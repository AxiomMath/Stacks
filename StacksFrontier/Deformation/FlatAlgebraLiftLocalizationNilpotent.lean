module

public import StacksFrontier.Deformation.FlatAlgebraLiftHenselizationNilpotent
public import StacksFrontier.Deformation.FlatAlgebraLiftLocalizationRelative
import all StacksFrontier.Deformation.FlatAlgebraLiftLocalization
import all StacksFrontier.RingTheory.Smoothing.LiftingAlongSurjections.SyntomicLift

/-!
# Deformations of localizations at a nilpotent kernel (Stacks 0DZ7)

Let `A' → A` be a surjective map of Noetherian rings with nilpotent kernel, `A → B` a finite type
flat ring map and `S ⊆ B` a multiplicative subset meeting no prime at which `Spec(B) → Spec(A)` is
not syntomic. Stacks 0DZ7 says that `B` has a flat lift to `A'` if and only if `S⁻¹B` does.

The forward implication is `Deformation.hasFlatAlgebraLift_localization_of_hasFlatAlgebraLift`.
The published proof of the converse reduces it to Stacks 0DZ2, which is false (see
`StacksFrontier/Deformation/FlatAlgebraLiftLocalization.lean`). The proof here instead runs the
comparison `Deformation.RelationLift.exists_flat_quotient_of_approx` along the localization
`P' → Q' = T⁻¹P'` of a polynomial presentation `π : P' = A'[x_1, …, x_n] → B` at `T = π⁻¹(S)`:

* a flat lift of `S⁻¹B` is a flat quotient `Q' ⧸ 𝔍` with `𝔍 + IQ' = (ker π) Q'`, because `Q'` is
  formally smooth along the reduction of the lift and every element of `T` becomes a unit there
  (`Deformation.exists_flat_quotient_localization`);
* for `𝔭 = π⁻¹(𝔟)`, `𝔟` the ideal generated by the `g` with `B_g` syntomic, every element of `T`
  is a unit modulo every `𝔭^N`, so `P'/𝔭^N = Q'/𝔭^N Q'`
  (`Deformation.bijective_quotientMap_localization`);
* the obstruction to improving a relation solution on `P'` is `𝔭`-power torsion, since `B_h` is
  syntomic for every `h ∈ 𝔟` (`Deformation.obstructionTorsion_of_syntomic`, Stacks 07M8 at every
  level), and syntomicity is local (`Deformation.syntomic_away_of_mem_span_syntomic`).

## Main results

* `Deformation.exists_flat_quotient_localization`: a flat lift of a localization is a flat
  quotient of the localized presentation.
* `Deformation.hasFlatAlgebraLift_of_hasFlatAlgebraLift_localization_of_syntomic`: the converse
  of Stacks 0DZ7, with the non-syntomic locus carried by an ideal `𝔟`.
* `Deformation.hasFlatAlgebraLift_iff_hasFlatAlgebraLift_localization`: **Stacks 0DZ7**.

## References

* [Stacks Project, Tag 0DZ7](https://stacks.math.columbia.edu/tag/0DZ7)
* [Stacks Project, Tag 07M8](https://stacks.math.columbia.edu/tag/07M8)
* [Stacks Project, Tag 00SY](https://stacks.math.columbia.edu/tag/00SY)
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u

namespace Deformation

open RelationLift

/-! ### A flat lift of a localization is a flat quotient of the localized presentation -/

section Localization

/-- **A flat lift of `S⁻¹B` is a flat quotient of `T⁻¹P'`.** Let `π : P' → B` be a surjection of
`A'`-algebras with `P'` formally smooth, `S ⊆ B` multiplicative, `T = π⁻¹(S)` and `Q' = T⁻¹P'`. A
flat lift of `C = S⁻¹B` to `A'` is `Q' ⧸ 𝔍` for an ideal `𝔍` with `𝔍 + IQ' = (ker π) Q'`. -/
theorem exists_flat_quotient_localization
    (A' A B P' : Type u) [CommRing A'] [CommRing A] [CommRing B] [CommRing P']
    [Algebra A' A] [Algebra A B] [Algebra A' B] [IsScalarTower A' A B] [Algebra A' P']
    [Algebra.FormallySmooth A' P']
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hnilA : IsNilpotent (RingHom.ker (algebraMap A' A)))
    (π : P' →ₐ[A'] B) (hπ : Function.Surjective π) (S : Submonoid B)
    (Q' : Type u) [CommRing Q'] [Algebra P' Q'] [IsLocalization (S.comap π.toRingHom) Q']
    [Algebra A' Q'] [IsScalarTower A' P' Q']
    (C : Type u) [CommRing C] [Algebra B C] [IsLocalization S C] [Algebra A C]
    [IsScalarTower A B C] (hlift : HasFlatAlgebraLift A' A C) :
    ∃ 𝔍 : Ideal Q', Module.Flat A' (Q' ⧸ 𝔍) ∧
      𝔍 ⊔ (RingHom.ker (algebraMap A' A)).map (algebraMap A' Q') =
        (RingHom.ker π).map (algebraMap P' Q') := by
  classical
  set I := RingHom.ker (algebraMap A' A) with hI
  set T := S.comap π.toRingHom with hT
  obtain ⟨C', _, _, hflatC', ⟨eC⟩⟩ := hlift
  -- the canonical map `Q' → C`
  let gh : Q' →+* C := IsLocalization.map (M := T) (T := S) C π.toRingHom le_rfl
  have hghP : ∀ x : P', gh (algebraMap P' Q' x) = algebraMap B C (π x) :=
    fun x => IsLocalization.map_eq _ _
  -- algebra structures
  let : Algebra A' C := ((algebraMap A C).comp (algebraMap A' A)).toAlgebra
  have : IsScalarTower A' A C := IsScalarTower.of_algebraMap_eq' rfl
  let : Algebra Q' C := gh.toAlgebra
  let : Algebra P' C := ((algebraMap B C).comp π.toRingHom).toAlgebra
  have : IsScalarTower P' Q' C := IsScalarTower.of_algebraMap_eq fun x => (hghP x).symm
  have : IsScalarTower A' P' C := IsScalarTower.of_algebraMap_eq fun a => by
    show algebraMap A C (algebraMap A' A a) = algebraMap B C (π (algebraMap A' P' a))
    rw [π.commutes, IsScalarTower.algebraMap_apply A' A B, ← IsScalarTower.algebraMap_apply A B C]
  have hunit : ∀ t ∈ T, IsUnit (algebraMap P' C t) := fun t ht =>
    IsLocalization.map_units C (⟨π t, ht⟩ : S)
  -- the lift `ψ : Q' → C'`
  obtain ⟨ψ, hψ⟩ := exists_algHom_localization_of_algebraLift A' A P' C C' hsurjA hnilA T Q'
    hunit eC
  set ρ : C' →ₐ[A'] C := (eC.restrictScalars A').toAlgHom.comp
    Algebra.TensorProduct.includeRight with hρdef
  have hρψ : ∀ x, ρ (ψ x) = gh x := fun x => hψ x
  have hρker : RingHom.ker ρ = I.map (algebraMap A' C') :=
    ker_comp_includeRight C C' hsurjA (eC.restrictScalars A')
  -- `gh` is onto with kernel `(ker π) Q'`
  have hghsurj : Function.Surjective gh := by
    intro z
    obtain ⟨⟨b₀, s⟩, rfl⟩ := IsLocalization.mk'_surjective S z
    obtain ⟨p, rfl⟩ := hπ b₀
    obtain ⟨t, ht⟩ := hπ s.1
    have htT : t ∈ T := by
      show π t ∈ S
      rw [ht]; exact s.2
    refine ⟨IsLocalization.mk' Q' p ⟨t, htT⟩, ?_⟩
    rw [IsLocalization.map_mk']
    congr 1
    exact Subtype.ext ht
  set 𝔧 := RingHom.ker π with h𝔧
  have hkergh : RingHom.ker gh ≤ 𝔧.map (algebraMap P' Q') := by
    intro x hx
    obtain ⟨⟨p, t⟩, rfl⟩ := IsLocalization.mk'_surjective T x
    rw [RingHom.mem_ker, IsLocalization.map_mk', IsLocalization.mk'_eq_zero_iff] at hx
    obtain ⟨⟨s, hs⟩, hsp⟩ := hx
    obtain ⟨t', rfl⟩ := hπ s
    have ht'T : t' ∈ T := hs
    have hmem : t' * p ∈ 𝔧 := by
      show π (t' * p) = 0
      rw [map_mul]; exact hsp
    have heq : IsLocalization.mk' Q' p t =
        algebraMap P' Q' (t' * p) * IsLocalization.mk' Q' (1 : P') (⟨t', ht'T⟩ * t) := by
      rw [← IsLocalization.mk'_eq_mul_mk'_one, IsLocalization.mk'_eq_iff_eq]
      simp only [Submonoid.coe_mul, map_mul]
      ring
    simp only at heq ⊢
    rw [heq]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)
  have hkergh' : 𝔧.map (algebraMap P' Q') ≤ RingHom.ker gh := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, hghP, show π x = 0 from hx, map_zero]
  -- `ψ` is onto, by Nakayama
  have hψsurj : Function.Surjective ψ := by
    have htop : LinearMap.range ψ.toLinearMap ⊔ I • (⊤ : Submodule A' C') = ⊤ := by
      refine eq_top_iff.mpr fun y _ => ?_
      obtain ⟨x, hx⟩ := hghsurj (ρ y)
      have hmem : y - ψ x ∈ I.map (algebraMap A' C') := by
        rw [← hρker, RingHom.mem_ker, map_sub, hρψ, hx, sub_self]
      have : y = ψ x + (y - ψ x) := by ring
      rw [this]
      refine Submodule.add_mem _ (Submodule.mem_sup_left ⟨x, rfl⟩) (Submodule.mem_sup_right ?_)
      rw [Ideal.smul_top_eq_map]; exact hmem
    have := Submodule.eq_top_of_sup_ideal_smul_top_eq_top hnilA htop
    intro y
    have hy : y ∈ LinearMap.range ψ.toLinearMap := this ▸ Submodule.mem_top
    obtain ⟨x, hx⟩ := hy
    exact ⟨x, hx⟩
  have hmap : I.map (algebraMap A' C') = (I.map (algebraMap A' Q')).map ψ.toRingHom := by
    rw [Ideal.map_map, show ψ.toRingHom.comp (algebraMap A' Q') = algebraMap A' C' from
      RingHom.ext fun a => ψ.commutes a]
  refine ⟨RingHom.ker ψ, ?_, ?_⟩
  · exact Module.Flat.of_linearEquiv
      (Ideal.quotientKerAlgEquivOfSurjective (f := ψ) hψsurj).toLinearEquiv
  · apply le_antisymm
    · refine sup_le (fun x hx => hkergh ?_) (fun x hx => hkergh ?_)
      · rw [RingHom.mem_ker, ← hρψ, show ψ x = 0 from hx, map_zero]
      · rw [RingHom.mem_ker, ← hρψ]
        have : ψ x ∈ I.map (algebraMap A' C') := by
          rw [hmap]; exact Ideal.mem_map_of_mem ψ.toRingHom hx
        rw [← hρker] at this
        exact this
    · intro x hx
      have hψx : ψ x ∈ I.map (algebraMap A' C') := by
        rw [← hρker, RingHom.mem_ker, hρψ]; exact hkergh' hx
      rw [hmap] at hψx
      obtain ⟨y, hy, hxy⟩ := (Ideal.mem_map_iff_of_surjective ψ.toRingHom hψsurj).mp hψx
      have : x = (x - y) + y := by ring
      rw [this]
      refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right hy)
      rw [RingHom.mem_ker, map_sub]
      show ψ x - ψ y = 0
      rw [show ψ y = ψ x from hxy, sub_self]

end Localization

/-! ### The converse of Stacks 0DZ7 -/

section Converse

/-- **The converse of Stacks 0DZ7, with the non-syntomic locus carried by an ideal.** Let
`A' → A` be a surjective map of Noetherian rings with nilpotent kernel, `A → B` a finite type flat
ring map, `𝔟 ⊆ B` an ideal with `A → B_h` syntomic for every `h ∈ 𝔟`, and `S ⊆ B` a multiplicative
subset meeting no prime containing `𝔟`. If `S⁻¹B` has a flat lift to `A'`, so does `B`. -/
theorem hasFlatAlgebraLift_of_hasFlatAlgebraLift_localization_of_syntomic
    (A' A B : Type u) [CommRing A'] [CommRing A] [CommRing B]
    [IsNoetherianRing A'] [Algebra A' A] [Algebra A B]
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hnilA : IsNilpotent (RingHom.ker (algebraMap A' A)))
    [Algebra.FiniteType A B] [Module.Flat A B] (b : Ideal B)
    (hsyn : ∀ h ∈ b, Algebra.Syntomic A (Localization.Away h))
    (S : Submonoid B) (hSb : ∀ q : Ideal B, q.IsPrime → b ≤ q → ∀ s ∈ S, s ∉ q)
    (C : Type u) [CommRing C] [Algebra B C] [IsLocalization S C] [Algebra A C]
    [IsScalarTower A B C] (hlift : HasFlatAlgebraLift A' A C) :
    HasFlatAlgebraLift A' A B := by
  classical
  let : Algebra A' B := ((algebraMap A B).comp (algebraMap A' A)).toAlgebra
  have : IsScalarTower A' A B := IsScalarTower.of_algebraMap_eq' rfl
  have : Algebra.FiniteType A' A := Algebra.FiniteType.of_surjective (Algebra.ofId A' A) hsurjA
  have : Algebra.FiniteType A' B := Algebra.FiniteType.trans (S := A) inferInstance inferInstance
  obtain ⟨n, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType A' B)
  set P' := MvPolynomial (Fin n) A'
  set I := RingHom.ker (algebraMap A' A) with hI
  set 𝔭 := b.comap π.toRingHom with h𝔭
  set 𝔧 := RingHom.ker π with h𝔧
  set T := S.comap π.toRingHom with hT
  let Q' : Type u := Localization T
  have hI𝔧 : I.map (algebraMap A' P') ≤ 𝔧 := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, h𝔧, RingHom.mem_ker, π.commutes, IsScalarTower.algebraMap_apply A' A B,
      show algebraMap A' A a = 0 from ha, map_zero]
  obtain ⟨n₀, hn₀⟩ := hnilA
  have hn : I ^ (max n₀ 1) = ⊥ :=
    le_bot_iff.mp ((Ideal.pow_le_pow_right (le_max_left _ _)).trans (le_of_eq hn₀))
  -- the flat quotient of `Q'`
  obtain ⟨𝔍, hflat𝔍, h𝔍⟩ := exists_flat_quotient_localization A' A B P' hsurjA ⟨n₀, hn₀⟩
    π hπ S Q' C hlift
  -- generators and syzygies
  obtain ⟨m, s, fh, rh, hfh, hsyz, hrh⟩ :=
    exists_generators_and_syzygyGenerators 𝔧 (I.map (algebraMap A' P'))
  have hIQ : I.map (algebraMap A' Q') = (I.map (algebraMap A' P')).map (algebraMap P' Q') := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  -- an exact solution over `Q'`
  have hJ : 𝔍 ⊔ I.map (algebraMap A' Q') =
      Ideal.span (Set.range (fun i => algebraMap P' Q' (fh i))) ⊔ I.map (algebraMap A' Q') := by
    rw [h𝔍, show (fun i => algebraMap P' Q' (fh i)) = algebraMap P' Q' ∘ fh from rfl,
      Set.range_comp, ← Ideal.map_span, hfh, hIQ, sup_eq_left.mpr (Ideal.map_mono hI𝔧)]
  have := hflat𝔍
  obtain ⟨Ft, Gt, hFt, hGt, -, hrel⟩ := exists_relVec_eq_zero_of_flat_quotient I hn 𝔍
    (fun i => algebraMap P' Q' (fh i)) (fun j i => algebraMap P' Q' (rh j i)) hJ
    (fun j => by
      rw [hIQ, map_mul_sum_helper]
      exact Ideal.mem_map_of_mem _ (hrh j))
  -- every element of `T` is a unit modulo every power of `𝔭`, so `P'/𝔭^N = Q'/𝔭^N Q'`
  have hunit : ∀ (N : ℕ), ∀ t ∈ T, IsUnit (Ideal.Quotient.mk (𝔭 ^ N) t) := by
    intro N t ht
    refine isUnit_quotient_mk_of_forall_isPrime (𝔭 ^ N) t fun q hq hle htq => ?_
    have h𝔭q : 𝔭 ≤ q := hq.le_of_pow_le hle
    have hkq : RingHom.ker π.toRingHom ≤ q := fun x hx => h𝔭q (by
      show π x ∈ b
      rw [show π x = 0 from hx]; exact b.zero_mem)
    have hqprime : (q.map π.toRingHom).IsPrime := Ideal.map_isPrime_of_surjective hπ hkq
    have hbq : b ≤ q.map π.toRingHom := by
      rw [← Ideal.map_comap_of_surjective π.toRingHom hπ b]
      exact Ideal.map_mono h𝔭q
    exact hSb _ hqprime hbq (π t) ht (Ideal.mem_map_of_mem _ htq)
  have hbij : ∀ N : ℕ, Function.Bijective (Ideal.quotientMap ((𝔭 ^ N).map (algebraMap P' Q'))
      (algebraMap P' Q') Ideal.le_comap_map) := fun N =>
    bijective_quotientMap_localization T Q' (𝔭 ^ N) (hunit N)
  have happrox : ∀ (N : ℕ) (y : Q'), ∃ x : P', y - algebraMap P' Q' x ∈
      (𝔭 ^ N).map (algebraMap P' Q') := fun N y =>
    exists_sub_mem_map_of_bijective_quotientMap (𝔭 ^ N) (hbij N) y
  have hcontr : ∀ (N : ℕ) (x : P'), algebraMap P' Q' x ∈ (𝔭 ^ N).map (algebraMap P' Q') →
      x ∈ 𝔭 ^ N := fun N x hx =>
    mem_of_algebraMap_mem_map_of_bijective_quotientMap (𝔭 ^ N) (hbij N) hx
  -- the comparison
  obtain ⟨F, hF, hflatF⟩ := exists_flat_quotient_of_approx (algebraMap P' Q') 𝔭 happrox hcontr I
    (le_max_right n₀ 1) hn fh rh hsyz hrh
    (fun k hk => obstructionTorsion_of_syntomic A' A B P' hsurjA ⟨n₀, hn₀⟩ π hπ b hsyn fh rh hfh
      hsyz hk) Ft Gt
    (fun i => by rw [← hIQ]; exact hFt i) (fun j i => by rw [← hIQ]; exact hGt j i) hrel
    (fun F hF => flat_reduction_of_sup_eq_ker hsurjA π hπ _ (span_sup_eq_of_sub_mem hF hfh hI𝔧))
  exact hasFlatAlgebraLift_of_flat_quotient hsurjA π hπ _ (span_sup_eq_of_sub_mem hF hfh hI𝔧)

end Converse

/-! ### Syntomicity is local -/

section Local

/-- **Syntomicity is local on the source.** If `h` lies in the ideal generated by the `g` with
`R → S_g` syntomic, then `R → S_h` is syntomic: every prime of `S_h` misses one such `g`, so the
local conditions of Lemma 00SY hold there. -/
theorem syntomic_away_of_mem_span_syntomic {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.FinitePresentation R S] {s : S}
    (hs : s ∈ Ideal.span {g : S | Algebra.Syntomic R (Localization.Away g)}) :
    Algebra.Syntomic R (Localization.Away s) := by
  classical
  set U : Set S := {g | Algebra.Syntomic R (Localization.Away g)}
  have : Algebra.FinitePresentation S (Localization.Away s) :=
    IsLocalization.Away.finitePresentation s
  have : Algebra.FinitePresentation R (Localization.Away s) :=
    Algebra.FinitePresentation.trans R S (Localization.Away s)
  apply Stacks.Smoothing.syntomic_of_local_flat_and_completeIntersection
  intro q' hq'
  let q := q'.comap (algebraMap S (Localization.Away s))
  have hsq : s ∉ q := fun hm ↦ hq'.ne_top (Ideal.eq_top_of_isUnit_mem q' hm
    (IsLocalization.Away.algebraMap_isUnit s))
  obtain ⟨t, ht, htq⟩ : ∃ t ∈ U, t ∉ q :=
    Set.not_subset.mp fun h ↦ hsq (Ideal.span_le.mpr h hs)
  have h13 := (Algebra.exists_notMem_syntomic_tfae (q.under R) q).out 1 3
  obtain ⟨_, _, _, hflat, hci⟩ := h13.mp ⟨t, htq, ht⟩
  rw [Localization.AtPrime.flat_localRingHom_iff] at hflat
  have : Module.Flat R (Localization.AtPrime q) := hflat
  have : IsLocalization.AtPrime (Localization.AtPrime q') q :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization (Submonoid.powers s)
      (Localization.AtPrime q') q'
  let e := (IsLocalization.algEquiv q.primeCompl
    (Localization.AtPrime q) (Localization.AtPrime q')).restrictScalars R
  have hp : q.under R = q'.under R := by
    show (q'.comap (algebraMap S (Localization.Away s))).comap (algebraMap R S) = _
    rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq]
  exact ⟨Module.Flat.of_linearEquiv e.symm.toLinearEquiv, IsCompleteIntersection.fiber_congr hp
    (hci.of_algEquiv (Algebra.TensorProduct.congr AlgEquiv.refl e))⟩

end Local

/-! ### Stacks 0DZ7 -/

section Tag

/-- **Stacks 0DZ7.** Let `A' → A` be a surjective map of Noetherian rings with nilpotent kernel,
let `A → B` be a finite type flat ring map and let `S ⊆ B` be a multiplicative subset such that if
`Spec(B) → Spec(A)` is not syntomic at `𝔮`, then `S ∩ 𝔮 = ∅`. Then `B` has a flat lift to `A'` if
and only if `S⁻¹B` has a flat lift to `A'`.

`Spec(B) → Spec(A)` is syntomic at the point `𝔮` exactly when `A → B_g` is syntomic for some
`g ∉ 𝔮` (Stacks 00SY, 01UE); that is how the hypothesis `hS` reads the source's condition. The
proof does not go through Stacks 0DZ2 (which is false); see the module documentation. -/
@[stacks 0DZ7 "`S⁻¹B` is any `C` with `IsLocalization S C`. `Spec(B) → Spec(A)` being syntomic at
the point `𝔮` is read affinely as `∃ g ∉ 𝔮, A → B_g` syntomic, the characterization of Stacks 00SY
and 01UE; `S ∩ 𝔮 = ∅` is `∀ s ∈ S, s ∉ 𝔮`. The published proof rests on Stacks 0DZ2, which is false;
the proof here approximates a flat lift over the localized presentation by relation solutions over
the polynomial presentation and corrects them one power of the kernel at a time (Artin-Rees plus
Stacks 07M8 at every level). See the module docstring."]
public theorem hasFlatAlgebraLift_iff_hasFlatAlgebraLift_localization
    (A' A B : Type u) [CommRing A'] [CommRing A] [CommRing B]
    [IsNoetherianRing A'] [IsNoetherianRing A] [Algebra A' A] [Algebra A B]
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hnilA : IsNilpotent (RingHom.ker (algebraMap A' A)))
    [Algebra.FiniteType A B] [Module.Flat A B] (S : Submonoid B)
    (hS : ∀ q : Ideal B, q.IsPrime →
      (¬ ∃ g ∉ q, Algebra.Syntomic A (Localization.Away g)) → ∀ s ∈ S, s ∉ q)
    (C : Type u) [CommRing C] [Algebra B C] [IsLocalization S C] [Algebra A C]
    [IsScalarTower A B C] :
    HasFlatAlgebraLift A' A B ↔ HasFlatAlgebraLift A' A C := by
  refine ⟨hasFlatAlgebraLift_localization_of_hasFlatAlgebraLift A' A B hsurjA S C,
    fun hlift => ?_⟩
  have : Algebra.FinitePresentation A B := Algebra.FinitePresentation.of_finiteType.mp
    inferInstance
  set b : Ideal B := Ideal.span {g : B | Algebra.Syntomic A (Localization.Away g)}
  have hsyn : ∀ h ∈ b, Algebra.Syntomic A (Localization.Away h) := fun h hh =>
    syntomic_away_of_mem_span_syntomic hh
  have hSb : ∀ q : Ideal B, q.IsPrime → b ≤ q → ∀ s ∈ S, s ∉ q := by
    intro q hq hbq
    refine hS q hq ?_
    rintro ⟨g, hgq, hg⟩
    exact hgq (hbq (Ideal.subset_span hg))
