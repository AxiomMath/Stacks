module

public import Mathlib.RingTheory.Filtration
public import Mathlib.RingTheory.Flat.Stability
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import StacksFrontier.RingTheory.Flat.TorCriterion

/-!
# Flat lifts of a presented algebra through lifted relations

Let `R` be a ring, `𝔦 ⊆ R` an ideal, `fh : Fin m → R` a family and `rh : Fin s → Fin m → R` a
family of vectors generating the module of syzygies of `fh` modulo `𝔦`, that is of the
`c : Fin m → R` with `∑ c i * fh i ∈ 𝔦`. A *`k`-solution* is a pair `(F, G)` with `F ≡ fh` and
`G ≡ rh` modulo `𝔦` and with every relation `∑ G j i * F i` lying in `𝔦 ^ k`.

This file proves the two facts about such solutions that are independent of any deformation
theory:

* the ideal generated by the entries of a `k`-solution `F` meets `𝔦` only in
  `𝔦 · (F) + 𝔦 ^ k` (`Deformation.RelationLift.span_inf_le_of_isSolution`);
* consequently, over a base `Λ` with a nilpotent ideal `𝔫`, if `R` is flat over `Λ`, the
  quotient by `(F)` is flat over `Λ` as soon as its reduction modulo `𝔫` is
  (`Deformation.RelationLift.flat_quotient_of_inf_le_mul`). This is the local criterion of
  flatness, Stacks 051C, specialised to a cyclic module, where its `Tor₁` hypothesis is the
  statement that relations lift.

## Main results

* `Deformation.RelationLift.IsSolution`: the notion of a `k`-solution.
* `Deformation.RelationLift.span_inf_le_of_isSolution`: relations lift.
* `Deformation.RelationLift.flat_quotient_of_inf_le_mul`: Stacks 051C for a cyclic module.
* `Deformation.RelationLift.inf_map_le_mul_of_flat_quotient`: conversely, a flat quotient meets
  an extended ideal in the product.

## References

* [Stacks Project, Tag 051C](https://stacks.math.columbia.edu/tag/051C)
* [Stacks Project, Tag 00MK](https://stacks.math.columbia.edu/tag/00MK)
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u

namespace Deformation.RelationLift

/-! ### Solutions -/

section Solutions

variable {R : Type u} [CommRing R] (𝔦 : Ideal R) {m s : ℕ} (fh : Fin m → R)
  (rh : Fin s → Fin m → R)

/-- The vectors `rh` generate the syzygies of `fh` modulo `𝔦`: every `c` with
`∑ c i * fh i ∈ 𝔦` is, modulo `𝔦`, an `R`-linear combination of the `rh j`. -/
def SyzygyGenerators : Prop :=
  ∀ c : Fin m → R, ∑ i, c i * fh i ∈ 𝔦 → ∃ a : Fin s → R, ∀ i, c i - ∑ j, a j * rh j i ∈ 𝔦

/-- A `k`-solution: `F ≡ fh` and `G ≡ rh` modulo `𝔦`, and every relation `∑ G j i * F i` lies
in `𝔦 ^ k`. -/
def IsSolution (k : ℕ) (F : Fin m → R) (G : Fin s → Fin m → R) : Prop :=
  (∀ i, F i - fh i ∈ 𝔦) ∧ (∀ j i, G j i - rh j i ∈ 𝔦) ∧ ∀ j, ∑ i, G j i * F i ∈ 𝔦 ^ k

variable {𝔦 fh rh}

/-- An element of the span of a finite family is a linear combination of it. -/
theorem exists_eq_sum_of_mem_span {F : Fin m → R} {x : R}
    (hx : x ∈ Ideal.span (Set.range F)) : ∃ c : Fin m → R, x = ∑ i, c i * F i := by
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hx
  exact ⟨c, by rw [← hc]; simp [smul_eq_mul]⟩

/-- A linear combination of a finite family lies in its span. -/
theorem sum_mem_span (F c : Fin m → R) : ∑ i, c i * F i ∈ Ideal.span (Set.range F) :=
  Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- A linear combination with coefficients in `𝔞` of a finite family lies in `𝔞 · (F)`. -/
theorem sum_mem_mul_span {𝔞 : Ideal R} (F c : Fin m → R) (hc : ∀ i, c i ∈ 𝔞) :
    ∑ i, c i * F i ∈ 𝔞 * Ideal.span (Set.range F) :=
  Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (hc i) (Ideal.subset_span ⟨i, rfl⟩)

/-- If `J ⊔ I = (f) ⊔ I`, then every `f i` lies in `J ⊔ I`. -/
private theorem apply_mem_sup_of_sup_eq_span {J I : Ideal R} {f : Fin m → R}
    (h : J ⊔ I = Ideal.span (Set.range f) ⊔ I) (i : Fin m) : f i ∈ J ⊔ I := by
  rw [h]; exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)

/-- Families congruent modulo `I` span ideals contained in each other's span plus `I`. -/
private theorem span_le_span_sup_of_sub_mem {I : Ideal R} {F f : Fin m → R}
    (h : ∀ i, F i - f i ∈ I) : Ideal.span (Set.range F) ≤ Ideal.span (Set.range f) ⊔ I := by
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  have : F i = f i + (F i - f i) := by ring
  rw [this]
  exact Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩))
    (Ideal.mem_sup_right (h i))

/-- **Relations lift.** For a `k`-solution `(F, G)`, the ideal `(F)` meets `𝔦` only in
`𝔦 · (F) + 𝔦 ^ k`. -/
theorem span_inf_le_of_isSolution (hsyz : SyzygyGenerators 𝔦 fh rh) {k : ℕ}
    {F : Fin m → R} {G : Fin s → Fin m → R} (hsol : IsSolution 𝔦 fh rh k F G) :
    Ideal.span (Set.range F) ⊓ 𝔦 ≤ 𝔦 * Ideal.span (Set.range F) ⊔ 𝔦 ^ k := by
  intro x ⟨hxF, hxi⟩
  obtain ⟨hF, hG, hrel⟩ := hsol
  obtain ⟨c, rfl⟩ := exists_eq_sum_of_mem_span hxF
  have hcfh : ∑ i, c i * fh i ∈ 𝔦 := by
    have hdiff : ∑ i, c i * F i - ∑ i, c i * fh i ∈ 𝔦 := by
      rw [← Finset.sum_sub_distrib]
      exact Ideal.sum_mem _ fun i _ => by
        rw [← mul_sub]
        exact Ideal.mul_mem_left _ _ (hF i)
    simpa using 𝔦.sub_mem hxi hdiff
  obtain ⟨a, ha⟩ := hsyz c hcfh
  have hsplit : ∑ i, c i * F i =
      ∑ j, a j * (∑ i, G j i * F i) - ∑ i, (∑ j, a j * (G j i - rh j i)) * F i +
        ∑ i, (c i - ∑ j, a j * rh j i) * F i := by
    have e1 : ∑ i, c i * F i = ∑ i, (∑ j, a j * rh j i) * F i +
        ∑ i, (c i - ∑ j, a j * rh j i) * F i := by
      rw [← Finset.sum_add_distrib]; exact Finset.sum_congr rfl fun i _ => by ring
    rw [e1]
    congr 1
    calc ∑ i, (∑ j, a j * rh j i) * F i = ∑ i, ∑ j, a j * rh j i * F i := by
          simp [Finset.sum_mul]
      _ = ∑ j, ∑ i, a j * rh j i * F i := Finset.sum_comm
      _ = ∑ j, a j * (∑ i, G j i * F i) - ∑ j, ∑ i, a j * (G j i - rh j i) * F i := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl fun i _ => by ring
      _ = _ := by
          rw [Finset.sum_comm (f := fun j i => a j * (G j i - rh j i) * F i)]
          simp [Finset.sum_mul]
  rw [hsplit]
  refine Ideal.add_mem _ (Ideal.sub_mem _ (Ideal.mem_sup_right ?_) (Ideal.mem_sup_left ?_))
    (Ideal.mem_sup_left (sum_mem_mul_span F _ ha))
  · exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hrel j)
  · exact sum_mem_mul_span F _ fun i =>
      Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hG j i)

/-- The form of `span_inf_le_of_isSolution` with `𝔦 ^ k` added on the left, for `k ≥ 1`. -/
theorem span_sup_pow_inf_le_of_isSolution (hsyz : SyzygyGenerators 𝔦 fh rh) {k : ℕ}
    (hk : 1 ≤ k) {F : Fin m → R} {G : Fin s → Fin m → R} (hsol : IsSolution 𝔦 fh rh k F G) :
    (Ideal.span (Set.range F) ⊔ 𝔦 ^ k) ⊓ 𝔦 ≤ 𝔦 * Ideal.span (Set.range F) ⊔ 𝔦 ^ k := by
  intro x ⟨hx, hxi⟩
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
  have hzi : z ∈ 𝔦 := Ideal.pow_le_self (by omega) hz
  have hyi : y ∈ 𝔦 := by simpa using 𝔦.sub_mem hxi hzi
  exact Ideal.add_mem _ (span_inf_le_of_isSolution hsyz hsol ⟨hy, hyi⟩)
    (Ideal.mem_sup_right hz)

end Solutions

/-! ### The local criterion of flatness for a cyclic module -/

section Flatness

variable {Λ R : Type u} [CommRing Λ] [CommRing R] [Algebra Λ R]

/-- The multiplication map `𝔫 ⊗_Λ R → R`. -/
def mulMap (𝔫 : Ideal Λ) : 𝔫 ⊗[Λ] R →ₗ[Λ] R :=
  TensorProduct.lift ((LinearMap.lsmul Λ R).comp 𝔫.subtype)

/-- The multiplication map sends `a ⊗ r` to `a • r`. -/
@[simp]
theorem mulMap_tmul (𝔫 : Ideal Λ) (a : 𝔫) (r : R) :
    mulMap 𝔫 (a ⊗ₜ[Λ] r) = (a : Λ) • r := rfl

/-- The multiplication map is injective when `R` is flat. -/
theorem mulMap_injective [Module.Flat Λ R] (𝔫 : Ideal Λ) :
    Function.Injective (mulMap (R := R) 𝔫) := by
  have h : mulMap (R := R) 𝔫 = (TensorProduct.lid Λ R).toLinearMap ∘ₗ 𝔫.subtype.rTensor R := by
    apply TensorProduct.ext'
    intro a r
    simp
  rw [h, LinearMap.coe_comp]
  exact (TensorProduct.lid Λ R).injective.comp
    (Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective)

/-- The multiplication map lands in `𝔫 R`. -/
theorem mulMap_mem_map (𝔫 : Ideal Λ) (w : 𝔫 ⊗[Λ] R) :
    mulMap 𝔫 w ∈ 𝔫.map (algebraMap Λ R) := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul a r =>
      rw [mulMap_tmul, Algebra.smul_def]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ a.2)
  | add u v hu hv => rw [map_add]; exact Ideal.add_mem _ hu hv

/-- Multiplication `𝔫 ⊗ R → R` commutes with the quotient map `R → R ⧸ 𝔞`. -/
private theorem lid_rTensor_lTensor_eq_mulMap (𝔫 : Ideal Λ) (𝔞 : Ideal R) (w : 𝔫 ⊗[Λ] R) :
    TensorProduct.lid Λ (R ⧸ 𝔞) ((𝔫.subtype.rTensor (R ⧸ 𝔞))
      ((Ideal.Quotient.mkₐ Λ 𝔞).toLinearMap.lTensor 𝔫 w)) =
      (Ideal.Quotient.mkₐ Λ 𝔞).toLinearMap (mulMap 𝔫 w) := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul a r => simp
  | add u v hu hv => simp only [map_add, hu, hv]

/-- An element of `𝔫 R · 𝔞` is the product of an element of `𝔫 ⊗ 𝔞`. -/
theorem mem_range_mulMap_of_mem_mul (𝔫 : Ideal Λ) (𝔞 : Ideal R) {x : R}
    (hx : x ∈ 𝔫.map (algebraMap Λ R) * 𝔞) :
    ∃ w ∈ LinearMap.range ((𝔞.restrictScalars Λ).subtype.lTensor 𝔫), mulMap 𝔫 w = x := by
  -- the image of `𝔫 ⊗ 𝔞` is an ideal of `R`
  let Y : Ideal R :=
    { carrier := {x | ∃ w ∈ LinearMap.range ((𝔞.restrictScalars Λ).subtype.lTensor 𝔫),
        mulMap 𝔫 w = x}
      add_mem' := by
        rintro _ _ ⟨w, hw, rfl⟩ ⟨w', hw', rfl⟩
        exact ⟨w + w', Submodule.add_mem _ hw hw', map_add _ _ _⟩
      zero_mem' := ⟨0, Submodule.zero_mem _, map_zero _⟩
      smul_mem' := by
        rintro c _ ⟨w, ⟨u, rfl⟩, rfl⟩
        -- multiplication by `c` on `𝔞` is `Λ`-linear
        let μ : (𝔞.restrictScalars Λ) →ₗ[Λ] (𝔞.restrictScalars Λ) :=
          { toFun := fun a => ⟨c * a, 𝔞.mul_mem_left c a.2⟩
            map_add' := fun a b => Subtype.ext (mul_add _ _ _)
            map_smul' := fun t a => Subtype.ext (by
              show c * (t • (a : R)) = t • (c * a)
              rw [Algebra.smul_def, Algebra.smul_def]; ring) }
        refine ⟨((𝔞.restrictScalars Λ).subtype.lTensor 𝔫) ((μ.lTensor 𝔫) u),
          ⟨(μ.lTensor 𝔫) u, rfl⟩, ?_⟩
        · induction u using TensorProduct.induction_on with
          | zero => simp
          | tmul a b =>
              simp only [LinearMap.lTensor_tmul, mulMap_tmul, smul_eq_mul]
              show (a : Λ) • (c * (b : R)) = c * ((a : Λ) • (b : R))
              rw [Algebra.smul_def, Algebra.smul_def]; ring
          | add u v hu hv =>
              simp only [map_add, smul_eq_mul, mul_add] at hu hv ⊢
              rw [hu, hv] }
  have hle : 𝔫.map (algebraMap Λ R) * 𝔞 ≤ Y := by
    rw [Ideal.mul_le]
    intro x hx y hy
    induction hx using Submodule.span_induction generalizing y with
    | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        refine ⟨((𝔞.restrictScalars Λ).subtype.lTensor 𝔫)
          ((⟨a, ha⟩ : 𝔫) ⊗ₜ[Λ] (⟨y, hy⟩ : 𝔞.restrictScalars Λ)), ⟨_, rfl⟩, ?_⟩
        simp [Algebra.smul_def]
    | zero => simp
    | add x z _ _ hx hz => simpa [add_mul] using Y.add_mem (hx y hy) (hz y hy)
    | smul c x _ hx =>
        have := hx (c * y) (𝔞.mul_mem_left c hy)
        simpa [smul_eq_mul, mul_assoc, mul_comm c x, mul_left_comm] using this
  exact hle hx

/-- The sequence `𝔞 → R → R ⧸ 𝔞` is exact. -/
private theorem exact_subtype_mkₐ (𝔞 : Ideal R) :
    Function.Exact (𝔞.restrictScalars Λ).subtype (Ideal.Quotient.mkₐ Λ 𝔞).toLinearMap := by
  rw [LinearMap.exact_iff]
  ext x
  simp [Ideal.Quotient.eq_zero_iff_mem]

/-- **Stacks 051C for a cyclic module.** Let `𝔫 ⊆ Λ` be a nilpotent ideal and `R` a flat
`Λ`-algebra. If the reduction of `R ⧸ 𝔞` modulo `𝔫` is flat over `Λ ⧸ 𝔫` and
`𝔞 ∩ 𝔫R ⊆ 𝔫R · 𝔞`, then `R ⧸ 𝔞` is flat over `Λ`. -/
theorem flat_quotient_of_inf_le_mul [Module.Flat Λ R] (𝔫 : Ideal Λ)
    (h𝔫 : ∃ n : ℕ, 1 ≤ n ∧ 𝔫 ^ n = ⊥) (𝔞 : Ideal R)
    (hred : Module.Flat (Λ ⧸ 𝔫) ((R ⧸ 𝔞) ⧸ (𝔫 • (⊤ : Submodule Λ (R ⧸ 𝔞)))))
    (hrel : 𝔞 ⊓ 𝔫.map (algebraMap Λ R) ≤ 𝔫.map (algebraMap Λ R) * 𝔞) :
    Module.Flat Λ (R ⧸ 𝔞) := by
  set q : R →ₗ[Λ] R ⧸ 𝔞 := (Ideal.Quotient.mkₐ Λ 𝔞).toLinearMap with hqdef
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hnat : ∀ w : 𝔫 ⊗[Λ] R, TensorProduct.lid Λ (R ⧸ 𝔞)
      ((𝔫.subtype.rTensor (R ⧸ 𝔞)) (q.lTensor 𝔫 w)) = q (mulMap 𝔫 w) :=
    lid_rTensor_lTensor_eq_mulMap 𝔫 𝔞
  have hinj : Function.Injective (𝔫.subtype.rTensor (R ⧸ 𝔞)) := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨w, rfl⟩ := LinearMap.lTensor_surjective 𝔫 hq z
    have hw𝔞 : mulMap 𝔫 w ∈ 𝔞 := by
      have := hnat w
      rw [hz, map_zero] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mp this.symm
    obtain ⟨w', ⟨u, rfl⟩, hw'⟩ :=
      mem_range_mulMap_of_mem_mul 𝔫 𝔞 (hrel ⟨hw𝔞, mulMap_mem_map 𝔫 w⟩)
    rw [mulMap_injective 𝔫 hw'.symm, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
    rw [(exact_subtype_mkₐ 𝔞).linearMap_comp_eq_zero, LinearMap.lTensor_zero,
      LinearMap.zero_apply]
  have ht : Tor1Vanishes Λ (Λ ⧸ 𝔫) (R ⧸ 𝔞) :=
    tor1_vanishes_of_shortExact_rTensor_injective 𝔫.subtype (Submodule.mkQ 𝔫)
      Subtype.val_injective (Submodule.mkQ_surjective 𝔫)
      (by rw [LinearMap.exact_iff]; simp)
      (Tor_iso_Tor'.tor_flat_isZero Λ (ModuleCat.of Λ Λ) (ModuleCat.of Λ (R ⧸ 𝔞)) 0) hinj
  exact flat_of_nilpotent 𝔫 hred ht h𝔫

/-- Multiplying the right factor by `c` multiplies the product by `c`. -/
theorem mulMap_lTensor_mulLeft (𝔠 : Ideal Λ) (c : R) (w : 𝔠 ⊗[Λ] R) :
    mulMap 𝔠 ((LinearMap.mulLeft Λ c).lTensor 𝔠 w) = c • mulMap 𝔠 w := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul a r =>
      simp only [LinearMap.lTensor_tmul, mulMap_tmul, smul_eq_mul, LinearMap.mulLeft_apply]
      rw [Algebra.smul_def, Algebra.smul_def]; ring
  | add u v hu hv => simp only [map_add, smul_add, hu, hv]

/-- The image of `𝔠 ⊗ 𝔞` lies in `𝔠R · 𝔞`. -/
theorem mulMap_lTensor_mem_mul (𝔠 : Ideal Λ) (𝔞 : Ideal R) (u : 𝔠 ⊗[Λ] 𝔞.restrictScalars Λ) :
    mulMap 𝔠 ((𝔞.restrictScalars Λ).subtype.lTensor 𝔠 u) ∈ 𝔠.map (algebraMap Λ R) * 𝔞 := by
  induction u using TensorProduct.induction_on with
  | zero => simp
  | tmul a r =>
      simp only [LinearMap.lTensor_tmul, Submodule.subtype_apply, mulMap_tmul]
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ a.2) r.2
  | add u v hu hv => rw [map_add, map_add]; exact Ideal.add_mem _ hu hv

/-- **A flat quotient meets an extended ideal in the product.** If `R ⧸ 𝔞` is flat over `Λ`,
then `𝔞 ∩ 𝔠R ⊆ 𝔠R · 𝔞` for every ideal `𝔠 ⊆ Λ`. No flatness of `R` is needed. -/
theorem inf_map_le_mul_of_flat_quotient (𝔞 : Ideal R) [Module.Flat Λ (R ⧸ 𝔞)] (𝔠 : Ideal Λ) :
    𝔞 ⊓ 𝔠.map (algebraMap Λ R) ≤ 𝔠.map (algebraMap Λ R) * 𝔞 := by
  set q : R →ₗ[Λ] R ⧸ 𝔞 := (Ideal.Quotient.mkₐ Λ 𝔞).toLinearMap with hqdef
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hnat : ∀ w : 𝔠 ⊗[Λ] R, TensorProduct.lid Λ (R ⧸ 𝔞)
      ((𝔠.subtype.rTensor (R ⧸ 𝔞)) (q.lTensor 𝔠 w)) = q (mulMap 𝔠 w) :=
    lid_rTensor_lTensor_eq_mulMap 𝔠 𝔞
  have hsurj : ∀ x ∈ 𝔠.map (algebraMap Λ R), ∃ w, mulMap 𝔠 w = x := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        exact ⟨(⟨a, ha⟩ : 𝔠) ⊗ₜ[Λ] (1 : R), by simp [Algebra.smul_def]⟩
    | zero => exact ⟨0, map_zero _⟩
    | add x y _ _ hx hy =>
        obtain ⟨w, rfl⟩ := hx
        obtain ⟨w', rfl⟩ := hy
        exact ⟨w + w', map_add _ _ _⟩
    | smul c x _ hx =>
        obtain ⟨w, rfl⟩ := hx
        exact ⟨_, mulMap_lTensor_mulLeft 𝔠 c w⟩
  rintro x ⟨hx𝔞, hx𝔠⟩
  obtain ⟨w, rfl⟩ := hsurj x hx𝔠
  have h0 : (𝔠.subtype.rTensor (R ⧸ 𝔞)) (q.lTensor 𝔠 w) = 0 := by
    apply (TensorProduct.lid Λ (R ⧸ 𝔞)).injective
    rw [hnat, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hx𝔞
  have h1 : q.lTensor 𝔠 w = 0 :=
    Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective
      (by rw [h0, map_zero])
  obtain ⟨u, rfl⟩ := (lTensor_exact 𝔠 (exact_subtype_mkₐ 𝔞) hq w).mp h1
  exact mulMap_lTensor_mem_mul 𝔠 𝔞 u

end Flatness

/-! ### Correcting an approximate solution, one power of `𝔦` at a time -/

section Step

variable {R : Type u} [CommRing R] (𝔦 𝔭 : Ideal R) {m s : ℕ} (fh : Fin m → R)
  (rh : Fin s → Fin m → R)

/-- The vector of relations `j ↦ ∑ i, G j i * F i`. -/
def relVec (F : Fin m → R) (G : Fin s → Fin m → R) : Fin s → R := fun j => ∑ i, G j i * F i

/-- The vectors of relations that can be killed modulo `𝔦 ^ (k + 1)` by changing a `k`-solution
by elements of `𝔦 ^ k`: those `x` for which some `μ ∈ (𝔦 ^ k) ^ m` makes every
`x j + ∑ rh j i * μ i` lie in `𝔦 ^ (k + 1) + 𝔦 ^ k · (fh)`. -/
def solvable (k : ℕ) : Submodule R (Fin s → R) where
  carrier := {x | ∃ μ : Fin m → R, (∀ i, μ i ∈ 𝔦 ^ k) ∧
    ∀ j, x j + ∑ i, rh j i * μ i ∈ 𝔦 ^ (k + 1) ⊔ 𝔦 ^ k * Ideal.span (Set.range fh)}
  add_mem' := by
    rintro x y ⟨μ, hμ, hx⟩ ⟨μ', hμ', hy⟩
    refine ⟨μ + μ', fun i => Ideal.add_mem _ (hμ i) (hμ' i), fun j => ?_⟩
    have : (x + y) j + ∑ i, rh j i * (μ + μ') i =
        (x j + ∑ i, rh j i * μ i) + (y j + ∑ i, rh j i * μ' i) := by
      simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]; ring
    rw [this]
    exact Ideal.add_mem _ (hx j) (hy j)
  zero_mem' := ⟨0, fun _ => Ideal.zero_mem _, fun j => by simp⟩
  smul_mem' := by
    rintro c x ⟨μ, hμ, hx⟩
    refine ⟨c • μ, fun i => Ideal.mul_mem_left _ c (hμ i), fun j => ?_⟩
    have : (c • x) j + ∑ i, rh j i * (c • μ) i = c * (x j + ∑ i, rh j i * μ i) := by
      simp only [Pi.smul_apply, smul_eq_mul, mul_add, Finset.mul_sum]
      congr 1
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [this]
    exact Ideal.mul_mem_left _ c (hx j)

/-- The obstruction to correcting a `k`-solution is `𝔭`-power torsion: for every `k`-solution
and every `g ∈ 𝔭`, some power of `g` makes its relation vector solvable. -/
def ObstructionTorsion (k : ℕ) : Prop :=
  ∀ (F : Fin m → R) (G : Fin s → Fin m → R), IsSolution 𝔦 fh rh k F G →
    ∀ g ∈ 𝔭, ∃ e : ℕ, g ^ e • relVec F G ∈ solvable 𝔦 fh rh k

variable {𝔦 𝔭 fh rh}

/-- A vector with every entry in `J` lies in `J • ⊤`. -/
theorem mem_smul_top_pi {J : Ideal R} {x : Fin s → R} (hx : ∀ j, x j ∈ J) :
    x ∈ J • (⊤ : Submodule R (Fin s → R)) := by
  rw [← Finset.univ_sum_single x]
  refine Submodule.sum_mem _ fun j _ => ?_
  have : Pi.single j (x j) = x j • (Pi.single j 1 : Fin s → R) := by
    rw [← Pi.single_smul, smul_eq_mul, mul_one]
  rw [this]
  exact Submodule.smul_mem_smul (hx j) Submodule.mem_top

/-- An element of `𝔞 · (f)` is a combination of the `f i` with coefficients in `𝔞`. -/
theorem exists_eq_sum_of_mem_mul_span {𝔞 : Ideal R} {f : Fin m → R} {x : R}
    (hx : x ∈ 𝔞 * Ideal.span (Set.range f)) :
    ∃ c : Fin m → R, (∀ i, c i ∈ 𝔞) ∧ x = ∑ i, c i * f i := by
  refine Submodule.mul_induction_on hx ?_ ?_
  · intro a ha y hy
    obtain ⟨d, rfl⟩ := exists_eq_sum_of_mem_span hy
    refine ⟨fun i => a * d i, fun i => Ideal.mul_mem_right _ _ ha, ?_⟩
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring
  · rintro x y ⟨c, hc, rfl⟩ ⟨c', hc', rfl⟩
    exact ⟨c + c', fun i => Ideal.add_mem _ (hc i) (hc' i), by
      simp [add_mul, Finset.sum_add_distrib]⟩

/-- An element of `J • solvable` is solvable with a correction in `J · 𝔦 ^ k`. -/
theorem exists_of_mem_smul_solvable {J : Ideal R} {k : ℕ} {x : Fin s → R}
    (hx : x ∈ J • solvable 𝔦 fh rh k) :
    ∃ μ : Fin m → R, (∀ i, μ i ∈ J * 𝔦 ^ k) ∧
      ∀ j, x j + ∑ i, rh j i * μ i ∈ J * (𝔦 ^ (k + 1) ⊔ 𝔦 ^ k * Ideal.span (Set.range fh)) := by
  refine Submodule.smul_induction_on hx ?_ ?_
  · intro a ha y hy
    obtain ⟨μ, hμ, hy⟩ := hy
    refine ⟨a • μ, fun i => Ideal.mul_mem_mul ha (hμ i), fun j => ?_⟩
    have : (a • y) j + ∑ i, rh j i * (a • μ) i = a * (y j + ∑ i, rh j i * μ i) := by
      simp only [Pi.smul_apply, smul_eq_mul, mul_add, Finset.mul_sum]
      congr 1
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [this]
    exact Ideal.mul_mem_mul ha (hy j)
  · rintro x y ⟨μ, hμ, hx⟩ ⟨μ', hμ', hy⟩
    refine ⟨μ + μ', fun i => Ideal.add_mem _ (hμ i) (hμ' i), fun j => ?_⟩
    have : (x + y) j + ∑ i, rh j i * (μ + μ') i =
        (x j + ∑ i, rh j i * μ i) + (y j + ∑ i, rh j i * μ' i) := by
      simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]; ring
    rw [this]
    exact Ideal.add_mem _ (hx j) (hy j)

/-- Splitting an element of `J · (𝔦 ^ (k + 1) + 𝔦 ^ k · (fh))`. -/
theorem exists_sub_sum_mem {J : Ideal R} {k : ℕ} {y : R}
    (hy : y ∈ J * (𝔦 ^ (k + 1) ⊔ 𝔦 ^ k * Ideal.span (Set.range fh))) :
    ∃ ν : Fin m → R, (∀ i, ν i ∈ J * 𝔦 ^ k) ∧ y - ∑ i, ν i * fh i ∈ J * 𝔦 ^ (k + 1) := by
  rw [Ideal.mul_sup, ← mul_assoc] at hy
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hy
  obtain ⟨ν, hν, rfl⟩ := exists_eq_sum_of_mem_mul_span hb
  exact ⟨ν, hν, by simpa using ha⟩

/-- Products land in `J · 𝔦 ^ (k + 1)`. -/
theorem mul_mem_of_mem_mul_pow {J : Ideal R} {k : ℕ} {x y : R} (hx : x ∈ J * 𝔦 ^ k)
    (hy : y ∈ 𝔦) : x * y ∈ J * 𝔦 ^ (k + 1) := by
  have := Ideal.mul_mem_mul hx hy
  rwa [mul_assoc, ← pow_succ] at this

/-- The `𝔭`-power torsion submodules relative to `solvable`. -/
def torsionStage (k t : ℕ) : Submodule R (Fin s → R) where
  carrier := {x | ∀ a ∈ 𝔭 ^ t, a • x ∈ solvable 𝔦 fh rh k}
  add_mem' := fun hx hy a ha => by rw [smul_add]; exact Submodule.add_mem _ (hx a ha) (hy a ha)
  zero_mem' := fun a _ => by rw [smul_zero]; exact Submodule.zero_mem _
  smul_mem' := fun c x hx a ha => by
    rw [smul_comm]; exact Submodule.smul_mem _ c (hx a ha)

/-- **The correction.** Changing a `k`-solution by `μ` and `ν` with entries in `J · 𝔦 ^ k`
that kill its relations modulo `J · 𝔦 ^ (k + 1)` gives a `(k + 1)`-solution whose relations lie
in `J · 𝔦 ^ (k + 1)`. -/
private theorem isSolution_succ_of_correction {k : ℕ} (hk : 1 ≤ k) {J : Ideal R} {F : Fin m → R}
    {G : Fin s → Fin m → R} (hsol : IsSolution 𝔦 fh rh k F G) {μ : Fin m → R}
    (hμ : ∀ i, μ i ∈ J * 𝔦 ^ k) {ν : Fin s → Fin m → R} (hν : ∀ j i, ν j i ∈ J * 𝔦 ^ k)
    (hνw : ∀ j, relVec F G j + ∑ i, rh j i * μ i - ∑ i, ν j i * fh i ∈ J * 𝔦 ^ (k + 1)) :
    IsSolution 𝔦 fh rh (k + 1) (F + μ) (fun j i => G j i - ν j i) ∧
      ∀ j, relVec (F + μ) (fun j i => G j i - ν j i) j ∈ J * 𝔦 ^ (k + 1) := by
  obtain ⟨hF, hG, -⟩ := hsol
  have hJi : J * 𝔦 ^ k ≤ 𝔦 := Ideal.mul_le_right.trans (Ideal.pow_le_self (by omega))
  have hkey : ∀ j, relVec (F + μ) (fun j i => G j i - ν j i) j ∈ J * 𝔦 ^ (k + 1) := by
    intro j
    have hid : relVec (F + μ) (fun j i => G j i - ν j i) j =
        (relVec F G j + ∑ i, rh j i * μ i - ∑ i, ν j i * fh i) - ∑ i, ν j i * (F i - fh i) +
          ∑ i, (G j i - rh j i) * μ i - ∑ i, ν j i * μ i := by
      unfold relVec
      simp only [Pi.add_apply, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [hid]
    refine Ideal.sub_mem _ (Ideal.add_mem _ (Ideal.sub_mem _ (hνw j) ?_) ?_) ?_
    · exact Ideal.sum_mem _ fun i _ => mul_mem_of_mem_mul_pow (hν j i) (hF i)
    · exact Ideal.sum_mem _ fun i _ => by
        rw [mul_comm (G j i - rh j i)]
        exact mul_mem_of_mem_mul_pow (hμ i) (hG j i)
    · exact Ideal.sum_mem _ fun i _ => mul_mem_of_mem_mul_pow (hν j i) (hJi (hμ i))
  refine ⟨⟨fun i => ?_, fun j i => ?_, fun j => Ideal.mul_le_right (hkey j)⟩, hkey⟩
  · have : (F + μ) i - fh i = (F i - fh i) + μ i := by simp [Pi.add_apply]; ring
    rw [this]
    exact Ideal.add_mem _ (hF i) (hJi (hμ i))
  · have : G j i - ν j i - rh j i = (G j i - rh j i) - ν j i := by ring
    rw [this]
    exact Ideal.sub_mem _ (hG j i) (hJi (hν j i))

/-- **One correction step.** If the obstruction is `𝔭`-power torsion and `R` is Noetherian,
there is a constant `C` such that every `k`-solution whose relations lie in
`𝔭 ^ (M + C) · 𝔦 ^ k` can be corrected to a `(k + 1)`-solution whose relations lie in
`𝔭 ^ M · 𝔦 ^ (k + 1)`. -/
theorem exists_isSolution_succ [IsNoetherianRing R] {k : ℕ} (hk : 1 ≤ k)
    (hT : ObstructionTorsion 𝔦 𝔭 fh rh k) :
    ∃ C : ℕ, ∀ (M : ℕ) (F : Fin m → R) (G : Fin s → Fin m → R), IsSolution 𝔦 fh rh k F G →
      (∀ j, relVec F G j ∈ 𝔭 ^ (M + C) * 𝔦 ^ k) →
      ∃ (F' : Fin m → R) (G' : Fin s → Fin m → R), IsSolution 𝔦 fh rh (k + 1) F' G' ∧
        ∀ j, relVec F' G' j ∈ 𝔭 ^ M * 𝔦 ^ (k + 1) := by
  classical
  let Hc : ℕ →o Submodule R (Fin s → R) :=
    ⟨fun t => torsionStage (𝔦 := 𝔦) (𝔭 := 𝔭) (fh := fh) (rh := rh) k t, fun t t' htt' x hx a ha =>
      hx a (Ideal.pow_le_pow_right htt' ha)⟩
  obtain ⟨c, hc⟩ := (monotone_stabilizes_iff_noetherian (R := R) (M := Fin s → R)).mpr
    inferInstance Hc
  obtain ⟨a, ha⟩ := Ideal.exists_pow_inf_eq_pow_smul 𝔭 (Hc c)
  obtain ⟨b, hb⟩ := Ideal.exists_pow_inf_eq_pow_smul 𝔭 (solvable 𝔦 fh rh k)
  refine ⟨a + c + b, fun M F G hsol hsmall => ?_⟩
  obtain ⟨v, hvdef⟩ : ∃ v, v = relVec F G := ⟨_, rfl⟩
  have hvtop : v ∈ 𝔭 ^ (M + (a + c + b)) • (⊤ : Submodule R (Fin s → R)) :=
    mem_smul_top_pi fun j => by rw [hvdef]; exact Ideal.mul_le_left (hsmall j)
  have hvH : v ∈ Hc c := by
    let 𝔠 : Ideal R := (solvable 𝔦 fh rh k).comap (LinearMap.toSpanSingleton R (Fin s → R) v)
    have h𝔭 : 𝔭 ≤ 𝔠.radical := fun g hg => by
      obtain ⟨e, he⟩ := hT F G hsol g hg
      refine ⟨e, ?_⟩
      show g ^ e • v ∈ solvable 𝔦 fh rh k
      rw [hvdef]
      exact he
    obtain ⟨t, ht⟩ := Ideal.exists_pow_le_of_le_radical_of_fg h𝔭 (IsNoetherian.noetherian 𝔭)
    rw [hc (max t c) (le_max_right _ _)]
    exact Hc.monotone (le_max_left _ _) fun a' ha' => ht ha'
  have hvS : v ∈ solvable 𝔦 fh rh k := by
    have h1 : v ∈ 𝔭 ^ (M + (a + c + b)) • (⊤ : Submodule R (Fin s → R)) ⊓ Hc c := ⟨hvtop, hvH⟩
    rw [ha _ (by omega)] at h1
    have hle : 𝔭 ^ (M + (a + c + b) - a) • (𝔭 ^ a • (⊤ : Submodule R (Fin s → R)) ⊓ Hc c) ≤
        solvable 𝔦 fh rh k := by
      rw [Submodule.smul_le]
      intro r hr x hx
      exact hx.2 r (Ideal.pow_le_pow_right (by omega) hr)
    exact hle h1
  have hvS' : v ∈ 𝔭 ^ (M + (a + c + b) - b) • solvable 𝔦 fh rh k := by
    have h2 : v ∈ 𝔭 ^ (M + (a + c + b)) • (⊤ : Submodule R (Fin s → R)) ⊓ solvable 𝔦 fh rh k :=
      ⟨hvtop, hvS⟩
    rw [hb _ (by omega)] at h2
    exact Submodule.smul_mono le_rfl inf_le_right h2
  have hJ : 𝔭 ^ (M + (a + c + b) - b) ≤ 𝔭 ^ M := Ideal.pow_le_pow_right (by omega)
  generalize 𝔭 ^ (M + (a + c + b) - b) = J at hvS' hJ
  obtain ⟨μ, hμ, hμv⟩ := exists_of_mem_smul_solvable hvS'
  choose ν hν hνw using fun j => exists_sub_sum_mem (hμv j)
  subst hvdef
  obtain ⟨hsol', hkey⟩ := isSolution_succ_of_correction hk hsol hμ hν hνw
  exact ⟨F + μ, fun j i => G j i - ν j i, hsol', fun j => Ideal.mul_mono_left hJ (hkey j)⟩

/-- **Iterated correction.** Under the torsion hypothesis at every level `k ≥ 1`, for every
`k ≥ 1` there is a constant `C` such that every `1`-solution whose relations lie in
`𝔭 ^ (M + C) · 𝔦` can be corrected to a `k`-solution whose relations lie in
`𝔭 ^ M · 𝔦 ^ k`. -/
theorem exists_isSolution_of_le [IsNoetherianRing R]
    (hT : ∀ k, 1 ≤ k → ObstructionTorsion 𝔦 𝔭 fh rh k) {k : ℕ} (hk : 1 ≤ k) :
    ∃ C : ℕ, ∀ (M : ℕ) (F : Fin m → R) (G : Fin s → Fin m → R), IsSolution 𝔦 fh rh 1 F G →
      (∀ j, relVec F G j ∈ 𝔭 ^ (M + C) * 𝔦) →
      ∃ (F' : Fin m → R) (G' : Fin s → Fin m → R), IsSolution 𝔦 fh rh k F' G' ∧
        ∀ j, relVec F' G' j ∈ 𝔭 ^ M * 𝔦 ^ k := by
  induction k, hk using Nat.le_induction with
  | base =>
      exact ⟨0, fun M F G hsol hsmall => ⟨F, G, hsol, fun j => by simpa using hsmall j⟩⟩
  | succ k hk ih =>
      obtain ⟨C, hC⟩ := ih
      obtain ⟨C', hC'⟩ := exists_isSolution_succ hk (hT k hk)
      refine ⟨C' + C, fun M F G hsol hsmall => ?_⟩
      obtain ⟨F₁, G₁, hsol₁, hsmall₁⟩ :=
        hC (M + C') F G hsol fun j => by
          rw [show M + C' + C = M + (C' + C) by omega]
          exact hsmall j
      exact hC' M F₁ G₁ hsol₁ hsmall₁

/-- **Approximate solutions are close to exact ones.** Let `R` be Noetherian with `𝔦` nilpotent,
and assume the obstruction is `𝔭`-power torsion at every level. Then there is an `N` such that
every `1`-solution whose relations lie in `𝔭 ^ N` can be corrected to a `1`-solution whose
relations vanish. -/
theorem exists_relVec_eq_zero [IsNoetherianRing R]
    (hT : ∀ k, 1 ≤ k → ObstructionTorsion 𝔦 𝔭 fh rh k) {n : ℕ} (hn : 𝔦 ^ n = ⊥) :
    ∃ N : ℕ, ∀ (F : Fin m → R) (G : Fin s → Fin m → R), IsSolution 𝔦 fh rh 1 F G →
      (∀ j, relVec F G j ∈ 𝔭 ^ N) →
      ∃ (F' : Fin m → R) (G' : Fin s → Fin m → R), IsSolution 𝔦 fh rh 1 F' G' ∧
        ∀ j, relVec F' G' j = 0 := by
  have hn' : 𝔦 ^ (max n 1) = ⊥ := le_bot_iff.mp (hn ▸ Ideal.pow_le_pow_right (le_max_left _ _))
  obtain ⟨C, hC⟩ := exists_isSolution_of_le hT (le_max_right n 1)
  obtain ⟨d, hd⟩ := Ideal.exists_pow_inf_eq_pow_smul 𝔭 (𝔦 : Submodule R R)
  refine ⟨C + d, fun F G hsol hsmall => ?_⟩
  have hsmall' : ∀ j, relVec F G j ∈ 𝔭 ^ (0 + C) * 𝔦 := by
    intro j
    have h1 : relVec F G j ∈ 𝔭 ^ (C + d) • (⊤ : Submodule R R) ⊓ (𝔦 : Submodule R R) := by
      refine ⟨?_, ?_⟩
      · rw [Ideal.smul_eq_mul, Ideal.mul_top]; exact hsmall j
      · have := hsol.2.2 j
        rw [pow_one] at this
        exact this
    rw [hd _ (by omega)] at h1
    have h2 := Submodule.smul_mono (le_refl (𝔭 ^ (C + d - d))) inf_le_right h1
    rw [Ideal.smul_eq_mul, Nat.add_sub_cancel] at h2
    simpa using h2
  obtain ⟨F', G', hsol', hrel'⟩ := hC 0 F G hsol hsmall'
  refine ⟨F', G', ⟨hsol'.1, hsol'.2.1, fun j => ?_⟩, fun j => ?_⟩
  · rw [pow_one]
    exact Ideal.pow_le_self (by omega) (hsol'.2.2 j)
  · have := Ideal.mul_le_right (I := 𝔭 ^ 0) (J := 𝔦 ^ (max n 1)) (hrel' j)
    rw [hn', Ideal.mem_bot] at this
    exact this

/-- **A flat lift kills the obstruction.** Let `(F, G)` be a `k`-solution with `k ≥ 1` and let
`Ĵ` be an ideal with `Ĵ + 𝔦 ^ k = (F) + 𝔦 ^ k` which meets `𝔦 ^ k` only in
`𝔦 ^ k · Ĵ + 𝔦 ^ (k + 1)` (as a flat lift of `R ⧸ ((F) + 𝔦 ^ k)` to `R ⧸ 𝔦 ^ (k + 1)` does).
Then the relation vector of `(F, G)` is solvable. -/
theorem relVec_mem_solvable_of_lift {k : ℕ} (hk : 1 ≤ k) {F : Fin m → R}
    {G : Fin s → Fin m → R} (hsol : IsSolution 𝔦 fh rh k F G) (Ĵ : Ideal R)
    (hĴ : Ĵ ⊔ 𝔦 ^ k = Ideal.span (Set.range F) ⊔ 𝔦 ^ k)
    (hflat : Ĵ ⊓ 𝔦 ^ k ≤ 𝔦 ^ k * Ĵ ⊔ 𝔦 ^ (k + 1)) :
    relVec F G ∈ solvable 𝔦 fh rh k := by
  obtain ⟨hF, hG, hrel⟩ := hsol
  choose Fh hFh y hy hFy using fun i =>
    Submodule.mem_sup.mp (apply_mem_sup_of_sup_eq_span hĴ i)
  have hspan := span_le_span_sup_of_sub_mem hF
  have hĴle : Ĵ ≤ Ideal.span (Set.range fh) ⊔ 𝔦 :=
    le_sup_left.trans (hĴ.le.trans (sup_le hspan (le_sup_right.trans
      (sup_le_sup_left (Ideal.pow_le_self (by omega)) _))))
  have hprod : 𝔦 ^ k * Ĵ ≤ 𝔦 ^ (k + 1) ⊔ 𝔦 ^ k * Ideal.span (Set.range fh) := by
    refine (Ideal.mul_mono_right hĴle).trans ?_
    rw [Ideal.mul_sup, ← pow_succ]
    exact sup_le le_sup_right le_sup_left
  refine ⟨fun i => -y i, fun i => neg_mem (hy i), fun j => ?_⟩
  have hid : relVec F G j + ∑ i, rh j i * -y i =
      ∑ i, G j i * Fh i + ∑ i, (G j i - rh j i) * y i := by
    unfold relVec
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => by rw [← hFy i]; ring
  rw [hid]
  have hGFh : ∑ i, G j i * Fh i ∈ Ĵ ⊓ 𝔦 ^ k := by
    refine ⟨Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hFh i), ?_⟩
    have : ∑ i, G j i * Fh i = ∑ i, G j i * F i - ∑ i, G j i * y i := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [← hFy i]; ring
    rw [this]
    exact Ideal.sub_mem _ (hrel j) (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hy i))
  refine Ideal.add_mem _ ?_ (Ideal.mem_sup_left (Ideal.sum_mem _ fun i _ => ?_))
  · exact sup_le hprod le_sup_left (hflat hGFh)
  · have := Ideal.mul_mem_mul (hG j i) (hy i)
    rwa [← pow_succ'] at this

end Step

/-! ### Exact solutions from a flat quotient, and their transfer along an approximation -/

section Transfer

/-- **Nilpotent Nakayama for ideals.** If `J ≤ K ⊔ I * J` and `I` is nilpotent, then `J ≤ K`. -/
private theorem le_of_le_sup_mul_of_pow_eq_bot {T : Type u} [CommRing T] {I J K : Ideal T} {n : ℕ}
    (h : J ≤ K ⊔ I * J) (hI : I ^ n = ⊥) : J ≤ K := by
  have hiter : ∀ t : ℕ, J ≤ K ⊔ I ^ t * J := by
    intro t
    induction t with
    | zero => simp
    | succ t ih =>
        refine ih.trans (sup_le le_sup_left ?_)
        calc I ^ t * J ≤ I ^ t * (K ⊔ I * J) := Ideal.mul_mono_right h
          _ ≤ K ⊔ I ^ (t + 1) * J := by
              rw [Ideal.mul_sup, ← mul_assoc, ← pow_succ]
              exact sup_le_sup_right Ideal.mul_le_right _
  have h' := hiter n
  rwa [hI, Ideal.bot_mul, sup_bot_eq] at h'

/-- **A flat quotient presents an exact solution.** Let `𝔫 ⊆ Λ` be nilpotent and let `T ⧸ 𝔍` be
flat over `Λ`, where `𝔍 + 𝔫T = (fh) + 𝔫T` and the `rh` are syzygies of `fh` modulo `𝔫T`. Then
there are `F ≡ fh` and `G ≡ rh` modulo `𝔫T` with `(F) = 𝔍` and every relation `∑ G j i * F i`
equal to zero. -/
theorem exists_relVec_eq_zero_of_flat_quotient {Λ T : Type u} [CommRing Λ] [CommRing T]
    [Algebra Λ T] (𝔫 : Ideal Λ) {n : ℕ} (hn : 𝔫 ^ n = ⊥) (𝔍 : Ideal T)
    [Module.Flat Λ (T ⧸ 𝔍)] {m s : ℕ} (fh : Fin m → T) (rh : Fin s → Fin m → T)
    (hJ : 𝔍 ⊔ 𝔫.map (algebraMap Λ T) = Ideal.span (Set.range fh) ⊔ 𝔫.map (algebraMap Λ T))
    (hrh : ∀ j, ∑ i, rh j i * fh i ∈ 𝔫.map (algebraMap Λ T)) :
    ∃ (F : Fin m → T) (G : Fin s → Fin m → T),
      (∀ i, F i - fh i ∈ 𝔫.map (algebraMap Λ T)) ∧
      (∀ j i, G j i - rh j i ∈ 𝔫.map (algebraMap Λ T)) ∧
      Ideal.span (Set.range F) = 𝔍 ∧ ∀ j, relVec F G j = 0 := by
  set 𝔦 := 𝔫.map (algebraMap Λ T) with h𝔦
  have hflat : 𝔍 ⊓ 𝔦 ≤ 𝔦 * 𝔍 := inf_map_le_mul_of_flat_quotient 𝔍 𝔫
  choose F hF b hb hFb using fun i =>
    Submodule.mem_sup.mp (apply_mem_sup_of_sup_eq_span hJ i)
  have hFfh : ∀ i, F i - fh i ∈ 𝔦 := fun i => by
    rw [← hFb i, show F i - (F i + b i) = -b i by ring]; exact neg_mem (hb i)
  have hFle : Ideal.span (Set.range F) ≤ 𝔍 := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hF i
  have hstep : 𝔍 ≤ Ideal.span (Set.range F) ⊔ 𝔦 * 𝔍 := by
    intro y hy
    have hfhle := span_le_span_sup_of_sub_mem (F := fh) (f := F) fun i => by
      simpa using 𝔦.neg_mem (hFfh i)
    have : y ∈ Ideal.span (Set.range F) ⊔ 𝔦 :=
      sup_le hfhle le_sup_right (hJ ▸ Ideal.mem_sup_left hy)
    obtain ⟨a, ha, c, hc, rfl⟩ := Submodule.mem_sup.mp this
    have hc𝔍 : c ∈ 𝔍 := by simpa using 𝔍.sub_mem hy (hFle ha)
    exact Ideal.add_mem _ (Ideal.mem_sup_left ha) (Ideal.mem_sup_right (hflat ⟨hc𝔍, hc⟩))
  have hspan : Ideal.span (Set.range F) = 𝔍 :=
    le_antisymm hFle (le_of_le_sup_mul_of_pow_eq_bot hstep
      (by rw [h𝔦, ← Ideal.map_pow, hn, Ideal.map_bot]))
  have hrel : ∀ j, ∑ i, rh j i * F i ∈ 𝔦 * Ideal.span (Set.range F) := by
    intro j
    rw [hspan]
    refine hflat ⟨Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hF i), ?_⟩
    have : ∑ i, rh j i * F i = ∑ i, rh j i * fh i + ∑ i, rh j i * (F i - fh i) := by
      rw [← Finset.sum_add_distrib]; exact Finset.sum_congr rfl fun i _ => by ring
    rw [this]
    exact Ideal.add_mem _ (hrh j) (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hFfh i))
  choose c hc hcF using fun j => exists_eq_sum_of_mem_mul_span (hrel j)
  refine ⟨F, fun j i => rh j i - c j i, hFfh, fun j i => ?_, hspan, fun j => ?_⟩
  · rw [show rh j i - c j i - rh j i = -c j i by ring]; exact neg_mem (hc j i)
  · unfold relVec
    simp only [sub_mul, Finset.sum_sub_distrib]
    rw [← hcF j, sub_self]

variable {S T : Type u} [CommRing S] [CommRing T] (φ : S →+* T) (𝔭 : Ideal S)

/-- Under `S/𝔭^N ↠ T/𝔭^N T`, an element of an extended ideal `𝔦T` is congruent modulo `𝔭^N T`
to the image of an element of `𝔦`. -/
theorem exists_mem_sub_mem_of_mem_map
    (happrox : ∀ y : T, ∃ x : S, y - φ x ∈ 𝔭.map φ) (𝔦 : Ideal S) {y : T}
    (hy : y ∈ 𝔦.map φ) : ∃ x ∈ 𝔦, y - φ x ∈ 𝔭.map φ := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨x, hx, rfl⟩ := hy
      exact ⟨x, hx, by simp⟩
  | zero => exact ⟨0, 𝔦.zero_mem, by simp⟩
  | add y z _ _ hy hz =>
      obtain ⟨x, hx, hxy⟩ := hy
      obtain ⟨x', hx', hxz⟩ := hz
      refine ⟨x + x', 𝔦.add_mem hx hx', ?_⟩
      rw [map_add, show y + z - (φ x + φ x') = (y - φ x) + (z - φ x') by ring]
      exact Ideal.add_mem _ hxy hxz
  | smul t y _ hy =>
      obtain ⟨x, hx, hxy⟩ := hy
      obtain ⟨a, ha⟩ := happrox t
      refine ⟨a * x, 𝔦.mul_mem_left a hx, ?_⟩
      rw [map_mul, smul_eq_mul,
        show t * y - φ a * φ x = (t - φ a) * y + φ a * (y - φ x) by ring]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_left _ _ hxy)

/-- **Transfer of an exact solution.** Let `φ : S → T` induce surjections `S/𝔭^N → T/𝔭^N T`
with `S ∩ 𝔭^N T = 𝔭^N` for every `N`, and let `(Ft, Gt)` be an exact solution over `T` lifting
`(φ fh, φ rh)` modulo `𝔦T`. Then for every `N` there is a `1`-solution over `S` whose relations
lie in `𝔭 ^ N`. -/
theorem exists_isSolution_one_of_approx
    (happrox : ∀ (N : ℕ) (y : T), ∃ x : S, y - φ x ∈ (𝔭 ^ N).map φ)
    (hcontr : ∀ (N : ℕ) (x : S), φ x ∈ (𝔭 ^ N).map φ → x ∈ 𝔭 ^ N)
    (𝔦 : Ideal S) {m s : ℕ} (fh : Fin m → S) (rh : Fin s → Fin m → S)
    (hrh : ∀ j, ∑ i, rh j i * fh i ∈ 𝔦)
    (Ft : Fin m → T) (Gt : Fin s → Fin m → T) (hFt : ∀ i, Ft i - φ (fh i) ∈ 𝔦.map φ)
    (hGt : ∀ j i, Gt j i - φ (rh j i) ∈ 𝔦.map φ) (hrel : ∀ j, relVec Ft Gt j = 0) (N : ℕ) :
    ∃ (F : Fin m → S) (G : Fin s → Fin m → S), IsSolution 𝔦 fh rh 1 F G ∧
      ∀ j, relVec F G j ∈ 𝔭 ^ N := by
  choose a ha haF using fun i => exists_mem_sub_mem_of_mem_map φ (𝔭 ^ N) (happrox N) 𝔦 (hFt i)
  choose c hc hcG using fun j i =>
    exists_mem_sub_mem_of_mem_map φ (𝔭 ^ N) (happrox N) 𝔦 (hGt j i)
  refine ⟨fun i => fh i + a i, fun j i => rh j i + c j i,
    ⟨fun i => by simpa using ha i, fun j i => by simpa using hc j i, fun j => ?_⟩, fun j => ?_⟩
  · rw [pow_one]
    show ∑ i, (rh j i + c j i) * (fh i + a i) ∈ 𝔦
    have : ∑ i, (rh j i + c j i) * (fh i + a i) =
        ∑ i, rh j i * fh i + ∑ i, (rh j i * a i + c j i * (fh i + a i)) := by
      rw [← Finset.sum_add_distrib]; exact Finset.sum_congr rfl fun i _ => by ring
    rw [this]
    exact Ideal.add_mem _ (hrh j) (Ideal.sum_mem _ fun i _ =>
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ (ha i)) (Ideal.mul_mem_right _ _ (hc j i)))
  · apply hcontr
    have hzero : ∑ i, Gt j i * Ft i = 0 := hrel j
    show φ (∑ i, (rh j i + c j i) * (fh i + a i)) ∈ _
    rw [map_sum]
    have : ∑ i, φ ((rh j i + c j i) * (fh i + a i)) =
        ∑ i, Gt j i * Ft i - ∑ i, ((Gt j i - φ (rh j i + c j i)) * Ft i +
          φ (rh j i + c j i) * (Ft i - φ (fh i + a i))) := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun i _ => by rw [map_mul]; ring
    rw [this, hzero, zero_sub]
    refine neg_mem (Ideal.sum_mem _ fun i _ => Ideal.add_mem _ (Ideal.mul_mem_right _ _ ?_)
      (Ideal.mul_mem_left _ _ ?_))
    · rw [map_add,
        show Gt j i - (φ (rh j i) + φ (c j i)) = (Gt j i - φ (rh j i)) - φ (c j i) by ring]
      exact hcG j i
    · rw [map_add, show Ft i - (φ (fh i) + φ (a i)) = (Ft i - φ (fh i)) - φ (a i) by ring]
      exact haF i

/-- **The comparison, in its generic form.** Let `𝔫 ⊆ Λ` be nilpotent, `S` a Noetherian flat
`Λ`-algebra, `𝔭 ⊆ S` an ideal and `φ : S → T` a ring map inducing surjections
`S/𝔭^N → T/𝔭^N T` with `S ∩ 𝔭^N T = 𝔭^N`. Let `fh, rh` present the reduction modulo `𝔫` and
assume the obstruction to correcting solutions is `𝔭`-power torsion at every level. If `T` carries
an exact solution lifting `(φ fh, φ rh)`, then some `F ≡ fh` modulo `𝔫S` has `S ⧸ (F)` flat over
`Λ`, provided the reduction modulo `𝔫` of every such quotient is flat over `Λ ⧸ 𝔫`. -/
theorem exists_flat_quotient_of_approx {Λ : Type u} [CommRing Λ] [Algebra Λ S] [Module.Flat Λ S]
    [IsNoetherianRing S]
    (happrox : ∀ (N : ℕ) (y : T), ∃ x : S, y - φ x ∈ (𝔭 ^ N).map φ)
    (hcontr : ∀ (N : ℕ) (x : S), φ x ∈ (𝔭 ^ N).map φ → x ∈ 𝔭 ^ N)
    (𝔫 : Ideal Λ) {n : ℕ} (hn1 : 1 ≤ n) (hn : 𝔫 ^ n = ⊥) {m s : ℕ} (fh : Fin m → S)
    (rh : Fin s → Fin m → S) (hsyz : SyzygyGenerators (𝔫.map (algebraMap Λ S)) fh rh)
    (hrh : ∀ j, ∑ i, rh j i * fh i ∈ 𝔫.map (algebraMap Λ S))
    (hT : ∀ k, 1 ≤ k → ObstructionTorsion (𝔫.map (algebraMap Λ S)) 𝔭 fh rh k)
    (Ft : Fin m → T) (Gt : Fin s → Fin m → T)
    (hFt : ∀ i, Ft i - φ (fh i) ∈ (𝔫.map (algebraMap Λ S)).map φ)
    (hGt : ∀ j i, Gt j i - φ (rh j i) ∈ (𝔫.map (algebraMap Λ S)).map φ)
    (hrel : ∀ j, relVec Ft Gt j = 0)
    (hred : ∀ F : Fin m → S, (∀ i, F i - fh i ∈ 𝔫.map (algebraMap Λ S)) →
      Module.Flat (Λ ⧸ 𝔫) ((S ⧸ Ideal.span (Set.range F)) ⧸
        (𝔫 • (⊤ : Submodule Λ (S ⧸ Ideal.span (Set.range F)))))) :
    ∃ F : Fin m → S, (∀ i, F i - fh i ∈ 𝔫.map (algebraMap Λ S)) ∧
      Module.Flat Λ (S ⧸ Ideal.span (Set.range F)) := by
  set 𝔦 := 𝔫.map (algebraMap Λ S) with h𝔦
  have h𝔦n : 𝔦 ^ n = ⊥ := by rw [h𝔦, ← Ideal.map_pow, hn, Ideal.map_bot]
  obtain ⟨N, hN⟩ := exists_relVec_eq_zero hT h𝔦n
  obtain ⟨F, G, hsol, hsmall⟩ :=
    exists_isSolution_one_of_approx φ 𝔭 happrox hcontr 𝔦 fh rh hrh Ft Gt hFt hGt hrel N
  obtain ⟨F', G', hsol', hzero⟩ := hN F G hsol hsmall
  have hsoln : IsSolution 𝔦 fh rh n F' G' :=
    ⟨hsol'.1, hsol'.2.1, fun j => by
      have h0 : ∑ i, G' j i * F' i = 0 := hzero j
      rw [h0]
      exact Ideal.zero_mem _⟩
  refine ⟨F', hsol'.1, flat_quotient_of_inf_le_mul 𝔫 ⟨n, hn1, hn⟩ _ (hred F' hsol'.1) ?_⟩
  have := span_inf_le_of_isSolution hsyz hsoln
  rwa [h𝔦n, sup_bot_eq] at this

end Transfer

end Deformation.RelationLift

