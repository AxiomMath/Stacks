/-!
# Fibre products over a separable residue-field extension

Let `k'` be the subfield of `k` generated by the image of `Λ`. If `k` is separable over `k'`,
then the fibre product of two objects of `𝒞_Λ` over a third is again an object of `𝒞_Λ`, with
no surjectivity hypothesis on either morphism (Stacks 06GH).

The argument is the one in the source. An element `α` of `k` satisfies a monic polynomial
over `Λ` with `α` a simple root, since `k` is separable over the image of `Λ` and the
coefficients of the minimal polynomial over `k'` lift to `Λ`. An Artinian local ring is
henselian, so this simple root lifts to each of the two algebras; its two images in the common
target are roots of the same polynomial, differ by a non-unit and are simple, hence coincide.
That produces a compatible pair over `α`, so the canonical map from the fibre product to `k`
is surjective; module-finiteness of `k` over `Λ` makes the fibre product Artinian.

## Main results

* `Deformation.ArtinianLocalAlgCat.isConcretePullback_of_isSeparable`: the ring of compatible
  pairs, with its canonical residue map and ordinary projections, is a pullback in `𝒞_Λ`.

## Implementation notes

Noetherianness of `Λ` and module-finiteness of `k` over `Λ` are the ambient hypotheses of the
section; they are what make the fibre product Artinian and the minimal polynomial over `k'`
liftable, and the source assumes them throughout. No completeness of `Λ` is used.

## References

* [Stacks Project, Tag 06GH](https://stacks.math.columbia.edu/tag/06GH)
-/

@[expose] public section

namespace Deformation

namespace ArtinianLocalAlgCat

section
open CategoryTheory CategoryTheory.Limits IsLocalRing
universe u v w

private theorem map_eval₂_general {R S T : Type*} [Semiring R] [Semiring S] [Semiring T]
    (f : R →+* S) (g : S →+* T) (x : S) (p : Polynomial R) :
    g (p.eval₂ f x) = p.eval₂ (g.comp f) (g x) := by
  rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.eval_map_apply (p := p.map f) g x,
    Polynomial.map_map, Polynomial.eval₂_eq_eval_map]

private theorem algHom_map_eval {Λ A B : Type*} [CommRing Λ] [CommRing A] [CommRing B]
    [Algebra Λ A] [Algebra Λ B] (f : A →ₐ[Λ] B) (p : Polynomial Λ) (x : A) :
    f ((p.map (algebraMap Λ A)).eval x) = (p.map (algebraMap Λ B)).eval (f x) := by
  rw [Polynomial.eval_map_algebraMap, Polynomial.eval_map_algebraMap,
    Polynomial.aeval_algHom_apply]

/-- A simple root in the residue field of an Artinian local ring lifts to a simple root in
the ring: Artinian local rings are henselian. -/
private theorem exists_simple_root_lift {R Λ k : Type*} [CommRing R] [IsLocalRing R]
    [IsArtinianRing R] [CommRing Λ] [Algebra Λ R] [Field k] [Algebra Λ k]
    (e : ResidueField R ≃ₐ[Λ] k) (q : Polynomial Λ) (hq : q.Monic) (α : k)
    (hroot : q.eval₂ (algebraMap Λ k) α = 0)
    (hder : q.derivative.eval₂ (algebraMap Λ k) α ≠ 0) :
    ∃ a : R, (q.map (algebraMap Λ R)).IsRoot a ∧ e (residue R a) = α ∧
      IsUnit ((q.map (algebraMap Λ R)).derivative.eval a) := by
  let g : R →+* k := e.toRingEquiv.toRingHom.comp (residue R)
  have hgbase : g.comp (algebraMap Λ R) = algebraMap Λ k := by
    ext r
    change e (residue R (algebraMap Λ R r)) = algebraMap Λ k r
    rw [← ResidueField.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply Λ R (ResidueField R) r]
    exact e.commutes r
  obtain ⟨z, hz⟩ := e.surjective α
  obtain ⟨a₀, ha₀⟩ := residue_surjective z
  have hga₀ : g a₀ = α := by simp [g, ha₀, hz]
  have := henselianLocalRing_of_krullDimLE_zero R
  let qR : Polynomial R := q.map (algebraMap Λ R)
  have hEval : qR.eval a₀ ∈ maximalIdeal R := by
    rw [Polynomial.eval_map, ← residue_eq_zero_iff (R := R)]
    apply e.injective
    change g (q.eval₂ (algebraMap Λ R) a₀) = e 0
    rw [map_eval₂_general, hgbase, hga₀]
    simpa using hroot
  have hderR (x : R) : qR.derivative.eval x = q.derivative.eval₂ (algebraMap Λ R) x := by
    simp [qR, Polynomial.derivative_map, Polynomial.eval_map]
  have hDerUnit (x : R) (hx : g x = α) : IsUnit (qR.derivative.eval x) := by
    apply (residue_ne_zero_iff_isUnit _).mp
    intro hzero
    apply hder
    have hzero' : g (qR.derivative.eval x) = 0 := by
      change e (residue R (qR.derivative.eval x)) = 0
      simpa only [map_zero] using congrArg e hzero
    rwa [hderR, map_eval₂_general, hgbase, hx] at hzero'
  have hqR : qR.Monic := by simpa [qR] using hq.map (algebraMap Λ R)
  obtain ⟨a, haRoot, haDiff⟩ :=
    HenselianLocalRing.is_henselian qR hqR a₀ hEval (hDerUnit a₀ hga₀)
  have hresEq : residue R a = residue R a₀ :=
    sub_eq_zero.mp (by rwa [← map_sub, residue_eq_zero_iff])
  have hga : g a = α := (congrArg e hresEq).trans hga₀
  exact ⟨a, haRoot, hga, hDerUnit a hga⟩

/-- Every element of `k` is a simple root of a monic polynomial over `Λ`, when `k` is
separable over the subfield generated by the image of `Λ`. -/
private theorem exists_monic_lift_for_residue_element {Λ k : Type*} [CommRing Λ]
    [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k]
    [Algebra.IsSeparable (residueImageField Λ k) k] (α : k) :
    ∃ q : Polynomial Λ, q.Monic ∧
      q.eval₂ (algebraMap Λ k) α = 0 ∧
      q.derivative.eval₂ (algebraMap Λ k) α ≠ 0 := by
  let K : Subfield k := residueImageField Λ k
  let p : Polynomial k := (minpoly K α).map (algebraMap K k)
  have hp : p.Monic :=
    Polynomial.Monic.map (algebraMap K k) (minpoly.monic (Algebra.IsSeparable.isIntegral K α))
  have hpRoot : p.eval α = 0 := by
    dsimp [p]
    rw [Polynomial.eval_map]
    simpa [Polynomial.aeval_def] using minpoly.aeval K α
  have hpDer : p.derivative.eval α ≠ 0 := by
    dsimp [p]
    rw [Polynomial.derivative_map, Polynomial.eval_map]
    exact (Algebra.IsSeparable.isSeparable K α).aeval_derivative_ne_zero (minpoly.aeval K α)
  have hcoeff (i : ℕ) : p.coeff i ∈ Set.range (algebraMap Λ k) := by
    dsimp [p]
    rw [Polynomial.coeff_map, ← residueImageField_eq_range Λ k]
    exact (minpoly K α).coeff i |>.property
  obtain ⟨q, hqMap, -, hqMonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic ((Polynomial.lifts_iff_coeff_lifts p).2 hcoeff) hp
  exact ⟨q, hqMonic, by rwa [Polynomial.eval₂_eq_eval_map, hqMap],
    by rwa [Polynomial.eval₂_eq_eval_map, ← Polynomial.derivative_map, hqMap]⟩

variable {Λ : Type u} {k : Type w} [CommRing Λ] [IsNoetherianRing Λ]
  [Field k] [Algebra Λ k] [Module.Finite Λ k]

/-- Under separability the canonical map from the fibre product to `k` is surjective: a
simple root lifts to both factors and the two lifts have the same image in the base. -/
private theorem pullbackToResidueField_surjective_of_isSeparable
    [Algebra.IsSeparable (residueImageField Λ k) k]
    {A₁ A₂ A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f₁ : A₁ ⟶ A) (f₂ : A₂ ⟶ A) :
    Function.Surjective (pullbackToResidueField f₁ f₂) := by
  intro α
  obtain ⟨q, hqMonic, hqRoot, hqDer⟩ :=
    exists_monic_lift_for_residue_element (Λ := Λ) (k := k) α
  have hlift {B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A) :
      ∃ b : B, (q.map (algebraMap Λ A)).IsRoot (f.hom b) ∧
        A.residueEquiv (residue A (f.hom b)) = α ∧
        IsUnit ((q.map (algebraMap Λ A)).derivative.eval (f.hom b)) := by
    obtain ⟨b, hb, hα, hu⟩ := exists_simple_root_lift B.residueEquiv q hqMonic α hqRoot hqDer
    refine ⟨b, ?_, (f.residue_comm b).trans hα, ?_⟩
    · rw [Polynomial.IsRoot.def, ← algHom_map_eval f.hom q b, hb.eq_zero, map_zero]
    · rw [Polynomial.derivative_map, ← algHom_map_eval f.hom q.derivative b,
        ← Polynomial.derivative_map]
      exact hu.map f.hom
  obtain ⟨a₁, hroot₁, hres₁, hder₁⟩ := hlift f₁
  obtain ⟨a₂, hroot₂, hres₂, -⟩ := hlift f₂
  have hmem : f₁.hom a₁ - f₂.hom a₂ ∈ maximalIdeal A := by
    rw [← residue_eq_zero_iff (R := A), map_sub]
    apply A.residueEquiv.injective
    rw [map_sub, hres₁, hres₂, sub_self, map_zero]
  have heq : f₁.hom a₁ = f₂.hom a₂ :=
    IsLocalRing.eq_of_eval_eq_zero_of_not_isUnit_sub hroot₁ hroot₂
      (by simpa [mem_maximalIdeal] using hmem) hder₁
  exact ⟨⟨(a₁, a₂), heq⟩, hres₁⟩

/-- The algebraic fibre product has its canonical object structure in `𝒞_Λ`
when `k` is separable over the image field of `Λ`. -/
@[stacks 06GH "separable_fiber_product_in_clambda"]
theorem isConcretePullback_of_isSeparable
    [Algebra.IsSeparable (residueImageField Λ k) k]
    {A₁ A₂ A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f₁ : A₁ ⟶ A) (f₂ : A₂ ⟶ A) :
    IsConcretePullback f₁ f₂ :=
  isConcretePullback_of_pullbackToResidueField_surjective f₁ f₂
    (pullback_isArtinianRing_of_moduleFinite f₁ f₂)
    (pullbackToResidueField_surjective_of_isSeparable f₁ f₂)

end

