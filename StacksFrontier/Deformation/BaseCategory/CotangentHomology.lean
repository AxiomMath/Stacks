module

public import Mathlib.Algebra.Field.ULift
public import Mathlib.FieldTheory.Separable
public import Mathlib.RingTheory.Etale.Field
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Kaehler.JacobiZariski
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Etale.FilteredColimit.Basic
public import StacksFrontier.RingTheory.NaiveCotangent.Henselization

/-!
# The conormal module of the base ring and first cotangent homology

Let `Λ` be the base ring of a deformation category, let `k` be the residue field in play and
let `k'` be the subfield of `k` generated by the image of `Λ`, so that `Λ → k'` is surjective
with kernel `𝔪_Λ`. There is a canonical `Λ`-linear map

    𝔪_Λ/𝔪_Λ² ⟶ H₁(L_{k/Λ}),

obtained by identifying `𝔪_Λ/𝔪_Λ²` with `H₁(L_{k'/Λ})` and pushing forward along `k' → k`.
When `k/k'` is separable — in particular whenever `k` has characteristic zero — it induces an
isomorphism `𝔪_Λ/𝔪_Λ² ⊗_{k'} k = H₁(L_{k/Λ})`, and in the classical case `k = k'` it is
itself an isomorphism. For an object `A` of the base category the composite

    𝔪_Λ/𝔪_Λ² ⟶ H₁(L_{k/Λ}) ⟶ 𝔪_A/𝔪_A²

is the map induced by the structural map `𝔪_Λ → 𝔪_A`.

## Main definitions

* `Deformation.conormalToH1CotangentOfSurjective`: for a surjection `Λ → S` with kernel `I`,
  the canonical `Λ`-linear map `I/I² → H₁(L_{S/Λ})`.
* `Deformation.conormalToH1Cotangent`: **Stacks 06S9**, the canonical map
  `𝔪_Λ/𝔪_Λ² → H₁(L_{k/Λ})`.

## Main results

* `Deformation.conormalToH1Cotangent_baseChange_bijective`: the separable case, `k/k'`
  separable implies `𝔪_Λ/𝔪_Λ² ⊗_{k'} k = H₁(L_{k/Λ})`.
* `Deformation.conormalToH1Cotangent_bijective_of_surjective`: the classical case `k = k'`.
* `Deformation.conormalToH1Cotangent_comp`: the composite to `𝔪_A/𝔪_A²` is induced by
  `𝔪_Λ → 𝔪_A`.

## Implementation notes

The image field `k'` is represented by an arbitrary field `S` receiving a surjective map from
`Λ` and embedding in `k`; its kernel is `𝔪_Λ`. Since the conormal module of a surjection with
kernel `I` is annihilated by `I`, it is naturally a module over `Λ/𝔪_Λ = k'`, so extension of
scalars to `k` over `Λ` agrees with extension of scalars over `k'`, and the base change is
written over `Λ` throughout. For an object `A` of the base category the kernel of its residue
map to `k` is its maximal ideal, so the target of `conormalToH1Cotangent_comp` is `𝔪_A/𝔪_A²`.

The canonical map is built from the tautological extension `Λ → S` of a surjection together
with its canonical morphism into the polynomial presentation of `S` over `Λ`; in particular it
is a genuine map and not an arbitrarily chosen isomorphism, which is what makes the
compatibility statement meaningful. (The repository already records the *existence* of an
isomorphism `H₁(L_{S/Λ}) ≃ₗ[Λ] I/I²` for a surjection, Stacks 07BP, as
`h1Cotangent_equiv_cotangent_of_surjective`, but that one is extracted from a `Nonempty` and
so has no computed value.)

The separable case is the ind-étale base-change isomorphism
`Algebra.h1Cotangent_liftBaseChange_bijective_of_ind_etale`, applied to the ind-étale map
`k' → k` of `Deformation.ind_etale_of_isSeparable`. That lemma wants its two algebras in one
universe, so `S` and `k` are lifted into `Type (max v w)` with `ULift` and the conclusion is
transported back along the resulting ring equivalences.

## References

* [Stacks Project, Tag 06S9](https://stacks.math.columbia.edu/tag/06S9)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u v w

namespace Deformation

/-- A finite separable field extension is étale. -/
private theorem etale_algebraMap_of_isSeparable (S L : Type v) [Field S] [Field L]
    [Algebra S L] [FiniteDimensional S L] [Algebra.IsSeparable S L] :
    CommRingCat.etale (CommRingCat.ofHom (algebraMap S L)) := by
  have : Module.Free S L := Module.Free.of_divisionRing S L
  have : Algebra.FormallyEtale S L := Algebra.FormallyEtale.of_isSeparable S L
  rw [CommRingCat.etale_ofHom_iff, RingHom.Etale.iff_flat_and_formallyUnramified]
  refine ⟨?_, ?_, ?_⟩
  · rw [RingHom.flat_algebraMap_iff]
    infer_instance
  · exact RingHom.formallyUnramified_algebraMap.mpr inferInstance
  · rw [RingHom.finitePresentation_algebraMap]
    exact (Algebra.FinitePresentation.of_finiteType).mp inferInstance

/-- A separable algebraic field extension is a filtered colimit of étale algebras: every
finitely presented `S`-subalgebra of `K` lands in a finite separable, hence étale, subextension
generated by the images of finitely many generators. -/
private theorem ind_etale_of_isSeparable
    (S K : Type v) [Field S] [Field K] [Algebra S K]
    [Algebra.IsSeparable S K] :
    (CommAlgCat.etale.{v} S).ind.{v} (CommAlgCat.of S K) := by
  classical
  rw [CommAlgCat.ind_etale_iff_ind_algebraMap,
    MorphismProperty.ind_iff_ind_underMk,
    CommRingCat.ind_under_iff_exists_factorization _
      (fun (B : Under (CommRingCat.of S)) (hB : CommRingCat.etale.underObj B) =>
        (RingHom.Etale.iff_flat_and_formallyUnramified.mp hB).2.2)]
  intro A hA f
  let : Algebra S A.right := A.hom.hom.toAlgebra
  have hfp : (algebraMap S A.right).FinitePresentation := by
    rwa [RingHom.algebraMap_toAlgebra]
  let fA : A.right →ₐ[S] K :=
    { f.right.hom with
      commutes' := fun r => congrArg (fun q => q.hom r) (Under.w f) }
  obtain ⟨n, ⟨G⟩⟩ := Algebra.FiniteType.iff_exists_generators.mp
    (RingHom.FiniteType.of_finitePresentation hfp)
  let L : IntermediateField S K :=
    IntermediateField.adjoin S (Set.range (fun i : Fin n => fA (G.val i)))
  have hgen : Algebra.adjoin S (Set.range G.val) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact (AlgHom.range_eq_top (MvPolynomial.aeval G.val)).mpr G.aeval_val_surjective
  have hle : Algebra.adjoin S (Set.range G.val) ≤ L.toSubalgebra.comap fA :=
    Algebra.adjoin_le (Set.range_subset_iff.2 fun i =>
      IntermediateField.subset_adjoin S _ ⟨i, rfl⟩)
  have hmem : ∀ x : A.right, fA x ∈ L := fun x => hle (by simp [hgen])
  let fL : A.right →ₐ[S] L := fA.codRestrict L.toSubalgebra hmem
  let B : Under (CommRingCat.of S) := Under.mk (CommRingCat.ofHom (algebraMap S L))
  have : Algebra.IsSeparable S L := Algebra.IsSeparable.of_algHom S K L.val
  have : FiniteDimensional S L :=
    IntermediateField.finiteDimensional_adjoin
      (S := Set.range (fun i : Fin n => fA (G.val i)))
      (fun z _ => Algebra.IsSeparable.isIntegral S z)
  refine ⟨B, Under.homMk (CommRingCat.ofHom fL.toRingHom) ?_,
    Under.homMk (CommRingCat.ofHom L.val.toRingHom) ?_, ?_, etale_algebraMap_of_isSeparable S L⟩
  · ext s
    exact fL.commutes s
  · ext s
    exact L.val.commutes s
  · ext x
    rfl

variable {Λ : Type u} {S : Type v} {k : Type w}
  [CommRing Λ] [Field S] [Field k] [Algebra Λ S] [Algebra Λ k]
  [Algebra S k] [IsScalarTower Λ S k]

/-- The canonical morphism from the tautological extension of a surjection `Λ → S`, whose ring
is `Λ` itself, into the polynomial presentation of `S` over `Λ`. -/
public noncomputable def surjectiveToSelfHom
    (h : Function.Surjective (algebraMap Λ S)) :
    (Algebra.Extension.ofSurjective (Algebra.ofId Λ S) h).Hom
      (Algebra.Generators.self Λ S).toExtension := by
  let P₁ := (Algebra.Generators.self Λ S).toExtension
  refine ⟨(algebraMap Λ P₁.Ring : Λ →+* P₁.Ring), ?_, ?_⟩
  · intro x
    rw [Algebra.algebraMap_self]
    rfl
  · intro x
    change Λ at x
    change (algebraMap P₁.Ring S) ((algebraMap Λ P₁.Ring) x) =
      (algebraMap S S) ((algebraMap Λ S) x)
    rw [← IsScalarTower.algebraMap_apply Λ P₁.Ring S]
    rfl

/-- A section of `surjectiveToSelfHom`: the polynomial presentation of `S` over `Λ` maps into
the tautological extension of a surjection `Λ → S` by evaluating the variables at chosen
preimages. -/
private noncomputable def selfToSurjectiveHom
    (h : Function.Surjective (algebraMap Λ S)) :
    (Algebra.Generators.self Λ S).toExtension.Hom
      (Algebra.Extension.ofSurjective (Algebra.ofId Λ S) h) := by
  let P₁ := (Algebra.Generators.self Λ S).toExtension
  refine ⟨(MvPolynomial.aeval (fun b => Function.surjInv h b) :
      P₁.Ring →ₐ[Λ] Λ).toRingHom, ?_, ?_⟩
  · intro x
    change (MvPolynomial.aeval (fun b => Function.surjInv h b))
      ((algebraMap Λ (MvPolynomial S Λ)) x) = _
    simp only [MvPolynomial.algebraMap_eq, MvPolynomial.algHom_C, Algebra.algebraMap_self,
      RingHom.id_apply]
    rfl
  · intro x
    change (algebraMap Λ S) ((MvPolynomial.aeval (fun b => Function.surjInv h b) :
      MvPolynomial S Λ →ₐ[Λ] Λ) x) =
      (algebraMap S S) ((MvPolynomial.aeval (R := Λ) (S₁ := S) (fun b => b)) x)
    rw [Algebra.algebraMap_self, RingHom.id_apply]
    have hcomp : (algebraMap Λ S).comp ((MvPolynomial.aeval (fun b => Function.surjInv h b) :
        MvPolynomial S Λ →ₐ[Λ] Λ) : MvPolynomial S Λ →+* Λ) =
        (MvPolynomial.aeval (R := Λ) (S₁ := S) (fun b => b) : MvPolynomial S Λ →+* S) :=
      MvPolynomial.ringHom_ext (fun _ => by simp) (fun _ => by simp [Function.surjInv_eq h])
    exact RingHom.congr_fun hcomp x

/-- For a surjection `Λ → S` with kernel `I`, the first cotangent homology of the tautological
extension is the conormal module `I/I²`: the degree-zero term of its naive cotangent complex
is `S ⊗[Λ] Ω[Λ⁄Λ] = 0`, so the differential vanishes and its kernel is everything. -/
public noncomputable def surjectiveConormalEquiv
    (h : Function.Surjective (algebraMap Λ S)) :
    (RingHom.ker (algebraMap Λ S)).Cotangent ≃ₗ[Λ]
      (Algebra.Extension.ofSurjective (Algebra.ofId Λ S) h).H1Cotangent := by
  let P₀ := Algebra.Extension.ofSurjective (Algebra.ofId Λ S) h
  have hss : Subsingleton P₀.CotangentSpace := by
    have : Subsingleton (Ω[P₀.Ring⁄Λ]) :=
      KaehlerDifferential.subsingleton_of_surjective Λ Λ Function.surjective_id
    unfold Algebra.Extension.CotangentSpace
    infer_instance
  let e3 : P₀.H1Cotangent ≃ₗ[S] P₀.Cotangent := LinearEquiv.ofTop _
    (LinearMap.ker_eq_top.mpr (LinearMap.ext fun _ => Subsingleton.elim _ _))
  let e4 : P₀.Cotangent ≃ₗ[Λ] P₀.ker.Cotangent :=
    { toFun := Algebra.Extension.Cotangent.val
      invFun := Algebra.Extension.Cotangent.of
      map_add' := Algebra.Extension.Cotangent.val_add
      map_smul' := Algebra.Extension.Cotangent.val_smul''
      left_inv := Algebra.Extension.Cotangent.of_val
      right_inv := Algebra.Extension.Cotangent.val_of }
  exact e4.symm.trans (e3.symm.restrictScalars Λ)

/-- The canonical `Λ`-linear map `I/I² → H₁(L_{S/Λ})` attached to a surjection `Λ → S` with
kernel `I`: identify `I/I²` with the first cotangent homology of the tautological extension
of `Λ → S` and push forward along the canonical morphism into the polynomial presentation of
`S` over `Λ`. It is an isomorphism, because that morphism has a section. -/
public noncomputable def conormalToH1CotangentOfSurjective
    (h : Function.Surjective (algebraMap Λ S)) :
    (RingHom.ker (algebraMap Λ S)).Cotangent →ₗ[Λ] Algebra.H1Cotangent Λ S :=
  (Algebra.Extension.H1Cotangent.map (surjectiveToSelfHom h)).restrictScalars Λ ∘ₗ
    (surjectiveConormalEquiv h).toLinearMap

/-- **Stacks 06S9.** The canonical map `𝔪_Λ/𝔪_Λ² → H₁(L_{k/Λ})`, for `k'` the subfield of `k`
generated by the image of `Λ`, presented as a field `S` with `Λ → S` surjective and `S → k` an
extension: the conormal module of `Λ → S` maps to `H₁(L_{S/Λ})` and then to `H₁(L_{k/Λ})`. -/
@[stacks 06S9 "canonical map"]
public noncomputable def conormalToH1Cotangent
    (h : Function.Surjective (algebraMap Λ S)) :
    (RingHom.ker (algebraMap Λ S)).Cotangent →ₗ[Λ] Algebra.H1Cotangent Λ k :=
  (Algebra.H1Cotangent.map Λ Λ S k).restrictScalars Λ ∘ₗ
    conormalToH1CotangentOfSurjective (Λ := Λ) (S := S) h

/-- For a surjection `Λ → S` with kernel `I`, the canonical map `I/I² → H₁(L_{S/Λ})` is an
isomorphism: it is `surjectiveConormalEquiv` followed by the map on first cotangent homology
induced by a morphism of extensions which has a section. -/
private theorem conormalToH1CotangentOfSurjective_bijective
    (h : Function.Surjective (algebraMap Λ S)) :
    Function.Bijective (conormalToH1CotangentOfSurjective (Λ := Λ) (S := S) h) :=
  (Algebra.Extension.H1Cotangent.equiv (surjectiveToSelfHom h)
    (selfToSurjectiveHom h)).bijective.comp (surjectiveConormalEquiv h).bijective

/-- The same-universe case of `h1CotangentMap_liftBaseChange_bijective`, which is the ind-étale
base-change isomorphism for `Λ → F` surjective and `K/F` separable. -/
private theorem h1CotangentMap_liftBaseChange_bijective_of_isSeparable {F K : Type v} [Field F]
    [Field K] [Algebra Λ F] [Algebra Λ K] [Algebra F K] [IsScalarTower Λ F K]
    [Algebra.IsSeparable F K] (h : Function.Surjective (algebraMap Λ F)) :
    Function.Bijective
      (((Algebra.H1Cotangent.map Λ Λ F K).restrictScalars Λ).liftBaseChange K) := by
  let _ : TensorProduct.CompatibleSMul Λ F K (Algebra.H1Cotangent Λ F) :=
    TensorProduct.CompatibleSMul.of_algebraMap_surjective K _ h
  let eTensor := TensorProduct.equivOfCompatibleSMul Λ F K K (Algebra.H1Cotangent Λ F)
  have heq : ((Algebra.H1Cotangent.map Λ Λ F K).liftBaseChange K).comp eTensor.symm.toLinearMap =
      ((Algebra.H1Cotangent.map Λ Λ F K).restrictScalars Λ).liftBaseChange K := by
    refine TensorProduct.AlgebraTensorModule.ext fun a x => ?_
    simp [LinearMap.liftBaseChange_tmul, eTensor, TensorProduct.equivOfCompatibleSMul,
      TensorProduct.mapOfCompatibleSMul_tmul]
  rw [← heq, LinearMap.coe_comp]
  exact (Algebra.h1Cotangent_liftBaseChange_bijective_of_ind_etale Λ F K
    (ind_etale_of_isSeparable F K)).comp eTensor.symm.bijective

/-- For `Λ → S` surjective and `k/S` separable, the map `H₁(L_{S/Λ}) → H₁(L_{k/Λ})` becomes
bijective after extending scalars to `k` over `Λ`. -/
private theorem h1CotangentMap_liftBaseChange_bijective
    (h : Function.Surjective (algebraMap Λ S)) [Algebra.IsSeparable S k] :
    Function.Bijective
      (((Algebra.H1Cotangent.map Λ Λ S k).restrictScalars Λ).liftBaseChange k) := by
  let g := (Algebra.H1Cotangent.map Λ Λ S k).restrictScalars Λ
  let S' := ULift.{max v w} S
  let k' := ULift.{max v w} k
  let _ : Algebra (ULift.{max v w} S) k := ULift.algebra' S k
  let _ : Algebra (ULift.{max v w} S) (ULift.{max v w} k) := ULift.algebra
  have : IsScalarTower Λ S' k' := IsScalarTower.of_algebraMap_eq fun x =>
    congrArg ULift.up (IsScalarTower.algebraMap_apply Λ S k x)
  let eS : S ≃ₐ[Λ] S' := { ULift.ringEquiv.symm with commutes' := fun _ => rfl }
  let eK : k ≃ₐ[Λ] k' := { ULift.ringEquiv.symm with commutes' := fun _ => rfl }
  have : Algebra.IsSeparable S' k' := Algebra.IsSeparable.of_equiv_equiv
    (A₁ := S) (B₁ := k) (A₂ := S') (B₂ := k') eS.toRingEquiv eK.toRingEquiv (by ext; rfl)
  let S'₁ := Algebra.H1Cotangent.mapEquiv Λ S S' eS
  let k'₁ := Algebra.H1Cotangent.mapEquiv Λ k k' eK
  let g' := (Algebra.H1Cotangent.map Λ Λ S' k').restrictScalars Λ
  let eIn := TensorProduct.map eK.toLinearMap S'₁.toLinearMap
  have hnat : g'.comp S'₁.toLinearMap = k'₁.toLinearMap.comp g := by
    unfold g g' S'₁ k'₁
    refine LinearMap.ext fun x => ?_
    show Algebra.Extension.H1Cotangent.map
        ((Algebra.Generators.defaultHom (Algebra.Generators.self Λ S')
          (Algebra.Generators.self Λ k')).toExtensionHom)
        (Algebra.Extension.H1Cotangent.map
          ((Algebra.Generators.defaultHom (Algebra.Generators.self Λ S)
            (Algebra.Generators.self Λ S')).toExtensionHom) x) =
      Algebra.Extension.H1Cotangent.map
        ((Algebra.Generators.defaultHom (Algebra.Generators.self Λ k)
          (Algebra.Generators.self Λ k')).toExtensionHom)
        (Algebra.Extension.H1Cotangent.map
          ((Algebra.Generators.defaultHom (Algebra.Generators.self Λ S)
            (Algebra.Generators.self Λ k)).toExtensionHom) x)
    rw [← Algebra.Extension.H1Cotangent.map_comp_apply,
      ← Algebra.Extension.H1Cotangent.map_comp_apply, Algebra.Extension.H1Cotangent.map_eq]
  have hgbLiftRestr : Function.Bijective (g'.liftBaseChange k') :=
    h1CotangentMap_liftBaseChange_bijective_of_isSeparable
      fun x => (h x.down).imp fun _ hy => congrArg ULift.up hy
  have hcomm : ((g'.liftBaseChange k').restrictScalars Λ).comp eIn =
      k'₁.toLinearMap.comp ((g.liftBaseChange k).restrictScalars Λ) := by
    refine TensorProduct.AlgebraTensorModule.ext fun a x => ?_
    show (g'.liftBaseChange k') (eK a ⊗ₜ[Λ] S'₁ x) =
      k'₁ ((g.liftBaseChange k) (a ⊗ₜ[Λ] x))
    rw [LinearMap.liftBaseChange_tmul, LinearMap.liftBaseChange_tmul,
      show k'₁ (a • g x) = eK a • k'₁ (g x) by
        show (Algebra.H1Cotangent.map Λ Λ k k') (a • g x) = _
        exact LinearMap.map_smul _ a (g x)]
    exact congrArg (fun z => eK a • z) (DFunLike.congr_fun hnat x)
  have hb : Function.Bijective (k'₁.toLinearMap ∘ₗ (g.liftBaseChange k).restrictScalars Λ) := by
    rw [← hcomm]
    exact hgbLiftRestr.comp (TensorProduct.map_bijective eK.bijective S'₁.bijective)
  exact (k'₁.bijective.of_comp_iff' (g.liftBaseChange k)).mp hb

/-- **Stacks 06S9.** When `k` is separable over the image field `S = k'`, the canonical map
induces an isomorphism `𝔪_Λ/𝔪_Λ² ⊗_{k'} k = H₁(L_{k/Λ})`. The base change is written over `Λ`,
which is the same thing: the conormal module of `Λ → S` is annihilated by its kernel, hence is
a module over `Λ/𝔪_Λ = k'`. -/
@[stacks 06S9 "separable case"]
public theorem conormalToH1Cotangent_baseChange_bijective
    (h : Function.Surjective (algebraMap Λ S))
    [Algebra.IsSeparable S k] :
    Function.Bijective
      ((conormalToH1Cotangent (Λ := Λ) (S := S) (k := k) h).liftBaseChange k) := by
  let f := conormalToH1CotangentOfSurjective (Λ := Λ) (S := S) h
  let g := (Algebra.H1Cotangent.map Λ Λ S k).restrictScalars Λ
  let e : (RingHom.ker (algebraMap Λ S)).Cotangent ≃ₗ[Λ] Algebra.H1Cotangent Λ S :=
    LinearEquiv.ofBijective f (conormalToH1CotangentOfSurjective_bijective (Λ := Λ) (S := S) h)
  have hfb : Function.Bijective (f.baseChange k) := by
    have heq : f.baseChange k =
        (LinearEquiv.baseChange Λ k _ _ e).toLinearMap := by
      refine TensorProduct.AlgebraTensorModule.ext fun a x => ?_
      simp [e]
    rw [heq]
    exact (LinearEquiv.baseChange Λ k _ _ e).bijective
  have hcomp : (g.comp f).liftBaseChange k =
      g.liftBaseChange k ∘ₗ f.baseChange k := by
    refine TensorProduct.AlgebraTensorModule.ext fun a x => ?_
    simp only [LinearMap.comp_apply, LinearMap.baseChange_tmul,
      LinearMap.liftBaseChange_tmul]
  show Function.Bijective ((g.comp f).liftBaseChange k)
  rw [hcomp]
  exact (h1CotangentMap_liftBaseChange_bijective h).comp hfb

/-- **Stacks 06S9.** In the classical case `k = k'`, that is `Λ → k` surjective, the canonical
map `𝔪_Λ/𝔪_Λ² → H₁(L_{k/Λ})` is itself an isomorphism. -/
@[stacks 06S9 "classical case"]
public theorem conormalToH1Cotangent_bijective_of_surjective
    (h : Function.Surjective (algebraMap Λ k)) :
    Function.Bijective
      (conormalToH1Cotangent (Λ := Λ) (S := k) (k := k) h) := by
  have hout : Function.Bijective
      ((Algebra.H1Cotangent.map Λ Λ k k).restrictScalars Λ) := by
    show Function.Bijective
      ((Algebra.Extension.H1Cotangent.map
        (Algebra.Generators.defaultHom (Algebra.Generators.self Λ k)
          (Algebra.Generators.self Λ k)).toExtensionHom).restrictScalars Λ)
    exact (Algebra.Extension.H1Cotangent.equiv
      (Algebra.Generators.defaultHom (Algebra.Generators.self Λ k)
        (Algebra.Generators.self Λ k)).toExtensionHom
      (Algebra.Generators.defaultHom (Algebra.Generators.self Λ k)
        (Algebra.Generators.self Λ k)).toExtensionHom).bijective
  exact hout.comp (conormalToH1CotangentOfSurjective_bijective h)

/-- For two factorizations `Λ → S → k` and `Λ → A → k` of the same map, the kernel of `Λ → S`
is carried into the kernel of `A → k` by `Λ → A`. For `A` an object of the base category, this
is the inclusion `𝔪_Λ → 𝔪_A`. -/
public theorem ker_algebraMap_le_comap_ker
    {A : Type*} [CommRing A] [Algebra Λ A] [Algebra A k]
    [IsScalarTower Λ A k] :
    RingHom.ker (algebraMap Λ S) ≤
      (RingHom.ker (algebraMap A k)).comap (algebraMap Λ A) := by
  intro x hx
  show (algebraMap A k) ((algebraMap Λ A) x) = 0
  rw [← IsScalarTower.algebraMap_apply Λ A k, IsScalarTower.algebraMap_apply Λ S k,
    RingHom.mem_ker.mp hx, map_zero]

/-- **Stacks 06S9.** The composite `𝔪_Λ/𝔪_Λ² → H₁(L_{k/Λ}) → H₁(L_{k/A})` is the map induced
by the structural map `𝔪_Λ → 𝔪_A`: for `A` with `Λ → A → k` and `A → k` surjective, pushing a
class of `𝔪_Λ/𝔪_Λ²` forward to `H₁(L_{k/A})` agrees with taking its image in `𝔪_A/𝔪_A²` and
applying the canonical map of `A → k`. Since the canonical map of `A → k` is an isomorphism by
`conormalToH1Cotangent_bijective_of_surjective`, this identifies the composite
`𝔪_Λ/𝔪_Λ² → H₁(L_{k/Λ}) → 𝔪_A/𝔪_A²` of the source. -/
@[stacks 06S9 "compatibility with the conormal map"]
public theorem conormalToH1Cotangent_comp
    {A : Type*} [CommRing A] [Algebra Λ A] [Algebra A k]
    [IsScalarTower Λ A k]
    (h : Function.Surjective (algebraMap Λ S))
    (hg : Function.Surjective (algebraMap A k))
    (x : (RingHom.ker (algebraMap Λ S)).Cotangent) :
    Algebra.H1Cotangent.map Λ A k k
        (conormalToH1Cotangent (Λ := Λ) (S := S) (k := k) h x) =
      conormalToH1Cotangent (Λ := A) (S := k) (k := k) hg
        (Ideal.mapCotangent (RingHom.ker (algebraMap Λ S))
          (RingHom.ker (algebraMap A k)) (Algebra.ofId Λ A)
          (ker_algebraMap_le_comap_ker (Λ := Λ) (S := S) (k := k) (A := A)) x) := by
  obtain ⟨y, rfl⟩ := (RingHom.ker (algebraMap Λ S)).toCotangent_surjective x
  let I := RingHom.ker (algebraMap Λ S)
  let J := RingHom.ker (algebraMap A k)
  have hle : I ≤ J.comap (Algebra.ofId Λ A) :=
    ker_algebraMap_le_comap_ker (Λ := Λ) (S := S) (k := k) (A := A)
  let P := Algebra.Extension.ofSurjective (Algebra.ofId Λ S) h
  let Q := Algebra.Extension.ofSurjective (Algebra.ofId A k) hg
  let t : P.Hom Q :=
    { toRingHom := algebraMap Λ A
      toRingHom_algebraMap := fun _ => rfl
      algebraMap_toRingHom := by
        intro z
        change Λ at z
        show (algebraMap A k) ((algebraMap Λ A) z) =
          (algebraMap S k) ((algebraMap Λ S) z)
        rw [← IsScalarTower.algebraMap_apply Λ A k,
          ← IsScalarTower.algebraMap_apply Λ S k] }
  let f := surjectiveToSelfHom h
  let g := surjectiveToSelfHom hg
  let u :=
    (Algebra.Generators.defaultHom (Algebra.Generators.self Λ S)
      (Algebra.Generators.self Λ k)).toExtensionHom
  let v :=
    (Algebra.Generators.defaultHom (Algebra.Generators.self Λ k)
      (Algebra.Generators.self A k)).toExtensionHom
  let zP := (surjectiveConormalEquiv h) (I.toCotangent y)
  let zQ := (surjectiveConormalEquiv hg)
    (J.toCotangent ⟨algebraMap Λ A y, hle y.2⟩)
  have hbridge : Algebra.Extension.H1Cotangent.map t zP = zQ := by
    apply Subtype.ext
    show Algebra.Extension.Cotangent.map t (Algebra.Extension.Cotangent.of (I.toCotangent y)) =
      Algebra.Extension.Cotangent.of (J.toCotangent ⟨algebraMap Λ A y, hle y.2⟩)
    apply Algebra.Extension.Cotangent.ext
    show Ideal.mapCotangent I J (Algebra.ofId Λ A) hle (I.toCotangent y) = _
    rw [Ideal.mapCotangent_toCotangent]
    rfl
  let r :=
    (Algebra.Generators.defaultHom (Algebra.Generators.self A k)
      (Algebra.Generators.self A k)).toExtensionHom
  have hpath : Algebra.Extension.H1Cotangent.map v
      (Algebra.Extension.H1Cotangent.map u
        (Algebra.Extension.H1Cotangent.map f zP)) =
      Algebra.Extension.H1Cotangent.map r
        (Algebra.Extension.H1Cotangent.map g (Algebra.Extension.H1Cotangent.map t zP)) := by
    simpa only [Algebra.Extension.H1Cotangent.map_comp_apply] using
      congrArg (fun F => F zP)
        (Algebra.Extension.H1Cotangent.map_eq (v.comp (u.comp f)) (r.comp (g.comp t)))
  exact hpath.trans (congrArg (Algebra.Extension.H1Cotangent.map r)
    (congrArg (Algebra.Extension.H1Cotangent.map g) hbridge))

end Deformation

end
