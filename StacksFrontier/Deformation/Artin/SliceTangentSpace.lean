module

public import StacksFrontier.Algebra.Module.OppositeOfCommSemiring
public import StacksFrontier.Deformation.Artin.RimSchlessinger.Slice
public import StacksFrontier.Deformation.TangentSpace.FiniteDimensional
public import StacksFrontier.Deformation.TangentSpace.LiftedComparison
public import StacksFrontier.Deformation.Applications.TwoFibreProductSixTermExact

/-!
# The tangent space of a point of a scheme

Let `S` be a scheme, `V` a scheme over `S` in the big fppf site which is locally of finite type
over `S`, and `v₀` a point of the represented category `(Sch/V)_{fppf}` over `Spec k`, for `k` a
field of finite type over `S` with `Spec k → S` factoring through an affine open `Spec Λ ⊂ S`.
This file proves that the tangent space of the deformation category `𝓕_{(Sch/V),k,v₀}` is
finite dimensional over `k`. This is the case of Stacks 07X1 in which the algebraic stack is
represented by a scheme, and it is the last step of the proof of Stacks 07X1.

The argument is the one of the source. Choose an affine open `U = Spec R` of `V` containing the
image of `v₀` and lying over `Spec Λ`; then `R` is of finite type over `Λ`, generated by finitely
many elements `f₁, …, fₙ`. A deformation of `v₀` over an Artinian local `Λ`-algebra `A` is a
morphism `Spec A ⟶ V` lying over `S`; since `Spec A` has a single point it lands in `U`, so it is
a `Λ`-algebra map `R ⟶ A`, and such a map is determined by its values on the `fᵢ`. Over the
square-zero extension `k[W] = k ⊕ W` its reduction is fixed, so the deformation is determined by
the `W`-components of those values: this gives an injection of `𝓕(k[W])` into `W^n`, natural in
`W`, and the finiteness criterion
`Deformation.finiteDimensional_artinianTangentSpace_of_natural_injection` applies.

## Main definitions

* `Deformation.Artin.SliceTangent.deformationMap` — the morphism to `V` underlying a deformation.
* `Deformation.Artin.SliceTangent.AffineChart` — an affine open neighbourhood of a point over
  `Spec Λ`, with its ring map `AffineChart.ringMap` out of its ring of sections.
* `Deformation.Artin.SliceTangent.tangentMap` — the natural map `𝓕(k[W]) ⟶ W^n`.

## Main results

* `Deformation.Artin.SliceTangent.isDeformationCategory_sliceDeformations` — the deformation
  category of a point of a scheme is a deformation category.
* `Deformation.Artin.SliceTangent.finiteDimensional_tangentSpaceArtinian_sliceBased` — its tangent
  space is finite dimensional.

## Implementation notes

The source bounds the dimension by the number of generators of the maximal ideal of `R` at the
point; the receptacle `W^n` used here is indexed by algebra generators of `R` over `Λ` instead,
since a `Λ`-algebra map is determined by its values on algebra generators and the residue field
of `R` at the point need not be `Λ`-rational.

## References

* [Stacks Project, Tag 07X1](https://stacks.math.columbia.edu/tag/07X1)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace Deformation.Artin.SliceTangent

universe u

-- `Over.post`, the fibres of a functor and their inclusion are plain `def`s, so goals mentioning
-- an object of the site read in `Over S` are not type-correct at `implicit` transparency.
attribute [local implicit_reducible] CategoryTheory.Functor.Fiber CategoryTheory.Functor.Fiber.mk
  CategoryTheory.Functor.Fiber.fiberInclusion

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {V : BigFppfOver B S hS}
variable {Λ k : Type u} [CommRing Λ] [Field k] [Algebra Λ k] {iΛ : Spec (.of Λ) ⟶ S}
variable {v₀ : Over V}
variable {hv₀ : (Over.forget V ⋙ Over.post B.inclusion).obj v₀ =
  Over.mk (Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ)}

/-- The underlying morphism of schemes to `V` of a deformation of a point of `(Sch/V)`. -/
def deformationMap (d : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀) :
    Spec (.of d.algebra) ⟶ B.inclusion.obj V.left :=
  eqToHom (congrArg Over.left d.base).symm ≫ B.inclusion.map d.point.hom.left

/-- The underlying morphism of schemes to `V` of the point `v₀` itself. -/
def pointMap (hv₀ : (Over.forget V ⋙ Over.post B.inclusion).obj v₀ =
    Over.mk (Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ)) :
    Spec (.of k) ⟶ B.inclusion.obj V.left :=
  eqToHom (congrArg Over.left hv₀).symm ≫ B.inclusion.map v₀.hom.left

private lemma over_hom_eq {C : Type*} [Category C] {T : C} {X Y : Over T} (h : X = Y) :
    X.hom = eqToHom (congrArg Over.left h) ≫ Y.hom := by
  subst h; simp

private lemma eqToHom_inclusion_comp {P : Over V} {T}
    (h : (Over.forget V ⋙ Over.post B.inclusion).obj P = T) :
    eqToHom (congrArg Over.left h).symm ≫ B.inclusion.map P.hom.left ≫ B.inclusion.map V.hom =
      T.hom := by
  have hw : P.hom.left ≫ V.hom = P.left.hom := Over.w P.hom
  rw [← Functor.map_comp, hw]
  change eqToHom _ ≫ ((Over.forget V ⋙ Over.post B.inclusion).obj P).hom = _
  rw [over_hom_eq h, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]

/-- A deformation lies over `S` through `Spec Λ`. -/
theorem deformationMap_comp
    (d : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀) :
    deformationMap d ≫ B.inclusion.map V.hom =
      Spec.map (CommRingCat.ofHom (algebraMap Λ d.algebra)) ≫ iΛ :=
  (Category.assoc _ _ _).trans (eqToHom_inclusion_comp d.base)

/-- A morphism of deformations of a point of `(Sch/V)` is read on morphisms to `V` as
precomposition with the spectrum of its ring map. -/
theorem deformationMap_of_morphism
    {a b : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    (m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ a b) :
    deformationMap b =
      Spec.map (CommRingCat.ofHom m.ringHom.hom.toRingHom) ≫ deformationMap a := by
  have hb := m.arrow_base
  have hw : m.arrow.left.left ≫ a.point.hom.left = b.point.hom.left :=
    congrArg (fun f => f.left) (Over.w m.arrow)
  rw [← hb]
  simp only [deformationMap, Category.assoc]
  rw [eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  change _ = eqToHom _ ≫ B.inclusion.map m.arrow.left.left ≫ B.inclusion.map a.point.hom.left
  rw [← Functor.map_comp, hw]

/-- The closed point of a deformation is the point `v₀`. -/
theorem residue_deformationMap
    (d : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀) :
    Spec.map (CommRingCat.ofHom (residueMap d.algebra)) ≫ deformationMap d = pointMap hv₀ := by
  have hb := d.arrow_base
  have hw : d.arrow.left.left ≫ d.point.hom.left = v₀.hom.left :=
    congrArg (fun f => f.left) (Over.w d.arrow)
  rw [← hb]
  simp only [deformationMap, pointMap, Category.assoc]
  rw [eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  change eqToHom _ ≫ B.inclusion.map d.arrow.left.left ≫ B.inclusion.map d.point.hom.left = _
  rw [← Functor.map_comp, hw]

/-- The arrow of a deformation lies over the residue map. -/
private lemma inclusion_map_arrow_eq
    (d : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀) :
    B.inclusion.map d.arrow.left.left = eqToHom (congrArg Over.left hv₀) ≫
      Spec.map (CommRingCat.ofHom (residueMap d.algebra)) ≫
        eqToHom (congrArg Over.left d.base).symm := by
  rw [← d.arrow_base]
  change _ = eqToHom _ ≫ (eqToHom _ ≫ B.inclusion.map d.arrow.left.left ≫ eqToHom _) ≫ eqToHom _
  simp

/-- Two deformations over the same algebra with the same morphism to `V` are joined by a
morphism of deformations over the identity. -/
theorem exists_morphism_of_deformationMap_eq
    {a b : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    (hA : a.algebra = b.algebra)
    (h : deformationMap b =
      Spec.map (CommRingCat.ofHom (eqToHom hA).hom.toRingHom) ≫ deformationMap a) :
    ∃ m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ a b,
      m.ringHom = eqToHom hA := by
  rcases a with ⟨A, P, α, base, abase⟩
  rcases b with ⟨A', P', α', base', abase'⟩
  change A = A' at hA
  subst hA
  simp only [eqToHom_refl, ArtinianLocalAlgCat.id_hom] at h
  rw [show (AlgHom.id Λ A).toRingHom = RingHom.id A from rfl, CommRingCat.ofHom_id, Spec.map_id,
    Category.id_comp] at h
  have hP : B.inclusion.obj P.left.left = Spec (.of A) := congrArg Over.left base
  have hP' : B.inclusion.obj P'.left.left = Spec (.of A) := congrArg Over.left base'
  let g0 : P'.left.left ⟶ P.left.left := B.inclusion.preimage (eqToHom (hP'.trans hP.symm))
  have hg0 : B.inclusion.map g0 = eqToHom (hP'.trans hP.symm) := Functor.map_preimage _ _
  have hPh := over_hom_eq base
  have hP'h := over_hom_eq base'
  have w0 : g0 ≫ P.left.hom = P'.left.hom := by
    apply B.inclusion.map_injective
    rw [Functor.map_comp, hg0]
    change eqToHom _ ≫ ((Over.forget V ⋙ Over.post B.inclusion).obj P).hom =
      ((Over.forget V ⋙ Over.post B.inclusion).obj P').hom
    rw [hPh, hP'h, eqToHom_trans_assoc]
  let gL : P'.left ⟶ P.left := Over.homMk g0 w0
  have w1 : gL ≫ P.hom = P'.hom := by
    apply Over.OverMorphism.ext
    apply B.inclusion.map_injective
    change B.inclusion.map (g0 ≫ P.hom.left) = B.inclusion.map P'.hom.left
    rw [Functor.map_comp, hg0]
    have h' := h
    simp only [deformationMap] at h'
    rw [← cancel_epi (eqToHom hP'.symm), h', eqToHom_trans_assoc]
  let arrow : P' ⟶ P := Over.homMk gL w1
  have harrow : B.inclusion.map arrow.left.left = eqToHom (hP'.trans hP.symm) := hg0
  refine ⟨⟨𝟙 _, arrow, ?_, ?_⟩, rfl⟩
  · apply Over.OverMorphism.ext
    apply Over.OverMorphism.ext
    apply B.inclusion.map_injective
    change B.inclusion.map (α'.left.left ≫ arrow.left.left) = B.inclusion.map α.left.left
    rw [Functor.map_comp, harrow]
    have e1 := inclusion_map_arrow_eq (hv₀ := hv₀) ⟨A, P, α, base, abase⟩
    have e2 := inclusion_map_arrow_eq (hv₀ := hv₀) ⟨A, P', α', base', abase'⟩
    rw [e1, e2]
    simp
  · change eqToHom _ ≫ B.inclusion.map arrow.left.left ≫ eqToHom _ = _
    rw [harrow]
    simp only [eqToHom_trans, eqToHom_refl, ArtinianLocalAlgCat.id_hom]
    rw [show (AlgHom.id Λ A).toRingHom = RingHom.id A from rfl, CommRingCat.ofHom_id, Spec.map_id]
    rfl

/-! ### An affine chart of `V` at the point -/

/-- The closed point of the spectrum of a local ring, as a point of the scheme. -/
def closedPt (R : CommRingCat.{u}) [IsLocalRing R] : Spec R := IsLocalRing.closedPoint R

section Chart

variable {Y : Scheme.{u}} (s : Y ⟶ S) (iΛ) [IsOpenImmersion iΛ] (y₀ : Y)

/-- An affine open neighbourhood of `y₀` in `Y` lying over the open `Spec Λ` of `S`. -/
structure AffineChart where
  /-- The affine open. -/
  U : Y.Opens
  isAffineOpen : IsAffineOpen U
  mem : y₀ ∈ U
  le : (U : Set Y) ⊆ s.base ⁻¹' Set.range iΛ.base

variable {s iΛ y₀}

theorem nonempty_affineChart (hy₀ : s.base y₀ ∈ Set.range iΛ.base) :
    Nonempty (AffineChart iΛ s y₀) := by
  let W : Y.Opens := s ⁻¹ᵁ iΛ.opensRange
  have hW : y₀ ∈ W := by
    change s.base y₀ ∈ (iΛ.opensRange : Set S)
    simpa [Scheme.Hom.coe_opensRange] using hy₀
  obtain ⟨U', hU', hy, hle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens Y)) hW
  refine ⟨⟨U', hU', hy, fun z hz => ?_⟩⟩
  have := hle hz
  change s.base z ∈ (iΛ.opensRange : Set S) at this
  simpa [Scheme.Hom.coe_opensRange] using this

variable (c : AffineChart iΛ s y₀)

/-- The ring of the chart. -/
abbrev AffineChart.ring : CommRingCat.{u} := Γ(Y, c.U)

/-- The chart as an open immersion of the spectrum of its ring. -/
abbrev AffineChart.fromSpec : Spec c.ring ⟶ Y := c.isAffineOpen.fromSpec

omit [IsOpenImmersion iΛ] in
theorem AffineChart.range_comp :
    Set.range (c.fromSpec ≫ s).base ⊆ Set.range iΛ.base := by
  rintro _ ⟨z, rfl⟩
  have hz : c.fromSpec.base z ∈ (c.U : Set Y) := by
    rw [← c.isAffineOpen.range_fromSpec]; exact ⟨z, rfl⟩
  exact c.le hz

/-- The structure map `Λ ⟶ Γ(Y, U)` of the chart. -/
def AffineChart.structureMap : CommRingCat.of Λ ⟶ c.ring :=
  Spec.preimage (IsOpenImmersion.lift iΛ (c.fromSpec ≫ s) c.range_comp)

theorem AffineChart.spec_structureMap :
    Spec.map c.structureMap ≫ iΛ = c.fromSpec ≫ s := by
  rw [AffineChart.structureMap, Spec.map_preimage, IsOpenImmersion.lift_fac]

theorem AffineChart.finiteType_structureMap [LocallyOfFiniteType s] :
    c.structureMap.hom.FiniteType := by
  have : LocallyOfFiniteType (Spec.map c.structureMap ≫ iΛ) := by
    rw [c.spec_structureMap]; infer_instance
  have : LocallyOfFiniteType (Spec.map c.structureMap) :=
    locallyOfFiniteType_of_comp _ iΛ
  exact HasRingHomProperty.Spec_iff.mp this

/-- The ring map out of the chart attached to a morphism `Spec A ⟶ Y` landing in the chart. -/
def AffineChart.ringMap {A : CommRingCat.{u}} (g : Spec A ⟶ Y)
    (hg : Set.range g.base ⊆ c.U) : c.ring ⟶ A :=
  Spec.preimage (IsOpenImmersion.lift c.fromSpec g (by rwa [c.isAffineOpen.range_fromSpec]))

omit [IsOpenImmersion iΛ] in
theorem AffineChart.spec_ringMap {A : CommRingCat.{u}} (g : Spec A ⟶ Y)
    (hg : Set.range g.base ⊆ c.U) : Spec.map (c.ringMap g hg) ≫ c.fromSpec = g := by
  rw [AffineChart.ringMap, Spec.map_preimage, IsOpenImmersion.lift_fac]

omit [IsOpenImmersion iΛ] in
theorem AffineChart.ringMap_injective {A : CommRingCat.{u}} {g g' : Spec A ⟶ Y}
    (hg : Set.range g.base ⊆ c.U) (hg' : Set.range g'.base ⊆ c.U)
    (h : c.ringMap g hg = c.ringMap g' hg') : g = g' := by
  rw [← c.spec_ringMap g hg, ← c.spec_ringMap g' hg', h]

omit [IsOpenImmersion iΛ] in
theorem AffineChart.ringMap_comp {A A' : CommRingCat.{u}} (β : A ⟶ A') (g : Spec A ⟶ Y)
    (hg : Set.range g.base ⊆ c.U) (hg' : Set.range (Spec.map β ≫ g).base ⊆ c.U) :
    c.ringMap (Spec.map β ≫ g) hg' = c.ringMap g hg ≫ β := by
  apply Spec.map_injective
  apply (cancel_mono c.fromSpec).mp
  rw [c.spec_ringMap, Spec.map_comp, Category.assoc, c.spec_ringMap]

theorem AffineChart.structureMap_ringMap {A : CommRingCat.{u}} (α : CommRingCat.of Λ ⟶ A)
    (g : Spec A ⟶ Y) (hg : Set.range g.base ⊆ c.U) (h : g ≫ s = Spec.map α ≫ iΛ) :
    c.structureMap ≫ c.ringMap g hg = α := by
  apply Spec.map_injective
  apply (cancel_mono iΛ).mp
  rw [Spec.map_comp, Category.assoc, c.spec_structureMap, ← Category.assoc, c.spec_ringMap, h]

omit [IsOpenImmersion iΛ] in
/-- A morphism out of the spectrum of a local ring whose closed point maps into the chart
lands in the chart. -/
theorem AffineChart.range_subset {A : CommRingCat.{u}} [IsLocalRing A] (g : Spec A ⟶ Y)
    (hg : g.base (closedPt A) ∈ c.U) : Set.range g.base ⊆ c.U := by
  rintro _ ⟨x, rfl⟩
  exact ((IsLocalRing.specializes_closedPoint x).map g.base.hom.continuous).mem_open
    c.U.isOpen hg

end Chart

/-! ### The ring map out of a chart attached to a deformation -/

section Value

/-- The spectrum of an arrow of `𝒞_Λ`. -/
abbrev specMap {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k} (β : A ⟶ A') :
    Spec (.of A') ⟶ Spec (.of A) :=
  Spec.map (CommRingCat.ofHom β.hom.toRingHom)

theorem specMap_comp {A A' A'' : ArtinianLocalAlgCat.{u, u, u} Λ k} (β : A ⟶ A')
    (γ : A' ⟶ A'') : specMap (β ≫ γ) = specMap γ ≫ specMap β := by
  simp only [specMap, ArtinianLocalAlgCat.comp_hom]
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rfl

theorem specMap_id (A : ArtinianLocalAlgCat.{u, u, u} Λ k) : specMap (𝟙 A) = 𝟙 _ := by
  simp only [specMap, ArtinianLocalAlgCat.id_hom]
  rw [show (AlgHom.id Λ A).toRingHom = RingHom.id A from rfl, CommRingCat.ofHom_id, Spec.map_id]

@[reassoc]
theorem specMap_eqToHom_comp {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k} (h : A = A') :
    specMap (eqToHom h) ≫ specMap (eqToHom h.symm) = 𝟙 _ := by
  subst h; simp [specMap_id]

theorem pointMap_comp :
    pointMap hv₀ ≫ B.inclusion.map V.hom =
      Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ :=
  (Category.assoc _ _ _).trans (eqToHom_inclusion_comp hv₀)

/-- The morphism to `V` of a deformation, read over a given algebra equal to its own. -/
def chartPointMap (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    Spec (.of A) ⟶ B.inclusion.obj V.left :=
  specMap (eqToHom hx) ≫ deformationMap x

theorem residue_chartPointMap
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    Spec.map (CommRingCat.ofHom (residueMap A)) ≫ chartPointMap x hx = pointMap hv₀ := by
  subst hx
  rw [chartPointMap, eqToHom_refl, specMap_id, Category.id_comp, residue_deformationMap]

theorem chartPointMap_comp
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    chartPointMap x hx ≫ B.inclusion.map V.hom =
      Spec.map (CommRingCat.ofHom (algebraMap Λ A)) ≫ iΛ := by
  subst hx
  rw [chartPointMap, eqToHom_refl, specMap_id, Category.id_comp, deformationMap_comp]

theorem chartPointMap_of_morphism
    {x y : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) (hy : y.algebra = A')
    (m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ x y)
    (β : A ⟶ A') (hm : m.ringHom = eqToHom hx ≫ β ≫ eqToHom hy.symm) :
    chartPointMap y hy = specMap β ≫ chartPointMap x hx := by
  rw [chartPointMap, chartPointMap, deformationMap_of_morphism m]
  change specMap (eqToHom hy) ≫ specMap m.ringHom ≫ _ = _
  rw [hm, specMap_comp, specMap_comp]
  simp only [Category.assoc]
  rw [specMap_eqToHom_comp_assoc]

/-- A residue map of `𝒞_Λ` is a local homomorphism. -/
instance isLocalHom_residueMap (A : ArtinianLocalAlgCat.{u, u, u} Λ k) :
    IsLocalHom (residueMap A) := by
  unfold residueMap
  infer_instance

theorem closedPoint_eq (A : ArtinianLocalAlgCat.{u, u, u} Λ k) :
    (Spec.map (CommRingCat.ofHom (residueMap A))).base (closedPt (.of k)) =
      closedPt (.of A) := by
  rw [Spec.map_base]
  exact IsLocalRing.comap_closedPoint (residueMap A)

variable [IsOpenImmersion iΛ] (c : AffineChart iΛ (B.inclusion.map V.hom)
  ((pointMap hv₀).base (closedPt (.of k))))

omit [IsOpenImmersion iΛ] in
theorem AffineChart.ringMap_congr {Y : Scheme.{u}} {s' : Y ⟶ S} {y : Y}
    (c' : AffineChart iΛ s' y) {A : CommRingCat.{u}} {g g' : Spec A ⟶ Y}
    (hg : Set.range g.base ⊆ c'.U) (hg' : Set.range g'.base ⊆ c'.U) (h : g = g') :
    c'.ringMap g hg = c'.ringMap g' hg' := by
  subst h; rfl

omit [IsOpenImmersion iΛ] in
theorem range_pointMap : Set.range (pointMap hv₀).base ⊆ c.U := by
  rintro _ ⟨z, rfl⟩
  have hz : z = closedPt (.of k) := Subsingleton.elim _ _
  rw [hz]
  exact c.mem

omit [IsOpenImmersion iΛ] in
theorem range_chartPointMap
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    Set.range (chartPointMap x hx).base ⊆ c.U := by
  apply c.range_subset (A := CommRingCat.of A)
  rw [← closedPoint_eq A, ← Scheme.Hom.comp_apply, residue_chartPointMap]
  exact c.mem

/-- The ring map out of the chart attached to a deformation. -/
def chartValue (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    c.ring ⟶ CommRingCat.of A :=
  c.ringMap (chartPointMap x hx) (range_chartPointMap c x hx)

omit [IsOpenImmersion iΛ] in
theorem chartValue_of_morphism
    {x y : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) (hy : y.algebra = A')
    (m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ x y)
    (β : A ⟶ A') (hm : m.ringHom = eqToHom hx ≫ β ≫ eqToHom hy.symm) :
    chartValue c y hy = chartValue c x hx ≫ CommRingCat.ofHom β.hom.toRingHom := by
  have h := chartPointMap_of_morphism hx hy m β hm
  rw [chartValue, chartValue, ← c.ringMap_comp _ _ _ (h ▸ range_chartPointMap c y hy)]
  exact AffineChart.ringMap_congr c _ _ h

theorem structureMap_chartValue
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    c.structureMap ≫ chartValue c x hx = CommRingCat.ofHom (algebraMap Λ A) :=
  c.structureMap_ringMap _ _ _ (chartPointMap_comp x hx)

omit [IsOpenImmersion iΛ] in
theorem chartValue_residue
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    chartValue c x hx ≫ CommRingCat.ofHom (residueMap A) =
      c.ringMap (pointMap hv₀) (range_pointMap c) := by
  rw [chartValue, ← c.ringMap_comp _ _ _ ((residue_chartPointMap x hx).symm ▸ range_pointMap c)]
  exact AffineChart.ringMap_congr c _ _ (residue_chartPointMap x hx)

omit [IsOpenImmersion iΛ] in
theorem exists_morphism_of_chartValue_eq
    {x x' : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) (hx' : x'.algebra = A)
    (h : chartValue c x hx = chartValue c x' hx') :
    ∃ m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ x x',
      m.ringHom = eqToHom (hx.trans hx'.symm) := by
  have h' : chartPointMap x hx = chartPointMap x' hx' := c.ringMap_injective _ _ h
  apply exists_morphism_of_deformationMap_eq
  subst hx'
  rw [chartPointMap, chartPointMap, eqToHom_refl, specMap_id, Category.id_comp] at h'
  rw [← h']

end Value

/-! ### The receptacle `W ↦ W^ι` -/

-- The bimodule structure on a vector space under which `TrivSqZeroExt k W` is formed in
-- `Deformation.squareZeroExtensionArtinian`.
local instance (W : FGModuleCat.{u} k) : Module kᵐᵒᵖ W :=
  Module.oppositeOfCommSemiring k W

local instance (W : FGModuleCat.{u} k) : IsCentralScalar k W :=
  Module.isCentralScalar_oppositeOfCommSemiring k W

section Receptacle

variable (k) in
/-- The functor `W ↦ W^ι` from finite-dimensional `k`-vector spaces to `k`-modules. -/
def powFunctor (ι : Type u) : FGModuleCat.{u} k ⥤ ModuleCat.{u} k where
  obj W := ModuleCat.of k (ι → W)
  map f := ModuleCat.ofHom (LinearMap.compLeft f.hom.hom ι)

instance (ι : Type u) : (powFunctor k ι).Additive where
  map_add := rfl

instance (ι : Type u) : (powFunctor k ι).Linear k where
  map_smul _ _ := rfl

instance (ι : Type u) [Finite ι] :
    FiniteDimensional k ((powFunctor k ι).obj (FGModuleCat.of k k)) :=
  inferInstanceAs (FiniteDimensional k (ι → k))

end Receptacle

/-! ### The tangent space of the deformation category of a point of a scheme -/

section Tangent

variable (iΛ v₀ hv₀) in
/-- The deformation category of `v₀` as a category over `𝒞_Λ`. -/
abbrev sliceDeformations : PredeformationConstruction iΛ
    (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ :=
  predeformationCategory iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀

instance : Category (sliceDeformations iΛ v₀ hv₀).carrier :=
  (sliceDeformations iΛ v₀ hv₀).category

variable (iΛ v₀ hv₀) in
/-- The deformation category of `v₀`, as a based category over `𝒞_Λ`. -/
abbrev sliceBased : BasedCategory (ArtinianLocalAlgCat.{u, u, u} Λ k) :=
  BasedCategory.ofFunctor (sliceDeformations iΛ v₀ hv₀).projection

variable [IsOpenImmersion iΛ] (c : AffineChart iΛ (B.inclusion.map V.hom)
  ((pointMap hv₀).base (closedPt (.of k))))

/-- The ring map out of the chart attached to an object of a fibre of the deformation
category. -/
def fiberValue {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (x : (sliceBased iΛ v₀ hv₀).p.Fiber A) : c.ring ⟶ CommRingCat.of A :=
  chartValue c x.1 x.2

omit [IsOpenImmersion iΛ] in
theorem fiberValue_of_isHomLift {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (x : (sliceBased iΛ v₀ hv₀).p.Fiber A) (y : (sliceBased iΛ v₀ hv₀).p.Fiber A')
    (β : A ⟶ A') (a : x.1 ⟶ y.1) [(sliceBased iΛ v₀ hv₀).p.IsHomLift β a] :
    fiberValue c y = fiberValue c x ≫ CommRingCat.ofHom β.hom.toRingHom := by
  apply chartValue_of_morphism c x.2 y.2 a β
  exact IsHomLift.fac' (sliceBased iΛ v₀ hv₀).p β a

omit [IsOpenImmersion iΛ] in
theorem fiberValue_eq_of_classOf_eq {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (x y : (sliceBased iΛ v₀ hv₀).p.Fiber A)
    (h : classOf (sliceBased iΛ v₀ hv₀) h𝓕 x = classOf (sliceBased iΛ v₀ hv₀) h𝓕 y) :
    fiberValue c x = fiberValue c y := by
  have hq : Quotient.mk (isIsomorphicSetoid _) x = Quotient.mk (isIsomorphicSetoid _) y := by
    rw [← classOf_eq, ← classOf_eq, h]
  obtain ⟨e⟩ := Quotient.exact hq
  have : (sliceBased iΛ v₀ hv₀).p.IsHomLift (𝟙 A) e.hom.1 := e.hom.2
  rw [fiberValue_of_isHomLift c x y (𝟙 A) e.hom.1]
  simp only [ArtinianLocalAlgCat.id_hom]
  rfl

/-- The ring map out of the chart attached to an isomorphism class of a fibre. -/
def classValue {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (z : (isomorphismClasses (sliceBased iΛ v₀ hv₀) h𝓕).obj A) : c.ring ⟶ CommRingCat.of A :=
  fiberValue c (classOf_surjective (sliceBased iΛ v₀ hv₀) h𝓕 A z).choose

omit [IsOpenImmersion iΛ] in
theorem classValue_classOf {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (x : (sliceBased iΛ v₀ hv₀).p.Fiber A) :
    classValue c h𝓕 (classOf (sliceBased iΛ v₀ hv₀) h𝓕 x) = fiberValue c x :=
  fiberValue_eq_of_classOf_eq c h𝓕 _ _
    (classOf_surjective (sliceBased iΛ v₀ hv₀) h𝓕 A _).choose_spec

/-- The family of maps from the tangent-space set functor to `W ↦ W^ι`, reading the
square-zero component of the ring map out of the chart on the chosen elements. -/
def tangentMap (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p) (gens : Set c.ring)
    (W : FGModuleCat.{u} k)
    (z : (associatedTangentSpaceSetFunctor (sliceBased iΛ v₀ hv₀) h𝓕).obj W) :
    (powFunctor k gens).obj W :=
  fun i => TrivSqZeroExt.snd (R := k) (M := W) ((classValue c h𝓕 z).hom i.1)

omit [IsOpenImmersion iΛ] in
theorem tangentMap_naturality (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (gens : Set c.ring) {W W' : FGModuleCat.{u} k} (f : W ⟶ W')
    (z : (associatedTangentSpaceSetFunctor (sliceBased iΛ v₀ hv₀) h𝓕).obj W) :
    tangentMap c h𝓕 gens W' ((associatedTangentSpaceSetFunctor (sliceBased iΛ v₀ hv₀) h𝓕).map f z) =
      ((powFunctor k gens).map f) (tangentMap c h𝓕 gens W z) := by
  let 𝓕 := sliceBased iΛ v₀ hv₀
  let F := squareZeroExtensionRestriction Λ k (artinianLocalOver Λ k)
    (squareZeroExtension_mem_artinianLocalOver Λ k) ⋙ artinianLocalOverToArtinian Λ k
  obtain ⟨x, rfl⟩ := classOf_surjective 𝓕 h𝓕 _ z
  obtain ⟨y, a, ha⟩ := h𝓕.exists_lift (F.map f).op (Opposite.op x.1) (congrArg Opposite.op x.2)
  have ha' : 𝓕.p.IsHomLift (F.map f) a.unop := by
    exact IsHomLift.of_fac 𝓕.p (F.map f) a.unop x.2
      (congrArg Opposite.unop (IsHomLift.domain_eq 𝓕.p.op (F.map f).op a))
      (by simpa using congrArg Quiver.Hom.unop (IsHomLift.fac 𝓕.p.op (F.map f).op a))
  let y' : 𝓕.p.Fiber (F.obj W') := ⟨y.unop, IsHomLift.codomain_eq 𝓕.p (F.map f) a.unop⟩
  change tangentMap c h𝓕 gens W' ((isomorphismClasses 𝓕 h𝓕).map (F.map f) (classOf 𝓕 h𝓕 x)) = _
  rw [map_classOf 𝓕 h𝓕 (F.map f) x y' a.unop]
  have e1 : classValue c h𝓕 (classOf 𝓕 h𝓕 y') =
      classValue c h𝓕 (classOf 𝓕 h𝓕 x) ≫ CommRingCat.ofHom (F.map f).hom.toRingHom := by
    rw [classValue_classOf, classValue_classOf, fiberValue_of_isHomLift c x y' (F.map f) a.unop]
  funext i
  change TrivSqZeroExt.snd (R := k) (M := W') ((classValue c h𝓕 (classOf 𝓕 h𝓕 y')).hom i.1) =
    f.hom.hom (TrivSqZeroExt.snd (R := k) (M := W) ((classValue c h𝓕 (classOf 𝓕 h𝓕 x)).hom i.1))
  rw [e1, CommRingCat.comp_apply]
  exact TrivSqZeroExt.snd_map f.hom.hom _

private lemma id_eq_eqToHom_comp {C : Type*} [Category C] {X Y Z : C} (h₁ : X = Y) (h₂ : Y = Z)
    (h₃ : Z = X) : 𝟙 X = eqToHom h₁ ≫ eqToHom h₂ ≫ eqToHom h₃ := by
  subst h₁ h₂; simp

/-- Two ring maps out of a ring of finite type over `Λ` which agree on `Λ` and on a set of
algebra generators are equal. -/
theorem ringHom_ext_of_adjoin {R A : CommRingCat.{u}} (lR : CommRingCat.of Λ ⟶ R)
    (gens : Set R)
    (hgens : @Algebra.adjoin Λ R _ _ lR.hom.toAlgebra gens = ⊤) {φ ψ : R ⟶ A}
    (hl : lR ≫ φ = lR ≫ ψ) (h : ∀ r ∈ gens, φ r = ψ r) : φ = ψ := by
  let := lR.hom.toAlgebra
  let : Algebra Λ A := (lR ≫ φ).hom.toAlgebra
  have hc : ∀ r : Λ, ψ (lR r) = φ (lR r) := fun r => by
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, hl]
  let φ' : R →ₐ[Λ] A := { φ.hom with commutes' := fun _ => rfl }
  let ψ' : R →ₐ[Λ] A := { ψ.hom with commutes' := hc }
  have : φ' = ψ' := AlgHom.ext_of_adjoin_eq_top hgens h
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  exact congrArg (fun χ : R →ₐ[Λ] A => χ r) this

theorem tangentMap_injective (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (gens : Set c.ring)
    (hgens : @Algebra.adjoin Λ c.ring _ _ c.structureMap.hom.toAlgebra gens = ⊤) :
    Function.Injective (tangentMap c h𝓕 gens (FGModuleCat.of k k)) := by
  let 𝓕 := sliceBased iΛ v₀ hv₀
  intro z z' hzz
  obtain ⟨x, rfl⟩ := classOf_surjective 𝓕 h𝓕 _ z
  obtain ⟨x', rfl⟩ := classOf_surjective 𝓕 h𝓕 _ z'
  have hv0 : classValue c h𝓕 (classOf 𝓕 h𝓕 x) = classValue c h𝓕 (classOf 𝓕 h𝓕 x') := by
    apply ringHom_ext_of_adjoin c.structureMap gens hgens
    · rw [classValue_classOf, classValue_classOf]
      exact (structureMap_chartValue c x.1 x.2).trans (structureMap_chartValue c x'.1 x'.2).symm
    · intro r hr
      have hsnd := congrFun hzz ⟨r, hr⟩
      have hfst : (classValue c h𝓕 (classOf 𝓕 h𝓕 x) ≫ CommRingCat.ofHom (residueMap _)) r =
          (classValue c h𝓕 (classOf 𝓕 h𝓕 x') ≫ CommRingCat.ofHom (residueMap _)) r := by
        rw [classValue_classOf, classValue_classOf]
        exact congrArg (fun χ => χ r) ((chartValue_residue c x.1 x.2).trans
          (chartValue_residue c x'.1 x'.2).symm)
      exact TrivSqZeroExt.ext hfst hsnd
  have hv : fiberValue c x = fiberValue c x' := by
    rw [← classValue_classOf c h𝓕 x, ← classValue_classOf c h𝓕 x']
    exact hv0
  obtain ⟨m, hm⟩ := exists_morphism_of_chartValue_eq c x.2 x'.2 hv
  let φ : x.1 ⟶ x'.1 := m
  let A0 := (artinianSquareZeroExtensionFunctor Λ k).obj (FGModuleCat.of k k)
  have hφ : 𝓕.p.IsHomLift (𝟙 A0) φ := by
    apply IsHomLift.of_fac 𝓕.p _ φ x.2 x'.2
    change 𝟙 A0 = eqToHom _ ≫ m.ringHom ≫ eqToHom _
    rw [hm]
    exact id_eq_eqToHom_comp _ _ _
  have : IsIso (𝓕.p.map φ) := by
    change IsIso m.ringHom
    rw [hm]
    infer_instance
  have : IsIso φ := isIso_of_isIso_map h𝓕 φ
  apply classOf_eq_of_isIsomorphic
  have : 𝓕.p.IsHomLift (𝟙 A0) (inv φ) := by
    have h := IsHomLift.inv 𝓕.p (𝟙 A0) φ
    simpa using h
  refine ⟨⟨Functor.Fiber.homMk 𝓕.p A0 φ, Functor.Fiber.homMk 𝓕.p A0 (inv φ), ?_, ?_⟩⟩
  · apply Functor.Fiber.hom_ext
    exact IsIso.hom_inv_id φ
  · apply Functor.Fiber.hom_ext
    exact IsIso.inv_hom_id φ

end Tangent

/-- Morphisms of deformations of a point of a scheme are determined by their ring maps. -/
theorem deformationMorphism_ext_of_ringHom
    {a b : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    {m m' : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ a b}
    (h : m.ringHom = m'.ringHom) : m = m' := by
  apply DeformationMorphism.ext_of_components _ _ _ _ h
  apply Over.OverMorphism.ext
  apply Over.OverMorphism.ext
  apply B.inclusion.map_injective
  have e := m.arrow_base.trans (h ▸ m'.arrow_base.symm)
  change eqToHom _ ≫ B.inclusion.map m.arrow.left.left ≫ eqToHom _ =
    eqToHom _ ≫ B.inclusion.map m'.arrow.left.left ≫ eqToHom _ at e
  exact (cancel_mono _).mp ((cancel_epi _).mp e)

instance subsingleton_fiber_hom {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (y y' : (sliceDeformations iΛ v₀ hv₀).projection.Fiber A) : Subsingleton (y ⟶ y') where
  allEq φ ψ := by
    apply Functor.Fiber.hom_ext
    apply deformationMorphism_ext_of_ringHom
    have := φ.2
    have := ψ.2
    have hφ := IsHomLift.fac' (sliceDeformations iΛ v₀ hv₀).projection (𝟙 A) φ.1
    have hψ := IsHomLift.fac' (sliceDeformations iΛ v₀ hv₀).projection (𝟙 A) ψ.1
    exact hφ.trans hψ.symm

/-! ### Finite dimensionality -/

section FiniteDimensional

variable [IsOpenImmersion iΛ]

omit [IsOpenImmersion iΛ] in
theorem pointMap_mem_range :
    (B.inclusion.map V.hom).base ((pointMap hv₀).base (closedPt (.of k))) ∈
      Set.range iΛ.base := by
  refine ⟨(Spec.map (CommRingCat.ofHom (algebraMap Λ k))).base (closedPt (.of k)), ?_⟩
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, pointMap_comp]

/-- The tangent space of the deformation category of a point of a scheme locally of finite
type over `S` is finite dimensional, for its canonical vector space structure. -/
theorem finiteDimensional_artinianTangentSpace_sliceBased
    [LocallyOfFiniteType (B.inclusion.map V.hom)]
    (h : IsPredeformationCategory (sliceBased iΛ v₀ hv₀).p)
    (hS2 : SchlessingerConditionS2
      (Functor.Elements.π (isomorphismClasses (sliceBased iΛ v₀ hv₀) h.cofibered))) :
    letI : Fact (IsPredeformationCategory (sliceBased iΛ v₀ hv₀).p) := ⟨h⟩
    letI : Fact (SchlessingerConditionS2
      (Functor.Elements.π (isomorphismClasses (sliceBased iΛ v₀ hv₀) h.cofibered))) := ⟨hS2⟩
    FiniteDimensional k
      (artinianTangentSpace Λ k (isomorphismClasses (sliceBased iΛ v₀ hv₀) h.cofibered)) := by
  obtain ⟨c⟩ := nonempty_affineChart (s := B.inclusion.map V.hom) (iΛ := iΛ)
    (pointMap_mem_range (hv₀ := hv₀))
  obtain ⟨t, ht⟩ := c.finiteType_structureMap.out
  exact finiteDimensional_artinianTangentSpace_of_natural_injection (sliceBased iΛ v₀ hv₀) h hS2
    (powFunctor k (t : Set c.ring)) (tangentMap c h.cofibered t)
    (fun f z => tangentMap_naturality c h.cofibered t f z)
    (tangentMap_injective c h.cofibered t ht)

omit [IsOpenImmersion iΛ] in
/-- The deformation category of a point of a scheme is a deformation category: the category
represented by a scheme satisfies (RS) by the universal property of the pushout. -/
theorem isDeformationCategory_sliceDeformations
    (hfinite : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ))
    (hqc : QuasiCompact (Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ)) :
    IsDeformationCategory (sliceDeformations iΛ v₀ hv₀).projection :=
  isDeformationCategory_predeformationCategory B S hS (Over.forget V)
    (Functor.IsFiberedInGroupoids.over_forget V) (satisfiesRS_over_forget B S hS V) iΛ v₀ hv₀
    hfinite hqc

/-- **The scheme case of Stacks 07X1, tangent spaces.** For `V` locally of finite type over a
scheme `S` and `k` a field of finite type over `S`, the tangent space of the deformation
category of a point of `(Sch/V)` over `k` is finite dimensional over `k`. -/
theorem finiteDimensional_tangentSpaceArtinian_sliceBased
    [LocallyOfFiniteType (B.inclusion.map V.hom)]
    (hp : IsDeformationCategory (sliceBased iΛ v₀ hv₀).p) :
    letI : Fact (IsPredeformationCategory (sliceBased iΛ v₀ hv₀).p) := ⟨hp.predeformation⟩
    letI : Fact (SchlessingerConditionS2 (Functor.Elements.π
      (isomorphismClasses (sliceBased iΛ v₀ hv₀) hp.predeformation.cofibered))) :=
      ⟨tangentConditionS2 hp⟩
    FiniteDimensional k (tangentSpaceArtinian.{u, u, u} Λ k
      (isomorphismClasses (sliceBased iΛ v₀ hv₀) hp.predeformation.cofibered)) := by
  have hS2 := tangentConditionS2 hp
  have h1 := finiteDimensional_artinianTangentSpace_sliceBased hp.predeformation hS2
  exact finiteDimensional_tangentSpaceArtinian_of_artinianTangentSpace _ hp.predeformation hS2 h1

end FiniteDimensional

end Deformation.Artin.SliceTangent
