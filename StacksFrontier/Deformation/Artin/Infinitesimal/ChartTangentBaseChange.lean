module

public import StacksFrontier.Deformation.Artin.Infinitesimal.ChartModFlatBaseChange
public import StacksFrontier.Deformation.Artin.Infinitesimal.TangentBaseChangeDescent

/-!
# Flat base change of the tangent modules at a chart point

With the notation of `Deformation.Artin.ChartLift.tangentToMod`, let `w : P → X` be a point of a
chart of an algebraic stack and suppose given a formally étale chart `b` of the arrows of the
groupoid of the chart through the identity of `w` (as produced, after a refinement, by
`AlgebraicGeometry.Stack.GroupoidLift.exists_arrowChart`). Then:

* the relation of isomorphism of lifts of `ξ w` is the relation "differ by an element of `S`"
  (`Deformation.Artin.ChartLift.rel_iff_of_chart`), at `w` and at every image `g ∘ w`
  (`Deformation.Artin.ChartLift.chart_app_comp`); this is the hypothesis `hrel` of
  `Deformation.Artin.ChartLift.tangentToMod`;
* for a map `g : X → Y` of small algebras which is a flat base change in the sense of
  `Deformation.Artin.ChartLift.sqzTensorLift`, the map of Stacks 07YA induces a `Y`-linear
  isomorphism `Y ⊗_X T_{ξ w}(M) ≅ T_{ξ (g ∘ w)}(N)`
  (`Deformation.Artin.ChartLift.isTangentBaseChangeIso_chart`).

This is Stacks 0DNT at a chart point.
-/

@[expose] public noncomputable section

open scoped TensorProduct
open AlgebraicGeometry CategoryTheory CategoryTheory.Functor
open AlgebraicGeometry.Stack.GroupoidLift AlgebraicGeometry.Space.ChartDescent
open AlgebraicGeometry.Stack.GroupoidLift.StackChart

namespace Deformation.Artin.ChartLift

universe u

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {T' : BigFppfOver B S hS}
  [IsAffine ((BigFppfOver.toScheme B S hS).obj T')]
  {𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (BigFppfOver B S hS)}
  {U₀ : BigFppfOver B S hS} {a : Stack.schemeFibredCategory B S hS U₀ ⟶ 𝒳}
  {P : SmallAlg (ringOf B S hS T') B.cutoff} {ι : specOver P ⟶ U₀}
  {Q : SmallAlg (ringOf B S hS T') B.cutoff} {b : Chart (stackArr a ι) Q.obj}
  {sV tV : P.obj →ₐ[ringOf B S hS T'] Q.obj}

section Rel

/-- A chart of the arrows through the identity of `w` passes through the identity of `g ∘ w`. -/
theorem chart_app_comp {X Y : SmallAlg (ringOf B S hS T') B.cutoff} (g : X ⟶ Y)
    {w : P.obj →ₐ[ringOf B S hS T'] X.obj} {v : Q.obj →ₐ[ringOf B S hS T'] X.obj}
    (hv : b.app X v = Arr.idt w) :
    b.app Y (g.hom.hom.comp v) = Arr.idt (g.hom.hom.comp w) := by
  rw [← b.natural, hv]
  exact (stackGroupoid a ι).idt_map g w

variable (hb : b.IsFormallyEtale)
  (hsV : ∀ (D : SmallAlg (ringOf B S hS T') B.cutoff) (v : Q.obj →ₐ[ringOf B S hS T'] D.obj),
    (b.app D v).src = v.comp sV)
  (htV : ∀ (D : SmallAlg (ringOf B S hS T') B.cutoff) (v : Q.obj →ₐ[ringOf B S hS T'] D.obj),
    (b.app D v).tgt = v.comp tV)

include hb hsV htV in
/-- **Isomorphism of lifts at a point through which a chart of the arrows passes**: two lifts of
`w` to `X[M]` are related exactly when they differ by an element of `S`. -/
theorem rel_iff_of_chart {X : SmallAlg (ringOf B S hS T') B.cutoff}
    {w : P.obj →ₐ[ringOf B S hS T'] X.obj} {v : Q.obj →ₐ[ringOf B S hS T'] X.obj}
    (hv : b.app X v = Arr.idt w) (M : SiteModule X.obj B)
    {ℓ₁ ℓ₂ : P.obj →ₐ[ringOf B S hS T'] (sqzAlgOf X M).obj}
    (h₁ : (sqzEOf X M).q.hom.hom.comp ℓ₁ = w) :
    Rel (stackGroupoid a ι) (sqzEOf X M) w ℓ₁ ℓ₂ ↔ ℓ₂.toLinearMap - ℓ₁.toLinearMap ∈
      AlgebraicGeometry.Stack.GroupoidLift.S (stackGroupoid a ι) (sqzEOf X M) w :=
  rel_iff_mem_S (G := stackGroupoid a ι) b hb sV tV hsV htV hv h₁

end Rel

/-- **Extension of scalars along a base change generated by a flat algebra.** Let `R → X → Y` be
ring maps, `j : F → Y` a map of `R`-algebras whose image spans `Y` as an `X`-module, and
`μ : T → T'` an `X`-linear map from an `X`-module to a `Y`-module. If `f ⊗ t ↦ j f • μ t` is a
bijection `F ⊗_R T → T'`, then `μ` extends to a bijection `Y ⊗_X T → T'`. -/
theorem bijective_liftBaseChange_of_span {R X Y F T T' : Type*} [CommRing R] [CommRing X]
    [CommRing Y] [CommRing F] [Algebra R X] [Algebra R Y] [Algebra X Y] [IsScalarTower R X Y]
    [Algebra R F] (j : F →ₐ[R] Y) (hj : ∀ y : Y, y ∈ Submodule.span X (Set.range j))
    [AddCommGroup T] [Module X T] [Module R T] [IsScalarTower R X T] [AddCommGroup T']
    [Module Y T'] [Module X T'] [IsScalarTower X Y T'] (μ : T →ₗ[X] T')
    (β : F ⊗[R] T →+ T') (hβ : Function.Bijective β) (hβt : ∀ f t, β (f ⊗ₜ t) = j f • μ t) :
    Function.Bijective (μ.liftBaseChange Y) := by
  let π₀ : F →+ T →+ Y ⊗[X] T :=
    AddMonoidHom.mk' (fun f ↦ (TensorProduct.mk X Y T (j f)).toAddMonoidHom)
      (fun f f' ↦ by rw [_root_.map_add, _root_.map_add]; rfl)
  let π : F ⊗[R] T →+ Y ⊗[X] T := TensorProduct.liftAddHom π₀ fun r f t ↦ by
    change j (r • f) ⊗ₜ[X] t = j f ⊗ₜ[X] (r • t)
    rw [_root_.map_smul, ← algebraMap_smul X r t, ← TensorProduct.smul_tmul, algebraMap_smul]
  have hπt : ∀ f t, π (f ⊗ₜ t) = j f ⊗ₜ t := fun _ _ ↦ rfl
  have hcomp : ∀ s, μ.liftBaseChange Y (π s) = β s := by
    intro s
    induction s using TensorProduct.inductionOn with
    | tmul f t => rw [hπt, LinearMap.liftBaseChange_tmul, hβt]
    | add s₁ s₂ h₁ h₂ => rw [_root_.map_add, _root_.map_add, h₁, h₂, _root_.map_add]
  have hπs : Function.Surjective π := by
    intro u
    induction u using TensorProduct.inductionOn with
    | tmul y t =>
      induction hj y using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨f, rfl⟩ := hy
        exact ⟨f ⊗ₜ t, rfl⟩
      | zero => exact ⟨0, by rw [_root_.map_zero, TensorProduct.zero_tmul]⟩
      | add y₁ y₂ _ _ h₁ h₂ =>
        obtain ⟨s₁, h₁⟩ := h₁
        obtain ⟨s₂, h₂⟩ := h₂
        exact ⟨s₁ + s₂, by rw [_root_.map_add, h₁, h₂, TensorProduct.add_tmul]⟩
      | smul c y _ h =>
        obtain ⟨s, hs⟩ := h
        have hgen : ∀ s : F ⊗[R] T, ∃ s', π s' = c • π s := by
          intro s
          induction s using TensorProduct.inductionOn with
          | tmul f t' =>
            refine ⟨f ⊗ₜ (c • t'), ?_⟩
            rw [hπt, hπt, TensorProduct.smul_tmul', TensorProduct.smul_tmul]
          | add s₁ s₂ h₁ h₂ =>
            obtain ⟨s₁', h₁⟩ := h₁
            obtain ⟨s₂', h₂⟩ := h₂
            exact ⟨s₁' + s₂', by rw [_root_.map_add, h₁, h₂, _root_.map_add, smul_add]⟩
        obtain ⟨s', hs'⟩ := hgen s
        exact ⟨s', by rw [hs', hs, TensorProduct.smul_tmul']⟩
    | add u₁ u₂ h₁ h₂ =>
      obtain ⟨s₁, rfl⟩ := h₁
      obtain ⟨s₂, rfl⟩ := h₂
      exact ⟨s₁ + s₂, _root_.map_add _ _ _⟩
  refine ⟨fun u₁ u₂ h ↦ ?_, fun t' ↦ ?_⟩
  · obtain ⟨s₁, rfl⟩ := hπs u₁
    obtain ⟨s₂, rfl⟩ := hπs u₂
    rw [hcomp, hcomp] at h
    rw [hβ.1 h]
  · obtain ⟨s, rfl⟩ := hβ.2 t'
    exact ⟨π s, hcomp s⟩

section BaseChange

variable {X Y : SmallAlg (ringOf B S hS T') B.cutoff} {w : P.obj →ₐ[ringOf B S hS T'] X.obj}

omit [IsAffine ((BigFppfOver.toScheme B S hS).obj T')] in
/-- The first coordinate of `sqzTensorLift` on a pure tensor. -/
theorem fst_sqzTensorLift_tmul (g : X ⟶ Y) {M : ModuleCat.{u} X.obj} {N : ModuleCat.{u} Y.obj}
    (ψ : M ⟶ (ModuleCat.restrictScalars (g.hom.hom : X.obj →+* Y.obj)).obj N)
    (hM : Cardinal.mk (TrivSqZeroExt X.obj M) < B.cutoff)
    (hN : Cardinal.mk (TrivSqZeroExt Y.obj N) < B.cutoff)
    {F : Type u} [CommRing F] [Algebra (ringOf B S hS T') F] (j : F →ₐ[ringOf B S hS T'] Y.obj)
    (z : (sqzAlg X M hM).obj) (f : F) :
    TrivSqZeroExt.fst (R := Y.obj) (M := N) (sqzTensorLift g ψ hM hN j (z ⊗ₜ f)) =
      g.hom.hom (TrivSqZeroExt.fst (R := X.obj) (M := M) z) * j f := by
  rw [sqzTensorLift, Algebra.TensorProduct.lift_tmul]
  exact TrivSqZeroExt.fst_mul _ _

variable (hb : b.IsFormallyEtale)
  (hsV : ∀ (D : SmallAlg (ringOf B S hS T') B.cutoff) (v : Q.obj →ₐ[ringOf B S hS T'] D.obj),
    (b.app D v).src = v.comp sV)
  (htV : ∀ (D : SmallAlg (ringOf B S hS T') B.cutoff) (v : Q.obj →ₐ[ringOf B S hS T'] D.obj),
    (b.app D v).tgt = v.comp tV)

include hb hsV htV in
/-- **Stacks 0DNT at a chart point.** Let `w : P → X` be a point of a chart through which a
formally étale chart `b` of the arrows passes at the identity, and let `g : X → Y`, `ψ : M → N`
be a flat base change: `X[M] ⊗_{A'} F ≅ Y[N]` for a flat `A'`-algebra `F`. Then the map of
Stacks 07YA induces a `Y`-linear isomorphism `Y ⊗_X T_{ξ w}(M) ≅ T_{ξ (g ∘ w)}(N)`. -/
theorem isTangentBaseChangeIso_chart_of_algebraMap (g : X ⟶ Y) [Algebra X.obj Y.obj]
    (hg : algebraMap X.obj Y.obj = (g.hom.hom : X.obj →+* Y.obj)) {M : SiteModule X.obj B}
    {N : SiteModule Y.obj B}
    (ψ : M.obj ⟶ (ModuleCat.restrictScalars (g.hom.hom : X.obj →+* Y.obj)).obj N.obj)
    (ψa : M.obj ⟶ (ModuleCat.restrictScalars (algebraMap X.obj Y.obj)).obj N.obj)
    (hψa : ∀ m, (ψa.hom m : N.obj) = ψ.hom m)
    (hf : Spec.map (CommRingCat.ofHom (algebraMap X.obj Y.obj)) ≫ toSOf X = toSOf Y)
    (hφ : 𝒳.val.p.IsHomLift (algebraOverMapOfRingHom (algebraMap X.obj Y.obj) B S hS (toSOf X)
      (toSOf Y) (contains_spec X) (contains_spec Y) hf) (trans a ι g w))
    {F : Type u} [CommRing F] [Algebra (ringOf B S hS T') F] [Module.Flat (ringOf B S hS T') F]
    (j : F →ₐ[ringOf B S hS T'] Y.obj)
    (hL : Function.Bijective (sqzTensorLift g ψ (card_sqz_lt M) (card_sqz_lt N) j))
    [Module.FinitePresentation P.obj Ω[P.obj⁄ringOf B S hS T']]
    [Module.FinitePresentation Q.obj Ω[Q.obj⁄ringOf B S hS T']]
    {v : Q.obj →ₐ[ringOf B S hS T'] X.obj} (hv : b.app X v = Arr.idt w)
    (ha : Stack.IsFormallySmoothOnObjects B S hS (Stack.schemeFibredCategory B S hS U₀) 𝒳 a)
    (hι : ∀ {C' C : SmallAlg (ringOf B S hS T') B.cutoff} (e : SqZero C' C)
      (m' : specOver C' ⟶ U₀) (u : P.obj →ₐ[ringOf B S hS T'] C.obj),
      specOverMap e.q ≫ m' = specOverMap (SmallAlg.homMk u) ≫ ι →
      ∃ u' : P.obj →ₐ[ringOf B S hS T'] C'.obj, e.q.hom.hom.comp u' = u ∧
        specOverMap (SmallAlg.homMk u') ≫ ι = m')
    (Fx : TangentFunctorData X.obj B S hS (toSOf X) (contains_spec X) 𝒳.val.p (ξ a ι w)
      (ξ_obj a ι w))
    (Gy : TangentFunctorData Y.obj B S hS (toSOf Y) (contains_spec Y) 𝒳.val.p
      (ξ a ι (g.hom.hom.comp w)) (ξ_obj a ι (g.hom.hom.comp w))) :
    IsTangentBaseChangeIso 𝒳.property hf (trans a ι g w) hφ Fx Gy ψa := by
  have hrel := fun M {ℓ₁ ℓ₂} h₁ ↦ Function.const ((sqzEOf X M).q.hom.hom.comp ℓ₂ = w)
    (rel_iff_of_chart hb hsV htV hv M (ℓ₁ := ℓ₁) (ℓ₂ := ℓ₂) h₁)
  have hrel' := fun N {ℓ₁ ℓ₂} h₁ ↦
    Function.const ((sqzEOf Y N).q.hom.hom.comp ℓ₂ = g.hom.hom.comp w)
      (rel_iff_of_chart hb hsV htV (chart_app_comp g hv) N (ℓ₁ := ℓ₁) (ℓ₂ := ℓ₂) h₁)
  obtain ⟨β, hβ, hβf⟩ := exists_bijective_modBaseChange (G := stackGroupoid a ι) g ψ
    (card_sqz_lt M) (card_sqz_lt N) j hL hb hsV htV hv
  let : Module X.obj ↥(Gy.functor.obj N) := Module.compHom _ (algebraMap X.obj Y.obj)
  have : IsScalarTower X.obj Y.obj ↥(Gy.functor.obj N) :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let μ : ↥(Fx.functor.obj M) →ₗ[X.obj] ↥(Gy.functor.obj N) :=
    { toFun := tangentPullbackHom (algebraMap X.obj Y.obj) hf 𝒳.property
        (trans a ι g w) hφ Fx Gy ψa
      map_add' := map_add _
      map_smul' := fun r t ↦ (tangentPullbackHom (algebraMap X.obj Y.obj) hf
        𝒳.property (trans a ι g w) hφ Fx Gy ψa).map_smulₛₗ r t }
  -- `T_x` as an `A'`-module, and its identification with `Mod w` as an `A'`-linear equivalence.
  let : Module (ringOf B S hS T') ↥(Fx.functor.obj M) :=
    Module.compHom _ (algebraMap (ringOf B S hS T') X.obj)
  let Φx := tangentToMod M hrel ha hι Fx
  let Φy := tangentToMod N hrel' ha hι Gy
  let ΦxA : ↥(Fx.functor.obj M) ≃ₗ[ringOf B S hS T'] Mod (stackGroupoid a ι) (sqzEOf X M) w :=
    { Φx with
      map_add' := tangentToMod_add M hrel ha hι Fx
      map_smul' := fun r z ↦ by
        change Φx (algebraMap (ringOf B S hS T') X.obj r • z) = r • Φx z
        rw [tangentToMod_smul]
        rfl }
  let ΦyA : ↥(Gy.functor.obj N) ≃+ Mod (stackGroupoid a ι) (sqzEOf Y N) (g.hom.hom.comp w) :=
    { Φy with map_add' := tangentToMod_add N hrel' ha hι Gy }
  have : IsScalarTower (ringOf B S hS T') X.obj ↥(Fx.functor.obj M) :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  have : IsScalarTower (ringOf B S hS T') X.obj Y.obj :=
    IsScalarTower.of_algebraMap_eq fun r ↦ by rw [hg]; exact (g.hom.hom.commutes r).symm
  have hj : ∀ y : Y.obj, y ∈ Submodule.span X.obj (Set.range j) := by
    have hgen : ∀ s, TrivSqZeroExt.fst (R := Y.obj) (M := N.obj)
        (sqzTensorLift g ψ (card_sqz_lt M) (card_sqz_lt N) j s) ∈
          Submodule.span X.obj (Set.range j) := by
      intro s
      induction s using TensorProduct.inductionOn with
      | tmul z f =>
        rw [fst_sqzTensorLift_tmul]
        have hs : g.hom.hom (TrivSqZeroExt.fst (R := X.obj) (M := M.obj) z) * j f =
            TrivSqZeroExt.fst (R := X.obj) (M := M.obj) z • j f := by
          rw [Algebra.smul_def, hg]
          rfl
        rw [hs]
        exact Submodule.smul_mem _ (TrivSqZeroExt.fst (R := X.obj) (M := M.obj) z)
          (Submodule.subset_span ⟨f, rfl⟩)
      | add s₁ s₂ h₁ h₂ =>
        rw [_root_.map_add]
        exact Submodule.add_mem _ h₁ h₂
    intro y
    obtain ⟨s, hs⟩ := hL.2 (sqzInl Y N.obj (card_sqz_lt N) y)
    have h := hgen s
    rwa [hs] at h
  let β' : F ⊗[ringOf B S hS T'] ↥(Fx.functor.obj M) →+ ↥(Gy.functor.obj N) :=
    ΦyA.symm.toAddMonoidHom.comp
      (β.comp (TensorProduct.congr (LinearEquiv.refl (ringOf B S hS T') F)
        ΦxA).toLinearMap).toAddMonoidHom
  have hβ' : Function.Bijective β' :=
    ΦyA.symm.bijective.comp (hβ.comp (TensorProduct.congr _ ΦxA).bijective)
  have hβt : ∀ f t, β' (f ⊗ₜ t) = j f • μ t := by
    intro f t
    refine ΦyA.symm_apply_eq.mpr ?_
    change β (f ⊗ₜ Φx t) = Φy (j f • tangentPullbackFun (algebraMap X.obj Y.obj) hf
      𝒳.property (trans a ι g w) hφ Fx Gy ψa t)
    have hc := tangentPullbackFun_congr 𝒳.property Fx Gy hg hf (toSOf_comp g) rfl hφ
      (trans_isHomLift a ι g w) ψa ψ hψa t
    exact (hβf f (Φx t)).trans (((congrArg (sqzInl Y N.obj (card_sqz_lt N) (j f) • ·)
      (tangentToMod_tangentPullbackFun g ψ hrel hrel' ha hι Fx Gy t)).symm.trans
        (tangentToMod_smul N hrel' ha hι Gy (j f) _).symm).trans
          (congrArg (fun z ↦ Φy (j f • z)) hc.symm))
  have hbij : Function.Bijective (μ.liftBaseChange Y.obj) :=
    bijective_liftBaseChange_of_span j hj μ β' hβ' hβt
  exact ⟨LinearEquiv.ofBijective (μ.liftBaseChange Y.obj) hbij, fun t ↦
    (LinearMap.liftBaseChange_tmul (A := Y.obj) μ 1 t).trans (one_smul _ _)⟩

include hb hsV htV in
/-- **Stacks 0DNT at a chart point**, for the algebra structure `g.toAlgebra`. -/
theorem isTangentBaseChangeIso_chart (g : X ⟶ Y) {M : SiteModule X.obj B}
    {N : SiteModule Y.obj B}
    (ψ : M.obj ⟶ (ModuleCat.restrictScalars (g.hom.hom : X.obj →+* Y.obj)).obj N.obj)
    {F : Type u} [CommRing F] [Algebra (ringOf B S hS T') F] [Module.Flat (ringOf B S hS T') F]
    (j : F →ₐ[ringOf B S hS T'] Y.obj)
    (hL : Function.Bijective (sqzTensorLift g ψ (card_sqz_lt M) (card_sqz_lt N) j))
    [Module.FinitePresentation P.obj Ω[P.obj⁄ringOf B S hS T']]
    [Module.FinitePresentation Q.obj Ω[Q.obj⁄ringOf B S hS T']]
    {v : Q.obj →ₐ[ringOf B S hS T'] X.obj} (hv : b.app X v = Arr.idt w)
    (ha : Stack.IsFormallySmoothOnObjects B S hS (Stack.schemeFibredCategory B S hS U₀) 𝒳 a)
    (hι : ∀ {C' C : SmallAlg (ringOf B S hS T') B.cutoff} (e : SqZero C' C)
      (m' : specOver C' ⟶ U₀) (u : P.obj →ₐ[ringOf B S hS T'] C.obj),
      specOverMap e.q ≫ m' = specOverMap (SmallAlg.homMk u) ≫ ι →
      ∃ u' : P.obj →ₐ[ringOf B S hS T'] C'.obj, e.q.hom.hom.comp u' = u ∧
        specOverMap (SmallAlg.homMk u') ≫ ι = m')
    (Fx : TangentFunctorData X.obj B S hS (toSOf X) (contains_spec X) 𝒳.val.p (ξ a ι w)
      (ξ_obj a ι w))
    (Gy : TangentFunctorData Y.obj B S hS (toSOf Y) (contains_spec Y) 𝒳.val.p
      (ξ a ι (g.hom.hom.comp w)) (ξ_obj a ι (g.hom.hom.comp w))) :
    letI : Algebra X.obj Y.obj := (g.hom.hom : X.obj →+* Y.obj).toAlgebra
    IsTangentBaseChangeIso 𝒳.property (toSOf_comp g) (trans a ι g w) (trans_isHomLift a ι g w)
      Fx Gy ψ :=
  let : Algebra X.obj Y.obj := (g.hom.hom : X.obj →+* Y.obj).toAlgebra
  isTangentBaseChangeIso_chart_of_algebraMap hb hsV htV g rfl ψ ψ (fun _ ↦ rfl) (toSOf_comp g)
    (trans_isHomLift a ι g w) j hL hv ha hι Fx Gy

end BaseChange

section SqzTensor

variable {A' : Type u} [CommRing A'] {κ : Cardinal.{u}} {X Y : SmallAlg A' κ} (g : X ⟶ Y)
  {M : ModuleCat.{u} X.obj} {N : ModuleCat.{u} Y.obj}
  (ψ : M ⟶ (ModuleCat.restrictScalars (g.hom.hom : X.obj →+* Y.obj)).obj N)
  (hM : Cardinal.mk (TrivSqZeroExt X.obj M) < κ) (hN : Cardinal.mk (TrivSqZeroExt Y.obj N) < κ)
  {F : Type u} [CommRing F] [Algebra A' F] (j : F →ₐ[A'] Y.obj)

/-- The `Z`-component of a product in `Z[K]` is the product of the `Z`-components. -/
theorem fst_sqz_mul {Z : SmallAlg A' κ} {K : ModuleCat.{u} Z.obj}
    {hK : Cardinal.mk (TrivSqZeroExt Z.obj K) < κ} (a b : (sqzAlg Z K hK).obj) :
    TrivSqZeroExt.fst (R := Z.obj) (M := K) (a * b) =
      TrivSqZeroExt.fst (R := Z.obj) (M := K) a * TrivSqZeroExt.fst (R := Z.obj) (M := K) b :=
  TrivSqZeroExt.fst_mul (R := Z.obj) (M := K) a b

/-- The `K`-component of a product in `Z[K]`: `(a * b)₁ = a₀ • b₁ + b₀ • a₁`. -/
theorem snd_sqz_mul {Z : SmallAlg A' κ} {K : ModuleCat.{u} Z.obj}
    {hK : Cardinal.mk (TrivSqZeroExt Z.obj K) < κ} (a b : (sqzAlg Z K hK).obj) :
    TrivSqZeroExt.snd (R := Z.obj) (M := K) (a * b) =
      TrivSqZeroExt.fst (R := Z.obj) (M := K) a • TrivSqZeroExt.snd (R := Z.obj) (M := K) b +
        TrivSqZeroExt.fst (R := Z.obj) (M := K) b • TrivSqZeroExt.snd (R := Z.obj) (M := K) a := by
  have := TrivSqZeroExt.snd_mul (R := Z.obj) (M := K) a b
  rw [op_smul_eq_smul] at this
  exact this

/-- The `A'`-action on `Z[K]` is multiplication by the image `(r, 0)` of `r ∈ A'`. -/
theorem sqz_smul_eq {Z : SmallAlg A' κ} {K : ModuleCat.{u} Z.obj}
    {hK : Cardinal.mk (TrivSqZeroExt Z.obj K) < κ} (r : A') (z : (sqzAlg Z K hK).obj) :
    r • z = sqzInl Z K hK (algebraMap A' Z.obj r) * z :=
  Algebra.smul_def r z

/-- `X[M] = X × M` as `A'`-modules, for the `A'`-module structure of `M` through `X`. -/
def sqzProdEquiv : letI : Module A' M := Module.compHom M (algebraMap A' X.obj)
    (sqzAlg X M hM).obj ≃ₗ[A'] X.obj × M :=
  letI : Module A' M := Module.compHom M (algebraMap A' X.obj)
  { toFun := fun z ↦ (TrivSqZeroExt.fst (R := X.obj) (M := M) z,
      TrivSqZeroExt.snd (R := X.obj) (M := M) z)
    invFun := fun p ↦ (TrivSqZeroExt.inl p.1 + TrivSqZeroExt.inr p.2 : TrivSqZeroExt X.obj M)
    left_inv := fun z ↦ TrivSqZeroExt.inl_fst_add_inr_snd_eq (R := X.obj) (M := M) z
    right_inv := fun p ↦ Prod.ext (by simp) (by simp)
    map_add' := fun _ _ ↦ rfl
    map_smul' := fun r z ↦ by
      refine Prod.ext ?_ ?_
      · change TrivSqZeroExt.fst (R := X.obj) (M := M) (r • z) =
          r • TrivSqZeroExt.fst (R := X.obj) (M := M) z
        rw [sqz_smul_eq, fst_sqz_mul, Algebra.smul_def]
        rfl
      · change TrivSqZeroExt.snd (R := X.obj) (M := M) (r • z) =
          algebraMap A' X.obj r • TrivSqZeroExt.snd (R := X.obj) (M := M) z
        rw [sqz_smul_eq, snd_sqz_mul]
        change _ + _ • (0 : M) = _
        rw [smul_zero, add_zero]
        rfl }

/-- **`X[M] ⊗_{A'} F ≅ Y[N]` from `X ⊗_{A'} F ≅ Y` and `M ⊗_{A'} F ≅ N`.** If
`x ⊗ f ↦ g x · j f` is a bijection `X ⊗_{A'} F → Y` and an additive bijection
`M ⊗_{A'} F → N` sends `m ⊗ f` to `j f • ψ m`, then `sqzTensorLift` is bijective. -/
theorem bijective_sqzTensorLift
    (hX : Function.Bijective (Algebra.TensorProduct.lift g.hom.hom j
      (fun _ _ ↦ Commute.all _ _) : X.obj ⊗[A'] F →ₐ[A'] Y.obj))
    (β : letI : Module A' M := Module.compHom M (algebraMap A' X.obj)
      M ⊗[A'] F →+ N)
    (hβ : Function.Bijective β)
    (hβt : letI : Module A' M := Module.compHom M (algebraMap A' X.obj)
      ∀ (m : M) (f : F), β (m ⊗ₜ f) = j f • ψ.hom m) :
    Function.Bijective (sqzTensorLift g ψ hM hN j) := by
  let : Module A' M := Module.compHom M (algebraMap A' X.obj)
  let lamX := Algebra.TensorProduct.lift g.hom.hom j (fun _ _ ↦ Commute.all _ _)
  let σ : (sqzAlg X M hM).obj ⊗[A'] F ≃ₗ[A'] (X.obj ⊗[A'] F) × (M ⊗[A'] F) :=
    (TensorProduct.congr (sqzProdEquiv hM) (LinearEquiv.refl A' F)).trans
      (TensorProduct.prodLeft A' A' X.obj M F)
  let τ : (X.obj ⊗[A'] F) × (M ⊗[A'] F) → (sqzAlg Y N hN).obj := fun p ↦
    (TrivSqZeroExt.inl (lamX p.1) + TrivSqZeroExt.inr (β p.2) : TrivSqZeroExt Y.obj N)
  have hτ : Function.Bijective τ := by
    refine ⟨fun p q h ↦ ?_, fun z ↦ ?_⟩
    · have h1 := congrArg (TrivSqZeroExt.fst (R := Y.obj) (M := N)) h
      have h2 := congrArg (TrivSqZeroExt.snd (R := Y.obj) (M := N)) h
      simp only [τ, TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr,
        add_zero, TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr,
        zero_add] at h1 h2
      exact Prod.ext (hX.1 h1) (hβ.1 h2)
    · obtain ⟨s, hs⟩ := hX.2 (TrivSqZeroExt.fst (R := Y.obj) (M := N) z)
      obtain ⟨t, ht⟩ := hβ.2 (TrivSqZeroExt.snd (R := Y.obj) (M := N) z)
      refine ⟨(s, t), ?_⟩
      change (TrivSqZeroExt.inl (lamX s) + TrivSqZeroExt.inr (β t) : TrivSqZeroExt Y.obj N) = z
      rw [hs, ht]
      exact TrivSqZeroExt.inl_fst_add_inr_snd_eq z
  have key : ∀ w, sqzTensorLift g ψ hM hN j w = τ (σ w) := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul z f =>
      change sqzTensorLift g ψ hM hN j (z ⊗ₜ f) = (TrivSqZeroExt.inl
        (lamX (TrivSqZeroExt.fst (R := X.obj) (M := M) z ⊗ₜ f)) +
          TrivSqZeroExt.inr (β (TrivSqZeroExt.snd (R := X.obj) (M := M) z ⊗ₜ f)) :
            TrivSqZeroExt Y.obj N)
      have hz : z ⊗ₜ[A'] f = (z ⊗ₜ[A'] (1 : F)) * ((1 : (sqzAlg X M hM).obj) ⊗ₜ[A'] f) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [hβt, hz, _root_.map_mul, sqzTensorLift_tmul_one, sqzTensorLift_one_tmul,
        Algebra.TensorProduct.lift_tmul]
      refine TrivSqZeroExt.ext ?_ ?_
      · refine (fst_sqz_mul _ _).trans ?_
        change _ = g.hom.hom (TrivSqZeroExt.fst z) * j f + 0
        rw [add_zero]
        rfl
      · refine (snd_sqz_mul _ _).trans ?_
        change _ • (0 : N) + _ = 0 + j f • (show N from ψ.hom (TrivSqZeroExt.snd z))
        rw [smul_zero, zero_add, zero_add]
        rfl
    | add w₁ w₂ h₁ h₂ =>
      rw [_root_.map_add, h₁, h₂, _root_.map_add]
      change _ = (TrivSqZeroExt.inl (lamX ((σ w₁).1 + (σ w₂).1)) +
        TrivSqZeroExt.inr (β ((σ w₁).2 + (σ w₂).2)) : TrivSqZeroExt Y.obj N)
      rw [_root_.map_add, _root_.map_add, TrivSqZeroExt.inl_add, TrivSqZeroExt.inr_add]
      change (TrivSqZeroExt.inl (lamX (σ w₁).1) + TrivSqZeroExt.inr (β (σ w₁).2) +
        (TrivSqZeroExt.inl (lamX (σ w₂).1) + TrivSqZeroExt.inr (β (σ w₂).2)) :
          TrivSqZeroExt Y.obj N) = _
      abel
  exact funext key ▸ hτ.comp σ.bijective

end SqzTensor

