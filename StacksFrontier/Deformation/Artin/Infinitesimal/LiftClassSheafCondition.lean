module

public import StacksFrontier.AlgebraicGeometry.Stacks.GroupoidLift.StackArrowInertia
public import StacksFrontier.AlgebraicGeometry.Topologies.Fppf.Equivalence
public import StacksFrontier.Deformation.Artin.Infinitesimal.LiftClassFamily

/-!
# The functor of isomorphism classes of infinitesimal lifts is an fppf sheaf (Stacks 0DNS)

Let `𝒳` be an algebraic stack over `S` whose inertia is locally of finite presentation, and
`(A' → A, x)` a deformation situation, written as an arrow `i : U ⟶ U'` of the big affine fppf
site of `S` with an object `x` of `𝒳` over `U`. The functor
`F : B' ↦ {lifts of x|_{B' ⊗_{A'} A} to B'}/isomorphism` is a sheaf on the localization at `U'`
of the big affine fppf site.

## Main results

* `Deformation.Artin.LiftClassSheaf.standardCoverage`: the coverage of `Over U'` by finite
  families whose underlying morphisms of affine schemes are standard fppf coverings.
* `Deformation.Artin.LiftClassSheaf.over_topology_le_toGrothendieck`: every covering sieve of the
  localized topology contains such a family.
* `Deformation.Artin.LiftClassSheaf.isSheaf_liftClassPresheaf`: **Stacks 0DNS**.

## Implementation notes

The localized topology is compared with the one generated by finite standard fppf families, for
which `Deformation.Artin.LiftClassSheaf.LiftClassPresheaf.isSheafFor_ofArrows` is the sheaf
condition. The inertia hypothesis enters only through the finiteness of the spaces of arrows of
charts (`AlgebraicGeometry.Stack.GroupoidLift.arrowSpacesLocallyOfFinitePresentation_of_inertia`),
which is what the descent along one affine fppf covering uses. The source deduces the sheaf
property from the vanishing of Čech cohomology of quasi-coherent modules on affines; here the
descent along an fppf covering is carried out on charts of `𝒳`.

## References

* [Stacks Project, Tag 0DNS](https://stacks.math.columbia.edu/tag/0DNS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Functor Opposite

namespace Deformation.Artin.LiftClassSheaf

universe u w

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {U' : BigAffineFppf B S hS}

/-- The finite families of `Over U'` whose underlying morphisms of affine schemes form a standard
fppf covering. -/
def standardCoverage : Coverage (Over U') where
  coverings W := {R | ∃ (n : ℕ) (Y : Fin n → Over U') (g : ∀ k, Y k ⟶ W),
    R = Presieve.ofArrows Y g ∧
      IsStandardFppfCovering (fun k ↦ (BigAffineFppf.toScheme B S hS).obj (Y k).left)
        (fun k ↦ (BigAffineFppf.toScheme B S hS).map (g k).left)}
  pullback := by
    rintro W Z f _ ⟨n, Yf, g, rfl, hg⟩
    refine ⟨Presieve.ofArrows (fun k ↦ pbObj f (g k)) (fun k ↦ pbFst f (g k)),
      ⟨n, _, _, rfl, ?_⟩, ?_⟩
    · have hsq : ∀ k, IsPullback ((BigAffineFppf.toScheme B S hS).map (pbFst f (g k)).left)
          ((BigAffineFppf.toScheme B S hS).map (pbSnd f (g k)).left)
          ((BigAffineFppf.toScheme B S hS).map f.left)
          ((BigAffineFppf.toScheme B S hS).map (g k).left) := fun k ↦
        IsPullback.map (BigAffineFppf.toScheme B S hS) (IsPullback.of_hasPullback f.left (g k).left)
      refine ⟨inferInstance, inferInstance, fun k ↦ inferInstance,
        fun k ↦ MorphismProperty.of_isPullback (P := @Flat) (hsq k).flip (hg.flat k),
        fun k ↦ ⟨MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation) (hsq k).flip
          (hg.finite_presentation k).1,
          MorphismProperty.of_isPullback (P := @QuasiCompact) (hsq k).flip
          (hg.finite_presentation k).2.1,
          MorphismProperty.of_isPullback (P := @QuasiSeparated) (hsq k).flip
          (hg.finite_presentation k).2.2⟩, ?_⟩
      refine Set.eq_univ_of_forall fun z ↦ ?_
      have hz : (BigAffineFppf.toScheme B S hS).map f.left z ∈
          ⋃ k, Set.range ((BigAffineFppf.toScheme B S hS).map (g k).left) := by
        rw [hg.jointly_surjective]
        trivial
      obtain ⟨k, y, hy⟩ := Set.mem_iUnion.1 hz
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine Set.mem_iUnion.2 ⟨k, (hsq k).isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hw]
    · rintro _ _ ⟨k⟩
      exact ⟨Yf k, pbSnd f (g k), g k, ⟨k⟩, (pb_comm f (g k)).symm⟩

/-- Every covering sieve of the big affine fppf site contains a finite standard fppf family. -/
theorem exists_standard_of_mem_topology {X : BigAffineFppf B S hS} {R : Sieve X}
    (hR : R ∈ BigAffineFppf.topology B S hS X) :
    ∃ (n : ℕ) (Xk : Fin n → BigAffineFppf B S hS) (v : ∀ k, Xk k ⟶ X), (∀ k, R (v k)) ∧
      IsStandardFppfCovering (fun k ↦ (BigAffineFppf.toScheme B S hS).obj (Xk k))
        (fun k ↦ (BigAffineFppf.toScheme B S hS).map (v k)) := by
  have hR' := (Functor.IsDenseSubsite.functorPushforward_mem_iff
    (G := BigAffineFppf.inclusion B S hS) (J := BigAffineFppf.topology B S hS)
    (K := BigFppfOver.topology B S hS)).2 hR
  rw [BigFppfOver.topology, GrothendieckTopology.mem_over_iff] at hR'
  have : IsAffine (B.inclusion.obj ((BigAffineFppf.inclusion B S hS).obj X).left) := X.property
  obtain ⟨Q, -, hQ, hQle⟩ := exists_standardFppf_refinement B hR'
  have := hQ.finite_index
  obtain ⟨n, ⟨σ⟩⟩ := Finite.exists_equiv_fin Q.I₀
  let Xk : Fin n → BigAffineFppf B S hS := fun k ↦
    ⟨Over.mk (Q.f (σ.symm k) ≫ ((BigAffineFppf.inclusion B S hS).obj X).hom),
      hQ.affine_source (σ.symm k)⟩
  let v : ∀ k, Xk k ⟶ X := fun k ↦ ObjectProperty.homMk (Over.homMk (Q.f (σ.symm k)))
  refine ⟨n, Xk, v, fun k ↦ ?_, ⟨inferInstance, hQ.affine_target, fun k ↦ hQ.affine_source _,
    fun k ↦ hQ.flat _, fun k ↦ hQ.finite_presentation _, ?_⟩⟩
  · have hk := hQle _ _ (Presieve.ofArrows.mk (σ.symm k))
    rw [Sieve.overEquiv_iff] at hk
    obtain ⟨Z, g, h, hg, he⟩ := hk
    have : v k = ObjectProperty.homMk h ≫ g :=
      (BigAffineFppf.inclusion B S hS).map_injective he
    rw [this]
    exact R.downward_closed hg _
  · exact (σ.symm.surjective.iUnion_comp
      (fun i ↦ Set.range (B.inclusion.map (Q.f i)))).trans hQ.jointly_surjective

/-- **Every covering sieve of the localized big affine fppf topology contains a finite standard
fppf family.** -/
theorem over_topology_le_toGrothendieck :
    (BigAffineFppf.topology B S hS).over U' ≤ (standardCoverage (U' := U')).toGrothendieck := by
  intro W R hR
  rw [GrothendieckTopology.mem_over_iff] at hR
  obtain ⟨n, Xk, v, hv, hstd⟩ := exists_standard_of_mem_topology hR
  refine (standardCoverage (U' := U')).toGrothendieck.superset_covering ?_
    (Coverage.mem_toGrothendieck.2 (Coverage.Saturate.of _ _
      ⟨n, fun k ↦ Over.mk (v k ≫ W.hom), fun k ↦ Over.homMk (v k), rfl, hstd⟩))
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨k⟩
  exact (Sieve.overEquiv_iff R (v k)).1 (hv k)

variable {U : BigAffineFppf B S hS} {𝒳 : Stack.AlgebraicStacks.{u, w} B S hS} {i : U ⟶ U'}
  {x : 𝒳.val.val.obj} {hx : 𝒳.val.val.p.obj x = (BigAffineFppf.inclusion B S hS).obj U}

/-- The functor of lift classes is a sheaf as soon as the spaces of arrows of charts of `𝒳` are
locally of finite presentation. -/
theorem LiftClassPresheaf.isSheaf_of_arrSpace (P : LiftClassPresheaf B S hS 𝒳 i x hx)
    (harr : Stack.GroupoidLift.ArrowSpacesLocallyOfFinitePresentation B S hS 𝒳.val)
    (hi : IsDeformationSituation (ringMap B S hS i).hom) :
    Presheaf.IsSheaf ((BigAffineFppf.topology B S hS).over U') P.presheaf := by
  rw [isSheaf_iff_isSheaf_of_type]
  refine Presieve.isSheaf_of_le _ over_topology_le_toGrothendieck ?_
  rw [Presieve.isSheaf_coverage]
  rintro W _ ⟨n, Y, g, rfl, hg⟩
  exact P.isSheafFor_ofArrows harr hi Y g hg

/-- **Stacks 0DNS.** For an algebraic stack over a base scheme whose inertia is locally of finite
presentation, and a deformation situation `(A' → A, x)`, the functor sending an affine
`A'`-algebra `B'` to the isomorphism classes of lifts of `x|_{B' ⊗_{A'} A}` to `B'` is a sheaf on
the big affine fppf site of `Spec A'`. -/
@[stacks 0DNS]
theorem isSheaf_liftClassPresheaf
    (hI : Stack.AlgebraicStacks.IsLocallyOfFinitePresentation B S hS
      (Stack.relativeInertiaProjection B S hS (Stack.structureMorphism B S hS 𝒳)))
    (hi : IsDeformationSituation (ringMap B S hS i).hom) (P : LiftClassPresheaf B S hS 𝒳 i x hx) :
    Presheaf.IsSheaf ((BigAffineFppf.topology B S hS).over U') P.presheaf :=
  P.isSheaf_of_arrSpace
    (Stack.GroupoidLift.arrowSpacesLocallyOfFinitePresentation_of_inertia 𝒳.property hI) hi

end Deformation.Artin.LiftClassSheaf

end
