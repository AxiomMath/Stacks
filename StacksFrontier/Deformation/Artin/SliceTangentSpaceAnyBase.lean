module

public import StacksFrontier.Algebra.Module.OppositeOfCommSemiring
public import StacksFrontier.Deformation.Artin.SliceTangentSpace

/-!
# The tangent space of a point of a scheme, over any deformation base

`Deformation.Artin.SliceTangent.finiteDimensional_artinianTangentSpace_sliceBased` proves that the
tangent space of the deformation category `𝓕_{(Sch/V),k,v₀}` of a point of a scheme `V` locally
of finite type over `S` is finite dimensional, when the deformation base `Spec Λ ⟶ S` is an open
immersion. This file removes that hypothesis: the deformation base `iΛ : Spec Λ ⟶ S` is
arbitrary, in particular it may be `Spec 𝒪_{S,s} ⟶ S`, the base Artin's criterion uses.

The argument is the one of the source, with the affine open of `S` decoupled from the
deformation base. Choose an affine open `W = Spec Λ'` of `S` containing the image of the point
and an affine open `U = Spec R` of `V` containing the point and lying over `W`; then `R` is of
finite type over `Λ'`, generated by finitely many elements. A deformation over an Artinian local
`Λ`-algebra `A` is a morphism `Spec A ⟶ V` over `S`; since `Spec A` has a single point it lands
in `U`, so it is a ring map `R ⟶ A`, and its restriction to `Λ'` is determined by the structure
morphism `Spec A ⟶ S` alone (the open immersion `Spec Λ' ⟶ S` is a monomorphism). Two
deformations over `A` with the same values on the generators therefore have the same ring map,
which gives the natural injection of `𝓕(k[W])` into `W^n` that
`Deformation.finiteDimensional_artinianTangentSpace_of_natural_injection` needs.

## Main results

* `Deformation.Artin.SliceTangent.finiteDimensional_artinianTangentSpace_sliceBased_anyBase`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Limits IsLocalRing

namespace Deformation.Artin.SliceTangent

universe u

attribute [local implicit_reducible]
  CategoryTheory.Functor.Fiber CategoryTheory.Functor.Fiber.mk
  CategoryTheory.Functor.Fiber.fiberInclusion

variable {B : BigFppfSite.{u}} {S : Scheme.{u}} {hS : B.Contains S} {V : BigFppfOver B S hS}
variable {Λ k : Type u} [CommRing Λ] [Field k] [Algebra Λ k] {iΛ : Spec (.of Λ) ⟶ S}
variable {v₀ : Over V}
variable {hv₀ : (Over.forget V ⋙ Over.post B.inclusion).obj v₀ =
  Over.mk (Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ)}

/-! ### The ring map out of a chart over an affine open of `S` -/

section Value

variable {Λ' : Type u} [CommRing Λ'] {j : Spec (.of Λ') ⟶ S} [IsOpenImmersion j]
  (c : AffineChart j (B.inclusion.map V.hom) ((pointMap hv₀).base (closedPt (.of k))))

omit [IsOpenImmersion j] in
theorem range_pointMap_anyBase
    (c : AffineChart j (B.inclusion.map V.hom) ((pointMap hv₀).base (closedPt (.of k)))) :
    Set.range (pointMap hv₀).base ⊆ c.U := by
  rintro _ ⟨z, rfl⟩
  have hz : z = closedPt (.of k) := Subsingleton.elim _ _
  rw [hz]
  exact c.mem

omit [IsOpenImmersion j] in
theorem range_chartPointMap_anyBase
    (c : AffineChart j (B.inclusion.map V.hom) ((pointMap hv₀).base (closedPt (.of k))))
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    Set.range (chartPointMap x hx).base ⊆ c.U := by
  apply c.range_subset (A := CommRingCat.of A)
  rw [← closedPoint_eq A, ← Scheme.Hom.comp_apply, residue_chartPointMap]
  exact c.mem

omit [IsOpenImmersion j] in
/-- The ring map out of the chart is compatible with precomposition by a spectrum map. -/
private theorem ringMap_comp_of_comp_eq {A A' : CommRingCat.{u}} (β : A ⟶ A')
    {g : Spec A ⟶ B.inclusion.obj V.left} {g' : Spec A' ⟶ B.inclusion.obj V.left}
    (hg : Set.range g.base ⊆ c.U) (hg' : Set.range g'.base ⊆ c.U) (h : Spec.map β ≫ g = g') :
    c.ringMap g' hg' = c.ringMap g hg ≫ β := by
  subst h
  exact c.ringMap_comp β g hg hg'

/-- The ring map out of the chart attached to a deformation. -/
def chartValueAnyBase
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    c.ring ⟶ CommRingCat.of A :=
  c.ringMap (chartPointMap x hx) (range_chartPointMap_anyBase c x hx)

omit [IsOpenImmersion j] in
theorem chartValueAnyBase_of_morphism
    {x y : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) (hy : y.algebra = A')
    (m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ x y)
    (β : A ⟶ A') (hm : m.ringHom = eqToHom hx ≫ β ≫ eqToHom hy.symm) :
    chartValueAnyBase c y hy = chartValueAnyBase c x hx ≫ CommRingCat.ofHom β.hom.toRingHom := by
  exact ringMap_comp_of_comp_eq c _ _ _ (chartPointMap_of_morphism hx hy m β hm).symm

/-- Two deformations over the same algebra induce the same ring map out of the ring of the
affine open of `S`: both are read off the structure morphism `Spec A ⟶ S`, through the
monomorphism `Spec Λ' ⟶ S`. -/
theorem structureMap_chartValueAnyBase
    (x x' : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) (hx' : x'.algebra = A) :
    c.structureMap ≫ chartValueAnyBase c x hx = c.structureMap ≫ chartValueAnyBase c x' hx' := by
  apply Spec.map_injective
  apply (cancel_mono j).mp
  rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc, c.spec_structureMap,
    ← Category.assoc, ← Category.assoc, chartValueAnyBase, chartValueAnyBase, c.spec_ringMap,
    c.spec_ringMap, chartPointMap_comp, chartPointMap_comp]

omit [IsOpenImmersion j] in
theorem chartValueAnyBase_residue
    (x : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀)
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) :
    chartValueAnyBase c x hx ≫ CommRingCat.ofHom (residueMap A) =
      c.ringMap (pointMap hv₀) (range_pointMap_anyBase c) := by
  exact (ringMap_comp_of_comp_eq c _ _ _ (residue_chartPointMap x hx)).symm

omit [IsOpenImmersion j] in
theorem exists_morphism_of_chartValueAnyBase_eq
    {x x' : DeformationObject iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀}
    {A : ArtinianLocalAlgCat.{u, u, u} Λ k} (hx : x.algebra = A) (hx' : x'.algebra = A)
    (h : chartValueAnyBase c x hx = chartValueAnyBase c x' hx') :
    ∃ m : DeformationMorphism iΛ (Over.forget V ⋙ Over.post B.inclusion) v₀ hv₀ x x',
      m.ringHom = eqToHom (hx.trans hx'.symm) := by
  have h' : chartPointMap x hx = chartPointMap x' hx' := c.ringMap_injective _ _ h
  apply exists_morphism_of_deformationMap_eq
  subst hx'
  rw [chartPointMap, chartPointMap, eqToHom_refl, specMap_id, Category.id_comp] at h'
  rw [← h']

end Value

/-! ### The tangent map -/

-- The bimodule structure on a vector space under which `TrivSqZeroExt k W` is formed in
-- `Deformation.squareZeroExtensionArtinian`.
local instance moduleMulOppositeAnyBase (W : FGModuleCat.{u} k) : Module kᵐᵒᵖ W :=
  Module.oppositeOfCommSemiring k W

local instance isCentralScalarAnyBase (W : FGModuleCat.{u} k) : IsCentralScalar k W :=
  Module.isCentralScalar_oppositeOfCommSemiring k W

section Tangent

variable {Λ' : Type u} [CommRing Λ'] {j : Spec (.of Λ') ⟶ S} [IsOpenImmersion j]
  (c : AffineChart j (B.inclusion.map V.hom) ((pointMap hv₀).base (closedPt (.of k))))

/-- The ring map out of the chart attached to an object of a fibre of the deformation
category. -/
def fiberValueAnyBase {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (x : (sliceBased iΛ v₀ hv₀).p.Fiber A) : c.ring ⟶ CommRingCat.of A :=
  chartValueAnyBase c x.1 x.2

omit [IsOpenImmersion j] in
theorem fiberValueAnyBase_of_isHomLift {A A' : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (x : (sliceBased iΛ v₀ hv₀).p.Fiber A) (y : (sliceBased iΛ v₀ hv₀).p.Fiber A')
    (β : A ⟶ A') (a : x.1 ⟶ y.1) [(sliceBased iΛ v₀ hv₀).p.IsHomLift β a] :
    fiberValueAnyBase c y = fiberValueAnyBase c x ≫ CommRingCat.ofHom β.hom.toRingHom := by
  apply chartValueAnyBase_of_morphism c x.2 y.2 a β
  exact IsHomLift.fac' (sliceBased iΛ v₀ hv₀).p β a

omit [IsOpenImmersion j] in
theorem fiberValueAnyBase_eq_of_classOf_eq {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (x y : (sliceBased iΛ v₀ hv₀).p.Fiber A)
    (h : classOf (sliceBased iΛ v₀ hv₀) h𝓕 x = classOf (sliceBased iΛ v₀ hv₀) h𝓕 y) :
    fiberValueAnyBase c x = fiberValueAnyBase c y := by
  have hq : Quotient.mk (isIsomorphicSetoid _) x = Quotient.mk (isIsomorphicSetoid _) y := by
    rw [← classOf_eq, ← classOf_eq, h]
  obtain ⟨e⟩ := Quotient.exact hq
  have : (sliceBased iΛ v₀ hv₀).p.IsHomLift (𝟙 A) e.hom.1 := e.hom.2
  rw [fiberValueAnyBase_of_isHomLift c x y (𝟙 A) e.hom.1]
  simp only [ArtinianLocalAlgCat.id_hom]
  rfl

/-- The ring map out of the chart attached to an isomorphism class of a fibre. -/
def classValueAnyBase {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (z : (isomorphismClasses (sliceBased iΛ v₀ hv₀) h𝓕).obj A) : c.ring ⟶ CommRingCat.of A :=
  fiberValueAnyBase c (classOf_surjective (sliceBased iΛ v₀ hv₀) h𝓕 A z).choose

omit [IsOpenImmersion j] in
theorem classValueAnyBase_classOf {A : ArtinianLocalAlgCat.{u, u, u} Λ k}
    (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (x : (sliceBased iΛ v₀ hv₀).p.Fiber A) :
    classValueAnyBase c h𝓕 (classOf (sliceBased iΛ v₀ hv₀) h𝓕 x) = fiberValueAnyBase c x :=
  fiberValueAnyBase_eq_of_classOf_eq c h𝓕 _ _
    (classOf_surjective (sliceBased iΛ v₀ hv₀) h𝓕 A _).choose_spec

/-- The family of maps from the tangent-space set functor to `W ↦ W^ι`, reading the
square-zero component of the ring map out of the chart on the chosen elements. -/
def tangentMapAnyBase (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (gens : Set c.ring) (W : FGModuleCat.{u} k)
    (z : (associatedTangentSpaceSetFunctor (sliceBased iΛ v₀ hv₀) h𝓕).obj W) :
    (powFunctor k gens).obj W :=
  fun i => TrivSqZeroExt.snd (R := k) (M := W) ((classValueAnyBase c h𝓕 z).hom i.1)

omit [IsOpenImmersion j] in
theorem tangentMapAnyBase_naturality (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (gens : Set c.ring) {W W' : FGModuleCat.{u} k} (f : W ⟶ W')
    (z : (associatedTangentSpaceSetFunctor (sliceBased iΛ v₀ hv₀) h𝓕).obj W) :
    tangentMapAnyBase c h𝓕 gens W'
        ((associatedTangentSpaceSetFunctor (sliceBased iΛ v₀ hv₀) h𝓕).map f z) =
      ((powFunctor k gens).map f) (tangentMapAnyBase c h𝓕 gens W z) := by
  let 𝓕 := sliceBased iΛ v₀ hv₀
  let F := squareZeroExtensionRestriction Λ k (artinianLocalOver Λ k)
    (squareZeroExtension_mem_artinianLocalOver Λ k) ⋙ artinianLocalOverToArtinian Λ k
  obtain ⟨x, rfl⟩ := classOf_surjective 𝓕 h𝓕 _ z
  obtain ⟨y, a, ha⟩ := h𝓕.exists_lift (F.map f).op (Opposite.op x.1) (congrArg Opposite.op x.2)
  have ha' : 𝓕.p.IsHomLift (F.map f) a.unop := by
    exact IsHomLift.of_fac 𝓕.p (F.map f) a.unop x.2
      (congrArg Opposite.unop (IsHomLift.domain_eq 𝓕.p.op (F.map f).op a))
      (by simpa using congrArg Quiver.Hom.unop (IsHomLift.fac 𝓕.p.op (F.map f).op a))
  let y' : 𝓕.p.Fiber (F.obj W') := ⟨y.unop, IsHomLift.codomain_eq 𝓕.p (F.map f) a.unop⟩
  change tangentMapAnyBase c h𝓕 gens W'
    ((isomorphismClasses 𝓕 h𝓕).map (F.map f) (classOf 𝓕 h𝓕 x)) = _
  rw [map_classOf 𝓕 h𝓕 (F.map f) x y' a.unop]
  have e1 : classValueAnyBase c h𝓕 (classOf 𝓕 h𝓕 y') =
      classValueAnyBase c h𝓕 (classOf 𝓕 h𝓕 x) ≫ CommRingCat.ofHom (F.map f).hom.toRingHom := by
    rw [classValueAnyBase_classOf, classValueAnyBase_classOf,
      fiberValueAnyBase_of_isHomLift c x y' (F.map f) a.unop]
  funext i
  change TrivSqZeroExt.snd (R := k) (M := W')
      ((classValueAnyBase c h𝓕 (classOf 𝓕 h𝓕 y')).hom i.1) =
    f.hom.hom (TrivSqZeroExt.snd (R := k) (M := W)
      ((classValueAnyBase c h𝓕 (classOf 𝓕 h𝓕 x)).hom i.1))
  rw [e1, CommRingCat.comp_apply]
  exact TrivSqZeroExt.snd_map f.hom.hom _

theorem tangentMapAnyBase_injective (h𝓕 : IsCofiberedInGroupoids (sliceBased iΛ v₀ hv₀).p)
    (gens : Set c.ring)
    (hgens : @Algebra.adjoin Λ' c.ring _ _ c.structureMap.hom.toAlgebra gens = ⊤) :
    Function.Injective (tangentMapAnyBase c h𝓕 gens (FGModuleCat.of k k)) := by
  let 𝓕 := sliceBased iΛ v₀ hv₀
  intro z z' hzz
  obtain ⟨x, rfl⟩ := classOf_surjective 𝓕 h𝓕 _ z
  obtain ⟨x', rfl⟩ := classOf_surjective 𝓕 h𝓕 _ z'
  have hv : fiberValueAnyBase c x = fiberValueAnyBase c x' := by
    apply ringHom_ext_of_adjoin (Λ := Λ') c.structureMap gens hgens
    · exact structureMap_chartValueAnyBase c x.1 x'.1 x.2 x'.2
    · intro r hr
      have hsnd := congrFun hzz ⟨r, hr⟩
      simp only [tangentMapAnyBase] at hsnd
      rw [classValueAnyBase_classOf, classValueAnyBase_classOf] at hsnd
      exact TrivSqZeroExt.ext (congrArg (fun χ => χ r) ((chartValueAnyBase_residue c x.1 x.2).trans
        (chartValueAnyBase_residue c x'.1 x'.2).symm)) hsnd
  obtain ⟨m, hm⟩ := exists_morphism_of_chartValueAnyBase_eq c x.2 x'.2 hv
  let φ : x.1 ⟶ x'.1 := m
  let A0 := (artinianSquareZeroExtensionFunctor Λ k).obj (FGModuleCat.of k k)
  have hφ : 𝓕.p.IsHomLift (𝟙 A0) φ := by
    apply IsHomLift.of_fac 𝓕.p _ φ x.2 x'.2
    change 𝟙 A0 = eqToHom _ ≫ m.ringHom ≫ eqToHom _
    rw [hm]
    have key : ∀ {X Y Z : ArtinianLocalAlgCat.{u, u, u} Λ k} (h₁ : X = Y) (h₂ : Y = Z)
        (h₃ : Z = X), 𝟙 X = eqToHom h₁ ≫ eqToHom h₂ ≫ eqToHom h₃ := by
      intro X Y Z h₁ h₂ h₃
      subst h₁ h₂
      simp
    exact key _ _ _
  have : IsIso (𝓕.p.map φ) := by
    change IsIso m.ringHom
    rw [hm]
    infer_instance
  have : IsIso φ := isIso_of_isIso_map h𝓕 φ
  apply classOf_eq_of_isIsomorphic
  have : 𝓕.p.IsHomLift (𝟙 A0) (inv φ) := by
    have h := IsHomLift.inv 𝓕.p (𝟙 A0) φ
    simpa using h
  refine ⟨⟨Functor.Fiber.homMk 𝓕.p A0 φ, Functor.Fiber.homMk 𝓕.p A0 (inv φ), ?_, ?_⟩⟩
  · exact Functor.Fiber.hom_ext (IsIso.hom_inv_id φ)
  · exact Functor.Fiber.hom_ext (IsIso.inv_hom_id φ)

end Tangent

/-! ### Finite dimensionality -/

/-- **The tangent space of the deformation category of a point of a scheme locally of finite
type over `S` is finite dimensional, over any deformation base `Spec Λ ⟶ S`**, for its
canonical vector space structure. -/
theorem finiteDimensional_artinianTangentSpace_sliceBased_anyBase {iΛ : Spec (.of Λ) ⟶ S}
    {hv₀ : (Over.forget V ⋙ Over.post B.inclusion).obj v₀ =
      Over.mk (Spec.map (CommRingCat.ofHom (algebraMap Λ k)) ≫ iΛ)}
    [LocallyOfFiniteType (B.inclusion.map V.hom)]
    (h : IsPredeformationCategory (sliceBased iΛ v₀ hv₀).p)
    (hS2 : SchlessingerConditionS2
      (Functor.Elements.π (isomorphismClasses (sliceBased iΛ v₀ hv₀) h.cofibered))) :
    letI : Fact (IsPredeformationCategory (sliceBased iΛ v₀ hv₀).p) := ⟨h⟩
    letI : Fact (SchlessingerConditionS2
      (Functor.Elements.π (isomorphismClasses (sliceBased iΛ v₀ hv₀) h.cofibered))) := ⟨hS2⟩
    FiniteDimensional k
      (artinianTangentSpace Λ k (isomorphismClasses (sliceBased iΛ v₀ hv₀) h.cofibered)) := by
  let y₀ := (pointMap hv₀).base (closedPt (.of k))
  obtain ⟨W, hW, hsW⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens S)) (TopologicalSpace.Opens.mem_top
      ((B.inclusion.map V.hom).base y₀))
  have hmem : (B.inclusion.map V.hom).base y₀ ∈ Set.range hW.fromSpec.base := by
    rw [hW.range_fromSpec]
    exact hsW.1
  let jW : Spec (.of (Γ(S, W) : Type u)) ⟶ S := hW.fromSpec
  have : IsOpenImmersion jW := hW.isOpenImmersion_fromSpec
  obtain ⟨c⟩ := nonempty_affineChart (s := B.inclusion.map V.hom) (iΛ := jW) hmem
  obtain ⟨t, ht⟩ := c.finiteType_structureMap.out
  exact finiteDimensional_artinianTangentSpace_of_natural_injection (sliceBased iΛ v₀ hv₀) h hS2
    (powFunctor k (t : Set c.ring)) (tangentMapAnyBase c h.cofibered t)
    (fun f z => tangentMapAnyBase_naturality c h.cofibered t f z)
    (tangentMapAnyBase_injective c h.cofibered t ht)

end Deformation.Artin.SliceTangent

end
