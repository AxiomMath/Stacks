module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.Artinian.Ring
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.HopkinsLevitzki
public import StacksFrontier.RingTheory.AdicCompletion.NoetherianRing

/-!
# Artinian points of the completion of a local ring of a Noetherian ring

Let `Λ` be a Noetherian ring, `𝔪 ⊂ Λ` a maximal ideal and `R = Λ_𝔪^∧` the completion of the
local ring of `Λ` at `𝔪`. This file collects the commutative algebra of `R` used in the
geometric half of Stacks Example 98.12.8 (tag 07XI): `Λ → R / 𝔪_R ^ n` is surjective for every
`n`, the maximal ideal of `R` is generated by `𝔪`, and every local ring `B` with nilpotent
maximal ideal which is a `Λ`-algebra with `𝔪_B ∩ Λ = 𝔪` receives a `Λ`-algebra map from `R`.
It also shows that an Artinian local `Λ`-algebra whose residue field is generated by the image
of `Λ` is of finite type over `Λ`.

## Main definitions

* `Deformation.Artin.GRingNecessity.Completion`: the completion `Λ_𝔪^∧`.
* `Deformation.Artin.GRingNecessity.completionLift`: the `Λ`-algebra map `Λ_𝔪^∧ → B` into a
  local ring with nilpotent maximal ideal lying over `𝔪`.

## Main results

* `Deformation.Artin.GRingNecessity.exists_sub_mem_pow_completion`: `Λ → Λ_𝔪^∧ / 𝔪^n` is
  surjective.
* `Deformation.Artin.GRingNecessity.maximalIdeal_completion_eq_map`: the maximal ideal of
  `Λ_𝔪^∧` is `𝔪 Λ_𝔪^∧`.
* `Deformation.Artin.GRingNecessity.algHom_ext_of_pow_le_ker`: two `Λ`-algebra maps out of
  `Λ_𝔪^∧` killing a common power of its maximal ideal agree.
* `Deformation.Artin.GRingNecessity.finiteType_of_residue_surjective`: an Artinian local
  `Λ`-algebra whose residue field is a quotient of `Λ` is of finite type over `Λ`.

## Implementation notes

The completion is Mathlib's `AdicCompletion` of `Localization.AtPrime 𝔪` at its maximal
ideal, with the `Λ`-algebra structure induced from `Λ → Λ_𝔪`. The map `completionLift`
is built from the evaluation `Λ_𝔪^∧ → Λ_𝔪 / 𝔪^N` and the localization of `Λ → B`, with `N`
any exponent killing the maximal ideal of `B`.

## References

* [Stacks Project, Tag 07XI](https://stacks.math.columbia.edu/tag/07XI)
* [Stacks Project, Tag 02HT](https://stacks.math.columbia.edu/tag/02HT)
-/

@[expose] public section

namespace Deformation.Artin.GRingNecessity

open IsLocalRing

universe u v

/-! ### Artinian local algebras -/

section Artinian

variable {Λ : Type u} [CommRing Λ] {X : Type v} [CommRing X] [IsLocalRing X]

/-- The maximal ideal of an Artinian local ring is nilpotent. -/
theorem exists_pow_maximalIdeal_eq_bot [IsArtinianRing X] :
    ∃ N : ℕ, maximalIdeal X ^ N = ⊥ := by
  have h := IsArtinianRing.isNilpotent_jacobson_bot (R := X)
  rwa [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top] at h

/-- An Artinian local `Λ`-algebra whose residue field is generated by the image of `Λ` is of
finite type over `Λ`: it is generated by any finite set of generators of its maximal ideal. -/
theorem finiteType_of_residue_surjective [IsArtinianRing X] [Algebra Λ X]
    (hX : Function.Surjective ((residue X).comp (algebraMap Λ X))) :
    Algebra.FiniteType Λ X := by
  obtain ⟨s, hs⟩ := (maximalIdeal X).fg_of_isNoetherianRing
  obtain ⟨N, hN⟩ := exists_pow_maximalIdeal_eq_bot (X := X)
  refine ⟨⟨s, ?_⟩⟩
  set T := Algebra.adjoin Λ (s : Set X)
  have Q0 : ∀ x : X, ∃ t ∈ T, x - t ∈ maximalIdeal X := by
    intro x
    obtain ⟨l, hl⟩ := hX (residue X x)
    refine ⟨algebraMap Λ X l, T.algebraMap_mem l, ?_⟩
    rw [← residue_eq_zero_iff, map_sub, sub_eq_zero]
    exact hl.symm
  have hadd : ∀ {J K : Ideal X} {x y : X}, (∃ t ∈ T, t ∈ J ∧ x - t ∈ K) →
      (∃ t ∈ T, t ∈ J ∧ y - t ∈ K) → ∃ t ∈ T, t ∈ J ∧ x + y - t ∈ K := by
    rintro J K x y ⟨tx, htxT, htxm, htx⟩ ⟨ty, htyT, htym, hty⟩
    refine ⟨tx + ty, T.add_mem htxT htyT, add_mem htxm htym, ?_⟩
    rw [add_sub_add_comm]
    exact add_mem htx hty
  have Q1 : ∀ e ∈ maximalIdeal X, ∃ t ∈ T, t ∈ maximalIdeal X ∧
      e - t ∈ maximalIdeal X ^ 2 := by
    intro e he
    rw [← hs] at he
    induction he using Submodule.span_induction with
    | mem x hx =>
      exact ⟨x, Algebra.subset_adjoin hx, hs ▸ Ideal.subset_span hx, by simp⟩
    | zero => exact ⟨0, T.zero_mem, zero_mem _, by simp⟩
    | add x y _ _ hx hy => exact hadd hx hy
    | smul c x hx' hx =>
      obtain ⟨tx, htxT, htxm, htx⟩ := hx
      obtain ⟨tc, htcT, htc⟩ := Q0 c
      refine ⟨tc * tx, T.mul_mem htcT htxT, Ideal.mul_mem_left _ _ htxm, ?_⟩
      rw [smul_eq_mul, show c * x - tc * tx = (c - tc) * x + tc * (x - tx) by ring]
      refine add_mem ?_ (Ideal.mul_mem_left _ _ htx)
      rw [pow_two]
      exact Ideal.mul_mem_mul htc (hs ▸ hx')
  have Qk : ∀ k : ℕ, ∀ e ∈ maximalIdeal X ^ k, ∃ t ∈ T, t ∈ maximalIdeal X ^ k ∧
      e - t ∈ maximalIdeal X ^ (k + 1) := by
    intro k
    induction k with
    | zero =>
      intro e _
      obtain ⟨t, ht, he⟩ := Q0 e
      exact ⟨t, ht, by simp, by simpa using he⟩
    | succ k ih =>
      intro e he
      rw [pow_succ] at he
      refine Submodule.mul_induction_on he ?_ ?_
      · intro a ha b hb
        obtain ⟨ta, htaT, htam, hta⟩ := ih a ha
        obtain ⟨tb, htbT, htbm, htb⟩ := Q1 b hb
        refine ⟨ta * tb, T.mul_mem htaT htbT, ?_, ?_⟩
        · rw [pow_succ]
          exact Ideal.mul_mem_mul htam htbm
        · rw [show a * b - ta * tb = (a - ta) * b + ta * (b - tb) by ring]
          refine add_mem ?_ ?_
          · rw [pow_succ]
            exact Ideal.mul_mem_mul hta hb
          · rw [show k + 1 + 1 = k + 2 by rfl, pow_add]
            exact Ideal.mul_mem_mul htam htb
      · exact fun _ _ => hadd
  have main : ∀ k : ℕ, ∀ x : X, ∃ t ∈ T, x - t ∈ maximalIdeal X ^ k := by
    intro k
    induction k with
    | zero => intro x; exact ⟨0, T.zero_mem, by simp⟩
    | succ k ih =>
      intro x
      obtain ⟨t, ht, hxt⟩ := ih x
      obtain ⟨t', ht', -, hxt'⟩ := Qk k _ hxt
      refine ⟨t + t', T.add_mem ht ht', ?_⟩
      rw [show x - (t + t') = x - t - t' by ring]
      exact hxt'
  rw [eq_top_iff]
  intro x _
  obtain ⟨t, ht, hxt⟩ := main N x
  rw [hN, Ideal.mem_bot, sub_eq_zero] at hxt
  rwa [hxt]

end Artinian

section Completion

variable {Λ : Type u} [CommRing Λ] (𝔪 : Ideal Λ) [𝔪.IsMaximal]

/-- The completion `Λ_𝔪^∧` of the local ring of `Λ` at the maximal ideal `𝔪`. -/
abbrev Completion : Type u :=
  AdicCompletion (maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)

/-! ### The local ring `Λ_𝔪` modulo powers of its maximal ideal -/

/-- Every element of `Λ_𝔪` is congruent to an element of `Λ` modulo every power of the
maximal ideal: `Λ / 𝔪 ^ n → Λ_𝔪 / 𝔪 ^ n` is surjective because `𝔪` is maximal. -/
theorem exists_sub_mem_pow_localization (n : ℕ) (x : Localization.AtPrime 𝔪) :
    ∃ l : Λ, x - algebraMap Λ (Localization.AtPrime 𝔪) l ∈
      maximalIdeal (Localization.AtPrime 𝔪) ^ n := by
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq 𝔪.primeCompl x
  obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv_pow 𝔪 s.2 n
  refine ⟨a * y, ?_⟩
  set M := IsLocalization.mk' (Localization.AtPrime 𝔪) a s
  have hspec : M * algebraMap Λ (Localization.AtPrime 𝔪) s =
      algebraMap Λ (Localization.AtPrime 𝔪) a := IsLocalization.mk'_spec _ a s
  have hyi' : algebraMap Λ (Localization.AtPrime 𝔪) y * algebraMap Λ _ s +
      algebraMap Λ (Localization.AtPrime 𝔪) i = 1 := by
    rw [← map_mul, ← map_add, hyi, map_one]
  have h1 : M - algebraMap Λ (Localization.AtPrime 𝔪) (a * y) =
      M * algebraMap Λ (Localization.AtPrime 𝔪) i := by
    rw [map_mul]
    linear_combination (-M) * hyi' + algebraMap Λ (Localization.AtPrime 𝔪) y * hspec
  rw [h1]
  refine Ideal.mul_mem_left _ _ ?_
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪 (Localization.AtPrime 𝔪), ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ hi

/-- The evaluation `Λ_𝔪^∧ → Λ_𝔪 / 𝔪 ^ n` extends `Λ → Λ_𝔪 / 𝔪 ^ n`. -/
private theorem evalₐ_algebraMap_completion (n : ℕ) (l : Λ) :
    AdicCompletion.evalₐ (maximalIdeal (Localization.AtPrime 𝔪)) n
      (algebraMap Λ (Completion 𝔪) l) =
      Ideal.Quotient.mk _ (algebraMap Λ (Localization.AtPrime 𝔪) l) := by
  rw [IsScalarTower.algebraMap_apply Λ (Localization.AtPrime 𝔪) (Completion 𝔪),
    AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
    RingHom.id_apply]

/-! ### Maps from `Λ_𝔪^∧` to local rings with nilpotent maximal ideal -/

section Lift

variable {B : Type v} [CommRing B] [IsLocalRing B] [Algebra Λ B]
  (hB : (maximalIdeal B).comap (algebraMap Λ B) = 𝔪) (N : ℕ) (hN : maximalIdeal B ^ N = ⊥)

include hB in
/-- Elements outside `𝔪` become units in a local `Λ`-algebra whose maximal ideal lies over
`𝔪`. -/
theorem isUnit_algebraMap_of_comap_eq (y : 𝔪.primeCompl) : IsUnit (algebraMap Λ B y) := by
  rw [← IsLocalRing.notMem_maximalIdeal]
  exact fun hy => y.2 (hB ▸ hy)

/-- The localization `Λ_𝔪 → B` of `Λ → B`, for a local `Λ`-algebra `B` whose maximal ideal
lies over `𝔪`. -/
noncomputable def localizationLift : Localization.AtPrime 𝔪 →+* B :=
  IsLocalization.lift (M := 𝔪.primeCompl) (isUnit_algebraMap_of_comap_eq 𝔪 hB)

/-- `localizationLift` extends `Λ → B`. -/
theorem localizationLift_algebraMap (l : Λ) :
    localizationLift 𝔪 hB (algebraMap Λ (Localization.AtPrime 𝔪) l) = algebraMap Λ B l :=
  IsLocalization.lift_eq _ _

include hN in
/-- The localization `Λ_𝔪 → B` kills the `N`-th power of the maximal ideal. -/
theorem pow_le_ker_localizationLift :
    maximalIdeal (Localization.AtPrime 𝔪) ^ N ≤ RingHom.ker (localizationLift 𝔪 hB) := by
  rw [RingHom.ker_eq_comap_bot, ← Ideal.map_le_iff_le_comap,
    ← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪 (Localization.AtPrime 𝔪), ← Ideal.map_pow,
    Ideal.map_map]
  have hcomp : (localizationLift 𝔪 hB).comp (algebraMap Λ (Localization.AtPrime 𝔪)) =
      algebraMap Λ B := RingHom.ext (localizationLift_algebraMap 𝔪 hB)
  rw [hcomp, Ideal.map_pow, ← hN]
  exact Ideal.pow_right_mono (by rw [Ideal.map_le_iff_le_comap, hB]) N

/-- The ring map underlying `completionLift`. -/
noncomputable def completionLiftRingHom : Completion 𝔪 →+* B :=
  (Ideal.Quotient.lift (maximalIdeal (Localization.AtPrime 𝔪) ^ N)
      (localizationLift 𝔪 hB)
      (fun _ ha => (RingHom.mem_ker).mp (pow_le_ker_localizationLift 𝔪 hB N hN ha))).comp
    (AdicCompletion.evalₐ (maximalIdeal (Localization.AtPrime 𝔪)) N).toRingHom

/-- `completionLiftRingHom` extends `Λ → B`. -/
theorem completionLiftRingHom_algebraMap (l : Λ) :
    completionLiftRingHom 𝔪 hB N hN (algebraMap Λ (Completion 𝔪) l) = algebraMap Λ B l := by
  rw [completionLiftRingHom, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    evalₐ_algebraMap_completion, Ideal.Quotient.lift_mk, localizationLift_algebraMap]

/-- The `Λ`-algebra map `Λ_𝔪^∧ → B` into a local `Λ`-algebra whose maximal ideal lies over
`𝔪` and has vanishing `N`-th power: the evaluation `Λ_𝔪^∧ → Λ_𝔪 / 𝔪 ^ N` followed by the
localization of `Λ → B`. -/
noncomputable def completionLift : Completion 𝔪 →ₐ[Λ] B :=
  { completionLiftRingHom 𝔪 hB N hN with
    commutes' := completionLiftRingHom_algebraMap 𝔪 hB N hN }

end Lift

/-! ### The completion `Λ_𝔪^∧` -/

variable [IsNoetherianRing Λ]

/-- The maximal ideal of `Λ_𝔪^∧` is generated by `𝔪`. -/
theorem maximalIdeal_completion_eq_map :
    maximalIdeal (Completion 𝔪) = 𝔪.map (algebraMap Λ (Completion 𝔪)) := by
  rw [AdicCompletion.maximalIdeal_eq_map,
    IsScalarTower.algebraMap_eq Λ (Localization.AtPrime 𝔪) (Completion 𝔪), ← Ideal.map_map,
    IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪 (Localization.AtPrime 𝔪)]

/-- The maximal ideal of `Λ_𝔪^∧` lies over `𝔪`. -/
theorem comap_maximalIdeal_completion :
    (maximalIdeal (Completion 𝔪)).comap (algebraMap Λ (Completion 𝔪)) = 𝔪 := by
  rw [IsScalarTower.algebraMap_eq Λ (Localization.AtPrime 𝔪) (Completion 𝔪),
    ← Ideal.comap_comap, IsLocalRing.maximalIdeal_comap]
  exact IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime 𝔪) 𝔪

/-- An element of `Λ_𝔪^∧` whose evaluation in `Λ_𝔪 / 𝔪 ^ n` vanishes lies in the `n`-th
power of the maximal ideal. -/
theorem mem_pow_of_evalₐ_eq_zero {n : ℕ} {r : Completion 𝔪}
    (hr : AdicCompletion.evalₐ (maximalIdeal (Localization.AtPrime 𝔪)) n r = 0) :
    r ∈ maximalIdeal (Completion 𝔪) ^ n := by
  set I := maximalIdeal (Localization.AtPrime 𝔪)
  have hle : I ^ n ≤ I ^ n • (⊤ : Ideal (Localization.AtPrime 𝔪)) := by
    rw [smul_eq_mul, Ideal.mul_top]
  have heval : AdicCompletion.eval I (Localization.AtPrime 𝔪) n r = 0 := by
    rw [← AdicCompletion.factor_evalₐ_eq_eval I r hle, hr, map_zero]
  have hker : r ∈ (I ^ n • ⊤ : Submodule (Localization.AtPrime 𝔪) (Completion 𝔪)) := by
    rwa [AdicCompletion.pow_smul_top_eq_ker_eval I.fg_of_isNoetherianRing]
  rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem] at hker
  rwa [AdicCompletion.maximalIdeal_eq_map, ← Ideal.map_pow]

/-- `Λ → Λ_𝔪^∧ / 𝔪_R ^ n` is surjective for every `n`. -/
theorem exists_sub_mem_pow_completion (n : ℕ) (r : Completion 𝔪) :
    ∃ l : Λ, r - algebraMap Λ (Completion 𝔪) l ∈ maximalIdeal (Completion 𝔪) ^ n := by
  set I := maximalIdeal (Localization.AtPrime 𝔪)
  obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n r)
  obtain ⟨l, hl⟩ := exists_sub_mem_pow_localization 𝔪 n x
  refine ⟨l, mem_pow_of_evalₐ_eq_zero 𝔪 ?_⟩
  rwa [map_sub, ← hx, evalₐ_algebraMap_completion, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]

/-- The residue field of `Λ_𝔪^∧` is a quotient of `Λ`. -/
theorem residue_completion_surjective :
    Function.Surjective ((residue (Completion 𝔪)).comp (algebraMap Λ (Completion 𝔪))) := by
  intro y
  obtain ⟨r, rfl⟩ := residue_surjective y
  obtain ⟨l, hl⟩ := exists_sub_mem_pow_completion 𝔪 1 r
  refine ⟨l, ?_⟩
  rw [RingHom.comp_apply, eq_comm, ← sub_eq_zero, ← map_sub, residue_eq_zero_iff]
  rwa [pow_one] at hl

/-- Two `Λ`-algebra maps out of `Λ_𝔪^∧` that kill a common power of its maximal ideal
agree. -/
theorem algHom_ext_of_pow_le_ker {X : Type v} [CommRing X] [Algebra Λ X]
    (f g : Completion 𝔪 →ₐ[Λ] X) (n : ℕ)
    (hf : maximalIdeal (Completion 𝔪) ^ n ≤ RingHom.ker f)
    (hg : maximalIdeal (Completion 𝔪) ^ n ≤ RingHom.ker g) : f = g := by
  ext r
  obtain ⟨l, hl⟩ := exists_sub_mem_pow_completion 𝔪 n r
  have h1 : f (r - algebraMap Λ (Completion 𝔪) l) = 0 := hf hl
  have h2 : g (r - algebraMap Λ (Completion 𝔪) l) = 0 := hg hl
  rw [map_sub, AlgHom.commutes, sub_eq_zero] at h1 h2
  rw [h1, h2]

section LiftUnique

variable {B : Type v} [CommRing B] [IsLocalRing B] [Algebra Λ B]
  (hB : (maximalIdeal B).comap (algebraMap Λ B) = 𝔪) (N : ℕ) (hN : maximalIdeal B ^ N = ⊥)

include hB in
/-- A `Λ`-algebra map from `Λ_𝔪^∧` to a local `Λ`-algebra lying over `𝔪` maps the maximal
ideal into the maximal ideal. -/
theorem map_maximalIdeal_completion_le (f : Completion 𝔪 →ₐ[Λ] B) :
    (maximalIdeal (Completion 𝔪)).map f ≤ maximalIdeal B := by
  rw [maximalIdeal_completion_eq_map, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
  intro l hl
  rwa [Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes, ← Ideal.mem_comap, hB]

include hB hN in
/-- A `Λ`-algebra map from `Λ_𝔪^∧` to a local `Λ`-algebra lying over `𝔪` kills every power
of the maximal ideal that vanishes in the target. -/
theorem pow_le_ker_of_algHom (f : Completion 𝔪 →ₐ[Λ] B) :
    maximalIdeal (Completion 𝔪) ^ N ≤ RingHom.ker f := by
  rw [RingHom.ker_eq_comap_bot, ← Ideal.map_le_iff_le_comap, Ideal.map_pow, ← hN]
  exact Ideal.pow_right_mono (map_maximalIdeal_completion_le 𝔪 hB f) N

include hB hN in
/-- There is exactly one `Λ`-algebra map from `Λ_𝔪^∧` to a local `Λ`-algebra lying over `𝔪`
with nilpotent maximal ideal. -/
theorem algHom_completion_ext (f g : Completion 𝔪 →ₐ[Λ] B) : f = g :=
  algHom_ext_of_pow_le_ker 𝔪 f g N (pow_le_ker_of_algHom 𝔪 hB N hN f)
    (pow_le_ker_of_algHom 𝔪 hB N hN g)

end LiftUnique

end Completion

end Deformation.Artin.GRingNecessity

end
