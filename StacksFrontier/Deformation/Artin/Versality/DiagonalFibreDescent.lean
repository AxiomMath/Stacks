/-!
# Descent along first-order thickenings in the fibres of the diagonal

Let `𝒳` be a limit preserving category fibred in groupoids over the big fppf site of `S`, let `V`
be an object of that site and `y` an object of `𝒳 × 𝒳` over `V`. Let `ξ` be an object of
`𝒲 = (Sch/V)_{fppf} ×_{y, 𝒳 × 𝒳, Δ} 𝒳` over an affine scheme `T` over `V`, and let `U ⟶ T` be a
first-order thickening with `U` affine of finite type over an affine open `W = Spec Λ` of `V`.
Then `ξ` is the pullback of an object over `Spec R'` for a finite type `Λ`-subalgebra `R' ⊆ Γ(T)`
surjecting onto `Γ(U)`; in particular `U ⟶ Spec R'` is again a first-order thickening.

This is the descent step of the proofs of Stacks 0G2K and 0CXU, for `𝒲`. The ring `Γ(T)` is the
filtered colimit of its finitely generated subalgebras over the subalgebra generated by lifts of
generators of `Γ(U)`, so `T` is the limit of their spectra; an object of `𝒲` over `T` is a
vertical isomorphism `y₁|_T ⟶ y₂|_T`, which descends to a stage by limit preservation of `𝒳`
(`CategoryTheory.TwoFibreProductOver.DiagonalFibre.VertHom.exists_restrict_eq_of_descentHom`).

## Main results

* `Deformation.Artin.hasThickeningDescent_diagonalFibre`: the fibres of the diagonal of a limit
  preserving category have descent along first-order thickenings.

## References

* [Stacks Project, Tag 0G2K](https://stacks.math.columbia.edu/tag/0G2K)
* [Stacks Project, Tag 07XL](https://stacks.math.columbia.edu/tag/07XL)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open CategoryTheory.TwoFibreProductOver CategoryTheory.TwoFibreProductOver.DiagonalFibre

namespace Deformation.Artin

universe u

attribute [local implicit_reducible] _root_.CategoryTheory.TwoFibreProductOver.fst
  _root_.CategoryTheory.TwoFibreProductOver.snd
  _root_.CategoryTheory.TwoFibreProductOver.diagonal

/-- A finite type algebra `R₀` over `Λ`, a surjection `q : R → R₀` of `Λ`-algebras with
square-zero kernel and a finite subset of `R` mapping onto generators of `R₀`: every
`Λ`-subalgebra of `R` containing that subset surjects onto `R₀` with square-zero kernel. -/
theorem surjective_ker_sq_of_le_subalgebra {Λ R R₀ : Type u} [CommRing Λ] [CommRing R]
    [CommRing R₀] [Algebra Λ R] [Algebra Λ R₀] (q : R →ₐ[Λ] R₀)
    (hq : (RingHom.ker q.toRingHom) ^ 2 = ⊥) (s : Set R)
    (hs : Algebra.adjoin Λ (q '' s) = ⊤) (A : Subalgebra Λ R) (hA : s ⊆ A) :
    Function.Surjective (q.comp A.val) ∧ (RingHom.ker (q.comp A.val).toRingHom) ^ 2 = ⊥ := by
  constructor
  · intro r
    have hr : r ∈ A.map q :=
      Algebra.adjoin_le (Set.image_mono hA |>.trans (by
        rintro _ ⟨a, ha, rfl⟩
        exact ⟨a, ha, rfl⟩)) (hs ▸ Algebra.mem_top)
    obtain ⟨a, ha, rfl⟩ := hr
    exact ⟨⟨a, ha⟩, rfl⟩
  · rw [eq_bot_iff, sq]
    have hmap : (RingHom.ker (q.comp A.val).toRingHom).map A.val.toRingHom ≤
        RingHom.ker q.toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      simpa using ha
    intro z hz
    have hz' : A.val z ∈ (RingHom.ker q.toRingHom) * (RingHom.ker q.toRingHom) := by
      have h₁ : A.val z ∈ ((RingHom.ker (q.comp A.val).toRingHom) *
          (RingHom.ker (q.comp A.val).toRingHom)).map A.val.toRingHom :=
        Ideal.mem_map_of_mem _ hz
      rw [Ideal.map_mul] at h₁
      exact Ideal.mul_mono hmap hmap h₁
    rw [← sq, hq] at hz'
    rw [Ideal.mem_bot]
    exact Subtype.val_injective (by simpa using hz')

section Subalgebras

variable (Λ R : Type u) [CommRing Λ] [CommRing R] [Algebra Λ R] (A₀ : Subalgebra Λ R)

/-- The finitely generated `Λ`-subalgebras of `R` containing `A₀`, ordered by inclusion. -/
abbrev FGSubalgebraAbove : Type u := {A : Subalgebra Λ R // A.FG ∧ A₀ ≤ A}

variable {Λ R A₀} in
/-- The finitely generated subalgebras above a finitely generated one are directed. -/
instance [Fact A₀.FG] : IsDirectedOrder (FGSubalgebraAbove Λ R A₀) where
  directed A A' := ⟨⟨A.1 ⊔ A'.1, A.2.1.sup A'.2.1, A.2.2.trans le_sup_left⟩,
    le_sup_left (a := A.1), le_sup_right (a := A.1)⟩

variable {Λ R A₀} in
/-- The type of finitely generated subalgebras above a finitely generated `A₀` is nonempty: it
contains `A₀` itself. -/
instance [Fact A₀.FG] : Nonempty (FGSubalgebraAbove Λ R A₀) := ⟨⟨A₀, Fact.out, le_rfl⟩⟩

variable {Λ R A₀} in
/-- The finitely generated subalgebras above a finitely generated `A₀` form a filtered category. -/
instance [Fact A₀.FG] : IsFiltered (FGSubalgebraAbove Λ R A₀) :=
  isFiltered_of_directed_le_nonempty _

/-- The diagram of rings of the finitely generated subalgebras above `A₀`. -/
def fgSubalgebraAboveRingDiagram : FGSubalgebraAbove Λ R A₀ ⥤ CommRingCat.{u} where
  obj A := CommRingCat.of A.1
  map h := CommRingCat.ofHom (Subalgebra.inclusion (leOfHom h)).toRingHom

/-- The cocone of inclusions of the finitely generated subalgebras above `A₀` into `R`. -/
def fgSubalgebraAboveRingCocone : Cocone (fgSubalgebraAboveRingDiagram Λ R A₀) where
  pt := CommRingCat.of R
  ι := { app A := CommRingCat.ofHom A.1.val.toRingHom }

/-- **`R` is the filtered colimit of its finitely generated subalgebras above `A₀`.** -/
noncomputable def fgSubalgebraAboveRingCoconeIsColimit [Fact A₀.FG] :
    IsColimit (fgSubalgebraAboveRingCocone Λ R A₀) := by
  let := reflectsColimit_of_reflectsIsomorphisms (fgSubalgebraAboveRingDiagram Λ R A₀)
    (forget CommRingCat)
  apply isColimitOfReflects (forget CommRingCat)
  apply Types.FilteredColimit.isColimitOf'
  · intro (r : R)
    let A : FGSubalgebraAbove Λ R A₀ := ⟨A₀ ⊔ Algebra.adjoin Λ ((({r} : Finset R)) : Set R),
      (Fact.out : A₀.FG).sup (Subalgebra.fg_adjoin_finset ({r} : Finset R)), le_sup_left⟩
    exact ⟨A, ⟨r, le_sup_right (a := A₀) (Algebra.subset_adjoin (by simp))⟩, rfl⟩
  · intro A a b hab
    exact ⟨A, 𝟙 A, Subtype.val_injective hab⟩

end Subalgebras

/-- A first-order thickening of affine schemes has square-zero kernel on global sections. -/
theorem ker_appTop_sq_of_isFirstOrderThickening {X Y : Scheme.{u}} [IsAffine Y] (f : X ⟶ Y)
    (hf : Stacks.Thickenings.IsFirstOrderThickening f) : (RingHom.ker f.appTop.hom) ^ 2 = ⊥ := by
  have : IsClosedImmersion f := hf.1
  let U : Y.affineOpens := ⟨⊤, isAffineOpen_top Y⟩
  have h := congrArg (fun J : Scheme.IdealSheafData Y => J.ideal U) hf.2
  change (f.ker.ideal U) ^ 2 = ⊥ at h
  rwa [Scheme.Hom.ker_apply] at h

/-- An isomorphism followed by a first-order thickening is a first-order thickening. -/
theorem isFirstOrderThickening_iso_comp {X X' Y : Scheme.{u}} (e : X ⟶ X') [IsIso e]
    (f : X' ⟶ Y) (hf : Stacks.Thickenings.IsFirstOrderThickening f) :
    Stacks.Thickenings.IsFirstOrderThickening (e ≫ f) := by
  have := hf.1
  exact ⟨inferInstance, by
    rw [Scheme.Hom.ker_comp_of_isIso]
    exact hf.2⟩

variable (B : AlgebraicGeometry.BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)
  (𝒳 : CatFiberedInGroupoids.{u, u, u + 1, u + 1} (AlgebraicGeometry.BigFppfOver B S hS))
  (V : AlgebraicGeometry.BigFppfOver B S hS)
  (y : AlgebraicGeometry.BigFppfOver B V.left.1 V.left.2 ⥤
    (CatFiberedInGroupoids.product 𝒳 𝒳).val.obj)
  (hy : y ⋙ (CatFiberedInGroupoids.product 𝒳 𝒳).val.p = Over.map V.hom)

include hy in
/-- **Descent along first-order thickenings in the fibres of the diagonal.** If `𝒳` is limit
preserving, the 2-fibre product `(Sch/V)_{fppf} ×_{y, 𝒳 × 𝒳, Δ} 𝒳` has descent along
first-order thickenings, in the sense of `Deformation.Artin.HasThickeningDescent`. -/
theorem hasThickeningDescent_diagonalFibre
    (h3 : Deformation.Artin.IsLimitPreserving.{u, u, u, u + 1, u} B S hS 𝒳) :
    HasThickeningDescent B V.left.1 V.left.2
      (TwoFibreProductOver.fst (Over.map V.hom) 𝒳.val.p
        (CatFiberedInGroupoids.product 𝒳 𝒳).val.p y
        (AlgebraicGeometry.Stack.diagonalBasedFunctor B S hS 𝒳).toFunctor) := by
  classical
  intro ξ U i hUaff hUlft hthick ⟨W, hWaff, hUW⟩
  have hp : 𝒳.val.p.IsFiberedInGroupoids := 𝒳.isFiberedInGroupoids
  have : 𝒳.val.p.IsFibered := hp.isFibered
  let VV := AlgebraicGeometry.BigFppfOver.toScheme B V.left.1 V.left.2
  have hY₁ : Y₁' y ⋙ 𝒳.val.p = Over.map V.hom := h1' hy
  have hY₂ : Y₂' y ⋙ 𝒳.val.p = Over.map V.hom := h2' hy
  let T := (TwoFibreProductOver.fst (Over.map V.hom) 𝒳.val.p
    (CatFiberedInGroupoids.product 𝒳 𝒳).val.p y
    (AlgebraicGeometry.Stack.diagonalBasedFunctor B S hS 𝒳).toFunctor).obj ξ
  have : IsAffine (VV.obj U) := hUaff
  have : IsAffine (VV.obj T) :=
    Stacks.Thickenings.isAffine_of_isThickening hthick.isThickening
  have : IsAffine W := hWaff
  have : IsClosedImmersion (VV.map i) := hthick.1
  let fU : VV.obj U ⟶ V.left.1 := B.inclusion.map U.hom
  let fT : VV.obj T ⟶ V.left.1 := B.inclusion.map T.hom
  have hiT : VV.map i ≫ fT = fU := by
    have h := congrArg B.inclusion.map (Over.w i)
    rwa [B.inclusion.map_comp] at h
  have hTW : Set.range fT.base ⊆ Set.range W.ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨t, rfl⟩
    obtain ⟨u, rfl⟩ := hthick.isThickening.2 t
    rw [← Scheme.Hom.comp_apply, hiT]
    exact hUW ⟨u, rfl⟩
  let τ : VV.obj T ⟶ W := IsOpenImmersion.lift W.ι fT hTW
  have hτ : τ ≫ W.ι = fT := IsOpenImmersion.lift_fac _ _ _
  let Λ : CommRingCat.{u} := Γ(W, ⊤)
  let R : CommRingCat.{u} := Γ(VV.obj T, ⊤)
  let R₀ : CommRingCat.{u} := Γ(VV.obj U, ⊤)
  let : Algebra Λ R := τ.appTop.hom.toAlgebra
  let : Algebra Λ R₀ := (VV.map i ≫ τ).appTop.hom.toAlgebra
  let q : R →ₐ[Λ] R₀ :=
    { (VV.map i).appTop.hom with
      commutes' := fun l => by
        show (VV.map i).appTop.hom (τ.appTop.hom l) = (VV.map i ≫ τ).appTop.hom l
        rw [Scheme.Hom.comp_appTop]
        rfl }
  have hqsurj : Function.Surjective q :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine (VV.map i)).2
  have hqker : (RingHom.ker q.toRingHom) ^ 2 = ⊥ :=
    ker_appTop_sq_of_isFirstOrderThickening (VV.map i) hthick
  have hft : Algebra.FiniteType Λ R₀ := by
    have hl : LocallyOfFiniteType (VV.map i ≫ τ) := by
      have : LocallyOfFiniteType ((VV.map i ≫ τ) ≫ W.ι) := by
        rw [Category.assoc, hτ, hiT]
        exact hUlft
      exact locallyOfFiniteType_of_comp _ W.ι
    exact HasRingHomProperty.appTop @LocallyOfFiniteType (VV.map i ≫ τ) hl
  obtain ⟨s₀, hs₀⟩ := hft.out
  choose lift hlift using hqsurj
  let G : Finset R := s₀.image lift
  let A₀ : Subalgebra Λ R := Algebra.adjoin Λ (G : Set R)
  have : Fact A₀.FG := ⟨Subalgebra.fg_adjoin_finset G⟩
  have hG : Algebra.adjoin Λ (q '' (G : Set R)) = ⊤ := by
    simpa [G, Set.image_image, hlift] using hs₀
  let J := FGSubalgebraAbove Λ R A₀
  have hWc : B.Contains W :=
    lt_of_le_of_lt (Scheme.size_le_of_isOpenImmersion W.ι) V.left.2
  have hΛc : B.Contains (Spec Λ) :=
    lt_of_le_of_lt (Scheme.size_le_of_isOpenImmersion (W : Scheme.{u}).isoSpec.inv) hWc
  have hAc (A : J) : B.Contains (Spec (CommRingCat.of A.1)) := by
    have : Algebra.FiniteType Λ A.1 := (Subalgebra.fg_iff_finiteType A.1).mp A.2.1
    exact Scheme.size_Spec_lt_of_finiteType B.aleph0_lt_cutoff B.cutoff_isStrongPrelimit Λ A.1
      hΛc
  let toV : Spec Λ ⟶ V.left.1 := (W : Scheme.{u}).isoSpec.inv ≫ W.ι
  let stage (A : J) : AlgebraicGeometry.BigFppfOver B V.left.1 V.left.2 :=
    Over.mk (ObjectProperty.homMk (X := B.obj (hAc A)) (Y := B.obj V.left.2)
      (Spec.map (CommRingCat.ofHom (algebraMap Λ A.1)) ≫ toV))
  let stageMap {A A' : J} (h : A ≤ A') : stage A' ⟶ stage A :=
    Over.homMk (ObjectProperty.homMk
      (Spec.map (CommRingCat.ofHom (Subalgebra.inclusion h).toRingHom))) (by
        apply ObjectProperty.hom_ext
        show Spec.map _ ≫ Spec.map _ ≫ toV = Spec.map _ ≫ toV
        rw [← Category.assoc, ← Spec.map_comp]
        rfl)
  let D : Jᵒᵖ ⥤ AlgebraicGeometry.BigFppfOver B V.left.1 V.left.2 :=
    { obj := fun A => stage A.unop
      map := fun h => stageMap (leOfHom h.unop)
      map_id := fun A => by
        apply Over.OverMorphism.ext
        apply ObjectProperty.hom_ext
        show Spec.map _ = 𝟙 _
        rw [show CommRingCat.ofHom (Subalgebra.inclusion (le_refl A.unop.1)).toRingHom =
          𝟙 _ from rfl, Spec.map_id]
      map_comp := fun h h' => by
        apply Over.OverMorphism.ext
        apply ObjectProperty.hom_ext
        show Spec.map _ = Spec.map _ ≫ Spec.map _
        rw [← Spec.map_comp]
        rfl }
  have hRc : B.Contains (Spec R) :=
    lt_of_le_of_lt (Scheme.size_le_of_isOpenImmersion (VV.obj T).isoSpec.inv) T.left.2
  let T₁ : AlgebraicGeometry.BigFppfOver B V.left.1 V.left.2 :=
    Over.mk (ObjectProperty.homMk (X := B.obj hRc) (Y := B.obj V.left.2)
      (Spec.map τ.appTop ≫ toV))
  let c : Cone D :=
    { pt := T₁
      π :=
        { app := fun A => Over.homMk (ObjectProperty.homMk
            (Spec.map (CommRingCat.ofHom A.unop.1.val.toRingHom))) (by
              apply ObjectProperty.hom_ext
              show Spec.map _ ≫ Spec.map _ ≫ toV = Spec.map _ ≫ toV
              rw [← Category.assoc, ← Spec.map_comp]
              rfl)
          naturality := fun A A' h => by
            apply Over.OverMorphism.ext
            apply ObjectProperty.hom_ext
            show 𝟙 _ ≫ Spec.map _ = Spec.map _ ≫ Spec.map _
            rw [Category.id_comp, ← Spec.map_comp]
            rfl } }
  have hc : IsLimit (VV.mapCone c) := by
    convert isLimitOfPreserves Scheme.Spec (fgSubalgebraAboveRingCoconeIsColimit Λ R A₀).op
      using 1 <;> rfl
  have haff : ∀ A, IsAffineOver B S hS ((D ⋙ Over.map V.hom).obj A) := fun A =>
    (inferInstance : IsAffine (Spec (CommRingCat.of A.unop.1)))
  have hcaff' : IsAffineOver B S hS ((Over.map V.hom).obj c.pt) :=
    (inferInstance : IsAffine (Spec R))
  let D' : Jᵒᵖ ⥤ BigAffineFppf B S hS := (IsAffineOver B S hS).lift (D ⋙ Over.map V.hom) haff
  let c' : Cone D' :=
    { pt := ⟨(Over.map V.hom).obj c.pt, hcaff'⟩
      π :=
        { app := fun A => ObjectProperty.homMk ((Over.map V.hom).map (c.π.app A))
          naturality := fun A A' h => by
            apply ObjectProperty.hom_ext
            show 𝟙 _ ≫ (Over.map V.hom).map (c.π.app A') =
              (Over.map V.hom).map (c.π.app A) ≫ (Over.map V.hom).map (D.map h)
            rw [Category.id_comp, ← Functor.map_comp, c.w h] } }
  have hc' : IsLimit ((BigAffineFppf.toScheme B S hS).mapCone c') := hc
  have : (colimitComparison 𝒳.val.p (D' ⋙ BigAffineFppf.inclusion B S hS)
      ((BigAffineFppf.inclusion B S hS).mapCone c')).Full := (h3 Jᵒᵖ D' c' hc').full
  have hdesc : DescentHom 𝒳.val.p (D ⋙ Over.map V.hom) ((Over.map V.hom).mapCone c) :=
    descentHom_of_full 𝒳.val.p hp (D' ⋙ BigAffineFppf.inclusion B S hS)
      ((BigAffineFppf.inclusion B S hS).mapCone c')
  have hTT₁ : (VV.obj T).isoSpec.inv ≫ fT = Spec.map τ.appTop ≫ toV := by
    rw [← hτ, ← Category.assoc, ← Scheme.isoSpec_inv_naturality]
    simp only [toV, Category.assoc]
  let isoT : T₁ ⟶ T := Over.homMk (ObjectProperty.homMk (VV.obj T).isoSpec.inv) (by
    apply ObjectProperty.hom_ext
    exact hTT₁)
  let isoT' : T ⟶ T₁ := Over.homMk (ObjectProperty.homMk (VV.obj T).isoSpec.hom) (by
    apply ObjectProperty.hom_ext
    show (VV.obj T).isoSpec.hom ≫ Spec.map τ.appTop ≫ toV = fT
    rw [← hTT₁, Iso.hom_inv_id_assoc])
  have hiso : isoT' ≫ isoT = 𝟙 T := by
    apply Over.OverMorphism.ext
    apply ObjectProperty.hom_ext
    exact (VV.obj T).isoSpec.hom_inv_id
  let σξ : VertHom 𝒳.val.p (Over.map V.hom) (Y₁' y) (Y₂' y) T := ⟨sectOf ξ, isHomLift_sectOf hy ξ⟩
  obtain ⟨k, χ, hχ⟩ := VertHom.exists_restrict_eq_of_descentHom hp hY₁ hY₂ D c hdesc
    (VertHom.restrict hp hY₁ hY₂ isoT σξ)
  let ξ' := objOf hy (D.obj k) χ hp
  have hres : VertHom.restrict hp hY₁ hY₂ (isoT' ≫ c.π.app k) χ = σξ := by
    rw [VertHom.restrict_comp, hχ, ← VertHom.restrict_comp, hiso, VertHom.restrict_id]
  obtain ⟨e, he⟩ := exists_hom_of_sectOf hp hy (A := ξ) (B := ξ') (isoT' ≫ c.π.app k) (by
    have h := VertHom.restrict_fac hp hY₁ hY₂ (isoT' ≫ c.π.app k) χ
    rw [hres] at h
    exact h.trans (congrArg _ (sectOf_objOf hy (D.obj k) χ hp).symm))
  have : Algebra.FiniteType Λ k.unop.1 := (Subalgebra.fg_iff_finiteType k.unop.1).mp k.unop.2.1
  refine ⟨ξ', e, ?_, ?_, ?_⟩
  · exact (inferInstance : IsAffine (Spec (CommRingCat.of k.unop.1)))
  · show LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap Λ k.unop.1)) ≫ toV)
    have : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap Λ k.unop.1))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)
    have : LocallyOfFiniteType toV := by
      simp only [toV]
      infer_instance
    infer_instance
  · have hea : VV.map e.a = (VV.obj T).isoSpec.hom ≫
        Spec.map (CommRingCat.ofHom k.unop.1.val.toRingHom) := by
      rw [he]
      rfl
    have hsq := surjective_ker_sq_of_le_subalgebra q hqker (G : Set R) hG k.unop.1
      ((Algebra.subset_adjoin).trans k.unop.2.2)
    have key : VV.map i ≫ (VV.obj T).isoSpec.hom ≫
        Spec.map (CommRingCat.ofHom k.unop.1.val.toRingHom) = (VV.obj U).isoSpec.hom ≫
        Spec.map (CommRingCat.ofHom k.unop.1.val.toRingHom ≫ (VV.map i).appTop) := by
      rw [Spec.map_comp]
      exact (Scheme.isoSpec_hom_naturality_assoc (VV.map i) _).symm
    show Stacks.Thickenings.IsFirstOrderThickening (VV.map i ≫ VV.map e.a)
    rw [hea]
    have h := isFirstOrderThickening_iso_comp (VV.obj U).isoSpec.hom _
      (Stacks.Smooth.isFirstOrderThickening_specMap
        (CommRingCat.ofHom k.unop.1.val.toRingHom ≫ (VV.map i).appTop) hsq.1 hsq.2)
    rwa [← key] at h

end Deformation.Artin

end
