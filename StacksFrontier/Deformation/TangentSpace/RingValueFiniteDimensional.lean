module

public import Mathlib.LinearAlgebra.TensorProduct.Prod
public import Mathlib.RingTheory.TensorProduct.Basic
public import StacksFrontier.Algebra.Module.OppositeOfCommSemiring
public import StacksFrontier.Deformation.TangentSpace.FiniteDimensional

/-!
# Finite-dimensional tangent spaces from ring-valued charts

Let `𝓕` be a predeformation category over `𝒞_Λ` whose functor of isomorphism classes satisfies
(S2), so that its tangent space `T𝓕 = 𝓕(k[ε])` carries the vector-space structure of Stacks 06IH.
Suppose that, for a finite extension `l/k` and a Noetherian `Λ`-algebra `R` with a map
`φ₀ : R → l`, every object `x` of `𝓕` over a square-zero extension `k[V] = k ⊕ V` gives a
`Λ`-algebra map `R → k[V] ⊗_k l` reducing to `φ₀`, compatibly with the maps `k[V] → k[V']`, and
that over `k[ε]` two objects with the same map are isomorphic. Then `T𝓕` is finite dimensional
over `k`, provided `Λ` is Noetherian and `l` is a finite `Λ`-module.

This is how the tangent spaces of a set-valued functor are bounded by an étale chart of a
formal algebraic space: after the field extension `l/k` a deformation lifts to the chart, whose
points with values in a local Artinian ring are ring maps out of a Noetherian ring.

The argument is that of the scheme case of Stacks 07X1. Two maps `φ, ψ : R → k[V] ⊗_k l` with the
same reduction differ by a derivation `R → V ⊗_k l`, which vanishes on `Λ` and is determined by
its values on generators of the ideal `𝔪 = ker φ₀` together with elements of `R` whose images
span `φ₀(R)` over `Λ`. Reading the `V ⊗_k l`-components on these finitely many elements gives a
family of maps `𝓕(k[V]) → (V ⊗_k l)^n`, natural in `V`, and injective for `V = k`, and the
finiteness criterion `Deformation.finiteDimensional_artinianTangentSpace_of_natural_injection`
applies.

## Main results

* `RingHom.eq_of_sub_mem_of_mul_eq_zero`: two ring maps congruent modulo a square-zero subset are
  equal once they agree on a base ring, on generators of an ideal mapping into that subset, and on
  elements spanning modulo the ideal.
* `Deformation.finiteDimensional_artinianTangentSpace_of_ringValue`: the criterion above.

## References

* [Stacks Project, Tag 06IH](https://stacks.math.columbia.edu/tag/06IH)
* [Stacks Project, Tag 07X1](https://stacks.math.columbia.edu/tag/07X1)
-/

@[expose] public section

open CategoryTheory TensorProduct

universe u v₁ u₁

/-! ### A derivation vanishing on generators -/

/-- Two ring maps `φ, ψ : R → C` whose differences lie in a subset `I` of `C` with `I · I = 0` are
equal as soon as they agree on the image of a ring map `c : R₀ → R`, on a set `g` generating an
ideal `𝔪` which `ψ` maps into `I`, and on a set `b` whose `R₀`-span maps onto `R / 𝔪`. The
difference `φ - ψ` is then a derivation vanishing on all three. -/
theorem RingHom.eq_of_sub_mem_of_mul_eq_zero {R₀ R C : Type*} [CommRing R₀] [CommRing R]
    [Ring C] [Algebra R₀ R] (φ ψ : R →+* C) (I : Set C)
    (hI : ∀ a ∈ I, ∀ b ∈ I, a * b = 0) (hsub : ∀ x, φ x - ψ x ∈ I)
    (hc : ∀ r : R₀, φ (algebraMap R₀ R r) = ψ (algebraMap R₀ R r))
    (g : Set R) (hgψ : ∀ x ∈ Ideal.span g, ψ x ∈ I) (hg : ∀ x ∈ g, φ x = ψ x)
    (b : Set R) (hb : ∀ a : R, ∃ s ∈ Submodule.span R₀ b, a - s ∈ Ideal.span g)
    (hbv : ∀ x ∈ b, φ x = ψ x) : φ = ψ := by
  -- the derivation rule for the difference
  have hmul : ∀ x y, φ (x * y) - ψ (x * y) = φ x * (φ y - ψ y) + (φ x - ψ x) * ψ y := by
    intro x y; rw [map_mul, map_mul]; noncomm_ring
  -- vanishing on the `R₀`-span of `b`
  have hspan : ∀ s ∈ Submodule.span R₀ b, φ s = ψ s := by
    intro s hs
    induction hs using Submodule.span_induction with
    | mem x hx => exact hbv x hx
    | zero => simp
    | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
    | smul r x _ hx =>
      rw [Algebra.smul_def, map_mul, map_mul, hc r, hx]
  -- vanishing on the ideal generated by `g`
  have hideal : ∀ m ∈ Ideal.span g, φ m = ψ m := by
    intro m hm
    induction hm using Submodule.span_induction with
    | mem x hx => exact hg x hx
    | zero => simp
    | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
    | smul r x hxm hx =>
      rw [smul_eq_mul, ← sub_eq_zero, hmul, hx, sub_self, mul_zero, zero_add]
      exact hI _ (hsub r) _ (hgψ x hxm)
  ext a
  obtain ⟨s, hs, hm⟩ := hb a
  have := hideal _ hm
  rw [map_sub, map_sub, hspan s hs] at this
  exact sub_left_injective this

namespace Deformation

variable {Λ k : Type u} [CommRing Λ] [Field k] [Algebra Λ k]

-- The bimodule structure on a vector space under which `TrivSqZeroExt k V` is formed in
-- `Deformation.squareZeroExtensionArtinian`.
local instance (V : FGModuleCat.{u} k) : Module kᵐᵒᵖ V :=
  Module.oppositeOfCommSemiring k V

local instance (V : FGModuleCat.{u} k) : IsCentralScalar k V :=
  Module.isCentralScalar_oppositeOfCommSemiring k V

section TensorComponents

variable (l : Type u) [Field l] [Algebra k l] (V : FGModuleCat.{u} k)

/-- The `k ⊗_k l`-component of an element of `k[V] ⊗_k l`. -/
noncomputable abbrev tensorFst : TrivSqZeroExt k V ⊗[k] l →ₗ[k] k ⊗[k] l :=
  (TrivSqZeroExt.fstHom k k V).toLinearMap.rTensor l

/-- The `V ⊗_k l`-component of an element of `k[V] ⊗_k l`. -/
noncomputable abbrev tensorSnd : TrivSqZeroExt k V ⊗[k] l →ₗ[k] V ⊗[k] l :=
  (TrivSqZeroExt.sndHom k V).rTensor l

/-- The inclusion `V ⊗_k l ⟶ k[V] ⊗_k l`. -/
noncomputable abbrev tensorInr : V ⊗[k] l →ₗ[k] TrivSqZeroExt k V ⊗[k] l :=
  (TrivSqZeroExt.inrHom k V).rTensor l

/-- The inclusion `k ⊗_k l ⟶ k[V] ⊗_k l`. -/
noncomputable abbrev tensorInl : k ⊗[k] l →ₗ[k] TrivSqZeroExt k V ⊗[k] l :=
  (Algebra.linearMap k (TrivSqZeroExt k V)).rTensor l

theorem tensorInl_fst_add_tensorInr_snd (w : TrivSqZeroExt k V ⊗[k] l) :
    tensorInl l V (tensorFst l V w) + tensorInr l V (tensorSnd l V w) = w := by
  have h : Algebra.linearMap k (TrivSqZeroExt k V) ∘ₗ
      (TrivSqZeroExt.fstHom k k V).toLinearMap +
      TrivSqZeroExt.inrHom k V ∘ₗ TrivSqZeroExt.sndHom k V = LinearMap.id := by
    apply LinearMap.ext; intro x
    ext <;> simp [TrivSqZeroExt.algebraMap_eq_inl]
  have h' := congrArg (fun f => LinearMap.rTensor l f w) h
  simpa only [LinearMap.rTensor_add, LinearMap.rTensor_comp, LinearMap.add_apply,
    LinearMap.comp_apply, LinearMap.rTensor_id, LinearMap.id_apply] using h'

/-- An element of `k[V] ⊗_k l` is determined by its two components. -/
theorem tensor_ext {w w' : TrivSqZeroExt k V ⊗[k] l}
    (h₁ : tensorFst l V w = tensorFst l V w') (h₂ : tensorSnd l V w = tensorSnd l V w') :
    w = w' := by
  rw [← tensorInl_fst_add_tensorInr_snd l V w, ← tensorInl_fst_add_tensorInr_snd l V w', h₁, h₂]

/-- An element of `k[V] ⊗_k l` with vanishing `k ⊗_k l`-component lies in `V ⊗_k l`. -/
theorem mem_range_tensorInr {w : TrivSqZeroExt k V ⊗[k] l} (h : tensorFst l V w = 0) :
    w ∈ Set.range (tensorInr l V) :=
  ⟨tensorSnd l V w, by simpa [h] using tensorInl_fst_add_tensorInr_snd l V w⟩

/-- The square-zero ideal `V ⊗_k l` of `k[V] ⊗_k l` has vanishing products. -/
theorem tensorInr_mul_tensorInr (a b : V ⊗[k] l) : tensorInr l V a * tensorInr l V b = 0 := by
  induction a using TensorProduct.induction_on with
  | zero => simp
  | add a a' ha ha' => rw [map_add, add_mul, ha, ha', add_zero]
  | tmul v x =>
    induction b using TensorProduct.induction_on with
    | zero => simp
    | add b b' hb hb' => rw [map_add, mul_add, hb, hb', add_zero]
    | tmul w y =>
      simp only [LinearMap.rTensor_tmul, Algebra.TensorProduct.tmul_mul_tmul,
        TrivSqZeroExt.inrHom_apply, TrivSqZeroExt.inr_mul_inr, TensorProduct.zero_tmul]

end TensorComponents

/-! ### The receptacle `V ↦ (V ⊗_k l)^ι` -/

variable (k) in
/-- The functor `V ↦ (V ⊗_k l)^ι` from finite-dimensional `k`-vector spaces to `k`-modules. -/
noncomputable def tensorPowFunctor (l : Type u) [Field l] [Algebra k l] (ι : Type u) :
    FGModuleCat.{u} k ⥤ ModuleCat.{u} k where
  obj V := ModuleCat.of k (ι → V ⊗[k] l)
  map f := ModuleCat.ofHom (LinearMap.compLeft (f.hom.hom.rTensor l) ι)
  map_id V := by
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro x; funext i
    simp only [ModuleCat.hom_ofHom, LinearMap.compLeft_apply, Function.comp_apply]
    change (LinearMap.id : V →ₗ[k] V).rTensor l (x i) = x i
    rw [LinearMap.rTensor_id, LinearMap.id_apply]
  map_comp f g := by
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro x; funext i
    simp only [ModuleCat.hom_ofHom, ModuleCat.hom_comp, LinearMap.compLeft_apply,
      Function.comp_apply, LinearMap.comp_apply]
    change (g.hom.hom ∘ₗ f.hom.hom).rTensor l (x i) = _
    rw [LinearMap.rTensor_comp, LinearMap.comp_apply]

instance (l : Type u) [Field l] [Algebra k l] (ι : Type u) :
    (tensorPowFunctor k l ι).Additive where
  map_add {V V'} {f g} := by
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro x; funext i
    change (f.hom.hom + g.hom.hom).rTensor l (x i) = _
    rw [LinearMap.rTensor_add]
    rfl

instance (l : Type u) [Field l] [Algebra k l] (ι : Type u) :
    (tensorPowFunctor k l ι).Linear k where
  map_smul {V V'} f r := by
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro x; funext i
    change (r • f.hom.hom).rTensor l (x i) = _
    rw [LinearMap.rTensor_smul]
    rfl

instance (l : Type u) [Field l] [Algebra k l] [Module.Finite k l] (ι : Type u) [Finite ι] :
    FiniteDimensional k ((tensorPowFunctor k l ι).obj (FGModuleCat.of k k)) :=
  inferInstanceAs (FiniteDimensional k (ι → k ⊗[k] l))

/-! ### The criterion -/

section Criterion

variable (𝓕 : BasedCategory.{v₁, u₁} (ArtinianLocalAlgCat.{u, u, u} Λ k))
  (h𝓕 : IsPredeformationCategory 𝓕.p)
  (l : Type u) [Field l] [Algebra k l]
  (R : Type u) [CommRing R] [Algebra Λ R] (φ₀ : R →+* l)
  (value : ∀ V : FGModuleCat.{u} k,
    𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj V) →
      (R →+* TrivSqZeroExt k V ⊗[k] l))

/-- The hypothesis that a family of ring-valued charts is compatible with the morphisms of `𝓕`
over the maps `k[V] → k[V']`. -/
def RingValueNatural : Prop :=
  ∀ {V V' : FGModuleCat.{u} k} (f : V ⟶ V')
    (x : 𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj V))
    (y : 𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj V')) (a : x.1 ⟶ y.1),
    𝓕.p.IsHomLift ((artinianSquareZeroExtensionFunctor Λ k).map f) a →
      value V' y = (Algebra.TensorProduct.map (TrivSqZeroExt.map f.hom.hom)
        (AlgHom.id k l)).toRingHom.comp (value V x)

variable {𝓕 l R value}

omit [Algebra Λ R] in
theorem value_eq_of_classOf_eq (hnat : RingValueNatural 𝓕 l R value) {V : FGModuleCat.{u} k}
    (x y : 𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj V))
    (h : classOf 𝓕 h𝓕.cofibered x = classOf 𝓕 h𝓕.cofibered y) : value V x = value V y := by
  have hq : Quotient.mk (isIsomorphicSetoid _) x = Quotient.mk (isIsomorphicSetoid _) y := by
    rw [← classOf_eq, ← classOf_eq, h]
  obtain ⟨e⟩ := Quotient.exact hq
  have h1 : 𝓕.p.IsHomLift (𝟙 ((artinianSquareZeroExtensionFunctor Λ k).obj V)) e.hom.1 := e.hom.2
  have h2 : 𝓕.p.IsHomLift ((artinianSquareZeroExtensionFunctor Λ k).map (𝟙 V)) e.hom.1 := by
    rw [CategoryTheory.Functor.map_id]; exact h1
  rw [hnat (𝟙 V) x y e.hom.1 h2]
  ext r
  change value V x r = (Algebra.TensorProduct.map
    (TrivSqZeroExt.map (LinearMap.id : V →ₗ[k] V)) (AlgHom.id k l)) (value V x r)
  rw [TrivSqZeroExt.map_id, Algebra.TensorProduct.map_id, AlgHom.id_apply]

/-- The chart value of an isomorphism class of a fibre, through a chosen representative. -/
noncomputable def classRingValue {V : FGModuleCat.{u} k}
    (z : (isomorphismClasses 𝓕 h𝓕.cofibered).obj
      ((artinianSquareZeroExtensionFunctor Λ k).obj V)) : R →+* TrivSqZeroExt k V ⊗[k] l :=
  value V (classOf_surjective 𝓕 h𝓕.cofibered _ z).choose

omit [Algebra Λ R] in
theorem classRingValue_classOf (hnat : RingValueNatural 𝓕 l R value) {V : FGModuleCat.{u} k}
    (x : 𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj V)) :
    classRingValue h𝓕 (value := value) (classOf 𝓕 h𝓕.cofibered x) = value V x :=
  value_eq_of_classOf_eq h𝓕 hnat _ _ (classOf_surjective 𝓕 h𝓕.cofibered _ _).choose_spec

variable (value) in
/-- The family of maps `𝓕(k[V]) → (V ⊗_k l)^ι` reading the `V ⊗_k l`-components of the chart
value on a family of elements of `R`. -/
noncomputable def ringValueTangentMap {ι : Type u} (e : ι → R) (V : FGModuleCat.{u} k)
    (z : (associatedTangentSpaceSetFunctor 𝓕 h𝓕.cofibered).obj V) :
    (tensorPowFunctor k l ι).obj V :=
  fun i => tensorSnd l V (classRingValue h𝓕 (value := value) z (e i))

omit [Algebra Λ R] in
theorem ringValueTangentMap_naturality (hnat : RingValueNatural 𝓕 l R value) {ι : Type u}
    (e : ι → R) {V V' : FGModuleCat.{u} k} (f : V ⟶ V')
    (z : (associatedTangentSpaceSetFunctor 𝓕 h𝓕.cofibered).obj V) :
    ringValueTangentMap h𝓕 value e V'
        ((associatedTangentSpaceSetFunctor 𝓕 h𝓕.cofibered).map f z) =
      ((tensorPowFunctor k l ι).map f) (ringValueTangentMap h𝓕 value e V z) := by
  let F := artinianSquareZeroExtensionFunctor Λ k
  obtain ⟨x, rfl⟩ := classOf_surjective 𝓕 h𝓕.cofibered _ z
  obtain ⟨y, a, ha⟩ := h𝓕.cofibered.exists_lift (F.map f).op (Opposite.op x.1)
    (congrArg Opposite.op x.2)
  have ha' : 𝓕.p.IsHomLift (F.map f) a.unop := by
    exact IsHomLift.of_fac 𝓕.p (F.map f) a.unop x.2
      (congrArg Opposite.unop (IsHomLift.domain_eq 𝓕.p.op (F.map f).op a))
      (by simpa using congrArg Quiver.Hom.unop (IsHomLift.fac 𝓕.p.op (F.map f).op a))
  let y' : 𝓕.p.Fiber (F.obj V') := ⟨y.unop, IsHomLift.codomain_eq 𝓕.p (F.map f) a.unop⟩
  change ringValueTangentMap h𝓕 value e V'
    ((isomorphismClasses 𝓕 h𝓕.cofibered).map (F.map f) (classOf 𝓕 h𝓕.cofibered x)) = _
  rw [map_classOf 𝓕 h𝓕.cofibered (F.map f) x y' a.unop]
  funext i
  change tensorSnd l V' (classRingValue h𝓕 (value := value) (classOf 𝓕 h𝓕.cofibered y') (e i)) =
    f.hom.hom.rTensor l
      (tensorSnd l V (classRingValue h𝓕 (value := value) (classOf 𝓕 h𝓕.cofibered x) (e i)))
  rw [classRingValue_classOf h𝓕 hnat, classRingValue_classOf h𝓕 hnat,
    hnat f x y' a.unop ha']
  change ((TrivSqZeroExt.sndHom k V').rTensor l ∘ₗ
    (TrivSqZeroExt.map f.hom.hom).toLinearMap.rTensor l) (value V x (e i)) =
      (f.hom.hom.rTensor l ∘ₗ (TrivSqZeroExt.sndHom k V).rTensor l) (value V x (e i))
  rw [← LinearMap.rTensor_comp, ← LinearMap.rTensor_comp]
  congr 2
  ext w
  simp

/-- Two chart values over the same `k[V]` agree once they agree on a set `g` generating `ker φ₀`
and on a set `b` spanning `R` modulo `ker φ₀` over `Λ`. -/
theorem value_eq_of_eqOn
    (halg : ∀ V x (r : Λ), value V x (algebraMap Λ R r) =
      algebraMap k (TrivSqZeroExt k V ⊗[k] l) (algebraMap Λ k r))
    (hfst : ∀ V x (r : R), tensorFst l V (value V x r) = 1 ⊗ₜ φ₀ r)
    (g : Set R) (hg : Ideal.span g = RingHom.ker φ₀) (b : Set R)
    (hb : ∀ a : R, ∃ t ∈ Submodule.span Λ b, a - t ∈ Ideal.span g)
    {V : FGModuleCat.{u} k} (x x' : 𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj V))
    (hgv : ∀ r ∈ g, tensorSnd l V (value V x r) = tensorSnd l V (value V x' r))
    (hbv : ∀ r ∈ b, tensorSnd l V (value V x r) = tensorSnd l V (value V x' r)) :
    value V x = value V x' := by
  refine RingHom.eq_of_sub_mem_of_mul_eq_zero (R₀ := Λ) (value V x) (value V x')
    (Set.range (tensorInr l V)) ?_ ?_ ?_ g ?_ ?_ b hb ?_
  · rintro _ ⟨a, rfl⟩ _ ⟨a', rfl⟩
    exact tensorInr_mul_tensorInr l V a a'
  · intro r
    apply mem_range_tensorInr
    rw [map_sub, hfst, hfst, sub_self]
  · intro r
    rw [halg, halg]
  · intro r hr
    apply mem_range_tensorInr
    have h0 : φ₀ r = 0 := RingHom.mem_ker.mp (hg ▸ hr)
    rw [hfst, h0, TensorProduct.tmul_zero]
  · exact fun r hr => tensor_ext l V ((hfst V x r).trans (hfst V x' r).symm) (hgv r hr)
  · exact fun r hr => tensor_ext l V ((hfst V x r).trans (hfst V x' r).symm) (hbv r hr)

/-- **Finite-dimensional tangent spaces from ring-valued charts.** Let `𝓕` be a predeformation
category over `𝒞_Λ` satisfying (S2), with `Λ` Noetherian, and let `l/k` be a finite extension with
`l` finite over `Λ`. Suppose given a Noetherian `Λ`-algebra `R`, a ring map `φ₀ : R → l`
compatible with `Λ`, and for every object `x` of `𝓕` over `k[V]` a ring map `R → k[V] ⊗_k l`,
compatible with `Λ`, reducing to `φ₀`, natural in `V` along the morphisms of `𝓕`, and such that
two objects over `k[ε]` with the same map are isomorphic. Then the tangent space of `𝓕` is finite
dimensional for its vector-space structure of Stacks 06IH. -/
theorem finiteDimensional_artinianTangentSpace_of_ringValue [IsNoetherianRing Λ]
    [IsNoetherianRing R] [Algebra Λ l] [IsScalarTower Λ k l] [Module.Finite Λ l]
    [Module.Finite k l]
    (hS2 : SchlessingerConditionS2
      (CategoryOfElements.π (isomorphismClasses 𝓕 h𝓕.cofibered)))
    (hφ₀ : ∀ r : Λ, φ₀ (algebraMap Λ R r) = algebraMap Λ l r)
    (hnat : RingValueNatural 𝓕 l R value)
    (halg : ∀ V x (r : Λ), value V x (algebraMap Λ R r) =
      algebraMap k (TrivSqZeroExt k V ⊗[k] l) (algebraMap Λ k r))
    (hfst : ∀ V x (r : R), tensorFst l V (value V x r) = 1 ⊗ₜ φ₀ r)
    (hinj : ∀ x y : 𝓕.p.Fiber ((artinianSquareZeroExtensionFunctor Λ k).obj
        (FGModuleCat.of k k)), value _ x = value _ y →
      classOf 𝓕 h𝓕.cofibered x = classOf 𝓕 h𝓕.cofibered y) :
    letI : Fact (IsPredeformationCategory 𝓕.p) := ⟨h𝓕⟩
    letI : Fact (SchlessingerConditionS2
      (CategoryOfElements.π (isomorphismClasses 𝓕 h𝓕.cofibered))) := ⟨hS2⟩
    FiniteDimensional k (artinianTangentSpace Λ k (isomorphismClasses 𝓕 h𝓕.cofibered)) := by
  classical
  -- generators of the kernel of `φ₀`
  obtain ⟨g, hg'⟩ := (IsNoetherian.noetherian (RingHom.ker φ₀) : (RingHom.ker φ₀).FG)
  have hg : Ideal.span (g : Set R) = RingHom.ker φ₀ := hg'
  -- elements of `R` whose images span `φ₀(R)` over `Λ`
  let φ₀' : R →ₗ[Λ] l :=
    { toFun := φ₀
      map_add' := map_add φ₀
      map_smul' := fun r x => by
        rw [Algebra.smul_def, map_mul, hφ₀, RingHom.id_apply, Algebra.smul_def] }
  have : IsNoetherian Λ l := isNoetherian_of_isNoetherianRing_of_finite Λ l
  obtain ⟨s', hs', hspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (R := Λ)
    (Set.range φ₀)).1 (IsNoetherian.noetherian (R := Λ) _)
  let b : s' → R := fun y => (hs' y.2).choose
  have hbφ : ∀ y, φ₀ (b y) = y := fun y => (hs' y.2).choose_spec
  have hb : ∀ a : R, ∃ t ∈ Submodule.span Λ (Set.range b), a - t ∈ Ideal.span (g : Set R) := by
    intro a
    have ha : φ₀ a ∈ Submodule.span Λ (s' : Set l) := hspan ▸ Submodule.subset_span ⟨a, rfl⟩
    have himg : (s' : Set l) = φ₀' '' Set.range b := by
      ext y
      refine ⟨fun hy => ⟨b ⟨y, hy⟩, ⟨⟨y, hy⟩, rfl⟩, hbφ ⟨y, hy⟩⟩, ?_⟩
      rintro ⟨_, ⟨z, rfl⟩, rfl⟩
      change φ₀ (b z) ∈ (s' : Set l)
      rw [hbφ z]; exact z.2
    rw [himg, Submodule.span_image] at ha
    obtain ⟨t, ht, hta⟩ := ha
    refine ⟨t, ht, ?_⟩
    rw [hg, RingHom.mem_ker, map_sub]
    change φ₀ a - φ₀' t = 0
    rw [hta, sub_self]
  -- the receptacle and the tangent map
  let ι := s' ⊕ (g : Set R)
  let e : ι → R := Sum.elim b Subtype.val
  refine finiteDimensional_artinianTangentSpace_of_natural_injection 𝓕 h𝓕 hS2
    (tensorPowFunctor k l ι) (ringValueTangentMap h𝓕 value e)
    (fun f z => ringValueTangentMap_naturality h𝓕 hnat e f z) ?_
  intro z z' hzz
  let V₀ := FGModuleCat.of k k
  obtain ⟨x, rfl⟩ := classOf_surjective 𝓕 h𝓕.cofibered _ z
  obtain ⟨x', rfl⟩ := classOf_surjective 𝓕 h𝓕.cofibered _ z'
  apply hinj
  have hcomp : ∀ i, tensorSnd l V₀ (value V₀ x (e i)) = tensorSnd l V₀ (value V₀ x' (e i)) := by
    intro i
    have := congrFun hzz i
    change tensorSnd l V₀ (classRingValue h𝓕 (value := value) (classOf 𝓕 h𝓕.cofibered x) (e i)) =
      tensorSnd l V₀ (classRingValue h𝓕 (value := value) (classOf 𝓕 h𝓕.cofibered x') (e i)) at this
    rwa [classRingValue_classOf h𝓕 hnat, classRingValue_classOf h𝓕 hnat] at this
  exact value_eq_of_eqOn φ₀ halg hfst (g : Set R) hg (Set.range b) hb x x'
    (fun r hr => hcomp (Sum.inr ⟨r, hr⟩)) (by rintro _ ⟨y, rfl⟩; exact hcomp (Sum.inl y))

end Criterion

