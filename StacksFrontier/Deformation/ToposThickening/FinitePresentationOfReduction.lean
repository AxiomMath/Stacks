open CategoryTheory CategoryTheory.Limits Opposite

universe v u w

namespace Deformation.ToposThickening.ReductionPresentation

section Locally

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- A property of the arrows into `U` holds **locally** when it holds on every arrow of some
covering sieve of `U`. -/
def Locally {U : C} (P : ∀ ⦃V : C⦄, (V ⟶ U) → Prop) : Prop :=
  ∃ S : Sieve U, S ∈ J U ∧ ∀ ⦃V : C⦄ (f : V ⟶ U), S f → P f

variable {J}

/-- If `P` holds locally and every arrow satisfying `P` satisfies `Q`, then `Q` holds locally. -/
lemma Locally.mono {U : C} {P Q : ∀ ⦃V : C⦄, (V ⟶ U) → Prop} (h : Locally J P)
    (hPQ : ∀ ⦃V : C⦄ (f : V ⟶ U), P f → Q f) : Locally J Q := by
  obtain ⟨S, hS, hP⟩ := h
  exact ⟨S, hS, fun V f hf => hPQ f (hP f hf)⟩

/-- A property of the arrows into `U` that holds on every such arrow holds locally. -/
lemma Locally.of_forall {U : C} {P : ∀ ⦃V : C⦄, (V ⟶ U) → Prop}
    (h : ∀ ⦃V : C⦄ (f : V ⟶ U), P f) : Locally J P :=
  ⟨⊤, J.top_mem U, fun _ f _ => h f⟩

/-- **Refining a covering on each of its members.** -/
lemma Locally.bind {U : C} {P : ∀ ⦃V : C⦄, (V ⟶ U) → Prop}
    (h : Locally J fun V f => Locally J fun W (g : W ⟶ V) => P (g ≫ f)) : Locally J P := by
  classical
  obtain ⟨S, hS, hP⟩ := h
  refine ⟨Sieve.bind S.arrows fun V f hf => (hP f hf).choose,
    J.bind_covering hS fun V f hf => (hP f hf).choose_spec.1, ?_⟩
  rintro W _ ⟨V, g, f, hf, hg, rfl⟩
  exact (hP f hf).choose_spec.2 g hg

/-- If `P` and `Q` both hold locally, then so does their conjunction. -/
lemma Locally.and {U : C} {P Q : ∀ ⦃V : C⦄, (V ⟶ U) → Prop} (hP : Locally J P)
    (hQ : Locally J Q) : Locally J fun _ f => P f ∧ Q f := by
  obtain ⟨S, hS, hP⟩ := hP
  obtain ⟨T, hT, hQ⟩ := hQ
  exact ⟨S ⊓ T, J.intersection_covering hS hT, fun V f hf => ⟨hP f hf.1, hQ f hf.2⟩⟩

/-- **Finitely many coverings have a common refinement.** -/
lemma Locally.forall_fin {U : C} {n : ℕ} {P : Fin n → ∀ ⦃V : C⦄, (V ⟶ U) → Prop}
    (h : ∀ i, Locally J (P i)) : Locally J fun _ f => ∀ i, P i f := by
  induction n with
  | zero => exact Locally.of_forall fun V f i => i.elim0
  | succ n ih =>
    refine ((h 0).and (ih fun i => h i.succ)).mono fun V f hf => ?_
    intro i
    refine Fin.cases hf.1 (fun j => hf.2 j) i

/-- A sieve containing the arrows of a covering sieve is covering. -/
lemma Locally.sieve_mem {U : C} {S : Sieve U} (h : Locally J fun _ f => S f) : S ∈ J U := by
  obtain ⟨T, hT, hS⟩ := h
  exact J.superset_covering (fun V f hf => hS f hf) hT

/-- **Finitely many sections lift simultaneously on a covering sieve**, along a locally surjective
morphism of presheaves with values in a concrete category. -/
lemma locally_lift {A : Type*} [Category A] {FA : A → A → Type*} {CA : A → Type*}
    [∀ X Y, FunLike (FA X Y) (CA X) (CA Y)] [ConcreteCategory A FA] {F G : Cᵒᵖ ⥤ A} (p : F ⟶ G)
    [Presheaf.IsLocallySurjective J p] {U : C} {ι : Type*} [Finite ι]
    (s : ι → ToType (G.obj (op U))) :
    Locally J fun V (f : V ⟶ U) =>
      ∃ t : ι → ToType (F.obj (op V)), ∀ i, p.app _ (t i) = G.map f.op (s i) := by
  classical
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  have h : ∀ k : Fin n, Locally J fun V (f : V ⟶ U) =>
      ∃ t : ToType (F.obj (op V)), p.app _ t = G.map f.op (s (e.symm k)) := fun k =>
    ⟨Presheaf.imageSieve p (s (e.symm k)), Presheaf.imageSieve_mem J p _,
      fun V f hf => hf⟩
  refine (Locally.forall_fin h).mono fun V f hf => ?_
  choose t ht using hf
  exact ⟨fun i => t (e i), fun i => by simpa using ht (e i)⟩

end Locally


section Algebra

variable {Rg : Type*} [Ring Rg] {M : Type*} [AddCommGroup M] [Module Rg M]

/-- The module algebra behind Nakayama for a square-zero ideal: if `y = ∑ cᵣ zᵣ` and each
`zᵣ = ∑ₖ aᵣₖ sₖ + ∑ₚ c'ᵣₚ z'ᵣₚ` with `cᵣ c'ᵣₚ = 0`, then `y = ∑ₖ (∑ᵣ cᵣ aᵣₖ) sₖ`. -/
lemma sum_smul_eq_of_sq_zero {N n : ℕ} {N' : Fin N → ℕ} (y : M) (c : Fin N → Rg)
    (z : Fin N → M) (s : Fin n → M) (a : Fin N → Fin n → Rg) (c' : ∀ r, Fin (N' r) → Rg)
    (z' : ∀ r, Fin (N' r) → M) (hy : y = ∑ r, c r • z r)
    (hz : ∀ r, z r = ∑ k, a r k • s k + ∑ p, c' r p • z' r p)
    (hcc : ∀ r p, c r * c' r p = 0) :
    y = ∑ k, (∑ r, c r * a r k) • s k := by
  rw [hy]
  simp_rw [hz, smul_add, Finset.smul_sum, smul_smul, hcc, zero_smul, Finset.sum_const_zero,
    add_zero, Finset.sum_smul]
  exact Finset.sum_comm

/-- The ring algebra behind condition (C). In the notation of the module docstring: `d` is a
relation with coefficients in the kernel, `β`, `κ`, `u` the data of a trivial vanishing of
`∑ dₖ ⊗ sₖ`, `w` the coordinates of the auxiliary sections in terms of `s`, and `y`, `z` (with
errors `ε`, `ε'` in the kernel) the expressions of the resulting relations through `t`. -/
lemma eq_sum_mul_of_vanishing {Rg : Type*} [CommRing Rg] {n l P m : ℕ}
    (d : Fin n → Rg) (β : Fin n → Fin l → Rg) (κ : Fin l → Fin P → Rg) (u : Fin P → Rg)
    (w : Fin l → Fin n → Rg) (t : Fin m → Fin n → Rg) (y : Fin P → Fin m → Rg)
    (ε : Fin P → Fin n → Rg) (z : Fin n → Fin m → Rg) (ε' : Fin n → Fin n → Rg)
    (h1 : ∀ g, ∑ k, β k g * d k = ∑ p, κ g p * u p)
    (h2 : ∀ p k', ∑ g, κ g p * w g k' = ∑ j, y p j * t j k' + ε p k')
    (h3 : ∀ k k', (if k = k' then 1 else 0) - ∑ g, β k g * w g k' = ∑ j, z k j * t j k' + ε' k k')
    (hdε : ∀ k k', d k * ε' k k' = 0) (huε : ∀ p k', u p * ε p k' = 0) (k' : Fin n) :
    d k' = ∑ j, (∑ k, d k * z k j + ∑ p, u p * y p j) * t j k' := by
  have e1 : d k' = ∑ k, d k * (if k = k' then 1 else 0) := by simp
  have h3' : ∀ k, (if k = k' then (1 : Rg) else 0) =
      ∑ j, z k j * t j k' + ε' k k' + ∑ g, β k g * w g k' := fun k => by
    rw [← h3 k k']; ring
  have e2 : ∑ k, d k * ∑ g, β k g * w g k' = ∑ p, u p * ∑ g, κ g p * w g k' := by
    calc ∑ k, d k * ∑ g, β k g * w g k'
        = ∑ g, (∑ k, β k g * d k) * w g k' := by
          simp only [Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
      _ = ∑ g, (∑ p, κ g p * u p) * w g k' := by simp_rw [h1]
      _ = ∑ p, u p * ∑ g, κ g p * w g k' := by
          simp only [Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
  have e3 : ∑ k, d k * (if k = k' then (1 : Rg) else 0) =
      ∑ k, d k * ∑ j, z k j * t j k' + ∑ p, u p * ∑ j, y p j * t j k' := by
    rw [Finset.sum_congr rfl fun k _ => congrArg (d k * ·) (h3' k)]
    simp only [mul_add, Finset.sum_add_distrib, hdε, add_zero]
    rw [e2]
    simp only [h2, mul_add, huε, add_zero]
  rw [e1, e3]
  simp only [Finset.mul_sum, add_mul, Finset.sum_mul, Finset.sum_add_distrib]
  rw [Finset.sum_comm (f := fun x j => d x * (z x j * t j k')),
    Finset.sum_comm (f := fun x j => u x * (y x j * t j k'))]
  exact congrArg₂ (· + ·) (Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring)
    (Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring)

end Algebra

section Core

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  {A O R : Sheaf J CommRingCat.{w}}

open Stacks.SheafOfModules (res resR res_res resR_resR res_smul res_sum resR_mul resR_sum
  resR_sub resR_zero res_zero resR_one)
open Stacks.SheafOfModules.FlatSquareZero (ringMap)

local notation "𝒪[" X "]" => Stacks.SheafOfModules.Tensor.ringSheaf X

/-- A map of sheaves of commutative rings, on the sections over `U`. -/
noncomputable abbrev ringMapApp (φ : O ⟶ R) (U : Cᵒᵖ) :
    ToType ((𝒪[O]).obj.obj U) →+* ToType ((𝒪[R]).obj.obj U) :=
  ((ringMap φ).hom.app U).hom

/-- `ringMapApp φ` commutes with the restriction of sections along `f : V ⟶ U`. -/
lemma ringMapApp_resR (φ : O ⟶ R) {U V : C} (f : V ⟶ U) (a : ToType ((𝒪[O]).obj.obj (op U))) :
    ringMapApp φ (op V) (resR (𝒪[O]) f a) = resR (𝒪[R]) f (ringMapApp φ (op U) a) := by
  have h := ConcreteCategory.congr_hom ((ringMap φ).hom.naturality f.op) a
  simp only [ConcreteCategory.comp_apply] at h
  exact h

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- Restriction of sections of a sheaf of modules along `f : V ⟶ U` is additive. -/
lemma res_add {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {U V : C} (f : V ⟶ U)
    (x y : ToType (M.val.obj (op U))) : res M f (x + y) = res M f x + res M f y :=
  map_add (M.val.map f.op).hom x y

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- Restriction of sections of a sheaf of modules along `f : V ⟶ U` preserves subtraction. -/
lemma res_sub {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {U V : C} (f : V ⟶ U)
    (x y : ToType (M.val.obj (op U))) : res M f (x - y) = res M f x - res M f y :=
  map_sub (M.val.map f.op).hom x y

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- Restriction of sections of a sheaf of rings along `f : V ⟶ U` is additive. -/
lemma resR_add (R' : Sheaf J RingCat.{w}) {U V : C} (f : V ⟶ U)
    (a b : ToType (R'.obj.obj (op U))) : resR R' f (a + b) = resR R' f a + resR R' f b :=
  map_add (R'.obj.map f.op).hom a b

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- Restriction along `f : V ⟶ U` sends a linear combination `∑ₖ aₖ • xₖ` of sections to
the linear combination of the restrictions of the `aₖ` and the `xₖ`. -/
lemma res_sum_smul {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {U V : C} (f : V ⟶ U)
    {n : ℕ} (a : Fin n → ToType (R'.obj.obj (op U))) (x : Fin n → ToType (M.val.obj (op U))) :
    res M f (∑ k, a k • x k) = ∑ k, resR R' f (a k) • res M f (x k) := by
  rw [res_sum]
  exact Finset.sum_congr rfl fun k _ => res_smul M f (a k) (x k)

variable {F' : SheafOfModules.{w} (𝒪[O])} {G : SheafOfModules.{w} (𝒪[R])} {π : O ⟶ R}

/-- A `π`-semilinear map `ℱ' ⟶ 𝒢`, on the sections over `U`. -/
noncomputable abbrev qApp (q : F' ⟶ (SheafOfModules.restrictScalars (ringMap π)).obj G)
    (U : Cᵒᵖ) (x : ToType (F'.val.obj U)) : ToType (G.val.obj U) :=
  q.val.app U x

variable (q : F' ⟶ (SheafOfModules.restrictScalars (ringMap π)).obj G)

/-- `qApp q U` is additive. -/
lemma qApp_add (U : Cᵒᵖ) (x y : ToType (F'.val.obj U)) :
    qApp q U (x + y) = qApp q U x + qApp q U y :=
  map_add (q.val.app U).hom x y

/-- `qApp q U` preserves subtraction. -/
lemma qApp_sub (U : Cᵒᵖ) (x y : ToType (F'.val.obj U)) :
    qApp q U (x - y) = qApp q U x - qApp q U y :=
  map_sub (q.val.app U).hom x y

/-- `qApp q U` sends `0` to `0`. -/
lemma qApp_zero (U : Cᵒᵖ) : qApp q U 0 = 0 :=
  map_zero (q.val.app U).hom

/-- `qApp q U` is `π`-semilinear: `q (c • x) = π c • q x`. -/
lemma qApp_smul (U : Cᵒᵖ) (c : ToType ((𝒪[O]).obj.obj U)) (x : ToType (F'.val.obj U)) :
    qApp q U (c • x) = ringMapApp π U c • qApp q U x :=
  (q.val.app U).hom.map_smul c x

/-- `qApp q U` commutes with finite sums. -/
lemma qApp_sum (U : Cᵒᵖ) {n : ℕ} (x : Fin n → ToType (F'.val.obj U)) :
    qApp q U (∑ k, x k) = ∑ k, qApp q U (x k) :=
  map_sum (q.val.app U).hom x Finset.univ

/-- `qApp q U` sends `∑ₖ cₖ • xₖ` to `∑ₖ π cₖ • q xₖ`. -/
lemma qApp_sum_smul (U : Cᵒᵖ) {n : ℕ} (c : Fin n → ToType ((𝒪[O]).obj.obj U))
    (x : Fin n → ToType (F'.val.obj U)) :
    qApp q U (∑ k, c k • x k) = ∑ k, ringMapApp π U (c k) • qApp q U (x k) := by
  rw [qApp_sum]
  exact Finset.sum_congr rfl fun k _ => qApp_smul q U (c k) (x k)

/-- `qApp q` commutes with the restriction of sections along `f : V ⟶ U`. -/
lemma qApp_res {U V : C} (f : V ⟶ U) (x : ToType (F'.val.obj (op U))) :
    qApp q (op V) (res F' f x) = res G f (qApp q (op U) x) :=
  PresheafOfModules.naturality_apply q.val f.op x

/-- `s` **generates `M` locally**: every section over an object over `U` is, on a covering
sieve, a linear combination of the restrictions of `s`. This is
`Stacks.SheafOfModules.GeneratesLocally` with the covering sieve recorded through `Locally`. -/
def Spans {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {U : C} {n : ℕ}
    (s : Fin n → ToType (M.val.obj (op U))) : Prop :=
  ∀ ⦃V : C⦄ (f : V ⟶ U) (y : ToType (M.val.obj (op V))),
    Locally J fun W (g : W ⟶ V) =>
      ∃ a : Fin n → ToType (R'.obj.obj (op W)), ∑ k, a k • res M (g ≫ f) (s k) = res M g y

/-- The kernel of a `π`-semilinear map is locally the ideal product: the hypothesis that the
reduction `q : ℱ' ⟶ 𝒢` has kernel `I·ℱ'`, on sections. -/
def KernelIsIdealProduct : Prop :=
  ∀ ⦃U : C⦄ (x : ToType (F'.val.obj (op U))), qApp q (op U) x = 0 →
    Locally J fun V (f : V ⟶ U) => ∃ (N : ℕ) (c : Fin N → ToType ((𝒪[O]).obj.obj (op V)))
      (y : Fin N → ToType (F'.val.obj (op V))),
        (∀ r, ringMapApp π (op V) (c r) = 0) ∧ res F' f x = ∑ r, c r • y r

variable (π) in
/-- The kernel of `π` is square zero, on sections. -/
def SquareZeroKernel : Prop :=
  ∀ (U : Cᵒᵖ) (a b : ToType ((𝒪[O]).obj.obj U)),
    ringMapApp π U a = 0 → ringMapApp π U b = 0 → a * b = 0

variable {q}

/-- If `ā` are the reductions of `a` and `∑ ā k • q (sₖ) = q y` on `W₁`, then `y - ∑ aₖ sₖ` is
killed by `q` on `W₂`. -/
private lemma qApp_res_sub_sum_smul_eq_zero {U V W₁ W₂ : C} {n : ℕ} (f : V ⟶ U) (g₁ : W₁ ⟶ V)
    (g₂ : W₂ ⟶ W₁) (s : Fin n → ToType (F'.val.obj (op U))) (y : ToType (F'.val.obj (op V)))
    (ā : Fin n → ToType ((𝒪[R]).obj.obj (op W₁)))
    (hā : ∑ k, ā k • res G (g₁ ≫ f) (qApp q _ (s k)) = res G g₁ (qApp q _ y))
    (a : Fin n → ToType ((𝒪[O]).obj.obj (op W₂)))
    (ha : ∀ k, ringMapApp π _ (a k) = resR _ g₂ (ā k)) :
    qApp q _ (res F' (g₂ ≫ g₁) y - ∑ k, a k • res F' (g₂ ≫ g₁ ≫ f) (s k)) = 0 := by
  simp only [qApp_sub, qApp_sum_smul, qApp_res]
  rw [sub_eq_zero, ← res_res, ← hā, res_sum_smul]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [res_res, ha k]

/-- **Nakayama for a square-zero ideal, on sections.** If the reductions of `s` generate `𝒢`
locally, then a section killed by `q` is locally a combination of the restrictions of `s` with
coefficients in the kernel of `π`. -/
theorem locally_eq_sum_of_qApp_eq_zero (hπ : Presheaf.IsLocallySurjective J (ringMap π).hom)
    (hsq : SquareZeroKernel π) (hker : KernelIsIdealProduct q) {U : C} {n : ℕ}
    (s : Fin n → ToType (F'.val.obj (op U))) (hs : Spans G fun k => qApp q _ (s k))
    ⦃V : C⦄ (f : V ⟶ U) (y : ToType (F'.val.obj (op V))) (hy : qApp q _ y = 0) :
    Locally J fun W (g : W ⟶ V) => ∃ e : Fin n → ToType ((𝒪[O]).obj.obj (op W)),
      (∀ k, ringMapApp π _ (e k) = 0) ∧ res F' g y = ∑ k, e k • res F' (g ≫ f) (s k) := by
  refine Locally.bind ((hker y hy).mono fun W g ⟨N, c, z, hc, hyz⟩ => ?_)
  refine Locally.bind ((Locally.forall_fin fun r => hs (g ≫ f) (qApp q _ (z r))).mono
    fun W₁ g₁ hā => ?_)
  choose ā hā using hā
  refine Locally.bind ((locally_lift (J := J) (ringMap π).hom
    (fun rk : Fin N × Fin n => ā rk.1 rk.2)).mono fun W₂ g₂ ⟨a, ha⟩ => ?_)
  let w : Fin N → ToType (F'.val.obj (op W₂)) := fun r =>
    res F' (g₂ ≫ g₁) (z r) - ∑ k, a (r, k) • res F' (g₂ ≫ g₁ ≫ g ≫ f) (s k)
  have hw : ∀ r, qApp q _ (w r) = 0 := fun r =>
    qApp_res_sub_sum_smul_eq_zero (g ≫ f) g₁ g₂ s (z r) (ā r) (hā r) _ fun k => ha (r, k)
  refine (Locally.forall_fin fun r => hker (w r) (hw r)).mono fun Z h hz' => ?_
  choose N' c' z' hc' hz' using hz'
  refine ⟨fun k => ∑ r, resR _ (h ≫ g₂ ≫ g₁) (c r) * resR _ h (a (r, k)), ?_, ?_⟩
  · intro k
    rw [map_sum]
    refine Finset.sum_eq_zero fun r _ => ?_
    rw [map_mul, ringMapApp_resR, hc r, resR_zero, zero_mul]
  · refine sum_smul_eq_of_sq_zero (N' := N') _ (fun r => resR _ (h ≫ g₂ ≫ g₁) (c r))
      (fun r => res F' (h ≫ g₂ ≫ g₁) (z r)) _ (fun r k => resR _ h (a (r, k))) c' z' ?_ ?_ ?_
    · rw [← res_res, hyz, res_sum_smul]
      simp only [Category.assoc]
    · intro r
      have := hz' r
      simp only [w, res_sub, res_sum_smul, res_res] at this
      rw [← this]
      simp only [Category.assoc]
      abel
    · intro r p
      refine hsq _ _ _ ?_ (hc' r p)
      rw [ringMapApp_resR, hc r, resR_zero]


/-- `q` is **surjective on sections, locally**. -/
def LocallySurjectiveOnSections (q : F' ⟶ (SheafOfModules.restrictScalars (ringMap π)).obj G) :
    Prop :=
  ∀ ⦃U : C⦄ (y : ToType (G.val.obj (op U))),
    Locally J fun V (f : V ⟶ U) => ∃ x : ToType (F'.val.obj (op V)), qApp q _ x = res G f y

/-- **(B): lifts of local generators of the reduction are local generators.** -/
theorem spans_of_spans_qApp (hπ : Presheaf.IsLocallySurjective J (ringMap π).hom)
    (hsq : SquareZeroKernel π) (hker : KernelIsIdealProduct q) {U : C} {n : ℕ}
    (s : Fin n → ToType (F'.val.obj (op U))) (hs : Spans G fun k => qApp q _ (s k)) :
    Spans F' s := by
  intro V f y
  refine Locally.bind ((hs f (qApp q _ y)).mono fun W₁ g₁ ⟨ā, hā⟩ => ?_)
  refine Locally.bind ((locally_lift (J := J) (ringMap π).hom ā).mono
    fun W₂ g₂ ⟨a, ha⟩ => ?_)
  let x : ToType (F'.val.obj (op W₂)) :=
    res F' (g₂ ≫ g₁) y - ∑ k, a k • res F' (g₂ ≫ g₁ ≫ f) (s k)
  have hx : qApp q _ x = 0 := qApp_res_sub_sum_smul_eq_zero f g₁ g₂ s y ā hā a ha
  refine (locally_eq_sum_of_qApp_eq_zero hπ hsq hker s hs (g₂ ≫ g₁ ≫ f) x hx).mono
    fun W₃ g₃ ⟨e, _, he⟩ => ?_
  refine ⟨fun k => resR _ g₃ (a k) + e k, ?_⟩
  have := he
  simp only [x, res_sub, res_sum_smul, res_res] at this
  simp only [add_smul, Finset.sum_add_distrib, Category.assoc]
  rw [← this]
  abel


/-- **(C) for the reduction**: every relation among the restrictions of `sb` is locally a
combination of the restrictions of the rows of `tb`. -/
def RelationsSpanned {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {V : C} {n m : ℕ}
    (sb : Fin n → ToType (M.val.obj (op V))) (tb : Fin m → Fin n → ToType (R'.obj.obj (op V))) :
    Prop :=
  ∀ ⦃W : C⦄ (g : W ⟶ V) (a : Fin n → ToType (R'.obj.obj (op W))),
    ∑ k, a k • res M g (sb k) = 0 →
      Locally J fun Z (h : Z ⟶ W) => ∃ c : Fin m → ToType (R'.obj.obj (op Z)),
        ∀ k, resR R' h (a k) = ∑ j, c j * resR R' (h ≫ g) (tb j k)

/-- **A relation among lifted generators is, modulo the kernel of `π`, locally a combination of
lifted relations.** Its reduction is a relation among the generators of the reduction. -/
theorem locally_relation_mod_kernel (hπ : Presheaf.IsLocallySurjective J (ringMap π).hom)
    {V V₁ : C} (φ : V₁ ⟶ V) {n m : ℕ} {sb : Fin n → ToType (G.val.obj (op V))}
    {tb : Fin m → Fin n → ToType ((𝒪[R]).obj.obj (op V))} (htb : RelationsSpanned G sb tb)
    (s : Fin n → ToType (F'.val.obj (op V₁))) (hs : ∀ k, qApp q _ (s k) = res G φ (sb k))
    (t : Fin m → Fin n → ToType ((𝒪[O]).obj.obj (op V₁)))
    (ht : ∀ j k, ringMapApp π _ (t j k) = resR _ φ (tb j k))
    ⦃W : C⦄ (g : W ⟶ V₁) (a : Fin n → ToType ((𝒪[O]).obj.obj (op W)))
    (ha : ∑ k, a k • res F' g (s k) = 0) :
    Locally J fun Z (h : Z ⟶ W) => ∃ b : Fin m → ToType ((𝒪[O]).obj.obj (op Z)),
      ∀ k, ringMapApp π _ (resR _ h (a k) - ∑ j, b j * resR _ (h ≫ g) (t j k)) = 0 := by
  have hā : ∑ k, ringMapApp π _ (a k) • res G (g ≫ φ) (sb k) = 0 := by
    have := congrArg (qApp q (op W)) ha
    rw [qApp_sum_smul, qApp_zero] at this
    rw [← this]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [qApp_res, hs k, res_res]
  refine Locally.bind ((htb (g ≫ φ) _ hā).mono fun Z₁ h₁ ⟨cb, hcb⟩ => ?_)
  refine (locally_lift (J := J) (ringMap π).hom cb).mono fun Z₂ h₂ ⟨c, hc⟩ => ?_
  refine ⟨c, fun k => ?_⟩
  rw [map_sub, map_sum, ringMapApp_resR, ← resR_resR, hcb k, resR_sum, sub_eq_zero]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_mul, ringMapApp_resR, ht j k, resR_resR, resR_mul, resR_resR]
  congr 1
  · exact (hc j).symm
  · simp only [Category.assoc]


/-- **Strictness, on sections**: every section of the kernel of `π` is locally an `O`-linear
combination of images under `ρ` of sections of `A` whose images lie in the kernel of `π`. -/
def KernelGeneratedByImage (ρ : A ⟶ O) (π : O ⟶ R) : Prop :=
  ∀ ⦃U : C⦄ (x : ToType ((𝒪[O]).obj.obj (op U))), ringMapApp π _ x = 0 →
    Locally J fun V (f : V ⟶ U) => ∃ (N : ℕ) (b : Fin N → ToType ((𝒪[O]).obj.obj (op V)))
      (α : Fin N → ToType ((𝒪[A]).obj.obj (op V))),
        (∀ p, ringMapApp π _ (ringMapApp ρ _ (α p)) = 0) ∧
          resR _ f x = ∑ p, b p * ringMapApp ρ _ (α p)

/-- Strictness can be tested on the members of a covering family: the condition on an arrow
restricts along any further arrow. -/
theorem kernelGeneratedByImage_of_presieve {ρ : A ⟶ O}
    (h : ∀ ⦃U : C⦄ (x : ToType ((𝒪[O]).obj.obj (op U))), ringMapApp π _ x = 0 →
      ∃ T : Presieve U, Sieve.generate T ∈ J U ∧ ∀ ⦃W : C⦄ (a : W ⟶ U), T a →
        ∃ (N : ℕ) (b : Fin N → ToType ((𝒪[O]).obj.obj (op W)))
          (α : Fin N → ToType ((𝒪[A]).obj.obj (op W))),
            (∀ p, ringMapApp π _ (ringMapApp ρ _ (α p)) = 0) ∧
              resR _ a x = ∑ p, b p * ringMapApp ρ _ (α p)) :
    KernelGeneratedByImage ρ π := by
  intro U x hx
  obtain ⟨T, hT, hP⟩ := h x hx
  refine ⟨_, hT, ?_⟩
  rintro W' _ ⟨W, c, a, ha, rfl⟩
  obtain ⟨N, b, α, hα, hb⟩ := hP a ha
  refine ⟨N, fun p => resR _ c (b p), fun p => resR _ c (α p), fun p => ?_, ?_⟩
  · rw [ringMapApp_resR, ringMapApp_resR, hα p, resR_zero]
  · rw [← resR_resR, hb, resR_sum]
    exact Finset.sum_congr rfl fun p _ => by rw [resR_mul, ringMapApp_resR]

/-- Strictness for finitely many sections of the kernel at once, with one family of generators
for all of them. -/
theorem locally_kernelGeneratedByImage_fin {ρ : A ⟶ O} (hst : KernelGeneratedByImage ρ π)
    {U : C} {n : ℕ} (d : Fin n → ToType ((𝒪[O]).obj.obj (op U)))
    (hd : ∀ k, ringMapApp π _ (d k) = 0) :
    Locally J fun V (f : V ⟶ U) => ∃ (N : ℕ) (β : Fin n → Fin N → ToType ((𝒪[O]).obj.obj (op V)))
      (α : Fin N → ToType ((𝒪[A]).obj.obj (op V))),
        (∀ p, ringMapApp π _ (ringMapApp ρ _ (α p)) = 0) ∧
          ∀ k, resR _ f (d k) = ∑ p, β k p * ringMapApp ρ _ (α p) := by
  classical
  refine (Locally.forall_fin fun k => hst (d k) (hd k)).mono fun V f h => ?_
  choose N b α hα hb using h
  let e := (finSigmaFinEquiv (n := N)).symm
  refine ⟨∑ k, N k, fun k P => if (e P).1 = k then b (e P).1 (e P).2 else 0,
    fun P => α (e P).1 (e P).2, fun P => hα _ _, fun k => ?_⟩
  rw [hb k, ← Fintype.sum_equiv e.symm _ _ (fun _ => rfl)]
  simp only [e, Equiv.symm_symm, Equiv.symm_apply_apply]
  rw [Fintype.sum_sigma, Finset.sum_eq_single k]
  · simp only [if_true]
    exact Finset.sum_congr rfl fun x _ => by rw [Equiv.symm_apply_apply]
  · intro k' _ hk'
    simp [hk']
  · simp


/-- **Relations with coefficients in the kernel vanish trivially**: every relation `∑ dₖ eₖ = 0`
among sections of `ℱ'` whose coefficients lie in the kernel of `π` is locally of the shape
produced by the equational criterion for the vanishing of `∑ dₖ ⊗ eₖ` in `I ⊗ ℱ'`
(`Stacks.SheafOfModules.exists_relationPresentation_of_sum_tmul_eq_zero`).

This is what the source extracts from the injectivity of `I ⊗_O ℱ ⟶ ℱ'` (Stacks 08MQ). It holds
for a module flat over `A` when the kernel is generated by images of sections of `A`
(`Deformation.ToposThickening.ReductionPresentation.idealRelationsVanish_of_isFlat`). -/
def IdealRelationsVanish (π : O ⟶ R) (F' : SheafOfModules.{w} (𝒪[O])) : Prop :=
  ∀ ⦃U : C⦄ {n : ℕ} (d : Fin n → ToType ((𝒪[O]).obj.obj (op U)))
    (e : Fin n → ToType (F'.val.obj (op U))),
    (∀ k, ringMapApp π _ (d k) = 0) → ∑ k, d k • e k = 0 →
      Locally J fun W (f : W ⟶ U) => ∃ (l P : ℕ) (τ : Fin l → ToType (F'.val.obj (op W)))
        (β : Fin n → Fin l → ToType ((𝒪[O]).obj.obj (op W)))
        (κ : Fin l → Fin P → ToType ((𝒪[O]).obj.obj (op W)))
        (u : Fin P → ToType ((𝒪[O]).obj.obj (op W))),
          (∀ p, ringMapApp π _ (u p) = 0) ∧ (∀ k, res F' f (e k) = ∑ g, β k g • τ g) ∧
            (∀ p, ∑ g, κ g p • τ g = 0) ∧
              ∀ g, ∑ k, β k g * resR _ f (d k) = ∑ p, κ g p * u p

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- A combination of linear combinations of `s` is a linear combination of `s`:
`∑_g a_g • ∑ₖ w_gk • sₖ = ∑ₖ (∑_g a_g * w_gk) • sₖ`. -/
lemma sum_smul_sum_smul {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {U : C}
    {n l : ℕ} (a : Fin l → ToType (R'.obj.obj (op U)))
    (w : Fin l → Fin n → ToType (R'.obj.obj (op U)))
    (s : Fin n → ToType (M.val.obj (op U))) :
    ∑ g, a g • ∑ k, w g k • s k = ∑ k, (∑ g, a g * w g k) • s k := by
  simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
  exact Finset.sum_comm

/-- **The key step of (C)**: a relation among the lifted generators with coefficients in the
kernel of `π` is locally a combination of the corrected relations. -/
theorem locally_eq_sum_of_kernel_relation (hsq : SquareZeroKernel π)
    (hvan : IdealRelationsVanish π F')
    {V₁ : C} {n m : ℕ} (s : Fin n → ToType (F'.val.obj (op V₁)))
    (t : Fin m → Fin n → ToType ((𝒪[O]).obj.obj (op V₁))) (hB : Spans F' s)
    (hmod : ∀ ⦃W : C⦄ (g : W ⟶ V₁) (a : Fin n → ToType ((𝒪[O]).obj.obj (op W))),
      ∑ k, a k • res F' g (s k) = 0 →
        Locally J fun Z (h : Z ⟶ W) => ∃ b : Fin m → ToType ((𝒪[O]).obj.obj (op Z)),
          ∀ k, ringMapApp π _ (resR _ h (a k) - ∑ j, b j * resR _ (h ≫ g) (t j k)) = 0)
    ⦃W : C⦄ (g : W ⟶ V₁) (d : Fin n → ToType ((𝒪[O]).obj.obj (op W)))
    (hd : ∀ k, ringMapApp π _ (d k) = 0) (hrel : ∑ k, d k • res F' g (s k) = 0) :
    Locally J fun Z (h : Z ⟶ W) => ∃ c : Fin m → ToType ((𝒪[O]).obj.obj (op Z)),
      ∀ k, resR _ h (d k) = ∑ j, c j * resR _ (h ≫ g) (t j k) := by
  classical
  refine Locally.bind ((hvan d (fun k => res F' g (s k)) hd hrel).mono
    fun W₁ h₁ ⟨l, P, τ, β, κ, u, hu, hτ, hκ, hβ⟩ => ?_)
  refine Locally.bind ((Locally.forall_fin fun g' => hB (h₁ ≫ g) (τ g')).mono fun W₂ h₂ hw => ?_)
  choose w hw using hw
  have hκ' : ∀ p, ∑ k, (∑ g', resR _ h₂ (κ g' p) * w g' k) • res F' (h₂ ≫ h₁ ≫ g) (s k) = 0 := by
    intro p
    rw [← sum_smul_sum_smul]
    simp_rw [hw, ← res_smul, ← res_sum, hκ p, res_zero]
  have hρ' : ∀ k, ∑ k', ((if k = k' then 1 else 0) - ∑ g', resR _ h₂ (β k g') * w g' k') •
      res F' (h₂ ≫ h₁ ≫ g) (s k') = 0 := by
    intro k
    simp only [sub_smul, Finset.sum_sub_distrib, ite_smul, one_smul, zero_smul,
      Finset.sum_ite_eq, Finset.mem_univ, if_true]
    rw [← sum_smul_sum_smul]
    simp_rw [hw, ← res_smul, ← res_sum, ← hτ k, res_res, sub_self]
  refine ((Locally.forall_fin fun p => hmod (h₂ ≫ h₁ ≫ g) _ (hκ' p)).and
    (Locally.forall_fin fun k => hmod (h₂ ≫ h₁ ≫ g) _ (hρ' k))).mono
    fun W₃ h₃ ⟨hy, hz⟩ => ?_
  choose y hy using hy
  choose z hz using hz
  let R₃ := fun (a : ToType ((𝒪[O]).obj.obj (op W₁))) => resR (𝒪[O]) (h₃ ≫ h₂) a
  let d₃ : Fin n → _ := fun k => resR (𝒪[O]) (h₃ ≫ h₂ ≫ h₁) (d k)
  let t₃ : Fin m → Fin n → _ := fun j k => resR (𝒪[O]) (h₃ ≫ h₂ ≫ h₁ ≫ g) (t j k)
  let w₃ : Fin l → Fin n → _ := fun g' k => resR (𝒪[O]) h₃ (w g' k)
  let ε : Fin P → Fin n → _ := fun p k =>
    ∑ g', R₃ (κ g' p) * w₃ g' k - ∑ j, y p j * t₃ j k
  let ε' : Fin n → Fin n → _ := fun k k' =>
    ((if k = k' then 1 else 0) - ∑ g', R₃ (β k g') * w₃ g' k') - ∑ j, z k j * t₃ j k'
  have hε : ∀ p k, ringMapApp π _ (ε p k) = 0 := by
    intro p k
    have := hy p k
    simp only [resR_sum, resR_mul, resR_resR] at this
    simpa only [ε, R₃, w₃, t₃, resR_resR, Category.assoc] using this
  have hε' : ∀ k k', ringMapApp π _ (ε' k k') = 0 := by
    intro k k'
    have := hz k k'
    simp only [resR_sub, resR_sum, resR_mul, resR_resR] at this
    have hite : resR (𝒪[O]) h₃ (if k = k' then (1 : ToType ((𝒪[O]).obj.obj (op W₂))) else 0) =
        if k = k' then 1 else 0 := by
      split_ifs
      · exact resR_one _ _
      · exact resR_zero _ _
    rw [hite] at this
    simpa only [ε', R₃, w₃, t₃, resR_resR, Category.assoc] using this
  have hd₃ : ∀ k, ringMapApp π _ (d₃ k) = 0 := fun k => by
    simp only [d₃, ringMapApp_resR, hd k, resR_zero]
  have hu₃ : ∀ p, ringMapApp π _ (R₃ (u p)) = 0 := fun p => by
    simp only [R₃, ringMapApp_resR, hu p, resR_zero]
  refine ⟨fun j => ∑ k, d₃ k * z k j + ∑ p, R₃ (u p) * y p j, fun k' => ?_⟩
  have key := eq_sum_mul_of_vanishing d₃ (fun k g' => R₃ (β k g')) (fun g' p => R₃ (κ g' p))
    (fun p => R₃ (u p)) w₃ t₃ y ε z ε'
    (fun g' => by
      have := congrArg (resR (𝒪[O]) (h₃ ≫ h₂)) (hβ g')
      simpa only [resR_sum, resR_mul, resR_resR, d₃, R₃, Category.assoc] using this)
    (fun p k' => by simp only [ε]; abel)
    (fun k k' => by simp only [ε']; abel)
    (fun k k' => hsq _ _ _ (hd₃ k) (hε' k k')) (fun p k' => hsq _ _ _ (hu₃ p) (hε p k')) k'
  simpa only [d₃, t₃, resR_resR, Category.assoc] using key


/-- **Section-level finite presentation data**: (A) the rows of `t` are relations among `s`,
(B) `s` generates locally and (C) every relation among the restrictions of `s` is locally a
combination of the restrictions of the rows of `t`. -/
structure IsSectionPresentation {R' : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R') {V : C}
    {n m : ℕ} (s : Fin n → ToType (M.val.obj (op V)))
    (t : Fin m → Fin n → ToType (R'.obj.obj (op V))) : Prop where
  /-- (A) Each row of `t` is a relation among the sections `s`. -/
  rel : ∀ j, ∑ k, t j k • s k = 0
  /-- (B) The sections `s` generate `M` locally. -/
  spans : Spans M s
  /-- (C) Every relation among the restrictions of `s` is locally a combination of the
  restrictions of the rows of `t`. -/
  relationsSpanned : RelationsSpanned M s t

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- If `s` generates `M` locally over `U`, then so do the restrictions of `s` along any
`φ : V ⟶ U`. -/
lemma spans_res {R' : Sheaf J RingCat.{w}} {M : SheafOfModules.{w} R'} {U V : C} {n : ℕ}
    {s : Fin n → ToType (M.val.obj (op U))} (hs : Spans M s) (φ : V ⟶ U) :
    Spans M fun k => res M φ (s k) := by
  intro W f y
  refine (hs (f ≫ φ) y).mono fun Z g ⟨a, ha⟩ => ⟨a, ?_⟩
  simpa only [res_res, Category.assoc] using ha

/-- **The local lifting of a presentation along the reduction**: the core of the proof of
(2) ⇒ (1) of Stacks 08VU, on one object. -/
theorem locally_isSectionPresentation_of_reduction
    (hπ : Presheaf.IsLocallySurjective J (ringMap π).hom) (hsq : SquareZeroKernel π)
    (hq : Presheaf.IsLocallySurjective J ((PresheafOfModules.toPresheaf _).map q.val))
    (hker : KernelIsIdealProduct q) (hvan : IdealRelationsVanish π F')
    {V : C} {n m : ℕ} {sb : Fin n → ToType (G.val.obj (op V))}
    {tb : Fin m → Fin n → ToType ((𝒪[R]).obj.obj (op V))} (h : IsSectionPresentation G sb tb) :
    Locally J fun V₁ (_ : V₁ ⟶ V) => ∃ (s : Fin n → ToType (F'.val.obj (op V₁)))
      (t : Fin m → Fin n → ToType ((𝒪[O]).obj.obj (op V₁))), IsSectionPresentation F' s t := by
  have hl : Locally J fun V₀ (φ₀ : V₀ ⟶ V) => ∃ s : Fin n → ToType (F'.val.obj (op V₀)),
      ∀ k, qApp q _ (s k) = res G φ₀ (sb k) :=
    locally_lift (J := J) ((PresheafOfModules.toPresheaf _).map q.val)
      (sb : Fin n → ToType (((PresheafOfModules.toPresheaf _).obj
        ((SheafOfModules.restrictScalars (ringMap π)).obj G).val).obj (op V)))
  have hl' : Locally J fun V₀ (φ₀ : V₀ ⟶ V) =>
      ∃ t' : Fin m × Fin n → ToType ((𝒪[O]).obj.obj (op V₀)),
        ∀ jk, ringMapApp π _ (t' jk) = resR _ φ₀ (tb jk.1 jk.2) :=
    locally_lift (J := J) (ringMap π).hom (fun jk : Fin m × Fin n => tb jk.1 jk.2)
  refine Locally.bind ((hl.and hl').mono fun V₀ φ₀ ⟨⟨s, hs'⟩, ⟨t', ht'⟩⟩ => ?_)
  have hsG : Spans G fun k => qApp q _ (s k) := by
    simpa only [hs'] using spans_res h.spans φ₀
  have hx : ∀ j, qApp q _ (∑ k, t' (j, k) • s k) = 0 := by
    intro j
    rw [qApp_sum_smul]
    have := congrArg (res G φ₀) (h.rel j)
    rw [res_sum_smul, res_zero] at this
    rw [← this]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hs' k, ht' (j, k)]
  refine (Locally.forall_fin fun j => locally_eq_sum_of_qApp_eq_zero hπ hsq hker s hsG (𝟙 V₀)
    _ (hx j)).mono fun V₁ φ₁ he => ?_
  choose e he₀ he using he
  let s₁ : Fin n → ToType (F'.val.obj (op V₁)) := fun k => res F' φ₁ (s k)
  let t : Fin m → Fin n → ToType ((𝒪[O]).obj.obj (op V₁)) := fun j k =>
    resR _ φ₁ (t' (j, k)) - e j k
  have hrel : ∀ j, ∑ k, t j k • s₁ k = 0 := by
    intro j
    have := he j
    rw [res_sum_smul] at this
    simp only [t, s₁, sub_smul, Finset.sum_sub_distrib]
    rw [this]
    simp only [Category.comp_id, sub_self]
  have ht : ∀ j k, ringMapApp π _ (t j k) = resR _ (φ₁ ≫ φ₀) (tb j k) := by
    intro j k
    simp only [t, map_sub, he₀ j k, sub_zero, ringMapApp_resR, ← resR_resR]
    rw [ht' (j, k)]
  have hs₁ : ∀ k, qApp q _ (s₁ k) = res G (φ₁ ≫ φ₀) (sb k) := by
    intro k
    simp only [s₁, qApp_res, hs' k, res_res]
  have hB : Spans F' s₁ := spans_res (spans_of_spans_qApp hπ hsq hker s hsG) φ₁
  refine ⟨s₁, t, hrel, hB, ?_⟩
  intro W g a ha
  refine Locally.bind ((locally_relation_mod_kernel hπ (φ₁ ≫ φ₀) h.relationsSpanned s₁ hs₁ t ht
    g a ha).mono fun Z₁ h₁ ⟨b, hb⟩ => ?_)
  have hrel' : ∑ k, (resR _ h₁ (a k) - ∑ j, b j * resR _ (h₁ ≫ g) (t j k)) •
      res F' (h₁ ≫ g) (s₁ k) = 0 := by
    simp only [sub_smul, Finset.sum_sub_distrib]
    have e1 : ∑ k, resR _ h₁ (a k) • res F' (h₁ ≫ g) (s₁ k) = 0 := by
      simp_rw [← res_res, ← res_smul, ← res_sum]
      rw [ha, res_zero]
    have e2 : ∑ k, (∑ j, b j * resR _ (h₁ ≫ g) (t j k)) • res F' (h₁ ≫ g) (s₁ k) = 0 := by
      rw [← sum_smul_sum_smul]
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [← res_sum_smul, hrel j, res_zero, smul_zero]
    rw [e1, e2, sub_zero]
  refine (locally_eq_sum_of_kernel_relation hsq hvan s₁ t hB
    (locally_relation_mod_kernel hπ (φ₁ ≫ φ₀) h.relationsSpanned s₁ hs₁ t ht)
    (h₁ ≫ g) _ hb hrel').mono fun Z₂ h₂ ⟨c, hc⟩ => ?_
  refine ⟨fun j => resR _ h₂ (b j) + c j, fun k => ?_⟩
  have := hc k
  rw [resR_sub, resR_sum, sub_eq_iff_eq_add] at this
  rw [← resR_resR, this]
  simp only [add_mul, Finset.sum_add_distrib, resR_mul, resR_resR, Category.assoc]
  abel


omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- Presentation data in the sense of `Stacks.Sheaves.LocalGeneration.IsPresentationData` is
section-level presentation data. -/
theorem isSectionPresentation_of_isPresentationData {R' : Sheaf J RingCat.{w}}
    {M : SheafOfModules.{w} R'} {V : C} {n m : ℕ} {s : Fin n → ToType (M.val.obj (op V))}
    {t : Fin m → Fin n → ToType (R'.obj.obj (op V))}
    (h : Stacks.Sheaves.LocalGeneration.IsPresentationData M s t) :
    IsSectionPresentation M s t where
  rel j := h.1 j
  spans W f y := by
    refine ⟨_, h.2.1 W f y, fun Z g ⟨a, ha⟩ => ⟨a, ?_⟩⟩
    refine Eq.trans (Finset.sum_congr rfl fun k _ => ?_) ha
    simp only [Stacks.Sheaves.LocalGeneration.restr_restr, ← op_comp]
    rfl
  relationsSpanned W g a ha := by
    refine ⟨_, h.2.2 W g a ha, fun Z k ⟨c, hc⟩ => ⟨c, fun i => ?_⟩⟩
    refine (hc i).symm.trans (Finset.sum_congr rfl fun j _ => ?_)
    exact congrArg (c j * ·) (resR_resR R' g k (t j i))

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- **Decoding**: section-level presentation data over `V` gives a finite presentation of the
restriction to `V`. -/
theorem exists_isFinite_presentation_of_isSectionPresentation {R' : Sheaf J RingCat.{w}}
    [∀ X : C, HasSheafify (J.over X) AddCommGrpCat.{w}]
    [∀ X : C, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{w}]
    {M : SheafOfModules.{w} R'} {V : C} {n m : ℕ} {s : Fin n → ToType (M.val.obj (op V))}
    {t : Fin m → Fin n → ToType (R'.obj.obj (op V))} (h : IsSectionPresentation M s t) :
    ∃ P : (M.over V).Presentation, P.IsFinite := by
  refine Stacks.SheafOfModules.exists_isFinite_presentation_over_of_relations M s t h.rel
    (fun W f y => ?_) (fun W g a ha => ?_)
  · obtain ⟨S, hS, hP⟩ := h.spans f y
    exact ⟨S, hS, fun Z g hg => hP g hg⟩
  · obtain ⟨S, hS, hP⟩ := h.relationsSpanned g a ha
    exact ⟨S, hS, fun Z k hk => hP k hk⟩

/-- **Stacks 08VU, (2) ⇒ (1), on one site.** Let `π : O ⟶ R` be a locally surjective map of
sheaves of commutative rings with square-zero kernel, let `q : ℱ' ⟶ 𝒢` be a locally surjective
`π`-semilinear map of modules whose kernel is locally the ideal product `I·ℱ'`, and assume that
relations among sections of `ℱ'` with coefficients in `I = ker π` vanish trivially. If `𝒢` is of
finite presentation over `R`, then `ℱ'` is of finite presentation over `O`. -/
theorem isFinitePresentation_of_reduction
    [∀ X : C, HasSheafify (J.over X) AddCommGrpCat.{w}]
    [∀ X : C, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (hπ : Presheaf.IsLocallySurjective J (ringMap π).hom) (hsq : SquareZeroKernel π)
    (hq : Presheaf.IsLocallySurjective J ((PresheafOfModules.toPresheaf _).map q.val))
    (hker : KernelIsIdealProduct q) (hvan : IdealRelationsVanish π F')
    (hG : G.IsFinitePresentation) : F'.IsFinitePresentation := by
  classical
  have : ∀ X : C, HasWeakSheafify (J.over X) AddCommGrpCat.{w} := fun X => inferInstance
  rw [Stacks.SheafOfModules.isFinitePresentation_iff_exists_cover_finite_presentations]
  refine ⟨{ V : C // ∃ (n m : ℕ) (s : Fin n → ToType (F'.val.obj (op V)))
      (t : Fin m → Fin n → ToType ((𝒪[O]).obj.obj (op V))), IsSectionPresentation F' s t },
    Subtype.val, fun Y => ?_, fun V => ?_⟩
  · obtain ⟨qd, hqd⟩ := SheafOfModules.IsFinitePresentation.exists_quasicoherentData G
    refine Locally.sieve_mem (Locally.bind ?_)
    refine ⟨_, qd.coversTop Y, fun V f ⟨i, ⟨v⟩⟩ => ?_⟩
    have := hqd.isFinite_presentation i
    obtain ⟨n, m, sb, tb, hd⟩ :=
      Stacks.Sheaves.LocalGeneration.exists_isPresentationData_of_presentation G (qd.X i)
        (qd.presentation i)
    have hd' := isSectionPresentation_of_isPresentationData
      (Stacks.Sheaves.LocalGeneration.isPresentationData_map hd v)
    refine (locally_isSectionPresentation_of_reduction hπ hsq hq hker hvan hd').mono
      fun W g ⟨s, t, hst⟩ => ?_
    exact ⟨⟨W, n, m, s, t, hst⟩, ⟨𝟙 W⟩⟩
  · obtain ⟨n, m, s, t, hst⟩ := V.2
    exact exists_isFinite_presentation_of_isSectionPresentation hst


section Flat

variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasWeakSheafify J AddCommGrpCat.{w}]

/-- **Relations with coefficients in the kernel vanish trivially in a flat module, when the
kernel is generated by images.** This is the consequence of Stacks 08MQ the proof of Stacks 08VU
uses, obtained here directly from the local equational criterion for flatness (Stacks 08FC): a
relation `∑ dₖ eₖ = 0` with `dₖ = ∑ₚ βₖₚ ρ(αₚ)` is the relation `∑ₚ αₚ • (∑ₖ βₖₚ eₖ) = 0` over `A`,
which flatness factors through a finite free module. -/
theorem idealRelationsVanish_of_isFlat {ρ : A ⟶ O} (hst : KernelGeneratedByImage ρ π)
    (hflat : AlgebraicGeometry.SheafOfModules.IsFlat
      ((SheafOfModules.restrictScalars (ringMap ρ)).obj F')) :
    IdealRelationsVanish π F' := by
  classical
  have hcrit := Stacks.SheafOfModules.hasLocalSingleRelationFactorizations_of_isFlat_freeUniverse
    (O := A) (F := (SheafOfModules.restrictScalars (ringMap ρ)).obj F') hflat
  intro U n d e hd hde
  refine Locally.bind ((locally_kernelGeneratedByImage_fin hst d hd).mono
    fun V f ⟨N, β, α, hα, hβ⟩ => ?_)
  let fP : Fin N → ToType (F'.val.obj (op V)) := fun p => ∑ k, β k p • res F' f (e k)
  have hrel : ∑ p, ringMapApp ρ _ (α p) • fP p = 0 := by
    simp only [fP, Finset.smul_sum, smul_smul]
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_smul, mul_comm (ringMapApp ρ _ _), ← hβ, ← res_smul, ← res_sum, hde,
      res_zero]
  obtain ⟨S, hS, hfac⟩ := hcrit V N α fP hrel
  refine ⟨S, hS, fun W g hg => ?_⟩
  obtain ⟨L, y₀, B, hy, hB⟩ := hfac g hg
  let y : Fin L → ToType (F'.val.obj (op W)) := y₀
  refine ⟨n + L, N, Fin.append (fun k => res F' (g ≫ f) (e k)) y,
    fun k => Fin.append (fun k' => if k = k' then 1 else 0) (fun _ => 0),
    Fin.append (fun k p => resR _ g (β k p)) (fun j p => -ringMapApp ρ _ (B j p)),
    fun p => ringMapApp ρ _ (resR _ g (α p)), fun p => ?_, fun k => ?_, fun p => ?_, fun g' => ?_⟩
  · dsimp only
    rw [ringMapApp_resR, ringMapApp_resR, hα p, resR_zero]
  · rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, zero_smul, Finset.sum_const_zero, add_zero,
      ite_smul, one_smul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  · rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, neg_smul, Finset.sum_neg_distrib]
    rw [← sub_eq_add_neg, sub_eq_zero]
    have e1 : ∑ k, resR _ g (β k p) • res F' (g ≫ f) (e k) = res F' g (fP p) := by
      simp only [fP, res_sum_smul, res_res]
    rw [e1]
    exact hy p
  · refine Fin.addCases (fun k' => ?_) (fun j => ?_) g'
    · simp only [Fin.append_left, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq',
        Finset.mem_univ, if_true]
      rw [← resR_resR, hβ k', resR_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [resR_mul, ringMapApp_resR]
    · simp only [Fin.append_right, zero_mul, Finset.sum_const_zero, neg_mul,
        Finset.sum_neg_distrib, zero_eq_neg]
      let B' : Fin L → Fin N → ToType ((𝒪[A]).obj.obj (op W)) := B
      have h3 : ∑ p, B' j p * resR _ g (α p) = 0 := hB j 0
      have h2 : ∑ p, ringMapApp ρ _ (B' j p) * ringMapApp ρ _ (resR _ g (α p)) =
          ringMapApp ρ _ (∑ p, B' j p * resR _ g (α p)) := by
        rw [map_sum]
        exact Finset.sum_congr rfl fun p _ => (map_mul _ _ _).symm
      rw [h3, map_zero] at h2
      exact h2

end Flat

