module

public import StacksFrontier.Deformation.ToposThickening.CurvatureBaseChange
public import StacksFrontier.Homology.ExtendScalars.Flat

/-!
# Flat base change of the kernel complex

Let `fR : R' → R` and `fS : S' → S` be surjections of commutative rings in a commuting square
with `a : R' → S'` and `b : R → S`, write `I = ker fR` and `J = ker fS`, and assume the square
is cartesian on kernels, `J = I · S'`. If `a` is flat then the comparison
`S ⊗_R I/I² → J/J²` is an isomorphism, so the comparison of the kernel complexes — the kernel
modules placed in cohomological degree zero — is an isomorphism of complexes. If moreover `b`
is flat then extension of scalars along `b` is exact, so it carries a resolution of the kernel
complex over `R` to a resolution of the kernel complex over `S`.

## Main results

* `Deformation.Obstruction.isIso_squareZeroKernelBaseChangeMap`: for flat `a` and a cartesian
  square on kernels, `S ⊗_R I/I² → J/J²` is an isomorphism of `S`-modules.
* `Deformation.Obstruction.isIso_kernelComplexBaseChangeMap`: the same for the kernel modules
  placed in degree zero.
* `Deformation.Obstruction.quasiIso_kernelComplexBaseChange`: for flat `a` and flat `b`, the
  base change along `b` of a resolution of `kernelComplex fR hfR` is a resolution of
  `kernelComplex fS hfS`.
* `Deformation.Obstruction.isZero_homology_mapCochainComplex`: the higher Tor of `S` against
  `I/I²` vanish, in the form that the base-changed resolution is exact away from degree zero.

## Implementation notes

Flatness is taken in the form `RingHom.Flat`. The two flatness hypotheses are genuinely
different maps: injectivity of `S ⊗_R I/I² → J/J²` is flatness of `a : R' → S'` and says
nothing about `b`, while exactness of extension of scalars on complexes is flatness of
`b : R → S`. Flatness of `b` alone does not give injectivity.

## References

* [Stacks Project, Tag 0DYR](https://stacks.math.columbia.edu/tag/0DYR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open CochainComplex.ExtendScalars

universe u

namespace Deformation.Obstruction

variable {R' R S' S : Type u} [CommRing R'] [CommRing R] [CommRing S'] [CommRing S]

/-- When `a` is flat and the kernel of `fS` is generated by the image of the kernel of `fR`,
the comparison of kernel modules `S ⊗_R I/I² → J/J²` is an isomorphism. -/
theorem isIso_squareZeroKernelBaseChangeMap
    (fR : R' →+* R) (hfR : Function.Surjective fR)
    (fS : S' →+* S) (hfS : Function.Surjective fS)
    (a : R' →+* S') (b : R →+* S) (hcomm : b.comp fR = fS.comp a)
    (hJ : RingHom.ker fS = Ideal.map a (RingHom.ker fR)) (ha : a.Flat) :
    IsIso (squareZeroKernelBaseChangeMap fR hfR fS hfS a b hcomm) := by
  rw [ConcreteCategory.isIso_iff_bijective]
  let : Algebra R S := b.toAlgebra
  let := kernelCotangentModule fR hfR
  let := kernelCotangentModule fS hfS
  exact ⟨kernelCotangentBaseChange_injective fR hfR fS hfS a hcomm hJ ha,
    kernelCotangentBaseChange_surjective fR hfR fS hfS a hcomm hJ⟩

/-- The comparison of the kernel modules placed in cohomological degree zero is an
isomorphism of complexes, under the same hypotheses. -/
theorem isIso_kernelComplexBaseChangeMap
    (fR : R' →+* R) (hfR : Function.Surjective fR)
    (fS : S' →+* S) (hfS : Function.Surjective fS)
    (a : R' →+* S') (b : R →+* S) (hcomm : b.comp fR = fS.comp a)
    (hJ : RingHom.ker fS = Ideal.map a (RingHom.ker fR)) (ha : a.Flat) :
    IsIso (kernelComplexBaseChangeMap fR hfR fS hfS a b hcomm) := by
  have := isIso_squareZeroKernelBaseChangeMap fR hfR fS hfS a b hcomm hJ ha
  show IsIso
    ((HomologicalComplex.singleMapHomologicalComplex (ModuleCat.extendScalars.{u, u, u} b)
        (ComplexShape.up ℤ) 0).hom.app (squareZeroKernelModule.{u, u} fR hfR) ≫
      (CochainComplex.singleFunctor (ModuleCat.{u} S) 0).map
        (squareZeroKernelBaseChangeMap fR hfR fS hfS a b hcomm))
  infer_instance

/-- Extension of scalars along a flat `b` carries a resolution of the kernel complex of `fR`
to a resolution of the kernel complex of `fS`: the base-changed resolution map, followed by
the comparison of kernel complexes, is a quasi-isomorphism. -/
theorem quasiIso_kernelComplexBaseChange
    (fR : R' →+* R) (hfR : Function.Surjective fR)
    (fS : S' →+* S) (hfS : Function.Surjective fS)
    (a : R' →+* S') (b : R →+* S) (hcomm : b.comp fR = fS.comp a)
    (hJ : RingHom.ker fS = Ideal.map a (RingHom.ker fR)) (ha : a.Flat) (hb : b.Flat)
    (T : CochainComplex (ModuleCat.{u} R) ℤ) (q : T ⟶ kernelComplex fR hfR) (hq : QuasiIso q) :
    QuasiIso ((mapCochainComplex b).map q ≫
      kernelComplexBaseChangeMap fR hfR fS hfS a b hcomm) := by
  have := extendScalars_preservesHomology_of_flat.{u, u} b hb
  have : QuasiIso ((mapCochainComplex b).map q) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology q (ModuleCat.extendScalars.{u, u, u} b)
  have := isIso_kernelComplexBaseChangeMap fR hfR fS hfS a b hcomm hJ ha
  infer_instance

/-- The higher Tor of `S` against `I/I²` vanish: the base change along a flat `b` of a
resolution of the kernel complex is exact away from cohomological degree zero. -/
theorem isZero_homology_mapCochainComplex
    (fR : R' →+* R) (hfR : Function.Surjective fR)
    (fS : S' →+* S) (hfS : Function.Surjective fS)
    (a : R' →+* S') (b : R →+* S) (hcomm : b.comp fR = fS.comp a)
    (hJ : RingHom.ker fS = Ideal.map a (RingHom.ker fR)) (ha : a.Flat) (hb : b.Flat)
    (T : CochainComplex (ModuleCat.{u} R) ℤ) (q : T ⟶ kernelComplex fR hfR) (hq : QuasiIso q)
    (i : ℤ) (hi : i ≠ 0) :
    IsZero (((mapCochainComplex b).obj T).homology i) := by
  have := quasiIso_kernelComplexBaseChange fR hfR fS hfS a b hcomm hJ ha hb T q hq
  exact IsZero.of_iso (HomologicalComplex.isZero_single_obj_homology (ComplexShape.up ℤ) 0
    (squareZeroKernelModule.{u, u} fS hfS) i hi) (asIso (HomologicalComplex.homologyMap
      ((mapCochainComplex b).map q ≫ kernelComplexBaseChangeMap fR hfR fS hfS a b hcomm) i))

end Deformation.Obstruction
