module

public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksCore.RingTheory.Nakayama
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Flat lifts of an algebra along a nilpotent thickening

Let `A' → A` be a surjection of commutative rings with nilpotent kernel. An `A`-algebra `B`
*has a flat lift to `A'`* if it is the base change to `A` of an `A'`-algebra which is flat as
an `A'`-module. This file compares that lifting problem with the problem of lifting `B` as a
module over a presentation: if `P → B` is a surjection of `A`-algebras and `P` is the base
change of an `A'`-algebra `P'`, then flat algebra lifts of `B` to `A'` and `A'`-flat
`P'`-module lifts of `B` exist together. The second implication is Nakayama's lemma in its
nilpotent form, Stacks 00DV (12).

## Main definitions

* `Deformation.HasFlatAlgebraLift`: `B` is the base change along `A' → A` of an `A'`-algebra
  flat over `A'`.

## Main results

* `Deformation.exists_flatModuleLift_of_algebraLift`: a flat algebra lift of `B`, together
  with a lift `P' → B'` of the presentation, is an `A'`-flat `P'`-module lift of `B`.
* `Deformation.hasFlatAlgebraLift_of_exists_flatModuleLift`: an `A'`-flat `P'`-module lift of
  `B` is generated by one element, so the annihilator of a generator presents a flat algebra
  lift of `B`.
* `Deformation.hasFlatAlgebraLift_iff_exists_flatModuleLift`: the two implications combined,
  for a presentation along which the structure map of `B` lifts.
* `Deformation.hasFlatAlgebraLift_iff_exists_flatModuleLift_of_formallySmooth`: the same
  comparison with no lifting hypothesis, for a formally smooth presentation.
* `Deformation.exists_flatModuleLift_of_hasFlatAlgebraLift`: the first implication alone, for
  a formally smooth presentation.
* `Deformation.hasFlatAlgebraLift_congr`: flat lifts are invariant under isomorphism of the
  algebra being lifted.

## Implementation notes

The commuting square `A' → P'`, `A' → A`, `P' → P`, `A → P` is carried by scalar tower
instances, and the cartesian condition `P = A ⊗_{A'} P'` enters only through the two places
that need it: the kernel identity `ker(P' → P) = ker(A' → A) · P'` for the first implication,
and an isomorphism `A ⊗_{A'} P' ≃ P` for the second.

In the first implication the lift `P' → B'` of the presentation is taken as data rather than
produced: it comes from freeness when `P'` is a polynomial algebra and from adic completeness
when `P'` is a completion, and both uses are needed.

## References

* [Stacks Project, Tag 00DV](https://stacks.math.columbia.edu/tag/00DV)
* [Stacks Project, Tag 0DZ3](https://stacks.math.columbia.edu/tag/0DZ3)
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u

namespace Deformation

/-- `B` has a flat lift to `A'` if it is the base change to `A` of an `A'`-algebra which is
flat as an `A'`-module. -/
def HasFlatAlgebraLift (A' A : Type u) [CommRing A'] [CommRing A] [Algebra A' A]
    (B : Type u) [CommRing B] [Algebra A B] : Prop :=
  ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra A' B'),
    Module.Flat A' B' ∧ Nonempty ((A ⊗[A'] B') ≃ₐ[A] B)

/-! ### The base change of an algebra along a surjection -/

section Surjection

variable (A' A C : Type u) [CommRing A'] [CommRing A] [CommRing C] [Algebra A' A] [Algebra A' C]

/-- For a surjection `A' → A` of commutative rings, every element of `A ⊗_{A'} N` is of the
form `1 ⊗ n`. -/
theorem surjective_one_tmul (hsurjA : Function.Surjective (algebraMap A' A))
    (N : Type u) [AddCommGroup N] [Module A' N] :
    Function.Surjective (fun n : N => (1 : A) ⊗ₜ[A'] n) := by
  intro z
  induction z using TensorProduct.inductionOn with
  | tmul a n =>
      obtain ⟨a', rfl⟩ := hsurjA a
      exact ⟨a' • n, by rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]⟩
  | add z w hz hw =>
      obtain ⟨n, rfl⟩ := hz
      obtain ⟨m, rfl⟩ := hw
      exact ⟨n + m, TensorProduct.tmul_add _ _ _⟩

/-- For a surjection `A' → A` of commutative rings, every element of `N ⊗_{A'} A` is of the
form `n ⊗ 1`. -/
theorem surjective_tmul_one (hsurjA : Function.Surjective (algebraMap A' A))
    (N : Type u) [AddCommGroup N] [Module A' N] :
    Function.Surjective (fun n : N => n ⊗ₜ[A'] (1 : A)) := by
  intro z
  induction z using TensorProduct.inductionOn with
  | tmul n a =>
      obtain ⟨a', rfl⟩ := hsurjA a
      exact ⟨a' • n, by rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul,
        TensorProduct.smul_tmul']⟩
  | add z w hz hw =>
      obtain ⟨n, rfl⟩ := hz
      obtain ⟨m, rfl⟩ := hw
      exact ⟨n + m, TensorProduct.add_tmul _ _ _⟩

/-- For a surjection `A' → A`, the inclusion of the right factor `C → A ⊗_{A'} C` is
surjective. -/
theorem surjective_includeRight (hsurjA : Function.Surjective (algebraMap A' A)) :
    Function.Surjective (Algebra.TensorProduct.includeRight : C →ₐ[A'] A ⊗[A'] C) :=
  surjective_one_tmul A' A hsurjA C

/-- For a surjection `A' → A` with kernel `I`, the kernel of `C → A ⊗_{A'} C` is `I · C`. -/
theorem ker_includeRight (hsurjA : Function.Surjective (algebraMap A' A)) :
    RingHom.ker (Algebra.TensorProduct.includeRight : C →ₐ[A'] A ⊗[A'] C) =
      (RingHom.ker (algebraMap A' A)).map (algebraMap A' C) := by
  set I : Ideal A' := RingHom.ker (algebraMap A' A) with hIdef
  have he : (A' ⧸ RingHom.ker (Algebra.ofId A' A)) ≃ₐ[A'] A :=
    Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId A' A) hsurjA
  have hkereq : RingHom.ker (Algebra.ofId A' A) = I := rfl
  set e : (A' ⧸ I) ≃ₐ[A'] A := (Ideal.quotientEquivAlgOfEq A' hkereq).symm.trans he with hedef
  set Φ : (C ⧸ I.map (algebraMap A' C)) ≃ₗ[A'] A ⊗[A'] C :=
    ((Algebra.TensorProduct.quotIdealMapEquivQuotTensor C I).restrictScalars A').toLinearEquiv
      ≪≫ₗ TensorProduct.congr e.toLinearEquiv (LinearEquiv.refl A' C) with hΦdef
  have hΦmk : ∀ c : C, Φ (Ideal.Quotient.mk _ c) =
      (Algebra.TensorProduct.includeRight : C →ₐ[A'] A ⊗[A'] C) c := by
    intro c
    rw [hΦdef]
    simp only [LinearEquiv.trans_apply, AlgEquiv.toLinearEquiv_apply,
      AlgEquiv.restrictScalars_apply, Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk]
    change (e 1) ⊗ₜ[A'] c = (1 : A) ⊗ₜ[A'] c
    rw [map_one]
  ext c
  rw [RingHom.mem_ker, ← hΦmk, ← Ideal.Quotient.eq_zero_iff_mem]
  exact EmbeddingLike.map_eq_zero_iff

end Surjection

/-- The image of a nilpotent ideal under a ring map is nilpotent. -/
theorem isNilpotent_ideal_map {R S : Type u} [CommRing R] [CommRing S] {I : Ideal R}
    (hI : IsNilpotent I) (f : R →+* S) : IsNilpotent (I.map f) := by
  obtain ⟨k, hk⟩ := hI
  exact ⟨k, by rw [← Ideal.map_pow, hk]; simp⟩

/-- For a surjection `A' → A` with kernel `I` and an `A'`-algebra `C`, the reduction
`C → A ⊗_{A'} C` followed by an isomorphism has kernel `I · C`. -/
theorem ker_comp_includeRight {A' A : Type u} [CommRing A'] [CommRing A] [Algebra A' A]
    (B : Type u) [CommRing B] [Algebra A' B] (C : Type u) [CommRing C] [Algebra A' C]
    (hsurjA : Function.Surjective (algebraMap A' A)) (φ : (A ⊗[A'] C) ≃ₐ[A'] B) :
    RingHom.ker (φ.toAlgHom.comp
        (Algebra.TensorProduct.includeRight : C →ₐ[A'] A ⊗[A'] C)) =
      (RingHom.ker (algebraMap A' A)).map (algebraMap A' C) := by
  rw [← ker_includeRight A' A C hsurjA]
  exact RingHom.ker_comp_of_injective _ φ.injective

/-! ### From an algebra lift to a module lift -/

section Bridge

variable {A' A P' P B : Type u}
  [CommRing A'] [CommRing A] [CommRing P'] [CommRing P] [CommRing B]
  [Algebra A' A] [Algebra A' P'] [Algebra A' B]
  [Algebra A P] [Algebra A B] [Algebra P' P] [Algebra P' B] [Algebra P B]
  [IsScalarTower A' A B] [IsScalarTower A' P' B] [IsScalarTower A P B]
  [IsScalarTower P' P B]

/-- For a surjection `P' → P` with kernel `J`, the induced isomorphism `P' ⧸ J ≃ P`. -/
def quotKerAlgEquiv (hsurjP : Function.Surjective (algebraMap P' P)) :
    (P' ⧸ RingHom.ker (algebraMap P' P)) ≃ₐ[P'] P :=
  Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId P' P) hsurjP

@[simp]
theorem quotKerAlgEquiv_mk (hsurjP : Function.Surjective (algebraMap P' P)) (x : P') :
    quotKerAlgEquiv hsurjP (Submodule.Quotient.mk x) = algebraMap P' P x := rfl

/-- Base change of a `P'`-module along a surjection `P' → P` with kernel `J` is the quotient
by `J`. -/
def quotKerSMulTopEquivBaseChange (hsurjP : Function.Surjective (algebraMap P' P))
    (N : Type u) [AddCommGroup N] [Module P' N] :
    (N ⧸ ((RingHom.ker (algebraMap P' P)) • (⊤ : Submodule P' N))) ≃ₗ[P'] P ⊗[P'] N :=
  (TensorProduct.quotTensorEquivQuotSMul N (RingHom.ker (algebraMap P' P))).symm ≪≫ₗ
    TensorProduct.congr (quotKerAlgEquiv hsurjP).toLinearEquiv (LinearEquiv.refl P' N)

@[simp]
theorem quotKerSMulTopEquivBaseChange_mk (hsurjP : Function.Surjective (algebraMap P' P))
    (N : Type u) [AddCommGroup N] [Module P' N] (n : N) :
    quotKerSMulTopEquivBaseChange hsurjP N (Submodule.Quotient.mk n) = (1 : P) ⊗ₜ[P'] n := by
  have h := LinearMap.congr_fun
    (TensorProduct.quotTensorEquivQuotSMul_comp_mkQ_rTensor
      (R := P') (M := N) (RingHom.ker (algebraMap P' P))) ((1 : P') ⊗ₜ[P'] n)
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.rTensor_tmul,
    Submodule.mkQ_apply, LinearEquiv.coe_coe, TensorProduct.lid_tmul, one_smul] at h
  have h2 : (TensorProduct.quotTensorEquivQuotSMul N (RingHom.ker (algebraMap P' P))).symm
      (Submodule.Quotient.mk n) = (Submodule.Quotient.mk (1 : P')) ⊗ₜ[P'] n := by
    rw [← h, LinearEquiv.symm_apply_apply]
  rw [quotKerSMulTopEquivBaseChange, LinearEquiv.trans_apply, h2, TensorProduct.congr_tmul,
    LinearEquiv.refl_apply, AlgEquiv.toLinearEquiv_apply, quotKerAlgEquiv_mk, map_one]

omit [Algebra A P] [IsScalarTower A' P' B] [IsScalarTower A P B] in
/-- **The first implication in the comparison of Stacks 0DZ3.** Let `A' → A` be a surjection
with kernel `I`, let `P' → P` be a surjection with kernel `I · P'` over it, and let `B` be a
`P`-algebra. If `B'` is an `A'`-flat lift of `B` and the structure map of `B` lifts to an
`A'`-algebra map `P' → B'`, then `B'` is an `A'`-flat `P'`-module lift of `B`. -/
theorem exists_flatModuleLift_of_algebraLift
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hsurjP : Function.Surjective (algebraMap P' P))
    (hkerP : RingHom.ker (algebraMap P' P) =
      (RingHom.ker (algebraMap A' A)).map (algebraMap A' P'))
    (B' : Type u) [CommRing B'] [Algebra A' B'] (hflatB' : Module.Flat A' B')
    (eB : (A ⊗[A'] B') ≃ₐ[A] B) (g : P' →ₐ[A'] B')
    (hg : ∀ x : P', eB (1 ⊗ₜ[A'] (g x)) = algebraMap P' B x) :
    ∃ (N : Type u) (_ : AddCommGroup N) (_ : Module P' N) (_ : Module A' N)
      (_ : IsScalarTower A' P' N), Module.Flat A' N ∧ Nonempty ((P ⊗[P'] N) ≃ₗ[P] B) := by
  classical
  let : Algebra P' B' := g.toRingHom.toAlgebra
  have : IsScalarTower A' P' B' :=
    IsScalarTower.of_algebraMap_eq fun x => (g.commutes x).symm
  have hgmap : ∀ x : P', algebraMap P' B' x = g x := fun _ => rfl
  set I : Ideal A' := RingHom.ker (algebraMap A' A) with hIdef
  set J : Ideal P' := RingHom.ker (algebraMap P' P) with hJdef
  set β₀ : B' →ₐ[A'] B :=
    ((eB.restrictScalars A').toAlgHom).comp Algebra.TensorProduct.includeRight with hβ₀def
  have hβ₀ : ∀ b : B', β₀ b = eB (1 ⊗ₜ[A'] b) := fun _ => rfl
  set βₐ : B' →ₐ[P'] B := ⟨β₀.toRingHom, fun x => by
    change β₀ (g x) = algebraMap P' B x
    rw [hβ₀]
    exact hg x⟩ with hβdef
  have hβ : ∀ b : B', βₐ b = eB (1 ⊗ₜ[A'] b) := fun _ => rfl
  -- the kernel of the reduction `B' → B` is `I · B'`
  have hβker : RingHom.ker βₐ = I.map (algebraMap A' B') :=
    ker_comp_includeRight B B' hsurjA (eB.restrictScalars A')
  -- it is also `ker(P' → P) · B'`
  have hJB : J.map (algebraMap P' B') = RingHom.ker βₐ := by
    rw [hβker, hkerP, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  -- the three isomorphisms
  have e₁ : (B' ⧸ J.map (algebraMap P' B')) ≃ₐ[P'] (P' ⧸ J) ⊗[P'] B' :=
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B' J).restrictScalars P'
  have e₂ : ((P' ⧸ J) ⊗[P'] B') ≃ₗ[P'] P ⊗[P'] B' :=
    TensorProduct.congr (quotKerAlgEquiv hsurjP).toLinearEquiv (LinearEquiv.refl P' B')
  have e₃ : (B' ⧸ J.map (algebraMap P' B')) ≃ₐ[P'] B :=
    (Ideal.quotientEquivAlgOfEq P' hJB).trans
      (Ideal.quotientKerAlgEquivOfSurjective (f := βₐ)
        ((eB.restrictScalars A').surjective.comp (surjective_includeRight A' A B' hsurjA)))
  have efin : (P ⊗[P'] B') ≃ₗ[P'] B :=
    e₂.symm ≪≫ₗ e₁.toLinearEquiv.symm ≪≫ₗ e₃.toLinearEquiv
  exact ⟨B', inferInstance, inferInstance, inferInstance, inferInstance, hflatB',
    ⟨LinearEquiv.extendScalarsOfSurjective hsurjP efin⟩⟩

omit [Algebra A' B] [IsScalarTower A' A B] [IsScalarTower A' P' B] in
/-- **The second implication in the comparison of Stacks 0DZ3.** Let `A' → A` be a
surjection, let `P' → P` be a surjection with nilpotent kernel over it with `P = A ⊗_{A'} P'`,
and let `P → B` be a surjection of `A`-algebras. An `A'`-flat `P'`-module lift of `B` is
generated by one element, and the quotient of `P'` by the annihilator of a generator is a flat
algebra lift of `B`. -/
theorem hasFlatAlgebraLift_of_exists_flatModuleLift
    (hsurjP : Function.Surjective (algebraMap P' P))
    (hnilP : IsNilpotent (RingHom.ker (algebraMap P' P)))
    (hsurjB : Function.Surjective (algebraMap P B))
    (ePP : (A ⊗[A'] P') ≃ₐ[A] P)
    (hePP : ∀ x : P', ePP (1 ⊗ₜ[A'] x) = algebraMap P' P x)
    (h : ∃ (N : Type u) (_ : AddCommGroup N) (_ : Module P' N) (_ : Module A' N)
      (_ : IsScalarTower A' P' N), Module.Flat A' N ∧ Nonempty ((P ⊗[P'] N) ≃ₗ[P] B)) :
    HasFlatAlgebraLift A' A B := by
  classical
  obtain ⟨N, _, _, _, _, hflatN, ⟨e⟩⟩ := h
  set J : Ideal P' := RingHom.ker (algebraMap P' P) with hJdef
  have hsurjPB : Function.Surjective (algebraMap P' B) := by
    rw [IsScalarTower.algebraMap_eq P' P B]
    exact hsurjB.comp hsurjP
  obtain ⟨n₀, hn₀⟩ : ∃ n₀ : N, e ((1 : P) ⊗ₜ[P'] n₀) = 1 := by
    obtain ⟨z, hz⟩ := e.surjective (1 : B)
    obtain ⟨n₀, rfl⟩ := surjective_one_tmul P' P hsurjP N z
    exact ⟨n₀, hz⟩
  set φ : P' →ₗ[P'] N := LinearMap.toSpanSingleton P' N n₀ with hφdef
  have hφ : ∀ x : P', φ x = x • n₀ := fun _ => rfl
  have htmul : ∀ x : P', (1 : P) ⊗ₜ[P'] (φ x) = (algebraMap P' P x) • ((1 : P) ⊗ₜ[P'] n₀) := by
    intro x
    rw [hφ, ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul',
      IsScalarTower.algebraMap_smul P]
  have hkey : ∀ x : P', e ((1 : P) ⊗ₜ[P'] (φ x)) = algebraMap P' B x := by
    intro x
    rw [htmul, map_smul, hn₀, Algebra.smul_def, mul_one,
      ← IsScalarTower.algebraMap_apply P' P B]
  -- the kernel of `N → P ⊗[P'] N` is `J · N`
  have hmem : ∀ n : N, (1 : P) ⊗ₜ[P'] n = 0 ↔ n ∈ J • (⊤ : Submodule P' N) := by
    intro n
    rw [← Submodule.Quotient.mk_eq_zero (J • (⊤ : Submodule P' N)),
      ← quotKerSMulTopEquivBaseChange_mk hsurjP N n]
    exact EmbeddingLike.map_eq_zero_iff
  -- `n₀` generates `N`, by Nakayama
  have hspan : Submodule.span P' ({n₀} : Set N) = ⊤ := by
    refine Submodule.span_eq_top_of_span_image_mkQ_eq_top_of_isNilpotent J hnilP {n₀} ?_
    rw [Set.image_singleton, eq_top_iff]
    intro y _
    obtain ⟨n, rfl⟩ := (J • (⊤ : Submodule P' N)).mkQ_surjective y
    obtain ⟨x, hx⟩ := hsurjPB (e ((1 : P) ⊗ₜ[P'] n))
    have hdiff : n - φ x ∈ J • (⊤ : Submodule P' N) := by
      refine (hmem _).mp (e.injective ?_)
      rw [TensorProduct.tmul_sub, map_sub, hkey, hx, sub_self, map_zero]
    have h1 : (J • (⊤ : Submodule P' N)).mkQ n = (J • (⊤ : Submodule P' N)).mkQ (φ x) := by
      rw [← sub_eq_zero, ← map_sub, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero (J • (⊤ : Submodule P' N))]
      exact hdiff
    rw [Submodule.mkQ_apply] at h1 ⊢
    rw [h1, hφ, ← Submodule.mkQ_apply, map_smul]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  have hφsurj : Function.Surjective φ := by
    rw [← LinearMap.range_eq_top, hφdef, ← LinearMap.span_singleton_eq_range]
    exact hspan
  -- the flat algebra lift
  set J' : Ideal P' := LinearMap.ker φ with hJ'def
  have eN : (P' ⧸ J') ≃ₗ[P'] N := φ.quotKerEquivOfSurjective hφsurj
  have hflat : Module.Flat A' (P' ⧸ J') := Module.Flat.of_linearEquiv (eN.restrictScalars A')
  -- the kernel of `P' → B`
  have hzero : ∀ x : P', algebraMap P' B x = 0 ↔ (1 : P) ⊗ₜ[P'] (φ x) = 0 := by
    intro x
    rw [← hkey]
    exact EmbeddingLike.map_eq_zero_iff
  have hkerP'B : RingHom.ker (algebraMap P' B) = J ⊔ J' := by
    have hJtop : J • (⊤ : Submodule P' P') = J := by
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hmapφ : Submodule.map φ J = J • (⊤ : Submodule P' N) := by
      conv_lhs => rw [← hJtop]
      rw [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hφsurj]
    ext x
    rw [RingHom.mem_ker, hzero, hmem, ← hmapφ, ← Submodule.mem_comap,
      Submodule.comap_map_eq, ← hJ'def]
  have hkerPB : RingHom.ker (algebraMap P B) = J'.map (algebraMap P' P) := by
    rw [← Ideal.map_comap_of_surjective _ hsurjP (RingHom.ker (algebraMap P B)),
      RingHom.comap_ker, ← IsScalarTower.algebraMap_eq, hkerP'B, Ideal.map_sup,
      (Ideal.map_eq_bot_iff_le_ker _).mpr (le_of_eq hJdef), bot_sup_eq]
  -- the three isomorphisms
  have E1 : (A ⊗[A'] (P' ⧸ J')) ≃ₐ[A]
      ((A ⊗[A'] P') ⧸ J'.map (Algebra.TensorProduct.includeRight : P' →ₐ[A'] A ⊗[A'] P')) :=
    Algebra.TensorProduct.tensorQuotientEquiv A P' A J'
  have hcomp : ∀ x : P', (ePP : (A ⊗[A'] P') →+* P)
      ((Algebra.TensorProduct.includeRight : P' →ₐ[A'] A ⊗[A'] P') x) = algebraMap P' P x :=
    fun x => hePP x
  have hmapideal : J'.map (algebraMap P' P) =
      Ideal.map (ePP : (A ⊗[A'] P') →+* P)
        (J'.map (Algebra.TensorProduct.includeRight : P' →ₐ[A'] A ⊗[A'] P')) := by
    refine le_antisymm ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, ← hcomp x]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hx)
    · rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_comap, hcomp x]
      exact Ideal.mem_map_of_mem _ hx
  have E2 : ((A ⊗[A'] P') ⧸
        J'.map (Algebra.TensorProduct.includeRight : P' →ₐ[A'] A ⊗[A'] P')) ≃ₐ[A]
      (P ⧸ J'.map (algebraMap P' P)) :=
    Ideal.quotientEquivAlg _ _ ePP hmapideal
  have E3 : (P ⧸ J'.map (algebraMap P' P)) ≃ₐ[A] B :=
    (Ideal.quotientEquivAlgOfEq A hkerPB.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective (f := IsScalarTower.toAlgHom A P B) hsurjB)
  exact ⟨P' ⧸ J', inferInstance, inferInstance, hflat, ⟨E1.trans (E2.trans E3)⟩⟩

omit [IsScalarTower A' P' B] in
/-- **The comparison at the heart of Stacks 0DZ3.** Let `A' → A` be a surjection with kernel
`I`, let `P' → P` be a surjection with nilpotent kernel `I · P'` over it with
`P = A ⊗_{A'} P'`, and let `P → B` be a surjection of `A`-algebras. If the structure map of `B`
lifts along `P'` to every flat algebra lift of `B`, then `B` has a flat lift to `A'` if and only
if `B` has an `A'`-flat `P'`-module lift. -/
theorem hasFlatAlgebraLift_iff_exists_flatModuleLift
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hsurjP : Function.Surjective (algebraMap P' P))
    (hnilP : IsNilpotent (RingHom.ker (algebraMap P' P)))
    (hkerP : RingHom.ker (algebraMap P' P) =
      (RingHom.ker (algebraMap A' A)).map (algebraMap A' P'))
    (hsurjB : Function.Surjective (algebraMap P B))
    (ePP : (A ⊗[A'] P') ≃ₐ[A] P)
    (hePP : ∀ x : P', ePP (1 ⊗ₜ[A'] x) = algebraMap P' P x)
    (hlift : ∀ (B' : Type u) (_ : CommRing B') (_ : Algebra A' B'), Module.Flat A' B' →
      ∀ eB : (A ⊗[A'] B') ≃ₐ[A] B, ∃ g : P' →ₐ[A'] B',
        ∀ x : P', eB (1 ⊗ₜ[A'] (g x)) = algebraMap P' B x) :
    HasFlatAlgebraLift A' A B ↔
      ∃ (N : Type u) (_ : AddCommGroup N) (_ : Module P' N) (_ : Module A' N)
        (_ : IsScalarTower A' P' N), Module.Flat A' N ∧ Nonempty ((P ⊗[P'] N) ≃ₗ[P] B) := by
  refine ⟨fun h => ?_, hasFlatAlgebraLift_of_exists_flatModuleLift hsurjP hnilP hsurjB ePP hePP⟩
  obtain ⟨B', _, _, hflatB', ⟨eB⟩⟩ := h
  obtain ⟨g, hg⟩ := hlift B' inferInstance inferInstance hflatB' eB
  exact exists_flatModuleLift_of_algebraLift hsurjA hsurjP hkerP B' hflatB' eB g hg

/-- For `P'` formally smooth over `A'`, the structure map of `B` lifts along `P'` to any flat
algebra lift of `B`: such a lift is a nilpotent thickening of `B`, so the lift exists by formal
smoothness. -/
@[ega "0 22.6.9" "partial"]
theorem exists_algHom_of_formallySmooth [Algebra.FormallySmooth A' P']
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hnilA : IsNilpotent (RingHom.ker (algebraMap A' A)))
    (B' : Type u) [CommRing B'] [Algebra A' B'] (eB : (A ⊗[A'] B') ≃ₐ[A] B) :
    ∃ g : P' →ₐ[A'] B', ∀ x : P', eB (1 ⊗ₜ[A'] (g x)) = algebraMap P' B x := by
  set β₀ : B' →ₐ[A'] B :=
    ((eB.restrictScalars A').toAlgHom).comp Algebra.TensorProduct.includeRight with hβ₀def
  have hβ₀ : ∀ b : B', β₀ b = eB (1 ⊗ₜ[A'] b) := fun _ => rfl
  have hβsurj : Function.Surjective β₀ :=
    (eB.restrictScalars A').surjective.comp (surjective_includeRight A' A B' hsurjA)
  have hβker : RingHom.ker β₀ = (RingHom.ker (algebraMap A' A)).map (algebraMap A' B') :=
    ker_comp_includeRight B B' hsurjA (eB.restrictScalars A')
  have hnilβ : IsNilpotent (RingHom.ker β₀) := by
    rw [hβker]
    exact isNilpotent_ideal_map hnilA _
  set e₃ : (B' ⧸ RingHom.ker β₀) ≃ₐ[A'] B :=
    Ideal.quotientKerAlgEquivOfSurjective hβsurj with he₃def
  have he₃ : ∀ b : B', e₃ (Ideal.Quotient.mk (RingHom.ker β₀) b) = β₀ b := fun _ => rfl
  set g₀ : P' →ₐ[A'] (B' ⧸ RingHom.ker β₀) :=
    e₃.symm.toAlgHom.comp (IsScalarTower.toAlgHom A' P' B) with hg₀def
  refine ⟨Algebra.FormallySmooth.lift (RingHom.ker β₀) hnilβ g₀, fun x => ?_⟩
  rw [← hβ₀, ← he₃, Algebra.FormallySmooth.mk_lift (RingHom.ker β₀) hnilβ g₀ x, hg₀def]
  change e₃ (e₃.symm (algebraMap P' B x)) = algebraMap P' B x
  rw [e₃.apply_symm_apply]

omit [Algebra A P] [IsScalarTower A P B] in
/-- **The first implication of Stacks 0DZ3's comparison, along a formally smooth presentation.**
A flat algebra lift of `B` is an `A'`-flat `P'`-module lift of `B`, with no lifting hypothesis:
the structure map of `B` lifts along a formally smooth `P'`. -/
theorem exists_flatModuleLift_of_hasFlatAlgebraLift [Algebra.FormallySmooth A' P']
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hnilA : IsNilpotent (RingHom.ker (algebraMap A' A)))
    (hsurjP : Function.Surjective (algebraMap P' P))
    (hkerP : RingHom.ker (algebraMap P' P) =
      (RingHom.ker (algebraMap A' A)).map (algebraMap A' P'))
    (h : HasFlatAlgebraLift A' A B) :
    ∃ (N : Type u) (_ : AddCommGroup N) (_ : Module P' N) (_ : Module A' N)
      (_ : IsScalarTower A' P' N), Module.Flat A' N ∧ Nonempty ((P ⊗[P'] N) ≃ₗ[P] B) := by
  obtain ⟨B', _, _, hflatB', ⟨eB⟩⟩ := h
  obtain ⟨g, hg⟩ := exists_algHom_of_formallySmooth (P' := P') hsurjA hnilA B' eB
  exact exists_flatModuleLift_of_algebraLift hsurjA hsurjP hkerP B' hflatB' eB g hg

/-- **The comparison at the heart of Stacks 0DZ3, along a formally smooth presentation.** Let
`A' → A` be a surjection with nilpotent kernel `I`, let `P' → P` be a surjection with kernel
`I · P'` over it with `P = A ⊗_{A'} P'`, and let `P → B` be a surjection of `A`-algebras. If
`P'` is formally smooth over `A'`, then `B` has a flat lift to `A'` if and only if `B` has an
`A'`-flat `P'`-module lift. -/
theorem hasFlatAlgebraLift_iff_exists_flatModuleLift_of_formallySmooth
    [Algebra.FormallySmooth A' P']
    (hsurjA : Function.Surjective (algebraMap A' A))
    (hnilA : IsNilpotent (RingHom.ker (algebraMap A' A)))
    (hsurjP : Function.Surjective (algebraMap P' P))
    (hkerP : RingHom.ker (algebraMap P' P) =
      (RingHom.ker (algebraMap A' A)).map (algebraMap A' P'))
    (hsurjB : Function.Surjective (algebraMap P B))
    (ePP : (A ⊗[A'] P') ≃ₐ[A] P)
    (hePP : ∀ x : P', ePP (1 ⊗ₜ[A'] x) = algebraMap P' P x) :
    HasFlatAlgebraLift A' A B ↔
      ∃ (N : Type u) (_ : AddCommGroup N) (_ : Module P' N) (_ : Module A' N)
        (_ : IsScalarTower A' P' N), Module.Flat A' N ∧ Nonempty ((P ⊗[P'] N) ≃ₗ[P] B) := by
  have hnilP : IsNilpotent (RingHom.ker (algebraMap P' P)) := by
    rw [hkerP]
    exact isNilpotent_ideal_map hnilA _
  refine hasFlatAlgebraLift_iff_exists_flatModuleLift hsurjA hsurjP hnilP hkerP hsurjB ePP hePP
    (fun B' _ _ _ eB => ?_)
  exact exists_algHom_of_formallySmooth (P' := P') hsurjA hnilA B' eB

/-- A flat lift of `B` is a flat lift of any `A`-algebra isomorphic to `B`. -/
theorem hasFlatAlgebraLift_congr {A' A B C : Type u} [CommRing A'] [CommRing A] [CommRing B]
    [CommRing C] [Algebra A' A] [Algebra A B] [Algebra A C] (e : B ≃ₐ[A] C) :
    HasFlatAlgebraLift A' A B ↔ HasFlatAlgebraLift A' A C := by
  constructor
  · rintro ⟨B', _, _, hflat, ⟨eB⟩⟩
    exact ⟨B', inferInstance, inferInstance, hflat, ⟨eB.trans e⟩⟩
  · rintro ⟨C', _, _, hflat, ⟨eC⟩⟩
    exact ⟨C', inferInstance, inferInstance, hflat, ⟨eC.trans e.symm⟩⟩

end Bridge

