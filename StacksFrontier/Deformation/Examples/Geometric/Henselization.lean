module

public import Mathlib.CategoryTheory.FiberedCategory.BasedCategory
public import Mathlib.RingTheory.Artinian.Ring
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Deformation.Examples.Geometric.Localization
public import StacksFrontier.RingTheory.Artinian.TFAE
public import StacksFrontier.RingTheory.Henselian.Pair.HenselizationLift

/-!
# Henselization of deformations of an algebra

Let `P` be a `k`-algebra and `J ⊆ P` an ideal. Henselizing a deformation of `P` at the inverse
image of `J` produces a deformation of the henselization of the pair `(P, J)` over the same
Artinian base, and this construction is a functor over `𝒞_Λ` from the deformation category of
`P` to that of `Pʰ`.

The flat algebra `Q` of a deformation is flat over its Artinian base and the henselization of
`(Q, J·Q)` is flat over `Q`, so the henselized flat algebra is again flat over the base. That
it is again *cartesian* over `(k, Pʰ)` is the compatibility of henselization with integral base
change (Stacks 0DYE): the map `Q → P` to the special fibre is surjective, hence integral, and
`J` and the image of its inverse image cut out the same closed subset, so `Qʰ ⊗_Q P → Pʰ` is
bijective. On morphisms of deformations the same argument applies, the base change there being
integral because a morphism of Artinian local algebras with residue field `k` is integral and
integrality passes to a pushout; the two inverse images of `J` differ by a nilpotent ideal,
which is what makes the two closed subsets agree.

## Main definitions

* `Deformation.Examples.henselizationAlgebra`: the `k`-algebra structure on the henselization
  of a pair of `k`-algebras.
* `Deformation.Examples.HenselizationFunctorData`: a functor of deformation categories over
  `𝒞_Λ` together with the data exhibiting it as henselization.

## Main results

* `Deformation.Examples.nonempty_henselizationFunctorData`: henselization at the inverse image
  of `J` is such a functor.
* `Deformation.Examples.henselizationFunctor`: the henselization functor itself.

## Implementation notes

As for localization and completion, the functor is packaged with its comparison data rather
than stated bare, because the source's assertion is not just that some functor exists but that
it henselizes: the recorded data says that the map out of each flat algebra identifies the
henselization of `(Q, J·Q)` with the value of the functor, that it is a map of algebras over
the common Artinian base, that it is compatible with reduction to the special fibre, and that
it is natural in morphisms of deformations. The base-compatibility clause has to transport the
base along the equality of Artinian bases supplied by the based functor, which is what the
`cast` expresses.

The `k`-algebra structure on `Pʰ` is composed from `k → P → Pʰ` and is used as a local
instance only; it is not a global one, because it would compete with the structure map of the
henselization whenever the base field and the algebra coincide.

## References

* [Stacks Project, Tag 0DYT](https://stacks.math.columbia.edu/tag/0DYT)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u w

namespace Deformation.Examples

/-- The `k`-algebra structure on the henselization of the pair `(P, J)`, for `P` a
`k`-algebra: the composite of `k → P` with the structure map of the henselization. -/
@[instance_reducible]
noncomputable def henselizationAlgebra {k P : Type w} [CommRing k] [CommRing P] [Algebra k P]
    (J : Ideal P) : Algebra k (henselization P J : Type w) :=
  ((algebraMap P (henselization P J : Type w)).comp (algebraMap k P)).toAlgebra

attribute [local instance 100] henselizationAlgebra

variable {Λ : Type u} {k P : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
  [CommRing P] [Algebra k P]

/-- Every element of the kernel of the map from a deformation to its special fibre is
nilpotent: the kernel lies in the ideal generated by the maximal ideal of the Artinian base,
and that ideal is nilpotent. -/
private theorem isNilpotent_of_mem_ker_deformationSpecialFiberMap
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) {q : X.left.fiber}
    (hq : q ∈ RingHom.ker X.hom.map.hom) : IsNilpotent q := by
  obtain ⟨n, hn⟩ := (isArtinianRing_iff_isNilpotent_maximalIdeal X.left.base).mp inferInstance
  have hmem := deformationSpecialFiber_ker_le_map_maximalIdeal X hq
  have hpow : (Ideal.map (algebraMap X.left.base X.left.fiber)
      (IsLocalRing.maximalIdeal X.left.base)) ^ n = 0 := by
    rw [← Ideal.map_pow, hn]
    simp
  exact ⟨n, Ideal.pow_eq_zero_of_mem hpow le_rfl hmem⟩

/-- A morphism of Artinian local `Λ`-algebras with residue field `k` is integral: an element
of the target agrees with the image of an element of the source modulo the maximal ideal, and
the difference is nilpotent. -/
private theorem isIntegral_of_artinianBaseHom
    {A B : ArtinianLocalAlgCat.{u, w, w} Λ k} (f : A ⟶ B) :
    letI : Algebra A B := f.hom.toRingHom.toAlgebra
    Algebra.IsIntegral A B := by
  let : Algebra A B := f.hom.toRingHom.toAlgebra
  refine ⟨?_⟩
  intro b
  obtain ⟨r, hr⟩ := A.residueEquiv.surjective (B.residueEquiv (IsLocalRing.residue B b))
  obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective (R := A) r
  have heq : B.residueEquiv (IsLocalRing.residue B (f.hom a)) =
      B.residueEquiv (IsLocalRing.residue B b) := by
    rw [f.residue_comm a, ha, hr]
  have hres := B.residueEquiv.injective heq
  have hmem : b - f.hom a ∈ IsLocalRing.maximalIdeal B := by
    rw [← IsLocalRing.residue_eq_zero_iff]
    simp [map_sub, hres]
  obtain ⟨n, hn⟩ := (isArtinianRing_iff_isNilpotent_maximalIdeal B).mp inferInstance
  have hpow : (b - f.hom a) ^ n = 0 := by
    have hm := Ideal.pow_mem_pow hmem n
    rw [hn] at hm
    simpa using hm
  have hpow' : (b - f.hom a) ^ (n + 1) = 0 := by
    rw [pow_succ, hpow]
    simp
  have hInt : IsIntegral A (b - f.hom a) :=
    IsIntegral.of_pow (Nat.succ_pos n) (hpow' ▸ isIntegral_zero)
  have hsum := (isIntegral_algebraMap (R := A) (A := B) (x := a)).add hInt
  have hmap : algebraMap A B a = f.hom a := rfl
  rw [hmap] at hsum
  simpa [sub_eq_add_neg, add_assoc, add_comm, add_left_comm] using hsum

/-- The henselization of a pair is flat over any base the ring is flat over: the henselization
is ind-étale, hence flat, and flatness composes along the tower. -/
private theorem flat_henselization_of_flat {A Q : Type w} [CommRing A] [CommRing Q]
    [Algebra A Q] [Module.Flat A Q] (I : Ideal Q) [Algebra A (henselization Q I : Type w)]
    [IsScalarTower A Q (henselization Q I : Type w)] :
    Module.Flat A (henselization Q I : Type w) := by
  let : Module.Flat Q (henselization Q I : Type w) :=
    CommAlgCat.flat_of_ind_etale (ind_henselization Q I)
  exact Module.Flat.trans A Q (henselization Q I : Type w)

/-- The map of henselizations induced by a ring map carrying `I` into `K`. -/
private noncomputable def henselizationMapOfLE {Q R : Type w} [CommRing Q] [CommRing R]
    (f : Q →+* R) (I : Ideal Q) (K : Ideal R) (h : I ≤ K.comap f) :
    (henselization Q I : Type w) →+* (henselization R K : Type w) :=
  letI : Algebra Q (henselization R K : Type w) := ((algebraMap R _).comp f).toAlgebra
  (henselizationLift Q I (K.map (algebraMap R (henselization R K : Type w)))
    (henselianPair_henselization R K) fun _ hq => Ideal.mem_map_of_mem _ (h hq)).toRingHom

/-- The map of henselizations restricts to the underlying ring map on the structure maps. -/
private theorem henselizationMapOfLE_algebraMap {Q R : Type w} [CommRing Q] [CommRing R]
    (f : Q →+* R) (I : Ideal Q) (K : Ideal R) (h : I ≤ K.comap f) (q : Q) :
    henselizationMapOfLE f I K h (algebraMap Q (henselization Q I : Type w) q) =
      algebraMap R (henselization R K : Type w) (f q) :=
  letI : Algebra Q (henselization R K : Type w) := ((algebraMap R _).comp f).toAlgebra
  (henselizationLift Q I (K.map (algebraMap R (henselization R K : Type w)))
    (henselianPair_henselization R K) fun _ hq => Ideal.mem_map_of_mem _ (h hq)).commutes q

/-- Henselization takes the identity ring map to the identity. -/
private theorem henselizationMapOfLE_id {Q : Type w} [CommRing Q] (I : Ideal Q)
    (h : I ≤ I.comap (RingHom.id Q)) :
    henselizationMapOfLE (RingHom.id Q) I I h = RingHom.id (henselization Q I : Type w) := by
  let H := (henselization Q I : Type w)
  let targetAlg : Algebra Q H := ((algebraMap Q H).comp (RingHom.id Q)).toAlgebra
  let : Algebra Q H := targetAlg
  let sourceAlg : Algebra Q (henselization Q I : Type w) :=
    CommAlgCat.instAlgebraObjForgetAlgHomCarrier
  have hmaps (q : Q) :
      (@algebraMap Q (henselization Q I : Type w) _ _ sourceAlg) q =
        (@algebraMap Q H _ _ targetAlg) q := rfl
  let g : @AlgHom Q (henselization Q I : Type w) H _ _ _ sourceAlg targetAlg :=
    @AlgHom.mk Q (henselization Q I : Type w) H _ _ _ sourceAlg targetAlg (RingHom.id H) hmaps
  have hI : I ≤ (I.map (algebraMap Q H)).comap (algebraMap Q H) :=
    fun q hq => Ideal.mem_map_of_mem _ hq
  have huniq := @henselizationLift_unique Q H _ _ targetAlg I (I.map (algebraMap Q H))
    (henselianPair_henselization Q I) hI g
  have hring := congrArg
    (fun h : @AlgHom Q (henselization Q I : Type w) H _ _ _ sourceAlg targetAlg =>
      @AlgHom.toRingHom Q (henselization Q I : Type w) H _ _ _ sourceAlg targetAlg h)
    huniq.symm
  simpa [henselizationMapOfLE, g] using hring

/-- Henselization is compatible with composition of ring maps. -/
private theorem henselizationMapOfLE_comp {Q R S : Type w} [CommRing Q] [CommRing R]
    [CommRing S] (f : Q →+* R) (g : R →+* S) (k : Q →+* S) (hk : g.comp f = k)
    (I : Ideal Q) (K : Ideal R) (L : Ideal S) (hIK : I ≤ K.comap f) (hKL : K ≤ L.comap g)
    (hIL : I ≤ L.comap k) :
    (henselizationMapOfLE g K L hKL).comp (henselizationMapOfLE f I K hIK) =
      henselizationMapOfLE k I L hIL := by
  subst hk
  let : Algebra Q R := f.toAlgebra
  let : Algebra R S := g.toAlgebra
  let : Algebra Q S := (g.comp f).toAlgebra
  let : Algebra Q (henselization R K : Type w) := ((algebraMap R _).comp f).toAlgebra
  let : Algebra R (henselization S L : Type w) := ((algebraMap S _).comp g).toAlgebra
  let : Algebra Q (henselization S L : Type w) := ((algebraMap S _).comp (g.comp f)).toAlgebra
  let : IsScalarTower Q R (henselization R K : Type w) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower Q R (henselization S L : Type w) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  let u : (henselization Q I : Type w) →ₐ[Q] (henselization R K : Type w) :=
    henselizationLift Q I (K.map (algebraMap R (henselization R K : Type w)))
      (henselianPair_henselization R K) fun _ hq => Ideal.mem_map_of_mem _ (hIK hq)
  let v : (henselization R K : Type w) →ₐ[Q] (henselization S L : Type w) :=
    (henselizationLift R K (L.map (algebraMap S (henselization S L : Type w)))
      (henselianPair_henselization S L)
      fun _ hr => Ideal.mem_map_of_mem _ (hKL hr)).restrictScalars Q
  exact congrArg AlgHom.toRingHom (henselizationLift_unique Q I
    (L.map (algebraMap S (henselization S L : Type w))) (henselianPair_henselization S L)
    (fun _ hq => Ideal.mem_map_of_mem _ (hIL hq)) (v.comp u))

/-- A morphism of deformations commutes with the maps to the special fibre. -/
private theorem hom_map_comp_eq {X Y : ringDeformationCategory (Λ := Λ) (k := k) P}
    (f : X ⟶ Y) : Y.hom.map.hom.comp f.left.map.hom = X.hom.map.hom :=
  congrArg (fun e : X.left ⟶ residueFieldAlgebra (Λ := Λ) (k := k) P => e.map.hom) f.w

/-- The inverse images of `J` in the fibres of two deformations are compatible along a
morphism. -/
private theorem comap_le_comap_of_hom (J : Ideal P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (f : X ⟶ Y) :
    J.comap X.hom.map.hom ≤ (J.comap Y.hom.map.hom).comap f.left.map.hom := by
  intro q hq
  change Y.hom.map.hom (f.left.map.hom q) ∈ J
  rw [← RingHom.comp_apply, hom_map_comp_eq]
  exact hq

/-- Base change along a pushout square of rings: if `f : Q → R` is integral (because `b` is, or
because `f` is surjective) and `K` and `I·R` have the same zero locus, then henselizing `Q`
along `I` and `R` along `K` gives a pushout square again. -/
private theorem isPushout_henselizationMapOfLE {A B Q R : Type w} [CommRing A] [CommRing B]
    [CommRing Q] [CommRing R] (a : A →+* Q) (b : A →+* B) (f : Q →+* R) (c : B →+* R)
    (hcart : IsPushout (CommRingCat.ofHom a) (CommRingCat.ofHom b) (CommRingCat.ofHom f)
      (CommRingCat.ofHom c))
    (hint : b.IsIntegral ∨ Function.Surjective f) (I : Ideal Q) (K : Ideal R)
    (hIK : I ≤ K.comap f)
    (hzero : PrimeSpectrum.zeroLocus (K : Set R) = PrimeSpectrum.zeroLocus (I.map f : Set R)) :
    IsPushout (CommRingCat.ofHom ((algebraMap Q (henselization Q I : Type w)).comp a))
      (CommRingCat.ofHom b) (CommRingCat.ofHom (henselizationMapOfLE f I K hIK))
      (CommRingCat.ofHom ((algebraMap R (henselization R K : Type w)).comp c)) := by
  let H := (henselization Q I : Type w)
  let T := (henselization R K : Type w)
  let : Algebra A Q := a.toAlgebra
  let : Algebra A B := b.toAlgebra
  let : Algebra Q R := f.toAlgebra
  let : Algebra B R := c.toAlgebra
  let : Algebra A R := (c.comp b).toAlgebra
  have hw (x : A) : f (a x) = c (b x) := ConcreteCategory.congr_hom hcart.w x
  let : IsScalarTower A Q R := IsScalarTower.of_algebraMap_eq fun x => (hw x).symm
  let : IsScalarTower A B R := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : Algebra.IsPushout A Q B R := CommRingCat.isPushout_iff_isPushout.mp hcart
  let : Algebra.IsIntegral Q R := by
    rcases hint with hb | hs
    · have : Algebra.IsIntegral A B := ⟨hb⟩
      exact Algebra.IsPushout.isIntegral' A Q B R
    · exact Algebra.isIntegral_of_surjective hs
  let : Algebra Q H := inferInstance
  let : Algebra R T := inferInstance
  let : Algebra Q T := ((algebraMap R T).comp f).toAlgebra
  let : IsScalarTower Q R T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let g : H →ₐ[Q] T := henselizationLift Q I (K.map (algebraMap R T))
    (henselianPair_henselization R K) fun _ hq => Ideal.mem_map_of_mem _ (hIK hq)
  let : Algebra H T := g.toRingHom.toAlgebra
  let : IsScalarTower Q H T := IsScalarTower.of_algebraMap_eq fun q => (g.commutes q).symm
  have hbij := henselization_tensorProduct_bijective_of_isIntegral
    Q H R T I K hIK hzero (henselianPair_henselization Q I) (henselianPair_henselization R K)
    (fun C _ L hL v hv => henselization_universalProperty Q I C inferInstance L hL v hv)
    (fun C _ L hL v hv => henselization_universalProperty R K C inferInstance L hL v hv) g
    (henselizationLift_map_le_comap Q I (K.map (algebraMap R T))
      (henselianPair_henselization R K) fun _ hq => Ideal.mem_map_of_mem _ (hIK hq))
  let : Algebra R (H ⊗[Q] R) := Algebra.TensorProduct.rightAlgebra
  let : Algebra H (H ⊗[Q] R) := Algebra.TensorProduct.leftAlgebra
  let : Algebra.IsPushout Q H R (H ⊗[Q] R) :=
    CommRingCat.isPushout_iff_isPushout.mp (CommRingCat.isPushout_tensorProduct Q H R)
  let φQ : (H ⊗[Q] R) →ₐ[Q] T :=
    Algebra.TensorProduct.lift g (IsScalarTower.toAlgHom Q R T) (fun _ _ => Commute.all _ _)
  let φH : (H ⊗[Q] R) →ₐ[H] T :=
    { toRingHom := φQ.toRingHom
      commutes' := fun h => DFunLike.congr_fun (Algebra.TensorProduct.lift_comp_includeLeft g
        (IsScalarTower.toAlgHom Q R T) (fun _ _ => Commute.all _ _)) h }
  let e : (H ⊗[Q] R) ≃ₐ[H] T := AlgEquiv.ofBijective φH hbij
  have he : e.toRingHom.comp (algebraMap R (H ⊗[Q] R)) = algebraMap R T :=
    RingHom.ext fun r => DFunLike.congr_fun (Algebra.TensorProduct.lift_comp_includeRight' g
      (IsScalarTower.toAlgHom Q R T) (fun _ _ => Commute.all _ _)) r
  let : Algebra.IsPushout Q H R T := Algebra.IsPushout.of_equiv e he
  let : Algebra A H := ((algebraMap Q H).comp a).toAlgebra
  let : Algebra B T := ((algebraMap R T).comp c).toAlgebra
  let : Algebra A T := ((algebraMap B T).comp b).toAlgebra
  let : IsScalarTower A Q H := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower B R T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower A R T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower A B T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower A H T := IsScalarTower.of_algebraMap_eq fun x => by
    change algebraMap R T (c (b x)) = g (algebraMap Q H (a x))
    rw [g.commutes, ← hw]
    rfl
  exact CommRingCat.isPushout_iff_isPushout.mpr
    ((Algebra.IsPushout.comp_iff A Q B R (T := H) (T' := T)).mpr inferInstance)

/-- The map from the henselization of a deformation to the henselization of its special
fibre. -/
private noncomputable def henselizedSpecialFiberMap (J : Ideal P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w) →+*
      (henselization P J : Type w) :=
  henselizationMapOfLE X.hom.map.hom _ J le_rfl

/-- The map on henselizations induced by a morphism of deformations. -/
private noncomputable def henselizedHomMap (J : Ideal P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (f : X ⟶ Y) :
    (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w) →+*
      (henselization Y.left.fiber (J.comap Y.hom.map.hom) : Type w) :=
  henselizationMapOfLE f.left.map.hom _ _ (comap_le_comap_of_hom J f)

/-- The square exhibiting the henselization of a deformation as a deformation of the
henselization of the special fibre is a pushout. -/
private theorem henselizedSpecialFiber_isPushout (J : Ideal P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    IsPushout
      (CommRingCat.ofHom
        ((algebraMap X.left.fiber
          (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w)).comp
          (algebraMap X.left.base X.left.fiber)))
      (CommRingCat.ofHom X.hom.base.hom.toRingHom)
      (CommRingCat.ofHom (henselizedSpecialFiberMap J X))
      (CommRingCat.ofHom
        ((algebraMap P (henselization P J : Type w)).comp (algebraMap k P))) :=
  isPushout_henselizationMapOfLE _ _ X.hom.map.hom _ X.hom.cartesian
    (Or.inr (deformationSpecialFiberMap_surjective X)) _ J le_rfl
    (congrArg (fun I : Ideal P => PrimeSpectrum.zeroLocus (I : Set P))
      (Ideal.map_comap_of_surjective _ (deformationSpecialFiberMap_surjective X) J).symm)

/-- The square exhibiting the henselization of a morphism of deformations as a base change is
a pushout. -/
private theorem henselizedHomMap_isPushout (J : Ideal P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (f : X ⟶ Y) :
    IsPushout
      (CommRingCat.ofHom
        ((algebraMap X.left.fiber
          (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w)).comp
          (algebraMap X.left.base X.left.fiber)))
      (CommRingCat.ofHom f.left.base.hom.toRingHom)
      (CommRingCat.ofHom (henselizedHomMap J f))
      (CommRingCat.ofHom
        ((algebraMap Y.left.fiber
          (henselization Y.left.fiber (J.comap Y.hom.map.hom) : Type w)).comp
          (algebraMap Y.left.base Y.left.fiber))) := by
  refine isPushout_henselizationMapOfLE _ _ f.left.map.hom _ f.left.cartesian
    (Or.inl fun x => (isIntegral_of_artinianBaseHom f.left.base).isIntegral x) _ _
    (comap_le_comap_of_hom J f) ?_
  ext p
  refine ⟨fun hp => le_trans (Ideal.map_le_iff_le_comap.mpr (comap_le_comap_of_hom J f)) hp,
    fun hp r hr => ?_⟩
  obtain ⟨q, hq⟩ := deformationSpecialFiberMap_surjective X (Y.hom.map.hom r)
  have hqI : q ∈ J.comap X.hom.map.hom := by
    change X.hom.map.hom q ∈ J
    rw [hq]
    exact hr
  have hd0 : Y.hom.map.hom (r - f.left.map.hom q) = 0 := by
    rw [map_sub, ← hq, ← RingHom.comp_apply, hom_map_comp_eq, sub_self]
  obtain ⟨n, hn⟩ := isNilpotent_of_mem_ker_deformationSpecialFiberMap Y
    (RingHom.mem_ker.mpr hd0)
  have hdp : r - f.left.map.hom q ∈ p.asIdeal :=
    p.isPrime.mem_of_pow_mem n (by rw [hn]; exact p.asIdeal.zero_mem)
  simpa using p.asIdeal.add_mem (hp (Ideal.mem_map_of_mem _ hqI)) hdp

/-- The flat algebra over the unchanged Artinian base obtained by henselizing the fibre. -/
private noncomputable def henselizedFlatAlgebra (J : Ideal P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    FlatAlgebraCategory.{u, w} Λ k := by
  let Q := X.left.fiber
  let A := X.left.base
  let I := J.comap X.hom.map.hom
  let H := (henselization Q I : Type w)
  letI : Algebra A H := ((algebraMap Q H).comp (algebraMap A Q)).toAlgebra
  letI : IsScalarTower A Q H := IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact
    { base := A
      fiber := H
      algebra := inferInstance
      flat := flat_henselization_of_flat I }

/-- Henselizing a morphism of deformations is compatible with the maps to the henselization of
the special fibre. -/
private theorem henselizedSpecialFiberMap_comp_henselizedHomMap (J : Ideal P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (f : X ⟶ Y) :
    (henselizedSpecialFiberMap J Y).comp (henselizedHomMap J f) =
      henselizedSpecialFiberMap J X :=
  henselizationMapOfLE_comp _ _ _ (hom_map_comp_eq f) _ _ _ _ _ _

/-- Henselization of a deformation, as a deformation of the henselized special fibre. -/
private noncomputable def henselizedDeformation (J : Ideal P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    ringDeformationCategory (Λ := Λ) (k := k) (henselization P J : Type w) :=
  Over.mk (show henselizedFlatAlgebra J X ⟶
      residueFieldAlgebra (Λ := Λ) (k := k) (henselization P J : Type w) from
    { base := X.hom.base
      map := CommRingCat.ofHom (henselizedSpecialFiberMap J X)
      cartesian := henselizedSpecialFiber_isPushout J X })

/-- Henselization of a morphism of deformations. -/
private noncomputable def henselizedDeformationHom (J : Ideal P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (f : X ⟶ Y) :
    henselizedDeformation J X ⟶ henselizedDeformation J Y := by
  refine Over.homMk (show (henselizedDeformation J X).left ⟶ (henselizedDeformation J Y).left
    from
    { base := f.left.base
      map := CommRingCat.ofHom (henselizedHomMap J f)
      cartesian := henselizedHomMap_isPushout J f }) ?_
  apply FlatAlgebraCategory.Hom.ext
  · exact congrArg (fun e : X.left ⟶ residueFieldAlgebra (Λ := Λ) (k := k) P => e.base) f.w
  · exact CommRingCat.hom_ext (henselizedSpecialFiberMap_comp_henselizedHomMap J f)

/-- Henselization takes the identity morphism of a deformation to the identity. -/
private theorem henselizedHomMap_id (J : Ideal P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    henselizedHomMap J (𝟙 X) =
      RingHom.id (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w) :=
  henselizationMapOfLE_id _ _

/-- Henselization takes a composite of morphisms of deformations to the composite. -/
private theorem henselizedHomMap_comp (J : Ideal P)
    {X Y Z : ringDeformationCategory (Λ := Λ) (k := k) P} (f : X ⟶ Y) (g : Y ⟶ Z) :
    (henselizedHomMap J g).comp (henselizedHomMap J f) = henselizedHomMap J (f ≫ g) :=
  henselizationMapOfLE_comp _ _ _ rfl _ _ _ _ _ _

/-- The functor on slice categories underlying henselization of deformations. -/
private noncomputable def henselizedDeformationFunctor (J : Ideal P) :
    ringDeformationCategory (Λ := Λ) (k := k) P ⥤
      ringDeformationCategory (Λ := Λ) (k := k) (henselization P J : Type w) where
  obj := henselizedDeformation J
  map := henselizedDeformationHom J
  map_id X := by
    apply Over.OverMorphism.ext
    apply FlatAlgebraCategory.Hom.ext
    · rfl
    · exact CommRingCat.hom_ext (henselizedHomMap_id J X)
  map_comp f g := by
    apply Over.OverMorphism.ext
    apply FlatAlgebraCategory.Hom.ext
    · rfl
    · exact CommRingCat.hom_ext (henselizedHomMap_comp J f g).symm

variable (J : Ideal P)

/-- Henselization of deformations, including the identification of the fibre of its value with
the henselization of the original fibre and the compatibilities of the resulting map out of
each flat algebra. -/
structure HenselizationFunctorData where
  /-- The functor of deformation categories over `𝒞_Λ`. -/
  functor : BasedFunctor
    (BasedCategory.ofFunctor
      (Over.forget (residueFieldAlgebra (Λ := Λ) (k := k) P) ⋙
        FlatAlgebraCategory.projection))
    (BasedCategory.ofFunctor
      (Over.forget (residueFieldAlgebra (Λ := Λ) (k := k)
        (henselization P J : Type w)) ⋙ FlatAlgebraCategory.projection))
  /-- The henselization map out of the flat algebra of each deformation. -/
  henselizationMap (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    X.left.fiber →+* (functor.obj X).left.fiber
  /-- The henselization map is a map of algebras over the common Artinian base. -/
  base_comm (X : ringDeformationCategory (Λ := Λ) (k := k) P) (a : X.left.base) :
    henselizationMap X (algebraMap X.left.base X.left.fiber a) =
      algebraMap (functor.obj X).left.base (functor.obj X).left.fiber
        (cast (congrArg ArtinianLocalAlgCat.carrier
          (congrArg (fun F => F.obj X) functor.w).symm) a)
  /-- The fibre of the value of the functor is the henselization of the original fibre at the
  inverse image of `J`. -/
  henselizationEquiv (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w) ≃+*
      (functor.obj X).left.fiber
  /-- That identification carries the structure map of the henselization to the henselization
  map. -/
  henselizationEquiv_algebraMap (X : ringDeformationCategory (Λ := Λ) (k := k) P)
      (q : X.left.fiber) :
    henselizationEquiv X (algebraMap X.left.fiber
      (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w) q) =
      henselizationMap X q
  /-- The henselization map is compatible with reduction to the special fibre. -/
  specialFiber_comm (X : ringDeformationCategory (Λ := Λ) (k := k) P) (q : X.left.fiber) :
    (functor.obj X).hom.map.hom (henselizationMap X q) =
      algebraMap P (henselization P J : Type w) (X.hom.map.hom q)
  /-- The henselization maps are natural in morphisms of deformations. -/
  naturality {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (g : X ⟶ Y)
      (q : X.left.fiber) :
    henselizationMap Y (g.left.map.hom q) =
      (functor.map g).left.map.hom (henselizationMap X q)

/-- Henselization along the inverse image of `J` is a functor of deformation categories over
`𝒞_Λ` which computes the henselization of each flat algebra. -/
theorem nonempty_henselizationFunctorData :
    Nonempty (HenselizationFunctorData (Λ := Λ) (k := k) (P := P) J) := by
  classical
  refine ⟨?_⟩
  refine
    { functor :=
        { toFunctor := henselizedDeformationFunctor (Λ := Λ) (k := k) (P := P) J
          w := rfl }
      henselizationMap := fun X =>
        algebraMap X.left.fiber
          (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w)
      base_comm := ?_
      henselizationEquiv := fun _ => RingEquiv.refl _
      henselizationEquiv_algebraMap := ?_
      specialFiber_comm := ?_
      naturality := ?_ }
  · intro X a
    let A := X.left.base
    let Q := X.left.fiber
    let H := (henselization Q (J.comap X.hom.map.hom) : Type w)
    let : Algebra A H := ((algebraMap Q H).comp (algebraMap A Q)).toAlgebra
    let : IsScalarTower A Q H := IsScalarTower.of_algebraMap_eq fun _ => rfl
    change algebraMap X.left.fiber
        (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w)
        (algebraMap X.left.base X.left.fiber a) =
      algebraMap X.left.base
        (henselization X.left.fiber (J.comap X.hom.map.hom) : Type w) a
    exact (IsScalarTower.algebraMap_apply A Q H a).symm
  · intro _ _
    rfl
  · intro X q
    exact henselizationMapOfLE_algebraMap X.hom.map.hom _ J le_rfl q
  · intro X Y f q
    exact (henselizationMapOfLE_algebraMap f.left.map.hom _ _ (comap_le_comap_of_hom J f) q).symm

/-- **Stacks 0DYT.** For a `k`-algebra `P` and an ideal `J ⊆ P`, henselization along the
inverse image of `J` is a functor from the deformation category of `P` to that of the
henselization of the pair `(P, J)`, over the category `𝒞_Λ` of Artinian local bases. -/
@[stacks 0DYT]
noncomputable def henselizationFunctor :
    HenselizationFunctorData (Λ := Λ) (k := k) (P := P) J :=
  Classical.choice (nonempty_henselizationFunctorData J)

end Deformation.Examples

