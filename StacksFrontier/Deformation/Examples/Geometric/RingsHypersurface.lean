/-!
# Infinitesimal automorphisms of a formal hypersurface (Stacks 0DY5)

Let `k` be a field and `f` a nonzero formal power series in `k[[x_1, …, x_n]]` lying in the
square of the ideal generated by the variables, and let `P = k[[x_1, …, x_n]]/(f)`. The
infinitesimal automorphism group of the deformation category of `P`, at an arbitrary
dual-number lift, carries the structure of a `k`-vector space whose addition is composition of
automorphisms, and that vector space is finite-dimensional if and only if `n = 1`.

Tag 0DY3 identifies the infinitesimal automorphism group with the `k`-derivations of `P` into
itself, written multiplicatively, and
`Stacks.MvPowerSeries.Hypersurface.finiteDimensional_derivation_iff_eq_one` is the criterion for
those derivations. So all this file does is transport the criterion along the identification of
0DY3, which also transports the vector-space structure.

## Main results

* `Deformation.Examples.hypersurface_finiteDimensional_infinitesimalAutomorphisms_iff`:
  **Stacks 0DY5(1)**, the stated equivalence for the infinitesimal automorphisms themselves.

## Implementation notes

The statement is shaped like `Deformation.Examples.ProjectiveGradedAlgebra`'s
`gradedAlgebra_infinitesimalAutomorphisms_finiteDimensional` (the weak form beside Tag 0DVZ's
`exists_module_finiteDimensional_infinitesimalAutomorphismGroup`): the automorphism group is a
multiplicative group, so its vector-space structure is produced inside the statement through
`Additive`, which is why `a + b = a * b` holds by `rfl` and has to be recorded for the structure
to pin down the group it came from. The predeformation-category property is produced from
`Deformation.Examples.ringDeformationCategory_isDeformationCategory` rather than assumed, as in
Tag 0DY3: the group depends on it, so a hypothesis would let a caller supply a different proof.

The produced `k`-module structure is pinned down, rather than merely asserted to exist: the
statement also exhibits the isomorphism of groups with the derivations of Tag 0DY3 and says that
it is `k`-linear for that structure. Without this the existential quantifier over module
structures would leave "finite dimensional" ambiguous, since an abelian group can carry several
inequivalent `k`-structures.

## References

* [Stacks Project, Tag 0DY5](https://stacks.math.columbia.edu/tag/0DY5)
-/

@[expose] public noncomputable section

open CategoryTheory

namespace Deformation.Examples

universe u w

/-- **Stacks 0DY5(1).** Let `k` be a field, `n` a number of variables and `f` a nonzero formal
power series in `k[[x_1, …, x_n]]` lying in the square of the ideal generated by the variables,
and let `P = k[[x_1, …, x_n]]/(f)`. At any dual-number lift of any object of the deformation
category of `P` over the residue field, the infinitesimal automorphism group carries a
`k`-vector-space structure whose addition is composition and which is carried by the
identification of Tag 0DY3 to the `k`-structure of `Derivation k P P`, and that vector space is
finite-dimensional if and only if `n = 1`. -/
@[stacks 0DY5 "part (1)"]
public theorem hypersurface_finiteDimensional_infinitesimalAutomorphisms_iff
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) (hf : f ≠ 0)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2) :
    let P := MvPowerSeries (Fin n) k ⧸ Ideal.span {f}
    let hp := (ringDeformationCategory_isDeformationCategory (Λ := Λ) (k := k) P).predeformation
    ∀ {Aε : ArtinianLocalAlgCat.{u, w, w} Λ k}
      {x₀ : (ringDeformationProjection Λ k P).Fiber (residueFieldObject.{u, w, w} Λ k)}
      {xε : (ringDeformationProjection Λ k P).Fiber Aε}
      (g : residueFieldObject.{u, w, w} Λ k ⟶ Aε)
      (e : Aε ⟶ residueFieldObject.{u, w, w} Λ k)
      (hpair : IsCanonicalDualNumberPair g e)
      (i : x₀.1 ⟶ xε.1) (hi : (ringDeformationProjection Λ k P).IsHomLift g i),
      let G := infinitesimalAutomorphismGroup hp g e hpair i hi
      ∃ hA : AddCommGroup G,
        letI := hA
        ∃ hM : Module k G,
          letI := hM
          (∀ a b : G, a + b = a * b) ∧
          (∃ E : G ≃* Multiplicative (Derivation k P P), ∀ (s : k) (a : G),
            Multiplicative.toAdd (E (s • a)) = s • Multiplicative.toAdd (E a)) ∧
          (FiniteDimensional k G ↔ n = 1) := by
  dsimp only
  intro Aε x₀ xε g e hpair i hi
  set P := MvPowerSeries (Fin n) k ⧸ Ideal.span {f} with hPdef
  let G := infinitesimalAutomorphismGroup
    (ringDeformationCategory_isDeformationCategory (Λ := Λ) (k := k) P).predeformation
    g e hpair i hi
  obtain ⟨hp', h3⟩ :=
    exists_infinitesimalAutomorphismGroupMulEquivDerivation (Λ := Λ) (k := k) (P := P)
  obtain ⟨c, -, -, Emul, -, -⟩ := h3 g e hpair i hi
  let Emul' : G ≃* Multiplicative (Derivation k P P) := Emul
  let E : Additive G ≃+ Derivation k P P := Emul'.toAdditiveLeft
  let : CommGroup G :=
    { (inferInstance : Group G) with
      mul_comm := by
        intro a b
        apply Emul'.injective
        simp only [map_mul]
        rw [mul_comm] }
  let hA : AddCommGroup G := inferInstanceAs (AddCommGroup (Additive G))
  let : AddCommGroup G := hA
  let : Module k (Additive G) := E.module k
  let hM : Module k G := inferInstanceAs (Module k (Additive G))
  let : Module k G := hM
  refine ⟨hA, hM, fun _ _ => rfl, ⟨Emul', fun s a => (E.linearEquiv k).map_smul s a⟩, ?_⟩
  rw [← Stacks.MvPowerSeries.Hypersurface.finiteDimensional_derivation_iff_eq_one n f hf hord]
  exact ⟨fun hG ↦ have : FiniteDimensional k (Additive G) := hG
    (E.linearEquiv k).finiteDimensional, fun _ ↦ (E.linearEquiv k).symm.finiteDimensional⟩

end Deformation.Examples

end
