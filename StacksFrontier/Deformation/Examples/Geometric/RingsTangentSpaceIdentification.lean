-/

@[expose] public noncomputable section

universe w

open TensorProduct TrivSqZeroExt Stacks.Deformation

namespace Stacks.Deformation

section Comp

variable (A B : Type w) [CommRing A] [CommRing B] [Algebra A B]
  {L M N : Type w} [AddCommGroup L] [Module B L] [AddCommGroup M] [Module B M]
  [AddCommGroup N] [Module B N]

/-- The map on conormal cokernels induced by a composite of coefficient maps is the composite
of the induced maps. -/
public lemma conormalCokernelPush_comp (c : L →ₗ[B] M) (d : M →ₗ[B] N)
    (y : extOneCokernel A B L) :
    conormalCokernelPush A B (d.comp c) y
      = conormalCokernelPush A B d (conormalCokernelPush A B c y) := by
  induction y using Quotient.inductionOn' with
  | h δ => rfl

/-- The map `Ext¹_B(NL_{B/A}, L) → Ext¹_B(NL_{B/A}, N)` induced by a composite `d ∘ c` of
coefficient maps is the composite of the maps induced by `c` and by `d`. -/
public lemma naiveCotangentExtOneMap_comp (c : L →ₗ[B] M) (d : M →ₗ[B] N)
    (x : naiveCotangentExtOne A B L) :
    naiveCotangentExtOneMap A B (d.comp c) x
      = naiveCotangentExtOneMap A B d (naiveCotangentExtOneMap A B c x) := by
  change (extCokernelIso A B N).symm (conormalCokernelPush A B (d.comp c)
      (extCokernelIso A B L x)) = _
  rw [conormalCokernelPush_comp]
  change _ = (extCokernelIso A B N).symm (conormalCokernelPush A B d
    (extCokernelIso A B M ((extCokernelIso A B M).symm
      (conormalCokernelPush A B c (extCokernelIso A B L x)))))
  rw [(extCokernelIso A B M).apply_symm_apply]

end Comp

end Stacks.Deformation

namespace Deformation.Examples

section FirstOrderExtension

variable {k : Type w} [Field k] {V V' : Type w} [AddCommGroup V] [Module k V]
  [AddCommGroup V'] [Module k V']

local instance : Module kᵐᵒᵖ V :=
  Module.oppositeOfCommSemiring k V

local instance : IsCentralScalar k V := Module.isCentralScalar_oppositeOfCommSemiring k V

local instance : Module kᵐᵒᵖ V' :=
  Module.oppositeOfCommSemiring k V'

local instance : IsCentralScalar k V' := Module.isCentralScalar_oppositeOfCommSemiring k V'

variable {P Q : Type w} [CommRing P] [Algebra k P] [CommRing Q]
  [Algebra (TrivSqZeroExt k V) Q] [Algebra k Q]
  [IsScalarTower k (TrivSqZeroExt k V) Q]

omit [Algebra k Q] [IsScalarTower k (TrivSqZeroExt k V) Q] in
/-- The submodule of `Q` generated by the augmentation ideal is an ideal: it is stable under
multiplication by `Q`. -/
private theorem mul_mem_kerIdeal_smul (q : Q) {x : Q}
    (hx : x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q)) :
    q * x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q) := by
  refine Submodule.smul_induction_on hx (fun i hi y _ ↦ ?_) (fun u v hu hv ↦ ?_)
  · rw [mul_smul_comm]
    exact Submodule.smul_mem_smul hi Submodule.mem_top
  · rw [mul_add]
    exact Submodule.add_mem _ hu hv

omit [Algebra k Q] [IsScalarTower k (TrivSqZeroExt k V) Q] in
/-- Two elements of the submodule generated by the augmentation ideal have product zero, since
that ideal has square zero. -/
private theorem mul_eq_zero_of_mem_kerIdeal_smul {x y : Q}
    (hx : x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q))
    (hy : y ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q)) : x * y = 0 := by
  refine Submodule.smul_induction_on hx (fun i hi z _ ↦ ?_) (fun u v hu hv ↦ ?_)
  · rw [smul_mul_assoc]
    exact kerIdeal_smul_eq_zero hi (mul_mem_kerIdeal_smul z hy)
  · rw [add_mul, hu, hv, add_zero]

variable (π : Q →ₐ[k] P)

omit [IsScalarTower k (TrivSqZeroExt k V) Q] in
/-- The kernel of the reduction of a first-order flat deformation has square zero. -/
public theorem sq_zero_ker_of_isFirstOrderReduction
    (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q)) :
    RingHom.ker π.toRingHom ^ 2 = ⊥ := by
  refine le_antisymm ?_ bot_le
  rw [pow_two]
  refine Ideal.mul_le.2 fun a ha b hb ↦ (Submodule.mem_bot Q).2 ?_
  exact mul_eq_zero_of_mem_kerIdeal_smul (hker a (RingHom.mem_ker.1 ha))
    (hker b (RingHom.mem_ker.1 hb))

/-- The `P`-action on the kernel of a square-zero reduction is multiplication by any lift:
`Deformation.Examples.kernelModule` descends the `Q`-action without choosing a section, so its
scalar multiplication has to be computed this way. -/
public theorem kernelModule_smul (hπ : Function.Surjective π)
    (hI2 : RingHom.ker π.toRingHom ^ 2 = ⊥) (p : P) (q : Q) (hq : π q = p)
    (y : ↥(RingHom.ker π.toRingHom)) :
    letI := kernelModule π hπ hI2
    (p • y : ↥(RingHom.ker π.toRingHom)) = q • y := by
  let := kernelSMul π hI2
  let := kernelModuleQuotient π hI2
  let := kernelModule π hπ hI2
  have hcls : quotKerRingEquiv π hπ p = Ideal.Quotient.mk (RingHom.ker π.toRingHom) q := by
    rw [← hq]
    exact RingHom.quotientKerEquivOfSurjective_symm_apply hπ q
  change (quotKerRingEquiv π hπ p) • y = q • y
  rw [hcls]
  rfl

/-- The `P`-action on the kernel of a square-zero reduction, read in `Q`. -/
public theorem coe_kernelModule_smul (hπ : Function.Surjective π)
    (hI2 : RingHom.ker π.toRingHom ^ 2 = ⊥) (p : P) (q : Q) (hq : π q = p)
    (y : ↥(RingHom.ker π.toRingHom)) :
    letI := kernelModule π hπ hI2
    ((p • y : ↥(RingHom.ker π.toRingHom)) : Q) = q * (y : Q) := by
  let := kernelModule π hπ hI2
  rw [kernelModule_smul π hπ hI2 p q hq y]
  rfl

/-- **A first-order flat deformation of `P` is a square-zero extension of `P` by `P ⊗[k] V`.**
Let `Q` be a flat `k ⊕ V`-algebra whose reduction `π : Q → P` is a surjection of `k`-algebras
compatible with the augmentation `k ⊕ V → k`, and whose kernel is the ideal generated by the
augmentation ideal. Then `0 → P ⊗[k] V → Q → P → 0` is a square-zero extension of the
`k`-algebra `P` by the `P`-module `P ⊗[k] V`.

The middle ring is `Q` itself, the reduction is `π`, and the identification of the kernel with
`P ⊗[k] V` is `Deformation.Examples.firstOrderConormalHom`, which is bijective onto the kernel
by `Deformation.Examples.injective_firstOrderConormalHom` — where the flatness of `Q` is
used, through Stacks 063Y — and
`Deformation.Examples.exists_firstOrderConormalHom_eq`. This is the shape in which Stacks
0GPT classifies the deformation by `Ext¹_P(NL_{P/k}, P ⊗[k] V)`. -/
public def firstOrderExtension [Module.Flat (TrivSqZeroExt k V) Q]
    (hπ : Function.Surjective π) (hπa : IsFirstOrderReduction V π)
    (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q)) :
    (algebraExtensionProblem k P (P ⊗[k] V)).CompatibleExtension.{w} := by
  have hI2 : RingHom.ker π.toRingHom ^ 2 = ⊥ :=
    sq_zero_ker_of_isFirstOrderReduction π hker
  letI : Module P ↥(RingHom.ker π.toRingHom) := kernelModule π hπ hI2
  let g : P ⊗[k] V →ₗ[P] ↥(RingHom.ker π.toRingHom) :=
    { toFun := fun x ↦ ⟨firstOrderConormalHom π hπ x,
        RingHom.mem_ker.2 (reduction_firstOrderConormalHom π hπ hπa x)⟩
      map_add' := fun x y ↦ Subtype.ext (map_add (firstOrderConormalHom π hπ) x y)
      map_smul' := fun p x ↦ by
        obtain ⟨q, hq⟩ := hπ p
        refine Subtype.ext ?_
        rw [RingHom.id_apply, coe_kernelModule_smul π hπ hI2 p q hq]
        exact firstOrderConormalHom_smul π hπ hker p q hq x }
  let e : P ⊗[k] V ≃ₗ[P] ↥(RingHom.ker π.toRingHom) :=
    LinearEquiv.ofBijective g
      ⟨fun x y h ↦ injective_firstOrderConormalHom π hπa hπ hker
          (congrArg Subtype.val h),
        fun y ↦ by
          obtain ⟨x, hx⟩ := exists_firstOrderConormalHom_eq π hπa hπ hker
            (RingHom.mem_ker.1 y.2)
          exact ⟨x, Subtype.ext hx⟩⟩
  dsimp only [algebraExtensionProblem]
  exact
    { B' := Q
      toB := π
      surjective := hπ
      sq_zero := hI2
      toB_smul_kernel := fun b' x ↦ kernelModule_smul π hπ hI2 (π b') b' rfl x
      kernelEquiv := e
      map_I := by
        intro i
        have h : i = 0 := Subtype.ext i.2
        rw [h]
        simp only [map_zero, Submodule.coe_zero] }

variable [Module.Flat (TrivSqZeroExt k V) Q] (hπ : Function.Surjective π)
  (hπa : IsFirstOrderReduction V π)
  (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q))

/-- The reduction of the extension attached to a first-order deformation is the reduction of
the deformation. -/
public theorem firstOrderExtension_toB (z : Q) :
    (firstOrderExtension (V := V) π hπ hπa hker).toB z = π z := rfl

/-- The kernel inclusion of the extension attached to a first-order deformation is the
canonical map `P ⊗[k] V → Q`. -/
public theorem kernelInclusion_firstOrderExtension (x : P ⊗[k] V) :
    kernelInclusion (firstOrderExtension (V := V) π hπ hπa hker) x
      = firstOrderConormalHom π hπ x := rfl

end FirstOrderExtension

section Comparison

variable {k : Type w} [Field k] {V V' : Type w} [AddCommGroup V] [Module k V]
  [AddCommGroup V'] [Module k V']

local instance : Module kᵐᵒᵖ V :=
  Module.oppositeOfCommSemiring k V

local instance : IsCentralScalar k V := Module.isCentralScalar_oppositeOfCommSemiring k V

local instance : Module kᵐᵒᵖ V' :=
  Module.oppositeOfCommSemiring k V'

local instance : IsCentralScalar k V' := Module.isCentralScalar_oppositeOfCommSemiring k V'

/-- The `P`-linear map `P ⊗[k] V → P ⊗[k] V'` induced by a `k`-linear map `V → V'`. This is
the coefficient map along which the extension class of a first-order deformation is natural in
`V`. -/
public def tensorRightMap (P : Type w) [CommRing P] [Algebra k P] (f : V →ₗ[k] V') :
    P ⊗[k] V →ₗ[P] P ⊗[k] V' :=
  TensorProduct.AlgebraTensorModule.map (LinearMap.id : P →ₗ[P] P) f

@[simp]
public theorem tensorRightMap_tmul (P : Type w) [CommRing P] [Algebra k P] (f : V →ₗ[k] V')
    (p : P) (v : V) : tensorRightMap P f (p ⊗ₜ[k] v) = p ⊗ₜ[k] f v := rfl

/-- The coefficient map induced by the identity of `V` is the identity. -/
public theorem tensorRightMap_id (P : Type w) [CommRing P] [Algebra k P]
    (x : P ⊗[k] V) : tensorRightMap P (LinearMap.id : V →ₗ[k] V) x = x := by
  induction x with
  | zero => exact map_zero _
  | tmul p v => rfl
  | add x y hx hy => rw [map_add, hx, hy]

variable {P Q Q' : Type w} [CommRing P] [Algebra k P] [CommRing Q] [CommRing Q']
  [Algebra (TrivSqZeroExt k V) Q] [Algebra k Q] [IsScalarTower k (TrivSqZeroExt k V) Q]
  [Algebra (TrivSqZeroExt k V') Q'] [Algebra k Q'] [IsScalarTower k (TrivSqZeroExt k V') Q']
  (π : Q →ₐ[k] P) (π' : Q' →ₐ[k] P)
  (hπ : Function.Surjective π) (hπ' : Function.Surjective π')

/-- A `k`-algebra map of first-order deformations which is compatible with the reductions and
semilinear over `f : V → V'` carries the canonical map `P ⊗[k] V → Q` of the source to that of
the target, along the coefficient map `P ⊗ f`.

This is the computation which makes the extension class of a first-order deformation natural
in `V`; the hypothesis is exactly what a morphism of the deformation category supplies, since
such a morphism lies over the map `k ⊕ V → k ⊕ V'` induced by `f`. -/
public theorem map_firstOrderConormalHom
    (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q))
    (hker' : ∀ x : Q', π' x = 0 → x ∈ kerIdeal k V' • (⊤ : Submodule (TrivSqZeroExt k V') Q'))
    (h : Q →ₐ[k] Q') (hcomm : ∀ z : Q, π' (h z) = π z)
    (f : V →ₗ[k] V')
    (hf : ∀ (v : V) (z : Q),
      h ((inr v : TrivSqZeroExt k V) • z) = (inr (f v) : TrivSqZeroExt k V') • h z)
    (x : P ⊗[k] V) :
    h (firstOrderConormalHom π hπ x)
      = firstOrderConormalHom π' hπ' (tensorRightMap P f x) := by
  induction x with
  | zero => simp only [map_zero]
  | tmul p v =>
    have hlift : π' (h (reductionSection π hπ p)) = p := by
      rw [hcomm, apply_reductionSection]
    rw [tensorRightMap_tmul, firstOrderConormalHom_tmul π' hπ' hker' p (f v) _ hlift,
      firstOrderConormalHom_tmul π hπ hker p v (reductionSection π hπ p)
        (apply_reductionSection π hπ p), hf]
  | add x y hx hy => simp only [map_add, hx, hy]

/-- Conversely, a `k`-algebra map of first-order deformations which is compatible with the
reductions and carries the canonical map of the source to that of the target is automatically
semilinear over `f : V → V'`, hence a map of `k ⊕ V`-algebras over `k ⊕ V → k ⊕ V'`.

This is what makes an isomorphism of the associated square-zero extensions an isomorphism of
the deformations: the action of the augmentation ideal on `Q` is recoverable from the reduction
and the identification of the kernel, by
`Deformation.Examples.firstOrderConormalHom_tmul`. -/
public theorem inr_smul_of_map_firstOrderConormalHom
    (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q))
    (hker' : ∀ x : Q', π' x = 0 → x ∈ kerIdeal k V' • (⊤ : Submodule (TrivSqZeroExt k V') Q'))
    (h : Q →ₐ[k] Q')
    (hcomm : ∀ z : Q, π' (h z) = π z) (f : V →ₗ[k] V')
    (hcompat : ∀ x : P ⊗[k] V,
      h (firstOrderConormalHom π hπ x) = firstOrderConormalHom π' hπ' (tensorRightMap P f x))
    (v : V) (z : Q) :
    h ((inr v : TrivSqZeroExt k V) • z) = (inr (f v) : TrivSqZeroExt k V') • h z := by
  rw [← firstOrderConormalHom_tmul π hπ hker (π z) v z rfl, hcompat, tensorRightMap_tmul]
  exact firstOrderConormalHom_tmul π' hπ' hker' (π z) (f v) (h z) (hcomm z)

/-- **The extension class of a first-order deformation is natural in `V`.** Let `Q` be a
first-order flat deformation of `P` over `k ⊕ V`, let `Q'` be one over `k ⊕ V'`, and let
`h : Q → Q'` be a `k`-algebra map compatible with the reductions and semilinear over a
`k`-linear map `f : V → V'`. Then the class of the extension attached to `Q'` is the image of
the class attached to `Q` under
`Ext¹_P(NL_{P/k}, P ⊗[k] V) → Ext¹_P(NL_{P/k}, P ⊗[k] V')`.

This is **Stacks 0GPV** for the trivial tower `k → P → P`, applied to `h`: the restriction map
on first Ext for that tower is the identity by
`Stacks.Deformation.naiveCotangentExtOneTowerMap_self`. -/
public theorem extClass_firstOrderExtension [Module.Flat (TrivSqZeroExt k V) Q]
    [Module.Flat (TrivSqZeroExt k V') Q']
    (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q))
    (hker' : ∀ x : Q', π' x = 0 → x ∈ kerIdeal k V' • (⊤ : Submodule (TrivSqZeroExt k V') Q'))
    (hπa : IsFirstOrderReduction V π)
    (hπa' : IsFirstOrderReduction V' π') (h : Q →ₐ[k] Q') (hcomm : ∀ z : Q, π' (h z) = π z)
    (f : V →ₗ[k] V')
    (hf : ∀ (v : V) (z : Q),
      h ((inr v : TrivSqZeroExt k V) • z) = (inr (f v) : TrivSqZeroExt k V') • h z) :
    extClass (firstOrderExtension π' hπ' hπa' hker')
      = naiveCotangentExtOneMap k P (tensorRightMap P f)
        (extClass (firstOrderExtension π hπ hπa hker)) := by
  have hex : ∃ g : (firstOrderExtension π hπ hπa hker).B' →ₐ[k]
      (firstOrderExtension π' hπ' hπa' hker').B',
      (∀ z : (firstOrderExtension π hπ hπa hker).B',
          (firstOrderExtension π' hπ' hπa' hker').toB (g z)
            = algebraMap P P ((firstOrderExtension π hπ hπa hker).toB z)) ∧
        ∀ m : P ⊗[k] V, g (kernelInclusion (firstOrderExtension π hπ hπa hker) m)
          = kernelInclusion (firstOrderExtension π' hπ' hπa' hker')
            (tensorRightMap P f m) :=
    ⟨h, fun z ↦ (hcomm z).trans (Algebra.algebraMap_self_apply (π z)).symm,
      fun m ↦ map_firstOrderConormalHom π π' hπ hπ' hker hker' h hcomm f hf m⟩
  have hres := (exists_compatible_algebraMap_iff k P P (tensorRightMap P f)
    (firstOrderExtension π hπ hπa hker) (firstOrderExtension π' hπ' hπa' hker')).1 hex
  rw [naiveCotangentExtOneTowerMap_self] at hres
  exact hres.symm

/-- **A map of the associated extensions is a map of the deformations.** Let `Q` and `Q''` be
first-order flat deformations of `P` over the same `k ⊕ V` and let `h : Q → Q''` be a
`k`-algebra map which commutes with the reductions and with the two identifications of the
kernel with `P ⊗[k] V` — that is, a map of the square-zero extensions they determine. Then `h`
is `k ⊕ V`-linear, so it is a map of deformations over `k ⊕ V`; applied to an isomorphism of
extensions it says that the isomorphism is an isomorphism of deformations.

This is the rigidity which makes the extension class of a first-order deformation injective on
isomorphism classes of deformations: the `k ⊕ V`-algebra structure of a first-order deformation
is not extra data, it is recoverable from its structure of square-zero extension, because
`k ⊕ V` is generated over `k` by the augmentation ideal and
`Deformation.Examples.firstOrderConormalHom_tmul` computes the action of that ideal from the
reduction. -/
public theorem smul_of_compatible_algHom
    (hker : ∀ x : Q, π x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q))
    {Q'' : Type w} [CommRing Q''] [Algebra (TrivSqZeroExt k V) Q''] [Algebra k Q'']
    [IsScalarTower k (TrivSqZeroExt k V) Q'']
    (π'' : Q'' →ₐ[k] P) (hπ'' : Function.Surjective π'')
    (hker'' : ∀ x : Q'', π'' x = 0 → x ∈ kerIdeal k V • (⊤ : Submodule (TrivSqZeroExt k V) Q''))
    (h : Q →ₐ[k] Q'') (hcomm : ∀ y : Q, π'' (h y) = π y)
    (hkercomm : ∀ x : P ⊗[k] V,
      h (firstOrderConormalHom π hπ x) = firstOrderConormalHom π'' hπ'' x)
    (a : TrivSqZeroExt k V) (z : Q) :
    h (a • z) = a • h z := by
  have hcompat : ∀ x : P ⊗[k] V, h (firstOrderConormalHom π hπ x)
      = firstOrderConormalHom π'' hπ'' (tensorRightMap P (LinearMap.id : V →ₗ[k] V) x) := by
    intro x
    rw [tensorRightMap_id]
    exact hkercomm x
  have hinr : ∀ (v : V) (y : Q),
      h ((inr v : TrivSqZeroExt k V) • y) = (inr v : TrivSqZeroExt k V) • h y :=
    fun v y ↦ inr_smul_of_map_firstOrderConormalHom π π'' hπ hπ'' hker hker''
      h hcomm (LinearMap.id : V →ₗ[k] V) hcompat v y
  have hinl : ∀ (c : k) (y : Q),
      h ((inl c : TrivSqZeroExt k V) • y) = (inl c : TrivSqZeroExt k V) • h y := by
    intro c y
    rw [← algebraMap_eq_inl, ← algebraMap_smul_eq (V := V) c y,
      ← algebraMap_smul_eq (V := V) c (h y), map_smul]
  have hsplit : a = inl a.fst + inr a.snd := by ext <;> simp
  rw [hsplit, add_smul, add_smul, map_add, hinl, hinr]

