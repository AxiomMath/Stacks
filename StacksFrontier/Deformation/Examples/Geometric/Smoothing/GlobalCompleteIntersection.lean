/-! ### Smoothing a global complete intersection -/

/-- The ring of formal power series over a field is infinite, the powers of `X` being
pairwise distinct. -/
private theorem infinite_powerSeries (k : Type u) [Field k] : Infinite (PowerSeries k) := by
  apply Infinite.of_injective (fun n : ℕ => (PowerSeries.X : PowerSeries k) ^ n)
  intro m n h
  by_contra hmn
  have hc := congrArg (PowerSeries.coeff m) h
  have hm : PowerSeries.coeff m ((PowerSeries.X : PowerSeries k) ^ m) = 1 := by
    simp [PowerSeries.coeff_X_pow]
  have hn : PowerSeries.coeff m ((PowerSeries.X : PowerSeries k) ^ n) = 0 := by
    simp [PowerSeries.coeff_X_pow, hmn]
  rw [hm, hn] at hc
  exact one_ne_zero hc

/-- A nonzero polynomial can be made nonzero at a tuple of power series all of whose entries
lie in `(X)`. This is the specialization needed to send the generic point of the deformation
parameter space through a prescribed nonempty basic open without disturbing the special
fibre. -/
private theorem exists_eval₂_powerSeries_mul_X_ne_zero
    {k : Type u} [Field k] {ι : Type*} (p : MvPolynomial ι k) (hp : p ≠ 0) :
    ∃ a : ι → PowerSeries k,
      MvPolynomial.eval₂ (algebraMap k (PowerSeries k))
        (fun i => PowerSeries.X * a i) p ≠ 0 := by
  classical
  let q : MvPolynomial ι (PowerSeries k) := MvPolynomial.map (algebraMap k (PowerSeries k)) p
  have hq : q ≠ 0 := by
    intro h
    apply hp
    dsimp [q] at h
    have h' : MvPolynomial.map (algebraMap k (PowerSeries k)) p =
        MvPolynomial.map (algebraMap k (PowerSeries k)) 0 := by simpa using h
    exact (MvPolynomial.map_injective (algebraMap k (PowerSeries k))
      (FaithfulSMul.algebraMap_injective k (PowerSeries k))) h'
  have hX : (PowerSeries.X : PowerSeries k) ≠ 0 := PowerSeries.X_ne_zero
  have hinj : Function.Injective (fun b : PowerSeries k => PowerSeries.X * b) := by
    intro a b hab
    exact mul_left_cancel₀ hX hab
  let : Infinite (PowerSeries k) := infinite_powerSeries k
  have hs : ∀ _i : ι, (Set.range (fun b : PowerSeries k => PowerSeries.X * b)).Infinite :=
    fun _ => Set.infinite_range_of_injective hinj
  by_contra h
  push Not at h
  apply hq
  apply MvPolynomial.funext_set
    (fun _ => Set.range (fun b : PowerSeries k => PowerSeries.X * b)) hs
  intro a ha
  have hb : ∀ i, ∃ b : PowerSeries k, a i = PowerSeries.X * b := by
    intro i
    obtain ⟨b, hb⟩ := Set.mem_range.mp ((Set.mem_pi.mp ha) i (Set.mem_univ _))
    exact ⟨b, hb.symm⟩
  have hzero := h (fun i => Classical.choose (hb i))
  have hx : ∀ i, a i = PowerSeries.X * Classical.choose (hb i) :=
    fun i => Classical.choose_spec (hb i)
  rw [MvPolynomial.eval₂_eq_eval_map] at hzero
  have hab : (fun i => PowerSeries.X * Classical.choose (hb i)) = a :=
    funext fun i => (hx i).symm
  rw [hab] at hzero
  exact hzero

/-- A nonzero parameter polynomial stays nonzero under some `k`-algebra map to `k⟦X⟧` sending
every parameter into the maximal ideal `(X)`. -/
private theorem exists_parameterSpecialization_ne_zero
    {k : Type u} [Field k] {n c : ℕ} {p : parameterRing k n c} (hp : p ≠ 0) :
    ∃ φ : parameterRing k n c →ₐ[k] PowerSeries k,
      (∀ i, φ (MvPolynomial.X i) ∈ Ideal.span ({PowerSeries.X} : Set (PowerSeries k))) ∧
        φ p ≠ 0 := by
  obtain ⟨a, ha⟩ := exists_eval₂_powerSeries_mul_X_ne_zero p hp
  let φ : parameterRing k n c →ₐ[k] PowerSeries k :=
    MvPolynomial.aeval (fun i => PowerSeries.X * a i)
  refine ⟨φ, ?_, ?_⟩
  · intro i
    rw [show φ (MvPolynomial.X i) = PowerSeries.X * a i by simp [φ]]
    exact Ideal.mem_span_singleton.mpr ⟨a i, by ring⟩
  · show MvPolynomial.eval₂ (algebraMap k (PowerSeries k))
      (fun i => PowerSeries.X * a i) p ≠ 0
    exact ha

/-- The kernel of the constant coefficient map on power series is the ideal generated by `X`. -/
private theorem ker_constantCoeff_eq_span_X (k : Type u) [Field k] :
    RingHom.ker (PowerSeries.constantCoeff (R := k)) =
      Ideal.span ({PowerSeries.X} : Set (PowerSeries k)) := by
  rw [PowerSeries.ker_coeff_eq_max_ideal, PowerSeries.maximalIdeal_eq_span_X]

/-- A nonempty open subscheme of the spectrum of a domain contains a nonempty basic open. -/
private theorem exists_ne_zero_basicOpen_le
    {R : Type*} [CommRing R] [IsDomain R] (U : (Spec (.of R)).Opens)
    (hU : U ≠ ⊥) :
    ∃ r : R, r ≠ 0 ∧ PrimeSpectrum.basicOpen r ≤ U := by
  have hUnonempty : (U : Set (Spec (.of R))).Nonempty := by
    by_contra h
    exact hU ((TopologicalSpace.Opens.not_nonempty_iff_eq_bot U).mp h)
  obtain ⟨y, hy⟩ := hUnonempty
  obtain ⟨_, ⟨r, rfl⟩, hy, hle⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.isOpen_iff.mp U.isOpen y hy
  have hr : r ≠ 0 := by
    intro hr
    subst r
    change y ∈ (PrimeSpectrum.basicOpen (0 : R) : Set (PrimeSpectrum R)) at hy
    rw [PrimeSpectrum.basicOpen_zero] at hy
    exact hy
  exact ⟨r, hr, hle⟩

/-- Base change of a quotient of a polynomial ring is the quotient of the polynomial ring over
the base by the base-changed equations. -/
private lemma nonempty_baseChangeQuotientEquiv
    {R : Type*} [CommRing R] (K : Type*) [CommRing K] [Algebra R K]
    {ι : Type*} {c : ℕ} (f : Fin c → MvPolynomial ι R) :
    Nonempty
      ((K ⊗[R] (MvPolynomial ι R ⧸ Ideal.span (Set.range f))) ≃ₐ[K]
        (MvPolynomial ι K ⧸
          Ideal.span (Set.range fun i => MvPolynomial.map (algebraMap R K) (f i)))) := by
  refine ⟨(Algebra.TensorProduct.tensorQuotientEquiv K (MvPolynomial ι R) K
      (Ideal.span (Set.range f))).trans
      (Ideal.quotientEquivAlg _ _ (MvPolynomial.algebraTensorAlgEquiv R K) ?_)⟩
  rw [Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
  simp [Function.comp_def]

/-- The special fibre of a `k⟦X⟧`-algebra `B`, written as the quotient of `B` by the ideal
generated by the image of `X`, is the base change of `B` along `k⟦X⟧ → k⟦X⟧/(X)`. -/
private noncomputable def quotientSpanXAlgEquivTensor
    (k : Type u) [Field k] (B : Type u) [CommRing B]
    [Algebra (PowerSeries k) B] [Algebra k B] [IsScalarTower k (PowerSeries k) B] :
    (B ⧸ Ideal.span ({algebraMap (PowerSeries k) B PowerSeries.X} : Set B)) ≃ₐ[B]
      TensorProduct (PowerSeries k) B
        (PowerSeries k ⧸ Ideal.span ({PowerSeries.X} : Set (PowerSeries k))) := by
  classical
  let I : Ideal (PowerSeries k) := Ideal.span {PowerSeries.X}
  let e₁ := Algebra.TensorProduct.tensorQuotientEquiv
      (R := PowerSeries k) (S := B) (T := PowerSeries k) (A := B) I
  let e₂ : (TensorProduct (PowerSeries k) B (PowerSeries k)) ≃ₐ[B] B :=
    Algebra.TensorProduct.rid (PowerSeries k) B B
  have hJ :
      Ideal.span ({algebraMap (PowerSeries k) B PowerSeries.X} : Set B) =
        Ideal.map e₂.toRingHom (Ideal.map Algebra.TensorProduct.includeRight I) := by
    have hcomp : e₂.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom =
        algebraMap (PowerSeries k) B := by
      ext x
      simp [e₂, Algebra.smul_def]
    calc
      Ideal.span ({algebraMap (PowerSeries k) B PowerSeries.X} : Set B) =
          Ideal.map (algebraMap (PowerSeries k) B) I := by
        simp only [I, Ideal.map_span, Set.image_singleton]
      _ = Ideal.map e₂.toRingHom (Ideal.map Algebra.TensorProduct.includeRight I) := by
        rw [← hcomp]
        exact (Ideal.map_map Algebra.TensorProduct.includeRight.toRingHom
          e₂.toRingHom).symm
  let e₃ := Ideal.quotientEquivAlg
    (Ideal.map Algebra.TensorProduct.includeRight I)
    (Ideal.span ({algebraMap (PowerSeries k) B PowerSeries.X} : Set B)) e₂ hJ
  exact (e₁.trans e₃).symm

/-- The `j`-th deformed equation after specializing the parameters along `φ`. -/
private noncomputable def specializedEquation
    {k : Type u} [Field k] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k) (j : Fin c) :
    MvPolynomial (Fin n) (PowerSeries k) :=
  MvPolynomial.map φ.toRingHom (deformedEquation k n c f j)

/-- The coordinate ring over `k⟦X⟧` of the specialized deformation. -/
private noncomputable abbrev specializedCoordinateRing
    {k : Type u} [Field k] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k) :=
  MvPolynomial (Fin n) (PowerSeries k) ⧸
    Ideal.span (Set.range (specializedEquation n c f φ))

/-- The ring structure on the specialized coordinate ring. -/
private noncomputable abbrev specializedCoordinateRing.commRing
    {k : Type u} [Field k] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k) :
    CommRing (specializedCoordinateRing n c f φ) := by
  dsimp [specializedCoordinateRing]
  infer_instance

attribute [local instance] specializedCoordinateRing.commRing

/-- The power series algebra structure on the specialized coordinate ring. -/
private noncomputable abbrev specializedCoordinateRing.powerSeriesAlgebra
    {k : Type u} [Field k] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k) :
    Algebra (PowerSeries k) (specializedCoordinateRing n c f φ) := by
  dsimp [specializedCoordinateRing]
  exact Ideal.Quotient.algebra (PowerSeries k)

attribute [local instance] specializedCoordinateRing.powerSeriesAlgebra

/-- The base field algebra structure on the specialized coordinate ring. -/
private noncomputable abbrev specializedCoordinateRing.fieldAlgebra
    {k : Type u} [Field k] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k) :
    Algebra k (specializedCoordinateRing n c f φ) := by
  dsimp [specializedCoordinateRing]
  exact Ideal.Quotient.algebra k

attribute [local instance] specializedCoordinateRing.fieldAlgebra

/-- The two algebra structures on the specialized coordinate ring are compatible. -/
private theorem specializedCoordinateRing.scalarTower
    {k : Type u} [Field k] (n c : ℕ) (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k) :
    IsScalarTower k (PowerSeries k) (specializedCoordinateRing n c f φ) :=
  IsScalarTower.of_algebraMap_eq (R := k) (S := PowerSeries k)
    (A := specializedCoordinateRing n c f φ) fun _ => rfl

attribute [local instance] specializedCoordinateRing.scalarTower

/-- Specializing the parameters into `(X)` leaves the original equations modulo `X`. -/
private theorem specializedEquation_map_constantCoeff
    {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k)
    (hφ : ∀ i, φ (MvPolynomial.X i) ∈ Ideal.span ({PowerSeries.X} : Set (PowerSeries k)))
    (j : Fin c) :
    MvPolynomial.map PowerSeries.constantCoeff (specializedEquation n c f φ j) = f j := by
  classical
  have hparam (i : Fin c × Fin (n + 1)) :
      PowerSeries.constantCoeff (φ (MvPolynomial.X i)) = 0 :=
    RingHom.mem_ker.mp ((ker_constantCoeff_eq_span_X k).symm ▸ hφ i)
  have hcoeff (a : k) : PowerSeries.constantCoeff (φ (algebraMap k
      (parameterRing k n c) a)) = a := by
    rw [φ.commutes]
    simp
  have hscalar : (PowerSeries.constantCoeff.comp φ.toRingHom).comp
      (MvPolynomial.C : k →+* parameterRing k n c) = RingHom.id k := by
    ext a
    exact hcoeff a
  rw [specializedEquation, MvPolynomial.map_map]
  suffices MvPolynomial.map ((PowerSeries.constantCoeff.comp φ.toRingHom).comp
      MvPolynomial.C) (f j) = f j by
    simpa [deformedEquation, hparam, MvPolynomial.map_map] using this
  rw [hscalar, MvPolynomial.map_id]

/-- The special fibre of the specialized deformation is the original complete intersection. -/
private theorem nonempty_specializedCoordinateRing_specialFiberEquiv
    {k : Type u} [Field k] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k)
    (φ : parameterRing k n c →ₐ[k] PowerSeries k)
    (hφ : ∀ i, φ (MvPolynomial.X i) ∈ Ideal.span ({PowerSeries.X} : Set (PowerSeries k))) :
    Nonempty ((specializedCoordinateRing n c f φ ⧸
      Ideal.span ({algebraMap (PowerSeries k) (specializedCoordinateRing n c f φ)
        PowerSeries.X} : Set (specializedCoordinateRing n c f φ))) ≃ₐ[k]
      (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f))) := by
  classical
  let B := specializedCoordinateRing n c f φ
  let R := PowerSeries k
  let : Algebra R k := PowerSeries.constantCoeff.toAlgebra
  let : IsScalarTower k R k :=
    IsScalarTower.of_algebraMap_eq (R := k) (S := R) (A := k) fun _ => rfl
  let I : Ideal R := Ideal.span {PowerSeries.X}
  let fR : R →ₐ[R] k :=
    { toRingHom := PowerSeries.constantCoeff
      commutes' := by intro a; rfl }
  let eR : (R ⧸ I) ≃ₐ[R] k := by
    have hI : I = RingHom.ker fR.toRingHom := by
      exact (ker_constantCoeff_eq_span_X k).symm
    exact (Ideal.quotientEquivAlgOfEq R hI).trans
      (Ideal.quotientKerAlgEquivOfSurjective (f := fR)
        PowerSeries.constantCoeff_surj)
  let e₁ := quotientSpanXAlgEquivTensor k B
  let e₂ := Algebra.TensorProduct.comm R B (R ⧸ I)
  let e₃ : ((R ⧸ I) ⊗[R] B) ≃ₐ[R] (k ⊗[R] B) :=
    Algebra.TensorProduct.congr eR (AlgEquiv.refl (R := R) (A₁ := B))
  obtain ⟨e₄⟩ := nonempty_baseChangeQuotientEquiv (R := R) (K := k)
    (f := specializedEquation n c f φ)
  have hfun : (fun j : Fin c => MvPolynomial.map PowerSeries.constantCoeff
      (specializedEquation n c f φ j)) = f := by
    funext j
    exact specializedEquation_map_constantCoeff f φ hφ j
  have heq : Ideal.span (Set.range fun j : Fin c =>
      MvPolynomial.map PowerSeries.constantCoeff (specializedEquation n c f φ j)) =
      Ideal.span (Set.range f) := by
    rw [hfun]
  let e₅ : (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range
      fun j : Fin c => MvPolynomial.map (algebraMap R k)
        (specializedEquation n c f φ j))) ≃ₐ[k]
      (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) := by
    apply Ideal.quotientEquivAlg _ _
      (AlgEquiv.refl (R := k) (A₁ := MvPolynomial (Fin n) k))
    rw [show (algebraMap R k : R →+* k) = PowerSeries.constantCoeff by rfl]
    simpa using heq.symm
  refine ⟨?_⟩
  exact (e₁.restrictScalars k).trans
    ((e₂.trans e₃).restrictScalars k |>.trans (e₄.trans e₅))

/-- If the projection to the base is smooth over an open subset `U` and a second base algebra
`K` has image inside `U`, then the base change of the first algebra to `K` is smooth. -/
private theorem smooth_baseChange_of_smooth_resLE
    {R S K : Type u} [CommRing R] [CommRing S] [CommRing K]
    [Algebra R S] [Algebra R K]
    (U : (Spec (.of R)).Opens)
    (hsm : Smooth ((Spec.map (CommRingCat.ofHom (algebraMap R S))).resLE
      U ((Spec.map (CommRingCat.ofHom (algebraMap R S))) ⁻¹ᵁ U) le_rfl))
    (hU : (Spec.map (CommRingCat.ofHom (algebraMap R K))) ⁻¹ᵁ U = ⊤) :
    Algebra.Smooth K (K ⊗[R] S) := by
  let f := Spec.map (CommRingCat.ofHom (algebraMap R S))
  let g := Spec.map (CommRingCat.ofHom (algebraMap R K))
  let a := Spec.map (CommRingCat.ofHom (algebraMap K (K ⊗[R] S)))
  let b := Spec.map (CommRingCat.ofHom
    (Algebra.TensorProduct.includeRight : S →ₐ[R] K ⊗[R] S).toRingHom)
  have H : IsPullback a b g f :=
    isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct R K S)
  have Hb : b ⁻¹ᵁ (f ⁻¹ᵁ U) = ⊤ := by
    rw [← Scheme.Hom.comp_preimage, ← H.w, Scheme.Hom.comp_preimage, hU]
    simp
  have H' := Scheme.Hom.isPullback_resLE H (US := U) (UT := f ⁻¹ᵁ U) (UX := ⊤)
    (UY := ⊤) le_rfl (by rw [hU]) (by simp [Hb])
  have hsm' : Smooth (a.resLE ⊤ ⊤ (by simp)) :=
    MorphismProperty.of_isPullback H'.flip hsm
  let := hsm'
  have hcomp : Smooth ((⊤ : (Spec (.of (K ⊗[R] S))).Opens).ι ≫ a) := by
    rw [← Scheme.Hom.resLE_comp_ι a
      (by simp : (⊤ : (Spec (.of (K ⊗[R] S))).Opens) ≤ a ⁻¹ᵁ ⊤)]
    infer_instance
  let : MorphismProperty.RespectsIso (@AlgebraicGeometry.Smooth.{u}) := by
    rw [HasRingHomProperty.eq_affineLocally (@AlgebraicGeometry.Smooth.{u})]
    exact affineLocally_respectsIso RingHom.Smooth RingHom.Smooth.propertyIsLocal.respectsIso
  have ha : Smooth a :=
    (MorphismProperty.cancel_left_of_respectsIso (@AlgebraicGeometry.Smooth.{u})
      (Spec (.of (K ⊗[R] S))).topIso.hom a).mp hcomp
  exact RingHom.smooth_algebraMap.mp ((HasRingHomProperty.Spec_iff (P := @Smooth)).mp ha)

/-- An open subset containing the zero locus of an element `t` contains a basic open whose
defining element is a unit modulo `t`. -/
private theorem exists_basicOpen_le_of_zeroLocus_subset
    {R : Type*} [CommRing R] (t : R) (U : TopologicalSpace.Opens (PrimeSpectrum R))
    (hU : PrimeSpectrum.zeroLocus {t} ⊆ U) :
    ∃ g : R, Ideal.Quotient.mk (Ideal.span {t}) g = 1 ∧
      PrimeSpectrum.basicOpen g ≤ U := by
  let I := PrimeSpectrum.vanishingIdeal (U : Set (PrimeSpectrum R))ᶜ
  have hI : PrimeSpectrum.zeroLocus (I : Set R) = (U : Set (PrimeSpectrum R))ᶜ := by
    rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, U.isOpen.isClosed_compl.closure_eq]
  have htop : I ⊔ Ideal.span {t} = ⊤ := by
    by_contra hne
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal (I ⊔ Ideal.span {t}) hne
    let := hm
    have hq : (⟨m, inferInstance⟩ : PrimeSpectrum R) ∈ (U : Set (PrimeSpectrum R))ᶜ := by
      rw [← hI]
      exact le_sup_left.trans hle
    apply hq
    apply hU
    intro x hx
    exact hle (Ideal.mem_sup_right (Ideal.subset_span hx))
  obtain ⟨g, hg, b, hb, hgb⟩ := Submodule.mem_sup.mp
    (show (1 : R) ∈ I ⊔ Ideal.span {t} by simp [htop])
  refine ⟨g, ?_, ?_⟩
  · simpa [Ideal.Quotient.eq_zero_iff_mem.mpr hb] using
      congrArg (Ideal.Quotient.mk (Ideal.span {t})) hgb
  · intro q hq
    by_contra hqu
    have hqi : q ∈ PrimeSpectrum.zeroLocus (I : Set R) := by rwa [hI]
    exact hq (hqi hg)

/-- For at least one equation, a specialization of the parameters into `(X)` exists whose
generic fibre is smooth over `k⸨X⸩`. -/
private theorem exists_specialization_smooth_genericFiber_of_one_le
    {k : Type u} [Field k] {n c : ℕ} (hc : 1 ≤ c) (hcn : c ≤ n)
    (f : Fin c → MvPolynomial (Fin n) k) :
    ∃ φ : parameterRing k n c →ₐ[k] PowerSeries k,
      (∀ i, φ (MvPolynomial.X i) ∈ Ideal.span ({PowerSeries.X} : Set (PowerSeries k))) ∧
      Algebra.Smooth (LaurentSeries k)
        (LaurentSeries k ⊗[PowerSeries k] specializedCoordinateRing n c f φ) := by
  classical
  let R := parameterRing k n c
  let S := deformedCoordinateRing k n c f
  let K := LaurentSeries k
  let : CommRing R := inferInstance
  let : CommRing S := inferInstance
  obtain ⟨U, hU, hsm⟩ := exists_nonempty_open_smooth_projection k n c hc hcn f
  obtain ⟨p, hp, hpU⟩ := exists_ne_zero_basicOpen_le U hU
  obtain ⟨φ, hφ, hpφ⟩ := exists_parameterSpecialization_ne_zero hp
  refine ⟨φ, hφ, ?_⟩
  let : Algebra R K := ((algebraMap (PowerSeries k) K).comp φ.toRingHom).toAlgebra
  have hpK : IsUnit (algebraMap R K p) := by
    apply isUnit_iff_ne_zero.mpr
    intro h
    change algebraMap (PowerSeries k) K (φ p) = 0 at h
    exact hpφ ((IsFractionRing.injective (PowerSeries k) K) (by simpa using h))
  have hpre : (Spec.map (CommRingCat.ofHom (algebraMap R K))) ⁻¹ᵁ U = ⊤ := by
    apply top_unique
    intro q _
    apply hpU
    show algebraMap R K p ∉ q.asIdeal
    exact fun h => q.isPrime.ne_top (q.asIdeal.eq_top_of_isUnit_mem h hpK)
  let : Algebra.Smooth K (K ⊗[R] S) := smooth_baseChange_of_smooth_resLE U hsm hpre
  obtain ⟨e₁⟩ := nonempty_baseChangeQuotientEquiv (R := R) K (deformedEquation k n c f)
  obtain ⟨e₂⟩ := nonempty_baseChangeQuotientEquiv (R := PowerSeries k) K
    (specializedEquation n c f φ)
  have heq : (fun j => MvPolynomial.map (algebraMap (PowerSeries k) K)
      (specializedEquation n c f φ j)) =
        (fun j => MvPolynomial.map (algebraMap R K) (deformedEquation k n c f j)) := by
    funext j
    simp only [specializedEquation, MvPolynomial.map_map]
    rfl
  have hI := congrArg (fun F : Fin c → MvPolynomial (Fin n) K =>
    Ideal.span (Set.range F)) heq
  exact Algebra.Smooth.of_equiv
    ((e₁.trans (Ideal.quotientEquivAlgOfEq K hI.symm)).trans e₂.symm)

/-- At a prime containing the image of `X`, the relative dimension of a `k⟦X⟧`-algebra is
bounded by the Krull dimension of its special fibre. -/
private theorem relativeDimensionAt_le_of_specialFiber_ringKrullDim
    {k : Type u} [Field k] {B : Type u} [CommRing B]
    [Algebra (PowerSeries k) B] [Algebra k B] [IsScalarTower k (PowerSeries k) B]
    {d : WithBot ℕ∞}
    (hdim : ringKrullDim
      (B ⧸ Ideal.span {algebraMap (PowerSeries k) B PowerSeries.X}) = d)
    (q : Ideal B) [q.IsPrime] (hq : algebraMap (PowerSeries k) B PowerSeries.X ∈ q) :
    Algebra.relativeDimensionAt (PowerSeries k) q ≤ d := by
  let R := PowerSeries k
  let I : Ideal R := Ideal.span {PowerSeries.X}
  let : I.IsMaximal := by
    dsimp [I]
    rw [← PowerSeries.maximalIdeal_eq_span_X]
    infer_instance
  have hqI : q.under R = I := by
    apply le_antisymm
    · have h := IsLocalRing.le_maximalIdeal_of_isPrime (q.under R)
      change q.under R ≤ IsLocalRing.maximalIdeal (PowerSeries k) at h
      rwa [PowerSeries.maximalIdeal_eq_span_X] at h
    · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hq)
  let eI : (R ⧸ I) ≃ₐ[R] I.ResidueField :=
    AlgEquiv.ofBijective (IsScalarTower.toAlgHom R (R ⧸ I) I.ResidueField)
      I.bijective_algebraMap_quotient_residueField
  let e₁ := Algebra.TensorProduct.congr eI.symm (AlgEquiv.refl (R := R) (A₁ := B))
  let e₂ := (quotientSpanXAlgEquivTensor k B).restrictScalars R
  let e₃ := Algebra.TensorProduct.comm R B (R ⧸ I)
  have hdimI : ringKrullDim (I.Fiber B) = d := by
    calc
      ringKrullDim (I.Fiber B) = ringKrullDim ((R ⧸ I) ⊗[R] B) :=
        ringKrullDim_eq_of_ringEquiv e₁.toRingEquiv
      _ = ringKrullDim (B ⧸ Ideal.span {algebraMap R B PowerSeries.X}) :=
        (ringKrullDim_eq_of_ringEquiv (e₂.trans e₃).toRingEquiv).symm
      _ = d := hdim
  have heq : (⟨q.under R, inferInstance⟩ : PrimeSpectrum R) = ⟨I, inferInstance⟩ :=
    PrimeSpectrum.ext hqI
  have hd := congrArg (fun p : PrimeSpectrum R => ringKrullDim (p.asIdeal.Fiber B)) heq
  exact (Algebra.relativeDimensionAt_le_ringKrullDim_fiber q).trans_eq (hd.trans hdimI)

/-- A presentation whose relative dimension is bounded above along the zero locus of `t`
localizes, near that zero locus, to a relative global complete intersection. -/
private theorem exists_localization_isRelativeGlobalCompleteIntersection
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    {n c : ℕ} (P : Algebra.Presentation R B (Fin n) (Fin c)) (t : B)
    (hbound : ∀ (q : Ideal B) [q.IsPrime], t ∈ q →
      Algebra.relativeDimensionAt R q + c ≤ n) :
    ∃ g : B, Ideal.Quotient.mk (Ideal.span {t}) g = 1 ∧
      ∃ Q : Algebra.Presentation R (Localization.Away g) (Fin (n + 1)) (Fin (c + 1)),
        Q.IsRelativeGlobalCompleteIntersection := by
  classical
  let : Algebra.FinitePresentation R B := P.finitePresentation_of_isFinite
  let U : TopologicalSpace.Opens (PrimeSpectrum B) :=
    ⟨{q | Algebra.relativeDimensionAt R q.asIdeal + c ≤ n},
      Algebra.isOpen_setOf_relativeDimensionAt_add_le c n⟩
  obtain ⟨g, hg, hU⟩ := exists_basicOpen_le_of_zeroLocus_subset t U (by
    intro q hq
    exact hbound q.asIdeal (hq (Set.mem_singleton t)))
  let C := Localization.Away g
  let Q : Algebra.Presentation R C (Fin (n + 1)) (Fin (c + 1)) :=
    ((Algebra.Presentation.localizationAway C g).comp P).reindex
      (Fintype.equivOfCardEq (by simp; omega))
      (Fintype.equivOfCardEq (by simp; omega))
  refine ⟨g, hg, Q, Q.isRelativeGlobalCompleteIntersection_of_relativeDimensionAt_add_le ?_⟩
  intro q hq
  have hgq : g ∉ q.under B := fun h =>
    hq.ne_top (q.eq_top_of_isUnit_mem h (IsLocalization.Away.algebraMap_isUnit g))
  have hb := hU (show (⟨q.under B, inferInstance⟩ : PrimeSpectrum B) ∈
    PrimeSpectrum.basicOpen g from hgq)
  change Algebra.relativeDimensionAt R (q.under B) + c ≤ n at hb
  rw [Algebra.relativeDimensionAt_comap_eq g C q] at hb
  calc
    Algebra.relativeDimensionAt R q + (c + 1 : ℕ) =
        (Algebra.relativeDimensionAt R q + c) + 1 := by push_cast; rw [add_assoc]
    _ ≤ (n : WithBot ℕ∞) + 1 := by simpa only [add_comm] using add_le_add_right hb 1
    _ = (n + 1 : ℕ) := by push_cast; rfl

/-- Inverting an element that is `1` modulo `t` does not change the quotient by `t`. -/
private noncomputable def localizationAwayQuotientEquiv
    {k B : Type*} [CommRing k] [CommRing B] [Algebra k B]
    (t g : B) (hg : Ideal.Quotient.mk (Ideal.span {t}) g = 1) :
    (Localization.Away g ⧸ Ideal.span {algebraMap B (Localization.Away g) t}) ≃ₐ[k]
      (B ⧸ Ideal.span {t}) := by
  let I := Ideal.span {t}
  let C := Localization.Away g
  let J := I.map (algebraMap B C)
  have hJ : J = Ideal.span {algebraMap B C t} := by simp [J, I, Ideal.map_span]
  letI : IsLocalization.Away (algebraMap B (B ⧸ I) g) (C ⧸ J) := by
    change IsLocalization (Submonoid.powers (algebraMap B (B ⧸ I) g)) (C ⧸ J)
    rw [← Submonoid.map_powers]
    exact IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
      (Submonoid.powers g) C I
  have hunit : IsUnit (algebraMap B (B ⧸ I) g) := by
    change IsUnit (Ideal.Quotient.mk I g)
    rw [hg]
    exact isUnit_one
  letI : IsScalarTower k (B ⧸ I) (C ⧸ J) :=
    .of_algebraMap_eq fun x => by
      change Ideal.Quotient.mk J (algebraMap k C x) =
        algebraMap (B ⧸ I) (C ⧸ J) (Ideal.Quotient.mk I (algebraMap k B x))
      rw [Ideal.Quotient.algebraMap_quotient_map_quotient,
        IsScalarTower.algebraMap_apply k B C]
  let e := IsLocalization.atUnit (B ⧸ I) (C ⧸ J) _ hunit
  exact (Ideal.quotientEquivAlgOfEq k hJ.symm).trans (e.restrictScalars k).symm

/-- Base change commutes with inverting an element. -/
private noncomputable def baseChangeLocalizationAwayEquiv
    {R B K : Type u} [CommRing R] [CommRing B] [CommRing K]
    [Algebra R B] [Algebra R K] (g : B) :
    (K ⊗[R] Localization.Away g) ≃ₐ[K]
      Localization.Away (Algebra.TensorProduct.includeRight (R := R) (A := K) g) := by
  let C := Localization.Away g
  letI : Algebra C (K ⊗[R] C) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra B (K ⊗[R] B) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra B (K ⊗[R] C) :=
    ((algebraMap C (K ⊗[R] C)).comp (algebraMap B C)).toAlgebra
  letI : Algebra (K ⊗[R] B) (K ⊗[R] C) :=
    (Algebra.TensorProduct.map (AlgHom.id R K)
      (IsScalarTower.toAlgHom R B C)).toRingHom.toAlgebra
  have : IsScalarTower B C (K ⊗[R] C) := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower B (K ⊗[R] B) (K ⊗[R] C) := .of_algebraMap_eq fun b => by
    simp [RingHom.algebraMap_toAlgebra]
  have : IsScalarTower R (K ⊗[R] B) (K ⊗[R] C) := .of_algebraMap_eq fun r => by
    simp [RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
  have : IsScalarTower K (K ⊗[R] B) (K ⊗[R] C) := .of_algebraMap_eq fun r => by
    simp [RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
  have h1 : Algebra.IsPushout B C (K ⊗[R] B) (K ⊗[R] C) :=
    (Algebra.IsPushout.comp_iff R B K (T := C) (S' := K ⊗[R] B)
      (T' := K ⊗[R] C)).mp inferInstance
  have : IsLocalization (Algebra.algebraMapSubmonoid (K ⊗[R] B) (Submonoid.powers g))
      (K ⊗[R] C) := (Algebra.isLocalization_iff_isPushout (Submonoid.powers g) C).mpr h1.symm
  have hpow : Algebra.algebraMapSubmonoid (K ⊗[R] B) (Submonoid.powers g) =
      Submonoid.powers (Algebra.TensorProduct.includeRight (R := R) (A := K) g) := by
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
    rfl
  rw [hpow] at this
  exact (IsLocalization.algEquiv (Submonoid.powers
    (Algebra.TensorProduct.includeRight (R := R) (A := K) g)) (K ⊗[R] C) _).restrictScalars K

/-- Smoothness of a base change is inherited by the base change of a localization. -/
private theorem smooth_baseChange_localizationAway
    {R B K : Type u} [CommRing R] [CommRing B] [CommRing K]
    [Algebra R B] [Algebra R K] [Algebra.Smooth K (K ⊗[R] B)] (g : B) :
    Algebra.Smooth K (K ⊗[R] Localization.Away g) := by
  let a := Algebra.TensorProduct.includeRight (R := R) (A := K) g
  let : Algebra.Smooth (K ⊗[R] B) (Localization.Away a) :=
    Algebra.Smooth.of_isLocalization_Away a
  let : Algebra.Smooth K (Localization.Away a) :=
    Algebra.Smooth.comp K (K ⊗[R] B) (Localization.Away a)
  exact Algebra.Smooth.of_equiv (baseChangeLocalizationAwayEquiv (K := K) g).symm

/-- A specialization of the parameters into `(X)` with smooth generic fibre exists, with no
hypothesis on the number of equations. -/
private theorem exists_specialization_smooth_genericFiber
    {k : Type u} [Field k] {n c : ℕ} (hcn : c ≤ n)
    (f : Fin c → MvPolynomial (Fin n) k) :
    ∃ φ : parameterRing k n c →ₐ[k] PowerSeries k,
      (∀ i, φ (MvPolynomial.X i) ∈ Ideal.span ({PowerSeries.X} : Set (PowerSeries k))) ∧
      Algebra.Smooth (LaurentSeries k)
        (LaurentSeries k ⊗[PowerSeries k] specializedCoordinateRing n c f φ) := by
  classical
  by_cases hc : c = 0
  · subst c
    let φ : parameterRing k n 0 →ₐ[k] PowerSeries k := MvPolynomial.aeval 0
    refine ⟨φ, fun i => Fin.elim0 i.1, ?_⟩
    have hI : Ideal.span (Set.range (specializedEquation n 0 f φ)) = ⊥ := by
      simp
    let : Algebra.Smooth (PowerSeries k) (MvPolynomial (Fin n) (PowerSeries k)) :=
      ⟨inferInstance, inferInstance⟩
    let : Algebra.Smooth (PowerSeries k) (specializedCoordinateRing n 0 f φ) :=
      Algebra.Smooth.of_equiv
        ((Ideal.quotientEquivAlgOfEq (PowerSeries k) hI).trans
          (AlgEquiv.quotientBot (PowerSeries k)
            (MvPolynomial (Fin n) (PowerSeries k)))).symm
    infer_instance
  · exact exists_specialization_smooth_genericFiber_of_one_le (by omega) hcn f

/-- **Stacks 0E7V.** A global complete intersection `A` over a field `k` is the special fibre
`B/XB` of a flat finite type `k⟦X⟧`-algebra `B` whose generic fibre `k⸨X⸩ ⊗[k⟦X⟧] B` is smooth
over `k⸨X⸩`, and `B` carries a relative global complete intersection presentation whose number
of variables minus number of relations is the Krull dimension of `A` when `A` is nonzero. -/
@[stacks 0E7V "the smoothing of a global complete intersection"]
public theorem exists_flat_powerSeries_specialFiber_smooth_genericFiber
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A]
    (hA : IsGlobalCompleteIntersection k A) :
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra (PowerSeries k) B)
      (_ : Algebra k B) (_ : IsScalarTower k (PowerSeries k) B)
      (_ : Module.Flat (PowerSeries k) B) (_ : Algebra.FiniteType (PowerSeries k) B),
      Nonempty
          ((B ⧸ Ideal.span ({algebraMap (PowerSeries k) B PowerSeries.X} : Set B)) ≃ₐ[k] A) ∧
        Algebra.Smooth (LaurentSeries k)
          (TensorProduct (PowerSeries k) (LaurentSeries k) B) ∧
        ∃ (n c : ℕ) (P : Algebra.Presentation (PowerSeries k) B (Fin n) (Fin c)),
          P.IsRelativeGlobalCompleteIntersection ∧
            (Nontrivial A → ringKrullDim A = ((n - c : ℕ) : WithBot ℕ∞)) := by
  classical
  rcases hA with hzero | ⟨n, c, f, e, hcn, hdim⟩
  · let := hzero
    let B := PUnit.{u + 1}
    let P : Algebra.Presentation (PowerSeries k) B (Fin 1) (Fin 1) :=
      (Algebra.SubmersivePresentation.ofSubsingleton.{u, u, 0, 0}
        (PowerSeries k) B).toPresentation.reindex
        (Fintype.equivOfCardEq (by simp)) (Fintype.equivOfCardEq (by simp))
    have hP : P.IsRelativeGlobalCompleteIntersection :=
      P.isRelativeGlobalCompleteIntersection_of_relativeDimensionAt_add_le
        (fun q hq => False.elim (hq.ne_top (Subsingleton.elim _ _)))
    let : Algebra.IsRelativeGlobalCompleteIntersection (PowerSeries k) B := ⟨⟨1, 1, P, hP⟩⟩
    let := Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection (PowerSeries k) B
    let F := B ⧸ Ideal.span {algebraMap (PowerSeries k) B PowerSeries.X}
    let : Unique F := uniqueOfSubsingleton 0
    let : Unique A := uniqueOfSubsingleton 0
    let eF : F ≃ₐ[k] A :=
      AlgEquiv.ofRingEquiv (f := RingEquiv.ofUnique) (fun _ => Subsingleton.elim _ _)
    let G := LaurentSeries k ⊗[PowerSeries k] B
    let : Algebra.IsStandardSmooth (LaurentSeries k) G :=
      (Algebra.SubmersivePresentation.ofSubsingleton.{u, u, 0, 0}
        (LaurentSeries k) G).isStandardSmooth
    refine ⟨B, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, ⟨eF⟩, inferInstance, 1, 1, P, hP, ?_⟩
    intro hnt
    let := hnt
    exact False.elim (zero_ne_one (Subsingleton.elim (0 : A) 1))
  · obtain ⟨φ, hφ, hsm⟩ := exists_specialization_smooth_genericFiber hcn f
    let B₀ := specializedCoordinateRing n c f φ
    let P : Algebra.Presentation (PowerSeries k) B₀ (Fin n) (Fin c) :=
      Algebra.Presentation.naive (v := specializedEquation n c f φ)
    obtain ⟨e'⟩ := nonempty_specializedCoordinateRing_specialFiberEquiv f φ hφ
    let e₀ := e'.trans e.symm
    have hdim₀ : ringKrullDim
        (B₀ ⧸ Ideal.span {algebraMap (PowerSeries k) B₀ PowerSeries.X}) =
          ((n - c : ℕ) : WithBot ℕ∞) :=
      (ringKrullDim_eq_of_ringEquiv e₀.toRingEquiv).trans hdim
    obtain ⟨g, hg, Q, hQ⟩ := exists_localization_isRelativeGlobalCompleteIntersection P
      (algebraMap (PowerSeries k) B₀ PowerSeries.X) (by
        intro q hq hX
        have hd := relativeDimensionAt_le_of_specialFiber_ringKrullDim hdim₀ q hX
        calc
          Algebra.relativeDimensionAt (PowerSeries k) q + c ≤
              ((n - c : ℕ) : WithBot ℕ∞) + c := by gcongr
          _ = (n : WithBot ℕ∞) := by norm_cast; omega)
    let B := Localization.Away g
    have : IsScalarTower (PowerSeries k) B₀ B := .of_algebraMap_eq fun _ => rfl
    have : IsScalarTower k (PowerSeries k) B := .of_algebraMap_eq fun _ => rfl
    let : Algebra.IsRelativeGlobalCompleteIntersection (PowerSeries k) B :=
      ⟨⟨n + 1, c + 1, Q, hQ⟩⟩
    let := Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection (PowerSeries k) B
    let : Algebra.Smooth (LaurentSeries k) (LaurentSeries k ⊗[PowerSeries k] B₀) := hsm
    have hsmB := smooth_baseChange_localizationAway
      (R := PowerSeries k) (K := LaurentSeries k) g
    have eB : Nonempty ((B ⧸ Ideal.span
        {algebraMap (PowerSeries k) B PowerSeries.X}) ≃ₐ[k] A) := by
      have hX : algebraMap B₀ B (algebraMap (PowerSeries k) B₀ PowerSeries.X) =
          algebraMap (PowerSeries k) B PowerSeries.X :=
        (IsScalarTower.algebraMap_apply (PowerSeries k) B₀ B PowerSeries.X).symm
      exact ⟨(Ideal.quotientEquivAlgOfEq k
          (congrArg (fun b : B => Ideal.span {b}) hX.symm)).trans
        ((localizationAwayQuotientEquiv (k := k) _ g hg).trans e₀)⟩
    refine ⟨B, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, eB, hsmB, n + 1, c + 1, Q, hQ, ?_⟩
    intro _
    simpa using hdim

end Deformation.Examples.Smoothing

