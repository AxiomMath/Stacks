/-!
# The singular incidence locus of the universal affine-linear deformation

Let `f 1, …, f c` be polynomials in `n` variables over a field `k`. Adjoin an independent
parameter for the constant term and for each linear coefficient of each equation, and let `Y` be
the closed subscheme of affine `n`-space over the resulting parameter affine space cut out by
the perturbed equations.

A parameter point over which some zero of the perturbed equations is singular carries a
normalized left-kernel vector for the Jacobian; normalizing one coordinate of that vector to `1`
lets the corresponding row of linear coefficients, and then every constant coefficient, be
solved for in terms of the point, the other kernel coordinates and the remaining coefficients.
The singular incidence locus is therefore the image of a polynomial map from an affine space of
dimension `n + (c - 1) * (n + 1) < c * (n + 1)`, so it satisfies a nonzero polynomial relation in
the parameters. Away from the product of those relations the Jacobian has rank `c` at every
zero.

## Main definitions

* `Deformation.Examples.Smoothing.parameterRing`: the polynomial ring in the deformation
  parameters.
* `Deformation.Examples.Smoothing.deformedEquation`: an equation together with its generic
  affine-linear perturbation.
* `Deformation.Examples.Smoothing.deformedCoordinateRing`: the coordinate ring of `Y`.

## Implementation notes

The parameter index `Fin (n + 1)` uses `0` for the constant coefficient and `i.succ` for the
coefficient of `x i`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory
open scoped TensorProduct

universe u v w

namespace Deformation.Examples.Smoothing

/-- The polynomial ring in the coefficients of the affine-linear perturbations. -/
public abbrev parameterRing (k : Type u) [CommRing k] (n c : ℕ) : Type u :=
  MvPolynomial (Fin c × Fin (n + 1)) k

/-- The `j`-th equation after independently perturbing its constant and linear terms. -/
public noncomputable def deformedEquation (k : Type u) [CommRing k] (n c : ℕ)
    (f : Fin c → MvPolynomial (Fin n) k) (j : Fin c) :
    MvPolynomial (Fin n) (parameterRing k n c) :=
  MvPolynomial.map (MvPolynomial.C : k →+* parameterRing k n c) (f j) +
    MvPolynomial.C (MvPolynomial.X (j, 0)) +
    ∑ i : Fin n, MvPolynomial.C (MvPolynomial.X (j, i.succ)) * MvPolynomial.X i

/-- The coordinate ring of the closed subscheme cut out by all deformed equations. -/
public abbrev deformedCoordinateRing (k : Type u) [CommRing k] (n c : ℕ)
    (f : Fin c → MvPolynomial (Fin n) k) : Type u :=
  MvPolynomial (Fin n) (parameterRing k n c) ⧸
    Ideal.span (Set.range (deformedEquation k n c f))

/-- A polynomial ring in more variables cannot embed as an algebra into one in fewer
variables. This is the transcendence-degree obstruction used in the incidence argument:
after solving for one row of coefficients, the parameter field is generated by fewer
than `c * (n + 1)` independent elements. -/
private theorem no_injective_polynomial_algebraMap {k : Type u} [Field k] {m n : ℕ}
    (hmn : m < n) :
    ¬ ∃ φ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin m) k,
      Function.Injective φ := by
  rintro ⟨φ, hφ⟩
  have htr := trdeg_le_of_injective φ hφ
  rw [MvPolynomial.trdeg_of_isDomain, MvPolynomial.trdeg_of_isDomain] at htr
  exact (not_le_of_gt (by simpa using hmn)) htr

/-- If a normalized nonzero row vector is in the left kernel of a matrix, its first
coefficient in each column is determined by the other rows. This is the coefficient
elimination step in the singular-incidence parameter count. -/
private theorem solve_first_row_of_kernel {F : Type u} [Field F] {c n : ℕ}
    (lam : Fin c → F) (D A : Fin c → Fin n → F) (j₀ : Fin c) (hlam : lam j₀ = 1)
    (hker : ∀ i, ∑ j : Fin c, lam j * (D j i + A j i) = 0) (i : Fin n) :
    A j₀ i = -D j₀ i - ∑ j ∈ Finset.univ.erase j₀, lam j * (D j i + A j i) := by
  have h := hker i
  rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ j₀)] at h
  simp only [hlam, one_mul] at h
  linear_combination h

/-- A rank-deficient matrix has a nonzero left-kernel vector, which can be
normalized at any one of its nonzero coordinates. -/
private theorem exists_normalized_left_kernel {F : Type u} [Field F] {c n : ℕ}
    (M : Matrix (Fin c) (Fin n) F) (hM : M.rank < c) :
    ∃ j₀ : Fin c, ∃ lam : Fin c → F,
      lam j₀ = 1 ∧ ∀ i, ∑ j : Fin c, lam j * M j i = 0 := by
  classical
  let L := M.transpose.mulVecLin
  have hrank : Module.finrank F L.range = M.rank := Matrix.rank_transpose M
  have hsource : Module.finrank F (Fin c → F) = c := by simp
  have hnull := LinearMap.finrank_range_add_finrank_ker L
  have hker : L.ker ≠ ⊥ := by
    apply (Submodule.one_le_finrank_iff).mp
    omega
  obtain ⟨v, hv, hvne⟩ := (Submodule.ne_bot_iff _).mp hker
  have hvec : M.transpose.mulVec v = 0 := LinearMap.mem_ker.mp hv
  have hvfun : v ≠ 0 := fun h => hvne (by simp [h])
  obtain ⟨j₀, hj₀⟩ : ∃ j₀, v j₀ ≠ 0 := by
    by_contra h
    apply hvfun
    funext j
    simpa using not_exists.mp h j
  let lam : Fin c → F := fun j => v j / v j₀
  refine ⟨j₀, lam, ?_, ?_⟩
  · simp [lam, hj₀]
  · intro i
    have hsum : ∑ j : Fin c, v j * M j i = 0 := by
      simpa [Matrix.mulVec, dotProduct, Matrix.transpose_apply, mul_comm] using congrFun hvec i
    simp only [lam, div_mul_eq_mul_div, ← Finset.sum_div, hsum, zero_div]

/-- Full row rank is detected by an invertible maximal square submatrix. -/
private theorem exists_injective_columns_det_ne_zero {F : Type u} [Field F]
    {m n : ℕ} (M : Matrix (Fin m) (Fin n) F) (hM : M.rank = m) :
    ∃ a : Fin m → Fin n, Function.Injective a ∧ (M.submatrix id a).det ≠ 0 := by
  classical
  have hdim : Module.finrank F (Submodule.span F (Set.range M.col)) = m :=
    (Matrix.rank_eq_finrank_span_cols M).symm.trans hM
  obtain ⟨v, hv, hvspan, hvli⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq F (Set.range M.col)
  let e : Fin m ≃ Fin (Module.finrank F (Submodule.span F (Set.range M.col))) :=
    Fintype.equivOfCardEq (by simp [hdim])
  let a : Fin m → Fin n := fun i => Classical.choose (hv (e i))
  have ha : ∀ i, M.col (a i) = v (e i) := fun i => Classical.choose_spec (hv (e i))
  have hli : LinearIndependent F (fun i : Fin m => v (e i)) := hvli.comp e e.injective
  have hai : Function.Injective a := by
    intro i j hij
    have hvec : v (e i) = v (e j) := by rw [← ha i, ← ha j, hij]
    exact hli.injective hvec
  have hcols : LinearIndependent F (M.submatrix id a).col := by
    show LinearIndependent F (fun i => M.col (a i))
    rwa [show (fun i => M.col (a i)) = fun i => v (e i) from funext ha]
  exact ⟨a, hai, ((Matrix.isUnit_iff_isUnit_det _).mp
    (Matrix.linearIndependent_cols_iff_isUnit.mp hcols)).ne_zero⟩

/-- Coordinates for the incidence variety after normalizing one nonzero kernel
coordinate to `1`: the point coordinates, the remaining kernel coordinates,
and all matrix coefficients outside the solved row. -/
private abbrev incidenceVariables (n c : ℕ) (j₀ : Fin c) :=
  Fin n ⊕ ({j : Fin c // j ≠ j₀} × Option (Fin n))

private theorem incidenceVariables_card (n c : ℕ) (j₀ : Fin c) :
    Fintype.card (incidenceVariables n c j₀) = n + (c - 1) * (n + 1) := by
  classical
  simp [incidenceVariables, Fintype.card_subtype_compl]

private theorem incidenceVariables_card_lt (n c : ℕ) (hc : 1 ≤ c)
    (j₀ : Fin c) : Fintype.card (incidenceVariables n c j₀) < c * (n + 1) := by
  rw [incidenceVariables_card]
  nlinarith [Nat.sub_add_cancel hc]

/-- The polynomial map evaluating the original variables at the incidence point. -/
private noncomputable def incidencePointMap {k : Type u} [CommRing k] {n c : ℕ}
    (j₀ : Fin c) : MvPolynomial (Fin n) k →ₐ[k]
      MvPolynomial (incidenceVariables n c j₀) k :=
  MvPolynomial.aeval (fun i => MvPolynomial.X (Sum.inl i))

/-- In the normalized incidence chart, the first row of the coefficient matrix
is recovered from the kernel equations; every other coefficient remains a free
incidence coordinate. -/
private noncomputable def incidenceLinearParameter {k : Type u} [CommRing k]
    {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j₀ : Fin c)
    (j : Fin c) (i : Fin n) : MvPolynomial (incidenceVariables n c j₀) k := by
  classical
  exact if hj : j = j₀ then
    -incidencePointMap j₀ (MvPolynomial.pderiv i (f j₀)) -
      ∑ j' : {j : Fin c // j ≠ j₀},
        MvPolynomial.X (Sum.inr (j', none)) *
          (incidencePointMap j₀ (MvPolynomial.pderiv i (f j'.val)) +
            MvPolynomial.X (Sum.inr (j', some i)))
  else
    MvPolynomial.X (Sum.inr (⟨j, hj⟩, some i))

/-- Each constant coefficient is determined by the corresponding equation after
the point and all linear coefficients have been chosen. -/
private noncomputable def incidenceConstantParameter {k : Type u} [CommRing k]
    {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j₀ : Fin c)
    (j : Fin c) : MvPolynomial (incidenceVariables n c j₀) k :=
  -incidencePointMap j₀ (f j) -
    ∑ i : Fin n,
      incidenceLinearParameter f j₀ j i * MvPolynomial.X (Sum.inl i)

/-- The singular incidence chart gives all deformation parameters as polynomials
in the point, normalized kernel vector, and the unsolved matrix coefficients. -/
private noncomputable def incidenceParameterMap {k : Type u} [CommRing k]
    {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j₀ : Fin c) :
    parameterRing k n c →ₐ[k] MvPolynomial (incidenceVariables n c j₀) k :=
  MvPolynomial.aeval (fun p : Fin c × Fin (n + 1) =>
    Fin.cases (incidenceConstantParameter f j₀ p.1)
      (fun i => incidenceLinearParameter f j₀ p.1 i) p.2)

private theorem eval_deformedEquation {k F : Type u} [Field k] [Field F]
    [Algebra k F] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j : Fin c)
    (θ : parameterRing k n c →ₐ[k] F) (x : Fin n → F) :
    MvPolynomial.aeval x (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j)) =
      MvPolynomial.aeval x (MvPolynomial.map (algebraMap k F) (f j)) +
        θ (MvPolynomial.X (j, 0)) +
        ∑ i : Fin n, θ (MvPolynomial.X (j, i.succ)) * x i := by
  have hcomp := θ.comp_algebraMap
  rw [MvPolynomial.algebraMap_eq] at hcomp
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
  simp [deformedEquation, MvPolynomial.aeval_def, MvPolynomial.eval₂_map, hcomp,
    MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X,
    MvPolynomial.eval₂_C]

private theorem eval_pderiv_deformedEquation {k F : Type u} [Field k] [Field F]
    [Algebra k F] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j : Fin c)
    (i : Fin n) (θ : parameterRing k n c →ₐ[k] F) (x : Fin n → F) :
    MvPolynomial.aeval x (MvPolynomial.pderiv i
      (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j))) =
      MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)) +
        θ (MvPolynomial.X (j, i.succ)) := by
  have hcomp := θ.comp_algebraMap
  rw [MvPolynomial.algebraMap_eq] at hcomp
  simp [deformedEquation, MvPolynomial.pderiv_map, MvPolynomial.pderiv_X,
    MvPolynomial.aeval_def, hcomp, Pi.single_apply, apply_ite,
    Finset.sum_ite_eq']

private theorem constant_parameter_of_equation_zero {k F : Type u} [Field k] [Field F]
    [Algebra k F] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j : Fin c)
    (θ : parameterRing k n c →ₐ[k] F) (x : Fin n → F)
    (hzero : MvPolynomial.aeval x
      (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j)) = 0) :
    θ (MvPolynomial.X (j, 0)) =
      -MvPolynomial.aeval x (f j) -
        ∑ i : Fin n, θ (MvPolynomial.X (j, i.succ)) * x i := by
  rw [eval_deformedEquation] at hzero
  have hcoeff : MvPolynomial.aeval x (MvPolynomial.map (algebraMap k F) (f j)) =
      MvPolynomial.aeval x (f j) := by
    simp [MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
  rw [hcoeff] at hzero
  linear_combination hzero

/-- The incidence parameterization has a nonzero polynomial relation, since its
target has one fewer independent coordinate than the full parameter space. -/
private theorem incidenceParameterMap_has_nonzero_relation {k : Type u} [Field k]
    {n c : ℕ} (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k) (j₀ : Fin c) :
    ∃ p : parameterRing k n c, p ≠ 0 ∧ incidenceParameterMap f j₀ p = 0 := by
  classical
  let e : (Fin c × Fin (n + 1)) ≃ Fin (c * (n + 1)) :=
    (Fintype.equivFin (Fin c × Fin (n + 1))).trans
      (Equiv.cast (by simp [Fintype.card_prod]))
  let ePoly := MvPolynomial.renameEquiv k e
  let eVars := Fintype.equivFin (incidenceVariables n c j₀)
  let eRename := MvPolynomial.renameEquiv k eVars
  let φ : MvPolynomial (Fin (c * (n + 1))) k →ₐ[k]
      MvPolynomial (Fin (Fintype.card (incidenceVariables n c j₀))) k :=
    eRename.toAlgHom.comp ((incidenceParameterMap f j₀).comp ePoly.symm.toAlgHom)
  have hnot := no_injective_polynomial_algebraMap (k := k)
    (m := Fintype.card (incidenceVariables n c j₀)) (n := c * (n + 1))
    (incidenceVariables_card_lt n c hc j₀)
  have hφ : ¬ Function.Injective φ := by
    intro hinj
    exact hnot ⟨φ, hinj⟩
  obtain ⟨a, b, hab, hφab⟩ := Function.not_injective_iff.mp hφ
  refine ⟨ePoly.symm a - ePoly.symm b, ?_, ?_⟩
  · intro heq
    apply hφab
    apply ePoly.symm.injective
    exact sub_eq_zero.mp heq
  · rw [map_sub]
    have hφab' : eRename (incidenceParameterMap f j₀ (ePoly.symm a)) =
        eRename (incidenceParameterMap f j₀ (ePoly.symm b)) := by
      change φ a = φ b at hab
      exact hab
    have hmap : incidenceParameterMap f j₀ (ePoly.symm a) =
        incidenceParameterMap f j₀ (ePoly.symm b) := eRename.injective hφab'
    rw [hmap]
    exact sub_self _

/-- Evaluation of the incidence coordinates at a point, a normalized kernel
vector, and the unsolved rows of its coefficient matrix. -/
private noncomputable def incidenceEvaluation {k F : Type u} [Field k] [Field F]
    [Algebra k F] {n c : ℕ} (j₀ : Fin c) (x : Fin n → F)
    (lam : Fin c → F) (A : Fin c → Fin n → F) :
    MvPolynomial (incidenceVariables n c j₀) k →ₐ[k] F := by
  classical
  exact MvPolynomial.aeval (fun v =>
    match v with
    | Sum.inl i => x i
    | Sum.inr (j, none) => lam j.val
    | Sum.inr (j, some i) => A j.val i)

private theorem incidenceEvaluation_point {k F : Type u} [Field k] [Field F]
    [Algebra k F] {n c : ℕ} (j₀ : Fin c) (x : Fin n → F)
    (lam : Fin c → F) (A : Fin c → Fin n → F) (p : MvPolynomial (Fin n) k) :
    incidenceEvaluation j₀ x lam A (incidencePointMap j₀ p) =
      MvPolynomial.aeval (R := k) x p := by
  show ((incidenceEvaluation j₀ x lam A).comp (incidencePointMap j₀)) p = _
  congr 1
  ext i
  simp [incidenceEvaluation, incidencePointMap]

private theorem incidenceEvaluation_linearParameter {k F : Type u} [Field k] [Field F]
    [Algebra k F] {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k)
    (j₀ : Fin c) (x : Fin n → F) (lam : Fin c → F) (A : Fin c → Fin n → F)
    (hlam : lam j₀ = 1)
    (hkernel : ∀ i, ∑ j : Fin c,
      lam j * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)) + A j i) = 0)
    (j : Fin c) (i : Fin n) :
    incidenceEvaluation j₀ x lam A (incidenceLinearParameter f j₀ j i) = A j i := by
  classical
  by_cases hj : j = j₀
  · subst j
    have hsolve := solve_first_row_of_kernel
      (fun j => lam j)
      (fun j i => MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)))
      A j₀ hlam hkernel i
    have hsum :
        (∑ j' : {j : Fin c // j ≠ j₀},
          lam j'.val * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j'.val)) +
            A j'.val i)) =
        ∑ j ∈ Finset.univ.erase j₀,
          lam j * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)) + A j i) := by
      symm
      exact Finset.sum_subtype (Finset.univ.erase j₀) (by intro j; simp) _
    calc
      incidenceEvaluation j₀ x lam A (incidenceLinearParameter f j₀ j₀ i) =
          -MvPolynomial.aeval x (MvPolynomial.pderiv i (f j₀)) -
            ∑ j' : {j : Fin c // j ≠ j₀},
              lam j'.val * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j'.val)) +
                A j'.val i) := by
          rw [incidenceLinearParameter, dite_eq_left rfl]
          simp only [map_sub, map_neg, map_sum, map_mul, map_add]
          rw [incidenceEvaluation_point]
          congr 1
          apply Finset.sum_congr rfl
          intro j' hj'
          rw [incidenceEvaluation_point]
          simp [incidenceEvaluation]
      _ = A j₀ i := by rw [hsum]; exact hsolve.symm
  · simp [incidenceLinearParameter, incidenceEvaluation, hj]

/-- The defining equations of the singular incidence chart make the parameter
map factor through the polynomial ring on the remaining incidence coordinates. -/
private theorem incidenceParameterMap_factors
    {k F : Type u} [Field k] [Field F] [Algebra k F]
    {n c : ℕ} (f : Fin c → MvPolynomial (Fin n) k) (j₀ : Fin c)
    (x : Fin n → F) (lam : Fin c → F) (A : Fin c → Fin n → F)
    (θ : parameterRing k n c →ₐ[k] F) (hlam : lam j₀ = 1)
    (hkernel : ∀ i, ∑ j : Fin c,
      lam j * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)) + A j i) = 0)
    (hlinear : ∀ j i, θ (MvPolynomial.X (j, i.succ)) = A j i)
    (hconstant : ∀ j, θ (MvPolynomial.X (j, 0)) =
      -MvPolynomial.aeval x (f j) - ∑ i : Fin n, A j i * x i) :
    θ = (incidenceEvaluation j₀ x lam A).comp (incidenceParameterMap f j₀) := by
  classical
  apply MvPolynomial.algHom_ext
  intro p
  rcases p with ⟨j, i⟩
  cases i using Fin.cases
  · rw [AlgHom.comp_apply]
    simp [incidenceParameterMap, hconstant, incidenceConstantParameter,
      incidenceEvaluation_point, incidenceEvaluation_linearParameter f j₀ x lam A
        hlam hkernel]
    simp [incidenceEvaluation]
  · rename_i i
    rw [AlgHom.comp_apply, hlinear j i]
    simp [incidenceParameterMap,
      incidenceEvaluation_linearParameter f j₀ x lam A hlam hkernel j i]

/-- A single nonzero parameter polynomial whose vanishing contains every
normalized singular-incidence chart. -/
private noncomputable def singularParameterPolynomial {k : Type u} [Field k]
    {n c : ℕ} (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k) :
    parameterRing k n c := by
  classical
  exact ∏ j₀ : Fin c,
    Classical.choose (incidenceParameterMap_has_nonzero_relation hc f j₀)

private theorem singularParameterPolynomial_ne_zero {k : Type u} [Field k]
    {n c : ℕ} (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k) :
    singularParameterPolynomial hc f ≠ 0 := by
  classical
  exact Finset.prod_ne_zero_iff.mpr fun j₀ _ =>
    (Classical.choose_spec (incidenceParameterMap_has_nonzero_relation hc f j₀)).1

/-- A parameter point with a normalized singular vector is excluded from the
principal open defined by `singularParameterPolynomial`. -/
private theorem singularParameterPolynomial_vanishes {k F : Type u}
    [Field k] [Field F] [Algebra k F] {n c : ℕ}
    (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k)
    (j₀ : Fin c) (x : Fin n → F) (lam : Fin c → F) (A : Fin c → Fin n → F)
    (θ : parameterRing k n c →ₐ[k] F) (hlam : lam j₀ = 1)
    (hkernel : ∀ i, ∑ j : Fin c,
      lam j * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)) + A j i) = 0)
    (hlinear : ∀ j i, θ (MvPolynomial.X (j, i.succ)) = A j i)
    (hconstant : ∀ j, θ (MvPolynomial.X (j, 0)) =
      -MvPolynomial.aeval x (f j) - ∑ i : Fin n, A j i * x i) :
    θ (singularParameterPolynomial hc f) = 0 := by
  classical
  let p := Classical.choose (incidenceParameterMap_has_nonzero_relation hc f j₀)
  have hpm : incidenceParameterMap f j₀ p = 0 :=
    (Classical.choose_spec (incidenceParameterMap_has_nonzero_relation hc f j₀)).2
  have hθp : θ p = 0 := by
    rw [incidenceParameterMap_factors f j₀ x lam A θ hlam hkernel hlinear hconstant,
      AlgHom.comp_apply, hpm]
    simp
  rw [singularParameterPolynomial]
  simp only [map_prod]
  exact Finset.prod_eq_zero (Finset.mem_univ j₀) hθp

/-- The equations and a left-kernel vector for their Jacobian already force the
parameter point into the excluded hypersurface. -/
private theorem singular_equations_parameter_polynomial_zero {k F : Type u}
    [Field k] [Field F] [Algebra k F] {n c : ℕ}
    (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k)
    (x : Fin n → F) (lam : Fin c → F)
    (θ : parameterRing k n c →ₐ[k] F) (j₀ : Fin c) (hlam : lam j₀ = 1)
    (hzero : ∀ j, MvPolynomial.aeval x
      (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j)) = 0)
    (hjac : ∀ i, ∑ j : Fin c, lam j * MvPolynomial.aeval x
      (MvPolynomial.pderiv i
        (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j))) = 0) :
    θ (singularParameterPolynomial hc f) = 0 := by
  let A : Fin c → Fin n → F := fun j i => θ (MvPolynomial.X (j, i.succ))
  have hkernel : ∀ i, ∑ j : Fin c,
      lam j * (MvPolynomial.aeval x (MvPolynomial.pderiv i (f j)) + A j i) = 0 := by
    intro i
    convert hjac i using 1
    apply Finset.sum_congr rfl
    intro j hj
    rw [eval_pderiv_deformedEquation]
  have hconstant : ∀ j, θ (MvPolynomial.X (j, 0)) =
      -MvPolynomial.aeval x (f j) - ∑ i : Fin n, A j i * x i := by
    intro j
    simpa [A] using constant_parameter_of_equation_zero f j θ x (hzero j)
  exact singularParameterPolynomial_vanishes hc f j₀ x lam A θ hlam hkernel
    (fun _ _ => rfl) hconstant

private theorem singularParameter_open_ne_bot {k : Type u} [Field k]
    {n c : ℕ} (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k) :
    (PrimeSpectrum.basicOpen (singularParameterPolynomial hc f) :
      (Spec (.of (parameterRing k n c))).Opens) ≠ ⊥ := by
  intro h
  have hg := singularParameterPolynomial_ne_zero hc f
  have hn : IsNilpotent (singularParameterPolynomial hc f) :=
    (PrimeSpectrum.basicOpen_eq_bot_iff _).mp h
  exact hg hn.eq_zero

/-- Over the principal open just constructed, every common zero of the deformed
equations has Jacobian rank `c`. -/
private theorem jacobian_full_rank_at_good_parameter {k F : Type u}
    [Field k] [Field F] [Algebra k F] {n c : ℕ}
    (hc : 1 ≤ c) (f : Fin c → MvPolynomial (Fin n) k)
    (θ : parameterRing k n c →ₐ[k] F) (hgood : θ (singularParameterPolynomial hc f) ≠ 0)
    (x : Fin n → F)
    (hzero : ∀ j, MvPolynomial.aeval x
      (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j)) = 0) :
    (Matrix.of fun (j : Fin c) (i : Fin n) =>
      MvPolynomial.aeval x (MvPolynomial.pderiv i
        (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j)))).rank = c := by
  let J : Matrix (Fin c) (Fin n) F := fun j i =>
    MvPolynomial.aeval x (MvPolynomial.pderiv i
      (MvPolynomial.map θ.toRingHom (deformedEquation k n c f j)))
  have hle : J.rank ≤ c := by
    simpa using J.rank_le_card_height
  by_contra hneq
  have hlt : J.rank < c := Nat.lt_of_le_of_ne hle hneq
  obtain ⟨j₀, lam, hlam, hkernel⟩ := exists_normalized_left_kernel J hlt
  have hvanish := singular_equations_parameter_polynomial_zero hc f x lam θ
    j₀ hlam hzero hkernel
  exact hgood hvanish

end Deformation.Examples.Smoothing

