/-!
# The canonical ideal maps of the source thickenings are natural along morphisms of deformations

Let `f : X ⟶ Y` be a morphism of schemes over `k` and `a : Y'_x ⟶ Y'_y` a morphism of
deformations of `Y` over the map `k[M] ⟶ k[N]` of `g : M ⟶ N`. The map
`ρ : f⁻¹𝒪_{Y'_x} ⟶ f⁻¹𝒪_{Y'_y}` it induces carries the ideal of the first source thickening
into the ideal of the second, and the canonical maps of these ideals to `𝒪_X ⊗_k M` and
`𝒪_X ⊗_k N` (`Deformation.Examples.schemeMorphismSourceIdeal`) commute with `ρ` and `𝒪_X ⊗_k g`.
Both composites are restriction data for the reduction of `f⁻¹𝒪_{Y'_x}`, and the ideal is locally
generated by the sections `ũ(m)` induced by the functions `(0, m)`, on which the two agree.

## Main definitions

* `Stacks.Sites.Conormal.IdealRestriction.comapOfFac`: a restriction datum precomposed with a
  factorisation of presentations.

## Main results

* `Stacks.Sites.Conormal.IdealRestriction.app_eq_of_generators`: two restriction data agreeing
  on global sections which locally generate the ideal agree.
* `Deformation.Examples.schemeMorphismSourceIdeal_transition`: the canonical ideal maps commute
  with the map induced by a morphism of deformations.

## References

* [Stacks Project, Tag 0E3V](https://stacks.math.columbia.edu/tag/0E3V)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.Sites.Conormal

section Fac

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  {A₁ A₂ B : Sheaf J CommRingCat.{u}} {φ₁ : A₁ ⟶ B} {φ₂ : A₂ ⟶ B}
  {G : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf B)}

/-- **A restriction datum precomposed with a factorisation of presentations**: for
`ψ : 𝒜₁ ⟶ 𝒜₂` with `ψ ≫ φ₂ = φ₁`, a restriction datum `Ker φ₂ ⟶ 𝒢` gives one on `Ker φ₁`,
`z ↦ ρ(ψ z)`. -/
def IdealRestriction.comapOfFac (ρ : IdealRestriction.{u, u, u, u} φ₂ G) (ψ : A₁ ⟶ A₂)
    (hψ : ψ ≫ φ₂ = φ₁) : IdealRestriction.{u, u, u, u} φ₁ G where
  app X :=
    { toFun := fun z => ρ.app X ⟨(ψ.hom.app X).hom z,
        kernelIdeal_le_comap φ₁.hom φ₂.hom ψ.hom (hom_of_comp_eq hψ) X z.2⟩
      map_zero' := (congrArg (ρ.app X) (Subtype.ext (map_zero (ψ.hom.app X).hom))).trans
        (map_zero _)
      map_add' := fun z z' => (congrArg (ρ.app X)
        (Subtype.ext (map_add (ψ.hom.app X).hom z.1 z'.1))).trans (map_add _ _ _) }
  app_smul X r z := by
    have hs : presentationScalar φ₂ X ((ψ.hom.app X).hom r) = presentationScalar φ₁ X r :=
      congrArg (fun t : A₁ ⟶ B => (t.hom.app X).hom r) hψ
    have e : (⟨(ψ.hom.app X).hom (r • z).1, kernelIdeal_le_comap φ₁.hom φ₂.hom ψ.hom
        (hom_of_comp_eq hψ) X (r • z).2⟩ : ↥(kernelIdeal φ₂.hom X)) =
        (ψ.hom.app X).hom r • ⟨(ψ.hom.app X).hom z.1, kernelIdeal_le_comap φ₁.hom φ₂.hom ψ.hom
          (hom_of_comp_eq hψ) X z.2⟩ :=
      Subtype.ext (map_mul (ψ.hom.app X).hom r z.1)
    refine (congrArg (ρ.app X) e).trans ?_
    refine (ρ.app_smul X ((ψ.hom.app X).hom r) ⟨(ψ.hom.app X).hom z,
      kernelIdeal_le_comap φ₁.hom φ₂.hom ψ.hom (hom_of_comp_eq hψ) X z.2⟩).trans ?_
    exact congrArg (· • _) hs
  app_map {X Y} f z := by
    refine (congrArg (ρ.app Y) (Subtype.ext ?_)).trans (ρ.app_map f _)
    exact congrArg (fun t => t.hom z.1) (ψ.hom.naturality f)

omit [J.HasSheafCompose (forget₂ CommRingCat RingCat)] in
/-- The restriction datum `ρ.comapOfFac ψ hψ` sends a section `z` of `Ker φ₁` to `ρ(ψ z)`. -/
theorem IdealRestriction.comapOfFac_app (ρ : IdealRestriction.{u, u, u, u} φ₂ G) (ψ : A₁ ⟶ A₂)
    (hψ : ψ ≫ φ₂ = φ₁) (X : Cᵒᵖ) (z : ↥(kernelIdeal φ₁.hom X)) :
    (ρ.comapOfFac ψ hψ).app X z = ρ.app X ⟨(ψ.hom.app X).hom z,
      kernelIdeal_le_comap φ₁.hom φ₂.hom ψ.hom (hom_of_comp_eq hψ) X z.2⟩ :=
  rfl

end Fac

section Generators

variable {X : TopCat.{u}} {A B : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}
  {φ : A ⟶ B} {G : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf B)}
  (ρ σ : IdealRestriction.{u, u, u, u} φ G)

/-- On the ideal generated by sections of the kernel on which they agree, two restriction data
agree. -/
theorem IdealRestriction.app_eq_of_mem_span {V : Opens X} {S : Set ↥(A.obj.obj (op V))}
    (hS : ∀ z ∈ S, ∃ hz : z ∈ kernelIdeal φ.hom (op V),
      ρ.app (op V) ⟨z, hz⟩ = σ.app (op V) ⟨z, hz⟩)
    {z : ↥(A.obj.obj (op V))} (hz₀ : z ∈ Ideal.span S) (hz : z ∈ kernelIdeal φ.hom (op V)) :
    ρ.app (op V) ⟨z, hz⟩ = σ.app (op V) ⟨z, hz⟩ := by
  have hk : ∀ {y}, y ∈ Ideal.span S → y ∈ kernelIdeal φ.hom (op V) := fun hy =>
    Ideal.span_le.2 (fun y hy => (hS y hy).1) hy
  induction hz₀ using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨_, h⟩ := hS y hy
    exact h
  | zero => exact (map_zero (ρ.app (op V))).trans (map_zero (σ.app (op V))).symm
  | add y y' hy hy' ih ih' =>
    exact (map_add (ρ.app (op V)) ⟨y, hk hy⟩ ⟨y', hk hy'⟩).trans
      ((congrArg₂ (· + ·) (ih (hk hy)) (ih' (hk hy'))).trans
        (map_add (σ.app (op V)) ⟨y, hk hy⟩ ⟨y', hk hy'⟩).symm)
  | smul r y hy ih =>
    exact (ρ.app_smul (op V) r ⟨y, hk hy⟩).trans ((congrArg (_ • ·) (ih (hk hy))).trans
      (σ.app_smul (op V) r ⟨y, hk hy⟩).symm)

/-- **Restriction data are determined on local generators of the ideal.** If the kernel of
`φ` is locally generated by global sections `u m` on which two restriction data agree, then they
agree. -/
theorem IdealRestriction.app_eq_of_generators {I : Type*} (u : I → ↥(A.obj.obj (op ⊤)))
    (hu : ∀ m, u m ∈ kernelIdeal φ.hom (op ⊤))
    (hgen : ∀ (V : Opens X) (z : ↥(A.obj.obj (op V))), z ∈ kernelIdeal φ.hom (op V) →
      ∃ (J : Type u) (W : J → Opens X) (hW : ∀ j, W j ≤ V), V ≤ iSup W ∧
        ∀ j, (A.obj.map (homOfLE (hW j)).op).hom z ∈
          Ideal.span (Set.range fun m => (A.obj.map (homOfLE (le_top (a := W j))).op).hom (u m)))
    (h : ∀ m, ρ.app (op ⊤) ⟨u m, hu m⟩ = σ.app (op ⊤) ⟨u m, hu m⟩)
    (V : (Opens X)ᵒᵖ) (z : ↥(kernelIdeal φ.hom V)) : ρ.app V z = σ.app V z := by
  obtain ⟨V⟩ := V
  obtain ⟨J, W, hW, hcov, hz⟩ := hgen V z.1 z.2
  refine TopCat.Sheaf.eq_of_locally_eq' (IdealRestriction.LocalRule.abSheaf (G := G)) W V
    (fun j => homOfLE (hW j)) hcov _ _ fun j => ?_
  change G.val.map (homOfLE (hW j)).op (ρ.app (op V) z) =
    G.val.map (homOfLE (hW j)).op (σ.app (op V) z)
  refine (ρ.app_map (homOfLE (hW j)).op z).symm.trans (Eq.trans ?_ (σ.app_map _ z))
  refine ρ.app_eq_of_mem_span σ ?_ (hz j) _
  rintro _ ⟨m, rfl⟩
  exact ⟨map_kernel φ.hom (homOfLE (le_top (a := W j))).op (hu m),
    (ρ.app_map (homOfLE (le_top (a := W j))).op ⟨u m, hu m⟩).trans ((congrArg _ (h m)).trans
      (σ.app_map (homOfLE (le_top (a := W j))).op ⟨u m, hu m⟩).symm)⟩

end Generators

end Stacks.Sites.Conormal

namespace Deformation.Examples

open AlgebraicGeometry Stacks.Sites.Conormal

variable {Λ k : Type u} [CommRing Λ] [Field k] [Algebra Λ k]
variable {X Y : Scheme.{u}} (f : X ⟶ Y) {pY : Y ⟶ baseSpec (residueFieldBase Λ k)}
  {M N : FGModuleCat.{u} k}
  {x : (schemeDeformationCategoryProjection (Λ := Λ) (k := k) (Over.mk pY)).Fiber
    ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M)}
  {y : (schemeDeformationCategoryProjection (Λ := Λ) (k := k) (Over.mk pY)).Fiber
    ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj N)}
  {a : x.1 ⟶ y.1}

/-- **The canonical ideal maps commute with the map induced by a morphism of deformations.**
For a morphism `a : Y'_x ⟶ Y'_y` of deformations of `Y` over the map `k[M] ⟶ k[N]` of
`g : M ⟶ N`, the map `ρ : f⁻¹𝒪_{Y'_x} ⟶ f⁻¹𝒪_{Y'_y}` followed by the canonical map of the ideal of
`f⁻¹𝒪_{Y'_y}` to `𝒪_X ⊗_k N` is the canonical map of the ideal of `f⁻¹𝒪_{Y'_x}` to `𝒪_X ⊗_k M`
followed by `𝒪_X ⊗_k g`. Both are restriction data for the reduction of `f⁻¹𝒪_{Y'_x}`, which
agree on the generators `ũ(m)` of its ideal: `ρ(ũ_x(m)) = ũ_y(g m)` goes to `1 ⊗ g m`, the image
of `1 ⊗ m`. -/
theorem schemeMorphismSourceIdeal_transition {g : M ⟶ N}
    (ha : (schemeDeformationCategoryProjection (Λ := Λ) (k := k) (Over.mk pY)).IsHomLift
      ((squareZeroExtensionArtinian.{u, u, u} Λ k).map g) a)
    (V : (Opens X.carrier)ᵒᵖ)
    (z : ↥(kernelIdeal (Scheme.liftSourceReduction x.1.specialMap f).hom V)) :
    (schemeMorphismSourceIdeal f pY y).app V ⟨(sourceIdealTransition f a).hom.app V z,
        kernelIdeal_le_comap (Scheme.liftSourceReduction x.1.specialMap f).hom
          (Scheme.liftSourceReduction y.1.specialMap f).hom (sourceIdealTransition f a).hom
          (hom_of_comp_eq (sourceIdealTransition_comp_reduction f a)) V z.2⟩ =
      (((schemeMorphismCoefficientSheafFunctor f pY).map g).val.app V).hom
        ((schemeMorphismSourceIdeal f pY x).app V z) :=
  IdealRestriction.app_eq_of_generators
    ((schemeMorphismSourceIdeal f pY y).comapOfFac (sourceIdealTransition f a)
      (sourceIdealTransition_comp_reduction f a))
    ((schemeMorphismSourceIdeal f pY x).mapCoeff
      ((RingedSpaceModuleAdjunction.modulePushforward
        (RingedSpace.inverseImageSourceInclusion f.toLRSHom.toShHom)).map
          ((schemeMorphismCoefficientSheafFunctor f pY).map g)))
    (sourceIdealGenerator f pY x) (sourceIdealGenerator_mem f pY x)
    (fun V z hz => sourceIdealGenerator_span f pY x V z hz)
    (fun m => ((congrArg ((schemeMorphismSourceIdeal f pY y).app (op ⊤))
      (Subtype.ext (sourceIdealTransition_generator f ha m))).trans
        (schemeMorphismSourceIdeal_app_generator f pY y (g.hom m))).trans
      ((coefficientSheafSection_map (f ≫ pY) g m).symm.trans
        (congrArg (((schemeMorphismCoefficientSheafFunctor f pY).map g).val.app (op ⊤)).hom
          (schemeMorphismSourceIdeal_app_generator f pY x m).symm)))
    V z

end Deformation.Examples

end
