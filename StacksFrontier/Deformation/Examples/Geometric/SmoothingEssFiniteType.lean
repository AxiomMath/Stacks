/-- An algebra essentially of finite type over `k` is essentially of finite type over `ULift k`. -/
private theorem essFiniteType_ulift (k : Type u) [Field k] (A : Type w) [CommRing A] [Algebra k A]
    [Algebra.EssFiniteType k A] :
    @Algebra.EssFiniteType (ULift.{v} k) A inferInstance inferInstance (ULift.algebra' k A) := by
  let k' := ULift.{v} k
  let : Algebra k' A := ULift.algebra' k A
  let : Algebra k' k := ULift.algebra' k k
  let : Algebra.FiniteType k' k := by
    apply Algebra.FiniteType.of_surjective (Algebra.ofId k' k)
    intro x
    exact ⟨ULift.up x, by simp [k']⟩
  let : IsScalarTower k' k A := by
    apply IsScalarTower.of_algebraMap_eq'
    ext x
    rfl
  let : Algebra.EssFiniteType k' k := Algebra.EssFiniteType.of_finiteType k' k
  exact Algebra.EssFiniteType.comp k' k A

/-- A complete intersection over `k` is a complete intersection over `ULift k`, the auxiliary
regular local ring and regular sequence being the same. -/
private theorem isCompleteIntersection_ulift_of_isCompleteIntersectionLocalRing
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A]
    (hA : IsCompleteIntersectionLocalRing k A) :
    @IsCompleteIntersection (ULift.{v} k) inferInstance A inferInstance
      (ULift.algebra' k A) := by
  obtain ⟨R, hRring, hRalg, hRreg, hRess, f, hmem, hseq, ⟨e⟩⟩ := hA
  let k' := ULift.{v} k
  let : Field k' := inferInstance
  let : Algebra k' A := ULift.algebra' k A
  let : Algebra k' R := ULift.algebra' k R
  let : Algebra k' (R ⧸ Ideal.ofList f) := ULift.algebra' k _
  have hRess' : Algebra.EssFiniteType k' R := essFiniteType_ulift k R
  have he : A ≃ₐ[k'] R ⧸ Ideal.ofList f := by
    apply AlgEquiv.ofRingEquiv (f := e.toRingEquiv)
    intro x
    simp [k', e.commutes (x.down)]
  exact ⟨R, hRring, inferInstance, hRreg, hRess', f, hseq, ⟨he⟩⟩

/-- **Stacks 00SF (1) ⇒ (4) over `ULift k`.** A local complete intersection over `k` which is
essentially of finite type over `k` is a localization at a prime of a global complete intersection
over `ULift k`. -/
private theorem exists_isGlobalCompleteIntersection_isLocalization_ulift
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A]
    (hA : IsCompleteIntersectionLocalRing k A) :
    ∃ (P : Type (max u v)) (_ : CommRing P) (_ : Algebra (ULift.{v} k) P)
      (_ : Algebra P A) (_ : IsScalarTower (ULift.{v} k) P A)
      (p : Ideal P) (_ : p.IsPrime),
      IsGlobalCompleteIntersection (ULift.{v} k) P ∧ IsLocalization.AtPrime A p := by
  let k' := ULift.{v} k
  let : Field k' := inferInstance
  let : Algebra k' A := ULift.algebra' k A
  let : IsLocalRing A := hA.isLocalRing
  let : Algebra.EssFiniteType k A := hA.essFiniteType
  let : Algebra.EssFiniteType k' A := essFiniteType_ulift k A
  have hCI : IsCompleteIntersection k' A :=
    isCompleteIntersection_ulift_of_isCompleteIntersectionLocalRing k A hA
  exact ((IsCompleteIntersection.tfae.{max u v, v, 0} k' A).out 1 4).mp hCI

/-- Transport of the local dimension of a fibre along the identification of `f x` with `s`. -/
private theorem fiber_local_dimension_cast
    {X S : Scheme} (f : X ⟶ S) {s : S} (x : X) (h : f x = s)
    {d : ℕ}
    (hd : topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) = (d : WithBot ℕ∞)) :
    topologicalKrullDimAt (f.fiber s) (h ▸ f.asFiber x) = (d : WithBot ℕ∞) := by
  cases h
  exact hd

/-- Every fibre of a relative global complete intersection is equidimensional, and a nonempty one
has dimension the number of variables minus the number of relations. -/
private theorem relative_gci_fiber_dimension
    {R C : Type u} [CommRing R] [CommRing C] [Algebra R C]
    {ι σ : Type*} [Finite ι] [Finite σ]
    (P : Algebra.Presentation R C ι σ) [P.IsRelativeGlobalCompleteIntersection]
    (s : Spec (.of R)) :
    TopologicalSpace.Equidimensional ((Spec.map (CommRingCat.ofHom (algebraMap R C))).fiber s) ∧
      (Nonempty ((Spec.map (CommRingCat.ofHom (algebraMap R C))).fiber s) →
        topologicalKrullDim ((Spec.map (CommRingCat.ofHom (algebraMap R C))).fiber s) =
          ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞)) := by
  let f : Spec (.of C) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom (algebraMap R C))
  let Z := f.fiber s
  let q : Z ⟶ Spec ((Spec (.of R)).residueField s) := f.fiberToSpecResidueField s
  let : Algebra.FinitePresentation R C := P.finitePresentation_of_isFinite
  let : (algebraMap R C).FinitePresentation := by
    rw [RingHom.finitePresentation_algebraMap]
    infer_instance
  have hft : RingHom.FiniteType (CommRingCat.ofHom (algebraMap R C)).hom := by
    show (algebraMap R C).FiniteType
    rw [RingHom.finiteType_algebraMap]
    infer_instance
  let : LocallyOfFiniteType f :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr hft
  have hloc (z : Z) :
      topologicalKrullDimAt Z z = ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := by
    let x : Spec (.of C) := f.fiberι s z
    have hfx : f x = s := f.apply_fiberι s z
    have hx := asFiber_eq_of_fiberι_eq f s z x hfx rfl
    have hdim := AlgebraicGeometry.fiberDimensionAt_eq_card_sub_card P x
    have hdim' := fiber_local_dimension_cast f x hfx (by simpa [f] using hdim)
    rwa [hx] at hdim'
  let : LocallyOfFiniteType q := Scheme.Hom.locallyOfFiniteType_fiberToSpecResidueField f s
  let : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian q
  let κ : Type u := ↑((Spec (.of R)).residueField s)
  let : Field κ := inferInstance
  have he : TopologicalSpace.Equidimensional Z :=
    equidimensional_of_constant_fiber_local_dimension κ Z q hloc
  have hdim (hne : Nonempty Z) : topologicalKrullDim Z =
      ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := by
    rw [TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
    simp_rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim, hloc]
    let : Nonempty Z := hne
    simp
  exact ⟨he, hdim⟩

/-- For a smooth algebra of finite type over a field whose Krull dimension is at most `d`, the
`d`-th Fitting ideal of the module of differentials is the unit ideal: at every maximal ideal the
relative cotangent space is generated by at most `d` elements. -/
private theorem fittingIdeal_kaehler_eq_top_of_smooth_dim
    {K T : Type u} [Field K] [CommRing T] [Algebra K T] [Algebra.FiniteType K T]
    (d : ℕ) (hdim : ringKrullDim T ≤ (d : WithBot ℕ∞))
    [Algebra.Smooth K T] :
    fittingIdeal (R := T) (M := KaehlerDifferential K T) (d : ℤ) = ⊤ := by
  classical
  by_contra hI
  by_cases hT : Nontrivial T
  · let : Nontrivial T := hT
    let I : Ideal T := fittingIdeal (R := T) (M := KaehlerDifferential K T) (d : ℤ)
    obtain ⟨m, hm, hIm⟩ := Ideal.exists_le_maximal I hI
    let : m.IsPrime := hm.isPrime
    let x : PrimeSpectrum T := ⟨m, hm.isPrime⟩
    have hlocal : TopologicalSpace.localKrullDim (PrimeSpectrum T) x ≤
        (d : WithBot ℕ∞) := by
      rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim]
      calc
        topologicalKrullDimAt (PrimeSpectrum T) x ≤ topologicalKrullDim (PrimeSpectrum T) := by
          unfold topologicalKrullDimAt
          let U : {U : Set (PrimeSpectrum T) // x ∈ U ∧ IsOpen U} :=
            ⟨Set.univ, ⟨Set.mem_univ _, isOpen_univ⟩⟩
          calc
            _ ≤ topologicalKrullDim (↥U.1) := iInf_le _ U
            _ = topologicalKrullDim (PrimeSpectrum T) :=
              IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ _).isHomeomorph
        _ = ringKrullDim T := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim T
        _ ≤ (d : WithBot ℕ∞) := hdim
    have hsmAt : Algebra.IsSmoothAt K m := by
      show Algebra.FormallySmooth K (Localization.AtPrime m)
      infer_instance
    have hfinrank :
        (Module.finrank m.ResidueField
          (m.ResidueField ⊗[T] KaehlerDifferential K T) : WithBot ℕ∞) ≤
          (d : WithBot ℕ∞) := by
      have h := ((Algebra.isSmoothAt_tfae_localKrullDim_and_isRegularLocalRing
        (k := K) x (Localization.AtPrime m)).1.out 1 2).mp hsmAt
      exact h.trans hlocal
    have hfinrank' : Module.finrank m.ResidueField
        (m.ResidueField ⊗[T] KaehlerDifferential K T) ≤ d := by
      exact_mod_cast hfinrank
    have hnot : ¬ I ≤ m :=
      ((fittingIdeal_local_generation_tfae (R := T)
        (M := KaehlerDifferential K T) d m).out 1 2).mpr hfinrank'
    exact hnot hIm
  · have := not_nontrivial_iff_subsingleton.mp hT
    exact hI (Subsingleton.elim _ _)

/-- The generic fibre of a relative global complete intersection over a domain, when nonzero, has
Krull dimension the number of variables minus the number of relations. -/
private theorem generic_fiber_ringKrullDim
    {R Q : Type u} [CommRing R] [CommRing Q] [Algebra R Q] [IsDomain R]
    [Algebra.FiniteType R Q] {ι σ : Type*} [Finite ι] [Finite σ]
    (P : Algebra.Presentation R Q ι σ) [P.IsRelativeGlobalCompleteIntersection]
    (hT : Nontrivial (TensorProduct R ((⊥ : Ideal R).ResidueField) Q)) :
    ringKrullDim (TensorProduct R ((⊥ : Ideal R).ResidueField) Q) =
      ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := by
  let s : Spec (.of R) := ⟨⊥, inferInstance⟩
  let f : Spec (.of Q) ⟶ Spec (.of R) :=
    Spec.map (CommRingCat.ofHom (algebraMap R Q))
  let T := TensorProduct R s.asIdeal.ResidueField Q
  let e : f.fiber s ≃ₜ PrimeSpectrum T :=
    (f.fiberHomeo s).trans (PrimeSpectrum.preimageHomeomorphFiber R Q s)
  let : Nontrivial T := hT
  let z : PrimeSpectrum T := Classical.choice (PrimeSpectrum.nonempty_iff_nontrivial.mpr hT)
  obtain ⟨_, hdim⟩ := relative_gci_fiber_dimension P s
  calc
    ringKrullDim T = topologicalKrullDim (PrimeSpectrum T) :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim T).symm
    _ = topologicalKrullDim (f.fiber s) :=
      (IsHomeomorph.topologicalKrullDim_eq _ e.isHomeomorph).symm
    _ = ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := hdim ⟨e.symm z⟩

/-- The isomorphism of power series rings induced by `k ≃ ULift k`. -/
private noncomputable def powerSeriesULiftEquiv (k : Type u) [CommRing k] :
    PowerSeries k ≃+* PowerSeries (ULift.{v} k) := by
  let f : k →+* ULift.{v} k := ULift.ringEquiv.symm.toRingHom
  let g : PowerSeries k →+* PowerSeries (ULift.{v} k) := PowerSeries.map f
  exact RingEquiv.ofBijective g ⟨PowerSeries.map_injective f ULift.ringEquiv.symm.injective,
    PowerSeries.map_surjective f ULift.ringEquiv.symm.surjective⟩

/-- The isomorphism of power series rings sends the variable to the variable. -/
private theorem powerSeriesULiftEquiv_X (k : Type u) [CommRing k] :
    powerSeriesULiftEquiv k PowerSeries.X = PowerSeries.X := by
  simp [powerSeriesULiftEquiv]

/-- The isomorphism of power series rings sends a constant to the corresponding constant. -/
private theorem powerSeriesULiftEquiv_C (k : Type u) [CommRing k] (a : k) :
    powerSeriesULiftEquiv k (PowerSeries.C a) = PowerSeries.C (ULift.up a) := by
  simp [powerSeriesULiftEquiv, ULift.ringEquiv]

/-- Differentials are unchanged by an isomorphism of the base ring compatible with the structure
maps, the two bases differing by a formally étale extension. -/
private noncomputable def kaehlerDifferential_equiv_of_baseRingEquiv
    {R R' B : Type*} [CommRing R] [CommRing R'] [CommRing B]
    [Algebra R B] [Algebra R' B] (e : R ≃+* R')
    (he : algebraMap R B = (algebraMap R' B).comp e.toRingHom) :
    KaehlerDifferential R B ≃ₗ[B] KaehlerDifferential R' B := by
  let : Algebra R R' := e.toRingHom.toAlgebra
  let : IsScalarTower R R' B := IsScalarTower.of_algebraMap_eq' he
  let : IsLocalization (IsUnit.submonoid R) R' :=
    IsLocalization.isLocalization_of_algEquiv (IsUnit.submonoid R)
      (AlgEquiv.ofRingEquiv (f := e) (fun _ => rfl) : R ≃ₐ[R] R')
  let : Algebra.FormallyEtale R R' :=
    Algebra.FormallyEtale.of_isLocalization (IsUnit.submonoid R)
  have hi : Function.Injective (KaehlerDifferential.map R R' B B) := by
    intro x₁ x₂ hxy
    have hzero : KaehlerDifferential.map R R' B B (x₁ - x₂) = 0 := by
      simpa using congrArg (fun z => z - KaehlerDifferential.map R R' B B x₂) hxy
    obtain ⟨z, hz⟩ :=
      (KaehlerDifferential.exact_mapBaseChange_map R R' B (x₁ - x₂)).mp hzero
    rw [Subsingleton.elim z 0] at hz
    exact sub_eq_zero.mp (by simpa using hz.symm)
  exact LinearEquiv.ofBijective (KaehlerDifferential.map R R' B B)
    ⟨hi, KaehlerDifferential.map_surjective R R' B⟩

/-- The `d`-th Fitting ideal of the differentials of a smooth algebra of dimension at most `d` over
a field `K` is the unit ideal, also over any base ring isomorphic to `K` compatibly with the
structure maps. -/
private theorem fittingIdeal_kaehler_eq_top_of_smooth_of_baseRingEquiv
    {F K T : Type u} [CommRing F] [Field K] [CommRing T] [Algebra F T] [Algebra K T]
    [Algebra.FiniteType K T] [Algebra.Smooth K T] [Module.Finite T (KaehlerDifferential F T)]
    (e : F ≃+* K) (he : algebraMap F T = (algebraMap K T).comp e.toRingHom)
    (d : ℕ) (hdim : ringKrullDim T ≤ (d : WithBot ℕ∞)) :
    fittingIdeal (R := T) (M := KaehlerDifferential F T) (d : ℤ) = ⊤ := by
  rw [fittingIdeal_eq_of_linearEquiv (kaehlerDifferential_equiv_of_baseRingEquiv e he) d]
  exact fittingIdeal_kaehler_eq_top_of_smooth_dim d hdim

/-- If the quotient of `Q` by a principal ideal is a ring `P` of which `A` is the localization at
a prime `𝔭`, then `A` is the special fibre of the localization of `Q` at the prime corresponding
to `𝔭`. -/
private theorem exists_localized_special_fiber
    {k' : Type u} [Field k'] {P Q A : Type v} [CommRing P] [CommRing Q] [CommRing A]
    [Algebra k' P] [Algebra k' Q] [Algebra P A] [Algebra k' A]
    [IsScalarTower k' P A]
    (I : Ideal Q) (e : (Q ⧸ I) ≃ₐ[k'] P) (p : Ideal P) [p.IsPrime]
    (hLoc : IsLocalization.AtPrime A p) :
    ∃ (q : Ideal Q) (_ : q.IsPrime) (B : Type v) (_ : CommRing B)
      (_ : Algebra Q B) (_ : Algebra k' B) (_ : IsScalarTower k' Q B)
      (_ : IsLocalization.AtPrime B q),
      Nonempty ((B ⧸ I.map (algebraMap Q B)) ≃ₐ[k'] A) := by
  let p' : Ideal (Q ⧸ I) := p.comap e.toRingEquiv.toRingHom
  let q : Ideal Q := Ideal.comap (Ideal.Quotient.mk I) p'
  have hp' : p'.IsPrime := Ideal.comap_isPrime _ _
  have hq : q.IsPrime := Ideal.comap_isPrime _ _
  let B := Localization.AtPrime q
  let : CommRing B := inferInstance
  let : Algebra Q B := inferInstance
  let : IsLocalization.AtPrime B q := inferInstance
  let : Algebra k' B := (algebraMap Q B).comp (algebraMap k' Q) |>.toAlgebra
  let : SMul k' B := (inferInstance : Algebra k' B).toSMul
  let : IsScalarTower k' Q B := IsScalarTower.of_algebraMap_eq' rfl
  let JB := I.map (algebraMap Q B)
  have hcomap : p'.comap (Ideal.Quotient.mk I) = q := rfl
  let : IsLocalization.AtPrime (B ⧸ JB) p' :=
    isLocalization_atPrime_quotient q B I p' hcomap
  let : Algebra (Q ⧸ I) A :=
    (algebraMap P A).comp e.toRingEquiv.toRingHom |>.toAlgebra
  let : IsScalarTower k' (Q ⧸ I) A := by
    refine IsScalarTower.of_algebraMap_eq (R := k') (S := Q ⧸ I) (A := A) ?_
    intro z
    calc
      algebraMap k' A z = algebraMap P A (algebraMap k' P z) :=
        IsScalarTower.algebraMap_apply k' P A z
      _ = algebraMap P A (e (algebraMap k' (Q ⧸ I) z)) := by rw [e.commutes]
      _ = algebraMap (Q ⧸ I) A (algebraMap k' (Q ⧸ I) z) := rfl
  have hLoc' : IsLocalization p'.primeCompl A := by
    have hRingEquiv := CompleteIntersection.isLocalization_comap_of_ringEquiv
      (T := Q ⧸ I) (T₀ := P) (B := A) e.toRingEquiv
      (fun z => show algebraMap P A (e z) = algebraMap (Q ⧸ I) A z from rfl)
      p.primeCompl
    have hsub : Submonoid.comap e.toRingEquiv.toRingHom p.primeCompl = p'.primeCompl := by
      ext x
      simp [p', Ideal.mem_comap]
    rwa [← hsub]
  let : IsScalarTower Q (Q ⧸ I) (B ⧸ JB) := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower k' Q (Q ⧸ I) := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower k' Q (B ⧸ JB) := by
    refine ⟨?_⟩
    intro r s z
    refine Quotient.inductionOn z ?_
    intro b
    show Ideal.Quotient.mk JB ((r • s) • b) =
      Ideal.Quotient.mk JB (r • s • b)
    rw [IsScalarTower.smul_assoc]
  let : IsScalarTower k' (Q ⧸ I) (B ⧸ JB) := by
    apply IsScalarTower.of_algebraMap_eq'
    ext z
    show algebraMap (Q ⧸ I) (B ⧸ JB)
        (algebraMap Q (Q ⧸ I) (algebraMap k' Q z)) =
      algebraMap (Q ⧸ I) (B ⧸ JB) (algebraMap k' (Q ⧸ I) z)
    rw [← IsScalarTower.algebraMap_apply k' Q (Q ⧸ I) z]
  exact ⟨q, hq, B, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    ⟨(IsLocalization.algEquiv p'.primeCompl (B ⧸ JB) A).restrictScalars k'⟩⟩

/-- Fitting ideals of relative differentials commute with localization of the algebra: the ideal
over a localization is the image of the ideal over the algebra. -/
private theorem fittingIdeal_kaehler_localization
    {R Q B : Type w}
    [CommRing R] [CommRing Q] [CommRing B]
    [Algebra R Q] [Algebra Q B] [Algebra R B] [IsScalarTower R Q B]
    (M : Submonoid Q) [IsLocalization M B]
    [Module.Finite Q (KaehlerDifferential R Q)] (d : ℕ) :
    let : Module.Finite B (KaehlerDifferential R B) :=
      Module.Finite.of_isLocalizedModule M (KaehlerDifferential.map R R Q B)
    fittingIdeal (R := B) (M := KaehlerDifferential R B) (d : ℤ) =
      Ideal.map (algebraMap Q B)
        (fittingIdeal (R := Q) (M := KaehlerDifferential R Q) (d : ℤ)) := by
  have hloc : IsLocalizedModule M (KaehlerDifferential.map R R Q B) :=
    omega_localization_total R Q M B
  let : Module.Finite B (KaehlerDifferential R B) :=
    Module.Finite.of_isLocalizedModule M (KaehlerDifferential.map R R Q B)
  have hbc : IsBaseChange B (KaehlerDifferential.map R R Q B) :=
    (isLocalizedModule_iff_isBaseChange M B
      (KaehlerDifferential.map R R Q B)).mp hloc
  let e : TensorProduct Q B (KaehlerDifferential R Q) ≃ₗ[B]
      KaehlerDifferential R B := hbc.equiv
  exact (fittingIdeal_eq_of_linearEquiv e d).symm.trans
    ((fittingIdeal_basic_properties.{w, w, w, w} (R := Q) (M := KaehlerDifferential R Q)).2.2.1 B d)

/-- If the `d`-th Fitting ideal of the differentials becomes the unit ideal after inverting `x`,
then a power of `x` already lies in it. -/
private theorem exists_pow_mem_fittingIdeal_of_isLocalization_powers
    {R Q T : Type w} [CommRing R] [CommRing Q] [CommRing T]
    [Algebra R Q] [Algebra Q T] [Algebra R T] [IsScalarTower R Q T]
    (x : Q) (hT : IsLocalization (Submonoid.powers x) T)
    [Module.Finite Q (KaehlerDifferential R Q)] [Module.Finite T (KaehlerDifferential R T)]
    (d : ℕ) (h : fittingIdeal (R := T) (M := KaehlerDifferential R T) (d : ℤ) = ⊤) :
    ∃ N : ℕ, x ^ N ∈ fittingIdeal (R := Q) (M := KaehlerDifferential R Q) (d : ℤ) := by
  have hone : algebraMap Q T 1 ∈ Ideal.map (algebraMap Q T)
      (fittingIdeal (R := Q) (M := KaehlerDifferential R Q) (d : ℤ)) := by
    rw [← fittingIdeal_kaehler_localization (R := R) (Q := Q) (B := T) (Submonoid.powers x) d, h]
    simp
  obtain ⟨s, ⟨N, rfl⟩, hsI⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers x) T _ 1).mp hone
  exact ⟨N, by simpa [Submonoid.mem_powers_iff] using hsI⟩

/-- A global complete intersection over a field is equidimensional: the local dimension at every
prime is the Krull dimension of the whole ring. -/
private theorem localKrullDim_eq_ringKrullDim_of_global_ci
    {k C : Type*} [Field k] [CommRing C] [Algebra k C]
    (hC : IsGlobalCompleteIntersection k C) (p : Ideal C) [p.IsPrime] :
    TopologicalSpace.localKrullDim (PrimeSpectrum C) ⟨p, ‹p.IsPrime›⟩ = ringKrullDim C := by
  classical
  have : Algebra.FiniteType k C := hC.finiteType
  rcases hC with hzero | ⟨n, c, rel, e, -, hdim⟩
  · have hnt : Nontrivial C := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨⟨p, ‹p.IsPrime›⟩⟩
    exact False.elim (not_subsingleton_iff_nontrivial.mpr hnt hzero)
  obtain ⟨g, hg, hle⟩ := PrimeSpectrum.exists_notMem_topologicalKrullDim_basicOpen_le_localKrullDim
    (⟨p, ‹p.IsPrime›⟩ : PrimeSpectrum C)
  have hne : ¬ Subsingleton (Localization.Away g) := by
    intro hs
    have hx : (⟨p, ‹p.IsPrime›⟩ : PrimeSpectrum C) ∈ Set.range
        (PrimeSpectrum.comap (algebraMap C (Localization.Away g))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away g) g]
      exact hg
    obtain ⟨y, hy⟩ := hx
    have hnt : Nontrivial (Localization.Away g) := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨y⟩
    exact (not_subsingleton_iff_nontrivial.mpr hnt) hs
  have hdimloc := gci_localization_dim k C g n c rel e hdim hne
  have hlow : ringKrullDim C ≤
      TopologicalSpace.localKrullDim (PrimeSpectrum C) ⟨p, ‹p.IsPrime›⟩ := by
    rw [hdim, ← hdimloc]
    exact (PrimeSpectrum.ringKrullDim_le_topologicalKrullDim_basicOpen g _).trans hle
  have hupp : TopologicalSpace.localKrullDim (PrimeSpectrum C) ⟨p, ‹p.IsPrime›⟩ ≤
      ringKrullDim C := by
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
      TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
    exact le_iSup _ (⟨p, ‹p.IsPrime›⟩ : PrimeSpectrum C)
  exact le_antisymm hupp hlow

/-- The residue field of a local ring essentially of finite type over `k` has finite
transcendence degree over `k`. -/
private theorem exists_nat_trdeg_residueField_eq (k : Type u) [Field k] (A : Type v) [CommRing A]
    [Algebra k A] [IsLocalRing A] [Algebra.EssFiniteType k A] :
    ∃ n : ℕ, Algebra.trdeg k (IsLocalRing.ResidueField A) = n := by
  have : IsScalarTower k A (IsLocalRing.ResidueField A) := IsScalarTower.of_algebraMap_eq' rfl
  have : Algebra.EssFiniteType k (IsLocalRing.ResidueField A) :=
    Algebra.EssFiniteType.comp k A _
  exact ⟨_, (Cardinal.cast_toNat_of_lt_aleph0 (trdeg_lt_aleph0 k _)).symm⟩

/-- A local complete intersection `A` over `k` is the localization at a prime of a global complete
intersection `P` over `ULift k` with `dim P = dim A + trdeg_k κ(A)`. -/
private theorem exists_isGlobalCompleteIntersection_ringKrullDim_eq_add_trdeg
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A] [IsLocalRing A]
    (hA : IsCompleteIntersectionLocalRing k A) :
    ∃ (P : Type (max u v)) (_ : CommRing P) (_ : Algebra (ULift.{v} k) P)
      (_ : Algebra P A) (_ : IsScalarTower (ULift.{v} k) P A)
      (p : Ideal P) (_ : p.IsPrime),
      IsGlobalCompleteIntersection (ULift.{v} k) P ∧ IsLocalization.AtPrime A p ∧
        ringKrullDim P = ringKrullDim A +
          (Cardinal.toENat (Algebra.trdeg k (IsLocalRing.ResidueField A)) : WithBot ℕ∞) := by
  obtain ⟨P, _, _, _, hT, p, _, hPci, hPLoc⟩ :=
    exists_isGlobalCompleteIntersection_isLocalization_ulift k A hA
  refine ⟨P, inferInstance, inferInstance, inferInstance, hT, p, inferInstance, hPci, hPLoc, ?_⟩
  let k' := ULift.{v} k
  let : Algebra k' A := ULift.algebra' k A
  let : Algebra k' k := ULift.algebra' k k
  have : IsScalarTower k' P A := hT
  have : IsScalarTower k' k A := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
  have : Algebra.IsAlgebraic k' k := ⟨fun x => isAlgebraic_algebraMap (ULift.up x)⟩
  have hzero : Algebra.trdeg k' k = 0 := trdeg_eq_zero_iff.mpr inferInstance
  have hbase := lift_trdeg_add_eq k' k (IsLocalRing.ResidueField A)
  simp only [hzero, Cardinal.lift_zero, zero_add] at hbase
  let A' := ULift.{u} A
  let : Algebra k' A' := ULift.algebra (R := k') (A := A)
  let eA' : A' ≃+* A := ULift.ringEquiv
  let : IsLocalRing A' := eA'.symm.isLocalRing
  have hres : Cardinal.toENat (Algebra.trdeg k' (IsLocalRing.ResidueField A')) =
      Cardinal.toENat (Algebra.trdeg k (IsLocalRing.ResidueField A)) := by
    rw [← Cardinal.lift_inj.mp hbase.symm]
    simpa only [Cardinal.toENat_lift] using congrArg Cardinal.toENat
      (IsLocalRing.ResidueField.mapAlgEquiv (ULift.algEquiv (R := k') (A := A))).lift_trdeg_eq
  have : Algebra.FiniteType k' P := hPci.finiteType
  have : IsLocalization.AtPrime A' p :=
    IsLocalization.isLocalization_of_algEquiv p.primeCompl (ULift.algEquiv (R := P) (A := A)).symm
  rw [← localKrullDim_eq_ringKrullDim_of_global_ci hPci p,
    IsLocalRing.localKrullDim_eq_ringKrullDim_add_trdeg k' P A' p,
    ringKrullDim_eq_of_ringEquiv eA', hres]

/-- The fraction field `κ(⊥)` of `K⟦t⟧` is `K⸨t⸩`. -/
private noncomputable def residueFieldBotEquivLaurentSeries (K : Type u) [Field K] :
    (⊥ : Ideal (PowerSeries K)).ResidueField ≃ₐ[PowerSeries K] LaurentSeries K :=
  IsFractionRing.algEquivOfAlgEquiv (R := PowerSeries K) (A := PowerSeries K)
    (K := (⊥ : Ideal (PowerSeries K)).ResidueField) (B := PowerSeries K) (L := LaurentSeries K)
    (AlgEquiv.refl (R := PowerSeries K) (A₁ := PowerSeries K))

/-- If the generic fibre `κ(⊥) ⊗ Q` of a `K⟦t⟧`-algebra `Q` is smooth over `K⸨t⸩` of dimension at
most `d`, the `d`-th Fitting ideal of its differentials over `κ(⊥)` is the unit ideal. -/
private theorem fittingIdeal_kaehler_genericFiber_eq_top
    {K Q : Type u} [Field K] [CommRing Q] [Algebra (PowerSeries K) Q]
    (hgeneric : Algebra.Smooth (LaurentSeries K) ((LaurentSeries K) ⊗[PowerSeries K] Q))
    [Module.Finite ((⊥ : Ideal (PowerSeries K)).ResidueField ⊗[PowerSeries K] Q)
      (KaehlerDifferential (⊥ : Ideal (PowerSeries K)).ResidueField
        ((⊥ : Ideal (PowerSeries K)).ResidueField ⊗[PowerSeries K] Q))]
    {d : ℕ} (hdim : ringKrullDim ((⊥ : Ideal (PowerSeries K)).ResidueField ⊗[PowerSeries K] Q) ≤
      (d : WithBot ℕ∞)) :
    fittingIdeal (R := (⊥ : Ideal (PowerSeries K)).ResidueField ⊗[PowerSeries K] Q)
      (M := KaehlerDifferential (⊥ : Ideal (PowerSeries K)).ResidueField
        ((⊥ : Ideal (PowerSeries K)).ResidueField ⊗[PowerSeries K] Q)) (d : ℤ) = ⊤ := by
  classical
  let R' := PowerSeries K
  let κQ := (⊥ : Ideal R').ResidueField
  let T := TensorProduct R' κQ Q
  let eκ := residueFieldBotEquivLaurentSeries K
  let : Algebra (LaurentSeries K) κQ := eκ.symm.toRingHom.toAlgebra
  let : IsScalarTower R' (LaurentSeries K) κQ := by
    apply IsScalarTower.of_algebraMap_eq'
    ext r
    show algebraMap R' κQ r = eκ.symm (algebraMap R' (LaurentSeries K) r)
    exact (eκ.symm_apply_apply _).symm.trans (congrArg eκ.symm (eκ.commutes r))
  let : CommSemiring (LaurentSeries K) :=
    (inferInstance : CommRing (LaurentSeries K)).toCommSemiring
  let : Algebra (LaurentSeries K) T := Algebra.TensorProduct.leftAlgebra
  let : IsScalarTower (LaurentSeries K) κQ T :=
    IsScalarTower.of_algebraMap_eq' (R := LaurentSeries K) (S := κQ) (A := T) rfl
  let eBaseField : κQ ≃ₐ[LaurentSeries K] LaurentSeries K :=
    AlgEquiv.ofRingEquiv (f := eκ.toRingEquiv) fun a => eκ.apply_symm_apply a
  let eGeneric : T ≃ₐ[LaurentSeries K] TensorProduct R' (LaurentSeries K) Q :=
    Algebra.TensorProduct.congr eBaseField (AlgEquiv.refl : Q ≃ₐ[R'] Q)
  have : Algebra.Smooth (LaurentSeries K) (TensorProduct R' (LaurentSeries K) Q) := hgeneric
  have : Algebra.Smooth (LaurentSeries K) T := Algebra.Smooth.of_equiv eGeneric.symm
  have hBaseMaps : algebraMap κQ T = (algebraMap (LaurentSeries K) T).comp eκ.toRingHom := by
    refine RingHom.ext fun x => ?_
    show algebraMap κQ T x = algebraMap (LaurentSeries K) T (eκ x)
    rw [IsScalarTower.algebraMap_apply (LaurentSeries K) κQ T (eκ x),
      show algebraMap (LaurentSeries K) κQ (eκ x) = x from eκ.symm_apply_apply x]
  exact fittingIdeal_kaehler_eq_top_of_smooth_of_baseRingEquiv eκ.toRingEquiv hBaseMaps d hdim

/-- If the generic fibre of a flat relative global complete intersection `Q` over `K⟦t⟧` is smooth,
then a power of `t` lies in the `d`-th Fitting ideal of `Ω_{Q/K⟦t⟧}` for every `d` at least the
relative dimension. -/
private theorem exists_pow_X_mem_fittingIdeal_of_smooth_genericFiber
    {K Q : Type u} [Field K] [CommRing Q] [Nontrivial Q] [Algebra (PowerSeries K) Q]
    [Module.Flat (PowerSeries K) Q] [Algebra.FiniteType (PowerSeries K) Q] {n c : ℕ}
    (pres : Algebra.Presentation (PowerSeries K) Q (Fin n) (Fin c))
    [pres.IsRelativeGlobalCompleteIntersection]
    (hgeneric : Algebra.Smooth (LaurentSeries K) ((LaurentSeries K) ⊗[PowerSeries K] Q))
    {d : ℕ} (hd : n - c ≤ d) :
    ∃ N : ℕ, algebraMap (PowerSeries K) Q PowerSeries.X ^ N ∈
      fittingIdeal (R := Q) (M := KaehlerDifferential (PowerSeries K) Q) (d : ℤ) := by
  let R' := PowerSeries K
  let κQ := (⊥ : Ideal R').ResidueField
  let : IsLocalization (Submonoid.powers (PowerSeries.X : R')) κQ :=
    IsLocalization.isLocalization_of_algEquiv (Submonoid.powers (PowerSeries.X : R'))
      (residueFieldBotEquivLaurentSeries K).symm
  let T := TensorProduct R' κQ Q
  let : Algebra Q T := Algebra.TensorProduct.rightAlgebra
  have : IsScalarTower R' Q T := by infer_instance
  let MX : Submonoid Q := Submonoid.powers (algebraMap R' Q PowerSeries.X)
  have hXreg : IsRegular (algebraMap R' Q PowerSeries.X) :=
    _root_.Stacks.Fitting.isRegular_algebraMap_of_flat (R := R') (S := Q)
      (isRegular_iff_ne_zero.mpr PowerSeries.X_ne_zero)
  have hMX : MX ≤ nonZeroDivisors Q := by
    apply Submonoid.powers_le.mpr
    show (algebraMap R' Q PowerSeries.X) ∈ nonZeroDivisorsLeft Q ∧
      (algebraMap R' Q PowerSeries.X) ∈ nonZeroDivisorsRight Q
    exact ⟨(isRegular_iff.mp hXreg).1.mem_nonZeroDivisorsLeft,
      (isRegular_iff.mp hXreg).2.mem_nonZeroDivisorsRight⟩
  have hlocT : IsLocalization MX T := by
    have hloc : IsLocalization ((Submonoid.powers (PowerSeries.X : R')).map
        (algebraMap R' Q)) T := by infer_instance
    simpa [MX, Submonoid.map_powers] using hloc
  have hTnt : Nontrivial T := (@IsLocalization.injective Q _ MX T _ _ hlocT hMX).nontrivial
  have hdimT : ringKrullDim T = ((n - c : ℕ) : WithBot ℕ∞) := by
    simpa using generic_fiber_ringKrullDim pres hTnt
  let eΩ : KaehlerDifferential κQ T ≃ₗ[T] KaehlerDifferential R' T :=
    (KaehlerDifferential.tensorKaehlerEquiv R' κQ Q T).symm.trans
      ((isLocalizedModule_iff_isBaseChange MX T (KaehlerDifferential.map R' R' Q T)).mp
        (omega_localization_total R' Q MX T)).equiv
  have : Monoid.FG MX := by
    show Monoid.FG (Submonoid.powers (algebraMap R' Q PowerSeries.X))
    exact Monoid.powers_fg (algebraMap R' Q PowerSeries.X)
  have : Algebra.FiniteType Q T := IsLocalization.finiteType_of_monoid_fg (M := MX) (S := T)
  have : Algebra.FiniteType R' T := Algebra.FiniteType.trans (S := Q) inferInstance inferInstance
  have : Module.Finite T (KaehlerDifferential κQ T) := Module.Finite.equiv eΩ.symm
  have hfit : fittingIdeal (R := T) (M := KaehlerDifferential R' T) (d : ℤ) = ⊤ := by
    rw [← fittingIdeal_eq_of_linearEquiv eΩ d]
    exact fittingIdeal_kaehler_genericFiber_eq_top hgeneric
      (hdimT.trans_le (by exact_mod_cast hd))
  exact exists_pow_mem_fittingIdeal_of_isLocalization_powers _ hlocT _ hfit

/-- A smoothing over `(ULift k)⟦t⟧` is a smoothing over `k⟦t⟧`, through `k⟦t⟧ ≃ (ULift k)⟦t⟧`:
flatness, essential finite type, the special fibre and the Fitting ideal membership transfer. -/
private theorem exists_powerSeries_of_powerSeries_ulift
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A]
    (B : Type (max u v)) [CommRing B] [Algebra (PowerSeries (ULift.{v} k)) B]
    [Algebra.EssFiniteType (PowerSeries (ULift.{v} k)) B]
    [Module.Flat (PowerSeries (ULift.{v} k)) B] [Algebra (ULift.{v} k) B]
    (hk' : ∀ x : ULift.{v} k, algebraMap (ULift.{v} k) B x = algebraMap (PowerSeries (ULift.{v} k))
      B (algebraMap (ULift.{v} k) (PowerSeries (ULift.{v} k)) x)) {J : Ideal B}
    (hJ : J = Ideal.span {algebraMap (PowerSeries (ULift.{v} k)) B PowerSeries.X})
    (e : (B ⧸ J) ≃+* A)
    (he : ∀ a : ULift.{v} k, e (algebraMap (ULift.{v} k) (B ⧸ J) a) = algebraMap k A a.down)
    {d N : ℕ} (hN : algebraMap (PowerSeries (ULift.{v} k)) B (PowerSeries.X ^ N) ∈
      fittingIdeal (M := KaehlerDifferential (PowerSeries (ULift.{v} k)) B) (d : ℤ)) :
    ∃ (_ : Algebra (PowerSeries k) B)
      (_ : Algebra.EssFiniteType (PowerSeries k) B) (_ : Module.Flat (PowerSeries k) B)
      (_ : Algebra k B) (_ : IsScalarTower k (PowerSeries k) B),
      Nonempty ((B ⧸ Ideal.span {algebraMap (PowerSeries k) B PowerSeries.X}) ≃ₐ[k] A) ∧
        algebraMap (PowerSeries k) B (PowerSeries.X ^ N) ∈
          fittingIdeal (M := KaehlerDifferential (PowerSeries k) B) (d : ℤ) := by
  classical
  let k' := ULift.{v} k
  let R' := PowerSeries k'
  let ePS := powerSeriesULiftEquiv.{u, v} k
  let : Algebra (PowerSeries k) R' := ePS.toRingHom.toAlgebra
  let : Algebra (PowerSeries k) B := (algebraMap R' B).comp ePS.toRingHom |>.toAlgebra
  have : IsScalarTower (PowerSeries k) R' B :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
  let ePSAlg : PowerSeries k ≃ₐ[PowerSeries k] R' := AlgEquiv.ofRingEquiv (f := ePS) fun _ => rfl
  have : Algebra.FiniteType (PowerSeries k) R' :=
    Algebra.FiniteType.of_surjective ePSAlg.toAlgHom ePS.surjective
  have : Algebra.EssFiniteType (PowerSeries k) R' :=
    Algebra.EssFiniteType.of_finiteType (PowerSeries k) R'
  have : Algebra.EssFiniteType (PowerSeries k) B := Algebra.EssFiniteType.comp (PowerSeries k) R' B
  let : SMul k' B := (inferInstance : Algebra k' B).toSMul
  let : Algebra k k' := ULift.algebra (R := k) (A := k)
  let : Algebra k B := (algebraMap k' B).comp (algebraMap k k') |>.toAlgebra
  have : IsScalarTower k k' B := by
    apply IsScalarTower.of_algebraMap_eq'
    ext a
    rfl
  have : IsScalarTower k (PowerSeries k) B := by
    refine IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a => ?_)
    show algebraMap k' B (ULift.up a) = algebraMap R' B (ePS (PowerSeries.C a))
    rw [powerSeriesULiftEquiv_C]
    exact hk' _
  have hXbase : algebraMap (PowerSeries k) R' PowerSeries.X = PowerSeries.X :=
    powerSeriesULiftEquiv_X k
  have hX : algebraMap (PowerSeries k) B PowerSeries.X = algebraMap R' B PowerSeries.X := by
    rw [IsScalarTower.algebraMap_apply (PowerSeries k) R' B, hXbase]
  refine ⟨inferInstance, inferInstance, RingHom.flat_algebraMap_iff.mp
    ((RingHom.Flat.of_bijective ePS.bijective).comp
      (RingHom.flat_algebraMap_iff.mpr ‹Module.Flat R' B›)), inferInstance, inferInstance, ?_, ?_⟩
  · rw [hX, ← hJ]
    refine ⟨AlgEquiv.ofRingEquiv (f := e) fun a => ?_⟩
    rw [IsScalarTower.algebraMap_apply k B (B ⧸ J), IsScalarTower.algebraMap_apply k k' B,
      ← IsScalarTower.algebraMap_apply k' B (B ⧸ J)]
    exact he _
  · have hN' : algebraMap R' B (PowerSeries.X ^ N) ∈
        fittingIdeal (M := KaehlerDifferential (PowerSeries k) B) (d : ℤ) := by
      rwa [fittingIdeal_eq_of_linearEquiv
        (kaehlerDifferential_equiv_of_baseRingEquiv (B := B) ePS rfl) d]
    simpa [hX, map_pow] using hN'

/-- **Stacks 0E7X.** Let `k` be a field and let `A` be a local `k`-algebra, essentially of finite
type over `k` and a complete intersection over `k`. Then `A` is the special fibre `B/tB` of a flat
`k⟦t⟧`-algebra `B` essentially of finite type over `k⟦t⟧`, and for some `n` the element `t^n` lies
in the `d`-th Fitting ideal of `Ω_{B/k⟦t⟧}`, where `d = dim(A) + trdeg_k(κ)` for `κ` the residue
field of `A`. -/
@[stacks 0E7X]
public theorem exists_flat_essFiniteType_specialFiber_pow_mem_fittingIdeal
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A]
    [IsLocalRing A] [Algebra.EssFiniteType k A]
    (hA : IsCompleteIntersectionLocalRing k A) :
    ∃ (dimA trdegResidue n : ℕ),
      ringKrullDim A = (dimA : WithBot ℕ∞) ∧
      Algebra.trdeg k (IsLocalRing.ResidueField A) = trdegResidue ∧
      ∃ (B : Type (max u v)) (_ : CommRing B) (_ : Algebra (PowerSeries k) B)
        (_ : Algebra.EssFiniteType (PowerSeries k) B) (_ : Module.Flat (PowerSeries k) B)
        (_ : Algebra k B) (_ : IsScalarTower k (PowerSeries k) B),
        Nonempty
          ((B ⧸ Ideal.span {algebraMap (PowerSeries k) B PowerSeries.X}) ≃ₐ[k] A) ∧
          algebraMap (PowerSeries k) B (PowerSeries.X ^ n) ∈
            fittingIdeal (M := KaehlerDifferential (PowerSeries k) B)
              ((dimA + trdegResidue : ℕ) : ℤ) := by
  have : IsNoetherianRing A := hA.isNoetherianRing
  obtain ⟨dimENat, hdimA'⟩ := WithBot.ne_bot_iff_exists.mp (ringKrullDim_ne_bot (R := A))
  have hdimA_top : dimENat ≠ ⊤ := by
    rintro rfl
    exact ringKrullDim_ne_top (R := A) hdimA'.symm
  obtain ⟨dimA, rfl⟩ := ENat.ne_top_iff_exists.mp hdimA_top
  have hdimA : ringKrullDim A = (dimA : WithBot ℕ∞) := hdimA'.symm
  obtain ⟨trdegResidue, htrdegResidue⟩ := exists_nat_trdeg_residueField_eq k A
  let : Algebra (ULift.{v} k) A := ULift.algebra' k A
  obtain ⟨P, _, _, _, hTowerPA, p, _, hPci, _, hPdim⟩ :=
    exists_isGlobalCompleteIntersection_ringKrullDim_eq_add_trdeg k A hA
  have : IsScalarTower (ULift.{v} k) P A := hTowerPA
  obtain ⟨Q, _, _, _, _, _, _, hspecial, hgeneric, ⟨n, c, pres, _, hdim⟩⟩ :=
    exists_flat_powerSeries_specialFiber_smooth_genericFiber (ULift.{v} k) P hPci
  have hPN : Nontrivial P := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨⟨p, ‹_›⟩⟩
  have hdim_index : n - c = dimA + trdegResidue := by
    rw [hdim hPN, hdimA, htrdegResidue] at hPdim
    norm_num at hPdim
    exact_mod_cast hPdim
  have : Nontrivial (Q ⧸ Ideal.span {algebraMap (PowerSeries (ULift.{v} k)) Q PowerSeries.X}) :=
    (Classical.choice hspecial).symm.injective.nontrivial
  have : Nontrivial Q := (Ideal.Quotient.mk_surjective : Function.Surjective (Ideal.Quotient.mk
    (Ideal.span {algebraMap (PowerSeries (ULift.{v} k)) Q PowerSeries.X}))).nontrivial
  obtain ⟨N, hNQ⟩ := exists_pow_X_mem_fittingIdeal_of_smooth_genericFiber pres hgeneric
    (d := dimA + trdegResidue) hdim_index.le
  obtain ⟨q, _, B, _, _, _, _, _, hquot⟩ := exists_localized_special_fiber
      (Ideal.span {algebraMap (PowerSeries (ULift.{v} k)) Q PowerSeries.X})
      (Classical.choice hspecial) p (A := ULift.{u} A)
      (IsLocalization.isLocalization_of_algEquiv p.primeCompl
        (ULift.algEquiv (R := P) (A := A)).symm)
  let : Algebra (PowerSeries (ULift.{v} k)) B :=
    (algebraMap Q B).comp (algebraMap (PowerSeries (ULift.{v} k)) Q) |>.toAlgebra
  have : IsScalarTower (PowerSeries (ULift.{v} k)) Q B := IsScalarTower.of_algebraMap_eq' rfl
  have : Module.Flat Q B := IsLocalization.flat B q.primeCompl
  have : Module.Flat (PowerSeries (ULift.{v} k)) B := Module.Flat.trans _ Q B
  have : Algebra.EssFiniteType Q B := Algebra.EssFiniteType.of_isLocalization B q.primeCompl
  have : Algebra.EssFiniteType (PowerSeries (ULift.{v} k)) Q := .of_finiteType _ Q
  have : Algebra.EssFiniteType (PowerSeries (ULift.{v} k)) B := Algebra.EssFiniteType.comp _ Q B
  have hk' (a : ULift.{v} k) : algebraMap (ULift.{v} k) B a = algebraMap
      (PowerSeries (ULift.{v} k)) B (algebraMap (ULift.{v} k) (PowerSeries (ULift.{v} k)) a) := by
    rw [IsScalarTower.algebraMap_apply (ULift.{v} k) Q B,
      IsScalarTower.algebraMap_apply (ULift.{v} k) (PowerSeries (ULift.{v} k)) Q,
      ← IsScalarTower.algebraMap_apply (PowerSeries (ULift.{v} k)) Q B]
  have hfit : algebraMap (PowerSeries (ULift.{v} k)) B (PowerSeries.X ^ N) ∈ fittingIdeal
      (M := KaehlerDifferential (PowerSeries (ULift.{v} k)) B) ((dimA + trdegResidue : ℕ) : ℤ) := by
    rw [fittingIdeal_kaehler_localization (R := PowerSeries (ULift.{v} k)) (Q := Q) (B := B)
      q.primeCompl (dimA + trdegResidue),
      IsScalarTower.algebraMap_apply (PowerSeries (ULift.{v} k)) Q B, map_pow]
    exact Ideal.mem_map_of_mem _ hNQ
  refine ⟨dimA, trdegResidue, N, hdimA, htrdegResidue, B, inferInstance, ?_⟩
  exact exists_powerSeries_of_powerSeries_ulift k A B hk'
    (by rw [Ideal.map_span, Set.image_singleton,
      ← IsScalarTower.algebraMap_apply (PowerSeries (ULift.{v} k)) Q B])
    ((Classical.choice hquot).toRingEquiv.trans ULift.ringEquiv)
    (fun a => congrArg ULift.down ((Classical.choice hquot).commutes a)) hfit

end Deformation.Examples.Smoothing

