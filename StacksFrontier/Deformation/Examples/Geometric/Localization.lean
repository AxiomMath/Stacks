/-!
# Localization of deformations of an algebra

Let `P` be a `k`-algebra and `S ⊆ P` a multiplicative subset. Localizing a deformation of `P`
at the inverse image of `S` produces a deformation of `S⁻¹P` over the same Artinian base, and
this construction is a functor over `𝒞_Λ` from the deformation category of `P` to that of
`S⁻¹P`.

The inverse image of `S` in the flat algebra of a deformation is the preimage along the map to
the special fibre, which is surjective because the deformation is cartesian over a surjection
of Artinian bases. Surjectivity makes the localization square a pushout, which is what shows
the localized flat algebra is again cartesian over `(k, S⁻¹P)`; and on morphisms of
deformations the two inverse images differ by a nilpotent ideal, so each localization is also
the localization at the image of the other and the square on morphisms is a pushout too.

## Main definitions

* `Deformation.Examples.fiberLocalizationMap`: the map on localizations induced by a ring map
  and the inverse image of a multiplicative subset.
* `Deformation.Examples.localizedFlatAlgebra`: the flat algebra of a localized deformation.
* `Deformation.Examples.localizedDeformation`: the localized deformation.
* `Deformation.Examples.localizedMorphism`: the localization of a morphism of deformations.
* `Deformation.Examples.LocalizationFunctorData`: a functor of deformation categories over
  `𝒞_Λ` together with the data exhibiting it as localization.

## Main results

* `Deformation.Examples.deformationBaseMap_surjective` and
  `Deformation.Examples.deformationSpecialFiberMap_surjective`: the two structure maps of a
  deformation down to the special fibre are surjective.
* `Deformation.Examples.deformationSpecialFiber_ker_le_map_maximalIdeal`: the kernel of the map
  to the special fibre lies in the ideal generated by the maximal ideal of the base.
* `Deformation.Examples.localizationFunctor`: localization at `S` is a functor from
  deformations of `P` to deformations of `S⁻¹P`, with the canonical localization map on every
  flat algebra.

## Implementation notes

The functor is packaged with its comparison data rather than stated bare, because the source's
assertion is not just that some functor exists but that it localizes: the recorded data says
that the map out of each flat algebra is a localization at the inverse image of `S`, that it is
a map of algebras over the common Artinian base, that it is compatible with reduction to the
special fibre, and that it is natural in morphisms of deformations. The base-compatibility
clause has to transport the base along the equality of Artinian bases supplied by the based
functor, which is what the `cast` expresses.

## References

* [Stacks Project, Tag 0DYS](https://stacks.math.columbia.edu/tag/0DYS)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u w

namespace Deformation.Examples

variable {Λ : Type u} {k P : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
  [CommRing P] [Algebra k P]

/-- The map from the localization at the inverse image of `S` to the localization at `S`,
induced by a ring map into `P`. -/
noncomputable def fiberLocalizationMap (S : Submonoid P)
    {Q : Type*} [CommRing Q] (f : Q →+* P) :
    Localization (S.comap f) →+* Localization S :=
  IsLocalization.map (M := S.comap f) (S := Localization (S.comap f))
    (T := S) (Localization S) f (by intro x hx; exact hx)

/-- `fiberLocalizationMap S f` sends the image of `x` in the localization of `Q` to the image
of `f x` in the localization of `P`. -/
theorem fiberLocalizationMap_algebraMap (S : Submonoid P)
    {Q : Type*} [CommRing Q] (f : Q →+* P) (x : Q) :
    fiberLocalizationMap S f (algebraMap Q (Localization (S.comap f)) x) =
      algebraMap P (Localization S) (f x) := by
  simp [fiberLocalizationMap]

/-- The flat algebra of a deformation, localized at the inverse image of `S`. -/
noncomputable def localizedFlatAlgebra (S : Submonoid P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    FlatAlgebraCategory.{u, w} Λ k where
  base := X.left.base
  fiber := Localization (S.comap X.hom.map.hom)
  flat := Module.Flat.trans X.left.base X.left.fiber
    (Localization (S.comap X.hom.map.hom))

/-- The map of Artinian bases of a deformation is surjective: it is surjective on residue
fields by construction and the target is a field. -/
theorem deformationBaseMap_surjective (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    Function.Surjective X.hom.base.hom.toRingHom := by
  intro y
  obtain ⟨r, hr⟩ := X.left.base.residueEquiv.surjective y
  obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective r
  refine ⟨a, ?_⟩
  have hcomm := X.hom.base.residue_comm a
  rw [ha] at hcomm
  have hres : X.hom.base.hom a =
      (residueFieldAlgebra (Λ := Λ) (k := k) P).base.residueEquiv
        (IsLocalRing.residue k (X.hom.base.hom a)) :=
    (residueFieldBase_residueEquiv_residue Λ k (X.hom.base.hom a)).symm
  exact hres.trans (hcomm.trans hr)

/-- The map from the flat algebra of a deformation to the special fibre is surjective. -/
theorem deformationSpecialFiberMap_surjective
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    Function.Surjective X.hom.map.hom := by
  let A := X.left.base
  let Q := X.left.fiber
  let : Algebra A k := X.hom.base.hom.toRingHom.toAlgebra
  let : Algebra A P := Algebra.compHom P (algebraMap A k)
  let : Algebra Q P := X.hom.map.hom.toAlgebra
  let : IsScalarTower A k P := .of_algebraMap_eq' rfl
  have hw := (congrArg CommRingCat.Hom.hom X.hom.cartesian.w).symm
  change (algebraMap k P).comp (algebraMap A k) =
      (X.hom.map.hom).comp (algebraMap A Q) at hw
  have hA : algebraMap A P = (algebraMap k P).comp (algebraMap A k) := rfl
  have hQ : (X.hom.map.hom).comp (algebraMap A Q) =
      (algebraMap Q P).comp (algebraMap A Q) := rfl
  let : IsScalarTower A Q P :=
    IsScalarTower.of_algebraMap_eq' (hA.trans (hw.trans hQ))
  let : Algebra.IsPushout A Q k P :=
    CommRingCat.isPushout_iff_isPushout.mp X.hom.cartesian
  let e := Algebra.IsPushout.equiv A Q k P
  have hi : Function.Surjective
      (Algebra.TensorProduct.includeLeft : Q →ₐ[Q] Q ⊗[A] k) :=
    Algebra.TensorProduct.includeLeft_surjective (S := Q) (A := Q)
      (deformationBaseMap_surjective X)
  intro p
  obtain ⟨t, rfl⟩ := e.surjective p
  obtain ⟨q, hq⟩ := hi t
  refine ⟨q, ?_⟩
  rw [← hq]
  have hs : e.symm (X.hom.map.hom q) = q ⊗ₜ[A] (1 : k) := by
    change e.symm (algebraMap Q P q) = q ⊗ₜ[A] (1 : k)
    exact Algebra.IsPushout.equiv_symm_algebraMap_left
      (R := A) (S := Q) (R' := k) (S' := P) q
  apply e.symm.injective
  rw [e.symm_apply_apply, Algebra.TensorProduct.includeLeft_apply]
  exact hs

/-- Localizing along a surjection gives a pushout square of commutative rings. -/
theorem localizationSquare (S : Submonoid P)
    {Q : Type w} [CommRing Q] (f : Q →+* P) (hf : Function.Surjective f) :
    IsPushout (CommRingCat.ofHom f)
      (CommRingCat.ofHom (algebraMap Q (Localization (S.comap f))))
      (CommRingCat.ofHom (algebraMap P (Localization S)))
      (CommRingCat.ofHom (fiberLocalizationMap S f)) := by
  let U := S.comap f
  have hU : U.map f = S := Submonoid.map_comap_eq_of_surjective hf S
  let : IsLocalization (U.map f) (Localization S) := by
    rw [hU]
    infer_instance
  have hcomm : (fiberLocalizationMap S f).comp (algebraMap Q (Localization U)) =
      (algebraMap P (Localization S)).comp f :=
    RingHom.ext (fiberLocalizationMap_algebraMap S f)
  exact CommRingCat.isPushout_of_isLocalization f (fiberLocalizationMap S f) hcomm U

/-- A morphism of deformations commutes with the maps to the special fibre. -/
theorem deformationMorphism_map_comm
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (g : X ⟶ Y)
    (x : X.left.fiber) : Y.hom.map.hom (g.left.map.hom x) = X.hom.map.hom x := by
  have h := congrArg (fun (φ : X.left ⟶
      residueFieldAlgebra (Λ := Λ) (k := k) P) => φ.map.hom x) (Over.w g)
  change Y.hom.map.hom (g.left.map.hom x) = X.hom.map.hom x at h
  exact h

/-- The map of localizations induced by a morphism of deformations. -/
noncomputable def localizedHomMap (S : Submonoid P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (g : X ⟶ Y) :
    Localization (S.comap X.hom.map.hom) →+* Localization (S.comap Y.hom.map.hom) :=
  IsLocalization.map (M := S.comap X.hom.map.hom)
    (S := Localization (S.comap X.hom.map.hom))
    (T := S.comap Y.hom.map.hom)
    (Localization (S.comap Y.hom.map.hom)) g.left.map.hom (by
      intro x hx
      change X.hom.map.hom x ∈ S at hx
      change Y.hom.map.hom (g.left.map.hom x) ∈ S
      rw [deformationMorphism_map_comm g x]
      exact hx)

/-- `localizedHomMap S g` sends the image of `x` to the image of `g.left.map.hom x`. -/
theorem localizedHomMap_algebraMap (S : Submonoid P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (g : X ⟶ Y) (x : X.left.fiber) :
    localizedHomMap S g (algebraMap X.left.fiber
      (Localization (S.comap X.hom.map.hom)) x) =
      algebraMap Y.left.fiber (Localization (S.comap Y.hom.map.hom))
        (g.left.map.hom x) := by
  simp [localizedHomMap]

/-- The localized map to the special fibre sends the image of `x` to the image of
`X.hom.map.hom x` in the localization of `P`. -/
theorem deformationLocalizationMap_algebraMap (S : Submonoid P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) (x : X.left.fiber) :
    fiberLocalizationMap S X.hom.map.hom
      (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) x) =
      algebraMap P (Localization S) (X.hom.map.hom x) :=
  fiberLocalizationMap_algebraMap S X.hom.map.hom x

/-- The localization of a deformation of `P` at the inverse image of `S`, as a deformation of
`S⁻¹P`. -/
noncomputable def localizedDeformation (S : Submonoid P)
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    ringDeformationCategory (Λ := Λ) (k := k) (Localization S) := by
  refine Over.mk (X := residueFieldAlgebra (Λ := Λ) (k := k) (Localization S))
    (Y := localizedFlatAlgebra S X) ?_
  refine ⟨X.hom.base, CommRingCat.ofHom (fiberLocalizationMap S X.hom.map.hom), ?_⟩
  let : IsScalarTower X.left.base X.left.fiber
      (Localization (S.comap X.hom.map.hom)) := inferInstance
  let : IsScalarTower k P (Localization S) := inferInstance
  have hloc := localizationSquare S X.hom.map.hom (deformationSpecialFiberMap_surjective X)
  have hpaste := X.hom.cartesian.paste_horiz hloc.flip
  refine hpaste.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ rfl rfl ?_
  · rw [← CommRingCat.ofHom_comp]
    exact congrArg CommRingCat.ofHom
      (IsScalarTower.algebraMap_eq X.left.base X.left.fiber
        (Localization (S.comap X.hom.map.hom))).symm
  · change CommRingCat.ofHom (algebraMap k P) ≫
      CommRingCat.ofHom (algebraMap P (Localization S)) =
      CommRingCat.ofHom (algebraMap k (Localization S))
    rw [← CommRingCat.ofHom_comp]

/-- The kernel of the map from a deformation to its special fibre is contained in the ideal
generated by the maximal ideal of the Artinian base. -/
theorem deformationSpecialFiber_ker_le_map_maximalIdeal
    (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    RingHom.ker X.hom.map.hom ≤
      Ideal.map (algebraMap X.left.base X.left.fiber)
        (IsLocalRing.maximalIdeal X.left.base) := by
  let A := X.left.base
  let Q := X.left.fiber
  let : Algebra A k := X.hom.base.hom.toRingHom.toAlgebra
  let : Algebra A P := Algebra.compHom P (algebraMap A k)
  let : Algebra Q P := X.hom.map.hom.toAlgebra
  let : IsScalarTower A k P := .of_algebraMap_eq' rfl
  have hw := (congrArg CommRingCat.Hom.hom X.hom.cartesian.w).symm
  change (algebraMap k P).comp (algebraMap A k) =
      (X.hom.map.hom).comp (algebraMap A Q) at hw
  have hA : algebraMap A P = (algebraMap k P).comp (algebraMap A k) := rfl
  have hQ : (X.hom.map.hom).comp (algebraMap A Q) =
      (algebraMap Q P).comp (algebraMap A Q) := rfl
  let : IsScalarTower A Q P := IsScalarTower.of_algebraMap_eq' (hA.trans (hw.trans hQ))
  let : Algebra.IsPushout A Q k P :=
    CommRingCat.isPushout_iff_isPushout.mp X.hom.cartesian
  let e := Algebra.IsPushout.equiv A Q k P
  let m := IsLocalRing.maximalIdeal A
  have hsurj : Function.Surjective (algebraMap A k) := deformationBaseMap_surjective X
  have hker : RingHom.ker (algebraMap A k) = m :=
    IsLocalRing.ker_eq_maximalIdeal (algebraMap A k) hsurj
  let ek₀ : (A ⧸ RingHom.ker (algebraMap A k)) ≃ₐ[A] k :=
    Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId A k) hsurj
  let ek : (A ⧸ m) ≃ₐ[A] k :=
    (Ideal.quotientEquivAlgOfEq A hker.symm).trans ek₀
  let et : Q ⊗[A] k ≃ₗ[A] Q ⧸ (m • (⊤ : Submodule A Q)) :=
    (Algebra.TensorProduct.congr (AlgEquiv.refl : Q ≃ₐ[A] Q) ek.symm).toLinearEquiv.trans
      (TensorProduct.tensorQuotEquivQuotSMul Q m)
  intro x hx
  have hxf : X.hom.map.hom x = (0 : P) := RingHom.mem_ker.mp hx
  have hx' : et (e.symm (X.hom.map.hom x)) = 0 := by
    rw [hxf, map_zero, map_zero]
  have hpush : e.symm (X.hom.map.hom x) = x ⊗ₜ[A] (1 : k) := by
    change e.symm (algebraMap Q P x) = x ⊗ₜ[A] (1 : k)
    exact Algebra.IsPushout.equiv_symm_algebraMap_left
      (R := A) (S := Q) (R' := k) (S' := P) x
  rw [hpush] at hx'
  have hcalc : et (x ⊗ₜ[A] (1 : k)) = (m • (⊤ : Submodule A Q)).mkQ x := by
    change TensorProduct.tensorQuotEquivQuotSMul Q m
      ((Algebra.TensorProduct.congr (AlgEquiv.refl : Q ≃ₐ[A] Q) ek.symm).toLinearEquiv
        (x ⊗ₜ[A] (1 : k))) = _
    have hcong :
        (Algebra.TensorProduct.congr (AlgEquiv.refl : Q ≃ₐ[A] Q) ek.symm).toLinearEquiv
          (x ⊗ₜ[A] (1 : k)) = x ⊗ₜ[A] (1 : A ⧸ m) := by
      simp
    rw [hcong]
    simpa using TensorProduct.tensorQuotEquivQuotSMul_tmul_mk m x (1 : A)
  rw [hcalc] at hx'
  change Submodule.Quotient.mk x = 0 at hx'
  rwa [Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_map] at hx'

/-- Localizing a morphism of deformations gives a pushout square of commutative rings: the two
inverse images of `S` differ by a nilpotent ideal, so each localization is also the
localization at the image of the other. -/
theorem localizedMorphism_square (S : Submonoid P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (g : X ⟶ Y) :
    IsPushout (CommRingCat.ofHom (algebraMap X.left.fiber
        (Localization (S.comap X.hom.map.hom))))
      (CommRingCat.ofHom g.left.map.hom)
      (CommRingCat.ofHom (localizedHomMap S g))
      (CommRingCat.ofHom (algebraMap Y.left.fiber
        (Localization (S.comap Y.hom.map.hom)))) := by
  let Q := X.left.fiber
  let R := Y.left.fiber
  let U := S.comap X.hom.map.hom
  let W := S.comap Y.hom.map.hom
  let qloc := Localization U
  let v : Q →+* R := g.left.map.hom
  let fX : Q →+* P := X.hom.map.hom
  let fY : R →+* P := Y.hom.map.hom
  let V := U.map v
  have hVU : V ≤ W := by
    rintro z ⟨x, hx, rfl⟩
    change Y.hom.map.hom (g.left.map.hom x) ∈ S
    rw [deformationMorphism_map_comm g x]
    exact hx
  have hWdiv : ∀ y : R, y ∈ W → ∃ z : R, z ∈ V ∧ y ∣ z := by
    intro y hy
    obtain ⟨x, hx⟩ := deformationSpecialFiberMap_surjective X (fY y)
    have hxU : x ∈ U := by
      change fX x ∈ S
      change fY y ∈ S at hy
      exact hx ▸ hy
    let d : R := y - v x
    have hdzero : fY d = 0 := by
      dsimp [d]
      rw [map_sub]
      have hcomm : fY (v x) = fX x := deformationMorphism_map_comm g x
      have heq : fY y = fY (v x) := (hcomm.trans hx).symm
      rw [heq, sub_self]
    have hdm : d ∈ Ideal.map (algebraMap Y.left.base R)
        (IsLocalRing.maximalIdeal Y.left.base) :=
      deformationSpecialFiber_ker_le_map_maximalIdeal Y (RingHom.mem_ker.mpr hdzero)
    obtain ⟨n, hn⟩ :=
      (isArtinianRing_iff_isNilpotent_maximalIdeal Y.left.base).mp inferInstance
    have hpow :
        (Ideal.map (algebraMap Y.left.base R)
          (IsLocalRing.maximalIdeal Y.left.base)) ^ n = 0 := by
      rw [← Ideal.map_pow, hn]
      simp
    have hnil : IsNilpotent d := ⟨n, Ideal.pow_eq_zero_of_mem hpow le_rfl hdm⟩
    have hnil' : IsNilpotent (algebraMap R (Localization V) d) :=
      hnil.map (algebraMap R (Localization V))
    have hxV : v x ∈ V := ⟨x, hxU, rfl⟩
    have hunit : IsUnit (algebraMap R (Localization V) (v x)) :=
      IsLocalization.map_units (Localization V) ⟨v x, hxV⟩
    have hyunit : IsUnit (algebraMap R (Localization V) y) := by
      have heq : algebraMap R (Localization V) y =
          algebraMap R (Localization V) (v x) + algebraMap R (Localization V) d := by
        simp [d]
      rw [heq]
      exact hnil'.isUnit_add_left_of_commute hunit (Commute.all _ _)
    exact (IsLocalization.algebraMap_isUnit_iff (M := V) (S := Localization V)).mp hyunit
  have hWloc : IsLocalization W (Localization V) :=
    (IsLocalization.iff_of_le_of_exists_dvd V W hVU hWdiv).mp inferInstance
  let e : Localization W ≃ₐ[R] Localization V := Localization.algEquiv W (Localization V)
  have hVloc : IsLocalization V (Localization W) :=
    IsLocalization.isLocalization_of_algEquiv V e.symm
  let : IsLocalization (U.map v) (Localization W) := by
    simpa [V] using hVloc
  have hcomm : (localizedHomMap S g).comp (algebraMap Q qloc) =
      (algebraMap R (Localization W)).comp v :=
    RingHom.ext (localizedHomMap_algebraMap S g)
  exact (CommRingCat.isPushout_of_isLocalization v (localizedHomMap S g) hcomm U).flip

/-- The localization of a morphism of deformations. -/
noncomputable def localizedMorphism (S : Submonoid P)
    {X Y : ringDeformationCategory (Λ := Λ) (k := k) P} (g : X ⟶ Y) :
    localizedDeformation S X ⟶ localizedDeformation S Y := by
  let h : (localizedDeformation S X).left ⟶ (localizedDeformation S Y).left :=
    { base := g.left.base
      map := CommRingCat.ofHom (localizedHomMap S g)
      cartesian := by
        have hpaste := g.left.cartesian.paste_horiz (localizedMorphism_square S g)
        refine hpaste.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) (Iso.refl _)
          ?_ rfl rfl ?_
        · rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom
            (IsScalarTower.algebraMap_eq X.left.base X.left.fiber
              (Localization (S.comap X.hom.map.hom))).symm
        · rw [← CommRingCat.ofHom_comp]
          exact congrArg CommRingCat.ofHom
            (IsScalarTower.algebraMap_eq Y.left.base Y.left.fiber
              (Localization (S.comap Y.hom.map.hom))).symm }
  refine Over.homMk h ?_
  let : Algebra X.left.fiber (Localization (S.comap X.hom.map.hom)) := inferInstance
  let : IsLocalization (S.comap X.hom.map.hom)
      (Localization (S.comap X.hom.map.hom)) := inferInstance
  apply FlatAlgebraCategory.Hom.ext
  · exact congrArg (fun φ => φ.base) (Over.w g)
  · apply CommRingCat.hom_ext
    change (fiberLocalizationMap S Y.hom.map.hom).comp (localizedHomMap S g) =
      fiberLocalizationMap S X.hom.map.hom
    apply IsLocalization.ringHom_ext (M := S.comap X.hom.map.hom)
    ext x
    change fiberLocalizationMap S Y.hom.map.hom
        (localizedHomMap S g (algebraMap X.left.fiber
          (Localization (S.comap X.hom.map.hom)) x)) =
      fiberLocalizationMap S X.hom.map.hom
        (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) x)
    rw [localizedHomMap_algebraMap,
      deformationLocalizationMap_algebraMap S Y (g.left.map.hom x),
      deformationLocalizationMap_algebraMap S X x]
    exact congrArg (algebraMap P (Localization S))
      (deformationMorphism_map_comm g x)

/-- A functor on deformations of `P`, over `𝒞_Λ`, whose action is localization at the inverse
image of `S` in every deformation. -/
structure LocalizationFunctorData (S : Submonoid P) where
  /-- The functor of deformation categories over `𝒞_Λ`. -/
  functor : BasedFunctor
    (BasedCategory.ofFunctor
      (Over.forget (residueFieldAlgebra (Λ := Λ) (k := k) P) ⋙
        FlatAlgebraCategory.projection))
    (BasedCategory.ofFunctor
      (Over.forget (residueFieldAlgebra (Λ := Λ) (k := k)
        (Localization S)) ⋙ FlatAlgebraCategory.projection))
  /-- The localization map out of the flat algebra of each deformation. -/
  localizationMap (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    X.left.fiber →+* (functor.obj X).left.fiber
  /-- The localization map is a map of algebras over the common Artinian base. -/
  base_comm (X : ringDeformationCategory (Λ := Λ) (k := k) P) (a : X.left.base) :
    localizationMap X (algebraMap X.left.base X.left.fiber a) =
      algebraMap (functor.obj X).left.base (functor.obj X).left.fiber
        (cast (congrArg ArtinianLocalAlgCat.carrier
          (congrArg (fun F => F.obj X) functor.w).symm) a)
  /-- The localization map is a localization at the inverse image of `S`. -/
  isLocalization (X : ringDeformationCategory (Λ := Λ) (k := k) P) :
    letI : Algebra X.left.fiber (functor.obj X).left.fiber := (localizationMap X).toAlgebra
    IsLocalization (S.comap X.hom.map.hom) (functor.obj X).left.fiber
  /-- The localization map is compatible with reduction to the special fibre. -/
  specialFiber_comm (X : ringDeformationCategory (Λ := Λ) (k := k) P) (q : X.left.fiber) :
    algebraMap P (Localization S) (X.hom.map.hom q) =
      (functor.obj X).hom.map.hom (localizationMap X q)
  /-- The localization maps are natural in morphisms of deformations. -/
  naturality {X Y : ringDeformationCategory (Λ := Λ) (k := k) P}
      (g : X ⟶ Y) (q : X.left.fiber) :
    localizationMap Y (g.left.map.hom q) =
      (functor.map g).left.map.hom (localizationMap X q)

/-- Localization at `S` gives a natural functor from deformations of `P` to deformations of
`S⁻¹P`, with the canonical localization map on every flat algebra. -/
@[stacks 0DYS]
noncomputable def localizationFunctor (S : Submonoid P) :
    LocalizationFunctorData (Λ := Λ) (k := k) S := by
  let F : ringDeformationCategory (Λ := Λ) (k := k) P ⥤
      ringDeformationCategory (Λ := Λ) (k := k) (Localization S) := {
    obj := localizedDeformation S
    map := fun g => localizedMorphism S g
    map_id := by
      intro X
      let : Algebra X.left.fiber (Localization (S.comap X.hom.map.hom)) := inferInstance
      let : IsLocalization (S.comap X.hom.map.hom)
          (Localization (S.comap X.hom.map.hom)) := inferInstance
      apply Over.OverMorphism.ext
      apply FlatAlgebraCategory.Hom.ext
      · change ((𝟙 X : X ⟶ X).left).base = 𝟙 (X.left).base
        rfl
      · apply CommRingCat.hom_ext
        change localizedHomMap S (𝟙 X) = RingHom.id _
        apply IsLocalization.ringHom_ext (M := S.comap X.hom.map.hom)
        ext q
        change localizedHomMap S (𝟙 X)
            (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q) =
          (RingHom.id _)
            (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q)
        rw [localizedHomMap_algebraMap]
        change algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q =
          algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q
        rfl
    map_comp := by
      intro X Y Z f g
      let : Algebra X.left.fiber (Localization (S.comap X.hom.map.hom)) := inferInstance
      let : IsLocalization (S.comap X.hom.map.hom)
          (Localization (S.comap X.hom.map.hom)) := inferInstance
      apply Over.OverMorphism.ext
      apply FlatAlgebraCategory.Hom.ext
      · change ((f ≫ g).left).base = f.left.base ≫ g.left.base
        rfl
      · apply CommRingCat.hom_ext
        change localizedHomMap S (f ≫ g) =
          (localizedHomMap S g).comp (localizedHomMap S f)
        apply IsLocalization.ringHom_ext (M := S.comap X.hom.map.hom)
        ext q
        change localizedHomMap S (f ≫ g)
            (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q) =
          localizedHomMap S g
            (localizedHomMap S f
              (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q))
        rw [localizedHomMap_algebraMap, localizedHomMap_algebraMap,
          localizedHomMap_algebraMap]
        rfl }
  refine ⟨BasedFunctor.mk F ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rfl
  · intro X
    change X.left.fiber →+* Localization (S.comap X.hom.map.hom)
    exact algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom))
  · intro X a
    change algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom))
        (algebraMap X.left.base X.left.fiber a) =
      algebraMap X.left.base (Localization (S.comap X.hom.map.hom)) a
    exact IsScalarTower.algebraMap_apply X.left.base X.left.fiber
      (Localization (S.comap X.hom.map.hom)) a
  · intro X
    exact (IsLocalization.isLocalization_iff_of_ringEquiv
      (M := S.comap X.hom.map.hom)
      (S := Localization (S.comap X.hom.map.hom)) (RingEquiv.refl _)).mp inferInstance
  · intro X q
    exact (fiberLocalizationMap_algebraMap S X.hom.map.hom q).symm
  · intro X Y g q
    change algebraMap Y.left.fiber (Localization (S.comap Y.hom.map.hom))
        (g.left.map.hom q) = localizedHomMap S g
          (algebraMap X.left.fiber (Localization (S.comap X.hom.map.hom)) q)
    exact (localizedHomMap_algebraMap S g q).symm

end Deformation.Examples
