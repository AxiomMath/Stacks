module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Deformation.Examples.Geometric.RingsHypersurfaceTangentSpace
public import StacksFrontier.Deformation.Examples.Geometric.RingsTangentSpaceEquivTangent
public import StacksFrontier.Deformation.SquareZero.ConormalLiftFunctional
public import StacksFrontier.RingTheory.MvPowerSeries.HypersurfaceJacobian

/-!
# The tangent space of a formal hypersurface is finite dimensional (Stacks 0DY5(2))

Let `k` be a field, `f` a formal power series in `S = k[[x_1, …, x_n]]` and `P = S/(f)` the
formal hypersurface it cuts out. Part (2) of Tag 0DY5 says that the tangent space `T𝓓_P` of
the deformation category of `P` is finite dimensional over `k` as soon as the Jacobian ideal
`(f, ∂f/∂x_1, …, ∂f/∂x_n)` has radical the ideal generated by the variables.

The proof is the source's. A first-order deformation of `P` is a square-zero extension of `P`
by `P`; the power series presentation `S → P` lifts to it, which presents it as
`k[ε][[x_1, …, x_n]]/(f + εg)`, and changing the lifts of the variables changes `g` by a
combination of the `∂f/∂x_i`. Formally: the tangent space is `Ext¹_P(NL_{P/k}, P)` by
**Stacks 0DY3**, which is the conormal cokernel of the canonical polynomial presentation by
**Stacks 0GPU**; every class of that cokernel is pulled back along `S → P`, because `S → P`
lifts through every square-zero extension of `P` by `P`
(`Deformation.Examples.exists_powerSeries_lift_hypersurfaceExtension`) and two lifts of the
canonical presentation differ by the conormal differential; the conormal module of `S → P` is
generated by the class of `f`, so the module of its conormal functionals is finite over `P`
and hence so is the cokernel; and the Jacobian ideal annihilates the cokernel, by the
derivative relation
`Algebra.Extension.exists_comp_cotangentComplex_eq_derivation_smul`. A finite module
annihilated by an isolated Jacobian ideal is finite dimensional over `k`, which is
`Stacks.MvPowerSeries.Hypersurface.finiteDimensional_of_jacobian_annihilates`.

## Main results

* `Deformation.Examples.hypersurfaceExtension`: the power series presentation of a formal
  hypersurface, read as an extension.
* `Deformation.Examples.surjective_hypersurfacePullback`: every class of the conormal cokernel
  of the canonical presentation of `P` comes from a conormal functional of the power series
  presentation.
* `Deformation.Examples.finiteDimensional_conormalCokernel_hypersurface`: that cokernel is
  finite dimensional over `k` under the radical hypothesis.
* `Deformation.Examples.hypersurface_finiteDimensional_tangentSpace`: **Stacks 0DY5(2)**, the
  tangent space of the deformation category of `P` is finite dimensional over `k`.

## Implementation notes

The hypotheses `f ≠ 0` and `f ∈ (x_1, …, x_n)²` are the standing hypotheses of the source's
Lemma 0DY5 and are carried, although the argument for part (2) does not use them.

The vector space structure on the tangent space is the canonical one of Stacks 06IH, which
instance search reads off two `Fact` instances introduced by `letI` inside the statement, as
in Stacks 06IW and in the tangent-space clause of Stacks 0DY3.

The fields of `Stacks.Deformation.algebraExtensionProblem k P P` are `k` and `P`, but only up
to unfolding that definition, which instance search does not do; so the power series ring is
given its algebra structures over and into those fields explicitly, and the extension is
written as a structure literal, so that its ring and its kernel are the power series ring and
`(f)` with no unfolding.

## References

* [Stacks Project, Tag 0DY5](https://stacks.math.columbia.edu/tag/0DY5)
* [Stacks Project, Tag 0DY3](https://stacks.math.columbia.edu/tag/0DY3)
* [Stacks Project, Tag 0GPU](https://stacks.math.columbia.edu/tag/0GPU)
-/

@[expose] public noncomputable section

open CategoryTheory Stacks.Deformation

namespace Deformation.Examples

attribute [local instance] HasDerivedCategory.standard

attribute [local instance] moduleBaseNaiveCotangentExtOne isScalarTowerBaseNaiveCotangentExtOne

universe u w

section Hypersurface

variable {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)

/-- The formal hypersurface `k[[x_1, …, x_n]]/(f)`. -/
abbrev Hypersurface : Type w := MvPowerSeries (Fin n) k ⧸ Ideal.span {f}

/-- The power series ring is an algebra over the base of the extension problem of `P` by `P`:
that base is `k`, restated because instance search does not unfold the problem. -/
instance algebraProblemBaseMvPowerSeries :
    Algebra (prob k (Hypersurface n f) (Hypersurface n f)).A (MvPowerSeries (Fin n) k) :=
  inferInstanceAs (Algebra k (MvPowerSeries (Fin n) k))

/-- The target of the extension problem of `P` by `P` is an algebra over the power series
ring: it is `P`, restated because instance search does not unfold the problem. -/
instance algebraMvPowerSeriesProblemTarget :
    Algebra (MvPowerSeries (Fin n) k) (prob k (Hypersurface n f) (Hypersurface n f)).B :=
  inferInstanceAs (Algebra (MvPowerSeries (Fin n) k) (Hypersurface n f))

/-- The scalar tower from the base of the extension problem of `P` by `P` through the power
series ring to its target: it is `k → k[[x_1, …, x_n]] → P`, restated because instance search
does not unfold the problem. -/
instance isScalarTowerProblemMvPowerSeries :
    IsScalarTower (prob k (Hypersurface n f) (Hypersurface n f)).A
      (MvPowerSeries (Fin n) k) (prob k (Hypersurface n f) (Hypersurface n f)).B :=
  inferInstanceAs (IsScalarTower k (MvPowerSeries (Fin n) k) (Hypersurface n f))

/-- The target of the extension problem of `P` by `P` is a `k`-algebra: it is `P`, restated
because instance search does not unfold the problem. -/
instance algebraBaseProblemTarget :
    Algebra k (prob k (Hypersurface n f) (Hypersurface n f)).B :=
  inferInstanceAs (Algebra k (Hypersurface n f))

/-- The target of the extension problem of `P` by `P` is a finite module over the power series
ring: it is the quotient `P`, restated because instance search does not unfold the problem. -/
instance moduleFiniteMvPowerSeriesProblemTarget :
    Module.Finite (MvPowerSeries (Fin n) k)
      (prob k (Hypersurface n f) (Hypersurface n f)).B :=
  inferInstanceAs (Module.Finite (MvPowerSeries (Fin n) k) (Hypersurface n f))

/-- The scalar tower `k → k[[x_1, …, x_n]] → P` with `P` read as the target of the extension
problem of `P` by `P`, restated because instance search does not unfold the problem. -/
instance isScalarTowerBaseMvPowerSeriesProblem :
    IsScalarTower k (MvPowerSeries (Fin n) k)
      (prob k (Hypersurface n f) (Hypersurface n f)).B :=
  inferInstanceAs (IsScalarTower k (MvPowerSeries (Fin n) k) (Hypersurface n f))

/-- The power series presentation `k[[x_1, …, x_n]] → P` of a formal hypersurface, read as an
extension of `P` over `k`. -/
abbrev hypersurfaceExtension : Algebra.Extension.{w}
    (prob k (Hypersurface n f) (Hypersurface n f)).A
    (prob k (Hypersurface n f) (Hypersurface n f)).B where
  Ring := MvPowerSeries (Fin n) k
  σ := fun b ↦ Classical.choose (Ideal.Quotient.mk_surjective (I := Ideal.span {f}) b)
  algebraMap_σ := fun b ↦
    Classical.choose_spec (Ideal.Quotient.mk_surjective (I := Ideal.span {f}) b)

/-- The kernel of the power series presentation of a formal hypersurface is the ideal `(f)`. -/
lemma hypersurfaceExtension_ker : (hypersurfaceExtension n f).ker = Ideal.span {f} := by
  change RingHom.ker (algebraMap (MvPowerSeries (Fin n) k) (Hypersurface n f)) = Ideal.span {f}
  rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker]

/-- The class of `f` in the conormal module of the power series presentation. -/
def hypersurfaceConormalGen : (hypersurfaceExtension n f).ker :=
  ⟨f, (hypersurfaceExtension_ker n f).ge (Ideal.mem_span_singleton_self f)⟩

/-- **Stacks 0DY5(2), the choice of lifts.** The power series presentation of a formal
hypersurface lifts through every square-zero extension of `P` by `P`. -/
lemma nonempty_hom_hypersurfaceExtension
    (Z : (prob k (Hypersurface n f) (Hypersurface n f)).CompatibleExtension.{w}) :
    Nonempty ((hypersurfaceExtension n f).Hom (solutionExtension Z)) := by
  obtain ⟨g, hg⟩ := exists_powerSeries_lift_hypersurfaceExtension n f Z
  exact ⟨{ toRingHom := g.toRingHom
           toRingHom_algebraMap := g.commutes
           algebraMap_toRingHom := hg }⟩

/-- Conormal functionals of the power series presentation of a formal hypersurface. -/
abbrev HypersurfaceFunctional :=
  (hypersurfaceExtension n f).Cotangent →ₗ[
    (prob k (Hypersurface n f) (Hypersurface n f)).B]
    (prob k (Hypersurface n f) (Hypersurface n f)).N

/-- Pulling back a conormal functional of the power series presentation to the canonical
polynomial presentation, read in the conormal cokernel. -/
def hypersurfacePullback :
    HypersurfaceFunctional n f →ₗ[(prob k (Hypersurface n f) (Hypersurface n f)).B]
      conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f)) :=
  pullbackClass (hypersurfaceExtension n f) (canonicalHom (hypersurfaceExtension n f))

/-- **Every first-order deformation of a formal hypersurface comes from the power series
presentation.** This is the surjectivity on which Stacks 0DY5(2) rests. -/
theorem surjective_hypersurfacePullback :
    Function.Surjective (hypersurfacePullback n f) := fun c ↦
  LinearMap.mem_range.mp
    (mem_range_pullbackClass (canonicalHom (hypersurfaceExtension n f))
      (nonempty_hom_hypersurfaceExtension n f)
      (splitAlgebraExtension k (Hypersurface n f) (Hypersurface n f)) c)

/-- The conormal module of the power series presentation is generated by the class of `f`. -/
lemma span_cotangent_hypersurfaceExtension :
    Submodule.span (prob k (Hypersurface n f) (Hypersurface n f)).B
        (Set.range fun _ : Unit ↦ Algebra.Extension.Cotangent.mk
          (P := hypersurfaceExtension n f) (hypersurfaceConormalGen n f)) = ⊤ :=
  Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker (P := hypersurfaceExtension n f)
    (fun _ : Unit ↦ f)
    (by
      rw [hypersurfaceExtension_ker]
      congr 1
      simp)

/-- The conormal functionals of the power series presentation form a finite module over `P`:
the conormal module is generated by the class of `f`, so evaluating at that class is an
injection into `P`, which is Noetherian. -/
lemma moduleFinite_hypersurfaceFunctional :
    Module.Finite (prob k (Hypersurface n f) (Hypersurface n f)).B
      (HypersurfaceFunctional n f) := by
  let g : HypersurfaceFunctional n f →ₗ[(prob k (Hypersurface n f) (Hypersurface n f)).B]
      (prob k (Hypersurface n f) (Hypersurface n f)).N :=
    { toFun := fun δ ↦ δ (Algebra.Extension.Cotangent.mk
        (P := hypersurfaceExtension n f) (hypersurfaceConormalGen n f))
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hinj : Function.Injective g := by
    rw [injective_iff_map_eq_zero]
    intro δ hδ
    exact LinearMap.ext_on_range (span_cotangent_hypersurfaceExtension n f)
      (fun _ ↦ hδ.trans (LinearMap.zero_apply _).symm)
  have : IsNoetherian (prob k (Hypersurface n f) (Hypersurface n f)).B
      (prob k (Hypersurface n f) (Hypersurface n f)).N :=
    inferInstanceAs (IsNoetherian (Hypersurface n f) (Hypersurface n f))
  exact Module.Finite.of_injective g hinj

/-- The conormal cokernel of the canonical presentation of a formal hypersurface is a finite
module over `P`. -/
lemma moduleFinite_conormalCokernel_hypersurface :
    Module.Finite (prob k (Hypersurface n f) (Hypersurface n f)).B
      (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) := by
  have := moduleFinite_hypersurfaceFunctional n f
  exact Module.Finite.of_surjective (hypersurfacePullback n f)
    (surjective_hypersurfacePullback n f)

/-- The derivatives of `f` annihilate the conormal cokernel: changing the lifts of the
variables changes the equation of the deformation by a combination of the `∂f/∂x_i`, which is
`Algebra.Extension.exists_comp_cotangentComplex_eq_derivation_smul`. -/
lemma pderiv_smul_conormalCokernel_eq_zero (i : Fin n)
    (c : conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :
    (algebraMap (MvPowerSeries (Fin n) k)
        (prob k (Hypersurface n f) (Hypersurface n f)).B
      (MvPowerSeries.pderiv k i f)) • c = 0 := by
  obtain ⟨δ, rfl⟩ := surjective_hypersurfacePullback n f c
  obtain ⟨t, ht⟩ := Algebra.Extension.exists_comp_cotangentComplex_eq_derivation_smul
    (hypersurfaceExtension n f) f (hypersurfaceExtension_ker n f) (MvPowerSeries.pderiv k i) δ
  rw [← map_smul, hypersurfacePullback, pullbackClass_apply, Submodule.Quotient.mk_eq_zero]
  refine LinearMap.mem_range.mpr ⟨t ∘ₗ Algebra.Extension.CotangentSpace.map
    (canonicalHom (hypersurfaceExtension n f)), ?_⟩
  refine LinearMap.ext fun z ↦ ?_
  have hz := LinearMap.congr_fun ht
    (Algebra.Extension.Cotangent.map (canonicalHom (hypersurfaceExtension n f)) z)
  refine Eq.trans ?_ hz.symm
  change t (Algebra.Extension.CotangentSpace.map (canonicalHom (hypersurfaceExtension n f))
      ((canonicalExtension k (Hypersurface n f) (Hypersurface n f)).cotangentComplex z)) =
    t ((hypersurfaceExtension n f).cotangentComplex
      (Algebra.Extension.Cotangent.map (canonicalHom (hypersurfaceExtension n f)) z))
  rw [Algebra.Extension.CotangentSpace.map_cotangentComplex]

/-- **Stacks 0DY5(2) for the conormal cokernel.** Under the radical hypothesis on the Jacobian
ideal, the conormal cokernel of the canonical presentation of `P = k[[x_1, …, x_n]]/(f)` — that
is, `Ext¹_P(NL_{P/k}, P)` — is a finite dimensional `k`-vector space. -/
theorem finiteDimensional_conormalCokernel_hypersurface
    (hjac : (Ideal.span ({f} ∪ Set.range
      (fun i : Fin n ↦ MvPowerSeries.pderiv k i f))).radical =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) :
    letI : Module k (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
      Module.compHom _ (algebraMap k (prob k (Hypersurface n f) (Hypersurface n f)).B)
    FiniteDimensional k
      (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) := by
  let : Module k (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    Module.compHom _ (algebraMap k (prob k (Hypersurface n f) (Hypersurface n f)).B)
  let : Module (MvPowerSeries (Fin n) k)
      (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    Module.compHom _ (algebraMap (MvPowerSeries (Fin n) k)
      (prob k (Hypersurface n f) (Hypersurface n f)).B)
  have : IsScalarTower (MvPowerSeries (Fin n) k)
      (prob k (Hypersurface n f) (Hypersurface n f)).B
      (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    ⟨fun a b x ↦ by
      rw [Algebra.smul_def]
      exact mul_smul (algebraMap (MvPowerSeries (Fin n) k)
        (prob k (Hypersurface n f) (Hypersurface n f)).B a) b x⟩
  have := moduleFinite_conormalCokernel_hypersurface n f
  have : Module.Finite (MvPowerSeries (Fin n) k)
      (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    Module.Finite.trans (prob k (Hypersurface n f) (Hypersurface n f)).B _
  have : IsScalarTower k (MvPowerSeries (Fin n) k)
      (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    ⟨fun a b x ↦ by
      change (algebraMap (MvPowerSeries (Fin n) k)
            (prob k (Hypersurface n f) (Hypersurface n f)).B (a • b)) • x =
          (algebraMap k (prob k (Hypersurface n f) (Hypersurface n f)).B a) •
            ((algebraMap (MvPowerSeries (Fin n) k)
              (prob k (Hypersurface n f) (Hypersurface n f)).B b) • x)
      rw [Algebra.smul_def, map_mul, mul_smul, ← IsScalarTower.algebraMap_apply]⟩
  refine Stacks.MvPowerSeries.Hypersurface.finiteDimensional_of_jacobian_annihilates n f hjac
    (Ideal.span_le.mpr ?_)
  rintro a (ha | ⟨i, rfl⟩)
  · rw [Set.mem_singleton_iff] at ha
    refine Module.mem_annihilator.mpr fun c ↦ ?_
    rw [ha]
    change (algebraMap (MvPowerSeries (Fin n) k)
      (prob k (Hypersurface n f) (Hypersurface n f)).B f) • c = 0
    rw [show algebraMap (MvPowerSeries (Fin n) k)
        (prob k (Hypersurface n f) (Hypersurface n f)).B f = 0 from
      (Ideal.Quotient.algebraMap_eq (Ideal.span {f}) ▸
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)), zero_smul]
  · exact Module.mem_annihilator.mpr fun c ↦ pderiv_smul_conormalCokernel_eq_zero n f i c

/-- The comparison of **Stacks 0GPU** between `Ext¹_P(NL_{P/k}, P)` and the conormal cokernel
of the canonical presentation of `P`, read `k`-linearly: both `k`-structures are the
restriction of the `P`-structures along `k → P`, so the `P`-linear comparison
`Stacks.Deformation.extCokernelLinearIso` is `k`-linear. -/
def naiveCotangentExtOneLinearEquivConormalCokernel :
    letI : Module k (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
      Module.compHom _ (algebraMap k (prob k (Hypersurface n f) (Hypersurface n f)).B)
    naiveCotangentExtOne k (Hypersurface n f) (Hypersurface n f) ≃ₗ[k]
      conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f)) :=
  letI : Module k (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    Module.compHom _ (algebraMap k (prob k (Hypersurface n f) (Hypersurface n f)).B)
  let e := extCokernelLinearIso k (Hypersurface n f) (Hypersurface n f)
  { toFun := e
    map_add' := e.map_add
    map_smul' := fun a x ↦ e.map_smul (algebraMap k (Hypersurface n f) a) x
    invFun := e.symm
    left_inv := e.left_inv
    right_inv := e.right_inv }

/-- **Stacks 0DY5(2).** Let `k` be a field, `f` a nonzero formal power series in
`k[[x_1, …, x_n]]` lying in the square of the ideal generated by the variables, and
`P = k[[x_1, …, x_n]]/(f)` the formal hypersurface it cuts out. If the Jacobian ideal
`(f, ∂f/∂x_1, …, ∂f/∂x_n)` has radical the ideal generated by the variables, then the tangent
space `T𝓓_P` of the deformation category of `P` of Stacks 0DY1 — with the canonical
`k`-vector-space structure of Stacks 06IH — is finite dimensional over `k`.

The tangent space is `Ext¹_P(NL_{P/k}, P)` by the tangent-space clause of Stacks 0DY3, that
group is the conormal cokernel of the canonical presentation of `P` by Stacks 0GPU, and the
cokernel is finite dimensional by
`Deformation.Examples.finiteDimensional_conormalCokernel_hypersurface`. -/
@[stacks 0DY5 "part (2)"]
theorem hypersurface_finiteDimensional_tangentSpace {Λ : Type u} [CommRing Λ] [Algebra Λ k]
    (hf : f ≠ 0)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2)
    (hjac : (Ideal.span ({f} ∪ Set.range
      (fun i : Fin n ↦ MvPowerSeries.pderiv k i f))).radical =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) :
    letI : Fact (IsPredeformationCategory
        (ringDeformationBasedCategory Λ k (Hypersurface n f)).p) :=
      ⟨(ringDeformationCategory_isDeformationCategory (Hypersurface n f)).predeformation⟩
    letI : Fact (SchlessingerConditionS2 (CategoryOfElements.π
      (isomorphismClasses (ringDeformationBasedCategory Λ k (Hypersurface n f))
        isCofiberedInGroupoids_ringDeformationProjection))) :=
      ⟨schlessingerConditionS2_ringDeformation Λ k (Hypersurface n f)⟩
    FiniteDimensional k (artinianTangentSpace Λ k
      (isomorphismClasses (ringDeformationBasedCategory Λ k (Hypersurface n f))
        isCofiberedInGroupoids_ringDeformationProjection)) := by
  let : Fact (IsPredeformationCategory
      (ringDeformationBasedCategory Λ k (Hypersurface n f)).p) :=
    ⟨(ringDeformationCategory_isDeformationCategory (Hypersurface n f)).predeformation⟩
  let : Fact (SchlessingerConditionS2 (CategoryOfElements.π
    (isomorphismClasses (ringDeformationBasedCategory Λ k (Hypersurface n f))
      isCofiberedInGroupoids_ringDeformationProjection))) :=
    ⟨schlessingerConditionS2_ringDeformation Λ k (Hypersurface n f)⟩
  let : Module k (conormalCokernel (prob k (Hypersurface n f) (Hypersurface n f))) :=
    Module.compHom _ (algebraMap k (prob k (Hypersurface n f) (Hypersurface n f)).B)
  have := finiteDimensional_conormalCokernel_hypersurface n f hjac
  have : FiniteDimensional k
      (naiveCotangentExtOne k (Hypersurface n f) (Hypersurface n f)) :=
    Module.Finite.equiv (naiveCotangentExtOneLinearEquivConormalCokernel n f).symm
  exact Module.Finite.equiv
    (ringDeformationTangentSpaceLinearEquivExtOne Λ k (Hypersurface n f)).symm

end Hypersurface

end Deformation.Examples

end
