module

public import Mathlib.RingTheory.DualNumber
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.RingTheory.Ideal.Span

/-!
# The maximal ideal of a ring with a dual-number coordinate

Let `A` be a ring with an isomorphism `A ≅ k[ε]` of `Λ`-algebras onto the dual numbers over a
field.  The element `ε` of `A` it picks out generates the maximal ideal and is its own
annihilator: `εa = 0` exactly when `a ∈ εA`.

## Main results

* `DualNumber.eps_mul_eq_zero_iff_mem_span`, `DualNumber.mem_span_eps_iff`.
* `IsLocalRing.maximalIdeal_eq_span_of_algEquiv_dualNumber` and
  `mul_eq_zero_iff_mem_span_of_algEquiv_dualNumber`.
-/

@[expose] public section

open TrivSqZeroExt

namespace DualNumber

variable {k : Type*} [Field k]

/-- An element of the dual numbers is a multiple of `ε` exactly when its constant term
vanishes. -/
theorem mem_span_eps_iff (x : DualNumber k) :
    x ∈ Ideal.span {(ε : DualNumber k)} ↔ fst x = 0 := by
  rw [Ideal.mem_span_singleton']
  refine ⟨?_, fun hx => ⟨inl (snd x), ?_⟩⟩
  · rintro ⟨y, rfl⟩
    simp
  · ext <;> simp [hx]

/-- `ε x = 0` exactly when `x` is a multiple of `ε`. -/
theorem eps_mul_eq_zero_iff_mem_span (x : DualNumber k) :
    (ε : DualNumber k) * x = 0 ↔ x ∈ Ideal.span {(ε : DualNumber k)} := by
  rw [mem_span_eps_iff]
  refine ⟨fun h => by simpa using congrArg snd h, fun h => ?_⟩
  ext <;> simp [h]

end DualNumber

section Transport

variable {Λ A k : Type*} [CommRing Λ] [CommRing A] [IsLocalRing A] [Algebra Λ A] [Field k]
  [Algebra Λ k] (iε : A ≃ₐ[Λ] DualNumber k)

/-- Membership in the ideal generated by `e.symm ε` can be tested after applying `e`. -/
private theorem mem_span_symm_eps_iff {B : Type*} [CommRing B] [Algebra Λ B]
    (e : B ≃ₐ[Λ] DualNumber k) (a : B) :
    a ∈ Ideal.span {e.symm DualNumber.eps} ↔
      e a ∈ Ideal.span {(DualNumber.eps : DualNumber k)} := by
  rw [Ideal.mem_span_singleton', Ideal.mem_span_singleton']
  refine ⟨?_, ?_⟩
  · rintro ⟨b, rfl⟩
    exact ⟨e b, by rw [map_mul, AlgEquiv.apply_symm_apply]⟩
  · rintro ⟨b, hb⟩
    refine ⟨e.symm b, e.injective ?_⟩
    rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply, hb]

omit [IsLocalRing A] in
/-- The element `ε` of a ring with a dual-number coordinate is its own annihilator. -/
theorem mul_eq_zero_iff_mem_span_of_algEquiv_dualNumber (a : A) :
    iε.symm DualNumber.eps * a = 0 ↔ a ∈ Ideal.span {iε.symm DualNumber.eps} := by
  have h1 : iε.symm DualNumber.eps * a = 0 ↔ DualNumber.eps * iε a = 0 := by
    rw [← iε.injective.eq_iff, map_mul, AlgEquiv.apply_symm_apply, map_zero]
  rw [h1, mem_span_symm_eps_iff iε, DualNumber.eps_mul_eq_zero_iff_mem_span]

/-- The maximal ideal of a local ring with a dual-number coordinate is generated by `ε`. -/
theorem IsLocalRing.maximalIdeal_eq_span_of_algEquiv_dualNumber :
    IsLocalRing.maximalIdeal A = Ideal.span {iε.symm DualNumber.eps} := by
  ext a
  rw [mem_span_symm_eps_iff iε, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    ← isUnit_map_iff iε.toRingEquiv a, ← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal,
    DualNumber.maximalIdeal_eq_span_singleton_eps]
  rfl

end Transport

end
