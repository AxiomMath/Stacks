module

public import StacksFrontier.AlgebraicGeometry.Cohomology.GlobalGeneration.Stalks
public import StacksFrontier.Deformation.Examples.Geometric.SchemeMorphismObstructionSourceIdealMap

/-!
# The generators of the ideal of the source thickening of Stacks 0E3V

The ideal of `f⁻¹𝒪_{Y'} ⟶ f⁻¹𝒪_Y` is generated, locally on `X`, by the global sections `ũ(m)`
induced by the functions `(0, m)` of `Spec k[M]`. The input is that `𝒪_Y ⊗_k M` is generated by
its global sections `1 ⊗ m`, which is read off the adjunction `p_Y^* ⊣ p_{Y,*}` on the one-point
space `Spec k`, and that a family of global sections generating a sheaf of modules generates each
of its local sections near every point.

## Main results

* `Stacks.SheafOfModules.exists_res_mem_sectionSpan_of_epi`: a family of global sections
  generating a sheaf of modules spans every local section near every point.
* `Deformation.Examples.sourceIdealGenerator_span`: **(Y3)** every local section of the ideal is,
  on the members of a cover, in the ideal generated by the `ũ(m)`.

## References

* [Stacks Project, Tag 0E3V](https://stacks.math.columbia.edu/tag/0E3V)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.SheafOfModules

variable {X : TopCat.{u}} {O : Sheaf (Opens.grothendieckTopology X) RingCat.{u}}
  (F : _root_.SheafOfModules.{u} O) {I : Type u} (s : I → F.sections)

/-- The span, over the sections of the ring on `W`, of the values on `W` of a family of global
sections. -/
abbrev sectionSpan (W : Opens X) : _root_.Submodule (O.obj.obj (op W)) (F.val.obj (op W)) :=
  _root_.Submodule.span (O.obj.obj (op W)) (Set.range fun i => (s i).eval (op W))

variable {F s}

/-- Restriction of a section, typed as a section on the smaller open. -/
abbrev sres {W W' : Opens X} (h : W' ≤ W) (b : F.val.obj (op W)) : F.val.obj (op W') :=
  (F.val.map (homOfLE h).op).hom b

/-- The restriction of a section in the span of the family lies in the span of the family. -/
theorem res_mem_sectionSpan {W W' : Opens X} (h : W' ≤ W) {a : F.val.obj (op W)}
    (ha : a ∈ sectionSpan F s W) :
    (F.val.map (homOfLE h).op a : F.val.obj (op W')) ∈ sectionSpan F s W' := by
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact _root_.Submodule.subset_span ⟨i, ((s i).2 (homOfLE h).op).symm⟩
  | zero =>
    exact (congrArg (· ∈ sectionSpan F s W') (map_zero (F.val.map (homOfLE h).op).hom)).mpr
      (_root_.Submodule.zero_mem _)
  | add x y _ _ hx hy =>
    exact (congrArg (· ∈ sectionSpan F s W') (map_add (F.val.map (homOfLE h).op).hom x y)).mpr
      (_root_.Submodule.add_mem _ hx hy)
  | smul r x _ hx =>
    exact (congrArg (· ∈ sectionSpan F s W') (PresheafOfModules.map_smul F.val _ r x)).mpr
      (_root_.Submodule.smul_mem _ _ hx)

variable (F s) in
/-- The germs at `x` of local sections lying, on their open, in the span of the family. -/
def spanGerms (x : X) : Set ((TopCat.Presheaf.stalk F.val.presheaf x : AddCommGrpCat) : Type u) :=
  {t | ∃ (W : Opens X) (hx : x ∈ W) (b : F.val.obj (op W)),
    (TopCat.Presheaf.germ F.val.presheaf W x hx).hom b = t ∧ b ∈ sectionSpan F s W}

/-- The germ of a member of the family lies in `spanGerms`. -/
theorem germ_mem_spanGerms (x : X) (i : I) :
    (TopCat.Presheaf.germ F.val.presheaf ⊤ x trivial).hom ((s i).eval (op ⊤)) ∈ spanGerms F s x :=
  ⟨⊤, trivial, _, rfl, _root_.Submodule.subset_span ⟨i, rfl⟩⟩

/-- `spanGerms` is closed under addition. -/
theorem add_mem_spanGerms {x : X}
    {t t' : ((TopCat.Presheaf.stalk F.val.presheaf x : AddCommGrpCat) : Type u)}
    (ht : t ∈ spanGerms F s x) (ht' : t' ∈ spanGerms F s x) : t + t' ∈ spanGerms F s x := by
  obtain ⟨W, hx, b, rfl, hb⟩ := ht
  obtain ⟨W', hx', b', rfl, hb'⟩ := ht'
  have hxx : x ∈ W ⊓ W' := ⟨hx, hx'⟩
  refine ⟨W ⊓ W', hxx, sres inf_le_left b + sres inf_le_right b', ?_,
      _root_.Submodule.add_mem _ (res_mem_sectionSpan _ hb) (res_mem_sectionSpan _ hb')⟩
  exact (map_add (TopCat.Presheaf.germ F.val.presheaf (W ⊓ W') x hxx).hom _ _).trans
    (congrArg₂ (· + ·) (TopCat.Presheaf.germ_res_apply _ _ _ _ _)
      (TopCat.Presheaf.germ_res_apply _ _ _ _ _))

/-- `spanGerms` contains zero. -/
theorem zero_mem_spanGerms (x : X) :
    (0 : ((TopCat.Presheaf.stalk F.val.presheaf x : AddCommGrpCat) : Type u)) ∈
    spanGerms F s x :=
  ⟨⊤, trivial, 0, map_zero _, _root_.Submodule.zero_mem _⟩

/-- `spanGerms` is closed under scalar multiplication by the stalk of the ring. -/
theorem smul_mem_spanGerms {x : X} (r : ((TopCat.Presheaf.stalk O.obj x : RingCat) : Type u))
    {t : ((TopCat.Presheaf.stalk F.val.presheaf x : AddCommGrpCat) : Type u)}
    (ht : t ∈ spanGerms F s x) : r • t ∈ spanGerms F s x := by
  obtain ⟨W, hx, b, rfl, hb⟩ := ht
  obtain ⟨U, hxU, ρ, rfl⟩ := TopCat.Presheaf.germ_exist O.obj r
  have hxx : x ∈ U ⊓ W := ⟨hxU, hx⟩
  refine ⟨U ⊓ W, hxx, (O.obj.map (homOfLE inf_le_left).op ρ) • sres inf_le_right b, ?_,
      _root_.Submodule.smul_mem _ _ (res_mem_sectionSpan _ hb)⟩
  refine (PresheafOfModules.germ_ringCat_smul F.val x (U ⊓ W) hxx _ _).trans ?_
  exact congrArg₂ (· • ·) (TopCat.Presheaf.germ_res_apply _ _ _ _ _)
    (TopCat.Presheaf.germ_res_apply _ _ _ _ _)

/-- **A family of global sections generating a sheaf of modules spans every local section near
every point.** -/
theorem exists_res_mem_sectionSpan_of_epi [Epi (F.freeHomEquiv.symm s)] {W : Opens X}
    (a : F.val.obj (op W)) (x : X) (hx : x ∈ W) :
    ∃ (W' : Opens X) (h : W' ≤ W), x ∈ W' ∧
      (F.val.map (homOfLE h).op a : F.val.obj (op W')) ∈ sectionSpan F s W' := by
  have hspan := (AlgebraicGeometry.generates_iff_stalkwise_generates O F s).1 inferInstance x
  have hmem : (TopCat.Presheaf.germ F.val.presheaf W x hx).hom a ∈ spanGerms F s x := by
    have ha : (TopCat.Presheaf.germ F.val.presheaf W x hx).hom a ∈ _root_.Submodule.span
        (R := (TopCat.Presheaf.stalk O.obj x : RingCat))
        (Set.range fun i ↦ (TopCat.Presheaf.Γgerm F.val.presheaf x).hom
          ((s i).eval (Opposite.op ⊤))) := by
      rw [hspan]; trivial
    refine _root_.Submodule.span_induction (p := fun t _ => t ∈ spanGerms F s x)
      ?_ (zero_mem_spanGerms x) (fun _ _ _ _ h h' => add_mem_spanGerms h h')
      (fun r _ _ h => smul_mem_spanGerms r h) ha
    rintro _ ⟨i, rfl⟩
    exact germ_mem_spanGerms x i
  obtain ⟨W₁, hx₁, b, hb, hbs⟩ := hmem
  obtain ⟨W₂, hx₂, i₁, i₂, he⟩ := TopCat.Presheaf.germ_eq F.val.presheaf x hx₁ hx b a hb
  refine ⟨W₂, leOfHom i₂, hx₂, ?_⟩
  have he' : (F.val.map (homOfLE (leOfHom i₂)).op a : F.val.obj (op W₂)) =
      F.val.map (homOfLE (leOfHom i₁)).op b := he.symm
  rw [he']
  exact res_mem_sectionSpan (leOfHom i₁) hbs

end Stacks.SheafOfModules

namespace Deformation.Examples

open AlgebraicGeometry Stacks.SheafOfModules AlgebraicGeometry.RingedSpaceThickening

variable {k : Type u} [Field k]

/-- The global sections `1 ⊗ m` of `p^* M^~`, as compatible families of sections. -/
def coefficientSections {Z : Scheme.{u}} (p : Z ⟶ Spec (CommRingCat.of k)) (M : FGModuleCat.{u} k)
    (m : M) : ((Scheme.Modules.pullback p).obj (tilde M.obj)).sections :=
  PresheafOfModules.sectionsMk
    (fun _ => ((Scheme.Modules.pullback p).obj (tilde M.obj)).val.map (homOfLE le_top).op
      (coefficientSheafSection p M m))
    (fun _ _ g => map_map_eq_map ((Scheme.Modules.pullback p).obj (tilde M.obj)) _ g _ _)

/-- The value on `⊤` of `coefficientSections p M m` is `coefficientSheafSection p M m`. -/
theorem coefficientSections_eval_top {Z : Scheme.{u}} (p : Z ⟶ Spec (CommRingCat.of k))
    (M : FGModuleCat.{u} k) (m : M) :
    (coefficientSections p M m).eval (op ⊤) = coefficientSheafSection p M m :=
  map_self_eq _ _ _

/-- **`p^* M^~` is generated by its global sections `1 ⊗ m`.** A map out of `p^* M^~` killing
them is zero, being determined on them (`coefficientSheaf_hom_ext`). -/
theorem epi_coefficientSections {Z : Scheme.{u}} (p : Z ⟶ Spec (CommRingCat.of k))
    (M : FGModuleCat.{u} k) :
    Epi (((Scheme.Modules.pullback p).obj (tilde M.obj)).freeHomEquiv.symm
      (coefficientSections p M)) := by
  refine Preadditive.epi_of_cancel_zero _ fun {Q} g hg => ?_
  refine coefficientSheaf_hom_ext (F := Q) p M fun m => ?_
  rw [← coefficientSections_eval_top,
    ← _root_.SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection (coefficientSections p M) m]
  exact congrArg (fun φ => (φ.val.app (op ⊤)).hom
    ((_root_.SheafOfModules.freeSection (R := Z.ringCatSheaf) m).eval (op ⊤))) hg

/-- Every open of the source of a closed immersion is the preimage of an open of the target. -/
private theorem exists_preimage_eq_of_isClosedImmersion {Y Y' : Scheme.{u}} (j : Y ⟶ Y')
    [IsClosedImmersion j] (O : Y.Opens) : ∃ W : Y'.Opens, ∀ y, y ∈ j ⁻¹ᵁ W ↔ y ∈ O := by
  obtain ⟨W, hWo, hW⟩ := j.isClosedEmbedding.isInducing.isOpen_iff.1 O.isOpen
  exact ⟨⟨W, hWo⟩, fun y => Set.ext_iff.1 hW y⟩

/-- **Local lifts along a closed immersion.** A section of `𝒪_Y` is, near each point, the
restriction of the comorphism of a section of `𝒪_{Y'}`. -/
theorem exists_app_eq_of_isClosedImmersion {Y Y' : Scheme.{u}} (j : Y ⟶ Y') [IsClosedImmersion j]
    {O : Y.Opens} (r : Γ(Y, O)) (y : Y) (hy : y ∈ O) :
    ∃ (W : Y'.Opens) (hW : j ⁻¹ᵁ W ≤ O), y ∈ j ⁻¹ᵁ W ∧ ∃ b : Γ(Y', W),
      j.app W b = (Y.presheaf.map (homOfLE hW).op).hom r := by
  obtain ⟨t, ht⟩ := j.stalkMap_surjective y (Y.presheaf.germ O y hy r)
  obtain ⟨W₀, hW₀, b₀, rfl⟩ := Y'.presheaf.exists_germ_eq t
  rw [Scheme.Hom.germ_stalkMap_apply] at ht
  obtain ⟨O', hyO', i₁, i₂, he⟩ := TopCat.Presheaf.germ_eq _ y hW₀ hy _ _ ht
  obtain ⟨W'', hW''⟩ := exists_preimage_eq_of_isClosedImmersion j O'
  let W : Y'.Opens := W₀ ⊓ W''
  have hWO' : j ⁻¹ᵁ W ≤ O' := fun z hz => (hW'' z).1 hz.2
  have hyW : y ∈ j ⁻¹ᵁ W := ⟨hW₀, (hW'' y).2 hyO'⟩
  refine ⟨W, hWO'.trans (leOfHom i₂), hyW, (Y'.presheaf.map (homOfLE inf_le_left).op).hom b₀, ?_⟩
  have hn := ConcreteCategory.congr_hom (j.naturality (homOfLE (inf_le_left : W ≤ W₀)).op) b₀
  refine (CommRingCat.comp_apply _ _ _).symm.trans (hn.trans ?_)
  refine (CommRingCat.comp_apply _ _ _).trans ?_
  have h₁ := congrArg (Y.presheaf.map (homOfLE hWO').op).hom he
  refine Eq.trans ?_ (h₁.trans ?_)
  · exact (ringPresheaf_map_map _ _ _ _ _).symm
  · exact ringPresheaf_map_map _ _ _ _ _

section Generators

open Stacks.Sites.Conormal Stacks.Topology RingedSpaceModuleAdjunction

variable {Λ : Type u} [CommRing Λ] [Algebra Λ k]
variable {X Y : Scheme.{u}} (f : X ⟶ Y) (pY : Y ⟶ baseSpec (residueFieldBase Λ k))
  {M : FGModuleCat.{u} k}
  (yε : (schemeDeformationCategoryProjection (Λ := Λ) (k := k) (Over.mk pY)).Fiber
    ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))

variable (M) in
/-- The global sections of the pulled-back ideal of `k[M]` on `Y` corresponding to the `1 ⊗ m`. -/
def pulledIdealSections (m : M) :
    (SchemeDeformationCategory.pulledIdeal ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M)
      (Over.mk pY)).sections :=
  _root_.SheafOfModules.sectionsMap (pulledIdealCoefficientIso (Λ := Λ) M (Over.mk pY)).inv
    (coefficientSections (Over.mk pY).hom M m)

variable (M) in
/-- The sections `pulledIdealSections pY M` generate the pulled-back ideal. -/
theorem epi_pulledIdealSections :
    Epi ((SchemeDeformationCategory.pulledIdeal ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M)
      (Over.mk pY)).freeHomEquiv.symm (pulledIdealSections pY M)) := by
  have := epi_coefficientSections (Over.mk pY).hom M
  have h := _root_.SheafOfModules.freeHomEquiv_symm_comp (coefficientSections (Over.mk pY).hom M)
    (pulledIdealCoefficientIso (Λ := Λ) M (Over.mk pY)).inv
  have h2 : Epi (pulledIdealCoefficientIso (Λ := Λ) M (Over.mk pY)).inv := inferInstance
  have h1 : @Epi (SheafOfModules.{u} (structureSheafRing (Over.mk pY).left.toRingedSpace)) _ _ _
      (((Scheme.Modules.pullback (Over.mk pY).hom).obj (tilde M.obj)).freeHomEquiv.symm
        (coefficientSections (Over.mk pY).hom M)) := this
  exact h ▸ @epi_comp (SheafOfModules.{u} (structureSheafRing (Over.mk pY).left.toRingedSpace)) _
    _ _ _ _ h1 _ h2

/-- The value on `⊤` of `pulledIdealSections pY M m` is `sourceIdealBaseSection pY yε m`. -/
theorem pulledIdealSections_eval_top (m : M) :
    (pulledIdealSections pY M m).eval (op ⊤) = sourceIdealBaseSection pY yε m := by
  have h₁ := pulledIdealCoefficientIso_inv_coefficientSheafSection (Λ := Λ) M (Over.mk pY)
    (squareZeroSpecFunction (Λ := Λ) M m) (residueSpecMap_squareZeroSpecFunction m) m
    (squareZeroSpecFunction_hom m)
  have h₂ := (sourceIdealBaseSection_eq pY yε m).trans
    ((sourceSolution pY yε).toMorphismOfThickenings.pushforwardComparison_val_app _ (op ⊤) _)
  refine Eq.trans ?_ (h₂.trans (map_self_eq _ _ _)).symm
  show ((pulledIdealCoefficientIso (Λ := Λ) M (Over.mk pY)).inv.val.app (op ⊤)).hom
    ((coefficientSections (Over.mk pY).hom M m).eval (op ⊤)) = _
  rwa [coefficientSections_eval_top]

/-- The ideal of the sections of `f⁻¹𝒪_{Y'}` on `V` generated by the restrictions of the `ũ(m)`. -/
abbrev generatorSpan (V : Opens X.carrier) :
    Ideal ((Scheme.liftSource yε.1.specialMap f).obj.obj (op V)) :=
  Ideal.span (Set.range fun m => ((Scheme.liftSource yε.1.specialMap f).obj.map
    (homOfLE (le_top (a := V))).op).hom (sourceIdealGenerator f pY yε m))

variable {f pY yε} in
/-- The restriction of a member of `generatorSpan f pY yε V₁` lies in `generatorSpan f pY yε V₂`.
-/
theorem res_mem_generatorSpan {V₁ V₂ : Opens X.carrier} (h : V₂ ≤ V₁)
    {z : (Scheme.liftSource yε.1.specialMap f).obj.obj (op V₁)}
    (hz : z ∈ generatorSpan f pY yε V₁) :
    ((Scheme.liftSource yε.1.specialMap f).obj.map (homOfLE h).op).hom z ∈
      generatorSpan f pY yε V₂ := by
  have h₁ := Ideal.mem_map_of_mem ((Scheme.liftSource yε.1.specialMap f).obj.map
    (homOfLE h).op).hom hz
  rw [Ideal.map_span] at h₁
  refine Ideal.span_mono ?_ h₁
  rintro _ ⟨_, ⟨m, rfl⟩, rfl⟩
  exact ⟨m, (ringPresheaf_map_map _ _ _ _ _).symm⟩

/-- The value of `pulledIdealSections pY M m` on the preimage of `W` is the restriction of
`sourceIdealBaseSection pY yε m` to `W`. -/
theorem pulledIdealSections_eval (W : Opens yε.1.scheme.carrier) (m : M) :
    (pulledIdealSections pY M m).eval
        (op ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W)) =
      (sourceIdealModule pY yε).val.map (homOfLE (le_top (a := W))).op
        (sourceIdealBaseSection pY yε m) :=
  ((pulledIdealSections pY M m).2 _).symm.trans
    (congrArg _ (pulledIdealSections_eval_top pY yε m))

variable {f pY yε} in
/-- A section `c` of the ideal of `Y` in `Y'` on `W` whose induced sections are, near every point,
in the ideal generated by the `ũ(m)`. -/
def LocGen (W : Opens yε.1.scheme.carrier) (c : (sourceIdealModule pY yε).val.obj (op W)) : Prop :=
  ∀ x ∈ (Opens.map (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base).obj W,
    ∃ (V : Opens X.carrier)
      (hV : V ≤ (Opens.map (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base).obj W), x ∈ V ∧
      ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base yε.1.scheme.sheaf hV
        ((sourceSolution pY yε).incl c) ∈ generatorSpan f pY yε V

variable {f pY yε}

/-- The zero section satisfies `LocGen`. -/
theorem locGen_zero (W : Opens yε.1.scheme.carrier) : LocGen (f := f) W 0 := by
  intro x hx
  refine ⟨_, le_rfl, hx, (congrArg (· ∈ generatorSpan f pY yε _)
    ((congrArg (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base
      yε.1.scheme.sheaf le_rfl).hom
        (DeformationSolution.incl_zero (Q := sourceSolution pY yε))).trans
          (map_zero _))).mpr (Ideal.zero_mem _)⟩

/-- `LocGen` is closed under addition. -/
theorem locGen_add {W : Opens yε.1.scheme.carrier} {c c' : (sourceIdealModule pY yε).val.obj (op W)}
    (hc : LocGen (f := f) W c) (hc' : LocGen (f := f) W c') : LocGen (f := f) W (c + c') := by
  intro x hx
  obtain ⟨V, hV, hxV, h⟩ := hc x hx
  obtain ⟨V', hV', hxV', h'⟩ := hc' x hx
  have hle : V ⊓ V' ≤ V := inf_le_left
  refine ⟨V ⊓ V', hle.trans hV, ⟨hxV, hxV'⟩, ?_⟩
  have e := (congrArg (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base
      yε.1.scheme.sheaf (hle.trans hV)).hom
    (DeformationSolution.incl_add (Q := sourceSolution pY yε) c c')).trans (map_add _ _ _)
  refine (congrArg (· ∈ generatorSpan f pY yε _) e).mpr (Ideal.add_mem _ ?_ ?_)
  · exact (congrArg (· ∈ generatorSpan f pY yε _) (ambientSection_res_apply _ _ hV hle _)).mp
      (res_mem_generatorSpan _ h)
  · exact (congrArg (· ∈ generatorSpan f pY yε _)
      (ambientSection_res_apply _ _ hV' (inf_le_right : V ⊓ V' ≤ V') _)).mp
        (res_mem_generatorSpan _ h')

/-- The value of each section `pulledIdealSections pY M m` satisfies `LocGen`. -/
theorem locGen_gen (W : Opens yε.1.scheme.carrier) (m : M) :
    LocGen (f := f) W ((pulledIdealSections pY M m).eval
      (op ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W))) := by
  intro x hx
  refine ⟨_, le_rfl, hx, ?_⟩
  have e₁ := (congrArg (sourceSolution pY yε).incl (pulledIdealSections_eval pY yε W m)).trans
    ((DeformationSolution.incl_naturality _ _).trans (congrArg _
      (incl_sourceIdealBaseSection pY yε m)))
  have e₂ := (congrArg (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base
      yε.1.scheme.sheaf (le_refl ((Opens.map (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base).obj
        W))).hom e₁).trans ((ambientSection_map_apply' _ _ _ _ _).trans
          (ambientSection_res_apply _ _ (W := ⊤) (V' := ⊤) (fun _ _ => trivial) le_top _).symm)
  refine (congrArg (· ∈ generatorSpan f pY yε _) e₂).mpr (Ideal.subset_span ⟨m, ?_⟩)
  exact congrArg _ (congrArg (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base
    yε.1.scheme.sheaf (U := ⊤) (V := ⊤) (fun _ _ => trivial)).hom (rebase_toBase_appTop pY yε m))

/-- `LocGen` is closed under multiplication by sections of `𝒪_Y`. -/
theorem locGen_smul {W : Opens yε.1.scheme.carrier}
    (b : (structureSheafRing Y.toRingedSpace).obj.obj
      (op ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W)))
    {c : (SchemeDeformationCategory.pulledIdeal ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M)
      (Over.mk pY)).val.obj (op ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W))}
    (hc : LocGen (f := f) W c) : LocGen (f := f) W (b • c) := by
  have : IsClosedImmersion yε.1.specialMap := deformationSpecialMap_isClosedImmersion yε.1
  intro x hx
  obtain ⟨V, hV, hxV, h⟩ := hc x hx
  obtain ⟨W₄, hW₄, hyW₄, b₄, hb₄⟩ :=
    exists_app_eq_of_isClosedImmersion yε.1.specialMap (O := yε.1.specialMap ⁻¹ᵁ W) b (f.base x)
      hx
  let W₅ : Opens yε.1.scheme.carrier := W₄ ⊓ W
  have h₅₄ : W₅ ≤ W₄ := inf_le_left
  have h₅ : W₅ ≤ W := inf_le_right
  let b₅ : (sourceSolution pY yε).X'.presheaf.obj (op W₅) :=
    (yε.1.scheme.presheaf.map (homOfLE h₅₄).op).hom b₄
  have hb₅ : yε.1.specialMap.app W₅ b₅ =
      ((structureSheafRing Y.toRingedSpace).obj.map
        (homOfLE ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).monotone h₅)).op).hom
          b := by
    have hn := ConcreteCategory.congr_hom (yε.1.specialMap.naturality (homOfLE h₅₄).op) b₄
    refine (CommRingCat.comp_apply _ _ _).symm.trans (hn.trans ?_)
    refine (CommRingCat.comp_apply _ _ _).trans ?_
    refine (congrArg _ hb₄).trans ?_
    exact ringPresheaf_map_map _ _ _ _ _
  let V' : Opens X.carrier :=
    V ⊓ (Opens.map (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base).obj W₅
  have hV'V : V' ≤ V := inf_le_left
  have hV'5 : V' ≤ (Opens.map (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base).obj W₅ :=
    inf_le_right
  have hxV' : x ∈ V' := ⟨hxV, hyW₄, hx⟩
  refine ⟨V', hV'V.trans hV, hxV', ?_⟩
  let c₅ : (sourceIdealModule pY yε).val.obj (op W₅) :=
    (sourceIdealModule pY yε).val.map (homOfLE h₅).op c
  have e₁ : (sourceIdealModule pY yε).val.map (homOfLE h₅).op (b • c) = b₅ • c₅ :=
    (PresheafOfModules.map_smul _ _ _ _).trans (congrArg (· • _) hb₅.symm)
  have e₂ := (DeformationSolution.incl_naturality (Q := sourceSolution pY yε) (homOfLE h₅).op
    (b • c)).symm.trans ((congrArg _ e₁).trans ((DeformationSolution.mul_incl _ _).symm.trans
      (congrArg (b₅ * ·) (DeformationSolution.incl_naturality _ _))))
  have e₃ := (ambientSection_map_apply' _ _ h₅ hV'5 _).symm.trans
    ((congrArg (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base
      yε.1.scheme.sheaf hV'5).hom e₂).trans ((map_mul _ _ _).trans
        (congrArg (_ * ·) (ambientSection_map_apply' _ _ h₅ hV'5 _))))
  refine (congrArg (· ∈ generatorSpan f pY yε V') e₃).mpr (Ideal.mul_mem_left _ _ ?_)
  exact (congrArg (· ∈ generatorSpan f pY yε _) (ambientSection_res_apply _ _ hV hV'V _)).mp
    (res_mem_generatorSpan _ h)

/-- A section in the span of the `pulledIdealSections pY M` satisfies `LocGen`. -/
theorem locGen_of_mem_sectionSpan {W : Opens yε.1.scheme.carrier}
    {c : (SchemeDeformationCategory.pulledIdeal ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M)
      (Over.mk pY)).val.obj (op ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W))}
    (hc : c ∈ sectionSpan _ (pulledIdealSections pY M)
      ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W)) :
    LocGen (f := f) W c := by
  refine _root_.Submodule.span_induction
    (p := fun (c : (SchemeDeformationCategory.pulledIdeal
      ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M) (Over.mk pY)).val.obj
        (op ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W))) _ =>
      LocGen (f := f) W c) ?_ (locGen_zero W)
    (fun _ _ _ _ h h' => locGen_add h h') (fun b _ _ h => locGen_smul b h) hc
  rintro _ ⟨m, rfl⟩
  exact locGen_gen W m

/-- **Every section of the ideal of `Y` in `Y'` induces, near every point, sections in the ideal
generated by the `ũ(m)`.** -/
theorem locGen (W : Opens yε.1.scheme.carrier) (c : (sourceIdealModule pY yε).val.obj (op W)) :
    LocGen (f := f) W c := by
  have : IsClosedImmersion yε.1.specialMap := deformationSpecialMap_isClosedImmersion yε.1
  have := epi_pulledIdealSections (Λ := Λ) pY M
  intro x hx
  obtain ⟨O, hO, hxO, hcO⟩ := exists_res_mem_sectionSpan_of_epi
    (F := SchemeDeformationCategory.pulledIdeal
      ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M) (Over.mk pY))
    (s := pulledIdealSections pY M) c (f.base x) hx
  obtain ⟨W'', hW''⟩ := exists_preimage_eq_of_isClosedImmersion yε.1.specialMap O
  let W₂ : Opens yε.1.scheme.carrier := W ⊓ W''
  have h₂ : W₂ ≤ W := inf_le_left
  have hW₂O : (Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W₂ ≤ O :=
    fun z hz => (hW'' z).1 hz.2
  have hx₂ : x ∈ (Opens.map (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base).obj W₂ :=
    ⟨hx, (hW'' (f.base x)).2 hxO⟩
  have hmem' : (sourceIdealModule pY yε).val.map (homOfLE h₂).op c ∈ sectionSpan _
      (pulledIdealSections pY M) ((Opens.map yε.1.specialMap.toLRSHom.toShHom.hom.base).obj W₂) :=
    (congrArg (· ∈ sectionSpan _ (pulledIdealSections pY M) _)
      (map_map_eq_map _ (homOfLE hO).op (homOfLE hW₂O).op _ c)).mp (res_mem_sectionSpan hW₂O hcO)
  obtain ⟨V, hV, hxV, h⟩ := locGen_of_mem_sectionSpan (f := f) hmem' x hx₂
  refine ⟨V, hV.trans ((Opens.map _).monotone h₂), hxV, ?_⟩
  have e := (congrArg (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base
      yε.1.scheme.sheaf hV).hom (DeformationSolution.incl_naturality (Q := sourceSolution pY yε)
        (homOfLE h₂).op c)).trans (ambientSection_map_apply' _ _ h₂ hV _)
  exact (congrArg (· ∈ generatorSpan f pY yε V) e).mp h

variable (f pY yε) in
/-- **(Y3) The ideal of the source thickening is locally generated by the `ũ(m)`**: every local
section of `Ker(f⁻¹𝒪_{Y'} ⟶ f⁻¹𝒪_Y)` lies, on the members of a cover, in the ideal generated by
the restrictions of the `ũ(m)`. -/
theorem sourceIdealGenerator_span (V : Opens X.carrier)
    (z : (Scheme.liftSource yε.1.specialMap f).obj.obj (op V))
    (hz : z ∈ kernelIdeal (Scheme.liftSourceReduction yε.1.specialMap f).hom (op V)) :
    ∃ (J : Type u) (W : J → Opens X.carrier) (hW : ∀ j, W j ≤ V), V ≤ iSup W ∧
      ∀ j, ((Scheme.liftSource yε.1.specialMap f).obj.map (homOfLE (hW j)).op).hom z ∈
        Ideal.span (Set.range fun m => ((Scheme.liftSource yε.1.specialMap f).obj.map
          (homOfLE (le_top (a := W j))).op).hom (sourceIdealGenerator f pY yε m)) := by
  have key : ∀ x : V, ∃ (W : Opens X.carrier) (hW : W ≤ V), x.1 ∈ W ∧
      ((Scheme.liftSource yε.1.specialMap f).obj.map (homOfLE hW).op).hom z ∈
        generatorSpan f pY yε W := by
    rintro ⟨x, hx⟩
    obtain ⟨V₁, hV₁, hxV₁, _, W₁, hW₁, q, hzq, -⟩ :=
      sourceIdealRel_exists (θ := sourceIdealTheta f pY M) ⟨z, hz⟩ x hx
    obtain ⟨V₂, hV₂, hxV₂, h⟩ := locGen (f := f) W₁ q x (hW₁ hxV₁)
    have hle : V₁ ⊓ V₂ ≤ V₁ := inf_le_left
    refine ⟨V₁ ⊓ V₂, hle.trans hV₁, ⟨hxV₁, hxV₂⟩, ?_⟩
    have e : ((Scheme.liftSource yε.1.specialMap f).obj.map (homOfLE (hle.trans hV₁)).op).hom z =
        ((Scheme.liftSource yε.1.specialMap f).obj.map
            (homOfLE (inf_le_right : V₁ ⊓ V₂ ≤ V₂)).op).hom
          (ambientSection (f ≫ yε.1.specialMap).toLRSHom.toShHom.hom.base yε.1.scheme.sheaf hV₂
            ((sourceSolution pY yε).incl q)) := by
      refine (ringPresheaf_map_map _ (homOfLE hV₁).op (homOfLE hle).op _ z).symm.trans ?_
      refine (congrArg _ hzq).trans ((ambientSection_res_apply _ _ hW₁ hle _).trans ?_)
      exact (ambientSection_res_apply _ _ hV₂ inf_le_right _).symm
    exact (congrArg (· ∈ generatorSpan f pY yε _) e).mpr (res_mem_generatorSpan _ h)
  choose W hW hxW hmem using key
  exact ⟨V, W, hW, fun x hx => Opens.mem_iSup.2 ⟨⟨x, hx⟩, hxW ⟨x, hx⟩⟩, hmem⟩

