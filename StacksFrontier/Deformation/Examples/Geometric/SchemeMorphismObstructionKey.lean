/-!
# The obstruction of Stacks 0E3V vanishes exactly when the morphism lifts

This file compares the two classes `Push(Y')` and `Pull(X')` of
[Stacks Project, Tag 0E3V] with the existence of a morphism `X' ⟶ Y'` over `Spec k[M]` restricting
to `f`. The first step is an elementary criterion for morphisms into `Spec k[M]`: two of them agree
as soon as they agree over `Spec k` and on the global functions `(0, m)`, `m ∈ M`.

## Main results

* `Deformation.Examples.squareZeroSpec_hom_ext`: morphisms into `Spec k[M]` agreeing over `Spec k`
  and on the functions `(0, m)` are equal.
* `Deformation.Examples.globalLiftsOverBaseEquivField`: the global lifts of `f` over `Spec k[M]`
  are the lifts over `Spec k` agreeing on the functions `(0, m)`.

## References

* [Stacks Project, Tag 0E3V](https://stacks.math.columbia.edu/tag/0E3V)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.RingedSpaceThickening.FibreExtensionData

open Stacks.Sites.Conormal (kernelIdeal)
open TopologicalSpace

variable {Z T : RingedSpace.{u, u}} {g : Z ⟶ T}
  {G : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf
    (J := Opens.grothendieckTopology Z.carrier) Z.sheaf)}
  {B : Sheaf (Opens.grothendieckTopology Z.carrier) CommRingCat.{u}} {q : Z.sheaf ⟶ B}
  (D : FibreExtensionData g G q) (P : AlgebraSquareZeroExtension g G)
  (φ : P.sheaf ⟶ D.B') (hφ : φ ≫ D.p = P.reduction ≫ q)

include hφ in
/-- On the ideal generated by sections on which it holds, the compatibility of `φ` with the two
identifications of the ideals holds. -/
theorem ideal_compat_of_mem_span {V : Opens Z.carrier} {S : Set ↥(P.sheaf.obj.obj (Opposite.op V))}
    (hS : ∀ z ∈ S, ∃ hz : z ∈ kernelIdeal P.reduction.hom (Opposite.op V),
      φ.hom.app (Opposite.op V) z = D.ι.app (Opposite.op V) (P.ideal.app (Opposite.op V) ⟨z, hz⟩))
    {z : ↥(P.sheaf.obj.obj (Opposite.op V))} (hz₀ : z ∈ Ideal.span S)
    (hz : z ∈ kernelIdeal P.reduction.hom (Opposite.op V)) :
    φ.hom.app (Opposite.op V) z =
      D.ι.app (Opposite.op V) (P.ideal.app (Opposite.op V) ⟨z, hz⟩) := by
  have hk : ∀ x ∈ Ideal.span S, x ∈ kernelIdeal P.reduction.hom (Opposite.op V) := fun x hx =>
    Ideal.span_le.2 (fun z hz => (hS z hz).1) hx
  induction hz₀ using Submodule.span_induction with
  | mem x hx => exact (hS x hx).2
  | zero =>
    rw [map_zero]
    exact ((congrArg (D.ι.app (Opposite.op V)) (map_zero _)).trans (map_zero _)).symm
  | add x y hx hy ihx ihy =>
    have hxk := hk x hx
    have hyk := hk y hy
    rw [map_add, ihx hxk, ihy hyk]
    refine ((map_add (D.ι.app (Opposite.op V)) _ _).symm.trans ?_)
    exact congrArg (D.ι.app (Opposite.op V))
      ((map_add (P.ideal.app (Opposite.op V)) ⟨x, hxk⟩ ⟨y, hyk⟩).symm)
  | smul a x hx ihx =>
    have hxk := hk x hx
    have hb : D.p.hom.app (Opposite.op V) (φ.hom.app (Opposite.op V) a) =
        q.hom.app (Opposite.op V) (P.reduction.hom.app (Opposite.op V) a) :=
      congrArg (fun t => (t.hom.app (Opposite.op V)).hom a) hφ
    have hsm := P.ideal.app_smul (Opposite.op V) a ⟨x, hxk⟩
    change (φ.hom.app (Opposite.op V)).hom (a * x) = _
    rw [map_mul, ihx hxk, D.smul_inr (Opposite.op V) _ _ _ hb]
    exact congrArg (D.ι.app (Opposite.op V)) hsm.symm

include hφ in
/-- **The compatibility on ideals is checked on local generators.** If the ideal of `P` is
locally generated by global sections `u m` on which `φ` is compatible with the two
identifications of the ideals, then `φ` is compatible on the whole ideal. -/
theorem ideal_compat_of_generators {I : Type*} (u : I → ↥(P.sheaf.obj.obj (Opposite.op ⊤)))
    (hu : ∀ m, u m ∈ kernelIdeal P.reduction.hom (Opposite.op ⊤))
    (hgen : ∀ (V : Opens Z.carrier) (z : ↥(P.sheaf.obj.obj (Opposite.op V))),
      z ∈ kernelIdeal P.reduction.hom (Opposite.op V) →
      ∃ (J : Type u) (W : J → Opens Z.carrier) (hW : ∀ j, W j ≤ V), V ≤ iSup W ∧
        ∀ j, (P.sheaf.obj.map (homOfLE (hW j)).op).hom z ∈
          Ideal.span (Set.range fun m => (P.sheaf.obj.map (homOfLE (le_top (a := W j))).op).hom
            (u m)))
    (h : ∀ m, φ.hom.app (Opposite.op ⊤) (u m) =
      D.ι.app (Opposite.op ⊤) (P.ideal.app (Opposite.op ⊤) ⟨u m, hu m⟩))
    (V : (Opens Z.carrier)ᵒᵖ) (z : ↥(kernelIdeal P.reduction.hom V)) :
    φ.hom.app V z = D.ι.app V (P.ideal.app V z) := by
  obtain ⟨V⟩ := V
  obtain ⟨J, W, hW, hcov, hz⟩ := hgen V z.1 z.2
  have hres1 : ∀ {V₁ V₂ : Opens Z.carrier} (e : V₂ ≤ V₁) (y : ↥(P.sheaf.obj.obj (Opposite.op V₁))),
      (D.B'.obj.map (homOfLE e).op).hom (φ.hom.app (Opposite.op V₁) y) =
        φ.hom.app (Opposite.op V₂) ((P.sheaf.obj.map (homOfLE e).op).hom y) := fun e y =>
    (congrArg (fun t => t.hom y) (φ.hom.naturality (homOfLE e).op)).symm
  have hres2 : ∀ {V₁ V₂ : Opens Z.carrier} (e : V₂ ≤ V₁)
      (y : ↥(kernelIdeal P.reduction.hom (Opposite.op V₁))),
      (D.B'.obj.map (homOfLE e).op).hom
          (D.ι.app (Opposite.op V₁) (P.ideal.app (Opposite.op V₁) y)) =
        D.ι.app (Opposite.op V₂) (P.ideal.app (Opposite.op V₂)
          ⟨(P.sheaf.obj.map (homOfLE e).op).hom y.1,
            Stacks.Sites.Conormal.map_kernel P.reduction.hom (homOfLE e).op y.2⟩) := fun e y =>
    (D.ι.app_map (homOfLE e).op (P.ideal.app _ y)).symm.trans
      (congrArg (D.ι.app _) (P.ideal.app_map (homOfLE e).op y).symm)
  refine TopCat.Sheaf.eq_of_locally_eq' D.B' W V (fun j => homOfLE (hW j)) hcov _ _ fun j => ?_
  refine (hres1 (hW j) z.1).trans (Eq.trans ?_ (hres2 (hW j) z).symm)
  refine D.ideal_compat_of_mem_span P φ hφ ?_ (hz j) _
  rintro _ ⟨m, rfl⟩
  refine ⟨Stacks.Sites.Conormal.map_kernel P.reduction.hom (homOfLE le_top).op (hu m), ?_⟩
  refine (hres1 le_top (u m)).symm.trans ?_
  rw [h m]
  exact hres2 le_top ⟨u m, hu m⟩

include hφ in
/-- `ideal_compat_of_generators` as an equivalence: under local generation of the ideal of `P` by
the global sections `u m`, the compatibility of `φ` on ideals is its compatibility on the
`u m`. -/
theorem ideal_compat_iff_generators {I : Type*} (u : I → ↥(P.sheaf.obj.obj (Opposite.op ⊤)))
    (hu : ∀ m, u m ∈ kernelIdeal P.reduction.hom (Opposite.op ⊤))
    (hgen : ∀ (V : Opens Z.carrier) (z : ↥(P.sheaf.obj.obj (Opposite.op V))),
      z ∈ kernelIdeal P.reduction.hom (Opposite.op V) →
      ∃ (J : Type u) (W : J → Opens Z.carrier) (hW : ∀ j, W j ≤ V), V ≤ iSup W ∧
        ∀ j, (P.sheaf.obj.map (homOfLE (hW j)).op).hom z ∈
          Ideal.span (Set.range fun m => (P.sheaf.obj.map (homOfLE (le_top (a := W j))).op).hom
            (u m))) :
    (∀ (V : (Opens Z.carrier)ᵒᵖ) (z : ↥(kernelIdeal P.reduction.hom V)),
        φ.hom.app V z = D.ι.app V (P.ideal.app V z)) ↔
      ∀ m, φ.hom.app (Opposite.op ⊤) (u m) =
        D.ι.app (Opposite.op ⊤) (P.ideal.app (Opposite.op ⊤) ⟨u m, hu m⟩) :=
  ⟨fun h m => h _ ⟨u m, hu m⟩, fun h => D.ideal_compat_of_generators P φ hφ u hu hgen h⟩

end AlgebraicGeometry.RingedSpaceThickening.FibreExtensionData

namespace AlgebraicGeometry.RingedSpace

open TopologicalSpace

/-- **The map `β⁻¹𝒪_W ⟶ 𝒪_Z` of a morphism of ringed spaces over `β`, on the image of a section
of `𝒪_W`.** It is the comorphism of the morphism, read through the equality of the preimages. -/
theorem homOverEquiv_unit_app {Z W : RingedSpace.{u, u}} (β : Z.carrier ⟶ W.carrier)
    (χ : Z ⟶ W) (h : χ.hom.base = β) (U : Opens W.carrier) (t : W.presheaf.obj (Opposite.op U)) :
    ((homOverEquiv β ⟨χ, h⟩).hom.app (Opposite.op ((Opens.map β).obj U))).hom
        ((((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} β).unit.app
          W.sheaf).hom.app (Opposite.op U)).hom t) =
      (Z.presheaf.map (eqToHom (by rw [h]; rfl))).hom ((χ.hom.c.app (Opposite.op U)).hom t) := by
  subst h
  have hu := congrArg (fun m => (m.hom.app (Opposite.op U)).hom t)
    (Stacks.SheafOfModules.unit_comp_map_ringedSpaceStructureMap χ)
  simp only [homOverEquiv, eqToHom_refl,
    Z.presheaf.map_id, CommRingCat.id_apply]
  exact hu

end AlgebraicGeometry.RingedSpace

namespace Deformation.Examples

variable {Λ k : Type u} [CommRing Λ] [Field k] [Algebra Λ k]

/-- The element `(0, m)` of `k[M] = k ⊕ M`. -/
def squareZeroInr (M : FGModuleCat.{u} k) (m : M) :
    ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M : Type u) :=
  show TrivSqZeroExt k M from TrivSqZeroExt.inr m

/-- Every element of `k[M]` is `(c, 0) + (0, m)`. -/
theorem squareZero_eq_add (M : FGModuleCat.{u} k)
    (x : ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M : Type u)) :
    ∃ (c : k) (m : M), x = squareZeroStructureRingHom (Λ := Λ) M c + squareZeroInr (Λ := Λ) M m :=
  ⟨TrivSqZeroExt.fst (R := k) (M := M) x, TrivSqZeroExt.snd (R := k) (M := M) x,
    (TrivSqZeroExt.inl_fst_add_inr_snd_eq (R := k) (M := M) x).symm⟩

/-- The global function `(0, m)` on `Spec k[M]`. -/
def squareZeroSpecFunction (M : FGModuleCat.{u} k) (m : M) :
    Γ(baseSpec ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M), ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))).inv.hom
    (squareZeroInr (Λ := Λ) M m)

/-- **Morphisms into `Spec k[M]` are determined over `Spec k` and on the functions `(0, m)`.**
A ring map out of `k[M] = k ⊕ M` is determined by its restriction to `k` and its values on
`M`. -/
theorem squareZeroSpec_hom_ext {W : Scheme.{u}} {M : FGModuleCat.{u} k}
    {a b : W ⟶ baseSpec ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M)}
    (h : a ≫ squareZeroStructureSpecMap M = b ≫ squareZeroStructureSpecMap M)
    (hm : ∀ m : M, a.appTop (squareZeroSpecFunction (Λ := Λ) M m) =
      b.appTop (squareZeroSpecFunction (Λ := Λ) M m)) :
    a = b := by
  apply ext_of_isAffine
  rw [← cancel_epi (Scheme.ΓSpecIso
    (CommRingCat.of ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))).inv]
  ext x
  obtain ⟨c, m, rfl⟩ := squareZero_eq_add (Λ := Λ) M x
  rw [map_add, map_add]
  congr 1
  · have hc : CommRingCat.ofHom (squareZeroStructureRingHom (Λ := Λ) M) ≫
        (Scheme.ΓSpecIso
          (CommRingCat.of ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))).inv ≫ a.appTop =
        CommRingCat.ofHom (squareZeroStructureRingHom (Λ := Λ) M) ≫
        (Scheme.ΓSpecIso
          (CommRingCat.of ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))).inv ≫ b.appTop := by
      rw [Scheme.ΓSpecIso_inv_naturality_assoc, Scheme.ΓSpecIso_inv_naturality_assoc,
        ← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop]
      exact congrArg (fun g : W ⟶ baseSpec (residueFieldBase Λ k) =>
        (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ g.appTop) h
    exact congrArg (fun g => g.hom c) hc
  · exact hm m

/-- Naturality of a morphism of presheaves of rings, on elements. -/
theorem nat_apply {C : Type*} [Category C] {F G : C ⥤ CommRingCat.{u}} (β : F ⟶ G) {U V : C}
    (g : U ⟶ V) (x : F.obj U) : (β.app V).hom ((F.map g).hom x) = (G.map g).hom ((β.app U).hom x) :=
  congrArg (fun m => m.hom x) (β.naturality g)

/-- A restriction map of a presheaf on opens from an open to itself is the identity. -/
theorem presheaf_map_apply_self {T : TopCat.{u}}
    (F : (TopologicalSpace.Opens T)ᵒᵖ ⥤ CommRingCat.{u})
    {U : (TopologicalSpace.Opens T)ᵒᵖ} (h : U ⟶ U) (x : F.obj U) : (F.map h).hom x = x := by
  rw [Subsingleton.elim h (𝟙 _), F.map_id]
  rfl

/-- Two restriction maps of a presheaf on opens returning to the same open compose to the
identity. -/
theorem presheaf_map_map_apply_self {T : TopCat.{u}}
    (F : (TopologicalSpace.Opens T)ᵒᵖ ⥤ CommRingCat.{u}) {U V : (TopologicalSpace.Opens T)ᵒᵖ}
    (a : U ⟶ V) (b : V ⟶ U) (x : F.obj U) : (F.map b).hom ((F.map a).hom x) = x := by
  rw [← CommRingCat.comp_apply, ← F.map_comp]
  exact presheaf_map_apply_self F _ x

variable {X Y : Scheme.{u}} (f : X ⟶ Y)
  {pX : X ⟶ baseSpec (residueFieldBase Λ k)} {pY : Y ⟶ baseSpec (residueFieldBase Λ k)}
  {M : FGModuleCat.{u} k}
  (xε : (schemeDeformationCategoryProjection (Λ := Λ) (k := k) (Over.mk pX)).Fiber
    ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))
  (yε : (schemeDeformationCategoryProjection (Λ := Λ) (k := k) (Over.mk pY)).Fiber
    ((squareZeroExtensionArtinian.{u, u, u} Λ k).obj M))

/-- A morphism of total spaces lies over `Spec` of the base of the target deformation, read
through the identification of the base of the source with it, exactly when it lies over
`Spec k[M]` for the rebased structure morphisms. -/
theorem comp_toBase_eq_iff_rebase (b : xε.1.scheme ⟶ yε.1.scheme) :
    b ≫ yε.1.toBase = deformationAmbientToBase xε.1 (eqToHom (yε.2.trans xε.2.symm)) ↔
      b ≫ (yε.1.rebase yε.2).toBase = (xε.1.rebase xε.2).toBase := by
  rw [SchemeDeformationCategory.rebase_toBase, SchemeDeformationCategory.rebase_toBase,
    deformationAmbientToBase, baseSpecMap_eqToHom]
  exact ⟨fun h => (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ eqToHom (congrArg baseSpec yε.2)) h).trans (by simp)),
    fun h => by simpa using congrArg (· ≫ eqToHom (congrArg baseSpec yε.2.symm)) h⟩

/-- **The global lifts of `f` over `Spec k[M]` are the lifts over `Spec k` agreeing on the
functions `(0, m)`.** A morphism `b : X' ⟶ Y'` restricting to `f` lies over `Spec k[M]` exactly
when it lies over `Spec k` and pulls the function `(0, m)` of `Y'` back to that of `X'`, for every
`m ∈ M`. -/
def globalLiftsOverBaseEquivField :
    globalLiftsOverBase f xε.1 yε.1 (eqToHom (yε.2.trans xε.2.symm)) ≃
      { b : xε.1.scheme ⟶ yε.1.scheme //
        (b ≫ schemeMorphismPushStructure pY yε = schemeMorphismPushStructure pX xε ∧
          xε.1.specialMap ≫ b = f ≫ yε.1.specialMap) ∧
        ∀ m : M, b.appTop ((yε.1.rebase yε.2).toBase.appTop (squareZeroSpecFunction (Λ := Λ) M m)) =
          (xε.1.rebase xε.2).toBase.appTop (squareZeroSpecFunction (Λ := Λ) M m) } :=
  Equiv.subtypeEquivRight fun b => by
    rw [comp_toBase_eq_iff_rebase]
    exact ⟨fun ⟨h, hs⟩ => ⟨⟨(Category.assoc _ _ _).symm.trans
        (congrArg (· ≫ squareZeroStructureSpecMap M) h), hs⟩,
          fun m => congrArg (fun g => g.appTop (squareZeroSpecFunction (Λ := Λ) M m)) h⟩,
      fun ⟨⟨h, hs⟩, hm⟩ => ⟨squareZeroSpec_hom_ext ((Category.assoc _ _ _).trans h) hm, hs⟩⟩

variable {f} in
/-- The special fibres and `f` form a commutative square over `Spec k`. -/
theorem specialMap_comp_pushStructure_eq (hf : f ≫ pY = pX) :
    xε.1.specialMap ≫ schemeMorphismPushStructure pX xε =
      f ≫ yε.1.specialMap ≫ schemeMorphismPushStructure pY yε := by
  rw [specialMap_comp_schemeMorphismPushStructure, specialMap_comp_schemeMorphismPushStructure, hf]

variable {f} in
/-- The `k`-algebra structure of `f⁻¹𝒪_{Y'}` is the one of `Scheme.liftSourceBaseMap`. -/
theorem schemeMorphismPushBase_eq (hf : f ≫ pY = pX) :
    schemeMorphismPushBase f pY yε =
      eqToHom (congrArg (fun t : X ⟶ baseSpec (residueFieldBase Λ k) =>
        (TopCat.Sheaf.pullback CommRingCat.{u} t.toLRSHom.toShHom.hom.base).obj
          (baseSpec (residueFieldBase Λ k)).toRingedSpace.sheaf)
        ((specialMap_comp_schemeMorphismPushStructure pX xε).trans hf.symm).symm) ≫
      Scheme.liftSourceBaseMap xε.1.specialMap yε.1.specialMap (schemeMorphismPushStructure pX xε)
        (schemeMorphismPushStructure pY yε) f (specialMap_comp_pushStructure_eq xε yε hf) := by
  rw [schemeMorphismPushBase, Scheme.liftSourceBaseMap, eqToHom_trans_assoc]
  rfl

variable {f} in
/-- **The lifts of `f` over `Spec k` are the compatible maps of sheaves of rings into the
thickened structure sheaf of the source.** `Scheme.liftsEquivSheafHom` at `T = Spec k`,
transported along `thickenedSheafIsoInverseImage`. -/
def schemeMorphismSheafLiftEquiv (hf : f ≫ pY = pX) :
    { b : xε.1.scheme ⟶ yε.1.scheme //
        b ≫ schemeMorphismPushStructure pY yε = schemeMorphismPushStructure pX xε ∧
          xε.1.specialMap ≫ b = f ≫ yε.1.specialMap } ≃
      { φ : Scheme.liftSource yε.1.specialMap f ⟶
          (fiberSolution (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
            xε).thickenedSheaf //
        φ ≫ (fiberSolution (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
              xε).thickenedSheafReduction =
            Scheme.liftSourceReduction yε.1.specialMap f ≫
              Stacks.SheafOfModules.ringedSpaceStructureMap f.toLRSHom.toShHom ∧
          schemeMorphismPushBase f pY yε ≫ φ =
            eqToHom (congrArg (fun t : X ⟶ baseSpec (residueFieldBase Λ k) =>
              (TopCat.Sheaf.pullback CommRingCat.{u} t.toLRSHom.toShHom.hom.base).obj
                (baseSpec (residueFieldBase Λ k)).toRingedSpace.sheaf)
              ((specialMap_comp_schemeMorphismPushStructure pX xε).trans hf.symm).symm) ≫
              Scheme.liftTargetBaseMap xε.1.specialMap (schemeMorphismPushStructure pX xε) ≫
                (fiberSolution (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
                  xε).thickenedSheafIsoInverseImage.inv } :=
  (Scheme.liftsEquivSheafHom xε.1.specialMap yε.1.specialMap (schemeMorphismPushStructure pX xε)
      (schemeMorphismPushStructure pY yε) f (deformationSpecialMap_isHomeomorph xε.1)
      (specialMap_comp_pushStructure_eq xε yε hf)).trans
    { toFun := fun φ =>
        ⟨φ.1 ≫ (fiberSolution (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
            xε).thickenedSheafIsoInverseImage.inv,
          (congrArg ((φ.1 ≫ (fiberSolution
              (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
              xε).thickenedSheafIsoInverseImage.inv) ≫ ·)
            (RingedSpaceThickening.DeformationSolution.thickenedSheafIsoInverseImage_hom_comp
              _).symm).trans
            ((Category.assoc _ _ _).trans ((congrArg (φ.1 ≫ ·)
              ((fiberSolution (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
                xε).thickenedSheafIsoInverseImage.inv_hom_id_assoc _)).trans
                (φ.2.1.trans (Scheme.liftSourceReduction_comp _ _).symm))),
          (congrArg (· ≫ (φ.1 ≫ (fiberSolution
              (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
              xε).thickenedSheafIsoInverseImage.inv))
              (schemeMorphismPushBase_eq xε yε hf)).trans
            ((Category.assoc _ _ _).trans (congrArg (eqToHom _ ≫ ·)
              ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ (fiberSolution
                (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
                xε).thickenedSheafIsoInverseImage.inv) φ.2.2))))⟩
      invFun := fun φ =>
        ⟨φ.1 ≫ (fiberSolution (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
            xε).thickenedSheafIsoInverseImage.hom,
          (Category.assoc _ _ _).trans ((congrArg (φ.1 ≫ ·)
            (RingedSpaceThickening.DeformationSolution.thickenedSheafIsoInverseImage_hom_comp
              _)).trans (φ.2.1.trans (Scheme.liftSourceReduction_comp _ _))), by
          have h1 := (Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ φ.1) (schemeMorphismPushBase_eq xε yε hf).symm).trans φ.2.2)
          have h2 := (cancel_epi _).1 h1
          exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (fiberSolution
              (maximalIdeal_squareZeroExtensionArtinian_pow_two (Λ := Λ) M)
