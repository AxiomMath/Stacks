@[expose] public section

namespace Deformation.Examples.MaurerCartanWindow

/-- **A square-zero element solving the window is zero.** Let `s` be an element of a commutative
ring with `s² = 0` and suppose the Maurer–Cartan system of the window `m = 1` has a solution at
`s`: elements `a`, `b` with `s·a + a·s = s` and `s·b + b·s + a² = a`. Then `s = 0`.

The first equation says `s·(2a − 1) = 0`, so `s·(2a − 1)² = 0`; the second says
`(2a − 1)² = 1 − 8·s·b`, so `s·(2a − 1)² = s − 8·s²·b = s`. The displayed linear combination is
those two computations subtracted. -/
theorem eq_zero_of_hasWindowSolution {R : Type*} [CommRing R] {s : R} (hs : s * s = 0)
    (h : HasWindowSolution s) : s = 0 := by
  obtain ⟨a, b, h1, h2⟩ := h
  linear_combination (2 * a - 1) * h1 - 4 * s * h2 + 8 * b * hs

/-- **The window has no solution at a nonzero square-zero element.** So the window `m = 1` of the
nilpotent dévissage of Stacks 0DZ2 is not solvable unconditionally: the smallest witness is the
rank-one module over `k[s]/(s²)` with `x` acting by `s`, whose `im x = (s)` is not projective. -/
theorem not_hasWindowSolution_of_sq_eq_zero {R : Type*} [CommRing R] {s : R} (hs : s * s = 0)
    (hne : s ≠ 0) : ¬ HasWindowSolution s :=
  fun h => hne (eq_zero_of_hasWindowSolution hs h)

/-- `3` squares to zero in `ZMod 9` and is not zero. -/
theorem three_sq_zmod_nine : (3 : ZMod 9) * 3 = 0 := by decide

/-- **The first equation of the window is solvable at `x = 3` over `ZMod 9`**, by `a = 2`. So the
witness below fails the window at its *second* equation — the one carrying the quadratic term —
and not at the first, which is the square-zero step the proved form of Stacks 0DZ2 handles. -/
theorem first_window_equation_zmod_nine : (3 : ZMod 9) * 2 + 2 * 3 = 3 := by decide

/-- **The window has no solution at `x = 3` over `ZMod 9`.** -/
theorem not_hasWindowSolution_zmod_nine : ¬ HasWindowSolution (3 : ZMod 9) :=
  not_hasWindowSolution_of_sq_eq_zero three_sq_zmod_nine (by decide)

/-! ### The solution set of the window is symmetric under `a ↦ 1 − a` -/

/-- **The window's solution set is symmetric under `a ↦ 1 − a`, with the same `b`.** If `(a, b)`
solves the Maurer–Cartan system of the window `m = 1` at `x`, so does `(1 − a, b)`: the first
equation is additive in `a` with `x·1 + 1·x = 2x`, and `(1 − a)² − (1 − a) = a² − a`, so the
second equation is unchanged.

This is why the mechanism of the abstract refutation of the local-to-global principle for a
quadratic correction equation does not transport to the window. There the two local solutions sit
on the two disjoint branches `s = 0` and `s = 1` of an idempotent and cannot be interpolated;
here the two branches are exchanged by `a ↦ 1 − a`, so solvability over a ring never pins the
branch, and a counterexample to the nilpotent form of Stacks 0DZ2 of this shape cannot be built
by forcing the local data onto incompatible branches. -/
theorem window_sol_one_sub {S : Type*} [Ring S] {x a b : S}
    (h1 : x * a + a * x = x) (h2 : x * b + b * x + a * a = a) :
    x * (1 - a) + (1 - a) * x = x ∧ x * b + b * x + (1 - a) * (1 - a) = 1 - a := by
  refine ⟨?_, ?_⟩
  · have hexp : x * (1 - a) + (1 - a) * x = 2 * x - (x * a + a * x) := by noncomm_ring
    rw [hexp, h1]
    noncomm_ring
  · have hexp : x * b + b * x + (1 - a) * (1 - a)
        = (x * b + b * x + a * a) - 2 * a + 1 := by noncomm_ring
    rw [hexp, h2]
    noncomm_ring

end Deformation.Examples.MaurerCartanWindow

end
