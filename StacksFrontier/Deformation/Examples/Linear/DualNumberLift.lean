module

public import Mathlib.Algebra.DualNumber
public import Mathlib.LinearAlgebra.TensorProduct.Basis
public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.RingTheory.DualNumber
public import Mathlib.RingTheory.LocalRing.Module

/-!
# Finite projective lifts of a vector space to the dual numbers

A finite-dimensional vector space over a field `k` has, up to isomorphism over that vector
space, exactly one finite projective lift to the dual numbers `k[ε]`. Existence is the free
module on a basis; uniqueness is the projective lifting property together with the fact that an
endomorphism of a lift inducing the identity on the special fibre differs from the identity by a
square-zero map, hence is invertible.

## Main definitions

* `Deformation.Examples.DualNumberLift`: a finite projective module over `k[ε]` together with a
  specified identification of its special fibre with `V`.

## Main results

* `Deformation.Examples.nonempty_dualNumberLift`: every finite-dimensional `k`-vector space
  admits such a lift.
* `Deformation.Examples.DualNumberLift.exists_linearEquiv`: any two lifts of `V` are isomorphic
  compatibly with their reduction maps.

## Implementation notes

The reduction map is semilinear for the canonical projection `k[ε] → k`, and the lifting
condition is recorded by requiring the induced map after extension of scalars to be a linear
equivalence with the prescribed value on `1 ⊗ m`. Isomorphisms of lifts are required to commute
with the reduction maps; such an isomorphism need not be unique, which is why the statement is
an existence statement rather than a canonical identification.

## References

* [Stacks Project, Tag 0D3I](https://stacks.math.columbia.edu/tag/0D3I)
-/

@[expose] public section

namespace Deformation.Examples

universe u v v' w

variable {k : Type u} [Field k]

/-- A finite projective module over the dual numbers `k[ε]` together with a specified
semilinear map to `V` exhibiting `V` as its special fibre. -/
public structure DualNumberLift (V : Type w) [AddCommGroup V] [Module k V] where
  /-- The underlying type of the lift. -/
  carrier : Type v
  [addCommGroup : AddCommGroup carrier]
  [module : Module (DualNumber k) carrier]
  [finite : Module.Finite (DualNumber k) carrier]
  [projective : Module.Projective (DualNumber k) carrier]
  /-- The reduction map to `V`, semilinear for the projection `k[ε] → k`. -/
  reduction : carrier →ₛₗ[(TrivSqZeroExt.fstHom k k k).toRingHom] V
  /-- The reduction map identifies `V` with the special fibre of the lift. -/
  baseChange :
    letI : Algebra (DualNumber k) k := TrivSqZeroExt.algebraBase k k
    ∃ e : (TensorProduct (DualNumber k) k carrier) ≃ₗ[k] V,
      ∀ m : carrier,
        e (TensorProduct.tmul (DualNumber k) (1 : k) m) = reduction m

namespace DualNumberLift

attribute [instance] addCommGroup module finite projective

/-- The projection `k[ε] → k` killing the infinitesimal coordinate. -/
public abbrev dualProjection (k : Type u) [Field k] : DualNumber k →ₐ[k] k :=
  TrivSqZeroExt.fstHom k k k

/-- The kernel of the dual-number projection: the ideal of elements with vanishing constant
coefficient. -/
public abbrev dualKernel (k : Type u) [Field k] : Ideal (DualNumber k) :=
  RingHom.ker (dualProjection k).toRingHom

/-- The kernel of the dual-number projection is the principal ideal generated by `ε`. -/
public lemma dualKernel_eq_span (k : Type u) [Field k] :
    dualKernel k = Ideal.span {DualNumber.eps} := by
  ext x
  simp [dualKernel, dualProjection, DualNumber.fst_eq_zero_iff_eps_dvd,
    Ideal.mem_span_singleton]

private lemma dualKernel_sq (k : Type u) [Field k] :
    dualKernel k ^ 2 = ⊥ := by
  rw [pow_two, dualKernel_eq_span, Ideal.span_singleton_mul_span_singleton,
    DualNumber.eps_mul_eps]
  simp

/-- The dual-number projection is surjective. -/
private lemma dualProjection_surjective (k : Type u) [Field k] :
    Function.Surjective (dualProjection k).toRingHom := fun x =>
  ⟨algebraMap k (DualNumber k) x, by simp [dualProjection]⟩

private noncomputable def dualKernelQuotientEquiv (k : Type u) [Field k] :
    let _ := TrivSqZeroExt.algebraBase k k
    (DualNumber k ⧸ dualKernel k) ≃ₐ[DualNumber k] k :=
  letI : Algebra (DualNumber k) k := TrivSqZeroExt.algebraBase k k
  AlgEquiv.ofRingEquiv
    (f := RingHom.quotientKerEquivOfSurjective (dualProjection_surjective k))
    fun x => RingHom.quotientKerEquivOfSurjective_apply_mk (dualProjection_surjective k) x

/-- An element of a lift killed by the reduction map lies in the kernel ideal of the dual-number
projection times the lift. -/
public lemma reduction_kernel_mem {V : Type w} [AddCommGroup V] [Module k V]
    (X : DualNumberLift.{u, v, w} (k := k) V) (m : X.carrier)
    (hm : X.reduction m = 0) :
    m ∈ dualKernel k • (⊤ : Submodule (DualNumber k) X.carrier) := by
  let : Algebra (DualNumber k) k := TrivSqZeroExt.algebraBase k k
  let : AddCommGroup X.carrier := X.addCommGroup
  let : Module (DualNumber k) X.carrier := X.module
  obtain ⟨e, he⟩ := X.baseChange
  have hmk : (TensorProduct.mk (DualNumber k) k X.carrier 1) m = 0 :=
    e.injective (by simpa [he m] using hm)
  let q := dualKernelQuotientEquiv k
  let t := TensorProduct.congr (R := DualNumber k) (R₂ := DualNumber k)
    (σ₁₂ := RingHom.id (DualNumber k)) q.toLinearEquiv
    (LinearEquiv.refl (DualNumber k) X.carrier)
  have hqmk : (TensorProduct.mk (DualNumber k) (DualNumber k ⧸ dualKernel k)
      X.carrier 1) m = 0 :=
    t.injective (by simpa [t, q, dualKernelQuotientEquiv] using hmk)
  refine (Submodule.Quotient.mk_eq_zero (dualKernel k • ⊤)).mp ?_
  simpa [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul] using
    congrArg (TensorProduct.quotTensorEquivQuotSMul (R := DualNumber k) X.carrier (dualKernel k))
      hqmk

/-- The reduction map of a lift is surjective. -/
public lemma reduction_surjective {V : Type w} [AddCommGroup V] [Module k V]
    (X : DualNumberLift.{u, v, w} (k := k) V) :
    Function.Surjective X.reduction := by
  let : Algebra (DualNumber k) k := TrivSqZeroExt.algebraBase k k
  obtain ⟨e, he⟩ := X.baseChange
  intro v
  obtain ⟨m, hm⟩ := TensorProduct.mk_surjective (DualNumber k) X.carrier k
    (dualProjection_surjective k) (e.symm v)
  exact ⟨m, (he m).symm.trans ((congrArg e hm).trans (e.apply_symm_apply v))⟩

private lemma endomorphism_bijective_of_reduction_eq {V : Type w} [AddCommGroup V]
    [Module k V] (X : DualNumberLift.{u, v, w} (k := k) V)
    (f : X.carrier →ₗ[DualNumber k] X.carrier)
    (hf : ∀ m, X.reduction (f m) = X.reduction m) : Function.Bijective f := by
  let I : Ideal (DualNumber k) := dualKernel k
  have hI2 : I ^ 2 = ⊥ := dualKernel_sq k
  let N : X.carrier →ₗ[DualNumber k] X.carrier :=
    f - (LinearMap.id : X.carrier →ₗ[DualNumber k] X.carrier)
  have hNrng (m : X.carrier) : N m ∈ I • (⊤ : Submodule (DualNumber k) X.carrier) := by
    apply reduction_kernel_mem X (N m)
    change X.reduction (f m - m) = 0
    simp only [map_sub, hf m, sub_self]
  have hN2 (m : X.carrier) : N (N m) = 0 := by
    apply Submodule.smul_induction_on (p := fun z => N z = 0) (hNrng m)
    · intro r hr x hx
      change N (r • x) = 0
      rw [N.map_smul]
      have hz : r • N x = 0 := by
        apply Submodule.smul_induction_on (p := fun z => r • z = 0) (hNrng x)
        · intro s hs y hy
          have hrs : r * s = 0 := by
            have hmul : I * I = ⊥ := by simpa [pow_two] using hI2
            have : r * s ∈ I * I := Ideal.mul_mem_mul hr hs
            rw [hmul] at this
            simpa using this
          rw [smul_smul, hrs]
          exact zero_smul (M₀ := DualNumber k) y
        · intro y z hy hz
          simp [hy, hz]
      exact hz
    · intro x y hx hy
      simp [N.map_add, hx, hy]
  have hfm (m : X.carrier) : f m = m + N m := by simp [N]
  refine ⟨fun x y h => ?_, fun y => ⟨y - N y, ?_⟩⟩
  · have hd : N (x - y) = -(x - y) := by
      simp [N, h]
    have := hN2 (x - y)
    rw [hd, map_neg, hd, neg_neg] at this
    exact sub_eq_zero.mp this
  · rw [hfm, map_sub, hN2, sub_zero, sub_add_cancel]

/-- A lift maps to any other lift of the same space, compatibly with the reduction maps. -/
private lemma exists_map_reduction_eq {V : Type w} [AddCommGroup V] [Module k V]
    (X : DualNumberLift.{u, v, w} (k := k) V) (Y : DualNumberLift.{u, v', w} (k := k) V) :
    ∃ f : X.carrier →ₗ[DualNumber k] Y.carrier, ∀ m, Y.reduction (f m) = X.reduction m := by
  let : Module (DualNumber k) V := Module.compHom V (dualProjection k).toRingHom
  let αX : X.carrier →ₗ[DualNumber k] V := {
    toFun := X.reduction
    map_add' := X.reduction.map_add
    map_smul' := X.reduction.map_smul' }
  let αY : Y.carrier →ₗ[DualNumber k] V := {
    toFun := Y.reduction
    map_add' := Y.reduction.map_add
    map_smul' := Y.reduction.map_smul' }
  obtain ⟨f, hf⟩ := Module.projective_lifting_property αY αX (reduction_surjective Y)
  exact ⟨f, fun m => LinearMap.congr_fun hf m⟩

/-- Any two finite projective lifts of the same vector space to the dual numbers are isomorphic
over that vector space. -/
public theorem exists_linearEquiv {V : Type w} [AddCommGroup V] [Module k V]
    (X : DualNumberLift.{u, v, w} (k := k) V)
    (Y : DualNumberLift.{u, v', w} (k := k) V) :
      ∃ e : X.carrier ≃ₗ[DualNumber k] Y.carrier,
      ∀ m : X.carrier, Y.reduction (e m) = X.reduction m := by
  obtain ⟨f, hf⟩ := exists_map_reduction_eq X Y
  obtain ⟨g, hg⟩ := exists_map_reduction_eq Y X
  have hfg' : Function.Bijective (f.comp g) :=
    endomorphism_bijective_of_reduction_eq Y (f.comp g) fun m => by rw [f.comp_apply, hf, hg]
  have hgf' : Function.Bijective (g.comp f) :=
    endomorphism_bijective_of_reduction_eq X (g.comp f) fun m => by rw [g.comp_apply, hg, hf]
  have hbij : Function.Bijective f :=
    ⟨Function.Injective.of_comp (f := ⇑g) hgf'.1, Function.Surjective.of_comp (g := ⇑g) hfg'.2⟩
  exact ⟨LinearEquiv.ofBijective f hbij, hf⟩

end DualNumberLift

/-- Every finite-dimensional vector space has a finite projective lift to the dual numbers. -/
public theorem nonempty_dualNumberLift {V : Type w} [AddCommGroup V]
    [Module k V] [Module.Finite k V] :
    Nonempty (DualNumberLift.{u, max u w, w} (k := k) V) := by
  let : Algebra (DualNumber k) k := TrivSqZeroExt.algebraBase k k
  let n := Module.finrank k V
  let bV : Module.Basis (Fin n) k V := Module.finBasis k V
  let bD : Module.Basis (Fin n) (DualNumber k) (Fin n → DualNumber k) :=
    Pi.basisFun (DualNumber k) (Fin n)
  let carrier := ULift.{max u w} (Fin n → DualNumber k)
  let liftEquiv : carrier ≃ₗ[DualNumber k] (Fin n → DualNumber k) := ULift.moduleEquiv
  let bCarrier : Module.Basis (Fin n) (DualNumber k) carrier := bD.map liftEquiv.symm
  let e : (TensorProduct (DualNumber k) k carrier) ≃ₗ[k] V :=
    (bCarrier.baseChange k).equiv bV (Equiv.refl (Fin n))
  let : Module (DualNumber k) carrier := ULift.module'
  let : DistribMulAction (DualNumber k) carrier :=
    (inferInstance : Module (DualNumber k) carrier).toDistribMulAction
  let : TensorProduct.CompatibleSMul (DualNumber k) (DualNumber k) k carrier :=
    TensorProduct.CompatibleSMul.of_algebraMap_surjective
      (R := DualNumber k) (A := DualNumber k) (M := k) (N := carrier)
      fun x => ⟨x, rfl⟩
  let ρ : carrier →ₛₗ[(TrivSqZeroExt.fstHom k k k).toRingHom] V := {
    toFun := fun m => e (1 ⊗ₜ[DualNumber k] m)
    map_add' := by intro m n; rw [TensorProduct.tmul_add, map_add]
    map_smul' := by
      intro r m
      change e (1 ⊗ₜ[DualNumber k] (r • m)) = r.fst • e (1 ⊗ₜ[DualNumber k] m)
      calc
        e (1 ⊗ₜ[DualNumber k] (r • m)) = e (r.fst • (1 ⊗ₜ[DualNumber k] m)) := by
          congr 1
          calc
            1 ⊗ₜ[DualNumber k] (r • m) = (r • (1 : k)) ⊗ₜ[DualNumber k] m :=
              (TensorProduct.smul_tmul (R := DualNumber k) (R' := DualNumber k)
                r (1 : k) m).symm
            _ = r.fst ⊗ₜ[DualNumber k] m := by
              change (r.fst * (1 : k)) ⊗ₜ[DualNumber k] m = r.fst ⊗ₜ[DualNumber k] m
              simp
            _ = (r.fst • (1 : k)) ⊗ₜ[DualNumber k] m := by simp
            _ = r.fst • (1 ⊗ₜ[DualNumber k] m) :=
              (TensorProduct.smul_tmul' (R := DualNumber k) (R' := k)
                r.fst (1 : k) m).symm
        _ = r.fst • e (1 ⊗ₜ[DualNumber k] m) := map_smul e _ _ }
  exact ⟨⟨carrier, ρ, e, fun _ => rfl⟩⟩

end Deformation.Examples
