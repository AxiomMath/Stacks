/-! ### Transferring a decomposition between families with the same carriers -/

namespace DirectSum

variable {ι₀ : Type*} {M : Type*} {S₁ : Type*} {S₂ : Type*} [AddCommMonoid M]
  [SetLike S₁ M] [AddSubmonoidClass S₁ M] [SetLike S₂ M] [AddSubmonoidClass S₂ M]

/-- Two substructures of an additive monoid with the same carrier are isomorphic as additive
monoids. -/
def addEquivOfCoeEq {p : S₁} {q : S₂} (h : (p : Set M) = (q : Set M)) : ↥p ≃+ ↥q where
  toFun x := ⟨(x : M), by
    have hx : (x : M) ∈ (p : Set M) := x.2
    rw [h] at hx
    exact hx⟩
  invFun y := ⟨(y : M), by
    have hy : (y : M) ∈ (q : Set M) := y.2
    rw [← h] at hy
    exact hy⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- A family of substructures whose carriers are those of a decomposing family is itself a
decomposition. The two families may live in different `SetLike` types, which is why the
decomposition is transported along the additive isomorphisms of the pieces rather than obtained
by substituting one family for the other. -/
@[instance_reducible]
def decompositionOfCoeEq [DecidableEq ι₀] (ℳ : ι₀ → S₁) [Decomposition ℳ] (𝒩 : ι₀ → S₂)
    (h : ∀ i, (ℳ i : Set M) = (𝒩 i : Set M)) : Decomposition 𝒩 := by
  have key : (DirectSum.coeAddMonoidHom 𝒩).comp
      (DirectSum.map fun i ↦ (addEquivOfCoeEq (h i)).toAddMonoidHom) =
      DirectSum.coeAddMonoidHom ℳ :=
    addHom_ext fun i y ↦ by
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, map_of,
        DirectSum.coeAddMonoidHom_of]
      rfl
  refine Decomposition.ofAddHom 𝒩
    ((DirectSum.map fun i ↦ (addEquivOfCoeEq (h i)).toAddMonoidHom).comp
      (decomposeAddEquiv ℳ).toAddMonoidHom) (AddMonoidHom.ext fun x ↦ ?_)
    (addHom_ext fun i y ↦ ?_)
  · have hx := DFunLike.congr_fun key (decomposeAddEquiv ℳ x)
    simp only [AddMonoidHom.coe_comp, Function.comp_apply,
      AddEquiv.coe_toAddMonoidHom] at hx ⊢
    rw [hx]
    exact DirectSum.Decomposition.left_inv x
  · have hy : (y : M) ∈ ℳ i := by
      have h2 : (y : M) ∈ (𝒩 i : Set M) := y.2
      rw [← h i] at h2
      exact h2
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, DirectSum.coeAddMonoidHom_of,
      AddMonoidHom.id_apply, AddEquiv.coe_toAddMonoidHom]
    have hd : decomposeAddEquiv ℳ (y : M) = of (fun i ↦ ↥(ℳ i)) i ⟨(y : M), hy⟩ := by
      simpa using DirectSum.decompose_of_mem ℳ hy
    rw [hd, map_of]
    congr 1

end DirectSum

/-! ### Weighted-homogeneous polynomials along a surjection of base rings -/

namespace MvPolynomial

variable {ι : Type x}

section Map

variable {A : Type u} [CommRing A] {k : Type w} [CommRing k]

/-- Taking a weighted-homogeneous component commutes with mapping the coefficients. -/
theorem map_weightedHomogeneousComponent (f : A →+* k) (w : ι → ℕ) (d : ℕ)
    (u : MvPolynomial ι A) :
    map f (weightedHomogeneousComponent w d u) =
      weightedHomogeneousComponent w d (map f u) := by
  classical
  ext m
  rw [coeff_map, coeff_weightedHomogeneousComponent, coeff_weightedHomogeneousComponent,
    coeff_map]
  split_ifs with h
  · rfl
  · exact map_zero f

/-- A weighted-homogeneous polynomial lifts, along a surjection of base rings, to a
weighted-homogeneous polynomial of the same degree: lift it arbitrarily and take the
weighted-homogeneous component of that degree. -/
theorem exists_isWeightedHomogeneous_map_eq {f : A →+* k} (hf : Function.Surjective f)
    (w : ι → ℕ) {d : ℕ} {g : MvPolynomial ι k} (hg : g.IsWeightedHomogeneous w d) :
    ∃ u : MvPolynomial ι A, u.IsWeightedHomogeneous w d ∧ map f u = g := by
  obtain ⟨u₀, hu₀⟩ := map_surjective f hf g
  refine ⟨weightedHomogeneousComponent w d u₀,
    weightedHomogeneousComponent_isWeightedHomogeneous d u₀, ?_⟩
  rw [map_weightedHomogeneousComponent, hu₀, weightedHomogeneousComponent_eq_self hg]

/-- A polynomial all of whose coefficients lie in an ideal of the base ring is a combination of
that ideal with polynomials: it is the sum of its monomials. -/
theorem mem_smul_top_of_coeff_mem (I : Ideal A) {u : MvPolynomial ι A}
    (hu : ∀ m, coeff m u ∈ I) : u ∈ I • (⊤ : Submodule A (MvPolynomial ι A)) := by
  classical
  rw [as_sum u]
  refine sum_mem fun m _ ↦ ?_
  have h : monomial m (coeff m u) = coeff m u • monomial m (1 : A) := by
    rw [smul_monomial, smul_eq_mul, mul_one]
  rw [h]
  exact Submodule.smul_mem_smul (hu m) Submodule.mem_top

/-- Mapping the coefficients along a ring map killing an ideal kills every combination of that
ideal with polynomials. -/
theorem map_eq_zero_of_mem_smul {I : Ideal A} {f : A →+* k} (hf : ∀ a ∈ I, f a = 0)
    {N : Submodule A (MvPolynomial ι A)} {u : MvPolynomial ι A} (hu : u ∈ I • N) :
    map f u = 0 := by
  refine Submodule.smul_induction_on hu ?_ ?_
  · intro a ha v _
    rw [smul_eq_C_mul, map_mul, map_C, hf a ha, map_zero, zero_mul]
  · intro v v' hv hv'
    rw [map_add, hv, hv', add_zero]

/-- The degree-`d` weighted-homogeneous component of a combination of an ideal of the base ring
with arbitrary polynomials is a combination of that ideal with weighted-homogeneous polynomials
of degree `d`. -/
theorem weightedHomogeneousComponent_mem_smul (I : Ideal A) (w : ι → ℕ) (d : ℕ)
    {u : MvPolynomial ι A} (hu : u ∈ I • (⊤ : Submodule A (MvPolynomial ι A))) :
    weightedHomogeneousComponent w d u ∈ I • weightedHomogeneousSubmodule A w d := by
  refine Submodule.smul_induction_on hu ?_ ?_
  · intro a ha v _
    rw [map_smul]
    exact Submodule.smul_mem_smul ha (weightedHomogeneousComponent_mem w v d)
  · intro v v' hv hv'
    rw [map_add]
    exact add_mem hv hv'

/-- Subtracting a combination of the kernel of `f` with weighted-homogeneous polynomials of degree
`d` from a weighted-homogeneous polynomial of degree `d` keeps it homogeneous and keeps its image
under `map f`. -/
private theorem isWeightedHomogeneous_sub_map_eq {f : A →+* k} {w : ι → ℕ} {d : ℕ}
    {G c : MvPolynomial ι A} (hG : G.IsWeightedHomogeneous w d)
    (hc : c ∈ RingHom.ker f • weightedHomogeneousSubmodule A w d) :
    (G - c).IsWeightedHomogeneous w d ∧ map f (G - c) = map f G :=
  ⟨hG.sub ((mem_weightedHomogeneousSubmodule A w d c).mp (Submodule.smul_le_right hc)),
    by rw [map_sub, map_eq_zero_of_mem_smul (fun a ha ↦ ha) hc, sub_zero]⟩

end Map

section Graded

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- If a polynomial evaluates to a homogeneous element of degree `d` at homogeneous elements of
the matching degrees, then so does its degree-`d` weighted-homogeneous component: the other
components contribute in other degrees, where the value is zero. -/
theorem aeval_weightedHomogeneousComponent_eq_of_mem (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜]
    (x : ι → S) (w : ι → ℕ) (hx : ∀ i, x i ∈ 𝒜 (w i)) {d : ℕ} {φ : MvPolynomial ι R} {p : S}
    (hp : p ∈ 𝒜 d) (hφ : aeval x φ = p) :
    aeval x (weightedHomogeneousComponent w d φ) = p := by
  classical
  have hymem : ∀ n : ℕ, aeval x (weightedHomogeneousComponent w n φ) -
      (if n = d then p else 0) ∈ 𝒜 n := by
    intro n
    refine sub_mem (aeval_mem_of_isWeightedHomogeneous 𝒜 x w hx
      (weightedHomogeneousComponent_isWeightedHomogeneous n φ)) ?_
    by_cases hn : n = d
    · subst hn
      simpa using hp
    · simp [hn]
  have hsum0 : ∑ n ∈ insert d (Finset.image (Finsupp.weight w) φ.support),
      aeval x (weightedHomogeneousComponent w n φ) = p := by
    have h1 : ∑ n ∈ Finset.image (Finsupp.weight w) φ.support,
        aeval x (weightedHomogeneousComponent w n φ) =
        ∑ n ∈ insert d (Finset.image (Finsupp.weight w) φ.support),
          aeval x (weightedHomogeneousComponent w n φ) :=
      Finset.sum_subset (Finset.subset_insert _ _) fun n _ hn ↦ by
        rw [weightedHomogeneousComponent_eq_zero_of_notMem w φ n hn, map_zero]
    rw [← h1, ← map_sum, sum_weightedHomogeneousComponent_support w φ, hφ]
  have hsumif : ∑ n ∈ insert d (Finset.image (Finsupp.weight w) φ.support),
      (if n = d then p else 0) = p := by
    rw [Finset.sum_eq_single_of_mem d (Finset.mem_insert_self _ _)
      fun n _ hn ↦ by simp [hn]]
    simp
  have hzero : ∑ n ∈ insert d (Finset.image (Finsupp.weight w) φ.support),
      (aeval x (weightedHomogeneousComponent w n φ) - (if n = d then p else 0)) = 0 := by
    rw [Finset.sum_sub_distrib, hsum0, hsumif, sub_self]
  have key := eq_zero_of_sum_mem_graded_eq_zero 𝒜
    (insert d (Finset.image (Finsupp.weight w) φ.support))
    (fun n ↦ aeval x (weightedHomogeneousComponent w n φ) - (if n = d then p else 0))
    hymem hzero d (Finset.mem_insert_self _ _)
  have key' : aeval x (weightedHomogeneousComponent w d φ) - p = 0 := by simpa using key
  exact sub_eq_zero.mp key'

/-- A homogeneous element of a graded algebra generated by homogeneous elements is the value of a
weighted-homogeneous polynomial of the same degree. -/
theorem exists_isWeightedHomogeneous_aeval_eq (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜]
    (x : ι → S) (w : ι → ℕ) (hx : ∀ i, x i ∈ 𝒜 (w i))
    (hsurj : Function.Surjective (aeval x : MvPolynomial ι R →ₐ[R] S))
    {d : ℕ} {p : S} (hp : p ∈ 𝒜 d) :
    ∃ φ : MvPolynomial ι R, φ.IsWeightedHomogeneous w d ∧ aeval x φ = p := by
  obtain ⟨φ, hφ⟩ := hsurj p
  exact ⟨weightedHomogeneousComponent w d φ,
    weightedHomogeneousComponent_isWeightedHomogeneous d φ,
    aeval_weightedHomogeneousComponent_eq_of_mem 𝒜 x w hx hp hφ⟩

end Graded

end MvPolynomial

namespace GradedDeformation

/-! ### The reduction of the value of a polynomial at lifts -/

section Reduction

variable {k : Type w} [CommRing k] {A : Type u} [CommRing A] [Algebra A k]
  {P : Type v} [CommRing P] [Algebra k P] {Q : Type t} [CommRing Q] [Algebra A Q]
  {ι : Type x}

/-- **The reduction of a polynomial value.** The reduction of the value of a polynomial over the
base at lifted elements is the value of the polynomial with reduced coefficients at the reduced
elements. This is the statement that lets a relation of a presentation of the special fibre be
tested against lifts. -/
theorem reduction_aeval (red : Q →+* P)
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q) (yl : ι → Q)
    (u : MvPolynomial ι A) :
    red (aeval yl u) = aeval (fun i ↦ red (yl i)) (MvPolynomial.map (algebraMap A k) u) := by
  induction u using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.map_C, aeval_C, aeval_C,
        Algebra.algebraMap_eq_smul_one (R := A) (A := Q) a, hsmul, map_one]
      exact (Algebra.algebraMap_eq_smul_one _).symm
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp => simp only [map_mul, MvPolynomial.map_X, aeval_X, hp]

end Reduction

/-! ### The lifted presentation algebra, its grading and its structural map -/

section Algebra

variable {A : Type u} [CommRing A] {ι : Type x} {σ : Type y}

/-- **The lifted presentation algebra** `A[X_i]/(R_j)` of a family of relations `R` over the
base `A`. For the lifted relations of a graded deformation this is the algebra which presents the
deformation itself. -/
abbrev liftedAlgebra (R : σ → MvPolynomial ι A) := MvPolynomial ι A ⧸ Ideal.span (Set.range R)

/-- The degree-`d` piece of the lifted presentation algebra: the image of the submodule of
weighted-homogeneous polynomials of degree `d`. -/
noncomputable def liftedGrading (w : ι → ℕ) (R : σ → MvPolynomial ι A) (d : ℕ) :
    Submodule A (liftedAlgebra R) :=
  Submodule.map (Ideal.Quotient.mkₐ A (Ideal.span (Set.range R))).toLinearMap
    (MvPolynomial.weightedHomogeneousSubmodule A w d)

/-- The class of a weighted-homogeneous polynomial of degree `d` is homogeneous of degree `d`. -/
theorem mk_mem_liftedGrading {w : ι → ℕ} {R : σ → MvPolynomial ι A} {d : ℕ}
    {u : MvPolynomial ι A} (hu : u.IsWeightedHomogeneous w d) :
    Ideal.Quotient.mk (Ideal.span (Set.range R)) u ∈ liftedGrading w R d :=
  ⟨u, (MvPolynomial.mem_weightedHomogeneousSubmodule A w d u).mpr hu, rfl⟩

/-- A homogeneous element of degree `d` of the lifted presentation algebra is the class of a
weighted-homogeneous polynomial of degree `d`. -/
theorem exists_isWeightedHomogeneous_of_mem_liftedGrading {w : ι → ℕ}
    {R : σ → MvPolynomial ι A} {d : ℕ} {s : liftedAlgebra R} (hs : s ∈ liftedGrading w R d) :
    ∃ u : MvPolynomial ι A, u.IsWeightedHomogeneous w d ∧
      Ideal.Quotient.mk (Ideal.span (Set.range R)) u = s := by
  obtain ⟨u, hu, rfl⟩ := hs
  exact ⟨u, (MvPolynomial.mem_weightedHomogeneousSubmodule A w d u).mp hu, rfl⟩

/-- **The grading of the lifted presentation algebra.** The images of the weighted-homogeneous
submodules decompose the quotient by a homogeneous relation ideal. -/
@[instance_reducible]
noncomputable def liftedDecomposition (w : ι → ℕ) (R : σ → MvPolynomial ι A)
    (hR : ∀ j, ∃ d, (R j).IsWeightedHomogeneous w d) :
    DirectSum.Decomposition (liftedGrading w R) := by
  letI : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule A w) :=
    MvPolynomial.weightedGradedAlgebra A w
  have hI : (Ideal.span (Set.range R)).IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule A w) := by
    refine Ideal.homogeneous_span _ _ ?_
    rintro _ ⟨j, rfl⟩
    obtain ⟨d, hd⟩ := hR j
    exact ⟨d, (MvPolynomial.mem_weightedHomogeneousSubmodule A w d _).mpr hd⟩
  letI := Stacks.GradedQuotient.decomposition
    (MvPolynomial.weightedHomogeneousSubmodule A w) (Ideal.span (Set.range R)) hI
  refine DirectSum.decompositionOfCoeEq
    (Stacks.GradedQuotient.grading (MvPolynomial.weightedHomogeneousSubmodule A w)
      (Ideal.span (Set.range R))) (liftedGrading w R) fun d ↦ ?_
  rw [Stacks.GradedQuotient.coe_grading, liftedGrading, Submodule.map_coe]
  rfl

variable {Q : Type t} [CommRing Q] [Algebra A Q]

/-- **The structural map of the lifted presentation algebra**: evaluation at the chosen lifts,
which kills the relation ideal exactly because the lifted relations vanish at the lifts. -/
noncomputable def liftedMap (yl : ι → Q) (R : σ → MvPolynomial ι A)
    (hR : ∀ j, aeval yl (R j) = 0) : liftedAlgebra R →ₐ[A] Q :=
  Ideal.Quotient.liftₐ _ (aeval yl) fun u hu ↦ by
    have hle : Ideal.span (Set.range R) ≤
        RingHom.ker (aeval yl : MvPolynomial ι A →ₐ[A] Q).toRingHom := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact RingHom.mem_ker.mpr (hR j)
    exact RingHom.mem_ker.mp (hle hu)

/-- The structural map is evaluation at the chosen lifts. -/
@[simp]
theorem liftedMap_mk (yl : ι → Q) (R : σ → MvPolynomial ι A) (hR : ∀ j, aeval yl (R j) = 0)
    (u : MvPolynomial ι A) :
    liftedMap yl R hR (Ideal.Quotient.mk (Ideal.span (Set.range R)) u) = aeval yl u := rfl

end Algebra

/-- A homogeneous element of the deformation killed by the reduction lies in the square-zero ideal
times the piece. -/
private theorem mem_ker_smul_top_of_reduction_eq_zero
    {k : Type w} [CommRing k] {A : Type u} [CommRing A] [Algebra k A] [Algebra A k]
    {P : Type v} [CommRing P] [Algebra k P] [Module A P] [IsScalarTower A k P]
    {𝒜 : ℕ → Submodule k P} {Q : Type t} [CommRing Q] [Algebra A Q] {𝒬 : ℕ → Submodule A Q}
    {red : Q →+* P}
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d)) {d : ℕ} {z : Q} (hzmem : z ∈ 𝒬 d)
    (hz : red z = 0) :
    (⟨z, hzmem⟩ : ↥(𝒬 d)) ∈ RingHom.ker (algebraMap A k) • (⊤ : Submodule A ↥(𝒬 d)) := by
  rw [← (hbc d).ker_eq_ker_algebraMap_smul_top
    (SquareZeroRetraction.surjective_algebraMap hret), LinearMap.mem_ker]
  exact gradedPiece_eq_zero hz

/-! ### Homogeneous elements of the deformation as values of homogeneous polynomials -/

section Values

variable {k : Type w} [CommRing k]
  {A : Type u} [CommRing A] [Algebra k A] [Algebra A k]
  {P : Type v} [CommRing P] [Algebra k P] [Module A P] [IsScalarTower A k P]
  {𝒜 : ℕ → Submodule k P} [GradedAlgebra 𝒜]
  {Q : Type t} [CommRing Q] [Algebra A Q] [Algebra k Q] [IsScalarTower k A Q]
  {𝒬 : ℕ → Submodule A Q} [GradedAlgebra 𝒬] [∀ d, Module.Flat A ↥(𝒬 d)]
  {red : Q →+* P}
  {ι : Type x} {σ : Type y}
  (pres : Algebra.WeightedHomogeneousPresentation k P 𝒜 ι σ) {yl : ι → Q}

omit [Module A P] [IsScalarTower A k P] [Algebra k Q] [IsScalarTower k A Q] in
/-- **Every homogeneous element of the special fibre is reached.** A homogeneous element of
degree `d` of the special fibre is the reduction of the value at the chosen lifts of a
weighted-homogeneous polynomial of degree `d` over the base. -/
theorem exists_isWeightedHomogeneous_reduction_aeval_eq
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hy : ∀ i, red (yl i) = pres.val i) {d : ℕ} {p : P} (hp : p ∈ 𝒜 d) :
    ∃ u : MvPolynomial ι A, u.IsWeightedHomogeneous pres.varDegree d ∧
      red (aeval yl u) = p := by
  obtain ⟨g, hghom, hgval⟩ := MvPolynomial.exists_isWeightedHomogeneous_aeval_eq 𝒜 pres.val
    pres.varDegree pres.val_mem pres.surjective_aeval hp
  obtain ⟨u, huhom, humap⟩ := MvPolynomial.exists_isWeightedHomogeneous_map_eq
    (SquareZeroRetraction.surjective_algebraMap hret) pres.varDegree hghom
  refine ⟨u, huhom, ?_⟩
  have hval : (fun i ↦ red (yl i)) = pres.val := funext hy
  rw [reduction_aeval red hsmul yl u, humap, hval]
  exact hgval

omit [GradedAlgebra 𝒜] [Algebra k Q] [IsScalarTower k A Q] [GradedAlgebra 𝒬]
  [∀ (d : ℕ), Module.Flat A ↥(𝒬 d)] in
/-- An element of the square-zero ideal annihilates every homogeneous element of the deformation
killed by the reduction: the kernel of the degreewise reduction is the square-zero ideal times
the piece, and the square of that ideal vanishes. -/
theorem smul_eq_zero_of_mem_ker
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d)) {d : ℕ} {a : A}
    (ha : a ∈ RingHom.ker (algebraMap A k)) {z : Q} (hzmem : z ∈ 𝒬 d) (hz : red z = 0) :
    a • z = 0 := by
  have hmz := mem_ker_smul_top_of_reduction_eq_zero hsmul hmem hret hbc hzmem hz
  have key : ∀ y ∈ RingHom.ker (algebraMap A k) • (⊤ : Submodule A ↥(𝒬 d)),
      a • y = (0 : ↥(𝒬 d)) := by
    intro y hy
    refine Submodule.smul_induction_on hy ?_ ?_
    · intro b hb m _
      have hab : a * b = 0 := by
        have hprod := Ideal.mul_mem_mul ha hb
        rwa [hsq, Ideal.mem_bot] at hprod
      rw [smul_smul, hab, zero_smul]
    · intro v v' hv hv'
      rw [smul_add, hv, hv', add_zero]
  have h2 := congrArg (fun y : ↥(𝒬 d) ↦ (y : Q)) (key _ hmz)
  simpa using h2

omit [Algebra k Q] [IsScalarTower k A Q] [∀ (d : ℕ), Module.Flat A ↥(𝒬 d)] in
/-- **A homogeneous element killed by the reduction is a value with small coefficients.** Such an
element of degree `d` is the value at the chosen lifts of a weighted-homogeneous polynomial of
degree `d` all of whose coefficients lie in the square-zero ideal.

The kernel of the degreewise reduction is the square-zero ideal times the piece; a multiple
`a · m` of a homogeneous element by an element of that ideal is `a · u(y)` for any homogeneous
polynomial `u` whose value reduces to the reduction of `m`, because the discrepancy is killed by
the reduction and hence annihilated by `a`. -/
theorem exists_mem_smul_aeval_eq
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i)
    {d : ℕ} {q : Q} (hq : q ∈ 𝒬 d) (hred : red q = 0) :
    ∃ u ∈ RingHom.ker (algebraMap A k) •
        MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree d,
      aeval yl u = q := by
  have hmq := mem_ker_smul_top_of_reduction_eq_zero hsmul hmem hret hbc hq hred
  have key : ∀ y ∈ RingHom.ker (algebraMap A k) • (⊤ : Submodule A ↥(𝒬 d)),
      ∃ u ∈ RingHom.ker (algebraMap A k) •
        MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree d,
        aeval yl u = (y : Q) := by
    intro y hy'
    refine Submodule.smul_induction_on hy' ?_ ?_
    · intro b hb m _
      obtain ⟨v, hvhom, hv⟩ := exists_isWeightedHomogeneous_reduction_aeval_eq pres hsmul
        hret hy (hmem d (m : Q) m.2)
      refine ⟨b • v, Submodule.smul_mem_smul hb
        ((MvPolynomial.mem_weightedHomogeneousSubmodule A pres.varDegree d v).mpr hvhom), ?_⟩
      have hvmem : aeval yl v ∈ 𝒬 d :=
        MvPolynomial.aeval_mem_of_isWeightedHomogeneous 𝒬 yl pres.varDegree hyd hvhom
      have hzero : b • (aeval yl v - (m : Q)) = 0 :=
        smul_eq_zero_of_mem_ker hsmul hmem hret hsq hbc hb (sub_mem hvmem m.2)
          (by rw [map_sub, hv, sub_self])
      rw [map_smul]
      rw [smul_sub, sub_eq_zero] at hzero
      exact hzero
    · rintro v v' ⟨u, hu, hue⟩ ⟨u', hu', hu'e⟩
      exact ⟨u + u', add_mem hu hu', by rw [map_add, hue, hu'e]; rfl⟩
  exact key _ hmq

omit [GradedAlgebra 𝒜] [GradedAlgebra 𝒬] in
/-- **The element named by a pure tensor.** It is the corresponding multiple of any preimage of
the second factor under the degreewise reduction. This is
`SquareZeroRetraction.coe_kerEquiv_tmul` read through `GradedDeformation.kerElement`. -/
theorem kerElement_tmul_gradedPiece
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d)) (d : ℕ)
    (a : ↥(RingHom.ker (algebraMap A k))) (m : ↥(𝒬 d)) :
    kerElement hret hsq hbc d (a ⊗ₜ[k] gradedPiece red hsmul hmem d m) =
      (a : A) • (m : Q) :=
  (congrArg (fun y : ↥(𝒬 d) ↦ (y : Q))
    (SquareZeroRetraction.coe_kerEquiv_tmul hret hsq (hbc d) a m)).trans
      (Submodule.coe_smul _ _)

end Values

/-! ### The lifted relations -/

section Relations

variable {k : Type w} [CommRing k]
  {A : Type u} [CommRing A] [Algebra k A] [Algebra A k]
  {P : Type v} [CommRing P] [Algebra k P] [Module A P] [IsScalarTower A k P]
  {𝒜 : ℕ → Submodule k P} [GradedAlgebra 𝒜]
  {Q : Type t} [CommRing Q] [Algebra A Q] [Algebra k Q] [IsScalarTower k A Q]
  {𝒬 : ℕ → Submodule A Q} [GradedAlgebra 𝒬] [∀ d, Module.Flat A ↥(𝒬 d)]
  {red : Q →+* P}
  {ι : Type x} {σ : Type y}
  (pres : Algebra.WeightedHomogeneousPresentation k P 𝒜 ι σ) {yl : ι → Q}

omit [Algebra k Q] [IsScalarTower k A Q] [∀ (d : ℕ), Module.Flat A ↥(𝒬 d)] in
/-- **The lifted relations exist.** For each relation `F_j` of the presentation of the special
fibre there is a weighted-homogeneous polynomial `R_j` over the base, of the same degree, which
reduces to `F_j` and which vanishes at the chosen lifts of the generators.

Lift `F_j` arbitrarily to a homogeneous `G_j` over the base. Its value at the lifts is
homogeneous of degree `e j` and reduces to `F_j(x) = 0`, so it is the value of a homogeneous
polynomial `c_j` of degree `e j` whose coefficients lie in the square-zero ideal; `R_j :=
G_j - c_j` then vanishes at the lifts, and still reduces to `F_j` because the coefficients of
`c_j` reduce to zero. -/
theorem exists_relationLift
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i) :
    ∃ R : σ → MvPolynomial ι A,
      (∀ j, (R j).IsWeightedHomogeneous pres.varDegree (pres.relDegree j)) ∧
        (∀ j, MvPolynomial.map (algebraMap A k) (R j) = pres.relation j) ∧
          ∀ j, aeval yl (R j) = 0 := by
  have hval : (fun i ↦ red (yl i)) = pres.val := funext hy
  have hstep : ∀ j : σ, ∃ r : MvPolynomial ι A,
      r.IsWeightedHomogeneous pres.varDegree (pres.relDegree j) ∧
        MvPolynomial.map (algebraMap A k) r = pres.relation j ∧ aeval yl r = 0 := by
    intro j
    obtain ⟨G, hGhom, hGmap⟩ := MvPolynomial.exists_isWeightedHomogeneous_map_eq
      (SquareZeroRetraction.surjective_algebraMap hret) pres.varDegree
      (pres.relation_isWeightedHomogeneous j)
    have hGmem : aeval yl G ∈ 𝒬 (pres.relDegree j) :=
      MvPolynomial.aeval_mem_of_isWeightedHomogeneous 𝒬 yl pres.varDegree hyd hGhom
    have hGred : red (aeval yl G) = 0 := by
      rw [reduction_aeval red hsmul yl G, hGmap, hval]
      exact pres.aeval_val_relation j
    obtain ⟨c, hcmem, hcval⟩ := exists_mem_smul_aeval_eq pres hsmul hmem hret hsq hbc hyd hy
      hGmem hGred
    obtain ⟨hhom, hmap⟩ := MvPolynomial.isWeightedHomogeneous_sub_map_eq hGhom hcmem
    exact ⟨G - c, hhom, hmap.trans hGmap, by rw [map_sub, hcval, sub_self]⟩
  choose R hRhom hRmap hRaeval using hstep
  exact ⟨R, hRhom, hRmap, hRaeval⟩

end Relations

/-! ### The two conditions of the presentation criterion -/

section Nakayama

variable {k : Type w} [CommRing k]
  {A : Type u} [CommRing A] [Algebra k A] [Algebra A k]
  {P : Type v} [CommRing P] [Algebra k P] [Module A P] [IsScalarTower A k P]
  {𝒜 : ℕ → Submodule k P} [GradedAlgebra 𝒜]
  {Q : Type t} [CommRing Q] [Algebra A Q] [Algebra k Q] [IsScalarTower k A Q]
  {𝒬 : ℕ → Submodule A Q} [GradedAlgebra 𝒬] [∀ d, Module.Flat A ↥(𝒬 d)]
  {red : Q →+* P}
  {ι : Type x} {σ : Type y}
  (pres : Algebra.WeightedHomogeneousPresentation k P 𝒜 ι σ) {yl : ι → Q}
  {R : σ → MvPolynomial ι A}

omit [Algebra k A] [Algebra A k] [Module A P] [IsScalarTower A k P] [GradedAlgebra 𝒜]
  [Algebra k Q] [IsScalarTower k A Q] [∀ (d : ℕ), Module.Flat A ↥(𝒬 d)] in
/-- **The structural map is graded.** It carries the degree-`d` piece of the lifted presentation
algebra into the degree-`d` piece of the deformation: a class in that piece is represented by a
weighted-homogeneous polynomial of degree `d`, whose value at homogeneous lifts of the matching
degrees is homogeneous of degree `d`. -/
theorem liftedMap_mem_of_mem_liftedGrading (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i))
    (hRaeval : ∀ j, aeval yl (R j) = 0) (d : ℕ) {s : liftedAlgebra R}
    (hs : s ∈ liftedGrading pres.varDegree R d) :
    liftedMap yl R hRaeval s ∈ 𝒬 d := by
  obtain ⟨u, huhom, rfl⟩ := exists_isWeightedHomogeneous_of_mem_liftedGrading hs
  exact MvPolynomial.aeval_mem_of_isWeightedHomogeneous 𝒬 yl pres.varDegree hyd huhom

omit [Module A P] [IsScalarTower A k P] [Algebra k Q] [IsScalarTower k A Q] in
/-- **Surjectivity in each degree.** Every homogeneous element of the special fibre of degree `d`
is the reduction of the image of a homogeneous element of degree `d` of the lifted presentation
algebra. This is the first hypothesis of
`Deformation.Examples.ProjectiveGradedAlgebra.bijective_of_gradedPresentation`. -/
theorem exists_mem_liftedGrading_reduction_eq
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hy : ∀ i, red (yl i) = pres.val i) (hRaeval : ∀ j, aeval yl (R j) = 0) (d : ℕ) {p : P}
    (hp : p ∈ 𝒜 d) :
    ∃ s ∈ liftedGrading pres.varDegree R d,
      red (liftedMap yl R hRaeval s) = p := by
  obtain ⟨u, huhom, hru⟩ := exists_isWeightedHomogeneous_reduction_aeval_eq pres hsmul
    hret hy hp
  exact ⟨Ideal.Quotient.mk (Ideal.span (Set.range R)) u, mk_mem_liftedGrading huhom, hru⟩

variable [Finite σ]

omit [Module A P] [IsScalarTower A k P] [GradedAlgebra 𝒜] [Algebra k Q]
  [IsScalarTower k A Q] in
/-- **Nakayama's small-kernel condition.** A homogeneous element of degree `d` of the lifted
presentation algebra whose image in the special fibre vanishes already lies in the square-zero
ideal times the degree-`d` piece. This is the second hypothesis of
`Deformation.Examples.ProjectiveGradedAlgebra.bijective_of_gradedPresentation`, and it is the
substantive one.

Represent the element by a weighted-homogeneous `u` of degree `d` over the base. Its reduction
lies in the relation ideal of the special fibre, so it is a combination `∑_j g_j F_j`; lifting
the `g_j` arbitrarily, `u` differs from the element `∑_j ĝ_j R_j` of the relation ideal by a
polynomial all of whose coefficients lie in the square-zero ideal. Taking degree-`d`
weighted-homogeneous components keeps the first summand in the relation ideal, because that ideal
is homogeneous, and keeps the second in the square-zero ideal times the homogeneous polynomials
of degree `d`. -/
theorem mem_smul_liftedGrading_of_reduction_eq_zero
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hy : ∀ i, red (yl i) = pres.val i)
    (hRhom : ∀ j, ∃ n, (R j).IsWeightedHomogeneous pres.varDegree n)
    (hRmap : ∀ j, MvPolynomial.map (algebraMap A k) (R j) = pres.relation j)
    (hRaeval : ∀ j, aeval yl (R j) = 0) (d : ℕ) {s : liftedAlgebra R}
    (hs : s ∈ liftedGrading pres.varDegree R d)
    (h0 : red (liftedMap yl R hRaeval s) = 0) :
    s ∈ RingHom.ker (algebraMap A k) • liftedGrading pres.varDegree R d := by
  classical
  have : Fintype σ := Fintype.ofFinite σ
  let : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree) :=
    MvPolynomial.weightedGradedAlgebra A pres.varDegree
  obtain ⟨u, huhom, rfl⟩ := exists_isWeightedHomogeneous_of_mem_liftedGrading hs
  have hval : (fun i ↦ red (yl i)) = pres.val := funext hy
  -- the reduction of `u` is a relation of the special fibre
  have h1 : aeval pres.val (MvPolynomial.map (algebraMap A k) u) = 0 := by
    have hre := reduction_aeval red hsmul yl u
    rw [hval] at hre
    rw [← hre]
    exact h0
  have h2 : MvPolynomial.map (algebraMap A k) u ∈ Ideal.span (Set.range pres.relation) := by
    rw [pres.span_range_relation_eq_ker]
    exact h1
  obtain ⟨g, hg⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp h2
  choose ĝ hĝ using fun j ↦ MvPolynomial.map_surjective (algebraMap A k)
    (SquareZeroRetraction.surjective_algebraMap hret) (g j)
  -- an element of the relation ideal of the lifted presentation with the same reduction as `u`
  have hrmem : ∑ j, ĝ j * R j ∈ Ideal.span (Set.range R) :=
    sum_mem fun j _ ↦ Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  have hmapr : MvPolynomial.map (algebraMap A k) (∑ j, ĝ j * R j) =
      MvPolynomial.map (algebraMap A k) u := by
    rw [map_sum, ← hg]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, hĝ j, hRmap j, smul_eq_mul]
  have hdiff : MvPolynomial.map (algebraMap A k) (u - ∑ j, ĝ j * R j) = 0 := by
    rw [map_sub, hmapr, sub_self]
  have hcoeff : ∀ m, MvPolynomial.coeff m (u - ∑ j, ĝ j * R j) ∈
      RingHom.ker (algebraMap A k) := by
    intro m
    rw [RingHom.mem_ker, ← MvPolynomial.coeff_map, hdiff, MvPolynomial.coeff_zero]
  have hsmall : u - ∑ j, ĝ j * R j ∈
      RingHom.ker (algebraMap A k) • (⊤ : Submodule A (MvPolynomial ι A)) :=
    MvPolynomial.mem_smul_top_of_coeff_mem _ hcoeff
  -- split `u` into its two degree-`d` components
  have hud : u = MvPolynomial.weightedHomogeneousComponent pres.varDegree d
        (∑ j, ĝ j * R j) +
      MvPolynomial.weightedHomogeneousComponent pres.varDegree d (u - ∑ j, ĝ j * R j) := by
    rw [← map_add, show (∑ j, ĝ j * R j) + (u - ∑ j, ĝ j * R j) = u by ring]
    exact (MvPolynomial.weightedHomogeneousComponent_eq_self huhom).symm
  have hIhom : (Ideal.span (Set.range R)).IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree) := by
    refine Ideal.homogeneous_span _ _ ?_
    rintro _ ⟨j, rfl⟩
    obtain ⟨n, hn⟩ := hRhom j
    exact ⟨n, (MvPolynomial.mem_weightedHomogeneousSubmodule A pres.varDegree n _).mpr hn⟩
  have hfirst : MvPolynomial.weightedHomogeneousComponent pres.varDegree d
      (∑ j, ĝ j * R j) ∈ Ideal.span (Set.range R) :=
    MvPolynomial.weightedHomogeneousComponent_mem_of_mem A pres.varDegree hIhom hrmem d
  have hsecond : MvPolynomial.weightedHomogeneousComponent pres.varDegree d
      (u - ∑ j, ĝ j * R j) ∈ RingHom.ker (algebraMap A k) •
        MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree d :=
    MvPolynomial.weightedHomogeneousComponent_mem_smul _ _ _ hsmall
  -- the first component dies in the quotient, the second lands in the right submodule
  have hmapsmul : Submodule.map
      (Ideal.Quotient.mkₐ A (Ideal.span (Set.range R))).toLinearMap
      (RingHom.ker (algebraMap A k) •
        MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree d) =
      RingHom.ker (algebraMap A k) • liftedGrading pres.varDegree R d :=
    Submodule.map_smul'' _ _ _
  rw [hud, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hfirst, zero_add, ← hmapsmul]
  exact Submodule.mem_map_of_mem hsecond

end Nakayama

/-! ### Adjusting the lifts by a prescribed first-order perturbation -/

section Adjust

variable {k : Type w} [CommRing k]
  {A : Type u} [CommRing A] [Algebra k A] [Algebra A k]
  {P : Type v} [CommRing P] [Algebra k P] [Module A P] [IsScalarTower A k P]
  {𝒜 : ℕ → Submodule k P} [GradedAlgebra 𝒜]
  {Q : Type t} [CommRing Q] [Algebra A Q] [Algebra k Q] [IsScalarTower k A Q]
  {𝒬 : ℕ → Submodule A Q} [GradedAlgebra 𝒬] [∀ d, Module.Flat A ↥(𝒬 d)]
  {red : Q →+* P}
  {ι : Type x} {σ : Type y}
  (pres : Algebra.WeightedHomogeneousPresentation k P 𝒜 ι σ) {yl yl₂ : ι → Q}

omit [GradedAlgebra 𝒜] [GradedAlgebra 𝒬] in
/-- The element of the deformation named by an element of `I ⊗[k] 𝒜 d` is homogeneous of
degree `d`: it is the image of an element of the kernel of the degreewise reduction. -/
theorem kerElement_mem
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d)) (d : ℕ)
    (ζ : ↥(RingHom.ker (algebraMap A k)) ⊗[k] ↥(𝒜 d)) :
    kerElement hret hsq hbc d ζ ∈ 𝒬 d :=
  ((SquareZeroRetraction.kerEquiv hret hsq (hbc d) ζ :
    ↥(LinearMap.ker (gradedPiece red hsmul hmem d))) : ↥(𝒬 d)).2

omit [GradedAlgebra 𝒜] [GradedAlgebra 𝒬] in
/-- The element of the deformation named by an element of `I ⊗[k] 𝒜 d` is killed by the
reduction. -/
theorem reduction_kerElement
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d)) (d : ℕ)
    (ζ : ↥(RingHom.ker (algebraMap A k)) ⊗[k] ↥(𝒜 d)) :
    red (kerElement hret hsq hbc d ζ) = 0 :=
  congrArg (fun y : ↥(𝒜 d) ↦ (y : P)) (LinearMap.mem_ker.mp
    (SquareZeroRetraction.kerEquiv hret hsq (hbc d) ζ).2)

omit [GradedAlgebra 𝒜] [GradedAlgebra 𝒬] in
/-- **Perturbing the lifts by a prescribed first-order datum.** Subtracting from each chosen lift
the element of the deformation named by an element of `I ⊗[k] 𝒜 (d i)` gives again a family of
homogeneous lifts of the generators, whose differences from the original family are exactly the
named elements. -/
theorem exists_lifts_sub_kerElement
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i)
    (ξ : ∀ i, ↥(RingHom.ker (algebraMap A k)) ⊗[k] ↥(𝒜 (pres.varDegree i))) :
    ∃ (z : ι → Q) (_ : ∀ i, z i ∈ 𝒬 (pres.varDegree i)) (_ : ∀ i, red (z i) = pres.val i),
      ∀ i, yl i - z i = kerElement hret hsq hbc (pres.varDegree i) (ξ i) := by
  refine ⟨fun i ↦ yl i - kerElement hret hsq hbc (pres.varDegree i) (ξ i),
    fun i ↦ sub_mem (hyd i) (kerElement_mem hsmul hmem hret hsq hbc _ (ξ i)),
    fun i ↦ ?_, fun i ↦ by rw [sub_sub_cancel]⟩
  rw [map_sub, hy i, reduction_kerElement hsmul hmem hret hsq hbc _ (ξ i), sub_zero]

omit [GradedAlgebra 𝒜] [GradedAlgebra 𝒬] in
/-- The first-order part of the difference of two families of lifts is the datum naming that
difference. This is `SquareZeroRetraction.firstOrderPart_eq_of_coe_kerEquiv_eq` with its
characterisation restated as an equation in the deformation. -/
theorem liftDifferenceFirstOrderPart_eq_of_kerElement_eq
    {hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q}
    {hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d}
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    (hyd₂ : ∀ i, yl₂ i ∈ 𝒬 (pres.varDegree i)) (hy₂ : ∀ i, red (yl₂ i) = pres.val i)
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i) (i : ι)
    {ζ : ↥(RingHom.ker (algebraMap A k)) ⊗[k] ↥(𝒜 (pres.varDegree i))}
    (hζ : yl i - yl₂ i = kerElement hret hsq hbc (pres.varDegree i) ζ) :
    liftDifferenceFirstOrderPart pres hret hsq hbc hyd₂ hy₂ hyd hy i = ζ :=
  SquareZeroRetraction.firstOrderPart_eq_of_coe_kerEquiv_eq hret hsq
    (hbc (pres.varDegree i)) _ ζ (Subtype.ext hζ.symm)

variable [Fintype ι]

/-- **The effect on the first-order parts of perturbing the lifts.** If the differences of two
families of homogeneous lifts of the generators are named by a datum `ξ`, then the first-order
parts of the relations at the two families differ by the graded Jacobian applied to `ξ`.

This is `GradedDeformation.relationFirstOrderPart_eq_add_sum` with the first-order parts of the
differences of the lifts identified with the prescribed datum, which is what makes the
perturbation an *input* rather than a quantity read off afterwards. -/
theorem relationFirstOrderPart_eq_sub_sum
    {hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q}
    {hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d}
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    {redₗ : Q →ₗ[A] P} (hredₗ : ∀ q : Q, redₗ q = red q) (hbcQ : IsBaseChange k redₗ)
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i)
    (hyd₂ : ∀ i, yl₂ i ∈ 𝒬 (pres.varDegree i)) (hy₂ : ∀ i, red (yl₂ i) = pres.val i)
    (ξ : ∀ i, ↥(RingHom.ker (algebraMap A k)) ⊗[k] ↥(𝒜 (pres.varDegree i)))
    (hξ : ∀ i, yl i - yl₂ i = kerElement hret hsq hbc (pres.varDegree i) (ξ i)) (j : σ) :
    relationFirstOrderPart (yl := yl₂) pres hret hsq hbc hyd₂ hy₂ j =
      relationFirstOrderPart pres hret hsq hbc hyd hy j -
        ∑ i, LinearMap.lTensor ↥(RingHom.ker (algebraMap A k)) (pderivValPiece pres j i)
          (ξ i) := by
  have hdiff : ∀ i, liftDifferenceFirstOrderPart pres hret hsq hbc hyd₂ hy₂ hyd hy i = ξ i :=
    fun i ↦ liftDifferenceFirstOrderPart_eq_of_kerElement_eq pres hret hsq hbc hyd₂ hy₂ hyd hy
      i (hξ i)
  have hsum := relationFirstOrderPart_eq_add_sum pres hret hsq hbc hredₗ hbcQ hyd₂ hy₂ hyd hy j
  simp only [hdiff] at hsum
  exact (eq_sub_iff_add_eq.mpr hsum.symm)

end Adjust

/-! ### A common family of lifted relations for two deformations -/

section Pair

variable {k : Type w} [CommRing k]
  {A : Type u} [CommRing A] [Algebra k A] [Algebra A k]
  {P : Type v} [CommRing P] [Algebra k P] [Module A P] [IsScalarTower A k P]
  {𝒜 : ℕ → Submodule k P} [GradedAlgebra 𝒜]
  {Q : Type t} [CommRing Q] [Algebra A Q] [Algebra k Q] [IsScalarTower k A Q]
  {𝒬 : ℕ → Submodule A Q} [GradedAlgebra 𝒬] [∀ d, Module.Flat A ↥(𝒬 d)]
  {Q' : Type t₂} [CommRing Q'] [Algebra A Q'] [Algebra k Q'] [IsScalarTower k A Q']
  {𝒬' : ℕ → Submodule A Q'} [GradedAlgebra 𝒬'] [∀ d, Module.Flat A ↥(𝒬' d)]
  {red : Q →+* P} {red' : Q' →+* P}
  {ι : Type x} {σ : Type y}
  (pres : Algebra.WeightedHomogeneousPresentation k P 𝒜 ι σ) {yl : ι → Q} {yl' : ι → Q'}
  {R : σ → MvPolynomial ι A}

omit [Algebra k A] [Module A P] [IsScalarTower A k P] [GradedAlgebra 𝒜] [Algebra k Q]
  [IsScalarTower k A Q] [GradedAlgebra 𝒬] [∀ (d : ℕ), Module.Flat A ↥(𝒬 d)] [Algebra k Q']
  [IsScalarTower k A Q'] [GradedAlgebra 𝒬'] [∀ (d : ℕ), Module.Flat A ↥(𝒬' d)] in
/-- **Two lifted presentations by one algebra agree on the special fibre.** The images in `P` of
an element of a common lifted presentation algebra under the two structural maps coincide: both
are the value at the chosen generators of the polynomial with reduced coefficients. This is the
compatibility which
`Deformation.Examples.ProjectiveGradedAlgebra.nonempty_fiber_iso_of_common_gradedPresentation`
requires of the two presentations. -/
theorem reduction_liftedMap_eq
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hsmul' : ∀ (a : A) (q : Q'), red' (a • q) = algebraMap A k a • red' q)
    (hy : ∀ i, red (yl i) = pres.val i) (hy' : ∀ i, red' (yl' i) = pres.val i)
    (hR : ∀ j, aeval yl (R j) = 0) (hR' : ∀ j, aeval yl' (R j) = 0) (s : liftedAlgebra R) :
    red' (liftedMap yl' R hR' s) = red (liftedMap yl R hR s) := by
  obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective s
  rw [liftedMap_mk, liftedMap_mk, reduction_aeval red' hsmul' yl' u,
    reduction_aeval red hsmul yl u, funext hy, funext hy']

/-- **One polynomial names a first-order part in both deformations at once.** An element of
`I ⊗[k] 𝒜 d` is the value, at the chosen lifts in either of two deformations of `P` over the same
square-zero base, of a single weighted-homogeneous polynomial of degree `d` whose coefficients
lie in the square-zero ideal.

A pure tensor `a ⊗ p` is named by `a · v` for any homogeneous polynomial `v` of degree `d` whose
value reduces to `p` — and whether it does depends only on the reduction of `v`, not on the
deformation in which the value is taken. So one choice of `v` serves both. -/
theorem exists_mem_smul_aeval_eq_pair
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hsmul' : ∀ (a : A) (q : Q'), red' (a • q) = algebraMap A k a • red' q)
    (hmem' : ∀ (d : ℕ) (q : Q'), q ∈ 𝒬' d → red' q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    (hbc' : ∀ d, IsBaseChange k (gradedPiece red' hsmul' hmem' d))
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i)
    (hyd' : ∀ i, yl' i ∈ 𝒬' (pres.varDegree i)) (hy' : ∀ i, red' (yl' i) = pres.val i)
    (d : ℕ) (ζ : ↥(RingHom.ker (algebraMap A k)) ⊗[k] ↥(𝒜 d)) :
    ∃ c ∈ RingHom.ker (algebraMap A k) •
        MvPolynomial.weightedHomogeneousSubmodule A pres.varDegree d,
      aeval yl c = kerElement hret hsq hbc d ζ ∧
        aeval yl' c = kerElement hret hsq hbc' d ζ := by
  induction ζ using TensorProduct.induction_on with
  | zero => exact ⟨0, zero_mem _, by simp, by simp⟩
  | tmul a p =>
      obtain ⟨v, hvhom, hv⟩ := exists_isWeightedHomogeneous_reduction_aeval_eq pres hsmul
        hret hy p.2
      have hvmem : aeval yl v ∈ 𝒬 d :=
        MvPolynomial.aeval_mem_of_isWeightedHomogeneous 𝒬 yl pres.varDegree hyd hvhom
      have hvmem' : aeval yl' v ∈ 𝒬' d :=
        MvPolynomial.aeval_mem_of_isWeightedHomogeneous 𝒬' yl' pres.varDegree hyd' hvhom
      have hbridge : red' (aeval yl' v) = red (aeval yl v) := by
        rw [reduction_aeval red' hsmul' yl' v, reduction_aeval red hsmul yl v, funext hy,
          funext hy']
      have hp1 : (p : ↥(𝒜 d)) = gradedPiece red hsmul hmem d ⟨aeval yl v, hvmem⟩ :=
        Subtype.ext hv.symm
      have hp2 : (p : ↥(𝒜 d)) = gradedPiece red' hsmul' hmem' d ⟨aeval yl' v, hvmem'⟩ :=
        Subtype.ext (hbridge.trans hv).symm
      refine ⟨(a : A) • v, Submodule.smul_mem_smul a.2
        ((MvPolynomial.mem_weightedHomogeneousSubmodule A pres.varDegree d v).mpr hvhom),
        ?_, ?_⟩
      · rw [map_smul, hp1,
          kerElement_tmul_gradedPiece hsmul hmem hret hsq hbc d a ⟨aeval yl v, hvmem⟩]
      · rw [map_smul, hp2,
          kerElement_tmul_gradedPiece hsmul' hmem' hret hsq hbc' d a ⟨aeval yl' v, hvmem'⟩]
  | add ζ ζ' h h' =>
      obtain ⟨c, hc, hce, hce'⟩ := h
      obtain ⟨b, hb, hbe, hbe'⟩ := h'
      exact ⟨c + b, add_mem hc hb, by rw [map_add, hce, hbe, map_add],
        by rw [map_add, hce', hbe', map_add]⟩

/-- **A common family of lifted relations.** If the relations of the presentation have the same
first-order parts at the chosen lifts in two deformations of `P` over the same square-zero base,
then one family of weighted-homogeneous lifts of those relations vanishes at both families of
lifts. The two deformations then share one lifted presentation algebra, which is the hypothesis
of `Deformation.Examples.ProjectiveGradedAlgebra.nonempty_fiber_iso_of_common_gradedPresentation`.

The canonical lift of a relation is the relation itself with coefficients pushed along
`k → A`: its value at lifts is the value of the relation read through the `k`-algebra structure
of the deformation, which is exactly what the first-order part measures. Subtracting the single
polynomial which names that common first-order part in both deformations kills it in both. -/
theorem exists_relationLift_common
    (hsmul : ∀ (a : A) (q : Q), red (a • q) = algebraMap A k a • red q)
    (hmem : ∀ (d : ℕ) (q : Q), q ∈ 𝒬 d → red q ∈ 𝒜 d)
    (hsmul' : ∀ (a : A) (q : Q'), red' (a • q) = algebraMap A k a • red' q)
    (hmem' : ∀ (d : ℕ) (q : Q'), q ∈ 𝒬' d → red' q ∈ 𝒜 d)
    (hret : ∀ r : k, algebraMap A k (algebraMap k A r) = r)
    (hsq : RingHom.ker (algebraMap A k) * RingHom.ker (algebraMap A k) = ⊥)
    (hbc : ∀ d, IsBaseChange k (gradedPiece red hsmul hmem d))
    (hbc' : ∀ d, IsBaseChange k (gradedPiece red' hsmul' hmem' d))
    (hyd : ∀ i, yl i ∈ 𝒬 (pres.varDegree i)) (hy : ∀ i, red (yl i) = pres.val i)
    (hyd' : ∀ i, yl' i ∈ 𝒬' (pres.varDegree i)) (hy' : ∀ i, red' (yl' i) = pres.val i)
    (heq : ∀ j, relationFirstOrderPart pres hret hsq hbc hyd hy j =
      relationFirstOrderPart pres hret hsq hbc' hyd' hy' j) :
    ∃ R : σ → MvPolynomial ι A,
      (∀ j, (R j).IsWeightedHomogeneous pres.varDegree (pres.relDegree j)) ∧
        (∀ j, MvPolynomial.map (algebraMap A k) (R j) = pres.relation j) ∧
          (∀ j, aeval yl (R j) = 0) ∧ ∀ j, aeval yl' (R j) = 0 := by
  have hcomp : (algebraMap A k).comp (algebraMap k A) = RingHom.id k := RingHom.ext hret
  have hstep : ∀ j : σ, ∃ r : MvPolynomial ι A,
      r.IsWeightedHomogeneous pres.varDegree (pres.relDegree j) ∧
        MvPolynomial.map (algebraMap A k) r = pres.relation j ∧
          aeval yl r = 0 ∧ aeval yl' r = 0 := by
    intro j
    have hGhom : (MvPolynomial.map (algebraMap k A) (pres.relation j)).IsWeightedHomogeneous
        pres.varDegree (pres.relDegree j) :=
      (pres.relation_isWeightedHomogeneous j).map _
    have hGmap : MvPolynomial.map (algebraMap A k)
        (MvPolynomial.map (algebraMap k A) (pres.relation j)) = pres.relation j := by
      rw [MvPolynomial.map_map, hcomp, MvPolynomial.map_id]
    obtain ⟨c, hcmem, hce, hce'⟩ := exists_mem_smul_aeval_eq_pair pres hsmul hmem hsmul' hmem'
      hret hsq hbc hbc' hyd hy hyd' hy' (pres.relDegree j)
      (relationFirstOrderPart pres hret hsq hbc hyd hy j)
    obtain ⟨hhom, hmap⟩ := MvPolynomial.isWeightedHomogeneous_sub_map_eq hGhom hcmem
    refine ⟨MvPolynomial.map (algebraMap k A) (pres.relation j) - c, hhom, hmap.trans hGmap, ?_, ?_⟩
    · rw [map_sub, hce, kerElement_relationFirstOrderPart pres hret hsq hbc hyd hy j,
        MvPolynomial.aeval_map_algebraMap A yl (pres.relation j), sub_self]
    · rw [map_sub, hce', heq j,
        kerElement_relationFirstOrderPart pres hret hsq hbc' hyd' hy' j,
        MvPolynomial.aeval_map_algebraMap A yl' (pres.relation j), sub_self]
  choose R hRhom hRmap hRaeval hRaeval' using hstep
  exact ⟨R, hRhom, hRmap, hRaeval, hRaeval'⟩

end Pair

end GradedDeformation

end
