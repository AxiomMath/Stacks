module

public import Mathlib.RingTheory.Smooth.Basic
public import StacksFrontier.Deformation.Examples.Geometric.Rings
public import StacksFrontier.Deformation.Predeformation.Basic
public import StacksFrontier.Deformation.Terminal
public import StacksFrontier.Deformation.VersalObject.MinimalVersalOrbitBijection
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Deformations of a smooth algebra over the dual numbers

A flat deformation of a smooth algebra `P` over a field `k` to the dual numbers `k[ε]` is
isomorphic to the trivial deformation `k[ε] ⊗_k P`, so the tangent space of the deformation
category of `P` vanishes.

## Main definitions

* `Deformation.Examples.trivialDeformationReduction` is the reduction `D ⊗_k P → P` of the
  trivial deformation along an augmentation of `D`.
* `Deformation.Examples.residueAugmentation` is the residue map of a dual-number base, as a
  `k`-algebra map.
* `Deformation.Examples.trivialFlatAlgebra` and
  `Deformation.Examples.trivialFlatAlgebraHom` are the trivial deformation `Aε ⊗_k P` and its
  cartesian reduction to the special fibre.
* `Deformation.Examples.trivialRingDeformation` is the trivial deformation as an object of
  the fibre of the deformation category of `P` over `Aε`.

## Main results

* `Deformation.Examples.isPushout_trivialDeformation`: the trivial deformation is cartesian
  over the augmentation.
* `Deformation.Examples.exists_algEquiv_tensor_of_formallySmooth`: a flat deformation of a
  formally smooth algebra over a dual-number base is isomorphic to the trivial one,
  compatibly with the reduction.
* `Deformation.Examples.nonempty_iso_trivialRingDeformation`: every object of the fibre over
  a dual-number base is isomorphic to the trivial deformation.
* `Deformation.Examples.existsUnique_ringDeformationClass_of_smooth`: the isomorphism classes
  of flat deformations of a smooth algebra over a dual-number base form a single point.
* `Deformation.Examples.existsUnique_ringDeformationClass_artinianDualNumbers_of_smooth`: the
  same statement at the dual-number object of `𝒞_Λ`, so that the tangent space of the
  deformation category of a smooth algebra is zero: **Stacks 0DZL**.

## Implementation notes

A dual-number base is presented by its data: a `k`-algebra structure splitting the residue
map, a linear form `σ` picking out the coefficient of `ε`, and the element `ε` itself,
subject to `ε * ε = 0`, `σ ε = 1`, and the requirement that every element be `a + σ(a) ε`
with `a` the image of its residue. Together these say that the base is `k[ε]` with its
canonical residue identification, and they are discharged for the dual-number object of
`𝒞_Λ` itself: its `k`-algebra structure is the constant inclusion, its `ε`-coefficient and
its `ε` come from the identification with `DualNumber k`, and its residue map is the first
coordinate.

The comparison with the trivial deformation is the algebra map induced by a section of the
reduction, which exists because `P` is formally smooth and the reduction has square-zero
kernel. That the kernel is generated by `ε` and that the comparison is injective both come
from the cartesian square: the first from its universal property applied to the quotient by
`ε`, the second from flatness of the deformation over the base.

## References

* [Stacks Project, Tag 0DZL](https://stacks.math.columbia.edu/tag/0DZL)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing
open scoped TensorProduct

universe u w

namespace Deformation.Examples

/-! ### The comparison with the trivial deformation, at the level of rings -/

section Rings



variable {k P D Q : Type w} [Field k] [CommRing P] [Algebra k P]
  [CommRing D] [CommRing Q] [Algebra k Q] [Algebra D Q]

/-- The kernel of the reduction of a deformation over a square-zero base has square zero:
if every element of the kernel is a multiple of the image of `ε` and `ε * ε = 0`, then the
square of the kernel vanishes. -/
public theorem sq_ker_eq_bot_of_mem_eps_mul (π : Q →ₐ[k] P) (ε : D) (hε : ε * ε = 0)
    (hker : ∀ q : Q, π q = 0 → ∃ q' : Q, q = algebraMap D Q ε * q') :
    (RingHom.ker (π : Q →+* P)) ^ 2 = ⊥ := by
  rw [pow_two, ← le_bot_iff, Ideal.mul_le]
  intro a ha b hb
  obtain ⟨a', rfl⟩ := hker a (RingHom.mem_ker.mp ha)
  obtain ⟨b', rfl⟩ := hker b (RingHom.mem_ker.mp hb)
  have h0 : (algebraMap D Q ε) * (algebraMap D Q ε) = 0 := by
    rw [← map_mul, hε, map_zero]
  simp only [Ideal.mem_bot]
  rw [show algebraMap D Q ε * a' * (algebraMap D Q ε * b')
      = (algebraMap D Q ε * algebraMap D Q ε) * (a' * b') by ring, h0, zero_mul]

variable [Algebra k D]

/-- The reduction of the trivial deformation `D ⊗[k] P` of `P` along an augmentation
`aug : D → k`: it carries `d ⊗ p` to `aug d · p`. -/
public noncomputable def trivialDeformationReduction (aug : D →ₐ[k] k) : (D ⊗[k] P) →ₐ[k] P :=
  Algebra.TensorProduct.lift ((Algebra.ofId k P).comp aug) (AlgHom.id k P)
    (fun _ _ => Commute.all _ _)

/-- The reduction of the trivial deformation on a pure tensor. -/
public theorem trivialDeformationReduction_tmul (aug : D →ₐ[k] k) (d : D) (p : P) :
    trivialDeformationReduction (P := P) aug (d ⊗ₜ[k] p) = algebraMap k P (aug d) * p := by
  simp [trivialDeformationReduction]

private noncomputable def sndPart (σ : D →ₗ[k] k) : (D ⊗[k] P) →ₗ[k] P :=
  TensorProduct.lift (((Algebra.linearMap k P).comp σ).smulRight (1 : P →ₗ[k] P))

private theorem sndPart_tmul (σ : D →ₗ[k] k) (d : D) (p : P) :
    sndPart (P := P) σ (d ⊗ₜ[k] p) = algebraMap k P (σ d) * p := by
  simp [sndPart, Algebra.smul_def]

private theorem tmul_decomp (aug : D →ₐ[k] k) (σ : D →ₗ[k] k) (ε : D)
    (hD : ∀ d : D, algebraMap k D (aug d) + σ d • ε = d) (x : D ⊗[k] P) :
    (1 : D) ⊗ₜ[k] (trivialDeformationReduction aug x) + ε ⊗ₜ[k] (sndPart σ x) = x := by
  induction x with
  | tmul d p =>
      rw [trivialDeformationReduction_tmul, sndPart_tmul, ← Algebra.smul_def, ← Algebra.smul_def,
        ← TensorProduct.smul_tmul, ← TensorProduct.smul_tmul,
        show (aug d) • (1 : D) = algebraMap k D (aug d) by rw [Algebra.smul_def, mul_one],
        ← TensorProduct.add_tmul, hD d]
  | add x y hx hy =>
      rw [map_add, map_add, TensorProduct.tmul_add, TensorProduct.tmul_add]
      conv_rhs => rw [← hx, ← hy]
      ring




/-- For a flat algebra over a dual-number base, multiplication by the image of `ε` is
injective on the special fibre: an element annihilated by the image of `ε` reduces to zero.
This is the one place where flatness of the deformation is used. -/
public theorem reduction_eq_zero_of_eps_mul_eq_zero (aug : D →ₐ[k] k) (σ : D →ₗ[k] k) (ε : D)
    (hε : ε * ε = 0) (hσε : σ ε = 1)
    (hD : ∀ d : D, algebraMap k D (aug d) + σ d • ε = d)
    [Module.Flat D Q]
    (π : Q →ₐ[k] P)
    (haug : ∀ d : D, π (algebraMap D Q d) = algebraMap k P (aug d))
    (q : Q) (hq : algebraMap D Q ε * q = 0) : π q = 0 := by
  let _ : Algebra D k := aug.toRingHom.toAlgebra
  let _ : Algebra D P := ((algebraMap k P).comp aug.toRingHom).toAlgebra
  have _ : IsScalarTower D k k := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have _ : IsScalarTower D k P := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hsmul (d : D) (c : k) : d • c = aug d * c := rfl
  let ι : k →ₗ[D] D :=
    { toFun := fun c => algebraMap k D c * ε
      map_add' := fun a b => by rw [map_add, add_mul]
      map_smul' := fun d c => by
        rw [hsmul, map_mul]
        show _ = d * (algebraMap k D c * ε)
        conv_rhs => rw [← hD d]
        rw [add_mul,
          show (σ d • ε) * (algebraMap k D c * ε)
            = σ d • (algebraMap k D c * (ε * ε)) by rw [smul_mul_assoc]; ring_nf,
          hε, mul_zero, smul_zero, add_zero, mul_assoc] }
  have hι : Function.Injective ι := by
    intro a b hab
    have h : ∀ c : k, σ (ι c) = c := fun c => by
      show σ (algebraMap k D c * ε) = c
      rw [← Algebra.smul_def, map_smul, hσε, smul_eq_mul, mul_one]
    rw [← h a, ← h b, hab]
  have hinjT : Function.Injective (LinearMap.rTensor Q ι) :=
    Module.Flat.rTensor_preserves_injective_linearMap ι hι
  let πD : Q →ₐ[D] P :=
    { π.toRingHom with commutes' := fun d => haug d }
  let ψ' : k ⊗[D] P →ₐ[k] P :=
    Algebra.TensorProduct.lift (Algebra.ofId k P) (AlgHom.id D P)
      (fun _ _ => Commute.all _ _)
  let ψ : k ⊗[D] Q →ₗ[D] P :=
    (ψ'.toLinearMap.restrictScalars D).comp (LinearMap.lTensor k πD.toLinearMap)
  have hzero : ((1 : k) ⊗ₜ[D] q) = 0 := by
    apply hinjT
    rw [map_zero, LinearMap.rTensor_tmul]
    have h1 : ι (1 : k) = ε := by
      show algebraMap k D 1 * ε = ε
      rw [map_one, one_mul]
    rw [h1]
    apply (TensorProduct.lid D Q).injective
    rw [map_zero, TensorProduct.lid_tmul, Algebra.smul_def, hq]
  have := congrArg ψ hzero
  rw [map_zero] at this
  rw [← this]
  show π q = ψ' ((1 : k) ⊗ₜ[D] πD q)
  rw [Algebra.TensorProduct.lift_tmul]
  simp [πD]




variable [IsScalarTower k D Q]

private theorem exists_algEquiv (aug : D →ₐ[k] k) (σ : D →ₗ[k] k) (ε : D)
    (hε : ε * ε = 0) (hσε : σ ε = 1)
    (hD : ∀ d : D, algebraMap k D (aug d) + σ d • ε = d)
    [Algebra.FormallySmooth k P] [Module.Flat D Q]
    (π : Q →ₐ[k] P) (hsurj : Function.Surjective π)
    (haug : ∀ d : D, π (algebraMap D Q d) = algebraMap k P (aug d))
    (hker : ∀ q : Q, π q = 0 → ∃ q' : Q, q = algebraMap D Q ε * q') :
    ∃ φ : (D ⊗[k] P) ≃ₐ[D] Q, ∀ x, π (φ x) = trivialDeformationReduction aug x := by
  have hnil : IsNilpotent (RingHom.ker (π : Q →+* P)) :=
    ⟨2, sq_ker_eq_bot_of_mem_eps_mul π ε hε hker⟩
  let s : P →ₐ[k] Q :=
    Algebra.FormallySmooth.liftOfSurjective (AlgHom.id k P) π hsurj hnil
  have hs : ∀ p, π (s p) = p := fun p =>
    Algebra.FormallySmooth.liftOfSurjective_apply (AlgHom.id k P) π hsurj hnil p
  have hεQ : algebraMap D Q ε * algebraMap D Q ε = 0 := by
    rw [← map_mul, hε, map_zero]
  let φ : (D ⊗[k] P) →ₐ[D] Q :=
    Algebra.TensorProduct.lift (Algebra.ofId D Q) s (fun _ _ => Commute.all _ _)
  have hφ_tmul : ∀ (d : D) (p : P), φ (d ⊗ₜ[k] p) = algebraMap D Q d * s p := fun d p => by
    simp [φ, Algebra.ofId]
  have hcomp : ∀ x, π (φ x) = trivialDeformationReduction aug x := by
    intro x
    induction x with
    | tmul d p => rw [hφ_tmul, map_mul, haug, hs, trivialDeformationReduction_tmul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  have hsurjφ : Function.Surjective φ := by
    intro q
    obtain ⟨q', hq'⟩ := hker (q - s (π q)) (by rw [map_sub, hs, sub_self])
    obtain ⟨q'', hq''⟩ := hker (q' - s (π q')) (by rw [map_sub, hs, sub_self])
    refine ⟨(1 : D) ⊗ₜ[k] (π q) + ε ⊗ₜ[k] (π q'), ?_⟩
    rw [map_add, hφ_tmul, hφ_tmul, map_one, one_mul]
    linear_combination -hq' - algebraMap D Q ε * hq'' - q'' * hεQ
  have hinjφ : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have h1 : trivialDeformationReduction aug x = 0 := by rw [← hcomp x, hx, map_zero]
    have h2 : ε ⊗ₜ[k] (sndPart σ x) = x := by
      have := tmul_decomp (P := P) aug σ ε hD x
      rwa [h1, TensorProduct.tmul_zero, zero_add] at this
    have h3 : algebraMap D Q ε * s (sndPart σ x) = 0 := by
      rw [← hφ_tmul, h2, hx]
    have h4 : sndPart σ x = 0 := by
      rw [← hs (sndPart σ x)]
      exact reduction_eq_zero_of_eps_mul_eq_zero aug σ ε hε hσε hD π haug _ h3
    rw [← h2, h4, TensorProduct.tmul_zero]
  exact ⟨AlgEquiv.ofBijective φ ⟨hinjφ, hsurjφ⟩, hcomp⟩


end Rings

/-! ### Dual-number bases and the trivial deformation -/

section Category

variable {Λ : Type u} {k P : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
  [CommRing P] [Algebra k P]
variable {Aε : ArtinianLocalAlgCat.{u, w, w} Λ k} [Algebra k Aε]

/-- The residue-field object of the deformation category of `P` is terminal in `𝒞_Λ`. -/
public def isTerminal_residueFieldAlgebra_base (P : Type w) [CommRing P] [Algebra k P] :
    IsTerminal ((residueFieldAlgebra (Λ := Λ) (k := k) P).base) :=
  ArtinianLocalAlgCat.isTerminal_of_algEquiv _ AlgEquiv.refl

/-- The residue map of an Artinian local algebra whose residue identification is split by
a `k`-algebra structure, as a `k`-algebra map to the residue field. -/
@[sga "3 VIIB 5.2.6" "special case"]
public def residueAugmentation
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c) :
    (Aε : Type w) →ₐ[k] k where
  toFun a := Aε.residueEquiv (residue Aε a)
  map_one' := by simp
  map_mul' a b := by simp
  map_zero' := by simp
  map_add' a b := by simp
  commutes' c := hsec c

/-- The residue augmentation of a dual-number base splits its `k`-algebra structure. -/
public theorem residueAugmentation_algebraMap
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c) (c : k) :
    residueAugmentation (Aε := Aε) hsec (algebraMap k Aε c) = c := hsec c

/-- The underlying flat algebra of the trivial deformation of `P` over a base `Aε`. -/
public def trivialFlatAlgebra (Aε : ArtinianLocalAlgCat.{u, w, w} Λ k) [Algebra k Aε]
    (P : Type w) [CommRing P] [Algebra k P] : FlatAlgebraCategory.{u, w} Λ k where
  base := Aε
  fiber := (Aε : Type w) ⊗[k] P
  flat := Module.Flat.baseChange k Aε P

variable [IsScalarTower Λ k Aε]

/-- On a cocone over the span, the image of a pure tensor `d ⊗ 1` is the image of the
augmentation of `d`. -/
private theorem cocone_tmul_one
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c)
    (s : PushoutCocone (CommRingCat.ofHom (algebraMap (Aε : Type w) ((Aε : Type w) ⊗[k] P)))
      (CommRingCat.ofHom
        ((residueAugmentation (Aε := Aε) hsec).restrictScalars Λ).toRingHom))
    (d : (Aε : Type w)) :
    s.inl.hom (d ⊗ₜ[k] (1 : P)) = s.inr.hom (residueAugmentation hsec d) := by
  exact congr($(s.condition).hom d)

/-- On a cocone over the span, the image of a constant pure tensor is the image of the
constant. -/
private theorem cocone_one_tmul_algebraMap
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c)
    (s : PushoutCocone (CommRingCat.ofHom (algebraMap (Aε : Type w) ((Aε : Type w) ⊗[k] P)))
      (CommRingCat.ofHom
        ((residueAugmentation (Aε := Aε) hsec).restrictScalars Λ).toRingHom))
    (c : k) :
    s.inl.hom ((1 : (Aε : Type w)) ⊗ₜ[k] (algebraMap k P c)) = s.inr.hom c := by
  have h1 : ((1 : (Aε : Type w)) ⊗ₜ[k] (algebraMap k P c)) =
      (algebraMap k (Aε : Type w) c) ⊗ₜ[k] (1 : P) := by
    rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
      TensorProduct.tmul_smul, TensorProduct.smul_tmul]
    exact (TensorProduct.tmul_smul c (1 : (Aε : Type w)) (1 : P)).symm
  rw [h1, cocone_tmul_one hsec s, residueAugmentation_algebraMap hsec c]

/-- The augmentation of a dual-number base to the residue field, as a morphism of
Artinian local algebras with residue field `k`. -/
@[sga "3 VIIB 5.2.6" "special case"]
public def residueAugmentationHom
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c) :
    Aε ⟶ (residueFieldAlgebra (Λ := Λ) (k := k) P).base where
  hom := (residueAugmentation hsec).restrictScalars Λ
  isLocal := by
    refine ⟨fun a ha => ?_⟩
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hmem
    have hr : residue Aε a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    have h0 : residueAugmentation hsec a = 0 := by
      change Aε.residueEquiv (residue Aε a) = 0
      rw [hr, map_zero]
    exact ha.ne_zero h0
  residue_comm _ := rfl

/-- The dual-number base, the trivial deformation, the residue field and the special
fibre form a pushout square of commutative rings: the trivial deformation is cartesian
over the augmentation. -/
public theorem isPushout_trivialDeformation (P : Type w) [CommRing P] [Algebra k P]
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c) :
    IsPushout (CommRingCat.ofHom (algebraMap (Aε : Type w) ((Aε : Type w) ⊗[k] P)))
      (CommRingCat.ofHom
        ((residueAugmentation (Aε := Aε) hsec).restrictScalars Λ).toRingHom)
      (CommRingCat.ofHom (trivialDeformationReduction (D := (Aε : Type w)) (P := P)
        (residueAugmentation hsec)).toRingHom)
      (CommRingCat.ofHom (algebraMap k P)) := by
  have hw : ∀ d : (Aε : Type w),
      trivialDeformationReduction (P := P) (residueAugmentation hsec) (d ⊗ₜ[k] (1 : P)) =
        algebraMap k P (residueAugmentation hsec d) := fun d => by
    rw [trivialDeformationReduction_tmul, mul_one]
  refine IsPushout.of_isColimit'
    (CommSq.mk (CommRingCat.hom_ext (RingHom.ext fun d => hw d)))
    (PushoutCocone.IsColimit.mk _
      (fun s => CommRingCat.ofHom (s.inl.hom.comp
        (Algebra.TensorProduct.includeRight : P →ₐ[k] (Aε : Type w) ⊗[k] P).toRingHom))
      ?_ ?_ ?_)
  · intro s
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    show s.inl.hom ((1 : (Aε : Type w)) ⊗ₜ[k]
      (trivialDeformationReduction (residueAugmentation hsec) x)) = s.inl.hom x
    induction x using TensorProduct.inductionOn with
    | tmul d p =>
        rw [trivialDeformationReduction_tmul,
          show ((1 : (Aε : Type w)) ⊗ₜ[k]
              (algebraMap k P (residueAugmentation hsec d) * p)) =
            ((1 : (Aε : Type w)) ⊗ₜ[k] (algebraMap k P (residueAugmentation hsec d))) *
              ((1 : (Aε : Type w)) ⊗ₜ[k] p) by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul],
          map_mul, cocone_one_tmul_algebraMap hsec s,
          show (d ⊗ₜ[k] p) = (d ⊗ₜ[k] (1 : P)) * ((1 : (Aε : Type w)) ⊗ₜ[k] p) by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul],
          map_mul, cocone_tmul_one hsec s]
    | add x y hx hy => rw [map_add, TensorProduct.tmul_add, map_add, map_add, hx, hy]
  · exact fun s => CommRingCat.hom_ext (RingHom.ext (cocone_one_tmul_algebraMap hsec s))
  · intro s m hm _
    refine CommRingCat.hom_ext (RingHom.ext fun p => ?_)
    have h : m.hom (trivialDeformationReduction (residueAugmentation hsec)
        ((1 : (Aε : Type w)) ⊗ₜ[k] p)) = s.inl.hom ((1 : (Aε : Type w)) ⊗ₜ[k] p) :=
      congr($(hm).hom ((1 : (Aε : Type w)) ⊗ₜ[k] p))
    rw [trivialDeformationReduction_tmul, map_one, map_one, one_mul] at h
    exact h

/-- The reduction of the trivial deformation to the special fibre, as a morphism of flat
algebras over Artinian local bases. -/
public def trivialFlatAlgebraHom
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c) :
    trivialFlatAlgebra Aε P ⟶ residueFieldAlgebra (Λ := Λ) (k := k) P where
  base := residueAugmentationHom (Aε := Aε) (P := P) hsec
  map := CommRingCat.ofHom
    (trivialDeformationReduction (D := (Aε : Type w)) (P := P)
      (residueAugmentation hsec)).toRingHom
  cartesian := isPushout_trivialDeformation P hsec

/-- The trivial deformation of `P` over a dual-number base, as an object of the fibre of
the deformation category of `P` over that base. -/
public def trivialRingDeformation
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c) :
    (objectsOverFunctor (FlatAlgebraCategory.projection (Λ := Λ) (k := k))
      (residueFieldAlgebra (Λ := Λ) (k := k) P)).Fiber Aε :=
  ⟨Over.mk (trivialFlatAlgebraHom (P := P) hsec), rfl⟩

/-! ### A flat deformation over a dual-number base is trivial -/

variable (σ : (Aε : Type w) →ₗ[k] k) (ε : (Aε : Type w))

/-- In a deformation over a dual-number base that is cartesian over the augmentation, the
kernel of the reduction to the special fibre is generated by the image of `ε`. -/
private theorem exists_eq_eps_mul_of_isPushout
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c)
    (hD : ∀ a : (Aε : Type w),
      algebraMap k Aε (Aε.residueEquiv (residue Aε a)) + σ a • ε = a)
    (Q : Type w) [CommRing Q] [Algebra (Aε : Type w) Q] (π : Q →+* P)
    (hcart : IsPushout (CommRingCat.ofHom (algebraMap (Aε : Type w) Q))
      (CommRingCat.ofHom
        ((residueAugmentation (Aε := Aε) hsec).restrictScalars Λ).toRingHom)
      (CommRingCat.ofHom π) (CommRingCat.ofHom (algebraMap k P)))
    (q : Q) (hq : π q = 0) :
    ∃ q' : Q, q = algebraMap (Aε : Type w) Q ε * q' := by
  have hmem : ∀ d : (Aε : Type w),
      (Ideal.Quotient.mk (Ideal.span {algebraMap (Aε : Type w) Q ε}))
          (algebraMap (Aε : Type w) Q d) =
        ((Ideal.Quotient.mk (Ideal.span {algebraMap (Aε : Type w) Q ε})).comp
          ((algebraMap (Aε : Type w) Q).comp (algebraMap k Aε)))
          (residueAugmentation hsec d) := by
    intro d
    have hd : algebraMap (Aε : Type w) Q d =
        algebraMap (Aε : Type w) Q (algebraMap k Aε (residueAugmentation hsec d))
          + algebraMap (Aε : Type w) Q (algebraMap k Aε (σ d)) *
            algebraMap (Aε : Type w) Q ε := by
      conv_lhs => rw [← hD d]
      rw [map_add, Algebra.smul_def, map_mul]
      rfl
    show Ideal.Quotient.mk _ (algebraMap (Aε : Type w) Q d) =
      Ideal.Quotient.mk _
        (algebraMap (Aε : Type w) Q (algebraMap k Aε (residueAugmentation hsec d)))
    rw [hd, map_add, Ideal.Quotient.eq_zero_iff_mem.2
      (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)), add_zero]
  have hdesc := hcart.inl_desc
    (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap (Aε : Type w) Q ε})))
    (CommRingCat.ofHom
      ((Ideal.Quotient.mk (Ideal.span {algebraMap (Aε : Type w) Q ε})).comp
        ((algebraMap (Aε : Type w) Q).comp (algebraMap k Aε))))
    (CommRingCat.hom_ext (RingHom.ext hmem))
  have h := congr($(hdesc).hom q)
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_ofHom] at h
  rw [hq, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem] at h
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 h
  exact ⟨a, by rw [← ha, mul_comm]⟩

/-- A flat deformation of a formally smooth algebra over a dual-number base, cartesian
over the augmentation, is isomorphic to the trivial deformation, compatibly with the
reduction to the special fibre. -/
public theorem exists_algEquiv_tensor_of_formallySmooth [Algebra.FormallySmooth k P]
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c)
    (hε : ε * ε = 0) (hσε : σ ε = 1)
    (hD : ∀ a : (Aε : Type w),
      algebraMap k Aε (Aε.residueEquiv (residue Aε a)) + σ a • ε = a)
    (Q : Type w) [CommRing Q] [Algebra (Aε : Type w) Q] [Module.Flat (Aε : Type w) Q]
    (π : Q →+* P)
    (hcart : IsPushout (CommRingCat.ofHom (algebraMap (Aε : Type w) Q))
      (CommRingCat.ofHom
        ((residueAugmentation (Aε := Aε) hsec).restrictScalars Λ).toRingHom)
      (CommRingCat.ofHom π) (CommRingCat.ofHom (algebraMap k P))) :
    ∃ φ : ((Aε : Type w) ⊗[k] P) ≃ₐ[(Aε : Type w)] Q,
      ∀ x, π (φ x) = trivialDeformationReduction (residueAugmentation hsec) x := by
  let _ : Algebra k Q := ((algebraMap (Aε : Type w) Q).comp (algebraMap k Aε)).toAlgebra
  have _ : IsScalarTower k (Aε : Type w) Q := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have haug : ∀ d : (Aε : Type w),
      π (algebraMap (Aε : Type w) Q d) = algebraMap k P (residueAugmentation hsec d) := by
    intro d
    exact congr($(hcart.w).hom d)
  have hπk : ∀ c : k, π (algebraMap k Q c) = algebraMap k P c := by
    intro c
    show π (algebraMap (Aε : Type w) Q (algebraMap k Aε c)) = algebraMap k P c
    rw [haug, residueAugmentation_algebraMap hsec c]
  have hsurj : Function.Surjective π := by
    have h1 := CommRingCat.closure_range_union_range_eq_top_of_isPushout hcart
    simp only [CommRingCat.hom_ofHom] at h1
    have hsub : Set.range (algebraMap k P) ⊆ Set.range π := by
      rintro _ ⟨c, rfl⟩
      exact ⟨algebraMap k Q c, hπk c⟩
    rw [Set.union_eq_self_of_subset_right hsub] at h1
    intro x
    have hx : x ∈ Subring.closure (Set.range π) := h1 ▸ Subring.mem_top x
    rwa [show Set.range π = ((π.range : Subring P) : Set P) from rfl, Subring.closure_eq,
      RingHom.mem_range] at hx
  exact exists_algEquiv (D := (Aε : Type w)) (Q := Q) (residueAugmentation hsec) σ ε hε hσε
    (fun d => hD d) { π with commutes' := hπk } hsurj haug
    (exists_eq_eps_mul_of_isPushout σ ε hsec hD Q π hcart)

/-- A square whose vertical leg is an identity and whose horizontal leg is an algebra
isomorphism is a pushout square. -/
private theorem isPushout_of_algEquiv {R A B : Type w} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (φ : A ≃ₐ[R] B) :
    IsPushout (CommRingCat.ofHom (algebraMap R A)) (𝟙 (CommRingCat.of R))
      (CommRingCat.ofHom φ.toAlgHom.toRingHom) (CommRingCat.ofHom (algebraMap R B)) := by
  refine IsPushout.of_isColimit'
    (CommSq.mk (CommRingCat.hom_ext (RingHom.ext fun r => ?_)))
    (PushoutCocone.IsColimit.mk _
      (fun s => CommRingCat.ofHom (s.inl.hom.comp (φ.symm : B →+* A))) ?_ ?_ ?_)
  · exact φ.commutes r
  · intro s
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    show s.inl.hom (φ.symm (φ x)) = s.inl.hom x
    rw [φ.symm_apply_apply]
  · intro s
    refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
    show s.inl.hom (φ.symm (algebraMap R B r)) = s.inr.hom r
    rw [show φ.symm (algebraMap R B r) = algebraMap R A r from φ.symm.commutes r]
    exact congr($(s.condition).hom r)
  · intro s m hm _
    refine CommRingCat.hom_ext (RingHom.ext fun y => ?_)
    have h : m.hom (φ (φ.symm y)) = s.inl.hom (φ.symm y) := congr($(hm).hom (φ.symm y))
    rwa [φ.apply_symm_apply] at h

private def trivialFlatAlgebraIsoOfAlgEquiv (X : FlatAlgebraCategory.{u, w} Λ k)
    [Algebra k X.base] (φ : ((X.base : Type w) ⊗[k] P) ≃ₐ[(X.base : Type w)] X.fiber) :
    trivialFlatAlgebra X.base P ≅ X where
  hom :=
    { base := 𝟙 _
      map := CommRingCat.ofHom φ.toAlgHom.toRingHom
      cartesian := by
        change IsPushout (CommRingCat.ofHom (algebraMap (X.base : Type w)
            ((X.base : Type w) ⊗[k] P)))
          (𝟙 (CommRingCat.of (X.base : Type w)))
          (CommRingCat.ofHom φ.toAlgHom.toRingHom)
          (CommRingCat.ofHom (algebraMap (X.base : Type w) X.fiber))
        exact isPushout_of_algEquiv φ }
  inv :=
    { base := 𝟙 _
      map := CommRingCat.ofHom φ.symm.toAlgHom.toRingHom
      cartesian := by
        change IsPushout (CommRingCat.ofHom (algebraMap (X.base : Type w) X.fiber))
          (𝟙 (CommRingCat.of (X.base : Type w)))
          (CommRingCat.ofHom φ.symm.toAlgHom.toRingHom)
          (CommRingCat.ofHom (algebraMap (X.base : Type w) ((X.base : Type w) ⊗[k] P)))
        exact isPushout_of_algEquiv φ.symm }
  hom_inv_id := FlatAlgebraCategory.Hom.ext (Category.id_comp _)
    (CommRingCat.hom_ext (RingHom.ext fun x => φ.symm_apply_apply x))
  inv_hom_id := FlatAlgebraCategory.Hom.ext (Category.id_comp _)
    (CommRingCat.hom_ext (RingHom.ext fun y => φ.apply_symm_apply y))

/-- Every flat deformation of a formally smooth algebra over a dual-number base is
isomorphic, in the fibre of the deformation category, to the trivial deformation. -/
public theorem nonempty_iso_trivialRingDeformation [Algebra.FormallySmooth k P]
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c)
    (hε : ε * ε = 0) (hσε : σ ε = 1)
    (hD : ∀ a : (Aε : Type w),
      algebraMap k Aε (Aε.residueEquiv (residue Aε a)) + σ a • ε = a)
    (X : (objectsOverFunctor (FlatAlgebraCategory.projection (Λ := Λ) (k := k))
      (residueFieldAlgebra (Λ := Λ) (k := k) P)).Fiber Aε) :
    Nonempty (X ≅ trivialRingDeformation (P := P) hsec) := by
  obtain ⟨Z, hZ0⟩ := X
  have hZ : Z.left.base = Aε := hZ0
  subst hZ
  have hbase : Z.hom.base = residueAugmentationHom (P := P) hsec :=
    (isTerminal_residueFieldAlgebra_base P).hom_ext _ _
  obtain ⟨φ, hφ⟩ := exists_algEquiv_tensor_of_formallySmooth
    (P := P) (Aε := Z.left.base) σ ε hsec hε hσε hD Z.left.fiber
    (Z.hom.map.hom : Z.left.fiber →+* P)
    (by
      have hc := Z.hom.cartesian
      rw [hbase] at hc
      exact hc)
  let eF := trivialFlatAlgebraIsoOfAlgEquiv Z.left φ
  have hwtri : eF.hom ≫ Z.hom = trivialFlatAlgebraHom (P := P) hsec := by
    refine FlatAlgebraCategory.Hom.ext ?_ (CommRingCat.hom_ext (RingHom.ext fun x => hφ x))
    show 𝟙 _ ≫ Z.hom.base = residueAugmentationHom (P := P) hsec
    exact (Category.id_comp _).trans hbase
  have hw : eF.inv ≫ trivialFlatAlgebraHom (P := P) hsec = Z.hom := by
    rw [← hwtri]
    rw [eF.inv_hom_id_assoc]
  let eO : Z ≅ Over.mk (trivialFlatAlgebraHom (P := P) hsec) := Over.isoMk eF.symm hw
  refine ⟨{ hom := ⟨eO.hom, ?_⟩, inv := ⟨eO.inv, ?_⟩, hom_inv_id := ?_, inv_hom_id := ?_ }⟩
  · have h : (objectsOverFunctor (FlatAlgebraCategory.projection (Λ := Λ) (k := k))
        (residueFieldAlgebra (Λ := Λ) (k := k) P)).map eO.hom = 𝟙 Z.left.base := rfl
    exact h ▸ Functor.IsHomLift.map eO.hom
  · have h : (objectsOverFunctor (FlatAlgebraCategory.projection (Λ := Λ) (k := k))
        (residueFieldAlgebra (Λ := Λ) (k := k) P)).map eO.inv = 𝟙 Z.left.base := rfl
    exact h ▸ Functor.IsHomLift.map eO.inv
  · exact Subtype.ext eO.hom_inv_id
  · exact Subtype.ext eO.inv_hom_id

/-- **Stacks 0DZL.** The tangent space of the deformation category of a smooth algebra
`P` over a field `k` is zero: the flat deformations of `P` over the dual numbers form a
single isomorphism class, that of the trivial deformation. -/
public theorem existsUnique_ringDeformationClass_of_smooth [Algebra.Smooth k P]
    (hsec : ∀ c : k, Aε.residueEquiv (residue Aε (algebraMap k Aε c)) = c)
    (hε : ε * ε = 0) (hσε : σ ε = 1)
    (hD : ∀ a : (Aε : Type w),
      algebraMap k Aε (Aε.residueEquiv (residue Aε a)) + σ a • ε = a) :
    ∃ x : Quotient (isIsomorphicSetoid
        ((objectsOverFunctor (FlatAlgebraCategory.projection (Λ := Λ) (k := k))
          (residueFieldAlgebra (Λ := Λ) (k := k) P)).Fiber Aε)),
      ∀ y, y = x := by
  have _ : Algebra.FormallySmooth k P := Algebra.Smooth.formallySmooth
  refine ⟨Quotient.mk _ (trivialRingDeformation (P := P) hsec), ?_⟩
  refine Quotient.ind fun X => ?_
  exact Quotient.sound (nonempty_iso_trivialRingDeformation σ ε hsec hε hσε hD X)

end Category




/-! ### The dual-number object of `𝒞_Λ` -/

section DualNumbers

variable {Λ : Type u} {k P : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
  [CommRing P] [Algebra k P]

/-- The dual-number object of `𝒞_Λ` is a `k`-algebra through the constant inclusion. -/
noncomputable local instance algebraArtinianDualNumbers :
    Algebra k (artinianDualNumbers.{u, w, w} Λ k : Type w) :=
  ((dualNumbersUp.{u, w, w} (Λ := Λ) (k := k)).toRingHom.comp
    (TrivSqZeroExt.inlHom k k)).toAlgebra

private theorem algebraMap_artinianDualNumbers (c : k) :
    algebraMap k (artinianDualNumbers.{u, w, w} Λ k : Type w) c =
      dualNumbersUp.{u, w, w} (Λ := Λ) (k := k) (TrivSqZeroExt.inl c) := rfl

private theorem dualNumbersEquiv_dualNumbersUp (y : DualNumber k) :
    dualNumbersEquiv.{u, w, w} (Λ := Λ) (k := k)
      (dualNumbersUp.{u, w, w} (Λ := Λ) (k := k) y) = y :=
  (AlgEquiv.ofBijective _ dualNumbersUp_bijective.{u, w, w}).symm_apply_apply y

/-- The constant inclusion splits the residue identification of the dual-number object. -/
private theorem residueEquiv_residue_algebraMap_artinianDualNumbers (c : k) :
    (artinianDualNumbers.{u, w, w} Λ k).residueEquiv
      (residue (artinianDualNumbers.{u, w, w} Λ k : Type w)
        (algebraMap k (artinianDualNumbers.{u, w, w} Λ k : Type w) c)) = c :=
  (squareZeroExtensionArtinian_residue Λ k (FGModuleCat.of k (ULift.{w} k)) _).trans
    (dualNumbersUp_fst.{u, w, w} (Λ := Λ) (k := k) (TrivSqZeroExt.inl c))

/-- The `k`-algebra structure of the dual-number object is compatible with its
`Λ`-algebra structure. -/
private theorem isScalarTower_artinianDualNumbers :
    IsScalarTower Λ k (artinianDualNumbers.{u, w, w} Λ k : Type w) := by
  refine IsScalarTower.of_algebraMap_eq fun l => ?_
  rw [algebraMap_artinianDualNumbers,
    show TrivSqZeroExt.inl (algebraMap Λ k l) = algebraMap Λ (DualNumber k) l from
      (TrivSqZeroExt.algebraMap_eq_inl' ..).symm]
  exact ((dualNumbersUp.{u, w, w} (Λ := Λ) (k := k)).commutes l).symm

attribute [local instance] isScalarTower_artinianDualNumbers

/-- The coefficient of `ε` on the dual-number object of `𝒞_Λ`. -/
private noncomputable def artinianDualNumbersSnd :
    (artinianDualNumbers.{u, w, w} Λ k : Type w) →ₗ[k] k where
  toFun x := TrivSqZeroExt.snd (dualNumbersEquiv.{u, w, w} (Λ := Λ) (k := k) x)
  map_add' x y := by rw [map_add, TrivSqZeroExt.snd_add]
  map_smul' c x := by
    rw [Algebra.smul_def, map_mul, algebraMap_artinianDualNumbers,
      dualNumbersEquiv_dualNumbersUp]
    simp [TrivSqZeroExt.snd_mul]

/-- The element `ε` of the dual-number object of `𝒞_Λ`. -/
private noncomputable def artinianDualNumbersEps :
    (artinianDualNumbers.{u, w, w} Λ k : Type w) :=
  dualNumbersUp.{u, w, w} (Λ := Λ) (k := k) DualNumber.eps

private theorem artinianDualNumbersEps_sq :
    artinianDualNumbersEps (Λ := Λ) (k := k) * artinianDualNumbersEps (Λ := Λ) (k := k) = 0 := by
  rw [artinianDualNumbersEps, ← map_mul, DualNumber.eps_mul_eps, map_zero]

private theorem artinianDualNumbersSnd_eps :
    artinianDualNumbersSnd (Λ := Λ) (k := k) (artinianDualNumbersEps (Λ := Λ) (k := k)) = 1 := by
  show TrivSqZeroExt.snd (dualNumbersEquiv.{u, w, w} (Λ := Λ) (k := k)
    (dualNumbersUp.{u, w, w} (Λ := Λ) (k := k) DualNumber.eps)) = 1
  rw [dualNumbersEquiv_dualNumbersUp]
  rfl

/-- Every element of the dual-number object is its residue plus its `ε`-coefficient
times `ε`. -/
private theorem artinianDualNumbers_decomp
    (a : (artinianDualNumbers.{u, w, w} Λ k : Type w)) :
    algebraMap k (artinianDualNumbers.{u, w, w} Λ k : Type w)
        ((artinianDualNumbers.{u, w, w} Λ k).residueEquiv
          (residue (artinianDualNumbers.{u, w, w} Λ k : Type w) a)) +
      artinianDualNumbersSnd (Λ := Λ) (k := k) a •
        artinianDualNumbersEps (Λ := Λ) (k := k) = a := by
  apply (dualNumbersEquiv.{u, w, w} (Λ := Λ) (k := k)).injective
  have hres : (artinianDualNumbers.{u, w, w} Λ k).residueEquiv
      (residue (artinianDualNumbers.{u, w, w} Λ k : Type w) a) =
      TrivSqZeroExt.fst (dualNumbersEquiv.{u, w, w} (Λ := Λ) (k := k) a) := by
    rw [dualNumbersEquiv_fst]
    exact squareZeroExtensionArtinian_residue Λ k (FGModuleCat.of k (ULift.{w} k)) a
  rw [map_add, hres, algebraMap_artinianDualNumbers, dualNumbersEquiv_dualNumbersUp,
    Algebra.smul_def, map_mul, algebraMap_artinianDualNumbers,
    dualNumbersEquiv_dualNumbersUp, artinianDualNumbersEps, dualNumbersEquiv_dualNumbersUp]
  show TrivSqZeroExt.inl (TrivSqZeroExt.fst (dualNumbersEquiv.{u, w, w} a)) +
      TrivSqZeroExt.inl (TrivSqZeroExt.snd (dualNumbersEquiv.{u, w, w} a)) *
        TrivSqZeroExt.inr (1 : k) = dualNumbersEquiv.{u, w, w} a
  rw [TrivSqZeroExt.inl_mul_inr, smul_eq_mul, mul_one]
  exact TrivSqZeroExt.inl_fst_add_inr_snd_eq _

/-- **Stacks 0DZL.** For a smooth algebra `P` over a field `k`, the tangent space of the
deformation category of `P` is zero: the flat deformations of `P` over the dual numbers
form a single isomorphism class. -/
@[stacks 0DZL]
public theorem existsUnique_ringDeformationClass_artinianDualNumbers_of_smooth
    [Algebra.Smooth k P] :
    ∃ x : Quotient (isIsomorphicSetoid
        ((objectsOverFunctor (FlatAlgebraCategory.projection (Λ := Λ) (k := k))
          (residueFieldAlgebra (Λ := Λ) (k := k) P)).Fiber
          (artinianDualNumbers.{u, w, w} Λ k))),
      ∀ y, y = x :=
  existsUnique_ringDeformationClass_of_smooth (P := P)
    (artinianDualNumbersSnd (Λ := Λ) (k := k)) (artinianDualNumbersEps (Λ := Λ) (k := k))
    residueEquiv_residue_algebraMap_artinianDualNumbers
    artinianDualNumbersEps_sq artinianDualNumbersSnd_eps artinianDualNumbers_decomp

end DualNumbers

end Deformation.Examples
