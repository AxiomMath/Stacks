/-! ### Artinian local algebras with fixed residue field -/

section
open CategoryTheory
open IsLocalRing
universe u v w

/-- An Artinian local `Λ`-algebra together with a specified `Λ`-algebra isomorphism from
its residue field to `k`. These are the objects of the category `𝒞_Λ` of Stacks Project,
Tag 06GC. -/
@[stacks 06GC "objects", sga "7 VI 1.15" "objects, K a field"]
structure ArtinianLocalAlgCat (Λ : Type u) (k : Type w) [CommRing Λ] [Field k]
    [Algebra Λ k] where
  /-- The underlying type of the algebra. -/
  carrier : Type v
  [commRing : CommRing carrier]
  [algebra : Algebra Λ carrier]
  [isArtinianRing : IsArtinianRing carrier]
  [isLocalRing : IsLocalRing carrier]
  /-- The chosen identification of the residue field with `k`. -/
  residueEquiv : ResidueField carrier ≃ₐ[Λ] k

namespace ArtinianLocalAlgCat

variable {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]

attribute [instance] commRing algebra isArtinianRing isLocalRing

/-- An object of `ArtinianLocalAlgCat Λ k` coerces to its underlying type. -/
instance : CoeSort (ArtinianLocalAlgCat.{u, v, w} Λ k) (Type v) := ⟨carrier⟩

attribute [coe] carrier

/-- A morphism of Artinian local `Λ`-algebras with fixed residue field is a local
`Λ`-algebra homomorphism whose induced map on residue fields respects the specified
identifications with `k`. -/
@[ext, stacks 06GC "morphisms", sga "7 VI 1.15" "morphisms, K a field"]
structure Hom (A B : ArtinianLocalAlgCat.{u, v, w} Λ k) where
  /-- The underlying `Λ`-algebra homomorphism. -/
  hom : A →ₐ[Λ] B
  /-- The underlying ring homomorphism is local. -/
  isLocal : IsLocalHom hom.toRingHom
  /-- Compatibility with the specified identifications of the residue fields. -/
  residue_comm : ∀ a : A,
    B.residueEquiv (residue B (hom a)) = A.residueEquiv (residue A a)

/-- The condition on representatives used in `Hom.residue_comm` is equivalent to the
commutative triangle for the map induced on residue fields. -/
theorem residue_comm_iff {A B : ArtinianLocalAlgCat.{u, v, w} Λ k}
    (f : A →ₐ[Λ] B) [IsLocalHom f] :
    (∀ a : A, B.residueEquiv (residue B (f a)) = A.residueEquiv (residue A a)) ↔
      B.residueEquiv.toAlgHom.comp (ResidueField.mapAlgHom f) =
        A.residueEquiv.toAlgHom :=
  ⟨fun h ↦ AlgHom.ext fun x ↦ by obtain ⟨a, rfl⟩ := residue_surjective x; exact h a,
   fun h a ↦ DFunLike.congr_fun h (residue A a)⟩

/-- The category structure on Artinian local `Λ`-algebras with the fixed residue field `k`.
Composition is composition of the underlying local algebra homomorphisms. -/
@[stacks 06GC "category structure"]
instance instCategory : Category (ArtinianLocalAlgCat.{u, v, w} Λ k) where
  Hom := Hom
  id A :=
    { hom := AlgHom.id Λ A
      isLocal := isLocalHom_id A
      residue_comm := fun _ ↦ rfl }
  comp f g :=
    { hom := g.hom.comp f.hom
      isLocal := by
        let _ : IsLocalHom f.hom.toRingHom := f.isLocal
        let _ : IsLocalHom g.hom.toRingHom := g.isLocal
        exact RingHom.isLocalHom_comp g.hom.toRingHom f.hom.toRingHom
      residue_comm := fun a ↦ (g.residue_comm (f.hom a)).trans (f.residue_comm a) }
  id_comp := by
    intro A B f
    ext
    rfl
  comp_id := by
    intro A B f
    ext
    rfl
  assoc := by
    intro A B C D f g h
    ext
    rfl

/-- The algebra homomorphism underlying a morphism is local. -/
instance hom_isLocal {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) :
    IsLocalHom f.hom :=
  ⟨fun a ha ↦ f.isLocal.map_nonunit a ha⟩

/-- The ring homomorphism underlying a morphism is local. -/
instance hom_toRingHom_isLocal {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) :
    IsLocalHom f.hom.toRingHom :=
  f.isLocal

/-- Two morphisms are equal when their underlying algebra homomorphisms are equal. -/
@[ext]
theorem hom_ext {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} {f g : A ⟶ B}
    (h : f.hom = g.hom) : f = g :=
  Hom.ext h

/-- The underlying algebra homomorphism of the identity is the identity. -/
@[simp]
theorem id_hom (A : ArtinianLocalAlgCat.{u, v, w} Λ k) :
    (𝟙 A : A ⟶ A).hom = AlgHom.id Λ A := rfl

/-- The underlying algebra homomorphism of a composite is the composite of the underlying maps. -/
@[simp]
theorem comp_hom {A B C : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) (g : B ⟶ C) :
    (f ≫ g).hom = g.hom.comp f.hom := rfl

end ArtinianLocalAlgCat

/-- The classical case of `𝒞_Λ`: `Λ` is a Noetherian complete local ring and the given
`Λ`-algebra `k` is its residue field. -/
@[stacks 06GC "classical case"]
def IsClassical (Λ : Type u) (k : Type w) [CommRing Λ] [Field k] [Algebra Λ k] : Prop :=
  ∃ h : IsNoetherianCompleteLocalRing Λ,
    letI : IsLocalRing Λ := h.isLocal
    Nonempty (ResidueField Λ ≃ₐ[Λ] k)

end

/-! ### Small extensions -/

section

add_to_stacks 06GD InfinitesimalLifting.IsSmallExtension

end

/-! ### Essential surjections of Artinian local algebras -/

section
open CategoryTheory
universe u v w

variable {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]

/-- A surjective morphism in `𝒞_Λ` is essential if, whenever its composite with a
morphism into its source is surjective, that morphism is already surjective. -/
@[stacks 06GF]
abbrev IsEssentialSurjection
    {B A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A) : Prop :=
  Function.Surjective f.hom ∧ ∀ {C : ArtinianLocalAlgCat.{u, v, w} Λ k} (g : C ⟶ B),
    Function.Surjective (g ≫ f).hom → Function.Surjective g.hom

end

/-! ### Factoring surjections into small extensions -/

section
open CategoryTheory
open IsLocalRing
universe u v w


/-- The quotient of a local ring by an ideal inside the maximal ideal is local. -/
private theorem quotient_isLocalRing {R : Type*} [CommRing R] [IsLocalRing R] {J : Ideal R}
    (hJ : J ≤ IsLocalRing.maximalIdeal R) : IsLocalRing (R ⧸ J) :=
  haveI : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr
    (ne_of_lt (lt_of_le_of_lt hJ (maximalIdeal.isMaximal R).lt_top))
  IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective

private noncomputable def quotientResidueEquiv
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    (B : ArtinianLocalAlgCat.{u, v, w} Λ k) (J : Ideal B)
    [IsLocalRing (B ⧸ J)] : ResidueField B ≃ₐ[Λ] ResidueField (B ⧸ J) := by
  let q : B →ₐ[Λ] B ⧸ J := Ideal.Quotient.mkₐ Λ J
  letI : IsLocalHom q.toRingHom := IsLocalHom.of_surjective q.toRingHom
    Ideal.Quotient.mk_surjective
  letI : IsLocalHom q := ⟨fun a ha => this.map_nonunit a ha⟩
  let e : ResidueField B ≃ₐ[Λ] ResidueField (B ⧸ J) :=
    AlgEquiv.ofBijective (ResidueField.mapAlgHom q) (by
      constructor
      · exact (ResidueField.mapAlgHom q).toRingHom.injective
      · intro y
        obtain ⟨z, rfl⟩ := (residue_surjective (R := B ⧸ J)) y
        obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective z
        refine ⟨residue B x, ?_⟩
        change residue (B ⧸ J) (q x) = residue (B ⧸ J) z
        rw [← hx]
        rfl)
  exact e

private noncomputable def quotientObject
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    (B : ArtinianLocalAlgCat.{u, v, w} Λ k) (J : Ideal B)
    (hJ : J ≤ maximalIdeal B) : ArtinianLocalAlgCat.{u, v, w} Λ k := by
  have := quotient_isLocalRing hJ
  exact {
    carrier := B ⧸ J
    commRing := inferInstance
    algebra := inferInstance
    isArtinianRing := IsArtinianRing.of_finite B (B ⧸ J)
    isLocalRing := inferInstance
    residueEquiv := (quotientResidueEquiv B J).symm.trans B.residueEquiv
  }

private noncomputable def quotientHom
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    (B : ArtinianLocalAlgCat.{u, v, w} Λ k) (J : Ideal B)
    (hJ : J ≤ maximalIdeal B) : B ⟶ quotientObject B J hJ := by
  have := quotient_isLocalRing hJ
  let q : B →ₐ[Λ] B ⧸ J := Ideal.Quotient.mkₐ Λ J
  letI : IsLocalHom q.toRingHom := IsLocalHom.of_surjective q.toRingHom
    Ideal.Quotient.mk_surjective
  refine ⟨q, ?_, ?_⟩
  · exact IsLocalHom.of_surjective q.toRingHom Ideal.Quotient.mk_surjective
  · intro b
    apply congrArg B.residueEquiv
    change (quotientResidueEquiv B J).symm (residue (B ⧸ J) (q b)) = residue B b
    rw [← (quotientResidueEquiv B J).symm_apply_apply (residue B b)]
    congr 1

private theorem exists_simpleSubideal
    {R : Type u} [CommRing R] [IsArtinianRing R] (I : Ideal R) (hI : I ≠ ⊥) :
    ∃ J : Ideal R, J ≤ I ∧ J ≠ ⊥ ∧ IsSimpleModule R J := by
  let S : Set (Ideal R) := {J | J ≤ I ∧ J ≠ ⊥}
  have hS : S.Nonempty := ⟨I, le_rfl, hI⟩
  obtain ⟨J, hJ, hmin⟩ := IsArtinian.set_has_minimal (R := R) (M := R) S hS
  refine ⟨J, hJ.1, hJ.2, ?_⟩
  rw [isSimpleModule_iff_isAtom, isAtom_iff_le_of_ge]
  refine ⟨hJ.2, fun K hKbot hKJ => ?_⟩
  have hKI : K ≤ I := hKJ.trans hJ.1
  have hKmem : K ∈ S := ⟨hKI, hKbot⟩
  have hnotlt : ¬ K < J := hmin K hKmem
  by_contra hJK
  have hne : K ≠ J := by
    intro hEq
    apply hJK
    rw [← hEq]
  exact hnotlt (lt_of_le_of_ne hKJ hne)

private noncomputable def quotientFactor
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {B A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A)
    (hf : Function.Surjective f.hom) (J : Ideal B)
    (hJker : J ≤ RingHom.ker f.hom.toRingHom)
    (hJmax : J ≤ maximalIdeal B) : quotientObject B J hJmax ⟶ A := by
  have := quotient_isLocalRing hJmax
  let q : B →ₐ[Λ] B ⧸ J := Ideal.Quotient.mkₐ Λ J
  have hker : RingHom.ker q.toRingHom ≤ RingHom.ker f.hom.toRingHom := by
    intro b hb
    have hbJ : b ∈ J := by simpa [q] using hb
    exact hJker hbJ
  let g : B ⧸ J →ₐ[Λ] A := AlgHom.liftOfSurjective q
    Ideal.Quotient.mk_surjective f.hom hker
  have hg_apply (b : B) : g (q b) = f.hom b := by
    simpa [g] using
      (AlgHom.liftOfSurjective_apply q Ideal.Quotient.mk_surjective f.hom hker b)
  have hg : Function.Surjective g := by
    intro a
    obtain ⟨b, rfl⟩ := hf a
    refine ⟨q b, ?_⟩
    exact hg_apply b
  letI : IsLocalHom g.toRingHom := IsLocalHom.of_surjective g.toRingHom hg
  refine ⟨g, IsLocalHom.of_surjective g.toRingHom hg, ?_⟩
  intro x
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  calc
    A.residueEquiv (residue A (g (q b))) = A.residueEquiv (residue A (f.hom b)) := by
      rw [hg_apply]
    _ = B.residueEquiv (residue B b) := f.residue_comm b
    _ = (quotientObject B J hJmax).residueEquiv
        (residue (quotientObject B J hJmax) (q b)) :=
      ((quotientHom B J hJmax).residue_comm b).symm

private theorem quotientFactor_comp
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {B A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A)
    (hf : Function.Surjective f.hom) (J : Ideal B)
    (hJker : J ≤ RingHom.ker f.hom.toRingHom)
    (hJmax : J ≤ maximalIdeal B) :
    quotientHom B J hJmax ≫ quotientFactor f hf J hJker hJmax = f := by
  apply ArtinianLocalAlgCat.hom_ext
  apply AlgHom.ext
  intro b
  exact AlgHom.liftOfSurjective_apply (Ideal.Quotient.mkₐ Λ J)
    Ideal.Quotient.mk_surjective f.hom (fun x hx ↦ hJker (by simpa using hx)) b

private noncomputable def isoOfSurjectiveKerBot
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {B A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A)
    (hf : Function.Surjective f.hom)
    (hker : RingHom.ker f.hom.toRingHom = ⊥) : B ≅ A := by
  have hinj : Function.Injective f.hom :=
    (RingHom.injective_iff_ker_eq_bot f.hom.toRingHom).2 hker
  let e : B ≃ₐ[Λ] A := AlgEquiv.ofBijective f.hom ⟨hinj, hf⟩
  refine ⟨f, ?_, ?_, ?_⟩
  · refine ⟨e.symm.toAlgHom, IsLocalHom.of_surjective e.symm.toRingEquiv.toRingHom
      e.symm.surjective, ?_⟩
    intro a
    have hc := f.residue_comm (e.symm a)
    have hfa : f.hom (e.symm a) = a := e.apply_symm_apply a
    rw [hfa] at hc
    exact hc.symm
  · apply ArtinianLocalAlgCat.hom_ext
    ext b
    change e.symm (e b) = b
    exact e.symm_apply_apply b
  · apply ArtinianLocalAlgCat.hom_ext
    ext a
    change e (e.symm a) = a
    exact e.apply_symm_apply a

private theorem quotientHom_isSmallExtension
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    (B : ArtinianLocalAlgCat.{u, v, w} Λ k) (J : Ideal B)
    (hJ : J ≤ maximalIdeal B) (hJsimple : IsSimpleModule B J) :
    InfinitesimalLifting.IsSmallExtension
      (CommRingCat.ofHom (quotientHom B J hJ).hom.toRingHom) := by
  refine ⟨inferInstance, inferInstance, inferInstance, inferInstance,
    Ideal.Quotient.mk_surjective, ?_⟩
  change Module.length B (RingHom.ker (Ideal.Quotient.mk J)) = 1
  rw [Ideal.mk_ker]
  exact Module.length_eq_one_iff.mpr hJsimple

private theorem smallExtension_comp_iso
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {B A C : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A) (e : A ≅ C)
    (hsmall : InfinitesimalLifting.IsSmallExtension
      (CommRingCat.ofHom f.hom.toRingHom)) :
    InfinitesimalLifting.IsSmallExtension
      (CommRingCat.ofHom (f ≫ e.hom).hom.toRingHom) := by
  rcases hsmall with ⟨hLA, hLB, hAA, hAB, hsurj, hlen⟩
  have hinvcomp : e.inv.hom.comp e.hom.hom = AlgHom.id Λ A := by
    have h := congrArg (fun g : A ⟶ A => g.hom) e.hom_inv_id
    change e.inv.hom.comp e.hom.hom = AlgHom.id Λ A at h
    exact h
  have hcompinv : e.hom.hom.comp e.inv.hom = AlgHom.id Λ C := by
    have h := congrArg (fun g : C ⟶ C => g.hom) e.inv_hom_id
    change e.hom.hom.comp e.inv.hom = AlgHom.id Λ C at h
    exact h
  have hEinj : Function.Injective e.hom.hom := by
    intro x y hxy
    have hx : e.inv.hom (e.hom.hom x) = x := by
      simpa using congrArg (fun g : A →ₐ[Λ] A => g x) hinvcomp
    have hy : e.inv.hom (e.hom.hom y) = y := by
      simpa using congrArg (fun g : A →ₐ[Λ] A => g y) hinvcomp
    rw [← hx, hxy, hy]
  have hker : RingHom.ker (e.hom.hom.comp f.hom).toRingHom =
      RingHom.ker f.hom.toRingHom := by
    ext x
    change e.hom.hom (f.hom x) = 0 ↔ f.hom x = 0
    exact ⟨fun h => hEinj (by simpa using h), fun h => by simp [h]⟩
  refine ⟨inferInstance, inferInstance, inferInstance, inferInstance,
    ?_, ?_⟩
  · intro c
    obtain ⟨b, hb⟩ := hsurj (e.inv.hom c)
    have hb' : f.hom b = e.inv.hom c := by simpa using hb
    refine ⟨b, ?_⟩
    change e.hom.hom (f.hom b) = c
    rw [hb']
    exact congrArg (fun g => g c) hcompinv
  · change Module.length B (RingHom.ker (e.hom.hom.comp f.hom).toRingHom) = 1
    rw [hker]
    exact hlen

private theorem quotient_length_lt
    {R : Type u} [CommRing R] [IsLocalRing R] [IsArtinianRing R]
    (J : Ideal R) (hJ : J ≠ ⊥) (hJmax : J ≤ maximalIdeal R) :
    Module.length (R ⧸ J) (R ⧸ J) < Module.length R R := by
  have := quotient_isLocalRing hJmax
  have hsurj : Function.Surjective (algebraMap R (R ⧸ J)) := by
    intro x
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨r, by simp⟩
  have hlen : Module.length R (R ⧸ J) = Module.length (R ⧸ J) (R ⧸ J) :=
    Module.length_eq_of_surjective hsurj
  rw [← hlen]
  exact Submodule.length_quotient_lt J hJ

/-- A surjective morphism in `\mathcal{C}_\Lambda` is a finite composite of small
extensions. -/
@[stacks 06GE]
theorem surjective_factors_into_smallExtensions
    {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]
    {B A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A)
    (hf : Function.Surjective f.hom) :
    ∃ (n : ℕ) (F : ComposableArrows (ArtinianLocalAlgCat.{u, v, w} Λ k) n)
      (hB : F.left = B) (e : F.right ≅ A),
      eqToHom hB.symm ≫ F.hom ≫ e.hom = f ∧
        ∀ (i : ℕ) (hi : i < n),
          InfinitesimalLifting.IsSmallExtension
            (CommRingCat.ofHom (F.map' i (i + 1)).hom.toRingHom) := by
  classical
  induction hlen : Module.length B B using WellFoundedLT.induction generalizing B A f hf with
  | ind m ih =>
      let I : Ideal B := RingHom.ker f.hom.toRingHom
      by_cases hI : I = ⊥
      · let F₀ := ComposableArrows.mk₀ B
        have hB₀ : F₀.left = B := rfl
        refine ⟨0, F₀, hB₀,
          isoOfSurjectiveKerBot (B := B) (A := A) f hf (by simpa [I] using hI), ?_⟩
        constructor
        · change eqToHom hB₀.symm ≫ F₀.hom ≫ f = f
          apply ArtinianLocalAlgCat.hom_ext
          ext b
          change f.hom ((eqToHom hB₀.symm).hom b) = f.hom b
          have hb : (eqToHom hB₀.symm).hom b = b := by
            dsimp [F₀, ComposableArrows.mk₀]
            rfl
          rw [hb]
        · intro i hi
          omega
      · have hImax : I ≤ maximalIdeal B := by
          intro x hx
          rw [← IsLocalRing.maximalIdeal_comap f.hom.toRingHom]
          change f.hom.toRingHom x ∈ maximalIdeal A
          rw [show f.hom.toRingHom x = 0 from hx]
          exact Ideal.zero_mem _
        obtain ⟨J, hJI, hJne, hJsimple⟩ := exists_simpleSubideal I hI
        have hJmax : J ≤ maximalIdeal B := hJI.trans hImax
        let Q : ArtinianLocalAlgCat.{u, v, w} Λ k := quotientObject B J hJmax
        let g : Q ⟶ A := quotientFactor f hf J hJI hJmax
        have hg : Function.Surjective g.hom := by
          intro a
          obtain ⟨b, rfl⟩ := hf a
          refine ⟨Ideal.Quotient.mk J b, ?_⟩
          have h := congrArg (fun t : B ⟶ A => t.hom b)
            (quotientFactor_comp f hf J hJI hJmax)
          change g.hom (Ideal.Quotient.mk J b) = f.hom b at h
          exact h
        have hmeasure : Module.length Q Q < Module.length B B := by
          change Module.length (B ⧸ J) (B ⧸ J) < Module.length B B
          exact quotient_length_lt J hJne hJmax
        rw [hlen] at hmeasure
        obtain ⟨n, F, hQ, e, hcomp, hsmall⟩ := ih (Module.length Q Q) hmeasure g hg rfl
        let u : B ⟶ F.left := quotientHom B J hJmax ≫ eqToHom hQ.symm
        let F' := F.precomp u
        have hpre : F'.hom = u ≫ F.hom := by
          cases n with
          | zero =>
              change ComposableArrows.Precomp.map F u 0 1 (by decide) = u ≫ F.hom
              rw [ComposableArrows.Precomp.map_zero_one]
              change u = u ≫ F.map' 0 0
              rw [ComposableArrows.map'_self F 0 (by decide)]
              exact (Category.comp_id u).symm
          | succ n =>
              change ComposableArrows.Precomp.map F u 0
                ⟨n + 2, by simp [Nat.add_assoc]⟩
                (Fin.zero_le _) =
                u ≫ F.map' 0 (n + 1)
              rw [ComposableArrows.Precomp.map_zero_succ_succ]
        refine ⟨n + 1, F', rfl, e, ?_⟩
        constructor
        · calc
            eqToHom rfl ≫ F'.hom ≫ e.hom = u ≫ F.hom ≫ e.hom := by
              simp [hpre]
            _ = quotientHom B J hJmax ≫
                  (eqToHom hQ.symm ≫ F.hom ≫ e.hom) := by simp [u, Category.assoc]
            _ = quotientHom B J hJmax ≫ g := by rw [hcomp]
            _ = f := quotientFactor_comp f hf J hJI hJmax
        · intro i hi
          cases i with
          | zero =>
              change InfinitesimalLifting.IsSmallExtension
                (CommRingCat.ofHom (u.hom).toRingHom)
              exact smallExtension_comp_iso (quotientHom B J hJmax)
                (eqToIso hQ.symm) (quotientHom_isSmallExtension B J hJmax hJsimple)
          | succ i =>
              have hi' : i < n := by omega
              simpa [F', ComposableArrows.precomp, ComposableArrows.Precomp.map] using
                hsmall i hi'

end

/-! ### Sections of small extensions -/

section
open CategoryTheory
universe u v w


variable {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]

/-- A small extension in `𝒞_Λ` is nonessential if and only if it has a section in
`𝒞_Λ`. -/
@[stacks 06H0 "small_extension_section"]
theorem not_isEssentialSurjection_iff_exists_section
    {B A : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : B ⟶ A)
    (hf : InfinitesimalLifting.IsSmallExtension
      (CommRingCat.ofHom f.hom.toRingHom)) :
    ¬ IsEssentialSurjection f ↔ ∃ s : A ⟶ B, s ≫ f = 𝟙 A := by
  classical
  constructor
  · intro hn
    have hnotproperty :
        ¬ (∀ {C : ArtinianLocalAlgCat.{u, v, w} Λ k} (g : C ⟶ B),
          Function.Surjective (g ≫ f).hom → Function.Surjective g.hom) :=
      fun h => hn ⟨hf.2.2.2.2.1, h⟩
    push Not at hnotproperty
    obtain ⟨C, g, hcomp_surj, hg_not_surj⟩ := hnotproperty
    let h : C →ₐ[Λ] A := f.hom.comp g.hom
    have hh_surj : Function.Surjective h := by
      simpa [h] using hcomp_surj
    let I : Ideal B := RingHom.ker f.hom.toRingHom
    have hI_simple : IsSimpleModule B I :=
      Module.length_eq_one_iff.mp hf.2.2.2.2.2
    have hI_sq : I ^ 2 = ⊥ :=
      (InfinitesimalLifting.IsSmallExtension.isSquareZeroSurjection
        (CommRingCat.ofHom f.hom.toRingHom) hf).2.2.2
    have hdisjoint : ∀ c : C, f.hom (g.hom c) = 0 → g.hom c = 0 := by
      intro c hfc
      by_contra hgc
      apply hg_not_surj
      intro b
      obtain ⟨c₀, hc₀⟩ := hh_surj (f.hom b)
      let d : B := b - g.hom c₀
      have hdI : d ∈ I := by
        change f.hom (b - g.hom c₀) = 0
        rw [map_sub, ← hc₀]
        simp [h]
      have hgc' : (⟨g.hom c, hfc⟩ : I) ≠ 0 :=
        fun hz => hgc (congrArg Subtype.val hz)
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
        (show (⟨d, hdI⟩ : I) ∈ B ∙ (⟨g.hom c, hfc⟩ : I) by
          rw [IsSimpleModule.span_singleton_eq_top B hgc']; trivial)
      have had : a * g.hom c = d := by
        simpa [smul_eq_mul] using congrArg Subtype.val ha
      obtain ⟨c₁, hc₁⟩ := hh_surj (f.hom a)
      let e : B := a - g.hom c₁
      have heI : e ∈ I := by
        change f.hom (a - g.hom c₁) = 0
        rw [map_sub, ← hc₁]
        simp [h]
      have he_mul : e * g.hom c = 0 := by
        have heprod : e * g.hom c ∈ I ^ 2 := by
          rw [pow_two]
          exact Ideal.mul_mem_mul heI hfc
        rw [hI_sq] at heprod
        simpa using heprod
      have hg₁ : g.hom c₁ = a - e := by dsimp [e]; ring
      have hfactor : g.hom (c₁ * c) = d := by
        rw [map_mul, hg₁, sub_mul, he_mul, sub_zero]
        exact had
      refine ⟨c₀ + c₁ * c, ?_⟩
      rw [map_add, hfactor]
      simp [d]
    have hker_le : RingHom.ker h.toRingHom ≤ RingHom.ker g.hom.toRingHom := by
      intro c hc
      exact RingHom.mem_ker.mpr (hdisjoint c (RingHom.mem_ker.mp hc))
    let qlift : C ⧸ RingHom.ker h.toRingHom →ₐ[Λ] B :=
      Ideal.Quotient.liftₐ (RingHom.ker h.toRingHom) g.hom (by
        intro c hc; exact RingHom.mem_ker.mp (hker_le hc))
    have hqlift_comp :
        qlift.comp (Ideal.Quotient.mkₐ Λ (RingHom.ker h.toRingHom)) = g.hom := by
      dsimp [qlift]
      exact Ideal.Quotient.liftₐ_comp _ _ _
    let hEquiv : (C ⧸ RingHom.ker h.toRingHom) ≃ₐ[Λ] A :=
      Ideal.quotientKerAlgEquivOfSurjective (f := h) hh_surj
    let sAlg : A →ₐ[Λ] B := qlift.comp hEquiv.symm.toAlgHom
    have hsAlg_comp_h : sAlg.comp h = g.hom := by
      apply AlgHom.ext
      intro c
      change qlift (hEquiv.symm (h c)) = g.hom c
      rw [show hEquiv.symm (h c) = Ideal.Quotient.mk _ c by
        exact Ideal.quotientKerAlgEquivOfSurjective_symm_apply hh_surj c]
      change (qlift.comp
        (Ideal.Quotient.mkₐ Λ (RingHom.ker h.toRingHom))) c = g.hom c
      exact congrArg (fun z : C →ₐ[Λ] B => z c) hqlift_comp
    have hsAlg_comp_f : f.hom.comp sAlg = AlgHom.id Λ A := by
      apply AlgHom.ext
      intro a
      obtain ⟨c, hc⟩ := hh_surj a
      have hval : sAlg (h c) = g.hom c := by
        simpa using congrArg (fun z : C →ₐ[Λ] B => z c) hsAlg_comp_h
      change f.hom (sAlg a) = a
      rw [← hc, hval]
      rfl
    have hs_eval (a : A) : f.hom (sAlg a) = a := by
      simpa using congrArg (fun z : A →ₐ[Λ] A => z a) hsAlg_comp_f
    let s : A ⟶ B :=
      { hom := sAlg
        isLocal := ⟨fun a ha => by
          simpa [hs_eval a] using ha.map f.hom⟩
        residue_comm := fun a => by
          have hres := f.residue_comm (sAlg a)
          rw [hs_eval a] at hres
          exact hres.symm }
    refine ⟨s, ?_⟩
    apply ArtinianLocalAlgCat.hom_ext
    simpa using hsAlg_comp_f
  · rintro ⟨s, hs⟩ hn
    have hker_ne : RingHom.ker f.hom.toRingHom ≠ ⊥ := by
      intro hker
      have hlen := hf.2.2.2.2.2
      change Module.length B (RingHom.ker f.hom.toRingHom) = 1 at hlen
      rw [hker, Module.length_bot] at hlen
      exact zero_ne_one hlen
    obtain ⟨b, hbker, hbne⟩ :=
      Submodule.exists_mem_ne_zero_of_ne_bot hker_ne
    obtain ⟨a, ha⟩ := (hn.2 s (by simpa [hs] using
      (Function.surjective_id : Function.Surjective (fun a : A => a)))) b
    have hs_comp : f.hom (s.hom a) = a := by
      have h := congrArg (fun q : A ⟶ A => q.hom a) hs
      simpa using h
    have ha_zero : a = 0 := by
      calc
        a = f.hom (s.hom a) := hs_comp.symm
        _ = f.hom b := by rw [ha]
        _ = 0 := RingHom.mem_ker.mp hbker
    apply hbne
    simpa [ha_zero] using ha.symm

end

/-! ### Relative cotangent spaces of local rings -/

section

universe u v

/-- The relative cotangent space of a local homomorphism `f : R → S`, namely
`m_S / (m_R S + m_S²)`. -/
@[stacks 06GY, sga "1 III 2.2"]
abbrev relativeCotangentSpace
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f] : Type v :=
  (IsLocalRing.maximalIdeal S) ⧸
    (Submodule.comap (IsLocalRing.maximalIdeal S).subtype
      ((IsLocalRing.maximalIdeal R).map f + IsLocalRing.maximalIdeal S ^ 2 : Ideal S) :
      Submodule S (IsLocalRing.maximalIdeal S))

/-- The relative cotangent space of `f` is a vector space over the residue field of `S`: the
maximal ideal of `S` acts on it by zero. -/
public noncomputable instance relativeCotangentSpace.module
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f] :
    Module (IsLocalRing.ResidueField S) (relativeCotangentSpace f) := by
  apply Module.IsTorsionBySet.module
  rw [Module.isTorsionBySet_quotient_iff]
  intro x r hr
  change (r * (x : S)) ∈ (IsLocalRing.maximalIdeal R).map f +
    IsLocalRing.maximalIdeal S ^ 2
  apply le_add_left (a := IsLocalRing.maximalIdeal S ^ 2) le_rfl
  rw [pow_two]
  exact Ideal.mul_mem_mul hr x.2

end

/-! ### The residue image field of a finite map to a field -/

section
universe u v

/-- The subfield generated by the image of the structural map `Λ → k`. -/
noncomputable def residueImageField (Λ : Type u) (k : Type v) [CommRing Λ]
    [Field k] [Algebra Λ k] : Subfield k :=
  Subfield.closure ((algebraMap Λ k).range : Set k)

/-- If `k` is a finite module over a Noetherian ring `Λ`, then the image of `Λ` in `k` is a
field. -/
public theorem range_isField (Λ : Type u) (k : Type v) [CommRing Λ]
    [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k] :
    IsField (algebraMap Λ k).range := by
  let : Algebra (algebraMap Λ k).range k := (Subring.subtype _).toAlgebra
  let : Algebra.IsIntegral (algebraMap Λ k).range k := ⟨fun x =>
      RingHom.IsIntegralElem.of_comp
      (f := (algebraMap Λ k).rangeRestrict)
      (g := algebraMap (algebraMap Λ k).range k)
      (by
        rw [show (algebraMap (algebraMap Λ k).range k).comp
          (algebraMap Λ k).rangeRestrict = algebraMap Λ k by ext y; rfl]
        exact IsIntegral.of_finite Λ x)⟩
  exact isField_of_isIntegral_of_isField
    (fun _ _ h => Subtype.ext h) (Field.toIsField k)

/-- For a finite map to a field, the subfield generated by its image has
underlying set equal to the image itself. -/
@[stacks 06S2 "the image is a field"]
theorem residueImageField_eq_range (Λ : Type u) (k : Type v) [CommRing Λ]
    [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k] :
    (residueImageField Λ k : Set k) = Set.range (algebraMap Λ k) := by
  have hr : IsField (algebraMap Λ k).range := range_isField Λ k
  let : Field (algebraMap Λ k).range := hr.toField
  let s := (Subring.subtype (algebraMap Λ k).range).fieldRange
  have hs : (s : Set k) = Set.range (algebraMap Λ k) := by
    rw [RingHom.coe_fieldRange, ← RingHom.coe_range, Subring.range_subtype]
    exact RingHom.coe_range _
  change (Subfield.closure (Set.range (algebraMap Λ k)) : Set k) = _
  rw [← hs, Subfield.closure_eq]


/-- The degrees of `k` over the image field and over the quotient of `Λ` by the kernel of its
structural map agree. -/
@[stacks 06S2 "the equality of degrees"]
theorem finrank_residueImageField_eq_quotient_ker
    (Λ : Type u) (k : Type v) [CommRing Λ] [IsNoetherianRing Λ]
    [Field k] [Algebra Λ k] [Module.Finite Λ k] :
    let f : Λ →+* k := algebraMap Λ k
    let e : Λ ⧸ RingHom.ker f ≃+* RingHom.range f :=
      RingHom.quotientKerEquivRange f
    letI : Field f.range := (range_isField Λ k).toField
    letI : Field (Λ ⧸ RingHom.ker f) :=
      ((e.toMulEquiv.isField_congr).mpr (Field.toIsField f.range)).toField
    let q : Λ ⧸ RingHom.ker f →+* k :=
      (Subring.subtype (RingHom.range f)).comp e.toRingHom
    letI : Algebra (Λ ⧸ RingHom.ker f) k := q.toAlgebra
    Module.finrank (residueImageField Λ k) k =
      Module.finrank (Λ ⧸ RingHom.ker f) k := by
  dsimp only
  let f : Λ →+* k := algebraMap Λ k
  let e : Λ ⧸ RingHom.ker f ≃+* RingHom.range f :=
    RingHom.quotientKerEquivRange f
  let : Field f.range := (range_isField Λ k).toField
  let : Field (Λ ⧸ RingHom.ker f) :=
    ((e.toMulEquiv.isField_congr).mpr (Field.toIsField f.range)).toField
  let q : Λ ⧸ RingHom.ker f →+* k :=
    (Subring.subtype (RingHom.range f)).comp e.toRingHom
  let : Algebra (Λ ⧸ RingHom.ker f) k := q.toAlgebra
  change Module.finrank (residueImageField Λ k) k =
    Module.finrank (Λ ⧸ RingHom.ker f) k
  have hs : (residueImageField Λ k).toSubring = f.range := by
    ext x
    exact Set.ext_iff.mp (residueImageField_eq_range Λ k) x
  calc
    Module.finrank (residueImageField Λ k) k = Module.finrank f.range k :=
      Algebra.finrank_eq_of_equiv_equiv (RingEquiv.subringCongr hs)
        (RingEquiv.refl k) (by ext; rfl)
    _ = Module.finrank (Λ ⧸ RingHom.ker f) k := by
      symm
      exact Algebra.finrank_eq_of_equiv_equiv e (RingEquiv.refl k) (by ext; rfl)

/-- **Stacks Project, Tag 06S2.** The extension of `k` over the image field of
a finite ring map is finite. -/
@[stacks 06S2 "finiteness of the degree"]
theorem residueImageField_finite
    (Λ : Type u) (k : Type v) [CommRing Λ] [IsNoetherianRing Λ]
    [Field k] [Algebra Λ k] [Module.Finite Λ k] :
    Module.Finite (residueImageField Λ k) k := by
  have hfin : Module.Finite Λ k := inferInstance
  let hmod : Module Λ k := inferInstance
  let : Algebra Λ (residueImageField Λ k) :=
    RingHom.toAlgebra ((algebraMap Λ k).codRestrict (residueImageField Λ k)
      (fun x => Subfield.subset_closure ⟨x, rfl⟩))
  let : Algebra (residueImageField Λ k) k :=
    (residueImageField Λ k).subtype.toAlgebra
  let : IsScalarTower Λ (residueImageField Λ k) k :=
    IsScalarTower.of_algebraMap_eq' (by
      ext x
      rfl)
  let : Module Λ k := hmod
  exact Module.Finite.of_restrictScalars_finite Λ (residueImageField Λ k) k (hM := hfin)

end

/-! ### Length over a local algebra and its base ring -/

section
open IsLocalRing
universe u v w x

private lemma residue_length
    (Λ : Type u) (k : Type w) (A : Type v)
    [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k]
    [CommRing A] [Algebra Λ A] [IsLocalRing A]
    (e : ResidueField A ≃ₐ[Λ] k) :
    Module.length Λ (ResidueField A) =
      Module.finrank (residueImageField Λ k) k := by
  rw [e.toLinearEquiv.length_eq]
  let k' := residueImageField Λ k
  let φ : Λ →+* k' := (algebraMap Λ k).codRestrict k' fun a =>
    Subfield.subset_closure ⟨a, rfl⟩
  let : Algebra Λ k' := φ.toAlgebra
  let : IsScalarTower Λ k' k := IsScalarTower.of_algebraMap_eq' rfl
  have hsurj : Function.Surjective (algebraMap Λ k') := by
    intro z; obtain ⟨a, ha⟩ := (Set.ext_iff.mp
      (residueImageField_eq_range Λ k) z.1).mp z.2
    exact ⟨a, Subtype.ext ha⟩
  let : Module.Finite k' k := residueImageField_finite Λ k
  rw [Module.length_eq_of_surjective (R := k') (M := k) hsurj,
    Module.length_eq_finrank]

private lemma covBy_length_restrictScalars
    (Λ : Type u) (k : Type w) (A : Type v) (M : Type x)
    [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k]
    [CommRing A] [Algebra Λ A] [IsLocalRing A]
    [AddCommGroup M] [Module A M] [Module Λ M] [IsScalarTower Λ A M]
    (e : ResidueField A ≃ₐ[Λ] k) {p q : Submodule A M} (h : p ⋖ q) :
    Module.length Λ q = Module.length Λ p +
      Module.finrank (residueImageField Λ k) k := by
  let f : p →ₗ[A] q := Submodule.inclusion h.le
  have key : IsSimpleModule A (q ⧸ f.range) := by rwa
    [Submodule.range_inclusion, ← covBy_iff_quot_is_simple h.le]
  obtain ⟨m, hm, ⟨em⟩⟩ := isSimpleModule_iff_quot_maximal.mp key
  rw [eq_maximalIdeal hm] at em
  let g : q →ₗ[A] ResidueField A := em.comp f.range.mkQ
  have hf : Function.Injective f := Submodule.inclusion_injective _
  have hg : Function.Surjective g := em.surjective.comp f.range.mkQ_surjective
  have hex : Function.Exact f g := LinearMap.exact_iff.mpr
    ((em.ker_comp f.range.mkQ).trans f.range.ker_mkQ)
  rw [Module.length_eq_add_of_exact (f.restrictScalars Λ) (g.restrictScalars Λ)
    (by simpa) (by simpa) (by simpa), residue_length Λ k A e]

/-- **Stacks Project, Tag 06GG.** Restricting scalars from a local `Λ`-algebra
with residue field `k` to `Λ` multiplies module length by the degree of `k` over
the image field of `Λ`. -/
@[stacks 06GG "general case"]
theorem finrank_residueImageField_mul_length_eq_length
    (Λ : Type u) (k : Type w) (A : Type v) (M : Type x)
    [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k]
    [CommRing A] [Algebra Λ A] [IsLocalRing A]
    [AddCommGroup M] [Module A M]
    (_ : ResidueField A ≃ₐ[Λ] k) :
    letI : Module Λ M := Module.compHom M (algebraMap Λ A)
    (Module.finrank (residueImageField Λ k) k : ℕ∞) * Module.length A M =
      Module.length Λ M := by
  let : Module Λ M := Module.compHom M (algebraMap Λ A)
  let : IsScalarTower Λ A M := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  by_cases hM : IsFiniteLength A M
  · obtain ⟨s, hs_bot, hs_top⟩ := isFiniteLength_iff_exists_compositionSeries.mp hM
    rw [← Module.length_compositionSeries s hs_bot hs_top]
    suffices ∀ i, Module.length Λ (s i) =
        i * Module.finrank (residueImageField Λ k) k by
      rw [mul_comm, ← Fin.val_last s.length, ← this, ← RelSeries.last, hs_top]
      exact Module.length_top (R := Λ) (M := M)
    intro i
    induction i using Fin.induction with
    | zero => rw [← RelSeries.head, hs_bot]; simp
    | succ j hj => simpa [hj, add_mul, add_comm] using
        covBy_length_restrictScalars Λ k A M ‹ResidueField A ≃ₐ[Λ] k› (s.step j)
  · have htopA : Module.length A M = ⊤ := by
      rwa [← Module.length_ne_top_iff, not_ne_iff] at hM
    have htopΛ : Module.length Λ M = ⊤ :=
      top_unique (htopA ▸ Module.length_le_length_restrictScalars Λ A (algebraMap Λ A) M)
    have hne : (Module.finrank (residueImageField Λ k) k : ℕ∞) ≠ 0 := by
      let := residueImageField_finite Λ k
      exact_mod_cast (Module.finrank_pos (R := residueImageField Λ k)
        (M := k)).ne'
    rw [htopA, htopΛ, ENat.mul_top hne]

/-- **Stacks Project, Tag 06GG.** In the classical case, module length is unchanged
by restriction of scalars from a local `Λ`-algebra with residue field `k` to `Λ`. -/
@[stacks 06GG "classical case"]
theorem length_eq_length_of_isClassical
    (Λ : Type u) (k : Type w) (A : Type v) (M : Type x)
    [CommRing Λ] [IsNoetherianRing Λ] [Field k] [Algebra Λ k] [Module.Finite Λ k]
    [CommRing A] [Algebra Λ A] [IsLocalRing A]
    [AddCommGroup M] [Module A M]
    (_ : ResidueField A ≃ₐ[Λ] k) (h : IsClassical Λ k) :
    letI : Module Λ M := Module.compHom M (algebraMap Λ A)
    Module.length A M = Module.length Λ M := by
  obtain ⟨hΛ, eΛ⟩ := h
  obtain ⟨eΛ⟩ := eΛ
  let : IsLocalRing Λ := hΛ.isLocal
  have hsurj : Function.Surjective (algebraMap Λ k) := by
    intro y; obtain ⟨a, ha⟩ := residue_surjective (eΛ.symm y)
    refine ⟨a, ?_⟩
    rw [← eΛ.commutes a, ResidueField.algebraMap_eq, ha, eΛ.apply_symm_apply]
  have hfield : residueImageField Λ k = ⊤ := by
    ext y; change y ∈ (residueImageField Λ k : Set k) ↔ _
    rw [residueImageField_eq_range Λ k]; simp [hsurj y]
  have hdegree : Module.finrank (residueImageField Λ k) k = 1 := by
    refine Module.finrank_of_bijective_algebraMap
      ⟨(residueImageField Λ k).subtype.injective, ?_⟩
    intro y; exact ⟨⟨y, hfield ▸ Set.mem_univ y⟩, rfl⟩
  simpa [hdegree] using
    finrank_residueImageField_mul_length_eq_length Λ k A M
      ‹ResidueField A ≃ₐ[Λ] k›

end

/-! ### Surjectivity of maps of Artinian local algebras -/

section
open CategoryTheory IsLocalRing
universe u v w


variable {Λ : Type u} {k : Type w} [CommRing Λ] [Field k] [Algebra Λ k]

namespace ArtinianLocalAlgCat

attribute [instance] ArtinianLocalAlgCat.commRing
  ArtinianLocalAlgCat.algebra ArtinianLocalAlgCat.isArtinianRing
  ArtinianLocalAlgCat.isLocalRing
attribute [coe] ArtinianLocalAlgCat.carrier

/-- The submodule `m_Λ A + m_A²` of `m_A`, where the distinguished ideal `m_Λ` is
`ker(Λ → k)`. -/
public abbrev relativeCotangentSubmodule
    (A : ArtinianLocalAlgCat.{u, v, w} Λ k) : Submodule A (maximalIdeal A) :=
  Submodule.comap (maximalIdeal A).subtype
    ((RingHom.ker (algebraMap Λ k)).map (algebraMap Λ A) + maximalIdeal A ^ 2 : Ideal A)

/-- For an Artinian local `Λ`-algebra `A` with residue field `k`, the relative cotangent
space `m_A / (m_Λ A + m_A²)`, where `m_Λ = ker(Λ → k)`. -/
public abbrev relativeCotangentSpaceOverBase
    (A : ArtinianLocalAlgCat.{u, v, w} Λ k) : Type v :=
  maximalIdeal A ⧸ relativeCotangentSubmodule A

/-- The additive map between maximal ideals induced by a morphism of Artinian local
algebras. -/
public def maximalIdealMap {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) :
    maximalIdeal A →+ maximalIdeal B where
  toFun x := ⟨f.hom x, by
    let _ : IsLocalHom f.hom.toRingHom := f.isLocal
    change (x : A) ∈ (maximalIdeal B).comap f.hom.toRingHom
    simpa only [maximalIdeal_comap] using x.2⟩
  map_zero' := by
    apply Subtype.ext
    simp
  map_add' := by
    intro x y
    apply Subtype.ext
    simp

/-- The canonical map
`m_A / (m_Λ A + m_A²) → m_B / (m_Λ B + m_B²)` induced by a morphism `A ⟶ B`. -/
public def relativeCotangentSpaceMap
    {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) :
    relativeCotangentSpaceOverBase A →+ relativeCotangentSpaceOverBase B := by
  apply QuotientAddGroup.map _ _ (maximalIdealMap f)
  let _ : IsLocalHom f.hom.toRingHom := f.isLocal
  intro x hx
  change f.hom x ∈ (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ B) +
    maximalIdeal B ^ 2
  change (x : A) ∈ (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ A) +
    maximalIdeal A ^ 2 at hx
  have h : (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ A) +
      maximalIdeal A ^ 2 ≤
      ((RingHom.ker (algebraMap Λ k)).map (algebraMap Λ B) +
        maximalIdeal B ^ 2).comap f.hom.toRingHom := by
    rw [← Ideal.map_le_iff_le_comap]
    change (((RingHom.ker (algebraMap Λ k)).map (algebraMap Λ A) ⊔
      maximalIdeal A ^ 2).map f.hom.toRingHom) ≤
        (RingHom.ker (algebraMap Λ k)).map (algebraMap Λ B) ⊔ maximalIdeal B ^ 2
    rw [Ideal.map_sup]
    apply add_le_add
    · rw [Ideal.map_map]
      have hfcomp : f.hom.toRingHom.comp (algebraMap Λ A) = algebraMap Λ B := by
        ext a
        exact f.hom.commutes a
      rw [hfcomp]
    · rw [Ideal.map_pow]
      exact pow_le_pow_left' (map_maximalIdeal_le f.hom.toRingHom) 2
  exact h hx

private lemma residue_surjective {A B : ArtinianLocalAlgCat.{u, v, w} Λ k}
    (f : A ⟶ B) :
    Function.Surjective ((Ideal.Quotient.mk (maximalIdeal B)).comp f.hom.toRingHom) := by
  intro z
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
    (A.residueEquiv.symm (B.residueEquiv (residue B y)))
  refine ⟨a, ?_⟩
  apply B.residueEquiv.injective
  change B.residueEquiv (residue B (f.hom a)) =
    B.residueEquiv (residue B y)
  rw [f.residue_comm]
  change A.residueEquiv ((Ideal.Quotient.mk (maximalIdeal A)) a) = _
  rw [ha]
  simp

/-- A morphism is surjective as soon as its image generates the maximal ideal of the target
modulo the cotangent projection. -/
private lemma surjective_of_map_toCotangent_eq_top {A B : ArtinianLocalAlgCat.{u, v, w} Λ k}
    (f : A ⟶ B)
    (hM : (Submodule.comap (maximalIdeal B).subtype
      ((maximalIdeal A).map f.hom.toRingHom)).map (maximalIdeal B).toCotangent = ⊤) :
    Function.Surjective f.hom := by
  have hMtop := IsLocalRing.CotangentSpace.map_eq_top_iff.mp hM
  have hmap : (maximalIdeal A).map f.hom.toRingHom = maximalIdeal B := by
    apply le_antisymm (map_maximalIdeal_le f.hom.toRingHom)
    intro y hy
    have : (⟨y, hy⟩ : maximalIdeal B) ∈ Submodule.comap (maximalIdeal B).subtype
      ((maximalIdeal A).map f.hom.toRingHom) := hMtop.symm ▸ Submodule.mem_top
    exact this
  have : IsHausdorff ((maximalIdeal A).map f.hom.toRingHom) B := hmap.symm ▸ inferInstance
  have : IsPrecomplete (maximalIdeal A) A := inferInstance
  have hres' : Function.Surjective
      ((Ideal.Quotient.mk ((maximalIdeal A).map f.hom.toRingHom)).comp f.hom.toRingHom) := by
    rw [hmap]
    exact residue_surjective f
  exact surjective_of_mk_map_comp_surjective (I := maximalIdeal A) f.hom.toRingHom hres'

/-- A morphism of Artinian local algebras is surjective exactly when its canonical map
`m_A / m_A² → m_B / m_B²` is surjective. -/
@[stacks 06S3 "conditions (1) and (2)"]
public theorem surjective_iff_cotangentSpaceMap_surjective
    {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) :
    Function.Surjective f.hom ↔
      Function.Surjective
        (Ideal.mapCotangent (maximalIdeal A) (maximalIdeal B) f.hom
          (by
            let _ : IsLocalHom f.hom.toRingHom := f.isLocal
            intro x hx
            change x ∈ (maximalIdeal B).comap f.hom.toRingHom
            simpa only [maximalIdeal_comap] using hx)) := by
  let I := maximalIdeal A
  let J := maximalIdeal B
  let g := Ideal.mapCotangent I J f.hom (by
    let _ : IsLocalHom f.hom.toRingHom := f.isLocal
    intro x hx
    change x ∈ J.comap f.hom.toRingHom
    rw [maximalIdeal_comap]
    exact hx)
  change Function.Surjective f.hom ↔ Function.Surjective g
  constructor
  · intro hf z
    obtain ⟨y, rfl⟩ := J.toCotangent_surjective z
    obtain ⟨x, hx⟩ := hf y
    have hxm : x ∈ I := by
      let _ : IsLocalHom f.hom.toRingHom := f.isLocal
      change x ∈ maximalIdeal A
      rw [← maximalIdeal_comap (f := f.hom.toRingHom)]
      change f.hom x ∈ maximalIdeal B
      exact hx ▸ y.2
    refine ⟨I.toCotangent ⟨x, hxm⟩, ?_⟩
    simpa only [g, Ideal.mapCotangent_toCotangent] using
      congrArg J.toCotangent (Subtype.ext hx)
  · intro hg
    let M : Submodule B J := Submodule.comap J.subtype (I.map f.hom.toRingHom)
    have hM : M.map J.toCotangent = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨x, rfl⟩ := hg z
      obtain ⟨a, rfl⟩ := I.toCotangent_surjective x
      change (Ideal.mapCotangent I J f.hom _ (I.toCotangent a)) ∈ _
      rw [Ideal.mapCotangent_toCotangent]
      exact Submodule.mem_map_of_mem (Ideal.mem_map_of_mem f.hom.toRingHom a.2)
    exact surjective_of_map_toCotangent_eq_top f hM

/-- Surjectivity on `m / m²` is equivalent to surjectivity after also quotienting by the
extension of the maximal ideal of the base. -/
@[stacks 06S3 "conditions (2) and (3)"]
public theorem cotangentSpaceMap_surjective_iff_relativeCotangentSpaceMap_surjective
    {A B : ArtinianLocalAlgCat.{u, v, w} Λ k} (f : A ⟶ B) :
    Function.Surjective
        (Ideal.mapCotangent (maximalIdeal A) (maximalIdeal B) f.hom
          (by
            let _ : IsLocalHom f.hom.toRingHom := f.isLocal
            intro x hx
            change x ∈ (maximalIdeal B).comap f.hom.toRingHom
            simpa only [maximalIdeal_comap] using hx)) ↔
      Function.Surjective (relativeCotangentSpaceMap f) := by
  let I := maximalIdeal A
  let J := maximalIdeal B
  let K := RingHom.ker (algebraMap Λ k)
  have hbaseA : K.map (algebraMap Λ A) ≤ I := by
    rw [Ideal.map_le_iff_le_comap]
    intro t ht
    apply (residue_eq_zero_iff (algebraMap Λ A t)).mp
    apply A.residueEquiv.injective
    rw [map_zero]
    exact (A.residueEquiv.commutes t).trans (RingHom.mem_ker.mp ht)
  have hbaseB : K.map (algebraMap Λ B) ≤ I.map f.hom.toRingHom := by
    rw [← f.hom.comp_algebraMap, ← Ideal.map_map]
    exact Ideal.map_mono hbaseA
  let g := Ideal.mapCotangent I J f.hom (by
    let _ : IsLocalHom f.hom.toRingHom := f.isLocal
    intro x hx
    change x ∈ J.comap f.hom.toRingHom
    rw [maximalIdeal_comap]
    exact hx)
  constructor
  · intro hg z
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective (relativeCotangentSubmodule B) z
    obtain ⟨x, hx⟩ := hg (J.toCotangent y)
    obtain ⟨a, rfl⟩ := I.toCotangent_surjective x
    refine ⟨Submodule.mkQ (relativeCotangentSubmodule A) a, ?_⟩
    change Submodule.mkQ (relativeCotangentSubmodule B) (maximalIdealMap f a) =
      Submodule.mkQ (relativeCotangentSubmodule B) y
    apply (Submodule.Quotient.eq _).mpr
    change ((maximalIdealMap f a - y : J) : B) ∈ K.map (algebraMap Λ B) + J ^ 2
    have hsquare : ((maximalIdealMap f a - y : J) : B) ∈ J ^ 2 := by
      apply (J.toCotangent_eq).mp
      change g (I.toCotangent a) = J.toCotangent y at hx
      convert hx using 1
      apply congrArg
      apply Subtype.ext
      rfl
    exact (le_sup_right : J ^ 2 ≤ K.map (algebraMap Λ B) + J ^ 2) hsquare
  · intro hr
    let M : Submodule B J := Submodule.comap J.subtype (I.map f.hom.toRingHom)
    have hmapJ : I.map f.hom.toRingHom ≤ J := map_maximalIdeal_le f.hom.toRingHom
    have hM : M.map J.toCotangent = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨y, rfl⟩ := J.toCotangent_surjective z
      obtain ⟨x, hx⟩ := hr (Submodule.mkQ (relativeCotangentSubmodule B) y)
      obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective (relativeCotangentSubmodule A) x
      have hd : (maximalIdealMap f a - y : J) ∈ relativeCotangentSubmodule B :=
        (Submodule.Quotient.eq _).mp hx
      change (((maximalIdealMap f a - y : J) : B)) ∈
        K.map (algebraMap Λ B) + J ^ 2 at hd
      obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hd
      have huJ : u ∈ J := hmapJ (hbaseB hu)
      have huM : (⟨u, huJ⟩ : J) ∈ M := hbaseB hu
      have haM : maximalIdealMap f a ∈ M :=
        Ideal.mem_map_of_mem f.hom.toRingHom a.2
      have heq : J.toCotangent (maximalIdealMap f a - y) =
          J.toCotangent (⟨u, huJ⟩ : J) := by
        apply (J.toCotangent_eq).mpr
        change ((maximalIdealMap f a : B) - y - u) ∈ J ^ 2
        have hh : (maximalIdealMap f a : B) - y = u + v := by simpa using huv.symm
        rw [hh]
        simpa using hv
      have heq' : J.toCotangent y = J.toCotangent (maximalIdealMap f a) -
          J.toCotangent (⟨u, huJ⟩ : J) := by
        have hh : J.toCotangent (maximalIdealMap f a) - J.toCotangent y =
            J.toCotangent (⟨u, huJ⟩ : J) := by simpa using heq
        exact (sub_eq_iff_eq_add).mp hh ▸ by abel
      rw [heq']
      exact sub_mem (Submodule.mem_map_of_mem haM) (Submodule.mem_map_of_mem huM)
    have hf := surjective_of_map_toCotangent_eq_top f hM
    exact (surjective_iff_cotangentSpaceMap_surjective f).mp hf

end ArtinianLocalAlgCat

end

end Deformation
