namespace Stacks.Descent

/-! ### Reflecting exactness from a contraction of the base change -/

section Reflect

open _root_.Stacks.Descent.C1573
variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Module.FaithfullyFlat A B]
  {P₀ P₁ P₂ : Type*} [AddCommGroup P₀] [AddCommGroup P₁] [AddCommGroup P₂]
  [Module A P₀] [Module A P₁] [Module A P₂]

/-- **Exactness reflected from a contraction of the base change.** Let `d₀ : P₀ → P₁`,
`d₁ : P₁ → P₂` be a complex of `A`-modules and `A → B` faithfully flat. Suppose there are
additive maps `ι₀ : B ⊗[A] P₀ → P₁` surjective, `ι₁ : B ⊗[A] P₁ → P₂` injective,
`h : B ⊗[A] P₁ → P₁`, `h₂ : B ⊗[A] P₂ → P₂` and `d₁' : P₁ → P₂` with
`ι₁ ∘ (B ⊗ d₀) = d₁' ∘ ι₀` and `ι₁ = h₂ ∘ (B ⊗ d₁) + d₁' ∘ h`. Then `P₀ → P₁ → P₂` is exact. -/
theorem C1573.exact_of_lTensor_contraction (d₀ : P₀ →ₗ[A] P₁) (d₁ : P₁ →ₗ[A] P₂)
    (hd : d₁ ∘ₗ d₀ = 0)
    (ι₀ : B ⊗[A] P₀ →+ P₁) (hι₀ : Function.Surjective ι₀)
    (ι₁ : B ⊗[A] P₁ →+ P₂) (hι₁ : Function.Injective ι₁)
    (h : B ⊗[A] P₁ →+ P₁) (h₂ : B ⊗[A] P₂ →+ P₂) (d₁' : P₁ →+ P₂)
    (hcomm : ∀ z, ι₁ (d₀.lTensor B z) = d₁' (ι₀ z))
    (hcontr : ∀ z, ι₁ z = h₂ (d₁.lTensor B z) + d₁' (h z)) :
    Function.Exact d₀ d₁ := by
  refine Module.FaithfullyFlat.lTensor_reflects_exact A B d₀ d₁ fun z ↦ ⟨fun hz ↦ ?_, ?_⟩
  · obtain ⟨w, hw⟩ := hι₀ (h z)
    refine ⟨w, hι₁ ?_⟩
    rw [hcomm, hw, hcontr z, hz, map_zero, zero_add]
  · rintro ⟨w, rfl⟩
    rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hd, LinearMap.lTensor_zero,
      LinearMap.zero_apply]

end Reflect

/-! ### Graded pieces of the adic filtration -/

section Graded

open _root_.Stacks.Descent.C1573
variable {R : Type*} [CommRing R]

/-- The `k`-th graded piece `I^k / I^{k+1}` of the `I`-adic filtration of a ring `R`, as the
quotient of the `R`-module `I^k` by `I • I^k`. -/
abbrev C1573.AdicGradedPiece (I : Ideal R) (k : ℕ) : Type _ :=
  ↥(I ^ k) ⧸ (I • ⊤ : Submodule R ↥(I ^ k))

namespace C1573.AdicGradedPiece

/-- The class in `I^k / I^{k+1}` of an element of `I^k`. -/
def mk (I : Ideal R) {k : ℕ} (x : R) (hx : x ∈ I ^ k) : AdicGradedPiece I k :=
  Submodule.Quotient.mk ⟨x, hx⟩

/-- An element of `I^k` lies in `I • I^k` if and only if it lies in `I^{k+1}`. -/
theorem mem_smul_top_iff' (I : Ideal R) {k : ℕ} (x : ↥(I ^ k)) :
    x ∈ (I • ⊤ : Submodule R ↥(I ^ k)) ↔ (x : R) ∈ I ^ (k + 1) := by
  rw [Submodule.mem_smul_top_iff, smul_eq_mul, ← pow_succ']

/-- Two elements of `I^k` have the same class in `I^k / I^{k+1}` if and only if their
difference lies in `I^{k+1}`. -/
theorem mk_eq_mk_iff (I : Ideal R) {k : ℕ} {x y : R} (hx : x ∈ I ^ k) (hy : y ∈ I ^ k) :
    mk I x hx = mk I y hy ↔ x - y ∈ I ^ (k + 1) := by
  rw [mk, mk, Submodule.Quotient.eq, mem_smul_top_iff']
  rfl

/-- The class of an element of `I^k` in `I^k / I^{k+1}` vanishes if and only if the element
lies in `I^{k+1}`. -/
theorem mk_eq_zero_iff (I : Ideal R) {k : ℕ} {x : R} (hx : x ∈ I ^ k) :
    mk I x hx = 0 ↔ x ∈ I ^ (k + 1) := by
  rw [mk, Submodule.Quotient.mk_eq_zero, mem_smul_top_iff']

/-- The class of a sum is the sum of the classes. -/
@[simp]
theorem mk_add (I : Ideal R) {k : ℕ} {x y : R} (hx : x ∈ I ^ k) (hy : y ∈ I ^ k) :
    mk I (x + y) (add_mem hx hy) = mk I x hx + mk I y hy :=
  rfl

/-- The class of a difference is the difference of the classes. -/
@[simp]
theorem mk_sub (I : Ideal R) {k : ℕ} {x y : R} (hx : x ∈ I ^ k) (hy : y ∈ I ^ k) :
    mk I (x - y) (sub_mem hx hy) = mk I x hx - mk I y hy :=
  rfl

/-- The class of `0` is `0`. -/
@[simp]
theorem mk_zero (I : Ideal R) {k : ℕ} : mk I (0 : R) (zero_mem (I ^ k)) = 0 :=
  rfl

/-- The scalar `r` acts on the class of `x` as the class of `r * x`. -/
theorem smul_mk (I : Ideal R) {k : ℕ} (r x : R) (hx : x ∈ I ^ k) :
    r • mk I x hx = mk I (r * x) (Ideal.mul_mem_left _ r hx) :=
  rfl

/-- Every element of `I^k / I^{k+1}` is the class of an element of `I^k`. -/
theorem mk_surjective (I : Ideal R) {k : ℕ} (z : AdicGradedPiece I k) :
    ∃ (x : R) (hx : x ∈ I ^ k), mk I x hx = z := by
  obtain ⟨⟨x, hx⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  exact ⟨x, hx, rfl⟩

/-- A property holding for the class of every element of `I^k` holds for every element of
`I^k / I^{k+1}`. -/
theorem induction_on (I : Ideal R) {k : ℕ} {motive : AdicGradedPiece I k → Prop}
    (z : AdicGradedPiece I k) (h : ∀ (x : R) (hx : x ∈ I ^ k), motive (mk I x hx)) :
    motive z := by
  obtain ⟨x, hx, rfl⟩ := mk_surjective I z
  exact h x hx

/-- The class of `r • x` in `I^k / I^{k+1}` only depends on `r` modulo `I`. -/
theorem smul_mk_of_sub_mem (I : Ideal R) {k : ℕ} {r r' : R} (hr : r - r' ∈ I) (x : R)
    (hx : x ∈ I ^ k) : r • mk I x hx = r' • mk I x hx := by
  rw [smul_mk, smul_mk, mk_eq_mk_iff, ← sub_mul, pow_succ']
  exact Ideal.mul_mem_mul hr hx

variable {R' : Type*} [CommRing R']

/-- The map `I^k / I^{k+1} → I'^k / I'^{k+1}` induced by a ring map carrying `I` into `I'`. -/
def map (φ : R →+* R') {I : Ideal R} {I' : Ideal R'} (h : I.map φ ≤ I') (k : ℕ) :
    AdicGradedPiece I k →ₛₗ[φ] AdicGradedPiece I' k :=
  Submodule.mapQ _ _
    { toFun := fun x ↦ ⟨φ x, Ideal.pow_right_mono h k (by
        rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem φ x.2)⟩
      map_add' := fun x y ↦ Subtype.ext (map_add φ _ _)
      map_smul' := fun r x ↦ Subtype.ext (map_mul φ _ _) }
    (fun x hx ↦ by
      rw [Submodule.mem_comap, mem_smul_top_iff']
      rw [mem_smul_top_iff'] at hx
      change φ x ∈ I' ^ (k + 1)
      exact Ideal.pow_right_mono h (k + 1) (by
        rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem φ hx))

/-- The induced map sends the class of `x` to the class of `φ x`. -/
@[simp]
theorem map_mk (φ : R →+* R') {I : Ideal R} {I' : Ideal R'} (h : I.map φ ≤ I') {k : ℕ} (x : R)
    (hx : x ∈ I ^ k) :
    map φ h k (mk I x hx) = mk I' (φ x)
      (Ideal.pow_right_mono h k (by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem φ hx)) :=
  rfl

end C1573.AdicGradedPiece

end Graded

/-! ### The situation -/

open _root_.Stacks.Descent.C1573
/-- **The data of a nilpotent invariant ideal over the Čech nerve of a faithfully flat map.**
A ring `B'` with two maps `s, t : B' → C'` to a ring `C'` and three maps
`p₀₁ = algebraMap, p₀₂, p₁₂ : C' → D'` satisfying the cosimplicial identities, with `C' → D'`
flat; a surjection `π : B' → B` whose kernel `J` extends along `s` to the kernel of a surjection
`ρ : C' → C`, killed by `t` as well; a surjection `σ : D' → D` whose kernel is the extension of
`ker ρ` along `p₀₁`; maps `s̄, t̄ : B → C` and `q₀₁, q₀₂, q₁₂ : C → D` induced by the primed ones;
a faithfully flat `A → B` such that the images of `s̄, t̄` generate `C` and agree on `A`; and a
ring map `τ : D → B ⊗[A] C` which sends `q₀₁` to the right factor and `q₁₂ ∘ t̄` to the left.

These are the global sections of an affine étale chart `U'` of an algebraic space `X'`, of
`U' ×_{X'} U'` and `U' ×_{X'} U' ×_{X'} U'`, and of their restrictions to a closed subspace
`X ⊂ X'` with the same points which is the spectrum of `A`. -/
structure C1573.EqualizerLiftData (A B B' C' D' C D : Type*) [CommRing A] [CommRing B] [CommRing B']
    [CommRing C'] [CommRing D'] [CommRing C] [CommRing D] [Algebra A B] [Algebra A C]
    [Algebra C' D'] where
  /-- The reduction of the chart. -/
  π : B' →+* B
  surjective_π : Function.Surjective π
  /-- The first projection of the double overlap. -/
  s : B' →+* C'
  /-- The second projection of the double overlap. -/
  t : B' →+* C'
  /-- The reduction of the double overlap. -/
  ρ : C' →+* C
  surjective_ρ : Function.Surjective ρ
  ker_ρ : RingHom.ker ρ = (RingHom.ker π).map s
  /-- The first projection of the reduced double overlap. -/
  sb : B →+* C
  /-- The second projection of the reduced double overlap. -/
  tb : B →+* C
  ρ_comp_s : ρ.comp s = sb.comp π
  ρ_comp_t : ρ.comp t = tb.comp π
  sb_comp_algebraMap : sb.comp (algebraMap A B) = algebraMap A C
  tb_comp_algebraMap : tb.comp (algebraMap A B) = algebraMap A C
  closure_range : Subring.closure (Set.range sb ∪ Set.range tb) = ⊤
  /-- The projection of the triple overlap onto the factors `0, 2`. -/
  p₀₂ : C' →+* D'
  /-- The projection of the triple overlap onto the factors `1, 2`. -/
  p₁₂ : C' →+* D'
  p₀₁_comp_s : (algebraMap C' D').comp s = p₀₂.comp s
  p₀₁_comp_t : (algebraMap C' D').comp t = p₁₂.comp s
  p₀₂_comp_t : p₀₂.comp t = p₁₂.comp t
  /-- The coface `p₀₁ : C' → D'` is flat. -/
  flat : Module.Flat C' D'
  /-- The reduction of the triple overlap. -/
  σ : D' →+* D
  surjective_σ : Function.Surjective σ
  ker_σ : RingHom.ker σ = (RingHom.ker ρ).map (algebraMap C' D')
  /-- The projection of the reduced triple overlap onto the factors `0, 1`. -/
  q₀₁ : C →+* D
  /-- The projection of the reduced triple overlap onto the factors `0, 2`. -/
  q₀₂ : C →+* D
  /-- The projection of the reduced triple overlap onto the factors `1, 2`. -/
  q₁₂ : C →+* D
  σ_comp_p₀₁ : σ.comp (algebraMap C' D') = q₀₁.comp ρ
  σ_comp_p₀₂ : σ.comp p₀₂ = q₀₂.comp ρ
  σ_comp_p₁₂ : σ.comp p₁₂ = q₁₂.comp ρ
  /-- The comparison of the reduced triple overlap with `B ⊗[A] C`. -/
  τ : D →+* B ⊗[A] C
  τ_comp_q₀₁ : τ.comp q₀₁ = Algebra.TensorProduct.includeRight.toRingHom
  τ_comp_e₂ : τ.comp (q₁₂.comp tb) = Algebra.TensorProduct.includeLeftRingHom

/-- If `ρ ∘ f = g ∘ π`, then `f` carries `ker π` into `ker ρ`. -/
private theorem map_ker_le_ker_of_comp {R S R' S' : Type*} [CommRing R] [CommRing S]
    [CommRing R'] [CommRing S'] (π : R →+* R') (ρ : S →+* S') (f : R →+* S) (g : R' →+* S')
    (h : ρ.comp f = g.comp π) : (RingHom.ker π).map f ≤ RingHom.ker ρ := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, h, RingHom.comp_apply,
    RingHom.mem_ker.1 hx, map_zero]

namespace C1573.EqualizerLiftData

variable {A B B' C' D' C D : Type*} [CommRing A] [CommRing B] [CommRing B'] [CommRing C']
  [CommRing D'] [CommRing C] [CommRing D] [Algebra A B] [Algebra A C] [Algebra C' D']
  (E : EqualizerLiftData A B B' C' D' C D)

/-- The kernel `J` of the reduction of the chart. -/
abbrev J : Ideal B' := RingHom.ker E.π

/-- The kernel `JC'` of the reduction of the double overlap. -/
abbrev I : Ideal C' := RingHom.ker E.ρ

/-- The kernel `JD'` of the reduction of the triple overlap. -/
abbrev K : Ideal D' := RingHom.ker E.σ

/-- The projection of the reduced triple overlap to its last factor. -/
abbrev e₂ : B →+* D := E.q₁₂.comp E.tb

/-! #### Identities between the reduced maps -/

/-- The reduced maps satisfy `q₀₂ ∘ t̄ = q₁₂ ∘ t̄`. -/
theorem q₀₂_comp_tb : E.q₀₂.comp E.tb = E.q₁₂.comp E.tb := by
  ext b
  obtain ⟨b, rfl⟩ := E.surjective_π b
  have h₁ := congr($(E.σ_comp_p₀₂) (E.t b))
  have h₂ := congr($(E.σ_comp_p₁₂) (E.t b))
  have h₃ := congr($(E.ρ_comp_t) b)
  have h₄ := congr($(E.p₀₂_comp_t) b)
  simp only [RingHom.comp_apply] at h₁ h₂ h₃ h₄
  simp only [RingHom.comp_apply, ← h₃, ← h₁, ← h₂, h₄]

/-- The reduced maps satisfy `q₀₁ ∘ s̄ = q₀₂ ∘ s̄`. -/
theorem q₀₁_comp_sb : E.q₀₁.comp E.sb = E.q₀₂.comp E.sb := by
  ext b
  obtain ⟨b, rfl⟩ := E.surjective_π b
  have h₁ := congr($(E.σ_comp_p₀₁) (E.s b))
  have h₂ := congr($(E.σ_comp_p₀₂) (E.s b))
  have h₃ := congr($(E.ρ_comp_s) b)
  have h₄ := congr($(E.p₀₁_comp_s) b)
  simp only [RingHom.comp_apply] at h₁ h₂ h₃ h₄
  simp only [RingHom.comp_apply, ← h₃, ← h₁, ← h₂, h₄]

/-- The reduced maps satisfy `q₀₁ ∘ t̄ = q₁₂ ∘ s̄`. -/
theorem q₀₁_comp_tb : E.q₀₁.comp E.tb = E.q₁₂.comp E.sb := by
  ext b
  obtain ⟨b, rfl⟩ := E.surjective_π b
  have h₁ := congr($(E.σ_comp_p₀₁) (E.t b))
  have h₂ := congr($(E.σ_comp_p₁₂) (E.s b))
  have h₃ := congr($(E.ρ_comp_s) b)
  have h₃' := congr($(E.ρ_comp_t) b)
  have h₄ := congr($(E.p₀₁_comp_t) b)
  simp only [RingHom.comp_apply] at h₁ h₂ h₃ h₃' h₄
  simp only [RingHom.comp_apply, ← h₃, ← h₃', ← h₁, ← h₂, h₄]

/-- The maps `q₀₂` and `q₀₁` agree on the image of `A` in `C`. -/
theorem q₀₂_comp_algebraMap : E.q₀₂.comp (algebraMap A C) = E.q₀₁.comp (algebraMap A C) := by
  rw [← E.sb_comp_algebraMap, ← RingHom.comp_assoc, ← RingHom.comp_assoc, E.q₀₁_comp_sb]

/-- The maps `q₁₂` and `q₀₁` agree on the image of `A` in `C`. -/
theorem q₁₂_comp_algebraMap : E.q₁₂.comp (algebraMap A C) = E.q₀₁.comp (algebraMap A C) := by
  rw [← E.sb_comp_algebraMap, ← RingHom.comp_assoc, ← E.q₀₁_comp_tb, RingHom.comp_assoc,
    E.tb_comp_algebraMap, E.sb_comp_algebraMap]

/-- On `A`, the projection `e₂ : B → D` agrees with `q₀₁ : C → D`. -/
theorem e₂_comp_algebraMap : E.e₂.comp (algebraMap A B) = E.q₀₁.comp (algebraMap A C) := by
  rw [RingHom.comp_assoc, E.tb_comp_algebraMap, E.q₁₂_comp_algebraMap]

/-- The map `s` carries `J` into `JC'`. -/
theorem map_s_le : E.J.map E.s ≤ E.I := E.ker_ρ.ge

/-- The map `t` carries `J` into `JC'`. -/
theorem map_t_le : E.J.map E.t ≤ E.I := map_ker_le_ker_of_comp E.π E.ρ E.t E.tb E.ρ_comp_t

/-- The map `p₀₁` carries `JC'` into `JD'`. -/
theorem map_p₀₁_le : E.I.map (algebraMap C' D') ≤ E.K := E.ker_σ.ge

/-- The map `p₀₂` carries `JC'` into `JD'`. -/
theorem map_p₀₂_le : E.I.map E.p₀₂ ≤ E.K :=
  map_ker_le_ker_of_comp E.ρ E.σ E.p₀₂ E.q₀₂ E.σ_comp_p₀₂

/-- The map `p₁₂` carries `JC'` into `JD'`. -/
theorem map_p₁₂_le : E.I.map E.p₁₂ ≤ E.K :=
  map_ker_le_ker_of_comp E.ρ E.σ E.p₁₂ E.q₁₂ E.σ_comp_p₁₂

/-! #### The graded pieces and their module structures -/

/-- The graded piece `J^k / J^{k+1}` of the chart. -/
abbrev P₀ (k : ℕ) : Type _ := AdicGradedPiece E.J k

/-- The graded piece `JC'^k / JC'^{k+1}` of the double overlap. -/
abbrev P₁ (k : ℕ) : Type _ := AdicGradedPiece E.I k

/-- The graded piece `JD'^k / JD'^{k+1}` of the triple overlap. -/
abbrev P₂ (k : ℕ) : Type _ := AdicGradedPiece E.K k

/-- The `B = B'/J`-module structure on `J^k/J^{k+1}`. -/
instance moduleP₀ (k : ℕ) : Module B (E.P₀ k) :=
  Module.compHom _ (RingHom.quotientKerEquivOfSurjective E.surjective_π).symm.toRingHom

/-- The `C = C'/JC'`-module structure on `JC'^k/JC'^{k+1}`. -/
instance moduleP₁ (k : ℕ) : Module C (E.P₁ k) :=
  Module.compHom _ (RingHom.quotientKerEquivOfSurjective E.surjective_ρ).symm.toRingHom

/-- The `D = D'/JD'`-module structure on `JD'^k/JD'^{k+1}`. -/
instance moduleP₂ (k : ℕ) : Module D (E.P₂ k) :=
  Module.compHom _ (RingHom.quotientKerEquivOfSurjective E.surjective_σ).symm.toRingHom

/-- The `A`-module structure on `J^k/J^{k+1}` through `A → B`. -/
instance moduleAP₀ (k : ℕ) : Module A (E.P₀ k) := Module.compHom _ (algebraMap A B)

/-- The `A`-module structure on `JC'^k/JC'^{k+1}` through `A → C`. -/
instance moduleAP₁ (k : ℕ) : Module A (E.P₁ k) := Module.compHom _ (algebraMap A C)

/-- The `A`-module structure on `JD'^k/JD'^{k+1}` through `q₀₁ ∘ (A → C)`. -/
instance moduleAP₂ (k : ℕ) : Module A (E.P₂ k) :=
  Module.compHom _ (E.q₀₁.comp (algebraMap A C))

/-- An element of `A` acts on `J^k/J^{k+1}` through its image in `B`. -/
theorem algebraMap_smul₀ {k : ℕ} (a : A) (x : E.P₀ k) : a • x = algebraMap A B a • x := rfl

/-- An element of `A` acts on `JC'^k/JC'^{k+1}` through its image in `C`. -/
theorem algebraMap_smul₁ {k : ℕ} (a : A) (x : E.P₁ k) : a • x = algebraMap A C a • x := rfl

/-- An element of `A` acts on `JD'^k/JD'^{k+1}` through its image under `q₀₁` in `D`. -/
theorem algebraMap_smul₂ {k : ℕ} (a : A) (x : E.P₂ k) :
    a • x = E.q₀₁ (algebraMap A C a) • x := rfl

/-- An element of `B'` acts on `J^k/J^{k+1}` through its reduction in `B`. -/
theorem π_smul {k : ℕ} (b : B') (x : E.P₀ k) : E.π b • x = b • x := by
  induction x using Submodule.Quotient.induction_on with
  | H m =>
    show (RingHom.quotientKerEquivOfSurjective E.surjective_π).symm (E.π b) •
      (Submodule.Quotient.mk m : E.P₀ k) = _
    rw [RingHom.quotientKerEquivOfSurjective_symm_apply]
    rfl

/-- An element of `C'` acts on `JC'^k/JC'^{k+1}` through its reduction in `C`. -/
theorem ρ_smul {k : ℕ} (c : C') (x : E.P₁ k) : E.ρ c • x = c • x := by
  induction x using Submodule.Quotient.induction_on with
  | H m =>
    show (RingHom.quotientKerEquivOfSurjective E.surjective_ρ).symm (E.ρ c) •
      (Submodule.Quotient.mk m : E.P₁ k) = _
    rw [RingHom.quotientKerEquivOfSurjective_symm_apply]
    rfl

/-- An element of `D'` acts on `JD'^k/JD'^{k+1}` through its reduction in `D`. -/
theorem σ_smul {k : ℕ} (d : D') (x : E.P₂ k) : E.σ d • x = d • x := by
  induction x using Submodule.Quotient.induction_on with
  | H m =>
    show (RingHom.quotientKerEquivOfSurjective E.surjective_σ).symm (E.σ d) •
      (Submodule.Quotient.mk m : E.P₂ k) = _
    rw [RingHom.quotientKerEquivOfSurjective_symm_apply]
    rfl

/-- The actions of `A` and `C` on `JC'^k/JC'^{k+1}` form a scalar tower. -/
instance isScalarTower₁ (k : ℕ) : IsScalarTower A C (E.P₁ k) :=
  ⟨fun a c x ↦ by rw [algebraMap_smul₁, Algebra.smul_def, mul_smul]⟩

/-! #### The induced maps on graded pieces -/

/-- The map `J^k/J^{k+1} → JC'^k/JC'^{k+1}` induced by `s`. -/
abbrev gs (k : ℕ) : E.P₀ k →ₛₗ[E.s] E.P₁ k := AdicGradedPiece.map E.s E.map_s_le k

/-- The map `J^k/J^{k+1} → JC'^k/JC'^{k+1}` induced by `t`. -/
abbrev gt (k : ℕ) : E.P₀ k →ₛₗ[E.t] E.P₁ k := AdicGradedPiece.map E.t E.map_t_le k

/-- The map `JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}` induced by `p₀₁`. -/
abbrev g₀₁ (k : ℕ) : E.P₁ k →ₛₗ[algebraMap C' D'] E.P₂ k :=
  AdicGradedPiece.map (algebraMap C' D') E.map_p₀₁_le k

/-- The map `JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}` induced by `p₀₂`. -/
abbrev g₀₂ (k : ℕ) : E.P₁ k →ₛₗ[E.p₀₂] E.P₂ k := AdicGradedPiece.map E.p₀₂ E.map_p₀₂_le k

/-- The map `JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}` induced by `p₁₂`. -/
abbrev g₁₂ (k : ℕ) : E.P₁ k →ₛₗ[E.p₁₂] E.P₂ k := AdicGradedPiece.map E.p₁₂ E.map_p₁₂_le k

/-- The map induced by `s` is semilinear along `s̄ : B → C`. -/
theorem gs_smul {k : ℕ} (b : B) (x : E.P₀ k) : E.gs k (b • x) = E.sb b • E.gs k x := by
  obtain ⟨b, rfl⟩ := E.surjective_π b
  rw [π_smul, LinearMap.map_smulₛₗ, ← ρ_smul, ← RingHom.comp_apply, E.ρ_comp_s,
    RingHom.comp_apply]

/-- The map induced by `t` is semilinear along `t̄ : B → C`. -/
theorem gt_smul {k : ℕ} (b : B) (x : E.P₀ k) : E.gt k (b • x) = E.tb b • E.gt k x := by
  obtain ⟨b, rfl⟩ := E.surjective_π b
  rw [π_smul, LinearMap.map_smulₛₗ, ← ρ_smul, ← RingHom.comp_apply, E.ρ_comp_t,
    RingHom.comp_apply]

/-- The map induced by `p₀₁` is semilinear along `q₀₁ : C → D`. -/
theorem g₀₁_smul {k : ℕ} (c : C) (x : E.P₁ k) : E.g₀₁ k (c • x) = E.q₀₁ c • E.g₀₁ k x := by
  obtain ⟨c, rfl⟩ := E.surjective_ρ c
  rw [ρ_smul, LinearMap.map_smulₛₗ, ← σ_smul, ← RingHom.comp_apply, E.σ_comp_p₀₁,
    RingHom.comp_apply]

/-- The map induced by `p₀₂` is semilinear along `q₀₂ : C → D`. -/
theorem g₀₂_smul {k : ℕ} (c : C) (x : E.P₁ k) : E.g₀₂ k (c • x) = E.q₀₂ c • E.g₀₂ k x := by
  obtain ⟨c, rfl⟩ := E.surjective_ρ c
  rw [ρ_smul, LinearMap.map_smulₛₗ, ← σ_smul, ← RingHom.comp_apply, E.σ_comp_p₀₂,
    RingHom.comp_apply]

/-- The map induced by `p₁₂` is semilinear along `q₁₂ : C → D`. -/
theorem g₁₂_smul {k : ℕ} (c : C) (x : E.P₁ k) : E.g₁₂ k (c • x) = E.q₁₂ c • E.g₁₂ k x := by
  obtain ⟨c, rfl⟩ := E.surjective_ρ c
  rw [ρ_smul, LinearMap.map_smulₛₗ, ← σ_smul, ← RingHom.comp_apply, E.σ_comp_p₁₂,
    RingHom.comp_apply]

/-! #### The obstruction complex -/

/-- The degree-zero differential `t - s : J^k/J^{k+1} → JC'^k/JC'^{k+1}`, `A`-linear. -/
def d₀ (k : ℕ) : E.P₀ k →ₗ[A] E.P₁ k where
  toFun x := E.gt k x - E.gs k x
  map_add' x y := by rw [map_add, map_add]; abel
  map_smul' a x := by
    rw [RingHom.id_apply, algebraMap_smul₀, algebraMap_smul₁, gt_smul, gs_smul, smul_sub,
      ← RingHom.comp_apply E.tb, ← RingHom.comp_apply E.sb, E.tb_comp_algebraMap,
      E.sb_comp_algebraMap]

/-- The value of `d₀` on `x` is `t x - s x`. -/
theorem d₀_apply {k : ℕ} (x : E.P₀ k) : E.d₀ k x = E.gt k x - E.gs k x := rfl

/-- The degree-one differential `p₁₂ - p₀₂ + p₀₁ : JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}`,
`A`-linear. -/
def d₁ (k : ℕ) : E.P₁ k →ₗ[A] E.P₂ k where
  toFun y := E.g₁₂ k y - E.g₀₂ k y + E.g₀₁ k y
  map_add' x y := by rw [map_add, map_add, map_add]; abel
  map_smul' a y := by
    rw [RingHom.id_apply, algebraMap_smul₁, algebraMap_smul₂, g₁₂_smul, g₀₂_smul, g₀₁_smul,
      smul_add, smul_sub, ← RingHom.comp_apply E.q₁₂, ← RingHom.comp_apply E.q₀₂,
      E.q₁₂_comp_algebraMap, E.q₀₂_comp_algebraMap, RingHom.comp_apply]

/-- The value of `d₁` on `y` is `p₁₂ y - p₀₂ y + p₀₁ y`. -/
theorem d₁_apply {k : ℕ} (y : E.P₁ k) : E.d₁ k y = E.g₁₂ k y - E.g₀₂ k y + E.g₀₁ k y := rfl

/-- If `t b - s b ∈ JC'^k`, its class in `JC'^k/JC'^{k+1}` is a cocycle: `d₁` kills it. -/
private theorem d₁_mk_sub_eq_zero {k : ℕ} (b : B') (hb : E.t b - E.s b ∈ E.I ^ k) :
    E.d₁ k (AdicGradedPiece.mk E.I _ hb) = 0 := by
  have h₁ := congr($(E.p₀₁_comp_s) b)
  have h₂ := congr($(E.p₀₁_comp_t) b)
  have h₃ := congr($(E.p₀₂_comp_t) b)
  simp only [RingHom.comp_apply] at h₁ h₂ h₃
  simp only [d₁_apply, AdicGradedPiece.map_mk]
  simp only [← AdicGradedPiece.mk_sub, ← AdicGradedPiece.mk_add, AdicGradedPiece.mk_eq_zero_iff]
  convert zero_mem (E.K ^ (k + 1)) using 1
  simp only [map_sub, h₁, h₂, h₃]
  ring

/-- The composite `d₁ ∘ d₀` vanishes at every element. -/
theorem d₁_d₀ {k : ℕ} (x : E.P₀ k) : E.d₁ k (E.d₀ k x) = 0 := by
  induction x using AdicGradedPiece.induction_on with
  | h x hx =>
    rw [d₀_apply, AdicGradedPiece.map_mk, AdicGradedPiece.map_mk,
      ← AdicGradedPiece.mk_sub]
    exact E.d₁_mk_sub_eq_zero x _

/-- The obstruction maps form a complex: `d₁ ∘ d₀ = 0`. -/
theorem d₁_comp_d₀ (k : ℕ) : E.d₁ k ∘ₗ E.d₀ k = 0 :=
  LinearMap.ext fun x ↦ E.d₁_d₀ x

/-! #### The comparison maps and the contraction -/

/-- The biadditive map `(b, m) ↦ c b • g m`, for a ring map `c : B → R` and an additive map
`g : M → N` to an `R`-module, on two modules over different rings: it builds the maps out of
`B ⊗[A] -` below. -/
def smulBilin {M N R : Type*} [AddCommGroup M] [AddCommGroup N] [Ring R] [Module R N]
    (c : B →+* R) (g : M →+ N) : B →+ M →+ N :=
  AddMonoidHom.mk' (fun b ↦ AddMonoidHom.mk' (fun m ↦ c b • g m) fun m m' ↦ by
    rw [map_add, smul_add]) fun b b' ↦ by
    ext m; simp [add_smul]

/-- The value of `smulBilin c g` at `(b, m)` is `c b • g m`. -/
@[simp]
theorem smulBilin_apply {M N R : Type*} [AddCommGroup M] [AddCommGroup N] [Ring R] [Module R N]
    (c : B →+* R) (g : M →+ N) (b : B) (m : M) : smulBilin c g b m = c b • g m := rfl

/-- The comparison `B ⊗[A] J^k/J^{k+1} → JC'^k/JC'^{k+1}`, `b ⊗ x ↦ t̄ b • s x`. -/
def ι₀ (k : ℕ) : B ⊗[A] E.P₀ k →+ E.P₁ k :=
  TensorProduct.liftAddHom (smulBilin E.tb (E.gs k).toAddMonoidHom) fun a b x ↦ by
    simp only [smulBilin_apply, LinearMap.toAddMonoidHom_coe]
    rw [algebraMap_smul₀, gs_smul, Algebra.smul_def, map_mul, ← RingHom.comp_apply E.tb,
      ← RingHom.comp_apply E.sb, E.tb_comp_algebraMap, E.sb_comp_algebraMap, mul_smul,
      smul_comm]

/-- The comparison `ι₀` sends `b ⊗ x` to `t̄ b • s x`. -/
@[simp]
theorem ι₀_tmul {k : ℕ} (b : B) (x : E.P₀ k) : E.ι₀ k (b ⊗ₜ x) = E.tb b • E.gs k x := rfl

/-- The comparison `B ⊗[A] JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}`, `b ⊗ y ↦ e₂ b • p₀₁ y`. -/
def ι₁ (k : ℕ) : B ⊗[A] E.P₁ k →+ E.P₂ k :=
  TensorProduct.liftAddHom (smulBilin E.e₂ (E.g₀₁ k).toAddMonoidHom) fun a b y ↦ by
    simp only [smulBilin_apply, LinearMap.toAddMonoidHom_coe]
    rw [algebraMap_smul₁, g₀₁_smul, Algebra.smul_def, map_mul, ← RingHom.comp_apply E.e₂,
      E.e₂_comp_algebraMap, RingHom.comp_apply, mul_smul, smul_comm]

/-- The comparison `ι₁` sends `b ⊗ y` to `e₂ b • p₀₁ y`. -/
@[simp]
theorem ι₁_tmul {k : ℕ} (b : B) (y : E.P₁ k) : E.ι₁ k (b ⊗ₜ y) = E.e₂ b • E.g₀₁ k y := rfl

/-- The contraction `B ⊗[A] JC'^k/JC'^{k+1} → JC'^k/JC'^{k+1}`, `b ⊗ y ↦ -(t̄ b • y)`:
multiplication of the new factor into the last slot. -/
def contr₁ (k : ℕ) : B ⊗[A] E.P₁ k →+ E.P₁ k :=
  TensorProduct.liftAddHom (smulBilin E.tb (-AddMonoidHom.id _)) fun a b y ↦ by
    simp only [smulBilin_apply, AddMonoidHom.neg_apply, AddMonoidHom.id_apply, smul_neg]
    rw [algebraMap_smul₁, Algebra.smul_def, map_mul, ← RingHom.comp_apply E.tb,
      E.tb_comp_algebraMap, mul_smul, smul_comm]

/-- The contraction `contr₁` sends `b ⊗ y` to `-(t̄ b • y)`. -/
@[simp]
theorem contr₁_tmul {k : ℕ} (b : B) (y : E.P₁ k) : E.contr₁ k (b ⊗ₜ y) = -(E.tb b • y) :=
  show E.tb b • (-y) = _ from smul_neg _ _

/-- The contraction `B ⊗[A] JD'^k/JD'^{k+1} → JD'^k/JD'^{k+1}`, `b ⊗ w ↦ e₂ b • w`. -/
def contr₂ (k : ℕ) : B ⊗[A] E.P₂ k →+ E.P₂ k :=
  TensorProduct.liftAddHom (smulBilin E.e₂ (AddMonoidHom.id _)) fun a b w ↦ by
    simp only [smulBilin_apply, AddMonoidHom.id_apply]
    rw [algebraMap_smul₂, Algebra.smul_def, map_mul, ← RingHom.comp_apply E.e₂,
      E.e₂_comp_algebraMap, RingHom.comp_apply, mul_smul, smul_comm]

/-- The contraction `contr₂` sends `b ⊗ w` to `e₂ b • w`. -/
@[simp]
theorem contr₂_tmul {k : ℕ} (b : B) (w : E.P₂ k) : E.contr₂ k (b ⊗ₜ w) = E.e₂ b • w := rfl

/-- The map `p₁₂ - p₀₂ : JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}`. -/
def d₁' (k : ℕ) : E.P₁ k →+ E.P₂ k :=
  (E.g₁₂ k).toAddMonoidHom - (E.g₀₂ k).toAddMonoidHom

/-- The value of `d₁'` on `y` is `p₁₂ y - p₀₂ y`. -/
@[simp]
theorem d₁'_apply {k : ℕ} (y : E.P₁ k) : E.d₁' k y = E.g₁₂ k y - E.g₀₂ k y := rfl

/-- The comparisons intertwine the differentials: `ι₁ ∘ (B ⊗ d₀) = d₁' ∘ ι₀`. -/
theorem ι₁_lTensor_d₀ {k : ℕ} (z : B ⊗[A] E.P₀ k) :
    E.ι₁ k ((E.d₀ k).lTensor B z) = E.d₁' k (E.ι₀ k z) := by
  induction z with
  | zero => simp
  | add z z' h h' => rw [map_add, map_add, h, h', map_add, map_add]
  | tmul b x =>
    have hq : E.q₀₂ (E.tb b) = E.e₂ b := congr($(E.q₀₂_comp_tb) b)
    rw [LinearMap.lTensor_tmul, ι₁_tmul, ι₀_tmul, d₁'_apply, g₁₂_smul, g₀₂_smul, hq]
    show E.e₂ b • _ = E.e₂ b • _ - E.e₂ b • _
    rw [← smul_sub]
    congr 1
    induction x using AdicGradedPiece.induction_on with
    | h x hx =>
      have h₁ := congr($(E.p₀₁_comp_s) x)
      have h₂ := congr($(E.p₀₁_comp_t) x)
      simp only [RingHom.comp_apply] at h₁ h₂
      simp only [d₀_apply, map_sub, AdicGradedPiece.map_mk, h₁, h₂]

/-- The contraction identity `ι₁ = contr₂ ∘ (B ⊗ d₁) + d₁' ∘ contr₁`. -/
theorem ι₁_eq_contr {k : ℕ} (z : B ⊗[A] E.P₁ k) :
    E.ι₁ k z = E.contr₂ k ((E.d₁ k).lTensor B z) + E.d₁' k (E.contr₁ k z) := by
  induction z with
  | zero => simp
  | add z z' h h' => rw [map_add, h, h', map_add, map_add, map_add, map_add]; abel
  | tmul b y =>
    have hq : E.q₀₂ (E.tb b) = E.e₂ b := congr($(E.q₀₂_comp_tb) b)
    rw [LinearMap.lTensor_tmul, ι₁_tmul, contr₂_tmul, contr₁_tmul, map_neg, d₁'_apply,
      g₁₂_smul, g₀₂_smul, hq, d₁_apply]
    show _ = _ + -(E.e₂ b • _ - E.e₂ b • _)
    simp only [smul_add, smul_sub]
    abel

/-! #### Surjectivity of the comparison in degree zero -/

/-- Multiplication by `t̄ b` on the image of `ι₀` is `ι₀` of multiplication by `b` on the left
factor. -/
theorem tb_smul_ι₀ {k : ℕ} (b : B) (z : B ⊗[A] E.P₀ k) :
    E.tb b • E.ι₀ k z = E.ι₀ k (b • z) := by
  induction z with
  | zero => simp
  | add z z' h h' => rw [map_add, smul_add, h, h', smul_add, map_add]
  | tmul b' x => rw [ι₀_tmul, TensorProduct.smul_tmul', ι₀_tmul, smul_eq_mul, map_mul, mul_smul]

/-- Multiplying an element of the image of `ι₀` by `s̄ b` stays in the image of `ι₀`. -/
theorem sb_smul_mem_range_ι₀ {k : ℕ} (b : B) (z : B ⊗[A] E.P₀ k) :
    E.sb b • E.ι₀ k z ∈ (E.ι₀ k).range := by
  induction z with
  | zero => simp
  | add z z' h h' => rw [map_add, smul_add]; exact add_mem h h'
  | tmul b' x => exact ⟨b' ⊗ₜ (b • x), by rw [ι₀_tmul, ι₀_tmul, gs_smul, smul_comm]⟩

/-- The image of `ι₀` is stable under multiplication by `C`. -/
theorem smul_mem_range_ι₀ {k : ℕ} (c : C) {z : E.P₁ k} (hz : z ∈ (E.ι₀ k).range) :
    c • z ∈ (E.ι₀ k).range := by
  have hc : c ∈ Subring.closure (Set.range E.sb ∪ Set.range E.tb) := by
    rw [E.closure_range]; trivial
  induction hc using Subring.closure_induction generalizing z with
  | mem c hc =>
    obtain ⟨w, rfl⟩ := hz
    rcases hc with ⟨b, rfl⟩ | ⟨b, rfl⟩
    · exact E.sb_smul_mem_range_ι₀ b w
    · exact ⟨b • w, (E.tb_smul_ι₀ b w).symm⟩
  | zero => rw [zero_smul]; exact zero_mem _
  | one => rwa [one_smul]
  | add c c' _ _ h h' => rw [add_smul]; exact add_mem (h hz) (h' hz)
  | neg c _ h => rw [neg_smul]; exact neg_mem (h hz)
  | mul c c' _ _ h h' => rw [mul_smul]; exact h (h' hz)

/-- The map `s` carries `J^k` into `JC'^k`. -/
theorem map_s_pow_le (k : ℕ) : (E.J ^ k).map E.s ≤ E.I ^ k := by
  rw [Ideal.map_pow]; exact Ideal.pow_right_mono E.map_s_le k

/-- The comparison `ι₀ : B ⊗[A] J^k/J^{k+1} → JC'^k/JC'^{k+1}` is surjective. -/
theorem ι₀_surjective (k : ℕ) : Function.Surjective (E.ι₀ k) := by
  intro z
  induction z using AdicGradedPiece.induction_on with
  | h y hy =>
    have hy' : y ∈ (E.J ^ k).map E.s := by rwa [Ideal.map_pow, ← E.ker_ρ]
    change y ∈ Ideal.span (E.s '' ↑(E.J ^ k)) at hy'
    suffices ∀ (y : C') (hy' : y ∈ Ideal.span (E.s '' ↑(E.J ^ k))),
        AdicGradedPiece.mk E.I y (E.map_s_pow_le k hy') ∈ (E.ι₀ k).range from this y hy'
    intro y hy'
    induction hy' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨x, hx, rfl⟩ := hy
      exact ⟨1 ⊗ₜ AdicGradedPiece.mk E.J x hx, by rw [ι₀_tmul, map_one, one_smul]; rfl⟩
    | zero => exact zero_mem _
    | add y y' _ _ h h' => exact add_mem h h'
    | smul c y _ h =>
      have := E.smul_mem_range_ι₀ (E.ρ c) h
      rwa [ρ_smul, AdicGradedPiece.smul_mk] at this

/-! #### Injectivity of the comparison in degree one -/

/-- The flat comparison `D' ⊗[C'] JC'^k → D'`, `d ⊗ y ↦ y d`, whose image is `JD'^k`. -/
def ε (k : ℕ) : D' ⊗[C'] ↥(E.I ^ k) →ₗ[D'] D' :=
  (TensorProduct.AlgebraTensorModule.rid C' D' D').toLinearMap ∘ₗ
    (E.I ^ k).subtype.baseChange D'

/-- The map `ε` sends `d ⊗ y` to `y d`. -/
theorem ε_tmul {k : ℕ} (d : D') (y : ↥(E.I ^ k)) :
    E.ε k (d ⊗ₜ y) = algebraMap C' D' y * d := by
  simp [ε, Algebra.smul_def]

/-- The map `ε : D' ⊗[C'] JC'^k → D'` is injective. -/
theorem ε_injective (k : ℕ) : Function.Injective (E.ε k) := by
  have := E.flat
  have h₁ : Function.Injective ((E.I ^ k).subtype.baseChange D') := by
    rw [LinearMap.baseChange_eq_ltensor]
    exact Module.Flat.lTensor_preserves_injective_linearMap _ (Submodule.injective_subtype _)
  exact (TensorProduct.AlgebraTensorModule.rid C' D' D').injective.comp h₁

/-- The ideal `JD'^k` is the extension of `JC'^k` along `p₀₁`. -/
theorem K_pow_eq (k : ℕ) : E.K ^ k = (E.I ^ k).map (algebraMap C' D') := by
  rw [Ideal.map_pow]; exact congrArg (· ^ k) E.ker_σ

/-- An element of `D'` lies in the image of `ε` if and only if it lies in `JD'^k`. -/
theorem mem_range_ε_iff {k : ℕ} (w : D') : w ∈ LinearMap.range (E.ε k) ↔ w ∈ E.K ^ k := by
  rw [E.K_pow_eq]
  constructor
  · rintro ⟨z, rfl⟩
    induction z with
    | zero => simp
    | add z z' h h' => rw [map_add]; exact add_mem h h'
    | tmul d y =>
      rw [ε_tmul]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ y.2)
  · intro hw
    change w ∈ Ideal.span (algebraMap C' D' '' ↑(E.I ^ k)) at hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨y, hy, rfl⟩ := hw
      exact ⟨1 ⊗ₜ ⟨y, hy⟩, by rw [ε_tmul, mul_one]⟩
    | zero => exact zero_mem _
    | add w w' _ _ h h' => exact add_mem h h'
    | smul d w _ h => exact Submodule.smul_mem _ d h

/-- The action of `B ⊗[A] C` on `B ⊗[A] JC'^k/JC'^{k+1}`, factor by factor. -/
def act (k : ℕ) : B ⊗[A] C →ₐ[A] Module.End A (B ⊗[A] E.P₁ k) :=
  Algebra.TensorProduct.lift (Algebra.lsmul A A (B ⊗[A] E.P₁ k))
    ((Module.End.lTensorAlgHom A (E.P₁ k) B).comp (Algebra.lsmul A A (E.P₁ k)))
    fun b c ↦ by
      refine LinearMap.ext fun z ↦ ?_
      induction z with
      | zero => simp
      | add z z' h h' => rw [map_add, map_add, h, h']
      | tmul b' y =>
        change b • (b' ⊗ₜ (c • y)) = LinearMap.lTensor B (Algebra.lsmul A A (E.P₁ k) c)
          (b • (b' ⊗ₜ y))
        rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', LinearMap.lTensor_tmul]
        rfl

/-- The element `b ⊗ c` acts on `b' ⊗ y` as `(b * b') ⊗ (c • y)`. -/
theorem act_tmul_tmul {k : ℕ} (b : B) (c : C) (b' : B) (y : E.P₁ k) :
    E.act k (b ⊗ₜ c) (b' ⊗ₜ y) = (b * b') ⊗ₜ (c • y) := by
  show b • (b' ⊗ₜ[A] (c • y)) = _
  rw [TensorProduct.smul_tmul', smul_eq_mul]

/-- The candidate left inverse of `ι₁`, on the flat presentation of `JD'^k`: the additive map
`D' ⊗[C'] JC'^k → B ⊗[A] JC'^k/JC'^{k+1}`, `d ⊗ y ↦ τ(σ d) • (1 ⊗ [y])`. -/
def r₀ (k : ℕ) : D' ⊗[C'] ↥(E.I ^ k) →+ B ⊗[A] E.P₁ k :=
  TensorProduct.liftAddHom
    (AddMonoidHom.mk'
      (fun d ↦ AddMonoidHom.mk'
        (fun y ↦ E.act k (E.τ (E.σ d)) (1 ⊗ₜ AdicGradedPiece.mk E.I y.1 y.2))
        fun y y' ↦ by
          rw [← map_add, ← TensorProduct.tmul_add]
          rfl)
      fun d d' ↦ by
        ext y
        simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add, LinearMap.add_apply])
    fun c d y ↦ by
      simp only [AddMonoidHom.mk'_apply]
      have h : E.σ (algebraMap C' D' c) = E.q₀₁ (E.ρ c) := congr($(E.σ_comp_p₀₁) c)
      have h' : E.τ (E.q₀₁ (E.ρ c)) = 1 ⊗ₜ E.ρ c := congr($(E.τ_comp_q₀₁) (E.ρ c))
      rw [Algebra.smul_def, map_mul, map_mul, mul_comm, map_mul, Module.End.mul_apply, h, h',
        act_tmul_tmul, mul_one, ρ_smul, AdicGradedPiece.smul_mk]
      rfl

/-- The map `r₀` sends `d ⊗ y` to `τ(σ d) • (1 ⊗ [y])`. -/
theorem r₀_tmul {k : ℕ} (d : D') (y : ↥(E.I ^ k)) :
    E.r₀ k (d ⊗ₜ y) = E.act k (E.τ (E.σ d)) (1 ⊗ₜ AdicGradedPiece.mk E.I y.1 y.2) := rfl

/-- The map `r₀` is semilinear along `τ ∘ σ : D' → B ⊗[A] C`. -/
theorem r₀_smul {k : ℕ} (d : D') (z : D' ⊗[C'] ↥(E.I ^ k)) :
    E.r₀ k (d • z) = E.act k (E.τ (E.σ d)) (E.r₀ k z) := by
  induction z with
  | zero => simp
  | add z z' h h' => rw [smul_add, map_add, h, h', map_add, map_add]
  | tmul d' y => rw [TensorProduct.smul_tmul', r₀_tmul, r₀_tmul, smul_eq_mul, map_mul, map_mul,
      map_mul, Module.End.mul_apply]

/-- The image of `ε` is `JD'^k`. -/
theorem range_ε (k : ℕ) : LinearMap.range (E.ε k) = E.K ^ k :=
  Submodule.ext fun w ↦ E.mem_range_ε_iff w

/-- The left inverse of `ι₁`, read on an element of `JD'^k`: the additive map
`JD'^k → B ⊗[A] JC'^k/JC'^{k+1}` given by `r₀` through the isomorphism
`ε : D' ⊗[C'] JC'^k ≃ JD'^k`. -/
def r (k : ℕ) : ↥(E.K ^ k) →+ B ⊗[A] E.P₁ k :=
  (E.r₀ k).comp ((LinearEquiv.ofInjective (E.ε k) (E.ε_injective k)).symm.toLinearMap.comp
    (LinearEquiv.ofEq _ _ (E.range_ε k).symm).toLinearMap).toAddMonoidHom

/-- The map `r` composed with `ε` is `r₀`. -/
theorem r_ε {k : ℕ} (z : D' ⊗[C'] ↥(E.I ^ k)) (hw : E.ε k z ∈ E.K ^ k) :
    E.r k ⟨E.ε k z, hw⟩ = E.r₀ k z := by
  simp only [r, AddMonoidHom.coe_comp, LinearMap.toAddMonoidHom_coe, Function.comp_apply,
    LinearMap.coe_comp, LinearEquiv.coe_coe]
  congr 1
  rw [LinearEquiv.symm_apply_eq]
  rfl

/-- The map `r` is semilinear along `τ ∘ σ : D' → B ⊗[A] C`. -/
theorem r_smul {k : ℕ} (d : D') (w : ↥(E.K ^ k)) :
    E.r k (d • w) = E.act k (E.τ (E.σ d)) (E.r k w) := by
  simp only [r, AddMonoidHom.coe_comp, LinearMap.toAddMonoidHom_coe, Function.comp_apply,
    LinearMap.coe_comp, LinearEquiv.coe_coe, map_smul]
  exact E.r₀_smul d _

/-- The map `r` vanishes on `JD'^{k+1}`. -/
theorem r_eq_zero {k : ℕ} (w : D') (hw : w ∈ E.K ^ (k + 1)) :
    E.r k ⟨w, Ideal.pow_le_pow_right (Nat.le_succ k) hw⟩ = 0 := by
  have hw' : w ∈ (E.I ^ (k + 1)).map (algebraMap C' D') := by rwa [← E.K_pow_eq]
  change w ∈ Ideal.span (algebraMap C' D' '' ↑(E.I ^ (k + 1))) at hw'
  have hle : Ideal.span (algebraMap C' D' '' ↑(E.I ^ (k + 1))) ≤ E.K ^ k := by
    show (E.I ^ (k + 1)).map (algebraMap C' D') ≤ _
    rw [← E.K_pow_eq]
    exact Ideal.pow_le_pow_right (Nat.le_succ k)
  suffices ∀ (w : D') (hw' : w ∈ Ideal.span (algebraMap C' D' '' ↑(E.I ^ (k + 1)))),
      E.r k ⟨w, hle hw'⟩ = 0 from this w hw'
  intro w hw'
  induction hw' using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨y, hy, rfl⟩ := hw
    have hyk : y ∈ E.I ^ k := Ideal.pow_le_pow_right (Nat.le_succ k) hy
    have h := E.r_ε (k := k) (1 ⊗ₜ ⟨y, hyk⟩)
      (by rw [ε_tmul, mul_one]; exact hle (Ideal.subset_span ⟨y, hy, rfl⟩))
    simp only [ε_tmul, mul_one] at h
    rw [h, r₀_tmul, map_one, map_one, map_one]
    show 1 ⊗ₜ AdicGradedPiece.mk E.I y hyk = 0
    rw [(AdicGradedPiece.mk_eq_zero_iff E.I hyk).2 hy, TensorProduct.tmul_zero]
  | zero => exact map_zero (E.r k)
  | add w w' _ _ h h' =>
    rw [show (⟨w + w', hle (add_mem ‹_› ‹_›)⟩ : ↥(E.K ^ k)) = ⟨w, hle ‹_›⟩ + ⟨w', hle ‹_›⟩ from rfl,
      map_add, h, h', add_zero]
  | smul d w _ h =>
    have := E.r_smul (k := k) d ⟨w, hle ‹_›⟩
    rwa [h, map_zero] at this

/-- Every `z : B ⊗[A] JC'^k/JC'^{k+1}` is `r w` for some `w ∈ JD'^k` whose class is `ι₁ z`. -/
theorem exists_r_eq_ι₁ {k : ℕ} (z : B ⊗[A] E.P₁ k) :
    ∃ w : ↥(E.K ^ k), Submodule.Quotient.mk w = E.ι₁ k z ∧ E.r k w = z := by
  induction z with
  | zero => exact ⟨0, by simp, map_zero _⟩
  | add z z' h h' =>
    obtain ⟨w, h₁, h₂⟩ := h
    obtain ⟨w', h₁', h₂'⟩ := h'
    exact ⟨w + w', by rw [Submodule.Quotient.mk_add, h₁, h₁', map_add], by rw [map_add, h₂, h₂']⟩
  | tmul b y =>
    induction y using AdicGradedPiece.induction_on with
    | h y hy =>
      obtain ⟨b', rfl⟩ := E.surjective_π b
      have he : E.σ (E.p₁₂ (E.t b')) = E.e₂ (E.π b') := by
        have h₁ := congr($(E.σ_comp_p₁₂) (E.t b'))
        have h₂ := congr($(E.ρ_comp_t) b')
        simp only [RingHom.comp_apply] at h₁ h₂
        rw [h₁, h₂]
        rfl
      have hmem : E.ε k (E.p₁₂ (E.t b') ⊗ₜ ⟨y, hy⟩) ∈ E.K ^ k :=
        (E.mem_range_ε_iff _).1 ⟨_, rfl⟩
      refine ⟨⟨_, hmem⟩, ?_, ?_⟩
      · rw [ι₁_tmul, ← he, σ_smul, AdicGradedPiece.map_mk, AdicGradedPiece.smul_mk]
        show AdicGradedPiece.mk E.K _ hmem = _
        congr 1
        rw [ε_tmul, mul_comm]
      · rw [r_ε, r₀_tmul, he]
        have h₃ : E.τ (E.e₂ (E.π b')) = _ := congr($(E.τ_comp_e₂) (E.π b'))
        rw [h₃, Algebra.TensorProduct.includeLeftRingHom_apply, act_tmul_tmul, mul_one,
          one_smul]

/-- The comparison `ι₁ : B ⊗[A] JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}` is injective. -/
theorem ι₁_injective (k : ℕ) : Function.Injective (E.ι₁ k) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨w, h₁, h₂⟩ := E.exists_r_eq_ι₁ z
  rw [hz, Submodule.Quotient.mk_eq_zero, AdicGradedPiece.mem_smul_top_iff'] at h₁
  rw [← h₂]
  exact E.r_eq_zero w h₁

/-! #### Exactness and the lifting statement -/

/-- **The obstruction complex is exact.** For every `k`, the complex
`J^k/J^{k+1} → JC'^k/JC'^{k+1} → JD'^k/JD'^{k+1}` with differentials `t - s` and
`p₁₂ - p₀₂ + p₀₁` is exact in the middle. -/
theorem exact_gradedDiff [Module.FaithfullyFlat A B] (k : ℕ) :
    Function.Exact (E.d₀ k) (E.d₁ k) :=
  exact_of_lTensor_contraction (E.d₀ k) (E.d₁ k) (E.d₁_comp_d₀ k) (E.ι₀ k) (E.ι₀_surjective k)
    (E.ι₁ k) (E.ι₁_injective k) (E.contr₁ k) (E.contr₂ k) (E.d₁' k) E.ι₁_lTensor_d₀
    E.ι₁_eq_contr

/-- If `t b - s b ∈ JC'^k`, its class in `JC'^k/JC'^{k+1}` is a cocycle: `d₁` kills it. -/
theorem d₁_mk_t_sub_s {k : ℕ} (b : B') (hb : E.t b - E.s b ∈ E.I ^ k) :
    E.d₁ k (AdicGradedPiece.mk E.I _ hb) = 0 :=
  E.d₁_mk_sub_eq_zero b hb

/-- **One step of the lifting.** An element of `B'` whose two images in `C'` agree modulo
`JC'^k`, `k ≥ 1`, can be corrected by an element of `J^k` so that they agree modulo
`JC'^{k+1}`. -/
theorem exists_sub_mem_pow_succ [Module.FaithfullyFlat A B] {k : ℕ} (hk : 1 ≤ k) (b : B')
    (hb : E.t b - E.s b ∈ E.I ^ k) :
    ∃ b' : B', E.π b' = E.π b ∧ E.t b' - E.s b' ∈ E.I ^ (k + 1) := by
  obtain ⟨m, hm⟩ := ((E.exact_gradedDiff k) (AdicGradedPiece.mk E.I _ hb)).1 (E.d₁_mk_t_sub_s b hb)
  induction m using AdicGradedPiece.induction_on with
  | h j hj =>
    refine ⟨b - j, ?_, ?_⟩
    · have : j ∈ E.J := Ideal.pow_le_self (by omega) hj
      rw [map_sub, RingHom.mem_ker.1 this, sub_zero]
    · rw [d₀_apply, AdicGradedPiece.map_mk, AdicGradedPiece.map_mk, ← AdicGradedPiece.mk_sub,
        AdicGradedPiece.mk_eq_mk_iff] at hm
      convert neg_mem hm using 1
      simp only [map_sub]
      ring

/-- **Lifting invariant elements across a nilpotent invariant ideal.** If the kernel of the
reduction `π : B' → B` is nilpotent, then every element of `A`, read in `B`, is the reduction of
an element `b` of `B'` with `s b = t b`. -/
theorem exists_eq_of_isNilpotent [Module.FaithfullyFlat A B] (hJ : IsNilpotent E.J) (a : A) :
    ∃ b : B', E.s b = E.t b ∧ E.π b = algebraMap A B a := by
  obtain ⟨N, hN⟩ := hJ
  have key : ∀ k : ℕ, ∃ b : B', E.π b = algebraMap A B a ∧ E.t b - E.s b ∈ E.I ^ (k + 1) := by
    intro k
    induction k with
    | zero =>
      obtain ⟨b, hb⟩ := E.surjective_π (algebraMap A B a)
      refine ⟨b, hb, ?_⟩
      rw [zero_add, pow_one, RingHom.mem_ker, map_sub, ← RingHom.comp_apply E.ρ,
        ← RingHom.comp_apply E.ρ, E.ρ_comp_t, E.ρ_comp_s, RingHom.comp_apply, RingHom.comp_apply,
        hb, ← RingHom.comp_apply E.tb, ← RingHom.comp_apply E.sb, E.tb_comp_algebraMap,
        E.sb_comp_algebraMap, sub_self]
    | succ k ih =>
      obtain ⟨b, hb, hk⟩ := ih
      obtain ⟨b', hb', hk'⟩ := E.exists_sub_mem_pow_succ (by omega) b hk
      exact ⟨b', hb'.trans hb, hk'⟩
  obtain ⟨b, hb, hk⟩ := key N
  refine ⟨b, ?_, hb⟩
  have hzero : E.I ^ N = ⊥ := by
    show RingHom.ker E.ρ ^ N = ⊥
    rw [E.ker_ρ, ← Ideal.map_pow]
    show Ideal.map E.s (E.J ^ N) = ⊥
    rw [hN, Ideal.zero_eq_bot, Ideal.map_bot]
  have := Ideal.pow_le_pow_right (Nat.le_succ N) hk
  rw [hzero, Ideal.mem_bot, sub_eq_zero] at this
  exact this.symm

end C1573.EqualizerLiftData

