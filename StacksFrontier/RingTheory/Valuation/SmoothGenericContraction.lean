/-!
# Contracting an invertible ideal of the generic fibre of a smooth algebra

Let `R` be a valuation ring with fraction field `K`, let `A` be a smooth `R`-algebra and let
`I ⊆ A ⊗_R K` be an invertible ideal. Then the contraction `J = I ∩ A` is locally generated by a
single nonzerodivisor (part of Stacks 0DMC).

## Main results

* `Algebra.Smooth.exists_away_eq_span_isRegular_comap_genericFibre`: near every prime of `A`, the
  contraction `J` is generated by one nonzerodivisor.
* `Ideal.invertible_map_of_isLocalization`: the extension of an invertible ideal to a
  localization is invertible.
* `Ideal.invertible_comap_ringEquiv`: the preimage of an invertible ideal under a ring
  isomorphism is invertible.
* `Ideal.exists_away_eq_span_isRegular_of_invertible_atPrime`: a finitely presented ideal which
  is invertible at a prime `q` is generated by one nonzerodivisor after inverting some element
  outside `q`.

## References

* [Stacks Project, Tag 0DMC](https://stacks.math.columbia.edu/tag/0DMC)
* [Stacks Project, Tag 0DLQ](https://stacks.math.columbia.edu/tag/0DLQ)
* [Stacks Project, Tag 0ASX](https://stacks.math.columbia.edu/tag/0ASX)
-/

@[expose] public noncomputable section

open scoped TensorProduct nonZeroDivisors

universe u

namespace Algebra.Smooth

private theorem exists_regular_generator_of_linearEquiv
    {A : Type*} [CommRing A] (I : Ideal A) (e : A ≃ₗ[A] I) :
    ∃ f : A, IsRegular f ∧ I = Ideal.span {f} := by
  let f : A := e 1
  have he (a : A) : (e a : A) = a * f := by
    have h := congrArg Subtype.val (e.map_smul a 1)
    simpa [f] using h
  refine ⟨f, (Commute.isRegular_iff (fun a => mul_comm f a)).2 ?_, ?_⟩
  · intro a b h
    apply e.injective
    apply Subtype.ext
    simpa only [he, mul_comm] using h
  · ext x
    constructor
    · intro hx
      refine Submodule.mem_span_singleton.mpr ⟨e.symm ⟨x, hx⟩, ?_⟩
      simpa using (he (e.symm ⟨x, hx⟩)).symm
    · intro hx
      obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
      exact I.smul_mem a (e 1).property

private theorem ideal_isPrincipal_of_subsingleton_pic
    {A : Type u} [CommRing A] [Subsingleton (CommRing.Pic A)]
    (I : Ideal A) [Module.Invertible A I] : I.IsPrincipal := by
  have hfree : Module.Free A I :=
    (CommRing.Pic.subsingleton_iff.mp inferInstance) I inferInstance
  obtain ⟨e⟩ := Module.Invertible.free_iff_linearEquiv.mp hfree
  obtain ⟨f, -, hf⟩ := exists_regular_generator_of_linearEquiv I e.symm
  rw [hf]
  infer_instance

/-- Let `A` be a flat, essentially of finite type, local algebra over a valuation ring `R` with
regular special fibre. Then every invertible ideal of the generic fibre `A ⊗_R K` is
principal. -/
@[sga "6 X 7.8" "special case"]
private theorem ideal_isPrincipal_genericFiber_of_isRegularSpecialFiber
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [Module.Flat R A] [Algebra.EssFiniteType R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [IsRegularRing (A ⊗[R] (IsLocalRing.ResidueField R))]
    (I : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) I] : I.IsPrincipal := by
  have : Subsingleton (CommRing.Pic (A ⊗[R] K)) :=
    ValuationRing.subsingleton_pic_genericFibre_of_isRegular_specialFibre
  exact ideal_isPrincipal_of_subsingleton_pic I

/-- A nonzero element `x` of a flat, essentially of finite type, local algebra `B` over a
valuation ring `R` is `π • y` for some `π ∈ R` and some `y` not in `m B`, for a maximal ideal
`m` of `R`. -/
private theorem exists_content_primitive
    {R B : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    (m : Ideal R) [hm : m.IsMaximal]
    [CommRing B] [IsLocalRing B] [Algebra R B] [IsLocalHom (algebraMap R B)]
    [Algebra.EssFiniteType R B] [Module.Flat R B]
    (x : B) (hx : x ≠ 0) :
    ∃ (π : R) (y : B), x = algebraMap R B π * y ∧
      y ∉ m • (⊤ : Submodule R B) := by
  obtain ⟨I, hI⟩ := exists_isContentIdeal_of_valuationRing (A := R) (B := B) (N := B) x
  have hprincipal : I.IsPrincipal := hI.isPrincipal_of_valuationRing
  let π : R := Submodule.IsPrincipal.generator I
  have hgen : I = Ideal.span {π} := (Ideal.span_singleton_generator I).symm
  have hxI := hI.mem_smul_top
  rw [hgen, Submodule.ideal_span_singleton_smul, Submodule.pointwise_smul_def,
    ← LinearMap.range_eq_map] at hxI
  obtain ⟨y, hy⟩ := hxI
  refine ⟨π, y, ?_, ?_⟩
  · simpa [Algebra.smul_def] using hy.symm
  · intro hmy
    have hπI : π ∈ I := by rw [hgen]; exact Ideal.mem_span_singleton_self _
    have hprod : x ∈ (I * m) • (⊤ : Submodule R B) := by
      rw [← Ideal.smul_eq_mul I m, Submodule.smul_assoc I m (⊤ : Submodule R B)]
      rw [← hy]
      exact Submodule.smul_mem_smul hπI hmy
    have hle := hI.le_of_mem_smul_top hprod
    have hπprod : π ∈ I * m := hle hπI
    have hπ : π ≠ 0 := by
      intro hzero
      apply hx
      rw [← hy]
      simp [hzero]
    obtain ⟨z, hzM, hz⟩ :=
      (Ideal.mem_span_singleton_mul).mp (by simpa [hgen] using hπprod)
    have hz1 : z = 1 := mul_left_cancel₀ hπ (by simpa using hz)
    have hone : (1 : R) ∈ m := hz1 ▸ hzM
    exact hm.ne_top ((Ideal.eq_top_iff_one m).mpr hone)

/-- Let `A` be a flat local `R`-algebra, essentially of finite presentation, whose closed fibre
is a domain. An element `f` of `A` which is nonzero in the closed fibre is a nonzerodivisor, and
`A ⧸ (f)` is flat over `R`. -/
private theorem isRegular_and_flat_quotient_of_primitive
    {R A : Type*} [CommRing R] [CommRing A] [IsLocalRing R] [IsLocalRing A]
    [Algebra R A] [IsLocalHom (algebraMap R A)] [Module.Flat R A]
    (hfp : (algebraMap R A).EssentiallyOfFinitePresentation)
    (hfiber : IsDomain
      (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule A A))))
    {f : A}
    (hf : f ∉ IsLocalRing.maximalIdeal R • (⊤ : Submodule R A)) :
    IsRegular f ∧ Module.Flat R (A ⧸ (Ideal.span {f} • (⊤ : Submodule A A))) := by
  let N : Submodule A A :=
    Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) • (⊤ : Submodule A A)
  let Q := A ⧸ N
  have hN : N.restrictScalars R =
      IsLocalRing.maximalIdeal R • (⊤ : Submodule R A) := by
    rw [Ideal.smul_restrictScalars, Submodule.restrictScalars_top]
  have hbar : N.mkQ f ≠ 0 := by
    intro h
    apply hf
    rw [← hN]
    exact (Submodule.Quotient.mk_eq_zero N).mp h
  have hregular : IsRegular (N.mkQ f) := IsRegular.of_ne_zero hbar
  have hsmul : IsSMulRegular Q f :=
    IsSMulRegular.of_map N.mkQ (fun _ => rfl) hregular.isSMulRegular
  obtain ⟨hfreg, hflat⟩ :=
    Module.Flat.isSMulRegular_and_flat_quotient_smul_of_isSMulRegular_maximalIdeal
      (R := R) (S := A) (M := A) hfp hsmul
  exact ⟨(Commute.isRegular_iff (fun a => mul_comm f a)).2 hfreg, hflat⟩

/-- The ideal `I • ⊤` of the ring `A` is `I`. -/
private theorem ideal_smul_top_self {A : Type*} [CommRing A] (I : Ideal A) :
    I • (⊤ : Submodule A A) = I := by
  rw [Ideal.smul_top_eq_map]
  show Submodule.restrictScalars A (Ideal.map (algebraMap A A) I) = I
  simp

/-- If `A ⧸ I` is flat over the valuation ring `R`, then the contraction from `A ⊗_R K` of the
extension of `I` is `I`. -/
private theorem ideal_comap_map_self_of_flat_quotient
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [Algebra R A] [Module.Flat R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (I : Ideal A)
    (hflat : Module.Flat R (A ⧸ I • (⊤ : Submodule A A))) :
    Ideal.comap (algebraMap A (A ⊗[R] K))
      (Ideal.map (algebraMap A (A ⊗[R] K)) I) = I := by
  let M := nonZeroDivisors R
  let T := A ⊗[R] K
  have : IsLocalization (Algebra.algebraMapSubmonoid A M) T := by infer_instance
  ext x
  constructor
  · intro hx
    rw [Ideal.mem_comap] at hx
    obtain ⟨s, hs, hsx⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (M := Algebra.algebraMapSubmonoid A M) T I x).mp hx
    obtain ⟨r, hr, hsr⟩ := (Submonoid.mem_map).mp hs
    have hsx' : algebraMap R A r * x ∈ I := by simpa [← hsr] using hsx
    rw [ideal_smul_top_self] at hflat
    have hsreg : IsSMulRegular (A ⧸ I) r :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hr
    have hq : Ideal.Quotient.mk I ((algebraMap R A r) * x) = 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).2 hsx'
    have hz : r • (Ideal.Quotient.mk I x) = 0 := by
      show Ideal.Quotient.mk I (r • x) = 0
      simpa [Algebra.smul_def] using hq
    exact Ideal.Quotient.eq_zero_iff_mem.mp (hsreg.right_eq_zero_of_smul hz)
  · intro hx
    exact Ideal.mem_comap.mpr (Ideal.mem_map_of_mem (algebraMap A T) hx)

/-- If an ideal `J` of the generic fibre `A ⊗_R K` is generated by an element `f` of `A` which
is nonzero in the closed fibre, then the contraction of `J` to `A` is `(f)`. -/
private theorem contraction_of_generic_principal
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R] [IsLocalRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [Module.Flat R A] [Algebra.EssFiniteType R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (f : A)
    (hfp : (algebraMap R A).EssentiallyOfFinitePresentation)
    (hfiber : IsDomain
      (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule A A))))
    (hprimitive : f ∉ IsLocalRing.maximalIdeal R • (⊤ : Submodule R A))
    (J : Ideal (A ⊗[R] K))
    (hgeneric : J = Ideal.map (algebraMap A (A ⊗[R] K)) (Ideal.span {f})) :
    Ideal.comap (algebraMap A (A ⊗[R] K)) J = Ideal.span {f} := by
  rw [hgeneric]
  exact ideal_comap_map_self_of_flat_quotient (R := R) (A := A) (K := K)
    (Ideal.span {f}) (isRegular_and_flat_quotient_of_primitive hfp hfiber hprimitive).2

/-- A nonzero principal ideal of the generic fibre `A ⊗_R K` contracts to the ideal of `A`
generated by an element which is nonzero in the closed fibre. -/
private theorem exists_contraction_generator
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R] [IsLocalRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [Module.Flat R A] [Algebra.EssFiniteType R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (hfp : (algebraMap R A).EssentiallyOfFinitePresentation)
    (hfiber : IsDomain
      (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule A A))))
    (J : Ideal (A ⊗[R] K))
    (hprincipal : ∃ g, J = Ideal.span {g})
    (hJ : J ≠ ⊥) :
    ∃ f : A,
      f ∉ IsLocalRing.maximalIdeal R • (⊤ : Submodule R A) ∧
      Ideal.comap (algebraMap A (A ⊗[R] K)) J = Ideal.span {f} := by
  let M := nonZeroDivisors R
  let MA := Algebra.algebraMapSubmonoid A M
  let T := A ⊗[R] K
  have : IsLocalization MA T := by infer_instance
  obtain ⟨g, hg⟩ := hprincipal
  obtain ⟨x, s, hs⟩ := IsLocalization.exists_mk'_eq MA g
  have hspan : Ideal.span {algebraMap A T x} = Ideal.span {g} := by
    calc
      Ideal.span {algebraMap A T x} =
          Ideal.span {algebraMap A T (s : A) * IsLocalization.mk' T x s} := by
        rw [IsLocalization.mk'_spec']
      _ = Ideal.span {IsLocalization.mk' T x s} :=
        Ideal.span_singleton_mul_left_unit (IsLocalization.map_units T s) _
      _ = Ideal.span {g} := by rw [hs]
  have hmap : Ideal.map (algebraMap A T) (Ideal.span {x}) = J := by
    rw [Ideal.map_span, Set.image_singleton, hspan, hg]
  have hx : x ≠ 0 := by
    rintro rfl
    simp [← hmap] at hJ
  obtain ⟨π, y, hxy, hy⟩ :=
    exists_content_primitive (R := R) (B := A)
      (IsLocalRing.maximalIdeal R) x hx
  have hπ : π ≠ 0 := by
    rintro rfl
    simp [hxy] at hx
  have hπmem : π ∈ M := mem_nonZeroDivisors_iff_ne_zero.mpr hπ
  have hπunit : IsUnit (algebraMap A T (algebraMap R A π)) :=
    IsLocalization.map_units T
      ⟨algebraMap R A π, Algebra.mem_algebraMapSubmonoid_of_mem ⟨π, hπmem⟩⟩
  have hmapY : Ideal.map (algebraMap A T) (Ideal.span {y}) = J := by
    rw [← hmap, Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton, hxy,
      map_mul]
    exact (Ideal.span_singleton_mul_left_unit hπunit _).symm
  exact ⟨y, hy, contraction_of_generic_principal (R := R) (A := A) (K := K)
    y hfp hfiber hy J hmapY.symm⟩

/-- A nonzero invertible ideal of the generic fibre `A ⊗_R K` of a local algebra with regular
special fibre contracts to the ideal of `A` generated by an element which is nonzero in the
closed fibre. -/
private theorem exists_contraction_generator_of_invertible_generic
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R] [IsLocalRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [Module.Flat R A] [Algebra.EssFiniteType R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [IsRegularRing (A ⊗[R] (IsLocalRing.ResidueField R))]
    (hfp : (algebraMap R A).EssentiallyOfFinitePresentation)
    (hfiber : IsDomain
      (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule A A))))
    (J : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) J]
    (hJ : J ≠ ⊥) :
    ∃ f : A,
      f ∉ IsLocalRing.maximalIdeal R • (⊤ : Submodule R A) ∧
      Ideal.comap (algebraMap A (A ⊗[R] K)) J = Ideal.span {f} := by
  have hprincipal : J.IsPrincipal :=
    ideal_isPrincipal_genericFiber_of_isRegularSpecialFiber (R := R) (A := A) (K := K) J
  exact exists_contraction_generator (R := R) (A := A) (K := K)
    hfp hfiber J ⟨_, (Ideal.span_singleton_generator J).symm⟩ hJ

private theorem invertible_span_of_isRegular
    {A : Type*} [CommRing A] {f : A} (hf : IsRegular f) :
    Module.Invertible A (Ideal.span {f}) := by
  let e : A →ₗ[A] Ideal.span {f} :=
    (LinearMap.toSpanSingleton A A f).codRestrict _
      (fun a => Submodule.mem_span_singleton.mpr ⟨a, rfl⟩)
  have he : Function.Bijective e := by
    constructor
    · exact fun a b h => hf.right (congrArg Subtype.val h)
    · intro a
      obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp a.2
      exact ⟨b, Subtype.ext hb⟩
  exact Module.Invertible.congr (LinearEquiv.ofBijective e he)

/-- The contraction to `A` of a nonzero invertible ideal of the generic fibre `A ⊗_R K` of a
local algebra with regular special fibre is invertible. -/
private theorem invertible_comap_of_regular_specialFiber
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [Module.Flat R A] [Algebra.EssFiniteType R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [IsRegularRing (A ⊗[R] (IsLocalRing.ResidueField R))]
    (hfp : (algebraMap R A).EssentiallyOfFinitePresentation)
    (hfiber : IsDomain
      (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule A A))))
    (J : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) J]
    (hJ : J ≠ ⊥) :
    Module.Invertible A (Ideal.comap (algebraMap A (A ⊗[R] K)) J) := by
  obtain ⟨f, hf, hgen⟩ := exists_contraction_generator_of_invertible_generic hfp hfiber J hJ
  rw [hgen]
  exact invertible_span_of_isRegular
    (isRegular_and_flat_quotient_of_primitive hfp hfiber hf).1

/-- A torsion free module over a valuation ring is flat. -/
private theorem flat_of_isTorsionFree_valuationRing
    {R M : Type*} [CommRing R] [IsDomain R] [ValuationRing R] [AddCommGroup M] [Module R M]
    [Module.IsTorsionFree R M] : Module.Flat R M := by
  rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
    ← Submodule.isTorsionFree_iff_torsion_eq_bot]
  infer_instance

/-- A quotient by an ideal contracted from a localization inverting every
nonzero base element is torsion free over the base valuation ring. -/
private theorem flat_quotient_comap_generic
    {R A T : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [Algebra R A] [CommRing T] [Algebra A T]
    [IsLocalization (Algebra.algebraMapSubmonoid A (nonZeroDivisors R)) T]
    (I : Ideal T) : Module.Flat R (A ⧸ Ideal.comap (algebraMap A T) I) := by
  let J := Ideal.comap (algebraMap A T) I
  have : Module.IsTorsionFree R (A ⧸ J) := by
    constructor
    intro r hr
    apply IsSMulRegular.of_right_eq_zero_of_smul
    intro q
    refine Quotient.inductionOn' q ?_
    intro x hx
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    have hxJ : algebraMap R A r * x ∈ J := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change Ideal.Quotient.mk J (r • x) = 0 at hx
      simpa only [Algebra.smul_def] using hx
    change algebraMap A T (algebraMap R A r * x) ∈ I at hxJ
    rw [map_mul] at hxJ
    have hr' : r ∈ nonZeroDivisors R := isRegular_iff_mem_nonZeroDivisors.mp hr
    obtain ⟨u, hu⟩ := IsLocalization.map_units T
      (⟨algebraMap R A r, Algebra.mem_algebraMapSubmonoid_of_mem ⟨r, hr'⟩⟩ :
        Algebra.algebraMapSubmonoid A (nonZeroDivisors R))
    show algebraMap A T x ∈ I
    have hxI := I.mul_mem_left (↑u⁻¹ : T) hxJ
    rw [← hu] at hxI
    simpa only [← mul_assoc, Units.inv_mul, one_mul] using hxI
  exact flat_of_isTorsionFree_valuationRing

/-- Over a finite type algebra `A` of a valuation ring, the contraction to `A` of an ideal of a
localization of `A` inverting the nonzero elements of the base is finitely generated. -/
private theorem fg_comap_generic
    {R A T : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [Algebra R A] [Algebra.FiniteType R A]
    [CommRing T] [Algebra A T]
    [IsLocalization (Algebra.algebraMapSubmonoid A (nonZeroDivisors R)) T]
    (I : Ideal T) : (Ideal.comap (algebraMap A T) I).FG := by
  let J := Ideal.comap (algebraMap A T) I
  have : Module.FinitePresentation A (A ⧸ J) :=
    (finitePresentation_of_flat_of_finiteType_of_valuationRing
      (A := R) (B := A) (M := A ⧸ J)).2
      (flat_quotient_comap_generic (R := R) I) inferInstance
  show Submodule.FG J
  simpa only [Submodule.ker_mkQ] using Module.FinitePresentation.fg_ker J.mkQ J.mkQ_surjective

private theorem isRegularRing_of_isLocalization
    {R : Type*} [CommRing R] [IsRegularRing R]
    (M : Submonoid R) (S : Type*) [CommRing S] [Algebra R S] [IsLocalization M S] :
    IsRegularRing S := by
  have : IsNoetherianRing S := IsLocalization.isNoetherianRing M S inferInstance
  rw [isRegularRing_iff]
  intro q hq
  have : IsLocalization.AtPrime (Localization.AtPrime q) (q.comap (algebraMap R S)) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M
      (Localization.AtPrime q) q
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv (q.comap (algebraMap R S)).primeCompl
      (Localization.AtPrime (q.comap (algebraMap R S)))
      (Localization.AtPrime q)).toRingEquiv

/-- Tensoring a localization `A → T` with `K` over `R` gives a localization of `A ⊗[R] K`. -/
private theorem isLocalization_tensor_of_algebraMap_eq
    {R A T K : Type*} [CommRing R] [CommRing A] [CommRing T] [CommRing K]
    [Algebra R A] [Algebra R T] [Algebra A T] [IsScalarTower R A T] [Algebra R K]
    (M : Submonoid A) [IsLocalization M T] [Algebra (A ⊗[R] K) (T ⊗[R] K)]
    (h : algebraMap (A ⊗[R] K) (T ⊗[R] K) =
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom R A T) (AlgHom.id R K)).toRingHom) :
    IsScalarTower A (A ⊗[R] K) (T ⊗[R] K) ∧
      IsLocalization (Algebra.algebraMapSubmonoid (A ⊗[R] K) M) (T ⊗[R] K) := by
  have : IsScalarTower A (A ⊗[R] K) (T ⊗[R] K) := by
    apply IsScalarTower.of_algebraMap_eq
    intro a
    simp [h]
  refine ⟨this, ?_⟩
  apply IsLocalization.tensorProduct_tensorProduct R K M T
  ext k
  simp [h]

private theorem isRegularRing_tensor_localization
    {R A T K : Type*} [CommRing R] [CommRing A] [CommRing T] [Field K]
    [Algebra R A] [Algebra R T] [Algebra A T] [IsScalarTower R A T]
    [Algebra R K] [Algebra.Smooth R A]
    (M : Submonoid A) [IsLocalization M T] : IsRegularRing (T ⊗[R] K) := by
  let φ : A ⊗[R] K →ₐ[R] T ⊗[R] K :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom R A T) (AlgHom.id R K)
  let : Algebra (A ⊗[R] K) (T ⊗[R] K) := φ.toRingHom.toAlgebra
  obtain ⟨_, _⟩ := isLocalization_tensor_of_algebraMap_eq (R := R) (T := T) (K := K) M rfl
  have : IsRegularRing (K ⊗[R] A) :=
    Stacks.Smooth.RegularRingAscent.isRegularRing_of_formallySmooth K _
  have : IsRegularRing (A ⊗[R] K) :=
    IsRegularRing.of_ringEquiv (Algebra.TensorProduct.comm R K A).toRingEquiv
  exact isRegularRing_of_isLocalization
    (Algebra.algebraMapSubmonoid (A ⊗[R] K) M) _

private theorem isRegularRing_specialFiber_of_smooth_localization
    {R A T V : Type*} [CommRing R] [CommRing A] [CommRing T]
    [CommRing V] [IsLocalRing V]
    [Algebra R A] [Algebra R T] [Algebra A T] [IsScalarTower R A T]
    [Algebra R V] [Algebra V T] [IsScalarTower R V T]
    [Algebra.Smooth R A]
    (M : Submonoid A) [IsLocalization M T]
    (S : Submonoid R) [IsLocalization S V] :
    IsRegularRing (T ⊗[V] IsLocalRing.ResidueField V) := by
  have : IsRegularRing (T ⊗[R] IsLocalRing.ResidueField V) :=
    isRegularRing_tensor_localization (R := R) M
  exact IsRegularRing.of_ringEquiv
    (IsLocalization.algebraTensorEquiv S V T (IsLocalRing.ResidueField V)).symm.toRingEquiv

private theorem isDomain_specialFiber
    {R A : Type*} [CommRing R] [IsLocalRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [IsRegularRing (A ⊗[R] IsLocalRing.ResidueField R)] :
    IsDomain (A ⧸ (Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule A A))) := by
  rw [ideal_smul_top_self]
  let I := Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)
  have : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      (IsLocalRing.map_maximalIdeal_le _))
  have : IsLocalRing (A ⧸ I) := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  let e : (A ⧸ I) ≃+* A ⊗[R] IsLocalRing.ResidueField R :=
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor A
      (IsLocalRing.maximalIdeal R)).toRingEquiv.trans
        (Algebra.TensorProduct.comm R (R ⧸ IsLocalRing.maximalIdeal R) A).toRingEquiv
  have : IsRegularRing (A ⧸ I) := IsRegularRing.of_ringEquiv e.symm
  have : IsRegularLocalRing (A ⧸ I) := IsRegularLocalRing.of_isRegularRing_of_isLocalRing _
  exact IsRegularLocalRing.isDomain _

private theorem generic_nontrivial
    {R A K : Type*} [CommRing R] [IsDomain R]
    [CommRing A] [Nontrivial A] [Algebra R A] [Module.Flat R A]
    [Field K] [Algebra R K] [IsFractionRing R K] :
    Nontrivial (A ⊗[R] K) := by
  have hM : Algebra.algebraMapSubmonoid A (nonZeroDivisors R) ≤ nonZeroDivisors A := by
    rintro _ ⟨r, hr, rfl⟩
    apply isRegular_iff_mem_nonZeroDivisors.mp
    apply (Commute.isRegular_iff (fun a => mul_comm _ a)).2
    simpa only [IsLeftRegular, IsSMulRegular, Algebra.smul_def] using
      (Module.Flat.isSMulRegular_of_nonZeroDivisors (M := A) hr)
  exact (IsLocalization.injective (A ⊗[R] K) hM).nontrivial

private theorem invertible_ideal_ne_bot
    {A : Type*} [CommRing A] [Nontrivial A]
    (I : Ideal A) [Module.Invertible A I] : I ≠ ⊥ := by
  intro h
  have : Subsingleton I := by rw [h]; infer_instance
  have : (0 : A) = 1 := FaithfulSMul.eq_of_smul_eq_smul
    (fun x : I => Subsingleton.elim _ _)
  exact zero_ne_one this

private theorem invertible_comap_generic_local
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [IsLocalRing A] [Algebra R A] [IsLocalHom (algebraMap R A)]
    [Module.Flat R A] [Algebra.EssFiniteType R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [IsRegularRing (A ⊗[R] IsLocalRing.ResidueField R)]
    (J : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) J] :
    Module.Invertible A (Ideal.comap (algebraMap A (A ⊗[R] K)) J) := by
  have hfp := (essentiallyOfFinitePresentation_and_finitePresentation_of_flat_of_valuationRing
    (A := R) (B := A) (M := A)).1 inferInstance
  have : Nontrivial (A ⊗[R] K) := generic_nontrivial
  exact invertible_comap_of_regular_specialFiber hfp isDomain_specialFiber J
    (invertible_ideal_ne_bot J)

private theorem ideal_localized'_eq_map
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (M : Submonoid R) [IsLocalization M S] (I : Ideal R) :
    I.localized' S M (Algebra.linearMap R S) = I.map (algebraMap R S) := by
  rw [Submodule.localized'_eq_span]
  rfl

/-- The extension of an invertible ideal to a localization is an invertible ideal. -/
theorem _root_.Ideal.invertible_map_of_isLocalization
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (M : Submonoid R) [IsLocalization M S]
    (I : Ideal R) [Module.Invertible R I] :
    Module.Invertible S (I.map (algebraMap R S)) := by
  rw [← ideal_localized'_eq_map M I]
  exact Module.Invertible.of_isLocalization M (I.toLocalized' S M (Algebra.linearMap R S))

private theorem ideal_map_comap_localization
    {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra R B] [Algebra S B] [Algebra A B]
    [IsScalarTower R S B] [IsScalarTower R A B]
    (M : Submonoid R) [IsLocalization M S]
    [IsLocalization (Algebra.algebraMapSubmonoid A M) B] (I : Ideal A) :
    (I.comap (algebraMap R A)).map (algebraMap R S) =
      (I.map (algebraMap A B)).comap (algebraMap S B) := by
  apply (IsLocalization.orderEmbedding M S).injective
  ext x
  show algebraMap R S x ∈ (I.comap (algebraMap R A)).map (algebraMap R S) ↔
    algebraMap S B (algebraMap R S x) ∈ I.map (algebraMap A B)
  rw [← IsScalarTower.algebraMap_apply R S B, IsScalarTower.algebraMap_apply R A B]
  rw [IsLocalization.algebraMap_mem_map_algebraMap_iff (M := M) S,
    IsLocalization.algebraMap_mem_map_algebraMap_iff
      (M := Algebra.algebraMapSubmonoid A M) B]
  constructor
  · rintro ⟨s, hs, h⟩
    refine ⟨algebraMap R A s, ⟨s, hs, rfl⟩, ?_⟩
    simpa only [Ideal.mem_comap, map_mul] using h
  · rintro ⟨t, ⟨s, hs, rfl⟩, h⟩
    refine ⟨s, hs, ?_⟩
    simpa only [Ideal.mem_comap, map_mul] using h

/-- The preimage of an invertible ideal under a ring isomorphism is an invertible ideal. -/
theorem _root_.Ideal.invertible_comap_ringEquiv
    {A B : Type*} [CommRing A] [CommRing B]
    (e : A ≃+* B) (I : Ideal B) [Module.Invertible B I] :
    Module.Invertible A (I.comap e) := by
  let : Algebra B A := e.symm.toRingHom.toAlgebra
  have : IsLocalization (IsUnit.submonoid B) A :=
    IsLocalization.of_le_isUnit_of_bijective
      Algebra.algebraMapSubmonoid_isUnit_le_isUnit e.symm.bijective
  have h : I.map (algebraMap B A) = I.comap e :=
    Ideal.map_comap_of_equiv e.symm
  rw [← h]
  exact Ideal.invertible_map_of_isLocalization (IsUnit.submonoid B) I

private theorem invertible_comap_generic_of_smooth_localization
    {R A T V K : Type*} [CommRing R] [CommRing A] [CommRing T]
    [CommRing V] [IsDomain V] [ValuationRing V] [IsLocalRing T]
    [Algebra R A] [Algebra R T] [Algebra A T] [IsScalarTower R A T]
    [Algebra R V] [Algebra V T] [IsScalarTower R V T]
    [IsLocalHom (algebraMap V T)] [Algebra.Smooth R A]
    [Field K] [Algebra V K] [IsFractionRing V K]
    (M : Submonoid A) [IsLocalization M T]
    (S : Submonoid R) [IsLocalization S V]
    (J : Ideal (T ⊗[V] K)) [Module.Invertible (T ⊗[V] K) J] :
    Module.Invertible T (Ideal.comap (algebraMap T (T ⊗[V] K)) J) := by
  have : Module.Flat A T := IsLocalization.flat T M
  have : Module.Flat R T := Module.Flat.trans R A T
  have : Module.Flat V T := (Module.flat_iff_of_isLocalization V S T).2 inferInstance
  have : Algebra.EssFiniteType A T := Algebra.EssFiniteType.of_isLocalization T M
  have : Algebra.EssFiniteType R T := Algebra.EssFiniteType.comp R A T
  have : Algebra.EssFiniteType V T := Algebra.EssFiniteType.of_comp R V T
  have : IsRegularRing (T ⊗[V] IsLocalRing.ResidueField V) :=
    isRegularRing_specialFiber_of_smooth_localization (R := R) M S
  exact invertible_comap_generic_local J

private theorem invertible_localization_comap_generic
    {R A T V K : Type*} [CommRing R] [CommRing A] [CommRing T]
    [CommRing V] [IsDomain V] [ValuationRing V] [IsLocalRing T]
    [Algebra R A] [Algebra R T] [Algebra A T] [IsScalarTower R A T]
    [Algebra R V] [Algebra V T] [IsScalarTower R V T]
    [IsLocalHom (algebraMap V T)] [Algebra.Smooth R A]
    [Field K] [Algebra R K] [Algebra V K] [IsScalarTower R V K] [IsFractionRing V K]
    (M : Submonoid A) [IsLocalization M T]
    (S : Submonoid R) [IsLocalization S V]
    (I : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) I] :
    Module.Invertible T
      ((I.comap (algebraMap A (A ⊗[R] K))).map (algebraMap A T)) := by
  let : Algebra A (T ⊗[R] K) := Algebra.TensorProduct.leftAlgebra
  have : IsScalarTower A T (T ⊗[R] K) := inferInstance
  let φ : A ⊗[R] K →ₐ[R] T ⊗[R] K :=
    Algebra.TensorProduct.map (IsScalarTower.toAlgHom R A T) (AlgHom.id R K)
  let : Algebra (A ⊗[R] K) (T ⊗[R] K) := φ.toRingHom.toAlgebra
  obtain ⟨_, _⟩ := isLocalization_tensor_of_algebraMap_eq (R := R) (T := T) (K := K) M rfl
  let J := I.map (algebraMap (A ⊗[R] K) (T ⊗[R] K))
  have : Module.Invertible (T ⊗[R] K) J :=
    Ideal.invertible_map_of_isLocalization (Algebra.algebraMapSubmonoid (A ⊗[R] K) M) I
  let e := IsLocalization.algebraTensorEquiv S V T K
  have : Module.Invertible (T ⊗[V] K) (J.comap e) :=
    Ideal.invertible_comap_ringEquiv e.toRingEquiv J
  have h := invertible_comap_generic_of_smooth_localization M S (J.comap e)
  have he : (J.comap e).comap (algebraMap T (T ⊗[V] K)) =
      J.comap (algebraMap T (T ⊗[R] K)) := by
    ext t
    show e (t ⊗ₜ[V] 1) ∈ J ↔ t ⊗ₜ[R] 1 ∈ J
    rfl
  rw [he] at h
  exact Module.Invertible.congr (LinearEquiv.ofEq _ _
    (ideal_map_comap_localization (B := T ⊗[R] K) M I).symm)

private theorem invertible_comap_generic_atPrime
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [Algebra R A] [Algebra.Smooth R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (I : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) I]
    (q : Ideal A) [q.IsPrime] :
    Module.Invertible (Localization.AtPrime q)
      ((I.comap (algebraMap A (A ⊗[R] K))).map (algebraMap A (Localization.AtPrime q))) := by
  let p := q.under R
  let V := Localization.AtPrime p
  let T := Localization.AtPrime q
  let : Algebra V T := Localization.AtPrime.algebraOfLiesOver p q
  have : IsScalarTower R V T := inferInstance
  have : IsLocalHom (algebraMap V T) := by
    show IsLocalHom (Localization.localRingHom p q (algebraMap R A) _)
    infer_instance
  have : ValuationRing V := valuationRing_localization_atPrime p
  let kmap : V →ₐ[R] K := IsLocalization.liftAlgHom
    (f := Algebra.ofId R K) (fun s : p.primeCompl =>
      IsLocalization.map_units K ⟨s.1, Ideal.primeCompl_le_nonZeroDivisors p s.2⟩)
  let : Algebra V K := kmap.toRingHom.toAlgebra
  have : IsScalarTower R V K := IsScalarTower.of_algebraMap_eq' kmap.comp_algebraMap.symm
  have : IsFractionRing V K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization p.primeCompl V K
  exact invertible_localization_comap_generic (V := V) q.primeCompl p.primeCompl I

/-- A finitely presented ideal which becomes invertible at a prime `q` is generated by a single
nonzerodivisor after inverting some element outside `q`. -/
theorem _root_.Ideal.exists_away_eq_span_isRegular_of_invertible_atPrime
    {A : Type*} [CommRing A] (I : Ideal A) [Module.FinitePresentation A I]
    (q : Ideal A) [q.IsPrime]
    [Module.Invertible (Localization.AtPrime q)
      (I.map (algebraMap A (Localization.AtPrime q)))] :
    ∃ r : A, r ∉ q ∧ ∃ f : Localization.Away r,
      IsRegular f ∧ I.map (algebraMap A (Localization.Away r)) = Ideal.span {f} := by
  let T := Localization.AtPrime q
  let L := I.localized' T q.primeCompl (Algebra.linearMap A T)
  have : Module.Invertible T L :=
    Module.Invertible.congr (LinearEquiv.ofEq _ _ (ideal_localized'_eq_map q.primeCompl I).symm)
  have : Module.Free T L := Module.free_of_flat_of_isLocalRing
  obtain ⟨r, hr, hfree, hrank⟩ := Module.FinitePresentation.exists_free_localizedModule_powers
    q.primeCompl (I.toLocalized' T q.primeCompl (Algebra.linearMap A T)) T
  have : Module.Free (Localization.Away r) (LocalizedModule.Away r I) := hfree
  let φ : Localization.Away r →+* T := IsLocalization.lift
    (fun s : Submonoid.powers r => IsLocalization.map_units T
      ⟨s.1, (Submonoid.powers_le.mpr hr) s.2⟩)
  have : Nontrivial (Localization.Away r) := φ.domain_nontrivial
  obtain ⟨e⟩ := Module.nonempty_linearEquiv_of_finrank_eq_one
    (hrank.trans (Module.Invertible.finrank_eq_one T L))
  let S := Localization.Away r
  let g := I.toLocalized' S (Submonoid.powers r) (Algebra.linearMap A S)
  let e' := IsLocalizedModule.mapEquiv (Submonoid.powers r)
    (LocalizedModule.mkLinearMap (Submonoid.powers r) I) g S (LinearEquiv.refl A I)
  obtain ⟨f, hf, hI⟩ := exists_regular_generator_of_linearEquiv _ (e.trans e')
  refine ⟨r, hr, f, hf, ?_⟩
  simpa only [ideal_localized'_eq_map] using hI

private theorem finitePresentation_comap_generic
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [Algebra R A] [Algebra.FiniteType R A] [Module.Flat R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (I : Ideal (A ⊗[R] K)) :
    Module.FinitePresentation A (I.comap (algebraMap A (A ⊗[R] K))) := by
  let J := I.comap (algebraMap A (A ⊗[R] K))
  have : Module.Finite A J := Module.Finite.iff_fg.mpr (fg_comap_generic (R := R) I)
  have : Module.Flat R J := flat_of_isTorsionFree_valuationRing
  exact (finitePresentation_of_flat_of_finiteType_of_valuationRing
    (A := R) (B := A) (M := J)).2 inferInstance inferInstance

/-- Let `A` be a smooth algebra over a valuation ring `R` with fraction field `K`, and let
`I ⊆ A ⊗_R K` be an invertible ideal. Then near every prime `q` of `A` the contraction `I ∩ A` is
generated by a single nonzerodivisor: there is `r ∉ q` with `(I ∩ A)_r = (f)` and `f` regular.
-/
theorem exists_away_eq_span_isRegular_comap_genericFibre
    {R A K : Type*} [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing A] [Algebra R A] [Algebra.Smooth R A]
    [Field K] [Algebra R K] [IsFractionRing R K]
    (I : Ideal (A ⊗[R] K)) [Module.Invertible (A ⊗[R] K) I]
    (q : Ideal A) [q.IsPrime] :
    ∃ r : A, r ∉ q ∧ ∃ f : Localization.Away r, IsRegular f ∧
      (I.comap (algebraMap A (A ⊗[R] K))).map (algebraMap A (Localization.Away r)) =
        Ideal.span {f} := by
  have := finitePresentation_comap_generic (R := R) I
  have := invertible_comap_generic_atPrime I q
  exact Ideal.exists_away_eq_span_isRegular_of_invertible_atPrime _ q

