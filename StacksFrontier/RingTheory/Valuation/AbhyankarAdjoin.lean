module

public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
public import StacksFrontier.RingTheory.DimensionFormula

/-!
# Adjoining finitely many elements of a local overring, and localizing

Let `φ : B → V` be an injective local homomorphism of local domains, `B` Noetherian, and
`w₁, …, w_k ∈ V`. The `B`-algebra `B[w]` generated by the `w_t` inside `V` is presented here as
`B[X₁, …, X_k] ⧸ ker(X_t ↦ w_t)`, so that it lives in the universe of `B`, and is localized at the
prime `𝔪_V ∩ B[w]`. The result `B[w]_𝔮` is a Noetherian local domain with an injective local
homomorphism to `V` extending `φ` and sending `X_t` to `w_t`; the dimension formula (Stacks 02IJ)
bounds its dimension by `dim B + trdeg_B B[w]`. When every `w_t` is a fraction of elements of
`φ(B)` the transcendence degree vanishes and `dim B[w]_𝔮 ≤ dim B`.

This is the enlargement step in the proof of Abhyankar's inequality.

## Main definitions

* `Stacks.Abhyankar.liftAtPrime`: the extension of an injective map `g : A → V` to the
  localization of `A` at `g⁻¹(𝔪_V)`.
* `Stacks.Abhyankar.Adjoin`, `Stacks.Abhyankar.AdjoinLoc`: `B[w]` and its localization.
* `Stacks.Abhyankar.adjoinLocHom`: the induced injective local map `B[w]_𝔮 → V`.

## Main results

* `Stacks.Abhyankar.liftAtPrime_injective`, `Stacks.Abhyankar.isLocalHom_liftAtPrime`.
* `Stacks.Abhyankar.height_maximalIdeal_adjoinLoc_add_trdeg_le`: the dimension formula bound.
* `Stacks.Abhyankar.height_maximalIdeal_adjoinLoc_le`: `dim B[w]_𝔮 ≤ dim B` for fractions `w`.

## References

* [Stacks Project, Tag 02IJ](https://stacks.math.columbia.edu/tag/02IJ)
-/

@[expose] public section

namespace Stacks.Abhyankar

open IsLocalRing

section LiftAtPrime

variable {A : Type*} [CommRing A] [IsDomain A] {V : Type*} [CommRing V] [IsDomain V]
  [IsLocalRing V] (g : A →+* V) (p : Ideal A) [p.IsPrime]
  (hp : Ideal.comap g (maximalIdeal V) = p)

omit [IsDomain A] [IsDomain V] [p.IsPrime] in
include hp in
/-- If `p = g⁻¹(𝔪_V)` and `a ∉ p`, then `g a` is a unit of `V`. -/
theorem isUnit_of_notMem (a : A) (ha : a ∉ p) : IsUnit (g a) :=
  IsLocalRing.notMem_maximalIdeal.mp fun h => ha (hp ▸ Ideal.mem_comap.mpr h)

omit [IsDomain A] [IsDomain V] in
include hp in
/-- If `p = g⁻¹(𝔪_V)`, then `g` sends every element of the complement of `p` to a unit. -/
theorem isUnit_of_mem_primeCompl (y : p.primeCompl) : IsUnit (g y) :=
  isUnit_of_notMem g p hp y y.2

/-- The extension of `g : A → V` to the localization of `A` at `p = g⁻¹(𝔪_V)`. -/
noncomputable def liftAtPrime : Localization.AtPrime p →+* V :=
  IsLocalization.lift (M := p.primeCompl) (isUnit_of_mem_primeCompl g p hp)

omit [IsDomain A] [IsDomain V] in
/-- `liftAtPrime g p hp` agrees with `g` on the image of `A`. -/
theorem liftAtPrime_algebraMap (a : A) :
    liftAtPrime g p hp (algebraMap A (Localization.AtPrime p) a) = g a :=
  IsLocalization.lift_eq _ a

omit [IsDomain V] in
/-- If `g` is injective, then so is its extension `liftAtPrime g p hp` to `A_p`. -/
theorem liftAtPrime_injective (hg : Function.Injective g) :
    Function.Injective (liftAtPrime g p hp) := by
  rw [liftAtPrime, IsLocalization.lift_injective_iff]
  exact fun x y => ⟨fun h => congrArg g
    (IsLocalization.injective _ p.primeCompl_le_nonZeroDivisors h), fun h => congrArg _ (hg h)⟩

omit [IsDomain A] [IsDomain V] in
/-- The extension `liftAtPrime g p hp : A_p → V` is a local homomorphism. -/
theorem isLocalHom_liftAtPrime : IsLocalHom (liftAtPrime g p hp) := by
  refine ⟨fun a ha => ?_⟩
  obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl a
  set w := liftAtPrime g p hp (IsLocalization.mk' (Localization.AtPrime p) b s)
  have hw : g b = g s * w :=
    (IsLocalization.lift_mk'_spec (M := p.primeCompl) (S := Localization.AtPrime p)
      (isUnit_of_mem_primeCompl g p hp) b w s).mp rfl
  have hgb : IsUnit (g b) := hw ▸ (isUnit_of_mem_primeCompl g p hp s).mul ha
  have hb : b ∈ p.primeCompl := Ideal.mem_primeCompl_iff.mpr fun hbp =>
    (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mem_comap.mp (hp.symm ▸ hbp)) hgb
  exact isUnit_iff_exists_inv.mpr ⟨_, IsLocalization.mk'_mul_mk'_eq_one'
    (S := Localization.AtPrime p) b s hb⟩

end LiftAtPrime

section Adjoin

variable {B : Type*} [CommRing B] {V : Type*} [CommRing V] (φ : B →+* V) {k : ℕ}
  (w : Fin k → V)

/-- The evaluation `B[X₁, …, X_k] → V`, `X_t ↦ w_t`, extending `φ`. -/
noncomputable def adjoinHom : MvPolynomial (Fin k) B →+* V := MvPolynomial.eval₂Hom φ w

/-- The `B`-algebra `B[w] ⊆ V` generated by the `w_t`, presented as a quotient of a polynomial
ring over `B`, so that it lives in the universe of `B`. -/
abbrev Adjoin : Type _ := MvPolynomial (Fin k) B ⧸ RingHom.ker (adjoinHom φ w)

/-- The inclusion `B[w] → V`. -/
noncomputable def adjoinLift : Adjoin φ w →+* V := RingHom.kerLift (adjoinHom φ w)

/-- The map `B[w] → V` is injective. -/
theorem adjoinLift_injective : Function.Injective (adjoinLift φ w) :=
  RingHom.kerLift_injective _

/-- The map `B[w] → V` sends the image of `b ∈ B` to `φ b`. -/
theorem adjoinLift_algebraMap (b : B) : adjoinLift φ w (algebraMap B (Adjoin φ w) b) = φ b := by
  change RingHom.kerLift (adjoinHom φ w) (Ideal.Quotient.mk _ (MvPolynomial.C b)) = φ b
  rw [RingHom.kerLift_mk, adjoinHom, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]

/-- The map `B[w] → V` sends the class of `X_t` to `w_t`. -/
theorem adjoinLift_X (t : Fin k) :
    adjoinLift φ w (Ideal.Quotient.mk _ (MvPolynomial.X t)) = w t := by
  rw [adjoinLift, RingHom.kerLift_mk, adjoinHom, MvPolynomial.coe_eval₂Hom,
    MvPolynomial.eval₂_X]

/-- The composite `B → B[w] → V` is `φ`. -/
theorem adjoinLift_comp_algebraMap :
    (adjoinLift φ w).comp (algebraMap B (Adjoin φ w)) = φ :=
  RingHom.ext (adjoinLift_algebraMap φ w)

/-- `B[w]` is a domain when `V` is. -/
instance [IsDomain V] : IsDomain (Adjoin φ w) :=
  (adjoinLift_injective φ w).isDomain _

/-- `B[w]` is Noetherian when `B` is. -/
instance [IsNoetherianRing B] : IsNoetherianRing (Adjoin φ w) := inferInstance

/-- `B[w]` is a finitely generated `B`-algebra. -/
instance : Algebra.FiniteType B (Adjoin φ w) :=
  Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ B _) (Ideal.Quotient.mkₐ_surjective B _)

variable [IsLocalRing V]

/-- The prime `𝔮 = 𝔪_V ∩ B[w]`. -/
noncomputable def adjoinPrime : Ideal (Adjoin φ w) := Ideal.comap (adjoinLift φ w) (maximalIdeal V)

/-- The ideal `𝔮 = 𝔪_V ∩ B[w]` is prime. -/
instance : (adjoinPrime φ w).IsPrime := Ideal.comap_isPrime _ _

/-- The localization `B[w]_𝔮`. -/
abbrev AdjoinLoc : Type _ := Localization.AtPrime (adjoinPrime φ w)

variable [IsDomain V]

/-- The inclusion `B[w]_𝔮 → V`. -/
noncomputable def adjoinLocHom : AdjoinLoc φ w →+* V :=
  liftAtPrime (adjoinLift φ w) (adjoinPrime φ w) rfl

/-- The map `B[w]_𝔮 → V` is injective. -/
theorem adjoinLocHom_injective : Function.Injective (adjoinLocHom φ w) :=
  liftAtPrime_injective _ _ _ (adjoinLift_injective φ w)

/-- The map `B[w]_𝔮 → V` is a local homomorphism. -/
instance : IsLocalHom (adjoinLocHom φ w) := isLocalHom_liftAtPrime _ _ _

/-- `B[w]_𝔮` is Noetherian when `B` is. -/
instance [IsNoetherianRing B] : IsNoetherianRing (AdjoinLoc φ w) :=
  IsLocalization.isNoetherianRing (adjoinPrime φ w).primeCompl _ inferInstance

/-- The image of `X_t` in `B[w]_𝔮`. -/
noncomputable def adjoinGen (t : Fin k) : AdjoinLoc φ w :=
  algebraMap (Adjoin φ w) (AdjoinLoc φ w) (Ideal.Quotient.mk _ (MvPolynomial.X t))

omit [IsDomain V] in
/-- The map `B[w]_𝔮 → V` sends the image of `X_t` to `w_t`. -/
theorem adjoinLocHom_adjoinGen (t : Fin k) : adjoinLocHom φ w (adjoinGen φ w t) = w t :=
  (liftAtPrime_algebraMap (adjoinLift φ w) (adjoinPrime φ w) rfl _).trans (adjoinLift_X φ w t)

omit [IsDomain V] in
/-- The map `B[w]_𝔮 → V` sends the image of `b ∈ B` to `φ b`. -/
theorem adjoinLocHom_algebraMap (b : B) :
    adjoinLocHom φ w (algebraMap B (AdjoinLoc φ w) b) = φ b := by
  rw [IsScalarTower.algebraMap_apply B (Adjoin φ w) (AdjoinLoc φ w)]
  exact (liftAtPrime_algebraMap (adjoinLift φ w) (adjoinPrime φ w) rfl _).trans
    (adjoinLift_algebraMap φ w b)

omit [IsDomain V] in
/-- The composite `B → B[w]_𝔮 → V` is `φ`. -/
theorem adjoinLocHom_comp_algebraMap :
    (adjoinLocHom φ w).comp (algebraMap B (AdjoinLoc φ w)) = φ :=
  RingHom.ext (adjoinLocHom_algebraMap φ w)

variable [IsDomain B] [IsLocalRing B] [IsLocalHom φ]

omit [IsLocalRing V] [IsDomain V] [IsDomain B] [IsLocalRing B] [IsLocalHom φ] in
/-- If `φ` is injective, then so is `B → B[w]`. -/
theorem algebraMap_adjoin_injective (hφ : Function.Injective φ) :
    Function.Injective (algebraMap B (Adjoin φ w)) := by
  intro a b h
  apply hφ
  rw [← adjoinLift_algebraMap φ w a, ← adjoinLift_algebraMap φ w b, h]

/-- The prime `𝔮` lies over the maximal ideal of `B`. -/
instance : (adjoinPrime φ w).LiesOver (maximalIdeal B) :=
  ⟨by rw [Ideal.under, adjoinPrime, Ideal.comap_comap, adjoinLift_comp_algebraMap,
    IsLocalRing.maximalIdeal_comap]⟩

omit [IsDomain V] [IsDomain B] [IsLocalRing B] [IsLocalHom φ] in
/-- The height of the maximal ideal of `B[w]_𝔮` equals the height of `𝔮`. -/
theorem height_maximalIdeal_adjoinLoc :
    (maximalIdeal (AdjoinLoc φ w)).height = (adjoinPrime φ w).height := by
  have h1 := IsLocalization.AtPrime.ringKrullDim_eq_height (adjoinPrime φ w) (AdjoinLoc φ w)
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim] at h1
  exact_mod_cast h1

/-- **The dimension formula for `B[w]_𝔮`** (Stacks 02IJ):
`dim B[w]_𝔮 + trdeg_{κ(𝔪_B)} κ(𝔮) ≤ dim B + trdeg_B B[w]`. -/
theorem height_maximalIdeal_adjoinLoc_add_trdeg_le [IsNoetherianRing B]
    (hφ : Function.Injective φ) :
    letI := Ideal.ResidueField.algebraOfLiesOver (maximalIdeal B) (adjoinPrime φ w)
    (maximalIdeal (AdjoinLoc φ w)).height +
        (Cardinal.toNat (Algebra.trdeg (maximalIdeal B).ResidueField
          (adjoinPrime φ w).ResidueField) : ℕ∞) ≤
      (maximalIdeal B).height + (Cardinal.toNat (Algebra.trdeg B (Adjoin φ w)) : ℕ∞) := by
  rw [height_maximalIdeal_adjoinLoc]
  exact height_add_trdeg_residue_le (algebraMap_adjoin_injective φ w hφ) (maximalIdeal B)
    (adjoinPrime φ w)

omit [IsLocalRing V] [IsDomain V] [IsLocalRing B] [IsLocalHom φ] in
/-- If every `w_t` is a fraction `φ(b_t)/φ(a_t)` of elements of `φ(B)`, then `B[w]` is algebraic
over `B`. -/
theorem isAlgebraic_adjoin (_hφ : Function.Injective φ)
    (hw : ∀ t, ∃ a b : B, a ≠ 0 ∧ φ a * w t = φ b) :
    Algebra.IsAlgebraic B (Adjoin φ w) := by
  have hgen : ∀ t, IsAlgebraic B (Ideal.Quotient.mk (RingHom.ker (adjoinHom φ w))
      (MvPolynomial.X t)) := by
    intro t
    obtain ⟨a, b, ha, hab⟩ := hw t
    refine ⟨Polynomial.C a * Polynomial.X - Polynomial.C b, ?_, ?_⟩
    · exact fun h0 => ha (by simpa [Polynomial.coeff_C] using congrArg (Polynomial.coeff · 1) h0)
    · apply adjoinLift_injective φ w
      simp only [Polynomial.aeval_C, Polynomial.aeval_X, map_sub, map_mul,
        adjoinLift_algebraMap, adjoinLift_X, map_zero, hab, sub_self]
  have htop : Algebra.adjoin B (Set.range fun t => Ideal.Quotient.mk
      (RingHom.ker (adjoinHom φ w)) (MvPolynomial.X t)) = ⊤ := by
    have e : Algebra.adjoin B (Set.range fun t => Ideal.Quotient.mk
        (RingHom.ker (adjoinHom φ w)) (MvPolynomial.X t)) =
        (Algebra.adjoin B (Set.range (MvPolynomial.X : Fin k → MvPolynomial (Fin k) B))).map
          (Ideal.Quotient.mkₐ B (RingHom.ker (adjoinHom φ w))) := by
      rw [AlgHom.map_adjoin, ← Set.range_comp]
      rfl
    rw [e, MvPolynomial.adjoin_range_X, Algebra.map_top]
    exact (AlgHom.range_eq_top _).mpr (Ideal.Quotient.mkₐ_surjective B _)
  have halg := (Algebra.isAlgebraic_adjoin_iff (R := B) (s := Set.range fun t =>
      Ideal.Quotient.mk (RingHom.ker (adjoinHom φ w)) (MvPolynomial.X t))).mpr
    (Set.forall_mem_range.mpr hgen)
  rw [htop] at halg
  exact ⟨fun y => halg y trivial⟩

/-- **`dim B[w]_𝔮 ≤ dim B`** when every `w_t` is a fraction of elements of `φ(B)`. -/
theorem height_maximalIdeal_adjoinLoc_le [IsNoetherianRing B] (hφ : Function.Injective φ)
    (hw : ∀ t, ∃ a b : B, a ≠ 0 ∧ φ a * w t = φ b) :
    (maximalIdeal (AdjoinLoc φ w)).height ≤ (maximalIdeal B).height := by
  let := Ideal.ResidueField.algebraOfLiesOver (maximalIdeal B) (adjoinPrime φ w)
  have h := height_maximalIdeal_adjoinLoc_add_trdeg_le φ w hφ
  have := isAlgebraic_adjoin φ w hφ hw
  have h0 : Algebra.trdeg B (Adjoin φ w) = 0 := trdeg_eq_zero_iff.mpr inferInstance
  rw [h0] at h
  exact le_self_add.trans (h.trans (by simp))

end Adjoin

end Stacks.Abhyankar
