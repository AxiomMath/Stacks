/-!
# Abhyankar's inequality: the composite of a valuation ring at a prime

For a valuation ring `V`, a nonzero nonunit `g ∈ V` and `P` the ideal of elements divisible by
every power of `g`, the valuation ring `V` is the composite of `V_P` (whose value group is the
value group of `V` modulo the convex subgroup generated by `v(g)`) and of `V/P` (whose value group
is that convex subgroup). This file proves the facts about `P`, `V_P` and `V/P` used to split the
bound `r ≤ dim B` of Abhyankar's inequality along this composite, phrased with associates rather
than value groups, together with the linear algebra that splits a family of independent values.

## Main definitions

* `Stacks.Abhyankar.powDvdIdeal`: the ideal `⋂ₙ gⁿ V`.
* `Stacks.Abhyankar.RelP`: `y` and `z` have the same value modulo the units of `V_P`.

## Main results

* `Stacks.Abhyankar.powDvdIdeal_isPrime`: `⋂ₙ gⁿ V` is prime for `g` a nonunit.
* `Stacks.Abhyankar.relP_of_associated`: elements associated in `V_P` are related by `RelP`.
* `Stacks.Abhyankar.associated_of_associated_quotient`: elements outside `P` associated in `V/P`
  are associated in `V`.
* `Stacks.Abhyankar.exists_complement_coordinates`: a family of standard basis vectors which is a
  basis modulo a subspace `W` of `ℚ^ι`.

## References

* O. Zariski, P. Samuel, *Commutative Algebra*, vol. II, Chapter VI, §10, and Appendix 2.
-/

@[expose] public section

namespace Stacks.Abhyankar

open IsLocalRing

section PowDvd

variable {V : Type*} [CommRing V] [IsDomain V] [ValuationRing V]

/-- The ideal `⋂ₙ gⁿ V` of elements divisible by every power of `g`. -/
def powDvdIdeal (g : V) : Ideal V where
  carrier := {a | ∀ n : ℕ, g ^ n ∣ a}
  add_mem' ha hb n := dvd_add (ha n) (hb n)
  zero_mem' _ := dvd_zero _
  smul_mem' c _ ha n := Dvd.dvd.mul_left (ha n) c

omit [IsDomain V] [ValuationRing V] in
/-- An element lies in `⋂ₙ gⁿ V` if and only if it is divisible by every power of `g`. -/
theorem mem_powDvdIdeal {g a : V} : a ∈ powDvdIdeal g ↔ ∀ n : ℕ, g ^ n ∣ a := Iff.rfl

/-- For `g` a nonunit of a valuation ring, `⋂ₙ gⁿ V` is a prime ideal. -/
theorem powDvdIdeal_isPrime {g : V} (hg : ¬IsUnit g) : (powDvdIdeal g).IsPrime := by
  refine ⟨?_, ?_⟩
  · rw [Ne, Ideal.eq_top_iff_one, mem_powDvdIdeal]
    intro h
    exact hg (isUnit_of_dvd_one (by simpa using h 1))
  · intro a b hab
    by_contra hcon
    rw [not_or, mem_powDvdIdeal, mem_powDvdIdeal] at hcon
    push Not at hcon
    obtain ⟨⟨n, hn⟩, m, hm⟩ := hcon
    have ha0 : a ≠ 0 := fun h => hn (h ▸ dvd_zero _)
    obtain ⟨c, hc⟩ : a ∣ g ^ n := (ValuationRing.dvd_total a (g ^ n)).resolve_right hn
    obtain ⟨e, he⟩ := hab (n + m)
    apply hm
    refine ⟨c * e, mul_left_cancel₀ ha0 ?_⟩
    rw [he, pow_add, hc]
    ring

omit [ValuationRing V] in
/-- A nonzero nonunit `g` does not lie in `⋂ₙ gⁿ V`. -/
theorem notMem_powDvdIdeal_self {g : V} (hg0 : g ≠ 0) (hg : ¬IsUnit g) :
    g ∉ powDvdIdeal g := by
  intro h
  obtain ⟨c, hc⟩ := h 2
  exact hg (isUnit_iff_exists_inv.mpr
    ⟨c, mul_left_cancel₀ hg0 (by rw [← mul_assoc, ← sq, ← hc, mul_one])⟩)

end PowDvd

section RelP

variable {V : Type*} [CommRing V] [IsDomain V]

/-- `y` and `z` have the same value modulo the units of `V_P`: `a y = b z` for some `a, b ∉ P`. -/
def RelP (P : Ideal V) (y z : V) : Prop := ∃ a b : V, a ∉ P ∧ b ∉ P ∧ a * y = b * z

omit [IsDomain V] in
/-- The relation `RelP P` is symmetric. -/
theorem RelP.symm {P : Ideal V} {y z : V} (h : RelP P y z) : RelP P z y := by
  obtain ⟨a, b, ha, hb, h⟩ := h
  exact ⟨b, a, hb, ha, h.symm⟩

omit [IsDomain V] in
/-- If `RelP P y z`, then `RelP P (y * t) (z * t)`. -/
theorem RelP.mul_right {P : Ideal V} {y z : V} (h : RelP P y z) (t : V) :
    RelP P (y * t) (z * t) := by
  obtain ⟨a, b, ha, hb, h⟩ := h
  exact ⟨a, b, ha, hb, by rw [← mul_assoc, h, mul_assoc]⟩

/-- If `t ≠ 0` and `RelP P (y * t) (z * t)`, then `RelP P y z`. -/
theorem RelP.cancel_right {P : Ideal V} {y z t : V} (ht : t ≠ 0) (h : RelP P (y * t) (z * t)) :
    RelP P y z := by
  obtain ⟨a, b, ha, hb, h⟩ := h
  exact ⟨a, b, ha, hb, mul_right_cancel₀ ht (by rw [mul_assoc, h, mul_assoc])⟩

/-- Elements whose images in `V_P` are associated are related by `RelP`. -/
theorem relP_of_associated (P : Ideal V) [P.IsPrime] {y z : V}
    (h : Associated (algebraMap V (Localization.AtPrime P) y)
      (algebraMap V (Localization.AtPrime P) z)) : RelP P y z := by
  obtain ⟨u, hu⟩ := h
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.mk'_surjective P.primeCompl (u : Localization.AtPrime P)
  dsimp only at hs
  have ha : a ∈ P.primeCompl :=
    (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime P) P a s).mp
      (hs ▸ u.isUnit)
  rw [← hs, IsLocalization.mul_mk'_eq_mk'_of_mul, ← IsLocalization.mk'_one
    (M := P.primeCompl) (Localization.AtPrime P) z, IsLocalization.mk'_eq_iff_eq] at hu
  have h2 := IsLocalization.injective (Localization.AtPrime P) P.primeCompl_le_nonZeroDivisors hu
  simp only [OneMemClass.coe_one, one_mul] at h2
  exact ⟨a, s, ha, s.2, by rwa [mul_comm]⟩

variable [ValuationRing V]

/-- Two elements outside a prime `P` of a valuation ring which are associated in `V/P` are
associated in `V`: a difference lying in `P` is a multiple of either of them by an element of
`P`, hence does not change the value. -/
theorem associated_of_associated_quotient (P : Ideal V) [hP : P.IsPrime] {y z : V} (hz : z ∉ P)
    (h : Associated (Ideal.Quotient.mk P y) (Ideal.Quotient.mk P z)) : Associated y z := by
  obtain ⟨u, hu⟩ := h
  obtain ⟨u', hu'⟩ := Ideal.Quotient.mk_surjective (u : V ⧸ P)
  obtain ⟨v', hv'⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : V ⧸ P)
  have hPm : P ≤ maximalIdeal V := IsLocalRing.le_maximalIdeal hP.ne_top
  have huv : u' * v' - 1 ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hu', hv', map_one, Units.mul_inv,
      sub_self]
  have hu'unit : IsUnit u' := by
    by_contra hnu
    simpa using Ideal.sub_mem _
      (Ideal.mul_mem_right v' _ ((IsLocalRing.mem_maximalIdeal _).mpr hnu)) (hPm huv)
  have hπ : y * u' - z ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hu', hu, sub_self]
  rcases ValuationRing.dvd_total z (y * u' - z) with ⟨t, ht⟩ | ⟨c, hc⟩
  · have ht' : t ∈ P := (hP.mem_or_mem (ht ▸ hπ)).resolve_left hz
    have h1t : IsUnit (1 + t) := by
      simpa using IsLocalRing.isUnit_one_sub_self_of_mem_nonunits (-t)
        ((IsLocalRing.mem_maximalIdeal _).mp (neg_mem (hPm ht')))
    have hyz : y * u' = z * (1 + t) := by rw [mul_add, mul_one, ← ht]; ring
    refine ⟨hu'unit.unit * h1t.unit⁻¹, ?_⟩
    rw [Units.val_mul, ← mul_assoc, IsUnit.unit_spec, hyz, mul_assoc, IsUnit.mul_val_inv,
      mul_one]
  · exact absurd (hc ▸ Ideal.mul_mem_right c P hπ) hz

end RelP

section Monomial

variable {V : Type*} [CommRing V] {ι : Type*} [Fintype ι]

/-- A monomial in elements outside a prime ideal `P` lies outside `P`. -/
theorem monom_notMem {P : Ideal V} [P.IsPrime] {x : ι → V} (hx : ∀ i, x i ∉ P) (α : ι → ℕ) :
    monom x α ∉ P := by
  intro h
  obtain ⟨i, -, hi⟩ := Ideal.IsPrime.prod_mem_iff.mp h
  exact hx i (Ideal.IsPrime.mem_of_pow_mem inferInstance _ hi)

/-- A monomial in a subfamily `x ∘ a` is the monomial in `x` with exponents extended by zero. -/
theorem monom_comp_of_injective {κ : Type*} [Fintype κ] {a : κ → ι} (ha : Function.Injective a)
    (x : ι → V) (α : κ → ℕ) : monom (x ∘ a) α = monom x (Function.extend a α 0) := by
  classical
  rw [monom, monom, ← Finset.prod_subset (Finset.subset_univ (Finset.univ.map ⟨a, ha⟩)),
    Finset.prod_map]
  · exact Finset.prod_congr rfl fun k _ => by simp [ha.extend_apply]
  · intro i _ hi
    have : ¬∃ k, a k = i := by
      rintro ⟨k, rfl⟩
      exact hi (Finset.mem_map_of_mem _ (Finset.mem_univ k))
    rw [Function.extend_apply' _ _ _ this]
    simp

/-- Multiplying the exponents of a monomial by `n` raises the monomial to the `n`-th power. -/
theorem monom_nsmul (x : ι → V) (n : ℕ) (α : ι → ℕ) : monom x (n • α) = monom x α ^ n := by
  simp [monom, ← Finset.prod_pow, ← pow_mul, mul_comm]

/-- The monomial with exponent `∑ j ∈ s, α j` is the product of the monomials with exponents
`α j`. -/
theorem monom_sum {κ : Type*} (s : Finset κ) (x : ι → V) (α : κ → ι → ℕ) :
    monom x (∑ j ∈ s, α j) = ∏ j ∈ s, monom x (α j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [monom_zero]
  | insert j s hj ih => rw [Finset.sum_insert hj, Finset.prod_insert hj, monom_add, ih]

/-- If `z_j x^{β_j} = x^{α_j}` for each `j`, then `z^c x^{Σ c_j β_j} = x^{Σ c_j α_j}`. -/
theorem monom_mul_monom_sum_eq {κ : Type*} [Fintype κ] (x : ι → V) (z : κ → V)
    (α β : κ → ι → ℕ) (hz : ∀ j, monom x (β j) * z j = monom x (α j)) (c : κ → ℕ) :
    monom z c * monom x (∑ j, c j • β j) = monom x (∑ j, c j • α j) := by
  rw [monom_sum, monom_sum, monom, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [monom_nsmul, monom_nsmul, ← hz j, mul_pow, mul_comm]

end Monomial

section LinearAlgebra

universe u

variable {ι : Type u} [Fintype ι] [DecidableEq ι]

omit [DecidableEq ι] in
/-- For a subspace `W ⊆ ℚ^ι` there is a set of coordinates `a : κ ↪ ι` with
`#κ + dim W = #ι` such that no nonzero vector of `W` is supported on `a(κ)`: the standard basis
vectors indexed by `κ` form a basis of `ℚ^ι / W`. -/
theorem exists_complement_coordinates (W : Submodule ℚ (ι → ℚ)) :
    ∃ (κ : Type u) (_ : Fintype κ) (a : κ → ι), Function.Injective a ∧
      (∀ v ∈ W, (∀ i, i ∉ Set.range a → v i = 0) → v = 0) ∧
      Fintype.card κ + Module.finrank ℚ W = Fintype.card ι := by
  classical
  let e' : ι → (ι → ℚ) ⧸ W := fun i => W.mkQ (Pi.single i 1)
  obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' ℚ e'
  have hspan' : Submodule.span ℚ (Set.range e') = ⊤ := by
    have : Set.range e' = W.mkQ '' Set.range (Pi.basisFun ℚ ι) := by
      rw [← Set.range_comp]
      congr 1
    rw [this, Submodule.span_image, (Pi.basisFun ℚ ι).span_eq, Submodule.map_top,
      Submodule.range_mkQ]
  have : Fintype κ := Fintype.ofInjective a ha
  refine ⟨κ, inferInstance, a, ha, ?_, ?_⟩
  · intro v hv hsupp
    have hv_eq : v = ∑ k, v (a k) • Pi.single (a k) (1 : ℚ) := by
      funext i
      simp only [Finset.sum_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, mul_ite,
        mul_one, mul_zero]
      by_cases hi : i ∈ Set.range a
      · obtain ⟨k₀, rfl⟩ := hi
        rw [Finset.sum_eq_single k₀]
        · simp
        · intro k _ hk
          simp only [ite_eq_right_iff]
          intro h
          exact absurd (ha h) (Ne.symm hk)
        · simp
      · rw [hsupp i hi]
        refine (Finset.sum_eq_zero fun k _ => ?_).symm
        have : i ≠ a k := fun h => hi ⟨k, h.symm⟩
        simp [this]
    have hsum : ∑ k, v (a k) • (e' ∘ a) k = 0 := by
      have : W.mkQ v = 0 := (Submodule.Quotient.mk_eq_zero W).mpr hv
      rw [hv_eq, map_sum] at this
      simpa [e', map_smul] using this
    have hzero := Fintype.linearIndependent_iff.mp hli (fun k => v (a k)) hsum
    funext i
    by_cases hi : i ∈ Set.range a
    · obtain ⟨k, rfl⟩ := hi
      exact hzero k
    · exact hsupp i hi
  · have h1 := Submodule.finrank_quotient_add_finrank W
    rwa [Module.finrank_eq_card_basis (Module.Basis.mk hli (hspan.trans hspan').ge),
      Module.finrank_fintype_fun_eq_card] at h1

omit [Fintype ι] [DecidableEq ι] in
/-- A linearly independent family of elements of a set `D ⊆ ℚ^ι` indexed by `Fin (dim span D)`. -/
theorem exists_linearIndependent_fin [Finite ι] (D : Set (ι → ℚ)) :
    ∃ b : Fin (Module.finrank ℚ (Submodule.span ℚ D)) → ι → ℚ,
      (∀ j, b j ∈ D) ∧ LinearIndependent ℚ b := by
  classical
  obtain ⟨κ, a, -, hspan, hli⟩ := exists_linearIndependent' ℚ (Subtype.val : D → ι → ℚ)
  have : Finite κ := hli.finite
  have : Fintype κ := Fintype.ofFinite κ
  have hcard : Fintype.card κ = Module.finrank ℚ (Submodule.span ℚ D) := by
    rw [← finrank_span_eq_card hli, hspan, Subtype.range_coe]
  let eqv : Fin (Module.finrank ℚ (Submodule.span ℚ D)) ≃ κ :=
    (Fintype.equivFinOfCardEq hcard).symm
  exact ⟨fun j => (a (eqv j)).1, fun j => (a (eqv j)).2, hli.comp eqv eqv.injective⟩

end LinearAlgebra

end Stacks.Abhyankar
