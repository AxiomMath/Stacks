private theorem assoc_comp_lTensor
    {A C D P X Y : Type*} [CommRing A] [CommRing C] [CommRing D]
    [Algebra A C] [Algebra C D] [Algebra A D] [IsScalarTower A C D]
    [AddCommGroup P] [Module A P] [Module C P] [IsScalarTower A C P]
    [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
    (u : X →ₗ[A] Y) :
    (assoc A C C D P Y).toLinearMap ∘ₗ lTensor C (D ⊗[C] P) u =
      LinearMap.lTensor D (lTensor C P u) ∘ₗ (assoc A C C D P X).toLinearMap := by
  ext
  rfl

private theorem lTensor_baseChange_injective_iff
    {A C D P X Y : Type*} [CommRing A] [CommRing C] [CommRing D]
    [Algebra A C] [Algebra C D] [Algebra A D] [IsScalarTower A C D]
    [AddCommGroup P] [Module A P] [Module C P] [IsScalarTower A C P]
    [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
    (u : X →ₗ[A] Y) :
    Function.Injective (LinearMap.lTensor (D ⊗[C] P) u) ↔
      Function.Injective (LinearMap.lTensor D (lTensor C P u)) := by
  rw [← coe_lTensor (A := C),
    ← EquivLike.comp_injective _ (assoc A C C D P Y),
    ← LinearEquiv.coe_coe, ← LinearMap.coe_comp, _root_.assoc_comp_lTensor,
    LinearMap.coe_comp, LinearEquiv.coe_coe, EquivLike.injective_comp]

private theorem flat_baseChange_of_flat
    {A C D P : Type*} [CommRing A] [CommRing C] [CommRing D]
    [Algebra A C] [Algebra C D] [Algebra A D] [IsScalarTower A C D]
    [AddCommGroup P] [Module A P] [Module C P] [IsScalarTower A C P]
    [Module.Flat A P] [Module.Flat C D] :
    Module.Flat A (D ⊗[C] P) := by
  rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
  intro X Y _ _ _ _ u hu
  rw [_root_.lTensor_baseChange_injective_iff]
  exact Module.Flat.lTensor_preserves_injective_linearMap (M := D) _
    (Module.Flat.lTensor_preserves_injective_linearMap (M := P) u hu)

private theorem smul_top_comap_ringEquiv_eq
    {R S M : Type*} [CommRing R] [CommRing S] [AddCommGroup M]
    [Module R M] [Module S M] (e : R ≃+* S)
    (hsmul : ∀ (r : R) (x : M), r • x = (e r) • x) (I : Ideal R) :
    ∀ x, (x ∈ I • (⊤ : Submodule R M) ↔
      x ∈ (I.comap e.symm) • (⊤ : Submodule S M)) := by
  refine fun x => ⟨fun hx => ?_, fun hx => ?_⟩
  · refine Submodule.smul_induction_on hx ?_ fun _ _ => Submodule.add_mem _
    intro r hr m hm
    rw [hsmul r m]
    exact Submodule.smul_mem_smul (Ideal.mem_comap.mpr (by simpa using hr))
      (show m ∈ (⊤ : Submodule S M) from Submodule.mem_top)
  · refine Submodule.smul_induction_on hx ?_ fun _ _ => Submodule.add_mem _
    intro s hs m hm
    have hr : e.symm s ∈ I := Ideal.mem_comap.mp hs
    have hmem := Submodule.smul_mem_smul hr
      (show m ∈ (⊤ : Submodule R M) from Submodule.mem_top)
    rw [hsmul (e.symm s) m, e.apply_symm_apply] at hmem
    exact hmem

private theorem mem_span_smul_top_of_faithfullyFlat
    {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.FaithfullyFlat R S] [AddCommGroup M] [Module R M]
    (r : R) (x : M)
    (hx : (1 : S) ⊗ₜ[R] x ∈
      Ideal.span {(algebraMap R S r)} • (⊤ : Submodule S (S ⊗[R] M))) :
    x ∈ Ideal.span {r} • (⊤ : Submodule R M) := by
  let I : Ideal R := Ideal.span {r}
  let Q := M ⧸ (I • (⊤ : Submodule R M))
  let q : M →ₗ[R] Q := (I • (⊤ : Submodule R M)).mkQ
  let f : S ⊗[R] M →ₗ[S] S ⊗[R] Q :=
    TensorProduct.AlgebraTensorModule.lTensor S S q
  have hkill (z : S ⊗[R] Q) : algebraMap R S r • z = 0 := by
    induction z using TensorProduct.inductionOn with
    | tmul s y =>
        obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective
          (I • (⊤ : Submodule R M)) y
        rw [TensorProduct.smul_tmul']
        rw [IsScalarTower.algebraMap_smul (R := R) (A := S) r s,
          TensorProduct.smul_tmul]
        have hzeroq : r • (Submodule.Quotient.mk m : Q) = 0 := by
          change Submodule.Quotient.mk (r • m) = 0
          apply (Submodule.Quotient.mk_eq_zero (I • (⊤ : Submodule R M))).mpr
          exact Submodule.smul_mem_smul (by simp [I]) Submodule.mem_top
        rw [hzeroq, TensorProduct.tmul_zero]
    | add z₁ z₂ hz₁ hz₂ => simp [hz₁, hz₂]
  have hzero : f ((1 : S) ⊗ₜ[R] x) = 0 := by
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro c hc y hy
      rw [map_smul]
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hc
      rw [← ha, mul_smul]
      rw [hkill, smul_zero]
    · intro y z hy hz
      simp [hy, hz]
  have hqx : (1 : S) ⊗ₜ[R] q x = 0 := by
    simpa [f] using hzero
  have hinj := Module.FaithfullyFlat.tensorProduct_mk_injective (A := R) (B := S) Q
  have hqzero : q x = 0 := by
    apply hinj
    simpa using hqx
  exact (Submodule.Quotient.mk_eq_zero _).mp hqzero

/-- A linear map sends `I • ⊤` into `(I.map (algebraMap R S)) • ⊤` of any scalar-tower extension. -/
private theorem map_mem_map_smul_top
    {R S M M' : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M'] [Module S M']
    [IsScalarTower R S M'] (f : M →ₗ[R] M') (I : Ideal R) {x : M}
    (hx : x ∈ I • (⊤ : Submodule R M)) :
    f x ∈ I.map (algebraMap R S) • (⊤ : Submodule S M') := by
  refine Submodule.smul_induction_on hx (fun r hr m _ => ?_) fun y z hy hz => ?_
  · rw [map_smul, ← algebraMap_smul S r (f m)]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top
  · rw [map_add]
    exact Submodule.add_mem _ hy hz

/-- **Stacks Tag 0ASX**, the existence assertion. Let `A → B` be a local ring map of local rings
which is essentially of finite type, let `N` be a finite `B`-module which is flat as an
`A`-module, and let `A` be a valuation ring. Then every element of `N` has a content ideal in the
sense of Stacks 0ASA.

The proof is the source's: the content ideal is produced over the henselization `Aʰ` of `A`,
where Stacks 05U7 applies, and descended to `A`. -/
theorem exists_isContentIdeal_of_valuationRing
    {A : Type u} {B : Type v} {N : Type w}
    [CommRing A] [IsDomain A] [ValuationRing A]
    [CommRing B] [IsLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
    [Algebra.EssFiniteType A B]
    [AddCommGroup N] [Module A N] [Module B N] [IsScalarTower A B N]
    [Module.Finite B N] [Module.Flat A N]
    (x : N) :
    ∃ I : Ideal A, IsContentIdeal x I := by
  obtain ⟨Ah, hAhComm, hAhAlg, hAhLocal, hAhLocalHom, hAhProps⟩ :=
    IsLocalRing.exists_henselization A
  let : CommRing Ah := hAhComm
  let : Algebra A Ah := hAhAlg
  let : IsLocalRing Ah := hAhLocal
  let : IsLocalHom (algebraMap A Ah) := hAhLocalHom
  obtain ⟨hAhHenselian, hAhIndEtale, hAhMaximal, hAhResidue⟩ := hAhProps
  let : HenselianLocalRing Ah := hAhHenselian
  have hAhResEq : ∃ e : ResidueField A ≃+* ResidueField Ah, ∀ a : A,
      e (residue A a) = residue Ah (algebraMap A Ah a) :=
    ⟨RingEquiv.ofBijective (ResidueField.map (algebraMap A Ah)) hAhResidue,
      ResidueField.map_residue (algebraMap A Ah)⟩
  let : IsHenselization A (ResidueField A) Ah :=
    IsLocalRing.IsHenselization.of_ind_etale hAhHenselian hAhIndEtale hAhResEq
  let κsep := SeparableClosure (ResidueField A)
  let : Field κsep := inferInstance
  let : Algebra (ResidueField A) κsep := inferInstance
  let : IsSepClosure (ResidueField A) κsep := inferInstance
  obtain ⟨Ash, hAshComm, hAshLocal, hAshA, hAshAh, hAshTower, hAshLocalHom,
      hAshProps⟩ :=
    IsLocalRing.exists_strictHenselization A Ah hAhIndEtale hAhResidue.2 κsep
  let : CommRing Ash := hAshComm
  let : IsLocalRing Ash := hAshLocal
  let : Algebra A Ash := hAshA
  let : Algebra Ah Ash := hAshAh
  let : IsScalarTower A Ah Ash := hAshTower
  let : IsLocalHom (algebraMap Ah Ash) := hAshLocalHom
  obtain ⟨hAshHenselian, _, hAshIndEtale, _, hAshRes⟩ := hAshProps
  let : HenselianLocalRing Ash := hAshHenselian
  let : IsHenselization A κsep Ash :=
    IsLocalRing.IsHenselization.of_ind_etale hAshHenselian hAshIndEtale hAshRes
  obtain ⟨hAhDomain, hAhValuation, _, _, hAhExtension, _, hAhWeak, _⟩ :=
    ValuationRing.isWeaklyUnramified_henselization_and_strictHenselization
      A Ah Ash κsep
  let : IsDomain Ah := hAhDomain
  let : ValuationRing Ah := hAhValuation
  obtain ⟨Bh, hBhComm, hBhAlg, hBhLocal, hBhLocalHom, hBhProps⟩ :=
    IsLocalRing.exists_henselization B
  let : CommRing Bh := hBhComm
  let : Algebra B Bh := hBhAlg
  let : IsLocalRing Bh := hBhLocal
  let : IsLocalHom (algebraMap B Bh) := hBhLocalHom
  obtain ⟨hBhHenselian, hBhIndEtale, hBhMaximal, hBhResidue⟩ := hBhProps
  let : HenselianLocalRing Bh := hBhHenselian
  have hBhResEq : ∃ e : ResidueField B ≃+* ResidueField Bh, ∀ b : B,
      e (residue B b) = residue Bh (algebraMap B Bh b) :=
    ⟨RingEquiv.ofBijective (ResidueField.map (algebraMap B Bh)) hBhResidue,
      ResidueField.map_residue (algebraMap B Bh)⟩
  let : IsHenselization B (ResidueField B) Bh :=
    IsLocalRing.IsHenselization.of_ind_etale hBhHenselian hBhIndEtale hBhResEq
  let : Algebra A Bh := ((algebraMap B Bh).comp (algebraMap A B)).toAlgebra
  let : IsScalarTower A B Bh := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsLocalHom (algebraMap A Bh) := RingHom.isLocalHom_comp _ _
  have hMap := StacksDraft.existsUnique_henselization_map
    (R := A) (A := A) (Ah := Ah) (B := Bh)
  obtain ⟨f, hf, hcomp, _⟩ := hMap
  let : IsLocalization.AtPrime A (maximalIdeal A) :=
    IsLocalization.of_le_isUnit fun _ ha => IsLocalRing.notMem_maximalIdeal.mp ha
  let : IsLocalization.AtPrime B (maximalIdeal B) :=
    IsLocalization.of_le_isUnit fun _ hb => IsLocalRing.notMem_maximalIdeal.mp hb
  let D := Ah ⊗[A] B
  let g : D →ₐ[A] Bh :=
    Algebra.TensorProduct.lift f (IsScalarTower.toAlgHom A B Bh) fun _ _ => .all _ _
  have hTensor := StacksDraft.exists_isHenselization_localization_tensorProduct
    (R := A) (Rp := A) (Rh := Ah) (S := B) (Sq := B) (Sh := Bh)
    (p := maximalIdeal A) (q := maximalIdeal B)
    (Lr := ResidueField A) (Ls := ResidueField B) f hf
  obtain ⟨Q, hQ, hQL, hQR, hQg, hAlg, hAlgData⟩ := hTensor
  let C := Localization.AtPrime Q
  let : IsLocalization.AtPrime C Q := inferInstance
  let : CommRing C := inferInstance
  let : IsLocalRing C := IsLocalization.AtPrime.isLocalRing C Q
  let : Algebra D C := inferInstance
  let : Algebra B D := Algebra.TensorProduct.rightAlgebra
  let : Algebra Ah D := Algebra.TensorProduct.leftAlgebra
  let : IsScalarTower A B D := inferInstance
  let : IsScalarTower A Ah D := inferInstance
  let : Algebra.IsPushout A Ah B D := inferInstance
  let : Algebra B C := ((algebraMap D C).comp
    (Algebra.TensorProduct.includeRight : B →ₐ[A] D).toRingHom).toAlgebra
  let : Algebra Ah C := inferInstance
  let : IsScalarTower Ah D C := inferInstance
  let P := D ⊗[B] N
  let : IsScalarTower Ah D P := inferInstance
  have hDfinite : Module.Finite D P := Module.Finite.base_change B D N
  let eP : P ≃ₗ[Ah] Ah ⊗[A] N := Algebra.IsPushout.cancelBaseChange A Ah B D N
  have hPflat : Module.Flat Ah P := (Module.Flat.equiv_iff eP).mpr (Module.Flat.baseChange A Ah N)
  have hDCflat : Module.Flat D C := IsLocalization.flat C Q.primeCompl
  let M' := C ⊗[D] P
  have hMflat : Module.Flat Ah M' := flat_baseChange_of_flat (A := Ah) (C := D) (D := C) (P := P)
  have hMfinite : Module.Finite C M' := Module.Finite.base_change D C P
  let : Algebra.EssFiniteType Ah D := Algebra.EssFiniteType.baseChange A B Ah
  let : Algebra.EssFiniteType D C := Algebra.EssFiniteType.of_isLocalization C Q.primeCompl
  let Ah' := ULift.{max u v} Ah
  let eAh : Ah' ≃+* Ah := ULift.ringEquiv
  let : CommRing Ah' := inferInstance
  let : Algebra Ah' Ah := ULift.algebra' Ah _
  let : Algebra Ah' C := ULift.algebra' Ah _
  let : IsLocalRing Ah' := eAh.symm.isLocalRing
  let : HenselianLocalRing Ah' := Stacks.Henselian.henselianLocalRing_of_ringEquiv eAh.symm
  let : Module.Finite Ah' Ah :=
    Module.Finite.of_surjective (Algebra.linearMap Ah' Ah) eAh.surjective
  let : Algebra.FiniteType Ah' Ah := inferInstance
  let : Algebra.EssFiniteType Ah' Ah := inferInstance
  have hEssLift : Algebra.EssFiniteType Ah' C := Algebra.EssFiniteType.comp Ah' Ah C
  have hAhC_local : IsLocalHom (algebraMap Ah C) := by
    refine ⟨fun a ha => ?_⟩
    have hnotQ : Algebra.TensorProduct.includeLeftRingHom (R := A) (A := Ah) (B := B) a ∉ Q := by
      apply (IsLocalization.AtPrime.isUnit_to_map_iff (S := C) (I := Q)
        (x := Algebra.TensorProduct.includeLeftRingHom (R := A) (A := Ah) (B := B) a)).mp
      have hmap : algebraMap Ah C a =
          algebraMap D C (Algebra.TensorProduct.includeLeftRingHom
            (R := A) (A := Ah) (B := B) a) := by
        rw [IsScalarTower.algebraMap_apply Ah D C]
        rfl
      rw [hmap] at ha
      exact ha
    have hnot : a ∉ maximalIdeal Ah := by
      intro ham
      apply hnotQ
      have hcomp : a ∈ Q.comap
          (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := Ah) (B := B)) := by
        rw [hQL]
        exact ham
      exact Ideal.mem_comap.mpr hcomp
    exact IsLocalRing.notMem_maximalIdeal.mp hnot
  let : IsLocalHom (eAh.toRingHom) := ⟨(isLocalHom_equiv eAh).map_nonunit⟩
  let : IsLocalHom (algebraMap Ah' Ah) := by change IsLocalHom (eAh.toRingHom); infer_instance
  let : IsLocalHom (algebraMap Ah' C) := RingHom.isLocalHom_comp _ _
  have hMflat' : Module.Flat Ah' M' := Module.Flat.ulift_left_iff.mpr hMflat
  let xM : M' := 1 ⊗ₜ[D] (1 ⊗ₜ[B] x)
  obtain ⟨J, hJ⟩ := Module.exists_isContentIdeal_of_colimit_free_presentation
    (A := Ah') (B := C) (N := M') hEssLift xM
  let e := eAh.symm
  let Ih : Ideal Ah := J.comap e.toRingHom
  have hsmul (r : Ah) (m : M') : r • m = (e r) • m := by
    calc
      r • m = (algebraMap Ah C r) • m :=
        (IsScalarTower.algebraMap_smul (R := Ah) (A := C) r m).symm
      _ = (algebraMap Ah' C (e r)) • m := by
        congr 1
      _ = (e r) • m := IsScalarTower.algebraMap_smul (R := Ah') (A := C) (e r) m
  have hIh : IsContentIdeal xM Ih := by
    refine ⟨?_, ?_⟩
    · have hm := smul_top_comap_ringEquiv_eq e hsmul Ih xM
      have heq : Ih.comap e.symm.toRingHom = J := by
        ext z
        change e (e.symm z) ∈ J ↔ z ∈ J
        simp
      have hmem : xM ∈ (Ih.comap e.symm.toRingHom) •
          (⊤ : Submodule Ah' M') := by rw [heq]; exact hJ.mem_smul_top
      exact hm.mpr hmem
    · intro K hxK
      have hxK' := (smul_top_comap_ringEquiv_eq e hsmul K xM).mp hxK
      have hle := hJ.le_of_mem_smul_top hxK'
      intro r hr
      have hr' : e r ∈ J := by simpa [Ih] using hr
      have hrK : e r ∈ K.comap e.symm.toRingHom := hle hr'
      exact Ideal.mem_comap.mp hrK
  let : Ih.IsPrincipal := IsBezout.isPrincipal_of_FG Ih (contentIdeal_fg xM Ih hIh)
  let a : Ah := Submodule.IsPrincipal.generator Ih
  have haI : Ideal.span {a} = Ih := Submodule.IsPrincipal.span_singleton_generator Ih
  let : ValuationRing.IsExtension (algebraMap A Ah) := hAhExtension
  obtain ⟨t, ht⟩ : ∃ t : A, Ih = Ideal.span {algebraMap A Ah t} := by
    by_cases hazero : a = 0
    · refine ⟨0, ?_⟩
      rw [← haI, hazero]
      simp
    · obtain ⟨a₀, c₀, u, ha₀, hc₀, hfact⟩ :=
        ValuationRing.factor_of_weak (algebraMap A Ah) hAhExtension hAhWeak a hazero
      obtain ⟨d, hd | hd⟩ := ValuationRing.cond a₀ c₀
      · have hfa₀ : algebraMap A Ah a₀ ≠ 0 := fun hz =>
          ha₀ (hAhExtension.1 (by simpa using hz))
        have hprod : (1 : Ah) = (u : Ah) * a * algebraMap A Ah d := by
          apply mul_left_cancel₀ hfa₀
          have heq : algebraMap A Ah a₀ =
              ((u : Ah) * a * algebraMap A Ah d) * algebraMap A Ah a₀ := by
            calc
              algebraMap A Ah a₀ = (u : Ah) * a * algebraMap A Ah c₀ := hfact
              _ = (u : Ah) * a * (algebraMap A Ah a₀ * algebraMap A Ah d) := by
                rw [← map_mul, hd]
              _ = ((u : Ah) * a * algebraMap A Ah d) * algebraMap A Ah a₀ := by ring
          simpa [mul_comm] using heq
        have huProd : IsUnit ((u : Ah) * a * algebraMap A Ah d) := by
          rw [← hprod]
          exact isUnit_one
        have hua : IsUnit ((u : Ah) * a) := isUnit_of_mul_isUnit_left huProd
        have haunit : IsUnit a :=
          isUnit_of_mul_isUnit_right (x := (u : Ah)) (y := a) hua
        refine ⟨1, ?_⟩
        rw [← haI]
        simp [haunit]
      · have hfc₀ : algebraMap A Ah c₀ ≠ 0 := fun hz =>
          hc₀ (hAhExtension.1 (by simpa using hz))
        have hfd : algebraMap A Ah d = (u : Ah) * a := by
          apply mul_left_cancel₀ hfc₀
          calc
            algebraMap A Ah c₀ * algebraMap A Ah d = algebraMap A Ah a₀ := by
              rw [← map_mul, hd]
            _ = (u : Ah) * a * algebraMap A Ah c₀ := hfact
            _ = algebraMap A Ah c₀ * ((u : Ah) * a) := by ring
        refine ⟨d, ?_⟩
        rw [← haI]
        calc
          Ideal.span {a} = Ideal.span {a * (u : Ah)} :=
            (Ideal.span_singleton_mul_right_unit u.isUnit a).symm
          _ = Ideal.span {algebraMap A Ah d} := by rw [hfd]; simp [mul_comm]
  obtain ⟨hCLocal, hAlgResidue, hCHenselian, hCSep, hcomp⟩ := hAlgData
  let : Algebra C Bh := hAlg
  let fAh : Ah →ₐ[A] Bh := f
  let : Algebra Ah Bh := fAh.toRingHom.toAlgebra
  let : Algebra D Bh := g.toRingHom.toAlgebra
  let : IsScalarTower D C Bh := IsScalarTower.of_algebraMap_eq fun d =>
    (DFunLike.congr_fun hcomp d).symm
  let : IsScalarTower B D Bh := by
    refine IsScalarTower.of_algebraMap_eq fun b => ?_
    have hgR := Algebra.TensorProduct.lift_comp_includeRight f
      (IsScalarTower.toAlgHom A B Bh) (fun _ _ => .all _ _)
    exact (DFunLike.congr_fun hgR b).symm
  have hgL : g.comp
      (Algebra.TensorProduct.includeLeft (R := A) (A := Ah) (B := B)) = f :=
    Algebra.TensorProduct.lift_comp_includeLeft f
      (IsScalarTower.toAlgHom A B Bh) (fun _ _ => .all _ _)
  let : IsScalarTower Ah D Bh :=
    IsScalarTower.of_algebraMap_eq fun a => (DFunLike.congr_fun hgL a).symm
  let : IsScalarTower Ah C Bh := by
    refine IsScalarTower.of_algebraMap_eq fun a => ?_
    calc
      algebraMap Ah Bh a = f a := rfl
      _ = g (algebraMap Ah D a) := (DFunLike.congr_fun hgL a).symm
      _ = algebraMap C Bh (algebraMap D C (algebraMap Ah D a)) :=
        (DFunLike.congr_fun hcomp _).symm
      _ = algebraMap C Bh (algebraMap Ah C a) := by
        rw [IsScalarTower.algebraMap_apply Ah D C]
  let : IsScalarTower A Ah Bh := IsScalarTower.of_algebraMap_eq fun a => by
    exact (f.commutes a).symm
  let : Module.Flat B Bh := IsHenselization.flat (L := ResidueField B)
  let : Module.FaithfullyFlat B Bh := IsHenselization.faithfullyFlat (L := ResidueField B)
  let cancel := TensorProduct.AlgebraTensorModule.cancelBaseChange B D Bh Bh N
  let mapC : C ⊗[D] P →ₗ[C] Bh ⊗[D] P :=
    TensorProduct.AlgebraTensorModule.map (Algebra.linearMap C Bh)
      (LinearMap.id : P →ₗ[D] P)
  let φ : M' →ₗ[Ah] Bh ⊗[B] N :=
    ((cancel.restrictScalars C).toLinearMap.comp mapC).restrictScalars Ah
  have hφx : φ xM = (1 : Bh) ⊗ₜ[B] x := by
    have hmap : mapC xM = (1 : Bh) ⊗ₜ[D] (1 ⊗ₜ[B] x) := by
      simp [mapC, xM, TensorProduct.AlgebraTensorModule.map_tmul]
    change cancel (mapC xM) = _
    rw [hmap, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
    simp
  have hmemBh : (1 : Bh) ⊗ₜ[B] x ∈
      Ideal.span {algebraMap Ah Bh (algebraMap A Ah t)} •
        (⊤ : Submodule Bh (Bh ⊗[B] N)) := by
    have := map_mem_map_smul_top (S := Bh) φ Ih hIh.mem_smul_top
    rwa [ht, Ideal.map_span, Set.image_singleton, hφx] at this
  have hxA : x ∈ Ideal.span {algebraMap A B t} • (⊤ : Submodule B N) := by
    have hgen : algebraMap Ah Bh (algebraMap A Ah t) =
        algebraMap B Bh (algebraMap A B t) := by
      rw [← IsScalarTower.algebraMap_apply A Ah Bh,
        ← IsScalarTower.algebraMap_apply A B Bh]
    rw [hgen] at hmemBh
    exact mem_span_smul_top_of_faithfullyFlat (algebraMap A B t) x hmemBh
  have hmemA : x ∈ Ideal.span {t} • (⊤ : Submodule A N) := by
    refine Submodule.smul_induction_on hxA ?_ ?_
    · intro r hr n hn
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hr
      have hsmul : r • n = t • (b • n) := by
        calc
          r • n = (b * algebraMap A B t) • n := by rw [hb]
          _ = b • ((algebraMap A B t) • n) := mul_smul _ _ _
          _ = (algebraMap A B t) • (b • n) :=
            SMulCommClass.smul_comm b (algebraMap A B t) n
          _ = t • (b • n) := IsScalarTower.algebraMap_smul (R := A) (A := B) t _
      rw [hsmul]
      exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self t) Submodule.mem_top
    · intro y z hy hz
      exact Submodule.add_mem _ hy hz
  let ψ1 : N →ₗ[B] P := TensorProduct.AlgebraTensorModule.mk B D D N 1
  let ψ2 : P →ₗ[D] M' := TensorProduct.AlgebraTensorModule.mk D C C P 1
  let ψ : N →ₗ[A] M' := ((ψ2.restrictScalars B).comp ψ1).restrictScalars A
  have hψx : ψ x = xM := by simp [ψ, ψ1, ψ2, xM]
  let : Module.FaithfullyFlat A Ah := IsHenselization.faithfullyFlat (L := ResidueField A)
  refine ⟨Ideal.span {t}, isContentIdeal_of_forall_le hmemA ?_⟩
  intro K hxK
  have hKmap : xM ∈ (K.map (algebraMap A Ah)) • (⊤ : Submodule Ah M') := by
    rw [← hψx]
    exact map_mem_map_smul_top ψ K hxK
  have hgenK : algebraMap A Ah t ∈ K.map (algebraMap A Ah) :=
    hIh.le_of_mem_smul_top hKmap (by rw [ht]; exact Ideal.mem_span_singleton_self _)
  have htK : t ∈ K := by
    have hcomap := Ideal.comap_map_eq_self_of_faithfullyFlat (A := A) (B := Ah) K
    have : t ∈ Ideal.comap (algebraMap A Ah) (K.map (algebraMap A Ah)) :=
      Ideal.mem_comap.mpr hgenK
    simpa [hcomap] using this
  exact Ideal.span_le.mpr fun z hz => by
    rcases Set.mem_singleton_iff.mp hz with rfl
    exact htK

/-- **Stacks Tag 0ASX.** Let `A → B` be a local ring map of local rings which is essentially of
finite type, and let `N` be a finite `B`-module which is flat as an `A`-module. If `A` is a
valuation ring, then every element `x` of `N` has a content ideal `I ⊆ A` in the sense of
Stacks 0ASA, and that ideal is principal.

Existence is `exists_isContentIdeal_of_valuationRing` and principality is
`IsContentIdeal.isPrincipal_of_valuationRing`. -/
@[stacks 0ASX]
theorem exists_isContentIdeal_isPrincipal_of_valuationRing_of_flat
    {A : Type u} {B : Type v} {N : Type w}
    [CommRing A] [IsDomain A] [ValuationRing A]
    [CommRing B] [IsLocalRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
    [Algebra.EssFiniteType A B]
    [AddCommGroup N] [Module A N] [Module B N] [IsScalarTower A B N]
    [Module.Finite B N] [Module.Flat A N]
    (x : N) :
    ∃ I : Ideal A, IsContentIdeal x I ∧ I.IsPrincipal := by
  obtain ⟨I, hI⟩ := exists_isContentIdeal_of_valuationRing (A := A) (B := B) x
  exact ⟨I, hI, hI.isPrincipal_of_valuationRing⟩

end
