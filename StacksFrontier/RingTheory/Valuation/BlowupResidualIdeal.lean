module

public import Mathlib.RingTheory.Valuation.ValuationRing

/-!
# Residual ideals of a pulled-back blowup centre over a valuation ring

Let `A` be a valuation ring and let `Iₐ, I_b, Jₐ, J_b` be ideals of `A` with
`Jₐ ^ M ≤ Iₐ ⊔ I_b` and `J_b ^ M ≤ Iₐ ⊔ I_b`. Suppose `Iₐ ⊔ Jₐ ^ M = (eₐ)` and
`I_b ⊔ J_b ^ M = (e_b)` are principal and generated by nonzero elements, and that
`Iₐ = (eₐ) I'ₐ` and `I_b = (e_b) I'_b`. Then `I'ₐ = A` or `I'_b = A`.

Geometrically, `A` maps to the two factors of a product `X ×_B X`. The ideals `Iₐ, I_b` and
`Jₐ, J_b` are the pullbacks of the ideal `I` of a closed subspace `D` and of an ideal `J`, along
the two coordinates of a valuation-ring point of a closed subspace on which
`(p₁^* J)^M, (p₂^* J)^M ≤ p₁^* I + p₂^* I`. On the blowup of `X` along `I + J^M`, the
exceptional ideal pulls back to `(eₐ)`, and the residual ideal `I'` of `I` cuts out a closed
subspace containing the strict transform of `D`. The lemma says that at least one of the two
lifted coordinates misses that strict transform.

## Main results

* `ValuationRing.eq_top_or_eq_top_of_pow_le_sup`: the statement above.

## Implementation notes

The proof uses only that the ideals of a valuation ring are totally ordered,
`ValuationRing.le_total_ideal`, and cancellation of a nonzero principal ideal in a domain.
-/

@[expose] public section

open Ideal

namespace ValuationRing

variable {A : Type*} [CommRing A] [IsDomain A] [ValuationRing A]

omit [ValuationRing A] in
/-- If `J ≤ I`, `I ⊔ J = (e)` with `e ≠ 0` and `I = (e) I'`, then `I' = ⊤`. -/
theorem eq_top_of_le_of_sup_eq_span_singleton {I J I' : Ideal A} {e : A} (he : e ≠ 0)
    (hJI : J ≤ I) (hE : I ⊔ J = span {e}) (hI : I = span {e} * I') : I' = ⊤ := by
  rw [sup_eq_left.mpr hJI] at hE
  rw [hE] at hI
  have h : span {e} * I' = span {e} * ⊤ := by rw [mul_top]; exact hI.symm
  exact (span_singleton_mul_right_inj he).mp h

/-- **One of two residual ideals is the unit ideal.** Over a valuation ring `A`, let
`Jₐ ^ M` and `J_b ^ M` lie in `Iₐ ⊔ I_b`, let `Iₐ ⊔ Jₐ ^ M = (eₐ)` and `I_b ⊔ J_b ^ M = (e_b)`
with `eₐ, e_b ≠ 0`, and let `Iₐ = (eₐ) I'ₐ` and `I_b = (e_b) I'_b`. Then `I'ₐ = ⊤` or
`I'_b = ⊤`. -/
theorem eq_top_or_eq_top_of_pow_le_sup {Ia Ib Ja Jb I'a I'b : Ideal A} {ea eb : A} (M : ℕ)
    (hea : ea ≠ 0) (heb : eb ≠ 0) (hJa : Ja ^ M ≤ Ia ⊔ Ib) (hJb : Jb ^ M ≤ Ia ⊔ Ib)
    (hEa : Ia ⊔ Ja ^ M = span {ea}) (hEb : Ib ⊔ Jb ^ M = span {eb})
    (hIa : Ia = span {ea} * I'a) (hIb : Ib = span {eb} * I'b) : I'a = ⊤ ∨ I'b = ⊤ := by
  rcases (ValuationRing.le_total_ideal (A := A)).total Ia Ib with h | h
  · exact Or.inr
      (eq_top_of_le_of_sup_eq_span_singleton heb (hJb.trans (sup_eq_right.mpr h).le) hEb hIb)
  · exact Or.inl
      (eq_top_of_le_of_sup_eq_span_singleton hea (hJa.trans (sup_eq_left.mpr h).le) hEa hIa)

end ValuationRing

end
