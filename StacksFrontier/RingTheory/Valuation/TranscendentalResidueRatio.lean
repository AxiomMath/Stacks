module

public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.RingTheory.Ideal.GoingUp
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.Valuation.ValuationRing

/-!
# Ratios with transcendental residue in a valuation ring

Let `R` be a valuation ring and `B → R` an injective ring map from a domain `B` integral over a
subring `A`. If an element `u` of `R` is a ratio of elements of `B` and its residue is
transcendental over a field `F` mapping to the residue field of `R`, then some ratio of two
elements of `A` lying in `R` already has a residue transcendental over `F`.

The proof is the classical one. Clearing denominators, `u` is a root of a polynomial
`∑ pₖ Xᵏ` with coefficients in `A` and nonzero image in `R`. Dividing by a coefficient `p_{k₀}`
of least valuation gives `∑ wₖ uᵏ = 0` with `wₖ = pₖ / p_{k₀} ∈ R` and `w_{k₀} = 1`. Reducing,
the residue of `u` is algebraic over the field generated by the residues of the `wₖ`, so one of
them is transcendental over `F`.

A second statement is a fact about ideals of local domains: if a product `(a, b) · J` is a nonzero
principal ideal, then `a ∣ b` or `b ∣ a`.

## Main results

* `ValuationRing.exists_ratio_transcendental_residue`: the ratio with transcendental residue.
* `Ideal.dvd_or_dvd_of_span_pair_mul_eq_span_singleton`: a two-generated factor of a nonzero
  principal ideal of a local domain is generated by one of its generators.
-/

@[expose] public section

open Polynomial IsLocalRing

/-- If `∑ wₖ uᵏ = 0` in a local ring with some `w_{k₀} = 1` and the residue of `u` is
transcendental over `F`, then the residue of some `wₖ` is transcendental over `F`. -/
private theorem exists_transcendental_residue_of_sum_eq_zero
    {R : Type*} [CommRing R] [IsLocalRing R] (F : Type*) [Field F] [Algebra F (ResidueField R)]
    {u : R}
    (hu : Transcendental F (residue R u)) {s : Finset ℕ} (w : ℕ → R) {k₀ : ℕ} (hk₀ : k₀ ∈ s)
    (hwk₀ : w k₀ = 1) (hwsum : ∑ k ∈ s, w k * u ^ k = 0) :
    ∃ k ∈ s, Transcendental F (residue R (w k)) := by
  classical
  by_contra hcon
  have halg : ∀ k ∈ s, IsAlgebraic F (residue R (w k)) := by
    intro k hk
    by_contra htr
    exact hcon ⟨k, hk, htr⟩
  let E := algebraicClosure F (ResidueField R)
  let coe : ℕ → E := fun k => if hk : k ∈ s then
    ⟨residue R (w k), mem_algebraicClosure_iff.mpr (halg k hk)⟩ else 0
  let P : E[X] := ∑ k ∈ s, C (coe k) * X ^ k
  apply (hu.algebraicClosure (E := ResidueField R))
  refine ⟨P, fun hP => ?_, ?_⟩
  · have h := congrArg (fun Q : E[X] => Q.coeff k₀) hP
    simp only [P, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow,
      Polynomial.coeff_zero, Finset.sum_ite_eq, if_pos hk₀] at h
    have h' := congrArg Subtype.val h
    simp only [coe, dif_pos hk₀, hwk₀, map_one, ZeroMemClass.coe_zero] at h'
    exact one_ne_zero h'
  · simp only [P, map_sum, map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
    have h := congrArg (residue R) hwsum
    simp only [map_sum, map_mul, map_pow, map_zero] at h
    rw [← h]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [coe, dif_pos hk]
    rfl

namespace ValuationRing

variable {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R]

/-- In a valuation ring, among finitely many elements one divides all the others. -/
theorem exists_dvd_forall_of_finset {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (f : ι → R) :
    ∃ i ∈ s, ∀ j ∈ s, f i ∣ f j := by
  classical
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a => exact ⟨a, by simp⟩
  | cons a s ha hs ih =>
    obtain ⟨i, his, hi⟩ := ih
    rcases ValuationRing.dvd_total (f a) (f i) with h | h
    · refine ⟨a, Finset.mem_cons_self a s, fun j hj => ?_⟩
      rcases Finset.mem_cons.mp hj with rfl | hj
      · exact dvd_rfl
      · exact h.trans (hi j hj)
    · refine ⟨i, Finset.mem_cons_of_mem his, fun j hj => ?_⟩
      rcases Finset.mem_cons.mp hj with rfl | hj
      · exact h
      · exact hi j hj

/-- **A ratio with transcendental residue can be taken with numerator and denominator in an
integral subring.** Let `A → B` be injective with `B` a domain integral over `A`, let
`φ : B → R` be an injective map to a valuation ring `R`, and let `F` be a field mapping to the
residue field of `R`. If `u ∈ R` satisfies `φ a = u * φ b` with `φ b ≠ 0`, and the residue of `u`
is transcendental over `F`, then there are `c, c₀ ∈ A` with `φ c₀ ≠ 0` and `t ∈ R` with
`φ c₀ * t = φ c` whose residue is transcendental over `F`. -/
theorem exists_ratio_transcendental_residue {A B : Type*} [CommRing A] [CommRing B] [IsDomain B]
    [Algebra A B] [Algebra.IsIntegral A B] [FaithfulSMul A B] (φ : B →+* R)
    (hφ : Function.Injective φ) (F : Type*) [Field F] [Algebra F (ResidueField R)]
    (u : R) (a b : B) (hb : φ b ≠ 0) (hab : φ a = u * φ b)
    (hu : Transcendental F (residue R u)) :
    ∃ c c₀ : A, φ (algebraMap A B c₀) ≠ 0 ∧ ∃ t : R,
      φ (algebraMap A B c₀) * t = φ (algebraMap A B c) ∧ Transcendental F (residue R t) := by
  classical
  have : Nontrivial A := (algebraMap A B).domain_nontrivial
  let ψ : A →+* R := φ.comp (algebraMap A B)
  have hψ : Function.Injective ψ := hφ.comp (FaithfulSMul.algebraMap_injective A B)
  -- a nonzero element of `A` divisible by `b`
  have hb0 : b ≠ 0 := fun h => hb (by rw [h, map_zero])
  obtain ⟨c, hcmem, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (Ideal.comap_ne_bot_of_integral_mem hb0 (Ideal.mem_span_singleton_self b)
      (Algebra.IsIntegral.isIntegral (R := A) b))
  obtain ⟨b', hb'⟩ := Ideal.mem_span_singleton'.mp (Ideal.mem_comap.mp hcmem)
  have hψc : ψ c ≠ 0 := fun h => hc0 (hψ (h.trans (map_zero ψ).symm))
  -- `u * ψ c = φ e` for `e = a * b'` integral over `A`
  set e := a * b'
  have hue : u * ψ c = φ e := by
    show u * φ (algebraMap A B c) = φ (a * b')
    rw [← hb', map_mul, map_mul, hab, mul_comm (φ b') (φ b), mul_assoc]
  obtain ⟨Q, hQm, hQ⟩ := Algebra.IsIntegral.isIntegral (R := A) e
  set n := Q.natDegree
  let p : ℕ → A := fun k => Q.coeff k * c ^ k
  have hsum : ∑ k ∈ Finset.range (n + 1), ψ (p k) * u ^ k = 0 := by
    have h0 : φ (Q.eval₂ (algebraMap A B) e) = 0 := by rw [hQ, map_zero]
    rw [Polynomial.eval₂_eq_sum_range, map_sum] at h0
    rw [← h0]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [p, ψ, RingHom.comp_apply, map_mul, map_pow, ← hue]
    ring
  have hpn : ψ (p n) ≠ 0 := by
    show ψ (Q.coeff Q.natDegree * c ^ Q.natDegree) ≠ 0
    rw [hQm.coeff_natDegree, one_mul, map_pow]
    exact pow_ne_zero _ hψc
  -- a coefficient of least valuation
  obtain ⟨k₀, hk₀, hdvd⟩ := exists_dvd_forall_of_finset (Finset.range (n + 1))
    Finset.nonempty_range_add_one (fun k => ψ (p k))
  have hpk₀ : ψ (p k₀) ≠ 0 := fun h => hpn (zero_dvd_iff.mp
    (h ▸ hdvd n (Finset.self_mem_range_succ n)))
  choose! w hw using hdvd
  have hwk₀ : w k₀ = 1 := (mul_right_eq_self₀.mp (hw k₀ hk₀).symm).resolve_right hpk₀
  have hwsum : ∑ k ∈ Finset.range (n + 1), w k * u ^ k = 0 := by
    have h : ψ (p k₀) * ∑ k ∈ Finset.range (n + 1), w k * u ^ k = 0 := by
      rw [Finset.mul_sum, ← hsum]
      refine Finset.sum_congr rfl fun k hk => ?_
      rw [hw k hk, mul_assoc]
    exact (mul_eq_zero.mp h).resolve_left hpk₀
  -- some `wₖ` has transcendental residue
  obtain ⟨k, hk, htr⟩ :=
    exists_transcendental_residue_of_sum_eq_zero F hu w hk₀ hwk₀ hwsum
  exact ⟨p k, p k₀, hpk₀, w k, (hw k hk).symm, htr⟩

end ValuationRing

namespace Ideal

private theorem dvd_of_mul_eq_mul_of_isUnit {R : Type*} [CommRing R] [IsDomain R]
    {a b d r s w : R} (hd : d ≠ 0) (hu : IsUnit r) (hr : a * w = d * r) (hs : b * w = d * s) :
    a ∣ b := by
  have hw0 : w ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hr
    exact hu.ne_zero ((mul_eq_zero.mp hr.symm).resolve_left hd)
  refine ⟨s * ↑hu.unit⁻¹, mul_right_cancel₀ hw0 ?_⟩
  calc b * w = d * s := hs
    _ = d * r * ↑hu.unit⁻¹ * s := by rw [mul_assoc d r, IsUnit.mul_val_inv, mul_one]
    _ = a * (s * ↑hu.unit⁻¹) * w := by
      rw [← hr]
      ring

/-- **A two-generated factor of a nonzero principal ideal of a local domain is generated by one of
its two generators.** If `(a, b) · J = (d)` with `d ≠ 0`, then `a ∣ b` or `b ∣ a`. -/
theorem dvd_or_dvd_of_span_pair_mul_eq_span_singleton {R : Type*} [CommRing R] [IsLocalRing R]
    [IsDomain R] {a b d : R} (J : Ideal R) (hd : d ≠ 0)
    (h : Ideal.span {a, b} * J = Ideal.span {d}) : a ∣ b ∨ b ∣ a := by
  have hle : ∀ x ∈ Ideal.span {a, b} * J, d ∣ x := fun x hx =>
    Ideal.mem_span_singleton.mp (h ▸ hx)
  have hpair : Ideal.span {a, b} = Ideal.span {a} ⊔ Ideal.span {b} := by
    rw [← Ideal.span_union, Set.singleton_union]
  have hdmem : d ∈ Ideal.span {a} * J ⊔ Ideal.span {b} * J := by
    rw [← Ideal.sup_mul, ← hpair, h]
    exact Ideal.mem_span_singleton_self d
  obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp hdmem
  obtain ⟨wa, hwa, rfl⟩ := Ideal.mem_span_singleton_mul.mp hx
  obtain ⟨wb, hwb, rfl⟩ := Ideal.mem_span_singleton_mul.mp hy
  have hdvd : ∀ x ∈ ({a, b} : Set R), ∀ z ∈ J, d ∣ x * z := fun x hx z hz =>
    hle _ (Ideal.mul_mem_mul (Ideal.subset_span hx) hz)
  obtain ⟨ra, hra⟩ := hdvd a (by simp) wa hwa
  obtain ⟨rb, hrb⟩ := hdvd b (by simp) wb hwb
  have hsum : ra + rb = 1 :=
    mul_left_cancel₀ hd (by rw [mul_add, ← hra, ← hrb, hxy, mul_one])
  rcases IsLocalRing.isUnit_or_isUnit_of_add_one hsum with hu | hu
  · obtain ⟨s, hs⟩ := hdvd b (by simp) wa hwa
    exact .inl (dvd_of_mul_eq_mul_of_isUnit hd hu hra hs)
  · obtain ⟨s, hs⟩ := hdvd a (by simp) wb hwb
    exact .inr (dvd_of_mul_eq_mul_of_isUnit hd hu hrb hs)

end Ideal
