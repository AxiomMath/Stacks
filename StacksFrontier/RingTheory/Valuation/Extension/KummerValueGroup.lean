module

public import Mathlib.RingTheory.Valuation.Basic
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GaloisCohomology.KummerProcyclicAbsoluteGalois

/-!
# Valuations on a Kummer extension `F(π^{1/ℓ^k})`

Let `v` be a valuation on a field `Ω`, `F ⊆ Ω` a subfield (an `F`-algebra structure on `Ω` with
`Ω / F` separable), `ℓ` a prime, `F` containing a primitive `ℓ ^ k`-th root of unity, and
`π ∈ F` whose valuation is not an `ℓ`-th power of a valuation of an element of `F`. Let
`α ∈ Ω` with `α ^ (ℓ ^ k) = π`. Then the value group of `F(α)` is generated by that of `F` and
`v(α)`: every nonzero `a ∈ F(α)` has `v(a) = v(c) · v(α)^j` for some `c ∈ F` and `j < ℓ ^ k`.
Equivalently `a = u · c · α^j` with `u ∈ F(α)` a unit for `v`.

The proof writes `a = ∑_{i < ℓ^k} cᵢ αⁱ` in the power basis of `F(α)` (of degree `ℓ ^ k`,
`Stacks.GaloisCohomology.finrank_adjoin_of_pow_eq`). The valuations `v(cᵢ αⁱ)` of the nonzero
terms are pairwise distinct: `v(α)^d ∈ v(Fˣ)` with `0 < d < ℓ ^ k`, together with
`v(α)^{ℓ^k} = v(π)`, would give `v(α)^{ℓ^{k-1}} ∈ v(Fˣ)` by Bézout, and then `v(π)` would be an
`ℓ`-th power in `v(Fˣ)`. Hence `v(a)` is the largest of them.

## Main results

* `Stacks.KummerValuation.eq_of_valuation_mul_pow_eq`: the valuations `v(c αⁱ)`, `i < ℓ ^ k`,
  are pairwise distinct.
* `Stacks.KummerValuation.exists_valuation_eq_mul_pow`: `v(a) = v(c) v(α)^j`.
* `Stacks.KummerValuation.exists_eq_unit_mul_mul_pow`: `a = u · c · α^j` with `v(u) = 1`.

## References

* J.-P. Serre, *Corps locaux*, I §4 and IV §2 (tamely ramified Kummer extensions).
* O. Endler, *Valuation theory*, §20.
-/

@[expose] public noncomputable section

open IntermediateField Module

namespace Stacks.KummerValuation

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω] {Γ₀ : Type*}
  [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation Ω Γ₀)

/-- If `v(π)` is not an `ℓ`-th power of a valuation of an element of `F`, then `α ^ (ℓ ^ k) = π`
forces `α ≠ 0`. -/
private theorem ne_zero_of_pow_eq {ℓ k : ℕ} (hℓ : ℓ.Prime) {π : F}
    (hπ : ∀ c : F, v (algebraMap F Ω c) ^ ℓ ≠ v (algebraMap F Ω π)) {α : Ω}
    (hα : α ^ (ℓ ^ k) = algebraMap F Ω π) : α ≠ 0 := by
  have hπ0 : π ≠ 0 := fun h0 ↦ hπ 0 (by rw [h0, map_zero, v.map_zero, zero_pow hℓ.ne_zero])
  rintro rfl
  rw [zero_pow (pow_ne_zero _ hℓ.ne_zero), eq_comm, map_eq_zero] at hα
  exact hπ0 hα

/-- **The valuations `v(c αⁱ)` for `i < ℓ ^ k` are pairwise distinct**, when `v(π)` is not the
`ℓ`-th power of a valuation of an element of `F` and `α ^ (ℓ ^ k) = π`. -/
theorem eq_of_valuation_mul_pow_eq {ℓ k : ℕ} (hℓ : ℓ.Prime) {π : F}
    (hπ : ∀ c : F, v (algebraMap F Ω c) ^ ℓ ≠ v (algebraMap F Ω π)) {α : Ω}
    (hα : α ^ (ℓ ^ k) = algebraMap F Ω π) {c c' : F} (hc : c ≠ 0) (hc' : c' ≠ 0) {i i' : ℕ}
    (hi : i < ℓ ^ k) (hi' : i' < ℓ ^ k)
    (h : v (algebraMap F Ω c) * v α ^ i = v (algebraMap F Ω c') * v α ^ i') : i = i' := by
  wlog hle : i' ≤ i generalizing c c' i i'
  · exact (this hc' hc hi' hi h.symm (by omega)).symm
  by_contra hne
  have hα0 := ne_zero_of_pow_eq v hℓ hπ hα
  set γ := v α with hγ
  have hγ0 : γ ≠ 0 := by rwa [hγ, ne_eq, Valuation.zero_iff]
  have hvc : v (algebraMap F Ω c) ≠ 0 := by
    rw [ne_eq, Valuation.zero_iff, map_eq_zero]
    exact hc
  set d := i - i' with hd
  have hd0 : 0 < d := by omega
  have hdlt : d < ℓ ^ k := by omega
  -- `γ ^ d ∈ v(F)`
  have hγd : γ ^ d = v (algebraMap F Ω (c' / c)) := by
    rw [map_div₀, map_div₀, eq_div_iff hvc]
    have hii : i = i' + d := by omega
    have h' : (v (algebraMap F Ω c) * γ ^ d) * γ ^ i' = v (algebraMap F Ω c') * γ ^ i' := by
      rw [← h, hii, pow_add, mul_assoc, mul_comm (γ ^ d)]
    rw [mul_comm]
    exact mul_right_cancel₀ (pow_ne_zero i' hγ0) h'
  have hγk : γ ^ (ℓ ^ k) = v (algebraMap F Ω π) := by rw [hγ, ← map_pow, hα]
  -- the gcd of `d` and `ℓ ^ k` is `ℓ ^ s` with `s < k`
  obtain ⟨s, hsk, hs⟩ := (Nat.dvd_prime_pow hℓ).mp (Nat.gcd_dvd_right d (ℓ ^ k))
  have hslt : s < k := by
    rcases Nat.lt_or_ge s k with h' | h'
    · exact h'
    · exfalso
      have hsk' : s = k := le_antisymm hsk h'
      have : ℓ ^ k ∣ d := by
        rw [← hsk', ← hs]
        exact Nat.gcd_dvd_left d (ℓ ^ k)
      exact absurd (Nat.le_of_dvd hd0 this) (by omega)
  -- Bézout
  set A := Nat.gcdA d (ℓ ^ k)
  set B := Nat.gcdB d (ℓ ^ k)
  set δ : F := (c' / c) ^ A * π ^ B with hδ
  have hvδ : v (algebraMap F Ω δ) = γ ^ (ℓ ^ s) := by
    have hbez : ((ℓ ^ s : ℕ) : ℤ) = (d : ℤ) * A + ((ℓ ^ k : ℕ) : ℤ) * B := by
      rw [← hs]
      exact Nat.gcd_eq_gcd_ab d (ℓ ^ k)
    rw [← zpow_natCast γ (ℓ ^ s), hbez, zpow_add₀ hγ0, zpow_mul, zpow_mul, zpow_natCast,
      zpow_natCast, hγd, hγk, hδ, map_mul, map_mul, map_zpow₀, map_zpow₀, map_zpow₀, map_zpow₀]
  apply hπ (δ ^ (ℓ ^ (k - 1 - s)))
  rw [map_pow, map_pow, hvδ, ← pow_mul, ← pow_mul, ← hγk]
  congr 1
  rw [← pow_succ, ← pow_add]
  congr 1
  omega

variable [Algebra.IsSeparable F Ω]

/-- **The valuation of an element of `F(π^{1/ℓ^k})`** is `v(c) v(α)^j` for some `c ∈ F` and
`j < ℓ ^ k`. -/
theorem exists_valuation_eq_mul_pow {ℓ k : ℕ} (hℓ : ℓ.Prime) {ζ : F}
    (hζ : IsPrimitiveRoot ζ (ℓ ^ k)) {π : F}
    (hπ : ∀ c : F, v (algebraMap F Ω c) ^ ℓ ≠ v (algebraMap F Ω π)) {α : Ω}
    (hα : α ^ (ℓ ^ k) = algebraMap F Ω π) {a : Ω} (ha : a ∈ F⟮α⟯) (ha0 : a ≠ 0) :
    ∃ (c : F) (j : ℕ), c ≠ 0 ∧ v a = v (algebraMap F Ω c) * v α ^ j := by
  classical
  have hπ' : ∀ y : F, y ^ ℓ ≠ π := fun y hy ↦ hπ y (by rw [← map_pow, ← map_pow, hy])
  have hint : IsIntegral F α := Algebra.IsIntegral.isIntegral α
  set pb := adjoin.powerBasis hint with hpb
  have hdim : pb.dim = ℓ ^ k := by
    rw [← pb.finrank]
    exact Stacks.GaloisCohomology.finrank_adjoin_of_pow_eq hℓ hζ hπ' hα
  set a' : F⟮α⟯ := ⟨a, ha⟩
  set c : Fin pb.dim → F := fun i ↦ pb.basis.repr a' i with hc
  set f : Fin pb.dim → Ω := fun i ↦ algebraMap F Ω (c i) * α ^ (i : ℕ) with hf
  have hsum : a = ∑ i, f i := by
    have h1 := congrArg (F⟮α⟯).val (pb.basis.sum_repr a')
    rw [map_sum] at h1
    change (F⟮α⟯).val a' = _
    rw [← h1]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_smul, Algebra.smul_def, PowerBasis.coe_basis, map_pow]
    rfl
  have hne : (Finset.univ : Finset (Fin pb.dim)).Nonempty := by
    rw [Finset.univ_nonempty_iff]
    exact ⟨⟨0, by rw [hdim]; exact pow_pos hℓ.pos k⟩⟩
  obtain ⟨j, -, hj⟩ := Finset.exists_max_image Finset.univ (fun i ↦ v (f i)) hne
  have hfj : f j ≠ 0 := by
    intro hfj0
    apply ha0
    rw [hsum]
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    have := hj i (Finset.mem_univ i)
    rw [hfj0, v.map_zero, le_zero_iff, Valuation.zero_iff] at this
    exact this
  have hcne : ∀ i, f i ≠ 0 → c i ≠ 0 := fun i hi hci ↦ hi (by rw [hf]; simp [hci])
  have hlt : ∀ i ∈ Finset.univ \ {j}, v (f i) < v (f j) := by
    intro i hi
    have hij : i ≠ j := by simpa using hi
    refine lt_of_le_of_ne (hj i (Finset.mem_univ i)) fun heq ↦ hij ?_
    have hfi : f i ≠ 0 := by
      intro h0
      rw [h0, v.map_zero, eq_comm, Valuation.zero_iff] at heq
      exact hfj heq
    have hv : v (algebraMap F Ω (c i)) * v α ^ (i : ℕ) =
        v (algebraMap F Ω (c j)) * v α ^ (j : ℕ) := by
      simpa only [hf, map_mul, map_pow] using heq
    exact Fin.ext (eq_of_valuation_mul_pow_eq v hℓ hπ hα (hcne i hfi) (hcne j hfj)
      (hdim ▸ i.2) (hdim ▸ j.2) hv)
  refine ⟨c j, j, hcne j hfj, ?_⟩
  rw [hsum, v.map_sum_eq_of_lt (Finset.mem_univ j) hlt, hf, map_mul, map_pow]

/-- **An element of `F(π^{1/ℓ^k})` is a unit times an element of `F` times a power of `α`.** -/
theorem exists_eq_unit_mul_mul_pow {ℓ k : ℕ} (hℓ : ℓ.Prime) {ζ : F}
    (hζ : IsPrimitiveRoot ζ (ℓ ^ k)) {π : F}
    (hπ : ∀ c : F, v (algebraMap F Ω c) ^ ℓ ≠ v (algebraMap F Ω π)) {α : Ω}
    (hα : α ^ (ℓ ^ k) = algebraMap F Ω π) {a : Ω} (ha : a ∈ F⟮α⟯) (ha0 : a ≠ 0) :
    ∃ (u : Ω) (c : F) (j : ℕ), u ∈ F⟮α⟯ ∧ v u = 1 ∧ c ≠ 0 ∧
      a = u * algebraMap F Ω c * α ^ j := by
  obtain ⟨c, j, hc0, hv⟩ := exists_valuation_eq_mul_pow v hℓ hζ hπ hα ha ha0
  have hα0 := ne_zero_of_pow_eq v hℓ hπ hα
  have hden : algebraMap F Ω c * α ^ j ≠ 0 :=
    mul_ne_zero ((map_ne_zero _).mpr hc0) (pow_ne_zero _ hα0)
  refine ⟨a / (algebraMap F Ω c * α ^ j), c, j, ?_, ?_, hc0, ?_⟩
  · exact div_mem ha (mul_mem (IntermediateField.algebraMap_mem _ c)
      (pow_mem (mem_adjoin_simple_self F α) j))
  · rw [map_div₀, hv, map_mul, map_pow, div_self]
    rw [← map_pow, ← map_mul, ne_eq, Valuation.zero_iff]
    exact hden
  · rw [mul_assoc, div_mul_cancel₀ a hden]

end Stacks.KummerValuation

end
