module

public import StacksFrontier.RingTheory.Valuation.RationalPowerSeries.CoefficientRing

/-!
# Power series with nonnegative rational exponents: the completion as a ring of series

## Main results

* `RationalPowerSeries.exists_equiv_coefficientFamily`: `coefficientRing κ` is in
  coefficient-preserving bijection with `CoefficientFamily κ`.
* `RationalPowerSeries.exists_ringEquiv_coefficientRing`: the completion is isomorphic as a
  ring to `coefficientRing κ`, compatibly with the coefficients of polynomials.

## Implementation notes

A coefficient family that is finitely supported below every integer bound has partially
well-ordered support, so it defines a Hahn series; conversely a Hahn series over `ℚ≥0` with
that finiteness property is one of the displayed series. This makes `coefficientRing κ` the
concrete model, and the valuation-ring and local properties are proved there: a locally
finite series with nonzero constant term is invertible because the geometric series of
`1 - c⁻¹ f` is again locally finite, and divisibility of two such series is comparable
because each factors as a monomial of its order times a unit.

The completion is matched with that model by reading off, for each exponent `q`, the
coefficient of `q` in any representative at a level above `q`; the coefficient does not
depend on the level because the `n`-th power of `(t)` consists of the polynomials whose
coefficients vanish below `n`.

## References

* [Stacks Project, Tag 0CB8](https://stacks.math.columbia.edu/tag/0CB8)
-/

@[expose] public noncomputable section

namespace RationalPowerSeries

/-! ### Powers of the ideal `(t)` in the monoid algebra -/

/-- The `n`-th power of `(t)` is generated by the monomial of exponent `n`. -/
private theorem polynomialTIdeal_pow_eq_span {k : Type*} [CommRing k] (n : ℕ) :
    (polynomialTIdeal k) ^ n =
      Ideal.span ({AddMonoidAlgebra.single (n : ℚ≥0) (1 : k)} : Set (rationalPolynomial k)) := by
  have ht : polynomialT k ^ n = AddMonoidAlgebra.single (n : ℚ≥0) (1 : k) := by
    induction n with
    | zero => exact AddMonoidAlgebra.one_def
    | succ n ih =>
        rw [pow_succ, ih]
        simp [polynomialT]
  rw [polynomialTIdeal, Ideal.span_singleton_pow, ht]

/-- An element of the `n`-th power of `(t)` has vanishing coefficients below `n`. -/
private theorem polynomial_mem_pow_coeff_eq_zero {k : Type*} [CommRing k]
    (p : rationalPolynomial k) (n : ℕ) (hp : p ∈ (polynomialTIdeal k) ^ n)
    {q : ℚ≥0} (hq : q < n) : p.coeff q = 0 := by
  rw [polynomialTIdeal_pow_eq_span] at hp
  have hp' : p ∈ Ideal.span
      (AddMonoidAlgebra.of' k ℚ≥0 '' ({(n : ℚ≥0)} : Set ℚ≥0)) := by
    simpa only [Set.image_singleton, AddMonoidAlgebra.of'_apply] using hp
  have hfactor :=
    (AddMonoidAlgebra.mem_ideal_span_of'_image (s := {(n : ℚ≥0)}) (x := p)).1 hp'
  by_contra hq0
  have hqmem : q ∈ p.coeff.support := by
    simp only [Finsupp.mem_support_iff]
    exact hq0
  obtain ⟨m, hm, d, hd⟩ := hfactor q hqmem
  simp only [Set.mem_singleton_iff] at hm
  have : (n : ℚ≥0) ≤ q := by
    rw [hd, hm]
    exact le_add_self
  exact (not_lt_of_ge this) hq

/-- The `n`-th power of `(t)` consists exactly of the polynomials whose coefficients vanish
below `n`. -/
theorem polynomial_mem_pow_iff_coeff_eq_zero {k : Type*} [CommRing k]
    (p : rationalPolynomial k) (n : ℕ) :
    p ∈ (polynomialTIdeal k) ^ n ↔ ∀ q : ℚ≥0, q < n → p.coeff q = 0 := by
  constructor
  · intro hp q hq
    exact polynomial_mem_pow_coeff_eq_zero p n hp hq
  · intro hzero
    rw [polynomialTIdeal_pow_eq_span]
    have hp' : p ∈ Ideal.span
        (AddMonoidAlgebra.of' k ℚ≥0 '' ({(n : ℚ≥0)} : Set ℚ≥0)) := by
      apply (AddMonoidAlgebra.mem_ideal_span_of'_image
        (s := {(n : ℚ≥0)}) (x := p)).2
      intro q hq
      have hcoeff : p.coeff q ≠ 0 := Finsupp.mem_support_iff.mp hq
      have hnle : (n : ℚ≥0) ≤ q := by
        by_contra h
        exact hcoeff (hzero q (lt_of_not_ge h))
      refine ⟨(n : ℚ≥0), Set.mem_singleton _, q - n, ?_⟩
      simpa [add_comm] using (tsub_add_cancel_of_le hnle).symm
    simpa only [Set.image_singleton, AddMonoidAlgebra.of'_apply] using hp'

/-- Two polynomials with the same class modulo `(t)^n` have the same coefficients below
`n`. -/
private theorem polynomial_coeff_eq_of_quotient_eq {k : Type*} [CommRing k]
    (p r : rationalPolynomial k) (n : ℕ) {q : ℚ≥0} (hq : q < n)
    (h : Submodule.Quotient.mk
      (p := (polynomialTIdeal k) ^ n •
        (⊤ : Submodule (rationalPolynomial k) (rationalPolynomial k))) p =
      Submodule.Quotient.mk
      (p := (polynomialTIdeal k) ^ n •
        (⊤ : Submodule (rationalPolynomial k) (rationalPolynomial k))) r) :
    p.coeff q = r.coeff q := by
  have hmemSub : p - r ∈ (polynomialTIdeal k) ^ n •
      (⊤ : Submodule (rationalPolynomial k) (rationalPolynomial k)) :=
    (Submodule.Quotient.eq _).1 h
  have hmem : p - r ∈ (polynomialTIdeal k) ^ n := by
    simpa [Ideal.smul_top_eq_map] using hmemSub
  have hzero := (polynomial_mem_pow_iff_coeff_eq_zero (p - r) n).mp hmem q hq
  change p.coeff q - r.coeff q = 0 at hzero
  exact sub_eq_zero.mp hzero

/-- Two polynomials with the same coefficients below `n` have the same class modulo `(t)^n`. -/
private theorem quotient_mk_eq_of_coeff_eq {k : Type*} [CommRing k]
    (p r : rationalPolynomial k) (n : ℕ) (h : ∀ q : ℚ≥0, q < n → p.coeff q = r.coeff q) :
    Submodule.Quotient.mk
      (p := (polynomialTIdeal k) ^ n •
        (⊤ : Submodule (rationalPolynomial k) (rationalPolynomial k))) p =
      Submodule.Quotient.mk r := by
  refine (Submodule.Quotient.eq _).2 ?_
  have hmem : p - r ∈ (polynomialTIdeal k) ^ n :=
    (polynomial_mem_pow_iff_coeff_eq_zero _ _).2 fun q hq => sub_eq_zero.2 (h q hq)
  simpa [Ideal.smul_top_eq_map] using hmem

/-- A representative of an element of the completion at level `n` has the coefficients below
`n` of any polynomial representing that level. -/
private theorem out_coeff_eq_of_val_eq {k : Type*} [CommRing k]
    (x : rationalPowerSeries k) (n : ℕ) (r : rationalPolynomial k)
    (h : x.val n = Submodule.Quotient.mk r) {q : ℚ≥0} (hq : q < n) :
    (Quotient.out (x.val n)).coeff q = r.coeff q :=
  polynomial_coeff_eq_of_quotient_eq _ _ n hq ((Quotient.out_eq (x.val n)).trans h)

/-- Every rational is below the successor of its ceiling, as a natural number. -/
private theorem lt_natCast_ceil_add_one (q : ℚ≥0) : q < ((Nat.ceil q + 1 : ℕ) : ℚ≥0) :=
  lt_of_le_of_lt (Nat.le_ceil q) (by exact_mod_cast Nat.lt_succ_self (Nat.ceil q))

/-! ### The completion as a ring of coefficient families -/

/-- The truncation of a coefficient family below `n`, as an element of the monoid algebra. -/
private def coefficientTruncation {k : Type*} [CommRing k]
    (f : CoefficientFamily k) (n : ℕ) : rationalPolynomial k := by
  classical
  exact AddMonoidAlgebra.ofCoeff <| Finsupp.onFinset (f.2 n).toFinset
    (fun q => if q < n then f.1 q else 0) (by
      intro q hq
      by_cases hqn : q < n
      · apply (f.2 n).mem_toFinset.mpr
        exact ⟨hqn.le, by simpa [hqn] using hq⟩
      · simp [hqn] at hq)

/-- The coefficients of a truncation are those of the family below `n` and zero above. -/
private theorem coefficient_coefficientTruncation {k : Type*} [CommRing k]
    (f : CoefficientFamily k) (n : ℕ) (q : ℚ≥0) :
    (coefficientTruncation f n).coeff q = if q < n then f.1 q else 0 := by
  classical
  simp [coefficientTruncation, AddMonoidAlgebra.coeff_ofCoeff, Finsupp.onFinset_apply]

/-- The element of the completion determined by a coefficient family, namely the adic Cauchy
sequence of its truncations. -/
private def coefficientFamilyToCompletion {k : Type*} [CommRing k]
    (f : CoefficientFamily k) : rationalPowerSeries k := by
  let a := AdicCompletion.AdicCauchySequence.mk (polynomialTIdeal k) (rationalPolynomial k)
    (coefficientTruncation f) (by
      intro n
      refine quotient_mk_eq_of_coeff_eq _ _ n fun q hq => ?_
      rw [coefficient_coefficientTruncation, coefficient_coefficientTruncation]
      have hq' : q < (n : ℚ≥0) + 1 := hq.trans (lt_add_one _)
      simp [hq, hq'])
  exact AdicCompletion.mk (polynomialTIdeal k) (rationalPolynomial k) a

/-- The coefficient of an exponent below `m` in a representative of an element of the
completion does not change when passing to a higher level. -/
private theorem completion_representative_coeff_stable {k : Type*} [CommRing k]
    (x : rationalPowerSeries k) {m n : ℕ} (hmn : m ≤ n) {q : ℚ≥0} (hq : q < m) :
    (Quotient.out (x.val m)).coeff q = (Quotient.out (x.val n)).coeff q := by
  set p : rationalPolynomial k := Quotient.out (x.val n)
  have hp : x.val n = Submodule.Quotient.mk p := (Quotient.out_eq _).symm
  refine out_coeff_eq_of_val_eq x m p ?_ hq
  rw [← x.property hmn, hp]
  simp

/-- The coefficient of exponent `q` of an element of the completion, read off from a
representative at any level above `q`. -/
private def completionCoefficient {k : Type*} [CommRing k]
    (x : rationalPowerSeries k) (q : ℚ≥0) : k :=
  (Quotient.out (x.val (Nat.ceil q + 1))).coeff q

/-- The coefficients of an element of the completion are finitely supported below every
integer bound. -/
private theorem completionCoefficient_locallyFinite {k : Type*} [CommRing k]
    (x : rationalPowerSeries k) (n : ℕ) :
    {q : ℚ≥0 | q ≤ n ∧ completionCoefficient x q ≠ 0}.Finite := by
  classical
  let p : rationalPolynomial k := Quotient.out (x.val (n + 1))
  have hsubset : {q : ℚ≥0 | q ≤ n ∧ completionCoefficient x q ≠ 0} ⊆ p.coeff.support := by
    intro q hq
    have hceil : Nat.ceil q ≤ n := (Nat.ceil_le).2 hq.1
    have hlevel : Nat.ceil q + 1 ≤ n + 1 := Nat.add_le_add_right hceil 1
    have heq : completionCoefficient x q = p.coeff q :=
      completion_representative_coeff_stable x hlevel (lt_natCast_ceil_add_one q)
    exact Finsupp.mem_support_iff.mpr (heq ▸ hq.2)
  exact p.coeff.support.finite_toSet.subset hsubset

/-- Every representative at a sufficiently high level computes the coefficients of all
exponents below the corresponding bound. -/
private theorem completionRepresentative_coeff_eq_completionCoefficient {k : Type*}
    [CommRing k] (x : rationalPowerSeries k) (q : ℚ≥0) {n : ℕ}
    (hn : Nat.ceil q + 1 ≤ n) {a : ℚ≥0} (ha : a ≤ q) :
    (Quotient.out (x.val n)).coeff a = completionCoefficient x a := by
  have hceil : Nat.ceil a ≤ Nat.ceil q := (Nat.ceil_le).2 (ha.trans (Nat.le_ceil q))
  have hlevel : Nat.ceil a + 1 ≤ n := (Nat.add_le_add_right hceil 1).trans hn
  show (Quotient.out (x.val n)).coeff a =
    (Quotient.out (x.val (Nat.ceil a + 1))).coeff a
  exact (completion_representative_coeff_stable x hlevel (lt_natCast_ceil_add_one a)).symm

/-- The coefficient family of an element of the completion. -/
private def completionToCoefficientFamily {k : Type*} [CommRing k]
    (x : rationalPowerSeries k) : CoefficientFamily k :=
  ⟨completionCoefficient x, completionCoefficient_locallyFinite x⟩

/-- Reading off the coefficients of the element of the completion built from a coefficient
family returns that family. -/
private theorem coefficientFamilyToCompletion_left_inverse {k : Type*} [CommRing k]
    (f : CoefficientFamily k) : completionToCoefficientFamily
      (coefficientFamilyToCompletion f) = f := by
  apply Subtype.ext
  funext q
  show completionCoefficient (coefficientFamilyToCompletion f) q = f.1 q
  have hqLt : q < (Nat.ceil q : ℚ≥0) + 1 :=
    lt_of_le_of_lt (Nat.le_ceil q)
      (lt_add_of_pos_right _ (show (0 : ℚ≥0) < 1 by positivity))
  unfold completionCoefficient
  rw [out_coeff_eq_of_val_eq _ _ (coefficientTruncation f (Nat.ceil q + 1)) _
    (lt_natCast_ceil_add_one q), coefficient_coefficientTruncation]
  · simp [hqLt]
  · rfl

/-- An element of the completion is recovered from its coefficient family. -/
private theorem coefficientFamilyToCompletion_right_inverse {k : Type*} [CommRing k]
    (x : rationalPowerSeries k) : coefficientFamilyToCompletion
      (completionToCoefficientFamily x) = x := by
  apply AdicCompletion.ext
  intro n
  let f := completionToCoefficientFamily x
  let p : rationalPolynomial k := Quotient.out (x.val n)
  have hcoeff : ∀ q : ℚ≥0, q < n → p.coeff q =
      (coefficientTruncation f n).coeff q := by
    intro q hq
    have hlevel : Nat.ceil q + 1 ≤ n + 1 := Nat.add_le_add_right ((Nat.ceil_le).2 hq.le) 1
    have hfirst : f.1 q = p.coeff q :=
      (completion_representative_coeff_stable x hlevel (lt_natCast_ceil_add_one q)).trans
        (completion_representative_coeff_stable x (Nat.le_succ n) hq).symm
    rw [coefficient_coefficientTruncation]
    simp [f, hfirst, hq]
  calc
    (coefficientFamilyToCompletion f).val n =
        Submodule.Quotient.mk (coefficientTruncation f n) := by
      rfl
    _ = Submodule.Quotient.mk p := (quotient_mk_eq_of_coeff_eq p _ n hcoeff).symm
    _ = x.val n := Quotient.out_eq (x.val n)

/-- Coefficient families are in bijection with the elements of the completion. -/
private def coefficientFamilyCompletionEquiv {k : Type*} [CommRing k] :
    CoefficientFamily k ≃ rationalPowerSeries k where
  toFun := coefficientFamilyToCompletion
  invFun := completionToCoefficientFamily
  left_inv := coefficientFamilyToCompletion_left_inverse
  right_inv := coefficientFamilyToCompletion_right_inverse

/-- Convolution of polynomials agrees with multiplication of Hahn series on any coefficient
whose computation only involves exponents where the two agree. -/
private theorem polynomial_mul_coeff_eq_hahn_mul_coeff {k : Type*} [Field k]
    (p r : rationalPolynomial k) (f g : HahnSeries ℚ≥0 k)
    (q : ℚ≥0)
    (hp : ∀ a : ℚ≥0, a ≤ q → p.coeff a = f.coeff a)
    (hr : ∀ a : ℚ≥0, a ≤ q → r.coeff a = g.coeff a) :
    (p * r).coeff q = (f * g).coeff q := by
  classical
  let s := (p.coeff.support ×ˢ r.coeff.support).filter (fun z => z.1 + z.2 = q)
  have hs : s = Finset.antidiagonal f.isPWO_support g.isPWO_support q := by
    ext z
    constructor
    · intro hz
      rcases Finset.mem_filter.mp hz with ⟨hzprod, hsum⟩
      rcases Finset.mem_product.mp hzprod with ⟨hpa, hpb⟩
      have haz : z.1 ≤ q := le_self_add.trans_eq hsum
      have hbz : z.2 ≤ q := le_add_self.trans_eq hsum
      refine Finset.mem_antidiagonal.mpr ⟨?_, ?_, hsum⟩
      · show f.coeff z.1 ≠ 0
        rw [← hp z.1 haz]
        exact Finsupp.mem_support_iff.mp hpa
      · show g.coeff z.2 ≠ 0
        rw [← hr z.2 hbz]
        exact Finsupp.mem_support_iff.mp hpb
    · intro hz
      rcases Finset.mem_antidiagonal.mp hz with ⟨hfa, hgb, hsum⟩
      have haz : z.1 ≤ q := le_self_add.trans_eq hsum
      have hbz : z.2 ≤ q := le_add_self.trans_eq hsum
      refine Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨?_, ?_⟩, hsum⟩
      · apply Finsupp.mem_support_iff.mpr
        rw [hp z.1 haz]
        exact hfa
      · apply Finsupp.mem_support_iff.mpr
        rw [hr z.2 hbz]
        exact hgb
  calc
    (p * r).coeff q =
        ∑ a ∈ p.coeff.support, ∑ b ∈ r.coeff.support,
          if a + b = q then p.coeff a * r.coeff b else 0 := by
      rw [AddMonoidAlgebra.coeff_mul]
      simp only [Finsupp.sum]
    _ = ∑ z ∈ s, p.coeff z.1 * r.coeff z.2 := by
      simp only [s]
      rw [Finset.sum_filter, Finset.sum_product]
    _ = ∑ z ∈ Finset.antidiagonal f.isPWO_support g.isPWO_support q,
          f.coeff z.1 * g.coeff z.2 := by
      rw [hs]
      apply Finset.sum_congr rfl
      intro z hz
      have hsum := (Finset.mem_antidiagonal.mp hz).2.2
      rw [hp z.1 (le_self_add.trans_eq hsum), hr z.2 (le_add_self.trans_eq hsum)]
    _ = (f * g).coeff q := (HahnSeries.coeff_mul).symm

/-- Coefficients of a product in the completion are the convolution of the coefficients. -/
private theorem completionCoefficient_mul {k : Type*} [Field k]
    (x y : rationalPowerSeries k) (q : ℚ≥0) :
    completionCoefficient (x * y) q =
      ((coefficientFamilyToHahn (completionToCoefficientFamily x)) *
        (coefficientFamilyToHahn (completionToCoefficientFamily y))).coeff q := by
  let n := Nat.ceil q + 1
  let r : rationalPolynomial k := Quotient.out (x.val n)
  let s : rationalPolynomial k := Quotient.out (y.val n)
  have hr : ∀ a : ℚ≥0, a ≤ q → r.coeff a = (coefficientFamilyToHahn
      (completionToCoefficientFamily x)).coeff a :=
    fun a ha => completionRepresentative_coeff_eq_completionCoefficient x q (Nat.le_refl n) ha
  have hs : ∀ a : ℚ≥0, a ≤ q → s.coeff a = (coefficientFamilyToHahn
      (completionToCoefficientFamily y)).coeff a :=
    fun a ha => completionRepresentative_coeff_eq_completionCoefficient y q (Nat.le_refl n) ha
  refine (out_coeff_eq_of_val_eq _ n (r * s) ?_ (lt_natCast_ceil_add_one q)).trans
    (polynomial_mul_coeff_eq_hahn_mul_coeff r s _ _ q hr hs)
  rw [AdicCompletion.val_mul, ← Quotient.out_eq (x.val n), ← Quotient.out_eq (y.val n)]
  simp [r, s]

/-- The coefficients of the image of a polynomial in the completion are its own
coefficients. -/
private theorem completionCoefficient_of {k : Type*} [CommRing k]
    (p : rationalPolynomial k) (q : ℚ≥0) :
    completionCoefficient
      (AdicCompletion.of (polynomialTIdeal k) (rationalPolynomial k) p) q = p.coeff q := by
  refine (out_coeff_eq_of_val_eq _ _ p ?_ (lt_natCast_ceil_add_one q))
  simp [AdicCompletion.of_apply]

/-- All coefficients of zero vanish. -/
private theorem completionCoefficient_zero {k : Type*} [CommRing k] (q : ℚ≥0) :
    completionCoefficient (0 : rationalPowerSeries k) q = 0 := by
  simpa using completionCoefficient_of (k := k) (0 : rationalPolynomial k) q

/-- The coefficients of one are those of the constant polynomial one. -/
private theorem completionCoefficient_one {k : Type*} [CommRing k] (q : ℚ≥0) :
    completionCoefficient (1 : rationalPowerSeries k) q =
      (1 : rationalPolynomial k).coeff q := by
  have h : AdicCompletion.of (polynomialTIdeal k) (rationalPolynomial k) 1 =
      (1 : rationalPowerSeries k) := by
    ext n
    simp [AdicCompletion.of_apply, AdicCompletion.val_one]
  simpa [h] using completionCoefficient_of (k := k) (1 : rationalPolynomial k) q

/-- Coefficients of a sum in the completion are the sums of the coefficients. -/
private theorem completionCoefficient_add {k : Type*} [CommRing k]
    (x y : rationalPowerSeries k) (q : ℚ≥0) :
    completionCoefficient (x + y) q =
      completionCoefficient x q + completionCoefficient y q := by
  let n := Nat.ceil q + 1
  have hr := completionRepresentative_coeff_eq_completionCoefficient x q (Nat.le_refl n)
    (a := q) le_rfl
  have hs := completionRepresentative_coeff_eq_completionCoefficient y q (Nat.le_refl n)
    (a := q) le_rfl
  refine (out_coeff_eq_of_val_eq _ n (Quotient.out (x.val n) + Quotient.out (y.val n)) ?_
    (lt_natCast_ceil_add_one q)).trans ?_
  · rw [← Quotient.out_eq (x.val n), ← Quotient.out_eq (y.val n)]
    simp [AdicCompletion.val_add]
  · simp [AddMonoidAlgebra.coeff_add, hr, hs]

/-! ### Units, localness and the valuation property of the coefficient ring -/

/-- A locally finite series with nonzero constant term has a locally finite inverse, given by
the geometric series of `1 - c⁻¹ f`. -/
private theorem coefficientRing_exists_inverse {k : Type*} [Field k]
    (f : HahnSeries ℚ≥0 k)
    (hf : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite)
    (h0 : f.coeff 0 ≠ 0) :
    ∃ g : HahnSeries ℚ≥0 k,
      (∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ g.coeff q ≠ 0}.Finite) ∧ f * g = 1 := by
  have h0mem : (0 : ℚ≥0) ∈ f.support := (HahnSeries.mem_support _ _).mpr h0
  have horderTop : f.orderTop = 0 :=
    HahnSeries.orderTop_eq_of_le h0mem (fun q _ => bot_le)
  have hfne : f ≠ 0 := by
    rintro rfl
    simp at h0
  have horder : f.order = 0 := by
    have heq := HahnSeries.order_eq_orderTop_of_ne_zero hfne
    exact WithTop.coe_inj.mp (heq.trans horderTop)
  have hlead : f.leadingCoeff ≠ 0 := by
    rw [HahnSeries.leadingCoeff_eq, horder]
    exact h0
  let r : k := f.leadingCoeff⁻¹
  let z : HahnSeries ℚ≥0 k := 1 - HahnSeries.single 0 r * f
  have hr : r * f.leadingCoeff = 1 := inv_mul_cancel₀ hlead
  have hpos : 0 < z.orderTop := by
    simpa [z, horder] using HahnSeries.unit_aux f hr 0 (by simp [horder])
  have hsingle : ∀ n : ℕ,
      {q : ℚ≥0 | q ≤ n ∧ (HahnSeries.single 0 r).coeff q ≠ 0}.Finite :=
    (mem_coefficientRing_iff k _).1 (single_mem_coefficientRing 0 r)
  have hz : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ z.coeff q ≠ 0}.Finite := by
    intro n
    have hprod := supportBelow_mul (HahnSeries.single 0 r) f n (hsingle n) (hf n)
    have hone : {q : ℚ≥0 | q ≤ n ∧ (1 : HahnSeries ℚ≥0 k).coeff q ≠ 0}.Finite :=
      (mem_coefficientRing_iff k _).1 (Subring.one_mem (coefficientRing k)) n
    have hneg : {q : ℚ≥0 | q ≤ n ∧ (-(HahnSeries.single 0 r * f)).coeff q ≠ 0}.Finite := by
      simpa using hprod
    simpa [z, sub_eq_add_neg] using supportBelow_add (1 : HahnSeries ℚ≥0 k)
      (-(HahnSeries.single 0 r * f)) n hone hneg
  let g : HahnSeries ℚ≥0 k := HahnSeries.single 0 r *
    (HahnSeries.SummableFamily.powers z).hsum
  have hg : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ g.coeff q ≠ 0}.Finite := fun n =>
    supportBelow_mul (HahnSeries.single 0 r) (HahnSeries.SummableFamily.powers z).hsum n
      (hsingle n) (supportBelow_geometricSeries z hz hpos n)
  have hmul : (HahnSeries.single 0 r * f) *
      (HahnSeries.SummableFamily.powers z).hsum = 1 := by
    simpa [z, sub_sub_cancel] using
      HahnSeries.SummableFamily.one_sub_self_mul_hsum_powers hpos
  refine ⟨g, hg, ?_⟩
  dsimp [g]
  calc
    f * (HahnSeries.single 0 r * (HahnSeries.SummableFamily.powers z).hsum) =
        (HahnSeries.single 0 r * f) * (HahnSeries.SummableFamily.powers z).hsum := by ring
    _ = 1 := hmul

/-- An element of the coefficient ring with nonzero constant term is a unit. -/
private theorem coefficientRing_isUnit_of_coeff_zero_ne {k : Type*} [Field k]
    (f : coefficientRing k) (h0 : f.1.coeff 0 ≠ 0) : IsUnit f := by
  obtain ⟨g, hg, hmul⟩ := coefficientRing_exists_inverse f.1
    ((mem_coefficientRing_iff k f.1).mp f.2) h0
  exact (isUnit_iff_exists_inv).2
    ⟨⟨g, (mem_coefficientRing_iff k g).2 hg⟩, Subtype.ext hmul⟩

/-- The coefficient ring is local: either an element or its complement to one has nonzero
constant term. -/
theorem coefficientRing_isLocalRing (k : Type*) [Field k] :
    IsLocalRing (coefficientRing k) := by
  apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
  intro f
  by_cases h0 : f.1.coeff 0 = 0
  · right
    apply coefficientRing_isUnit_of_coeff_zero_ne
    simp [h0]
  · left
    exact coefficientRing_isUnit_of_coeff_zero_ne f h0

/-- A product with a factor of vanishing constant term has vanishing constant term. -/
private theorem coeff_zero_mul_eq_zero {k : Type*} [Field k]
    (f g : HahnSeries ℚ≥0 k) (h0 : f.coeff 0 = 0) :
    (f * g).coeff 0 = 0 := by
  rw [HahnSeries.coeff_mul]
  apply Finset.sum_eq_zero
  intro p hp
  have hp0 := Finset.mem_antidiagonal.mp hp
  have hpair : p.1 = 0 ∧ p.2 = 0 :=
    (add_eq_zero_iff_of_nonneg bot_le bot_le).mp hp0.2.2
  simp [hpair.1, h0]

/-- A non-unit of the coefficient ring has vanishing constant term. -/
theorem coefficientRing_notUnit_coeff_zero {k : Type*} [Field k]
    (f : coefficientRing k) (hf : ¬ IsUnit f) : f.1.coeff 0 = 0 := by
  by_contra h0
  exact hf (coefficientRing_isUnit_of_coeff_zero_ne f h0)

/-- Divisibility in the coefficient ring is total: each nonzero element is its leading
monomial times a unit, so the one of smaller order divides the other. -/
theorem coefficientRing_preValuationRing (k : Type*) [Field k] :
    PreValuationRing (coefficientRing k) := by
  refine ⟨?_⟩
  intro f g
  by_cases hf0 : f.1 = 0
  · obtain rfl : f = 0 := Subtype.ext hf0
    exact ⟨0, Or.inr (by simp)⟩
  by_cases hg0 : g.1 = 0
  · obtain rfl : g = 0 := Subtype.ext hg0
    exact ⟨0, Or.inl (by simp)⟩
  have hdiv (f g : coefficientRing k) (hf0 : f.1 ≠ 0)
      (hab : f.1.order ≤ g.1.order) : ∃ c : coefficientRing k, f * c = g := by
    let a := f.1.order
    let b := g.1.order
    let u := shiftDownHahn f.1 ((mem_coefficientRing_iff k f.1).mp f.2) a
    let v := shiftDownHahn g.1 ((mem_coefficientRing_iff k g.1).mp g.2) b
    have hfu : HahnSeries.single a (1 : k) * u = f.1 := by
      apply single_mul_shiftDown_eq
      intro q hq
      exact HahnSeries.coeff_eq_zero_of_lt_order (by simpa [a] using hq)
    have hgv : HahnSeries.single b (1 : k) * v = g.1 := by
      apply single_mul_shiftDown_eq
      intro q hq
      exact HahnSeries.coeff_eq_zero_of_lt_order (by simpa [b] using hq)
    have hu0 : u.coeff 0 = f.1.leadingCoeff := by
      simp [u, shiftDownHahn_coeff, a, HahnSeries.leadingCoeff_eq]
    have huLF : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ u.coeff q ≠ 0}.Finite := by
      simpa [u, shiftDownHahn, coefficientFamilyToHahn] using
        (shiftDownFamily ⟨f.1.coeff, (mem_coefficientRing_iff k f.1).mp f.2⟩ a).2
    obtain ⟨ui, hui, huiu⟩ := coefficientRing_exists_inverse u
      huLF
      (by rw [hu0]; exact HahnSeries.leadingCoeff_ne_zero.mpr hf0)
    have hvMem : v ∈ coefficientRing k :=
      (mem_coefficientRing_iff k v).2 (by simpa [v, shiftDownHahn, coefficientFamilyToHahn] using
        (shiftDownFamily ⟨g.1.coeff, (mem_coefficientRing_iff k g.1).mp g.2⟩ b).2)
    have hmonoEq : HahnSeries.single a (1 : k) * HahnSeries.single (b - a) (1 : k) =
        HahnSeries.single b (1 : k) := by
      rw [HahnSeries.single_mul_single]
      have heq : a + (b - a) = b := add_tsub_cancel_of_le hab
      simp [heq]
    let c : coefficientRing k :=
      ⟨ui * (HahnSeries.single (b - a) (1 : k) * v),
        Subring.mul_mem _ ((mem_coefficientRing_iff k ui).2 hui)
          (Subring.mul_mem _ (single_mem_coefficientRing _ _) hvMem)⟩
    refine ⟨c, ?_⟩
    apply Subtype.ext
    dsimp [c]
    calc
      f.1 * (ui * (HahnSeries.single (b - a) (1 : k) * v)) =
          (HahnSeries.single a (1 : k) * u) *
            (ui * (HahnSeries.single (b - a) (1 : k) * v)) := by rw [hfu]
      _ = HahnSeries.single a (1 : k) *
            (HahnSeries.single (b - a) (1 : k) * v) := by
          rw [mul_assoc, ← mul_assoc u ui, huiu, one_mul]
      _ = (HahnSeries.single a (1 : k) *
            HahnSeries.single (b - a) (1 : k)) * v := by ac_rfl
      _ = HahnSeries.single b (1 : k) * v := by rw [hmonoEq]
      _ = g.1 := hgv
  rcases le_total f.1.order g.1.order with hab | hba
  · obtain ⟨c, hc⟩ := hdiv f g hf0 hab
    exact ⟨c, Or.inl hc⟩
  · obtain ⟨c, hc⟩ := hdiv g f hg0 hba
    exact ⟨c, Or.inr hc⟩

/-- **Stacks 0CB8.** Every coefficient family `(a_α)` is represented by a unique element of
the coefficient ring, with unchanged coefficients. -/
@[stacks 0CB8 "the rational power series valuation ring"]
theorem exists_equiv_coefficientFamily (k : Type*) [Field k] :
    ∃ e : CoefficientFamily k ≃ coefficientRing k,
      ∀ f : CoefficientFamily k, ∀ q : ℚ≥0, ((e f).1).coeff q = f.1 q := by
  let e : CoefficientFamily k ≃ coefficientRing k :=
    { toFun := fun f =>
        ⟨coefficientFamilyToHahn f, (mem_coefficientRing_iff k _).2 f.2⟩
      invFun := fun g => ⟨g.1.coeff, (mem_coefficientRing_iff k _).1 g.2⟩
      left_inv := by
        intro f
        apply Subtype.ext
        rfl
      right_inv := by
        intro g
        apply Subtype.ext
        simp [coefficientFamilyToHahn] }
  refine ⟨e, ?_⟩
  intro f q
  rfl

/-- The Hahn series attached to an element of the completion. -/
private def completionToHahn (k : Type*) [Field k] (x : rationalPowerSeries k) :
    HahnSeries ℚ≥0 k := coefficientFamilyToHahn (completionToCoefficientFamily x)

/-- Reading off coefficients is a ring homomorphism from the completion to the coefficient
ring. -/
private def completionToCoefficientRingHom (k : Type*) [Field k] :
    rationalPowerSeries k →+* coefficientRing k where
  toFun x := ⟨completionToHahn k x, (mem_coefficientRing_iff k _).2
    (completionToCoefficientFamily x).2⟩
  map_one' := by
    apply Subtype.ext
    ext q
    change completionCoefficient (1 : rationalPowerSeries k) q =
      (1 : HahnSeries ℚ≥0 k).coeff q
    simp [completionCoefficient_one, AddMonoidAlgebra.one_def, Finsupp.single_apply, eq_comm]
  map_mul' x y := by
    apply Subtype.ext
    ext q
    change completionCoefficient (x * y) q = _
    exact completionCoefficient_mul x y q
  map_zero' := by
    apply Subtype.ext
    ext q
    change completionCoefficient (0 : rationalPowerSeries k) q = 0
    exact completionCoefficient_zero q
  map_add' x y := by
    apply Subtype.ext
    ext q
    change completionCoefficient (x + y) q = _
    exact completionCoefficient_add x y q

/-- **Stacks 0CB8.** The completed monoid algebra is the ring of locally finite coefficient
series, with the usual addition and convolution multiplication; the isomorphism preserves the
coefficients of polynomials. -/
@[stacks 0CB8 "the rational power series valuation ring"]
theorem exists_ringEquiv_coefficientRing (k : Type*) [Field k] :
    ∃ e : rationalPowerSeries k ≃+* coefficientRing k,
      ∀ (p : rationalPolynomial k) (q : ℚ≥0),
        ((e (AdicCompletion.of (polynomialTIdeal k) (rationalPolynomial k) p)).1).coeff q =
          p.coeff q := by
  obtain ⟨eCF, heCF⟩ := exists_equiv_coefficientFamily k
  let f := completionToCoefficientRingHom k
  have hinj : Function.Injective f := by
    intro x y hxy
    have hseries : completionToHahn k x = completionToHahn k y :=
      congrArg Subtype.val hxy
    have hfamily : completionToCoefficientFamily x = completionToCoefficientFamily y := by
      apply Subtype.ext
      funext q
      exact congrArg (fun z : HahnSeries ℚ≥0 k => z.coeff q) hseries
    exact (coefficientFamilyCompletionEquiv (k := k)).symm.injective hfamily
  have hsurj : Function.Surjective f := by
    intro y
    let c := eCF.symm y
    let x := coefficientFamilyCompletionEquiv c
    refine ⟨x, ?_⟩
    apply Subtype.ext
    ext q
    show (completionToCoefficientFamily x).1 q = y.1.coeff q
    have hx : completionToCoefficientFamily x = c := by
      show completionToCoefficientFamily (coefficientFamilyToCompletion c) = c
      exact coefficientFamilyToCompletion_left_inverse c
    rw [hx]
    calc
      c.1 q = (eCF c).1.coeff q := (heCF c q).symm
      _ = y.1.coeff q := by simp [c]
  refine ⟨RingEquiv.ofBijective f ⟨hinj, hsurj⟩, ?_⟩
  intro p q
  show completionCoefficient
    (AdicCompletion.of (polynomialTIdeal k) (rationalPolynomial k) p) q = p.coeff q
  exact completionCoefficient_of p q

/-- Under any coefficient-preserving isomorphism with the coefficient ring, `t` corresponds
to the monomial of exponent one. -/
theorem coefficientRing_equiv_t {k : Type*} [Field k]
    (e : rationalPowerSeries k ≃+* coefficientRing k)
    (he : ∀ (p : rationalPolynomial k) (q : ℚ≥0),
      ((e (AdicCompletion.of (polynomialTIdeal k) (rationalPolynomial k) p)).1).coeff q =
        p.coeff q) :
    e (t k) = ⟨HahnSeries.single 1 (1 : k), single_mem_coefficientRing _ _⟩ := by
  classical
  apply Subtype.ext
  ext q
  have h := he (polynomialT k) q
  rw [t, h]
  simp [polynomialT, HahnSeries.coeff_single, Finsupp.single_apply, eq_comm]

/-- The ideal of elements of the coefficient ring whose coefficients vanish up to `q`. -/
def coefficientVanishingIdeal {k : Type*} [Field k] (q : ℚ≥0) :
    Ideal (coefficientRing k) where
  carrier := {f | ∀ r : ℚ≥0, r ≤ q → f.1.coeff r = 0}
  zero_mem' := by simp
  add_mem' := by
    intro f g hf hg r hr
    change (f.1 + g.1).coeff r = 0
    rw [HahnSeries.coeff_add']
    simp [hf r hr, hg r hr]
  smul_mem' := by
    intro a f hf r hr
    change (a.1 * f.1).coeff r = 0
    rw [HahnSeries.coeff_mul]
    apply Finset.sum_eq_zero
    intro p hp
    have hp0 := Finset.mem_antidiagonal.mp hp
    have hp2 : p.2 ≤ r := by
      rw [← hp0.2.2]
      exact le_add_self
    simp [hf p.2 (hp2.trans hr)]

/-- An element of the coefficient ring with vanishing constant term is not a unit. -/
theorem coefficientRing_zero_const_notUnit {k : Type*} [Field k]
    (f : coefficientRing k) (h0 : f.1.coeff 0 = 0) : ¬ IsUnit f := by
  intro hu
  obtain ⟨g, hfg⟩ := (isUnit_iff_exists_inv.mp hu)
  have hcoeff := congrArg (fun z : HahnSeries ℚ≥0 k => z.coeff 0)
    (congrArg Subtype.val hfg)
  change (f.1 * g.1).coeff 0 = (1 : HahnSeries ℚ≥0 k).coeff 0 at hcoeff
  rw [coeff_zero_mul_eq_zero _ _ h0] at hcoeff
  have hone : (1 : HahnSeries ℚ≥0 k).coeff 0 = 1 := by simp
  rw [hone] at hcoeff
  exact zero_ne_one hcoeff

end RationalPowerSeries

