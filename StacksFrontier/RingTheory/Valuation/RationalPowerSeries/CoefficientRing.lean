/-!
# Power series with nonnegative rational exponents: the construction and the coefficient ring

For a field `κ`, the ring
`A = { ∑_{α ∈ ℚ, α ≥ 0} a_α t^α | a_α ∈ κ and for every n only finitely many nonzero a_α
have α ≤ n }`
is a valuation ring: it is a local domain, it is `(t)`-adically complete, the radical of `(t)`
is its maximal ideal, and `t` is a nonzero element of that maximal ideal, yet the maximal
ideal is not finitely generated (it contains `t^q` for every positive rational `q`). It is
therefore an example of a valuation ring `(A, 𝔪, κ)` that is `(π)`-adically complete for a
nonzero `π ∈ 𝔪` whose maximal ideal is not finitely generated.

The ring is built here as the `(t)`-adic completion of the monoid algebra `κ[t^(ℚ≥0)]`, which
makes completeness immediate, and it is then identified with the displayed ring of
locally finite families of coefficients, realised inside the Hahn series ring
`HahnSeries ℚ≥0 κ`.

## Main definitions

* `rationalPolynomial κ`: the monoid algebra `κ[t^(ℚ≥0)]` of finite sums with nonnegative
  rational exponents.
* `polynomialT κ`, `polynomialTIdeal κ`: the monomial `t` of exponent one and the ideal it
  generates in `rationalPolynomial κ`.
* `rationalPowerSeries κ`: the ring `A` above, as the `(t)`-adic completion of
  `rationalPolynomial κ`, topologised by the `(t)`-adic topology.
* `RationalPowerSeries.t`, `RationalPowerSeries.tIdeal`: the image of the exponent-one
  monomial in the completion and the ideal it generates.
* `CoefficientFamily κ`: families `ℚ≥0 → κ` with finitely many nonzero values below each
  integer bound, i.e. the coefficient families `(a_α)` displayed above.
* `coefficientRing κ`: the subring of `HahnSeries ℚ≥0 κ` generated by the series whose
  support is finite below each integer bound.

## Main results

* `RationalPowerSeries.mem_coefficientRing_iff`: the generating set of `coefficientRing κ`
  is already a subring, so membership is exactly local finiteness of the support.

## References

* [Stacks Project, Tag 0CB8](https://stacks.math.columbia.edu/tag/0CB8)
-/

@[expose] public noncomputable section

/-- **Stacks 0CB8.** Finite sums `∑ a_α t^α` with `α` ranging over nonnegative rationals,
realised as the monoid algebra of `ℚ≥0` over `k`. -/
@[stacks 0CB8 "the rational power series valuation ring"]
abbrev rationalPolynomial (k : Type*) [CommRing k] := AddMonoidAlgebra k ℚ≥0

/-- **Stacks 0CB8.** The monomial `t = t^1` in `rationalPolynomial k`. -/
@[stacks 0CB8 "the rational power series valuation ring"]
def polynomialT (k : Type*) [CommRing k] : rationalPolynomial k :=
  AddMonoidAlgebra.single 1 1

/-- **Stacks 0CB8.** The principal ideal `(t)` of `rationalPolynomial k`. -/
@[stacks 0CB8 "the rational power series valuation ring"]
def polynomialTIdeal (k : Type*) [CommRing k] : Ideal (rationalPolynomial k) :=
  Ideal.span {polynomialT k}

/-- **Stacks 0CB8.** The ring of power series with nonnegative rational exponents over `k`,
constructed as the `(t)`-adic completion of `rationalPolynomial k`. -/
@[stacks 0CB8 "the rational power series valuation ring"]
abbrev rationalPowerSeries (k : Type*) [CommRing k] :=
  AdicCompletion (polynomialTIdeal k) (rationalPolynomial k)

/-- **Stacks 0CB8.** Coefficient families `(a_α)_{α ∈ ℚ≥0}` in `k` having, for every natural
number `n`, only finitely many nonzero entries with `α ≤ n`. -/
@[stacks 0CB8 "the rational power series valuation ring"]
def CoefficientFamily (k : Type*) [Zero k] :=
  { f : ℚ≥0 → k // ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f q ≠ 0}.Finite }

/-- **Stacks 0CB8.** The subring of `HahnSeries ℚ≥0 k` generated by the series whose support
is finite below every integer bound. `RationalPowerSeries.mem_coefficientRing_iff` shows that
the generating set is already a subring, so this is exactly the displayed ring of series. -/
@[stacks 0CB8 "the rational power series valuation ring"]
def coefficientRing (k : Type*) [CommRing k] : Subring (HahnSeries ℚ≥0 k) :=
  Subring.closure {f | ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite}

namespace RationalPowerSeries

/-- **Stacks 0CB8.** The element `π = t` of `rationalPowerSeries k`, the image of the
exponent-one monomial under the completion map. -/
@[stacks 0CB8 "the rational power series valuation ring"]
def t (k : Type*) [CommRing k] : rationalPowerSeries k :=
  AdicCompletion.of (polynomialTIdeal k) (rationalPolynomial k) (polynomialT k)

/-- **Stacks 0CB8.** The principal ideal `(t)` of `rationalPowerSeries k`, whose powers
define the topology. -/
@[stacks 0CB8 "the rational power series valuation ring"]
def tIdeal (k : Type*) [CommRing k] : Ideal (rationalPowerSeries k) :=
  Ideal.span {t k}

/-- The `(t)`-adic topology on `rationalPowerSeries k`. -/
instance instTopologicalSpace (k : Type*) [CommRing k] :
    TopologicalSpace (rationalPowerSeries k) :=
  (tIdeal k).adicTopology

/-- The `(t)`-adic topology makes `rationalPowerSeries k` a topological ring. -/
instance instIsTopologicalRing (k : Type*) [CommRing k] :
    IsTopologicalRing (rationalPowerSeries k) :=
  (tIdeal k).nonarchimedean.toIsTopologicalRing

/-- The `(t)`-adic topology is linear: the powers of `(t)` are a basis of neighbourhoods
of zero consisting of ideals. -/
instance instIsLinearTopology (k : Type*) [CommRing k] :
    IsLinearTopology (rationalPowerSeries k) (rationalPowerSeries k) :=
  (tIdeal k).isLinearTopology

/-! ### The coefficient ring inside the Hahn series ring -/

/-- Local finiteness of the support below an integer bound is stable under addition. -/
theorem supportBelow_add {k : Type*} [Field k]
    (f g : HahnSeries ℚ≥0 k) (n : ℕ)
    (hf : {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite)
    (hg : {q : ℚ≥0 | q ≤ n ∧ g.coeff q ≠ 0}.Finite) :
    {q : ℚ≥0 | q ≤ n ∧ (f + g).coeff q ≠ 0}.Finite := by
  apply (hf.union hg).subset
  rintro q ⟨hqn, hqf⟩
  simp only [HahnSeries.coeff_add'] at hqf
  by_cases hfq : f.coeff q = 0
  · exact Set.mem_union_right _ ⟨hqn, by simpa [hfq] using hqf⟩
  · exact Set.mem_union_left _ ⟨hqn, hfq⟩

/-- Local finiteness of the support below an integer bound is stable under multiplication:
a nonzero product coefficient at `q` comes from a pair of exponents summing to `q`, each at
most `q`. -/
theorem supportBelow_mul {k : Type*} [Field k]
    (f g : HahnSeries ℚ≥0 k) (n : ℕ)
    (hf : {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite)
    (hg : {q : ℚ≥0 | q ≤ n ∧ g.coeff q ≠ 0}.Finite) :
    {q : ℚ≥0 | q ≤ n ∧ (f * g).coeff q ≠ 0}.Finite := by
  classical
  have hsubset : {q : ℚ≥0 | q ≤ n ∧ (f * g).coeff q ≠ 0} ⊆
      (hf.toFinset ×ˢ hg.toFinset).image (fun p => p.1 + p.2) := by
    rintro q ⟨hqle, hqcoeff⟩
    rw [HahnSeries.coeff_mul] at hqcoeff
    by_contra hnot
    let s := Finset.antidiagonal f.isPWO_support g.isPWO_support q
    have hterm : ∀ a ∈ s, f.coeff a.1 * g.coeff a.2 = 0 := by
      intro a ha
      by_contra hne
      apply hnot
      apply Finset.mem_image.mpr
      refine ⟨a, ?_, (Finset.mem_antidiagonal.mp ha).2.2⟩
      apply Finset.mem_product.mpr
      have hsum := (Finset.mem_antidiagonal.mp ha).2.2
      exact ⟨hf.mem_toFinset.mpr ⟨(le_self_add.trans_eq hsum).trans hqle,
          fun hz => hne (mul_eq_zero.mpr (Or.inl hz))⟩,
        hg.mem_toFinset.mpr ⟨(le_add_self.trans_eq hsum).trans hqle,
          fun hz => hne (mul_eq_zero.mpr (Or.inr hz))⟩⟩
    exact hqcoeff (Finset.sum_eq_zero hterm)
  exact (hf.toFinset ×ˢ hg.toFinset).image (fun p => p.1 + p.2) |>.finite_toSet.subset hsubset

/-- Local finiteness of the support below an integer bound holds when all nonzero
coefficients sit at a single exponent. -/
private theorem supportBelow_of_coeff_ne_zero_eq {k : Type*} [Zero k]
    (f : HahnSeries ℚ≥0 k) (q : ℚ≥0) (h : ∀ r, f.coeff r ≠ 0 → r = q) (n : ℕ) :
    {r : ℚ≥0 | r ≤ n ∧ f.coeff r ≠ 0}.Finite :=
  (Set.finite_singleton q).subset fun r hr => h r hr.2

/-- The geometric series of a locally finite series of positive order is locally finite:
below a fixed integer bound only finitely many powers contribute. -/
theorem supportBelow_geometricSeries {k : Type*} [Field k]
    (z : HahnSeries ℚ≥0 k)
    (hz : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ z.coeff q ≠ 0}.Finite)
    (hpos : 0 < z.orderTop) (n : ℕ) :
    {q : ℚ≥0 | q ≤ n ∧
      ((HahnSeries.SummableFamily.powers z).hsum).coeff q ≠ 0}.Finite := by
  by_cases hz0 : z = 0
  · subst z
    refine supportBelow_of_coeff_ne_zero_eq _ 0 (fun q hq => ?_) n
    by_contra hne
    exact hq (by simp [HahnSeries.SummableFamily.powers_zero, hne])
  · have hdpos : 0 < z.order := WithTop.coe_pos.mp <| by
      rwa [← HahnSeries.order_eq_orderTop_of_ne_zero hz0] at hpos
    obtain ⟨M, hM⟩ := exists_nat_gt ((n : ℚ≥0) / z.order)
    have hnM : (n : ℚ≥0) < M • z.order := by
      rw [nsmul_eq_mul]
      exact (div_lt_iff₀ hdpos).mp hM
    have hp : ∀ m : ℕ, ∀ b : ℕ,
      {q : ℚ≥0 | q ≤ b ∧ (z ^ m).coeff q ≠ 0}.Finite := by
      intro m
      induction m with
      | zero =>
          exact supportBelow_of_coeff_ne_zero_eq _ 0 fun q hq => by simpa using hq
      | succ m ih =>
          intro b
          simpa [pow_succ] using supportBelow_mul (z ^ m) z b (ih b) (hz b)
    have hfinite :
      (⋃ m ∈ Finset.range M,
        {q : ℚ≥0 | q ∈ (z ^ m).support ∧ q ≤ n}).Finite := by
      apply (Finset.finite_toSet (Finset.range M)).biUnion
      intro m hm
      apply (hp m n).subset
      intro q hq
      exact ⟨hq.2, (HahnSeries.mem_support _ _).mpr hq.1⟩
    apply hfinite.subset
    intro q hq
    have hsupport : q ∈ ((HahnSeries.SummableFamily.powers z).hsum).support :=
      (HahnSeries.mem_support _ _).mpr hq.2
    rcases Set.mem_iUnion.mp
      (HahnSeries.SummableFamily.support_hsum_subset hsupport) with ⟨m, hm⟩
    have hmM : m < M := by
      by_contra! hMm
      have hm' : q ∈ (z ^ m).support := by
        simpa [HahnSeries.SummableFamily.powers_of_orderTop_pos hpos m] using hm
      have hmq : m • z.order ≤ q := by
        have hle := HahnSeries.order_le_of_coeff_ne_zero ((HahnSeries.mem_support _ _).mp hm')
        simpa [HahnSeries.order_pow] using hle
      have hlt : (n : ℚ≥0) < q := lt_of_lt_of_le hnM (le_trans
        (nsmul_le_nsmul_left hdpos.le hMm) hmq)
      exact (not_lt_of_ge hq.1) hlt
    exact Set.mem_iUnion.2 ⟨m, Set.mem_iUnion.2
      ⟨Finset.mem_range.mpr hmM, ⟨by
        simpa [HahnSeries.SummableFamily.powers_of_orderTop_pos hpos m] using hm, hq.1⟩⟩⟩

/-- The locally finite Hahn series form a subring of `HahnSeries ℚ≥0 k`. -/
private def locallyFiniteSubring (k : Type*) [Field k] :
    Subring (HahnSeries ℚ≥0 k) where
  carrier := {f | ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite}
  zero_mem' := by simp [HahnSeries.coeff_zero]
  one_mem' := by
    exact supportBelow_of_coeff_ne_zero_eq _ 0 fun q hq => by simpa [HahnSeries.coeff_one] using hq
  add_mem' := fun hf hg n => supportBelow_add _ _ n (hf n) (hg n)
  mul_mem' := fun hf hg n => supportBelow_mul _ _ n (hf n) (hg n)
  neg_mem' := by
    intro f hf n
    simpa using hf n

/-- **Stacks 0CB8.** Membership in `coefficientRing k` is precisely local finiteness of the
support below every integer bound; in particular the generating set of `coefficientRing k` is
already a subring. -/
@[stacks 0CB8 "the rational power series valuation ring"]
theorem mem_coefficientRing_iff (k : Type*) [Field k] (f : HahnSeries ℚ≥0 k) :
    f ∈ coefficientRing k ↔
      ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite := by
  let s := locallyFiniteSubring k
  rw [coefficientRing]
  rw [show ({g : HahnSeries ℚ≥0 k | ∀ n : ℕ,
      {q : ℚ≥0 | q ≤ n ∧ g.coeff q ≠ 0}.Finite} : Set (HahnSeries ℚ≥0 k)) =
        (s : Set (HahnSeries ℚ≥0 k)) by rfl, Subring.closure_eq]
  rfl

/-- A single monomial `c · t^q` is locally finite, hence lies in `coefficientRing k`. -/
theorem single_mem_coefficientRing {k : Type*} [Field k]
    (q : ℚ≥0) (c : k) : HahnSeries.single q c ∈ coefficientRing k := by
  refine (mem_coefficientRing_iff k _).2 (supportBelow_of_coeff_ne_zero_eq _ q fun r hr => ?_)
  by_contra h
  exact hr (by simp [h])

/-! ### Coefficient families as Hahn series -/

/-- A family that is finitely supported below every integer bound has partially well-ordered
support: a strictly decreasing sequence would stay below an integer bound. -/
theorem coefficientFamilySupport_isPWO {k : Type*} [Zero k]
    (f : ℚ≥0 → k)
    (hf : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f q ≠ 0}.Finite) :
    (Function.support f).IsPWO := by
  apply (show (Function.support f).IsWF from ?_).isPWO
  rw [Set.isWF_iff_no_descending_seq]
  intro u hanti hu
  obtain ⟨n, hn⟩ := exists_nat_gt (u 0)
  have hfin : (Set.range u).Finite :=
    (hf n).subset (Set.range_subset_iff.mpr fun i => by
      constructor
      · exact (hanti.antitone (Nat.zero_le i)).trans hn.le
      · exact Function.mem_support.mp (hu i))
  exact hfin.not_infinite (Set.infinite_range_of_injective hanti.injective)

/-- The Hahn series determined by a coefficient family. -/
def coefficientFamilyToHahn {k : Type*} [Zero k] (f : CoefficientFamily k) :
    HahnSeries ℚ≥0 k :=
  ⟨f.1, coefficientFamilySupport_isPWO f.1 f.2⟩

/-- Division of a coefficient family by the monomial of exponent `a`, that is, the family
`q ↦ f (q + a)`. -/
def shiftDownFamily {k : Type*} [Zero k]
    (f : CoefficientFamily k) (a : ℚ≥0) : CoefficientFamily k := by
  classical
  refine ⟨fun q => f.1 (q + a), ?_⟩
  intro n
  obtain ⟨N, hN⟩ := exists_nat_gt ((n : ℚ≥0) + a)
  have hsubset : {q : ℚ≥0 | q ≤ n ∧ f.1 (q + a) ≠ 0} ⊆
      (fun r : ℚ≥0 => r - a) '' {r : ℚ≥0 | r ≤ N ∧ f.1 r ≠ 0 ∧ a ≤ r} := by
    intro q hq
    refine ⟨q + a, ⟨?_, hq.2, le_add_self⟩, ?_⟩
    · exact (add_le_add_left hq.1 a).trans hN.le
    · simp [add_tsub_cancel_right]
  have hfinite : {r : ℚ≥0 | r ≤ N ∧ f.1 r ≠ 0 ∧ a ≤ r}.Finite :=
    (f.2 N).subset (by intro r hr; exact ⟨hr.1, hr.2.1⟩)
  exact hfinite.image (fun q : ℚ≥0 => q - a) |>.subset hsubset

/-- Division of a locally finite Hahn series by the monomial of exponent `a`. -/
def shiftDownHahn {k : Type*} [Zero k]
    (f : HahnSeries ℚ≥0 k)
    (hf : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite)
    (a : ℚ≥0) : HahnSeries ℚ≥0 k :=
  coefficientFamilyToHahn (shiftDownFamily ⟨f.coeff, hf⟩ a)

/-- The coefficients of `shiftDownHahn f hf a` are those of `f`, shifted by `a`. -/
theorem shiftDownHahn_coeff {k : Type*} [Zero k]
    (f : HahnSeries ℚ≥0 k)
    (hf : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite)
    (a q : ℚ≥0) : (shiftDownHahn f hf a).coeff q = f.coeff (q + a) := rfl

/-- A locally finite series vanishing below `a` is the monomial of exponent `a` times its
shift down by `a`. -/
theorem single_mul_shiftDown_eq {k : Type*} [Field k]
    (f : HahnSeries ℚ≥0 k)
    (hf : ∀ n : ℕ, {q : ℚ≥0 | q ≤ n ∧ f.coeff q ≠ 0}.Finite)
    (a : ℚ≥0) (hbelow : ∀ q : ℚ≥0, q < a → f.coeff q = 0) :
    HahnSeries.single a (1 : k) * shiftDownHahn f hf a = f := by
  ext q
  by_cases haq : a ≤ q
  · let r : ℚ≥0 := q - a
    have hr : r + a = q := by
      dsimp [r]
      exact tsub_add_cancel_of_le haq
    rw [← hr, HahnSeries.coeff_single_mul_add]
    simp [shiftDownHahn_coeff]
  · have hfq : f.coeff q = 0 := hbelow q (lt_of_not_ge haq)
    have hprod : (HahnSeries.single a (1 : k) * shiftDownHahn f hf a).coeff q = 0 := by
      by_contra hne
      rw [HahnSeries.coeff_mul] at hne
      obtain ⟨p, hp, hterm⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
      have hp0 := Finset.mem_antidiagonal.mp hp
      rcases p with ⟨i, j⟩
      have hia : i = a := by
        simpa [HahnSeries.mem_support, HahnSeries.coeff_single] using hp0.1
      subst i
      exact haq (le_self_add.trans_eq hp0.2.2)
    simp [hfq, hprod]

end RationalPowerSeries

