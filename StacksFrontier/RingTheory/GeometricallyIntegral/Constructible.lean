module

public import Mathlib.RingTheory.Spectrum.Prime.ConstructibleSet
public import Mathlib.RingTheory.Spectrum.Prime.Noetherian
public import StacksFrontier.RingTheory.FinitePresentation.FiniteTypeSystem

/-!
# Constructible sets and the finite type system of Stacks 00R1

Let `R` be a ring, let `R₀ ⊆ R` be a subring of finite type over `ℤ` and let `R_λ` run through
the finite type `ℤ`-subalgebras of `R` containing `R₀`, as organized by
`Algebra.FiniteTypeSystem.Index`. The union of the `R_λ` is `R`, so `Spec R → Spec R_λ` has dense
image, but it is almost never surjective: for `R = ℚ` the source is a point. A Noetherian
approximation argument that has to control *every* prime of a stage therefore needs to move to a
later stage, and the tool for that is the limit lemma of Stacks 05F4: a locally constructible
subset of a stage which contains the image of the limit already contains the image of all
sufficiently large stages.

This file proves the affine case of that lemma for the system above, by an elementary ideal
computation rather than through the scheme-theoretic limit formalism.

**The argument.** A constructible subset of `Spec R_λ` is a finite union of basic pieces
`V(g₁, …, gₙ) \ V(f)`, which is what Mathlib's `PrimeSpectrum.ConstructibleSetData` records. For a
ring map `φ : R_λ → A`, such a piece misses the image of `Spec A` exactly when `φ f` lies in the
radical of the ideal generated by the `φ gᵢ`, i.e. when `φ f ^ n = ∑ cₖ ⬝ φ gᵢₖ` for some `n` and
some coefficients `cₖ ∈ A`: this is
`PrimeSpectrum.disjoint_range_comap_toSet_iff`, and it is just the translation of "no prime of `A`
contains all the `φ gᵢ` without containing `φ f`". Applying it to `φ : R_λ → R` for each of the
finitely many pieces of the complement of the given set produces finitely many elements of `R`,
all of which lie in a single later stage `R_μ`; the same relations then hold in `R_μ`, so no prime
of `R_μ` meets any piece, which is the conclusion.

Note that mere stability of the complement under specialization would not be enough, and no
weakening in that direction can work: the closed points of `Spec ℤ` form a dense,
specialization-closed set whose vanishing ideal is `0`, so there is no relation to descend.

## Main results

* `PrimeSpectrum.disjoint_range_comap_toSet_iff`: a basic constructible set `V(g) \ V(f)` of
  `Spec R` is disjoint from the image of `Spec A` exactly when `f` has a power in the ideal
  generated by the image of the `g` in `A`.
* `Algebra.FiniteTypeSystem.exists_range_comap_baseMap_subset`: the affine case of Stacks 05F4 for
  the system of Stacks 00R1 — a constructible subset of `Spec R_λ` containing the image of
  `Spec R` contains the image of `Spec R_μ` for some `μ ≥ λ`.
* `PrimeSpectrum.isConstructible_of_isOpen`: over a Noetherian ring every open subset of the
  spectrum is constructible, so the hypothesis of the lemma above is weaker than openness.

## Implementation notes

`Algebra.FiniteTypeSystem.algebraMap_baseMap` and
`Algebra.FiniteTypeSystem.exists_le_forall_mem` are small additions to the interface of
`StacksFrontier.RingTheory.FinitePresentation.FiniteTypeSystem` and belong there; they are stated
here to keep that file untouched. The second is the finite-set form of
`Algebra.FiniteTypeSystem.base_jointly_surjective` and is proved the same way.

The conclusion is phrased with `Algebra.FiniteTypeSystem.baseMap` rather than with
`algebraMap (Base R₀ i) (Base R₀ j)`, because the latter needs a `Fact (i ≤ j)` instance which
cannot be produced before the index `j` is known. The two agree definitionally once the instance
is available.

## References

* [Stacks Project, Tag 05F4](https://stacks.math.columbia.edu/tag/05F4)
* [Stacks Project, Tag 00F8](https://stacks.math.columbia.edu/tag/00F8)
* [Stacks Project, Tag 00R1](https://stacks.math.columbia.edu/tag/00R1)
-/

@[expose] public section

open Topology

universe u

namespace PrimeSpectrum

variable {R A : Type*} [CommRing R] [CommRing A]

/-- **A basic constructible set misses the image of a spectrum iff a relation holds.** The piece
`V(g₁, …, gₙ) \ V(f)` of `Spec R` described by `C` is disjoint from the image of `Spec A` under
`φ : R →+* A` exactly when some power of `φ f` lies in the ideal of `A` generated by the
`φ gᵢ`.

Indeed a prime `q` of `A` contracts into the piece exactly when it contains all the `φ gᵢ` and not
`φ f`, so the piece is missed exactly when `φ f` belongs to every prime containing the ideal
generated by the `φ gᵢ`, that is, to its radical. -/
theorem disjoint_range_comap_toSet_iff (φ : R →+* A) (C : BasicConstructibleSetData R) :
    Disjoint (Set.range (comap φ)) C.toSet ↔
      ∃ n, φ C.f ^ n ∈ (Ideal.span (Set.range C.g)).map φ := by
  rw [Set.disjoint_left]
  constructor
  · intro h
    show φ C.f ∈ ((Ideal.span (Set.range C.g)).map φ).radical
    rw [← vanishingIdeal_zeroLocus_eq_radical, mem_vanishingIdeal]
    intro q hq
    by_contra hf
    refine h (Set.mem_range_self q) ⟨?_, ?_⟩
    · rw [mem_zeroLocus] at hq ⊢
      exact fun x hx => Ideal.map_le_iff_le_comap.mp (SetLike.coe_subset_coe.mp hq)
        (Ideal.subset_span hx)
    · simpa [mem_zeroLocus] using hf
  · rintro ⟨n, hn⟩ p ⟨q, rfl⟩ ⟨h1, h2⟩
    rw [mem_zeroLocus] at h1
    have hle : (Ideal.span (Set.range C.g)).map φ ≤ q.asIdeal :=
      Ideal.map_le_iff_le_comap.mpr (Ideal.span_le.mpr h1)
    exact h2 (by simpa [mem_zeroLocus] using q.2.mem_of_pow_mem n (hle hn))

/-- Over a Noetherian ring every open subset of the spectrum is constructible, the spectrum being
a Noetherian space. -/
theorem isConstructible_of_isOpen [IsNoetherianRing R] {U : Set (PrimeSpectrum R)}
    (hU : IsOpen U) : IsConstructible U :=
  ((TopologicalSpace.NoetherianSpace.isCompact U).isRetrocompact hU).isConstructible hU

end PrimeSpectrum

namespace Algebra.FiniteTypeSystem

variable {R : Type u} [CommRing R] (R₀ : Subring R)

/-- The transition maps of the system are compatible with the inclusions into `R`. -/
theorem algebraMap_baseMap {i j : Index R₀} (h : i ≤ j) (x : Base R₀ i) :
    algebraMap (Base R₀ j) R (baseMap R₀ h x) = algebraMap (Base R₀ i) R x := rfl

/-- Every finite subset of `R` lies in some stage of the system beyond a given one. This is the
finite-set form of `Algebra.FiniteTypeSystem.base_jointly_surjective`. -/
theorem exists_le_forall_mem (i : Index R₀) (t : Finset R) :
    ∃ j : Index R₀, ∃ _ : i ≤ j, ∀ x ∈ t, x ∈ j.1 :=
  ⟨⟨i.1 ⊔ Algebra.adjoin ℤ (t : Set R), fun _ hx => (le_sup_left : i.1 ≤ _) (i.2.1 hx),
    i.2.2.sup (by simpa using Subalgebra.fg_adjoin_finset t)⟩,
    (le_sup_left : i.1 ≤ _), fun _ hx =>
    (le_sup_right : Algebra.adjoin ℤ (t : Set R) ≤ _) (Algebra.subset_adjoin hx)⟩

/-- **The affine case of the limit lemma of Stacks 05F4.** Let `U ⊆ Spec R_λ` be constructible and
suppose it contains the image of `Spec R`. Then it contains the image of `Spec R_μ` for some
stage `μ ≥ λ`.

The complement of `U` is a finite union of basic pieces `V(g) \ V(f)`, each disjoint from the
image of `Spec R`; by `PrimeSpectrum.disjoint_range_comap_toSet_iff` that disjointness is
witnessed by a relation `f ^ n = ∑ cₖ gₖ` with coefficients in `R`. All the coefficients
occurring in the finitely many relations lie in a single stage `R_μ`, where the relations
therefore already hold, so every piece is disjoint from the image of `Spec R_μ` as well. -/
theorem exists_range_comap_baseMap_subset (i : Index R₀)
    {U : Set (PrimeSpectrum (Base R₀ i))} (hU : IsConstructible U)
    (hR : Set.range (PrimeSpectrum.comap (algebraMap (Base R₀ i) R)) ⊆ U) :
    ∃ (j : Index R₀) (h : i ≤ j),
      Set.range (PrimeSpectrum.comap (baseMap R₀ h).toRingHom) ⊆ U := by
  classical
  obtain ⟨C, hC⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hU.compl
  have hdisj : ∀ c : {x // x ∈ C}, ∃ n,
      algebraMap (Base R₀ i) R c.1.f ^ n ∈
        (Ideal.span (Set.range c.1.g)).map (algebraMap (Base R₀ i) R) := by
    intro c
    rw [← PrimeSpectrum.disjoint_range_comap_toSet_iff, Set.disjoint_left]
    exact fun p hp hp' => (hC ▸ Set.mem_biUnion c.2 hp' : p ∈ Uᶜ) (hR hp)
  choose n hn using hdisj
  have hn' : ∀ c : {x // x ∈ C}, algebraMap (Base R₀ i) R c.1.f ^ n c ∈
      Ideal.span ((algebraMap (Base R₀ i) R) '' Set.range c.1.g) := fun c => by
    simpa only [Ideal.map_span] using hn c
  choose m a y hy using fun c => Submodule.mem_span_set'.mp (hn' c)
  choose z hzmem hz using fun (c : {x // x ∈ C}) (k : Fin (m c)) => (y c k).2
  obtain ⟨j, hij, hjmem⟩ := exists_le_forall_mem R₀ i
    (C.attach.biUnion fun c => Finset.univ.image (a c))
  let d : (c : {x // x ∈ C}) → Fin (m c) → Base R₀ j := fun c k =>
    ⟨a c k, hjmem _ (Finset.mem_biUnion.mpr ⟨c, Finset.mem_attach _ _,
      Finset.mem_image_of_mem _ (Finset.mem_univ k)⟩)⟩
  have hdmap : ∀ (c : {x // x ∈ C}) (k : Fin (m c)),
      algebraMap (Base R₀ j) R (d c k) = a c k := fun _ _ => rfl
  have key : ∀ c : {x // x ∈ C}, (baseMap R₀ hij) c.1.f ^ n c ∈
      (Ideal.span (Set.range c.1.g)).map (baseMap R₀ hij).toRingHom := by
    intro c
    rw [Ideal.map_span]
    refine Submodule.mem_span_set'.mpr ⟨m c, d c,
      fun k => ⟨baseMap R₀ hij (z c k), ⟨z c k, hzmem c k, rfl⟩⟩, ?_⟩
    apply algebraMap_base_injective R₀ j
    rw [map_sum, map_pow, algebraMap_baseMap, ← hy c]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [smul_eq_mul, map_mul, algebraMap_baseMap, hz c k, hdmap, smul_eq_mul]
  refine ⟨j, hij, ?_⟩
  rintro p ⟨q, rfl⟩
  by_contra hp
  rw [← Set.mem_compl_iff, ← hC] at hp
  obtain ⟨c, hcC, hc⟩ := Set.mem_iUnion₂.mp hp
  exact Set.disjoint_left.mp
    ((PrimeSpectrum.disjoint_range_comap_toSet_iff _ c).mpr ⟨n ⟨c, hcC⟩, key ⟨c, hcC⟩⟩)
    (Set.mem_range_self q) hc

end Algebra.FiniteTypeSystem

end
