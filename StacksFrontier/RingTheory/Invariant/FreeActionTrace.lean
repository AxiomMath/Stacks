module

public import Mathlib.LinearAlgebra.TensorProduct.Finiteness
public import Mathlib.RingTheory.Ideal.GoingUp
public import Mathlib.RingTheory.Invariant.Basic
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# Trace-one elements for a free action of a finite group on a ring

Let a finite group `G` act on a commutative ring `A` by ring automorphisms.  Say that the action
is *free* if for every `g ≠ 1` the elements `g • a - a` generate the unit ideal; geometrically,
no `g ≠ 1` fixes a point of `Spec A` and acts trivially on its residue field.  Then the trace
map `a ↦ ∑ g, g • a` takes the value `1`.

This is the surjectivity of the trace of a Galois extension of rings
[Chase–Harrison–Rosenberg, Lemma 1.6].  The ring maps `μ_g : A ⊗[ℤ] A → A`,
`x ⊗ y ↦ x · (g • y)`, have pairwise comaximal kernels exactly because the action is free, so
the Chinese remainder theorem produces `∑ⱼ xⱼ ⊗ yⱼ` with `∑ⱼ xⱼ · (g • yⱼ) = δ_{g,1}`.  Averaging
gives `∑ⱼ Tr(xⱼ) · yⱼ = 1`, so the ideal of the invariant ring generated by the traces generates
the unit ideal of `A`; since `A` is integral over its invariants, lying over shows that this
ideal is already the unit ideal of the invariants.

## Main results

* `MulSemiringAction.exists_sum_smul_eq_one`: for a free action of a finite group there is `t`
  with `∑ g, g • t = 1`.

## References

* [S. U. Chase, D. K. Harrison, A. Rosenberg, *Galois theory and Galois cohomology of
  commutative rings*, Mem. Amer. Math. Soc. 52 (1965)]
-/

@[expose] public section

open TensorProduct

namespace MulSemiringAction

variable {G A : Type*} [Group G] [Fintype G] [CommRing A] [MulSemiringAction G A]

/-- The ring map `A ⊗[ℤ] A → A`, `x ⊗ y ↦ x · (g • y)`. -/
noncomputable def tensorTwist (g : G) : A ⊗[ℤ] A →+* A :=
  (Algebra.TensorProduct.lift (AlgHom.id ℤ A) (MulSemiringAction.toRingHom G A g).toIntAlgHom
    (fun _ _ => Commute.all _ _)).toRingHom

omit [Fintype G] in
/-- `tensorTwist g` sends `x ⊗ y` to `x * g • y`. -/
@[simp]
theorem tensorTwist_tmul (g : G) (x y : A) : tensorTwist g (x ⊗ₜ y) = x * g • y := by
  simp [tensorTwist]

omit [Fintype G] in
/-- The ring map `tensorTwist g : A ⊗[ℤ] A → A` is surjective. -/
theorem tensorTwist_surjective (g : G) : Function.Surjective (tensorTwist (A := A) g) :=
  fun a => ⟨a ⊗ₜ 1, by simp⟩

omit [Fintype G] in
/-- For a free action, the kernels of the twists by two different elements are comaximal. -/
theorem ker_tensorTwist_sup_eq_top
    (hfree : ∀ g : G, g ≠ 1 → Ideal.span (Set.range fun a : A => g • a - a) = ⊤)
    {g h : G} (hgh : g ≠ h) :
    RingHom.ker (tensorTwist (A := A) g) ⊔ RingHom.ker (tensorTwist (A := A) h) = ⊤ := by
  set K := RingHom.ker (tensorTwist (A := A) g) ⊔ RingHom.ker (tensorTwist (A := A) h)
  set I := Ideal.map (tensorTwist g) K
  have hc : g⁻¹ * h ≠ 1 := by
    intro hc
    exact hgh (by rw [← mul_inv_cancel_left g h, hc, mul_one])
  have hdiff : ∀ a : A, g • a - h • a ∈ I := by
    intro a
    have hmem : (1 : A) ⊗ₜ[ℤ] a - (h • a) ⊗ₜ[ℤ] (1 : A) ∈ K := by
      refine Ideal.mem_sup_right ?_
      simp only [RingHom.mem_ker, map_sub, tensorTwist_tmul, one_mul, smul_one, mul_one,
        sub_self]
    have := Ideal.mem_map_of_mem (tensorTwist g) hmem
    simpa only [map_sub, tensorTwist_tmul, one_mul, smul_one, mul_one] using this
  have hI : I = ⊤ := by
    let I' := Ideal.comap (MulSemiringAction.toRingHom G A g) I
    have hle : Ideal.span (Set.range fun a : A => (g⁻¹ * h) • a - a) ≤ I' := by
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      show g • ((g⁻¹ * h) • a - a) ∈ I
      rw [smul_sub, ← mul_smul, mul_inv_cancel_left, ← neg_sub]
      exact I.neg_mem (hdiff a)
    rw [hfree _ hc, top_le_iff] at hle
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : A) ∈ I' := hle ▸ Submodule.mem_top
    simpa [I'] using h1
  have hcomap := Ideal.comap_map_of_surjective' _ (tensorTwist_surjective g) K
  rw [show Ideal.map (tensorTwist g) K = ⊤ from hI, Ideal.comap_top] at hcomap
  rw [eq_top_iff, hcomap]
  exact sup_le le_rfl le_sup_left

/-- For a free action there is `∑ⱼ xⱼ ⊗ yⱼ` with `∑ⱼ xⱼ · (g • yⱼ)` equal to `1` at `g = 1` and
to `0` elsewhere. -/
theorem exists_sum_mul_smul_eq_ite
    (hfree : ∀ g : G, g ≠ 1 → Ideal.span (Set.range fun a : A => g • a - a) = ⊤) :
    ∃ s : Finset (A × A), ∑ p ∈ s, p.1 * p.2 = 1 ∧
      ∀ g : G, g ≠ 1 → ∑ p ∈ s, p.1 * g • p.2 = 0 := by
  classical
  have hsup : RingHom.ker (tensorTwist (A := A) (1 : G)) ⊔
      ⨅ g ∈ (Finset.univ.erase (1 : G)), RingHom.ker (tensorTwist (A := A) g) = ⊤ :=
    Ideal.sup_iInf_eq_top fun g hg =>
      ker_tensorTwist_sup_eq_top hfree (Ne.symm (Finset.ne_of_mem_erase hg))
  obtain ⟨k, hk, w, hw, hkw⟩ := Submodule.mem_sup.1 (hsup ▸ Submodule.mem_top (x := (1 : A ⊗[ℤ] A)))
  obtain ⟨s, rfl⟩ := TensorProduct.exists_finset w
  have hsum : ∀ g : G, tensorTwist g (∑ p ∈ s, p.1 ⊗ₜ[ℤ] p.2) = ∑ p ∈ s, p.1 * g • p.2 := by
    intro g
    simp [map_sum]
  refine ⟨s, ?_, fun g hg => ?_⟩
  · have := congrArg (tensorTwist (A := A) (1 : G)) hkw
    rw [map_add, RingHom.mem_ker.1 hk, zero_add, map_one, hsum] at this
    simpa using this
  · rw [← hsum]
    have hmem := (Submodule.mem_iInf _).1 hw g
    exact RingHom.mem_ker.1 ((Submodule.mem_iInf _).1 hmem
      (Finset.mem_erase.2 ⟨hg, Finset.mem_univ g⟩))

/-- **Trace-one elements for a free action.**  If a finite group acts on a commutative ring so
that for every `g ≠ 1` the elements `g • a - a` generate the unit ideal, then some element has
trace `∑ g, g • t = 1`. -/
theorem exists_sum_smul_eq_one
    (hfree : ∀ g : G, g ≠ 1 → Ideal.span (Set.range fun a : A => g • a - a) = ⊤) :
    ∃ t : A, ∑ g : G, g • t = 1 := by
  classical
  obtain ⟨s, hs1, hs⟩ := exists_sum_mul_smul_eq_ite hfree
  let R := FixedPoints.subring A G
  let tr : A → R := fun x => ⟨∑ g : G, g • x, fun h => by
    simp only [Finset.smul_sum, smul_smul]
    exact Fintype.sum_equiv (Equiv.mulLeft h) _ _ (fun _ => rfl)⟩
  have hone : ∑ p ∈ s, ((tr p.1 : R) : A) * p.2 = 1 := by
    have hg : ∀ g : G, g ≠ 1 → ∑ p ∈ s, (g⁻¹ • p.1) * p.2 = 0 := by
      intro g hg
      have := congrArg (fun a : A => g⁻¹ • a) (hs g hg)
      simpa only [Finset.smul_sum, smul_mul', inv_smul_smul, smul_zero] using this
    calc ∑ p ∈ s, ((tr p.1 : R) : A) * p.2
        = ∑ g : G, ∑ p ∈ s, (g⁻¹ • p.1) * p.2 := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun p _ => ?_
          simp only [tr, Finset.sum_mul]
          exact (Fintype.sum_equiv (Equiv.inv G) _ _ (fun _ => by simp))
      _ = ∑ p ∈ s, ((1 : G)⁻¹ • p.1) * p.2 := by
          classical
          rw [Fintype.sum_eq_single 1 hg]
      _ = 1 := by simpa using hs1
  let J : Ideal R := Ideal.span (Set.range tr)
  have hJ : J = ⊤ := by
    by_contra hJ
    obtain ⟨n, hn, hJn⟩ := Ideal.exists_le_maximal J hJ
    have : Algebra.IsInvariant R A G := ⟨fun b hb => ⟨⟨b, hb⟩, rfl⟩⟩
    have : Algebra.IsIntegral R A := Algebra.IsInvariant.isIntegral R A G
    obtain ⟨P, hP, hPn⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral n
      (by
        intro x hx
        have : (x : A) = 0 := hx
        rw [show x = 0 from Subtype.ext this]
        exact n.zero_mem)
    have hmem : (1 : A) ∈ P := by
      rw [← hone]
      refine Ideal.sum_mem _ fun p _ => Ideal.mul_mem_right _ _ ?_
      have : tr p.1 ∈ n := hJn (Ideal.subset_span ⟨p.1, rfl⟩)
      rw [← hPn] at this
      exact this
    exact hP.ne_top ((Ideal.eq_top_iff_one P).2 hmem)
  have h1 : (1 : R) ∈ J := hJ ▸ Submodule.mem_top
  let trL : A →ₗ[R] R :=
    { toFun := tr
      map_add' := fun a b => Subtype.ext (by simp [tr, smul_add, Finset.sum_add_distrib])
      map_smul' := fun c x => by
        refine Subtype.ext ?_
        show ∑ g : G, g • ((c : A) * x) = (c : A) * ∑ g : G, g • x
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun g _ => ?_
        rw [smul_mul', c.2 g] }
  have hJ' : J = LinearMap.range trL := by
    show Submodule.span R (Set.range trL) = _
    rw [← LinearMap.coe_range, Submodule.span_eq]
  obtain ⟨t, ht⟩ : ∃ t : A, tr t = 1 := by
    rw [hJ'] at h1
    exact h1
  exact ⟨t, congrArg Subtype.val ht⟩

end MulSemiringAction
