/-!
# Formal smoothness and separability of field extensions

Let `K/k` be an extension of fields. Then `K` is formally smooth over `k` if it is purely
transcendental, separable algebraic, or separable over `k` in the sense that every subextension
finitely generated over `k` has a separating transcendence basis. Conversely, a formally smooth
field extension is separable, so that formal smoothness and separability of `K/k` agree. Moreover,
separability of `K/k` is equivalent to reducedness of `K ⊗[k] k^{1/p}` for the exponential
characteristic `p` of `k`, to geometric reducedness, to injectivity of the canonical map
`K ⊗[k] Ω[k⁄ℤ] → Ω[K⁄ℤ]`, and to the vanishing of `H¹(L_{K/k})`; every extension of a field of
characteristic zero is separable, and every extension of a perfect field is formally smooth.

## Main results

* `Algebra.FormallySmooth.of_algebraicIndependent_and_of_isSeparable_and_of_isSeparableExtension`:
  a purely transcendental, separable algebraic or separable field extension is formally smooth.
* `Algebra.FormallySmooth.isSeparableExtension`: a formally smooth field extension is separable.
* `Algebra.FormallySmooth.iff_isSeparableExtension`: a field extension is formally smooth if and
  only if it is separable.
* `Stacks.FormallySmooth.SeparableTFAE.isGeometricallyReduced_of_isSeparableExtension`: a
  separable field extension is geometrically reduced.
* `Algebra.isSeparableExtension_of_charZero_and_tfae`: six characterizations of separability of a
  field extension are equivalent, and in characteristic zero every field extension is separable.
* `Algebra.formallySmooth_of_perfectField`: every extension of a perfect field is formally smooth.

## References

* [StacksProject 0320](https://stacks.math.columbia.edu/tag/0320)
* [StacksProject 031Y](https://stacks.math.columbia.edu/tag/031Y)
* [StacksProject 0321](https://stacks.math.columbia.edu/tag/0321)
* [StacksProject 0322](https://stacks.math.columbia.edu/tag/0322)
* [StacksProject 030O](https://stacks.math.columbia.edu/tag/030O)
-/

@[expose] public section

@[expose] public section

/-- The subextension generated by finitely many elements is essentially of finite type. -/
private lemma essFiniteType_adjoin_finset {k K : Type*} [Field k] [Field K] [Algebra k K]
    (s : Finset K) : Algebra.EssFiniteType k (IntermediateField.adjoin k (s : Set K)) :=
  IntermediateField.essFiniteType_iff.mpr (IntermediateField.fg_adjoin_finset s)

namespace Stacks.FormallySmooth.FieldCriteria

open Algebra MvPolynomial

section CanonicalPresentation

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The naive cotangent complex of the canonical presentation `R[x_s; s ∈ S] → S` kills the class
of a relation `F` exactly when every partial derivative of `F` vanishes at `x_s ↦ s`. -/
private lemma cotangentComplex_mk_eq_zero_iff (F : ↥(Generators.self R S).toExtension.ker) :
    (Generators.self R S).toExtension.cotangentComplex (Extension.Cotangent.mk F) = 0 ↔
      ∀ i : S, aeval (_root_.id : S → S) (pderiv i F.1) = 0 := by
  rw [← map_eq_zero_iff _ (Generators.self R S).cotangentSpaceBasis.repr.injective,
    Finsupp.ext_iff]
  simp [Extension.cotangentComplex_mk, Generators.cotangentSpaceBasis_repr_one_tmul,
    funext (Generators.self_val R S)]

/-- `H¹` of the cotangent complex of `S/R`, read off the canonical presentation
`R[x_s; s ∈ S] → S`: it vanishes exactly when every relation `F` among the elements of `S` whose
partial derivatives all vanish at the tautological point `x_s ↦ s` lies in the square of the ideal
of relations. -/
private lemma subsingleton_h1Cotangent_iff_forall_mem_ker_sq (R S : Type*) [CommRing R]
    [CommRing S] [Algebra R S] :
    Subsingleton (Algebra.H1Cotangent R S) ↔
      ∀ F ∈ (Generators.self R S).toExtension.ker,
        (∀ i : S, aeval (_root_.id : S → S) (pderiv i F) = 0) →
          F ∈ (Generators.self R S).toExtension.ker ^ 2 := by
  rw [Algebra.H1Cotangent, Extension.subsingleton_h1Cotangent, ← LinearMap.ker_eq_bot,
    LinearMap.ker_eq_bot']
  refine ⟨fun h F hF hpd => ?_, fun h x hx => ?_⟩
  · exact (Extension.Cotangent.mk_eq_zero_iff ⟨F, hF⟩).mp
      (h _ ((cotangentComplex_mk_eq_zero_iff ⟨F, hF⟩).mpr hpd))
  · obtain ⟨f, rfl⟩ := Extension.Cotangent.mk_surjective x
    exact (Extension.Cotangent.mk_eq_zero_iff f).mpr
      (h f.1 f.2 ((cotangentComplex_mk_eq_zero_iff f).mp hx))

end CanonicalPresentation

section Tower

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
  [Algebra S T] [IsScalarTower R S T]

/-- Naturality of the canonical presentation in the middle algebra of a tower `R → S → T`:
evaluating a polynomial in the variables `x_s`, `s ∈ S`, at the tautological point of `T` is
evaluating it at the tautological point of `S` and pushing the value forward to `T`. -/
private lemma aeval_id_rename_algebraMap (p : MvPolynomial S R) :
    aeval (_root_.id : T → T) (rename (algebraMap S T) p) =
      algebraMap S T (aeval (_root_.id : S → S) p) :=
  AlgHom.congr_fun (MvPolynomial.algHom_ext (fun i => by simp) :
    (aeval (_root_.id : T → T)).comp (rename (algebraMap S T)) =
      (IsScalarTower.toAlgHom R S T).comp (aeval (_root_.id : S → S))) p

/-- A polynomial in the variables `x_s`, `s ∈ S`, is a relation over `S` if and only if it is one
over `T`, as soon as `S → T` is injective. -/
private lemma aeval_id_rename_algebraMap_eq_zero_iff (hST : Function.Injective (algebraMap S T))
    (p : MvPolynomial S R) :
    aeval (_root_.id : T → T) (rename (algebraMap S T) p) = 0 ↔
      aeval (_root_.id : S → S) p = 0 := by
  rw [aeval_id_rename_algebraMap, map_eq_zero_iff _ hST]

/-- `R[x_s; s ∈ S] → R[x_t; t ∈ T]` carries every power of the ideal of relations of `S/R` into
the same power of the ideal of relations of `T/R`. -/
private lemma map_rename_ker_pow_le (n : ℕ) :
    Ideal.map (rename (algebraMap S T) : MvPolynomial S R →ₐ[R] MvPolynomial T R)
        (RingHom.ker ((aeval (_root_.id : S → S)).toRingHom) ^ n) ≤
      RingHom.ker ((aeval (_root_.id : T → T)).toRingHom) ^ n := by
  rw [Ideal.map_pow]
  refine Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr fun p hp => ?_) n
  simp only [Ideal.mem_comap, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hp ⊢
  rw [aeval_id_rename_algebraMap, hp, map_zero]

end Tower

section Fields

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- `H¹` of the cotangent complex of a field extension `K/k` vanishes as soon as it vanishes for
every subextension of `K/k` generated by finitely many elements. -/
private lemma subsingleton_h1Cotangent_of_forall_adjoin_finset
    (H : ∀ s : Finset K,
      Subsingleton (Algebra.H1Cotangent k (IntermediateField.adjoin k (s : Set K)))) :
    Subsingleton (Algebra.H1Cotangent k K) := by
  rw [subsingleton_h1Cotangent_iff_forall_mem_ker_sq]
  intro F hF hpd
  have hFval : aeval (_root_.id : K → K) F = 0 := hF
  set K' := IntermediateField.adjoin k (F.vars : Set K)
  have hinj : Function.Injective (algebraMap K' K) := (algebraMap K' K).injective
  obtain ⟨G, hGF⟩ := exists_rename_eq_of_vars_subset_range F (algebraMap K' K) hinj
    fun i hi => ⟨⟨i, IntermediateField.subset_adjoin k _ hi⟩, rfl⟩
  have hGker : G ∈ (Generators.self k K').toExtension.ker :=
    (aeval_id_rename_algebraMap_eq_zero_iff hinj G).mp (hGF ▸ hFval)
  have hG2 : G ∈ (RingHom.ker ((aeval (_root_.id : K' → K')).toRingHom) :
      Ideal (MvPolynomial K' k)) ^ 2 :=
    (subsingleton_h1Cotangent_iff_forall_mem_ker_sq k K').mp (H F.vars) G hGker fun j =>
      (aeval_id_rename_algebraMap_eq_zero_iff hinj _).mp
        (by rw [← pderiv_rename hinj, hGF]; exact hpd _)
  change F ∈ (RingHom.ker ((aeval (_root_.id : K → K)).toRingHom) : Ideal (MvPolynomial K k)) ^ 2
  rw [← hGF]
  exact map_rename_ker_pow_le 2 (Ideal.mem_map_of_mem _ hG2)

/-- A separably generated field extension is formally smooth. -/
@[ega "0 19.0.2" "II, special case",
  ega "0 19.6.1" "special case",
  ega "0 21.5.1" "special case",
  ega "0 22.2.1" "special case"]
private lemma formallySmooth_of_isSeparablyGenerated (h : Algebra.IsSeparablyGenerated k K) :
    Algebra.FormallySmooth k K := by
  obtain ⟨t, ht, hts⟩ := h.isSeparable
  have : Algebra.IsSeparable ↥(IntermediateField.adjoin k (Set.range ((↑) : t → K))) K := by
    rwa [Subtype.range_coe]
  exact Algebra.FormallySmooth.of_algebraicIndependent_of_isSeparable ht.1

/-- Every subextension of a separable extension generated by finitely many elements is formally
smooth. -/
private lemma formallySmooth_adjoin_finset (h : Algebra.IsSeparableExtension k K) (s : Finset K) :
    Algebra.FormallySmooth k (IntermediateField.adjoin k (s : Set K)) :=
  have := essFiniteType_adjoin_finset (k := k) s
  formallySmooth_of_isSeparablyGenerated (h.isSeparablyGenerated _)

end Fields

/-- Let `K/k` be an extension of fields. Then `K` is formally smooth over `k` in each of the
following three cases: (1) `K` is purely transcendental over `k`, that is, `K` is generated as an
intermediate field by an algebraically independent set; (2) `K` is separable algebraic over `k`;
(3) `K` is separable over `k` in the sense of `Algebra.IsSeparableExtension`. -/
public theorem solution (k K : Type*) [Field k] [Field K] [Algebra k K] :
    (∀ s : Set K, AlgebraicIndependent k ((↑) : s → K) → IntermediateField.adjoin k s = ⊤ →
        Algebra.FormallySmooth k K) ∧
      (Algebra.IsSeparable k K → Algebra.FormallySmooth k K) ∧
      (Algebra.IsSeparableExtension k K → Algebra.FormallySmooth k K) :=
  ⟨fun s hs hs' => Algebra.FormallySmooth.of_algebraicIndependent hs (by rwa [Subtype.range_coe]),
    fun h => have := h; have := Algebra.FormallyEtale.of_isSeparable k K; inferInstance,
    fun h => (Algebra.formallySmooth_iff_subsingleton_h1Cotangent k K).mpr
      (subsingleton_h1Cotangent_of_forall_adjoin_finset fun s =>
        (Algebra.formallySmooth_iff_subsingleton_h1Cotangent k _).mp
          (formallySmooth_adjoin_finset h s))⟩

end Stacks.FormallySmooth.FieldCriteria

end

@[expose] public section

/-- Let `K/k` be an extension of fields. Then `K` is formally smooth over `k` in each of the
following three cases: (1) `K` is purely transcendental over `k`, that is, `K` is generated as an
intermediate field by an algebraically independent set; (2) `K` is separable algebraic over `k`;
(3) `K` is separable over `k` in the sense of `Algebra.IsSeparableExtension`. -/
@[stacks 0320 "The source's parts (1), (2), (3) are the conjuncts `.1`, `.2.1`, `.2.2`. Purely
transcendental is `AlgebraicIndependent` together with `IntermediateField.adjoin k s = ⊤`, as in
the Mathlib sibling `Algebra.FormallySmooth.of_algebraicIndependent`; separable algebraic is
`Algebra.IsSeparable`; separable is `Algebra.IsSeparableExtension`, Definition 030O(2), which does
not presuppose algebraicity. See the module docstring.",
  ega "0 19.6.1" "sufficiency",
  ega "0 21.5.1" "more general",
  ega "0 19.0.2" "sufficiency",
  ega "0 22.2.1" "special case"]
public theorem
    Algebra.FormallySmooth.of_algebraicIndependent_and_of_isSeparable_and_of_isSeparableExtension
    (k K : Type*) [Field k] [Field K] [Algebra k K] :
    (∀ s : Set K, AlgebraicIndependent k ((↑) : s → K) → IntermediateField.adjoin k s = ⊤ →
        Algebra.FormallySmooth k K) ∧
      (Algebra.IsSeparable k K → Algebra.FormallySmooth k K) ∧
      (Algebra.IsSeparableExtension k K → Algebra.FormallySmooth k K) :=
  Stacks.FormallySmooth.FieldCriteria.solution k K

end

@[expose] public section

namespace Stacks.FormallySmooth.SeparableNecessity

/-- Let `K/k` be an extension of fields. If `K` is formally smooth over `k`, then `K` is a
separable extension of `k`: every subextension of `K/k` finitely generated over `k` has a
separating transcendence basis. -/
public theorem solution (k K : Type*) [Field k] [Field K]
    [Algebra k K] [Algebra.FormallySmooth k K] : Algebra.IsSeparableExtension k K :=
  have ⟨r, hr⟩ := KaehlerDifferential.exists_retraction_mapBaseChange ℤ k K
  (Algebra.isSeparableExtension_iff_injective_mapBaseChange k K).2
    (LinearMap.injective_of_comp_eq_id _ r hr)

end Stacks.FormallySmooth.SeparableNecessity

end

@[expose] public section

/-- Let `K/k` be an extension of fields. If `K` is formally smooth over `k`, then `K` is a
separable extension of `k`: every subextension of `K/k` finitely generated over `k` has a
separating transcendence basis. -/
@[stacks 031Y "Separability is `Algebra.IsSeparableExtension` (Definition 030O(2)), not Mathlib's
`Algebra.IsSeparable`, which asks the extension to be algebraic and would make the statement false
for purely transcendental extensions. See the module docstring.",
  ega "0 19.6.1" "necessity",
  ega "0 19.0.2" "necessity"]
public theorem Algebra.FormallySmooth.isSeparableExtension (k K : Type*) [Field k] [Field K]
    [Algebra k K] [Algebra.FormallySmooth k K] : Algebra.IsSeparableExtension k K :=
  Stacks.FormallySmooth.SeparableNecessity.solution k K

end

@[expose] public section

namespace Stacks.FormallySmooth.SeparableIff

/-- A field extension `K/k` is formally smooth over `k` if and only if it is separable over `k` in
the sense of `Algebra.IsSeparableExtension`. -/
public theorem solution (k K : Type*) [Field k] [Field K] [Algebra k K] :
    Algebra.FormallySmooth k K ↔ Algebra.IsSeparableExtension k K :=
  ⟨fun _ => Algebra.FormallySmooth.isSeparableExtension k K,
    (Algebra.FormallySmooth.of_algebraicIndependent_and_of_isSeparable_and_of_isSeparableExtension
      k K).2.2⟩

end Stacks.FormallySmooth.SeparableIff

end

@[expose] public section

/-- A field extension `K/k` is formally smooth over `k` if and only if it is separable over `k` in
the sense of `Algebra.IsSeparableExtension`. -/
@[stacks 0321 "Separability is `Algebra.IsSeparableExtension`, Definition 030O (2), which does not
presuppose algebraicity and so is not `Algebra.IsSeparable`; formal smoothness is
`Algebra.FormallySmooth`, Definition 00TI. The characteristic split is dropped: both implications
hold in every characteristic (the source's proof is `combine Lemmas 031Y and 0320`, neither of
which mentions the characteristic), so part (2) is this equivalence and part (1) is it together
with the characteristic-zero case of Lemma 030Z. See the module docstring.", ega "0 19.6.1", ega
  "0 21.5.1" "more general", ega "0 19.0.2"]
public theorem Algebra.FormallySmooth.iff_isSeparableExtension (k K : Type*) [Field k] [Field K]
    [Algebra k K] : Algebra.FormallySmooth k K ↔ Algebra.IsSeparableExtension k K :=
  Stacks.FormallySmooth.SeparableIff.solution k K

end

@[expose] public section

open scoped TensorProduct in
/-- `A ⊗[R] B` is reduced if and only if `B ⊗[R] A` is reduced. -/
public theorem isReduced_tensorProduct_comm {R A B : Type*} [CommSemiring R] [CommSemiring A]
    [CommSemiring B] [Algebra R A] [Algebra R B] :
    IsReduced (A ⊗[R] B) ↔ IsReduced (B ⊗[R] A) :=
  ⟨fun _ ↦ isReduced_of_injective (Algebra.TensorProduct.comm R B A) (AlgEquiv.injective _),
    fun _ ↦ isReduced_of_injective (Algebra.TensorProduct.comm R A B) (AlgEquiv.injective _)⟩

namespace Stacks.FormallySmooth.SeparableTFAE

open scoped TensorProduct

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

section PurelyTranscendental

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- For a domain `S` over `k`, the base change `k(σ) ⊗[k] S` of `S` to the rational function field
`k(σ)` is a domain. -/
@[ega "IV 4.3.9" "special case"]
private theorem isDomain_tensorProduct_fractionRing_mvPolynomial (k : Type*) [Field k]
    (σ : Type*) (S : Type*) [CommRing S] [IsDomain S] [Algebra k S] :
    IsDomain (FractionRing (MvPolynomial σ k) ⊗[k] S) := by
  have hd : IsDomain (MvPolynomial σ k ⊗[k] S) :=
    Function.Injective.isDomain
      ((Algebra.TensorProduct.comm k (MvPolynomial σ k) S).trans
        ((MvPolynomial.algebraTensorAlgEquiv k S).restrictScalars k)).toRingHom
      (AlgEquiv.injective _)
  have hinj : Function.Injective (algebraMap (MvPolynomial σ k) (MvPolynomial σ k ⊗[k] S)) :=
    Algebra.TensorProduct.includeLeft_injective (S := k) (FaithfulSMul.algebraMap_injective k S)
  have hle : Algebra.algebraMapSubmonoid (MvPolynomial σ k ⊗[k] S)
      (nonZeroDivisors (MvPolynomial σ k)) ≤ nonZeroDivisors (MvPolynomial σ k ⊗[k] S) := by
    rintro x ⟨y, hy, rfl⟩
    rw [SetLike.mem_coe, mem_nonZeroDivisors_iff_ne_zero] at hy
    rw [mem_nonZeroDivisors_iff_ne_zero]
    exact fun h ↦ hy (hinj (by rw [h, map_zero]))
  have : IsDomain (FractionRing (MvPolynomial σ k) ⊗[MvPolynomial σ k]
      (MvPolynomial σ k ⊗[k] S)) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ hle
  exact Function.Injective.isDomain
    (Algebra.TensorProduct.cancelBaseChange k (MvPolynomial σ k) (FractionRing (MvPolynomial σ k))
      (FractionRing (MvPolynomial σ k)) S).symm.toRingHom (AlgEquiv.injective _)

end PurelyTranscendental

/-- Base change of a domain along the subextension generated by an algebraically independent family
is a domain. -/
private theorem isDomain_tensorProduct_of_algebraicIndependent {s : Set K}
    (hs : AlgebraicIndependent k ((↑) : s → K)) (S : Type*) [CommRing S] [IsDomain S]
    [Algebra k S] : IsDomain (IntermediateField.adjoin k s ⊗[k] S) :=
  have e : FractionRing (MvPolynomial s k) ≃ₐ[k] IntermediateField.adjoin k s :=
    hs.aevalEquivField.trans (IntermediateField.equivOfEq (by rw [Subtype.range_coe]))
  have := isDomain_tensorProduct_fractionRing_mvPolynomial k s S
  Function.Injective.isDomain (Algebra.TensorProduct.congr e AlgEquiv.refl).symm.toRingHom
    (AlgEquiv.injective _)

/-- A separably generated field extension of finite type is geometrically reduced. -/
private theorem isGeometricallyReduced_of_isSeparablyGenerated (k K : Type*) [Field k] [Field K]
    [Algebra k K] [Algebra.EssFiniteType k K] [Algebra.IsSeparablyGenerated k K] :
    Algebra.IsGeometricallyReduced k K := by
  obtain ⟨s, hs, hsep⟩ :=
    Algebra.IsSeparablyGenerated.isSeparable (k := k) (K := K)
  have := hsep
  have := isDomain_tensorProduct_of_algebraicIndependent hs.1 (AlgebraicClosure k)
  have : IsReduced (K ⊗[IntermediateField.adjoin k s]
      (IntermediateField.adjoin k s ⊗[k] AlgebraicClosure k)) :=
    Stacks.GeometricallyReduced.SeparableBaseChange.isReduced_tensorProduct_of_isSeparable
  rw [Algebra.isGeometricallyReduced_field_iff]
  exact isReduced_tensorProduct_comm.mp (isReduced_of_injective
    (Algebra.TensorProduct.cancelBaseChange k (IntermediateField.adjoin k s) K K
      (AlgebraicClosure k)).symm (AlgEquiv.injective _))

/-- A field extension is geometrically reduced as soon as its subextensions of finite type are. -/
public theorem isGeometricallyReduced_of_forall_essFiniteType (k K : Type*) [Field k] [Field K]
    [Algebra k K] (h : ∀ K' : IntermediateField k K, [Algebra.EssFiniteType k K'] →
      Algebra.IsGeometricallyReduced k K') : Algebra.IsGeometricallyReduced k K := by
  refine Algebra.IsGeometricallyReduced.of_forall_fg fun B hB ↦ ?_
  obtain ⟨t, rfl⟩ := hB
  have := essFiniteType_adjoin_finset (k := k) t
  have := h (IntermediateField.adjoin k (t : Set K))
  exact Algebra.IsGeometricallyReduced.of_injective
    (Subalgebra.inclusion (Algebra.adjoin_le fun x hx ↦ IntermediateField.subset_adjoin k _ hx))
    (Subalgebra.inclusion_injective _)

/-- A separable field extension is geometrically reduced. -/
public theorem isGeometricallyReduced_of_isSeparableExtension (k K : Type*) [Field k] [Field K]
    [Algebra k K] [Algebra.IsSeparableExtension k K] : Algebra.IsGeometricallyReduced k K :=
  isGeometricallyReduced_of_forall_essFiniteType k K fun K' ↦
    isGeometricallyReduced_of_isSeparablyGenerated k K'

/-- Let `A` be an algebra of exponential characteristic `p` over a ring `S`, itself an algebra over
`R`, and let `r : R → S` send each `c` to a `p`-th root of `algebraMap R S c`. Then the `p`-th
power of the combination `∑ r (c i) • x i` is the `R`-linear combination `∑ c i • x i ^ p`. -/
public theorem sum_smul_pow_char {R S A ι : Type*} [CommSemiring R] [CommSemiring S]
    [CommSemiring A] [Algebra R S] [Algebra S A] [Algebra R A] [IsScalarTower R S A] (p : ℕ)
    [ExpChar A p] {r : R → S} (hr : ∀ c : R, r c ^ p = algebraMap R S c) (t : Finset ι)
    (c : ι → R) (x : ι → A) : (∑ i ∈ t, r (c i) • x i) ^ p = ∑ i ∈ t, c i • x i ^ p := by
  rw [sum_pow_char]
  exact Finset.sum_congr rfl fun i _ ↦ by rw [smul_pow, hr, algebraMap_smul]

/-- If `K ⊗[k] k^{1/p}` is reduced, then raising to the `p`-th power carries `k`-linearly
independent subsets of `K` to `k`-linearly independent subsets. -/
public theorem linearIndepOn_pow_of_isReduced (p : ℕ) [ExpChar k p]
    (h : IsReduced (K ⊗[k] AdjoinPthRoots k)) {s : Set K} (hs : LinearIndepOn k _root_.id s) :
    LinearIndepOn k (· ^ p) s := by
  have := isReduced_tensorProduct_comm.mp h
  have : ExpChar (AdjoinPthRoots k ⊗[k] K) p :=
    expChar_of_injective_algebraMap (algebraMap k _).injective p
  have hli := linearIndependent_iff'.mp
    (Module.Flat.linearIndependent_one_tmul (S := AdjoinPthRoots k) hs)
  refine linearIndependent_iff'.mpr fun t c hc x hx ↦ ?_
  have hy : (∑ i ∈ t, AdjoinPthRoots.root k (c i) •
      ((1 : AdjoinPthRoots k) ⊗ₜ[k] (i : K))) = 0 := by
    refine IsNilpotent.eq_zero ⟨p, ?_⟩
    rw [sum_smul_pow_char p (AdjoinPthRoots.root_pow (k := k) (p := p))]
    simp only [Algebra.TensorProduct.tmul_pow, one_pow, TensorProduct.smul_tmul',
      TensorProduct.smul_tmul, ← TensorProduct.tmul_sum, hc, TensorProduct.tmul_zero]
  simpa using hli t (fun i ↦ AdjoinPthRoots.root k (c i)) hy x hx

/-- Let `k → K → L` be a tower of fields. If raising to the `p`-th power carries `k`-linearly
independent subsets of `L` to `k`-linearly independent subsets, then it does so for subsets of
`K`. -/
public theorem linearIndepOn_pow_of_isScalarTower {L : Type*} [Field L] [Algebra K L]
    [Algebra k L] [IsScalarTower k K L] (p : ℕ)
    (H : ∀ s : Set L, LinearIndepOn k _root_.id s → LinearIndepOn k (· ^ p) s) {s : Set K}
    (hs : LinearIndepOn k _root_.id s) : LinearIndepOn k (· ^ p) s :=
  have h := (H _ ((LinearIndepOn.id_image_algebraMap_iff (A := L)).mpr hs)).comp_of_image
    (FaithfulSMul.algebraMap_injective K L).injOn
  (LinearIndepOn.algebraMap_comp_iff (A := L)).mp
    (h.congr fun x _ ↦ (map_pow (algebraMap K L) x p).symm)

/-- Let `p` be the exponential characteristic of `k`. If raising to the `p`-th power carries
`k`-linearly independent subsets of `K` to `k`-linearly independent subsets, then `K` is separable
over `k`. -/
public theorem isSeparableExtension_of_forall_linearIndepOn_pow (p : ℕ) [ExpChar k p]
    (H : ∀ s : Set K, LinearIndepOn k _root_.id s → LinearIndepOn k (· ^ p) s) :
    Algebra.IsSeparableExtension k K := by
  refine ⟨fun K' _ ↦ ⟨?_⟩⟩
  obtain ⟨t, ht, hsep⟩ : ∃ t : Finset K', IsTranscendenceBasis k ((↑) : t → K') ∧
      Algebra.IsSeparable (IntermediateField.adjoin k (t : Set K')) K' := by
    rcases expChar_is_prime_or_one k p with hp | rfl
    · exact exists_isTranscendenceBasis_and_isSeparable_of_linearIndepOn_pow_of_essFiniteType p hp
        fun _ ht ↦ linearIndepOn_pow_of_isScalarTower p H ht
    · have := charZero_of_expChar_one' (R := k)
      exact exists_isTranscendenceBasis_and_isSeparable_of_perfectField k K'
  exact ⟨t, ht, hsep⟩

/-- If `K ⊗[k] k^{1/p}` is reduced, `p` the exponential characteristic of `k`, then the field
extension `K/k` is separable. -/
@[ega "IV 4.3.5" "special case"]
private theorem isSeparableExtension_of_isReduced_tensorProduct_adjoinPthRoots (k K : Type*)
    [Field k] [Field K] [Algebra k K] (h : IsReduced (K ⊗[k] AdjoinPthRoots k)) :
    Algebra.IsSeparableExtension k K :=
  have ⟨p, hp⟩ := ExpChar.exists k
  have := hp
  isSeparableExtension_of_forall_linearIndepOn_pow p fun _ hs ↦
    linearIndepOn_pow_of_isReduced p h hs

/-- In characteristic zero every field extension is separable. -/
private theorem isSeparableExtension_of_charZero (k K : Type*) [Field k] [Field K] [Algebra k K]
    [CharZero k] : Algebra.IsSeparableExtension k K :=
  isSeparableExtension_of_forall_linearIndepOn_pow 1 fun _ hs ↦ by
    simpa only [pow_one, Function.id_def] using hs

/-- Let `K/k` be a field extension. If the characteristic of `k` is zero then `K` is separable over
`k`; and, in any characteristic, the following are equivalent: `K` is separable over `k`, the ring
`K ⊗_k k^{1/p}` is reduced for the exponential characteristic `p` of `k`, `K` is geometrically
reduced over `k`, the map `K ⊗_k Ω_{k/𝐙} → Ω_{K/𝐙}` is injective, `H_1(L_{K/k}) = 0`, and `K` is
formally smooth over `k`. -/
public theorem solution (k K : Type*) [Field k] [Field K] [Algebra k K] :
    (CharZero k → Algebra.IsSeparableExtension k K) ∧
      List.TFAE
        [Algebra.IsSeparableExtension k K,
          IsReduced (K ⊗[k] AdjoinPthRoots k),
          Algebra.IsGeometricallyReduced k K,
          Function.Injective (KaehlerDifferential.mapBaseChange ℤ k K),
          Subsingleton (Algebra.H1Cotangent k K),
          Algebra.FormallySmooth k K] := by
  refine ⟨fun _ ↦ isSeparableExtension_of_charZero k K, ?_⟩
  tfae_have 1 → 3 := fun _ ↦ isGeometricallyReduced_of_isSeparableExtension k K
  tfae_have 3 → 2 := fun _ ↦
    (isReduced_tensorProduct_comm (A := AdjoinPthRoots k)).mp inferInstance
  tfae_have 2 → 1 := isSeparableExtension_of_isReduced_tensorProduct_adjoinPthRoots k K
  tfae_have 1 ↔ 4 := Algebra.isSeparableExtension_iff_injective_mapBaseChange k K
  tfae_have 1 ↔ 6 := (Algebra.FormallySmooth.iff_isSeparableExtension k K).symm
  tfae_have 5 ↔ 6 := (Algebra.formallySmooth_iff_subsingleton_h1Cotangent k K).symm
  tfae_finish

end Stacks.FormallySmooth.SeparableTFAE

end

@[expose] public section

open scoped TensorProduct

/-- Let `K/k` be a field extension. If the characteristic of `k` is zero then `K` is separable over
`k`; and, in any characteristic, the following are equivalent: `K` is separable over `k`, the ring
`K ⊗_k k^{1/p}` is reduced for the exponential characteristic `p` of `k`, `K` is geometrically
reduced over `k`, the map `K ⊗_k Ω_{k/𝐙} → Ω_{K/𝐙}` is injective, `H_1(L_{K/k}) = 0`, and `K` is
formally smooth over `k`. -/
@[stacks 0322 "The equivalences are stated uniformly in the characteristic: `k^{1/p}` is
`AdjoinPthRoots k` for the exponential characteristic, which in characteristic zero makes the second
condition, hence all of them, automatic, and the source's characteristic-zero list is recovered.
Differentials are taken over `𝐙` in both characteristics. See the module docstring.",
  ega "0 20.6.3"]
public theorem Algebra.isSeparableExtension_of_charZero_and_tfae (k K : Type*) [Field k] [Field K]
    [Algebra k K] :
    (CharZero k → Algebra.IsSeparableExtension k K) ∧
      List.TFAE
        [Algebra.IsSeparableExtension k K,
          IsReduced (K ⊗[k] AdjoinPthRoots k),
          Algebra.IsGeometricallyReduced k K,
          Function.Injective (KaehlerDifferential.mapBaseChange ℤ k K),
          Subsingleton (Algebra.H1Cotangent k K),
          Algebra.FormallySmooth k K] :=
  Stacks.FormallySmooth.SeparableTFAE.solution k K

/-- Every extension of a perfect field is formally smooth. -/
@[ega "0 19.0.2" "special case",
  ega "0 19.10.3" "perfect base field",
  ega "0 19.6.1" "special case",
  ega "0 21.5.1" "special case",
  ega "0 22.2.1" "more general", sga "1 III 1.2" "special case"]
public theorem Algebra.formallySmooth_of_perfectField (k K : Type*) [Field k] [Field K]
    [Algebra k K] [PerfectField k] : Algebra.FormallySmooth k K := by
  apply (Algebra.FormallySmooth.iff_isSeparableExtension k K).mpr
  refine ⟨fun L _ => ⟨?_⟩⟩
  obtain ⟨t, ht, hs⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField k L
  exact ⟨t, ht, hs⟩

end
