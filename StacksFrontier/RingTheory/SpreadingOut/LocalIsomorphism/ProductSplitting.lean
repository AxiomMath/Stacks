/-!
# Splitting off a factor `R_f` of `S_f`

If `φ : R → S` is of finite presentation and `R_p → S_q` is bijective, then `S_f ≅ R_f × C` as
`R_f`-algebras for some `f ∉ p` and some `R_f`-algebra `C`: the kernel of a retraction of
`R_f → S_f` becomes generated by an idempotent after a further localization.

## Main results

* `exists_algEquiv_prod_of_isIdempotentElem`: an `R`-algebra `A` with an idempotent `g` such
  that `A ⧸ (1 - g) ≅ R` is isomorphic to a product `R × C`.
* `exists_away_prod_of_localRingHom_bijective`: if `R_p → S_q` is bijective, then
  `S_f ≅ R_f × C` as `R_f`-algebras for some `f ∉ p` and some `R_f`-algebra `C`.

## References

* [Stacks Project, Tag 00QR](https://stacks.math.columbia.edu/tag/00QR)
-/

@[expose] public section

universe u v v' w w'

@[expose] public section

open Localization

/-- If `A` is a commutative `R`-algebra, `g ∈ A` is idempotent, and the quotient `A ⧸ (1 - g)` is
`R`-algebra isomorphic to `R`, then `A` is `R`-algebra isomorphic to a product `R × C`. -/
theorem exists_algEquiv_prod_of_isIdempotentElem (R A : Type) [CommRing R] [CommRing A] [Algebra R
  A] (g : A)
    (hg : IsIdempotentElem g) (iso : (A ⧸ Ideal.span {1 - g}) ≃ₐ[R] R) :
    ∃ (C : Type) (_ : CommRing C) (_ : Algebra R C), Nonempty (A ≃ₐ[R] R × C) := by
  have hmul : (1 - g) * g = 0 := by rw [sub_mul, one_mul, hg.eq, sub_self]
  exact ⟨A ⧸ Ideal.span {g}, inferInstance, inferInstance,
    ⟨(AlgEquiv.prodQuotientOfIsIdempotentElem R hg.one_sub hg (sub_add_cancel 1 g) hmul).trans
      (iso.prodCongr AlgEquiv.refl)⟩⟩

/-- `Localization.awayMap φ f` is compatible with the maps from `R` and `S`. -/
private theorem awayMap_algebraMap_apply (R S : Type) [CommRing R] [CommRing S] [Algebra R S]
    (f r : R) :
    Localization.awayMap (algebraMap R S) f (algebraMap R (Localization.Away f) r) =
      algebraMap S (Localization.Away (algebraMap R S f)) (algebraMap R S r) := by
  rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq]

/-- Let `σ : S_f → R_f` be a retraction of `ν_f`, let `f₁ : R`, and let `I'` be the image of
`ker σ` in the localization `(S_f)_{sf}` away from `sf := ι_f^S (φ f₁)`. If `I' ≤ I' * I'`, then
`ν_{f·f₁}` has a retraction `σ' : S_{f·f₁} → R_{f·f₁}` with `ker σ' ≤ ker σ' * ker σ'`. -/
theorem exists_localizedRetraction_of_ker_le_sq (R S : Type) [CommRing R] [CommRing S] [Algebra R S]
    (f f₁ : R)
    (σ :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      Localization.Away (algebraMap R S f) →+* Localization.Away f)
    (hsec :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
        RingHom.id (Localization.Away f))
    (hsq :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      let sf := algebraMap S (Localization.Away (algebraMap R S f)) (algebraMap R S f₁)
      (Ideal.map (algebraMap (Localization.Away (algebraMap R S f)) (Localization.Away sf))
          (RingHom.ker σ)) ≤
        (Ideal.map (algebraMap (Localization.Away (algebraMap R S f)) (Localization.Away sf))
            (RingHom.ker σ)) *
          (Ideal.map (algebraMap (Localization.Away (algebraMap R S f)) (Localization.Away sf))
            (RingHom.ker σ))) :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
      (Localization.awayMap (algebraMap R S) f).toAlgebra
      letI : Algebra (Localization.Away (f * f₁)) (Localization.Away (algebraMap R S (f * f₁))) :=
      (Localization.awayMap (algebraMap R S) (f * f₁)).toAlgebra
      ∃ σ' : Localization.Away (algebraMap R S (f * f₁)) →+* Localization.Away (f * f₁),
      σ'.comp
            (algebraMap (Localization.Away (f * f₁))
              (Localization.Away (algebraMap R S (f * f₁)))) =
          RingHom.id (Localization.Away (f * f₁)) ∧
        (RingHom.ker σ') ≤ (RingHom.ker σ') * (RingHom.ker σ') := by
  let : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
    (Localization.awayMap (algebraMap R S) f).toAlgebra
  let : Algebra (Localization.Away (f * f₁)) (Localization.Away (algebraMap R S (f * f₁))) :=
    (Localization.awayMap (algebraMap R S) (f * f₁)).toAlgebra
  set Rf := Localization.Away f with hRf
  set Sf := Localization.Away (algebraMap R S f) with hSf
  set ν : Rf →+* Sf := algebraMap Rf Sf with hνdef
  set sf : Sf := algebraMap S Sf (algebraMap R S f₁) with hsf
  have hsq_r : ∀ r : R, ν (algebraMap R Rf r) = algebraMap S Sf (algebraMap R S r) := by
    intro r; exact awayMap_algebraMap_apply R S f r
  have hσR : ∀ r : R, σ (algebraMap R Sf r) = algebraMap R Rf r := by
    intro r
    rw [IsScalarTower.algebraMap_apply R S Sf r, ← hsq_r r]
    simpa using RingHom.congr_fun hsec (algebraMap R Rf r)
  have hσsf : σ sf = algebraMap R Rf f₁ := by
    rw [hsf, ← IsScalarTower.algebraMap_apply R S Sf f₁]; exact hσR f₁
  set A := Localization.Away (algebraMap R S (f * f₁)) with hA
  set B := Localization.Away (f * f₁) with hB
  set B' := Localization.Away (algebraMap R Rf f₁) with hB'
  set A' := Localization.Away sf with hA'
  have instB : IsLocalization.Away (σ sf) B' := by
    rw [hσsf]; infer_instance
  set τ : A' →+* B' := IsLocalization.Away.map A' B' σ sf with hτ
  have heqφ : algebraMap R S (f * f₁) = algebraMap R S f * algebraMap R S f₁ := map_mul _ _ _
  let : IsLocalization (Submonoid.powers (algebraMap R S (f * f₁))) A' := by
    rw [heqφ]; infer_instance
  set eA := (IsLocalization.algEquiv (Submonoid.powers (algebraMap R S (f * f₁))) A A') with heAdef
  let : IsLocalization (Submonoid.powers (f * f₁)) B' := inferInstance
  set eB := (IsLocalization.algEquiv (Submonoid.powers (f * f₁)) B' B) with heBdef
  set eA' : A →+* A' := (eA.toRingEquiv : A →+* A') with heA'def
  set eB' : B' →+* B := (eB.toRingEquiv : B' →+* B) with heB'def
  have hτmap : ∀ x : Sf, τ (algebraMap Sf A' x) = algebraMap Rf B' (σ x) := by
    intro x; rw [hτ, IsLocalization.Away.map, IsLocalization.map_eq]
  have heA_r : ∀ r : R, eA' (algebraMap R A r) = algebraMap R A' r := by
    intro r
    rw [heA'def]
    show eA (algebraMap R A r) = algebraMap R A' r
    rw [IsScalarTower.algebraMap_apply R S A r]
    rw [show eA (algebraMap S A (algebraMap R S r)) = algebraMap S A' (algebraMap R S r) from
        eA.commutes _]
    rw [← IsScalarTower.algebraMap_apply R S A' r]
  have heB_r : ∀ r : R, eB' (algebraMap R B' r) = algebraMap R B r := by
    intro r
    rw [heB'def]; change eB (algebraMap R B' r) = algebraMap R B r
    exact eB.commutes r
  have hτ_r : ∀ r : R, τ (algebraMap R A' r) = algebraMap R B' r := by
    intro r
    rw [IsScalarTower.algebraMap_apply R Sf A' r, hτmap]
    rw [hσR r, ← IsScalarTower.algebraMap_apply R Rf B' r]
  refine ⟨eB'.comp (τ.comp eA'), ?_, ?_⟩
  · apply IsLocalization.ringHom_ext (Submonoid.powers (f * f₁))
    ext r
    rw [RingHom.comp_apply, RingHom.comp_apply]
    change
      eB'
          (τ
            (eA'
              ((algebraMap (Localization.Away (f * f₁))
                  (Localization.Away (algebraMap R S (f * f₁))))
                (algebraMap R B r)))) =
        _
    have hν' : (algebraMap B A) (algebraMap R B r) = algebraMap R A r := by
      exact awayMap_algebraMap_apply R S (f * f₁) r
    rw [hν', heA_r, hτ_r, heB_r, RingHom.comp_apply, RingHom.id_apply]
  · have hkerτ : RingHom.ker τ = Ideal.map (algebraMap Sf A') (RingHom.ker σ) := by
      have hT : Submonoid.map σ (Submonoid.powers sf) = Submonoid.powers (σ sf) :=
        Submonoid.map_powers σ sf
      rw [hτ]
      exact IsLocalization.ker_map B' σ hT
    have hsq' : RingHom.ker τ ≤ RingHom.ker τ * RingHom.ker τ := by
      rw [hkerτ]; exact hsq
    have hkerEB : RingHom.ker eB' = (⊥ : Ideal B') := by
      rw [heB'def]
      exact
        (RingHom.ker_eq_bot_iff_eq_zero _).mpr
          (fun x hx => by
            have :=
              eB.toRingEquiv.injective (show eB.toRingEquiv x = eB.toRingEquiv 0 by simpa using hx)
            simpa using this)
    have hkerσ' :
      RingHom.ker (eB'.comp (τ.comp eA')) = Ideal.map eA.toRingEquiv.symm (RingHom.ker τ) := by
      rw [← RingHom.comap_ker, hkerEB, ← RingHom.ker_eq_comap_bot, ← RingHom.comap_ker, heA'def,
        Ideal.comap_coe, ← Ideal.map_symm eA.toRingEquiv]
    rw [hkerσ']
    calc
      Ideal.map eA.toRingEquiv.symm (RingHom.ker τ) ≤
          Ideal.map eA.toRingEquiv.symm (RingHom.ker τ * RingHom.ker τ) :=
        Ideal.map_mono hsq'
      _ =
          Ideal.map eA.toRingEquiv.symm (RingHom.ker τ) *
            Ideal.map eA.toRingEquiv.symm (RingHom.ker τ) :=
        Ideal.map_mul _ _ _

/-- Let `σ : S_f → R_f` be a retraction of `ν_f` whose kernel is finitely generated and annihilated
by the image of some `t ∈ S ∖ q`. Then there are `f₁ ∉ p` and a retraction
`σ' : S_{f·f₁} → R_{f·f₁}` of `ν_{f·f₁}` with `ker σ' ≤ ker σ' * ker σ'`. -/
theorem exists_factor_localizedRetraction_ker_le_sq (R S : Type) [CommRing R] [CommRing S] [Algebra
  R S]
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S))
    [Algebra.FinitePresentation R S] (f : R) (hf : f ∉ p)
    (σ :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      Localization.Away (algebraMap R S f) →+* Localization.Away f)
    (hsec :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
        RingHom.id (Localization.Away f))
    (hfg : (RingHom.ker σ).FG) (t : S) (ht : t ∉ q)
    (hann : ∀ x ∈ RingHom.ker σ, (algebraMap S (Localization.Away (algebraMap R S f)) t) * x = 0) :
    ∃ f₁ : R,
      f₁ ∉ p ∧
        letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
          (Localization.awayMap (algebraMap R S) f).toAlgebra
        letI :
          Algebra (Localization.Away (f * f₁)) (Localization.Away (algebraMap R S (f * f₁))) :=
          (Localization.awayMap (algebraMap R S) (f * f₁)).toAlgebra
        ∃ σ' : Localization.Away (algebraMap R S (f * f₁)) →+* Localization.Away (f * f₁),
          σ'.comp
                (algebraMap (Localization.Away (f * f₁))
                  (Localization.Away (algebraMap R S (f * f₁)))) =
              RingHom.id (Localization.Away (f * f₁)) ∧
            (RingHom.ker σ') ≤ (RingHom.ker σ') * (RingHom.ker σ') := by
  obtain ⟨f₁, hf₁, hsq⟩ := exists_notMem_map_ker_le_mul_self R S p q hpq f hf σ hsec hfg t ht hann
  exact ⟨f₁, hf₁, exists_localizedRetraction_of_ker_le_sq R S f f₁ σ hsec hsq⟩

/-- Let `σ : S_f → R_f` be a retraction of `ν_f` whose kernel is finitely generated and annihilated
by the image of some `t ∈ S ∖ q`. Then there are `f' ∉ p` and a retraction `σ' : S_{f'} → R_{f'}`
of `ν_{f'}` with `ker σ' ≤ ker σ' * ker σ'`. -/
theorem exists_retraction_ker_le_ker_mul_self (R S : Type) [CommRing R] [CommRing S] [Algebra R S]
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S))
    [Algebra.FinitePresentation R S] (f : R) (hf : f ∉ p)
    (σ :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      Localization.Away (algebraMap R S f) →+* Localization.Away f)
    (hsec :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
        RingHom.id (Localization.Away f))
    (hfg : (RingHom.ker σ).FG) (t : S) (ht : t ∉ q)
    (hann : ∀ x ∈ RingHom.ker σ, (algebraMap S (Localization.Away (algebraMap R S f)) t) * x = 0) :
    ∃ f' : R,
      f' ∉ p ∧
        letI : Algebra (Localization.Away f') (Localization.Away (algebraMap R S f')) :=
          (Localization.awayMap (algebraMap R S) f').toAlgebra
        ∃ σ' : Localization.Away (algebraMap R S f') →+* Localization.Away f',
          σ'.comp (algebraMap (Localization.Away f') (Localization.Away (algebraMap R S f'))) =
              RingHom.id (Localization.Away f') ∧
            (RingHom.ker σ') ≤ (RingHom.ker σ') * (RingHom.ker σ') := by
  obtain ⟨f₁, hf₁, hrest⟩ := exists_factor_localizedRetraction_ker_le_sq R S p q hpq f hf σ hsec hfg
    t ht hann
  refine ⟨f * f₁, ?_, hrest⟩
  intro hmem
  rcases Ideal.IsPrime.mem_or_mem ‹p.IsPrime› hmem with h | h
  · exact hf h
  · exact hf₁ h

/-- Let `σ : S_f → R_f` be a retraction of `ν_f` whose kernel is finitely generated and annihilated
by the image of some `t ∈ S ∖ q`. Then there are `f' ∉ p` and a retraction `σ' : S_{f'} → R_{f'}`
of `ν_{f'}` whose kernel is idempotent. -/
theorem exists_retraction_isIdempotentElem_ker (R S : Type) [CommRing R] [CommRing S] [Algebra R S]
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S))
    [Algebra.FinitePresentation R S] (f : R) (hf : f ∉ p)
    (σ :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      Localization.Away (algebraMap R S f) →+* Localization.Away f)
    (hsec :
      letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
        (Localization.awayMap (algebraMap R S) f).toAlgebra
      σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
        RingHom.id (Localization.Away f))
    (hfg : (RingHom.ker σ).FG) (t : S) (ht : t ∉ q)
    (hann : ∀ x ∈ RingHom.ker σ, (algebraMap S (Localization.Away (algebraMap R S f)) t) * x = 0) :
    ∃ f' : R,
      f' ∉ p ∧
        letI : Algebra (Localization.Away f') (Localization.Away (algebraMap R S f')) :=
          (Localization.awayMap (algebraMap R S) f').toAlgebra
        ∃ σ' : Localization.Away (algebraMap R S f') →+* Localization.Away f',
          σ'.comp (algebraMap (Localization.Away f') (Localization.Away (algebraMap R S f'))) =
              RingHom.id (Localization.Away f') ∧
            IsIdempotentElem (RingHom.ker σ') := by
  obtain ⟨f', hf', σ', hsec', hle⟩ :=
    exists_retraction_ker_le_ker_mul_self R S p q hpq f hf σ hsec hfg t ht hann
  exact ⟨f', hf', σ', hsec', isIdempotentElem_of_le_mul_self _ hle⟩

/-- From the spread-out retraction, an enlargement `f'` of `f` with `f' ∉ p` carrying a
retraction whose kernel is idempotent. -/
theorem exists_retraction_isIdempotentElem_ker_of_fg_ker (R S : Type) [CommRing R] [CommRing S]
  [Algebra R S]
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S))
    [Algebra.FinitePresentation R S]
    (hspread :
      ∃ f : R,
        f ∉ p ∧
          letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
            (Localization.awayMap (algebraMap R S) f).toAlgebra
          ∃ σ : Localization.Away (algebraMap R S f) →+* Localization.Away f,
            (σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
                RingHom.id (Localization.Away f)) ∧
              (RingHom.ker σ).FG ∧
              (∃ t : S,
                t ∉ q ∧
                  ∀ x ∈ RingHom.ker σ,
                    (algebraMap S (Localization.Away (algebraMap R S f)) t) * x = 0)) :
    ∃ f : R,
      f ∉ p ∧
        letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
          (Localization.awayMap (algebraMap R S) f).toAlgebra
        ∃ σ : Localization.Away (algebraMap R S f) →+* Localization.Away f,
          σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
              RingHom.id (Localization.Away f) ∧
            IsIdempotentElem (RingHom.ker σ) := by
  obtain ⟨f, hf, σ, hsec, hfg, t, ht, hann⟩ := hspread
  exact exists_retraction_isIdempotentElem_ker R S p q hpq f hf σ hsec hfg t ht hann

/-- Assembling the spread-out retraction with the enlargement: there is an `f ∉ p` and a
retraction of `S_f → R_f` with idempotent kernel. -/
theorem exists_retraction_isIdempotentElem_ker_of_localRingHom_bijective (R S : Type) [CommRing R]
  [CommRing S] [Algebra R S] (p : Ideal R)
    [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S))
    [Algebra.FinitePresentation R S]
    (hiso : Function.Bijective (Localization.localRingHom p q (algebraMap R S) hpq)) :
    ∃ f : R,
      f ∉ p ∧
        letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
          (Localization.awayMap (algebraMap R S) f).toAlgebra
        ∃ σ : Localization.Away (algebraMap R S f) →+* Localization.Away f,
          σ.comp (algebraMap (Localization.Away f) (Localization.Away (algebraMap R S f))) =
              RingHom.id (Localization.Away f) ∧
            IsIdempotentElem (RingHom.ker σ) := by
  exact exists_retraction_isIdempotentElem_ker_of_fg_ker R S p q hpq
    (exists_retraction_away_of_bijective_localRingHom R S p q hpq hiso)

/-- Under the hypotheses of `exists_away_prod_of_localRingHom_bijective`, there are `f ∉ p` and an
idempotent `g` in `S_f := Localization.Away (φ f)`, with its `R_f`-algebra structure induced by
`Localization.awayMap φ f`, such that `S_f ⧸ (1 - g) ≃ₐ[R_f] R_f`. -/
theorem exists_idempotent_quotient_algEquiv_away (R S : Type) [CommRing R] [CommRing S] [Algebra R
  S] (p : Ideal R)
    [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S))
    [Algebra.FinitePresentation R S]
    (hiso : Function.Bijective (Localization.localRingHom p q (algebraMap R S) hpq)) :
    ∃ f : R,
      f ∉ p ∧
        letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
          (Localization.awayMap (algebraMap R S) f).toAlgebra
        ∃ g : Localization.Away (algebraMap R S f),
          IsIdempotentElem g ∧
            Nonempty
              ((Localization.Away (algebraMap R S f) ⧸ Ideal.span {1 - g}) ≃ₐ[Localization.Away f]
                Localization.Away f) := by
  classical
  have hanalytic := exists_retraction_isIdempotentElem_ker_of_localRingHom_bijective R S p q hpq
    hiso
  obtain ⟨f, hf, σ, hsec, hidem⟩ := hanalytic
  refine ⟨f, hf, ?_⟩
  let : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
    (Localization.awayMap (algebraMap R S) f).toAlgebra
  have hst : IsScalarTower R (Localization.Away f) (Localization.Away (algebraMap R S f)) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    exact (awayMap_algebraMap_apply R S f x).symm
  have hSfR : Algebra.FinitePresentation R (Localization.Away (algebraMap R S f)) :=
    instFinitePresentationAway (algebraMap R S f)
  have hRfFT : Algebra.FiniteType R (Localization.Away f) := by
    have : Algebra.FinitePresentation R (Localization.Away f) :=
      IsLocalization.Away.finitePresentation f
    infer_instance
  have hfp :
    Algebra.FinitePresentation (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation (R := R)
      (Localization.Away f) (Localization.Away (algebraMap R S f))
  set Rf := Localization.Away f
  set Sf := Localization.Away (algebraMap R S f)
  have hsurj : Function.Surjective σ := fun x =>
    ⟨algebraMap Rf Sf x, by simpa using RingHom.congr_fun hsec x⟩
  have hcomm : ∀ r : Rf, σ (algebraMap Rf Sf r) = algebraMap Rf Rf r := by
    intro r; simpa using RingHom.congr_fun hsec r
  let σa : Sf →ₐ[Rf] Rf := { σ with commutes' := hcomm }
  have hsurja : Function.Surjective σa := hsurj
  have hkereq : RingHom.ker σa.toRingHom = RingHom.ker σ := rfl
  have hker_fg : (RingHom.ker σa.toRingHom).FG :=
    Algebra.FinitePresentation.ker_fG_of_surjective σa hsurja
  have hfg : (RingHom.ker σ).FG := hkereq ▸ hker_fg
  obtain ⟨e, he_idem, hIe⟩ := (Ideal.isIdempotentElem_iff_of_fg (RingHom.ker σ) hfg).mp hidem
  refine ⟨1 - e, he_idem.one_sub, ⟨?_⟩⟩
  have h1g : (1 : Sf) - (1 - e) = e := by ring
  have hspan : Ideal.span {(1 : Sf) - (1 - e)} = RingHom.ker σ := by rw [h1g, hIe]
  have e2 : (Sf ⧸ RingHom.ker σ) ≃ₐ[Rf] Rf := by
    have hkeq : RingHom.ker σa = RingHom.ker σ := rfl
    exact hkeq ▸ Ideal.quotientKerAlgEquivOfSurjective (f := σa) hsurja
  exact (Ideal.quotientEquivAlgOfEq Rf hspan).trans e2

/-- Let `φ : R → S` be a ring map of commutative rings, and let `q ⊆ S` be a prime ideal lying over
the prime `p ⊆ R` (i.e. `p = q.comap φ`). Assume `S` is of finite presentation over `R`, and that
the induced map on localizations `φ_p : R_p → S_q` (`Localization.localRingHom`) is bijective.
Then there exist `f : R` with `f ∉ p` and an `R_f`-algebra `C` such that `S_f ≅ R_f × C` as
`R_f`-algebras, where `S_f := Localization.Away (φ f)` is given the `R_f`-algebra structure
induced by `Localization.awayMap φ f`. -/
@[stacks 00QR]
theorem exists_away_prod_of_localRingHom_bijective (R S : Type) [CommRing R] [CommRing S] [Algebra R
  S] (p : Ideal R) [p.IsPrime]
    (q : Ideal S) [q.IsPrime] (hpq : p = q.comap (algebraMap R S)) [Algebra.FinitePresentation R S]
    (hiso : Function.Bijective (Localization.localRingHom p q (algebraMap R S) hpq)) :
    ∃ f : R,
      f ∉ p ∧
        ∃ (C : Type) (_ : CommRing C) (_ : Algebra (Localization.Away f) C),
          letI : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
            (Localization.awayMap (algebraMap R S) f).toAlgebra
          Nonempty
            (Localization.Away (algebraMap R S f) ≃ₐ[Localization.Away f]
              (Localization.Away f × C)) := by
  obtain ⟨f, hf, g, hg, ⟨iso⟩⟩ := exists_idempotent_quotient_algEquiv_away R S p q hpq hiso
  let : Algebra (Localization.Away f) (Localization.Away (algebraMap R S f)) :=
    (Localization.awayMap (algebraMap R S) f).toAlgebra
  obtain ⟨C, hC, hCalg, ⟨e⟩⟩ :=
    exists_algEquiv_prod_of_isIdempotentElem (Localization.Away f) (Localization.Away (algebraMap R
      S f)) g hg iso
  exact ⟨f, hf, C, hC, hCalg, ⟨e⟩⟩
