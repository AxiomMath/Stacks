module

public import StacksFrontier.RingTheory.FinitePresentation.ColimitsII

/-!
# Flat models of finitely many algebra maps over a ring of finite type over `ℤ`

Let `A` be a ring, let `C` and `D` be flat `A`-algebras of finite presentation and let
`pₖ : C → D` be finitely many `A`-algebra maps. Then there are a ring `A₀` of finite type over
`ℤ` with a map `A₀ → A`, flat `A₀`-algebras `C₀` and `D₀` of finite type with `C = A ⊗_{A₀} C₀`
and `D = A ⊗_{A₀} D₀`, and `A₀`-algebra maps `qₖ : C₀ → D₀` whose base changes are the `pₖ`.

## Main results

* `Algebra.exists_isPushout_finiteType_of_subring_le`: a finite type model of an algebra over a
  subring `R₀ ⊆ A` can be moved to any larger subring.
* `Algebra.exists_flat_finiteType_model_algHom_family`: the flat model of a finite family of
  algebra maps.
* `Algebra.exists_flat_finiteType_model_algHom_pair`: the case of two maps.

## Implementation notes

The two algebras are first descended separately, by Stacks 00R1
(`Algebra.exists_subring_finiteType_int_isPushout_isBaseChange`), to subrings `R₀` and `R₀'` of
`A` of finite type over `ℤ`, and both models are then moved to the subring generated by
`R₀ ∪ R₀'`, so that the directed systems `Algebra.FiniteTypeSystem` of the two algebras share
their index set and their stages `R_λ`. The maps descend to a stage because a map out of a
finitely presented algebra into a directed colimit factors through a stage
(`AlgHom.exists_comp_eq_of_finitePresentation`); flatness holds at a stage by Stacks 02JO
(`Algebra.FiniteTypeSystem.exists_flat_stage_self`) and persists to the later stages by base
change.

## References

* [Stacks Project, Tag 00R1](https://stacks.math.columbia.edu/tag/00R1)
* [Stacks Project, Tag 02JO](https://stacks.math.columbia.edu/tag/02JO)
-/

@[expose] public section

universe u

open scoped TensorProduct

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- **A finite type model over a subring can be moved to a larger subring.** If `S = A ⊗_{R₀} S₀`
with `S₀` of finite type over the subring `R₀ ⊆ A`, then for every subring `R₂ ⊇ R₀` the algebra
`S` is likewise the base change of an `R₂`-algebra of finite type, namely `R₂ ⊗_{R₀} S₀`. -/
theorem Algebra.exists_isPushout_finiteType_of_subring_le {A S : Type u} [CommRing A]
    [CommRing S] [Algebra A S] {R₀ R₂ : Subring A} (h : R₀ ≤ R₂) (S₀ : Type u) [CommRing S₀]
    [Algebra R₀ S₀] [Algebra S₀ S] [IsScalarTower R₀ S₀ S] [Algebra.FiniteType R₀ S₀]
    [Algebra.IsPushout R₀ A S₀ S] :
    ∃ (S₂ : Type u) (_ : CommRing S₂) (_ : Algebra R₂ S₂) (_ : Algebra S₂ S)
      (_ : IsScalarTower R₂ S₂ S), Algebra.FiniteType R₂ S₂ ∧ Algebra.IsPushout R₂ A S₂ S := by
  let : Algebra R₀ R₂ := (Subring.inclusion h).toAlgebra
  have : IsScalarTower R₀ R₂ A := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R₀ R₂ S := IsScalarTower.of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply R₀ A S, IsScalarTower.algebraMap_apply R₀ R₂ A,
      ← IsScalarTower.algebraMap_apply R₂ A S]
  let φ : R₂ ⊗[R₀] S₀ →ₐ[R₀] S :=
    Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R₀ R₂ S)
      (IsScalarTower.toAlgHom R₀ S₀ S)
  let : Algebra (R₂ ⊗[R₀] S₀) S := φ.toRingHom.toAlgebra
  have : IsScalarTower R₂ (R₂ ⊗[R₀] S₀) S := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R₂ S r = φ (r ⊗ₜ 1)
    simp [φ]
  have : IsScalarTower R₀ (R₂ ⊗[R₀] S₀) S :=
    IsScalarTower.of_algebraMap_eq fun r => (φ.commutes r).symm
  have : IsScalarTower S₀ (R₂ ⊗[R₀] S₀) S := IsScalarTower.of_algebraMap_eq fun s => by
    change algebraMap S₀ S s = φ (1 ⊗ₜ s)
    simp [φ]
  exact ⟨R₂ ⊗[R₀] S₀, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, (Algebra.IsPushout.comp_iff R₀ R₂ S₀ (R₂ ⊗[R₀] S₀)).mp inferInstance⟩

namespace Algebra.FiniteTypeSystem

variable {A : Type u} [CommRing A] (R₁ : Subring A)

/-- A stage at which the model `S_λ` is flat stays flat at every later stage, the transition
squares being cartesian. -/
theorem flat_ring_of_le (S₁ : Type u) [CommRing S₁] [Algebra R₁ S₁] {i k : Index R₁} (hik : i ≤ k)
    [Module.Flat (Base R₁ i) (Ring R₁ S₁ i)] : Module.Flat (Base R₁ k) (Ring R₁ S₁ k) := by
  have : Fact (i ≤ k) := ⟨hik⟩
  exact Module.Flat.isBaseChange (Base R₁ i) (Base R₁ k) (Ring R₁ S₁ i) (Ring R₁ S₁ k)
    (ringMap_isPushout R₁ S₁ (i := i) (j := k)).out

end Algebra.FiniteTypeSystem

open Algebra.FiniteTypeSystem in
/-- **A flat model of finitely many algebra maps.** Let `C` and `D` be flat `A`-algebras of finite
presentation and let `p i : C → D` be a finite family of `A`-algebra maps. Then there are a ring
`A₀` of finite type over `ℤ` with a map `A₀ → A`, flat `A₀`-algebras of finite type `C₀` and `D₀`
with `C = A ⊗_{A₀} C₀` and `D = A ⊗_{A₀} D₀`, and `A₀`-algebra maps `q i : C₀ → D₀` inducing the
`p i`. -/
theorem Algebra.exists_flat_finiteType_model_algHom_family {A C D : Type u} [CommRing A]
    [CommRing C] [CommRing D] [Algebra A C] [Algebra A D] [Module.Flat A C] [Module.Flat A D]
    [Algebra.FinitePresentation A C] [Algebra.FinitePresentation A D] {ι : Type*} [Finite ι]
    (p : ι → (C →ₐ[A] D)) :
    ∃ (A₀ C₀ D₀ : Type u) (_ : CommRing A₀) (_ : CommRing C₀) (_ : CommRing D₀)
      (_ : Algebra A₀ A) (_ : Algebra A₀ C₀) (_ : Algebra A₀ D₀) (_ : Algebra C₀ C)
      (_ : Algebra D₀ D) (_ : Algebra A₀ C) (_ : Algebra A₀ D) (_ : IsScalarTower A₀ A C)
      (_ : IsScalarTower A₀ C₀ C) (_ : IsScalarTower A₀ A D) (_ : IsScalarTower A₀ D₀ D),
      Algebra.FiniteType ℤ A₀ ∧ Algebra.FiniteType A₀ C₀ ∧ Algebra.FiniteType A₀ D₀ ∧
        Module.Flat A₀ C₀ ∧ Module.Flat A₀ D₀ ∧
        Algebra.IsPushout A₀ A C₀ C ∧ Algebra.IsPushout A₀ A D₀ D ∧
        ∃ q : ι → (C₀ →ₐ[A₀] D₀), ∀ i, (IsScalarTower.toAlgHom A₀ D₀ D).comp (q i) =
          ((p i).restrictScalars A₀).comp (IsScalarTower.toAlgHom A₀ C₀ C) := by
  classical
  -- Stacks 00R1 for each algebra
  obtain ⟨R₀, S₀, -, _, _, _, _, -, -, -, -, -, hZ, hS₀, -, hpushS, -⟩ :=
    Algebra.exists_subring_finiteType_int_isPushout_isBaseChange (R := A) (S := C) C
  obtain ⟨R₀', T₀, -, _, _, _, _, -, -, -, -, -, hZ', hT₀, -, hpushT, -⟩ :=
    Algebra.exists_subring_finiteType_int_isPushout_isBaseChange (R := A) (S := D) D
  -- a common subring of finite type over `ℤ`
  let i₀ : Index R₀ := Classical.arbitrary _
  let i₀' : Index R₀' := Classical.arbitrary _
  let R₁ : Subring A := (i₀.1 ⊔ i₀'.1).toSubring
  have hR₀ : R₀ ≤ R₁ := fun _ hx => (le_sup_left : i₀.1 ≤ i₀.1 ⊔ i₀'.1) (i₀.2.1 hx)
  have hR₀' : R₀' ≤ R₁ := fun _ hx => (le_sup_right : i₀'.1 ≤ i₀.1 ⊔ i₀'.1) (i₀'.2.1 hx)
  have : Algebra.FiniteType ℤ R₁ :=
    finiteType_int_of_algebra _ _ ((Subalgebra.fg_iff_finiteType _).mp (i₀.2.2.sup i₀'.2.2))
  have : IsNoetherianRing R₁ := Algebra.FiniteType.isNoetherianRing ℤ _
  obtain ⟨S₁, _, _, _, _, hS₁, hpushS₁⟩ :=
    Algebra.exists_isPushout_finiteType_of_subring_le hR₀ S₀ (S := C)
  obtain ⟨T₁, _, _, _, _, hT₁, hpushT₁⟩ :=
    Algebra.exists_isPushout_finiteType_of_subring_le hR₀' T₀ (S := D)
  have : Algebra.FinitePresentation R₁ S₁ := Algebra.FinitePresentation.of_finiteType.mp hS₁
  -- flat stages
  obtain ⟨iC, hiC⟩ := exists_flat_stage_self R₁ S₁ (B := C)
  obtain ⟨iD, hiD⟩ := exists_flat_stage_self R₁ T₁ (B := D)
  -- the maps descend to stages
  have hdesc (m : ι) : ∃ (j : Index R₁) (ψ : S₁ →ₐ[R₁] Ring R₁ T₁ j),
      (ringToRing R₁ T₁ (S := D) j).comp ψ =
        ((p m).restrictScalars R₁).comp (IsScalarTower.toAlgHom R₁ S₁ C) :=
    AlgHom.exists_comp_eq_of_finitePresentation (fun _ _ h => ringMap R₁ T₁ h)
      (fun j => ringToRing R₁ T₁ (S := D) j) (fun _ _ h x => ring_cocone R₁ T₁ h x)
      (ring_colimit R₁ T₁).1
      (fun j x hx => by
        obtain ⟨k, h, hk⟩ := (ring_colimit R₁ T₁ (S := D)).2 j x 0 (by rw [hx, map_zero])
        exact ⟨k, h, by rw [hk, map_zero]⟩) _
  choose j ψ hψ using hdesc
  -- a common later stage
  have := Fintype.ofFinite ι
  obtain ⟨k, hk⟩ := (insert iC (insert iD (Finset.univ.image j))).exists_le
  have hCk : iC ≤ k := hk _ (Finset.mem_insert_self _ _)
  have hDk : iD ≤ k := hk _ (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
  have hjk (m : ι) : j m ≤ k := hk _ (Finset.mem_insert_of_mem
    (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ m))))
  have := flat_ring_of_le R₁ S₁ hCk
  have := flat_ring_of_le R₁ T₁ hDk
  let ψk (m : ι) : S₁ →ₐ[R₁] Ring R₁ T₁ k := (ringMap R₁ T₁ (hjk m)).comp (ψ m)
  have hψk (m : ι) : (ringToRing R₁ T₁ (S := D) k).comp (ψk m) =
      ((p m).restrictScalars R₁).comp (IsScalarTower.toAlgHom R₁ S₁ C) := by
    rw [← hψ m]
    ext x
    exact ring_cocone R₁ T₁ (hjk m) (ψ m x)
  let q (m : ι) : Ring R₁ S₁ k →ₐ[Base R₁ k] Ring R₁ T₁ k :=
    Algebra.TensorProduct.lift (Algebra.ofId (Base R₁ k) (Ring R₁ T₁ k)) (ψk m)
      (fun _ _ => Commute.all _ _)
  refine ⟨Base R₁ k, Ring R₁ S₁ k, Ring R₁ T₁ k, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, ringToRing_isPushout R₁ S₁ k,
    ringToRing_isPushout R₁ T₁ k, q, fun m => ?_⟩
  have : IsScalarTower R₁ (Base R₁ k) D := IsScalarTower.of_algebraMap_eq fun _ => rfl
  refine Algebra.TensorProduct.ext' fun a b => ?_
  have hb := AlgHom.congr_fun (hψk m) b
  simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, IsScalarTower.coe_toAlgHom',
    q, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_mul] at hb ⊢
  change algebraMap (Ring R₁ T₁ k) D (algebraMap (Base R₁ k) (Ring R₁ T₁ k) a) *
      ringToRing R₁ T₁ k (ψk m b) =
    p m (algebraMap (Base R₁ k) C a * algebraMap S₁ C b)
  rw [← IsScalarTower.algebraMap_apply, hb, map_mul, IsScalarTower.algebraMap_apply (Base R₁ k) A C,
    AlgHom.commutes, ← IsScalarTower.algebraMap_apply]

/-- **A flat model of a pair of algebra maps.** Let `C` and `D` be flat `A`-algebras of finite
presentation and let `p₁ p₂ : C → D` be `A`-algebra maps. Then there are a ring `A₀` of finite type
over `ℤ` with a map `A₀ → A`, flat `A₀`-algebras of finite type `C₀` and `D₀` with
`C = A ⊗_{A₀} C₀` and `D = A ⊗_{A₀} D₀`, and `A₀`-algebra maps `q₁ q₂ : C₀ → D₀` inducing `p₁` and
`p₂`. -/
theorem Algebra.exists_flat_finiteType_model_algHom_pair {A C D : Type u} [CommRing A]
    [CommRing C] [CommRing D] [Algebra A C] [Algebra A D] [Module.Flat A C] [Module.Flat A D]
    [Algebra.FinitePresentation A C] [Algebra.FinitePresentation A D] (p₁ p₂ : C →ₐ[A] D) :
    ∃ (A₀ C₀ D₀ : Type u) (_ : CommRing A₀) (_ : CommRing C₀) (_ : CommRing D₀)
      (_ : Algebra A₀ A) (_ : Algebra A₀ C₀) (_ : Algebra A₀ D₀) (_ : Algebra C₀ C)
      (_ : Algebra D₀ D) (_ : Algebra A₀ C) (_ : Algebra A₀ D) (_ : IsScalarTower A₀ A C)
      (_ : IsScalarTower A₀ C₀ C) (_ : IsScalarTower A₀ A D) (_ : IsScalarTower A₀ D₀ D),
      Algebra.FiniteType ℤ A₀ ∧ Algebra.FiniteType A₀ C₀ ∧ Algebra.FiniteType A₀ D₀ ∧
        Module.Flat A₀ C₀ ∧ Module.Flat A₀ D₀ ∧
        Algebra.IsPushout A₀ A C₀ C ∧ Algebra.IsPushout A₀ A D₀ D ∧
        ∃ q₁ q₂ : C₀ →ₐ[A₀] D₀,
          (IsScalarTower.toAlgHom A₀ D₀ D).comp q₁ =
            (p₁.restrictScalars A₀).comp (IsScalarTower.toAlgHom A₀ C₀ C) ∧
          (IsScalarTower.toAlgHom A₀ D₀ D).comp q₂ =
            (p₂.restrictScalars A₀).comp (IsScalarTower.toAlgHom A₀ C₀ C) := by
  obtain ⟨A₀, C₀, D₀, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hA₀, hC₀, hD₀, hfC, hfD, hpC, hpD,
    q, hq⟩ := Algebra.exists_flat_finiteType_model_algHom_family (A := A) (C := C) (D := D)
      ![p₁, p₂]
  exact ⟨A₀, C₀, D₀, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hA₀, hC₀, hD₀, hfC, hfD, hpC, hpD,
    q 0, q 1, hq 0, hq 1⟩
