/-!
# Syzygies of a presentation over a coefficient algebra of finite type

Let `B = C[x_1, …, x_n]/(f_1, …, f_m)` be a presentation of a `C`-algebra, let `D` be a
`C`-algebra, and let `a_{kj} ∈ D[x_1, …, x_n]` for `k = 1, …, K` be finitely many syzygies
`∑_j a_{kj} f_j = 0` among the images of the `f_j` in `D[x_1, …, x_n]`, say generating the module
of all such syzygies, so that

  `D[x_1, …, x_n]^{⊕K} → D[x_1, …, x_n]^{⊕m} → D[x_1, …, x_n] → B ⊗_C D → 0`

is exact. Adjoining to `C` the finitely many coefficients of the `a_{kj}` produces a `C`-algebra
`C'` of finite type, equipped with a `C`-algebra map `C' → D` and with polynomials
`t_{kj} ∈ C'[x_1, …, x_n]` satisfying `∑_j t_{kj} f_j = 0` and mapping to the `a_{kj}`. Hence
there is a four-term complex

  `C'[x_1, …, x_n]^{⊕K} → C'[x_1, …, x_n]^{⊕m} → C'[x_1, …, x_n] → B ⊗_C C' → 0`

which is exact at `C'[x_1, …, x_n]` and at `B ⊗_C C'`, and whose base change along `C' → D` is
the displayed complex over `D[x_1, …, x_n]`.

## Main results

* `Stacks.SyzygyCoefficients.exact_resolution`: the displayed complex over `D[x_1, …, x_n]` is
  exact.
* `Stacks.SyzygyCoefficients.exists_exact_resolution`: such a complex exists when `D` is
  Noetherian, since then the module of relations among the images of the `f_j` is finitely
  generated.
* `Stacks.SyzygyCoefficients.exists_finiteType_resolution`: the complex over a coefficient
  algebra of finite type, together with its specialization to the given one.

## Implementation notes

The two matrices of the complex are given by their entries: the `t_{kj}` for the first map and
the relations of the base-changed presentation for the second. The last map is the evaluation map
of the base-changed presentation `P.baseChange C'`, with target the tensor product `C' ⊗[C] B`;
exactness at `C'[x_1, …, x_n]` says that the ideal generated by the relations is its kernel, and
exactness at the tensor product is its surjectivity. The syzygy equations make the first
composite zero, and applying `C' → D` to both matrices recovers the given data.

`C'` is produced in the universe of `C` rather than that of `D`: the subalgebra of `D` generated
by the coefficients is of finite type over `C`, hence small relative to `C`, and `Shrink`
transports it to the universe of `C`.

That the `a_{kj}` generate every syzygy is what makes the complex over `D[x_1, …, x_n]` exact at
`D[x_1, …, x_n]^{⊕m}`; the construction of `C'` and of the `t_{kj}` only uses that the `a_{kj}`
are syzygies.

## References

* [Stacks Project, Tag 0CAZ](https://stacks.math.columbia.edu/tag/0CAZ)
* [Stacks Project, Tag 0CB0](https://stacks.math.columbia.edu/tag/0CB0)
-/

@[expose] public section

open MvPolynomial TensorProduct

universe u v w

namespace Stacks.SyzygyCoefficients

/-- The map `D[x_1, …, x_n]^{⊕m} → D[x_1, …, x_n]`, `v ↦ ∑_j v_j f_j`, combining the images in
`D[x_1, …, x_n]` of the relations of a presentation `P` of `B` over `C`. -/
noncomputable def relationMap {C : Type u} {B : Type v} (D : Type w)
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D] {n m : ℕ}
    (P : Algebra.Presentation C B (Fin n) (Fin m)) :
    (Fin m → MvPolynomial (Fin n) D) →ₗ[MvPolynomial (Fin n) D] MvPolynomial (Fin n) D :=
  Fintype.linearCombination (MvPolynomial (Fin n) D)
    fun j => MvPolynomial.map (algebraMap C D) (P.relation j)

/-- `relationMap D P v = ∑_j v_j f_j`, with `f_j` the image in `D[x_1, …, x_n]` of the `j`-th
relation of `P`. -/
@[simp]
theorem relationMap_apply {C : Type u} {B : Type v} (D : Type w)
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D] {n m : ℕ}
    (P : Algebra.Presentation C B (Fin n) (Fin m)) (v : Fin m → MvPolynomial (Fin n) D) :
    relationMap D P v = ∑ j, v j * MvPolynomial.map (algebraMap C D) (P.relation j) := by
  simp [relationMap, Fintype.linearCombination_apply, smul_eq_mul]

/-- The map `D[x_1, …, x_n]^{⊕K} → D[x_1, …, x_n]^{⊕m}` given by a matrix `a`, sending `w` to
the vector with `j`-th entry `∑_k w_k a_{kj}`. -/
noncomputable def syzygyMap {D : Type w} [CommRing D] {n m K : ℕ}
    (a : Fin K → Fin m → MvPolynomial (Fin n) D) :
    (Fin K → MvPolynomial (Fin n) D) →ₗ[MvPolynomial (Fin n) D]
      (Fin m → MvPolynomial (Fin n) D) :=
  LinearMap.pi fun j => Fintype.linearCombination (MvPolynomial (Fin n) D) fun k => a k j

/-- The `j`-th entry of `syzygyMap a w` is `∑_k w_k a_{kj}`. -/
@[simp]
theorem syzygyMap_apply {D : Type w} [CommRing D] {n m K : ℕ}
    (a : Fin K → Fin m → MvPolynomial (Fin n) D) (w : Fin K → MvPolynomial (Fin n) D)
    (j : Fin m) : syzygyMap a w j = ∑ k, w k * a k j := by
  simp [syzygyMap, Fintype.linearCombination_apply, smul_eq_mul]

/-- The image of `relationMap` is the kernel of the evaluation map
`D[x_1, …, x_n] → B ⊗_C D`, so the cokernel of `relationMap` is `B ⊗_C D`. -/
theorem range_relationMap_eq_ker {C : Type u} {B : Type v} (D : Type w)
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D] {n m : ℕ}
    (P : Algebra.Presentation C B (Fin n) (Fin m)) :
    LinearMap.range (relationMap D P) =
      RingHom.ker (aeval (R := D) (S₁ := D ⊗[C] B) (P.baseChange D).val) := by
  refine Eq.trans ?_ (P.span_range_relation_eq_ker_baseChange D)
  ext y
  simp only [LinearMap.mem_range, relationMap_apply, Ideal.mem_span_range_iff_exists_fun]

/-- The cokernel of `relationMap` is `B ⊗_C D`, the last two terms of the four-term complex. -/
noncomputable def quotRangeRelationMapEquiv {C : Type u} {B : Type v} (D : Type w)
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D] {n m : ℕ}
    (P : Algebra.Presentation C B (Fin n) (Fin m)) :
    (MvPolynomial (Fin n) D ⧸ LinearMap.range (relationMap D P)) ≃ₐ[D] D ⊗[C] B :=
  (Ideal.quotientEquivAlgOfEq D (range_relationMap_eq_ker D P)).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (f := aeval (R := D) (S₁ := D ⊗[C] B) (P.baseChange D).val)
      (P.baseChange D).algebraMap_surjective)

/-- Let `P` present `B` as `C[x_1, …, x_n]/(f_1, …, f_m)`, let `σ : C → D` make `D` a
`C`-algebra and let `a_{kj} ∈ D[x_1, …, x_n]`, `k = 1, …, K`, generate the module of relations
among the `σ(f_j)`. Then `D[x]^{⊕K} → D[x]^{⊕m} → D[x] → B ⊗_{C, σ} D → 0` is exact. -/
@[stacks 0CAZ]
theorem exact_resolution
    {C : Type u} {B : Type v} {D : Type w}
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D]
    {n m K : ℕ} (P : Algebra.Presentation C B (Fin n) (Fin m))
    (a : Fin K → Fin m → MvPolynomial (Fin n) D)
    (ha : ∀ k, ∑ j, a k j * MvPolynomial.map (algebraMap C D) (P.relation j) = 0)
    (hgen : ∀ v : Fin m → MvPolynomial (Fin n) D,
      (∑ j, v j * MvPolynomial.map (algebraMap C D) (P.relation j) = 0) →
      ∃ w : Fin K → MvPolynomial (Fin n) D, ∀ j, v j = ∑ k, w k * a k j) :
    LinearMap.ker (relationMap D P) = LinearMap.range (syzygyMap a) ∧
      LinearMap.range (relationMap D P) =
        RingHom.ker (aeval (R := D) (S₁ := D ⊗[C] B) (P.baseChange D).val) ∧
      Function.Surjective (aeval (R := D) (S₁ := D ⊗[C] B) (P.baseChange D).val) := by
  refine ⟨?_, range_relationMap_eq_ker D P, (P.baseChange D).algebraMap_surjective⟩
  ext v
  simp only [LinearMap.mem_ker, relationMap_apply, LinearMap.mem_range]
  refine ⟨fun hv => (hgen v hv).imp fun w hw =>
    funext fun j => (syzygyMap_apply a w j).trans (hw j).symm, ?_⟩
  rintro ⟨w, rfl⟩
  simp only [syzygyMap_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun k _ => ?_
  simp only [mul_assoc, ← Finset.mul_sum, ha k, mul_zero]

/-- Over a Noetherian ring `D` the relations among the images of the `f_j` in `D[x_1, …, x_n]`
form a finitely generated module, so finitely many syzygies `a_{kj}` as in `exact_resolution`
exist. -/
theorem exists_exact_resolution {C : Type u} {B : Type v} (D : Type w)
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D] [IsNoetherianRing D]
    {n m : ℕ} (P : Algebra.Presentation C B (Fin n) (Fin m)) :
    ∃ (K : ℕ) (a : Fin K → Fin m → MvPolynomial (Fin n) D),
      (∀ k, ∑ j, a k j * MvPolynomial.map (algebraMap C D) (P.relation j) = 0) ∧
      LinearMap.ker (relationMap D P) = LinearMap.range (syzygyMap a) := by
  obtain ⟨K, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (LinearMap.ker (relationMap D P)))
  have key : ∀ w : Fin K → MvPolynomial (Fin n) D,
      syzygyMap s w = ∑ k, w k • s k := by
    intro w
    funext j
    rw [syzygyMap_apply, Finset.sum_apply]
    exact Finset.sum_congr rfl fun k _ => (smul_eq_mul _ _).symm
  refine ⟨K, s, fun k => ?_, ?_⟩
  · have hk : s k ∈ LinearMap.ker (relationMap D P) := by
      rw [← hs]
      exact Submodule.subset_span (Set.mem_range_self k)
    simpa only [LinearMap.mem_ker, relationMap_apply] using hk
  · rw [← hs]
    ext v
    rw [Submodule.mem_span_range_iff_exists_fun, LinearMap.mem_range]
    exact exists_congr fun w => by rw [key w]

/-- Let `P` present `B` as `C[x_1, …, x_n]/(f_1, …, f_m)`, let `D` be a `C`-algebra, and let
`a_{kj} ∈ D[x_1, …, x_n]`, `k = 1, …, K`, be syzygies `∑_j a_{kj} f_j = 0` generating all
syzygies among the images of the `f_j`. Then there are a `C`-algebra `C'` of finite type, a
`C`-algebra map `τ : C' → D` and polynomials `t_{kj} ∈ C'[x_1, …, x_n]` with `∑_j t_{kj} f_j = 0`,
such that `τ` carries the `t_{kj}` to the `a_{kj}` and the four-term complex over
`C'[x_1, …, x_n]` built from the `t_{kj}` and the `f_j` is exact at `C'[x_1, …, x_n]` and at
`B ⊗_C C'`. -/
@[stacks 0CB0]
theorem exists_finiteType_resolution
    {C : Type u} {B : Type v} {D : Type w}
    [CommRing C] [CommRing B] [CommRing D] [Algebra C B] [Algebra C D]
    {n m K : ℕ} (P : Algebra.Presentation C B (Fin n) (Fin m))
    (a : Fin K → Fin m → MvPolynomial (Fin n) D)
    (ha : ∀ k, ∑ j, a k j * MvPolynomial.map (algebraMap C D) (P.relation j) = 0)
    (_hgen : ∀ v : Fin m → MvPolynomial (Fin n) D,
      (∑ j, v j * MvPolynomial.map (algebraMap C D) (P.relation j) = 0) →
      ∃ w : Fin K → MvPolynomial (Fin n) D, ∀ j, v j = ∑ k, w k * a k j) :
    ∃ (C' : Type u) (_ : CommRing C') (_ : Algebra C C') (_ : Algebra.FiniteType C C')
      (τ : C' →ₐ[C] D) (t : Fin K → Fin m → MvPolynomial (Fin n) C'),
      (∀ k, ∑ j, t k j * MvPolynomial.map (algebraMap C C') (P.relation j) = 0) ∧
      (∀ k j, MvPolynomial.map (τ : C' →+* D) (t k j) = a k j) ∧
      (∀ j, MvPolynomial.map (τ : C' →+* D)
        (MvPolynomial.map (algebraMap C C') (P.relation j)) =
        MvPolynomial.map (algebraMap C D) (P.relation j)) ∧
      Ideal.span (Set.range fun j : Fin m =>
          MvPolynomial.map (algebraMap C C') (P.relation j)) =
        RingHom.ker (aeval (R := C') (S₁ := C' ⊗[C] B) (P.baseChange C').val) ∧
      Function.Surjective (aeval (R := C') (S₁ := C' ⊗[C] B) (P.baseChange C').val) := by
  classical
  let cs : Finset D :=
    Finset.univ.biUnion fun k => Finset.univ.biUnion fun j => (a k j).coeffs
  let S : Subalgebra C D := Algebra.adjoin C (cs : Set D)
  have hcoeffs : ∀ (k : Fin K) (j : Fin m),
      ((a k j).coeffs : Set D) ⊆ Set.range (S.val : S →+* D) :=
    fun k j x hx => ⟨⟨x, Algebra.subset_adjoin <| Finset.mem_coe.mpr <| Finset.mem_biUnion.mpr
      ⟨k, Finset.mem_univ k, Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, hx⟩⟩⟩, rfl⟩
  choose q hq using fun (k : Fin K) (j : Fin m) =>
    MvPolynomial.mem_range_map_iff_coeffs_subset.mpr (hcoeffs k j)
  have : Algebra.FiniteType C S := Algebra.FiniteType.adjoin_of_finite cs.finite_toSet
  have : Small.{u} S := Algebra.FiniteType.small (R := C) (S := S)
  set e : Shrink.{u} S ≃ₐ[C] S := Shrink.algEquiv C S
  set τ : Shrink.{u} S →ₐ[C] D := S.val.comp e.toAlgHom with hτ
  have hcomp : (τ : Shrink.{u} S →+* D).comp e.symm.toRingHom = (S.val : S →+* D) :=
    RingHom.ext fun x => by simp [hτ]
  have hτt : ∀ (k : Fin K) (j : Fin m), MvPolynomial.map (τ : Shrink.{u} S →+* D)
      (MvPolynomial.map e.symm.toRingHom (q k j)) = a k j := fun k j => by
    rw [MvPolynomial.map_map, hcomp, hq]
  have hrel : ∀ j : Fin m, MvPolynomial.map (τ : Shrink.{u} S →+* D)
      (MvPolynomial.map (algebraMap C (Shrink.{u} S)) (P.relation j)) =
      MvPolynomial.map (algebraMap C D) (P.relation j) := fun j => by
    rw [MvPolynomial.map_map, τ.comp_algebraMap]
  refine ⟨Shrink.{u} S, inferInstance, inferInstance,
    Algebra.FiniteType.of_surjective e.symm.toAlgHom e.symm.surjective, τ,
    fun k j => MvPolynomial.map e.symm.toRingHom (q k j), fun k => ?_, hτt, hrel,
    P.span_range_relation_eq_ker_baseChange _, (P.baseChange _).algebraMap_surjective⟩
  refine MvPolynomial.map_injective (τ : Shrink.{u} S →+* D)
    (Subtype.val_injective.comp e.injective) ?_
  simpa only [map_sum, map_mul, hτt, hrel, map_zero] using ha k

end Stacks.SyzygyCoefficients
