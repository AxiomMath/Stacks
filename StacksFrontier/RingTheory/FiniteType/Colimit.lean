module

public import Mathlib.Algebra.Colimit.Ring
public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.TensorProduct.Maps
public import StacksCore.Tactic.StacksAttribute

/-!
# A finite-type ring map is a filtered colimit of finite-type maps over finite-type bases

All rings are commutative with `1` and all ring maps are unital.

## Main result

Let `φ : R → S` be a ring map with `S` of finite type over `R`. Then `φ` is a filtered
colimit of a directed system of ring maps `φ_λ : R_λ → S_λ` over a directed set `(Λ, ≤)`
such that

1. the colimit of the system recovers `φ : R → S`, up to ring isomorphisms compatible
   with the maps;
2. each `R_λ` is of finite type over `ℤ`;
3. each `φ_λ : R_λ → S_λ` is of finite type; and
4. for each `λ ≤ μ` the canonical base-change map
   `θ_{λμ} : S_λ ⊗_{R_λ} R_μ → S_μ`, `s ⊗ a ↦ s_{λμ}(s) · φ_μ(a)`, is surjective.

## Notation and conventions

Being of finite type is `RingHom.FiniteType`: `f.FiniteType` says the target is a finitely
generated algebra over the source through `f`. For part (2), "`R_λ` of finite type over
`ℤ`" is `(algebraMap ℤ (R l)).FiniteType`, i.e. `Algebra.FiniteType ℤ (R l)`, every ring
being canonically a `ℤ`-algebra.

A directed set is a nonempty type `Λ` with a `Preorder` that is directed,
`IsDirected Λ (· ≤ ·)`. A `Preorder` suffices rather than a `PartialOrder` because the
construction and the colimit only use directedness — the same generality as
`Ring.DirectLimit`.

A system of ring maps over `Λ` is bundled as `RingHomDirectedSystem`: families of
commutative rings `R_λ, S_λ`, transition maps `r_{λμ}, s_{λμ}` forming `DirectedSystem`s,
a ring map `φ_λ : R_λ → S_λ` for each `λ`, and commutativity of the squares. The colimit
is `Ring.DirectLimit` with induced map `Ring.DirectLimit.lift` of the maps
`(of S) ∘ φ_λ`, and "the colimit equals `R → S`" means: up to ring isomorphisms
`α : colim R_λ ≅ R` and `β : colim S_λ ≅ S` with `β ∘ (colim φ_λ) = φ ∘ α`.

The base-change map `θ_{λμ}` is `Algebra.TensorProduct.productMap` of the `R_λ`-algebra
maps induced by `s_{λμ}` and `φ_μ`; the `Algebra` instances come from the ring maps via
`RingHom.toAlgebra`, and the scalar-tower and commutativity conditions follow from the
commuting squares.

## Construction

Take `Λ = Finset R` ordered by `⊆`, with `R_A` the `ℤ`-subalgebra of `R` generated by `A`
and `S_A` the `ℤ`-subalgebra of `S` generated by `φ(A)` together with a fixed finite
generating set of `S` over `R`.
-/

@[expose] public section

universe u

/-- A system of ring maps `φ_λ : R_λ → S_λ` over a directed index
`Λ`.  The transition maps `r` and `s` form `DirectedSystem`s and the squares
`φ_μ ∘ r_{λμ} = s_{λμ} ∘ φ_λ` commute. -/
structure RingHomDirectedSystem (Λ : Type u) [Preorder Λ] where
  /-- The base rings `R_λ`. -/
  R : Λ → Type u
  /-- The total rings `S_λ`. -/
  S : Λ → Type u
  [commRingR : ∀ l, CommRing (R l)]
  [commRingS : ∀ l, CommRing (S l)]
  /-- Transition ring maps `r_{λμ} : R_λ → R_μ` for `λ ≤ μ`. -/
  r : ∀ ⦃i j : Λ⦄, i ≤ j → (R i →+* R j)
  /-- Transition ring maps `s_{λμ} : S_λ → S_μ` for `λ ≤ μ`. -/
  s : ∀ ⦃i j : Λ⦄, i ≤ j → (S i →+* S j)
  /-- The maps `r` form a directed system of rings. -/
  directedR : DirectedSystem R (fun _ _ h => (r h : R _ → R _))
  /-- The maps `s` form a directed system of rings. -/
  directedS : DirectedSystem S (fun _ _ h => (s h : S _ → S _))
  /-- The ring maps `φ_λ : R_λ → S_λ`. -/
  φ : ∀ l, R l →+* S l
  /-- The squares commute: `φ_μ ∘ r_{λμ} = s_{λμ} ∘ φ_λ`. -/
  square : ∀ ⦃i j : Λ⦄ (h : i ≤ j), (φ j).comp (r h) = (s h).comp (φ i)

attribute [instance] RingHomDirectedSystem.commRingR RingHomDirectedSystem.commRingS

namespace RingHomDirectedSystem

variable {Λ : Type u} [Preorder Λ] (sys : RingHomDirectedSystem Λ)

/-- The colimit `colim_λ R_λ`. -/
abbrev colimR : Type u := Ring.DirectLimit sys.R (fun _ _ h => (sys.r h : sys.R _ → sys.R _))

/-- The colimit `colim_λ S_λ`. -/
abbrev colimS : Type u := Ring.DirectLimit sys.S (fun _ _ h => (sys.s h : sys.S _ → sys.S _))

/-- The commutative ring structure on `colim_λ R_λ`. -/
noncomputable instance : CommRing sys.colimR := by
  unfold colimR
  infer_instance

/-- The commutative ring structure on `colim_λ S_λ`. -/
noncomputable instance : CommRing sys.colimS := by
  unfold colimS
  infer_instance

/-- The induced map `colim φ_λ : colim R_λ → colim S_λ`. -/
noncomputable def colimφ : sys.colimR →+* sys.colimS :=
  Ring.DirectLimit.lift _ _ _
    (fun i => (Ring.DirectLimit.of sys.S _ i).comp (sys.φ i))
    (by
      intro i j hij x
      have hsq := RingHom.congr_fun (sys.square hij) x
      simp only [RingHom.comp_apply] at hsq ⊢
      rw [hsq, Ring.DirectLimit.of_f])

/-- For `i ≤ j`, the base-change map
`θ_{ij} : S_i ⊗_{R_i} R_j → S_j`, `s ⊗ a ↦ s_{ij}(s) · φ_j(a)`. -/
noncomputable def baseChangeMap {i j : Λ} (h : i ≤ j) :
    letI : Algebra (sys.R i) (sys.S i) := (sys.φ i).toAlgebra
    letI : Algebra (sys.R i) (sys.R j) := (sys.r h).toAlgebra
    @TensorProduct (sys.R i) _ (sys.S i) (sys.R j) _ _ _ _ →+* sys.S j :=
  letI : Algebra (sys.R i) (sys.S i) := (sys.φ i).toAlgebra
  letI : Algebra (sys.R i) (sys.R j) := (sys.r h).toAlgebra
  letI : Algebra (sys.R i) (sys.S j) := ((sys.φ j).comp (sys.r h)).toAlgebra
  letI : Algebra (sys.R j) (sys.S j) := (sys.φ j).toAlgebra
  haveI : IsScalarTower (sys.R i) (sys.R j) (sys.S j) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let gφ : sys.R j →ₐ[sys.R i] sys.S j := IsScalarTower.toAlgHom _ _ _
  let fs : sys.S i →ₐ[sys.R i] sys.S j :=
    { sys.s h with
      commutes' := by
        intro a
        change sys.s h (algebraMap (sys.R i) (sys.S i) a) = algebraMap (sys.R i) (sys.S j) a
        simp only [RingHom.algebraMap_toAlgebra, RingHom.comp_apply]
        exact (RingHom.congr_fun (sys.square h) a).symm }
  (Algebra.TensorProduct.productMap fs gφ : _ →ₐ[sys.R i] sys.S j).toRingHom

end RingHomDirectedSystem

namespace Stacks.FiniteTypeColimit

variable {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (gen : Finset S)

/-- `R_A ⊆ R`: the `ℤ`-subalgebra of `R` generated by the finite set `A`. -/
noncomputable def RAsub (A : Finset R) : Subalgebra ℤ R := Algebra.adjoin ℤ (↑A : Set R)

/-- `S_A ⊆ S`: the `ℤ`-subalgebra of `S` generated by `φ(A)` together with the chosen
finite generating set `gen` of `S` over `R`. -/
noncomputable def SAsub (A : Finset R) : Subalgebra ℤ S :=
  Algebra.adjoin ℤ ((φ '' (↑A : Set R)) ∪ (↑gen : Set S))

/-- Monotonicity of `A ↦ R_A`: `A ⊆ B ⟹ R_A ≤ R_B`.
Argument: `adjoin` is monotone in its generating set, and `A ⊆ B` as sets. -/
theorem RAsub_mono {A B : Finset R} (h : A ⊆ B) : RAsub A ≤ RAsub (R := R) B :=
  Algebra.adjoin_mono (by exact_mod_cast h)

/-- Monotonicity of `A ↦ S_A`: `A ⊆ B ⟹ S_A ≤ S_B`.
Argument: `φ '' A ⊆ φ '' B` (image is monotone) and `gen` is common, so the
generating sets are nested; `adjoin` is monotone. -/
theorem SAsub_mono {A B : Finset R} (h : A ⊆ B) : SAsub φ gen A ≤ SAsub φ gen B :=
  Algebra.adjoin_mono
    (Set.union_subset_union_left _ (Set.image_mono (by exact_mod_cast h)))

/-- `φ` maps `R_A` into `S_A`.
Argument: `φ.toIntAlgHom` is a `ℤ`-algebra hom, so `(adjoin ℤ A).map φ = adjoin ℤ (φ '' A)`
(`Algebra.adjoin_image` / `Algebra.map_adjoin`). And `adjoin ℤ (φ '' A) ≤
adjoin ℤ (φ '' A ∪ gen) = S_A` by `Algebra.adjoin_mono` + `Set.subset_union_left`. -/
theorem phi_mapsTo (A : Finset R) :
    (RAsub A).map φ.toIntAlgHom ≤ SAsub φ gen A := by
  unfold RAsub SAsub
  rw [← Algebra.adjoin_image]
  exact Algebra.adjoin_mono Set.subset_union_left

/-- The (co)restriction `φ_A : R_A → S_A` of `φ`, as a `ℤ`-algebra hom. -/
noncomputable def phiA (A : Finset R) : (RAsub A) →ₐ[ℤ] (SAsub φ gen A) :=
  ((φ.toIntAlgHom.comp (RAsub A).val).codRestrict (SAsub φ gen A)
    (fun x => phi_mapsTo φ gen A ⟨x, x.2, rfl⟩))

/-- The underlying value of `φ_A x` is `φ` of the underlying value of `x`. -/
theorem phiA_coe (A : Finset R) (x : RAsub A) :
    ((phiA φ gen A x : SAsub φ gen A) : S) = φ (x : R) := by
  rw [phiA, AlgHom.coe_codRestrict]
  rfl

/-- The constructed `RingHomDirectedSystem` over `Λ = Finset R`.
Data: `R_A`, `S_A`, subalgebra-inclusion transition maps, and the corestriction
`φ_A`.  The three proof fields below (`directedR`, `directedS`, `square`) are the
remaining content of the construction (subgoal A). -/
noncomputable def sys : RingHomDirectedSystem (Finset R) where
  R := fun A => (RAsub A : Type u)
  S := fun A => (SAsub φ gen A : Type u)
  r := fun _ _ h => (Subalgebra.inclusion (RAsub_mono h)).toRingHom
  s := fun _ _ h => (Subalgebra.inclusion (SAsub_mono φ gen h)).toRingHom
  directedR := by
    constructor
    · intro i x
      apply Subtype.ext
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion]
    · intro k j i hij hjk x
      apply Subtype.ext
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion]
  directedS := by
    constructor
    · intro i x
      apply Subtype.ext
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion]
    · intro k j i hij hjk x
      apply Subtype.ext
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion]
  φ := fun A => (phiA φ gen A).toRingHom
  square := by
    intro i j h
    ext
    rfl

/-! ### The four conclusions, as named sub-lemmas referencing `sys`. -/

/-- Including a subalgebra into a bigger one and then taking the underlying value is the
underlying value. -/
private theorem val_comp_inclusion {T : Type u} [CommRing T] {A B : Subalgebra ℤ T} (h : A ≤ B)
    (x : A) : B.val.toRingHom ((Subalgebra.inclusion h).toRingHom x) = A.val.toRingHom x := by
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.val_apply,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.val_apply]

-- needed: five `rw`s in `conclusion_colim` only match with isDefEq ignoring transparency
-- (the colimit's structure maps are semireducible and must unfold to expose the pattern).
set_option backward.isDefEq.respectTransparency false in
/-- **Conclusion (1): the colimit recovers `φ`.**
There are ring isos `α : colim R_A ≅ R` and `β : colim S_A ≅ S` with
`β ∘ (colim φ_A) = φ ∘ α`.

Argument (hardest subgoal, B): The family `(R_A)` is a filtered system of subrings
of `R` whose union is all of `R` (every `r ∈ R` lies in `R_{{r}}`), and the
transition maps are the (injective) inclusions.  Hence the canonical ring map
`colim R_A → R` (induced by the inclusions `R_A ↪ R` via `Ring.DirectLimit.lift`)
is bijective: surjective because every `r` is hit from `R_{{r}}`; injective because
on a filtered colimit of injective compatible maps an element mapping to `0` is
`0` already at some stage (`Ring.DirectLimit.of.injective`-style argument /
`Ring.DirectLimit` exactness for directed injective systems). Take `α` to be the
induced isomorphism.  Identically, `β : colim S_A ≅ S` since the `S_A` exhaust `S`
(`S = adjoin ℤ (φ '' R ∪ gen)`, and any element involves finitely many `φ(a)`'s and
the `x_i`, all lying in some `S_A`).  Compatibility `β ∘ colimφ = φ ∘ α` holds
because, on each stage `A`, `colimφ` is induced by `φ_A` which is the corestriction
of `φ`, and `α, β` are induced by the inclusions; chase `Ring.DirectLimit.lift_of`. -/
theorem conclusion_colim
    (hgen : (@Algebra.adjoin R S _ _ φ.toAlgebra (↑gen : Set S))
      = (⊤ : @Subalgebra R S _ _ φ.toAlgebra)) :
    ∃ (α : (sys φ gen).colimR ≃+* R) (β : (sys φ gen).colimS ≃+* S),
      (β : (sys φ gen).colimS →+* S).comp (sys φ gen).colimφ
        = φ.comp (α : (sys φ gen).colimR →+* R) := by
  -- The forward map `colim R_A → R` induced by the inclusions `(RAsub A).val`.
  let liftR : (sys φ gen).colimR →+* R :=
    Ring.DirectLimit.lift _ _ R (fun A => (RAsub A).val.toRingHom) (by
      intro i j hij x
      exact val_comp_inclusion (RAsub_mono hij) x)
  -- The forward map `colim S_A → S` induced by the inclusions `(SAsub φ gen A).val`.
  let liftS : (sys φ gen).colimS →+* S :=
    Ring.DirectLimit.lift _ _ S (fun A => (SAsub φ gen A).val.toRingHom) (by
      intro i j hij x
      exact val_comp_inclusion (SAsub_mono φ gen hij) x)
  -- `liftR` is bijective.
  have hbijR : Function.Bijective liftR := by
    constructor
    · apply Ring.DirectLimit.lift_injective
      intro i
      exact Subtype.val_injective
    · intro r
      refine ⟨Ring.DirectLimit.of _ _ {r} ⟨r, ?_⟩, ?_⟩
      · unfold RAsub; exact Algebra.subset_adjoin (by simp)
      · show liftR _ = r
        rw [Ring.DirectLimit.lift_of]; rfl
  -- Every element of `S` lies in some stage `S_A`.
  have hexists : ∀ s : S, ∃ A : Finset R, s ∈ SAsub φ gen A := by
    classical
    let : Algebra R S := φ.toAlgebra
    intro s
    have hs : s ∈ Algebra.adjoin R (↑gen : Set S) := by rw [hgen]; exact Algebra.mem_top
    refine Algebra.adjoin_induction
      (p := fun z _ => ∃ A : Finset R, z ∈ SAsub φ gen A) ?_ ?_ ?_ ?_ hs
    · -- generators z ∈ gen
      intro z hz
      exact ⟨∅, Algebra.subset_adjoin (Or.inr hz)⟩
    · -- algebraMap R S r = φ r, lies in stage {r}
      intro r
      refine ⟨{r}, ?_⟩
      have hval : (algebraMap R S) r = φ r := rfl
      rw [hval]
      apply Algebra.subset_adjoin
      apply Or.inl
      exact ⟨r, by simp, rfl⟩
    · -- add
      rintro x y _ _ ⟨A, hA⟩ ⟨B, hB⟩
      exact ⟨A ∪ B, add_mem (SAsub_mono φ gen Finset.subset_union_left hA)
        (SAsub_mono φ gen Finset.subset_union_right hB)⟩
    · -- mul
      rintro x y _ _ ⟨A, hA⟩ ⟨B, hB⟩
      exact ⟨A ∪ B, mul_mem (SAsub_mono φ gen Finset.subset_union_left hA)
        (SAsub_mono φ gen Finset.subset_union_right hB)⟩
  -- `liftS` is bijective.
  have hbijS : Function.Bijective liftS := by
    constructor
    · apply Ring.DirectLimit.lift_injective
      intro i
      exact Subtype.val_injective
    · intro s
      obtain ⟨A, hA⟩ := hexists s
      refine ⟨Ring.DirectLimit.of _ _ A ⟨s, hA⟩, ?_⟩
      show liftS _ = s
      rw [Ring.DirectLimit.lift_of]; rfl
  refine ⟨RingEquiv.ofBijective liftR hbijR, RingEquiv.ofBijective liftS hbijS, ?_⟩
  -- Helper computations for `liftR`, `liftS` on the canonical maps `of`.
  have hLR : ∀ (B : Finset R) (y : (sys φ gen).R B),
      liftR (Ring.DirectLimit.of _ _ B y) = (RAsub B).val.toRingHom y :=
    fun B y => Ring.DirectLimit.lift_of _ _ _ B y
  have hLS : ∀ (B : Finset R) (y : (sys φ gen).S B),
      liftS (Ring.DirectLimit.of _ _ B y) = (SAsub φ gen B).val.toRingHom y :=
    fun B y => Ring.DirectLimit.lift_of _ _ _ B y
  -- Compatibility square: `liftS ∘ colimφ = φ ∘ liftR`.
  apply Ring.DirectLimit.hom_ext
  intro A
  ext x
  -- LHS: liftS (colimφ (of A x)) ; RHS: φ (liftR (of A x))
  change liftS ((sys φ gen).colimφ (Ring.DirectLimit.of _ _ A x))
    = φ (liftR (Ring.DirectLimit.of _ _ A x))
  rw [RingHomDirectedSystem.colimφ, Ring.DirectLimit.lift_of]
  change liftS (Ring.DirectLimit.of _ _ A ((phiA φ gen A).toRingHom x))
    = φ (liftR (Ring.DirectLimit.of _ _ A x))
  rw [hLS, hLR]
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.val_apply,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Subalgebra.val_apply]
  exact phiA_coe φ gen A x

/-- **Conclusion (2): each `R_A` is of finite type over `ℤ`.**
Argument (routine, C): `R_A = adjoin ℤ (↑A)` with `A` finite, so
`Algebra.FiniteType ℤ R_A` by `Algebra.FiniteType.adjoin_of_finite`; translate to
`(algebraMap ℤ (sys.R A)).FiniteType` via `RingHom.FiniteType` ↔ `Algebra.FiniteType`
(`Algebra.FiniteType` for the canonical `ℤ`-algebra structure is defeq to the
algebraMap's `FiniteType`). -/
theorem conclusion_RA_ft (A : Finset R) :
    (algebraMap ℤ ((sys φ gen).R A)).FiniteType := by
  rw [RingHom.finiteType_algebraMap]
  exact Algebra.FiniteType.adjoin_of_finite A.finite_toSet

/-- **Conclusion (3): each `φ_A : R_A → S_A` is of finite type.**
Argument (routine, D): `S_A = adjoin ℤ (φ '' A ∪ gen)`.  As an `R_A`-algebra
(via `φ_A`), `S_A` is generated by the finite set `gen` (the image of the `x_i`):
the other ℤ-generators `φ(a)`, `a ∈ A`, already lie in the image of `R_A` under
`φ_A` (since `a ∈ R_A` and `φ_A a = φ a`).  Hence `S_A` is a finitely generated
`R_A`-algebra, i.e. `(sys.φ A).FiniteType`.  Formally: show
`Algebra.adjoin R_A (gen' : Set S_A) = ⊤` where `gen'` are the lifts of `gen`,
because `adjoin R_A gen' ⊇ adjoin ℤ (φ''A ∪ gen)` once the `φ(a)` are absorbed by
the `R_A`-action. -/
theorem conclusion_phiA_ft (A : Finset R) :
    ((sys φ gen).φ A).FiniteType := by
  -- Use the tower ℤ → R_A → S_A: `φ_A` is a ℤ-algebra hom so
  -- `φ_A ∘ (algebraMap ℤ R_A) = algebraMap ℤ S_A`, which is finite type since
  -- `S_A = adjoin ℤ (finite set)`.  Then `of_comp_finiteType` gives `φ_A` finite type.
  apply RingHom.FiniteType.of_comp_finiteType
    (f := algebraMap ℤ ((sys φ gen).R A))
  have hcomp : ((sys φ gen).φ A).comp (algebraMap ℤ ((sys φ gen).R A))
      = algebraMap ℤ ((sys φ gen).S A) := by
    ext n
    exact (phiA φ gen A).commutes n
  rw [hcomp, RingHom.finiteType_algebraMap]
  exact Algebra.FiniteType.adjoin_of_finite
    (Set.Finite.union (Set.Finite.image _ A.finite_toSet) gen.finite_toSet)

/-- **Conclusion (4): each base-change map `θ_{AB}` is surjective.**
Argument (hard subgoal, E): For `A ⊆ B`, `θ_{AB} : S_A ⊗_{R_A} R_B → S_B` is
`Algebra.TensorProduct.productMap fs gφ` with `fs = s_{AB}` (inclusion `S_A ↪ S_B`)
and `gφ = φ_B` (as `R_A`-alg map `R_B → S_B`).  By
`Algebra.TensorProduct.productMap_range`, `range θ = (range fs) ⊔ (range gφ)` as
`R_A`-subalgebras of `S_B`.  Now `range fs = S_A` contains all `gen` (the `x_i`) and
all `φ(a)`, `a ∈ A`; and `range gφ = φ(R_B)` contains all `φ(b)`, `b ∈ B`.  Together
these contain every ℤ-algebra generator of `S_B = adjoin ℤ (φ''B ∪ gen)`, so the
join is `⊤`; hence `θ` is surjective. -/
theorem conclusion_surj ⦃A B : Finset R⦄ (h : A ≤ B) :
    Function.Surjective ((sys φ gen).baseChangeMap h) := by
  let : Algebra ((sys φ gen).R A) ((sys φ gen).S A) := ((sys φ gen).φ A).toAlgebra
  let : Algebra ((sys φ gen).R A) ((sys φ gen).R B) := ((sys φ gen).r h).toAlgebra
  let : Algebra ((sys φ gen).R A) ((sys φ gen).S B) :=
    (((sys φ gen).φ B).comp ((sys φ gen).r h)).toAlgebra
  let : Algebra ((sys φ gen).R B) ((sys φ gen).S B) := ((sys φ gen).φ B).toAlgebra
  have : IsScalarTower ((sys φ gen).R A) ((sys φ gen).R B) ((sys φ gen).S B) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  unfold RingHomDirectedSystem.baseChangeMap
  rw [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, ← AlgHom.range_eq_top,
      Algebra.TensorProduct.productMap_range, eq_top_iff]
  -- It suffices to show every element of `S_B` lies in the join `fs.range ⊔ gφ.range`.
  -- `S_B = adjoin ℤ (φ''B ∪ gen)`; induct on membership.
  rintro ⟨y, hy⟩ -
  refine Algebra.adjoin_induction
    (p := fun z hz => (⟨z, hz⟩ : (sys φ gen).S B) ∈ _ ⊔ _) ?_ ?_ ?_ ?_ hy
  · rintro z (hz | hz)
    · obtain ⟨b, hbB, rfl⟩ := hz
      have hbRB : b ∈ RAsub B := Algebra.subset_adjoin (by exact_mod_cast hbB)
      apply IsConcreteLE.le_iff.mp le_sup_right
      refine ⟨⟨b, hbRB⟩, ?_⟩
      apply Subtype.ext
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, IsScalarTower.coe_toAlgHom',
          RingHom.algebraMap_toAlgebra]
      exact phiA_coe φ gen B ⟨b, hbRB⟩
    · have hzSA : z ∈ SAsub φ gen A := Algebra.subset_adjoin (Or.inr hz)
      apply IsConcreteLE.le_iff.mp le_sup_left
      exact ⟨⟨z, hzSA⟩, Subtype.ext rfl⟩
  · exact fun r => intCast_mem _ r
  · exact fun _ _ _ _ => add_mem
  · exact fun _ _ _ _ => mul_mem

end Stacks.FiniteTypeColimit

/-- Let `φ : R → S` be a ring map with `S` of finite
type over `R`.  Then there exist a directed set `(Λ, ≤)` and a system of ring maps
`φ_λ : R_λ → S_λ` over `Λ` such that:

1. the colimit of the system recovers `φ : R → S` (there are ring isomorphisms
   `α : colim R_λ ≅ R`, `β : colim S_λ ≅ S` with `β ∘ (colim φ_λ) = φ ∘ α`);
2. each `R_λ` is of finite type over `ℤ`;
3. each `φ_λ : R_λ → S_λ` is of finite type;
4. for each `λ ≤ μ`, the base-change map `θ_{λμ} : S_λ ⊗_{R_λ} R_μ → S_μ` is
   surjective. -/
@[stacks 00QZ]
theorem exists_ringHomDirectedSystem_of_finiteType
    (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S)
    (hft : φ.FiniteType) :
    ∃ (Λ : Type u) (_ : Preorder Λ) (_ : IsDirected Λ (· ≤ ·)) (_ : Nonempty Λ)
      (sys : RingHomDirectedSystem Λ),
      -- (1) the colimit recovers `φ : R → S`
      (∃ (α : sys.colimR ≃+* R) (β : sys.colimS ≃+* S),
        (β : sys.colimS →+* S).comp sys.colimφ = φ.comp (α : sys.colimR →+* R)) ∧
      -- (2) each `R_λ` is of finite type over `ℤ`
      (∀ l, (algebraMap ℤ (sys.R l)).FiniteType) ∧
      -- (3) each `φ_λ` is of finite type
      (∀ l, (sys.φ l).FiniteType) ∧
      -- (4) each base-change map `θ_{λμ}` is surjective
      (∀ ⦃i j : Λ⦄ (h : i ≤ j), Function.Surjective (sys.baseChangeMap h)) := by
  -- Extract a finite generating set `gen` of `S` over `R` from `hft : φ.FiniteType`.
  -- `φ.FiniteType` is `Algebra.FiniteType R S` for the `φ`-algebra structure, which
  -- provides `gen : Finset S` with `Algebra.adjoin R ↑gen = ⊤`.
  obtain ⟨gen, hgen⟩ := (hft : @Algebra.FiniteType R S _ _ φ.toAlgebra).out
  exact ⟨Finset R, inferInstance, inferInstance, inferInstance, Stacks.FiniteTypeColimit.sys φ gen,
    Stacks.FiniteTypeColimit.conclusion_colim φ gen hgen,
    Stacks.FiniteTypeColimit.conclusion_RA_ft φ gen,
    Stacks.FiniteTypeColimit.conclusion_phiA_ft φ gen,
    Stacks.FiniteTypeColimit.conclusion_surj φ gen⟩
