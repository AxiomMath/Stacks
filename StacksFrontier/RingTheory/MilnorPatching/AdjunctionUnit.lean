open scoped ChangeOfRings
open ModuleGlueing

universe u

namespace MilnorPatching
open ModuleGlueing
open scoped TensorProduct

@[expose] public section

/-- The concrete tensor-product form of the surjectivity assertion in Tag 08IG.
The ring and module universes are independent. -/
public theorem compatibleTensorPairs_surjective
    {R S T U L : Type*} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    [AddCommGroup L] [Module R L] [Module R U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (hf : Function.Surjective f) (hk : Function.Surjective k)
    (hker : ∀ t : T, k t = 0 → ∃ r : R, f r = 0 ∧ g r = t)
    (hl : letI : Module R S := Module.compHom S f; S →ₗ[R] U)
    (kl : letI : Module R T := Module.compHom T g; T →ₗ[R] U)
    (hhl : ∀ s, hl s = h s) (hkl : ∀ t, kl t = k t) :
    letI : Module R S := Module.compHom S f
    letI : Module R T := Module.compHom T g
    ∀ (x : S ⊗[R] L) (y : T ⊗[R] L),
      (LinearMap.rTensor L hl) x = (LinearMap.rTensor L kl) y →
      ∃ l : L, (1 : S) ⊗ₜ[R,f] l = x ∧ (1 : T) ⊗ₜ[R,g] l = y := by
  let : Module R S := Module.compHom S f
  let : Module R T := Module.compHom T g
  intro x y he
  obtain ⟨l₀, rfl⟩ := tensorUnit_surjective f hf L x
  have hz : (LinearMap.rTensor L kl) (y - (1 : T) ⊗ₜ[R,g] l₀) = 0 := by
    rw [map_sub, ← he]
    simp only [LinearMap.rTensor_tmul, hhl, hkl, map_one, sub_self]
  obtain ⟨l₁, h₁, h₂⟩ := tensorKernelLift f g k hk hker L kl hkl _ hz
  refine ⟨l₀ + l₁, ?_, ?_⟩
  · simp [TensorProduct.tmul_add, h₁]
  · rw [TensorProduct.tmul_add, h₂]
    abel

end

end MilnorPatching
end
