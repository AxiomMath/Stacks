private lemma fibreToBSurj {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
    (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
    (s : RingFibreProduct.Situation toBase surjection I) :
    Function.Surjective s.pullbackCone.fst.hom := by
  intro b
  obtain ⟨a', ha'⟩ := s.surjective_surjection (toBase b)
  exact ⟨⟨(b, a'), ha'.symm⟩, rfl⟩

private lemma fibreKernelLift {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
    (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
    (s : RingFibreProduct.Situation toBase surjection I) :
    ∀ t : A', surjection t = 0 →
      ∃ r : s.fibreProduct, s.pullbackCone.fst.hom r = 0 ∧
        s.pullbackCone.snd.hom r = t :=
  fun t ht => ⟨⟨(0, t), by simp [ht]⟩, rfl, rfl⟩

private lemma pairSurj {R S T U : Type u} [CommRing R] [CommRing S]
    [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g)
    (hf : Function.Surjective f) (hk : Function.Surjective k)
    (hker : ∀ t : T, k t = 0 → ∃ r : R, f r = 0 ∧ g r = t)
    (L : ModuleCat.{u} R)
    (unitPair : ∀ l : L, ∃ p₀ : CompatiblePairs h k
        ((extensionOfScalarsToPullback f g h k comm).obj L),
        p₀.1.1 = (1 : S) ⊗ₜ[R,f] l ∧ p₀.1.2 = (1 : T) ⊗ₜ[R,g] l)
    (p : CompatiblePairs h k
      ((extensionOfScalarsToPullback f g h k comm).obj L)) :
    ∃ l : L, p.1.1 = (1 : S) ⊗ₜ[R,f] l ∧ p.1.2 = (1 : T) ⊗ₜ[R,g] l := by
  let : Module R S := Module.compHom S f
  let : Module R T := Module.compHom T g
  let : Module R U := Module.compHom U (k.comp g)
  let : Module T U := Module.compHom U k
  obtain ⟨l₀, hl₀⟩ := tensorUnit_surjective f hf L p.1.1
  obtain ⟨p₀, hp₀B, hp₀T⟩ := unitPair l₀
  let z : (extensionOfScalarsToPullback f g h k comm).obj L |>.snd :=
    p.1.2 - p₀.1.2
  have hzouter : (1 : U) ⊗ₜ[T,k] z = 0 := by
    have hsame : (1 : U) ⊗ₜ[T,k] p.1.2 =
        (1 : U) ⊗ₜ[T,k] p₀.1.2 := by
      calc
        _ = ((extensionOfScalarsToPullback f g h k comm).obj L).iso.hom
              ((1 : U) ⊗ₜ[S,h] p.1.1) := p.2.symm
        _ = ((extensionOfScalarsToPullback f g h k comm).obj L).iso.hom
              ((1 : U) ⊗ₜ[S,h] p₀.1.1) :=
              congrArg
                (fun x : ((extensionOfScalarsToPullback f g h k comm).obj L).fst =>
                ((extensionOfScalarsToPullback f g h k comm).obj L).iso.hom
                  ((1 : U) ⊗ₜ[S,h] x)) (hl₀.symm.trans hp₀B.symm)
        _ = _ := p₀.2
    change (1 : U) ⊗ₜ[T,k] (p.1.2 - p₀.1.2) = 0
    rw [TensorProduct.tmul_sub, hsame, sub_self]
  have hzker : (LinearMap.rTensor L (tensorRingMapLinear g k)) z = 0 := by
    have hc := extendScalarsComp_rTensor g k L z
    apply ((ModuleCat.extendScalarsComp g k).app L).toLinearEquiv.injective
    simpa only [Iso.toLinearEquiv_apply, Iso.app_hom, map_zero] using hc.trans hzouter
  obtain ⟨l₁, hl₁B, hl₁T⟩ := tensorKernelLift f g k hk hker L (tensorRingMapLinear g k)
    (fun _ => rfl) z hzker
  refine ⟨l₀ + l₁, ?_, ?_⟩
  · rw [TensorProduct.tmul_add, hl₁B, add_zero]
    exact hl₀.symm
  · rw [TensorProduct.tmul_add, hl₁T, ← hp₀T]
    dsimp [z]
    abel

private lemma adjUnitPairComponents {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
    (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
    (s : RingFibreProduct.Situation toBase surjection I) :
    let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
    let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
    let comm : toBase.comp toB = surjection.comp toA' := by
      exact congrArg CommRingCat.Hom.hom s.pullbackCone.condition
    ∀ (F : CategoricalPullback (ModuleCat.extendScalars.{u,u,u} toBase)
          (ModuleCat.extendScalars.{u,u,u} surjection) ⥤ ModuleCat.{u} s.fibreProduct)
      (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
      (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F),
      (∀ (L : ModuleCat.{u} s.fibreProduct) (X) (h : L ⟶ F.obj X) (l : L),
        (e X (h l)).1.1 =
            ((adj.homEquiv L X).symm h).fst ((1 : B) ⊗ₜ[s.fibreProduct,toB] l) ∧
          (e X (h l)).1.2 =
            ((adj.homEquiv L X).symm h).snd ((1 : A') ⊗ₜ[s.fibreProduct,toA'] l)) →
      ∀ (L : ModuleCat.{u} s.fibreProduct) (l : L),
        (e ((extensionOfScalarsToPullback toB toA' toBase surjection comm).obj L)
          ((adj.unit.app L) l)).1.1 = (1 : B) ⊗ₜ[s.fibreProduct,toB] l ∧
        (e ((extensionOfScalarsToPullback toB toA' toBase surjection comm).obj L)
          ((adj.unit.app L) l)).1.2 = (1 : A') ⊗ₜ[s.fibreProduct,toA'] l := by
  dsimp only
  intro F e adj h L l
  let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
  let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
  let comm : toBase.comp toB = surjection.comp toA' :=
    congrArg CommRingCat.Hom.hom s.pullbackCone.condition
  let E := extensionOfScalarsToPullback toB toA' toBase surjection comm
  obtain ⟨hhB, hhA'⟩ := h L (E.obj L) (adj.unit.app L) l
  rw [adj.homEquiv_symm_unit] at hhB hhA'
  exact ⟨by convert hhB using 1, by convert hhA' using 1⟩

private lemma surjAdjUnit {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
    (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
    (s : RingFibreProduct.Situation toBase surjection I) :
    let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
    let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
    let comm : toBase.comp toB = surjection.comp toA' := by
      exact congrArg CommRingCat.Hom.hom s.pullbackCone.condition
    ∀ (F : CategoricalPullback (ModuleCat.extendScalars.{u,u,u} toBase)
          (ModuleCat.extendScalars.{u,u,u} surjection) ⥤ ModuleCat.{u} s.fibreProduct)
      (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
      (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F),
      (∀ (L : ModuleCat.{u} s.fibreProduct) (X) (h : L ⟶ F.obj X) (l : L),
        (e X (h l)).1.1 =
            ((adj.homEquiv L X).symm h).fst ((1 : B) ⊗ₜ[s.fibreProduct,toB] l) ∧
          (e X (h l)).1.2 =
            ((adj.homEquiv L X).symm h).snd ((1 : A') ⊗ₜ[s.fibreProduct,toA'] l)) →
      ∀ L, Function.Surjective (adj.unit.app L) := by
  dsimp only
  intro F e adj h L x
  let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
  let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
  let comm : toBase.comp toB = surjection.comp toA' :=
    congrArg CommRingCat.Hom.hom s.pullbackCone.condition
  let E := extensionOfScalarsToPullback toB toA' toBase surjection comm
  have hunit (l : L) :
      (e (E.obj L) ((adj.unit.app L) l)).1.1 = (1 : B) ⊗ₜ[s.fibreProduct,toB] l ∧
      (e (E.obj L) ((adj.unit.app L) l)).1.2 = (1 : A') ⊗ₜ[s.fibreProduct,toA'] l :=
    adjUnitPairComponents toBase surjection I s F e adj h L l
  obtain ⟨l, hlB, hlA'⟩ := pairSurj toB toA' toBase surjection comm
    (fibreToBSurj toBase surjection I s) s.surjective_surjection
    (fibreKernelLift toBase surjection I s) L
    (fun l => ⟨e (E.obj L) ((adj.unit.app L) l), hunit l⟩) (e (E.obj L) x)
  exact ⟨l, (e (E.obj L)).injective <| Subtype.ext <|
    Prod.ext ((hunit l).1.trans hlB.symm) ((hunit l).2.trans hlA'.symm)⟩

private def reduction : ZMod 4 →+* ZMod 2 := ZMod.castHom (by decide : 2 ∣ 4) (ZMod 2)
private theorem situation : RingFibreProduct.Situation reduction reduction
    (RingHom.ker reduction) :=
  ⟨ZMod.castHom_surjective (by decide : 2 ∣ 4), rfl⟩
private lemma tensorQuotientClass_eq_zero {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S) (J : Ideal R) (r : R) (hr : f r = 0) :
    (1 : S) ⊗ₜ[R,f] (Ideal.Quotient.mk J r) = 0 := by
  let : Module R S := Module.compHom S f
  have hr' : (Ideal.Quotient.mk J r : R ⧸ J) = r • (1 : R ⧸ J) := by
    calc
      (Ideal.Quotient.mk J r : R ⧸ J) = Ideal.Quotient.mk J (r • (1 : R)) := by simp
      _ = r • Ideal.Quotient.mk J (1 : R) := Submodule.Quotient.mk_smul J r (1 : R)
      _ = r • (1 : R ⧸ J) := by simp
  rw [hr']
  change (1 : S) ⊗ₜ[R] (r • (1 : R ⧸ J)) = 0
  rw [TensorProduct.tmul_smul]
  change (f r * 1 : S) ⊗ₜ[R] (1 : R ⧸ J) = 0
  simp [hr]

private lemma noninjAdjUnit {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
    (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
    (s : RingFibreProduct.Situation toBase surjection I) :
    let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
    let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
    let comm : toBase.comp toB = surjection.comp toA' := by
      exact congrArg CommRingCat.Hom.hom s.pullbackCone.condition
    ∀ (F : CategoricalPullback (ModuleCat.extendScalars.{u,u,u} toBase)
          (ModuleCat.extendScalars.{u,u,u} surjection) ⥤ ModuleCat.{u} s.fibreProduct)
      (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
      (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F),
      (∀ (L : ModuleCat.{u} s.fibreProduct) (X) (h : L ⟶ F.obj X) (l : L),
        (e X (h l)).1.1 =
            ((adj.homEquiv L X).symm h).fst ((1 : B) ⊗ₜ[s.fibreProduct,toB] l) ∧
          (e X (h l)).1.2 =
            ((adj.homEquiv L X).symm h).snd ((1 : A') ⊗ₜ[s.fibreProduct,toA'] l)) →
      ∀ (L : ModuleCat.{u} s.fibreProduct) (l : L), l ≠ 0 →
        (1 : B) ⊗ₜ[s.fibreProduct,toB] l = 0 →
        (1 : A') ⊗ₜ[s.fibreProduct,toA'] l = 0 →
        ¬ Function.Injective (adj.unit.app L) := by
  dsimp only
  intro F e adj h L l hne hB hA hinj
  let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
  let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
  let comm : toBase.comp toB = surjection.comp toA' :=
    congrArg CommRingCat.Hom.hom s.pullbackCone.condition
  let E := extensionOfScalarsToPullback toB toA' toBase surjection comm
  have hunit (z : L) :
      (e (E.obj L) ((adj.unit.app L) z)).1.1 = (1 : B) ⊗ₜ[s.fibreProduct,toB] z ∧
      (e (E.obj L) ((adj.unit.app L) z)).1.2 = (1 : A') ⊗ₜ[s.fibreProduct,toA'] z :=
    adjUnitPairComponents toBase surjection I s F e adj h L z
  have heq : (adj.unit.app L) l = (adj.unit.app L) 0 := by
    apply (e (E.obj L)).injective
    apply Subtype.ext
    apply Prod.ext
    · rw [(hunit l).1, (hunit 0).1, hB, TensorProduct.tmul_zero]
    · rw [(hunit l).2, (hunit 0).2, hA, TensorProduct.tmul_zero]
  exact hne (hinj heq)

private def liftedReduction : ULift.{u} (ZMod 4) →+* ULift.{u} (ZMod 2) :=
  reduction.ulift

private theorem liftedSituation : RingFibreProduct.Situation
    liftedReduction liftedReduction (RingHom.ker liftedReduction) := by
  refine ⟨fun z => ?_, rfl⟩
  obtain ⟨a, ha⟩ := situation.surjective_surjection z.down
  refine ⟨⟨a⟩, ?_⟩
  change ULift.up (reduction a) = z
  exact ULift.up_down z ▸ congrArg ULift.up ha

private abbrev DLift := liftedSituation.fibreProduct
private def xLift : DLift := ⟨(⟨2⟩, ⟨0⟩), by
  change liftedReduction (⟨2⟩ : ULift.{u} (ZMod 4)) =
    liftedReduction (⟨0⟩ : ULift.{u} (ZMod 4))
  decide⟩
private def yLift : DLift := ⟨(⟨0⟩, ⟨2⟩), by
  change liftedReduction (⟨0⟩ : ULift.{u} (ZMod 4)) =
    liftedReduction (⟨2⟩ : ULift.{u} (ZMod 4))
  decide⟩
private def JLift : Ideal DLift := Ideal.span {xLift - yLift}

private lemma xLiftNotMemJ : xLift ∉ JLift := by
  rw [JLift, Ideal.mem_span_singleton]
  rintro ⟨r, hr⟩
  have hpar : reduction r.1.1.down = reduction r.1.2.down :=
    congrArg ULift.down (r.2 : liftedReduction r.1.1 = liftedReduction r.1.2)
  have hfst : (2 : ZMod 4) * r.1.1.down = 2 := by
    have hh := congrArg (fun d : DLift => d.1.1.down) hr
    change (2 : ZMod 4) = ((2 : ZMod 4) - 0) * r.1.1.down at hh
    simpa using hh.symm
  have hsnd : (2 : ZMod 4) * r.1.2.down = 0 := by
    have hh := congrArg (fun d : DLift => d.1.2.down) hr
    change (0 : ZMod 4) = ((0 : ZMod 4) - 2) * r.1.2.down at hh
    simpa [show (0 : ZMod 4) - 2 = 2 by decide] using hh.symm
  have hno : ∀ a b : ZMod 4, reduction a = reduction b →
      (2 : ZMod 4) * a = 2 → (2 : ZMod 4) * b = 0 → False := by decide
  exact hno r.1.1.down r.1.2.down hpar hfst hsnd

private lemma xLiftNeZero :
    (Ideal.Quotient.mk JLift xLift : DLift ⧸ JLift) ≠ 0 :=
  fun h => xLiftNotMemJ (Ideal.Quotient.eq_zero_iff_mem.mp h)

private lemma xyLiftQuotientEq :
    (Ideal.Quotient.mk JLift xLift : DLift ⧸ JLift) =
      Ideal.Quotient.mk JLift yLift :=
  (Ideal.Quotient.mk_eq_mk_iff_sub_mem xLift yLift).mpr
    (Ideal.subset_span (Set.mem_singleton (xLift - yLift)))

private lemma tensorXLift_toB_zero :
    (1 : ULift.{u} (ZMod 4)) ⊗ₜ[DLift,liftedSituation.pullbackCone.fst.hom]
      (Ideal.Quotient.mk JLift xLift) = 0 := by
  rw [xyLiftQuotientEq]
  exact tensorQuotientClass_eq_zero liftedSituation.pullbackCone.fst.hom JLift yLift rfl

private lemma tensorXLift_toA'_zero :
    (1 : ULift.{u} (ZMod 4)) ⊗ₜ[DLift,liftedSituation.pullbackCone.snd.hom]
      (Ideal.Quotient.mk JLift xLift) = 0 :=
  tensorQuotientClass_eq_zero liftedSituation.pullbackCone.snd.hom JLift xLift rfl

/-- **Stacks Project, Tag 08IG.** For a fibre product `B' = B ×_A A'` with `A' → A`
surjective, the adjunction map from any `B'`-module to the compatible pairs of its scalar
extensions to `B` and `A'` is surjective. In general this map is not injective. -/
@[stacks 08IG]
public theorem compatiblePairs_adjunctionMap_surjective_and_not_injective_in_general :
    (∀ (A A' B : Type u) [CommRing A] [CommRing A'] [CommRing B]
      (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
      (s : RingFibreProduct.Situation toBase surjection I),
      let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
      let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
      let comm : toBase.comp toB = surjection.comp toA' := by
        exact congrArg CommRingCat.Hom.hom s.pullbackCone.condition
      ∃ (F : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} toBase)
            (ModuleCat.extendScalars.{u, u, u} surjection) ⥤ ModuleCat.{u} s.fibreProduct)
        (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
        (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F),
        (∀ (L : ModuleCat.{u} s.fibreProduct) (X) (h : L ⟶ F.obj X) (l : L),
          (e X (h l)).1.1 =
              ((adj.homEquiv L X).symm h).fst
                ((1 : B) ⊗ₜ[s.fibreProduct,toB] l) ∧
            (e X (h l)).1.2 =
              ((adj.homEquiv L X).symm h).snd
                ((1 : A') ⊗ₜ[s.fibreProduct,toA'] l)) ∧
          IsIso adj.counit ∧ ∀ L, Function.Surjective (adj.unit.app L)) ∧
      ∃ (A A' B : Type u) (_ : CommRing A) (_ : CommRing A') (_ : CommRing B)
        (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
        (s : RingFibreProduct.Situation toBase surjection I),
        let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
        let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
        let comm : toBase.comp toB = surjection.comp toA' := by
          exact congrArg CommRingCat.Hom.hom s.pullbackCone.condition
        ∃ (F : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} toBase)
              (ModuleCat.extendScalars.{u, u, u} surjection) ⥤ ModuleCat.{u} s.fibreProduct)
          (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
          (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F)
          (L : ModuleCat.{u} s.fibreProduct),
          (∀ (N : ModuleCat.{u} s.fibreProduct) (X) (h : N ⟶ F.obj X) (l : N),
            (e X (h l)).1.1 =
                ((adj.homEquiv N X).symm h).fst
                  ((1 : B) ⊗ₜ[s.fibreProduct,toB] l) ∧
              (e X (h l)).1.2 =
                ((adj.homEquiv N X).symm h).snd
                  ((1 : A') ⊗ₜ[s.fibreProduct,toA'] l)) ∧
            IsIso adj.counit ∧ ¬ Function.Injective (adj.unit.app L) := by
  constructor
  · intro A A' B _ _ _ toBase surjection I s
    obtain ⟨F, e, adj, h, hiso⟩ :=
      compatiblePairsRightAdjoint_counit_isIso toBase surjection I s
    exact ⟨F, e, adj, h, hiso, surjAdjUnit toBase surjection I s F e adj h⟩
  · refine ⟨ULift.{u} (ZMod 2), ULift.{u} (ZMod 4), ULift.{u} (ZMod 4),
        inferInstance, inferInstance, inferInstance, liftedReduction, liftedReduction,
        RingHom.ker liftedReduction, liftedSituation, ?_⟩
    dsimp only
    obtain ⟨F, e, adj, h, hiso⟩ :=
      compatiblePairsRightAdjoint_counit_isIso
        liftedReduction liftedReduction (RingHom.ker liftedReduction) liftedSituation
    let L : ModuleCat.{u} DLift := ModuleCat.of DLift (DLift ⧸ JLift)
    exact ⟨F, e, adj, L, h, hiso, noninjAdjUnit liftedReduction liftedReduction
      (RingHom.ker liftedReduction) liftedSituation F e adj h L (Ideal.Quotient.mk JLift xLift)
      xLiftNeZero tensorXLift_toB_zero tensorXLift_toA'_zero⟩

end MilnorPatching
