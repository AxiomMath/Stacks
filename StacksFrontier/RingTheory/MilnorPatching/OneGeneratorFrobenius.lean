module

public import Mathlib
public import StacksFrontier.RingTheory.FibreProduct
public import StacksFrontier.RingTheory.LocalCohomology.Frobenius

/-!
# Patching along one generator, with a Frobenius splitting

Let `A` be a commutative ring, let `f : A` and let `J ⊆ A` be an ideal annihilated by `f ^ n`.
This file assembles the ring-theoretic data of the square

```
A ⧸ (J ⊓ fA) ---> A ⧸ J
     |               |
     v               v
   A ⧸ fA  ---> A ⧸ (J + fA)
```

together with two further pieces of structure that the annihilation hypothesis buys: the
intersection `J ⊓ fA` is nilpotent of exponent at most `n + 1`, and in characteristic `p` a
large enough power of the Frobenius therefore factors through the quotient by it.

## Main results

* `MilnorPatching.OneGeneratorFrobenius.pow_inf_span_singleton_eq_bot`: the intersection
  `J ⊓ fA` satisfies `(J ⊓ fA) ^ (n + 1) = ⊥`, with the elementwise consequences
  `pow_eq_zero_of_mem_inf` and `pow_eq_zero_of_mem_inf_of_le`.
* `MilnorPatching.OneGeneratorFrobenius.betaHom`: the ring homomorphism
  `A ⧸ (J ⊓ fA) →+* A` sending the class of `x` to `x ^ p ^ N`, defined whenever
  `(p : A) = 0` and `n + 1 ≤ p ^ N`. Both composites with the quotient map are the
  `p ^ N`-power endomorphism `frobeniusPow`, by `betaHom_comp_mk` and `mk_comp_betaHom`.
* `MilnorPatching.OneGeneratorFrobenius.situation`: the square above is a fibre product
  situation in the sense of `RingFibreProduct.Situation` (Stacks Tag 08KH), with the kernel of
  `A ⧸ fA → A ⧸ (J + fA)` the image of `J`.
* `MilnorPatching.OneGeneratorFrobenius.fibreProductEquiv`: the fourth corner of that square is
  `A ⧸ (J ⊓ fA)`, by the canonical comparison map; `fibreProductEquiv_fst` and
  `fibreProductEquiv_snd` identify its two components with the two quotient maps.

## References

* [Stacks Project, Tag 0EVG](https://stacks.math.columbia.edu/tag/0EVG)
* [Stacks Project, Tag 08KH](https://stacks.math.columbia.edu/tag/08KH)
-/

@[expose] public section

universe u

namespace MilnorPatching.OneGeneratorFrobenius

/-! ### Nilpotence of the intersection -/

section Nilpotence

variable {A : Type u} [CommRing A] {f : A} {J : Ideal A} {n : ℕ}

/-- If `f ^ n` annihilates the ideal `J`, then the intersection of `J` with the principal ideal
generated by `f` satisfies `(J ⊓ fA) ^ (n + 1) = ⊥`. -/
public theorem pow_inf_span_singleton_eq_bot (hann : ∀ x ∈ J, f ^ n * x = 0) :
    (J ⊓ Ideal.span {f}) ^ (n + 1) = ⊥ := by
  refine le_antisymm ?_ bot_le
  calc (J ⊓ Ideal.span {f}) ^ (n + 1)
      = (J ⊓ Ideal.span {f}) ^ n * (J ⊓ Ideal.span {f}) := pow_succ _ _
    _ ≤ Ideal.span {f} ^ n * J :=
        Ideal.mul_mono (Ideal.pow_right_mono inf_le_right n) inf_le_left
    _ = Ideal.span {f ^ n} * J := by rw [Ideal.span_singleton_pow]
    _ ≤ ⊥ := Ideal.mul_le.mpr fun r hr s hs => by
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hr
        refine Ideal.mem_bot.mpr ?_
        calc f ^ n * c * s = f ^ n * s * c := by ring
          _ = 0 := by rw [hann s hs, zero_mul]

/-- Every element of `J ⊓ fA` has vanishing `(n + 1)`-st power, `f ^ n` annihilating `J`. -/
public theorem pow_eq_zero_of_mem_inf (hann : ∀ x ∈ J, f ^ n * x = 0) {x : A}
    (hx : x ∈ J ⊓ Ideal.span {f}) : x ^ (n + 1) = 0 := by
  have hmem := Ideal.pow_mem_pow hx (n + 1)
  rw [pow_inf_span_singleton_eq_bot hann] at hmem
  exact Ideal.mem_bot.mp hmem

/-- Every element of `J ⊓ fA` has vanishing `k`-th power for every exponent `k ≥ n + 1`, `f ^ n`
annihilating `J`. -/
public theorem pow_eq_zero_of_mem_inf_of_le (hann : ∀ x ∈ J, f ^ n * x = 0) {k : ℕ}
    (hk : n + 1 ≤ k) {x : A} (hx : x ∈ J ⊓ Ideal.span {f}) : x ^ k = 0 := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [pow_add, pow_eq_zero_of_mem_inf hann hx, zero_mul]

end Nilpotence

/-! ### The Frobenius factorisation -/

section Frobenius

/-- The `p ^ N`-power endomorphism of a commutative ring in which the prime `p` vanishes: the
`N`-th power, in the monoid of ring endomorphisms, of the Frobenius
`Stacks.LocalCohomology.frobeniusOfNatCastEqZero`. -/
public noncomputable def frobeniusPow (R : Type u) [CommRing R] (p : ℕ) [Fact p.Prime]
    (hp : (p : R) = 0) (N : ℕ) : R →+* R :=
  Stacks.LocalCohomology.frobeniusOfNatCastEqZero R p Fact.out hp ^ N

/-- The `p ^ N`-power endomorphism raises to the `p ^ N`-th power. -/
@[simp] public theorem frobeniusPow_apply (R : Type u) [CommRing R] (p : ℕ) [Fact p.Prime]
    (hp : (p : R) = 0) (N : ℕ) (x : R) : frobeniusPow R p hp N x = x ^ p ^ N := by
  have h : ⇑(Stacks.LocalCohomology.frobeniusOfNatCastEqZero R p Fact.out hp)
      = fun y : R => y ^ p := rfl
  have h2 : frobeniusPow R p hp N x
      = (⇑(Stacks.LocalCohomology.frobeniusOfNatCastEqZero R p Fact.out hp))^[N] x := by
    rw [frobeniusPow, ← RingHom.coe_pow]
  rw [h2, h, pow_iterate]

variable {A : Type u} [CommRing A] {f : A} {J : Ideal A} {n : ℕ}

/-- The prime `p` vanishes in `A ⧸ (J ⊓ fA)` as soon as it vanishes in `A`. -/
public theorem natCast_quotient_eq_zero (f : A) (J : Ideal A) {p : ℕ} (hp : (p : A) = 0) :
    (p : A ⧸ (J ⊓ Ideal.span {f})) = 0 := by
  rw [← map_natCast (Ideal.Quotient.mk (J ⊓ Ideal.span {f})) p, hp, map_zero]

/-- If `f ^ n` annihilates `J`, if the prime `p` vanishes in `A` and if `n + 1 ≤ p ^ N`, the ring
homomorphism `A ⧸ (J ⊓ fA) →+* A` induced by the `p ^ N`-power endomorphism of `A`. -/
public noncomputable def betaHom (hann : ∀ x ∈ J, f ^ n * x = 0) (p : ℕ) [Fact p.Prime]
    (hp : (p : A) = 0) (N : ℕ) (hN : n + 1 ≤ p ^ N) :
    (A ⧸ (J ⊓ Ideal.span {f})) →+* A :=
  Ideal.Quotient.lift _ (frobeniusPow A p hp N) fun a ha => by
    rw [frobeniusPow_apply]
    exact pow_eq_zero_of_mem_inf_of_le hann hN ha

/-- The Frobenius factorisation sends the class of `x` to `x ^ p ^ N`. -/
@[simp] public theorem betaHom_mk (hann : ∀ x ∈ J, f ^ n * x = 0) (p : ℕ) [Fact p.Prime]
    (hp : (p : A) = 0) (N : ℕ) (hN : n + 1 ≤ p ^ N) (x : A) :
    betaHom hann p hp N hN (Ideal.Quotient.mk (J ⊓ Ideal.span {f}) x) = x ^ p ^ N := by
  rw [betaHom, Ideal.Quotient.lift_mk, frobeniusPow_apply]

/-- Precomposing the Frobenius factorisation with the quotient map recovers the `p ^ N`-power
endomorphism of `A`. -/
public theorem betaHom_comp_mk (hann : ∀ x ∈ J, f ^ n * x = 0) (p : ℕ) [Fact p.Prime]
    (hp : (p : A) = 0) (N : ℕ) (hN : n + 1 ≤ p ^ N) :
    (betaHom hann p hp N hN).comp (Ideal.Quotient.mk (J ⊓ Ideal.span {f}))
      = frobeniusPow A p hp N := by
  ext x
  simp

/-- Postcomposing the Frobenius factorisation with the quotient map gives the `p ^ N`-power
endomorphism of `A ⧸ (J ⊓ fA)`. -/
public theorem mk_comp_betaHom (hann : ∀ x ∈ J, f ^ n * x = 0) (p : ℕ) [Fact p.Prime]
    (hp : (p : A) = 0) (N : ℕ) (hN : n + 1 ≤ p ^ N) :
    (Ideal.Quotient.mk (J ⊓ Ideal.span {f})).comp (betaHom hann p hp N hN)
      = frobeniusPow (A ⧸ (J ⊓ Ideal.span {f})) p (natCast_quotient_eq_zero f J hp) N := by
  ext x
  simp [map_pow]

end Frobenius

/-! ### The Milnor square and its fourth corner -/

section Square

variable {A : Type u} [CommRing A]

/-- The map `A ⧸ J → A ⧸ (J + fA)` of the Milnor square. -/
public def toBase (f : A) (J : Ideal A) : (A ⧸ J) →+* (A ⧸ (J ⊔ Ideal.span {f})) :=
  Ideal.Quotient.factor le_sup_left

/-- The surjection `A ⧸ fA → A ⧸ (J + fA)` of the Milnor square. -/
public def surjection (f : A) (J : Ideal A) :
    (A ⧸ Ideal.span {f}) →+* (A ⧸ (J ⊔ Ideal.span {f})) :=
  Ideal.Quotient.factor le_sup_right

/-- `toBase` is the identity on representatives. -/
@[simp] public theorem toBase_mk (f : A) (J : Ideal A) (x : A) :
    toBase f J (Ideal.Quotient.mk J x) = Ideal.Quotient.mk (J ⊔ Ideal.span {f}) x :=
  Ideal.Quotient.factor_mk _ _

/-- `surjection` is the identity on representatives. -/
@[simp] public theorem surjection_mk (f : A) (J : Ideal A) (x : A) :
    surjection f J (Ideal.Quotient.mk (Ideal.span {f}) x)
      = Ideal.Quotient.mk (J ⊔ Ideal.span {f}) x :=
  Ideal.Quotient.factor_mk _ _

/-- The square of quotient maps of `A` along `J` and along `fA` is a ring fibre product situation
in the sense of Stacks Tag 08KH: the map `A ⧸ fA → A ⧸ (J + fA)` is surjective with kernel the
image of `J`. -/
public theorem situation (f : A) (J : Ideal A) :
    RingFibreProduct.Situation (toBase f J) (surjection f J)
      (Ideal.map (Ideal.Quotient.mk (Ideal.span {f})) J) where
  surjective_surjection := Ideal.Quotient.factor_surjective _
  ker_surjection := by
    apply Ideal.comap_injective_of_surjective (Ideal.Quotient.mk (Ideal.span {f}))
      Ideal.Quotient.mk_surjective
    have h1 : Ideal.comap (Ideal.Quotient.mk (Ideal.span {f}))
        (RingHom.ker (surjection f J)) = J ⊔ Ideal.span {f} := by
      ext x
      simp only [Ideal.mem_comap, RingHom.mem_ker, surjection_mk,
        Ideal.Quotient.eq_zero_iff_mem]
    have h2 : Ideal.comap (Ideal.Quotient.mk (Ideal.span {f}))
        (Ideal.map (Ideal.Quotient.mk (Ideal.span {f})) J) = J ⊔ Ideal.span {f} := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
      change J ⊔ RingHom.ker (Ideal.Quotient.mk (Ideal.span {f})) = J ⊔ Ideal.span {f}
      rw [Ideal.mk_ker]
    rw [h1, h2]

/-- The canonical map from `A` to the fibre product `A ⧸ J ×_{A ⧸ (J + fA)} A ⧸ fA`, given by the
pair of quotient maps. -/
public def toPullback (f : A) (J : Ideal A) :
    A →+* ↥(RingHom.pullback (toBase f J) (surjection f J)) where
  toFun a := ⟨(Ideal.Quotient.mk J a, Ideal.Quotient.mk (Ideal.span {f}) a), by
    simp [RingHom.mem_eqLocus]⟩
  map_one' := by ext <;> simp
  map_mul' a b := by ext <;> simp
  map_zero' := by ext <;> simp
  map_add' a b := by ext <;> simp

/-- The kernel of the canonical map to the fibre product is exactly `J ⊓ fA`. -/
public theorem ker_toPullback (f : A) (J : Ideal A) :
    RingHom.ker (toPullback f J) = J ⊓ Ideal.span {f} := by
  ext x
  rw [RingHom.mem_ker, Subtype.ext_iff, Prod.ext_iff]
  simp [toPullback, Ideal.Quotient.eq_zero_iff_mem]

/-- The canonical map to the fibre product is surjective. -/
public theorem surjective_toPullback (f : A) (J : Ideal A) :
    Function.Surjective (toPullback f J) := by
  rintro ⟨⟨x, y⟩, hxy⟩
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective (I := J) x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective (I := Ideal.span {f}) y
  rw [RingHom.mem_eqLocus] at hxy
  simp only [RingHom.coe_comp, Function.comp_apply, RingHom.coe_fst, RingHom.coe_snd,
    toBase_mk, surjection_mk, Ideal.Quotient.mk_eq_mk_iff_sub_mem] at hxy
  obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.mp hxy
  refine ⟨b - i, Subtype.ext (Prod.ext ?_ ?_)⟩
  · simpa [toPullback, Ideal.Quotient.eq_zero_iff_mem] using hi
  · have hba : b - i - a = j := by linear_combination -hij
    simpa only [toPullback, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk,
      Ideal.Quotient.mk_eq_mk_iff_sub_mem, hba] using hj

/-- The isomorphism from `A ⧸ (J ⊓ fA)` to the fibre product `A ⧸ J ×_{A ⧸ (J + fA)} A ⧸ fA`
induced by the canonical map from `A`. -/
public noncomputable def fibreProductEquiv (f : A) (J : Ideal A) :
    (A ⧸ (J ⊓ Ideal.span {f})) ≃+* ↥(RingHom.pullback (toBase f J) (surjection f J)) :=
  (Ideal.quotEquivOfEq (ker_toPullback f J).symm).trans
    (RingHom.quotientKerEquivOfSurjective (surjective_toPullback f J))

/-- The isomorphism onto the fibre product is the canonical map: on the class of `x` it is the
pair of classes of `x`. -/
@[simp] public theorem fibreProductEquiv_mk (f : A) (J : Ideal A) (x : A) :
    fibreProductEquiv f J (Ideal.Quotient.mk (J ⊓ Ideal.span {f}) x) = toPullback f J x :=
  RingHom.quotientKerEquivOfSurjective_apply_mk (surjective_toPullback f J) x

/-- The first component of the isomorphism onto the fibre product is the quotient map
`A ⧸ (J ⊓ fA) → A ⧸ J`. -/
@[simp] public theorem fibreProductEquiv_fst (f : A) (J : Ideal A)
    (z : A ⧸ (J ⊓ Ideal.span {f})) :
    ((fibreProductEquiv f J z : (A ⧸ J) × (A ⧸ Ideal.span {f}))).1
      = Ideal.Quotient.factor inf_le_left z := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp [toPullback]

/-- The second component of the isomorphism onto the fibre product is the quotient map
`A ⧸ (J ⊓ fA) → A ⧸ fA`. -/
@[simp] public theorem fibreProductEquiv_snd (f : A) (J : Ideal A)
    (z : A ⧸ (J ⊓ Ideal.span {f})) :
    ((fibreProductEquiv f J z : (A ⧸ J) × (A ⧸ Ideal.span {f}))).2
      = Ideal.Quotient.factor inf_le_right z := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp [toPullback]

end Square

end MilnorPatching.OneGeneratorFrobenius

end
