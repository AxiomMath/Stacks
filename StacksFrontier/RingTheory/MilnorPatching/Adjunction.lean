module

public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.LocalRing.Pullback
public import StacksFrontier.RingTheory.FibreProduct
public import StacksFrontier.RingTheory.MilnorPatching.ModuleCategory
public import StacksFrontier.RingTheory.Localization.Glueing.CategoricalPullback

/-!
# The counit of the patching adjunction is invertible

Let `B' = B ×_A A'` be a fibre product of rings in which `A' → A` is surjective.  Gluing a
compatible pair of a `B`-module and an `A'`-module and then extending scalars again returns the
pair one started with: the counit of the adjunction between extension of scalars into the
categorical pullback and its right adjoint is an isomorphism.  Equivalently, the right adjoint is
fully faithful, so the category of compatible pairs is a full subcategory of `Mod B'` up to
equivalence.

## Main results

* `MilnorPatching.compatiblePairsRightAdjoint_counit_isIso_of_surjective` proves the counit is
  invertible whenever the map `A' → A` of the square is surjective.
* `MilnorPatching.compatiblePairsRightAdjoint_counit_isIso` is Stacks Tag 07RU: the same
  conclusion phrased for a ring fibre product situation.

## Implementation notes

Invertibility of the counit is checked componentwise.  On the `B` side the comparison map is
bijective because the relevant element of `A ⊗_B N` is a single tensor `1 ⊗ₜ n`; on the `A'` side
it is only surjective, and the two facts together suffice because a morphism of compatible pairs
whose first component is bijective and whose second is surjective is an isomorphism.

## References

* [Stacks Project, Tag 07RU](https://stacks.math.columbia.edu/tag/07RU)
-/

section

open CategoryTheory
open CategoryTheory.Limits
open scoped ChangeOfRings
open ModuleGlueing

universe u

namespace MilnorPatching
open scoped TensorProduct

set_option backward.isDefEq.respectTransparency false

/-- The tensor `1 ⊗ r • l` is the tensor `f r ⊗ l`. -/
private lemma one_tmul_smul_eq {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (r : R)
    {L : Type*} [AddCommGroup L] [Module R L] (l : L) :
    (1 : S) ⊗ₜ[R,f] (r • l) = f r ⊗ₜ[R,f] l := by
  let : Module R S := Module.compHom S f
  change (1 : S) ⊗ₜ[R] (r • l) = f r ⊗ₜ[R] l
  rw [TensorProduct.tmul_smul]
  change (f r * 1 : S) ⊗ₜ[R] l = f r ⊗ₜ[R] l
  rw [mul_one]

/-- The tensor `s ⊗ m` is `s` times the tensor `1 ⊗ m`. -/
private lemma tmul_eq_smul_one_tmul {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    {M : ModuleCat.{u} R} (s : S) (m : M) :
    s ⊗ₜ[R,f] m = s • ((1 : S) ⊗ₜ[R,f] m) := by
  rw [ModuleCat.ExtendScalars.smul_tmul, mul_one]

/-- Scalar extension along a surjection is generated by the tensors with coefficient one. -/
public lemma tensorUnit_surjective {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : Function.Surjective f)
    (L : Type*) [AddCommGroup L] [Module R L] :
    Function.Surjective (fun l : L => (1 : S) ⊗ₜ[R,f] l) := by
  intro z
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul s l =>
    obtain ⟨r, rfl⟩ := hf s
    exact ⟨r • l, one_tmul_smul_eq f r l⟩
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, by simp [TensorProduct.tmul_add]⟩

/-- A ring map `k : T →+* U` read as an `R`-linear map, for the module structures restricted
along `g : R →+* T` and along `k.comp g`. -/
@[expose]
public def tensorRingMapLinear {R T U : Type*} [CommRing R] [CommRing T] [CommRing U]
    (g : R →+* T) (k : T →+* U) :
    letI : Module R T := Module.compHom T g
    letI : Module R U := Module.compHom U (k.comp g)
    T →ₗ[R] U := by
  letI : Module R T := Module.compHom T g
  letI : Module R U := Module.compHom U (k.comp g)
  refine { toFun := k, map_add' := map_add k, map_smul' := fun r t => ?_ }
  change k (g r * t) = (k (g r)) * k t
  exact map_mul k (g r) t

/-- A tensor in the kernel of `rTensor L kl`, for a linear map `kl` agreeing with a surjection
`k : T →+* U` whose kernel is reached by scalars killed by `f`, is the image of an element of
`L` that already dies in `S ⊗[R] L`. -/
public lemma tensorKernelLift {R S T U : Type*} [CommRing R] [CommRing S]
    [CommRing T] [CommRing U] (f : R →+* S) (g : R →+* T) (k : T →+* U)
    (hk : Function.Surjective k)
    (hker : ∀ t : T, k t = 0 → ∃ r : R, f r = 0 ∧ g r = t)
    (L : Type*) [AddCommGroup L] [Module R L] [Module R U]
    (kl : letI : Module R T := Module.compHom T g; T →ₗ[R] U)
    (hkl : ∀ t, kl t = k t) :
    letI : Module R T := Module.compHom T g;
    ∀ z : T ⊗[R] L, (LinearMap.rTensor L kl) z = 0 →
      ∃ l : L, (1 : S) ⊗ₜ[R,f] l = 0 ∧ (1 : T) ⊗ₜ[R,g] l = z := by
  let : Module R T := Module.compHom T g
  intro z hz
  have hsurj : Function.Surjective kl := fun u => (hk u).imp fun t ht => (hkl t).trans ht
  obtain ⟨w, hw⟩ := (rTensor_exact L (LinearMap.exact_subtype_ker_map kl) hsurj z).mp hz
  have hwitness : ∀ w : (LinearMap.ker kl) ⊗[R] L,
      ∃ l : L, (1 : S) ⊗ₜ[R,f] l = 0 ∧
        (1 : T) ⊗ₜ[R,g] l =
          (LinearMap.rTensor L (LinearMap.ker kl).subtype) w := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp, by simp⟩
    | tmul t l =>
      obtain ⟨r, hfr, hgr⟩ := hker t.1 ((hkl t.1).symm.trans t.2)
      refine ⟨r • l, ?_, ?_⟩
      · rw [one_tmul_smul_eq, hfr]
        simp
      · rw [one_tmul_smul_eq, LinearMap.rTensor_tmul, hgr]
        rfl
    | add x y hx hy =>
      obtain ⟨a, ha0, ha1⟩ := hx
      obtain ⟨b, hb0, hb1⟩ := hy
      refine ⟨a + b, ?_, ?_⟩ <;> simp [TensorProduct.tmul_add, ha0, hb0, ha1, hb1]
  exact (hwitness w).imp fun l hl => ⟨hl.1, hl.2.trans hw⟩

/-- Extending scalars twice agrees with extending along the composite: the comparison
isomorphism carries the pushforward of a tensor along `tensorRingMapLinear` to the tensor
with coefficient one. -/
public lemma extendScalarsComp_rTensor {R T U : Type u} [CommRing R] [CommRing T] [CommRing U]
    (g : R →+* T) (k : T →+* U) (L : ModuleCat.{u} R) :
    letI : Module R T := Module.compHom T g;
    letI : Module R U := Module.compHom U (k.comp g);
    ∀ z : (ModuleCat.extendScalars g).obj L,
      (ModuleCat.extendScalarsComp g k).hom.app L
        ((LinearMap.rTensor L (tensorRingMapLinear g k)) z) =
      (1 : U) ⊗ₜ[T,k] z := by
  let : Module R T := Module.compHom T g
  let : Module R U := Module.compHom U (k.comp g)
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp only [map_zero, TensorProduct.tmul_zero]
  | tmul t l =>
    rw [LinearMap.rTensor_tmul]
    calc
      (ModuleCat.extendScalarsComp g k).hom.app L ((tensorRingMapLinear g k) t ⊗ₜ[R] l)
          = (k t) • ((ModuleCat.extendScalarsComp g k).hom.app L
              ((1 : U) ⊗ₜ[R,k.comp g] l)) := by
              change (ModuleCat.extendScalarsComp g k).hom.app L
                ((k t) ⊗ₜ[R,k.comp g] l) = _
              rw [tmul_eq_smul_one_tmul (k.comp g), map_smul]
      _ = (k t) • ((1 : U) ⊗ₜ[T,k] ((1 : T) ⊗ₜ[R,g] l)) := by
            rw [ModuleCat.extendScalarsComp_hom_app_one_tmul]
      _ = (1 : U) ⊗ₜ[T,k] (t ⊗ₜ[R,g] l) := by
            rw [tmul_eq_smul_one_tmul g t l]
            let : Module T U := Module.compHom U k
            rw [TensorProduct.tmul_smul]
            rfl
  | add x y hx hy =>
    simp only [map_add, TensorProduct.tmul_add, hx, hy]

/-- When `k` is surjective, every element of `X.fst` is the first coordinate of a compatible
pair. -/
public lemma compatiblePairsModule_exists_fst_eq
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g) (hk : Function.Surjective k)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k)) (n : X.fst) :
    ∃ p : compatiblePairsModule f g h k comm X, p.1.1 = n := by
  let : Module S U := Module.compHom U h
  let : Module T U := Module.compHom U k
  obtain ⟨m, hm⟩ := tensorUnit_surjective k hk X.snd (X.iso.hom ((1 : U) ⊗ₜ[S] n))
  exact ⟨⟨(n, m), hm.symm⟩, rfl⟩

/-- A map out of the scalar extension of the compatible pairs, sending `1 ⊗ p` to the second
coordinate of `p`, sends `t ⊗ p` to `t • p.2`. -/
public lemma compatiblePairs_snd_tmul
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k))
    (c : (ModuleCat.extendScalars g).obj
      (compatiblePairsModule f g h k comm X) ⟶ X.snd)
    (hc : ∀ p, c ((1 : T) ⊗ₜ[R,g] p) = p.1.2)
    (t : T) (p : compatiblePairsModule f g h k comm X) :
    c (t ⊗ₜ[R,g] p) = t • p.1.2 := by
  rw [tmul_eq_smul_one_tmul g t p, map_smul]
  exact congrArg (t • ·) (hc p)

/-- A map out of the scalar extension of the compatible pairs to `X.snd`, sending `1 ⊗ p` to the
second coordinate of `p`, is surjective. -/
public lemma compatiblePairs_snd_surjective
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g) (hk : Function.Surjective k)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k))
    (c : (ModuleCat.extendScalars g).obj
      (compatiblePairsModule f g h k comm X) ⟶ X.snd)
    (hc : ∀ p, c ((1 : T) ⊗ₜ[R,g] p) = p.1.2) :
    Function.Surjective c := by
  let : Module R T := Module.compHom T g
  let : Module S U := Module.compHom U h
  let : Module T U := Module.compHom U k
  let P := compatiblePairsModule f g h k comm X
  change ModuleCat.of T (T ⊗[R] P) ⟶ X.snd at c
  have hct : ∀ (t : T) (p : P), c (t ⊗ₜ[R] p) = t • p.1.2 :=
    compatiblePairs_snd_tmul f g h k comm X c hc
  have hmod : ∀ z : (ModuleCat.extendScalars h).obj X.fst,
      ∃ w : T ⊗[R] P, X.iso.hom z = (1 : U) ⊗ₜ[T] (c w) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul a n =>
      obtain ⟨t, rfl⟩ := hk a
      obtain ⟨p, rfl⟩ := compatiblePairsModule_exists_fst_eq f g h k comm hk X n
      refine ⟨t ⊗ₜ[R] p, ?_⟩
      rw [hct]
      rw [tmul_eq_smul_one_tmul h (k t) p.1.1, map_smul, p.2,
        TensorProduct.tmul_smul (R := T) (R' := T)]
      change _ = (k t * 1) ⊗ₜ[T] p.1.2
      exact ModuleCat.ExtendScalars.smul_tmul k (k t) 1 p.1.2
    | add x y hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by simp [ha, hb, TensorProduct.tmul_add]⟩
  intro m
  obtain ⟨w, hw⟩ := hmod (X.iso.inv ((1 : U) ⊗ₜ[T] m))
  have hm : (1 : U) ⊗ₜ[T] m = (1 : U) ⊗ₜ[T] (c w) := by
    simpa only [← ConcreteCategory.comp_apply, X.iso.inv_hom_id,
      ConcreteCategory.id_apply] using hw
  let p : P := ⟨(0, m - c w), by
    show X.iso.hom ((1 : U) ⊗ₜ[S] 0) = (1 : U) ⊗ₜ[T] (m - c w)
    simp only [TensorProduct.tmul_zero, map_zero, TensorProduct.tmul_sub, hm, sub_self]⟩
  refine ⟨w + (1 : T) ⊗ₜ[R] p, ?_⟩
  rw [map_add]
  calc
    _ = c w + p.1.2 := congrArg (c w + ·) (hc p)
    _ = m := by
      show c w + (m - c w) = m
      abel

/-- Multiplying by a scalar of `T` killed by `k` lands in the second coordinates of compatible
pairs with zero first coordinate that die in `S ⊗[R] P`. -/
public lemma compatiblePairsModule_exists_of_ker
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g) (hk : Function.Surjective k)
    (hker : ∀ t : T, k t = 0 → ∃ r : R, f r = 0 ∧ g r = t)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k))
    (c : (ModuleCat.extendScalars g).obj
      (compatiblePairsModule f g h k comm X) ⟶ X.snd)
    (hc : ∀ p, c ((1 : T) ⊗ₜ[R,g] p) = p.1.2) (t : T) (ht : k t = 0) (m : X.snd) :
    ∃ p : compatiblePairsModule f g h k comm X,
      p.1.1 = 0 ∧ p.1.2 = t • m ∧ (1 : S) ⊗ₜ[R,f] p = 0 := by
  let : Module R S := Module.compHom S f
  let : Module R T := Module.compHom T g
  let : Module R X.fst := Module.compHom X.fst f
  let : Module R X.snd := Module.compHom X.snd g
  let P := compatiblePairsModule f g h k comm X
  change ModuleCat.of T (T ⊗[R] P) ⟶ X.snd at c
  have hcs : Function.Surjective c := compatiblePairs_snd_surjective f g h k comm hk X c hc
  have hct : ∀ (t : T) (p : P), c (t ⊗ₜ[R] p) = t • p.1.2 :=
    compatiblePairs_snd_tmul f g h k comm X c hc
  obtain ⟨z, rfl⟩ := hcs m
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, rfl, by simp, by simp⟩
  | tmul a p =>
    obtain ⟨r, hrS, hrT⟩ := hker (t * a) (by simp [ht])
    refine ⟨r • p, ?_, ?_, ?_⟩
    · show f r • p.1.1 = 0
      rw [hrS, zero_smul]
    · show g r • p.1.2 = t • c (a ⊗ₜ[R] p)
      rw [hrT, hct, mul_smul]
    · rw [one_tmul_smul_eq, hrS]
      simp
  | add x y hx hy =>
    obtain ⟨p, hp0, hp1, hp2⟩ := hx
    obtain ⟨q, hq0, hq1, hq2⟩ := hy
    refine ⟨p + q, ?_, ?_, ?_⟩
    · show p.1.1 + q.1.1 = 0
      rw [hp0, hq0, add_zero]
    · show p.1.2 + q.1.2 = t • c (x + y)
      rw [hp1, hq1, map_add, smul_add]
    · rw [TensorProduct.tmul_add, hp2, hq2, add_zero]

/-- If `k` is surjective and every multiple of `ker k` is the second coordinate of a compatible
pair with zero first coordinate dying in `S ⊗[R] P`, then every compatible pair with zero first
coordinate dies in `S ⊗[R] P`. -/
public lemma compatiblePairsModule_tmul_eq_zero_of_fst_eq_zero
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g) (hk : Function.Surjective k)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k))
    (hkill : ∀ t : T, k t = 0 → ∀ m : X.snd,
      ∃ p : compatiblePairsModule f g h k comm X,
        p.1.1 = 0 ∧ p.1.2 = t • m ∧ (1 : S) ⊗ₜ[R,f] p = 0)
    (p : compatiblePairsModule f g h k comm X) (hp0 : p.1.1 = 0) :
    (1 : S) ⊗ₜ[R,f] p = 0 := by
  let : Module R S := Module.compHom S f
  let : Module T U := Module.compHom U k
  let P := compatiblePairsModule f g h k comm X
  let kl : T →ₗ[T] U := tensorRingMapLinear (RingHom.id T) k
  have hz : (LinearMap.rTensor X.snd kl) ((1 : T) ⊗ₜ[T] p.1.2) = 0 := by
    rw [LinearMap.rTensor_tmul]
    show k 1 ⊗ₜ[T] p.1.2 = 0
    rw [map_one, ← p.2, hp0, TensorProduct.tmul_zero, map_zero]
  obtain ⟨w, hw⟩ := (rTensor_exact X.snd (LinearMap.exact_subtype_ker_map kl) hk _).mp hz
  have hl : ∀ w : (LinearMap.ker kl) ⊗[T] X.snd,
      ∃ q : P, q.1.1 = 0 ∧
        q.1.2 = (TensorProduct.lid T X.snd)
          ((LinearMap.rTensor X.snd (LinearMap.ker kl).subtype) w) ∧
        (1 : S) ⊗ₜ[R] q = 0 := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => exact ⟨0, rfl, by simp, by simp⟩
    | tmul t m =>
      simpa only [LinearMap.rTensor_tmul, Submodule.subtype_apply,
        TensorProduct.lid_tmul] using hkill t.1 t.2 m
    | add x y hx hy =>
      obtain ⟨p, hp0, hp1, hp2⟩ := hx
      obtain ⟨q, hq0, hq1, hq2⟩ := hy
      refine ⟨p + q, ?_, ?_, ?_⟩
      · show p.1.1 + q.1.1 = 0
        rw [hp0, hq0, add_zero]
      · show p.1.2 + q.1.2 = _
        rw [hp1, hq1, map_add, map_add]
      · rw [TensorProduct.tmul_add, hp2, hq2, add_zero]
  obtain ⟨q, hq0, hq1, hq2⟩ := hl w
  have hqp : q = p := Subtype.ext (Prod.ext (hq0.trans hp0.symm)
    (by simpa only [hw, TensorProduct.lid_tmul, one_smul] using hq1))
  exact hqp ▸ hq2

-- The first projection is a quotient, and the second projection generates its target.
private lemma compatiblePairs_fst_bijective_snd_surjective
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g)
    (hf : Function.Surjective f) (hk : Function.Surjective k)
    (hker : ∀ t : T, k t = 0 → ∃ r : R, f r = 0 ∧ g r = t)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k))
    (b : (ModuleCat.extendScalars f).obj
      (compatiblePairsModule f g h k comm X) ⟶ X.fst)
    (c : (ModuleCat.extendScalars g).obj
      (compatiblePairsModule f g h k comm X) ⟶ X.snd)
    (hb : ∀ p, b ((1 : S) ⊗ₜ[R,f] p) = p.1.1)
    (hc : ∀ p, c ((1 : T) ⊗ₜ[R,g] p) = p.1.2) :
    Function.Bijective b ∧ Function.Surjective c := by
  refine ⟨⟨(injective_iff_map_eq_zero b.hom).mpr fun z hz => ?_, fun n => ?_⟩,
    compatiblePairs_snd_surjective f g h k comm hk X c hc⟩
  · obtain ⟨p, rfl⟩ := tensorUnit_surjective f hf _ z
    exact compatiblePairsModule_tmul_eq_zero_of_fst_eq_zero f g h k comm hk X
      (compatiblePairsModule_exists_of_ker f g h k comm hk hker X c hc) p ((hb p).symm.trans hz)
  · obtain ⟨p, hp⟩ := compatiblePairsModule_exists_fst_eq f g h k comm hk X n
    exact ⟨(1 : S) ⊗ₜ[R,f] p, (hb p).trans hp⟩

-- Once the first component is invertible, the gluing equation detects the remaining kernel.
private lemma compatiblePairs_morphism_isIso
    {R S T U : Type u} [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (k : T →+* U)
    (comm : h.comp f = k.comp g)
    (hf : Function.Surjective f) (hk : Function.Surjective k)
    (hker : ∀ t : T, k t = 0 → ∃ r : R, f r = 0 ∧ g r = t)
    (X : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} h)
      (ModuleCat.extendScalars.{u, u, u} k))
    (d : (extensionOfScalarsToPullback f g h k comm).obj
      (compatiblePairsModule f g h k comm X) ⟶ X)
    (hb : ∀ p, d.fst ((1 : S) ⊗ₜ[R,f] p) = p.1.1)
    (hc : ∀ p, d.snd ((1 : T) ⊗ₜ[R,g] p) = p.1.2) : IsIso d := by
  obtain ⟨hbj, hcs⟩ := compatiblePairs_fst_bijective_snd_surjective f g h k comm hf hk hker X
    d.fst d.snd hb hc
  have : IsIso d.fst := (ConcreteCategory.isIso_iff_bijective _).mpr hbj
  have hi : IsIso
      (((extensionOfScalarsToPullback f g h k comm).obj
        (compatiblePairsModule f g h k comm X)).iso.hom ≫
        (ModuleCat.extendScalars k).map d.snd) := by
    rw [← d.w]
    infer_instance
  have : IsIso ((ModuleCat.extendScalars k).map d.snd) :=
    (isIso_comp_left_iff _ _).mp hi
  apply (CategoricalPullback.isIso_iff _ _ d).mpr
  refine ⟨inferInstance, (ConcreteCategory.isIso_iff_bijective _).mpr ⟨?_, hcs⟩⟩
  refine (injective_iff_map_eq_zero d.snd.hom).mpr fun z hz => ?_
  let P := compatiblePairsModule f g h k comm X
  let : Module R T := Module.compHom T g
  let : Module R U := Module.compHom U (k.comp g)
  have hzouter : (1 : U) ⊗ₜ[T,k] z = 0 := by
    apply ((ConcreteCategory.isIso_iff_bijective _).mp
      (inferInstance : IsIso ((ModuleCat.extendScalars k).map d.snd))).1
    rw [ModuleCat.ExtendScalars.map_tmul, hz, TensorProduct.tmul_zero, map_zero]
  have hzker : (LinearMap.rTensor P (tensorRingMapLinear g k)) z = 0 := by
    have hh := extendScalarsComp_rTensor g k P z
    apply ((ModuleCat.extendScalarsComp g k).app P).toLinearEquiv.injective
    simpa only [Iso.toLinearEquiv_apply, Iso.app_hom, map_zero] using hh.trans hzouter
  obtain ⟨p, hpS, hpT⟩ := tensorKernelLift f g k hk hker P (tensorRingMapLinear g k)
    (fun _ => rfl) z hzker
  have hp0 : p = 0 := by
    refine Subtype.ext (Prod.ext ?_ ?_)
    · show p.1.1 = 0
      rw [← hb, hpS, map_zero]
    · show p.1.2 = 0
      rw [← hc, hpT]
      exact hz
  rw [← hpT, hp0, TensorProduct.tmul_zero]

/-- The counit remains an isomorphism when the upper-left ring maps surjectively onto the
pullback. This applies in particular to the relative square of Tag 08KK. The surjectivity
of `A' → A` is essential to the recovery of both components. -/
public theorem compatiblePairsRightAdjoint_counit_isIso_of_surjective
    {A A' B B' : Type u} [CommRing A] [CommRing A'] [CommRing B] [CommRing B']
    (toBase : B →+* A) (surjection : A' →+* A)
    (toB : B' →+* B) (toA' : B' →+* A')
    (comm : toBase.comp toB = surjection.comp toA')
    (hs : Function.Surjective surjection)
    (hp : Function.Surjective
      (let toPullback : B' →+* RingHom.pullback toBase surjection :=
        RingHom.codRestrict (toB.prod toA') (RingHom.pullback toBase surjection)
          (fun x => DFunLike.congr_fun comm x)
      toPullback)) :
    ∃ (F : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} toBase)
          (ModuleCat.extendScalars.{u, u, u} surjection) ⥤ ModuleCat.{u} B')
      (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
      (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F),
      (∀ (L : ModuleCat.{u} B') (X) (h : L ⟶ F.obj X) (l : L),
          (e X (h l)).1.1 =
              ((adj.homEquiv L X).symm h).fst
                ((1 : B) ⊗ₜ[B',toB] l) ∧
            (e X (h l)).1.2 =
              ((adj.homEquiv L X).symm h).snd
                ((1 : A') ⊗ₜ[B',toA'] l)) ∧
        IsIso adj.counit := by
  have hlift : ∀ (b : B) (a : A'), toBase b = surjection a →
      ∃ r : B', toB r = b ∧ toA' r = a := by
    intro b a ha
    obtain ⟨r, hr⟩ := hp ⟨(b, a), ha⟩
    exact ⟨r, congrArg (fun x => x.1.1) hr, congrArg (fun x => x.1.2) hr⟩
  have hf : Function.Surjective toB := by
    intro b
    obtain ⟨a, ha⟩ := hs (toBase b)
    obtain ⟨r, hr, _⟩ := hlift b a ha.symm
    exact ⟨r, hr⟩
  have hker : ∀ a : A', surjection a = 0 → ∃ r : B', toB r = 0 ∧ toA' r = a :=
    fun a ha => hlift 0 a ((map_zero toBase).trans ha.symm)
  obtain ⟨F, e, adj, _, hformula⟩ :=
    exists_rightAdjoint_extensionOfScalarsToPullback toB toA' toBase surjection comm
  refine ⟨F, fun X => (e X).toEquiv, adj, hformula, ?_⟩
  refine (NatTrans.isIso_iff_isIso_app adj.counit).mpr fun X => ?_
  let E := extensionOfScalarsToPullback toB toA' toBase surjection comm
  let P := compatiblePairsModule toB toA' toBase surjection comm X
  let i : F.obj X ≅ P := (e X).toModuleIso
  let d : E.obj P ⟶ X := E.map i.inv ≫ adj.counit.app X
  have hd : ∀ p : P, d.fst ((1 : B) ⊗ₜ[B',toB] p) = p.1.1 ∧
      d.snd ((1 : A') ⊗ₜ[B',toA'] p) = p.1.2 := by
    intro p
    have hh := hformula (F.obj X) X (𝟙 _) ((e X).symm p)
    rw [adj.homEquiv_symm_id] at hh
    simp only [ConcreteCategory.id_apply, LinearEquiv.apply_symm_apply] at hh
    constructor
    · show (adj.counit.app X).fst
        ((ModuleCat.extendScalars toB).map i.inv ((1 : B) ⊗ₜ[B',toB] p)) = _
      rw [ModuleCat.ExtendScalars.map_tmul]
      exact hh.1.symm
    · show (adj.counit.app X).snd
        ((ModuleCat.extendScalars toA').map i.inv ((1 : A') ⊗ₜ[B',toA'] p)) = _
      rw [ModuleCat.ExtendScalars.map_tmul]
      exact hh.2.symm
  have hi : IsIso d := compatiblePairs_morphism_isIso toB toA' toBase surjection comm
    hf hs hker X d (fun p => (hd p).1) (fun p => (hd p).2)
  exact (isIso_comp_left_iff (E.map i.inv) (adj.counit.app X)).mp hi

/-- **Stacks Project, Tag 07RU.** For a fibre product `B' = B ×_A A'` with `A' → A`
surjective, the compatible-pairs construction is right adjoint to extension of scalars from
`B'`.  The counit is an isomorphism, so scalar extension of the compatible-pairs module to
`B` and to `A'` canonically recovers the original two modules. -/
@[stacks 07RU]
public theorem compatiblePairsRightAdjoint_counit_isIso
    {A A' B : Type u} [CommRing A] [CommRing A'] [CommRing B]
    (toBase : B →+* A) (surjection : A' →+* A) (I : Ideal A')
    (s : RingFibreProduct.Situation toBase surjection I) :
    let toB : s.fibreProduct →+* B := s.pullbackCone.fst.hom
    let toA' : s.fibreProduct →+* A' := s.pullbackCone.snd.hom
    let comm : toBase.comp toB = surjection.comp toA' := by
      exact congrArg CommRingCat.Hom.hom s.pullbackCone.condition
    ∃ (F : CategoricalPullback (ModuleCat.extendScalars.{u, u, u} toBase)
          (ModuleCat.extendScalars.{u, u, u} surjection) ⥤ ModuleCat.{u} s.fibreProduct)
      (e : ∀ X, F.obj X ≃ CompatiblePairs toBase surjection X)
      (adj : extensionOfScalarsToPullback toB toA' toBase surjection comm ⊣ F),
      (∀ (L : ModuleCat.{u} s.fibreProduct) (X) (h : L ⟶ F.obj X) (l : L),
          (e X (h l)).1.1 =
              ((adj.homEquiv L X).symm h).fst
                ((1 : B) ⊗ₜ[s.fibreProduct,toB] l) ∧
            (e X (h l)).1.2 =
              ((adj.homEquiv L X).symm h).snd
                ((1 : A') ⊗ₜ[s.fibreProduct,toA'] l)) ∧
        IsIso adj.counit := by
  dsimp only
  exact compatiblePairsRightAdjoint_counit_isIso_of_surjective
    toBase surjection s.pullbackCone.fst.hom s.pullbackCone.snd.hom
    (congrArg CommRingCat.Hom.hom s.pullbackCone.condition)
    s.surjective_surjection fun x => ⟨x, rfl⟩

end MilnorPatching

