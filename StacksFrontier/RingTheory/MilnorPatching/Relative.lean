section Pushout
variable {R : Type uR} {S : Type uS} {T : Type uT} {U : Type uU}
  [CommRing R] [CommRing S] [CommRing T] [CommRing U]
  (f : R →+* S) (g : R →+* T) (h : S →+* U) (i : T →+* U)
  (comm : h.comp f = i.comp g)
def IsPushoutSquare (_comm : h.comp f = i.comp g) : Prop :=
  letI : Algebra R S := f.toAlgebra
  letI : Algebra R T := g.toAlgebra
  letI : Algebra S U := h.toAlgebra
  letI : Algebra T U := i.toAlgebra
  letI : Algebra R U := (h.comp f).toAlgebra
  ∃ (_hs : IsScalarTower R S U) (_ht : IsScalarTower R T U), Algebra.IsPushout R T S U

set_option backward.isDefEq.respectTransparency false in
noncomputable def pushoutBaseChangeIso (hp : IsPushoutSquare f g h i comm)
    (M : ModuleCat.{max w uR uS uT uU} S) :
    (ModuleCat.restrictScalars i).obj ((ModuleCat.extendScalars h).obj M) ≅
    (ModuleCat.extendScalars g).obj ((ModuleCat.restrictScalars f).obj M) := by
  letI : Algebra R S := f.toAlgebra
  letI : Algebra R T := g.toAlgebra
  letI : Algebra S U := h.toAlgebra
  letI : Algebra T U := i.toAlgebra
  letI : Algebra R U := (h.comp f).toAlgebra
  letI : IsScalarTower R S U := IsScalarTower.of_algebraMap_eq' rfl
  letI : IsScalarTower R T U := IsScalarTower.of_algebraMap_eq' comm
  letI : Algebra.IsPushout R T S U := by
    obtain ⟨_, _, hp⟩ := hp
    exact hp
  letI : Module R M := Module.compHom M f
  letI : IsScalarTower R S M := IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
  exact (Algebra.IsPushout.cancelBaseChange R T S U M).toModuleIso

set_option backward.isDefEq.respectTransparency false in
lemma pushoutBaseChangeIso_inv_tmul (hp : IsPushoutSquare f g h i comm)
    (M : ModuleCat.{max w uR uS uT uU} S) (t : T) (m : M) :
    (pushoutBaseChangeIso f g h i comm hp M).inv (t ⊗ₜ[R,g] m) =
      i t ⊗ₜ[S,h] m := by
  let : Algebra R S := f.toAlgebra
  let : Algebra R T := g.toAlgebra
  let : Algebra S U := h.toAlgebra
  let : Algebra T U := i.toAlgebra
  let : Algebra R U := (h.comp f).toAlgebra
  let : IsScalarTower R S U := IsScalarTower.of_algebraMap_eq' rfl
  let : IsScalarTower R T U := IsScalarTower.of_algebraMap_eq' comm
  let : Algebra.IsPushout R T S U := by
    obtain ⟨_, _, hp⟩ := hp
    exact hp
  let : Module R M := Module.compHom M f
  let : IsScalarTower R S M := IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
  exact Algebra.IsPushout.cancelBaseChange_symm_tmul R T S U M t m

noncomputable def pushoutBaseChange (hp : IsPushoutSquare f g h i comm) :
    ModuleCat.extendScalars.{_, _, max w uR uS uT uU} h ⋙ ModuleCat.restrictScalars i ≅
      ModuleCat.restrictScalars f ⋙ ModuleCat.extendScalars g :=
  (NatIso.ofComponents (fun M => (pushoutBaseChangeIso f g h i comm hp M).symm)
    (by
      intro M N φ
      ext x
      induction x using TensorProduct.inductionOn with
      | add x y hx hy => simp only [map_add, hx, hy]
      | tmul t m =>
        change (pushoutBaseChangeIso f g h i comm hp N).inv (t ⊗ₜ[R,g] φ m) =
        (ModuleCat.extendScalars h).map φ
          ((pushoutBaseChangeIso f g h i comm hp M).inv (t ⊗ₜ[R,g] m))
        rw [pushoutBaseChangeIso_inv_tmul, pushoutBaseChangeIso_inv_tmul]
        rfl)).symm

lemma pushoutBaseChange_hom_one_tmul (hp : IsPushoutSquare f g h i comm)
    (M : ModuleCat.{max w uR uS uT uU} S) (m : M) :
    (pushoutBaseChange f g h i comm hp).hom.app M ((1 : U) ⊗ₜ[S,h] m) =
      (1 : T) ⊗ₜ[R,g] (show (ModuleCat.restrictScalars f).obj M from m) := by
  have he := pushoutBaseChangeIso_inv_tmul f g h i comm hp M 1 m
  simp only [map_one] at he
  exact ((pushoutBaseChangeIso f g h i comm hp M).toLinearEquiv.symm_apply_eq.mp he).symm

end Pushout

section AlgebraSquare
variable {R : Type uR} {S : Type uS} {T : Type uT} {U : Type uU}
  [CommRing R] [CommRing S] [CommRing T] [CommRing U]
  [Algebra R S] [Algebra R T] [Algebra R U] [Algebra S U] [Algebra T U]
  [IsScalarTower R S U] [IsScalarTower R T U] [Algebra.IsPushout R T S U]
lemma algebraMap_isPushoutSquare :
    IsPushoutSquare (algebraMap R S) (algebraMap R T) (algebraMap S U) (algebraMap T U)
      ((IsScalarTower.algebraMap_eq R S U).symm.trans (IsScalarTower.algebraMap_eq R T U)) := by
  unfold IsPushoutSquare
  rw [← IsScalarTower.algebraMap_eq R S U]
  rw [toAlgebra_algebraMap, toAlgebra_algebraMap, toAlgebra_algebraMap,
    toAlgebra_algebraMap, toAlgebra_algebraMap]
  exact ⟨inferInstance, inferInstance, inferInstance⟩
end AlgebraSquare

section Tensor
variable {R : Type uR} {S : Type uS} {T : Type uT} {U : Type uU}
  [CommRing R] [CommRing S] [CommRing T] [CommRing U]
  [Algebra R S] [Algebra R T] [Algebra R U]

lemma tensorPushout : IsPushoutSquare (algebraMap R S) (algebraMap R T)
    (Algebra.TensorProduct.includeLeftRingHom : S →+* S ⊗[R] T)
    Algebra.TensorProduct.includeRight.toRingHom
      (RingHom.ext (fun r => Algebra.TensorProduct.tmul_one_eq_one_tmul r)) := by
  let : Algebra T (S ⊗[R] T) := Algebra.TensorProduct.rightAlgebra
  exact algebraMap_isPushoutSquare (R := R) (S := S) (T := T) (U := S ⊗[R] T)

noncomputable def tensorBaseChange :
    ModuleCat.extendScalars.{_, _, max w uR uS uT}
        (Algebra.TensorProduct.includeLeftRingHom : S →+* S ⊗[R] T) ⋙
      ModuleCat.restrictScalars Algebra.TensorProduct.includeRight.toRingHom ≅
    ModuleCat.restrictScalars (algebraMap R S) ⋙
      ModuleCat.extendScalars (algebraMap R T) :=
  pushoutBaseChange.{_, _, _, _, w} _ _ _ _ _ tensorPushout

lemma tensorBaseChange_inv_tmul
    (M : ModuleCat.{max w uR uS uT} S) (t : T) (m : M) :
    (tensorBaseChange (R := R) (S := S) (T := T)).inv.app M
        (t ⊗ₜ[R,algebraMap R T] m) =
      Algebra.TensorProduct.includeRight (R := R) (A := S) t
        ⊗ₜ[S,Algebra.TensorProduct.includeLeftRingHom] m :=
  pushoutBaseChangeIso_inv_tmul.{_, _, _, _, w} _ _ _ _ _ tensorPushout M t m

lemma tensorMapPushout (f : T →ₐ[R] U) :
    IsPushoutSquare
      (Algebra.TensorProduct.includeRight.toRingHom : T →+* S ⊗[R] T)
      f.toRingHom (Algebra.TensorProduct.map (AlgHom.id R S) f).toRingHom
      (Algebra.TensorProduct.includeRight.toRingHom : U →+* S ⊗[R] U)
      (by ext; simp) := by
  let : Algebra T U := f.toRingHom.toAlgebra
  let : IsScalarTower R T U := IsScalarTower.of_algebraMap_eq (fun r => (f.commutes r).symm)
  let : Algebra T (S ⊗[R] T) := Algebra.TensorProduct.rightAlgebra
  let : Algebra U (S ⊗[R] U) := Algebra.TensorProduct.rightAlgebra
  let : Algebra T (S ⊗[R] U) :=
    ((Algebra.TensorProduct.map (AlgHom.id R S) f).toRingHom.comp
      (Algebra.TensorProduct.includeRight.toRingHom : T →+* S ⊗[R] T)).toAlgebra
  let : IsScalarTower R T (S ⊗[R] U) :=
    IsScalarTower.of_algebraMap_eq (fun r => by
      simp [RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.tmul_one_eq_one_tmul])
  let : IsScalarTower T U (S ⊗[R] U) := IsScalarTower.of_algebraMap_eq (fun t => by
    simp [RingHom.algebraMap_toAlgebra])
  let : Algebra (S ⊗[R] T) (S ⊗[R] U) :=
    (Algebra.TensorProduct.map (AlgHom.id R S) f).toRingHom.toAlgebra
  let : IsScalarTower T (S ⊗[R] T) (S ⊗[R] U) :=
    IsScalarTower.of_algebraMap_eq (fun t => by simp [RingHom.algebraMap_toAlgebra])
  let : IsScalarTower R (S ⊗[R] T) (S ⊗[R] U) :=
    IsScalarTower.of_algebraMap_eq (fun r => by simp [RingHom.algebraMap_toAlgebra])
  let : IsScalarTower S (S ⊗[R] T) (S ⊗[R] U) :=
    IsScalarTower.of_algebraMap_eq (fun s => by simp [RingHom.algebraMap_toAlgebra])
  have hp : Algebra.IsPushout T U (S ⊗[R] T) (S ⊗[R] U) :=
    (Algebra.IsPushout.comp_iff R T S (S ⊗[R] T) (T := U)).mp inferInstance
  exact ⟨inferInstance, inferInstance, hp⟩
end Tensor

lemma extension_iso_one_tmul
    {R : Type uR} {S : Type uS} {T : Type uT} {U : Type uU}
    [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (i : T →+* U)
    (comm : h.comp f = i.comp g)
    (M : ModuleCat.{max w uS uT uU} R) (m : M) :
    ((extensionOfScalarsToPullback f g h i comm).obj M).iso.hom
      ((1 : U) ⊗ₜ[S,h] ((1 : S) ⊗ₜ[R,f] m)) =
      (1 : U) ⊗ₜ[T,i] ((1 : T) ⊗ₜ[R,g] m) := by
  have hinv := ((extendScalarsComp.{max w uS uT uU} f h).app M).toLinearEquiv.symm_apply_eq.mpr
    (extendScalarsComp_hom_app_one_tmul.{max w uS uT uU} f h M m).symm
  have heq : (eqToIso (congrArg (ModuleCat.extendScalars.{_, _, max w uS uT uU}) comm)).hom.app M
      ((1 : U) ⊗ₜ[R,h.comp f] m) = (1 : U) ⊗ₜ[R,i.comp g] m := by
    generalize h.comp f = p at comm ⊢
    generalize i.comp g = q at comm ⊢
    subst q
    rfl
  change (extendScalarsComp.{max w uS uT uU} g i).hom.app M
      ((eqToIso (congrArg ModuleCat.extendScalars comm)).hom.app M
        ((extendScalarsComp.{max w uS uT uU} f h).inv.app M _)) = _
  change (extendScalarsComp.{max w uS uT uU} f h).inv.app M
    ((1 : U) ⊗ₜ[S,h] ((1 : S) ⊗ₜ[R,f] m)) = (1 : U) ⊗ₜ[R,h.comp f] m at hinv
  rw [hinv, heq]
  exact extendScalarsComp_hom_app_one_tmul.{max w uS uT uU} g i M m

/-- Transport the tensor law through an equality of gluing isomorphisms. -/
private lemma extensionIso_one_tmul_of_eq
    {R : Type uR} {S : Type uS} {T : Type uT} {U : Type uU}
    [CommRing R] [CommRing S] [CommRing T] [CommRing U]
    (f : R →+* S) (g : R →+* T) (h : S →+* U) (i : T →+* U)
    (comm : h.comp f = i.comp g)
    (M : ModuleCat.{max w uS uT uU} R) (m : M)
    (e : (ModuleCat.extendScalars h).obj ((ModuleCat.extendScalars f).obj M) ≅
      (ModuleCat.extendScalars i).obj ((ModuleCat.extendScalars g).obj M))
    (he : e = ((extensionOfScalarsToPullback f g h i comm).obj M).iso) :
    e.hom ((1 : U) ⊗ₜ[S,h] ((1 : S) ⊗ₜ[R,f] m)) =
      (1 : U) ⊗ₜ[T,i] ((1 : T) ⊗ₜ[R,g] m) := by
  subst e
  exact extension_iso_one_tmul f g h i comm M m

/-- Two successive scalar extensions are generated by the tensors `1 ⊗ (1 ⊗ m)`. -/
lemma extendScalars_twice_hom_ext
    {R : Type uR} {S : Type uS} {T : Type uT}
    [CommRing R] [CommRing S] [CommRing T]
    (f : R →+* S) (g : S →+* T)
    (M : ModuleCat.{max w uR uS uT} R)
    {N : ModuleCat.{max w uR uS uT} T}
    (φ ψ : (ModuleCat.extendScalars g).obj ((ModuleCat.extendScalars f).obj M) ⟶ N)
    (h : ∀ m : M, φ ((1 : T) ⊗ₜ[S,g] ((1 : S) ⊗ₜ[R,f] m)) =
      ψ ((1 : T) ⊗ₜ[S,g] ((1 : S) ⊗ₜ[R,f] m))) : φ = ψ := by
  apply ((ModuleCat.extendRestrictScalarsAdj.{max w uR uS uT} g).homEquiv _ _).injective
  apply ModuleCat.ExtendScalars.hom_ext
  exact h

open Submodule LinearEquiv

noncomputable def quotientTensorEquiv {R S M : Type*} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (f : R →+* S) (hf : Function.Surjective f)
    (I : Ideal R) (hI : RingHom.ker f = I) :
    letI : Algebra R S := f.toAlgebra
    (M ⧸ (I • (⊤ : Submodule R M))) ≃ₗ[R] S ⊗[R] M := by
  letI : Algebra R S := f.toAlgebra
  let u := TensorProduct.mk R S M 1
  have hu : LinearMap.ker u = I • ⊤ := by
    rw [ker_tensorProductMk_of_surjective f hf, hI]
  exact (Submodule.quotEquivOfEq _ _ hu.symm).trans
    (u.quotKerEquivOfSurjective (tensorUnit_surjective f hf M))

lemma quotientTensorEquiv_mk {R S M : Type*} [CommRing R] [CommRing S]
    [AddCommGroup M] [Module R M] (f : R →+* S) (hf : Function.Surjective f)
    (I : Ideal R) (hI : RingHom.ker f = I) (m : M) :
    letI : Algebra R S := f.toAlgebra
    quotientTensorEquiv f hf I hI (Submodule.Quotient.mk m) = (1 : S) ⊗ₜ[R] m := by
  rfl

variable {A : Type uA} {A' : Type uA'} {B : Type uB} {D' : Type uD'}
    [CommRing A] [CommRing A'] [CommRing B] [CommRing D']
variable {toBase : B →+* A} {surjection : A' →+* A} {I : Ideal A'}

/-- **Stacks Project, Tag 08KK.** The relative fibre-product situation consists of a
fibre-product square `B' = B ×_A A'` as in Tag 08KH and an additional ring map
`B' → D'`. -/
@[stacks 08KK]
public structure RelativeModuleFibreProductSituation
    (base : RingFibreProduct.Situation toBase surjection I) where
  /-- The additional ring map `B' → D'`. -/
  toD' : base.fibreProduct →+* D'

namespace RelativeModuleFibreProductSituation

variable {base : RingFibreProduct.Situation toBase surjection I}
    (s : RelativeModuleFibreProductSituation (D' := D') base)

/-- The projection `B' → B` from the original fibre product. -/
public abbrev toB : base.fibreProduct →+* B := toBase.pullbackFst surjection

/-- The projection `B' → A'` from the original fibre product. -/
public abbrev toA' : base.fibreProduct →+* A' := toBase.pullbackSnd surjection

/-- The common composite `B' → A`. -/
public abbrev toA : base.fibreProduct →+* A :=
  toBase.comp (toB (base := base))

/-- The base-change ring `D = D' \otimes_{B'} B`. -/
@[reducible] public def D : Type (max uD' uB) :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct B := (toB (base := base)).toAlgebra
  TensorProduct base.fibreProduct D' B

/-- The base-change ring `C' = D' \otimes_{B'} A'`. -/
@[reducible] public def C' : Type (max uD' uA') :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct A' := (toA' (base := base)).toAlgebra
  TensorProduct base.fibreProduct D' A'

/-- The base-change ring `C = D' \otimes_{B'} A`. -/
@[reducible] public def C : Type (max uD' uA) :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct A := (toA (base := base)).toAlgebra
  TensorProduct base.fibreProduct D' A

/-- The canonical map `D' → D = D' ⊗_{B'} B`. -/
public noncomputable def toD : D' →+* s.D :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct B := (toB (base := base)).toAlgebra
  Algebra.TensorProduct.includeLeftRingHom

/-- The canonical map `D' → C' = D' ⊗_{B'} A'`. -/
public noncomputable def toC' : D' →+* s.C' :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct A' := (toA' (base := base)).toAlgebra
  Algebra.TensorProduct.includeLeftRingHom

/-- The base-changed map `D → C`. -/
public noncomputable def DtoC : s.D →+* s.C :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct B := (toB (base := base)).toAlgebra
  letI : Algebra base.fibreProduct A := (toA (base := base)).toAlgebra
  let BtoA : B →ₐ[base.fibreProduct] A :=
    { toBase with commutes' := fun _ => rfl }
  (Algebra.TensorProduct.map (AlgHom.id base.fibreProduct D') BtoA).toRingHom

/-- The base-changed map `C' → C`. -/
public noncomputable def C'toC : s.C' →+* s.C :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct A' := (toA' (base := base)).toAlgebra
  letI : Algebra base.fibreProduct A := (toA (base := base)).toAlgebra
  let A'toA : A' →ₐ[base.fibreProduct] A :=
    { surjection with
      commutes' := fun x => by
        change surjection ((toA' (base := base)) x) =
          toBase ((toB (base := base)) x)
        exact x.property.symm }
  (Algebra.TensorProduct.map (AlgHom.id base.fibreProduct D') A'toA).toRingHom

/-- The inclusion of the second tensor factor `B → D`. -/
public noncomputable def BtoD : B →+* s.D :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct B := (toB (base := base)).toAlgebra
  Algebra.TensorProduct.includeRight.toRingHom

/-- The inclusion of the second tensor factor `A' → C'`. -/
public noncomputable def A'toC' : A' →+* s.C' :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct A' := (toA' (base := base)).toAlgebra
  Algebra.TensorProduct.includeRight.toRingHom

/-- The inclusion of the second tensor factor `A → C`. -/
public noncomputable def AtoC : A →+* s.C :=
  letI : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  letI : Algebra base.fibreProduct A := (toA (base := base)).toAlgebra
  Algebra.TensorProduct.includeRight.toRingHom

/-- The canonical map `D' → D ×_C C'`. -/
public noncomputable def toRelativePullback :
    D' →+* RingHom.pullback s.DtoC s.C'toC :=
  RingHom.codRestrict ((s.toD).prod s.toC') (RingHom.pullback s.DtoC s.C'toC) (fun x => by
    change s.DtoC (s.toD x) = s.C'toC (s.toC' x)
    simp [DtoC, C'toC, toD, toC'])

