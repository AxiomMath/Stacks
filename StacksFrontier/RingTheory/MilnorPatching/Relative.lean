/-- Pure-tensor formula for the inverse of the first restriction comparison. -/
public theorem restrictionFstIso_inv_tmul
    (N : ModuleCat.{max v uA uA' uB uD'} s.D) (a : A) (n : N) :
    s.restrictionFstIso.{uA, uA', uB, uD', v}.inv.app N (a ⊗ₜ[B,toBase] n) = s.AtoC a ⊗ₜ[s.D,s.DtoC]
      n :=
  pushoutBaseChangeIso_inv_tmul.{_, _, _, _, max v uA uA' uB uD'}
    s.BtoD toBase s.DtoC s.AtoC s.DtoC_BtoD (fstPushout s) N a n

/-- Pure-tensor formula for the inverse of the second restriction comparison. -/
public theorem restrictionSndIso_inv_tmul
    (M : ModuleCat.{max v uA uA' uB uD'} s.C') (a : A) (m : M) :
    s.restrictionSndIso.{uA, uA', uB, uD', v}.inv.app M (a ⊗ₜ[A',surjection] m) = s.AtoC a
      ⊗ₜ[s.C',s.C'toC] m :=
  pushoutBaseChangeIso_inv_tmul.{_, _, _, _, max v uA uA' uB uD'}
    s.A'toC' surjection s.C'toC s.AtoC s.C'toC_A'toC' (sndPushout s) M a m

/-- Restriction of a compatible pair to the original square. -/
public noncomputable def restrictCompatibleModules :
    CompatibleModules.{uA,uA',uB,uD',v} s ⥤
      BaseCompatibleModules.{uA,uA',uB,max v uD'} (toBase := toBase) (surjection := surjection)
        where
  obj X :=
    { fst := (ModuleCat.restrictScalars s.BtoD).obj X.fst
      snd := (ModuleCat.restrictScalars s.A'toC').obj X.snd
      iso := (s.restrictionFstIso.{uA, uA', uB, uD', v}.app X.fst).symm ≪≫
        (ModuleCat.restrictScalars s.AtoC).mapIso X.iso ≪≫
        s.restrictionSndIso.{uA, uA', uB, uD', v}.app X.snd }
  map {X Y} f :=
    { fst := (ModuleCat.restrictScalars s.BtoD).map f.fst
      snd := (ModuleCat.restrictScalars s.A'toC').map f.snd
      w := by
        change (ModuleCat.extendScalars toBase).map
            ((ModuleCat.restrictScalars s.BtoD).map f.fst) ≫
            (s.restrictionFstIso.{uA, uA', uB, uD', v}.inv.app Y.fst ≫
              (ModuleCat.restrictScalars s.AtoC).map Y.iso.hom ≫
              s.restrictionSndIso.{uA, uA', uB, uD', v}.hom.app Y.snd) =
          (s.restrictionFstIso.{uA, uA', uB, uD', v}.inv.app X.fst ≫
            (ModuleCat.restrictScalars s.AtoC).map X.iso.hom ≫
            s.restrictionSndIso.{uA, uA', uB, uD', v}.hom.app X.snd) ≫
            (ModuleCat.extendScalars surjection).map
              ((ModuleCat.restrictScalars s.A'toC').map f.snd)
        rw [← Category.assoc]
        erw [s.restrictionFstIso.{uA, uA', uB, uD', v}.inv.naturality f.fst]
        simp only [Category.assoc, Functor.comp_map]
        rw [← Category.assoc ((ModuleCat.restrictScalars s.AtoC).map
          ((ModuleCat.extendScalars s.DtoC).map f.fst)), ← Functor.map_comp,
          f.w, Functor.map_comp]
        simp only [Category.assoc]
        erw [s.restrictionSndIso.{uA, uA', uB, uD', v}.hom.naturality f.snd]
        rfl }

