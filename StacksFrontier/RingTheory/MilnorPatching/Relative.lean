/-- The canonical map is surjective, as asserted in the footnote of Tag 08KK (Tag 08IG). -/
public theorem toRelativePullback_surjective : Function.Surjective s.toRelativePullback := by
  let : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  let : Algebra base.fibreProduct B := (toB (base := base)).toAlgebra
  let : Algebra base.fibreProduct A' := (toA' (base := base)).toAlgebra
  let : Algebra base.fibreProduct A := (toA (base := base)).toAlgebra
  have hc := RingHom.pullback_comm_sq toBase surjection
  have hf : Function.Surjective (toB (base := base)) := by
    intro b
    obtain ⟨a, ha⟩ := base.surjective_surjection (toBase b)
    exact ⟨⟨(b, a), ha.symm⟩, rfl⟩
  have hk : ∀ a : A', surjection a = 0 →
      ∃ r : base.fibreProduct, (toB (base := base)) r = 0 ∧
        (toA' (base := base)) r = a := by
    intro a ha
    exact ⟨⟨(0, a), by simp [ha]⟩, rfl, rfl⟩
  intro z
  have hB (x : s.D) :
      (LinearMap.rTensor D'
        (show B →ₗ[base.fibreProduct] A from
          { toBase with
            map_smul' := fun r b => by
              change toBase (r.val.1 * b) = toBase r.val.1 * toBase b
              exact map_mul _ _ _ }))
        ((TensorProduct.comm base.fibreProduct D' B) x) =
      (TensorProduct.comm base.fibreProduct D' A) (s.DtoC x) := by
    induction x using TensorProduct.inductionOn with
    | tmul d b => simp [DtoC]
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  have hA (x : s.C') :
      (LinearMap.rTensor D'
        (show A' →ₗ[base.fibreProduct] A from
          { surjection with
            map_smul' := fun r a => by
              change surjection (r.val.2 * a) = toBase r.val.1 * surjection a
              rw [map_mul]
              exact congrArg (· * surjection a) r.property.symm }))
        ((TensorProduct.comm base.fibreProduct D' A') x) =
      (TensorProduct.comm base.fibreProduct D' A) (s.C'toC x) := by
    induction x using TensorProduct.inductionOn with
    | tmul d a => simp [C'toC]
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  obtain ⟨d, hd, ha⟩ := compatibleTensorPairs_surjective (L := D')
    (toB (base := base)) (toA' (base := base)) toBase surjection
    hf base.surjective_surjection hk _ _ (fun _ => rfl) (fun _ => rfl)
    ((TensorProduct.comm base.fibreProduct D' B) z.val.1)
    ((TensorProduct.comm base.fibreProduct D' A') z.val.2)
    (by
      rw [hB, hA]
      exact congrArg (TensorProduct.comm base.fibreProduct D' A) z.property)
  refine ⟨d, Subtype.ext (Prod.ext ?_ ?_)⟩
  · change s.toD d = z.val.1
    apply (TensorProduct.comm base.fibreProduct D' B).injective
    simpa [toD] using hd
  · change s.toC' d = z.val.2
    apply (TensorProduct.comm base.fibreProduct D' A').injective
    simpa [toC'] using ha

