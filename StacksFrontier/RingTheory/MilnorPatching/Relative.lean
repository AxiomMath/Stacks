section
universe u

namespace MilnorPatching
open ModuleGlueing
open MilnorPatching RelativeModuleFibreProductSituation

variable {A A' B D' : Type u} [CommRing A] [CommRing A'] [CommRing B] [CommRing D']
variable {toBase : B →+* A} {surjection : A' →+* A} {I : Ideal A'}
variable {base : RingFibreProduct.Situation toBase surjection I}

/-- **Stacks Project, Tag 08KN.** If `J` is the kernel of `B' → B`, then the
canonical map from `J D'` to `I C'` is surjective. -/
@[stacks 08KN]
public theorem image_extendedKernel_eq_extendedIdeal
    (s : RelativeModuleFibreProductSituation (D' := D') base) :
    s.toC' ''
        (↑((RingHom.ker (toB (base := base))).map s.toD') : Set D') =
      (↑(I.map s.A'toC') : Set s.C') := by
  let : Algebra base.fibreProduct D' := s.toD'.toAlgebra
  let : Algebra base.fibreProduct A' := (toA' (base := base)).toAlgebra
  let J := RingHom.ker (toB (base := base))
  let L := J.map s.toD'
  let K : Set s.C' := s.toC' '' (↑L : Set D')
  have hright (j : base.fibreProduct) :
      s.toC' (s.toD' j) = s.A'toC' ((toA' (base := base)) j) := by
    change (algebraMap base.fibreProduct D' j) ⊗ₜ 1 =
      1 ⊗ₜ (algebraMap base.fibreProduct A' j)
    exact Algebra.TensorProduct.tmul_one_eq_one_tmul j
  have hjI (j : base.fibreProduct) (hj : j ∈ J) : (toA' (base := base)) j ∈ I := by
    refine (SetLike.ext_iff.mp base.ker_surjection _).mp ?_
    have hsquare : surjection ((toA' (base := base)) j) = toBase ((toB (base := base)) j) :=
      DFunLike.congr_fun (congrArg CommRingCat.Hom.hom base.pullbackCone.condition).symm j
    change surjection ((toA' (base := base)) j) = 0
    rw [hsquare]
    change (toB (base := base)) j = 0 at hj
    simp [hj]
  have lift_mem (i : A') (hi : i ∈ I) :
      ∃ j : base.fibreProduct, j ∈ J ∧ (toA' (base := base)) j = i := by
    have hi' : surjection i = 0 :=
      (show i ∈ RingHom.ker surjection from
        (SetLike.ext_iff.mp base.ker_surjection i).mpr hi)
    let j : base.fibreProduct := ⟨(0, i), by simp [hi']⟩
    exact ⟨j, by change (toB (base := base)) j = 0; rfl, rfl⟩
  have mul_right (a : A') (d : D') (hd : d ∈ L) :
      ∃ e ∈ L, s.toC' e = s.A'toC' a * s.toC' d := by
    change d ∈ Ideal.span (s.toD' '' (↑J : Set base.fibreProduct)) at hd
    induction hd using Submodule.span_induction with
    | mem d hd =>
        obtain ⟨j, hj, rfl⟩ := hd
        obtain ⟨ja, hja, hja'⟩ := lift_mem (a * (toA' (base := base)) j)
          (I.mul_mem_left a (hjI j hj))
        refine ⟨s.toD' ja, Ideal.mem_map_of_mem _ hja, ?_⟩
        rw [hright, hja', map_mul, ← hright]
    | zero => exact ⟨0, L.zero_mem, by simp⟩
    | add x y _ _ hx hy =>
        obtain ⟨x', hx', ex⟩ := hx
        obtain ⟨y', hy', ey⟩ := hy
        exact ⟨x' + y', L.add_mem hx' hy', by simp [ex, ey, mul_add]⟩
    | smul r x _ hx =>
        obtain ⟨x', hx', ex⟩ := hx
        exact ⟨r * x', L.mul_mem_left r hx', by simp [ex, mul_left_comm]⟩
  have mul_closed (c : s.C') (d : D') (hd : d ∈ L) :
      ∃ e ∈ L, s.toC' e = c * s.toC' d := by
    induction c using TensorProduct.inductionOn with
    | tmul x a =>
        obtain ⟨e, he, ee⟩ := mul_right a d hd
        exact ⟨x * e, L.mul_mem_left x he, by
          rw [map_mul, ee]
          simp [RelativeModuleFibreProductSituation.toC',
            RelativeModuleFibreProductSituation.A'toC']⟩
    | add x y hx hy =>
        obtain ⟨x', hx', ex⟩ := hx
        obtain ⟨y', hy', ey⟩ := hy
        exact ⟨x' + y', L.add_mem hx' hy', by simp [ex, ey, add_mul]⟩
  let Kideal : Ideal s.C' :=
    { carrier := K
      zero_mem' := ⟨0, L.zero_mem, by simp⟩
      add_mem' := by
        rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
        exact ⟨x + y, L.add_mem hx hy, by simp⟩
      smul_mem' := by
        rintro c _ ⟨d, hd, rfl⟩
        obtain ⟨e, he, ee⟩ := mul_closed c d hd
        exact ⟨e, he, ee⟩ }
  change K = (↑(I.map s.A'toC') : Set s.C')
  change (↑Kideal : Set s.C') = _
  apply congrArg (fun Q : Ideal s.C' => (↑Q : Set s.C'))
  apply le_antisymm
  · rintro _ ⟨d, hd, rfl⟩
    change d ∈ Ideal.span (s.toD' '' (↑J : Set base.fibreProduct)) at hd
    induction hd using Submodule.span_induction with
    | mem d hd =>
        obtain ⟨j, hj, rfl⟩ := hd
        rw [hright]
        exact Ideal.mem_map_of_mem _ (hjI j hj)
    | zero => simp
    | add x y _ _ hx hy => simpa using (I.map s.A'toC').add_mem hx hy
    | smul r x _ hx => simpa using (I.map s.A'toC').mul_mem_left (s.toC' r) hx
  · rw [Ideal.map_le_iff_le_comap]
    intro i hi
    obtain ⟨j, hj, hj'⟩ := lift_mem i hi
    change s.A'toC' i ∈ Kideal
    exact ⟨s.toD' j, Ideal.mem_map_of_mem _ hj, by rw [hright, hj']⟩

end MilnorPatching
end

end

