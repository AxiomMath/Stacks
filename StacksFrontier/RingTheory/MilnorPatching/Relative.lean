      (s.extensionRestrictionFstIso.{uA, uA', uB, uD', v}.app L).symm
      (s.extensionRestrictionSndIso.{uA, uA', uB, uD', v}.app L).symm ?_
    exact s.restrictionSquare_coherence.{uA, uA', uB, uD', v} L
  · intro L M f
    apply CategoricalPullback.hom_ext
    · exact s.extensionRestrictionFstIso.{uA, uA', uB, uD', v}.inv.naturality f
    · exact s.extensionRestrictionSndIso.{uA, uA', uB, uD', v}.inv.naturality f

set_option maxHeartbeats 1000000 in
-- was section-wide; the statement elaborates tensor base change over `base.fibreProduct`
/-- Pure-tensor law for the first inverse component of the displayed functor square. -/
public theorem restrictionSquareIso_inv_fst_tmul
    (L : ModuleCat.{max v uA uA' uB uD'} D') (b : B) (l : L) :
    (s.restrictionSquareIso.{uA, uA', uB, uD', v}.inv.app L).fst (b ⊗ₜ[base.fibreProduct,toB] l) =
      s.BtoD b ⊗ₜ[D',s.toD] l :=
  s.extensionRestrictionFstIso_inv_tmul.{uA, uA', uB, uD', v} L b l

set_option maxHeartbeats 1000000 in
-- was section-wide; the statement elaborates tensor base change over `base.fibreProduct`
/-- Pure-tensor law for the second inverse component of the displayed functor square. -/
public theorem restrictionSquareIso_inv_snd_tmul
    (L : ModuleCat.{max v uA uA' uB uD'} D') (a : A') (l : L) :
    (s.restrictionSquareIso.{uA, uA', uB, uD', v}.inv.app L).snd (a ⊗ₜ[base.fibreProduct,toA'] l) =
      s.A'toC' a ⊗ₜ[D',s.toC'] l :=
  s.extensionRestrictionSndIso_inv_tmul.{uA, uA', uB, uD', v} L a l

end

/-- The literal quotient `M'/IM'`, with `M'` restricted along `A' → C'`. -/
public abbrev QuotientModule (X : CompatibleModules.{uA, uA', uB, uD', v} s) :=
  let M := (ModuleCat.restrictScalars s.A'toC').obj X.snd
  M ⧸ (I • (⊤ : Submodule A' M))

/-- The canonical additive identification of the literal quotient with `C ⊗[C'] M'`. -/
public noncomputable def quotientTensorAddEquiv (X : CompatibleModules.{uA, uA', uB, uD', v} s) :
    s.QuotientModule X ≃+ (ModuleCat.extendScalars s.C'toC).obj X.snd := by
  let M := (ModuleCat.restrictScalars s.A'toC').obj X.snd
  exact (quotientTensorEquiv (M := M) surjection base.surjective_surjection I
    base.ker_surjection).toAddEquiv.trans
      (s.restrictionSndIso.{uA, uA', uB, uD', v}.app X.snd).toLinearEquiv.symm.toAddEquiv

/-- The quotient identification sends the class of `m` to `1 ⊗ m`. -/
public theorem quotientTensorAddEquiv_mk
    (X : CompatibleModules.{uA, uA', uB, uD', v} s) (m : X.snd) :
    s.quotientTensorAddEquiv X (Submodule.Quotient.mk m) =
      (1 : s.C) ⊗ₜ[s.C',s.C'toC] m := by
  change s.restrictionSndIso.{uA, uA', uB, uD', v}.inv.app X.snd
      (quotientTensorEquiv surjection base.surjective_surjection I base.ker_surjection
        (Submodule.Quotient.mk m)) = _
  rw [quotientTensorEquiv_mk, restrictionSndIso_inv_tmul, map_one]

/-- The induced `D`-module on the literal quotient, transported through its canonical
identification with `C ⊗[C'] M'`. -/
public noncomputable def quotientModuleCat (X : CompatibleModules.{uA, uA', uB, uD', v} s) :
    ModuleCat.{max v uA uA' uB uD'} s.D :=
  let e : s.QuotientModule X ≃+
      (ModuleCat.restrictScalars s.DtoC).obj ((ModuleCat.extendScalars s.C'toC).obj X.snd) :=
    s.quotientTensorAddEquiv X
  letI := e.module s.D
  ModuleCat.of s.D (s.QuotientModule X)

/-- The `D`-linear quotient-to-tensor identification. -/
public noncomputable def quotientTensorIso (X : CompatibleModules.{uA, uA', uB, uD', v} s) :
    s.quotientModuleCat X ≅
      (ModuleCat.restrictScalars s.DtoC).obj ((ModuleCat.extendScalars s.C'toC).obj X.snd) :=
  let e : s.QuotientModule X ≃+
      (ModuleCat.restrictScalars s.DtoC).obj ((ModuleCat.extendScalars s.C'toC).obj X.snd) :=
    s.quotientTensorAddEquiv X
  (e.linearEquiv s.D).toModuleIso

/-- The formula characterizing the induced `D` action on the quotient. -/
public theorem quotientTensorIso_smul (X : CompatibleModules.{uA, uA', uB, uD', v} s)
    (d : s.D) (q : s.quotientModuleCat X) :
    (s.quotientTensorIso X).hom (d • q) =
      s.DtoC d • (show (ModuleCat.extendScalars s.C'toC).obj X.snd from
        (s.quotientTensorIso X).hom q) :=
  (s.quotientTensorIso X).hom.hom.map_smul d q

/-- The source's `D`-linear map `N → M'/IM'`. -/
public noncomputable def quotientComparison (X : CompatibleModules.{uA, uA', uB, uD', v} s) :
    X.fst ⟶ s.quotientModuleCat X :=
  (ModuleCat.extendRestrictScalarsAdj.{max v uA uA' uB uD'} s.DtoC).homEquiv _ _ X.iso.hom ≫
    (s.quotientTensorIso X).inv

/-- The quotient comparison is the original gluing map on tensors of `1`. -/
public theorem quotientComparison_apply (X : CompatibleModules.{uA, uA', uB, uD', v} s)
    (n : X.fst) :
    (s.quotientTensorIso X).hom (s.quotientComparison X n) =
      X.iso.hom ((1 : s.C) ⊗ₜ[s.D,s.DtoC] n) := by
  change (s.quotientTensorIso X).toLinearEquiv
      ((s.quotientTensorIso X).toLinearEquiv.symm _) = _
  rw [LinearEquiv.apply_symm_apply]
  rfl

/-- Extending the `D`-linear comparison to `C`, under the canonical quotient
identification, recovers exactly `X.iso.hom`. -/
public theorem quotientComparison_extendScalars
    (X : CompatibleModules.{uA, uA', uB, uD', v} s) :
    ((ModuleCat.extendRestrictScalarsAdj.{max v uA uA' uB uD'} s.DtoC).homEquiv X.fst
      ((ModuleCat.extendScalars s.C'toC).obj X.snd)).symm
        (s.quotientComparison X ≫ (s.quotientTensorIso X).hom) = X.iso.hom := by
  simp only [quotientComparison, Category.assoc, Iso.inv_hom_id, Category.comp_id,
    Equiv.symm_apply_apply]

end RelativeModuleFibreProductSituation

end

end MilnorPatching

end

