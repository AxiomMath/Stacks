module

public import Mathlib.Algebra.DualNumber
public import Mathlib.LinearAlgebra.Dimension.Finite
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.RingTheory.Noetherian.Defs

/-!
# Infinitely many independent tangent vectors obstruct finite generation

Let `R` be a commutative ring and `χ : R →+* K` a ring map to a field. A *tangent vector* at `χ`
is a ring map `φ : R →+* K[ε]` to the dual numbers lifting `χ`; its second component is a point
derivation `D : R → K`, `D(ab) = χ(a) D(b) + χ(b) D(a)`. Every such derivation vanishes on
`(ker χ)²` and is `R`-linear on `ker χ` for the action of `R` through `χ`, so the derivations
factor through the cotangent space `ker χ / (ker χ)²`, a `K`-vector space.

If `ker χ` is generated by `n` elements, the cotangent space has dimension at most `n`, so at
most `n` tangent vectors can be independent. Hence a sequence of tangent vectors `φ_j` together
with elements `t_i ∈ ker χ` satisfying `D_j(t_i) = δ_ij` shows that `ker χ` is not finitely
generated, and in particular that `R` is not Noetherian.

## Main results

* `Stacks.DualNumberTangents.not_fg_ker`: the kernel of `χ` is not a finitely generated ideal.
* `Stacks.DualNumberTangents.not_isNoetherianRing`: hence `R` is not Noetherian.
-/

@[expose] public section


namespace Stacks.DualNumberTangents

variable {R K : Type*} [CommRing R] [Field K]

/-- **A point derivation vanishes on the multiples of the kernel**: for `g ∈ ker χ` the second
component of `φ (r g)` is `χ r` times that of `φ g`. -/
theorem snd_mul_of_mem_ker (χ : R →+* K) (φ : R →+* DualNumber K) (hφ : ∀ r, (φ r).fst = χ r)
    (r g : R) (hg : χ g = 0) : (φ (r * g)).snd = χ r * (φ g).snd := by
  rw [map_mul, TrivSqZeroExt.snd_mul, hφ, hφ, hg]
  simp [smul_eq_mul]

/-- **Infinitely many independent tangent vectors at `χ` make `ker χ` infinitely generated.** Let
`φ_j : R →+* K[ε]` (`j ∈ ℕ`) lift `χ`, and let `t_i ∈ ker χ` with `(φ_j t_i).snd = δ_ij`. Then
`ker χ` is not finitely generated. -/
theorem not_fg_ker (χ : R →+* K) (φ : ℕ → R →+* DualNumber K)
    (hφ : ∀ j r, (φ j r).fst = χ r) (t : ℕ → R) (ht0 : ∀ i, χ (t i) = 0)
    (ht : ∀ i j, (φ j (t i)).snd = if i = j then 1 else 0) : ¬ (RingHom.ker χ).FG := by
  classical
  rintro ⟨G, hG⟩
  set n := G.card
  -- `n + 1` vectors in the `n`-dimensional space `G → K` are dependent
  let w : Fin (n + 1) → (G → K) := fun j g => (φ j g).snd
  have hnot : ¬ LinearIndependent K w := by
    intro hli
    have := hli.fintype_card_le_finrank
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin, Fintype.card_coe] at this
    omega
  obtain ⟨c, hc, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.mp hnot
  -- the combined derivation vanishes on the kernel
  let D : R → K := fun r => ∑ j : Fin (n + 1), c j * (φ j r).snd
  have hDadd : ∀ a b, D (a + b) = D a + D b := by
    intro a b
    simp only [D, map_add, TrivSqZeroExt.snd_add, mul_add, Finset.sum_add_distrib]
  have hDG : ∀ g ∈ G, D g = 0 := fun g hg => by
    simpa [D, w, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using congrFun hc ⟨g, hg⟩
  have hDker : ∀ x ∈ RingHom.ker χ, D x = 0 := by
    intro x hx
    rw [← hG] at hx
    induction hx using Submodule.span_induction with
    | mem g hg => exact hDG g hg
    | zero => simp [D]
    | add a b _ _ ha hb => rw [hDadd, ha, hb, add_zero]
    | smul r a ha haD =>
      have haker : χ a = 0 := RingHom.mem_ker.mp (hG ▸ ha)
      have : D (r * a) = χ r * D a := by
        simp only [D, snd_mul_of_mem_ker χ (φ _) (hφ _) r a haker, Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [smul_eq_mul, this, haD, mul_zero]
  -- but it does not vanish at `t i₀`
  have hDt : D (t i₀) = c i₀ := by
    simp only [D, ht]
    rw [Finset.sum_eq_single i₀]
    · simp
    · intro j _ hj
      rw [if_neg (fun h => hj (Fin.ext h.symm)), mul_zero]
    · simp
  exact hi₀ (hDt ▸ hDker _ (ht0 i₀))

/-- **Hence `R` is not Noetherian.** -/
theorem not_isNoetherianRing (χ : R →+* K) (φ : ℕ → R →+* DualNumber K)
    (hφ : ∀ j r, (φ j r).fst = χ r) (t : ℕ → R) (ht0 : ∀ i, χ (t i) = 0)
    (ht : ∀ i j, (φ j (t i)).snd = if i = j then 1 else 0) : ¬ IsNoetherianRing R := fun _ =>
  not_fg_ker χ φ hφ t ht0 ht (IsNoetherian.noetherian _)

end Stacks.DualNumberTangents

end
