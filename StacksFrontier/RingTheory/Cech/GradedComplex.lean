module

public import StacksFrontier.RingTheory.Cech.Substrate
public import StacksFrontier.RingTheory.HomogeneousLocalization.GradedLocalizedModule
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The extended Čech complex of homogeneous elements is graded

Let `R = ⨁_{i ≥ 0} 𝒜 i` be a graded ring, let `M = ⨁_{j ∈ ℤ} 𝒨 j` be a `ℤ`-graded `R`-module, and
let `f₀, …, f_{r-1}` be homogeneous elements of `R`, with `f i` of degree `c i`. Each term of the
extended alternating Čech complex `Cech.cechComplex f M` is a direct sum of localizations
`M_{∏_{i ∈ s} f i}` at homogeneous elements, so each is `ℤ`-graded by
`Stacks.GradedLocalization.gradedPiece`. This file proves that the transition maps — hence the
differential — **preserve those degrees**, so the whole complex is a complex of `ℤ`-graded modules
and splits as the direct sum over `e ∈ ℤ` of its degree-`e` subcomplexes.

That splitting is what turns an ungraded statement about the complex into a statement about each
degree separately. In particular, for the variables of a polynomial ring the complex has
cohomology only in the top degree `r` (`MvPolynomial.cechComplex_homology_X_isZero`, from
Koszul-regularity), and since cohomology commutes with direct sums **each degree-`e` subcomplex
has cohomology only in degree `r`** — which for `𝒜 = R[T₀, …, Tₙ]` and the variables is the
vanishing `H^q(ℙⁿ_R, 𝒪(e)) = 0` for `0 < q < n`, for every `e` at once, with no computation of the
graded pieces. The degrees `q = 0` and `q = n` are genuinely graded statements and do not follow
this way.

## Main results

* `Cech.cechι_mk_pow` — **the transition map on a fraction**: for `s ⊆ s'`, writing
  `g = ∏_{i ∈ s} f i` and `h = ∏_{i ∈ s' \ s} f i`, the map `M_g → M_{gh}` sends `x / g ^ n` to
  `h ^ n · x / (gh) ^ n`.
* `Cech.mem_gradedPiece_cechι` — **the transition maps preserve the grading**: the degree-`e` part
  of `M_{∏_{i ∈ s} f i}` is carried into the degree-`e` part of `M_{∏_{i ∈ s'} f i}`.
* `Cech.mem_gradedPiece_cechD_component` — hence so does each component of the Čech differential.

## Implementation notes

`Cech.cechι` is `IsLocalizedModule.liftOfLE` for the submonoids *generated by the individual*
`f i`, not for the powers of the product; the identification of the two is
`Cech.instClosureOfPowers`. So the formula for it on a fraction is read off from
`IsLocalizedModule.liftOfLE_mk'` together with `IsLocalizedModule.mk'_eq_iff`, which characterizes
`mk'` by `f m = s • mk' f m s`. No injectivity or invertibility argument is needed: both fractions
are exhibited as the same `mk'`.

The grading action `VAdd ℕ ℤ` of a non-negative ring degree on an integer module degree is
`instVAddNatIntGradedLocalizedModule`, activated here as a local instance rather than declared
again: the graded statements of this file and those of
`StacksFrontier.RingTheory.HomogeneousLocalization.GradedLocalizedModule`, which it applies, then
mention the same `SetLike.GradedSMul` instance instead of two definitionally equal copies that
instance search will not cross between.

## References

* [Stacks Project, Tag 01XT](https://stacks.math.columbia.edu/tag/01XT)
* [Stacks Project, Tag 0G6L](https://stacks.math.columbia.edu/tag/0G6L)
-/

@[expose] public section

universe u v w t

open Finset

-- The grading action of a non-negative ring degree on an integer module degree, taken from
-- `StacksFrontier.RingTheory.HomogeneousLocalization.GradedLocalizedModule` rather than declared
-- again here.
attribute [local instance] instVAddNatIntGradedLocalizedModule

namespace Cech

variable {R : Type u} [CommRing R] {r : ℕ} {σ : Type w} {τ : Type t}
  [SetLike σ R] [AddSubgroupClass σ R] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {M : Type v} [AddCommGroup M] [Module R M]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨]
  (f : Fin r → R)

/-- **The transition map of the Čech complex on a fraction.** For `s ⊆ t`, writing
`g = ∏_{i ∈ s} f i` and `h = ∏_{i ∈ s' \ s} f i`, the canonical map `M_g → M_{gh}` sends the
fraction `x / g ^ n` to `h ^ n · x / (gh) ^ n`.

Both sides are the same `IsLocalizedModule.mk'` with denominator `g ^ n` — on the left over the
submonoid generated by the `f i`, `i ∈ s`, on the right over the one for `i ∈ s'` — so
`IsLocalizedModule.liftOfLE_mk'` identifies them without any invertibility argument. -/
@[ega "0 1.4.1" "special case"]
theorem cechι_mk_pow {s s' : Finset (Fin r)} (hsu : s ⊆ s') (x : M) (n : ℕ) :
    cechι f M hsu (LocalizedModule.mk x
        (⟨(∏ i ∈ s, f i) ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers (∏ i ∈ s, f i))) =
      LocalizedModule.mk ((∏ i ∈ s' \ s, f i) ^ n • x)
        (⟨(∏ i ∈ s', f i) ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers (∏ i ∈ s', f i)) := by
  classical
  -- over the submonoid for `i ∈ t ⊇ s`, the fraction `x / g ^ n` is `mk'` of `h ^ n • x / (gh) ^ n`
  have key : ∀ t (ht : s ⊆ t), IsLocalizedModule.mk' (LocalizedModule.mkLinearMap (cechSub f t) M)
      x (⟨(∏ i ∈ s, f i) ^ n, cechSub_le_closure f ht ⟨n, rfl⟩⟩ :
        Submonoid.closure (f '' (t : Set (Fin r)))) =
      LocalizedModule.mk ((∏ i ∈ t \ s, f i) ^ n • x)
        (⟨(∏ i ∈ t, f i) ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers (∏ i ∈ t, f i)) := by
    intro t ht
    have hprod : (∏ i ∈ s, f i) * (∏ i ∈ t \ s, f i) = ∏ i ∈ t, f i := by
      rw [mul_comm]; exact Finset.prod_sdiff ht
    rw [IsLocalizedModule.mk'_eq_iff]
    change LocalizedModule.mk x 1 = _
    rw [Submonoid.smul_def, LocalizedModule.smul'_mk, smul_smul, ← mul_pow, hprod]
    refine LocalizedModule.mk_eq.2 ⟨1, ?_⟩
    simp [Submonoid.smul_def]
  have hleft := key s le_rfl
  simp only [Finset.sdiff_self, Finset.prod_empty, one_pow, one_smul] at hleft
  rw [← hleft, cechι, IsLocalizedModule.liftOfLE_mk', key s' hsu]

omit [DirectSum.Decomposition 𝒨] in
/-- **The transition maps of the Čech complex preserve the grading.** If every `f i` is
homogeneous, of degree `c i`, then for `s ⊆ s'` the canonical map
`M_{∏_{i ∈ s} f i} → M_{∏_{i ∈ s'} f i}` carries the degree-`e` part into the degree-`e` part.

The numerator is multiplied by `(∏_{i ∈ s' \ s} f i) ^ n`, of degree `n · ∑_{i ∈ s' \ s} c i`, and
the denominator's degree rises by the same amount, so the degree of the fraction is unchanged. -/
theorem mem_gradedPiece_cechι {c : Fin r → ℕ} (hc : ∀ i, f i ∈ 𝒜 (c i))
    {s s' : Finset (Fin r)} (hsu : s ⊆ s') (e : ℤ) {z : cechMod f M s}
    (hz : z ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒨 (∏ i ∈ s, f i) e) :
    cechι f M hsu z ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒨 (∏ i ∈ s', f i) e := by
  classical
  have hprod : ∀ t : Finset (Fin r), (∏ i ∈ t, f i) ∈ 𝒜 (∑ i ∈ t, c i) := fun t =>
    SetLike.prod_mem_graded 𝒜 c f fun i _ => hc i
  have hs := hprod s
  have hu := hprod s'
  have hd := hprod (s' \ s)
  obtain ⟨n, x, hx, rfl⟩ :=
    (Stacks.GradedLocalization.mem_gradedPiece_iff 𝒜 𝒨 hs e z).1 hz
  rw [cechι_mk_pow f hsu x n]
  refine Stacks.GradedLocalization.mk_mem_gradedPiece 𝒜 𝒨 hu ?_
  have hsmul := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨)
    (SetLike.pow_mem_graded n hd) hx
  have hdeg : (n • (∑ i ∈ s' \ s, c i) : ℕ) +ᵥ (e + n • ((∑ i ∈ s, c i : ℕ) : ℤ)) =
      e + n • ((∑ i ∈ s', c i : ℕ) : ℤ) := by
    change ((n • (∑ i ∈ s' \ s, c i) : ℕ) : ℤ) + (e + n • ((∑ i ∈ s, c i : ℕ) : ℤ)) = _
    rw [← Finset.sum_sdiff hsu]
    simp only [nsmul_eq_mul]
    push_cast
    ring
  rwa [hdeg] at hsmul

omit [DirectSum.Decomposition 𝒨] in
/-- **Each component of the Čech differential preserves the grading.** The differential is a
signed sum of the transition maps into the summands indexed by `insert i s`, and
`Cech.mem_gradedPiece_cechι` applies to each. -/
theorem mem_gradedPiece_cechD_component {c : Fin r → ℕ} (hc : ∀ i, f i ∈ 𝒜 (c i))
    {s : Finset (Fin r)} (i : Fin r) (e : ℤ) {z : cechMod f M s}
    (hz : z ∈ Stacks.GradedLocalization.gradedPiece 𝒜 𝒨 (∏ j ∈ s, f j) e) :
    cechι f M (Finset.subset_insert i s) z ∈
      Stacks.GradedLocalization.gradedPiece 𝒜 𝒨 (∏ j ∈ insert i s, f j) e :=
  mem_gradedPiece_cechι 𝒜 𝒨 f hc (Finset.subset_insert i s) e hz

end Cech

end
