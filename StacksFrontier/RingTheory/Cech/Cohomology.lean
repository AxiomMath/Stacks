/-!
# Cohomology of the extended alternating Čech complex

Let `R` be a commutative ring, `f_1, …, f_r ∈ R` and `M` an `R`-module, and write `K` for
the extended alternating Čech complex `C^•(f_1, …, f_r; M)` regarded as a cochain complex
in integer degrees. Its cohomology is concentrated in the defining range `[0, r]`, is power
torsion for each of the chosen elements, and is therefore supported on their common zero
locus; it vanishes altogether as soon as some element of the ideal generated by the
`f_i` acts invertibly on `M`.

## Main results

* `Cech.cechComplex_homology_torsion_support_vanishes` gives the degree bound,
  power-torsion, support, and vanishing properties of the cohomology of `K`.
* `Cech.extendedCechObject_isZero_of_smul_unit` expresses the vanishing part in the
  derived category.
* `Cech.extendedCechObject_localized_isZero` applies it after localization at any element
  of the generated ideal.
* `Cech.extendedCechObject_baseChangeIso` carries the canonical base-change identification
  of Tag 0G6I to the integer-indexed derived objects.

## Implementation notes

The integer-indexed complex is the canonical extension of `Cech.cechComplex` from natural
to integer degrees along `ComplexShape.embeddingUpNat`, so it has zero terms outside the
interval `[0, r]`; cohomology in a degree coming from `ℕ` is transported along
`HomologicalComplex.extendHomologyIso`. Invertibility of the scalar action of `g` on `M` is
expressed as invertibility of the corresponding endomorphism `algebraMap R (Module.End R M) g`.

The power-torsion statement is obtained by localizing: over `Localization.Away (f i)` the
element `f i` becomes a unit, so the base-changed Čech complex is null homotopic by
Tag 0G6J, and flat base change of homology (`KoszulC.flat_homology_baseChange_of_linearEquiv`)
identifies its cohomology with the localization of the cohomology of `K`. The degree bound
holds because the terms of `K` vanish outside `[0, r]`, the support bound follows from power
torsion, and the vanishing holds because some power of `g` kills a given class while acting
injectively on cohomology. The derived-category statements are the forms of Tag 0G6K used in
the proof of Tag 091V.

## References

* [Stacks Project, Tag 0G6K](https://stacks.math.columbia.edu/tag/0G6K)
-/

@[expose] public section

namespace Cech

open CategoryTheory Limits
open scoped TensorProduct

universe u v w

attribute [local instance] HasDerivedCategory.standard

set_option backward.isDefEq.respectTransparency false

private lemma homology_subsingleton_of_nullHomotopic
    {R : Type u} [CommRing R] {K : CochainComplex (ModuleCat.{v} R) ℕ}
    (h : Nonempty (Homotopy (𝟙 K) 0)) (n : ℕ) : Subsingleton (K.homology n) := by
  rw [subsingleton_iff_forall_eq 0]
  intro x
  obtain ⟨h⟩ := h
  have hh := h.homologyMap_eq n
  rw [HomologicalComplex.homologyMap_id, HomologicalComplex.homologyMap_zero] at hh
  have hh' := congrArg ModuleCat.Hom.hom hh
  exact LinearMap.congr_fun hh' x

private lemma cechComplexBaseChange_d_hom
    {R : Type u} [CommRing R] {S : Type w} [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] (a b : ℕ) :
    ((Stacks.CechBaseChange.cechComplexBaseChange f M S).d a b).hom =
      LinearMap.baseChange S ((Cech.cechComplex f M).d a b).hom := by
  by_cases h : (ComplexShape.up ℕ).Rel a b
  · obtain rfl : b = a + 1 := h.symm
    simp only [Stacks.CechBaseChange.cechComplexBaseChange, Cech.cechComplex, CochainComplex.of_d,
      ModuleCat.hom_ofHom]
  · rw [HomologicalComplex.shape _ _ _ h, HomologicalComplex.shape _ _ _ h,
      ModuleCat.hom_zero]
    change (0 : TensorProduct R S (Cech.cechTerm f M a) →ₗ[S]
      TensorProduct R S (Cech.cechTerm f M b)) = LinearMap.baseChange S 0
    exact LinearMap.baseChange_zero.symm

private lemma cech_baseChange_homology_linearEquiv
    {R : Type u} [CommRing R] {S : Type w} [CommRing S] [Algebra R S] [Module.Flat R S]
    {r : ℕ} (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ) :
    Nonempty
      ((Stacks.CechBaseChange.cechComplexBaseChange f M S).homology n ≃ₗ[S]
        (S ⊗[R] ((Cech.cechComplex f M).homology n))) := by
  let C := Cech.cechComplex f M
  let C' := Stacks.CechBaseChange.cechComplexBaseChange f M S
  have hf : ((C'.sc n).f).hom = LinearMap.baseChange S ((C.sc n).f).hom :=
    cechComplexBaseChange_d_hom f M _ _
  have hg : ((C'.sc n).g).hom = LinearMap.baseChange S ((C.sc n).g).hom :=
    cechComplexBaseChange_d_hom f M _ _
  have hz' : ∀ x, ((C'.sc n).f).hom x ∈ LinearMap.ker ((C'.sc n).g).hom :=
    fun x ↦ LinearMap.mem_ker.mpr (ShortComplex.zero_apply (C'.sc n) x)
  have hz : ∀ x, ((C.sc n).f).hom x ∈ LinearMap.ker ((C.sc n).g).hom :=
    fun x ↦ LinearMap.mem_ker.mpr (ShortComplex.zero_apply (C.sc n) x)
  obtain ⟨e⟩ := KoszulC.flat_homology_baseChange_of_linearEquiv
    ((C.sc n).f).hom ((C.sc n).g).hom ((C'.sc n).f).hom ((C'.sc n).g).hom
    (LinearEquiv.refl S _) (LinearEquiv.refl S _) (LinearEquiv.refl S _)
    (fun x ↦ LinearMap.congr_fun hf x) (fun x ↦ LinearMap.congr_fun hg x) hz' hz
  exact ⟨((C'.sc n).moduleCatHomologyIso).toLinearEquiv.trans (e.trans
    (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl S S)
      ((C.sc n).moduleCatHomologyIso).toLinearEquiv.symm))⟩

private lemma cech_localized_homology_subsingleton
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (i : Fin r) (n : ℕ) :
    Subsingleton
      ((Localization.Away (f i)) ⊗[R] ((Cech.cechComplex f M).homology n)) := by
  let S := Localization.Away (f i)
  let g : Fin r → S := fun j ↦ algebraMap R S (f j)
  have hi : IsUnit (g i) := IsLocalization.map_units S ⟨f i, Submonoid.mem_powers _⟩
  obtain ⟨hc⟩ := Stacks.CechContractible.cechComplex_nullHomotopic g (S ⊗[R] M) ⟨i, hi⟩
  let F := ModuleCat.uliftFunctor.{u, max v u} S
  have ht : Subsingleton
      (((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        (Cech.cechComplex g (S ⊗[R] M))).homology n) :=
    homology_subsingleton_of_nullHomotopic ⟨F.mapHomotopy hc⟩ n
  obtain ⟨e, -⟩ := Stacks.CechBaseChange.exists_cechComplexBaseChange_iso f M S
  have hs : Subsingleton ((Stacks.CechBaseChange.cechComplexBaseChange f M S).homology n) := by
    let eh := (HomologicalComplex.homologyFunctor _ (ComplexShape.up ℕ) n).mapIso e
    have ht' : Subsingleton
        ((Stacks.CechBaseChange.cechComplexBaseChangeTarget f M S).homology n) := ht
    exact eh.toLinearEquiv.toEquiv.subsingleton_congr.mpr ht'
  obtain ⟨eb⟩ := cech_baseChange_homology_linearEquiv (S := S) f M n
  exact eb.symm.toEquiv.subsingleton

private lemma cech_homology_power_torsion
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (i : Fin r) (n : ℕ)
    (x : (Cech.cechComplex f M).homology n) :
    ∃ k : ℕ, 0 < k ∧ f i ^ k • x = 0 := by
  have hs := cech_localized_homology_subsingleton f M i n
  have ht : ∀ x : (Cech.cechComplex f M).homology n,
      ∃ s : R, s ∈ Submonoid.powers (f i) ∧ s • x = 0 :=
    (IsLocalizedModule.subsingleton_iff (Submonoid.powers (f i))
      (TensorProduct.mk R (Localization.Away (f i)) _ 1)).mp hs
  obtain ⟨_, ⟨k, rfl⟩, hk⟩ := ht x
  exact ⟨k + 1, Nat.succ_pos _, by
    simpa [pow_succ', mul_smul] using congrArg (fun y ↦ f i • y) hk⟩

private lemma homology_subsingleton_of_X
    {R : Type u} [CommRing R] {I : Type*} {c : ComplexShape I}
    (K : HomologicalComplex (ModuleCat.{v} R) c) (i : I) [Subsingleton (K.X i)] :
    Subsingleton (K.homology i) := by
  rw [← ModuleCat.isZero_iff_subsingleton]
  exact IsZero.of_epi (K.homologyπ i)
    (IsZero.of_mono (K.iCycles i) (ModuleCat.isZero_iff_subsingleton.mpr inferInstance))

private lemma cechTerm_subsingleton_of_lt
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] {n : ℕ} (h : r < n) :
    Subsingleton (Cech.cechTerm f M n) := by
  refine ⟨fun x y ↦ DirectSum.ext fun s ↦ ?_⟩
  have hs := Finset.card_le_univ s.1
  simp only [Fintype.card_fin] at hs
  omega

private lemma extend_homology_subsingleton
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (n : ℕ)
    (h : Subsingleton ((Cech.cechComplex f M).homology n)) :
    Subsingleton
      (((Cech.cechComplex f M).extend ComplexShape.embeddingUpNat).homology (n : ℤ)) :=
  (HomologicalComplex.extendHomologyIso (Cech.cechComplex f M) ComplexShape.embeddingUpNat
    (j := n) (j' := (n : ℤ)) (by simp)).toLinearEquiv.toEquiv.subsingleton

private lemma extend_homology_power_torsion
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (i : Fin r) (n : ℕ)
    (x : ((Cech.cechComplex f M).extend ComplexShape.embeddingUpNat).homology (n : ℤ)) :
    ∃ k : ℕ, 0 < k ∧ f i ^ k • x = 0 := by
  let e := HomologicalComplex.extendHomologyIso (Cech.cechComplex f M)
    ComplexShape.embeddingUpNat (j := n) (j' := (n : ℤ)) (by simp)
  obtain ⟨k, hk, hx⟩ := cech_homology_power_torsion f M i n (e.hom.hom x)
  refine ⟨k, hk, ?_⟩
  apply e.toLinearEquiv.injective
  simpa using hx

private lemma localized_smul_bijective
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    (S : Submonoid R) (g : R)
    (h : Function.Bijective (algebraMap R (Module.End R M) g)) :
    Function.Bijective
      (algebraMap R (Module.End R (LocalizedModule S M)) g) := by
  let l := LocalizedModule.mkLinearMap S M
  have heq : algebraMap R (Module.End R (LocalizedModule S M)) g =
      IsLocalizedModule.map S l l (algebraMap R (Module.End R M) g) := by
    refine LinearMap.ext fun x ↦ ?_
    induction x using LocalizedModule.induction_on with
    | _ m s =>
      simpa only [Module.algebraMap_end_apply, LocalizedModule.smul'_mk] using
        (IsLocalizedModule.map_LocalizedModules (S := S)
          (algebraMap R (Module.End R M) g) m s).symm
  rw [heq]
  exact ⟨IsLocalizedModule.map_injective S l l _ h.1,
    IsLocalizedModule.map_surjective S l l _ h.2⟩

private lemma cechTerm_smul_bijective
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (g : R)
    (h : Function.Bijective (algebraMap R (Module.End R M) g)) (n : ℕ) :
    Function.Bijective (algebraMap R (Module.End R (Cech.cechTerm f M n)) g) := by
  let e : Cech.cechTerm f M n ≃ₗ[R] Cech.cechTerm f M n :=
    DFinsupp.mapRange.linearEquiv fun s ↦
      LinearEquiv.ofBijective
        (algebraMap R (Module.End R (Cech.cechMod f M s.1)) g)
        (localized_smul_bijective (Cech.cechSub f s.1) g h)
  have he : e.toLinearMap = algebraMap R (Module.End R (Cech.cechTerm f M n)) g :=
    LinearMap.ext fun x ↦ DFinsupp.ext fun s ↦ rfl
  rw [← he]
  exact e.bijective

private lemma cech_homology_smul_injective
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (g : R)
    (h : Function.Bijective (algebraMap R (Module.End R M) g)) (n : ℕ) :
    Function.Injective
      (algebraMap R (Module.End R ((Cech.cechComplex f M).homology n)) g) := by
  let C := Cech.cechComplex f M
  let φ : C ⟶ C := g • 𝟙 C
  let (p : ℕ) : IsIso (φ.f p) := by
    rw [ConcreteCategory.isIso_iff_bijective]
    have he : (φ.f p).hom =
        algebraMap R (Module.End R (Cech.cechTerm f M p)) g := by
      ext x
      rfl
    change Function.Bijective (φ.f p).hom
    rw [he]
    exact cechTerm_smul_bijective f M g h p
  let : IsIso φ := HomologicalComplex.Hom.isIso_of_components φ
  have hi := (ConcreteCategory.bijective_of_isIso
    (HomologicalComplex.homologyMap φ n)).injective
  change Function.Injective (HomologicalComplex.homologyMap φ n).hom at hi
  have he : (HomologicalComplex.homologyMap φ n).hom =
      algebraMap R (Module.End R ((Cech.cechComplex f M).homology n)) g := by
    let F := HomologicalComplex.shortComplexFunctor (ModuleCat R) (ComplexShape.up ℕ) n
    have hsc : F.map φ = g • F.map (𝟙 C) := by
      ext <;> rfl
    dsimp [HomologicalComplex.homologyMap]
    rw [hsc, ShortComplex.homologyMap_smul, F.map_id, ShortComplex.homologyMap_id]
    ext x
    rfl
  exact he ▸ hi

/-- **Stacks 0G6K.** The cohomology of the extended alternating Čech complex is
concentrated in degrees `0, …, r`; every chosen element acts locally nilpotently
on every cohomology class; its support lies in the common zero locus of the chosen
elements; and all cohomology vanishes when an element of their generated ideal
acts invertibly on the coefficient module. -/
@[stacks 0G6K]
theorem cechComplex_homology_torsion_support_vanishes
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M] (q : ℤ) :
    let K : CochainComplex (ModuleCat.{max u v} R) ℤ :=
      (Cech.cechComplex f M).extend ComplexShape.embeddingUpNat
    ((q < 0 ∨ (r : ℤ) < q) → Subsingleton (K.homology q)) ∧
      (∀ (i : Fin r) (x : K.homology q),
        ∃ n : ℕ, 0 < n ∧ f i ^ n • x = 0) ∧
      Module.support R (K.homology q) ⊆
        PrimeSpectrum.zeroLocus (Ideal.span (Set.range f) : Set R) ∧
      ((∃ g ∈ Ideal.span (Set.range f),
          IsUnit (algebraMap R (Module.End R M) g)) →
        Subsingleton (K.homology q)) := by
  dsimp only
  let K := (Cech.cechComplex f M).extend ComplexShape.embeddingUpNat
  by_cases hq : 0 ≤ q
  · obtain ⟨n, rfl⟩ : ∃ n : ℕ, q = n := ⟨q.toNat, by simp [hq]⟩
    have htors : ∀ (i : Fin r) (x : K.homology (n : ℤ)),
        ∃ k : ℕ, 0 < k ∧ f i ^ k • x = 0 :=
      fun i x ↦ extend_homology_power_torsion f M i n x
    have hsupp : Module.support R (K.homology (n : ℤ)) ⊆
        PrimeSpectrum.zeroLocus (Ideal.span (Set.range f) : Set R) := by
      intro p hp
      rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      obtain ⟨x, hx⟩ := Module.mem_support_iff_exists_annihilator.mp hp
      obtain ⟨k, hk, hkill⟩ := htors i x
      exact p.isPrime.mem_of_pow_mem k
        (hx ((Submodule.mem_annihilator_span_singleton x (f i ^ k)).mpr hkill))
    refine ⟨?_, htors, hsupp, ?_⟩
    · intro houtside
      rcases houtside with hneg | hhigh
      · omega
      · have hrn : r < n := by exact_mod_cast hhigh
        have : Subsingleton ((Cech.cechComplex f M).X n) :=
          cechTerm_subsingleton_of_lt f M hrn
        exact extend_homology_subsingleton f M n
          (homology_subsingleton_of_X (Cech.cechComplex f M) n)
    · rintro ⟨g, hg, hunit⟩
      rw [subsingleton_iff_forall_eq 0]
      intro x
      have hrad : g ∈ (Submodule.span R {x}).annihilator.radical := by
        apply (Ideal.span_le.mpr ?_) hg
        rintro _ ⟨i, rfl⟩
        obtain ⟨k, hk, hkill⟩ := htors i x
        exact ⟨k, (Submodule.mem_annihilator_span_singleton x (f i ^ k)).mpr hkill⟩
      obtain ⟨k, hk⟩ := (Ideal.mem_radical_iff.mp hrad)
      have hkill : g ^ k • x = 0 :=
        (Submodule.mem_annihilator_span_singleton x (g ^ k)).mp hk
      let e := HomologicalComplex.extendHomologyIso (Cech.cechComplex f M)
        ComplexShape.embeddingUpNat (j := n) (j' := (n : ℤ)) (by simp)
      have huPow : IsUnit (algebraMap R (Module.End R M) (g ^ k)) := by
        rw [map_pow]
        exact hunit.pow k
      have hinj := cech_homology_smul_injective f M (g ^ k)
        ((Module.End.isUnit_iff _).mp huPow) n
      apply e.toLinearEquiv.injective
      apply hinj
      simpa only [Module.algebraMap_end_apply, map_zero, map_smul] using
        congrArg e.toLinearEquiv hkill
  · have hneg : q < 0 := lt_of_not_ge hq
    have hzX : IsZero (K.X q) := by
      apply HomologicalComplex.isZero_extend_X
      intro n hn
      rw [ComplexShape.embeddingUpNat_f] at hn
      omega
    have hzero : Subsingleton (K.homology q) :=
      have := ModuleCat.isZero_iff_subsingleton.mp hzX
      homology_subsingleton_of_X K q
    refine ⟨fun _ ↦ hzero, ?_, ?_, fun _ ↦ hzero⟩
    · intro i x
      exact ⟨1, by simp, Subsingleton.elim _ _⟩
    · intro p hp
      let : Subsingleton (K.homology q) := hzero
      have he := Module.support_eq_empty (R := R) (M := K.homology q)
      rw [he] at hp
      simp at hp

/-- The derived-category form of the vanishing conclusion of Stacks 0G6K.
The complex here has coefficients in `M`, so it can be used after any scalar
extension once that extension has been identified with a Čech complex. -/
theorem extendedCechObject_isZero_of_smul_unit
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type v) [AddCommGroup M] [Module R M]
    (h : ∃ g ∈ Ideal.span (Set.range f),
      IsUnit (algebraMap R (Module.End R M) g)) :
    IsZero (DerivedCategory.Q.obj
      ((Cech.cechComplex f M).extend ComplexShape.embeddingUpNat)) := by
  let K := (Cech.cechComplex f M).extend ComplexShape.embeddingUpNat
  have hh : ∀ q : ℤ, IsZero (K.homology q) := by
    intro q
    have hs := (cechComplex_homology_torsion_support_vanishes f M q).2.2.2 h
    exact ModuleCat.isZero_iff_subsingleton.mpr hs
  have he : K.Acyclic := by
    intro q
    exact (HomologicalComplex.exactAt_iff_isZero_homology K q).mpr (hh q)
  have hqi : QuasiIso
      (0 : K ⟶ (HomologicalComplex.zero : CochainComplex (ModuleCat.{max u v} R) ℤ)) := by
    rw [quasiIso_iff]
    intro q
    exact (quasiIsoAt_iff_exactAt' _ _
      ((HomologicalComplex.acyclic_of_isZero _ HomologicalComplex.isZero_zero) q)).mpr (he q)
  let : QuasiIso
      (0 : K ⟶ (HomologicalComplex.zero : CochainComplex (ModuleCat.{max u v} R) ℤ)) := hqi
  let e : DerivedCategory.Q.obj K ≅ DerivedCategory.Q.obj
      (HomologicalComplex.zero : CochainComplex (ModuleCat.{max u v} R) ℤ) :=
    asIso (DerivedCategory.Q.map
      (0 : K ⟶ (HomologicalComplex.zero : CochainComplex (ModuleCat.{max u v} R) ℤ)))
  exact IsZero.of_iso (Functor.map_isZero DerivedCategory.Q HomologicalComplex.isZero_zero) e

/-- If `g` belongs to the ideal generated by `f`, the extended Čech complex
with coefficients localized at `g` vanishes in the derived category of
`R`-modules. This is the localized complex appearing in the proof of Stacks
091V. -/
theorem extendedCechObject_localized_isZero
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (g : R) (hg : g ∈ Ideal.span (Set.range f)) :
    IsZero (DerivedCategory.Q.obj
      ((Cech.cechComplex f (Localization.Away g)).extend
        ComplexShape.embeddingUpNat)) :=
  extendedCechObject_isZero_of_smul_unit f (Localization.Away g) ⟨g, hg,
    IsLocalizedModule.map_units (Algebra.linearMap R (Localization.Away g))
      ⟨g, Submonoid.mem_powers g⟩⟩

/-- The canonical base-change comparison of Stacks 0G6I, extended to integer
degrees and passed to the derived category. The target is universe-lifted as
in `Stacks.CechBaseChange.exists_cechComplexBaseChange_iso`. -/
theorem extendedCechObject_baseChangeIso
    {R : Type u} [CommRing R] {S : Type w} [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] :
    Nonempty
      (DerivedCategory.Q.obj
        ((Stacks.CechBaseChange.cechComplexBaseChange f M S).extend ComplexShape.embeddingUpNat) ≅
       DerivedCategory.Q.obj
        ((Stacks.CechBaseChange.cechComplexBaseChangeTarget f M S).extend
          ComplexShape.embeddingUpNat)) := by
  obtain ⟨e, -⟩ := Stacks.CechBaseChange.exists_cechComplexBaseChange_iso f M S
  exact ⟨DerivedCategory.Q.mapIso
    ((ComplexShape.embeddingUpNat.extendFunctor _).mapIso e)⟩

end Cech

end
