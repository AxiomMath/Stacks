module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.Homology.HomologicalComplex
public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.RingTheory.Localization.BaseChange

/-!
# The extended alternating Čech complex

Let `R` be a commutative ring, let `f : Fin r → R` be a finite family of elements of `R`, and let
`M` be an `R`-module.  For a finite set `s : Finset (Fin r)` of indices we form the localization
of `M` at the product `∏ i ∈ s, f i`; as `s` grows these localizations are connected by canonical
maps, and the resulting alternating complex

`C^p = ⨁_{#s = p} M_{∏ i ∈ s, f i}`

is the *extended alternating Čech complex* of `M` with respect to `f`. Its degree-`p` term is
indexed by the `p`-element subsets of `Fin r`, so it vanishes for `p > r`.

## Main definitions

* `Cech.cechSub f s`: the multiplicative set `Submonoid.powers (∏ i ∈ s, f i)`.
* `Cech.cechMod f M s`: the localized module `M_{∏ i ∈ s, f i}`.
* `Cech.cechι f M h`: for `h : s ⊆ t`, the canonical map `cechMod f M s →ₗ[R] cechMod f M t`.
* `Cech.bridgeClosure f M s`: the identification of `cechMod f M s` with the localization of `M`
  at the submonoid generated by the individual elements `f i`, `i ∈ s`.
* `Cech.cechSign s i`: the sign `(-1) ^ j`, where `j` is the position at which `i` is inserted
  into the sorted set `insert i s`.
* `Cech.cechTerm f M p`, `Cech.cechD f M p`, `Cech.cechComplex f M`: the terms, the differentials
  and the complex itself.

## Main results

* `Cech.instClosureOfPowers`: localizing `M` at the powers of `∏ i ∈ s, f i` also localizes `M` at
  the submonoid generated by the elements `f i`, `i ∈ s`.  The two multiplicative sets are
  different, but they have the same localization.
* `Cech.cechD_comp_cechD`: the differentials square to zero.
* `Cech.cechComplex_d`: the differential of the complex in adjacent degrees is `Cech.cechD`.
-/

@[expose] public section

universe u v

open Finset

namespace Cech

variable {R : Type u} [CommRing R] {r : ℕ}

/-! ### The localizing submonoid -/

/-- The multiplicative set attached to a finite set `s` of indices: the powers of the product
`∏ i ∈ s, f i`.  Localizing at it inverts `f_{i₀} ⋯ f_{i_{p-1}}`. -/
abbrev cechSub (f : Fin r → R) (s : Finset (Fin r)) : Submonoid R :=
  Submonoid.powers (∏ i ∈ s, f i)

/-- The localized module `M_{f_{i₀} ⋯ f_{i_{p-1}}}` attached to a finite set `s` of indices. -/
abbrev cechMod (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M]
    (s : Finset (Fin r)) : Type _ := LocalizedModule (cechSub f s) M

/-- Every element of the submonoid generated by `{f i : i ∈ s}` divides a power of the product
`∏ i ∈ s, f i`. -/
theorem dvd_pow_prod {f : Fin r → R} {s : Finset (Fin r)}
    (x : Submonoid.closure (f '' (s : Set (Fin r)))) :
    ∃ m : R, m * (x : R) ∈ cechSub f s := by
  obtain ⟨x, hx⟩ := x
  induction hx using Submonoid.closure_induction with
  | one => exact ⟨1, 0, by simp⟩
  | mem y hy =>
      obtain ⟨i, hi, rfl⟩ := hy
      refine ⟨∏ j ∈ s.erase i, f j, 1, ?_⟩
      show (∏ i ∈ s, f i) ^ 1 = _
      rw [pow_one]
      exact (Finset.prod_erase_mul _ _ (by exact_mod_cast hi)).symm
  | mul a b _ _ ha hb =>
      obtain ⟨ma, na, hna⟩ := ha
      obtain ⟨mb, nb, hnb⟩ := hb
      refine ⟨ma * mb, na + nb, ?_⟩
      show (∏ i ∈ s, f i) ^ (na + nb) = _
      simp only at hna hnb
      rw [pow_add, hna, hnb]
      push_cast
      ring

/-- The powers of `∏ i ∈ s, f i` lie in the submonoid generated by `{f i : i ∈ t}` whenever
`s ⊆ t`. -/
theorem cechSub_le_closure (f : Fin r → R) {s t : Finset (Fin r)} (h : s ⊆ t) :
    cechSub f s ≤ Submonoid.closure (f '' (t : Set (Fin r))) := by
  rw [Submonoid.powers_le]
  exact Submonoid.prod_mem _ fun i hi =>
    Submonoid.subset_closure (Set.mem_image_of_mem f (by exact_mod_cast h hi))

/-- Localizing `M` at the powers of `∏ i ∈ s, f i` also localizes `M` at the submonoid generated
by the individual elements `f i`, `i ∈ s`. -/
instance instClosureOfPowers (f : Fin r → R) (s : Finset (Fin r)) (M : Type v)
    [AddCommGroup M] [Module R M] :
    IsLocalizedModule (Submonoid.closure (f '' (s : Set (Fin r))))
      (LocalizedModule.mkLinearMap (cechSub f s) M) :=
  IsLocalizedModule.of_exists_mul_mem _ _ (cechSub_le_closure f le_rfl) dvd_pow_prod _

variable (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M]

/-- Monotonicity of the submonoid generated by `{f i : i ∈ s}`. -/
theorem closure_mono_of_subset {s t : Finset (Fin r)} (h : s ⊆ t) :
    Submonoid.closure (f '' (s : Set (Fin r))) ≤ Submonoid.closure (f '' (t : Set (Fin r))) :=
  Submonoid.closure_mono (Set.image_mono (by exact_mod_cast h))

/-- Each element of `cechSub f s` acts invertibly on any localization of `M` at the submonoid
generated by `{f i : i ∈ t}`, for `s ⊆ t`. -/
theorem isUnit_algebraMap {s t : Finset (Fin r)} (h : s ⊆ t) {N : Type*} [AddCommGroup N]
    [Module R N] (g : M →ₗ[R] N)
    [IsLocalizedModule (Submonoid.closure (f '' (t : Set (Fin r)))) g] (x : cechSub f s) :
    IsUnit ((algebraMap R (Module.End R N)) (x : R)) :=
  IsLocalizedModule.map_units g ⟨(x : R), cechSub_le_closure f h x.2⟩

/-! ### The identification with the localization at the individual elements -/

/-- The identification of `M_{∏ i ∈ s, f i}` with the localization of `M` at the submonoid
generated by the individual elements `f i`, `i ∈ s`. -/
noncomputable def bridgeClosure (s : Finset (Fin r)) :
    cechMod f M s ≃ₗ[R] LocalizedModule (Submonoid.closure (f '' (s : Set (Fin r)))) M :=
  IsLocalizedModule.linearEquiv (Submonoid.closure (f '' (s : Set (Fin r))))
    (LocalizedModule.mkLinearMap (cechSub f s) M)
    (LocalizedModule.mkLinearMap (Submonoid.closure (f '' (s : Set (Fin r)))) M)

/-- `bridgeClosure` sends the image of `m` in `M_{∏ i ∈ s, f i}` to the image of `m` in the
localization at the submonoid generated by the `f i`, `i ∈ s`. -/
theorem bridgeClosure_mk (s : Finset (Fin r)) (m : M) :
    bridgeClosure f M s (LocalizedModule.mkLinearMap (cechSub f s) M m)
      = LocalizedModule.mkLinearMap (Submonoid.closure (f '' (s : Set (Fin r)))) M m :=
  IsLocalizedModule.linearEquiv_apply _ _ _ m

/-! ### The transition maps -/

/-- The canonical map `M_{∏ i ∈ s, f i} → M_{∏ i ∈ t, f i}` for `s ⊆ t`, inverting the further
elements `f i`, `i ∈ t \ s`. -/
noncomputable def cechι {s t : Finset (Fin r)} (h : s ⊆ t) :
    cechMod f M s →ₗ[R] cechMod f M t :=
  IsLocalizedModule.liftOfLE _ _ (closure_mono_of_subset f h)
    (LocalizedModule.mkLinearMap (cechSub f s) M)
    (LocalizedModule.mkLinearMap (cechSub f t) M)

/-- The transition map `cechι` is compatible with the localization maps from `M`. -/
@[simp] theorem cechι_comp_mk {s t : Finset (Fin r)} (h : s ⊆ t) :
    (cechι f M h).comp (LocalizedModule.mkLinearMap (cechSub f s) M)
      = LocalizedModule.mkLinearMap (cechSub f t) M :=
  IsLocalizedModule.liftOfLE_comp _ _ _ _ _

/-- The transition map `cechι` sends the image of `m` in `M_{∏ i ∈ s, f i}` to the image of `m`
in `M_{∏ i ∈ t, f i}`. -/
theorem cechι_mk {s t : Finset (Fin r)} (h : s ⊆ t) (m : M) :
    cechι f M h (LocalizedModule.mkLinearMap (cechSub f s) M m)
      = LocalizedModule.mkLinearMap (cechSub f t) M m :=
  LinearMap.congr_fun (cechι_comp_mk f M h) m

/-- The transition maps compose: `cechι` for `t ⊆ w` after `cechι` for `s ⊆ t` is `cechι` for
`s ⊆ w`. -/
theorem cechι_comp {s t w : Finset (Fin r)} (h : s ⊆ t) (h' : t ⊆ w) :
    (cechι f M h').comp (cechι f M h) = cechι f M (h.trans h') := by
  refine IsLocalizedModule.ext (cechSub f s) (LocalizedModule.mkLinearMap (cechSub f s) M)
    (isUnit_algebraMap f M (h.trans h') (LocalizedModule.mkLinearMap (cechSub f w) M)) ?_
  rw [LinearMap.comp_assoc, cechι_comp_mk, cechι_comp_mk, cechι_comp_mk]

/-- Applying the transition maps for `s ⊆ t` and `t ⊆ w` in turn is applying the transition map
for `s ⊆ w`. -/
theorem cechι_cechι {s t w : Finset (Fin r)} (h : s ⊆ t) (h' : t ⊆ w) (x : cechMod f M s) :
    cechι f M h' (cechι f M h x) = cechι f M (h.trans h') x :=
  LinearMap.congr_fun (cechι_comp f M h h') x

/-- The transition map for `s ⊆ s` is the identity. -/
@[simp] theorem cechι_rfl (s : Finset (Fin r)) : cechι f M (le_refl s) = LinearMap.id := by
  refine IsLocalizedModule.ext (cechSub f s) (LocalizedModule.mkLinearMap (cechSub f s) M)
    (isUnit_algebraMap f M (le_refl s) (LocalizedModule.mkLinearMap (cechSub f s) M)) ?_
  rw [cechι_comp_mk, LinearMap.id_comp]

/-- The transition maps are compatible with `bridgeClosure`: identifying both sides with the
localizations at the submonoids generated by the individual elements turns `cechι` into the
canonical map between those. -/
theorem bridgeClosure_naturality {s t : Finset (Fin r)} (h : s ⊆ t) :
    (bridgeClosure f M t).toLinearMap.comp (cechι f M h)
      = (IsLocalizedModule.liftOfLE _ _ (closure_mono_of_subset f h)
          (LocalizedModule.mkLinearMap (Submonoid.closure (f '' (s : Set (Fin r)))) M)
          (LocalizedModule.mkLinearMap (Submonoid.closure (f '' (t : Set (Fin r)))) M)).comp
        (bridgeClosure f M s).toLinearMap := by
  refine IsLocalizedModule.ext (cechSub f s) (LocalizedModule.mkLinearMap (cechSub f s) M)
    (isUnit_algebraMap f M (h.trans le_rfl)
      (LocalizedModule.mkLinearMap (Submonoid.closure (f '' (t : Set (Fin r)))) M)) ?_
  ext m
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, cechι_mk, bridgeClosure_mk]
  rw [← LinearMap.comp_apply, IsLocalizedModule.liftOfLE_comp]

/-! ### Signs -/

/-- The sign `(-1) ^ j` of the Čech differential, where `j = #{k ∈ s : k < i}` is the position at
which `i` is inserted into the sorted set `insert i s`. -/
def cechSign (s : Finset (Fin r)) (i : Fin r) : ℤ := (-1) ^ (s.filter (· < i)).card

/-- The sign `cechSign s k` does not change when `k` is inserted into `s`. -/
@[simp] theorem cechSign_insert (k : Fin r) (T : Finset (Fin r)) :
    cechSign (insert k T) k = cechSign T k := by
  simp [cechSign, Finset.filter_insert]

/-- The sign `cechSign s k` does not change when `k` is erased from `s`. -/
@[simp] theorem cechSign_erase (T : Finset (Fin r)) (k : Fin r) :
    cechSign (T.erase k) k = cechSign T k := by
  simp [cechSign, Finset.filter_erase, Finset.erase_eq_of_notMem]

/-- If `A + B = C + D + 1`, then `(-1) ^ D * (-1) ^ A = -((-1) ^ C * (-1) ^ B)`. -/
theorem sign_anti (D A C B : ℕ) (key : A + B = C + D + 1) :
    ((-1 : ℤ) ^ D * (-1) ^ A) = - ((-1) ^ C * (-1) ^ B) := by
  have h : (-1 : ℤ) ^ (C + B + 1) = (-1) ^ (D + A) := by
    rw [neg_one_pow_eq_pow_mod_two, neg_one_pow_eq_pow_mod_two (n := D + A)]
    congr 1
    omega
  rw [← pow_add, ← pow_add, ← h, pow_succ]
  ring

/-- Inserting two distinct new indices into `s` in the two possible orders picks up opposite
signs. -/
theorem cechSign_swap (s : Finset (Fin r)) {i j : Fin r}
    (hij : i ≠ j) (hi : i ∉ s) (hj : j ∉ s) :
    cechSign s i * cechSign (insert i s) j
      = - (cechSign s j * cechSign (insert j s) i) := by
  unfold cechSign
  apply sign_anti
  rw [Finset.filter_insert, Finset.filter_insert]
  rcases lt_or_gt_of_ne hij with h | h
  · rw [ite_eq_left h, ite_eq_right (by omega), Finset.card_insert_of_notMem (by simp [hi])]
    omega
  · rw [ite_eq_right (by omega), ite_eq_left h, Finset.card_insert_of_notMem (by simp [hj])]
    omega

/-- A double sum over `a ∉ s` and then `b ∉ insert a s` of an antisymmetric family vanishes. -/
theorem double_sum_antisymm_zero {α : Type*} [Fintype α] [DecidableEq α]
    {T : Type*} [AddCommGroup T] (s : Finset α) (g : α → α → T)
    (h : ∀ a ∈ sᶜ, ∀ b ∈ sᶜ, a ≠ b → g a b = -g b a) :
    ∑ a ∈ sᶜ.attach, ∑ b ∈ (insert a.1 s)ᶜ.attach, g a.1 b.1 = 0 := by
  rw [Finset.sum_attach sᶜ (fun a => ∑ b ∈ (insert a s)ᶜ.attach, g a b.1)]
  have hcompl : ∀ a : α, (insert a s)ᶜ = sᶜ.erase a := by
    intro a; ext x; simp [Finset.mem_erase]
  rw [Finset.sum_congr rfl (fun a _ => by
    rw [Finset.sum_attach (insert a s)ᶜ (fun b => g a b), hcompl a])]
  have hconv : ∑ a ∈ sᶜ, ∑ x ∈ sᶜ.erase a, g a x = ∑ p ∈ sᶜ.offDiag, g p.1 p.2 := by
    rw [Finset.sum_sigma']
    apply Finset.sum_nbij' (fun p => (p.1, p.2)) (fun p => ⟨p.1, p.2⟩)
    · rintro ⟨a, b⟩ hab
      simp only [Finset.mem_sigma, Finset.mem_erase] at hab
      simp [Finset.mem_offDiag, hab.1, hab.2.2, Ne.symm hab.2.1]
    · rintro ⟨a, b⟩ hab
      simp only [Finset.mem_offDiag] at hab
      simp [Finset.mem_sigma, Finset.mem_erase, hab.1, hab.2.1, Ne.symm hab.2.2]
    · rintro ⟨a, b⟩ _; rfl
    · rintro ⟨a, b⟩ _; rfl
    · rintro ⟨a, b⟩ _; rfl
  rw [hconv]
  apply Finset.sum_involution (fun p _ => (p.2, p.1))
  · rintro ⟨a, b⟩ hab
    simp only [Finset.mem_offDiag] at hab
    rw [h a hab.1 b hab.2.1 hab.2.2]; simp
  · rintro ⟨a, b⟩ hab hfne
    simp only [Finset.mem_offDiag] at hab
    simp only [ne_eq, Prod.mk.injEq, not_and]
    exact fun hba _ ↦ hab.2.2 hba.symm
  · rintro ⟨a, b⟩ hab
    simp only [Finset.mem_offDiag] at hab ⊢
    exact ⟨hab.2.1, hab.1, (Ne.symm hab.2.2)⟩
  · rintro ⟨a, b⟩ _; rfl

/-! ### The complex -/

/-- The degree-`p` term of the extended alternating Čech complex: the direct sum of the modules
`M_{∏ i ∈ s, f i}` over all `p`-element sets `s` of indices. -/
abbrev cechTerm (p : ℕ) : Type _ :=
  DirectSum {s : Finset (Fin r) // s.card = p} (fun s => cechMod f M s.1)

/-- The differential `d^p : C^p → C^{p+1}`: on the summand indexed by `s` it is the sum over
`i ∉ s` of the transition map into the summand indexed by `insert i s`, weighted by
`cechSign s i`. -/
noncomputable def cechD (p : ℕ) : cechTerm f M p →ₗ[R] cechTerm f M (p + 1) :=
  DirectSum.toModule R _ _ fun s =>
    ∑ i ∈ s.1ᶜ.attach, cechSign s.1 i.1 •
      (DirectSum.lof R {t : Finset (Fin r) // t.card = p + 1} (fun t => cechMod f M t.1)
          ⟨insert i.1 s.1, by
            rw [Finset.card_insert_of_notMem (by simpa using Finset.mem_compl.1 i.2), s.2]⟩).comp
        (cechι f M (Finset.subset_insert i.1 s.1))

/-- The differential `cechD` on the summand indexed by `s`: the sum over `i ∉ s` of
`cechSign s i` times the transition map into the summand indexed by `insert i s`. -/
theorem cechD_lof (p : ℕ) (s : {s : Finset (Fin r) // s.card = p}) (x : cechMod f M s.1) :
    cechD f M p (DirectSum.lof R _ (fun t => cechMod f M t.1) s x)
      = ∑ i ∈ s.1ᶜ.attach, cechSign s.1 i.1 •
          DirectSum.lof R {t : Finset (Fin r) // t.card = p + 1} (fun t => cechMod f M t.1)
            ⟨insert i.1 s.1, by
              rw [Finset.card_insert_of_notMem (by simpa using Finset.mem_compl.1 i.2), s.2]⟩
            (cechι f M (Finset.subset_insert i.1 s.1) x) := by
  rw [cechD, DirectSum.toModule_lof]
  simp only [LinearMap.coe_sum, Finset.sum_apply, LinearMap.smul_apply, LinearMap.comp_apply]

/-- The differentials of the extended alternating Čech complex square to zero. -/
theorem cechD_comp_cechD (p : ℕ) : (cechD f M (p + 1)).comp (cechD f M p) = 0 := by
  refine DirectSum.linearMap_ext R fun s => LinearMap.ext fun y => ?_
  simp only [LinearMap.comp_apply, LinearMap.zero_apply, LinearMap.zero_comp]
  rw [cechD_lof, map_sum]
  simp only [map_zsmul]
  rw [Finset.sum_congr rfl (fun i _ => by rw [cechD_lof])]
  simp only [Finset.smul_sum, smul_smul]
  set g : Fin r → Fin r → cechTerm f M (p + 1 + 1) := fun a b =>
    if h : (insert b (insert a s.1)).card = p + 1 + 1 then
      (cechSign s.1 a * cechSign (insert a s.1) b) •
        DirectSum.lof R {t : Finset (Fin r) // t.card = p + 1 + 1}
          (fun t => cechMod f M t.1) ⟨insert b (insert a s.1), h⟩
          (cechι f M ((Finset.subset_insert a s.1).trans
            (Finset.subset_insert b (insert a s.1))) y)
    else 0 with hg
  have hcard : ∀ a b, a ∉ s.1 → b ∉ insert a s.1 →
      (insert b (insert a s.1)).card = p + 1 + 1 := fun a b ha hb => by
    rw [Finset.card_insert_of_notMem hb, Finset.card_insert_of_notMem ha, s.2]
  have hbody : ∀ a ∈ s.1ᶜ.attach, ∀ b ∈ (insert a.1 s.1)ᶜ.attach,
      (cechSign s.1 a.1 * cechSign (insert a.1 s.1) b.1) •
        DirectSum.lof R {t : Finset (Fin r) // t.card = p + 1 + 1}
          (fun t => cechMod f M t.1)
          ⟨insert b.1 (insert a.1 s.1),
            hcard a.1 b.1 (Finset.mem_compl.1 a.2) (Finset.mem_compl.1 b.2)⟩
          (cechι f M (Finset.subset_insert b.1 (insert a.1 s.1))
            (cechι f M (Finset.subset_insert a.1 s.1) y))
        = g a.1 b.1 := by
    intro a _ b _
    rw [hg]
    simp only [dite_eq_left (hcard a.1 b.1 (Finset.mem_compl.1 a.2) (Finset.mem_compl.1 b.2))]
    rw [cechι_cechι]
  rw [Finset.sum_congr rfl (fun a ha => Finset.sum_congr rfl (fun b hb => hbody a ha b hb))]
  refine double_sum_antisymm_zero s.1 g fun a ha b hb hab => ?_
  have hane : a ∉ s.1 := by simpa using Finset.mem_compl.1 ha
  have hbne : b ∉ s.1 := by simpa using Finset.mem_compl.1 hb
  have hcardab := hcard a b hane (by simp [hbne, Ne.symm hab])
  have hcardba := hcard b a hbne (by simp [hane, hab])
  rw [hg]
  simp only [dite_eq_left hcardab, dite_eq_left hcardba]
  have hlof : ∀ (T : Finset (Fin r)) (hT : T.card = p + 1 + 1) (hsT : s.1 ⊆ T)
      (T' : Finset (Fin r)) (hT' : T'.card = p + 1 + 1) (hsT' : s.1 ⊆ T') (hTT' : T = T'),
      DirectSum.lof R {t : Finset (Fin r) // t.card = p + 1 + 1}
          (fun t => cechMod f M t.1) ⟨T, hT⟩ (cechι f M hsT y)
        = DirectSum.lof R {t : Finset (Fin r) // t.card = p + 1 + 1}
          (fun t => cechMod f M t.1) ⟨T', hT'⟩ (cechι f M hsT' y) := by
    rintro T hT hsT T' hT' hsT' rfl
    rfl
  rw [cechSign_swap s.1 hab hane hbne, hlof (insert b (insert a s.1)) hcardab
    ((Finset.subset_insert a s.1).trans (Finset.subset_insert b _))
    (insert a (insert b s.1)) hcardba
    ((Finset.subset_insert b s.1).trans (Finset.subset_insert a _))
    (Finset.insert_comm b a s.1), neg_smul]

/-- The extended alternating Čech complex `C^•(f₁, …, f_r; M)`, as a cochain complex of `R`-modules
indexed by `ℕ`; the terms in degrees `> r` vanish, the index type of the direct sum being empty
there. -/
noncomputable def cechComplex : CochainComplex (ModuleCat.{max u v} R) ℕ :=
  CochainComplex.of (fun p => ModuleCat.of R (cechTerm f M p))
    (fun p => ModuleCat.ofHom (cechD f M p))
    (fun p => by
      apply ModuleCat.hom_ext
      simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, ModuleCat.hom_zero]
      exact cechD_comp_cechD f M p)

/-- The differential of `Cech.cechComplex` in adjacent degrees. -/
theorem cechComplex_d (p : ℕ) :
    (cechComplex f M).d p (p + 1) = ModuleCat.ofHom (cechD f M p) :=
  CochainComplex.of_d (fun p => ModuleCat.of R (cechTerm f M p))
    (fun p => ModuleCat.ofHom (cechD f M p)) p

end Cech
