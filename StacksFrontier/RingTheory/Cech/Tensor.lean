module

public import StacksFrontier.RingTheory.Cech.Substrate

/-!
# The extended alternating Čech complex as a base change

Let `R` be a commutative ring, `f_1, …, f_r ∈ R` and `M` an `R`-module. In cohomological
degree `p` the extended alternating Čech complex `Č^•(M)` has the term
`⨁_{#s = p} M_{∏_{i ∈ s} f_i}`, the differential being the alternating sum
`d(x)_{i_0 … i_p} = ∑_j (-1)^j x_{i_0 … î_j … i_p}` of the canonical localization maps.
Localization of a module is computed by base change, `M ⊗_R R_g ≅ M_g`, and tensor products
commute with direct sums; combining the two identifies `Č^p(M)` with `M ⊗_R Č^p(R)`,
compatibly with the differentials. This exhibits `Č^•(M)` as `M ⊗_R Č^•(R)`, an isomorphism
of cochain complexes of `R`-modules.

## Main definitions

* `LocalizedModule.tensorEquiv`: the canonical isomorphism `M ⊗_R R_S ≅ M_S` at a
  single localizing submonoid `S`, `m ⊗ (a / s) ↦ (a · m) / s`.
* `ExtendedCech.termTensorEquiv`: the degreewise isomorphism `Č^p(M) ≃ₗ[R] M ⊗_R Č^p(R)`,
  assembled from `LocalizedModule.tensorEquiv` over the summands.

## Main results

* `LocalizedModule.tensorEquiv_tmul`: `LocalizedModule.tensorEquiv` on a `tmul`.
* `ExtendedCech.cechι_tensorEquiv_tmul`: `LocalizedModule.tensorEquiv` is natural for the
  transition maps `Cech.cechι`.
* `ExtendedCech.termTensorEquiv_lof`, `ExtendedCech.termTensorEquiv_lof_tmul`:
  `termTensorEquiv` on a direct-sum generator.
* `ExtendedCech.termTensorEquiv_comm_d`: the degreewise isomorphisms commute with the Čech
  differentials, the differential of `M ⊗_R Č^•(R)` being `id_M ⊗ d_R`.

## Implementation notes

* Strictly increasing index tuples `1 ≤ i_0 < ⋯ < i_{p-1} ≤ r` are modeled as subsets
  `s : Finset (Fin r)` with `s.card = p`, with `0`-indexing via `Fin r`.
* The terms, the transition maps `Cech.cechι`, the signs and the differential `Cech.cechD`
  are the shared substrate of `StacksFrontier.RingTheory.Cech.Substrate`: the localization
  `M_{f_{i_0} ⋯ f_{i_{p-1}}}` is `Cech.cechMod f M s`, the localization of `M` at the powers
  of the product `∏ i ∈ s, f i`. The substrate's `Cech.instClosureOfPowers` exhibits it
  simultaneously as the localization at the submonoid generated by the individual `f i`,
  `i ∈ s`, which is what makes the transition maps for `s ⊆ t` available.
* The differential's sign `(-1)^j` for omitting the index `i_j` from a tuple `t` equals
  `(-1)` to the power of the number of elements of `t` strictly below `i_j`; this is the
  position of `i_j` in the sorted tuple `t`.
* `DirectSum.congrLinearEquiv_lof`, `TensorProduct.directSumRight_symm_lof`,
  `LocalizedModule.mkLinearMap_smul_mk_one` and `LocalizedModule.tensorEquiv` are generic
  lemmas about direct sums, tensor products and localized modules of which Mathlib has only
  the `tmul`-level or unbundled counterparts.

## References

* [Stacks Project, Tag 0G6F](https://stacks.math.columbia.edu/tag/0G6F), Section 15.30,
  the extended alternating Čech complex.
* [Stacks Project, Tag 0G6H](https://stacks.math.columbia.edu/tag/0G6H), Lemma 15.30.2,
  whose proof there is omitted.
-/

@[expose] public section

open scoped TensorProduct

/-! ### Complements to Mathlib -/

namespace DirectSum

/-- `DirectSum.congrLinearEquiv` acts on `DirectSum.lof` summandwise. -/
@[simp]
theorem congrLinearEquiv_lof {R : Type*} [Semiring R] {ι : Type*} [DecidableEq ι]
    {N P : ι → Type*} [(i : ι) → AddCommMonoid (N i)] [(i : ι) → Module R (N i)]
    [(i : ι) → AddCommMonoid (P i)] [(i : ι) → Module R (P i)]
    (e : (i : ι) → N i ≃ₗ[R] P i) (i : ι) (x : N i) :
    congrLinearEquiv e (lof R ι N i x) = lof R ι P i (e i x) := by
  simp only [coe_congrLinearEquiv, lmap_lof, LinearEquiv.coe_coe]

end DirectSum

namespace TensorProduct

/-- Pulling a direct-sum summand out of `M ⊗ -`: the inverse of
`TensorProduct.directSumRight` turns the inclusion of the `i`-th summand of
`⨁ i, M ⊗ N i` into `id_M ⊗ (inclusion of the i-th summand of ⨁ i, N i)`. -/
@[simp]
theorem directSumRight_symm_lof {R : Type*} [CommSemiring R] {M : Type*} [AddCommMonoid M]
    [Module R M] {ι : Type*} [DecidableEq ι] {N : ι → Type*} [(i : ι) → AddCommMonoid (N i)]
    [(i : ι) → Module R (N i)] (i : ι) (w : M ⊗[R] N i) :
    (directSumRight R R M N).symm (DirectSum.lof R ι (fun j => M ⊗[R] N j) i w)
      = LinearMap.lTensor M (DirectSum.lof R ι N i) w := by
  induction w using TensorProduct.inductionOn with
  | tmul a b => rw [directSumRight_symm_lof_tmul, LinearMap.lTensor_tmul]
  | add a b ha hb => simp only [map_add, ha, hb]

end TensorProduct

namespace LocalizedModule

/-- Acting by the image of `a : R` on the canonical generator `mk m 1` produces the
generator `mk (a • m) 1`. -/
theorem mkLinearMap_smul_mk_one {R : Type*} [CommSemiring R] {M : Type*} [AddCommMonoid M]
    [Module R M] (S : Submonoid R) (a : R) (m : M) :
    (mkLinearMap S R a) • (mk m 1 : LocalizedModule S M) = mk (a • m) 1 := by
  rw [mkLinearMap_apply, show (mk a (1 : S) : LocalizedModule S R) = Localization.mk a 1 from rfl,
    mk_smul_mk, one_mul]

variable {R : Type*} [CommSemiring R] (M : Type*) [AddCommMonoid M] [Module R M]

/-- The canonical isomorphism `M ⊗_R R_S ≅ M_S` for a single localization,
`m ⊗ (a/s) ↦ (a·m)/s`. This is the standard fact that localization of a module
is computed by base change along `R → R_S`.  See also
`LocalizedModule.equivTensorProduct`, the same fact stated over `R_S` with the
factors in the other order. -/
noncomputable def tensorEquiv (S : Submonoid R) :
    M ⊗[R] LocalizedModule S R ≃ₗ[R] LocalizedModule S M :=
  (TensorProduct.comm R M (LocalizedModule S R)) ≪≫ₗ
    ((isBaseChange S M).equiv).restrictScalars R

/-- The canonical isomorphism on a `tmul`: `m ⊗ x ↦ x • mk m 1`. -/
@[simp]
theorem tensorEquiv_tmul (S : Submonoid R) (m : M) (x : LocalizedModule S R) :
    tensorEquiv M S (m ⊗ₜ[R] x) = x • mk m 1 := by
  unfold tensorEquiv
  simp only [LinearEquiv.trans_apply, TensorProduct.comm_tmul,
    LinearEquiv.restrictScalars_apply, IsBaseChange.equiv_tmul, mkLinearMap_apply]

end LocalizedModule

namespace ExtendedCech

open Cech

variable {R : Type*} [CommRing R] {r : ℕ} (f : Fin r → R)
variable (M : Type*) [AddCommGroup M] [Module R M]

/-! ### The degreewise canonical isomorphism -/

/-- Single-summand naturality of the canonical isomorphism `LocalizedModule.tensorEquiv`
with respect to the transition maps, in the form
`cechι_M ∘ tensorEquiv = tensorEquiv ∘ (id_M ⊗ cechι_R)`, evaluated on a `tmul`. -/
theorem cechι_tensorEquiv_tmul {s t : Finset (Fin r)} (hst : s ⊆ t) (m : M)
    (x : cechMod f R s) :
    cechι f M hst (LocalizedModule.tensorEquiv M (cechSub f s) (m ⊗ₜ[R] x))
      = LocalizedModule.tensorEquiv M (cechSub f t) (m ⊗ₜ[R] cechι f R hst x) := by
  have key : (cechι f M hst).comp
        ((LocalizedModule.tensorEquiv M (cechSub f s)).toLinearMap.comp
          (TensorProduct.mk R M (cechMod f R s) m))
      = (LocalizedModule.tensorEquiv M (cechSub f t)).toLinearMap.comp
        ((TensorProduct.mk R M (cechMod f R t) m).comp (cechι f R hst)) := by
    refine IsLocalizedModule.ext (cechSub f s) (LocalizedModule.mkLinearMap (cechSub f s) R)
      (isUnit_algebraMap f M hst (LocalizedModule.mkLinearMap (cechSub f t) M)) ?_
    refine LinearMap.ext fun a => ?_
    have key₀ : ∀ S : Submonoid R, (LocalizedModule.tensorEquiv M S)
          (m ⊗ₜ[R] (LocalizedModule.mkLinearMap S R) a)
        = LocalizedModule.mkLinearMap S M (a • m) := fun S => by
      rw [LocalizedModule.tensorEquiv_tmul, LocalizedModule.mkLinearMap_smul_mk_one,
        LocalizedModule.mkLinearMap_apply]
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, TensorProduct.mk_apply]
    rw [key₀, cechι_mk, cechι_mk, key₀]
  exact LinearMap.congr_fun key x

/-- The degreewise canonical isomorphism `Čᵖ(M) ≅ M ⊗_R Čᵖ(R)`, obtained from
the per-summand canonical isomorphisms `M ⊗_R R_g ≅ M_g` together with the fact
that tensor product commutes with direct sums. -/
noncomputable def termTensorEquiv (p : ℕ) : cechTerm f M p ≃ₗ[R] M ⊗[R] cechTerm f R p :=
  (DirectSum.congrLinearEquiv
      (fun s : {s : Finset (Fin r) // s.card = p} =>
        (LocalizedModule.tensorEquiv M (cechSub f s.1)).symm)) ≪≫ₗ
    (TensorProduct.directSumRight R R M
      (fun s : {s : Finset (Fin r) // s.card = p} => cechMod f R s.1)).symm

/-- The degreewise isomorphism on a direct-sum generator. -/
@[simp]
theorem termTensorEquiv_lof {p : ℕ} (t : {s : Finset (Fin r) // s.card = p}) (z : cechMod f M t.1) :
    termTensorEquiv f M p (DirectSum.lof R _ (fun u => cechMod f M u.1) t z)
      = LinearMap.lTensor M (DirectSum.lof R _ (fun u => cechMod f R u.1) t)
          ((LocalizedModule.tensorEquiv M (cechSub f t.1)).symm z) := by
  rw [termTensorEquiv, LinearEquiv.trans_apply, DirectSum.congrLinearEquiv_lof]
  exact TensorProduct.directSumRight_symm_lof t _

/-- The degreewise isomorphism on the generator `lof_t (LocalizedModule.tensorEquiv (m ⊗ x))`:
it is `m ⊗ lof_t x`. -/
theorem termTensorEquiv_lof_tmul {p : ℕ} (t : {s : Finset (Fin r) // s.card = p}) (m : M)
    (x : cechMod f R t.1) :
    termTensorEquiv f M p (DirectSum.lof R _ (fun u => cechMod f M u.1) t
        (LocalizedModule.tensorEquiv M (cechSub f t.1) (m ⊗ₜ[R] x)))
      = m ⊗ₜ[R] DirectSum.lof R _ (fun u => cechMod f R u.1) t x := by
  rw [termTensorEquiv_lof, LinearEquiv.symm_apply_apply, LinearMap.lTensor_tmul]

/-! ### Compatibility with the differentials -/

/-- **Stacks Lemma 15.30.2 (Tag 0G6H).** The degreewise canonical isomorphisms
`termTensorEquiv` (induced by `M ⊗_R R_g ≅ M_g`) commute with the Čech
differentials, the differential of `M ⊗_R Č•(R)` being
`id_M ⊗ d_R = LinearMap.lTensor M (Cech.cechD f R p)`.  Together with
`termTensorEquiv` this exhibits the extended alternating Čech complex of `M` as
`M ⊗_R Č•(R)`, an isomorphism of cochain complexes of `R`-modules. -/
@[stacks 0G6H]
theorem termTensorEquiv_comm_d (p : ℕ) :
    (termTensorEquiv f M (p + 1)).toLinearMap.comp (cechD f M p)
      = (LinearMap.lTensor M (cechD f R p)).comp (termTensorEquiv f M p).toLinearMap := by
  refine DirectSum.linearMap_ext R fun s => LinearMap.ext fun y => ?_
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
  obtain ⟨w, rfl⟩ : ∃ w, LocalizedModule.tensorEquiv M (cechSub f s.1) w = y :=
    ⟨(LocalizedModule.tensorEquiv M (cechSub f s.1)).symm y, by simp⟩
  induction w using TensorProduct.inductionOn with
  | add a b ha hb => simp only [map_add]; rw [ha, hb]
  | tmul m x =>
    rw [cechD_lof, map_sum]
    simp only [map_zsmul]
    rw [Finset.sum_congr rfl fun i (_ : i ∈ (s.1ᶜ).attach) => by
      rw [cechι_tensorEquiv_tmul, termTensorEquiv_lof_tmul]]
    rw [termTensorEquiv_lof_tmul, LinearMap.lTensor_tmul, cechD_lof, TensorProduct.tmul_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [TensorProduct.tmul_smul]

end ExtendedCech
