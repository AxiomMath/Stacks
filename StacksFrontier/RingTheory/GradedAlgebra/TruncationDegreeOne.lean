module

public import StacksFrontier.RingTheory.GradedAlgebra.Truncation
public import StacksFrontier.RingTheory.GradedAlgebra.FinitelyGenerated
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesGrading

/-!
# The truncation ring of a graded ring generated in degree one is a Rees algebra

Let `A = ⨁_{d ≥ 0} A_d` be a graded ring and `B = ⨁_{d ≥ 0} A_{≥ d}` its truncation ring. If `A`
is generated over `A_0` by finitely many elements `f_1, …, f_r ∈ A_1`, then
`A_+ = (f_1, …, f_r)` and `(f_1, …, f_r)^m = A_{≥ m}` for all `m ≥ 0`, so that `B` is the Rees
algebra `A[A_+ t]` of the irrelevant ideal, compatibly with the gradings.

## Main definitions

* `Stacks.Truncation.toPolynomial`: the injective ring map `B → A[t]`, `a⁽ᵈ⁾ ↦ a tᵈ`.
* `Stacks.Truncation.reesEquivOfPowEq`: for an ideal `I` with `Iᵐ = A_{≥ m}` for every `m`, the
  ring isomorphism `B ≃ A[I t]`; `reesGradedHomOfPowEq` and `reesGradedHomInvOfPowEq` are it and
  its inverse as homomorphisms of graded rings.
* `Stacks.Truncation.truncationRingEquivReesAlgebra`: **`B ≃ A[A_+ t]`** for `A` generated in
  degree one.

## Main results

* `Stacks.Truncation.span_range_eq_irrelevant`: `(f_1, …, f_r) = A_+`.
* `Stacks.Truncation.span_range_pow_eq_truncationIdeal`: `(f_1, …, f_r)^m = A_{≥ m}`.
* `Stacks.Truncation.truncationRingEquivReesAlgebra_mem_iff`: the isomorphism `B ≃ A[A_+ t]`
  preserves degrees.

## References

* [Stacks Project, Tag 0EKF](https://stacks.math.columbia.edu/tag/0EKF)
-/

@[expose] public noncomputable section

open DirectSum Polynomial

namespace Stacks.Truncation

universe u v

variable {A : Type u} [CommRing A] {σ : Type v} [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-! ### Powers of the irrelevant ideal -/

section Powers

/-- `A_{≥ 1}` is the irrelevant ideal `A_+`. -/
theorem truncationIdeal_one_eq_irrelevant :
    truncationIdeal 𝒜 1 = (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  ext a
  change a ∈ truncation 𝒜 1 ↔ a ∈ HomogeneousIdeal.irrelevant 𝒜
  rw [mem_truncation_iff, HomogeneousIdeal.mem_irrelevant_iff]
  exact ⟨fun h ↦ h 0 Nat.one_pos, fun h k hk ↦ by rwa [Nat.lt_one_iff.mp hk]⟩

variable {𝒜} {r : ℕ} {f : Fin r → A}

/-- **`A_+ = (f_1, …, f_r)`** when `A` is generated over `A_0` by `f_1, …, f_r ∈ A_1`. -/
@[stacks 0EKF "A₊ = (f₁, …, f_r) when A is generated over A₀ by f₁, …, f_r ∈ A₁"]
theorem span_range_eq_irrelevant (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤) :
    Ideal.span (Set.range f) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal :=
  (generates_algebra_iff_generates_irrelevant 𝒜 f (fun _ ↦ 1) (fun _ ↦ Nat.one_pos) hf).mp hgen

/-- The ideal generated by `A_1` is the ideal generated by `f_1, …, f_r`, when these lie in `A_1`
and generate `A` over `A_0`. -/
theorem span_degreeOne_eq_span_range (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤) :
    Ideal.span (𝒜 1 : Set A) = Ideal.span (Set.range f) := by
  refine le_antisymm (Ideal.span_le.2 fun a ha ↦ ?_)
    (Ideal.span_mono (Set.range_subset_iff.2 hf))
  rw [span_range_eq_irrelevant hf hgen]
  exact mem_irrelevant_of_mem_of_pos 𝒜 ha Nat.one_pos

/-- For `A` generated over `A_0` by `f_1, …, f_r ∈ A_1`, every element of `A_{d+1}` lies in
`A_1 · A_d`. -/
theorem mem_span_degreeOne_mul_of_adjoin_eq_top (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤) (d : ℕ) (a : A) (ha : a ∈ 𝒜 (d + 1)) :
    a ∈ Ideal.span (𝒜 1 : Set A) * Ideal.span (𝒜 d : Set A) := by
  have hirr : a ∈ Ideal.span (Set.range f) := by
    rw [span_range_eq_irrelevant hf hgen]
    exact mem_irrelevant_of_mem_of_pos 𝒜 ha (Nat.succ_pos d)
  obtain ⟨n, c, g, hsum⟩ := Submodule.mem_span_set'.mp hirr
  rw [← proj_eq_self_of_mem 𝒜 ha, ← hsum, map_sum]
  refine Ideal.sum_mem _ fun k _ ↦ ?_
  obtain ⟨i, hi⟩ := (g k).property
  rw [smul_eq_mul, ← hi, proj_mul_eq 𝒜 _ _ 1 (d + 1) (hf i) (by omega), Nat.add_sub_cancel]
  have h := Ideal.mul_mem_mul (Ideal.subset_span (hf i))
    (Ideal.subset_span (proj_mem 𝒜 (c k) d) : _ ∈ Ideal.span (𝒜 d : Set A))
  rwa [mul_comm (f i)] at h

/-- **`(f_1, …, f_r)^m = A_{≥ m}` for all `m ≥ 0`**, when `A` is generated over `A_0` by
`f_1, …, f_r ∈ A_1`. -/
@[stacks 0EKF "(f₁, …, f_r)^m = A_{≥ m} for all m ≥ 0 when A is generated over A₀ by \
f₁, …, f_r ∈ A₁"]
theorem span_range_pow_eq_truncationIdeal (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤) (m : ℕ) :
    Ideal.span (Set.range f) ^ m = truncationIdeal 𝒜 m := by
  rw [← span_degreeOne_eq_span_range hf hgen]
  exact span_degreeOne_pow_eq_truncationIdeal 𝒜
    (mem_span_degreeOne_mul_of_adjoin_eq_top hf hgen) m

/-- `(A_+)^m = A_{≥ m}` for all `m ≥ 0`, when `A` is generated over `A_0` by
`f_1, …, f_r ∈ A_1`. -/
theorem irrelevant_pow_eq_truncationIdeal (hf : ∀ i, f i ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤) (m : ℕ) :
    (HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ m = truncationIdeal 𝒜 m := by
  rw [← span_range_eq_irrelevant hf hgen, span_range_pow_eq_truncationIdeal hf hgen]

end Powers

/-! ### The truncation ring inside the polynomial ring -/

section Polynomial

/-- The `d`-th summand `A_{≥ d}` of the truncation ring, sent to the monomials of degree `d` of
`A[t]`. -/
def toPolynomialComponent (d : ℕ) : truncation 𝒜 d →+ A[X] :=
  (monomial d).toAddMonoidHom.comp (truncation 𝒜 d).subtype

/-- The ring map `B = ⨁_{d ≥ 0} A_{≥ d} → A[t]`, `a⁽ᵈ⁾ ↦ a tᵈ`. -/
def toPolynomial : TruncationRing 𝒜 →+* A[X] :=
  DirectSum.toSemiring (toPolynomialComponent 𝒜)
    (by
      change monomial 0 (1 : A) = 1
      rw [monomial_zero_one])
    (fun {d e} a b ↦ by
      change monomial (d + e) ((a : A) * b) = monomial d (a : A) * monomial e (b : A)
      rw [monomial_mul_monomial])

/-- `toPolynomial` sends `a⁽ᵈ⁾` to `a tᵈ`. -/
theorem toPolynomial_of (d : ℕ) (a : truncation 𝒜 d) :
    toPolynomial 𝒜 (DirectSum.of _ d a) = monomial d (a : A) :=
  DirectSum.toSemiring_of _ _ _ _ _

/-- The `i`-th coefficient of `toPolynomial x` is the degree-`i` component of `x`. -/
theorem coeff_toPolynomial (x : TruncationRing 𝒜) (i : ℕ) :
    (toPolynomial 𝒜 x).coeff i = (x i : A) := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | of d a =>
    rw [toPolynomial_of, coeff_monomial]
    obtain rfl | h := eq_or_ne d i
    · simp
    · rw [ite_eq_right h, DirectSum.of_eq_of_ne _ _ _ (Ne.symm h)]
      simp
  | add x y hx hy => simp [hx, hy]

/-- `toPolynomial` is injective. -/
theorem toPolynomial_injective : Function.Injective (toPolynomial 𝒜) := fun x y hxy ↦
  DFinsupp.ext fun i ↦ Subtype.ext <| by
    simpa only [coeff_toPolynomial] using congrArg (Polynomial.coeff · i) hxy

end Polynomial

/-! ### The truncation ring as a Rees algebra -/

section Rees

variable {𝒜} {I : Ideal A} (hI : ∀ m, I ^ m = truncationIdeal 𝒜 m)
include hI

/-- `toPolynomial` takes values in the Rees algebra of an ideal whose powers are the
truncations. -/
theorem toPolynomial_mem_reesAlgebra (x : TruncationRing 𝒜) :
    toPolynomial 𝒜 x ∈ reesAlgebra I := by
  rw [mem_reesAlgebra_iff]
  intro i
  rw [coeff_toPolynomial, hI]
  exact (x i).2

/-- **The truncation ring is a Rees algebra**: if `Iᵐ = A_{≥ m}` for all `m ≥ 0`, then
`a⁽ᵈ⁾ ↦ a tᵈ` is a ring isomorphism `⨁_{d ≥ 0} A_{≥ d} ≃ A[I t]`. -/
def reesEquivOfPowEq : TruncationRing 𝒜 ≃+* reesAlgebra I :=
  RingEquiv.ofBijective
    ((toPolynomial 𝒜).codRestrict (reesAlgebra I).toSubring (toPolynomial_mem_reesAlgebra hI))
    ⟨fun x y hxy ↦ toPolynomial_injective 𝒜 (congrArg Subtype.val hxy), by
      classical
      rintro ⟨p, hp⟩
      rw [mem_reesAlgebra_iff] at hp
      refine ⟨∑ i ∈ p.support, DirectSum.of _ i
        ⟨p.coeff i, (show p.coeff i ∈ truncationIdeal 𝒜 i from hI i ▸ hp i)⟩, ?_⟩
      refine Subtype.ext ?_
      change toPolynomial 𝒜 _ = p
      rw [map_sum]
      simp only [toPolynomial_of]
      exact (as_sum_support p).symm⟩

/-- The underlying polynomial of `reesEquivOfPowEq hI x` is `toPolynomial x`. -/
theorem coe_reesEquivOfPowEq (x : TruncationRing 𝒜) :
    (reesEquivOfPowEq hI x : A[X]) = toPolynomial 𝒜 x :=
  rfl

/-- `reesEquivOfPowEq` sends `a⁽ᵈ⁾` to `a tᵈ`. -/
theorem coe_reesEquivOfPowEq_of (d : ℕ) (a : truncation 𝒜 d) :
    (reesEquivOfPowEq hI (DirectSum.of _ d a) : A[X]) = monomial d (a : A) :=
  toPolynomial_of 𝒜 d a

/-- `reesEquivOfPowEq` preserves degrees. -/
theorem reesEquivOfPowEq_mem {d : ℕ} {x : TruncationRing 𝒜} (hx : x ∈ grading 𝒜 d) :
    reesEquivOfPowEq hI x ∈ Stacks.Blowup.reesGrading I d := by
  obtain ⟨a, rfl⟩ := hx
  intro i hi
  rw [coe_reesEquivOfPowEq_of, coeff_monomial, ite_eq_right (Ne.symm hi)]

/-- The inverse of `reesEquivOfPowEq` preserves degrees. -/
theorem reesEquivOfPowEq_symm_mem {d : ℕ} {p : reesAlgebra I}
    (hp : p ∈ Stacks.Blowup.reesGrading I d) :
    (reesEquivOfPowEq hI).symm p ∈ grading 𝒜 d := by
  refine ⟨⟨(p : A[X]).coeff d,
    (show (p : A[X]).coeff d ∈ truncationIdeal 𝒜 d from hI d ▸ (mem_reesAlgebra_iff _ _).mp p.2 d)⟩,
    ?_⟩
  rw [RingEquiv.eq_symm_apply]
  refine Subtype.ext ?_
  rw [coe_reesEquivOfPowEq_of]
  exact (Stacks.Blowup.coe_eq_monomial I hp).symm

/-- `reesEquivOfPowEq` preserves and reflects degrees. -/
theorem reesEquivOfPowEq_mem_iff {d : ℕ} {x : TruncationRing 𝒜} :
    reesEquivOfPowEq hI x ∈ Stacks.Blowup.reesGrading I d ↔ x ∈ grading 𝒜 d :=
  ⟨fun h ↦ (reesEquivOfPowEq hI).symm_apply_apply x ▸ reesEquivOfPowEq_symm_mem hI h,
    reesEquivOfPowEq_mem hI⟩

/-- `reesEquivOfPowEq`, as a homomorphism of graded rings. -/
def reesGradedHomOfPowEq : grading 𝒜 →+*ᵍ Stacks.Blowup.reesGrading I where
  toRingHom := (reesEquivOfPowEq hI).toRingHom
  map_mem hx := reesEquivOfPowEq_mem hI hx

/-- The inverse of `reesEquivOfPowEq`, as a homomorphism of graded rings. -/
def reesGradedHomInvOfPowEq : Stacks.Blowup.reesGrading I →+*ᵍ grading 𝒜 where
  toRingHom := (reesEquivOfPowEq hI).symm.toRingHom
  map_mem hp := reesEquivOfPowEq_symm_mem hI hp

/-- `reesGradedHomOfPowEq` is `reesEquivOfPowEq`. -/
@[simp]
theorem reesGradedHomOfPowEq_apply (x : TruncationRing 𝒜) :
    reesGradedHomOfPowEq hI x = reesEquivOfPowEq hI x :=
  rfl

/-- `reesGradedHomInvOfPowEq` is the inverse of `reesEquivOfPowEq`. -/
@[simp]
theorem reesGradedHomInvOfPowEq_apply (p : reesAlgebra I) :
    reesGradedHomInvOfPowEq hI p = (reesEquivOfPowEq hI).symm p :=
  rfl

end Rees

/-! ### Generation in degree one -/

section DegreeOne

variable {𝒜} {r : ℕ} {f : Fin r → A} (hf : ∀ i, f i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range f) = ⊤)

/-- **`B` is the Rees algebra of `A_+`**: when `A` is generated over `A_0` by
`f_1, …, f_r ∈ A_1`, the map `a⁽ᵈ⁾ ↦ a tᵈ` is a ring isomorphism
`B = ⨁_{d ≥ 0} A_{≥ d} ≃ A[A_+ t]`. It preserves degrees by
`Stacks.Truncation.truncationRingEquivReesAlgebra_mem_iff`. -/
@[stacks 0EKF "B = ⨁_{d ≥ 0} A_{≥ d} is the Rees algebra of A₊ = (f₁, …, f_r) when A is \
generated over A₀ by f₁, …, f_r ∈ A₁"]
def truncationRingEquivReesAlgebra :
    TruncationRing 𝒜 ≃+* reesAlgebra (HomogeneousIdeal.irrelevant 𝒜).toIdeal :=
  reesEquivOfPowEq (irrelevant_pow_eq_truncationIdeal hf hgen)

/-- `truncationRingEquivReesAlgebra` sends `a⁽ᵈ⁾` to `a tᵈ`. -/
theorem coe_truncationRingEquivReesAlgebra_of (d : ℕ) (a : truncation 𝒜 d) :
    (truncationRingEquivReesAlgebra hf hgen (DirectSum.of _ d a) : A[X]) = monomial d (a : A) :=
  coe_reesEquivOfPowEq_of _ d a

/-- **The isomorphism `B ≃ A[A_+ t]` is graded**: it carries `B_d` onto the degree-`d` part of
the Rees algebra. -/
@[stacks 0EKF "the isomorphism of B with the Rees algebra of A₊ respects the gradings"]
theorem truncationRingEquivReesAlgebra_mem_iff {d : ℕ} {x : TruncationRing 𝒜} :
    truncationRingEquivReesAlgebra hf hgen x ∈
        Stacks.Blowup.reesGrading (HomogeneousIdeal.irrelevant 𝒜).toIdeal d ↔
      x ∈ grading 𝒜 d :=
  reesEquivOfPowEq_mem_iff _

end DegreeOne

end Stacks.Truncation

end
