module

public import StacksFrontier.RingTheory.GradedAlgebra.Proj.LaurentAway
public import StacksFrontier.RingTheory.Ideal.AssociatedPrime.LaurentBaseChange

/-!
# Associated primes along the degree-zero chart of a localization at a degree-one element

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring, let `f ∈ 𝒜 1`, and write `A₍f₎ = Away 𝒜 f` for the
degree-zero part of `A[1/f]`. The identification `laurentAwayEquiv` makes `A[1/f]` the
Laurent extension `A₍f₎[f, f⁻¹]` of `A₍f₎`, and `basisZpow` exhibits the integer powers of `f` as
a basis. This file transports the Laurent description of associated primes across that
identification:

`Ass_{A[1/f]}(A[1/f] ⊗_{A₍f₎} M) = { 𝔭·A[1/f] : 𝔭 ∈ Ass_{A₍f₎}(M) }`,

the inclusion `⊇` for every `A₍f₎`-module `M` and the equality when `A₍f₎` is Noetherian. So an
associated prime upstairs is generated by its contraction to the chart ring, and the contraction
is an associated prime there.

## Main results

* `Stacks.GradedLaurentAssociatedPrimes.flat_of_mem_degree_one`: `A[1/f]` is flat over its
  degree-zero part.
* `Stacks.GradedLaurentAssociatedPrimes.isPrime_map_algebraMap_localizationAway`: a prime of the
  degree-zero part stays prime in `A[1/f]`.
* `Stacks.GradedLaurentAssociatedPrimes.comap_map_algebraMap_localizationAway`: and contracts back
  to itself.
* `Stacks.GradedLaurentAssociatedPrimes.associatedPrimes_localizationAway_tensor_eq_image`: the
  description of the associated primes displayed above.
* `Stacks.GradedLaurentAssociatedPrimes.mem_associatedPrimes_localizationAway_iff`: its membership
  form.

## Implementation notes

Nothing here is a second proof of anything in
`StacksFrontier.RingTheory.Ideal.AssociatedPrime.LaurentBaseChange`: the general statement there is
already stated for an arbitrary flat extension in which primes stay prime, so only those two
inputs are transported, and only the second needs the identification. Primality is carried across
`laurentAwayEquiv` by `Ideal.map_isPrime_of_surjective` and contraction by
`Ideal.comap_map_of_bijective`, both of which are about the underlying ring homomorphism, so the
transport never touches a module.

The degree-one hypothesis is the one `laurentAwayEquiv` carries and is genuinely needed there
rather than an artefact: for `𝒜` the grading of `k[x, y]` with `deg x = 2` and `deg y = 1`, the
powers of `f = x` span only the even-degree part of `A[1/x]`, so `A[1/x]` is not the Laurent
extension of its degree-zero part. That counterexample is recorded with `laurentAwayEquiv` itself.

Noetherianness of the chart ring `A₍f₎` is taken as an instance binder rather than derived from
`[IsNoetherianRing A]`, so that these statements become unconditional in `A` the moment a
`IsNoetherianRing (Away 𝒜 f)` instance lands, with no edit here.

These declarations are in a namespace of their own rather than in `Stacks.GradedLaurent`, where
`LaurentAway` and its height companion live, because a duplicate fully-qualified name is a hard
import error under the module system and that namespace is being extended concurrently.

## References

* [Stacks Project, Tag 0312](https://stacks.math.columbia.edu/tag/0312)
* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
-/

@[expose] public section

namespace Stacks.GradedLaurentAssociatedPrimes

open HomogeneousLocalization Stacks.GradedLaurent Stacks.LaurentAssociatedPrimes TensorProduct

universe u v

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : A}

/-- For `f` homogeneous of degree one, `A[1/f]` is flat over its degree-zero part, being free on
the integer powers of `f`. -/
theorem flat_of_mem_degree_one (hf : f ∈ 𝒜 1) :
    Module.Flat (Away 𝒜 f) (Localization.Away f) :=
  have := free_of_mem_degree_one 𝒜 hf
  Module.Flat.of_free

/-- The structure map of the degree-zero part into `A[1/f]` is the value of a fraction. -/
theorem algebraMap_away_eq_val (a : Away 𝒜 f) :
    algebraMap (Away 𝒜 f) (Localization.Away f) a = a.val := by
  rw [Algebra.algebraMap_eq_smul_one, smul_eq_val_mul, mul_one]

/-- The Laurent identification is a map of algebras over the degree-zero part. Stated as a `have`
inside the proofs below would duplicate a declaration of the same shape being added concurrently
to `Stacks.GradedLaurent`; it is kept private here. -/
private theorem equiv_comp_algebraMap (hf : f ∈ 𝒜 1) :
    ((laurentAwayEquiv 𝒜 hf : LaurentPolynomial (Away 𝒜 f) ≃+* Localization.Away f) :
          LaurentPolynomial (Away 𝒜 f) →+* Localization.Away f).comp
        (algebraMap (Away 𝒜 f) (LaurentPolynomial (Away 𝒜 f)))
      = algebraMap (Away 𝒜 f) (Localization.Away f) := by
  ext a
  change laurentAwayEquiv 𝒜 hf (LaurentPolynomial.C a) = _
  rw [laurentAwayEquiv_C, algebraMap_away_eq_val]

/-- The extension of an ideal of the degree-zero part to `A[1/f]`, read through the Laurent
identification. -/
private theorem map_algebraMap_eq_map_equiv (hf : f ∈ 𝒜 1) (p : Ideal (Away 𝒜 f)) :
    p.map (algebraMap (Away 𝒜 f) (Localization.Away f))
      = Ideal.map ((laurentAwayEquiv 𝒜 hf :
            LaurentPolynomial (Away 𝒜 f) ≃+* Localization.Away f) :
            LaurentPolynomial (Away 𝒜 f) →+* Localization.Away f)
          (p.map (algebraMap (Away 𝒜 f) (LaurentPolynomial (Away 𝒜 f)))) := by
  rw [Ideal.map_map, equiv_comp_algebraMap 𝒜 hf]

/-- **A prime of the degree-zero part stays prime in `A[1/f]`**, for `f` homogeneous of degree
one. -/
theorem isPrime_map_algebraMap_localizationAway (hf : f ∈ 𝒜 1) (p : Ideal (Away 𝒜 f))
    [hp : p.IsPrime] :
    (p.map (algebraMap (Away 𝒜 f) (Localization.Away f))).IsPrime := by
  have hL := isPrime_map_algebraMap_laurentPolynomial (A := Away 𝒜 f) p
  rw [map_algebraMap_eq_map_equiv 𝒜 hf p]
  exact Ideal.map_isPrime_of_equiv (laurentAwayEquiv 𝒜 hf)

/-- **Contracting the extension of a prime back to the degree-zero part recovers the prime.** -/
theorem comap_map_algebraMap_localizationAway (hf : f ∈ 𝒜 1) (p : Ideal (Away 𝒜 f))
    [hp : p.IsPrime] :
    (p.map (algebraMap (Away 𝒜 f) (Localization.Away f))).comap
      (algebraMap (Away 𝒜 f) (Localization.Away f)) = p := by
  rw [map_algebraMap_eq_map_equiv 𝒜 hf p, ← equiv_comp_algebraMap 𝒜 hf, ← Ideal.comap_comap,
    Ideal.comap_map_of_bijective
      ((laurentAwayEquiv 𝒜 hf : LaurentPolynomial (Away 𝒜 f) ≃+* Localization.Away f) :
        LaurentPolynomial (Away 𝒜 f) →+* Localization.Away f)
      (laurentAwayEquiv 𝒜 hf).bijective,
    comap_map_algebraMap_laurentPolynomial (A := Away 𝒜 f) p]

/-- For `f` homogeneous of degree one and a Noetherian degree-zero part, `A[1/f]` is Noetherian. -/
theorem isNoetherianRing_localizationAway_of_mem_degree_one (hf : f ∈ 𝒜 1)
    [IsNoetherianRing (Away 𝒜 f)] : IsNoetherianRing (Localization.Away f) :=
  have := isNoetherianRing_laurentPolynomial (A := Away 𝒜 f)
  isNoetherianRing_of_ringEquiv _ (laurentAwayEquiv 𝒜 hf)

variable (M : Type*) [AddCommGroup M] [Module (Away 𝒜 f) M]

/-- **The extension of an associated prime of `M` is an associated prime of
`A[1/f] ⊗_{A₍f₎} M`**, for every module `M` over the degree-zero part and with no Noetherian
hypothesis. `Ass` is the annihilator spelling of Stacks Tag 00LA. -/
theorem image_assStacks_subset_assStacks_tensor_localizationAway (hf : f ∈ 𝒜 1) :
    (fun p : Ideal (Away 𝒜 f) => p.map (algebraMap (Away 𝒜 f) (Localization.Away f))) ''
        {p : Ideal (Away 𝒜 f) | p.IsPrime ∧ ∃ m : M, (⊥ : Submodule (Away 𝒜 f) M).colon {m} = p}
      ⊆ {q : Ideal (Localization.Away f) | q.IsPrime ∧
          ∃ w : Localization.Away f ⊗[Away 𝒜 f] M,
            (⊥ : Submodule (Localization.Away f)
              (Localization.Away f ⊗[Away 𝒜 f] M)).colon {w} = q} :=
  have := flat_of_mem_degree_one 𝒜 hf
  image_assStacks_subset_assStacks_tensor
    (fun p hp => isPrime_map_algebraMap_localizationAway 𝒜 hf p (hp := hp)) M

/-- **The associated primes of `A[1/f] ⊗_{A₍f₎} M` are exactly the extensions of the associated
primes of `M`**, for `f` homogeneous of degree one and the degree-zero chart ring Noetherian. -/
theorem associatedPrimes_localizationAway_tensor_eq_image (hf : f ∈ 𝒜 1)
    [IsNoetherianRing (Away 𝒜 f)] :
    associatedPrimes (Localization.Away f) (Localization.Away f ⊗[Away 𝒜 f] M)
      = (fun p : Ideal (Away 𝒜 f) =>
          p.map (algebraMap (Away 𝒜 f) (Localization.Away f))) ''
            associatedPrimes (Away 𝒜 f) M :=
  have := flat_of_mem_degree_one 𝒜 hf
  have := isNoetherianRing_localizationAway_of_mem_degree_one 𝒜 hf
  associatedPrimes_tensor_eq_image
    (fun p hp => isPrime_map_algebraMap_localizationAway 𝒜 hf p (hp := hp)) M

/-- **The membership form.** A prime of `A[1/f]` is associated to `A[1/f] ⊗_{A₍f₎} M` exactly when
it is generated by its contraction to the degree-zero chart ring and that contraction is an
associated prime of `M` there. This is the shape in which an associated prime is moved between a
graded ring and a standard chart of its `Proj`. -/
theorem mem_associatedPrimes_localizationAway_iff (hf : f ∈ 𝒜 1)
    [IsNoetherianRing (Away 𝒜 f)] {q : Ideal (Localization.Away f)} :
    q ∈ associatedPrimes (Localization.Away f) (Localization.Away f ⊗[Away 𝒜 f] M)
      ↔ q.comap (algebraMap (Away 𝒜 f) (Localization.Away f))
            ∈ associatedPrimes (Away 𝒜 f) M
        ∧ q = (q.comap (algebraMap (Away 𝒜 f) (Localization.Away f))).map
            (algebraMap (Away 𝒜 f) (Localization.Away f)) := by
  rw [associatedPrimes_localizationAway_tensor_eq_image 𝒜 M hf]
  refine ⟨?_, fun ⟨h1, h2⟩ => ⟨_, h1, h2.symm⟩⟩
  rintro ⟨p, hp, rfl⟩
  have : p.IsPrime := hp.1
  rw [comap_map_algebraMap_localizationAway 𝒜 hf p]
  exact ⟨hp, rfl⟩

end Stacks.GradedLaurentAssociatedPrimes

end
