/-!
# Homogeneous primes of a graded ring

Stacks 00JT — the ideal generated by the homogeneous elements of a prime `𝔭` of a graded ring
is again prime — is Mathlib's `Ideal.IsPrime.homogeneousCore`, that ideal being
`Ideal.homogeneousCore`.

Stacks 00JU remains here: any minimal prime over a homogeneous ideal (in particular any
minimal prime of the ring) is homogeneous.
-/

@[expose] public section

-- The former @[stacks 00JT] theorem is the Mathlib theorem.
add_to_stacks 00JT Ideal.IsPrime.homogeneousCore
add_to_ega "II 8.3.7" "graded prime q exists" Ideal.IsPrime.homogeneousCore
add_to_stacks 00JT "the homogeneous ideal generated by the homogeneous elements of `𝔭`"
  Ideal.homogeneousCore


variable {ι σ A : Type*}
variable [CommRing A]
variable [AddCommMonoid ι] [LinearOrder ι] [IsOrderedCancelAddMonoid ι]
variable [SetLike σ A] [AddSubmonoidClass σ A] (𝒜 : ι → σ) [GradedRing 𝒜]

/-- Part (2): Given a homogeneous ideal `I`, any minimal prime over `I` is
homogeneous. -/
@[stacks 00JU "part (2)"]
theorem Ideal.IsHomogeneous.isHomogeneous_of_mem_minimalPrimes
    {I p : Ideal A} (hI : I.IsHomogeneous 𝒜) (hp : p ∈ I.minimalPrimes) :
    p.IsHomogeneous 𝒜 := by
  obtain ⟨⟨hp_prime, hIp⟩, hp_min⟩ := hp
  have hle := Ideal.toIdeal_homogeneousCore_le 𝒜 p
  have hI_le : I ≤ (p.homogeneousCore 𝒜).toIdeal :=
    hI.toIdeal_homogeneousCore_eq_self ▸ Ideal.homogeneousCore_mono 𝒜 hIp
  rw [le_antisymm (hp_min ⟨hp_prime.homogeneousCore, hI_le⟩ hle) hle]
  exact (p.homogeneousCore 𝒜).isHomogeneous

/-- Part (1): Any minimal prime of a graded ring is a homogeneous ideal. This
is the special case of part (2) where `I = ⊥`. -/
@[stacks 00JU "part (1)"]
theorem GradedRing.isHomogeneous_of_mem_minimalPrimes
    {p : Ideal A} (hp : p ∈ minimalPrimes A) :
    p.IsHomogeneous 𝒜 :=
  Ideal.IsHomogeneous.isHomogeneous_of_mem_minimalPrimes 𝒜
    (Ideal.IsHomogeneous.bot 𝒜) hp

