module

public import Mathlib.Algebra.Module.LocalizedModule.Submodule
public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.RingTheory.Ideal.AssociatedPrime.Localization
public import StacksFrontier.RingTheory.GradedAlgebra.Proj.ChartHeight
public import StacksFrontier.RingTheory.GradedAlgebra.Proj.LaurentAwayAssociatedPrimes

/-!
# Associated primes of a homogeneous ideal, read on a standard chart of `Proj`

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring, let `f ∈ 𝒜 1`, and write `A₍f₎ = Away 𝒜 f` for the
degree-zero part of `A[1/f]`. For a homogeneous ideal `I ⊆ A` and a prime `p` associated to `I`
with `f ∉ p`, this file shows that the prime of the chart ring `A₍f₎` corresponding to `p` is
associated to the ideal of `A₍f₎` corresponding to `I`:

`p ∈ Ass_A(I)` and `f ∉ p` imply `(p · A[1/f]) ∩ A₍f₎ ∈ Ass_{A₍f₎}((I · A[1/f]) ∩ A₍f₎)`.

Together with `Stacks.GradedLaurent.height_eq_height_under_away_of_isNoetherianRing`, which says
the two primes have the same height, this transfers a height question about an associated prime of
a homogeneous ideal to the same question on an affine chart of `Proj 𝒜`.

The route is two localizations of different kinds, in this order.

* `A → A[1/f]` is an ordinary localization, so associated primes move along it by Tag 0310. What
  is needed here is the *ideal* form of that statement, where Mathlib's is stated for a module and
  a localized module; `mem_associatedPrimes_quotient_iff` is the bridge between
  `Submodule.associatedPrimes I` and `associatedPrimes A (A ⧸ I)`, and
  `Submodule.toLocalizedQuotient'` supplies the `IsLocalizedModule` instance for the quotient.
* `A₍f₎ → A[1/f]` is **not** a localization — it is the Laurent extension `A₍f₎[f, f⁻¹]` — so
  Tag 0310 says nothing about it, and
  `Stacks.GradedLaurentAssociatedPrimes.mem_associatedPrimes_localizationAway_iff` is used
  instead. That statement is about `A[1/f] ⊗_{A₍f₎} M`, so the quotient `A[1/f] ⧸ I · A[1/f]` is
  presented as such a tensor product by `Ideal.quotMapEquivTensorQuot`; the hypothesis it needs,
  that `I · A[1/f]` is generated by its degree-zero part, is exactly where homogeneity of `I`
  enters and is `Stacks.GradedLaurent.map_eq_map_under_of_isHomogeneous`.

## Main results

* `Stacks.GradedChartAssociatedPrimes.mem_associatedPrimes_quotient_iff`: a prime is associated to
  the module `A ⧸ I` exactly when it is associated to the ideal `I`.
* `Stacks.GradedChartAssociatedPrimes.map_mem_associatedPrimes_map_of_disjoint`: associated primes
  of an ideal extend to associated primes of its extension along a localization that avoids them.
* `Stacks.GradedChartAssociatedPrimes.under_mem_associatedPrimes_under_of_mem`: **the chart
  statement** displayed above.

## Implementation notes

The prime and the ideal of the chart ring are both written out as
`(· .map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)` rather than through named
constructions, following `ChartHeight.lean`, so that no new name is coined for objects the `Proj`
chart maps already describe and so that the statement composes with that file's height identity
without a bridge.

`Submodule.associatedPrimes I` for `I : Ideal A` is the annihilator-radical spelling applied to
`I` viewed as a submodule of `A`, whereas `associatedPrimes A (A ⧸ I)` is Mathlib's module
spelling. They agree, but not definitionally: the colon of `⊥` at `Ideal.Quotient.mk I x` has to
be identified with the colon of `I` at `x`, which is `colon_bot_quotientMk`. Both of Mathlib's
inputs used below are stated in the module spelling, so the bridge is crossed once at each end.

The degree-one hypothesis `f ∈ 𝒜 1` is inherited from
`mem_associatedPrimes_localizationAway_iff` and from `map_eq_map_under_of_isHomogeneous`, and is
genuinely needed by both; see `LaurentAway.lean` for the counterexample at degree two.

## References

* [Stacks Project, Tag 0310](https://stacks.math.columbia.edu/tag/0310)
* [Stacks Project, Tag 0312](https://stacks.math.columbia.edu/tag/0312)
* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
-/

@[expose] public section

namespace Stacks.GradedChartAssociatedPrimes

open HomogeneousLocalization Stacks.GradedLaurent Stacks.GradedLaurentAssociatedPrimes
open scoped TensorProduct

universe u v

/-! ### The associated primes of an ideal and of its quotient module -/

section Bridge

variable {A : Type*} [CommRing A] (I : Ideal A)

/-- Acting by `r` on the class of `x` in `A ⧸ I` gives zero exactly when `r * x ∈ I`. -/
theorem smul_quotientMk_eq_zero_iff (x r : A) :
    r • (Ideal.Quotient.mk I) x = (0 : A ⧸ I) ↔ r * x ∈ I := by
  rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
    Ideal.Quotient.eq_zero_iff_mem]

/-- The colon ideal of `⊥` in `A ⧸ I` at the class of `x` is the colon ideal of `I` at `x`. -/
theorem colon_bot_quotientMk (x : A) :
    (⊥ : Submodule A (A ⧸ I)).colon {Ideal.Quotient.mk I x} = Submodule.colon I {x} := by
  ext r
  rw [Submodule.mem_colon_singleton, Submodule.mem_colon_singleton, Submodule.mem_bot,
    smul_quotientMk_eq_zero_iff I x r, smul_eq_mul]

/-- **A prime is associated to the module `A ⧸ I` exactly when it is associated to the ideal
`I`.** The two spellings of an associated prime of an ideal — Mathlib's module one and the
submodule one — agree.

Both inputs of this file's chart statement are phrased in the module spelling and the statement
itself in the submodule spelling, so this is crossed at each end. -/
theorem mem_associatedPrimes_quotient_iff (p : Ideal A) :
    p ∈ associatedPrimes A (A ⧸ I) ↔ p ∈ Submodule.associatedPrimes I := by
  refine ⟨fun ⟨hp, x, hx⟩ => ?_, fun ⟨hp, x, hx⟩ => ⟨hp, Ideal.Quotient.mk I x, ?_⟩⟩
  · obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨hp, y, by rw [hx, colon_bot_quotientMk]⟩
  · rw [hx, colon_bot_quotientMk]

end Bridge

/-! ### Associated primes along a ring isomorphism -/

section RingEquiv

variable {A : Type*} {B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B)

/-- Membership in the transport of an ideal along a ring isomorphism.

Mathlib's `Ideal.symm_apply_mem_of_equiv_iff` says this, but with the isomorphism itself as the
map rather than its underlying ring homomorphism, so it does not rewrite a goal phrased with
`Ideal.map (e : A →+* B)` — which is the phrasing the geometric consumer produces. -/
theorem mem_map_ringEquiv_iff (J : Ideal A) (y : B) :
    y ∈ J.map (e : A →+* B) ↔ e.symm y ∈ J := by
  refine ⟨fun hy => ?_, fun hy => ?_⟩
  · have hle : J.map (e : A →+* B) ≤ J.comap (e.symm : B →+* A) :=
      Ideal.map_le_iff_le_comap.mpr fun x hx => by simpa using hx
    exact Ideal.mem_comap.mp (hle hy)
  · simpa using Ideal.mem_map_of_mem (e : A →+* B) hy

/-- The two spellings of the transport of an ideal along a ring isomorphism — along the
isomorphism itself and along its underlying ring homomorphism — agree.

They are definitionally equal, but `rw` does not cross between them: `Ideal.map` takes the map as
a bundled-hom-class argument, and the class differs. `RingEquiv.height_map` is stated in the first
spelling and the geometric consumers produce the second. -/
theorem map_coe_ringEquiv (J : Ideal A) : J.map (e : A →+* B) = J.map e := rfl

/-- The colon ideal of a transported ideal at a transported element is the transported colon
ideal. -/
theorem colon_map_ringEquiv (J : Ideal A) (x : A) :
    Submodule.colon (J.map (e : A →+* B)) {e x} = (Submodule.colon J {x}).map (e : A →+* B) := by
  ext r
  simp only [Submodule.mem_colon_singleton, smul_eq_mul, mem_map_ringEquiv_iff, map_mul,
    RingEquiv.symm_apply_apply]

/-- The kernel of a ring isomorphism is contained in every ideal. -/
theorem ker_ringEquiv_le (J : Ideal A) : RingHom.ker (e : A →+* B) ≤ J := by
  intro y hy
  rw [RingHom.mem_ker] at hy
  have hy0 : y = 0 := e.injective (by simpa using hy)
  exact hy0 ▸ Submodule.zero_mem _

/-- The radical of a transported ideal is the transported radical. -/
theorem radical_map_ringEquiv (J : Ideal A) :
    (J.map (e : A →+* B)).radical = J.radical.map (e : A →+* B) :=
  (Ideal.map_radical_of_surjective e.surjective (ker_ringEquiv_le e J)).symm

/-- **Associated primes are carried along a ring isomorphism.** If `q` is associated to the ideal
`J` of `A` and `e : A ≃+* B`, then `q · B` is associated to `J · B`.

This is what moves the chart statement from the degree-zero ring `A₍f₎` to the ring of sections
`Γ(Proj 𝒜, D₊(f))`, which Mathlib's `Proj.basicOpenIsoAway` identifies with it. -/
theorem map_mem_associatedPrimes_map_of_ringEquiv {J q : Ideal A}
    (h : q ∈ Submodule.associatedPrimes J) :
    q.map (e : A →+* B) ∈ Submodule.associatedPrimes (J.map (e : A →+* B)) := by
  obtain ⟨hq, x, hx⟩ := h
  refine ⟨Ideal.map_isPrime_of_surjective e.surjective (ker_ringEquiv_le e q), e x, ?_⟩
  rw [colon_map_ringEquiv, hx]
  exact (radical_map_ringEquiv e _).symm

end RingEquiv

/-! ### Associated primes extend along a localization avoiding them -/

/-- **An associated prime of an ideal extends to an associated prime of the extended ideal**,
along a localization at a submonoid disjoint from the prime.

This is the ideal form of Tag 0310 (1). Mathlib's
`Module.associatedPrimes.mem_associatedPrimes_of_comap_mem_associatedPrimes_of_isLocalizedModule`
is stated for a module and a localized module; the quotient `B ⧸ I · B` is a localized module of
`A ⧸ I` by `IsLocalizedModule.toLocalizedQuotient'`, and `Ideal.localized'_eq_map` identifies the
submodule it is a quotient by with `I · B`. -/
theorem map_mem_associatedPrimes_map_of_disjoint {A : Type u} [CommRing A] {B : Type v}
    [CommRing B] [Algebra A B] (S : Submonoid A) [IsLocalization S B] {I p : Ideal A}
    [hp : p.IsPrime] (hdisj : Disjoint (S : Set A) (p : Set A))
    (h : p ∈ Submodule.associatedPrimes I) :
    p.map (algebraMap A B) ∈ Submodule.associatedPrimes (I.map (algebraMap A B)) := by
  have hcomap : (p.map (algebraMap A B)).comap (algebraMap A B) = p :=
    IsLocalization.under_map_of_isPrime_disjoint S B hp hdisj
  rw [← mem_associatedPrimes_quotient_iff]
  have e : (I : Submodule A A).localized' B S (Algebra.linearMap A B)
      = ((I.map (algebraMap A B) : Ideal B) : Submodule B B) := Ideal.localized'_eq_map B S I
  refine (LinearEquiv.isAssociatedPrime_iff (Submodule.quotEquivOfEq _ _ e)).mp ?_
  open Module.associatedPrimes in
  exact mem_associatedPrimes_of_comap_mem_associatedPrimes_of_isLocalizedModule
    S ((I : Submodule A A).toLocalizedQuotient' B S (Algebra.linearMap A B)) _
    (by rw [hcomap]; exact (mem_associatedPrimes_quotient_iff I p).mpr h)

/-! ### The chart statement -/

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : A}

/-- Cancelling a power of `f` from numerator and denominator: `f ^ m * b / f ^ (n + m)` is
`b / f ^ n`. -/
theorem mk_pow_mul_left (hf : f ∈ 𝒜 1) (n m : ℕ) (b : A) (hb : b ∈ 𝒜 (n • 1))
    (hb' : f ^ m * b ∈ 𝒜 ((n + m) • 1)) :
    Away.mk 𝒜 hf (n + m) (f ^ m * b) hb' = Away.mk 𝒜 hf n b hb := by
  apply HomogeneousLocalization.val_injective
  rw [Away.val_mk, Away.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul]
  ring

/-- **The ideal that a homogeneous ideal cuts out on a standard chart, elementwise.** For
`f ∈ 𝒜 1`, an element of the degree-zero chart ring `A₍f₎` lies in the contraction of `I · A[1/f]`
exactly when it is `b / f ^ n` for some homogeneous `b ∈ I` of degree `n`.

Needs no homogeneity of `I`: if `b / f ^ n` lies in `I · A[1/f]` then some `f ^ j * b` lies in `I`,
and `f ^ j * b / f ^ (n + j)` is the same element of `A₍f₎`. -/
theorem mem_under_map_iff (hf : f ∈ 𝒜 1) {I : Ideal A} (x : Away 𝒜 f) :
    x ∈ (I.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)
      ↔ ∃ (n : ℕ) (b : A) (hb : b ∈ 𝒜 (n • 1)), b ∈ I ∧ Away.mk 𝒜 hf n b hb = x := by
  rw [Ideal.under, Ideal.mem_comap, HomogeneousLocalization.algebraMap_apply]
  constructor
  · intro hx
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hf x
    rw [Away.val_mk, IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f)] at hx
    obtain ⟨⟨⟨c, hc⟩, ⟨s, k, (rfl : f ^ k = s)⟩⟩, heq⟩ := hx
    simp only [← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists] at heq
    obtain ⟨⟨u, j, (rfl : f ^ j = u)⟩, hu⟩ := heq
    simp only [OneMemClass.coe_one, mul_one, one_mul] at hu
    have hmem : f ^ (j + k) * a ∈ I := by
      rw [show f ^ (j + k) * a = f ^ j * c * f ^ n by linear_combination hu]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ hc)
    have hdeg : f ^ (j + k) * a ∈ 𝒜 ((n + (j + k)) • 1) := by
      have h := SetLike.mul_mem_graded (by simpa using SetLike.pow_mem_graded (A := 𝒜) (j + k) hf :
        f ^ (j + k) ∈ 𝒜 ((j + k) • 1)) ha
      rwa [← add_smul, add_comm (j + k) n] at h
    exact ⟨n + (j + k), _, hdeg, hmem, mk_pow_mul_left 𝒜 hf n (j + k) a ha hdeg⟩
  · rintro ⟨n, b, hb, hbI, rfl⟩
    rw [Away.val_mk, mk_eq_algebraMap_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hbI)

/-- **The extension of a homogeneous ideal to `A[1/f]` is a base change of its degree-zero
part.** For `f ∈ 𝒜 1` and `I` homogeneous, `A[1/f] ⧸ I · A[1/f]` is the base change along
`A₍f₎ → A[1/f]` of `A₍f₎ ⧸ (I · A[1/f]) ∩ A₍f₎`.

This is `Stacks.GradedLaurent.map_eq_map_under_of_isHomogeneous` — the one step that uses
homogeneity — followed by `Ideal.quotMapEquivTensorQuot`. -/
noncomputable def quotientMapEquivTensorQuotientUnder (hf : f ∈ 𝒜 1) {I : Ideal A}
    (hI : I.IsHomogeneous 𝒜) :
    (Localization.Away f ⧸ I.map (algebraMap A (Localization.Away f)))
      ≃ₗ[Localization.Away f] Localization.Away f ⊗[Away 𝒜 f]
        (Away 𝒜 f ⧸ (I.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)) :=
  (Submodule.quotEquivOfEq (I.map (algebraMap A (Localization.Away f)))
      (((I.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)).map
        (algebraMap (Away 𝒜 f) (Localization.Away f)))
      (map_eq_map_under_of_isHomogeneous 𝒜 hf hI)).trans
    (Ideal.quotMapEquivTensorQuot (Localization.Away f))

/-- **An associated prime of a homogeneous ideal, read on a standard chart of `Proj`.** Let
`f ∈ 𝒜 1`, let `I` be a homogeneous ideal of a Noetherian graded ring `A`, and let `p` be a prime
associated to `I` with `f ∉ p`. Then the prime of the degree-zero chart ring `A₍f₎` that the
standard open `D₊(f) ≅ Spec A₍f₎` assigns to the point `p` of `Proj 𝒜` is associated to the ideal
of `A₍f₎` that `I` cuts out there.

Both the prime and the ideal are the contraction to `A₍f₎` of the extension to `A[1/f]`, which is
the spelling `Stacks.GradedLaurent.height_eq_height_under_away_of_isNoetherianRing` uses for the
corresponding prime, so the two statements compose directly. -/
theorem under_mem_associatedPrimes_under_of_mem [IsNoetherianRing A] (hf : f ∈ 𝒜 1) {I p : Ideal A}
    (hI : I.IsHomogeneous 𝒜) [hp : p.IsPrime] (hfp : f ∉ p)
    (h : p ∈ Submodule.associatedPrimes I) :
    ((p.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f))
      ∈ Submodule.associatedPrimes
        ((I.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)) := by
  have hNoeth : IsNoetherianRing (Away 𝒜 f) := isNoetherianRing_away_of_mem_degree_one 𝒜 hf
  have hdisj : Disjoint (Submonoid.powers f : Set A) (p : Set A) := by
    rw [Set.disjoint_left]
    rintro z ⟨n, rfl⟩ hz
    exact hfp (hp.mem_of_pow_mem n hz)
  -- extend to `A[1/f]`, where `p` stays associated to `I` because `f ∉ p`
  have hup : p.map (algebraMap A (Localization.Away f))
      ∈ Submodule.associatedPrimes (I.map (algebraMap A (Localization.Away f))) :=
    map_mem_associatedPrimes_map_of_disjoint (Submonoid.powers f) hdisj h
  -- present the quotient as a base change from the chart ring and apply the Laurent description
  rw [← mem_associatedPrimes_quotient_iff] at hup ⊢
  refine (mem_associatedPrimes_localizationAway_iff 𝒜 _ hf).mp
    ((LinearEquiv.isAssociatedPrime_iff
      (quotientMapEquivTensorQuotientUnder 𝒜 hf hI)).mp hup) |>.1

end Stacks.GradedChartAssociatedPrimes

end
