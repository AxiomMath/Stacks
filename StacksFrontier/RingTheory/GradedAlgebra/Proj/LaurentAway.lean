module

public import Mathlib.Algebra.Polynomial.Laurent
public import StacksFrontier.RingTheory.GradedAlgebra.Proj.StandardOpenBaseChange
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The localization at a degree-one homogeneous element is a Laurent extension

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring and let `f ∈ 𝒜 d` be homogeneous. In the ordinary
localization `A[1/f]` the element `f` becomes a unit, so every integer power `f ^ k` makes sense
there, and the degree-zero part of `A[1/f]` is the ring `A₍f₎ = HomogeneousLocalization.Away 𝒜 f`.
This file proves that the integer powers of `f` are a *basis* of `A[1/f]` over `A₍f₎` as soon as
`f` has degree one, so that

`A[1/f] = A₍f₎[f, f⁻¹]`

is a Laurent extension of its degree-zero part. The identification is realized as a ring
isomorphism from `LaurentPolynomial A₍f₎` carrying `T` to `f`.

Three statements of independent interest are proved on the way, each for a homogeneous element of
arbitrary degree `d`:

* the degree-`k * d` part of `A[1/f]` is the free rank-one `A₍f₎`-submodule generated by `f ^ k`,
  for **every** integer `k`;
* the degree parts exhaust `A[1/f]`;
* the powers `f ^ k` are linearly independent over `A₍f₎` whenever `d ≠ 0`.

Degree one is needed only for the last step, and genuinely: for `𝒜` the grading of `k[x, y]` with
`deg x = 2` and `deg y = 1`, the powers of `f = x` span only the even-degree part of `A[1/x]`,
which does not contain `y`.

## Main definitions

* `Stacks.GradedLaurent.awayUnit`: the image of `f` in `A[1/f]`, as a unit.
* `Stacks.GradedLaurent.basisZpow`: the basis `k ↦ f ^ k` of `A[1/f]` over `A₍f₎`, for `f` of
  degree one.
* `Stacks.GradedLaurent.laurentAwayEquiv`: the ring isomorphism
  `LaurentPolynomial A₍f₎ ≃+* A[1/f]` sending `T` to `f`.

## Main results

* `Stacks.GradedLaurent.twistAway_eq_span_zpow`: **the degree-`k * d` part of `A[1/f]` is
  `A₍f₎ ∙ f ^ k`**, for every `k : ℤ`. This generalizes
  `Stacks.ProjStandardOpenBaseChange.twistAway_self_eq_span`, which is the case `k = 1`.
* `Stacks.GradedLaurent.iSup_twistAway_eq_top`: the degree parts of `A[1/f]` exhaust it.
* `Stacks.GradedLaurent.linearIndependent_coe_awayUnit_zpow`: **the integer powers of `f` are
  linearly independent over `A₍f₎`** when `d ≠ 0`.
* `Stacks.GradedLaurent.span_range_coe_awayUnit_zpow_eq_top`: for `d = 1` they also span.
* `Stacks.GradedLaurent.laurentAwayEquiv_T` and `Stacks.GradedLaurent.laurentAwayEquiv_C`: the
  isomorphism carries `T k` to `f ^ k` and `C a` to `a`.

## Implementation notes

The degree parts are taken in the spelling `Stacks.ProjStandardOpenBaseChange.twistAway`, which
presents the degree-`n` part of `A[1/f]` as an `A₍f₎`-submodule of `A[1/f]` itself. That is the
spelling in which the degree-`d` case is already proved, and it is the one in which both halves of
a basis statement — independence and spanning — are statements about one and the same module, so
no comparison map intervenes anywhere in this file.

Every fraction identity is routed through `coe_awayUnit_zpow_eq_mk`, which writes an arbitrary
*integer* power of `f` as a single fraction `f ^ a / f ^ b` with `a` and `b` natural and
`(a : ℤ) = k + b`. Taking the two natural exponents as *arguments* constrained by that equation,
rather than computing them with `Int.toNat`, is what makes the lemma usable in both signs of `k`
with no case split: a formulation using `(k + b).toNat` cannot be rewritten with, because the
`toNat` term occurs on both sides of the equation.

Linear independence is reduced to the directness of the grading of `A` itself, not to any grading
of the localization. Given a relation `∑ cₙ • f ⁿ = 0` over a finite set of integers `n`, the
denominators are cleared by multiplying by `f ^ J` for `J` the supremum of the denominators'
exponents, and the negative powers by multiplying by `f ^ N` for `N` large enough that `n + N ≥ 0`
throughout; what is left is a relation among *homogeneous elements of `A` of pairwise distinct
degrees*, and `eq_zero_of_sum_eq_zero_of_injOn` kills it one summand at a time with the
homogeneous projections. This is why `d ≠ 0` appears exactly where it does: it is what makes the
degrees distinct.

`smul_eq_val_mul` crosses, once and for all, between the action of `A₍f₎` on `A[1/f]` and
multiplication by the value of a fraction. The two are definitionally equal, but the rewrite is
needed explicitly because the scalar action and the ring multiplication are different terms.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
* [Stacks Project, Tag 01M4](https://stacks.math.columbia.edu/tag/01M4)
-/

@[expose] public noncomputable section

namespace Stacks.GradedLaurent

open HomogeneousLocalization Stacks.ProjStandardOpenBaseChange

universe u v

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]

/-! ### Integer powers of the inverted element -/

/-- The image of `f` in the localization `A[1/f]`, as a unit. -/
def awayUnit (f : A) : (Localization.Away f)ˣ :=
  (IsLocalization.Away.algebraMap_isUnit f).unit

/-- A natural power of `awayUnit f` has value the image of `f ^ n` in `A[1/f]`. -/
@[simp]
theorem coe_awayUnit_zpow_natCast (f : A) (n : ℕ) :
    ((awayUnit f ^ (n : ℤ) : (Localization.Away f)ˣ) : Localization.Away f)
      = algebraMap A (Localization.Away f) (f ^ n) := by
  rw [zpow_natCast, Units.val_pow_eq_pow_val, awayUnit, IsUnit.unit_spec, map_pow]

/-- A fraction with denominator a power of `f` is cleared by multiplying by that power. -/
theorem mk_mul_algebraMap_pow (f x : A) (b : ℕ) :
    Localization.mk x ⟨f ^ b, Submonoid.pow_mem _ (Submonoid.mem_powers f) b⟩ *
      algebraMap A (Localization.Away f) (f ^ b) = algebraMap A (Localization.Away f) x := by
  rw [← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
    Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp; ring⟩

/-- An arbitrary integer power `f ^ k` is the fraction `f ^ a / f ^ b` for any natural `a` and `b`
with `(a : ℤ) = k + b`. -/
theorem coe_awayUnit_zpow_eq_mk (f : A) {k : ℤ} {a b : ℕ} (h : (a : ℤ) = k + b) :
    ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f)
      = Localization.mk (f ^ a) ⟨f ^ b, Submonoid.pow_mem _ (Submonoid.mem_powers f) b⟩ := by
  refine (Units.mul_left_inj (awayUnit f ^ (b : ℤ))).mp ?_
  rw [← Units.val_mul, ← zpow_add, ← h, coe_awayUnit_zpow_natCast, coe_awayUnit_zpow_natCast,
    mk_mul_algebraMap_pow]

/-- Multiplying `(y / f ^ j) * f ^ n` by `f ^ J` and `f ^ N`, with `j ≤ J` and `(a : ℤ) = n + N`,
gives the image of `y * f ^ (J - j) * f ^ a`. -/
theorem mk_mul_zpow_mul (f y : A) {j J a : ℕ} (hjJ : j ≤ J) {n : ℤ} {N : ℕ}
    (ha : (a : ℤ) = n + N) :
    Localization.mk y ⟨f ^ j, Submonoid.pow_mem _ (Submonoid.mem_powers f) j⟩
        * ((awayUnit f ^ n : (Localization.Away f)ˣ) : Localization.Away f)
        * algebraMap A (Localization.Away f) (f ^ J)
        * ((awayUnit f ^ (N : ℤ) : (Localization.Away f)ˣ) : Localization.Away f)
      = algebraMap A (Localization.Away f) (y * f ^ (J - j) * f ^ a) := by
  have hJ : f ^ J = f ^ j * f ^ (J - j) := by rw [← pow_add, Nat.add_sub_cancel' hjJ]
  calc Localization.mk y ⟨f ^ j, Submonoid.pow_mem _ (Submonoid.mem_powers f) j⟩
        * ((awayUnit f ^ n : (Localization.Away f)ˣ) : Localization.Away f)
        * algebraMap A (Localization.Away f) (f ^ J)
        * ((awayUnit f ^ (N : ℤ) : (Localization.Away f)ˣ) : Localization.Away f)
      = (Localization.mk y ⟨f ^ j, Submonoid.pow_mem _ (Submonoid.mem_powers f) j⟩
          * algebraMap A (Localization.Away f) (f ^ j))
        * algebraMap A (Localization.Away f) (f ^ (J - j))
        * (((awayUnit f ^ n : (Localization.Away f)ˣ) : Localization.Away f)
          * ((awayUnit f ^ (N : ℤ) : (Localization.Away f)ˣ) : Localization.Away f)) := by
        rw [hJ, map_mul]; ring
    _ = algebraMap A (Localization.Away f) (y * f ^ (J - j) * f ^ a) := by
        rw [mk_mul_algebraMap_pow, ← Units.val_mul, ← zpow_add, ← ha, coe_awayUnit_zpow_natCast,
          map_mul, map_mul]

/-- A fraction is its numerator times the inverse of its denominator. -/
theorem mk_eq_algebraMap_mul (f x : A) (s : Submonoid.powers f) :
    Localization.mk x s = algebraMap A (Localization.Away f) x * Localization.mk 1 s := by
  rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]

/-! ### The degree parts of the localization -/

variable (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : A} {d : ℕ}

/-- The action of the degree-zero localization on the full localization is multiplication by the
value of the fraction. -/
theorem smul_eq_val_mul (c : Away 𝒜 f) (z : Localization.Away f) : c • z = c.val * z :=
  smul_eq_mul (val c) z

/-- **The degree-`k * d` part of `A[1/f]` is the `A₍f₎`-submodule generated by `f ^ k`**, for every
integer `k`. This generalizes `Stacks.ProjStandardOpenBaseChange.twistAway_self_eq_span`, which is
the case `k = 1`. -/
theorem twistAway_eq_span_zpow (hf : f ∈ 𝒜 d) (k : ℤ) :
    twistAway 𝒜 f d (k * d) =
      Away 𝒜 f ∙ ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f) := by
  apply le_antisymm
  · rw [twistAway, Submodule.span_le]
    rintro z ⟨m, e, x, he, hx, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_span_singleton]
    set M : ℕ := (-k - m).toNat with hM
    have hM' : (0 : ℤ) ≤ (m : ℤ) + M + k := by simp only [hM]; omega
    obtain ⟨j, hjz⟩ := Int.eq_ofNat_of_zero_le hM'
    have hxM : x * f ^ M ∈ 𝒜 (j • d) := by
      have hjd : j • d = e + M * d := by
        have h2 : ((j • d : ℕ) : ℤ) = ((e + M * d : ℕ) : ℤ) := by
          push_cast [smul_eq_mul] at he ⊢; rw [← hjz]; linarith [he]
        exact Nat.cast_injective h2
      rw [hjd]
      exact SetLike.mul_mem_graded hx (SetLike.pow_mem_graded M hf)
    refine ⟨Away.mk 𝒜 hf j (x * f ^ M) hxM, ?_⟩
    rw [smul_eq_val_mul, Away.val_mk,
      coe_awayUnit_zpow_eq_mk f (k := k) (a := j) (b := m + M) (by push_cast; omega),
      Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by push_cast; ring⟩
  · obtain ⟨a, ha⟩ := Int.eq_ofNat_of_zero_le (show (0 : ℤ) ≤ k + (-k).toNat by omega)
    rw [Submodule.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      coe_awayUnit_zpow_eq_mk f (k := k) (a := a) (b := (-k).toNat) ha.symm]
    refine Submodule.subset_span ⟨(-k).toNat, a * d, _, ?_, SetLike.pow_mem_graded _ hf, rfl⟩
    push_cast
    rw [← ha]
    ring

/-- A single fraction with homogeneous numerator lies in the degree part its degree names. -/
theorem mem_twistAway_mk {e m : ℕ} {x : A} (hx : x ∈ 𝒜 e) :
    Localization.mk x ⟨f ^ m, Submonoid.pow_mem _ (Submonoid.mem_powers f) m⟩
      ∈ twistAway 𝒜 f d ((e : ℤ) - m * d) :=
  Submodule.subset_span ⟨m, e, x, by push_cast; ring, hx, rfl⟩

/-- The degree parts of `A[1/f]` exhaust it, for any `f`, homogeneous or not. -/
theorem iSup_twistAway_eq_top (d : ℕ) :
    (⨆ n : ℤ, twistAway 𝒜 f d n) = ⊤ := by
  classical
  rw [eq_top_iff]
  intro z _
  induction z using Localization.induction_on with
  | H y =>
    obtain ⟨x, s⟩ := y
    obtain ⟨m, hm⟩ := s.2
    have hs : s = ⟨f ^ m, Submonoid.pow_mem _ (Submonoid.mem_powers f) m⟩ := Subtype.ext hm.symm
    subst hs
    rw [mk_eq_algebraMap_mul, ← DirectSum.sum_support_decompose 𝒜 x, map_sum, Finset.sum_mul]
    refine Submodule.sum_mem _ fun e _ => ?_
    rw [← mk_eq_algebraMap_mul]
    exact Submodule.mem_iSup_of_mem _ (mem_twistAway_mk 𝒜 (d := d) (DirectSum.decompose 𝒜 x e).2)

/-! ### Independence of the powers -/

/-- A finite sum of homogeneous elements of pairwise distinct degrees vanishes only if every
summand vanishes. -/
theorem eq_zero_of_sum_eq_zero_of_injOn
    {ι : Type*} {s : Finset ι} {g : ι → ℕ} (hg : Set.InjOn g s) {w : ι → A}
    (hw : ∀ n ∈ s, w n ∈ 𝒜 (g n)) (h : ∑ n ∈ s, w n = 0) {n₀ : ι} (hn₀ : n₀ ∈ s) :
    w n₀ = 0 := by
  classical
  have key : GradedRing.proj 𝒜 (g n₀) (∑ n ∈ s, w n) = w n₀ := by
    rw [map_sum]
    refine (Finset.sum_eq_single_of_mem n₀ hn₀ fun b hb hne => ?_).trans ?_
    · rw [GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne 𝒜 (hw b hb) fun hcon => hne (hg hb hn₀ hcon)
    · rw [GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_same 𝒜 (hw n₀ hn₀)
  rw [h, map_zero] at key
  exact key.symm

/-- **The integer powers of a homogeneous element of nonzero degree are linearly independent over
the degree-zero localization.** -/
@[ega "II 2.2.1" "partial"]
theorem linearIndependent_coe_awayUnit_zpow (hf : f ∈ 𝒜 d) (hd : d ≠ 0) :
    LinearIndependent (Away 𝒜 f)
      (fun k : ℤ => ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f)) := by
  classical
  rw [linearIndependent_iff']
  intro s c hsum n₀ hn₀
  choose jj num hnum hmk using fun n : ℤ => Away.mk_surjective 𝒜 hf (c n)
  simp only [smul_eq_mul] at hnum
  set J : ℕ := s.sup jj with hJdef
  set N : ℕ := s.sup fun n => (-n).toNat with hNdef
  have hjJ : ∀ n ∈ s, jj n ≤ J := fun n hn => Finset.le_sup hn
  have hnN : ∀ n ∈ s, (0 : ℤ) ≤ n + N := by
    intro n hn
    have h : ((-n).toNat : ℤ) ≤ (N : ℤ) :=
      Int.ofNat_le.mpr (Finset.le_sup (f := fun n : ℤ => (-n).toNat) hn)
    omega
  set a : ℤ → ℕ := fun n => (n + N).toNat with hadef
  have ha : ∀ n ∈ s, (a n : ℤ) = n + N := fun n hn => Int.toNat_of_nonneg (hnN n hn)
  have hterm : ∀ n ∈ s, c n • ((awayUnit f ^ n : (Localization.Away f)ˣ) : Localization.Away f)
      * algebraMap A (Localization.Away f) (f ^ J)
      * ((awayUnit f ^ (N : ℤ) : (Localization.Away f)ˣ) : Localization.Away f)
      = algebraMap A (Localization.Away f) (num n * f ^ (J - jj n) * f ^ a n) := by
    intro n hn
    rw [smul_eq_val_mul, ← hmk n, Away.val_mk]
    exact mk_mul_zpow_mul f (num n) (hjJ n hn) (ha n hn)
  have hzero : algebraMap A (Localization.Away f)
      (∑ n ∈ s, num n * f ^ (J - jj n) * f ^ a n) = 0 := by
    rw [map_sum, ← Finset.sum_congr rfl hterm, ← Finset.sum_mul, ← Finset.sum_mul, hsum,
      zero_mul, zero_mul]
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers f)] at hzero
  obtain ⟨t, hp⟩ := hzero
  obtain ⟨p, hpt⟩ := t.2
  rw [← hpt, Finset.mul_sum] at hp
  have hdeg : ∀ n ∈ s, f ^ p * (num n * f ^ (J - jj n) * f ^ a n) ∈ 𝒜 ((p + J + a n) * d) := by
    intro n hn
    have hmem := SetLike.mul_mem_graded (SetLike.pow_mem_graded p hf)
      (SetLike.mul_mem_graded
        (SetLike.mul_mem_graded (hnum n) (SetLike.pow_mem_graded (J - jj n) hf))
        (SetLike.pow_mem_graded (a n) hf))
    have hidx : p * d + (jj n * d + (J - jj n) * d + a n * d) = (p + J + a n) * d := by
      zify [hjJ n hn]; ring
    simp only [smul_eq_mul] at hmem
    rwa [hidx] at hmem
  have hinj : Set.InjOn (fun n => (p + J + a n) * d) s := by
    intro n hn n' hn' hEq
    simp only at hEq
    have hd' : 0 < d := Nat.pos_of_ne_zero hd
    have h1 : p + J + a n = p + J + a n' := Nat.eq_of_mul_eq_mul_right hd' hEq
    have h2 := ha n hn
    have h3 := ha n' hn'
    omega
  have hnumzero : algebraMap A (Localization.Away f) (num n₀) = 0 := by
    rw [IsLocalization.map_eq_zero_iff (Submonoid.powers f)]
    refine ⟨⟨f ^ (p + (J - jj n₀) + a n₀), p + (J - jj n₀) + a n₀, rfl⟩, ?_⟩
    calc f ^ (p + (J - jj n₀) + a n₀) * num n₀
        = f ^ p * (num n₀ * f ^ (J - jj n₀) * f ^ a n₀) := by rw [pow_add, pow_add]; ring
      _ = 0 := eq_zero_of_sum_eq_zero_of_injOn 𝒜 hinj hdeg hp hn₀
  rw [← hmk n₀, ← HomogeneousLocalization.val_injective (Submonoid.powers f) |>.eq_iff,
    HomogeneousLocalization.val_zero, Away.val_mk, mk_eq_algebraMap_mul, hnumzero, zero_mul]

/-! ### The Laurent identification in degree one -/

/-- For `f` of degree one the integer powers of `f` span `A[1/f]` over the degree-zero
localization. -/
theorem span_range_coe_awayUnit_zpow_eq_top (hf : f ∈ 𝒜 1) :
    Submodule.span (Away 𝒜 f) (Set.range fun k : ℤ =>
      ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f)) = ⊤ := by
  rw [Submodule.span_range_eq_iSup, ← iSup_twistAway_eq_top 𝒜 (f := f) 1]
  refine iSup_congr fun k => ?_
  rw [← twistAway_eq_span_zpow 𝒜 hf k, Nat.cast_one, mul_one]

/-- **`A[1/f]` is free over its degree-zero part on the integer powers of `f`**, for `f`
homogeneous of degree one. -/
def basisZpow (hf : f ∈ 𝒜 1) :
    Module.Basis ℤ (Away 𝒜 f) (Localization.Away f) :=
  Module.Basis.mk (linearIndependent_coe_awayUnit_zpow 𝒜 hf one_ne_zero)
    (by rw [span_range_coe_awayUnit_zpow_eq_top 𝒜 hf])

/-- The `k`-th vector of `basisZpow` is the `k`-th power of `f`. -/
@[simp]
theorem basisZpow_apply (hf : f ∈ 𝒜 1) (k : ℤ) :
    basisZpow 𝒜 hf k = ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f) := by
  rw [basisZpow, Module.Basis.mk_apply]

/-- The evaluation `T ↦ f` of a Laurent polynomial over the degree-zero localization. -/
def laurentAwayHom (f : A) :
    LaurentPolynomial (Away 𝒜 f) →+* Localization.Away f :=
  LaurentPolynomial.eval₂ (algebraMap (Away 𝒜 f) (Localization.Away f)) (awayUnit f)

/-- The evaluation `laurentAwayHom` carries `T k` to the `k`-th power of `f`. -/
@[simp]
theorem laurentAwayHom_T (k : ℤ) :
    laurentAwayHom 𝒜 f (LaurentPolynomial.T k)
      = ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f) :=
  LaurentPolynomial.eval₂_T _ _ k

/-- The evaluation `laurentAwayHom` carries `C a` to the value of `a` in `A[1/f]`. -/
@[simp]
theorem laurentAwayHom_C (a : Away 𝒜 f) :
    laurentAwayHom 𝒜 f (LaurentPolynomial.C a) = a.val :=
  LaurentPolynomial.eval₂_C _ _ a

/-- **The Laurent identification: for `f` homogeneous of degree one the localization `A[1/f]` is
the Laurent extension `A₍f₎[f, f⁻¹]` of its degree-zero part.** -/
def laurentAwayEquiv (hf : f ∈ 𝒜 1) :
    LaurentPolynomial (Away 𝒜 f) ≃+* Localization.Away f := by
  refine RingEquiv.ofBijective (laurentAwayHom 𝒜 f) ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro p hp
    have hsum : ∑ n ∈ (AddMonoidAlgebra.coeff p).support, AddMonoidAlgebra.coeff p n •
        ((awayUnit f ^ n : (Localization.Away f)ˣ) : Localization.Away f)
        = laurentAwayHom 𝒜 f p := by
      conv_rhs => rw [← AddMonoidAlgebra.sum_coeff_single p]
      rw [Finsupp.sum, map_sum]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [LaurentPolynomial.single_eq_C_mul_T, map_mul, laurentAwayHom_C, laurentAwayHom_T,
        smul_eq_val_mul]
    have hli := linearIndependent_iff'.mp
      (linearIndependent_coe_awayUnit_zpow 𝒜 hf one_ne_zero) (AddMonoidAlgebra.coeff p).support
      (AddMonoidAlgebra.coeff p) (hsum.trans hp)
    refine LaurentPolynomial.ext_iff.mpr fun k => ?_
    by_cases hk : k ∈ (AddMonoidAlgebra.coeff p).support
    · exact hli k hk
    · simpa using hk
  · intro z
    have hz : z ∈ Submodule.span (Away 𝒜 f) (Set.range fun k : ℤ =>
        ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f)) := by
      rw [span_range_coe_awayUnit_zpow_eq_top 𝒜 hf]; trivial
    induction hz using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨k, rfl⟩ := hx
        exact ⟨LaurentPolynomial.T k, laurentAwayHom_T 𝒜 k⟩
    | zero => exact ⟨0, map_zero _⟩
    | add x y _ _ hx hy =>
        obtain ⟨px, hpx⟩ := hx
        obtain ⟨py, hpy⟩ := hy
        exact ⟨px + py, by rw [map_add, hpx, hpy]⟩
    | smul c x _ hx =>
        obtain ⟨px, hpx⟩ := hx
        exact ⟨LaurentPolynomial.C c * px, by
          rw [map_mul, laurentAwayHom_C, hpx, smul_eq_val_mul]⟩

/-- The Laurent identification `laurentAwayEquiv` is the evaluation `laurentAwayHom`. -/
@[simp]
theorem laurentAwayEquiv_apply (hf : f ∈ 𝒜 1) (p : LaurentPolynomial (Away 𝒜 f)) :
    laurentAwayEquiv 𝒜 hf p = laurentAwayHom 𝒜 f p := rfl

/-- The Laurent identification carries `T k` to the `k`-th power of `f`. -/
theorem laurentAwayEquiv_T (hf : f ∈ 𝒜 1) (k : ℤ) :
    laurentAwayEquiv 𝒜 hf (LaurentPolynomial.T k)
      = ((awayUnit f ^ k : (Localization.Away f)ˣ) : Localization.Away f) :=
  laurentAwayHom_T 𝒜 k

/-- The Laurent identification is the identity on the degree-zero part. -/
theorem laurentAwayEquiv_C (hf : f ∈ 𝒜 1) (a : Away 𝒜 f) :
    laurentAwayEquiv 𝒜 hf (LaurentPolynomial.C a) = a.val :=
  laurentAwayHom_C 𝒜 a

/-- `A[1/f]` is a free module over its degree-zero part, for `f` homogeneous of degree one. -/
theorem free_of_mem_degree_one (hf : f ∈ 𝒜 1) :
    Module.Free (Away 𝒜 f) (Localization.Away f) :=
  Module.Free.of_basis (basisZpow 𝒜 hf)

end Stacks.GradedLaurent

