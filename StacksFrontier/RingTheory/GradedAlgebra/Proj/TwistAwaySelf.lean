module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.GradedAlgebra.Proj.StandardOpenBaseChange

/-!
# The twist by the degree of a homogeneous element

Let `A` be a graded `R`-algebra and `f` a homogeneous element of degree `d`. On the standard
open `D₊(f)` the twist by `d` is free of rank one, generated by `f` itself: the degree-zero
localization of `A(d)` at `f`, viewed inside the ordinary localization `A[1/f]`, is the
`A₍f₎`-submodule generated by the image of `f`.

## Main results

* `Stacks.ProjStandardOpenBaseChange.twistAway_self_eq_span`: the twist by `deg f` is the span
  of `f` in the localization.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
-/

@[expose] public noncomputable section

namespace Stacks.ProjStandardOpenBaseChange

open HomogeneousLocalization

universe u v

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]

/-- On the standard open of a homogeneous element, the twist by its degree is the principal
submodule generated by that element. -/
public theorem twistAway_self_eq_span (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    (f : A) (d : ℕ) (hf : f ∈ 𝒜 d) :
    twistAway 𝒜 f d (d : ℤ) =
      Submodule.span (Away 𝒜 f) {algebraMap A (Localization.Away f) f} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro z ⟨k, e, x, he, hx, rfl⟩
    apply Submodule.mem_span_singleton.mpr
    refine ⟨Away.mk 𝒜 hf (k + 1) x ?_, ?_⟩
    · simpa [show e = (k + 1) * d by
        simpa [Nat.add_mul] using (show e = k * d + d by exact_mod_cast he)] using hx
    · change Localization.mk x ⟨f ^ (k + 1),
          Submonoid.pow_mem _ (Submonoid.mem_powers f) (k + 1)⟩ *
          Localization.mk f ⟨1, Submonoid.one_mem _⟩ =
        Localization.mk x ⟨f ^ k, Submonoid.pow_mem _ (Submonoid.mem_powers f) k⟩
      rw [Localization.mk_mul, Localization.mk_eq_mk']
      convert (IsLocalization.mk'_cancel (S := Localization (Submonoid.powers f)) x
        ⟨f ^ k, Submonoid.pow_mem _ (Submonoid.mem_powers f) k⟩
        ⟨f, Submonoid.mem_powers f⟩) using 1
      simp [pow_succ]
  · rw [Submodule.span_le, Set.singleton_subset_iff]
    refine Submodule.subset_span ⟨0, d, f, by simp, hf, ?_⟩
    rw [← Localization.mk_one_eq_algebraMap]
    simp only [pow_zero]
    congr 1

end Stacks.ProjStandardOpenBaseChange

end
