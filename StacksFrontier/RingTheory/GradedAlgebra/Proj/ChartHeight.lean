module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic
public import Mathlib.RingTheory.KrullDimension.Polynomial
public import StacksFrontier.RingTheory.GradedAlgebra.Proj.LaurentAway

/-!
# Heights are computed on a standard chart of `Proj`

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring, let `f ∈ 𝒜 1`, and let `p` be a homogeneous prime of
`A` with `f ∉ p`. The point of `Proj 𝒜` cut out by `p` lies in the standard open `D₊(f)`, which is
the spectrum of the degree-zero chart ring `A₍f₎ = HomogeneousLocalization.Away 𝒜 f`, and the
prime of `A₍f₎` it corresponds to is the degree-zero part `q` of `p · A[1/f]`. This file proves
that the two heights agree:

`height_A p = height_{A₍f₎} q`.

The route is a chain of three localizations and one ring isomorphism, none of which changes a
height:

* `height_A p = height_{A[1/f]} (p · A[1/f])`, by `IsLocalization.height_map_of_disjoint`;
* `p · A[1/f] = q · A[1/f]`, because `p` is homogeneous and every homogeneous element of `A[1/f]`
  is a degree-zero element times a power of `f`;
* `A[1/f] ≅ A₍f₎[T, T⁻¹]` by `Stacks.GradedLaurent.laurentAwayEquiv`, which carries
  `q · A₍f₎[T, T⁻¹]` to `q · A[1/f]`, so `RingEquiv.height_map` applies;
* `A₍f₎[T, T⁻¹] = A₍f₎[X][1/X]`, by `LaurentPolynomial.isLocalization`, and
  `height (q · A₍f₎[X]) = height q`.

## Main results

* `Stacks.GradedLaurent.height_map_C_of_isPrime`: for a **prime** `q` of a Noetherian ring `R`,
  `height (q · R[X]) = height q`.
* `Stacks.GradedLaurent.height_map_laurentPolynomial`: the same for the Laurent extension
  `R[T, T⁻¹]`.
* `Stacks.GradedLaurent.map_eq_map_under_of_isHomogeneous`: for `f ∈ 𝒜 1` and `p` a homogeneous
  ideal, `p · A[1/f]` is generated by its degree-zero part.
* `Stacks.GradedLaurent.isNoetherianRing_away_of_mem_degree_one`: for `f ∈ 𝒜 1` and `A`
  Noetherian, the chart ring `A₍f₎` is Noetherian.
* `Stacks.GradedLaurent.height_eq_height_under_away` and
  `Stacks.GradedLaurent.height_eq_height_under_away_of_isNoetherianRing`: the height of a
  homogeneous prime `p` with `f ∉ p` equals the height of the corresponding prime of the chart
  ring `A₍f₎`, with the Noetherian hypothesis on `A₍f₎` and on `A` respectively.

## Implementation notes

The results assume a Noetherian ring, since the height computation for a polynomial extension,
`Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown`, assumes the larger ring is Noetherian.
The identity `height (q · R[X]) = height q` holds for an arbitrary commutative ring, by the special
chain theorem, but is not proved here.

The hypothesis is stated on the chart ring `A₍f₎` in `height_eq_height_under_away`, and
`isNoetherianRing_away_of_mem_degree_one` derives it from `IsNoetherianRing A`: by
`free_of_mem_degree_one`, `A[1/f]` is free, hence faithfully flat, over `A₍f₎`, and a Noetherian
ring descends along a faithfully flat algebra.

The hypothesis `f ∈ 𝒜 1` is used twice. In `map_eq_map_under_of_isHomogeneous` it makes
`x / f ^ d` a degree-zero element for `x ∈ 𝒜 d`; for `f` of degree `e > 1` there need be no power
of `f` of degree `d`. And `laurentAwayEquiv` needs it: in the grading of `k[x, y]` with
`deg x = 2`, the powers of `x` span only the even part of `k[x, y][1/x]`.

The corresponding prime of the chart ring is written as `(p.map (algebraMap A A[1/f])).under A₍f₎`.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON)
-/

@[expose] public noncomputable section

namespace Stacks.GradedLaurent

open HomogeneousLocalization Polynomial Ideal
open scoped TensorProduct

universe u v

/-! ### Heights in a polynomial and a Laurent extension -/

section Polynomial

variable {S : Type u} [CommRing S]

/-- The contraction of `q · S[X]` along `S → S[X]` is `q`, for an arbitrary ideal `q`. -/
theorem comap_C_map_C (q : Ideal S) : (q.map (Polynomial.C)).comap Polynomial.C = q := by
  refine le_antisymm (fun a ha => ?_) le_comap_map
  simpa using (Ideal.mem_map_C_iff.mp ha) 0

/-- For a prime `q` of a Noetherian ring `S`, `q · S[X]` has the same height as `q`. -/
theorem height_map_C_of_isPrime [IsNoetherianRing S] (q : Ideal S) [q.IsPrime] :
    (q.map (Polynomial.C)).height = q.height := by
  have : (q.map (Polynomial.C (R := S))).LiesOver q := ⟨(comap_C_map_C q).symm⟩
  simp [Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown q]

/-- For a prime `q` of a Noetherian ring `S`, `q · S[T, T⁻¹]` has the same height as `q`. -/
theorem height_map_laurentPolynomial [IsNoetherianRing S] (q : Ideal S) [q.IsPrime] :
    (q.map (algebraMap S (LaurentPolynomial S))).height = q.height := by
  have hcomp : (algebraMap S[X] (LaurentPolynomial S)).comp Polynomial.C
      = algebraMap S (LaurentPolynomial S) := by
    ext a; simp
  have h1 : q.map (algebraMap S (LaurentPolynomial S))
      = (q.map (Polynomial.C)).map (algebraMap S[X] (LaurentPolynomial S)) := by
    rw [Ideal.map_map, hcomp]
  have hdisj : Disjoint (Submonoid.powers (Polynomial.X : S[X]) : Set S[X])
      ((q.map (Polynomial.C)) : Set S[X]) := by
    rw [Ideal.disjoint_powers_iff_notMem_of_isPrime]
    intro hX
    exact (Ideal.IsPrime.ne_top ‹q.IsPrime›) ((Ideal.eq_top_iff_one _).mpr (by
      simpa using (Ideal.mem_map_C_iff.mp hX) 1))
  rw [h1, IsLocalization.height_map_of_disjoint (Submonoid.powers (Polynomial.X : S[X]))
    (q.map Polynomial.C) hdisj, height_map_C_of_isPrime]

end Polynomial

/-! ### A homogeneous ideal is generated by its degree-zero part after inverting `f` -/

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]
variable (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : A}

/-- For `f ∈ 𝒜 1` and `x ∈ 𝒜 d`, the fraction `x / f ^ d` is a degree-zero element of `A[1/f]`,
and `x` is that element times `f ^ d`. -/
theorem algebraMap_eq_val_mul_pow (hf : f ∈ 𝒜 1) {d : ℕ} {x : A} (hx : x ∈ 𝒜 d) :
    algebraMap A (Localization.Away f) x
      = (Away.mk 𝒜 hf d x (by simpa using hx)).val
        * algebraMap A (Localization.Away f) (f ^ d) := by
  rw [Away.val_mk, mk_mul_algebraMap_pow]

/-- For `f ∈ 𝒜 1` and `p` a homogeneous ideal, the ideal `p · A[1/f]` is generated by its
degree-zero part. -/
theorem map_eq_map_under_of_isHomogeneous (hf : f ∈ 𝒜 1) {p : Ideal A}
    (hp : p.IsHomogeneous 𝒜) :
    p.map (algebraMap A (Localization.Away f))
      = ((p.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)).map
          (algebraMap (Away 𝒜 f) (Localization.Away f)) := by
  classical
  refine le_antisymm ?_ Ideal.map_comap_le
  rw [Ideal.map_le_iff_le_comap]
  intro x hxp
  rw [Ideal.mem_comap]
  rw [← DirectSum.sum_support_decompose 𝒜 x, map_sum]
  refine Ideal.sum_mem _ fun d _ => ?_
  set y : A := (DirectSum.decompose 𝒜 x d : A) with hy
  have hyp : y ∈ p := hp d hxp
  have hyd : y ∈ 𝒜 d := (DirectSum.decompose 𝒜 x d).2
  set c : Away 𝒜 f := Away.mk 𝒜 hf d y (by simpa using hyd) with hc
  have hcmem : c ∈ (p.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f) := by
    rw [Ideal.under, Ideal.mem_comap, HomogeneousLocalization.algebraMap_apply, hc,
      Away.val_mk,
      mk_eq_algebraMap_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hyp)
  rw [algebraMap_eq_val_mul_pow 𝒜 hf hyd, ← HomogeneousLocalization.algebraMap_apply]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hcmem)

/-! ### The chart ring of a Noetherian graded ring is Noetherian -/

/-- For `f ∈ 𝒜 1` and `A` Noetherian, the degree-zero chart ring `A₍f₎` is Noetherian. -/
theorem isNoetherianRing_away_of_mem_degree_one [IsNoetherianRing A] (hf : f ∈ 𝒜 1) :
    IsNoetherianRing (Away 𝒜 f) := by
  rcases subsingleton_or_nontrivial (Localization.Away f) with hst | hnt
  · have : Subsingleton (Away 𝒜 f) :=
      Function.Injective.subsingleton (HomogeneousLocalization.val_injective (Submonoid.powers f))
    exact isNoetherian_of_finite _ _
  · have : Module.Free (Away 𝒜 f) (Localization.Away f) := free_of_mem_degree_one 𝒜 hf
    have h : IsNoetherian (Localization.Away f)
        ((Localization.Away f) ⊗[Away 𝒜 f] (Away 𝒜 f)) :=
      isNoetherian_of_linearEquiv
        (TensorProduct.AlgebraTensorModule.rid (Away 𝒜 f) (Localization.Away f)
          (Localization.Away f)).symm
    exact Submodule.IsNoetherian.of_isNoetherian_tensorProduct_of_faithfullyFlat
      (A := Localization.Away f) h

/-! ### The height of a homogeneous prime is computed on the chart -/

/-- The isomorphism `laurentAwayEquiv : A₍f₎[T, T⁻¹] ≃ A[1/f]` is compatible with the algebra
maps from `A₍f₎`. -/
theorem laurentAwayEquiv_comp_algebraMap (hf : f ∈ 𝒜 1) :
    ((laurentAwayEquiv 𝒜 hf).toRingHom.comp
        (algebraMap (Away 𝒜 f) (LaurentPolynomial (Away 𝒜 f))))
      = algebraMap (Away 𝒜 f) (Localization.Away f) := by
  ext a
  exact laurentAwayEquiv_C 𝒜 hf a

/-- The extension of an ideal of the chart ring to `A[1/f]` has the same height as the ideal
itself, for `f` of degree one and a Noetherian chart ring. -/
theorem height_map_away_eq (hf : f ∈ 𝒜 1) [IsNoetherianRing (Away 𝒜 f)] (q : Ideal (Away 𝒜 f))
    [q.IsPrime] :
    (q.map (algebraMap (Away 𝒜 f) (Localization.Away f))).height = q.height := by
  have key : q.map (algebraMap (Away 𝒜 f) (Localization.Away f))
      = Ideal.map (laurentAwayEquiv 𝒜 hf)
          (q.map (algebraMap (Away 𝒜 f) (LaurentPolynomial (Away 𝒜 f)))) := by
    rw [← laurentAwayEquiv_comp_algebraMap 𝒜 hf, ← Ideal.map_map]
    rfl
  rw [key, RingEquiv.height_map, height_map_laurentPolynomial]

/-- For `f ∈ 𝒜 1` with `A₍f₎` Noetherian, the height of a homogeneous prime `p` of `A` with
`f ∉ p` equals the height of the contraction of `p · A[1/f]` to the degree-zero chart ring
`A₍f₎ = (A[1/f])₀`, the prime that the chart `D₊(f) ≅ Spec A₍f₎` assigns to `p`. -/
theorem height_eq_height_under_away (hf : f ∈ 𝒜 1) [IsNoetherianRing (Away 𝒜 f)] {p : Ideal A}
    (hp : p.IsHomogeneous 𝒜) [p.IsPrime] (hfp : f ∉ p) :
    p.height = ((p.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)).height := by
  have hdisj : Disjoint (Submonoid.powers f : Set A) (p : Set A) :=
    (Ideal.disjoint_powers_iff_notMem_of_isPrime f).mpr hfp
  have hP : (p.map (algebraMap A (Localization.Away f))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f)
      (Localization.Away f) p ‹_› hdisj
  have hq : ((p.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)).IsPrime :=
    Ideal.IsPrime.under _ _
  rw [← IsLocalization.height_map_of_disjoint (S := Localization.Away f)
      (Submonoid.powers f) p hdisj]
  conv_lhs => rw [map_eq_map_under_of_isHomogeneous 𝒜 hf hp]
  exact height_map_away_eq 𝒜 hf _

/-- For `f ∈ 𝒜 1` and `A` Noetherian, the height of a homogeneous prime `p` of `A` with `f ∉ p`
equals the height of the contraction of `p · A[1/f]` to the degree-zero chart ring `A₍f₎`. -/
theorem height_eq_height_under_away_of_isNoetherianRing [IsNoetherianRing A] (hf : f ∈ 𝒜 1)
    {p : Ideal A} (hp : p.IsHomogeneous 𝒜) [p.IsPrime] (hfp : f ∉ p) :
    p.height = ((p.map (algebraMap A (Localization.Away f))).under (Away 𝒜 f)).height :=
  have := isNoetherianRing_away_of_mem_degree_one 𝒜 hf
  height_eq_height_under_away 𝒜 hf hp hfp

end Stacks.GradedLaurent

end
