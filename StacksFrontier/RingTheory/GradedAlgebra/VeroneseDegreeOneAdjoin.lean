module

public import StacksFrontier.RingTheory.GradedAlgebra.Veronese
public import StacksFrontier.RingTheory.GradedAlgebra.VeroneseGrading
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The Veronese subring is generated by its degree-one part, as an algebra

`Stacks.Veronese.VeroneseGeneratedInDegOne 𝒜 d` says that for every `n ≥ 1` the `S₀`-module
`S_{nd}` is spanned by the `n`-fold products of elements of `S_d`, and
`Stacks.Veronese.veronese_generated_in_deg_one_of_finiteType` ([Stacks, Tag 0EGH]) establishes it
for all sufficiently divisible `d`. That is a statement about *spans of homogeneous pieces inside
`A`*. What every consumer of the Veronese reduction actually needs is the corresponding statement
about the graded ring `S⁽ᵈ⁾` itself,

`Algebra.adjoin (S⁽ᵈ⁾)₀ ((S⁽ᵈ⁾)₁) = ⊤`,

because that — with the grading `Stacks.Veronese.veroneseGrading 𝒜 d`, for which `(S⁽ᵈ⁾)₀ = S₀`
and `(S⁽ᵈ⁾)₁ = S_d` — is the form in which "generated in degree one over the degree-zero part" is
hypothesised throughout the `Proj` development. This file is that bridge.

The two are not the same statement and neither is a rewriting of the other: the first is an
equality of `S₀`-submodules of `A`, one piece at a time, and the second is an equality of
`S₀`-subalgebras of the subring `S⁽ᵈ⁾`, which has to be reached through the description of
`S⁽ᵈ⁾` as the additive closure of its homogeneous pieces
(`Stacks.Veronese.mem_veroneseSubring_iff`).

## Main results

* `Stacks.Veronese.adjoin_veroneseGrading_one_eq_top`: the bridge.
* `Stacks.Veronese.exists_forall_adjoin_veroneseGrading_one_eq_top`: the bridge with its
  hypothesis discharged for a finitely generated graded ring — for all sufficiently divisible `d`
  the Veronese subring is generated by its degree-one part over its degree-zero part.
* `Stacks.Veronese.exists_finite_degreeOne_generators_veroneseSubring`: the same generation by a
  *finite family* of elements of `S_d`, which is the shape the `Proj` development's degree-one
  hypothesis takes.
* `Stacks.Veronese.veroneseGradingZeroRingEquiv` and
  `Stacks.Veronese.isNoetherianRing_veroneseGrading_zero`: `(S⁽ᵈ⁾)₀ = S₀` as rings, and so
  `(S⁽ᵈ⁾)₀` is Noetherian when `S₀` is. This is the second standing hypothesis of that
  development, `IsNoetherianRing (𝒮 0)`, read on `S⁽ᵈ⁾`.

## Implementation notes

The induction is run on the *image* of the subalgebra in `A`, `Subring.map` of the inclusion
`S⁽ᵈ⁾ → A`, rather than on the subalgebra itself. Membership in `S⁽ᵈ⁾` is then not a side
condition that has to be carried through the `Submodule.span_induction`: the predicate is
membership in a subset of `A`, and the lift back to `S⁽ᵈ⁾` happens once, at the end, where
`Subtype.ext` identifies an element of the image with the element it came from.

A homogeneous element of degree `n · d` with `n = 0` lands in the degree-zero part and so in the
base of the adjunction; with `n ≥ 1` it is an `S₀`-combination of `n`-fold products of elements of
`S_d`, and each factor is a degree-one element of `S⁽ᵈ⁾`. Those are the only two cases, and the
split on `n` is where `VeroneseGeneratedInDegOne` is used — it says nothing at `n = 0`, where it
would be false for `d > 0` unless `S₀` were spanned by the empty product alone.

Positivity of `d` is never assumed. The grading of the Veronese subring enters only through the
hypothesis `[GradedRing (veroneseGrading 𝒜 d)]`, as in `VeroneseGrading.lean` and
`VeroneseAwayDegreeOne.lean`; positivity of `d` is what makes that hypothesis satisfiable, via
`Stacks.Veronese.veroneseGradingGradedRing`, and supplying it is the consumer's business.

## References

* [Stacks Project, Tag 0EGH](https://stacks.math.columbia.edu/tag/0EGH)
* [Stacks Project, Tag 0B5Q](https://stacks.math.columbia.edu/tag/0B5Q)
* [Stacks Project, Tag 0B5R](https://stacks.math.columbia.edu/tag/0B5R)
-/

@[expose] public noncomputable section

namespace Stacks.Veronese

variable {A : Type*} [CommRing A] {σ : Type*} [SetLike σ A] [AddSubgroupClass σ A]
variable (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- A degree-zero element of `A` is the image of an element of any subalgebra of `S⁽ᵈ⁾`. -/
private theorem exists_mem_subalgebra_of_mem_grade_zero (d : ℕ)
    (B : Subalgebra (veroneseGrading 𝒜 d 0) (veroneseSubring 𝒜 d)) {c : A} (hc : c ∈ 𝒜 0) :
    ∃ z : veroneseSubring 𝒜 d, z ∈ B ∧ (z : A) = c := by
  have hcV : c ∈ veroneseSubring 𝒜 d :=
    mem_veroneseSubring_of_mem 𝒜 (n := 0) (by rwa [Nat.zero_mul])
  have hc0 : (⟨c, hcV⟩ : veroneseSubring 𝒜 d) ∈ veroneseGrading 𝒜 d 0 := by
    rw [mem_veroneseGrading, Nat.zero_mul]
    exact hc
  exact ⟨⟨c, hcV⟩, Subalgebra.algebraMap_mem B (⟨⟨c, hcV⟩, hc0⟩ : veroneseGrading 𝒜 d 0), rfl⟩

/-- If a set `X ⊆ A` consists of images of elements of a subalgebra `B` of `S⁽ᵈ⁾` over `S₀`, so
does its `S₀`-span. -/
private theorem exists_mem_subalgebra_of_mem_span (d : ℕ)
    (B : Subalgebra (veroneseGrading 𝒜 d 0) (veroneseSubring 𝒜 d)) {X : Set A}
    (hX : ∀ x ∈ X, ∃ z : veroneseSubring 𝒜 d, z ∈ B ∧ (z : A) = x) {x : A}
    (hx : x ∈ Submodule.span (gradeZero 𝒜) X) :
    ∃ z : veroneseSubring 𝒜 d, z ∈ B ∧ (z : A) = x := by
  induction hx using Submodule.span_induction with
  | mem x hx => exact hX x hx
  | zero => exact ⟨0, zero_mem _, rfl⟩
  | add x y _ _ hx hy =>
      obtain ⟨z, hzB, rfl⟩ := hx
      obtain ⟨w, hwB, rfl⟩ := hy
      exact ⟨z + w, add_mem hzB hwB, rfl⟩
  | smul c x _ hx =>
      obtain ⟨z, hzB, rfl⟩ := hx
      obtain ⟨w, hwB, hw⟩ := exists_mem_subalgebra_of_mem_grade_zero 𝒜 d B c.2
      refine ⟨w * z, mul_mem hwB hzB, ?_⟩
      rw [Subring.coe_mul, hw]
      exact (Algebra.smul_def c _).symm

/-- **If the adjunction of a set already contains the whole degree-one part of `S⁽ᵈ⁾`, it is all
of `S⁽ᵈ⁾`.** This is the engine: `Stacks.Veronese.VeroneseGeneratedInDegOne` says each `S_{nd}`
with `n ≥ 1` is an `S₀`-span of `n`-fold products of elements of `S_d`, so once every element of
`S_d` is in the subalgebra so is every homogeneous piece, and `S⁽ᵈ⁾` is the additive closure of
those (`Stacks.Veronese.mem_veroneseSubring_iff`).

The induction runs on the *image* of the subalgebra in `A`, so membership in `S⁽ᵈ⁾` is not a side
condition carried through `Submodule.span_induction`; the lift back happens once, at the end. -/
public theorem adjoin_eq_top_of_forall_mem_grade (d : ℕ) [GradedRing (veroneseGrading 𝒜 d)]
    (h : VeroneseGeneratedInDegOne 𝒜 d) (s : Set (veroneseSubring 𝒜 d))
    (hs : ∀ v : veroneseSubring 𝒜 d, (v : A) ∈ 𝒜 d →
      v ∈ Algebra.adjoin (veroneseGrading 𝒜 d 0) s) :
    Algebra.adjoin (veroneseGrading 𝒜 d 0) s = ⊤ := by
  classical
  set B : Subalgebra (veroneseGrading 𝒜 d 0) (veroneseSubring 𝒜 d) :=
    Algebra.adjoin (veroneseGrading 𝒜 d 0) s with hB
  set Bimg : Subring A := B.toSubring.map (veroneseSubring 𝒜 d).subtype with hBimg
  have hmemBimg : ∀ a : A, a ∈ Bimg ↔ ∃ z : veroneseSubring 𝒜 d, z ∈ B ∧ (z : A) = a := by
    intro a
    simp only [hBimg, Subring.mem_map, Subalgebra.mem_toSubring, Subring.coe_subtype]
  -- a degree-zero element of `A` lifts into the base of the adjunction
  -- every homogeneous element of degree a multiple of `d` lies in the image
  have hhom : ∀ (n : ℕ) (a : A), a ∈ 𝒜 (n * d) → a ∈ Bimg := by
    intro n a ha
    rw [hmemBimg]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact exists_mem_subalgebra_of_mem_grade_zero 𝒜 d B (by rwa [Nat.zero_mul] at ha)
    · refine exists_mem_subalgebra_of_mem_span 𝒜 d B (X := degOneProducts 𝒜 d n) ?_ ?_
      · rintro x ⟨g, hg, rfl⟩
        have hgV : ∀ i, g i ∈ veroneseSubring 𝒜 d := fun i =>
          mem_veroneseSubring_of_mem 𝒜 (n := 1) (by rw [Nat.one_mul]; exact hg i)
        refine ⟨∏ i, (⟨g i, hgV i⟩ : veroneseSubring 𝒜 d), ?_, ?_⟩
        · exact Subalgebra.prod_mem B fun i _ => hs _ (hg i)
        · push_cast
          rfl
      · have hset := h n hn
        rw [Set.ext_iff] at hset
        exact (hset a).mp ha
  -- hence all of the Veronese subring lies in the image, and the lift back is the element itself
  have hall : ∀ a : A, a ∈ veroneseSubring 𝒜 d → a ∈ Bimg := by
    intro a ha
    refine AddSubgroup.closure_le Bimg.toAddSubgroup |>.mpr ?_
      ((mem_veroneseSubring_iff 𝒜 d).mp ha)
    intro x hx
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hx
    exact hhom n x hn
  refine le_antisymm le_top fun y _ => ?_
  obtain ⟨z, hzB, hz⟩ := (hmemBimg (y : A)).mp (hall (y : A) y.2)
  exact (Subtype.ext hz : z = y) ▸ hzB

/-- **The Veronese subring is generated as an `S₀`-algebra by its degree-one part**, as soon as
every `S_{nd}` with `n ≥ 1` is spanned over `S₀` by the `n`-fold products of elements of `S_d`.

This is `Stacks.Veronese.VeroneseGeneratedInDegOne` turned into the hypothesis
`Algebra.adjoin (𝒮 0) (𝒮 1) = ⊤` that the `Proj` development asks of a graded ring generated in
degree one, at the graded ring `S⁽ᵈ⁾`. -/
public theorem adjoin_veroneseGrading_one_eq_top (d : ℕ) [GradedRing (veroneseGrading 𝒜 d)]
    (h : VeroneseGeneratedInDegOne 𝒜 d) :
    Algebra.adjoin (veroneseGrading 𝒜 d 0)
        ((veroneseGrading 𝒜 d 1 : Set (veroneseSubring 𝒜 d))) = ⊤ :=
  adjoin_eq_top_of_forall_mem_grade 𝒜 d h _ fun v hv =>
    Algebra.subset_adjoin (by rw [SetLike.mem_coe, mem_veroneseGrading, Nat.one_mul]; exact hv)

/-- **The Veronese subring of a finitely generated graded ring is generated by its degree-one part
over its degree-zero part, for all sufficiently divisible `d`.** This is
`Stacks.Veronese.veronese_generated_in_deg_one_of_finiteType` ([Stacks, Tag 0EGH]) in the
algebra-generation form the `Proj` development consumes. -/
@[ega "II 2.1.6", ega "II 3.1.10" "partial"]
public theorem exists_forall_adjoin_veroneseGrading_one_eq_top
    (hfg : FinitelyGeneratedOverGradeZero 𝒜) :
    ∃ d₀ : ℕ, 1 ≤ d₀ ∧ ∀ d : ℕ, 1 ≤ d → d₀ ∣ d →
      ∀ _ : GradedRing (veroneseGrading 𝒜 d),
        Algebra.adjoin (veroneseGrading 𝒜 d 0)
          ((veroneseGrading 𝒜 d 1 : Set (veroneseSubring 𝒜 d))) = ⊤ := by
  obtain ⟨d₀, hd₀, hall⟩ := veronese_generated_in_deg_one_of_finiteType 𝒜 hfg
  refine ⟨d₀, hd₀, fun d hd hdvd inst => ?_⟩
  exact adjoin_veroneseGrading_one_eq_top 𝒜 d (h := hall d hd hdvd)


/-- **A homogeneous component of a graded ring of finite type is spanned over `S₀` by finitely
many of its own elements.** The monomials in a fixed set of homogeneous generators that have
weighted degree `k` span `S_k` (`Stacks.Veronese.mem_span_monomials`), and each of their exponents
is at most `k` because the generators have positive degree; projecting the resulting finite set
into degree `k` makes its members homogeneous without changing the span of what it has to reach. -/
@[ega "II 3.1.10" "partial"]
public theorem exists_finset_span_grade {r : ℕ} (f : Fin r → A) (deg : Fin r → ℕ)
    (hdeg : ∀ i, 1 ≤ deg i) (hfdeg : ∀ i, f i ∈ 𝒜 (deg i))
    (hgen : Algebra.adjoin (gradeZero 𝒜) (Set.range f) = ⊤) (k : ℕ) :
    ∃ t : Finset A, (∀ a ∈ t, a ∈ 𝒜 k) ∧
      (𝒜 k : Set A) ⊆ (Submodule.span (gradeZero 𝒜) (t : Set A) : Set A) := by
  classical
  set box : Finset A :=
    Finset.univ.image (fun e : Fin r → Fin (k + 1) => ∏ i, f i ^ (e i : ℕ)) with hbox
  set t : Finset A := box.image (GradedRing.proj 𝒜 k) with ht
  refine ⟨t, ?_, ?_⟩
  · intro a ha
    obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp ha
    rw [GradedRing.proj_apply]
    exact (DirectSum.decompose 𝒜 b k).2
  -- the degree-`k` projection carries the span of `box` into the span of `t`
  have hproj : ∀ x : A, x ∈ Submodule.span (gradeZero 𝒜) (box : Set A) →
      GradedRing.proj 𝒜 k x ∈ Submodule.span (gradeZero 𝒜) (t : Set A) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span (Finset.mem_image_of_mem _ hx)
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | smul c x _ hx =>
        have hc : GradedRing.proj 𝒜 k ((c : A) * x) = (c : A) * GradedRing.proj 𝒜 k x := by
          rw [GradedRing.proj_apply, GradedRing.proj_apply,
            DirectSum.coe_decompose_mul_of_left_mem 𝒜 k (SetLike.coe_mem c)]
          simp
        rw [show (c • x : A) = (c : A) * x from rfl, hc,
          show (c : A) * GradedRing.proj 𝒜 k x = c • GradedRing.proj 𝒜 k x from rfl]
        exact Submodule.smul_mem _ _ hx
  intro a ha
  have hbox' : a ∈ Submodule.span (gradeZero 𝒜) (box : Set A) := by
    refine Submodule.span_le.mpr ?_ (mem_span_monomials 𝒜 f deg hfdeg hgen k ha)
    rintro x ⟨e, hesum, rfl⟩
    have hle : ∀ i, e i < k + 1 := by
      intro i
      have h1 : e i * deg i ≤ ∑ j, e j * deg j :=
        Finset.single_le_sum (f := fun j => e j * deg j) (fun j _ => Nat.zero_le _)
          (Finset.mem_univ i)
      have h2 : e i ≤ e i * deg i := Nat.le_mul_of_pos_right _ (hdeg i)
      omega
    exact Submodule.subset_span
      (Finset.mem_coe.mpr (Finset.mem_image.mpr
        ⟨fun i => ⟨e i, hle i⟩, Finset.mem_univ _, rfl⟩))
  have := hproj a hbox'
  rwa [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 ha] at this

/-- **A finite family of degree-one generators of the Veronese subring.** For a graded ring with
finitely many homogeneous generators of positive degree, and a `d` for which the Veronese subring
is generated in degree one, there are finitely many elements of `S_d` generating `S⁽ᵈ⁾` as an
algebra over its degree-zero part.

This is the shape in which the `Proj` development hypothesises degree-one generation: a family
`x : Fin n → A` of degree-one elements with `Algebra.adjoin (𝒜 0) (Set.range x) = ⊤`, as in
`Stacks.ProjCoherentDegreeOne`. The set-level
`Stacks.Veronese.adjoin_veroneseGrading_one_eq_top` does not supply it, because the degree-one
part of `S⁽ᵈ⁾` is `S_d`, which is a whole homogeneous component rather than a finite family. -/
public theorem exists_finite_degreeOne_generators_veroneseSubring (d : ℕ)
    [GradedRing (veroneseGrading 𝒜 d)] {r : ℕ} (f : Fin r → A) (deg : Fin r → ℕ)
    (hdeg : ∀ i, 1 ≤ deg i) (hfdeg : ∀ i, f i ∈ 𝒜 (deg i))
    (hgen : Algebra.adjoin (gradeZero 𝒜) (Set.range f) = ⊤)
    (h : VeroneseGeneratedInDegOne 𝒜 d) :
    ∃ (n : ℕ) (y : Fin n → veroneseSubring 𝒜 d),
      (∀ i, y i ∈ veroneseGrading 𝒜 d 1) ∧
        Algebra.adjoin (veroneseGrading 𝒜 d 0) (Set.range y) = ⊤ := by
  classical
  obtain ⟨t, htmem, htspan⟩ := exists_finset_span_grade 𝒜 f deg hdeg hfdeg hgen d
  have hlift : ∀ b : {x // x ∈ t}, (b : A) ∈ veroneseSubring 𝒜 d := fun b =>
    mem_veroneseSubring_of_mem 𝒜 (n := 1) (by rw [Nat.one_mul]; exact htmem _ b.2)
  refine ⟨t.card, fun i => ⟨((t.equivFin.symm i : {x // x ∈ t}) : A),
    hlift (t.equivFin.symm i)⟩, fun i => ?_, ?_⟩
  · rw [mem_veroneseGrading, Nat.one_mul]
    exact htmem _ (t.equivFin.symm i).2
  refine adjoin_eq_top_of_forall_mem_grade 𝒜 d h _ fun v hv => ?_
  -- every element of `S_d` is an `S₀`-combination of the chosen family
  set B : Subalgebra (veroneseGrading 𝒜 d 0) (veroneseSubring 𝒜 d) :=
    Algebra.adjoin (veroneseGrading 𝒜 d 0)
      (Set.range fun i => (⟨((t.equivFin.symm i : {x // x ∈ t}) : A),
        hlift (t.equivFin.symm i)⟩ : veroneseSubring 𝒜 d)) with hB
  obtain ⟨z, hzB, hz⟩ := exists_mem_subalgebra_of_mem_span 𝒜 d B (X := (t : Set A))
    (fun x hx => ⟨⟨x, hlift ⟨x, hx⟩⟩, Algebra.subset_adjoin ⟨t.equivFin ⟨x, hx⟩, by simp⟩, rfl⟩)
    (htspan hv)
  exact (Subtype.ext hz : z = v) ▸ hzB

/-- **The degree-zero part of the Veronese subring is the degree-zero part of `A`.** Both are
carried by the same subset of `A` — the elements of `𝒜 0`, which lie in `S⁽ᵈ⁾` as the `n = 0`
homogeneous piece — and both inherit their ring structure from `A`, so the identity of `A`
restricts to a ring isomorphism between them.

The two are not the *same* type: `(S⁽ᵈ⁾)₀` is cut out inside the subring `S⁽ᵈ⁾` by
`Stacks.Veronese.veroneseGrading 𝒜 d 0`, whose membership condition is `x ∈ 𝒜 (0 * d)`, and
`0 * d` is `0` only propositionally. Everything stated about `𝒜 0` therefore has to be
transported, and this is the transport. -/
public def veroneseGradingZeroRingEquiv (d : ℕ) :
    veroneseGrading 𝒜 d 0 ≃+* 𝒜 0 where
  toFun x := ⟨(x : A), by
    have hx : ((x : veroneseSubring 𝒜 d) : A) ∈ 𝒜 (0 * d) := x.2
    rwa [Nat.zero_mul] at hx⟩
  invFun a := ⟨⟨(a : A), mem_veroneseSubring_of_mem 𝒜 (n := 0)
      (by rw [Nat.zero_mul]; exact a.2)⟩, by
    rw [mem_veroneseGrading, Nat.zero_mul]
    exact a.2⟩
  left_inv x := rfl
  right_inv a := rfl
  map_mul' x y := rfl
  map_add' x y := rfl

/-- **The degree-zero part of the Veronese subring is Noetherian when that of `A` is.** The
degree-one machinery of the `Proj` development asks for `IsNoetherianRing (𝒮 0)` of the graded
ring it is run on, and run on `S⁽ᵈ⁾` that is this statement; the two degree-zero parts are the
same ring, by `Stacks.Veronese.veroneseGradingZeroRingEquiv`. -/
public theorem isNoetherianRing_veroneseGrading_zero (d : ℕ) [IsNoetherianRing (𝒜 0)] :
    IsNoetherianRing (veroneseGrading 𝒜 d 0) :=
  isNoetherianRing_of_ringEquiv (𝒜 0) (veroneseGradingZeroRingEquiv 𝒜 d).symm

end Stacks.Veronese

end
