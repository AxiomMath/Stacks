module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.GradedAlgebra.Examples.WeightedPolynomial

/-!
# The degree-zero ring of the weighted polynomial algebra

Let `S = k[x, y, z]` with `deg x = 1`, `deg y = 2`, `deg z = 3`. The degree-zero part of the
localization of `S` at `z` is generated by the three fractions

`u = x³/z`,  `v = xy/z`,  `w = y³/z²`,

and the single relation `u w = v³` is the only relation between them: the induced map

`k[X₀, X₁, X₂] / (X₀ X₂ - X₁³) → S₍z₎`,  `X₀ ↦ u`,  `X₁ ↦ v`,  `X₂ ↦ w`

is an isomorphism of `k`-algebras. In particular `Proj S` has a standard affine open which is
not smooth, the affine cone over it being the quadric cone `uw = v³`.

## Main definitions

* `Stacks.WeightedPolynomial.cubicRelationIdeal`: the ideal `(X₀ X₂ - X₁³)`.
* `Stacks.WeightedPolynomial.degreeZeroRingEquiv`: the presentation of `S₍z₎` as the quotient
  of `k[X₀, X₁, X₂]` by that ideal.

## Main results

* `Stacks.WeightedPolynomial.degreeZeroRingEquiv_mk_X`: the presentation carries the three
  variables to `u`, `v` and `w`.

## Implementation notes

The isomorphism carries both halves of the source's assertion: surjectivity says that `u`, `v`
and `w` generate `S₍z₎`, and injectivity says that `uw = v³` generates all their relations.
Fixing the images of the variables, which is `degreeZeroRingEquiv_mk_X`, is what makes the
isomorphism the canonical presentation associated to those three fractions rather than an
unspecified one.

Surjectivity uses `HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top`: `S₍z₎` is generated
over `S₀` by the fractions `∏ Xᵢ^{aᵢ} / zᵃ` with each exponent at most `deg z = 3`, and
`toricExponentLift` rewrites the exponent vector of such a fraction as a product of powers of
`u`, `v`, `w`.

Injectivity is proved by comparing both sides with the polynomial ring in two variables. The
`k`-algebra map `specialize : S₍z₎ → k[X₀, X₁]` is evaluation at `z = 1`; it is injective
because a weighted homogeneous polynomial is determined by its specialization, the `z`-exponent
being recoverable from the weight. On the quotient side the composite is the *toric map*
`X₀ ↦ X₀³`, `X₁ ↦ X₀X₁`, `X₂ ↦ X₁³`, which is injective on the quotient because every class has
a representative whose monomials are *canonical* — no monomial divisible by both `X₀` and `X₂`,
the relation being used to replace `X₀X₂` by `X₁³` — and on canonical monomials the exponent map
`(a₀, a₁, a₂) ↦ (3a₀ + a₁, a₁ + 3a₂)` is injective.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
-/

@[expose] public noncomputable section

universe u

namespace Stacks.WeightedPolynomial

/-! ### The relation ideal and the toric comparison map -/

/-- The ideal generated by the relation `X₀ X₂ - X₁³` in the polynomial algebra on three
variables. -/
public def cubicRelationIdeal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Fin 3) k) :=
  Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 3}

/-- A monomial in three variables, written out as a product of powers. -/
lemma monomial_fin3_eq {k : Type*} [CommSemiring k] (d : Fin 3 →₀ ℕ) (c : k) :
    MvPolynomial.monomial d c = MvPolynomial.C c *
      MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1 * MvPolynomial.X 2 ^ d 2 := by
  have hd : d = Finsupp.single 0 (d 0) + Finsupp.single 1 (d 1) + Finsupp.single 2 (d 2) := by
    ext i
    fin_cases i <;> simp
  rw [MvPolynomial.monomial_eq, hd,
    Finsupp.prod_add_index' (fun _ => by simp) (fun _ _ _ => by simp [pow_add]),
    Finsupp.prod_add_index' (fun _ => by simp) (fun _ _ _ => by simp [pow_add]),
    Finsupp.prod_single_index (by simp), Finsupp.prod_single_index (by simp),
    Finsupp.prod_single_index (by simp)]
  simp
  ring

/-- A monomial in two variables, written out as a product of powers. -/
lemma monomial_fin2_eq {k : Type*} [CommSemiring k] (d : Fin 2 →₀ ℕ) (c : k) :
    MvPolynomial.monomial d c = MvPolynomial.C c *
      MvPolynomial.X 0 ^ d 0 * MvPolynomial.X 1 ^ d 1 := by
  have hd : d = Finsupp.single 0 (d 0) + Finsupp.single 1 (d 1) := by
    ext i
    fin_cases i <;> simp
  rw [MvPolynomial.monomial_eq, hd,
    Finsupp.prod_add_index' (fun _ => by simp) (fun _ _ _ => by simp [pow_add]),
    Finsupp.prod_single_index (by simp), Finsupp.prod_single_index (by simp)]
  simp
  ring

/-- The toric map `X₀ ↦ X₀³`, `X₁ ↦ X₀X₁`, `X₂ ↦ X₁³` into the polynomial algebra on two
variables; it kills the relation `X₀X₂ - X₁³`. -/
def toricMap (k : Type u) [CommRing k] :
    MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
  MvPolynomial.aeval ![MvPolynomial.X 0 ^ 3,
    MvPolynomial.X 0 * MvPolynomial.X 1, MvPolynomial.X 1 ^ 3]

/-- The effect of the toric map on exponent vectors. -/
def exponentImage (d : Fin 3 →₀ ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 (3 * d 0 + d 1) + Finsupp.single 1 (d 1 + 3 * d 2)

/-- The canonical representative of an exponent vector modulo the relation: cancel the common
powers of `X₀` and `X₂` against `X₁³`. -/
def normalizedExponent (d : Fin 3 →₀ ℕ) : Fin 3 →₀ ℕ :=
  let m := min (d 0) (d 2)
  Finsupp.single 0 (d 0 - m) + Finsupp.single 1 (d 1 + 3 * m) + Finsupp.single 2 (d 2 - m)

/-- The `X₀`-exponent of `normalizedExponent d` is `d 0 - min (d 0) (d 2)`. -/
lemma normalizedExponent_apply0 (d : Fin 3 →₀ ℕ) :
    normalizedExponent d 0 = d 0 - min (d 0) (d 2) := by
  simp [normalizedExponent, Finsupp.add_apply]

/-- The `X₁`-exponent of `normalizedExponent d` is `d 1 + 3 * min (d 0) (d 2)`. -/
lemma normalizedExponent_apply1 (d : Fin 3 →₀ ℕ) :
    normalizedExponent d 1 = d 1 + 3 * min (d 0) (d 2) := by
  simp [normalizedExponent, Finsupp.add_apply]

/-- The `X₂`-exponent of `normalizedExponent d` is `d 2 - min (d 0) (d 2)`. -/
lemma normalizedExponent_apply2 (d : Fin 3 →₀ ℕ) :
    normalizedExponent d 2 = d 2 - min (d 0) (d 2) := by
  simp [normalizedExponent, Finsupp.add_apply]

/-- A normalized exponent vector is canonical: it is not divisible by both `X₀` and `X₂`. -/
lemma normalizedExponent_canonical (d : Fin 3 →₀ ℕ) :
    normalizedExponent d 0 = 0 ∨ normalizedExponent d 2 = 0 := by
  by_cases h : d 0 ≤ d 2
  · left
    simp [normalizedExponent, Finsupp.add_apply, min_eq_left h]
  · right
    have h' : d 2 ≤ d 0 := by omega
    simp [normalizedExponent, Finsupp.add_apply, min_eq_right h']

/-- On canonical exponent vectors the toric exponent map is injective. -/
lemma exponentImage_injective_of_canonical {d e : Fin 3 →₀ ℕ}
    (hd : d 0 = 0 ∨ d 2 = 0) (he : e 0 = 0 ∨ e 2 = 0)
    (h : exponentImage d = exponentImage e) : d = e := by
  have h0 : 3 * d 0 + d 1 = 3 * e 0 + e 1 := by
    have := congrArg (fun x : Fin 2 →₀ ℕ => x 0) h
    simpa [exponentImage, Finsupp.add_apply, Finsupp.single_apply] using this
  have h1 : d 1 + 3 * d 2 = e 1 + 3 * e 2 := by
    have := congrArg (fun x : Fin 2 →₀ ℕ => x 1) h
    simpa [exponentImage, Finsupp.add_apply, Finsupp.single_apply] using this
  ext i
  fin_cases i
  · change d 0 = e 0
    rcases hd with hd | hd <;> rcases he with he | he <;> omega
  · change d 1 = e 1
    omega
  · change d 2 = e 2
    rcases hd with hd | hd <;> rcases he with he | he <;> omega

/-- The toric map sends the monomial with exponent vector `d` to the monomial with exponent
vector `exponentImage d` and the same coefficient. -/
lemma toricMap_monomial (k : Type u) [CommRing k] (d : Fin 3 →₀ ℕ) (c : k) :
    toricMap k (MvPolynomial.monomial d c) = MvPolynomial.monomial (exponentImage d) c := by
  rw [monomial_fin3_eq, monomial_fin2_eq]
  simp [toricMap, MvPolynomial.aeval_X]
  simp [exponentImage, Finsupp.add_apply, ← pow_mul, mul_pow]
  ring_nf

/-- Modulo the relation, a monomial equals its normalized monomial. -/
lemma quotient_monomial_normal (k : Type u) [CommRing k] (d : Fin 3 →₀ ℕ) (c : k) :
    Ideal.Quotient.mk (cubicRelationIdeal k) (MvPolynomial.monomial d c) =
      Ideal.Quotient.mk (cubicRelationIdeal k)
        (MvPolynomial.monomial (normalizedExponent d) c) := by
  let Q := MvPolynomial (Fin 3) k ⧸ cubicRelationIdeal k
  let U : Q := Ideal.Quotient.mk _ (MvPolynomial.X 0)
  let V : Q := Ideal.Quotient.mk _ (MvPolynomial.X 1)
  let W : Q := Ideal.Quotient.mk _ (MvPolynomial.X 2)
  let Cc : Q := algebraMap k Q c
  let m : ℕ := min (d 0) (d 2)
  have hrel : U * W = V ^ 3 := by
    have hzero : Ideal.Quotient.mk (cubicRelationIdeal k)
        (MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 3) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    dsimp [U, V, W] at hzero ⊢
    exact sub_eq_zero.mp hzero
  have hpow : U ^ m * W ^ m = V ^ (3 * m) := by rw [← mul_pow, hrel, ← pow_mul]
  have hm0 : m ≤ d 0 := Nat.min_le_left _ _
  have hm2 : m ≤ d 2 := Nat.min_le_right _ _
  rw [monomial_fin3_eq, monomial_fin3_eq]
  simp only [map_mul, map_pow]
  rw [normalizedExponent_apply0, normalizedExponent_apply1, normalizedExponent_apply2]
  change Cc * U ^ d 0 * V ^ d 1 * W ^ d 2 =
    Cc * U ^ (d 0 - m) * V ^ (d 1 + 3 * m) * W ^ (d 2 - m)
  have hU : U ^ d 0 = U ^ (d 0 - m) * U ^ m := by rw [← pow_add, Nat.sub_add_cancel hm0]
  have hW : W ^ d 2 = W ^ (d 2 - m) * W ^ m := by rw [← pow_add, Nat.sub_add_cancel hm2]
  rw [hU, hW, pow_add V, ← hpow]
  ring

/-- The canonical representative of a polynomial modulo the relation. -/
def normalizePolynomial (k : Type u) [CommRing k] (p : MvPolynomial (Fin 3) k) :
    MvPolynomial (Fin 3) k :=
  ∑ d ∈ p.support, MvPolynomial.monomial (normalizedExponent d) (p.coeff d)

/-- Modulo the relation, a polynomial equals its canonical representative. -/
lemma quotient_mk_normalize (k : Type u) [CommRing k] (p : MvPolynomial (Fin 3) k) :
    Ideal.Quotient.mk (cubicRelationIdeal k) p =
      Ideal.Quotient.mk (cubicRelationIdeal k) (normalizePolynomial k p) := by
  conv_lhs => rw [p.as_sum]
  simp only [normalizePolynomial, map_sum]
  exact Finset.sum_congr rfl fun d _ => quotient_monomial_normal k d (p.coeff d)

/-- Every monomial of the canonical representative of a polynomial is canonical: it is not
divisible by both `X₀` and `X₂`. -/
lemma normalizePolynomial_canonical (k : Type u) [CommRing k]
    (p : MvPolynomial (Fin 3) k) (d : Fin 3 →₀ ℕ)
    (hd : d ∈ (normalizePolynomial k p).support) : d 0 = 0 ∨ d 2 = 0 := by
  have hd' : d ∈ p.support.biUnion fun e =>
      (MvPolynomial.monomial (normalizedExponent e) (p.coeff e)).support :=
    MvPolynomial.support_sum hd
  rcases Finset.mem_biUnion.mp hd' with ⟨e, _, hde⟩
  have hde' : d = normalizedExponent e :=
    Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hde)
  rw [hde']
  exact normalizedExponent_canonical e

/-- An algebra map sending monomials to monomials by an injective-on-the-support exponent map
kills only the zero polynomial. -/
private theorem eq_zero_of_map_monomial_of_injOn {k σ τ : Type*} [CommRing k]
    (f : MvPolynomial σ k →ₐ[k] MvPolynomial τ k) (g : (σ →₀ ℕ) → (τ →₀ ℕ))
    (hf : ∀ d c, f (MvPolynomial.monomial d c) = MvPolynomial.monomial (g d) c)
    (p : MvPolynomial σ k) (hg : Set.InjOn g p.support) (h : f p = 0) : p = 0 := by
  classical
  ext d
  by_cases hd : d ∈ p.support
  · have hcoeff : (f p).coeff (g d) = p.coeff d := by
      conv_lhs => rw [p.as_sum]
      rw [map_sum, MvPolynomial.coeff_sum, Finset.sum_eq_single d]
      · simp [hf, MvPolynomial.coeff_monomial]
      · intro e he hne
        have hge : g e ≠ g d := fun heq => hne (hg he hd heq)
        simp [hf, MvPolynomial.coeff_monomial, hge]
      · exact fun hnot => (hnot hd).elim
    simpa [h] using hcoeff.symm
  · simpa using hd

/-- A polynomial whose monomials are all canonical and which the toric map kills is zero. -/
lemma toricMap_injective_on_canonical (k : Type u) [CommRing k]
    (p : MvPolynomial (Fin 3) k) (hp : ∀ d ∈ p.support, d 0 = 0 ∨ d 2 = 0)
    (h : toricMap k p = 0) : p = 0 :=
  eq_zero_of_map_monomial_of_injOn (toricMap k) exponentImage (toricMap_monomial k) p
    (fun e he d hd heq => exponentImage_injective_of_canonical (hp e he) (hp d hd) heq) h

/-- The toric map kills the relation `X₀X₂ - X₁³`. -/
lemma toricRelation_maps_to_zero (k : Type u) [CommRing k] :
    toricMap k (MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 3) = 0 := by
  simp [toricMap, MvPolynomial.aeval_X]
  ring

/-- A ring map killing `X₀X₂ - X₁³` kills the ideal it generates. -/
private theorem cubicRelationIdeal_le_ker_of {k R : Type*} [CommRing k] [CommRing R]
    (f : MvPolynomial (Fin 3) k →+* R)
    (h : f (MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 3) = 0) :
    cubicRelationIdeal k ≤ RingHom.ker f := by
  rw [cubicRelationIdeal, Ideal.span_le, Set.singleton_subset_iff]
  exact RingHom.mem_ker.mpr h

/-- The ideal `(X₀X₂ - X₁³)` lies in the kernel of the toric map. -/
lemma toricRelationIdeal_le_ker (k : Type u) [CommRing k] :
    cubicRelationIdeal k ≤ RingHom.ker
      (↑(toricMap k) : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k) :=
  cubicRelationIdeal_le_ker_of _ (toricRelation_maps_to_zero k)

/-- The toric map, descended to the quotient by the relation. -/
def toricMapQuotient (k : Type u) [CommRing k] :
    (MvPolynomial (Fin 3) k ⧸ cubicRelationIdeal k) →ₐ[k] MvPolynomial (Fin 2) k :=
  Ideal.Quotient.liftₐ (cubicRelationIdeal k) (toricMap k)
    (fun _ hp => RingHom.mem_ker.mp (toricRelationIdeal_le_ker k hp))

/-- The descended toric map sends the class of `p` to the image of `p` under the toric map. -/
lemma toricMapQuotient_mk (k : Type u) [CommRing k] (p : MvPolynomial (Fin 3) k) :
    toricMapQuotient k (Ideal.Quotient.mk (cubicRelationIdeal k) p) = toricMap k p := by
  have hcomp := Ideal.Quotient.liftₐ_comp (cubicRelationIdeal k) (toricMap k)
    (fun _ hp => RingHom.mem_ker.mp (toricRelationIdeal_le_ker k hp))
  have h := congrArg (fun f : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k => f p) hcomp
  simpa [toricMapQuotient] using h

/-- The toric map is injective on the quotient by the relation `X₀X₂ - X₁³`. -/
lemma toricMapQuotient_injective (k : Type u) [CommRing k] :
    Function.Injective (toricMapQuotient k) := by
  intro x y hxy
  have hzero : toricMapQuotient k (x - y) = 0 := by simp [hxy]
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (x - y)
  have htoric : toricMap k p = 0 := by
    rw [← hp, toricMapQuotient_mk k p] at hzero
    exact hzero
  have hnormal : toricMap k (normalizePolynomial k p) = 0 := by
    have hq := congrArg (toricMapQuotient k) (quotient_mk_normalize k p)
    rw [toricMapQuotient_mk k p, toricMapQuotient_mk k (normalizePolynomial k p)] at hq
    exact hq.symm.trans htoric
  have hnorm : normalizePolynomial k p = 0 :=
    toricMap_injective_on_canonical k (normalizePolynomial k p)
      (normalizePolynomial_canonical k p) hnormal
  rw [← sub_eq_zero, ← hp, quotient_mk_normalize k p, hnorm, map_zero]

/-- An exponent vector of weight divisible by three is a combination of the exponent vectors of
`u`, `v` and `w`. -/
lemma toricExponentLift (a b t : ℕ) (h : a + 2 * b = 3 * t) :
    ∃ A B C : ℕ, 3 * A + B = a ∧ B + 3 * C = b ∧ A + B + 2 * C = t := by
  by_cases hab : a ≤ b
  · let C := (b - a) / 3
    have hdiv : 3 ∣ b - a := by omega
    have hC : 3 * C = b - a := by
      dsimp [C]
      simpa [Nat.mul_comm] using Nat.div_mul_cancel hdiv
    exact ⟨0, a, C, by simp, by omega, by omega⟩
  · have hba : b ≤ a := by omega
    let A := (a - b) / 3
    have hdiv : 3 ∣ a - b := by omega
    have hA : 3 * A = a - b := by
      dsimp [A]
      simpa [Nat.mul_comm] using Nat.div_mul_cancel hdiv
    exact ⟨A, b, 0, by omega, by simp, by omega⟩

/-! ### The presentation of the degree-zero ring -/

/-- The `k`-algebra map `k[X₀, X₁, X₂] → S₍z₎` sending the variables to `u`, `v`, `w`. -/
def presentationMap (E : WeightedPolynomialSituation) :
    MvPolynomial (Fin 3) E.k →ₐ[E.k] E.R :=
  MvPolynomial.aeval ![E.u, E.v, E.w]

/-- The presentation map sends the variables `X₀`, `X₁`, `X₂` to `u`, `v`, `w`. -/
lemma presentationMap_X (E : WeightedPolynomialSituation) (i : Fin 3) :
    presentationMap E (MvPolynomial.X i) = ![E.u, E.v, E.w] i := by simp [presentationMap]

/-- In the localization `S_z`, the element `u` is the fraction `x³/z`. -/
lemma val_u (E : WeightedPolynomialSituation) :
    HomogeneousLocalization.val E.u =
      Localization.mk (E.x ^ 3) ⟨E.z, Submonoid.mem_powers E.z⟩ := by
  unfold WeightedPolynomialSituation.u
  simpa [pow_one] using
    (HomogeneousLocalization.Away.val_mk E.naturalGrading (f := E.z) 1
      (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) (E.x ^ 3) (by
        change MvPolynomial.IsWeightedHomogeneous E.naturalWeight (E.x ^ 3)
          (1 • E.naturalWeight 2)
        simpa [WeightedPolynomialSituation.naturalWeight, WeightedPolynomialSituation.x] using
          (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 0).pow 3))

/-- In the localization `S_z`, the element `v` is the fraction `xy/z`. -/
lemma val_v (E : WeightedPolynomialSituation) :
    HomogeneousLocalization.val E.v =
      Localization.mk (E.x * E.y) ⟨E.z, Submonoid.mem_powers E.z⟩ := by
  unfold WeightedPolynomialSituation.v
  simpa [pow_one] using
    (HomogeneousLocalization.Away.val_mk E.naturalGrading (f := E.z) 1
      (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) (E.x * E.y) (by
        change MvPolynomial.IsWeightedHomogeneous E.naturalWeight (E.x * E.y)
          (1 • E.naturalWeight 2)
        simpa [WeightedPolynomialSituation.naturalWeight, WeightedPolynomialSituation.x,
          WeightedPolynomialSituation.y] using
          (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 0).mul
            (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 1)))

/-- In the localization `S_z`, the element `w` is the fraction `y³/z²`. -/
lemma val_w (E : WeightedPolynomialSituation) :
    HomogeneousLocalization.val E.w =
      Localization.mk (E.y ^ 3)
        ⟨E.z ^ 2, Submonoid.pow_mem _ (Submonoid.mem_powers E.z) 2⟩ := by
  unfold WeightedPolynomialSituation.w
  exact HomogeneousLocalization.Away.val_mk E.naturalGrading (f := E.z) 2
    (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) (E.y ^ 3) (by
      change MvPolynomial.IsWeightedHomogeneous E.naturalWeight (E.y ^ 3)
        (2 • E.naturalWeight 2)
      simpa [WeightedPolynomialSituation.naturalWeight, WeightedPolynomialSituation.y] using
        (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 1).pow 3)

/-- Evaluation at `z = 1`, as a map out of `S`. -/
def evalAtZOne (E : WeightedPolynomialSituation) :
    E.S →ₐ[E.k] MvPolynomial (Fin 2) E.k :=
  MvPolynomial.aeval ![MvPolynomial.X 0, MvPolynomial.X 1, 1]

/-- Evaluation at `z = 1`, as a map out of the ordinary localization `S_z`. -/
noncomputable def evalAtZOneLocalization (E : WeightedPolynomialSituation) :
    E.ordinaryLocalization →+* MvPolynomial (Fin 2) E.k :=
  Localization.awayLift (evalAtZOne E).toRingHom E.z
    (isUnit_iff_exists_inv.mpr ⟨1, by simp [evalAtZOne]⟩)

/-- Evaluation at `z = 1`, restricted to the degree-zero localization `S₍z₎`. -/
def specialize (E : WeightedPolynomialSituation) :
    E.R →+* MvPolynomial (Fin 2) E.k :=
  (evalAtZOneLocalization E).comp (algebraMap E.R E.ordinaryLocalization)

/-- Evaluation at `z = 1` sends the fraction `a/zⁿ` to the evaluation of `a` at `z = 1`. -/
lemma evalAtZOneLocalization_mk (E : WeightedPolynomialSituation) (a : E.S) (n : ℕ) :
    evalAtZOneLocalization E
        (Localization.mk a ⟨E.z ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers E.z) n⟩) =
      evalAtZOne E a := by
  rw [evalAtZOneLocalization]
  convert Localization.awayLift_mk (evalAtZOne E).toRingHom E.z a 1
    (by simp [evalAtZOne]) n using 1
  simp [evalAtZOne]

/-- Evaluation at `z = 1` sends `u` to `X₀³`. -/
lemma specialize_u (E : WeightedPolynomialSituation) :
    specialize E E.u = MvPolynomial.X 0 ^ 3 := by
  change evalAtZOneLocalization E (HomogeneousLocalization.val E.u) = _
  rw [val_u]
  convert evalAtZOneLocalization_mk E (E.x ^ 3) 1 using 1 <;> simp [evalAtZOne]

/-- Evaluation at `z = 1` sends `v` to `X₀X₁`. -/
lemma specialize_v (E : WeightedPolynomialSituation) :
    specialize E E.v = MvPolynomial.X 0 * MvPolynomial.X 1 := by
  change evalAtZOneLocalization E (HomogeneousLocalization.val E.v) = _
  rw [val_v]
  convert evalAtZOneLocalization_mk E (E.x * E.y) 1 using 1 <;> simp [evalAtZOne]

/-- Evaluation at `z = 1` sends `w` to `X₁³`. -/
lemma specialize_w (E : WeightedPolynomialSituation) :
    specialize E E.w = MvPolynomial.X 1 ^ 3 := by
  change evalAtZOneLocalization E (HomogeneousLocalization.val E.w) = _
  rw [val_w]
  convert evalAtZOneLocalization_mk E (E.y ^ 3) 2 using 1
  simp [evalAtZOne]

/-- The relation `uw = v³` holds in `S₍z₎`. -/
lemma cubic_relation_maps_to_zero (E : WeightedPolynomialSituation) :
    presentationMap E (MvPolynomial.X 0 * MvPolynomial.X 2 - MvPolynomial.X 1 ^ 3) = 0 := by
  simp only [map_sub, map_mul, map_pow, presentationMap_X]
  change E.u * E.w - E.v ^ 3 = 0
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.val_mul,
    HomogeneousLocalization.val_pow, val_u, val_v, val_w, Localization.mk_mul,
    Localization.mk_pow]
  have hd : (⟨E.z, Submonoid.mem_powers E.z⟩ : Submonoid.powers E.z) *
        ⟨E.z ^ 2, Submonoid.pow_mem _ (Submonoid.mem_powers E.z) 2⟩ =
      (⟨E.z, Submonoid.mem_powers E.z⟩ : Submonoid.powers E.z) ^ 3 := by
    apply Subtype.ext
    change E.z * E.z ^ 2 = E.z ^ 3
    ring
  have hn : E.x ^ 3 * E.y ^ 3 = (E.x * E.y) ^ 3 := by ring
  rw [hd, hn, sub_self]
  simp

/-- The exponent vector of `x` and `y` in a monomial of `S`. -/
def exponentPair (d : Fin 3 →₀ ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 (d 0) + Finsupp.single 1 (d 1)

/-- The weight of an exponent vector `d` for `deg x = 1`, `deg y = 2`, `deg z = 3` is
`d 0 + 2 * d 1 + 3 * d 2`. -/
lemma naturalWeight_weight (E : WeightedPolynomialSituation) (d : Fin 3 →₀ ℕ) :
    Finsupp.weight E.naturalWeight d = d 0 + 2 * d 1 + 3 * d 2 := by
  simp [Finsupp.weight_eq_sum, WeightedPolynomialSituation.naturalWeight,
    Fin.sum_univ_succ]
  ring

/-- A degree-zero element of `S` is a constant. -/
lemma degreeZeroCoefficient (E : WeightedPolynomialSituation) (p : E.naturalGrading 0) :
    ∃ c : E.k, (p : E.S) = MvPolynomial.C c := by
  let q : E.S := p
  have hq : q ∈ E.naturalGrading 0 := p.property
  have hh : q.IsWeightedHomogeneous E.naturalWeight 0 :=
    (MvPolynomial.mem_weightedHomogeneousSubmodule _ _ _ q).mp hq
  refine ⟨q.coeff 0, ?_⟩
  apply MvPolynomial.ext
  intro d
  by_cases hd : d = 0
  · subst d
    simp [q]
  · have hcoeff : q.coeff d = 0 := by
      by_contra hc
      have hw := hh hc
      have hw' : d 0 + 2 * d 1 + 3 * d 2 = 0 := by
        rw [naturalWeight_weight E d] at hw
        exact hw
      have hz : d = 0 := by
        ext i
        fin_cases i <;> simp at * <;> omega
      exact hd hz
    have hd' : 0 ≠ d := fun h => hd h.symm
    simp [q, hd', hcoeff]

/-- A degree-zero element of `S` equal to the constant `C c` maps to the image of `c` in `S₍z₎`. -/
lemma degreeZeroScalar (E : WeightedPolynomialSituation) (p : E.naturalGrading 0)
    (c : E.k) (hp : (p : E.S) = MvPolynomial.C c) :
    algebraMap (E.naturalGrading 0) E.R p = algebraMap E.k E.R c := by
  have hc : MvPolynomial.C c ∈ E.naturalGrading 0 :=
    (MvPolynomial.mem_weightedHomogeneousSubmodule _ _ _ _).2
      (MvPolynomial.isWeightedHomogeneous_C E.naturalWeight c)
  let pc : E.naturalGrading 0 := ⟨MvPolynomial.C c, hc⟩
  have hpc : p = pc := Subtype.ext hp
  have hscalar : algebraMap E.k (E.naturalGrading 0) c = pc := by
    apply Subtype.ext
    rfl
  rw [hpc, ← hscalar]
  rfl

/-- Evaluation at `z = 1` sends the monomial with exponent vector `d` to the monomial in `x`, `y`
with exponent vector `exponentPair d` and the same coefficient. -/
lemma evalAtZOne_monomial (E : WeightedPolynomialSituation) (d : Fin 3 →₀ ℕ)
    (c : E.k) :
    evalAtZOne E (MvPolynomial.monomial d c) =
      MvPolynomial.monomial (exponentPair d) c := by
  rw [monomial_fin3_eq, monomial_fin2_eq]
  simp [evalAtZOne, exponentPair, MvPolynomial.aeval_X, Finsupp.add_apply]

/-- A weighted homogeneous polynomial killed by evaluation at `z = 1` is zero: its
`z`-exponent is determined by the weight and the exponents of `x` and `y`. -/
lemma evalAtZOne_injective_on_homogeneous (E : WeightedPolynomialSituation)
    (p : MvPolynomial (Fin 3) E.k) (D : ℕ) (hp : p.IsWeightedHomogeneous E.naturalWeight D)
    (hz : evalAtZOne E p = 0) : p = 0 := by
  refine eq_zero_of_map_monomial_of_injOn (evalAtZOne E) exponentPair
    (evalAtZOne_monomial E) p (fun e he d hd hpair => ?_) hz
  have h0 : e 0 = d 0 := by simpa [exponentPair] using DFunLike.congr_fun hpair 0
  have h1 : e 1 = d 1 := by simpa [exponentPair] using DFunLike.congr_fun hpair 1
  have hw : e 0 + 2 * e 1 + 3 * e 2 = d 0 + 2 * d 1 + 3 * d 2 := by
    rw [← naturalWeight_weight E e, ← naturalWeight_weight E d,
      hp (Finsupp.mem_support_iff.mp he), hp (Finsupp.mem_support_iff.mp hd)]
  ext i
  fin_cases i <;> simp [h0, h1, show e 2 = d 2 by omega]

/-- The ideal `(X₀X₂ - X₁³)` lies in the kernel of the presentation map. -/
lemma cubicRelationIdeal_le_ker (E : WeightedPolynomialSituation) :
    cubicRelationIdeal E.k ≤ RingHom.ker (presentationMap E).toRingHom :=
  cubicRelationIdeal_le_ker_of _ (cubic_relation_maps_to_zero E)

/-- The presentation map, descended to the quotient by the relation. -/
noncomputable def degreeZeroRingMap (E : WeightedPolynomialSituation) :
    (MvPolynomial (Fin 3) E.k ⧸ cubicRelationIdeal E.k) →ₐ[E.k] E.R :=
  Ideal.Quotient.liftₐ (cubicRelationIdeal E.k) (presentationMap E)
    (fun _ hp => RingHom.mem_ker.mp (cubicRelationIdeal_le_ker E hp))

/-- The descended presentation map sends the class of `p` to the image of `p` under the
presentation map. -/
lemma degreeZeroRingMap_quotient_mk (E : WeightedPolynomialSituation)
    (p : MvPolynomial (Fin 3) E.k) :
    degreeZeroRingMap E (Ideal.Quotient.mk (cubicRelationIdeal E.k) p) =
      presentationMap E p := by
  have hcomp := Ideal.Quotient.liftₐ_comp (cubicRelationIdeal E.k) (presentationMap E)
    (fun _ hp => RingHom.mem_ker.mp (cubicRelationIdeal_le_ker E hp))
  have h := congrArg (fun f : MvPolynomial (Fin 3) E.k →ₐ[E.k] E.R => f p) hcomp
  simpa [degreeZeroRingMap] using h

/-- The presentation map followed by evaluation at `z = 1` is the toric map. -/
lemma specialize_presentationMap (E : WeightedPolynomialSituation)
    (p : MvPolynomial (Fin 3) E.k) :
    specialize E (presentationMap E p) = toricMap E.k p := by
  have hpoly : (specialize E).comp (presentationMap E).toRingHom =
      (toricMap E.k).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change specialize E (presentationMap E (MvPolynomial.C c)) =
        toricMap E.k (MvPolynomial.C c)
      simp only [presentationMap, toricMap, MvPolynomial.aeval_C]
      change specialize E (algebraMap E.k E.R c) = MvPolynomial.C c
      unfold specialize
      change evalAtZOneLocalization E
        (HomogeneousLocalization.val (algebraMap E.k E.R c)) = MvPolynomial.C c
      simp only [evalAtZOneLocalization]
      change Localization.awayLift (evalAtZOne E).toRingHom E.z
          (isUnit_iff_exists_inv.mpr ⟨1, by simp [evalAtZOne]⟩)
          (Localization.mk (MvPolynomial.C c) 1) = MvPolynomial.C c
      rw [Localization.mk_one_eq_algebraMap]
      simp [evalAtZOne]
    · intro i
      fin_cases i <;>
        simp [presentationMap, toricMap, specialize_u, specialize_v, specialize_w]
  exact congrArg (fun f : MvPolynomial (Fin 3) E.k →+* MvPolynomial (Fin 2) E.k => f p) hpoly

/-- The map `k[X₀, X₁, X₂] / (X₀X₂ - X₁³) → S₍z₎` followed by evaluation at `z = 1` is the
descended toric map. -/
lemma specialize_degreeZeroRingMap (E : WeightedPolynomialSituation)
    (q : MvPolynomial (Fin 3) E.k ⧸ cubicRelationIdeal E.k) :
    specialize E (degreeZeroRingMap E q) = toricMapQuotient E.k q := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
  change specialize E (presentationMap E p) = _
  rw [specialize_presentationMap E p, toricMapQuotient_mk]

/-- The map `k[X₀, X₁, X₂] / (X₀X₂ - X₁³) → S₍z₎` is injective. -/
lemma degreeZeroRingMap_injective (E : WeightedPolynomialSituation) :
    Function.Injective (degreeZeroRingMap E) := by
  intro a b hab
  apply toricMapQuotient_injective E.k
  rw [← specialize_degreeZeroRingMap E a, ← specialize_degreeZeroRingMap E b]
  exact congrArg (specialize E) hab

/-- Evaluation at `z = 1` sends the fraction `p/zⁿ` of `S₍z₎` to the evaluation of `p` at
`z = 1`. -/
lemma specialize_mk (E : WeightedPolynomialSituation) (n : ℕ) (p : E.S)
    (hp : p ∈ E.naturalGrading (n • E.naturalWeight 2)) :
    specialize E (HomogeneousLocalization.Away.mk E.naturalGrading (f := E.z)
      (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) n p hp) =
      evalAtZOne E p := by
  change evalAtZOneLocalization E
    (HomogeneousLocalization.val
      (HomogeneousLocalization.Away.mk E.naturalGrading (f := E.z)
        (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) n p hp)) = _
  rw [HomogeneousLocalization.Away.val_mk E.naturalGrading (f := E.z) n
    (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) p hp,
    evalAtZOneLocalization_mk]

/-- Evaluation at `z = 1` is injective on `S₍z₎`. -/
lemma specialize_injective (E : WeightedPolynomialSituation) :
    Function.Injective (specialize E) := by
  intro a b hab
  have hz : specialize E (a - b) = 0 := by rw [map_sub, hab, sub_self]
  obtain ⟨n, p, hp, hrep⟩ := HomogeneousLocalization.Away.mk_surjective E.naturalGrading
    (f := E.z) (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) (a - b)
  have heval : evalAtZOne E p = 0 := by rwa [← hrep, specialize_mk E n p hp] at hz
  have hp' : p.IsWeightedHomogeneous E.naturalWeight (3 * n) := by
    simpa [WeightedPolynomialSituation.naturalWeight, Nat.mul_comm] using hp
  have hp0 := evalAtZOne_injective_on_homogeneous E p (3 * n) hp' heval
  have hmkzero : HomogeneousLocalization.Away.mk E.naturalGrading (f := E.z)
      (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) n p hp = 0 := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk E.naturalGrading (f := E.z) n
      (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) p hp, hp0]
    simp only [Localization.mk_zero, HomogeneousLocalization.val_zero]
  exact sub_eq_zero.mp (hrep.symm.trans hmkzero)

/-- The map `k[X₀, X₁, X₂] / (X₀X₂ - X₁³) → S₍z₎` is surjective. -/
lemma degreeZeroRingMap_surjective (E : WeightedPolynomialSituation) :
    Function.Surjective (degreeZeroRingMap E) := by
  classical
  let B := E.naturalGrading 0
  have coordinateSpan :
      Algebra.adjoin B (Set.range (MvPolynomial.X : Fin 3 → E.S)) = ⊤ := by
    apply top_unique
    rintro p -
    induction p using MvPolynomial.induction_on with
    | C c =>
        have hc : MvPolynomial.C c ∈ E.naturalGrading 0 :=
          (MvPolynomial.mem_weightedHomogeneousSubmodule _ _ _ _).2
            (MvPolynomial.isWeightedHomogeneous_C E.naturalWeight c)
        let c₀ : B := ⟨MvPolynomial.C c, hc⟩
        change (c₀ : E.S) ∈ _
        exact (Algebra.adjoin B
          (Set.range (MvPolynomial.X : Fin 3 → E.S))).algebraMap_mem c₀
    | add p q hp hq => exact (Algebra.adjoin B _).add_mem hp hq
    | mul_X p i hp => exact (Algebra.adjoin B _).mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
  have hgen := HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top
    (𝒜 := E.naturalGrading) (f := E.z) (d := 3)
    (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2)
    (Fin 3) (MvPolynomial.X : Fin 3 → E.S) coordinateSpan E.naturalWeight
    (fun i => MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight i)
  let T : Subalgebra B E.R :=
    { carrier := Set.range (degreeZeroRingMap E)
      add_mem' := by
        rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
        exact ⟨a + b, map_add _ _ _⟩
      mul_mem' := by
        rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
        exact ⟨a * b, map_mul _ _ _⟩
      algebraMap_mem' := by
        intro p
        obtain ⟨c, hp⟩ := degreeZeroCoefficient E p
        refine ⟨algebraMap E.k (MvPolynomial (Fin 3) E.k ⧸ cubicRelationIdeal E.k) c, ?_⟩
        rw [degreeZeroScalar E p c hp]
        simp [degreeZeroRingMap] }
  have hsubset : Algebra.adjoin B
      {HomogeneousLocalization.Away.mk E.naturalGrading (f := E.z)
        (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) a
        (∏ i : Fin 3, MvPolynomial.X i ^ ai i)
        (hai ▸ SetLike.prod_pow_mem_graded _ _ _ _
          (fun i _ => MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight i)) |
          (a : ℕ) (ai : Fin 3 → ℕ) (hai : ∑ i, ai i • E.naturalWeight i = a • 3)
          (_ : ∀ i, ai i ≤ 3)} ≤ T := by
    rw [Algebra.adjoin_le_iff]
    rintro z ⟨a, ai, hai, _, rfl⟩
    have hwt₀ : ai 0 + (ai 1 * 2 + ai 2 * 3) = a * 3 := by
      simpa [WeightedPolynomialSituation.naturalWeight, Fin.sum_univ_succ] using hai
    have hwt : ai 0 + 2 * ai 1 + 3 * ai 2 = 3 * a := by nlinarith [hwt₀]
    have hdecomp : ai 0 + 2 * ai 1 = 3 * (a - ai 2) := by omega
    obtain ⟨A, D, C, hA, hD, _⟩ := toricExponentLift _ _ _ hdecomp
    have hprodmem : (∏ i : Fin 3, MvPolynomial.X i ^ ai i) ∈
        E.naturalGrading (a • E.naturalWeight 2) :=
      hai ▸ SetLike.prod_pow_mem_graded _ _ _ _
        (fun i _ => MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight i)
    let q : MvPolynomial (Fin 3) E.k ⧸ cubicRelationIdeal E.k :=
      Ideal.Quotient.mk _
        (MvPolynomial.X 0 ^ A * MvPolynomial.X 1 ^ D * MvPolynomial.X 2 ^ C)
    have hmap : degreeZeroRingMap E q = E.u ^ A * E.v ^ D * E.w ^ C := by
      simp only [q, degreeZeroRingMap, Ideal.Quotient.liftₐ_apply]
      simp [presentationMap]
    have hspec : specialize E
        (HomogeneousLocalization.Away.mk E.naturalGrading (f := E.z)
          (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) a
          (∏ i : Fin 3, MvPolynomial.X i ^ ai i) hprodmem) =
        specialize E (E.u ^ A * E.v ^ D * E.w ^ C) := by
      rw [specialize_mk E a _ hprodmem]
      have hevalprod : evalAtZOne E (∏ i : Fin 3, MvPolynomial.X i ^ ai i) =
          MvPolynomial.X 0 ^ ai 0 * MvPolynomial.X 1 ^ ai 1 := by
        simp [evalAtZOne, Fin.prod_univ_succ, MvPolynomial.aeval_X]
      rw [hevalprod]
      simp only [map_mul, map_pow, specialize_u, specialize_v, specialize_w]
      rw [← hA, ← hD, pow_add, pow_add, pow_mul, mul_pow, pow_mul]
      ac_rfl
    have hfrac : HomogeneousLocalization.Away.mk E.naturalGrading (f := E.z)
        (MvPolynomial.isWeightedHomogeneous_X E.k E.naturalWeight 2) a
        (∏ i : Fin 3, MvPolynomial.X i ^ ai i) hprodmem =
        E.u ^ A * E.v ^ D * E.w ^ C := specialize_injective E hspec
    rw [hfrac, ← hmap]
    exact ⟨q, rfl⟩
  exact fun r => Set.mem_range.mp ((hgen ▸ hsubset : (⊤ : Subalgebra B E.R) ≤ T)
    (show r ∈ (⊤ : Subalgebra B E.R) from trivial))

/-- The presentation of the degree-zero localization at `z` in the weighted polynomial
example: `S₍z₎ ≅ k[X₀, X₁, X₂] / (X₀X₂ - X₁³)`. Surjectivity says that `u`, `v` and `w`
generate, injectivity that `uw = v³` is their only relation. -/
public noncomputable def degreeZeroRingEquiv (E : WeightedPolynomialSituation) :
    (MvPolynomial (Fin 3) E.k ⧸ cubicRelationIdeal E.k) ≃ₐ[E.k] E.R :=
  AlgEquiv.ofBijective
    (Ideal.Quotient.liftₐ (cubicRelationIdeal E.k) (MvPolynomial.aeval ![E.u, E.v, E.w])
      (fun _ hp => RingHom.mem_ker.mp (cubicRelationIdeal_le_ker E hp)))
    ⟨degreeZeroRingMap_injective E, degreeZeroRingMap_surjective E⟩

/-- The canonical presentation sends its three variables to `x³/z`, `xy/z` and `y³/z²`. -/
public theorem degreeZeroRingEquiv_mk_X (E : WeightedPolynomialSituation) (i : Fin 3) :
    degreeZeroRingEquiv E (Ideal.Quotient.mk (cubicRelationIdeal E.k) (MvPolynomial.X i)) =
      ![E.u, E.v, E.w] i := by
  change degreeZeroRingMap E
    (Ideal.Quotient.mk (cubicRelationIdeal E.k) (MvPolynomial.X i)) = _
  rw [degreeZeroRingMap_quotient_mk]
  exact presentationMap_X E i

end Stacks.WeightedPolynomial

