module

public import Mathlib.RingTheory.Ideal.Quotient.PowTransition
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.GradedAlgebra.Examples.WeightedPolynomialDegreeZero

/-!
# The vertex ideal of the weighted polynomial example

For the polynomial ring `S = k[x, y, z]` graded by the weights `1`, `2` and `3`, the degree-zero
localization `S₍z₎` at `z` is generated over `k` by the three fractions `u = x³/z`, `v = xy/z` and
`w = y³/z²`. The ideal they generate — the *vertex ideal*, the origin of the affine cone — is a
maximal ideal with residue field the ground field `k`.

## Main results

* `Stacks.WeightedPolynomialSituation.vertexIdeal_isMaximal`: the ideal `(u, v, w)` of `S₍z₎`
  is maximal.
* `Stacks.WeightedPolynomialSituation.bijective_algebraMap_vertexIdeal_residueField`: the
  canonical map from `k` to the residue field at the vertex ideal is bijective, so that residue
  field is `k`.
* `Stacks.WeightedPolynomialSituation.bijective_algebraMap_vertexIdeal_quotient`: the same for
  the quotient of `S₍z₎` by the vertex ideal.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
-/

public section

namespace Stacks.WeightedPolynomialSituation

open Stacks.WeightedPolynomial

universe u

private theorem idealOfVars_eq_ker_constantCoeff (k : Type u) [CommRing k] :
    MvPolynomial.idealOfVars (Fin 3) k =
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin 3) k →+* k) := by
  ext p
  rw [RingHom.mem_ker, ← pow_one (MvPolynomial.idealOfVars (Fin 3) k),
    MvPolynomial.mem_pow_idealOfVars_iff' 1]
  simpa [MvPolynomial.constantCoeff_eq] using
    (show (∀ x : Fin 3 →₀ ℕ, Finsupp.degree x < 1 → p.coeff x = 0) ↔ p.coeff 0 = 0 by
      simp [Finsupp.degree_eq_zero_iff])

private theorem idealOfVars_fin_three (k : Type u) [CommRing k] :
    MvPolynomial.idealOfVars (Fin 3) k =
      Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1, MvPolynomial.X 2} := by
  apply le_antisymm
  · rw [MvPolynomial.idealOfVars]
    apply Ideal.span_le.mpr
    rintro x ⟨i, rfl⟩
    fin_cases i <;> exact Ideal.subset_span (by simp)
  · apply Ideal.span_le.mpr
    rintro x (rfl | rfl | rfl) <;> exact Ideal.subset_span ⟨_, rfl⟩

private theorem cubicRelationIdeal_le_idealOfVars (E : WeightedPolynomialSituation) :
    cubicRelationIdeal E.k ≤ MvPolynomial.idealOfVars (Fin 3) E.k := by
  rw [idealOfVars_eq_ker_constantCoeff, cubicRelationIdeal]
  apply Ideal.span_le.mpr
  rintro _ rfl
  simp

private theorem vertexIdeal_eq_mapped_idealOfVars (E : WeightedPolynomialSituation) :
    E.vertexIdeal =
      Ideal.map (degreeZeroRingEquiv E)
        (Ideal.map (Ideal.Quotient.mk (cubicRelationIdeal E.k))
          (MvPolynomial.idealOfVars (Fin 3) E.k)) := by
  rw [idealOfVars_fin_three]
  simp [Ideal.map_span, degreeZeroRingEquiv_mk_X,
    WeightedPolynomialSituation.vertexIdeal]

/-- The ideal generated by `u`, `v`, and `w` in the degree-zero localization is maximal. -/
theorem vertexIdeal_isMaximal (E : WeightedPolynomialSituation) :
    E.vertexIdeal.IsMaximal := by
  have hV : (MvPolynomial.idealOfVars (Fin 3) E.k).IsMaximal := by
    rw [idealOfVars_eq_ker_constantCoeff]
    exact RingHom.ker_isMaximal_of_surjective _ (fun c ↦ ⟨MvPolynomial.C c, by simp⟩)
  let : Field (MvPolynomial (Fin 3) E.k ⧸ MvPolynomial.idealOfVars (Fin 3) E.k) :=
    Ideal.Quotient.field _
  have hI := cubicRelationIdeal_le_idealOfVars E
  have hL : (Ideal.map (Ideal.Quotient.mk (cubicRelationIdeal E.k))
      (MvPolynomial.idealOfVars (Fin 3) E.k)).IsMaximal := by
    rw [← Ideal.Quotient.factor_ker hI]
    exact RingHom.ker_isMaximal_of_surjective _ (Ideal.Quotient.factor_surjective hI)
  rw [vertexIdeal_eq_mapped_idealOfVars E]
  exact hL.map_bijective _ (EquivLike.bijective _)

/-- The map from the ground field to `S₍z₎` modulo the vertex ideal is bijective. -/
private theorem bijective_algebraMap_quotient_vertexIdeal (E : WeightedPolynomialSituation) :
    Function.Bijective (algebraMap E.k (E.R ⧸ E.vertexIdeal)) := by
  let : E.vertexIdeal.IsMaximal := vertexIdeal_isMaximal E
  refine ⟨RingHom.injective _, ?_⟩
  intro q
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
  let I := cubicRelationIdeal E.k
  let V := MvPolynomial.idealOfVars (Fin 3) E.k
  let e := degreeZeroRingEquiv E
  obtain ⟨p, hp⟩ := (e.surjective.comp Ideal.Quotient.mk_surjective) r
  refine ⟨MvPolynomial.constantCoeff p, ?_⟩
  rw [← hp]
  apply Ideal.Quotient.eq.mpr
  have hpV : p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈ V := by
    show p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      MvPolynomial.idealOfVars (Fin 3) E.k
    rw [idealOfVars_eq_ker_constantCoeff, RingHom.mem_ker]
    simp
  have hqV : Ideal.Quotient.mk I p -
      algebraMap E.k (MvPolynomial (Fin 3) E.k ⧸ I) (MvPolynomial.constantCoeff p) ∈
        Ideal.map (Ideal.Quotient.mk I) V := by
    show Ideal.Quotient.mk I
        (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) ∈
      Ideal.map (Ideal.Quotient.mk I) V
    exact Ideal.mem_map_of_mem (Ideal.Quotient.mk I) hpV
  have hrV :
      e (Ideal.Quotient.mk I p) - algebraMap E.k E.R (MvPolynomial.constantCoeff p) ∈
        Ideal.map e (Ideal.map (Ideal.Quotient.mk I) V) := by
    have heq : e (algebraMap E.k (MvPolynomial (Fin 3) E.k ⧸ I)
        (MvPolynomial.constantCoeff p)) =
        algebraMap E.k E.R (MvPolynomial.constantCoeff p) := e.commutes _
    rw [← heq, ← map_sub]
    exact Ideal.mem_map_of_mem e hqV
  rw [vertexIdeal_eq_mapped_idealOfVars E]
  simpa [Function.comp_apply, sub_eq_add_neg, add_comm] using
    (Ideal.map e (Ideal.map (Ideal.Quotient.mk I) V)).neg_mem hrV

/-- The canonical map from the ground field to the vertex residue field is bijective. -/
theorem bijective_algebraMap_vertexIdeal_residueField (E : WeightedPolynomialSituation) :
    letI : E.vertexIdeal.IsMaximal := vertexIdeal_isMaximal E
    Function.Bijective (algebraMap E.k E.vertexIdeal.ResidueField) := by
  let : E.vertexIdeal.IsMaximal := vertexIdeal_isMaximal E
  simpa [IsScalarTower.algebraMap_eq E.k (E.R ⧸ E.vertexIdeal) E.vertexIdeal.ResidueField] using
    (Ideal.bijective_algebraMap_quotient_residueField E.vertexIdeal).comp
      (bijective_algebraMap_quotient_vertexIdeal E)

/-- The canonical map from the ground field to the quotient of the degree-zero localization by
the vertex ideal is bijective. -/
theorem bijective_algebraMap_vertexIdeal_quotient (E : WeightedPolynomialSituation) :
    Function.Bijective (algebraMap E.k (E.R ⧸ E.vertexIdeal)) :=
  bijective_algebraMap_quotient_vertexIdeal E

end Stacks.WeightedPolynomialSituation

end
