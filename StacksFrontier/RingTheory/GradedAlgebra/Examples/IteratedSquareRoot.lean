/-!
# An infinitely generated graded algebra, and its irrelevant locus

This file sets up the graded algebra

`S = ℂ[t][X₁, X₂, …] / (Xᵢ² - t Xᵢ₊₁)`,  `deg Xᵢ = 2ⁱ⁻¹`,  `S₀ = ℂ[t]`,

in which every variable has a square root up to the coefficient `t`, and proves the one property
of it that the source uses: the image of `t` lies in no point of `Proj S`. Indeed if a
homogeneous prime contained `t` then it would contain every `Xᵢ`, because `Xᵢ² = t Xᵢ₊₁`, and
hence the whole irrelevant ideal — which no point of `Proj S` does.

## Main definitions

* `Stacks.IteratedSquareRootAlgebra.baseRing` is the coefficient ring `ℂ[t]`.
* `Stacks.IteratedSquareRootAlgebra.polynomialRing` is `ℂ[t][X₁, X₂, …]`.
* `Stacks.IteratedSquareRootAlgebra.relationIdeal` is the ideal generated by the relations.
* `Stacks.IteratedSquareRootAlgebra.ring` is the quotient algebra `S`.
* `Stacks.IteratedSquareRootAlgebra.x` is the class of a variable in `S`.
* `Stacks.IteratedSquareRootAlgebra.weight` is the weight function `i ↦ 2ⁱ` of the variables.
* `Stacks.IteratedSquareRootAlgebra.Grading` packages the specified grading of `S`.
* `Stacks.IteratedSquareRootAlgebra.canonicalGrading` is that grading, constructed.

## Main results

* `Stacks.IteratedSquareRootAlgebra.relation_isWeightedHomogeneous` and
  `Stacks.IteratedSquareRootAlgebra.relationIdeal_isHomogeneous`: the relations, and the ideal
  they generate, are homogeneous for the weighted grading.
* `Stacks.IteratedSquareRootAlgebra.algebraMap_t_notMem` and
  `Stacks.IteratedSquareRootAlgebra.algebraMap_t_notMem_canonical`: the image of `t` lies in no
  homogeneous prime belonging to `Proj S`, for an arbitrary `Grading` and for
  `canonicalGrading`.

## Implementation notes

The natural-number index `i` represents the source's variable `X_{i+1}`. The underlying ring is
the literal quotient of the multivariable polynomial ring, so the presentation is part of its
definition rather than an asserted surjective presentation. `Grading` bundles exactly the
properties of the grading that the source uses: the degree-zero piece is the canonical copy of
`ℂ[t]`, represented as the submodule spanned by `1`; the class of `X_{i+1}` is homogeneous of
degree `2 ^ i`; and the defining relation holds in directly usable form.

The grading itself is `canonicalGrading`: the weighted grading of `ℂ[t][X₁, X₂, …]` for the
weights `i ↦ 2 ^ i`, pushed to the quotient. The relation `Xᵢ² - t Xᵢ₊₁` is weighted
homogeneous of degree `2 ^ (i + 1)`, because the coefficient `t` has weight zero while both `Xᵢ²`
and `Xᵢ₊₁` have weight `2 ^ (i + 1)`, so the relation ideal is homogeneous and the quotient
inherits the grading. All weights are positive, so a polynomial of weighted degree zero is a
constant, which is what identifies the degree-zero piece with `ℂ[t] · 1`.

Membership of a point of `Proj S` means membership in its underlying homogeneous ideal. The
proof reduces to showing that a homogeneous prime containing every `Xᵢ` contains every element
of positive degree, which follows by subtracting the constant coefficient of a polynomial
representative and projecting to the degree in question.

## References

* [Stacks Project, Tag 01MH](https://stacks.math.columbia.edu/tag/01MH)
-/

@[expose] public section

noncomputable section

namespace Stacks.IteratedSquareRootAlgebra

/-- The degree-zero coefficient ring `ℂ[t]`. -/
public abbrev baseRing := Polynomial ℂ

/-- The polynomial ring over `ℂ[t]` in variables indexed by the natural numbers. -/
public abbrev polynomialRing := MvPolynomial ℕ baseRing

/-- The polynomial relation corresponding to `Xᵢ² = t Xᵢ₊₁` (with zero-based indices). -/
public def relation (i : ℕ) : polynomialRing :=
  MvPolynomial.X i ^ 2 - MvPolynomial.C Polynomial.X * MvPolynomial.X (i + 1)

/-- The ideal generated by all relations `Xᵢ² - t Xᵢ₊₁`. -/
public def relationIdeal : Ideal polynomialRing := Ideal.span (Set.range relation)

/-- The ring `ℂ[t][X₁, X₂, …] / (Xᵢ² - tXᵢ₊₁)`. -/
public abbrev ring := polynomialRing ⧸ relationIdeal

/-- The coefficient `t` in the base ring. -/
public abbrev t : baseRing := Polynomial.X

/-- The image of `X_{i+1}` in the quotient ring. -/
public def x (i : ℕ) : ring := Ideal.Quotient.mk relationIdeal (MvPolynomial.X i)

/-- The weights of the variables: `X_{i+1}` has weight `2 ^ i`, so that `deg Xᵢ = 2ⁱ⁻¹` in the
source's numbering from one. -/
public def weight (i : ℕ) : ℕ := 2 ^ i

/-- The weighted grading of `ℂ[t][X₁, X₂, …]` attached to the weights `2 ^ i`. -/
public instance polynomialGradedAlgebra :
    GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule baseRing weight) :=
  MvPolynomial.weightedGradedAlgebra baseRing weight

/-- The relation `Xᵢ² - t Xᵢ₊₁` is weighted homogeneous of degree `2 ^ (i + 1)`: the square has
weight `2 · 2 ^ i` and the coefficient `t` has weight zero. -/
public theorem relation_isWeightedHomogeneous (i : ℕ) :
    (relation i).IsWeightedHomogeneous weight (2 ^ (i + 1)) := by
  have hsquare : ((MvPolynomial.X i : polynomialRing) ^ 2).IsWeightedHomogeneous weight
      (2 ^ (i + 1)) := by
    have h := (MvPolynomial.isWeightedHomogeneous_X baseRing weight i).pow 2
    rwa [show 2 • weight i = 2 ^ (i + 1) by
      simp only [weight, smul_eq_mul, pow_succ]; ring] at h
  have hproduct : ((MvPolynomial.C Polynomial.X : polynomialRing) *
      MvPolynomial.X (i + 1)).IsWeightedHomogeneous weight (2 ^ (i + 1)) := by
    have h := (MvPolynomial.isWeightedHomogeneous_C weight (Polynomial.X : baseRing)).mul
      (MvPolynomial.isWeightedHomogeneous_X baseRing weight (i + 1))
    rwa [show (0 : ℕ) + weight (i + 1) = 2 ^ (i + 1) by simp [weight]] at h
  exact hsquare.sub hproduct

/-- The relation ideal is homogeneous for the weighted grading, being generated by weighted
homogeneous elements. -/
public theorem relationIdeal_isHomogeneous :
    relationIdeal.IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule baseRing weight) :=
  Ideal.homogeneous_span _ _ (by
    rintro _ ⟨i, rfl⟩
    exact ⟨2 ^ (i + 1), (MvPolynomial.mem_weightedHomogeneousSubmodule _ _ _ _).mpr
      (relation_isWeightedHomogeneous i)⟩)

/-- Every weight is positive, so a polynomial of weighted degree zero is a constant. -/
private lemma eq_C_of_mem_weight_zero {p : polynomialRing}
    (hp : p ∈ MvPolynomial.weightedHomogeneousSubmodule baseRing weight 0) :
    p = MvPolynomial.C (p.coeff 0) := by
  have hnontorsion : MvPolynomial.NonTorsionWeight weight :=
    MvPolynomial.nonTorsionWeight_of fun i => (pow_pos (by norm_num : 0 < 2) i).ne'
  refine MvPolynomial.ext _ _ fun d => ?_
  rw [MvPolynomial.coeff_C]
  by_cases hd : (0 : ℕ →₀ ℕ) = d
  · subst hd; simp
  · rw [ite_eq_right hd]
    by_contra hcoeff
    refine hd (Finsupp.ext fun j => ?_).symm
    simpa using
      (MvPolynomial.weightedDegree_eq_zero_iff hnontorsion).mp
        ((MvPolynomial.mem_weightedHomogeneousSubmodule _ _ _ _).mp hp hcoeff) j

/-- The specified grading of `S = ℂ[t][X₁, X₂, …] / (Xᵢ² - tXᵢ₊₁)`, with `deg(Xᵢ) = 2ⁱ⁻¹` and
degree-zero part `ℂ[t]`. -/
public structure Grading where
  /-- The homogeneous pieces of the specified grading. -/
  grading : ℕ → Submodule baseRing ring
  /-- The pieces form a grading of the quotient as an algebra over `ℂ[t]`. -/
  gradedAlgebra : GradedAlgebra grading
  /-- The degree-zero part is precisely the canonical copy of `ℂ[t]`. -/
  degreeZero : grading 0 = Submodule.span baseRing {1}
  /-- The class of `X_{i+1}` is homogeneous of degree `2^i`. -/
  x_mem : ∀ i : ℕ, x i ∈ grading (2 ^ i)
  /-- The defining relation, in a directly usable form. -/
  x_sq : ∀ i : ℕ, x i ^ 2 = algebraMap baseRing ring t * x (i + 1)

/-- **The specified grading of `S` exists.** The degree-`d` piece is the image of the
polynomials of weighted degree `d` for the weights `2 ^ i`; the relation ideal is homogeneous,
so those images grade the quotient, and all weights being positive the degree-zero piece is
`ℂ[t] · 1`. -/
public def canonicalGrading : Grading where
  grading :=
    Stacks.GradedModel.quotientGrading
      (MvPolynomial.weightedHomogeneousSubmodule baseRing weight) relationIdeal
  gradedAlgebra := Stacks.GradedModel.quotientGradedAlgebra _ relationIdeal_isHomogeneous
  degreeZero := by
    refine le_antisymm (fun y hy => ?_) (Submodule.span_le.2 (Set.singleton_subset_iff.2 ?_))
    · have hy' : y ∈ (Stacks.GradedModel.quotientGrading
          (MvPolynomial.weightedHomogeneousSubmodule baseRing weight) relationIdeal 0 :
          Set ring) := hy
      rw [Stacks.GradedModel.coe_quotientGrading] at hy'
      obtain ⟨p, hp, rfl⟩ := hy'
      rw [eq_C_of_mem_weight_zero hp, MvPolynomial.C_eq_algebraMap,
        Ideal.Quotient.mk_algebraMap, Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self 1)
    · have h1 : (1 : ring) = Ideal.Quotient.mk relationIdeal 1 := (map_one _).symm
      rw [SetLike.mem_coe, h1]
      exact Stacks.GradedModel.mk_mem_quotientGrading
        ((MvPolynomial.mem_weightedHomogeneousSubmodule _ _ _ _).mpr
          (MvPolynomial.isWeightedHomogeneous_one baseRing weight))
  x_mem i :=
    Stacks.GradedModel.mk_mem_quotientGrading
      ((MvPolynomial.mem_weightedHomogeneousSubmodule _ _ (2 ^ i) _).mpr
        (MvPolynomial.isWeightedHomogeneous_X baseRing weight i))
  x_sq i := by
    have hzero : Ideal.Quotient.mk relationIdeal (relation i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    have ht : algebraMap baseRing ring t =
        Ideal.Quotient.mk relationIdeal (MvPolynomial.C Polynomial.X) := by
      rw [MvPolynomial.C_eq_algebraMap, Ideal.Quotient.mk_algebraMap]
    rw [relation, map_sub, map_pow, map_mul, sub_eq_zero] at hzero
    rw [ht]
    exact hzero

/-- The constructed grading, as the graded-algebra instance on its pieces. -/
public instance canonicalGradedAlgebra : GradedAlgebra canonicalGrading.grading :=
  canonicalGrading.gradedAlgebra

/-- A homogeneous ideal containing every variable contains every polynomial minus its constant
coefficient. -/
private lemma quotient_sub_constantCoeff_mem (I : Ideal ring)
    (hx : ∀ i, x i ∈ I) (f : polynomialRing) :
    Ideal.Quotient.mk relationIdeal f -
      algebraMap baseRing ring (MvPolynomial.constantCoeff f) ∈ I := by
  induction f using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.constantCoeff_C, MvPolynomial.C_eq_algebraMap,
        Ideal.Quotient.mk_algebraMap]; simp
  | add f g hf hg =>
      rw [map_add, map_add, map_add]
      convert I.add_mem hf hg using 1
      ring
  | mul_X f i hf =>
      simpa [map_mul, x, mul_comm] using
        I.mul_mem_left (Ideal.Quotient.mk relationIdeal f) (hx i)

/-- The image of the coefficient `t` lies in no homogeneous prime of the example's
projective spectrum. -/
public theorem algebraMap_t_notMem (s : Grading) :
    letI : GradedAlgebra s.grading := s.gradedAlgebra
    ∀ p : Proj s.grading,
      algebraMap baseRing ring t ∉ p.asHomogeneousIdeal := by
  let : GradedAlgebra s.grading := s.gradedAlgebra
  intro p ht
  have hx : ∀ i, x i ∈ p.asHomogeneousIdeal.toIdeal := by
    intro i
    have hsquare : x i ^ 2 ∈ p.asHomogeneousIdeal.toIdeal := by
      rw [s.x_sq i]
      exact Ideal.mul_mem_right _ _ ht
    rcases p.isPrime.mem_or_mem (by simpa [pow_two] using hsquare) with h | h <;> exact h
  apply p.not_irrelevant_le
  apply (HomogeneousIdeal.irrelevant_le s.grading).2
  intro i hi y hy
  change y ∈ p.asHomogeneousIdeal.toIdeal
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  have hdiff := quotient_sub_constantCoeff_mem p.asHomogeneousIdeal.toIdeal hx f
  have hc0 : algebraMap baseRing ring (MvPolynomial.constantCoeff f) ∈ s.grading 0 := by
    rw [s.degreeZero, Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
  have hproj_eq :
      GradedRing.proj s.grading i
        (Ideal.Quotient.mk relationIdeal f -
          algebraMap baseRing ring (MvPolynomial.constantCoeff f)) =
        Ideal.Quotient.mk relationIdeal f := by
    rw [map_sub, GradedRing.proj_apply,
      DirectSum.decompose_of_mem_same s.grading hy, GradedRing.proj_apply,
      DirectSum.decompose_of_mem_ne s.grading hc0 (Ne.symm (Nat.ne_of_gt hi)), sub_zero]
  rw [← hproj_eq]
  simpa only [GradedRing.proj_apply] using
    ((Submodule.IsHomogeneous.mem_iff s.grading
      p.asHomogeneousIdeal.isHomogeneous).mp hdiff i)

/-- **Stacks Project, Tag 01MH.** The image of the coefficient `t` lies in no point of
`Proj S`: a homogeneous prime containing `t` would contain every `Xᵢ`, since `Xᵢ² = t Xᵢ₊₁`,
and hence the whole irrelevant ideal. -/
public theorem algebraMap_t_notMem_canonical (p : Proj canonicalGrading.grading) :
    algebraMap baseRing ring t ∉ p.asHomogeneousIdeal :=
  algebraMap_t_notMem canonicalGrading p

end Stacks.IteratedSquareRootAlgebra

end
