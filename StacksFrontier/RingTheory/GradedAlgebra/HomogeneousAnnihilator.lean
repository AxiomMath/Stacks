module

public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
public import Mathlib.RingTheory.GradedAlgebra.Radical
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Topology

/-!
# Annihilators of homogeneous elements, and ring maps out of `A_{(f)}` in degree one

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring. This file collects three facts about homogeneous
elements that the computation of sections of twisting sheaves on `Proj A` keeps returning to.

* The annihilator of a homogeneous element `δ` is a homogeneous ideal: if `t δ = 0`, then every
  homogeneous component of `t` kills `δ`, because the component of `t δ` in degree `i + deg δ`
  is `tᵢ δ`. So a relation `t δ = 0` with `t` outside a homogeneous prime `𝔭` can always be
  witnessed by a *homogeneous* `t` outside `𝔭`.
* If `δ` is homogeneous and is killed, at every point `𝔭 ∈ D₊(f)` of `Proj A`, by some element
  outside `𝔭`, then `δ` is killed by a power of `f`. The annihilator is homogeneous, its
  radical is the intersection of the homogeneous primes containing it, and none of those
  primes misses `f`.
* If `A` is generated in degree one over `𝒜 0` and `f ∈ 𝒜 1`, then a ring map out of the
  degree-zero localization `A_{(f)}` is determined by its values on the fractions `g / f`,
  `g ∈ 𝒜 1`.

## Main results

* `Submodule.isHomogeneous_annihilator_span_singleton`: the annihilator of a homogeneous element
  is homogeneous.
* `HomogeneousIdeal.exists_decompose_notMem_mul_eq_zero`: the homogeneous witness.
* `ProjectiveSpectrum.exists_pow_mul_eq_zero_of_forall_mem_basicOpen`: the power of `f`.
* `HomogeneousLocalization.Away.ringHom_ext_of_adjoin_degreeOne`: the extensionality of ring
  maps out of `A_{(f)}`.

## Implementation notes

The extensionality statement is proved by induction over the subalgebra generated by `𝒜 1`,
carrying the statement for *every* homogeneous component at once: a product `a b` has its
degree-`m` component `∑_{i + j = m} aᵢ bⱼ`, and `aᵢ bⱼ / f ^ m = (aᵢ / f ^ i)(bⱼ / f ^ j)`.
Degree-zero scalars `c` are absorbed into degree one as `c = (c f) / f`, so no hypothesis on
the restriction of the two maps to `𝒜 0` is needed.

## References

* [Stacks Project, Tag 00JM](https://stacks.math.columbia.edu/tag/00JM)
* [Stacks Project, Tag 01M3](https://stacks.math.columbia.edu/tag/01M3)
-/

@[expose] public section

open DirectSum HomogeneousLocalization

variable {A : Type*} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  {𝒜 : ℕ → σ} [GradedRing 𝒜]

/-- **A homogeneous component of an annihilator is an annihilator.** If `t δ = 0` with `δ`
homogeneous, then every homogeneous component of `t` kills `δ`. -/
theorem DirectSum.decompose_mul_eq_zero_of_mul_eq_zero {t δ : A} {j : ℕ} (hδ : δ ∈ 𝒜 j)
    (h : t * δ = 0) (i : ℕ) : (decompose 𝒜 t i : A) * δ = 0 := by
  rw [← coe_decompose_mul_add_of_right_mem 𝒜 hδ, h, decompose_zero]
  rfl

/-- **A relation `t δ = 0` with `t ∉ 𝔭` has a homogeneous witness.** If `𝔭` is a homogeneous
ideal, `δ` is homogeneous and `t δ = 0` with `t ∉ 𝔭`, then some homogeneous component of `t`
lies outside `𝔭` and kills `δ`. -/
theorem HomogeneousIdeal.exists_decompose_notMem_mul_eq_zero (𝔭 : HomogeneousIdeal 𝒜)
    {t δ : A} {j : ℕ} (hδ : δ ∈ 𝒜 j) (ht : t ∉ 𝔭) (h : t * δ = 0) :
    ∃ i, (decompose 𝒜 t i : A) ∉ 𝔭 ∧ (decompose 𝒜 t i : A) * δ = 0 := by
  by_contra! hcon
  apply ht
  have hmem : ∀ i, (decompose 𝒜 t i : A) ∈ 𝔭 := fun i => by
    by_contra hi
    exact hi (absurd (DirectSum.decompose_mul_eq_zero_of_mul_eq_zero hδ h i) (hcon i hi))
  exact (𝔭.isHomogeneous.mem_iff).mpr hmem

/-- **The annihilator of a homogeneous element is a homogeneous ideal.** -/
theorem Submodule.isHomogeneous_annihilator_span_singleton {δ : A} {j : ℕ} (hδ : δ ∈ 𝒜 j) :
    (Submodule.span A {δ}).annihilator.IsHomogeneous 𝒜 := by
  intro i t ht
  rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul] at ht ⊢
  exact DirectSum.decompose_mul_eq_zero_of_mul_eq_zero hδ ht i

/-- **A homogeneous element killed near every point of `D₊(f)` is killed by a power of `f`.**
Let `f` be homogeneous of positive degree and `δ` homogeneous. If at every point `𝔭` of
`Proj A` with `f ∉ 𝔭` some element outside `𝔭` kills `δ`, then `f ^ N δ = 0` for some `N`. -/
theorem ProjectiveSpectrum.exists_pow_mul_eq_zero_of_forall_mem_basicOpen {f δ : A} {m j : ℕ}
    (hm : 0 < m) (hf : f ∈ 𝒜 m) (hδ : δ ∈ 𝒜 j)
    (h : ∀ x : ProjectiveSpectrum 𝒜, f ∉ x.asHomogeneousIdeal →
      ∃ t ∉ x.asHomogeneousIdeal, t * δ = 0) :
    ∃ N : ℕ, f ^ N * δ = 0 := by
  set J : Ideal A := (Submodule.span A {δ}).annihilator with hJ
  have hJhom : J.IsHomogeneous 𝒜 := Submodule.isHomogeneous_annihilator_span_singleton hδ
  have hmemJ : ∀ t, t ∈ J ↔ t * δ = 0 := fun t => by
    rw [hJ, Submodule.mem_annihilator_span_singleton, smul_eq_mul]
  suffices hrad : f ∈ J.radical by
    obtain ⟨N, hN⟩ := hrad
    exact ⟨N, (hmemJ _).mp hN⟩
  rw [hJhom.radical_eq]
  refine Submodule.mem_sInf.mpr fun 𝔮 ⟨h𝔮hom, hJ𝔮, h𝔮prime⟩ => ?_
  by_contra hf𝔮
  let x : ProjectiveSpectrum 𝒜 :=
    { asHomogeneousIdeal := ⟨𝔮, h𝔮hom⟩
      isPrime := h𝔮prime
      not_irrelevant_le := fun hle => hf𝔮 (hle (by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
          decompose_of_mem_ne 𝒜 hf (Nat.pos_iff_ne_zero.mp hm)])) }
  obtain ⟨t, ht, htδ⟩ := h x hf𝔮
  exact ht (hJ𝔮 ((hmemJ t).mpr htδ))

namespace HomogeneousLocalization.Away

/-- **A ring map out of `A_{(f)}` is determined in degree one.** If `A` is generated over `𝒜 0` by
`𝒜 1` and `f ∈ 𝒜 1`, two ring maps out of `A_{(f)}` that agree on every fraction `g / f` with
`g ∈ 𝒜 1` are equal. -/
theorem ringHom_ext_of_adjoin_degreeOne {R : Type*} [CommRing R] {f : A} (hf : f ∈ 𝒜 1)
    (hgen : Algebra.adjoin (𝒜 0) ((𝒜 1 : σ) : Set A) = ⊤)
    {φ ψ : Away 𝒜 f →+* R}
    (h : ∀ (g : A) (hg : g ∈ 𝒜 (1 • 1)), φ (Away.mk 𝒜 hf 1 g hg) = ψ (Away.mk 𝒜 hf 1 g hg)) :
    φ = ψ := by
  classical
  -- both maps vanish on the fraction with numerator `0`
  have hzero : ∀ (n : ℕ) (x : A) (hx : x ∈ 𝒜 (n • 1)), x = 0 →
      φ (Away.mk 𝒜 hf n x hx) = ψ (Away.mk 𝒜 hf n x hx) := by
    rintro n x hx rfl
    have hmk : Away.mk 𝒜 hf n 0 hx = 0 := by
      ext
      simp only [Away.val_mk, Localization.mk_zero, val_zero]
    rw [hmk, map_zero, map_zero]
  -- the statement for every homogeneous component of every element of `A`
  have key : ∀ a : A, ∀ n : ℕ,
      φ (Away.mk 𝒜 hf n (decompose 𝒜 a (n • 1)) (decompose 𝒜 a (n • 1)).2) =
        ψ (Away.mk 𝒜 hf n (decompose 𝒜 a (n • 1)) (decompose 𝒜 a (n • 1)).2) := by
    intro a
    have ha : a ∈ Algebra.adjoin (𝒜 0) ((𝒜 1 : σ) : Set A) := hgen ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem g hg =>
        intro n
        by_cases hn : n = 1
        · subst hn
          have hdg : (decompose 𝒜 g (1 • 1) : A) = g := by
            simpa using decompose_of_mem_same 𝒜 (hg : g ∈ 𝒜 1)
          have hmk : Away.mk 𝒜 hf 1 (decompose 𝒜 g (1 • 1)) (decompose 𝒜 g (1 • 1)).2 =
              Away.mk 𝒜 hf 1 g (by simpa using hg) := by
            ext
            simp only [Away.val_mk, hdg]
          rw [hmk]
          exact h g _
        · have hdg : (decompose 𝒜 g (n • 1) : A) = 0 :=
            decompose_of_mem_ne 𝒜 (hg : g ∈ 𝒜 1) (by simpa using Ne.symm hn)
          exact hzero n _ _ hdg
    | algebraMap c =>
        intro n
        by_cases hn : n = 0
        · subst hn
          have hdc : (decompose 𝒜 (algebraMap (𝒜 0) A c) (0 • 1) : A) = c := by
            simp
          have hcf : (c : A) * f ∈ 𝒜 (1 • 1) := by
            simpa using SetLike.mul_mem_graded c.2 hf
          have hmk : Away.mk 𝒜 hf 0 (decompose 𝒜 (algebraMap (𝒜 0) A c) (0 • 1))
              (decompose 𝒜 (algebraMap (𝒜 0) A c) (0 • 1)).2 =
              Away.mk 𝒜 hf 1 ((c : A) * f) hcf := by
            ext
            simp only [Away.val_mk, hdc, pow_zero, pow_one]
            rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
            exact ⟨1, by simp [mul_comm]⟩
          rw [hmk]
          exact h _ hcf
        · have hdc : (decompose 𝒜 (algebraMap (𝒜 0) A c) (n • 1) : A) = 0 :=
            decompose_of_mem_ne 𝒜 c.2 (by simpa using Ne.symm hn)
          exact hzero n _ _ hdc
    | add a b _ _ iha ihb =>
        intro n
        have hmk : Away.mk 𝒜 hf n (decompose 𝒜 (a + b) (n • 1)) (decompose 𝒜 (a + b) (n • 1)).2 =
            Away.mk 𝒜 hf n (decompose 𝒜 a (n • 1)) (decompose 𝒜 a (n • 1)).2 +
              Away.mk 𝒜 hf n (decompose 𝒜 b (n • 1)) (decompose 𝒜 b (n • 1)).2 := by
          ext
          simp only [Away.val_mk, val_add, decompose_add, add_apply, AddMemClass.coe_add,
            Localization.add_mk_self]
        rw [hmk, map_add, map_add, iha, ihb]
    | mul a b _ _ iha ihb =>
        intro n
        have hmk : Away.mk 𝒜 hf n (decompose 𝒜 (a * b) (n • 1)) (decompose 𝒜 (a * b) (n • 1)).2 =
            ∑ ij ∈ Finset.antidiagonal n,
              Away.mk 𝒜 hf ij.1 (decompose 𝒜 a (ij.1 • 1)) (decompose 𝒜 a (ij.1 • 1)).2 *
                Away.mk 𝒜 hf ij.2 (decompose 𝒜 b (ij.2 • 1)) (decompose 𝒜 b (ij.2 • 1)).2 := by
          apply val_injective
          simp only [← algebraMap_apply, map_sum, map_mul]
          simp only [algebraMap_apply, Away.val_mk, Localization.mk_mul]
          have hdec : (decompose 𝒜 (a * b) (n • 1) : A) =
              ∑ ij ∈ Finset.antidiagonal n,
                (decompose 𝒜 a (ij.1 • 1) : A) * (decompose 𝒜 b (ij.2 • 1) : A) := by
            rw [decompose_mul, coe_mul_apply_eq_sum_antidiagonal]
            simp only [smul_eq_mul, mul_one]
            refine Finset.sum_congr rfl fun x _ => ?_
            rw [mul_one, mul_one]
          rw [hdec]
          have hden : ∀ ij ∈ Finset.antidiagonal n,
              Localization.mk ((decompose 𝒜 a (ij.1 • 1) : A) * (decompose 𝒜 b (ij.2 • 1) : A))
                (⟨f ^ ij.1, ⟨ij.1, rfl⟩⟩ * ⟨f ^ ij.2, ⟨ij.2, rfl⟩⟩ : Submonoid.powers f) =
              Localization.mk ((decompose 𝒜 a (ij.1 • 1) : A) * (decompose 𝒜 b (ij.2 • 1) : A))
                (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) := by
            intro ij hij
            congr 1
            apply Subtype.ext
            simp only [Submonoid.coe_mul, ← pow_add, (Finset.mem_antidiagonal.mp hij)]
          rw [Finset.sum_congr rfl hden, Localization.mk_sum]
        rw [hmk, map_sum, map_sum]
        refine Finset.sum_congr rfl fun ij _ => ?_
        rw [map_mul, map_mul, iha ij.1, ihb ij.2]
  ext x
  obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hf x
  have hda : (decompose 𝒜 a (n • 1) : A) = a := decompose_of_mem_same 𝒜 ha
  have hmk : Away.mk 𝒜 hf n a ha =
      Away.mk 𝒜 hf n (decompose 𝒜 a (n • 1)) (decompose 𝒜 a (n • 1)).2 := by
    ext
    simp only [Away.val_mk, hda]
  rw [hmk]
  exact key a n

end HomogeneousLocalization.Away

end
