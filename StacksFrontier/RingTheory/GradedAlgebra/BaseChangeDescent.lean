module

public import Mathlib.Algebra.Polynomial.Monic
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import StacksFrontier.LinearAlgebra.TensorProduct.SubmoduleFaithfullyFlatDescent

/-!
# Finiteness conditions on graded rings under base change and faithfully flat descent

Let `R ⟶ B` be a ring map into the degree-zero part of an `ℕ`-graded ring `B`, and let
`R ⟶ R'`, `B ⟶ B'` be a compatible pair of maps into a second graded ring `B'` over `R'` such
that `B'` is spanned over `R'` by the image of `B`. This file shows that the conditions of
Stacks 07ZX, 07ZY and 07ZZ on `B` pass to `B'`, and descend from a finite family of such `B'`
whose rings `R'` are jointly faithfully flat over `R`:

* `B` is of finite type over `B₀`;
* `R ⟶ B₀` is integral;
* `B` is of finite type over `R`;
* `B` is generated by `B₁` over `B₀` and `B₁` is a finite `B₀`-module;
* the irrelevant ideal `B₊` is nil modulo the ideal generated by a finitely generated
  `B₀`-submodule of `B₊`.

## Main definitions

* `Stacks.GradedBaseChange.spanVia`: the `R'`-span of a subset of `B'`, for the module structure
  given by a ring map `R' ⟶ B'`.
* `Stacks.GradedBaseChange.IsGradedBaseChange`: a compatible pair `(φ, Φ)` with `B'` spanned over
  `R'` by the image of `B`.
* `Stacks.GradedBaseChange.Kills`: the image of `b` in `R' ⊗_R (B/N)` vanishes as soon as `Φ b`
  lies in the `R'`-span of `Φ(N)`.
* `Stacks.GradedBaseChange.IsGradedDescentFamily`: a finite family of such pairs whose ring maps
  `R ⟶ R'ᵢ` have faithfully flat product.

## Main results

* `Stacks.GradedBaseChange.IsGradedDescentFamily.mem`: membership in an `R`-submodule of `B`
  descends along the family.
* The pairs `…_of_isGradedBaseChange` / `…_of_isGradedDescentFamily` for each of the five
  conditions above.
-/

@[expose] public section

open scoped TensorProduct

universe u v

namespace Stacks.GradedBaseChange

/-! ### Spans along a ring map -/

section SpanVia

variable {R' B' : Type*} [CommRing R'] [CommRing B'] (σ' : R' →+* B')

/-- The additive subgroup of `B'` generated by the products `σ' r * s` with `s ∈ S`: the
`R'`-span of `S` for the module structure on `B'` given by `σ'`. -/
def spanVia (S : Set B') : AddSubgroup B' :=
  AddSubgroup.closure {y | ∃ r : R', ∃ s ∈ S, y = σ' r * s}

variable {σ'}

/-- The product `σ' r * s` of a scalar and an element of `S` lies in the span of `S`. -/
theorem smul_mem_spanVia {S : Set B'} (r : R') {s : B'} (hs : s ∈ S) :
    σ' r * s ∈ spanVia σ' S :=
  AddSubgroup.subset_closure ⟨r, s, hs, rfl⟩

/-- A set lies in its span. -/
theorem mem_spanVia_of_mem {S : Set B'} {s : B'} (hs : s ∈ S) : s ∈ spanVia σ' S := by
  simpa using smul_mem_spanVia (σ' := σ') 1 hs

/-- The span is monotone in the spanning set. -/
theorem spanVia_mono {S T : Set B'} (h : S ⊆ T) : spanVia σ' S ≤ spanVia σ' T :=
  AddSubgroup.closure_mono fun _ ⟨r, s, hs, e⟩ => ⟨r, s, h hs, e⟩

/-- The span of `S` lies in every additive subgroup containing the products `σ' r * s` with
`s ∈ S`. -/
theorem spanVia_le {S : Set B'} {H : AddSubgroup B'} (h : ∀ r, ∀ s ∈ S, σ' r * s ∈ H) :
    spanVia σ' S ≤ H :=
  (AddSubgroup.closure_le _).2 fun _ ⟨r, s, hs, e⟩ => e ▸ h r s hs

/-- A span is closed under the scalars. -/
theorem mul_left_mem_spanVia {S : Set B'} (r : R') {y : B'} (hy : y ∈ spanVia σ' S) :
    σ' r * y ∈ spanVia σ' S := by
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨r', s, hs, rfl⟩ := hy
    rw [← mul_assoc, ← map_mul]
    exact smul_mem_spanVia _ hs
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | neg x _ hx => rw [mul_neg]; exact neg_mem hx

/-- The product of two spans lies in the span of the products. -/
theorem mul_mem_spanVia {S T U : Set B'} (hST : ∀ s ∈ S, ∀ t ∈ T, s * t ∈ U) {y z : B'}
    (hy : y ∈ spanVia σ' S) (hz : z ∈ spanVia σ' T) : y * z ∈ spanVia σ' U := by
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨r, s, hs, rfl⟩ := hy
    induction hz using AddSubgroup.closure_induction with
    | mem z hz =>
      obtain ⟨r', t, ht, rfl⟩ := hz
      have e : σ' r * s * (σ' r' * t) = σ' (r * r') * (s * t) := by rw [map_mul]; ring
      rw [e]
      exact smul_mem_spanVia _ (hST s hs t ht)
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
    | neg x _ hx => rw [mul_neg]; exact neg_mem hx
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | neg x _ hx => rw [neg_mul]; exact neg_mem hx

/-- An element of the span of an image lies in the span of the image of a finite subset. -/
theorem exists_finset_of_mem_spanVia {B : Type*} (f : B → B') {S : Set B} {y : B'}
    (hy : y ∈ spanVia σ' (f '' S)) :
    ∃ T : Finset B, (T : Set B) ⊆ S ∧ y ∈ spanVia σ' (f '' (T : Set B)) := by
  classical
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨r, s, ⟨b, hb, rfl⟩, rfl⟩ := hy
    exact ⟨{b}, by simpa using hb, smul_mem_spanVia _ ⟨b, by simp, rfl⟩⟩
  | zero => exact ⟨∅, by simp, zero_mem _⟩
  | add x y _ _ hx hy =>
    obtain ⟨T, hT, hxT⟩ := hx
    obtain ⟨T', hT', hyT'⟩ := hy
    refine ⟨T ∪ T', by rw [Finset.coe_union]; exact Set.union_subset hT hT', add_mem ?_ ?_⟩
    · exact spanVia_mono (Set.image_mono (by simp)) hxT
    · exact spanVia_mono (Set.image_mono (by simp)) hyT'
  | neg x _ hx =>
    obtain ⟨T, hT, hxT⟩ := hx
    exact ⟨T, hT, neg_mem hxT⟩

/-- An element of the span of a finite family is a linear combination of it. -/
theorem exists_eq_sum_of_mem_spanVia_range {ι : Type*} [Fintype ι] {v : ι → B'} {y : B'}
    (hy : y ∈ spanVia σ' (Set.range v)) : ∃ c : ι → R', y = ∑ i, σ' (c i) * v i := by
  classical
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨r, s, ⟨j, rfl⟩, rfl⟩ := hy
    refine ⟨Pi.single j r, ?_⟩
    rw [Finset.sum_eq_single j (fun i _ hij => by simp [Pi.single_eq_of_ne hij])
      (fun h => absurd (Finset.mem_univ j) h)]
    simp
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨c, rfl⟩ := hx
    obtain ⟨c', rfl⟩ := hy
    exact ⟨c + c', by simp [add_mul, Finset.sum_add_distrib]⟩
  | neg x _ hx =>
    obtain ⟨c, rfl⟩ := hx
    exact ⟨-c, by simp [Finset.sum_neg_distrib]⟩

/-- A span of a multiplicatively closed set containing `1` and the image of `K` is a
`K`-subalgebra. -/
def spanViaSubalgebra (K : Type*) [CommRing K] [Algebra K B'] (S : Set B') (h1 : (1 : B') ∈ S)
    (hmul : ∀ s ∈ S, ∀ t ∈ S, s * t ∈ S) (hK : ∀ k : K, algebraMap K B' k ∈ spanVia σ' S) :
    Subalgebra K B' where
  carrier := spanVia σ' S
  mul_mem' hy hz := mul_mem_spanVia hmul hy hz
  one_mem' := mem_spanVia_of_mem h1
  add_mem' := add_mem
  zero_mem' := zero_mem _
  algebraMap_mem' := hK

/-- Membership in `spanViaSubalgebra` is membership in the span. -/
theorem mem_spanViaSubalgebra (K : Type*) [CommRing K] [Algebra K B'] (S : Set B')
    (h1 : (1 : B') ∈ S) (hmul : ∀ s ∈ S, ∀ t ∈ S, s * t ∈ S)
    (hK : ∀ k : K, algebraMap K B' k ∈ spanVia σ' S) (y : B') :
    y ∈ spanViaSubalgebra K S h1 hmul hK ↔ y ∈ spanVia σ' S :=
  Iff.rfl

end SpanVia

/-! ### Integral elements through spans of powers -/

section Integral

variable {K L : Type*} [CommRing K] [CommRing L] (τ : K →+* L)

/-- **An integral element satisfies, in every high degree, a relation by lower powers.** -/
theorem exists_pow_mem_spanVia_of_isIntegralElem {z : L} (hz : τ.IsIntegralElem z) :
    ∃ m : ℕ, ∀ d ≥ m, z ^ d ∈ spanVia τ (Set.range fun j : Fin d => z ^ (j : ℕ)) := by
  obtain ⟨p, hp, hpz⟩ := hz
  refine ⟨p.natDegree, fun d hd => ?_⟩
  have hsum := Polynomial.eval₂_eq_sum_range (p := p) τ z
  rw [hpz, Finset.sum_range_succ, hp.coeff_natDegree, map_one, one_mul] at hsum
  have hm : z ^ p.natDegree = -∑ i ∈ Finset.range p.natDegree, τ (p.coeff i) * z ^ i :=
    eq_neg_of_add_eq_zero_right hsum.symm
  have hd' : z ^ d = z ^ (d - p.natDegree) * z ^ p.natDegree := by
    rw [← pow_add, Nat.sub_add_cancel hd]
  rw [hd', hm, mul_neg, Finset.mul_sum]
  refine neg_mem (sum_mem fun i hi => ?_)
  have hi' : i + (d - p.natDegree) < d := by
    have := Finset.mem_range.mp hi
    omega
  have e : z ^ (d - p.natDegree) * (τ (p.coeff i) * z ^ i) =
      τ (p.coeff i) * z ^ ((⟨i + (d - p.natDegree), hi'⟩ : Fin d) : ℕ) := by
    simp only [pow_add]
    ring
  rw [e]
  exact smul_mem_spanVia _ ⟨_, rfl⟩

/-- **A relation by lower powers makes an element integral.** -/
theorem isIntegralElem_of_pow_mem_spanVia {z : L} {d : ℕ}
    (hz : z ^ d ∈ spanVia τ (Set.range fun j : Fin d => z ^ (j : ℕ))) : τ.IsIntegralElem z := by
  obtain ⟨c, hc⟩ := exists_eq_sum_of_mem_spanVia_range hz
  refine ⟨Polynomial.X ^ d - ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ),
    Polynomial.monic_X_pow_sub (Polynomial.degree_sum_fin_lt c), ?_⟩
  simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
    Polynomial.eval₂_mul, Polynomial.eval₂_C]
  rw [← hc, sub_self]

end Integral

/-! ### Descent of membership -/

/-- For every `R`-submodule `N` of `B`, the image of `b` in `R' ⊗_R (B/N)` vanishes as soon as
`Φ b` lies in the `R'`-span of `Φ(N)`. -/
def Kills {R B R' B' : Type u} [CommRing R] [CommRing B] [CommRing R'] [CommRing B']
    (σ : R →+* B) (σ' : R' →+* B') (φ : R →+* R') (Φ : B →+* B') : Prop :=
  letI : Module R B := Module.compHom B σ
  letI := φ.toAlgebra
  ∀ (N : Submodule R B) (b : B), Φ b ∈ spanVia σ' (Φ '' N) →
    (1 : R') ⊗ₜ[R] N.mkQ b = 0

/-- **Membership descends along a faithfully flat family.** -/
theorem mem_of_forall_kills {ι : Type v} [Finite ι] {R B : Type u} [CommRing R] [CommRing B]
    (σ : R →+* B) {R'' B'' : ι → Type u} [∀ i, CommRing (R'' i)] [∀ i, CommRing (B'' i)]
    (σ'' : ∀ i, R'' i →+* B'' i) (φ'' : ∀ i, R →+* R'' i) (Φ'' : ∀ i, B →+* B'' i)
    (hff : (RingHom.pi φ'').FaithfullyFlat) (hk : ∀ i, Kills σ (σ'' i) (φ'' i) (Φ'' i))
    (N : AddSubgroup B) (hN : ∀ r x, x ∈ N → σ r * x ∈ N) (b : B)
    (hb : ∀ i, Φ'' i b ∈ spanVia (σ'' i) (Φ'' i '' N)) : b ∈ N := by
  classical
  let : Module R B := Module.compHom B σ
  let := fun i => (φ'' i).toAlgebra
  have _ : Fintype ι := Fintype.ofFinite ι
  have _ : Module.FaithfullyFlat R (∀ i, R'' i) := Module.faithfullyFlat_pi_of_ringHom_pi hff
  let N' : Submodule R B := { N with smul_mem' := fun r x hx => hN r x hx }
  change b ∈ N'
  refine (Submodule.Quotient.mk_eq_zero N').1
    ((Module.FaithfullyFlat.one_tmul_eq_zero_iff (A := ∀ i, R'' i) R (B ⧸ N') (N'.mkQ b)).1 ?_)
  have h1 : ∑ i : ι, Pi.single i (1 : R'' i) = (1 : ∀ i, R'' i) :=
    Finset.univ_sum_single (1 : ∀ i, R'' i)
  rw [← h1, TensorProduct.sum_tmul]
  refine Finset.sum_eq_zero fun i _ => ?_
  have hi := congrArg
    (LinearMap.rTensor (B ⧸ N') (ArtinReesBaseChange.piSingleLinearMap R R'' i))
    (hk i N' b (hb i))
  rwa [LinearMap.rTensor_tmul, map_zero, ArtinReesBaseChange.piSingleLinearMap_apply] at hi

/-! ### Compatible pairs and descent families -/

section Pairs

variable {R B R' B' : Type u} [CommRing R] [CommRing B] [CommRing R'] [CommRing B']
  {𝒜 : ℕ → AddSubgroup B} [GradedRing 𝒜] {𝒜' : ℕ → AddSubgroup B'} [GradedRing 𝒜']

/-- **A graded base change**: ring maps `σ : R ⟶ B₀`, `σ' : R' ⟶ B'₀`, a ring map
`φ : R ⟶ R'` and a graded ring map `Φ : B ⟶ B'` with `Φ ∘ σ = σ' ∘ φ`, such that `B'` is
spanned over `R'` by the image of `Φ`. -/
structure IsGradedBaseChange (σ : R →+* B) (σ' : R' →+* B') (φ : R →+* R') (Φ : 𝒜 →+*ᵍ 𝒜') :
    Prop where
  σ_mem : ∀ r, σ r ∈ 𝒜 0
  σ'_mem : ∀ r, σ' r ∈ 𝒜' 0
  comm : ∀ r, Φ (σ r) = σ' (φ r)
  mem_spanVia : ∀ y : B', y ∈ spanVia σ' (Set.range Φ)

/-- **A descent family**: a finite family of graded base changes of `B` whose ring maps
`R ⟶ R'ᵢ` have faithfully flat product, each satisfying `Kills`. -/
structure IsGradedDescentFamily {ι : Type v} [Finite ι] {R' B' : ι → Type u}
    [∀ i, CommRing (R' i)] [∀ i, CommRing (B' i)] {𝒜' : ∀ i, ℕ → AddSubgroup (B' i)}
    [∀ i, GradedRing (𝒜' i)] (σ : R →+* B) (σ' : ∀ i, R' i →+* B' i) (φ : ∀ i, R →+* R' i)
    (Φ : ∀ i, 𝒜 →+*ᵍ 𝒜' i) : Prop where
  σ_mem : ∀ r, σ r ∈ 𝒜 0
  bc : ∀ i, IsGradedBaseChange σ (σ' i) (φ i) (Φ i)
  ff : (RingHom.pi φ).FaithfullyFlat
  kills : ∀ i, Kills σ (σ' i) (φ i) (Φ i).toRingHom

variable {σ : R →+* B} {σ' : R' →+* B'} {φ : R →+* R'} {Φ : 𝒜 →+*ᵍ 𝒜'}

/-- **The degree-`n` piece of `B'` is spanned by the image of the degree-`n` piece of `B`.** -/
theorem IsGradedBaseChange.mem_spanVia_piece (h : IsGradedBaseChange σ σ' φ Φ) {n : ℕ} {y : B'}
    (hy : y ∈ 𝒜' n) : y ∈ spanVia σ' (Φ '' (𝒜 n : Set B)) := by
  classical
  have key : ∀ z ∈ spanVia σ' (Set.range Φ),
      (DirectSum.decompose 𝒜' z n : B') ∈ spanVia σ' (Φ '' (𝒜 n : Set B)) := by
    intro z hz
    induction hz using AddSubgroup.closure_induction with
    | mem z hz =>
      obtain ⟨r, s, ⟨b, rfl⟩, rfl⟩ := hz
      rw [DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜' (h.σ'_mem r),
        ← GradedRingHom.map_directSumDecompose]
      exact smul_mem_spanVia _ ⟨_, SetLike.coe_mem _, rfl⟩
    | zero => simp
    | add x y _ _ hx hy =>
      rw [DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add]
      exact add_mem hx hy
    | neg x _ hx =>
      have e : (DirectSum.decompose 𝒜' (-x) n : B') = -(DirectSum.decompose 𝒜' x n : B') := by
        rw [DirectSum.decompose_neg]
        rfl
      rw [e]
      exact neg_mem hx
  simpa [DirectSum.decompose_of_mem_same 𝒜' hy] using key y (h.mem_spanVia y)

/-- **The irrelevant ideal of `B'` is spanned by the image of the irrelevant ideal of `B`.** -/
theorem IsGradedBaseChange.mem_spanVia_irrelevant (h : IsGradedBaseChange σ σ' φ Φ) {y : B'}
    (hy : y ∈ HomogeneousIdeal.irrelevant 𝒜') :
    y ∈ spanVia σ' (Φ '' ((HomogeneousIdeal.irrelevant 𝒜).toIdeal : Set B)) := by
  classical
  have key : ∀ z ∈ spanVia σ' (Set.range Φ),
      z - (DirectSum.decompose 𝒜' z 0 : B') ∈
        spanVia σ' (Φ '' ((HomogeneousIdeal.irrelevant 𝒜).toIdeal : Set B)) := by
    intro z hz
    induction hz using AddSubgroup.closure_induction with
    | mem z hz =>
      obtain ⟨r, s, ⟨b, rfl⟩, rfl⟩ := hz
      rw [DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜' (h.σ'_mem r),
        ← GradedRingHom.map_directSumDecompose, ← mul_sub, ← map_sub]
      refine smul_mem_spanVia _ ⟨_, ?_, rfl⟩
      change GradedRing.proj 𝒜 0 (b - (DirectSum.decompose 𝒜 b 0 : B)) = 0
      simp [GradedRing.proj_apply, DirectSum.decompose_sub]
    | zero => simp
    | add x y _ _ hx hy =>
      rw [DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add,
        add_sub_add_comm]
      exact add_mem hx hy
    | neg x _ hx =>
      have e : -x - (DirectSum.decompose 𝒜' (-x) 0 : B') =
          -(x - (DirectSum.decompose 𝒜' x 0 : B')) := by
        have e' : (DirectSum.decompose 𝒜' (-x) 0 : B') = -(DirectSum.decompose 𝒜' x 0 : B') := by
          rw [DirectSum.decompose_neg]
          rfl
        rw [e']
        ring
      rw [e]
      exact neg_mem hx
  have hy0 : (DirectSum.decompose 𝒜' y 0 : B') = 0 := hy
  simpa [hy0] using key y (h.mem_spanVia y)

omit [GradedRing 𝒜] [GradedRing 𝒜'] in
/-- A surjective graded ring map over the identity of the base is a graded base change. -/
theorem isGradedBaseChange_of_surjective (hσ : ∀ r, σ r ∈ 𝒜 0) {σ₁ : R →+* B'}
    (hσ₁ : ∀ r, σ₁ r ∈ 𝒜' 0) {Ψ : 𝒜 →+*ᵍ 𝒜'} (hcomm : ∀ r, Ψ (σ r) = σ₁ r)
    (hΨ : Function.Surjective Ψ) : IsGradedBaseChange σ σ₁ (RingHom.id R) Ψ where
  σ_mem := hσ
  σ'_mem := hσ₁
  comm := hcomm
  mem_spanVia y := by
    obtain ⟨b, rfl⟩ := hΨ y
    simpa using smul_mem_spanVia (σ' := σ₁) (S := Set.range Ψ) 1 ⟨b, rfl⟩

section Family

variable {ι : Type v} [Finite ι] {R'' B'' : ι → Type u} [∀ i, CommRing (R'' i)]
  [∀ i, CommRing (B'' i)] {𝒜'' : ∀ i, ℕ → AddSubgroup (B'' i)} [∀ i, GradedRing (𝒜'' i)]
  {σ'' : ∀ i, R'' i →+* B'' i} {φ'' : ∀ i, R →+* R'' i} {Φ'' : ∀ i, 𝒜 →+*ᵍ 𝒜'' i}

omit [GradedRing 𝒜] in
/-- **Membership in an `R`-submodule of `B` descends along a descent family.** -/
theorem IsGradedDescentFamily.mem (hfam : IsGradedDescentFamily σ σ'' φ'' Φ'')
    (N : AddSubgroup B) (hN : ∀ r x, x ∈ N → σ r * x ∈ N) (b : B)
    (hb : ∀ i, Φ'' i b ∈ spanVia (σ'' i) (Φ'' i '' N)) : b ∈ N :=
  mem_of_forall_kills σ σ'' φ'' (fun i => (Φ'' i).toRingHom) hfam.ff
    hfam.kills N hN b hb

end Family

end Pairs

/-- Finite subsets `s i` of the `B'' i`, each lying in the span of the image of `P`, lie in the
spans of the images of one finite subset of `P`. -/
private theorem exists_finset_mem_spanVia_forall {ι : Type*} [Finite ι] {B : Type*}
    {R'' B'' : ι → Type*} [∀ i, CommRing (R'' i)] [∀ i, CommRing (B'' i)]
    {σ'' : ∀ i, R'' i →+* B'' i} {Φ : ∀ i, B → B'' i} {s : ∀ i, Finset (B'' i)} {P : Set B}
    (hs : ∀ i, ∀ y ∈ s i, y ∈ spanVia (σ'' i) (Φ i '' P)) :
    ∃ U : Finset B, (U : Set B) ⊆ P ∧
      ∀ i, ∀ y ∈ s i, y ∈ spanVia (σ'' i) (Φ i '' (U : Set B)) := by
  classical
  have := Fintype.ofFinite ι
  choose T hTsub hT using fun i y hy => exists_finset_of_mem_spanVia (Φ i) (hs i y hy)
  refine ⟨Finset.univ.biUnion fun i => (s i).attach.biUnion fun y => T i y.1 y.2,
    fun b hb => ?_, fun i y hy => spanVia_mono (Set.image_mono fun b hb => ?_) (hT i y hy)⟩
  · obtain ⟨i, -, hb⟩ := Finset.mem_biUnion.1 hb
    obtain ⟨y, -, hb⟩ := Finset.mem_biUnion.1 hb
    exact hTsub i y.1 y.2 hb
  · exact Finset.mem_biUnion.2 ⟨i, Finset.mem_univ _,
      Finset.mem_biUnion.2 ⟨⟨y, hy⟩, Finset.mem_attach _ _, hb⟩⟩

/-- The span of the image of `f` lies in a subring containing the scalars and the image of `f`. -/
private theorem spanVia_range_le_toAddSubgroup {R' B B' : Type*} [CommRing R'] [CommRing B']
    {σ' : R' →+* B'} {f : B → B'} (D : Subring B') (hσ : ∀ r, σ' r ∈ D) (hf : ∀ b, f b ∈ D) :
    spanVia σ' (Set.range f) ≤ D.toAddSubgroup :=
  spanVia_le fun r _ ⟨b, hb⟩ => hb ▸ D.mul_mem (hσ r) (hf b)

/-! ### The five conditions -/

section Conditions

variable {R B R' B' : Type u} [CommRing R] [CommRing B] [CommRing R'] [CommRing B']
  {𝒜 : ℕ → AddSubgroup B} [GradedRing 𝒜] {𝒜' : ℕ → AddSubgroup B'} [GradedRing 𝒜']
  {σ : R →+* B} {σ' : R' →+* B'} {φ : R →+* R'} {Φ : 𝒜 →+*ᵍ 𝒜'}

variable {ι : Type v} [Finite ι] {R'' B'' : ι → Type u} [∀ i, CommRing (R'' i)]
  [∀ i, CommRing (B'' i)] {𝒜'' : ∀ i, ℕ → AddSubgroup (B'' i)} [∀ i, GradedRing (𝒜'' i)]
  {σ'' : ∀ i, R'' i →+* B'' i} {φ'' : ∀ i, R →+* R'' i} {Φ'' : ∀ i, 𝒜 →+*ᵍ 𝒜'' i}

omit [GradedRing 𝒜] [GradedRing 𝒜'] in
/-- A graded ring map carries `B₀` into `B'₀`. -/
theorem map_mem_zero (Ψ : 𝒜 →+*ᵍ 𝒜') (b : 𝒜 0) : Ψ (b : B) ∈ 𝒜' 0 := Ψ.map_mem b.2

/-- The span of the image of a subring of `B` containing `B₀` is a `B'₀`-subalgebra of `B'`. -/
def spanViaSubalgebraZero (h : IsGradedBaseChange σ σ' φ Φ) (C : Subalgebra (𝒜 0) B) :
    Subalgebra (𝒜' 0) B' :=
  spanViaSubalgebra (σ' := σ') (𝒜' 0) (Φ '' (C : Set B)) ⟨1, C.one_mem, map_one Φ⟩
    (by
      rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
      exact ⟨x * y, C.mul_mem hx hy, map_mul Φ x y⟩)
    (fun k => spanVia_mono (Set.image_mono fun b hb =>
        (show algebraMap (𝒜 0) B ⟨b, hb⟩ ∈ C from C.algebraMap_mem _))
      (h.mem_spanVia_piece k.2))

/-- `B₀`-subalgebras of `B` are `R`-submodules. -/
theorem subalgebraZero_smul_mem (hσ : ∀ r, σ r ∈ 𝒜 0) (C : Subalgebra (𝒜 0) B)
    (r : R) (x : B) (hx : x ∈ C) : σ r * x ∈ C :=
  C.mul_mem (show algebraMap (𝒜 0) B ⟨σ r, hσ r⟩ ∈ C from C.algebraMap_mem _) hx

/-- `B₀`-submodules of `B` are closed under multiplication by `B₀`. -/
theorem mul_mem_submoduleZero (F : Submodule (𝒜 0) B) {a x : B} (ha : a ∈ 𝒜 0) (hx : x ∈ F) :
    a * x ∈ F := by
  have e : a * x = (⟨a, ha⟩ : 𝒜 0) • x := by rw [Algebra.smul_def]; rfl
  rw [e]
  exact F.smul_mem _ hx

/-- `B₀`-submodules of `B` are `R`-submodules. -/
theorem submoduleZero_smul_mem (hσ : ∀ r, σ r ∈ 𝒜 0) (F : Submodule (𝒜 0) B)
    (r : R) (x : B) (hx : x ∈ F) : σ r * x ∈ F :=
  mul_mem_submoduleZero F (hσ r) hx

/-- A graded ring map carries `B₊` into `B'₊`. -/
theorem map_mem_irrelevant (Ψ : 𝒜 →+*ᵍ 𝒜') {b : B} (hb : b ∈ HomogeneousIdeal.irrelevant 𝒜) :
    Ψ b ∈ HomogeneousIdeal.irrelevant 𝒜' := by
  rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hb ⊢
  rw [← GradedRingHom.map_directSumDecompose, hb, map_zero]

/-- A graded ring map carries the `B₀`-span of `t` into the `B'₀`-span of the image of `t`. -/
theorem map_mem_span_zero (Ψ : 𝒜 →+*ᵍ 𝒜') {t : Set B} {b : B}
    (hb : b ∈ Submodule.span (𝒜 0) t) : Ψ b ∈ Submodule.span (𝒜' 0) (Ψ '' t) := by
  induction hb using Submodule.span_induction with
  | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul a x _ hx =>
    have e : Ψ (a • x) = (⟨Ψ a, map_mem_zero Ψ a⟩ : 𝒜' 0) • Ψ x := by
      rw [Algebra.smul_def, Algebra.smul_def, map_mul]
      rfl
    rw [e]
    exact Submodule.smul_mem _ _ hx

/-! #### `B` of finite type over `B₀` -/

/-- **Finite type over the degree-zero part passes to a graded base change.** -/
theorem finiteType_zero_of_isGradedBaseChange (h : IsGradedBaseChange σ σ' φ Φ)
    (hft : Algebra.FiniteType (𝒜 0) B) : Algebra.FiniteType (𝒜' 0) B' := by
  classical
  obtain ⟨s, hs⟩ := hft.out
  refine ⟨⟨s.image Φ, ?_⟩⟩
  rw [eq_top_iff]
  intro y _
  set D := Algebra.adjoin (𝒜' 0) ((s.image Φ : Finset B') : Set B')
  have hΦ : ∀ b : B, Φ b ∈ D := by
    intro b
    have hb : b ∈ Algebra.adjoin (𝒜 0) (s : Set B) := hs ▸ Algebra.mem_top
    induction hb using Algebra.adjoin_induction with
    | mem x hx => exact Algebra.subset_adjoin (by simpa using ⟨x, hx, rfl⟩)
    | algebraMap r => exact D.algebraMap_mem ⟨_, map_mem_zero Φ r⟩
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  exact spanVia_range_le_toAddSubgroup D.toSubring
    (fun r => D.algebraMap_mem ⟨σ' r, h.σ'_mem r⟩) hΦ (h.mem_spanVia y)

/-- **Finite type over the degree-zero part descends along a descent family.** -/
theorem finiteType_zero_of_isGradedDescentFamily (hfam : IsGradedDescentFamily σ σ'' φ'' Φ'')
    (hft : ∀ i, Algebra.FiniteType (𝒜'' i 0) (B'' i)) : Algebra.FiniteType (𝒜 0) B := by
  classical
  have _ : Fintype ι := Fintype.ofFinite ι
  choose s hs using fun i => (hft i).out
  obtain ⟨Tall, -, hTall⟩ := exists_finset_mem_spanVia_forall (Φ := fun i => Φ'' i)
    (P := Set.univ) (s := s) fun i y _ => by simpa using (hfam.bc i).mem_spanVia y
  let C := Algebra.adjoin (𝒜 0) (Tall : Set B)
  refine ⟨⟨Tall, ?_⟩⟩
  rw [eq_top_iff]
  intro b _
  refine hfam.mem C.toSubring.toAddSubgroup
    (fun r x hx => subalgebraZero_smul_mem hfam.σ_mem C r x hx) b fun i => ?_
  have hle : Algebra.adjoin (𝒜'' i 0) (s i : Set (B'' i)) ≤
      spanViaSubalgebraZero (hfam.bc i) C :=
    Algebra.adjoin_le fun y hy =>
      spanVia_mono (Set.image_mono Algebra.subset_adjoin) (hTall i y hy)
  exact hle (by rw [hs i]; trivial)

/-! #### `R ⟶ B₀` integral -/

/-- Integrality of `R ⟶ B₀` read on the elements of `B₀` inside `B`. -/
theorem isIntegralElem_zero_iff (hσ : ∀ r, σ r ∈ 𝒜 0) (x : 𝒜 0) :
    ((GradedRing.projZeroRingHom' 𝒜).comp σ).IsIntegralElem x ↔ σ.IsIntegralElem (x : B) := by
  have hg : Function.Injective (algebraMap (𝒜 0) B) := Subtype.val_injective
  rw [← RingHom.IsIntegralElem.map_iff (g := algebraMap (𝒜 0) B) hg]
  have e : (algebraMap (𝒜 0) B).comp ((GradedRing.projZeroRingHom' 𝒜).comp σ) = σ := by
    ext r
    simp [GradedRing.projZeroRingHom_apply, DirectSum.decompose_of_mem_same 𝒜 (hσ r)]
  rw [e]
  rfl

/-- **Integrality of `R ⟶ B₀` passes to a graded base change.** -/
theorem isIntegral_zero_of_isGradedBaseChange (h : IsGradedBaseChange σ σ' φ Φ)
    (hint : ((GradedRing.projZeroRingHom' 𝒜).comp σ).IsIntegral) :
    ((GradedRing.projZeroRingHom' 𝒜').comp σ').IsIntegral := by
  intro y
  rw [isIntegralElem_zero_iff h.σ'_mem]
  let := σ'.toAlgebra
  have hle : spanVia σ' (Φ '' (𝒜 0 : Set B)) ≤ (integralClosure R' B').toSubring.toAddSubgroup :=
    spanVia_le fun r _ ⟨b, hb, e⟩ => by
      subst e
      refine (integralClosure R' B').mul_mem isIntegral_algebraMap ?_
      have hΦb := ((isIntegralElem_zero_iff h.σ_mem ⟨b, hb⟩).1 (hint ⟨b, hb⟩)).map Φ.toRingHom
      rw [show Φ.toRingHom.comp σ = σ'.comp φ from RingHom.ext h.comm] at hΦb
      exact hΦb.of_comp
  exact hle (h.mem_spanVia_piece y.2)

/-- **Integrality of `R ⟶ B₀` descends along a descent family.** -/
theorem isIntegral_zero_of_isGradedDescentFamily (hfam : IsGradedDescentFamily σ σ'' φ'' Φ'')
    (hint : ∀ i, ((GradedRing.projZeroRingHom' (𝒜'' i)).comp (σ'' i)).IsIntegral) :
    ((GradedRing.projZeroRingHom' 𝒜).comp σ).IsIntegral := by
  classical
  have _ : Fintype ι := Fintype.ofFinite ι
  intro x
  rw [isIntegralElem_zero_iff hfam.σ_mem]
  have hi : ∀ i, (σ'' i).IsIntegralElem (Φ'' i x) := fun i =>
    (isIntegralElem_zero_iff (hfam.bc i).σ'_mem ⟨_, map_mem_zero (Φ'' i) x⟩).1 (hint i _)
  choose m hm using fun i => exists_pow_mem_spanVia_of_isIntegralElem _ (hi i)
  let d := Finset.univ.sup m
  refine isIntegralElem_of_pow_mem_spanVia σ (d := d) ?_
  refine hfam.mem _ (fun r y hy => mul_left_mem_spanVia r hy) _ fun i => ?_
  rw [map_pow]
  refine spanVia_mono ?_ (hm i d (Finset.le_sup (Finset.mem_univ i)))
  rintro _ ⟨j, rfl⟩
  exact ⟨(x : B) ^ (j : ℕ), mem_spanVia_of_mem ⟨j, rfl⟩, map_pow _ _ _⟩

/-! #### `B` of finite type over `R` -/

omit [GradedRing 𝒜] [GradedRing 𝒜'] in
/-- **Finite type over the base passes to a graded base change.** -/
theorem finiteType_of_isGradedBaseChange (h : IsGradedBaseChange σ σ' φ Φ)
    (hft : σ.FiniteType) : σ'.FiniteType := by
  classical
  let := σ.toAlgebra
  let := σ'.toAlgebra
  have hft' : Algebra.FiniteType R B := hft
  obtain ⟨s, hs⟩ := hft'.out
  change Algebra.FiniteType R' B'
  refine ⟨⟨s.image Φ, ?_⟩⟩
  rw [eq_top_iff]
  intro y _
  set D := Algebra.adjoin R' ((s.image Φ : Finset B') : Set B')
  have hΦ : ∀ b : B, Φ b ∈ D := by
    intro b
    have hb : b ∈ Algebra.adjoin R (s : Set B) := hs ▸ Algebra.mem_top
    induction hb using Algebra.adjoin_induction with
    | mem x hx => exact Algebra.subset_adjoin (by simpa using ⟨x, hx, rfl⟩)
    | algebraMap r =>
      rw [show algebraMap R B r = σ r from rfl, h.comm]
      exact D.algebraMap_mem (φ r)
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  exact spanVia_range_le_toAddSubgroup D.toSubring
    (fun r => D.algebraMap_mem r) hΦ (h.mem_spanVia y)

omit [GradedRing 𝒜] in
/-- **Finite type over the base descends along a descent family.** -/
theorem finiteType_of_isGradedDescentFamily (hfam : IsGradedDescentFamily σ σ'' φ'' Φ'')
    (hft : ∀ i, (σ'' i).FiniteType) : σ.FiniteType := by
  classical
  have _ : Fintype ι := Fintype.ofFinite ι
  let := σ.toAlgebra
  let := fun i => (σ'' i).toAlgebra
  have hft' : ∀ i, Algebra.FiniteType (R'' i) (B'' i) := hft
  choose s hs using fun i => (hft' i).out
  obtain ⟨Tall, -, hTall⟩ := exists_finset_mem_spanVia_forall (Φ := fun i => Φ'' i)
    (P := Set.univ) (s := s) fun i y _ => by simpa using (hfam.bc i).mem_spanVia y
  let C := Algebra.adjoin R (Tall : Set B)
  change Algebra.FiniteType R B
  refine ⟨⟨Tall, ?_⟩⟩
  rw [eq_top_iff]
  intro b _
  refine hfam.mem C.toSubring.toAddSubgroup
    (fun r x hx => C.mul_mem (C.algebraMap_mem r) hx) b fun i => ?_
  let E : Subalgebra (R'' i) (B'' i) :=
    spanViaSubalgebra (σ' := σ'' i) (R'' i) (Φ'' i '' (C : Set B)) ⟨1, C.one_mem, map_one _⟩
      (by
        rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
        exact ⟨x * y, C.mul_mem hx hy, map_mul _ x y⟩)
      (fun k => by
        change (σ'' i) k ∈ _
        simpa using smul_mem_spanVia (σ' := σ'' i) (S := Φ'' i '' (C : Set B)) k
          ⟨1, C.one_mem, map_one (Φ'' i)⟩)
  have hle : Algebra.adjoin (R'' i) (s i : Set (B'' i)) ≤ E :=
    Algebra.adjoin_le fun y hy =>
      spanVia_mono (Set.image_mono Algebra.subset_adjoin) (hTall i y hy)
  exact hle (by rw [hs i]; trivial)

/-! #### `B` generated by a finite `B₁` -/

/-- **Generation by a finite degree-one part passes to a graded base change.** -/
theorem finitelyGeneratedInDegreeOne_of_isGradedBaseChange (h : IsGradedBaseChange σ σ' φ Φ)
    (hfg : Algebra.adjoin (𝒜 0) (𝒜 1 : Set B) = ⊤ ∧ ∃ t : Finset B,
      (t : Set B) ⊆ (𝒜 1 : Set B) ∧
        (𝒜 1 : Set B) ⊆ (Submodule.span (𝒜 0) (t : Set B) : Set B)) :
    Algebra.adjoin (𝒜' 0) (𝒜' 1 : Set B') = ⊤ ∧ ∃ t : Finset B',
      (t : Set B') ⊆ (𝒜' 1 : Set B') ∧
        (𝒜' 1 : Set B') ⊆ (Submodule.span (𝒜' 0) (t : Set B') : Set B') := by
  classical
  obtain ⟨hadj, t, ht1, htspan⟩ := hfg
  refine ⟨?_, t.image Φ, ?_, ?_⟩
  · rw [eq_top_iff]
    intro y _
    set D := Algebra.adjoin (𝒜' 0) (𝒜' 1 : Set B')
    have hΦ : ∀ b : B, Φ b ∈ D := by
      intro b
      have hb : b ∈ Algebra.adjoin (𝒜 0) (𝒜 1 : Set B) := hadj ▸ Algebra.mem_top
      induction hb using Algebra.adjoin_induction with
      | mem x hx => exact Algebra.subset_adjoin (Φ.map_mem hx)
      | algebraMap r => exact D.algebraMap_mem ⟨_, map_mem_zero Φ r⟩
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    exact spanVia_range_le_toAddSubgroup D.toSubring
      (fun r => D.algebraMap_mem ⟨σ' r, h.σ'_mem r⟩) hΦ (h.mem_spanVia y)
  · rw [Finset.coe_image]
    rintro _ ⟨b, hb, rfl⟩
    exact Φ.map_mem (ht1 hb)
  · intro y hy
    rw [Finset.coe_image]
    have hle : spanVia σ' (Φ '' (𝒜 1 : Set B)) ≤
        (Submodule.span (𝒜' 0) (Φ '' (t : Set B))).toAddSubgroup :=
      spanVia_le fun r _ ⟨b, hb, e⟩ => by
        subst e
        exact submoduleZero_smul_mem h.σ'_mem _ r _ (map_mem_span_zero Φ (htspan hb))
    exact hle (h.mem_spanVia_piece hy)

/-- **Generation by a finite degree-one part descends along a descent family.** -/
theorem finitelyGeneratedInDegreeOne_of_isGradedDescentFamily
    (hfam : IsGradedDescentFamily σ σ'' φ'' Φ'')
    (hfg : ∀ i, Algebra.adjoin (𝒜'' i 0) (𝒜'' i 1 : Set (B'' i)) = ⊤ ∧
      ∃ t : Finset (B'' i), (t : Set (B'' i)) ⊆ (𝒜'' i 1 : Set (B'' i)) ∧
        (𝒜'' i 1 : Set (B'' i)) ⊆
          (Submodule.span (𝒜'' i 0) (t : Set (B'' i)) : Set (B'' i))) :
    Algebra.adjoin (𝒜 0) (𝒜 1 : Set B) = ⊤ ∧ ∃ t : Finset B,
      (t : Set B) ⊆ (𝒜 1 : Set B) ∧
        (𝒜 1 : Set B) ⊆ (Submodule.span (𝒜 0) (t : Set B) : Set B) := by
  classical
  have _ : Fintype ι := Fintype.ofFinite ι
  refine ⟨?_, ?_⟩
  · let C := Algebra.adjoin (𝒜 0) (𝒜 1 : Set B)
    rw [eq_top_iff]
    intro b _
    refine hfam.mem C.toSubring.toAddSubgroup
      (fun r x hx => subalgebraZero_smul_mem hfam.σ_mem C r x hx) b fun i => ?_
    have hle : Algebra.adjoin (𝒜'' i 0) (𝒜'' i 1 : Set (B'' i)) ≤
        spanViaSubalgebraZero (hfam.bc i) C :=
      Algebra.adjoin_le fun y hy =>
        spanVia_mono (Set.image_mono Algebra.subset_adjoin) ((hfam.bc i).mem_spanVia_piece hy)
    exact hle (by rw [(hfg i).1]; trivial)
  · choose t ht1 htspan using fun i => (hfg i).2
    obtain ⟨Tall, hTallsub, hTall⟩ := exists_finset_mem_spanVia_forall (Φ := fun i => Φ'' i)
      (s := t) fun i y hy => (hfam.bc i).mem_spanVia_piece (ht1 i hy)
    refine ⟨Tall, hTallsub, fun b hb => ?_⟩
    let F := Submodule.span (𝒜 0) (Tall : Set B)
    refine hfam.mem F.toAddSubgroup (fun r x hx => submoduleZero_smul_mem hfam.σ_mem F r x hx)
      b fun i => ?_
    let W : Submodule (𝒜'' i 0) (B'' i) :=
      { carrier := spanVia (σ'' i) (Φ'' i '' (F : Set B))
        add_mem' := add_mem
        zero_mem' := zero_mem _
        smul_mem' := fun a w hw => by
          rw [Algebra.smul_def, SetLike.GradeZero.algebraMap_apply]
          refine mul_mem_spanVia (S := Φ'' i '' (𝒜 0 : Set B)) ?_
            ((hfam.bc i).mem_spanVia_piece a.2) hw
          rintro _ ⟨a', ha', rfl⟩ _ ⟨n, hn, rfl⟩
          exact ⟨a' * n, mul_mem_submoduleZero F ha' hn, map_mul _ _ _⟩ }
    have hle : Submodule.span (𝒜'' i 0) (t i : Set (B'' i)) ≤ W :=
      Submodule.span_le.2 fun y hy =>
        spanVia_mono (Set.image_mono Submodule.subset_span) (hTall i y hy)
    exact hle (htspan i ((Φ'' i).map_mem hb))

/-! #### `B₊` nil modulo a finitely generated part -/

/-- **Local nilpotence of `B₊` modulo a finitely generated part passes to a graded base
change.** -/
theorem hasNilpotentPositiveQuotient_of_isGradedBaseChange (h : IsGradedBaseChange σ σ' φ Φ)
    (hnpq : ∃ F : Submodule (𝒜 0) B,
      (F : Set B) ⊆ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ∧ F.FG ∧
      ∀ x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal, ∃ n : ℕ, x ^ n ∈ Ideal.span (F : Set B)) :
    ∃ F : Submodule (𝒜' 0) B',
      (F : Set B') ⊆ (HomogeneousIdeal.irrelevant 𝒜').toIdeal ∧ F.FG ∧
      ∀ x ∈ (HomogeneousIdeal.irrelevant 𝒜').toIdeal,
        ∃ n : ℕ, x ^ n ∈ Ideal.span (F : Set B') := by
  classical
  obtain ⟨F, hFirr, ⟨t, ht⟩, hnil⟩ := hnpq
  let F' := Submodule.span (𝒜' 0) (Φ '' (F : Set B))
  have hF'eq : F' = Submodule.span (𝒜' 0) (Φ '' (t : Set B)) :=
    le_antisymm (Submodule.span_le.2 fun _ ⟨b, hb, e⟩ => e ▸ map_mem_span_zero Φ (ht ▸ hb))
      (Submodule.span_mono (Set.image_mono (ht ▸ Submodule.subset_span)))
  refine ⟨F', ?_, ⟨t.image Φ, by rw [Finset.coe_image, hF'eq]⟩, ?_⟩
  · intro y hy
    have hle : F' ≤ (HomogeneousIdeal.irrelevant 𝒜').toIdeal.restrictScalars (𝒜' 0) :=
      Submodule.span_le.2 fun _ ⟨b, hb, e⟩ => e ▸ map_mem_irrelevant Φ (hFirr hb)
    exact hle hy
  · intro y hy
    have hle : spanVia σ' (Φ '' ((HomogeneousIdeal.irrelevant 𝒜).toIdeal : Set B)) ≤
        (Ideal.span (F' : Set B')).radical.toAddSubgroup :=
      spanVia_le fun r _ ⟨b, hb, e⟩ => by
        subst e
        refine Ideal.mul_mem_left _ _ ?_
        obtain ⟨n, hn⟩ := hnil b hb
        refine ⟨n, ?_⟩
        rw [← map_pow]
        have hmap : Φ (b ^ n) ∈ Ideal.map Φ (Ideal.span (F : Set B)) := Ideal.mem_map_of_mem _ hn
        rw [Ideal.map_span] at hmap
        exact Ideal.span_mono Submodule.subset_span hmap
    exact hle (h.mem_spanVia_irrelevant hy)

/-- **Local nilpotence of `B₊` modulo a finitely generated part descends along a descent
family.** -/
theorem hasNilpotentPositiveQuotient_of_isGradedDescentFamily
    (hfam : IsGradedDescentFamily σ σ'' φ'' Φ'')
    (hnpq : ∀ i, ∃ F : Submodule (𝒜'' i 0) (B'' i),
      (F : Set (B'' i)) ⊆ (HomogeneousIdeal.irrelevant (𝒜'' i)).toIdeal ∧ F.FG ∧
      ∀ x ∈ (HomogeneousIdeal.irrelevant (𝒜'' i)).toIdeal,
        ∃ n : ℕ, x ^ n ∈ Ideal.span (F : Set (B'' i))) :
    ∃ F : Submodule (𝒜 0) B,
      (F : Set B) ⊆ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ∧ F.FG ∧
      ∀ x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal, ∃ n : ℕ, x ^ n ∈ Ideal.span (F : Set B) := by
  classical
  have _ : Fintype ι := Fintype.ofFinite ι
  choose F' hF'irr hF'fg hF'nil using hnpq
  choose t' ht' using fun i => hF'fg i
  obtain ⟨Tall, hTallsub, hTall⟩ := exists_finset_mem_spanVia_forall (Φ := fun i => Φ'' i)
    (s := t') fun i y hy => (hfam.bc i).mem_spanVia_irrelevant
      (hF'irr i (ht' i ▸ Submodule.subset_span hy))
  let F := Submodule.span (𝒜 0) (Tall : Set B)
  refine ⟨F, ?_, ⟨Tall, rfl⟩, ?_⟩
  · intro y hy
    have hle : F ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal.restrictScalars (𝒜 0) :=
      Submodule.span_le.2 hTallsub
    exact hle hy
  · intro x hx
    choose n hn using fun i => hF'nil i _ (map_mem_irrelevant (Φ'' i) hx)
    let N := Finset.univ.sup n
    let I := Ideal.span (F : Set B)
    refine ⟨N, hfam.mem I.toAddSubgroup (fun r y hy => I.mul_mem_left _ hy) _ fun i => ?_⟩
    let J : Ideal (B'' i) :=
      { carrier := spanVia (σ'' i) (Φ'' i '' (I : Set B))
        add_mem' := add_mem
        zero_mem' := zero_mem _
        smul_mem' := fun z w hw => by
          rw [smul_eq_mul]
          refine mul_mem_spanVia (S := Set.range (Φ'' i)) ?_ ((hfam.bc i).mem_spanVia z) hw
          rintro _ ⟨b, rfl⟩ _ ⟨c, hc, rfl⟩
          exact ⟨b * c, I.mul_mem_left _ hc, map_mul _ _ _⟩ }
    have hF'J : F' i ≤ J.restrictScalars (𝒜'' i 0) := by
      rw [← ht' i]
      exact Submodule.span_le.2 fun y hy =>
        spanVia_mono (Set.image_mono (Submodule.subset_span.trans Ideal.subset_span))
          (hTall i y hy)
    have hle : Ideal.span (F' i : Set (B'' i)) ≤ J := Ideal.span_le.2 fun y hy => hF'J hy
    rw [map_pow]
    exact hle (Ideal.pow_mem_of_pow_mem _ (hn i) (Finset.le_sup (Finset.mem_univ i)))

end Conditions

end Stacks.GradedBaseChange

