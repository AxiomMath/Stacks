/-!
# Graded pieces of a finitely generated graded module

Let `S = ⨁_{n ≥ 0} S_n` be a graded ring and `M = ⨁_{n ∈ ℤ} M_n` a graded `S`-module. If `M` is
finitely generated as an `S`-module and `S` is finitely generated as an `S_0`-algebra, then each
graded piece `M_n` is a finite `S_0`-module.

## Main definitions

* `gradePieceSubmodule`: The graded piece `𝒜 k` of `S`, as an `𝒜 0`-submodule of `S`.

## Main results

* `exists_finset_homogeneous_span_eq_top`: A finitely generated graded `S`-module is generated by
  finitely many homogeneous elements.
* `fg_gradePieceSubmodule`: Each graded piece of `S` is a finitely generated `𝒜 0`-module.
* `graded_module_pieces_finite`: Each graded piece `M_n` is a finite `S_0`-module.

## Implementation notes

The ring `S` is graded by `ℕ` via `GradedRing 𝒜` for `𝒜 : ℕ → AddSubgroup S`, which includes
the direct sum decomposition `S = ⨁ n, 𝒜 n`. The module `M` is graded by `ℤ` via
`DirectSum.Decomposition ℳ` for `ℳ : ℤ → Submodule (𝒜 0) M`, where `M` is an `𝒜 0`-module by
restriction of scalars; the compatibility `S_d · M_e ⊆ M_{d+e}` is an explicit hypothesis.
Generators of `S` over `S_0` may have arbitrary positive degree.
-/

@[expose] public section
section GradedModuleFG

variable {S : Type*} [CommRing S]
variable (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
variable {M : Type*} [AddCommGroup M] [Module S M]

/-- The `S_0`-module structure on `M`, where `S_0 = 𝒜 0`, obtained by restriction of scalars along
`S_0 → S`. -/
noncomputable local instance instModuleZero : Module (𝒜 0) M :=
  Module.compHom M (algebraMap (𝒜 0) S)

/-- The actions of `𝒜 0` and `S` on `M` form a scalar tower. -/
local instance instTowerZero : IsScalarTower (𝒜 0) S M := by
  refine ⟨fun a s m => ?_⟩
  change ((a • s) • m : M) = (↑a : S) • s • m
  rw [Algebra.smul_def, mul_smul]
  rfl

/-- The degree-`k` graded piece `𝒜 k` of `S`, as an `𝒜 0`-submodule of `S`. -/
@[ega "II 2.1.1", ega "II 2.4.5" "case A = S_0"]
def gradePieceSubmodule (k : ℕ) : Submodule (𝒜 0) S where
  carrier := (𝒜 k : Set S)
  add_mem' := AddSubgroup.add_mem _
  zero_mem' := AddSubgroup.zero_mem _
  smul_mem' := by
    intro c s hs
    change (c : S) • s ∈ 𝒜 k
    rw [Algebra.smul_def]
    have : ((algebraMap (𝒜 0) S) c) * s ∈ 𝒜 (0 + k) :=
      SetLike.mul_mem_graded (SetLike.coe_mem _) hs
    simpa using this

/-- An element of `S` lies in `gradePieceSubmodule 𝒜 k` if and only if it lies in `𝒜 k`. -/
@[simp]
theorem mem_gradePieceSubmodule {k : ℕ} {s : S} : s ∈ gradePieceSubmodule 𝒜 k ↔ s ∈ 𝒜 k :=
  Iff.rfl

/-- The underlying set of `gradePieceSubmodule 𝒜 k` is `𝒜 k`. -/
@[simp]
theorem coe_gradePieceSubmodule (k : ℕ) : (gradePieceSubmodule 𝒜 k : Set S) = 𝒜 k :=
  rfl

/-- If `M` is a finitely generated `S`-module, then it is generated as an `S`-module by a finite
set of homogeneous elements. -/
theorem exists_finset_homogeneous_span_eq_top (ℳ : ℤ → Submodule (𝒜 0) M)
    [DirectSum.Decomposition ℳ] (hM : Module.Finite S M) :
    ∃ x : Finset M, (∀ y ∈ x, ∃ d : ℤ, y ∈ ℳ d) ∧ Submodule.span S (↑x : Set M) = ⊤ := by
  classical
  obtain ⟨G, hG⟩ := Module.finite_def.mp hM
  refine
    ⟨G.biUnion
        (fun g =>
          (DirectSum.decompose ℳ g).support.image (fun d => ((DirectSum.decompose ℳ g) d : M))),
      ?_, ?_⟩
  · intro y hy
    simp only [Finset.mem_biUnion, Finset.mem_image] at hy
    obtain ⟨g, _, d, _, rfl⟩ := hy
    exact ⟨d, SetLike.coe_mem _⟩
  · rw [eq_top_iff, ← hG, Submodule.span_le]
    intro g hg
    rw [SetLike.mem_coe, ← DirectSum.sum_support_decompose ℳ g]
    apply Submodule.sum_mem
    intro d hd
    apply Submodule.subset_span
    simp only [Finset.coe_biUnion, Finset.coe_image, Set.mem_iUnion]
    refine ⟨g, hg, ?_⟩
    simp only [Set.mem_image, Finset.mem_coe]
    exact ⟨d, hd, rfl⟩

/-- If `t` is a finite set of homogeneous elements of positive degree, then the degree-`k`
projections of the monomials in `t` form a finite set. -/
theorem finite_proj_image_closure {t : Finset S} (htdeg : ∀ f ∈ t, ∃ e : ℕ, e ≠ 0 ∧ f ∈ 𝒜 e)
    (k : ℕ) : (GradedRing.proj 𝒜 k '' Submonoid.closure (↑t : Set S)).Finite := by
  classical
  choose e he₁ he₂ using htdeg
  apply Set.Finite.subset ((Set.finite_range fun (a : t → Fin (k + 1)) =>
    ∏ f ∈ t.attach, (f : S) ^ (a f).val).insert 0)
  rintro y ⟨m, hm, rfl⟩
  obtain ⟨a, -, rfl⟩ := Submonoid.mem_closure_finset.1 hm
  have hdeg : (∏ f ∈ t, f ^ (a f)) ∈ 𝒜 (∑ f ∈ t.attach, (a f) • e f f.property) := by
    have :=
      SetLike.prod_pow_mem_graded (κ := { x // x ∈ t }) (fun f => e f.val f.property)
        (fun f => (f : S)) (F := t.attach) (n := fun f => a f.val) (A := 𝒜)
        fun f _ => he₂ f.val f.property
    rw [Finset.prod_attach t (fun f => f ^ (a f))] at this
    convert this using 2
  set d := ∑ f ∈ t.attach, (a f) • e f f.property
  by_cases hdk : d = k
  · subst hdk
    rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hdeg]
    right
    refine ⟨fun f => ⟨a f.val, ?_⟩, by rw [← Finset.prod_attach t (fun f => f ^ (a f))]⟩
    have h₁ := Finset.single_le_sum (f := fun f : { x // x ∈ t } => (a f.val) • e f.val f.property)
      (fun _ _ => by positivity) (Finset.mem_attach _ f)
    have h₂ : a f.val ≤ a f.val • e f.val f.property :=
      Nat.le_mul_of_pos_right _ (Nat.pos_of_ne_zero (he₁ f.val f.property))
    omega
  · left
    rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒜 hdeg hdk]

/-- If `S` is a finitely generated `𝒜 0`-algebra, then each graded piece `𝒜 k` is a finitely
generated `𝒜 0`-module. -/
theorem fg_gradePieceSubmodule [Algebra.FiniteType (𝒜 0) S] (k : ℕ) :
    (gradePieceSubmodule 𝒜 k).FG := by
  classical
  obtain ⟨t, htadj, htdeg⟩ := GradedAlgebra.exists_finset_adjoin_eq_top_and_homogeneous_ne_zero 𝒜
  let L : S →ₗ[𝒜 0] S :=
    { toFun := fun x => GradedRing.proj 𝒜 k x
      map_add' := by simp
      map_smul' := by
        intro c x
        change (GradedRing.proj 𝒜 k) ((c : S) * x) = (c : S) * (GradedRing.proj 𝒜 k) x
        rw [GradedRing.proj_apply, GradedRing.proj_apply,
          DirectSum.coe_decompose_mul_of_left_mem 𝒜 k (SetLike.coe_mem c)]
        simp }
  have hspan :
      (⊤ : Submodule (𝒜 0) S) =
        Submodule.span (𝒜 0) (↑(Submonoid.closure (↑t : Set S)) : Set S) := by
    have h := Algebra.adjoin_eq_span (𝒜 0) (↑t : Set S)
    rwa [htadj, Algebra.top_toSubmodule] at h
  have hrange : gradePieceSubmodule 𝒜 k = LinearMap.range L :=
    le_antisymm (fun x hx => ⟨x, DirectSum.decompose_of_mem_same 𝒜 hx⟩)
      (by rintro _ ⟨x, rfl⟩; exact SetLike.coe_mem _)
  rw [hrange, LinearMap.range_eq_map, hspan, Submodule.map_span]
  exact Submodule.fg_span (finite_proj_image_closure 𝒜 htdeg k)

/-- If `y ∈ ℳ e`, then for every `s : S` the degree-`n` component of `s • y` lies in
`𝒜 (n - e) • y` (which is `0` when `n < e`). -/
theorem decompose_smul_mem (ℳ : ℤ → Submodule (𝒜 0) M) [DirectSum.Decomposition ℳ]
    (hsmul : ∀ (d : ℕ) (e : ℤ) (s : S), s ∈ 𝒜 d → ∀ m : M, m ∈ ℳ e → s • m ∈ ℳ ((d : ℤ) + e))
    {y : M} {e : ℤ} (hy : y ∈ ℳ e) (n : ℤ) (s : S) :
    (DirectSum.decompose ℳ (s • y) n : M) ∈
      if 0 ≤ n - e then
        Submodule.map ((LinearMap.toSpanSingleton S M y).restrictScalars (𝒜 0))
          (gradePieceSubmodule 𝒜 (n - e).toNat)
      else ⊥ := by
  induction s using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | @homogeneous k s =>
    have hmem := hsmul k e s s.2 y hy
    by_cases hkn : (k : ℤ) + e = n
    · rw [DirectSum.decompose_of_mem_same ℳ (hkn ▸ hmem), ite_eq_left (show 0 ≤ n - e by omega)]
      apply Submodule.mem_map_of_mem
      change (s : S) ∈ 𝒜 (n - e).toNat
      rw [show (n - e).toNat = k by omega]
      exact s.2
    · rw [DirectSum.decompose_of_mem_ne ℳ hmem hkn]
      exact Submodule.zero_mem _
  | add a b ha hb =>
    rw [add_smul, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem ha hb

/-- If `M` is generated as an `S`-module by a finite set `x` of homogeneous elements and `S` is a
finitely generated `𝒜 0`-algebra, then each graded piece `ℳ n` is a finite `𝒜 0`-module. -/
theorem module_finite_of_span_homogeneous (ℳ : ℤ → Submodule (𝒜 0) M) [DirectSum.Decomposition ℳ]
    (hsmul : ∀ (d : ℕ) (e : ℤ) (s : S), s ∈ 𝒜 d → ∀ m : M, m ∈ ℳ e → s • m ∈ ℳ ((d : ℤ) + e))
    [Algebra.FiniteType (𝒜 0) S] (x : Finset M) (hxdeg : ∀ y ∈ x, ∃ d : ℤ, y ∈ ℳ d)
    (hxspan : Submodule.span S (↑x : Set M) = ⊤) (n : ℤ) : Module.Finite (𝒜 0) (ℳ n) := by
  classical
  rw [Module.Finite.iff_fg]
  choose deg hdeg using hxdeg
  let N : (z : { z // z ∈ x }) → Submodule (𝒜 0) M := fun z =>
    if 0 ≤ n - deg z.val z.property then
      Submodule.map ((LinearMap.toSpanSingleton S M z.val).restrictScalars (𝒜 0))
        (gradePieceSubmodule 𝒜 (n - deg z.val z.property).toNat)
    else ⊥
  have hNle : ∀ z, N z ≤ ℳ n := by
    intro z
    simp only [N]
    split_ifs with hpos
    · rintro _ ⟨s, hs, rfl⟩
      have := hsmul _ _ s hs z.val (hdeg z.val z.property)
      rwa [show ((n - deg z.val z.property).toNat : ℤ) + deg z.val z.property = n by omega]
        at this
    · exact bot_le
  have hspaneq : ℳ n = ⨆ z, N z := by
    refine le_antisymm (fun m hm => ?_) (iSup_le hNle)
    obtain ⟨c, -, hc⟩ :=
      Submodule.mem_span_finset.1 (hxspan ▸ Submodule.mem_top : m ∈ Submodule.span S (↑x : Set M))
    rw [← DirectSum.decompose_of_mem_same ℳ hm, ← hc, ← Finset.sum_attach x fun y => c y • y,
      DirectSum.decompose_sum, DFinsupp.finsetSum_apply, Submodule.coe_sum]
    exact Submodule.sum_mem _ fun z _ => Submodule.mem_iSup_of_mem z
      (decompose_smul_mem 𝒜 ℳ hsmul (hdeg z.val z.property) n (c z.val))
  rw [hspaneq]
  refine Submodule.fg_iSup _ fun z => ?_
  simp only [N]
  split_ifs
  · exact Submodule.FG.map _ (fg_gradePieceSubmodule 𝒜 _)
  · exact Submodule.fg_bot

/-- **Stacks 00K0**.
Let `S = ⨁_{n ≥ 0} 𝒜 n` be a graded ring and `M = ⨁_{n ∈ ℤ} ℳ n` a graded `S`-module, with
`S_d · M_e ⊆ M_{d+e}`. If `M` is finitely generated as an `S`-module and `S` is finitely
generated as an `𝒜 0`-algebra, then every graded piece `ℳ n` is a finite `𝒜 0`-module. -/
@[stacks 00K0, ega "II 2.1.6" "(i)"]
theorem graded_module_pieces_finite (ℳ : ℤ → Submodule (𝒜 0) M) [DirectSum.Decomposition ℳ]
    (hsmul : ∀ (d : ℕ) (e : ℤ) (s : S), s ∈ 𝒜 d → ∀ m : M, m ∈ ℳ e → s • m ∈ ℳ ((d : ℤ) + e))
    (hM : Module.Finite S M)
    (hS : Algebra.FiniteType (𝒜 0) S) : ∀ n : ℤ, Module.Finite (𝒜 0) (ℳ n) := by
  obtain ⟨x, hxdeg, hxspan⟩ := exists_finset_homogeneous_span_eq_top 𝒜 ℳ hM
  have := hS
  exact module_finite_of_span_homogeneous 𝒜 ℳ hsmul x hxdeg hxspan

end GradedModuleFG

