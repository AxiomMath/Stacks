/-!
# Generators of a graded ring and of its irrelevant ideal

Stacks Project, Tag 07Z4.

Throughout, $S$ denotes a graded ring: a commutative ring equipped with a direct
sum decomposition (as an abelian group) $S = \bigoplus_{d \ge 0} S_d$ indexed by
the non-negative integers, satisfying $S_d \cdot S_e \subseteq S_{d+e}$. In
particular $S_0$ is a subring of $S$ (containing $1$), and each $S_d$ is an
$S_0$-module.

## Definitions

1. Homogeneous element: $x \in S$ is homogeneous of degree $d$ if $x \in S_d$.

2. The irrelevant ideal $S_+ = \bigoplus_{d \ge 1} S_d$, i.e. the elements with
   zero degree-$0$ component. This is an ideal of $S$.

3. Generation as an $S_0$-algebra: a family $(f_i)_{i \in I}$ generates $S$ as an
   algebra over $S_0$ if the smallest $S_0$-subalgebra containing all the $f_i$
   is $S$ itself.

4. Generation of an ideal: $(f_i)_{i \in I}$ generates $S_+$ as an ideal of $S$
   if the smallest ideal of $S$ containing all the $f_i$ equals $S_+$.

## Main results
Let $S$ be a graded ring and let $(f_i)_{i \in I}$ be a family of homogeneous
elements with $f_i \in S_+$ for every $i$ (i.e. each $f_i$ is homogeneous of
strictly positive degree). Then the following are equivalent:

1. The family $(f_i)$ generates $S$ as an algebra over $S_0$.
2. The family $(f_i)$ generates $S_+$ as an ideal of $S$.

Reference: <https://stacks.math.columbia.edu/tag/07Z4>.
-/

@[expose] public section
/-
## Formalization notes

We model the graded ring $S$ by a type `A` with a `CommRing` structure together
with a grading `𝒜 : ℕ → σ` (where `σ` is a `SetLike` family of additive
submonoids) satisfying `[GradedRing 𝒜]`.

The `GradedRing 𝒜` class is exactly Mathlib's interface for the graded-ring data
in the informal problem. It bundles two pieces:

* The multiplicative compatibility `S_d · S_e ⊆ S_{d+e}` together with
  `1 ∈ S_0` (via the `GradedMonoid` / `SetLike.GradedMonoid` component), and

* The genuine direct-sum decomposition `S = ⨁_{d} S_d`, via the
  `DirectSum.Decomposition 𝒜` component which `GradedRing` extends. Concretely,
  `(inferInstance : DirectSum.Decomposition 𝒜)` succeeds, so every element of
  `A` decomposes uniquely as a finite sum of its homogeneous components. We also
  list `[DirectSum.Decomposition 𝒜]` explicitly below to make this hypothesis
  visible, even though it is already implied by `[GradedRing 𝒜]`.

* The degree-$0$ piece $S_0$ is the carrier subring `↥(𝒜 0)`. Mathlib provides a
  canonical `Algebra ↥(𝒜 0) A` instance, so "generates $S$ as an algebra over
  $S_0$" (Definition 3) is `Algebra.adjoin ↥(𝒜 0) (Set.range f) = ⊤`.

* The irrelevant ideal $S_+$ (Definition 2) is
  `(HomogeneousIdeal.irrelevant 𝒜).toIdeal`, which by
  `HomogeneousIdeal.mem_irrelevant_iff` consists of the elements whose
  degree-$0$ projection is zero.

* "Generates $S_+$ as an ideal" (Definition 4) is
  `Ideal.span (Set.range f) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal`.

* The hypothesis "$f_i \in S_+$ is homogeneous of strictly positive degree" is
  expressed via a degree function `d : I → ℕ` with `0 < d i` and `f i ∈ 𝒜 (d i)`.
  Indeed an element of `𝒜 (d i)` with `0 < d i` automatically lies in the
  irrelevant ideal.
-/

open DirectSum

section Helpers

variable {σ A : Type*}
variable [CommRing A] [SetLike σ A] [AddSubmonoidClass σ A]
variable (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- If `b` is homogeneous of degree `j` and `n < j`, then the degree-`n`
homogeneous component of `a * b` vanishes, since every homogeneous component of
`a * b` lives in a degree `≥ j > n`. -/
theorem proj_mul_eq_zero_of_lt (a b : A) (j n : ℕ) (hb : b ∈ 𝒜 j) (hlt : n < j) :
    (GradedRing.proj 𝒜 n) (a * b) = 0 := by
  rw [GradedRing.proj_apply, DirectSum.coe_decompose_mul_of_right_mem_of_not_le 𝒜 hb (by omega)]

/-- A homogeneous element of degree `i ≠ n` has vanishing degree-`n` projection. -/
theorem proj_eq_zero_of_mem_ne {x : A} {i n : ℕ} (hx : x ∈ 𝒜 i) (hne : i ≠ n) :
    (GradedRing.proj 𝒜 n) x = 0 := by
  rw [GradedRing.proj_apply]
  exact DirectSum.decompose_of_mem_ne 𝒜 hx hne

/-- A homogeneous element of degree `i` is its own degree-`i` projection. -/
theorem proj_eq_self_of_mem {x : A} {i : ℕ} (hx : x ∈ 𝒜 i) :
    (GradedRing.proj 𝒜 i) x = x := by
  rw [GradedRing.proj_apply]
  exact DirectSum.decompose_of_mem_same 𝒜 hx

/-- The degree-`n` projection of a homogeneous element of degree `i` lies in `𝒜 n`. -/
theorem proj_mem (x : A) (n : ℕ) : (GradedRing.proj 𝒜 n) x ∈ 𝒜 n := by
  rw [GradedRing.proj_apply]
  exact SetLike.coe_mem _

/-- The degree-`n` homogeneous component of `a * b` (for `b` of degree `j ≤ n`)
equals `(proj (n - j) a) * b`. -/
theorem proj_mul_eq (a b : A) (j n : ℕ) (hb : b ∈ 𝒜 j) (hle : j ≤ n) :
    (GradedRing.proj 𝒜 n) (a * b) = (GradedRing.proj 𝒜 (n - j)) a * b := by
  rw [GradedRing.proj_apply, GradedRing.proj_apply,
    DirectSum.coe_decompose_mul_of_right_mem_of_le 𝒜 hb hle]

end Helpers

variable {σ A : Type*}
variable [CommRing A] [SetLike σ A] [AddSubmonoidClass σ A]
variable (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- A homogeneous element of positive degree lies in the irrelevant ideal. -/
@[ega "II 2.1.1" "S_n ⊆ S_+ for n > 0"]
theorem mem_irrelevant_of_mem_of_pos {x : A} {n : ℕ} (hx : x ∈ 𝒜 n) (hn : 0 < n) :
    x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  change x ∈ HomogeneousIdeal.irrelevant 𝒜
  rw [HomogeneousIdeal.mem_irrelevant_iff]
  exact proj_eq_zero_of_mem_ne 𝒜 hx (by omega)

/-- Every element of the `𝒜 0`-subalgebra generated by `s` differs from a degree-zero
constant by an element of the ideal generated by `s`. -/
theorem exists_sub_mem_span_of_mem_adjoin {s : Set A} {x : A}
    (hx : x ∈ Algebra.adjoin (↥(𝒜 0)) s) : ∃ c : ↥(𝒜 0), x - (c : A) ∈ Ideal.span s := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact ⟨0, by simpa using Ideal.subset_span hx⟩
  | algebraMap r => exact ⟨r, by simp⟩
  | add x y _ _ ihx ihy =>
    obtain ⟨cx, hcx⟩ := ihx
    obtain ⟨cy, hcy⟩ := ihy
    refine ⟨cx + cy, ?_⟩
    rw [AddMemClass.coe_add, show x + y - ((cx : A) + cy) = (x - cx) + (y - cy) by ring]
    exact Ideal.add_mem _ hcx hcy
  | mul x y _ _ ihx ihy =>
    obtain ⟨cx, hcx⟩ := ihx
    obtain ⟨cy, hcy⟩ := ihy
    refine ⟨cx * cy, ?_⟩
    rw [SetLike.GradeZero.coe_mul cx cy,
      show x * y - ((cx : A) * cy) = (x - cx) * y + (cx : A) * (y - cy) by ring]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hcx) (Ideal.mul_mem_left _ _ hcy)

/-- If a family of homogeneous elements of positive degree generates the irrelevant ideal,
then every homogeneous element lies in the `𝒜 0`-subalgebra it generates. -/
@[ega "II 2.1.3" "necessity"]
theorem mem_adjoin_of_span_eq_irrelevant {I : Type*} (f : I → A) (d : I → ℕ)
    (hd : ∀ i, 0 < d i) (hf : ∀ i, f i ∈ 𝒜 (d i))
    (hspan : Ideal.span (Set.range f) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal) (n : ℕ) :
    ∀ x ∈ 𝒜 n, x ∈ Algebra.adjoin (↥(𝒜 0)) (Set.range f) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro x hx
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact Subalgebra.algebraMap_mem _ (⟨x, hx⟩ : ↥(𝒜 0))
    have hxirr : x ∈ Ideal.span (Set.range f) := hspan ▸ mem_irrelevant_of_mem_of_pos 𝒜 hx hn
    obtain ⟨m, c, g, hsum⟩ := Submodule.mem_span_set'.mp hxirr
    rw [← proj_eq_self_of_mem 𝒜 hx, ← hsum, map_sum]
    refine Subalgebra.sum_mem _ fun k _ ↦ ?_
    obtain ⟨idx, hidx⟩ := (g k).property
    rw [smul_eq_mul, ← hidx]
    by_cases hcase : d idx ≤ n
    · rw [proj_mul_eq 𝒜 _ _ (d idx) n (hf idx) hcase]
      exact Subalgebra.mul_mem _ (ih (n - d idx) (by have := hd idx; omega) _ (proj_mem 𝒜 _ _))
        (Algebra.subset_adjoin ⟨idx, rfl⟩)
    · rw [proj_mul_eq_zero_of_lt 𝒜 _ _ (d idx) n (hf idx) (by omega)]
      exact Subalgebra.zero_mem _

/-- Stacks Tag 07Z4: for a family `(f i)` of homogeneous elements of strictly
positive degree in a graded ring `A` with grading `𝒜` (the `GradedRing 𝒜`
hypothesis, together with the explicit `DirectSum.Decomposition 𝒜`, encodes the
direct-sum decomposition `A = ⨁_d 𝒜 d`), the family generates `A` as an algebra
over the degree-zero subring `𝒜 0` if and only if it generates the irrelevant
ideal `S₊` as an ideal of `A`. -/
@[stacks 07Z4, ega "II 2.1.3", ega "II 2.1.4" "partial"]
theorem generates_algebra_iff_generates_irrelevant
    {I : Type*} (f : I → A) (d : I → ℕ)
    (hd : ∀ i, 0 < d i) (hf : ∀ i, f i ∈ 𝒜 (d i)) :
    Algebra.adjoin ↥(𝒜 0) (Set.range f) = ⊤ ↔
    Ideal.span (Set.range f) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  classical
  have hspan_le : Ideal.span (Set.range f) ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal :=
    Ideal.span_le.mpr (Set.range_subset_iff.mpr fun i ↦
      mem_irrelevant_of_mem_of_pos 𝒜 (hf i) (hd i))
  refine ⟨fun hadj ↦ le_antisymm hspan_le fun x hx ↦ ?_, fun hspan ↦ ?_⟩
  · obtain ⟨c, hc⟩ := exists_sub_mem_span_of_mem_adjoin 𝒜 (hadj ▸ Algebra.mem_top : x ∈ _)
    have hxc : (c : A) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      rw [show (c : A) = x - (x - c) by ring]
      exact (HomogeneousIdeal.irrelevant 𝒜).toIdeal.sub_mem hx (hspan_le hc)
    rw [HomogeneousIdeal.mem_irrelevant_iff, proj_eq_self_of_mem 𝒜 c.property] at hxc
    simpa [hxc] using hc
  · rw [eq_top_iff]
    rintro x -
    induction x using DirectSum.Decomposition.inductionOn 𝒜 with
    | zero => exact Subalgebra.zero_mem _
    | homogeneous m => exact mem_adjoin_of_span_eq_irrelevant 𝒜 f d hd hf hspan _ _ m.property
    | add x y hx hy => exact Subalgebra.add_mem _ hx hy
