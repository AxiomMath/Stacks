module

public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.AwayFraction
public import StacksFrontier.RingTheory.GradedAlgebra.Veronese

/-!
# The degree-zero localization at an element of a Veronese generating degree

Let `A = ⨁_{n ≥ 0} 𝒜 n` be a graded ring and `d > 0` a degree for which the Veronese subring
`A^{(d)}` is generated in degree one over `𝒜 0`, in the sense of
`Stacks.Veronese.VeroneseGeneratedInDegOne`. Let `b j` be elements of `𝒜 d` spanning `𝒜 d` over
`𝒜 0`, and let `f ∈ 𝒜 d`. Then the degree-zero part `A_{(f)}` of the localization at `f` is
generated as a ring by the image of `𝒜 0` and the fractions `b j / f`.

## Main results

* `Stacks.VeroneseAwayClosure.mem_closure_mk_of_mem_span`: a fraction `x / f` with `x` in the
  `𝒜 0`-span of the `b j` lies in that subring.
* `Stacks.VeroneseAwayClosure.mem_closure`: **every element of `A_{(f)}` lies in the subring
  generated by `𝒜 0` and the `b j / f`.**

## References

* [Stacks Project, Tag 0E8V](https://stacks.math.columbia.edu/tag/0E8V)
* [Stacks Project, Tag 01N0](https://stacks.math.columbia.edu/tag/01N0)
-/

@[expose] public section

open HomogeneousLocalization

universe u w

namespace Stacks.VeroneseAwayClosure

variable {A : Type u} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

variable {d : ℕ} {f : A} (hf : f ∈ 𝒜 d) {ι : Type*} (b : ι → A) (hb : ∀ j, b j ∈ 𝒜 d)

/-- **The subring of `A_{(f)}` generated by `𝒜 0` and the fractions `b j / f`.** -/
abbrev closureSubring : Subring (Away 𝒜 f) :=
  Subring.closure (Set.range (fromZeroRingHom 𝒜 (Submonoid.powers f)) ∪
    Set.range fun j => Away.mk 𝒜 hf 1 (b j) (by simpa using hb j))

/-- **The image of a degree-zero element is its fraction over `f⁰`.** -/
theorem fromZeroRingHom_eq_mk {c : A} (hc : c ∈ 𝒜 0) (h0 : c ∈ 𝒜 (0 • d)) :
    fromZeroRingHom 𝒜 (Submonoid.powers f) ⟨c, hc⟩ = Away.mk 𝒜 hf 0 c h0 := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.Away.val_mk]
  change Localization.mk c 1 = _
  congr 1
  ext
  simp

/-- **The fraction of a degree-zero element times a fraction.** `(c x) / f^n = c · (x / f^n)` for
`c ∈ 𝒜 0`. -/
theorem mk_mul_left_of_mem_zero {n : ℕ} {c x : A} (hc : c ∈ 𝒜 0) (hx : x ∈ 𝒜 (n • d))
    (hcx : c * x ∈ 𝒜 (n • d)) :
    Away.mk 𝒜 hf n (c * x) hcx =
      fromZeroRingHom 𝒜 (Submonoid.powers f) ⟨c, hc⟩ * Away.mk 𝒜 hf n x hx := by
  have hc' : c ∈ 𝒜 (0 • d) := by simpa using hc
  rw [Stacks.AwayFraction.mk_mul 𝒜 hf (by omega : n = 0 + n) hcx hc' hx,
    fromZeroRingHom_eq_mk 𝒜 hf hc hc']

/-- **The `𝒜 0`-span of elements of `𝒜 e` lies in `𝒜 e`.** -/
theorem span_subset {e : ℕ} {s : Set A} (hs : s ⊆ (𝒜 e : Set A)) :
    (Submodule.span (Stacks.Veronese.gradeZero 𝒜) s : Set A) ⊆ (𝒜 e : Set A) := by
  intro x hx
  rw [SetLike.mem_coe] at hx ⊢
  induction hx using Submodule.span_induction with
  | mem z hz => exact hs hz
  | zero => exact zero_mem _
  | add y z _ _ hy hz => exact add_mem hy hz
  | smul a y _ hy =>
    have : (a • y : A) ∈ 𝒜 (0 + e) := SetLike.mul_mem_graded a.property hy
    rwa [zero_add] at this

/-- A subring containing `𝒜 0` contains `x / f^n` for `x` in the `𝒜 0`-span of a set `s ⊆ 𝒜 (n d)`
as soon as it contains the fractions of the elements of `s`. -/
private theorem mk_mem_of_mem_span {S : Subring (Away 𝒜 f)}
    (hS : Set.range (fromZeroRingHom 𝒜 (Submonoid.powers f)) ⊆ S) {n : ℕ} {s : Set A}
    (hs : s ⊆ (𝒜 (n • d) : Set A))
    (hgen : ∀ y, y ∈ s → ∀ hy : y ∈ 𝒜 (n • d), Away.mk 𝒜 hf n y hy ∈ S) {x : A}
    (hx : x ∈ Submodule.span (Stacks.Veronese.gradeZero 𝒜) s) (hxd : x ∈ 𝒜 (n • d)) :
    Away.mk 𝒜 hf n x hxd ∈ S := by
  have hsub := span_subset 𝒜 hs
  induction hx using Submodule.span_induction with
  | mem z hz => exact hgen z hz hxd
  | zero =>
    rw [Stacks.Veronese.awayMk_zero 𝒜 hf n hxd]
    exact zero_mem _
  | add y z hy hz ihy ihz =>
    rw [← Stacks.Veronese.awayMk_add 𝒜 hf n (hsub hy) (hsub hz) hxd]
    exact add_mem (ihy (hsub hy)) (ihz (hsub hz))
  | smul a y hy ihy =>
    change Away.mk 𝒜 hf n ((a : A) * y) hxd ∈ _
    rw [mk_mul_left_of_mem_zero 𝒜 hf a.property (hsub hy) hxd]
    exact mul_mem (hS ⟨_, rfl⟩) (ihy (hsub hy))

/-- **A fraction `x / f` with `x` in the `𝒜 0`-span of the `b j` lies in the subring generated by
`𝒜 0` and the `b j / f`.** -/
theorem mem_closure_mk_of_mem_span {x : A}
    (hx : x ∈ Submodule.span (Stacks.Veronese.gradeZero 𝒜) (Set.range b))
    (hxd : x ∈ 𝒜 (1 • d)) :
    Away.mk 𝒜 hf 1 x hxd ∈ closureSubring 𝒜 hf b hb :=
  mk_mem_of_mem_span 𝒜 hf (fun _ h ↦ Subring.subset_closure (Or.inl h))
    (by rintro _ ⟨j, rfl⟩; simpa using hb j)
    (by rintro _ ⟨j, rfl⟩ _; exact Subring.subset_closure (Or.inr ⟨j, rfl⟩)) hx hxd

/-- **Every element of `A_{(f)}` lies in the subring generated by `𝒜 0` and the fractions
`b j / f`**, when the `b j` span `𝒜 d` over `𝒜 0` and `A^{(d)}` is generated in degree one. -/
theorem mem_closure (hspan : (𝒜 d : Set A) ⊆
      (Submodule.span (Stacks.Veronese.gradeZero 𝒜) (Set.range b) : Set A))
    (hver : Stacks.Veronese.VeroneseGeneratedInDegOne 𝒜 d) (z : Away 𝒜 f) :
    z ∈ closureSubring 𝒜 hf b hb := by
  obtain ⟨n, x, hx, rfl⟩ := Away.mk_surjective 𝒜 hf z
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [← fromZeroRingHom_eq_mk 𝒜 hf (by simpa using hx) hx]
    exact Subring.subset_closure (Or.inl ⟨_, rfl⟩)
  have hxs : x ∈ Submodule.span (Stacks.Veronese.gradeZero 𝒜)
      (Stacks.Veronese.degOneProducts 𝒜 d n) := by
    have h : x ∈ (𝒜 (n * d) : Set A) := by rwa [← smul_eq_mul]
    rwa [hver n hn] at h
  refine mk_mem_of_mem_span 𝒜 hf (fun _ h ↦ Subring.subset_closure (Or.inl h)) ?_ ?_ hxs hx
  · rw [smul_eq_mul]
    exact Submodule.subset_span.trans (Stacks.Veronese.span_degOneProducts_subset 𝒜 d n)
  · rintro _ ⟨g, hg, rfl⟩ hy
    have hg1 : ∀ i, g i ∈ 𝒜 (1 • d) := fun i ↦ by simpa using hg i
    rw [Stacks.AwayFraction.mk_prod 𝒜 hf Finset.univ (fun _ ↦ 1) g hg1 (by simp) hy]
    exact prod_mem fun i _ ↦ mem_closure_mk_of_mem_span 𝒜 hf b hb (hspan (hg i)) (hg1 i)

end Stacks.VeroneseAwayClosure

end
