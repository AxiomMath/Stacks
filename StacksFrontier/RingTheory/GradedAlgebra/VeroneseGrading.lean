@[expose] public section

open DirectSum

namespace DirectSum

variable {ι M σ : Type*} [DecidableEq ι] [AddCommMonoid M] [SetLike σ M]
  [AddSubmonoidClass σ M]

/-- The `i`-th homogeneous projection attached to an internal decomposition
`ℳ`, as an additive map. This is `GradedRing.proj` with the multiplicative
hypotheses dropped: only `DirectSum.Decomposition ℳ` is needed, so it also
applies to graded modules. -/
def decompositionProj (ℳ : ι → σ) [Decomposition ℳ] (i : ι) : M →+ M :=
  (AddSubmonoidClass.subtype (ℳ i)).comp <|
    (DFinsupp.evalAddMonoidHom i).comp (decomposeAddEquiv ℳ).toAddMonoidHom

/-- The projection `decompositionProj ℳ i` evaluates the `i`-th component of the decomposition. -/
@[simp]
theorem decompositionProj_apply (ℳ : ι → σ) [Decomposition ℳ] (i : ι) (x : M) :
    decompositionProj ℳ i x = (decompose ℳ x : ⨁ i, ℳ i) i :=
  rfl

/-- A homogeneous element is fixed by the projection onto its own degree. -/
theorem decompositionProj_of_mem_same (ℳ : ι → σ) [Decomposition ℳ] {i : ι} {x : M}
    (hx : x ∈ ℳ i) : decompositionProj ℳ i x = x :=
  decompose_of_mem_same ℳ hx

/-- A homogeneous element is killed by the projection onto any other degree. -/
theorem decompositionProj_of_mem_ne (ℳ : ι → σ) [Decomposition ℳ] {i j : ι} {x : M}
    (hx : x ∈ ℳ i) (hij : i ≠ j) : decompositionProj ℳ j x = 0 :=
  decompose_of_mem_ne ℳ hx hij

end DirectSum

namespace Stacks.Veronese

/-- A family of subgroups of `Q`, placed in the degrees `e i` of a decomposition of `N` by an
injective map `φ`, has an injective internal sum when `e` is injective. -/
private theorem injective_coeAddMonoidHom_of_decomposition {ι κ N Q σ : Type*} [DecidableEq ι]
    [DecidableEq κ] [AddCommGroup N] [AddCommGroup Q] [SetLike σ N] [AddSubgroupClass σ N]
    (φ : Q →+ N) (hφ : Function.Injective φ) (G : ι → AddSubgroup Q) (ℳ : κ → σ)
    [Decomposition ℳ] (e : ι → κ) (he : Function.Injective e)
    (hG : ∀ i x, x ∈ G i → φ x ∈ ℳ (e i)) : Function.Injective (DirectSum.coeAddMonoidHom G) := by
  classical
  rw [injective_iff_map_eq_zero]
  intro z hz
  refine DFinsupp.ext fun i₀ => ?_
  by_cases hmem : i₀ ∈ z.support
  · have hsum : ∑ i ∈ z.support, φ (z i) = 0 := by
      have := congrArg φ ((DirectSum.sum_support_of z).symm ▸ hz)
      simpa [map_sum] using this
    have hzero := congrArg (decompositionProj ℳ (e i₀)) hsum
    rw [map_sum, map_zero, Finset.sum_eq_single_of_mem i₀ hmem ?_] at hzero
    · rw [decompositionProj_of_mem_same ℳ (hG _ _ (z i₀).2)] at hzero
      exact Subtype.ext (hφ (by simpa using hzero))
    · intro i _ hne
      exact decompositionProj_of_mem_ne ℳ (hG _ _ (z i).2) fun h => hne (he h)
  · simpa using DFinsupp.notMem_support_iff.mp hmem

/-- If `φ` is injective, an element of `Q` whose image lies in the subgroup generated by `X`
is in the internal sum of `G`, as soon as every element of `X` is the image of one. -/
private theorem exists_coeAddMonoidHom_eq_of_mem_closure {ι N Q : Type*} [DecidableEq ι]
    [AddCommGroup N] [AddCommGroup Q] (φ : Q →+ N) (hφ : Function.Injective φ)
    (G : ι → AddSubgroup Q) (X : Set N)
    (hX : ∀ x ∈ X, ∃ z : ⨁ i, G i, φ (DirectSum.coeAddMonoidHom G z) = x) {y : Q}
    (hy : φ y ∈ AddSubgroup.closure X) : ∃ z : ⨁ i, G i, DirectSum.coeAddMonoidHom G z = y := by
  obtain ⟨z, hz⟩ := AddSubgroup.closure_le (φ.comp (DirectSum.coeAddMonoidHom G)).range |>.mpr hX hy
  exact ⟨z, hφ hz⟩

variable {A : Type*} [CommRing A] {σ : Type*} [SetLike σ A] [AddSubgroupClass σ A]
variable (𝒜 : ℕ → σ) [GradedRing 𝒜]

section Ring

/-- The generating set of the Veronese subring is already a submonoid: it contains
`1 ∈ S_0 = S_{0·d}` and `S_{nd} · S_{md} ⊆ S_{(n+m)d}`. -/
def veroneseSubmonoid (d : ℕ) : Submonoid A where
  carrier := veroneseSet 𝒜 d
  one_mem' := by
    simp only [veroneseSet, Set.mem_iUnion]
    exact ⟨0, by rw [zero_mul]; exact SetLike.GradedOne.one_mem⟩
  mul_mem' := by
    simp only [veroneseSet, Set.mem_iUnion]
    rintro x y ⟨n, hn⟩ ⟨m, hm⟩
    exact ⟨n + m, by rw [add_mul]; exact SetLike.GradedMul.mul_mem hn hm⟩

/-- The carrier of `veroneseSubmonoid` is `veroneseSet`. -/
@[simp]
theorem coe_veroneseSubmonoid (d : ℕ) :
    (veroneseSubmonoid 𝒜 d : Set A) = veroneseSet 𝒜 d :=
  rfl

omit [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- Every homogeneous element whose degree is a multiple of `d` lies in the
Veronese subring. -/
theorem mem_veroneseSubring_of_mem {d n : ℕ} {x : A} (hx : x ∈ 𝒜 (n * d)) :
    x ∈ veroneseSubring 𝒜 d :=
  Subring.subset_closure (Set.mem_iUnion.mpr ⟨n, hx⟩)

/-- The Veronese subring is exactly the additive subgroup generated by the
homogeneous pieces in degrees divisible by `d`: taking the *subring* closure adds
nothing, because the generating set is already closed under multiplication. -/
theorem mem_veroneseSubring_iff (d : ℕ) {x : A} :
    x ∈ veroneseSubring 𝒜 d ↔ x ∈ AddSubgroup.closure (veroneseSet 𝒜 d) := by
  have h : (Submonoid.closure (veroneseSet 𝒜 d) : Set A) = veroneseSet 𝒜 d :=
    congrArg (fun T : Submonoid A => (T : Set A))
      (Submonoid.closure_eq (veroneseSubmonoid 𝒜 d))
  rw [veroneseSubring, Subring.mem_closure_iff, h]

/-- The degree-`n` component of the Veronese subring `S⁽ᵈ⁾`: those of its elements
that are homogeneous of degree `nd` in `S`. -/
def veroneseGrading (d n : ℕ) : AddSubgroup (veroneseSubring 𝒜 d) where
  carrier := {x | (x : A) ∈ 𝒜 (n * d)}
  zero_mem' := zero_mem _
  add_mem' ha hb := add_mem ha hb
  neg_mem' ha := neg_mem ha

omit [GradedRing 𝒜] in
/-- An element of `S⁽ᵈ⁾` lies in the degree-`n` component exactly when it lies in `S_{nd}`. -/
@[simp]
theorem mem_veroneseGrading {d n : ℕ} {x : veroneseSubring 𝒜 d} :
    x ∈ veroneseGrading 𝒜 d n ↔ (x : A) ∈ 𝒜 (n * d) :=
  Iff.rfl

/-- The reindexed components form a graded monoid on the Veronese subring. -/
instance veroneseGradingGradedMonoid (d : ℕ) :
    SetLike.GradedMonoid (veroneseGrading 𝒜 d) where
  one_mem := by
    rw [mem_veroneseGrading, zero_mul]
    exact SetLike.GradedOne.one_mem
  mul_mem i j gi gj hi hj := by
    rw [mem_veroneseGrading] at hi hj ⊢
    rw [add_mul]
    exact SetLike.GradedMul.mul_mem hi hj

/-- The Veronese subring is the internal direct sum of its reindexed components.

Surjectivity is `mem_veroneseSubring_iff`. Injectivity is where `0 < d` is used:
it makes `n ↦ n * d` injective, so two different Veronese degrees are two
different degrees of `S`, and the decomposition of `S` separates them. -/
@[ega "II 2.1.1" "partial"]
theorem veroneseGrading_isInternal (d : ℕ) (hd : 0 < d) :
    DirectSum.IsInternal (veroneseGrading 𝒜 d) := by
  classical
  refine ⟨injective_coeAddMonoidHom_of_decomposition (veroneseSubring 𝒜 d).subtype.toAddMonoidHom
    Subtype.val_injective _ 𝒜 (· * d) (fun _ _ h => Nat.eq_of_mul_eq_mul_right hd h)
    fun _ _ h => h, fun y => ?_⟩
  refine exists_coeAddMonoidHom_eq_of_mem_closure (veroneseSubring 𝒜 d).subtype.toAddMonoidHom
    Subtype.val_injective _ _ ?_ ((mem_veroneseSubring_iff 𝒜 d).mp y.2)
  simp only [veroneseSet, Set.mem_iUnion]
  rintro a ⟨n, ha⟩
  exact ⟨DirectSum.of _ n ⟨⟨a, mem_veroneseSubring_of_mem 𝒜 ha⟩, ha⟩, by simp⟩

/-- The Veronese subring `S⁽ᵈ⁾` is a graded ring, with degree-`n` component the
original degree-`nd` component `S_{nd}`. -/
@[instance_reducible, ega "II 2.1.1"]
noncomputable def veroneseGradingGradedRing (d : ℕ) (hd : 0 < d) :
    GradedRing (veroneseGrading 𝒜 d) :=
  letI := (veroneseGrading_isInternal 𝒜 d hd).chooseDecomposition
  { __ := veroneseGradingGradedMonoid 𝒜 d
    __ := (veroneseGrading_isInternal 𝒜 d hd).chooseDecomposition }

/-- The reindexed components grade the Veronese subring. -/
@[ega "II 2.1.1"]
theorem nonempty_gradedRing_veroneseGrading (d : ℕ) (hd : 0 < d) :
    Nonempty (GradedRing (veroneseGrading 𝒜 d)) :=
  ⟨veroneseGradingGradedRing 𝒜 d hd⟩

end Ring

section Module

/-- A non-negative ring degree acts on an integer module degree by addition.
Mathlib has no `VAdd ℕ ℤ` instance, and `SetLike.GradedSMul` for an `ℕ`-graded
ring acting on a `ℤ`-graded module needs one. -/
instance instVAddNatInt : VAdd ℕ ℤ where
  vadd n i := (n : ℤ) + i

/-- The action of `n : ℕ` on `i : ℤ` is `n + i`. -/
@[simp]
theorem natVAddInt_def (n : ℕ) (i : ℤ) : n +ᵥ i = (n : ℤ) + i := rfl

variable {M : Type*} [AddCommGroup M] [Module A M]

/-- Restriction of scalars along `S⁽ᵈ⁾ ⊆ S` makes every `S`-module a module over
the Veronese subring. -/
noncomputable instance veroneseModule (d : ℕ) : Module (veroneseSubring 𝒜 d) M :=
  Module.compHom M (veroneseSubring 𝒜 d).subtype

omit [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- An element of `S⁽ᵈ⁾` acts on `M` through its image in `S`. -/
@[simp]
theorem veroneseModule_smul_def (d : ℕ) (c : veroneseSubring 𝒜 d) (x : M) :
    c • x = (c : A) • x :=
  rfl

variable (ℳ : ℤ → AddSubgroup M) [DirectSum.Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ]

/-- The generating set of the Veronese part of a graded module: the union of the
homogeneous pieces in degrees divisible by `d`. -/
def veroneseModuleSet (d : ℕ) : Set M := ⋃ n : ℤ, (ℳ (n * (d : ℤ)) : Set M)

omit [DirectSum.Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ] [AddSubgroupClass σ A]
  [GradedRing 𝒜] in
/-- An element lies in `veroneseModuleSet ℳ d` exactly when it lies in `ℳ (n * d)` for some
`n : ℤ`. -/
theorem mem_veroneseModuleSet_iff {d : ℕ} {x : M} :
    x ∈ veroneseModuleSet ℳ d ↔ ∃ n : ℤ, x ∈ ℳ (n * (d : ℤ)) :=
  Set.mem_iUnion

/-- The Veronese part `T⁽ᵈ⁾ = ⨁ₙ T_{nd}` of an integer-graded module, as a
submodule over the Veronese subring. -/
noncomputable def veroneseSubmodule (d : ℕ) : Submodule (veroneseSubring 𝒜 d) M :=
  Submodule.span (veroneseSubring 𝒜 d) (veroneseModuleSet ℳ d)

omit [DirectSum.Decomposition ℳ] in
/-- Scaling a homogeneous element of degree divisible by `d` by an element of the
Veronese subring stays in the additive span of the Veronese pieces: this is
`S_{md} · T_{nd} ⊆ T_{(m+n)d}` together with the fact that `S⁽ᵈ⁾` is additively
generated by the `S_{md}`. -/
theorem smul_mem_closure_veroneseModuleSet_of_mem {d : ℕ} {n : ℤ} {y : M}
    (hy : y ∈ ℳ (n * (d : ℤ))) (c : veroneseSubring 𝒜 d) :
    c • y ∈ AddSubgroup.closure (veroneseModuleSet ℳ d) := by
  rw [veroneseModule_smul_def]
  set T : AddSubgroup A :=
    { carrier := {a : A | a • y ∈ AddSubgroup.closure (veroneseModuleSet ℳ d)}
      zero_mem' := by simpa only [Set.mem_ofPred_eq, zero_smul] using zero_mem _
      add_mem' ha hb := by simpa only [Set.mem_ofPred_eq, add_smul] using add_mem ha hb
      neg_mem' ha := by simpa only [Set.mem_ofPred_eq, neg_smul] using neg_mem ha }
  have hgen : veroneseSet 𝒜 d ⊆ T := by
    simp only [veroneseSet, Set.iUnion_subset_iff]
    intro m a ha
    have key := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ) ha hy
    rw [natVAddInt_def] at key
    have heq : ((m : ℤ) + n) * (d : ℤ) = ((m * d : ℕ) : ℤ) + n * (d : ℤ) := by
      push_cast
      ring
    refine AddSubgroup.subset_closure ?_
    rw [mem_veroneseModuleSet_iff]
    exact ⟨(m : ℤ) + n, by rwa [heq]⟩
  exact AddSubgroup.closure_le T |>.mpr hgen ((mem_veroneseSubring_iff 𝒜 d).mp c.2)

omit [DirectSum.Decomposition ℳ] in
/-- The additive span of the Veronese pieces is stable under the `S⁽ᵈ⁾`-action. -/
theorem smul_mem_closure_veroneseModuleSet {d : ℕ} (c : veroneseSubring 𝒜 d) {x : M}
    (hx : x ∈ AddSubgroup.closure (veroneseModuleSet ℳ d)) :
    c • x ∈ AddSubgroup.closure (veroneseModuleSet ℳ d) := by
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨n, hn⟩ := (mem_veroneseModuleSet_iff ℳ).mp hy
    exact smul_mem_closure_veroneseModuleSet_of_mem 𝒜 ℳ hn c
  | zero => simpa only [smul_zero] using zero_mem _
  | add a b _ _ ha hb => simpa only [smul_add] using add_mem ha hb
  | neg a _ ha => simpa only [smul_neg] using neg_mem ha

omit [DirectSum.Decomposition ℳ] in
/-- The Veronese part of a graded module is exactly the additive subgroup
generated by its homogeneous pieces in degrees divisible by `d`: the
`S⁽ᵈ⁾`-span adds nothing. -/
theorem mem_veroneseSubmodule_iff (d : ℕ) {x : M} :
    x ∈ veroneseSubmodule 𝒜 ℳ d ↔ x ∈ AddSubgroup.closure (veroneseModuleSet ℳ d) := by
  refine ⟨fun hx => ?_, fun hx =>
    AddSubgroup.closure_le (veroneseSubmodule 𝒜 ℳ d).toAddSubgroup |>.mpr Submodule.subset_span hx⟩
  rw [veroneseSubmodule] at hx
  induction hx using Submodule.span_induction with
  | mem y hy => exact AddSubgroup.subset_closure hy
  | zero => exact zero_mem _
  | add a b _ _ ha hb => exact add_mem ha hb
  | smul c a _ ha => exact smul_mem_closure_veroneseModuleSet 𝒜 ℳ c ha

/-- The degree-`n` component of the Veronese part `T⁽ᵈ⁾`: those of its elements
that are homogeneous of degree `nd` in `T`. -/
@[ega "II 2.1.1" "partial"]
def veroneseModuleGrading (d : ℕ) (n : ℤ) :
    AddSubgroup (veroneseSubmodule 𝒜 ℳ d) where
  carrier := {x | (x : M) ∈ ℳ (n * (d : ℤ))}
  zero_mem' := by
    simp only [Set.mem_ofPred_eq, ZeroMemClass.coe_zero]
    exact zero_mem _
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, AddMemClass.coe_add] at ha hb ⊢
    exact add_mem ha hb
  neg_mem' := by
    intro a ha
    simp only [Set.mem_ofPred_eq, NegMemClass.coe_neg] at ha ⊢
    exact neg_mem ha

omit [AddSubgroupClass σ A] [GradedRing 𝒜] [DirectSum.Decomposition ℳ]
  [SetLike.GradedSMul 𝒜 ℳ] in
/-- An element of `T⁽ᵈ⁾` lies in the degree-`n` component exactly when it lies in `T_{nd}`. -/
@[simp]
theorem mem_veroneseModuleGrading {d : ℕ} {n : ℤ} {x : veroneseSubmodule 𝒜 ℳ d} :
    x ∈ veroneseModuleGrading 𝒜 ℳ d n ↔ (x : M) ∈ ℳ (n * (d : ℤ)) :=
  Iff.rfl

/-- The reindexed ring and module gradings are compatible with the scalar action:
`(S⁽ᵈ⁾)ᵢ · (T⁽ᵈ⁾)ⱼ ⊆ (T⁽ᵈ⁾)ᵢ₊ⱼ`, because `S_{id} · T_{jd} ⊆ T_{(i+j)d}`. -/
instance veroneseModuleGrading_gradedSMul (d : ℕ) :
    SetLike.GradedSMul (veroneseGrading 𝒜 d) (veroneseModuleGrading 𝒜 ℳ d) where
  smul_mem := by
    intro i j ai bj hi hj
    have key := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ)
      (show (ai : A) ∈ 𝒜 (i * d) from hi) (show (bj : M) ∈ ℳ (j * (d : ℤ)) from hj)
    rw [natVAddInt_def] at key
    have heq : ((i : ℤ) + j) * (d : ℤ) = ((i * d : ℕ) : ℤ) + j * (d : ℤ) := by
      push_cast
      ring
    rw [mem_veroneseModuleGrading, natVAddInt_def, heq]
    simpa using key

/-- The Veronese part of a graded module is the internal direct sum of its
reindexed components. As for the ring, `0 < d` is used only for injectivity, to
make `n ↦ nd` injective on `ℤ`. -/
@[ega "II 2.1.1" "partial"]
theorem veroneseModuleGrading_isInternal (d : ℕ) (hd : 0 < d) :
    DirectSum.IsInternal (veroneseModuleGrading 𝒜 ℳ d) := by
  classical
  have hd' : (d : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr hd.ne'
  refine ⟨injective_coeAddMonoidHom_of_decomposition
    (veroneseSubmodule 𝒜 ℳ d).subtype.toAddMonoidHom Subtype.val_injective _ ℳ
    (· * (d : ℤ)) (fun _ _ h => mul_right_cancel₀ hd' h) fun _ _ h => h, fun y => ?_⟩
  refine exists_coeAddMonoidHom_eq_of_mem_closure
    (veroneseSubmodule 𝒜 ℳ d).subtype.toAddMonoidHom Subtype.val_injective _ _ ?_
    ((mem_veroneseSubmodule_iff 𝒜 ℳ d).mp y.2)
  simp only [veroneseModuleSet, Set.mem_iUnion]
  rintro a ⟨n, ha⟩
  have haV : a ∈ veroneseSubmodule 𝒜 ℳ d := by
    rw [mem_veroneseSubmodule_iff]
    exact AddSubgroup.subset_closure ((mem_veroneseModuleSet_iff ℳ).mpr ⟨n, ha⟩)
  exact ⟨DirectSum.of _ n ⟨⟨a, haV⟩, ha⟩, by simp⟩

/-- The reindexed components decompose the Veronese part of a graded module. -/
@[instance_reducible]
noncomputable def veroneseModuleGradingDecomposition (d : ℕ) (hd : 0 < d) :
    DirectSum.Decomposition (veroneseModuleGrading 𝒜 ℳ d) :=
  (veroneseModuleGrading_isInternal 𝒜 ℳ d hd).chooseDecomposition

/-- The reindexed components decompose the Veronese part of a graded module. -/
theorem nonempty_decomposition_veroneseModuleGrading (d : ℕ) (hd : 0 < d) :
    Nonempty (DirectSum.Decomposition (veroneseModuleGrading 𝒜 ℳ d)) :=
  ⟨veroneseModuleGradingDecomposition 𝒜 ℳ d hd⟩

end Module

/-! ## Comparison of degree-zero localizations

Everything below compares the Veronese subring and submodule at a positive-degree homogeneous
`f ∈ S_e` with `S` and `T` themselves, over the standard open `D₊(f)`.
-/

/-- The degree-zero localization `S₍f₎` acts on the localization `T_f` of an `S`-module `T`,
through the embedding `S₍f₎ ↪ S_f`. Mathlib has no such instance, because `Module.compHom` is
not an instance; it is declared `local` so that it does not escape this file. -/
local instance awayModule {M : Type*} [AddCommGroup M] [Module A M] (f : A) :
    Module (HomogeneousLocalization.Away 𝒜 f) (LocalizedModule.Away (R := A) f M) :=
  Module.compHom _ (algebraMap (HomogeneousLocalization.Away 𝒜 f) (Localization.Away f))

/-- `f ^ d`, viewed as an element of the Veronese subring. -/
def veronesePower (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) : veroneseSubring 𝒜 d :=
  ⟨f ^ d, mem_veroneseSubring_of_mem 𝒜 (n := e)
    (by simpa [mul_comm] using SetLike.pow_mem_graded d hf)⟩

/-- The element of `S⁽ᵈ⁾` underlying `veronesePower` is `f ^ d`. -/
@[simp]
theorem coe_veronesePower (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) :
    ((veronesePower 𝒜 d f hf : veroneseSubring 𝒜 d) : A) = f ^ d := rfl

/-- The `n`-th power of `f ^ d` in `S⁽ᵈ⁾` is `f ^ (d * n)` in `S`. -/
private theorem coe_veronesePower_pow (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) (n : ℕ) :
    ((veronesePower 𝒜 d f hf ^ n : veroneseSubring 𝒜 d) : A) = f ^ (d * n) := by
  push_cast
  rw [coe_veronesePower, ← pow_mul]

/-- For `0 < d`, the `n`-th power of `f ^ d` in `S⁽ᵈ⁾` is `f ^ (n (d - 1)) * f ^ n` in `S`. -/
private theorem coe_veronesePower_pow_of_pos {d : ℕ} (hd : 0 < d) (f : A) {e : ℕ}
    (hf : f ∈ 𝒜 e) (n : ℕ) :
    ((veronesePower 𝒜 d f hf ^ n : veroneseSubring 𝒜 d) : A) = f ^ (n * (d - 1)) * f ^ n := by
  rw [coe_veronesePower_pow, ← pow_add]
  congr 1
  cases d with
  | zero => exact absurd hd (by simp)
  | succ k => simp [Nat.mul_succ, Nat.mul_comm]

/-- `f ^ d` is homogeneous of Veronese degree `deg f`, since `f ^ d ∈ S_{d · deg f}`. -/
theorem veronesePower_mem (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) :
    veronesePower 𝒜 d f hf ∈ veroneseGrading 𝒜 d e := by
  rw [mem_veroneseGrading, coe_veronesePower]
  simpa [mul_comm] using SetLike.pow_mem_graded d hf

section Graded

variable (d : ℕ) [inst : GradedRing (veroneseGrading 𝒜 d)]

/-- An inclusion of standard opens `D₊(g) ⊆ D₊(f)` in `Proj S` gives the inclusion
`D₊(g ᵈ) ⊆ D₊(f ᵈ)` in `Proj S⁽ᵈ⁾`: a factorization `g ^ n = a f` with `a` homogeneous gives
`(g ᵈ) ^ n = a ᵈ · f ᵈ` inside `S⁽ᵈ⁾`. -/
theorem basicOpen_veronesePower_le (f g : A) {e k : ℕ}
    (hf : f ∈ 𝒜 e) (hg : g ∈ 𝒜 k)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f)
    (he : 0 < e) (hk : 0 < k) :
    ProjectiveSpectrum.basicOpen (veroneseGrading 𝒜 d) (veronesePower 𝒜 d g hg) ≤
      ProjectiveSpectrum.basicOpen (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf) := by
  obtain ⟨n, hn, a, ⟨da, hda⟩, hga⟩ :=
    ProjectiveSpectrum.exists_pow_eq_mul_of_basicOpen_le 𝒜 hf he hg hk hfg
  have key : (veronesePower 𝒜 d g hg) ^ n =
      veronesePower 𝒜 d f hf * veronesePower 𝒜 d a hda := by
    apply Subtype.ext
    show (g ^ d) ^ n = f ^ d * a ^ d
    rw [← pow_mul, mul_comm d n, pow_mul, hga, mul_pow, mul_comm]
  rw [← ProjectiveSpectrum.basicOpen_pow _ (veronesePower 𝒜 d g hg) n hn, key]
  exact ProjectiveSpectrum.basicOpen_mul_le_left _ _ _

end Graded

/-! ### The comparison of ordinary localizations -/

/-- The inclusion `S⁽ᵈ⁾ ⊆ S` sends powers of `f ^ d` to powers of `f`, because
`(f ^ d) ^ n = f ^ (dn)`. This is what makes the comparison of localizations exist. -/
theorem powers_veronesePower_le (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) :
    Submonoid.powers (veronesePower 𝒜 d f hf) ≤
      (Submonoid.powers f).comap (veroneseSubring 𝒜 d).subtype := by
  rintro x ⟨n, rfl⟩
  exact ⟨d * n, (coe_veronesePower_pow 𝒜 d f hf n).symm⟩

/-- The map `S⁽ᵈ⁾_{f ^ d} → S_f` on ordinary localizations induced by `S⁽ᵈ⁾ ⊆ S`. -/
noncomputable def veroneseLocalizationMap (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) :
    Localization.Away (veronesePower 𝒜 d f hf) →+* Localization.Away f :=
  IsLocalization.map _ (veroneseSubring 𝒜 d).subtype (powers_veronesePower_le 𝒜 d f hf)

/-- The comparison of localizations is `a / b ↦ a / b` on fractions. -/
theorem veroneseLocalizationMap_mk (d : ℕ) (f : A) {e : ℕ} (hf : f ∈ 𝒜 e)
    (a : veroneseSubring 𝒜 d) (b : Submonoid.powers (veronesePower 𝒜 d f hf)) :
    veroneseLocalizationMap 𝒜 d f hf (Localization.mk a b) =
      Localization.mk (a : A) ⟨((b : veroneseSubring 𝒜 d) : A),
        powers_veronesePower_le 𝒜 d f hf b.2⟩ := by
  rw [Localization.mk_eq_mk', veroneseLocalizationMap, IsLocalization.map_mk',
    ← Localization.mk_eq_mk']
  rfl

/-- The comparison `S⁽ᵈ⁾_{f ᵈ} → S_f` is injective: a power `f ^ m` annihilating a numerator
may be replaced by `(f ᵈ) ^ m = f ^ (dm)`, which is a power of `f ^ d`. This is the one place
where `0 < d` enters, through `m ≤ dm`. -/
theorem veroneseLocalizationMap_injective (d : ℕ) (hd : 0 < d) (f : A) {e : ℕ}
    (hf : f ∈ 𝒜 e) : Function.Injective (veroneseLocalizationMap 𝒜 d f hf) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  induction x using Localization.induction_on with
  | H y =>
    obtain ⟨a, b⟩ := y
    rw [veroneseLocalizationMap_mk, Localization.mk_eq_mk',
      IsLocalization.mk'_eq_zero_iff] at hx
    obtain ⟨c, hc⟩ := hx
    obtain ⟨m, hm⟩ := c.2
    have key : ((veronesePower 𝒜 d f hf ^ m : veroneseSubring 𝒜 d) : A) * (a : A) = 0 := by
      rw [coe_veronesePower_pow_of_pos 𝒜 hd, show f ^ m = c from hm, mul_assoc, hc,
        mul_zero]
    rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
    exact ⟨⟨veronesePower 𝒜 d f hf ^ m, ⟨m, rfl⟩⟩, Subtype.ext (by exact_mod_cast key)⟩

/-! ### The comparison of degree-zero localizations -/

section AwayRing

variable (d : ℕ) [inst : GradedRing (veroneseGrading 𝒜 d)]
variable (f : A) {e : ℕ} (hf : f ∈ 𝒜 e)

/-- A homogeneous fraction of the Veronese subring, read as one of `S`. -/
def veroneseNumDen
    (c : HomogeneousLocalization.NumDenSameDeg (veroneseGrading 𝒜 d)
      (Submonoid.powers (veronesePower 𝒜 d f hf))) :
    HomogeneousLocalization.NumDenSameDeg 𝒜 (Submonoid.powers f) where
  deg := c.deg * d
  num := ⟨((c.num : veroneseSubring 𝒜 d) : A), (mem_veroneseGrading 𝒜).mp c.num.2⟩
  den := ⟨((c.den : veroneseSubring 𝒜 d) : A), (mem_veroneseGrading 𝒜).mp c.den.2⟩
  den_mem := powers_veronesePower_le 𝒜 d f hf c.den_mem

omit inst in
/-- Reading a homogeneous fraction of `S⁽ᵈ⁾` in `S` is compatible with the embeddings of both
degree-zero localizations into the ordinary ones. -/
theorem veroneseLocalizationMap_embedding
    (c : HomogeneousLocalization.NumDenSameDeg (veroneseGrading 𝒜 d)
      (Submonoid.powers (veronesePower 𝒜 d f hf))) :
    veroneseLocalizationMap 𝒜 d f hf c.embedding =
      (veroneseNumDen 𝒜 d f hf c).embedding := by
  rw [HomogeneousLocalization.NumDenSameDeg.embedding, veroneseLocalizationMap_mk]
  rfl

/-- The underlying function of the comparison `S⁽ᵈ⁾₍fᵈ₎ → S₍f₎`. -/
noncomputable def veroneseAwayFun
    (z : HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf)) :
    HomogeneousLocalization.Away 𝒜 f :=
  Quotient.map' (veroneseNumDen 𝒜 d f hf)
    (fun c c' (h : c.embedding = c'.embedding) => by
      change (veroneseNumDen 𝒜 d f hf c).embedding = (veroneseNumDen 𝒜 d f hf c').embedding
      rw [← veroneseLocalizationMap_embedding, ← veroneseLocalizationMap_embedding, h]) z

omit inst in
/-- The comparison of degree-zero localizations is compatible with the embeddings into the
ordinary localizations. This single identity carries all of its ring-map properties, and its
injectivity. -/
theorem val_veroneseAwayFun
    (z : HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf)) :
    (veroneseAwayFun 𝒜 d f hf z).val = veroneseLocalizationMap 𝒜 d f hf z.val := by
  obtain ⟨c, rfl⟩ := HomogeneousLocalization.mk_surjective z
  exact (veroneseLocalizationMap_embedding 𝒜 d f hf c).symm

/-- The comparison ring map `S⁽ᵈ⁾₍fᵈ₎ → S₍f₎`. -/
noncomputable def veroneseAwayHom :
    HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf) →+*
      HomogeneousLocalization.Away 𝒜 f where
  toFun := veroneseAwayFun 𝒜 d f hf
  map_one' := by
    apply HomogeneousLocalization.val_injective (Submonoid.powers f)
    rw [val_veroneseAwayFun, HomogeneousLocalization.val_one,
      HomogeneousLocalization.val_one, map_one]
  map_mul' x y := by
    apply HomogeneousLocalization.val_injective (Submonoid.powers f)
    rw [val_veroneseAwayFun, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.val_mul, map_mul, val_veroneseAwayFun, val_veroneseAwayFun]
  map_zero' := by
    apply HomogeneousLocalization.val_injective (Submonoid.powers f)
    rw [val_veroneseAwayFun, HomogeneousLocalization.val_zero,
      HomogeneousLocalization.val_zero, map_zero]
  map_add' x y := by
    apply HomogeneousLocalization.val_injective (Submonoid.powers f)
    rw [val_veroneseAwayFun, HomogeneousLocalization.val_add,
      HomogeneousLocalization.val_add, map_add, val_veroneseAwayFun, val_veroneseAwayFun]

/-- `veroneseAwayHom` is `veroneseAwayFun` as a ring map. -/
@[simp]
theorem veroneseAwayHom_apply
    (z : HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf)) :
    veroneseAwayHom 𝒜 d f hf z = veroneseAwayFun 𝒜 d f hf z := rfl

/-- The comparison of degree-zero localizations is injective. -/
theorem veroneseAwayHom_injective (hd : 0 < d) :
    Function.Injective (veroneseAwayHom 𝒜 d f hf) := by
  intro x y hxy
  apply HomogeneousLocalization.val_injective (Submonoid.powers (veronesePower 𝒜 d f hf))
  apply veroneseLocalizationMap_injective 𝒜 d hd f hf
  rw [← val_veroneseAwayFun, ← val_veroneseAwayFun]
  exact congrArg HomogeneousLocalization.val hxy

/-- The comparison of degree-zero localizations is surjective: a fraction `y / f ⁿ` of `S₍f₎`
is `y f ^ (n(d-1)) / f ^ (nd)`, whose numerator lies in `S⁽ᵈ⁾` and whose denominator is a power
of `f ^ d`. -/
theorem veroneseAwayHom_surjective (hd : 0 < d) :
    Function.Surjective (veroneseAwayHom 𝒜 d f hf) := by
  intro w
  obtain ⟨m, y, hy, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf w
  have hdeg : m * e + m * (d - 1) * e = m * e * d := by
    cases d with
    | zero => omega
    | succ k =>
      simp only [Nat.succ_sub_one]
      ring
  have hx𝒜 : y * f ^ (m * (d - 1)) ∈ 𝒜 (m * e * d) := by
    rw [← hdeg]
    refine SetLike.mul_mem_graded ?_ ?_
    · simpa using hy
    · simpa [mul_comm] using SetLike.pow_mem_graded (m * (d - 1)) hf
  refine ⟨HomogeneousLocalization.Away.mk (veroneseGrading 𝒜 d)
    (veronesePower_mem 𝒜 d f hf) m ⟨_, mem_veroneseSubring_of_mem 𝒜 (n := m * e) hx𝒜⟩
    (by simpa using hx𝒜), ?_⟩
  apply HomogeneousLocalization.val_injective (Submonoid.powers f)
  rw [veroneseAwayHom_apply, val_veroneseAwayFun, HomogeneousLocalization.Away.val_mk,
    veroneseLocalizationMap_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul]
  rw [coe_veronesePower_pow_of_pos 𝒜 hd]
  ring

/-- The comparison of the degree-zero localization of the Veronese subring at `f ^ d` with
that of `S` at `f`. -/
noncomputable def veroneseAwayEquiv (hd : 0 < d) :
    HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf) ≃+*
      HomogeneousLocalization.Away 𝒜 f :=
  RingEquiv.ofBijective (veroneseAwayHom 𝒜 d f hf)
    ⟨veroneseAwayHom_injective 𝒜 d f hf hd, veroneseAwayHom_surjective 𝒜 d f hf hd⟩

/-- The ring isomorphism `(S⁽ᵈ⁾)₍f ᵈ₎ ≃+* S₍f₎` is compatible with the embeddings into the
ordinary localizations. -/
theorem val_veroneseAwayEquiv (hd : 0 < d)
    (z : HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf)) :
    (veroneseAwayEquiv 𝒜 d f hf hd z).val = veroneseLocalizationMap 𝒜 d f hf z.val :=
  val_veroneseAwayFun 𝒜 d f hf z

/-- The ring isomorphism is induced by the inclusion `S⁽ᵈ⁾ ⊆ S`: it takes the fraction
`x / (f ᵈ) ⁿ` to `x / f ⁿᵈ`. -/
theorem veroneseAwayEquiv_mk (hd : 0 < d) (n : ℕ) (x : veroneseSubring 𝒜 d)
    (hxV : x ∈ veroneseGrading 𝒜 d (n • e)) (hxS : (x : A) ∈ 𝒜 ((n * d) • e)) :
    veroneseAwayEquiv 𝒜 d f hf hd
        (HomogeneousLocalization.Away.mk (veroneseGrading 𝒜 d)
          (veronesePower_mem 𝒜 d f hf) n x hxV) =
      HomogeneousLocalization.Away.mk 𝒜 hf (n * d) (x : A) hxS := by
  apply HomogeneousLocalization.val_injective (Submonoid.powers f)
  rw [val_veroneseAwayEquiv, HomogeneousLocalization.Away.val_mk,
    veroneseLocalizationMap_mk, HomogeneousLocalization.Away.val_mk]
  congr 1
  exact Subtype.ext ((coe_veronesePower_pow 𝒜 d f hf n).trans (by rw [mul_comm d n]))

end AwayRing

/-! ### Naturality of the ring comparison -/

section Naturality

variable (d : ℕ) [inst : GradedRing (veroneseGrading 𝒜 d)]

/-- Reading a fraction of `S⁽ᵈ⁾` in `S` commutes with the restriction maps `S_f → S_g` of
Tag 01M4: both composites are ring maps out of `S⁽ᵈ⁾_{f ᵈ}` which are the identity on `S⁽ᵈ⁾`. -/
theorem veroneseLocalizationMap_localizedRingMap (f g : A) {e k : ℕ}
    (he : 0 < e) (hk : 0 < k) (hf : f ∈ 𝒜 e) (hg : g ∈ 𝒜 k)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f)
    (w : Localization.Away (veronesePower 𝒜 d f hf)) :
    veroneseLocalizationMap 𝒜 d g hg
        (ProjectiveSpectrum.localizedRingMap (veroneseGrading 𝒜 d)
          (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk) w) =
      ProjectiveSpectrum.localizedRingMap 𝒜 f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩ hfg
        (veroneseLocalizationMap 𝒜 d f hf w) := by
  have key : (veroneseLocalizationMap 𝒜 d g hg).comp
        (ProjectiveSpectrum.localizedRingMap (veroneseGrading 𝒜 d)
          (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).toRingHom =
      (ProjectiveSpectrum.localizedRingMap 𝒜 f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
          hfg).toRingHom.comp (veroneseLocalizationMap 𝒜 d f hf) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (veronesePower 𝒜 d f hf))
    ext v
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, veroneseLocalizationMap, IsLocalization.map_eq]
    rw [AlgHom.commutes, IsLocalization.map_eq, AlgHom.commutes]
  exact DFunLike.congr_fun key w

/-- The ring comparison commutes with the restriction maps `S₍f₎ → S₍g₎` attached to an
inclusion `D₊(g) ⊆ D₊(f)` and to the transported inclusion `D₊(g ᵈ) ⊆ D₊(f ᵈ)`. -/
theorem veroneseAwayEquiv_naturality (hd : 0 < d) (f g : A) {e k : ℕ}
    (he : 0 < e) (hk : 0 < k) (hf : f ∈ 𝒜 e) (hg : g ∈ 𝒜 k)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f)
    (z : HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf)) :
    veroneseAwayEquiv 𝒜 d g hg hd
        (ProjectiveSpectrum.degreeZeroRingMap (veroneseGrading 𝒜 d)
          (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk) z) =
      ProjectiveSpectrum.degreeZeroRingMap 𝒜 f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩ hfg
        (veroneseAwayEquiv 𝒜 d f hf hd z) := by
  apply HomogeneousLocalization.val_injective (Submonoid.powers g)
  rw [val_veroneseAwayEquiv, ProjectiveSpectrum.val_degreeZeroRingMap,
    ProjectiveSpectrum.val_degreeZeroRingMap, val_veroneseAwayEquiv,
    veroneseLocalizationMap_localizedRingMap 𝒜 d f g he hk hf hg hfg]

end Naturality

/-! ### The degree-zero part of a localized graded module -/

section DegreeZeroMem

variable {M τ : Type*} [AddCommGroup M] [Module A M] [SetLike τ M] [AddSubgroupClass τ M]
variable (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨] [SetLike.GradedSMul 𝒜 𝒨]

/-- The degree-zero submodule `M₍f₎` consists exactly of the fractions `x / f ^ n` whose
numerator has degree `n • deg f`. -/
@[ega "II 2.2.1" "partial"]
theorem mem_gradedModuleDegreeZeroLocalization_iff (f : A) (c : ℕ) (hf : f ∈ 𝒜 c)
    (y : LocalizedModule.Away f M) :
    y ∈ GradedModuleDegreeZeroLocalization 𝒜 𝒨 f ↔
      ∃ (n : ℕ) (x : M), x ∈ 𝒨 (n • (c : ℤ)) ∧
        y = LocalizedModule.mk x (⟨f ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers f) := by
  classical
  have key (a b : ℕ) : (a • c : ℕ) +ᵥ (b • (c : ℤ)) = (a + b) • (c : ℤ) := by
    simp only [nsmul_eq_mul, natVAddInt_def]
    push_cast
    ring
  constructor
  · intro hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨c', n, hf', x, hx, rfl⟩ := hy
        by_cases hfn : f ^ n = 0
        · have : Subsingleton (LocalizedModule.Away f M) :=
            LocalizedModule.subsingleton (S := Submonoid.powers f) (M := M) ⟨n, hfn⟩
          exact ⟨0, 0, by simp, Subsingleton.elim _ _⟩
        · have hdeg : n • c' = n • c :=
            DirectSum.degree_eq_of_mem_mem 𝒜
              (SetLike.pow_mem_graded n hf') (SetLike.pow_mem_graded n hf) hfn
          have hdeg' : n • (c' : ℤ) = n • (c : ℤ) := by
            simpa [nsmul_eq_mul] using congrArg (fun j : ℕ => (j : ℤ)) hdeg
          exact ⟨n, x, hdeg' ▸ hx, rfl⟩
    | zero => exact ⟨0, 0, by simp, by simp⟩
    | add y z _ _ hy hz =>
        obtain ⟨n, x, hx, rfl⟩ := hy
        obtain ⟨m, z, hz, rfl⟩ := hz
        refine ⟨n + m, (f ^ m) • x + (f ^ n) • z, ?_, ?_⟩
        · have hx' := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨)
            (SetLike.pow_mem_graded m hf) hx
          have hz' := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨)
            (SetLike.pow_mem_graded n hf) hz
          exact add_mem (add_comm m n ▸ key m n ▸ hx') (key n m ▸ hz')
        · rw [LocalizedModule.mk_add_mk]
          congr 1
          apply Subtype.ext
          simp [pow_add]
    | smul a y _ hy =>
        obtain ⟨n, x, hx, rfl⟩ := hy
        obtain ⟨m, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf a
        refine ⟨m + n, b • x, ?_, ?_⟩
        · exact key m n ▸ SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) hb hx
        · show (HomogeneousLocalization.Away.mk 𝒜 hf m b hb).val •
              LocalizedModule.mk x (⟨f ^ n, by exact ⟨n, rfl⟩⟩ : Submonoid.powers f) = _
          rw [HomogeneousLocalization.Away.val_mk, LocalizedModule.mk_smul_mk]
          congr 1
          apply Subtype.ext
          simp [pow_add]
  · rintro ⟨n, x, hx, rfl⟩
    exact Submodule.subset_span ⟨c, n, hf, x, hx, rfl⟩

end DegreeZeroMem

/-! ### The module comparison -/

section ModuleComparison

variable (d : ℕ)
variable {M : Type*} [AddCommGroup M] [Module A M]
variable (ℳ : ℤ → AddSubgroup M)
variable (f : A) {e : ℕ} (hf : f ∈ 𝒜 e)

/-- The map `T⁽ᵈ⁾_{f ^ d} → T_f` on localized modules induced by `T⁽ᵈ⁾ ⊆ T`. -/
noncomputable def veroneseLocalizedModuleFun
    (x : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
      (veroneseSubmodule 𝒜 ℳ d)) :
    LocalizedModule.Away (R := A) f M :=
  LocalizedModule.liftOn x
    (fun p => LocalizedModule.mk ((p.1 : M))
      ⟨((p.2 : veroneseSubring 𝒜 d) : A), powers_veronesePower_le 𝒜 d f hf p.2.2⟩)
    (by
      rintro ⟨m, s⟩ ⟨m', s'⟩ ⟨u, hu⟩
      have hu' := congrArg (fun z : veroneseSubmodule 𝒜 ℳ d => (z : M)) hu
      simp only [Submonoid.smul_def, SetLike.val_smul, veroneseModule_smul_def] at hu'
      rw [LocalizedModule.mk_eq]
      refine ⟨⟨((u : veroneseSubring 𝒜 d) : A),
        powers_veronesePower_le 𝒜 d f hf u.2⟩, ?_⟩
      simpa only [Submonoid.smul_def] using hu')

/-- The comparison of localized modules is `m / s ↦ m / s` on fractions. -/
theorem veroneseLocalizedModuleFun_mk (m : veroneseSubmodule 𝒜 ℳ d)
    (s : Submonoid.powers (veronesePower 𝒜 d f hf)) :
    veroneseLocalizedModuleFun 𝒜 d ℳ f hf (LocalizedModule.mk m s) =
      LocalizedModule.mk (m : M) ⟨((s : veroneseSubring 𝒜 d) : A),
        powers_veronesePower_le 𝒜 d f hf s.2⟩ :=
  LocalizedModule.liftOn_mk _ _ _

/-- The comparison of localized modules is additive. -/
theorem veroneseLocalizedModuleFun_add
    (x y : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
      (veroneseSubmodule 𝒜 ℳ d)) :
    veroneseLocalizedModuleFun 𝒜 d ℳ f hf (x + y) =
      veroneseLocalizedModuleFun 𝒜 d ℳ f hf x + veroneseLocalizedModuleFun 𝒜 d ℳ f hf y := by
  induction x using LocalizedModule.induction_on with
  | h m s =>
    induction y using LocalizedModule.induction_on with
    | h m' s' =>
      rw [LocalizedModule.mk_add_mk, veroneseLocalizedModuleFun_mk,
        veroneseLocalizedModuleFun_mk, veroneseLocalizedModuleFun_mk,
        LocalizedModule.mk_add_mk]
      congr 1

/-- The comparison of localized modules is semilinear over `veroneseLocalizationMap`. -/
theorem veroneseLocalizedModuleFun_smul (w : Localization.Away (veronesePower 𝒜 d f hf))
    (x : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
      (veroneseSubmodule 𝒜 ℳ d)) :
    veroneseLocalizedModuleFun 𝒜 d ℳ f hf (w • x) =
      veroneseLocalizationMap 𝒜 d f hf w • veroneseLocalizedModuleFun 𝒜 d ℳ f hf x := by
  induction w using Localization.induction_on with
  | H p =>
    obtain ⟨a, t⟩ := p
    induction x using LocalizedModule.induction_on with
    | h m s =>
      rw [LocalizedModule.mk_smul_mk, veroneseLocalizedModuleFun_mk,
        veroneseLocalizedModuleFun_mk, veroneseLocalizationMap_mk,
        LocalizedModule.mk_smul_mk]
      congr 1

/-- The comparison `T⁽ᵈ⁾_{f ᵈ} → T_f` is injective, by the same replacement of `f ^ m` by
`(f ᵈ) ^ m` as for the ring. -/
theorem veroneseLocalizedModuleFun_injective (hd : 0 < d) :
    Function.Injective (veroneseLocalizedModuleFun 𝒜 d ℳ f hf) := by
  intro x y hxy
  induction x using LocalizedModule.induction_on with
  | h m s =>
    induction y using LocalizedModule.induction_on with
    | h m' s' =>
      rw [veroneseLocalizedModuleFun_mk, veroneseLocalizedModuleFun_mk,
        LocalizedModule.mk_eq] at hxy
      obtain ⟨c, hc⟩ := hxy
      obtain ⟨u, hu⟩ := c.2
      rw [LocalizedModule.mk_eq]
      refine ⟨⟨veronesePower 𝒜 d f hf ^ u, ⟨u, rfl⟩⟩, ?_⟩
      apply Subtype.val_injective
      simp only [Submonoid.smul_def, SetLike.val_smul, veroneseModule_smul_def,
        coe_veronesePower_pow_of_pos 𝒜 hd, hu]
      simp only [Submonoid.smul_def] at hc
      rw [mul_smul, mul_smul, hc]

section DegreeZero

variable [inst : GradedRing (veroneseGrading 𝒜 d)]
variable [DirectSum.Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ]
variable [DirectSum.Decomposition (veroneseModuleGrading 𝒜 ℳ d)]

/-- The comparison carries the degree-zero part of `T⁽ᵈ⁾_{f ᵈ}` into the degree-zero part
of `T_f`: a fraction of Veronese degree `n` has numerator of degree `ndd'` and denominator
`f ^ (nd)`. -/
theorem veroneseLocalizedModuleFun_mem
    (z : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
      (veroneseSubmodule 𝒜 ℳ d))
    (hz : z ∈ GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf)) :
    veroneseLocalizedModuleFun 𝒜 d ℳ f hf z ∈
      GradedModuleDegreeZeroLocalization 𝒜 ℳ f := by
  obtain ⟨n, x, hx, rfl⟩ := (mem_gradedModuleDegreeZeroLocalization_iff
    (veroneseGrading 𝒜 d) (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) e
    (veronesePower_mem 𝒜 d f hf) z).mp hz
  rw [veroneseLocalizedModuleFun_mk, mem_gradedModuleDegreeZeroLocalization_iff 𝒜 ℳ f e hf]
  refine ⟨d * n, (x : M), ?_, ?_⟩
  · have heq : ((d * n : ℕ)) • (e : ℤ) = (n • (e : ℤ)) * (d : ℤ) := by
      simp only [nsmul_eq_mul]
      push_cast
      ring
    rw [heq]
    exact (mem_veroneseModuleGrading 𝒜 ℳ).mp hx
  · congr 1
    exact Subtype.ext (coe_veronesePower_pow 𝒜 d f hf n)

/-- Every element of `T₍f₎` comes from the degree-zero part of `T⁽ᵈ⁾_{f ᵈ}`: multiply the
numerator and the denominator of `x / f ⁿ` by `f ^ (n(d-1))`. -/
theorem veroneseLocalizedModuleFun_surjOn (hd : 0 < d)
    (y : LocalizedModule.Away (R := A) f M)
    (hy : y ∈ GradedModuleDegreeZeroLocalization 𝒜 ℳ f) :
    ∃ z : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
        (veroneseSubmodule 𝒜 ℳ d),
      z ∈ GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d)
        (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) ∧
      veroneseLocalizedModuleFun 𝒜 d ℳ f hf z = y := by
  obtain ⟨n, x, hx, rfl⟩ := (mem_gradedModuleDegreeZeroLocalization_iff 𝒜 ℳ f e hf y).mp hy
  have hpow := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ)
    (SetLike.pow_mem_graded (n * (d - 1)) hf) hx
  have hdeg : (((n * (d - 1)) • e : ℕ) : ℤ) + n • (e : ℤ) = (n • (e : ℤ)) * (d : ℤ) := by
    simp only [smul_eq_mul, nsmul_eq_mul]
    push_cast
    cases d with
    | zero => exact absurd hd (by simp)
    | succ j =>
      push_cast [Nat.succ_sub_one]
      ring
  rw [natVAddInt_def, hdeg] at hpow
  have hxV : f ^ (n * (d - 1)) • x ∈ veroneseSubmodule 𝒜 ℳ d := by
    rw [mem_veroneseSubmodule_iff]
    exact AddSubgroup.subset_closure ((mem_veroneseModuleSet_iff ℳ).mpr ⟨n • (e : ℤ), hpow⟩)
  refine ⟨LocalizedModule.mk ⟨f ^ (n * (d - 1)) • x, hxV⟩
    ⟨veronesePower 𝒜 d f hf ^ n, ⟨n, rfl⟩⟩, ?_, ?_⟩
  · rw [mem_gradedModuleDegreeZeroLocalization_iff (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) e
      (veronesePower_mem 𝒜 d f hf)]
    exact ⟨n, ⟨f ^ (n * (d - 1)) • x, hxV⟩, (mem_veroneseModuleGrading 𝒜 ℳ).mpr hpow, rfl⟩
  · rw [veroneseLocalizedModuleFun_mk]
    have hden : (⟨((veronesePower 𝒜 d f hf ^ n : veroneseSubring 𝒜 d) : A),
          powers_veronesePower_le 𝒜 d f hf ⟨n, rfl⟩⟩ : Submonoid.powers f) =
        (⟨f ^ (n * (d - 1)), ⟨n * (d - 1), rfl⟩⟩ : Submonoid.powers f) *
          ⟨f ^ n, ⟨n, rfl⟩⟩ := by
      exact Subtype.ext (coe_veronesePower_pow_of_pos 𝒜 hd f hf n)
    rw [hden]
    exact LocalizedModule.mk_cancel_common_left (R := A) (M := M)
      (⟨f ^ (n * (d - 1)), ⟨n * (d - 1), rfl⟩⟩ : Submonoid.powers f)
      (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) x

/-- The comparison of the degree-zero localization of the Veronese part of a graded module
with that of the module itself. -/
noncomputable def veroneseModuleAwayEquiv (hd : 0 < d) :
    GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d) (veroneseModuleGrading 𝒜 ℳ d)
        (veronesePower 𝒜 d f hf) ≃+
      GradedModuleDegreeZeroLocalization 𝒜 ℳ f :=
  AddEquiv.ofBijective
    (AddMonoidHom.mk'
      (fun z => ⟨veroneseLocalizedModuleFun 𝒜 d ℳ f hf z.1,
        veroneseLocalizedModuleFun_mem 𝒜 d ℳ f hf z.1 z.2⟩)
      (fun z w => Subtype.ext (veroneseLocalizedModuleFun_add 𝒜 d ℳ f hf z.1 w.1)))
    ⟨fun z w hzw => Subtype.ext (veroneseLocalizedModuleFun_injective 𝒜 d ℳ f hf hd
        (congrArg Subtype.val hzw)),
      fun y => by
        obtain ⟨z, hz, hzy⟩ := veroneseLocalizedModuleFun_surjOn 𝒜 d ℳ f hf hd y.1 y.2
        exact ⟨⟨z, hz⟩, Subtype.ext hzy⟩⟩

/-- The module comparison is the restriction of `veroneseLocalizedModuleFun`. -/
theorem coe_veroneseModuleAwayEquiv (hd : 0 < d)
    (z : GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf)) :
    ((veroneseModuleAwayEquiv 𝒜 d ℳ f hf hd z :
        GradedModuleDegreeZeroLocalization 𝒜 ℳ f) : LocalizedModule.Away (R := A) f M) =
      veroneseLocalizedModuleFun 𝒜 d ℳ f hf
        (z : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
          (veroneseSubmodule 𝒜 ℳ d)) := rfl

/-- The module comparison is induced by the inclusion `T⁽ᵈ⁾ ⊆ T`: a fraction `m / (f ᵈ) ⁿ`
goes to `m / f ⁿᵈ`. The hypothesis is stated for an arbitrary representative in the ordinary
localized module, so it characterizes the map without choosing homogeneous representatives. -/
theorem veroneseModuleAwayEquiv_mk (hd : 0 < d) (n : ℕ) (m : veroneseSubmodule 𝒜 ℳ d)
    (z : GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf))
    (hz : (z : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
        (veroneseSubmodule 𝒜 ℳ d)) =
      LocalizedModule.mk m (⟨veronesePower 𝒜 d f hf ^ n, ⟨n, rfl⟩⟩ :
        Submonoid.powers (veronesePower 𝒜 d f hf))) :
    ((veroneseModuleAwayEquiv 𝒜 d ℳ f hf hd z :
        GradedModuleDegreeZeroLocalization 𝒜 ℳ f) : LocalizedModule.Away (R := A) f M) =
      LocalizedModule.mk (m : M) (⟨f ^ (n * d), ⟨n * d, rfl⟩⟩ : Submonoid.powers f) := by
  rw [coe_veroneseModuleAwayEquiv, hz, veroneseLocalizedModuleFun_mk]
  congr 1
  exact Subtype.ext ((coe_veronesePower_pow 𝒜 d f hf n).trans (by rw [mul_comm d n]))

/-- The module comparison is semilinear over the ring comparison `veroneseAwayEquiv`. -/
theorem veroneseModuleAwayEquiv_smul (hd : 0 < d)
    (r : HomogeneousLocalization.Away (veroneseGrading 𝒜 d) (veronesePower 𝒜 d f hf))
    (z : GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf)) :
    veroneseModuleAwayEquiv 𝒜 d ℳ f hf hd (r • z) =
      veroneseAwayEquiv 𝒜 d f hf hd r • veroneseModuleAwayEquiv 𝒜 d ℳ f hf hd z := by
  apply Subtype.ext
  rw [coe_veroneseModuleAwayEquiv]
  show veroneseLocalizedModuleFun 𝒜 d ℳ f hf
      (HomogeneousLocalization.val r • (z : LocalizedModule _ _)) =
    HomogeneousLocalization.val (veroneseAwayEquiv 𝒜 d f hf hd r) •
      ((veroneseModuleAwayEquiv 𝒜 d ℳ f hf hd z :
        GradedModuleDegreeZeroLocalization 𝒜 ℳ f) : LocalizedModule.Away (R := A) f M)
  rw [veroneseLocalizedModuleFun_smul, coe_veroneseModuleAwayEquiv, val_veroneseAwayEquiv]

end DegreeZero

end ModuleComparison

/-! ### Naturality of the module comparison -/

section ModuleNaturality

variable (d : ℕ) [inst : GradedRing (veroneseGrading 𝒜 d)]
variable {M : Type*} [AddCommGroup M] [Module A M]
variable (ℳ : ℤ → AddSubgroup M)

omit inst in
/-- The comparison of localizations takes `1 / (f ᵈ) ʲ` to `1 / f ᵈʲ`. -/
theorem veroneseLocalizationMap_mk_one (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) (j : ℕ) :
    veroneseLocalizationMap 𝒜 d f hf
        (Localization.mk 1 (⟨veronesePower 𝒜 d f hf ^ j, ⟨j, rfl⟩⟩ :
          Submonoid.powers (veronesePower 𝒜 d f hf))) =
      Localization.mk 1 (⟨f ^ (d * j), ⟨d * j, rfl⟩⟩ : Submonoid.powers f) := by
  rw [veroneseLocalizationMap_mk]
  congr 1
  exact Subtype.ext (coe_veronesePower_pow 𝒜 d f hf j)

omit inst in
/-- The comparison of localized modules takes `m / 1` to `m / 1`. -/
theorem veroneseLocalizedModuleFun_mk_one (f : A) {e : ℕ} (hf : f ∈ 𝒜 e)
    (m : veroneseSubmodule 𝒜 ℳ d) :
    veroneseLocalizedModuleFun 𝒜 d ℳ f hf
        (LocalizedModule.mk m (1 : Submonoid.powers (veronesePower 𝒜 d f hf))) =
      LocalizedModule.mk (m : M) (1 : Submonoid.powers f) := by
  rw [veroneseLocalizedModuleFun_mk]
  congr 1

omit inst in
/-- The comparison of localized modules takes `m / (f ᵈ) ʲ` to `m / f ᵈʲ`. -/
theorem veroneseLocalizedModuleFun_mk_pow (f : A) {e : ℕ} (hf : f ∈ 𝒜 e) (j : ℕ)
    (m : veroneseSubmodule 𝒜 ℳ d) :
    veroneseLocalizedModuleFun 𝒜 d ℳ f hf (LocalizedModule.mk m
        (⟨veronesePower 𝒜 d f hf ^ j, ⟨j, rfl⟩⟩ :
          Submonoid.powers (veronesePower 𝒜 d f hf))) =
      LocalizedModule.mk (m : M) (⟨f ^ (d * j), ⟨d * j, rfl⟩⟩ : Submonoid.powers f) := by
  rw [veroneseLocalizedModuleFun_mk]
  congr 1
  exact Subtype.ext (coe_veronesePower_pow 𝒜 d f hf j)

variable [DirectSum.Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ]
variable [DirectSum.Decomposition (veroneseModuleGrading 𝒜 ℳ d)]

/-- Reading a fraction of `T⁽ᵈ⁾` in `T` commutes with the restriction maps `T_f → T_g` of
Tag 01M4. Both sides are computed on `m / (f ᵈ) ʲ = (1 / (f ᵈ) ʲ) · (m / 1)`, where the
restriction maps are pinned down by their value on `m / 1` and their semilinearity. -/
theorem veroneseLocalizedModuleFun_localizedMap (f g : A) {e k : ℕ}
    (he : 0 < e) (hk : 0 < k) (hf : f ∈ 𝒜 e) (hg : g ∈ 𝒜 k)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f)
    (x : LocalizedModule (Submonoid.powers (veronesePower 𝒜 d f hf))
      (veroneseSubmodule 𝒜 ℳ d)) :
    veroneseLocalizedModuleFun 𝒜 d ℳ g hg
        ((ProjectiveSpectrum.moduleRestrictionMaps (veroneseGrading 𝒜 d)
          (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).localizedMap x) =
      (ProjectiveSpectrum.moduleRestrictionMaps 𝒜 ℳ f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
        hfg).localizedMap (veroneseLocalizedModuleFun 𝒜 d ℳ f hf x) := by
  induction x using LocalizedModule.induction_on with
  | h m s =>
    obtain ⟨_, j, rfl⟩ := s
    have hmkV : (ProjectiveSpectrum.moduleRestrictionMaps (veroneseGrading 𝒜 d)
          (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).localizedMap
        (LocalizedModule.mk m (1 : Submonoid.powers (veronesePower 𝒜 d f hf))) =
        LocalizedModule.mk m (1 : Submonoid.powers (veronesePower 𝒜 d g hg)) := by
      simpa only [LocalizedModule.mkLinearMap_apply] using
        (ProjectiveSpectrum.moduleRestrictionMaps (veroneseGrading 𝒜 d)
          (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).map_mk m
    have hmkS : (ProjectiveSpectrum.moduleRestrictionMaps 𝒜 ℳ f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
          hfg).localizedMap (LocalizedModule.mk (m : M) (1 : Submonoid.powers f)) =
        LocalizedModule.mk (m : M) (1 : Submonoid.powers g) := by
      simpa only [LocalizedModule.mkLinearMap_apply] using
        (ProjectiveSpectrum.moduleRestrictionMaps 𝒜 ℳ f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
          hfg).map_mk (m : M)
    have hdecompV : (LocalizedModule.mk m
          (⟨veronesePower 𝒜 d f hf ^ j, ⟨j, rfl⟩⟩ :
            Submonoid.powers (veronesePower 𝒜 d f hf))) =
        (Localization.mk 1 (⟨veronesePower 𝒜 d f hf ^ j, ⟨j, rfl⟩⟩ :
            Submonoid.powers (veronesePower 𝒜 d f hf))) •
          LocalizedModule.mk m (1 : Submonoid.powers (veronesePower 𝒜 d f hf)) := by
      rw [LocalizedModule.mk_smul_mk, one_smul, mul_one]
    have hdecompS : (LocalizedModule.mk (m : M)
          (⟨f ^ (d * j), ⟨d * j, rfl⟩⟩ : Submonoid.powers f)) =
        (Localization.mk 1 (⟨f ^ (d * j), ⟨d * j, rfl⟩⟩ : Submonoid.powers f)) •
          LocalizedModule.mk (m : M) (1 : Submonoid.powers f) := by
      rw [LocalizedModule.mk_smul_mk, one_smul, mul_one]
    let _instV : Module (Localization.Away (veronesePower 𝒜 d f hf))
        (LocalizedModule.Away (veronesePower 𝒜 d g hg) (veroneseSubmodule 𝒜 ℳ d)) :=
      Module.compHom _ (ProjectiveSpectrum.localizedRingMap (veroneseGrading 𝒜 d)
        (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
        ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
        (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).toRingHom
    let _instS : Module (Localization.Away f) (LocalizedModule.Away (R := A) g M) :=
      Module.compHom _ (ProjectiveSpectrum.localizedRingMap 𝒜 f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
        hfg).toRingHom
    rw [veroneseLocalizedModuleFun_mk_pow, hdecompS, hdecompV, LinearMap.map_smul,
      LinearMap.map_smul, hmkV, hmkS]
    show veroneseLocalizedModuleFun 𝒜 d ℳ g hg
        ((ProjectiveSpectrum.localizedRingMap (veroneseGrading 𝒜 d)
            (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
            ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
            (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk))
          (Localization.mk 1 (⟨veronesePower 𝒜 d f hf ^ j, ⟨j, rfl⟩⟩ :
            Submonoid.powers (veronesePower 𝒜 d f hf))) •
          LocalizedModule.mk m (1 : Submonoid.powers (veronesePower 𝒜 d g hg))) =
      (ProjectiveSpectrum.localizedRingMap 𝒜 f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩ hfg)
          (Localization.mk 1 (⟨f ^ (d * j), ⟨d * j, rfl⟩⟩ : Submonoid.powers f)) •
        LocalizedModule.mk (m : M) (1 : Submonoid.powers g)
    rw [veroneseLocalizedModuleFun_smul, veroneseLocalizedModuleFun_mk_one,
      veroneseLocalizationMap_localizedRingMap 𝒜 d f g he hk hf hg hfg,
      veroneseLocalizationMap_mk_one]

/-- The module comparison commutes with the restriction maps `T₍f₎ → T₍g₎` attached to an
inclusion `D₊(g) ⊆ D₊(f)` and to the transported inclusion `D₊(g ᵈ) ⊆ D₊(f ᵈ)`. -/
@[ega "II 8.14.13" "(f)"]
theorem veroneseModuleAwayEquiv_naturality (hd : 0 < d) (f g : A) {e k : ℕ}
    (he : 0 < e) (hk : 0 < k) (hf : f ∈ 𝒜 e) (hg : g ∈ 𝒜 k)
    (hfg : ProjectiveSpectrum.basicOpen 𝒜 g ≤ ProjectiveSpectrum.basicOpen 𝒜 f)
    (z : GradedModuleDegreeZeroLocalization (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf)) :
    veroneseModuleAwayEquiv 𝒜 d ℳ g hg hd
        ((ProjectiveSpectrum.moduleRestrictionMaps (veroneseGrading 𝒜 d)
          (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
          ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
          (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).degreeZeroMap z) =
      (ProjectiveSpectrum.moduleRestrictionMaps 𝒜 ℳ f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
        hfg).degreeZeroMap (veroneseModuleAwayEquiv 𝒜 d ℳ f hf hd z) := by
  apply Subtype.ext
  rw [coe_veroneseModuleAwayEquiv,
    (ProjectiveSpectrum.moduleRestrictionMaps (veroneseGrading 𝒜 d)
      (veroneseModuleGrading 𝒜 ℳ d) (veronesePower 𝒜 d f hf) (veronesePower 𝒜 d g hg)
      ⟨e, he, veronesePower_mem 𝒜 d f hf⟩ ⟨k, hk, veronesePower_mem 𝒜 d g hg⟩
      (basicOpen_veronesePower_le 𝒜 d f g hf hg hfg he hk)).degreeZeroMap_val,
    (ProjectiveSpectrum.moduleRestrictionMaps 𝒜 ℳ f g ⟨e, he, hf⟩ ⟨k, hk, hg⟩
      hfg).degreeZeroMap_val, coe_veroneseModuleAwayEquiv,
    veroneseLocalizedModuleFun_localizedMap 𝒜 d ℳ f g he hk hf hg hfg]

end ModuleNaturality

