module

public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import StacksFrontier.RingTheory.GradedAlgebra.NoetherianModel

/-!
# Quotients of a weighted polynomial ring by weighted homogeneous relations

Fix a commutative ring `R`, a family of variables `ι` with weights `w : ι → ℕ`, and a family of
relations `rel : κ → R[xᵢ]` with `rel j` weighted homogeneous of degree `deg j`. The quotient
`A = R[xᵢ] / (rel j)` then carries the grading whose degree-`d` piece is the image of the
weighted homogeneous polynomials of degree `d`, and the class of the variable `xᵢ` is
homogeneous of degree `w i`.

## Main definitions

* `Stacks.WeightedQuotient.relationIdeal`: the ideal generated by the relations.
* `Stacks.WeightedQuotient.ring`: the quotient algebra `R[xᵢ] / (rel j)`.
* `Stacks.WeightedQuotient.gen`: the class of a variable in the quotient.
* `Stacks.WeightedQuotient.grading`: the degreewise image of the weighted homogeneous
  polynomials.
* `Stacks.WeightedQuotient.gradedAlgebra`: the graded-algebra structure on the quotient.

## Main results

* `Stacks.WeightedQuotient.relationIdeal_isHomogeneous`: the relation ideal is homogeneous for
  the weighted grading.
* `Stacks.WeightedQuotient.mk_mem_grading`, `Stacks.WeightedQuotient.gen_mem_grading` and
  `Stacks.WeightedQuotient.algebraMap_mem_grading_zero`: which classes are homogeneous.
* `Stacks.WeightedQuotient.adjoin_range_gen_eq_top`: the classes of the variables generate the
  quotient as an algebra over its degree-zero part.
-/

@[expose] public section

noncomputable section

open MvPolynomial

namespace Stacks.WeightedQuotient

universe u

variable {R : Type u} [CommRing R] {ι κ : Type}

/-- The ideal of `R[xᵢ]` generated by a family of relations. -/
public def relationIdeal (rel : κ → MvPolynomial ι R) : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range rel)

/-- The quotient algebra `R[xᵢ] / (rel j)` presented by a family of relations. -/
public abbrev ring (rel : κ → MvPolynomial ι R) : Type u :=
  MvPolynomial ι R ⧸ relationIdeal rel

/-- The class of the variable `xᵢ` in the quotient. -/
public def gen (rel : κ → MvPolynomial ι R) (i : ι) : ring rel :=
  Ideal.Quotient.mk (relationIdeal rel) (X i)

section Grading

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable (w : ι → ℕ) (deg : κ → ℕ) (rel : κ → MvPolynomial ι R)

/-- The grading of `R[xᵢ] / (rel j)` by weighted degree: the degree-`d` piece is the image of
the weighted homogeneous polynomials of weighted degree `d`. -/
public def grading (d : ℕ) : Submodule R (ring rel) :=
  Stacks.GradedModel.quotientGrading (weightedHomogeneousSubmodule R w) (relationIdeal rel) d

/-- The class of a weighted homogeneous polynomial of degree `d` is homogeneous of degree `d`. -/
public theorem mk_mem_grading {d : ℕ} {p : MvPolynomial ι R}
    (hp : p.IsWeightedHomogeneous w d) :
    Ideal.Quotient.mk (relationIdeal rel) p ∈ grading w rel d :=
  Stacks.GradedModel.mk_mem_quotientGrading
    ((mem_weightedHomogeneousSubmodule R w d p).mpr hp)

/-- An ideal generated by weighted homogeneous polynomials is homogeneous for the weighted
grading. -/
public theorem relationIdeal_isHomogeneous
    (hrel : ∀ j, (rel j).IsWeightedHomogeneous w (deg j)) :
    (relationIdeal rel).IsHomogeneous (weightedHomogeneousSubmodule R w) :=
  Ideal.homogeneous_span _ _ (by
    rintro _ ⟨j, rfl⟩
    exact ⟨deg j, (mem_weightedHomogeneousSubmodule R w (deg j) (rel j)).mpr (hrel j)⟩)

/-- The graded-algebra structure on the quotient of a weighted polynomial ring by weighted
homogeneous relations: the decomposition of the quotient by a homogeneous ideal, transported to
the submodule-valued grading. -/
@[instance_reducible]
public def gradedAlgebra (hrel : ∀ j, (rel j).IsWeightedHomogeneous w (deg j)) :
    GradedAlgebra (grading w rel) :=
  Stacks.GradedModel.quotientGradedAlgebra (weightedHomogeneousSubmodule R w)
    (relationIdeal_isHomogeneous w deg rel hrel)

/-- The class of the variable `xᵢ` is homogeneous of degree `w i`. -/
public theorem gen_mem_grading (i : ι) : gen rel i ∈ grading w rel (w i) :=
  mk_mem_grading w rel (isWeightedHomogeneous_X R w i)

/-- The image of a scalar lies in the degree-zero piece. -/
public theorem algebraMap_mem_grading_zero (r : R) :
    algebraMap R (ring rel) r ∈ grading w rel 0 := by
  rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  exact mk_mem_grading w rel (isWeightedHomogeneous_C w r)

/-- The classes of the variables generate the quotient as an algebra over its degree-zero
piece. -/
public theorem adjoin_range_gen_eq_top [GradedAlgebra (grading w rel)] :
    Algebra.adjoin (grading w rel 0) (Set.range (gen rel)) = ⊤ := by
  set B : Subalgebra (grading w rel 0) (ring rel) :=
    Algebra.adjoin (grading w rel 0) (Set.range (gen rel))
  refine top_unique fun y _ => ?_
  have hmk (p : MvPolynomial ι R) : Ideal.Quotient.mk (relationIdeal rel) p ∈ B := by
    induction p using MvPolynomial.induction_on with
    | C a => exact B.algebraMap_mem ⟨_, mk_mem_grading w rel (isWeightedHomogeneous_C w a)⟩
    | add p q hp hq => simpa only [map_add] using B.add_mem hp hq
    | mul_X p i hp =>
        rw [map_mul]
        exact B.mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact hmk p

end Grading

end Stacks.WeightedQuotient

end

end
