module

public import Mathlib.Algebra.DirectSum.Internal
public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.RingTheory.Ideal.Operations
public import StacksCore.Tactic.StacksAttribute

/-!
# The truncation graded ring of a graded ring

Let `A = ⨁_{d ≥ 0} A_d` be a graded ring. For `m ≥ 0` the `m`-th *truncation* of `A` is
the additive subgroup

  `A_{≥ m} = ⨁_{d ≥ m} A_d ⊆ A`

generated by the homogeneous elements of degree at least `m`. Because `1 ∈ A_0 = A_{≥ 0}`
and `A_{≥ d} · A_{≥ e} ⊆ A_{≥ d+e}`, the truncations form a graded monoid of additive
subgroups of `A`, so the external direct sum

  `B = ⨁_{d ≥ 0} A_{≥ d}`

is a commutative ring: writing `a⁽ᵈ⁾` for the element of the `d`-th summand attached to
`a ∈ A_{≥ d}`, the multiplication is `a⁽ᵈ⁾ · b⁽ᵉ⁾ = (ab)⁽ᵈ⁺ᵉ⁾`. The ring `B` is graded by
the additive subgroups `B_d` which are the images of its summands, and `A_{≥ d} ≃ B_d`.

Three canonical ring maps relate `A` and `B`:

* `σ : A ≃+* B_0`, `a ↦ a⁽⁰⁾`;
* `ψ : A → B`, the graded ring map determined by `ψ(a) = a⁽ᵈ⁾` for `a ∈ A_d`;
* `τ : B → A`, the graded ring map determined by `τ(a⁽ᵈ⁾) = a_d`, the degree-`d`
  homogeneous component of `a`; so `τ(a⁽ᵈ⁾) = a` when `a ∈ A_d`, and `τ(a⁽ᵈ⁾) = 0` when
  `a ∈ A_{d'}` for some `d' > d`.

They satisfy `τ ∘ ψ = id_A`; in particular `τ` is surjective. The ring `B` together with
`σ`, `ψ` and `τ` is determined by this data up to a unique isomorphism compatible with the
identifications `A_{≥ d} ≃ B_d`.

## Main definitions

* `Stacks.Truncation.truncation 𝒜 m` is `A_{≥ m}`.
* `Stacks.Truncation.TruncationRing 𝒜` is the ring `B = ⨁_{d ≥ 0} A_{≥ d}`, and
  `Stacks.Truncation.grading 𝒜` is its grading, with `Stacks.Truncation.degreeEquiv 𝒜 d`
  the identification `A_{≥ d} ≃+ B_d` of `a` with `a⁽ᵈ⁾`.
* `Stacks.Truncation.sigma 𝒜`, `Stacks.Truncation.psi 𝒜` and `Stacks.Truncation.tau 𝒜`
  are the maps `σ`, `ψ` and `τ`.
* `Stacks.Truncation.TruncationAlgebra 𝒜` bundles a graded ring with the identifications
  `A_{≥ d} ≃+ B_d`, the three maps and the formulas defining them, and
  `Stacks.Truncation.truncationAlgebra 𝒜` is the canonical such algebra.

## Main results

* `Stacks.Truncation.mem_truncation_iff` characterises `A_{≥ m}` as the elements all of
  whose homogeneous components of degree `< m` vanish.
* `Stacks.Truncation.proj_mul_of_mem_truncation` computes the degree-`(d+e)` component of a
  product of elements of `A_{≥ d}` and `A_{≥ e}`.
* `Stacks.Truncation.tau_comp_psi` says `τ ∘ ψ = id_A`, and
  `Stacks.Truncation.tau_surjective` says that `τ` is surjective.
* `Stacks.Truncation.truncationAlgebra_unique` says that any two truncation algebras are
  isomorphic by a unique ring isomorphism compatible with the identifications
  `A_{≥ d} ≃+ B_d`.
* `Stacks.Truncation.span_degreeOne_pow_eq_truncationIdeal` says that if `A_{d+1} ⊆ A_1 · A_d`
  for every `d` then `(A_1)^m = A_{≥ m}` for every `m ≥ 0`. The statement of Stacks, Section 0EKF,
  for `A` generated over `A_0` by `f_1, …, f_r ∈ A_1`, together with the identification of `B`
  with the Rees algebra of `A_+`, is in
  `StacksFrontier/RingTheory/GradedAlgebra/TruncationDegreeOne.lean`.

## References

* [Stacks Project, Tag 0EKF](https://stacks.math.columbia.edu/tag/0EKF)
* [Stacks Project, Tag 0EKG](https://stacks.math.columbia.edu/tag/0EKG)
-/

@[expose] public noncomputable section

open DirectSum

namespace Stacks.Truncation

universe u v

variable {A : Type u} [CommRing A] {σ : Type v} [SetLike σ A] [AddSubgroupClass σ A]

/-! ### The truncations `A_{≥ m}` -/

/-- The truncation `A_{≥ m} = ⨁_{d ≥ m} A_d` of a graded ring `A`, as the additive subgroup
of `A` generated by the homogeneous elements of degree at least `m`. -/
def truncation (𝒜 : ℕ → σ) (m : ℕ) : AddSubgroup A :=
  AddSubgroup.closure {a : A | ∃ d, m ≤ d ∧ a ∈ 𝒜 d}

variable (𝒜 : ℕ → σ)

omit [AddSubgroupClass σ A] in
/-- A homogeneous element of degree at least `m` lies in `A_{≥ m}`. -/
theorem mem_truncation_of_mem {m d : ℕ} (hmd : m ≤ d) {a : A} (ha : a ∈ 𝒜 d) :
    a ∈ truncation 𝒜 m :=
  AddSubgroup.subset_closure ⟨d, hmd, ha⟩

omit [AddSubgroupClass σ A] in
/-- The truncations are decreasing: `A_{≥ m} ⊆ A_{≥ n}` for `n ≤ m`. -/
theorem truncation_le_truncation {m n : ℕ} (hnm : n ≤ m) :
    truncation 𝒜 m ≤ truncation 𝒜 n :=
  AddSubgroup.closure_mono fun _ ⟨d, hd, had⟩ ↦ ⟨d, hnm.trans hd, had⟩

omit [AddSubgroupClass σ A] in
/-- The product of an element of `A_{≥ i}` and an element of `A_{≥ j}` lies in
`A_{≥ i+j}`. -/
theorem mul_mem_truncation [SetLike.GradedMonoid 𝒜] {i j : ℕ} {a b : A}
    (ha : a ∈ truncation 𝒜 i) (hb : b ∈ truncation 𝒜 j) :
    a * b ∈ truncation 𝒜 (i + j) := by
  induction ha using AddSubgroup.closure_induction with
  | mem x hx =>
    induction hb using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨d, hd, hxd⟩ := hx
      obtain ⟨e, he, hye⟩ := hy
      exact mem_truncation_of_mem 𝒜 (Nat.add_le_add hd he) (SetLike.mul_mem_graded hxd hye)
    | zero => rw [mul_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
    | neg y _ hy => rw [mul_neg]; exact neg_mem hy
  | zero => rw [zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | neg x _ hx => rw [neg_mul]; exact neg_mem hx

/-- The truncations of a graded ring form a graded monoid of additive subgroups: `1 ∈ A_{≥ 0}`
and `A_{≥ i} · A_{≥ j} ⊆ A_{≥ i+j}`. -/
instance instGradedMonoidTruncation [SetLike.GradedMonoid 𝒜] :
    SetLike.GradedMonoid (truncation 𝒜) where
  one_mem := mem_truncation_of_mem 𝒜 le_rfl (SetLike.one_mem_graded 𝒜)
  mul_mem := @fun _ _ _ _ ha hb ↦ mul_mem_truncation 𝒜 ha hb

section GradedRing

variable [GradedRing 𝒜]

/-- A homogeneous element is killed by the projection onto any other degree. -/
theorem proj_of_mem_ne {d k : ℕ} {a : A} (ha : a ∈ 𝒜 d) (hdk : d ≠ k) :
    GradedRing.proj 𝒜 k a = 0 :=
  DirectSum.decompose_of_mem_ne 𝒜 ha hdk

/-- A homogeneous element is its own projection onto its degree. -/
private theorem proj_of_mem_same {d : ℕ} {a : A} (ha : a ∈ 𝒜 d) :
    GradedRing.proj 𝒜 d a = a :=
  (GradedRing.proj_apply 𝒜 _ _).trans (DirectSum.decompose_of_mem_same 𝒜 ha)

/-- An element of `A_{≥ m}` has no homogeneous component in degree `< m`. -/
theorem proj_eq_zero_of_mem_truncation {m k : ℕ} (hkm : k < m) {a : A}
    (ha : a ∈ truncation 𝒜 m) : GradedRing.proj 𝒜 k a = 0 := by
  induction ha using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨d, hd, hxd⟩ := hx
    exact proj_of_mem_ne 𝒜 hxd (by omega)
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | neg x _ hx => rw [map_neg, hx, neg_zero]

/-- `A_{≥ m}` consists exactly of the elements whose homogeneous components of degree `< m`
all vanish. -/
theorem mem_truncation_iff {m : ℕ} {a : A} :
    a ∈ truncation 𝒜 m ↔ ∀ k < m, GradedRing.proj 𝒜 k a = 0 := by
  classical
  refine ⟨fun ha k hk ↦ proj_eq_zero_of_mem_truncation 𝒜 hk ha, fun h ↦ ?_⟩
  rw [← DirectSum.sum_support_decompose 𝒜 a]
  refine sum_mem fun i hi ↦ mem_truncation_of_mem 𝒜 ?_ (SetLike.coe_mem _)
  by_contra hlt
  exact (GradedRing.mem_support_iff 𝒜 a i).mp hi (h i (by omega))

/-- `A_{≥ 0} = A`. -/
theorem mem_truncation_zero (a : A) : a ∈ truncation 𝒜 0 :=
  (mem_truncation_iff 𝒜).mpr fun _ hk ↦ absurd hk (by omega)

/-- Subtracting its degree-`d` component moves an element of `A_{≥ d}` into `A_{≥ d+1}`. -/
theorem sub_proj_mem_truncation_succ {d : ℕ} {a : A} (ha : a ∈ truncation 𝒜 d) :
    a - GradedRing.proj 𝒜 d a ∈ truncation 𝒜 (d + 1) := by
  rw [mem_truncation_iff]
  intro k hk
  rw [map_sub]
  have hp : GradedRing.proj 𝒜 d a ∈ 𝒜 d := SetLike.coe_mem _
  rcases Nat.lt_or_ge k d with h | h
  · rw [proj_eq_zero_of_mem_truncation 𝒜 h ha, proj_of_mem_ne 𝒜 hp (by omega), sub_zero]
  · obtain rfl : k = d := by omega
    rw [proj_of_mem_same 𝒜 hp, sub_self]

/-- For `a ∈ A_{≥ d}` and `b ∈ A_{≥ e}` the degree-`(d+e)` component of `a * b` is the
product of the degree-`d` component of `a` and the degree-`e` component of `b`. -/
theorem proj_mul_of_mem_truncation {d e : ℕ} {a b : A} (ha : a ∈ truncation 𝒜 d)
    (hb : b ∈ truncation 𝒜 e) :
    GradedRing.proj 𝒜 (d + e) (a * b) =
      GradedRing.proj 𝒜 d a * GradedRing.proj 𝒜 e b := by
  have hA : GradedRing.proj 𝒜 d a ∈ 𝒜 d := SetLike.coe_mem _
  have hB : GradedRing.proj 𝒜 e b ∈ 𝒜 e := SetLike.coe_mem _
  have ha' := sub_proj_mem_truncation_succ 𝒜 ha
  have hb' := sub_proj_mem_truncation_succ 𝒜 hb
  have hz1 := proj_eq_zero_of_mem_truncation 𝒜 (show d + e < d + (e + 1) by omega)
    (mul_mem_truncation 𝒜 (mem_truncation_of_mem 𝒜 le_rfl hA) hb')
  have hz2 := proj_eq_zero_of_mem_truncation 𝒜 (show d + e < d + 1 + e by omega)
    (mul_mem_truncation 𝒜 ha' (mem_truncation_of_mem 𝒜 le_rfl hB))
  have hz3 := proj_eq_zero_of_mem_truncation 𝒜 (show d + e < d + 1 + (e + 1) by omega)
    (mul_mem_truncation 𝒜 ha' hb')
  have hs := proj_of_mem_same 𝒜 (SetLike.mul_mem_graded hA hB)
  have key : a * b = GradedRing.proj 𝒜 d a * GradedRing.proj 𝒜 e b +
      (GradedRing.proj 𝒜 d a * (b - GradedRing.proj 𝒜 e b) +
        ((a - GradedRing.proj 𝒜 d a) * GradedRing.proj 𝒜 e b +
          (a - GradedRing.proj 𝒜 d a) * (b - GradedRing.proj 𝒜 e b))) := by ring
  rw [key, map_add, map_add, map_add, hz1, hz2, hz3, hs]
  simp

end GradedRing

/-! ### The truncation graded ring `B = ⨁_{d ≥ 0} A_{≥ d}` -/

/-- The truncation graded ring `B = ⨁_{d ≥ 0} A_{≥ d}` of a graded ring `A`. Its ring
structure is the one carried by the external direct sum of a graded monoid of additive
subgroups, so that `a⁽ᵈ⁾ · b⁽ᵉ⁾ = (ab)⁽ᵈ⁺ᵉ⁾`. -/
abbrev TruncationRing (𝒜 : ℕ → σ) : Type u := ⨁ d : ℕ, ↥(truncation 𝒜 d)

/-- The degree-`d` part `B_d` of `B = ⨁_{d ≥ 0} A_{≥ d}`: the image of the `d`-th summand
`A_{≥ d}` under the inclusion into the direct sum. -/
def grading (𝒜 : ℕ → σ) (d : ℕ) : AddSubgroup (TruncationRing 𝒜) where
  carrier := Set.range (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d)
  add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a + b, map_add _ _ _⟩
  zero_mem' := ⟨0, map_zero _⟩
  neg_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨-a, map_neg _ _⟩

omit [AddSubgroupClass σ A] in
/-- `B_d` consists of the elements supported in the `d`-th summand. -/
theorem mem_grading_iff {d : ℕ} {x : TruncationRing 𝒜} :
    x ∈ grading 𝒜 d ↔
      ∃ a : truncation 𝒜 d, DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d a = x :=
  Iff.rfl

omit [AddSubgroupClass σ A] in
/-- `a⁽ᵈ⁾` lies in `B_d`. -/
theorem mem_grading (d : ℕ) (a : truncation 𝒜 d) :
    DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d a ∈ grading 𝒜 d :=
  (mem_grading_iff 𝒜).mpr ⟨a, rfl⟩

/-- The identification `A_{≥ d} ≃+ B_d` sending `a` to `a⁽ᵈ⁾`. -/
def degreeEquiv (d : ℕ) : truncation 𝒜 d ≃+ grading 𝒜 d where
  toFun a := ⟨DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d a, mem_grading 𝒜 d a⟩
  invFun x := (x : TruncationRing 𝒜) d
  left_inv a := DirectSum.of_eq_same (β := fun e ↦ ↥(truncation 𝒜 e)) d a
  right_inv x := by
    obtain ⟨a, ha⟩ := (mem_grading_iff 𝒜).mp x.2
    refine Subtype.ext ?_
    change DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d ((x : TruncationRing 𝒜) d) =
      (x : TruncationRing 𝒜)
    rw [← ha, DirectSum.of_eq_same]
  map_add' a b := Subtype.ext (map_add _ a b)

omit [AddSubgroupClass σ A] in
/-- `a⁽ᵈ⁾` is the image of `a` under the `d`-th inclusion into the direct sum. -/
@[simp]
theorem coe_degreeEquiv (d : ℕ) (a : truncation 𝒜 d) :
    ((degreeEquiv 𝒜 d a : grading 𝒜 d) : TruncationRing 𝒜) =
      DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d a :=
  rfl

/-- The decomposition map `B → ⨁_d B_d`, sending the `d`-th summand `A_{≥ d}` into `B_d`
by `a ↦ a⁽ᵈ⁾`. -/
def gradingDecompose : TruncationRing 𝒜 →+ ⨁ d : ℕ, ↥(grading 𝒜 d) :=
  DirectSum.toAddMonoid fun d ↦
    (DirectSum.of (fun e ↦ ↥(grading 𝒜 e)) d).comp (degreeEquiv 𝒜 d).toAddMonoidHom

omit [AddSubgroupClass σ A] in
/-- The decomposition map sends `a⁽ᵈ⁾` to `a⁽ᵈ⁾` in the `d`-th summand `B_d`. -/
@[simp]
theorem gradingDecompose_of (d : ℕ) (a : truncation 𝒜 d) :
    gradingDecompose 𝒜 (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d a) =
      DirectSum.of (fun e ↦ ↥(grading 𝒜 e)) d (degreeEquiv 𝒜 d a) :=
  DirectSum.toAddMonoid_of _ _ _

/-- `B` is the direct sum of the `B_d`: this is the tautological decomposition of an
external direct sum into its summands, transported along `A_{≥ d} ≃+ B_d`. -/
@[instance_reducible]
def gradingDecomposition : DirectSum.Decomposition (grading 𝒜) :=
  DirectSum.Decomposition.ofAddHom (grading 𝒜) (gradingDecompose 𝒜)
    (by
      refine DirectSum.addHom_ext fun d a ↦ ?_
      simp only [AddMonoidHom.comp_apply, gradingDecompose_of, DirectSum.coeAddMonoidHom_of,
        AddMonoidHom.id_apply, coe_degreeEquiv])
    (by
      refine DirectSum.addHom_ext fun d x ↦ ?_
      have hx : (x : TruncationRing 𝒜) =
          DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d ((degreeEquiv 𝒜 d).symm x) := by
        rw [← coe_degreeEquiv 𝒜 d ((degreeEquiv 𝒜 d).symm x), AddEquiv.apply_symm_apply]
      simp only [AddMonoidHom.comp_apply, DirectSum.coeAddMonoidHom_of, AddMonoidHom.id_apply,
        hx, gradingDecompose_of, AddEquiv.apply_symm_apply])

section Grading

variable [SetLike.GradedMonoid 𝒜]

omit [AddSubgroupClass σ A] in
/-- `a⁽ᵈ⁾ · b⁽ᵉ⁾ = (ab)⁽ᵈ⁺ᵉ⁾`. -/
theorem coe_degreeEquiv_mul (d e : ℕ) (a b : A) (ha : a ∈ truncation 𝒜 d)
    (hb : b ∈ truncation 𝒜 e) (hab : a * b ∈ truncation 𝒜 (d + e)) :
    ((degreeEquiv 𝒜 d ⟨a, ha⟩ : grading 𝒜 d) : TruncationRing 𝒜) *
        ((degreeEquiv 𝒜 e ⟨b, hb⟩ : grading 𝒜 e) : TruncationRing 𝒜) =
      ((degreeEquiv 𝒜 (d + e) ⟨a * b, hab⟩ : grading 𝒜 (d + e)) : TruncationRing 𝒜) :=
  DirectSum.of_mul_of (A := fun e ↦ ↥(truncation 𝒜 e)) ⟨a, ha⟩ ⟨b, hb⟩

omit [AddSubgroupClass σ A] in
/-- The unit of `B` is `1⁽⁰⁾`, so it lies in `B_0`. -/
theorem one_mem_grading : (1 : TruncationRing 𝒜) ∈ grading 𝒜 0 :=
  (mem_grading_iff 𝒜).mpr
    ⟨⟨1, mem_truncation_of_mem 𝒜 le_rfl (SetLike.one_mem_graded 𝒜)⟩, rfl⟩

/-- The grading of `B` is a graded monoid of additive subgroups: `1 ∈ B_0` and
`B_i · B_j ⊆ B_{i+j}`. -/
instance instGradedMonoidGrading : SetLike.GradedMonoid (grading 𝒜) where
  one_mem := one_mem_grading 𝒜
  mul_mem := @fun i j x y hx hy ↦ by
    obtain ⟨a, rfl⟩ := (mem_grading_iff 𝒜).mp hx
    obtain ⟨b, rfl⟩ := (mem_grading_iff 𝒜).mp hy
    exact (mem_grading_iff 𝒜).mpr
      ⟨_, (DirectSum.of_mul_of (A := fun e ↦ ↥(truncation 𝒜 e)) a b).symm⟩

/-- `B = ⨁_{d ≥ 0} A_{≥ d}` is a graded ring with degree-`d` part `B_d ≃ A_{≥ d}`. -/
@[stacks 0EKG "the graded ring B = ⨁_{d ≥ 0} A_{≥ d}"]
instance instGradedRingGrading : GradedRing (grading 𝒜) :=
  { instGradedMonoidGrading 𝒜, gradingDecomposition 𝒜 with }

omit [AddSubgroupClass σ A] in
/-- Multiplication in `B_0` is the multiplication of `B`. -/
theorem coe_gradeZero_mul (u v : grading 𝒜 0) :
    ((u * v : grading 𝒜 0) : TruncationRing 𝒜) =
      ((u : TruncationRing 𝒜)) * ((v : TruncationRing 𝒜)) :=
  rfl

end Grading

/-! ### The maps `σ`, `ψ` and `τ` -/

section Maps

variable [GradedRing 𝒜]

/-- `A ≃+ A_{≥ 0}`: the truncation at `0` is all of `A`. -/
def truncationZeroEquiv : A ≃+ truncation 𝒜 0 where
  toFun a := ⟨a, mem_truncation_zero 𝒜 a⟩
  invFun a := a
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- The ring isomorphism `σ : A ≃+* B_0`, `a ↦ a⁽⁰⁾`. -/
@[stacks 0EKG "the isomorphism σ : A ≃ B₀"]
def sigma : A ≃+* grading 𝒜 0 :=
  { (truncationZeroEquiv 𝒜).trans (degreeEquiv 𝒜 0) with
    map_mul' := fun a b ↦ Subtype.ext <| by
      rw [coe_gradeZero_mul]
      exact (coe_degreeEquiv_mul 𝒜 0 0 a b (mem_truncation_zero 𝒜 a)
        (mem_truncation_zero 𝒜 b) (mem_truncation_zero 𝒜 (a * b))).symm }

/-- `σ(a) = a⁽⁰⁾`. -/
theorem coe_sigma_apply (a : A) (ha : a ∈ truncation 𝒜 0) :
    ((sigma 𝒜 a : grading 𝒜 0) : TruncationRing 𝒜) =
      ((degreeEquiv 𝒜 0 ⟨a, ha⟩ : grading 𝒜 0) : TruncationRing 𝒜) :=
  rfl

/-- The inclusion `A_d → A_{≥ d}` of a homogeneous part into the truncation it generates. -/
def ofHomogeneous (d : ℕ) : ↥(𝒜 d) →+ ↥(truncation 𝒜 d) where
  toFun a := ⟨a, mem_truncation_of_mem 𝒜 le_rfl a.2⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- The ring map `⨁_d A_d → B` sending the degree-`d` part of `A` into `B_d`. -/
def psiSum : (⨁ d : ℕ, ↥(𝒜 d)) →+* TruncationRing 𝒜 :=
  DirectSum.toSemiring
    (fun d ↦ (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d).comp (ofHomogeneous 𝒜 d)) rfl
    fun {i j} x y ↦
      (DirectSum.of_mul_of (A := fun e ↦ ↥(truncation 𝒜 e))
        (ofHomogeneous 𝒜 i x) (ofHomogeneous 𝒜 j y)).symm

/-- `psiSum` sends `a ∈ A_d` in the `d`-th summand to `a⁽ᵈ⁾`. -/
@[simp]
theorem psiSum_of (d : ℕ) (a : ↥(𝒜 d)) :
    psiSum 𝒜 (DirectSum.of (fun e ↦ ↥(𝒜 e)) d a) =
      DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d (ofHomogeneous 𝒜 d a) :=
  DirectSum.toSemiring_of _ _ _ _ _

/-- The ring map `A →+* B` underlying the graded ring map `ψ`. -/
def psiRingHom : A →+* TruncationRing 𝒜 :=
  (psiSum 𝒜).comp (DirectSum.decomposeRingEquiv 𝒜).toRingHom

/-- `psiRingHom` is `psiSum` applied to the decomposition of `a` into homogeneous
components. -/
theorem psiRingHom_apply (a : A) :
    psiRingHom 𝒜 a = psiSum 𝒜 (DirectSum.decompose 𝒜 a) :=
  rfl

/-- `ψ(a) = a⁽ᵈ⁾` for `a ∈ A_d`. -/
theorem psiRingHom_of_mem {d : ℕ} {a : A} (ha : a ∈ 𝒜 d) :
    psiRingHom 𝒜 a =
      DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d ⟨a, mem_truncation_of_mem 𝒜 le_rfl ha⟩ := by
  rw [psiRingHom_apply, DirectSum.decompose_of_mem 𝒜 ha, psiSum_of]
  rfl

/-- The graded ring map `ψ : A → B` with `ψ(a) = a⁽ᵈ⁾` for `a ∈ A_d`. -/
@[stacks 0EKG "the graded ring map ψ : A → B"]
def psi : 𝒜 →+*ᵍ grading 𝒜 where
  __ := psiRingHom 𝒜
  map_mem {d a} ha := by
    rw [psiRingHom_of_mem 𝒜 ha]
    exact mem_grading 𝒜 d _

/-- `ψ(a) = a⁽ᵈ⁾` for `a ∈ A_d`. -/
theorem psi_apply (d : ℕ) (a : A) (ha : a ∈ 𝒜 d) (ha' : a ∈ truncation 𝒜 d) :
    psi 𝒜 a = ((degreeEquiv 𝒜 d ⟨a, ha'⟩ : grading 𝒜 d) : TruncationRing 𝒜) :=
  psiRingHom_of_mem 𝒜 ha

/-- The ring map `B →+* A` underlying the graded ring map `τ`: it sends `a⁽ᵈ⁾` to the
degree-`d` homogeneous component of `a`. -/
def tauRingHom : TruncationRing 𝒜 →+* A :=
  DirectSum.toSemiring
    (fun d ↦ (GradedRing.proj 𝒜 d).comp (AddSubgroupClass.subtype (truncation 𝒜 d)))
    (DirectSum.decompose_of_mem_same 𝒜 (SetLike.one_mem_graded 𝒜))
    fun a b ↦ proj_mul_of_mem_truncation 𝒜 a.2 b.2

/-- `tauRingHom` sends `a⁽ᵈ⁾` to the degree-`d` homogeneous component of `a`. -/
@[simp]
theorem tauRingHom_of (d : ℕ) (a : truncation 𝒜 d) :
    tauRingHom 𝒜 (DirectSum.of (fun e ↦ ↥(truncation 𝒜 e)) d a) =
      GradedRing.proj 𝒜 d a :=
  DirectSum.toSemiring_of _ _ _ _ _

/-- `τ` is graded: it sends `B_d` into `A_d`. -/
theorem tauRingHom_mem {d : ℕ} {x : TruncationRing 𝒜} (hx : x ∈ grading 𝒜 d) :
    tauRingHom 𝒜 x ∈ 𝒜 d := by
  obtain ⟨a, rfl⟩ := (mem_grading_iff 𝒜).mp hx
  rw [tauRingHom_of 𝒜 d a]
  exact SetLike.coe_mem _

/-- The surjective graded ring map `τ : B → A` with `τ(a⁽ᵈ⁾) = a_d`. -/
@[stacks 0EKG "the graded ring map τ : B → A"]
def tau : grading 𝒜 →+*ᵍ 𝒜 where
  __ := tauRingHom 𝒜
  map_mem {_d _x} hx := tauRingHom_mem 𝒜 hx

/-- `τ(a⁽ᵈ⁾)` is the degree-`d` homogeneous component of `a`. -/
theorem tau_apply (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) :
    tau 𝒜 ((degreeEquiv 𝒜 d ⟨a, ha⟩ : grading 𝒜 d) : TruncationRing 𝒜) =
      GradedRing.proj 𝒜 d a :=
  tauRingHom_of 𝒜 d ⟨a, ha⟩

end Maps

/-! ### Truncation algebras and their uniqueness -/

/-- The data of a graded ring `B = ⨁_{d ≥ 0} A_{≥ d}` over a graded ring `A`: a graded ring
whose degree-`d` part is identified with `A_{≥ d}` by `a ↦ a⁽ᵈ⁾`, compatibly with
multiplication, together with the three canonical maps `σ`, `ψ` and `τ` and the formulas
describing them on the elements `a⁽ᵈ⁾`. -/
structure TruncationAlgebra (𝒜 : ℕ → σ) [GradedRing 𝒜] where
  /-- The underlying ring of `B`. -/
  B : Type u
  /-- The ring structure of `B`. -/
  [commRing : CommRing B]
  /-- The grading of `B`, with `B_d = A_{≥ d}`. -/
  grading : ℕ → AddSubgroup B
  /-- `B` is graded by `grading`. -/
  [gradedRing : GradedRing grading]
  /-- The identification `A_{≥ d} ≃ B_d`, written `a ↦ a⁽ᵈ⁾`. -/
  degreeEquiv (d : ℕ) : truncation 𝒜 d ≃+ grading d
  /-- `a⁽ᵈ⁾ * b⁽ᵉ⁾ = (a * b)⁽ᵈ⁺ᵉ⁾`. -/
  degreeEquiv_mul (d e : ℕ) (a b : A) (ha : a ∈ truncation 𝒜 d) (hb : b ∈ truncation 𝒜 e)
    (hab : a * b ∈ truncation 𝒜 (d + e)) :
    ((degreeEquiv d ⟨a, ha⟩ : B)) * ((degreeEquiv e ⟨b, hb⟩ : B)) =
      ((degreeEquiv (d + e) ⟨a * b, hab⟩ : B))
  /-- `σ : A ≃ B₀`, `σ(a) = a⁽⁰⁾`. -/
  sigma : A ≃+* grading 0
  /-- `ψ : A → B`, the graded ring map with `ψ(a) = a⁽ᵈ⁾` for `a ∈ A_d`. -/
  psi : 𝒜 →+*ᵍ grading
  /-- `τ : B → A`, the graded ring map with `τ(a⁽ᵈ⁾) = a_d`. -/
  tau : grading →+*ᵍ 𝒜
  /-- `σ(a) = a⁽⁰⁾`. -/
  sigma_apply (a : A) (ha : a ∈ truncation 𝒜 0) :
    ((sigma a : grading 0) : B) = ((degreeEquiv 0 ⟨a, ha⟩ : B))
  /-- `ψ(a) = a⁽ᵈ⁾` for `a ∈ A_d`. -/
  psi_apply (d : ℕ) (a : A) (ha : a ∈ 𝒜 d) (ha' : a ∈ truncation 𝒜 d) :
    psi a = ((degreeEquiv d ⟨a, ha'⟩ : B))
  /-- `τ(a⁽ᵈ⁾)` is the degree-`d` component of `a`. -/
  tau_apply (d : ℕ) (a : A) (ha : a ∈ truncation 𝒜 d) :
    tau ((degreeEquiv d ⟨a, ha⟩ : B)) = GradedRing.proj 𝒜 d a

attribute [instance] TruncationAlgebra.commRing TruncationAlgebra.gradedRing

section Algebra

variable [GradedRing 𝒜]

/-- The graded ring `B = ⨁_{d ≥ 0} A_{≥ d}` with its canonical maps `σ`, `ψ` and `τ`. -/
@[stacks 0EKG "the graded ring B and the maps σ, ψ, τ"]
def truncationAlgebra : TruncationAlgebra 𝒜 where
  B := TruncationRing 𝒜
  grading := grading 𝒜
  degreeEquiv := degreeEquiv 𝒜
  degreeEquiv_mul := coe_degreeEquiv_mul 𝒜
  sigma := sigma 𝒜
  psi := psi 𝒜
  tau := tau 𝒜
  sigma_apply := coe_sigma_apply 𝒜
  psi_apply := psi_apply 𝒜
  tau_apply := tau_apply 𝒜

variable (s : TruncationAlgebra 𝒜)

/-- `τ ∘ ψ = id_A`. -/
@[stacks 0EKG "τ ∘ ψ = id"]
theorem tau_comp_psi : s.tau.comp s.psi = GradedRingHom.id 𝒜 := by
  have key : ∀ a : A, s.tau (s.psi a) = a := by
    refine DirectSum.Decomposition.inductionOn 𝒜 ?_ ?_ ?_
    · rw [map_zero, map_zero]
    · intro d x
      rw [s.psi_apply d (x : A) x.2 (mem_truncation_of_mem 𝒜 le_rfl x.2),
        s.tau_apply d (x : A) (mem_truncation_of_mem 𝒜 le_rfl x.2),
        proj_of_mem_same 𝒜 x.2]
    · intro x y hx hy
      rw [map_add, map_add, hx, hy]
  exact GradedRingHom.ext key

/-- `τ` is surjective. -/
@[stacks 0EKG "τ is surjective"]
theorem tau_surjective : Function.Surjective s.tau := fun a ↦
  ⟨s.psi a, GradedRingHom.congr_fun (tau_comp_psi 𝒜 s) a⟩

/-- `a⁽ᵈ⁾ · b⁽ᵉ⁾ = (ab)⁽ᵈ⁺ᵉ⁾`, in bundled form. -/
theorem coe_degreeEquiv_mul' {d e : ℕ} (a : truncation 𝒜 d) (b : truncation 𝒜 e) :
    ((s.degreeEquiv d a : s.B)) * ((s.degreeEquiv e b : s.B)) =
      ((s.degreeEquiv (d + e) ⟨(a : A) * (b : A), mul_mem_truncation 𝒜 a.2 b.2⟩ : s.B)) :=
  s.degreeEquiv_mul d e a b a.2 b.2 _

/-- `1⁽⁰⁾ = 1`: the unit of `B` is the degree-zero element attached to `1`. -/
theorem coe_degreeEquiv_one :
    ((s.degreeEquiv 0 ⟨1, mem_truncation_zero 𝒜 1⟩ : s.grading 0) : s.B) = 1 := by
  rw [← s.sigma_apply 1 (mem_truncation_zero 𝒜 1), map_one]
  rfl

/-- Induction on `B`: it suffices to treat `0`, the elements `a⁽ᵈ⁾` and sums. -/
private theorem induction_on_degreeEquiv {P : s.B → Prop} (x : s.B) (h0 : P 0)
    (hd : ∀ (d : ℕ) (a : truncation 𝒜 d), P (s.degreeEquiv d a))
    (hadd : ∀ x y, P x → P y → P (x + y)) : P x := by
  refine DirectSum.Decomposition.inductionOn s.grading h0 (fun {d} u ↦ ?_) hadd x
  obtain ⟨a, rfl⟩ : ∃ a, s.degreeEquiv d a = u := ⟨_, (s.degreeEquiv d).apply_symm_apply u⟩
  exact hd d a

variable (t : TruncationAlgebra 𝒜)

/-- The degreewise comparison map `B_d → B'_d` between two truncation algebras, obtained
from the two identifications with `A_{≥ d}`. -/
def compareSummand (d : ℕ) : s.grading d →+ t.B :=
  (AddSubgroupClass.subtype (t.grading d)).comp
    ((t.degreeEquiv d).toAddMonoidHom.comp (s.degreeEquiv d).symm.toAddMonoidHom)

/-- `compareSummand` sends `x ∈ B_d` to the element of `B'_d` with the same preimage in
`A_{≥ d}`. -/
theorem compareSummand_apply (d : ℕ) (x : s.grading d) :
    compareSummand 𝒜 s t d x =
      ((t.degreeEquiv d ((s.degreeEquiv d).symm x) : t.grading d) : t.B) :=
  rfl

/-- The comparison additive map between two truncation algebras: it sends `a⁽ᵈ⁾` to
`a⁽ᵈ⁾`. -/
def compareAddHom : s.B →+ t.B :=
  (DirectSum.toAddMonoid (compareSummand 𝒜 s t)).comp
    (DirectSum.decomposeAddEquiv s.grading).toAddMonoidHom

/-- The comparison additive map sends `a⁽ᵈ⁾` to `a⁽ᵈ⁾`. -/
theorem compareAddHom_apply (d : ℕ) (a : truncation 𝒜 d) :
    compareAddHom 𝒜 s t ((s.degreeEquiv d a : s.B)) = ((t.degreeEquiv d a : t.B)) := by
  have hd : DirectSum.decompose s.grading ((s.degreeEquiv d a : s.B)) =
      DirectSum.of (fun e ↦ ↥(s.grading e)) d (s.degreeEquiv d a) :=
    DirectSum.decompose_of_mem s.grading (s.degreeEquiv d a).2
  have h0 : compareAddHom 𝒜 s t ((s.degreeEquiv d a : s.B)) =
      DirectSum.toAddMonoid (compareSummand 𝒜 s t)
        (DirectSum.decompose s.grading ((s.degreeEquiv d a : s.B))) := rfl
  rw [h0, hd, DirectSum.toAddMonoid_of, compareSummand_apply, AddEquiv.symm_apply_apply]

/-- The comparison additive map is multiplicative. -/
theorem compareAddHom_mul (x y : s.B) :
    compareAddHom 𝒜 s t (x * y) = compareAddHom 𝒜 s t x * compareAddHom 𝒜 s t y := by
  induction x using induction_on_degreeEquiv 𝒜 s with
  | h0 => rw [zero_mul, map_zero, zero_mul]
  | hd d a =>
    induction y using induction_on_degreeEquiv 𝒜 s with
    | h0 => rw [mul_zero, map_zero, mul_zero]
    | hd e b =>
      rw [coe_degreeEquiv_mul' 𝒜 s a b, compareAddHom_apply, compareAddHom_apply,
        compareAddHom_apply, coe_degreeEquiv_mul' 𝒜 t a b]
    | hadd v w hv hw => rw [mul_add, map_add, map_add, hv, hw, mul_add]
  | hadd u w hu hw => rw [add_mul, map_add, map_add, hu, hw, add_mul]

/-- The comparison ring map between two truncation algebras: it sends `a⁽ᵈ⁾` to `a⁽ᵈ⁾`. -/
def compare : s.B →+* t.B where
  toFun := compareAddHom 𝒜 s t
  map_one' := by
    rw [← coe_degreeEquiv_one 𝒜 s, compareAddHom_apply, coe_degreeEquiv_one 𝒜 t]
  map_mul' := compareAddHom_mul 𝒜 s t
  map_zero' := map_zero _
  map_add' := map_add _

/-- The comparison ring map sends `a⁽ᵈ⁾` to `a⁽ᵈ⁾`. -/
theorem compare_apply (d : ℕ) (a : truncation 𝒜 d) :
    compare 𝒜 s t ((s.degreeEquiv d a : s.B)) = ((t.degreeEquiv d a : t.B)) :=
  compareAddHom_apply 𝒜 s t d a

/-- The comparison maps in the two directions are mutually inverse. -/
theorem compare_compare (x : s.B) : compare 𝒜 t s (compare 𝒜 s t x) = x := by
  induction x using induction_on_degreeEquiv 𝒜 s with
  | h0 => rw [map_zero, map_zero]
  | hd d a => rw [compare_apply, compare_apply]
  | hadd u v hu hv => rw [map_add, map_add, hu, hv]

/-- The comparison ring isomorphism between two truncation algebras: it sends `a⁽ᵈ⁾` to
`a⁽ᵈ⁾`, and its inverse is the comparison map in the other direction. -/
def compareEquiv : s.B ≃+* t.B where
  toFun := compare 𝒜 s t
  invFun := compare 𝒜 t s
  left_inv := compare_compare 𝒜 s t
  right_inv := compare_compare 𝒜 t s
  map_mul' := map_mul (compare 𝒜 s t)
  map_add' := map_add (compare 𝒜 s t)

/-- The comparison ring isomorphism sends `a⁽ᵈ⁾` to `a⁽ᵈ⁾`. -/
theorem compareEquiv_apply (d : ℕ) (a : truncation 𝒜 d) :
    compareEquiv 𝒜 s t ((s.degreeEquiv d a : s.B)) = ((t.degreeEquiv d a : t.B)) :=
  compare_apply 𝒜 s t d a

/-- Two truncation algebras are isomorphic by a unique ring isomorphism compatible with the
identifications `A_{≥ d} ≃+ B_d`. -/
@[stacks 0EKG "uniqueness of the graded ring B"]
theorem truncationAlgebra_unique :
    ∃! e : s.B ≃+* t.B, ∀ (d : ℕ) (a : truncation 𝒜 d),
      e ((s.degreeEquiv d a : s.B)) = ((t.degreeEquiv d a : t.B)) := by
  refine ⟨compareEquiv 𝒜 s t, compareEquiv_apply 𝒜 s t, ?_⟩
  intro e he
  refine RingEquiv.ext fun x ↦ ?_
  induction x using induction_on_degreeEquiv 𝒜 s with
  | h0 => rw [map_zero, map_zero]
  | hd d a => rw [he d a, compareEquiv_apply]
  | hadd u v hu hv => rw [map_add, map_add, hu, hv]

end Algebra

/-! ### `A` generated in degree one: `B` is the Rees algebra of `A_+`

The truncations of a graded ring `A` are ideals of `A`, and `(A_+)^m ⊆ A_{≥ m}` always.  When
`A` is generated over `A_0` by its degree-one part the two agree, so that
`B = ⨁_{d ≥ 0} A_{≥ d}` is the Rees algebra of `A_+`. -/

section ReesAlgebra

variable [GradedRing 𝒜]

/-- The truncation `A_{≥ m}` as an ideal of `A`. -/
def truncationIdeal (m : ℕ) : Ideal A where
  carrier := truncation 𝒜 m
  add_mem' := add_mem
  zero_mem' := zero_mem _
  smul_mem' c x hx := by
    simpa using mul_mem_truncation 𝒜 (mem_truncation_zero 𝒜 c) hx

/-- Membership in the ideal `A_{≥ m}` is membership in the additive subgroup `A_{≥ m}`. -/
theorem mem_truncationIdeal_iff {m : ℕ} {a : A} :
    a ∈ truncationIdeal 𝒜 m ↔ a ∈ truncation 𝒜 m := Iff.rfl

/-- `A_{≥ 0} = A` as an ideal. -/
theorem truncationIdeal_zero : truncationIdeal 𝒜 0 = ⊤ :=
  Ideal.eq_top_iff_one _ |>.2 (mem_truncation_zero 𝒜 1)

/-- The ideal generated by the degree-one part is contained in `A_+ = A_{≥ 1}`. -/
theorem span_degreeOne_le_truncationIdeal_one :
    Ideal.span (𝒜 1 : Set A) ≤ truncationIdeal 𝒜 1 :=
  Ideal.span_le.2 fun _ ha ↦ mem_truncation_of_mem 𝒜 le_rfl ha

/-- `(A_1)^m ⊆ A_{≥ m}`, with no hypothesis on `A`. -/
theorem span_degreeOne_pow_le_truncationIdeal (m : ℕ) :
    Ideal.span (𝒜 1 : Set A) ^ m ≤ truncationIdeal 𝒜 m := by
  induction m with
  | zero => rw [pow_zero, truncationIdeal_zero]; exact le_top
  | succ m ih =>
    rw [pow_succ]
    exact Ideal.mul_le.2 fun x hx y hy ↦
      mul_mem_truncation 𝒜 (ih hx) (span_degreeOne_le_truncationIdeal_one 𝒜 hy)

omit [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- A homogeneous element of degree `d` lies in `(A_1)^d`, when `A_{d+1} ⊆ A_1 · A_d` for
every `d`. -/
theorem mem_span_degreeOne_pow_of_mem
    (hgen : ∀ d : ℕ, ∀ a ∈ 𝒜 (d + 1),
      a ∈ Ideal.span (𝒜 1 : Set A) * Ideal.span (𝒜 d : Set A))
    (d : ℕ) {a : A} (ha : a ∈ 𝒜 d) : a ∈ Ideal.span (𝒜 1 : Set A) ^ d := by
  induction d generalizing a with
  | zero => simp
  | succ d ih =>
    have hle : Ideal.span (𝒜 d : Set A) ≤ Ideal.span (𝒜 1 : Set A) ^ d :=
      Ideal.span_le.2 fun y hy ↦ ih hy
    have hpow : Ideal.span (𝒜 1 : Set A) ^ (d + 1)
        = Ideal.span (𝒜 1 : Set A) * Ideal.span (𝒜 1 : Set A) ^ d := by
      rw [pow_succ, mul_comm]
    rw [hpow]
    exact Ideal.mul_mono le_rfl hle (hgen d a ha)

/-- `A_{≥ m} ⊆ (A_1)^m`, for `A` generated over `A_0` by its degree-one part. -/
theorem truncationIdeal_le_span_degreeOne_pow
    (hgen : ∀ d : ℕ, ∀ a ∈ 𝒜 (d + 1),
      a ∈ Ideal.span (𝒜 1 : Set A) * Ideal.span (𝒜 d : Set A))
    (m : ℕ) : truncationIdeal 𝒜 m ≤ Ideal.span (𝒜 1 : Set A) ^ m := by
  intro a ha
  replace ha : a ∈ truncation 𝒜 m := ha
  induction ha using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨d, hmd, hxd⟩ := hx
    exact Ideal.pow_le_pow_right hmd (mem_span_degreeOne_pow_of_mem 𝒜 hgen d hxd)
  | zero => exact zero_mem _
  | add x y _ _ hx hy => exact add_mem hx hy
  | neg x _ hx => exact neg_mem hx

/-- If `A` is generated over `A_0` by its degree-one part, in the form `A_{d+1} ⊆ A_1 · A_d`
for every `d`, then `(A_+)^m = A_{≥ m}` for every `m ≥ 0`. -/
@[ega "II 8.2.10" "(iii), special case"]
theorem span_degreeOne_pow_eq_truncationIdeal
    (hgen : ∀ d : ℕ, ∀ a ∈ 𝒜 (d + 1),
      a ∈ Ideal.span (𝒜 1 : Set A) * Ideal.span (𝒜 d : Set A))
    (m : ℕ) : Ideal.span (𝒜 1 : Set A) ^ m = truncationIdeal 𝒜 m :=
  le_antisymm (span_degreeOne_pow_le_truncationIdeal 𝒜 m)
    (truncationIdeal_le_span_degreeOne_pow 𝒜 hgen m)

/-- For `A` generated over `A_0` by its degree-one part the ideal `A_+ = A_{≥ 1}` is generated
by `A_1`. -/
theorem truncationIdeal_one_eq_span_degreeOne
    (hgen : ∀ d : ℕ, ∀ a ∈ 𝒜 (d + 1),
      a ∈ Ideal.span (𝒜 1 : Set A) * Ideal.span (𝒜 d : Set A)) :
    truncationIdeal 𝒜 1 = Ideal.span (𝒜 1 : Set A) := by
  rw [← span_degreeOne_pow_eq_truncationIdeal 𝒜 hgen 1, pow_one]

end ReesAlgebra

end Stacks.Truncation
