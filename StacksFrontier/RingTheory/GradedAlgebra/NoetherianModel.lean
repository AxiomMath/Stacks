module

public import Mathlib.RingTheory.Adjoin.FG
public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.RingTheory.TensorProduct.MvPolynomial
public import StacksFrontier.AlgebraicGeometry.GradedQuotient

/-!
# Noetherian graded models of finitely presented graded algebras

Let `A` be a commutative `R`-algebra which is finitely presented over `R` and carries an
internal `ℕ`-grading `𝒜 : ℕ → Submodule R A`. This file produces a *Noetherian graded model*
of that situation: a subring `R₀ ⊆ R` of finite type over `ℤ` — hence Noetherian, by the
Hilbert basis theorem — a Noetherian graded `R₀`-algebra `A₀`, a degree-preserving ring
homomorphism `A₀ → A` and an identification `R ⊗_{R₀} A₀ ≅ A` of `R`-algebras under which the
homomorphism becomes `a ↦ 1 ⊗ a`.

This is the graded refinement, with the base ring cut down to a finitely generated
`ℤ`-subalgebra, of the ungraded colimit descent of finitely presented algebras.

## Main definitions

* `Stacks.GradedModel.quotientGrading` is the grading of a quotient of a graded algebra by a
  homogeneous ideal, with its pieces spelled as submodules over the base ring rather than as
  additive subgroups.

## Main results

* `Stacks.GradedModel.gradedRingOfCoeEq` transports an internal grading to any family of
  subobjects with the same carriers.
* `Stacks.GradedModel.isHomogeneous_ker`: the kernel of a homomorphism of graded rings is a
  homogeneous ideal.
* `Stacks.GradedModel.exists_finset_homogeneous_span`: a finitely generated homogeneous ideal
  is generated by finitely many homogeneous elements.
* `Stacks.GradedModel.exists_homogeneous_algebra_generators`: a graded algebra of finite type
  is a quotient of a weighted polynomial ring by a graded surjection.
* `Stacks.GradedModel.aeval_mem_of_isWeightedHomogeneous`: that surjection is degree
  preserving.
* `Stacks.GradedModel.quotientGradedAlgebra`: the quotient of a graded algebra by a
  homogeneous ideal is a graded algebra.
* `Stacks.GradedModel.exists_noetherianGradedModel` is the model itself.

## Implementation notes

The model is built from a graded presentation. Decomposing a finite set of algebra generators
of `A` into homogeneous components gives finitely many homogeneous generators `aᵢ` of degrees
`wᵢ`, so `A` is the quotient of `R[xᵢ]` graded by the weights `w` — Mathlib's
`MvPolynomial.weightedGradedAlgebra` — along the surjection `π = aeval a`, which is degree
preserving. Finite presentation makes `ker π` finitely generated and `isHomogeneous_ker` makes
it homogeneous, so it is generated by finitely many homogeneous polynomials. Taking `R₀` to be
the subring generated by the (finitely many) coefficients of those polynomials, the relations
descend to `R₀[xᵢ]`, and `A₀` is the quotient of `R₀[xᵢ]` by the ideal they generate there.

Mathlib has no grading on a quotient by a homogeneous ideal; the additive-subgroup version is
`Stacks.GradedQuotient.gradedRing`, and `quotientGradedAlgebra` is the submodule-valued form
obtained from it through `gradedRingOfCoeEq`. The transport is needed because a `Submodule R A`
and an `AddSubgroup A` with the same carrier are different types, so the grading cannot simply
be reused.

The base-change identification is built as a pair of mutually inverse algebra maps rather than
from a quotient-commutes-with-tensor lemma. The map out of `R ⊗_{R₀} A₀` is
`Algebra.TensorProduct.lift`; the map into it is `aeval (fun i ↦ 1 ⊗ xᵢ)` descended through
`ker π`, which it kills because each chosen relation is the image of a polynomial over `R₀`
that already lies in the descended ideal. Both composites are checked on the variables, using
that `π` is surjective in one direction and `TensorProduct.induction_on` in the other.

This file carries no `@[stacks]` tag. Tag 01MU is the invertible locus of the twists on `Proj`
and is a different statement, already carried elsewhere; the ungraded antecedents cited below
are general colimit statements, not this one.

## References

* [Stacks Project, Algebra, Lemma 10.127.8, Tag 05N9](https://stacks.math.columbia.edu/tag/05N9)
* [Stacks Project, Algebra, Lemma 10.127.9, Tag 00QT](https://stacks.math.columbia.edu/tag/00QT)
-/

@[expose] public section

open MvPolynomial

namespace Stacks.GradedModel

universe u v

/-! ### Transport of a grading along a family with the same carriers -/

section Transport

variable {ι σ τ A : Type*} [DecidableEq ι] [AddMonoid ι] [Semiring A]
  [SetLike σ A] [AddSubmonoidClass σ A] [SetLike τ A] [AddSubmonoidClass τ A]

/-- The componentwise map between two families of subobjects with equal carriers. -/
def coeEqAddHom (𝒜 : ι → σ) (ℬ : ι → τ) (h : ∀ i, (ℬ i : Set A) = 𝒜 i) (i : ι) :
    𝒜 i →+ ℬ i where
  toFun x := ⟨x.1, by rw [← SetLike.mem_coe, h i]; exact x.2⟩
  map_zero' := rfl
  map_add' _ _ := rfl

/-- A family of subobjects whose carriers are those of an internal grading is itself an
internal grading. -/
@[instance_reducible]
def gradedRingOfCoeEq (𝒜 : ι → σ) [GradedRing 𝒜] (ℬ : ι → τ)
    (h : ∀ i, (ℬ i : Set A) = 𝒜 i) : GradedRing ℬ := by
  have hmem : ∀ (i : ι) (x : A), x ∈ ℬ i ↔ x ∈ 𝒜 i := fun i x => by
    rw [← SetLike.mem_coe, h i, SetLike.mem_coe]
  letI : SetLike.GradedMonoid ℬ :=
    { one_mem := (hmem 0 1).2 SetLike.GradedOne.one_mem
      mul_mem := fun {i j x y} hx hy =>
        (hmem _ _).2 (SetLike.GradedMul.mul_mem ((hmem i x).1 hx) ((hmem j y).1 hy)) }
  have hcoe : (DirectSum.coeAddMonoidHom ℬ).comp
      (DirectSum.map (coeEqAddHom 𝒜 ℬ h)) = DirectSum.coeAddMonoidHom 𝒜 :=
    DirectSum.addHom_ext fun i x => by
      simp [DirectSum.map_of, DirectSum.coeAddMonoidHom_of, coeEqAddHom]
  refine { (inferInstance : SetLike.GradedMonoid ℬ),
    DirectSum.Decomposition.ofAddHom ℬ
      ((DirectSum.map (coeEqAddHom 𝒜 ℬ h)).comp
        (DirectSum.decomposeAddEquiv 𝒜).toAddMonoidHom) ?_ ?_ with }
  · refine AddMonoidHom.ext fun x => ?_
    have h1 := DFunLike.congr_fun hcoe (DirectSum.decompose 𝒜 x)
    have h2 : DirectSum.coeAddMonoidHom 𝒜 (DirectSum.decompose 𝒜 x) = x :=
      (DirectSum.decompose 𝒜).left_inv x
    simpa [DirectSum.decomposeAddEquiv, h2] using h1
  · refine DirectSum.addHom_ext fun i x => ?_
    have hx : (x : A) ∈ 𝒜 i := (hmem i x).1 x.2
    simp [DirectSum.coeAddMonoidHom_of, DirectSum.decomposeAddEquiv,
      DirectSum.decompose_of_mem 𝒜 hx, DirectSum.map_of, coeEqAddHom]

end Transport

/-! ### Kernels of graded ring homomorphisms -/

section Ker

variable {ι σ τ A B : Type*} [DecidableEq ι] [AddMonoid ι] [CommRing A] [CommRing B]
  [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
  (𝒜 : ι → σ) (ℬ : ι → τ) [GradedRing 𝒜] [GradedRing ℬ]

/-- The kernel of a homomorphism of graded rings is a homogeneous ideal. -/
theorem isHomogeneous_ker (f : 𝒜 →+*ᵍ ℬ) :
    (RingHom.ker (f : A →+* B)).IsHomogeneous 𝒜 := by
  intro i r hr
  have hr' : f r = 0 := by simpa [RingHom.mem_ker] using hr
  have h0 : f ((DirectSum.decompose 𝒜 r i : A)) = 0 := by
    rw [GradedRingHom.map_directSumDecompose, hr']
    simp
  simpa [RingHom.mem_ker] using h0

end Ker

/-! ### Finitely generated homogeneous ideals -/

section HomogeneousSpan

variable {ι σ A : Type*} [DecidableEq ι] [AddMonoid ι] [CommRing A]
  [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ι → σ) [GradedRing 𝒜]

/-- A finitely generated homogeneous ideal is generated by a finite set of homogeneous
elements. -/
theorem exists_finset_homogeneous_span {I : Ideal A} (hI : I.IsHomogeneous 𝒜) (hfg : I.FG) :
    ∃ t : Finset A, (∀ x ∈ t, SetLike.IsHomogeneousElem 𝒜 x) ∧ I = Ideal.span (t : Set A) := by
  classical
  obtain ⟨s, hs⟩ := hfg
  refine ⟨s.biUnion fun x => (DirectSum.decompose 𝒜 x).support.image
      fun i => ((DirectSum.decompose 𝒜 x) i : A), ?_, le_antisymm ?_ ?_⟩
  · intro y hy
    simp only [Finset.mem_biUnion, Finset.mem_image] at hy
    obtain ⟨x, -, i, -, rfl⟩ := hy
    exact ⟨i, (DirectSum.decompose 𝒜 x i).2⟩
  · rw [← hs, Ideal.span_le]
    intro x hx
    rw [SetLike.mem_coe, ← DirectSum.sum_support_decompose 𝒜 x]
    refine Ideal.sum_mem _ fun i hi => Ideal.subset_span ?_
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.coe_image]
    exact ⟨x, hx, ⟨i, hi, rfl⟩⟩
  · rw [Ideal.span_le]
    intro y hy
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.coe_image, Set.mem_image,
      Finset.mem_coe] at hy
    obtain ⟨x, hx, i, -, rfl⟩ := hy
    exact hI i (hs ▸ Ideal.subset_span hx)

end HomogeneousSpan

/-! ### Graded generators and graded presentations -/

section Generators

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]

/-- A family of elements whose generated subalgebra is everything induces a surjection from
the polynomial ring on the index type. -/
theorem surjective_aeval_of_adjoin_eq_top {σ : Type v} (a : σ → A)
    (h : Algebra.adjoin R (Set.range a) = ⊤) :
    Function.Surjective (MvPolynomial.aeval a : MvPolynomial σ R →ₐ[R] A) := fun x => by
  have hx : x ∈ (MvPolynomial.aeval a : MvPolynomial σ R →ₐ[R] A).range := by
    rw [← Algebra.adjoin_range_eq_range_aeval, h]
    exact Algebra.mem_top
  exact hx

/-- A graded algebra of finite type is generated by a finite family of homogeneous elements,
hence is a quotient of a weighted polynomial ring. -/
theorem exists_homogeneous_algebra_generators (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    [Algebra.FiniteType R A] :
    ∃ (σ : Type u) (_ : Fintype σ) (w : σ → ℕ) (a : σ → A),
      (∀ i, a i ∈ 𝒜 (w i)) ∧
        Function.Surjective (MvPolynomial.aeval a : MvPolynomial σ R →ₐ[R] A) := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
  refine ⟨Σ x : s, (DirectSum.decompose 𝒜 (x.1 : A)).support, inferInstance,
    fun i => (i.2 : ℕ), fun i => ((DirectSum.decompose 𝒜 (i.1.1 : A)) i.2 : A),
    fun i => (DirectSum.decompose 𝒜 _ _).2, surjective_aeval_of_adjoin_eq_top _ ?_⟩
  rw [← top_le_iff, ← hs, Algebra.adjoin_le_iff]
  intro x hx
  rw [← DirectSum.sum_support_decompose 𝒜 x]
  exact sum_mem fun n hn => Algebra.subset_adjoin ⟨⟨⟨x, hx⟩, ⟨n, hn⟩⟩, rfl⟩

/-- Evaluating a monomial at homogeneous elements lands in the graded piece of the
corresponding weighted degree. -/
theorem aeval_monomial_mem {σ : Type v} (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    (w : σ → ℕ) (a : σ → A) (ha : ∀ i, a i ∈ 𝒜 (w i)) (d : σ →₀ ℕ) (r : R) :
    (MvPolynomial.aeval a : MvPolynomial σ R →ₐ[R] A) (MvPolynomial.monomial d r) ∈
      𝒜 (Finsupp.weight w d) := by
  have hprod : (d.prod fun i k => a i ^ k) ∈ 𝒜 (Finsupp.weight w d) := by
    rw [Finsupp.prod, Finsupp.weight_apply, Finsupp.sum]
    exact SetLike.prod_mem_graded 𝒜 (fun i => d i • w i) (fun i => a i ^ d i)
      fun i _ => SetLike.pow_mem_graded (d i) (ha i)
  rw [MvPolynomial.aeval_monomial, ← Algebra.smul_def]
  exact Submodule.smul_mem _ r hprod

/-- Evaluating a weighted-homogeneous polynomial at homogeneous elements of the matching
degrees lands in the graded piece of the same degree. -/
theorem aeval_mem_of_isWeightedHomogeneous {σ : Type v} (𝒜 : ℕ → Submodule R A)
    [GradedAlgebra 𝒜] (w : σ → ℕ) (a : σ → A) (ha : ∀ i, a i ∈ 𝒜 (w i)) {m : ℕ}
    {p : MvPolynomial σ R} (hp : p.IsWeightedHomogeneous w m) :
    (MvPolynomial.aeval a : MvPolynomial σ R →ₐ[R] A) p ∈ 𝒜 m := by
  rw [MvPolynomial.as_sum p, map_sum]
  refine sum_mem fun d hd => ?_
  rw [← hp (MvPolynomial.mem_support_iff.mp hd)]
  exact aeval_monomial_mem 𝒜 w a ha d (p.coeff d)

end Generators

/-! ### The grading of a quotient, with pieces spelled as submodules -/

section QuotientGrading

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- The degree-`d` piece of the quotient of a graded algebra by a homogeneous ideal, namely
the image of the degree-`d` piece under the quotient map. -/
def quotientGrading (𝒜 : ℕ → Submodule R A) (I : Ideal A) (d : ℕ) : Submodule R (A ⧸ I) :=
  Submodule.map (Ideal.Quotient.mkₐ R I).toLinearMap (𝒜 d)

/-- The carrier of the degree-`d` piece of the quotient is the image of the degree-`d` piece. -/
theorem coe_quotientGrading (𝒜 : ℕ → Submodule R A) (I : Ideal A) (d : ℕ) :
    (quotientGrading 𝒜 I d : Set (A ⧸ I)) = Ideal.Quotient.mk I '' (𝒜 d) := by
  simp [quotientGrading]

/-- The class of a homogeneous element of degree `d` is homogeneous of degree `d`. -/
theorem mk_mem_quotientGrading {𝒜 : ℕ → Submodule R A} {I : Ideal A} {d : ℕ} {x : A}
    (hx : x ∈ 𝒜 d) : Ideal.Quotient.mk I x ∈ quotientGrading 𝒜 I d :=
  ⟨x, hx, rfl⟩

/-- The quotient of a graded algebra by a homogeneous ideal is a graded algebra, graded by the
images of the graded pieces. -/
@[instance_reducible]
def quotientGradedAlgebra (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {I : Ideal A}
    (hI : I.IsHomogeneous 𝒜) : GradedAlgebra (quotientGrading 𝒜 I) := by
  letI := Stacks.GradedQuotient.gradedRing 𝒜 I hI
  exact gradedRingOfCoeEq (Stacks.GradedQuotient.grading 𝒜 I) (quotientGrading 𝒜 I)
    fun d => (coe_quotientGrading 𝒜 I d).trans (Stacks.GradedQuotient.coe_grading 𝒜 I d).symm

end QuotientGrading

/-! ### Descending the coefficients of finitely many polynomials to a subring -/

section Coefficients

variable {R S : Type*} [CommRing R] [CommRing S] {σ : Type v}

/-- A ring homomorphism preserves weighted homogeneity. -/
theorem isWeightedHomogeneous_map (φ : R →+* S) {w : σ → ℕ} {m : ℕ} {p : MvPolynomial σ R}
    (hp : p.IsWeightedHomogeneous w m) :
    (MvPolynomial.map φ p).IsWeightedHomogeneous w m := by
  intro d hd
  refine hp ?_
  rw [MvPolynomial.coeff_map] at hd
  exact fun h => hd (by rw [h, map_zero])

/-- Weighted homogeneity descends along an injective change of coefficients. -/
theorem isWeightedHomogeneous_of_map_injective {φ : R →+* S} (hφ : Function.Injective φ)
    {w : σ → ℕ} {m : ℕ} {p : MvPolynomial σ R}
    (hp : (MvPolynomial.map φ p).IsWeightedHomogeneous w m) : p.IsWeightedHomogeneous w m := by
  intro d hd
  refine hp ?_
  rw [MvPolynomial.coeff_map]
  exact fun h => hd (hφ (by rw [h, map_zero]))

/-- A polynomial all of whose coefficients lie in a subring is the image of a polynomial over
that subring. -/
theorem exists_map_eq_of_coeff_mem (R₀ : Subring R) (p : MvPolynomial σ R)
    (hp : ∀ d, p.coeff d ∈ R₀) :
    ∃ p₀ : MvPolynomial σ R₀, MvPolynomial.map (algebraMap R₀ R) p₀ = p := by
  classical
  refine ⟨∑ d ∈ p.support, MvPolynomial.monomial d ⟨p.coeff d, hp d⟩, ?_⟩
  rw [map_sum]
  simp only [MvPolynomial.map_monomial]
  exact (MvPolynomial.as_sum p).symm

end Coefficients

/-! ### The Noetherian graded model -/

section Model

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]

open scoped TensorProduct

/-- A finitely presented graded algebra descends to a graded algebra over a finitely generated
subring of the base.

The model is of finite type over the small base, which is what makes its degree-zero part of
finite type there (`gradeZero_finiteType`) and hence makes the structure morphism of its
projective spectrum locally of finite type. That conjunct is recorded because it is not
recoverable from the others: a Noetherian ring need not be of finite type over a Noetherian
subring. -/
theorem exists_noetherianGradedModel (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    [Algebra.FinitePresentation R A] :
    ∃ R₀ : Subring R,
      Algebra.FiniteType ℤ R₀ ∧ IsNoetherianRing R₀ ∧
      ∃ (A₀ : Type u) (hring : CommRing A₀),
        letI : CommRing A₀ := hring
        ∃ halg : Algebra R₀ A₀,
          letI : Algebra R₀ A₀ := halg
          ∃ (𝒜₀ : ℕ → Submodule R₀ A₀) (hgraded : GradedAlgebra 𝒜₀),
            letI : GradedAlgebra 𝒜₀ := hgraded
            Algebra.FiniteType R₀ A₀ ∧ IsNoetherianRing A₀ ∧
            ∃ (f : 𝒜₀ →+*ᵍ 𝒜) (e : TensorProduct R₀ R A₀ ≃ₐ[R] A),
              (∀ r : R₀, f (algebraMap R₀ A₀ r) = algebraMap R A (r : R)) ∧
              ∀ (r : R) (x : A₀), e (r ⊗ₜ[R₀] x) = r • f x := by
  classical
  -- A finite family of homogeneous algebra generators, and the resulting graded surjection.
  obtain ⟨σ, hfin, w, a, ha, hsurj⟩ := exists_homogeneous_algebra_generators 𝒜
  let := hfin
  let : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule R w) :=
    MvPolynomial.weightedGradedAlgebra R w
  set π : MvPolynomial σ R →ₐ[R] A := MvPolynomial.aeval a with hπdef
  have hπgr : ∀ (i : ℕ) (p : MvPolynomial σ R),
      p ∈ MvPolynomial.weightedHomogeneousSubmodule R w i → π p ∈ 𝒜 i := fun i p hp =>
    aeval_mem_of_isWeightedHomogeneous 𝒜 w a ha hp
  let g : MvPolynomial.weightedHomogeneousSubmodule R w →+*ᵍ 𝒜 :=
    { toRingHom := (π : MvPolynomial σ R →+* A)
      map_mem := fun {i p} hp => hπgr i p hp }
  -- The kernel is a finitely generated homogeneous ideal.
  have hker : (RingHom.ker π).IsHomogeneous
      (MvPolynomial.weightedHomogeneousSubmodule R w) :=
    isHomogeneous_ker _ 𝒜 g
  have : Algebra.FinitePresentation R (MvPolynomial σ R) :=
    Algebra.FinitePresentation.mvPolynomial_of_finitePresentation (R := R) (A := R) σ
  have hfg : (RingHom.ker π).FG := Algebra.FinitePresentation.ker_fG_of_surjective π hsurj
  obtain ⟨t, hthom, hteq⟩ := exists_finset_homogeneous_span _ hker hfg
  -- The subring generated by the coefficients of the chosen homogeneous relations.
  set Cf : Finset R := t.biUnion fun p => p.support.image fun d => p.coeff d
    with hCfdef
  set R₀ : Subring R := Subring.closure (Cf : Set R) with hR₀def
  have hcoeff : ∀ p ∈ t, ∀ d, p.coeff d ∈ R₀ := by
    intro p hp d
    by_cases hd : d ∈ p.support
    · exact Subring.subset_closure (Finset.mem_coe.2
        (Finset.mem_biUnion.2 ⟨p, hp, Finset.mem_image.2 ⟨d, hd, rfl⟩⟩))
    · rw [MvPolynomial.notMem_support_iff.mp hd]
      exact zero_mem _
  have hNoeth : IsNoetherianRing R₀ := is_noetherian_subring_closure _ Cf.finite_toSet
  have hFT : Algebra.FiniteType ℤ R₀ := by
    have hFG : (Algebra.adjoin ℤ (Cf : Set R)).FG :=
      Subalgebra.fg_def.2 ⟨(Cf : Set R), Cf.finite_toSet, rfl⟩
    have h2 := (Subalgebra.fg_iff_finiteType (Algebra.adjoin ℤ (Cf : Set R))).1 hFG
    rwa [Algebra.adjoin_int] at h2
  -- Lift the relations to the subring.
  have hliftex : ∀ p ∈ t, ∃ p₀ : MvPolynomial σ R₀,
      MvPolynomial.map (algebraMap R₀ R) p₀ = p := fun p hp =>
    exists_map_eq_of_coeff_mem R₀ p (hcoeff p hp)
  choose! lft hlft using hliftex
  let : GradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule R₀ w) :=
    MvPolynomial.weightedGradedAlgebra R₀ w
  set t₀ : Finset (MvPolynomial σ R₀) := t.image lft with ht₀def
  set I₀ : Ideal (MvPolynomial σ R₀) := Ideal.span (t₀ : Set (MvPolynomial σ R₀)) with hI₀def
  have hinj : Function.Injective (algebraMap R₀ R) := fun x y h => Subtype.ext h
  have hI₀hom : I₀.IsHomogeneous (MvPolynomial.weightedHomogeneousSubmodule R₀ w) := by
    refine Ideal.homogeneous_span _ _ ?_
    intro x hx
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.1 hx
    obtain ⟨i, hi⟩ := hthom p hp
    exact ⟨i, isWeightedHomogeneous_of_map_injective hinj (by rw [hlft p hp]; exact hi)⟩
  -- The model and its grading.
  set A₀ : Type u := MvPolynomial σ R₀ ⧸ I₀ with hA₀def
  set 𝒜₀ : ℕ → Submodule R₀ A₀ :=
    quotientGrading (MvPolynomial.weightedHomogeneousSubmodule R₀ w) I₀ with h𝒜₀def
  let hgraded : GradedAlgebra 𝒜₀ :=
    quotientGradedAlgebra (MvPolynomial.weightedHomogeneousSubmodule R₀ w) hI₀hom
  have : Algebra.FinitePresentation R₀ (MvPolynomial σ R₀) :=
    Algebra.FinitePresentation.mvPolynomial_of_finitePresentation (R := R₀) (A := R₀) σ
  have hFTA₀ : Algebra.FiniteType R₀ A₀ :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R₀ I₀) Ideal.Quotient.mk_surjective
  have hNoethA₀ : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing R₀ A₀
  -- The structural map of the model.
  set ψ : MvPolynomial σ R₀ →ₐ[R₀] A := MvPolynomial.aeval a with hψdef
  have hψmap : ∀ p₀ : MvPolynomial σ R₀,
      ψ p₀ = π (MvPolynomial.map (algebraMap R₀ R) p₀) := fun p₀ =>
    (MvPolynomial.aeval_map_algebraMap R a p₀).symm
  have hψker : ∀ x ∈ I₀, ψ x = 0 := by
    change I₀ ≤ RingHom.ker ψ
    rw [hI₀def, Ideal.span_le]
    intro y hy
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.1 hy
    have hpk : p ∈ RingHom.ker π := by rw [hteq]; exact Ideal.subset_span hp
    simp only [SetLike.mem_coe, RingHom.mem_ker, hψmap, hlft p hp]
    simpa [RingHom.mem_ker] using hpk
  set gA : A₀ →ₐ[R₀] A := Ideal.Quotient.liftₐ I₀ ψ hψker with hgAdef
  have hgA : ∀ p₀ : MvPolynomial σ R₀, gA (Ideal.Quotient.mk I₀ p₀) = ψ p₀ := fun p₀ => rfl
  have hfmem : ∀ (i : ℕ) (x : A₀), x ∈ 𝒜₀ i → gA x ∈ 𝒜 i := by
    intro i x hx
    rw [h𝒜₀def, quotientGrading, Submodule.mem_map] at hx
    obtain ⟨p₀, hp₀, rfl⟩ := hx
    have hmk : (Ideal.Quotient.mkₐ R₀ I₀).toLinearMap p₀ = Ideal.Quotient.mk I₀ p₀ := rfl
    rw [hmk, hgA, hψmap]
    exact hπgr i _ (isWeightedHomogeneous_map (algebraMap R₀ R) hp₀)
  let f : 𝒜₀ →+*ᵍ 𝒜 :=
    { toRingHom := (gA : A₀ →+* A)
      map_mem := fun {i x} hx => hfmem i x hx }
  -- The base-change identification.
  set u : TensorProduct R₀ R A₀ →ₐ[R] A :=
    Algebra.TensorProduct.lift (Algebra.ofId R A) gA (fun _ _ => Commute.all _ _) with hudef
  set w₁ : MvPolynomial σ R →ₐ[R] TensorProduct R₀ R A₀ :=
    MvPolynomial.aeval fun i => Algebra.TensorProduct.includeRight
      (Ideal.Quotient.mk I₀ (MvPolynomial.X i)) with hw₁def
  have hw₁map : ∀ p₀ : MvPolynomial σ R₀,
      w₁ (MvPolynomial.map (algebraMap R₀ R) p₀) =
        Algebra.TensorProduct.includeRight (Ideal.Quotient.mk I₀ p₀) := by
    have key : (MvPolynomial.aeval fun i => Algebra.TensorProduct.includeRight
          (Ideal.Quotient.mk I₀ (MvPolynomial.X i)) :
            MvPolynomial σ R₀ →ₐ[R₀] TensorProduct R₀ R A₀) =
        (Algebra.TensorProduct.includeRight : A₀ →ₐ[R₀] TensorProduct R₀ R A₀).comp
          (Ideal.Quotient.mkₐ R₀ I₀) := MvPolynomial.algHom_ext fun i => by
            simp only [MvPolynomial.aeval_X, AlgHom.comp_apply,
              Algebra.TensorProduct.includeRight_apply]
            rfl
    intro p₀
    rw [hw₁def, MvPolynomial.aeval_map_algebraMap R]
    exact AlgHom.congr_fun key p₀
  have hw₁ker : ∀ x ∈ RingHom.ker π, w₁ x = 0 := by
    change RingHom.ker π ≤ RingHom.ker w₁
    rw [hteq, Ideal.span_le]
    intro p hp
    have h2 : Ideal.Quotient.mk I₀ (lft p) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, hI₀def]
      exact Ideal.subset_span (Finset.mem_image.2 ⟨p, hp, rfl⟩)
    have h4 := hw₁map (lft p)
    rwa [hlft p hp, h2, map_zero] at h4
  set e' : (MvPolynomial σ R ⧸ RingHom.ker π) ≃ₐ[R] A :=
    Ideal.quotientKerAlgEquivOfSurjective hsurj with he'def
  have he' : ∀ p : MvPolynomial σ R, e' (Ideal.Quotient.mk (RingHom.ker π) p) = π p :=
    fun p => rfl
  set v : A →ₐ[R] TensorProduct R₀ R A₀ :=
    (Ideal.Quotient.liftₐ (RingHom.ker π) w₁ hw₁ker).comp e'.symm.toAlgHom with hvdef
  have hv : ∀ p : MvPolynomial σ R, v (π p) = w₁ p := by
    intro p
    have hsym : e'.symm (π p) = Ideal.Quotient.mk (RingHom.ker π) p := by
      rw [AlgEquiv.symm_apply_eq, he' p]
    have hunfold : v (π p) =
        (Ideal.Quotient.liftₐ (RingHom.ker π) w₁ hw₁ker) (e'.symm (π p)) := rfl
    rw [hunfold, hsym]
    exact Ideal.Quotient.lift_mk _ _ _
  have huv : ∀ x : A, u (v x) = x := by
    have hcomp : (u.comp v).comp π = π := MvPolynomial.algHom_ext fun i => by
      have h2 : v (π (MvPolynomial.X i)) = Algebra.TensorProduct.includeRight
          (Ideal.Quotient.mk I₀ (MvPolynomial.X i)) := by
        rw [hv, hw₁def, MvPolynomial.aeval_X]
      have h3 : ((u.comp v).comp π) (MvPolynomial.X i) = u (v (π (MvPolynomial.X i))) := rfl
      rw [h3, h2, Algebra.TensorProduct.includeRight_apply, hudef,
        Algebra.TensorProduct.lift_tmul, map_one, one_mul, hgA, hψdef,
        MvPolynomial.aeval_X, hπdef, MvPolynomial.aeval_X]
    intro x
    obtain ⟨p, rfl⟩ := hsurj x
    exact AlgHom.congr_fun hcomp p
  have hvu : ∀ x : TensorProduct R₀ R A₀, v (u x) = x := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul r y =>
        obtain ⟨p₀, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [hudef, Algebra.TensorProduct.lift_tmul]
        simp only [Algebra.ofId_apply, hgA]
        rw [← Algebra.smul_def, map_smul, hψmap, hv, hw₁map,
          Algebra.TensorProduct.includeRight_apply, TensorProduct.smul_tmul']
        simp
    | add y z hy hz => rw [map_add, map_add, hy, hz]
  refine ⟨R₀, hFT, hNoeth, A₀, inferInstance, inferInstance, 𝒜₀, hgraded, hFTA₀, hNoethA₀, f,
    AlgEquiv.ofAlgHom u v (AlgHom.ext huv) (AlgHom.ext hvu), ?_, ?_⟩
  · intro r
    change gA (algebraMap R₀ A₀ r) = algebraMap R A (r : R)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R₀ R A]
    rfl
  · intro r x
    change u (r ⊗ₜ[R₀] x) = r • gA x
    rw [hudef, Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, Algebra.smul_def]

end Model

end Stacks.GradedModel

