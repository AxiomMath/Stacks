module

public import Mathlib.AlgebraicGeometry.EllipticCurve.Projective.Basic
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.Data.ENat.Basic

/-!
# The section ring of a curve of genus one

Let `X` be a proper curve of genus one over a field `k`, `P ∈ X(k)` a rational point and
`L = 𝒪_X(dP)`. The section ring `A = ⨁_m Γ(X, L^{⊗m})` is an `ℕ`-graded `k`-algebra, the order
of vanishing at `P` gives an order function on its homogeneous elements, and the canonical
section `Z ∈ A_1` vanishes to order `d` at `P` and nowhere else. We isolate the properties of
this situation that the classical argument uses (`Stacks.GenusOneSectionRing.Data`) and derive
from them, by pure algebra, that `dim A_m = d m` for `m ≥ 1`, that the orders attained in degree
`m` are exactly `[0, d m] \ {d m - 1}`, and, for `d = 3`, that `A` is the quotient of
`k[x, y, z]` by a single homogeneous Weierstrass cubic.

## Main definitions

* `Stacks.GenusOneSectionRing.Data`: an order function `ord : A → ℕ∞` on a graded `k`-algebra
  `A` behaving like the order of vanishing at a rational point, a degree-one element `Z` of
  order `d` dividing every homogeneous element of large order, `A_0 = k`, and the Riemann–Roch
  bounds `d m ≤ dim A_m` for `m ≥ 1` and `dim A_m ≤ d m` for `m` large.
* `Stacks.GenusOneSectionRing.Data.orders`: the orders of the nonzero elements of `A_m`.

## Main results

* `Stacks.GenusOneSectionRing.Data.finrank_eq_card_orders`: `dim A_m` is the number of orders
  attained by nonzero elements of `A_m`.
* `Stacks.GenusOneSectionRing.finrank_eq`: `dim A_m = d m` for every `m ≥ 1`.
* `Stacks.GenusOneSectionRing.exists_ord_eq_iff`: the orders of the nonzero elements of `A_m`,
  `m ≥ 1`, are exactly the `v ≤ d m` with `v ≠ d m - 1`.
* `Stacks.GenusOneSectionRing.exists_weierstrassCurve`: for `d = 3` and `X, Y ∈ A_1` of orders
  one and zero, suitable nonzero multiples `λX, νY` together with `Z` generate `A`, and the
  kernel of `k[x, y, z] → A`, `(x, y, z) ↦ (λX, νY, Z)`, is generated by the homogeneous
  Weierstrass polynomial of a Weierstrass curve.

## Implementation notes

The dimension count works with the pole orders `d m - ord a`. Nonzero elements of one degree
with distinct orders are linearly independent, and the leading-coefficient hypothesis
`Data.exists_lt_ord_sub` shows that one element of each attained order spans; so `dim A_m` is the
number of attained orders, all of which lie in `[0, d m]`. Multiplication and division by powers
of `Z` show that the attained pole orders of all degrees form one additive monoid, cut off at
`d m` in degree `m`. If the pole order one occurred, this monoid would be all of `ℕ` and
`dim A_m = d m + 1` for every `m`, contradicting the upper bound; so it does not, and the lower
bound forces every other pole order in `[0, d m]` to occur.

For the Weierstrass equation, the monomials `x^i y^j z^l` with `i ≤ 2` map to elements whose
orders `i + 3 l` separate them within each degree, so their images are linearly independent and
span every `A_m`. A relation in degree three between `X³` and `Y²Z` (both of order three)
rescales to a Weierstrass cubic `F`, which is monic of degree three in `x` over `k[y, z]`
(`MvPolynomial.finSuccEquiv`); division by `F` (`Polynomial.modByMonic`) reduces any polynomial
to one of degree at most two in `x`, which lies in the kernel only if it is zero.
-/

@[expose] public noncomputable section

namespace Stacks.GenusOneSectionRing

variable {k A : Type*} [Field k] [CommRing A] [Algebra k A]

/-- The data and the hypotheses: an order function on the homogeneous elements behaving like the
order of vanishing at a `k`-rational point, a degree-one element `Z` of order `d` by which every
homogeneous element of large enough order is divisible, degree zero equal to `k`, and the
Riemann–Roch bounds on the dimensions of the graded pieces. -/
structure Data (𝒜 : ℕ → Submodule k A) [GradedAlgebra 𝒜] (d : ℕ) where
  /-- The order of vanishing at the point. -/
  ord : A → ℕ∞
  ord_eq_top_iff {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) : ord a = ⊤ ↔ a = 0
  ord_mul {m n : ℕ} {a b : A} (ha : a ∈ 𝒜 m) (hb : b ∈ 𝒜 n) : ord (a * b) = ord a + ord b
  min_le_ord_add {m : ℕ} {a b : A} (ha : a ∈ 𝒜 m) (hb : b ∈ 𝒜 m) :
    min (ord a) (ord b) ≤ ord (a + b)
  ord_smul {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) {c : k} (hc : c ≠ 0) : ord (c • a) = ord a
  /-- The residue field at the point is `k`: two homogeneous elements of the same degree and the
  same finite order agree to first order up to a scalar. -/
  exists_lt_ord_sub {m : ℕ} {a b : A} (ha : a ∈ 𝒜 m) (hb : b ∈ 𝒜 m) (hb0 : b ≠ 0)
    (hab : ord a = ord b) : ∃ c : k, ord a < ord (a - c • b)
  /-- The canonical section. -/
  Z : A
  Z_mem : Z ∈ 𝒜 1
  ord_Z : ord Z = d
  /-- Division by powers of `Z`. -/
  exists_eq_Z_pow_mul {m j : ℕ} {a : A} (ha : a ∈ 𝒜 (m + j)) (hj : ((d * j : ℕ) : ℕ∞) ≤ ord a) :
    ∃ b ∈ 𝒜 m, a = Z ^ j * b
  /-- Degree zero is the ground field. -/
  exists_eq_algebraMap {a : A} (ha : a ∈ 𝒜 0) : ∃ c : k, a = algebraMap k A c
  finiteDimensional (m : ℕ) : FiniteDimensional k (𝒜 m)
  /-- Riemann–Roch: `h⁰ ≥ deg = d m`. -/
  le_finrank {m : ℕ} (hm : 1 ≤ m) : d * m ≤ Module.finrank k (𝒜 m)
  /-- Serre vanishing: `h⁰ = d m` for `m` large. -/
  eventually_finrank_le : ∃ m₀ : ℕ, ∀ m, m₀ ≤ m → Module.finrank k (𝒜 m) ≤ d * m

variable {𝒜 : ℕ → Submodule k A} [GradedAlgebra 𝒜] [Nontrivial A] {d : ℕ} (D : Data 𝒜 d)

omit [Nontrivial A] in
/-- A power of an element of degree one lies in the expected degree. -/
theorem pow_mem_of_mem_one {x : A} (hx : x ∈ 𝒜 1) (i : ℕ) : x ^ i ∈ 𝒜 i := by
  simpa using SetLike.pow_mem_graded i hx

namespace Data

omit [Nontrivial A] in
/-- The zero element has infinite order. -/
theorem ord_zero : D.ord 0 = ⊤ := (D.ord_eq_top_iff (zero_mem (𝒜 0))).2 rfl

omit [Nontrivial A] in
/-- A nonzero homogeneous element has finite order. -/
theorem ord_ne_top {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) (h0 : a ≠ 0) : D.ord a ≠ ⊤ :=
  fun h ↦ h0 ((D.ord_eq_top_iff ha).1 h)

omit [Nontrivial A] in
/-- An element of finite order is nonzero. -/
theorem ne_zero_of_ord_eq {a : A} {v : ℕ} (h : D.ord a = v) : a ≠ 0 := by
  rintro rfl
  rw [D.ord_zero] at h
  exact ENat.top_ne_natCast v h

/-- The unit has order zero. -/
theorem ord_one : D.ord 1 = 0 := by
  have h1 : (1 : A) ∈ 𝒜 0 := SetLike.one_mem_graded 𝒜
  have h := D.ord_mul h1 h1
  rw [one_mul] at h
  obtain ⟨v, hv⟩ := ENat.ne_top_iff_exists.1 (D.ord_ne_top h1 one_ne_zero)
  rw [← hv] at h ⊢
  obtain rfl : v = 0 := by
    have : v = v + v := by exact_mod_cast h
    omega
  simp

/-- The order of a power. -/
theorem ord_pow {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) (q : ℕ) : D.ord (a ^ q) = q * D.ord a := by
  induction q with
  | zero => simp [D.ord_one]
  | succ q ih =>
    rw [pow_succ, D.ord_mul (SetLike.pow_mem_graded q ha) ha, ih]
    push_cast
    ring

omit [Nontrivial A] in
/-- A power of `Z` lies in the expected degree. -/
theorem Z_pow_mem (j : ℕ) : D.Z ^ j ∈ 𝒜 j :=
  pow_mem_of_mem_one D.Z_mem j

/-- The order of a power of `Z`. -/
theorem ord_Z_pow (j : ℕ) : D.ord (D.Z ^ j) = (d * j : ℕ) := by
  rw [D.ord_pow D.Z_mem, D.ord_Z]
  push_cast
  ring

/-- Nonzero scalars have order zero. -/
theorem ord_algebraMap {c : k} (hc : c ≠ 0) : D.ord (algebraMap k A c) = 0 := by
  rw [Algebra.algebraMap_eq_smul_one, D.ord_smul (SetLike.one_mem_graded 𝒜) hc, D.ord_one]

/-- Multiplying by a power of `Z` adds its order. -/
private theorem ord_Z_pow_mul {m : ℕ} {b : A} (hb : b ∈ 𝒜 m) (j : ℕ) :
    D.ord (D.Z ^ j * b) = (d * j : ℕ) + D.ord b := by
  rw [D.ord_mul (D.Z_pow_mem j) hb, D.ord_Z_pow]

/-- A nonzero element of degree `m` has order at most `d m`. -/
theorem ord_le {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) (h0 : a ≠ 0) : D.ord a ≤ (d * m : ℕ) := by
  by_contra h
  obtain ⟨b, hb, rfl⟩ :=
    D.exists_eq_Z_pow_mul (m := 0) (j := m) (by rwa [zero_add]) (not_le.1 h).le
  obtain ⟨c, rfl⟩ := D.exists_eq_algebraMap hb
  have hc : c ≠ 0 := by
    rintro rfl
    simp at h0
  rw [D.ord_Z_pow_mul hb, D.ord_algebraMap hc, add_zero] at h
  exact h le_rfl

/-- The order of a nonzero element of degree `m` is a natural number at most `d m`. -/
theorem exists_ord_eq {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) (h0 : a ≠ 0) :
    ∃ v : ℕ, D.ord a = v ∧ v ≤ d * m := by
  obtain ⟨v, hv⟩ := ENat.ne_top_iff_exists.1 (D.ord_ne_top ha h0)
  refine ⟨v, hv.symm, ?_⟩
  exact_mod_cast hv ▸ D.ord_le ha h0

omit [Nontrivial A] in
/-- Negation preserves the order. -/
theorem ord_neg {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) : D.ord (-a) = D.ord a := by
  rw [← neg_one_smul k a, D.ord_smul ha (neg_ne_zero.2 one_ne_zero)]

omit [Nontrivial A] in
/-- A lower bound for the orders of the terms of a finite sum of elements of one degree bounds
the order of the sum. -/
theorem le_ord_sum {ι : Type*} {m : ℕ} (s : Finset ι) (f : ι → A) (hf : ∀ i ∈ s, f i ∈ 𝒜 m)
    (b : ℕ∞) (hb : ∀ i ∈ s, b ≤ D.ord (f i)) : b ≤ D.ord (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [D.ord_zero]
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact le_trans (le_min (hb i (Finset.mem_insert_self _ _))
      (ih (fun j hj ↦ hf j (Finset.mem_insert_of_mem hj))
        (fun j hj ↦ hb j (Finset.mem_insert_of_mem hj))))
      (D.min_le_ord_add (hf i (Finset.mem_insert_self _ _))
        (Submodule.sum_mem _ fun j hj ↦ hf j (Finset.mem_insert_of_mem hj)))

/-- Homogeneous nonzero elements are linearly independent as soon as two of them of the same
degree always have distinct orders. -/
theorem linearIndependent_of_ord {ι : Type*} (v : ι → A) (deg : ι → ℕ)
    (hv : ∀ i, v i ∈ 𝒜 (deg i)) (hv0 : ∀ i, v i ≠ 0)
    (hinj : ∀ i j, deg i = deg j → D.ord (v i) = D.ord (v j) → i = j) :
    LinearIndependent k v := by
  classical
  rw [linearIndependent_iff']
  intro s g hg i hi
  by_contra hgi
  set n := deg i
  have hcomp : ∑ j ∈ s with deg j = n, g j • v j = 0 := by
    have h := congrArg (GradedRing.proj 𝒜 n) hg
    rw [map_sum, map_zero] at h
    rw [Finset.sum_filter]
    refine Eq.trans (Finset.sum_congr rfl fun j _ ↦ ?_) h
    rw [GradedRing.proj_apply]
    split_ifs with hj
    · exact (DirectSum.decompose_of_mem_same 𝒜
        (by rw [← hj]; exact Submodule.smul_mem _ _ (hv j))).symm
    · exact (DirectSum.decompose_of_mem_ne 𝒜 (Submodule.smul_mem _ _ (hv j)) hj).symm
  obtain ⟨i₀, hi₀, hmin⟩ := (s.filter fun j ↦ deg j = n ∧ g j ≠ 0).exists_min_image
    (fun j ↦ D.ord (v j)) ⟨i, by simp [hi, hgi, n]⟩
  simp only [Finset.mem_filter] at hi₀ hmin
  obtain ⟨w, hw, -⟩ := D.exists_ord_eq (hv i₀) (hv0 i₀)
  have hi₀' : i₀ ∈ s.filter fun j ↦ deg j = n := Finset.mem_filter.2 ⟨hi₀.1, hi₀.2.1⟩
  rw [← Finset.add_sum_erase _ _ hi₀', add_eq_zero_iff_eq_neg] at hcomp
  have hmem : ∀ j ∈ (s.filter fun j ↦ deg j = n).erase i₀, g j • v j ∈ 𝒜 n := by
    intro j hj
    have hj' := Finset.mem_filter.1 (Finset.mem_of_mem_erase hj)
    rw [← hj'.2]
    exact Submodule.smul_mem _ _ (hv j)
  have hle := D.le_ord_sum _ _ hmem (D.ord (v i₀) + 1) (by
    intro j hj
    obtain ⟨hji, hj⟩ := Finset.mem_erase.1 hj
    have hj' := Finset.mem_filter.1 hj
    by_cases hgj : g j = 0
    · simp [hgj, D.ord_zero]
    rw [D.ord_smul (hv j) hgj]
    refine Order.add_one_le_of_lt (lt_of_le_of_ne (hmin j ⟨hj'.1, hj'.2, hgj⟩) fun h ↦ hji ?_)
    exact (hinj _ _ (hi₀.2.1.trans hj'.2.symm) h).symm)
  rw [← D.ord_neg (Submodule.sum_mem _ hmem), ← hcomp, D.ord_smul (hv i₀) hi₀.2.2, hw] at hle
  norm_cast at hle
  omega

/-- If every order `≥ j` of a nonzero element of degree `m` is attained on `s ⊆ 𝒜 m`, then every
element of degree `m` and order `≥ j` is a combination of elements of `s` of order `≥ j`. -/
theorem mem_span_of_ord {m : ℕ} (s : Set A) (hs : s ⊆ 𝒜 m) (j : ℕ∞)
    (h : ∀ a ∈ 𝒜 m, a ≠ 0 → j ≤ D.ord a → ∃ b ∈ s, D.ord b = D.ord a) {a : A} (ha : a ∈ 𝒜 m)
    (hj : j ≤ D.ord a) : a ∈ Submodule.span k {b ∈ s | j ≤ D.ord b} := by
  suffices H : ∀ n : ℕ, ∀ a ∈ 𝒜 m, j ≤ D.ord a → ((d * m + 1 : ℕ) : ℕ∞) ≤ D.ord a + n →
      a ∈ Submodule.span k {b ∈ s | j ≤ D.ord b} from
    H (d * m + 1) a ha hj le_add_self
  intro n
  induction n with
  | zero =>
    intro a ha _ hn
    by_cases h0 : a = 0
    · exact h0 ▸ zero_mem _
    · exfalso
      rw [Nat.cast_zero, add_zero] at hn
      have := hn.trans (D.ord_le ha h0)
      norm_cast at this
      omega
  | succ n ih =>
    intro a ha hj hn
    by_cases hn' : ((d * m + 1 : ℕ) : ℕ∞) ≤ D.ord a + n
    · exact ih a ha hj hn'
    have h0 : a ≠ 0 := by
      rintro rfl
      simp [D.ord_zero] at hn'
    obtain ⟨b, hbs, hb⟩ := h a ha h0 hj
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [D.ord_zero] at hb
      exact D.ord_ne_top ha h0 hb.symm
    obtain ⟨c, hc⟩ := D.exists_lt_ord_sub ha (hs hbs) hb0 hb.symm
    have hmem : a - c • b ∈ 𝒜 m := sub_mem ha (Submodule.smul_mem _ _ (hs hbs))
    have key := ih (a - c • b) hmem (hj.trans hc.le) (by
      calc ((d * m + 1 : ℕ) : ℕ∞) ≤ D.ord a + (n + 1 : ℕ) := hn
        _ = (D.ord a + 1) + n := by push_cast; ring
        _ ≤ D.ord (a - c • b) + n := add_le_add_left (Order.add_one_le_of_lt hc) _)
    rw [← sub_add_cancel a (c • b)]
    exact add_mem key (Submodule.smul_mem _ _ (Submodule.subset_span ⟨hbs, hb ▸ hj⟩))

open scoped Classical in
/-- The orders of the nonzero elements of degree `m`. -/
def orders (m : ℕ) : Finset ℕ :=
  (Finset.range (d * m + 1)).filter fun v ↦ ∃ a ∈ 𝒜 m, D.ord a = v

/-- Membership in `orders`: the bound `v ≤ d m` is automatic. -/
theorem mem_orders {m v : ℕ} : v ∈ D.orders m ↔ ∃ a ∈ 𝒜 m, D.ord a = v := by
  classical
  simp only [orders, Finset.mem_filter, Finset.mem_range, and_iff_right_iff_imp]
  rintro ⟨a, ha, hv⟩
  exact Nat.lt_succ_of_le (by exact_mod_cast hv ▸ D.ord_le ha (D.ne_zero_of_ord_eq hv))

/-- The dimension of `𝒜 m` is the number of orders of its nonzero elements. -/
theorem finrank_eq_card_orders (m : ℕ) : Module.finrank k (𝒜 m) = (D.orders m).card := by
  choose w hw hwo using fun v : D.orders m ↦ D.mem_orders.1 v.2
  have hli : LinearIndependent k w := D.linearIndependent_of_ord w (fun _ ↦ m) hw
    (fun v ↦ D.ne_zero_of_ord_eq (hwo v))
    (fun i j _ h ↦ Subtype.ext (by rw [hwo, hwo] at h; exact_mod_cast h))
  have hspan : Submodule.span k (Set.range w) = 𝒜 m := by
    refine le_antisymm (Submodule.span_le.2 (Set.range_subset_iff.2 hw)) fun a ha ↦
      Submodule.span_mono (Set.sep_subset _ _)
        (D.mem_span_of_ord (Set.range w) (Set.range_subset_iff.2 hw) 0 ?_ ha (by simp))
    intro a ha h0 _
    obtain ⟨v, hv, -⟩ := D.exists_ord_eq ha h0
    exact ⟨w ⟨v, D.mem_orders.2 ⟨a, ha, hv⟩⟩, ⟨_, rfl⟩, (hwo _).trans hv.symm⟩
  rw [← hspan, finrank_span_eq_card hli, Fintype.card_coe]

/-- Transport of a pole order between degrees: if `a ∈ 𝒜 m` has order `d m - p`, then for every
`n` with `p ≤ d n` some element of `𝒜 n` has order `d n - p`. Upwards this is multiplication by
a power of `Z`, downwards division by one. -/
theorem exists_ord_of_pole {m n v p : ℕ} {a : A} (ha : a ∈ 𝒜 m) (hv : D.ord a = v)
    (hvp : v + p = d * m) (hp : p ≤ d * n) : ∃ b ∈ 𝒜 n, D.ord b = (d * n - p : ℕ) := by
  rcases le_or_gt m n with hmn | hmn
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hmn
    refine ⟨D.Z ^ j * a, by rw [add_comm]; exact SetLike.mul_mem_graded (D.Z_pow_mem j) ha, ?_⟩
    rw [D.ord_Z_pow_mul ha, hv]
    norm_cast
    rw [Nat.mul_add] at *
    omega
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_lt hmn
    rw [Nat.mul_add, Nat.mul_add] at hvp
    obtain ⟨b, hb, rfl⟩ := D.exists_eq_Z_pow_mul (m := n) (j := j + 1) (by rwa [← add_assoc])
      (by rw [hv, Nat.mul_add]; norm_cast; omega)
    refine ⟨b, hb, ?_⟩
    obtain ⟨w, hw, -⟩ := D.exists_ord_eq hb (by rintro rfl; simp [D.ord_zero] at hv)
    rw [D.ord_Z_pow_mul hb, hw] at hv
    rw [hw]
    norm_cast at hv ⊢
    rw [Nat.mul_add] at hv
    omega

/-- The order `d m - 1` (a pole of order one) is never attained in positive degree. -/
theorem not_exists_ord_eq_sub_one (hd : 1 ≤ d) {m : ℕ} (hm : 1 ≤ m) :
    ¬ ∃ a ∈ 𝒜 m, D.ord a = (d * m - 1 : ℕ) := by
  rintro ⟨a, ha, hao⟩
  obtain ⟨m₀, hm₀⟩ := D.eventually_finrank_le
  have hdm : 1 ≤ d * m := Nat.mul_pos hd hm
  have hsub : Finset.range (d * m₀ + 1) ⊆ D.orders m₀ := by
    intro v hv
    rw [Finset.mem_range] at hv
    rw [D.mem_orders]
    have hq : a ^ (d * m₀ - v) ∈ 𝒜 ((d * m₀ - v) * m) := by
      simpa [smul_eq_mul] using SetLike.pow_mem_graded (d * m₀ - v) ha
    have hord : D.ord (a ^ (d * m₀ - v)) = (((d * m₀ - v) * (d * m - 1)) : ℕ) := by
      rw [D.ord_pow ha, hao, Nat.cast_mul]
    have hvp : (d * m₀ - v) * (d * m - 1) + (d * m₀ - v) = d * ((d * m₀ - v) * m) := by
      calc (d * m₀ - v) * (d * m - 1) + (d * m₀ - v) = (d * m₀ - v) * (d * m - 1 + 1) := by ring
        _ = (d * m₀ - v) * (d * m) := by rw [Nat.sub_add_cancel hdm]
        _ = d * ((d * m₀ - v) * m) := by ring
    obtain ⟨b, hb, hbo⟩ := D.exists_ord_of_pole hq hord (n := m₀) hvp (by omega)
    exact ⟨b, hb, by rw [hbo]; congr 1; omega⟩
  have := Finset.card_le_card hsub
  rw [Finset.card_range, ← D.finrank_eq_card_orders] at this
  have := hm₀ m₀ le_rfl
  omega

/-- In positive degree the orders lie in `[0, d m] \ {d m - 1}`. -/
theorem orders_subset (hd : 1 ≤ d) {m : ℕ} (hm : 1 ≤ m) :
    D.orders m ⊆ (Finset.range (d * m + 1)).erase (d * m - 1) := by
  classical
  intro v hv
  refine Finset.mem_erase.2 ⟨?_, ?_⟩
  · rintro rfl
    exact D.not_exists_ord_eq_sub_one hd hm (D.mem_orders.1 hv)
  · exact (Finset.mem_filter.1 hv).1

/-- The set `[0, d m] \ {d m - 1}` has `d m` elements. -/
theorem card_range_erase (m : ℕ) : ((Finset.range (d * m + 1)).erase (d * m - 1)).card = d * m := by
  rw [Finset.card_erase_of_mem (Finset.mem_range.2 (by omega)), Finset.card_range]
  simp

/-- In positive degree the orders are exactly `[0, d m] \ {d m - 1}`. -/
theorem orders_eq (hd : 1 ≤ d) {m : ℕ} (hm : 1 ≤ m) :
    D.orders m = (Finset.range (d * m + 1)).erase (d * m - 1) :=
  Finset.eq_of_subset_of_card_le (D.orders_subset hd hm)
    (by rw [card_range_erase, ← D.finrank_eq_card_orders]; exact D.le_finrank hm)

end Data

/-- **Riemann–Roch on the nose**: every graded piece of positive degree has dimension `d m`. -/
theorem finrank_eq (D : Data 𝒜 d) (hd : 1 ≤ d) {m : ℕ} (hm : 1 ≤ m) :
    Module.finrank k (𝒜 m) = d * m := by
  rw [D.finrank_eq_card_orders, D.orders_eq hd hm, Data.card_range_erase]

/-- The orders of the nonzero elements of `𝒜 m`, `m ≥ 1`, are exactly `[0, d m] \ {d m - 1}`. -/
theorem exists_ord_eq_iff (D : Data 𝒜 d) (hd : 1 ≤ d) {m : ℕ} (hm : 1 ≤ m) (v : ℕ) :
    (∃ a ∈ 𝒜 m, a ≠ 0 ∧ D.ord a = v) ↔ v ≤ d * m ∧ v ≠ d * m - 1 := by
  have h : v ∈ D.orders m ↔ v ∈ (Finset.range (d * m + 1)).erase (d * m - 1) := by
    rw [D.orders_eq hd hm]
  rw [D.mem_orders, Finset.mem_erase, Finset.mem_range] at h
  constructor
  · rintro ⟨a, ha, -, hv⟩
    obtain ⟨h1, h2⟩ := h.1 ⟨a, ha, hv⟩
    exact ⟨by omega, h1⟩
  · rintro ⟨h1, h2⟩
    obtain ⟨a, ha, hv⟩ := h.2 ⟨h2, by omega⟩
    exact ⟨a, ha, D.ne_zero_of_ord_eq hv, hv⟩

namespace Data

omit [Nontrivial A] in
/-- A monomial in two elements of degree one and `Z` lies in the expected degree. -/
theorem mono_mem {x y : A} (hx : x ∈ 𝒜 1) (hy : y ∈ 𝒜 1) (i j l : ℕ) :
    x ^ i * y ^ j * D.Z ^ l ∈ 𝒜 (i + j + l) :=
  SetLike.mul_mem_graded (SetLike.mul_mem_graded (pow_mem_of_mem_one hx i)
    (pow_mem_of_mem_one hy j)) (D.Z_pow_mem l)

/-- The order of a monomial in elements `x, y` of degree one and orders one and zero and `Z`. -/
theorem ord_mono {x y : A} (hx : x ∈ 𝒜 1) (hxo : D.ord x = 1) (hy : y ∈ 𝒜 1)
    (hyo : D.ord y = 0) (i j l : ℕ) : D.ord (x ^ i * y ^ j * D.Z ^ l) = (i + d * l : ℕ) := by
  rw [D.ord_mul (SetLike.mul_mem_graded (pow_mem_of_mem_one hx i) (pow_mem_of_mem_one hy j))
    (D.Z_pow_mem l), D.ord_mul (pow_mem_of_mem_one hx i) (pow_mem_of_mem_one hy j),
    D.ord_pow hx, D.ord_pow hy, hxo, hyo, D.ord_Z_pow]
  push_cast
  ring

end Data

open MvPolynomial

/-- Every order of a nonzero element of degree `m` is the order of a monomial
`x ^ i * y ^ j * Z ^ l` of degree `m` with `i ≤ 2`. -/
theorem exists_mono_ord_eq (D : Data 𝒜 3) {x y : A} (hx : x ∈ 𝒜 1) (hxo : D.ord x = 1)
    (hy : y ∈ 𝒜 1) (hyo : D.ord y = 0) {m : ℕ} {a : A} (ha : a ∈ 𝒜 m) (h0 : a ≠ 0) :
    ∃ i j l : ℕ, i ≤ 2 ∧ i + j + l = m ∧ D.ord (x ^ i * y ^ j * D.Z ^ l) = D.ord a := by
  obtain ⟨v, hv, hvm⟩ := D.exists_ord_eq ha h0
  have hv' : m = 0 ∨ v ≠ 3 * m - 1 := (Nat.eq_zero_or_pos m).imp_right fun h ↦
    ((exists_ord_eq_iff D (by norm_num) h v).1 ⟨a, ha, h0, hv⟩).2
  refine ⟨v % 3, m - v % 3 - v / 3, v / 3, by omega, by omega, ?_⟩
  rw [D.ord_mono hx hxo hy hyo, hv]
  congr 1
  omega

omit [Nontrivial A] in
/-- The evaluation of a monomial in three variables. -/
theorem aeval_monomial_fin_three (x y z : A) (s : Fin 3 →₀ ℕ) :
    aeval ![x, y, z] (monomial s (1 : k)) = x ^ s 0 * y ^ s 1 * z ^ s 2 := by
  rw [aeval_monomial, map_one, one_mul, Finsupp.prod_fintype _ _ (fun _ ↦ pow_zero _),
    Fin.prod_univ_three]
  simp

/-- The evaluation `k[x, y, z] → A` at `x, y, Z` is surjective. -/
theorem aeval_surjective (D : Data 𝒜 3) {x y : A} (hx : x ∈ 𝒜 1) (hxo : D.ord x = 1)
    (hy : y ∈ 𝒜 1) (hyo : D.ord y = 0) :
    Function.Surjective (aeval ![x, y, D.Z] : MvPolynomial (Fin 3) k →ₐ[k] A) := by
  set φ := (aeval ![x, y, D.Z] : MvPolynomial (Fin 3) k →ₐ[k] A)
  have hdeg : ∀ m, ∀ a ∈ 𝒜 m, a ∈ φ.range := by
    intro m a ha
    have hspan := D.mem_span_of_ord {b | b ∈ 𝒜 m ∧ b ∈ φ.range} (fun b hb ↦ hb.1) 0 ?_ ha
      (by simp)
    · have hle : Submodule.span k {b ∈ {b | b ∈ 𝒜 m ∧ b ∈ φ.range} | 0 ≤ D.ord b} ≤
          Subalgebra.toSubmodule φ.range := Submodule.span_le.2 fun b hb ↦ hb.1.2
      exact hle hspan
    · intro a ha h0 _
      obtain ⟨i, j, l, -, hijl, hord⟩ := exists_mono_ord_eq D hx hxo hy hyo ha h0
      refine ⟨_, ⟨hijl ▸ D.mono_mem hx hy i j l, (AlgHom.mem_range φ).2
        ⟨X 0 ^ i * X 1 ^ j * X 2 ^ l, by simp [φ]⟩⟩, hord⟩
  intro a
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => exact ⟨0, map_zero _⟩
  | homogeneous b => exact hdeg _ _ b.2
  | add a b ha hb =>
    obtain ⟨p, rfl⟩ := ha
    obtain ⟨q, rfl⟩ := hb
    exact ⟨p + q, map_add _ _ _⟩

/-- The monomials of degree at most two in the first variable have linearly independent images
under the evaluation at `x, y, Z`. -/
theorem linearIndependent_aeval_monomial (D : Data 𝒜 3) {x y : A} (hx : x ∈ 𝒜 1)
    (hxo : D.ord x = 1) (hy : y ∈ 𝒜 1) (hyo : D.ord y = 0) :
    LinearIndependent k fun s : {s : Fin 3 →₀ ℕ // s 0 ≤ 2} ↦
      aeval ![x, y, D.Z] (monomial (s : Fin 3 →₀ ℕ) (1 : k)) := by
  simp only [aeval_monomial_fin_three]
  refine D.linearIndependent_of_ord _ (fun s ↦ s.1 0 + s.1 1 + s.1 2)
    (fun s ↦ D.mono_mem hx hy _ _ _) (fun s ↦ D.ne_zero_of_ord_eq (D.ord_mono hx hxo hy hyo _ _ _))
    fun s t hdeg hord ↦ ?_
  rw [D.ord_mono hx hxo hy hyo, D.ord_mono hx hxo hy hyo] at hord
  have hord' : s.1 0 + 3 * s.1 2 = t.1 0 + 3 * t.1 2 := by exact_mod_cast hord
  have hs := s.2
  have ht := t.2
  have h0 : s.1 0 = t.1 0 := by omega
  have h2 : s.1 2 = t.1 2 := by omega
  have h1 : s.1 1 = t.1 1 := by omega
  refine Subtype.ext (Finsupp.ext fun i ↦ ?_)
  fin_cases i
  exacts [h0, h1, h2]

/-- A polynomial all of whose monomials have degree at most two in the first variable and which
vanishes at `x, y, Z` is zero. -/
theorem eq_zero_of_aeval_eq_zero (D : Data 𝒜 3) {x y : A} (hx : x ∈ 𝒜 1)
    (hxo : D.ord x = 1) (hy : y ∈ 𝒜 1) (hyo : D.ord y = 0) {r : MvPolynomial (Fin 3) k}
    (hr : ∀ s ∈ r.support, s 0 ≤ 2) (h : aeval ![x, y, D.Z] r = 0) : r = 0 := by
  classical
  have hli := linearIndependent_iff'.1 (linearIndependent_aeval_monomial D hx hxo hy hyo)
    (r.support.subtype fun s ↦ s 0 ≤ 2) (fun s ↦ r.coeff s.1) (by
      rw [Finset.sum_subtype_of_mem (fun s ↦ r.coeff s • aeval ![x, y, D.Z] (monomial s (1 : k)))
        hr, ← h]
      conv_rhs => rw [r.as_sum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun s _ ↦ ?_
      rw [← map_smul, smul_monomial, smul_eq_mul, mul_one])
  ext s
  rw [AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  by_contra hs
  exact hs (hli ⟨s, hr s (mem_support_iff.2 hs)⟩ (Finset.mem_subtype.2 (mem_support_iff.2 hs)))

/-- Seen as a polynomial in the first variable over the other two, the negative of the
homogeneous Weierstrass polynomial is monic of degree three. -/
theorem monic_finSuccEquiv_neg_polynomial (C : WeierstrassCurve k) :
    (finSuccEquiv k 2 (-C.toProjective.polynomial)).Monic ∧
      (finSuccEquiv k 2 (-C.toProjective.polynomial)).natDegree = 3 := by
  simp only [WeierstrassCurve.Projective.polynomial, map_neg, map_sub, map_add, map_mul, map_pow,
    finSuccEquiv_X_zero]
  have h1 : finSuccEquiv k 2 (X 1) = Polynomial.C (X 0) := finSuccEquiv_X_succ (j := 0)
  have h2 : finSuccEquiv k 2 (X 2) = Polynomial.C (X 1) := finSuccEquiv_X_succ (j := 1)
  have hC : ∀ a : k, finSuccEquiv k 2 (MvPolynomial.C a) = Polynomial.C (MvPolynomial.C a) :=
    fun a ↦ (finSuccEquiv k 2).commutes a
  simp only [h1, h2, hC]
  have : ∀ (q : Polynomial (MvPolynomial (Fin 2) k)), q = Polynomial.X ^ 3 +
      (Polynomial.C (MvPolynomial.C C.a₂ * X 1) * Polynomial.X ^ 2 +
        Polynomial.C (MvPolynomial.C C.a₄ * X 1 ^ 2 - MvPolynomial.C C.a₁ * X 0 * X 1) *
          Polynomial.X +
        Polynomial.C (MvPolynomial.C C.a₆ * X 1 ^ 3 - X 0 ^ 2 * X 1 -
          MvPolynomial.C C.a₃ * X 0 * X 1 ^ 2)) → q.Monic ∧ q.natDegree = 3 := by
    rintro q rfl
    exact ⟨Polynomial.monic_X_pow_add (lt_of_le_of_lt (by compute_degree) (by norm_num)),
      by compute_degree!⟩
  apply this
  simp only [Polynomial.C_mul, Polynomial.C_sub, Polynomial.C_pow]
  ring

/-- A polynomial vanishing at `x, y, Z` is a multiple of a Weierstrass polynomial vanishing
there: divide by it as a monic cubic in the first variable, and the remainder vanishes. -/
theorem mem_span_of_aeval_eq_zero (D : Data 𝒜 3) {x y : A} (hx : x ∈ 𝒜 1)
    (hxo : D.ord x = 1) (hy : y ∈ 𝒜 1) (hyo : D.ord y = 0) (C : WeierstrassCurve k)
    (hC : aeval ![x, y, D.Z] C.toProjective.polynomial = 0) {p : MvPolynomial (Fin 3) k}
    (hp : aeval ![x, y, D.Z] p = 0) : p ∈ Ideal.span {C.toProjective.polynomial} := by
  set F := C.toProjective.polynomial
  set Φ := finSuccEquiv k 2
  obtain ⟨hmon, hdeg⟩ := monic_finSuccEquiv_neg_polynomial C
  set r := Φ.symm (Φ p %ₘ Φ (-F))
  have hpr : p = r + (-F) * Φ.symm (Φ p /ₘ Φ (-F)) := by
    apply Φ.injective
    rw [map_add, map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
    exact (Polynomial.modByMonic_add_div (Φ p) (Φ (-F))).symm
  have hr0 : aeval ![x, y, D.Z] r = 0 := by
    rwa [hpr, map_add, map_mul, map_neg, hC, neg_zero, zero_mul, add_zero] at hp
  have hlt : degreeOf 0 r < 3 := by
    rw [← natDegree_finSuccEquiv, AlgEquiv.apply_symm_apply]
    exact lt_of_lt_of_eq (Polynomial.natDegree_modByMonic_lt _ hmon
      (fun h ↦ by rw [h, Polynomial.natDegree_one] at hdeg; omega)) hdeg
  have hr : r = 0 := eq_zero_of_aeval_eq_zero D hx hxo hy hyo
    (fun s hs ↦ by have := monomial_le_degreeOf 0 hs; omega) hr0
  rw [hpr, hr, zero_add]
  exact Ideal.mul_mem_right _ _ (neg_mem (Ideal.subset_span rfl))

/-- **The cubic relation.** For `X, Y ∈ 𝒜 1` of orders one and zero, the ten cubic monomials in
`X, Y, Z` satisfy a relation `X³ - c Y²Z ∈ span {XYZ, X²Z, YZ², XZ², Z³}` with `c ≠ 0`:
`X³` and `Y²Z` both have order three, and every order at least four in degree three is attained
by one of the five monomials on the right. -/
theorem exists_relation (D : Data 𝒜 3) {X Y : A} (hX : X ∈ 𝒜 1) (hXo : D.ord X = 1)
    (hY : Y ∈ 𝒜 1) (hYo : D.ord Y = 0) :
    ∃ c d₁ d₂ d₃ d₄ d₅ : k, c ≠ 0 ∧ X ^ 3 - c • (Y ^ 2 * D.Z) =
      d₁ • (X * Y * D.Z) + d₂ • (X ^ 2 * D.Z) + d₃ • (Y * D.Z ^ 2) + d₄ • (X * D.Z ^ 2) +
        d₅ • D.Z ^ 3 := by
  have hm := D.mono_mem hX hY
  have ho := D.ord_mono hX hXo hY hYo
  obtain ⟨c, hc⟩ := D.exists_lt_ord_sub (hm 3 0 0) (hm 0 2 1)
    (D.ne_zero_of_ord_eq (ho 0 2 1)) (by rw [ho, ho])
  have hc0 : c ≠ 0 := by
    rintro rfl
    simp at hc
  have ha' : X ^ 3 * Y ^ 0 * D.Z ^ 0 - c • (X ^ 0 * Y ^ 2 * D.Z ^ 1) ∈ 𝒜 3 :=
    sub_mem (hm 3 0 0) (Submodule.smul_mem _ _ (hm 0 2 1))
  have h4 : ((4 : ℕ) : ℕ∞) ≤ D.ord (X ^ 3 * Y ^ 0 * D.Z ^ 0 - c • (X ^ 0 * Y ^ 2 * D.Z ^ 1)) := by
    have := Order.add_one_le_of_lt hc
    rwa [ho] at this
  have hs : ({X ^ 1 * Y ^ 1 * D.Z ^ 1, X ^ 2 * Y ^ 0 * D.Z ^ 1, X ^ 0 * Y ^ 1 * D.Z ^ 2,
      X ^ 1 * Y ^ 0 * D.Z ^ 2, X ^ 0 * Y ^ 0 * D.Z ^ 3} : Set A) ⊆ 𝒜 3 := by
    intro b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
    rcases hb with rfl | rfl | rfl | rfl | rfl
    exacts [hm 1 1 1, hm 2 0 1, hm 0 1 2, hm 1 0 2, hm 0 0 3]
  have hspan := D.mem_span_of_ord _ hs (4 : ℕ) (by
    intro a ha h0 h4a
    obtain ⟨v, hv, hv9⟩ := D.exists_ord_eq ha h0
    have h8 := ((exists_ord_eq_iff D (by norm_num) (by norm_num : 1 ≤ 3) v).1
      ⟨a, ha, h0, hv⟩).2
    rw [hv] at h4a
    have h4v : 4 ≤ v := by exact_mod_cast h4a
    interval_cases v
    · exact ⟨_, Set.mem_insert _ _, by rw [hv, ho]⟩
    · exact ⟨_, Set.mem_insert_of_mem _ (Set.mem_insert _ _), by rw [hv, ho]⟩
    · exact ⟨_, Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _)),
        by rw [hv, ho]⟩
    · exact ⟨_, Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
        (Set.mem_insert_of_mem _ (Set.mem_insert _ _))), by rw [hv, ho]⟩
    · exact absurd rfl h8
    · exact ⟨_, Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
        (Set.mem_insert_of_mem _ (Set.mem_singleton _)))), by rw [hv, ho]⟩) ha' h4
  replace hspan := Submodule.span_mono (Set.sep_subset _ _) hspan
  obtain ⟨d₁, z₁, hz₁, h₁⟩ := Submodule.mem_span_insert.1 hspan
  obtain ⟨d₂, z₂, hz₂, h₂⟩ := Submodule.mem_span_insert.1 hz₁
  obtain ⟨d₃, z₃, hz₃, h₃⟩ := Submodule.mem_span_insert.1 hz₂
  obtain ⟨d₄, z₄, hz₄, h₄⟩ := Submodule.mem_span_insert.1 hz₃
  obtain ⟨d₅, h₅⟩ := Submodule.mem_span_singleton.1 hz₄
  refine ⟨c, d₁, d₂, d₃, d₄, d₅, hc0, ?_⟩
  rw [h₂, h₃, h₄, ← h₅] at h₁
  simp only [pow_zero, pow_one, mul_one, one_mul] at h₁
  rw [h₁]
  abel

/-- **The Weierstrass equation.** For any `X, Y ∈ 𝒜 1` of orders one and zero, after rescaling by
two nonzero scalars the three elements `λX, νY, Z` generate `A` and satisfy exactly one relation,
a Weierstrass equation: the `k`-algebra map `k[x, y, z] → A` sending `x, y, z` to `λX, νY, Z` is
surjective with kernel generated by the homogeneous Weierstrass polynomial of some `C`. -/
theorem exists_weierstrassCurve (D : Data 𝒜 3) {X Y : A} (hX : X ∈ 𝒜 1) (hXo : D.ord X = 1)
    (hY : Y ∈ 𝒜 1) (hYo : D.ord Y = 0) :
    ∃ (C : WeierstrassCurve k) (l n : k), l ≠ 0 ∧ n ≠ 0 ∧
      Function.Surjective (MvPolynomial.aeval ![l • X, n • Y, D.Z] :
        MvPolynomial (Fin 3) k →ₐ[k] A) ∧
      RingHom.ker (MvPolynomial.aeval ![l • X, n • Y, D.Z] :
        MvPolynomial (Fin 3) k →ₐ[k] A) = Ideal.span {C.toProjective.polynomial} := by
  obtain ⟨c, d₁, d₂, d₃, d₄, d₅, hc, hrel⟩ := exists_relation D hX hXo hY hYo
  have hx : c • X ∈ 𝒜 1 := Submodule.smul_mem _ _ hX
  have hxo : D.ord (c • X) = 1 := by rw [D.ord_smul hX hc, hXo]
  have hy : c ^ 2 • Y ∈ 𝒜 1 := Submodule.smul_mem _ _ hY
  have hyo : D.ord (c ^ 2 • Y) = 0 := by rw [D.ord_smul hY (pow_ne_zero 2 hc), hYo]
  let C : WeierstrassCurve k := ⟨d₁, -c * d₂, c * d₃, -c ^ 2 * d₄, -c ^ 3 * d₅⟩
  have hC : aeval ![c • X, c ^ 2 • Y, D.Z] C.toProjective.polynomial = 0 := by
    simp only [WeierstrassCurve.Projective.polynomial, C, map_sub,
      map_add, map_mul, map_pow, aeval_X, aeval_C, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Algebra.smul_def, map_neg] at hrel ⊢
    linear_combination (-(algebraMap k A c) ^ 3) * hrel
  exact ⟨C, c, c ^ 2, hc, pow_ne_zero 2 hc, aeval_surjective D hx hxo hy hyo,
    le_antisymm (fun p hp ↦ mem_span_of_aeval_eq_zero D hx hxo hy hyo C hC (RingHom.mem_ker.1 hp))
      (Ideal.span_le.2 (Set.singleton_subset_iff.2 (RingHom.mem_ker.2 hC)))⟩

end Stacks.GenusOneSectionRing
