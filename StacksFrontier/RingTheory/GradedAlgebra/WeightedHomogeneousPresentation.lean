/-!
# Weighted-homogeneous presentations and the graded Jacobian

Let `S` be a graded algebra over a commutative ring `R`, with grading `𝒜 : ℕ → Submodule R S`.
A *weighted-homogeneous presentation* of `S` is a surjection

`R[X_i : i ∈ ι] ⟶ S`,  `X_i ↦ x_i ∈ 𝒜 (d i)`,

whose kernel is generated by relations `F_j` which are weighted homogeneous of degree `e j` for
the weights `d`. Such a presentation has a *graded Jacobian*

`J : ⨁_i 𝒜 (d i) ⟶ ⨁_j 𝒜 (e j)`,  `(p_i) ↦ (∑_i p_i · ∂F_j/∂X_i)`,

a map of `R`-modules, and the cokernel `W` of `J` is the vector space that controls first-order
deformations of `S`: it is the space called `W` in the proof of Stacks 0DVZ. When the graded
pieces of `S` are finite over `R` and the presentation is finite, `W` is a finite `R`-module,
hence finite dimensional when `R` is a field.

This file also shows that a graded algebra of finite type over a field, with finite-dimensional
graded pieces, admits a finite weighted-homogeneous presentation.

## Main definitions

* `Algebra.WeightedHomogeneousPresentation`: a weighted-homogeneous presentation of a graded
  algebra.
* `Algebra.WeightedHomogeneousPresentation.pderivVal`: the image in `S` of `∂F_j/∂X_i`.
* `Algebra.WeightedHomogeneousPresentation.jacobian`: the graded Jacobian.
* `Algebra.WeightedHomogeneousPresentation.jacobianCokernel`: its cokernel, the space `W` of
  the proof of Stacks 0DVZ.

## Main results

* `MvPolynomial.aeval_mem_of_isWeightedHomogeneous`: a graded evaluation map carries a weighted
  homogeneous polynomial into the corresponding graded piece.
* `MvPolynomial.aeval_weightedHomogeneousComponent_eq_zero`: the kernel of a graded evaluation
  map is a homogeneous ideal, in the form that every weighted homogeneous component of a
  relation is again a relation.
* `MvPolynomial.exists_fin_isWeightedHomogeneous_span_ker`: over a Noetherian base the kernel of
  a graded evaluation map in finitely many variables is generated by finitely many weighted
  homogeneous polynomials.
* `MvPolynomial.aeval_add_of_mul_eq_zero`: the first-order Taylor expansion of a polynomial at a
  perturbation of the point of evaluation by elements with vanishing pairwise products.
* `Algebra.WeightedHomogeneousPresentation.aeval_val_add_relation_eq_jacobian`: the graded
  Jacobian is exactly the first-order variation of the relations under a square-zero
  perturbation of the chosen generators. This is the computation omitted from the proof of
  Stacks 0DVZ, and it is why the cokernel of the Jacobian is the right receptacle.
* `Algebra.WeightedHomogeneousPresentation.exists_fin_of_finiteType`: a graded algebra of finite
  type over a field with finite-dimensional graded pieces has a finite weighted-homogeneous
  presentation.
* `Algebra.WeightedHomogeneousPresentation.jacobianCokernel_finite`: the cokernel of the graded
  Jacobian of a finite presentation is a finite `R`-module as soon as the graded pieces are.

## Implementation notes

The homogeneity of the kernel is stated through `MvPolynomial.weightedHomogeneousComponent`
rather than through `Ideal.IsHomogeneous`, because the latter needs the graded-algebra structure
`MvPolynomial.weightedGradedAlgebra` on the polynomial ring as an instance, which is deliberately
not global in Mathlib. The component form is what every consumer here uses anyway.

A partial derivative lowers the weighted degree by the weight of the variable, so
`∂F_j/∂X_i` is weighted homogeneous of degree `e j - d i` with truncated subtraction: the
degenerate case `e j < d i` is harmless because then `∂F_j/∂X_i = 0`, which is weighted
homogeneous of every degree. This is why `jacobian` is defined without a side condition
relating the two degree functions.

## References

* [Stacks Project, Tag 0DVZ](https://stacks.math.columbia.edu/tag/0DVZ)
-/

@[expose] public section

namespace MvPolynomial

variable {R S ι : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- A weighted homogeneous polynomial whose degree is smaller than the weight of a variable does
not involve that variable, so its partial derivative there vanishes. -/
theorem IsWeightedHomogeneous.pderiv_eq_zero_of_lt {d : ι → ℕ} {n : ℕ} {i : ι}
    {φ : MvPolynomial ι R} (hφ : φ.IsWeightedHomogeneous d n) (hlt : n < d i) :
    pderiv i φ = 0 := by
  classical
  ext a
  rw [coeff_pderiv, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  have hz : φ.coeff (a + Finsupp.single i 1) = 0 := by
    by_contra hc
    have hw := hφ hc
    rw [map_add, Finsupp.weight_single] at hw
    simp only [smul_eq_mul] at hw
    omega
  simp [hz]

/-- Evaluating a weighted homogeneous polynomial of degree `n` at homogeneous elements whose
degrees are the weights lands in the degree-`n` piece. -/
theorem aeval_mem_of_isWeightedHomogeneous (𝒜 : ℕ → Submodule R S) [SetLike.GradedMonoid 𝒜]
    (x : ι → S) (d : ι → ℕ) (hx : ∀ i, x i ∈ 𝒜 (d i)) {φ : MvPolynomial ι R} {n : ℕ}
    (hφ : φ.IsWeightedHomogeneous d n) : aeval x φ ∈ 𝒜 n := by
  induction hφ using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => simp
  | add p q hp hq ihp ihq => simpa using add_mem ihp ihq
  | monomial a r hr =>
      rw [aeval_monomial, ← hr, Finsupp.weight_apply, Finsupp.sum]
      have hprod : (a.prod fun i j ↦ x i ^ j) ∈ 𝒜 (∑ i ∈ a.support, a i • d i) :=
        SetLike.prod_mem_graded 𝒜 (fun i ↦ a i • d i) (fun i ↦ x i ^ a i)
          (fun i _ ↦ by simpa [smul_eq_mul] using SetLike.pow_mem_graded (a i) (hx i))
      simpa using SetLike.mul_mem_graded (SetLike.algebraMap_mem_graded 𝒜 r) hprod

/-- A finite family of homogeneous elements of pairwise distinct degrees summing to zero is
zero. -/
theorem eq_zero_of_sum_mem_graded_eq_zero (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜]
    (T : Finset ℕ) (y : ℕ → S) (hy : ∀ n, y n ∈ 𝒜 n) (h : ∑ n ∈ T, y n = 0) :
    ∀ n ∈ T, y n = 0 := by
  classical
  intro n hn
  have h2 : (DirectSum.decomposeAddEquiv 𝒜) (∑ m ∈ T, y m) n = 0 := by rw [h]; simp
  have key : ∀ m,
      (DirectSum.decomposeAddEquiv 𝒜) (y m) = DirectSum.of (𝒜 ·) m ⟨y m, hy m⟩ := fun m ↦ by
      have hd : (DirectSum.decomposeAddEquiv 𝒜) (y m) = DirectSum.decompose 𝒜 (y m) := rfl
      rw [hd, DirectSum.decompose_of_mem 𝒜 (hy m)]
  rw [map_sum, DFinsupp.finsetSum_apply, Finset.sum_eq_single_of_mem n hn] at h2
  · simpa [key n] using h2
  · intro m _ hmn
    rw [key m]
    exact DirectSum.of_eq_of_ne _ _ _ fun hh ↦ hmn hh.symm

/-- A polynomial is the sum of its weighted homogeneous components of the degrees occurring in
its support. -/
theorem sum_weightedHomogeneousComponent_support (d : ι → ℕ) (φ : MvPolynomial ι R) :
    ∑ n ∈ Finset.image (Finsupp.weight d) φ.support, weightedHomogeneousComponent d n φ = φ := by
  classical
  refine Eq.trans ?_ (sum_weightedHomogeneousComponent d φ)
  refine (finsum_eq_finsetSum_of_support_subset
    (fun n ↦ weightedHomogeneousComponent d n φ) ?_).symm
  intro n hn
  simp only [Function.mem_support, ne_eq] at hn
  by_contra hnn
  exact hn (weightedHomogeneousComponent_eq_zero_of_notMem d φ n (by simpa using hnn))

/-- The kernel of a graded evaluation map is a homogeneous ideal: every weighted homogeneous
component of a relation is a relation. -/
theorem aeval_weightedHomogeneousComponent_eq_zero (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜]
    (x : ι → S) (d : ι → ℕ) (hx : ∀ i, x i ∈ 𝒜 (d i)) {φ : MvPolynomial ι R}
    (hφ : aeval x φ = 0) (n : ℕ) : aeval x (weightedHomogeneousComponent d n φ) = 0 := by
  classical
  by_cases hn : n ∈ Finset.image (Finsupp.weight d) φ.support
  · have h0 : ∑ m ∈ Finset.image (Finsupp.weight d) φ.support,
        aeval x (weightedHomogeneousComponent d m φ) = 0 := by
      rw [← map_sum, sum_weightedHomogeneousComponent_support d φ, hφ]
    exact eq_zero_of_sum_mem_graded_eq_zero 𝒜 _
      (fun m ↦ aeval x (weightedHomogeneousComponent d m φ))
      (fun m ↦ aeval_mem_of_isWeightedHomogeneous 𝒜 x d hx
        (weightedHomogeneousComponent_isWeightedHomogeneous m φ)) h0 n hn
  · rw [weightedHomogeneousComponent_eq_zero_of_notMem d φ n hn, map_zero]

/-- **First-order Taylor expansion.** Perturbing the point of evaluation by a family of
elements whose pairwise products vanish changes the value of a polynomial by the corresponding
linear combination of its partial derivatives. -/
theorem aeval_add_of_mul_eq_zero [Fintype ι] (x z : ι → S) (hz : ∀ i j, z i * z j = 0)
    (φ : MvPolynomial ι R) :
    aeval (x + z) φ = aeval x φ + ∑ i, z i * aeval x (pderiv i φ) := by
  classical
  induction φ using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq =>
      rw [map_add, map_add, hp, hq]
      simp only [map_add, mul_add]
      rw [Finset.sum_add_distrib]
      ring
  | mul_X p i hp =>
      have hpd : ∀ j, pderiv j (p * X i)
          = (if j = i then p else 0) + pderiv j p * X i := by
        intro j
        rw [Derivation.leibniz, pderiv_X]
        by_cases h : j = i <;> simp [h, mul_comm]
      have hsz : (∑ j, z j * aeval x (pderiv j p)) * z i = 0 := by
        rw [Finset.sum_mul]
        refine Finset.sum_eq_zero fun j _ ↦ ?_
        rw [mul_right_comm, hz j i, zero_mul]
      have hR : ∑ j, z j * aeval x (pderiv j (p * X i))
          = (∑ j, z j * aeval x (pderiv j p) * x i) + z i * aeval x p := by
        have hterm : ∀ j : ι, z j * aeval x (pderiv j (p * X i))
            = z j * aeval x (pderiv j p) * x i + (if j = i then z i * aeval x p else 0) := by
          intro j
          rw [hpd j]
          by_cases h : j = i
          · subst h; simp; ring
          · simp [h]; ring
        rw [Finset.sum_congr rfl fun j _ ↦ hterm j, Finset.sum_add_distrib,
          Finset.sum_ite_eq' Finset.univ i fun _ ↦ z i * aeval x p]
        simp
      rw [map_mul, map_mul, aeval_X, aeval_X, hp, hR, ← Finset.sum_mul]
      simp only [Pi.add_apply]
      linear_combination hsz

/-- Over a Noetherian base ring, and in finitely many variables, the kernel of a graded
evaluation map is generated by finitely many weighted homogeneous polynomials. -/
theorem exists_fin_isWeightedHomogeneous_span_ker [Finite ι] [IsNoetherianRing R]
    (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜] (x : ι → S) (d : ι → ℕ)
    (hx : ∀ i, x i ∈ 𝒜 (d i)) :
    ∃ (m : ℕ) (F : Fin m → MvPolynomial ι R) (e : Fin m → ℕ),
      (∀ j, (F j).IsWeightedHomogeneous d (e j)) ∧
        Ideal.span (Set.range F) =
          RingHom.ker (aeval x : MvPolynomial ι R →ₐ[R] S) := by
  classical
  set K : Ideal (MvPolynomial ι R) := RingHom.ker (aeval x : MvPolynomial ι R →ₐ[R] S) with hK
  obtain ⟨s, hs⟩ := (isNoetherian_def.mp (inferInstance : IsNoetherian _ _) K)
  -- the finite index set of all weighted homogeneous components of all chosen generators
  set T : {p : MvPolynomial ι R // p ∈ s} → Finset ℕ :=
    fun p ↦ Finset.image (Finsupp.weight d) (p.1).support with hT
  set ι₀ := Σ p : {p : MvPolynomial ι R // p ∈ s}, {n : ℕ // n ∈ T p} with hι₀
  have hmemK : ∀ p : {p : MvPolynomial ι R // p ∈ s}, p.1 ∈ K := by
    intro p
    rw [← hs]
    exact Submodule.subset_span p.2
  set F₀ : ι₀ → MvPolynomial ι R :=
    fun z ↦ weightedHomogeneousComponent d z.2.1 z.1.1 with hF₀
  set e₀ : ι₀ → ℕ := fun z ↦ z.2.1 with he₀
  have hhom : ∀ z, (F₀ z).IsWeightedHomogeneous d (e₀ z) := fun z ↦
    weightedHomogeneousComponent_isWeightedHomogeneous _ _
  have hspan : Ideal.span (Set.range F₀) = K := by
    refine le_antisymm (Ideal.span_le.2 ?_) ?_
    · rintro _ ⟨z, rfl⟩
      exact aeval_weightedHomogeneousComponent_eq_zero 𝒜 x d hx (hmemK z.1) z.2.1
    · rw [← hs, Submodule.span_le]
      intro p hp
      have hsum := sum_weightedHomogeneousComponent_support d p
      rw [← hsum]
      refine sum_mem fun n hn ↦ Ideal.subset_span ⟨⟨⟨p, hp⟩, ⟨n, hn⟩⟩, rfl⟩
  let eqv := (Fintype.equivFin ι₀).symm
  refine ⟨Fintype.card ι₀, F₀ ∘ eqv, e₀ ∘ eqv, fun j ↦ hhom _, ?_⟩
  rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hspan]

end MvPolynomial

namespace Algebra

open MvPolynomial

universe u v w t

/-- A weighted-homogeneous presentation of a graded `R`-algebra `S`: a family of homogeneous
algebra generators `x_i` of degree `d i` together with weighted homogeneous relations `F_j` of
degree `e j` generating the kernel of `R[X_i] → S`, `X_i ↦ x_i`.

This is the datum from which the proof of Stacks 0DVZ builds the finite-dimensional space `W`
receiving the tangent space of the deformation category of a graded algebra. -/
structure WeightedHomogeneousPresentation (R : Type u) (S : Type v) [CommRing R] [CommRing S]
    [Algebra R S] (𝒜 : ℕ → Submodule R S) (ι : Type w) (σ : Type t) where
  /-- The degree of the variable `X_i`. -/
  varDegree : ι → ℕ
  /-- The value of the variable `X_i`, a homogeneous element of degree `varDegree i`. -/
  val : ι → S
  /-- The chosen generators are homogeneous of the prescribed degrees. -/
  val_mem : ∀ i, val i ∈ 𝒜 (varDegree i)
  /-- The chosen generators generate `S` as an `R`-algebra. -/
  surjective_aeval : Function.Surjective (aeval val : MvPolynomial ι R →ₐ[R] S)
  /-- The degree of the relation `F_j`. -/
  relDegree : σ → ℕ
  /-- The relation `F_j`, a weighted homogeneous polynomial of degree `relDegree j`. -/
  relation : σ → MvPolynomial ι R
  /-- The relations are weighted homogeneous of the prescribed degrees. -/
  relation_isWeightedHomogeneous :
    ∀ j, (relation j).IsWeightedHomogeneous varDegree (relDegree j)
  /-- The relations generate the kernel of the presentation. -/
  span_range_relation_eq_ker :
    Ideal.span (Set.range relation) = RingHom.ker (aeval val : MvPolynomial ι R →ₐ[R] S)

namespace WeightedHomogeneousPresentation

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
  {𝒜 : ℕ → Submodule R S} {ι : Type w} {σ : Type t}

/-- A relation of a presentation evaluates to zero at the chosen generators. -/
theorem aeval_val_relation (P : WeightedHomogeneousPresentation R S 𝒜 ι σ) (j : σ) :
    aeval P.val (P.relation j) = 0 := by
  have hmem : P.relation j ∈ RingHom.ker (aeval P.val : MvPolynomial ι R →ₐ[R] S) := by
    rw [← P.span_range_relation_eq_ker]
    exact Ideal.subset_span ⟨j, rfl⟩
  exact hmem

section GradedMonoid

variable [SetLike.GradedMonoid 𝒜] (P : WeightedHomogeneousPresentation R S 𝒜 ι σ)

/-- The image in `S` of the partial derivative `∂F_j/∂X_i` of a relation. -/
noncomputable def pderivVal (j : σ) (i : ι) : S :=
  aeval P.val (pderiv i (P.relation j))

/-- Multiplying `∂F_j/∂X_i` by a homogeneous element of degree `d i` lands in the degree-`e j`
piece: the partial derivative is homogeneous of degree `e j - d i`, and vanishes when that
truncated subtraction is lossy. -/
theorem mul_pderivVal_mem (j : σ) (i : ι) {p : S} (hp : p ∈ 𝒜 (P.varDegree i)) :
    p * P.pderivVal j i ∈ 𝒜 (P.relDegree j) := by
  rcases le_or_gt (P.varDegree i) (P.relDegree j) with hle | hlt
  · have hd : (pderiv i (P.relation j)).IsWeightedHomogeneous P.varDegree
        (P.relDegree j - P.varDegree i) :=
      (P.relation_isWeightedHomogeneous j).pderiv (Nat.sub_add_cancel hle)
    have := SetLike.mul_mem_graded hp
      (aeval_mem_of_isWeightedHomogeneous 𝒜 P.val P.varDegree P.val_mem hd)
    rwa [Nat.add_sub_cancel' hle] at this
  · rw [pderivVal, (P.relation_isWeightedHomogeneous j).pderiv_eq_zero_of_lt hlt, map_zero,
      mul_zero]
    exact zero_mem _

variable [Fintype ι]

/-- The graded Jacobian of a weighted-homogeneous presentation: the `R`-linear
map `(p_i) ↦ (∑_i p_i ∂F_j/∂X_i)` from the product of the degree-`d i` pieces to the product of
the degree-`e j` pieces. -/
noncomputable def jacobian :
    (∀ i, 𝒜 (P.varDegree i)) →ₗ[R] (∀ j, 𝒜 (P.relDegree j)) where
  toFun p j := ⟨∑ i, (p i : S) * P.pderivVal j i,
    sum_mem fun i _ ↦ P.mul_pderivVal_mem j i (p i).2⟩
  map_add' p q := by
    ext j
    simp [add_mul, Finset.sum_add_distrib]
  map_smul' r p := by
    ext j
    simp [Finset.smul_sum]

/-- The `j`-th component of the graded Jacobian applied to `(p_i)`, viewed in `S`, is
`∑_i p_i ∂F_j/∂X_i`. -/
@[simp]
theorem jacobian_apply_coe {𝒜 : ℕ → Submodule R S} [SetLike.GradedMonoid 𝒜]
    (P : WeightedHomogeneousPresentation R S 𝒜 ι σ) (p : ∀ i, 𝒜 (P.varDegree i)) (j : σ) :
    (P.jacobian p j : S) = ∑ i, (p i : S) * P.pderivVal j i := rfl

/-- **The graded Jacobian is the first-order variation of the relations.** Perturbing the
chosen generators `x_i` by homogeneous elements `p_i` of the same degree whose pairwise
products vanish changes the value of the relation `F_j` at the generators from `0` to the
`j`-th component of the graded Jacobian applied to `(p_i)`.

This is the computation left out of the proof of Stacks 0DVZ: it is what makes the cokernel of
the Jacobian, rather than `⨁_j 𝒜 (e j)` itself, the receptacle of the first-order deformation
class of a graded algebra. -/
theorem aeval_val_add_relation_eq_jacobian (p : ∀ i, 𝒜 (P.varDegree i))
    (hp : ∀ i i', (p i : S) * (p i' : S) = 0) (j : σ) :
    aeval (P.val + fun i ↦ (p i : S)) (P.relation j) = (P.jacobian p j : S) := by
  rw [aeval_add_of_mul_eq_zero P.val _ hp, P.aeval_val_relation j, zero_add,
    jacobian_apply_coe]
  rfl

/-- The cokernel `W` of the graded Jacobian of a weighted-homogeneous
presentation. For a finite presentation of a graded algebra with finite graded pieces this is a
finite `R`-module, and it is the space into which the tangent space of the deformation category
of the graded algebra injects. -/
noncomputable abbrev jacobianCokernel : Type (max t v) :=
  (∀ j, 𝒜 (P.relDegree j)) ⧸ LinearMap.range P.jacobian

/-- The cokernel of the graded Jacobian of a finite weighted-homogeneous
presentation is a finite `R`-module as soon as the graded pieces are; in particular it is
finite dimensional over a field. -/
instance jacobianCokernel_finite [Finite σ] [∀ n, Module.Finite R (𝒜 n)] :
    Module.Finite R P.jacobianCokernel :=
  Module.Finite.of_surjective (LinearMap.range P.jacobian).mkQ
    (LinearMap.range P.jacobian).mkQ_surjective

end GradedMonoid

/-- A graded algebra of finite type over a field, with finite-dimensional
graded pieces, admits a finite weighted-homogeneous presentation: a presentation by finitely
many homogeneous generators and finitely many weighted homogeneous relations. -/
theorem exists_fin_of_finiteType {k : Type u} {P : Type v} [Field k] [CommRing P] [Algebra k P]
    (𝒜 : ℕ → Submodule k P) [GradedAlgebra 𝒜] [∀ n, Module.Finite k (𝒜 n)]
    [Algebra.FiniteType k P] :
    ∃ n m : ℕ, Nonempty (WeightedHomogeneousPresentation k P 𝒜 (Fin n) (Fin m)) := by
  obtain ⟨n, x, d, hx, hgen⟩ := GradedAlgebra.exists_fin_homogeneous_adjoin_eq_top 𝒜
  have hsurj : Function.Surjective (aeval x : MvPolynomial (Fin n) k →ₐ[k] P) := by
    intro y
    have hy : y ∈ (aeval x : MvPolynomial (Fin n) k →ₐ[k] P).range := by
      rw [← Algebra.adjoin_range_eq_range_aeval, hgen]
      exact Algebra.mem_top
    exact hy
  obtain ⟨m, F, e, hFhom, hFspan⟩ :=
    MvPolynomial.exists_fin_isWeightedHomogeneous_span_ker 𝒜 x d hx
  refine ⟨n, m, ⟨?_⟩⟩
  exact
    { varDegree := d
      val := x
      val_mem := hx
      surjective_aeval := hsurj
      relDegree := e
      relation := F
      relation_isWeightedHomogeneous := hFhom
      span_range_relation_eq_ker := hFspan }

end WeightedHomogeneousPresentation

end Algebra

end
