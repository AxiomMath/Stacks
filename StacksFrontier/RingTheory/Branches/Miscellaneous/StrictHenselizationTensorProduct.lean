@[expose] public section

/-!
# Branches: minimal primes of the strict henselization of a tensor product

Let `k` be an algebraically closed field and let `A` and `B` be strictly henselian local
`k`-algebras with residue field `k`. Localizing `A ⊗[k] B` at the maximal ideal induced by the
two residue maps and strictly henselizing, the minimal primes of the result are classified by
contraction to `A` and to `B`: they correspond bijectively to pairs of a minimal prime of `A` and
a minimal prime of `B`.

## Main results

* `minimalPrimes_strictHenselization_tensorProduct_bijOn` (Stacks 06DU): the bijection between
  the minimal primes of the strict henselization of `(A ⊗[k] B)` at the induced maximal ideal
  and the pairs of minimal primes of `A` and `B`, given by contraction along the two canonical
  maps, together with `map_isPrime_of_mem_minimalPrimes_localized_tensorProduct` and
  `minimalPrimes_localized_tensorProduct_eq_sup`: a minimal prime of that strict henselization
  is the ideal generated by the images of its two contractions, hence the smallest prime
  containing them.

## Implementation notes

The identification of the residue field of each local `k`-algebra with `k` is represented by a
`k`-algebra map to `k` whose kernel is the maximal ideal. The inverse image of the non-zero
elements of `k` under the induced map `A ⊗[k] B → k` is the localization submonoid; its
complement is exactly the ideal `m_A ⊗[k] B + A ⊗[k] m_B`. Henselizations and strict
henselizations are represented abstractly by `IsLocalRing.IsHenselization`, so no particular
construction is chosen. Normality along an ind-étale algebra is transported across universes by
`isNormalRing_of_indEtale`. Tag 06DU is stated in full generality.

Flatness of a henselization over its base is taken from
`StacksFrontier.RingTheory.Branches.Henselization` (`flat_of_isHenselization`).

The two facts about minimal primes under flat and faithfully flat maps used here and in
`StacksFrontier.RingTheory.Branches.Miscellaneous.SmoothInvariance` are kept in the section
`MinimalPrimesFlat`; the equality of the numbers of minimal primes along a faithfully flat map
with injective contraction on minimal primes, used for Tag 0DQ1, is proved at the end of this
file because it rests on them.

## References

* [The Stacks Project, Tag 06DU](https://stacks.math.columbia.edu/tag/06DU)
-/

universe u v w uA uB uC uN vA vB

section MinimalPrimesFlat

/-- Contraction along a flat algebra map carries minimal primes to minimal primes. -/
@[ega "IV 4.7.2" "more general"]
private theorem comap_mem_minimalPrimes_of_flat (R S : Type*) [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] (q : Ideal S) (hq : q ∈ minimalPrimes S) :
    Ideal.comap (algebraMap R S) q ∈ minimalPrimes R := by
  have hgd : Algebra.HasGoingDown R S := Algebra.HasGoingDown.of_flat
  have hQprime : q.IsPrime := hq.isPrime
  set p : Ideal R := q.comap (algebraMap R S) with hpdef
  have hpprime : p.IsPrime := Ideal.IsPrime.comap _
  change Minimal (fun r : Ideal R ↦ r.IsPrime ∧ (⊥ : Ideal R) ≤ r) p
  refine ⟨⟨hpprime, bot_le⟩, fun p₀ hp₀ hp₀le ↦ ?_⟩
  by_contra hnle
  have hlt : p₀ < p := lt_of_le_of_ne hp₀le (fun h ↦ hnle (h ▸ le_refl _))
  have : p₀.IsPrime := hp₀.1
  have hunder : Ideal.under R q = p := by
    change q.comap (algebraMap R S) = p
    exact hpdef.symm
  have hlt' : p₀ < Ideal.under R q := by rw [hunder]; exact hlt
  obtain ⟨P, hPle, hPp, hPlies⟩ := hgd.exists_ideal_le_liesOver_of_lt q hlt'
  have hQP : q ≤ P := hq.right ⟨hPp, bot_le⟩ hPle
  have hcle : p ≤ P.comap (algebraMap R S) := by rw [hpdef]; exact Ideal.comap_mono hQP
  have hPunder : p₀ = P.comap (algebraMap R S) := by
    have := hPlies.over
    rwa [Ideal.under_def] at this
  rw [← hPunder] at hcle
  exact hnle hcle

/-- Every minimal prime of the base is the contraction of a minimal prime of a faithfully flat
algebra over it. -/
private theorem surjOn_minimalPrimes_comap (R S : Type*) [CommRing R] [CommRing S]
    [Algebra R S] [Module.FaithfullyFlat R S] :
    Set.SurjOn (Ideal.comap (algebraMap R S)) (minimalPrimes S) (minimalPrimes R) := by
  intro p hp
  obtain ⟨P, hP⟩ :=
    (PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := S)) ⟨p, hp.isPrime⟩
  have hPas := congrArg PrimeSpectrum.asIdeal hP
  change Ideal.comap (algebraMap R S) P.asIdeal = p at hPas
  obtain ⟨q, hq, hqP⟩ := Ideal.exists_minimalPrimes_le
    (I := (⊥ : Ideal S)) (J := P.asIdeal) bot_le
  refine ⟨q, hq, ?_⟩
  have hle : Ideal.comap (algebraMap R S) q ≤ p := hPas ▸ Ideal.comap_mono hqP
  exact le_antisymm hle (hp.2 ⟨hq.isPrime.comap _, bot_le⟩ hle)

end MinimalPrimesFlat


section StrictHenselizationTensorProduct

open scoped TensorProduct

/-- A domain over an algebraically closed field is geometrically integral. -/
private theorem geometricallyIntegral_of_isAlgClosed
    (k S : Type u) [Field k] [IsAlgClosed k]
    [CommRing S] [IsDomain S] [Algebra k S] :
    Algebra.IsGeometricallyIntegral k S := by
  have he : Function.Bijective (algebraMap k (AlgebraicClosure k)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : k ≃ₐ[k] AlgebraicClosure k :=
    AlgEquiv.ofBijective (Algebra.ofId k (AlgebraicClosure k)) he
  have h : IsDomain (S ⊗[k] AlgebraicClosure k) := by
    let f : S ⊗[k] AlgebraicClosure k ≃ₐ[k] S :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl) e.symm).trans
        (Algebra.TensorProduct.rid k k S)
    exact Function.Injective.isDomain f.toRingHom f.injective
  exact ((Algebra.isGeometricallyIntegral_tfae k S).out 4 1).mp h

/-- The tensor product of two domains over an algebraically closed field is a domain. -/
private theorem isDomain_tensorProduct_of_isAlgClosed
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [IsDomain A] [Algebra k A]
    [CommRing B] [IsDomain B] [Algebra k B] :
    IsDomain (A ⊗[k] B) := by
  let : Algebra.IsGeometricallyIntegral k B := geometricallyIntegral_of_isAlgClosed k B
  exact Algebra.IsGeometricallyIntegral.isDomain_tensorProduct k A B

/-- Quotienting both factors by prime ideals gives a prime ideal in their tensor product. -/
private theorem quotient_tensor_kernel_isPrime
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime] :
    (RingHom.ker
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
        (Ideal.Quotient.mkₐ k q)).toRingHom).IsPrime := by
  let : IsDomain (A ⧸ p) := Ideal.Quotient.isDomain p
  let : IsDomain (B ⧸ q) := Ideal.Quotient.isDomain q
  let : IsDomain ((A ⧸ p) ⊗[k] (B ⧸ q)) :=
    isDomain_tensorProduct_of_isAlgClosed k (A ⧸ p) (B ⧸ q)
  exact RingHom.ker_isPrime _

/-- The kernel of the tensor product of the two quotient maps is generated by the two prime
ideals. -/
private theorem quotient_tensor_kernel_eq
    (k A B : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (p : Ideal A) (q : Ideal B) :
    RingHom.ker
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
        (Ideal.Quotient.mkₐ k q)) =
      p.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B) ⊔
      q.map (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B) := by
  have hp : RingHom.ker (Ideal.Quotient.mkₐ k p) = p := by
    rw [← RingHom.ker_coe_toRingHom]
    exact Ideal.Quotient.mkₐ_ker k p
  have hq : RingHom.ker (Ideal.Quotient.mkₐ k q) = q := by
    rw [← RingHom.ker_coe_toRingHom]
    exact Ideal.Quotient.mkₐ_ker k q
  rw [Algebra.TensorProduct.map_ker _ _
    (Ideal.Quotient.mkₐ_surjective k p) (Ideal.Quotient.mkₐ_surjective k q), hp, hq]

/-- The quotient-tensor kernel contracts to the chosen ideal in the left factor. -/
private theorem quotient_tensor_kernel_comap_left
    (k A B : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (p : Ideal A) (q : Ideal B) [q.IsPrime] :
    (RingHom.ker
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
        (Ideal.Quotient.mkₐ k q)).toRingHom).comap
        (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom = p := by
  let : Nontrivial (B ⧸ q) := inferInstance
  rw [RingHom.comap_ker]
  change RingHom.ker (((Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
    (Ideal.Quotient.mkₐ k q)).comp Algebra.TensorProduct.includeLeft).toRingHom) = p
  rw [Algebra.TensorProduct.map_comp_includeLeft]
  change RingHom.ker (((Algebra.TensorProduct.includeLeft :
    A ⧸ p →ₐ[k] (A ⧸ p) ⊗[k] (B ⧸ q)).toRingHom).comp
      (Ideal.Quotient.mkₐ k p).toRingHom) = p
  rw [RingHom.ker_comp_of_injective _
    (Algebra.TensorProduct.includeLeft_injective
      (RingHom.injective (algebraMap k (B ⧸ q))))]
  exact Ideal.Quotient.mkₐ_ker k p

/-- The quotient-tensor kernel contracts to the chosen ideal in the right factor. -/
private theorem quotient_tensor_kernel_comap_right
    (k A B : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (p : Ideal A) (q : Ideal B) [p.IsPrime] :
    (RingHom.ker
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
        (Ideal.Quotient.mkₐ k q)).toRingHom).comap
        (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom = q := by
  let : Nontrivial (A ⧸ p) := inferInstance
  rw [RingHom.comap_ker]
  change RingHom.ker (((Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
    (Ideal.Quotient.mkₐ k q)).comp Algebra.TensorProduct.includeRight).toRingHom) = q
  rw [Algebra.TensorProduct.map_comp_includeRight]
  change RingHom.ker (((Algebra.TensorProduct.includeRight :
    B ⧸ q →ₐ[k] (A ⧸ p) ⊗[k] (B ⧸ q)).toRingHom).comp
      (Ideal.Quotient.mkₐ k q).toRingHom) = q
  rw [RingHom.ker_comp_of_injective _
    (Algebra.TensorProduct.includeRight_injective
      (RingHom.injective (algebraMap k (A ⧸ p))))]
  exact Ideal.Quotient.mkₐ_ker k q

/-- The right tensor inclusion is flat over a field. -/
private theorem flat_tensorProduct_right
    (k A B : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B] :
    letI : Algebra B (A ⊗[k] B) := Algebra.TensorProduct.rightAlgebra
    Module.Flat B (A ⊗[k] B) := by
  let : Algebra B (A ⊗[k] B) := Algebra.TensorProduct.rightAlgebra
  exact Module.Flat.of_linearEquiv
    (Algebra.TensorProduct.commRight k B A).symm.toLinearEquiv

/-- Contraction along both tensor inclusions sends minimal primes to pairs of minimal primes. -/
private theorem minimalPrimes_tensorProduct_mapsTo
    (k A B : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B] :
    Set.MapsTo
      (fun q : Ideal (A ⊗[k] B) ↦
        (q.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom,
         q.comap (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom))
      (minimalPrimes (A ⊗[k] B))
      ((minimalPrimes A) ×ˢ (minimalPrimes B)) := by
  intro q hq
  have hleft : q.comap
      (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom ∈
      minimalPrimes A := by
    exact comap_mem_minimalPrimes_of_flat A (A ⊗[k] B) q hq
  have hright : q.comap
      (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom ∈
      minimalPrimes B := by
    let : Algebra B (A ⊗[k] B) := Algebra.TensorProduct.rightAlgebra
    let : Module.Flat B (A ⊗[k] B) := flat_tensorProduct_right k A B
    exact comap_mem_minimalPrimes_of_flat B (A ⊗[k] B) q hq
  exact ⟨hleft, hright⟩

/-- A minimal prime of a tensor product is the kernel of the tensor product of its
two quotient maps. -/
private theorem minimalPrime_tensorProduct_eq_quotient_kernel
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (r : Ideal (A ⊗[k] B)) (hr : r ∈ minimalPrimes (A ⊗[k] B)) :
    r = RingHom.ker
      (Algebra.TensorProduct.map
        (Ideal.Quotient.mkₐ k
          (r.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom))
        (Ideal.Quotient.mkₐ k
          (r.comap
            (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom))).toRingHom := by
  let p := r.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom
  let q := r.comap (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom
  have hpq := minimalPrimes_tensorProduct_mapsTo k A B hr
  let : p.IsPrime := hpq.1.isPrime
  let : q.IsPrime := hpq.2.isPrime
  let K : Ideal (A ⊗[k] B) := RingHom.ker
    (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
      (Ideal.Quotient.mkₐ k q)).toRingHom
  have hK : K.IsPrime := quotient_tensor_kernel_isPrime k A B p q
  have hle : K ≤ r := by
    rw [show K = p.map (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B) ⊔
      q.map (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B) from
        quotient_tensor_kernel_eq k A B p q]
    exact sup_le (Ideal.map_le_iff_le_comap.mpr le_rfl)
      (Ideal.map_le_iff_le_comap.mpr le_rfl)
  exact (((IsMinimalPrime.iff_minimal r).mp hr).eq_of_le hK hle).symm

/-- Minimal primes of a tensor product over an algebraically closed field are classified by
their contractions to the two factors. -/
private theorem minimalPrimes_tensorProduct_bijOn
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B] :
    Set.BijOn
      (fun r : Ideal (A ⊗[k] B) ↦
        (r.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom,
         r.comap (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom))
      (minimalPrimes (A ⊗[k] B))
      ((minimalPrimes A) ×ˢ (minimalPrimes B)) := by
  let f : Ideal (A ⊗[k] B) → Ideal A × Ideal B := fun r ↦
    (r.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom,
     r.comap (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom)
  change Set.BijOn f _ _
  refine ⟨minimalPrimes_tensorProduct_mapsTo k A B, ?_, ?_⟩
  · intro r hr s hs heq
    have hfr := minimalPrime_tensorProduct_eq_quotient_kernel k A B r hr
    have hfs := minimalPrime_tensorProduct_eq_quotient_kernel k A B s hs
    dsimp [f] at heq
    let g : Ideal A × Ideal B → Ideal (A ⊗[k] B) := fun pq ↦
      RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k pq.1)
        (Ideal.Quotient.mkₐ k pq.2)).toRingHom
    exact hfr.trans ((congrArg g heq).trans hfs.symm)
  · rintro ⟨p, q⟩ ⟨hp, hq⟩
    let : p.IsPrime := hp.isPrime
    let : q.IsPrime := hq.isPrime
    let K : Ideal (A ⊗[k] B) := RingHom.ker
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
        (Ideal.Quotient.mkₐ k q)).toRingHom
    have hK : K.IsPrime := quotient_tensor_kernel_isPrime k A B p q
    obtain ⟨r, hr, hrK⟩ := Ideal.exists_minimalPrimes_le (I := ⊥) (J := K) bot_le
    have hpair := minimalPrimes_tensorProduct_mapsTo k A B hr
    have hleft : r.comap
        (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom = p := by
      apply ((IsMinimalPrime.iff_minimal p).mp hp).eq_of_le hpair.1.isPrime
      rw [← quotient_tensor_kernel_comap_left k A B p q]
      exact Ideal.comap_mono hrK
    have hright : r.comap
        (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom = q := by
      apply ((IsMinimalPrime.iff_minimal q).mp hq).eq_of_le hpair.2.isPrime
      rw [← quotient_tensor_kernel_comap_right k A B p q]
      exact Ideal.comap_mono hrK
    exact ⟨r, hr, Prod.ext hleft hright⟩

/-- If every minimal prime avoids the localization submonoid, contraction classifies the
minimal primes of the localization. -/
private theorem minimalPrimes_localization_bijOn
    (S T : Type*) [CommRing S] [CommRing T] [Algebra S T]
    (M : Submonoid S) [IsLocalization M T]
    (hM : ∀ p ∈ minimalPrimes S, Disjoint (M : Set S) p) :
    Set.BijOn (Ideal.comap (algebraMap S T)) (minimalPrimes T) (minimalPrimes S) := by
  let f := algebraMap S T
  have hclass := IsLocalization.minimalPrimes_map M T (⊥ : Ideal S)
  simp only [Ideal.map_bot] at hclass
  refine ⟨?_, ?_, ?_⟩
  · intro q hq
    exact (Set.mem_preimage.mp (hclass ▸ hq))
  · intro q hq r hr heq
    calc
      q = (q.comap f).map f := (IsLocalization.map_under M T q).symm
      _ = (r.comap f).map f := congrArg (fun p : Ideal S => p.map f) heq
      _ = r := IsLocalization.map_under M T r
  · intro p hp
    let : p.IsPrime := hp.isPrime
    refine ⟨p.map f, ?_, ?_⟩
    · change p.map f ∈ (⊥ : Ideal T).minimalPrimes
      rw [hclass]
      change (p.map f).under S ∈ minimalPrimes S
      rw [IsLocalization.under_map_of_isPrime_disjoint M T hp.isPrime (hM p hp)]
      exact hp
    · exact IsLocalization.under_map_of_isPrime_disjoint M T hp.isPrime (hM p hp)

/-- Every minimal prime of a tensor product of local algebras lies under the maximal ideal
induced by the residue maps. -/
private theorem minimalPrime_tensorProduct_le_residue_ker
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [IsLocalRing A] [Algebra k A]
    [CommRing B] [IsLocalRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = IsLocalRing.maximalIdeal A)
    (hresB : RingHom.ker resB.toRingHom = IsLocalRing.maximalIdeal B)
    (r : Ideal (A ⊗[k] B)) (hr : r ∈ minimalPrimes (A ⊗[k] B)) :
    r ≤ RingHom.ker
      (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom := by
  let f : A ⊗[k] B →ₐ[k] k :=
    Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)
  let p := r.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom
  let q := r.comap (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom
  have hpq := minimalPrimes_tensorProduct_mapsTo k A B hr
  let : p.IsPrime := hpq.1.isPrime
  let : q.IsPrime := hpq.2.isPrime
  have hp : p ≤ RingHom.ker resA.toRingHom := by
    rw [hresA]
    exact IsLocalRing.le_maximalIdeal_of_isPrime p
  have hq : q ≤ RingHom.ker resB.toRingHom := by
    rw [hresB]
    exact IsLocalRing.le_maximalIdeal_of_isPrime q
  rw [minimalPrime_tensorProduct_eq_quotient_kernel k A B r hr]
  change RingHom.ker
    (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
      (Ideal.Quotient.mkₐ k q)) ≤ RingHom.ker f.toRingHom
  rw [quotient_tensor_kernel_eq]
  refine sup_le ?_ ?_
  · apply Ideal.map_le_iff_le_comap.mpr
    change p ≤ (RingHom.ker f.toRingHom).comap
      (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom
    rw [RingHom.comap_ker]
    change p ≤ RingHom.ker
      (((f.comp (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B)).toRingHom))
    rw [Algebra.TensorProduct.lift_comp_includeLeft]
    exact hp
  · apply Ideal.map_le_iff_le_comap.mpr
    change q ≤ (RingHom.ker f.toRingHom).comap
      (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom
    rw [RingHom.comap_ker]
    change q ≤ RingHom.ker
      (((f.comp (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B)).toRingHom))
    rw [Algebra.TensorProduct.lift_comp_includeRight']
    exact hq

/-- Contraction classifies the minimal primes of the localization of a tensor product at the
residue maximal ideal. -/
public theorem minimalPrimes_localized_tensorProduct_bijOn
    (k A B R : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [IsLocalRing A] [Algebra k A]
    [CommRing B] [IsLocalRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = IsLocalRing.maximalIdeal A)
    (hresB : RingHom.ker resB.toRingHom = IsLocalRing.maximalIdeal B)
    [CommRing R] [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R] :
    Set.BijOn (Ideal.comap (algebraMap (A ⊗[k] B) R))
      (minimalPrimes R) (minimalPrimes (A ⊗[k] B)) := by
  let f : A ⊗[k] B →ₐ[k] k :=
    Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)
  let M := Submonoid.comap f.toRingHom (nonZeroDivisors k)
  refine minimalPrimes_localization_bijOn (A ⊗[k] B) R M fun p hp ↦
    Set.disjoint_left.mpr fun x hxM hxP ↦ (nonZeroDivisors.ne_zero hxM : f x ≠ 0) ?_
  exact minimalPrime_tensorProduct_le_residue_ker k A B resA resB hresA hresB p hp hxP

/-- Minimal primes of the localized tensor product are classified by contraction to its
factors. -/
public theorem minimalPrimes_localized_tensorProduct_pair_bijOn
    (k A B R : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [IsLocalRing A] [Algebra k A]
    [CommRing B] [IsLocalRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = IsLocalRing.maximalIdeal A)
    (hresB : RingHom.ker resB.toRingHom = IsLocalRing.maximalIdeal B)
    [CommRing R] [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R] :
    Set.BijOn
      (fun r : Ideal R ↦
        (r.comap ((algebraMap (A ⊗[k] B) R).comp
          (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom),
         r.comap ((algebraMap (A ⊗[k] B) R).comp
          (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom)))
      (minimalPrimes R) ((minimalPrimes A) ×ˢ (minimalPrimes B)) := by
  have h := (minimalPrimes_tensorProduct_bijOn k A B).comp
    (minimalPrimes_localized_tensorProduct_bijOn k A B R resA resB hresA hresB)
  simpa only [Function.comp_def, Ideal.comap_comap] using h

/-- The residue map extends across localization at its nonzero fibres. -/
private noncomputable def localizedTensor_residueMap
    (k A B R : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    [CommRing R] [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R] : R →+* k :=
  let f := (Algebra.TensorProduct.lift resA resB
    (fun _ _ ↦ Commute.all _ _)).toRingHom
  IsLocalization.lift (M := Submonoid.comap f (nonZeroDivisors k)) (g := f) (fun y ↦
    isUnit_iff_ne_zero.mpr (nonZeroDivisors.ne_zero
      (show f y ∈ nonZeroDivisors k from y.property)))

/-- Uniqueness of the minimal prime after quotienting by each extended source minimal prime
implies injectivity of contraction. -/
private theorem minimalPrimes_comap_injOn_of_quotient_unique
    (S T : Type*) [CommRing S] [CommRing T] [Algebra S T] [Module.Flat S T]
    (hunique : ∀ p ∈ minimalPrimes S,
      ∃! q : Ideal (T ⧸ p.map (algebraMap S T)),
        q ∈ minimalPrimes (T ⧸ p.map (algebraMap S T))) :
    Set.InjOn (Ideal.comap (algebraMap S T)) (minimalPrimes T) := by
  intro q hq q' hq' hcomp
  let p := q.comap (algebraMap S T)
  have hp : p ∈ minimalPrimes S := comap_mem_minimalPrimes_of_flat S T q hq
  let I := p.map (algebraMap S T)
  have hIq : I ≤ q := Ideal.map_le_iff_le_comap.mpr le_rfl
  have hIq' : I ≤ q' := Ideal.map_le_iff_le_comap.mpr (by simpa [p] using hcomp.le)
  have hqI : q ∈ I.minimalPrimes :=
    ⟨⟨hq.isPrime, hIq⟩, fun r hr hrq => hq.2 ⟨hr.1, bot_le⟩ hrq⟩
  have hq'I : q' ∈ I.minimalPrimes :=
    ⟨⟨hq'.isPrime, hIq'⟩, fun r hr hrq => hq'.2 ⟨hr.1, bot_le⟩ hrq⟩
  rw [Ideal.minimalPrimes_eq_comap] at hqI hq'I
  obtain ⟨Q, hQ, hQeq⟩ := hqI
  obtain ⟨Q', hQ', hQ'eq⟩ := hq'I
  have heq : Q = Q' := (hunique p hp).unique hQ hQ'
  exact hQeq.symm.trans ((congrArg (Ideal.comap (Ideal.Quotient.mk I)) heq).trans hQ'eq)

/-- The only additional input needed for a bijection on minimal primes of a faithfully flat
extension is uniqueness of the minimal prime in each minimal-prime quotient. -/
private theorem minimalPrimes_comap_bijOn_of_quotient_unique
    (S T : Type*) [CommRing S] [CommRing T] [Algebra S T]
    [Module.FaithfullyFlat S T]
    (hunique : ∀ p ∈ minimalPrimes S,
      ∃! q : Ideal (T ⧸ p.map (algebraMap S T)),
        q ∈ minimalPrimes (T ⧸ p.map (algebraMap S T))) :
    Set.BijOn (Ideal.comap (algebraMap S T)) (minimalPrimes T) (minimalPrimes S) := by
  refine ⟨?_, minimalPrimes_comap_injOn_of_quotient_unique S T hunique, ?_⟩
  · intro q hq
    exact comap_mem_minimalPrimes_of_flat S T q hq
  · exact surjOn_minimalPrimes_comap S T


section Colimits

open CategoryTheory CategoryTheory.Limits

private theorem isGeometricallyNormal_of_isAlgClosed
    (k N : Type u) [Field k] [IsAlgClosed k] [CommRing N] [Algebra k N]
    (hN : IsNormalRing N) : Algebra.IsGeometricallyNormal k N := by
  obtain ⟨p, hp⟩ := ExpChar.exists k
  let : ExpChar k p := hp
  let : PerfectRing k p := PerfectField.toPerfectRing p
  have h : IsNormalRing (k ⊗[k] N) :=
    IsNormalRing.congr (Algebra.TensorProduct.lid k N).toRingEquiv.symm hN
  exact ⟨((Algebra.isNormalRing_tensorProduct_tfae k p N k).out 4 1).mp h⟩

/-- Normality ascends along an ind-étale algebra, with the base and the algebra in independent
universes: the statement is transported to the fully lifted algebra, where the two universes
coincide. -/
private theorem isNormalRing_of_indEtale (R : Type u) (S : Type v)
    [CommRing R] [CommRing S] [Algebra R S]
    (hR : IsNormalRing R) (hS : StacksDraft.IndEtale R S) : IsNormalRing S := by
  let : Algebra (ULift.{v} R) (ULift.{u} S) := ULift.algebra' R _
  have h : StacksDraft.IndEtale (ULift.{v} R) (ULift.{u} S) :=
    StacksDraft.indEtale_of_equiv ULift.ringEquiv.symm ULift.ringEquiv.symm (fun _ => rfl) hS
  exact IsNormalRing.congr (ULift.ringEquiv : ULift.{u} S ≃+* S)
    (isNormalRing_of_ind_etale (ULift.{v} R) (ULift.{u} S)
      (IsNormalRing.congr (ULift.ringEquiv.symm : R ≃+* ULift.{v} R) hR)
      (StacksDraft.indEtale_iff.mp h))

/-- A henselization is ind-étale, so base changing a normal ring along it stays normal. The base,
the henselization and the normal ring have independent universes. -/
@[ega "IV 18.6.9" "(i), special case"]
theorem isNormalRing_baseChange_henselization
    (D : Type u) (C : Type v) (N : Type w)
    [CommRing D] [IsLocalRing D] [CommRing C] [IsLocalRing C]
    [CommRing N] [Algebra D C] [Algebra D N]
    (L : Type*) [Field L] [Algebra (IsLocalRing.ResidueField D) L]
    [IsLocalRing.IsHenselization D L C]
    (hN : IsNormalRing N) : IsNormalRing (C ⊗[D] N) := by
  let : Algebra C (N ⊗[D] C) := Algebra.TensorProduct.rightAlgebra
  have h : StacksDraft.IndEtale N (N ⊗[D] C) :=
    StacksDraft.indEtale_tensorProduct N
      (StacksDraft.indEtale_of_isHenselization (R := D) L (Rh := C))
  exact IsNormalRing.congr (Algebra.TensorProduct.comm D N C).toRingEquiv
    (isNormalRing_of_indEtale N (N ⊗[D] C) hN h)

private theorem isNormalRing_baseChange_localized_henselization
    (D R C N : Type u) [CommRing D] [CommRing R] [IsLocalRing R]
    [CommRing C] [IsLocalRing C] [CommRing N]
    [Algebra D R] [Algebra R C] [Algebra D C] [IsScalarTower D R C]
    [Algebra D N] (M : Submonoid D) [IsLocalization M R]
    (L : Type v) [Field L] [Algebra (IsLocalRing.ResidueField R) L]
    [IsLocalRing.IsHenselization R L C]
    (hN : IsNormalRing N) : IsNormalRing (C ⊗[D] N) := by
  have hNR : IsNormalRing (R ⊗[D] N) :=
    IsNormalRing.congr (Algebra.TensorProduct.comm D N R).toRingEquiv
      (hN.isLocalization (Algebra.algebraMapSubmonoid N M) (N ⊗[D] R))
  exact IsNormalRing.congr
    (Algebra.TensorProduct.cancelBaseChange D R C C N).toRingEquiv
    (isNormalRing_baseChange_henselization R C (R ⊗[D] N) L hNR)

end Colimits

section TensorNormalization

open IsLocalRing

attribute [local instance] Algebra.TensorProduct.rightAlgebra

private theorem isLocalRing_tensor_baseChange
    (k A B C NA NB : Type u) [CommRing k] [CommRing A] [CommRing B]
    [CommRing C] [CommRing NA] [CommRing NB]
    [Algebra k A] [Algebra k B] [Algebra k C] [Algebra k NA] [Algebra k NB]
    [Algebra A NA] [Algebra B NB] [IsScalarTower k A NA] [IsScalarTower k B NB]
    [Algebra A C] [Algebra B C] [IsScalarTower k A C] [IsScalarTower k B C]
    [Algebra (A ⊗[k] B) C] [IsScalarTower A (A ⊗[k] B) C]
    [IsScalarTower B (A ⊗[k] B) C] [IsScalarTower k (A ⊗[k] B) C]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing C] [IsLocalRing NA] [IsLocalRing NB]
    [IsLocalHom (algebraMap A C)] [IsLocalHom (algebraMap B C)]
    [IsLocalHom (algebraMap A NA)] [IsLocalHom (algebraMap B NB)]
    [Algebra.IsIntegral A NA] [Algebra.IsIntegral B NB]
    (hNA : (ResidueField.map (algebraMap A NA)).IsPurelyInseparable)
    (hNB : (ResidueField.map (algebraMap B NB)).IsPurelyInseparable) :
    letI : Algebra (A ⊗[k] B) (NA ⊗[k] NB) :=
      (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA)
        (IsScalarTower.toAlgHom k B NB)).toRingHom.toAlgebra
    IsLocalRing (C ⊗[A ⊗[k] B] (NA ⊗[k] NB)) := by
  let D := A ⊗[k] B
  let Y := NA ⊗[k] B
  let N := NA ⊗[k] NB
  let : Algebra D Y := (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA)
    (AlgHom.id k B)).toRingHom.toAlgebra
  let : Algebra D N := (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA)
    (IsScalarTower.toAlgHom k B NB)).toRingHom.toAlgebra
  let : Algebra Y N := (Algebra.TensorProduct.map (AlgHom.id k NA)
    (IsScalarTower.toAlgHom k B NB)).toRingHom.toAlgebra
  let : Algebra B N := ((algebraMap NB N).comp (algebraMap B NB)).toAlgebra
  have : IsScalarTower A D Y := IsScalarTower.of_algebraMap_eq fun x => by
    simp [D, Y, RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
  have : IsScalarTower k D Y := IsScalarTower.of_algebraMap_eq fun x => by
    simp [D, Y, RingHom.algebraMap_toAlgebra]
  have : IsScalarTower B D Y := IsScalarTower.of_algebraMap_eq fun x => by
    simp [D, Y, RingHom.algebraMap_toAlgebra]
  have : IsScalarTower B Y N := IsScalarTower.of_algebraMap_eq fun x => by
    simp [Y, N, RingHom.algebraMap_toAlgebra]
  have : IsScalarTower B NB N := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower k B N := IsScalarTower.of_algebraMap_eq fun x => by
    simp [N, RingHom.algebraMap_toAlgebra, ← IsScalarTower.algebraMap_apply k B NB]
  have : IsScalarTower k Y N := IsScalarTower.of_algebraMap_eq fun x => by
    simp [Y, N, RingHom.algebraMap_toAlgebra]
  have : IsScalarTower NA Y N := IsScalarTower.of_algebraMap_eq fun x => by
    simp [Y, N, RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
  have : IsScalarTower D Y N := IsScalarTower.of_algebraMap_eq fun x => by
    change (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA)
      (IsScalarTower.toAlgHom k B NB)) x =
      (Algebra.TensorProduct.map (AlgHom.id k NA) (IsScalarTower.toAlgHom k B NB))
        ((Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA) (AlgHom.id k B)) x)
    simp only [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp,
      AlgHom.id_comp, AlgHom.comp_id]
  have : Algebra.IsPushout A NA D Y :=
    Algebra.IsPushout.tensorProduct_tensorProduct k B A NA (by
      ext b
      simp [RingHom.algebraMap_toAlgebra])
  have : Algebra.IsPushout B NB Y N :=
    (Algebra.IsPushout.comp_iff (R := k) (S := B) (T := NB)
      (R' := NA) (S' := Y) (T' := N)).mp inferInstance
  let X := Y ⊗[D] C
  have : IsScalarTower B C X := IsScalarTower.of_algebraMap_eq fun b => by
    rw [IsScalarTower.algebraMap_apply B D C]
    exact (IsScalarTower.algebraMap_apply B D X b).trans
      (IsScalarTower.algebraMap_apply D C X (algebraMap B D b))
  let e := Algebra.IsPushout.cancelBaseChangeAlg A NA D Y C
  have : IsLocalRing (C ⊗[A] NA) := (isLocalRing_tensorProduct_of_isIntegral A C NA (Or.inl hNA)).1
  have : IsLocalRing (NA ⊗[A] C) := (Algebra.TensorProduct.comm A C NA).toRingEquiv.isLocalRing
  have : IsLocalRing X := e.symm.toRingEquiv.isLocalRing
  have : Algebra.IsIntegral D Y :=
    Algebra.IsPushout.isIntegral (R := A) (S := NA) (A := D) (SA := Y)
  have : Algebra.IsIntegral C X :=
    Algebra.IsPushout.isIntegral (R := D) (S := Y) (A := C) (SA := X)
  have : IsLocalHom (algebraMap C X) := Stacks.LocalHom.isLocalHom_of_isIntegral C X
  have : IsLocalHom (algebraMap B X) := by
    rw [IsScalarTower.algebraMap_eq B C X]
    infer_instance
  have : IsLocalRing (X ⊗[B] NB) := (isLocalRing_tensorProduct_of_isIntegral B X NB (Or.inl hNB)).1
  have : IsLocalRing (NB ⊗[B] X) := (Algebra.TensorProduct.comm B X NB).toRingEquiv.isLocalRing
  let f := Algebra.IsPushout.cancelBaseChangeAlg B NB Y N X
  have : IsLocalRing (N ⊗[Y] X) := f.symm.toRingEquiv.isLocalRing
  let g := Algebra.TensorProduct.cancelBaseChange D Y N N C
  have : IsLocalRing (N ⊗[D] C) := g.toRingEquiv.isLocalRing
  exact (Algebra.TensorProduct.comm D N C).toRingEquiv.isLocalRing

private theorem isLocalHom_of_ker_residue
    {k S T : Type*} [Field k] [CommRing S] [IsLocalRing S] [CommRing T]
    (f : S →+* T) (g : T →+* k) (res : S →+* k)
    (hres : RingHom.ker res = IsLocalRing.maximalIdeal S) (hcomp : g.comp f = res) :
    IsLocalHom f := by
  have : IsLocalHom res := by
    apply ((IsLocalRing.local_hom_TFAE res).out 4 1).mp
    intro x hx
    have hx0 : res x = 0 := by
      change x ∈ RingHom.ker res
      rwa [hres]
    change res x ∈ IsLocalRing.maximalIdeal k
    simp [hx0]
  have : IsLocalHom (g.comp f) := hcomp.symm ▸ inferInstance
  exact isLocalHom_of_comp f g

private theorem localizedTensor_residueMap_comp
    (k A B R : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    [CommRing R] [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R] :
    (localizedTensor_residueMap k A B R resA resB).comp (algebraMap (A ⊗[k] B) R) =
      (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom := by
  let f := (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
  dsimp [localizedTensor_residueMap]
  exact IsLocalization.lift_comp (M := Submonoid.comap f (nonZeroDivisors k)) (g := f)
    (fun y ↦ isUnit_iff_ne_zero.mpr (nonZeroDivisors.ne_zero
      (show f y ∈ nonZeroDivisors k from y.property)))

private theorem localizedTensor_isLocalHom_left
    (k A B R : Type u) [Field k]
    [CommRing A] [IsLocalRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = IsLocalRing.maximalIdeal A)
    [CommRing R] [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R] :
    IsLocalHom ((algebraMap (A ⊗[k] B) R).comp
      (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom) := by
  apply isLocalHom_of_ker_residue _ (localizedTensor_residueMap k A B R resA resB)
    resA.toRingHom hresA
  rw [← RingHom.comp_assoc, localizedTensor_residueMap_comp]
  ext a
  change (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _))
    (a ⊗ₜ[k] (1 : B)) = resA a
  simp

private theorem localizedTensor_isLocalHom_right
    (k A B R : Type u) [Field k]
    [CommRing A] [Algebra k A] [CommRing B] [IsLocalRing B] [Algebra k B]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresB : RingHom.ker resB.toRingHom = IsLocalRing.maximalIdeal B)
    [CommRing R] [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R] :
    IsLocalHom ((algebraMap (A ⊗[k] B) R).comp
      (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom) := by
  apply isLocalHom_of_ker_residue _ (localizedTensor_residueMap k A B R resA resB)
    resB.toRingHom hresB
  rw [← RingHom.comp_assoc, localizedTensor_residueMap_comp]
  ext b
  change (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _))
    ((1 : A) ⊗ₜ[k] b) = resB b
  simp

/-- Normalizing the prime quotients does not change the tensor quotient kernel. -/
private theorem normalization_tensor_kernel
    (k A B : Type u) [Field k] [CommRing A] [Algebra k A]
    [CommRing B] [Algebra k B] (p : Ideal A) (q : Ideal B)
    [p.IsPrime] [q.IsPrime] :
    RingHom.ker (Algebra.TensorProduct.map
      (IsScalarTower.toAlgHom k A (integralClosure (A ⧸ p) (FractionRing (A ⧸ p))))
      (IsScalarTower.toAlgHom k B (integralClosure (B ⧸ q) (FractionRing (B ⧸ q))))) =
    RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p)
      (Ideal.Quotient.mkₐ k q)) := by
  let NA := integralClosure (A ⧸ p) (FractionRing (A ⧸ p))
  let NB := integralClosure (B ⧸ q) (FractionRing (B ⧸ q))
  let f := IsScalarTower.toAlgHom k (A ⧸ p) NA
  let g := IsScalarTower.toAlgHom k (B ⧸ q) NB
  have hf : Function.Injective f := FaithfulSMul.algebraMap_injective (A ⧸ p) NA
  have hg : Function.Injective g := FaithfulSMul.algebraMap_injective (B ⧸ q) NB
  have : Module.Flat k NA := Module.Flat.of_free
  have : Module.Flat k (B ⧸ q) := Module.Flat.of_free
  have hi : Function.Injective (Algebra.TensorProduct.map f g) :=
    TensorProduct.map_injective_of_flat_flat f.toLinearMap g.toLinearMap hf hg
  have hcomp : (Algebra.TensorProduct.map f g).comp
      (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k p) (Ideal.Quotient.mkₐ k q)) =
      Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA)
        (IsScalarTower.toAlgHom k B NB) := by
    rw [← Algebra.TensorProduct.map_comp]
    rfl
  change RingHom.ker (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k A NA)
    (IsScalarTower.toAlgHom k B NB)).toRingHom = _
  rw [← hcomp]
  exact RingHom.ker_comp_of_injective _ hi

/-- The integral closure of a domain in its fraction ring is a normal ring. -/
private theorem isNormalRing_integralClosure_fractionRing (S : Type*) [CommRing S] [IsDomain S] :
    IsNormalRing (integralClosure S (FractionRing S)) := by
  have : IsIntegrallyClosed (integralClosure S (FractionRing S)) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing S)
  exact fun q _ =>
    ⟨IsLocalization.isDomain_of_local_atPrime ‹q.IsPrime›,
      isIntegrallyClosed_of_isLocalization (S := Localization.AtPrime q)
        (M := q.primeCompl) q.primeCompl_le_nonZeroDivisors⟩

/-- **The ideal generated by a minimal prime in the strict henselization stays prime.** Let
`R` be the localization of `A ⊗[k] B` at the maximal ideal induced by the two residue maps and
let `C` be a strict henselization of `R`.  The ideal generated in `C` by a minimal prime of `R`
is prime: after base change to the normalization of the corresponding minimal prime of
`A ⊗[k] B` it becomes the kernel of a map to a domain. -/
theorem map_isPrime_of_mem_minimalPrimes_localized_tensorProduct
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [HenselianLocalRing A] [IsSepClosed (ResidueField A)]
    [CommRing B] [Algebra k B] [HenselianLocalRing B] [IsSepClosed (ResidueField B)]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = maximalIdeal A)
    (hresB : RingHom.ker resB.toRingHom = maximalIdeal B)
    (R C : Type u) [CommRing R] [IsLocalRing R] [CommRing C] [IsLocalRing C]
    [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R]
    [Algebra R C]
    (ksep : Type v) [Field ksep] [Algebra (ResidueField R) ksep]
    [IsSepClosure (ResidueField R) ksep]
    [IsLocalRing.IsHenselization R ksep C]
    (p : Ideal R) (hp : p ∈ minimalPrimes R) :
    (p.map (algebraMap R C)).IsPrime := by
  classical
  let D := A ⊗[k] B
  let M := Submonoid.comap
    (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
    (nonZeroDivisors k)
  let : Algebra D C := ((algebraMap R C).comp (algebraMap D R)).toAlgebra
  have : IsScalarTower D R C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : Algebra k C := ((algebraMap D C).comp (algebraMap k D)).toAlgebra
  let : Algebra A C := ((algebraMap D C).comp (algebraMap A D)).toAlgebra
  let : Algebra B C := ((algebraMap D C).comp (algebraMap B D)).toAlgebra
  have : IsScalarTower k D C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A D C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower B D C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower k A C := IsScalarTower.to₁₂₄ k A D C
  have : IsScalarTower k B C := IsScalarTower.to₁₂₄ k B D C
  have : IsLocalHom (algebraMap R C) :=
    IsLocalRing.IsHenselization.isLocalHom (L := ksep)
  have : IsLocalHom ((algebraMap D R).comp (algebraMap A D)) :=
    localizedTensor_isLocalHom_left k A B R resA resB hresA
  have : IsLocalHom ((algebraMap D R).comp (algebraMap B D)) :=
    localizedTensor_isLocalHom_right k A B R resA resB hresB
  have : IsLocalHom (algebraMap A C) :=
    inferInstanceAs (IsLocalHom ((algebraMap R C).comp
      ((algebraMap D R).comp (algebraMap A D))))
  have : IsLocalHom (algebraMap B C) :=
    inferInstanceAs (IsLocalHom ((algebraMap R C).comp
      ((algebraMap D R).comp (algebraMap B D))))
  have : Module.Flat R C := flat_of_isHenselization (L := ksep)
  have : Module.FaithfullyFlat R C := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have : Module.Flat D R := IsLocalization.flat R M
  have : Module.Flat D C := Module.Flat.trans D R C
  let r := p.comap (algebraMap D R)
  have hr : r ∈ minimalPrimes D :=
    (minimalPrimes_localized_tensorProduct_bijOn k A B R resA resB hresA hresB).mapsTo hp
  let pA := r.comap (Algebra.TensorProduct.includeLeft : A →ₐ[k] D).toRingHom
  let pB := r.comap (Algebra.TensorProduct.includeRight : B →ₐ[k] D).toRingHom
  have hpAB := minimalPrimes_tensorProduct_mapsTo k A B hr
  have : pA.IsPrime := hpAB.1.isPrime
  have : pB.IsPrime := hpAB.2.isPrime
  let NA := integralClosure (A ⧸ pA) (FractionRing (A ⧸ pA))
  let NB := integralClosure (B ⧸ pB) (FractionRing (B ⧸ pB))
  have : Algebra.IsIntegral A NA := Algebra.IsIntegral.trans (A ⧸ pA)
  have : Algebra.IsIntegral B NB := Algebra.IsIntegral.trans (B ⧸ pB)
  obtain ⟨hNA, hlocalA, hsepA⟩ :=
    RingHom.exists_henselianLocalRing_of_isIntegral_of_isDomain
      (algebraMap A NA) (Algebra.IsIntegral.isIntegral (R := A))
  obtain ⟨hNB, hlocalB, hsepB⟩ :=
    RingHom.exists_henselianLocalRing_of_isIntegral_of_isDomain
      (algebraMap B NB) (Algebra.IsIntegral.isIntegral (R := B))
  let : HenselianLocalRing NA := hNA
  let : HenselianLocalRing NB := hNB
  have : IsLocalHom (algebraMap A NA) := hlocalA
  have : IsLocalHom (algebraMap B NB) := hlocalB
  have hNAins := (hsepA inferInstance).2
  have hNBins := (hsepB inferInstance).2
  have hNAnormal : IsNormalRing NA := isNormalRing_integralClosure_fractionRing (A ⧸ pA)
  have hNBnormal : IsNormalRing NB := isNormalRing_integralClosure_fractionRing (B ⧸ pB)
  have : Algebra.IsGeometricallyNormal k NA :=
    isGeometricallyNormal_of_isAlgClosed k NA hNAnormal
  let N := NA ⊗[k] NB
  have hN : IsNormalRing N :=
    Algebra.IsGeometricallyNormal.isNormalRing_tensorProduct_of_isNormalRing k NA NB hNBnormal
  let : Algebra D N := (Algebra.TensorProduct.map
    (IsScalarTower.toAlgHom k A NA) (IsScalarTower.toAlgHom k B NB)).toRingHom.toAlgebra
  have hnormal : IsNormalRing (C ⊗[D] N) :=
    isNormalRing_baseChange_localized_henselization D R C N M ksep hN
  have : IsLocalRing (C ⊗[D] N) :=
    isLocalRing_tensor_baseChange k A B C NA NB hNAins hNBins
  have : IsDomain (C ⊗[D] N) := hnormal.of_isLocalRing.1
  have hker : RingHom.ker (algebraMap D N) = r :=
    (normalization_tensor_kernel k A B pA pB).trans
      (minimalPrime_tensorProduct_eq_quotient_kernel k A B r hr).symm
  have hext : RingHom.ker (algebraMap C (C ⊗[D] N)) =
      p.map (algebraMap R C) := by
    rw [Algebra.ker_algebraMap_tensorProduct_left D C N, hker, IsScalarTower.algebraMap_eq D R C,
      ← Ideal.map_map]
    rw [show r.map (algebraMap D R) = p from IsLocalization.map_under M R p]
  exact hext ▸ RingHom.ker_isPrime (algebraMap C (C ⊗[D] N))

/-- The minimal primes of the strict henselization of the localization of `A ⊗[k] B` at the
maximal ideal induced by the residue maps correspond bijectively, by contraction, to pairs of
minimal primes of `A` and `B`. -/
@[stacks 06DU]
theorem minimalPrimes_strictHenselization_tensorProduct_bijOn
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [HenselianLocalRing A] [IsSepClosed (ResidueField A)]
    [CommRing B] [Algebra k B] [HenselianLocalRing B] [IsSepClosed (ResidueField B)]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = maximalIdeal A)
    (hresB : RingHom.ker resB.toRingHom = maximalIdeal B)
    (R C : Type u) [CommRing R] [IsLocalRing R] [CommRing C] [IsLocalRing C]
    [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R]
    [Algebra R C]
    (ksep : Type v) [Field ksep] [Algebra (ResidueField R) ksep]
    [IsSepClosure (ResidueField R) ksep]
    [IsLocalRing.IsHenselization R ksep C] :
    Set.BijOn
      (fun q : Ideal C ↦
        (q.comap ((algebraMap R C).comp
          ((algebraMap (A ⊗[k] B) R).comp
            (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom)),
         q.comap ((algebraMap R C).comp
          ((algebraMap (A ⊗[k] B) R).comp
            (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom))))
      (minimalPrimes C) ((minimalPrimes A) ×ˢ (minimalPrimes B)) := by
  classical
  have : IsLocalHom (algebraMap R C) :=
    IsLocalRing.IsHenselization.isLocalHom (L := ksep)
  have : Module.Flat R C := flat_of_isHenselization (L := ksep)
  have : Module.FaithfullyFlat R C := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hgeom : ∀ p ∈ minimalPrimes R,
      ∃! q : Ideal (C ⧸ p.map (algebraMap R C)),
        q ∈ minimalPrimes (C ⧸ p.map (algebraMap R C)) := by
    intro p hp
    have : (p.map (algebraMap R C)).IsPrime :=
      map_isPrime_of_mem_minimalPrimes_localized_tensorProduct k A B resA resB hresA hresB
        R C ksep p hp
    have : IsDomain (C ⧸ p.map (algebraMap R C)) := Ideal.Quotient.isDomain _
    simp only [IsDomain.minimalPrimes_eq_singleton_bot, Set.mem_singleton_iff]
    exact existsUnique_eq
  have h := (minimalPrimes_localized_tensorProduct_pair_bijOn
    k A B R resA resB hresA hresB).comp
      (minimalPrimes_comap_bijOn_of_quotient_unique R C hgeom)
  simpa only [Function.comp_def, Ideal.comap_comap] using h


/-- **A minimal prime of the strict henselization is generated by its two contractions.** Let
`R` be the localization of `A ⊗[k] B` at the maximal ideal induced by the two residue maps and
let `C` be a strict henselization of `R`.  A minimal prime `q` of `C` is the ideal generated by
the images of its contractions to `A` and to `B`; in particular it is the smallest prime of `C`
containing those two images. -/
theorem minimalPrimes_localized_tensorProduct_eq_sup
    (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [Algebra k A] [HenselianLocalRing A] [IsSepClosed (ResidueField A)]
    [CommRing B] [Algebra k B] [HenselianLocalRing B] [IsSepClosed (ResidueField B)]
    (resA : A →ₐ[k] k) (resB : B →ₐ[k] k)
    (hresA : RingHom.ker resA.toRingHom = maximalIdeal A)
    (hresB : RingHom.ker resB.toRingHom = maximalIdeal B)
    (R C : Type u) [CommRing R] [IsLocalRing R] [CommRing C] [IsLocalRing C]
    [Algebra (A ⊗[k] B) R]
    [IsLocalization
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R]
    [Algebra R C]
    (ksep : Type v) [Field ksep] [Algebra (ResidueField R) ksep]
    [IsSepClosure (ResidueField R) ksep]
    [IsLocalRing.IsHenselization R ksep C]
    (q : Ideal C) (hq : q ∈ minimalPrimes C) :
    q = (q.comap ((algebraMap R C).comp ((algebraMap (A ⊗[k] B) R).comp
            (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom))).map
          ((algebraMap R C).comp ((algebraMap (A ⊗[k] B) R).comp
            (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom)) ⊔
        (q.comap ((algebraMap R C).comp ((algebraMap (A ⊗[k] B) R).comp
            (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom))).map
          ((algebraMap R C).comp ((algebraMap (A ⊗[k] B) R).comp
            (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom)) := by
  classical
  have : IsLocalHom (algebraMap R C) :=
    IsLocalRing.IsHenselization.isLocalHom (L := ksep)
  have : Module.Flat R C := flat_of_isHenselization (L := ksep)
  set iA := (Algebra.TensorProduct.includeLeft : A →ₐ[k] A ⊗[k] B).toRingHom with hiA
  set iB := (Algebra.TensorProduct.includeRight : B →ₐ[k] A ⊗[k] B).toRingHom with hiB
  -- the contraction of `q` to `R` is a minimal prime, and `q` is the ideal it generates
  have hp : q.comap (algebraMap R C) ∈ minimalPrimes R :=
    comap_mem_minimalPrimes_of_flat R C q hq
  have hpp : (q.comap (algebraMap R C)).IsPrime := hp.1.1
  have hprime : ((q.comap (algebraMap R C)).map (algebraMap R C)).IsPrime :=
    map_isPrime_of_mem_minimalPrimes_localized_tensorProduct k A B resA resB hresA hresB
      R C ksep _ hp
  have hqe : q = (q.comap (algebraMap R C)).map (algebraMap R C) :=
    (((IsMinimalPrime.iff_minimal q).mp hq).eq_of_le hprime
      (Ideal.map_le_iff_le_comap.mpr le_rfl)).symm
  -- its contraction to `A ⊗[k] B` is a minimal prime generated by its own two contractions
  have hr : (q.comap (algebraMap R C)).comap (algebraMap (A ⊗[k] B) R) ∈
      minimalPrimes (A ⊗[k] B) :=
    (minimalPrimes_localized_tensorProduct_bijOn k A B R resA resB hresA hresB).mapsTo hp
  set r := (q.comap (algebraMap R C)).comap (algebraMap (A ⊗[k] B) R) with hrdef
  set pA := r.comap iA with hpAdef
  set pB := r.comap iB with hpBdef
  have hpA : pA.IsPrime := (minimalPrimes_tensorProduct_mapsTo k A B hr).1.isPrime
  have hpB : pB.IsPrime := (minimalPrimes_tensorProduct_mapsTo k A B hr).2.isPrime
  have hrsup : r = pA.map iA ⊔ pB.map iB := by
    rw [minimalPrime_tensorProduct_eq_quotient_kernel k A B r hr]
    change RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k pA)
      (Ideal.Quotient.mkₐ k pB)) = _
    rw [quotient_tensor_kernel_eq k A B pA pB]
    rfl
  have hmap : r.map (algebraMap (A ⊗[k] B) R) = q.comap (algebraMap R C) :=
    IsLocalization.map_under
      (Submonoid.comap
        (Algebra.TensorProduct.lift resA resB (fun _ _ ↦ Commute.all _ _)).toRingHom
        (nonZeroDivisors k)) R _
  -- and the two contractions of `q` to `A` and to `B` are those of `r`
  have hcA : q.comap ((algebraMap R C).comp
      ((algebraMap (A ⊗[k] B) R).comp iA)) = pA := by
    rw [hpAdef, hrdef, ← Ideal.comap_comap, ← Ideal.comap_comap]
  have hcB : q.comap ((algebraMap R C).comp
      ((algebraMap (A ⊗[k] B) R).comp iB)) = pB := by
    rw [hpBdef, hrdef, ← Ideal.comap_comap, ← Ideal.comap_comap]
  rw [hcA, hcB, hqe, ← hmap, Ideal.map_map, hrsup, Ideal.map_sup, Ideal.map_map, Ideal.map_map,
    RingHom.comp_assoc, RingHom.comp_assoc]

end TensorNormalization

end StrictHenselizationTensorProduct

section SmoothInvariance

open scoped TensorProduct
open IsLocalRing
open CategoryTheory CategoryTheory.Limits

theorem encard_minimalPrimes_eq_of_injOn_comap
    {A : Type*} {B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [Module.FaithfullyFlat A B]
    (hinj : Set.InjOn (fun q : Ideal B => Ideal.comap (algebraMap A B) q)
      (minimalPrimes B)) :
    (minimalPrimes A).encard = (minimalPrimes B).encard := by
  have hbij : Set.BijOn (fun q : Ideal B => Ideal.comap (algebraMap A B) q)
      (minimalPrimes B) (minimalPrimes A) :=
    ⟨fun q hq => comap_mem_minimalPrimes_of_flat A B q hq,
      hinj, surjOn_minimalPrimes_comap A B⟩
  exact (Set.encard_congr (hbij.equiv _)).symm

end SmoothInvariance

