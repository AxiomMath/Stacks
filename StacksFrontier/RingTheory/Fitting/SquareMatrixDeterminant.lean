module

public import StacksFrontier.RingTheory.Fitting.Basic

/-!
# The zeroth Fitting ideal of a square presentation

For a square matrix `A ∈ Mₙ(R)` the ideal of its `n × n` minors is generated by `det A`
(`minorIdeal_self_eq_span_det`): an `n × n` minor of an `n × n` matrix is the determinant of a
reindexing by two maps `Fin n → Fin n`, which vanishes unless both are bijections, and is `± det A`
otherwise. Consequently the zeroth Fitting ideal of the cokernel of `A : Rⁿ → Rⁿ` is the principal
ideal `(det A)` (`fittingIdeal_zero_eq_span_det`, [Stacks, Tag 07Z9]).

This computes the theta divisor of a curve locally: there `H¹` of the universal family of degree
`g - 1` is the cokernel of a square matrix.
-/

@[expose] public section

open Matrix

universe u

namespace Stacks.Fitting

/-- **The `n × n` minors of an `n × n` matrix generate `(det A)`.** -/
theorem minorIdeal_self_eq_span_det {R : Type*} [CommRing R] {n : ℕ}
    (A : Matrix (Fin n) (Fin n) R) :
    minorIdeal A n = Ideal.span {A.det} := by
  classical
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro x ⟨f, g, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_span_singleton]
    by_cases hf : Function.Injective f
    · by_cases hg : Function.Injective g
      · set σ := Equiv.ofBijective f ((Finite.injective_iff_bijective).1 hf)
        set τ := Equiv.ofBijective g ((Finite.injective_iff_bijective).1 hg)
        have : A.submatrix f g = (A.submatrix id τ).submatrix σ id := by
          ext i j; rfl
        rw [this, Matrix.det_permute, Matrix.det_permute']
        exact Dvd.dvd.mul_left (Dvd.dvd.mul_left (dvd_refl _) _) _
      · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.1 hg
        rw [Matrix.det_zero_of_column_eq (M := A.submatrix f g) hne
          (fun r => by simp only [Matrix.submatrix_apply]; rw [hij])]
        exact dvd_zero _
    · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.1 hf
      rw [Matrix.det_zero_of_row_eq (M := A.submatrix f g) hne
        (by funext c; simp only [Matrix.submatrix_apply]; rw [hij])]
      exact dvd_zero _
  · rintro x rfl
    exact Ideal.subset_span ⟨id, id, by simp⟩

/-- **The zeroth Fitting ideal of the cokernel of a square matrix is `(det A)`.** -/
theorem fittingIdeal_zero_coker_mulVecLin {R : Type u} [CommRing R] {n : ℕ}
    (A : Matrix (Fin n) (Fin n) R) :
    fittingIdeal (R := R) (M := (Fin n → R) ⧸ LinearMap.range A.mulVecLin) ((0 : ℕ) : ℤ) =
      Ideal.span {A.det} := by
  rw [fittingIdeal_eq_minorIdeal_of_presentation A 0
    (Submodule.quotEquivOfEq _ _ (by rw [Matrix.range_mulVecLin]; rfl)), Nat.sub_zero,
    minorIdeal_self_eq_span_det]

end Stacks.Fitting
