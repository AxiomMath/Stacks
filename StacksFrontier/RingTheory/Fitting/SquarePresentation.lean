module

public import StacksFrontier.RingTheory.Fitting.LocalFiltration
public import StacksFrontier.RingTheory.Fitting.ProjectiveDimension

/-!
# The divisors and the two filtrations of any finite module with principal Fitting ideals

Over a local ring, a finite module all of whose Fitting ideals are generated by nonzerodivisors
has the divisors `D_i` and the two filtrations of Stacks tag 0ESU, with no presentation assumed:
such a module is the cokernel of an injective square matrix, to which
`Stacks.FittingFiltration.exists_divisors_and_filtrations` applies. The hypothesis on the Fitting
ideals passes to the localization of any ring at a prime.

## Main results

* `Stacks.FittingFiltration.map_incr` and `Stacks.FittingFiltration.map_decr`: both filtrations are
  carried onto each other by an isomorphism of modules.
* `Stacks.FittingFiltration.exists_divisors_and_filtrations_of_finite`: **the local form of Stacks
  tag 0ESU with no presentation assumed.** For a finite module over a local ring all of whose
  Fitting ideals are generated by nonzerodivisors, the local equations of the divisors `D_i`
  exist, both filtrations are finite and anchored, and for every `i ≥ 1` both graded pieces are
  free of rank `i` over `R ⧸ (f_i)`.
* `Stacks.FittingFiltration.forall_fittingIdeal_localizedAtPrime_eq_span_singleton`: if every
  Fitting ideal of a finite module is generated by a nonzerodivisor, the same holds for its
  localization at any prime.

## Implementation notes

The number `n` of generators is not part of the data of the module, so it is existentially
quantified in the conclusion; for the cokernel of a square matrix it is the size of the matrix.

## References

* [Stacks Project, Tag 0ESU](https://stacks.math.columbia.edu/tag/0ESU)
* [Stacks Project, Tag 0F7M](https://stacks.math.columbia.edu/tag/0F7M)
-/

@[expose] public noncomputable section

universe u v w

namespace Stacks.FittingFiltration

open Stacks.ScaledPresentation

variable {R : Type u} [CommRing R]

/-! ### Both filtrations are carried along an isomorphism -/

section Transport

variable {M : Type v} [AddCommGroup M] [Module R M]
  {M₂ : Type w} [AddCommGroup M₂] [Module R M₂]

/-- The increasing filtration is carried onto the increasing filtration by an isomorphism: it is
the image of multiplication by a ring element, and an isomorphism commutes with that. -/
theorem map_incr (σ : M ≃ₗ[R] M₂) (f : ℕ → R) (N i : ℕ) :
    (incr M f N i).map (σ : M →ₗ[R] M₂) = incr M₂ f N i := by
  ext y
  simp only [incr, Submodule.mem_map, LinearMap.mem_range, LinearMap.lsmul_apply,
    LinearEquiv.coe_coe]
  constructor
  · rintro ⟨x, ⟨v, rfl⟩, rfl⟩
    exact ⟨σ v, by rw [map_smul]⟩
  · rintro ⟨v, rfl⟩
    exact ⟨divisorProd f N (i + 1) • σ.symm v, ⟨σ.symm v, rfl⟩,
      by rw [map_smul, σ.apply_symm_apply]⟩

/-- The decreasing filtration is carried onto the decreasing filtration by an isomorphism: it is
the kernel of multiplication by a ring element, and an isomorphism commutes with that. -/
theorem map_decr (σ : M ≃ₗ[R] M₂) (f : ℕ → R) (N i : ℕ) :
    (decr M f N i).map (σ : M →ₗ[R] M₂) = decr M₂ f N i := by
  ext y
  simp [decr, Submodule.map_equiv_eq_comap_symm, ← map_smul]

end Transport

/-! ### The divisors and the filtrations of a finite module -/

/-- **The local form of Stacks tag 0ESU, with no presentation assumed.** Let `R` be a local ring
and `𝓕` a finite `R`-module all of whose Fitting ideals `Fit_k(𝓕)`, `k ≥ 0`, are generated by a
nonzerodivisor. Then there are a bound `n` and local equations `e_1, …, e_n` of the divisors `D_i`
of the source such that:

* each `e_j` is a nonzerodivisor, so `D_j` is an effective Cartier divisor, and `e_j` is a unit for
  `j > n`, so only finitely many `D_j` are nonempty;
* `Fit_k(𝓕) = ∏_{j > k} (e_j)^{j - k}`, which is the source's
  `E_k = D_{k+1} + 2 D_{k+2} + 3 D_{k+3} + ⋯`;
* the increasing filtration `F^i = (e_{i+1} ⋯ e_n) · 𝓕` runs from `F^0 = 0` to `F^i = 𝓕` for
  `i ≥ n`, and the decreasing filtration `F_i = Ker(e_i ⋯ e_n : 𝓕 → 𝓕)` runs from `F_1 = 𝓕` to
  `F_i = 0` for `i > n`;
* for every `i ≥ 1` both graded pieces `F^i/F^{i-1}` and `F_i/F_{i+1}` are free of rank `i` over
  `R ⧸ (e_i)`, the ring of functions on `D_i`. -/
theorem exists_divisors_and_filtrations_of_finite [IsLocalRing R] (M : Type v) [AddCommGroup M]
    [Module R M] [Module.Finite R M]
    (hfit : ∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
      fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {g}) :
    ∃ (n : ℕ) (e : ℕ → R),
      (∀ j, e j ∈ nonZeroDivisors R) ∧
      (∀ j, n < j → IsUnit (e j)) ∧
      (∀ k : ℕ, fittingIdeal (R := R) (M := M) (k : ℤ) =
        ∏ j ∈ Finset.Icc (k + 1) n, Ideal.span {e j} ^ (j - k)) ∧
      incr M e n 0 = ⊥ ∧
      (∀ i, n ≤ i → incr M e n i = ⊤) ∧
      Monotone (incr M e n) ∧
      decr M e n 1 = ⊤ ∧
      (∀ i, n < i → decr M e n i = ⊥) ∧
      Antitone (decr M e n) ∧
      (∀ i : ℕ, Nonempty (gradedQuot (incr M e n i) (incr M e n (i + 1))
        ≃ₗ[R] (Fin (i + 1) → R ⧸ Ideal.span {e (i + 1)}))) ∧
      (∀ i : ℕ, Nonempty (gradedQuot (decr M e n (i + 2)) (decr M e n (i + 1))
        ≃ₗ[R] (Fin (i + 1) → R ⧸ Ideal.span {e (i + 1)}))) := by
  obtain ⟨g, hg, hg0⟩ := hfit 0
  obtain ⟨n, A, p, hinj, hp, hrange⟩ :=
    exists_square_presentation_of_fittingIdeal_zero_eq_span_singleton g
      ((isRegular_iff_mem_nonZeroDivisors).mpr hg) (by simpa using hg0)
  let σ : Cokernel A ≃ₗ[R] M :=
    (Submodule.quotEquivOfEq _ _ hrange).trans (p.quotKerEquivOfSurjective hp)
  have hfitA : ∀ k : ℕ, ∃ z ∈ nonZeroDivisors R,
      fittingIdeal (R := R) (M := Cokernel A) (k : ℤ) = Ideal.span {z} := by
    intro k
    obtain ⟨z, hz, hzk⟩ := hfit k
    exact ⟨z, hz, (fittingIdeal_eq_of_linearEquiv σ k).trans hzk⟩
  obtain ⟨e, hmem, hunit, hfiteq, hi0, hitop, himono, hd1, hdbot, hdanti, higr, hdgr⟩ :=
    exists_divisors_and_filtrations A hinj hfitA
  have hincr := map_incr σ e n
  have hdecr := map_decr σ e n
  refine ⟨n, e, hmem, hunit, fun k => (fittingIdeal_eq_of_linearEquiv σ k).symm.trans (hfiteq k),
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← hincr 0, hi0, Submodule.map_bot]
  · intro i hi
    rw [← hincr i, hitop i hi, Submodule.map_top, LinearMap.range_eq_top]
    exact σ.surjective
  · intro i j hij
    rw [← hincr i, ← hincr j]
    exact Submodule.map_mono (himono hij)
  · rw [← hdecr 1, hd1, Submodule.map_top, LinearMap.range_eq_top]
    exact σ.surjective
  · intro i hi
    rw [← hdecr i, hdbot i hi, Submodule.map_bot]
  · intro i j hij
    rw [← hdecr i, ← hdecr j]
    exact Submodule.map_mono (hdanti hij)
  · intro i
    obtain ⟨φ⟩ := higr i
    rw [← hincr i, ← hincr (i + 1)]
    exact ⟨(gradedQuotMapEquiv (σ : Cokernel A →ₗ[R] M) σ.injective _ _).symm.trans φ⟩
  · intro i
    obtain ⟨φ⟩ := hdgr i
    rw [← hdecr (i + 2), ← hdecr (i + 1)]
    exact ⟨(gradedQuotMapEquiv (σ : Cokernel A →ₗ[R] M) σ.injective _ _).symm.trans φ⟩

/-! ### The hypothesis at a point -/

/-- **A nonzerodivisor stays a nonzerodivisor in a flat algebra**, because multiplication by it
stays injective there. -/
theorem mem_nonZeroDivisors_algebraMap_of_flat {S : Type w} [CommRing S] [Algebra R S]
    [Module.Flat R S] {g : R} (hg : g ∈ nonZeroDivisors R) :
    algebraMap R S g ∈ nonZeroDivisors S := by
  have h : IsSMulRegular S g :=
    Module.Flat.isSMulRegular_of_isRegular (isRegular_iff_mem_nonZeroDivisors.mpr hg)
  have hleft : IsLeftRegular (algebraMap R S g) := by
    intro x y hxy
    exact h (by simpa [Algebra.smul_def] using hxy)
  exact isRegular_iff_mem_nonZeroDivisors.mp
    ⟨hleft, fun x y hxy => hleft (by simpa [mul_comm] using hxy)⟩

/-- The hypothesis of `Stacks.FittingFiltration.exists_divisors_and_filtrations_of_finite` passes
to the localization at a prime, where the ring is local. -/
theorem forall_fittingIdeal_localizedAtPrime_eq_span_singleton {M : Type v} [AddCommGroup M]
    [Module R M] [Module.Finite R M]
    (hfit : ∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
      fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {g})
    (p : Ideal R) [p.IsPrime] :
    ∀ k : ℕ, ∃ g ∈ nonZeroDivisors (Localization.AtPrime p),
      fittingIdeal (R := Localization.AtPrime p) (M := LocalizedModule.AtPrime p M) (k : ℤ) =
        Ideal.span {g} := by
  intro k
  obtain ⟨g, hg, hgk⟩ := hfit k
  refine ⟨algebraMap R (Localization.AtPrime p) g, mem_nonZeroDivisors_algebraMap_of_flat hg, ?_⟩
  rw [fittingIdeal_localizedAtPrime_eq_map p k, hgk, Ideal.map_span, Set.image_singleton]

end Stacks.FittingFiltration

end
