module

public import StacksFrontier.AlgebraicGeometry.Curves.JacobianCriterionPlane
public import StacksFrontier.RingTheory.Fitting.UnitEntryDescent
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The two filtrations and the divisors of a module with principal Fitting ideals

Let `R` be a local ring and let `𝓕 = Rⁿ / A Rⁿ` be presented by a square matrix `A` with `A`
injective, and assume every Fitting ideal `Fit_k(𝓕)`, `k ≥ 0`, is generated by a nonzerodivisor.
This file produces, by induction on `n`, the local equations `f_1, …, f_n` of the divisors `D_i` of
Stacks tag 0ESU together with the two filtrations of `𝓕` and the identification of their graded
pieces.

Everything is canonical: with `f_i` the local equation of `D_i`, the two filtrations are

```
F^i = (f_{i+1} ⋯ f_n) · 𝓕        and        F_i = Ker(f_i ⋯ f_n : 𝓕 → 𝓕),
```

so no choice enters their definition once the `f_i` are fixed, and the `f_i` themselves are pinned
down by the Fitting ideals through the identity `Fit_k(𝓕) = ∏_{j > k} (f_j)^{j - k}`, which is the
source's `E_k = D_{k+1} + 2 D_{k+2} + 3 D_{k+3} + ⋯`.

## Main definitions

* `Stacks.FittingFiltration.gradedQuot`: the graded piece `P ⧸ N` of a pair of submodules.
* `Stacks.FittingFiltration.divisorProd`: the product `f_i f_{i+1} ⋯ f_N` of the local equations
  from the index `i` on.
* `Stacks.FittingFiltration.incr` and `Stacks.FittingFiltration.decr`: the increasing and the
  decreasing filtration, `F^i = (f_{i+1} ⋯ f_N) · M` and `F_i = Ker(f_i ⋯ f_N : M → M)`.
* `Stacks.FittingFiltration.LocalData`: the whole package — the equations, the Fitting identity,
  the two anchors `F^0 = 0` and `F_1 = M`, and the two graded-piece identifications.

## Main results

* `Stacks.FittingFiltration.incr_eq_top` and `Stacks.FittingFiltration.decr_eq_bot`: the two
  filtrations are finite, `F^i = M` for `i ≥ N` and `F_i = 0` for `i > N`.
* `Stacks.FittingFiltration.incr_monotone` and `Stacks.FittingFiltration.decr_antitone`: the two
  families are a filtration.
* `Stacks.FittingFiltration.exists_span_singleton_of_pow_mul_eq_span_singleton`: a nonzerodivisor
  cancels out of a product of ideals, so `(f)^e · J` principal on a nonzerodivisor forces `J` to be
  principal on a nonzerodivisor.
* `Stacks.FittingFiltration.LocalData.fittingIdeal_mul_fittingIdeal`:
  `Fit_k · Fit_{k+2} = Fit_{k+1} · Fit_{k+1} · (f_{k+1})`, so the divisors are determined by the
  Fitting ideals of the module.
* `Stacks.FittingFiltration.injective_and_forall_fittingIdeal_eq_span_singleton`: the hypotheses
  below are met by the `1 × 1` matrix of a nonzerodivisor `g`, whose cokernel is `R ⧸ (g)`.
* `Stacks.FittingFiltration.exists_divisors_and_filtrations`: **the local form of Stacks tag
  0ESU.** For a square injective presentation over a local ring all of whose Fitting ideals are
  generated by nonzerodivisors, the local equations of the divisors `D_i` exist, both filtrations
  are finite and anchored, and for every `i ≥ 1` both graded pieces are free of rank `i` over
  `R ⧸ (f_i)`, the ring of functions on `D_i`.

## Implementation notes

**Why a local ring.** The source shrinks the affine open `V` twice in the inductive step: once so
that `Fit_{n-1}(ℱ)|_V` becomes principal on a nonzerodivisor, and once so that an entry of `A'`
becomes invertible, which is possible because the entries of `A'` generate the unit ideal. Over a
local ring both shrinkings are free: a principal generator is a hypothesis of the statement, and a
family generating the unit ideal in a local ring has a member outside the maximal ideal, hence a
unit member. So the induction runs over a single ring and no localization bookkeeping appears.

**The graded pieces.** `R ⧸ (f_i)` is the ring of functions on the divisor `D_i` cut out by `f_i`,
so `Fin i → R ⧸ (f_i)` is `𝒪_{D_i}^{⊕ i}` and the two graded-piece identifications are the
source's "`F^i/F^{i-1}` and `F_i/F_{i+1}` are finite locally free of rank `i` on `D_i`".

## References

* [Stacks Project, Tag 0ESU](https://stacks.math.columbia.edu/tag/0ESU)
* [Stacks Project, Tag 00MT](https://stacks.math.columbia.edu/tag/00MT)
* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
-/


@[expose] public noncomputable section

universe u v w

namespace Stacks.FittingFiltration

open Stacks.ScaledPresentation Matrix

variable {R : Type u} [CommRing R]

/-! ### Graded pieces of a pair of submodules -/

section Graded

variable {M : Type v} [AddCommGroup M] [Module R M]
  {M₂ : Type w} [AddCommGroup M₂] [Module R M₂]

/-- The graded piece `P ⧸ N` of a pair of submodules of `M`, as the quotient of `P` by the part
of `N` lying inside it. For `N ≤ P` this is the quotient module `P ⧸ N`. -/
@[ega "IV 19.6.1"]
abbrev gradedQuot (N P : Submodule R M) : Type v := ↥P ⧸ Submodule.comap P.subtype N

/-- Membership in the part of `N` lying inside `P`, read in the ambient module. -/
theorem mem_comap_subtype_iff (N P : Submodule R M) (x : ↥P) :
    x ∈ Submodule.comap P.subtype N ↔ (x : M) ∈ N := Iff.rfl

/-- A quotient by the whole module has one element. -/
theorem subsingleton_quotient_of_eq_top {P : Submodule R M} (h : P = ⊤) :
    Subsingleton (M ⧸ P) := by
  refine ⟨fun a b => ?_⟩
  induction a using Submodule.Quotient.induction_on with
  | _ x =>
    induction b using Submodule.Quotient.induction_on with
    | _ y =>
      rw [(Submodule.Quotient.mk_eq_zero P).mpr (by rw [h]; exact Submodule.mem_top),
        (Submodule.Quotient.mk_eq_zero P).mpr (by rw [h]; exact Submodule.mem_top)]

/-- A graded piece of a pair of equal submodules has one element: there is nothing between `P`
and itself. -/
theorem subsingleton_gradedQuot_self (P : Submodule R M) : Subsingleton (gradedQuot P P) :=
  subsingleton_quotient_of_eq_top (by ext x; simp)

/-- A free module over `R ⧸ (c)` for a unit `c` has one element: the divisor cut out by a unit is
empty. -/
theorem subsingleton_pi_quotient_span_singleton {c : R} (hc : IsUnit c) (k : ℕ) :
    Subsingleton (Fin k → R ⧸ Ideal.span {c}) := by
  have : Subsingleton (R ⧸ Ideal.span {c}) :=
    subsingleton_quotient_of_eq_top (Ideal.span_singleton_eq_top.mpr hc)
  exact ⟨fun a b => funext fun _ => Subsingleton.elim _ _⟩

/-- Two modules with at most one element are isomorphic. -/
def subsingletonEquiv (A : Type v) (B : Type w) [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] [Subsingleton A] [Subsingleton B] : A ≃ₗ[R] B :=
  LinearEquiv.ofLinear 0 0 (by ext x; exact Subsingleton.elim _ _)
    (by ext x; exact Subsingleton.elim _ _)

/-- The graded piece over the zero submodule is the submodule itself. -/
def gradedQuotBotEquiv (P : Submodule R M) : gradedQuot (⊥ : Submodule R M) P ≃ₗ[R] ↥P :=
  Submodule.quotEquivOfEqBot _ (by rw [Submodule.comap_bot, Submodule.ker_subtype])

/-- The graded piece under the whole module is the quotient by the smaller submodule. -/
def gradedQuotTopEquiv (N : Submodule R M) : gradedQuot N (⊤ : Submodule R M) ≃ₗ[R] M ⧸ N :=
  Submodule.Quotient.equiv _ _ Submodule.topEquiv (by ext x; simp)

/-- **Graded pieces transport along an injective map.** The image of a pair of submodules under
an injective linear map has the same graded piece. -/
def gradedQuotMapEquiv (φ : M →ₗ[R] M₂) (hφ : Function.Injective φ) (N P : Submodule R M) :
    gradedQuot N P ≃ₗ[R] gradedQuot (N.map φ) (P.map φ) := by
  have hcoe : ∀ (x : M) (hx : x ∈ P),
      ((Submodule.equivMapOfInjective φ hφ P ⟨x, hx⟩ : ↥(P.map φ)) : M₂) = φ x := by
    intro x hx
    simp [Submodule.coe_equivMapOfInjective_apply]
  refine Submodule.Quotient.equiv _ _ (Submodule.equivMapOfInjective φ hφ P) ?_
  refine Submodule.ext fun y => ⟨?_, ?_⟩
  · rintro ⟨⟨x, hxP⟩, hxN, rfl⟩
    have hxN' : x ∈ N := hxN
    have hmem : φ x ∈ N.map φ := Submodule.mem_map_of_mem hxN'
    simpa [Submodule.coe_equivMapOfInjective_apply] using hmem
  · intro hy
    have hy' : (y : M₂) ∈ N.map φ := hy
    obtain ⟨x, hxN, hx⟩ := hy'
    obtain ⟨x', hx'P, hx'⟩ := y.2
    have hxx' : x = x' := hφ (by rw [hx, hx'])
    have hxP : x ∈ P := by rw [hxx']; exact hx'P
    have hxN' : x ∈ N := hxN
    refine ⟨⟨x, hxP⟩, hxN', Subtype.ext ?_⟩
    simpa [Submodule.coe_equivMapOfInjective_apply] using hx

/-- **Graded pieces transport along a surjective map.** The preimage of a pair of submodules under
a surjective linear map has the same graded piece. -/
def gradedQuotComapEquiv (φ : M →ₗ[R] M₂) (hφ : Function.Surjective φ) (N P : Submodule R M₂) :
    gradedQuot (N.comap φ) (P.comap φ) ≃ₗ[R] gradedQuot N P := by
  have hres : ∀ x ∈ P.comap φ, φ x ∈ P := fun _ hx => hx
  have hψcoe : ∀ x : ↥(P.comap φ), ((φ.restrict hres x : ↥P) : M₂) = φ (x : M) := fun x => by
    rw [LinearMap.restrict_coe_apply]
  have hgsurj : Function.Surjective
      ((Submodule.comap P.subtype N).mkQ ∘ₗ φ.restrict hres) := by
    intro y
    induction y using Submodule.Quotient.induction_on with
    | _ b =>
      obtain ⟨a, ha⟩ := hφ (b : M₂)
      have haP : a ∈ P.comap φ := by
        rw [Submodule.mem_comap, ha]
        exact b.2
      refine ⟨⟨a, haP⟩, ?_⟩
      have hb : φ.restrict hres ⟨a, haP⟩ = b := Subtype.ext (by rw [hψcoe]; exact ha)
      rw [LinearMap.comp_apply, hb, Submodule.mkQ_apply]
  have hker : LinearMap.ker ((Submodule.comap P.subtype N).mkQ ∘ₗ φ.restrict hres)
      = Submodule.comap (P.comap φ).subtype (N.comap φ) := by
    refine Submodule.ext fun x => ?_
    rw [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero, mem_comap_subtype_iff, mem_comap_subtype_iff,
      Submodule.mem_comap, hψcoe]
  exact (Submodule.quotEquivOfEq _ _ hker.symm).trans
    (LinearMap.quotKerEquivOfSurjective _ hgsurj)

end Graded

/-! ### The products of local equations -/

/-- The product `f_i f_{i+1} ⋯ f_N` of the local equations of the divisors of index at least `i`
and at most `N`. -/
def divisorProd (f : ℕ → R) (N i : ℕ) : R := ∏ j ∈ Finset.Icc i N, f j

/-- Past the last divisor the product is empty. -/
theorem divisorProd_of_lt (f : ℕ → R) {N i : ℕ} (h : N < i) : divisorProd f N i = 1 := by
  rw [divisorProd, Finset.Icc_eq_empty (by omega), Finset.prod_empty]

/-- The product from the index `i` on splits off its first factor. -/
theorem divisorProd_succ (f : ℕ → R) {N i : ℕ} (h : i ≤ N) :
    divisorProd f N i = f i * divisorProd f N (i + 1) := by
  rw [divisorProd, divisorProd, ← Finset.insert_Icc_add_one_left_eq_Icc h,
    Finset.prod_insert (by simp)]

/-- The product at the top index is the top equation. -/
theorem divisorProd_self (f : ℕ → R) (N : ℕ) : divisorProd f N N = f N := by
  rw [divisorProd, Finset.Icc_self, Finset.prod_singleton]

/-- Enlarging the range of divisors by one multiplies the product by the new equation. -/
theorem divisorProd_succ_top (f : ℕ → R) {N i : ℕ} (h : i ≤ N + 1) :
    divisorProd f (N + 1) i = divisorProd f N i * f (N + 1) :=
  Finset.prod_Icc_succ_top h f

/-! ### The two filtrations -/

section Filtration

variable (M : Type v) [AddCommGroup M] [Module R M]

/-- **The increasing filtration of Stacks tag 0ESU**, `F^i = (f_{i+1} ⋯ f_N) · M`: the image of
multiplication by the product of the local equations of the divisors above `i`. -/
def incr (f : ℕ → R) (N i : ℕ) : Submodule R M :=
  LinearMap.range (LinearMap.lsmul R M (divisorProd f N (i + 1)))

/-- **The decreasing filtration of Stacks tag 0ESU**, `F_i = Ker(f_i ⋯ f_N : M → M)`: the
submodule killed by the product of the local equations of the divisors from `i` on. -/
def decr (f : ℕ → R) (N i : ℕ) : Submodule R M :=
  LinearMap.ker (LinearMap.lsmul R M (divisorProd f N i))

variable {M}

/-- Multiplication by a product factors through multiplication by either factor. -/
theorem lsmul_comp_lsmul (c d : R) :
    (LinearMap.lsmul R M c) ∘ₗ (LinearMap.lsmul R M d) = LinearMap.lsmul R M (c * d) := by
  ext x; simp [smul_smul, mul_comm]

/-- The image of multiplication by a product lies in the image of multiplication by a factor. -/
theorem range_lsmul_mul_le (c d : R) :
    LinearMap.range (LinearMap.lsmul R M (c * d)) ≤
      LinearMap.range (LinearMap.lsmul R M d) := by
  rintro _ ⟨x, rfl⟩
  refine ⟨c • x, ?_⟩
  show d • (c • x) = (c * d) • x
  rw [smul_smul, mul_comm]

/-- What a factor kills is killed by the product. -/
theorem ker_le_ker_lsmul_mul (c d : R) :
    LinearMap.ker (LinearMap.lsmul R M d) ≤
      LinearMap.ker (LinearMap.lsmul R M (c * d)) := by
  intro x hx
  have hx' : d • x = 0 := hx
  show (c * d) • x = 0
  rw [← smul_smul, hx', smul_zero]

/-- Multiplication by one has the whole module as image. -/
theorem range_lsmul_eq_top_of_eq_one {c : R} (hc : c = 1) :
    LinearMap.range (LinearMap.lsmul R M c) = ⊤ := by
  subst hc
  refine Submodule.eq_top_iff'.mpr fun x => ?_
  exact ⟨x, one_smul R x⟩

/-- Multiplication by one kills nothing. -/
theorem ker_lsmul_eq_bot_of_eq_one {c : R} (hc : c = 1) :
    LinearMap.ker (LinearMap.lsmul R M c) = ⊥ := by
  subst hc
  refine le_antisymm (fun x hx => ?_) bot_le
  have h1 : (1 : R) • x = 0 := hx
  rw [one_smul] at h1
  exact (Submodule.mem_bot R).mpr h1

/-- **The increasing filtration exhausts the module**: past the last divisor `F^i = M`. -/
theorem incr_eq_top (f : ℕ → R) {N i : ℕ} (h : N ≤ i) : incr M f N i = ⊤ :=
  range_lsmul_eq_top_of_eq_one (divisorProd_of_lt f (by omega))

/-- **The decreasing filtration reaches zero**: past the last divisor `F_i = 0`. -/
theorem decr_eq_bot (f : ℕ → R) {N i : ℕ} (h : N < i) : decr M f N i = ⊥ :=
  ker_lsmul_eq_bot_of_eq_one (divisorProd_of_lt f h)

/-- The increasing family is a filtration. -/
theorem incr_monotone (f : ℕ → R) (N : ℕ) : Monotone (incr M f N) := by
  refine monotone_nat_of_le_succ fun i => ?_
  rcases le_or_gt (i + 1) N with h | h
  · rw [incr, incr, divisorProd_succ f h]
    exact range_lsmul_mul_le (f (i + 1)) (divisorProd f N (i + 1 + 1))
  · rw [incr_eq_top f (by omega : N ≤ i + 1)]
    exact le_top

/-- The decreasing family is a filtration. -/
theorem decr_antitone (f : ℕ → R) (N : ℕ) : Antitone (decr M f N) := by
  refine antitone_nat_of_succ_le fun i => ?_
  rcases le_or_gt i N with h | h
  · rw [decr, decr, divisorProd_succ f h]
    exact ker_le_ker_lsmul_mul (f i) (divisorProd f N (i + 1))
  · rw [decr_eq_bot f (by omega : N < i + 1)]
    exact bot_le

end Filtration

/-! ### Cancelling a nonzerodivisor from a product of ideals -/

/-- **A nonzerodivisor cancels out of a product of ideals.** If `(f)^e · J` is generated by a
nonzerodivisor and `f` is a nonzerodivisor, then `J` is generated by a nonzerodivisor. -/
theorem exists_span_singleton_of_pow_mul_eq_span_singleton {f g : R} {J : Ideal R} {e : ℕ}
    (hf : f ∈ nonZeroDivisors R) (hg : g ∈ nonZeroDivisors R)
    (h : Ideal.span {f} ^ e * J = Ideal.span {g}) :
    ∃ z ∈ nonZeroDivisors R, J = Ideal.span {z} := by
  have hfe : f ^ e ∈ nonZeroDivisors R := pow_mem hf e
  rw [Ideal.span_singleton_pow] at h
  have hgmem : g ∈ Ideal.span {f ^ e} * J := by rw [h]; exact Ideal.mem_span_singleton_self g
  obtain ⟨z, hzJ, hz⟩ := Ideal.mem_span_singleton_mul.mp hgmem
  refine ⟨z, ?_, ?_⟩
  · refine mem_nonZeroDivisors_iff.mpr ⟨fun x hx => ?_, fun x hx => ?_⟩
    · refine (mem_nonZeroDivisors_iff.mp hg).1 x ?_
      rw [← hz]
      calc f ^ e * z * x = f ^ e * (z * x) := by ring
        _ = 0 := by rw [hx, mul_zero]
    · refine (mem_nonZeroDivisors_iff.mp hg).2 x ?_
      rw [← hz]
      calc x * (f ^ e * z) = f ^ e * (x * z) := by ring
        _ = 0 := by rw [hx, mul_zero]
  · refine le_antisymm (fun y hy => ?_) ?_
    · have hfy : f ^ e * y ∈ Ideal.span {g} := by
        rw [← h]
        exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hy
      rw [← hz] at hfy
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hfy
      refine Ideal.mem_span_singleton.mpr ⟨c, ?_⟩
      have h0 : f ^ e * (y - z * c) = 0 := by
        rw [mul_sub]
        linear_combination hc
      exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff.mp hfe).1 _ h0)
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact hzJ

/-! ### The local package -/

/-- **The local form of the conclusion of Stacks tag 0ESU.** The local equations `f_j` of the
divisors `D_j`, the identity `Fit_k = ∏_{j > k} (f_j)^{j-k}` expressing the source's
`E_k = D_{k+1} + 2 D_{k+2} + ⋯`, the two anchors `F^0 = 0` and `F_1 = M` of the two filtrations
`Stacks.FittingFiltration.incr` and `Stacks.FittingFiltration.decr`, and the identification of
both graded pieces in degree `i` with the free module of rank `i` over `R ⧸ (f_i)`, the ring of
functions on `D_i`. -/
structure LocalData (R : Type u) [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    [Module.Finite R M] (N : ℕ) where
  /-- The local equation of the divisor `D_j`. -/
  equation : ℕ → R
  /-- Each divisor is cut out by a nonzerodivisor. -/
  equation_mem (j : ℕ) : equation j ∈ nonZeroDivisors R
  /-- Only the first `N` divisors are nonempty. -/
  isUnit_equation {j : ℕ} (hj : N < j) : IsUnit (equation j)
  /-- `E_k = D_{k+1} + 2 D_{k+2} + 3 D_{k+3} + ⋯`, in the form of the Fitting ideals. -/
  fittingIdeal_eq (k : ℕ) :
    fittingIdeal (R := R) (M := M) (k : ℤ) =
      ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {equation j} ^ (j - k)
  /-- The increasing filtration starts at zero. -/
  incr_zero : incr M equation N 0 = ⊥
  /-- The decreasing filtration starts at the whole module. -/
  decr_one : decr M equation N 1 = ⊤
  /-- `F^i/F^{i-1}` is free of rank `i` over the ring of functions on `D_i`. -/
  incr_graded (i : ℕ) :
    Nonempty (gradedQuot (incr M equation N i) (incr M equation N (i + 1)) ≃ₗ[R]
      (Fin (i + 1) → R ⧸ Ideal.span {equation (i + 1)}))
  /-- `F_i/F_{i+1}` is free of rank `i` over the ring of functions on `D_i`. -/
  decr_graded (i : ℕ) :
    Nonempty (gradedQuot (decr M equation N (i + 2)) (decr M equation N (i + 1)) ≃ₗ[R]
      (Fin (i + 1) → R ⧸ Ideal.span {equation (i + 1)}))

/-- **The divisors are pinned down by the Fitting ideals.** If `e_j` is a unit for `j > N` and
`Fit_k = ∏_{k < j ≤ N} (e_j)^{j-k}` for every `k`, then

```
Fit_k · Fit_{k+2} = Fit_{k+1} · Fit_{k+1} · (e_{k+1}),
```

in which every term other than `(e_{k+1})` is a Fitting ideal of the module. -/
theorem fittingIdeal_mul_fittingIdeal_of_prod {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] {N : ℕ} {e : ℕ → R} (hunit : ∀ {j : ℕ}, N < j → IsUnit (e j))
    (hprod : ∀ k : ℕ, fittingIdeal (R := R) (M := M) (k : ℤ) =
      ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j} ^ (j - k)) (k : ℕ) :
    fittingIdeal (R := R) (M := M) (k : ℤ) * fittingIdeal (R := R) (M := M) ((k + 2 : ℕ) : ℤ)
      = fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ)
          * fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ)
          * Ideal.span {e (k + 1)} := by
  have e0 : fittingIdeal (R := R) (M := M) (k : ℤ)
      = ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j} ^ (j - k) := hprod k
  have e1 : fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ)
      = ∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 1)) :=
    hprod (k + 1)
  have e2 : fittingIdeal (R := R) (M := M) ((k + 2 : ℕ) : ℤ)
      = ∏ j ∈ Finset.Icc (k + 3) N, Ideal.span {e j} ^ (j - (k + 2)) :=
    hprod (k + 2)
  rcases le_or_gt (k + 1) N with hk | hk
  · have hB : (∏ j ∈ Finset.Icc (k + 3) N, Ideal.span {e j} ^ (j - (k + 2)))
        = ∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 2)) := by
      refine Finset.prod_subset (fun j hj => ?_) (fun j hj hj' => ?_)
      · simp only [Finset.mem_Icc] at hj ⊢
        omega
      · simp only [Finset.mem_Icc] at hj hj'
        have hj2 : j = k + 2 := by omega
        rw [hj2]
        simp
    have hA : (∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j} ^ (j - k))
        = Ideal.span {e (k + 1)}
          * ∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - k) := by
      rw [← Finset.insert_Icc_add_one_left_eq_Icc hk, Finset.prod_insert (by simp)]
      congr 1
      rw [show k + 1 - k = 1 from by omega, pow_one]
    have hkey : (∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - k))
          * (∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 2)))
        = (∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 1)))
          * (∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 1))) := by
      rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl fun j hj => ?_
      simp only [Finset.mem_Icc] at hj
      rw [← pow_add, ← pow_add,
        show (j - k) + (j - (k + 2)) = (j - (k + 1)) + (j - (k + 1)) from by omega]
    rw [e0, e1, e2, hB, hA, mul_assoc, hkey]
    exact mul_comm _ _
  · rw [e0, e1, e2, Finset.Icc_eq_empty (show ¬ k + 1 ≤ N by omega),
      Finset.Icc_eq_empty (show ¬ k + 2 ≤ N by omega),
      Finset.Icc_eq_empty (show ¬ k + 3 ≤ N by omega),
      Ideal.span_singleton_eq_top.mpr (hunit (show N < k + 1 by omega))]
    simp

/-- **The divisors of a local package are pinned down by the Fitting ideals**:
`Stacks.FittingFiltration.fittingIdeal_mul_fittingIdeal_of_prod` read off the product formula a
`Stacks.FittingFiltration.LocalData` carries. -/
theorem LocalData.fittingIdeal_mul_fittingIdeal {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] {N : ℕ} (d : LocalData R M N) (k : ℕ) :
    fittingIdeal (R := R) (M := M) (k : ℤ) * fittingIdeal (R := R) (M := M) ((k + 2 : ℕ) : ℤ)
      = fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ)
          * fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ)
          * Ideal.span {d.equation (k + 1)} :=
  fittingIdeal_mul_fittingIdeal_of_prod (fun hj => d.isUnit_equation hj) d.fittingIdeal_eq k

section Transport

variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]
  {M₂ : Type w} [AddCommGroup M₂] [Module R M₂] [Module.Finite R M₂]

omit [Module.Finite R M] [Module.Finite R M₂] in
/-- Multiplication by `c` carries a filtration step of one module onto the corresponding step of
an isomorphic one. -/
theorem map_range_lsmul_of_equiv (e : M ≃ₗ[R] M₂) (c : R) :
    Submodule.map e.toLinearMap (LinearMap.range (LinearMap.lsmul R M c)) =
      LinearMap.range (LinearMap.lsmul R M₂ c) := by
  rw [← LinearMap.range_comp,
    show e.toLinearMap ∘ₗ LinearMap.lsmul R M c
        = (LinearMap.lsmul R M₂ c) ∘ₗ e.toLinearMap by ext x; simp,
    LinearMap.range_comp, LinearMap.range_eq_top.mpr e.surjective, Submodule.map_top]

omit [Module.Finite R M] [Module.Finite R M₂] in
/-- What `c` kills in one module corresponds to what it kills in an isomorphic one. -/
theorem map_ker_lsmul_of_equiv (e : M ≃ₗ[R] M₂) (c : R) :
    Submodule.map e.toLinearMap (LinearMap.ker (LinearMap.lsmul R M c)) =
      LinearMap.ker (LinearMap.lsmul R M₂ c) := by
  refine Submodule.ext fun y => ⟨?_, ?_⟩
  · rintro ⟨x, hx, rfl⟩
    have hx' : c • x = 0 := hx
    show c • (e x) = 0
    rw [← e.map_smul, hx', map_zero]
  · intro hy
    have hy' : c • y = 0 := hy
    refine ⟨e.symm y, ?_, by simp⟩
    show c • (e.symm y) = 0
    rw [← e.symm.map_smul, hy', map_zero]

/-- The local package transports along an isomorphism of modules. -/
def LocalData.ofLinearEquiv {N : ℕ} (e : M ≃ₗ[R] M₂) (d : LocalData R M N) :
    LocalData R M₂ N where
  equation := d.equation
  equation_mem := d.equation_mem
  isUnit_equation hj := d.isUnit_equation hj
  fittingIdeal_eq k := by
    rw [← fittingIdeal_eq_of_linearEquiv_int e (k : ℤ)]
    exact d.fittingIdeal_eq k
  incr_zero := by
    rw [incr, ← map_range_lsmul_of_equiv e, ← incr, d.incr_zero, Submodule.map_bot]
  decr_one := by
    rw [decr, ← map_ker_lsmul_of_equiv e, ← decr, d.decr_one, Submodule.map_top,
      LinearMap.range_eq_top.mpr e.surjective]
  incr_graded i := by
    obtain ⟨ε⟩ := d.incr_graded i
    have h1 : ∀ j : ℕ, (incr M d.equation N j).map e.toLinearMap = incr M₂ d.equation N j :=
      fun _ => map_range_lsmul_of_equiv e _
    have key := gradedQuotMapEquiv e.toLinearMap e.injective
      (incr M d.equation N i) (incr M d.equation N (i + 1))
    rw [h1 i, h1 (i + 1)] at key
    exact ⟨key.symm.trans ε⟩
  decr_graded i := by
    obtain ⟨ε⟩ := d.decr_graded i
    have h1 : ∀ j : ℕ, (decr M d.equation N j).map e.toLinearMap = decr M₂ d.equation N j :=
      fun _ => map_ker_lsmul_of_equiv e _
    have key := gradedQuotMapEquiv e.toLinearMap e.injective
      (decr M d.equation N (i + 2)) (decr M d.equation N (i + 1))
    rw [h1 (i + 2), h1 (i + 1)] at key
    exact ⟨key.symm.trans ε⟩

end Transport

/-! ### Subsingleton modules -/

section Subsingleton

variable {M : Type v} [AddCommGroup M] [Module R M]

/-- A quotient of a module with one element has one element. -/
theorem subsingleton_quotient [Subsingleton M] (P : Submodule R M) : Subsingleton (M ⧸ P) := by
  refine ⟨fun a b => ?_⟩
  induction a using Submodule.Quotient.induction_on with
  | _ x =>
    induction b using Submodule.Quotient.induction_on with
    | _ y =>
      exact congrArg (fun z : M => (Submodule.Quotient.mk z : M ⧸ P)) (Subsingleton.elim x y)

/-- A graded piece inside a module with one element has one element. -/
theorem subsingleton_gradedQuot_of_subsingleton [Subsingleton M] (N P : Submodule R M) :
    Subsingleton (gradedQuot N P) := by
  have : Subsingleton ↥P := ⟨fun a b => Subtype.ext (Subsingleton.elim _ _)⟩
  exact subsingleton_quotient _

/-- Inside a module with one element every submodule is zero. -/
theorem eq_bot_of_subsingleton [Subsingleton M] (P : Submodule R M) : P = ⊥ :=
  (Submodule.eq_bot_iff _).mpr fun x _ => Subsingleton.elim x 0

/-- Inside a module with one element every submodule is everything. -/
theorem eq_top_of_subsingleton [Subsingleton M] (P : Submodule R M) : P = ⊤ :=
  Submodule.eq_top_iff'.mpr fun x => by
    rw [Subsingleton.elim x 0]
    exact P.zero_mem

end Subsingleton

/-! ### The inductive step -/

/-- The local equations after adjoining a new top divisor, the one cut out by `f`. -/
def stepEquation (d : ℕ → R) (f : R) (m : ℕ) : ℕ → R := fun j => if j = m + 1 then f else d j

omit [CommRing R] in
/-- Away from index `m + 1`, `stepEquation d f m` agrees with `d`. -/
theorem stepEquation_ne {d : ℕ → R} {f : R} {m j : ℕ} (hj : j ≠ m + 1) :
    stepEquation d f m j = d j := by simp [stepEquation, hj]

omit [CommRing R] in
/-- At index `m + 1`, `stepEquation d f m` takes the value `f`. -/
theorem stepEquation_top {d : ℕ → R} {f : R} {m : ℕ} : stepEquation d f m (m + 1) = f := by
  simp [stepEquation]

/-- A graded piece with one element is isomorphic to a free module over the ring of functions on
an empty divisor. -/
private theorem nonempty_equiv_pi_quotient_of_subsingleton {M : Type v} [AddCommGroup M]
    [Module R M] {N P : Submodule R M} [Subsingleton (gradedQuot N P)] {c : R} (hc : IsUnit c)
    (k : ℕ) : Nonempty (gradedQuot N P ≃ₗ[R] (Fin k → R ⧸ Ideal.span {c})) :=
  have := subsingleton_pi_quotient_span_singleton hc k
  ⟨subsingletonEquiv _ _⟩

/-- The product of the local equations after adjoining the new top divisor picks up the factor
`f`. -/
theorem divisorProd_stepEquation (d : ℕ → R) (f : R) {m i : ℕ} (h : i ≤ m + 1) :
    divisorProd (stepEquation d f m) (m + 1) i = divisorProd d m i * f := by
  rw [divisorProd_succ_top _ h, stepEquation_top]
  congr 1
  rw [divisorProd, divisorProd]
  refine Finset.prod_congr rfl fun j hj => stepEquation_ne ?_
  have := (Finset.mem_Icc.mp hj).2
  omega

section Step

variable {m : ℕ} (B : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (f : R)

/-- **Multiplication by `f` carries the increasing filtration of `𝓕'` into that of `𝓕`.** The
image under `Stacks.ScaledPresentation.ofBase` of the image of multiplication by `c` on `𝓕'` is
the image of multiplication by `c f` on `𝓕`. -/
theorem map_ofBase_range_lsmul (c : R) :
    Submodule.map (ofBase B f) (LinearMap.range (LinearMap.lsmul R (Cokernel B) c)) =
      LinearMap.range (LinearMap.lsmul R (Cokernel (f • B)) (c * f)) := by
  have hcomm : (ofBase B f) ∘ₗ LinearMap.lsmul R (Cokernel B) c
      = (LinearMap.lsmul R (Cokernel (f • B)) c) ∘ₗ (ofBase B f) := by
    refine LinearMap.ext fun x => ?_
    show ofBase B f (c • x) = c • (ofBase B f x)
    rw [map_smul]
  rw [← LinearMap.range_comp, hcomm, LinearMap.range_comp,
    ← range_lsmul_eq_range_ofBase B f, ← LinearMap.range_comp, lsmul_comp_lsmul]

/-- **The decreasing filtration of `𝓕` below the top is the preimage of that of `𝓕'`.** The
preimage under `Stacks.ScaledPresentation.toBase` of what `c` kills on `𝓕'` is what `c f` kills on
`𝓕`. -/
theorem comap_toBase_ker_lsmul (hf : f ∈ nonZeroDivisors R) (c : R) :
    Submodule.comap (toBase B f) (LinearMap.ker (LinearMap.lsmul R (Cokernel B) c)) =
      LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) (c * f)) := by
  have hcomm : (LinearMap.lsmul R (Cokernel B) c) ∘ₗ (toBase B f)
      = (toBase B f) ∘ₗ (LinearMap.lsmul R (Cokernel (f • B)) c) := by
    refine LinearMap.ext fun x => ?_
    show c • (toBase B f x) = toBase B f (c • x)
    rw [map_smul]
  have hkt : LinearMap.ker (toBase B f)
      = LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) f) := by
    rw [ker_toBase B f, ker_lsmul_eq_range_ofQuotSmul B f hf]
  rw [← LinearMap.ker_comp, hcomm, LinearMap.ker_comp, hkt, ← LinearMap.ker_comp,
    lsmul_comp_lsmul, mul_comm f c]

/-- Below the top the increasing filtration of `𝓕` is the image of that of `𝓕'`. -/
theorem incr_step (d : ℕ → R) {i : ℕ} (hi : i ≤ m) :
    incr (Cokernel (f • B)) (stepEquation d f m) (m + 1) i =
      Submodule.map (ofBase B f) (incr (Cokernel B) d m i) := by
  rw [incr, incr, map_ofBase_range_lsmul,
    divisorProd_stepEquation d f (by omega : i + 1 ≤ m + 1)]

/-- Below the top the decreasing filtration of `𝓕` is the preimage of that of `𝓕'`. -/
theorem decr_step (d : ℕ → R) (hf : f ∈ nonZeroDivisors R) {i : ℕ} (hi : i ≤ m + 1) :
    decr (Cokernel (f • B)) (stepEquation d f m) (m + 1) i =
      Submodule.comap (toBase B f) (decr (Cokernel B) d m i) := by
  rw [decr, decr, comap_toBase_ker_lsmul B f hf, divisorProd_stepEquation d f hi]

/-- **The inductive step of Stacks tag 0ESU.** Let `𝓕 = Rⁿ / (f A') Rⁿ` with `n = m + 1`, let `f`
be a nonzerodivisor and let `A'` be injective, and suppose the divisors and the two filtrations
are already known for `𝓕' = Rⁿ / A' Rⁿ` with `m` divisors. Then they are known for `𝓕` with
`m + 1` divisors: the new top divisor is the one cut out by `f`, the new top graded piece of the
increasing filtration is `𝓕 ⧸ f 𝓕` and that of the decreasing filtration is
`Ker(f : 𝓕 → 𝓕)`, both free of rank `n` over `R ⧸ (f)`, and the pieces below the top are those
of `𝓕'`. -/
def stepData (hf : f ∈ nonZeroDivisors R) (hB : Function.Injective B.mulVecLin)
    (d : LocalData R (Cokernel B) m) : LocalData R (Cokernel (f • B)) (m + 1) where
  equation := stepEquation d.equation f m
  equation_mem j := by
    by_cases hj : j = m + 1
    · rw [hj, stepEquation_top]; exact hf
    · rw [stepEquation_ne hj]; exact d.equation_mem j
  isUnit_equation hj := by
    rw [stepEquation_ne (by omega)]
    exact d.isUnit_equation (by omega)
  fittingIdeal_eq k := by
    rw [fittingIdeal_cokernel_smul B f k, d.fittingIdeal_eq k]
    rcases le_or_gt k m with hk | hk
    · rw [Finset.prod_Icc_succ_top (by omega : k + 1 ≤ m + 1), stepEquation_top,
        show (∏ j ∈ Finset.Icc (k + 1) m,
              Ideal.span {stepEquation d.equation f m j} ^ (j - k))
            = ∏ j ∈ Finset.Icc (k + 1) m, Ideal.span {d.equation j} ^ (j - k) from
          Finset.prod_congr rfl fun j hj => by
            rw [stepEquation_ne (by have := (Finset.mem_Icc.mp hj).2; omega)]]
      exact mul_comm _ _
    · rw [Finset.Icc_eq_empty (show ¬ k + 1 ≤ m + 1 by omega), Finset.prod_empty,
        Finset.Icc_eq_empty (show ¬ k + 1 ≤ m by omega), Finset.prod_empty,
        show m + 1 - k = 0 from by omega, pow_zero, one_mul]
  incr_zero := by
    rw [incr_step B f d.equation (by omega : 0 ≤ m), d.incr_zero, Submodule.map_bot]
  decr_one := by
    rw [decr_step B f d.equation hf (by omega : 1 ≤ m + 1), d.decr_one, Submodule.comap_top]
  incr_graded i := by
    rcases lt_trichotomy i m with hi | hi | hi
    · obtain ⟨ε⟩ := d.incr_graded i
      have h1 := incr_step B f d.equation (le_of_lt hi)
      have h2 := incr_step B f d.equation (by omega : i + 1 ≤ m)
      have key := gradedQuotMapEquiv (ofBase B f) (ofBase_injective B f hf)
        (incr (Cokernel B) d.equation m i) (incr (Cokernel B) d.equation m (i + 1))
      rw [← h1, ← h2] at key
      rw [stepEquation_ne (by omega : i + 1 ≠ m + 1)]
      exact ⟨key.symm.trans ε⟩
    · rw [hi]
      have hinc : incr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) m
          = LinearMap.range (LinearMap.lsmul R (Cokernel (f • B)) f) := by
        rw [incr, divisorProd_self, stepEquation_top]
      have htop : incr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) (m + 1) = ⊤ :=
        incr_eq_top _ le_rfl
      have hker : LinearMap.range (LinearMap.lsmul R (Cokernel (f • B)) f)
          = LinearMap.ker (toFree B f) := by
        rw [ker_toFree, range_lsmul_eq_range_ofBase]
      rw [hinc, htop, stepEquation_top]
      exact ⟨(gradedQuotTopEquiv _).trans ((Submodule.quotEquivOfEq _ _ hker).trans
        (LinearMap.quotKerEquivOfSurjective (toFree B f) (toFree_surjective B f)))⟩
    · have h1 : incr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) i = ⊤ :=
        incr_eq_top _ (by omega)
      have h2 : incr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) (i + 1) = ⊤ :=
        incr_eq_top _ (by omega)
      have hu : IsUnit (stepEquation d.equation f m (i + 1)) := by
        rw [stepEquation_ne (by omega)]
        exact d.isUnit_equation (by omega)
      have := subsingleton_pi_quotient_span_singleton hu (i + 1)
      rw [h1, h2]
      have := subsingleton_gradedQuot_self (⊤ : Submodule R (Cokernel (f • B)))
      exact ⟨subsingletonEquiv _ _⟩
  decr_graded i := by
    rcases lt_trichotomy i m with hi | hi | hi
    · obtain ⟨ε⟩ := d.decr_graded i
      have h1 := decr_step B f d.equation hf (by omega : i + 2 ≤ m + 1)
      have h2 := decr_step B f d.equation hf (by omega : i + 1 ≤ m + 1)
      have key := gradedQuotComapEquiv (toBase B f) (toBase_surjective B f)
        (decr (Cokernel B) d.equation m (i + 2)) (decr (Cokernel B) d.equation m (i + 1))
      rw [← h1, ← h2] at key
      rw [stepEquation_ne (by omega : i + 1 ≠ m + 1)]
      exact ⟨key.trans ε⟩
    · rw [hi]
      have hdec : decr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) (m + 1)
          = LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) f) := by
        rw [decr, divisorProd_self, stepEquation_top]
      have hbot : decr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) (m + 2) = ⊥ :=
        decr_eq_bot _ (by omega)
      have hrange : LinearMap.range (ofFree B f)
          = LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) f) :=
        (ker_lsmul_eq_range_ofFree B f hf).symm
      rw [show m + 1 + 1 = m + 2 from rfl, hbot, hdec, stepEquation_top]
      exact ⟨(gradedQuotBotEquiv _).trans
        (((LinearEquiv.ofInjective (ofFree B f) (ofFree_injective B f hB)).trans
          (LinearEquiv.ofEq _ _ hrange)).symm)⟩
    · have h1 : decr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) (i + 1) = ⊥ :=
        decr_eq_bot _ (by omega)
      have h2 : decr (Cokernel (f • B)) (stepEquation d.equation f m) (m + 1) (i + 2) = ⊥ :=
        decr_eq_bot _ (by omega)
      have hu : IsUnit (stepEquation d.equation f m (i + 1)) := by
        rw [stepEquation_ne (by omega)]
        exact d.isUnit_equation (by omega)
      have := subsingleton_pi_quotient_span_singleton hu (i + 1)
      rw [h1, h2]
      have := subsingleton_gradedQuot_self (⊥ : Submodule R (Cokernel (f • B)))
      exact ⟨subsingletonEquiv _ _⟩

end Step

/-! ### The induction -/

/-- In a local ring a family generating the unit ideal has a unit member: otherwise it would lie
in the maximal ideal. -/
theorem exists_isUnit_of_span_eq_top [IsLocalRing R] {s : Set R} (h : Ideal.span s = ⊤) :
    ∃ x ∈ s, IsUnit x := by
  by_contra hc
  simp only [not_exists, not_and] at hc
  have hle : Ideal.span s ≤ IsLocalRing.maximalIdeal R :=
    Ideal.span_le.mpr fun x hx => (IsLocalRing.mem_maximalIdeal x).mpr (hc x hx)
  rw [h] at hle
  exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp hle)

/-- **The induction of Stacks tag 0ESU, over a local ring.** For a square injective presentation
matrix of size `n` over a local ring all of whose Fitting ideals are generated by nonzerodivisors,
the local equations of the divisors `D_1, …, D_n`, the two filtrations and their graded pieces
exist. -/
theorem nonempty_localData [IsLocalRing R] : ∀ (n : ℕ) (A : Matrix (Fin n) (Fin n) R),
    Function.Injective A.mulVecLin →
    (∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
      fittingIdeal (R := R) (M := Cokernel A) (k : ℤ) = Ideal.span {g}) →
    Nonempty (LocalData R (Cokernel A) n) := by
  intro n
  induction n with
  | zero =>
    intro A _ _
    have hsub : Subsingleton (Cokernel A) := subsingleton_quotient _
    refine ⟨{ equation := fun _ => 1
              equation_mem := fun _ => one_mem _
              isUnit_equation := fun _ => isUnit_one
              fittingIdeal_eq := ?_
              incr_zero := ?_
              decr_one := ?_
              incr_graded := ?_
              decr_graded := ?_ }⟩
    · intro k
      have he : Cokernel A ≃ₗ[R] (Fin 0 → R) := subsingletonEquiv _ _
      rw [fittingIdeal_eq_of_linearEquiv_int he (k : ℤ),
        fittingIdeal_fin_eq_bot_or_top 0 (k : ℤ), if_neg (by push_cast; omega),
        Finset.Icc_eq_empty (by omega), Finset.prod_empty]
      exact Ideal.one_eq_top.symm
    · exact eq_bot_of_subsingleton _
    · exact eq_top_of_subsingleton _
    · intro i
      have := subsingleton_gradedQuot_of_subsingleton
        (incr (Cokernel A) (fun _ => (1 : R)) 0 i) (incr (Cokernel A) (fun _ => (1 : R)) 0 (i + 1))
      exact nonempty_equiv_pi_quotient_of_subsingleton isUnit_one _
    · intro i
      have := subsingleton_gradedQuot_of_subsingleton
        (decr (Cokernel A) (fun _ => (1 : R)) 0 (i + 2))
        (decr (Cokernel A) (fun _ => (1 : R)) 0 (i + 1))
      exact nonempty_equiv_pi_quotient_of_subsingleton isUnit_one _
  | succ m ih =>
    intro A hA hfit
    obtain ⟨f, hf, hfitm⟩ := hfit m
    obtain ⟨A', hAA', hA'inj, -, -⟩ := exists_eq_smul_and_shortExact f A hf hA hfitm
    subst hAA'
    have hfit' : ∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
        fittingIdeal (R := R) (M := Cokernel A') (k : ℤ) = Ideal.span {g} := by
      intro k
      obtain ⟨g, hg, hgk⟩ := hfit k
      refine exists_span_singleton_of_pow_mul_eq_span_singleton (e := m + 1 - k) hf hg ?_
      rw [← fittingIdeal_cokernel_smul A' f k, hgk]
    have htop : fittingIdeal (R := R) (M := Cokernel A') (m : ℤ) = ⊤ :=
      fittingIdeal_cokernel_eq_top_of_fittingIdeal_smul_eq_span_singleton f A' hf hfitm
    obtain ⟨x, hxmem, hxunit⟩ :=
      exists_isUnit_of_span_eq_top (span_entries_eq_top_of_fittingIdeal_eq_top A' htop)
    obtain ⟨p, hp⟩ := hxmem
    obtain ⟨ψ, ⟨e⟩, hψ⟩ := exists_cokernel_equiv_of_isUnit_entry A' p.1 p.2
      (by rw [show A' p.1 p.2 = x from hp]; exact hxunit)
    have hψfit : ∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
        fittingIdeal (R := R) (M := Cokernel ψ) (k : ℤ) = Ideal.span {g} := by
      intro k
      obtain ⟨g, hg, hgk⟩ := hfit' k
      exact ⟨g, hg, by rw [← fittingIdeal_eq_of_linearEquiv_int e (k : ℤ)]; exact hgk⟩
    obtain ⟨d0⟩ := ih ψ (hψ hA'inj) hψfit
    exact ⟨stepData A' f hf hA'inj (d0.ofLinearEquiv e.symm)⟩

/-- **The local form of Stacks tag 0ESU: the divisors and the two filtrations.** Let `R` be a
local ring and let `𝓕 = Rⁿ / A Rⁿ` be presented by a square matrix `A` with `A` injective, and
suppose every Fitting ideal `Fit_k(𝓕)`, `k ≥ 0`, is generated by a nonzerodivisor. Then there are
local equations `f_j` of divisors `D_j` such that

* each `f_j` is a nonzerodivisor, so `D_j` is an effective Cartier divisor, and `f_j` is a unit
  for `j > n`, so only finitely many `D_j` are nonempty;
* `Fit_k(𝓕) = ∏_{j > k} (f_j)^{j - k}`, which is the source's
  `E_k = D_{k+1} + 2 D_{k+2} + 3 D_{k+3} + ⋯`;
* the increasing filtration `F^i = (f_{i+1} ⋯ f_n) · 𝓕` runs from `F^0 = 0` to `F^i = 𝓕` for
  `i ≥ n`, and the decreasing filtration `F_i = Ker(f_i ⋯ f_n : 𝓕 → 𝓕)` runs from `F_1 = 𝓕` to
  `F_i = 0` for `i > n`;
* for every `i ≥ 1` both graded pieces `F^i/F^{i-1}` and `F_i/F_{i+1}` are free of rank `i` over
  `R ⧸ (f_i)`, the ring of functions on `D_i`.

Both filtrations are canonical: their steps are the image and the kernel of multiplication by a
product of the `f_j`, and the `f_j` are pinned down by the Fitting ideals through the displayed
identity. -/
theorem exists_divisors_and_filtrations [IsLocalRing R] {n : ℕ}
    (A : Matrix (Fin n) (Fin n) R) (hA : Function.Injective A.mulVecLin)
    (hfit : ∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
      fittingIdeal (R := R) (M := Cokernel A) (k : ℤ) = Ideal.span {g}) :
    ∃ e : ℕ → R,
      (∀ j, e j ∈ nonZeroDivisors R) ∧
      (∀ j, n < j → IsUnit (e j)) ∧
      (∀ k : ℕ, fittingIdeal (R := R) (M := Cokernel A) (k : ℤ) =
        ∏ j ∈ Finset.Icc (k + 1) n, Ideal.span {e j} ^ (j - k)) ∧
      incr (Cokernel A) e n 0 = ⊥ ∧
      (∀ i, n ≤ i → incr (Cokernel A) e n i = ⊤) ∧
      Monotone (incr (Cokernel A) e n) ∧
      decr (Cokernel A) e n 1 = ⊤ ∧
      (∀ i, n < i → decr (Cokernel A) e n i = ⊥) ∧
      Antitone (decr (Cokernel A) e n) ∧
      (∀ i : ℕ, Nonempty (gradedQuot (incr (Cokernel A) e n i) (incr (Cokernel A) e n (i + 1))
        ≃ₗ[R] (Fin (i + 1) → R ⧸ Ideal.span {e (i + 1)}))) ∧
      (∀ i : ℕ, Nonempty (gradedQuot (decr (Cokernel A) e n (i + 2))
        (decr (Cokernel A) e n (i + 1))
        ≃ₗ[R] (Fin (i + 1) → R ⧸ Ideal.span {e (i + 1)}))) := by
  obtain ⟨d⟩ := nonempty_localData n A hA hfit
  exact ⟨d.equation, d.equation_mem, fun _ hj => d.isUnit_equation hj, d.fittingIdeal_eq,
    d.incr_zero, fun _ hi => incr_eq_top _ hi, incr_monotone _ _, d.decr_one,
    fun _ hi => decr_eq_bot _ hi, decr_antitone _ _, d.incr_graded, d.decr_graded⟩

/-! ### The hypotheses are met -/

/-- The `1 × 1` matrix of a nonzerodivisor `g` is injective, and every Fitting ideal of its
cokernel `R ⧸ (g)` is generated by a nonzerodivisor: `(g)` in index `0` and the unit ideal above.
-/
theorem injective_and_forall_fittingIdeal_eq_span_singleton {g : R}
    (hg : g ∈ nonZeroDivisors R) :
    Function.Injective (Matrix.of (fun _ _ : Fin 1 => g)).mulVecLin ∧
      ∀ k : ℕ, ∃ z ∈ nonZeroDivisors R,
        fittingIdeal (R := R) (M := Cokernel (Matrix.of (fun _ _ : Fin 1 => g))) (k : ℤ)
          = Ideal.span {z} := by
  have hpres : ∀ k : ℕ,
      fittingIdeal (R := R) (M := Cokernel (Matrix.of (fun _ _ : Fin 1 => g))) (k : ℤ)
        = minorIdeal (Matrix.of (fun _ _ : Fin 1 => g)) (1 - k) := fun k =>
    fittingIdeal_eq_minorIdeal_of_presentation (Matrix.of (fun _ _ : Fin 1 => g)) k
      (Submodule.quotEquivOfEq _ _
        (Matrix.columnSpan_eq_range_mulVecLin (Matrix.of (fun _ _ : Fin 1 => g))))
  refine ⟨fun v w hvw => ?_, fun k => ?_⟩
  · have h0 : g * v 0 = g * w 0 := by
      have h1 := congrFun (show (Matrix.of (fun _ _ : Fin 1 => g)) *ᵥ v
        = (Matrix.of (fun _ _ : Fin 1 => g)) *ᵥ w from hvw) 0
      simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_one] using h1
    have hv : v 0 = w 0 := by
      have h2 : g * (v 0 - w 0) = 0 := by linear_combination h0
      exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff.mp hg).1 _ h2)
    funext i
    rw [Subsingleton.elim i 0]
    exact hv
  · rcases Nat.eq_zero_or_pos k with hk | hk
    · refine ⟨g, hg, ?_⟩
      rw [hk, hpres 0, show 1 - 0 = 1 from rfl, Stacks.Curves.minorIdeal_one]
      congr 1
      ext x
      constructor
      · rintro ⟨i, j, rfl⟩
        rfl
      · rintro rfl
        exact ⟨0, 0, rfl⟩
    · refine ⟨1, one_mem _, ?_⟩
      rw [hpres k, show 1 - k = 0 from by omega, minorIdeal_zero, Ideal.span_singleton_one]

end Stacks.FittingFiltration

end
