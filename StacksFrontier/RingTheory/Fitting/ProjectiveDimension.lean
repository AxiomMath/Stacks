/-!
# A principal Fitting ideal splits a finitely presented module

Let `M` be a finitely presented module over a commutative ring `R`, let `k : ℕ`, and suppose the
`k`th Fitting ideal of `M` is generated by a nonzerodivisor `f` while the `(k - 1)`st vanishes.
Then `M` splits: writing `T` for the submodule of elements killed by `f`, the quotient `M ⧸ T` is
finite locally free of rank `k`, `T` is exactly the `f`-power torsion of `M`, both `M` and `T`
have projective dimension at most one, and `M ≅ (M ⧸ T) × T`.

## Main results

* `hasProjectiveDimensionLE_one_and_split_of_fittingIdeal_eq_span_singleton`: the five conclusions
  of the source, as a single conjunction.

## Implementation notes

The argument is the source's and runs first over a local ring, then globalizes. Locally, Stacks
080Z (`exists_fin_generating_family_quotient_ker_lsmul_of_fittingIdeal_eq_span_singleton`) gives
`k` elements generating `M ⧸ T`; the vanishing of `Fit_{k-1}(M)` makes them independent over the
localization at `f`, and since `f` is a nonzerodivisor it makes them independent outright, so
`M ≅ Rᵏ × T` locally. That reduces the claim to the case `k = 0`, where `M` is killed by `f` and
the adjugate identity of `StacksFrontier.LinearAlgebra.Matrix.MaximalMinors` shows a presentation
matrix has the same image as a square block with nonzerodivisor determinant, giving projective
dimension at most one. Globalizing uses that a finite module which is free of constant rank at
every prime is finite locally free, so the local splittings assemble and the extension
`0 → T → M → M ⧸ T → 0` splits.

## References

* [Stacks Project, Tag 0F7M](https://stacks.math.columbia.edu/tag/0F7M)
-/

open CategoryTheory
open scoped TensorProduct

universe u v uR uU uV

@[expose] public section


/-- **Fitting ideals commute with localization at a prime**: the `k`th Fitting ideal of the
localized module is the ideal generated by the image of the `k`th Fitting ideal.

This is the base-change clause of `fittingIdeal_basic_properties` read through the identification
of the localized module with a tensor product. -/
@[sga "7 VI 5.1" "5.1(a), special case"]
public lemma fittingIdeal_localizedAtPrime_eq_map {R : Type uR} {M : Type uU}
    [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (p : Ideal R) [p.IsPrime] (k : ℕ) :
    fittingIdeal (R := Localization.AtPrime p)
      (M := LocalizedModule.AtPrime p M) (k : ℤ) =
      Ideal.map (algebraMap R (Localization.AtPrime p))
        (fittingIdeal (R := R) (M := M) (k : ℤ)) := by
  let e : LocalizedModule.AtPrime p M ≃ₗ[Localization.AtPrime p]
      Localization.AtPrime p ⊗[R] M :=
    LocalizedModule.equivTensorProduct p.primeCompl M
  rw [fittingIdeal_eq_of_linearEquiv e k]
  exact (fittingIdeal_basic_properties.{uR, uU, uU, uR}
    (R := R) (M := M)).2.2.1 (Localization.AtPrime p) k

private alias fittingIdeal_localized_eq_map := fittingIdeal_localizedAtPrime_eq_map

private lemma fittingIdeal_localized_pair {R : Type uR} {M : Type uU}
    [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (p : Ideal R) [p.IsPrime] (k : ℕ) (f : R)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    fittingIdeal (R := Localization.AtPrime p)
      (M := LocalizedModule.AtPrime p M) (k : ℤ) =
        Ideal.span {algebraMap R (Localization.AtPrime p) f} ∧
    fittingIdeal (R := Localization.AtPrime p)
      (M := LocalizedModule.AtPrime p M) ((k : ℤ) - 1) = ⊥ := by
  refine ⟨by rw [fittingIdeal_localized_eq_map p k, hk, Ideal.map_span, Set.image_singleton], ?_⟩
  rcases k with _ | j
  · simp [fittingIdeal]
  · rw [show ((j + 1 : ℕ) : ℤ) - 1 = j by omega] at hkm1 ⊢
    rw [fittingIdeal_localized_eq_map p j, hkm1, Ideal.map_bot]

private noncomputable abbrev localized_fin_pi_equiv {R : Type*} [CommRing R]
    (p : Ideal R) [p.IsPrime] (n : ℕ) :
    (Fin n → Localization.AtPrime p) ≃ₗ[Localization.AtPrime p]
      LocalizedModule p.primeCompl (Fin n → R) :=
  (TensorProduct.piScalarRight R (Localization.AtPrime p)
    (Localization.AtPrime p) (Fin n)).symm.trans
    (LocalizedModule.equivTensorProduct p.primeCompl (Fin n → R)).symm

private lemma localized_fin_presentation_surjective {R M : Type*}
    [CommRing R] [AddCommGroup M] [Module R M]
    (p : Ideal R) [p.IsPrime] (n : ℕ)
    (g : (Fin n → R) →ₗ[R] M) (hg : Function.Surjective g) :
    Function.Surjective
      (((IsLocalizedModule.map p.primeCompl
        (LocalizedModule.mkLinearMap p.primeCompl (Fin n → R))
        (LocalizedModule.mkLinearMap p.primeCompl M) g).extendScalarsOfIsLocalization
        p.primeCompl (Localization.AtPrime p)).comp
        (localized_fin_pi_equiv p n).toLinearMap) :=
  (IsLocalizedModule.map_surjective p.primeCompl
    (LocalizedModule.mkLinearMap p.primeCompl (Fin n → R))
    (LocalizedModule.mkLinearMap p.primeCompl M) g hg).comp
      (localized_fin_pi_equiv p n).surjective

private theorem localized_kernel_equiv {R P M : Type*}
    [CommRing R] [AddCommGroup P] [Module R P]
    [AddCommGroup M] [Module R M]
    (p : Ideal R) [p.IsPrime] (g : P →ₗ[R] M) :
    Nonempty (LocalizedModule p.primeCompl (LinearMap.ker g) ≃ₗ[Localization.AtPrime p]
      LinearMap.ker
        ((IsLocalizedModule.map p.primeCompl
          (LocalizedModule.mkLinearMap p.primeCompl P)
          (LocalizedModule.mkLinearMap p.primeCompl M) g).extendScalarsOfIsLocalization
          p.primeCompl (Localization.AtPrime p))) :=
  ⟨((LinearMap.ker g).localizedEquiv p.primeCompl).symm.trans
    (LinearEquiv.ofEq _ _ (LinearMap.localized'_ker_eq_ker_localizedMap
      (Localization.AtPrime p) p.primeCompl (LocalizedModule.mkLinearMap p.primeCompl P)
      (LocalizedModule.mkLinearMap p.primeCompl M) g))⟩

/-- **The localization of multiplication by a ring element is multiplication by its image.** The
two maps agree on the image of `M`, and a localized map is determined by its values there. -/
public lemma localizedMap_lsmul {R M : Type*}
    [CommRing R] [AddCommGroup M] [Module R M]
    (p : Ideal R) [p.IsPrime] (f : R) :
    (IsLocalizedModule.map p.primeCompl
        (LocalizedModule.mkLinearMap p.primeCompl M)
        (LocalizedModule.mkLinearMap p.primeCompl M)
        (LinearMap.lsmul R M f)).extendScalarsOfIsLocalization
          p.primeCompl (Localization.AtPrime p) =
      LinearMap.lsmul (Localization.AtPrime p) (LocalizedModule.AtPrime p M)
        (algebraMap R (Localization.AtPrime p) f) := by
  ext x
  obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective p.primeCompl
    (LocalizedModule.mkLinearMap p.primeCompl M) x
  simp [IsLocalizedModule.map_mk', IsLocalizedModule.mk'_smul]

/-- **What a ring element kills localizes to what its image kills.** This is one step of the
decreasing filtration of Stacks tag 0ESU passing to a localization: its steps are the kernels of
multiplication by a product of the local equations. -/
public lemma ker_lsmul_localizedAtPrime {R M : Type*}
    [CommRing R] [AddCommGroup M] [Module R M]
    (p : Ideal R) [p.IsPrime] (f : R) :
    (LinearMap.ker (LinearMap.lsmul R M f)).localized p.primeCompl =
      LinearMap.ker (LinearMap.lsmul (Localization.AtPrime p)
        (LocalizedModule.AtPrime p M)
        (algebraMap R (Localization.AtPrime p) f)) :=
  (LinearMap.localized'_ker_eq_ker_localizedMap (Localization.AtPrime p) p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl M)
      (LocalizedModule.mkLinearMap p.primeCompl M) (LinearMap.lsmul R M f)).trans
    (congrArg LinearMap.ker (localizedMap_lsmul p f))

/-- **The multiples of a ring element localize to the multiples of its image.** This is one step
of the increasing filtration of Stacks tag 0ESU passing to a localization: its steps are the
images of multiplication by a product of the local equations. -/
public lemma range_lsmul_localized {R M : Type*}
    [CommRing R] [AddCommGroup M] [Module R M]
    (p : Ideal R) [p.IsPrime] (f : R) :
    (LinearMap.range (LinearMap.lsmul R M f)).localized p.primeCompl =
      LinearMap.range (LinearMap.lsmul (Localization.AtPrime p)
        (LocalizedModule.AtPrime p M)
        (algebraMap R (Localization.AtPrime p) f)) :=
  (LinearMap.localized'_range_eq_range_localizedMap (Localization.AtPrime p) p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl M)
      (LocalizedModule.mkLinearMap p.primeCompl M) (LinearMap.lsmul R M f)).trans
    (congrArg LinearMap.range (localizedMap_lsmul p f))

private alias ker_lsmul_localized := ker_lsmul_localizedAtPrime

private theorem exists_mem_eq_unit_mul_of_regular {R : Type*}
    [CommRing R] [IsLocalRing R] (S : Set R) (f : R) (hf : IsRegular f)
    (hsub : S ⊆ Ideal.span {f}) (hspan : Ideal.span S = Ideal.span {f}) :
    ∃ e ∈ S, ∃ u : R, IsUnit u ∧ e = u * f := by
  classical
  have hfmem : f ∈ Ideal.span S := hspan.symm ▸ Ideal.mem_span_singleton_self f
  obtain ⟨c, hc⟩ := (Finsupp.mem_span_iff_linearCombination R S f).mp hfmem
  choose a ha using fun e : S => Ideal.mem_span_singleton'.mp (hsub e.property)
  have hsum : (∑ e ∈ c.support, c e * a e) * f = f := by
    rw [Finset.sum_mul]
    rw [Finsupp.linearCombination_apply] at hc
    simpa only [Finsupp.sum, smul_eq_mul, mul_assoc, ha] using hc
  have hsum1 : (∑ e ∈ c.support, c e * a e) = 1 := by
    apply hf.smul_right_injective R
    simpa only [smul_eq_mul, mul_comm, mul_one] using hsum
  obtain ⟨e, he, heunit⟩ := IsLocalRing.exists_of_isUnit_sum (hsum1 ▸ isUnit_one)
  exact ⟨e, e.property, a e, isUnit_of_mul_isUnit_right heunit, (ha e).symm⟩

private theorem nonempty_equiv_quotient_prod_of_projective
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (T : Submodule R M) [Module.Projective R (M ⧸ T)] :
    Nonempty (M ≃ₗ[R] (M ⧸ T) × T) := by
  obtain ⟨s, hs⟩ :=
    Module.projective_lifting_property T.mkQ LinearMap.id (Submodule.mkQ_surjective T)
  exact ⟨((LinearMap.exact_subtype_mkQ T).splitSurjectiveEquiv
    T.injective_subtype ⟨s, hs⟩).val.trans (LinearEquiv.prodComm R T (M ⧸ T))⟩

private theorem hasProjectiveDimensionLE_one_of_equiv_prod
    {R : Type*} {M Q T : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup Q] [Module R Q] [AddCommGroup T] [Module R T]
    (e : M ≃ₗ[R] Q × T)
    (hM : HasProjectiveDimensionLE (ModuleCat.of R M) 1) :
    HasProjectiveDimensionLE (ModuleCat.of R T) 1 := by
  let i : T →ₗ[R] M := e.symm.toLinearMap.comp (LinearMap.inr R Q T)
  let r : M →ₗ[R] T := (LinearMap.snd R Q T).comp e.toLinearMap
  have hri : r.comp i = LinearMap.id := by
    ext x
    simp [r, i]
  let h : Retract (ModuleCat.of R T) (ModuleCat.of R M) :=
    { i := ModuleCat.ofHom i
      r := ModuleCat.ofHom r
      retract := by
        rw [← ModuleCat.ofHom_comp, hri]
        rfl }
  let := hM
  exact h.hasProjectiveDimensionLT 2

private theorem projective_of_finite_free_localizations_constant_rank
    {R Q : Type*} [CommRing R] [AddCommGroup Q] [Module R Q]
    [Module.Finite R Q] (k : ℕ)
    (hfree : ∀ p : PrimeSpectrum R,
      Module.Free (Localization.AtPrime p.asIdeal)
        (LocalizedModule p.asIdeal.primeCompl Q))
    (hrank : Module.rankAtStalk (R := R) Q = fun _ => k) :
    Module.Projective R Q := by
  have hloc : Module.freeLocus R Q = Set.univ := by
    ext p
    simpa only [Set.mem_univ, Module.mem_freeLocus, iff_true] using hfree p
  have hlc : IsLocallyConstant (Module.rankAtStalk (R := R) Q) := by
    rw [hrank]
    exact IsLocallyConstant.const k
  have h : Module.Finite R Q ∧ Module.Projective R Q :=
    ((Module.finite_projective_tfae R Q).out 8 2).mp
      (show Module.Finite R Q ∧ Module.freeLocus R Q = Set.univ ∧
        IsLocallyConstant (Module.rankAtStalk (R := R) Q) from
          ⟨inferInstance, hloc, hlc⟩)
  exact h.2

private theorem mem_range_mulVecLin_of_cramer_mem_span
    {R n : Type*} [CommRing R] [Fintype n] [DecidableEq n]
    (B : Matrix n n R) (b : n → R) (f u : R) (hf : IsRegular f)
    (hu : IsUnit u) (hdet : B.det = u * f)
    (hcramer : ∀ i, B.cramer b i ∈ Ideal.span {f}) :
    b ∈ LinearMap.range B.mulVecLin := by
  classical
  choose c hc using fun i => Ideal.mem_span_singleton'.mp (hcramer i)
  have hC : B.cramer b = f • c := by
    funext i
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [mul_comm]
    exact (hc i).symm
  have h : B.mulVec c = u • b := by
    apply hf.smul_right_injective (n → R)
    calc
      f • B.mulVec c = B.mulVec (f • c) := by
        simp only [Matrix.mulVec_smul]
      _ = B.mulVec (B.cramer b) := by rw [hC]
      _ = B.det • b := B.mulVec_cramer b
      _ = f • (u • b) := by rw [hdet, mul_smul, smul_comm]
  exact (Submodule.smul_mem_iff_of_isUnit _ hu).mp ⟨c, h⟩

private theorem ker_lsmul_eq_torsion_powers_of_quotient_smul_injective
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (f : R)
    (hf : Function.Injective (fun q : M ⧸ LinearMap.ker (LinearMap.lsmul R M f) =>
      f • q)) :
    LinearMap.ker (LinearMap.lsmul R M f) =
      Submodule.torsion' R M (Submonoid.powers f) := by
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  apply le_antisymm
  · intro x hx
    rw [Submodule.mem_torsion'_iff]
    refine ⟨⟨f, Submonoid.mem_powers f⟩, ?_⟩
    simpa only [Submonoid.smul_def, LinearMap.mem_ker, LinearMap.lsmul_apply] using hx
  · intro x hx
    rw [Submodule.mem_torsion'_iff] at hx
    obtain ⟨⟨s, hs⟩, hxs⟩ := hx
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff s f).mp hs
    have hpow (n : ℕ) : Function.Injective
        (fun q : M ⧸ T => f ^ n • q) := by
      induction n with
      | zero => exact fun _ _ h => by simpa using h
      | succ n ih =>
        intro a b h
        apply ih
        apply hf
        simpa only [pow_succ', mul_smul] using h
    have hq : (Submodule.mkQ T) x = 0 := by
      apply hpow n
      change f ^ n • x = 0 at hxs
      simpa only [smul_zero, map_smul, map_zero] using
        congrArg (Submodule.mkQ T) hxs
    exact (Submodule.Quotient.mk_eq_zero T).mp hq

private theorem ker_lsmul_eq_torsion_powers_of_projective_quotient
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (f : R)
    (hf : IsRegular f)
    [Module.Projective R (M ⧸ LinearMap.ker (LinearMap.lsmul R M f))] :
    LinearMap.ker (LinearMap.lsmul R M f) =
      Submodule.torsion' R M (Submonoid.powers f) :=
  ker_lsmul_eq_torsion_powers_of_quotient_smul_injective f
    (Module.Flat.isSMulRegular_of_isRegular hf)

private theorem eq_zero_of_augmented_minor
    {R J : Type*} [CommRing R] {m n : ℕ}
    (A : Matrix (Fin m) J R) (r : Fin n → Fin m)
    (c : Fin n → J) (j : J)
    (hminor : minorIdeal A (n + 1) = ⊥)
    (hdet : IsRegular (A.submatrix r c).det)
    (hzero : ∀ t, A (r t) j = 0) :
    ∀ i, A i j = 0 := by
  classical
  intro i
  let row : Fin (n + 1) → Fin m := Fin.cases i r
  let col : Fin (n + 1) → J := Fin.cases j c
  have hd : (A.submatrix row col).det = 0 := by
    have hm : (A.submatrix row col).det ∈ minorIdeal A (n + 1) :=
      Ideal.subset_span ⟨row, col, rfl⟩
    rwa [hminor, Ideal.mem_bot] at hm
  rw [Matrix.det_succ_column_zero, Fin.sum_univ_succ] at hd
  have hz (t : Fin n) : (A.submatrix row col) t.succ 0 = 0 := by
    simpa [row, col, Matrix.submatrix_apply] using hzero t
  simp only [hz, mul_zero, zero_mul, Finset.sum_const_zero, add_zero] at hd
  have hsub : (A.submatrix row col).submatrix (Fin.succAbove (0 : Fin (n + 1)))
      Fin.succ = A.submatrix r c := by
    ext s t
    simp [row, col, Matrix.submatrix_apply]
  rw [hsub] at hd
  apply hdet.smul_right_injective R
  simpa [row, col, Matrix.submatrix_apply, mul_comm] using hd

/-- Minors of size larger than the number of rows vanish. -/
private theorem minorIdeal_succ_eq_bot_of_le {R J : Type*} [CommRing R] {m n : ℕ}
    (A : Matrix (Fin m) J R) (h : m ≤ n) : minorIdeal A (n + 1) = ⊥ := by
  rw [minorIdeal, Ideal.span_eq_bot]
  rintro x ⟨r, c, rfl⟩
  obtain ⟨i, j, hij, heq⟩ := Fintype.exists_ne_map_eq_of_card_lt r (by simp; omega)
  apply Matrix.det_zero_of_row_eq hij
  ext t
  simp [Matrix.submatrix, heq]

/-- Over a local ring, if the `n × n` minors of the relation matrix of `p` generate `(f)` for a
nonzerodivisor `f` and the larger minors vanish, then `ker p` is the image of an injective
`m × n` matrix. -/
private theorem exists_injective_mulVecLin_range_eq_ker_of_minorIdeal
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]
    {m n : ℕ} (p : (Fin m → R) →ₗ[R] M) (f : R) (hf : IsRegular f)
    (hk : minorIdeal
      (fun (i : Fin m) (j : LinearMap.ker p) => (j : Fin m → R) i) n = Ideal.span {f})
    (hkm1 : minorIdeal
      (fun (i : Fin m) (j : LinearMap.ker p) => (j : Fin m → R) i) (n + 1) = ⊥) :
    ∃ B : Matrix (Fin m) (Fin n) R,
      Function.Injective B.mulVecLin ∧ LinearMap.range B.mulVecLin = LinearMap.ker p := by
  classical
  let A : Matrix (Fin m) (LinearMap.ker p) R :=
    fun i j => (j : Fin m → R) i
  let S : Set R := {e | ∃ (r : Fin n → Fin m) (c : Fin n → LinearMap.ker p),
    e = (A.submatrix r c).det}
  have hspan : Ideal.span S = Ideal.span {f} := by
    simpa only [minorIdeal, S] using hk
  have hsub : S ⊆ Ideal.span {f} := fun _ he => hspan.le (Ideal.subset_span he)
  by_cases hR : Subsingleton R
  · have : Subsingleton (LinearMap.ker p) := Module.subsingleton R _
    exact ⟨0, fun _ _ _ => Subsingleton.elim _ _, Subsingleton.elim _ _⟩
  let : Nontrivial R := not_subsingleton_iff_nontrivial.mp hR
  obtain ⟨e, ⟨r, c, he⟩, u, hu, heq⟩ :=
    exists_mem_eq_unit_mul_of_regular S f hf hsub hspan
  let B : Matrix (Fin n) (Fin n) R := A.submatrix r c
  let B₀ : Matrix (Fin m) (Fin n) R := A.submatrix id c
  have hdet : B.det = u * f := he.symm.trans heq
  have hBreg : IsRegular B.det := hdet ▸ hu.isRegular.mul hf
  have hcramer (j : LinearMap.ker p) (i : Fin n) :
      B.cramer ((A.col j) ∘ r) i ∈ Ideal.span {f} := by
    have heq : B.cramer ((A.col j) ∘ r) i =
        (A.submatrix r (Function.update c i j)).det := by
      rw [Matrix.cramer_apply]
      congr 1
      ext a b
      by_cases h : b = i
      · subst b
        simp [B, Matrix.updateCol, Matrix.submatrix_apply, Function.update]
      · simp [B, Matrix.updateCol, Matrix.submatrix_apply, Function.update, h]
    rw [heq, ← hspan]
    exact Ideal.subset_span ⟨r, Function.update c i j, rfl⟩
  have hle : LinearMap.range B₀.mulVecLin ≤ LinearMap.ker p := by
    rw [Matrix.range_mulVecLin]
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change (c i : Fin m → R) ∈ LinearMap.ker p
    exact (c i).property
  have hcols (j : LinearMap.ker p) :
      (j : Fin m → R) ∈ LinearMap.range B₀.mulVecLin := by
    obtain ⟨v, hv⟩ :=
      mem_range_mulVecLin_of_cramer_mem_span B ((A.col j) ∘ r)
        f u hf hu hdet (hcramer j)
    change B.mulVec v = (A.col j) ∘ r at hv
    let d : LinearMap.ker p :=
      ⟨(j : Fin m → R) - B₀.mulVec v,
        (LinearMap.ker p).sub_mem j.property (hle ⟨v, rfl⟩)⟩
    have hd (t : Fin n) : A (r t) d = 0 := by
      have ht := congrFun hv t
      change (∑ l : Fin n, A (r t) (c l) * v l) = (j : Fin m → R) (r t) at ht
      simp only [A, d, Pi.sub_apply, B₀, Matrix.mulVec]
      exact sub_eq_zero.mpr ht.symm
    refine ⟨v, funext fun i => ?_⟩
    have hi := eq_zero_of_augmented_minor A r c d hkm1 hBreg hd i
    change ((j : Fin m → R) - B₀.mulVec v) i = 0 at hi
    exact (sub_eq_zero.mp hi).symm
  have hrange : LinearMap.range B₀.mulVecLin = LinearMap.ker p :=
    le_antisymm hle fun x hx => hcols ⟨x, hx⟩
  have hinj : Function.Injective B₀.mulVecLin := by
    intro v w h
    apply Matrix.mulVec_injective_of_det_mem_nonZeroDivisors
      (isRegular_iff_mem_nonZeroDivisors.mp hBreg)
    funext i
    simpa [B₀, B, Matrix.mulVec, Matrix.submatrix_apply] using congrFun h (r i)
  exact ⟨B₀, hinj, hrange⟩

/-- **A square presentation matrix over a local ring**, the first sentence of the proof of Stacks
0ESU: "choose an affine open `V ⊂ X` such that there exists a presentation
`0 → 𝒪_V^{⊕n} → 𝒪_V^{⊕n} → ℱ → 0`".

Over a local ring a finite module `M` whose zeroth Fitting ideal is generated by a nonzerodivisor
`f` is the cokernel of an injective **square** matrix: there are `n`, a surjection
`p : Rⁿ → M` and a matrix `A : Matrix (Fin n) (Fin n) R` with `A.mulVecLin` injective and
`Im(A) = Ker(p)`, so that `M ≅ Rⁿ / A Rⁿ` with the same `n` upstairs and downstairs.

Both halves come out of one construction. Stacks 0F7M's hypothesis `Fit_0(M) = (f)` says that the
ideal of `n × n` minors of the full relation matrix `A` of `p` is `(f)`; since `f` is a
nonzerodivisor one of those minors is `f` times a unit, so the `n` columns of `A` cutting it out
already generate `Ker(p)` — by Cramer's rule every other column is in their image — and the square
block `A₀` they form has a nonzerodivisor determinant, hence is injective. Squareness is therefore
not an extra condition to be matched up by a rank count: the number of relations needed equals the
number of generators because the minors of maximal size generate.

The hypothesis is exactly the one Stacks 0ESU has available after its blowup, where every Fitting
ideal is an effective Cartier divisor, hence locally generated by a nonzerodivisor. -/
public theorem exists_square_presentation_of_fittingIdeal_zero_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (f : R) (hf : IsRegular f)
    (hfit : fittingIdeal (R := R) (M := M) 0 = Ideal.span {f}) :
    ∃ (n : ℕ) (A : Matrix (Fin n) (Fin n) R) (p : (Fin n → R) →ₗ[R] M),
      Function.Injective A.mulVecLin ∧ Function.Surjective p ∧
        LinearMap.range A.mulVecLin = LinearMap.ker p := by
  classical
  let hfin := Module.Finite.exists_fin' R M
  let n := hfin.choose
  let p : (Fin n → R) →ₗ[R] M := hfin.choose_spec.choose
  have hp : Function.Surjective p := hfin.choose_spec.choose_spec
  have hI : minorIdeal (fun (i : Fin n) (j : LinearMap.ker p) => (j : Fin n → R) i) n =
      Ideal.span {f} := by
    simpa [fittingIdeal, n, hfin] using hfit
  obtain ⟨B, hinj, hrange⟩ := exists_injective_mulVecLin_range_eq_ker_of_minorIdeal p f hf hI
    (minorIdeal_succ_eq_bot_of_le _ le_rfl)
  exact ⟨n, B, p, hinj, hp, hrange⟩


private theorem local_free_kernel_of_fittingIdeal_zero_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (f : R) (hf : IsRegular f)
    (hfit : fittingIdeal (R := R) (M := M) 0 = Ideal.span {f}) :
    ∃ (n : ℕ) (p : (Fin n → R) →ₗ[R] M),
      Function.Surjective p ∧ Module.Free R (LinearMap.ker p) := by
  obtain ⟨n, A, p, hinj, hp, hrange⟩ :=
    exists_square_presentation_of_fittingIdeal_zero_eq_span_singleton f hf hfit
  exact ⟨n, p, hp, Module.Free.of_equiv
    ((LinearEquiv.ofInjective A.mulVecLin hinj).trans (LinearEquiv.ofEq _ _ hrange))⟩

private theorem hasProjectiveDimensionLE_one_of_free_kernel_presentation
    {R M P : Type u} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup P] [Module R P] [Module.Projective R P]
    (p : P →ₗ[R] M) (hp : Function.Surjective p)
    [Module.Projective R (LinearMap.ker p)] :
    HasProjectiveDimensionLE (ModuleCat.of R M) 1 := by
  let S := p.shortComplexKer
  have hS : S.ShortExact := LinearMap.shortExact_shortComplexKer hp
  have hP : Projective S.X₂ :=
    ModuleCat.projective_of_categoryTheory_projective _
  exact (hS.hasProjectiveDimensionLT_X₃_iff 0 hP).mpr inferInstance

private theorem local_hasProjectiveDimensionLE_one_of_fittingIdeal_zero_eq_span_singleton
    {R M : Type u} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (f : R) (hf : IsRegular f)
    (hfit : fittingIdeal (R := R) (M := M) 0 = Ideal.span {f}) :
    HasProjectiveDimensionLE (ModuleCat.of R M) 1 := by
  obtain ⟨n, p, hp, hfree⟩ :=
    local_free_kernel_of_fittingIdeal_zero_eq_span_singleton f hf hfit
  let : Module.Free R (LinearMap.ker p) := hfree
  exact hasProjectiveDimensionLE_one_of_free_kernel_presentation p hp

private theorem linearIndependent_of_span_range_eq_top_of_fittingIdeal_pred_eq_bot
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (g : Fin k → M)
    (hg : Submodule.span R (Set.range g) = ⊤)
    (hfit : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    LinearIndependent R g := by
  classical
  let p : (Fin k → R) →ₗ[R] M := Fintype.linearCombination R g
  have hp : Function.Surjective p :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination R g).mp hg
  let A : Matrix (Fin k) (LinearMap.ker p) R := fun i j => (j : Fin k → R) i
  have hspan : Submodule.span R (Set.range (fun j : LinearMap.ker p =>
      fun i : Fin k => A i j)) = LinearMap.ker p := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact j.property
    · intro j hj
      exact Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩
  let e : ((Fin k → R) ⧸ Submodule.span R
      (Set.range (fun j : LinearMap.ker p => fun i : Fin k => A i j))) ≃ₗ[R] M :=
    hspan.symm ▸ LinearMap.quotKerEquivOfSurjective p hp
  by_cases hk : k = 0
  · subst k
    exact linearIndependent_empty_type
  have hminor : minorIdeal A 1 = ⊥ := by
    have h := fittingIdeal_eq_minorIdeal_of_presentation A (k - 1) e
    have hpred : ((k - 1 : ℕ) : ℤ) = (k : ℤ) - 1 := by omega
    rw [hpred, hfit] at h
    have hkone : k - (k - 1) = 1 := by omega
    simpa only [hkone] using h.symm
  have hker : LinearMap.ker p = ⊥ := by
    apply (Submodule.eq_bot_iff _).mpr
    intro j hj
    funext i
    have hm : (A.submatrix (fun _ : Fin 1 => i) (fun _ : Fin 1 => (⟨j, hj⟩ : LinearMap.ker p))).det
        ∈ minorIdeal A 1 := by
      apply Ideal.subset_span
      exact ⟨fun _ => i, fun _ => ⟨j, hj⟩, rfl⟩
    rw [hminor, Ideal.mem_bot] at hm
    simpa [Matrix.det_fin_one, Matrix.submatrix, A] using hm
  exact (linearIndependent_iff_injective_fintypeLinearCombination).mpr
    (LinearMap.ker_eq_bot.mp hker)

private theorem eq_zero_of_diagonal_minor_eq_bot
    {R J : Type*} [CommRing R] {k n : ℕ}
    (A : Matrix (Fin (k + n)) J R) (a : Fin k → R)
    (j₀ : J) (j₁ : Fin n → J) (f : R) (hf : IsRegular f)
    (hminor : minorIdeal A (n + 1) = ⊥)
    (h₀ : ∀ i, A (Fin.castAdd n i) j₀ = a i)
    (h₁ : ∀ i, A (Fin.natAdd k i) j₀ = 0)
    (h₂ : ∀ i t, A (Fin.castAdd n i) (j₁ t) = 0)
    (h₃ : ∀ i t, A (Fin.natAdd k i) (j₁ t) = if i = t then f else 0) :
    a = 0 := by
  classical
  funext i
  let row : Fin (n + 1) → Fin (k + n) :=
    Fin.cases (Fin.castAdd n i) (Fin.natAdd k)
  let col : Fin (n + 1) → J := Fin.cases j₀ j₁
  have hdet : (A.submatrix row col).det = 0 := by
    have hm : (A.submatrix row col).det ∈ minorIdeal A (n + 1) :=
      Ideal.subset_span ⟨row, col, rfl⟩
    rwa [hminor, Ideal.mem_bot] at hm
  have hdiag : A.submatrix row col =
      Matrix.diagonal (Fin.cases (a i) (fun _ => f)) := by
    ext s t
    cases s using Fin.cases with
    | zero =>
      cases t using Fin.cases with
      | zero => simp [row, col, h₀, Matrix.diagonal]
      | succ t =>
        have hne : (0 : Fin (n + 1)) ≠ t.succ := (Fin.succ_ne_zero t).symm
        simp [row, col, h₂, Matrix.diagonal, hne]
    | succ s =>
      cases t using Fin.cases with
      | zero => simp [row, col, h₁, Matrix.diagonal]
      | succ t => simp [row, col, h₃, Matrix.diagonal]
  rw [hdiag, Matrix.det_diagonal, Fin.prod_univ_succ] at hdet
  simp only [Fin.cases_zero, Fin.cases_succ, Finset.prod_const, Finset.card_fin] at hdet
  have hreg : IsRegular (f ^ n) := hf.pow n
  apply hreg.smul_right_injective R
  simpa only [Pi.zero_apply, smul_eq_mul, mul_zero, mul_comm] using hdet

private theorem linearIndependent_of_fittingIdeal_pred_eq_bot_of_annihilated_complement
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k n : ℕ) (g : Fin k → M) (t : Fin n → M)
    (f : R) (hf : IsRegular f)
    (ht : ∀ j, f • t j = 0)
    (hp : Function.Surjective (Fintype.linearCombination R (Fin.append g t)))
    (hfit : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    LinearIndependent R g := by
  classical
  by_cases hk : k = 0
  · subst k
    exact linearIndependent_empty_type
  let p : (Fin (k + n) → R) →ₗ[R] M :=
    Fintype.linearCombination R (Fin.append g t)
  let A : Matrix (Fin (k + n)) (LinearMap.ker p) R :=
    fun i j => (j : Fin (k + n) → R) i
  have hspan : Submodule.span R (Set.range (fun j : LinearMap.ker p =>
      fun i : Fin (k + n) => A i j)) = LinearMap.ker p := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact j.property
    · intro j hj
      exact Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩
  let e : ((Fin (k + n) → R) ⧸ Submodule.span R
      (Set.range (fun j : LinearMap.ker p => fun i : Fin (k + n) => A i j))) ≃ₗ[R] M :=
    hspan.symm ▸ LinearMap.quotKerEquivOfSurjective p hp
  have hminor : minorIdeal A (n + 1) = ⊥ := by
    have h := fittingIdeal_eq_minorIdeal_of_presentation A (k - 1) e
    have hpred : ((k - 1 : ℕ) : ℤ) = (k : ℤ) - 1 := by omega
    rw [hpred, hfit] at h
    have hsub : k + n - (k - 1) = n + 1 := by omega
    simpa only [hsub] using h.symm
  apply (linearIndependent_iff_injective_fintypeLinearCombination).mpr
  intro a b hab
  have hzero (c : Fin k → R)
      (hc : (Fintype.linearCombination R g) c = 0) : c = 0 := by
    let v : Fin (k + n) → R := Fin.append c 0
    have hv : p v = 0 := by
      simpa [p, v, Fintype.linearCombination_apply, Fin.sum_univ_add,
        Fin.append_left, Fin.append_right] using hc
    let j₀ : LinearMap.ker p := ⟨v, LinearMap.mem_ker.mpr hv⟩
    let w (j : Fin n) : Fin (k + n) → R :=
      Fin.append 0 (Pi.single j f)
    have hw (j : Fin n) : p (w j) = 0 := by
      simp [p, w, Fintype.linearCombination_apply, Fin.sum_univ_add,
        Fin.append_left, Fin.append_right, ht]
    let j₁ (j : Fin n) : LinearMap.ker p :=
      ⟨w j, LinearMap.mem_ker.mpr (hw j)⟩
    apply eq_zero_of_diagonal_minor_eq_bot A c j₀ j₁ f hf hminor
    · intro i
      simp [A, j₀, v, Fin.append_left]
    · intro i
      simp [A, j₀, v, Fin.append_right]
    · intro i j
      simp [A, j₁, w, Fin.append_left]
    · intro i j
      simp [A, j₁, w, Fin.append_right, Pi.single_apply]
  exact sub_eq_zero.mp (hzero _ (by simpa using sub_eq_zero.mpr hab))

private theorem exists_linearIndependent_lift_of_fittingIdeal_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    let T := LinearMap.ker (LinearMap.lsmul R M f)
    ∃ g : Fin k → M, LinearIndependent R g ∧
      Submodule.span R (Set.range (fun i => (Submodule.mkQ T) (g i))) = ⊤ := by
  classical
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  let q : M →ₗ[R] M ⧸ T := T.mkQ
  obtain ⟨gQ, hgQ⟩ :=
    exists_fin_generating_family_quotient_ker_lsmul_of_fittingIdeal_eq_span_singleton
      k f hk
  let g : Fin k → M := fun i => Classical.choose (Submodule.mkQ_surjective T (gQ i))
  have hg (i : Fin k) : q (g i) = gQ i :=
    Classical.choose_spec (Submodule.mkQ_surjective T (gQ i))
  have hQsurj : Function.Surjective (Fintype.linearCombination R gQ) :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination R gQ).mp hgQ
  obtain ⟨n, h, hh⟩ := Module.Finite.exists_fin (R := R) (M := M)
  choose c hc using fun j => hQsurj (q (h j))
  let t : Fin n → M := fun j => h j - (Fintype.linearCombination R g) (c j)
  have hqt (j : Fin n) : q (t j) = 0 := by
    have hcomb : q ((Fintype.linearCombination R g) (c j)) =
        (Fintype.linearCombination R gQ) (c j) := by
      simp only [Fintype.linearCombination_apply, map_sum, map_smul, hg]
    simp [t, hcomb, hc]
  have ht (j : Fin n) : f • t j = 0 := by
    have hj : t j ∈ T := (Submodule.Quotient.mk_eq_zero T).mp (hqt j)
    simpa only [T, LinearMap.mem_ker, LinearMap.lsmul_apply] using hj
  have hsurj : Function.Surjective (Fintype.linearCombination R (Fin.append g t)) := by
    let P := Submodule.span R (Set.range (Fin.append g t))
    have hgin (i : Fin k) : g i ∈ P :=
      Submodule.subset_span ⟨Fin.castAdd n i, Fin.append_left g t i⟩
    have htin (j : Fin n) : t j ∈ P :=
      Submodule.subset_span ⟨Fin.natAdd k j, Fin.append_right g t j⟩
    have hcomb (j : Fin n) : (Fintype.linearCombination R g) (c j) ∈ P := by
      rw [Fintype.linearCombination_apply]
      exact P.sum_mem (fun i _ => P.smul_mem _ (hgin i))
    have hspan : Submodule.span R (Set.range h) ≤ P := by
      apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      have hj := P.add_mem (hcomb j) (htin j)
      have heq : (Fintype.linearCombination R g) (c j) + t j = h j := by
        dsimp [t]
        abel
      rwa [← heq]
    exact (span_range_eq_top_iff_surjective_fintypeLinearCombination R
      (Fin.append g t)).mp (top_unique (hh ▸ hspan))
  refine ⟨g, linearIndependent_of_fittingIdeal_pred_eq_bot_of_annihilated_complement
    k n g t f hf ht hsurj hkm1, ?_⟩
  have hgfun : (fun i => q (g i)) = gQ := funext hg
  change Submodule.span R (Set.range (fun i => q (g i))) = ⊤
  rwa [hgfun]

private theorem local_quotient_equiv_fin_of_fittingIdeal_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Nonempty ((Fin k → R) ≃ₗ[R] (M ⧸ LinearMap.ker (LinearMap.lsmul R M f))) := by
  classical
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  let q : M →ₗ[R] M ⧸ T := T.mkQ
  obtain ⟨g, hli, hgen⟩ :=
    exists_linearIndependent_lift_of_fittingIdeal_eq_span_singleton k f hf hk hkm1
  let e : (Fin k → R) →ₗ[R] M ⧸ T :=
    Fintype.linearCombination R (fun i => q (g i))
  have he (c : Fin k → R) : e c = q ((Fintype.linearCombination R g) c) := by
    simp [e, Fintype.linearCombination_apply, map_sum, map_smul]
  have he_surj : Function.Surjective e :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination R
      (fun i => q (g i))).mp hgen
  have he_inj : Function.Injective e := by
    intro a b hab
    apply sub_eq_zero.mp
    have hz : e (a - b) = 0 := by rwa [map_sub, sub_eq_zero]
    rw [he] at hz
    have hT : (Fintype.linearCombination R g) (a - b) ∈ T :=
      (Submodule.Quotient.mk_eq_zero T).mp hz
    have hfm : f • (Fintype.linearCombination R g) (a - b) = 0 := by
      simpa only [T, LinearMap.mem_ker, LinearMap.lsmul_apply] using hT
    have hfc : (Fintype.linearCombination R g) (f • (a - b)) = 0 := by
      simpa only [map_smul] using hfm
    have hzero : f • (a - b) = 0 :=
      (linearIndependent_iff_injective_fintypeLinearCombination.mp hli)
        (hfc.trans (map_zero _).symm)
    apply hf.smul_right_injective (Fin k → R)
    simpa only [smul_zero] using hzero
  exact ⟨LinearEquiv.ofBijective e ⟨he_inj, he_surj⟩⟩

private theorem localized_quotient_equiv_fin_of_fittingIdeal_pair
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (p : Ideal R) [p.IsPrime]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Nonempty ((Fin k → Localization.AtPrime p) ≃ₗ[Localization.AtPrime p]
      LocalizedModule p.primeCompl
        (M ⧸ LinearMap.ker (LinearMap.lsmul R M f))) := by
  let S := Localization.AtPrime p
  let L := LocalizedModule.AtPrime p M
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  let K := LinearMap.ker (LinearMap.lsmul S L (algebraMap R S f))
  have hpair := fittingIdeal_localized_pair p k f hk hkm1
  have hfS : IsRegular (algebraMap R S f) :=
    Stacks.Fitting.isRegular_algebraMap_of_flat hf
  obtain ⟨e⟩ := local_quotient_equiv_fin_of_fittingIdeal_eq_span_singleton
    (M := L) k (algebraMap R S f) hfS hpair.1 hpair.2
  have hK : T.localized p.primeCompl = K := ker_lsmul_localized p f
  let eQ : (L ⧸ K) ≃ₗ[S] LocalizedModule p.primeCompl (M ⧸ T) := by
    rw [← hK]
    exact localizedQuotientEquiv p.primeCompl T
  exact ⟨e.trans eQ⟩

private theorem projective_quotient_of_fittingIdeal_pair
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Module.Projective R (M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) := by
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  let Q := M ⧸ T
  let : Module.Finite R Q :=
    Module.Finite.of_surjective T.mkQ (Submodule.mkQ_surjective T)
  have hlocal (p : PrimeSpectrum R) :
      Nonempty ((Fin k → Localization.AtPrime p.asIdeal) ≃ₗ[Localization.AtPrime p.asIdeal]
        LocalizedModule p.asIdeal.primeCompl Q) :=
    localized_quotient_equiv_fin_of_fittingIdeal_pair p.asIdeal k f hf hk hkm1
  have hfree (p : PrimeSpectrum R) :
      Module.Free (Localization.AtPrime p.asIdeal)
        (LocalizedModule p.asIdeal.primeCompl Q) := by
    obtain ⟨e⟩ := hlocal p
    exact Module.Free.of_equiv e
  have hrank : Module.rankAtStalk (R := R) Q = fun _ => k := by
    funext p
    obtain ⟨e⟩ := hlocal p
    change Module.finrank (Localization.AtPrime p.asIdeal)
      (LocalizedModule p.asIdeal.primeCompl Q) = k
    rw [← e.finrank_eq]
    simp
  exact projective_of_finite_free_localizations_constant_rank k hfree hrank

private theorem rankAtStalk_quotient_of_fittingIdeal_pair
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Module.rankAtStalk (R := R)
      (M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) = fun _ => k := by
  funext p
  obtain ⟨e⟩ :=
    localized_quotient_equiv_fin_of_fittingIdeal_pair p.asIdeal k f hf hk hkm1
  change Module.finrank (Localization.AtPrime p.asIdeal)
    (LocalizedModule p.asIdeal.primeCompl
      (M ⧸ LinearMap.ker (LinearMap.lsmul R M f))) = k
  rw [← e.finrank_eq]
  simp

private theorem local_split_of_fittingIdeal_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Nonempty (M ≃ₗ[R] (M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) ×
      LinearMap.ker (LinearMap.lsmul R M f)) := by
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  obtain ⟨e⟩ :=
    local_quotient_equiv_fin_of_fittingIdeal_eq_span_singleton k f hf hk hkm1
  let : Module.Free R (M ⧸ T) := Module.Free.of_equiv e
  exact nonempty_equiv_quotient_prod_of_projective T

private theorem local_projective_quotient_of_fittingIdeal_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Module.Projective R (M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) := by
  obtain ⟨e⟩ :=
    local_quotient_equiv_fin_of_fittingIdeal_eq_span_singleton k f hf hk hkm1
  let : Module.Free R (M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) :=
    Module.Free.of_equiv e
  infer_instance

private theorem minorIdeal_eq_of_zero_top_rows
    {R J : Type*} [CommRing R] (k n : ℕ)
    (A : Matrix (Fin (k + n)) J R)
    (hzero : ∀ i : Fin k, ∀ j, A (Fin.castAdd n i) j = 0) :
    minorIdeal A n = minorIdeal (A.submatrix (Fin.natAdd k) id) n := by
  classical
  apply le_antisymm
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨r, c, rfl⟩
    by_cases hr : ∃ i : Fin n, (r i).val < k
    · obtain ⟨i, hi⟩ := hr
      have hrow : ∀ j, (A.submatrix r c) i j = 0 := by
        intro j
        have heq : r i = Fin.castAdd n ⟨(r i).val, hi⟩ := by
          apply Fin.ext
          simp
        change A (r i) (c j) = 0
        rw [heq]
        exact hzero _ _
      rw [Matrix.det_eq_zero_of_row_eq_zero i hrow]
      exact Ideal.zero_mem _
    · push Not at hr
      let s : Fin n → Fin n := fun i =>
        ⟨(r i).val - k, by have := (r i).isLt; have := hr i; omega⟩
      have hs (i : Fin n) : Fin.natAdd k (s i) = r i := by
        apply Fin.ext
        have := hr i
        simp [s]
        omega
      have heq : A.submatrix r c =
          (A.submatrix (Fin.natAdd k) id).submatrix s c := by
        ext i j
        simp [Matrix.submatrix_apply, hs]
      rw [heq, minorIdeal]
      exact Ideal.subset_span ⟨s, c, rfl⟩
  · exact minorIdeal_submatrix_le A (Fin.natAdd k) id n

private theorem equiv_kernel_of_fittingIdeal_pair_of_surjective
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k n : ℕ) (p : (Fin (k + n) → R) →ₗ[R] M)
    (hp : Function.Surjective p) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Nonempty ((Fin n → R) ≃ₗ[R] LinearMap.ker p) := by
  classical
  let A : Matrix (Fin (k + n)) (LinearMap.ker p) R :=
    fun i j => (j : Fin (k + n) → R) i
  have hspan : Submodule.span R (Set.range (fun j : LinearMap.ker p =>
      fun i : Fin (k + n) => A i j)) = LinearMap.ker p := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact j.property
    · intro j hj
      exact Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩
  let e : ((Fin (k + n) → R) ⧸ Submodule.span R
      (Set.range (fun j : LinearMap.ker p => fun i : Fin (k + n) => A i j))) ≃ₗ[R] M :=
    hspan.symm ▸ LinearMap.quotKerEquivOfSurjective p hp
  have hminor : minorIdeal A n = Ideal.span {f} := by
    have h := fittingIdeal_eq_minorIdeal_of_presentation A k e
    have hsub : k + n - k = n := by omega
    simpa only [hsub, hk] using h.symm
  have hminor1 : minorIdeal A (n + 1) = ⊥ := by
    by_cases hk0 : k = 0
    · subst k
      exact minorIdeal_succ_eq_bot_of_le A (by simp)
    · have h := fittingIdeal_eq_minorIdeal_of_presentation A (k - 1) e
      have hpred : ((k - 1 : ℕ) : ℤ) = (k : ℤ) - 1 := by omega
      rw [hpred, hkm1] at h
      have hsub : k + n - (k - 1) = n + 1 := by omega
      simpa only [hsub] using h.symm
  obtain ⟨B, hinj, hrange⟩ :=
    exists_injective_mulVecLin_range_eq_ker_of_minorIdeal p f hf hminor hminor1
  exact ⟨(LinearEquiv.ofInjective B.mulVecLin hinj).trans (LinearEquiv.ofEq _ _ hrange)⟩

private theorem localized_kernel_free_of_fittingIdeal_pair
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k n : ℕ)
    (g : (Fin (k + n) → R) →ₗ[R] M) (hg : Function.Surjective g)
    (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥)
    (p : Ideal R) [p.IsPrime] :
    Module.Free (Localization.AtPrime p)
      (LocalizedModule p.primeCompl (LinearMap.ker g)) ∧
      Module.finrank (Localization.AtPrime p)
        (LocalizedModule p.primeCompl (LinearMap.ker g)) = n := by
  let S := Localization.AtPrime p
  let L := LocalizedModule.AtPrime p M
  let F := Fin (k + n) → R
  let Fₚ := LocalizedModule.AtPrime p F
  let eF : (Fin (k + n) → S) ≃ₗ[S] Fₚ := localized_fin_pi_equiv p (k + n)
  let gₚ : Fₚ →ₗ[S] L :=
    (IsLocalizedModule.map p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl F)
      (LocalizedModule.mkLinearMap p.primeCompl M) g).extendScalarsOfIsLocalization
        p.primeCompl S
  let g' : (Fin (k + n) → S) →ₗ[S] L := gₚ.comp eF.toLinearMap
  have hg' : Function.Surjective g' :=
    localized_fin_presentation_surjective p (k + n) g hg
  have hpair := fittingIdeal_localized_pair p k f hk hkm1
  have hf' : IsRegular (algebraMap R S f) := Stacks.Fitting.isRegular_algebraMap_of_flat hf
  obtain ⟨eg'⟩ := equiv_kernel_of_fittingIdeal_pair_of_surjective k n g' hg'
    (algebraMap R S f) hf' hpair.1 hpair.2
  let hker : LinearMap.ker g' ≃ₗ[S] LinearMap.ker gₚ :=
    { toFun := fun x => ⟨eF x, x.property⟩
      invFun := fun x => ⟨eF.symm x, by simp [g']⟩
      left_inv _ := by ext; simp
      right_inv _ := by ext; simp
      map_add' _ _ := by ext; simp
      map_smul' _ _ := by ext; simp }
  obtain ⟨eK⟩ := localized_kernel_equiv p g
  let e : (Fin n → S) ≃ₗ[S]
      LocalizedModule p.primeCompl (LinearMap.ker g) :=
    (eg'.trans hker).trans eK.symm
  exact ⟨Module.Free.of_equiv e, by rw [← e.finrank_eq]; simp⟩

private theorem finite_kernel_of_finitePresentation_of_surjective
    {R P M : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [Module.Finite R P]
    [AddCommGroup M] [Module R M] [Module.FinitePresentation R M]
    (g : P →ₗ[R] M) (hg : Function.Surjective g) :
    Module.Finite R (LinearMap.ker g) :=
  Module.Finite.of_fg (Module.FinitePresentation.fg_ker g hg)

private theorem projective_kernel_of_fittingIdeal_pair
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] (k n : ℕ)
    (g : (Fin (k + n) → R) →ₗ[R] M) (hg : Function.Surjective g)
    (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    Module.Projective R (LinearMap.ker g) := by
  let K := LinearMap.ker g
  let : Module.Finite R K :=
    finite_kernel_of_finitePresentation_of_surjective g hg
  have hlocal (p : PrimeSpectrum R) :
      Module.Free (Localization.AtPrime p.asIdeal)
        (LocalizedModule p.asIdeal.primeCompl K) ∧
      Module.finrank (Localization.AtPrime p.asIdeal)
        (LocalizedModule p.asIdeal.primeCompl K) = n :=
    localized_kernel_free_of_fittingIdeal_pair k n g hg f hf hk hkm1 p.asIdeal
  exact projective_of_finite_free_localizations_constant_rank n (fun p => (hlocal p).1)
    (funext fun p => (hlocal p).2)

private theorem local_free_kernel_of_fittingIdeal_pair
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    ∃ (n : ℕ) (p : (Fin (k + n) → R) →ₗ[R] M),
      Function.Surjective p ∧ Module.Free R (LinearMap.ker p) := by
  classical
  obtain ⟨n, h, hh⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let g : Fin (k + n) → M := Fin.append (fun _ : Fin k => 0) h
  let p : (Fin (k + n) → R) →ₗ[R] M := Fintype.linearCombination R g
  have hh' : Function.Surjective (Fintype.linearCombination R h) :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination R h).mp hh
  have hp : Function.Surjective p := by
    intro x
    obtain ⟨v, hv⟩ := hh' x
    refine ⟨Fin.append 0 v, ?_⟩
    simpa [p, g, Fintype.linearCombination_apply, Fin.sum_univ_add,
      Fin.append_left, Fin.append_right] using hv
  obtain ⟨eqv⟩ := equiv_kernel_of_fittingIdeal_pair_of_surjective k n p hp f hf hk hkm1
  exact ⟨n, p, hp, Module.Free.of_equiv eqv⟩

private theorem local_hasProjectiveDimensionLE_one_of_fittingIdeal_pair
    {R M : Type u} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    HasProjectiveDimensionLE (ModuleCat.of R M) 1 := by
  obtain ⟨n, p, hp, hfree⟩ :=
    local_free_kernel_of_fittingIdeal_pair k f hf hk hkm1
  let : Module.Free R (LinearMap.ker p) := hfree
  exact hasProjectiveDimensionLE_one_of_free_kernel_presentation p hp

private theorem hasProjectiveDimensionLE_one_of_fittingIdeal_pair
    {R : Type uR} {M : Type uU} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    HasProjectiveDimensionLE (ModuleCat.of R (ULift.{uR} M)) 1 := by
  classical
  obtain ⟨n, h, hh⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let g : Fin (k + n) → M := Fin.append (fun _ : Fin k => 0) h
  let p : (Fin (k + n) → R) →ₗ[R] M := Fintype.linearCombination R g
  have hh' : Function.Surjective (Fintype.linearCombination R h) :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination R h).mp hh
  have hp : Function.Surjective p := by
    intro x
    obtain ⟨v, hv⟩ := hh' x
    refine ⟨Fin.append 0 v, ?_⟩
    simpa [p, g, Fintype.linearCombination_apply, Fin.sum_univ_add,
      Fin.append_left, Fin.append_right] using hv
  let : Module.Projective R (LinearMap.ker p) :=
    projective_kernel_of_fittingIdeal_pair k n p hp f hf hk hkm1
  -- The presentation and its quotient live in the ring's universe.
  let K := LinearMap.ker p
  have : Module.Projective R (LinearMap.ker K.mkQ) := by
    rw [Submodule.ker_mkQ]
    infer_instance
  let := hasProjectiveDimensionLE_one_of_free_kernel_presentation K.mkQ
    (Submodule.mkQ_surjective K)
  -- Both categories contain the ring, so transfer along this equivalence needs no extra
  -- hypothesis.
  exact ModuleCat.hasProjectiveDimensionLE_of_linearEquiv
    (M := ModuleCat.of R ((Fin (k + n) → R) ⧸ K))
    (N := ModuleCat.of R (ULift.{uR} M))
    ((p.quotKerEquivOfSurjective hp).trans (ULift.moduleEquiv (R := R) (M := M)).symm) 1

private theorem fittingIdeal_pair_conclusion_of_projectiveDimensionLE_one
    {R : Type uR} {M : Type uU} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥)
    (hpd : HasProjectiveDimensionLE (ModuleCat.of R (ULift.{uR} M)) 1) :
    let T := LinearMap.ker (LinearMap.lsmul R M f)
    let Q := M ⧸ T
    HasProjectiveDimensionLE (ModuleCat.of R (ULift.{uR} M)) 1 ∧
      T = Submodule.torsion' R M (Submonoid.powers f) ∧
      HasProjectiveDimensionLE (ModuleCat.of R (ULift.{uR} T)) 1 ∧
      (∃ hfin : Module.Finite R Q,
        letI := hfin
        ∃ hproj : Module.Projective R Q,
          letI := hproj
          Module.rankAtStalk (R := R) Q = fun _ => k) ∧
      Nonempty (M ≃ₗ[R] Q × T) := by
  let T := LinearMap.ker (LinearMap.lsmul R M f)
  let Q := M ⧸ T
  let hfin : Module.Finite R Q :=
    Module.Finite.of_surjective T.mkQ (Submodule.mkQ_surjective T)
  let hproj : Module.Projective R Q :=
    projective_quotient_of_fittingIdeal_pair k f hf hk hkm1
  obtain ⟨e⟩ := nonempty_equiv_quotient_prod_of_projective T
  let eLift : ULift.{uR} M ≃ₗ[R] ULift.{uR} Q × ULift.{uR} T :=
    (ULift.moduleEquiv (R := R) (M := M)).trans (e.trans
      ((ULift.moduleEquiv (R := R) (M := Q)).symm.prodCongr
        (ULift.moduleEquiv (R := R) (M := T)).symm))
  exact ⟨hpd, ker_lsmul_eq_torsion_powers_of_projective_quotient f hf,
    hasProjectiveDimensionLE_one_of_equiv_prod eLift hpd,
    ⟨hfin, hproj, rankAtStalk_quotient_of_fittingIdeal_pair k f hf hk hkm1⟩,
    ⟨e⟩⟩

/-- **Stacks 0F7M.** Let `M` be a finitely presented module. If its `k`th Fitting ideal is
generated by a nonzerodivisor `f` and its `(k - 1)`st Fitting ideal vanishes, then `M` and its
`f`-power torsion submodule have projective dimension at most one, the quotient is finite locally
free of rank `k`, and `M` is the direct sum of the quotient and the torsion submodule. -/
@[stacks 0F7M]
public theorem hasProjectiveDimensionLE_one_and_split_of_fittingIdeal_eq_span_singleton
    {R : Type uR} {M : Type uU} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] (k : ℕ) (f : R) (hf : IsRegular f)
    (hk : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (hkm1 : fittingIdeal (R := R) (M := M) ((k : ℤ) - 1) = ⊥) :
    let T := LinearMap.ker (LinearMap.lsmul R M f)
    let Q := M ⧸ T
    HasProjectiveDimensionLE (ModuleCat.of R (ULift.{uR} M)) 1 ∧
      T = Submodule.torsion' R M (Submonoid.powers f) ∧
      HasProjectiveDimensionLE (ModuleCat.of R (ULift.{uR} T)) 1 ∧
      (∃ hfin : Module.Finite R Q,
        letI := hfin
        ∃ hproj : Module.Projective R Q,
          letI := hproj
          Module.rankAtStalk (R := R) Q = fun _ => k) ∧
      Nonempty (M ≃ₗ[R] Q × T) :=
  fittingIdeal_pair_conclusion_of_projectiveDimensionLE_one k f hf hk hkm1
    (hasProjectiveDimensionLE_one_of_fittingIdeal_pair k f hf hk hkm1)

