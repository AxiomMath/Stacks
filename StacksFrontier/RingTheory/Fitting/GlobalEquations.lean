module

public import StacksFrontier.RingTheory.Fitting.SquarePresentation

/-!
# The local equations of the divisors over a ring that is not local

Let `ℱ` be a finite module over a commutative ring, not necessarily local, whose Fitting ideals
are generated by nonzerodivisors `f_k`. This file produces the local equations `e_1, …, e_n` of
the divisors `D_j` of Stacks tag 0ESU in the ring itself, as the successive quotients of the `f_k`:

```
q_k = f_k / f_{k+1},        e_{k+1} = q_k / q_{k+1} = f_k f_{k+2} / f_{k+1}^2.
```

The first quotient exists because the Fitting ideals increase, and the second because of
`Stacks.FittingFiltration.fittingIdeal_mul_fittingIdeal_le`, the inequality

```
Fit_k(ℱ) · Fit_{k+2}(ℱ) ≤ Fit_{k+1}(ℱ)^2.
```

## Main results

* `Stacks.FittingFiltration.fittingIdeal_mul_fittingIdeal_le`: the Fitting ideals of a finite
  module whose Fitting ideals are generated by nonzerodivisors satisfy
  `Fit_k · Fit_{k+2} ≤ Fit_{k+1}^2`, over an arbitrary commutative ring.
* `Stacks.FittingFiltration.exists_equations_of_forall_fittingIdeal_eq_span_singleton`: **the
  local equations over an arbitrary commutative ring.** If every Fitting ideal of a finite module
  is generated by a nonzerodivisor `f_k`, and `f_k` is a unit for `k ≥ N`, then there are
  nonzerodivisors `e_j`, units for `j > N`, with `Fit_k(ℱ) = ∏_{j > k} (e_j)^{j-k}`.

## References

* [Stacks Project, Tag 0ESU](https://stacks.math.columbia.edu/tag/0ESU)
* [Stacks Project, Tag 07Z7](https://stacks.math.columbia.edu/tag/07Z7)
-/


@[expose] public noncomputable section

universe u v

namespace Stacks.FittingFiltration

variable {R : Type u} [CommRing R]

/-! ### The tail products of the equations -/

/-- The product `(e_{k+1}) (e_{k+2}) ⋯ (e_N)`, which is the ideal of the divisor
`D_{k+1} + D_{k+2} + ⋯` and the successive quotient `Fit_k : Fit_{k+1}`. -/
def equationTail (e : ℕ → R) (N k : ℕ) : Ideal R := ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j}

/-- Past the last divisor the tail product is the unit ideal. -/
theorem equationTail_of_le (e : ℕ → R) {N k : ℕ} (h : N ≤ k) : equationTail e N k = ⊤ := by
  rw [equationTail, Finset.Icc_eq_empty (by omega), Finset.prod_empty, Ideal.one_eq_top]

/-- One step of the tail product splits off the next equation. -/
theorem equationTail_succ (e : ℕ → R) {N k : ℕ} (h : k + 1 ≤ N) :
    equationTail e N k = Ideal.span {e (k + 1)} * equationTail e N (k + 1) := by
  have hIcc : Finset.Icc (k + 1) N = insert (k + 1) (Finset.Icc (k + 2) N) := by
    ext x
    simp only [Finset.mem_Icc, Finset.mem_insert]
    omega
  rw [equationTail, equationTail, hIcc, Finset.prod_insert (by simp)]

/-- The tail product is principal, generated by the product of the equations. -/
theorem equationTail_eq_span (e : ℕ → R) (N k : ℕ) :
    equationTail e N k = Ideal.span {∏ j ∈ Finset.Icc (k + 1) N, e j} := by
  rw [equationTail, Ideal.prod_span_singleton]

/-- **The weighted product of the equations peels off one tail.** The identity
`∏_{j > k} (e_j)^{j-k} = (∏_{j > k+1} (e_j)^{j-k-1}) · (e_{k+1}) ⋯ (e_N)`, which is the
divisor identity `E_k = E_{k+1} + (D_{k+1} + D_{k+2} + ⋯)`. -/
theorem prod_pow_eq_mul_equationTail (e : ℕ → R) (N k : ℕ) :
    (∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j} ^ (j - k))
      = (∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 1))) * equationTail e N k := by
  have hext : (∏ j ∈ Finset.Icc (k + 2) N, Ideal.span {e j} ^ (j - (k + 1)))
      = ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j} ^ (j - (k + 1)) := by
    refine Finset.prod_subset (fun j hj => ?_) fun j hj hj' => ?_
    · simp only [Finset.mem_Icc] at hj ⊢
      omega
    · simp only [Finset.mem_Icc] at hj hj'
      have hj1 : j = k + 1 := by omega
      subst hj1
      simp
  rw [hext, equationTail, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun j hj => ?_
  simp only [Finset.mem_Icc] at hj
  rw [← pow_succ]
  congr 1
  omega

/-! ### The Fitting ideals are log-concave -/

/-- **The Fitting ideals are log-concave.** For a finite module over an arbitrary commutative ring
all of whose Fitting ideals are generated by a nonzerodivisor,

```
Fit_k(ℱ) · Fit_{k+2}(ℱ) ≤ Fit_{k+1}(ℱ)^2.
```
-/
theorem fittingIdeal_mul_fittingIdeal_le {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M]
    (hfit : ∀ k : ℕ, ∃ g ∈ nonZeroDivisors R,
      fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {g}) (k : ℕ) :
    fittingIdeal (R := R) (M := M) (k : ℤ) * fittingIdeal (R := R) (M := M) ((k + 2 : ℕ) : ℤ) ≤
      fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ) *
        fittingIdeal (R := R) (M := M) ((k + 1 : ℕ) : ℤ) := by
  refine Ideal.le_of_localization_maximal fun P hP => ?_
  have : P.IsPrime := hP.isPrime
  rw [Ideal.map_mul, Ideal.map_mul, ← fittingIdeal_localizedAtPrime_eq_map (M := M) P k,
    ← fittingIdeal_localizedAtPrime_eq_map (M := M) P (k + 2),
    ← fittingIdeal_localizedAtPrime_eq_map (M := M) P (k + 1)]
  obtain ⟨n, e, hmem, hunit, hfiteq, hi0, -, -, hd1, -, -, higr, hdgr⟩ :=
    exists_divisors_and_filtrations_of_finite (R := Localization.AtPrime P)
      (LocalizedModule.AtPrime P M)
      (forall_fittingIdeal_localizedAtPrime_eq_span_singleton hfit P)
  have hid := LocalData.fittingIdeal_mul_fittingIdeal
    ({ equation := e, equation_mem := hmem, isUnit_equation := fun hj => hunit _ hj,
        fittingIdeal_eq := hfiteq, incr_zero := hi0, decr_one := hd1,
        incr_graded := higr, decr_graded := hdgr } :
      LocalData (Localization.AtPrime P) (LocalizedModule.AtPrime P M) n) k
  rw [hid]
  exact Ideal.mul_le_left

/-! ### The local equations over an arbitrary ring -/

/-- **The local equations of the divisors `D_j`, over a ring that need not be local.** Let `ℱ` be
a finite module over a commutative ring `R` whose `k`-th Fitting ideal is generated by a
nonzerodivisor `f_k`, with `f_k` a unit for `k ≥ N`. Then there are elements `e_j` of `R` with

* each `e_j` a nonzerodivisor, so each `D_j` is an effective Cartier divisor;
* `e_j` a unit for `j > N`, so only finitely many `D_j` are nonempty;
* `Fit_k(ℱ) = ∏_{j > k} (e_j)^{j-k}`, the source's `E_k = D_{k+1} + 2 D_{k+2} + 3 D_{k+3} + ⋯`.
-/
theorem exists_equations_of_forall_fittingIdeal_eq_span_singleton {M : Type v} [AddCommGroup M]
    [Module R M] [Module.Finite R M] (N : ℕ) (f : ℕ → R)
    (hfmem : ∀ k, f k ∈ nonZeroDivisors R)
    (hfit : ∀ k : ℕ, fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f k})
    (hfunit : ∀ k, N ≤ k → IsUnit (f k)) :
    ∃ e : ℕ → R,
      (∀ j, e j ∈ nonZeroDivisors R) ∧
      (∀ j, N < j → IsUnit (e j)) ∧
      (∀ k : ℕ, fittingIdeal (R := R) (M := M) (k : ℤ) =
        ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {e j} ^ (j - k)) := by
  have hfac : ∀ a b c : R, a = b * c →
      (a ∈ nonZeroDivisors R → c ∈ nonZeroDivisors R) ∧ (IsUnit a → IsUnit c) := by
    rintro a b c rfl
    exact ⟨fun h => (mul_mem_nonZeroDivisors.mp h).2, isUnit_of_mul_isUnit_right⟩
  have hq : ∀ k : ℕ, ∃ c : R, f k = f (k + 1) * c := by
    intro k
    exact Ideal.span_singleton_le_span_singleton.mp <| by
      rw [← hfit k, ← hfit (k + 1)]
      exact Stacks.Fitting.fittingIdeal_monotone (by exact_mod_cast Nat.le_succ k)
  choose q hqeq using hq
  have hqmem : ∀ k, q k ∈ nonZeroDivisors R := fun k =>
    (hfac _ _ _ (hqeq k)).1 (hfmem k)
  have hqunit : ∀ k, N ≤ k → IsUnit (q k) := fun k hk =>
    (hfac _ _ _ (hqeq k)).2 (hfunit k hk)
  have hE : ∀ k : ℕ, ∃ c : R, q k = q (k + 1) * c := by
    intro k
    have hlog := fittingIdeal_mul_fittingIdeal_le (M := M)
      (fun j => ⟨f j, hfmem j, hfit j⟩) k
    rw [hfit k, hfit (k + 2), hfit (k + 1), Ideal.span_singleton_mul_span_singleton,
      Ideal.span_singleton_mul_span_singleton] at hlog
    obtain ⟨c, hc⟩ := Ideal.span_singleton_le_span_singleton.mp hlog
    refine ⟨c, ?_⟩
    have hreg : IsRegular (f (k + 1) * f (k + 2)) :=
      isRegular_iff_mem_nonZeroDivisors.mpr (mul_mem (hfmem (k + 1)) (hfmem (k + 2)))
    refine hreg.left ?_
    calc f (k + 1) * f (k + 2) * q k = f k * f (k + 2) := by rw [hqeq k]; ring
      _ = f (k + 1) * f (k + 1) * c := hc
      _ = f (k + 1) * (f (k + 2) * q (k + 1)) * c := by rw [← hqeq (k + 1)]
      _ = f (k + 1) * f (k + 2) * (q (k + 1) * c) := by ring
  choose E hEeq using hE
  have hEmem : ∀ k, E k ∈ nonZeroDivisors R := fun k =>
    (hfac _ _ _ (hEeq k)).1 (hqmem k)
  have hEunit : ∀ k, N ≤ k → IsUnit (E k) := fun k hk =>
    (hfac _ _ _ (hEeq k)).2 (hqunit k hk)
  have hqprod : ∀ k : ℕ, Ideal.span {q k} = equationTail (fun j => E (j - 1)) N k := by
    have key : ∀ m k : ℕ, N ≤ k + m →
        Ideal.span {q k} = equationTail (fun j => E (j - 1)) N k := by
      intro m
      induction m with
      | zero =>
        intro k hk
        rw [equationTail_of_le _ (show N ≤ k by omega),
          Ideal.span_singleton_eq_top.mpr (hqunit k (by omega))]
      | succ m ih =>
        intro k hk
        rcases le_or_gt N k with hNk | hNk
        · rw [equationTail_of_le _ hNk, Ideal.span_singleton_eq_top.mpr (hqunit k hNk)]
        · rw [equationTail_succ _ (show k + 1 ≤ N by omega), ← ih (k + 1) (by omega),
            Ideal.span_singleton_mul_span_singleton, hEeq k, Nat.add_sub_cancel,
            mul_comm (q (k + 1)) (E k)]
    exact fun k => key (N + 1) k (by omega)
  have hfprod : ∀ k : ℕ,
      Ideal.span {f k} = ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {E (j - 1)} ^ (j - k) := by
    have key : ∀ m k : ℕ, N ≤ k + m →
        Ideal.span {f k} = ∏ j ∈ Finset.Icc (k + 1) N, Ideal.span {E (j - 1)} ^ (j - k) := by
      intro m
      induction m with
      | zero =>
        intro k hk
        rw [Finset.Icc_eq_empty (by omega), Finset.prod_empty,
          Ideal.span_singleton_eq_top.mpr (hfunit k (by omega)), Ideal.one_eq_top]
      | succ m ih =>
        intro k hk
        rcases le_or_gt N k with hNk | hNk
        · rw [Finset.Icc_eq_empty (by omega), Finset.prod_empty,
            Ideal.span_singleton_eq_top.mpr (hfunit k hNk), Ideal.one_eq_top]
        · have h1 : Ideal.span {f k} = Ideal.span {f (k + 1)} * Ideal.span {q k} := by
            rw [Ideal.span_singleton_mul_span_singleton, ← hqeq k]
          rw [h1, ih (k + 1) (by omega), hqprod k,
            prod_pow_eq_mul_equationTail (fun j => E (j - 1)) N k]
    exact fun k => key (N + 1) k (by omega)
  refine ⟨fun j => E (j - 1), fun j => hEmem _, fun j hj => hEunit _ (by omega), fun k => ?_⟩
  rw [hfit k]
  exact hfprod k

end Stacks.FittingFiltration

end
