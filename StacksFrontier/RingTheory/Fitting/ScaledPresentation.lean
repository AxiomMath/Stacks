* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
-/

@[expose] public noncomputable section

universe u

variable {R : Type u} [CommRing R]

/-! ### Minors of a scaled matrix -/

/-- Scaling a matrix by `f` multiplies its ideal of `r × r` minors by `(f)^r`, because every
`r × r` minor of `f • A` is `f ^ r` times the corresponding minor of `A`. -/
theorem minorIdeal_smul {l o : Type*} (A : Matrix l o R) (f : R) (r : ℕ) :
    minorIdeal (f • A) r = Ideal.span {f} ^ r * minorIdeal A r := by
  have hdet : ∀ (g : Fin r → l) (h : Fin r → o),
      ((f • A).submatrix g h).det = f ^ r * (A.submatrix g h).det := by
    intro g h
    have hsub : (f • A).submatrix g h = f • A.submatrix g h := rfl
    rw [hsub, Matrix.det_smul, Fintype.card_fin]
  refine le_antisymm ?_ ?_
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨g, h, rfl⟩
    rw [hdet g h]
    exact Ideal.mul_mem_mul
      (by rw [Ideal.span_singleton_pow]; exact Ideal.mem_span_singleton_self _)
      (Ideal.subset_span ⟨g, h, rfl⟩)
  · rw [Ideal.mul_le]
    intro a ha b hb
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    rw [mul_comm (f ^ r) c, mul_assoc]
    refine Ideal.mul_mem_left _ _ ?_
    rw [minorIdeal] at hb
    induction hb using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨g, h, rfl⟩ := hx
      exact Ideal.subset_span ⟨g, h, (hdet g h).symm⟩
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
    | smul a x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx

/-- Every entry of a matrix is one of its `1 × 1` minors, hence lies in the ideal they generate.
The membership form of `Stacks.Curves.minorIdeal_one`, which identifies that ideal with the span
of the entries. -/
theorem mem_minorIdeal_one {l o : Type*} (A : Matrix l o R) (i : l) (j : o) :
    A i j ∈ minorIdeal A 1 := by
  rw [Stacks.Curves.minorIdeal_one]
  exact Ideal.subset_span ⟨i, j, rfl⟩

/-! ### The Fitting ideals of a module presented by a scaled matrix -/

/-- The column span of a matrix, the submodule of relations imposed by a presentation. -/
abbrev Matrix.columnSpan {n : ℕ} {J : Type*} (A : Matrix (Fin n) J R) : Submodule R (Fin n → R) :=
  Submodule.span R (Set.range fun j : J => fun i : Fin n => A i j)

/-- The column span of a matrix is the image of the linear map it defines. -/
theorem Matrix.columnSpan_eq_range_mulVecLin {n : ℕ} {J : Type*} [Fintype J]
    (A : Matrix (Fin n) J R) : A.columnSpan = LinearMap.range A.mulVecLin :=
  (Matrix.range_mulVecLin A).symm

/-- **Stacks Project, Tag 0ESU**, the Fitting ideals of a scaled presentation.
If `A = f • B` is an `n`-row presentation matrix of `𝓕` and `B` presents `𝓕'`, then
`Fit_k(𝓕) = (f)^{n-k} Fit_k(𝓕')`. -/
@[stacks 0ESU "the Fitting ideals of a presentation matrix divided by f"]
theorem fittingIdeal_quotient_span_smul {n : ℕ} {J : Type*} (B : Matrix (Fin n) J R) (f : R)
    (k : ℕ) :
    fittingIdeal (M := (Fin n → R) ⧸ (f • B).columnSpan) (k : ℤ) =
      Ideal.span {f} ^ (n - k) * fittingIdeal (M := (Fin n → R) ⧸ B.columnSpan) (k : ℤ) := by
  rw [fittingIdeal_eq_minorIdeal_of_presentation (f • B) k (LinearEquiv.refl _ _),
    fittingIdeal_eq_minorIdeal_of_presentation B k (LinearEquiv.refl _ _), minorIdeal_smul]

/-! ### The two canonical short exact sequences -/

namespace Stacks.ScaledPresentation

open Matrix

/-- The module `Rⁿ / A Rⁿ` presented by a square matrix `A`. -/
abbrev Cokernel {n : ℕ} (A : Matrix (Fin n) (Fin n) R) : Type u :=
  (Fin n → R) ⧸ LinearMap.range A.mulVecLin

/-- The submodule `f Rⁿ ⊆ Rⁿ`, the image of multiplication by `f`. -/
abbrev smulSubmodule (n : ℕ) (f : R) : Submodule R (Fin n → R) :=
  LinearMap.range (LinearMap.lsmul R (Fin n → R) f)

/-- Multiplication by a nonzerodivisor is injective on a product of copies of the ring. -/
theorem smul_left_injective_of_mem_nonZeroDivisors {f : R} (hf : f ∈ nonZeroDivisors R)
    {ι : Type*} {a b : ι → R} (h : f • a = f • b) : a = b := by
  exact funext fun i => (mul_cancel_left_mem_nonZeroDivisors hf).mp (congrFun h i)

/-- The submodule `f Rⁿ` consists of the vectors all of whose entries lie in `(f)`. -/
theorem smulSubmodule_eq_pi (n : ℕ) (f : R) :
    smulSubmodule n f = Submodule.pi Set.univ fun _ : Fin n => (Ideal.span {f} : Ideal R) := by
  ext v
  constructor
  · rintro ⟨w, rfl⟩ i _
    exact Ideal.mem_span_singleton.mpr ⟨w i, rfl⟩
  · intro hv
    choose c hc using fun i => Ideal.mem_span_singleton.mp (Submodule.mem_pi.mp hv i trivial)
    exact ⟨c, by funext i; exact (hc i).symm⟩

/-- `Rⁿ / f Rⁿ` is the free module of rank `n` over `R ⧸ (f)`: it is the structure sheaf of the
effective Cartier divisor cut out by `f`, to the `n`-th power. -/
def quotSmulEquivFree (n : ℕ) (f : R) :
    ((Fin n → R) ⧸ smulSubmodule n f) ≃ₗ[R] (Fin n → R ⧸ Ideal.span {f}) :=
  (Submodule.quotEquivOfEq _ _ (smulSubmodule_eq_pi n f)).trans
    (Submodule.quotientPi fun _ : Fin n => (Ideal.span {f} : Ideal R))

variable {n : ℕ} (B : Matrix (Fin n) (Fin n) R) (f : R)

/-- The relations imposed by `f • B` are exactly the `f`-multiples of those imposed by `B`. -/
theorem mem_range_smul_mulVecLin {v : Fin n → R} :
    v ∈ LinearMap.range (f • B).mulVecLin ↔ ∃ w, v = f • (B *ᵥ w) := by
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨w, by simp⟩
  · rintro ⟨w, rfl⟩
    exact ⟨w, by simp⟩

/-- The relations imposed by `f • B` are among those imposed by `B`. -/
theorem range_smul_le_range : LinearMap.range (f • B).mulVecLin ≤ LinearMap.range B.mulVecLin := by
  rintro v hv
  obtain ⟨w, rfl⟩ := (mem_range_smul_mulVecLin B f).mp hv
  exact ⟨f • w, by simp⟩

/-- The relations imposed by `f • B` are divisible by `f`. -/
theorem range_smul_le_smulSubmodule :
    LinearMap.range (f • B).mulVecLin ≤ smulSubmodule n f := by
  rintro v hv
  obtain ⟨w, rfl⟩ := (mem_range_smul_mulVecLin B f).mp hv
  exact ⟨B *ᵥ w, rfl⟩

/-- Multiplying by `B` carries `f Rⁿ` into the relations imposed by `f • B`. -/
theorem smulSubmodule_le_comap :
    smulSubmodule n f ≤ (LinearMap.range (f • B).mulVecLin).comap B.mulVecLin := by
  rintro v ⟨w, rfl⟩
  exact (mem_range_smul_mulVecLin B f).mpr ⟨w, by simp⟩

/-- Multiplying by `f` carries the relations imposed by `B` into those imposed by `f • B`. -/
theorem range_le_comap_lsmul :
    LinearMap.range B.mulVecLin ≤
      (LinearMap.range (f • B).mulVecLin).comap (LinearMap.lsmul R (Fin n → R) f) := by
  rintro v ⟨w, rfl⟩
  exact (mem_range_smul_mulVecLin B f).mpr ⟨w, rfl⟩

/-- The canonical surjection `𝓕 = Rⁿ/(f • B)Rⁿ → 𝓕' = Rⁿ/B Rⁿ`. -/
def toBase : Cokernel (f • B) →ₗ[R] Cokernel B :=
  Submodule.mapQ _ _ LinearMap.id (range_smul_le_range B f)

/-- Multiplication by `f`, as a map `𝓕' = Rⁿ/B Rⁿ → 𝓕 = Rⁿ/(f • B)Rⁿ`. -/
def ofBase : Cokernel B →ₗ[R] Cokernel (f • B) :=
  Submodule.mapQ _ _ (LinearMap.lsmul R (Fin n → R) f) (range_le_comap_lsmul B f)

/-- Reduction modulo `f`, as a map `𝓕 = Rⁿ/(f • B)Rⁿ → Rⁿ/f Rⁿ`. -/
def toQuotSmul : Cokernel (f • B) →ₗ[R] ((Fin n → R) ⧸ smulSubmodule n f) :=
  Submodule.mapQ _ _ LinearMap.id (range_smul_le_smulSubmodule B f)

/-- Multiplication by `B`, as a map `Rⁿ/f Rⁿ → 𝓕 = Rⁿ/(f • B)Rⁿ`. -/
def ofQuotSmul : ((Fin n → R) ⧸ smulSubmodule n f) →ₗ[R] Cokernel (f • B) :=
  Submodule.mapQ _ _ B.mulVecLin (smulSubmodule_le_comap B f)

/-- Reduction modulo `f`, as a map `𝓕 → (R ⧸ (f))ⁿ`. -/
def toFree : Cokernel (f • B) →ₗ[R] (Fin n → R ⧸ Ideal.span {f}) :=
  (quotSmulEquivFree n f).toLinearMap ∘ₗ toQuotSmul B f

/-- Multiplication by `B`, as a map `(R ⧸ (f))ⁿ → 𝓕`. -/
def ofFree : (Fin n → R ⧸ Ideal.span {f}) →ₗ[R] Cokernel (f • B) :=
  ofQuotSmul B f ∘ₗ (quotSmulEquivFree n f).symm.toLinearMap

/-- `toBase` sends the class of `v` modulo `(f • B) Rⁿ` to its class modulo `B Rⁿ`. -/
@[simp] theorem toBase_mk (v : Fin n → R) :
    toBase B f (Submodule.Quotient.mk v) = Submodule.Quotient.mk v := rfl

/-- `ofBase` sends the class of `v` modulo `B Rⁿ` to the class of `f • v` modulo `(f • B) Rⁿ`. -/
@[simp] theorem ofBase_mk (v : Fin n → R) :
    ofBase B f (Submodule.Quotient.mk v) = Submodule.Quotient.mk (f • v) := rfl

/-- `toQuotSmul` sends the class of `v` modulo `(f • B) Rⁿ` to its class modulo `f Rⁿ`. -/
@[simp] theorem toQuotSmul_mk (v : Fin n → R) :
    toQuotSmul B f (Submodule.Quotient.mk v) = Submodule.Quotient.mk v := rfl

/-- `ofQuotSmul` sends the class of `v` modulo `f Rⁿ` to the class of `B *ᵥ v` modulo
`(f • B) Rⁿ`. -/
@[simp] theorem ofQuotSmul_mk (v : Fin n → R) :
    ofQuotSmul B f (Submodule.Quotient.mk v) = Submodule.Quotient.mk (B *ᵥ v) := rfl

/-! #### Surjectivity and injectivity of the four maps -/

/-- The map `𝓕 → 𝓕'` is surjective. -/
theorem toBase_surjective : Function.Surjective (toBase B f) := by
  intro y
  induction y using Submodule.Quotient.induction_on with
  | _ v => exact ⟨Submodule.Quotient.mk v, rfl⟩

/-- Reduction modulo `f`, `𝓕 → Rⁿ / f Rⁿ`, is surjective. -/
theorem toQuotSmul_surjective : Function.Surjective (toQuotSmul B f) := by
  intro y
  induction y using Submodule.Quotient.induction_on with
  | _ v => exact ⟨Submodule.Quotient.mk v, rfl⟩

/-- Reduction modulo `f`, `𝓕 → (R ⧸ (f))ⁿ`, is surjective. -/
theorem toFree_surjective : Function.Surjective (toFree B f) := by
  intro y
  obtain ⟨x, hx⟩ := toQuotSmul_surjective B f ((quotSmulEquivFree n f).symm y)
  exact ⟨x, by simp [toFree, hx]⟩

/-- Multiplication by `f` is injective on `𝓕'` when `f` is a nonzerodivisor: this is the
injectivity in the short exact sequence `0 → 𝓕' → 𝓕 → 𝒪_D^{⊕n} → 0`. -/
theorem ofBase_injective (hf : f ∈ nonZeroDivisors R) : Function.Injective (ofBase B f) := by
  refine (injective_iff_map_eq_zero _).mpr fun y hy => ?_
  induction y using Submodule.Quotient.induction_on with
  | _ v =>
    rw [ofBase_mk, Submodule.Quotient.mk_eq_zero] at hy
    obtain ⟨w, hw⟩ := (mem_range_smul_mulVecLin B f).mp hy
    rw [Submodule.Quotient.mk_eq_zero]
    exact ⟨w, (smul_left_injective_of_mem_nonZeroDivisors hf hw).symm⟩

/-- Multiplication by `B` is injective on `Rⁿ / f Rⁿ` when `B` is injective: this is the
injectivity in the short exact sequence `0 → 𝒪_D^{⊕n} → 𝓕 → 𝓕' → 0`. -/
theorem ofQuotSmul_injective (hB : Function.Injective B.mulVecLin) :
    Function.Injective (ofQuotSmul B f) := by
  refine (injective_iff_map_eq_zero _).mpr fun y hy => ?_
  induction y using Submodule.Quotient.induction_on with
  | _ v =>
    rw [ofQuotSmul_mk, Submodule.Quotient.mk_eq_zero] at hy
    obtain ⟨w, hw⟩ := (mem_range_smul_mulVecLin B f).mp hy
    have h2 : B.mulVecLin v = B.mulVecLin (f • w) := by
      simpa [Matrix.mulVec_smul] using hw
    rw [Submodule.Quotient.mk_eq_zero]
    exact ⟨w, (hB h2).symm⟩

/-- Multiplication by `B`, `(R ⧸ (f))ⁿ → 𝓕`, is injective when `B` is injective. -/
theorem ofFree_injective (hB : Function.Injective B.mulVecLin) :
    Function.Injective (ofFree B f) :=
  (ofQuotSmul_injective B f hB).comp (quotSmulEquivFree n f).symm.injective

/-! #### Exactness in the middle -/

/-- The image of multiplication by `f` is the kernel of reduction modulo `f`: this is exactness
of `0 → 𝓕' → 𝓕 → 𝒪_D^{⊕n} → 0` in the middle. -/
theorem ker_toQuotSmul : LinearMap.ker (toQuotSmul B f) = LinearMap.range (ofBase B f) := by
  refine le_antisymm ?_ ?_
  · intro x hx
    induction x using Submodule.Quotient.induction_on with
    | _ v =>
      rw [LinearMap.mem_ker, toQuotSmul_mk, Submodule.Quotient.mk_eq_zero] at hx
      obtain ⟨c, hc⟩ := hx
      exact ⟨Submodule.Quotient.mk c, by rw [ofBase_mk]; exact congrArg _ hc⟩
  · rintro _ ⟨y, rfl⟩
    induction y using Submodule.Quotient.induction_on with
    | _ w =>
      rw [LinearMap.mem_ker, ofBase_mk, toQuotSmul_mk, Submodule.Quotient.mk_eq_zero]
      exact ⟨w, rfl⟩

/-- The image of multiplication by `B` is the kernel of the surjection onto `𝓕'`: this is
exactness of `0 → 𝒪_D^{⊕n} → 𝓕 → 𝓕' → 0` in the middle. -/
theorem ker_toBase : LinearMap.ker (toBase B f) = LinearMap.range (ofQuotSmul B f) := by
  refine le_antisymm ?_ ?_
  · intro x hx
    induction x using Submodule.Quotient.induction_on with
    | _ v =>
      rw [LinearMap.mem_ker, toBase_mk, Submodule.Quotient.mk_eq_zero] at hx
      obtain ⟨w, hw⟩ := hx
      exact ⟨Submodule.Quotient.mk w, by rw [ofQuotSmul_mk]; exact congrArg _ hw⟩
  · rintro _ ⟨y, rfl⟩
    induction y using Submodule.Quotient.induction_on with
    | _ w =>
      rw [LinearMap.mem_ker, ofQuotSmul_mk, toBase_mk, Submodule.Quotient.mk_eq_zero]
      exact ⟨w, rfl⟩

/-- The kernel of `𝓕 → (R ⧸ (f))ⁿ` is the image of multiplication by `f` from `𝓕'`. -/
theorem ker_toFree : LinearMap.ker (toFree B f) = LinearMap.range (ofBase B f) := by
  rw [← ker_toQuotSmul B f, toFree]
  exact LinearMap.ker_comp_of_ker_eq_bot _ (LinearMap.ker_eq_bot_of_injective
    (quotSmulEquivFree n f).injective)

/-- The image of `(R ⧸ (f))ⁿ → 𝓕` is that of multiplication by `B` on `Rⁿ / f Rⁿ`. -/
private theorem range_ofFree_eq :
    LinearMap.range (ofFree B f) = LinearMap.range (ofQuotSmul B f) := by
  rw [ofFree, LinearMap.range_comp]
  simp [LinearMap.range_eq_top_of_surjective _ (quotSmulEquivFree n f).symm.surjective]

/-- The image of `(R ⧸ (f))ⁿ → 𝓕` is the kernel of `𝓕 → 𝓕'`. -/
theorem range_ofFree : LinearMap.range (ofFree B f) = LinearMap.ker (toBase B f) := by
  rw [range_ofFree_eq, ker_toBase]

/-! #### Canonicity: the two sequences are the kernel and cokernel of multiplication by `f` -/

/-- Multiplication by `f` on `𝓕` factors as `𝓕 → 𝓕' → 𝓕`. -/
private theorem lsmul_eq_ofBase_comp_toBase :
    LinearMap.lsmul R (Cokernel (f • B)) f = ofBase B f ∘ₗ toBase B f := by
  ext v
  rfl

/-- The submodule `𝓕'` of `𝓕` is the image of multiplication by `f`, so the quotient in
`0 → 𝓕' → 𝓕 → 𝒪_D^{⊕n} → 0` is `Coker(f : 𝓕 → 𝓕)`. -/
theorem range_lsmul_eq_range_ofBase :
    LinearMap.range (LinearMap.lsmul R (Cokernel (f • B)) f) = LinearMap.range (ofBase B f) := by
  rw [lsmul_eq_ofBase_comp_toBase, LinearMap.range_comp_of_range_eq_top _
    (LinearMap.range_eq_top.mpr (toBase_surjective B f))]

/-- The submodule `𝒪_D^{⊕n}` of `𝓕` is the kernel of multiplication by `f`, so the sequence
`0 → 𝒪_D^{⊕n} → 𝓕 → 𝓕' → 0` is canonical. -/
theorem ker_lsmul_eq_range_ofQuotSmul (hf : f ∈ nonZeroDivisors R) :
    LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) f) = LinearMap.range (ofQuotSmul B f) := by
  rw [lsmul_eq_ofBase_comp_toBase, LinearMap.ker_comp_of_ker_eq_bot _
    (LinearMap.ker_eq_bot.mpr (ofBase_injective B f hf)), ker_toBase]

/-- When `f` is a nonzerodivisor, the kernel of multiplication by `f` on `𝓕` is the image of
`(R ⧸ (f))ⁿ → 𝓕`. -/
theorem ker_lsmul_eq_range_ofFree (hf : f ∈ nonZeroDivisors R) :
    LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) f) = LinearMap.range (ofFree B f) := by
  rw [ker_lsmul_eq_range_ofQuotSmul B f hf, range_ofFree_eq]

/-! #### The two short exact sequences -/

/-- **Stacks Project, Tag 0ESU**, the Fitting ideals of a square presentation matrix divided by
`f`: if `𝓕` is presented by `f • B` and `𝓕'` by `B`, then `Fit_k(𝓕) = (f)^{n-k} Fit_k(𝓕')`. -/
@[stacks 0ESU "the Fitting ideals of a square presentation matrix divided by f"]
theorem fittingIdeal_cokernel_smul (k : ℕ) :
    fittingIdeal (M := Cokernel (f • B)) (k : ℤ) =
      Ideal.span {f} ^ (n - k) * fittingIdeal (M := Cokernel B) (k : ℤ) := by
  rw [fittingIdeal_eq_minorIdeal_of_presentation (f • B) k
      (Submodule.quotEquivOfEq _ _ (Matrix.columnSpan_eq_range_mulVecLin (f • B))),
    fittingIdeal_eq_minorIdeal_of_presentation B k
      (Submodule.quotEquivOfEq _ _ (Matrix.columnSpan_eq_range_mulVecLin B)),
    minorIdeal_smul]

/-- **Stacks Project, Tag 0ESU**, the first canonical short exact sequence of a local
presentation. For `A = f • B` with `B` injective, writing `𝓕 = Rⁿ / A Rⁿ` and `𝓕' = Rⁿ / B Rⁿ`,
the sequence
```
0 → (R ⧸ (f))ⁿ → 𝓕 → 𝓕' → 0
```
is exact, and when `f` is a nonzerodivisor its submodule is `Ker(f : 𝓕 → 𝓕)`, which is what makes
the sequence canonical. Here `R ⧸ (f)` is the structure sheaf of the effective Cartier divisor
cut out by `f`. -/
@[stacks 0ESU "the canonical sequence 0 → 𝒪_{D_n}^{⊕n} → ℱ → ℱ' → 0 of a local presentation"]
theorem shortExact_ofFree_toBase (hf : f ∈ nonZeroDivisors R)
    (hB : Function.Injective B.mulVecLin) :
    Function.Injective (ofFree B f) ∧
      LinearMap.range (ofFree B f) = LinearMap.ker (toBase B f) ∧
      Function.Surjective (toBase B f) ∧
      LinearMap.range (ofFree B f) = LinearMap.ker (LinearMap.lsmul R (Cokernel (f • B)) f) :=
  ⟨ofFree_injective B f hB, range_ofFree B f, toBase_surjective B f,
    (ker_lsmul_eq_range_ofFree B f hf).symm⟩

/-- **Stacks Project, Tag 0ESU**, the second canonical short exact sequence of a local
presentation. For `A = f • B` with `f` a nonzerodivisor, writing `𝓕 = Rⁿ / A Rⁿ` and
`𝓕' = Rⁿ / B Rⁿ`, the sequence
```
0 → 𝓕' → 𝓕 → (R ⧸ (f))ⁿ → 0
```
is exact, and its submodule is the image of multiplication by `f` on `𝓕`, so that its quotient
is `Coker(f : 𝓕 → 𝓕)`; this is what makes the sequence canonical. -/
@[stacks 0ESU "the canonical sequence 0 → ℱ' → ℱ → 𝒪_{D_n}^{⊕n} → 0 of a local presentation"]
theorem shortExact_ofBase_toFree (hf : f ∈ nonZeroDivisors R) :
    Function.Injective (ofBase B f) ∧
      LinearMap.range (ofBase B f) = LinearMap.ker (toFree B f) ∧
      Function.Surjective (toFree B f) ∧
      LinearMap.range (ofBase B f) = LinearMap.range (LinearMap.lsmul R (Cokernel (f • B)) f) :=
  ⟨ofBase_injective B f hf, (ker_toFree B f).symm, toFree_surjective B f,
    (range_lsmul_eq_range_ofBase B f).symm⟩

/-! #### Where the factorization comes from -/

/-- For a square presentation matrix `A` of size `n = m + 1`, the Fitting ideal `Fit_{n-1}(𝓕)` of
`𝓕 = Rⁿ / A Rⁿ` is the ideal of `1 × 1` minors of `A`, that is, the ideal generated by the entries
of `A`. -/
theorem fittingIdeal_cokernel_eq_minorIdeal_one {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R) :
    fittingIdeal (M := Cokernel A) (m : ℤ) = minorIdeal A 1 := by
  have hsub : m + 1 - m = 1 := by omega
  rw [fittingIdeal_eq_minorIdeal_of_presentation A m
    (Submodule.quotEquivOfEq _ _ (Matrix.columnSpan_eq_range_mulVecLin A)), hsub]

/-- **Stacks Project, Tag 0ESU**, the factorization `A = f A'`. For `𝓕 = R^{n} / A R^{n}`
presented by a square matrix `A` with `n = m + 1` rows, the Fitting ideal `Fit_{n-1}(𝓕)` is the
ideal generated by the entries of `A`, namely the ideal of `1 × 1` minors. So if it is generated
by a single element `f` — which in the source is arranged by shrinking the affine open — then `f`
divides every entry of `A` and `A = f A'` for some square matrix `A'`. -/
theorem exists_eq_smul_of_fittingIdeal_eq_span_singleton {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R)
    (hfit : fittingIdeal (M := Cokernel A) (m : ℤ) = Ideal.span {f}) :
    ∃ A' : Matrix (Fin (m + 1)) (Fin (m + 1)) R, A = f • A' := by
  classical
  have hpres : fittingIdeal (M := Cokernel A) (m : ℤ) = minorIdeal A 1 :=
    fittingIdeal_cokernel_eq_minorIdeal_one A
  have hmem : ∀ i j, f ∣ A i j := by
    intro i j
    refine Ideal.mem_span_singleton.mp ?_
    rw [← hfit, hpres]
    exact mem_minorIdeal_one A i j
  choose c hc using fun i j => hmem i j
  refine ⟨fun i j => c i j, ?_⟩
  ext i j
  exact hc i j

/-- **Stacks Project, Tag 0ESU**, the local step of the induction. Let `𝓕 = R^{n} / A R^{n}` be
presented by a square matrix `A` with `n = m + 1` rows, with `A` injective, and suppose
`Fit_{n-1}(𝓕)` is generated by a nonzerodivisor `f`. Then `A = f A'` for a square matrix `A'`
which is again injective, so that `𝓕' = R^{n} / A' R^{n}` is presented by an exact sequence of
the same shape, and `𝓕` sits in the two canonical short exact sequences
```
0 → (R ⧸ (f))ⁿ → 𝓕 → 𝓕' → 0    and    0 → 𝓕' → 𝓕 → (R ⧸ (f))ⁿ → 0
```
whose free term is the structure sheaf of the divisor cut out by `f` — the divisor `D_n` of the
source — and whose submodule and quotient are `Ker(f : 𝓕 → 𝓕)` and `Coker(f : 𝓕 → 𝓕)`. -/
@[stacks 0ESU "the local step: a principal Fit_{n-1} gives A = f A' and the two sequences"]
theorem exists_eq_smul_and_shortExact {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (hf : f ∈ nonZeroDivisors R)
    (hA : Function.Injective A.mulVecLin)
    (hfit : fittingIdeal (M := Cokernel A) (m : ℤ) = Ideal.span {f}) :
    ∃ A' : Matrix (Fin (m + 1)) (Fin (m + 1)) R, A = f • A' ∧
      Function.Injective A'.mulVecLin ∧
      (Function.Injective (ofFree A' f) ∧
        LinearMap.range (ofFree A' f) = LinearMap.ker (toBase A' f) ∧
        Function.Surjective (toBase A' f) ∧
        LinearMap.range (ofFree A' f) =
          LinearMap.ker (LinearMap.lsmul R (Cokernel (f • A')) f)) ∧
      (Function.Injective (ofBase A' f) ∧
        LinearMap.range (ofBase A' f) = LinearMap.ker (toFree A' f) ∧
        Function.Surjective (toFree A' f) ∧
        LinearMap.range (ofBase A' f) =
          LinearMap.range (LinearMap.lsmul R (Cokernel (f • A')) f)) := by
  obtain ⟨A', hA'⟩ := exists_eq_smul_of_fittingIdeal_eq_span_singleton f A hfit
  have hA'inj : Function.Injective A'.mulVecLin := by
    intro v w hvw
    have hv : A' *ᵥ v = A' *ᵥ w := hvw
    refine hA ?_
    change A *ᵥ v = A *ᵥ w
    rw [hA', Matrix.smul_mulVec, Matrix.smul_mulVec, hv]
  exact ⟨A', hA', hA'inj, shortExact_ofFree_toBase A' f hf hA'inj,
    shortExact_ofBase_toFree A' f hf⟩

/-- Cancelling a nonzerodivisor: if `(f) I = (f)` and `f` is a nonzerodivisor then `I` is the unit
ideal, because `f` itself must be `f` times an element of `I`. -/
theorem eq_top_of_span_singleton_mul_eq (hf : f ∈ nonZeroDivisors R) {I : Ideal R}
    (h : Ideal.span {f} * I = Ideal.span {f}) : I = ⊤ := by
  have hfmem : f ∈ Ideal.span {f} * I := by
    rw [h]; exact Ideal.mem_span_singleton_self f
  obtain ⟨z, hz, hfz⟩ := Ideal.mem_span_singleton_mul.mp hfmem
  have hz1 : z = 1 := (mul_cancel_left_mem_nonZeroDivisors hf).mp (hfz.trans (mul_one f).symm)
  rw [Ideal.eq_top_iff_one, ← hz1]
  exact hz

/-- **Stacks Project, Tag 0ESU**: the entries of `A'` generate the unit ideal. If `𝓕` is presented
by `A = f A'` with `A'` square of size `n = m + 1` and `Fit_{n-1}(𝓕)` is generated by the
nonzerodivisor `f`, then `Fit_{n-1}(𝓕') = R` for `𝓕' = R^{n} / A' R^{n}`: the scaling identity
gives `(f) = (f) · Fit_{n-1}(𝓕')`, and `f` cancels. Since `Fit_{n-1}(𝓕')` is the ideal of
`1 × 1` minors of `A'`, this says the entries of `A'` generate the unit ideal, which is the
hypothesis under which the source invokes Algebra, Lemma 10.102.2 (tag 00MT) to drop the number
of generators by one. -/
@[stacks 0ESU "the entries of A' generate the unit ideal"]
theorem fittingIdeal_cokernel_eq_top_of_fittingIdeal_smul_eq_span_singleton {m : ℕ}
    (A' : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (hf : f ∈ nonZeroDivisors R)
    (hfit : fittingIdeal (M := Cokernel (f • A')) (m : ℤ) = Ideal.span {f}) :
    fittingIdeal (R := R) (M := Cokernel A') (m : ℤ) = ⊤ := by
  have hsub : m + 1 - m = 1 := by omega
  have hscale := fittingIdeal_cokernel_smul A' f m
  rw [hfit, hsub, pow_one] at hscale
  exact eq_top_of_span_singleton_mul_eq f hf hscale.symm

end Stacks.ScaledPresentation

end
