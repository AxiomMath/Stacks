module

public import StacksFrontier.RingTheory.Fitting.Basic

/-!
# The zeroth Fitting ideal of a cyclic module

A finite module generated by a single element is isomorphic to `R ⧸ Ann(M)`, and the zeroth
Fitting ideal of `R ⧸ I` is `I`, so for a cyclic module the zeroth Fitting ideal is exactly the
annihilator. In general only the inclusion `Fit₀(M) ≤ Ann(M)` holds.

## Main results

* `fittingIdeal_zero_eq_annihilator_of_span_singleton_eq_top`: for a module generated by one
  element the zeroth Fitting ideal is the annihilator.

## References

* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA)
-/

universe u v

@[expose] public section

/-- A module generated by a single element is isomorphic to the quotient of the ring by its
annihilator. -/
theorem quotientAnnihilator_linearEquiv_of_span_singleton_eq_top {R : Type u} [CommRing R]
    {M : Type v} [AddCommGroup M] [Module R M] {x : M}
    (hx : Submodule.span R {x} = ⊤) :
    Nonempty ((R ⧸ Module.annihilator R M) ≃ₗ[R] M) := by
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton R M x) := by
    rw [← LinearMap.range_eq_top, ← LinearMap.span_singleton_eq_range, hx]
  have hker : LinearMap.ker (LinearMap.toSpanSingleton R M x) = Module.annihilator R M := by
    ext r
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, Module.mem_annihilator]
    refine ⟨fun h m ↦ ?_, fun h ↦ h x⟩
    have hm : m ∈ Submodule.span R {x} := hx ▸ Submodule.mem_top
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hm
    rw [smul_comm, h, smul_zero]
  exact ⟨hker ▸ (LinearMap.toSpanSingleton R M x).quotKerEquivOfSurjective hsurj⟩

/-- **The zeroth Fitting ideal of a cyclic module is its annihilator.** -/
theorem fittingIdeal_zero_eq_annihilator_of_span_singleton_eq_top {R : Type u} [CommRing R]
    {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M] {x : M}
    (hx : Submodule.span R {x} = ⊤) :
    fittingIdeal (R := R) (M := M) 0 = Module.annihilator R M := by
  obtain ⟨e⟩ := quotientAnnihilator_linearEquiv_of_span_singleton_eq_top hx
  have h := fittingIdeal_eq_of_linearEquiv.{u, u, v} e 0
  rw [Nat.cast_zero] at h
  rw [← h, (fittingIdeal_basic_properties.{u, u, u, u}
    (R := R) (M := R ⧸ Module.annihilator R M)).2.2.2.2.2.2.2]

end
