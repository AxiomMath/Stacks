module

public import StacksFrontier.AlgebraicGeometry.Curves.JacobianCriterionPlane
public import Mathlib.RingTheory.Localization.Away.Basic
public import StacksFrontier.Algebra.Homology.FiniteFreeComplex
public import StacksFrontier.RingTheory.Fitting.ScaledPresentation

/-!
# Dropping a generator when the relation entries generate the unit ideal

Let `A` be an `n × n` matrix over a commutative ring `R` with `n = m + 1`, and let `𝓕 = Rⁿ / A Rⁿ`
be the module it presents. The Fitting ideal `Fit_{n-1}(𝓕)` is the ideal generated by the entries
of `A`. This file proves that if that ideal is the unit ideal then, on a Zariski cover of `Spec R`,
`𝓕` is presented by a matrix with one row and one column fewer, so in particular it needs only
`n - 1` generators.

An entry of `A` which is a unit can be cleared by invertible row and column operations, bringing
`A` into the block form `diag(1, ψ)`; neither operation changes the module presented, and the
module presented by `diag(1, ψ)` is the module presented by `ψ`, which has `n - 1` rows. The
entries of `A` generating the unit ideal is exactly the statement that the basic opens `D(A i j)`
cover `Spec R`, and on `D(A i j)` the entry `A i j` is a unit.

## Main results

* `Stacks.ScaledPresentation.cokernelEquivMulMul`: `Rⁿ / A Rⁿ ≅ Rⁿ / (L A K) Rⁿ` for `L` and `K`
  of unit determinant — invertible row and column operations do not change the module presented.
* `Stacks.ScaledPresentation.cokernelEquivBlock`: the module presented by a matrix of the block
  form `diag(1, ψ)` is the module presented by `ψ`.
* `Stacks.ScaledPresentation.exists_cokernel_equiv_of_isUnit_entry`: if some entry of `A` is a unit
  then `Rⁿ / A Rⁿ` is the cokernel of an `(n-1) × (n-1)` matrix, which is again injective if `A`
  was.
* `Stacks.ScaledPresentation.exists_span_eq_top_of_isUnit_entry`: under the same hypothesis, `𝓕` is
  generated by `n - 1` elements.
* `Stacks.ScaledPresentation.span_entries_eq_top_of_fittingIdeal_eq_top`: `Fit_{n-1}(𝓕) = R` says
  the entries of `A` generate the unit ideal, so the basic opens they cut out cover `Spec R`.
* `Stacks.ScaledPresentation.exists_cover_cokernel_equiv_of_fittingIdeal_eq_top`: the two previous
  items combined — if `Fit_{n-1}(𝓕) = R`, the basic opens `D(A i j)` cover `Spec R` and on each of
  them `𝓕` is presented by an `(n-1) × (n-1)` matrix and generated by `n - 1` elements.

## Implementation notes

**Why the cokernel of a matrix and not a complex.** The repository's form of tag 00MT,
`exists_splitOff_elementaryComplex_of_hasInvertibleCoeff` in
`StacksFrontier.Algebra.Homology.FiniteFreeComplex`, splits an elementary complex off a bounded
complex of finite free modules. Nothing related that to the cokernel of a single matrix, which is
the shape in which tag 0ESU consumes the lemma: there `𝓕` and `𝓕'` are presented by square
matrices and the induction is on their size. So the normalization is carried out directly on the
cokernel here, reusing the matrix normalization
`BoundedFreeComplex.exists_block_form_of_unit_entry` that the complex version also uses.

**The cover.** The source shrinks the affine open `V` until an entry becomes a unit. That step is
rendered as a pair: the entries generate the unit ideal, hence the basic opens they cut out cover,
and over `Localization.Away (A i j)` the entry `A i j` is a unit.

## References

* [Stacks Project, Tag 0ESU](https://stacks.math.columbia.edu/tag/0ESU)
* [Stacks Project, Tag 00MT](https://stacks.math.columbia.edu/tag/00MT)
-/


@[expose] public noncomputable section

universe u

namespace Stacks.ScaledPresentation

open Matrix

variable {R : Type u} [CommRing R]

/-! ### Invertible row and column operations -/

/-- Multiplication by a matrix of unit determinant is a bijection on `Rⁿ`, its inverse being
multiplication by the inverse matrix. -/
theorem mulVecLin_bijective_of_isUnit_det {n : ℕ} (L : Matrix (Fin n) (Fin n) R)
    (hL : IsUnit L.det) : Function.Bijective L.mulVecLin := by
  classical
  refine ⟨fun v w hvw => ?_, fun v => ⟨L⁻¹ *ᵥ v, ?_⟩⟩
  · simpa [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul L hL] using congrArg (L⁻¹ *ᵥ ·) hvw
  · simp [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv L hL]

/-- The relations imposed by `L A K`, for `K` of unit determinant, are the image under `L` of the
relations imposed by `A`: multiplying on the right by an invertible matrix permutes the relations
and multiplying on the left by `L` transports them. -/
theorem range_mulVecLin_mul_mul {n : ℕ} (A L K : Matrix (Fin n) (Fin n) R) (hK : IsUnit K.det) :
    LinearMap.range (L * A * K).mulVecLin =
      Submodule.map L.mulVecLin (LinearMap.range A.mulVecLin) := by
  rw [Matrix.mulVecLin_mul, LinearMap.range_comp,
    LinearMap.range_eq_top.mpr (mulVecLin_bijective_of_isUnit_det K hK).2, Submodule.map_top,
    Matrix.mulVecLin_mul, LinearMap.range_comp]

/-- Invertible row and column operations do not change the module presented by a square matrix:
`Rⁿ / A Rⁿ ≅ Rⁿ / (L A K) Rⁿ` whenever `L` and `K` have unit determinant. -/
def cokernelEquivMulMul {n : ℕ} (A L K : Matrix (Fin n) (Fin n) R)
    (hL : IsUnit L.det) (hK : IsUnit K.det) : Cokernel A ≃ₗ[R] Cokernel (L * A * K) :=
  Submodule.Quotient.equiv _ _
    (LinearEquiv.ofBijective L.mulVecLin (mulVecLin_bijective_of_isUnit_det L hL))
    (by
      rw [show ((LinearEquiv.ofBijective L.mulVecLin
          (mulVecLin_bijective_of_isUnit_det L hL) : (Fin n → R) ≃ₗ[R] (Fin n → R)) :
          (Fin n → R) →ₗ[R] (Fin n → R)) = L.mulVecLin from rfl]
      exact (range_mulVecLin_mul_mul A L K hK).symm)

/-! ### Forgetting the first coordinate -/

/-- Forgetting the first coordinate of a vector, `Rⁿ⁺¹ → Rⁿ`. -/
abbrev dropFirst (n : ℕ) : (Fin (n + 1) → R) →ₗ[R] (Fin n → R) :=
  LinearMap.funLeft R R Fin.succ

/-- The `p`-th coordinate of `dropFirst n v` is the `p.succ`-th coordinate of `v`. -/
@[simp] theorem dropFirst_apply {n : ℕ} (v : Fin (n + 1) → R) (p : Fin n) :
    dropFirst n v p = v p.succ := rfl

/-- Forgetting the first coordinate of `Fin.cons x w` gives back `w`. -/
private theorem dropFirst_cons {n : ℕ} (x : R) (w : Fin n → R) :
    dropFirst n (Fin.cons x w : Fin (n + 1) → R) = w := by
  funext p; simp

/-- Forgetting the first coordinate, `Rⁿ⁺¹ → Rⁿ`, is surjective. -/
theorem dropFirst_surjective (n : ℕ) : Function.Surjective (dropFirst (R := R) n) :=
  fun w => ⟨Fin.cons 0 w, by funext p; simp⟩

/-! ### The module presented by a block matrix -/

section Block

variable {m : ℕ} (C : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (ψ : Matrix (Fin m) (Fin m) R)
  (h00 : C 0 0 = 1) (hrow : ∀ q : Fin m, C 0 q.succ = 0)
  (hcol : ∀ p : Fin m, C p.succ 0 = 0) (hblock : ∀ p q : Fin m, C p.succ q.succ = ψ p q)

include h00 hrow hcol hblock

/-- Multiplication by a matrix of the block form `diag(1, ψ)` acts as the identity on the first
coordinate and as `ψ` on the remaining ones. -/
theorem mulVec_of_block (v : Fin (m + 1) → R) :
    C *ᵥ v = Fin.cons (v 0) (ψ *ᵥ dropFirst m v) := by
  funext i
  induction i using Fin.cases with
  | zero =>
    rw [Matrix.mulVec, dotProduct, Fin.sum_univ_succ, h00, one_mul, Fin.cons_zero]
    simp [hrow]
  | succ p =>
    rw [Matrix.mulVec, dotProduct, Fin.sum_univ_succ, hcol, zero_mul, zero_add,
      Fin.cons_succ, Matrix.mulVec, dotProduct]
    exact Finset.sum_congr rfl fun q _ => by rw [hblock, dropFirst_apply]

/-- Multiplication by a matrix of the block form `diag(1, ψ)` is injective exactly when
multiplication by `ψ` is. -/
theorem mulVecLin_injective_of_block (hC : Function.Injective C.mulVecLin) :
    Function.Injective ψ.mulVecLin := by
  intro w w' hww
  have h : C *ᵥ Fin.cons 0 w = C *ᵥ Fin.cons 0 w' := by
    rw [mulVec_of_block C ψ h00 hrow hcol hblock, mulVec_of_block C ψ h00 hrow hcol hblock]
    rw [dropFirst_cons, dropFirst_cons, Fin.cons_zero, Fin.cons_zero]
    exact congrArg _ hww
  have := hC h
  funext p
  exact congrFun (congrArg (fun u => Fin.tail u) this) p

/-- A vector whose last `m` coordinates vanish is a relation of a matrix of the block form
`diag(1, ψ)`, its first column being the first standard basis vector. -/
theorem mem_range_of_dropFirst_eq_zero {v : Fin (m + 1) → R} (hv : dropFirst m v = 0) :
    v ∈ LinearMap.range C.mulVecLin := by
  refine ⟨Fin.cons (v 0) 0, ?_⟩
  change C *ᵥ Fin.cons (v 0) 0 = v
  rw [mulVec_of_block C ψ h00 hrow hcol hblock]
  rw [dropFirst_cons, Matrix.mulVec_zero, Fin.cons_zero]
  funext i
  induction i using Fin.cases with
  | zero => rw [Fin.cons_zero]
  | succ p => rw [Fin.cons_succ]; exact (congrFun hv p).symm

/-- Forgetting the first coordinate carries the relations of a matrix of the block form
`diag(1, ψ)` into the relations of `ψ`. -/
theorem range_le_comap_dropFirst :
    LinearMap.range C.mulVecLin ≤
      Submodule.comap (dropFirst m) (LinearMap.range ψ.mulVecLin) := by
  rintro _ ⟨w, rfl⟩
  refine ⟨dropFirst m w, ?_⟩
  change ψ *ᵥ dropFirst m w = dropFirst m (C *ᵥ w)
  rw [mulVec_of_block C ψ h00 hrow hcol hblock]
  funext p
  rw [dropFirst_apply, Fin.cons_succ]

/-- **The module presented by a block matrix `diag(1, ψ)` is the module presented by `ψ`.** The
isomorphism forgets the first coordinate; it is well defined because the first standard basis
vector is a relation of `diag(1, ψ)`, and injective because that is the only relation forgotten. -/
def cokernelEquivBlock : Cokernel C ≃ₗ[R] Cokernel ψ :=
  LinearEquiv.ofBijective
    (Submodule.mapQ _ _ (dropFirst m) (range_le_comap_dropFirst C ψ h00 hrow hcol hblock))
    (by
      constructor
      · refine (injective_iff_map_eq_zero _).mpr fun x hx => ?_
        induction x using Submodule.Quotient.induction_on with
        | _ v =>
          rw [Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at hx
          obtain ⟨w, hw⟩ := hx
          have hwv : dropFirst m (v - C *ᵥ Fin.cons 0 w) = 0 := by
            have hd : dropFirst m (Fin.cons (0 : R) w) = w := by funext p; simp
            have : dropFirst m (C *ᵥ Fin.cons 0 w) = ψ *ᵥ w := by
              rw [mulVec_of_block C ψ h00 hrow hcol hblock, hd]
              funext p
              rw [dropFirst_apply, Fin.cons_succ]
            rw [map_sub, this]
            exact sub_eq_zero.mpr hw.symm
          rw [Submodule.Quotient.mk_eq_zero]
          have hsub := mem_range_of_dropFirst_eq_zero C ψ h00 hrow hcol hblock hwv
          have hmem : (C *ᵥ Fin.cons (0 : R) w) ∈ LinearMap.range C.mulVecLin := ⟨_, rfl⟩
          simpa using add_mem hsub hmem
      · intro y
        induction y using Submodule.Quotient.induction_on with
        | _ w =>
          obtain ⟨v, hv⟩ := dropFirst_surjective (R := R) m w
          exact ⟨Submodule.Quotient.mk v, by rw [Submodule.mapQ_apply]; exact congrArg _ hv⟩)

end Block

/-! ### Clearing a unit entry -/

/-- If some entry of a square matrix `A` of size `n = m + 1` is a unit, then the module `Rⁿ / A Rⁿ`
presented by `A` is the module presented by a square matrix of size `m`, which is again injective
if `A` is. -/
@[stacks 0ESU "dropping a generator: a unit relation entry gives a smaller presentation"]
theorem exists_cokernel_equiv_of_isUnit_entry {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (a b : Fin (m + 1)) (hu : IsUnit (A a b)) :
    ∃ ψ : Matrix (Fin m) (Fin m) R,
      Nonempty (Cokernel A ≃ₗ[R] Cokernel ψ) ∧
        (Function.Injective A.mulVecLin → Function.Injective ψ.mulVecLin) := by
  obtain ⟨L, K, ψ, hL, hK, hblock, h00, hrow, hcol⟩ :=
    BoundedFreeComplex.exists_block_form_of_unit_entry A a b hu
  refine ⟨ψ, ⟨(cokernelEquivMulMul A L K hL hK).trans
    (cokernelEquivBlock (L * A * K) ψ h00 hrow hcol hblock)⟩, fun hA => ?_⟩
  refine mulVecLin_injective_of_block (L * A * K) ψ h00 hrow hcol hblock ?_
  intro v w hvw
  have h0 : (L * A * K) *ᵥ v = (L * A * K) *ᵥ w := hvw
  have h1 : L *ᵥ (A *ᵥ (K *ᵥ v)) = L *ᵥ (A *ᵥ (K *ᵥ w)) := by
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
    exact h0
  exact (mulVecLin_bijective_of_isUnit_det K hK).1
    (hA ((mulVecLin_bijective_of_isUnit_det L hL).1 h1))

/-- A module presented by a square matrix of size `n = m + 1` one of whose entries is a unit is
generated by `m = n - 1` elements. -/
theorem exists_span_eq_top_of_isUnit_entry {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R) (a b : Fin (m + 1)) (hu : IsUnit (A a b)) :
    ∃ s : Fin m → Cokernel A, Submodule.span R (Set.range s) = ⊤ := by
  obtain ⟨ψ, ⟨e⟩, _⟩ := exists_cokernel_equiv_of_isUnit_entry A a b hu
  let f : (Fin m → R) →ₗ[R] Cokernel A := e.symm.toLinearMap ∘ₗ Submodule.mkQ _
  refine ⟨fun i => f (Pi.basisFun R (Fin m) i), ?_⟩
  rw [show (Set.range fun i => f (Pi.basisFun R (Fin m) i)) = f '' Set.range (Pi.basisFun R _) from
    Set.range_comp f _, Submodule.span_image, (Pi.basisFun R (Fin m)).span_eq, Submodule.map_top,
    LinearMap.range_eq_top]
  exact e.symm.surjective.comp (Submodule.mkQ_surjective _)

/-! ### The Zariski cover on which an entry becomes a unit -/

/-- `Fit_{n-1}(𝓕) = R` for `𝓕 = Rⁿ / A Rⁿ` says exactly that the entries of `A` generate the unit
ideal, so that the basic opens `D(A i j)` cover `Spec R`. -/
theorem span_entries_eq_top_of_fittingIdeal_eq_top {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R)
    (hfit : fittingIdeal (R := R) (M := Cokernel A) (m : ℤ) = ⊤) :
    Ideal.span (Set.range fun p : Fin (m + 1) × Fin (m + 1) => A p.1 p.2) = ⊤ := by
  rw [fittingIdeal_cokernel_eq_minorIdeal_one A, Stacks.Curves.minorIdeal_one] at hfit
  refine le_antisymm le_top ?_
  rw [← hfit, Ideal.span_le]
  rintro x ⟨i, j, rfl⟩
  exact Ideal.subset_span ⟨(i, j), rfl⟩

/-- On the basic open `D(g)`, that is over `Localization.Away g`, the element `g` is a unit. -/
theorem isUnit_algebraMap_localizationAway (g : R) :
    IsUnit (algebraMap R (Localization.Away g) g) :=
  IsLocalization.map_units (M := Submonoid.powers g) (Localization.Away g)
    ⟨g, Submonoid.mem_powers g⟩

/-- Let `𝓕` be presented by a square matrix `A` of size `n = m + 1` with `Fit_{n-1}(𝓕) = R`. Then
the entries of `A` generate the unit ideal — so the basic opens `D(A i j)` cover `Spec R` — and
over each of those basic opens the module presented by `A` is the cokernel of a square matrix of
size `m`, and hence is generated by `m = n - 1` elements. -/
@[stacks 0ESU "the Zariski cover on which ℱ' needs only n-1 generators"]
theorem exists_cover_cokernel_equiv_of_fittingIdeal_eq_top {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) R)
    (hfit : fittingIdeal (R := R) (M := Cokernel A) (m : ℤ) = ⊤) :
    Ideal.span (Set.range fun p : Fin (m + 1) × Fin (m + 1) => A p.1 p.2) = ⊤ ∧
      ∀ p : Fin (m + 1) × Fin (m + 1),
        ∃ ψ : Matrix (Fin m) (Fin m) (Localization.Away (A p.1 p.2)),
          Nonempty (Cokernel (A.map (algebraMap R (Localization.Away (A p.1 p.2)))) ≃ₗ[
              Localization.Away (A p.1 p.2)] Cokernel ψ) ∧
            ∃ s : Fin m → Cokernel (A.map (algebraMap R (Localization.Away (A p.1 p.2)))),
              Submodule.span (Localization.Away (A p.1 p.2)) (Set.range s) = ⊤ := by
  refine ⟨span_entries_eq_top_of_fittingIdeal_eq_top A hfit, fun p => ?_⟩
  have hu : IsUnit ((A.map (algebraMap R (Localization.Away (A p.1 p.2)))) p.1 p.2) :=
    isUnit_algebraMap_localizationAway (A p.1 p.2)
  obtain ⟨ψ, he, _⟩ := exists_cokernel_equiv_of_isUnit_entry _ p.1 p.2 hu
  exact ⟨ψ, he, exists_span_eq_top_of_isUnit_entry _ p.1 p.2 hu⟩

end Stacks.ScaledPresentation

end
