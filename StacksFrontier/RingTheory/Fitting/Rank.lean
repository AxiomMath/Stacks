/-!
# Fitting ideals, local number of generators, and local freeness

The Fitting ideals of a finite module measure how many generators it needs locally.

The first result is pointwise: `Fit_k(M) ⊄ p` holds exactly when the fibre of `M` at `p` has
dimension at most `k`, equivalently when `M_p` needs only `k` generators, equivalently when `k`
generators already suffice on a principal neighbourhood of `p`. The second is the global
consequence: `M` is finite locally free of rank `r` precisely when `Fit_{r-1}(M) = 0` and
`Fit_r(M) = R`. The third is local and quantitative: over a local ring, if `Fit_k(M)` is
principal, generated by `f`, then `M` modulo the elements killed by `f` is generated by `k`
elements.

## Main results

* `fittingIdeal_local_generation_tfae`: the four equivalent conditions at a prime.
* `finiteLocallyFreeOfRank_fittingIdeal_tfae`: the Fitting-ideal criterion for being finite
  locally free of a given rank.
* `exists_fin_generating_family_quotient_ker_lsmul_of_fittingIdeal_eq_span_singleton`: over a
  local ring, a principal `k`th Fitting ideal bounds the number of generators of the quotient by
  the `f`-torsion.
* `Stacks.Fitting.exists_fin_span_atPrime_quotient_primaryComponent`: if `Fit_k(M)` is generated
  by `f`, then at every prime the localization of `M` modulo its `f`-primary component is
  generated by `k` elements.

## References

* [Stacks Project, Tag 07ZC](https://stacks.math.columbia.edu/tag/07ZC)
* [Stacks Project, Tag 07ZD](https://stacks.math.columbia.edu/tag/07ZD)
* [Stacks Project, Tag 080Z](https://stacks.math.columbia.edu/tag/080Z)
-/

open scoped TensorProduct
open TensorProduct

universe u v w

@[expose] public section

/-! ### The number of generators at a prime -/

private theorem fin_generating_family_of_le
    {R Q : Type*} [Semiring R] [AddCommMonoid Q] [Module R Q]
    {n k : ℕ} (hk : n ≤ k) (x : Fin n → Q)
    (hx : Submodule.span R (Set.range x) = ⊤) :
    ∃ g : Fin k → Q, Submodule.span R (Set.range g) = ⊤ := by
  let g : Fin k → Q := fun i => if hi : (i : ℕ) < n then x ⟨i, hi⟩ else 0
  refine ⟨g, ?_⟩
  apply eq_top_iff.mpr
  rw [← hx]
  apply Submodule.span_mono
  rintro _ ⟨i, rfl⟩
  refine ⟨Fin.castLE hk i, ?_⟩
  simp [g]

private lemma finrank_le_iff_exists_fin_span {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] (k : ℕ) :
    Module.finrank K V ≤ k ↔
      ∃ g : Fin k → V, Submodule.span K (Set.range g) = ⊤ := by
  classical
  constructor
  · exact fun h ↦ fin_generating_family_of_le h _ (Module.finBasis K V).span_eq
  · rintro ⟨g, hg⟩
    let := (Set.finite_range g).fintype
    rw [← finrank_top, ← hg]
    exact (finrank_span_le_card (Set.range g)).trans
      (by simpa using
        (Finset.card_image_le : (Finset.univ.image g).card ≤ Finset.univ.card))

private lemma fittingIdeal_eq_top_iff_finrank_le {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] (k : ℕ) :
    fittingIdeal (R := K) (M := V) (k : ℤ) = ⊤ ↔
      Module.finrank K V ≤ k := by
  let b := Module.finBasis K V
  rw [fittingIdeal_eq_of_linearEquiv b.equivFun k, fittingIdeal_fin_eq_bot_or_top]
  split_ifs with h
  · simp [show ¬ Module.finrank K V ≤ k by omega]
  · simp [show Module.finrank K V ≤ k by omega]

private lemma map_eq_top_iff_not_le_prime {R K : Type*} [CommRing R] [Field K]
    (p : Ideal R) (f : R →+* K) (hf : RingHom.ker f = p) (I : Ideal R) :
    Ideal.map f I = ⊤ ↔ ¬ I ≤ p := by
  constructor
  · intro hI hp
    have hcomap : Ideal.comap f ⊥ = p := hf
    have : Ideal.map f I ≤ ⊥ := Ideal.map_le_iff_le_comap.mpr (by rwa [hcomap])
    rw [hI] at this
    exact top_ne_bot (le_antisymm this bot_le)
  · intro hp
    rw [eq_top_iff]
    obtain ⟨x, hxI, hxp⟩ := Set.not_subset.mp hp
    have hx : f x ≠ 0 := by simpa [← RingHom.mem_ker, hf] using hxp
    exact ((Ideal.map f I).eq_top_of_isUnit_mem (Ideal.mem_map_of_mem f hxI)
      (isUnit_iff_ne_zero.mpr hx)).ge

private lemma finrank_fiber_le_iff_exists_span_atPrime
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (p : Ideal R) [p.IsPrime] :
    Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k ↔
      ∃ g : Fin k → LocalizedModule.AtPrime p M,
        Submodule.span (Localization.AtPrime p) (Set.range g) = ⊤ := by
  let A := Localization.AtPrime p
  let L := LocalizedModule.AtPrime p M
  let K := p.ResidueField
  let e : (K ⊗[A] L) ≃ₗ[K] (K ⊗[R] M) :=
    (AlgebraTensorModule.congr (LinearEquiv.refl K K)
      (LocalizedModule.equivTensorProduct p.primeCompl M)).trans
        (AlgebraTensorModule.cancelBaseChange R A K K M)
  have hfin : Module.finrank K (K ⊗[A] L) = Module.finrank K (K ⊗[R] M) := e.finrank_eq
  constructor
  · intro h
    obtain ⟨y, hy⟩ := (finrank_le_iff_exists_fin_span k).mp (hfin.trans_le h)
    choose g hg using fun i ↦
      TensorProduct.mk_surjective A L K Ideal.Quotient.mk_surjective (y i)
    refine ⟨g, (IsLocalRing.map_tensorProduct_mk_eq_top (R := A)
      (N := Submodule.span A (Set.range g))).mp ?_⟩
    rw [Submodule.map_span, ← Set.range_comp]
    rw [← Submodule.restrictScalars_span A K Ideal.Quotient.mk_surjective,
      Submodule.restrictScalars_eq_top_iff]
    rwa [show TensorProduct.mk A K L 1 ∘ g = y from funext hg]
  · rintro ⟨g, hg⟩
    rw [← hfin]
    apply (finrank_le_iff_exists_fin_span k).2
    refine ⟨fun i ↦ 1 ⊗ₜ[A] g i, ?_⟩
    change Submodule.span K (Set.range (TensorProduct.mk A K L 1 ∘ g)) = ⊤
    have hm := (IsLocalRing.map_tensorProduct_mk_eq_top (R := A)
      (N := Submodule.span A (Set.range g))).2 hg
    rw [Submodule.map_span, ← Set.range_comp] at hm
    apply (Submodule.restrictScalars_eq_top_iff A K _).mp
    rwa [Submodule.restrictScalars_span A K Ideal.Quotient.mk_surjective]

private lemma exists_away_span_of_atPrime_span
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (p : Ideal R) [p.IsPrime]
    (g : Fin k → LocalizedModule.AtPrime p M)
    (hg : Submodule.span (Localization.AtPrime p) (Set.range g) = ⊤) :
    ∃ f : R, f ∉ p ∧ ∃ g : Fin k → LocalizedModule.Away f M,
      Submodule.span (Localization.Away f) (Set.range g) = ⊤ := by
  choose z hz using fun i ↦
    IsLocalizedModule.surj p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl M) (g i)
  let m : Fin k → M := fun i ↦ (z i).1
  let s : Fin k → p.primeCompl := fun i ↦ (z i).2
  have hms (i : Fin k) : (s i : R) • g i =
      LocalizedModule.mkLinearMap p.primeCompl M (m i) := by
    simpa only [m, s, Submonoid.smul_def] using hz i
  have hm : Submodule.span (Localization.AtPrime p)
      ((LocalizedModule.mkLinearMap p.primeCompl M) '' Set.range m) = ⊤ := by
    apply top_unique
    rw [← hg, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    have hmem : LocalizedModule.mkLinearMap p.primeCompl M (m i) ∈
        Submodule.span (Localization.AtPrime p)
        ((LocalizedModule.mkLinearMap p.primeCompl M) '' Set.range m) :=
      Submodule.subset_span ⟨m i, ⟨i, rfl⟩, rfl⟩
    have heq : g i = Localization.mk 1 (s i) •
        LocalizedModule.mkLinearMap p.primeCompl M (m i) :=
      (LocalizedModule.smul_eq_iff_of_mem (s i : R) (s i).2 _ _).mp (hms i)
    exact heq.symm ▸ Submodule.smul_mem _ _ hmem
  have hlocal : ∀ x : M, ∃ t : p.primeCompl,
      (t : R) • x ∈ Submodule.span R (Set.range m) := by
    rw [← Submodule.span_image_eq_top_iff (Localization.AtPrime p) p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl M)]
    simpa [Set.image_image] using hm
  obtain ⟨f, hf, hspan⟩ :=
    Submodule.exists_mem_and_span_image_eq_top p.primeCompl (Set.range m) hlocal
  refine ⟨f, hf, fun i ↦ LocalizedModule.mkLinearMap (Submonoid.powers f) M (m i), ?_⟩
  have hrange : (LocalizedModule.mkLinearMap (Submonoid.powers f) M) '' Set.range m =
      Set.range (fun i ↦ LocalizedModule.mkLinearMap (Submonoid.powers f) M (m i)) :=
    (Set.range_comp _ _).symm
  rw [← hrange]
  exact hspan (Rf := Localization.Away f) (Mf := LocalizedModule.Away f M)
    (LocalizedModule.mkLinearMap (Submonoid.powers f) M)

private lemma fittingIdeal_localizedModule_eq_map
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (T : Submonoid R) (k : ℤ) :
    fittingIdeal (R := Localization T) (M := LocalizedModule T M) k =
      Ideal.map (algebraMap R (Localization T)) (fittingIdeal (R := R) (M := M) k) := by
  rcases lt_or_ge k 0 with hk | hk
  · rw [fittingIdeal_eq_bot_of_lt_zero hk, fittingIdeal_eq_bot_of_lt_zero hk, Ideal.map_bot]
  · obtain ⟨j, rfl⟩ := Int.eq_ofNat_of_zero_le hk
    rw [fittingIdeal_eq_of_linearEquiv (LocalizedModule.equivTensorProduct T M) j]
    exact (fittingIdeal_basic_properties.{u, v, u, u} (R := R) (M := M)).2.2.1 _ j

private lemma not_le_fittingIdeal_of_away_span
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (p : Ideal R) [p.IsPrime]
    (f : R) (hf : f ∉ p) (g : Fin k → LocalizedModule.Away f M)
    (hg : Submodule.span (Localization.Away f) (Set.range g) = ⊤) :
    ¬ fittingIdeal (R := R) (M := M) (k : ℤ) ≤ p := by
  let S := Localization.Away f
  have hmaptop : Ideal.map (algebraMap R S)
      (fittingIdeal (R := R) (M := M) (k : ℤ)) = ⊤ := by
    rw [← fittingIdeal_localizedModule_eq_map (Submonoid.powers f) (k : ℤ)]
    exact (fittingIdeal_basic_properties.{u, max u v, u, u}
      (R := S) (M := LocalizedModule.Away f M)).1 k ⟨g, hg⟩
  intro hp
  have hd : Disjoint ((Submonoid.powers f : Submonoid R) : Set R)
      (fittingIdeal (R := R) (M := M) (k : ℤ) : Set R) := by
    rw [Set.disjoint_left]
    intro x hxS hxI
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff x f).mp hxS
    exact hf (Ideal.IsPrime.mem_of_pow_mem (I := p) inferInstance n (hp hxI))
  exact (IsLocalization.map_algebraMap_ne_top_iff_disjoint (S := S)
    (Submonoid.powers f) _).2 hd hmaptop

/-- Let `M` be a finite module over a commutative ring `R`, let `k` be a natural
number, and let `p` be a prime ideal of `R`. The following are equivalent: the `k`th Fitting ideal
of `M` is not contained in `p`; the fibre of `M` at `p` has dimension at most `k`; the
localization of `M` at `p` is generated by `k` elements; and this generation property holds on
some principal neighbourhood of `p`. -/
@[stacks 07ZC]
theorem fittingIdeal_local_generation_tfae
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (p : Ideal R) [p.IsPrime] :
    [
      ¬ fittingIdeal (R := R) (M := M) (k : ℤ) ≤ p,
      Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k,
      ∃ g : Fin k → LocalizedModule.AtPrime p M,
        Submodule.span (Localization.AtPrime p) (Set.range g) = ⊤,
      ∃ f : R, f ∉ p ∧ ∃ g : Fin k → LocalizedModule.Away f M,
        Submodule.span (Localization.Away f) (Set.range g) = ⊤
    ].TFAE := by
  have hbase : fittingIdeal (R := p.ResidueField)
      (M := p.ResidueField ⊗[R] M) (k : ℤ) =
      Ideal.map (algebraMap R p.ResidueField)
        (fittingIdeal (R := R) (M := M) (k : ℤ)) :=
    (fittingIdeal_basic_properties.{u, v, u, u}
      (R := R) (M := M)).2.2.1 p.ResidueField k
  tfae_have 1 ↔ 2 := by
    rw [← fittingIdeal_eq_top_iff_finrank_le, hbase,
      map_eq_top_iff_not_le_prime p (algebraMap R p.ResidueField)
        p.ker_algebraMap_residueField]
  tfae_have 2 ↔ 3 := finrank_fiber_le_iff_exists_span_atPrime k p
  tfae_have 3 → 4 := fun ⟨g, hg⟩ ↦ exists_away_span_of_atPrime_span k p g hg
  tfae_have 4 → 1 := fun ⟨f, hf, g, hg⟩ ↦ not_le_fittingIdeal_of_away_span k p f hf g hg
  tfae_finish

/-! ### Finite local freeness of a given rank -/

section IsFiniteLocallyFreeOfRank

private lemma minorIdeal_one_eq_bot_iff
    {R : Type*} [CommRing R] {ι κ : Type*} (A : Matrix ι κ R) :
    minorIdeal A 1 = ⊥ ↔ ∀ i j, A i j = 0 := by
  classical
  constructor
  · intro h i j
    have hm : (A.submatrix (fun _ : Fin 1 => i) (fun _ : Fin 1 => j)).det ∈
        minorIdeal A 1 := Ideal.subset_span ⟨_, _, rfl⟩
    rw [h] at hm
    simpa [Matrix.det_fin_one] using hm
  · intro h
    unfold minorIdeal
    rw [Ideal.span_eq_bot]
    rintro x ⟨f, g, rfl⟩
    simp [h]

/-- A finite module generated by `r` elements whose `(r - 1)`st Fitting ideal is zero is free
with a basis indexed by `Fin r`. -/
lemma basis_of_span_eq_top_of_fittingIdeal_eq_bot
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (r : ℕ) (g : Fin r → M)
    (hg : Submodule.span R (Set.range g) = ⊤)
    (hfit : fittingIdeal (R := R) (M := M) ((r : ℤ) - 1) = ⊥) :
    Nonempty (Module.Basis (Fin r) R M) := by
  classical
  let q : (Fin r → R) →ₗ[R] M := Finsupp.linearCombination R g ∘ₗ
    (Finsupp.linearEquivFunOnFinite R R (Fin r)).symm.toLinearMap
  have hq : Function.Surjective q := by
    rw [← LinearMap.range_eq_top, show q = _ from rfl, LinearMap.range_comp, LinearEquiv.range,
      Submodule.map_top]
    simpa [Finsupp.range_linearCombination] using hg
  by_cases hr : r = 0
  · subst r
    have hi : Function.Injective q := fun x y _ => Subsingleton.elim x y
    exact ⟨Module.Basis.ofEquivFun (LinearEquiv.ofBijective q ⟨hi, hq⟩).symm⟩
  · have hrpos : 0 < r := Nat.pos_of_ne_zero hr
    let A : Matrix (Fin r) (LinearMap.ker q) R := fun i j => j.1 i
    have hspan : Submodule.span R (Set.range fun j : LinearMap.ker q =>
        fun i => A i j) = LinearMap.ker q := by
      refine le_antisymm (Submodule.span_le.2 ?_) fun x hx ↦ Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
      rintro _ ⟨j, rfl⟩
      exact j.2
    let e : ((Fin r → R) ⧸ Submodule.span R (Set.range fun j : LinearMap.ker q =>
        fun i => A i j)) ≃ₗ[R] M :=
      (Submodule.Quotient.equiv _ _ (LinearEquiv.refl R _) (by simpa using hspan)).trans
        (LinearMap.quotKerEquivOfSurjective q hq)
    have hminor : minorIdeal A 1 = ⊥ := by
      have h := fittingIdeal_eq_minorIdeal_of_presentation A (r - 1) e
      have hindex : ((r - 1 : ℕ) : ℤ) = (r : ℤ) - 1 := by omega
      have hsize : r - (r - 1) = 1 := by omega
      calc
        minorIdeal A 1 = minorIdeal A (r - (r - 1)) := by rw [hsize]
        _ = fittingIdeal (R := R) (M := M) ((r - 1 : ℕ) : ℤ) := h.symm
        _ = ⊥ := by rw [hindex, hfit]
    have hker : LinearMap.ker q = ⊥ := by
      rw [← hspan, Submodule.span_eq_bot]
      rintro x ⟨j, rfl⟩
      funext i
      exact (minorIdeal_one_eq_bot_iff A).mp hminor i j
    have hi : Function.Injective q := LinearMap.ker_eq_bot.mp hker
    exact ⟨Module.Basis.ofEquivFun (LinearEquiv.ofBijective q ⟨hi, hq⟩).symm⟩

private lemma fittingIdeals_all_iff_adjacent
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (r : ℕ) :
    (fittingIdeal (R := R) (M := M) ((r : ℤ) - 1) = ⊥ ∧
      fittingIdeal (R := R) (M := M) (r : ℤ) = ⊤) ↔
    ((∀ k : ℤ, k < r → fittingIdeal (R := R) (M := M) k = ⊥) ∧
      ∀ k : ℤ, (r : ℤ) ≤ k → fittingIdeal (R := R) (M := M) k = ⊤) := by
  constructor
  · rintro ⟨hlo, hhi⟩
    refine ⟨fun k hk ↦ ?_, fun k hk ↦ ?_⟩
    · rw [eq_bot_iff, ← hlo]
      exact Stacks.Fitting.fittingIdeal_monotone (by omega)
    · rw [eq_top_iff, ← hhi]
      exact Stacks.Fitting.fittingIdeal_monotone hk
  · rintro ⟨hlo, hhi⟩
    exact ⟨hlo _ (by omega), hhi _ le_rfl⟩

private lemma localized'_ideal_eq_map
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (p : Submonoid R) [IsLocalization p S] (I : Ideal R) :
    I.localized' S p (Algebra.linearMap R S) = Ideal.map (algebraMap R S) I := by
  rw [Ideal.map, Ideal.span, Submodule.localized'_eq_span, Algebra.coe_linearMap]

private lemma map_fittingIdeal_eq_bot_or_top_of_basis
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    [Module.Finite R M] (r : ℕ) (k : ℤ) (f : R)
    (b : Module.Basis (Fin r) (Localization.Away f) (LocalizedModule.Away f M)) :
    Ideal.map (algebraMap R (Localization.Away f)) (fittingIdeal (R := R) (M := M) k) =
      if k < r then ⊥ else ⊤ := by
  rw [← fittingIdeal_localizedModule_eq_map (Submonoid.powers f) k,
    fittingIdeal_eq_of_linearEquiv_int b.equivFun k, fittingIdeal_fin_eq_bot_or_top]

/-- A finite module is finite locally free of rank `r` if and only if its
`(r - 1)`st Fitting ideal is zero and its `r`th Fitting ideal is the unit ideal; equivalently, all
Fitting ideals below `r` are zero and all those from `r` onward are the unit ideal. -/
@[stacks 07ZD, sga "7 VI 5.1" "5.1(b), special case"]
theorem finiteLocallyFreeOfRank_fittingIdeal_tfae
    {R : Type u} {M : Type v} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (r : ℕ) :
    [
      Module.IsFiniteLocallyFreeOfRank R M r,
      fittingIdeal (R := R) (M := M) ((r : ℤ) - 1) = ⊥ ∧
        fittingIdeal (R := R) (M := M) (r : ℤ) = ⊤,
      (∀ k : ℤ, k < r → fittingIdeal (R := R) (M := M) k = ⊥) ∧
        (∀ k : ℤ, (r : ℤ) ≤ k → fittingIdeal (R := R) (M := M) k = ⊤)
    ].TFAE := by
  tfae_have 2 ↔ 3 := fittingIdeals_all_iff_adjacent r
  tfae_have 1 → 2 := by
    rintro ⟨ι, f, hf, hfree⟩
    constructor
    · apply Submodule.eq_bot_of_isLocalized'_span (s := Set.range f) hf
        (Rₚ := fun x => Localization.Away x.1)
        (Mₚ := fun x => Localization.Away x.1)
        (f := fun x => Algebra.linearMap R (Localization.Away x.1))
      rintro ⟨_, i, rfl⟩
      rw [localized'_ideal_eq_map]
      rw [map_fittingIdeal_eq_bot_or_top_of_basis r _ (f i) (hfree i).some, ite_eq_left (by omega)]
    · apply Submodule.eq_top_of_isLocalized'_span (s := Set.range f) hf
        (Rₚ := fun x => Localization.Away x.1)
        (Mₚ := fun x => Localization.Away x.1)
        (f := fun x => Algebra.linearMap R (Localization.Away x.1))
      rintro ⟨_, i, rfl⟩
      rw [localized'_ideal_eq_map]
      rw [map_fittingIdeal_eq_bot_or_top_of_basis r _ (f i) (hfree i).some, ite_eq_right (by omega)]
  tfae_have 2 → 1 := by
    rintro ⟨hprev, hr⟩
    classical
    have hlocal (p : PrimeSpectrum R) :
        ∃ f : R, f ∉ p.asIdeal ∧ ∃ g : Fin r → LocalizedModule.Away f M,
          Submodule.span (Localization.Away f) (Set.range g) = ⊤ := by
      have hnot : ¬ fittingIdeal (R := R) (M := M) (r : ℤ) ≤ p.asIdeal := by
        rw [hr]
        exact fun h ↦ p.2.ne_top (top_unique h)
      exact ((fittingIdeal_local_generation_tfae (M := M) r p.asIdeal).out 1 4).mp hnot
    choose f hf g hg using hlocal
    refine ⟨PrimeSpectrum R, f, ?_, fun p => ?_⟩
    · apply top_unique
      by_contra hne
      have hproper : Ideal.span (Set.range f) ≠ ⊤ := fun he ↦ hne (by rw [he])
      obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hproper
      let p : PrimeSpectrum R := ⟨m, hm.isPrime⟩
      exact hf p (hle (Ideal.subset_span ⟨p, rfl⟩))
    · apply basis_of_span_eq_top_of_fittingIdeal_eq_bot r (g p) (hg p)
      rw [fittingIdeal_localizedModule_eq_map, hprev, Ideal.map_bot]
  tfae_finish

end IsFiniteLocallyFreeOfRank

/-! ### A principal Fitting ideal over a local ring -/

private theorem exists_mem_eq_unit_mul {R : Type*} [CommRing R] [IsLocalRing R]
    (S : Set R) (f : R) (hf : f ≠ 0)
    (hsub : S ⊆ Ideal.span {f}) (hspan : Ideal.span S = Ideal.span {f}) :
    ∃ e ∈ S, ∃ u : R, IsUnit u ∧ e = u * f := by
  classical
  have hfmem : f ∈ Ideal.span S := hspan.symm ▸ Ideal.mem_span_singleton_self f
  obtain ⟨c, hc⟩ := (Finsupp.mem_span_iff_linearCombination R S f).mp hfmem
  let a : S → R := fun e => Classical.choose (Ideal.mem_span_singleton'.mp (hsub e.property))
  have ha (e : S) : a e * f = e :=
    Classical.choose_spec (Ideal.mem_span_singleton'.mp (hsub e.property))
  have hsum : (∑ e ∈ c.support, c e * a e) * f = f := by
    rw [Finset.sum_mul]
    rw [Finsupp.linearCombination_apply] at hc
    simpa only [Finsupp.sum, smul_eq_mul, mul_assoc, ha] using hc
  have hu : IsUnit (∑ e ∈ c.support, c e * a e) := by
    by_contra hn
    have hu1 : IsUnit (1 - ∑ e ∈ c.support, c e * a e) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hn
    have hzero : (1 - ∑ e ∈ c.support, c e * a e) * f = 0 := by
      rw [sub_mul, one_mul, hsum, sub_self]
    exact hf (hu1.mul_right_eq_zero.mp hzero)
  obtain ⟨e, he, heunit⟩ := IsLocalRing.exists_of_isUnit_sum hu
  exact ⟨e, e.property, a e, isUnit_of_mul_isUnit_right heunit, (ha e).symm⟩

private theorem fin_generating_family_of_selected_span
    {R Q : Type*} [Semiring R] [AddCommMonoid Q] [Module R Q]
    {n k : ℕ} (hk : k ≤ n) (x : Fin n → Q)
    (hx : Submodule.span R (Set.range x) = ⊤)
    (r : Fin (n - k) → Fin n) (hr : Function.Injective r)
    (hsel : ∀ j : Fin (n - k), x (r j) ∈
      Submodule.span R (x '' ((Finset.image r Finset.univ)ᶜ : Finset (Fin n)))) :
    ∃ g : Fin k → Q, Submodule.span R (Set.range g) = ⊤ := by
  classical
  let T : Finset (Fin n) := (Finset.image r Finset.univ)ᶜ
  have hcard : T.card = k := by
    have himage : (Finset.image r Finset.univ).card = n - k :=
      by simpa using (Finset.card_image_iff.mpr (fun _ _ _ _ h => hr h) :
        (Finset.image r Finset.univ).card = (Finset.univ : Finset (Fin (n - k))).card)
    simp only [T, Finset.card_compl, Fintype.card_fin, himage]
    omega
  let e := T.orderIsoOfFin hcard
  let g : Fin k → Q := fun j => x (e j).val
  refine ⟨g, ?_⟩
  have hrange : Set.range g = x '' (T : Set (Fin n)) := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨(e j).val, (e j).property, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      refine ⟨e.symm ⟨i, hi⟩, ?_⟩
      simp only [g, e, OrderIso.apply_symm_apply]
  rw [hrange, eq_top_iff, ← hx, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  by_cases hi : i ∈ T
  · exact Submodule.subset_span ⟨i, hi, rfl⟩
  · have hi' : i ∈ Finset.image r Finset.univ := by simpa [T] using hi
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hi'
    exact hsel j

private theorem matrix_mul_adjugate_eq_det_updateRow
    {R : Type*} [CommRing R] {n m : ℕ}
    (A : Matrix (Fin n) (Fin m) R) (B : Matrix (Fin m) (Fin m) R)
    (i : Fin n) (j : Fin m) :
    (A * B.adjugate) i j = (B.updateRow j (fun l => A i l)).det := by
  rw [det_updateRow_linear, Matrix.mul_apply]
  exact Finset.sum_congr rfl fun l _ ↦ by rw [Matrix.adjugate_apply]

private theorem matrix_relation_adjugate
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {n m : ℕ} (A : Matrix (Fin n) (Fin m) R)
    (y : Fin n → M) (hrel : ∀ l : Fin m, ∑ i, A i l • y i = 0)
    (B : Matrix (Fin m) (Fin m) R) (j : Fin m) :
    ∑ i, (A * B.adjugate) i j • y i = 0 := by
  simp only [Matrix.mul_apply, Finset.sum_smul]
  rw [Finset.sum_comm]
  calc
    (∑ l, ∑ i, (A i l * B.adjugate l j) • y i) =
        ∑ l, B.adjugate l j • (∑ i, A i l • y i) := by
      apply Finset.sum_congr rfl
      intro l _
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [mul_smul, smul_comm]
    _ = 0 := by simp [hrel]

private theorem matrix_mul_adjugate_eq_submatrix_det
    {R : Type*} [CommRing R] {n m : ℕ} {J : Type*}
    (A : Matrix (Fin n) J R) (r : Fin m → Fin n) (c : Fin m → J)
    (i : Fin n) (j : Fin m) :
    ((A.submatrix id c) * (A.submatrix r c).adjugate) i j =
      (A.submatrix (Function.update r j i) c).det := by
  rw [matrix_mul_adjugate_eq_det_updateRow]
  congr 1
  ext a b
  by_cases h : a = j
  · subst a
    simp [Matrix.submatrix_apply, Matrix.updateRow, Function.update]
  · simp [Matrix.submatrix_apply, Matrix.updateRow, Function.update, h]

private theorem quotient_mk_eq_zero_of_smul_eq_zero
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (f : R) (y : M) (hy : f • y = 0) :
    (Submodule.Quotient.mk y : M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) = 0 := by
  rw [Submodule.Quotient.mk_eq_zero]
  change (LinearMap.lsmul R M f) y = 0
  simpa using hy

private theorem quotient_smul_eq_of_mul_eq
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (f a b : R) (hab : a * f = b * f) (y : M) :
    a • (Submodule.Quotient.mk y : M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) =
      b • (Submodule.Quotient.mk y : M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) := by
  apply sub_eq_zero.mp
  rw [← sub_smul, ← Submodule.Quotient.mk_smul]
  apply quotient_mk_eq_zero_of_smul_eq_zero
  rw [smul_comm f, ← mul_smul, sub_mul, hab, sub_self, zero_smul]

private theorem selected_rows_mem_span
    {R M J : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {n m : ℕ} (A : Matrix (Fin n) J R) (y : Fin n → M)
    (hrel : ∀ c : J, ∑ i, A i c • y i = 0)
    (r : Fin m → Fin n) (hr : Function.Injective r) (c : Fin m → J)
    (f u : R) (hu : IsUnit u)
    (hdet : (A.submatrix r c).det = u * f)
    (hminor : ∀ s : Fin m → Fin n, (A.submatrix s c).det ∈ Ideal.span {f})
    (j : Fin m) :
    (Submodule.Quotient.mk (y (r j)) : M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) ∈
      Submodule.span R ((fun i => (Submodule.Quotient.mk (y i) :
        M ⧸ LinearMap.ker (LinearMap.lsmul R M f))) ''
        ((Finset.image r Finset.univ)ᶜ : Finset (Fin n))) := by
  classical
  let B : Matrix (Fin m) (Fin m) R := A.submatrix r c
  let D : Matrix (Fin n) (Fin m) R := A.submatrix id c
  let C : Fin n → R := fun i => (D * B.adjugate) i j
  have hmem (i : Fin n) : C i ∈ Ideal.span {f} := by
    rw [show C i = _ from matrix_mul_adjugate_eq_submatrix_det A r c i j]
    exact hminor _
  let d : Fin n → R := fun i => Classical.choose (Ideal.mem_span_singleton'.mp (hmem i))
  have hd (i : Fin n) : d i * f = C i :=
    Classical.choose_spec (Ideal.mem_span_singleton'.mp (hmem i))
  let z : Fin n → M ⧸ LinearMap.ker (LinearMap.lsmul R M f) :=
    fun i => Submodule.Quotient.mk (y i)
  have hC : ∑ i, C i • y i = 0 := by
    apply matrix_relation_adjugate D y _ B j
    intro l
    simpa [D, Matrix.submatrix_apply] using hrel (c l)
  have hfy : f • (∑ i, d i • y i) = 0 := by
    calc
      f • (∑ i, d i • y i) = ∑ i, (d i * f) • y i := by
        rw [Finset.smul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [mul_smul, smul_comm]
      _ = ∑ i, C i • y i := by simp_rw [hd]
      _ = 0 := hC
  have hqsum : ∑ i, d i • z i = 0 := by
    calc
      ∑ i, d i • z i = (Submodule.Quotient.mk (∑ i, d i • y i) :
        M ⧸ LinearMap.ker (LinearMap.lsmul R M f)) := by
          let q := Submodule.mkQ (LinearMap.ker (LinearMap.lsmul R M f))
          change (∑ i, d i • q (y i)) = q (∑ i, d i • y i)
          rw [map_sum]
          simp only [map_smul]
      _ = 0 := quotient_mk_eq_zero_of_smul_eq_zero f _ hfy
  have htop (t : Fin m) : C (r t) = (if t = j then u else 0) * f := by
    have hrow : C (r t) = (B * B.adjugate) t j := by
      simp [C, D, B, Matrix.mul_apply, Matrix.submatrix_apply]
    rw [hrow, Matrix.mul_adjugate, Matrix.smul_apply, hdet]
    by_cases ht : t = j <;> simp [ht, Matrix.one_apply, mul_comm]
  have hscalar (t : Fin m) :
      d (r t) • z (r t) = (if t = j then u else 0) • z (r t) :=
    quotient_smul_eq_of_mul_eq f _ _ ((hd (r t)).trans (htop t)) (y (r t))
  have hselSum : ∑ i ∈ Finset.image r Finset.univ, d i • z i = u • z (r j) := by
    rw [Finset.sum_image (fun _ _ _ _ h => hr h)]
    simp_rw [hscalar]
    simp
  let T : Finset (Fin n) := (Finset.image r Finset.univ)ᶜ
  have hsplit : u • z (r j) + ∑ i ∈ T, d i • z i = 0 := by
    have hh := Finset.sum_add_sum_compl (Finset.image r Finset.univ)
      (fun i => d i • z i)
    rwa [hselSum, ← show T = (Finset.image r Finset.univ)ᶜ from rfl, hqsum] at hh
  have hout : ∑ i ∈ T, d i • z i ∈ Submodule.span R (z '' (T : Set (Fin n))) :=
    Submodule.sum_mem _ fun i hi ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, hi, rfl⟩)
  have hunit : u • z (r j) ∈ Submodule.span R (z '' (T : Set (Fin n))) := by
    rw [eq_neg_of_add_eq_zero_left hsplit]
    exact Submodule.neg_mem _ hout
  exact (Submodule.smul_mem_iff_of_isUnit _ hu).mp hunit

private theorem span_range_map_basis_eq_top
    {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    {n : ℕ} (p : (Fin n → R) →ₗ[R] M) (hp : Function.Surjective p) :
    Submodule.span R (Set.range (fun i : Fin n => p (Pi.single i 1))) = ⊤ := by
  have hb : Submodule.span R (Set.range (fun i : Fin n => Pi.single i (1 : R))) = ⊤ := by
    have hfun : (fun i : Fin n => Pi.basisFun R (Fin n) i) =
        (fun i : Fin n => Pi.single i (1 : R)) := by
      funext i
      exact Pi.basisFun_apply R (Fin n) i
    simpa only [hfun] using (Pi.basisFun R (Fin n)).span_eq
  have hs : Set.range (fun i : Fin n => p (Pi.single i 1)) =
      p '' Set.range (fun i : Fin n => Pi.single i (1 : R)) := by
    ext y
    simp only [Set.mem_range, Set.mem_image]
    aesop
  rw [hs, Submodule.span_image, hb, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr hp

private theorem relation_sum_of_mem_ker
    {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    {n : ℕ} (p : (Fin n → R) →ₗ[R] M) (j : LinearMap.ker p) :
    ∑ i : Fin n, (j : Fin n → R) i • p (Pi.single i 1) = 0 := by
  have hdecomp : (j : Fin n → R) =
      ∑ i : Fin n, (j : Fin n → R) i • Pi.single i 1 := by
    ext t
    simp [Finset.sum_apply, Pi.single_apply]
  have hj : p (j : Fin n → R) = 0 := j.property
  rw [hdecomp, map_sum] at hj
  simpa only [map_smul] using hj

/-- If the `k`th Fitting ideal of a finite module over a local ring is generated
by `f`, then the quotient by the submodule of elements annihilated by `f` is generated by `k`
elements. -/
@[stacks 080Z]
theorem exists_fin_generating_family_quotient_ker_lsmul_of_fittingIdeal_eq_span_singleton
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (f : R)
    (h : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f}) :
    ∃ g : Fin k → M ⧸ LinearMap.ker (LinearMap.lsmul R M f),
      Submodule.span R (Set.range g) = ⊤ := by
  classical
  let hfin := Module.Finite.exists_fin' R M
  let n := hfin.choose
  let p : (Fin n → R) →ₗ[R] M := hfin.choose_spec.choose
  have hp : Function.Surjective p := hfin.choose_spec.choose_spec
  let A : Matrix (Fin n) (LinearMap.ker p) R := fun i j => (j : Fin n → R) i
  have hI : minorIdeal A (n - k) = Ideal.span {f} := by
    simp only [fittingIdeal] at h
    exact h
  let K : Submodule R M := LinearMap.ker (LinearMap.lsmul R M f)
  let q : M →ₗ[R] M ⧸ K := Submodule.mkQ K
  let y : Fin n → M := fun i => p (Pi.single i 1)
  let z : Fin n → M ⧸ K := fun i => q (y i)
  have hpq : Function.Surjective (q.comp p) := (Submodule.mkQ_surjective K).comp hp
  have hzgen : Submodule.span R (Set.range z) = ⊤ :=
    span_range_map_basis_eq_top (q.comp p) hpq
  by_cases hf : f = 0
  · have hzero (w : M ⧸ K) : w = 0 := by
      obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective K w
      exact quotient_mk_eq_zero_of_smul_eq_zero f v (by simp [hf])
    refine ⟨fun _ => 0, ?_⟩
    apply eq_top_iff.mpr
    intro w _
    rw [hzero w]
    exact Submodule.zero_mem _
  by_cases hnk : n ≤ k
  · exact fin_generating_family_of_le hnk z hzgen
  have hkn : k ≤ n := by omega
  let S : Set R := {e | ∃ (r : Fin (n - k) → Fin n) (c : Fin (n - k) → LinearMap.ker p),
    e = (A.submatrix r c).det}
  have hspan : Ideal.span S = Ideal.span {f} := by
    simpa only [minorIdeal, S] using hI
  have hsub : S ⊆ Ideal.span {f} := by
    rw [← hspan]
    exact Ideal.subset_span
  obtain ⟨e, heS, u, hu, heq⟩ := exists_mem_eq_unit_mul S f hf hsub hspan
  obtain ⟨r, c, he⟩ := heS
  have hdet : (A.submatrix r c).det = u * f := he.symm.trans heq
  have hne : (A.submatrix r c).det ≠ 0 := by
    rw [hdet]
    exact fun huf => hf (hu.mul_right_eq_zero.mp huf)
  have hr : Function.Injective r := fun i j hij ↦ by_contra fun hneij ↦
    hne (Matrix.det_zero_of_row_eq hneij (funext fun l ↦ by simp [Matrix.submatrix_apply, hij]))
  have hminor (s : Fin (n - k) → Fin n) :
      (A.submatrix s c).det ∈ Ideal.span {f} := by
    rw [← hspan]
    exact Ideal.subset_span ⟨s, c, rfl⟩
  have hrel (j : LinearMap.ker p) : ∑ i, A i j • y i = 0 := by
    simpa only [A, y] using relation_sum_of_mem_ker p j
  have hsel (j : Fin (n - k)) : z (r j) ∈
      Submodule.span R (z '' ((Finset.image r Finset.univ)ᶜ : Finset (Fin n))) :=
    selected_rows_mem_span A y hrel r hr c f u hu hdet hminor j
  exact fin_generating_family_of_selected_span hkn z hzgen r hr hsel

/-! ### Generators of a quotient by a primary component -/

namespace Stacks.Fitting

/-- A generating family stays a generating family after a surjection. -/
lemma span_range_comp_eq_top
    {R M N : Type*} [Semiring R] [AddCommMonoid M] [AddCommMonoid N]
    [Module R M] [Module R N] {ι : Type*} (g : ι → M)
    (hg : Submodule.span R (Set.range g) = ⊤)
    (q : M →ₗ[R] N) (hq : Function.Surjective q) :
    Submodule.span R (Set.range (q ∘ g)) = ⊤ := by
  rw [Set.range_comp, ← Submodule.map_span, hg, Submodule.map_top,
    LinearMap.range_eq_top.mpr hq]

/-- The image of a regular element under a flat algebra map is regular. -/
lemma isRegular_algebraMap_of_flat {R S : Type*}
    [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    {f : R} (hf : IsRegular f) : IsRegular (algebraMap R S f) := by
  apply (Commute.isRegular_iff (fun b => Commute.all _ b)).2
  simpa only [IsLeftRegular, IsSMulRegular, Algebra.smul_def] using
    (Module.Flat.isSMulRegular_of_isRegular (M := S) hf)

/-- Elements of the localization of `M` at a prime killed by `f` come from the `f`-primary
component of `M`. -/
lemma ker_lsmul_le_localized_primaryComponent {R M : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] (p : Ideal R) [p.IsPrime] (f : R) :
    LinearMap.ker (LinearMap.lsmul (Localization.AtPrime p)
      (LocalizedModule.AtPrime p M) (algebraMap R (Localization.AtPrime p) f)) ≤
      (Ideal.primaryComponent M (Ideal.span {f})).localized p.primeCompl := by
  intro x hx
  obtain ⟨⟨m, s⟩, rfl⟩ :=
    IsLocalizedModule.mk'_surjective p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl M) x
  rw [LinearMap.mem_ker] at hx
  change algebraMap R (Localization.AtPrime p) f •
      IsLocalizedModule.mk' (LocalizedModule.mkLinearMap p.primeCompl M) m s = 0 at hx
  have hx' : f • IsLocalizedModule.mk'
      (LocalizedModule.mkLinearMap p.primeCompl M) m s = 0 := by
    rwa [← IsScalarTower.algebraMap_smul (Localization.AtPrime p)]
  rw [← IsLocalizedModule.mk'_smul (S := p.primeCompl), IsLocalizedModule.mk'_eq_zero,
    IsLocalizedModule.eq_zero_iff p.primeCompl (LocalizedModule.mkLinearMap p.primeCompl M)] at hx'
  obtain ⟨t, ht⟩ := hx'
  rw [Submonoid.smul_def, smul_smul] at ht
  rw [Submodule.mem_localized']
  refine ⟨(t : R) • m, ?_, t * s, ?_⟩
  · rw [Ideal.primaryComponent_mem]
    refine ⟨1, ?_⟩
    rw [Submodule.mem_torsionBySet_iff]
    intro r
    have hr : (r : R) ∈ (Ideal.span {f} : Set R) := by
      simpa only [pow_one] using r.property
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hr
    calc
      (r : R) • (t : R) • m = (f * c) • (t : R) • m := by rw [hc]
      _ = c • (((t : R) * f) • m) := by simp only [smul_smul]; congr 1; ring
      _ = 0 := by rw [ht, smul_zero]
  · change IsLocalizedModule.mk' (LocalizedModule.mkLinearMap p.primeCompl M)
      ((t : R) • m) (t * s) =
        IsLocalizedModule.mk' (LocalizedModule.mkLinearMap p.primeCompl M) m s
    exact IsLocalizedModule.mk'_cancel_left
      (LocalizedModule.mkLinearMap p.primeCompl M) m t s

/-- If the `k`-th Fitting ideal of a finite module `M` is generated
by `f`, then at every prime the localization of `M` modulo its `f`-primary component is generated
by `k` elements. -/
theorem exists_fin_span_atPrime_quotient_primaryComponent {R : Type u} {M : Type v}
    [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    (k : ℕ) (f : R)
    (hfit : fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f})
    (p : Ideal R) [p.IsPrime] :
    ∃ g : Fin k → LocalizedModule.AtPrime p
        (M ⧸ Ideal.primaryComponent M (Ideal.span {f})),
      Submodule.span (Localization.AtPrime p) (Set.range g) = ⊤ := by
  let A := Localization.AtPrime p
  let L := LocalizedModule.AtPrime p M
  let T := Ideal.primaryComponent M (Ideal.span {f})
  let K := LinearMap.ker (LinearMap.lsmul A L (algebraMap R A f))
  let TL := T.localized p.primeCompl
  have hfitL : fittingIdeal (R := A) (M := L) (k : ℤ) =
      Ideal.span {algebraMap R A f} := by
    rw [fittingIdeal_localizedModule_eq_map p.primeCompl, hfit, Ideal.map_span, Set.image_singleton]
  obtain ⟨g, hg⟩ :=
    exists_fin_generating_family_quotient_ker_lsmul_of_fittingIdeal_eq_span_singleton
      k (algebraMap R A f) hfitL
  have hKT : K ≤ TL := ker_lsmul_le_localized_primaryComponent p f
  let φ : L ⧸ K →ₗ[A] L ⧸ TL := Submodule.mapQ K TL LinearMap.id hKT
  have hφ : Function.Surjective φ := by
    intro y
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective TL y
    exact ⟨Submodule.Quotient.mk x, rfl⟩
  let eqv : (L ⧸ TL) ≃ₗ[A]
      LocalizedModule.AtPrime p (M ⧸ T) := _root_.localizedQuotientEquiv p.primeCompl T
  exact ⟨eqv ∘ φ ∘ g,
    span_range_comp_eq_top (φ ∘ g) (span_range_comp_eq_top g hg φ hφ)
      eqv.toLinearMap eqv.surjective⟩

end Stacks.Fitting
