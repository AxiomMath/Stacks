module

public import StacksFrontier.RingTheory.Fitting.SquareMatrixDeterminant
public import StacksFrontier.AlgebraicGeometry.Picard.FamilyFittingIdeal
public import Mathlib.RingTheory.Spectrum.Prime.FreeLocus
public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.Localization.Ideal

/-!
# The Fitting ideal of a cokernel of projective modules of the same rank is locally principal

Let `δ : K₀ ⟶ K₁` be a map of finite projective `A`-modules of the same rank at every prime. At
a prime `p` both localizations are free of the same rank, so `δ_p` is a square matrix and
`Fit₀(coker δ)_p = (det δ_p)`. Since `Fit₀(coker δ)` is finitely generated, a generator at `p`
spreads out to a basic open neighbourhood: there are `r ∉ p` and `a ∈ Fit₀(coker δ)` with
`Fit₀(coker δ) · A_r = (a)`.

## Main results

* `Stacks.Fitting.exists_map_fittingIdeal_atPrime_eq_span`: the local statement.
* `Stacks.Fitting.exists_map_eq_span_of_atPrime`: spreading out a principal generator.
* `Stacks.Fitting.exists_map_fittingIdeal_coker_eq_span`: the combination.
-/


@[expose] public noncomputable section

open TensorProduct

universe u

namespace Stacks.Fitting

variable {A : Type u} [CommRing A]

/-- **Spreading out a principal generator.** If a finitely generated ideal `I` becomes `(a)` at a
prime `p`, with `a ∈ I`, it is already `(a)` on a basic open neighbourhood of `p`. -/
theorem exists_map_eq_span_of_atPrime (I : Ideal A) (hI : I.FG) (p : PrimeSpectrum A) (a : A)
    (ha : a ∈ I)
    (hp : Ideal.map (algebraMap A (Localization.AtPrime p.asIdeal)) I =
      Ideal.span {algebraMap A (Localization.AtPrime p.asIdeal) a}) :
    ∃ r ∉ p.asIdeal, ∀ (B : Type u) [CommRing B] [Algebra A B] [IsLocalization.Away r B],
      Ideal.map (algebraMap A B) I = Ideal.span {algebraMap A B a} := by
  classical
  obtain ⟨G, hG⟩ := hI
  have hgen : ∀ g ∈ G, ∃ u ∉ p.asIdeal, ∃ c : A, u * g = c * a := by
    intro g hg
    have hgI : algebraMap A (Localization.AtPrime p.asIdeal) g ∈
        Ideal.span {algebraMap A (Localization.AtPrime p.asIdeal) a} := by
      rw [← hp]
      exact Ideal.mem_map_of_mem _ (hG ▸ Ideal.subset_span hg)
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hgI
    obtain ⟨⟨c', s⟩, rfl⟩ := IsLocalization.mk'_surjective p.asIdeal.primeCompl c
    have h1 : algebraMap A (Localization.AtPrime p.asIdeal) (g * s) =
        algebraMap A (Localization.AtPrime p.asIdeal) (c' * a) := by
      rw [map_mul, map_mul, ← hc, mul_right_comm, IsLocalization.mk'_spec]
    obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists p.asIdeal.primeCompl
      (Localization.AtPrime p.asIdeal)).1 h1
    refine ⟨t * s, p.asIdeal.primeCompl.mul_mem t.2 s.2, t * c', ?_⟩
    linear_combination ht
  choose u hu c hc using hgen
  let r : A := ∏ g ∈ G.attach, u g.1 g.2
  have hr : r ∉ p.asIdeal := p.asIdeal.primeCompl.prod_mem fun g _ => hu g.1 g.2
  refine ⟨r, hr, fun B _ _ _ => le_antisymm ?_ ?_⟩
  · rw [← hG, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe]
    have hunit : IsUnit (algebraMap A B (u g hg)) := by
      have hr' : IsUnit (algebraMap A B r) := IsLocalization.Away.algebraMap_isUnit r
      have hdvd : u g hg ∣ r := Finset.dvd_prod_of_mem _ (Finset.mem_attach G ⟨g, hg⟩)
      obtain ⟨w, hw⟩ := hdvd
      rw [hw, map_mul] at hr'
      exact isUnit_of_mul_isUnit_left hr'
    obtain ⟨v, hv⟩ := hunit
    have h := congrArg (algebraMap A B) (hc g hg)
    rw [map_mul, map_mul, ← hv] at h
    rw [Ideal.mem_span_singleton']
    refine ⟨↑v⁻¹ * algebraMap A B (c g hg), ?_⟩
    calc ↑v⁻¹ * algebraMap A B (c g hg) * algebraMap A B a =
        ↑v⁻¹ * (algebraMap A B (c g hg) * algebraMap A B a) := by ring
      _ = ↑v⁻¹ * (↑v * algebraMap A B g) := by rw [h]
      _ = algebraMap A B g := by rw [← mul_assoc, Units.inv_mul, one_mul]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ ha

variable {K₀ K₁ : Type u} [AddCommGroup K₀] [AddCommGroup K₁] [Module A K₀] [Module A K₁]
  [Module.Finite A K₀] [Module.Projective A K₀] [Module.Finite A K₁] [Module.Projective A K₁]

/-- `coker δ` is finite. -/
instance (δ : K₀ →ₗ[A] K₁) : Module.Finite A (Stacks.FamilyFitting.coker δ) :=
  Module.Finite.quotient A _

/-- **At a prime the Fitting ideal of `coker δ` is principal**, generated by an element of the
ideal, when `K₀` and `K₁` have the same rank there. -/
theorem exists_map_fittingIdeal_atPrime_eq_span (δ : K₀ →ₗ[A] K₁) (p : PrimeSpectrum A)
    (hrank : Module.rankAtStalk K₀ p = Module.rankAtStalk K₁ p) :
    ∃ a ∈ fittingIdeal (R := A) (M := Stacks.FamilyFitting.coker δ) ((0 : ℕ) : ℤ),
      Ideal.map (algebraMap A (Localization.AtPrime p.asIdeal))
          (fittingIdeal (R := A) (M := Stacks.FamilyFitting.coker δ) ((0 : ℕ) : ℤ)) =
        Ideal.span {algebraMap A (Localization.AtPrime p.asIdeal) a} := by
  classical
  set R := Localization.AtPrime p.asIdeal
  have : Module.Free R (R ⊗[A] K₀) := Module.free_of_flat_of_isLocalRing
  have : Module.Free R (R ⊗[A] K₁) := Module.free_of_flat_of_isLocalRing
  set n := Module.finrank R (R ⊗[A] K₀)
  have hn : Module.finrank R (R ⊗[A] K₁) = n := by
    rw [← Module.rankAtStalk_eq_finrank_tensorProduct, ← hrank,
      Module.rankAtStalk_eq_finrank_tensorProduct]
  let b₀ := Module.finBasisOfFinrankEq R (R ⊗[A] K₀) (rfl : Module.finrank R _ = n)
  let b₁ := Module.finBasisOfFinrankEq R (R ⊗[A] K₁) hn
  let δR := δ.baseChange R
  let Mx := LinearMap.toMatrix b₀ b₁ δR
  have hδR : (b₁.equivFun.toLinearMap ∘ₗ δR) = Mx.mulVecLin ∘ₗ b₀.equivFun.toLinearMap := by
    refine LinearMap.ext fun x => ?_
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply, Matrix.mulVecLin_apply,
      Module.Basis.equivFun_apply, Mx, LinearMap.toMatrix_mulVec_repr]
  let ecok : Stacks.FamilyFitting.coker δR ≃ₗ[R]
      ((Fin n → R) ⧸ LinearMap.range Mx.mulVecLin) :=
    Stacks.TwoAffineCech.cokerEquivOfComm δR Mx.mulVecLin b₀.equivFun b₁.equivFun hδR
  have hfit : fittingIdeal (R := R) (M := R ⊗[A] Stacks.FamilyFitting.coker δ) ((0 : ℕ) : ℤ) =
      Ideal.span {Mx.det} := by
    have : Module.Finite R (Stacks.FamilyFitting.coker δR) :=
      Module.Finite.equiv ecok.symm
    rw [fittingIdeal_eq_of_linearEquiv (Stacks.FamilyFitting.cokerBaseChangeEquiv δ R).symm 0,
      fittingIdeal_eq_of_linearEquiv ecok 0]
    exact fittingIdeal_zero_coker_mulVecLin Mx
  have hmap := (fittingIdeal_basic_properties.{u, u, u, u} (R := A)
    (M := Stacks.FamilyFitting.coker δ)).2.2.1 R 0
  rw [hfit] at hmap
  have hdet : Mx.det ∈ Ideal.map (algebraMap A R)
      (fittingIdeal (R := A) (M := Stacks.FamilyFitting.coker δ) ((0 : ℕ) : ℤ)) := by
    rw [← hmap]
    exact Ideal.mem_span_singleton_self _
  obtain ⟨⟨⟨a, ha⟩, s⟩, has⟩ :=
    (IsLocalization.mem_map_algebraMap_iff p.asIdeal.primeCompl R).1 hdet
  refine ⟨a, ha, ?_⟩
  rw [← hmap]
  simp only at has
  rw [← has]
  exact (Ideal.span_singleton_mul_right_unit (IsLocalization.map_units R s) _).symm

/-- **The Fitting ideal of `coker δ` is principal on a basic open neighbourhood of every prime**
when `K₀` and `K₁` have the same rank everywhere. -/
theorem exists_map_fittingIdeal_coker_eq_span (δ : K₀ →ₗ[A] K₁)
    (hrank : ∀ q : PrimeSpectrum A, Module.rankAtStalk K₀ q = Module.rankAtStalk K₁ q)
    (p : PrimeSpectrum A) :
    ∃ r ∉ p.asIdeal, ∃ a : A, ∀ (B : Type u) [CommRing B] [Algebra A B]
      [IsLocalization.Away r B],
      Ideal.map (algebraMap A B)
          (fittingIdeal (R := A) (M := Stacks.FamilyFitting.coker δ) ((0 : ℕ) : ℤ)) =
        Ideal.span {algebraMap A B a} := by
  obtain ⟨a, ha, hp⟩ := exists_map_fittingIdeal_atPrime_eq_span δ p (hrank p)
  have : Module.FinitePresentation A K₁ := Module.finitePresentation_of_projective A K₁
  have : Module.FinitePresentation A (Stacks.FamilyFitting.coker δ) :=
    Module.finitePresentation_of_surjective (LinearMap.range δ).mkQ
      (Submodule.mkQ_surjective _) (by
        rw [Submodule.ker_mkQ, LinearMap.range_eq_map]
        exact (Module.Finite.fg_top).map δ)
  have hfg := (fittingIdeal_basic_properties.{u, u, u, u} (R := A)
    (M := Stacks.FamilyFitting.coker δ)).2.2.2.1 inferInstance 0
  obtain ⟨r, hr, h⟩ := exists_map_eq_span_of_atPrime _ hfg p a ha hp
  exact ⟨r, hr, a, h⟩

end Stacks.Fitting

end
