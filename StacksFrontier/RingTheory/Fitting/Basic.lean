/-!
# Fitting ideals of a finite module

Let `R` be a commutative ring and `M` a finite `R`-module. Choosing a surjection `Rⁿ → M` and
letting `A` be the matrix whose columns are the elements of the kernel, the `k`th *Fitting ideal*
of `M` is the ideal generated by the `(n - k) × (n - k)` minors of `A`. Stacks 07Z8
(`minorIdeal_eq_of_quotientLinearEquiv`) says this does not depend on the chosen surjection, so
the construction is an invariant of `M`, and `fittingIdeal` packages it, indexed by `ℤ` so that
the conventional value `Fit_{-1}(M) = 0` is available.

This file sets up the definition and the formal properties of the construction: its agreement with
the minors of an arbitrary finite free presentation, the standard list of basic properties, the
computation for a finite free module, and the computation for a quotient of the ring and for a
product of two such quotients.

## Main definitions

* `fittingIdeal`: the `k`th Fitting ideal of a finite module, for `k : ℤ`.

## Main results

* `fittingIdeal_eq_bot_of_lt_zero`: the Fitting ideals vanish in negative degree.
* `fittingIdeal_eq_minorIdeal_of_presentation`: the Fitting ideal is computed by the minors of any
  finite free presentation, not just the canonical one used in the definition.
* `fittingIdeal_basic_properties`: generation in bounded degree, behaviour on products, base
  change, finite generation for finitely presented modules, monotonicity under quotients, and the
  annihilator and support descriptions of the zeroth Fitting ideal.
* `isClosed_support_and_isCompact_compl_support`: the support of a finitely presented module is
  closed with quasi-compact complement (Stacks 051B).
* `fittingIdeal_eq_of_linearEquiv`: the Fitting ideals are invariant under isomorphism.
* `fittingIdeal_fin_eq_bot_or_top`: `Fit_k(Rⁿ)` is `⊥` for `k < n` and `⊤` for `k ≥ n`.
* `fittingIdeal_quotient_and_prod`: `Fit_0(R ⧸ I) = I`, and for `(R ⧸ I) × (R ⧸ J)` the zeroth and
  first Fitting ideals are `I * J` and `I + J`.

## Implementation notes

The definition uses `Module.Finite.exists_fin'` to choose a finite free surjection onto `M` and
indexes the relations by the whole kernel, so that no finite presentation of the kernel is needed
and every finite module is covered. Most proofs go through
`fittingIdeal_eq_minorIdeal_of_presentation`, which frees them from the arbitrary choice made in
the definition, and then reduce to a statement about minors of the presenting matrix, where the
results of `StacksFrontier.LinearAlgebra.Matrix.MinorIdeal` apply: the product formula for a block
diagonal matrix gives the behaviour on products, compatibility of minors with a ring map gives
base change, and the adjugate gives the annihilator bound.

`fittingIdeal_basic_properties` is stated as a single conjunction, matching the source's numbered
list; its components are proved separately by the private lemmas above it.

## References

* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA)
* [Stacks Project, Tag 07ZB](https://stacks.math.columbia.edu/tag/07ZB)
* [Stacks Project, Tag 0H73](https://stacks.math.columbia.edu/tag/0H73)
-/

open scoped TensorProduct

universe u v w x

@[expose] public section

/-- The `k`th Fitting ideal of a finite module. For negative indices, in particular `-1`, it is
the zero ideal. For nonnegative indices it is generated by the minors of a finite free
presentation. -/
@[stacks 07Z9, sga "7 VI 4.16"]
noncomputable def fittingIdeal {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] [Module.Finite R M] (k : ℤ) : Ideal R :=
  if k < 0 then ⊥ else
    let h := Module.Finite.exists_fin' R M
    let n := h.choose
    let f := h.choose_spec.choose
    minorIdeal (fun (i : Fin n) (j : LinearMap.ker f) => (j : Fin n → R) i)
      (n - k.toNat)

/-- In negative degree the Fitting ideal is the zero ideal; in particular `Fit₋₁(M) = 0`. -/
theorem fittingIdeal_eq_bot_of_lt_zero {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] [Module.Finite R M] {k : ℤ} (hk : k < 0) :
    fittingIdeal (R := R) (M := M) k = ⊥ := by
  simp only [fittingIdeal, hk, ite_true]

/-- **Stacks 07Z9.** The Fitting ideal agrees with the minor ideal of any finite free
presentation of the module, not only the presentation chosen in the definition. -/
@[stacks 07Z9, sga "7 VI 4.16" "partial"]
theorem fittingIdeal_eq_minorIdeal_of_presentation {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {n : ℕ} {J : Type*} (A : Matrix (Fin n) J R) (k : ℕ)
    (e : ((Fin n → R) ⧸ Submodule.span R
      (Set.range (fun j : J => fun i : Fin n => A i j))) ≃ₗ[R] M) :
    fittingIdeal (M := M) (k : ℤ) = minorIdeal A (n - k) := by
  classical
  let h := Module.Finite.exists_fin' R M
  let m := h.choose
  let f := h.choose_spec.choose
  have hf : Function.Surjective f := h.choose_spec.choose_spec
  let B : Matrix (Fin m) (LinearMap.ker f) R := fun i j => (j : Fin m → R) i
  have hker : Submodule.span R
      (Set.range fun j : LinearMap.ker f => fun i => (j : Fin m → R) i) =
      LinearMap.ker f :=
    le_antisymm (Submodule.span_le.2 <| Set.range_subset_iff.2 fun j => j.property)
      fun x hx => Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
  let q : ((Fin m → R) ⧸ Submodule.span R
      (Set.range fun j : LinearMap.ker f => fun i : Fin m => (j : Fin m → R) i)) ≃ₗ[R] M :=
    (Submodule.quotEquivOfEq _ _ hker).trans (f.quotKerEquivOfSurjective hf)
  have hminor := minorIdeal_eq_of_quotientLinearEquiv A B k (e.trans q.symm)
  simpa [fittingIdeal, Int.not_lt.mpr (Int.natCast_nonneg k), Int.toNat_natCast,
    h, m, f, B] using hminor.symm

/-! ### Basic properties -/

private def relationMatrix {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M]
    [Module R M] {n : ℕ} (f : (Fin n → R) →ₗ[R] M) :
    Matrix (Fin n) (LinearMap.ker f) R := fun i j => j.1 i

private lemma relationMatrix_column_mem_ker {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M) (j : LinearMap.ker f) :
    (fun i => (relationMatrix f) i j) ∈ LinearMap.ker f :=
  j.2

private lemma relationMatrix_span {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M) :
    Submodule.span R (Set.range fun j : LinearMap.ker f =>
      fun i => (relationMatrix f) i j) = LinearMap.ker f :=
  le_antisymm (Submodule.span_le.2 <| Set.range_subset_iff.2 fun j => j.2)
    fun v hv => Submodule.subset_span (R := R) ⟨⟨v, hv⟩, rfl⟩

/-- The Fitting ideal is computed by the minors of any matrix whose columns span the kernel of a
surjection `Rⁿ → M`. -/
private theorem fittingIdeal_eq_minorIdeal_of_span_eq_ker {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] [Module.Finite R M] {n : ℕ} {J : Type*}
    (A : Matrix (Fin n) J R) (f : (Fin n → R) →ₗ[R] M) (hf : Function.Surjective f)
    (hspan : Submodule.span R (Set.range fun j : J => fun i => A i j) = LinearMap.ker f)
    (k : ℕ) : fittingIdeal (R := R) (M := M) (k : ℤ) = minorIdeal A (n - k) :=
  fittingIdeal_eq_minorIdeal_of_presentation A k
    ((Submodule.quotEquivOfEq _ _ hspan).trans (f.quotKerEquivOfSurjective hf))

private theorem fittingIdeal_eq_relationMatrix {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] [Module.Finite R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M) (hf : Function.Surjective f) (k : ℕ) :
    fittingIdeal (R := R) (M := M) (k : ℤ) =
      minorIdeal (relationMatrix f) (n - k) :=
  fittingIdeal_eq_minorIdeal_of_span_eq_ker _ f hf (relationMatrix_span f) k

private theorem fittingIdeal_eq_top_of_span_range {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (n : ℕ) (f : Fin n → M) (hf : Submodule.span R (Set.range f) = ⊤) :
    fittingIdeal (R := R) (M := M) (n : ℤ) = ⊤ := by
  let g : (Fin n → R) →ₗ[R] M :=
    (Finsupp.linearCombination R f).comp
      (Finsupp.linearEquivFunOnFinite R R (Fin n)).symm.toLinearMap
  have hg : Function.Surjective g := by
    apply LinearMap.range_eq_top.mp
    rw [LinearMap.range_comp, LinearEquiv.range, Submodule.map_top]
    simpa [Finsupp.range_linearCombination] using hf
  rw [fittingIdeal_eq_relationMatrix g hg n, Nat.sub_self, minorIdeal_zero]

private theorem fittingIdeal_mono_of_surjective {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {M' : Type*} [AddCommGroup M'] [Module R M']
    (f : M →ₗ[R] M') (hf : Function.Surjective f) (k : ℕ) :
    letI := Module.Finite.of_surjective f hf
    fittingIdeal (R := R) (M := M) (k : ℤ) ≤
      fittingIdeal (R := R) (M := M') (k : ℤ) := by
  let := Module.Finite.of_surjective f hf
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin' R M
  let h : LinearMap.ker g → LinearMap.ker (f.comp g) := fun j =>
    ⟨j.1, by
      change f (g j.1) = 0
      rw [LinearMap.mem_ker.mp j.2, map_zero]⟩
  calc
    fittingIdeal (R := R) (M := M) (k : ℤ) =
        minorIdeal (relationMatrix g) (n - k) :=
          fittingIdeal_eq_relationMatrix g hg k
    _ ≤ minorIdeal (relationMatrix (f.comp g)) (n - k) :=
      minorIdeal_submatrix_le (relationMatrix (f.comp g)) id h _
    _ = fittingIdeal (R := R) (M := M') (k : ℤ) :=
      (fittingIdeal_eq_relationMatrix (f.comp g) (hf.comp hg) k).symm

private theorem minorIdeal_fg {R : Type*} [CommRing R] {L J : Type*}
    [Finite L] [Finite J] (A : Matrix L J R) (r : ℕ) :
    (minorIdeal A r).FG := by
  classical
  unfold minorIdeal
  let d : (Fin r → L) × (Fin r → J) → R :=
    fun p => (A.submatrix p.1 p.2).det
  have hs : {x : R | ∃ (f : Fin r → L) (g : Fin r → J),
      x = (A.submatrix f g).det} = Set.range d := by
    ext x
    simp [d, eq_comm]
  rw [hs]
  exact Submodule.fg_span (Set.finite_range d)

private theorem fittingIdeal_fg_of_finitePresentation {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] (k : ℕ) :
    (fittingIdeal (R := R) (M := M) (k : ℤ)).FG := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  obtain ⟨S, hS, hspan⟩ := Submodule.fg_def.mp
    (Module.FinitePresentation.fg_ker f hf)
  let : Finite S := hS.to_subtype
  let A : Matrix (Fin n) S R := fun i j => j.1 i
  have hA : Submodule.span R (Set.range fun j : S =>
      fun i => A i j) = LinearMap.ker f := by
    have hs : Set.range (fun j : S => fun i => A i j) = S := Subtype.range_coe
    rw [hs, hspan]
  rw [fittingIdeal_eq_minorIdeal_of_span_eq_ker A f hf hA k]
  exact minorIdeal_fg A (n - k)

private theorem minorIdeal_one_eq_span_entries {R : Type*} [CommRing R]
    {J : Type*} (A : Matrix (Fin 1) J R) :
    minorIdeal A 1 = Ideal.span (Set.range fun j : J => A 0 j) := by
  classical
  unfold minorIdeal
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro x ⟨f, g, rfl⟩
    rw [Matrix.det_fin_one]
    have hmem : A 0 (g 0) ∈ Ideal.span (Set.range fun j : J => A 0 j) :=
      Ideal.subset_span ⟨g 0, rfl⟩
    change A (f 0) (g 0) ∈ _
    rw [Subsingleton.elim (f 0) 0]
    exact hmem
  · apply Ideal.span_le.mpr
    rintro x ⟨j, rfl⟩
    apply Ideal.subset_span
    refine ⟨fun _ => 0, fun _ => j, ?_⟩
    simp

private theorem fittingIdeal_zero_quotient {R : Type*} [CommRing R]
    (I : Ideal R) : fittingIdeal (R := R) (M := R ⧸ I) 0 = I := by
  classical
  let e : (Fin 1 → R) ≃ₗ[R] R := LinearEquiv.piUnique R (fun _ => R)
  let q : (Fin 1 → R) →ₗ[R] R ⧸ I := (Submodule.mkQ I).comp e.toLinearMap
  have hq : Function.Surjective q :=
    (Submodule.mkQ_surjective I).comp e.surjective
  change fittingIdeal (R := R) (M := R ⧸ I) ((0 : ℕ) : ℤ) = I
  rw [fittingIdeal_eq_relationMatrix q hq 0, Nat.sub_zero,
    minorIdeal_one_eq_span_entries]
  have he : ∀ x : Fin 1 → R, e x = x 0 := by
    intro x
    rfl
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x ⟨j, rfl⟩
    have hj := LinearMap.mem_ker.mp j.2
    change (Submodule.mkQ I) (e j.1) = 0 at hj
    rw [he] at hj
    have hh : j.1 0 ∈ LinearMap.ker (Submodule.mkQ I) :=
      LinearMap.mem_ker.mpr hj
    change j.1 0 ∈ I
    simpa [Submodule.ker_mkQ] using hh
  · intro x hx
    apply Ideal.subset_span
    let y : Fin 1 → R := fun _ => x
    have hy : y ∈ LinearMap.ker q := by
      change (Submodule.mkQ I) (e y) = 0
      rw [he]
      apply LinearMap.mem_ker.mp
      simpa [Submodule.ker_mkQ] using hx
    exact ⟨⟨y, hy⟩, rfl⟩

private theorem squareRelation_mulVec_mem_ker {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M)
    (g : Fin n → LinearMap.ker f) (v : Fin n → R) :
    ((relationMatrix f).submatrix id g).mulVec v ∈ LinearMap.ker f := by
  classical
  have h : ((relationMatrix f).submatrix id g).mulVec v =
      ∑ j : Fin n, v j • (g j).1 := by
    ext i
    simp [Matrix.mulVec, dotProduct, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul, mul_comm, relationMatrix]
  rw [h]
  exact Submodule.sum_mem _ fun j _ => (LinearMap.ker f).smul_mem _ (g j).2

private theorem squareRelation_det_smul_mem_ker {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M)
    (g : Fin n → LinearMap.ker f) (v : Fin n → R) :
    (((relationMatrix f).submatrix id g).det : R) • v ∈ LinearMap.ker f := by
  classical
  let B := (relationMatrix f).submatrix id g
  have h : B.det • v = B.mulVec (B.adjugate.mulVec v) := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_adjugate, Matrix.smul_mulVec,
      Matrix.one_mulVec]
  rw [h]
  exact squareRelation_mulVec_mem_ker f g _

private theorem relationMinor_det_mem_annihilator {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M) (hf : Function.Surjective f)
    (a : Fin n → Fin n) (g : Fin n → LinearMap.ker f) :
    ((relationMatrix f).submatrix a g).det ∈ Module.annihilator R M := by
  classical
  let B := (relationMatrix f).submatrix id g
  have hB : B.det ∈ Module.annihilator R M := by
    apply Module.mem_annihilator.mpr
    intro m
    obtain ⟨v, rfl⟩ := hf m
    have hker := squareRelation_det_smul_mem_ker f g v
    have hzero : f (B.det • v) = 0 := LinearMap.mem_ker.mp hker
    simpa only [map_smul] using hzero
  by_cases ha : Function.Injective a
  · let e : Equiv.Perm (Fin n) :=
      Equiv.ofBijective a ⟨ha, Finite.surjective_of_injective ha⟩
    have hdet : ((relationMatrix f).submatrix a g).det =
        (Equiv.Perm.sign e : R) * B.det := by
      have he : (e : Fin n → Fin n) = a := rfl
      have hmatrix : B.submatrix e id = (relationMatrix f).submatrix a g := by
        ext i j
        simp [B, Matrix.submatrix_apply, he]
      rw [← hmatrix]
      exact Matrix.det_permute e B
    rw [hdet]
    exact Ideal.mul_mem_left _ _ hB
  · have hpair : ∃ i j, i ≠ j ∧ a i = a j := by
      by_contra h
      exact ha fun i j hij => by_contra fun hne => h ⟨i, j, hne, hij⟩
    obtain ⟨i, j, hij, heq⟩ := hpair
    have hdet : ((relationMatrix f).submatrix a g).det = 0 := by
      apply Matrix.det_zero_of_row_eq hij
      ext k
      simp [Matrix.submatrix_apply, heq]
    rw [hdet]
    exact Ideal.zero_mem _

private theorem fittingIdeal_zero_le_annihilator {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M] :
    fittingIdeal (R := R) (M := M) 0 ≤ Module.annihilator R M := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  change fittingIdeal (R := R) (M := M) ((0 : ℕ) : ℤ) ≤ _
  rw [fittingIdeal_eq_relationMatrix f hf 0, Nat.sub_zero, minorIdeal,
    Ideal.span_le]
  rintro x ⟨a, g, rfl⟩
  exact relationMinor_det_mem_annihilator f hf a g

private theorem annihilator_pow_mem_fittingIdeal_zero {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (x : R) (hx : x ∈ Module.annihilator R M) :
    ∃ n : ℕ, x ^ n ∈ fittingIdeal (R := R) (M := M) 0 := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  let g : Fin n → LinearMap.ker f := fun j =>
    ⟨x • Pi.single j (1 : R),
      LinearMap.mem_ker.mpr ((map_smul f x _).trans (Module.mem_annihilator.mp hx _))⟩
  have hmatrix : (relationMatrix f).submatrix id g =
      x • (1 : Matrix (Fin n) (Fin n) R) := by
    ext i j
    simp [relationMatrix, g, Matrix.one_apply, Pi.single_apply, smul_eq_mul]
  have hdet : ((relationMatrix f).submatrix id g).det = x ^ n := by
    rw [hmatrix, Matrix.det_smul]
    simp
  refine ⟨n, ?_⟩
  change x ^ n ∈ fittingIdeal (R := R) (M := M) ((0 : ℕ) : ℤ)
  rw [fittingIdeal_eq_relationMatrix f hf 0, Nat.sub_zero, ← hdet]
  exact Ideal.subset_span ⟨id, g, rfl⟩

private theorem fittingIdeal_zero_zeroLocus_eq_support {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M] :
    PrimeSpectrum.zeroLocus ((fittingIdeal (R := R) (M := M) 0 : Ideal R) : Set R) =
      Module.support R M := by
  rw [Module.support_eq_zeroLocus]
  ext p
  constructor
  · refine fun hp => (PrimeSpectrum.mem_zeroLocus p _).mpr fun x hx => ?_
    obtain ⟨n, hn⟩ := annihilator_pow_mem_fittingIdeal_zero x hx
    exact p.isPrime.mem_of_pow_mem n ((PrimeSpectrum.mem_zeroLocus p _).mp hp hn)
  · exact fun hp => (PrimeSpectrum.mem_zeroLocus p _).mpr <|
      Set.Subset.trans fittingIdeal_zero_le_annihilator ((PrimeSpectrum.mem_zeroLocus p _).mp hp)

/-- Minor ideals commute with extension of scalars: the image of `I_r(A)` under `φ` generates
`I_r(φ A)`. -/
public theorem minorIdeal_map {R : Type*} [CommRing R]
    {S : Type*} [CommRing S] (φ : R →+* S)
    {L J : Type*} (A : Matrix L J R) (r : ℕ) :
    Ideal.map φ (minorIdeal A r) = minorIdeal (A.map φ) r := by
  classical
  unfold minorIdeal
  rw [Ideal.map_span]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨y, ⟨f, g, rfl⟩, rfl⟩
    exact ⟨f, g, by rw [RingHom.map_det]; congr 1⟩
  · rintro ⟨f, g, rfl⟩
    exact ⟨(A.submatrix f g).det, ⟨f, g, rfl⟩, by rw [RingHom.map_det]; congr 1⟩

private theorem minorIdeal_antitone {R : Type*} [CommRing R] {L J : Type*}
    (A : Matrix L J R) : Antitone (minorIdeal A) :=
  antitone_nat_of_succ_le (minorIdeal_succ_le A)

private theorem minorIdeal_eq_bot_of_rows_lt {R : Type*} [CommRing R]
    {L J : Type*} [Fintype L] (A : Matrix L J R) {r : ℕ}
    (h : Fintype.card L < r) :
    minorIdeal A r = ⊥ := by
  rw [minorIdeal, Ideal.span_eq_bot]
  rintro x ⟨f, g, rfl⟩
  obtain ⟨i, j, hij, heq⟩ := Fintype.exists_ne_map_eq_of_card_lt f (by simpa using h)
  apply Matrix.det_zero_of_row_eq hij
  ext k
  simp [Matrix.submatrix_apply, heq]

private theorem minorIdeal_fromBlocks_fitting {R : Type*} [CommRing R]
    {J K : Type*} {n m : ℕ} (A : Matrix (Fin n) J R)
    (B : Matrix (Fin m) K R) (l : ℕ) :
    minorIdeal (Matrix.fromBlocks A 0 0 B) (n + m - l) =
      ∑ k ∈ Finset.range (l + 1), minorIdeal A (n - k) * minorIdeal B (m - (l - k)) := by
  classical
  let C := Matrix.fromBlocks A 0 0 B
  let F : ℕ → Ideal R := fun r => minorIdeal C r
  have hF : Antitone F := minorIdeal_antitone C
  by_cases hlarge : n + m ≤ l
  · have hn : n ∈ Finset.range (l + 1) := Finset.mem_range.mpr (by omega)
    have hm : m ≤ l - n := by omega
    rw [Nat.sub_eq_zero_of_le hlarge, minorIdeal_zero]
    apply (top_unique ?_).symm
    simpa [minorIdeal_zero, Nat.sub_eq_zero_of_le hm] using
      (Finset.single_le_sum (f := fun k => minorIdeal A (n - k) *
        minorIdeal B (m - (l - k))) (fun _ _ => bot_le) hn)
  have hsmall : l < n + m := by omega
  rw [minorIdeal_fromBlocks]
  apply le_antisymm
  · apply Finset.sup_le
    intro p hp
    have hp' : p.1 + p.2 = n + m - l := Finset.mem_antidiagonal.mp hp
    by_cases hpn : n < p.1
    · rw [minorIdeal_eq_bot_of_rows_lt A (by simpa using hpn)]
      simp
    by_cases hpm : m < p.2
    · rw [minorIdeal_eq_bot_of_rows_lt B (by simpa using hpm)]
      simp
    let k := n - p.1
    have hk : k ≤ l := by dsimp [k]; omega
    have hka : n - k = p.1 := by dsimp [k]; omega
    have hkb : m - (l - k) = p.2 := by dsimp [k]; omega
    have hmem : k ∈ Finset.range (l + 1) := Finset.mem_range.mpr (by omega)
    simpa only [hka, hkb] using (Finset.single_le_sum (f := fun i =>
      minorIdeal A (n - i) * minorIdeal B (m - (l - i))) (fun _ _ => bot_le) hmem)
  · apply Finset.sup_le
    intro k hk
    have hk' : k ≤ l := by have := Finset.mem_range.mp hk; omega
    let a := n - k
    let b := m - (l - k)
    calc
      minorIdeal A a * minorIdeal B b ≤
          ∑ p ∈ Finset.antidiagonal (a + b),
            minorIdeal A p.1 * minorIdeal B p.2 := by
              simpa only [Prod.fst, Prod.snd] using
                (Finset.single_le_sum (f := fun p : ℕ × ℕ =>
                  minorIdeal A p.1 * minorIdeal B p.2) (fun _ _ => bot_le)
                  (Finset.mem_antidiagonal.mpr rfl : (a, b) ∈ Finset.antidiagonal (a + b)))
      _ = F (a + b) := (minorIdeal_fromBlocks A B (a + b)).symm
      _ ≤ F (n + m - l) := hF (by dsimp [a, b]; omega)
      _ = ∑ p ∈ Finset.antidiagonal (n + m - l),
            minorIdeal A p.1 * minorIdeal B p.2 := minorIdeal_fromBlocks A B _

private def productFreeEquiv {R : Type*} [CommRing R] (n m : ℕ) :
    (Fin (n + m) → R) ≃ₗ[R] (Fin n → R) × (Fin m → R) :=
  (LinearEquiv.funCongrLeft R R (finSumFinEquiv : Fin n ⊕ Fin m ≃ Fin (n + m))).trans
    (LinearEquiv.sumArrowLequivProdArrow (Fin n) (Fin m) R R)

private def productPresentation {R : Type*} [CommRing R]
    {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {n m : ℕ} (f : (Fin n → R) →ₗ[R] M) (g : (Fin m → R) →ₗ[R] N) :
    (Fin (n + m) → R) →ₗ[R] M × N :=
  (f.prodMap g).comp (productFreeEquiv n m).toLinearMap

private def productRelationMatrix {R : Type*} [CommRing R]
    {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {n m : ℕ} (f : (Fin n → R) →ₗ[R] M) (g : (Fin m → R) →ₗ[R] N) :
    Matrix (Fin (n + m)) (LinearMap.ker f ⊕ LinearMap.ker g) R :=
  (Matrix.fromBlocks (relationMatrix f) 0 0 (relationMatrix g)).submatrix
    (finSumFinEquiv : Fin n ⊕ Fin m ≃ Fin (n + m)).symm id

private theorem productRelationMatrix_span {R : Type*} [CommRing R]
    {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {n m : ℕ} (f : (Fin n → R) →ₗ[R] M) (g : (Fin m → R) →ₗ[R] N) :
    Submodule.span R (Set.range fun j : LinearMap.ker f ⊕ LinearMap.ker g =>
      fun i => (productRelationMatrix f g) i j) =
      LinearMap.ker (productPresentation f g) := by
  let e := productFreeEquiv (R := R) n m
  let B := productRelationMatrix f g
  have hcol : ∀ j : LinearMap.ker f ⊕ LinearMap.ker g,
      e (fun i => B i j) =
        match j with
        | Sum.inl a => (a.1, 0)
        | Sum.inr b => (0, b.1) := by
    intro j
    cases j with
    | inl a =>
        apply Prod.ext <;> funext i
        · simp [e, B, productFreeEquiv, productRelationMatrix, relationMatrix,
            Matrix.fromBlocks_apply₁₁]
        · simp [e, B, productFreeEquiv, productRelationMatrix,
            Matrix.fromBlocks_apply₂₁]
    | inr b =>
        apply Prod.ext <;> funext i
        · simp [e, B, productFreeEquiv, productRelationMatrix,
            Matrix.fromBlocks_apply₁₂]
        · simp [e, B, productFreeEquiv, productRelationMatrix, relationMatrix,
            Matrix.fromBlocks_apply₂₂]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro x ⟨j, rfl⟩
    apply LinearMap.mem_ker.mpr
    change (f.prodMap g) (e (fun i => B i j)) = 0
    rw [hcol]
    cases j with
    | inl a => simp [LinearMap.prodMap_apply, LinearMap.mem_ker.mp a.2]
    | inr b => simp [LinearMap.prodMap_apply, LinearMap.mem_ker.mp b.2]
  · intro x hx
    have hxy : (f.prodMap g) (e x) = 0 := LinearMap.mem_ker.mp hx
    have hx1 : (e x).1 ∈ LinearMap.ker f :=
      LinearMap.mem_ker.mpr (by simpa using congrArg Prod.fst hxy)
    have hx2 : (e x).2 ∈ LinearMap.ker g :=
      LinearMap.mem_ker.mpr (by simpa using congrArg Prod.snd hxy)
    let a : LinearMap.ker f := ⟨(e x).1, hx1⟩
    let b : LinearMap.ker g := ⟨(e x).2, hx2⟩
    have hdecomp : x = (fun i => B i (Sum.inl a)) + (fun i => B i (Sum.inr b)) := by
      apply e.injective
      rw [map_add, hcol, hcol]
      simp [a, b]
    rw [hdecomp]
    exact Submodule.add_mem _ (Submodule.subset_span ⟨Sum.inl a, rfl⟩)
      (Submodule.subset_span ⟨Sum.inr b, rfl⟩)

private theorem fittingIdeal_prod {R : Type*} [CommRing R]
    {M N : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] (l : ℕ) :
    fittingIdeal (R := R) (M := M × N) (l : ℤ) =
      ∑ k ∈ Finset.range (l + 1), fittingIdeal (R := R) (M := M) (k : ℤ) *
        fittingIdeal (R := R) (M := N) ((l - k : ℕ) : ℤ) := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  obtain ⟨m, g, hg⟩ := Module.Finite.exists_fin' R N
  let P := productPresentation f g
  have hP : Function.Surjective P := by
    intro x
    obtain ⟨a, ha⟩ := hf x.1
    obtain ⟨b, hb⟩ := hg x.2
    refine ⟨(productFreeEquiv (R := R) n m).symm (a, b), ?_⟩
    simp [P, productPresentation, ha, hb]
  let B := productRelationMatrix f g
  have hminor (r : ℕ) : minorIdeal B r =
      minorIdeal (Matrix.fromBlocks (relationMatrix f) 0 0 (relationMatrix g)) r :=
    le_antisymm (minorIdeal_submatrix_le _ _ _ _)
      (minorIdeal_reindex_rows_le _ (finSumFinEquiv : Fin n ⊕ Fin m ≃ Fin (n + m)).symm _)
  calc
    fittingIdeal (R := R) (M := M × N) (l : ℤ) = minorIdeal B (n + m - l) :=
      fittingIdeal_eq_minorIdeal_of_span_eq_ker B P hP (productRelationMatrix_span f g) l
    _ = minorIdeal (Matrix.fromBlocks (relationMatrix f) 0 0 (relationMatrix g))
          (n + m - l) := hminor _
    _ = ∑ k ∈ Finset.range (l + 1), minorIdeal (relationMatrix f) (n - k) *
          minorIdeal (relationMatrix g) (m - (l - k)) :=
      minorIdeal_fromBlocks_fitting _ _ _
    _ = ∑ k ∈ Finset.range (l + 1), fittingIdeal (R := R) (M := M) (k : ℤ) *
          fittingIdeal (R := R) (M := N) ((l - k : ℕ) : ℤ) := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [fittingIdeal_eq_relationMatrix f hf k,
        fittingIdeal_eq_relationMatrix g hg (l - k)]

private theorem baseChange_relationMatrix_span {R : Type*} [CommRing R]
    {S : Type*} [CommRing S] [Algebra R S]
    {M : Type*} [AddCommGroup M] [Module R M] {n : ℕ}
    (f : (Fin n → R) →ₗ[R] M) (hf : Function.Surjective f) :
    let e := TensorProduct.piScalarRight R S S (Fin n)
    let F : (Fin n → S) →ₗ[S] TensorProduct R S M :=
      (f.baseChange S).comp e.symm.toLinearMap
    let B := (relationMatrix f).map (algebraMap R S)
    Submodule.span S (Set.range fun j : LinearMap.ker f => fun i => B i j) =
      LinearMap.ker F := by
  classical
  dsimp
  let e := TensorProduct.piScalarRight R S S (Fin n)
  let B := (relationMatrix f).map (algebraMap R S)
  have hcol (s : S) (j : LinearMap.ker f) :
      e (((LinearMap.ker f).subtype.baseChange S) (s ⊗ₜ[R] j)) =
        s • (fun i => B i j) := by
    ext i
    simp [e, B, relationMatrix, LinearMap.baseChange_tmul,
      TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul,
      Algebra.smul_def, smul_eq_mul, mul_comm]
  have hex : Function.Exact
      ((LinearMap.ker f).subtype.baseChange S) (f.baseChange S) := by
    have hfg : Function.Exact (LinearMap.ker f).subtype f := by
      rw [LinearMap.exact_iff]
      exact (Submodule.range_subtype _).symm
    simpa only [LinearMap.baseChange_eq_lTensor] using (lTensor_exact S hfg hf)
  have hker : (f.baseChange S).ker =
      ((LinearMap.ker f).subtype.baseChange S).range :=
    LinearMap.exact_iff.mp hex
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro x ⟨j, rfl⟩
    apply LinearMap.mem_ker.mpr
    change (f.baseChange S) (e.symm (fun i => B i j)) = 0
    have hj : (f.baseChange S) (((LinearMap.ker f).subtype.baseChange S)
        (1 ⊗ₜ[R] j)) = 0 := by
      rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul]
      simp [LinearMap.mem_ker.mp j.2]
    have hc := hcol 1 j
    simp only [one_smul] at hc
    rw [← hc, e.symm_apply_apply]
    exact hj
  · intro x hx
    have hx' : e.symm x ∈ (f.baseChange S).ker :=
      LinearMap.mem_ker.mpr (LinearMap.mem_ker.mp hx)
    rw [hker] at hx'
    obtain ⟨y, hy⟩ := hx'
    have hspan : ∀ y : TensorProduct R S (LinearMap.ker f),
        e (((LinearMap.ker f).subtype.baseChange S) y) ∈
          Submodule.span S (Set.range fun j : LinearMap.ker f => fun i => B i j) := by
      intro y
      induction y using TensorProduct.inductionOn with
      | tmul s j =>
          rw [hcol]
          exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
      | add y z hy hz =>
          simp only [map_add]
          exact Submodule.add_mem _ hy hz
    have he : x = e (((LinearMap.ker f).subtype.baseChange S) y) := by
      apply e.symm.injective
      simpa using hy.symm
    rw [he]
    exact hspan y

private theorem fittingIdeal_baseChange {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    {S : Type*} [CommRing S] [Algebra R S] (k : ℕ) :
    fittingIdeal (R := S) (M := TensorProduct R S M) (k : ℤ) =
      Ideal.map (algebraMap R S) (fittingIdeal (R := R) (M := M) (k : ℤ)) := by
  classical
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  let e := TensorProduct.piScalarRight R S S (Fin n)
  let F : (Fin n → S) →ₗ[S] TensorProduct R S M :=
    (f.baseChange S).comp e.symm.toLinearMap
  let B := (relationMatrix f).map (algebraMap R S)
  have hF : Function.Surjective F :=
    (LinearMap.baseChange_surjective S hf).comp e.symm.surjective
  calc
    fittingIdeal (R := S) (M := TensorProduct R S M) (k : ℤ) =
        minorIdeal B (n - k) :=
          fittingIdeal_eq_minorIdeal_of_span_eq_ker B F hF (baseChange_relationMatrix_span f hf) k
    _ = Ideal.map (algebraMap R S) (minorIdeal (relationMatrix f) (n - k)) :=
      (minorIdeal_map (algebraMap R S) (relationMatrix f) (n - k)).symm
    _ = Ideal.map (algebraMap R S) (fittingIdeal (R := R) (M := M) (k : ℤ)) := by
      rw [fittingIdeal_eq_relationMatrix f hf k]

/-- **Stacks 07ZA.** Basic properties of the Fitting ideals of a finite module: generation in
bounded degree, compatibility with direct sums and scalar extension, finite generation for
finitely presented modules, monotonicity under quotients, the annihilator and support
descriptions in degree zero, and the computation for a quotient of the ring. -/
@[stacks 07ZA, sga "7 VI 5.1"]
theorem fittingIdeal_basic_properties {R : Type u} [CommRing R]
    {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M] :
    (∀ n : ℕ, (∃ f : Fin n → M, Submodule.span R (Set.range f) = ⊤) →
      fittingIdeal (R := R) (M := M) (n : ℤ) = ⊤) ∧
    (∀ (M' : Type w) [AddCommGroup M'] [Module R M'] [Module.Finite R M'],
      fittingIdeal (R := R) (M := M × M') 0 =
          fittingIdeal (R := R) (M := M) 0 * fittingIdeal (R := R) (M := M') 0 ∧
      ∀ l : ℕ, fittingIdeal (R := R) (M := M × M') (l : ℤ) =
        ∑ k ∈ Finset.range (l + 1),
          fittingIdeal (R := R) (M := M) (k : ℤ) *
            fittingIdeal (R := R) (M := M') ((l - k : ℕ) : ℤ)) ∧
    (∀ (S : Type x) [CommRing S] [Algebra R S] (k : ℕ),
      fittingIdeal (R := S) (M := TensorProduct R S M) (k : ℤ) =
        Ideal.map (algebraMap R S) (fittingIdeal (R := R) (M := M) (k : ℤ))) ∧
    (Module.FinitePresentation R M →
      ∀ k : ℕ, (fittingIdeal (R := R) (M := M) (k : ℤ)).FG) ∧
    (∀ (M' : Type w) [AddCommGroup M'] [Module R M']
      (f : M →ₗ[R] M') (k : ℕ) (hf : Function.Surjective f),
        letI := Module.Finite.of_surjective f hf
        fittingIdeal (R := R) (M := M) (k : ℤ) ≤
          fittingIdeal (R := R) (M := M') (k : ℤ)) ∧
    (fittingIdeal (R := R) (M := M) 0 ≤ Module.annihilator R M) ∧
    (PrimeSpectrum.zeroLocus ((fittingIdeal (R := R) (M := M) 0 : Ideal R) : Set R) =
      Module.support R M) ∧
    (∀ I : Ideal R, fittingIdeal (R := R) (M := R ⧸ I) 0 = I) := by
  classical
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fun n ⟨f, hf⟩ => fittingIdeal_eq_top_of_span_range n f hf
  · exact fun M' _ _ _ => ⟨by simpa using fittingIdeal_prod (M := M) (N := M') 0,
      fittingIdeal_prod (M := M) (N := M')⟩
  · exact fun S _ _ k => fittingIdeal_baseChange (M := M) (S := S) k
  · intro hfp k
    let := hfp
    exact fittingIdeal_fg_of_finitePresentation k
  · exact fun M' _ _ f k hf => fittingIdeal_mono_of_surjective f hf k
  · exact fittingIdeal_zero_le_annihilator
  · exact fittingIdeal_zero_zeroLocus_eq_support
  · exact fittingIdeal_zero_quotient

/-- **Stacks 051B.** The support of a finitely presented module is a closed subset of `Spec R`
whose complement is quasi-compact. The support is the zero locus of the zeroth Fitting ideal,
the ideal of maximal minors of a presentation matrix, and that ideal is finitely generated for
a finitely presented module. -/
@[stacks 051B "Supp(M) = V(Fit_0(M)) with Fit_0(M) finitely generated, as in the source proof"]
theorem isClosed_support_and_isCompact_compl_support {R : Type*} [CommRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.FinitePresentation R M] :
    IsClosed (Module.support R M) ∧ IsCompact (Module.support R M)ᶜ := by
  rw [← fittingIdeal_zero_zeroLocus_eq_support]
  exact ⟨PrimeSpectrum.isClosed_zeroLocus _, (PrimeSpectrum.isCompact_isOpen_iff_ideal.mpr
    ⟨_, fittingIdeal_fg_of_finitePresentation (M := M) 0, rfl⟩).1⟩

/-- The Fitting ideals of a finite module are invariant under isomorphism. -/
theorem fittingIdeal_eq_of_linearEquiv {R : Type u} [CommRing R]
    {M : Type v} {N : Type w} [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    (e : M ≃ₗ[R] N) (k : ℕ) :
    fittingIdeal (R := R) (M := M) (k : ℤ) = fittingIdeal (R := R) (M := N) (k : ℤ) :=
  le_antisymm
    ((fittingIdeal_basic_properties.{u, v, w, u} (R := R) (M := M)).2.2.2.2.1
      N e.toLinearMap k e.surjective)
    ((fittingIdeal_basic_properties.{u, w, v, u} (R := R) (M := N)).2.2.2.2.1
      M e.symm.toLinearMap k e.symm.surjective)


/-! ### Finite free modules and quotients of the ring -/

/-- **Stacks 07ZB.** The Fitting ideal of a finite free module is zero below its rank and the
unit ideal from its rank onward. -/
@[stacks 07ZB]
theorem fittingIdeal_fin_eq_bot_or_top {R : Type*} [CommRing R] (n : ℕ) (k : ℤ) :
    fittingIdeal (R := R) (M := Fin n → R) k =
      if k < n then ⊥ else ⊤ := by
  by_cases hk : k < 0
  · rw [fittingIdeal, ite_eq_left hk]
    rw [ite_eq_left (lt_of_lt_of_le hk (Int.natCast_nonneg n))]
  · have hk0 : 0 ≤ k := le_of_not_gt hk
    obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hk0
    let A : Matrix (Fin n) Empty R := fun _ j => j.elim
    have hspan : Submodule.span R
        (Set.range (fun j : Empty => fun i : Fin n => A i j)) = ⊥ := by
      rw [Submodule.span_eq_bot]
      rintro x ⟨j, rfl⟩
      exact j.elim
    rw [fittingIdeal_eq_minorIdeal_of_presentation A k
      (Submodule.quotEquivOfEqBot _ hspan)]
    by_cases hkn : k < n
    · rw [ite_eq_left]
      · exact minorIdeal_eq_bot_of_card_lt A (n - k)
          (Or.inr (by simpa using Nat.sub_pos_of_lt hkn))
      · exact_mod_cast hkn
    · rw [ite_eq_right]
      · rw [Nat.sub_eq_zero_of_le (Nat.le_of_not_gt hkn), minorIdeal_zero]
      · exact_mod_cast hkn

private def twoMatrix {R : Type*} [CommRing R] (I J : Ideal R) :
    Matrix (Fin 2) (I ⊕ J) R := fun i z => match z with
  | Sum.inl x => if i = 0 then (x : R) else 0
  | Sum.inr y => if i = 1 then (y : R) else 0

private def twoQuotientMap {R : Type*} [CommRing R] (I J : Ideal R) :
    (Fin 2 → R) →ₗ[R] (R ⧸ I) × (R ⧸ J) where
  toFun x := (Ideal.Quotient.mk I (x 0), Ideal.Quotient.mk J (x 1))
  map_add' _ _ := by simp
  map_smul' _ _ := rfl

private lemma twoQuotientMap_surjective {R : Type*} [CommRing R] (I J : Ideal R) :
    Function.Surjective (twoQuotientMap I J) := by
  rintro ⟨x, y⟩
  refine Quotient.inductionOn' x fun a => Quotient.inductionOn' y fun b => ?_
  exact ⟨![a, b], rfl⟩

private lemma ker_twoQuotientMap {R : Type*} [CommRing R] (I J : Ideal R) :
    LinearMap.ker (twoQuotientMap I J) =
      Submodule.span R (Set.range (fun j : I ⊕ J => fun i : Fin 2 => twoMatrix I J i j)) := by
  apply le_antisymm
  · intro x hx
    have hxI : x 0 ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp (congrArg Prod.fst hx)
    have hxJ : x 1 ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp (congrArg Prod.snd hx)
    have hI := Submodule.subset_span (R := R)
      (show (fun i : Fin 2 => twoMatrix I J i (Sum.inl ⟨x 0, hxI⟩)) ∈
        Set.range (fun j : I ⊕ J => fun i : Fin 2 => twoMatrix I J i j) from
        ⟨Sum.inl ⟨x 0, hxI⟩, rfl⟩)
    have hJ := Submodule.subset_span (R := R)
      (show (fun i : Fin 2 => twoMatrix I J i (Sum.inr ⟨x 1, hxJ⟩)) ∈
        Set.range (fun j : I ⊕ J => fun i : Fin 2 => twoMatrix I J i j) from
        ⟨Sum.inr ⟨x 1, hxJ⟩, rfl⟩)
    convert Submodule.add_mem _ hI hJ using 1
    ext i
    fin_cases i <;> simp [twoMatrix]
  · rw [Submodule.span_le]
    rintro _ ⟨z, rfl⟩
    rcases z with x | y
    · apply Prod.ext
      · exact Ideal.Quotient.eq_zero_iff_mem.mpr x.property
      · change Ideal.Quotient.mk J (if (1 : Fin 2) = 0 then (x : R) else 0) = 0
        simp
    · apply Prod.ext
      · change Ideal.Quotient.mk I (if (0 : Fin 2) = 1 then (y : R) else 0) = 0
        simp
      · exact Ideal.Quotient.eq_zero_iff_mem.mpr y.property

private lemma minorIdeal_twoMatrix_one {R : Type*} [CommRing R] (I J : Ideal R) :
    minorIdeal (twoMatrix I J) 1 = I + J := by
  rw [minorIdeal]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨f, g, rfl⟩
    generalize hg : g 0 = z
    rcases z with x | y
    · apply Ideal.mem_sup_left
      simp only [Matrix.det_fin_one, Matrix.submatrix_apply, twoMatrix]
      split_ifs <;> simp_all
    · apply Ideal.mem_sup_right
      simp only [Matrix.det_fin_one, Matrix.submatrix_apply, twoMatrix]
      split_ifs <;> simp_all
  · rw [add_eq_sup, sup_le_iff]
    refine ⟨fun x hx => Ideal.subset_span ⟨fun _ => 0, fun _ => Sum.inl ⟨x, hx⟩, ?_⟩,
      fun y hy => Ideal.subset_span ⟨fun _ => 1, fun _ => Sum.inr ⟨y, hy⟩, ?_⟩⟩ <;>
    simp [twoMatrix]

private lemma minorIdeal_twoMatrix_two {R : Type*} [CommRing R] (I J : Ideal R) :
    minorIdeal (twoMatrix I J) 2 = I * J := by
  rw [minorIdeal]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨f, g, rfl⟩
    have hf0 : f 0 = 0 ∨ f 0 = 1 := by omega
    have hf1 : f 1 = 0 ∨ f 1 = 1 := by omega
    rcases hf0 with h0 | h0 <;> rcases hf1 with h1 | h1
    · simp [Matrix.det_fin_two, h0, h1, mul_comm]
    · generalize hg0 : g 0 = z0
      generalize hg1 : g 1 = z1
      rcases z0 with x | y <;> rcases z1 with x' | y'
      · simp [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1]
      · simpa [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1] using
          Ideal.mul_mem_mul x.property y'.property
      · simpa [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1] using
          (I * J).neg_mem (Ideal.mul_mem_mul x'.property y.property)
      · simp [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1]
    · generalize hg0 : g 0 = z0
      generalize hg1 : g 1 = z1
      rcases z0 with x | y <;> rcases z1 with x' | y'
      · simp [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1]
      · simpa [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1, mul_comm] using
          (I * J).neg_mem (Ideal.mul_mem_mul x.property y'.property)
      · simpa [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1, mul_comm] using
          Ideal.mul_mem_mul x'.property y.property
      · simp [twoMatrix, Matrix.det_fin_two, h0, h1, hg0, hg1]
    · simp [Matrix.det_fin_two, h0, h1, mul_comm]
  · rw [Ideal.mul_le]
    intro x hx y hy
    apply Ideal.subset_span
    refine ⟨![0, 1], ![Sum.inl ⟨x, hx⟩, Sum.inr ⟨y, hy⟩], ?_⟩
    rw [Matrix.det_fin_two]
    simp [twoMatrix]

/-- **Stacks 0H73.** The zeroth Fitting ideal of `R ⧸ I` is `I`; for the direct sum of two such
quotients, the zeroth and first Fitting ideals are respectively the product and sum of the
defining ideals. -/
@[stacks 0H73]
theorem fittingIdeal_quotient_and_prod {R : Type*} [CommRing R] (I J : Ideal R) :
    fittingIdeal (M := R ⧸ I) 0 = I ∧
      fittingIdeal (M := (R ⧸ I) × (R ⧸ J)) 0 = I * J ∧
      fittingIdeal (M := (R ⧸ I) × (R ⧸ J)) 1 = I + J :=
  ⟨fittingIdeal_zero_quotient I,
    (fittingIdeal_eq_minorIdeal_of_span_eq_ker (twoMatrix I J) _ (twoQuotientMap_surjective I J)
      (ker_twoQuotientMap I J).symm 0).trans (by simpa using minorIdeal_twoMatrix_two I J),
    (fittingIdeal_eq_minorIdeal_of_span_eq_ker (twoMatrix I J) _ (twoQuotientMap_surjective I J)
      (ker_twoQuotientMap I J).symm 1).trans (by simpa using minorIdeal_twoMatrix_one I J)⟩

/-! ### Monotonicity -/

namespace Stacks.Fitting

/-- Raising the index by one enlarges the Fitting ideal: the corresponding minor ideal is
generated by smaller minors. -/
theorem fittingIdeal_le_succ {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] [Module.Finite R M] (k : ℤ) :
    fittingIdeal (R := R) (M := M) k ≤ fittingIdeal (R := R) (M := M) (k + 1) := by
  rcases lt_or_ge k 0 with hk | hk
  · rw [fittingIdeal, ite_eq_left_of_eq_true _ _ (eq_true hk)]
    exact bot_le
  · rw [fittingIdeal, fittingIdeal, ite_eq_right_of_eq_false _ _ (eq_false (by omega : ¬ k < 0)),
      ite_eq_right_of_eq_false _ _ (eq_false (by omega : ¬ k + 1 < 0))]
    exact antitone_nat_of_succ_le (minorIdeal_succ_le _) (by omega)

/-- **Stacks Project, Tag 07Z7.** The Fitting ideals of a finite module increase. -/
@[stacks 07Z7 "(1), for Fitting ideals", sga "7 VI 5.1"]
theorem fittingIdeal_monotone {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    Monotone (fittingIdeal (R := R) (M := M)) := by
  intro a b hab
  induction b, hab using Int.leInduction with
  | base => exact le_rfl
  | succ n _ ih => exact ih.trans (fittingIdeal_le_succ n)

end Stacks.Fitting
/-! ### Monotonicity, transport along an isomorphism, and a free direct factor -/

/-- The Fitting ideals of a finite module are invariant under isomorphism, at an integer index;
in negative degrees both sides are the zero ideal. -/
theorem fittingIdeal_eq_of_linearEquiv_int {R : Type u} [CommRing R]
    {M : Type v} {N : Type w} [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] (e : M ≃ₗ[R] N) (k : ℤ) :
    fittingIdeal (R := R) (M := M) k = fittingIdeal (R := R) (M := N) k := by
  rcases lt_or_ge k 0 with hk | hk
  · rw [fittingIdeal_eq_bot_of_lt_zero hk, fittingIdeal_eq_bot_of_lt_zero hk]
  · obtain ⟨j, rfl⟩ := Int.eq_ofNat_of_zero_le hk
    exact fittingIdeal_eq_of_linearEquiv e j

/-- **A free direct factor shifts the index of the Fitting ideals.**
`Fit_{j+m}(M ⊕ R^m) = Fit_j(M)`: by the direct sum formula of [Stacks, Tag 07ZA] the Fitting
ideal of the product is `∑_{c ≤ j + m} Fit_c(M) · Fit_{j+m-c}(R^m)`, and by [Stacks, Tag 07ZB]
the second factor is the unit ideal exactly when `c ≤ j` and the zero ideal otherwise, so the sum
is `∑_{c ≤ j} Fit_c(M) = Fit_j(M)`.

This is the computation behind splitting off a trivial two-term complex from a bounded-above
complex of finite free modules in the degrees `p + 1, p + 2`: the cokernel of `d_p` acquires a
free direct factor of rank `m` and the alternating sum of the ranks above `p + 1` grows by `m`. -/
@[sga "7 VI 5.1" "5.1(d) with E₂ = A^m"]
theorem fittingIdeal_prod_fin_free {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M]
    [Module R M] [Module.Finite R M] (m : ℕ) (j : ℤ) :
    fittingIdeal (R := R) (M := M × (Fin m → R)) (j + m) =
      fittingIdeal (R := R) (M := M) j := by
  rcases lt_or_ge j 0 with hj | hj
  · rw [fittingIdeal_eq_bot_of_lt_zero hj]
    rcases lt_or_ge (j + m) 0 with hjm | hjm
    · exact fittingIdeal_eq_bot_of_lt_zero hjm
    · obtain ⟨l, hl⟩ := Int.eq_ofNat_of_zero_le hjm
      rw [hl, fittingIdeal_prod (M := M) (N := Fin m → R) l]
      have hzero : ∀ c ∈ Finset.range (l + 1),
          fittingIdeal (R := R) (M := M) (c : ℤ) *
            fittingIdeal (R := R) (M := Fin m → R) ((l - c : ℕ) : ℤ) = 0 := by
        intro c hc
        have hcl := Finset.mem_range.mp hc
        have hlc : ((l - c : ℕ) : ℤ) < m := by omega
        rw [fittingIdeal_fin_eq_bot_or_top m ((l - c : ℕ) : ℤ), ite_eq_left hlc, Ideal.mul_bot]
        rfl
      rw [Finset.sum_congr rfl hzero, Finset.sum_const_zero]
      rfl
  · obtain ⟨j', rfl⟩ := Int.eq_ofNat_of_zero_le hj
    rw [show ((j' : ℤ) + (m : ℤ)) = ((j' + m : ℕ) : ℤ) by push_cast; ring,
      fittingIdeal_prod (M := M) (N := Fin m → R) (j' + m)]
    refine le_antisymm ?_ ?_
    · refine Finset.sum_induction _ (· ≤ fittingIdeal (R := R) (M := M) (j' : ℤ))
        (fun a b ha hb => sup_le ha hb) bot_le ?_
      intro c hc
      have hcl := Finset.mem_range.mp hc
      by_cases hcj : c ≤ j'
      · exact Ideal.mul_le_left.trans (Stacks.Fitting.fittingIdeal_monotone (by exact_mod_cast hcj))
      · have hlc : ((j' + m - c : ℕ) : ℤ) < m := by omega
        rw [fittingIdeal_fin_eq_bot_or_top m ((j' + m - c : ℕ) : ℤ), ite_eq_left hlc, Ideal.mul_bot]
        exact bot_le
    · have hmem := Finset.single_le_sum
        (f := fun c : ℕ => fittingIdeal (R := R) (M := M) (c : ℤ) *
          fittingIdeal (R := R) (M := Fin m → R) ((j' + m - c : ℕ) : ℤ))
        (a := j') (fun _ _ => bot_le) (Finset.mem_range.mpr (show j' < j' + m + 1 by omega))
      refine le_trans ?_ hmem
      have hle : ¬ ((j' + m - j' : ℕ) : ℤ) < m := by omega
      rw [fittingIdeal_fin_eq_bot_or_top m ((j' + m - j' : ℕ) : ℤ), ite_eq_right hle, Ideal.mul_top]
