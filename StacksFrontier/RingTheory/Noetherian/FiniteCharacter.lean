module

public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.LocalProperties.Basic
public import Mathlib.RingTheory.Localization.Ideal

/-!
# Nagata's Noetherianity criterion

A ring whose localizations at its maximal ideals are Noetherian, and in which every nonzero
element lies in only finitely many maximal ideals, is Noetherian.

## Main results

* `IsLocalization.exists_fg_le_map_le`: an ideal whose extension to a localization is finitely
  generated contains a finitely generated ideal with the same extension.
* `isNoetherianRing_of_localization_maximal_of_finite`: Nagata's criterion.

## Implementation notes

Given an ideal `J ≠ 0`, choose `a ∈ J` nonzero. At each of the finitely many maximal ideals
containing `a` the extension of `J` is generated by finitely many elements of `J`; these together
with `a` generate an ideal `J₀ ⊆ J` which agrees with `J` at every maximal ideal (at a maximal
ideal not containing `a` both are the unit ideal), hence equals `J`.

## References

* M. Nagata, *Local rings*, Appendix, Example 1.
-/

@[expose] public section

/-- If the extension of an ideal `J` to a localization `S` of `R` is finitely generated, then `J`
contains a finitely generated ideal `J₀` whose extension contains that of `J`. -/
theorem IsLocalization.exists_fg_le_map_le {R : Type*} [CommRing R] (M : Submonoid R)
    (S : Type*) [CommRing S] [Algebra R S] [IsLocalization M S] {J : Ideal R}
    (hJ : (Ideal.map (algebraMap R S) J).FG) :
    ∃ J₀ : Ideal R, J₀.FG ∧ J₀ ≤ J ∧
      Ideal.map (algebraMap R S) J ≤ Ideal.map (algebraMap R S) J₀ := by
  classical
  obtain ⟨s, hs⟩ := hJ
  have hmem : ∀ z ∈ s, ∃ x ∈ J, ∃ m ∈ M, z * algebraMap R S m = algebraMap R S x := by
    intro z hz
    have hz' : z ∈ Ideal.map (algebraMap R S) J := hs ▸ Ideal.subset_span hz
    obtain ⟨⟨x, m⟩, hx⟩ := (IsLocalization.mem_map_algebraMap_iff M S).mp hz'
    exact ⟨x, x.2, m, m.2, hx⟩
  choose! f hfJ g hgM hfg using hmem
  refine ⟨Ideal.span (s.image f : Set R), ⟨s.image f, rfl⟩, ?_, ?_⟩
  · rw [Ideal.span_le]
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
    exact hfJ z hz
  · rw [← hs, Ideal.span_le]
    intro z hz
    have hu : IsUnit (algebraMap R S (g z)) := IsLocalization.map_units S ⟨g z, hgM z hz⟩
    rw [SetLike.mem_coe, ← Ideal.mul_unit_mem_iff_mem _ hu, hfg z hz]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Finset.mem_image_of_mem f hz))

/-- **Nagata's criterion.** A commutative ring whose localizations at all maximal ideals are
Noetherian, and in which every nonzero element lies in only finitely many maximal ideals, is
Noetherian. -/
theorem isNoetherianRing_of_localization_maximal_of_finite {A : Type*} [CommRing A]
    (hloc : ∀ (m : Ideal A) [m.IsMaximal], IsNoetherianRing (Localization.AtPrime m))
    (hfin : ∀ a : A, a ≠ 0 → {m : Ideal A | m.IsMaximal ∧ a ∈ m}.Finite) :
    IsNoetherianRing A := by
  refine ⟨fun J => ?_⟩
  obtain rfl | hJ := eq_or_ne J ⊥
  · exact Submodule.fg_bot
  obtain ⟨a, haJ, ha⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  have : Finite {m : Ideal A | m.IsMaximal ∧ a ∈ m} := (hfin a ha).to_subtype
  have hlocal : ∀ m : {m : Ideal A | m.IsMaximal ∧ a ∈ m}, ∃ J₀ : Ideal A, J₀.FG ∧ J₀ ≤ J ∧
      ∀ (_ : m.1.IsPrime), Ideal.map (algebraMap A (Localization.AtPrime m.1)) J ≤
        Ideal.map (algebraMap A (Localization.AtPrime m.1)) J₀ := by
    intro m
    have : m.1.IsMaximal := m.2.1
    obtain ⟨J₀, h₁, h₂, h₃⟩ := IsLocalization.exists_fg_le_map_le m.1.primeCompl
      (Localization.AtPrime m.1) (IsNoetherian.noetherian (Ideal.map _ J))
    exact ⟨J₀, h₁, h₂, fun _ => h₃⟩
  choose J₀ hJ₀fg hJ₀le hJ₀map using hlocal
  let J₁ : Ideal A := Ideal.span {a} ⊔ ⨆ m, J₀ m
  have hJ₁fg : J₁.FG :=
    Submodule.FG.sup (Submodule.fg_span_singleton a) (Submodule.fg_iSup _ hJ₀fg)
  have hJ₁le : J₁ ≤ J :=
    sup_le ((Ideal.span_singleton_le_iff_mem J).mpr haJ) (iSup_le hJ₀le)
  suffices h : J ≤ J₁ from le_antisymm hJ₁le h ▸ hJ₁fg
  refine Ideal.le_of_localization_maximal fun P hP => ?_
  by_cases haP : a ∈ P
  · let m : {m : Ideal A | m.IsMaximal ∧ a ∈ m} := ⟨P, hP, haP⟩
    exact (hJ₀map m hP.isPrime).trans
      (Ideal.map_mono (le_sup_of_le_right (le_iSup J₀ m)))
  · have hu : IsUnit (algebraMap A (Localization.AtPrime P) a) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ P a).mpr haP
    have htop : Ideal.map (algebraMap A (Localization.AtPrime P)) J₁ = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _
        (Ideal.mem_map_of_mem _
          (le_sup_left (a := Ideal.span {a}) (Ideal.mem_span_singleton_self a)))
        hu
    exact le_top.trans_eq htop.symm
