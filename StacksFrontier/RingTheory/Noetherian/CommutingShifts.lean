module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# Eventual generation in degree one for commuting shift operators

Let `A` be a Noetherian ring and `… N₀, N₁, N₂, …` a sequence of `A`-modules, together with a
finite family of `A`-linear *shift* maps `μ_l : Nₙ → Nₙ₊₁` (one for each `l` in a finite type
`L`, in every degree) which commute with each other and which generate every degree from the
previous one: every element of `Nₙ₊₁` is a sum `∑ₗ μ_l(yₗ)`. If `N₀` is a finite `A`-module,
then `⨁ₙ Nₙ` is a finitely generated module over the polynomial ring `A[X_l : l ∈ L]`, with
`X_l` acting as `μ_l`, hence a Noetherian one. Consequently every family of submodules
`Dₙ ⊆ Nₙ` stable under the shifts is generated in degree one above some degree:
`D_(n+1) = ∑ₗ μ_l(Dₙ)` for all large `n`.

This is the ascending chain condition on graded submodules of a finite graded module over a
Noetherian graded ring generated in degree one.

## Main definitions

* `Stacks.CommutingShifts.shift` — the total shift `⨁ₙ Nₙ → ⨁ₙ Nₙ` induced by a family of maps
  `Nₙ → Nₙ₊₁`.

## Main results

* `Stacks.CommutingShifts.exists_eventual_sum_shift` — stable families of submodules are
  eventually generated in degree one.
-/

@[expose] public noncomputable section

open scoped DirectSum

universe u v w

namespace Stacks.CommutingShifts

variable {A : Type u} [CommRing A] {N : ℕ → Type w} [∀ n, AddCommGroup (N n)]
  [∀ n, Module A (N n)]

/-- The total shift `⨁ₙ Nₙ → ⨁ₙ Nₙ` of a family of linear maps `Nₙ → Nₙ₊₁`. -/
def shift (μ : ∀ n, N n →ₗ[A] N (n + 1)) : (⨁ n, N n) →ₗ[A] (⨁ n, N n) :=
  DirectSum.toModule A ℕ (⨁ n, N n) fun n ↦ (DirectSum.lof A ℕ N (n + 1)).comp (μ n)

/-- The total shift sends the component `x ∈ Nₙ` to the component `μₙ(x) ∈ Nₙ₊₁`. -/
theorem shift_lof (μ : ∀ n, N n →ₗ[A] N (n + 1)) (n : ℕ) (x : N n) :
    shift μ (DirectSum.lof A ℕ N n x) = DirectSum.lof A ℕ N (n + 1) (μ n x) :=
  DirectSum.toModule_lof A n x

/-- A single-degree element `x ∈ Nₖ` has zero component in every other degree. -/
private theorem lof_apply_of_ne {k m : ℕ} (h : k ≠ m) (x : N k) :
    DirectSum.lof A ℕ N k x m = 0 :=
  DirectSum.of_eq_of_ne _ _ _ h.symm

/-- The degree `n + 1` component of the total shift of `z` is `μₙ` applied to the degree `n`
component of `z`. -/
theorem shift_apply_succ (μ : ∀ n, N n →ₗ[A] N (n + 1)) (z : ⨁ n, N n) (n : ℕ) :
    shift μ z (n + 1) = μ n (z n) := by
  classical
  induction z using DirectSum.induction_on with
  | zero => simp
  | of m y =>
    rw [← DirectSum.lof_eq_of A, shift_lof]
    by_cases h : m = n
    · subst h
      simp [DirectSum.lof_eq_of]
    · rw [lof_apply_of_ne (by omega), lof_apply_of_ne h, map_zero]
  | add x y hx hy => simp only [map_add, DirectSum.add_apply, hx, hy]

/-- The degree zero component of the total shift is zero. -/
theorem shift_apply_zero (μ : ∀ n, N n →ₗ[A] N (n + 1)) (z : ⨁ n, N n) :
    shift μ z 0 = 0 := by
  classical
  induction z using DirectSum.induction_on with
  | zero => simp
  | of m y =>
    rw [← DirectSum.lof_eq_of A, shift_lof, lof_apply_of_ne (by omega)]
  | add x y hx hy => simp only [map_add, DirectSum.add_apply, hx, hy, add_zero]

/-- Total shifts of commuting families of maps commute. -/
private theorem shift_mul_shift_comm {μ μ' : ∀ n, N n →ₗ[A] N (n + 1)}
    (h : ∀ n (x : N n), μ (n + 1) (μ' n x) = μ' (n + 1) (μ n x)) :
    shift μ * shift μ' = shift μ' * shift μ :=
  DirectSum.linearMap_ext A fun n ↦ LinearMap.ext fun x ↦ by
    simp only [LinearMap.comp_apply, Module.End.mul_apply, shift_lof, h]

/-- Finitely many elements of `⨁ₙ Nₙ` all vanish above some degree. -/
private theorem exists_forall_le_apply_eq_zero (G : Finset (⨁ n, N n)) :
    ∃ c, ∀ g ∈ G, ∀ m, c ≤ m → g m = 0 := by
  classical
  refine ⟨G.sup fun g ↦ g.support.sup id + 1, fun g hg m hm ↦ ?_⟩
  by_contra hne
  have h₁ : m ≤ g.support.sup id := Finset.le_sup (f := id) (DFinsupp.mem_support_iff.mpr hne)
  have h₂ : g.support.sup id + 1 ≤ G.sup fun g ↦ g.support.sup id + 1 :=
    Finset.le_sup (f := fun g : ⨁ n, N n ↦ g.support.sup id + 1) hg
  omega

/-- A polynomial minus its constant term lies in the ideal generated by the variables. -/
private theorem sub_C_constantCoeff_mem_span_X {σ R : Type*} [CommRing R] (p : MvPolynomial σ R) :
    p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ R)) := by
  classical
  rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  rw [MvPolynomial.mem_support_iff] at hm
  have hm₀ : m ≠ 0 := by
    rintro rfl
    simp only [MvPolynomial.coeff_sub, MvPolynomial.coeff_C] at hm
    exact hm (sub_eq_zero.mpr rfl)
  obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm₀
  exact ⟨i, Set.mem_univ _, by simpa using hi⟩

/-- Every component of a single-degree element `x ∈ Dₖ` lies in the corresponding `Dₘ`. -/
private theorem lof_apply_mem {D : ∀ n, Submodule A (N n)} {k : ℕ} {x : N k} (hx : x ∈ D k)
    (m : ℕ) : DirectSum.lof A ℕ N k x m ∈ D m := by
  classical
  by_cases h : k = m
  · subst h
    simpa [DirectSum.lof_eq_of, DirectSum.of_eq_same] using hx
  · rw [lof_apply_of_ne h]
    exact (D m).zero_mem

section PolynomialModule

variable {L : Type v} {μ : L → ∀ n, N n →ₗ[A] N (n + 1)}
  [Module (MvPolynomial L A) (⨁ n, N n)]

/-- If `X_l` acts as the shift `μ_l` and constants act through `A`, then every single-degree
element lies in the span of the image of generators of `N₀`. -/
private theorem lof_mem_span_image_lof_zero [Fintype L]
    (hX : ∀ l (z : ⨁ n, N n), (MvPolynomial.X l : MvPolynomial L A) • z = shift (μ l) z)
    (hC : ∀ (a : A) (z : ⨁ n, N n), (MvPolynomial.C a : MvPolynomial L A) • z = a • z)
    (hsurj : ∀ n (x : N (n + 1)), ∃ y : L → N n, x = ∑ l, μ l n (y l))
    {s : Set (N 0)} (hs : Submodule.span A s = ⊤) (n : ℕ) (x : N n) :
    DirectSum.lof A ℕ N n x ∈
      Submodule.span (MvPolynomial L A) (DirectSum.lof A ℕ N 0 '' s) := by
  induction n with
  | zero =>
    have hx : x ∈ Submodule.span A s := hs ▸ Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      exact Submodule.add_mem _ hx hy
    | smul a x _ hx =>
      rw [map_smul, ← hC]
      exact Submodule.smul_mem _ _ hx
  | succ n ih =>
    obtain ⟨y, rfl⟩ := hsurj n x
    rw [map_sum]
    refine Submodule.sum_mem _ fun l _ ↦ ?_
    rw [← shift_lof, ← hX]
    exact Submodule.smul_mem _ _ (ih (y l))

/-- If `X_l` acts as the shift `μ_l`, constants act through `A`, the shifts generate each degree
from the previous one and `N₀` is finite, then `⨁ₙ Nₙ` is a finite `A[X_l]`-module. -/
private theorem finite_of_smul_X_eq_shift [Fintype L] [Module.Finite A (N 0)]
    (hX : ∀ l (z : ⨁ n, N n), (MvPolynomial.X l : MvPolynomial L A) • z = shift (μ l) z)
    (hC : ∀ (a : A) (z : ⨁ n, N n), (MvPolynomial.C a : MvPolynomial L A) • z = a • z)
    (hsurj : ∀ n (x : N (n + 1)), ∃ y : L → N n, x = ∑ l, μ l n (y l)) :
    Module.Finite (MvPolynomial L A) (⨁ n, N n) := by
  classical
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := A) (M := N 0)
  refine ⟨⟨s.image (DirectSum.lof A ℕ N 0), Submodule.eq_top_iff'.mpr fun z ↦ ?_⟩⟩
  rw [Finset.coe_image]
  induction z using DirectSum.induction_on with
  | zero => exact Submodule.zero_mem _
  | of n x =>
    rw [← DirectSum.lof_eq_of A]
    exact lof_mem_span_image_lof_zero hX hC hsurj hs n x
  | add x y hx hy => exact Submodule.add_mem _ hx hy

/-- If `X_l` acts as the shift `μ_l` and constants act through `A`, then the elements of
`⨁ₙ Nₙ` with every component in a shift-stable family `Dₙ` are stable under `A[X_l]`. -/
private theorem smul_apply_mem
    (hX : ∀ l (z : ⨁ n, N n), (MvPolynomial.X l : MvPolynomial L A) • z = shift (μ l) z)
    (hC : ∀ (a : A) (z : ⨁ n, N n), (MvPolynomial.C a : MvPolynomial L A) • z = a • z)
    {D : ∀ n, Submodule A (N n)} (hD : ∀ l n x, x ∈ D n → μ l n x ∈ D (n + 1))
    (p : MvPolynomial L A) : ∀ z : ⨁ n, N n, (∀ n, z n ∈ D n) → ∀ n, (p • z) n ∈ D n := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    intro z hz n
    rw [hC, DirectSum.smul_apply]
    exact (D n).smul_mem a (hz n)
  | add p q hp hq =>
    intro z hz n
    rw [add_smul, DirectSum.add_apply]
    exact (D n).add_mem (hp z hz n) (hq z hz n)
  | mul_X p l hp =>
    intro z hz n
    rw [mul_smul, hX]
    refine hp _ (fun m ↦ ?_) n
    cases m with
    | zero =>
      rw [shift_apply_zero]
      exact (D 0).zero_mem
    | succ m =>
      rw [shift_apply_succ]
      exact hD l m _ (hz m)

/-- If every `μ_l(Dₙ)` lies in `R ⊆ Nₙ₊₁`, then so does the degree `n + 1` component of `q • z`
for `q` in the ideal of the variables and `z` with components in `D`. -/
private theorem apply_succ_mem_of_mem_span_X
    (hX : ∀ l (z : ⨁ n, N n), (MvPolynomial.X l : MvPolynomial L A) • z = shift (μ l) z)
    (hC : ∀ (a : A) (z : ⨁ n, N n), (MvPolynomial.C a : MvPolynomial L A) • z = a • z)
    {D : ∀ n, Submodule A (N n)} (hD : ∀ l n x, x ∈ D n → μ l n x ∈ D (n + 1))
    {n : ℕ} {R : Submodule A (N (n + 1))} (hR : ∀ l y, y ∈ D n → μ l n y ∈ R)
    {q : MvPolynomial L A} (hq : q ∈ Ideal.span (Set.range (MvPolynomial.X : L → _))) :
    ∀ z : ⨁ n, N n, (∀ m, z m ∈ D m) → (q • z) (n + 1) ∈ R := by
  induction hq using Submodule.span_induction with
  | mem q hq =>
    obtain ⟨l, rfl⟩ := hq
    intro z hz
    rw [hX, shift_apply_succ]
    exact hR l _ (hz n)
  | zero => intro z _; simp
  | add q q' _ _ hq hq' =>
    intro z hz
    rw [add_smul, DirectSum.add_apply]
    exact R.add_mem (hq z hz) (hq' z hz)
  | smul s q _ hq =>
    intro z hz
    rw [smul_eq_mul, mul_comm, mul_smul]
    exact hq _ (smul_apply_mem hX hC hD s z hz)

/-- If every `μ_l(Dₙ)` lies in `R ⊆ Nₙ₊₁`, the span of `G` has components in `D`, and every
element of `G` vanishes in degree `n + 1`, then every element of that span has its degree `n + 1`
component in `R`. -/
private theorem apply_succ_mem_of_mem_span
    (hX : ∀ l (z : ⨁ n, N n), (MvPolynomial.X l : MvPolynomial L A) • z = shift (μ l) z)
    (hC : ∀ (a : A) (z : ⨁ n, N n), (MvPolynomial.C a : MvPolynomial L A) • z = a • z)
    {D : ∀ n, Submodule A (N n)} (hD : ∀ l n x, x ∈ D n → μ l n x ∈ D (n + 1))
    {n : ℕ} {R : Submodule A (N (n + 1))} (hR : ∀ l y, y ∈ D n → μ l n y ∈ R)
    {G : Set (⨁ n, N n)} (hG₀ : ∀ g ∈ G, g (n + 1) = 0)
    (hGD : ∀ w ∈ Submodule.span (MvPolynomial L A) G, ∀ m, w m ∈ D m)
    {w : ⨁ n, N n} (hw : w ∈ Submodule.span (MvPolynomial L A) G) : w (n + 1) ∈ R := by
  induction hw using Submodule.span_induction with
  | mem g hg =>
    rw [hG₀ g hg]
    exact R.zero_mem
  | zero => simp
  | add w w' _ _ hw hw' =>
    rw [DirectSum.add_apply]
    exact R.add_mem hw hw'
  | smul p w hwmem hw =>
    have hsplit : p • w = (MvPolynomial.C (MvPolynomial.constantCoeff p) :
        MvPolynomial L A) • w + (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) • w := by
      rw [← add_smul, add_sub_cancel]
    rw [hsplit, DirectSum.add_apply, hC, DirectSum.smul_apply]
    exact R.add_mem (R.smul_mem _ hw) (apply_succ_mem_of_mem_span_X hX hC hD hR
      (sub_C_constantCoeff_mem_span_X p) w (hGD w hwmem))

end PolynomialModule

/-- **Stable families of submodules are eventually generated in degree one.** Let `A` be
Noetherian, `μ_l : Nₙ → Nₙ₊₁` a finite family of commuting shifts generating each degree from the
previous one, and `N₀` finite. Then for every family of submodules `Dₙ ⊆ Nₙ` with
`μ_l(Dₙ) ⊆ D_(n+1)` there is a `c` such that every element of `D_(n+1)`, `n ≥ c`, is
`∑ₗ μ_l(yₗ)` with all `yₗ ∈ Dₙ`. -/
theorem exists_eventual_sum_shift [IsNoetherianRing A] {L : Type v} [Fintype L]
    [Module.Finite A (N 0)] (μ : L → ∀ n, N n →ₗ[A] N (n + 1))
    (hcomm : ∀ l l' n (x : N n), μ l (n + 1) (μ l' n x) = μ l' (n + 1) (μ l n x))
    (hsurj : ∀ n (x : N (n + 1)), ∃ y : L → N n, x = ∑ l, μ l n (y l))
    (D : ∀ n, Submodule A (N n)) (hD : ∀ l n x, x ∈ D n → μ l n x ∈ D (n + 1)) :
    ∃ c, ∀ n, c ≤ n → ∀ x ∈ D (n + 1),
      ∃ y : L → N n, (∀ l, y l ∈ D n) ∧ x = ∑ l, μ l n (y l) := by
  classical
  let M := ⨁ n, N n
  let T : L → Module.End A M := fun l ↦ shift (μ l)
  have hT : ∀ a ∈ Set.range T, ∀ b ∈ Set.range T, a * b = b * a := by
    rintro _ ⟨l, rfl⟩ _ ⟨l', rfl⟩
    exact shift_mul_shift_comm (hcomm l l')
  have := Algebra.isMulCommutative_adjoin A hT
  let : CommRing (Algebra.adjoin A (Set.range T)) := IsMulCommutative.instCommRing
  let ψ : MvPolynomial L A →ₐ[A] Algebra.adjoin A (Set.range T) :=
    MvPolynomial.aeval fun l ↦ ⟨T l, Algebra.subset_adjoin ⟨l, rfl⟩⟩
  let ρ : MvPolynomial L A →+* Module.End A M :=
    (Algebra.adjoin A (Set.range T)).val.toRingHom.comp ψ.toRingHom
  let : Module (MvPolynomial L A) M := Module.compHom M ρ
  have hsmul (p : MvPolynomial L A) (z : M) : p • z = ρ p z := rfl
  have hX (l : L) (z : M) : (MvPolynomial.X l : MvPolynomial L A) • z = shift (μ l) z := by
    rw [hsmul]
    simp [ρ, ψ, T, MvPolynomial.aeval_X]
  have hC (a : A) (z : M) : (MvPolynomial.C a : MvPolynomial L A) • z = a • z := by
    rw [hsmul]
    simp [ρ, ψ, Module.algebraMap_end_apply]
  have := finite_of_smul_X_eq_shift hX hC hsurj
  have : IsNoetherian (MvPolynomial L A) M := isNoetherian_of_isNoetherianRing_of_finite _ _
  let 𝒟 : Submodule (MvPolynomial L A) M :=
    { carrier := {z | ∀ n, z n ∈ D n}
      zero_mem' := fun n ↦ by simp
      add_mem' := fun hx hy n ↦ by
        rw [DirectSum.add_apply]
        exact (D n).add_mem (hx n) (hy n)
      smul_mem' := fun p z hz ↦ smul_apply_mem hX hC hD p z hz }
  obtain ⟨G, hG⟩ := IsNoetherian.noetherian 𝒟
  obtain ⟨c, hc⟩ := exists_forall_le_apply_eq_zero G
  refine ⟨c, fun n hn x hx ↦ ?_⟩
  let Φ : (L → D n) →ₗ[A] N (n + 1) :=
    ∑ l, (μ l n).comp ((D n).subtype.comp (LinearMap.proj l))
  have hΦ (y : L → D n) : Φ y = ∑ l, μ l n (y l) := by
    simp [Φ, LinearMap.sum_apply]
  have hR (l : L) (y : N n) (hy : y ∈ D n) : μ l n y ∈ LinearMap.range Φ := by
    refine ⟨Pi.single l ⟨y, hy⟩, ?_⟩
    rw [hΦ, Finset.sum_eq_single l (fun b _ hb ↦ by simp [hb]) (by simp)]
    simp
  have hGD (w : M) (hw : w ∈ Submodule.span (MvPolynomial L A) (G : Set M)) :
      ∀ m, w m ∈ D m :=
    (hG ▸ hw : w ∈ 𝒟)
  have hx𝒟 : DirectSum.lof A ℕ N (n + 1) x ∈ 𝒟 := lof_apply_mem hx
  have hxr := apply_succ_mem_of_mem_span hX hC hD hR (G := (G : Set M))
    (fun g hg ↦ hc g hg (n + 1) (by omega)) hGD (hG.symm ▸ hx𝒟)
  rw [DirectSum.lof_eq_of, DirectSum.of_eq_same] at hxr
  obtain ⟨y, hy⟩ := hxr
  exact ⟨fun l ↦ y l, fun l ↦ (y l).2, by rw [← hy, hΦ]⟩

end Stacks.CommutingShifts

end
