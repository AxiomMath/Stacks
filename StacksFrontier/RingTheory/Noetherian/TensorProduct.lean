module

public import StacksFrontier.RingTheory.Noetherian.Spec
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Noetherianity of a base change along a finitely generated field extension

Let `k` be a field and `R` a Noetherian `k`-algebra. If `K/k` is a finitely
generated field extension then `K ⊗[k] R` is Noetherian. All rings are
commutative with unit, and a `k`-algebra is a commutative ring with an
`Algebra k _` structure, not assumed of finite type.

A ring is Noetherian when every ascending chain of ideals stabilizes,
equivalently when every ideal is finitely generated; this is `IsNoetherianRing`.

An extension `K/k` is finitely generated *as a field* when there are finitely
many `x₁, …, xₙ ∈ K` with `K = k(x₁, …, xₙ)`, the smallest subfield containing
the image of `k` and the `xᵢ`. Inverses are allowed, so this is strictly weaker
than `K` being finitely generated as a `k`-algebra: `k(t)` is finitely generated
as a field but not as an algebra. The field-theoretic adjunction is
`IntermediateField.adjoin`, and finite generation as a field is expressed by
`(⊤ : IntermediateField k K).FG`, that is, some `Finset s` has
`IntermediateField.adjoin k s = ⊤`. The tensor product of `k`-algebras is
`TensorProduct k K R`, written `K ⊗[k] R`.

The proof: the finite field generators generate a finite-type `k`-subalgebra
`A ⊆ K` of which `K` is a localization. Then `A ⊗[k] R` is a finite-type, hence
Noetherian, `R`-algebra by the Hilbert basis theorem, and `K ⊗[k] R` is a
localization of `A ⊗[k] R`, hence Noetherian.
-/

@[expose] public section

open scoped TensorProduct

/-- **Tensor-product cancellation isomorphism.** For a field `k`, a `k`-algebra
`R`, a field `K` over `k`, and a `k`-subalgebra `A ⊆ K`, there is a canonical
`k`-algebra isomorphism `(A ⊗[k] R) ⊗[A] K ≃ₐ[k] K ⊗[k] R`.

Mathematical argument: this is associativity/commutativity of tensor products
together with cancellation of a base change.  Concretely
`(A ⊗[k] R) ⊗[A] K ≃ K ⊗[A] (A ⊗[k] R)` (commutativity over `A`,
`Algebra.TensorProduct.comm`) and `K ⊗[A] (A ⊗[k] R) ≃ K ⊗[k] R`
(cancellation of the base change `A ⊗[k] R = A ⊗[k] R` against `K` over `A`,
`Algebra.TensorProduct.cancelBaseChange k A K K R`); composing gives the desired
`k`-algebra equivalence.  (An `AlgEquiv` is used rather than a bare `RingEquiv`
so that `.toRingEquiv` carries the canonical semiring-derived `Mul`, matching the
hypotheses of `isNoetherianRing_of_ringEquiv` under
`backward.isDefEq.respectTransparency false`.) -/
noncomputable def tensorTensor_cancelBaseChange_algEquiv
    (k : Type*) [Field k]
    (R : Type*) [CommRing R] [Algebra k R]
    (K : Type*) [Field K] [Algebra k K]
    (A : Subalgebra k K) :
    ((A ⊗[k] R) ⊗[A] K) ≃ₐ[k] (K ⊗[k] R) := by
  -- `comm` lives over `A` and `cancelBaseChange k A K K R` lives over `K` (its `T = K`);
  -- both must be `.restrictScalars k`-ed before `.trans` to land in `≃ₐ[k]`.  The required
  -- `IsScalarTower k A _`, `IsScalarTower k K _` instances are available, within the default
  -- `synthInstance.maxHeartbeats` budget.
  exact
    ((Algebra.TensorProduct.comm A (A ⊗[k] R) K).restrictScalars k).trans
      ((Algebra.TensorProduct.cancelBaseChange k A K K R).restrictScalars k)

/-- **Stacks Tag 045I.** Let `k` be a field and `R` a Noetherian commutative
`k`-algebra. If `K/k` is a finitely generated field extension (finitely
generated *as a field*, expressed by `(⊤ : IntermediateField k K).FG`), then the
`k`-algebra `K ⊗[k] R` is Noetherian. -/
@[stacks 045I,
  ega "IV 4.7.3" "(i), special case",
  ega "IV 6.7.1" "Affine X, special case",
  ega "IV 6.7.1.1" "more general", sga "1 III 1.4" "special case", sga "5 V 5.1.5" "special case"]
theorem tensorProduct_isNoetherianRing_of_finitelyGenerated_fieldExtension
    (k : Type*) [Field k]
    (R : Type*) [CommRing R] [Algebra k R] [IsNoetherianRing R]
    (K : Type*) [Field K] [Algebra k K]
    (hK : (⊤ : IntermediateField k K).FG) :
    IsNoetherianRing (K ⊗[k] R) := by
  classical
  obtain ⟨s, hs⟩ := hK
  -- The finite-type `k`-subalgebra generated by `s`.
  set A : Subalgebra k K := Algebra.adjoin k (↑s : Set K) with hA
  -- `A` is finitely generated, hence finite type, hence Noetherian.
  have hAfg : (Algebra.adjoin k (↑s : Set K)).FG := Subalgebra.fg_adjoin_finset s
  have hAft : Algebra.FiniteType k A := (Subalgebra.fg_iff_finiteType A).mp hAfg
  have hANoeth : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  -- `K` is the fraction field of `A` (every element of `K` is a ratio of
  -- elements of `A`, since `K = k(s)` and `A = k[s]`).
  have hfrac : IsFractionRing A K := by
    refine IsFractionRing.of_field A K ?_
    intro z
    have hz : z ∈ IntermediateField.adjoin k (↑s : Set K) := by
      rw [hs]; exact IntermediateField.mem_top
    rw [IntermediateField.mem_adjoin_iff_div] at hz
    obtain ⟨r, hr, t, ht, hzeq⟩ := hz
    exact ⟨⟨r, hr⟩, ⟨t, ht⟩, by simpa using hzeq⟩
  -- Step 2: `A ⊗[k] R` is Noetherian: it is the base change of the Noetherian
  -- ring `R` along the finite-type `k`-algebra `A`, so it is a finite-type
  -- `R`-algebra and Noetherian by the Hilbert basis theorem (Stacks 00FN/0CY6,
  -- packaged as `noetherian_base_change_finite_type`).
  have hBNoeth : IsNoetherianRing (A ⊗[k] R) := noetherian_base_change_finite_type k A R
  -- Step 3: `(A ⊗[k] R) ⊗[A] K` is the localization of `A ⊗[k] R` at the image
  -- of `nonZeroDivisors A` (tensor product commutes with localization:
  -- `IsLocalization.tensor`, using `IsFractionRing A K` i.e.
  -- `IsLocalization (nonZeroDivisors A) K`).
  have hloc :
      IsLocalization (Algebra.algebraMapSubmonoid (A ⊗[k] R) (nonZeroDivisors A))
        ((A ⊗[k] R) ⊗[A] K) :=
    IsLocalization.tensor K (nonZeroDivisors A)
  -- Hence `(A ⊗[k] R) ⊗[A] K` is Noetherian (a localization of a Noetherian ring
  -- is Noetherian: `IsLocalization.isNoetherianRing`).
  have hCNoeth : IsNoetherianRing ((A ⊗[k] R) ⊗[A] K) :=
    IsLocalization.isNoetherianRing
      (Algebra.algebraMapSubmonoid (A ⊗[k] R) (nonZeroDivisors A)) ((A ⊗[k] R) ⊗[A] K) hBNoeth
  -- Step 4: transport Noetherianity across the canonical isomorphism
  -- `(A ⊗[k] R) ⊗[A] K ≃ₐ[k] K ⊗[k] R` (tensor-product cancellation, the named
  -- lemma `tensorTensor_cancelBaseChange_algEquiv`), since `IsNoetherianRing`
  -- transports along ring equivalences (`isNoetherianRing_of_ringEquiv`).
  have hiso : ((A ⊗[k] R) ⊗[A] K) ≃ₐ[k] (K ⊗[k] R) :=
    tensorTensor_cancelBaseChange_algEquiv k R K A
  -- Transport Noetherianity along the underlying ring equivalence of `hiso`.
  exact isNoetherianRing_of_ringEquiv _ hiso.toRingEquiv
