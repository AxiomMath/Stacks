/-!
# Extending and perturbing systems of parameters

Let `R` be a Noetherian local ring and let `f` be an element of its maximal ideal lying in no
minimal prime of `R`. This file shows that `f` can be completed to a system of parameters
`f, g₁, …, g_{d-1}`, with the `gᵢ` taken in any prescribed power of the maximal ideal, and that
the completion can be arranged so that replacing `f` by `f + h` for `h` in a sufficiently high
power of the maximal ideal again gives a system of parameters and does not change the length of
the quotient it defines.

## Main definitions

No new definitions are introduced. Systems of parameters are expressed using
`IsLocalRing.IsSystemOfParameters`, and the ideal generated by a list of ring elements by
`Ideal.ofList`.

## Main results

* `exists_isSystemOfParameters_cons_of_avoids_minimalPrimes`: extension of `f` to a system of
  parameters whose remaining entries lie in a prescribed power of the maximal ideal.
* `exists_isSystemOfParameters_pair_add_of_avoids_minimalPrimes`: the dimension-two form, together
  with invariance of the quotient length under high-order perturbation of `f`.
* `exists_isSystemOfParameters_cons_stable_under_add_of_avoids_minimalPrimes`: the same
  perturbation statement in arbitrary dimension.

## Implementation notes

The source's sequence `g₁, …, g_{d-1}` is represented by a list of length `d - 1`, so that
adjoining `f` at the front is list `cons` and the length of the whole list is literally the
dimension of the ring. Membership in `m ^ k` is imposed entrywise.

## References

* [Stacks, Tag 0BWU](https://stacks.math.columbia.edu/tag/0BWU)
* [Stacks, Tag 0BWV](https://stacks.math.columbia.edu/tag/0BWV)
* [Stacks, Tag 0BWY](https://stacks.math.columbia.edu/tag/0BWY)
-/

@[expose] public section

open IsLocalRing

section ParameterSystemExtension

@[ega "0 16.2.5" "partial"]
private theorem exists_isSystemOfParameters_of_ringKrullDim_eq
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (e : ℕ) (he : ringKrullDim A = e) :
    ∃ xs : List A, xs.length = e ∧ IsSystemOfParameters xs := by
  classical
  obtain ⟨s, hs, hcard⟩ :=
    Ideal.exists_finset_card_eq_height_of_isNoetherianRing (maximalIdeal A)
  let xs := s.toList
  have hlen : xs.length = e := by
    have hcard' : ((s.card : ℕ∞) : WithBot ℕ∞) = ringKrullDim A := by
      rw [hcard, maximalIdeal_height_eq_ringKrullDim]
    rw [he] at hcard'
    simpa [xs] using (by exact_mod_cast hcard' : s.card = e)
  refine ⟨xs, hlen, ?_, ?_⟩
  · rw [show Ideal.ofList xs = Ideal.span (s : Set A) by simp [xs, Ideal.ofList],
      Ideal.radical_eq_sInf]
    exact le_antisymm (sInf_le ⟨hs.1.2, (maximalIdeal.isMaximal A).isPrime⟩)
      (le_sInf fun J hJ ↦ hs.2 ⟨hJ.2, hJ.1⟩ (le_maximalIdeal hJ.2.ne_top))
  · simpa [hlen] using he

private theorem radical_ofList_map_pow (A : Type*) [CommRing A] (xs : List A) (n : ℕ)
    (hn : n ≠ 0) :
    (Ideal.ofList (xs.map (· ^ n))).radical = (Ideal.ofList xs).radical := by
  apply le_antisymm
  · rw [Ideal.radical_le_radical_iff, Ideal.ofList, Submodule.span_le]
    intro x hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    exact Ideal.le_radical
      ((Ideal.ofList xs).pow_mem_of_mem (Ideal.subset_span hy) n (Nat.pos_of_ne_zero hn))
  · rw [Ideal.radical_le_radical_iff, Ideal.ofList, Submodule.span_le]
    intro x hx
    exact ⟨n, Ideal.subset_span (List.mem_map.mpr ⟨x, hx, rfl⟩)⟩

private theorem exists_isSystemOfParameters_cons_mem_maximalIdeal
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (d : ℕ) (hdim : ringKrullDim R = d) (f : R) (hf : f ∈ maximalIdeal R)
    (hfmin : ∀ p ∈ minimalPrimes R, f ∉ p) :
    ∃ gs : List R, gs.length = d - 1 ∧ (∀ g ∈ gs, g ∈ maximalIdeal R) ∧
      IsSystemOfParameters (f :: gs) := by
  let I : Ideal R := Ideal.span {f}
  have hItop : I ≠ ⊤ := ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top <|
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hf)
  let S := R ⧸ I
  let q : R →+* S := Ideal.Quotient.mk I
  let : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr hItop
  let : IsLocalRing S := IsLocalRing.of_surjective' q Ideal.Quotient.mk_surjective
  have hann : ∀ p ∈ (Module.annihilator R R).minimalPrimes, f ∉ p := by
    rw [Module.annihilator_eq_bot.mpr (inferInstance : FaithfulSMul R R)]
    exact hfmin
  have hdrop := Module.supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal
    (M := R) hann hf
  have hquot : Module.supportDim R (QuotSMulTop f R) = ringKrullDim S := by
    calc
      _ = Module.supportDim R (R ⧸ (I : Submodule R R)) :=
        Module.supportDim_eq_of_equiv <| Submodule.quotEquivOfEq _ _ <| by
          rw [← Submodule.ideal_span_singleton_smul]
          simp
          rfl
      _ = ringKrullDim S := Module.supportDim_quotient_eq_ringKrullDim I
  rw [Module.supportDim_self_eq_ringKrullDim, hquot, hdim] at hdrop
  obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp (ringKrullDim_ne_bot (R := S))
  rw [← he] at hdrop
  norm_cast at hdrop
  have hd0 : d ≠ 0 := by
    intro hd
    subst d
    simp at hdrop
  have he' : e = ((d - 1 : ℕ) : ℕ∞) := by
    have hdcast : (d : ℕ∞) = (d - 1 : ℕ) + 1 := by
      norm_cast
      omega
    exact ENat.add_left_injective_of_ne_top (n := (1 : ℕ∞)) (by simp) (hdrop.trans hdcast)
  have hsDim : ringKrullDim S = ((d - 1 : ℕ) : WithBot ℕ∞) := by
    rw [← he, he']
    rfl
  obtain ⟨ys, hyslen, hys⟩ :=
    exists_isSystemOfParameters_of_ringKrullDim_eq (A := S) (d - 1) hsDim
  have hqmax : Ideal.map q (maximalIdeal R) = maximalIdeal S :=
    IsLocalRing.map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective
  have hy_lift : ∀ y ∈ ys, ∃ x ∈ maximalIdeal R, q x = y := by
    intro y hy
    have : y ∈ maximalIdeal S := hys.1 ▸ Ideal.le_radical (Ideal.subset_span hy)
    rw [← hqmax] at this
    exact (Ideal.mem_map_iff_of_surjective q Ideal.Quotient.mk_surjective).mp this
  choose lift hlift_mem hlift_q using hy_lift
  let gs := ys.attach.map fun y ↦ lift y.1 y.2
  have hmap : gs.map q = ys := by simp [gs, hlift_q]
  refine ⟨gs, by simp [gs, hyslen], ?_, ?_⟩
  · intro g hg
    simp only [gs, List.mem_map, List.mem_attach] at hg
    obtain ⟨y, -, rfl⟩ := hg
    exact hlift_mem y.1 y.2
  · constructor
    · rw [Ideal.ofList_cons]
      have hker : RingHom.ker q ≤ Ideal.span {f} ⊔ Ideal.ofList gs := by
        rw [Ideal.mk_ker]
        exact le_sup_left
      have hcomap : Ideal.comap q
          (Ideal.map q (Ideal.span {f} ⊔ Ideal.ofList gs).radical) =
          (Ideal.span {f} ⊔ Ideal.ofList gs).radical := by
        rw [Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
          ← RingHom.ker_eq_comap_bot, sup_of_le_left (hker.trans Ideal.le_radical)]
      rw [← hcomap, Ideal.map_radical_of_surjective Ideal.Quotient.mk_surjective hker,
        Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_ofList, hmap,
        hys.1, ← hqmax]
      rw [Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot]
      exact sup_of_le_left (by rw [Ideal.mk_ker]; exact Ideal.span_le.mpr <|
        Set.singleton_subset_iff.mpr hf)
    · rw [List.length_cons, show gs.length = d - 1 by simp [gs, hyslen]]
      simpa [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hd0)] using hdim

/-- **Stacks 0BWU.** In a Noetherian local ring of dimension `d > 1`, an element `f` of
the maximal ideal which belongs to no minimal prime extends to a system of parameters
`f, g₁, ..., g_{d-1}`, with every `gᵢ` lying in the prescribed power `m ^ k`. -/
@[stacks 0BWU]
theorem exists_isSystemOfParameters_cons_of_avoids_minimalPrimes
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (d : ℕ) (hdim : ringKrullDim R = d) (hd : 1 < d)
    (f : R) (hf : f ∈ maximalIdeal R)
    (hfmin : ∀ p ∈ minimalPrimes R, f ∉ p) (k : ℕ) :
    ∃ gs : List R,
      gs.length = d - 1 ∧
        (∀ g ∈ gs, g ∈ maximalIdeal R ^ k) ∧
          IsSystemOfParameters (f :: gs) := by
  obtain ⟨xs, hxslen, hxsmax, hxs⟩ :=
    exists_isSystemOfParameters_cons_mem_maximalIdeal d hdim f hf hfmin
  let n := max 1 k
  refine ⟨xs.map (· ^ n), by simp [hxslen], ?_, ?_, by simpa [hxslen, hd.le] using hxs.2⟩
  · intro g hg
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hg
    exact Ideal.pow_le_pow_right (Nat.le_max_right 1 k) <|
      Ideal.pow_mem_pow (hxsmax x hx) n
  · rw [Ideal.ofList_cons, Ideal.radical_sup, radical_ofList_map_pow R xs n (by simp [n]),
      ← Ideal.radical_sup, ← Ideal.ofList_cons]
    exact hxs.1

end ParameterSystemExtension

section DimensionTwoPerturbation

private theorem ofList_cons_add_eq_of_sub_mem {R : Type*} [CommRing R] [IsLocalRing R]
    (f : R) (gs : List R) (a h : R) (ha : a ∈ maximalIdeal R)
    (hh : h - a * f ∈ Ideal.ofList gs) :
    Ideal.ofList ((f + h) :: gs) = Ideal.ofList (f :: gs) := by
  have hu : IsUnit (1 + a) := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hm
    have : (1 : R) ∈ maximalIdeal R := by
      convert (maximalIdeal R).sub_mem hm ha using 1
      ring
    exact (maximalIdeal.isMaximal R).ne_top ((maximalIdeal R).eq_top_iff_one.mpr this)
  rw [Ideal.ofList_cons, Ideal.ofList_cons]
  have heq : Ideal.span {f + h} ⊔ Ideal.ofList gs =
      Ideal.span {(1 + a) * f} ⊔ Ideal.ofList gs := by
    apply le_antisymm <;> apply sup_le
    · rw [Ideal.span_le, Set.singleton_subset_iff, show f + h = (1 + a) * f + (h - a * f) by ring]
      exact add_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)) (Ideal.mem_sup_right hh)
    · exact le_sup_right
    · rw [Ideal.span_le, Set.singleton_subset_iff,
        show (1 + a) * f = (f + h) - (h - a * f) by ring]
      exact sub_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)) (Ideal.mem_sup_right hh)
    · exact le_sup_right
  rw [heq, Ideal.span_singleton_mul_left_unit hu]

private theorem exists_pow_forall_isSystemOfParameters_cons_add
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (f : R) (gs : List R) (hs : IsSystemOfParameters (f :: gs)) :
    ∃ N : ℕ, ∀ h ∈ maximalIdeal R ^ N,
      IsSystemOfParameters ((f + h) :: gs) ∧
        Module.length R (R ⧸ Ideal.ofList (f :: gs)) =
          Module.length R (R ⧸ Ideal.ofList ((f + h) :: gs)) := by
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg
    (I := maximalIdeal R) (J := Ideal.ofList (f :: gs)) hs.1.ge
    (maximalIdeal R).fg_of_isNoetherianRing
  refine ⟨n + 1, fun h hh ↦ ?_⟩
  have hh' : h ∈ maximalIdeal R * Ideal.ofList (f :: gs) := by
    rw [pow_succ'] at hh
    exact Ideal.mul_mono le_rfl hn hh
  rw [Ideal.ofList_cons, Ideal.mul_sup, mul_comm (maximalIdeal R) (Ideal.span {f}),
    Submodule.mem_sup] at hh'
  obtain ⟨x, hx, y, hy, hxy⟩ := hh'
  obtain ⟨a, ha, hax⟩ := Ideal.mem_span_singleton_mul.mp hx
  have hrest : h - a * f ∈ Ideal.ofList gs := by
    rw [← hxy, ← hax]
    simpa [mul_comm] using (Ideal.mul_le_right hy : y ∈ Ideal.ofList gs)
  have hideal := ofList_cons_add_eq_of_sub_mem f gs a h ha hrest
  exact ⟨⟨by simpa [hideal] using hs.1, by simpa using hs.2⟩, by rw [hideal]⟩

/-- **Stacks 0BWV.** In a two-dimensional Noetherian local ring, an element `f` of the maximal
ideal which belongs to no minimal prime can be completed by an element `g` to a system of
parameters. For every sufficiently high-order perturbation `f + h`, the pair `f + h, g` remains a
system of parameters and defines a quotient of the same length as the quotient defined by
`f, g`. -/
@[stacks 0BWV]
theorem exists_isSystemOfParameters_pair_add_of_avoids_minimalPrimes
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (hdim : ringKrullDim R = 2) (f : R) (hf : f ∈ maximalIdeal R)
    (hfmin : ∀ p ∈ minimalPrimes R, f ∉ p) :
    ∃ g ∈ maximalIdeal R, ∃ N : ℕ,
      IsSystemOfParameters [f, g] ∧
        ∀ h ∈ maximalIdeal R ^ N,
          IsSystemOfParameters [f + h, g] ∧
            Module.length R (R ⧸ Ideal.ofList [f, g]) =
              Module.length R (R ⧸ Ideal.ofList [f + h, g]) := by
  obtain ⟨gs, hlen, hgsm, hsop⟩ :=
    exists_isSystemOfParameters_cons_mem_maximalIdeal 2 hdim f hf hfmin
  obtain ⟨g, rfl⟩ := List.length_eq_one_iff.mp (by simpa using hlen)
  obtain ⟨N, hN⟩ := exists_pow_forall_isSystemOfParameters_cons_add f [g] hsop
  exact ⟨g, hgsm g (by simp), N, hsop, hN⟩

end DimensionTwoPerturbation

section ParameterSystemPerturbation

/-- **Stacks 0BWY.** A parameter in the maximal ideal of a Noetherian local ring which avoids all
minimal primes can be completed to a system of parameters such that perturbing the parameter by
an element of a sufficiently high power of the maximal ideal preserves both the parameter system
and the length of its quotient. -/
@[stacks 0BWY]
theorem exists_isSystemOfParameters_cons_stable_under_add_of_avoids_minimalPrimes
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (d : ℕ) (hdim : ringKrullDim R = d)
    (f : R) (hf : f ∈ maximalIdeal R)
    (hfmin : ∀ p ∈ minimalPrimes R, f ∉ p) :
    ∃ gs : List R, ∃ N : ℕ,
      gs.length = d - 1 ∧
        (∀ g ∈ gs, g ∈ maximalIdeal R) ∧
          IsSystemOfParameters (f :: gs) ∧
            ∀ h ∈ maximalIdeal R ^ N,
              IsSystemOfParameters ((f + h) :: gs) ∧
                Module.length R (R ⧸ Ideal.ofList (f :: gs)) =
                  Module.length R (R ⧸ Ideal.ofList ((f + h) :: gs)) := by
  obtain ⟨gs, hlen, hg, hs⟩ := exists_isSystemOfParameters_cons_mem_maximalIdeal d hdim f hf hfmin
  obtain ⟨N, hN⟩ := exists_pow_forall_isSystemOfParameters_cons_add f gs hs
  exact ⟨gs, N, hlen, hg, hs, hN⟩

end ParameterSystemPerturbation
