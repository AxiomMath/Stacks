/-!
# Lengths of parameter quotients

Let `R` be a Noetherian local ring. This file collects the estimates that compare the length of a
quotient `R / I`, for `I` a principal ideal or an ideal generated by a system of parameters, with
the discrete invariants of `R`: the growth in `n` of the lengths of `R / x ^ n R`, the number of
minimal primes of `R`, the number of those minimal primes of full dimension, and the multiplicity
read off the leading coefficient of the Hilbert–Samuel polynomial of `I`. These are the numerical
input for the existence of principal radical ideals.

## Main definitions

No new definitions are introduced. Systems of parameters are expressed using
`IsLocalRing.IsSystemOfParameters`, and the ideal generated by a list of ring elements by
`Ideal.ofList`.

## Main results

* `length_quotient_span_pow_le_and_eq_of_mem_nonZeroDivisors`: in dimension one, the lengths of
  `R / x ^ n R` are finite and grow at most linearly in `n`, exactly linearly when `x` is a
  non-zero-divisor.
* `natCard_minimalPrimes_le_length_quotient_span_singleton`: in dimension one, the number of
  minimal primes is at most the length of `R / x R` for `x` avoiding every minimal prime.
* `multiplicity_le_length_quotient_of_isSystemOfParameters`: the multiplicity `e` read off the
  leading coefficient `e / d !` of the Hilbert–Samuel polynomial of a parameter ideal is at most
  the length of its quotient.
* `natCard_fullDimensionalMinimalPrimes_le_length_quotient_of_isSystemOfParameters`: the number of
  minimal primes `p` with `dim (R / p) = dim R` is at most the length of a parameter quotient.

## Implementation notes

Module lengths take values in `ℕ∞`, so finiteness is always asserted explicitly and the
natural-number lengths of the source appear as the `ℕ∞`-valued `Module.length`. Sequences of
parameters are lists rather than indexed families, so that the length of the list is literally the
dimension of the ring.

## References

* [Stacks, Tag 0BWS](https://stacks.math.columbia.edu/tag/0BWS)
* [Stacks, Tag 0BWT](https://stacks.math.columbia.edu/tag/0BWT)
* [Stacks, Tag 0BWW](https://stacks.math.columbia.edu/tag/0BWW)
* [Stacks, Tag 0BWX](https://stacks.math.columbia.edu/tag/0BWX)
-/

@[expose] public section

open IsLocalRing
open Stacks.HilbertSamuel.DimensionTheorem
  (length_quotient_le_add length_quotient_smul_top length_quotient_sup_eq)

section PrincipalPowerLengths

open Pointwise

/-- A parameter avoiding every minimal prime has a finite-length quotient. Its support is
the single closed point of the local spectrum. -/
private theorem length_quotient_span_singleton_ne_top_of_krullDimLE_one
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (hdim : Ring.KrullDimLE 1 R) {x : R}
    (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hx_min : ∀ p ∈ minimalPrimes R, x ∉ p) :
    Module.length R (R ⧸ Ideal.span {x}) ≠ ⊤ := by
  have hsupport : Module.support R (R ⧸ Ideal.span {x}) =
      {IsLocalRing.closedPoint R} := by
    rw [Module.support_eq_zeroLocus, Ideal.annihilator_quotient]
    ext q
    constructor
    · intro hq
      have hxq : x ∈ q.asIdeal := hq (Ideal.subset_span (Set.mem_singleton x))
      rcases (Ring.krullDimLE_one_iff.mp hdim) q.asIdeal q.isPrime with hmin | hmax
      · exact (hx_min q.asIdeal hmin hxq).elim
      · exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
    · intro hq
      have hqeq : q = IsLocalRing.closedPoint R := by simpa using hq
      subst q
      intro y hy
      exact (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx)) hy
  exact Module.length_ne_top_iff.mpr (isFiniteLength_of_support hsupport)

/-- Multiplying `(x ^ n)` by `x` gives `(x ^ (n + 1))`. -/
private lemma smul_span_pow_eq {R : Type*} [CommRing R] (x : R) (n : ℕ) :
    x • Ideal.span {x ^ n} = Ideal.span {x ^ (n + 1)} := by
  rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.span_mul_span]
  simp [pow_succ']

private lemma length_quotient_span_pow_succ_le
    {R : Type*} [CommRing R] (x : R) (n : ℕ) :
    Module.length R (R ⧸ Ideal.span {x ^ (n + 1)}) ≤
      Module.length R (R ⧸ Ideal.span {x ^ n}) +
        Module.length R (R ⧸ Ideal.span {x}) := by
  let I : Ideal R := Ideal.span {x ^ n}
  let f := Ideal.mulQuot x I
  let g := Ideal.quotOfMul x I
  have hlen := Module.length_eq_add_of_exact (LinearMap.ker g).subtype g
    (Submodule.subtype_injective _) (Ideal.quotOfMul_surjective I)
    (LinearMap.exact_subtype_ker_map g)
  have hker : Module.length R (LinearMap.ker g) ≤ Module.length R (R ⧸ I) := by
    rw [(Ideal.exact_mulQuot_quotOfMul I : Function.Exact f g).linearMap_ker_eq]
    exact Module.length_le_of_surjective f.rangeRestrict
      (LinearMap.surjective_rangeRestrict f)
  have hlen' : Module.length R (R ⧸ Ideal.span {x ^ (n + 1)}) =
      Module.length R (LinearMap.ker g) + Module.length R (R ⧸ Ideal.span {x}) := by
    rwa [← smul_span_pow_eq]
  rw [hlen']
  show _ ≤ Module.length R (R ⧸ I) + _
  exact add_le_add hker le_rfl

private lemma length_quotient_span_pow_succ_eq
    {R : Type*} [CommRing R] (x : R) (hx : x ∈ nonZeroDivisors R) (n : ℕ) :
    Module.length R (R ⧸ Ideal.span {x ^ (n + 1)}) =
      Module.length R (R ⧸ Ideal.span {x ^ n}) +
        Module.length R (R ⧸ Ideal.span {x}) := by
  have h := Module.length_eq_add_of_exact
    (Ideal.mulQuot x (Ideal.span {x ^ n})) (Ideal.quotOfMul x (Ideal.span {x ^ n}))
    (Ideal.mulQuot_injective _ hx) (Ideal.quotOfMul_surjective _)
    (Ideal.exact_mulQuot_quotOfMul _)
  rwa [← smul_span_pow_eq]

/-- **Stacks 0BWS.** The quotients by powers of a parameter in a one-dimensional Noetherian
local ring have finite length. Their lengths grow at most linearly, and grow exactly linearly
when the parameter is a non-zero-divisor. -/
@[stacks 0BWS, ega "IV 21.10.13" "(i) for M=A"]
theorem length_quotient_span_pow_le_and_eq_of_mem_nonZeroDivisors
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (hdim : ringKrullDim R = 1) {x : R}
    (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hx_min : ∀ p ∈ minimalPrimes R, x ∉ p) :
    let P : ℕ → ℕ∞ := fun n ↦ Module.length R (R ⧸ Ideal.span {x ^ n})
    (∀ n, P n ≠ ⊤) ∧
      (∀ n, P n ≤ (n : ℕ∞) * P 1) ∧
      (x ∈ nonZeroDivisors R → ∀ n, P n = (n : ℕ∞) * P 1) := by
  let P : ℕ → ℕ∞ := fun n ↦ Module.length R (R ⧸ Ideal.span {x ^ n})
  have hP1' : P 1 = Module.length R (R ⧸ Ideal.span {x}) :=
    congrArg (fun y => Module.length R (R ⧸ Ideal.span {y})) (pow_one x)
  have hP1 : P 1 ≠ ⊤ := by
    rw [hP1']
    exact length_quotient_span_singleton_ne_top_of_krullDimLE_one
      (Ring.krullDimLE_iff.mpr hdim.le) hx hx_min
  have hle : ∀ n, P n ≤ (n : ℕ∞) * P 1 := by
    intro n
    induction n with
    | zero => simp [P]
    | succ n ih =>
      calc
        P (n + 1) ≤ P n + P 1 := by
          rw [hP1']
          exact length_quotient_span_pow_succ_le x n
        _ ≤ (n : ℕ∞) * P 1 + P 1 := add_le_add ih le_rfl
        _ = ((n + 1 : ℕ) : ℕ∞) * P 1 := by simp [Nat.cast_add, add_mul]
  have hfin : ∀ n, P n ≠ ⊤ := fun n ↦
    ne_top_of_le_ne_top (WithTop.mul_ne_top (ENat.natCast_ne_top n) hP1) (hle n)
  refine ⟨hfin, hle, fun hxreg n ↦ ?_⟩
  induction n with
  | zero => simp
  | succ n ih =>
    change P n = (n : ℕ∞) * P 1 at ih
    calc
      P (n + 1) = P n + P 1 := by
        rw [hP1']
        exact length_quotient_span_pow_succ_eq x hxreg n
      _ = (n : ℕ∞) * P 1 + P 1 := by rw [ih]
      _ = ((n + 1 : ℕ) : ℕ∞) * P 1 := by simp [Nat.cast_add, add_mul]

end PrincipalPowerLengths

section MinimalPrimeCount

open Pointwise

private theorem length_pi_quotient_smul
    {R : Type*} [CommRing R] {ι : Type*} [Fintype ι]
    (M : ι → Type*) [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)] (x : R) :
    Module.length R ((∀ i, M i) ⧸ (x • (⊤ : Submodule R (∀ i, M i)))) =
      ∑ i, Module.length R (M i ⧸ (x • (⊤ : Submodule R (M i)))) := by
  classical
  have hsub : x • (⊤ : Submodule R (∀ i, M i)) =
      Submodule.pi Set.univ (fun i => x • (⊤ : Submodule R (M i))) := by
    ext b
    simp only [Submodule.mem_pi, Set.mem_univ, forall_const]
    constructor
    · intro hb i
      obtain ⟨c, _, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hb
      exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨c i, Submodule.mem_top, rfl⟩
    · intro hb
      choose c hc using fun i => (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp (hb i)
      exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr
        ⟨c, Submodule.mem_top, funext fun i ↦ (hc i).2⟩
  rw [hsub, (Submodule.quotientPi (fun i => x • (⊤ : Submodule R (M i)))).length_eq]
  exact Module.length_pi_of_fintype R _

private theorem one_le_length_quotient_prime
    {R : Type*} [CommRing R] [IsLocalRing R]
    {x : R} (hx : x ∈ IsLocalRing.maximalIdeal R)
    {p : Ideal R} (hp : p.IsPrime) :
    (1 : ℕ∞) ≤ Module.length R ((R ⧸ p) ⧸ (x • (⊤ : Submodule R (R ⧸ p)))) := by
  let : p.IsPrime := hp
  have : Nontrivial (R ⧸ p) := inferInstance
  have : Module.Finite R (R ⧸ p) := inferInstance
  have : Nontrivial ((R ⧸ p) ⧸ (x • (⊤ : Submodule R (R ⧸ p)))) :=
    nontrivial_quotSMulTop_of_mem_maximalIdeal (R ⧸ p) hx
  exact Order.one_le_iff_pos.mpr Module.length_pos

private theorem card_minimalPrimes_le_length_pi_quotient_smul
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {x : R} (hx : x ∈ IsLocalRing.maximalIdeal R) :
    (Nat.card (minimalPrimes R) : ℕ∞) ≤
      Module.length R ((∀ p : {p : Ideal R // p ∈ minimalPrimes R}, R ⧸ p.1) ⧸
        (x • (⊤ : Submodule R (∀ p : {p : Ideal R // p ∈ minimalPrimes R}, R ⧸ p.1)))) := by
  let : Fintype {p : Ideal R // p ∈ minimalPrimes R} :=
    (minimalPrimes.finite_of_isNoetherianRing R).fintype
  rw [length_pi_quotient_smul]
  calc
    (Nat.card (minimalPrimes R) : ℕ∞) =
        ∑ p : {p : Ideal R // p ∈ minimalPrimes R}, (1 : ℕ∞) := by
      rw [Nat.card_eq_fintype_card]
      show (Fintype.card {p : Ideal R // p ∈ minimalPrimes R} : ℕ∞) =
        ∑ _ : {p : Ideal R // p ∈ minimalPrimes R}, 1
      simp
    _ ≤ ∑ p : {p : Ideal R // p ∈ minimalPrimes R},
        Module.length R ((R ⧸ p.1) ⧸ (x • (⊤ : Submodule R (R ⧸ p.1)))) :=
      Finset.sum_le_sum fun p _ ↦ one_le_length_quotient_prime hx p.2.isPrime

variable {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]

private abbrev minimalPrimeDiagonal :
    R →ₗ[R] (∀ p : {p : Ideal R // p ∈ minimalPrimes R}, R ⧸ p.1) :=
  LinearMap.pi fun p => (p.1 : Submodule R R).mkQ

omit [IsLocalRing R] in
/-- At each minimal prime, a suitable product of elements in the other minimal primes
annihilates the cokernel of the diagonal map while avoiding that prime. -/
private theorem diagonal_cokernel_annihilator_witness (p : {p : Ideal R // p ∈ minimalPrimes R}) :
    ∃ r : R, r ∈ Module.annihilator R
       ((∀ q : {q : Ideal R // q ∈ minimalPrimes R}, R ⧸ q.1) ⧸
         LinearMap.range (minimalPrimeDiagonal (R := R))) ∧
       r ∉ p.1 := by
  classical
  let : Fintype {q : Ideal R // q ∈ minimalPrimes R} :=
    (minimalPrimes.finite_of_isNoetherianRing R).fintype
  have hchoose : ∀ q : {q : Ideal R // q ∈ minimalPrimes R},
      ∃ y : R, q ≠ p → y ∈ q.1 ∧ y ∉ p.1 := by
    intro q
    by_cases hqp : q = p
    · exact ⟨1, fun h ↦ (h hqp).elim⟩
    · have hnle : ¬ q.1 ≤ p.1 := by
        intro hle
        have hle' : p.1 ≤ q.1 := p.2.2 ⟨q.2.isPrime, bot_le⟩ hle
        exact hqp (Subtype.ext (le_antisymm hle hle'))
      obtain ⟨y, hyq, hynp⟩ := SetLike.not_le_iff_exists.mp hnle
      exact ⟨y, fun _ => ⟨hyq, hynp⟩⟩
  choose y hy using hchoose
  let r : R :=
    ∏ q ∈ (Finset.univ : Finset {q : Ideal R // q ∈ minimalPrimes R}).erase p, y q
  let : p.1.IsPrime := p.2.isPrime
  have hrp : r ∉ p.1 := by
    intro hrp
    obtain ⟨q, hqs, hqmem⟩ := (Ideal.IsPrime.prod_mem_iff (p := p.1)).mp hrp
    have hqp : q ≠ p := (Finset.mem_erase.mp hqs).1
    exact (hy q hqp).2 hqmem
  refine ⟨r, ?_, hrp⟩
  rw [Module.mem_annihilator]
  intro m
  obtain ⟨v, rfl⟩ :=
    Submodule.mkQ_surjective (LinearMap.range (minimalPrimeDiagonal (R := R))) m
  show (LinearMap.range (minimalPrimeDiagonal (R := R))).mkQ (r • v) = 0
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  obtain ⟨a, ha⟩ := Submodule.mkQ_surjective (p.1 : Submodule R R) (v p)
  refine ⟨r * a, ?_⟩
  funext q
  by_cases hqp : q = p
  · subst q
    show (Submodule.mkQ (p.1 : Submodule R R)) (r * a) = r • v p
    rw [← ha]
    simp [Algebra.smul_def, mul_comm]
  · have hqmem : r ∈ q.1 := by
      apply Ideal.prod_mem
        (s := (Finset.univ : Finset {q : Ideal R // q ∈ minimalPrimes R}).erase p)
        (i := q)
      · exact Finset.mem_erase.mpr ⟨hqp, Finset.mem_univ q⟩
      · exact (hy q hqp).1
    show (Submodule.mkQ (q.1 : Submodule R R)) (r * a) = r • v q
    have hzero : (Ideal.Quotient.mk q.1) r = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hqmem
    simp [Algebra.smul_def, hzero]

/-- The diagonal cokernel has support only at the closed point, hence finite length. -/
private theorem diagonal_cokernel_finite
    (hdim : Ring.KrullDimLE 1 R) :
    Module.length R
      ((∀ q : {q : Ideal R // q ∈ minimalPrimes R}, R ⧸ q.1) ⧸
        LinearMap.range (minimalPrimeDiagonal (R := R))) ≠ ⊤ := by
  classical
  let : Fintype {q : Ideal R // q ∈ minimalPrimes R} :=
    (minimalPrimes.finite_of_isNoetherianRing R).fintype
  let M := ∀ q : {q : Ideal R // q ∈ minimalPrimes R}, R ⧸ q.1
  let Q := M ⧸ LinearMap.range (minimalPrimeDiagonal (R := R))
  have : Module.Finite R M := inferInstance
  have : Module.Finite R Q := inferInstance
  have hsupp : Module.support R Q ⊆ {IsLocalRing.closedPoint R} := by
    intro q hq
    rw [Module.support_eq_zeroLocus] at hq
    have hann : Module.annihilator R Q ≤ q.asIdeal := SetLike.coe_subset_coe.mp hq
    rcases (Ring.krullDimLE_one_iff.mp hdim) q.asIdeal q.isPrime with hmin | hmax
    · obtain ⟨r, hr, hnr⟩ :=
        diagonal_cokernel_annihilator_witness (R := R) ⟨q.asIdeal, hmin⟩
      exact (hnr (hann hr)).elim
    · have hqmax : q.asIdeal = IsLocalRing.maximalIdeal R := IsLocalRing.eq_maximalIdeal hmax
      simpa only [Set.mem_singleton_iff] using (PrimeSpectrum.ext hqmax)
  by_cases htriv : Subsingleton Q
  · exact Module.length_ne_top_iff.mpr IsFiniteLength.of_subsingleton
  · have hne : Module.support R Q ≠ ∅ := fun h ↦ htriv (Module.support_eq_empty_iff.mp h)
    obtain ⟨q, hq⟩ : (Module.support R Q).Nonempty := Set.nonempty_iff_ne_empty.mpr hne
    have hclosed : IsLocalRing.closedPoint R ∈ Module.support R Q := by
      have hqeq : q = IsLocalRing.closedPoint R := by simpa using hsupp hq
      simpa only [hqeq] using hq
    have heq : Module.support R Q = {IsLocalRing.closedPoint R} :=
      Set.Subset.antisymm hsupp (by simpa using hclosed)
    exact Module.length_ne_top_iff.mpr (isFiniteLength_of_support heq)

omit [IsNoetherianRing R] [IsLocalRing R] in
private theorem smul_injective_on_minimalPrimeProduct {x : R}
    (hx : ∀ p ∈ minimalPrimes R, x ∉ p) :
    Function.Injective
      (fun v : (∀ q : {q : Ideal R // q ∈ minimalPrimes R}, R ⧸ q.1) => x • v) := by
  intro a b hab
  funext p
  let : p.1.IsPrime := p.2.isPrime
  have hxp : (Ideal.Quotient.mk p.1) x ≠ 0 := by
    rw [ne_eq, Ideal.Quotient.eq_zero_iff_mem]
    exact hx p.1 p.2
  have h := congrFun hab p
  apply mul_left_cancel₀ hxp
  simpa [Algebra.smul_def] using h

omit [IsNoetherianRing R] [IsLocalRing R] in
private theorem quot_smul_top_eq_span (x : R) :
    (x • (⊤ : Submodule R R)) = Ideal.span {x} := by
  ext y
  rw [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨r, -, rfl⟩
    simp [smul_eq_mul]
  · rintro ⟨r, rfl⟩
    exact ⟨r, trivial, by rw [smul_eq_mul]⟩

omit [IsNoetherianRing R] [IsLocalRing R] in
private theorem diagonal_quotient_length_le {x : R} :
    Module.length R
      ((LinearMap.range (minimalPrimeDiagonal (R := R))) ⧸
        (x • (⊤ : Submodule R (LinearMap.range (minimalPrimeDiagonal (R := R)))))) ≤
      Module.length R (R ⧸ Ideal.span {x}) := by
  let f := (minimalPrimeDiagonal (R := R)).rangeRestrict
  have hle := Module.length_le_of_surjective (QuotSMulTop.map x f)
    (QuotSMulTop.map_surjective x (minimalPrimeDiagonal (R := R)).surjective_rangeRestrict)
  have hlen : Module.length R (R ⧸ (x • (⊤ : Submodule R R))) =
      Module.length R (R ⧸ Ideal.span {x}) :=
    congrArg (fun S : Submodule R R => Module.length R (R ⧸ S))
      (quot_smul_top_eq_span x)
  exact le_trans hle hlen.le

/-- **Stacks 0BWT.** The number of minimal primes of a one-dimensional Noetherian local ring is
at most the length of its quotient by a parameter avoiding all minimal primes. -/
@[stacks 0BWT]
theorem natCard_minimalPrimes_le_length_quotient_span_singleton
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (hdim : ringKrullDim R = 1) {x : R}
    (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hx_min : ∀ p ∈ minimalPrimes R, x ∉ p) :
    Module.length R (R ⧸ Ideal.span {x}) ≠ ⊤ ∧
      (Nat.card (minimalPrimes R) : ℕ∞) ≤ Module.length R (R ⧸ Ideal.span {x}) := by
  have hdim' : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr hdim.le
  have hfinite := length_quotient_span_singleton_ne_top_of_krullDimLE_one hdim' hx hx_min
  have hcard := card_minimalPrimes_le_length_pi_quotient_smul hx
  have heq := length_quot_xtop_eq_of_quot_finite R x
    (smul_injective_on_minimalPrimeProduct hx_min)
    (LinearMap.range (minimalPrimeDiagonal (R := R)))
    (diagonal_cokernel_finite hdim')
  exact ⟨hfinite, hcard.trans (heq.trans_le diagonal_quotient_length_le)⟩

end MinimalPrimeCount

section ParameterMultiplicity

open Polynomial

private lemma leadingCoeff_le_of_eventually_eval_le (P Q : ℚ[X])
    (h : ∀ᶠ n : ℕ in Filter.atTop, P.eval (n : ℚ) ≤ Q.eval (n : ℚ))
    (hdeg : P.degree = Q.degree) : P.leadingCoeff ≤ Q.leadingCoeff := by
  by_cases hpos : 0 < P.degree
  · exact HilbertSamuel.leadingCoeff_cmp P Q 0 (by simpa using h) hdeg hpos
  · by_cases hP : P = 0
    · have hQ : Q = 0 := Polynomial.degree_eq_bot.mp (by simpa [hP] using hdeg.symm)
      simp [hP, hQ]
    have hPd : P.degree = 0 := le_antisymm (le_of_not_gt hpos) (zero_le_degree_iff.mpr hP)
    have hQ : Q ≠ 0 := by
      intro hQ
      rw [hQ, Polynomial.degree_zero] at hdeg
      simp [hPd] at hdeg
    have hQd : Q.degree = 0 := hdeg ▸ hPd
    have hPC := Polynomial.eq_C_of_degree_le_zero (le_of_eq hPd)
    have hQC := Polynomial.eq_C_of_degree_le_zero (le_of_eq hQd)
    obtain ⟨n, hn⟩ := h.exists
    rw [hPC, hQC] at hn ⊢
    simpa only [Polynomial.eval_C, Polynomial.leadingCoeff_C] using hn

/-- The quotient by a power of an ideal of definition has finite length. -/
private lemma length_quotient_pow_succ_lt_top
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : I.radical = maximalIdeal R) (n : ℕ) :
    Module.length R (R ⧸ I ^ (n + 1)) < ⊤ := by
  have h := HilbertSamuel.length_quotient_lt_top I hI R n
  have hs : I ^ (n + 1) • (⊤ : Submodule R R) = I ^ (n + 1) := by simp
  rwa [hs] at h

/-- The quotient by an ideal of definition has finite length. -/
private lemma length_quotient_lt_top_of_radical_eq_maximalIdeal
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {I : Ideal R} (hI : I.radical = maximalIdeal R) : Module.length R (R ⧸ I) < ⊤ := by
  have h := length_quotient_pow_succ_lt_top I hI 0
  rwa [zero_add, pow_one] at h

/-- An ideal of definition is proper. -/
private lemma ne_top_of_radical_eq_maximalIdeal
    {R : Type*} [CommRing R] [IsLocalRing R] {I : Ideal R}
    (hI : I.radical = maximalIdeal R) : I ≠ ⊤ := by
  rintro rfl
  rw [Ideal.radical_top] at hI
  exact (maximalIdeal.isMaximal R).ne_top hI.symm

/-- The quotient by an ideal of definition has length at least one. -/
private lemma one_le_length_quotient_of_radical_eq_maximalIdeal
    {R : Type*} [CommRing R] [IsLocalRing R] {I : Ideal R}
    (hI : I.radical = maximalIdeal R) : (1 : ℕ∞) ≤ Module.length R (R ⧸ I) := by
  have : Nontrivial (R ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_radical_eq_maximalIdeal hI)
  exact Order.one_le_iff_pos.mpr Module.length_pos

private lemma eq_of_eventually_eval_eq {P Q : ℚ[X]}
    (h : ∀ᶠ n : ℕ in Filter.atTop, P.eval (n : ℚ) = Q.eval (n : ℚ)) : P = Q := by
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp h
  apply Polynomial.eq_of_infinite_eval_eq
  refine Set.infinite_of_injective_forall_mem
    (f := fun n : ℕ => ((n + N : ℕ) : ℚ)) (fun a b hab => by simpa using hab) fun n => ?_
  exact hN _ (Nat.le_add_left N n)

private abbrev ComputesHilbertSamuel (R : Type*) [CommRing R]
    (I : Ideal R) (M : Type*) [AddCommGroup M] [Module R M] (P : ℚ[X]) : Prop :=
  ∀ᶠ n : ℕ in Filter.atTop, ∃ q : ℕ,
    Module.length R (M ⧸ (I ^ (n + 1) • (⊤ : Submodule R M))) = q ∧
      P.eval (n : ℚ) = (q : ℚ)

/-- A polynomial computing a Hilbert–Samuel function is nonnegative at the naturals, so its
leading coefficient is nonnegative. -/
private lemma nonneg_leadingCoeff_of_computesHilbertSamuel
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {I : Ideal R} {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P) : 0 ≤ P.leadingCoeff := by
  apply HilbertSamuel.nonneg_leadingCoeff_of_eventually_nonneg P
  filter_upwards [hP] with n hn
  obtain ⟨q, _, hq⟩ := hn
  rw [hq]
  positivity

/-- A polynomial computing a Hilbert–Samuel function is eventually integer-valued. -/
private lemma eventually_exists_int_eval_of_computesHilbertSamuel
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {I : Ideal R} {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P) :
    ∀ᶠ n : ℕ in Filter.atTop, ∃ z : ℤ, P.eval (n : ℚ) = z := by
  filter_upwards [hP] with n hn
  obtain ⟨q, _, hq⟩ := hn
  exact ⟨q, by exact_mod_cast hq⟩

private lemma exists_computesHilbertSamuel
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (I : Ideal R) (hI : I.radical = maximalIdeal R) :
    ∃ P : ℚ[X], ComputesHilbertSamuel R I M P := by
  obtain ⟨r, _, b, hab⟩ :=
    Ideal.exists_eventually_length_quotient_smul_pow_eq_sum_choose_mul I hI M
  refine ⟨∑ i ∈ Finset.range (r + 1),
    Polynomial.C (b i : ℚ) * Stacks.HilbertFunction.PolynomialQuotient.binomialPoly i, hab.mono fun
      n hn => ?_⟩
  obtain ⟨q, hq1, hq2⟩ := hn.2
  refine ⟨q, hq1, ?_⟩
  simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
    Stacks.HilbertFunction.PolynomialQuotient.binomialPoly_eval]
  simp_rw [Ring.choose_natCast]
  calc
    _ = ∑ i ∈ Finset.range (r + 1), (n.choose i : ℚ) * (b i : ℚ) := by
      simp_rw [mul_comm]
    _ = (q : ℚ) := by exact_mod_cast hq2.symm

private lemma hilbertSamuelDegree_eq_degree_of_computesHilbertSamuel
    {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M]
    {I : Ideal R} {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P) :
    I.hilbertSamuelDegree M = P.degree := by
  have hex : ∃ Q : ℚ[X], ComputesHilbertSamuel R I M Q := ⟨P, hP⟩
  rw [Ideal.hilbertSamuelDegree, dite_eq_left hex]
  apply congrArg Polynomial.degree
  apply eq_of_eventually_eval_eq
  filter_upwards [Classical.choose_spec hex, hP] with n h1 h2
  obtain ⟨a, ha1, ha2⟩ := h1
  obtain ⟨b, hb1, hb2⟩ := h2
  have : a = b := by exact_mod_cast ha1.symm.trans hb1
  rw [ha2, hb2, this]

/-- The degree of every Hilbert–Samuel polynomial is the dimension of its module's support. -/
private lemma degree_map_eq_supportDim
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P) :
    P.degree.map (Nat.cast : ℕ → ℕ∞) = Module.supportDim R M := by
  obtain ⟨_, e, he⟩ :=
    Ideal.exists_degree_eq_of_eventually_eval_eq_length_quotient_smul_pow (R := R) M
  have hPe : P.degree = e := (he I hI P).2 hP
  obtain ⟨Q, hQ⟩ := exists_computesHilbertSamuel (R := R) (M := M)
    (maximalIdeal R) ((maximalIdeal.isMaximal R).isPrime.radical)
  have hQe : Q.degree = e :=
    (he (maximalIdeal R) ((maximalIdeal.isMaximal R).isPrime.radical) Q).2 hQ
  have hdeg : Module.hilbertSamuelDegree R M = P.degree := by
    show (maximalIdeal R).hilbertSamuelDegree M = P.degree
    rw [hilbertSamuelDegree_eq_degree_of_computesHilbertSamuel hQ, hQe, hPe]
  rw [← hdeg]
  exact Module.hilbertSamuelDegree_eq_supportDim R M

/-- If the support of `M` has the dimension of `R`, a polynomial computing a Hilbert–Samuel
function of `M` has degree `d = dim R`. -/
private lemma degree_eq_of_supportDim_eq_ringKrullDim
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞))
    (hM : Module.supportDim R M = ringKrullDim R) : P.degree = d := by
  apply WithBot.map_injective (f := (Nat.cast : ℕ → ℕ∞)) Nat.cast_injective
  rw [degree_map_eq_supportDim hI hP, hM, hd]
  rfl

private lemma computes_of_isHilbertSamuelPoly
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : I.radical = maximalIdeal R) (P : ℚ[X])
    (hP : HilbertSamuel.IsHilbertSamuelPoly I R P) :
    ∀ᶠ n : ℕ in Filter.atTop, ∃ q : ℕ,
      Module.length R (R ⧸ (I ^ (n + 1) • (⊤ : Submodule R R))) = q ∧
        P.eval (n : ℚ) = (q : ℚ) := by
  filter_upwards [hP] with n hn
  refine ⟨HilbertSamuel.hilbertSamuelFunction I R n, ?_, hn⟩
  unfold HilbertSamuel.hilbertSamuelFunction
  exact (ENat.natCast_toNat
    (HilbertSamuel.length_quotient_lt_top I hI R n).ne).symm

/-- Modulo `(x)`, adjoining `(x)` before taking a power has no effect. -/
private lemma pow_sup_span_sup (R : Type*) [CommRing R] (x : R) (J : Ideal R) (n : ℕ) :
    (Ideal.span {x} ⊔ J) ^ n ⊔ Ideal.span {x} = J ^ n ⊔ Ideal.span {x} := by
  let f := Ideal.Quotient.mk (Ideal.span {x} : Ideal R)
  have hm :
      Ideal.map f ((Ideal.span {x} ⊔ J) ^ n ⊔ Ideal.span {x}) =
        Ideal.map f (J ^ n ⊔ Ideal.span {x}) := by
    simp [f, Ideal.map_sup, Ideal.map_pow]
  have hs := (Ideal.map_eq_iff_sup_ker_eq_of_surjective f Ideal.Quotient.mk_surjective).mp hm
  simpa [f, Ideal.mk_ker, sup_assoc] using hs

/-- The elementary monomial bound for powers of an ideal with a specified list of
generators.  Its coefficient counts monomials of total degree at most `n`. -/
private theorem length_quotient_pow_le_choose :
    ∀ d : ℕ, ∀ (R : Type*) [CommRing R] (gs : List R), gs.length = d → ∀ n : ℕ,
      Module.length R (R ⧸ (Ideal.ofList gs) ^ (n + 1)) ≤
        ((n + d).choose d : ℕ∞) * Module.length R (R ⧸ Ideal.ofList gs) := by
  intro d
  induction d with
  | zero =>
      intro R _ gs hgs n
      have : gs = [] := List.length_eq_zero_iff.mp hgs
      subst gs
      have hbot : Ideal.ofList ([] : List R) = ⊥ := by simp [Ideal.ofList]
      rw [hbot, Ideal.bot_pow (by omega)]
      simp only [Nat.add_zero, Nat.choose_zero_right, Nat.cast_one, one_mul]
      exact le_rfl
  | succ d ih =>
      intro R _ gs hgs n
      obtain ⟨x, gs, rfl⟩ := List.exists_cons_of_length_eq_add_one hgs
      set J : Ideal R := Ideal.ofList gs
      have hlen : gs.length = d := by simpa using hgs
      have hI : Ideal.ofList (x :: gs) = Ideal.span {x} ⊔ J := by
        simp [J, Ideal.ofList_cons]
      induction n with
      | zero =>
          rw [show Ideal.ofList (x :: gs) ^ (0 + 1) = Ideal.ofList (x :: gs) by simp]
          simp only [Nat.zero_add, Nat.choose_self, Nat.cast_one, one_mul]
          exact le_rfl
      | succ n hn =>
          let S := R ⧸ Ideal.span {x}
          let f : R →+* S := Ideal.Quotient.mk (Ideal.span {x})
          let qs : List S := gs.map f
          have hqs : qs.length = d := by simp [qs, hlen]
          have hmapJ : Ideal.ofList qs = Ideal.map f J := (Ideal.map_ofList f gs).symm
          have hstep := length_quotient_le_add x
            ((Ideal.ofList (x :: gs)) ^ (n + 1 + 1))
            ((Ideal.ofList (x :: gs)) ^ (n + 1)) (by
              intro b hb
              have hm := Ideal.mul_mem_mul
                (Ideal.subset_span (by simp) : x ∈ Ideal.ofList (x :: gs)) hb
              rw [pow_succ']
              exact hm)
          have htailS := ih S qs hqs (n + 1)
          have htailR :
              Module.length R (R ⧸ (J ^ (n + 1 + 1) ⊔ Ideal.span {x})) ≤
                (((n + 1) + d).choose d : ℕ∞) *
                  Module.length R (R ⧸ (J ⊔ Ideal.span {x})) := by
            rw [← length_quotient_sup_eq (Ideal.span {x}) (J ^ (n + 1 + 1)),
              ← length_quotient_sup_eq (Ideal.span {x}) J,
              length_quotient_smul_top, length_quotient_smul_top]
            rwa [hmapJ, ← Ideal.map_pow] at htailS
          rw [hI, pow_sup_span_sup R x J (n + 1 + 1)] at hstep
          rw [← hI] at hstep
          calc
            Module.length R (R ⧸ (Ideal.ofList (x :: gs)) ^ (n + 1 + 1))
                ≤ Module.length R (R ⧸ (Ideal.ofList (x :: gs)) ^ (n + 1)) +
                    Module.length R (R ⧸ (J ^ (n + 1 + 1) ⊔ Ideal.span {x})) := hstep
            _ ≤ (((n + 1 + (d + 1)).choose (d + 1) : ℕ∞) *
                  Module.length R (R ⧸ Ideal.ofList (x :: gs))) := by
              have hbase : J ⊔ Ideal.span {x} = Ideal.ofList (x :: gs) := by
                rw [hI, sup_comm]
              rw [hbase] at htailR
              calc
                _ ≤ (((n + (d + 1)).choose (d + 1) : ℕ∞) +
                      (((n + 1) + d).choose d : ℕ∞)) *
                    Module.length R (R ⧸ Ideal.ofList (x :: gs)) := by
                  rw [add_mul]
                  exact add_le_add hn htailR
                _ = (((n + 1 + (d + 1)).choose (d + 1) : ℕ∞) *
                    Module.length R (R ⧸ Ideal.ofList (x :: gs))) := by
                  have hc :
                      (n + (d + 1)).choose (d + 1) + (n + 1 + d).choose d =
                        (n + 1 + (d + 1)).choose (d + 1) := by
                    simpa [add_comm, add_left_comm, add_assoc] using
                      (Nat.choose_succ_succ (n + d + 1) d).symm
                  rw [← Nat.cast_add, hc]

/-- **Stacks 0BWW.** If `I` is generated by a system of parameters and the leading coefficient
of its Hilbert–Samuel polynomial is `e / d!`, then `e ≤ length_R(R / I)`. -/
@[stacks 0BWW]
theorem multiplicity_le_length_quotient_of_isSystemOfParameters
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {gs : List R} (hgs : IsSystemOfParameters gs) {P : ℚ[X]}
    (hP : HilbertSamuel.IsHilbertSamuelPoly (Ideal.ofList gs) R P) {e : ℕ}
    (hlead : P.leadingCoeff = (e : ℚ) / gs.length.factorial) :
    (e : ℕ∞) ≤ Module.length R (R ⧸ Ideal.ofList gs) := by
  let I := Ideal.ofList gs
  let d := gs.length
  let L := Module.length R (R ⧸ I)
  have hI : I.radical = maximalIdeal R := hgs.1
  have hL : L < ⊤ := length_quotient_lt_top_of_radical_eq_maximalIdeal hI
  have hPdeg : P.degree = (d : WithBot ℕ) :=
    degree_eq_of_supportDim_eq_ringKrullDim hI (M := R) (computes_of_isHilbertSamuelPoly I hI P hP)
      hgs.2 (Module.supportDim_self_eq_ringKrullDim R)
  let B : ℚ[X] := Polynomial.C ((d.factorial : ℚ)⁻¹) *
    (ascPochhammer ℚ d).comp (Polynomial.X + 1)
  have hBeval : ∀ n : ℕ, B.eval (n : ℚ) = ((n + d).choose d : ℚ) := by
    intro n
    simp only [B]
    rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_comp,
      Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_one]
    rw [show (n : ℚ) + 1 = ((n + 1 : ℕ) : ℚ) by push_cast; ring,
      ← ascPochhammer_eval_cast ℚ d (n + 1), ascPochhammer_nat_eq_ascFactorial]
    have hc : (n + d).choose d = (n + 1).ascFactorial d / d.factorial := by
      rw [Nat.choose_eq_descFactorial_div_factorial,
        Nat.add_descFactorial_eq_ascFactorial]
    rw [hc, Nat.cast_div (Nat.factorial_dvd_ascFactorial (n + 1) d)]
    · rw [div_eq_inv_mul]
    · exact_mod_cast Nat.factorial_ne_zero d
  have hBdeg : B.degree = (d : WithBot ℕ) := by
    have hc : ((d.factorial : ℚ))⁻¹ ≠ 0 := by simp [Nat.factorial_ne_zero]
    simp only [B]
    rw [Polynomial.degree_C_mul hc, Polynomial.degree_comp]
    · rw [Polynomial.degree_eq_natDegree (monic_ascPochhammer ℚ d).ne_zero,
        ascPochhammer_natDegree, show (Polynomial.X + 1 : ℚ[X]).degree = 1 by
          simpa using Polynomial.degree_X_add_C (1 : ℚ), mul_one]
    · rw [← Polynomial.C_1, Polynomial.degree_X_add_C]
      norm_num
  have hBlc : B.leadingCoeff = (d.factorial : ℚ)⁻¹ := by
    simp only [B]
    rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
      Polynomial.leadingCoeff_comp]
    · rw [(monic_ascPochhammer ℚ d).leadingCoeff,
        show (Polynomial.X + 1 : ℚ[X]).leadingCoeff = 1 by
          simpa using (Polynomial.monic_X_add_C (1 : ℚ)).leadingCoeff,
        one_pow, mul_one, mul_one]
    · simp
  have hboundQ : ∀ᶠ n : ℕ in Filter.atTop,
      P.eval (n : ℚ) ≤ (L.toNat : ℚ) * B.eval (n : ℚ) := by
    filter_upwards [hP] with n hn
    rw [hn, hBeval]
    have hb := length_quotient_pow_le_choose d R gs rfl n
    have hpow := length_quotient_pow_succ_lt_top I hI n
    change Module.length R (R ⧸ I ^ (n + 1)) ≤ ((n + d).choose d : ℕ∞) * L at hb
    rw [← ENat.natCast_toNat hpow.ne, ← ENat.natCast_toNat hL.ne,
      ← Nat.cast_mul, ENat.natCast_le_natCast] at hb
    unfold HilbertSamuel.hilbertSamuelFunction
    show (↑(Module.length R (R ⧸ I ^ (n + 1) • (⊤ : Submodule R R))).toNat : ℚ) ≤
      (L.toNat : ℚ) * ((n + d).choose d : ℚ)
    have hs : I ^ (n + 1) • (⊤ : Submodule R R) = I ^ (n + 1) := by simp
    rw [hs]
    exact_mod_cast (by simpa only [Nat.mul_comm] using hb)
  have hL0 : L.toNat ≠ 0 := by
    intro hz
    have hL1 : 1 ≤ L := one_le_length_quotient_of_radical_eq_maximalIdeal hI
    rw [← ENat.natCast_toNat hL.ne, hz] at hL1
    simp at hL1
  have hlc := leadingCoeff_le_of_eventually_eval_le P
    (Polynomial.C (L.toNat : ℚ) * B) (by simpa using hboundQ) (by
      rw [Polynomial.degree_C_mul]
      · exact hPdeg.trans hBdeg.symm
      · exact_mod_cast hL0)
  rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, hBlc, hlead] at hlc
  have hfac : (d.factorial : ℚ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero d
  have heL : e ≤ L.toNat := by
    have hrat : (e : ℚ) / (d.factorial : ℚ) ≤
        (L.toNat : ℚ) / (d.factorial : ℚ) := by
      simpa [d, div_eq_mul_inv, mul_comm] using hlc
    exact_mod_cast (div_le_div_iff_of_pos_right
      (by positivity : (0 : ℚ) < d.factorial)).mp hrat
  show (e : ℕ∞) ≤ L
  rw [← ENat.natCast_toNat hL.ne]
  exact_mod_cast heL

end ParameterMultiplicity

section FullDimensionalMinimalPrimes

open Polynomial Filter

/-- The normalized leading coefficient of an eventually integer-valued polynomial is an
integer. -/
private lemma exists_int_factorial_mul_leadingCoeff {P : ℚ[X]} {d : ℕ}
    (hdegree : P.degree = d)
    (hval : ∀ᶠ n : ℕ in atTop, ∃ z : ℤ, P.eval (n : ℚ) = z) :
    ∃ z : ℤ, P.leadingCoeff * (d.factorial : ℚ) = z := by
  have hnat : P.natDegree = d := Polynomial.natDegree_eq_of_degree_eq_some hdegree
  obtain ⟨N, hN⟩ := eventually_atTop.mp hval
  let z (k : ℕ) : ℤ := Classical.choose (hN (N + k) (Nat.le_add_right N k))
  have hz (k : ℕ) : P.eval ((N + k : ℕ) : ℚ) = (z k : ℚ) :=
    Classical.choose_spec (hN (N + k) (Nat.le_add_right N k))
  refine ⟨∑ k ∈ Finset.range (d + 1),
      ((-1 : ℤ) ^ (d - k) * (d.choose k : ℤ)) * z k, ?_⟩
  have hfd := congrFun (Polynomial.fwdDiff_iter_degree_eq_factorial P) (N : ℚ)
  rw [hnat, fwdDiff_iter_eq_sum_shift] at hfd
  simpa only [Pi.smul_apply, Pi.natCast_apply, smul_eq_mul, zsmul_eq_mul, Nat.cast_smul_eq_nsmul,
    nsmul_eq_mul, mul_one, ← Nat.cast_add, hz, Int.cast_sum, Int.cast_mul, Int.cast_pow,
    Int.cast_neg, Int.cast_one, Int.cast_natCast] using hfd.symm

/-- A positive integral normalized leading coefficient is at least one. -/
private lemma one_le_factorial_mul_leadingCoeff {P : ℚ[X]} {d : ℕ}
    (hdegree : P.degree = d)
    (hval : ∀ᶠ n : ℕ in atTop, ∃ z : ℤ, P.eval (n : ℚ) = z)
    (hpositive : 0 < P.leadingCoeff) :
    (1 : ℚ) ≤ P.leadingCoeff * (d.factorial : ℚ) := by
  obtain ⟨z, hz⟩ := exists_int_factorial_mul_leadingCoeff hdegree hval
  have hzpos : 0 < z := by
    exact_mod_cast (hz ▸ mul_pos hpositive (by positivity : (0 : ℚ) < d.factorial))
  have : (1 : ℤ) ≤ z := by omega
  rw [hz]
  exact_mod_cast this

private abbrev FullDimensionalMinimalPrime (R : Type*) [CommRing R] :=
  {p : Ideal R // p ∈ minimalPrimes R ∧
    ringKrullDim (R ⧸ p) = ringKrullDim R}

private abbrev fullDimensionalMinimalPrimesInSupport
    (R M : Type*) [CommRing R] [AddCommGroup M] [Module R M] :
    Set (FullDimensionalMinimalPrime R) :=
  {p | (⟨p.1, p.2.1.isPrime⟩ : PrimeSpectrum R) ∈
    Module.support R M}

private lemma finite_fullDimensionalMinimalPrime
    (R : Type*) [CommRing R] [IsNoetherianRing R] :
    Finite (FullDimensionalMinimalPrime R) :=
  ((minimalPrimes.finite_of_isNoetherianRing R).subset (fun _ h => h.1)).to_subtype

/-- The full-dimensional minimal primes in the support of the middle module of a short exact
sequence are the union of those in the supports of its end modules. -/
private lemma fullDimensionalMinimalPrimesInSupport_exact
    {R M₁ M₂ M₃ : Type*} [CommRing R]
    [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
    [AddCommGroup M₃] [Module R M₃]
    {f : M₁ →ₗ[R] M₂} {g : M₂ →ₗ[R] M₃}
    (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) :
    fullDimensionalMinimalPrimesInSupport R M₂ =
      fullDimensionalMinimalPrimesInSupport R M₁ ∪
        fullDimensionalMinimalPrimesInSupport R M₃ := by
  ext p
  simp only [fullDimensionalMinimalPrimesInSupport, Set.mem_ofPred_eq, Set.mem_union]
  rw [Module.support_of_exact hfg hf hg]
  rfl

private lemma fullDimensionalMinimalPrimesInSupport_self
    (R : Type*) [CommRing R] :
    fullDimensionalMinimalPrimesInSupport R R = Set.univ := by
  ext p
  simp only [fullDimensionalMinimalPrimesInSupport, Set.mem_ofPred_eq, Set.mem_univ,
    iff_true]
  rw [Module.mem_support_iff_of_finite, Module.annihilator_eq_bot.mpr (inferInstance :
    FaithfulSMul R R)]
  exact bot_le

/-- A full-dimensional minimal prime in the support forces the module to have full support
dimension. -/
private lemma supportDim_eq_ringKrullDim_of_mem_fullDimensionalMinimalPrime
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] [Module.Finite R M]
    {p : FullDimensionalMinimalPrime R}
    (hp : p ∈ fullDimensionalMinimalPrimesInSupport R M) :
    Module.supportDim R M = ringKrullDim R := by
  have hsubset : Module.support R (R ⧸ p.1) ⊆ Module.support R M := by
    intro q hq
    rw [Module.support_eq_zeroLocus, Ideal.annihilator_quotient] at hq
    exact Module.mem_support_mono hq hp
  have hle : Module.supportDim R (R ⧸ p.1) ≤ Module.supportDim R M := by
    unfold Module.supportDim
    refine Order.krullDim_le_of_strictMono
      (fun q : Module.support R (R ⧸ p.1) =>
        (⟨q.1, hsubset q.2⟩ : Module.support R M)) ?_
    intro a b hab
    exact hab
  apply le_antisymm (Module.supportDim_le_ringKrullDim R M)
  calc
    ringKrullDim R = ringKrullDim (R ⧸ p.1) := p.2.2.symm
    _ = Module.supportDim R (R ⧸ p.1) := (Module.supportDim_quotient_eq_ringKrullDim p.1).symm
    _ ≤ Module.supportDim R M := hle

private lemma degree_le_ringKrullDim
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞)) :
    P.degree ≤ d := by
  have hm : P.degree.map (Nat.cast : ℕ → ℕ∞) ≤
      WithBot.map (Nat.cast : ℕ → ℕ∞) (d : WithBot ℕ) := by
    rw [degree_map_eq_supportDim hI hP, WithBot.map_natCast]
    simpa [hd] using Module.supportDim_le_ringKrullDim R M
  exact (WithBot.map_le_iff (Nat.cast : ℕ → ℕ∞) (by
    intro a b
    constructor <;> intro h <;> exact_mod_cast h)).mp hm

private lemma degree_eq_ringKrullDim_of_mem_fullDimensionalMinimalPrime
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞))
    {p : FullDimensionalMinimalPrime R}
    (hp : p ∈ fullDimensionalMinimalPrimesInSupport R M) :
    P.degree = d := by
  exact degree_eq_of_supportDim_eq_ringKrullDim hI hP hd
    (supportDim_eq_ringKrullDim_of_mem_fullDimensionalMinimalPrime hp)

private lemma fullDimensionalMinimalPrimesInSupport_quotient_ncard_le_one
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    (p : Ideal R) [p.IsPrime] :
    (fullDimensionalMinimalPrimesInSupport R (R ⧸ p)).ncard ≤ 1 := by
  have : Finite (FullDimensionalMinimalPrime R) := finite_fullDimensionalMinimalPrime R
  apply (Set.ncard_le_one_iff).mpr
  intro q q' qmem q'mem
  have eqp (q : FullDimensionalMinimalPrime R)
      (hq : q ∈ fullDimensionalMinimalPrimesInSupport R (R ⧸ p)) : p = q.1 := by
    have hpq : p ≤ q.1 := by
      change (⟨q.1, q.2.1.isPrime⟩ : PrimeSpectrum R) ∈ Module.support R (R ⧸ p) at hq
      rwa [Module.mem_support_iff_of_finite, Ideal.annihilator_quotient] at hq
    exact le_antisymm hpq (q.2.1.2 ⟨inferInstance, bot_le⟩ hpq)
  exact Subtype.ext ((eqp q qmem).symm.trans (eqp q' q'mem))

private lemma coeff_eq_leadingCoeff_of_degree_eq
    {P : ℚ[X]} {d : ℕ} (hdegree : P.degree = d) :
    P.coeff d = P.leadingCoeff := by
  simp [Polynomial.leadingCoeff, Polynomial.natDegree_eq_of_degree_eq_some hdegree]

private lemma coeff_nonneg_of_computesHilbertSamuel
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞)) :
    0 ≤ P.coeff d := by
  have hle := degree_le_ringKrullDim hI hP hd
  rcases eq_or_lt_of_le hle with heq | hlt
  · rw [coeff_eq_leadingCoeff_of_degree_eq heq]
    exact nonneg_leadingCoeff_of_computesHilbertSamuel hP
  · rw [Polynomial.coeff_eq_zero_of_degree_lt hlt]

private lemma one_le_factorial_mul_coeff_of_mem_fullDimensionalMinimalPrime
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞))
    {p : FullDimensionalMinimalPrime R}
    (hp : p ∈ fullDimensionalMinimalPrimesInSupport R M) :
    (1 : ℚ) ≤ P.coeff d * (d.factorial : ℚ) := by
  have hdegree := degree_eq_ringKrullDim_of_mem_fullDimensionalMinimalPrime hI hP hd hp
  have hne : P ≠ 0 := Polynomial.ne_zero_of_coe_le_degree hdegree.ge
  have hpos : 0 < P.leadingCoeff :=
    (nonneg_leadingCoeff_of_computesHilbertSamuel hP).lt_of_ne
      (Polynomial.leadingCoeff_ne_zero.mpr hne).symm
  rw [coeff_eq_leadingCoeff_of_degree_eq hdegree]
  exact one_le_factorial_mul_leadingCoeff hdegree
    (eventually_exists_int_eval_of_computesHilbertSamuel hP) hpos

/-- The top-degree coefficient is additive in a short exact sequence when the first module has
infinite length. -/
private lemma coeff_eq_add_of_exact_of_infinite_length
    {R M₁ M₂ M₃ : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M₁] [Module R M₁] [Module.Finite R M₁]
    [AddCommGroup M₂] [Module R M₂] [Module.Finite R M₂]
    [AddCommGroup M₃] [Module R M₃] [Module.Finite R M₃]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P₁ P₂ P₃ : ℚ[X]}
    (hP₁ : ComputesHilbertSamuel R I M₁ P₁)
    (hP₂ : ComputesHilbertSamuel R I M₂ P₂)
    (hP₃ : ComputesHilbertSamuel R I M₃ P₃)
    {f : M₁ →ₗ[R] M₂} {g : M₂ →ₗ[R] M₃}
    (hfg : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g)
    (hinf : ¬ IsFiniteLength R M₁)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞)) :
    P₂.coeff d = P₁.coeff d + P₃.coeff d := by
  have h00KC := (Ideal.max_degree_eq_degree_of_exact I hI hfg hf hg).1
    P₁ P₂ P₃ hP₁ hP₂ hP₃
  have herr : (P₂ - P₃ - P₁).degree < (d : WithBot ℕ) :=
    lt_of_lt_of_le (h00KC.1 hinf) (degree_le_ringKrullDim hI hP₁ hd)
  have hcoeff := Polynomial.coeff_eq_zero_of_degree_lt herr
  simp only [Polynomial.coeff_sub] at hcoeff
  linarith

/-- Powers of a proper ideal eventually annihilate a finite-length module over a Noetherian
local ring. -/
private lemma exists_pow_smul_top_eq_bot_of_isFiniteLength
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (I : Ideal R) (hI : I.radical = maximalIdeal R)
    (hM : IsFiniteLength R M) :
    ∃ n : ℕ, I ^ n • (⊤ : Submodule R M) = ⊥ := by
  have : IsArtinian R M := (isFiniteLength_iff_isNoetherian_isArtinian.mp hM).2
  let f : ℕ →o (Submodule R M)ᵒᵈ :=
    { toFun := fun n => OrderDual.toDual (I ^ n • (⊤ : Submodule R M))
      monotone' := by
        intro a b hab
        exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hab) }
  obtain ⟨n, hn⟩ := IsArtinian.monotone_stabilizes f
  refine ⟨n, ?_⟩
  have hinf : (⨅ k : ℕ, I ^ k • (⊤ : Submodule R M)) = ⊥ :=
    Ideal.iInf_pow_smul_eq_bot_of_isLocalRing I (ne_top_of_radical_eq_maximalIdeal hI)
  have hle : I ^ n • (⊤ : Submodule R M) ≤
      ⨅ k : ℕ, I ^ k • (⊤ : Submodule R M) := by
    refine le_iInf fun k => ?_
    by_cases hnk : n ≤ k
    · exact le_of_eq (congrArg OrderDual.ofDual (hn k hnk))
    · exact Submodule.smul_mono_left (Ideal.pow_le_pow_right (le_of_not_ge hnk))
  exact le_antisymm (hinf ▸ hle) bot_le

/-- The Hilbert–Samuel polynomial of a finite-length module is constant. -/
private lemma degree_le_zero_of_isFiniteLength
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    (hM : IsFiniteLength R M) : P.degree ≤ 0 := by
  obtain ⟨N, hN⟩ := exists_pow_smul_top_eq_bot_of_isFiniteLength I hI hM
  let q := (Module.length R M).toNat
  have hq : Module.length R M = (q : ℕ∞) :=
    (ENat.natCast_toNat (Module.length_ne_top_iff.mpr hM)).symm
  have hlen : Module.length R (M ⧸ (⊥ : Submodule R M)) = (q : ℕ∞) := by
    rwa [(Submodule.quotEquivOfEqBot (⊥ : Submodule R M) rfl).length_eq]
  have hconst : ∀ᶠ n : ℕ in atTop, P.eval (n : ℚ) = (q : ℚ) := by
    filter_upwards [hP, eventually_ge_atTop N] with n hn hge
    obtain ⟨r, hr, hr'⟩ := hn
    have hpow : I ^ (n + 1) • (⊤ : Submodule R M) = ⊥ := by
      apply le_antisymm _ bot_le
      calc
        I ^ (n + 1) • (⊤ : Submodule R M) ≤ I ^ N • ⊤ :=
          Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega))
        _ = ⊥ := hN
    rw [hpow, hlen] at hr
    have heq : r = q := by exact_mod_cast hr.symm
    rw [hr', heq]
  have hPC : P = Polynomial.C (q : ℚ) :=
    eq_of_eventually_eval_eq (hconst.mono fun n h ↦ by rw [h, Polynomial.eval_C])
  rw [hPC]
  exact Polynomial.degree_C_le

private lemma fullDimensionalMinimalPrimesInSupport_eq_empty_of_isFiniteLength
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    (hM : IsFiniteLength R M)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞)) (hdpos : 0 < d) :
    fullDimensionalMinimalPrimesInSupport R M = ∅ := by
  ext p
  simp only [Set.mem_empty_iff_false, iff_false]
  intro hp
  have hdegree := degree_eq_ringKrullDim_of_mem_fullDimensionalMinimalPrime hI hP hd hp
  have hzero := degree_le_zero_of_isFiniteLength hI hP hM
  rw [hdegree] at hzero
  have : d ≤ 0 := by exact_mod_cast hzero
  omega

/-- Hilbert–Samuel functions decrease under surjective module maps. -/
private lemma eventually_eval_le_of_surjective
    {R M N : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    {I : Ideal R} {P Q : ℚ[X]}
    (hP : ComputesHilbertSamuel R I M P)
    (hQ : ComputesHilbertSamuel R I N Q)
    (g : M →ₗ[R] N) (hg : Function.Surjective g) :
    ∀ᶠ n : ℕ in atTop, Q.eval (n : ℚ) ≤ P.eval (n : ℚ) := by
  filter_upwards [hP, hQ] with n hn hm
  obtain ⟨p, hp1, hp2⟩ := hn
  obtain ⟨q, hq1, hq2⟩ := hm
  have hlen : Module.length R (N ⧸ (I ^ (n + 1) • (⊤ : Submodule R N))) ≤
      Module.length R (M ⧸ (I ^ (n + 1) • (⊤ : Submodule R M))) := by
    let H : M ⧸ (I ^ (n + 1) • (⊤ : Submodule R M)) →ₗ[R]
        N ⧸ (I ^ (n + 1) • (⊤ : Submodule R N)) :=
      Submodule.mapQ _ _ g (by
        rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
        exact smul_mono_right _ le_top)
    apply Module.length_le_of_surjective H
    intro y
    obtain ⟨z, rfl⟩ := Submodule.mkQ_surjective _ y
    obtain ⟨x, rfl⟩ := hg z
    exact ⟨Submodule.mkQ _ x, rfl⟩
  rw [hp1, hq1] at hlen
  rw [hp2, hq2]
  exact_mod_cast hlen

private lemma coeff_le_of_surjective
    {R M N : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P Q : ℚ[X]}
    (hP : ComputesHilbertSamuel R I M P)
    (hQ : ComputesHilbertSamuel R I N Q)
    (g : M →ₗ[R] N) (hg : Function.Surjective g)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞)) (hdpos : 0 < d) :
    Q.coeff d ≤ P.coeff d := by
  have hQle := degree_le_ringKrullDim hI hQ hd
  rcases eq_or_lt_of_le hQle with hQdeg | hQdeg
  · have hsdN : Module.supportDim R N = ringKrullDim R := by
      rw [← degree_map_eq_supportDim hI hQ, hQdeg, hd]
      rfl
    have hsdM : Module.supportDim R M = ringKrullDim R := by
      apply le_antisymm (Module.supportDim_le_ringKrullDim R M)
      rw [← hsdN]
      exact Module.supportDim_le_of_surjective g hg
    have hPdeg := degree_eq_of_supportDim_eq_ringKrullDim hI hP hd hsdM
    rw [coeff_eq_leadingCoeff_of_degree_eq hQdeg,
      coeff_eq_leadingCoeff_of_degree_eq hPdeg]
    apply HilbertSamuel.leadingCoeff_cmp Q P 0
    · simpa using eventually_eval_le_of_surjective hP hQ g hg
    · exact hQdeg.trans hPdeg.symm
    · rw [hQdeg]
      exact_mod_cast hdpos
  · rw [Polynomial.coeff_eq_zero_of_degree_lt hQdeg]
    exact coeff_nonneg_of_computesHilbertSamuel hI hP hd

/-- A prime quotient contributes at most one full-dimensional minimal prime, and a nonzero
contribution forces normalized leading coefficient at least one. -/
private lemma ncard_le_factorial_mul_coeff_of_equiv_quotientPrime
    {R M : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    {I : Ideal R} (hI : I.radical = maximalIdeal R)
    {P : ℚ[X]} (hP : ComputesHilbertSamuel R I M P)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞))
    (p : PrimeSpectrum R) (e : M ≃ₗ[R] R ⧸ p.asIdeal) :
    ((fullDimensionalMinimalPrimesInSupport R M).ncard : ℚ) ≤
      P.coeff d * (d.factorial : ℚ) := by
  have : Finite (FullDimensionalMinimalPrime R) := finite_fullDimensionalMinimalPrime R
  have hsubset : fullDimensionalMinimalPrimesInSupport R M ⊆
      fullDimensionalMinimalPrimesInSupport R (R ⧸ p.asIdeal) :=
    fun _ hq ↦ Module.support_subset_of_injective e e.injective hq
  have hcard : (fullDimensionalMinimalPrimesInSupport R M).ncard ≤ 1 :=
    (Set.ncard_mono hsubset).trans
      (fullDimensionalMinimalPrimesInSupport_quotient_ncard_le_one p.asIdeal)
  by_cases hzero : fullDimensionalMinimalPrimesInSupport R M = ∅
  · rw [hzero, Set.ncard_empty, Nat.cast_zero]
    exact mul_nonneg (coeff_nonneg_of_computesHilbertSamuel hI hP hd)
      (by positivity)
  · obtain ⟨q, hq⟩ := Set.nonempty_iff_ne_empty.mpr hzero
    have hcount : ((fullDimensionalMinimalPrimesInSupport R M).ncard : ℚ) ≤ 1 := by
      exact_mod_cast hcard
    exact hcount.trans
      (one_le_factorial_mul_coeff_of_mem_fullDimensionalMinimalPrime hI hP hd hq)

/-- The top Hilbert–Samuel coefficient bounds the number of full-dimensional minimal primes in
the support of any finite module. -/
private theorem ncard_le_factorial_mul_coeff
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : I.radical = maximalIdeal R)
    {d : ℕ} (hd : ringKrullDim R = (d : WithBot ℕ∞)) (hdpos : 0 < d)
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∀ P : ℚ[X], ComputesHilbertSamuel R I M P →
      ((fullDimensionalMinimalPrimesInSupport R M).ncard : ℚ) ≤
        P.coeff d * (d.factorial : ℚ) := by
  induction ‹Module.Finite R M› using
    IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime with
  | subsingleton N =>
      intro P hP
      have hF : fullDimensionalMinimalPrimesInSupport R N = ∅ := by
        ext p
        simp [fullDimensionalMinimalPrimesInSupport, Module.support_eq_empty]
      rw [hF, Set.ncard_empty, Nat.cast_zero]
      exact mul_nonneg (coeff_nonneg_of_computesHilbertSamuel hI hP hd) (by positivity)
  | quotient N p e =>
      intro P hP
      exact ncard_le_factorial_mul_coeff_of_equiv_quotientPrime hI hP hd p e
  | exact N₁ N₂ N₃ f g hf hg hfg ih₁ ih₃ =>
      intro P₂ hP₂
      obtain ⟨P₁, hP₁⟩ := exists_computesHilbertSamuel (R := R) (M := N₁) I hI
      obtain ⟨P₃, hP₃⟩ := exists_computesHilbertSamuel (R := R) (M := N₃) I hI
      have hset := fullDimensionalMinimalPrimesInSupport_exact hfg hf hg
      have hcard : ((fullDimensionalMinimalPrimesInSupport R N₂).ncard : ℚ) ≤
          ((fullDimensionalMinimalPrimesInSupport R N₁).ncard : ℚ) +
            ((fullDimensionalMinimalPrimesInSupport R N₃).ncard : ℚ) := by
        have h := Set.ncard_union_le (fullDimensionalMinimalPrimesInSupport R N₁)
          (fullDimensionalMinimalPrimesInSupport R N₃)
        rw [← hset] at h
        exact_mod_cast h
      by_cases hfin : IsFiniteLength R N₁
      · have hF : fullDimensionalMinimalPrimesInSupport R N₁ = ∅ :=
          fullDimensionalMinimalPrimesInSupport_eq_empty_of_isFiniteLength hI hP₁ hfin hd hdpos
        rw [hF, Set.ncard_empty, Nat.cast_zero, zero_add] at hcard
        have hcoeff : P₃.coeff d ≤ P₂.coeff d :=
          coeff_le_of_surjective hI hP₂ hP₃ g hg hd hdpos
        calc
          ((fullDimensionalMinimalPrimesInSupport R N₂).ncard : ℚ)
              ≤ ((fullDimensionalMinimalPrimesInSupport R N₃).ncard : ℚ) := hcard
          _ ≤ P₃.coeff d * (d.factorial : ℚ) := ih₃ P₃ hP₃
          _ ≤ P₂.coeff d * (d.factorial : ℚ) :=
            mul_le_mul_of_nonneg_right hcoeff (by positivity)
      · have hcoeff := coeff_eq_add_of_exact_of_infinite_length hI hP₁ hP₂ hP₃
          hfg hf hg hfin hd
        calc
          ((fullDimensionalMinimalPrimesInSupport R N₂).ncard : ℚ)
              ≤ ((fullDimensionalMinimalPrimesInSupport R N₁).ncard : ℚ) +
                  ((fullDimensionalMinimalPrimesInSupport R N₃).ncard : ℚ) := hcard
          _ ≤ P₁.coeff d * (d.factorial : ℚ) +
              P₃.coeff d * (d.factorial : ℚ) := add_le_add (ih₁ P₁ hP₁) (ih₃ P₃ hP₃)
          _ = P₂.coeff d * (d.factorial : ℚ) := by rw [hcoeff]; ring

private lemma isHilbertSamuelPoly_of_computesHilbertSamuel
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {I : Ideal R} {P : ℚ[X]}
    (hP : ComputesHilbertSamuel R I M P) :
    HilbertSamuel.IsHilbertSamuelPoly I M P := by
  filter_upwards [hP] with n hn
  obtain ⟨q, hq1, hq2⟩ := hn
  rw [hq2, HilbertSamuel.hilbertSamuelFunction, hq1]
  simp

/-- **Stacks 0BWX.** In a Noetherian local ring, the number of minimal primes whose quotient
has the full dimension of the ring is at most the length of the quotient by a system of
parameters. -/
@[stacks 0BWX]
theorem natCard_fullDimensionalMinimalPrimes_le_length_quotient_of_isSystemOfParameters
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {gs : List R} (hgs : IsSystemOfParameters gs) :
    Module.length R (R ⧸ Ideal.ofList gs) ≠ ⊤ ∧
      (Nat.card {p : Ideal R // p ∈ minimalPrimes R ∧
        ringKrullDim (R ⧸ p) = ringKrullDim R} : ℕ∞) ≤
        Module.length R (R ⧸ Ideal.ofList gs) := by
  let I := Ideal.ofList gs
  let d := gs.length
  have hI : I.radical = maximalIdeal R := hgs.1
  have hd : ringKrullDim R = (d : WithBot ℕ∞) := hgs.2
  have hfin : Module.length R (R ⧸ I) ≠ ⊤ :=
    (length_quotient_lt_top_of_radical_eq_maximalIdeal hI).ne
  refine ⟨hfin, ?_⟩
  by_cases hd0 : d = 0
  · have hdim0 : ringKrullDim R = 0 := by simpa [hd0] using hd
    let : Ring.KrullDimLE 0 R :=
      ringKrullDimZero_iff_ringKrullDim_eq_zero.mpr hdim0
    let : Subsingleton (PrimeSpectrum R) :=
      Ring.KrullDimLE.subsingleton_primeSpectrum R
    have : Subsingleton (FullDimensionalMinimalPrime R) := ⟨by
      intro p q
      apply Subtype.ext
      exact congrArg PrimeSpectrum.asIdeal
        (Subsingleton.elim (⟨p.1, p.2.1.isPrime⟩ : PrimeSpectrum R)
          (⟨q.1, q.2.1.isPrime⟩ : PrimeSpectrum R))⟩
    have hcard : Nat.card (FullDimensionalMinimalPrime R) ≤ 1 := by
      rw [← Set.ncard_univ (FullDimensionalMinimalPrime R)]
      exact Set.ncard_le_one_of_subsingleton Set.univ
    exact (by exact_mod_cast hcard :
      (Nat.card (FullDimensionalMinimalPrime R) : ℕ∞) ≤ 1).trans
        (one_le_length_quotient_of_radical_eq_maximalIdeal hI)
  · have hdpos : 0 < d := Nat.pos_of_ne_zero hd0
    obtain ⟨P, hP⟩ := exists_computesHilbertSamuel (R := R) (M := R) I hI
    have hPdeg : P.degree = d :=
      degree_eq_of_supportDim_eq_ringKrullDim hI hP hd (Module.supportDim_self_eq_ringKrullDim R)
    obtain ⟨z, hz⟩ := exists_int_factorial_mul_leadingCoeff hPdeg
      (eventually_exists_int_eval_of_computesHilbertSamuel hP)
    have hznonneg : 0 ≤ z := by
      exact_mod_cast (hz ▸ mul_nonneg (nonneg_leadingCoeff_of_computesHilbertSamuel hP)
        (by positivity : (0 : ℚ) ≤ d.factorial))
    let e : ℕ := z.toNat
    have he : (e : ℚ) = P.leadingCoeff * (d.factorial : ℚ) := by
      rw [hz]
      exact_mod_cast Int.toNat_of_nonneg hznonneg
    have hlead : P.leadingCoeff = (e : ℚ) / gs.length.factorial := by
      apply (eq_div_iff (by positivity : (d.factorial : ℚ) ≠ 0)).mpr
      simpa [d] using he.symm
    have hbound := ncard_le_factorial_mul_coeff I hI hd hdpos R P hP
    rw [fullDimensionalMinimalPrimesInSupport_self, Set.ncard_univ,
      coeff_eq_leadingCoeff_of_degree_eq hPdeg, ← he] at hbound
    have hcard : Nat.card (FullDimensionalMinimalPrime R) ≤ e := by
      exact_mod_cast hbound
    have hmult := multiplicity_le_length_quotient_of_isSystemOfParameters
      hgs (isHilbertSamuelPoly_of_computesHilbertSamuel hP) hlead
    exact (by exact_mod_cast hcard :
      (Nat.card (FullDimensionalMinimalPrime R) : ℕ∞) ≤ e).trans hmult

end FullDimensionalMinimalPrimes
