module

public import Mathlib.Algebra.Lie.OfAssociative

/-!
# The module of relations of a sequence

Let `R` be a commutative ring, let `f_1, …, f_n ∈ R` and let `I = (f_1, …, f_n)`. Let `M` be the
`R`-module generated by symbols `e_1, …, e_n` subject to the relations `f_i e_j - f_j e_i = 0`, and
let `φ : M → R` be the `R`-linear map with `φ(e_i) = f_i`, whose range is `I`. Then there is a
short exact sequence `0 → K → M → I → 0` of `R`-modules with `K = ker φ` annihilated by `I`.

## Main definitions

* `Stacks.RelationsOfSequence.relSubmodule`: The submodule of `R^n` spanned by the `f_i e_j - f_j
  e_i`.
* `Stacks.RelationsOfSequence.relQuotient`: The module `M`, the quotient of `R^n` by
  `relSubmodule`.
* `Stacks.RelationsOfSequence.phi`: The map `M → R` sending `e_i` to `f_i`.
* `Stacks.RelationsOfSequence.idealI`: The ideal `I = (f_1, …, f_n)`.
* `Stacks.RelationsOfSequence.kerPhi`: The kernel `K` of `phi`.

## Main results

* `Stacks.RelationsOfSequence.short_exact`: The sequence `0 → K → M → I → 0` is exact.
* `Stacks.RelationsOfSequence.idealI_le_annihilator_kerPhi`: The kernel `K` is annihilated by `I`.
-/

@[expose] public section

namespace Stacks.RelationsOfSequence

variable {R : Type*} [CommRing R] {n : ℕ} (f : Fin n → R)

/-- The standard basis vector `e_i` in the free module `R^n`. -/
def e (i : Fin n) : Fin n → R :=
  Pi.single i 1

/-- The submodule of relations `N`, generated by all `f_i e_j - f_j e_i`. -/
def relSubmodule : Submodule R (Fin n → R) :=
  Submodule.span R { x | ∃ i j : Fin n, x = f i • (e j) - f j • (e i) }

/-- The relation `f i e_j - f j e_i` lies in the submodule of relations `N`. -/
theorem smul_e_sub_smul_e_mem_relSubmodule (i j : Fin n) :
    f i • e j - f j • e i ∈ relSubmodule f :=
  Submodule.subset_span ⟨i, j, rfl⟩

/-- The quotient of `Fin n → R` by the submodule of relations `relSubmodule f`. -/
abbrev relQuotient := (Fin n → R) ⧸ relSubmodule f

/-- The base map `F → R`, `e_i ↦ f_i`, given concretely by `x ↦ ∑ i, x i • f i`. -/
def baseMap : (Fin n → R) →ₗ[R] R := Fintype.linearCombination R f

/-- The base map sends the basis vector `e_i` to `f_i`. -/
@[simp]
theorem baseMap_e (j : Fin n) : baseMap f (e j) = f j := by
  rw [baseMap, e, Fintype.linearCombination_apply_single, one_smul]

/-- The submodule of relations `N` is contained in the kernel of the base map. -/
theorem relSubmodule_le_ker_baseMap : relSubmodule f ≤ LinearMap.ker (baseMap f) := by
  rw [relSubmodule, Submodule.span_le]
  rintro x ⟨i, j, rfl⟩
  simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub, map_smul, baseMap_e, smul_eq_mul]
  ring

/-- The map `φ : M → R` sending `ē_i` to `f_i`. -/
def phi : relQuotient f →ₗ[R] R :=
  (relSubmodule f).liftQ (baseMap f) (relSubmodule_le_ker_baseMap f)

/-- `φ` is computed on the class of `x ∈ R^n` by the base map. -/
@[simp]
theorem phi_mk (x : Fin n → R) :
    phi f (Submodule.Quotient.mk (p := relSubmodule f) x) = baseMap f x := rfl

/-- `φ` sends the class of the basis vector `e_i` to `f_i`. -/
@[simp]
theorem phi_mk_e (i : Fin n) :
    phi f (Submodule.Quotient.mk (p := relSubmodule f) (e i)) = f i := by
  simp

/-- The ideal `I = (f_1, …, f_n)`, viewed as an `R`-submodule of `R`. -/
def idealI : Ideal R := Ideal.span (Set.range f)

/-- Each `f_i` belongs to the ideal `I = (f_1, …, f_n)`. -/
theorem mem_idealI (i : Fin n) : f i ∈ idealI f :=
  Ideal.subset_span ⟨i, rfl⟩

/-- The kernel `K = ker φ`. -/
def kerPhi : Submodule R (relQuotient f) := LinearMap.ker (phi f)

/-- The kernel `K = ker φ`, under the name used in the Stacks 05ED statements. -/
abbrev K : Submodule R (relQuotient f) := kerPhi f

/-- An element of `M` lies in `K = ker φ` exactly when `φ` kills it. -/
@[simp]
theorem mem_kerPhi_iff {x : relQuotient f} : x ∈ kerPhi f ↔ phi f x = 0 :=
  LinearMap.mem_ker

/-- The range of `φ : M → R` is exactly the ideal `I = (f_1, …, f_n)`. -/
theorem range_phi : LinearMap.range (phi f) = idealI f := by
  rw [phi, Submodule.range_liftQ, baseMap, Fintype.range_linearCombination, idealI, Ideal.span]

/-- The sequence `0 → K → M → I → 0` is exact: the inclusion `K ↪ M` and `φ` are exact at `M`, and
the range of `φ` is the ideal `I = (f_1, …, f_n)`. -/
@[stacks 05ED]
theorem short_exact :
    Function.Exact (K f).subtype (phi f) ∧
      LinearMap.range (phi f) = (idealI f).restrictScalars R :=
  ⟨LinearMap.exact_subtype_ker_map (phi f), range_phi f⟩

/-- In `M`, the relation `f l • ē i = f i • ē l` holds. -/
theorem smul_mk_e (l i : Fin n) :
    f l • Submodule.Quotient.mk (p := relSubmodule f) (e i)
      = f i • Submodule.Quotient.mk (p := relSubmodule f) (e l) := by
  rw [← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
  exact smul_e_sub_smul_e_mem_relSubmodule f l i

/-- In `M`, `f l • x̄ = (baseMap f x) • ē l` for every `x ∈ R^n`. -/
theorem smul_mk_eq_baseMap_smul_mk_e (l : Fin n) (x : Fin n → R) :
    f l • Submodule.Quotient.mk (p := relSubmodule f) x
      = baseMap f x • Submodule.Quotient.mk (p := relSubmodule f) (e l) := by
  have hx : x = ∑ i, x i • e i := pi_eq_sum_univ' x
  conv_lhs => rw [hx]
  rw [← Submodule.mkQ_apply, map_sum, Finset.smul_sum, baseMap,
    Fintype.linearCombination_apply, Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_smul, smul_smul, mul_comm (f l),
    ← smul_smul, smul_mk_e f l i, smul_smul, smul_eq_mul]

/-- The ideal `I = (f_1, …, f_n)` is contained in the annihilator of `K = ker φ`. -/
theorem idealI_le_annihilator_kerPhi : idealI f ≤ (kerPhi f).annihilator := by
  rw [idealI, Ideal.span_le, Set.range_subset_iff]
  intro l
  rw [SetLike.mem_coe, Submodule.mem_annihilator]
  intro k hk
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ k
  rw [mem_kerPhi_iff, phi_mk] at hk
  rw [smul_mk_eq_baseMap_smul_mk_e f l x, hk, zero_smul]

/-- The kernel `K = ker φ` is annihilated by the ideal `I = (f_1, …, f_n)`. -/
@[stacks 05ED]
theorem K_annihilated : ∀ a ∈ idealI f, ∀ k ∈ K f, a • k = 0 :=
  fun _ ha k hk => Submodule.mem_annihilator.mp (idealI_le_annihilator_kerPhi f ha) k hk

/-- Every element of the ideal `I = (f_1, …, f_n)` annihilates every element of `K = ker φ`. -/
theorem smul_eq_zero_of_mem_idealI_of_mem_kerPhi {a : R} (ha : a ∈ idealI f)
    {k : relQuotient f} (hk : k ∈ kerPhi f) : a • k = 0 :=
  K_annihilated f a ha k hk

end Stacks.RelationsOfSequence
