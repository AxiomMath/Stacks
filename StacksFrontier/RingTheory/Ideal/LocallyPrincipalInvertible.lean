module

public import StacksFrontier.AlgebraicGeometry.InvertibleRankOneModule.Basic

/-!
# An ideal is invertible exactly when it is locally generated by a nonzerodivisor

Let `S` be a commutative ring and `J` an ideal of `S`. Then `J` is an invertible `S`-module
exactly when every maximal ideal of `S` avoids some `g ∈ S` for which the extension of `J` to the
localization `S_g` is generated by a single nonzerodivisor of `S_g`.

## Main results

* `Module.isFiniteLocallyFreeOfRank_of_forall_isMaximal`: finite local freeness of rank `r` from
  local data at the maximal ideals.
* `Ideal.exists_mem_nonZeroDivisors_span_eq_of_nonempty_basis`: an ideal which is free of rank one
  as a module is generated by a nonzerodivisor.
* `Ideal.localizedModuleAwayEquiv`: the localization of `J` away from `g` is the extension of `J`
  to `S_g`.
* `Ideal.exists_map_localization_away_eq_span_singleton`: the local hypothesis read off any
  localization of `S` away from `g`.
* `Ideal.invertible_of_forall_isMaximal_map_eq_span_singleton` and
  `Ideal.invertible_iff_forall_isMaximal_map_eq_span_singleton`: the characterization.

## Implementation notes

The localization of the module `↥J` is compared with the extended ideal `J · S_g` through
`Submodule.localized'`, whose underlying submodule of `S_g` is `Ideal.map (algebraMap S S_g) J`
and which is a localization of `↥J` by `Submodule.isLocalizedModule`. Invertibility is then
`Module.isFiniteLocallyFreeOfRank_one_iff_invertible`.

## References

* [Stacks Project, Tag 00NX](https://stacks.math.columbia.edu/tag/00NX)
* [Stacks Project, Tag 0AFW](https://stacks.math.columbia.edu/tag/0AFW)
-/

@[expose] public noncomputable section

universe u

namespace Module

/-- **Finite local freeness of rank `r` is a condition at the maximal ideals.** If every maximal
ideal of `R` avoids some `g` for which `M_g` has a basis indexed by `Fin r`, then such `g` generate
the unit ideal and `M` is finite locally free of rank `r`. -/
theorem isFiniteLocallyFreeOfRank_of_forall_isMaximal {R M : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] (r : ℕ)
    (h : ∀ p : Ideal R, p.IsMaximal → ∃ g : R, g ∉ p ∧
      Nonempty (Module.Basis (Fin r) (Localization.Away g)
        (LocalizedModule (Submonoid.powers g) M))) :
    Module.IsFiniteLocallyFreeOfRank R M r := by
  refine ⟨{g : R // Nonempty (Module.Basis (Fin r) (Localization.Away g)
      (LocalizedModule (Submonoid.powers g) M))}, Subtype.val, ?_, fun i => i.2⟩
  by_contra hne
  obtain ⟨p, hp, hle⟩ := Ideal.exists_le_maximal _ hne
  obtain ⟨g, hg, hb⟩ := h p hp
  exact hg (hle (Ideal.subset_span ⟨⟨g, hb⟩, rfl⟩))

end Module

namespace Ideal

variable {S : Type u} [CommRing S]

/-- **An ideal generated by a nonzerodivisor is free of rank one.** Multiplication by a
nonzerodivisor `t` is an injective endomorphism with image the ideal it generates. -/
theorem nonempty_basis_of_mem_nonZeroDivisors {A : Type u} [CommRing A] {t : A}
    (ht : t ∈ nonZeroDivisors A) :
    Nonempty (Module.Basis (Fin 1) A (Ideal.span {t})) := by
  have hinj : Function.Injective (LinearMap.toSpanSingleton A A t) := by
    intro x y hxy
    simp only [LinearMap.toSpanSingleton_apply, smul_eq_mul] at hxy
    exact sub_eq_zero.mp
      (mem_nonZeroDivisors_iff.mp ht |>.2 _ (by rw [sub_mul, hxy, sub_self]))
  exact ⟨(Module.Basis.singleton (Fin 1) A).map
    ((LinearEquiv.ofInjective _ hinj).trans (LinearEquiv.ofEq _ _
      (LinearMap.span_singleton_eq_range A A t).symm))⟩

/-- **An ideal which is free of rank one as a module is generated by a nonzerodivisor.** The image
of `1` under an isomorphism from the ring is such a generator. -/
theorem exists_mem_nonZeroDivisors_span_eq_of_nonempty_basis {A : Type u} [CommRing A]
    (K : Ideal A) (hb : Nonempty (Module.Basis (Fin 1) A K)) :
    ∃ t ∈ nonZeroDivisors A, K = Ideal.span {t} := by
  obtain ⟨b⟩ := hb
  let e : A ≃ₗ[A] K := (b.equiv (Module.Basis.singleton (Fin 1) A) (Equiv.refl (Fin 1))).symm
  have hval (c : A) : ((e c : K) : A) = c * ((e 1 : K) : A) := by
    rw [show c = c • (1 : A) from (mul_one c).symm, map_smul]
    simp
  refine ⟨((e 1 : K) : A), mem_nonZeroDivisors_iff.mpr ⟨fun c hc => ?_, fun c hc => ?_⟩, ?_⟩
  · exact e.injective (Subtype.ext (by rw [hval, mul_comm, hc, map_zero, ZeroMemClass.coe_zero]))
  · exact e.injective (Subtype.ext (by rw [hval, hc, map_zero, ZeroMemClass.coe_zero]))
  · refine le_antisymm (fun x hx => ?_) ?_
    · obtain ⟨c, hc⟩ := e.surjective ⟨x, hx⟩
      exact Ideal.mem_span_singleton'.mpr ⟨c, by rw [← hval, hc]⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact (e 1).2

/-- **The localization of an ideal away from `g` is its extension to the localized ring.** -/
def localizedModuleAwayEquiv (J : Ideal S) (g : S) :
    LocalizedModule (Submonoid.powers g) J ≃ₗ[Localization.Away g]
      (J.map (algebraMap S (Localization.Away g)) : Ideal (Localization.Away g)) :=
  have := IsLocalization.linearMap_compatibleSMul (Submonoid.powers g)
    (S := Localization.Away g)
  ((IsLocalizedModule.linearEquiv (Submonoid.powers g)
      (J.toLocalized' (Localization.Away g) (Submonoid.powers g)
        (Algebra.linearMap S (Localization.Away g)))
      (LocalizedModule.mkLinearMap _ _)).restrictScalars (Localization.Away g)).symm.trans
    (LinearEquiv.ofEq _ _ (by rw [Submodule.localized'_eq_span]; rfl))

/-- **The local hypothesis may be read off any localization away from `g`.** If `J` extends to the
ideal generated by a nonzerodivisor in some localization `A` of `S` away from `g`, the same holds
in `Localization.Away g`, the two being isomorphic as `S`-algebras. -/
theorem exists_map_localization_away_eq_span_singleton {A : Type u} [CommRing A] [Algebra S A]
    (g : S) [IsLocalization.Away g A] (J : Ideal S) {t : A} (ht : t ∈ nonZeroDivisors A)
    (hJ : J.map (algebraMap S A) = Ideal.span {t}) :
    ∃ t' ∈ nonZeroDivisors (Localization.Away g),
      J.map (algebraMap S (Localization.Away g)) = Ideal.span {t'} := by
  let e := IsLocalization.algEquiv (Submonoid.powers g) A (Localization.Away g)
  refine ⟨e t, MulEquivClass.map_nonZeroDivisors e ▸ Submonoid.mem_map_of_mem _ ht, ?_⟩
  have hcomp : algebraMap S (Localization.Away g) =
      (e : A →+* Localization.Away g).comp (algebraMap S A) := by
    ext x; exact (e.commutes x).symm
  rw [hcomp, ← Ideal.map_map, hJ, Ideal.map_span, Set.image_singleton]
  rfl

/-- **An ideal locally generated by a nonzerodivisor is invertible.** If every maximal ideal of `S`
avoids some `g` for which `J · S_g` is generated by a nonzerodivisor, then `J` is finite locally
free of rank one, hence an invertible `S`-module. -/
theorem invertible_of_forall_isMaximal_map_eq_span_singleton (J : Ideal S)
    (h : ∀ p : Ideal S, p.IsMaximal → ∃ g : S, g ∉ p ∧
      ∃ t ∈ nonZeroDivisors (Localization.Away g),
        J.map (algebraMap S (Localization.Away g)) = Ideal.span {t}) :
    Module.Invertible S J :=
  Module.isFiniteLocallyFreeOfRank_one_iff_invertible.mp
    (Module.isFiniteLocallyFreeOfRank_of_forall_isMaximal 1 fun p hp => by
      obtain ⟨g, hg, t, ht, hJ⟩ := h p hp
      exact ⟨g, hg, ⟨((nonempty_basis_of_mem_nonZeroDivisors ht).some.map
        (LinearEquiv.ofEq _ _ hJ.symm)).map (J.localizedModuleAwayEquiv g).symm⟩⟩)

/-- **An ideal is invertible exactly when it is locally generated by a nonzerodivisor.** The
covering may be taken by the standard opens `D(g)` for `g` avoiding one maximal ideal each. -/
theorem invertible_iff_forall_isMaximal_map_eq_span_singleton (J : Ideal S) :
    Module.Invertible S J ↔ ∀ p : Ideal S, p.IsMaximal → ∃ g : S, g ∉ p ∧
      ∃ t ∈ nonZeroDivisors (Localization.Away g),
        J.map (algebraMap S (Localization.Away g)) = Ideal.span {t} := by
  refine ⟨fun hinv p hp => ?_, invertible_of_forall_isMaximal_map_eq_span_singleton J⟩
  obtain ⟨ι, f, hspan, hbasis⟩ :=
    Module.isFiniteLocallyFreeOfRank_one_iff_invertible.mpr hinv
  obtain ⟨-, ⟨i, rfl⟩, hfi⟩ := Set.not_subset.mp (fun hsub =>
    hp.ne_top (top_le_iff.mp (hspan ▸ Ideal.span_le.mpr hsub)))
  obtain ⟨t, ht, hK⟩ := exists_mem_nonZeroDivisors_span_eq_of_nonempty_basis
    (J.map (algebraMap S (Localization.Away (f i))))
    ((hbasis i).map fun b => b.map (J.localizedModuleAwayEquiv (f i)))
  exact ⟨f i, hfi, t, ht, hK⟩

end Ideal

end
