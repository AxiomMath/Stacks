module

public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.RingTheory.Ideal.Operations
public import StacksFrontier.RingTheory.Koszul.Quasiregular
public import StacksFrontier.RingTheory.Sequence.QuasiRegular.DegreeOne

/-!
# An invertible change of generators of an ideal

Let `R` be a commutative ring, let `v : Fin n → R` and let `b` be an `n × n` matrix over `R`.
The ideal generated by `b *ᵥ v` is contained in the ideal generated by `v`, with equality as
soon as the determinant of `b` is a unit, since then `v = b⁻¹ *ᵥ (b *ᵥ v)`.

This is the closing step of item (3) of Stacks tag 063W.  There the ideal of the containing
subscheme `Z` of item (1) is generated by a family `f` and the ideal of `T` by a family `g` of
the same length, with `f = b *ᵥ g` because `T ⊆ Z`;  the two ideals agree wherever `det b` is a
unit, which near the point in question is everywhere.

Over a Noetherian local ring the determinant is a unit as soon as `f` is a regular sequence
lying in the maximal ideal:  writing `g = a *ᵥ f` as well, the matrix `b * a - 1` kills `f`, so
degree-one quasi-regularity puts all of its entries in `(f)` and hence in the maximal ideal,
whence `det b · det a = 1` in the residue field.

## Main results

* `Stacks.RingTheory.span_range_mulVec_le`: a matrix combination of a family generates a
  sub-ideal of the ideal the family generates.
* `Stacks.RingTheory.span_range_mulVec_eq_of_isUnit_det`: equality when the determinant is a
  unit.
* `Stacks.RingTheory.isUnit_det_of_isWeaklyRegular_of_span_eq`: over a Noetherian local ring a
  change of generators out of a regular sequence has unit determinant.
* `Stacks.RingTheory.exists_matrix_isUnit_det_map`: the same, with the matrix produced over a
  ring mapping to that local ring.

## References

* [Stacks Project, Lemma 31.22.8 (Tag 063W)](https://stacks.math.columbia.edu/tag/063W)
-/

@[expose] public section

open Matrix

namespace Stacks.RingTheory

variable {R : Type*} [CommRing R] {n : ℕ}

/-- **A matrix combination of a family generates a sub-ideal of the ideal it generates.** -/
theorem span_range_mulVec_le (b : Matrix (Fin n) (Fin n) R) (v : Fin n → R) :
    Ideal.span (Set.range (b *ᵥ v)) ≤ Ideal.span (Set.range v) := by
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  show ∑ j, b i j * v j ∈ Ideal.span (Set.range v)
  exact Submodule.sum_mem _ fun j _ =>
    Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self j))

/-- **An invertible change of generators does not change the ideal.** -/
theorem span_range_mulVec_eq_of_isUnit_det (b : Matrix (Fin n) (Fin n) R) (hb : IsUnit b.det)
    (v : Fin n → R) :
    Ideal.span (Set.range (b *ᵥ v)) = Ideal.span (Set.range v) := by
  refine le_antisymm (span_range_mulVec_le b v) ?_
  have hv : b⁻¹ *ᵥ (b *ᵥ v) = v := by
    rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul b hb, Matrix.one_mulVec]
  have h := span_range_mulVec_le b⁻¹ (b *ᵥ v)
  rwa [hv] at h

/-- A family lying in the ideal generated by `v` is a matrix combination of `v`. -/
private theorem exists_matrix_mulVec_eq {S : Type*} [CommRing S] (v w : Fin n → S)
    (h : ∀ i, w i ∈ Ideal.span (Set.range v)) :
    ∃ b : Matrix (Fin n) (Fin n) S, w = b *ᵥ v := by
  choose B hB using fun i => (Submodule.mem_span_range_iff_exists_fun S).mp (h i)
  exact ⟨Matrix.of B, funext fun i => by simpa [Matrix.mulVec, dotProduct, eq_comm] using
    (hB i).symm⟩

/-- **In a Noetherian local ring, a change of generators out of a regular sequence has unit
determinant.**  If a weakly regular sequence `f` of length `n` lying in the maximal ideal and a
family `g` of the same length generate the same ideal, any matrix with `f = b *ᵥ g` has unit
determinant. -/
theorem isUnit_det_of_isWeaklyRegular_of_span_eq [IsNoetherianRing R] [IsLocalRing R]
    (f g : Fin n → R) (b : Matrix (Fin n) (Fin n) R)
    (hfg : f = b *ᵥ g)
    (hf : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn f))
    (hfm : ∀ i, f i ∈ IsLocalRing.maximalIdeal R)
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    IsUnit b.det := by
  classical
  let : Field (R ⧸ IsLocalRing.maximalIdeal R) := Ideal.Quotient.field _
  have hreg : RingTheory.Sequence.IsRegular R (List.ofFn f) :=
    RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal R
      (fun r hr => by obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hr; exact hfm i) hf
  have hqr : RingTheory.Sequence.IsQuasiRegular R (List.ofFn f) :=
    ((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae (M := R) f hfm).2.out 1 4).mp hreg
  have hJle : Ideal.span (Set.range f) ≤ IsLocalRing.maximalIdeal R :=
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hfm i)
  have hgmem : ∀ j, g j ∈ Ideal.span (Set.range f) := fun j => by
    rw [hspan]; exact Ideal.subset_span (Set.mem_range_self j)
  obtain ⟨A, haf⟩ := exists_matrix_mulVec_eq f g hgmem
  have hbaf : (b * A) *ᵥ f = f := by
    rw [← Matrix.mulVec_mulVec, ← haf, ← hfg]
  have hd : ∀ i k, (b * A) i k - (1 : Matrix (Fin n) (Fin n) R) i k ∈
      IsLocalRing.maximalIdeal R := by
    intro i k
    have hzero : ∑ l, ((b * A) i l - (1 : Matrix (Fin n) (Fin n) R) i l) * f l = 0 := by
      have h1 : ∑ l, (b * A) i l * f l = f i := congrFun hbaf i
      have h2 : ∑ l, (1 : Matrix (Fin n) (Fin n) R) i l * f l = f i :=
        congrFun (Matrix.one_mulVec f) i
      simp only [sub_mul, Finset.sum_sub_distrib, h1, h2, sub_self]
    exact hJle (hqr.coeff_mem_Jid _ (by rw [hzero]; exact zero_mem _) k)
  have hmap : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)).mapMatrix (b * A) = 1 := by
    ext i k
    have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hd i k)
    rw [map_sub, sub_eq_zero] at h0
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, h0]
    simp [Matrix.one_apply, apply_ite]
  have hdet : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) b.det *
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal R) A.det = 1 := by
    rw [← map_mul, ← Matrix.det_mul, RingHom.map_det, hmap, Matrix.det_one]
  refine IsLocalRing.notMem_maximalIdeal.mp fun hmem => ?_
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, zero_mul] at hdet
  exact zero_ne_one hdet

/-- **The change of generators, over a ring mapping to a Noetherian local ring.**  If `a` is a
family of elements of the ideal generated by a family `g` of the same length, and the image of
`a` in a Noetherian local ring `R` is a regular sequence in the maximal ideal generating the
same ideal as the image of `g`, then a matrix carrying `g` to `a` can be chosen with unit
determinant in `R`. -/
theorem exists_matrix_isUnit_det_map {A : Type*} [CommRing A] [IsNoetherianRing R]
    [IsLocalRing R] (φ : A →+* R) (a g : Fin n → A)
    (ha : ∀ i, a i ∈ Ideal.span (Set.range g))
    (hreg : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn fun i => φ (a i)))
    (hmem : ∀ i, φ (a i) ∈ IsLocalRing.maximalIdeal R)
    (hspan : Ideal.span (Set.range fun i => φ (a i))
      = Ideal.span (Set.range fun j => φ (g j))) :
    ∃ b : Matrix (Fin n) (Fin n) A, a = b *ᵥ g ∧ IsUnit (φ b.det) := by
  classical
  obtain ⟨B, hB⟩ := exists_matrix_mulVec_eq g a ha
  refine ⟨B, hB, ?_⟩
  rw [RingHom.map_det]
  refine isUnit_det_of_isWeaklyRegular_of_span_eq (fun i => φ (a i)) (fun j => φ (g j))
    (φ.mapMatrix B) (funext fun i => ?_) hreg hmem hspan
  subst hB
  exact RingHom.map_mulVec φ B g i

end Stacks.RingTheory

end
