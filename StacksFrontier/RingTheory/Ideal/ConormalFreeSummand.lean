/-!
# Free summands of the conormal module lift to regular sequences

Let `I` be an ideal in a Noetherian local ring `R`. If `I`, regarded as an `R`-module, has
finite projective dimension, then every finite-rank free direct summand of the conormal module
`I/I²` is generated by the classes of a regular sequence contained in `I`, provided `I` is
proper when the rank is positive. In the rank one case this says that a direct summand of
`I/I²` isomorphic to `R/I` is generated by the class of a nonzerodivisor of `R` lying in `I`.

## Main results

* `Ideal.exists_isRegular_of_isCompl_cotangent`: a free direct summand of `I.Cotangent` of
  rank `r` is spanned by the classes of a length `r` regular sequence in `I`.
* `Ideal.exists_isRegular_generator_of_isCompl_cotangent`: a direct summand of `I.Cotangent`
  isomorphic to `R/I` is spanned by the class of a nonzerodivisor belonging to `I`.

## Implementation notes

The source statement of tag 0FJR omits the properness condition needed at positive rank: for
`I = ⊤` the zero conormal module is free of any finite rank over the zero quotient ring,
whereas a nonempty regular sequence cannot generate the unit ideal in a local ring. Hence the
hypothesis `r = 0 ∨ I ≠ ⊤`, which is the positive-rank properness correction. The assertion
that the summand `F` is free of rank `r` is represented by a basis indexed by `Fin r`, and the
assertion that it is a direct summand by the existence of a complementary submodule. The
conclusion records equality with the span of the residue classes, so it says precisely that
those classes generate the specified summand `F`, rather than merely some isomorphic copy.

The two statements are proved here in the opposite order to the usual one. Customarily the
rank one case is settled first, using only the theory of associated primes and of exactness of
complexes of finite free modules over a Noetherian local ring: finiteness of the set of
associated primes, the identification of the union of the associated primes with the set of
zerodivisors, Nakayama's lemma, and prime avoidance in the form permitting two non-prime
members, so that the finitely many associated primes can be avoided along with the single
ideal `𝔪·J + I²`; finite projective dimension enters only through the exactness criterion for
complexes of finite free modules, and only in order to produce a single nonzerodivisor of `R`
lying in `I`. The general case then follows by induction on the rank, each step cutting down
along `R → R/xR` and transporting finite projective dimension across that map.

The development here instead establishes the general rank `r` case directly, by strong
induction on `r`: prime avoidance produces a nonzerodivisor `x ∈ I` whose class is primitive in
`F`, and passing to `R/xR` the extended ideal again has finite projective dimension while the
image of `F` is a free direct summand of rank `r - 1` of the conormal module of the extended
ideal. The rank one case is then the specialisation to `r = 1`, a free `R/I`-module of rank one
being the same thing as a module isomorphic to `R/I`. The two orders are consistent: the
general statement proved here does not depend on the rank one statement, so nothing is
circular.

## References

* [W. V. Vasconcelos, *Ideals generated by R-sequences*][Vasconcelos]
* [Stacks Project, Tag 0FJQ](https://stacks.math.columbia.edu/tag/0FJQ)
* [Stacks Project, Tag 0FJR](https://stacks.math.columbia.edu/tag/0FJR)
-/

@[expose] public section

open CategoryTheory
open scoped Pointwise

universe u

namespace Ideal

private theorem exists_isRegular_of_basis_fin_zero
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (F : Submodule (R ⧸ I) I.Cotangent)
    (hfree : Nonempty (Module.Basis (Fin 0) (R ⧸ I) F)) :
    ∃ x : Fin 0 → I,
      RingTheory.Sequence.IsRegular R (List.ofFn fun i ↦ (x i : R)) ∧
        Submodule.span (R ⧸ I) (Set.range fun i ↦ I.toCotangent (x i)) = F := by
  let b := hfree.some
  have hF : F = ⊥ := by
    apply le_antisymm _ bot_le
    intro x hx
    have hx0 : (⟨x, hx⟩ : F) = 0 := b.repr.injective (Subsingleton.elim _ _)
    simpa using congrArg Subtype.val hx0
  refine ⟨isEmptyElim, ?_, ?_⟩
  · simpa using RingTheory.Sequence.IsRegular.nil R R
  · simp [hF]

private theorem quotSMulTop_map_ker_subtype_injective {R F M : Type*} [CommRing R]
    [AddCommGroup F] [Module R F] [AddCommGroup M] [Module R M] {x : R} (π : F →ₗ[R] M)
    (hxM : IsSMulRegular M x) :
    Function.Injective (QuotSMulTop.map x (LinearMap.ker π).subtype) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro a ha
  obtain ⟨a', rfl⟩ := Submodule.Quotient.mk_surjective _ a
  rw [QuotSMulTop.map_apply_mk] at ha
  rw [Submodule.Quotient.mk_eq_zero] at ha ⊢
  obtain ⟨f, -, hf⟩ := (Submodule.mem_smul_pointwise_iff_exists _ x _).mp ha
  have h0 : x • π f = x • (0 : M) := by
    rw [smul_zero, ← map_smul, hf]
    exact a'.2
  exact (Submodule.mem_smul_pointwise_iff_exists _ x _).mpr
    ⟨⟨f, hxM h0⟩, trivial, Subtype.ext hf⟩

/-- A projective module has projective dimension below `n + 1`. -/
private theorem hasProjectiveDimensionLT_succ_of_projective {R : Type u} [CommRing R]
    {P : Type u} [AddCommGroup P] [Module R P] [Module.Projective R P] (n : ℕ) :
    HasProjectiveDimensionLT (ModuleCat.of R P) (n + 1) := by
  have : HasProjectiveDimensionLT (ModuleCat.of R P) 1 :=
    projective_iff_hasProjectiveDimensionLT_one.mp inferInstance
  infer_instance

/-- The kernel of a surjection from a projective module onto a module of projective dimension
`≤ n + 1` has projective dimension `≤ n`. -/
private theorem hasProjectiveDimensionLE_ker_of_surjective {R : Type u} [CommRing R]
    {P M : Type u} [AddCommGroup P] [Module R P] [Module.Projective R P] [AddCommGroup M]
    [Module R M] {π : P →ₗ[R] M} (hπ : Function.Surjective π) {n : ℕ}
    (h : HasProjectiveDimensionLE (ModuleCat.of R M) (n + 1)) :
    HasProjectiveDimensionLE (ModuleCat.of R (LinearMap.ker π)) n :=
  (LinearMap.shortExact_shortComplexKer hπ).hasProjectiveDimensionLT_X₁ (n + 1)
    (hasProjectiveDimensionLT_succ_of_projective n) h

/-- A finite module of projective dimension `≤ 0` over a local ring is free. -/
private theorem free_of_hasProjectiveDimensionLE_zero {R : Type u} [CommRing R] [IsLocalRing R]
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (h : HasProjectiveDimensionLE (ModuleCat.of R M) 0) : Module.Free R M := by
  rw [← projective_iff_hasProjectiveDimensionLE_zero, ← IsProjective.iff_projective] at h
  exact Module.free_of_flat_of_isLocalRing

/-- Change of rings along a regular element: if `x` is regular on the ring and on a finite
module `M`, then `M / xM` has finite projective dimension over `R / xR` whenever `M` does over
`R`. This is the quotient-ring form needed by the induction below. -/
@[ega "0 17.3.1.4" "more general"]
private theorem hasProjectiveDimensionLE_quotSMulTop
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {x : R}
    (hx : IsSMulRegular R x) :
    ∀ (n : ℕ) (M : Type u) (_ : AddCommGroup M) (_ : Module R M) (_ : Module.Finite R M),
      IsSMulRegular M x →
        CategoryTheory.HasProjectiveDimensionLE (ModuleCat.of R M) n →
        CategoryTheory.HasProjectiveDimensionLE
          (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R)) (QuotSMulTop x M)) n := by
  have hxreg : IsRegular x := isLeftRegular_iff_isRegular.mp hx
  intro n
  induction n with
  | zero =>
      intro M _ _ _ _ h
      have : Module.Free R M := free_of_hasProjectiveDimensionLE_zero M h
      rw [← projective_iff_hasProjectiveDimensionLE_zero, ← IsProjective.iff_projective]
      exact Module.Projective.of_free
  | succ n ih =>
      intro M _ _ _ hxM h
      obtain ⟨F, _, _, _, _, π, hπ⟩ := Module.exists_finite_presentation R M
      have hxF : IsSMulRegular F x := Module.Flat.isSMulRegular_of_isRegular hxreg
      have hxN : IsSMulRegular ↥(LinearMap.ker π) x := IsSMulRegular.submodule _ x hxF
      have hN := hasProjectiveDimensionLE_ker_of_surjective hπ h
      have hNq := ih ↥(LinearMap.ker π) inferInstance inferInstance inferInstance hxN hN
      have hsurj : Function.Surjective
          (algebraMap R (R ⧸ Ideal.span ({x} : Set R))) := Ideal.Quotient.mk_surjective
      let f' : QuotSMulTop x ↥(LinearMap.ker π) →ₗ[R ⧸ Ideal.span ({x} : Set R)]
          QuotSMulTop x F :=
        (QuotSMulTop.map x (LinearMap.ker π).subtype).extendScalarsOfSurjective hsurj
      let g' : QuotSMulTop x F →ₗ[R ⧸ Ideal.span ({x} : Set R)] QuotSMulTop x M :=
        (QuotSMulTop.map x π).extendScalarsOfSurjective hsurj
      have hex : Function.Exact f' g' :=
        QuotSMulTop.map_exact x (LinearMap.exact_subtype_ker_map π) hπ
      have heq0 : g'.comp f' = 0 := LinearMap.ext fun a => hex.apply_apply_eq_zero a
      have hinj : Function.Injective f' := quotSMulTop_map_ker_subtype_injective π hxM
      have hsur : Function.Surjective g' := QuotSMulTop.map_surjective x hπ
      have hS' : (ModuleCat.shortComplexOfCompEqZero f' g' heq0).ShortExact :=
        { exact := ModuleCat.shortComplex_exact _ hex
          mono_f := (ModuleCat.mono_iff_injective _).mpr hinj
          epi_g := (ModuleCat.epi_iff_surjective _).mpr hsur }
      exact hS'.hasProjectiveDimensionLT_X₃ (n + 1) hNq
        (hasProjectiveDimensionLT_succ_of_projective (n + 1))

/-- Apply the change-of-rings bound to the ideal itself. -/
private theorem hasProjectiveDimensionLE_quotSMulTop_ideal
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) {x : R} (hx : IsSMulRegular R x)
    (hpd : Module.projectiveDimension R I ≠ ⊤) :
    ∃ n : ℕ, CategoryTheory.HasProjectiveDimensionLE
      (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R)) (QuotSMulTop x I)) n := by
  obtain ⟨n, hn⟩ :=
    (CategoryTheory.projectiveDimension_ne_top_iff (ModuleCat.of R I)).mp hpd
  have hIreg : IsSMulRegular I x := IsSMulRegular.submodule I x hx
  exact ⟨n, hasProjectiveDimensionLE_quotSMulTop (R := R) hx n I
    inferInstance inferInstance inferInstance hIreg hn⟩

/-- Finite projective dimension passes to a split quotient of modules. -/
private theorem projectiveDimension_ne_top_of_splitLinearMap
    {R : Type u} [CommRing R]
    (M N : Type u) [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) (s : N →ₗ[R] M) (hfs : f.comp s = LinearMap.id)
    (hpd : Module.projectiveDimension R M ≠ ⊤) :
    Module.projectiveDimension R N ≠ ⊤ := by
  change CategoryTheory.projectiveDimension (ModuleCat.of R N) ≠ ⊤
  have hpdM : CategoryTheory.projectiveDimension (ModuleCat.of R M) ≠ ⊤ := by
    change Module.projectiveDimension R M ≠ ⊤
    exact hpd
  obtain ⟨n, hn⟩ :=
    (CategoryTheory.projectiveDimension_ne_top_iff (ModuleCat.of R M)).mp hpdM
  let ρ : Retract (ModuleCat.of R N) (ModuleCat.of R M) :=
    { i := ModuleCat.ofHom s
      r := ModuleCat.ofHom f
      retract := by
        change ModuleCat.ofHom (f.comp s) = ModuleCat.ofHom LinearMap.id
        rw [hfs] }
  rw [CategoryTheory.projectiveDimension_ne_top_iff]
  have := hn
  exact ⟨n, ρ.hasProjectiveDimensionLT (n + 1)⟩

private theorem exists_surjective_forall_mem_maximalIdeal_of_mem_ker
    {R : Type u} [CommRing R] [IsLocalRing R]
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∃ (n : ℕ) (f : (Fin n → R) →ₗ[R] M), Function.Surjective f ∧
      ∀ a ∈ LinearMap.ker f, ∀ i, a i ∈ IsLocalRing.maximalIdeal R := by
  classical
  suffices H : ∀ (N : ℕ) (g : Fin N → M), Submodule.span R (Set.range g) = ⊤ →
      ∃ (n : ℕ) (f : (Fin n → R) →ₗ[R] M), Function.Surjective f ∧
        ∀ a ∈ LinearMap.ker f, ∀ i, a i ∈ IsLocalRing.maximalIdeal R by
    obtain ⟨N, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := M)
    exact H N g hg
  intro N
  induction N with
  | zero =>
      intro g hg
      refine ⟨0, Fintype.linearCombination R g, ?_, fun a _ i => absurd i.2 (by omega)⟩
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hg]
  | succ N ih =>
      intro g hg
      by_cases hker : ∀ a ∈ LinearMap.ker (Fintype.linearCombination R g), ∀ i,
          a i ∈ IsLocalRing.maximalIdeal R
      · refine ⟨N + 1, Fintype.linearCombination R g, ?_, hker⟩
        rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hg]
      · rw [not_forall] at hker
        obtain ⟨a, hker⟩ := hker
        rw [not_imp, not_forall] at hker
        obtain ⟨ha, i, hai⟩ := hker
        have hu : IsUnit (a i) := IsLocalRing.notMem_maximalIdeal.mp hai
        obtain ⟨v, hv⟩ := isUnit_iff_exists_inv'.mp hu
        refine ih (g ∘ i.succAbove) (top_le_iff.mp ?_)
        rw [← hg, Submodule.span_le, Set.range_subset_iff]
        intro j
        change g j ∈ Submodule.span R (Set.range (g ∘ i.succAbove))
        by_cases hj : j = i
        · subst hj
          have hsum : a j • g j + ∑ k : Fin N, a (j.succAbove k) • g (j.succAbove k) = 0 := by
            have h2 := LinearMap.mem_ker.mp ha
            rwa [Fintype.linearCombination_apply, Fin.sum_univ_succAbove _ j] at h2
          have hmem : a j • g j ∈ Submodule.span R (Set.range (g ∘ j.succAbove)) := by
            rw [eq_neg_of_add_eq_zero_left hsum]
            exact neg_mem (Submodule.sum_mem _ fun k _ =>
              Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩))
          have hgj : g j = v • (a j • g j) := by rw [← mul_smul, hv, one_smul]
          rw [hgj]
          exact Submodule.smul_mem _ _ hmem
        · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hj
          exact Submodule.subset_span ⟨k, rfl⟩

private theorem subsingleton_of_free_of_smul_eq_zero {S N : Type*} [CommRing S]
    [AddCommGroup N] [Module S N] [Module.Free S N] {y : S} (hy : y ≠ 0)
    (h : ∀ n : N, y • n = 0) : Subsingleton N := by
  rcases subsingleton_or_nontrivial N with hN | hN
  · exact hN
  · let b := Module.Free.chooseBasis S N
    obtain ⟨i⟩ := b.index_nonempty
    exact (hy (by simpa using congrArg (fun z => b.repr z i) (h (b i)))).elim

private theorem free_of_hasProjectiveDimensionLE_of_mul_eq_zero
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {y : R} (hy : y ≠ 0)
    (hann : ∀ c ∈ IsLocalRing.maximalIdeal R, c * y = 0) :
    ∀ (n : ℕ) (M : Type u) (_ : AddCommGroup M) (_ : Module R M) (_ : Module.Finite R M),
      CategoryTheory.HasProjectiveDimensionLE (ModuleCat.of R M) n → Module.Free R M := by
  intro n
  induction n with
  | zero =>
      intro M _ _ _ h
      exact free_of_hasProjectiveDimensionLE_zero M h
  | succ n ih =>
      intro M _ _ _ h
      obtain ⟨m, f, hf, hker⟩ :=
        exists_surjective_forall_mem_maximalIdeal_of_mem_ker (R := R) M
      have hN := hasProjectiveDimensionLE_ker_of_surjective hf h
      have hNfree : Module.Free R ↥(LinearMap.ker f) :=
        ih ↥(LinearMap.ker f) inferInstance inferInstance inferInstance hN
      have hbot : LinearMap.ker f = ⊥ := by
        have := subsingleton_of_free_of_smul_eq_zero hy fun n : LinearMap.ker f =>
          Subtype.ext (funext fun j => by
            change y * ((n : Fin m → R)) j = 0
            rw [mul_comm]
            exact hann _ (hker _ n.2 j))
        exact Submodule.eq_bot_of_subsingleton
      exact Module.Free.of_equiv (LinearEquiv.ofBijective f ⟨LinearMap.ker_eq_bot.mp hbot, hf⟩)

private theorem projectiveDimension_map_ne_top
    {R : Type u} [CommRing R] [IsNoetherianRing R]
    (I : Ideal R) (p : Ideal R) [p.IsPrime]
    (hpd : Module.projectiveDimension R I ≠ ⊤) :
    Module.projectiveDimension (Localization.AtPrime p)
      (I.map (algebraMap R (Localization.AtPrime p))) ≠ ⊤ := by
  let e : LocalizedModule p.primeCompl I ≃ₗ[Localization.AtPrime p]
      I.map (algebraMap R (Localization.AtPrime p)) :=
    LinearEquiv.extendScalarsOfIsLocalization p.primeCompl (Localization.AtPrime p)
      (IsLocalizedModule.linearEquiv p.primeCompl
        (LocalizedModule.mkLinearMap p.primeCompl I)
        (Algebra.idealMap I (S := Localization.AtPrime p)))
  obtain ⟨n, hn⟩ :=
    (CategoryTheory.projectiveDimension_ne_top_iff (ModuleCat.of R I)).mp hpd
  have hloc := projectiveDimension_localization_le R p.primeCompl I n hn
  have heq : Module.projectiveDimension (Localization.AtPrime p) (LocalizedModule p.primeCompl I) =
      Module.projectiveDimension (Localization.AtPrime p)
        (I.map (algebraMap R (Localization.AtPrime p))) :=
    ModuleCat.projectiveDimension_eq_of_linearEquiv e
  rw [← heq]
  exact (CategoryTheory.projectiveDimension_ne_top_iff
    (ModuleCat.of (Localization.AtPrime p) (LocalizedModule p.primeCompl I))).mpr ⟨n, hloc⟩

private theorem mem_of_smul_basis_eq_zero {R : Type u} [CommRing R] {I : Ideal R}
    {F : Submodule (R ⧸ I) I.Cotangent} {ι : Type*} (b : Module.Basis ι (R ⧸ I) F) (i : ι)
    {s : R} (hs : s • (b i : I.Cotangent) = 0) : s ∈ I := by
  have hsb : algebraMap R (R ⧸ I) s • b i = 0 := by
    apply Subtype.ext
    change algebraMap R (R ⧸ I) s • (b i : I.Cotangent) = 0
    rw [IsScalarTower.algebraMap_smul (A := R ⧸ I)]
    exact hs
  have hcoef : Finsupp.single i (algebraMap R (R ⧸ I) s) = 0 := by
    simpa using congrArg b.repr hsb
  have hsmem : algebraMap R (R ⧸ I) s ∈ (⊥ : Ideal (R ⧸ I)) := by
    simpa using congrArg (fun f : ι →₀ R ⧸ I => f i) hcoef
  have hmk : Ideal.Quotient.mk I s = 0 := by simpa using hsmem
  exact Ideal.Quotient.eq_zero_iff_mem.mp hmk

private theorem ideal_not_le_associatedPrime
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (r : ℕ) (F : Submodule (R ⧸ I) I.Cotangent)
    (hpd : Module.projectiveDimension R I ≠ ⊤)
    (hfree : Nonempty (Module.Basis (Fin r) (R ⧸ I) F)) (hr : 0 < r)
    (p : Ideal R) (hp : p ∈ associatedPrimes R R) : ¬ I ≤ p := by
  classical
  intro hIp
  let : p.IsPrime := hp.isPrime
  let S := Localization.AtPrime p
  let J := I.map (algebraMap R S)
  have hpdJ : Module.projectiveDimension S J ≠ ⊤ :=
    projectiveDimension_map_ne_top I p hpd
  obtain ⟨n, hn⟩ := (CategoryTheory.projectiveDimension_ne_top_iff (ModuleCat.of S J)).mp hpdJ
  have hpS : IsLocalRing.maximalIdeal S ∈ associatedPrimes S S :=
    Module.associatedPrimes.mem_associatedPrimes_atPrime_of_mem_associatedPrimes hp
  obtain ⟨hmax, y, hy⟩ := isAssociatedPrime_iff.mp hpS
  have hy0 : y ≠ 0 := by
    intro hy0
    subst y
    have : IsLocalRing.maximalIdeal S = ⊤ := by
      rw [hy]
      ext c
      simp [Submodule.mem_colon_singleton]
    exact (IsLocalRing.maximalIdeal.isMaximal S).ne_top this
  have hann : ∀ c ∈ IsLocalRing.maximalIdeal S, c * y = 0 := by
    intro c hc
    rw [hy, Submodule.mem_colon_singleton] at hc
    simpa [Submodule.mem_bot, smul_eq_mul] using hc
  have hJfree : Module.Free S J :=
    free_of_hasProjectiveDimensionLE_of_mul_eq_zero hy0 hann n J inferInstance inferInstance
      inferInstance hn
  have hJmax : J ≤ IsLocalRing.maximalIdeal S := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono hIp
  have hJbot : J = ⊥ := by
    have := subsingleton_of_free_of_smul_eq_zero hy0 fun n : J => Subtype.ext (by
      change y * (n : S) = 0
      rw [mul_comm]
      exact hann _ (hJmax n.2))
    exact Submodule.eq_bot_of_subsingleton
  have hsub : Subsingleton J.Cotangent := by
    apply (J.cotangent_subsingleton_iff).2
    rw [hJbot]
    change (⊥ : Ideal S) * ⊥ = ⊥
    simp
  let b := hfree.some
  let i : Fin r := ⟨0, hr⟩
  let z : I.Cotangent := (b i : I.Cotangent)
  have hθz : Ideal.localizedCotangentMap p.primeCompl S I z = 0 :=
    Subsingleton.elim _ _
  let : IsLocalizedModule p.primeCompl (Ideal.localizedCotangentMap p.primeCompl S I) :=
    Ideal.isLocalizedModule_localizedCotangentMap p.primeCompl S I
  obtain ⟨s, hs⟩ :=
    (IsLocalizedModule.eq_zero_iff p.primeCompl
      (Ideal.localizedCotangentMap p.primeCompl S I)).mp hθz
  have hsz : (s : R) • z = 0 := hs
  exact s.2 (hIp (mem_of_smul_basis_eq_zero b i hsz))

private noncomputable def cotangentPreimage {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) : Ideal R :=
  (Submodule.comap I.toCotangent (F.restrictScalars R)).map I.subtype

private theorem cotangentPreimage_le {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) : cotangentPreimage I F ≤ I := by
  rintro _ ⟨y, -, rfl⟩
  exact y.2

private theorem toCotangent_mem_of_mem_cotangentPreimage {R : Type u} [CommRing R]
    {I : Ideal R} {F : Submodule (R ⧸ I) I.Cotangent} {a : R} (ha : a ∈ cotangentPreimage I F) :
    I.toCotangent ⟨a, cotangentPreimage_le I F ha⟩ ∈ F := by
  obtain ⟨y, hy, hya⟩ := Submodule.mem_map.mp ha
  have heq : (⟨a, cotangentPreimage_le I F ha⟩ : I) = y := Subtype.ext hya.symm
  rw [heq]
  exact hy

private theorem pow_two_le_cotangentPreimage {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) : I ^ 2 ≤ cotangentPreimage I F := by
  intro a ha
  have haI : a ∈ I := Ideal.pow_le_self two_ne_zero ha
  have hP : (⟨a, haI⟩ : I) ∈ Submodule.comap I.toCotangent (F.restrictScalars R) := by
    change I.toCotangent ⟨a, haI⟩ ∈ F
    rw [(I.toCotangent_eq_zero ⟨a, haI⟩).2 ha]
    exact F.zero_mem
  exact Submodule.mem_map_of_mem hP

private noncomputable def cotangentPreimageMap {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) : cotangentPreimage I F →ₗ[R] F where
  toFun a := ⟨I.toCotangent ⟨a, cotangentPreimage_le I F a.2⟩,
    toCotangent_mem_of_mem_cotangentPreimage a.2⟩
  map_add' a b := by
    apply Subtype.ext
    change I.toCotangent ((⟨(a : R), cotangentPreimage_le I F a.2⟩ : I) +
      ⟨(b : R), cotangentPreimage_le I F b.2⟩) = _
    exact map_add I.toCotangent _ _
  map_smul' c a := by
    apply Subtype.ext
    change I.toCotangent (c • (⟨(a : R), cotangentPreimage_le I F a.2⟩ : I)) = _
    exact map_smul I.toCotangent c _

private theorem cotangentPreimageMap_surjective {R : Type u} [CommRing R] (I : Ideal R)
    (F : Submodule (R ⧸ I) I.Cotangent) : Function.Surjective (cotangentPreimageMap I F) := by
  intro z
  obtain ⟨y, hy⟩ := I.toCotangent_surjective z
  have hyP : y ∈ Submodule.comap I.toCotangent (F.restrictScalars R) := by
    change I.toCotangent y ∈ F
    rw [hy]
    exact z.2
  exact ⟨⟨y, Submodule.mem_map_of_mem hyP⟩, Subtype.ext hy⟩

/-- An element of `J • ⊤` is a finitely supported `J`-linear combination of elements. -/
private theorem exists_finsupp_of_mem_smul_top {A M : Type*} [CommRing A] [AddCommGroup M]
    [Module A M] (J : Ideal A) {z : M} (hz : z ∈ J • (⊤ : Submodule A M)) :
    ∃ (d : M →₀ A) (_ : ∀ i, d i ∈ J), (d.sum fun i c => c • i) = z :=
  (Submodule.mem_ideal_smul_span_iff_exists_sum J (fun w : M => w) z).mp (by simpa using hz)

/-- For a local quotient ring, an element lies in the maximal ideal iff its class does. -/
private theorem mk_mem_maximalIdeal_iff {R : Type u} [CommRing R] [IsLocalRing R] {I : Ideal R}
    [IsLocalRing (R ⧸ I)] (a : R) :
    Ideal.Quotient.mk I a ∈ IsLocalRing.maximalIdeal (R ⧸ I) ↔
      a ∈ IsLocalRing.maximalIdeal R := by
  have h : (IsLocalRing.maximalIdeal (R ⧸ I)).comap (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal
      (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
  rw [← h, Ideal.mem_comap]

private theorem cotangentPreimageMap_mem_maximalIdeal_smul {R : Type u} [CommRing R]
    [IsLocalRing R] {I : Ideal R} [IsLocalRing (R ⧸ I)] {F : Submodule (R ⧸ I) I.Cotangent}
    (u : cotangentPreimage I F)
    (hu : (u : R) ∈ IsLocalRing.maximalIdeal R * cotangentPreimage I F) :
    (cotangentPreimageMap I F u : I.Cotangent) ∈ IsLocalRing.maximalIdeal (R ⧸ I) • F := by
  classical
  have hu' : u ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R (cotangentPreimage I F)) :=
    (Submodule.mem_smul_top_iff _ _ _).mpr (by simpa only [← smul_eq_mul] using hu)
  obtain ⟨d, hd, rfl⟩ := exists_finsupp_of_mem_smul_top _ hu'
  rw [map_finsuppSum]
  simp only [map_smul, Finsupp.sum]
  have hmem : (∑ i ∈ d.support, (d i : R) • (cotangentPreimageMap I F i : I.Cotangent)) ∈
      IsLocalRing.maximalIdeal (R ⧸ I) • F := by
    refine Submodule.sum_mem _ fun i _ => ?_
    have hcbar : algebraMap R (R ⧸ I) (d i) ∈ IsLocalRing.maximalIdeal (R ⧸ I) :=
      (mk_mem_maximalIdeal_iff _).mpr (hd i)
    rw [← IsScalarTower.algebraMap_smul (R ⧸ I) (d i)
      (cotangentPreimageMap I F i : I.Cotangent)]
    exact Submodule.smul_mem_smul hcbar (cotangentPreimageMap I F i).property
  simpa using hmem

private theorem le_maximalIdeal_smul_of_cotangentPreimage_le {R : Type u} [CommRing R]
    [IsLocalRing R] {I : Ideal R} [IsLocalRing (R ⧸ I)] {F : Submodule (R ⧸ I) I.Cotangent}
    (h : cotangentPreimage I F ≤ IsLocalRing.maximalIdeal R * cotangentPreimage I F ⊔ I ^ 2) :
    F ≤ IsLocalRing.maximalIdeal (R ⧸ I) • F := by
  intro z hz
  obtain ⟨a, ha⟩ := cotangentPreimageMap_surjective I F ⟨z, hz⟩
  rcases Submodule.mem_sup.mp (h a.2) with ⟨u, hu, v, hv, huv⟩
  have huK : u ∈ cotangentPreimage I F :=
    (Ideal.mul_le_right :
      IsLocalRing.maximalIdeal R * cotangentPreimage I F ≤ cotangentPreimage I F) hu
  have hvK : v ∈ cotangentPreimage I F := pow_two_le_cotangentPreimage I F hv
  let uK : cotangentPreimage I F := ⟨u, huK⟩
  let vK : cotangentPreimage I F := ⟨v, hvK⟩
  have haeq : a = uK + vK := Subtype.ext huv.symm
  have hφv : cotangentPreimageMap I F vK = 0 :=
    Subtype.ext ((I.toCotangent_eq_zero ⟨v, cotangentPreimage_le I F hvK⟩).2 hv)
  have hz_eq : z = (cotangentPreimageMap I F uK : I.Cotangent) + cotangentPreimageMap I F vK := by
    calc
      z = (cotangentPreimageMap I F a : I.Cotangent) := congrArg Subtype.val ha.symm
      _ = (cotangentPreimageMap I F (uK + vK) : I.Cotangent) :=
        congrArg Subtype.val (congrArg (cotangentPreimageMap I F) haeq)
      _ = (cotangentPreimageMap I F uK : I.Cotangent) + cotangentPreimageMap I F vK :=
        congrArg Subtype.val (map_add (cotangentPreimageMap I F) _ _)
  simpa [hz_eq, hφv] using cotangentPreimageMap_mem_maximalIdeal_smul uK hu

private theorem exists_mem_forall_notMem_of_not_le {R : Type u} [CommRing R]
    [IsNoetherianRing R] {K J : Ideal R} (hKJ : ¬ K ≤ J)
    (hK : ∀ p ∈ associatedPrimes R R, ¬ K ≤ p) :
    ∃ x ∈ K, x ∉ J ∧ ∀ p ∈ associatedPrimes R R, x ∉ p := by
  classical
  let S : Set (Ideal R) := insert J (associatedPrimes R R)
  have hS : S.Finite := (associatedPrimes.finite R R).insert _
  have hprime : ∀ P ∈ S, P ≠ J → P ≠ J → P.IsPrime := by
    rintro P (rfl | hP) hne _
    · exact (hne rfl).elim
    · exact hP.isPrime
  have hnotcover : ¬ (K : Set R) ⊆ ⋃ P ∈ S, (P : Set R) := by
    intro hcover
    obtain ⟨P, hP, hKP⟩ :=
      (Ideal.subset_union_prime_finite hS _ _ hprime (I := K)).mp hcover
    rcases hP with rfl | hP
    · exact hKJ hKP
    · exact hK P hP hKP
  obtain ⟨x, hxK, hxnot⟩ := Set.not_subset.mp hnotcover
  have hJS : J ∈ S := Set.mem_insert _ _
  exact ⟨x, hxK, fun hx => hxnot (Set.mem_iUnion₂_of_mem hJS hx),
    fun p hp hxp => hxnot (Set.mem_iUnion₂_of_mem (Set.mem_insert_of_mem _ hp) hxp)⟩

private theorem toCotangent_notMem_maximalIdeal_smul {R : Type u} [CommRing R] [IsLocalRing R]
    {I : Ideal R} [IsLocalRing (R ⧸ I)] {F : Submodule (R ⧸ I) I.Cotangent} {x : R}
    (hxK : x ∈ cotangentPreimage I F)
    (hx : x ∉ IsLocalRing.maximalIdeal R * cotangentPreimage I F ⊔ I ^ 2) :
    (⟨I.toCotangent ⟨x, cotangentPreimage_le I F hxK⟩,
      toCotangent_mem_of_mem_cotangentPreimage hxK⟩ : F) ∉
      IsLocalRing.maximalIdeal (R ⧸ I) • (⊤ : Submodule (R ⧸ I) F) := by
  classical
  set z : F := ⟨I.toCotangent ⟨x, cotangentPreimage_le I F hxK⟩,
    toCotangent_mem_of_mem_cotangentPreimage hxK⟩
  intro hxspan
  obtain ⟨d, hd, hsumz⟩ := exists_finsupp_of_mem_smul_top _ hxspan
  have hcoeff : ∀ i : F, ∃ c : R, c ∈ IsLocalRing.maximalIdeal R ∧
      algebraMap R (R ⧸ I) c = d i := by
    intro i
    obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (d i)
    exact ⟨c, (mk_mem_maximalIdeal_iff (I := I) c).mp (by simpa [hc] using hd i), by simpa using hc⟩
  choose c hcM hcq using hcoeff
  choose a ha using fun i : F => cotangentPreimageMap_surjective I F i
  let t : cotangentPreimage I F := ∑ i ∈ d.support, c i • a i
  have hφt : cotangentPreimageMap I F t = z := by
    calc
      cotangentPreimageMap I F t = ∑ i ∈ d.support, c i • cotangentPreimageMap I F (a i) := by
        simp [t, map_sum, map_smul]
      _ = ∑ i ∈ d.support, algebraMap R (R ⧸ I) (c i) • i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [ha i, ← IsScalarTower.algebraMap_smul (R ⧸ I) (c i) (i : F)]
      _ = d.sum fun i c' => c' • i := by
        rw [Finsupp.sum]
        exact Finset.sum_congr rfl fun i _ => by rw [hcq i]
      _ = z := hsumz
  have hcot : I.toCotangent ⟨x, cotangentPreimage_le I F hxK⟩ =
      I.toCotangent ⟨(t : R), cotangentPreimage_le I F t.2⟩ :=
    (congrArg Subtype.val hφt).symm
  refine hx (Submodule.mem_sup.mpr ⟨(t : R), ?_, x - (t : R), I.toCotangent_eq.mp hcot, by ring⟩)
  have htmem : (∑ i ∈ d.support, c i * (a i : R)) ∈
      IsLocalRing.maximalIdeal R * cotangentPreimage I F :=
    Submodule.sum_mem _ fun i _ => Ideal.mul_mem_mul (hcM i) (a i).2
  simpa [t, smul_eq_mul] using htmem

/-- There is a regular lift whose cotangent class is primitive in a given free summand. The
preimage of the summand is an ideal; prime avoidance, with its maximal-ideal multiple as the
exceptional member, chooses a lift that is both outside all associated primes and nonzero modulo
the maximal ideal of that preimage. -/
private theorem exists_regular_primitive_cotangent
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (r : ℕ) (F : Submodule (R ⧸ I) I.Cotangent)
    [IsLocalRing (R ⧸ I)]
    (hI : I ≠ ⊤) (hpd : Module.projectiveDimension R I ≠ ⊤)
    (hfree : Nonempty (Module.Basis (Fin r) (R ⧸ I) F)) (hr : 0 < r) :
    ∃ x : I, IsSMulRegular R (x : R) ∧
      ∃ z : F, (z : I.Cotangent) = I.toCotangent x ∧ z ∉
        IsLocalRing.maximalIdeal (R ⧸ I) • (⊤ : Submodule (R ⧸ I) F) := by
  classical
  have hA : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  have hFne : F ≠ ⊥ := by
    intro hbot
    let b := hfree.some
    let i : Fin r := ⟨0, hr⟩
    have hbi : b i ≠ 0 := by
      intro he
      have hrepr := congrArg b.repr he
      simp at hrepr
    have hbi0 : b i = 0 := by
      apply Subtype.ext
      simpa [hbot] using (b i).property
    exact hbi hbi0
  have hKnotAss : ∀ p ∈ associatedPrimes R R, ¬ cotangentPreimage I F ≤ p := by
    intro p hp hKp
    by_cases hIp : I ≤ p
    · exact ideal_not_le_associatedPrime I r F hpd hfree hr p hp hIp
    · obtain ⟨a, haI, hap⟩ := Set.not_subset.mp hIp
      exact hap (hp.isPrime.mem_of_pow_mem 2
        (hKp (pow_two_le_cotangentPreimage I F (Ideal.pow_mem_pow haI 2))))
  have hKnotBad : ¬ cotangentPreimage I F ≤
      IsLocalRing.maximalIdeal R * cotangentPreimage I F ⊔ I ^ 2 := by
    intro hKbad
    have : Module.Finite (R ⧸ I) F := Module.Finite.of_basis hfree.some
    exact hFne (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot
      (IsLocalRing.maximalIdeal (R ⧸ I)) F ((Submodule.fg_top F).mp Module.Finite.fg_top)
      (le_maximalIdeal_smul_of_cotangentPreimage_le hKbad)
      (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal (R ⧸ I))))
  obtain ⟨x, hxK, hxnot, hxAss⟩ := exists_mem_forall_notMem_of_not_le hKnotBad hKnotAss
  have hxreg : IsSMulRegular R (x : R) := by
    rw [isSMulRegular_iff_right_eq_zero_of_smul]
    intro y hxy
    by_contra hy0
    have hmem : x ∈ ⋃ p ∈ associatedPrimes R R, (p : Set R) := by
      rw [biUnion_associatedPrimes_eq_zero_divisors]
      exact ⟨y, hy0, by simpa [smul_eq_mul, mul_comm] using hxy⟩
    simp only [Set.mem_iUnion, exists_prop] at hmem
    obtain ⟨p, hp, hxp⟩ := hmem
    exact hxAss p hp hxp
  exact ⟨⟨x, cotangentPreimage_le I F hxK⟩, hxreg,
    ⟨I.toCotangent ⟨x, cotangentPreimage_le I F hxK⟩,
      toCotangent_mem_of_mem_cotangentPreimage hxK⟩, rfl,
    toCotangent_notMem_maximalIdeal_smul hxK hxnot⟩

private theorem comap_map_quotient_span_singleton {R : Type u} [CommRing R] (I : Ideal R) (x : R) :
    (I.map (algebraMap R (R ⧸ Ideal.span {x}))).comap (algebraMap R (R ⧸ Ideal.span {x})) =
      RingHom.ker (algebraMap R (R ⧸ Ideal.span {x})) ⊔ I := by
  change (I.map (Ideal.Quotient.mk _)).comap (Ideal.Quotient.mk _) =
    RingHom.ker (Ideal.Quotient.mk _) ⊔ I
  rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot]
  exact sup_comm _ _

private theorem quotient_cotangent_map_ker
    {R : Type u} [CommRing R] (I : Ideal R) (x : I) :
    let q := Ideal.span ({(x : R)} : Set R)
    let A := R ⧸ q
    let J := I.map (algebraMap R A)
    let f := Ideal.mapCotangent I J (Algebra.ofId R A)
      (Ideal.map_le_iff_le_comap.mp le_rfl)
    LinearMap.ker f = Submodule.span R {I.toCotangent x} := by
  dsimp
  let q : Ideal R := Ideal.span ({(x : R)} : Set R)
  let A := R ⧸ q
  let J := I.map (algebraMap R A)
  have hqI : q ≤ I := Ideal.span_le.mpr (by rintro y rfl; exact x.2)
  have hkerq : RingHom.ker (algebraMap R A) = q := by
    change RingHom.ker (Ideal.Quotient.mk q) = q
    exact Ideal.mk_ker
  have hcomap : J.comap (algebraMap R A) = RingHom.ker (algebraMap R A) ⊔ I :=
    comap_map_quotient_span_singleton I x
  let f := Ideal.mapCotangent I J (Algebra.ofId R A)
    (Ideal.map_le_iff_le_comap.mp le_rfl)
  have hker := Ideal.mapCotangent_ker_of_surjective
    (A := R) (B := A) Ideal.Quotient.mk_surjective (I := J) (J := I) hcomap
  have hpre : Submodule.comap I.subtype (q ⊓ I) = Submodule.span R {x} := by
    ext a
    constructor
    · intro ha
      have haq : (a : R) ∈ q := (Submodule.mem_comap.mp ha).1
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp haq
      rw [Submodule.mem_span_singleton]
      refine ⟨c, ?_⟩
      apply Subtype.ext
      change c * (x : R) = (a : R)
      exact hc
    · intro ha
      rw [Submodule.mem_span_singleton] at ha
      obtain ⟨c, hc⟩ := ha
      apply Submodule.mem_comap.mpr
      constructor
      · change (a : R) ∈ q
        rw [← hc]
        change c * (x : R) ∈ q
        exact q.mul_mem_left c (Ideal.mem_span_singleton_self _)
      · change (a : R) ∈ I
        rw [← hc]
        exact (c • x).property
  have hpre' : Submodule.comap I.subtype q = Submodule.span R {x} := by
    rw [← inf_eq_left.mpr hqI]
    exact hpre
  change LinearMap.ker f = _ at hker
  have hker' : f.ker = Submodule.map I.toCotangent (Submodule.comap I.subtype q) := by
    rw [hker, hkerq, inf_eq_left.mpr hqI]
  change LinearMap.ker f = Submodule.span R {I.toCotangent x}
  rw [hker', hpre', Submodule.map_span, Set.image_singleton]

private theorem basis_change_at_primitive
    {A : Type u} [CommRing A] [IsLocalRing A]
    {M : Type u} [AddCommGroup M] [Module A M]
    (r : ℕ) (b : Module.Basis (Fin r) A M) (z : M)
    (hz : z ∉ IsLocalRing.maximalIdeal A • (⊤ : Submodule A M)) :
    ∃ i : Fin r, ∃ a : Aˣ, ∃ c : Module.Basis (Fin r) A M,
      c i = (↑a⁻¹ : A) • z := by
  classical
  have hcoord : ∃ i : Fin r, b.repr z i ∉ IsLocalRing.maximalIdeal A := by
    by_contra h
    push Not at h
    have hsum : z = Finsupp.linearCombination A b (b.repr z) :=
      (b.linearCombination_repr z).symm
    have hmem : (∑ i ∈ (b.repr z).support, b.repr z i • b i) ∈
        IsLocalRing.maximalIdeal A • (⊤ : Submodule A M) := by
      apply Submodule.sum_mem
      intro i hi
      exact Submodule.smul_mem_smul (h i) (Submodule.mem_top)
    have hmem' : Finsupp.linearCombination A b (b.repr z) ∈
        IsLocalRing.maximalIdeal A • (⊤ : Submodule A M) := by
      change (∑ i ∈ (b.repr z).support, b.repr z i • b i) ∈ _
      exact hmem
    exact hz (hsum ▸ hmem')
  obtain ⟨i, hi⟩ := hcoord
  let d : A := b.repr z i
  have hdunit : IsUnit d := IsLocalRing.notMem_maximalIdeal.mp hi
  let a : Aˣ := hdunit.unit
  have ha : (a : A) = d := hdunit.unit_spec
  let ℓ : Module.Dual A M := (↑(a⁻¹) : A) • b.coord i
  have hℓz : ℓ z = 1 := by
    simp [ℓ, d, ← ha]
  have hℓbi : ℓ (b i) = (↑(a⁻¹) : A) := by
    simp [ℓ]
  let v : M := z - (a : A) • b i
  have hℓv : ℓ v = 0 := by
    simp [v, map_sub, map_smul, hℓz, hℓbi]
  let e : M ≃ₗ[A] M := LinearEquiv.transvection hℓv
  let c := b.map e
  refine ⟨i, a, c, ?_⟩
  rw [Module.Basis.map_apply, LinearEquiv.transvection.apply]
  dsimp [v]
  rw [hℓbi]
  have hmul : (↑(a⁻¹) : A) * d = 1 := by rw [← ha, Units.inv_mul]
  calc
    b i + (↑(a⁻¹) : A) • (z - d • b i) =
        (↑(a⁻¹) : A) • z + (1 - (↑(a⁻¹) : A) * d) • b i := by module
    _ = (↑(a⁻¹) : A) • z := by rw [hmul]; simp

private theorem split_free_basis_at_primitive
    {A : Type u} [CommRing A] [IsLocalRing A]
    {M : Type u} [AddCommGroup M] [Module A M]
    (r : ℕ) (b : Module.Basis (Fin (r + 1)) A M) (z : M)
    (hz : z ∉ IsLocalRing.maximalIdeal A • (⊤ : Submodule A M)) :
    ∃ (i : Fin (r + 1)) (a : Aˣ) (c : Module.Basis (Fin (r + 1)) A M)
      (G : Submodule A M) (_bG : Module.Basis (Fin r) A G),
      c i = (↑a⁻¹ : A) • z ∧ IsCompl (Submodule.span A {c i}) G := by
  classical
  obtain ⟨i, a, c, hci⟩ := basis_change_at_primitive (r + 1) b z hz
  let v : Fin r → M := fun j => c (i.succAbove j)
  let G : Submodule A M := Submodule.span A (Set.range v)
  have hli : LinearIndependent A v :=
    c.linearIndependent.comp (i.succAbove) Fin.succAbove_right_injective
  let bG : Module.Basis (Fin r) A G := Module.Basis.span hli
  have hcomp : IsCompl (Submodule.span A {c i}) G := by
    have h := c.linearIndependent.isCompl_span_image c.span_eq
      (isCompl_compl : IsCompl ({i} : Set (Fin (r + 1))) ({i} : Set (Fin (r + 1)))ᶜ)
    have hset : Set.range v = c '' ({i}ᶜ) := by
      change Set.range (c ∘ i.succAbove) = c '' ({i}ᶜ)
      rw [Set.range_comp, Fin.range_succAbove]
    simpa [G, hset] using h
  exact ⟨i, a, c, G, bG, hci, hcomp⟩

private theorem isCompl_map_of_ker_le
    {A M N : Type*} [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    {f : M →ₗ[A] N} (hsurj : Function.Surjective f) {F H : Submodule A M}
    (hcompl : IsCompl F H) (hker : LinearMap.ker f ≤ F) : IsCompl (F.map f) (H.map f) := by
  refine ⟨?_, ?_⟩
  · rw [Submodule.disjoint_def]
    rintro _ ⟨v, hv, rfl⟩ ⟨w, hw, hwv⟩
    have hvw : v - w ∈ F := hker (by simp [LinearMap.mem_ker, hwv])
    have hwF : w ∈ F := by simpa using F.sub_mem hv hvw
    have hw0 : w = 0 := by simpa using hcompl.disjoint.le_bot ⟨hwF, hw⟩
    rw [← hwv, hw0, map_zero]
  · rw [codisjoint_iff, ← Submodule.map_sup, hcompl.sup_eq_top, Submodule.map_top,
      LinearMap.range_eq_top.mpr hsurj]

private theorem quotient_free_complement
    {A : Type u} [CommRing A] [IsLocalRing A]
    {M : Type u} {N : Type u} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N]
    (r : ℕ) (f : M →ₗ[A] N) (hsurj : Function.Surjective f)
    (F H : Submodule A M) (hcompl : IsCompl F H)
    (b : Module.Basis (Fin (r + 1)) A F) (z : F)
    (hz : z ∉ IsLocalRing.maximalIdeal A • (⊤ : Submodule A F))
    (hkerF : LinearMap.ker (f.comp F.subtype) = Submodule.span A {z})
    (hkerM : LinearMap.ker f = Submodule.span A {(z : M)}) :
    ∃ F' H' : Submodule A N, IsCompl F' H' ∧
      Nonempty (Module.Basis (Fin r) A F') ∧ F' = F.map f := by
  obtain ⟨i, a, c, G, bG, hci, hcompG⟩ := split_free_basis_at_primitive r b z hz
  have hker : IsCompl (LinearMap.ker (f.comp F.subtype)) G := by
    rwa [hkerF, ← Submodule.span_singleton_smul_eq (a⁻¹).isUnit z, ← hci]
  have hrange : LinearMap.range (f.comp F.subtype) = F.map f := by
    rw [LinearMap.range_comp, Submodule.range_subtype]
  have hkerle : LinearMap.ker f ≤ F := by
    rw [hkerM, Submodule.span_singleton_le_iff_mem]
    exact z.property
  exact ⟨F.map f, H.map f, isCompl_map_of_ker_le hsurj hcompl hkerle,
    ⟨bG.map (((Submodule.quotientEquivOfIsCompl _ _ hker).symm.trans
      (f.comp F.subtype).quotKerEquivRange).trans (LinearEquiv.ofEq _ _ hrange))⟩, rfl⟩

private noncomputable def basisOfRingEquiv
    {r : ℕ} {A B M : Type u} [CommRing A] [CommRing B] [AddCommGroup M]
    [Module A M] [Module B M]
    (e : B ≃+* A) (hsmul : ∀ c : B, ∀ x : M, c • x = (e c) • x)
    (b : Module.Basis (Fin r) A M) :
    Module.Basis (Fin r) B M := by
  let f : M →ₗ[B] (Fin r →₀ B) :=
    { toFun := fun x => (b.repr x).mapRange e.symm e.symm.map_zero
      map_add' := by
        intro x y
        ext i
        simp
      map_smul' := by
        intro c x
        rw [hsmul c x]
        ext i
        simp }
  have hinj : Function.Injective f := by
    intro x y h
    apply b.repr.injective
    ext i
    have hi := congrArg (fun v : Fin r →₀ B => e (v i)) h
    simpa [f, Finsupp.mapRange_apply] using hi
  have hsurj : Function.Surjective f := by
    intro v
    let vA : Fin r →₀ A := v.mapRange e e.map_zero
    refine ⟨b.repr.symm vA, ?_⟩
    ext i
    simp [f, vA, Finsupp.mapRange_apply]
  exact Module.Basis.ofRepr (LinearEquiv.ofBijective f ⟨hinj, hsurj⟩)

private theorem regular_cons_of_quotient
    {R : Type u} [CommRing R] {x : R} (hx : IsSMulRegular R x) (l : List R)
    (hl : RingTheory.Sequence.IsRegular (R ⧸ Ideal.span {x})
      (l.map (Ideal.Quotient.mk (Ideal.span {x})))) :
    RingTheory.Sequence.IsRegular R (x :: l) := by
  have hq : (x • (⊤ : Submodule R R)) = Ideal.span {x} := by
    rw [← Submodule.ideal_span_singleton_smul]
    exact Ideal.mul_top _
  let e : QuotSMulTop x R ≃ₗ[R] (R ⧸ Ideal.span {x}) :=
    Submodule.quotEquivOfEq _ _ hq
  apply RingTheory.Sequence.IsRegular.cons hx
  apply (e.isRegular_congr l).mpr
  exact ((AddEquiv.refl (R ⧸ Ideal.span {x})).isRegular_congr
    (List.forall₂_map_right_iff.mpr (List.forall₂_same.mpr
      (fun a _ b => (IsScalarTower.algebraMap_smul (R ⧸ Ideal.span {x}) a b).symm)))).mpr hl

/-- A surjection `g` that factors as `gR ∘ ρ`, with `ρ` killing the kernel of `g`, makes `gR`
split. -/
private theorem exists_comp_eq_id_of_comp_eq
    {R M N P : Type u} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup P] [Module R P] (g : M →ₗ[R] N) (hg : Function.Surjective g)
    (gR : P →ₗ[R] N) (ρ : M →ₗ[R] P) (hker : LinearMap.ker g ≤ LinearMap.ker ρ)
    (hρ : ∀ v, gR (ρ v) = g v) :
    ∃ s : N →ₗ[R] P, gR.comp s = LinearMap.id := by
  refine ⟨(LinearMap.ker g).liftQ ρ hker ∘ₗ (g.quotKerEquivOfSurjective hg).symm.toLinearMap, ?_⟩
  ext y
  obtain ⟨v, rfl⟩ := hg y
  change gR ((LinearMap.ker g).liftQ ρ hker ((g.quotKerEquivOfSurjective hg).symm (g v))) = g v
  rw [LinearMap.quotKerEquivOfSurjective_symm_apply, Submodule.liftQ_apply, hρ]

private theorem quotSMulTop_mk_eq_of_mem_span
    {R : Type u} [CommRing R] (I : Ideal R) (x : I)
    (phi : I.Cotangent →ₗ[R ⧸ I] R ⧸ I) (hphi : phi (I.toCotangent x) = 1)
    (eta : (R ⧸ I) →ₗ[R] QuotSMulTop (x : R) I)
    (heta : ∀ a : R, eta (Ideal.Quotient.mk I a) = Submodule.Quotient.mk (a • x))
    {y : I} (hy : (y : R) ∈ Ideal.span {(x : R)}) :
    (Submodule.Quotient.mk y : QuotSMulTop (x : R) I) = eta (phi (I.toCotangent y)) := by
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hy
  obtain rfl : y = a • x := Subtype.ext ha.symm
  rw [map_smul, ← IsScalarTower.algebraMap_smul (R ⧸ I) a (I.toCotangent x), map_smul, hphi,
    smul_eq_mul, mul_one]
  exact (heta a).symm

/-- A functional on `I/I²` taking the value `1` at the class of `x` splits the surjection
`I/xI → I/(x)`. -/
private theorem exists_retraction_quotSMulTop
    {R : Type u} [CommRing R] (I : Ideal R) (x : I)
    (phi : I.Cotangent →ₗ[R ⧸ I] R ⧸ I) (hphi : phi (I.toCotangent x) = 1) :
    ∃ (g : QuotSMulTop (x : R) I →ₗ[R] I.map (algebraMap R (R ⧸ Ideal.span {(x : R)})))
      (s : I.map (algebraMap R (R ⧸ Ideal.span {(x : R)})) →ₗ[R] QuotSMulTop (x : R) I),
      g.comp s = LinearMap.id := by
  let q : Ideal R := Ideal.span {(x : R)}
  let Q := R ⧸ q
  let u : R →ₗ[R] QuotSMulTop (x : R) I :=
    ((x : R) • (⊤ : Submodule R I)).mkQ.comp (LinearMap.smulRight (LinearMap.id : R →ₗ[R] R) x)
  have hkillI : (I : Submodule R R) ≤ LinearMap.ker u := by
    intro a ha
    rw [LinearMap.mem_ker]
    change Submodule.Quotient.mk ((a : R) • x) = 0
    rw [Submodule.Quotient.mk_eq_zero]
    change (a : R) • x ∈ (x : R) • (⊤ : Submodule R I)
    rw [Submodule.mem_smul_pointwise_iff_exists]
    exact ⟨⟨a, ha⟩, Submodule.mem_top, Subtype.ext (by simp [mul_comm])⟩
  let eta : (R ⧸ I) →ₗ[R] QuotSMulTop (x : R) I := (I : Submodule R R).liftQ u hkillI
  have heta (a : R) : eta (Ideal.Quotient.mk I a) = Submodule.Quotient.mk (a • x) := rfl
  let psi : I →ₗ[R] (R ⧸ I) := (phi.restrictScalars R).comp I.toCotangent
  let rho : I →ₗ[R] QuotSMulTop (x : R) I := ((x : R) • (⊤ : Submodule R I)).mkQ - eta.comp psi
  let gbar : I →ₗ[R] I.map (algebraMap R Q) := Algebra.idealMap Q I
  have hxzero : algebraMap R Q (x : R) = 0 := by
    change Ideal.Quotient.mk q (x : R) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  have hgx : gbar x = 0 := Subtype.ext hxzero
  have hgbar_surj : Function.Surjective gbar := fun y => by
    obtain ⟨v, hv, hvy⟩ := (Ideal.mem_map_iff_of_surjective (algebraMap R Q)
      Ideal.Quotient.mk_surjective).mp y.property
    exact ⟨⟨v, hv⟩, Subtype.ext hvy⟩
  have hxker : (x : R) • (⊤ : Submodule R I) ≤ LinearMap.ker gbar := by
    intro y hy
    obtain ⟨v, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ (x : R) ⊤).mp hy
    rw [LinearMap.mem_ker, map_smul]
    apply Subtype.ext
    simp [Algebra.smul_def, hxzero]
  let gR := ((x : R) • (⊤ : Submodule R I)).liftQ gbar hxker
  have hrho : LinearMap.ker gbar ≤ LinearMap.ker rho := fun y hy => by
    have hbar0 : algebraMap R Q (y : R) = 0 := congrArg Subtype.val (LinearMap.mem_ker.mp hy)
    have hyq : (y : R) ∈ q := Ideal.Quotient.eq_zero_iff_mem.mp hbar0
    rw [LinearMap.mem_ker]
    change (Submodule.Quotient.mk y : QuotSMulTop (x : R) I) - eta (psi y) = 0
    rw [sub_eq_zero]
    exact quotSMulTop_mk_eq_of_mem_span I x phi hphi eta heta hyq
  have hρ (v : I) : gR (rho v) = gbar v := by
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (psi v)
    change gR (Submodule.Quotient.mk v - eta (psi v)) = gbar v
    rw [← ha, heta, map_sub]
    change gbar v - gbar (a • x) = gbar v
    rw [map_smul, hgx, smul_zero, sub_zero]
  obtain ⟨s, hs⟩ := exists_comp_eq_id_of_comp_eq gbar hgbar_surj gR rho hrho hρ
  exact ⟨gR, s, hs⟩

/-- If a functional on `I/I²` takes the value `1` at the class of a regular element `x ∈ I`,
then `I(R/xR)` has finite projective dimension over `R/xR` whenever `I` does over `R`. -/
private theorem projectiveDimension_map_quotient_span_ne_top
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] (I : Ideal R) (x : I)
    (hxreg : IsSMulRegular R (x : R)) (hpd : Module.projectiveDimension R I ≠ ⊤)
    (phi : I.Cotangent →ₗ[R ⧸ I] R ⧸ I) (hphi : phi (I.toCotangent x) = 1) :
    Module.projectiveDimension (R ⧸ Ideal.span {(x : R)})
      (I.map (algebraMap R (R ⧸ Ideal.span {(x : R)}))) ≠ ⊤ := by
  obtain ⟨gR, sR, hgsR⟩ := exists_retraction_quotSMulTop I x phi hphi
  obtain ⟨n, hn⟩ := hasProjectiveDimensionLE_quotSMulTop_ideal I hxreg hpd
  refine projectiveDimension_ne_top_of_splitLinearMap _ _
    (gR.extendScalarsOfSurjective Ideal.Quotient.mk_surjective)
    (sR.extendScalarsOfSurjective Ideal.Quotient.mk_surjective) ?_ ?_
  · ext y
    exact congrArg Subtype.val (congrFun (congrArg DFunLike.coe hgsR) y)
  · rw [CategoryTheory.projectiveDimension_ne_top_iff]
    exact ⟨n, hn⟩

/-- A primitive element of a free direct summand takes the value `1` under some functional on
the ambient module. -/
private theorem exists_dual_eq_one_of_primitive
    {A : Type u} [CommRing A] [IsLocalRing A] {M : Type u} [AddCommGroup M] [Module A M]
    {F H : Submodule A M} (hcompl : IsCompl F H) {r : ℕ} (b : Module.Basis (Fin r) A F)
    {z : F} (hz : z ∉ IsLocalRing.maximalIdeal A • (⊤ : Submodule A F)) :
    ∃ phi : M →ₗ[A] A, phi z = 1 := by
  obtain ⟨i, a, c, hci⟩ := basis_change_at_primitive r b z hz
  have hzci : z = (a : A) • c i := by rw [hci, smul_smul, Units.mul_inv, one_smul]
  refine ⟨((↑a⁻¹ : A) • c.coord i).comp (Submodule.projectionOnto F H hcompl), ?_⟩
  rw [LinearMap.comp_apply, Submodule.projectionOnto_apply_left, LinearMap.smul_apply, hzci,
    map_smul]
  simp

private theorem ker_comp_subtype_eq_span_singleton
    {A M N : Type u} [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (f : M →ₗ[A] N) (F : Submodule A M) (z : F)
    (h : LinearMap.ker f = Submodule.span A {(z : M)}) :
    LinearMap.ker (f.comp F.subtype) = Submodule.span A {z} := by
  rw [LinearMap.ker_comp, h]
  ext v
  rw [Submodule.mem_comap, Submodule.mem_span_singleton, Submodule.mem_span_singleton]
  exact ⟨fun ⟨c, hc⟩ => ⟨c, Subtype.ext hc⟩, fun ⟨c, hc⟩ => ⟨c, congrArg Subtype.val hc⟩⟩

/-- A family whose image spans the image of `F`, together with a generator of the kernel lying
in `F`, spans `F`. -/
private theorem span_range_cons_eq_of_map_eq
    {A M N X : Type u} [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (f : M →ₗ[A] N) (F : Submodule A M) (g : X → M) {a : X}
    (hker : LinearMap.ker f = Submodule.span A {g a}) (ha : g a ∈ F) {r : ℕ} (t : Fin r → X)
    (ht : Submodule.span A (Set.range fun i => f (g (t i))) = F.map f) :
    Submodule.span A (Set.range fun i => g ((Fin.cons a t : Fin (r + 1) → X) i)) = F := by
  have hfa : f (g a) = 0 := by
    rw [← LinearMap.mem_ker, hker]
    exact Submodule.mem_span_singleton_self _
  have hS : (Set.range fun i => g ((Fin.cons a t : Fin (r + 1) → X) i)) =
      insert (g a) (Set.range fun i => g (t i)) := by
    rw [← Fin.range_cons]
    congr 1
    funext i
    exact Fin.cases rfl (fun _ => rfl) i
  have hkerS : LinearMap.ker f ≤ Submodule.span A (insert (g a) (Set.range fun i => g (t i))) := by
    rw [hker]
    exact Submodule.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
  have hkerF : LinearMap.ker f ≤ F := by rwa [hker, Submodule.span_singleton_le_iff_mem]
  rw [hS, ← Submodule.comap_map_eq_self hkerS, ← Submodule.comap_map_eq_self hkerF, ← ht,
    Submodule.map_span, Set.image_insert_eq, hfa, ← Set.range_comp, Submodule.span_insert_zero]
  rfl

private theorem nonempty_basis_restrictScalars_of_ringEquiv
    {A B N : Type u} [CommRing A] [CommRing B] [AddCommGroup N] [Module A N] [Module B N]
    [Algebra B A] [IsScalarTower B A N] (e : B ≃+* A) (he : ∀ c, algebraMap B A c = e c)
    {r : ℕ} {F : Submodule A N} (b : Module.Basis (Fin r) A F) :
    Nonempty (Module.Basis (Fin r) B (F.restrictScalars B)) := by
  let eF : F ≃ₗ[B] F.restrictScalars B :=
    { toFun := fun v => ⟨v, v.property⟩
      invFun := fun v => ⟨v, v.property⟩
      map_add' _ _ := rfl
      map_smul' _ _ := rfl
      left_inv _ := rfl
      right_inv _ := rfl }
  refine ⟨(basisOfRingEquiv e (fun c w => Subtype.ext ?_) b).map eF⟩
  change c • (w : N) = e c • (w : N)
  rw [← he, IsScalarTower.algebraMap_smul]

/-- Cutting down along a regular `x ∈ I` whose class is primitive in the free summand `F` of rank
`r + 1`: the image of `F` in the conormal module of `I(R/xR)` is a free summand of rank `r`, and
lifts of generators of that image, together with `x`, generate `F`. -/
private theorem exists_free_summand_quotient_span
    {R : Type u} [CommRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)]
    (F H : Submodule (R ⧸ I) I.Cotangent) (hcompl : IsCompl F H) {r : ℕ}
    (b : Module.Basis (Fin (r + 1)) (R ⧸ I) F) (x : I) (z : F)
    (hz : (z : I.Cotangent) = I.toCotangent x)
    (hzprimitive : z ∉ IsLocalRing.maximalIdeal (R ⧸ I) • (⊤ : Submodule (R ⧸ I) F)) :
    ∃ F' : Submodule ((R ⧸ Ideal.span {(x : R)}) ⧸ I.map (algebraMap R (R ⧸ Ideal.span {(x : R)})))
        (I.map (algebraMap R (R ⧸ Ideal.span {(x : R)}))).Cotangent,
      I.map (algebraMap R (R ⧸ Ideal.span {(x : R)})) ≠ ⊤ ∧ (∃ H', IsCompl F' H') ∧
      Nonempty (Module.Basis (Fin r)
        ((R ⧸ Ideal.span {(x : R)}) ⧸ I.map (algebraMap R (R ⧸ Ideal.span {(x : R)}))) F') ∧
      ∀ (t : Fin r → I) (y : Fin r → I.map (algebraMap R (R ⧸ Ideal.span {(x : R)}))),
        (∀ i, algebraMap R (R ⧸ Ideal.span {(x : R)}) (t i : R) = y i) →
        Submodule.span _ (Set.range fun i =>
          (I.map (algebraMap R (R ⧸ Ideal.span {(x : R)}))).toCotangent (y i)) = F' →
        Submodule.span (R ⧸ I)
          (Set.range fun i => I.toCotangent ((Fin.cons x t : Fin (r + 1) → I) i)) = F := by
  let q : Ideal R := Ideal.span {(x : R)}
  have hqI : q ≤ I := Ideal.span_le.mpr (by rintro y rfl; exact x.property)
  let Q := R ⧸ q
  let J : Ideal Q := I.map (algebraMap R Q)
  let B := Q ⧸ J
  let e : B ≃+* (R ⧸ I) := DoubleQuot.quotQuotEquivQuotOfLE hqI
  let : Algebra B (R ⧸ I) := e.toRingHom.toAlgebra
  let : Module (R ⧸ I) J.Cotangent := Module.compHom J.Cotangent e.symm.toRingHom
  let : IsScalarTower R (R ⧸ I) J.Cotangent := IsScalarTower.of_compHom R (R ⧸ I) J.Cotangent
  have : IsScalarTower B (R ⧸ I) J.Cotangent := ⟨fun c a v => by
    change e.symm (e c * a) • v = c • e.symm a • v
    rw [map_mul, e.symm_apply_apply, mul_smul]⟩
  let fR : I.Cotangent →ₗ[R] J.Cotangent :=
    Ideal.mapCotangent I J (Algebra.ofId R Q) (Ideal.map_le_iff_le_comap.mp le_rfl)
  let f : I.Cotangent →ₗ[R ⧸ I] J.Cotangent :=
    fR.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
  have hkerR : LinearMap.ker fR = Submodule.span R {I.toCotangent x} := by
    simpa [fR, q, Q, J] using quotient_cotangent_map_ker I x
  have hker : LinearMap.ker f = Submodule.span (R ⧸ I) {(z : I.Cotangent)} := by
    apply Submodule.restrictScalars_injective R
    rw [Submodule.restrictScalars_span R (R ⧸ I) Ideal.Quotient.mk_surjective, hz]
    ext v
    exact SetLike.ext_iff.mp hkerR v
  have hsurj : Function.Surjective f := fun y => by
    obtain ⟨v, hv⟩ := Ideal.mapCotangent_surjective_of_comap_eq (A := R) (B := Q)
      Ideal.Quotient.mk_surjective (I := J) (J := I) (comap_map_quotient_span_singleton I x) y
    exact ⟨v, by simpa [f, fR] using hv⟩
  obtain ⟨F', H', hcompl', ⟨bF'⟩, hFmap'⟩ :=
    quotient_free_complement r f hsurj F H hcompl b z hzprimitive
      (ker_comp_subtype_eq_span_singleton f F z hker) hker
  rw [hz] at hker
  refine ⟨F'.restrictScalars B,
    Ideal.Quotient.nontrivial_iff.mp ((Equiv.nontrivial_congr e.toEquiv).mpr inferInstance),
    ⟨H'.restrictScalars B, by simpa using hcompl'⟩,
    nonempty_basis_restrictScalars_of_ringEquiv e (fun _ => rfl) bF', fun t y ht hy =>
      span_range_cons_eq_of_map_eq f F I.toCotangent hker (hz ▸ z.property) t ?_⟩
  rw [← hFmap']
  apply Submodule.restrictScalars_injective B
  rw [Submodule.restrictScalars_span B (R ⧸ I) e.surjective, ← hy]
  refine congrArg (fun g => Submodule.span B (Set.range g)) (funext fun i => ?_)
  change fR (I.toCotangent (t i)) = _
  rw [Ideal.mapCotangent_toCotangent]
  exact congrArg J.toCotangent (Subtype.ext (ht i))

/- Strong induction on rank is used because each quotient ring and ideal changes at a step. -/
private theorem exists_isRegular_of_isCompl_cotangent_induction (r : ℕ) :
    ∀ {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (F : Submodule (R ⧸ I) I.Cotangent)
    (_hproper : r = 0 ∨ I ≠ ⊤)
    (_hpd : Module.projectiveDimension R I ≠ ⊤)
    (_hcompl : ∃ F' : Submodule (R ⧸ I) I.Cotangent, IsCompl F F')
    (_hfree : Nonempty (Module.Basis (Fin r) (R ⧸ I) F)),
    ∃ x : Fin r → I,
      RingTheory.Sequence.IsRegular R (List.ofFn fun i ↦ (x i : R)) ∧
        Submodule.span (R ⧸ I) (Set.range fun i ↦ I.toCotangent (x i)) = F := by
  induction r using Nat.strong_induction_on with
  | h r ih =>
    intro R _ _ _ I F hproper hpd hcompl hfree
    classical
    rcases r with _ | r
    · exact exists_isRegular_of_basis_fin_zero I F hfree
    have hIne : I ≠ ⊤ := hproper.resolve_left r.succ_ne_zero
    have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hIne
    have : IsLocalRing (R ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    obtain ⟨x, hxreg, z, hz, hzprimitive⟩ :=
      exists_regular_primitive_cotangent I (r + 1) F hIne hpd hfree r.succ_pos
    obtain ⟨phi, hphi⟩ :=
      exists_dual_eq_one_of_primitive hcompl.choose_spec hfree.some hzprimitive
    rw [hz] at hphi
    obtain ⟨F', hJne, hcompl', hfree', hspan⟩ :=
      exists_free_summand_quotient_span I F _ hcompl.choose_spec hfree.some x z hz hzprimitive
    let q : Ideal R := Ideal.span {(x : R)}
    let Q := R ⧸ q
    have : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr
      (ne_top_of_le_ne_top hIne (Ideal.span_le.mpr (by rintro y rfl; exact x.property)))
    have : IsLocalRing Q :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk q) Ideal.Quotient.mk_surjective
    obtain ⟨y, hyreg, hyspan⟩ := ih r r.lt_succ_self (R := Q) _ F' (Or.inr hJne)
      (projectiveDimension_map_quotient_span_ne_top I x hxreg hpd phi hphi) hcompl' hfree'
    have hlift (w : I.map (algebraMap R Q)) : ∃ t : I, algebraMap R Q t = w := by
      obtain ⟨v, hv, hvy⟩ := (Ideal.mem_map_iff_of_surjective (algebraMap R Q)
        Ideal.Quotient.mk_surjective).mp w.property
      exact ⟨⟨v, hv⟩, hvy⟩
    choose t ht using fun i => hlift (y i)
    refine ⟨Fin.cons x t, ?_, hspan t y ht hyspan⟩
    have hvt : (List.ofFn fun i => ((Fin.cons x t : Fin (r + 1) → I) i : R)) =
        (x : R) :: List.ofFn fun i => (t i : R) := by
      rw [List.ofFn_succ]
      rfl
    rw [hvt]
    apply regular_cons_of_quotient hxreg
    rw [List.map_ofFn, show (Ideal.Quotient.mk q ∘ fun i => (t i : R)) = fun i => (y i : Q) from
      funext ht]
    exact hyreg

/-- **Stacks Project, Tag 0FJR, with the positive-rank properness correction.** A finite-rank
free direct summand of `I/I²`, for an ideal `I` of finite projective dimension in a Noetherian
local ring, lifts to a regular sequence in `I` whose residue classes generate that summand,
provided `I` is proper when the rank is positive. -/
@[stacks 0FJR]
theorem exists_isRegular_of_isCompl_cotangent
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (r : ℕ) (F : Submodule (R ⧸ I) I.Cotangent)
    (hproper : r = 0 ∨ I ≠ ⊤)
    (hpd : Module.projectiveDimension R I ≠ ⊤)
    (hcompl : ∃ F' : Submodule (R ⧸ I) I.Cotangent, IsCompl F F')
    (hfree : Nonempty (Module.Basis (Fin r) (R ⧸ I) F)) :
    ∃ x : Fin r → I,
      RingTheory.Sequence.IsRegular R (List.ofFn fun i ↦ (x i : R)) ∧
        Submodule.span (R ⧸ I) (Set.range fun i ↦ I.toCotangent (x i)) = F :=
  exists_isRegular_of_isCompl_cotangent_induction r I F hproper hpd hcompl hfree

/-- A direct summand of `I/I²` isomorphic to `R/I`, for an ideal `I` of finite projective
dimension in a Noetherian local ring, is generated by the class of a nonzerodivisor of `R`
belonging to `I`. -/
@[stacks 0FJQ]
theorem exists_isRegular_generator_of_isCompl_cotangent
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : Module.projectiveDimension R I ≠ ⊤)
    (F : Submodule (R ⧸ I) I.Cotangent)
    (hF : ∃ F' : Submodule (R ⧸ I) I.Cotangent, IsCompl F F')
    (hFfree : Nonempty (F ≃ₗ[R ⧸ I] R ⧸ I)) :
    ∃ (x : R) (hx : x ∈ I), IsRegular x ∧
      Submodule.span (R ⧸ I) {I.toCotangent ⟨x, hx⟩} = F := by
  classical
  by_cases hItop : I = ⊤
  · subst I
    refine ⟨1, (show (1 : R) ∈ (⊤ : Ideal R) from trivial), isRegular_one, ?_⟩
    let : Subsingleton (⊤ : Ideal R).Cotangent :=
      (Ideal.cotangent_subsingleton_iff (⊤ : Ideal R)).mpr (by
        change (⊤ : Ideal R) * ⊤ = ⊤
        simp)
    exact Subsingleton.elim _ _
  obtain ⟨e⟩ := hFfree
  obtain ⟨xs, hxs, hspan⟩ :=
    exists_isRegular_of_isCompl_cotangent I 1 F (Or.inr hItop) hI hF
      ⟨(Module.Basis.singleton (Fin 1) (R ⧸ I)).map e.symm⟩
  refine ⟨xs 0, (xs 0).property, ?_, ?_⟩
  · have hsmul : IsSMulRegular R (xs 0 : R) :=
      (RingTheory.Sequence.isRegular_cons_iff R (xs 0 : R) []).mp (by simpa using hxs) |>.1
    rw [isRegular_iff_mem_nonZeroDivisors]
    simpa [nonZeroSMulDivisors, nonZeroDivisors, smul_eq_mul, mul_comm] using
      (isSMulRegular_iff_mem_nonZeroSMulDivisors.mp hsmul)
  · simpa [Set.range_unique] using hspan

end Ideal

end
