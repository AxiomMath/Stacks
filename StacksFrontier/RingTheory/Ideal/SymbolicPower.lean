/-!
# Symbolic powers of a prime ideal

Let `R` be a commutative semiring and let `p ⊆ R` be a prime ideal. For `n : ℕ` the `n`th
*symbolic power* of `p` is the ideal
`p ^ (n) = Ker(R → R_p / p ^ n R_p)`,
that is, the contraction to `R` of the ideal `p ^ n R_p` generated by `p ^ n` in the localization
`R_p`. Concretely it consists of those `x ∈ R` for which `s * x ∈ p ^ n` for some `s ∉ p`, so it is
the `p`-saturation of `p ^ n`; the ordinary power is contained in the symbolic one,
`p ^ n ≤ p ^ (n)`, but the containment can be strict. For instance in
`k[x, y, z] / (x * y - z ^ 2)` with `p = (x, z)` one has `x ∈ p ^ (2)`, since
`y * x = z ^ 2 ∈ p ^ 2` with `y ∉ p`, while `x ∉ p ^ 2` by degree.

## Main definitions

* `Ideal.symbolicPower`: the `n`th symbolic power `p ^ (n)` of a prime ideal `p`, an ideal of `R`.
* `symbolicPower'`: the same ideal over a commutative ring, with the `n`th power taken after the
  extension to `R_p`.

## Main results

* `mem_symbolicPower_iff`: `x ∈ p ^ (n)` exactly when `s * x ∈ p ^ n` for some `s ∉ p`.
* `symbolicPower_isPrimary`, `symbolicPower_radical`: for `n ≠ 0`, `p ^ (n)` is `p`-primary with
  radical `p`.
* `symbolicPower_map_of_flat`: for a flat ring map `R → S` with `p S` prime,
  `p ^ (n) S = (p S) ^ (n)`.

## References

* [Stacks 0313](https://stacks.math.columbia.edu/tag/0313), Definition 10.64.1.
-/

namespace Ideal

@[expose] public section

/-- The `n`th *symbolic power* `p ^ (n)` of a prime ideal `p` of a commutative semiring `R`: the
kernel of `R → R_p / p ^ n R_p`, realized as the contraction to `R` of the ideal `p ^ n R_p` of the
localization `R_p`. -/
@[stacks 0313, ega "IV 11.4.7"]
public def symbolicPower {R : Type*} [CommSemiring R] (p : Ideal R) [p.IsPrime] (n : ℕ) :
    Ideal R :=
  ((p ^ n).map (algebraMap R (Localization.AtPrime p))).under R

end

end Ideal

/-! ### Symbolic powers along a flat ring map

For a flat ring map `φ : R → S` and a prime `p ⊆ R` whose extension `q = p S` is prime, the
extension of the `n`th symbolic power of `p` is the `n`th symbolic power of `q`.
-/

@[expose] public section

open Ideal

/-- The `n`th symbolic power `Ideal.symbolicPower p n` of a prime ideal `p` of a commutative
ring. -/
@[ega "IV 11.4.7"]
def symbolicPower' {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] (n : ℕ) : Ideal R :=
  Ideal.symbolicPower p n

/-- Membership in the symbolic power: `x ∈ p^{(n)}` exactly when the image of `x` in `R_p`
lies in `(p R_p)^n`. -/
theorem mem_symbolicPower_iff_mem_pow_map {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] (n : ℕ)
    (x : R) :
    x ∈ symbolicPower' p n ↔
      algebraMap R (Localization.AtPrime p) x ∈
        (p.map (algebraMap R (Localization.AtPrime p))) ^ n := by
  rw [← Ideal.map_pow]
  exact Ideal.mem_comap

/-- The symbolic power contains the ordinary power: `p ^ n ≤ p^{(n)}`. -/
@[ega "IV 11.4.7" "special case"]
theorem pow_le_symbolicPower {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] (n : ℕ) :
    p ^ n ≤ symbolicPower' p n :=
  Ideal.le_comap_map

/-- The zeroth symbolic power is the whole ring. -/
theorem symbolicPower_zero {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] :
    symbolicPower' p 0 = ⊤ := by
  unfold symbolicPower' Ideal.symbolicPower
  simp [Ideal.map_top]

/-- The first symbolic power is `p` itself. -/
theorem symbolicPower_one {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] :
    symbolicPower' p 1 = p := by
  unfold symbolicPower' Ideal.symbolicPower
  rw [pow_one, Localization.AtPrime.map_eq_maximalIdeal]
  exact Localization.AtPrime.under_maximalIdeal

/-- Saturation characterization of the symbolic power: `x ∈ p^{(n)}` exactly when `s * x ∈ p^n`
for some `s ∉ p`. -/
theorem mem_symbolicPower_iff {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] (n : ℕ) (x : R) :
    x ∈ symbolicPower' p n ↔ ∃ s ∈ p.primeCompl, s * x ∈ p ^ n := by
  rw [mem_symbolicPower_iff_mem_pow_map, ← Ideal.map_pow]
  constructor
  · intro hx
    rw [IsLocalization.mem_map_algebraMap_iff p.primeCompl (Localization.AtPrime p)] at hx
    obtain ⟨⟨y, s⟩, hy⟩ := hx
    simp only [← map_mul] at hy
    rw [IsLocalization.eq_iff_exists p.primeCompl (Localization.AtPrime p)] at hy
    obtain ⟨c, hc⟩ := hy
    refine ⟨c * s, mul_mem c.property s.property, ?_⟩
    rw [show (c : R) * s * x = c * y by linear_combination hc]
    exact Ideal.mul_mem_left _ _ y.property
  · rintro ⟨s, hs, hsx⟩
    have hmem := Ideal.mem_map_of_mem (algebraMap R (Localization.AtPrime p)) hsx
    rw [map_mul] at hmem
    exact (Ideal.unit_mul_mem_iff_mem _
      (IsLocalization.map_units (Localization.AtPrime p) (⟨s, hs⟩ : p.primeCompl))).mp hmem

/-- For a flat ring map `φ` and a prime `p` whose extension `p S` is prime, the contraction of
`p S` is `p` again. -/
theorem comap_map_eq_of_flat_isPrime {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : φ.Flat) (p : Ideal R) [p.IsPrime] (hq : (p.map φ).IsPrime) : (p.map φ).comap φ = p := by
  let := φ.toAlgebra
  have hflat : Module.Flat R S := hφ
  have hbc : Module.Flat (R ⧸ p) (TensorProduct R (R ⧸ p) S) := Module.Flat.baseChange R (R ⧸ p) S
  let e := Algebra.TensorProduct.quotIdealMapEquivQuotTensor (A := R) S p
  have hflatq : Module.Flat (R ⧸ p) (S ⧸ Ideal.map (algebraMap R S) p) :=
    Module.Flat.of_linearEquiv e.toLinearEquiv
  have : Nontrivial (S ⧸ Ideal.map (algebraMap R S) p) :=
    (Ideal.Quotient.nontrivial_iff).mpr hq.ne_top
  have : Module.IsTorsionFree (R ⧸ p) (S ⧸ Ideal.map (algebraMap R S) p) :=
    Module.Flat.isTorsionFree
  have : FaithfulSMul (R ⧸ p) (S ⧸ Ideal.map (algebraMap R S) p) :=
    Module.IsTorsionFree.to_faithfulSMul
  have hinj : Function.Injective (algebraMap (R ⧸ p) (S ⧸ Ideal.map (algebraMap R S) p)) :=
    FaithfulSMul.algebraMap_injective _ _
  apply le_antisymm _ Ideal.le_comap_map
  intro x hx
  rw [Ideal.mem_comap] at hx
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  apply hinj
  rw [map_zero]
  show algebraMap (R ⧸ p) (S ⧸ Ideal.map (algebraMap R S) p) (Ideal.Quotient.mk p x) = 0
  show Ideal.Quotient.mk (Ideal.map (algebraMap R S) p) (φ x) = 0
  exact (Ideal.Quotient.eq_zero_iff_mem).mpr hx

/-- Along a flat ring map with `p S` prime, the extension of the symbolic power is contained in
the symbolic power of the extension. -/
theorem symbolicPower_map_le_of_flat {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : φ.Flat) (p : Ideal R) [p.IsPrime] (hq : (p.map φ).IsPrime) (n : ℕ) :
    (symbolicPower' p n).map φ ≤ symbolicPower' (p.map φ) n := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  obtain ⟨s, hs, hsx⟩ := (mem_symbolicPower_iff p n x).mp hx
  rw [Ideal.mem_comap, mem_symbolicPower_iff]
  refine ⟨φ s, fun hmem => hs ?_, ?_⟩
  · rw [← comap_map_eq_of_flat_isPrime φ hφ p hq]
    exact hmem
  · rw [← map_mul, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem φ hsx

/-- For `n ≠ 0` the radical of `p ^ n R_p` is the maximal ideal of `R_p`. -/
private theorem radical_map_pow_eq_maximalIdeal {R : Type*} [CommRing R] (P : Ideal R) [P.IsPrime]
    {n : ℕ} (hn : n ≠ 0) :
    ((P ^ n).map (algebraMap R (Localization.AtPrime P))).radical =
      IsLocalRing.maximalIdeal (Localization.AtPrime P) := by
  rw [Ideal.map_pow, Ideal.radical_pow _ hn, Localization.AtPrime.map_eq_maximalIdeal,
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime.radical]

/-- For `n ≠ 0` the symbolic power `P^{(n)}` is `P`-primary. -/
theorem symbolicPower_isPrimary {R : Type*} [CommRing R] (P : Ideal R) [P.IsPrime] (n : ℕ)
    (hn : n ≠ 0) : (symbolicPower' P n).IsPrimary := by
  unfold symbolicPower' Ideal.symbolicPower
  apply Ideal.IsPrimary.comap _ _
  apply Ideal.isPrimary_of_isMaximal_radical
  rw [radical_map_pow_eq_maximalIdeal P hn]
  exact IsLocalRing.maximalIdeal.isMaximal _

/-- For `n ≠ 0` the radical of `P^{(n)}` is `P`. -/
theorem symbolicPower_radical {R : Type*} [CommRing R] (P : Ideal R) [P.IsPrime] (n : ℕ)
    (hn : n ≠ 0) : (symbolicPower' P n).radical = P := by
  unfold symbolicPower' Ideal.symbolicPower
  rw [← Ideal.comap_radical, radical_map_pow_eq_maximalIdeal P hn]
  exact Localization.AtPrime.under_maximalIdeal

open scoped TensorProduct in
/-- Base change of a contraction along a flat ring map: extending the contraction of `Jp`
computes the contraction of the extension. -/
theorem map_comap_eq_comap_map_of_flat {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A]
    [CommRing B] [Algebra R S] [Algebra R A] [Algebra R B] [Algebra A B] [Algebra S B]
    [IsScalarTower R A B] [IsScalarTower R S B] (M' : Submonoid R) [IsLocalization M' A]
    [IsLocalization (Algebra.algebraMapSubmonoid S M') B] (hflat : Module.Flat R S)
    (Jp : Ideal A) :
    (Ideal.comap (algebraMap R A) Jp).map (algebraMap R S) =
      (Jp.map (algebraMap A B)).comap (algebraMap S B) := by
  have : Module.Flat R S := hflat
  have rangeLemma :
    ∀ (I : Ideal R),
      LinearMap.range
          ((TensorProduct.lid R S).toLinearMap ∘ₗ
            LinearMap.rTensor S (I.restrictScalars R).subtype) =
        (I.map (algebraMap R S)).restrictScalars R := by
    intro I
    set ι := (I.restrictScalars R).subtype
    set γ := (TensorProduct.lid R S).toLinearMap ∘ₗ LinearMap.rTensor S ι with hγ
    have hγt : ∀ (x : (I.restrictScalars R)) (s : S), γ (x ⊗ₜ[R] s) = (algebraMap R S x) * s := by
      intro x s
      simp [hγ, LinearMap.rTensor_tmul, ι, Algebra.smul_def]
    have hscale :
      ∀ (s : S) (t : (I.restrictScalars R) ⊗[R] S),
        γ ((LinearMap.lTensor _ (LinearMap.mulLeft R s)) t) = s * γ t := by
      intro s
      have hmaps :
        γ.comp (LinearMap.lTensor (I.restrictScalars R) (LinearMap.mulLeft R s)) =
          (LinearMap.mulLeft R s).comp γ := by
        apply TensorProduct.ext'
        intro x s'
        simp only [LinearMap.comp_apply, LinearMap.lTensor_tmul, LinearMap.mulLeft_apply]
        rw [hγt, hγt]; ring
      intro t
      exact LinearMap.congr_fun hmaps t
    apply le_antisymm
    · rw [LinearMap.range_le_iff_comap, eq_top_iff]
      intro t _
      simp only [Submodule.mem_comap]
      induction t using TensorProduct.induction_on with
      | zero =>
        rw [map_zero]; exact Submodule.zero_mem _
      | tmul a s =>
        rw [hγt]
        exact
          (Submodule.restrictScalars_mem _ _ _).mpr
            (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ a.property))
      | add x y hx hy =>
        rw [map_add]; exact Submodule.add_mem _ (hx trivial) (hy trivial)
    · intro z hz
      simp only [Submodule.restrictScalars_mem] at hz
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨x, hx, rfl⟩
        exact
          ⟨(⟨x, hx⟩ : (I.restrictScalars R)) ⊗ₜ[R] 1, by
            rw [hγt]; simp⟩
      · exact ⟨0, map_zero γ⟩
      · rintro a b _ _ ⟨ta, hta⟩ ⟨tb, htb⟩; exact ⟨ta + tb, by rw [map_add, hta, htb]⟩
      · rintro s a _ ⟨t, ht⟩
        exact
          ⟨(LinearMap.lTensor _ (LinearMap.mulLeft R s)) t, by rw [hscale s t, ht, smul_eq_mul]⟩
  have betaIff :
    ∀ (y : S),
      ((1 : A ⧸ Jp) ⊗ₜ[R] y = 0) ↔ y ∈ (Ideal.comap (algebraMap R A) Jp).map (algebraMap R S) := by
    intro y
    set π : R →ₗ[R] (A ⧸ Jp) :=
      (Ideal.Quotient.mkₐ R Jp).toLinearMap ∘ₗ (Algebra.linearMap R A) with hπ
    have hπ1 : π 1 = (1 : A ⧸ Jp) := by simp [hπ, Algebra.linearMap_apply]
    have hkerπ : LinearMap.ker π = (Ideal.comap (algebraMap R A) Jp).restrictScalars R := by
      ext x
      simp only [hπ, LinearMap.mem_ker, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
        Algebra.linearMap_apply, Ideal.Quotient.mkₐ_eq_mk, Submodule.restrictScalars_mem,
        Ideal.mem_comap]
      rw [Ideal.Quotient.eq_zero_iff_mem]
    have hexact :
      Function.Exact (LinearMap.rTensor S (LinearMap.ker π).subtype) (LinearMap.rTensor S π) :=
      Module.Flat.rTensor_exact S (LinearMap.exact_subtype_ker_map π)
    have hval : (1 : A ⧸ Jp) ⊗ₜ[R] y = LinearMap.rTensor S π ((1 : R) ⊗ₜ[R] y) := by
      rw [LinearMap.rTensor_tmul, hπ1]
    rw [hval]
    have hlid : ((1 : R) ⊗ₜ[R] y) = (TensorProduct.lid R S).symm y := by simp
    rw [hlid]
    rw [show
        (LinearMap.rTensor S π ((TensorProduct.lid R S).symm y) = 0) ↔
          (TensorProduct.lid R S).symm y ∈ LinearMap.ker (LinearMap.rTensor S π)
        from Iff.rfl]
    rw [hexact.linearMap_ker_eq]
    constructor
    · intro hmem
      have hy :
        y ∈
          LinearMap.range
            ((TensorProduct.lid R S).toLinearMap ∘ₗ
              LinearMap.rTensor S (LinearMap.ker π).subtype) := by
        rw [LinearMap.range_comp]
        exact ⟨(TensorProduct.lid R S).symm y, hmem, by simp⟩
      rwa [hkerπ, rangeLemma (Ideal.comap (algebraMap R A) Jp)] at hy
    · intro hy
      have hyr :
        y ∈
          LinearMap.range
            ((TensorProduct.lid R S).toLinearMap ∘ₗ
              LinearMap.rTensor S (LinearMap.ker π).subtype) := by
        rw [hkerπ, rangeLemma (Ideal.comap (algebraMap R A) Jp)]; exact hy
      rw [LinearMap.range_comp] at hyr
      obtain ⟨w, hw, hwy⟩ := hyr
      have : (TensorProduct.lid R S).symm y = w := by
        apply (TensorProduct.lid R S).injective
        rw [LinearEquiv.apply_symm_apply]; simpa using hwy.symm
      rw [this]; exact hw
  have hpo : Algebra.IsPushout R S A B := Algebra.isPushout_of_isLocalization M' A S B
  have hpo2 : Algebra.IsPushout R A S B := hpo.symm
  let eAB : A ⊗[R] S ≃ₗ[A] B := hpo2.out.equiv
  have heAB : ∀ y : S, eAB ((1 : A) ⊗ₜ[R] y) = algebraMap S B y := by
    intro y
    rw [show eAB ((1 : A) ⊗ₜ[R] y) = (1 : A) • _ from hpo2.out.equiv_tmul 1 y]
    simp [IsScalarTower.toAlgHom_apply]
  have heAB' : ∀ y : S, eAB.symm (algebraMap S B y) = (1 : A) ⊗ₜ[R] y := by
    intro y; rw [← heAB y, LinearEquiv.symm_apply_apply]
  let e1 := Algebra.TensorProduct.quotIdealMapEquivQuotTensor B Jp
  let ec : (A ⧸ Jp) ⊗[A] B ≃ₗ[A] (A ⧸ Jp) ⊗[A] (A ⊗[R] S) :=
    TensorProduct.congr (LinearEquiv.refl A (A ⧸ Jp)) eAB.symm
  let ecb := TensorProduct.AlgebraTensorModule.cancelBaseChange R A A (A ⧸ Jp) S
  let Φ : (B ⧸ Ideal.map (algebraMap A B) Jp) →ₗ[A] (A ⧸ Jp) ⊗[R] S :=
    (ecb.toLinearMap ∘ₗ ec.toLinearMap) ∘ₗ (e1.toLinearEquiv.restrictScalars A).toLinearMap
  have hΦinj : Function.Injective Φ :=
    (ecb.injective.comp ec.injective).comp (e1.toLinearEquiv.restrictScalars A).injective
  have hΦval : ∀ y : S, Φ (Ideal.Quotient.mk _ (algebraMap S B y)) = (1 : A ⧸ Jp) ⊗ₜ[R] y := by
    intro y
    simp only [Φ, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.restrictScalars_apply]
    rw [show
        (e1.toLinearEquiv) (Ideal.Quotient.mk _ (algebraMap S B y)) =
          (1 : A ⧸ Jp) ⊗ₜ[A] (algebraMap S B y)
        by rw [AlgEquiv.toLinearEquiv_apply, Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk]]
    rw [show ec ((1 : A ⧸ Jp) ⊗ₜ[A] (algebraMap S B y)) = (1 : A ⧸ Jp) ⊗ₜ[A] ((1 : A) ⊗ₜ[R] y) from
        by simp only [ec, TensorProduct.congr_tmul, LinearEquiv.refl_apply, heAB']]
    simp only [ecb, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul]
  ext y
  rw [Ideal.mem_comap]
  rw [← Ideal.Quotient.eq_zero_iff_mem (I := Ideal.map (algebraMap A B) Jp)]
  rw [← betaIff y]
  constructor
  · intro h
    apply hΦinj
    rw [hΦval, h, map_zero]
  · intro h
    rw [← hΦval y, h, map_zero]

/-- Extending an ideal along `R → A → B` or along `R → S → B` gives the same ideal of `B`. -/
private theorem map_map_eq_map_map_of_isScalarTower {R S A B : Type*} [CommRing R] [CommRing S]
    [CommRing A] [CommRing B] [Algebra R S] [Algebra R A] [Algebra R B] [Algebra A B]
    [Algebra S B] [IsScalarTower R A B] [IsScalarTower R S B] (I : Ideal R) :
    (I.map (algebraMap R A)).map (algebraMap A B) =
      (I.map (algebraMap R S)).map (algebraMap S B) := by
  rw [Ideal.map_map, Ideal.map_map, ← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]

/-- Along a flat ring map, the extension of `p^{(n)}` is the contraction of the corresponding
power in the localized ring. -/
theorem symbolicPower_map_eq_comap {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : φ.Flat) (p : Ideal R) [p.IsPrime] (n : ℕ) :
    letI := φ.toAlgebra
    (symbolicPower' p n).map φ =
      (((p.map φ).map (algebraMap S (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)))) ^
            n).comap
        (algebraMap S (Localization (Algebra.algebraMapSubmonoid S p.primeCompl))) := by
  let := φ.toAlgebra
  set A := Localization.AtPrime p with hA
  set B := Localization (Algebra.algebraMapSubmonoid S p.primeCompl) with hB
  have hflat : Module.Flat R S := hφ
  have key :=
    map_comap_eq_comap_map_of_flat (R := R) (S := S) (A := A) (B := B) p.primeCompl hflat
      ((p ^ n).map (algebraMap R A))
  have hφeq : (algebraMap R S) = φ := rfl
  rw [show ((p ^ n).map (algebraMap R A)).comap (algebraMap R A) = symbolicPower' p n from
      rfl] at key
  have hrhs :
    ((p ^ n).map (algebraMap R A)).map (algebraMap A B) =
      ((p.map φ).map (algebraMap S B)) ^ n := by
    rw [map_map_eq_map_map_of_isScalarTower (S := S), Ideal.map_pow, Ideal.map_pow]
    rfl
  rwa [hrhs, hφeq] at key

open scoped TensorProduct in
/-- The natural `B`-linear map `B ⊗[A] p → B`, `b ⊗ a ↦ b * algebraMap a`. -/
noncomputable def sqCoreNatMap (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (p : Submodule A A) : (B ⊗[A] ↥p) →ₗ[B] B :=
  (TensorProduct.AlgebraTensorModule.rid A B B) ∘ₗ (LinearMap.baseChange B p.subtype)

open scoped TensorProduct in
/-- `sqCoreNatMap A B p` sends `b ⊗ a` to `b * algebraMap A B a`. -/
@[simp]
lemma sqCoreNatMap_tmul (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] (p : Submodule A A)
    (b : B) (a : ↥p) : sqCoreNatMap A B p (b ⊗ₜ a) = b * algebraMap A B a.1 := by
  simp [sqCoreNatMap, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_comm]

open scoped TensorProduct in
/-- The range of `sqCoreNatMap` is the extension `p B` of `p`. -/
@[ega "0 1.0.3" "special case"]
lemma sqCoreNatMap_range (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] (p : Ideal A) :
    LinearMap.range (sqCoreNatMap A B (p : Submodule A A)) =
      ((p.map (algebraMap A B) : Ideal B) : Submodule B B) := by
  apply le_antisymm
  · rintro _ ⟨t, rfl⟩
    induction t with
    | zero => simp
    | tmul b a =>
      rw [sqCoreNatMap_tmul]; exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ a.property)
    | add x y hx hy =>
      rw [map_add]; exact Submodule.add_mem _ hx hy
  · rw [Ideal.map, Submodule.span_le]
    rintro _ ⟨a, ha, rfl⟩
    exact ⟨(1 : B) ⊗ₜ ⟨a, ha⟩, by simp⟩

open scoped TensorProduct in
/-- For `B` flat over `A`, the map `B ⊗_A p → B` is injective. -/
@[sga "3 III 4.13" "partial", sga "3 VIB 11.7" "affine ideal inclusion"]
lemma sqCoreNatMap_injective (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [Module.Flat A B] (p : Submodule A A) : Function.Injective (sqCoreNatMap A B p) := by
  rw [sqCoreNatMap, LinearMap.coe_comp]
  apply Function.Injective.comp (TensorProduct.AlgebraTensorModule.rid A B B).injective
  rw [LinearMap.baseChange_eq_ltensor]
  exact Module.Flat.lTensor_preserves_injective_linearMap _ (Subtype.coe_injective)

open scoped TensorProduct in
/-- The kernel of `m ↦ 1 ⊗ m : M → (A ⧸ 𝔪) ⊗[A] M` is `𝔪 • ⊤`. -/
lemma sqCore_ker_mk_one (A M : Type*) [CommRing A] [AddCommGroup M] [Module A M] (𝔪 : Ideal A) :
    LinearMap.ker (TensorProduct.mk A (A ⧸ 𝔪) M (1 : A ⧸ 𝔪)) = 𝔪 • (⊤ : Submodule A M) := by
  have hcomp :
    (TensorProduct.quotTensorEquivQuotSMul M 𝔪).toLinearMap ∘ₗ
        (TensorProduct.mk A (A ⧸ 𝔪) M (1 : A ⧸ 𝔪)) =
      (𝔪 • (⊤ : Submodule A M)).mkQ := by
    ext x
    simp only [LinearMap.coe_comp, Function.comp_apply, TensorProduct.mk_apply,
      LinearEquiv.coe_coe, Submodule.mkQ_apply]
    rw [show (1 : A ⧸ 𝔪) = Ideal.Quotient.mk 𝔪 1 from rfl,
      TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul]
  have hk :
    LinearMap.ker (TensorProduct.mk A (A ⧸ 𝔪) M (1 : A ⧸ 𝔪)) =
      LinearMap.ker ((𝔪 • (⊤ : Submodule A M)).mkQ) := by
    rw [← hcomp, LinearMap.ker_comp_of_ker_eq_bot]
    rw [LinearMap.ker_eq_bot]
    exact (TensorProduct.quotTensorEquivQuotSMul M 𝔪).injective
  rw [hk, Submodule.ker_mkQ]

open scoped TensorProduct in
/-- If `Vi` is a `κ = A ⧸ 𝔪`-module (`κ` a field) and `(A ⧸ 𝔪) ⊗[A] B`
is a domain, then any `u : B` whose image `1 ⊗ u` is nonzero acts injectively on `B ⊗[A] Vi`. -/
theorem sqCore_endpoint_inj (A B Vi : Type*) [CommRing A] [CommRing B] [Algebra A B] (𝔪 : Ideal A)
    [AddCommGroup Vi] [Module A Vi] [Module (A ⧸ 𝔪) Vi] [IsScalarTower A (A ⧸ 𝔪) Vi]
    (hfield : IsField (A ⧸ 𝔪)) [IsDomain ((A ⧸ 𝔪) ⊗[A] B)] (u : B)
    (hu : (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) ≠ 0) (z : B ⊗[A] Vi) (hz : u • z = 0) :
    z = 0 := by
  let : Field (A ⧸ 𝔪) := hfield.toField
  set e : (((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi) ≃ₗ[A] (B ⊗[A] Vi) :=
    (((TensorProduct.comm (A ⧸ 𝔪) ((A ⧸ 𝔪) ⊗[A] B) Vi).restrictScalars A).trans
          ((TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ 𝔪) (A ⧸ 𝔪) Vi
                B).restrictScalars
            A)).trans
      (TensorProduct.comm A Vi B) with
    he
  have hfreeVi : Module.Free (A ⧸ 𝔪) Vi := Module.Free.of_divisionRing (A ⧸ 𝔪) Vi
  have hfree : Module.Free ((A ⧸ 𝔪) ⊗[A] B) (((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi) := Module.Free.tensor
  have hflat : Module.Flat ((A ⧸ 𝔪) ⊗[A] B) (((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi) := Module.Flat.of_free
  have htf : Module.IsTorsionFree ((A ⧸ 𝔪) ⊗[A] B) (((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi) :=
    Module.Flat.isTorsionFree
  have hact :
    ∀ w : ((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi,
      e ((TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) • w) = u • e w := by
    intro w
    induction w with
    | zero => simp
    | add a b ha hb => rw [smul_add, map_add, ha, hb, map_add, smul_add]
    | tmul d v =>
      rw [he]
      simp only [LinearEquiv.trans_apply, LinearEquiv.restrictScalars_apply]
      induction d with
      | zero => simp
      | add d1 d2 h1 h2 =>
        simp only [TensorProduct.add_tmul, smul_add, map_add]
        rw [h1, h2]
      | tmul a
        b =>
        rw [TensorProduct.smul_tmul',
          show ((TensorProduct.mk A (A ⧸ 𝔪) B) 1) u • a ⊗ₜ[A] b = a ⊗ₜ[A] (u * b) by
            rw [TensorProduct.mk_apply, smul_eq_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul,
              mul_comm u b]]
        simp only [TensorProduct.comm_tmul,
          TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, TensorProduct.smul_tmul',
          smul_eq_mul]
  obtain ⟨w, rfl⟩ := e.surjective z
  rw [← hact] at hz
  have hw : (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) • w = 0 := by
    apply e.injective
    rw [hz, e.map_zero]
  have hreg : IsRegular (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) := IsRegular.of_ne_zero hu
  have hsmul :
    IsSMulRegular (((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi) (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) :=
    htf.isSMulRegular hreg
  have hw0 : w = 0 := by
    have hww :
      (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) • w =
        (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) • (0 : ((A ⧸ 𝔪) ⊗[A] B) ⊗[A ⧸ 𝔪] Vi) := by
      rw [hw, smul_zero]
    exact hsmul hww
  rw [hw0, e.map_zero]

open scoped TensorProduct in
/-- For `B` flat over `A` with `A ⧸ 𝔪` a field and
`B ⧸ 𝔪 B` a domain, an element `u ∉ 𝔪 B` is a nonzerodivisor on each `(𝔪 B)^i / (𝔪 B)^{i+1}`. -/
theorem sq_core_cancel {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (hflat : Module.Flat A B) (𝔪 : Ideal A) (hfield : IsField (A ⧸ 𝔪))
    (hdom : IsDomain (B ⧸ 𝔪.map (algebraMap A B))) (u : B) (hu : u ∉ 𝔪.map (algebraMap A B))
    (i : ℕ) (x : B) (hx : x ∈ (𝔪.map (algebraMap A B)) ^ i)
    (hux : u * x ∈ (𝔪.map (algebraMap A B)) ^ (i + 1)) :
    x ∈ (𝔪.map (algebraMap A B)) ^ (i + 1) := by
  set J := 𝔪.map (algebraMap A B) with hJ
  set Mi := ((𝔪 ^ i : Ideal A) : Submodule A A) with hMi
  set Vi := (A ⧸ 𝔪) ⊗[A] ↥Mi with hViDef
  set q : ↥Mi →ₗ[A] Vi := TensorProduct.mk A (A ⧸ 𝔪) ↥Mi (1 : A ⧸ 𝔪) with hq
  set Φ := sqCoreNatMap A B Mi with hΦ
  set Bq : (B ⊗[A] ↥Mi) →ₗ[B] (B ⊗[A] Vi) := LinearMap.baseChange B q with hBq
  have : IsDomain ((A ⧸ 𝔪) ⊗[A] B) :=
    Function.Injective.isDomain
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B 𝔪).symm.toRingEquiv.toRingHom
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B 𝔪).symm.toRingEquiv.injective
  have hu' : (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) ≠ 0 := by
    have key := Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk B 𝔪 u
    intro h
    apply hu
    have hmk : (Ideal.Quotient.mk (𝔪.map (algebraMap A B)) u) = 0 := by
      apply (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B 𝔪).injective
      rw [key, show (1 : A ⧸ 𝔪) ⊗ₜ[A] u = (TensorProduct.mk A (A ⧸ 𝔪) B (1 : A ⧸ 𝔪) u) from rfl, h,
        map_zero]
    rwa [Ideal.Quotient.eq_zero_iff_mem] at hmk
  have hrange : LinearMap.range Φ = ((J ^ i : Ideal B) : Submodule B B) := by
    rw [hΦ, sqCoreNatMap_range A B (𝔪 ^ i), Ideal.map_pow]
  obtain ⟨ξ, hξ⟩ : x ∈ LinearMap.range Φ := by rwa [hrange]
  have hkerq : LinearMap.ker q = 𝔪 • (⊤ : Submodule A ↥Mi) := sqCore_ker_mk_one A ↥Mi 𝔪
  set incl : (B ⊗[A] ↥(LinearMap.ker q)) →ₗ[B] (B ⊗[A] ↥Mi) :=
    LinearMap.baseChange B (LinearMap.ker q).subtype with hincl
  have hexact : Function.Exact incl Bq := by
    have h :=
      Module.Flat.lTensor_exact B (N := ↥(LinearMap.ker q)) (N' := ↥Mi) (N'' := Vi) (f :=
        (LinearMap.ker q).subtype) (g := q) (by rw [LinearMap.exact_iff, Submodule.range_subtype])
    rw [Function.Exact] at h ⊢
    intro y
    rw [hincl, hBq, LinearMap.baseChange_eq_ltensor, LinearMap.baseChange_eq_ltensor]
    exact h y
  have hmapS :
    Submodule.map Φ (LinearMap.range incl) = ((J ^ (i + 1) : Ideal B) : Submodule B B) := by
    rw [← LinearMap.range_comp]
    apply le_antisymm
    · rintro _ ⟨t, rfl⟩
      induction t with
      | zero =>
        rw [map_zero]; exact Submodule.zero_mem _
      | tmul b
        y =>
        rw [LinearMap.comp_apply, hincl, hΦ, LinearMap.baseChange_tmul, sqCoreNatMap_tmul]
        apply Ideal.mul_mem_left
        rw [hJ, ← Ideal.map_pow]
        apply Ideal.mem_map_of_mem
        have hy : ((y : ↥Mi) : ↥Mi) ∈ 𝔪 • (⊤ : Submodule A ↥Mi) := hkerq ▸ y.property
        show ((y : ↥Mi) : A) ∈ (𝔪 ^ (i + 1) : Ideal A)
        refine Submodule.smul_induction_on hy ?_ ?_
        · intro a ha z _
          have hz : ((a • z : ↥Mi) : A) = a * (z : A) := rfl
          rw [hz, pow_succ, mul_comm a]
          exact Ideal.mul_mem_mul z.property ha
        · intro p w hp hw
          rw [Submodule.coe_add]; exact Ideal.add_mem _ hp hw
      | add s t hs ht =>
        rw [map_add]; exact Submodule.add_mem _ hs ht
    · rw [hJ, ← Ideal.map_pow, Ideal.map, Submodule.span_le]
      rintro _ ⟨a, ha, rfl⟩
      refine ⟨(1 : B) ⊗ₜ ⟨⟨a, Ideal.pow_le_pow_right (Nat.le_succ i) ha⟩, ?_⟩, ?_⟩
      · rw [hkerq, Submodule.mem_smul_top_iff]
        have hsm :
          𝔪 • ((𝔪 ^ i : Ideal A) : Submodule A A) = ((𝔪 ^ (i + 1) : Ideal A) : Submodule A A) := by
          rw [smul_eq_mul, ← pow_succ']
        change
          ((⟨a, Ideal.pow_le_pow_right (Nat.le_succ i) ha⟩ :
                ↥((𝔪 ^ i : Ideal A) : Submodule A A)) :
              A) ∈
            𝔪 • ((𝔪 ^ i : Ideal A) : Submodule A A)
        rw [hsm]; exact ha
      · rw [LinearMap.comp_apply, hincl, hΦ, LinearMap.baseChange_tmul, sqCoreNatMap_tmul, one_mul]
        rfl
  have : Module.Flat A B := hflat
  have hΦinj : Function.Injective Φ := sqCoreNatMap_injective A B Mi
  have hdir : ∀ ζ, Φ ζ ∈ (J ^ (i + 1) : Ideal B) ↔ Bq ζ = 0 := by
    intro ζ
    constructor
    · intro hmem
      rw [← hmapS] at hmem
      obtain ⟨ζ', hζ', hΦeq⟩ := hmem
      have hζζ' : ζ = ζ' := hΦinj hΦeq.symm
      rw [hζζ']
      obtain ⟨w', rfl⟩ := hζ'
      exact hexact.apply_apply_eq_zero w'
    · intro h0
      have hr : ζ ∈ LinearMap.range incl := (hexact ζ).mp h0
      have := Submodule.mem_map_of_mem (f := Φ) hr
      rwa [hmapS] at this
  set z := Bq ξ with hz
  have huz : u • z = 0 := by
    have h1 : Bq (u • ξ) = u • z := by rw [hz, Bq.map_smul]
    have h2 : Φ (u • ξ) ∈ (J ^ (i + 1) : Ideal B) := by
      have : Φ (u • ξ) = u * x := by
        rw [Φ.map_smul, hξ]; rfl
      rw [this]; exact hux
    rw [(hdir (u • ξ)).mp h2] at h1
    exact h1.symm
  have hfin := (hdir ξ).mpr (sqCore_endpoint_inj A B Vi 𝔪 hfield u hu' z huz)
  rwa [hξ] at hfin

/-- Elements of the complement of `p S` act as nonzerodivisors on the powers of `p S` in the
localization. -/
theorem nzd_localization_pow {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (hφ : φ.Flat)
    (p : Ideal R) [p.IsPrime] (hq : (p.map φ).IsPrime) (n : ℕ) (t : S)
    (ht : t ∈ (p.map φ).primeCompl) (z : S)
    (hz :
      letI := φ.toAlgebra
      algebraMap S (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) (t * z) ∈
        ((p.map φ).map
            (algebraMap S (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)))) ^
          n) :
    letI := φ.toAlgebra
    algebraMap S (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) z ∈
      ((p.map φ).map (algebraMap S (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)))) ^
        n := by
  let := φ.toAlgebra
  have hflatRS : Module.Flat R S := hφ
  set B := Localization (Algebra.algebraMapSubmonoid S p.primeCompl) with hB
  set M := Algebra.algebraMapSubmonoid S p.primeCompl with hM
  set A := Localization.AtPrime p with hA
  have hcontract : (p.map φ).comap φ = p := comap_map_eq_of_flat_isPrime φ hφ p hq
  have hdisj : Disjoint (M : Set S) ((p.map φ) : Set S) := by
    rw [Set.disjoint_left]
    rintro x hxM hxq
    rw [SetLike.mem_coe, hM,
      show Algebra.algebraMapSubmonoid S p.primeCompl = (p.primeCompl).map (algebraMap R S) from
        rfl,
      Submonoid.mem_map] at hxM
    obtain ⟨r, hr, rfl⟩ := hxM
    apply hr; rw [← hcontract]; rw [SetLike.mem_coe] at hxq; exact hxq
  have hbridge :
    (p.map φ).map (algebraMap S B) = (p.map (algebraMap R A)).map (algebraMap A B) := by
    exact (map_map_eq_map_map_of_isScalarTower (S := S) p).symm
  set J := (p.map φ).map (algebraMap S B) with hJ
  have hJprime : J.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint M B (p.map φ) hq hdisj
  have : IsDomain (B ⧸ J) := Ideal.Quotient.isDomain _
  have hcomap : J.comap (algebraMap S B) = p.map φ :=
    IsLocalization.under_map_of_isPrime_disjoint M B (I := p.map φ) hq hdisj
  have hflatAB : Module.Flat A B := Module.Flat.instLocalizationAlgebraMapSubmonoid p.primeCompl
  have hfield : IsField (A ⧸ (p.map (algebraMap R A))) := by
    have h1 : (p.map (algebraMap R A)) = IsLocalRing.maximalIdeal A :=
      Localization.AtPrime.map_eq_maximalIdeal
    rw [h1]
    exact
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp
        (IsLocalRing.maximalIdeal.isMaximal A)
  have hdomAB : IsDomain (B ⧸ (p.map (algebraMap R A)).map (algebraMap A B)) := by
    rw [← hbridge]; infer_instance
  have hu : algebraMap S B t ∉ (p.map (algebraMap R A)).map (algebraMap A B) := by
    rw [← hbridge]
    intro hmem
    have hcm : t ∈ J.comap (algebraMap S B) := hmem
    rw [hcomap] at hcm; exact ht hcm
  have SQ :
    ∀ (i : ℕ) (x : B), x ∈ J ^ i → (algebraMap S B t) * x ∈ J ^ (i + 1) → x ∈ J ^ (i + 1) := by
    intro i x hx hux
    rw [hbridge] at hx hux ⊢
    exact
      sq_core_cancel hflatAB (p.map (algebraMap R A)) hfield hdomAB (algebraMap S B t) hu i x hx
        hux
  have hcancel : ∀ (m : ℕ) (b : B), (algebraMap S B t) * b ∈ J ^ m → b ∈ J ^ m := by
    intro m
    induction m with
    | zero =>
      intro b _; simp
    | succ k ih =>
      intro b hb
      have hbk : b ∈ J ^ k := ih b ((Ideal.pow_le_pow_right (Nat.le_succ k)) hb)
      exact SQ k b hbk hb
  exact hcancel n (algebraMap S B z) (by rwa [← map_mul])

/-- If `t ∉ p S` and `t * y` lies in the extension of `p^{(n)}`, then so does
`y`. -/
theorem primeCompl_nzd_on_symbolicPower_map {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : φ.Flat) (p : Ideal R) [p.IsPrime] (hq : (p.map φ).IsPrime) (n : ℕ) (t : S)
    (ht : t ∈ (p.map φ).primeCompl) (y : S) (hty : t * y ∈ (symbolicPower' p n).map φ) :
    y ∈ (symbolicPower' p n).map φ := by
  let := φ.toAlgebra
  rw [symbolicPower_map_eq_comap φ hφ p n] at hty ⊢
  rw [Ideal.mem_comap] at hty ⊢
  exact nzd_localization_pow φ hφ p hq n t ht y hty

/-- Along a flat ring map with `p S` prime, the symbolic power of the extension is contained in
the extension of the symbolic power. -/
theorem le_symbolicPower_map_of_flat {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : φ.Flat) (p : Ideal R) [p.IsPrime] (hq : (p.map φ).IsPrime) (n : ℕ) :
    symbolicPower' (p.map φ) n ≤ (symbolicPower' p n).map φ := by
  intro y hy
  obtain ⟨t, ht, hty⟩ := (mem_symbolicPower_iff _ n y).mp hy
  have hle : (p.map φ) ^ n ≤ (symbolicPower' p n).map φ := by
    rw [← Ideal.map_pow]
    exact Ideal.map_mono (pow_le_symbolicPower p n)
  exact primeCompl_nzd_on_symbolicPower_map φ hφ p hq n t ht y (hle hty)

/-- For a flat ring map `R → S` and a prime `p ⊆ R` whose extension `q = p S` is prime,
`p^{(n)} S = q^{(n)}`. -/
@[stacks 0BC0]
theorem symbolicPower_map_of_flat {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (hφ : φ.Flat) (p : Ideal R) [p.IsPrime] (hq : (p.map φ).IsPrime) (n : ℕ) :
    (symbolicPower' p n).map φ = symbolicPower' (p.map φ) n :=
  le_antisymm (symbolicPower_map_le_of_flat φ hφ p hq n) (le_symbolicPower_map_of_flat φ hφ p hq n)
