module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.AlgebraicTopology.SimplexCategory.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Prod
public import Mathlib.RingTheory.Flat.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# Annihilators and flat base change

Let `φ : R → S` be a homomorphism of commutative rings. Via `φ`, every `S`-module is regarded
as an `R`-module and `S` is an `R`-algebra. For an `R`-module `M`:

* `Ann_R(m) = { f ∈ R : f • m = 0 }` is the annihilator of an element `m ∈ M`, an ideal of
  `R`, being the kernel of `R → M`, `f ↦ f • m`.
* `Ann_R(M) = { f ∈ R : f • x = 0 for all x ∈ M }` is the annihilator of `M`.
* For an ideal `I ⊆ R`, the extension `I S` is the ideal of `S` generated by `φ(I)`.
* The base change of `M` is the `S`-module `S ⊗_R M`.

## Main results

For `φ` flat, i.e. `S` flat as an `R`-module:

* `ann_extension_eq_ann_baseChange_elem`: for every `m ∈ M`, `Ann_R(m) S = Ann_S(1 ⊗ m)`.
* `map_annihilator_span_singleton_of_flat`: for every `x ∈ R`, `Ann_R(x) S = Ann_S(φ x)`.
* `ann_extension_eq_ann_baseChange_module`: if moreover `M` is a finite `R`-module, then
  `Ann_R(M) S = Ann_S(S ⊗_R M)`.
* `map_inf_of_flat`, `Ideal.map_iInf_of_flat`: extension of ideals along a flat ring map
  commutes with binary, hence with finite, intersections.

## Implementation notes

* The ring map `φ : R → S` is modelled by an `Algebra R S` instance; the extension `I S` is
  `Ideal.map (algebraMap R S) I`, the ideal of `S` generated by the image of `I`.
* Flatness of `φ` is `Module.Flat R S`.
* The base change is written `S ⊗[R] M` with `S` on the *left* factor: this is Mathlib's
  standard orientation, for which the `S`-module structure on `S ⊗[R] M` is found
  automatically. It is canonically isomorphic to the `M ⊗_R S` of the informal statement,
  with `m ⊗ 1` corresponding to `1 ⊗ₜ m`; this only swaps the tensor factors and changes
  nothing mathematically.
* `Ann_R(m)` is `Ideal.torsionOf R M m`, `Ann_R(M)` is `Module.annihilator R M`, and
  finiteness of `M` is `Module.Finite R M`.
-/

@[expose] public section

open TensorProduct

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
variable {M : Type*} [AddCommGroup M] [Module R M]

/-- The right-unitor `S ⊗ R ≅ S` carries the base change of an ideal `I` to its extension. -/
private theorem map_rid_baseChange_eq_map (I : Ideal R) :
    Submodule.map (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap
      (Submodule.baseChange S I) = Ideal.map (algebraMap R S) I := by
  rw [Submodule.baseChange_eq_span, Submodule.map_span]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro x ⟨y, hy, rfl⟩
    simp only [SetLike.mem_coe] at hy
    obtain ⟨r, hr, rfl⟩ := hy
    have : (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap ((TensorProduct.mk R S R 1) r)
        = algebraMap R S r := by
      simp [TensorProduct.AlgebraTensorModule.rid, Algebra.smul_def]
    rw [this]; exact Ideal.mem_map_of_mem _ hr
  · rw [Ideal.map, Ideal.span_le]
    rintro x ⟨r, hr, rfl⟩
    apply Submodule.subset_span
    refine ⟨(TensorProduct.mk R S R 1) r, ⟨r, hr, rfl⟩, ?_⟩
    simp [TensorProduct.AlgebraTensorModule.rid, Algebra.smul_def]

/-- For a flat ring map `φ : R → S` and any `m` in an `R`-module `M`, the extension of the
annihilator `Ann_R(m)` to `S` equals the `S`-annihilator of the base-changed element
`1 ⊗ m ∈ S ⊗_R M`: `Ann_R(m) S = Ann_S(1 ⊗ m)`. -/
@[stacks 07T8]
theorem ann_extension_eq_ann_baseChange_elem [Module.Flat R S] (m : M) :
    Ideal.map (algebraMap R S) (Ideal.torsionOf R M m)
      = Ideal.torsionOf S (S ⊗[R] M) ((1 : S) ⊗ₜ[R] m) := by
  set f : R →ₗ[R] M := LinearMap.toSpanSingleton R M m with hf
  set i : (LinearMap.ker f) →ₗ[R] R := (LinearMap.ker f).subtype with hi
  have hexactRf : Function.Exact i f := LinearMap.exact_subtype_ker_map f
  have hexactS : Function.Exact (LinearMap.lTensor S i) (LinearMap.lTensor S f) :=
    Module.Flat.lTensor_exact S hexactRf
  have hexactS' : Function.Exact (LinearMap.baseChange S i) (LinearMap.baseChange S f) := by
    intro x
    have := hexactS x
    simpa [LinearMap.baseChange_eq_ltensor] using this
  have hker : (LinearMap.baseChange S f).ker = (LinearMap.baseChange S i).range :=
    LinearMap.exact_iff.mp hexactS'
  -- Step A : torsionOf S (...) = map rid (ker (baseChange S f))
  have hA : Ideal.torsionOf S (S ⊗[R] M) ((1:S) ⊗ₜ[R] m)
      = Submodule.map (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap
          (LinearMap.ker (LinearMap.baseChange S f)) := by
    have hcomp : (LinearMap.baseChange S f).comp
          (TensorProduct.AlgebraTensorModule.rid R S S).symm.toLinearMap
        = LinearMap.toSpanSingleton S (S ⊗[R] M) ((1:S) ⊗ₜ[R] m) := by
      ext
      simp [hf, LinearMap.toSpanSingleton, TensorProduct.AlgebraTensorModule.rid]
    have heq : Ideal.torsionOf S (S ⊗[R] M) ((1:S) ⊗ₜ[R] m)
        = LinearMap.ker (LinearMap.toSpanSingleton S (S ⊗[R] M) ((1:S) ⊗ₜ[R] m)) := rfl
    rw [heq, ← hcomp, LinearMap.ker_comp, Submodule.map_equiv_eq_comap_symm]
  -- range baseChange i = baseChange of ker f
  have hrange : (LinearMap.baseChange S i).range = Submodule.baseChange S (LinearMap.ker f) := by
    rw [hi]; rfl
  -- Step C : map rid (baseChange of ker f) = Ideal.map (algebraMap R S) (ker f)
  have hC := map_rid_baseChange_eq_map (S := S) (LinearMap.ker f)
  -- assemble
  rw [hA, hker, hrange, hC]
  rfl

/-! ### The module version

Pick a finite generating family `s₁,…,sₙ` of `M`. Then

* `Ann_R(M) = ⨅ᵢ Ann_R(sᵢ)`, the annihilator of `M` being the intersection of the element
  annihilators;
* `Ann_S(S ⊗ M) = ⨅ᵢ Ann_S(1 ⊗ sᵢ)`, the same identity on the `S`-side, since the `1 ⊗ sᵢ`
  generate `S ⊗ M` over `S`;
* `Ann_S(1 ⊗ sᵢ) = map(Ann_R(sᵢ))`, the element version applied to each generator;
* `map(⨅ᵢ Iᵢ) = ⨅ᵢ map(Iᵢ)`, flat extension commuting with finite intersections.

Assembling: `map(Ann_R M) = map(⨅ Ann_R sᵢ) = ⨅ map(Ann_R sᵢ) = ⨅ Ann_S(1 ⊗ sᵢ)
= Ann_S(S ⊗ M)`.
-/

/-- For a flat ring map `φ : R → S` and an element `x ∈ R`, the extension of the annihilator of
`x` is the annihilator of its image: `Ann_R(x) S = Ann_S(φ x)`.

This is the case `M = R` of `ann_extension_eq_ann_baseChange_elem`, transported along the
identification `S ⊗_R R ≃ S`. -/
theorem map_annihilator_span_singleton_of_flat [Module.Flat R S] (x : R) :
    Ideal.map (algebraMap R S) (Submodule.span R {x}).annihilator =
      (Submodule.span S {algebraMap R S x}).annihilator := by
  have he : TensorProduct.AlgebraTensorModule.rid R S S ((1 : S) ⊗ₜ[R] x) =
      algebraMap R S x := by
    rw [TensorProduct.AlgebraTensorModule.rid_tmul]
    simp [Algebra.smul_def]
  have ht : Ideal.torsionOf S (S ⊗[R] R) ((1 : S) ⊗ₜ[R] x) =
      Ideal.torsionOf S S (algebraMap R S x) := by
    ext s
    rw [Ideal.mem_torsionOf_iff, Ideal.mem_torsionOf_iff]
    refine ⟨fun hs => ?_, fun hs => ?_⟩
    · simpa [he, map_smul] using
        congrArg (TensorProduct.AlgebraTensorModule.rid R S S) hs
    · refine (TensorProduct.AlgebraTensorModule.rid R S S).injective ?_
      simpa [he, map_smul] using hs
  rw [Ideal.annihilator_span_singleton_eq_torsionOf, ann_extension_eq_ann_baseChange_elem, ht,
    Ideal.annihilator_span_singleton_eq_torsionOf]

/-- For a family `s : Fin n → M` generating `M` (`span R (range s) = ⊤`), the module
annihilator is the finite intersection of the element annihilators:
`Ann_R(M) = ⨅ i, Ann_R(sᵢ)`. This is the standard fact `Ann_R(M) = ⋂_{x∈M} Ann_R(x)`
specialized to a generating set, valid for any `R`-module.

Proof: `Ann_R M = Ann_R(⊤) = Ann_R(⨆ᵢ R∙sᵢ) = ⨅ᵢ Ann_R(R∙sᵢ) = ⨅ᵢ Ann_R(sᵢ)`. -/
@[ega "0 1.7.4"]
theorem annihilator_eq_iInf_torsionOf {n : ℕ} (s : Fin n → M)
    (hs : Submodule.span R (Set.range s) = ⊤) :
    Module.annihilator R M = ⨅ i, Ideal.torsionOf R M (s i) := by
  rw [← Submodule.annihilator_top, ← hs, Submodule.span_range_eq_iSup,
    Submodule.annihilator_iSup]
  simp_rw [Ideal.annihilator_span_singleton_eq_torsionOf]

/-- If `s : Fin n → M` generates `M` over `R`, then the base-changed family `1 ⊗ sᵢ`
generates `S ⊗[R] M` over `S`.

Proof: `span S {1⊗sᵢ} = span S ((mk 1) '' range s) = (span R (range s)).baseChange S
= (⊤).baseChange S = ⊤`. -/
theorem span_baseChange_gens_eq_top {n : ℕ} (s : Fin n → M)
    (hs : Submodule.span R (Set.range s) = ⊤) :
    Submodule.span S (Set.range (fun i => (1 : S) ⊗ₜ[R] s i)) = ⊤ := by
  have h1 : (Set.range (fun i => (1 : S) ⊗ₜ[R] s i))
      = (TensorProduct.mk R S M 1) '' (Set.range s) := by
    rw [← Set.range_comp]; rfl
  rw [h1, ← Submodule.baseChange_span, hs, Submodule.baseChange_top]

/-! ### Flat extension commutes with finite intersections

For `Module.Flat R S` and a finite family of ideals `I : Fin n → Ideal R`,
`map φ (⨅ i, Iᵢ) = ⨅ i, map φ Iᵢ` where `φ = algebraMap R S`.

The inclusion `≤` holds for any ring map (`Ideal.map_inf_le`, applied along the finite
intersection); the reverse inclusion is where flatness enters.

It suffices to prove the binary statement `map(I ⊓ J) = map I ⊓ map J` for flat `S`; the
`Fin n` case follows by induction on `n`, the empty intersection being `⊤` and `map ⊤ = ⊤`.

For the binary case, consider the exact sequence of `R`-modules
`0 → R/(I ⊓ J) --d--> R/I × R/J`, `d(r) = (r mod I, r mod J)`, whose kernel is
`(I ⊓ J)/(I ⊓ J) = 0`, so `d` is injective. Since `S` is flat, `- ⊗_R S` is exact, so
`d ⊗ id_S : (R/(I⊓J)) ⊗ S → (R/I × R/J) ⊗ S` is injective. Identifying
`(R/K) ⊗_R S ≅ S/(K·S) = S/map(K)` and `(A × B) ⊗ S ≅ (A⊗S) × (B⊗S)`, injectivity of
`d ⊗ id_S` says that `S/map(I⊓J) → S/map(I) × S/map(J)` is injective, i.e. its kernel
`map(I) ⊓ map(J) / map(I⊓J)` is zero, i.e. `map(I) ⊓ map(J) = map(I⊓J)`. Concretely, an
element `s ∈ map(I) ⊓ map(J)` maps to `0` in `S/map(I⊓J)`, and the injectivity above forces
`s ∈ map(I⊓J)`, the reverse of `Ideal.map_inf_le`.
-/

/-- Identification of the extension `map φ I` as the image, under the right-unitor
`S ⊗ R ≅ S`, of the range of `id_S ⊗ (I ↪ R)`. Holds for any ring map (no flatness). -/
@[ega "0 1.0.3" "special case", ega "IV 11.3.4" "(iv)"]
theorem map_rid_range_baseChange (I : Ideal R) :
    Submodule.map (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap
      (LinearMap.range (LinearMap.baseChange S (I : Submodule R R).subtype))
      = Ideal.map (algebraMap R S) I := by
  exact map_rid_baseChange_eq_map I

/-- Membership in the extension `map φ I` translated into the tensor algebra:
`s ∈ map φ I` iff `s ⊗ 1 ∈ range (id_S ⊗ (I ↪ R))`. Holds for any ring map. -/
@[ega "0 1.0.3" "special case", ega "0 4.3.5" "special case", sga "3 III 0.1.4" "special case"]
theorem mem_map_iff_tmul (I : Ideal R) (s : S) :
    s ∈ Ideal.map (algebraMap R S) I ↔
      s ⊗ₜ[R] (1 : R) ∈ LinearMap.range (LinearMap.baseChange S (I : Submodule R R).subtype) := by
  rw [← map_rid_range_baseChange I, Submodule.mem_map_equiv]
  rw [show (TensorProduct.AlgebraTensorModule.rid R S S).symm s = s ⊗ₜ[R] (1:R) from by
    simp [TensorProduct.AlgebraTensorModule.rid]]

/-- For a flat ring map `φ : R → S` and ideals `I, J`, extension commutes with binary
intersection: `map φ (I ⊓ J) = map φ I ⊓ map φ J`.

The `≤` inclusion is `Ideal.map_inf_le` (any ring map). For `≥`, take
`s ∈ map I ⊓ map J`. Via `mem_map_iff_tmul`, `s ⊗ 1` lies in the ranges of
`id_S ⊗ (I ↪ R)` and `id_S ⊗ (J ↪ R)`, hence (easy half of exactness of the
flat-tensored `I ↪ R → R/I` sequences) is killed by `id_S ⊗ R.mkQ_I` and
`id_S ⊗ R.mkQ_J`. Packaging the two quotient maps as `g = mkQ_I.prod mkQ_J`
(with `ker g = I ⊓ J`), `prodRight` shows `id_S ⊗ g` also kills `s ⊗ 1`. Flatness
makes `id_S ⊗ (ker g ↪ R) → id_S ⊗ g` exact, so `s ⊗ 1 ∈ range (id_S ⊗ (I⊓J ↪ R))`,
which by `mem_map_iff_tmul` again means `s ∈ map (I ⊓ J)`. -/
@[ega "0 6.1.3" "special case"]
theorem map_inf_of_flat [Module.Flat R S] (I J : Ideal R) :
    Ideal.map (algebraMap R S) (I ⊓ J)
      = Ideal.map (algebraMap R S) I ⊓ Ideal.map (algebraMap R S) J := by
  refine le_antisymm (Ideal.map_inf_le (algebraMap R S)) ?_
  intro s hs
  rw [Ideal.mem_inf] at hs
  obtain ⟨hI, hJ⟩ := hs
  set g : R →ₗ[R] (R ⧸ (I:Submodule R R)) × (R ⧸ (J:Submodule R R)) :=
    (I : Submodule R R).mkQ.prod (J : Submodule R R).mkQ with hg
  have hkerg : LinearMap.ker g = (I ⊓ J : Submodule R R) := by
    rw [hg, LinearMap.ker_prod, Submodule.ker_mkQ, Submodule.ker_mkQ]
  have hexg : Function.Exact (LinearMap.baseChange S (LinearMap.ker g).subtype)
      (LinearMap.baseChange S g) :=
    Module.Flat.lTensor_exact S (LinearMap.exact_subtype_ker_map g)
  have heK : ∀ K : Ideal R, s ∈ Ideal.map (algebraMap R S) K →
      s ⊗ₜ[R] ((K : Submodule R R).mkQ (1:R))
        = (0 : S ⊗[R] (R ⧸ (K:Submodule R R))) := by
    intro K hK
    obtain ⟨t, ht⟩ := (mem_map_iff_tmul K s).mp hK
    have hex : Function.Exact (LinearMap.baseChange S (K : Submodule R R).subtype)
        (LinearMap.baseChange S (K : Submodule R R).mkQ) :=
      Module.Flat.lTensor_exact S (LinearMap.exact_subtype_mkQ (K : Submodule R R))
    rw [← LinearMap.baseChange_tmul, ← ht]
    exact hex.apply_apply_eq_zero t
  have hzero : LinearMap.baseChange S g (s ⊗ₜ[R] (1:R)) = 0 := by
    apply (TensorProduct.prodRight R S S (R ⧸ (I:Submodule R R)) (R ⧸ (J:Submodule R R))).injective
    rw [LinearEquiv.map_zero]
    -- Compute prodRight ∘ baseChange S g on s ⊗ 1 as a pair of pure tensors.
    have key : (TensorProduct.prodRight R S S (R ⧸ (I:Submodule R R)) (R ⧸ (J:Submodule R R)))
          (LinearMap.baseChange S g (s ⊗ₜ[R] (1:R)))
        = (s ⊗ₜ[R] ((I : Submodule R R).mkQ (1:R)),
           s ⊗ₜ[R] ((J : Submodule R R).mkQ (1:R))) := by
      rw [hg]; rfl
    rw [key, heK I hI, heK J hJ]
    rfl
  have hmemset : s ⊗ₜ[R] (1:R) ∈ Set.range (LinearMap.baseChange S (LinearMap.ker g).subtype) :=
    (hexg _).mp hzero
  rw [mem_map_iff_tmul (I ⊓ J) s]
  rw [show (LinearMap.ker g) = ((I ⊓ J : Ideal R) : Submodule R R) from hkerg] at hmemset
  obtain ⟨t, ht⟩ := hmemset
  exact ⟨t, ht⟩

/-- Splitting off the first index of a finite infimum. -/
private theorem iInf_fin_succ_eq_inf {α : Type*} [CompleteLattice α] {n : ℕ} (f : Fin (n + 1) → α) :
    ⨅ i, f i = f 0 ⊓ ⨅ i : Fin n, f i.succ :=
  le_antisymm (le_inf (iInf_le _ 0) (le_iInf fun i => iInf_le _ i.succ))
    (le_iInf fun i => Fin.cases inf_le_left (fun j => inf_le_right.trans (iInf_le _ j)) i)

/-- For a flat ring map `φ : R → S` and a finite family of ideals `I : Fin n → Ideal R`,
extension commutes with the finite intersection: `map φ (⨅ i, Iᵢ) = ⨅ i, map φ Iᵢ`. -/
@[ega "0 6.1.3" "special case"]
theorem Ideal.map_iInf_of_flat [Module.Flat R S] {n : ℕ} (I : Fin n → Ideal R) :
    Ideal.map (algebraMap R S) (⨅ i, I i)
      = ⨅ i, Ideal.map (algebraMap R S) (I i) := by
  -- Reduce to the binary case `map_inf_of_flat` by induction on `n`.
  induction n with
  | zero =>
    -- empty intersection is `⊤` on both sides, and `map φ ⊤ = ⊤`.
    simp only [iInf_of_empty]
    rw [Ideal.map_top]
  | succ n ih =>
    -- split off the first index: `⨅ i, I i = I 0 ⊓ ⨅ i, I i.succ`.
    rw [iInf_fin_succ_eq_inf I, map_inf_of_flat,
      iInf_fin_succ_eq_inf fun i => Ideal.map (algebraMap R S) (I i), ih (fun i => I i.succ)]

/-- For a flat ring map `φ : R → S` and a finite `R`-module `M`, the extension of the
annihilator `Ann_R(M)` to `S` equals the `S`-annihilator of the base change `S ⊗_R M`:
`Ann_R(M) S = Ann_S(S ⊗_R M)`. -/
@[stacks 07T8, ega "IV 2.1.11" "affine case"]
theorem ann_extension_eq_ann_baseChange_module [Module.Flat R S] [Module.Finite R M] :
    Ideal.map (algebraMap R S) (Module.annihilator R M)
      = Module.annihilator S (S ⊗[R] M) := by
  -- Get a finite generating family `s₁,…,sₙ` of `M`.
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := M)
  -- rewrite the R-side annihilator as a finite intersection of element annihilators
  rw [annihilator_eq_iInf_torsionOf s hs]
  -- flat extension commutes with finite intersection
  rw [Ideal.map_iInf_of_flat]
  -- the element version applied per generator: map(Ann_R sᵢ) = Ann_S(1⊗sᵢ)
  simp_rw [ann_extension_eq_ann_baseChange_elem]
  -- the S-side annihilator is the matching finite intersection
  rw [annihilator_eq_iInf_torsionOf (R := S) (M := S ⊗[R] M)
      (fun i => (1 : S) ⊗ₜ[R] s i) (span_baseChange_gens_eq_top s hs)]
