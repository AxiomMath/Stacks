module

public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.FieldTheory.Finiteness
public import Mathlib.Data.Fintype.Card

/-!
# Finitely many ideals of bounded finite colength over a finite field

Let `A` be a finitely generated algebra over a finite field `E`. For every `M` there are only
finitely many ideals `I` of `A` with `A ⧸ I` finite of cardinality at most `M`.

In a finite ring `R` with at most `M` elements every element satisfies `r ^ (M + M!) = r ^ M`:
two of `r ^ 0, …, r ^ M` coincide, so the powers of `r` are periodic from an exponent `≤ M` on,
with a period `≤ M` that divides `M!`. Hence every such `I` contains the ideal `J` generated by
the `g ^ (M + M!) - g ^ M` for `g` in a finite generating set of `A`. The quotient `A ⧸ J` is
generated by integral elements, so it is a finite `E`-module and a finite set, and the ideals
containing `J` are the ideals of `A ⧸ J`.

## Main results

* `Stacks.RingTheory.pow_add_factorial_eq_pow`: `r ^ (M + M!) = r ^ M` in a monoid with at most
  `M` elements.
* `Stacks.RingTheory.finite_setOf_ideal_natCard_quotient_le`: the finiteness statement.
-/

@[expose] public noncomputable section

namespace Stacks.RingTheory

/-- **Powers in a small finite monoid.** In a monoid with at most `M` elements,
`r ^ (M + M!) = r ^ M` for every `r`. -/
theorem pow_add_factorial_eq_pow {R : Type*} [Monoid R] [Finite R] {M : ℕ}
    (hM : Nat.card R ≤ M) (r : R) : r ^ (M + M.factorial) = r ^ M := by
  classical
  have : Fintype R := Fintype.ofFinite R
  have hlt : Fintype.card R < Fintype.card (Fin (M + 1)) := by
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card]
    omega
  obtain ⟨i, j, hij, heq⟩ :=
    Fintype.exists_ne_map_eq_of_card_lt (fun i : Fin (M + 1) => r ^ (i : ℕ)) hlt
  -- order the two exponents
  obtain ⟨a, b, hab, hbM, hpow⟩ : ∃ a b : ℕ, a < b ∧ b ≤ M ∧ r ^ a = r ^ b := by
    rcases lt_or_gt_of_ne (fun h => hij (Fin.ext h)) with h | h
    · exact ⟨i, j, h, Nat.lt_succ_iff.1 j.2, heq⟩
    · exact ⟨j, i, h, Nat.lt_succ_iff.1 i.2, heq.symm⟩
  set d := b - a with hd
  have hd0 : 0 < d := by omega
  -- periodicity from the exponent `a` on
  have hper : ∀ t n : ℕ, r ^ (a + n + t * d) = r ^ (a + n) := by
    intro t n
    induction t with
    | zero => simp
    | succ t ih =>
      have : a + n + (t + 1) * d = (a + d) + (n + t * d) := by ring
      rw [this, show a + d = b by omega, pow_add, ← hpow, ← pow_add,
        show a + (n + t * d) = a + n + t * d by ring, ih]
  obtain ⟨c, hc⟩ : d ∣ M.factorial := Nat.dvd_factorial hd0 (by omega)
  have h := hper c (M - a)
  rw [show a + (M - a) = M by omega] at h
  rw [hc, mul_comm d c]
  exact h

variable (E A : Type*) [Field E] [Finite E] [CommRing A] [Algebra E A] [Algebra.FiniteType E A]

include E in
/-- **Finitely many ideals of bounded finite colength.** In a finitely generated algebra `A` over
a finite field there are only finitely many ideals `I` with `A ⧸ I` finite of cardinality at most
`M`. -/
theorem finite_setOf_ideal_natCard_quotient_le (M : ℕ) :
    {I : Ideal A | Finite (A ⧸ I) ∧ Nat.card (A ⧸ I) ≤ M}.Finite := by
  classical
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out (R := E) (A := A))
  set e := M + M.factorial with he
  set J : Ideal A := Ideal.span ((fun g : A => g ^ e - g ^ M) '' (s : Set A)) with hJ
  -- every ideal of the set contains `J`
  have hJle : ∀ I ∈ {I : Ideal A | Finite (A ⧸ I) ∧ Nat.card (A ⧸ I) ≤ M}, J ≤ I := by
    rintro I ⟨hfin, hcard⟩
    rw [hJ, Ideal.span_le]
    rintro _ ⟨g, -, rfl⟩
    rw [SetLike.mem_coe, ← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow, map_pow,
      sub_eq_zero]
    exact pow_add_factorial_eq_pow hcard _
  -- `A ⧸ J` is finite
  have hint : Algebra.IsIntegral E (A ⧸ J) := by
    have hgen : Algebra.adjoin E ((Ideal.Quotient.mkₐ E J) '' (s : Set A)) = ⊤ := by
      rw [Algebra.adjoin_image, hs, Algebra.map_top]
      exact (AlgHom.range_eq_top _).2 (Ideal.Quotient.mkₐ_surjective E J)
    refine ⟨fun x => ?_⟩
    have hle : Algebra.adjoin E ((Ideal.Quotient.mkₐ E J) '' (s : Set A)) ≤
        integralClosure E (A ⧸ J) := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨g, hg, rfl⟩
      refine ⟨Polynomial.X ^ e - Polynomial.X ^ M, ?_, ?_⟩
      · have hlt : M < e := by
          have := Nat.factorial_pos M
          omega
        exact Polynomial.monic_X_pow_sub (by simpa using hlt)
      · have hmem : g ^ e - g ^ M ∈ J := Ideal.subset_span ⟨g, hg, rfl⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X_pow, ← map_pow,
          ← map_pow, ← map_sub]
        exact (Ideal.Quotient.eq_zero_iff_mem).2 hmem
    exact hle (hgen ▸ Algebra.mem_top)
  have : Algebra.FiniteType E (A ⧸ J) := Algebra.FiniteType.trans (S := A) inferInstance
    inferInstance
  have : Module.Finite E (A ⧸ J) := Algebra.IsIntegral.finite
  have : Finite (A ⧸ J) := Module.finite_of_finite E
  have : Finite (Ideal (A ⧸ J)) :=
    Finite.of_injective (fun I : Ideal (A ⧸ J) => (I : Set (A ⧸ J))) SetLike.coe_injective
  -- the ideals containing `J` are the ideals of `A ⧸ J`
  refine Set.Finite.of_finite_image (f := Ideal.map (Ideal.Quotient.mk J)) (Set.toFinite _) ?_
  intro I hI I' hI' h
  have h' := congrArg (Ideal.comap (Ideal.Quotient.mk J)) h
  simp only [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective] at h'
  rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.2 (hJle I hI),
    sup_eq_left.2 (hJle I' hI')] at h'
  exact h'

end Stacks.RingTheory

end
