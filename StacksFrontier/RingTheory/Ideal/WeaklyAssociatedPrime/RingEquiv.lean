module

public import StacksFrontier.RingTheory.Ideal.WeaklyAssociatedPrime.Defs

/-!
# Weakly associated primes across a ring isomorphism

Let `e : R ≃+* R'` be an isomorphism of commutative rings and let `φ : M ≃+ M'` be an additive
isomorphism of an `R`-module with an `R'`-module which is semilinear along `e`, that is
`φ (r • x) = e r • φ x`. The two modules then have the same weakly associated primes, read
through the order isomorphism `Ideal R ≃ Ideal R'` that `e` induces.

In particular every weakly associated prime of `M'` is the inverse image of one of `M`, so
*finiteness* of the set of weakly associated primes transports along `e`; this is the hypothesis
on the base ring in Stacks 05IL, Stacks 05IR and Stacks 053G, and it applies for instance to
`ULift.ringEquiv`.

## Main results

* `Submodule.annihilator_span_singleton_comap_of_semilinearEquiv`: the annihilator of a cyclic
  submodule is carried to the annihilator of the corresponding cyclic submodule by `Ideal.comap`.
* `isWeaklyAssociatedPrime_map_of_semilinearEquiv`: a weakly associated prime of `M` has image
  a weakly associated prime of `M'`.
* `isWeaklyAssociatedPrime_iff_of_semilinearEquiv`: the biconditional form, a prime of `R` is
  weakly associated to `M` exactly when its image is weakly associated to `M'`.
* `weaklyAssociatedPrimes_subset_comap_image_of_semilinearEquiv`: every weakly associated prime
  of `M'` is the inverse image of a weakly associated prime of `M`.
* `weaklyAssociatedPrimes_finite_of_semilinearEquiv`: finiteness of the set of weakly associated
  primes transports.

## Implementation notes

The semilinearity hypothesis is spelled `∀ r x, φ (r • x) = e r • φ x` rather than by bundling
`φ` as a semilinear equivalence, matching `Module.Flat.of_semilinearEquiv` and
`Module.Finite.of_semilinearEquiv`; at the call sites it is usually `rfl`.

Minimality of a prime over an ideal is transported by
`Ideal.minimalPrimes_comap_of_surjective`, which needs only surjectivity of the ring map.

## References

* [Stacks Project, Tag 0547](https://stacks.math.columbia.edu/tag/0547)
-/

@[expose] public section

variable {R : Type*} [CommRing R] {R' : Type*} [CommRing R']
  {M : Type*} [AddCommGroup M] [Module R M] {M' : Type*} [AddCommGroup M'] [Module R' M']

/-- The annihilator of the cyclic submodule generated by `y : M'` pulls back along a ring
isomorphism `e : R ≃+* R'` to the annihilator of the cyclic submodule generated by the
corresponding element of `M`, for any additive isomorphism `φ : M ≃+ M'` semilinear along `e`. -/
public theorem Submodule.annihilator_span_singleton_comap_of_semilinearEquiv (e : R ≃+* R')
    (φ : M ≃+ M') (hφ : ∀ (r : R) (x : M), φ (r • x) = e r • φ x) (y : M') :
    Ideal.comap (e : R →+* R') (Submodule.span R' {y}).annihilator
      = (Submodule.span R {φ.symm y}).annihilator := by
  ext r
  simp only [Ideal.mem_comap, Submodule.mem_annihilator_span_singleton]
  rw [← φ.map_eq_zero_iff (x := r • φ.symm y), hφ, φ.apply_symm_apply]
  exact Iff.rfl

/-- A semilinear bijection between modules over isomorphic rings carries a weakly associated
prime to its image: for a ring isomorphism `e : R ≃+* R'` and an additive isomorphism
`φ : M ≃+ M'` semilinear along `e`, a prime weakly associated to `M` has image weakly
associated to `M'`. -/
public theorem isWeaklyAssociatedPrime_map_of_semilinearEquiv (e : R ≃+* R') (φ : M ≃+ M')
    (hφ : ∀ (r : R) (x : M), φ (r • x) = e r • φ x) {p : Ideal R}
    (hp : IsWeaklyAssociatedPrime R M p) :
    IsWeaklyAssociatedPrime R' M' (p.map e.toRingHom) := by
  obtain ⟨m, hm⟩ := hp
  have hann : (Submodule.span R' {φ m}).annihilator.comap e.toRingHom
      = (Submodule.span R {m}).annihilator := by
    ext r
    simp only [Ideal.mem_comap, Submodule.mem_annihilator_span_singleton]
    change e r • φ m = 0 ↔ r • m = 0
    rw [← hφ]
    simpa only [map_zero] using (φ.injective.eq_iff (a := r • m) (b := 0))
  rw [← hann] at hm
  obtain ⟨q, hq, hqp⟩ := Ideal.exists_minimalPrimes_comap_eq e.toRingHom p hm
  have hqeq : q = p.map e.toRingHom :=
    (Ideal.map_comap_of_surjective e.toRingHom e.surjective q).symm.trans (congrArg _ hqp)
  exact ⟨φ m, hqeq ▸ hq⟩

/-- **Weak association transports along a semilinear bijection between modules over isomorphic
rings.** For a ring isomorphism `e : R ≃+* R'` and an additive isomorphism `φ : M ≃+ M'`
semilinear along `e`, a prime `p` of `R` is weakly associated to `M` exactly when its image
`p.map e` is weakly associated to `M'`. -/
public theorem isWeaklyAssociatedPrime_iff_of_semilinearEquiv (e : R ≃+* R') (φ : M ≃+ M')
    (hφ : ∀ (r : R) (x : M), φ (r • x) = e r • φ x) (p : Ideal R) :
    IsWeaklyAssociatedPrime R M p ↔ IsWeaklyAssociatedPrime R' M' (p.map e.toRingHom) := by
  refine ⟨isWeaklyAssociatedPrime_map_of_semilinearEquiv e φ hφ, fun hp ↦ ?_⟩
  have hφ' : ∀ (s : R') (y : M'), φ.symm (s • y) = e.symm s • φ.symm y := by
    intro s y
    apply φ.injective
    simp only [φ.apply_symm_apply, hφ, e.apply_symm_apply]
  convert isWeaklyAssociatedPrime_map_of_semilinearEquiv e.symm φ.symm hφ' hp using 1
  simp [Ideal.map_map]

/-- Every prime weakly associated to `M'` is the inverse image along `e` of a prime weakly
associated to `M`, for a ring isomorphism `e : R ≃+* R'` and an additive isomorphism
`φ : M ≃+ M'` semilinear along `e`. -/
public theorem weaklyAssociatedPrimes_subset_comap_image_of_semilinearEquiv (e : R ≃+* R')
    (φ : M ≃+ M') (hφ : ∀ (r : R) (x : M), φ (r • x) = e r • φ x) :
    weaklyAssociatedPrimes R' M'
      ⊆ Ideal.comap (e.symm : R' →+* R) '' weaklyAssociatedPrimes R M := by
  rintro I' ⟨y, hy⟩
  refine ⟨Ideal.comap (e : R →+* R') I', ⟨φ.symm y, ?_⟩, ?_⟩
  · rw [← Submodule.annihilator_span_singleton_comap_of_semilinearEquiv e φ hφ y]
    exact Ideal.minimalPrimes_comap_of_surjective (f := (e : R →+* R')) e.surjective hy
  · simp [Ideal.comap_comap]

/-- **Finiteness of the set of weakly associated primes transports along a ring isomorphism.**
If `e : R ≃+* R'` is an isomorphism of rings and `φ : M ≃+ M'` is an additive isomorphism
semilinear along `e`, then `M'` has finitely many weakly associated primes as soon as `M` does. -/
public theorem weaklyAssociatedPrimes_finite_of_semilinearEquiv (e : R ≃+* R') (φ : M ≃+ M')
    (hφ : ∀ (r : R) (x : M), φ (r • x) = e r • φ x)
    (h : (weaklyAssociatedPrimes R M).Finite) : (weaklyAssociatedPrimes R' M').Finite :=
  (h.image _).subset (weaklyAssociatedPrimes_subset_comap_image_of_semilinearEquiv e φ hφ)
