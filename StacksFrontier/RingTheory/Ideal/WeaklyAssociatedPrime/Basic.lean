module

public import StacksFrontier.RingTheory.Ideal.WeaklyAssociatedPrime.Defs
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Modules with no weakly associated primes

Let `R` be a commutative ring and `M` an `R`-module. For `m ∈ M` the annihilator of `m` is
the ideal `Ann(m) = {f ∈ R | f • m = 0}`, equivalently the annihilator of the cyclic
submodule `R ∙ m ⊆ M`, and a prime ideal `p` of `R` is *weakly associated* to `M` if there
is an `m ∈ M` such that `p` is a minimal prime over `Ann(m)` (Stacks tag 0547). These
notions are `IsWeaklyAssociatedPrime R M` and `weaklyAssociatedPrimes R M`.

Stacks tag 0588 (Lemma 10.66.5): `M` is the zero module if and only if it has no weakly
associated primes. Since `M` is an arbitrary type carrying an `R`-module structure, the
condition `M = (0)` is rendered as `∀ m : M, m = 0` (equivalently `Subsingleton M`).

If `M = (0)` then its only element is `0`, and `Ann(0) = R` has no prime minimal over it,
so no prime is weakly associated. Conversely, if some `m ∈ M` is nonzero then `Ann(m)` is a
proper ideal, hence admits a minimal prime over it, and any such prime is weakly associated
to `M`.
-/

@[expose] public section

/-- Stacks Tag 0588 (Lemma 10.66.5): an `R`-module `M` is the zero module if and
only if it has no weakly associated primes. -/
@[stacks 0588]
theorem weakAss_empty_iff_zero {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M]
    [Module R M] :
    (∀ m : M, m = 0) ↔ weaklyAssociatedPrimes R M = ∅ := by
  refine ⟨fun hM ↦ Set.eq_empty_of_forall_notMem fun I ⟨m, hm⟩ ↦ ?_, fun hW m ↦ ?_⟩
  · exact hm.1.1.ne_top <| top_le_iff.mp <| by
      simpa [hM m, Submodule.annihilator_bot] using hm.1.2
  · by_contra hm0
    obtain ⟨p, hp⟩ := Ideal.nonempty_minimalPrimes (I := (R ∙ m).annihilator)
      (by simpa [Submodule.annihilator_eq_top_iff])
    exact Set.eq_empty_iff_forall_notMem.mp hW p ⟨m, hp⟩

