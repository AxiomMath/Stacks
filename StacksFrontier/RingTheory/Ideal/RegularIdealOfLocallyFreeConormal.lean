/-!
# Regular ideals from finite projective dimension

Let `I` be an ideal of a Noetherian ring `R` which has finite projective dimension as an
`R`-module and whose conormal module `I/I²` is finite locally free over `R/I`. Then `I` is a
regular ideal: locally on its zero locus it is generated by a regular sequence.

## Main results

* `Ideal.isRegular_of_projectiveDimension_ne_top_of_isFiniteLocallyFree_cotangent`: the
  regular-ideal criterion.

## Implementation notes

The predicate `Ideal.IsRegular` expresses Stacks Definition 07CV(1): the extension of the ideal
to a suitable principal localization is generated by a regular sequence. Finiteness of the
projective dimension is expressed by its value being different from `⊤`, and `Ideal.Cotangent I`
is the conormal module `I/I²` over `R/I`.

Two steps of the argument are carried out in a shape slightly different from the source. First,
the free summand of the conormal module is produced over the localization at a prime, where
projectivity of `I/I²` together with the Noetherian hypothesis gives freeness; the rank is then
the rank of a basis rather than a globally defined invariant. Second, the generators and their
regularity, obtained over the localization at a prime, are spread out to a localization away
from a single element, which is what `Ideal.IsRegular` asks for: the denominators of the
generators and the element supplied by Tag 061L are multiplied together into one element.

## References

* [Stacks Project, Tag 0FJS](https://stacks.math.columbia.edu/tag/0FJS)
* [Vasconcelos, Corollary 1][Vasconcelos]
* [Iyengar][Iyengar]
* [Ferrand][Ferrand-lci]
-/

@[expose] public section

namespace Ideal

open scoped TensorProduct

universe u

variable {R : Type*} [CommRing R] [IsNoetherianRing R]

omit [IsNoetherianRing R] in
private lemma projectiveDimension_map_localization_ne_top (I : Ideal R) (S : Submonoid R)
    (hpd : Module.projectiveDimension R I ≠ ⊤) :
    Module.projectiveDimension (Localization S) (I.map (algebraMap R (Localization S))) ≠ ⊤ := by
  let e : LocalizedModule S I ≃ₗ[Localization S]
      I.map (algebraMap R (Localization S)) :=
    LinearEquiv.extendScalarsOfIsLocalization S (Localization S)
      (IsLocalizedModule.linearEquiv S
        (LocalizedModule.mkLinearMap S I) (Algebra.idealMap I (S := Localization S)))
  obtain ⟨n, hn⟩ := (CategoryTheory.projectiveDimension_ne_top_iff (ModuleCat.of R I)).mp hpd
  have heq : Module.projectiveDimension (Localization S) (LocalizedModule S I) =
      Module.projectiveDimension (Localization S) (I.map (algebraMap R (Localization S))) :=
    ModuleCat.projectiveDimension_eq_of_linearEquiv e
  rw [← heq]
  exact (CategoryTheory.projectiveDimension_ne_top_iff
    (ModuleCat.of (Localization S) (LocalizedModule S I))).mpr
      ⟨n, projectiveDimension_localization_le R S I n hn⟩

private lemma projective_of_isFiniteLocallyFree {A M : Type u} [CommRing A]
    [AddCommGroup M] [Module A M] (h : Module.IsFiniteLocallyFree A M) :
    Module.Projective A M := by
  obtain ⟨ι, f, hcover, hfree⟩ := h
  have hp : Module.Finite A M ∧ Module.Projective A M := by
    apply ((Module.finite_projective_tfae A M).out 7 2).mp
    refine ⟨Set.range f, ?_, ?_⟩
    · simpa using hcover
    · rintro _ ⟨i, rfl⟩
      exact hfree i
  exact hp.2

omit [IsNoetherianRing R] in
private lemma le_span_sup_sq_of_span_toCotangent_eq_top
    (I : Ideal R) {ι : Type*} (v : ι → I)
    (hv : Submodule.span (R ⧸ I) (Set.range fun i => I.toCotangent (v i)) = ⊤) :
    I ≤ Ideal.span (Set.range fun i => (v i : R)) ⊔ I ^ 2 := by
  let K := Submodule.span R (Set.range v)
  have hmap : K.map I.toCotangent = ⊤ := by
    apply top_unique
    intro z hz0
    have hz : z ∈ Submodule.span (R ⧸ I) (Set.range fun i => I.toCotangent (v i)) := by
      simp [hv]
    clear hz0
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact ⟨v i, Submodule.subset_span ⟨i, rfl⟩, rfl⟩
    | zero => exact Submodule.zero_mem _
    | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
    | smul a x _ hx =>
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
      exact (K.map I.toCotangent).smul_mem a hx
  intro x hx
  have hm : I.toCotangent ⟨x, hx⟩ ∈ K.map I.toCotangent := by simp [hmap]
  obtain ⟨y, hy, hxy⟩ := hm
  apply Submodule.mem_sup.mpr
  refine ⟨y, ?_, x - y, ?_, by simp⟩
  · have : (y : R) ∈ K.map I.subtype := ⟨y, hy, rfl⟩
    change (y : R) ∈ Submodule.span R (Set.range fun i => (v i : R))
    convert this using 1
    simp only [K, Submodule.map_span, ← Set.range_comp, Function.comp_def,
      Submodule.subtype_apply]
  · rw [← Ideal.toCotangent_eq_zero I ⟨x - y, I.sub_mem hx y.2⟩]
    change I.toCotangent (⟨x, hx⟩ - y) = 0
    rw [map_sub, hxy, sub_self]

private lemma eq_span_of_span_toCotangent_eq_top
    {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (J : Ideal A) (hJ : J ≠ ⊤) {ι : Type*} (v : ι → J)
    (hv : Submodule.span (A ⧸ J) (Set.range fun i => J.toCotangent (v i)) = ⊤) :
    J = Ideal.span (Set.range fun i => (v i : A)) := by
  have hle := le_span_sup_sq_of_span_toCotangent_eq_top J v hv
  have hjac : J ≤ Ideal.jacobson (⊥ : Ideal A) := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal _ bot_ne_top]
    exact IsLocalRing.le_maximalIdeal hJ
  have hgen : J ≤ Ideal.span (Set.range fun i => (v i : A)) := by
    apply Submodule.le_of_le_smul_of_le_jacobson_bot
      (IsNoetherian.noetherian J) hjac
    simpa only [Ideal.smul_eq_mul, pow_two] using hle
  exact le_antisymm hgen (Ideal.span_le.mpr (Set.range_subset_iff.mpr fun i => (v i).2))

private lemma projective_cotangent_map {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B] (I : Ideal A)
    (hproj : Module.Projective (A ⧸ I) I.Cotangent) :
    Module.Projective (B ⧸ I.map (algebraMap A B)) (I.map (algebraMap A B)).Cotangent := by
  let _ := hproj
  exact Module.Projective.of_equiv (quotientTensorCotangentEquivMap I)

/-- The extension of an ideal contained in a prime `p` to the localization at `p` is proper. -/
private lemma map_atPrime_ne_top {A : Type*} [CommRing A] (I : Ideal A) (p : Ideal A) [p.IsPrime]
    (hp : I ≤ p) : I.map (algebraMap A (Localization.AtPrime p)) ≠ ⊤ := by
  rw [IsLocalization.map_algebraMap_ne_top_iff_disjoint (M := p.primeCompl)
    (S := Localization.AtPrime p)]
  exact Set.disjoint_left.mpr (fun s hs hI => hs (hp hI))

private lemma exists_basis_cotangent_atPrime (I : Ideal R) (p : Ideal R) [p.IsPrime]
    (hp : I ≤ p) (hproj : Module.Projective (R ⧸ I) I.Cotangent) :
    ∃ r : ℕ, Nonempty (Module.Basis (Fin r)
      ((Localization.AtPrime p) ⧸ I.map (algebraMap R (Localization.AtPrime p)))
      (I.map (algebraMap R (Localization.AtPrime p))).Cotangent) := by
  let T := Localization.AtPrime p
  let J := I.map (algebraMap R T)
  have hJ : J ≠ ⊤ := map_atPrime_ne_top I p hp
  have : Nontrivial (T ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  have : IsLocalRing (T ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  have : Module.Flat R T := IsLocalization.flat T p.primeCompl
  have : Module.Projective (T ⧸ J) J.Cotangent :=
    projective_cotangent_map I hproj
  have : Module.Finite T J := Module.Finite.of_fg (IsNoetherian.noetherian J)
  have : Module.Finite T J.Cotangent :=
    Module.Finite.of_surjective J.toCotangent J.toCotangent_surjective
  have : Module.Finite (T ⧸ J) J.Cotangent :=
    Module.Finite.of_restrictScalars_finite T (T ⧸ J) J.Cotangent
  have : Module.Free (T ⧸ J) J.Cotangent := Module.free_of_flat_of_isLocalRing
  exact ⟨_, ⟨Module.finBasis (T ⧸ J) J.Cotangent⟩⟩

private lemma exists_regular_generators_atPrime (I : Ideal R) (p : Ideal R) [p.IsPrime]
    (hp : I ≤ p) (hpd : Module.projectiveDimension R I ≠ ⊤)
    (hproj : Module.Projective (R ⧸ I) I.Cotangent) :
    ∃ (r : ℕ) (v : Fin r → I.map (algebraMap R (Localization.AtPrime p))),
      RingTheory.Sequence.IsRegular (Localization.AtPrime p)
        (List.ofFn fun i => (v i : Localization.AtPrime p)) ∧
      I.map (algebraMap R (Localization.AtPrime p)) =
        Ideal.ofList (List.ofFn fun i => (v i : Localization.AtPrime p)) := by
  let T := Localization.AtPrime p
  let J := I.map (algebraMap R T)
  have hJ : J ≠ ⊤ := map_atPrime_ne_top I p hp
  obtain ⟨r, ⟨b⟩⟩ := exists_basis_cotangent_atPrime I p hp hproj
  have hb : Nonempty (Module.Basis (Fin r) (T ⧸ J) (⊤ : Submodule (T ⧸ J) J.Cotangent)) :=
    ⟨b.map Submodule.topEquiv.symm⟩
  obtain ⟨v, hreg, hspan⟩ :=
    Ideal.exists_isRegular_of_isCompl_cotangent J r ⊤
      (Or.inr hJ)
      (projectiveDimension_map_localization_ne_top I p.primeCompl hpd)
      ⟨⊥, isCompl_top_bot⟩ hb
  refine ⟨r, v, hreg, ?_⟩
  rw [Ideal.ofList_ofFn]
  exact eq_span_of_span_toCotangent_eq_top J hJ v hspan

/-- The product of a finite family in a submonoid is a multiple of each member. -/
private lemma exists_prod_eq_mul {A : Type*} [CommRing A] {S : Submonoid A} {n : ℕ}
    (t : Fin n → S) (i : Fin n) : ∃ u : S, ((∏ j, t j : S) : A) = (t i : A) * (u : A) :=
  ⟨∏ j ∈ Finset.univ.erase i, t j,
    congrArg Subtype.val (Finset.mul_prod_erase Finset.univ t (Finset.mem_univ i)).symm⟩

omit [IsNoetherianRing R] in
private lemma common_numerators (I : Ideal R) (S : Submonoid R) {n : ℕ}
    (v : Fin n → I.map (algebraMap R (Localization S))) :
    ∃ s : S, ∃ f : Fin n → I,
      ∀ i, algebraMap R (Localization S) (f i : R) =
        algebraMap R (Localization S) (s : R) * (v i : Localization S) := by
  classical
  have hrep (i : Fin n) : ∃ a : I, ∃ t : S,
      algebraMap R (Localization S) (a : R) =
        (v i : Localization S) * algebraMap R (Localization S) (t : R) := by
    obtain ⟨⟨a, t⟩, heq⟩ := (IsLocalization.mem_map_algebraMap_iff S (Localization S)).mp (v i).2
    exact ⟨a, t, heq.symm⟩
  choose a t ht using hrep
  choose u hu using exists_prod_eq_mul t
  let f (i : Fin n) : I := ⟨(u i : R) * (a i : R), I.mul_mem_left _ (a i).2⟩
  refine ⟨∏ i, t i, f, fun i => ?_⟩
  dsimp [f]
  rw [map_mul, ht i, hu i, map_mul]
  ring

private lemma exists_regular_generators_from_base_atPrime (I : Ideal R) (p : Ideal R) [p.IsPrime]
    (hp : I ≤ p) (hpd : Module.projectiveDimension R I ≠ ⊤)
    (hproj : Module.Projective (R ⧸ I) I.Cotangent) :
    ∃ (r : ℕ) (f : Fin r → I),
      RingTheory.Sequence.IsRegular (Localization.AtPrime p)
        (List.ofFn fun i => algebraMap R (Localization.AtPrime p) (f i : R)) ∧
      I.map (algebraMap R (Localization.AtPrime p)) =
        Ideal.ofList (List.ofFn fun i => algebraMap R (Localization.AtPrime p) (f i : R)) := by
  obtain ⟨r, v, hreg, hgen⟩ := exists_regular_generators_atPrime I p hp hpd hproj
  obtain ⟨s, f, hf⟩ := common_numerators I p.primeCompl v
  have hu : IsUnit (algebraMap R (Localization.AtPrime p) (s : R)) :=
    IsLocalization.map_units _ s
  have hl : (List.ofFn fun i => algebraMap R (Localization.AtPrime p) (f i : R)) =
      (List.ofFn fun i => (v i : Localization.AtPrime p)).map
        (algebraMap R (Localization.AtPrime p) (s : R) * ·) := by
    rw [← List.ofFn_comp']
    exact congrArg List.ofFn (funext hf)
  refine ⟨r, f, ?_, ?_⟩
  · rw [hl]
    exact hreg.map_mul_unit hu
  · rwa [hl, Ideal.ofList_map_mul_unit hu]

private lemma exists_away_eq_of_atPrime_eq (I K : Ideal R)
    (p : Ideal R) [p.IsPrime]
    (heq : I.map (algebraMap R (Localization.AtPrime p)) =
      K.map (algebraMap R (Localization.AtPrime p))) :
    ∃ g : R, g ∉ p ∧ ∀ x ∈ I, g * x ∈ K := by
  classical
  obtain ⟨n, a, ha⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian I)
  have hrep (i : Fin n) : ∃ s : R, s ∈ p.primeCompl ∧ s * a i ∈ K := by
    have hai : a i ∈ I := ha ▸ Submodule.subset_span ⟨i, rfl⟩
    have hloc : algebraMap R (Localization.AtPrime p) (a i) ∈
        K.map (algebraMap R (Localization.AtPrime p)) := by
      rw [← heq]
      exact Ideal.mem_map_of_mem _ hai
    exact (IsLocalization.algebraMap_mem_map_algebraMap_iff p.primeCompl
      (Localization.AtPrime p) K (a i)).mp hloc
  choose s hs hsa using hrep
  choose u hu using exists_prod_eq_mul fun i => (⟨s i, hs i⟩ : p.primeCompl)
  let gs : p.primeCompl := ∏ i : Fin n, (⟨s i, hs i⟩ : p.primeCompl)
  let g : R := gs
  have hga (i : Fin n) : g * a i ∈ K := by
    rw [show g = s i * (u i : R) from hu i]
    convert K.mul_mem_left (u i : R) (hsa i) using 1
    ring
  refine ⟨g, gs.property, fun x hx => ?_⟩
  rw [← ha] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact hga i
  | zero => simp
  | add x y _ _ hx hy => simpa [mul_add] using K.add_mem hx hy
  | smul r x _ hx =>
    simpa [smul_eq_mul, mul_comm, mul_left_comm, mul_assoc] using K.mul_mem_left r hx

private lemma regular_sequence_localize_away_of_atPrime_mul
    (p : Ideal R) [p.IsPrime] (xs : List R)
    (hp : RingTheory.Sequence.IsRegular (LocalizedModule p.primeCompl R)
      (xs.map (algebraMap R (Localization.AtPrime p))))
    (a : R) (ha : a ∉ p) :
    ∃ g : R, g ∉ p ∧ a ∣ g ∧
      RingTheory.Sequence.IsRegular (LocalizedModule (Submonoid.powers g) R)
        (xs.map (algebraMap R (Localization.Away g))) := by
  obtain ⟨g₀, hg₀, hker₀, _⟩ := L_choose_g p xs hp
  let g := a * g₀
  have hg : g ∈ p.primeCompl := mul_mem ha hg₀
  have hker : ∀ i (hi : i < xs.length),
      Subsingleton (LocalizedModule (Submonoid.powers g)
        (LinearMap.ker (LinearMap.lsmul R
          (R ⧸ (Ideal.ofList (xs.take i) • ⊤ : Submodule R R)) xs[i]))) := by
    intro i hi
    have hsub := hker₀ i hi
    rw [LocalizedModule.subsingleton_iff] at hsub ⊢
    intro m
    obtain ⟨r, ⟨k, rfl⟩, hr⟩ := hsub m
    refine ⟨g ^ k, ⟨k, rfl⟩, ?_⟩
    change g ^ k • m = 0
    rw [show g = g₀ * a by simp [g, mul_comm], mul_pow, mul_smul,
      smul_comm (g₀ ^ k) (a ^ k) m, hr, smul_zero]
  have htop :
      (⊤ : Submodule (Localization.Away g) (LocalizedModule (Submonoid.powers g) R)) ≠
        Ideal.ofList (xs.map (algebraMap R (Localization.Away g))) • ⊤ := by
    rw [ne_comm, ne_eq, ← Submodule.Quotient.subsingleton_iff]
    intro hsubg
    have hQg : Subsingleton
        (LocalizedModule (Submonoid.powers g)
          (R ⧸ (Ideal.ofList xs • ⊤ : Submodule R R))) := by
      obtain ⟨e⟩ := nonempty_localizedModule_quotient_ofList_equiv
        (M := R) xs (Submonoid.powers g)
      exact (Equiv.subsingleton_congr e.toEquiv).mpr hsubg
    have hQp : Subsingleton
        (LocalizedModule p.primeCompl
          (R ⧸ (Ideal.ofList xs • ⊤ : Submodule R R))) := by
      rw [LocalizedModule.subsingleton_iff] at hQg ⊢
      intro m
      obtain ⟨r, hrmem, hr⟩ := hQg m
      exact ⟨r, (Submonoid.powers_le.mpr hg) hrmem, hr⟩
    obtain ⟨e⟩ := nonempty_localizedModule_quotient_ofList_equiv
      (M := R) xs p.primeCompl
    have hsubp := (Equiv.subsingleton_congr e.toEquiv).mp hQp
    have hp' := hp.top_ne_smul
    rw [ne_comm, ne_eq, ← Submodule.Quotient.subsingleton_iff] at hp'
    exact hp' hsubp
  refine ⟨g, hg, ⟨g₀, rfl⟩, ?_, htop⟩
  rw [RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff (Localization.Away g)]
  exact L_weaklyRegular_of_kernels_away g xs hker

/-- A list is regular on the localized module `S⁻¹R` iff it is regular on the ring `S⁻¹R`. -/
private lemma isRegular_localizedModule_iff {A : Type*} [CommRing A] (S : Submonoid A)
    (xs : List A) :
    RingTheory.Sequence.IsRegular (LocalizedModule S A) (xs.map (algebraMap A (Localization S))) ↔
      RingTheory.Sequence.IsRegular (Localization S) (xs.map (algebraMap A (Localization S))) :=
  let e : LocalizedModule S A ≃ₗ[Localization S] Localization S :=
    LinearEquiv.extendScalarsOfIsLocalization S (Localization S)
      (IsLocalizedModule.linearEquiv S (LocalizedModule.mkLinearMap S A)
        (Algebra.linearMap A (Localization S)))
  e.isRegular_congr _

private lemma exists_away_regular_of_atPrime_regular (p : Ideal R) [p.IsPrime]
    {n : ℕ} (f : Fin n → R) (a : R) (ha : a ∉ p)
    (hreg : RingTheory.Sequence.IsRegular (Localization.AtPrime p)
      (List.ofFn fun i => algebraMap R (Localization.AtPrime p) (f i))) :
    ∃ g : R, g ∉ p ∧ a ∣ g ∧ RingTheory.Sequence.IsRegular (Localization.Away g)
      (List.ofFn fun i => algebraMap R (Localization.Away g) (f i)) := by
  obtain ⟨g, hg, hag, hr⟩ := regular_sequence_localize_away_of_atPrime_mul p (List.ofFn f)
    ((isRegular_localizedModule_iff p.primeCompl _).2 (by
      simpa only [List.map_ofFn, Function.comp_def] using hreg)) a ha
  refine ⟨g, hg, hag, ?_⟩
  simpa only [List.map_ofFn, Function.comp_def] using
    (isRegular_localizedModule_iff (Submonoid.powers g) _).1 hr

/-- An ideal of a Noetherian ring which has finite projective dimension and whose conormal
module is finite locally free over the quotient is a regular ideal. -/
@[stacks 0FJS]
public theorem isRegular_of_projectiveDimension_ne_top_of_isFiniteLocallyFree_cotangent
    (I : Ideal R) (hpd : Module.projectiveDimension R I ≠ ⊤)
    (hconormal : Module.IsFiniteLocallyFree (R ⧸ I) I.Cotangent) : I.IsRegular := by
  classical
  have hproj := projective_of_isFiniteLocallyFree hconormal
  intro P hIP
  let p : Ideal R := P.asIdeal
  let : p.IsPrime := P.isPrime
  obtain ⟨r, f, hreg, hgen⟩ :=
    exists_regular_generators_from_base_atPrime I p hIP hpd hproj
  let K : Ideal R := Ideal.span (Set.range fun i : Fin r => (f i : R))
  have hKI : K ≤ I := Ideal.span_le.mpr (Set.range_subset_iff.mpr fun i => (f i).2)
  have heq : I.map (algebraMap R (Localization.AtPrime p)) =
      K.map (algebraMap R (Localization.AtPrime p)) := by
    simpa only [K, Ideal.map_span, ← Set.range_comp, Function.comp_def,
      Ideal.ofList_ofFn] using hgen
  obtain ⟨a, ha, hclear⟩ := exists_away_eq_of_atPrime_eq I K p heq
  obtain ⟨g, hg, ⟨b, hgb⟩, hregg⟩ :=
    exists_away_regular_of_atPrime_regular p (fun i => (f i : R)) a ha hreg
  have hmap : I.map (algebraMap R (Localization.Away g)) =
      K.map (algebraMap R (Localization.Away g)) := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap]
      apply (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (Submonoid.powers g) (Localization.Away g) K x).2
      refine ⟨g, Submonoid.mem_powers g, ?_⟩
      rw [hgb]
      simpa [mul_assoc, mul_comm, mul_left_comm] using
        K.mul_mem_left b (hclear x hx)
    · exact Ideal.map_mono hKI
  refine ⟨g, hg, r, (fun i => algebraMap R (Localization.Away g) (f i : R)),
    hregg, ?_⟩
  simpa only [K, Ideal.map_span, ← Set.range_comp, Function.comp_def]
    using hmap

end Ideal

end
