* [Stacks 07BV](https://stacks.math.columbia.edu/tag/07BV)
* [Stacks 037X](https://stacks.math.columbia.edu/tag/037X)
* [Stacks 00P0](https://stacks.math.columbia.edu/tag/00P0)
* [Stacks 031Y](https://stacks.math.columbia.edu/tag/031Y)
* [Stacks 030O](https://stacks.math.columbia.edu/tag/030O)
-/

@[expose] public section

open Polynomial

/-- Division by a monic polynomial: if `μ` is monic, `μ(e) = 0`, and no nonzero polynomial of
smaller degree vanishes at `e`, then `μ` generates the kernel of evaluation at `e`. -/
theorem Polynomial.ker_eval₂RingHom_eq_span_of_monic {R L : Type*} [CommRing R] [CommRing L]
    (φ : R →+* L) (e : L) {μ : R[X]} (hμ : μ.Monic) (he : μ.eval₂ φ e = 0)
    (hmin : ∀ p : R[X], p ≠ 0 → p.natDegree < μ.natDegree → p.eval₂ φ e ≠ 0) :
    RingHom.ker (eval₂RingHom φ e) = Ideal.span {μ} := by
  ext p
  simp only [RingHom.mem_ker, coe_eval₂RingHom, Ideal.mem_span_singleton]
  constructor
  · intro hp
    nontriviality R
    rw [← modByMonic_eq_zero_iff_dvd hμ]
    by_contra h
    refine hmin _ h (natDegree_lt_natDegree h (degree_modByMonic_lt p hμ)) ?_
    rw [modByMonic_eq_sub_mul_div p μ, eval₂_sub, eval₂_mul, hp, he, zero_mul, sub_zero]
  · rintro ⟨q, rfl⟩
    simp [eval₂_mul, he]

section

variable {k : Type*} [Field k]

/-- A `k`-algebra `B` has a finite presentation with `d` more variables than relations, and a
transcendence basis over `k` with `d` elements. -/
private def HasGoodPresentation (k B : Type*) [Field k] [CommRing B] [Algebra k B] (d : ℕ) : Prop :=
  (∃ (ι σ : Type) (_ : Finite ι) (_ : Finite σ) (_ : Algebra.Presentation k B ι σ),
    Nat.card ι = Nat.card σ + d) ∧
  ∃ (ι : Type) (_ : Finite ι) (x : ι → B), IsTranscendenceBasis k x ∧ Nat.card ι = d

/-- `HasGoodPresentation` is invariant under isomorphism. -/
private theorem HasGoodPresentation.of_algEquiv {B B' : Type*} [CommRing B] [CommRing B']
    [Algebra k B] [Algebra k B'] {d : ℕ} (e : B ≃ₐ[k] B') (h : HasGoodPresentation k B d) :
    HasGoodPresentation k B' d := by
  obtain ⟨⟨ι, σ, hι, hσ, P, hP⟩, ⟨κ, hκ, x, hx, hκd⟩⟩ := h
  refine ⟨⟨ι, σ, hι, hσ, P.ofAlgEquiv e, hP⟩, ⟨κ, hκ, e ∘ x, ?_, hκd⟩⟩
  exact AlgEquiv.isTranscendenceBasis e hx

/-- The field `k` itself: no variables, no relations, empty transcendence basis. -/
private theorem hasGoodPresentation_self : HasGoodPresentation k k 0 := by
  refine ⟨⟨PEmpty, PEmpty, inferInstance, inferInstance, Algebra.Presentation.id k, rfl⟩, ?_⟩
  obtain ⟨ι, x, hx⟩ := exists_isTranscendenceBasis' k k
  have : IsEmpty ι := hx.1.isEmpty_of_isAlgebraic
  refine ⟨Empty, inferInstance, Empty.elim, ?_, Nat.card_of_isEmpty⟩
  have := (isTranscendenceBasis_equiv (Equiv.equivOfIsEmpty Empty ι) (f := x)).mpr hx
  convert this using 1

/-- Evaluation of one-variable `MvPolynomial`s at `X` is the standard isomorphism with `B[X]`. -/
private theorem aeval_X_eq_uniqueAlgEquiv (B : Type*) [CommRing B] :
    MvPolynomial.aeval (fun _ : Unit ↦ (X : B[X])) =
      (MvPolynomial.uniqueAlgEquiv B Unit).toAlgHom :=
  MvPolynomial.algHom_ext fun _ ↦ by simp [MvPolynomial.uniqueAlgEquiv_apply]

/-- The presentation of `B[X]` over `B` with one variable and no relations. -/
private noncomputable def polynomialPresentation (B : Type*) [CommRing B] :
    Algebra.Presentation B B[X] Unit Empty where
  toGenerators := Algebra.Generators.ofSurjective (fun _ ↦ X) (by
    rw [aeval_X_eq_uniqueAlgEquiv]; exact (MvPolynomial.uniqueAlgEquiv B Unit).surjective)
  relation := Empty.elim
  span_range_relation_eq_ker := by
    rw [Algebra.Generators.ker_eq_ker_aeval_val]
    simp only [Set.range_eq_empty, Ideal.span_empty]
    refine ((RingHom.injective_iff_ker_eq_bot _).mp ?_).symm
    change Function.Injective (MvPolynomial.aeval (fun _ : Unit ↦ (X : B[X])))
    rw [aeval_X_eq_uniqueAlgEquiv]
    exact (MvPolynomial.uniqueAlgEquiv B Unit).injective

/-- Passing from `B` to `B[X]` adds one variable, no relation and one transcendental element. -/
private theorem HasGoodPresentation.polynomial {B : Type*} [CommRing B] [IsDomain B] [Algebra k B]
    {d : ℕ} (h : HasGoodPresentation k B d) : HasGoodPresentation k B[X] (d + 1) := by
  obtain ⟨⟨ι, σ, hι, hσ, P, hP⟩, ⟨κ, hκ, x, hx, hκd⟩⟩ := h
  refine ⟨⟨Unit ⊕ ι, Empty ⊕ σ, inferInstance, inferInstance, (polynomialPresentation B).comp P,
    ?_⟩, ⟨Unit ⊕ κ, inferInstance, _, hx.sumElim_comp (.polynomial Unit B), ?_⟩⟩
  · simp [Nat.card_sum, hP]; ring
  · simp [Nat.card_sum, hκd]; ring

/-- `HasGoodPresentation` passes to the image of an injective algebra map. -/
private theorem HasGoodPresentation.range {B K : Type*} [CommRing B] [Algebra k B] [CommRing K]
    [Algebra k K] {d : ℕ} (h : HasGoodPresentation k B d) (Ψ : B →ₐ[k] K)
    (hΨ : Function.Injective Ψ) : HasGoodPresentation k Ψ.range d :=
  h.of_algEquiv (AlgEquiv.ofInjective Ψ hΨ)

/-- The quotient `B_g[Y]/(μ)` of the polynomial ring over a principal localization of `B` by a
single polynomial, written with a one-variable `MvPolynomial` ring. -/
private abbrev LocalizationQuotient {B : Type*} [CommRing B] (g : B)
    (μ : (Localization.Away g)[X]) :=
  MvPolynomial Unit (Localization.Away g) ⧸
    Ideal.span (Set.range fun _ : Unit ↦ (MvPolynomial.uniqueAlgEquiv _ Unit).symm μ)

/-- `B_g[Y]/(μ)` is integral over `B_g` when `μ` is monic. -/
private theorem isIntegral_localizationQuotient {B : Type*} [CommRing B] (g : B)
    {μ : (Localization.Away g)[X]} (hμ : μ.Monic) :
    Algebra.IsIntegral (Localization.Away g) (LocalizationQuotient g μ) := by
  set I := Ideal.span (Set.range fun _ : Unit ↦ (MvPolynomial.uniqueAlgEquiv _ Unit).symm μ)
  let π := Ideal.Quotient.mkₐ (Localization.Away g) I
  have hX : IsIntegral (Localization.Away g) (π (MvPolynomial.X ())) := by
    refine ⟨μ, hμ, ?_⟩
    rw [← Polynomial.aeval_def, Polynomial.aeval_algHom_apply]
    refine (Ideal.Quotient.eq_zero_iff_mem).2 (Ideal.subset_span ⟨(), ?_⟩)
    simp only [MvPolynomial.uniqueAlgEquiv, Polynomial.aeval_def]
    rfl
  refine ⟨fun t ↦ ?_⟩
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective (Localization.Away g) I t
  induction p using MvPolynomial.induction_on with
  | C a => simpa [π] using isIntegral_algebraMap (x := a)
  | add p q hp hq =>
    rw [map_add]; exact IsIntegral.add (A := MvPolynomial Unit (Localization.Away g) ⧸ I) hp hq
  | mul_X p i hp =>
    rw [map_mul]; exact IsIntegral.mul (A := MvPolynomial Unit (Localization.Away g) ⧸ I) hp hX

/-- Passing from `B` to `B_g[Y]/(μ)`, with `μ` monic and `B → B_g[Y]/(μ)` injective, adds two
variables and two relations and keeps the transcendence basis. -/
private theorem HasGoodPresentation.localizationQuotient {B : Type*} [CommRing B] [IsDomain B]
    [Algebra k B] {d : ℕ} (h : HasGoodPresentation k B d) {g : B} (hg : g ≠ 0)
    {μ : (Localization.Away g)[X]} (hμ : μ.Monic)
    (hinj : Function.Injective (algebraMap B (LocalizationQuotient g μ))) :
    HasGoodPresentation k (LocalizationQuotient g μ) d := by
  obtain ⟨⟨ι, σ, hι, hσ, P, hP⟩, ⟨κ, hκ, x, hx, hκd⟩⟩ := h
  refine ⟨⟨Unit ⊕ (Unit ⊕ ι), Unit ⊕ (Unit ⊕ σ), inferInstance, inferInstance,
    (Algebra.Presentation.naive (v := fun _ : Unit ↦
      (MvPolynomial.uniqueAlgEquiv (Localization.Away g) Unit).symm μ)).comp
      ((Algebra.Presentation.localizationAway (Localization.Away g) g).comp P), ?_⟩,
    ⟨κ, hκ, algebraMap B _ ∘ x, ?_, hκd⟩⟩
  · simp [Nat.card_sum, hP]; ring
  · have : IsDomain (Localization.Away g) := Localization.Away.isDomain hg
    have := isIntegral_localizationQuotient g hμ
    have : Algebra.IsAlgebraic B (Localization.Away g) :=
      IsLocalization.isAlgebraic _ (Submonoid.powers g)
    have : Algebra.IsAlgebraic B (LocalizationQuotient g μ) :=
      Algebra.IsAlgebraic.trans_isIntegral B (Localization.Away g) _
    have : FaithfulSMul B (LocalizationQuotient g μ) :=
      (faithfulSMul_iff_algebraMap_injective _ _).2 hinj
    exact hx.algebraMap_comp

variable {K : Type*} [Field K] [Algebra k K]

/-- A `k`-subalgebra `B ⊆ K` with a good presentation can be enlarged to one containing any
given `e ∈ K`. -/
private theorem exists_hasGoodPresentation_of_le (B : Subalgebra k K) {d : ℕ}
    (hB : HasGoodPresentation k B d) (e : K) :
    ∃ (B' : Subalgebra k K) (d' : ℕ), B ≤ B' ∧ e ∈ B' ∧ HasGoodPresentation k B' d' := by
  set C := Subfield.closure (B : Set K)
  have hBC : ∀ b ∈ B, b ∈ C := fun b hb ↦ Subfield.subset_closure hb
  let ι : B →+* C :=
    { toFun := fun b ↦ ⟨b, hBC b b.2⟩, map_one' := rfl, map_mul' := fun _ _ ↦ rfl,
      map_zero' := rfl, map_add' := fun _ _ ↦ rfl }
  have hι : ∀ b : B, ((ι b : C) : K) = b := fun _ ↦ rfl
  have hιinj : Function.Injective ι := fun a b h ↦ Subtype.ext (by
    simpa [hι] using congrArg Subtype.val h)
  by_cases halg : IsAlgebraic C e
  · have hint : IsIntegral C e := halg.isIntegral
    set μC := minpoly C e with hμC_def
    set n := μC.natDegree with hn
    have hclos : Subring.closure (B : Set K) = B.toSubring := by
      simpa using Subring.closure_eq B.toSubring
    have hcoeff : ∀ j : Fin n, ∃ a s : B, s ≠ 0 ∧ ((μC.coeff j : C) : K) = a / s := by
      intro j
      obtain ⟨y, hy, z, hz, hyz⟩ := Subfield.mem_closure_iff.1 (μC.coeff j).2
      rw [hclos] at hy hz
      by_cases hz0 : z = 0
      · refine ⟨0, 1, one_ne_zero, ?_⟩
        rw [← hyz, hz0]
        simp
      · exact ⟨⟨y, hy⟩, ⟨z, hz⟩, fun h ↦ hz0 (congrArg Subtype.val h), hyz.symm⟩
    choose a s hs hc using hcoeff
    set g : B := ∏ j, s j with hg_def
    have hg : g ≠ 0 := Finset.prod_ne_zero_iff.2 fun j _ ↦ hs j
    have hu : ∀ j, IsUnit (algebraMap B (Localization.Away g) (s j)) := fun j ↦
      isUnit_of_dvd_unit (map_dvd _ (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)))
        (IsLocalization.Away.algebraMap_isUnit g)
    let β : Fin n → Localization.Away g := fun j ↦
      algebraMap B (Localization.Away g) (a j) * ↑(hu j).unit⁻¹
    let μ : (Localization.Away g)[X] := X ^ n + ∑ j : Fin n, Polynomial.C (β j) * X ^ (j : ℕ)
    have hdeg : (∑ j : Fin n, Polynomial.C (β j) * X ^ (j : ℕ)).degree < (n : WithBot ℕ) :=
      degree_sum_fin_lt β
    have hμ : μ.Monic := monic_X_pow_add hdeg
    have : IsDomain (Localization.Away g) := Localization.Away.isDomain hg
    have hμn : μ.natDegree = n := by
      rw [natDegree_add_eq_left_of_degree_lt (by rwa [degree_X_pow]), natDegree_X_pow]
    have hιg : IsUnit (ι g) := isUnit_iff_ne_zero.2 fun h ↦ hg (hιinj (by rw [h, map_zero]))
    let ψ : Localization.Away g →+* C := IsLocalization.Away.lift g hιg
    have hψ : ∀ b : B, ψ (algebraMap B _ b) = ι b := fun b ↦ IsLocalization.lift_eq _ b
    have hψinj : Function.Injective ψ := by
      refine (injective_iff_map_eq_zero ψ).2 fun z hz ↦ ?_
      obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.surj (Submonoid.powers g) z
      have hb0 : b = 0 := hιinj (by rw [← hψ, ← hbt, map_mul, hz, zero_mul, map_zero])
      rw [hb0, map_zero] at hbt
      exact (IsLocalization.map_units (Localization.Away g) t).mul_left_eq_zero.1 hbt
    have hψβ : ∀ j, ψ (β j) = μC.coeff j := by
      intro j
      have h1 : ψ (↑(hu j).unit⁻¹) * ι (s j) = 1 := by
        rw [← hψ, ← map_mul]
        simp
      have hs' : ι (s j) ≠ 0 := fun h ↦ hs j (hιinj (by rw [h, map_zero]))
      apply Subtype.ext
      rw [hc j]
      simp only [β, map_mul, hψ, Subfield.coe_mul]
      have h1' : (ψ (↑(hu j).unit⁻¹) : K) * (s j : K) = 1 := by
        simpa [hι] using congrArg Subtype.val h1
      rw [eq_div_iff (by simpa [hι] using (Subtype.ext_iff.not.1 hs')), mul_assoc, h1',
        mul_one, hι]
    have hmap : μ.map ψ = μC := by
      have hmon : μC.Monic := minpoly.monic hint
      conv_rhs => rw [hmon.as_sum]
      simp only [μ, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
        Polynomial.map_mul, Polynomial.map_C, hψβ]
      rw [← hn, Fin.sum_univ_eq_sum_range (fun i ↦ Polynomial.C (μC.coeff i) * X ^ i)]
    let φ : Localization.Away g →+* K := C.subtype.comp ψ
    have hev : ∀ p : (Localization.Away g)[X], p.eval₂ φ e = aeval e (p.map ψ) := fun p ↦ by
      rw [aeval_def, eval₂_map]
      rfl
    have he : μ.eval₂ φ e = 0 := by rw [hev, hmap, minpoly.aeval]
    have hmin : ∀ p : (Localization.Away g)[X], p ≠ 0 → p.natDegree < μ.natDegree →
        p.eval₂ φ e ≠ 0 := by
      intro p hp0 hpn hpe
      rw [hev] at hpe
      have := minpoly.degree_le_of_ne_zero C e ((Polynomial.map_ne_zero_iff hψinj).2 hp0) hpe
      have := natDegree_le_natDegree this
      rw [natDegree_map_eq_of_injective hψinj] at this
      have hn' : n = (minpoly C e).natDegree := rfl
      omega
    have hker := Polynomial.ker_eval₂RingHom_eq_span_of_monic φ e hμ he hmin
    set I := Ideal.span (Set.range fun _ : Unit ↦
      (MvPolynomial.uniqueAlgEquiv (Localization.Away g) Unit).symm μ) with hI
    let Ψ0 : MvPolynomial Unit (Localization.Away g) →+* K :=
      MvPolynomial.eval₂Hom φ fun _ ↦ e
    have hΨ0 : Ψ0 = (eval₂RingHom φ e).comp
        ((MvPolynomial.uniqueAlgEquiv (Localization.Away g) Unit).toRingEquiv :
          MvPolynomial Unit (Localization.Away g) →+* (Localization.Away g)[X]) := by
      refine MvPolynomial.ringHom_ext (fun r ↦ ?_) (fun i ↦ ?_)
      · simp [Ψ0, MvPolynomial.uniqueAlgEquiv_apply]
      · simp [Ψ0, MvPolynomial.uniqueAlgEquiv_apply]
    have hkerΨ0 : RingHom.ker Ψ0 = I := by
      rw [hΨ0, ← RingHom.comap_ker, hker, hI, Set.range_const]
      exact (Ideal.map_symm (I := Ideal.span {μ})
        (MvPolynomial.uniqueAlgEquiv (Localization.Away g) Unit).toRingEquiv).symm.trans
        (by rw [Ideal.map_span, Set.image_singleton]; rfl)
    let Ψ1 : LocalizationQuotient g μ →+* K :=
      Ideal.Quotient.lift I Ψ0 fun x hx ↦ by rwa [← RingHom.mem_ker, hkerΨ0]
    have hΨ1 : Function.Injective Ψ1 := (Ideal.injective_lift_iff _).2 hkerΨ0
    have hΨB : ∀ b : B, Ψ1 (algebraMap B _ b) = b := fun b ↦ by
      show Ψ1 (Ideal.Quotient.mk I (MvPolynomial.C (algebraMap B (Localization.Away g) b))) = _
      simp [Ψ1, Ψ0, φ, hψ, hι]
    let Ψ : LocalizationQuotient g μ →ₐ[k] K :=
      { Ψ1 with
        commutes' := fun r ↦ by
          have := hΨB (algebraMap k B r)
          rw [← IsScalarTower.algebraMap_apply] at this
          simpa using this }
    have hinjB : Function.Injective (algebraMap B (LocalizationQuotient g μ)) :=
      fun x y h ↦ Subtype.ext (by rw [← hΨB x, ← hΨB y, h])
    refine ⟨Ψ.range, d, fun b hb ↦ ⟨algebraMap B _ ⟨b, hb⟩, hΨB _⟩, ?_,
      (hB.localizationQuotient hg hμ hinjB).range Ψ hΨ1⟩
    refine ⟨Ideal.Quotient.mk I (MvPolynomial.X ()), ?_⟩
    change Ψ0 (MvPolynomial.X ()) = e
    exact MvPolynomial.eval₂_X _ _ _
  · have htr : Transcendental B e := by
      rintro ⟨p, hp0, hpe⟩
      refine halg ⟨p.map ι, (Polynomial.map_ne_zero_iff hιinj).2 hp0, ?_⟩
      rwa [Polynomial.aeval_def, Polynomial.eval₂_map]
    have hinj : Function.Injective ((Polynomial.aeval e : B[X] →ₐ[B] K).restrictScalars k) :=
      (transcendental_iff_injective).1 htr
    refine ⟨_, d + 1, fun b hb ↦ ?_, ?_, hB.polynomial.range _ hinj⟩
    · exact ⟨Polynomial.C ⟨b, hb⟩, by simp⟩
    · exact ⟨X, by simp⟩

/-- Every finite subset of `K` lies in a `k`-subalgebra with a good presentation. -/
private theorem exists_hasGoodPresentation (s : Finset K) :
    ∃ (B : Subalgebra k K) (d : ℕ), (s : Set K) ⊆ B ∧ HasGoodPresentation k B d := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    exact ⟨_, 0, by simp,
      hasGoodPresentation_self.range (Algebra.ofId k K) (algebraMap k K).injective⟩
  | insert e s _ ih =>
    obtain ⟨B, d, hsB, hB⟩ := ih
    obtain ⟨B', d', hBB', heB', hB'⟩ := exists_hasGoodPresentation_of_le B hB e
    refine ⟨B', d', ?_, hB'⟩
    rw [Finset.coe_insert, Set.insert_subset_iff]
    exact ⟨heB', hsB.trans hBB'⟩

/-- A `k`-subalgebra of `K` with a good presentation is a global complete intersection over
`k`: its dimension is the size of its transcendence basis by Lemma 00P0. -/
private theorem HasGoodPresentation.isGlobalCompleteIntersectionOver {A : Subalgebra k K} {d : ℕ}
    (h : HasGoodPresentation k A d) : IsGlobalCompleteIntersectionOver k A := by
  obtain ⟨⟨ι, σ, hι, hσ, P, hP⟩, ⟨κ, hκ, x, hx, hκd⟩⟩ := h
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite σ
  have := Fintype.ofFinite κ
  let P' := P.reindex (Fintype.equivFin ι).symm (Fintype.equivFin σ).symm
  right
  refine ⟨Fintype.card ι, Fintype.card σ, MvPolynomial.aeval P'.val, P'.relation,
    P'.aeval_val_surjective, ?_, ?_⟩
  · rw [P'.span_range_relation_eq_ker, P'.ker_eq_ker_aeval_val]
    rfl
  · have : Algebra.FinitePresentation k A := P.finitePresentation_of_isFinite
    have hdim := (ringKrullDim_eq_trdeg_and_ringKrullDim_localization_eq_trdeg.{_, _, _, 0} k A
      (FractionRing A)).1
    have : Algebra.IsAlgebraic A (FractionRing A) :=
      IsLocalization.isAlgebraic _ (nonZeroDivisors A)
    have hx' : IsTranscendenceBasis k (algebraMap A (FractionRing A) ∘ x) := hx.algebraMap_comp
    have htr := hx'.lift_cardinalMk_eq_trdeg
    have hκ' : Fintype.card κ = d := by rw [← hκd, Nat.card_eq_fintype_card]
    have : Cardinal.toENat (Algebra.trdeg k (FractionRing A)) = d := by
      have := congrArg Cardinal.toENat htr
      simpa [hκ'] using this.symm
    rw [hdim, this]
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card] at hP
    rw [hP]
    norm_cast
    omega

/-- A family of finitely generated subalgebras such that every finite subset of `K` lies in one of
them is directed and exhausts `K`. -/
theorem Subalgebra.directedOn_and_forall_mem_of_forall_finset (S : Set (Subalgebra k K))
    (hfg : ∀ A ∈ S, A.FG) (h : ∀ s : Finset K, ∃ A : Subalgebra k K, (s : Set K) ⊆ A ∧ A ∈ S) :
    DirectedOn (· ≤ ·) S ∧ ∀ x : K, ∃ A ∈ S, x ∈ A := by
  classical
  refine ⟨fun A hA B hB ↦ ?_, fun x ↦ ?_⟩
  · obtain ⟨t, ht⟩ := (hfg A hA).sup (hfg B hB)
    obtain ⟨C, htC, hC⟩ := h t
    have : A ⊔ B ≤ C := ht ▸ Algebra.adjoin_le htC
    exact ⟨C, hC, le_sup_left.trans this, le_sup_right.trans this⟩
  · obtain ⟨A, hxA, hA⟩ := h {x}
    exact ⟨A, hA, hxA (by simp)⟩

/-- A global complete intersection `k`-subalgebra of a field is finitely generated. -/
theorem IsGlobalCompleteIntersectionOver.fg {A : Subalgebra k K}
    (h : IsGlobalCompleteIntersectionOver k A) : A.FG := by
  rcases h with h | ⟨n, c, π, f, hπ, -, -⟩
  · exact absurd h (not_subsingleton A)
  · have : Algebra.FiniteType k A := Algebra.FiniteType.of_surjective π hπ
    exact Subalgebra.fg_iff_finiteType A |>.2 this

/-- Every finite subset of a field extension `K/k` lies in a `k`-subalgebra of `K` which is a
global complete intersection over `k`. -/
theorem Subalgebra.exists_finset_subset_isGlobalCompleteIntersectionOver (s : Finset K) :
    ∃ A : Subalgebra k K, (s : Set K) ⊆ A ∧ IsGlobalCompleteIntersectionOver k A := by
  obtain ⟨A, d, hsA, hA⟩ := exists_hasGoodPresentation (k := k) s
  exact ⟨A, hsA, hA.isGlobalCompleteIntersectionOver⟩

/-- Every finite subset of a separable field extension `K/k` lies in a smooth `k`-subalgebra of
`K`. -/
theorem Subalgebra.exists_finset_subset_smooth [Algebra.IsSeparableExtension k K] (s : Finset K) :
    ∃ A : Subalgebra k K, (s : Set K) ⊆ A ∧ Algebra.Smooth k A := by
  classical
  set L := IntermediateField.adjoin k (s : Set K)
  have : Algebra.EssFiniteType k L := IntermediateField.essFiniteType_iff.mpr ⟨s, rfl⟩
  have : Algebra.FormallySmooth k L := by
    obtain ⟨t, ht, hts⟩ := (Algebra.IsSeparableExtension.isSeparablyGenerated (k := k)
      L).isSeparable
    have : Algebra.IsSeparable (IntermediateField.adjoin k (Set.range ((↑) : t → L))) L := by
      rwa [Subtype.range_coe]
    exact Algebra.FormallySmooth.of_algebraicIndependent_of_isSeparable ht.1
  have := Algebra.FormallySmooth.isSeparableExtension k L
  obtain ⟨R, hR, hRL⟩ := ((Algebra.IsSeparableExtension.tfae_exists_smooth k L).out 1 2).1 this
  have hmk : ∀ x : s, ∃ (a : R) (b : nonZeroDivisors R),
      IsLocalization.mk' L a b = ⟨x, IntermediateField.subset_adjoin _ _ x.2⟩ :=
    fun x ↦ by
      obtain ⟨⟨a, b⟩, h⟩ := IsLocalization.mk'_surjective (nonZeroDivisors R)
        (⟨x, IntermediateField.subset_adjoin _ _ x.2⟩ : L)
      exact ⟨a, b, h⟩
  choose a b hab using hmk
  set g : nonZeroDivisors R := ∏ x, b x
  let Rg := Localization.subalgebra L (Submonoid.powers (g : R))
    (Submonoid.powers_le.2 g.2)
  have hsmR : Algebra.Smooth R Rg := Algebra.Smooth.of_isLocalization_Away (g : R)
  have : Algebra.Smooth k Rg := Algebra.Smooth.comp k R Rg
  have hmem : ∀ x : s, (⟨x, IntermediateField.subset_adjoin _ _ x.2⟩ : L) ∈ Rg := by
    intro x
    obtain ⟨c, hc⟩ : b x ∣ g := Finset.dvd_prod_of_mem _ (Finset.mem_univ x)
    rw [← hab, IsLocalization.mk'_eq_mul_mk'_one]
    refine Rg.mul_mem (Rg.algebraMap_mem _) ?_
    have : IsLocalization.mk' L (1 : R) (b x) = IsLocalization.mk' L (c : R) g := by
      rw [IsLocalization.mk'_eq_iff_eq, hc]
      simp [mul_comm]
    rw [this]
    exact ⟨c, g, Submonoid.mem_powers _, rfl⟩
  refine ⟨(Rg.restrictScalars k).map (IsScalarTower.toAlgHom k L K),
    fun x hx ↦ ⟨_, hmem ⟨x, hx⟩, rfl⟩, ?_⟩
  · have : Algebra.Smooth k (Rg.restrictScalars k) := ‹Algebra.Smooth k Rg›
    exact Algebra.Smooth.of_equiv (Subalgebra.equivMapOfInjective (Rg.restrictScalars k) _
      (algebraMap L K).injective)


/-- **Stacks 07BV, first part.** Every field extension `K/k` is a filtered colimit of global
complete intersection algebras over `k`: the `k`-subalgebras of `K` that are global complete
intersections over `k` form a directed family whose union is `K`. -/
@[stacks 07BV "First part. The filtered colimit is the directed union of the global complete
intersection `k`-subalgebras of `K`; see the module docstring."]
theorem Subalgebra.directedOn_isGlobalCompleteIntersectionOver_and_exists_mem
    (k K : Type*) [Field k] [Field K] [Algebra k K] :
    DirectedOn (· ≤ ·) {A : Subalgebra k K | IsGlobalCompleteIntersectionOver k A} ∧
      ∀ x : K, ∃ A ∈ {A : Subalgebra k K | IsGlobalCompleteIntersectionOver k A}, x ∈ A :=
  Subalgebra.directedOn_and_forall_mem_of_forall_finset _ (fun _ hA ↦ hA.fg)
    fun s ↦ Subalgebra.exists_finset_subset_isGlobalCompleteIntersectionOver s

/-- **Stacks 07BV, second part.** A separable field extension `K/k` is a filtered colimit of
smooth `k`-algebras: the smooth `k`-subalgebras of `K` form a directed family whose union
is `K`. -/
@[stacks 07BV "Second part. The filtered colimit is the directed union of the smooth
`k`-subalgebras of `K`; see the module docstring."]
theorem Subalgebra.directedOn_smooth_and_exists_mem
    (k K : Type*) [Field k] [Field K] [Algebra k K] [Algebra.IsSeparableExtension k K] :
    DirectedOn (· ≤ ·) {A : Subalgebra k K | Algebra.Smooth k A} ∧
      ∀ x : K, ∃ A ∈ {A : Subalgebra k K | Algebra.Smooth k A}, x ∈ A :=
  Subalgebra.directedOn_and_forall_mem_of_forall_finset _
    (fun A hA ↦ have := hA.finitePresentation; (Subalgebra.fg_iff_finiteType A).2 inferInstance)
    fun s ↦ Subalgebra.exists_finset_subset_smooth s

end

