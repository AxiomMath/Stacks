/-!
# Ideals of a two-dimensional regular local ring with reduced, or depth-one, quotient

Let `(A, 𝔪)` be a regular local ring of Krull dimension `2` and let `I ⊆ 𝔪` be an ideal. If `A/I`
is reduced then `I` is `(0)`, `𝔪`, or principal generated by a nonzero element of `𝔪`; if `A/I`
has depth `1` then `I` is principal generated by a nonzero element of `𝔪`.

## Main results

All three are in the `IsRegularLocalRing` namespace.

* `exists_eq_span_singleton_or_exists_eq_span_singleton_mul_of_ne_bot`: a nonzero ideal
  contained in `𝔪` is principal, or the product of a nonzero principal ideal and a proper ideal
  whose radical is `𝔪`.
* `eq_bot_or_eq_maximalIdeal_or_eq_span_singleton_of_quotient_isReduced`: if `A/I` is reduced
  then `I` is `(0)`, `𝔪`, or generated by a nonzero element of `𝔪`.
* `exists_ne_zero_mem_maximalIdeal_and_eq_span_singleton_of_quotient_depth_eq_one`: if `A/I` has
  depth `1` then `I` is generated by a nonzero element of `𝔪`.

## References

* [Stacks Project, Tag 0C48](https://stacks.math.columbia.edu/tag/0C48)
* [Stacks Project, Tag 0AG0](https://stacks.math.columbia.edu/tag/0AG0)
-/

@[expose] public section

universe u

namespace IsRegularLocalRing

/-- A nonzero ideal contained in the maximal ideal of a two-dimensional regular local ring is
principal, or has a nonzero principal factor and a proper remaining factor whose radical is the
maximal ideal. -/
public theorem exists_eq_span_singleton_or_exists_eq_span_singleton_mul_of_ne_bot
    {A : Type*} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) (I : Ideal A) (hI : I ≠ ⊥)
    (hImax : I ≤ IsLocalRing.maximalIdeal A) :
    (∃ f : A, f ≠ 0 ∧ f ∈ IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f}) ∨
      ∃ (f : A) (J : Ideal A), f ≠ 0 ∧ J ≠ ⊤ ∧
        J.radical = IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f} * J := by
  classical
  let : IsDomain A := IsRegularLocalRing.isDomain A
  let : UniqueFactorizationMonoid A := IsRegularLocalRing.uniqueFactorizationMonoid A
  obtain ⟨T, hIspan⟩ : I.FG := Ideal.fg_of_isNoetherianRing I
  let : StrongNormalizationMonoid A := UniqueFactorizationMonoid.strongNormalizationMonoid
  let : NormalizedGCDMonoid A := UniqueFactorizationMonoid.toNormalizedGCDMonoid A
  let f : A := T.gcd (fun x : A => x)
  have hdvd : ∀ x ∈ T, f ∣ x := fun x hx => by simpa [f] using Finset.gcd_dvd hx
  have hTI : ∀ x ∈ T, x ∈ I := fun x hx => by
    rw [← hIspan]
    exact Ideal.subset_span hx
  let J : Ideal A := I.colon ({f} : Set A)
  have hmemJ : ∀ y, f * y ∈ I → y ∈ J := fun y hy => by
    show y ∈ I.colon ({f} : Set A)
    rw [Submodule.mem_colon_singleton]
    show y * f ∈ I
    rwa [mul_comm]
  have hIle : I ≤ Ideal.span {f} := by
    rw [← hIspan]
    exact Ideal.span_le.mpr fun x hx => Ideal.mem_span_singleton.mpr (hdvd x hx)
  have hf0 : f ≠ 0 := fun hf => hI (bot_unique (by simpa [hf] using hIle))
  have hfactor : I = Ideal.span {f} * J := by
    refine le_antisymm ?_ (Ideal.mul_le.mpr fun a ha b hb => ?_)
    · rw [← hIspan]
      refine Ideal.span_le.mpr fun x hx => ?_
      obtain ⟨y, rfl⟩ := hdvd x hx
      exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self f) (hmemJ y (hTI _ hx))
    · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have hb' : b * f ∈ I := Submodule.mem_colon_singleton.mp hb
      simpa [mul_assoc, mul_comm, mul_left_comm] using I.mul_mem_left c hb'
  by_cases hJtop : J = ⊤
  · have hIf : I = Ideal.span {f} := by simpa [hJtop] using hfactor
    exact .inl ⟨f, hf0, hImax (hIf ▸ Ideal.mem_span_singleton_self f), hIf⟩
  right
  let : FiniteRingKrullDim A := (finiteRingKrullDim_iff_ne_bot_and_top).2
    ⟨by rw [hdim]; exact WithBot.coe_ne_bot,
      by rw [hdim]; exact fun h => ENat.natCast_ne_top 2 (WithBot.coe_eq_top.mp h)⟩
  have hJnebot : J ≠ ⊥ := fun hJbot => hI (by rw [hfactor, hJbot]; simp)
  have hnoheightone : ∀ P : Ideal A, P.IsPrime → P.height = 1 → ¬ J ≤ P := by
    intro P hP hPh hJP
    have hPprin : P.IsPrincipal := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hPh
    let q : A := hPprin.generator
    have hqprime : Prime q := hPprin.prime_generator_of_isPrime P (P.ne_bot_of_height_eq_one hPh)
    have hPq : P = Ideal.span {q} := P.eq_span_singleton_of_height_eq_one hPh (by simp [q]) hqprime
    have hdiv : ∀ x ∈ T, f * q ∣ x := by
      intro x hx
      obtain ⟨y, rfl⟩ := hdvd x hx
      obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton.mp (hPq ▸ hJP (hmemJ y (hTI _ hx)))
      exact ⟨z, by ring⟩
    have hdivg : f * q ∣ f := by simpa [f] using Finset.dvd_gcd_iff.mpr hdiv
    exact hqprime.not_isUnit <| isUnit_iff_dvd_one.mpr <|
      (mul_dvd_mul_iff_left hf0).mp (by rwa [mul_one])
  have hmheight : (IsLocalRing.maximalIdeal A).height = (2 : ℕ∞) := by
    apply WithBot.coe_injective
    rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
    exact hdim
  have hradical : J.radical = IsLocalRing.maximalIdeal A := by
    refine le_antisymm ((IsLocalRing.maximalIdeal.isMaximal A).isPrime.radical_le_iff.mpr
      (IsLocalRing.le_maximalIdeal hJtop)) ?_
    rw [Ideal.radical_eq_sInf]
    refine le_sInf fun P ⟨hJP, hP⟩ =>
      (eq_of_le_of_not_lt (IsLocalRing.le_maximalIdeal_of_isPrime P) fun hPlt => ?_).ge
    have hPne : P.height ≠ 0 := fun hz =>
      hJnebot (bot_unique (by simpa [Ideal.height_eq_zero_iff_eq_bot.mp hz] using hJP))
    have hlt : P.height < (2 : ℕ∞) := by
      simpa [hmheight] using Ideal.height_strict_mono_of_isPrime_of_isPrime hPlt
    obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (hlt.trans (ENat.natCast_lt_top 2)).ne
    rw [← hn] at hPne hlt
    exact hnoheightone P hP (by rw [← hn]; norm_cast at hPne hlt ⊢; omega) hJP
  exact ⟨f, J, hf0, hJtop, hradical, hfactor⟩

/-- An ideal with reduced quotient in a two-dimensional regular local ring is
zero, maximal, or generated by a nonzero element of the maximal ideal. -/
@[stacks 0C48 "reduced_quotient"]
public theorem eq_bot_or_eq_maximalIdeal_or_eq_span_singleton_of_quotient_isReduced
    {A : Type*} [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (I : Ideal A) (hI : I ≤ IsLocalRing.maximalIdeal A) [IsReduced (A ⧸ I)] :
      I = ⊥ ∨ I = IsLocalRing.maximalIdeal A ∨
      ∃ f : A, f ≠ 0 ∧ f ∈ IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f} := by
  have hIr : I.IsRadical := (Ideal.isRadical_iff_quotient_reduced I).mpr inferInstance
  by_cases hzero : I = ⊥; · exact .inl hzero
  rcases exists_eq_span_singleton_or_exists_eq_span_singleton_mul_of_ne_bot hdim I hzero hI with
    hprincipal | ⟨f, J, hf, _, hJrad, hIJ⟩
  · exact .inr (.inr hprincipal)
  by_cases hfm : f ∈ IsLocalRing.maximalIdeal A
  · obtain ⟨n, hfn⟩ := Ideal.mem_radical_iff.mp (hJrad ▸ hfm)
    have hpow : f ^ (n + 1) ∈ I := by
      rw [hIJ, pow_succ]
      simpa [mul_comm] using Ideal.mul_mem_mul (Ideal.mem_span_singleton.mpr ⟨1, by simp⟩) hfn
    exact .inr (.inr ⟨f, hf, hfm, le_antisymm (by rw [hIJ]; exact Ideal.mul_le_left)
      ((Ideal.span_singleton_le_iff_mem I).mpr (hIr (Ideal.mem_radical_iff.mpr ⟨n + 1, hpow⟩)))⟩)
  · have hunit : IsUnit f := (IsLocalRing.notMem_maximalIdeal).mp hfm
    have hIeqJ : I = J := by simpa [Ideal.span_singleton_eq_top.mpr hunit] using hIJ
    rw [hIeqJ] at hIr
    exact .inr (.inl (hIeqJ.trans (hIr.radical.symm.trans hJrad)))

/-- An ideal in a two-dimensional regular local ring whose quotient has
depth one is generated by a nonzero element of the maximal ideal. -/
@[stacks 0C48 "depth_one_quotient"]
public theorem exists_ne_zero_mem_maximalIdeal_and_eq_span_singleton_of_quotient_depth_eq_one
    {A : Type u} [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (I : Ideal A) (hI : I ≤ IsLocalRing.maximalIdeal A)
    (hdepth : Module.depth A (IsLocalRing.maximalIdeal A) (A ⧸ I) = 1) :
    ∃ f : A, f ≠ 0 ∧ f ∈ IsLocalRing.maximalIdeal A ∧ I = Ideal.span {f} := by
  by_cases hIz : I = ⊥
  · subst I
    have hcm :=
      (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay A).2
    have hd : Module.depth A (IsLocalRing.maximalIdeal A) A = 2 := by
      change (Module.depth A (IsLocalRing.maximalIdeal A) A : WithBot ℕ∞) = _ at hcm
      have : (Module.depth A (IsLocalRing.maximalIdeal A) A : WithBot ℕ∞) = 2 := by
        rw [hcm, hdim]
      exact WithBot.coe_eq_coe.mp this
    have depth_eq_of_equiv {M N : Type u} [AddCommGroup M] [Module A M]
        [AddCommGroup N] [Module A N] (e : M ≃ₗ[A] N) :
        Module.depth A (IsLocalRing.maximalIdeal A) M =
          Module.depth A (IsLocalRing.maximalIdeal A) N := by
      have hs : {rs : List A | (∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal A) ∧
          RingTheory.Sequence.IsRegular M rs} =
          {rs : List A | (∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal A) ∧
          RingTheory.Sequence.IsRegular N rs} := by
        ext rs; simp only [Set.mem_ofPred_eq, e.isRegular_congr rs]
      have ht : IsLocalRing.maximalIdeal A • (⊤ : Submodule A M) = ⊤ ↔
          IsLocalRing.maximalIdeal A • (⊤ : Submodule A N) = ⊤ := by
        rw [← Submodule.map_eq_top_iff (e := e), Submodule.map_smul'',
          Submodule.map_top, LinearEquiv.range]
      simp only [Module.depth, hs, ht]
    have htop : Module.depth A (IsLocalRing.maximalIdeal A) (A ⧸ (⊥ : Ideal A)) =
        Module.depth A (IsLocalRing.maximalIdeal A) A :=
      depth_eq_of_equiv
          ({ toEquiv := (RingEquiv.quotientBot A).toEquiv
             map_add' := by simp
             map_smul' := by
               intro c x
               show (RingEquiv.quotientBot A)
                   (Ideal.Quotient.mk (⊥ : Ideal A) c * x) = _
               rw [map_mul]
               simp } :
            (A ⧸ (⊥ : Ideal A)) ≃ₗ[A] A)
    rw [hdepth, hd] at htop
    norm_num at htop
  rcases exists_eq_span_singleton_or_exists_eq_span_singleton_mul_of_ne_bot hdim I hIz hI with
    hcase | ⟨f, J, hf, hJtop, hJrad, hIfJ⟩
  · exact hcase
  · exfalso
    have hdom : IsDomain A := IsRegularLocalRing.isDomain A
    have hnotmem : f ∉ I := fun hfi => hJtop <| (Ideal.span_singleton_mul_right_inj hf).mp <|
      le_antisymm (mul_le_mul' le_rfl le_top) <| by
        rw [Ideal.mul_top, ← hIfJ]
        exact (Ideal.span_singleton_le_iff_mem I).mpr hfi
    let x : A ⧸ I := Ideal.Quotient.mk I f
    have hx : x ≠ 0 := fun hx => hnotmem (Ideal.Quotient.eq_zero_iff_mem.mp hx)
    have hJann : J ≤ (A ∙ x).annihilator := by
      intro j hj
      rw [Submodule.mem_annihilator_span_singleton]
      show Ideal.Quotient.mk I (j * f) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, hIfJ]
      simpa [mul_comm] using Ideal.mul_mem_mul (Ideal.mem_span_singleton_self f) hj
    obtain ⟨P, hP, hann⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing A x hx
    have hJP : J ≤ P := by
      intro j hj
      apply hann
      rw [Submodule.mem_colon_singleton, Submodule.mem_bot]
      exact (Submodule.mem_annihilator_span_singleton x j).mp (hJann hj)
    have hleP : IsLocalRing.maximalIdeal A ≤ P := by
      rw [← hJrad]
      exact hP.isPrime.radical_le_iff.mpr hJP
    have hass' : IsLocalRing.maximalIdeal A ∈ associatedPrimes A (A ⧸ I) :=
      ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hP.isPrime.ne_top hleP) ▸ hP
    have hle := Module.depth_le_ringKrullDim_quotient_of_mem_associatedPrimes hass'
    have hzero : ringKrullDim (A ⧸ IsLocalRing.maximalIdeal A) = 0 := by
      let : (IsLocalRing.maximalIdeal A).IsMaximal :=
        IsLocalRing.maximalIdeal.isMaximal A
      let : Field (A ⧸ IsLocalRing.maximalIdeal A) :=
        Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
      exact ringKrullDim_eq_zero_of_isField (Field.toIsField _)
    have hdepth' : (Module.depth A (IsLocalRing.maximalIdeal A) (A ⧸ I) : WithBot ℕ∞) = 1 := by
      simpa using hdepth
    rw [hdepth', hzero] at hle
    norm_num at hle

end IsRegularLocalRing

end
