open IsLocalRing

/-- The maximal ideal of a power series ring in finitely many variables over a field is generated
by the variables. This is the multivariate `PowerSeries.maximalIdeal_eq_span_X`. -/
public theorem MvPowerSeries.maximalIdeal_eq_span_range_X (k : Type*) [Field k] (n : ℕ) :
    IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k) =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k)) :=
  Stacks.CompleteLocalRing.PowerSeriesRing.maximalIdeal_eq_span_range_X k n

/-- The Krull dimension of a power series ring in `n` variables over a field is at most `n`: its
maximal ideal is generated by the `n` variables. -/
@[ega "0 17.1.4" "(iii)"]
public theorem MvPowerSeries.ringKrullDim_le (k : Type*) [Field k] (n : ℕ) :
    ringKrullDim (MvPowerSeries (Fin n) k) ≤ (n : WithBot ℕ∞) :=
  Stacks.CompleteLocalRing.PowerSeriesRing.ringKrullDim_mvPowerSeries_le k n

/-- The Krull dimension of a power series ring in `n` variables over a field is at least `n`:
each further variable adds one, by `ringKrullDim_succ_le_ringKrullDim_powerseries`. -/
@[ega "0 17.1.4" "(iii)"]
public theorem MvPowerSeries.natCast_le_ringKrullDim (k : Type*) [Field k] (n : ℕ) :
    (n : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin n) k) := by
  induction n with
  | zero => exact zero_le_ringKrullDim_iff_nontrivial.mpr inferInstance
  | succ n ih =>
    calc ((n + 1 : ℕ) : WithBot ℕ∞) = (n : WithBot ℕ∞) + 1 := by norm_num
      _ ≤ ringKrullDim (MvPowerSeries (Fin n) k) + 1 := by gcongr
      _ ≤ ringKrullDim (PowerSeries (MvPowerSeries (Fin n) k)) :=
          ringKrullDim_succ_le_ringKrullDim_powerseries
      _ = ringKrullDim (MvPowerSeries (Fin (n + 1)) k) :=
          (ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv k n).toRingEquiv).symm

/-- **The Krull dimension of `k[[x_1, …, x_n]]` is `n`** for a field `k`. -/
@[ega "0 17.1.4" "(iii): dimension n", ega "0 21.9.3" "partial"]
public theorem MvPowerSeries.ringKrullDim_eq (k : Type*) [Field k] (n : ℕ) :
    ringKrullDim (MvPowerSeries (Fin n) k) = (n : WithBot ℕ∞) :=
  le_antisymm (MvPowerSeries.ringKrullDim_le k n) (MvPowerSeries.natCast_le_ringKrullDim k n)

/-- Let `(R, 𝔪)` be a Noetherian complete local ring which is regular, and let `d` be its
embedding dimension `dim_{R/𝔪} 𝔪/𝔪²`, which equals `dim R`.
1. If `R` contains a field — equivalently `𝐅_p` or `𝐐` — then `R` is isomorphic to the power
   series ring in `d` variables over its residue field.
2. If `k` is a field and `k → R` is a ring map inducing an isomorphism `k → R/𝔪`, then `R` is
   isomorphic as a `k`-algebra to the power series ring in `d` variables over `k`.
(Stacks 0C0S) -/
@[stacks 0C0S "The source's Noetherian complete local regular ring is `IsRegularLocalRing R` \
  with `IsAdicComplete (maximalIdeal R) R`. `R` contains `𝐅_p` or `𝐐` iff it contains a field, \
  which is how the first part is hypothesized; the number of variables is pinned to the \
  embedding dimension, the `d` of the source's proof. The two parts are the two conjuncts, \
  each guarded by its own hypothesis. See the module docstring.",
  ega "0 19.6.3" "a)⇒c), regular case",
  ega "0 19.6.5" "Â ≅ K[[T_1,...,T_n]]",
  ega "0 19.6.4" "special case",
  ega "0 19.8.8" "(i), special case"]
public theorem IsRegularLocalRing.nonempty_ringEquiv_and_algEquiv_mvPowerSeries (R : Type u)
    [CommRing R] [IsRegularLocalRing R] [IsAdicComplete (maximalIdeal R) R] (d : ℕ)
    (hd : Module.finrank (ResidueField R) (CotangentSpace R) = d) :
    (∀ (F : Type v) [Field F] [Algebra F R],
        Nonempty (R ≃+* MvPowerSeries (Fin d) (ResidueField R))) ∧
      (∀ (k : Type w) [Field k] [Algebra k R],
        Function.Bijective ((residue R).comp (algebraMap k R)) →
          Nonempty (R ≃ₐ[k] MvPowerSeries (Fin d) k)) :=
