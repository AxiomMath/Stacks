            Ideal.span (Set.range (fun i => (z i : MvPowerSeries (Fin n) Λ)))) ≃ₐ[Λ]
          MvPowerSeries (Fin (n - r)) Λ) := by
  -- (a) `r ≤ n`: the length-`(r+1)` sequence `(p, z_1,…,z_r)` has linearly independent
  --     cotangent images in the `(n+1)`-dimensional cotangent space
  --     (`finrank_cotangentSpace_cohen = n+1`), so `r + 1 ≤ n + 1`, i.e. `r ≤ n`.
  have hr : r ≤ n := by
    -- `LinearIndependent.fintype_card_le_finrank` on `Fin.cons p z` (card `r+1`) against
    -- `finrank = n+1`, then `omega`.
    have :
      Module.Finite (ResidueField (MvPowerSeries (Fin n) Λ))
        (CotangentSpace (MvPowerSeries (Fin n) Λ)) := by
      obtain ⟨bas⟩ := nonempty_basis_cotangentSpace_cohen (Λ := Λ) hΛ (n := n)
      exact Module.Finite.of_basis bas
    have hcard := hz.fintype_card_le_finrank
    rw [finrank_cotangentSpace_cohen hΛ, Fintype.card_fin] at hcard
    omega
  refine ⟨hr, ?_⟩
  -- (b) Extend `(p, z_1,…,z_r)` to a full RSOP `(p, z_1,…,z_r, w_1,…,w_{n-r})` (Cohen
  --     analogue of `extend_partial_rsop_field`), apply Statement (3) to identify `B` with
  --     `Λ[[Z_1,…,Z_r, W_1,…,W_{n-r}]]` (the `p` is the coefficient, the `Z,W` are the n
  --     `Y`-variables), then quotient by `(z_1,…,z_r)` via `quotient_initial_vars`
  --     to land in `Λ[[Y_1,…,Y_{n-r}]]`.
  -- SANITY CHECK PASSED
  classical
  classical
  obtain ⟨w, hrsp⟩ := extend_partial_rsop_cohen hΛ p z hz hr
  exact nonempty_quotient_algEquiv_of_algEquiv_X hr z w
    (exists_algEquiv_of_isRegularSystemOfParameters_cohen Λ hΛ n pr hunif p hp _ hrsp)
