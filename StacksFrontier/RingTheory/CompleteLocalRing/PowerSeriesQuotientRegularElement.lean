module

public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.RingTheory.KrullDimension.NonZeroDivisors
public import Mathlib.RingTheory.MvPowerSeries.Equiv
public import StacksFrontier.RingTheory.CohenMacaulay.Equidimensional
public import StacksFrontier.RingTheory.CohenMacaulay.RegularSequence
public import StacksFrontier.RingTheory.CompleteLocalRing.CohenStructureTheorem
public import StacksFrontier.RingTheory.KrullDimension.SystemOfParameters
public import StacksFrontier.RingTheory.MvPowerSeries.Noetherian
public import StacksFrontier.RingTheory.RegularLocalRing.Basic

/-!
# Quotients of power series rings over `ℤ_[ℓ]` by few relations

Let `P = ℤ_[ℓ][[x₁, …, x_d]]`, a regular local ring of dimension `d + 1`. If `f₁, …, f_r ∈ P`
with `r ≤ d` and `P/(f₁, …, f_r, ℓ)` is finite, then `f₁, …, f_r, ℓ` is a system of parameters
of the Cohen–Macaulay ring `P`, hence a regular sequence, and `ℓ` is a nonzerodivisor on
`P/(f₁, …, f_r)`. This is the commutative algebra in de Jong's proof that the universal
deformation ring is flat over `ℤ_[ℓ]`.

## Main results

* `MvPowerSeries.ringKrullDim_padicInt` — `dim ℤ_[ℓ][[x₁, …, x_d]] = d + 1`.
* `MvPowerSeries.isRegularLocalRing_padicInt` — it is a regular local ring.
* `mem_nonZeroDivisors_of_surjective_mvPowerSeries_padicInt`.
-/

@[expose] public noncomputable section

open IsLocalRing

namespace MvPowerSeries

variable (ℓ : ℕ) [Fact ℓ.Prime]

/-- `dim ℤ_[ℓ][[x₁, …, x_d]] ≥ d + 1`. -/
theorem ringKrullDim_padicInt_ge (d : ℕ) :
    ((d + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin d) ℤ_[ℓ]) := by
  induction d with
  | zero =>
    refine le_trans ?_ (ringKrullDim_le_of_surjective
      (MvPowerSeries.constantCoeff (σ := Fin 0) (R := ℤ_[ℓ]))
      fun c => ⟨MvPowerSeries.C c, by simp⟩)
    rw [IsDiscreteValuationRing.ringKrullDim_eq_one]
    rfl
  | succ d ih =>
    rw [ringKrullDim_eq_of_ringEquiv (finSuccEquiv ℤ_[ℓ] d).toRingEquiv]
    refine le_trans ?_ ringKrullDim_succ_le_ringKrullDim_powerseries
    have := add_le_add_left ih (1 : WithBot ℕ∞)
    refine le_trans (le_of_eq ?_) this
    push_cast
    rfl

/-- `ℤ_[ℓ][[x₁, …, x_d]]` is a regular local ring of dimension `d + 1`. -/
theorem isRegularLocalRing_padicInt_and_ringKrullDim (d : ℕ) :
    IsRegularLocalRing (MvPowerSeries (Fin d) ℤ_[ℓ]) ∧
      ringKrullDim (MvPowerSeries (Fin d) ℤ_[ℓ]) = ((d + 1 : ℕ) : WithBot ℕ∞) := by
  have := mvPowerSeries_fin_isNoetherianRing ℤ_[ℓ] d
  have hs : Ideal.span ((({(ℓ : ℤ_[ℓ])} : Finset ℤ_[ℓ])) : Set ℤ_[ℓ]) = maximalIdeal ℤ_[ℓ] := by
    simp [PadicInt.maximalIdeal_eq_span_p]
  have hle := Stacks.CompleteLocalRing.RegularSubring.spanFinrank_maximalIdeal_mvPowerSeries_le
    ℤ_[ℓ] d {(ℓ : ℤ_[ℓ])} hs
  rw [Finset.card_singleton, add_comm] at hle
  have hge := ringKrullDim_padicInt_ge ℓ d
  have hdim : ringKrullDim (MvPowerSeries (Fin d) ℤ_[ℓ]) = ((d + 1 : ℕ) : WithBot ℕ∞) := by
    refine le_antisymm ?_ hge
    refine (ringKrullDim_le_spanFinrank_maximalIdeal _).trans ?_
    exact_mod_cast hle
  refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, hdim⟩
  rw [hdim]
  exact_mod_cast hle

end MvPowerSeries

/-- **Regularity of `ℓ` on a quotient of `ℤ_[ℓ][[x₁, …, x_d]]` by at most `d` relations.** Let
`F : ℤ_[ℓ][[x₁, …, x_d]] → R` be a surjective ring map compatible with the `ℤ_[ℓ]`-algebra
structures, whose kernel is generated by `r ≤ d` elements, and assume `R/ℓR` is finite and
nonzero. Then `ℓ` is a nonzerodivisor on `R`. -/
theorem mem_nonZeroDivisors_of_surjective_mvPowerSeries_padicInt {ℓ : ℕ} [Fact ℓ.Prime]
    {R : Type*} [CommRing R] [Algebra ℤ_[ℓ] R] {d : ℕ}
    (F : MvPowerSeries (Fin d) ℤ_[ℓ] →+* R) (hF : Function.Surjective F)
    (hFC : ∀ c, F (MvPowerSeries.C c) = algebraMap ℤ_[ℓ] R c)
    (fs : List (MvPowerSeries (Fin d) ℤ_[ℓ]))
    (hker : RingHom.ker F = Ideal.ofList fs) (hr : fs.length ≤ d)
    (hfin : Finite (R ⧸ Ideal.span {algebraMap ℤ_[ℓ] R ℓ}))
    (hnt : Nontrivial (R ⧸ Ideal.span {algebraMap ℤ_[ℓ] R ℓ})) :
    algebraMap ℤ_[ℓ] R ℓ ∈ nonZeroDivisors R := by
  classical
  obtain ⟨hreg, hdim⟩ := MvPowerSeries.isRegularLocalRing_padicInt_and_ringKrullDim ℓ d
  have hCM :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      (MvPowerSeries (Fin d) ℤ_[ℓ])).2
  set p : MvPowerSeries (Fin d) ℤ_[ℓ] := MvPowerSeries.C (ℓ : ℤ_[ℓ])
  have hFp : F p = algebraMap ℤ_[ℓ] R ℓ := hFC _
  set xs := fs ++ [p]
  set I : Ideal R := Ideal.span {algebraMap ℤ_[ℓ] R ℓ}
  have hxsI : Ideal.ofList xs = I.comap F := by
    have : I = (Ideal.span {p}).map F := by
      rw [Ideal.map_span, Set.image_singleton, hFp]
    rw [this, Ideal.comap_map_of_surjective _ hF, ← RingHom.ker_eq_comap_bot, hker,
      Ideal.ofList_append, Ideal.ofList_singleton, sup_comm]
  have hItop : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.1 hnt
  have hxstop : Ideal.ofList xs ≠ ⊤ := by
    rw [hxsI]; exact fun h => hItop (Ideal.comap_eq_top_iff.1 h)
  have hxsm : Ideal.ofList xs ≤ maximalIdeal (MvPowerSeries (Fin d) ℤ_[ℓ]) := le_maximalIdeal hxstop
  have hfinxs : Finite (MvPowerSeries (Fin d) ℤ_[ℓ] ⧸ Ideal.ofList xs) := by
    have e : Ideal.ofList xs = I.comap F := hxsI
    rw [e]
    exact Finite.of_injective _ (Ideal.quotientMap_injective (I := I) (f := F))
  have hrad : (Ideal.ofList xs).radical = maximalIdeal (MvPowerSeries (Fin d) ℤ_[ℓ]) := by
    refine le_antisymm ((Ideal.IsPrime.radical_le_iff
      (maximalIdeal.isMaximal (MvPowerSeries (Fin d) ℤ_[ℓ])).isPrime).2 hxsm) ?_
    rw [Ideal.radical_eq_sInf]
    refine le_sInf fun Q ⟨hJQ, hQ⟩ => ?_
    have : IsArtinianRing (MvPowerSeries (Fin d) ℤ_[ℓ] ⧸ Ideal.ofList xs) := isArtinian_of_finite
    have hQ' : (Q.map (Ideal.Quotient.mk (Ideal.ofList xs))).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hJQ)
    have hmax := hQ'.isMaximal'
    have : (Q.map (Ideal.Quotient.mk (Ideal.ofList xs))).comap
        (Ideal.Quotient.mk (Ideal.ofList xs)) = Q := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
        Ideal.mk_ker, sup_eq_left.2 hJQ]
    have hQm : Q.IsMaximal := this ▸ Ideal.comap_isMaximal_of_surjective _
      Ideal.Quotient.mk_surjective
    exact (IsLocalRing.eq_maximalIdeal hQm).ge
  have hmem : ∀ x ∈ xs, x ∈ maximalIdeal (MvPowerSeries (Fin d) ℤ_[ℓ]) := fun x hx =>
    hxsm (Ideal.subset_span hx)
  have hlen : ((xs.length + ([] : List (MvPowerSeries (Fin d) ℤ_[ℓ])).length : ℕ) : WithBot ℕ∞) ≤
      ringKrullDim (MvPowerSeries (Fin d) ℤ_[ℓ]) := by
    rw [hdim]
    simp only [xs, List.length_append, List.length_singleton, List.length_nil, add_zero]
    exact_mod_cast Nat.succ_le_succ hr
  have h02IE := ringKrullDim_add_length_eq_ringKrullDim_of_radical_ofList_append_eq_maximalIdeal
    xs [] (by rwa [List.append_nil]) hlen
  have hregxs : RingTheory.Sequence.IsRegular (MvPowerSeries (Fin d) ℤ_[ℓ]) xs :=
    ((hCM.isRegular_iff_ringKrullDim_add_length_eq_ringKrullDim xs hmem).1).2 h02IE
  have hregp := ((isRegular_snoc_iff fs p).1 hregxs).2
  have hsmul : IsSMulRegular (MvPowerSeries (Fin d) ℤ_[ℓ] ⧸ Ideal.ofList fs •
      (⊤ : Submodule (MvPowerSeries (Fin d) ℤ_[ℓ]) (MvPowerSeries (Fin d) ℤ_[ℓ]))) p :=
    ((RingTheory.Sequence.isRegular_cons_iff _ _ _).1 hregp).1
  rw [mem_nonZeroDivisors_iff]
  refine ⟨fun y hy => ?_, fun y hy => ?_⟩
  all_goals
    obtain ⟨x, rfl⟩ := hF y
    have hpx : p * x ∈ Ideal.ofList fs := by
      rw [← hker, RingHom.mem_ker, map_mul, hFp]
      first | exact hy | (rw [mul_comm]; exact hy)
    have h1 : p • (Submodule.Quotient.mk x : MvPowerSeries (Fin d) ℤ_[ℓ] ⧸ Ideal.ofList fs •
        (⊤ : Submodule (MvPowerSeries (Fin d) ℤ_[ℓ]) (MvPowerSeries (Fin d) ℤ_[ℓ]))) =
        p • 0 := by
      rw [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
        Ideal.smul_eq_mul, Ideal.mul_top]
      exact hpx
    have h2 := hsmul h1
    rw [Submodule.Quotient.mk_eq_zero, Ideal.smul_eq_mul, Ideal.mul_top] at h2
    rw [← RingHom.mem_ker, hker]
    exact h2
