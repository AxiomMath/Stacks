module

public import StacksFrontier.RingTheory.CompleteLocalRing.Noetherian.LeadingTerm

/-!
# A complete local ring with finitely generated maximal ideal is Noetherian

This file builds the homogeneous leading-term ideal of an ideal `J` (`exists_leadingIdeal`),
extracts single-step data from finitely many homogeneous generators of it
(`leadingTerm_data_exists`), shows that an ideal with single-step data in a complete local ring is
finitely generated (`ideal_fg_of_adicComplete`), and concludes that a complete local ring with
finitely generated maximal ideal is Noetherian (`complete_local_ring_noetherian`).

## References

* [Stacks Project, Tag 032B](https://stacks.math.columbia.edu/tag/032B)
-/

@[expose] public section

open IsLocalRing

attribute [local instance] MvPolynomial.gradedAlgebra

/-- `c * f` as the sum over the monomials of `c` of (monomial) `* f`. -/
private theorem mul_eq_sum_monomial_mul {σ K : Type*} [CommSemiring K] (c f : MvPolynomial σ K) :
    c * f = ∑ β ∈ c.support, MvPolynomial.monomial β (c.coeff β) * f := by
  conv_lhs => rw [c.as_sum]; rw [Finset.sum_mul]

/-- A homogeneous polynomial of degree `n` is in `leadingMem` once its representative is
in `(m ^ n ⊓ J) ⊔ m ^ (n + 1)`. -/
private theorem leadingMem_of_isHomogeneous (R : Type*) [CommRing R] [IsLocalRing R] {t n : ℕ}
    (ω : Fin t → R) (J : Ideal R) {f : MvPolynomial (Fin t) (IsLocalRing.ResidueField R)}
    (hf : f.IsHomogeneous n)
    (h : reprMap R ω f
      ∈ (IsLocalRing.maximalIdeal R ^ n ⊓ J) ⊔ IsLocalRing.maximalIdeal R ^ (n + 1)) :
    leadingMem R ω J f := by
  intro k
  rw [MvPolynomial.homogeneousComponent_of_mem ((MvPolynomial.mem_homogeneousSubmodule n f).mpr hf)]
  split_ifs with hk
  · subst hk; exact h
  · have := leadingMem_zero R ω J k
    rwa [map_zero] at this

/-- For a finitely generated maximal ideal `m = span (range ω)` and an ideal `J`, there is a
homogeneous ideal `𝓛` of `S = MvPolynomial (Fin t) (ResidueField R)` with
`f ∈ 𝓛 ↔ leadingMem R ω J f`. -/
theorem exists_leadingIdeal
    (R : Type*) [CommRing R] [IsLocalRing R]
    {t : ℕ} (ω : Fin t → R)
    (hω : IsLocalRing.maximalIdeal R = Ideal.span (Set.range ω))
    (J : Ideal R) :
    ∃ 𝓛 : Ideal (MvPolynomial (Fin t) (IsLocalRing.ResidueField R)),
      𝓛.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin t) (IsLocalRing.ResidueField R)) ∧
      ∀ f, f ∈ 𝓛 ↔ leadingMem R ω J f := by
  classical
  have hsmul : ∀ (c f : MvPolynomial (Fin t) (IsLocalRing.ResidueField R)),
      leadingMem R ω J f → leadingMem R ω J (c * f) := by
    intro c f hf
    rw [mul_eq_sum_monomial_mul]
    exact Finset.sum_induction _ (leadingMem R ω J)
      (fun a b ha hb => leadingMem_add R ω hω J a b ha hb) (leadingMem_zero R ω J)
      fun β _ => leadingMem_monomial_mul R ω hω J β (c.coeff β) f hf
  let 𝓛 : Ideal (MvPolynomial (Fin t) (IsLocalRing.ResidueField R)) :=
  { carrier := {f | leadingMem R ω J f}
    add_mem' := fun {a b} ha hb => leadingMem_add R ω hω J a b ha hb
    zero_mem' := leadingMem_zero R ω J
    smul_mem' := fun c {f} hf => hsmul c f hf }
  refine ⟨𝓛, ?_, fun f => Iff.rfl⟩
  intro i f hf
  change leadingMem R ω J _
  exact (congrArg (leadingMem R ω J) (MvPolynomial.decomposition.decompose'_apply f i)).mpr
    (leadingMem_of_isHomogeneous R ω J (MvPolynomial.homogeneousComponent_isHomogeneous i f) (hf i))

/-- A homogeneous ideal `𝓛` of `S = MvPolynomial (Fin t) (ResidueField R)` is generated by
finitely many homogeneous elements `g i`, each of an explicit degree `d i`. -/
theorem homogeneous_ideal_fg_gens
    (R : Type*) [CommRing R] [IsLocalRing R]
    {t : ℕ}
    (𝓛 : Ideal (MvPolynomial (Fin t) (IsLocalRing.ResidueField R)))
    (hhom : 𝓛.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) (IsLocalRing.ResidueField R))) :
    ∃ (r : ℕ) (g : Fin r → MvPolynomial (Fin t) (IsLocalRing.ResidueField R)) (d : Fin r → ℕ),
      (∀ i, g i ∈ MvPolynomial.homogeneousSubmodule (Fin t) (IsLocalRing.ResidueField R) (d i)) ∧
      𝓛 = Ideal.span (Set.range g) := by
  have : IsNoetherianRing (MvPolynomial (Fin t) (IsLocalRing.ResidueField R)) :=
    MvPolynomial.isNoetherianRing_fin
  classical
  set S := MvPolynomial (Fin t) (IsLocalRing.ResidueField R) with hS
  set 𝒜 := MvPolynomial.homogeneousSubmodule (Fin t) (IsLocalRing.ResidueField R) with h𝒜
  obtain ⟨s, hs⟩ := (isNoetherianRing_iff_ideal_fg S).mp ‹IsNoetherianRing S› 𝓛
  set T : Finset (ℕ × S) :=
    s.biUnion (fun p => (Finset.range (p.totalDegree + 1)).image
      (fun n => (n, MvPolynomial.homogeneousComponent n p))) with hT
  have hcomp_mem : ∀ p ∈ s, ∀ n : ℕ, MvPolynomial.homogeneousComponent n p ∈ 𝓛 := by
    intro p hp n
    exact MvPolynomial.homogeneousComponent_mem_of_mem hhom (hs ▸ Ideal.subset_span hp) n
  have hT_hom : ∀ x ∈ T, x.snd ∈ 𝒜 x.fst := by
    intro x hx
    rw [hT, Finset.mem_biUnion] at hx
    obtain ⟨p, _, hx2⟩ := hx
    rw [Finset.mem_image] at hx2
    obtain ⟨n, _, rfl⟩ := hx2
    rw [h𝒜, MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.homogeneousComponent_isHomogeneous n p
  have hT_mem : ∀ x ∈ T, x.snd ∈ 𝓛 := by
    intro x hx
    rw [hT, Finset.mem_biUnion] at hx
    obtain ⟨p, hp, hx2⟩ := hx
    rw [Finset.mem_image] at hx2
    obtain ⟨n, _, rfl⟩ := hx2
    exact hcomp_mem p hp n
  refine ⟨T.card, fun i => (T.equivFin.symm i).val.snd,
    fun i => (T.equivFin.symm i).val.fst, ?_, ?_⟩
  · exact fun i ↦ hT_hom _ (T.equivFin.symm i).property
  · have hrange :
        Set.range (fun i : Fin T.card => ((T.equivFin.symm i : {x // x ∈ T}) : ℕ × S).snd)
          = (fun x : ℕ × S => x.snd) '' (T : Set (ℕ × S)) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨(T.equivFin.symm i : {x // x ∈ T}), (T.equivFin.symm i).property, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact ⟨T.equivFin ⟨x, hx⟩, by simp⟩
    rw [hrange]
    apply le_antisymm
    · rw [← hs, Ideal.span_le]
      intro p hp
      rw [SetLike.mem_coe, ← MvPolynomial.sum_homogeneousComponent p]
      refine Ideal.sum_mem _ fun n hn => Ideal.subset_span ?_
      refine ⟨(n, MvPolynomial.homogeneousComponent n p), ?_, rfl⟩
      rw [Finset.mem_coe, hT, Finset.mem_biUnion]
      exact ⟨p, hp, Finset.mem_image.mpr ⟨n, hn, rfl⟩⟩
    · exact Ideal.span_le.mpr (Set.image_subset_iff.mpr hT_mem)

/-- The degree-`n` component of `p * g`, for `g` homogeneous of degree `D`. -/
private theorem homogeneousComponent_mul_of_isHomogeneous {K : Type*} [CommRing K] {t D : ℕ}
    {g : MvPolynomial (Fin t) K} (hg : g.IsHomogeneous D) (n : ℕ) (p : MvPolynomial (Fin t) K) :
    MvPolynomial.homogeneousComponent n (p * g)
      = if D ≤ n then MvPolynomial.homogeneousComponent (n - D) p * g else 0 := by
  classical
  ext γ
  rw [MvPolynomial.coeff_homogeneousComponent,
    apply_ite (fun q : MvPolynomial (Fin t) K => q.coeff γ),
    AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply, MvPolynomial.coeff_mul]
  have hterm : ∀ x ∈ Finset.antidiagonal γ,
      (if γ.degree = n then p.coeff x.1 * g.coeff x.2 else 0)
        = if D ≤ n then (MvPolynomial.homogeneousComponent (n - D) p).coeff x.1
          * g.coeff x.2 else 0 := by
    rintro ⟨α, β⟩ hx
    have hadd := map_add Finsupp.degree α β
    rw [Finset.mem_antidiagonal.mp hx] at hadd
    by_cases hβ : β.degree = D
    · rw [MvPolynomial.coeff_homogeneousComponent]
      by_cases hD : D ≤ n
      · have : α.degree = n - D ↔ γ.degree = n := by omega
        simp only [hD, ite_true, ite_mul, zero_mul, this]
      · have : γ.degree ≠ n := by omega
        simp [hD, this]
    · simp [hg.coeff_eq_zero hβ]
  rw [MvPolynomial.coeff_mul]
  have := Finset.sum_congr rfl hterm
  simp only [Finset.sum_ite_irrel, Finset.sum_const_zero] at this
  exact this

/-- If the homogeneous elements `g i` of degrees `d i` generate an ideal `𝓛` with
`f ∈ 𝓛 ↔ leadingMem R ω J f`, then `J` admits single-step data `SingleStep R J a d`. -/
theorem singleStep_of_leadingData
    (R : Type*) [CommRing R] [IsLocalRing R]
    {t : ℕ} (ω : Fin t → R)
    (hω : IsLocalRing.maximalIdeal R = Ideal.span (Set.range ω))
    (J : Ideal R)
    (𝓛 : Ideal (MvPolynomial (Fin t) (IsLocalRing.ResidueField R)))
    (hchar : ∀ f, f ∈ 𝓛 ↔ leadingMem R ω J f)
    {r : ℕ} (g : Fin r → MvPolynomial (Fin t) (IsLocalRing.ResidueField R)) (d : Fin r → ℕ)
    (hg : ∀ i, g i ∈ MvPolynomial.homogeneousSubmodule (Fin t) (IsLocalRing.ResidueField R) (d i))
    (hspan : 𝓛 = Ideal.span (Set.range g)) :
    ∃ (r : ℕ) (a : Fin r → R) (d : Fin r → ℕ), SingleStep R J a d := by
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  have reprMap_homog_mem : ∀ {h : MvPolynomial (Fin t) (IsLocalRing.ResidueField R)} {k : ℕ},
      h.IsHomogeneous k → reprMap R ω h ∈ m ^ k := by
    intro h k hh
    refine Ideal.sum_mem _ fun α hα => hm ▸ Ideal.mul_mem_left _ _ ?_
    rw [← sum_eq_of_isHomogeneous_of_mem_support R hh hα]
    exact prod_pow_mem_maximalIdeal_pow R ω hω α
  have hghom : ∀ i, (g i).IsHomogeneous (d i) := by
    intro i
    rw [← MvPolynomial.mem_homogeneousSubmodule]
    exact hg i
  have hlift : ∀ i, ∃ ai : R, ai ∈ m ^ (d i) ⊓ J ∧ reprMap R ω (g i) - ai ∈ m ^ (d i + 1) := by
    intro i
    have hgi𝓛 : g i ∈ 𝓛 := by
      rw [hspan]; exact Ideal.subset_span ⟨i, rfl⟩
    have hlm : leadingMem R ω J (g i) := (hchar (g i)).mp hgi𝓛
    have hcomp := MvPolynomial.homogeneousComponent_eq_self (hghom i)
    have := hlm (d i)
    rw [hcomp] at this
    rw [Submodule.mem_sup] at this
    obtain ⟨y, hy, z, hz, hyz⟩ := this
    refine ⟨y, hy, ?_⟩
    rw [← hyz]
    have : y + z - y = z := by ring
    rw [this]; exact hz
  choose a ha using hlift
  refine ⟨r, a, d, ?_, ?_, ?_⟩
  · intro i; exact (Submodule.mem_inf.mp (ha i).left).right
  · intro i; exact (Submodule.mem_inf.mp (ha i).left).left
  · intro n x hx hxJ
    have hxmn : x ∈ m ^ n := hx
    rw [pow_maximalIdeal_eq_span_monomials R ω hω n] at hx
    obtain ⟨cc, hcc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hx
    set f : MvPolynomial (Fin t) (IsLocalRing.ResidueField R) :=
      ∑ e ∈ cc.support, MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm e.val)
        (IsLocalRing.residue R (cc e)) with hf
    set γ : {e : Fin t → ℕ // ∑ j, e j = n} → (Fin t →₀ ℕ) :=
      fun e => Finsupp.equivFunOnFinite.symm e.val with hγ
    have hγdeg : ∀ e : {e : Fin t → ℕ // ∑ j, e j = n}, ∑ j, (γ e) j = n := by
      intro e
      have : ∀ j, (γ e) j = e.val j := fun j => by rw [hγ]; rfl
      rw [show (∑ j, (γ e) j) = ∑ j, e.val j from Finset.sum_congr rfl (fun j _ => this j)]
      exact e.property
    have hγinj : Set.InjOn γ cc.support := by
      intro e1 _ e2 _ h
      rw [hγ] at h
      have : e1.val = e2.val := by
        have := congrArg Finsupp.equivFunOnFinite h
        simpa using this
      exact Subtype.ext this
    have hfhom : f.IsHomogeneous n := by
      rw [hf]
      apply MvPolynomial.IsHomogeneous.sum
      intro e _
      have hde : (γ e).degree = n := by rw [Finsupp.degree_eq_sum]; exact hγdeg e
      exact MvPolynomial.isHomogeneous_monomial _ hde
    have hcoeff : ∀ e₀ ∈ cc.support,
        f.coeff (γ e₀) = IsLocalRing.residue R (cc e₀) := by
      intro e₀ he₀
      rw [hf, MvPolynomial.coeff_sum]
      rw [Finset.sum_eq_single e₀]
      · rw [MvPolynomial.coeff_monomial, ite_eq_left rfl]
      · intro e' he' hne
        rw [MvPolynomial.coeff_monomial, ite_eq_right]
        intro hcon
        exact hne (hγinj he' he₀ hcon)
      · intro h; exact absurd he₀ h
    have hωγ : ∀ e : {e : Fin t → ℕ // ∑ j, e j = n},
        (∏ j, ω j ^ ((γ e) j)) = ∏ j, ω j ^ (e.val j) := by
      intro e
      apply Finset.prod_congr rfl
      intro j _
      rw [hγ]; rfl
    set s : Finset (Fin t →₀ ℕ) := Finset.image γ cc.support with hs
    have hsdeg : ∀ α ∈ s, ∑ j, α j = n := by
      intro α hα
      rw [hs, Finset.mem_image] at hα
      obtain ⟨e, _, rfl⟩ := hα
      exact hγdeg e
    have hfsub : f.support ⊆ s := by
      rw [hf]
      apply Finset.Subset.trans MvPolynomial.support_sum
      refine Finset.biUnion_subset.mpr fun e he =>
        MvPolynomial.support_monomial_subset.trans fun α hα => ?_
      rw [Finset.mem_singleton] at hα
      rw [hs, Finset.mem_image]
      exact ⟨e, he, hα.symm⟩
    have e1 := reprMap_eq_sum_on R ω hω f s hfsub hsdeg
    have hsum_s : (∑ α ∈ s, residueSection R (f.coeff α) * ∏ j, ω j ^ (α j))
        = ∑ e ∈ cc.support, residueSection R (IsLocalRing.residue R (cc e))
            * ∏ j, ω j ^ (e.val j) := by
      rw [hs, Finset.sum_image hγinj]
      exact Finset.sum_congr rfl fun e he => by rw [hcoeff e he, hωγ e]
    rw [hsum_s] at e1
    have hxsum : x = ∑ e ∈ cc.support, cc e * ∏ j, ω j ^ (e.val j) := by
      rw [← hcc, Finsupp.sum]
      apply Finset.sum_congr rfl
      intro e _; rw [smul_eq_mul]
    have hxdiff : (∑ e ∈ cc.support, residueSection R (IsLocalRing.residue R (cc e))
          * ∏ j, ω j ^ (e.val j)) - x
        ∈ m ^ (n + 1) := by
      rw [hxsum, ← Finset.sum_sub_distrib]
      refine Ideal.sum_mem _ fun e he ↦ ?_
      rw [← sub_mul, pow_succ', hm]
      apply Ideal.mul_mem_mul
      · rw [sub_mem_maximalIdeal_iff_residue_eq, residue_residueSection]
      · have hp := prod_pow_mem_maximalIdeal_pow R ω hω (Finsupp.equivFunOnFinite.symm e.val)
        rw [show (∑ j, (Finsupp.equivFunOnFinite.symm e.val) j) = n from by
          rw [show (∑ j, (Finsupp.equivFunOnFinite.symm e.val) j) = ∑ j, e.val j from
            Finset.sum_congr rfl (fun j _ => by rfl)]; exact e.property] at hp
        rw [show (∏ j, ω j ^ (e.val j)) = ∏ j, ω j ^ ((Finsupp.equivFunOnFinite.symm e.val) j) from
          Finset.prod_congr rfl (fun j _ => by rfl)]
        exact hp
    have hreprx : reprMap R ω f - x ∈ m ^ (n + 1) := by
      have : reprMap R ω f - x
          = (reprMap R ω f - ∑ e ∈ cc.support, residueSection R (IsLocalRing.residue R (cc e))
              * ∏ j, ω j ^ (e.val j))
            + ((∑ e ∈ cc.support, residueSection R (IsLocalRing.residue R (cc e))
                * ∏ j, ω j ^ (e.val j)) - x) := by ring
      rw [this]
      exact Ideal.add_mem _ e1 hxdiff
    have hflead : leadingMem R ω J f :=
      leadingMem_of_isHomogeneous R ω J hfhom
        (Submodule.mem_sup.mpr ⟨x, Submodule.mem_inf.mpr ⟨hxmn, hxJ⟩, _, hreprx, by ring⟩)
    have hf𝓛 : f ∈ 𝓛 := (hchar f).mpr hflead
    have reprMap_mul_homog : ∀ {e D : ℕ} (u v : MvPolynomial (Fin t) (IsLocalRing.ResidueField R)),
        u.IsHomogeneous e → v.IsHomogeneous D →
        reprMap R ω (u * v) - reprMap R ω u * reprMap R ω v ∈ m ^ (e + D + 1) := by
      intro e D u v hu hv
      classical
      rw [mul_eq_sum_monomial_mul u v]
      have hterm : ∀ β ∈ u.support,
          (MvPolynomial.monomial β (u.coeff β) * v).IsHomogeneous (e + D) := by
        intro β hβ
        have hβdeg : β.degree = e := by
          rw [Finsupp.degree_eq_sum]; exact sum_eq_of_isHomogeneous_of_mem_support R hu hβ
        exact (MvPolynomial.isHomogeneous_monomial _ hβdeg).mul hv
      have hsplit := reprMap_sum_defect R ω hω u.support
        (fun β => MvPolynomial.monomial β (u.coeff β) * v) hterm
      have hpart : (∑ β ∈ u.support,
            reprMap R ω (MvPolynomial.monomial β (u.coeff β) * v))
          - reprMap R ω u * reprMap R ω v ∈ m ^ (e + D + 1) := by
        have hru : reprMap R ω u * reprMap R ω v
            = ∑ β ∈ u.support, residueSection R (u.coeff β) * (∏ j, ω j ^ (β j))
              * reprMap R ω v := by
          rw [reprMap, Finset.sum_mul]
        rw [hru, ← Finset.sum_sub_distrib]
        apply Ideal.sum_mem
        intro β hβ
        have hβdeg : ∑ j, β j = e := sum_eq_of_isHomogeneous_of_mem_support R hu hβ
        exact reprMap_monomial_mul R ω hω β hβdeg (u.coeff β) v hv
      have key : reprMap R ω (∑ β ∈ u.support, MvPolynomial.monomial β (u.coeff β) * v)
          - reprMap R ω u * reprMap R ω v
          = (reprMap R ω (∑ β ∈ u.support, MvPolynomial.monomial β (u.coeff β) * v)
              - ∑ β ∈ u.support, reprMap R ω (MvPolynomial.monomial β (u.coeff β) * v))
            + ((∑ β ∈ u.support, reprMap R ω (MvPolynomial.monomial β (u.coeff β) * v))
                - reprMap R ω u * reprMap R ω v) := by ring
      rw [key]
      exact Ideal.add_mem _ hsplit hpart
    rw [hspan, Ideal.mem_span_range_iff_exists_fun] at hf𝓛
    obtain ⟨p, hp⟩ := hf𝓛
    set q : Fin r → MvPolynomial (Fin t) (IsLocalRing.ResidueField R) :=
      fun i => if d i ≤ n then MvPolynomial.homogeneousComponent (n - d i) (p i) else 0 with hq
    set c : Fin r → R := fun i => reprMap R ω (q i) with hc
    have hqhom : ∀ i, (q i).IsHomogeneous (n - d i) := by
      intro i
      rw [hq]; simp only
      by_cases hle : d i ≤ n
      · rw [ite_eq_left hle]; exact MvPolynomial.homogeneousComponent_isHomogeneous _ _
      · rw [ite_eq_right hle]
        rw [show n - d i = 0 from by omega]
        exact MvPolynomial.isHomogeneous_zero _ _ _
    have hci : ∀ i, c i ∈ m ^ (n - d i) := by
      intro i; rw [hc]; exact reprMap_homog_mem (hqhom i)
    have hfsum : f = ∑ i, q i * g i := by
      have h1 := MvPolynomial.homogeneousComponent_eq_self hfhom
      rw [← h1, ← hp, map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [homogeneousComponent_mul_of_isHomogeneous (hghom i) n (p i)]
      simp only [hq]
      split_ifs <;> simp
    refine ⟨c, hci, ?_⟩
    have hsumdef_r : reprMap R ω (∑ i, q i * g i) - ∑ i, reprMap R ω (q i * g i) ∈ m ^ (n + 1) := by
      have hPhom : ∀ i ∈ (Finset.univ : Finset (Fin r)), (q i * g i).IsHomogeneous n := by
        intro i _
        have := (hqhom i).mul (hghom i)
        by_cases hle : d i ≤ n
        · rwa [show n - d i + d i = n from by omega] at this
        · have hq0 : q i = 0 := by rw [hq]; simp only; rw [ite_eq_right hle]
          rw [hq0, zero_mul]; exact MvPolynomial.isHomogeneous_zero _ _ _
      exact reprMap_sum_defect R ω hω Finset.univ _ hPhom
    have hterm3 : ∀ i, reprMap R ω (q i * g i) - c i * a i ∈ m ^ (n + 1) := by
      intro i
      by_cases hle : d i ≤ n
      · have hmul := reprMap_mul_homog (q i) (g i) (hqhom i) (hghom i)
        rw [show (n - d i) + d i + 1 = n + 1 from by omega] at hmul
        have hcq : reprMap R ω (q i) = c i := by rw [hc]
        have hstar : reprMap R ω (g i) - a i ∈ m ^ (d i + 1) := (ha i).right
        have habsorb : c i * (reprMap R ω (g i) - a i) ∈ m ^ (n + 1) := by
          rw [show n + 1 = (n - d i) + (d i + 1) from by omega, pow_add]
          exact Ideal.mul_mem_mul (hci i) hstar
        have key : reprMap R ω (q i * g i) - c i * a i
            = (reprMap R ω (q i * g i) - reprMap R ω (q i) * reprMap R ω (g i))
              + c i * (reprMap R ω (g i) - a i) := by
          rw [hcq]; ring
        rw [key]
        exact Ideal.add_mem _ hmul habsorb
      · have hq0 : q i = 0 := by rw [hq]; simp only; rw [ite_eq_right hle]
        have hc0 : c i = 0 := by rw [hc]; simp only; rw [hq0, reprMap]; simp
        rw [hq0, zero_mul, hc0, zero_mul, sub_zero, reprMap]
        simp only [MvPolynomial.support_zero, Finset.sum_empty]
        exact Submodule.zero_mem _
    have hcombine : x - ∑ i, c i * a i
        = (x - reprMap R ω f)
          + (reprMap R ω f - ∑ i, reprMap R ω (q i * g i))
          + (∑ i, (reprMap R ω (q i * g i) - c i * a i)) := by
      rw [Finset.sum_sub_distrib]; ring
    rw [hcombine]
    apply Ideal.add_mem
    · apply Ideal.add_mem
      · have : x - reprMap R ω f = -(reprMap R ω f - x) := by ring
        rw [this]; exact neg_mem hreprx
      · rw [hfsum]; exact hsumdef_r
    · exact Ideal.sum_mem _ (fun i _ => hterm3 i)

/-- If `ω : Fin t → R` generates the maximal ideal, every ideal `J` admits single-step data
`SingleStep R J a d`. -/
theorem singleStep_data_of_fg_generators
    (R : Type*) [CommRing R] [IsLocalRing R]
    {t : ℕ} (ω : Fin t → R)
    (hω : IsLocalRing.maximalIdeal R = Ideal.span (Set.range ω))
    (J : Ideal R) :
    ∃ (r : ℕ) (a : Fin r → R) (d : Fin r → ℕ), SingleStep R J a d := by
  classical
  obtain ⟨𝓛, hhom, hchar⟩ := exists_leadingIdeal R ω hω J
  obtain ⟨r, g, d, hg, hspan⟩ := homogeneous_ideal_fg_gens R 𝓛 hhom
  exact singleStep_of_leadingData R ω hω J 𝓛 hchar g d hg hspan

/-- For a local ring `R` with finitely generated maximal ideal, every ideal `J` admits
single-step data `SingleStep R J a d`. -/
theorem leadingTerm_data_exists
    (R : Type*) [CommRing R] [IsLocalRing R]
    (hfg : (IsLocalRing.maximalIdeal R).FG) (J : Ideal R) :
    ∃ (r : ℕ) (a : Fin r → R) (d : Fin r → ℕ), SingleStep R J a d := by
  classical
  obtain ⟨s, hs⟩ := hfg
  refine singleStep_data_of_fg_generators R
    (fun i : Fin s.card => ((s.equivFin.symm i : {x // x ∈ s}) : R)) ?_ J
  have hrange : Set.range (fun i : Fin s.card => ((s.equivFin.symm i : {x // x ∈ s}) : R))
      = ↑s := by
    ext x
    simp only [Set.mem_range]
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).property
    · intro hx
      exact ⟨s.equivFin ⟨x, hx⟩, by simp⟩
  rw [hrange, hs]

/-- If an ideal `J` admits single-step data `SingleStep R J a d` and `R` is `m`-adically
complete, then `J` is finitely generated. -/
theorem ideal_fg_of_adicComplete
    (R : Type*) [CommRing R] [IsLocalRing R]
    (hcomplete : IsAdicComplete (IsLocalRing.maximalIdeal R) R)
    {J : Ideal R} {r : ℕ} {a : Fin r → R} {d : Fin r → ℕ}
    (hstep : SingleStep R J a d) :
    J.FG := by
  classical
  obtain ⟨haJ, haDeg, hstep⟩ := hstep
  refine ⟨Finset.image a Finset.univ, ?_⟩
  set m := IsLocalRing.maximalIdeal R with hm
  rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  refine le_antisymm (Ideal.span_le.mpr (Set.range_subset_iff.mpr haJ)) fun x hxJ ↦ ?_
  let rem : (n : ℕ) → {y : R // y ∈ (m ^ n : Ideal R) ∧ y ∈ J} :=
    fun n => Nat.rec
      (⟨x, by simp, hxJ⟩)
      (fun n p =>
        ⟨(p.val : R)
            - ∑ i, (Classical.choose (hstep n p.val p.property.left p.property.right)) i * a i,
          (Classical.choose_spec (hstep n p.val p.property.left p.property.right)).right,
          J.sub_mem p.property.right
            (Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (haJ i)))⟩)
      n
  let C : ℕ → Fin r → R :=
    fun n => Classical.choose (hstep n (rem n).val (rem n).property.left (rem n).property.right)
  have hC_pow : ∀ n i, C n i ∈ (m ^ (n - d i) : Ideal R) := fun n =>
    (Classical.choose_spec
      (hstep n (rem n).val (rem n).property.left (rem n).property.right)).left
  have hrem_succ : ∀ n, (rem (n + 1)).val = (rem n).val - ∑ i, C n i * a i := fun n => rfl
  have hrem0 : (rem 0).val = x := rfl
  have hrem_pow : ∀ n, (rem n).val ∈ (m ^ n : Ideal R) := fun n => (rem n).property.left
  have hTel : ∀ N : ℕ, x - ∑ n ∈ Finset.range N, ∑ i, C n i * a i = (rem N).val := by
    intro N
    induction N with
    | zero => simp [hrem0]
    | succ N ih => rw [Finset.sum_range_succ, hrem_succ N, ← ih]; ring
  let S : ℕ → Fin r → R := fun N i => ∑ n ∈ Finset.range N, C n i
  have hShiftCauchy : ∀ (i : Fin r) {p q : ℕ}, p ≤ q →
      S (p + d i) i - S (q + d i) i ∈ (m ^ p : Ideal R) := by
    intro i p q hpq
    have hle : p + d i ≤ q + d i := by omega
    have hdiff : S (q + d i) i - S (p + d i) i
        = ∑ n ∈ Finset.Ico (p + d i) (q + d i), C n i := by
      simp only [S]; rw [eq_comm, Finset.sum_Ico_eq_sub _ hle]
    have hmem : (∑ n ∈ Finset.Ico (p + d i) (q + d i), C n i) ∈ (m ^ p : Ideal R) := by
      refine Ideal.sum_mem _ fun n hn => ?_
      rw [Finset.mem_Ico] at hn
      have hpn : p ≤ n - d i := by omega
      exact (Ideal.pow_le_pow_right hpn) (hC_pow n i)
    rw [← neg_sub, hdiff]
    exact neg_mem hmem
  have hlimexists : ∀ i : Fin r, ∃ L : R, ∀ n : ℕ,
      S (n + d i) i - L ∈ (m ^ n : Ideal R) := by
    intro i
    obtain ⟨L, hL⟩ := hcomplete.toIsPrecomplete.prec' (fun k => S (k + d i) i)
      fun {p q} hpq => by
        rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
        exact hShiftCauchy i hpq
    refine ⟨L, fun n => ?_⟩
    simpa only [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using hL n
  choose c hc using hlimexists
  have hterm : ∀ N i, (S N i - c i) * a i ∈ (m ^ N : Ideal R) := by
    intro N i
    by_cases hN : d i ≤ N
    · have h1 : S N i - c i ∈ (m ^ (N - d i) : Ideal R) := by
        have hci := hc i (N - d i); rwa [Nat.sub_add_cancel hN] at hci
      have hmul : (S N i - c i) * a i ∈ (m ^ (N - d i) * m ^ (d i) : Ideal R) :=
        Ideal.mul_mem_mul h1 (haDeg i)
      have hpow : (m ^ (N - d i) * m ^ (d i) : Ideal R) = m ^ N := by
        rw [← pow_add, Nat.sub_add_cancel hN]
      rwa [hpow] at hmul
    · have hle : N ≤ d i := by omega
      have hai : a i ∈ (m ^ N : Ideal R) := (Ideal.pow_le_pow_right hle) (haDeg i)
      exact Ideal.mul_mem_left _ _ hai
  have hsumcomm : ∀ N, (∑ n ∈ Finset.range N, ∑ i, C n i * a i) = ∑ i, (S N i) * a i := by
    intro N
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    simp only [S, Finset.sum_mul]
  have hfinal : ∀ N : ℕ, x - ∑ i, c i * a i ∈ (m ^ N : Ideal R) := by
    intro N
    have h1 := hTel N
    rw [hsumcomm N] at h1
    have key : x - ∑ i, c i * a i = (rem N).val + ∑ i, (S N i - c i) * a i := by
      have expand : ∑ i, (S N i - c i) * a i = (∑ i, S N i * a i) - ∑ i, c i * a i := by
        rw [← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl; intro i _; ring
      rw [expand, ← h1]; ring
    rw [key]
    exact Ideal.add_mem _ (hrem_pow N) (Ideal.sum_mem _ (fun i _ => hterm N i))
  have hzero : x - ∑ i, c i * a i = 0 := by
    refine hcomplete.toIsHausdorff.haus _ fun n => ?_
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, sub_zero]
    exact hfinal n
  rw [sub_eq_zero.mp hzero]
  exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))

/-- A local ring `R` that is complete for its maximal-ideal-adic topology and whose maximal
ideal is finitely generated is Noetherian. -/
@[stacks 032B, ega "0 7.2.6" "special case", ega "I 10.6.4" "special case"]
theorem complete_local_ring_noetherian
    (R : Type*) [CommRing R] [IsLocalRing R]
    (hcomplete : IsAdicComplete (IsLocalRing.maximalIdeal R) R)
    (hfg : (IsLocalRing.maximalIdeal R).FG) :
    IsNoetherianRing R := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro J
  obtain ⟨r, a, d, hstep⟩ := leadingTerm_data_exists R hfg J
  exact ideal_fg_of_adicComplete R hcomplete hstep
