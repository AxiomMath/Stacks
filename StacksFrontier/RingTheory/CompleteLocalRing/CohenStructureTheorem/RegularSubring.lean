* [StacksProject 00KW](https://stacks.math.columbia.edu/tag/00KW)
-/

namespace Stacks.CompleteLocalRing.RegularSubring

open IsLocalRing

/-! ### Finiteness and injectivity -/

/-- **The `𝔪`-adic filtration of a Noetherian local ring is finite over a subring surjecting onto
the residue field.** If `S → R` induces a surjection on residue fields and `R` is Noetherian local,
then for every `j` there is a finite subset `A ⊆ R` with `R = S·A + 𝔪 ^ j`: a generating set of the
ideal `𝔪 ^ j` may be corrected by elements of `S` modulo `𝔪 ^ (j + 1)`. -/
private theorem exists_finset_top_le_span_sup_restrictScalars_pow {S R : Type*} [CommRing S]
    [CommRing R] [Algebra S R] [IsNoetherianRing R] [IsLocalRing R]
    (hres : Function.Surjective ((residue R).comp (algebraMap S R))) (j : ℕ) :
    ∃ A : Finset R, (⊤ : Submodule S R) ≤
      Submodule.span S (A : Set R) ⊔ (maximalIdeal R ^ j).restrictScalars S := by
  classical
  induction j with
  | zero => exact ⟨∅, by simp⟩
  | succ j ih =>
    obtain ⟨A, hA⟩ := ih
    obtain ⟨G, hG⟩ := (IsNoetherian.noetherian (maximalIdeal R ^ j) : (maximalIdeal R ^ j).FG)
    refine ⟨A ∪ G, ?_⟩
    have hstep : (maximalIdeal R ^ j).restrictScalars S ≤
        Submodule.span S (G : Set R) ⊔ (maximalIdeal R ^ (j + 1)).restrictScalars S := by
      intro z hz
      have hz' : z ∈ Submodule.span R (G : Set R) := by rwa [hG]
      obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1 hz'
      choose t ht using
        Stacks.Etale.PrincipalPowerIso.exists_sub_mem_maximalIdeal_of_surjective_residue_comp
          (algebraMap S R) hres
      have key : z = (∑ g ∈ G, (t (c g)) • g)
          + ∑ g ∈ G, (c g - algebraMap S R (t (c g))) * g := by
        rw [← hc, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun g _ => ?_
        have h1 : (t (c g)) • g = algebraMap S R (t (c g)) * g := Algebra.smul_def _ _
        rw [h1, smul_eq_mul]
        ring
      rw [key]
      refine Submodule.add_mem_sup ?_ ?_
      · exact Submodule.sum_mem _ fun g hg => Submodule.smul_mem _ _
          (Submodule.subset_span (by simpa using hg))
      · refine Submodule.sum_mem _ fun g hg => ?_
        have hgm : g ∈ maximalIdeal R ^ j := by rw [← hG]; exact Submodule.subset_span hg
        have hmem : (c g - algebraMap S R (t (c g))) * g
            ∈ maximalIdeal R * maximalIdeal R ^ j := Ideal.mul_mem_mul (ht (c g)) hgm
        rw [← pow_succ'] at hmem
        exact hmem
    calc (⊤ : Submodule S R)
        ≤ Submodule.span S (A : Set R) ⊔ (maximalIdeal R ^ j).restrictScalars S := hA
      _ ≤ _ := by
        refine sup_le (le_trans (Submodule.span_mono (by simp)) le_sup_left)
          (le_trans hstep (sup_le (le_trans (Submodule.span_mono (by simp)) le_sup_left)
            le_sup_right))

/-- A ring map from a complete local ring which carries the maximal ideal onto an ideal of
definition of a Noetherian complete local ring is finite. This is Stacks 031D applied to `R` as a
module over the source: `R` is `I`-adically separated because it is `I`-adically complete, and
`R/I` is finite over the residue field of the source because `𝔪 ^ k ≤ I` and the residue field of
the source surjects onto that of `R`. -/
private theorem finite_of_map_maximalIdeal {S R : Type*} [CommRing S] [CommRing R] [IsLocalRing S]
    [IsNoetherianRing R] [IsLocalRing R] [IsAdicComplete (maximalIdeal S) S] (F : S →+* R)
    (I : Ideal R) (hI : Ideal.map F (maximalIdeal S) = I) {k : ℕ}
    (hk : (maximalIdeal R) ^ k ≤ I) [IsAdicComplete I R]
    (hres : Function.Surjective ((residue R).comp F)) : F.Finite := by
  classical
  let _ : Algebra S R := F.toAlgebra
  have halg : (algebraMap S R) = F := rfl
  have hP : (maximalIdeal S) • (⊤ : Submodule S R) = I.restrictScalars S := by
    rw [Ideal.smul_top_eq_map, halg, hI]
  have hsep : ⨅ n : ℕ, (maximalIdeal S) ^ n • (⊤ : Submodule S R) = ⊥ :=
    haveI : IsHausdorff (maximalIdeal S) R :=
      IsHausdorff.of_map (J := I) (by rw [halg, hI])
    IsHausdorff.iInf_pow_smul this
  have hfin : Module.Finite (S ⧸ maximalIdeal S)
      (R ⧸ (maximalIdeal S) • (⊤ : Submodule S R)) := by
    obtain ⟨A, hA⟩ :=
      exists_finset_top_le_span_sup_restrictScalars_pow (S := S) (R := R) (by rwa [halg]) k
    have hAP : (⊤ : Submodule S R) ≤
        Submodule.span S (A : Set R) ⊔ (maximalIdeal S) • (⊤ : Submodule S R) := by
      refine hA.trans (sup_le_sup_left ?_ _)
      rw [hP]
      exact Submodule.restrictScalars_mono S hk
    have hSfin : Module.Finite S (R ⧸ (maximalIdeal S) • (⊤ : Submodule S R)) := by
      set P := (maximalIdeal S) • (⊤ : Submodule S R) with hPdef
      rw [Module.finite_def]
      refine ⟨A.image P.mkQ, ?_⟩
      rw [eq_top_iff]
      intro y _
      obtain ⟨r, rfl⟩ := P.mkQ_surjective y
      obtain ⟨a, ha, p, hp, hap⟩ := Submodule.mem_sup.1 (hAP (Submodule.mem_top (x := r)))
      have hmk : P.mkQ r = P.mkQ a := by rw [← hap]; simp [hp]
      rw [hmk, Finset.coe_image, ← Submodule.map_span]
      exact Submodule.mem_map_of_mem ha
    exact Module.Finite.of_restrictScalars_finite S _ _
  exact Module.Finite.of_iInf_pow_smul_top_eq_bot_of_finite_quotient_smul_top
    (maximalIdeal S) hsep hfin

/-- An integral ring map from a Noetherian local domain into a domain of at least the same Krull
dimension is injective: its kernel is a prime `P` of the source and `R` is integral over `S/P`, so
`dim R ≤ dim S/P` by Stacks 00OJ, while a nonzero `a ∈ P` would give
`dim S/P ≤ dim S/(a) < dim S ≤ dim R`. -/
private theorem injective_of_isIntegral_of_ringKrullDim_le {S R : Type*} [CommRing S] [CommRing R]
    [IsNoetherianRing S] [IsLocalRing S] [IsDomain S] [IsDomain R] (F : S →+* R)
    (hF : F.IsIntegral) (hdim : ringKrullDim S ≤ ringKrullDim R) : Function.Injective F := by
  rw [RingHom.injective_iff_ker_eq_bot]
  by_contra hker
  obtain ⟨a, haP, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
  let G : S ⧸ RingHom.ker F →+* R := Ideal.Quotient.lift (RingHom.ker F) F fun _ hb => hb
  have hGF : G.comp (Ideal.Quotient.mk (RingHom.ker F)) = F := rfl
  have hG : G.IsIntegral := fun r => by
    obtain ⟨q, hqm, hq⟩ := hF r
    exact ⟨q.map (Ideal.Quotient.mk (RingHom.ker F)), hqm.map _,
      by rwa [Polynomial.eval₂_map, hGF]⟩
  let T : S ⧸ Ideal.span {a} →+* S ⧸ RingHom.ker F :=
    Ideal.Quotient.lift _ (Ideal.Quotient.mk (RingHom.ker F)) fun _ hb =>
      Ideal.Quotient.eq_zero_iff_mem.2 ((Ideal.span_singleton_le_iff_mem _).2 haP hb)
  have hTsurj : Function.Surjective T := fun y => by
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨Ideal.Quotient.mk _ z, rfl⟩
  have hlt : ringKrullDim (S ⧸ Ideal.span {a}) < ringKrullDim S :=
    ringKrullDim_quotient_span_singleton_lt (mem_nonZeroDivisors_of_ne_zero ha0)
      (le_maximalIdeal (RingHom.ker_isPrime F).ne_top haP)
  exact absurd (hlt.trans_le (hdim.trans ((integral_dim_up G hG).1.trans
    (ringKrullDim_le_of_surjective T hTsurj)))) (lt_irrefl _)

/-! ### The common core of the two cases -/

/-- The common core of both cases of Stacks 032D. -/
private theorem exists_of_ringHom (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [IsDomain R] [IsAdicComplete (maximalIdeal R) R] (Λ : Type u) [CommRing Λ]
    [IsNoetherianRing Λ] [IsLocalRing Λ] [IsDomain Λ] [IsAdicComplete (maximalIdeal Λ) Λ]
    (g : Λ →+* R) (s : Finset Λ) (hs : Ideal.span (s : Set Λ) = maximalIdeal Λ)
    (hgloc : ∀ y : Λ, y ∈ maximalIdeal Λ → g y ∈ maximalIdeal R)
    (hgres : Function.Surjective ((residue R).comp g)) (d : ℕ) (x : Fin d → R)
    (hx : ∀ i, x i ∈ maximalIdeal R)
    (hdef : Ring.KrullDimLE 0
      (R ⧸ ((maximalIdeal Λ).map g ⊔ Ideal.span (Set.range x))))
    (hdim : ((s.card + d : ℕ) : WithBot ℕ∞) ≤ ringKrullDim R) :
    ∃ _ : IsRegularLocalRing (MvPowerSeries (Fin d) Λ),
      IsAdicComplete (maximalIdeal (MvPowerSeries (Fin d) Λ)) (MvPowerSeries (Fin d) Λ) ∧
        ∃ f : MvPowerSeries (Fin d) Λ →+* R,
          Function.Injective f ∧ f.Finite ∧ Function.Surjective ((residue R).comp f) := by
  have : IsDomain (MvPowerSeries (Fin d) Λ) := { }
  have hSac : IsAdicComplete (maximalIdeal (MvPowerSeries (Fin d) Λ))
      (MvPowerSeries (Fin d) Λ) := isAdicComplete_maximalIdeal_mvPowerSeries Λ d
  set I : Ideal R := (maximalIdeal Λ).map g ⊔ Ideal.span (Set.range x) with hIdef
  have hIle : I ≤ maximalIdeal R := by
    refine sup_le ?_ (Ideal.span_le.2 ?_)
    · exact Ideal.map_le_iff_le_comap.2 fun y hy => hgloc y hy
    · rintro _ ⟨i, rfl⟩
      exact hx i
  obtain ⟨k, hk0, hk⟩ := exists_pow_maximalIdeal_le I hIle hdef
  have hIac : IsAdicComplete I R := isAdicComplete_of_pow_maximalIdeal_le I hIle hk0 hk
  have hxI : ∀ i, x i ∈ I := fun i => Submodule.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩)
  obtain ⟨F, hFX, hFC⟩ := exists_eval₂Hom I x hxI g
  have hcomp : F.comp (MvPowerSeries.C (σ := Fin d)) = g := RingHom.ext hFC
  have hmap : Ideal.map F (maximalIdeal (MvPowerSeries (Fin d) Λ)) = I := by
    rw [maximalIdeal_mvPowerSeries Λ d, Ideal.map_sup, Ideal.map_map, Ideal.map_span, hcomp,
      hIdef]
    congr 1
    rw [← Set.range_comp]
    exact congrArg _ (congrArg Set.range (funext hFX))
  have hres : Function.Surjective ((residue R).comp F) := by
    intro z
    obtain ⟨c, hc⟩ := hgres z
    exact ⟨MvPowerSeries.C c, by simpa [hFC c] using hc⟩
  have hFin : F.Finite := finite_of_map_maximalIdeal F I hmap hk hres
  have hSR : ringKrullDim (MvPowerSeries (Fin d) Λ) ≤ ringKrullDim R :=
    (ringKrullDim_mvPowerSeries_le Λ d s hs).trans hdim
  have hinj : Function.Injective F :=
    injective_of_isIntegral_of_ringKrullDim_le F hFin.to_isIntegral hSR
  have hRS : ringKrullDim R ≤ ringKrullDim (MvPowerSeries (Fin d) Λ) :=
    (integral_dim_up F hFin.to_isIntegral).1
  have hreg : IsRegularLocalRing (MvPowerSeries (Fin d) Λ) := by
    refine ⟨le_antisymm ?_ (ringKrullDim_le_spanFinrank_maximalIdeal _)⟩
    refine le_trans ?_ (hdim.trans hRS)
    exact_mod_cast spanFinrank_maximalIdeal_mvPowerSeries_le Λ d s hs
  exact ⟨hreg, hSac, F, hinj, hFin, hres⟩

/-! ### Systems of parameters -/

/-- The quotient of a local ring by an ideal whose radical is the maximal ideal has Krull
dimension zero: the image of the maximal ideal is the nilradical of the quotient. -/
@[ega "IV 21.13.12.1" "partial", ega "IV 6.1.3" "partial"]
private theorem krullDimLE_zero_quotient_of_radical_eq {A : Type*} [CommRing A] [IsLocalRing A]
    {I : Ideal A} (h : I.radical = maximalIdeal A) : Ring.KrullDimLE 0 (A ⧸ I) := by
  have := isLocalRing_quotient (ne_top_of_le_ne_top
    (h ▸ (maximalIdeal.isMaximal A).ne_top) Ideal.le_radical)
  have hnil : maximalIdeal (A ⧸ I) ≤ nilradical (A ⧸ I) := fun z hz => by
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨n, hn⟩ := h ▸ mk_mem_maximalIdeal_iff.1 hz
    exact ⟨n, by rw [← map_pow]; exact Ideal.Quotient.eq_zero_iff_mem.2 hn⟩
  have hnt : nilradical (A ⧸ I) ≠ ⊤ := fun htop => by
    obtain ⟨n, hn⟩ : IsNilpotent (1 : A ⧸ I) := mem_nilradical.1 ((Ideal.eq_top_iff_one _).1 htop)
    simp at hn
  have : (nilradical (A ⧸ I)).IsMaximal :=
    le_antisymm (le_maximalIdeal hnt) hnil ▸ maximalIdeal.isMaximal (A ⧸ I)
  exact Ring.KrullDimLE.of_isMaximal_nilradical _

/-- **A Noetherian local ring has a system of parameters**: there are `dim A` elements of the
maximal ideal generating an ideal of definition, that is an ideal whose quotient has Krull
dimension zero. This is the existence half of Stacks 00KQ item (3). -/
@[ega "0 16.2.5" "partial", ega "0 16.3.8" "special case"]
private theorem exists_systemOfParameters_aux (A : Type*) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] : ∃ (d : ℕ) (x : Fin d → A), (∀ i, x i ∈ maximalIdeal A) ∧
      Ring.KrullDimLE 0 (A ⧸ Ideal.span (Set.range x)) ∧
      ((d : ℕ) : WithBot ℕ∞) ≤ ringKrullDim A := by
  classical
  obtain ⟨D, hD⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim A
  obtain ⟨⟨I, hIrad, hIrank⟩, -⟩ := ((IsLocalRing.ringKrullDim_eq_tfae D).out 1 3).1 hD
  obtain ⟨s, hcard, hspan⟩ :=
    (IsNoetherian.noetherian I : I.FG).exists_span_finset_card_eq_spanFinrank
  set e := Finset.equivFinOfCardEq (hcard.trans hIrank) with he
  have hrange : Set.range (fun i : Fin D => ((e.symm i : A))) = (s : Set A) := by
    ext y
    simp only [Set.mem_range]
    constructor
    · rintro ⟨i, rfl⟩
      exact (e.symm i).2
    · intro hy
      exact ⟨e ⟨y, hy⟩, by simp⟩
  have hI : Ideal.span (Set.range (fun i : Fin D => ((e.symm i : A)))) = I := by
    rwa [hrange]
  refine ⟨D, fun i => ((e.symm i : A)), fun i => ?_, ?_, le_of_eq hD.symm⟩
  · rw [← hIrad]
    exact Ideal.le_radical (hI ▸ Ideal.subset_span ⟨i, rfl⟩)
  · rw [hI]
    exact krullDimLE_zero_quotient_of_radical_eq hIrad

/-- **A complete local domain whose maximal ideal is generated by one nonzero element is a
discrete valuation ring.** Every nonzero `x` is a unit times a power of `p`: the ring being
`𝔪`-adically separated, some power of `p` fails to divide `x`, and at the last power which does
divide it the cofactor lies outside `𝔪 = (p)`, hence is a unit. -/
private theorem isDiscreteValuationRing_of_maximalIdeal_eq_span {A : Type*} [CommRing A]
    [IsDomain A] [IsLocalRing A] [IsAdicComplete (maximalIdeal A) A] {p : A} (hp0 : p ≠ 0)
    (hp : maximalIdeal A = Ideal.span {p}) : IsDiscreteValuationRing A := by
  classical
  have hirr : Irreducible p :=
    ((Ideal.span_singleton_prime hp0).1
      (hp ▸ (inferInstance : (maximalIdeal A).IsPrime))).irreducible
  refine IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization ⟨p, hirr, ?_⟩
  intro x hx
  have hex : ∃ n : ℕ, ¬ (p ^ n ∣ x) := by
    by_contra hall
    push Not at hall
    refine hx (IsHausdorff.haus (inferInstance : IsHausdorff (maximalIdeal A) A) x fun n => ?_)
    rw [SModEq.zero]
    have h1 : x ∈ Ideal.span {p ^ n} := Ideal.mem_span_singleton.2 (hall n)
    simpa [hp, Ideal.span_singleton_pow] using h1
  obtain ⟨k, hk, hkmin⟩ : ∃ k : ℕ, ¬ p ^ k ∣ x ∧ ∀ j < k, p ^ j ∣ x :=
    ⟨Nat.find hex, Nat.find_spec hex, fun j hj => not_not.1 (Nat.find_min hex hj)⟩
  have hkpos : k ≠ 0 := fun hzero => hk (by simp [hzero])
  obtain ⟨u, hu⟩ : p ^ (k - 1) ∣ x := hkmin _ (by omega)
  have hpu : ¬ p ∣ u := by
    rintro ⟨v, rfl⟩
    refine hk ⟨v, ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
    rw [Nat.add_sub_cancel] at hu
    rw [hu, pow_succ]
    ring
  have hunit : IsUnit u := by
    by_contra hnu
    exact hpu (Ideal.mem_span_singleton.1
      (hp ▸ (mem_maximalIdeal u).2 (mem_nonunits_iff.2 hnu)))
  exact ⟨k - 1, hunit.unit, by rw [hunit.unit_spec, hu]⟩

/-! ### Producing the coefficient ring -/

/-- Since `R` is a domain, the coefficient ring of `R` produced by the Cohen structure theorem
(Stacks 032A) is either a field or a Cohen ring, and in either case it is a complete local domain
whose maximal ideal is zero or principal on a nonzero element; the inclusion is injective, carries
the maximal ideal into `𝔪` and induces a surjection onto the residue field. -/
private theorem exists_coefficientRing (R : Type u) [CommRing R] [IsLocalRing R] [IsDomain R]
    [IsAdicComplete (maximalIdeal R) R] :
    ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsDomain Λ) (_ : IsNoetherianRing Λ) (_ : IsLocalRing Λ)
      (_ : IsAdicComplete (maximalIdeal Λ) Λ),
      (IsField Λ ∨ IsCohenRing Λ) ∧
        (maximalIdeal Λ = ⊥ ∨ ∃ p : Λ, p ≠ 0 ∧ maximalIdeal Λ = Ideal.span {p}) ∧
        ∃ g : Λ →+* R, Function.Injective g ∧
          (∀ y : Λ, y ∈ maximalIdeal Λ → g y ∈ maximalIdeal R) ∧
          Function.Surjective ((residue R).comp g) := by
  obtain ⟨Λ, hcoeff⟩ :=
    (IsLocalRing.exists_isCoefficientRing_and_exists_surjective_mvPowerSeries R).1
  have : IsLocalRing Λ.toSubring := Λ.isLocalRing
  have := hcoeff.isLocalHom
  have := hcoeff.isAdicComplete
  set g : Λ.toSubring →+* R := Λ.toSubring.subtype with hg
  have hginj : Function.Injective g := Subtype.val_injective
  have hmcomap : maximalIdeal Λ.toSubring = (maximalIdeal R).comap g :=
    (maximalIdeal_comap g).symm
  have hgloc : ∀ y : Λ.toSubring, y ∈ maximalIdeal Λ.toSubring → g y ∈ maximalIdeal R := by
    intro y hy
    rw [hmcomap] at hy
    exact hy
  have hmax : maximalIdeal Λ.toSubring
      = Ideal.span {((ringChar (ResidueField R) : ℕ) : Λ.toSubring)} := by
    rw [hmcomap, hcoeff.comap_maximalIdeal_eq_span_ringChar]
  have hgres : Function.Surjective ((residue R).comp g) := by
    intro z
    obtain ⟨w, hw⟩ := hcoeff.residueField_map_surjective z
    obtain ⟨b, rfl⟩ := residue_surjective w
    refine ⟨b, ?_⟩
    have hgb : ((residue R).comp g) b = residue R (b : R) := rfl
    rw [hgb]
    simpa [ResidueField.map_residue g b] using hw
  by_cases hz : ((ringChar (ResidueField R) : ℕ) : Λ.toSubring) = 0
  · have hbot : maximalIdeal Λ.toSubring = ⊥ := by rw [hmax, hz]; simp
    have hfield : IsField Λ.toSubring := isField_iff_maximalIdeal_eq.2 hbot
    have _ : IsNoetherianRing Λ.toSubring := by
      let _ := hfield.toField
      infer_instance
    exact ⟨Λ.toSubring, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      Or.inl hfield, Or.inl hbot, g, hginj, hgloc, hgres⟩
  · have hprime : (ringChar (ResidueField R)).Prime := by
      rcases CharP.char_is_prime_or_zero (ResidueField R) (ringChar (ResidueField R)) with h | h
      · exact h
      · exact absurd (by rw [h]; simp) hz
    have hdvr : IsDiscreteValuationRing Λ.toSubring :=
      isDiscreteValuationRing_of_maximalIdeal_eq_span hz hmax
    have : IsCohenRing Λ.toSubring := IsCohenRing.mk ⟨_, hprime, hmax⟩
    exact ⟨Λ.toSubring, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      Or.inr inferInstance, Or.inr ⟨_, hz, hmax⟩, g, hginj, hgloc, hgres⟩

/-- Given a complete local coefficient ring `Λ → R` whose maximal ideal is zero or principal, the
system of parameters of `R/𝔪_Λ R` needed by the core lemma exists, together with the dimension
bookkeeping `#s + d ≤ dim R`. In the principal case the generator `p` of `𝔪_Λ` has nonzero, hence
nonzerodivisor, image in the domain `R`, which is what makes `dim R/𝔪_Λ R = dim R - 1`
(Stacks 00KW). -/
private theorem exists_systemOfParameters (R : Type u) [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] [IsDomain R] (Λ : Type u) [CommRing Λ] [IsLocalRing Λ]
    (g : Λ →+* R) (hginj : Function.Injective g)
    (hgloc : ∀ y : Λ, y ∈ maximalIdeal Λ → g y ∈ maximalIdeal R)
    (hm : maximalIdeal Λ = ⊥ ∨ ∃ p : Λ, p ≠ 0 ∧ maximalIdeal Λ = Ideal.span {p}) :
    ∃ (s : Finset Λ) (d : ℕ) (x : Fin d → R), Ideal.span (s : Set Λ) = maximalIdeal Λ ∧
      (∀ i, x i ∈ maximalIdeal R) ∧
      Ring.KrullDimLE 0 (R ⧸ ((maximalIdeal Λ).map g ⊔ Ideal.span (Set.range x))) ∧
      ((s.card + d : ℕ) : WithBot ℕ∞) ≤ ringKrullDim R := by
  rcases hm with hbot | ⟨p, hp0, hpspan⟩
  · obtain ⟨d, x, hx, hdef, hdim⟩ := exists_systemOfParameters_aux R
    refine ⟨∅, d, x, by simp [hbot], hx, ?_, by simpa using hdim⟩
    rwa [hbot, Ideal.map_bot, bot_sup_eq]
  · have hq0 : g p ≠ 0 := fun h => hp0 (hginj (by rw [h, map_zero]))
    have hqm : g p ∈ maximalIdeal R :=
      hgloc p (hpspan ▸ Ideal.mem_span_singleton_self p)
    have hqnzd : g p ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hq0
    have hmapq : Ideal.map g (maximalIdeal Λ) = Ideal.span {g p} := by
      rw [hpspan, Ideal.map_span]
      simp
    have : IsLocalRing (R ⧸ Ideal.span {g p}) := isLocalRing_quotient
      (ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top
        ((Ideal.span_singleton_le_iff_mem _).2 hqm))
    obtain ⟨d, y, hy, hdefy, hdimy⟩ := exists_systemOfParameters_aux (R ⧸ Ideal.span {g p})
    have hlift : ∀ i, ∃ a : R, Ideal.Quotient.mk (Ideal.span {g p}) a = y i :=
      fun i => Ideal.Quotient.mk_surjective (y i)
    choose x hx using hlift
    have hmapx : Ideal.map (Ideal.Quotient.mk (Ideal.span {g p})) (Ideal.span (Set.range x))
        = Ideal.span (Set.range y) := by
      rw [Ideal.map_span, ← Set.range_comp]
      exact congrArg _ (congrArg Set.range (funext hx))
    refine ⟨{p}, d, x, by rw [hpspan]; simp, fun i => ?_, ?_, ?_⟩
    · exact mk_mem_maximalIdeal_iff.1 (hx i ▸ hy i)
    · have h1 : ringKrullDim (R ⧸ (Ideal.span {g p} ⊔ Ideal.span (Set.range x)))
          = ringKrullDim ((R ⧸ Ideal.span {g p}) ⧸ Ideal.span (Set.range y)) := by
        rw [← hmapx]
        exact (ringKrullDim_eq_of_ringEquiv
          (DoubleQuot.quotQuotEquivQuotSup (Ideal.span {g p}) (Ideal.span (Set.range x)))).symm
      rw [hmapq, Ring.krullDimLE_iff, h1]
      exact Ring.krullDimLE_iff.1 hdefy
    · have h3 : ringKrullDim (R ⧸ Ideal.span {g p}) + 1 = ringKrullDim R :=
        ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
          hqnzd hqm
      calc ((({p} : Finset Λ).card + d : ℕ) : WithBot ℕ∞) = (d : WithBot ℕ∞) + 1 := by
            rw [Finset.card_singleton, Nat.cast_add, Nat.cast_one, add_comm]
        _ ≤ ringKrullDim (R ⧸ Ideal.span {g p}) + 1 := by gcongr
        _ = ringKrullDim R := h3

end Stacks.CompleteLocalRing.RegularSubring

/-!
# A complete local domain is finite over a regular power series subring

Let `(R, 𝔪)` be a Noetherian complete local domain. Then `R` contains a subring `R₀` such that

1. `R₀` is a regular complete local ring,
2. `R₀ ⊆ R` is finite and induces an isomorphism on residue fields,
3. `R₀` is isomorphic either to `k[[X_1, …, X_d]]` for a field `k`, or to `Λ[[X_1, …, X_d]]` for a
   Cohen ring `Λ` (Stacks 0327).

Such an `R₀` comes from a coefficient ring `Λ` of `R` (Stacks 0326, Stacks 032A), which is either a
field or a Cohen ring because `R` is a domain — the third possibility for a coefficient ring, an
Artinian local ring with maximal ideal `(p)`, has nilpotents. If `Λ = k` is a field, put
`d = dim R`, choose `x_1, …, x_d ∈ 𝔪` generating an ideal of definition `I`, note that `R` is
`I`-adically complete as well (Stacks 0319) and map `R₀ = k[[X_1, …, X_d]] → R` by `X_i ↦ x_i`.
Then `R₀` is complete for `I₀ = (X_1, …, X_d)` and `R/I₀R = R/IR` is finite over `k = R₀/I₀`
because `dim R/I = 0`, so the map is finite by Stacks 031D; as `dim R = dim R₀`, it is injective by
Stacks 00OJ. If `Λ` is a Cohen ring with residue characteristic `p`, then `p` is a nonzerodivisor
of the domain `R`, so `dim R/pR = dim R - 1 = d`, and the same argument applies to
`R₀ = Λ[[X_1, …, X_d]] → R`, `X_i ↦ x_i`, for `x_1, …, x_d ∈ R` generating an ideal of definition
of `R/pR` and `I = (p, x_1, …, x_d)`.

## Main results

* `IsLocalRing.exists_injective_finite_mvPowerSeries`: a Noetherian complete local domain is a
  finite extension of a power series ring in finitely many variables over a field or over a Cohen
  ring, by a map which is injective and induces an isomorphism on residue fields, the power series
  ring being a regular complete local ring.

## Implementation notes

The subring `R₀ ⊆ R` of the source is presented by the injective ring homomorphism `f` whose image
it is, from the power series ring itself rather than from an abstract ring isomorphic to one: the
source's items (1) and (3) are then statements about `MvPowerSeries (Fin d) Λ`, and its item (2) is
a statement about `f`. This is equivalent to the literal reading — `R₀` is `f.range`, and
`f.rangeRestrict` is the isomorphism of item (3) — and it is the form the source's own proof
produces and the form its uses want, since they immediately replace `R` by the power series ring.

The two cases of item (3) are one disjunction `IsField Λ ∨ IsCohenRing Λ` on a single `Λ`, as in
Stacks 032A; `IsCohenRing` is a class on a domain, so `Λ` carries anonymous `CommRing` and
`IsDomain` instance binders, which both disjuncts supply, and `IsField Λ` rather than `Field Λ` is
the predicate appropriate to such a `Λ`. The `d` variables are indexed by `Fin d`, matching the
source's `X_1, …, X_d`, and `d` is existential as in the source; it is determined by `R`, being
`dim R` in the field case and `dim R - 1` in the Cohen ring case.

Item (1) is `IsRegularLocalRing (MvPowerSeries (Fin d) Λ)`, which already contains Noetherian and
local, together with `IsAdicComplete` for the maximal ideal, the source's completeness. The
regularity hypothesis is bound before the completeness so that `IsLocalRing` is available to name
that maximal ideal.

Item (2) is `f.Finite`, Mathlib's `RingHom.Finite`, that is `R` is a finite module over the power
series ring through `f`, together with `Function.Injective f`, the source's `R₀ ⊆ R`, and with
`Function.Surjective ((residue R).comp f)` for the isomorphism on residue fields. The latter is
equivalent to the literal item (2): the source ring of `f` is local, so a surjection onto `R/𝔪`
has as kernel a maximal ideal, whence `f` is a local homomorphism and the induced map of residue
fields is surjective, hence — a ring homomorphism out of a field being injective — an isomorphism.

Faithfulness. (1) Every hypothesis is used by the conclusion: `[IsLocalRing R]` gives `𝔪` and the
residue field; `[IsAdicComplete (maximalIdeal R) R]` is what produces the coefficient ring and what
makes `f` finite; `[IsNoetherianRing R]` is what gives `R` a finite ideal of definition and the
dimension theory by which `dim R = dim R₀` makes `f` injective; and `[IsDomain R]` is what excludes
the Artinian coefficient rings, without which the statement is false — for `R = ℤ/p²ℤ` no field and
no Cohen ring maps injectively to `R` at all. (2) The scalars and the base are the source's: `f`
maps into `R` itself, finiteness is of `R` as a module over `MvPowerSeries (Fin d) Λ` along `f` and
not over a localization or a completion of it, and the residue field is `R`'s own
`IsLocalRing.ResidueField R`. (3) The maps the source names are pinned: the inclusion `R₀ ⊆ R` is
`f`, quantified over with its injectivity rather than only through its image, and the induced map
on residue fields is `(residue R).comp f`, not an unspecified isomorphism; only `d`, `Λ` and `f`
themselves are existential, as in the source, since they depend on a choice of coefficient ring and
of an ideal of definition. (4) The instantiation is not degenerate: `R = ℤ_p` satisfies every
hypothesis, with `Λ = ℤ_p` a Cohen ring, `d = 0` and `f` an isomorphism, and
`R = k[[x, y]]/(y² - x³) = k[[t², t³]]` is one where `f` is not surjective, being finite of degree
two over `Λ = k`, `d = 1`, `X ↦ t²`.

## References

* [StacksProject 032D](https://stacks.math.columbia.edu/tag/032D), Lemma 10.160.11
* [StacksProject 032A](https://stacks.math.columbia.edu/tag/032A), Theorem 10.160.8
* [StacksProject 032C](https://stacks.math.columbia.edu/tag/032C), Remark 10.160.9
* [StacksProject 0319](https://stacks.math.columbia.edu/tag/0319)
* [StacksProject 031D](https://stacks.math.columbia.edu/tag/031D)
* [StacksProject 00OJ](https://stacks.math.columbia.edu/tag/00OJ)
-/

@[expose] public section

open IsLocalRing
open Stacks.CompleteLocalRing.RegularSubring

/-- Let `(R, 𝔪)` be a Noetherian complete local domain. Then there is a subring `R₀ ⊆ R` which is
a regular complete local ring, over which `R` is finite, which induces an isomorphism on residue
fields, and which is a power series ring `Λ[[X_1, …, X_d]]` over a field or over a Cohen ring `Λ`.
The subring is presented as the image of an injective ring homomorphism
`f : Λ[[X_1, …, X_d]] → R`, finite and with `R/𝔪` generated by the image of `f`. (Stacks 032D) -/
@[stacks 032D "The subring `R₀ ⊆ R` is presented as an injective ring homomorphism `f` from the \
  power series ring it is isomorphic to, so that items (1) and (3) are statements about \
  `MvPowerSeries (Fin d) Λ` and item (2) is one about `f`: `f.Finite` for finiteness and \
  `Function.Surjective ((residue R).comp f)` for the isomorphism on residue fields. \
  See the module docstring.", ega "0 19.8.8" "(ii)"]
public theorem IsLocalRing.exists_injective_finite_mvPowerSeries (R : Type u) [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] [IsDomain R] [IsAdicComplete (maximalIdeal R) R] :
    ∃ (d : ℕ) (Λ : Type u) (_ : CommRing Λ) (_ : IsDomain Λ),
      (IsField Λ ∨ IsCohenRing Λ) ∧
        ∃ _ : IsRegularLocalRing (MvPowerSeries (Fin d) Λ),
          IsAdicComplete (maximalIdeal (MvPowerSeries (Fin d) Λ)) (MvPowerSeries (Fin d) Λ) ∧
            ∃ f : MvPowerSeries (Fin d) Λ →+* R,
              Function.Injective f ∧ f.Finite ∧ Function.Surjective ((residue R).comp f) := by
  obtain ⟨Λ, _, _, _, _, _, hcase, hm, g, hginj, hgloc, hgres⟩ := exists_coefficientRing R
  obtain ⟨s, d, x, hs, hx, hdef, hdim⟩ :=
    exists_systemOfParameters R Λ g hginj hgloc hm
  obtain ⟨hSreg, hSac, f, hinj, hfin, hfres⟩ :=
    exists_of_ringHom R Λ g s hs hgloc hgres d x hx hdef hdim
  exact ⟨d, Λ, inferInstance, inferInstance, hcase, hSreg, hSac, f, hinj, hfin, hfres⟩

end
