module

public import Mathlib.RingTheory.LocalProperties.Submodule
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import Mathlib.Algebra.Module.LocalizedModule.IsLocalization

/-!
# Detecting submodule membership, and integrality, one maximal ideal at a time

Let `A` be a commutative ring, `M` an `A`-module and `N` an `A`-submodule of `M`. An element
`x : M` lies in `N` as soon as, for every maximal ideal `P` of `A`, some scalar outside `P`
carries `x` into `N`. The reason is that the scalars which do carry `x` into `N` form an ideal
of `A` — the preimage of `N` under `a ↦ a • x` — and the hypothesis says that this ideal is
contained in no maximal ideal, so it is the unit ideal and `x = 1 • x ∈ N`.

This is `Submodule.mem_of_localization_maximal` with the localizations removed from the
hypothesis. The statement in Mathlib is phrased through `Submodule.localized₀` and an
`IsLocalizedModule` structure, so a caller must first produce a family of localized modules and
the scalar towers relating them; unfolding `Submodule.localized₀` and clearing denominators
turns the hypothesis into the self-contained `∃ a ∉ P, a • x ∈ N`, which mentions no
localization at all and can be supplied directly by whoever cleared the denominators by hand.
Both forms are provided here, together with the passage from one to the other, because the
denominator-clearing form is what an argument about a specific element produces and the
localized form is what a statement about localizations consumes.

The localized form is specialised to the case of interest: `M` is an `A`-algebra `L` and the
localization of `L` at a maximal ideal `P` of `A` is a *ring* localization of `L`, namely at the
image `Algebra.algebraMapSubmonoid L P.primeCompl` of `P.primeCompl`. The required
`IsLocalizedModule P.primeCompl` structure on the `A`-linear map `L → Lₚ` is then automatic.
Note that the submodule appearing in the hypothesis has to be the localization of `N` as an
`A`-module, not the `Lₚ`-submodule generated by the image of `N`: an `A`-submodule of `L` is not
an ideal, so the two differ.

The application is to integral closures. The integral closure of `A` in an `A`-algebra `L` is a
subalgebra, hence in particular an `A`-submodule of `L`, so the criterion applies verbatim: an
element of `L` which becomes integral over `A` after scaling by something outside `P`, for every
maximal ideal `P` of `A`, is already integral over `A`.

## Main results

* `Stacks.IntegralClosureLocal.mem_of_forall_maximal_exists_smul_mem` — **membership in an
  `A`-submodule is detected at the maximal ideals of `A`**, in the denominator-clearing form
  `∃ a ∉ P, a • x ∈ N`.
* `Stacks.IntegralClosureLocal.exists_smul_mem_of_mem_localized₀` — membership of `f x` in the
  localization of `N` at a submonoid `S` produces an element of `S` carrying `x` into `N`.
* `Stacks.IntegralClosureLocal.mem_of_forall_maximal_mem_localized₀_algebra` — the criterion for
  an `A`-submodule of an `A`-algebra `L`, tested on ring localizations of `L`.
* `Stacks.IntegralClosureLocal.isIntegral_of_forall_maximal_exists_smul_isIntegral` — the
  criterion for the integral closure of `A` in an `A`-algebra `L`.

## References

* [Stacks Project, Tag 00GY](https://stacks.math.columbia.edu/tag/00GY)
-/

@[expose] public noncomputable section

universe u v w

namespace Stacks.IntegralClosureLocal

/-- **An element of an `A`-module lies in a submodule as soon as, for every maximal ideal `P`
of `A`, some element outside `P` carries it into the submodule.**

The scalars `a` with `a • x ∈ N` form an ideal of `A`, namely the preimage of `N` under the
`A`-linear map `a ↦ a • x`. The hypothesis says this ideal escapes every maximal ideal, so it is
all of `A`; taking `a = 1` gives `x ∈ N`. -/
public theorem mem_of_forall_maximal_exists_smul_mem
    {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]
    (N : Submodule A M) (x : M)
    (h : ∀ P : Ideal A, P.IsMaximal → ∃ a ∈ (P : Set A)ᶜ, a • x ∈ N) :
    x ∈ N := by
  let I : Ideal A := N.comap (LinearMap.toSpanSingleton A M x)
  suffices hI : I = ⊤ by simpa [I] using I.eq_top_iff_one.mp hI
  refine Not.imp_symm I.exists_le_maximal fun ⟨P, hP, hle⟩ => ?_
  obtain ⟨a, ha, haN⟩ := h P hP
  exact ha (hle (show a ∈ I from haN))

/-- **Clearing denominators in the localization of a submodule.** If `f : M → Mₛ` realises `Mₛ`
as the localization of `M` at a submonoid `S` of `A`, and `f x` lies in the localization
`N.localized₀ S f` of an `A`-submodule `N`, then already some element of `S` carries `x` into
`N`.

Unfolding `Submodule.localized₀`, the hypothesis provides `n ∈ N` and `s : S` with
`f n / s = f x`; comparing the two fractions gives a further `t : S` with `(t * s) • x = t • n`,
and the right-hand side lies in `N`. -/
public theorem exists_smul_mem_of_mem_localized₀
    {A : Type u} [CommRing A] {M : Type v} [AddCommMonoid M] [Module A M]
    {Mₛ : Type w} [AddCommMonoid Mₛ] [Module A Mₛ]
    (S : Submonoid A) (f : M →ₗ[A] Mₛ) [IsLocalizedModule S f]
    (N : Submodule A M) (x : M) (h : f x ∈ N.localized₀ S f) :
    ∃ s : S, (s : A) • x ∈ N := by
  obtain ⟨n, hn, s, e⟩ := h
  rw [← IsLocalizedModule.mk'_one S f x, IsLocalizedModule.mk'_eq_mk'_iff] at e
  obtain ⟨t, ht⟩ := e
  simp_rw [smul_smul] at ht
  exact ⟨t * s, by apply ht ▸ N.smul_mem _ hn⟩

/-- **Membership in an `A`-submodule of an `A`-algebra `L` is detected on the ring localizations
of `L` at the maximal ideals of `A`.**

For each maximal ideal `P` of `A`, `Lp P` is a localization of `L` at the image
`Algebra.algebraMapSubmonoid L P.primeCompl` of `P.primeCompl`, and the hypothesis is that the
image of `x` there lies in the localization of `N`, taken as an `A`-module along the `A`-linear
structure map `L → Lp P`.

This is `Submodule.mem_of_localization_maximal` in the shape an algebra provides: the localized
modules are rings, localized as rings, and no `IsLocalizedModule` instance has to be supplied by
the caller. -/
public theorem mem_of_forall_maximal_mem_localized₀_algebra
    {A : Type u} [CommRing A] {L : Type v} [CommRing L] [Algebra A L]
    (Lp : ∀ (P : Ideal A) [P.IsMaximal], Type w)
    [∀ (P : Ideal A) [P.IsMaximal], CommRing (Lp P)]
    [∀ (P : Ideal A) [P.IsMaximal], Algebra L (Lp P)]
    [∀ (P : Ideal A) [P.IsMaximal], Algebra A (Lp P)]
    [∀ (P : Ideal A) [P.IsMaximal], IsScalarTower A L (Lp P)]
    [∀ (P : Ideal A) [P.IsMaximal],
      IsLocalization (Algebra.algebraMapSubmonoid L P.primeCompl) (Lp P)]
    (N : Submodule A L) (x : L)
    (h : ∀ (P : Ideal A) [P.IsMaximal],
      (IsScalarTower.toAlgHom A L (Lp P)).toLinearMap x ∈
        N.localized₀ P.primeCompl (IsScalarTower.toAlgHom A L (Lp P)).toLinearMap) :
    x ∈ N := by
  refine mem_of_forall_maximal_exists_smul_mem N x fun P hP => ?_
  obtain ⟨s, hs⟩ := exists_smul_mem_of_mem_localized₀ P.primeCompl
    (IsScalarTower.toAlgHom A L (Lp P)).toLinearMap N x (h P)
  exact ⟨s, s.2, hs⟩

/-- **If an element of an `A`-algebra `L` becomes integral over `A` after multiplication by
something outside `P`, for every maximal ideal `P` of `A`, then it is integral over `A`.**

The integral closure is an `A`-submodule of `L`, so this is
`Stacks.IntegralClosureLocal.mem_of_forall_maximal_exists_smul_mem` applied to it. The
hypothesis is about `A`-multiples of `x` being integral over `A` itself; the more familiar local
statement, in which `x` is integral over the localization of `A` at `P`, reduces to this one by
clearing the denominators of a monic equation. -/
public theorem isIntegral_of_forall_maximal_exists_smul_isIntegral
    {A : Type u} [CommRing A] {L : Type v} [CommRing L] [Algebra A L]
    (x : L)
    (h : ∀ P : Ideal A, P.IsMaximal →
      ∃ a ∈ (P : Set A)ᶜ, a • x ∈ Subalgebra.toSubmodule (integralClosure A L)) :
    x ∈ integralClosure A L :=
  mem_of_forall_maximal_exists_smul_mem (Subalgebra.toSubmodule (integralClosure A L)) x h

end Stacks.IntegralClosureLocal

end
