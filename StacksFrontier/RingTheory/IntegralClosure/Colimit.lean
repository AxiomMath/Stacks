/-!
# Colimits and maps of finite presentation: integral maps as filtered colimits

Let `R → S` be a ring map between commutative rings with `S` integral over `R` (every
element of `S` is a root of a monic polynomial with coefficients in the image of `R`).
Then `R → S` can be written as a filtered colimit of a directed system of ring maps
`f_λ : R_λ → S_λ` such that

1. the colimit of the system `R_λ → S_λ` is the map `R → S`;
2. each `R_λ` is of finite type over `ℤ`;
3. each map `f_λ : R_λ → S_λ` is finite (module-finite).

The data of a directed system of ring maps is encoded categorically:

* a directed system over a directed index preorder `Λ`, together with the two families of
  rings `(R_λ)` and `(S_λ)` and the transition maps, is exactly the data of a functor
  `Λ ⥤ CommRingCat` (objects = the rings, morphisms = transition maps; functoriality
  encodes `φ_{λλ} = id` and `φ_{μν} ∘ φ_{λμ} = φ_{λν}`);
* the compatible family of ring maps `f_λ : R_λ → S_λ` is exactly a natural transformation
  between the two functors (naturality encodes `f_μ ∘ φ^R_{λμ} = φ^S_{λμ} ∘ f_λ`);
* "the colimit of the system equals `R → S`" is encoded by a colimit cocone with apex `R`
  for the source functor, a colimit cocone with apex `S` for the target functor, and the
  requirement that the squares relating the cocone legs, the maps `f_λ`, and the given map
  `R → S` commute.  Together with the universal property of the source colimit this pins
  down the induced map on colimits to be exactly the given `R → S`.

The index preorder `Λ` is required to be both nonempty and directed (pairwise upper
bounds), since a directed set is by definition nonempty.

## Definitions used from Mathlib

* `Algebra.IsIntegral R S` : `S` is integral over `R`.
* `Algebra.FiniteType ℤ A` : `A` is of finite type over `ℤ`.
* `RingHom.Finite g` : the ring map `g` is module-finite.
* `CategoryTheory.Limits.IsColimit` : a cocone is a colimit.

## Dependencies (cited, not re-proved)

* Stacks 00GK: a finite-type algebra generated by integral elements is module-finite.
* Stacks 00GM = `Algebra.finite_adjoin_of_finite_of_isIntegral`.
* Stacks 02JJ = `RingHom.finite_iff_isIntegral_and_finiteType`.
-/

@[expose] public section

open CategoryTheory Limits

/--
A *directed system of ring maps* with index preorder `Λ` consists of a directed preorder on
`Λ`, two functors `FR FS : Λ ⥤ CommRingCat` (encoding the families of rings together with
their transition maps and functoriality), and a natural transformation `f : FR ⟶ FS`
(encoding the compatible family of ring maps `f_λ : R_λ → S_λ`).

The index set is required to be nonempty (field `nonempty`) and directed (field
`directed`).
-/
structure DirectedRingMapSystem where
  /-- The index set. -/
  Λ : Type
  /-- The preorder on the index set. -/
  preorder : Preorder Λ
  /-- The index set is nonempty (part of being a directed set in Definition 1). -/
  nonempty : Nonempty Λ
  /-- The preorder is directed (it is automatically a category via `preorder`). -/
  directed : @IsDirected Λ (· ≤ ·)
  /-- The functor `λ ↦ R_λ` together with the transition maps `φ^R_{λμ}`. -/
  FR : @CategoryTheory.Functor Λ (@Preorder.smallCategory Λ preorder) CommRingCat _
  /-- The functor `λ ↦ S_λ` together with the transition maps `φ^S_{λμ}`. -/
  FS : @CategoryTheory.Functor Λ (@Preorder.smallCategory Λ preorder) CommRingCat _
  /-- The compatible family `f_λ : R_λ → S_λ`, as a natural transformation. -/
  f : FR ⟶ FS

attribute [instance] DirectedRingMapSystem.preorder DirectedRingMapSystem.nonempty
  DirectedRingMapSystem.directed

/--
The colimit of the system `R_λ → S_λ` *equals* the map `g : R →+* S`.

This asks for colimit cocones `cR`, `cS` with apexes `R` and `S` for the two functors, such
that for every index `λ` the square
```
   R_λ --f_λ--> S_λ
    |            |
  ι^R_λ        ι^S_λ
    v            v
    R ---g----> S
```
commutes.  Together with the universal property of `cR` (the colimit on the source side)
this forces the induced map on colimits to be exactly `g`, i.e. `R → S = ⟶ g`.
-/
def DirectedRingMapSystem.IsColimitEqual
    (D : DirectedRingMapSystem) {R S : Type} [CommRing R] [CommRing S] (g : R →+* S) :
    Prop :=
  ∃ (cR : Cocone D.FR) (_ : IsColimit cR) (hRpt : cR.pt = CommRingCat.of R)
    (cS : Cocone D.FS) (_ : IsColimit cS) (hSpt : cS.pt = CommRingCat.of S),
    ∀ a : D.Λ,
      (D.f.app a ≫ cS.ι.app a ≫ eqToHom hSpt).hom =
        (CommRingCat.ofHom g).hom.comp (cR.ι.app a ≫ eqToHom hRpt).hom

/-!
## Outline of the construction

The directed system is realized concretely as a directed family of `ℤ`-subalgebras of `R`
and `S`, with all transition and cocone maps being inclusions.

The argument is decomposed into the following building blocks, each developed in the
`SubalgebraSystem` namespace below:

* `Idx R S` — the index set: pairs `(E, F)` of finite subsets `E ⊆ R`, `F ⊆ S`, ordered
  componentwise by inclusion; a nonempty directed preorder.
* `Rsub`, `Ssub` — the subalgebra families `R_λ = ℤ[E]`, `S_λ = ℤ[F ∪ algebraMap '' E]`.
* `FRfunctor`, `FSfunctor` — the two functors `Idx R S ⥤ CommRingCat`.
* `fNat` — the natural transformation `FRfunctor ⟶ FSfunctor` given by restricting
  `algebraMap R S`.
* `coconeOfSubalgebra` / `isColimit_coconeOfSubalgebra` — a *reusable* lemma: for a directed
  family of subalgebras whose supremum is `⊤`, the inclusion cocone with apex the whole ring
  is a colimit in `CommRingCat`.
* `Rsub_iSup_top`, `Ssub_iSup_top` — the families exhaust `R` and `S`.
* finite-type and module-finiteness of the pieces.
-/

namespace SubalgebraSystem

variable {R S : Type} [CommRing R] [CommRing S] [Algebra R S]

/-- The `ℤ`-subalgebra of `R` generated by a finite set `E` (used both as `R_λ` and to phrase
the integrality condition of the index). -/
noncomputable def adj (E : Finset R) : Subalgebra ℤ R := Algebra.adjoin ℤ (E : Set R)

/-- Integrality over `adj E` is preserved when `E` grows: if `s : S` is integral over the
`ℤ`-subalgebra `ℤ[E]` and `E ⊆ E'`, then `s` is integral over `ℤ[E']`.

Indeed `adj E ≤ adj E'` (`Algebra.adjoin_mono`), and `S` is an algebra over both via the
scalar towers `adj E → R → S` and `adj E' → R → S`.  Integrality is monotone in the base
ring along a subalgebra inclusion: a monic witnessing polynomial over `adj E` has
coefficients that also lie in `adj E'` (push along `Subalgebra.inclusion`). -/
lemma isIntegral_adj_mono {E E' : Finset R} (h : E ⊆ E') {s : S}
    (hs : IsIntegral (adj E) s) : IsIntegral (adj E') s := by
  have hle : adj E ≤ adj E' := Algebra.adjoin_mono (Finset.coe_subset.mpr h)
  let : Algebra (adj E) (adj E') := (Subalgebra.inclusion hle).toAlgebra
  have : IsScalarTower (adj E) (adj E') S :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      simp [RingHom.algebraMap_toAlgebra, Subalgebra.inclusion]
      rfl)
  exact hs.tower_top

/-- The index set: pairs `(E, F)` of a finite subset `E ⊆ R` and a finite subset `F ⊆ S`,
together with the *integrality condition* that every `s ∈ F` is integral over `ℤ[E]`.

This condition is exactly what makes the construction work: it guarantees that each
generator of `S_λ` is integral over the base `R_λ`, hence `S_λ` is module-finite over
`R_λ`. -/
structure Idx (R S : Type) [CommRing R] [CommRing S] [Algebra R S] where
  /-- A finite subset of `R` (generators of the base ring `R_λ`). -/
  E : Finset R
  /-- A finite subset of `S` (extra generators of `S_λ`). -/
  F : Finset S
  /-- Each `s ∈ F` is integral over `R_λ = ℤ[E]`. -/
  cond : ∀ s ∈ F, IsIntegral (adj E) s

/-- Componentwise inclusion order on the index set (the integrality field is a `Prop`, so it
is ignored by the order). -/
instance idxPreorder : Preorder (Idx R S) where
  le x y := x.E ⊆ y.E ∧ x.F ⊆ y.F
  le_refl x := ⟨Finset.Subset.refl _, Finset.Subset.refl _⟩
  le_trans x y z h1 h2 :=
    ⟨Finset.Subset.trans h1.left h2.left, Finset.Subset.trans h1.right h2.right⟩

/-- The index set is nonempty: the pair of empty subsets satisfies the integrality
condition vacuously. -/
instance : Nonempty (Idx R S) := ⟨⟨∅, ∅, by simp⟩⟩

open Classical in
/-- The index preorder is directed: the upper bound of `(E,F)` and `(E',F')` is the
componentwise union `(E∪E', F∪F')`.  Its integrality condition holds because integrality
over `ℤ[E]` (resp. `ℤ[E']`) persists over the larger `ℤ[E∪E']` (`isIntegral_adj_mono`). -/
instance idxDirected : IsDirected (Idx R S) (· ≤ ·) where
  directed x y :=
    ⟨⟨x.E ∪ y.E, x.F ∪ y.F, by
        intro s hs
        rcases Finset.mem_union.mp hs with hsx | hsy
        · exact isIntegral_adj_mono Finset.subset_union_left (x.cond s hsx)
        · exact isIntegral_adj_mono Finset.subset_union_right (y.cond s hsy)⟩,
      show _ ∧ _ from ⟨Finset.subset_union_left, Finset.subset_union_left⟩,
      show _ ∧ _ from ⟨Finset.subset_union_right, Finset.subset_union_right⟩⟩

/-- `R_λ = ℤ[E]`, the `ℤ`-subalgebra of `R` generated by `E`. -/
noncomputable def Rsub (x : Idx R S) : Subalgebra ℤ R := adj x.E

/-- `S_λ = ℤ[F ∪ algebraMap '' E]`, the `ℤ`-subalgebra of `S` generated by `F` and the
image of `E`. -/
noncomputable def Ssub (x : Idx R S) : Subalgebra ℤ S :=
  Algebra.adjoin ℤ ((x.F : Set S) ∪ (algebraMap R S '' (x.E : Set R)))

/-- The base subalgebras are monotone in the index. -/
lemma Rsub_mono {x y : Idx R S} (h : x ≤ y) : Rsub x ≤ Rsub y :=
  Algebra.adjoin_mono (by exact_mod_cast Finset.coe_subset.mpr h.left)

/-- The top subalgebras are monotone in the index. -/
lemma Ssub_mono {x y : Idx R S} (h : x ≤ y) : Ssub x ≤ Ssub y :=
  Algebra.adjoin_mono (Set.union_subset_union
    (by exact_mod_cast Finset.coe_subset.mpr h.right)
    (Set.image_mono (by exact_mod_cast Finset.coe_subset.mpr h.left)))

/-- The image of `R_λ` under `algebraMap R S` lands inside `S_λ`: indeed `algebraMap R S`
sends the generators `E` of `R_λ` into the generators `algebraMap '' E ⊆ S_λ`, and `S_λ`
is a `ℤ`-subalgebra. -/
lemma algebraMap_Rsub_mem (x : Idx R S) {a : R} (ha : a ∈ Rsub x) :
    algebraMap R S a ∈ Ssub x := by
  -- Induct on membership in `Rsub x = adjoin ℤ E`. The generators map into
  -- `algebraMap '' E ⊆ Ssub x`; the operations are preserved since `Ssub x` is a subalgebra.
  induction ha using Algebra.adjoin_induction with
  | mem r hr =>
      apply Algebra.subset_adjoin
      exact Set.mem_union_right _ (Set.mem_image_of_mem _ hr)
  | algebraMap z =>
      rw [← IsScalarTower.algebraMap_apply ℤ R S z]; exact (Ssub x).algebraMap_mem z
  | add p q _ _ hp hq => rw [map_add]; exact (Ssub x).add_mem hp hq
  | mul p q _ _ hp hq => rw [map_mul]; exact (Ssub x).mul_mem hp hq

/-- The restricted map `f_λ : R_λ → S_λ`, the corestriction to `S_λ` of
`(algebraMap R S) ∘ (inclusion R_λ ↪ R)`. -/
noncomputable def fRingHom (x : Idx R S) : Rsub x →+* Ssub x where
  toFun a := ⟨algebraMap R S a.val, algebraMap_Rsub_mem x a.property⟩
  map_one' := by ext; simp
  map_mul' a b := by ext; simp
  map_zero' := by ext; simp
  map_add' a b := by ext; simp

/-- The `R`-side functor `λ ↦ R_λ`, transition maps are subring inclusions. -/
noncomputable def FRfunctor : Idx R S ⥤ CommRingCat where
  obj x := CommRingCat.of (Rsub x)
  map {x y} h := CommRingCat.ofHom (Subalgebra.inclusion (Rsub_mono h.le)).toRingHom
  -- Functoriality is automatic: compositions of subalgebra inclusions are inclusions, and
  -- the identity inclusion is the identity. Trivial but slow under `respectTransparency`;
  -- discharge with `CommRingCat.hom_ext` + `Subalgebra.inclusion_inclusion`/`inclusion_self`.
  map_id x := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_ofHom, CommRingCat.hom_id]
    exact RingHom.ext fun a => Subtype.ext (Subalgebra.coe_inclusion _ a)
  map_comp {x y z} f g := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom]
    refine RingHom.ext fun a => Subtype.ext ?_
    rw [RingHom.comp_apply]
    exact (Subalgebra.coe_inclusion _ a).trans
      ((Subalgebra.coe_inclusion _ _).trans (Subalgebra.coe_inclusion _ a)).symm

/-- The `S`-side functor `λ ↦ S_λ`, transition maps are subring inclusions. -/
noncomputable def FSfunctor : Idx R S ⥤ CommRingCat where
  obj x := CommRingCat.of (Ssub x)
  map {x y} h := CommRingCat.ofHom (Subalgebra.inclusion (Ssub_mono h.le)).toRingHom
  -- As for `FRfunctor`.
  map_id x := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_ofHom, CommRingCat.hom_id]
    exact RingHom.ext fun a => Subtype.ext (Subalgebra.coe_inclusion _ a)
  map_comp {x y z} f g := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom]
    refine RingHom.ext fun a => Subtype.ext ?_
    rw [RingHom.comp_apply]
    exact (Subalgebra.coe_inclusion _ a).trans
      ((Subalgebra.coe_inclusion _ _).trans (Subalgebra.coe_inclusion _ a)).symm

-- needed: `fNat`'s `rw [RingHom.comp_apply]`/`Subalgebra.coe_inclusion` step only matches
-- with defeq unfolding the `Rsub`/`Ssub` subalgebra coercions.
set_option backward.isDefEq.respectTransparency false in
/-- The compatible family `f_λ : R_λ → S_λ` as a natural transformation. -/
noncomputable def fNat : (FRfunctor (R := R) (S := S)) ⟶ FSfunctor where
  app x := CommRingCat.ofHom (fRingHom x)
  -- Naturality: both composites send `a ∈ R_λ` to `algebraMap R S a ∈ S_μ`; the squares
  -- of inclusions/restrictions commute on underlying elements. Discharge with
  -- `CommRingCat.hom_ext` + `RingHom.ext`, computing both sides as `algebraMap R S a`.
  naturality := by
    intro X Y f
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom]
    apply RingHom.ext
    intro a
    apply Subtype.ext
    rw [RingHom.comp_apply, RingHom.comp_apply]
    have hR : (FRfunctor.map f).hom = (Subalgebra.inclusion (Rsub_mono f.le)).toRingHom :=
      CommRingCat.hom_ofHom _
    have hS : (FSfunctor.map f).hom = (Subalgebra.inclusion (Ssub_mono f.le)).toRingHom :=
      CommRingCat.hom_ofHom _
    rw [hR, hS]
    change (algebraMap R S) ((Subalgebra.inclusion (Rsub_mono f.le) a : Rsub Y) : R)
      = ((Subalgebra.inclusion (Ssub_mono f.le) (fRingHom X a) : Ssub Y) : S)
    rw [Subalgebra.coe_inclusion, Subalgebra.coe_inclusion]
    rfl

/-!
### The colimit lemma (reusable)

For a directed family of `ℤ`-subalgebras `K : ι → Subalgebra ℤ A` (monotone, indexed by a
nonempty directed preorder) whose supremum is `⊤`, the inclusion cocone with apex
`CommRingCat.of A` is a colimit.
-/

/-- The inclusion cocone with apex `CommRingCat.of A` for a monotone family of subalgebras
`K`: the leg at `i` is the inclusion `K i ↪ A` (as `Subalgebra.val`). -/
noncomputable def coconeOfSubalgebra {ι : Type} [Preorder ι] {A : Type} [CommRing A]
    [Algebra ℤ A] (K : ι → Subalgebra ℤ A) (hK : Monotone K)
    (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i))
    (hFmap : ∀ {i j : ι} (h : i ⟶ j),
      F.map h = eqToHom (hFobj i) ≫
        CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom ≫ eqToHom (hFobj j).symm) :
    Cocone F where
  pt := CommRingCat.of A
  ι :=
    { app := fun i =>
        eqToHom (hFobj i) ≫ CommRingCat.ofHom (Subalgebra.val (K i)).toRingHom
      -- Naturality: `val (K j) ∘ inclusion = val (K i)` (`Subalgebra.val_comp_inclusion`).
      naturality := by
        intro X Y f
        apply CommRingCat.hom_ext
        rw [hFmap f]
        simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id,
          Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
        rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_comp,
          CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
        apply RingHom.ext
        intro a
        rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply]
        set b := (CommRingCat.Hom.hom (eqToHom (hFobj X))) a with hb
        change ((Subalgebra.val (K Y)) (Subalgebra.inclusion (hK f.le) b) : A)
          = ((Subalgebra.val (K X)) b : A)
        rw [Subalgebra.coe_val, Subalgebra.coe_val, Subalgebra.coe_inclusion] }

/-- The cocone leg at `i`, viewed as a `ℤ`-algebra hom `K i →ₐ[ℤ] s.pt` (any ring hom between
`ℤ`-algebras is automatically a `ℤ`-algebra hom). -/
noncomputable def legAlg {ι : Type} [Preorder ι] {A : Type} [CommRing A] [Algebra ℤ A]
    (K : ι → Subalgebra ℤ A) (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i)) (s : Cocone F) (i : ι) : (K i) →ₐ[ℤ] s.pt :=
  { toRingHom := (eqToHom (hFobj i).symm ≫ s.ι.app i).hom
    commutes' := by
      intro r
      change (eqToHom (hFobj i).symm ≫ s.ι.app i).hom (algebraMap ℤ _ r) = algebraMap ℤ _ r
      simp only [algebraMap_int_eq, eq_intCast, map_intCast] }

/-- Compatibility of `legAlg` along a morphism `i ⟶ k` of the index: the leg at `i` factors as
the leg at `k` precomposed with the inclusion `K i ↪ K k`.  This is the cocone naturality of `s`
combined with the description `hFmap` of `F.map`. -/
lemma legAlg_compat {ι : Type} [Preorder ι] {A : Type} [CommRing A] [Algebra ℤ A]
    (K : ι → Subalgebra ℤ A) (hK : Monotone K) (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i))
    (hFmap : ∀ {i j : ι} (h : i ⟶ j),
      F.map h = eqToHom (hFobj i) ≫
        CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom ≫ eqToHom (hFobj j).symm)
    (s : Cocone F) {i k : ι} (h : i ⟶ k) (x : ↥(K i)) :
    legAlg K F hFobj s i x = legAlg K F hFobj s k (Subalgebra.inclusion (hK h.le) x) := by
  show (eqToHom (hFobj i).symm ≫ s.ι.app i).hom x
      = (eqToHom (hFobj k).symm ≫ s.ι.app k).hom (Subalgebra.inclusion (hK h.le) x)
  have hnat : F.map h ≫ s.ι.app k = s.ι.app i := by
    simpa only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id] using
      s.ι.naturality h
  have key : eqToHom (hFobj i).symm ≫ s.ι.app i
      = CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom
        ≫ eqToHom (hFobj k).symm ≫ s.ι.app k := by
    rw [← hnat, hFmap h]
    simp only [Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  simpa using congrArg (fun m => CommRingCat.Hom.hom m x) key

/-- The compatibility hypothesis required by `Subalgebra.iSupLift`: for `K i ≤ K j` the leg at
`i` is the leg at `j` precomposed with the inclusion.  This holds even for incomparable `i, j`
(in the index) by going up to a common upper bound `m` (directedness). -/
lemma legAlg_hf {ι : Type} [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    {A : Type} [CommRing A] [Algebra ℤ A]
    (K : ι → Subalgebra ℤ A) (hK : Monotone K) (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i))
    (hFmap : ∀ {i j : ι} (h : i ⟶ j),
      F.map h = eqToHom (hFobj i) ≫
        CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom ≫ eqToHom (hFobj j).symm)
    (s : Cocone F) (i j : ι) (h : K i ≤ K j) :
    legAlg K F hFobj s i = (legAlg K F hFobj s j).comp (Subalgebra.inclusion h) := by
  obtain ⟨m, him, hjm⟩ := (directed_of (· ≤ ·) i j)
  ext x
  rw [AlgHom.comp_apply, legAlg_compat K hK F hFobj hFmap s (homOfLE him) x,
    legAlg_compat K hK F hFobj hFmap s (homOfLE hjm) (Subalgebra.inclusion h x)]
  congr 1

/-- The descent `ℤ`-algebra hom `A →ₐ[ℤ] s.pt` induced by another cocone `s`, glued from the
legs `legAlg` via `Subalgebra.iSupLift` over `⊤ = ⨆ i, K i` and the iso `A ≃ ⊤`. -/
noncomputable def descAlg {ι : Type} [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    {A : Type} [CommRing A] [Algebra ℤ A]
    (K : ι → Subalgebra ℤ A) (hK : Monotone K) (hsup : ⨆ i, K i = ⊤) (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i))
    (hFmap : ∀ {i j : ι} (h : i ⟶ j),
      F.map h = eqToHom (hFobj i) ≫
        CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom ≫ eqToHom (hFobj j).symm)
    (s : Cocone F) : A →ₐ[ℤ] s.pt :=
  (Subalgebra.iSupLift K hK.directed_le (legAlg K F hFobj s)
    (legAlg_hf K hK F hFobj hFmap s) ⊤ (le_of_eq hsup.symm)).comp
      (Subalgebra.topEquiv).symm.toAlgHom

/-- On an element `↑x` coming from `K i`, the descent map agrees with the leg `legAlg s i`. -/
lemma descAlg_val {ι : Type} [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    {A : Type} [CommRing A] [Algebra ℤ A]
    (K : ι → Subalgebra ℤ A) (hK : Monotone K) (hsup : ⨆ i, K i = ⊤) (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i))
    (hFmap : ∀ {i j : ι} (h : i ⟶ j),
      F.map h = eqToHom (hFobj i) ≫
        CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom ≫ eqToHom (hFobj j).symm)
    (s : Cocone F) (i : ι) (x : ↥(K i)) :
    descAlg K hK hsup F hFobj hFmap s (x : A) = legAlg K F hFobj s i x := by
  rw [descAlg, AlgHom.comp_apply]
  have hmem : (x : A) ∈ (⊤ : Subalgebra ℤ A) := trivial
  have heq : (Subalgebra.topEquiv).symm.toAlgHom (x : A) = ⟨(x : A), hmem⟩ := rfl
  rw [heq]
  exact Subalgebra.iSupLift_mk (T := ⊤) (hT := le_of_eq hsup.symm) K x hmem

-- needed: `isColimit_coconeOfSubalgebra`'s `Subalgebra.iSupLift` rewrite needs defeq to
-- unfold the `CommRingCat` bundling around the subalgebra legs.
set_option backward.isDefEq.respectTransparency false in
/-- **Reusable colimit lemma.** If `K` is a monotone family of `ℤ`-subalgebras indexed by a
nonempty directed preorder, and `⨆ i, K i = ⊤`, then the inclusion cocone
`coconeOfSubalgebra K hK F hFobj hFmap` is a colimit in `CommRingCat`.

Proof outline.  The family is directed (`hK.directed_le`), so by
`Subalgebra.coe_iSup_of_directed` the union of the `K i` (as sets) is `↑(⨆ i, K i) = ⊤ = A`,
i.e. every `a : A` lies in some `K i`.  Given any other cocone `c : Cocone F` with apex `B`,
the descent map `A →+* B` comes from `Subalgebra.iSupLift` applied to the legs of `c`
(transported through `hFobj`), with `T = ⊤`.  The `fac` and `uniq` colimit obligations then
follow because the legs `K i ↪ A` are jointly surjective: `fac` from the compatibility of
`iSupLift` with the legs, and `uniq` because two ring maps out of `A` agreeing on every
`K i` agree on `A`.

(`def`, not `lemma`: `IsColimit` is data — the universal cocone witness — not a `Prop`.) -/
noncomputable def isColimit_coconeOfSubalgebra {ι : Type} [Preorder ι] [Nonempty ι]
    [IsDirected ι (· ≤ ·)] {A : Type} [CommRing A] [Algebra ℤ A]
    (K : ι → Subalgebra ℤ A) (hK : Monotone K) (hsup : ⨆ i, K i = ⊤)
    (F : ι ⥤ CommRingCat)
    (hFobj : ∀ i, F.obj i = CommRingCat.of (K i))
    (hFmap : ∀ {i j : ι} (h : i ⟶ j),
      F.map h = eqToHom (hFobj i) ≫
        CommRingCat.ofHom (Subalgebra.inclusion (hK h.le)).toRingHom ≫ eqToHom (hFobj j).symm) :
    IsColimit (coconeOfSubalgebra K hK F hFobj hFmap) := by
  refine IsColimit.mk (fun s => CommRingCat.ofHom (descAlg K hK hsup F hFobj hFmap s).toRingHom)
    (fun s i => ?_) (fun s m hm => ?_)
  · -- fac: the inclusion `K i ↪ A` followed by the descent map is the leg `s.ι.app i`.
    change (eqToHom (hFobj i) ≫ CommRingCat.ofHom (Subalgebra.val (K i)).toRingHom)
          ≫ CommRingCat.ofHom (descAlg K hK hsup F hFobj hFmap s).toRingHom = s.ι.app i
    have hgoal : CommRingCat.ofHom (Subalgebra.val (K i)).toRingHom
          ≫ CommRingCat.ofHom (descAlg K hK hsup F hFobj hFmap s).toRingHom
        = eqToHom (hFobj i).symm ≫ s.ι.app i := by
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      exact RingHom.ext fun x => descAlg_val K hK hsup F hFobj hFmap s i x
    rw [Category.assoc, hgoal, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp]
  · -- uniq: any `m` agreeing with the legs equals the descent map, by joint surjectivity.
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    have hmem : a ∈ (⨆ i, K i) := by rw [hsup]; trivial
    rw [← SetLike.mem_coe, Subalgebra.coe_iSup_of_directed hK.directed_le] at hmem
    obtain ⟨_, ⟨i, rfl⟩, (hai : a ∈ K i)⟩ := hmem
    have key : CommRingCat.ofHom (Subalgebra.val (K i)).toRingHom ≫ m
        = eqToHom (hFobj i).symm ≫ s.ι.app i := by
      have hmi : (eqToHom (hFobj i) ≫ CommRingCat.ofHom (Subalgebra.val (K i)).toRingHom) ≫ m
          = s.ι.app i := hm i
      rw [← hmi, ← Category.assoc, ← Category.assoc, eqToHom_trans, eqToHom_refl,
        Category.id_comp]
    have hmleg : m.hom a = legAlg K F hFobj s i ⟨a, hai⟩ := by
      have := congrArg (fun mm => CommRingCat.Hom.hom mm (⟨a, hai⟩ : ↥(K i))) key
      simp only [legAlg]
      exact this
    change m.hom a = (CommRingCat.ofHom (descAlg K hK hsup F hFobj hFmap s).toRingHom).hom a
    rw [CommRingCat.hom_ofHom, hmleg]
    exact (descAlg_val K hK hsup F hFobj hFmap s i ⟨a, hai⟩).symm

/-! ### Exhaustion of `R` and `S` -/

/-- The base subalgebras exhaust `R`: `⨆ x, R_x = ⊤`, since `r ∈ R_⟨{r},∅⟩`.

Note the witness `⟨{r}, ∅, by simp⟩` has empty `F`, so its integrality condition is vacuous. -/
lemma Rsub_iSup_top : ⨆ x : Idx R S, Rsub x = ⊤ := by
  -- Strategy: `Algebra.eq_top_iff`; given `r`, use `x = ⟨{r}, ∅, by simp⟩`, then
  -- `Algebra.mem_iSup_of_mem x` + `Algebra.subset_adjoin (mem_singleton)`.
  rw [Algebra.eq_top_iff]
  intro r
  have hr : r ∈ Rsub (⟨{r}, ∅, by simp⟩ : Idx R S) := Algebra.subset_adjoin (by simp)
  exact Algebra.mem_iSup_of_mem _ hr

/-- The top subalgebras exhaust `S`: `⨆ x, S_x = ⊤`.

Here we *use* that `S` is integral over `R`.  Given `s : S`, integrality gives a monic
`p ∈ R[X]` with `aeval s p = 0`.  Take `E := p.coeffs` (the finite set of coefficients of `p`,
in `R`) and `F := {s}`; then `s` is integral over `ℤ[E]` (its monic polynomial `p` has all
coefficients in `E ⊆ ℤ[E]`, so view `p` over `ℤ[E]`), giving a valid index
`x = ⟨E, {s}, …⟩`.  Since `s ∈ F`, `s ∈ S_x = ℤ[F ∪ algebraMap '' E]`
(`Algebra.subset_adjoin`), so `s ∈ ⨆ x, S_x` (`Algebra.mem_iSup_of_mem`).  Then conclude with
`Algebra.eq_top_iff`. -/
lemma Ssub_iSup_top [Algebra.IsIntegral R S] : ⨆ x : Idx R S, Ssub x = ⊤ := by
  -- Strategy: see the docstring. Use `Algebra.IsIntegral.isIntegral s` to get the monic `p`,
  -- set `E := p.coeffs`, `F := {s}`; the `cond` field follows because the coefficients of `p`
  -- lie in `adj E` (each `p.coeff i ∈ E ⊆ adj E` via `Algebra.subset_adjoin`, so `p` lifts to
  -- a monic poly over `adj E` annihilating `s`).
  rw [Algebra.eq_top_iff]
  intro s
  obtain ⟨p, hmonic, hp⟩ := (Algebra.IsIntegral.isIntegral (R := R) s)
  -- Each coefficient of `p` lies in `adj p.coeffs`.
  have hcoeff : ∀ i, p.coeff i ∈ adj (R := R) p.coeffs := by
    intro i
    by_cases h0 : p.coeff i = 0
    · rw [h0]; exact (adj p.coeffs).zero_mem
    · exact Algebra.subset_adjoin (Polynomial.coeff_mem_coeffs h0)
  -- `s` is integral over `adj p.coeffs`.
  have hint : IsIntegral (adj (R := R) p.coeffs) s := by
    have hsub : (↑p.coeffs : Set R) ⊆ (↑(adj (R := R) p.coeffs).toSubring : Set R) := by
      intro c hc
      simp only [Subalgebra.coe_toSubring]
      obtain ⟨n, _, rfl⟩ := Polynomial.mem_coeffs_iff.mp hc
      exact hcoeff n
    refine ⟨p.toSubring (adj p.coeffs).toSubring hsub, ?_, ?_⟩
    · rw [Polynomial.monic_toSubring]; exact hmonic
    · have hmap : algebraMap (adj (R := R) p.coeffs) S
          = (algebraMap R S).comp (adj p.coeffs).toSubring.subtype := by
        ext x
        exact Eq.symm (RingHom.congr_fun rfl ((adj p.coeffs).val x))
      rw [show Polynomial.eval₂ (algebraMap (adj (R := R) p.coeffs) S) s
              (p.toSubring (adj p.coeffs).toSubring hsub)
            = Polynomial.eval₂ ((algebraMap R S).comp (adj p.coeffs).toSubring.subtype) s
                (p.toSubring (adj p.coeffs).toSubring hsub) from by rw [hmap]]
      rw [← Polynomial.eval₂_map, Polynomial.map_toSubring]
      rw [← Polynomial.aeval_def]
      exact hp
  -- Build the index `x = ⟨p.coeffs, {s}, …⟩`.
  set x : Idx R S := ⟨p.coeffs, {s}, by
    intro t ht
    rw [Finset.mem_singleton] at ht
    subst ht
    exact hint⟩ with hx
  -- `s ∈ Ssub x` since `s ∈ F`.
  have hmem : s ∈ Ssub x := by
    apply Algebra.subset_adjoin
    apply Set.mem_union_left
    show s ∈ ((x.F : Finset S) : Set S)
    rw [hx]
    simp
  exact Algebra.mem_iSup_of_mem x hmem

/-! ### Finite type and module finiteness -/

/-- Each base ring `R_λ = ℤ[E]` is of finite type over `ℤ` because `E` is finite
(`Algebra.FiniteType.adjoin_of_finite`). -/
lemma Rsub_finiteType (x : Idx R S) : Algebra.FiniteType ℤ (Rsub x) :=
  Algebra.FiniteType.adjoin_of_finite (x.E.finite_toSet)

/-- Each `s ∈ F` is integral over `R_λ`.  This is now immediate from the integrality
condition `Idx.cond` baked into the index: `Rsub x = ℤ[E] = adj x.E`, and `x.cond` says
exactly that every `s ∈ F` is integral over `adj x.E`. -/
lemma F_mem_isIntegral_Rsub (x : Idx R S) {s : S} (hs : s ∈ (x.F : Set S)) :
    IsIntegral (Rsub x) s :=
  x.cond s (by exact_mod_cast hs)

/-- Each map `f_λ : R_λ → S_λ` is module-finite.

Proof outline.  `S_λ` is generated as an `R_λ`-algebra by the finite set `F` (the image of `E`
already lies in `R_λ`'s image, hence in the `R_λ`-subalgebra generated by `F`).  Each `s ∈ F`
is integral over `R_λ` (`F_mem_isIntegral_Rsub`).  A finitely generated algebra generated by
integral elements is module-finite — Stacks 00GK / Mathlib
`Algebra.finite_adjoin_of_finite_of_isIntegral` — giving `Module.Finite R_λ S_λ`, equivalently
`(f_λ).Finite`.  Alternatively use `RingHom.finite_iff_isIntegral_and_finiteType` (02JJ):
`f_λ` is finite type (from `Rsub_finiteType` + base change) and integral, hence finite. -/
lemma fRingHom_finite (x : Idx R S) : RingHom.Finite (fRingHom x) := by
  let := (fRingHom x).toAlgebra
  rw [RingHom.finite_iff_isIntegral_and_finiteType]
  refine ⟨?_, ?_⟩
  · -- IsIntegral: every element of Ssub x is integral over Rsub x.
    have hAlgInt : Algebra.IsIntegral (Rsub x) (Ssub x) := by
      -- Scalar tower `Rsub x → Ssub x → S`: `algebraMap (Rsub x) S` factors through `Ssub x`.
      have htowerS : IsScalarTower (Rsub x) (Ssub x) S :=
        IsScalarTower.of_algebraMap_eq (fun a => by
          show algebraMap R S (a : R) = ((fRingHom x a : Ssub x) : S)
          rfl)
      -- Each element of `S` that lies in `Ssub x` is integral over `Rsub x`.
      have key : ∀ s ∈ Ssub x, IsIntegral (Rsub x) s := by
        intro s hs
        induction hs using Algebra.adjoin_induction with
        | mem r hr =>
            rcases hr with hF | ⟨a, ha, rfl⟩
            · exact F_mem_isIntegral_Rsub x hF
            · -- `algebraMap R S a` with `a ∈ E ⊆ Rsub x` is `fRingHom`'s value, hence integral.
              exact isIntegral_algebraMap (x := (⟨a, Algebra.subset_adjoin ha⟩ : Rsub x))
        | algebraMap z =>
            rw [IsScalarTower.algebraMap_apply ℤ (Rsub x) S z]
            exact isIntegral_algebraMap
        | add p q _ _ hp hq => exact hp.add hq
        | mul p q _ _ hp hq => exact hp.mul hq
      exact ⟨fun y => IsIntegral.tower_bot Subtype.val_injective (key y.val y.property)⟩
    exact hAlgInt.isIntegral
  · -- FiniteType: Ssub x is finite type over Rsub x.
    show Algebra.FiniteType (Rsub x) (Ssub x)
    have hZ : Algebra.FiniteType ℤ (Ssub x) :=
      Algebra.FiniteType.adjoin_of_finite (Set.Finite.union (x.F.finite_toSet)
        (Set.Finite.image _ (x.E.finite_toSet)))
    exact Algebra.FiniteType.of_restrictScalars_finiteType ℤ (Rsub x) (Ssub x)

/-! ### Assembling the directed system -/

/-- The directed system of ring maps witnessing Stacks 0BTG for the integral map
`algebraMap R S`. -/
noncomputable def system (R S : Type) [CommRing R] [CommRing S] [Algebra R S] :
    DirectedRingMapSystem where
  Λ := Idx R S
  preorder := idxPreorder
  nonempty := inferInstance
  directed := idxDirected
  FR := FRfunctor
  FS := FSfunctor
  f := fNat

end SubalgebraSystem

-- needed: `integral_isColimit_directed_finite_of_finiteType`'s `simp` steps and the kernel
-- check of its `system` cocone require defeq through `CommRingCat.of`/`Subalgebra` coercions.
set_option backward.isDefEq.respectTransparency false in
/--
If `S` is integral over `R`, then the algebra map `R → S` is a filtered colimit of a
directed system of module-finite ring maps `f_λ : R_λ → S_λ` whose bases `R_λ` are of
finite type over `ℤ`.
-/
@[stacks 0BTG]
theorem integral_isColimit_directed_finite_of_finiteType
    (R S : Type) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S] :
    ∃ D : DirectedRingMapSystem,
      -- (1) Colimit: the colimit of the system equals the structural map `R → S`.
      D.IsColimitEqual (algebraMap R S) ∧
      -- (2) Finite type base: each `R_λ` is of finite type over `Z`.
      (∀ a : D.Λ, Algebra.FiniteType ℤ (D.FR.obj a)) ∧
      -- (3) Module-finite: each `f_λ : R_λ → S_λ` is finite.
      (∀ a : D.Λ, RingHom.Finite (D.f.app a).hom) := by
  classical
  -- Use the concrete directed system built above.
  refine ⟨SubalgebraSystem.system R S, ?_, ?_, ?_⟩
  · -- (1) Colimit equals `algebraMap R S`.
    -- Strategy: take `cR = coconeOfSubalgebra Rsub … `, `cS = coconeOfSubalgebra Ssub …`,
    -- with `IsColimit` from `isColimit_coconeOfSubalgebra` (using `Rsub_iSup_top` /
    -- `Ssub_iSup_top`). Both apexes are defeq `CommRingCat.of R`, `CommRingCat.of S`, so
    -- `hRpt`, `hSpt` are `rfl` and `eqToHom _ = 𝟙`. The commuting square then says: for
    -- `a ∈ R_λ`, `algebraMap R S` of the image of `a` in `R` equals the image in `S` of
    -- `f_λ a` — true since `f_λ` is the restriction of `algebraMap R S` (`fRingHom`).
    -- Discharge the square with `CommRingCat.hom_ext` + `RingHom.ext`.
    have hFRobj : ∀ i, (SubalgebraSystem.FRfunctor (R := R) (S := S)).obj i
        = CommRingCat.of (SubalgebraSystem.Rsub i) := fun _ => rfl
    have hFRmap : ∀ {i j : SubalgebraSystem.Idx R S} (h : i ⟶ j),
        (SubalgebraSystem.FRfunctor (R := R) (S := S)).map h = eqToHom (hFRobj i) ≫
          CommRingCat.ofHom (Subalgebra.inclusion (SubalgebraSystem.Rsub_mono h.le)).toRingHom
            ≫ eqToHom (hFRobj j).symm := fun h => by
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id]; rfl
    have hFSobj : ∀ i, (SubalgebraSystem.FSfunctor (R := R) (S := S)).obj i
        = CommRingCat.of (SubalgebraSystem.Ssub i) := fun _ => rfl
    have hFSmap : ∀ {i j : SubalgebraSystem.Idx R S} (h : i ⟶ j),
        (SubalgebraSystem.FSfunctor (R := R) (S := S)).map h = eqToHom (hFSobj i) ≫
          CommRingCat.ofHom (Subalgebra.inclusion (SubalgebraSystem.Ssub_mono h.le)).toRingHom
            ≫ eqToHom (hFSobj j).symm := fun h => by
      simp only [eqToHom_refl, Category.id_comp, Category.comp_id]; rfl
    refine ⟨SubalgebraSystem.coconeOfSubalgebra SubalgebraSystem.Rsub
        (fun _ _ h => SubalgebraSystem.Rsub_mono h)
        SubalgebraSystem.FRfunctor hFRobj hFRmap,
      SubalgebraSystem.isColimit_coconeOfSubalgebra SubalgebraSystem.Rsub
        (fun _ _ h => SubalgebraSystem.Rsub_mono h)
        SubalgebraSystem.Rsub_iSup_top SubalgebraSystem.FRfunctor hFRobj hFRmap,
      rfl,
      SubalgebraSystem.coconeOfSubalgebra SubalgebraSystem.Ssub
        (fun _ _ h => SubalgebraSystem.Ssub_mono h)
        SubalgebraSystem.FSfunctor hFSobj hFSmap,
      SubalgebraSystem.isColimit_coconeOfSubalgebra SubalgebraSystem.Ssub
        (fun _ _ h => SubalgebraSystem.Ssub_mono h)
        SubalgebraSystem.Ssub_iSup_top SubalgebraSystem.FSfunctor hFSobj hFSmap,
      rfl, ?_⟩
    intro a
    apply RingHom.ext
    intro x
    simp only [eqToHom_refl, Category.comp_id, CommRingCat.hom_comp,
      CommRingCat.hom_ofHom, RingHom.comp_apply]
    rfl
  · -- (2) Finite type base.
    intro a
    -- `D.FR.obj a = CommRingCat.of (Rsub a)`; reduce to `SubalgebraSystem.Rsub_finiteType`.
    exact SubalgebraSystem.Rsub_finiteType a
  · -- (3) Module-finite.
    intro a
    -- `(D.f.app a).hom = fRingHom a` up to the `CommRingCat.ofHom`/`.hom` round-trip
    -- (`CommRingCat.hom_ofHom`); reduce to `SubalgebraSystem.fRingHom_finite`.
    show RingHom.Finite (CommRingCat.ofHom (SubalgebraSystem.fRingHom a)).hom
    rw [CommRingCat.hom_ofHom]
    exact SubalgebraSystem.fRingHom_finite a
