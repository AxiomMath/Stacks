module

public import Mathlib.LinearAlgebra.Matrix.Charpoly.LinearMap
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# A short exact sequence from two nonzerodivisors

Let `R` be a commutative ring and `x, y ∈ R` nonzerodivisors. Form the
localizations `R_x`, `R_y`, `R_{xy}` (localizing away from `x`, `y`, and `xy`
respectively). Since `x, y` are nonzerodivisors all of these localization maps
are injective, and we regard `R` as a subring of each.

Inside `R_{xy}` both `x` and `y` are invertible; write `x/y := x · y⁻¹` and
`y/x := y · x⁻¹`, so `(x/y)(y/x) = 1`. Form the `R`-subalgebras
`R[x/y]`, `R[y/x]`, `R[x/y, y/x]` of `R_{xy}`.

Consider the two `R`-linear maps
* `f : R → R[x/y] ⊕ R[y/x]`, `f(r) = (-r, r)`  (the map `(-1, 1)`), and
* `g : R[x/y] ⊕ R[y/x] → R[x/y, y/x]`, `g(a, b) = ι₁ a + ι₂ b`
  (the map `(1, 1)`, addition inside `R_{xy}`).

If `R` is integrally closed in `R_x`, or `R` is integrally closed in `R_y`, then
`0 → R → R[x/y] ⊕ R[y/x] → R[x/y, y/x] → 0`
is a short exact sequence of `R`-modules:
1. `f` is injective;
2. `im f = ker g` (equivalently `R[x/y] ∩ R[y/x] = R` inside `R_{xy}`);
3. `g` is surjective.

This is Stacks Tag 052J. Here "`R` is integrally closed in `R_z`" means that every
`α ∈ R_z` integral over `R` lies in the image of the localization map `R → R_z`,
that is in the bottom subalgebra `⊥`.

## Main results

* `shortExact_fmap_gmap`: the three assertions above.
* `Axy_inf_Ayx_eq_bot`: exactness in the middle in its intrinsic form,
  `R[x/y] ∩ R[y/x] = R` inside `R_{xy}`.
* `gmap_surjective`: surjectivity of `g`, which needs no hypothesis. Injectivity
  of `f` needs only that `x` and `y` are nonzerodivisors; the integral-closedness
  hypothesis enters only through `Axy_inf_Ayx_eq_bot`.
* `toSubmodule_adjoin_pair_eq_sup`: `R[u, v] = R[u] + R[v]` as `R`-submodules
  whenever `u * v = 1`. This is what makes `g` surjective.
* `adjoin_inf_adjoin_le_integralClosure`: every element of `R[u] ∩ R[v]` is
  integral over `R` whenever `u * v = 1`. This is the integrality half of the
  middle exactness; the descent half, which places such an element in `R` once
  `R` is integrally closed in `R_x` or in `R_y`, is proved here for `x/y` and
  `y/x` only.

## Implementation notes

The two general lemmas `toSubmodule_adjoin_pair_eq_sup` and
`adjoin_inf_adjoin_le_integralClosure` carry the argument; both assume only
`u * v = 1`, which `x/y` and `y/x` satisfy. The integrality step inside the
second is Stacks 052I, proved here from `LinearMap.exists_monic_and_aeval_eq_zero`
(Stacks 05BT).
-/

@[expose] public section

open scoped nonZeroDivisors

variable {R : Type*} [CommRing R] (x y : R)

/-- `R_{xy}`, the localization of `R` away from `x * y` (this is the localization
at the submonoid generated by `x` and `y`). -/
abbrev Rxy := Localization.Away (x * y)

/-- The element `x/y := x · y⁻¹` inside `R_{xy}`. (`Ring.inverse` agrees with the
genuine inverse here because `y` is invertible in `R_{xy}`.) -/
noncomputable def xdivy : Rxy x y :=
  algebraMap R (Rxy x y) x * Ring.inverse (algebraMap R (Rxy x y) y)

/-- The element `y/x := y · x⁻¹` inside `R_{xy}`. -/
noncomputable def ydivx : Rxy x y :=
  algebraMap R (Rxy x y) y * Ring.inverse (algebraMap R (Rxy x y) x)

/-- `R[x/y]`, the `R`-subalgebra of `R_{xy}` generated by `x/y`. -/
noncomputable def Axy : Subalgebra R (Rxy x y) := Algebra.adjoin R {xdivy x y}

/-- `R[y/x]`, the `R`-subalgebra of `R_{xy}` generated by `y/x`. -/
noncomputable def Ayx : Subalgebra R (Rxy x y) := Algebra.adjoin R {ydivx x y}

/-- `R[x/y, y/x]`, the `R`-subalgebra of `R_{xy}` generated by `x/y` and `y/x`. -/
noncomputable def Axyyx : Subalgebra R (Rxy x y) :=
  Algebra.adjoin R {xdivy x y, ydivx x y}

/-- `R[x/y] ⊆ R[x/y, y/x]`. -/
theorem Axy_le : Axy x y ≤ Axyyx x y := by
  rw [Axy, Axyyx]; exact Algebra.adjoin_mono (by simp)

/-- `R[y/x] ⊆ R[x/y, y/x]`. -/
theorem Ayx_le : Ayx x y ≤ Axyyx x y := by
  rw [Ayx, Axyyx]; exact Algebra.adjoin_mono (by simp)

/-- The `R`-linear map `f(r) = (-r, r)` into `R[x/y] ⊕ R[y/x]`. -/
noncomputable def fmap : R →ₗ[R] (↥(Axy x y) × ↥(Ayx x y)) :=
  LinearMap.prod (-(Algebra.linearMap R ↥(Axy x y))) (Algebra.linearMap R ↥(Ayx x y))

/-- The `R`-linear map `g(a, b) = ι₁ a + ι₂ b` (addition inside `R_{xy}`). -/
noncomputable def gmap : (↥(Axy x y) × ↥(Ayx x y)) →ₗ[R] ↥(Axyyx x y) :=
  LinearMap.coprod (Subalgebra.inclusion (Axy_le x y)).toLinearMap
    (Subalgebra.inclusion (Ayx_le x y)).toLinearMap

-- Correctness statements characterizing the definitions

/-- `x` is a unit in `R_{xy}`. -/
private theorem isUnit_x : IsUnit (algebraMap R (Rxy x y) x) :=
  IsLocalization.Away.isUnit_of_dvd (x * y) (dvd_mul_right x y)

/-- `y` is a unit in `R_{xy}`. -/
private theorem isUnit_y : IsUnit (algebraMap R (Rxy x y) y) :=
  IsLocalization.Away.isUnit_of_dvd (x * y) (dvd_mul_left y x)

/-- `x/y` times `y` equals `x` inside `R_{xy}`: `x/y` is genuinely `x · y⁻¹`. -/
private theorem xdivy_mul_y :
    xdivy x y * algebraMap R (Rxy x y) y = algebraMap R (Rxy x y) x := by
  unfold xdivy
  rw [mul_assoc, Ring.inverse_mul_cancel _ (isUnit_y x y), mul_one]

/-- `y/x` times `x` equals `y` inside `R_{xy}`: `y/x` is genuinely `y · x⁻¹`. -/
private theorem ydivx_mul_x :
    ydivx x y * algebraMap R (Rxy x y) x = algebraMap R (Rxy x y) y := by
  unfold ydivx
  rw [mul_assoc, Ring.inverse_mul_cancel _ (isUnit_x x y), mul_one]

/-- `(x/y)(y/x) = 1` inside `R_{xy}`. -/
private theorem xdivy_mul_ydivx :
    xdivy x y * ydivx x y = 1 := by
  unfold xdivy ydivx
  rw [mul_comm (algebraMap R (Rxy x y) y), mul_mul_mul_comm,
    Ring.mul_inverse_cancel _ (isUnit_x x y), Ring.inverse_mul_cancel _ (isUnit_y x y), mul_one]

/-- The localization map `R → R_{xy}` is injective (since `x, y` are
nonzerodivisors). -/
private theorem injective_algebraMap_Rxy (hx : x ∈ R⁰) (hy : y ∈ R⁰) :
    Function.Injective (algebraMap R (Rxy x y)) :=
  IsLocalization.injective (Rxy x y) (Submonoid.powers_le.2 (mul_mem hx hy))

open Submodule in
/-- If `u * v = 1`, then `R[u, v] = R[u] + R[v]` as `R`-submodules. -/
theorem toSubmodule_adjoin_pair_eq_sup {R B : Type*} [CommSemiring R] [CommSemiring B]
    [Algebra R B] {u v : B} (huv : u * v = 1) :
    Subalgebra.toSubmodule (Algebra.adjoin R {u, v}) =
      Subalgebra.toSubmodule (Algebra.adjoin R {u}) ⊔
        Subalgebra.toSubmodule (Algebra.adjoin R {v}) := by
  refine le_antisymm ?_ (sup_le (Subalgebra.toSubmodule.le_iff_le.2 (Algebra.adjoin_mono (by simp)))
    (Subalgebra.toSubmodule.le_iff_le.2 (Algebra.adjoin_mono (by simp))))
  rw [Set.insert_eq, Algebra.adjoin_union_coe_submodule]
  conv_lhs => rw [Algebra.adjoin_eq_span, Algebra.adjoin_eq_span]
  rw [span_mul_span, span_le, Set.mul_subset_iff]
  simp only [SetLike.mem_coe, Submonoid.mem_closure_singleton, forall_exists_index,
    forall_apply_eq_imp_iff]
  intro i j
  rcases le_total i j with h | h <;> obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  · rw [pow_add, ← mul_assoc, ← mul_pow, huv, one_pow, one_mul]
    exact mem_sup_right ((Subalgebra.mem_toSubmodule _).2
      (pow_mem (Algebra.self_mem_adjoin_singleton R v) k))
  · rw [pow_add, mul_right_comm, ← mul_pow, huv, one_pow, one_mul]
    exact mem_sup_left ((Subalgebra.mem_toSubmodule _).2
      (pow_mem (Algebra.self_mem_adjoin_singleton R u) k))

/-- **Surjectivity of `g`**: `R[x/y, y/x] = R[x/y] + R[y/x]` because `(x/y)(y/x) = 1`. -/
theorem gmap_surjective : Function.Surjective (gmap x y) := by
  rintro ⟨c, hc⟩
  have hc' : c ∈ Subalgebra.toSubmodule (Axy x y) ⊔ Subalgebra.toSubmodule (Ayx x y) := by
    rw [Axy, Ayx, ← toSubmodule_adjoin_pair_eq_sup (xdivy_mul_ydivx x y)]
    rwa [Axyyx] at hc
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.1 hc'
  exact ⟨(⟨p, (Subalgebra.mem_toSubmodule _).1 hp⟩, ⟨q, (Subalgebra.mem_toSubmodule _).1 hq⟩),
    Subtype.ext (by simp [gmap])⟩

-- ===========================================================================
-- Exactness in the middle: `R[x/y] ∩ R[y/x] = R`
-- ===========================================================================

/-- General determinant-trick lemma: if `M` is a finitely-generated `R`-submodule
of an `R`-algebra `B` that contains `1` and is stable under multiplication by `α`,
then `α` is integral over `R`. -/
@[stacks 052I]
theorem isIntegral_of_fg_stable
    {R B : Type*} [CommRing R] [Ring B] [Algebra R B]
    (M : Submodule R B) (hMfg : M.FG) (h1 : (1 : B) ∈ M)
    (α : B) (hstable : ∀ z ∈ M, α * z ∈ M) :
    IsIntegral R α := by
  let φ : M →ₗ[R] M :=
    { toFun := fun z => ⟨α * z, hstable z z.property⟩
      map_add' := by intro a b; apply Subtype.ext; simp [mul_add]
      map_smul' := by intro r a; apply Subtype.ext; simp [Algebra.mul_smul_comm] }
  have hfin : Module.Finite R M := Module.Finite.iff_fg.mpr hMfg
  obtain ⟨p, hpmonic, hp⟩ := LinearMap.exists_monic_and_aeval_eq_zero R φ
  have hpow : ∀ n : ℕ, ((φ ^ n) ⟨1, h1⟩ : B) = α ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ k ih =>
      have hcomp : (φ ^ (k+1)) ⟨1, h1⟩ = φ ((φ^k) ⟨1, h1⟩) := by rw [pow_succ']; rfl
      rw [hcomp]
      show (α * ((φ ^ k) ⟨1, h1⟩ : B)) = α ^ (k+1)
      rw [ih, ← pow_succ']
  have hval : (((Polynomial.aeval φ) p) ⟨1, h1⟩ : B) = (Polynomial.aeval α) p := by
    rw [Polynomial.aeval_endomorphism]
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum]
    rw [Polynomial.sum, Polynomial.sum]
    rw [AddSubmonoidClass.coe_finsetSum]
    apply Finset.sum_congr rfl
    intro n hn
    rw [SetLike.val_smul, hpow, Algebra.smul_def]
  refine ⟨p, hpmonic, ?_⟩
  have hz : (((Polynomial.aeval φ) p) ⟨1, h1⟩ : B) = 0 := by rw [hp]; simp
  rw [hval] at hz
  exact hz

open Polynomial Submodule in
/-- If `u * v = 1`, every element of `R[u] ∩ R[v]` is integral over `R`: it stabilises the span
of `u ^ N, …, u, 1, v, …, v ^ N` for `N` large. -/
theorem adjoin_inf_adjoin_le_integralClosure {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]
    {u v : B} (huv : u * v = 1) :
    Algebra.adjoin R {u} ⊓ Algebra.adjoin R {v} ≤ integralClosure R B := by
  intro α hα
  rw [mem_integralClosure_iff]
  obtain ⟨p, rfl⟩ := Algebra.adjoin_mem_exists_aeval R u (Algebra.mem_inf.1 hα).1
  obtain ⟨q, hq⟩ := Algebra.adjoin_mem_exists_aeval R v (Algebra.mem_inf.1 hα).2
  set N := max p.natDegree q.natDegree
  let P (t : B) : Submodule R B := span R (Set.range fun i : Fin (N + 1) ↦ t ^ (i : ℕ))
  have pow_mem (t : B) {i : ℕ} (hi : i ≤ N) : t ^ i ∈ P t :=
    mem_span_of_mem (Set.mem_range_self (⟨i, Nat.lt_succ_of_le hi⟩ : Fin (N + 1)))
  have aeval_mem (t : B) (r : R[X]) (hr : r.natDegree ≤ N) : aeval t r ∈ P t := by
    rw [aeval_eq_sum_range' (Nat.lt_succ_of_le hr)]
    exact sum_mem fun i hi ↦ smul_mem _ _ (pow_mem t (Nat.lt_succ_iff.1 (Finset.mem_range.1 hi)))
  have hmul : P u * P v ≤ P u ⊔ P v := by
    rw [span_mul_span, span_le, Set.mul_subset_iff]
    simp only [Set.forall_mem_range]
    intro i j
    rcases le_total (i : ℕ) j with h | h <;> obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    · rw [hk, pow_add, ← mul_assoc, ← mul_pow, huv, one_pow, one_mul]
      exact mem_sup_right (pow_mem v (by omega))
    · rw [hk, pow_add, mul_right_comm, ← mul_pow, huv, one_pow, one_mul]
      exact mem_sup_left (pow_mem u (by omega))
  have hαu : aeval u p ∈ P u := aeval_mem u p (le_max_left _ _)
  have hαv : aeval u p ∈ P v := hq ▸ aeval_mem v q (le_max_right _ _)
  refine isIntegral_of_fg_stable (P u ⊔ P v)
    ((fg_span (Set.finite_range _)).sup (fg_span (Set.finite_range _)))
    (mem_sup_left (by simpa using pow_mem u (Nat.zero_le N))) (aeval u p) fun m hm ↦ ?_
  obtain ⟨a, ha, b, hb, rfl⟩ := mem_sup.1 hm
  rw [mul_add, mul_comm _ a]
  exact add_mem (hmul (mul_mem_mul ha hαv)) (hmul (mul_mem_mul hαu hb))

/-- Every element of `R[x/y] ∩ R[y/x]` is integral over `R`. -/
private theorem inter_isIntegral
    (α : Rxy x y) (hαx : α ∈ Axy x y) (hαy : α ∈ Ayx x y) :
    IsIntegral R α := by
  rw [Axy] at hαx
  rw [Ayx] at hαy
  exact (mem_integralClosure_iff R _).1
    (adjoin_inf_adjoin_le_integralClosure (xdivy_mul_ydivx x y) (Algebra.mem_inf.2 ⟨hαx, hαy⟩))

/-- **Descent through `R_z`.** Let `z ∈ R⁰` be invertible in `R_{xy}` and let `R` be integrally
closed in `R_z`. Then every integral `α ∈ R[w · z⁻¹] ⊆ R_{xy}` lies in `R`.

The comparison map `φ : R_z → R_{xy}` is injective, as `z` and `x * y` are nonzerodivisors, and
`w · z⁻¹` lies in its range; so `α = φ α₀`, and `α₀` is integral over `R` since `φ` is an
injective `R`-algebra map. Integral closedness then puts `α₀`, hence `α`, in `R`. -/
private theorem mem_bot_of_mem_adjoin_of_intClosed
    (hxy : Function.Injective (algebraMap R (Rxy x y)))
    (z w : R) (hz : z ∈ R⁰) (hg : IsUnit (algebraMap R (Rxy x y) z))
    (hcl : ∀ α : Localization.Away z, IsIntegral R α →
        α ∈ (⊥ : Subalgebra R (Localization.Away z)))
    (α : Rxy x y)
    (hα : α ∈ Algebra.adjoin R {algebraMap R (Rxy x y) w * Ring.inverse (algebraMap R (Rxy x y) z)})
    (hαint : IsIntegral R α) :
    α ∈ (⊥ : Subalgebra R (Rxy x y)) := by
  -- φ : the comparison R-algebra map R_z → R_xy
  let φ : Localization.Away z →ₐ[R] Rxy x y :=
    { IsLocalization.Away.lift z hg with
      commutes' := fun r => IsLocalization.Away.lift_eq z hg r }
  -- φ injective, both localization maps out of `R` being injective
  have hφinj : Function.Injective φ := by
    show Function.Injective (IsLocalization.Away.lift z hg)
    unfold IsLocalization.Away.lift
    rw [IsLocalization.lift_injective_iff]
    exact fun a b ↦ (IsLocalization.injective (Localization.Away z)
      (Submonoid.powers_le.2 hz)).eq_iff.trans hxy.eq_iff.symm
  -- general fact: φ preserves Ring.inverse on units coming from R
  have inv_comm : ∀ (a : R), IsUnit (algebraMap R (Localization.Away z) a) →
      φ (Ring.inverse (algebraMap R (Localization.Away z) a))
        = Ring.inverse (algebraMap R (Rxy x y) a) := by
    intro a ha
    have hfa := ha.map φ
    rw [φ.commutes] at hfa
    refine hfa.mul_right_cancel ?_
    rw [Ring.inverse_mul_cancel _ hfa, ← φ.commutes a, ← map_mul, Ring.inverse_mul_cancel _ ha,
      map_one]
  -- the generator is φ of (w · z⁻¹) ∈ R_z
  have hrange : algebraMap R (Rxy x y) w * Ring.inverse (algebraMap R (Rxy x y) z) ∈ φ.range := by
    refine (AlgHom.mem_range φ).2 ⟨algebraMap R (Localization.Away z) w
      * Ring.inverse (algebraMap R (Localization.Away z) z), ?_⟩
    rw [map_mul, φ.commutes w, inv_comm z (IsLocalization.Away.algebraMap_isUnit z)]
  -- pull α back to α₀ ∈ R_z with φ α₀ = α, as the adjoin is contained in φ.range
  obtain ⟨α₀, hα₀⟩ :=
    (AlgHom.mem_range φ).1 (Algebra.adjoin_le (Set.singleton_subset_iff.2 hrange) hα)
  -- integrality transfers through the injective φ, and R is integrally closed in R_z
  obtain ⟨r, hr⟩ := Algebra.mem_bot.1
    (hcl α₀ ((isIntegral_algHom_iff φ hφinj).1 (by rwa [hα₀])))
  exact Algebra.mem_bot.2 ⟨r, by rw [← hα₀, ← hr, φ.commutes r]⟩

/-- Exactness in the middle, expressed as `R[x/y] ∩ R[y/x] = R` (the bottom
`R`-subalgebra) inside `R_{xy}`. This is the content of the middle exactness in
`shortExact_fmap_gmap`.

The inclusion `⊇` is immediate, `⊥` being below everything. For `⊆`, take
`α ∈ Axy ⊓ Ayx`. By `inter_isIntegral`, `α` is integral over `R`. By the
hypothesis `hint`, either `R` is integrally closed in `R_x` — then apply
`mem_bot_of_mem_adjoin_of_intClosed` using `α ∈ Ayx` — or in `R_y` — then apply
it using `α ∈ Axy`. Either way `α ∈ ⊥`. -/
theorem Axy_inf_Ayx_eq_bot
    (hx : x ∈ R⁰) (hy : y ∈ R⁰)
    (hint : (∀ α : Localization.Away x, IsIntegral R α → α ∈ (⊥ : Subalgebra R (Localization.Away
        x))) ∨
            (∀ α : Localization.Away y, IsIntegral R α → α ∈ (⊥ : Subalgebra R (Localization.Away
                y)))) :
    Axy x y ⊓ Ayx x y = (⊥ : Subalgebra R (Rxy x y)) := by
  apply le_antisymm
  · -- ⊆ : the integral-closure descent
    intro α hα
    rw [Algebra.mem_inf] at hα
    obtain ⟨hαx, hαy⟩ := hα
    have hint_α : IsIntegral R α := inter_isIntegral x y α hαx hαy
    rcases hint with hclx | hcly
    · exact mem_bot_of_mem_adjoin_of_intClosed x y (injective_algebraMap_Rxy x y hx hy) x y hx
        (isUnit_x x y) hclx α hαy hint_α
    · exact mem_bot_of_mem_adjoin_of_intClosed x y (injective_algebraMap_Rxy x y hx hy) y x hy
        (isUnit_y x y) hcly α hαx hint_α
  · -- ⊇ : bot is below everything
    exact bot_le

-- ===========================================================================
-- The short exact sequence
-- ===========================================================================

/-- **Stacks Tag 052J.** Under the hypothesis that `R` is integrally closed in
`R_x` or in `R_y`, the sequence
`0 → R → R[x/y] ⊕ R[y/x] → R[x/y, y/x] → 0`
is a short exact sequence of `R`-modules:
1. `f` is injective;
2. `im f = ker g`;
3. `g` is surjective. -/
@[stacks 052J]
theorem shortExact_fmap_gmap
    (hx : x ∈ R⁰) (hy : y ∈ R⁰)
    (hint : (∀ α : Localization.Away x, IsIntegral R α → α ∈ (⊥ : Subalgebra R (Localization.Away
        x))) ∨
            (∀ α : Localization.Away y, IsIntegral R α → α ∈ (⊥ : Subalgebra R (Localization.Away
                y)))) :
    Function.Injective (fmap x y) ∧
    LinearMap.range (fmap x y) = LinearMap.ker (gmap x y) ∧
    Function.Surjective (gmap x y) := by
  have hinj := injective_algebraMap_Rxy x y hx hy
  refine ⟨(injective_iff_map_eq_zero (fmap x y)).2 fun r hr ↦
    (injective_iff_map_eq_zero _).1 hinj r ?_, ?_, gmap_surjective x y⟩
  · simpa [fmap, Prod.ext_iff, Subtype.ext_iff] using hr
  ext ⟨a, b⟩
  simp only [LinearMap.mem_range, LinearMap.mem_ker, fmap, gmap, LinearMap.prod_apply,
    LinearMap.coe_neg, Function.prod_apply, Pi.neg_apply, Algebra.linearMap_apply,
    LinearMap.coprod_apply, AlgHom.coe_toLinearMap, Prod.ext_iff, Subtype.ext_iff,
    ZeroMemClass.coe_zero, AddMemClass.coe_add, NegMemClass.coe_neg,
    SubalgebraClass.coe_algebraMap]
  rw [Subalgebra.coe_inclusion, Subalgebra.coe_inclusion]
  refine ⟨fun ⟨r, ha, hb⟩ ↦ by rw [← ha, ← hb, neg_add_cancel], fun hab ↦ ?_⟩
  have hb : (b : Rxy x y) ∈ Axy x y ⊓ Ayx x y :=
    Algebra.mem_inf.2 ⟨by rw [eq_neg_of_add_eq_zero_right hab]; exact neg_mem a.2, b.2⟩
  rw [Axy_inf_Ayx_eq_bot x y hx hy hint, Algebra.mem_bot] at hb
  obtain ⟨r, hr⟩ := Set.mem_range.1 hb
  exact ⟨r, by rw [hr, ← eq_neg_of_add_eq_zero_left hab], hr⟩
