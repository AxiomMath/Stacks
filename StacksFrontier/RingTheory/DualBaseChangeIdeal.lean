module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.LinearAlgebra.TensorProduct.Tower

/-!
# The ideal of values of the dual, under a flat base change

Let `A` be a commutative ring, `T` a flat `A`-algebra, `M` a finitely presented `A`-module and
`m₀ : M`. The values `l m₀` of the `A`-linear functionals on `M` generate an ideal `I ⊆ A`.
This file shows that the value `g m₀` of *any* `A`-linear map `g : M →ₗ[A] T` lies in the
extension `I · T` of that ideal.

Equivalently: a functional on the base change `T ⊗[A] M` evaluates at `1 ⊗ m₀` inside `I · T`.

## Main results

* `Module.FinitePresentation.apply_mem_ideal_map_span_dual`: `g m₀ ∈ I · T` for every
  `A`-linear `g : M →ₗ[A] T`.
* `Module.FinitePresentation.liftBaseChange_mem_ideal_map_span_dual`: the same statement read on
  a `T`-linear functional of the base change.
* `Module.FinitePresentation.ideal_map_dualValueIdeal_eq_span_singleton`: when the base change
  is free of rank one, the extended ideal is the principal ideal of the coefficient of `1 ⊗ m₀`.
* `Ideal.exists_sum_of_mem_map`: an element of the extension `I · T` of an ideal along a ring
  homomorphism is a finite `T`-combination of images of members of `I`.

## Implementation notes

The input is `Module.FinitePresentation.isBaseChange_map`, which for `M` finitely presented over
`A` and `T` flat over `A` exhibits `T ⊗[A] (M →ₗ[A] N)` as the module of `T`-linear maps
`T ⊗[A] M →ₗ[T] T ⊗[A] N`. It is applied with `N = A`, and the right-hand `T ⊗[A] A` is
identified with `T` by `TensorProduct.AlgebraTensorModule.rid`. Flatness and finite presentation
enter only through that one lemma; no projectivity of `M` is needed, so nothing here asks `M` to
be locally free.

Given a `g : M →ₗ[A] T`, its adjoint `LinearMap.liftBaseChange T g` composed with the inverse of
that identification is such a `T`-linear map, hence a sum of elementary tensors `t ⊗ l`; the
conclusion is then an induction over the tensor product, the elementary case being
`l m₀ ∈ I` by definition of `I`.
-/

@[expose] public noncomputable section

open TensorProduct

universe u v w

namespace Module.FinitePresentation

variable {A : Type u} [CommRing A] {T : Type v} [CommRing T] [Algebra A T]
variable {M : Type w} [AddCommGroup M] [Module A M]

/-- The ideal of `A` generated by the values at `m₀` of the `A`-linear functionals on `M`. -/
def dualValueIdeal (m₀ : M) : Ideal A :=
  Ideal.span (Set.range fun l : Module.Dual A M => l m₀)

/-- The value `l m₀` of an `A`-linear functional `l` on `M` lies in `dualValueIdeal m₀`. -/
theorem self_mem_dualValueIdeal (m₀ : M) (l : Module.Dual A M) :
    l m₀ ∈ dualValueIdeal m₀ :=
  Ideal.subset_span ⟨l, rfl⟩

variable [Module.Flat A T] [Module.FinitePresentation A M]

/-- Every `T`-linear functional on the base change `T ⊗[A] M` sends `1 ⊗ m₀` into the extension
to `T` of the ideal generated by the values at `m₀` of the `A`-linear functionals on `M`. -/
theorem liftBaseChange_mem_ideal_map_span_dual (m₀ : M)
    (Φ : (T ⊗[A] M) →ₗ[T] T) :
    Φ (1 ⊗ₜ[A] m₀) ∈ Ideal.map (algebraMap A T) (dualValueIdeal (A := A) m₀) := by
  classical
  have hbc : IsBaseChange T (LinearMap.baseChangeHom A T M A) :=
    Module.FinitePresentation.isBaseChange_map A M A T
  set rid : (T ⊗[A] A) ≃ₗ[T] T := TensorProduct.AlgebraTensorModule.rid A T T with hrid
  set Ψ : (T ⊗[A] M) →ₗ[T] (T ⊗[A] A) := rid.symm.toLinearMap ∘ₗ Φ with hΨ
  have key : ∀ σ : T ⊗[A] (M →ₗ[A] A),
      rid ((hbc.equiv σ) (1 ⊗ₜ[A] m₀)) ∈
        Ideal.map (algebraMap A T) (dualValueIdeal (A := A) m₀) := by
    intro σ
    induction σ using TensorProduct.inductionOn with
    | tmul t l =>
        have hev : hbc.equiv (t ⊗ₜ[A] l) = t • LinearMap.baseChangeHom A T M A l :=
          hbc.equiv_tmul t l
        rw [hev]
        have : rid ((t • LinearMap.baseChangeHom A T M A l) (1 ⊗ₜ[A] m₀))
            = t * algebraMap A T (l m₀) := by
          simp [rid, LinearMap.baseChangeHom, Algebra.smul_def, mul_comm]
        rw [this]
        exact Ideal.mul_mem_left _ _
          (Ideal.mem_map_of_mem _ (self_mem_dualValueIdeal m₀ l))
    | add x y hx hy => simpa [map_add] using Submodule.add_mem _ hx hy
  have hsig := key (hbc.equiv.symm Ψ)
  rw [LinearEquiv.apply_symm_apply] at hsig
  simpa [hΨ] using hsig

/-- The value at `m₀` of any `A`-linear map `M →ₗ[A] T` lies in the extension to `T` of the ideal
generated by the values at `m₀` of the `A`-linear functionals on `M`. -/
theorem apply_mem_ideal_map_span_dual (m₀ : M) (g : M →ₗ[A] T) :
    g m₀ ∈ Ideal.map (algebraMap A T) (dualValueIdeal (A := A) m₀) := by
  have h := liftBaseChange_mem_ideal_map_span_dual (A := A) (T := T) m₀
    (LinearMap.liftBaseChange T g)
  simpa using h

/-- **The extended ideal of values of the dual is principal on a free base change.** If the base
change `T ⊗[A] M` is free of rank one over `T` on `e`, through an isomorphism `β`, and `β` carries
`1 ⊗ m₀` to `a • e`, then the extension to `T` of the ideal of values at `m₀` of the functionals on
`M` is the principal ideal `(a)`. -/
theorem ideal_map_dualValueIdeal_eq_span_singleton {N : Type*} [AddCommGroup N] [Module T N]
    (β : (T ⊗[A] M) ≃ₗ[T] N) (e : N) (he : Function.Bijective fun t : T => t • e) (m₀ : M)
    (a : T) (h : β (1 ⊗ₜ[A] m₀) = a • e) :
    Ideal.map (algebraMap A T) (dualValueIdeal (A := A) m₀) = Ideal.span {a} := by
  set ψ : T ≃ₗ[T] N := LinearEquiv.ofBijective (LinearMap.toSpanSingleton T N e) he with hψ
  have hψa : ψ a = a • e := rfl
  refine le_antisymm ?_ ?_
  · rw [Ideal.map_le_iff_le_comap, dualValueIdeal, Ideal.span_le]
    rintro _ ⟨l, rfl⟩
    set Ψ : (T ⊗[A] M) →ₗ[T] T := LinearMap.liftBaseChange T ((Algebra.linearMap A T) ∘ₗ l)
    have hval : algebraMap A T (l m₀) = (Ψ ∘ₗ β.symm.toLinearMap) (ψ a) := by
      rw [LinearMap.comp_apply, LinearEquiv.coe_coe, hψa, ← h, LinearEquiv.symm_apply_apply]
      simp [Ψ]
    have hmul : (Ψ ∘ₗ β.symm.toLinearMap) (ψ a) = a * (Ψ ∘ₗ β.symm.toLinearMap) (ψ 1) := by
      rw [← smul_eq_mul, ← LinearMap.map_smul, ← LinearEquiv.map_smul, smul_eq_mul, mul_one]
    change _ ∈ Ideal.span _
    rw [hval, hmul]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have hmem := liftBaseChange_mem_ideal_map_span_dual (A := A) (T := T) m₀
      (ψ.symm.toLinearMap ∘ₗ β.toLinearMap)
    rwa [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.coe_coe, h, ← hψa,
      LinearEquiv.symm_apply_apply] at hmem

end Module.FinitePresentation

/-- An element of the extension `I · T` of an ideal along a ring homomorphism is a finite
`T`-combination of images of elements of `I`. -/
theorem Ideal.exists_sum_of_mem_map {A : Type*} [CommRing A] {T : Type*} [CommRing T]
    (f : A →+* T) (I : Ideal A) {y : T} (hy : y ∈ Ideal.map f I) :
    ∃ (m : ℕ) (c : Fin m → T) (a : Fin m → A),
      (∀ j, a j ∈ I) ∧ ∑ j, c j * f (a j) = y := by
  classical
  rw [Ideal.map, Submodule.mem_span_set'] at hy
  obtain ⟨m, c, w, hw⟩ := hy
  refine ⟨m, c, fun j => (w j).2.choose, fun j => (w j).2.choose_spec.1, ?_⟩
  rw [← hw]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [(w j).2.choose_spec.2, smul_eq_mul]

end
