module

public import StacksFrontier.RingTheory.ApproximationProperty.Certificate
public import StacksFrontier.RingTheory.ApproximationProperty.RegularLocalSupport

/-!
# Solutions of the certificate system

Let `R` be a regular local ring and `ρ : R → T` a surjection with prime kernel `𝔮`. We prove two
properties of the certificate system `Stacks.ApproximationProperty.Certificate.rel` (Rotthaus,
Section 2).

* A solution of the system in `R` whose `𝔮`-unknowns generate `𝔮`, whose `V`'s do not
  contain `S` in the ideal they generate, and whose parameters lie in the maximal ideal, produces a
  prime `𝔓 ⊇ 𝔮` containing all the `Q`'s, of coheight `k_v`, not containing `T` nor `C`, at
  which `R ⧸ 𝔮` is singular (Rotthaus (2.2.8), (2.3.6), (2.4.5)).
* Conversely a prime `𝔭 ⊇ 𝔮` at which `R ⧸ 𝔮` is singular gives a solution of the system whose
  `Q`'s generate `𝔭` and with `C` any prescribed element outside `𝔭` (Rotthaus (2.1)–(2.4)).

## Main definitions

* `Stacks.ApproximationProperty.Certificate.IsSingularPoint ρ hρ P hP`: the local ring of `T` at
  `ρ(P)` is not regular.

## Main results

* `Stacks.ApproximationProperty.Certificate.exists_prime_of_rel`: a solution produces a prime.
* `Stacks.ApproximationProperty.Certificate.exists_solution`: a singular prime produces a
  solution.

## References

* [C. Rotthaus, *Rings with approximation property*, Math. Ann. 287 (1990), 455–466][Rotthaus]
-/

@[expose] public section

open IsLocalRing

universe u v

namespace Stacks.ApproximationProperty.Certificate

variable {R₀ : Type u} [CommRing R₀] {R : Type u} [CommRing R] [Algebra R₀ R]
  {T : Type v} [CommRing T]

/-- `P` is a singular point of `R ⧸ ker ρ`, read through the surjection `ρ`: the local ring of
`T` at the prime `ρ(P)` is not regular. -/
def IsSingularPoint (ρ : R →+* T) (hρ : Function.Surjective ρ) (P : Ideal R) [P.IsPrime]
    (hP : RingHom.ker ρ ≤ P) : Prop :=
  letI := Ideal.map_isPrime_of_surjective hρ hP
  ¬ IsRegularLocalRing (Localization.AtPrime (P.map ρ))

/-- If an ideal primary to the maximal ideal is generated by `z₁, …, z_e` and every `z_i ^ N`
lies in `I`, then `I` contains a power of the maximal ideal. -/
theorem exists_pow_le_of_forall_pow_mem [IsLocalRing R] [IsNoetherianRing R] {e N : ℕ}
    (z : Fin e → R) (hz : ∃ M, maximalIdeal R ^ M ≤ Ideal.span (Set.range z)) {I : Ideal R}
    (hI : ∀ i, z i ^ N ∈ I) : ∃ M, maximalIdeal R ^ M ≤ I := by
  obtain ⟨M, hM⟩ := hz
  have h1 : Ideal.span (Set.range z) ≤ I.radical :=
    Ideal.span_le.2 (by rintro _ ⟨i, rfl⟩; exact ⟨N, hI i⟩)
  have h2 : maximalIdeal R ≤ I.radical := by
    intro x hx
    obtain ⟨n, hn⟩ := h1 (hM (Ideal.pow_mem_pow hx M))
    exact ⟨M * n, by rwa [pow_mul]⟩
  exact Ideal.exists_pow_le_of_le_radical_of_fg_radical h2 (IsNoetherian.noetherian _)

/-- A finite sum of multiples of the generators of an ideal lies in it. -/
private theorem sum_mul_mem_span {ι : Type*} (S : Finset ι) (c g : ι → R) :
    ∑ i ∈ S, c i * g i ∈ Ideal.span (g '' ↑S) :=
  Ideal.sum_mem _ fun i hi => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, hi, rfl⟩)

/-- A combination of the members of a finite family lies in the ideal they generate. -/
private theorem sum_mul_mem_span_range {ι : Type*} [Fintype ι] (c g : ι → R) :
    ∑ i, c i * g i ∈ Ideal.span (Set.range g) :=
  Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

variable (s : Shape) (y : Fin s.e → R₀)

/-- **What a solution of the certificate system implies** (Rotthaus (2.2.8), (2.3.6),
(2.4.5)). Let `R` be a regular local ring of dimension `l + k_v`, `k_v = k_z + 1`, and
`ρ : R → T` a surjection with prime kernel `𝔮` of height `r`, the `y_i` generating an ideal
primary to the maximal ideal. Let `p` be a solution of the system whose `𝔮`-unknowns generate `𝔮`,
with `S` not in the ideal of the `V`'s and the parameters `Lv`, `Lz` in the maximal ideal. Then
there is a prime `𝔓 ⊇ 𝔮` containing every `Q_σ`, with `dim R/𝔓 = k_v`, `T ∉ 𝔓`, `C ∉ 𝔓`, at which
`R ⧸ 𝔮` is singular. -/
theorem exists_prime_of_rel [IsRegularLocalRing R] (ρ : R →+* T) (hρ : Function.Surjective ρ)
    [(RingHom.ker ρ).IsPrime] (p : Var s → R) (hp : ∀ k, rel s y p k = 0)
    (hgen : Ideal.span (Set.range fun i => p (.Q (qIdx s i))) = RingHom.ker ρ)
    (hr : (s.r : ℕ∞) = (RingHom.ker ρ).height) (hpick : ∀ J : Subs s, s.pick J ∈ J.1)
    (hdim : ringKrullDim R = (s.l + s.kv : ℕ)) (hkv : s.kv = s.kz + 1)
    (hy : ∃ M, maximalIdeal R ^ M ≤ Ideal.span (Set.range (algebraMap R₀ R ∘ y)))
    (hS : p .S ∉ Ideal.span (Set.range fun i => p (.Q (vIdx s i))))
    (hLv : ∀ j, p (.Lv j) ∈ maximalIdeal R) (hLz : ∀ j, p (.Lz j) ∈ maximalIdeal R) :
    ∃ (P : Ideal R) (_ : P.IsPrime) (hP : RingHom.ker ρ ≤ P), (∀ σ, p (.Q σ) ∈ P) ∧
      ringKrullDim (R ⧸ P) = s.kv ∧ p .T ∉ P ∧ p .C ∉ P ∧ IsSingularPoint ρ hρ P hP := by
  classical
  set Iv : Ideal R := Ideal.span (Set.range fun i => p (.Q (vIdx s i))) with hIv
  have hSQ : ∀ σ, p .S * p (.Q σ) ∈ Iv := by
    intro σ
    have h := hp (.S σ)
    rw [rel, sub_eq_zero] at h
    rw [h]
    exact sum_mul_mem_span_range _ _
  have hVrel : ∀ i, (algebraMap R₀ R ∘ y) i ^ s.N ∈
      Iv ⊔ Ideal.span (Set.range fun j => p (.Lv j)) := by
    intro i
    have h := hp (.V i)
    rw [rel, sub_eq_zero] at h
    rw [Function.comp_apply, h]
    exact Ideal.add_mem _ (Ideal.mem_sup_left (sum_mul_mem_span_range _ _))
      (Ideal.mem_sup_right (sum_mul_mem_span_range _ _))
  have hne : Ideal.Quotient.mk Iv (p .S) ≠ 0 := by
    rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨P, hPass, hann⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing R _ hne
  have hPprime : P.IsPrime := hPass.isPrime
  have hQP : ∀ σ, p (.Q σ) ∈ P := by
    intro σ
    apply hann
    rw [Submodule.mem_colon_singleton, Submodule.mem_bot, Algebra.smul_def,
      Ideal.Quotient.algebraMap_eq, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, mul_comm]
    exact hSQ σ
  have hkerP : RingHom.ker ρ ≤ P := by
    rw [← hgen, Ideal.span_le]
    exact Set.range_subset_iff.2 fun _ => hQP _
  have hIv : Iv ≠ ⊤ := fun h => hS (h ▸ Submodule.mem_top)
  have hV : ∀ i, p (.Q (vIdx s i)) ∈ maximalIdeal R :=
    fun i => le_maximalIdeal hIv (Ideal.subset_span ⟨i, rfl⟩)
  have hprim := exists_pow_le_of_forall_pow_mem _ hy hVrel
  have hdimP : ringKrullDim (R ⧸ P) = s.kv :=
    ringKrullDim_quotient_eq_of_mem_associatedPrimes (fun i => p (.Q (vIdx s i)))
      (fun j => p (.Lv j)) hV hLv hdim hprim hPass
  have hTC : p .T * p .C ∉ P := by
    intro hmem
    have hZrel : ∀ i, (algebraMap R₀ R ∘ y) i ^ s.N ∈
        P ⊔ Ideal.span (Set.range fun j => p (.Lz j)) := by
      intro i
      have h := hp (.Z i)
      rw [rel, sub_eq_zero] at h
      rw [Function.comp_apply, h]
      refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mem_sup_left ?_)
        (Ideal.mem_sup_left (P.mul_mem_left _ hmem))) (Ideal.mem_sup_right
          (sum_mul_mem_span_range _ _))
      exact Ideal.sum_mem _ fun σ _ => P.mul_mem_left _ (hQP σ)
    have hle := ringKrullDim_quotient_le_of_pow_le_sup_span P (fun j => p (.Lz j)) hLz
      (exists_pow_le_of_forall_pow_mem _ hy hZrel)
    rw [hdimP, hkv] at hle
    have : s.kz + 1 ≤ s.kz := by exact_mod_cast hle
    lia
  have hT : p .T ∉ P := fun h => hTC (P.mul_mem_right _ h)
  have hC : p .C ∉ P := fun h => hTC (P.mul_mem_left _ h)
  refine ⟨P, hPprime, hkerP, hQP, hdimP, hT, hC, ?_⟩
  let := Ideal.map_isPrime_of_surjective hρ hkerP
  refine not_isRegularLocalRing_localization_of_forall_exists_mul_mem ρ hρ
    (fun i => p (.Q (qIdx s i))) hgen.symm P hkerP ?_
  intro J hJ
  have hJ' : J.card = s.r := by exact_mod_cast hJ.trans hr.symm
  refine ⟨s.pick ⟨J, hJ'⟩, hpick _, p .T, hT, ?_⟩
  have h := hp (.T ⟨J, hJ'⟩)
  rw [rel, sub_eq_zero] at h
  rw [h]
  refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right (sum_mul_mem_span _ _ _))
  refine Ideal.sum_mem _ fun σ _ => Ideal.sum_mem _ fun τ _ => Ideal.mul_mem_left _ _ ?_
  rw [pow_two]
  exact Ideal.mul_mem_mul (hQP σ) (hQP τ)

/-- In `WithBot ℕ∞`, `l + x = l + k` with `l, k` natural numbers forces `x = k`. -/
private theorem eq_natCast_of_natCast_add_eq {l k : ℕ} {x : WithBot ℕ∞}
    (h : (((l : ℕ∞) : WithBot ℕ∞) + x) = ((l + k : ℕ) : WithBot ℕ∞)) : x = (k : WithBot ℕ∞) := by
  obtain ⟨m, rfl⟩ : ∃ m : ℕ∞, x = (m : WithBot ℕ∞) := by
    induction x using WithBot.recBotCoe with
    | bot => exact absurd h (by rw [WithBot.add_bot]; exact WithBot.bot_ne_coe)
    | coe m => exact ⟨m, rfl⟩
  have h' : (l : ℕ∞) + m = ((l + k : ℕ) : ℕ∞) := by exact_mod_cast h
  induction m using ENat.recTopCoe with
  | top =>
    rw [add_top] at h'
    exact absurd h' (ENat.top_ne_natCast _)
  | coe m =>
    have : l + m = l + k := by exact_mod_cast h'
    obtain rfl : m = k := by lia
    rfl

/-- An element of the ideal generated by the images of a finset is a combination of them. -/
private theorem exists_eq_sum_of_mem_span_image {ι : Type*} (g : ι → R)
    (F : Finset ι) {x : R} (hx : x ∈ Ideal.span (g '' ↑F)) :
    ∃ c : ι → R, x = ∑ i ∈ F, c i * g i := by
  classical
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨i, hi, rfl⟩
    refine ⟨Pi.single i 1, ?_⟩
    rw [Finset.sum_eq_single_of_mem i hi (fun j _ hji => by simp [hji])]
    simp
  · exact ⟨0, by simp⟩
  · rintro x y - - ⟨c, rfl⟩ ⟨d, rfl⟩
    exact ⟨c + d, by simp [add_mul, Finset.sum_add_distrib]⟩
  · rintro a x - ⟨c, rfl⟩
    exact ⟨a • c, by simp [Finset.mul_sum, mul_assoc]⟩

/-- An element of the ideal generated by a finite family is a combination of it. -/
private theorem exists_eq_sum_of_mem_span_range {ι : Type*} [Fintype ι] (g : ι → R) {x : R}
    (hx : x ∈ Ideal.span (Set.range g)) : ∃ c : ι → R, x = ∑ i, c i * g i := by
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 hx
  exact ⟨c, by simp [← hc, smul_eq_mul]⟩

/-- An element of the square of the ideal generated by a finite family is a combination of the
pairwise products of the family. -/
private theorem exists_eq_sum_sum_of_mem_sq {ι : Type*} [Fintype ι] (g : ι → R) {x : R}
    (hx : x ∈ Ideal.span (Set.range g) ^ 2) :
    ∃ A : ι → ι → R, x = ∑ i, ∑ j, A i j * (g i * g j) := by
  have hle : Ideal.span (Set.range g) ^ 2 ≤
      Ideal.span (Set.range fun ij : ι × ι => g ij.1 * g ij.2) := by
    rw [pow_two, Ideal.span_mul_span]
    apply Ideal.span_mono
    rintro _ ⟨_, ⟨i, rfl⟩, _, ⟨j, rfl⟩, rfl⟩
    exact ⟨(i, j), rfl⟩
  obtain ⟨c, hc⟩ := exists_eq_sum_of_mem_span_range _ (hle hx)
  exact ⟨fun i j => c (i, j), by rw [hc, Fintype.sum_prod_type]⟩

/-- **The true solution** (Rotthaus (2.1)–(2.4)). Let `R` be a regular local ring of dimension
`l + k_z + 1`, `ρ : R → T` a surjection whose prime kernel `𝔮 = (q₁, …, q_a)` has height `r`,
`y_i` elements of `R₀` mapping into the maximal ideal, `P ⊇ 𝔮` a prime of height `l` at which
`R ⧸ 𝔮` is singular, and `c₀ ∉ P`. Then the certificate system of the corresponding shape has a
solution `p` in `R` whose first `a` generators are the `q_i`, whose generators generate `P`, with
`S ∉ P`, `C = c₀`, and all parameters in the maximal ideal. -/
theorem exists_solution [IsRegularLocalRing R] (ρ : R →+* T) (hρ : Function.Surjective ρ)
    [(RingHom.ker ρ).IsPrime] {a : ℕ} (q : Fin a → R)
    (hq : Ideal.span (Set.range q) = RingHom.ker ρ) {r : ℕ}
    (hr : (r : ℕ∞) = (RingHom.ker ρ).height) {e : ℕ} (y : Fin e → R₀)
    (hy : ∀ i, algebraMap R₀ R (y i) ∈ maximalIdeal R) (P : Ideal R) [P.IsPrime]
    (hP : RingHom.ker ρ ≤ P) (hsing : IsSingularPoint ρ hρ P hP) {l kz : ℕ}
    (hl : P.height = l) (hdim : ringKrullDim R = (l + (kz + 1) : ℕ)) (c₀ : R) (hc₀ : c₀ ∉ P) :
    ∃ (c N : ℕ) (pick : {J : Finset (Fin a) // J.card = r} → Fin a)
      (p : Var ⟨a, l, c, kz + 1, kz, e, r, N, pick⟩ → R),
      (∀ k, rel ⟨a, l, c, kz + 1, kz, e, r, N, pick⟩ y p k = 0) ∧ (∀ J, pick J ∈ J.1) ∧
      (∀ i, p (.Q (.inl i)) = q i) ∧ Ideal.span (Set.range fun σ => p (.Q σ)) = P ∧
      p .S ∉ P ∧ p .C = c₀ ∧ (∀ j, p (.Lv j) ∈ maximalIdeal R) ∧
      ∀ j, p (.Lz j) ∈ maximalIdeal R := by
  classical
  let := Ideal.map_isPrime_of_surjective hρ hP
  obtain ⟨t, htP, ht⟩ :=
    exists_mul_mem_of_not_isRegularLocalRing_localization ρ hρ q hq.symm P hP hsing
  have hpick : ∀ J : {J : Finset (Fin a) // J.card = r},
      ∃ j ∈ J.1, t * q j ∈ P ^ 2 ⊔ Ideal.span (q '' ↑(J.1.erase j)) :=
    fun J => ht J.1 (by rw [J.2]; exact hr)
  choose pick hpickJ hpickmem using hpick
  obtain ⟨v, hvP, ⟨s₀, hs₀P, hs₀⟩, w, hw, N₁, hN₁⟩ :=
    exists_fin_mem_and_mul_mem_span_and_pow_le P hl hdim
  obtain ⟨c, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (IsNoetherian.noetherian P)
  have hcoh : ringKrullDim (R ⧸ P) = (kz + 1 : ℕ) := by
    have h := ringKrullDim_eq_height_add_ringKrullDim_quotient_of_isRegularLocalRing P
    rw [hdim, hl] at h
    exact eq_natCast_of_natCast_add_eq h.symm
  have htc : t * c₀ ∉ P := fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim htP hc₀
  obtain ⟨Lz, hLz, N₂, hN₂⟩ := exists_pow_le_sup_span_singleton_sup_span P hcoh htc
  set N := max N₁ N₂
  let Qv : Fin a ⊕ Fin l ⊕ Fin c → R := Sum.elim q (Sum.elim v g)
  have hqP : ∀ i, q i ∈ P := fun i => hP (hq ▸ Ideal.subset_span ⟨i, rfl⟩)
  have hgP : ∀ j, g j ∈ P := fun j => hg ▸ Ideal.subset_span ⟨j, rfl⟩
  have hQvP : ∀ σ, Qv σ ∈ P := by
    rintro (i | i | j)
    · exact hqP i
    · exact hvP i
    · exact hgP j
  have hspan : Ideal.span (Set.range Qv) = P := by
    refine le_antisymm (Ideal.span_le.2 (Set.range_subset_iff.2 hQvP)) ?_
    rw [← hg, Ideal.span_le]
    exact Set.range_subset_iff.2 fun j => Ideal.subset_span ⟨.inr (.inr j), rfl⟩
  have hF : ∀ σ, ∃ f : Fin l → R, s₀ * Qv σ = ∑ i, f i * v i :=
    fun σ => exists_eq_sum_of_mem_span_range v (hs₀ _ (hQvP σ))
  choose F hF using hF
  have hyN : ∀ i, algebraMap R₀ R (y i) ^ N ∈ maximalIdeal R ^ N₁ ⊓ maximalIdeal R ^ N₂ :=
    fun i => ⟨Ideal.pow_le_pow_right (le_max_left _ _) (Ideal.pow_mem_pow (hy i) N),
      Ideal.pow_le_pow_right (le_max_right _ _) (Ideal.pow_mem_pow (hy i) N)⟩
  have hVc : ∀ i, ∃ (gv : Fin l → R) (hv : Fin (kz + 1) → R),
      algebraMap R₀ R (y i) ^ N = ∑ j, gv j * v j + ∑ j, hv j * w j := by
    intro i
    obtain ⟨x₁, hx₁, x₂, hx₂, hx⟩ := Submodule.mem_sup.1 (hN₁ (hyN i).1)
    obtain ⟨gv, rfl⟩ := exists_eq_sum_of_mem_span_range v hx₁
    obtain ⟨hv, rfl⟩ := exists_eq_sum_of_mem_span_range w hx₂
    exact ⟨gv, hv, hx.symm⟩
  choose Gv Hv hVc using hVc
  have hTc : ∀ J : {J : Finset (Fin a) // J.card = r},
      ∃ (A : (Fin a ⊕ Fin l ⊕ Fin c) → (Fin a ⊕ Fin l ⊕ Fin c) → R) (C : Fin a → R),
        t * q (pick J) = ∑ σ, ∑ τ, A σ τ * (Qv σ * Qv τ) +
          ∑ i ∈ J.1.erase (pick J), C i * q i := by
    intro J
    obtain ⟨x₁, hx₁, x₂, hx₂, hx⟩ := Submodule.mem_sup.1 (hpickmem J)
    rw [← hspan] at hx₁
    obtain ⟨A, rfl⟩ := exists_eq_sum_sum_of_mem_sq Qv hx₁
    obtain ⟨C, rfl⟩ := exists_eq_sum_of_mem_span_image q _ hx₂
    exact ⟨A, C, hx.symm⟩
  choose A CJ hTc using hTc
  have hZc : ∀ i, ∃ (gz : (Fin a ⊕ Fin l ⊕ Fin c) → R) (hz : R) (kz' : Fin kz → R),
      algebraMap R₀ R (y i) ^ N = ∑ σ, gz σ * Qv σ + hz * (t * c₀) + ∑ j, kz' j * Lz j := by
    intro i
    obtain ⟨x₁, hx₁, x₂, hx₂, hx⟩ := Submodule.mem_sup.1 (hN₂ (hyN i).2)
    obtain ⟨x₃, hx₃, x₄, hx₄, rfl⟩ := Submodule.mem_sup.1 hx₁
    rw [← hspan] at hx₃
    obtain ⟨gz, rfl⟩ := exists_eq_sum_of_mem_span_range Qv hx₃
    obtain ⟨hz, rfl⟩ := Ideal.mem_span_singleton'.1 hx₄
    obtain ⟨kz', rfl⟩ := exists_eq_sum_of_mem_span_range Lz hx₂
    exact ⟨gz, hz, kz', hx.symm⟩
  choose Gz Hz Kz hZc using hZc
  let sh : Shape := ⟨a, l, c, kz + 1, kz, e, r, N, pick⟩
  let p : Var sh → R := fun
    | .Q σ => Qv σ
    | .S => s₀
    | .F σ i => F σ i
    | .Lv j => w j
    | .Gv i j => Gv i j
    | .Hv i j => Hv i j
    | .T => t
    | .A J σ τ => A J σ τ
    | .CJ J i => CJ J i
    | .C => c₀
    | .Lz j => Lz j
    | .Gz i σ => Gz i σ
    | .Hz i => Hz i
    | .Kz i j => Kz i j
  refine ⟨c, N, pick, p, ?_, hpickJ, fun i => rfl, hspan, hs₀P, rfl, hw, hLz⟩
  intro k
  cases k with
  | S σ =>
    change s₀ * Qv σ - ∑ i, F σ i * v i = 0
    rw [hF σ, sub_self]
  | V i =>
    change algebraMap R₀ R (y i) ^ N - (∑ j, Gv i j * v j + ∑ j, Hv i j * w j) = 0
    rw [hVc i, sub_self]
  | T J =>
    change t * q (pick J) - (∑ σ, ∑ τ, A J σ τ * (Qv σ * Qv τ) +
      ∑ i ∈ J.1.erase (pick J), CJ J i * q i) = 0
    rw [hTc J, sub_self]
  | Z i =>
    change algebraMap R₀ R (y i) ^ N -
      (∑ σ, Gz i σ * Qv σ + Hz i * (t * c₀) + ∑ j, Kz i j * Lz j) = 0
    rw [hZc i, sub_self]

end Stacks.ApproximationProperty.Certificate

end
