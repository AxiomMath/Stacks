@[expose] public section

/-!
# Local weakly étale algebras over strictly henselian local rings

A weakly étale local algebra over a strictly henselian local ring is isomorphic to its base
through the structure homomorphism.

## Main definitions

No new definitions are introduced.

## Main results

* `bijective_algebraMap_of_weaklyEtale_of_isLocalHom` (Stacks 092Z): the structure map of a
  local weakly étale algebra over a strictly henselian local ring is bijective.

## Implementation notes

Strict henselianity is represented by `HenselianLocalRing` together with separable closedness of
the residue field. The equality of the source and target rings is expressed canonically by
bijectivity of their given structure homomorphism.

The proof runs through the fibres: over each prime of the base the fibre algebra is generated by
scalars, because the integral closure of the residue field in an algebraic closure is again
strictly henselian (Stacks 092X) and the weakly étale algebra is integrally closed after base
change to a fraction field (Stacks 092W), so the fibre has no nontrivial idempotents. Surjectivity
on fibres makes the spectral map of `B ⊗[A] B` injective, whence the multiplication map is
faithfully flat and `A → B` is an epimorphism; Stacks 04VU then concludes.

## References

* [The Stacks Project, Tag 092Z](https://stacks.math.columbia.edu/tag/092Z)
* [Olivier, *Anneaux absolument plats universels et épimorphismes à buts réduits*][Olivier-AF]
-/

open IsLocalRing Polynomial TensorProduct

universe u v

private theorem idempotent_integral {R C : Type*} [CommRing R] [Nontrivial R]
    [CommRing C] [Algebra R C] {e : C} (he : IsIdempotentElem e) : IsIntegral R e := by
  have h : aeval e (X ^ 2 - X : R[X]) = 0 := by
    simp [pow_two, he.eq]
  have hp : (X ^ 2 - X : R[X]).Monic := monic_X_pow_sub (by simp [degree_X])
  have h' := isIntegral_leadingCoeff_smul (X ^ 2 - X : R[X]) e h
  rwa [hp.leadingCoeff, one_smul] at h'

private theorem idempotent_trivial {R C : Type*} [CommRing R] [IsLocalRing R]
    [CommRing C] [Algebra R C] [IsIntegrallyClosedIn R C]
    {e : C} (he : IsIdempotentElem e) : e = 0 ∨ e = 1 := by
  obtain ⟨r, hr⟩ := IsIntegrallyClosedIn.algebraMap_eq_of_integral
    (R := R) (A := C) (idempotent_integral he)
  have hrid : IsIdempotentElem r := by
    apply (isIntegrallyClosedIn_iff.mp (inferInstance : IsIntegrallyClosedIn R C)).1
    simpa [hr] using he.eq
  rcases IsLocalRing.isUnit_or_isUnit_one_sub_self r with h | h
  · right
    rw [← hr]
    simpa using congrArg (algebraMap R C) ((IsIdempotentElem.iff_eq_one_of_isUnit h).mp hrid)
  · left
    have h1 : 1 - r = 1 := (IsIdempotentElem.iff_eq_one_of_isUnit h).mp hrid.one_sub
    have : r = 0 := sub_eq_zero.mp (by simpa using h1)
    simpa [← hr] using congrArg (algebraMap R C) this

/-- Triviality of idempotents transfers along a ring isomorphism. -/
private theorem idempotent_trivial_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (iso : R ≃+* S) (hS : ∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1)
    (e : R) (he : IsIdempotentElem e) : e = 0 ∨ e = 1 :=
  (hS (iso e) (he.map iso)).imp (fun h => iso.injective (by simpa using h))
    (fun h => iso.injective (by simpa using h))

/-- Surjectivity of the structure map transfers along an algebra isomorphism. -/
private theorem surjective_algebraMap_of_algEquiv {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra R T] (e : S ≃ₐ[R] T)
    (h : Function.Surjective (algebraMap R T)) : Function.Surjective (algebraMap R S) := by
  intro x
  obtain ⟨k, hk⟩ := h (e x)
  exact ⟨k, e.injective ((e.commutes k).trans hk)⟩

private theorem idempotent_trivial_tensor_fraction
    (R S K : Type*) [CommRing R] [CommRing S] [Field K]
    [IsDomain R] [IsIntegrallyClosed R] [Algebra R K] [IsFractionRing R K]
    [IsLocalRing S] [Algebra R S]
    (h : Algebra.WeaklyEtale R S) (e : S ⊗[R] K)
    (he : IsIdempotentElem e) : e = 0 ∨ e = 1 := by
  let : IsIntegrallyClosedIn S (S ⊗[R] K) :=
    isIntegrallyClosedIn_tensorProduct_fractionField_of_weaklyEtale R S K h
  exact idempotent_trivial (R := S) (C := S ⊗[R] K) he

private theorem idempotent_trivial_baseChange_fraction
    (A B C L : Type*) [CommRing A] [CommRing B] [CommRing C] [Field L]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing C]
    [Algebra A B] [Algebra A C] [Algebra A L] [Algebra C L]
    [IsScalarTower A C L] [IsLocalHom (algebraMap A B)]
    [IsLocalHom (algebraMap A C)] [Algebra.IsIntegral A C]
    [IsDomain C] [IsIntegrallyClosed C] [IsFractionRing C L]
    (h : Algebra.WeaklyEtale A B)
    (hins : @IsPurelyInseparable (IsLocalRing.ResidueField A)
      (IsLocalRing.ResidueField C) _ _
      (IsLocalRing.ResidueField.map (algebraMap A C)).toAlgebra)
    (e : B ⊗[A] L) (he : IsIdempotentElem e) : e = 0 ∨ e = 1 := by
  let : Algebra.WeaklyEtale A B := h
  have hloc : IsLocalRing (B ⊗[A] C) :=
    (isLocalRing_tensorProduct_of_isIntegral A B C (Or.inl hins)).1
  let : Algebra C (B ⊗[A] C) := Algebra.TensorProduct.rightAlgebra
  have : IsLocalRing (C ⊗[A] B) :=
    (Algebra.TensorProduct.commRight A C B).symm.toRingEquiv.isLocalRing
  let F := (C ⊗[A] B) ⊗[C] L
  let iso : F ≃+* B ⊗[A] L :=
    (Algebra.TensorProduct.comm C (C ⊗[A] B) L).toRingEquiv.trans
      ((Algebra.TensorProduct.cancelBaseChange A C L L B).toRingEquiv.trans
        (Algebra.TensorProduct.comm A L B).toRingEquiv)
  exact idempotent_trivial_of_ringEquiv iso.symm
    (idempotent_trivial_tensor_fraction C (C ⊗[A] B) L inferInstance) e he

private theorem idempotent_trivial_over_residue_extension
    (A B : Type*) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] [CommRing B] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)]
    (h : Algebra.WeaklyEtale A B) (p : Ideal A) [p.IsPrime]
    (L : Type*) [Field L] [Algebra p.ResidueField L]
    [Algebra A L] [IsScalarTower A p.ResidueField L]
    [Algebra.IsAlgebraic p.ResidueField L]
    (e : B ⊗[A] L) (he : IsIdempotentElem e) : e = 0 ∨ e = 1 := by
  let Q := A ⧸ p
  let K := p.ResidueField
  let : Algebra Q L := Algebra.compHom L (algebraMap Q K)
  let : IsScalarTower Q K L := .of_algebraMap_eq' rfl
  let : IsScalarTower A Q L := .of_algebraMap_eq' (by
    ext a
    change (algebraMap A L) a = (algebraMap Q L) (Ideal.Quotient.mk p a)
    rw [IsScalarTower.algebraMap_apply A K L, IsScalarTower.algebraMap_apply Q K L]
    rfl)
  have hinj : Function.Injective (algebraMap Q L) :=
    (FaithfulSMul.algebraMap_injective K L).comp p.injective_algebraMap_quotient_residueField
  let C := integralClosure Q L
  let : Algebra A C := Algebra.compHom C (Ideal.Quotient.mk p)
  let : IsScalarTower A Q C := .of_algebraMap_eq' rfl
  let : IsScalarTower A C L := .of_algebraMap_eq' (by
    ext a
    simp only [RingHom.comp_apply]
    rw [IsScalarTower.algebraMap_apply A Q L, IsScalarTower.algebraMap_apply A Q C,
      IsScalarTower.algebraMap_apply Q C L])
  have : Algebra.IsAlgebraic Q L :=
    (IsFractionRing.comap_isAlgebraic_iff (A := Q) (K := K) (C := L)).mpr inferInstance
  let : IsFractionRing C L :=
    integralClosure.isFractionRing_of_algebraic (fun x hx => hinj (by simpa using hx))
  let : IsIntegrallyClosed C :=
    (isIntegrallyClosed_iff_isIntegrallyClosedIn L).mpr inferInstance
  have : Algebra.IsIntegral A C := Algebra.IsIntegral.trans Q
  obtain ⟨hC, hlocal, hstrict⟩ :=
    RingHom.exists_henselianLocalRing_of_isIntegral_of_isDomain
      (algebraMap A C) ((algebraMap_isIntegral_iff).mpr inferInstance)
  let : HenselianLocalRing C := hC
  let : IsLocalHom (algebraMap A C) := hlocal
  obtain ⟨_, hpure⟩ := hstrict inferInstance
  exact idempotent_trivial_baseChange_fraction A B C L h hpure e he

private theorem finite_split_image_scalar
    {K E C : Type*} [Field K] [CommRing E] [CommRing C]
    [Algebra K E] [Algebra K C] [Algebra.IsFiniteSplit K E] [Nontrivial C]
    (hconn : ∀ e : C, IsIdempotentElem e → e = 0 ∨ e = 1)
    (f : E →ₐ[K] C) (x : E) : ∃ k : K, f x = algebraMap K C k := by
  classical
  obtain ⟨n, ⟨equiv⟩⟩ := Algebra.IsFiniteSplit.nonempty_algEquiv_fun K E
  let ψ : (Fin n → K) →ₐ[K] C := f.comp equiv.symm.toAlgHom
  have hidem (i : Fin n) : IsIdempotentElem (ψ (Pi.single i 1)) := by
    change ψ (Pi.single i 1) * ψ (Pi.single i 1) = ψ (Pi.single i 1)
    rw [← map_mul]
    congr 1
    ext j
    by_cases h : j = i <;> simp [h]
  have hsum : ∑ i : Fin n, ψ (Pi.single i 1) = 1 := by
    rw [← map_sum]
    have h : (∑ i : Fin n, Pi.single i (1 : K)) = 1 := by
      ext j
      simp
    rw [h, map_one]
  obtain ⟨j, hj⟩ : ∃ j : Fin n, ψ (Pi.single j 1) = 1 := by
    by_contra! hn
    have hz (i : Fin n) : ψ (Pi.single i 1) = 0 :=
      (hconn _ (hidem i)).resolve_right (hn i)
    simp [hz] at hsum
  have hothers (i : Fin n) (hi : i ≠ j) : ψ (Pi.single i 1) = 0 := by
    have hmul : ψ (Pi.single i 1) * ψ (Pi.single j 1) = 0 := by
      rw [← map_mul]
      have hz : (Pi.single i (1 : K) : Fin n → K) *
          (Pi.single j (1 : K) : Fin n → K) = 0 := by
        ext k
        by_cases hki : k = i <;> by_cases hkj : k = j <;> simp [hki, hkj, hi] at *
      rw [hz, map_zero]
    simpa [hj] using hmul
  have hfactor (y : Fin n → K) : ψ y = algebraMap K C (y j) := by
    conv_lhs => rw [← Finset.univ_sum_single y]
    rw [map_sum]
    have hsingle (i : Fin n) : Pi.single i (y i) = Pi.single i 1 * y := by
      rw [← Pi.single_mul_left]
      simp
    rw [Finset.sum_eq_single_of_mem j (Finset.mem_univ _)]
    · have hy : Pi.single j (y j) =
          (algebraMap K (Fin n → K) (y j)) * Pi.single j 1 := by
        ext i
        by_cases hij : i = j
        · subst hij
          simp
        · simp [Pi.single_eq_of_ne hij]
      rw [hy, map_mul, AlgHom.commutes, hj, mul_one]
    · intro i _ hi
      rw [hsingle, map_mul, hothers i hi, zero_mul]
  refine ⟨(equiv x) j, ?_⟩
  simpa [ψ] using hfactor (equiv x)

private theorem surjective_algebraMap_of_weaklyEtale_of_isSepClosed_of_idempotents
    (K C : Type*) [Field K] [IsSepClosed K] [CommRing C] [Nontrivial C]
    [Algebra K C] (h : Algebra.WeaklyEtale K C)
    (hconn : ∀ e : C, IsIdempotentElem e → e = 0 ∨ e = 1) :
    Function.Surjective (algebraMap K C) := by
  let : Algebra.WeaklyEtale K C := h
  have hfg := (flat_lmul_weaklyEtale_filteredColimitEtale_tfae K C).2
    (Algebra.WeaklyEtale.flat_lmul' K C)
  intro x
  let E : Subalgebra K C := Algebra.adjoin K ({x} : Set C)
  have hEfg : E.FG := by
    simpa [E] using (Subalgebra.fg_adjoin_finset ({x} : Finset C))
  have : Algebra.Etale K E := hfg E hEfg
  exact (finite_split_image_scalar hconn E.val
    ⟨x, Algebra.subset_adjoin (Set.mem_singleton x)⟩).imp fun _ hk => hk.symm

private theorem fibre_algebraMap_surjective
    (A B : Type*) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] [CommRing B] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)]
    (h : Algebra.WeaklyEtale A B) (p : Ideal A) [p.IsPrime] :
    Function.Surjective
      (algebraMap p.ResidueField (p.ResidueField ⊗[A] B)) := by
  let K := p.ResidueField
  let L := AlgebraicClosure K
  let : IsScalarTower A K L := inferInstance
  let : Algebra.WeaklyEtale A B := h
  have : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have : Nontrivial (L ⊗[A] B) :=
    (FaithfulSMul.algebraMap_injective L (L ⊗[A] B)).nontrivial
  have hconn (e : L ⊗[A] B) (he : IsIdempotentElem e) : e = 0 ∨ e = 1 := by
    exact idempotent_trivial_of_ringEquiv (Algebra.TensorProduct.comm A L B).toRingEquiv
      (idempotent_trivial_over_residue_extension A B h p L) e he
  have hsurj : Function.Surjective (algebraMap L (L ⊗[A] B)) :=
    surjective_algebraMap_of_weaklyEtale_of_isSepClosed_of_idempotents
      L (L ⊗[A] B) inferInstance hconn
  let F := K ⊗[A] B
  let equiv : L ⊗[K] F ≃ₐ[L] L ⊗[A] B :=
    Algebra.TensorProduct.cancelBaseChange A K L L B
  have hsurj' := surjective_algebraMap_of_algEquiv equiv hsurj
  have : Module.FaithfullyFlat K L :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom (A := K) (B := L)
  exact Module.FaithfullyFlat.surjective_of_tensorProduct hsurj'

private theorem comap_injective_of_fibre_algebraMap_surjective
    (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    (h : ∀ (p : Ideal R) [p.IsPrime],
      Function.Surjective (algebraMap p.ResidueField (p.ResidueField ⊗[R] S))) :
    Function.Injective (PrimeSpectrum.comap (algebraMap R S)) := by
  intro q₁ q₂ heq
  let p := PrimeSpectrum.comap (algebraMap R S) q₁
  let K := p.asIdeal.ResidueField
  let F := K ⊗[R] S
  have hspec : Subsingleton (PrimeSpectrum F) :=
    ⟨fun _ _ => PrimeSpectrum.comap_injective_of_surjective (algebraMap K F) (h p.asIdeal)
      (Subsingleton.elim _ _)⟩
  have hpre : (⟨q₁, rfl⟩ : (PrimeSpectrum.comap (algebraMap R S)) ⁻¹' {p}) =
      ⟨q₂, heq.symm⟩ := (PrimeSpectrum.preimageEquivFiber R S p).injective (Subsingleton.elim _ _)
  exact congrArg Subtype.val hpre

private theorem tensor_self_algebraMap_surjective_of_surjective
    (K S : Type*) [CommRing K] [CommRing S] [Algebra K S]
    (h : Function.Surjective (algebraMap K S)) :
    Function.Surjective (algebraMap K (S ⊗[K] S)) := by
  intro z
  induction z using TensorProduct.inductionOn with
  | tmul x y =>
    obtain ⟨a, rfl⟩ := h x
    obtain ⟨b, rfl⟩ := h y
    refine ⟨a * b, ?_⟩
    simpa [Algebra.TensorProduct.algebraMap_apply, Algebra.smul_def] using
      (TensorProduct.smul_tmul_smul a b (1 : S) (1 : S)).symm
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, by simp [Algebra.TensorProduct.algebraMap_apply, add_tmul]⟩

private theorem tensor_square_fibre_algebraMap_surjective
    (A B K : Type*) [CommRing A] [CommRing B] [Field K]
    [Algebra A B] [Algebra A K]
    (h : Function.Surjective (algebraMap K (K ⊗[A] B))) :
    Function.Surjective (algebraMap K (K ⊗[A] (B ⊗[A] B))) := by
  let F := K ⊗[A] B
  let e₁ : F ⊗[A] B ≃ₐ[K] K ⊗[A] (B ⊗[A] B) :=
    Algebra.TensorProduct.assoc A A K K B B
  let e₂ : F ⊗[A] B ≃ₐ[K] F ⊗[K] F :=
    (Algebra.TensorProduct.cancelBaseChange A K K F B).symm
  let e := e₁.symm.trans e₂
  exact surjective_algebraMap_of_algEquiv e (tensor_self_algebraMap_surjective_of_surjective K F h)

/-- A local weakly étale algebra over a strictly henselian local ring has bijective structure
homomorphism. -/
@[stacks 092Z]
theorem bijective_algebraMap_of_weaklyEtale_of_isLocalHom
    (A : Type u) (B : Type v) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (ResidueField A)] [CommRing B] [IsLocalRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] (hAB : Algebra.WeaklyEtale A B) :
    Function.Bijective (algebraMap A B) := by
  let : Algebra.WeaklyEtale A B := hAB
  let : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  let D := B ⊗[A] B
  let μ : D →ₐ[A] B := Algebra.TensorProduct.lmul' A
  have hAD : Function.Injective (PrimeSpectrum.comap (algebraMap A D)) :=
    comap_injective_of_fibre_algebraMap_surjective A D (fun p =>
      tensor_square_fibre_algebraMap_surjective A B p.ResidueField
        (fibre_algebraMap_surjective A B hAB p))
  have hμspec : Function.Surjective (PrimeSpectrum.comap μ.toRingHom) := by
    intro P
    let p : PrimeSpectrum A := PrimeSpectrum.comap (algebraMap A D) P
    obtain ⟨q, hq⟩ :=
      (RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mp
        ((RingHom.faithfullyFlat_algebraMap_iff (R := A) (S := B)).mpr inferInstance)).2 p
    refine ⟨q, ?_⟩
    apply hAD
    have hcomp : μ.toRingHom.comp (algebraMap A D) = algebraMap A B := by
      ext a
      simp [μ, D]
    simpa [← PrimeSpectrum.comap_comp_apply, hcomp] using hq
  have hμff : μ.toRingHom.FaithfullyFlat :=
    RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mpr
      ⟨Algebra.WeaklyEtale.flat_lmul' A B, hμspec⟩
  have : Algebra.IsEpi A B := by
    apply (Algebra.isEpi_iff_forall_one_tmul_eq A B).mpr
    intro b
    apply hμff.injective
    change (Algebra.TensorProduct.lmul' A (S := B)) (1 ⊗ₜ[A] b) =
      (Algebra.TensorProduct.lmul' A (S := B)) (b ⊗ₜ[A] 1)
    simp
  exact faithfullyFlat_epimorphism_isIso A B
