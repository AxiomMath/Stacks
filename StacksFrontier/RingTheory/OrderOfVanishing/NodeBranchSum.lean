module

public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.RingTheory.FiniteLength
public import Mathlib.RingTheory.HopkinsLevitzki
public import Mathlib.RingTheory.KrullDimension.Regular
public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.OrderOfVanishing.Basic
public import Mathlib.RingTheory.SimpleModule.Basic
public import Mathlib.Tactic.LinearCombination

/-!
# The order of vanishing of the sum of the two branches at a node

Let `L` be a reduced local ring whose maximal ideal is generated by two nonzero elements `x` and
`y` with `xy = 0`; the local ring at the origin of the union of the two coordinate axes is the
model. Then `x + y` is a nonzerodivisor of `L` and its order of vanishing is `2`: the quotient
`L/(x + y)` has the composition series `0 ⊂ (x̄) ⊂ L/(x + y)`, both of whose factors are the
residue field.

## Main results

* `Ring.add_mem_nonZeroDivisors_of_mul_eq_zero`: `x + y` is a nonzerodivisor.
* `Ring.not_mem_span_add_of_mul_eq_zero`: `x` is not a multiple of `x + y`.
* `Ring.ord_add_eq_two_of_mul_eq_zero`: `ord_L(x + y) = 2`.
* `Ring.ringKrullDim_eq_one_of_mul_eq_zero`: if `L` is moreover Noetherian, it has Krull
  dimension one, since `L/(x + y)` has finite length.
-/

@[expose] public section

open IsLocalRing

namespace Ring

variable {L : Type*} [CommRing L] [IsLocalRing L] [IsReduced L] {x y : L}

omit [IsLocalRing L] in
/-- An element of a reduced ring whose square is zero is zero. -/
private theorem eq_zero_of_mul_self_eq_zero {z : L} (h : z * z = 0) : z = 0 :=
  IsReduced.eq_zero z ⟨2, by rw [pow_two, h]⟩

/-- In a reduced local ring whose maximal ideal is `(x, y)` with `x ≠ 0` and `xy = 0`, the sum
`x + y` is a nonzerodivisor: an element killing it kills `x` and `y`, hence the maximal ideal,
hence itself. -/
theorem add_mem_nonZeroDivisors_of_mul_eq_zero (hxy : x * y = 0)
    (hm : maximalIdeal L = Ideal.span {x, y}) (hx : x ≠ 0) :
    x + y ∈ nonZeroDivisors L := by
  refine mem_nonZeroDivisors_iff_right.mpr fun f hf => ?_
  have hxf : x * f = 0 := eq_zero_of_mul_self_eq_zero (by
    linear_combination (x * f) * hf - f * f * hxy)
  have hyf : y * f = 0 := eq_zero_of_mul_self_eq_zero (by
    linear_combination (y * f) * hf - f * f * hxy)
  by_cases hf0 : f ∈ maximalIdeal L
  · rw [hm, Ideal.mem_span_pair] at hf0
    obtain ⟨a, b, hab⟩ := hf0
    exact eq_zero_of_mul_self_eq_zero (by linear_combination a * hxf + b * hyf - f * hab)
  · exact absurd (((notMem_maximalIdeal.mp hf0).mul_left_eq_zero).mp hxf) hx

/-- If the maximal ideal is `(x, y)`, then `x + y` lies in it. -/
private theorem add_mem_maximalIdeal_of_eq_span {R : Type*} [CommRing R] [IsLocalRing R] {a b : R}
    (hm : maximalIdeal R = Ideal.span {a, b}) : a + b ∈ maximalIdeal R := by
  rw [hm]
  exact Ideal.mem_span_pair.mpr ⟨1, 1, by ring⟩

/-- In a reduced local ring with `x, y ≠ 0` and `xy = 0`, the element `x` is not a multiple of
`x + y`. -/
theorem not_mem_span_add_of_mul_eq_zero (hxy : x * y = 0) (hx : x ≠ 0) (hy : y ≠ 0) :
    x ∉ Ideal.span {x + y} := by
  intro h
  obtain ⟨f, hf⟩ := Ideal.mem_span_singleton'.mp h
  have hfy : f * y = 0 := eq_zero_of_mul_self_eq_zero (by
    linear_combination (f * y) * hf + (f - f * f) * hxy)
  rcases isUnit_or_isUnit_one_sub_self f with hu | hu
  · exact hy ((hu.mul_right_eq_zero).mp hfy)
  · exact hx ((hu.mul_left_eq_zero).mp (by linear_combination -hf + hfy))

/-- **The order of vanishing of `x + y` at a node is `2`.** In a reduced local ring whose maximal
ideal is generated by nonzero elements `x` and `y` with `xy = 0`, the quotient `L/(x + y)` has
length `2`: the submodule generated by the class of `x` is killed by the maximal ideal, since
`x² = x (x + y)`, and the quotient by it is `L/(x + y, x)`, the residue field. -/
theorem ord_add_eq_two_of_mul_eq_zero (hxy : x * y = 0)
    (hm : maximalIdeal L = Ideal.span {x, y}) (hx : x ≠ 0) (hy : y ≠ 0) :
    Ring.ord L (x + y) = 2 := by
  let I : Submodule L L := Ideal.span {x + y}
  let xb : L ⧸ I := Submodule.Quotient.mk x
  let N : Submodule L (L ⧸ I) := Submodule.span L {xb}
  have hsimple : IsSimpleModule L (L ⧸ maximalIdeal L) :=
    isSimpleModule_iff_isCoatom.mpr (maximalIdeal.isMaximal L).out
  -- the class of `x` is killed exactly by the maximal ideal
  have htors : Ideal.torsionOf L (L ⧸ I) xb = maximalIdeal L := by
    ext a
    rw [Ideal.mem_torsionOf_iff]
    change Submodule.Quotient.mk (a • x) = 0 ↔ _
    rw [Submodule.Quotient.mk_eq_zero, smul_eq_mul]
    refine ⟨fun ha => ?_, fun ha => ?_⟩
    · by_contra hna
      obtain ⟨v, hv⟩ := (notMem_maximalIdeal.mp hna).exists_left_inv
      refine not_mem_span_add_of_mul_eq_zero hxy hx hy ?_
      have := Ideal.mul_mem_left I v ha
      rwa [← mul_assoc, hv, one_mul] at this
    · rw [hm, Ideal.mem_span_pair] at ha
      obtain ⟨c, d, rfl⟩ := ha
      exact Ideal.mem_span_singleton'.mpr ⟨c * x, by linear_combination (c - d) * hxy⟩
  have hN : Module.length L N = 1 := by
    rw [← (Ideal.quotTorsionOfEquivSpanSingleton L (L ⧸ I) xb).length_eq, htors]
    exact Module.length_eq_one L _
  -- the quotient by the class of `x` is the residue field
  have hsup : I ⊔ Submodule.span L {x} = maximalIdeal L := by
    rw [hm]
    apply le_antisymm
    · refine sup_le ((Submodule.span_singleton_le_iff_mem _ _).mpr ?_)
        ((Submodule.span_singleton_le_iff_mem _ _).mpr ?_)
      · exact hm ▸ add_mem_maximalIdeal_of_eq_span hm
      · exact Ideal.mem_span_pair.mpr ⟨1, 0, by ring⟩
    · refine Ideal.span_le.mpr ?_
      rintro z (rfl | rfl)
      · exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self z)
      · refine Submodule.mem_sup.mpr
          ⟨x + z, Submodule.mem_span_singleton_self _, -x,
            Submodule.neg_mem _ (Submodule.mem_span_singleton_self x), by ring⟩
  have hmap : (Submodule.span L {x}).map I.mkQ = N := by
    rw [Submodule.map_span, Set.image_singleton]
    rfl
  have hQ : Module.length L ((L ⧸ I) ⧸ N) = 1 := by
    rw [← hmap, (Submodule.quotientQuotientEquivQuotientSup I (Submodule.span L {x})).length_eq,
      hsup]
    exact Module.length_eq_one L _
  rw [Ring.ord, Module.length_eq_add_of_exact N.subtype N.mkQ N.injective_subtype
    N.mkQ_surjective (LinearMap.exact_subtype_mkQ N), hN, hQ]
  rfl

/-- A reduced Noetherian local ring whose maximal ideal is generated by nonzero `x` and `y` with
`xy = 0` has Krull dimension one: `x + y` is a nonzerodivisor in the maximal ideal and
`L/(x + y)` has finite length, hence dimension zero. -/
theorem ringKrullDim_eq_one_of_mul_eq_zero [IsNoetherianRing L] (hxy : x * y = 0)
    (hm : maximalIdeal L = Ideal.span {x, y}) (hx : x ≠ 0) (hy : y ≠ 0) :
    ringKrullDim L = 1 := by
  have hmem := add_mem_maximalIdeal_of_eq_span hm
  rw [← ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    (add_mem_nonZeroDivisors_of_mul_eq_zero hxy hm hx) hmem]
  have hlen : Module.length L (L ⧸ Ideal.span {x + y}) ≠ ⊤ := by
    have h := ord_add_eq_two_of_mul_eq_zero hxy hm hx hy
    rw [Ring.ord] at h
    rw [h]
    exact ENat.natCast_ne_top 2
  have hart : IsArtinian L (L ⧸ Ideal.span {x + y}) :=
    (isFiniteLength_iff_isNoetherian_isArtinian.mp (Module.length_ne_top_iff.mp hlen)).2
  have : IsArtinianRing (L ⧸ Ideal.span {x + y}) := isArtinian_of_tower L hart
  have : Nontrivial (L ⧸ Ideal.span {x + y}) :=
    Ideal.Quotient.nontrivial_iff.mpr (fun h => (maximalIdeal.isMaximal L).ne_top
      (top_le_iff.mp (h ▸ (Ideal.span_singleton_le_iff_mem _).mpr hmem)))
  have h0 : ringKrullDim (L ⧸ Ideal.span {x + y}) = 0 :=
    le_antisymm (Ring.krullDimLE_iff.mp inferInstance) ringKrullDim_nonneg_of_nontrivial
  rw [h0, zero_add]

end Ring
