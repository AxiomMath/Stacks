module

public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.RingHom.Flat

/-!
# Strict local homomorphisms

A local homomorphism `φ : R → B` of local rings is *strict* if it is flat, extends the maximal
ideal of `R` to the maximal ideal of `B`, and is surjective on residue fields. The completion of
a Noetherian local ring, and the map on local rings at the closed points of a base change along a
strict homomorphism, are strict.

This file proves the algebraic half of the second statement: for a local `R`-algebra `O` (with
local structure map) and a strict `φ : R → B`, the ideal of `O ⊗[R] B` generated by the maximal
ideal of `O` is maximal with residue field the residue field of `O`; so a localization of
`O ⊗[R] B` at a prime is, as soon as the composite `O → O ⊗[R] B → (O ⊗[R] B)_Q` is local, a
local ring whose maximal ideal is generated by that of `O` and whose residue field is that of `O`.

## Main definitions

* `IsStrictLocalHom`

## Main results

* `IsStrictLocalHom.comp`, `IsStrictLocalHom.of_ringEquiv`
* `IsStrictLocalHom.exists_includeLeft_sub_mem`: every element of `O ⊗[R] B` is congruent to an
  element of `O` modulo the ideal generated by the maximal ideal of `O`.
* `IsStrictLocalHom.map_maximalIdeal_and_surjective_of_isLocalization`: the transfer to a
  localization of `O ⊗[R] B`.
-/

@[expose] public section

open IsLocalRing

open scoped TensorProduct

universe u v w

/-- A local homomorphism of local rings is strict if it is flat, extends the maximal ideal to
the maximal ideal, and is surjective on residue fields. -/
structure IsStrictLocalHom {R : Type u} {B : Type v} [CommRing R] [CommRing B] [IsLocalRing R]
    [IsLocalRing B] (φ : R →+* B) : Prop where
  flat : φ.Flat
  isLocalHom : IsLocalHom φ
  map_maximalIdeal : Ideal.map φ (maximalIdeal R) = maximalIdeal B
  surjective_residue : Function.Surjective ((residue B).comp φ)

namespace IsStrictLocalHom

variable {R : Type u} {B : Type v} {C : Type w} [CommRing R] [CommRing B] [CommRing C]
  [IsLocalRing R] [IsLocalRing B] [IsLocalRing C]

/-- The composite of two strict local homomorphisms is strict. -/
theorem comp {φ : R →+* B} {ψ : B →+* C} (hφ : IsStrictLocalHom φ) (hψ : IsStrictLocalHom ψ) :
    IsStrictLocalHom (ψ.comp φ) := by
  have := hφ.isLocalHom
  have := hψ.isLocalHom
  refine ⟨RingHom.Flat.comp hφ.flat hψ.flat, inferInstance, ?_, ?_⟩
  · rw [← Ideal.map_map, hφ.map_maximalIdeal, hψ.map_maximalIdeal]
  · intro c
    obtain ⟨b, hb⟩ := hψ.surjective_residue c
    obtain ⟨r, hr⟩ := hφ.surjective_residue (residue B b)
    refine ⟨r, ?_⟩
    simp only [RingHom.comp_apply] at hb hr ⊢
    rw [← hb]
    have : ψ (φ r) - ψ b ∈ maximalIdeal C := by
      rw [← map_sub]
      exact map_nonunit ψ _ (Ideal.Quotient.eq.mp hr)
    exact Ideal.Quotient.eq.mpr this

/-- A ring isomorphism between local rings is a strict local homomorphism. -/
theorem of_ringEquiv (e : R ≃+* B) : IsStrictLocalHom (e : R →+* B) := by
  have : IsLocalHom (e : R →+* B) := IsLocalHom.of_surjective _ e.surjective
  refine ⟨RingHom.Flat.of_bijective e.bijective, inferInstance, ?_, ?_⟩
  · refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun r hr => ?_) fun b hb => ?_
    · exact map_nonunit (e : R →+* B) r hr
    · have : e.symm b ∈ maximalIdeal R := by
        refine (mem_maximalIdeal _).mpr fun hu => (mem_maximalIdeal _).mp hb ?_
        simpa using hu.map (e : R →+* B)
      simpa using Ideal.mem_map_of_mem (e : R →+* B) this
  · intro c
    obtain ⟨b, rfl⟩ := residue_surjective c
    exact ⟨e.symm b, by simp⟩

end IsStrictLocalHom

namespace IsStrictLocalHom

variable {R : Type u} {B : Type u} [CommRing R] [CommRing B] [IsLocalRing R] [IsLocalRing B]
  [Algebra R B] (hφ : IsStrictLocalHom (algebraMap R B))
  {O : Type u} [CommRing O] [IsLocalRing O] [Algebra R O] [IsLocalHom (algebraMap R O)]
include hφ

/-- **Every element of `O ⊗[R] B` is an element of `O` modulo the maximal ideal of `O`.** Write
the second factor as the image of an element of `R` plus an element of the maximal ideal of `B`,
which is generated by that of `R`; the latter part moves to the first factor, where it lands in
the maximal ideal of `O`. -/
theorem exists_includeLeft_sub_mem :
    ∀ t : O ⊗[R] B, ∃ o : O, t - Algebra.TensorProduct.includeLeftRingHom o ∈
      Ideal.map (Algebra.TensorProduct.includeLeftRingHom : O →+* O ⊗[R] B) (maximalIdeal O) := by
  set M := Ideal.map (Algebra.TensorProduct.includeLeftRingHom : O →+* O ⊗[R] B) (maximalIdeal O)
  have key : ∀ (o : O) (r : R), o ⊗ₜ[R] algebraMap R B r =
      Algebra.TensorProduct.includeLeftRingHom (algebraMap R O r * o) := by
    intro o r
    rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.algebraMap_eq_smul_one (A := B),
      TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def]
  have hmB : ∀ o : O, ∀ n ∈ maximalIdeal B, o ⊗ₜ[R] n ∈ M := by
    intro o n hn
    rw [← hφ.map_maximalIdeal] at hn
    induction hn using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨r, hr, rfl⟩ := hx
      rw [key]
      exact Ideal.mem_map_of_mem _ (Ideal.mul_mem_right _ _ (map_nonunit (algebraMap R O) r hr))
    | zero => simp
    | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact M.add_mem hx hy
    | smul a x _ hx =>
      rw [smul_eq_mul]
      have : o ⊗ₜ[R] (a * x) = (1 ⊗ₜ[R] a) * (o ⊗ₜ[R] x) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      rw [this]
      exact M.mul_mem_left _ hx
  intro t
  induction t using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul o b =>
    obtain ⟨r, hr⟩ := hφ.surjective_residue (residue B b)
    have hn : b - algebraMap R B r ∈ maximalIdeal B := by
      rw [← Ideal.Quotient.eq]
      exact hr.symm
    refine ⟨algebraMap R O r * o, ?_⟩
    rw [← key, ← TensorProduct.tmul_sub]
    exact hmB o _ hn
  | add t₁ t₂ h₁ h₂ =>
    obtain ⟨o₁, ho₁⟩ := h₁
    obtain ⟨o₂, ho₂⟩ := h₂
    refine ⟨o₁ + o₂, ?_⟩
    rw [map_add, add_sub_add_comm]
    exact M.add_mem ho₁ ho₂

/-- **Localizing `O ⊗[R] B` at a prime above the maximal ideal of `O`.** Let `O'` be the
localization of `O ⊗[R] B` at a prime `Q`, and suppose the composite `O → O'` is local. Then the
maximal ideal of `O'` is generated by that of `O`, and `O → O'` is surjective on residue fields.
Indeed the ideal generated by the maximal ideal of `O` is maximal in `O ⊗[R] B`, every element
being congruent to an element of `O` modulo it, so it is `Q`. -/
theorem map_maximalIdeal_and_surjective_of_isLocalization {O' : Type u} [CommRing O']
    [IsLocalRing O'] :
    ∀ (ψ : O ⊗[R] B →+* O'), IsLocalHom (ψ.comp Algebra.TensorProduct.includeLeftRingHom) →
      letI := ψ.toAlgebra
      IsLocalization.AtPrime O' (Ideal.comap ψ (maximalIdeal O')) →
      Ideal.map (ψ.comp Algebra.TensorProduct.includeLeftRingHom) (maximalIdeal O) =
          maximalIdeal O' ∧
        Function.Surjective
          ((residue O').comp (ψ.comp Algebra.TensorProduct.includeLeftRingHom)) := by
  intro ψ hloc
  let := ψ.toAlgebra
  intro hlocz
  let ι : O →+* O ⊗[R] B := Algebra.TensorProduct.includeLeftRingHom
  let Q := Ideal.comap ψ (maximalIdeal O')
  let M := Ideal.map ι (maximalIdeal O)
  have hcong : ∀ t : O ⊗[R] B, ∃ o : O, t - ι o ∈ M := hφ.exists_includeLeft_sub_mem (O := O)
  have hMQ : M ≤ Q := by
    rw [Ideal.map_le_iff_le_comap]
    intro o ho
    exact map_nonunit (ψ.comp ι) o ho
  have hmem : ∀ o : O, ι o ∈ Q → o ∈ maximalIdeal O := by
    intro o ho
    by_contra hn
    exact (mem_maximalIdeal _).mp ho ((notMem_maximalIdeal.mp hn).map (ψ.comp ι))
  have hQM : Q ≤ M := by
    intro t ht
    obtain ⟨o, ho⟩ := hcong t
    have : ι o ∈ Q := by
      have h1 := Q.sub_mem ht (hMQ ho)
      rwa [sub_sub_cancel] at h1
    have h2 := M.add_mem ho (Ideal.mem_map_of_mem ι (hmem o this))
    rwa [sub_add_cancel] at h2
  have hQ : Q = M := le_antisymm hQM hMQ
  refine ⟨?_, ?_⟩
  · rw [← Ideal.map_map]
    show Ideal.map ψ M = _
    rw [← hQ]
    exact IsLocalization.AtPrime.map_eq_maximalIdeal Q O'
  · intro z
    obtain ⟨w, rfl⟩ := residue_surjective z
    obtain ⟨⟨t, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl w
    obtain ⟨ot, hot⟩ := hcong t
    obtain ⟨os, hos⟩ := hcong (s : O ⊗[R] B)
    have hosu : IsUnit os := by
      rw [← notMem_maximalIdeal]
      intro h
      apply s.2
      have h3 := Q.add_mem (hMQ hos) (hMQ (Ideal.mem_map_of_mem ι h))
      rwa [sub_add_cancel] at h3
    have hres : ∀ (u : O ⊗[R] B) (o : O), u - ι o ∈ M →
        residue O' (ψ u) = residue O' (ψ (ι o)) := by
      intro u o h
      show Ideal.Quotient.mk _ (ψ u) = Ideal.Quotient.mk _ (ψ (ι o))
      rw [Ideal.Quotient.eq, ← map_sub]
      exact hMQ h
    refine ⟨ot * ↑(hosu.unit⁻¹), ?_⟩
    have hs0 : residue O' (ψ (ι os)) ≠ 0 := by
      rw [ne_eq, residue_eq_zero_iff]
      exact fun h => (mem_maximalIdeal _).mp h ((hosu.map ι).map ψ)
    have hspec := IsLocalization.mk'_spec O' t s
    rw [show (algebraMap (O ⊗[R] B) O') = ψ from rfl] at hspec
    apply mul_right_cancel₀ hs0
    simp only [RingHom.comp_apply]
    rw [← map_mul, ← map_mul, ← map_mul, mul_assoc, IsUnit.val_inv_mul, mul_one,
      ← hres _ _ hos, ← map_mul, hspec, hres _ _ hot]

end IsStrictLocalHom
