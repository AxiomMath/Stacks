module

public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.RingTheory.Flat.Localization
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Submodule
import Mathlib.RingTheory.Polynomial.Basic

/-!
# Passing to an infinite residue field

For a Noetherian local ring `(A, 𝔪, κ)` the localization `A(t) = A[t]_{𝔪A[t]}` of the polynomial
ring at the prime `𝔪A[t]` is a Noetherian local ring, flat over `A`, whose maximal ideal is
generated by `𝔪`, and whose residue field `κ(t)` is infinite. This is the standard device for
reducing statements about a Noetherian local ring to the case of an infinite residue field.

## Main results

* `IsLocalRing.exists_flat_isNoetherianRing_infinite_residueField`: every Noetherian local ring
  has a flat local extension, Noetherian, with maximal ideal generated by the maximal ideal of the
  base and with infinite residue field.

## Implementation notes

The flat local extension with prescribed residue field of [Stacks, Tag 03C3]
(`IsLocalRing.exists_flat_residueField_algEquiv`) is not known to be Noetherian, which is why the
explicit localization of the polynomial ring is used here.
-/

@[expose] public section

open Polynomial IsLocalRing

universe u

namespace IsLocalRing

/-- **Passing to an infinite residue field.** A Noetherian local ring `A` has a flat local
extension `B` which is Noetherian, with `𝔪_A B = 𝔪_B` and infinite residue field; one can take
`B = A[t]_{𝔪A[t]}`. -/
theorem exists_flat_isNoetherianRing_infinite_residueField (A : Type u) [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] :
    ∃ (B : Type u) (_ : CommRing B) (_ : IsLocalRing B) (_ : IsNoetherianRing B)
      (_ : Algebra A B) (_ : IsLocalHom (algebraMap A B)),
      Module.Flat A B ∧ (maximalIdeal A).map (algebraMap A B) = maximalIdeal B ∧
        Infinite (ResidueField B) := by
  let P : Ideal A[X] := (maximalIdeal A).map C
  let B := Localization.AtPrime P
  have hmap : (maximalIdeal A).map (algebraMap A B) = maximalIdeal B := by
    rw [IsScalarTower.algebraMap_eq A A[X] B, ← Ideal.map_map]
    exact Localization.AtPrime.map_eq_maximalIdeal
  have hflat : Module.Flat A B := Module.Flat.trans A A[X] B
  refine ⟨B, inferInstance, inferInstance, inferInstance, inferInstance, ?_, hflat, hmap, ?_⟩
  · refine ⟨fun a ha => ?_⟩
    by_contra hna
    have : algebraMap A B a ∈ maximalIdeal B :=
      hmap ▸ Ideal.mem_map_of_mem _ ((mem_maximalIdeal a).mpr hna)
    exact (mem_maximalIdeal _).mp this ha
  · have hcomap : (maximalIdeal B).comap (algebraMap A[X] B) = P :=
      Localization.AtPrime.under_maximalIdeal
    let f : ℕ → ResidueField B := fun n => residue B (algebraMap A[X] B (X ^ n))
    refine Infinite.of_injective f fun n m hnm => ?_
    by_contra hne
    have hsub : (X ^ n - X ^ m : A[X]) ∈ P := by
      rwa [← hcomap, Ideal.mem_comap, map_sub, ← IsLocalRing.residue_eq_zero_iff, map_sub,
        sub_eq_zero]
    have hcoeff := (Ideal.mem_map_C_iff.mp hsub) n
    rw [coeff_sub, coeff_X_pow_self, coeff_X_pow, if_neg hne, sub_zero] at hcoeff
    exact (maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr hcoeff)

end IsLocalRing
