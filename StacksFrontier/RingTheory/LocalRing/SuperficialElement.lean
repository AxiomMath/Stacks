/-!
# Superficial elements of the maximal ideal

Let `(A, 𝔪, κ)` be a Noetherian local ring with infinite residue field. A general element
`b ∈ 𝔪` is *superficial*: multiplication by its initial form is injective on the associated
graded ring `⊕ 𝔪ⁿ/𝔪ⁿ⁺¹` in all large degrees, that is,

`r ∈ 𝔪ⁿ` and `b r ∈ 𝔪ⁿ⁺²` imply `r ∈ 𝔪ⁿ⁺¹` for all `n ≫ 0`.

Moreover `b` can be taken outside any finite family of ideals not containing `𝔪`.

## Main results

* `Submodule.iUnion_ne_univ_of_isLocalRing`: a module over a local ring with infinite residue
  field is not a finite union of proper submodules.
* `IsLocalRing.exists_mem_maximalIdeal_forall_mul_mem_pow_imp_mem_pow`: existence of superficial
  elements of the maximal ideal, avoiding finitely many ideals not containing it.

## Implementation notes

The argument takes place in the Rees algebra `R = A[𝔪t] ⊆ A[t]`, which is Noetherian. The ideal
`𝔞 = 𝔪R` consists of the `f` whose coefficient of `tⁿ` lies in `𝔪ⁿ⁺¹`, so `R/𝔞` is the
associated graded ring. Its saturation `𝔞^sat = {f | R₊^k f ⊆ 𝔞 for some k}` with respect to
`R₊ = (𝔪t)` agrees with `𝔞` in large degrees: it is generated by finitely many elements, each
pushed into `𝔞` by a power of `R₊`, and these have bounded degree. No associated prime of
`R/𝔞^sat` contains `R₊`, because `𝔞^sat` is saturated, so the `c ∈ 𝔪` with `ct` in a given
associated prime form a proper submodule of `𝔪`. A `b` outside these finitely many proper
submodules, and outside the proper submodules `(P ∩ 𝔪) + 𝔪²` for the ideals `P` to be avoided,
exists by the covering statement; then `bt` is a nonzerodivisor on `R/𝔞^sat`, which gives the
claim in large degrees.
-/

@[expose] public noncomputable section

open Polynomial

/-- **A module over a local ring with infinite residue field is not a finite union of proper
submodules.** -/
theorem Submodule.iUnion_ne_univ_of_isLocalRing {A M ι : Type*} [CommRing A] [IsLocalRing A]
    [Infinite (IsLocalRing.ResidueField A)] [AddCommGroup M] [Module A M]
    {p : ι → Submodule A M} {s : Finset ι} (hs : ∀ i ∈ s, p i ≠ ⊤) :
    ⋃ i ∈ s, (p i : Set M) ≠ Set.univ := by
  intro hcovers
  obtain ⟨i, hi, hfi⟩ := Submodule.exists_finiteIndex_of_cover hcovers
  have : Finite (M ⧸ p i) := AddSubgroup.finite_quotient_of_finiteIndex
  obtain ⟨v, hv⟩ : ∃ v : M, v ∉ p i := by
    by_contra! h
    exact hs i hi (eq_top_iff.mpr fun v _ => h v)
  let lift := Function.surjInv (IsLocalRing.residue_surjective (R := A))
  have hlift : ∀ x, IsLocalRing.residue A (lift x) = x :=
    Function.surjInv_eq (IsLocalRing.residue_surjective (R := A))
  have hinj : Function.Injective fun x : IsLocalRing.ResidueField A =>
      lift x • Submodule.Quotient.mk (p := p i) v := by
    intro x y hxy
    simp only at hxy
    rw [← sub_eq_zero, ← sub_smul] at hxy
    by_cases hm : lift x - lift y ∈ IsLocalRing.maximalIdeal A
    · rwa [← hlift x, ← hlift y, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    · have hu : IsUnit (lift x - lift y) := by
        simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using hm
      obtain ⟨u, hu⟩ := hu
      have h0 : Submodule.Quotient.mk (p := p i) v = 0 := by
        rw [← hu] at hxy
        simpa [Units.smul_def] using congrArg (fun z => (↑u⁻¹ : A) • z) hxy
      exact (hv ((Submodule.Quotient.mk_eq_zero _).mp h0)).elim
  have := Finite.of_injective _ hinj
  exact _root_.not_finite (IsLocalRing.ResidueField A)

/-- An element of `A ⧸ J` dies in `A ⧸ (sA + J)` iff it is a multiple of `s` modulo `J`. -/
private theorem factor_span_singleton_sup_mk_eq_zero_iff {A : Type*} [CommRing A] (s : A)
    (J : Ideal A) (y : A) :
    Submodule.factor (le_sup_right : J ≤ Ideal.span {s} ⊔ J) (Submodule.Quotient.mk y) = 0 ↔
      ∃ c : A, (Submodule.Quotient.mk (s * c) : A ⧸ J) = Submodule.Quotient.mk y := by
  change (Submodule.Quotient.mk y : A ⧸ (Ideal.span {s} ⊔ J)) = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_sup]
  constructor
  · rintro ⟨u, hu, w, hw, rfl⟩
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hu
    refine ⟨c, ?_⟩
    rw [Submodule.Quotient.eq]
    simpa [mul_comm] using J.neg_mem hw
  · rintro ⟨c, hc⟩
    rw [Submodule.Quotient.eq] at hc
    exact ⟨s * c, Ideal.mem_span_singleton'.mpr ⟨c, mul_comm _ _⟩, y - s * c,
      by simpa using J.neg_mem hc, by ring⟩

namespace IsLocalRing

variable {A : Type*} [CommRing A] [IsLocalRing A]

namespace Superficial

variable (A) in
/-- The Rees algebra of the maximal ideal, as a type. -/
private abbrev Rees : Type _ := ↥(reesAlgebra (maximalIdeal A))

/-- The monomial `c tⁿ` of the Rees algebra, for `c ∈ 𝔪ⁿ`. -/
private def mono (n : ℕ) (c : A) (hc : c ∈ maximalIdeal A ^ n) : Rees A :=
  ⟨monomial n c, reesAlgebra.monomial_mem.mpr hc⟩

private theorem coe_mono (n : ℕ) (c : A) (hc : c ∈ maximalIdeal A ^ n) :
    ((mono n c hc : Rees A) : A[X]) = monomial n c :=
  rfl

private theorem coeff_mem (f : Rees A) (n : ℕ) : (f : A[X]).coeff n ∈ maximalIdeal A ^ n :=
  (mem_reesAlgebra_iff _ _).mp f.2 n

/-- The irrelevant ideal `R₊ = (𝔪 t)` of the Rees algebra. -/
private def irrelevant : Ideal (Rees A) :=
  Ideal.span (Set.range fun c : maximalIdeal A => mono 1 c.1 (by simp))

/-- A monomial of degree `n` lies in the `n`-th power of the irrelevant ideal. -/
private theorem mono_mem_irrelevant_pow (n : ℕ) (c : A) (hc : c ∈ maximalIdeal A ^ n) :
    mono n c hc ∈ (irrelevant (A := A)) ^ n := by
  induction n generalizing c with
  | zero =>
    simp
  | succ n ih =>
    have key : ∀ (c : A) (hc : c ∈ maximalIdeal A ^ n * maximalIdeal A),
        mono (n + 1) c (by rw [pow_succ]; exact hc) ∈ irrelevant ^ (n + 1) := by
      intro c hc'
      induction hc' using Submodule.mul_induction_on' with
      | mem_mul_mem x hx y hy =>
        have heq : mono (n + 1) (x * y) (by rw [pow_succ]; exact Submodule.mul_mem_mul hx hy) =
            mono n x hx * mono 1 y (by simpa using hy) :=
          Subtype.ext (by simp [coe_mono, monomial_mul_monomial])
        rw [heq, pow_succ]
        exact Ideal.mul_mem_mul (ih x hx) (Ideal.subset_span ⟨⟨y, hy⟩, rfl⟩)
      | add x hx y hy ihx ihy =>
        have heq : mono (n + 1) (x + y) (by rw [pow_succ]; exact Submodule.add_mem _ hx hy) =
            mono (n + 1) x (by rw [pow_succ]; exact hx) +
              mono (n + 1) y (by rw [pow_succ]; exact hy) :=
          Subtype.ext (by simp [coe_mono])
        rw [heq]
        exact Ideal.add_mem _ ihx ihy
    exact key c (by rwa [← pow_succ])

/-- The ideal `𝔞 = 𝔪 R` of the Rees algebra: the coefficient of `tⁿ` lies in `𝔪ⁿ⁺¹`. -/
private def fib : Ideal (Rees A) where
  carrier := {f | ∀ n, (f : A[X]).coeff n ∈ maximalIdeal A ^ (n + 1)}
  add_mem' := by
    intro f g hf hg n
    simpa using Ideal.add_mem _ (hf n) (hg n)
  zero_mem' := by
    intro n
    simp
  smul_mem' := by
    intro g f hf n
    change ((g * f : Rees A) : A[X]).coeff n ∈ _
    rw [MulMemClass.coe_mul, coeff_mul]
    refine Ideal.sum_mem _ fun p hp => ?_
    rw [Finset.mem_antidiagonal] at hp
    have h := Ideal.mul_mem_mul (coeff_mem g p.1) (hf p.2)
    rwa [← pow_add, show p.1 + (p.2 + 1) = n + 1 by omega] at h

/-- The saturation of `𝔞` with respect to the irrelevant ideal. -/
private def sat : Ideal (Rees A) where
  carrier := {f | ∃ k : ℕ, ∀ g ∈ irrelevant ^ k, g * f ∈ fib}
  add_mem' := by
    rintro f f' ⟨k, hk⟩ ⟨k', hk'⟩
    refine ⟨max k k', fun g hg => ?_⟩
    rw [mul_add]
    exact Ideal.add_mem _ (hk g (Ideal.pow_le_pow_right (le_max_left _ _) hg))
      (hk' g (Ideal.pow_le_pow_right (le_max_right _ _) hg))
  zero_mem' := ⟨0, fun g _ => by simp⟩
  smul_mem' := by
    rintro c f ⟨k, hk⟩
    refine ⟨k, fun g hg => ?_⟩
    rw [smul_eq_mul, mul_left_comm]
    exact fib.mul_mem_left c (hk g hg)

private theorem fib_le_sat : (fib : Ideal (Rees A)) ≤ sat :=
  fun _ hf => ⟨0, fun g _ => fib.mul_mem_left g hf⟩

variable [IsNoetherianRing A]

private instance : IsNoetherianRing (Rees A) :=
  isNoetherianRing_of_fg (reesAlgebra.fg (IsNoetherian.noetherian _))

/-- The saturation is saturated. -/
private theorem mem_sat_of_irrelevant_mul_le {f : Rees A}
    (hf : ∀ g ∈ (irrelevant (A := A)), g * f ∈ sat) : f ∈ sat := by
  classical
  obtain ⟨s, hs⟩ := (IsNoetherian.noetherian (irrelevant (A := A)) :
    (irrelevant (A := A)).FG)
  have hmem : ∀ g ∈ s, ∃ k : ℕ, ∀ h ∈ irrelevant ^ k, h * (g * f) ∈ fib := fun g hg =>
    hf g (hs ▸ Ideal.subset_span hg)
  choose! K hK using hmem
  refine ⟨s.sup K + 1, fun h hh => ?_⟩
  rw [pow_succ] at hh
  have key : irrelevant ^ s.sup K * irrelevant ≤ fib.colon {f} := by
    refine Ideal.mul_le.mpr fun a ha g hg => ?_
    rw [← hs] at hg
    induction hg using Submodule.span_induction with
    | mem g hg' =>
      rw [Submodule.mem_colon_singleton, smul_eq_mul, mul_assoc]
      exact hK g hg' a (Ideal.pow_le_pow_right (Finset.le_sup hg') ha)
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
    | smul c x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ c hx
  have := key hh
  rwa [Submodule.mem_colon_singleton, smul_eq_mul] at this

/-- The saturation agrees with `𝔞` in large degrees. -/
private theorem exists_mem_pow_of_mono_mem_sat :
    ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ (r : A) (hr : r ∈ maximalIdeal A ^ n), mono n r hr ∈ sat →
      r ∈ maximalIdeal A ^ (n + 1) := by
  classical
  obtain ⟨s, hs⟩ := (IsNoetherian.noetherian (sat (A := A)) : (sat (A := A)).FG)
  have hmem : ∀ g ∈ s, ∃ k : ℕ, ∀ h ∈ irrelevant ^ k, h * g ∈ fib := fun g hg =>
    (hs ▸ Ideal.subset_span hg : g ∈ sat)
  choose! K hK using hmem
  refine ⟨s.sup (fun g => (g : A[X]).natDegree) + s.sup K, fun n hn r hr hsat => ?_⟩
  rw [← hs] at hsat
  obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp hsat
  have hcoeff := congrArg (fun f : Rees A => (f : A[X]).coeff n) hc
  simp only [coe_mono, coeff_monomial_same] at hcoeff
  rw [← hcoeff, AddSubmonoidClass.coe_finset_sum, finset_sum_coeff]
  refine Ideal.sum_mem _ fun g hg => ?_
  rw [smul_eq_mul, MulMemClass.coe_mul, coeff_mul]
  refine Ideal.sum_mem _ fun p hp => ?_
  rw [Finset.mem_antidiagonal] at hp
  by_cases hdeg : (g : A[X]).natDegree < p.2
  · rw [coeff_eq_zero_of_natDegree_lt hdeg, mul_zero]
    exact Ideal.zero_mem _
  · push Not at hdeg
    have hD : (g : A[X]).natDegree ≤ s.sup (fun g : Rees A => (g : A[X]).natDegree) :=
      Finset.le_sup (f := fun g : Rees A => (g : A[X]).natDegree) hg
    have hK' : K g ≤ s.sup K := Finset.le_sup hg
    have hmono := mono_mem_irrelevant_pow p.1 _ (coeff_mem (c g) p.1)
    have hfib := hK g hg _ (Ideal.pow_le_pow_right (by omega) hmono) n
    rw [MulMemClass.coe_mul, coe_mono, show n = p.2 + p.1 by omega, coeff_monomial_mul] at hfib
    rwa [show p.2 + p.1 = n by omega] at hfib

/-- Some `c t` avoids each associated prime of `R / 𝔞^sat`. -/
private theorem exists_mono_notMem {P : Ideal (Rees A)}
    (hP : P ∈ associatedPrimes (Rees A) (Rees A ⧸ (sat : Submodule (Rees A) (Rees A)))) :
    ∃ c : maximalIdeal A, mono 1 c.1 (by simp) ∉ P := by
  obtain ⟨hprime, x, hx⟩ := (isAssociatedPrime_iff).mp hP
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  have hcol : ∀ r : Rees A, r ∈ P ↔ r * x ∈ sat := fun r => by
    rw [hx, Submodule.mem_colon_singleton, ← Submodule.Quotient.mk_smul,
      Submodule.mem_bot, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
  by_contra! hall
  have hle : irrelevant ≤ P := Ideal.span_le.mpr (Set.range_subset_iff.mpr hall)
  have hxsat : x ∈ sat := mem_sat_of_irrelevant_mul_le fun g hg => (hcol g).mp (hle hg)
  exact hprime.ne_top ((Ideal.eq_top_iff_one P).mpr ((hcol 1).mpr (by simpa using hxsat)))

end Superficial

open Superficial in
/-- **Superficial elements.** Let `(A, 𝔪, κ)` be a Noetherian local ring with infinite residue
field and let `Ps` be a finite set of ideals none of which contains `𝔪`. Then there are `b ∈ 𝔪`
outside every member of `Ps` and `N` such that for all `n ≥ N`, `r ∈ 𝔪ⁿ` and `b r ∈ 𝔪ⁿ⁺²` imply
`r ∈ 𝔪ⁿ⁺¹`: the initial form of `b` is a nonzerodivisor on `⊕ 𝔪ⁿ/𝔪ⁿ⁺¹` in large degrees. -/
theorem exists_mem_maximalIdeal_forall_mul_mem_pow_imp_mem_pow [IsNoetherianRing A]
    [Infinite (ResidueField A)] (Ps : Finset (Ideal A)) (hPs : ∀ P ∈ Ps, ¬ maximalIdeal A ≤ P) :
    ∃ b ∈ maximalIdeal A, (∀ P ∈ Ps, b ∉ P) ∧
      ∃ N : ℕ, ∀ n ≥ N, ∀ r ∈ maximalIdeal A ^ n, b * r ∈ maximalIdeal A ^ (n + 2) →
        r ∈ maximalIdeal A ^ (n + 1) := by
  classical
  let ℓ : maximalIdeal A →ₗ[A] Rees A :=
    { toFun := fun c => mono 1 c.1 (by simp)
      map_add' := fun c d => Subtype.ext (by simp [coe_mono])
      map_smul' := fun a c => Subtype.ext (by
        simp [coe_mono, Algebra.smul_def, Polynomial.C_mul_monomial]) }
  let Qs := (associatedPrimes.finite (Rees A)
    (Rees A ⧸ (sat : Submodule (Rees A) (Rees A)))).toFinset
  let p : Ideal (Rees A) ⊕ Ideal A → Submodule A (maximalIdeal A) :=
    Sum.elim (fun Q => (Q.restrictScalars A).comap ℓ)
      (fun P => Submodule.comap (maximalIdeal A).subtype (P ⊔ maximalIdeal A ^ 2))
  have hp : ∀ i ∈ Qs.disjSum Ps, p i ≠ ⊤ := by
    intro i hi
    rcases i with Q | P
    · rw [Finset.inl_mem_disjSum] at hi
      obtain ⟨c, hc⟩ := exists_mono_notMem ((Set.Finite.mem_toFinset _).mp hi)
      intro htop
      exact hc (show c ∈ p (Sum.inl Q) from htop ▸ Submodule.mem_top)
    · rw [Finset.inr_mem_disjSum] at hi
      intro htop
      refine hPs P hi ?_
      have hle : maximalIdeal A ≤ P ⊔ maximalIdeal A • maximalIdeal A := by
        intro x hx
        have : (⟨x, hx⟩ : maximalIdeal A) ∈ p (Sum.inr P) := htop ▸ Submodule.mem_top
        simpa [p, pow_two, smul_eq_mul] using this
      exact Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
        (maximalIdeal_le_jacobson _) hle
  have hcov := Submodule.iUnion_ne_univ_of_isLocalRing hp
  obtain ⟨b, hb⟩ : ∃ b : maximalIdeal A, b ∉ ⋃ i ∈ Qs.disjSum Ps, (p i : Set (maximalIdeal A)) := by
    by_contra! h
    exact hcov (Set.eq_univ_of_forall h)
  simp only [Set.mem_iUnion, SetLike.mem_coe, not_exists] at hb
  obtain ⟨N₀, hN₀⟩ := exists_mem_pow_of_mono_mem_sat (A := A)
  refine ⟨b.1, b.2, fun P hP hbP => ?_, N₀, fun n hn r hr hbr => ?_⟩
  · exact hb (Sum.inr P) (Finset.inr_mem_disjSum.mpr hP)
      (Submodule.mem_comap.mpr (Ideal.mem_sup_left hbP))
  · -- `b t` is a nonzerodivisor on `R / 𝔞^sat`
    have hreg : ∀ f : Rees A, ℓ b * f ∈ sat → f ∈ sat := by
      intro f hf
      by_contra hfs
      have hzd : ℓ b ∈ ⋃ P ∈ associatedPrimes (Rees A)
          (Rees A ⧸ (sat : Submodule (Rees A) (Rees A))), (P : Set (Rees A)) := by
        rw [biUnion_associatedPrimes_eq_zero_divisors]
        refine ⟨Submodule.Quotient.mk f, ?_, ?_⟩
        · rwa [Ne, Submodule.Quotient.mk_eq_zero]
        · rwa [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
      simp only [Set.mem_iUnion, SetLike.mem_coe] at hzd
      obtain ⟨Q, hQ, hbQ⟩ := hzd
      exact hb (Sum.inl Q) (Finset.inl_mem_disjSum.mpr ((Set.Finite.mem_toFinset _).mpr hQ)) hbQ
    have hprod : ℓ b * mono n r hr ∈ sat := by
      refine fib_le_sat fun j => ?_
      have hc : ((ℓ b * mono n r hr : Rees A) : A[X]) = monomial (1 + n) (b.1 * r) := by
        simp [ℓ, coe_mono, monomial_mul_monomial]
      rw [hc, coeff_monomial]
      split_ifs with hj
      · subst hj
        rwa [show 1 + n + 1 = n + 2 by omega]
      · exact Ideal.zero_mem _
    exact hN₀ n hn r hr (hreg _ hprod)

/-- **A superficial nonzerodivisor.** If `b` is a nonzerodivisor whose initial form is a
nonzerodivisor on `⊕ 𝔪ⁿ/𝔪ⁿ⁺¹` in large degrees, then `(𝔪ⁿ⁺¹ : b) = 𝔪ⁿ` for all large `n`. The
proof combines the Artin–Rees lemma for `bA ⊆ A`, which gives `(𝔪ⁿ⁺¹ : b) ⊆ 𝔪ⁿ⁺¹⁻ᵏ`, with the
hypothesis, which raises the exponent one step at a time. -/
theorem exists_forall_mul_mem_pow_succ_imp_mem_pow [IsNoetherianRing A] {b : A}
    (hreg : IsSMulRegular A b) {N : ℕ}
    (hN : ∀ n ≥ N, ∀ r ∈ maximalIdeal A ^ n, b * r ∈ maximalIdeal A ^ (n + 2) →
      r ∈ maximalIdeal A ^ (n + 1)) :
    ∃ N' : ℕ, ∀ n ≥ N', ∀ r : A, b * r ∈ maximalIdeal A ^ (n + 1) →
      r ∈ maximalIdeal A ^ n := by
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul (maximalIdeal A) (Ideal.span {b})
  refine ⟨N + k, fun n hn r hr => ?_⟩
  have h1 : r ∈ maximalIdeal A ^ (n + 1 - k) := by
    have hmem : b * r ∈ maximalIdeal A ^ (n + 1) • (⊤ : Submodule A A) ⊓ Ideal.span {b} :=
      ⟨by simpa using hr, Ideal.mem_span_singleton'.mpr ⟨r, mul_comm _ _⟩⟩
    rw [hk (n + 1) (by omega)] at hmem
    have hle : maximalIdeal A ^ (n + 1 - k) • (maximalIdeal A ^ k • (⊤ : Submodule A A) ⊓
        Ideal.span {b}) ≤ Ideal.span {b} * maximalIdeal A ^ (n + 1 - k) :=
      calc _ ≤ maximalIdeal A ^ (n + 1 - k) • Ideal.span {b} :=
            Submodule.smul_mono le_rfl inf_le_right
        _ = _ := by rw [smul_eq_mul, mul_comm]
    obtain ⟨z, hz, hbz⟩ := Ideal.mem_span_singleton_mul.mp (hle hmem)
    have hzr : z = r := hreg (show b • z = b • r by simpa [smul_eq_mul] using hbz)
    rwa [hzr] at hz
  -- raise the exponent from `n + 1 - k` to `n`
  have key : ∀ t j : ℕ, j + t = n → N ≤ j → r ∈ maximalIdeal A ^ j → r ∈ maximalIdeal A ^ n := by
    intro t
    induction t with
    | zero => intro j hj _ hr'; rwa [← hj]
    | succ t ih =>
      intro j hj hNj hr'
      exact ih (j + 1) (by omega) (by omega)
        (hN j hNj r hr' (Ideal.pow_le_pow_right (by omega) hr))
  exact key k (n - k) (by omega) (by omega) (Ideal.pow_le_pow_right (by omega) h1)

/-- **Colength of `bA + 𝔪ⁿ⁺¹`.** If `(𝔪ⁿ⁺¹ : b) = 𝔪ⁿ` for some `b ∈ 𝔪`, then
`ℓ(A/(bA + 𝔪ⁿ⁺¹)) + ℓ(A/𝔪ⁿ) = ℓ(A/𝔪ⁿ⁺¹)`, from the exact sequence
`0 → A/𝔪ⁿ → A/𝔪ⁿ⁺¹ → A/(bA + 𝔪ⁿ⁺¹) → 0` whose first map is multiplication by `b`. -/
theorem length_quotient_span_singleton_sup_add_length_quotient_pow {b : A}
    (hb : b ∈ maximalIdeal A) {n : ℕ}
    (h : ∀ r : A, b * r ∈ maximalIdeal A ^ (n + 1) → r ∈ maximalIdeal A ^ n) :
    Module.length A (A ⧸ (Ideal.span {b} ⊔ maximalIdeal A ^ (n + 1))) +
        Module.length A (A ⧸ maximalIdeal A ^ n) =
      Module.length A (A ⧸ maximalIdeal A ^ (n + 1)) := by
  let f : A ⧸ maximalIdeal A ^ n →ₗ[A] A ⧸ maximalIdeal A ^ (n + 1) :=
    Submodule.mapQ _ _ (LinearMap.mulLeft A b) fun r hr => by
      show b * r ∈ maximalIdeal A ^ (n + 1)
      rw [pow_succ']
      exact Ideal.mul_mem_mul hb hr
  let g : A ⧸ maximalIdeal A ^ (n + 1) →ₗ[A] A ⧸ (Ideal.span {b} ⊔ maximalIdeal A ^ (n + 1)) :=
    Submodule.factor le_sup_right
  have hf : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro x hx
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rw [LinearMap.mem_ker] at hx
    change Submodule.Quotient.mk (b * r) = 0 at hx
    rw [Submodule.Quotient.mk_eq_zero] at hx
    rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
    exact h r hx
  have hfg : Function.Exact f g := by
    intro y
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rw [factor_span_singleton_sup_mk_eq_zero_iff]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨Submodule.Quotient.mk c, hc⟩
    · rintro ⟨x, hx⟩
      obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      exact ⟨c, hx⟩
  rw [Module.length_eq_add_of_exact f g hf (Submodule.factor_surjective _) hfg, add_comm]

/-- **Killing one element drops the colength by at most one, at a socle element.** If `s ∈ A`
satisfies `𝔪 s ⊆ J`, then `ℓ(A/J) ≤ ℓ(A/(sA + J)) + 1`: the kernel of `A/J → A/(sA + J)` is the
image of `A/𝔪` under multiplication by `s`. -/
theorem length_quotient_le_length_quotient_span_singleton_sup_add_one {s : A} {J : Ideal A}
    (hs : ∀ c ∈ maximalIdeal A, c * s ∈ J) :
    Module.length A (A ⧸ J) ≤ Module.length A (A ⧸ (Ideal.span {s} ⊔ J)) + 1 := by
  let f : A ⧸ maximalIdeal A →ₗ[A] A ⧸ J :=
    Submodule.mapQ _ _ (LinearMap.mulRight A s) fun c hc => hs c hc
  let g : A ⧸ J →ₗ[A] A ⧸ (Ideal.span {s} ⊔ J) := Submodule.factor le_sup_right
  have hfg : Function.Exact (LinearMap.range f).subtype g := by
    intro y
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rw [factor_span_singleton_sup_mk_eq_zero_iff]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨⟨_, Submodule.Quotient.mk c, rfl⟩, by rw [← hc, mul_comm]; rfl⟩
    · rintro ⟨⟨z, x, rfl⟩, hx⟩
      obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      exact ⟨c, by rw [mul_comm]; exact hx⟩
  rw [Module.length_eq_add_of_exact _ g (Submodule.injective_subtype _)
    (Submodule.factor_surjective _) hfg, add_comm]
  gcongr
  have hsimple : IsSimpleModule A (A ⧸ maximalIdeal A) :=
    (isSimpleModule_iff_isCoatom).2 (Ideal.isMaximal_def.mp (maximalIdeal.isMaximal A))
  calc Module.length A (LinearMap.range f) ≤ Module.length A (A ⧸ maximalIdeal A) :=
        Module.length_le_of_surjective _ f.surjective_rangeRestrict
    _ = 1 := Module.length_eq_one A _

end IsLocalRing
