namespace Stacks.LocalRing.EmbeddingDimension



open CategoryTheory IsLocalRing Pointwise

/-- A module has projective dimension at most `0` iff it is projective. -/
private theorem hasProjectiveDimensionLE_zero_iff_projective {R : Type u} [Ring R] {M : Type u}
    [AddCommGroup M] [Module R M] :
    HasProjectiveDimensionLE (ModuleCat.of R M) 0 ↔ Module.Projective R M := by
  rw [← projective_iff_hasProjectiveDimensionLE_zero, ← IsProjective.iff_projective]

/-- A projective module has projective dimension at most `n`, for every `n`. -/
private theorem hasProjectiveDimensionLE_of_projective {R : Type u} [Ring R] {M : Type u}
    [AddCommGroup M] [Module R M] [Module.Projective R M] (n : ℕ) :
    HasProjectiveDimensionLE (ModuleCat.of R M) n := by
  have : HasProjectiveDimensionLE (ModuleCat.of R M) 0 :=
    hasProjectiveDimensionLE_zero_iff_projective.mpr ‹_›
  infer_instance

/-- The kernel of a surjection from a projective module onto a module of projective dimension at
most `n + 1` has projective dimension at most `n`. -/
private theorem hasProjectiveDimensionLE_ker_of_projective {R : Type u} [Ring R] {F M : Type u}
    [AddCommGroup F] [Module R F] [Module.Projective R F] [AddCommGroup M] [Module R M]
    {f : F →ₗ[R] M} (hf : Function.Surjective f) (n : ℕ)
    (h : HasProjectiveDimensionLE (ModuleCat.of R M) (n + 1)) :
    HasProjectiveDimensionLE (ModuleCat.of R (LinearMap.ker f)) n :=
  (LinearMap.shortExact_shortComplexKer hf).hasProjectiveDimensionLT_X₁ (n + 1)
    (hasProjectiveDimensionLE_of_projective n) h

/-- A free ideal of a commutative ring is principal: two distinct members of a basis `b` would
satisfy the relation `b j • b i - b i • b j = 0`, whose coefficients are not both zero. (Over the
zero ring the only ideal is `0`, and the argument is vacuous.) -/
private theorem isPrincipal_of_free {R : Type*} [CommRing R] (I : Ideal R)
    [Module.Free R I] : I.IsPrincipal := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · have := hR
    exact ⟨0, by
      rw [Submodule.span_zero_singleton, ← le_bot_iff]
      exact fun x _ => (Submodule.mem_bot R).mpr (Subsingleton.elim x 0)⟩
  have := hR
  set ι := Module.Free.ChooseBasisIndex R I
  set b := Module.Free.chooseBasis R I
  have hsub : ∀ i j : ι, i = j := by
    intro i j
    by_contra hij
    have key : ((b j : R)) • b i - ((b i : R)) • b j = 0 := by
      apply Subtype.ext
      push_cast
      ring
    exact b.ne_zero j (by simpa [hij] using congrArg (fun x => b.repr x i) key)
  rcases isEmpty_or_nonempty ι with he | hne
  · refine ⟨0, ?_⟩
    rw [Submodule.span_zero_singleton, ← le_bot_iff]
    intro x hx
    have hz : (⟨x, hx⟩ : I) = 0 := b.ext_elem isEmptyElim
    simpa [Submodule.mem_bot] using congrArg Subtype.val hz
  · obtain ⟨i⟩ := hne
    have : Subsingleton ι := ⟨hsub⟩
    have : Unique ι := uniqueOfSubsingleton i
    refine ⟨(b i : R), le_antisymm ?_ ?_⟩
    · intro x hx
      refine Submodule.mem_span_singleton.mpr ⟨b.repr ⟨x, hx⟩ i, ?_⟩
      have hsum := congrArg Subtype.val (b.sum_repr ⟨x, hx⟩)
      rw [Fintype.sum_unique, hsub default i] at hsum
      simpa using hsum
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      exact (b i).2

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

omit [IsNoetherianRing R] in
/-- A local ring whose residue field is projective as a module over it is a field: the residue
field is then finite free, so its annihilator is zero, while the maximal ideal annihilates it. -/
private theorem isField_of_projective_residueField
    (h : Module.Projective R (ResidueField R)) : IsField R := by
  have hfree : Module.Free R (ResidueField R) := by
    have := h
    exact Module.free_of_flat_of_isLocalRing
  have hann : Module.annihilator R (ResidueField R) = ⊥ :=
    Module.annihilator_eq_bot.mpr inferInstance
  rw [isField_iff_maximalIdeal_eq, ← le_bot_iff, ← hann]
  intro x hx
  rw [Module.mem_annihilator]
  intro m
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective (I := maximalIdeal R) m
  exact (Submodule.Quotient.mk_eq_zero _).mpr (Ideal.mul_mem_right _ _ hx)

/-- If the residue field of a Noetherian local ring `R` has projective dimension at most `1`, then
the maximal ideal of `R` is principal: the exact sequence `0 → 𝔪 → R → κ → 0` makes `𝔪`
projective, hence finite free, hence principal. -/
private theorem isPrincipal_maximalIdeal_of_hasProjectiveDimensionLE_one
    (h : HasProjectiveDimensionLE (ModuleCat.of R (ResidueField R)) 1) :
    (maximalIdeal R).IsPrincipal := by
  have hker : Module.Projective R (LinearMap.ker (Submodule.mkQ (maximalIdeal R))) :=
    hasProjectiveDimensionLE_zero_iff_projective.mp
      (hasProjectiveDimensionLE_ker_of_projective (Submodule.mkQ_surjective _) 0 h)
  have : Module.Projective R (maximalIdeal R) :=
    hker.of_equiv (LinearEquiv.ofEq _ _ (Submodule.ker_mkQ _))
  have : Module.Free R (maximalIdeal R) := Module.free_of_flat_of_isLocalRing
  exact isPrincipal_of_free _


/-- **Change of rings along `R → R/xR`.** Let `x` be a nonzerodivisor of `R` which is also a
nonzerodivisor on a finite `R`-module `M`. Then the projective dimension of `M/xM` over `R/xR` is
at most the projective dimension of `M` over `R`.

The induction is on the projective dimension: a finite free cover `0 → N → F → M → 0` has
`N ∩ xF = xN`, because `xf ∈ N` gives `x · (f mod N) = 0` in `M` and so `f ∈ N`; hence
`0 → N/xN → F/xF → M/xM → 0` is exact over `R/xR` with `F/xF` finite free. -/
private theorem hasProjectiveDimensionLE_quotSMulTop {x : R} (hx : IsSMulRegular R x) :
    ∀ (n : ℕ) (M : Type u) (_ : AddCommGroup M) (_ : Module R M) (_ : Module.Finite R M),
      IsSMulRegular M x → HasProjectiveDimensionLE (ModuleCat.of R M) n →
        HasProjectiveDimensionLE
          (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R)) (QuotSMulTop x M)) n := by
  have hxreg : IsRegular x := isLeftRegular_iff_isRegular.mp hx
  intro n
  induction n with
  | zero =>
    intro M _ _ _ _ h
    have := hasProjectiveDimensionLE_zero_iff_projective.mp h
    have : Module.Free R M := Module.free_of_flat_of_isLocalRing
    exact hasProjectiveDimensionLE_zero_iff_projective.mpr Module.Projective.of_free
  | succ n ih =>
    intro M _ _ _ hxM h
    obtain ⟨F, _, _, _, _, π, hπ⟩ := Module.exists_finite_presentation R M
    have hxF : IsSMulRegular F x := Module.Flat.isSMulRegular_of_isRegular hxreg
    have hxN : IsSMulRegular ↥(LinearMap.ker π) x := IsSMulRegular.submodule _ x hxF
    have hN := hasProjectiveDimensionLE_ker_of_projective hπ n h
    have hNq := ih ↥(LinearMap.ker π) inferInstance inferInstance inferInstance hxN hN
    have hsurj : Function.Surjective (algebraMap R (R ⧸ Ideal.span ({x} : Set R))) :=
      Ideal.Quotient.mk_surjective
    let f' : QuotSMulTop x ↥(LinearMap.ker π) →ₗ[R ⧸ Ideal.span ({x} : Set R)] QuotSMulTop x F :=
      (QuotSMulTop.map x (LinearMap.ker π).subtype).extendScalarsOfSurjective hsurj
    let g' : QuotSMulTop x F →ₗ[R ⧸ Ideal.span ({x} : Set R)] QuotSMulTop x M :=
      (QuotSMulTop.map x π).extendScalarsOfSurjective hsurj
    have hex : Function.Exact f' g' :=
      QuotSMulTop.map_exact x (LinearMap.exact_subtype_ker_map π) hπ
    have heq0 : g'.comp f' = 0 := LinearMap.ext fun a => hex.apply_apply_eq_zero a
    have hinj : Function.Injective f' := by
      change Function.Injective (QuotSMulTop.map x (LinearMap.ker π).subtype)
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro a ha
      obtain ⟨a', rfl⟩ := Submodule.Quotient.mk_surjective _ a
      rw [QuotSMulTop.map_apply_mk] at ha
      rw [Submodule.Quotient.mk_eq_zero] at ha ⊢
      obtain ⟨f, -, hf⟩ := (Submodule.mem_smul_pointwise_iff_exists _ x _).mp ha
      have h0 : x • π f = x • (0 : M) := by
        rw [smul_zero, ← map_smul, hf]; exact a'.2
      exact (Submodule.mem_smul_pointwise_iff_exists _ x _).mpr
        ⟨⟨f, hxM h0⟩, trivial, Subtype.ext hf⟩
    have hsur : Function.Surjective g' := QuotSMulTop.map_surjective x hπ
    have hS' : (ModuleCat.shortComplexOfCompEqZero f' g' heq0).ShortExact :=
      { exact := ModuleCat.shortComplex_exact _ hex
        mono_f := (ModuleCat.mono_iff_injective _).mpr hinj
        epi_g := (ModuleCat.epi_iff_surjective _).mpr hsur }
    have : Module.Projective (R ⧸ Ideal.span ({x} : Set R)) (QuotSMulTop x F) :=
      Module.Projective.of_free
    exact hS'.hasProjectiveDimensionLT_X₃ (n + 1) hNq (hasProjectiveDimensionLE_of_projective _)

omit [IsNoetherianRing R] in
/-- **A minimal free cover.** Every finite module over a local ring is the image of a finite free
module `Rⁿ` under a map every element of whose kernel has all coordinates in the maximal ideal;
equivalently, `n` is the minimal number of generators of `M`.

The induction is on the size of a generating family: if some element `a` of the kernel of the map
`Rᴺ⁺¹ → M` attached to a family `g` has a unit coordinate `a i`, then `g i` lies in the span of
the remaining `g j`, so the family with `g i` deleted still generates. -/
@[sga "6 I 1.3" "partial"]
private theorem exists_surjective_forall_mem_maximalIdeal_of_mem_ker
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∃ (n : ℕ) (f : (Fin n → R) →ₗ[R] M), Function.Surjective f ∧
      ∀ a ∈ LinearMap.ker f, ∀ i, a i ∈ maximalIdeal R := by
  suffices H : ∀ (N : ℕ) (g : Fin N → M), Submodule.span R (Set.range g) = ⊤ →
      ∃ (n : ℕ) (f : (Fin n → R) →ₗ[R] M), Function.Surjective f ∧
        ∀ a ∈ LinearMap.ker f, ∀ i, a i ∈ maximalIdeal R by
    obtain ⟨N, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := M)
    exact H N g hg
  intro N
  induction N with
  | zero =>
    intro g hg
    refine ⟨0, Fintype.linearCombination R g, ?_, fun a _ i => absurd i.2 (by omega)⟩
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hg]
  | succ N ih =>
    intro g hg
    by_cases hker : ∀ a ∈ LinearMap.ker (Fintype.linearCombination R g), ∀ i, a i ∈ maximalIdeal R
    · refine ⟨N + 1, Fintype.linearCombination R g, ?_, hker⟩
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hg]
    · rw [not_forall] at hker
      obtain ⟨a, hker⟩ := hker
      rw [not_imp, not_forall] at hker
      obtain ⟨ha, i, hai⟩ := hker
      have hu : IsUnit (a i) := by
        by_contra hcon
        exact hai ((mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hcon))
      obtain ⟨v, hv⟩ := isUnit_iff_exists_inv'.mp hu
      refine ih (g ∘ i.succAbove) (top_le_iff.mp ?_)
      rw [← hg, Submodule.span_le, Set.range_subset_iff]
      intro j
      change g j ∈ Submodule.span R (Set.range (g ∘ i.succAbove))
      by_cases hj : j = i
      · subst hj
        have hsum : a j • g j + ∑ k : Fin N, a (j.succAbove k) • g (j.succAbove k) = 0 := by
          have h2 := LinearMap.mem_ker.mp ha
          rw [Fintype.linearCombination_apply, Fin.sum_univ_succAbove _ j] at h2
          exact h2
        have hmem : a j • g j ∈ Submodule.span R (Set.range (g ∘ j.succAbove)) := by
          rw [eq_neg_of_add_eq_zero_left hsum]
          exact neg_mem (Submodule.sum_mem _ fun k _ =>
            Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩))
        have hgj : g j = v • (a j • g j) := by rw [← mul_smul, hv, one_smul]
        rw [hgj]
        exact Submodule.smul_mem _ _ hmem
      · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hj
        exact Submodule.subset_span ⟨k, rfl⟩

/-- **A finite module of finite projective dimension over a local ring of depth zero is free.**
Here "depth zero" is spelled by hand: `y ≠ 0` is annihilated by the maximal ideal.

The induction is on the projective dimension. A minimal free cover `0 → N → Rᵐ → M → 0` gives
`pd N < pd M`, so `N` is free by induction, and every element of `N` has all coordinates in `𝔪`
and is therefore killed by `y`; a nonzero free module has a basis vector, which `y` does not kill.
So `N = 0` and `M ≅ Rᵐ`. -/
private theorem free_of_hasProjectiveDimensionLE_of_mul_eq_zero
    {y : R} (hy : y ≠ 0) (hann : ∀ c ∈ maximalIdeal R, c * y = 0) :
    ∀ (n : ℕ) (M : Type u) (_ : AddCommGroup M) (_ : Module R M) (_ : Module.Finite R M),
      HasProjectiveDimensionLE (ModuleCat.of R M) n → Module.Free R M := by
  intro n
  induction n with
  | zero =>
    intro M _ _ _ h
    have := hasProjectiveDimensionLE_zero_iff_projective.mp h
    exact Module.free_of_flat_of_isLocalRing
  | succ n ih =>
    intro M _ _ _ h
    obtain ⟨m, f, hf, hker⟩ := exists_surjective_forall_mem_maximalIdeal_of_mem_ker (R := R) M
    have hNfree : Module.Free R ↥(LinearMap.ker f) :=
      ih ↥(LinearMap.ker f) inferInstance inferInstance inferInstance
        (hasProjectiveDimensionLE_ker_of_projective hf n h)
    have hbot : LinearMap.ker f = ⊥ := by
      by_contra hne
      have hnt : Nontrivial ↥(LinearMap.ker f) := Submodule.nontrivial_iff_ne_bot.mpr hne
      set b := Module.Free.chooseBasis R ↥(LinearMap.ker f) with hb
      obtain ⟨i⟩ := b.index_nonempty
      have hz : y • b i = 0 := by
        refine Subtype.ext (funext fun j => ?_)
        have hmj : ((b i : Fin m → R)) j ∈ maximalIdeal R := hker _ (b i).2 j
        change y * ((b i : Fin m → R)) j = 0
        rw [mul_comm]
        exact hann _ hmj
      refine hy ?_
      have h2 := congrArg (fun z => b.repr z i) hz
      simpa using h2
    exact Module.Free.of_equiv (LinearEquiv.ofBijective f ⟨LinearMap.ker_eq_bot.mp hbot, hf⟩)

/-- A Noetherian local ring which is not a field and whose residue field has finite projective
dimension has a nonzerodivisor in `𝔪 ∖ 𝔪²`.

Prime avoidance
(`Ideal.subset_iUnion_iff_mem_of_isMaximal_of_finite`, which tolerates one non-prime member `𝔪²`
of the covering family) produces it: were `𝔪` covered by `𝔪²` together with the finitely many
associated primes of `R`, it would be contained in one of them; but `𝔪 = 𝔪²` gives `𝔪 = ⊥` by
Nakayama, while `𝔪 ∈ Ass R` supplies a nonzero `y` with `𝔪 y = 0`, hence by
`free_of_hasProjectiveDimensionLE_of_mul_eq_zero` a free residue field, so that `R` is a field
and `𝔪 = ⊥` again. -/
private theorem exists_isSMulRegular_notMem_sq (n : ℕ) (hm : maximalIdeal R ≠ ⊥)
    (h : HasProjectiveDimensionLE (ModuleCat.of R (ResidueField R)) n) :
    ∃ x ∈ maximalIdeal R, x ∉ maximalIdeal R ^ 2 ∧ IsSMulRegular R x := by
  classical
  set S : Set (Ideal R) := insert (maximalIdeal R ^ 2) (associatedPrimes R R)
  have hsqle : maximalIdeal R ^ 2 ≤ maximalIdeal R := Ideal.pow_le_self (by norm_num)
  have hsqtop : maximalIdeal R ^ 2 ≠ ⊤ := fun hh =>
    (maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (hh ▸ hsqle))
  have hprime : ∀ I ∈ S, I ≠ maximalIdeal R ^ 2 → I ≠ maximalIdeal R ^ 2 → I.IsPrime := by
    rintro I (rfl | hI) hne _
    · exact absurd rfl hne
    · exact hI.isPrime
  have hnotmem : maximalIdeal R ∉ S := by
    rintro (heq | hass)
    · exact hm (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) _
        (IsNoetherian.noetherian _) (by rw [smul_eq_mul, ← pow_two]; exact heq.le)
        (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]))
    · obtain ⟨-, y, hy⟩ := isAssociatedPrime_iff.mp hass
      have hy0 : y ≠ 0 := by
        rintro rfl
        exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr
          (hy ▸ Submodule.mem_colon_singleton.mpr (by simp)))
      have hann : ∀ c ∈ maximalIdeal R, c * y = 0 := by
        intro c hc
        rw [hy, Submodule.mem_colon_singleton] at hc
        simpa [Submodule.mem_bot, smul_eq_mul] using hc
      have : Module.Free R (ResidueField R) :=
        free_of_hasProjectiveDimensionLE_of_mul_eq_zero hy0 hann n (ResidueField R)
          inferInstance inferInstance inferInstance h
      exact hm (isField_iff_maximalIdeal_eq.mp
        (isField_of_projective_residueField Module.Projective.of_free))
  have hnot := (Ideal.subset_iUnion_iff_mem_of_isMaximal_of_finite (M := maximalIdeal R)
    ((associatedPrimes.finite R R).insert _) (maximalIdeal R ^ 2) (maximalIdeal R ^ 2)
    hprime hsqtop hsqtop).not.mpr hnotmem
  rw [Set.not_subset] at hnot
  obtain ⟨x, hxm, hx⟩ := hnot
  simp only [Set.mem_iUnion, exists_prop, not_exists, not_and, Set.mem_insert_iff] at hx
  refine ⟨x, hxm, fun hc => hx _ (Or.inl rfl) hc, isSMulRegular_iff_right_eq_zero_of_smul.mpr ?_⟩
  intro y hy
  by_contra hy0
  have hmemU : x ∈ ⋃ p ∈ associatedPrimes R R, (p : Set R) := by
    rw [biUnion_associatedPrimes_eq_zero_divisors]; exact ⟨y, hy0, hy⟩
  simp only [Set.mem_iUnion, exists_prop] at hmemU
  obtain ⟨p, hp, hxp⟩ := hmemU
  exact hx p (Or.inr hp) hxp

omit [IsNoetherianRing R] in
/-- For `x ∈ 𝔪 ∖ 𝔪²`, the residue field of `R/xR` is a direct summand of `𝔪/x𝔪` as an
`R/xR`-module, so its projective dimension over `R/xR` is at most that of `𝔪/x𝔪`.

The splitting is by hand: `xR/x𝔪` is a copy of `κ` inside `𝔪/x𝔪`, and any `R`-linear
`φ : 𝔪 → κ(R/xR)` kills `x𝔪` automatically, so a `φ` with `φ x = 1` retracts `𝔪/x𝔪` onto it.
Such a `φ` exists because `x ∉ 𝔪²` makes the image of `x` in the cotangent space nonzero, and a
nonzero vector of a vector space is carried to `1` by some functional. -/
private theorem hasProjectiveDimensionLE_residueField_quotient {x : R} (hxm : x ∈ maximalIdeal R)
    (hx2 : x ∉ maximalIdeal R ^ 2)
    [IsLocalRing (R ⧸ Ideal.span ({x} : Set R))] (n : ℕ)
    (h : HasProjectiveDimensionLE (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R))
      (QuotSMulTop x ↥(maximalIdeal R))) n) :
    HasProjectiveDimensionLE (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R))
      (ResidueField (R ⧸ Ideal.span ({x} : Set R)))) n := by
  have hv : (maximalIdeal R).toCotangent ⟨x, hxm⟩ ≠ 0 := by
    rw [Ne, Ideal.toCotangent_eq_zero]; exact hx2
  obtain ⟨ψ, hψ⟩ : ∃ ψ : CotangentSpace R →ₗ[ResidueField R] ResidueField R,
      ψ ((maximalIdeal R).toCotangent ⟨x, hxm⟩) = 1 := by
    obtain ⟨g, hg⟩ := (LinearMap.toSpanSingleton (ResidueField R) (CotangentSpace R)
      ((maximalIdeal R).toCotangent ⟨x, hxm⟩)).exists_leftInverse_of_injective
        (LinearMap.ker_toSpanSingleton _ hv)
    exact ⟨g, by simpa [LinearMap.toSpanSingleton_apply] using LinearMap.congr_fun hg 1⟩
  have := IsLocalRing.maximalIdeal.isMaximal (R ⧸ Ideal.span ({x} : Set R))
  have hcomap : Ideal.comap (Ideal.Quotient.mk (Ideal.span ({x} : Set R)))
      (maximalIdeal (R ⧸ Ideal.span ({x} : Set R))) = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal
      (Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective)
  have hax : (algebraMap R (ResidueField (R ⧸ Ideal.span ({x} : Set R)))) x = 0 := by
    rw [IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span ({x} : Set R))]
    have hz : (algebraMap R (R ⧸ Ideal.span ({x} : Set R))) x = 0 := by
      rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self x
    rw [hz, map_zero]
  have hmem : ∀ a ∈ maximalIdeal R,
      (algebraMap R (ResidueField (R ⧸ Ideal.span ({x} : Set R)))) a = 0 := by
    intro a ha
    rw [IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span ({x} : Set R)),
      Ideal.Quotient.algebraMap_eq]
    exact (residue_eq_zero_iff _).mpr (Ideal.mem_comap.mp (hcomap ▸ ha))
  set e : ResidueField R →ₗ[R] ResidueField (R ⧸ Ideal.span ({x} : Set R)) :=
    Submodule.liftQ (maximalIdeal R) (Algebra.linearMap R _)
      (fun a ha => by simpa using hmem a ha) with he
  have he1 : e (1 : ResidueField R) = 1 := by
    rw [he]
    change (Algebra.linearMap R (ResidueField (R ⧸ Ideal.span ({x} : Set R)))) (1 : R) = 1
    simp
  set φ : ↥(maximalIdeal R) →ₗ[R] ResidueField (R ⧸ Ideal.span ({x} : Set R)) :=
    e ∘ₗ ψ.restrictScalars R ∘ₗ (maximalIdeal R).toCotangent
  have hφx : φ ⟨x, hxm⟩ = 1 := by
    have hc : φ ⟨x, hxm⟩ = e (ψ ((maximalIdeal R).toCotangent ⟨x, hxm⟩)) := rfl
    rw [hc, hψ, he1]
  have hφker : (x • ⊤ : Submodule R ↥(maximalIdeal R)) ≤ LinearMap.ker φ := by
    intro m hm
    obtain ⟨m', -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ x _).mp hm
    simp only [LinearMap.mem_ker, map_smul, Algebra.smul_def, hax, zero_mul]
  set r : QuotSMulTop x ↥(maximalIdeal R) →ₗ[R]
      ResidueField (R ⧸ Ideal.span ({x} : Set R)) := Submodule.liftQ _ φ hφker
  set r' := r.extendScalarsOfSurjective (Ideal.Quotient.mk_surjective :
    Function.Surjective (algebraMap R (R ⧸ Ideal.span ({x} : Set R))))
  set abar : QuotSMulTop x ↥(maximalIdeal R) := Submodule.Quotient.mk ⟨x, hxm⟩ with habar
  set i : ResidueField (R ⧸ Ideal.span ({x} : Set R)) →ₗ[R ⧸ Ideal.span ({x} : Set R)]
      QuotSMulTop x ↥(maximalIdeal R) :=
    Submodule.liftQ _ (LinearMap.toSpanSingleton _ _ abar) (by
      intro c hc
      obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective c
      have hc' : c' ∈ maximalIdeal R := by rw [← hcomap]; exact Ideal.mem_comap.mpr hc
      simp only [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
      rw [show (Ideal.Quotient.mk (Ideal.span ({x} : Set R)) c')
          = algebraMap R (R ⧸ Ideal.span ({x} : Set R)) c' from rfl, algebraMap_smul, habar,
        ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      exact (Submodule.mem_smul_pointwise_iff_exists _ x _).mpr
        ⟨⟨c', hc'⟩, trivial, Subtype.ext (mul_comm x c')⟩)
  have hr'abar : r' abar = 1 := hφx
  have hri : ∀ z, r' (i z) = z := by
    intro z
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective
      (I := maximalIdeal (R ⧸ Ideal.span ({x} : Set R))) z
    have h1 : i (Ideal.Quotient.mk (maximalIdeal (R ⧸ Ideal.span ({x} : Set R))) c)
        = c • abar := rfl
    rw [h1, map_smul, hr'abar, Algebra.smul_def, mul_one]
    rfl
  have hRY : HasProjectiveDimensionLT (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R))
      (QuotSMulTop x ↥(maximalIdeal R))) (n + 1) := h
  have hret : Retract (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R))
      (ResidueField (R ⧸ Ideal.span ({x} : Set R))))
      (ModuleCat.of (R ⧸ Ideal.span ({x} : Set R)) (QuotSMulTop x ↥(maximalIdeal R))) :=
    { i := ModuleCat.ofHom i
      r := ModuleCat.ofHom r'
      retract := by
        rw [← ModuleCat.ofHom_comp, show r'.comp i = LinearMap.id from LinearMap.ext hri]
        rfl }
  exact hret.hasProjectiveDimensionLT (n + 1)

/-- **Stacks 00OA in the form the induction takes.** If the residue field of a Noetherian local
ring has projective dimension at most `d`, then its maximal ideal is generated by `d` elements.

The induction is on `d`; the inductive step passes from `R` to `R/xR` for a nonzerodivisor
`x ∈ 𝔪 ∖ 𝔪²`, whose residue field has projective dimension at most `d - 1`. -/
private theorem exists_finset_card_le_span_eq_maximalIdeal :
    ∀ (d : ℕ) (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S],
      HasProjectiveDimensionLE (ModuleCat.of S (ResidueField S)) d →
        ∃ t : Finset S, t.card ≤ d ∧ Ideal.span (t : Set S) = maximalIdeal S := by
  classical
  intro d
  induction d with
  | zero =>
    intro S _ _ _ h
    refine ⟨∅, by simp, ?_⟩
    rw [Finset.coe_empty, Ideal.span_empty]
    exact (isField_iff_maximalIdeal_eq.mp
      (isField_of_projective_residueField (hasProjectiveDimensionLE_zero_iff_projective.mp h))).symm
  | succ d ih =>
    intro S _ _ _ h
    by_cases hm : maximalIdeal S = ⊥
    · exact ⟨∅, by simp, by rw [Finset.coe_empty, Ideal.span_empty, hm]⟩
    obtain ⟨x, hxm, hx2, hx⟩ := exists_isSMulRegular_notMem_sq (R := S) (d + 1) hm h
    have hxle : Ideal.span ({x} : Set S) ≤ maximalIdeal S :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxm)
    have hne : Ideal.span ({x} : Set S) ≠ ⊤ := fun hh =>
      (maximalIdeal.isMaximal S).ne_top (top_le_iff.mp (hh ▸ hxle))
    have : Nontrivial (S ⧸ Ideal.span ({x} : Set S)) := by
      refine ⟨⟨1, 0, fun hh => hne ((Ideal.eq_top_iff_one _).mpr ?_)⟩⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_one]
      exact hh
    have : IsLocalRing (S ⧸ Ideal.span ({x} : Set S)) :=
      IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
    -- `pd_S 𝔪 ≤ d`, from `0 → 𝔪 → S → κ → 0`
    have : HasProjectiveDimensionLE
        (ModuleCat.of S ↥(LinearMap.ker (Submodule.mkQ (maximalIdeal S)))) d :=
      hasProjectiveDimensionLE_ker_of_projective (Submodule.mkQ_surjective (maximalIdeal S)) d h
    have hmpd : HasProjectiveDimensionLE (ModuleCat.of S ↥(maximalIdeal S)) d :=
      ModuleCat.hasProjectiveDimensionLE_of_linearEquiv
        (M := ModuleCat.of S ↥(LinearMap.ker (Submodule.mkQ (maximalIdeal S))))
        (LinearEquiv.ofEq _ _ (Submodule.ker_mkQ (maximalIdeal S))) d
    have hxmreg : IsSMulRegular ↥(maximalIdeal S) x := fun a b hab =>
      Subtype.ext (hx (by simpa using congrArg Subtype.val hab))
    have h1 := hasProjectiveDimensionLE_quotSMulTop (R := S) hx d ↥(maximalIdeal S)
      inferInstance inferInstance inferInstance hxmreg hmpd
    have h2 := hasProjectiveDimensionLE_residueField_quotient (R := S) hxm hx2 d h1
    obtain ⟨s, hcard, hspan⟩ := ih (S ⧸ Ideal.span ({x} : Set S)) h2
    -- lift the generators of `𝔪/xS` along `S → S/xS` and adjoin `x`
    have hsurj : Function.Surjective (Ideal.Quotient.mk (Ideal.span ({x} : Set S))) :=
      Ideal.Quotient.mk_surjective
    refine ⟨insert x (s.image (Function.surjInv hsurj)), ?_, ?_⟩
    · exact (Finset.card_insert_le _ _).trans
        (Nat.add_le_add_right (Finset.card_image_le.trans hcard) 1)
    · have himg : (Ideal.Quotient.mk (Ideal.span ({x} : Set S))) ''
          ((s.image (Function.surjInv hsurj) : Finset S) : Set S) =
          (s : Set (S ⧸ Ideal.span ({x} : Set S))) := by
        rw [Finset.coe_image, Set.image_image]
        simp [Function.surjInv_eq hsurj]
      have := IsLocalRing.maximalIdeal.isMaximal (S ⧸ Ideal.span ({x} : Set S))
      calc Ideal.span ((insert x (s.image (Function.surjInv hsurj)) : Finset S) : Set S)
          = Ideal.span ({x} : Set S) ⊔
              Ideal.span ((s.image (Function.surjInv hsurj) : Finset S) : Set S) := by
            rw [Finset.coe_insert, Ideal.span_insert]
        _ = Ideal.comap (Ideal.Quotient.mk (Ideal.span ({x} : Set S)))
              (Ideal.map (Ideal.Quotient.mk (Ideal.span ({x} : Set S)))
                (Ideal.span ((s.image (Function.surjInv hsurj) : Finset S) : Set S))) :=
            (Ideal.comap_map_quotientMk _ _).symm
        _ = maximalIdeal S := by
            rw [Ideal.map_span, himg, hspan]
            exact IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective _ hsurj)

/-- **The bound of Stacks 00OA for a resolution of length at least two.** If the residue field of
a Noetherian local ring `R` has a projective resolution of length `d + 2`, then `𝔪/𝔪²` has
dimension at most `d + 2` over the residue field: `𝔪` is generated by `d + 2` elements. -/
private theorem finrank_cotangentSpace_le_of_hasProjectiveDimensionLE_add_two (d : ℕ)
    (h : HasProjectiveDimensionLE (ModuleCat.of R (ResidueField R)) (d + 2)) :
    Module.finrank (ResidueField R) (CotangentSpace R) ≤ d + 2 := by
  obtain ⟨t, hcard, hspan⟩ := exists_finset_card_le_span_eq_maximalIdeal (d + 2) R h
  rw [← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, ← hspan]
  calc (Ideal.span (t : Set R)).spanFinrank ≤ (t : Set R).ncard :=
        Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)
    _ = t.card := by simp
    _ ≤ d + 2 := hcard

/-- If the residue field of a Noetherian local ring `R` has projective dimension at most `d`,
then `dim_κ 𝔪/𝔪² ≤ d`. -/
private theorem finrank_cotangentSpace_le_of_hasProjectiveDimensionLE (d : ℕ)
    (h : HasProjectiveDimensionLE (ModuleCat.of R (ResidueField R)) d) :
    Module.finrank (ResidueField R) (CotangentSpace R) ≤ d := by
  match d with
  | 0 =>
    exact le_of_eq (IsLocalRing.finrank_cotangentSpace_eq_zero_iff.mpr
      (isField_of_projective_residueField (hasProjectiveDimensionLE_zero_iff_projective.mp h)))
  | 1 =>
    exact IsLocalRing.finrank_cotangentSpace_le_one_iff.mpr
      (isPrincipal_maximalIdeal_of_hasProjectiveDimensionLE_one h)
  | d + 2 => exact finrank_cotangentSpace_le_of_hasProjectiveDimensionLE_add_two d h

/-- **Stacks 00OA.** The embedding dimension `dim_κ 𝔪/𝔪²` of a Noetherian local ring is at most
the projective dimension of its residue field `κ`. -/
public theorem solution :
    (Module.finrank (ResidueField R) (CotangentSpace R) : WithBot ℕ∞) ≤
      projectiveDimension (ModuleCat.of R (ResidueField R)) := by
  rw [projectiveDimension_ge_iff]
  have key : ∀ n : ℕ, Module.finrank (ResidueField R) (CotangentSpace R) = n →
      ¬ HasProjectiveDimensionLT (ModuleCat.of R (ResidueField R)) n := by
    intro n hn hlt
    match n with
    | 0 =>
      have h0 := (hasProjectiveDimensionLT_zero_iff_isZero
        (ModuleCat.of R (ResidueField R))).mp hlt
      rw [ModuleCat.isZero_iff_subsingleton] at h0
      exact (not_subsingleton (ResidueField R)) h0
    | d + 1 =>
      have := finrank_cotangentSpace_le_of_hasProjectiveDimensionLE (R := R) d hlt
      omega
  exact key _ rfl

end Stacks.LocalRing.EmbeddingDimension

end

/-!
# The projective dimension of the residue field bounds the embedding dimension

Let `(R, 𝔪, κ)` be a Noetherian local ring. Then the projective dimension of `κ` as an
`R`-module is at least the embedding dimension `dim_κ 𝔪/𝔪²` of `R`:
`dim_κ 𝔪/𝔪² ≤ pd_R κ`.

The source's proof is by the Koszul complex. Pick `x₁, …, x_n ∈ 𝔪` whose images form a
`κ`-basis of `𝔪/𝔪²`, so `n = dim_κ 𝔪/𝔪²`, and let `K_•(R, x_•)` be the Koszul complex on them,
whose cokernel in degree `0` is `κ` (Lemma 00DV (8)). If `κ` had projective dimension `d`, then
by Lemma 0CXF it admits a resolution `F_• → κ` of length `d` by finite free modules, and by
Lemma 00MT one may assume `Im(F_i → F_{i-1}) ⊆ 𝔪 F_{i-1}`, since splitting off a trivial summand
only shortens the resolution. Lifting the identity of `κ` (Lemma 00LS) gives
`α : K_•(R, x_•) → F_•`, and one shows by induction on `i` that `α_i ⊗ κ : ∧^i κ^n → F_i ⊗ κ`
is injective, the inductive step reducing to the injectivity of
`∧^i κ^n → ∧^{i-1} κ^n ⊗_κ 𝔪/𝔪²`. In particular `F_n ≠ 0`, so `d ≥ n`.

Together with Lemma 00OB (`pd_R κ ≤ dim R` when finite) this is what makes a Noetherian local
ring of finite global dimension regular, Proposition 00OC.

## Main results

* `IsLocalRing.finrank_cotangentSpace_le_projectiveDimension_residueField`: the embedding
  dimension of a Noetherian local ring is at most the projective dimension of its residue field.

## Implementation notes

The source's `dim_κ 𝔪/𝔪²` is `Module.finrank (ResidueField R) (CotangentSpace R)`, the dimension
of the cotangent space `IsLocalRing.CotangentSpace R = (maximalIdeal R).Cotangent`, which is
Mathlib's spelling of `𝔪/𝔪²` together with its `ResidueField R`-module structure. By
`IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace` it equals
`(maximalIdeal R).spanFinrank`, the minimal number of generators of `𝔪`, so the reader who wants
the conclusion in the form used by `ringKrullDim_le_spanFinrank_maximalIdeal` rewrites with that
lemma.

The projective dimension is `CategoryTheory.projectiveDimension` of `κ` viewed as an object of
`ModuleCat R`; it takes values in `WithBot ℕ∞`, with `⊥` reserved for the zero object and `⊤`
meaning "infinite", so the inequality is an inequality of extended naturals and carries no
finiteness assumption on `pd_R κ`: the case `pd_R κ = ⊤` is the (true, vacuous) statement that
nothing is claimed, and `pd_R κ = ⊥` cannot occur, as `κ` is a field, hence nonzero.

`κ` lives in the universe of `R`, so the statement is read in `ModuleCat.{u} R` for `R : Type u`,
as in the rest of the `IsLocalRing` API. Nothing of substance is lost: `κ` is a finite `R`-module,
and by `ModuleCat.hasProjectiveDimensionLT_of_forall_finite` the projective dimension of a finite
module is already tested by the finite modules, which all live in that universe.

`IsNoetherianRing R` is the hypothesis under which `finrank` is the honest dimension: it supplies
`FiniteDimensional (ResidueField R) (CotangentSpace R)`. It is not decoration, but note that the
inequality is vacuous rather than false without it, since `Module.finrank` is `0` on an
infinite-dimensional space; the statement to generalize to non-Noetherian local rings would be
the one with `Module.rank`, which the source does not make.

Faithfulness. (1) No hypothesis is dead: `IsLocalRing R` provides both `𝔪` and `κ`, and
`IsNoetherianRing R` is what gives `𝔪/𝔪²` a finite dimension for `finrank` to compute — it is
used by the source's proof through the existence of a finite free resolution of `κ` (Lemma 0CXF).
(2) The scalars are the source's on both sides: `𝔪/𝔪²` is measured over `κ = ResidueField R`, and
the projective dimension is that of `κ` as an object of `ModuleCat R`, i.e. over `R`.
(3) No canonical map is at issue; the two invariants are pinned by name, `κ` being the residue
field `R ⧸ 𝔪` with its canonical `R`-module structure rather than an abstract field with a map
from `R`. (4) The instantiation is not degenerate: for a discrete valuation ring both sides are
`1` (a uniformizer is a basis of `𝔪/𝔪²`, and `0 → R → R → κ → 0` is a projective resolution), and
for `R = k[x,y]` localized at `(x, y)` both sides are `2`, so the inequality is an equality with
content and neither side is constantly `0` or `⊤`.

