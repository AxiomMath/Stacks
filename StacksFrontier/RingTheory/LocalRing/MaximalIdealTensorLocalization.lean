module

public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# The maximal ideal of a local ring of a tensor product

Let `R → A` and `R → B` be ring maps with `A` and `B` local, and let `C` be a local ring which is
a localization of `A ⊗_R B` such that `A → C` and `B → C` are local. If every residue class of
`A` comes from `R`, then the maximal ideal of `C` is generated by the maximal ideals of `A` and
`B`:

`𝔪_C = 𝔪_A C + 𝔪_B C`.

Geometrically: at a point of a fibre product `X ×_S Y` lying over a point of `X` whose residue
field is that of its image in `S`, the maximal ideal of the local ring is generated by those of
the two factors. For `Y = Spec k'` over `S = Spec k` and a `k`-rational point of `X` this says
that the maximal ideal of `X` generates that of `X_{k'}`, which is what makes the order of
vanishing invariant under extension of an algebraically closed base field.

## Main results

* `Stacks.maximalIdeal_eq_map_sup_map_of_isLocalization_tensorProduct`
-/

@[expose] public section

open TensorProduct IsLocalRing

namespace Stacks

variable {R A B C : Type*} [CommRing R] [CommRing A] [CommRing B] [CommRing C] [Algebra R A]
  [Algebra R B] [IsLocalRing A] [IsLocalRing B] [IsLocalRing C]

omit [IsLocalRing B] in
/-- **Every element of `A ⊗_R B` is congruent to some `1 ⊗ b` modulo `𝔪_A (A ⊗_R B)`**, as soon
as every residue class of `A` comes from `R`. -/
theorem exists_sub_one_tmul_mem_map_maximalIdeal
    (hres : Function.Surjective ((residue A).comp (algebraMap R A)))
    (t : A ⊗[R] B) :
    ∃ b : B, t - 1 ⊗ₜ b ∈ (maximalIdeal A).map Algebra.TensorProduct.includeLeftRingHom := by
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    obtain ⟨r, hr⟩ := hres (residue A a)
    refine ⟨r • b, ?_⟩
    have hmem : a - algebraMap R A r ∈ maximalIdeal A := by
      rw [← residue_eq_zero_iff, map_sub, sub_eq_zero]
      exact hr.symm
    have h : a ⊗ₜ[R] b - 1 ⊗ₜ (r • b) =
        Algebra.TensorProduct.includeLeftRingHom (a - algebraMap R A r) * (1 ⊗ₜ b) := by
      rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.tmul_mul_tmul,
        mul_one, one_mul, sub_tmul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
    rw [h]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)
  | add t t' ht ht' =>
    obtain ⟨b, hb⟩ := ht
    obtain ⟨b', hb'⟩ := ht'
    refine ⟨b + b', ?_⟩
    rw [tmul_add, add_sub_add_comm]
    exact Ideal.add_mem _ hb hb'

/-- The image of the maximal ideal under `f` lies in the preimage of the maximal ideal of `U`,
when `g ∘ f` is a local homomorphism. -/
private theorem map_maximalIdeal_le_comap_maximalIdeal {S T U : Type*} [CommRing S] [CommRing T]
    [CommRing U] [IsLocalRing S] [IsLocalRing U] (f : S →+* T) (g : T →+* U)
    [IsLocalHom (g.comp f)] : (maximalIdeal S).map f ≤ (maximalIdeal U).comap g := by
  rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap]
  exact (maximalIdeal_comap (g.comp f)).ge

/-- **`𝔪_C = 𝔪_A C + 𝔪_B C`** for a local ring `C` which is a localization of `A ⊗_R B` with local
maps from `A` and `B`, when every residue class of `A` comes from `R`. -/
theorem maximalIdeal_eq_map_sup_map_of_isLocalization_tensorProduct
    (hres : Function.Surjective ((residue A).comp (algebraMap R A)))
    [Algebra (A ⊗[R] B) C] (M : Submonoid (A ⊗[R] B)) [IsLocalization M C]
    [IsLocalHom ((algebraMap (A ⊗[R] B) C).comp Algebra.TensorProduct.includeLeftRingHom)]
    [IsLocalHom ((algebraMap (A ⊗[R] B) C).comp
      (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom)] :
    maximalIdeal C =
      (maximalIdeal A).map
          ((algebraMap (A ⊗[R] B) C).comp Algebra.TensorProduct.includeLeftRingHom) ⊔
        (maximalIdeal B).map ((algebraMap (A ⊗[R] B) C).comp
          (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom) := by
  set I := (maximalIdeal A).map (Algebra.TensorProduct.includeLeftRingHom (R := R) (B := B))
  set J := (maximalIdeal B).map
    (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom
  set P := (maximalIdeal C).comap (algebraMap (A ⊗[R] B) C)
  have hIP : I ≤ P := map_maximalIdeal_le_comap_maximalIdeal _ _
  have hJP : J ≤ P := map_maximalIdeal_le_comap_maximalIdeal _ _
  have hP : P = I ⊔ J := by
    refine le_antisymm (fun t ht => ?_) (sup_le hIP hJP)
    obtain ⟨b, hb⟩ := exists_sub_one_tmul_mem_map_maximalIdeal hres t
    have hbP : (1 : A) ⊗ₜ[R] b ∈ P := by
      have := P.sub_mem ht (hIP hb)
      rwa [sub_sub_cancel] at this
    have hbm : b ∈ maximalIdeal B := by
      by_contra hb'
      have hu : IsUnit ((algebraMap (A ⊗[R] B) C)
          ((Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)) b)) :=
        (((algebraMap (A ⊗[R] B) C).comp
          (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom).isUnit_map
            ((mem_maximalIdeal _).not.mp hb' |> not_not.mp))
      exact (mem_maximalIdeal _).mp hbP hu
    have : t = (t - 1 ⊗ₜ b) + (Algebra.TensorProduct.includeRight (R := R) (A := A) b) :=
      (sub_add_cancel t (1 ⊗ₜ b)).symm
    rw [this]
    exact Ideal.add_mem _ (Ideal.mem_sup_left hb)
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hbm))
  refine ((IsLocalization.map_under M C (maximalIdeal C)).symm.trans
    (congrArg (Ideal.map (algebraMap (A ⊗[R] B) C)) hP)).trans ?_
  rw [Ideal.map_sup, Ideal.map_map, Ideal.map_map]

end Stacks
