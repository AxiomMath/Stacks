module

public import Mathlib.Algebra.Module.SpanRankOperations
public import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# Minimal generators of a maximal ideal chosen inside a prescribed generating set

Let `(B, 𝔪)` be a Noetherian local ring and let `s ⊆ B` be a set generating `𝔪`.  Then `𝔪` is
generated by `(𝔪).spanFinrank` elements **of `s`**: the minimal number of generators can be
realized inside any prescribed generating set.

The point is Nakayama's lemma.  The images of `s` span the cotangent space `𝔪/𝔪²` over the
residue field, a maximal linearly independent subfamily of those images is a basis, so it has
`finrank (𝔪/𝔪²) = (𝔪).spanFinrank` members, and the corresponding elements of `s` generate `𝔪`
again by `IsLocalRing.CotangentSpace.span_image_eq_top_iff`.

The consequence this file is written for concerns a homomorphism of local rings `φ : A → B` with
`φ(𝔪_A) B = 𝔪_B` — the condition that, for a morphism of schemes locally of finite type, is one
of the two clauses of unramifiedness at a point (**Stacks 02GF**).  There the prescribed
generating set is `φ(𝔪_A)`, and the conclusion is that `𝔪_B` is generated by the images of
`(𝔪_B).spanFinrank` elements of `𝔪_A`.  When `B` is moreover a regular local ring, those images
are therefore a *regular sequence* generating `𝔪_B` (**Stacks 00NQ**), so the quotient of `B` by
them is the residue field of `B`.  That is the local statement behind the étale slicing step of
**Stacks 06N3**: the functions cutting the slice are pulled back from the base, and the local
ring of the fibre of the slice has to come out equal to the residue field, not merely
zero-dimensional.

## Main results

* `IsLocalRing.exists_fn_mem_ofList_eq_maximalIdeal_of_span_eq`: the minimal generating family
  inside a prescribed generating set.
* `IsLocalRing.exists_fn_mem_maximalIdeal_ofList_map_eq_maximalIdeal`: the local-homomorphism
  form, for `φ(𝔪_A) B = 𝔪_B`.
* `IsLocalRing.map_eq_maximalIdeal_of_ofList_quotient_eq_maximalIdeal`: the consumer of such a
  family — a surjection killing it carries the ideal of the quotient onto the maximal ideal.

## Implementation notes

The extraction is run on a *finite* subfamily of `s`, produced first by
`Submodule.mem_span_finite_of_mem_span` applied to each member of a finite generating set of the
Noetherian ideal `𝔪`;  the linear-independence extraction `exists_linearIndependent'` returns an
index type which has to be finite for `Module.finrank_eq_card_basis` to apply, and
`Fin`-indexing the finite subfamily is what makes it so.

Spanning is moved between three places: an ideal of `B`, a submodule of the subtype `↥𝔪`, and a
subspace of the cotangent space.  The first two are identified by
`Submodule.map_injective_of_injective (Submodule.injective_subtype _)`, since the image of `⊤`
under the inclusion `↥𝔪 → B` is `𝔪`;  the last two are
`IsLocalRing.CotangentSpace.span_image_eq_top_iff`.

The length of the extracted family is produced as an existentially bound natural number first
and only then identified with `(𝔪).spanFinrank`, so that the family is never carried across a
cast of its index type.
-/

@[expose] public section

open IsLocalRing

universe u

namespace IsLocalRing

variable {B : Type u} [CommRing B] [IsLocalRing B]

omit [IsLocalRing B] in
/-- The ideal generated by the list of values of a `Fin`-indexed family is the ideal generated by
its range. -/
theorem ofList_ofFn_eq_span_range {r : ℕ} (y : Fin r → B) :
    Ideal.ofList (List.ofFn y) = Ideal.span (Set.range y) := by
  refine congrArg Ideal.span (Set.ext fun x => ?_)
  simp only [Set.mem_setOf_eq, List.mem_ofFn, Set.mem_range]

omit [IsLocalRing B] in
/-- **A finite subfamily of a generating set of a finitely generated ideal already generates
it.**  Each of the finitely many generators is a finite combination of members of the set, and
only finitely many members are involved. -/
theorem exists_finset_subset_span_eq_of_span_eq [IsNoetherianRing B] {I : Ideal B} {s : Set B}
    (hs : Ideal.span s = I) :
    ∃ T : Finset B, (T : Set B) ⊆ s ∧ Ideal.span (T : Set B) = I := by
  classical
  obtain ⟨g, hg⟩ : I.FG := IsNoetherian.noetherian _
  have hsub : ∀ x ∈ g, ∃ t : Finset B, (t : Set B) ⊆ s ∧ x ∈ Ideal.span (t : Set B) := by
    intro x hx
    refine Submodule.mem_span_finite_of_mem_span ?_
    have hxI : x ∈ I := hg ▸ Ideal.subset_span hx
    rw [← hs] at hxI
    exact hxI
  choose t hts htmem using hsub
  have hmem : ∀ x ∈ ((g.attach.biUnion fun y => t y.1 y.2 : Finset B) : Set B), x ∈ s := by
    intro x hx
    obtain ⟨y, -, hy⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    exact hts y.1 y.2 hy
  refine ⟨g.attach.biUnion fun y => t y.1 y.2, hmem, le_antisymm ?_ ?_⟩
  · rw [← hs]
    exact Ideal.span_le.2 fun x hx => Ideal.subset_span (hmem x hx)
  · rw [← hg]
    refine Ideal.span_le.2 fun x hx => ?_
    refine Ideal.span_mono (fun z hz => ?_) (htmem x (Finset.mem_coe.mp hx))
    exact Finset.mem_coe.2
      (Finset.mem_biUnion.2 ⟨⟨x, Finset.mem_coe.mp hx⟩, Finset.mem_attach _ _,
        Finset.mem_coe.mp hz⟩)

/-- A family in `𝔪` has cotangent images spanning `𝔪/𝔪²` iff it generates `𝔪` as an ideal. -/
private theorem span_range_toCotangent_eq_top_iff [IsNoetherianRing B] {ι : Type*}
    (v : ι → ↥(maximalIdeal B)) :
    Submodule.span (ResidueField B) (Set.range ((maximalIdeal B).toCotangent ∘ v)) = ⊤ ↔
      Ideal.span (Set.range fun i => (v i : B)) = maximalIdeal B := by
  rw [Set.range_comp, CotangentSpace.span_image_eq_top_iff,
    ← (Submodule.map_injective_of_injective
      (Submodule.injective_subtype (maximalIdeal B))).eq_iff, Submodule.map_span,
    Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
  rfl

/-- The extraction of `IsLocalRing.exists_fn_mem_ofList_eq_maximalIdeal_of_span_eq`, with the
length of the family existentially bound rather than written as `(𝔪_B).spanFinrank`. -/
private theorem exists_fn_mem_span_range_eq_maximalIdeal_aux [IsNoetherianRing B] {s : Set B}
    (hs : Ideal.span s = maximalIdeal B) :
    ∃ (n : ℕ) (y : Fin n → B), n = (maximalIdeal B).spanFinrank ∧ (∀ i, y i ∈ s) ∧
      Ideal.span (Set.range y) = maximalIdeal B := by
  classical
  -- a finite subfamily of `s` generating `𝔪`, read as a `Fin`-indexed family
  obtain ⟨T, hTs, hTspan⟩ := exists_finset_subset_span_eq_of_span_eq hs
  have hrange : Set.range (fun i => ((T.equivFin.symm i : ↥T) : B)) = (T : Set B) := by
    refine Set.ext fun x => ⟨?_, ?_⟩
    · rintro ⟨i, rfl⟩
      exact (T.equivFin.symm i).2
    · intro hx
      exact ⟨T.equivFin ⟨x, hx⟩,
        congrArg Subtype.val (T.equivFin.symm_apply_apply ⟨x, hx⟩)⟩
  have hmemy : ∀ i, ((T.equivFin.symm i : ↥T) : B) ∈ maximalIdeal B := fun i =>
    hTspan ▸ Ideal.subset_span (T.equivFin.symm i).2
  -- the family inside `↥𝔪`
  let v : Fin T.card → ↥(maximalIdeal B) := fun i => ⟨((T.equivFin.symm i : ↥T) : B), hmemy i⟩
  have hvspan : Submodule.span (ResidueField B) (Set.range ((maximalIdeal B).toCotangent ∘ v))
      = ⊤ := (span_range_toCotangent_eq_top_iff v).mpr
    (by rw [show Set.range (fun i => (v i : B)) = T from hrange, hTspan])
  -- extract a linearly independent subfamily; it is a basis, so it has `finrank` members
  obtain ⟨κ, a, hainj, haspan, hali⟩ :=
    exists_linearIndependent' (K := ResidueField B) (V := CotangentSpace B)
      ((maximalIdeal B).toCotangent ∘ v)
  have hκfin : Finite κ := Finite.of_injective a hainj
  have _ : Fintype κ := Fintype.ofFinite κ
  have hcard : Module.finrank (ResidueField B) (CotangentSpace B) = Fintype.card κ :=
    Module.finrank_eq_card_basis (Module.Basis.mk hali (by rw [haspan, hvspan]))
  -- reindex by `Fin` and read the conclusion back in `B`
  refine ⟨Fintype.card κ, fun i => v (a ((Fintype.equivFin κ).symm i)), ?_,
    fun i => hTs (T.equivFin.symm _).2, ?_⟩
  · rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, hcard]
  · refine (span_range_toCotangent_eq_top_iff (v ∘ a ∘ (Fintype.equivFin κ).symm)).mp ?_
    change Submodule.span _ (Set.range ((((maximalIdeal B).toCotangent ∘ v) ∘ a) ∘
      (Fintype.equivFin κ).symm)) = ⊤
    rw [(Fintype.equivFin κ).symm.surjective.range_comp, haspan, hvspan]

/-- **Nakayama: a minimal generating family of the maximal ideal can be chosen inside any
prescribed generating set.**  If a set `s` generates the maximal ideal of a Noetherian local
ring `B`, then there is a family of `(𝔪_B).spanFinrank` members of `s` generating `𝔪_B`.

The images of `s` in the cotangent space `𝔪_B/𝔪_B²` span it over the residue field; a maximal
linearly independent subfamily of those images is a basis of that space, hence has
`finrank = (𝔪_B).spanFinrank` members, and the corresponding members of `s` generate `𝔪_B` again
by Nakayama. -/
theorem exists_fn_mem_ofList_eq_maximalIdeal_of_span_eq [IsNoetherianRing B] {s : Set B}
    (hs : Ideal.span s = maximalIdeal B) :
    ∃ y : Fin (maximalIdeal B).spanFinrank → B, (∀ i, y i ∈ s) ∧
      Ideal.ofList (List.ofFn y) = maximalIdeal B := by
  obtain ⟨n, y, hn, hys, hyspan⟩ := exists_fn_mem_span_range_eq_maximalIdeal_aux hs
  subst hn
  exact ⟨y, hys, (ofList_ofFn_eq_span_range y).trans hyspan⟩

/-- **The images of `(𝔪_B).spanFinrank` elements of `𝔪_A` generate `𝔪_B`, as soon as
`φ(𝔪_A) B = 𝔪_B`.**  Let `φ : A → B` be a homomorphism of local rings with `B` Noetherian, and
suppose the ideal of `B` generated by the image of `𝔪_A` is the whole of `𝔪_B`.  Then there are
`(𝔪_B).spanFinrank` elements of `𝔪_A` whose images generate `𝔪_B`.

The hypothesis is one of the two clauses of unramifiedness at a point (**Stacks 02GF**); the
conclusion is `IsLocalRing.exists_fn_mem_ofList_eq_maximalIdeal_of_span_eq` at the generating
set `φ(𝔪_A)`, with the chosen members lifted along `φ`. -/
theorem exists_fn_mem_maximalIdeal_ofList_map_eq_maximalIdeal {A : Type*} [CommRing A]
    [IsLocalRing A] [IsNoetherianRing B] (φ : A →+* B)
    (hmap : Ideal.map φ (maximalIdeal A) = maximalIdeal B) :
    ∃ t : Fin (maximalIdeal B).spanFinrank → A, (∀ i, t i ∈ maximalIdeal A) ∧
      Ideal.ofList (List.ofFn fun i => φ (t i)) = maximalIdeal B := by
  classical
  have hs : Ideal.span (φ '' (maximalIdeal A : Set A)) = maximalIdeal B := by
    rw [← hmap, ← Ideal.map_span, Ideal.span_eq]
  obtain ⟨y, hys, hyspan⟩ := exists_fn_mem_ofList_eq_maximalIdeal_of_span_eq hs
  choose t htmem hty using fun i => (Set.mem_image _ _ _).mp (hys i)
  refine ⟨t, htmem, ?_⟩
  rw [show (List.ofFn fun i => φ (t i)) = List.ofFn y from
    congrArg List.ofFn (funext fun i => hty i)]
  exact hyspan

/-- **The extended ideal is the whole maximal ideal downstream, once the slicing functions
generate the maximal ideal of the quotient and die downstream.**  Let `(A, 𝔪_A)` be a local ring,
let `I ⊆ 𝔪_A` be an ideal with `A ⧸ I` local, let `h₁, …, h_r ∈ A` have images generating the
maximal ideal of `A ⧸ I`, and let `ψ : A → C` be a surjective homomorphism onto a local ring
which kills every `h_k`.  Then `ψ(I) C = 𝔪_C`.

The two ideals `(h₁, …, h_r) + I` and `𝔪_A` have the same image in `A ⧸ I`, namely the maximal
ideal, and both contain `I`, so they are equal;  applying `ψ` kills the first summand and
carries `𝔪_A` onto `𝔪_C`.

This is the ideal-theoretic form of the source's computation
`𝒪_{T, v} = 𝒪_{V, v} / (φ(f₁), …, φ(f_d)) = κ(v)` in the étale chart construction of
**Stacks 06N3**: with `A = 𝒪_{V, v}`, `I = 𝔪_u 𝒪_{V, v}` the ideal cutting out the fibre and
`C = 𝒪_{T, v}`, it says that the fibre ideal of the slice is the whole maximal ideal, which is
the first of the two clauses of unramifiedness at a point in **Stacks 02GF**. -/
theorem map_eq_maximalIdeal_of_ofList_quotient_eq_maximalIdeal {A C : Type*} [CommRing A]
    [CommRing C] [IsLocalRing A] [IsLocalRing C] (I : Ideal A) [IsLocalRing (A ⧸ I)]
    (hI : I ≤ maximalIdeal A) {r : ℕ} (h : Fin r → A) (ψ : A →+* C)
    (hψ : Function.Surjective ψ) (hzero : ∀ k, ψ (h k) = 0)
    (hgen : Ideal.ofList (List.ofFn fun k => Ideal.Quotient.mk I (h k))
      = maximalIdeal (A ⧸ I)) :
    Ideal.map ψ I = maximalIdeal C := by
  classical
  -- `(h₁, …, h_r) + I = 𝔪_A`, both sides being the preimage of `𝔪_{A ⧸ I}`
  have hker : Ideal.comap (Ideal.Quotient.mk I) (⊥ : Ideal (A ⧸ I)) = I := by
    rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  have key : Ideal.ofList (List.ofFn h) ⊔ I = maximalIdeal A := by
    have h1 : Ideal.comap (Ideal.Quotient.mk I)
          (Ideal.map (Ideal.Quotient.mk I) (Ideal.ofList (List.ofFn h)))
        = Ideal.ofList (List.ofFn h) ⊔ I := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, hker]
    have h2 : Ideal.comap (Ideal.Quotient.mk I)
          (Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A)) = maximalIdeal A := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, hker,
        sup_eq_left.2 hI]
    rw [← h1, ← h2]
    refine congrArg (Ideal.comap (Ideal.Quotient.mk I)) ?_
    rw [Ideal.map_ofList, List.map_ofFn,
      IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
    exact hgen
  -- the slicing functions die downstream, so only `I` survives
  have hbot : Ideal.map ψ (Ideal.ofList (List.ofFn h)) = ⊥ := by
    rw [Ideal.map_ofList, List.map_ofFn]
    refine Ideal.span_eq_bot.2 fun x hx => ?_
    obtain ⟨k, rfl⟩ := List.mem_ofFn.mp hx
    exact hzero k
  rw [← IsLocalRing.map_maximalIdeal_of_surjective ψ hψ, ← key, Ideal.map_sup, hbot, bot_sup_eq]

end IsLocalRing

end
