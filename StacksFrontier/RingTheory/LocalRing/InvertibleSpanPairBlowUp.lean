module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalChart
public import StacksFrontier.AlgebraicGeometry.Blowup.FiniteOverLocalDimensionOne
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.InvertibleGlobalSections
public import StacksFrontier.RingTheory.LocalRing.PrepareNonZeroDivisors

/-!
# Two nonzerodivisors span an invertible ideal after a finite extension

Let `R` be a Noetherian local ring of Krull dimension one and let `a` and `b` be elements of `R`
with `a` a nonzerodivisor. Blowing up `Spec R` in the ideal `(a, b)` produces a scheme which is
finite over `Spec R`, hence affine; its ring of global sections `S` is a finite `R`-algebra, the
map `R → S` is injective, a power of the maximal ideal annihilates `S / R`, and the ideal of `S`
generated by the images of `a` and `b` — the exceptional divisor — is invertible.

## Main results

* `Stacks.PrepareNonZeroDivisors.exists_pow_mul_eq_zero_and_pow_mul_mem_range_of_isIso_app`: the
  ring-theoretic content of a morphism of affine schemes being an isomorphism over a standard open.
* `Stacks.PrepareNonZeroDivisors.exists_finiteExtension_invertible_span_pair`: the construction.
* `Stacks.PrepareNonZeroDivisors.invertibleSpanPairAfterFiniteExtension` proves
  `Stacks.PrepareNonZeroDivisors.InvertibleSpanPairAfterFiniteExtension`.

## Implementation notes

The blowup is an isomorphism over the standard open `D(a)`, which avoids the centre because `a`
lies in the ideal being blown up. On global sections this says that `R_a → S_a` is an isomorphism,
and both the injectivity of `R → S` and the annihilation of `S / R` by a power of `a` are read off
from that; the annihilating power of the maximal ideal then comes from `a` being a nonzerodivisor
in a one-dimensional ring, where a prime containing it is maximal.

## References

* [Stacks Project, Tag 02Q7](https://stacks.math.columbia.edu/tag/02Q7)
* [Stacks Project, Tag 02OS](https://stacks.math.columbia.edu/tag/02OS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing

universe u

namespace Stacks.PrepareNonZeroDivisors

/-- An element killed in the localization away from `g` is killed by a power of `g`. -/
private theorem exists_pow_mul_eq_zero_of_algebraMap_eq_zero {A B : Type*} [CommRing A]
    [CommRing B] [Algebra A B] {g : A} [IsLocalization.Away g B] {x : A}
    (h : algebraMap A B x = 0) : ∃ n : ℕ, g ^ n * x = 0 := by
  obtain ⟨⟨_, n, rfl⟩, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers g) B x).mp h
  exact ⟨n, hm⟩

/-- **The ring-theoretic content of being an isomorphism over a standard open.** If a morphism of
affine schemes `f : Y ⟶ X` induces an isomorphism on the sections over `D(g)`, then an element of
`Γ(X, ⊤)` killed by `f` is killed by a power of `g`, and every element of `Γ(Y, ⊤)` becomes the
image of a section of `X` after multiplication by a power of the image of `g`. -/
theorem exists_pow_mul_eq_zero_and_pow_mul_mem_range_of_isIso_app {X Y : Scheme.{u}} [IsAffine X]
    [IsAffine Y] (f : Y ⟶ X) (g : Γ(X, ⊤)) (hiso : IsIso (f.app (X.basicOpen g))) :
    (∀ r : Γ(X, ⊤), f.appTop.hom r = 0 → ∃ n : ℕ, g ^ n * r = 0) ∧
      (∀ s : Γ(Y, ⊤), ∃ (r : Γ(X, ⊤)) (n : ℕ),
        f.appTop.hom r = f.appTop.hom g ^ n * s) := by
  let _ : Algebra Γ(Y, ⊤) Γ(Y, f ⁻¹ᵁ X.basicOpen g) :=
    (Y.presheaf.map (homOfLE (le_top : (f ⁻¹ᵁ X.basicOpen g) ≤ ⊤)).op).hom.toAlgebra
  have hB : IsLocalization.Away (f.appTop g) Γ(Y, f ⁻¹ᵁ X.basicOpen g) :=
    (isAffineOpen_top Y).isLocalization_of_eq_basicOpen (f.appTop g)
      (homOfLE (le_top : (f ⁻¹ᵁ X.basicOpen g) ≤ ⊤)) (Scheme.Hom.preimage_basicOpen_top f g)
  have hsq : ∀ x : Γ(X, ⊤), (f.app (X.basicOpen g)).hom
        (algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g) x) =
      algebraMap Γ(Y, ⊤) Γ(Y, f ⁻¹ᵁ X.basicOpen g) (f.appTop.hom x) := by
    have h : X.presheaf.map (homOfLE (X.basicOpen_le g)).op ≫ f.app (X.basicOpen g) =
        f.appTop ≫ Y.presheaf.map (homOfLE (le_top : (f ⁻¹ᵁ X.basicOpen g) ≤ ⊤)).op := by
      rw [f.naturality (homOfLE (X.basicOpen_le g)).op]
      rfl
    exact fun x => congrArg (fun φ : Γ(X, ⊤) ⟶ Γ(Y, f ⁻¹ᵁ X.basicOpen g) => φ.hom x) h
  refine ⟨fun r hr => ?_, fun s => ?_⟩
  · have h0 : algebraMap Γ(X, ⊤) Γ(X, X.basicOpen g) r = 0 := by
      refine (ConcreteCategory.bijective_of_isIso (f.app (X.basicOpen g))).1 ?_
      rw [hsq, hr, map_zero, map_zero]
    exact exists_pow_mul_eq_zero_of_algebraMap_eq_zero h0
  · obtain ⟨y, hy⟩ := (ConcreteCategory.bijective_of_isIso (f.app (X.basicOpen g))).2
      (algebraMap Γ(Y, ⊤) Γ(Y, f ⁻¹ᵁ X.basicOpen g) s)
    obtain ⟨⟨r, _, n, rfl⟩, hrm⟩ := IsLocalization.surj (Submonoid.powers g) y
    have e1 := congrArg (f.app (X.basicOpen g)).hom hrm
    rw [map_mul, hy, hsq, hsq, map_pow, map_pow] at e1
    have e2 : algebraMap Γ(Y, ⊤) Γ(Y, f ⁻¹ᵁ X.basicOpen g)
        (f.appTop.hom r - f.appTop.hom g ^ n * s) = 0 := by
      rw [map_sub, map_mul, map_pow]
      linear_combination -e1
    obtain ⟨k, hc⟩ := exists_pow_mul_eq_zero_of_algebraMap_eq_zero (g := f.appTop g) e2
    refine ⟨g ^ k * r, k + n, ?_⟩
    rw [map_mul, map_pow, pow_add]
    linear_combination hc

/-- **Blowing up two elements of a one-dimensional Noetherian local ring, one of them a
nonzerodivisor, makes the ideal they generate invertible.** The blowup of `Spec R` in `(a, b)` is
finite over `Spec R`, hence affine, and its global sections `S` form a finite `R`-algebra with
`R → S` injective and `S / R` annihilated by a power of the maximal ideal; the exceptional divisor
is the invertible ideal generated by the images of `a` and `b`. -/
theorem exists_finiteExtension_invertible_span_pair (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (hdim : ringKrullDim R = 1) (a b : R) (ha : a ∈ nonZeroDivisors R) :
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (_ : Module.Finite R S),
      Function.Injective (algebraMap R S) ∧
      (∃ n : ℕ, maximalIdeal R ^ n ≤
        Module.annihilator R (S ⧸ (Algebra.linearMap R S).range)) ∧
      Module.Invertible S (Ideal.span ({algebraMap R S a, algebraMap R S b} : Set S)) := by
  classical
  let X : Scheme.{u} := Spec (CommRingCat.of R)
  let ρ : R ≃+* Γ(X, ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of R)).commRingCatIsoToRingEquiv.symm
  let I : X.IdealSheafData :=
    Scheme.IdealSheafData.ofIdealTop (Ideal.span ({ρ a, ρ b} : Set Γ(X, ⊤)))
  have hfin : IsFinite (blowUpToBase I) :=
    isFinite_blowUpToBase_of_ringKrullDim_le_one hdim.le I
  have : IsAffine (blowUp I) := isAffine_of_isAffineHom (blowUpToBase I)
  let S : Type u := Γ(blowUp I, ⊤)
  let _ : Algebra Γ(X, ⊤) S := (blowUpToBase I).appTop.hom.toAlgebra
  let _ : Algebra R Γ(X, ⊤) := ρ.toRingHom.toAlgebra
  let algRS : Algebra R S := Algebra.compHom S ρ.toRingHom
  have : IsScalarTower R Γ(X, ⊤) S := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Module.Finite R Γ(X, ⊤) :=
    Module.Finite.of_surjective (Algebra.linearMap R Γ(X, ⊤)) ρ.surjective
  have : Module.Finite Γ(X, ⊤) S := (blowUpToBase I).finite_appTop
  have finRS : Module.Finite R S := Module.Finite.trans Γ(X, ⊤) S
  have hmap : ∀ x : R, algebraMap R S x = (blowUpToBase I).appTop.hom (ρ x) := fun _ => rfl
  -- the blowup is an isomorphism over the standard open `D(a)`, which avoids the centre
  have hWle : ((X.basicOpen (ρ a) : X.Opens) : Set X) ⊆ ((I.support : Set X))ᶜ := by
    intro x hx hxs
    rw [Scheme.IdealSheafData.coe_support_ofIdealTop] at hxs
    exact (X.mem_zeroLocus_iff _ x).mp hxs (ρ a) (Ideal.subset_span (by simp)) hx
  have hisoApp : IsIso ((blowUpToBase I).app (X.basicOpen (ρ a))) :=
    (isIso_morphismRestrict_iff_isIso_app _ ((isAffineOpen_top X).basicOpen (ρ a))).mp
      (isIso_blowUpToBase_restrict_of_subset_compl_support I _ hWle)
  obtain ⟨hker, hclear⟩ :=
    exists_pow_mul_eq_zero_and_pow_mul_mem_range_of_isIso_app (blowUpToBase I) (ρ a) hisoApp
  -- injectivity
  have hinj : Function.Injective (algebraMap R S) := by
    refine (injective_iff_map_eq_zero (algebraMap R S)).mpr fun x hx => ?_
    obtain ⟨n, hn⟩ := hker (ρ x) (by rwa [← hmap])
    refine (mem_nonZeroDivisors_iff.mp ((nonZeroDivisors R).pow_mem ha n)).1 x (ρ.injective ?_)
    rwa [map_mul, map_pow, map_zero]
  -- a power of `a` carries `S` into `R`
  have hkill : ∀ q : S ⧸ (Algebra.linearMap R S).range, ∃ n : ℕ, a ^ n • q = 0 := by
    intro q
    obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    obtain ⟨r, n, hn⟩ := hclear s
    refine ⟨n, ?_⟩
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    refine ⟨ρ.symm r, ?_⟩
    rw [Algebra.linearMap_apply, Algebra.smul_def, hmap, hmap, ρ.apply_symm_apply, map_pow,
      map_pow]
    exact hn
  have hsupp : Module.support R (S ⧸ (Algebra.linearMap R S).range) ⊆ {closedPoint R} := by
    intro p hp
    obtain ⟨q, hq⟩ := Module.mem_support_iff_exists_annihilator.mp hp
    obtain ⟨n, hn⟩ := hkill q
    exact Set.mem_singleton_iff.mpr (PrimeSpectrum.ext
      (eq_maximalIdeal_of_isPrime_of_mem_nonZeroDivisors hdim ha p.asIdeal p.isPrime
        (p.isPrime.mem_of_pow_mem n
          (hq ((Submodule.mem_annihilator_span_singleton q (a ^ n)).2 hn)))))
  -- the exceptional divisor is the ideal generated by the images of `a` and `b`
  have hE : (I.comap (blowUpToBase I)).ideal ⟨⊤, isAffineOpen_top (blowUp I)⟩ =
      Ideal.span ({algebraMap R S a, algebraMap R S b} : Set S) := by
    rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine I (blowUpToBase I),
      Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map, Ideal.map_span]
    simp only [Set.image_insert_eq, Set.image_singleton]
    rfl
  exact ⟨S, inferInstance, algRS, finRS, hinj,
    exists_maximalIdeal_pow_le_annihilator_of_support_subset hsupp,
    hE ▸ Stacks.Divisors.invertible_ideal_top_of_isEffectiveCartierDivisor
      (I.comap (blowUpToBase I)) (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal I)⟩

/-- **The geometric input of Stacks Tag 02Q7.** Over a one-dimensional Noetherian local ring, two
nonzerodivisors generate an invertible ideal in a finite extension whose quotient by the base is
annihilated by a power of the maximal ideal. -/
theorem invertibleSpanPairAfterFiniteExtension :
    InvertibleSpanPairAfterFiniteExtension.{u} :=
  fun R _ _ _ hdim a b ha _ _ _ => exists_finiteExtension_invertible_span_pair R hdim a b ha

end Stacks.PrepareNonZeroDivisors

end
