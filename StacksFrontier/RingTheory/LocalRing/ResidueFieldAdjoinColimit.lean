module

public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.Adjoin.FG
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.AlgebraicGeometry.GammaSpecAdjunction

/-!
# The residue field at a prime as a colimit over finitely generated subalgebras

Let `A` be an `R₀`-algebra and `𝔭 ⊂ A` a prime. For a finite subset `s ⊆ A` let `A_s = R₀[s] ⊆ A`
be the `R₀`-subalgebra it generates and `𝔭_s = 𝔭 ∩ A_s`. Then `κ(𝔭)` is the filtered colimit of
the residue fields `κ(𝔭_s)`, and so `Spec κ(𝔭)` is the limit of the `Spec κ(𝔭_s)`. This is the
statement `κ(s) = colim κ(s_i)` of the proof of Stacks 0E7C, for the system of finitely generated
`ℤ`-subalgebras of `A`.

## Main results

* `AlgebraicGeometry.AdjoinResidueField.ringIsColimit`: `κ(𝔭) = colim κ(𝔭_s)`.
* `AlgebraicGeometry.AdjoinResidueField.isLimit`: `Spec κ(𝔭) = lim Spec κ(𝔭_s)`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.AdjoinResidueField

variable {A : Type u} [CommRing A] (R₀ : Type*) [CommRing R₀] [Algebra R₀ A] (p : Ideal A)
  [p.IsPrime]

/-- The `R₀`-subalgebra of `A` generated by a finite subset. -/
abbrev sub (s : Finset A) : Subalgebra R₀ A := Algebra.adjoin R₀ (s : Set A)

/-- The inclusion `R₀[s] ⊆ R₀[t]` for `s ⊆ t`. -/
abbrev incl {s t : Finset A} (h : s ⟶ t) : sub R₀ s →+* sub R₀ t :=
  (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom h)))).toRingHom

/-- The prime `𝔭 ∩ R₀[s]`. -/
abbrev prime (s : Finset A) : Ideal (sub R₀ s) := p.comap (sub R₀ s).val.toRingHom

/-- The inclusion `R₀[s] ⊆ R₀[t]` does not move elements of `A`. -/
theorem incl_apply {s t : Finset A} (h : s ⟶ t) (x : sub R₀ s) :
    ((incl R₀ h x : sub R₀ t) : A) = (x : A) :=
  Subalgebra.coe_inclusion _ x

omit [p.IsPrime] in
/-- For `s ⊆ t`, the prime `𝔭 ∩ R₀[s]` is the pullback of `𝔭 ∩ R₀[t]` along the inclusion. -/
theorem prime_comap {s t : Finset A} (h : s ⟶ t) :
    prime R₀ p s = (prime R₀ p t).comap (incl R₀ h) :=
  Ideal.ext fun x => (iff_of_eq (congrArg (· ∈ p) (incl_apply R₀ h x))).symm

omit [p.IsPrime] in
/-- The prime `𝔭 ∩ R₀[s]` is the pullback of `𝔭` along `R₀[s] → A`. -/
theorem prime_eq (s : Finset A) : prime R₀ p s = p.comap (sub R₀ s).val.toRingHom := rfl

/-- Two homomorphisms out of `κ(𝔭 ∩ R₀[s])` agree once they agree on the classes of fractions. -/
theorem ringHom_ext {s : Finset A} {K : Type u} [CommRing K]
    {f g : (prime R₀ p s).ResidueField →+* K}
    (h : ∀ (a : sub R₀ s) (b : (prime R₀ p s).primeCompl),
      f (IsLocalRing.residue _ (IsLocalization.mk' _ a b)) =
        g (IsLocalRing.residue _ (IsLocalization.mk' _ a b))) : f = g := by
  refine RingHom.ext fun x => ?_
  obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
  obtain ⟨⟨a, b⟩, rfl⟩ := IsLocalization.mk'_surjective (prime R₀ p s).primeCompl y
  exact h a b

/-- The map of residue fields induced by `f` sends the class of `a / b` to the class of
`f a / f b`. -/
private theorem map_residue_mk'_aux {R S : Type*} [CommRing R] [CommRing S] (P : Ideal R)
    [P.IsPrime] (Q : Ideal S) [Q.IsPrime] (f : R →+* S) (hf : P = Q.comap f) (a : R)
    (b : P.primeCompl) :
    Ideal.ResidueField.map P Q f hf (IsLocalRing.residue _ (IsLocalization.mk' _ a b)) =
      IsLocalRing.residue _ (IsLocalization.mk' _ (f a)
        (⟨f b, fun hb => b.2 (hf ▸ hb)⟩ : Q.primeCompl)) := by
  simp [Ideal.ResidueField.map, Localization.localRingHom_mk']

/-- The transition map `κ(𝔭 ∩ R₀[s]) → κ(𝔭 ∩ R₀[t])` sends the class of `a / b` to the class
of the same fraction read in `R₀[t]`. -/
theorem map_residue_mk' {s t : Finset A} (h : s ⟶ t) (a : sub R₀ s)
    (b : (prime R₀ p s).primeCompl) :
    Ideal.ResidueField.map (prime R₀ p s) (prime R₀ p t) (incl R₀ h) (prime_comap R₀ p h)
        (IsLocalRing.residue _ (IsLocalization.mk' _ a b)) =
      IsLocalRing.residue _ (IsLocalization.mk' _ (incl R₀ h a)
        (⟨incl R₀ h b, fun hb => b.2 hb⟩ : (prime R₀ p t).primeCompl)) :=
  map_residue_mk'_aux ..

/-- The map `κ(𝔭 ∩ R₀[s]) → κ(𝔭)` sends the class of `a / b` to the class of the same fraction
read in `A`. -/
theorem toResidueField_residue_mk' (s : Finset A) (a : sub R₀ s)
    (b : (prime R₀ p s).primeCompl) :
    Ideal.ResidueField.map (prime R₀ p s) p (sub R₀ s).val.toRingHom (prime_eq R₀ p s)
        (IsLocalRing.residue _ (IsLocalization.mk' _ a b)) =
      IsLocalRing.residue _ (IsLocalization.mk' _ (a : A)
        (⟨(b : sub R₀ s), b.2⟩ : p.primeCompl)) :=
  map_residue_mk'_aux ..

/-- The diagram of the residue fields `κ(𝔭 ∩ R₀[s])`. -/
def ringDiagram : Finset A ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (prime R₀ p s).ResidueField
  map h := CommRingCat.ofHom
    (Ideal.ResidueField.map (prime R₀ p _) (prime R₀ p _) (incl R₀ h) (prime_comap R₀ p h))
  map_id s := by
    apply CommRingCat.hom_ext
    refine ringHom_ext R₀ p fun a b => ?_
    exact (map_residue_mk' R₀ p (𝟙 s) a b).trans rfl
  map_comp {s t r} h k := by
    apply CommRingCat.hom_ext
    refine ringHom_ext R₀ p fun a b => (map_residue_mk' R₀ p (h ≫ k) a b).trans ?_
    change _ = Ideal.ResidueField.map (prime R₀ p t) (prime R₀ p r) (incl R₀ k)
      (prime_comap R₀ p k) (Ideal.ResidueField.map (prime R₀ p s) (prime R₀ p t) (incl R₀ h)
        (prime_comap R₀ p h) (IsLocalRing.residue _ (IsLocalization.mk' _ a b)))
    rw [map_residue_mk', map_residue_mk']
    rfl

/-- The cocone of the maps `κ(𝔭 ∩ R₀[s]) ⟶ κ(𝔭)`. -/
def ringCocone : Cocone (ringDiagram R₀ p) where
  pt := CommRingCat.of p.ResidueField
  ι :=
    { app := fun s ↦ CommRingCat.ofHom
        (Ideal.ResidueField.map (prime R₀ p s) p (sub R₀ s).val.toRingHom (prime_eq R₀ p s))
      naturality := by
        intro s t h
        apply CommRingCat.hom_ext
        refine ringHom_ext R₀ p fun a b => ?_
        change Ideal.ResidueField.map (prime R₀ p t) p (sub R₀ t).val.toRingHom
          (prime_eq R₀ p t) (Ideal.ResidueField.map (prime R₀ p s) (prime R₀ p t) (incl R₀ h)
            (prime_comap R₀ p h) (IsLocalRing.residue _ (IsLocalization.mk' _ a b))) =
          Ideal.ResidueField.map (prime R₀ p s) p (sub R₀ s).val.toRingHom (prime_eq R₀ p s)
            (IsLocalRing.residue _ (IsLocalization.mk' _ a b))
        rw [map_residue_mk', toResidueField_residue_mk', toResidueField_residue_mk']
        simp only [incl_apply] }

/-- **`κ(𝔭)` is the filtered colimit of the residue fields `κ(𝔭 ∩ R₀[s])`.** Every element of
`κ(𝔭)` is the class of a fraction `a / b` with `a, b ∈ A`, `b ∉ 𝔭`, which already lives in
`κ(𝔭 ∩ R₀[{a, b}])`; the transition maps, being homomorphisms of fields, are injective. -/
def ringIsColimit : IsColimit (ringCocone R₀ p) := by
  classical
  let := reflectsColimit_of_reflectsIsomorphisms (ringDiagram R₀ p) (forget CommRingCat)
  apply isColimitOfReflects (forget CommRingCat)
  apply Types.FilteredColimit.isColimitOf'
  · intro x
    obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
    obtain ⟨⟨a, b⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl y
    let s : Finset A := {a, (b : A)}
    let a' : sub R₀ s := ⟨a, Algebra.subset_adjoin (by simp [s])⟩
    let b' : sub R₀ s := ⟨b, Algebra.subset_adjoin (by simp [s])⟩
    have hb' : b' ∈ (prime R₀ p s).primeCompl := fun h => b.2 h
    refine ⟨s, IsLocalRing.residue _ (IsLocalization.mk' _ a' ⟨b', hb'⟩), ?_⟩
    exact (toResidueField_residue_mk' R₀ p s a' ⟨b', hb'⟩).symm
  · intro s x y h
    exact ⟨s, 𝟙 s, by
      rw [(Ideal.ResidueField.map _ _ _ (prime_eq R₀ p s)).injective h]⟩

/-- The cofiltered system of the spectra of the residue fields `κ(𝔭 ∩ R₀[s])`. -/
abbrev diagram : (Finset A)ᵒᵖ ⥤ Scheme.{u} := (ringDiagram R₀ p).op ⋙ Scheme.Spec

/-- The cone of the morphisms `Spec κ(𝔭) ⟶ Spec κ(𝔭 ∩ R₀[s])`. -/
abbrev cone : Cone (diagram R₀ p) := Scheme.Spec.mapCone (ringCocone R₀ p).op

/-- **`Spec κ(𝔭)` is the limit of the spectra of the residue fields `κ(𝔭 ∩ R₀[s])`.** -/
def isLimit : IsLimit (cone R₀ p) :=
  isLimitOfPreserves Scheme.Spec (ringIsColimit R₀ p).op

end AlgebraicGeometry.AdjoinResidueField

end
