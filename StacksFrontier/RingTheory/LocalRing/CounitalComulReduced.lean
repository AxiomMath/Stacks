/-!
# A local Cartier theorem: counital local algebras in characteristic zero

Let `k` be a field of characteristic zero and `R` a local `k`-algebra with a `k`-algebra map
`ε : R → k`. Let `S` be the localization of `R ⊗[k] R` at the kernel of `ε ⊗ ε`, with
`π₁, π₂ : S → R` induced by `ε ⊗ id` and `id ⊗ ε`. A ring map `Δ : R → S` is *counital* when
`π₁ ∘ Δ = id = π₂ ∘ Δ`; this is what the comultiplication of a group scheme over `k` gives on the
local ring at the identity. We show that if such a `Δ` exists and the nilradical `N` of `R` is
finitely generated, then `N = 0`.

## Main definitions

* `counitTensorKer ε`: the kernel of `ε ⊗ ε : R ⊗[k] R → k`, a prime ideal.

## Main results

* `nilradical_eq_bot_of_counital_of_fg`: the local Cartier theorem.

## Implementation notes

The usual proof passes to the associated graded ring `⊕ Nⁱ/𝔪Nⁱ`, where `Δ` becomes a counital
graded map, so that degree-one elements are primitive. We avoid building that ring. By Nakayama
there is an `x ∈ N \ 𝔪N`; let `q ≥ 2` be least with `x ^ q ∈ 𝔪 Nᵠ`. As `k` is perfect, the
nilpotents of `S` lie in the ideal `J` generated by `N ⊗ 1` and `1 ⊗ N`, and counitality gives
`Δ x ≡ x ⊗ 1 + 1 ⊗ x` modulo `𝔪_S J`. Hence `(x ⊗ 1 + 1 ⊗ x) ^ q ∈ 𝔪_S Jᵠ`. In the quotient
of `S` by `𝔪Nᵠ⁻¹ ⊗ 1 + 1 ⊗ 𝔪N` the ideal `𝔪_S Jᵠ` vanishes and the left side becomes
`q · xᵠ⁻¹ ⊗ x`, which is nonzero there; as `q` is invertible in `k`, this is a contradiction.
-/

@[expose] public section

open TensorProduct

variable {k R S : Type*} [Field k] [CommRing R] [Algebra k R]

/-- The kernel of `ε ⊗ ε : R ⊗[k] R → k` for a `k`-algebra map `ε : R → k`. -/
noncomputable def counitTensorKer (ε : R →ₐ[k] k) : Ideal (R ⊗[k] R) :=
  RingHom.ker (Algebra.TensorProduct.lift ε ε fun _ _ => .all _ _).toRingHom

/-- The kernel of `ε ⊗ ε` is a prime ideal, being the kernel of a map to a field. -/
instance (ε : R →ₐ[k] k) : (counitTensorKer ε).IsPrime := RingHom.ker_isPrime _

namespace CounitalComulReduced

/-- A power of `A ⊔ B`, bounded by the terms of degree at most one in `B` and by `B ^ 2`. -/
theorem sup_pow_succ_le {T : Type*} [CommRing T] (A B : Ideal T) (n : ℕ) :
    (A ⊔ B) ^ (n + 1) ≤ A ^ (n + 1) ⊔ A ^ n * B ⊔ B ^ 2 := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc (A ⊔ B) ^ (n + 1 + 1) = (A ⊔ B) ^ (n + 1) * (A ⊔ B) := pow_succ _ _
      _ ≤ (A ^ (n + 1) ⊔ A ^ n * B ⊔ B ^ 2) * (A ⊔ B) := Ideal.mul_mono_left ih
      _ ≤ A ^ (n + 1 + 1) ⊔ A ^ (n + 1) * B ⊔ B ^ 2 := by
        rw [Ideal.mul_sup, Ideal.sup_mul, Ideal.sup_mul, Ideal.sup_mul, Ideal.sup_mul]
        refine sup_le (sup_le (sup_le ?_ ?_) ?_) (sup_le (sup_le ?_ ?_) ?_)
        · rw [← pow_succ]
          exact le_sup_of_le_left le_sup_left
        · rw [show A ^ n * B * A = A ^ (n + 1) * B by ring]
          exact le_sup_of_le_left le_sup_right
        · exact le_sup_of_le_right Ideal.mul_le_left
        · exact le_sup_of_le_left le_sup_right
        · rw [show A ^ n * B * B = A ^ n * B ^ 2 by ring]
          exact le_sup_of_le_right Ideal.mul_le_right
        · exact le_sup_of_le_right Ideal.mul_le_left

/-- The binomial formula when the second summand squares to zero. -/
theorem add_pow_succ_of_sq_eq_zero {T : Type*} [CommRing T] (a b : T) (hb : b ^ 2 = 0)
    (n : ℕ) : (a + b) ^ (n + 1) = a ^ (n + 1) + (n + 1 : T) * a ^ n * b := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, ih]
    push_cast
    linear_combination ((n : T) + 1) * a ^ n * hb

variable (ε : R →ₐ[k] k)

/-- `ε ⊗ ε`, as a `k`-algebra map. -/
noncomputable abbrev counitTensor : R ⊗[k] R →ₐ[k] k :=
  Algebra.TensorProduct.lift ε ε fun _ _ => .all _ _

/-- The ideal generated by `ker ε ⊗ 1` and `1 ⊗ ker ε`. -/
noncomputable abbrev augIdeal : Ideal (R ⊗[k] R) :=
  (RingHom.ker ε).map (Algebra.TensorProduct.includeLeft : R →ₐ[k] R ⊗[k] R) ⊔
    (RingHom.ker ε).map (Algebra.TensorProduct.includeRight : R →ₐ[k] R ⊗[k] R)

/-- An element minus the scalar `ε r` lies in the kernel of `ε`. -/
theorem sub_algebraMap_mem_ker (r : R) : r - algebraMap k R (ε r) ∈ RingHom.ker ε := by
  simp [RingHom.mem_ker]

/-- Every element of `R ⊗[k] R` is congruent to the scalar `(ε ⊗ ε) t` modulo `augIdeal ε`. -/
theorem sub_algebraMap_mem_augIdeal (t : R ⊗[k] R) :
    t - algebraMap k (R ⊗[k] R) (counitTensor ε t) ∈ augIdeal ε := by
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    have h : a ⊗ₜ[k] b - algebraMap k (R ⊗[k] R) (counitTensor ε (a ⊗ₜ b)) =
        Algebra.TensorProduct.includeLeft (S := k) (a - algebraMap k R (ε a)) *
            Algebra.TensorProduct.includeRight b +
          algebraMap k (R ⊗[k] R) (ε a) *
            Algebra.TensorProduct.includeRight (b - algebraMap k R (ε b)) := by
      simp only [Algebra.TensorProduct.lift_tmul, map_sub, map_mul, AlgHom.commutes,
        Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply]
      have e : a ⊗ₜ[k] (1 : R) * (1 : R) ⊗ₜ[k] b = a ⊗ₜ[k] b := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      linear_combination -e
    rw [h]
    exact Ideal.add_mem _
      (Ideal.mul_mem_right _ _ (Ideal.mem_sup_left
        (Ideal.mem_map_of_mem _ (sub_algebraMap_mem_ker ε a))))
      (Ideal.mul_mem_left _ _ (Ideal.mem_sup_right
        (Ideal.mem_map_of_mem _ (sub_algebraMap_mem_ker ε b))))
  | add x y hx hy =>
    convert Ideal.add_mem _ hx hy using 1
    simp only [map_add]
    ring

/-- Over a field, a pure tensor of nonzero vectors is nonzero. -/
theorem tmul_ne_zero_of_ne_zero {V W : Type*} [AddCommGroup V] [Module k V] [AddCommGroup W]
    [Module k W] {a : V} {b : W} (ha : a ≠ 0) (hb : b ≠ 0) : a ⊗ₜ[k] b ≠ 0 := by
  obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual k V, φ a ≠ 0 :=
    not_forall.mp (mt (Module.forall_dual_apply_eq_zero_iff k a).mp ha)
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Module.Dual k W, ψ b ≠ 0 :=
    not_forall.mp (mt (Module.forall_dual_apply_eq_zero_iff k b).mp hb)
  intro h
  have h' := congrArg (TensorProduct.lift ((LinearMap.mul k k).compl₁₂ φ ψ)) h
  simp only [TensorProduct.lift.tmul, LinearMap.compl₁₂_apply, LinearMap.mul_apply',
    map_zero] at h'
  exact mul_ne_zero hφ hψ h'

/-- A nilpotent element of a localization of `A` lies in the ideal generated by the kernel of any
ring map from `A` to a reduced ring. -/
@[ega "0 1.2.8" "more general"]
theorem mem_map_ker_of_isNilpotent {A L C : Type*} [CommRing A] [CommRing L] [CommRing C]
    [Algebra A L] (M : Submonoid A) [IsLocalization M L] [IsReduced C] (θ : A →+* C) {s : L}
    (hs : IsNilpotent s) : s ∈ Ideal.map (algebraMap A L) (RingHom.ker θ) := by
  obtain ⟨⟨a, u⟩, rfl⟩ := IsLocalization.mk'_surjective M s
  obtain ⟨n, hn⟩ := hs
  have hn' : IsLocalization.mk' L a u ^ (n + 1) = 0 := by rw [pow_succ, hn, zero_mul]
  have h0 : algebraMap A L (a ^ (n + 1)) = 0 := by
    have := IsLocalization.mk'_spec L (a ^ (n + 1)) (u ^ (n + 1))
    rw [IsLocalization.mk'_pow, hn', zero_mul] at this
    exact this.symm
  obtain ⟨⟨v, hv⟩, hv0⟩ := (IsLocalization.map_eq_zero_iff M L _).mp h0
  have hva : θ (v * a) = 0 := by
    apply IsReduced.eq_zero
    refine ⟨n + 1, ?_⟩
    rw [← map_pow, mul_pow, pow_succ v n, mul_assoc, hv0, mul_zero, map_zero]
  have hmk : IsLocalization.mk' L a u = algebraMap A L (v * a) *
      IsLocalization.mk' L (1 : A) (u * ⟨v, hv⟩) := by
    rw [← IsLocalization.mk'_eq_mul_mk'_one, mul_comm v a]
    exact (IsLocalization.mk'_cancel (S := L) a u ⟨v, hv⟩).symm
  change IsLocalization.mk' L a u ∈ _
  rw [hmk]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hva)

/-- Over a field of characteristic zero, the tensor square of a reduced algebra is reduced. -/
theorem isReduced_tensorProduct_self [CharZero k] (A : Type*) [CommRing A] [Algebra k A]
    [IsReduced A] : IsReduced (A ⊗[k] A) := by
  have : Algebra.IsGeometricallyReduced k A :=
    (Algebra.isGeometricallyReduced_field_iff k A).mpr
      (Algebra.isReduced_tensorProduct_of_isSeparableExtension_or_isSeparablyGenerated
        (Or.inl (Algebra.isSeparableExtension_of_perfectField k _)))
  infer_instance

/-- The kernel of the tensor product of two quotient maps. -/
theorem ker_map_mkₐ (I₁ I₂ : Ideal R) :
    RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k I₁) (Ideal.Quotient.mkₐ k I₂)) =
      I₁.map (Algebra.TensorProduct.includeLeft : R →ₐ[k] R ⊗[k] R) ⊔
        I₂.map (Algebra.TensorProduct.includeRight : R →ₐ[k] R ⊗[k] R) := by
  have := Algebra.TensorProduct.map_ker (Ideal.Quotient.mkₐ k I₁) (Ideal.Quotient.mkₐ k I₂)
    (Ideal.Quotient.mkₐ_surjective k I₁) (Ideal.Quotient.mkₐ_surjective k I₂)
  have e₁ : RingHom.ker (Ideal.Quotient.mkₐ k I₁) = I₁ := Ideal.Quotient.mkₐ_ker k I₁
  have e₂ : RingHom.ker (Ideal.Quotient.mkₐ k I₂) = I₂ := Ideal.Quotient.mkₐ_ker k I₂
  rwa [e₁, e₂] at this

/-- For a local `R`, the kernel of the surjection `ε : R → k` is the maximal ideal. -/
theorem ker_eq_maximalIdeal [IsLocalRing R] : RingHom.ker ε = IsLocalRing.maximalIdeal R := by
  have : (RingHom.ker ε).IsMaximal := RingHom.ker_isMaximal_of_surjective (ε : R →+* k)
    (fun c => ⟨algebraMap k R c, ε.commutes c⟩)
  exact IsLocalRing.eq_maximalIdeal this

section Localized

variable [CommRing S] [Algebra (R ⊗[k] R) S] [IsLocalization.AtPrime S (counitTensorKer ε)]

local notation "alg" => algebraMap (R ⊗[k] R) S

/-- `a ↦ a ⊗ 1` into the localization. -/
noncomputable abbrev ιL : R →+* S := (algebraMap (R ⊗[k] R) S).comp
  (Algebra.TensorProduct.includeLeft : R →ₐ[k] R ⊗[k] R).toRingHom

/-- `b ↦ 1 ⊗ b` into the localization. -/
noncomputable abbrev ιR : R →+* S := (algebraMap (R ⊗[k] R) S).comp
  (Algebra.TensorProduct.includeRight : R →ₐ[k] R ⊗[k] R).toRingHom

/-- The scalars `k` in the localization. -/
noncomputable abbrev κ : k →+* S := (algebraMap (R ⊗[k] R) S).comp (algebraMap k (R ⊗[k] R))

omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `ιL a` is the image of `a ⊗ 1` in the localization. -/
theorem ιL_apply (a : R) : ιL (k := k) (S := S) a = alg (a ⊗ₜ 1) := rfl

omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `ιR b` is the image of `1 ⊗ b` in the localization. -/
theorem ιR_apply (b : R) : ιR (k := k) (S := S) b = alg (1 ⊗ₜ b) := rfl

omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `ιL` restricts to `κ` on the scalars. -/
theorem ιL_algebraMap (c : k) : ιL (k := k) (S := S) (algebraMap k R c) = κ (R := R) c := by
  simp [Algebra.TensorProduct.algebraMap_apply]

omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `ιR` restricts to `κ` on the scalars. -/
theorem ιR_algebraMap (c : k) : ιR (k := k) (S := S) (algebraMap k R c) = κ (R := R) c := by
  simp

omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `ιL a * ιR b` is the image of `a ⊗ b` in the localization. -/
theorem ιL_mul_ιR (a b : R) : ιL (k := k) (S := S) a * ιR (k := k) b = alg (a ⊗ₜ b) := by
  rw [ιL_apply, ιR_apply, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

/-- The image in the localization of `I₁ ⊗ R + R ⊗ I₂` is generated by `I₁ ⊗ 1` and `1 ⊗ I₂`. -/
private theorem map_algebraMap_includes_sup (I₁ I₂ : Ideal R) :
    (I₁.map (Algebra.TensorProduct.includeLeft : R →ₐ[k] R ⊗[k] R) ⊔
      I₂.map (Algebra.TensorProduct.includeRight : R →ₐ[k] R ⊗[k] R)).map alg =
      I₁.map (ιL (k := k) (S := S)) ⊔ I₂.map (ιR (k := k)) := by
  rw [Ideal.map_sup]
  congr 1 <;> exact Ideal.map_map _ _

variable (π₁ π₂ : S →+* R)
  (hπ₁ : ∀ a b, π₁ (algebraMap (R ⊗[k] R) S (a ⊗ₜ b)) = algebraMap k R (ε a) * b)
  (hπ₂ : ∀ a b, π₂ (algebraMap (R ⊗[k] R) S (a ⊗ₜ b)) = a * algebraMap k R (ε b))

include hπ₁ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `π₁` sends `ιL a` to the scalar `ε a`. -/
theorem π₁_ιL (a : R) : π₁ (ιL (k := k) a) = algebraMap k R (ε a) := by
  rw [ιL_apply, hπ₁, mul_one]

include hπ₁ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `π₁` is a left inverse of `ιR`. -/
theorem π₁_ιR (b : R) : π₁ (ιR (k := k) b) = b := by
  rw [ιR_apply, hπ₁, map_one, map_one, one_mul]

include hπ₂ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `π₂` is a left inverse of `ιL`. -/
theorem π₂_ιL (a : R) : π₂ (ιL (k := k) a) = a := by
  rw [ιL_apply, hπ₂, map_one, map_one, mul_one]

include hπ₂ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `π₂` sends `ιR b` to the scalar `ε b`. -/
theorem π₂_ιR (b : R) : π₂ (ιR (k := k) b) = algebraMap k R (ε b) := by
  rw [ιR_apply, hπ₂, one_mul]

include hπ₁ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- On the image of `R ⊗[k] R`, `ε ∘ π₁` is `ε ⊗ ε`. -/
theorem ε_π₁_alg (t : R ⊗[k] R) : ε (π₁ (alg t)) = counitTensor ε t := by
  induction t using TensorProduct.inductionOn with
  | tmul a b => simp [hπ₁]
  | add x y hx hy => simp only [map_add, hx, hy]

include hπ₁ hπ₂ in
/-- The two residue maps `ε ∘ π₁` and `ε ∘ π₂` of `S` agree. -/
theorem ε_π₂ (s : S) : ε (π₂ s) = ε (π₁ s) := by
  have : (ε : R →+* k).comp π₂ = (ε : R →+* k).comp π₁ :=
    IsLocalization.ringHom_ext (counitTensorKer ε).primeCompl (RingHom.ext fun t => by
      induction t using TensorProduct.inductionOn with
      | tmul a b =>
        change ε (π₂ (alg (a ⊗ₜ b))) = ε (π₁ (alg (a ⊗ₜ b)))
        rw [hπ₁, hπ₂]
        simp [mul_comm]
      | add x y hx hy =>
        simp only [RingHom.comp_apply, map_add] at hx hy ⊢
        rw [hx, hy])
  exact congrArg (fun f => f s) this

include hπ₁ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- `ε ∘ π₁` is a left inverse of the scalar map `κ`. -/
theorem ε_π₁_κ (c : k) : ε (π₁ (κ (R := R) (S := S) c)) = c := by
  change ε (π₁ (alg _)) = c
  rw [ε_π₁_alg ε π₁ hπ₁]
  simp

/-- The maximal ideal of `S`, as the kernel of its residue map `ε ∘ π₁`. -/
noncomputable abbrev augS : Ideal S := RingHom.ker ((ε : R →+* k).comp π₁)

omit [Algebra (R ⊗[k] R) S] [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- Membership in `augS`: the residue `ε (π₁ s)` vanishes. -/
theorem mem_augS_iff (s : S) : s ∈ augS ε π₁ ↔ ε (π₁ s) = 0 := RingHom.mem_ker

include hπ₁ in
/-- The maximal ideal of `S` is generated by `m ⊗ 1` and `1 ⊗ m`. -/
theorem maximalIdeal_le [IsLocalRing R] :
    augS ε π₁ ≤ (IsLocalRing.maximalIdeal R).map (ιL (k := k)) ⊔
      (IsLocalRing.maximalIdeal R).map (ιR (k := k)) := by
  intro s hs
  obtain ⟨⟨t, u⟩, rfl⟩ := IsLocalization.mk'_surjective (S := S) (counitTensorKer ε).primeCompl s
  have ht0 : counitTensor ε t = 0 := by
    have h := congrArg (fun z => ε (π₁ z)) (IsLocalization.mk'_spec S t u)
    simp only [map_mul] at h
    rw [(mem_augS_iff ε π₁ _).mp hs, zero_mul, ε_π₁_alg ε π₁ hπ₁] at h
    exact h.symm
  have htmem : alg t ∈ (IsLocalRing.maximalIdeal R).map (ιL (k := k)) ⊔
      (IsLocalRing.maximalIdeal R).map (ιR (k := k)) := by
    have h := sub_algebraMap_mem_augIdeal ε t
    rw [ht0, map_zero, sub_zero] at h
    have := Ideal.mem_map_of_mem alg h
    rwa [augIdeal, map_algebraMap_includes_sup, ker_eq_maximalIdeal] at this
  change IsLocalization.mk' S t u ∈ _
  rw [IsLocalization.mk'_eq_mul_mk'_one]
  exact Ideal.mul_mem_right _ _ htmem

/-- The ideal of `S` generated by `N ⊗ 1` and `1 ⊗ N`. -/
noncomputable abbrev nilIdeal : Ideal S :=
  (nilradical R).map (ιL (k := k)) ⊔ (nilradical R).map (ιR (k := k))

include ε in
/-- Nilpotents of `S` lie in `nilIdeal`; this uses that `k` is perfect. -/
theorem mem_nilIdeal_of_isNilpotent [CharZero k] {s : S} (hs : IsNilpotent s) :
    s ∈ nilIdeal (k := k) (R := R) (S := S) := by
  let θ : R ⊗[k] R →ₐ[k] (R ⧸ nilradical R) ⊗[k] (R ⧸ nilradical R) :=
    Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k _) (Ideal.Quotient.mkₐ k _)
  have : IsReduced (R ⧸ nilradical R) :=
    (Ideal.isRadical_iff_quotient_reduced _).mp (Ideal.radical_isRadical ⊥)
  have : IsReduced ((R ⧸ nilradical R) ⊗[k] (R ⧸ nilradical R)) :=
    isReduced_tensorProduct_self _
  have h := mem_map_ker_of_isNilpotent (counitTensorKer ε).primeCompl θ.toRingHom hs
  have hk : RingHom.ker θ.toRingHom = _ := ker_map_mkₐ (nilradical R) (nilradical R)
  rwa [hk, map_algebraMap_includes_sup] at h

include hπ₁ in
omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- Modulo `𝔪_S · (N ⊗ 1)`, an element of the ideal generated by `N ⊗ 1` is a pure `n ⊗ 1`
(and likewise on the right). -/
theorem exists_sub_mem_mul (ι : R →+* S) (hι : ∀ c, ι (algebraMap k R c) = κ (R := R) c) (z : S)
    (hz : z ∈ (nilradical R).map ι) :
    ∃ n ∈ nilradical R, z - ι n ∈ augS ε π₁ * (nilradical R).map ι := by
  have hsκ : ∀ s : S, s - κ (R := R) (ε (π₁ s)) ∈ augS ε π₁ := fun s => by
    rw [mem_augS_iff ε π₁, map_sub, map_sub, ε_π₁_κ ε π₁ hπ₁, sub_self]
  change z ∈ Submodule.span S (ι '' (nilradical R)) at hz
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨n, hn, rfl⟩ := hz
    exact ⟨n, hn, by simp⟩
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | add z w _ _ ihz ihw =>
    obtain ⟨n, hn, h⟩ := ihz
    obtain ⟨n', hn', h'⟩ := ihw
    refine ⟨n + n', add_mem hn hn', ?_⟩
    convert add_mem h h' using 1
    rw [map_add]
    ring
  | smul s z hz ih =>
    obtain ⟨n, hn, h⟩ := ih
    refine ⟨algebraMap k R (ε (π₁ s)) * n, Ideal.mul_mem_left _ _ hn, ?_⟩
    have e : s • z - ι (algebraMap k R (ε (π₁ s)) * n) =
        (s - κ (R := R) (ε (π₁ s))) * z + κ (R := R) (ε (π₁ s)) * (z - ι n) := by
      rw [smul_eq_mul, map_mul, hι]
      ring
    rw [e]
    exact add_mem (Ideal.mul_mem_mul (hsκ s) hz) (Ideal.mul_mem_left _ _ h)

include hπ₁ hπ₂ in
/-- For `x` nilpotent, `Δ x ≡ x ⊗ 1 + 1 ⊗ x` modulo `𝔪_S · nilIdeal`. -/
theorem sub_mem_augS_mul_nilIdeal [CharZero k] [IsLocalRing R] (Δ : R →+* S)
    (h₁ : ∀ r, π₁ (Δ r) = r) (h₂ : ∀ r, π₂ (Δ r) = r) {x : R} (hxN : x ∈ nilradical R) :
    Δ x - ιL (k := k) x - ιR (k := k) x ∈ augS ε π₁ * nilIdeal (k := k) (R := R) (S := S) := by
  set m := IsLocalRing.maximalIdeal R
  set N := nilradical R
  set J := nilIdeal (k := k) (R := R) (S := S)
  have hm : ∀ a, a ∈ m ↔ ε a = 0 := fun a => by rw [← RingHom.mem_ker, ker_eq_maximalIdeal ε]
  have hNm : N ≤ m := nilradical_le_prime m
  have hεN : ∀ n ∈ N, ε n = 0 := fun n hn => (hm n).mp (hNm hn)
  have hπ₁J : J ≤ N.comap π₁ := sup_le
    (Ideal.map_le_iff_le_comap.mpr fun a ha => by simp [Ideal.mem_comap, hπ₁, hεN a ha])
    (Ideal.map_le_iff_le_comap.mpr fun a ha => by simpa [Ideal.mem_comap, hπ₁] using ha)
  have hπ₂J : J ≤ N.comap π₂ := sup_le
    (Ideal.map_le_iff_le_comap.mpr fun a ha => by simpa [Ideal.mem_comap, hπ₂] using ha)
    (Ideal.map_le_iff_le_comap.mpr fun a ha => by simp [Ideal.mem_comap, hπ₂, hεN a ha])
  have hπPJ : ∀ π : S →+* R, J ≤ N.comap π → (∀ p ∈ augS ε π₁, ε (π p) = 0) →
      augS ε π₁ * J ≤ (m * N).comap π := fun π hJ hP =>
    Ideal.mul_le.mpr fun p hp j hj => by
      rw [Ideal.mem_comap, map_mul]
      exact Ideal.mul_mem_mul ((hm _).mpr (hP p hp)) (hJ hj)
  have hπ₁PJ := hπPJ π₁ hπ₁J fun p hp => (mem_augS_iff ε π₁ p).mp hp
  have hπ₂PJ := hπPJ π₂ hπ₂J fun p hp => by
    rw [ε_π₂ ε π₁ π₂ hπ₁ hπ₂]
    exact (mem_augS_iff ε π₁ p).mp hp
  have hmN : ∀ ι : R →+* S, N.map ι ≤ J → (∀ a ∈ m, ε (π₁ (ι a)) = 0) →
      m * N ≤ (augS ε π₁ * J).comap ι := fun ι hNι hι =>
    Ideal.mul_le.mpr fun a ha b hb => by
      rw [Ideal.mem_comap, map_mul]
      exact Ideal.mul_mem_mul ((mem_augS_iff ε π₁ _).mpr (hι a ha))
        (hNι (Ideal.mem_map_of_mem _ hb))
  have hmNL := hmN (ιL (k := k)) le_sup_left fun a ha => by
    rw [π₁_ιL ε π₁ hπ₁, (hm a).mp ha, map_zero, map_zero]
  have hmNR := hmN (ιR (k := k)) le_sup_right fun a ha => by
    rw [π₁_ιR ε π₁ hπ₁]
    exact (hm a).mp ha
  have hyJ : Δ x - ιL (k := k) x - ιR (k := k) x ∈ J := sub_mem (sub_mem
    (mem_nilIdeal_of_isNilpotent ε ((mem_nilradical.mp hxN).map Δ))
    (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hxN)))
    (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hxN))
  obtain ⟨z1, hz1, z2, hz2, hz⟩ := Submodule.mem_sup.mp hyJ
  obtain ⟨n, hn, hn1⟩ := exists_sub_mem_mul ε π₁ hπ₁ _ (ιL_algebraMap (S := S)) z1 hz1
  obtain ⟨n', hn', hn2⟩ := exists_sub_mem_mul ε π₁ hπ₁ _ (ιR_algebraMap (S := S)) z2 hz2
  have hn1' : z1 - ιL (k := k) n ∈ augS ε π₁ * J := Ideal.mul_mono_right le_sup_left hn1
  have hn2' : z2 - ιR (k := k) n' ∈ augS ε π₁ * J := Ideal.mul_mono_right le_sup_right hn2
  have e1 : n' = -(π₁ (z1 - ιL (k := k) n) + π₁ (z2 - ιR (k := k) n')) := by
    have := congrArg π₁ hz
    simp only [map_add, map_sub, h₁, π₁_ιL ε π₁ hπ₁, π₁_ιR ε π₁ hπ₁, hεN x hxN, hεN n hn,
      map_zero] at this ⊢
    linear_combination this
  have e2 : n = -(π₂ (z1 - ιL (k := k) n) + π₂ (z2 - ιR (k := k) n')) := by
    have := congrArg π₂ hz
    simp only [map_add, map_sub, h₂, π₂_ιL ε π₂ hπ₂, π₂_ιR ε π₂ hπ₂, hεN x hxN, hεN n' hn',
      map_zero] at this ⊢
    linear_combination this
  have hnmN : n ∈ m * N := by
    rw [e2]
    exact neg_mem (add_mem (hπ₂PJ hn1') (hπ₂PJ hn2'))
  have hn'mN : n' ∈ m * N := by
    rw [e1]
    exact neg_mem (add_mem (hπ₁PJ hn1') (hπ₁PJ hn2'))
  rw [← hz, show z1 + z2 = (z1 - ιL (k := k) n) + ιL (k := k) n +
    ((z2 - ιR (k := k) n') + ιR (k := k) n') by ring]
  exact add_mem (add_mem hn1' (hmNL hnmN)) (add_mem hn2' (hmNR hn'mN))

omit [IsLocalization.AtPrime S (counitTensorKer ε)] in
/-- The localization of `R ⊗ R` does not kill `X ⊗ Y` modulo `I₁ ⊗ R + R ⊗ I₂` when `X`, `Y` are
annihilated by `ker ε` modulo `I₁`, `I₂` and survive there. -/
theorem tmul_notMem_map [IsLocalization.AtPrime S (counitTensorKer ε)] (I₁ I₂ : Ideal R)
    (X Y : R) (hX : ∀ a, a * X - algebraMap k R (ε a) * X ∈ I₁)
    (hY : ∀ a, a * Y - algebraMap k R (ε a) * Y ∈ I₂) (hX₁ : X ∉ I₁) (hY₂ : Y ∉ I₂) :
    alg (X ⊗ₜ Y) ∉ (I₁.map (Algebra.TensorProduct.includeLeft : R →ₐ[k] R ⊗[k] R) ⊔
      I₂.map (Algebra.TensorProduct.includeRight : R →ₐ[k] R ⊗[k] R)).map alg := by
  intro h0
  obtain ⟨⟨⟨k0, hk0⟩, ⟨u, hu⟩⟩, he⟩ :=
    (IsLocalization.mem_map_algebraMap_iff (counitTensorKer ε).primeCompl S).mp h0
  simp only at he
  rw [← map_mul] at he
  obtain ⟨⟨v, hv⟩, hv'⟩ := (IsLocalization.eq_iff_exists (counitTensorKer ε).primeCompl S).mp he
  simp only at hv'
  let φ : R ⊗[k] R →ₐ[k] (R ⧸ I₁) ⊗[k] (R ⧸ I₂) :=
    Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k I₁) (Ideal.Quotient.mkₐ k I₂)
  have hφk0 : φ k0 = 0 := by
    have : k0 ∈ RingHom.ker φ := by rw [ker_map_mkₐ]; exact hk0
    exact this
  have hscal : ∀ (I : Ideal R) (y : R), (∀ a, a * y - algebraMap k R (ε a) * y ∈ I) →
      ∀ a, Ideal.Quotient.mk I (a * y) = ε a • Ideal.Quotient.mk I y := by
    intro I y hy a
    rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, ← map_mul, Ideal.Quotient.eq]
    exact hy a
  have hkey : ∀ t, φ t * φ (X ⊗ₜ Y) = counitTensor ε t • φ (X ⊗ₜ Y) := by
    intro t
    induction t using TensorProduct.inductionOn with
    | add a b ha hb => rw [map_add, add_mul, ha, hb, map_add, add_smul]
    | tmul a b =>
      simp only [φ, Algebra.TensorProduct.map_tmul, Ideal.Quotient.mkₐ_eq_mk,
        Algebra.TensorProduct.tmul_mul_tmul, ← map_mul, hscal I₁ X hX, hscal I₂ Y hY,
        Algebra.TensorProduct.lift_tmul]
      rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul', smul_smul, map_mul, mul_comm (ε b),
        TensorProduct.smul_tmul']
  have hc : counitTensor ε (v * u) ≠ 0 := fun h =>
    (mul_mem hv hu : v * u ∈ (counitTensorKer ε).primeCompl) (by
      change v * u ∈ RingHom.ker _
      rw [RingHom.mem_ker]
      exact h)
  have hφw : φ (X ⊗ₜ Y) = 0 := by
    have h1 : φ (v * u) * φ (X ⊗ₜ Y) = 0 := by
      have := congrArg φ hv'
      rw [map_mul, map_mul, map_mul, hφk0, mul_zero] at this
      rw [map_mul]
      linear_combination this
    rw [hkey] at h1
    exact (smul_eq_zero.mp h1).resolve_left hc
  refine tmul_ne_zero_of_ne_zero (k := k) (a := Ideal.Quotient.mk I₁ X)
    (b := Ideal.Quotient.mk I₂ Y) ?_ ?_ ?_
  · rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  · rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  · simpa [φ] using hφw

end Localized

end CounitalComulReduced

open CounitalComulReduced IsLocalRing in
/-- **Local Cartier.** Let `k` be a field of characteristic zero and `R` a local `k`-algebra with
a `k`-algebra map `ε : R → k` (so `R` has residue field `k`). Let `S` be a localization of
`R ⊗[k] R` at the kernel of `ε ⊗ ε`, and `π₁, π₂ : S → R` the localizations of `ε ⊗ id` and
`id ⊗ ε`. If a ring map `Δ : R → S` is counital, `π₁ ∘ Δ = id = π₂ ∘ Δ`, and the nilradical of
`R` is a finitely generated ideal, then the nilradical of `R` is zero. -/
theorem nilradical_eq_bot_of_counital_of_fg [CharZero k] [IsLocalRing R] (ε : R →ₐ[k] k)
    [CommRing S] [Algebra (R ⊗[k] R) S] [IsLocalization.AtPrime S (counitTensorKer ε)]
    (Δ : R →+* S) (π₁ π₂ : S →+* R)
    (hπ₁ : ∀ a b, π₁ (algebraMap (R ⊗[k] R) S (a ⊗ₜ b)) = algebraMap k R (ε a) * b)
    (hπ₂ : ∀ a b, π₂ (algebraMap (R ⊗[k] R) S (a ⊗ₜ b)) = a * algebraMap k R (ε b))
    (h₁ : ∀ r, π₁ (Δ r) = r) (h₂ : ∀ r, π₂ (Δ r) = r)
    (hN : (nilradical R).FG) : nilradical R = ⊥ := by
  classical
  set m := maximalIdeal R with hmdef
  set N := nilradical R with hNdef
  set P := augS ε π₁ with hPdef
  set J := nilIdeal (k := k) (R := R) (S := S) with hJdef
  have hm : ∀ a, a ∈ m ↔ ε a = 0 := fun a => by rw [← RingHom.mem_ker, ker_eq_maximalIdeal ε]
  have hNm : N ≤ m := nilradical_le_prime m
  -- Nakayama: some `x ∈ N` is not in `m * N`
  by_contra hne
  have hNmN : ¬ N ≤ m * N := fun hle => hne <|
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot m N hN
      (by simpa only [smul_eq_mul] using hle) (IsLocalRing.maximalIdeal_le_jacobson ⊥)
  obtain ⟨x, hxN, hxmN⟩ := Set.not_subset.mp hNmN
  -- the least `q` with `x ^ q ∈ m * N ^ q` is at least `2`
  have hex : ∃ n, x ^ n ∈ m * N ^ n := by
    obtain ⟨n, hn⟩ := mem_nilradical.mp hxN
    exact ⟨n, by rw [hn]; exact zero_mem _⟩
  have hp0 : x ^ 0 ∉ m * N ^ 0 := by
    rw [pow_zero, pow_zero, Ideal.one_eq_top, Ideal.mul_top]
    exact fun h => (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hp1 : x ^ 1 ∉ m * N ^ 1 := by rwa [pow_one, pow_one]
  have hq : x ^ Nat.find hex ∈ m * N ^ Nat.find hex := Nat.find_spec hex
  obtain ⟨r, hr⟩ : ∃ r, Nat.find hex = r + 2 := by
    have h0 : Nat.find hex ≠ 0 := fun h => hp0 (h ▸ hq)
    have h1 : Nat.find hex ≠ 1 := fun h => hp1 (h ▸ hq)
    exact ⟨Nat.find hex - 2, by omega⟩
  have hmin : x ^ (r + 1) ∉ m * N ^ (r + 1) := Nat.find_min hex (by omega)
  rw [hr] at hq
  -- `(x ⊗ 1 + 1 ⊗ x) ^ q ∈ P * J ^ q`
  have hy := sub_mem_augS_mul_nilIdeal ε π₁ π₂ hπ₁ hπ₂ Δ h₁ h₂ hxN
  obtain ⟨A, hAdef⟩ : ∃ A, A = ιL (k := k) (S := S) x + ιR (k := k) x := ⟨_, rfl⟩
  have hAJ : A ∈ J := hAdef ▸ add_mem (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hxN))
    (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hxN))
  have hyJ : Δ x - ιL (k := k) x - ιR (k := k) x ∈ J := Ideal.mul_le_right hy
  have hΔq : Δ x ^ (r + 2) ∈ P * J ^ (r + 2) := by
    rw [← map_pow]
    have : m * N ^ (r + 2) ≤ (P * J ^ (r + 2)).comap Δ := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_mul, Ideal.map_pow]
      refine Ideal.mul_mono (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_)
        (Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr fun a ha =>
          mem_nilIdeal_of_isNilpotent ε ((mem_nilradical.mp ha).map Δ)) _)
      change ε (π₁ (Δ a)) = 0
      rw [h₁]
      exact (hm a).mp ha
    exact this hq
  have hdiff : Δ x ^ (r + 2) - A ^ (r + 2) ∈ P * J ^ (r + 2) := by
    have hΔA : Δ x = A + (Δ x - ιL (k := k) x - ιR (k := k) x) := by rw [hAdef]; ring
    rw [hΔA, ← geom_sum₂_mul, add_sub_cancel_left]
    have hsum : ∑ i ∈ Finset.range (r + 2), (A + (Δ x - ιL (k := k) x - ιR (k := k) x)) ^ i *
        A ^ (r + 2 - 1 - i) ∈ J ^ (r + 1) := by
      refine Ideal.sum_mem _ fun i hi => ?_
      have h := Ideal.mul_mem_mul (Ideal.pow_mem_pow (add_mem hAJ hyJ) i)
        (Ideal.pow_mem_pow hAJ (r + 2 - 1 - i))
      rw [← pow_add] at h
      have hi' : i + (r + 2 - 1 - i) = r + 1 := by
        have := Finset.mem_range.mp hi
        omega
      rwa [hi'] at h
    have h := Ideal.mul_mem_mul hsum hy
    rwa [show J ^ (r + 1) * (P * J) = P * J ^ (r + 2) by ring] at h
  have hAq : A ^ (r + 2) ∈ P * J ^ (r + 2) := by
    have := sub_mem hΔq hdiff
    rwa [sub_sub_cancel] at this
  -- pass to the quotient `B = S ⧸ K` killing `m N ^ (q - 1) ⊗ 1` and `1 ⊗ m N`
  set 𝔞 := m * N ^ (r + 1) with h𝔞
  set 𝔟 := m * N with h𝔟
  set K : Ideal S := (𝔞.map (Algebra.TensorProduct.includeLeft : R →ₐ[k] R ⊗[k] R) ⊔
    𝔟.map (Algebra.TensorProduct.includeRight : R →ₐ[k] R ⊗[k] R)).map
      (algebraMap (R ⊗[k] R) S) with hK
  let ρ : S →+* S ⧸ K := Ideal.Quotient.mk K
  let ρ₁ : R →+* S ⧸ K := ρ.comp (ιL (k := k))
  let ρ₂ : R →+* S ⧸ K := ρ.comp (ιR (k := k))
  have hρ𝔞 : ∀ a ∈ 𝔞, ρ₁ a = 0 := fun a ha => Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_map_of_mem _ (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ ha)))
  have hρ𝔟 : ∀ b ∈ 𝔟, ρ₂ b = 0 := fun b hb => Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_map_of_mem _ (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ hb)))
  have hN2 : N ^ 2 ≤ 𝔟 := by
    rw [pow_two]
    exact Ideal.mul_mono_left hNm
  have hNq : N ^ (r + 2) ≤ 𝔞 := by
    rw [pow_succ']
    exact Ideal.mul_mono_left hNm
  have hvan : (P * J ^ (r + 2)).map ρ = ⊥ := by
    rw [Ideal.map_mul, Ideal.map_pow]
    have hPρ : P.map ρ ≤ m.map ρ₁ ⊔ m.map ρ₂ := by
      refine (Ideal.map_mono (maximalIdeal_le ε π₁ hπ₁)).trans ?_
      rw [Ideal.map_sup, Ideal.map_map, Ideal.map_map]
    have hJρ : J.map ρ = N.map ρ₁ ⊔ N.map ρ₂ := by
      rw [hJdef, Ideal.map_sup, Ideal.map_map, Ideal.map_map]
    have hbot : ∀ (ρ' : R →+* S ⧸ K) (I : Ideal R), (∀ a ∈ I, ρ' a = 0) → I.map ρ' = ⊥ :=
      fun ρ' I h => (Ideal.map_eq_bot_iff_le_ker ρ').mpr fun a ha => h a ha
    have hJ2 : (N.map ρ₂) ^ 2 = ⊥ := by
      rw [← Ideal.map_pow]
      exact hbot ρ₂ _ fun b hb => hρ𝔟 b (hN2 hb)
    have hJ1 : (N.map ρ₁) ^ (r + 1 + 1) = ⊥ := by
      rw [← Ideal.map_pow]
      exact hbot ρ₁ _ fun a ha => hρ𝔞 a (hNq ha)
    have e1 : m.map ρ₁ * (N.map ρ₁) ^ (r + 1) = ⊥ := by
      rw [← Ideal.map_pow, ← Ideal.map_mul]
      exact hbot ρ₁ _ hρ𝔞
    have e2 : m.map ρ₂ * N.map ρ₂ = ⊥ := by
      rw [← Ideal.map_mul]
      exact hbot ρ₂ _ hρ𝔟
    rw [hJρ]
    refine le_bot_iff.mp ?_
    calc P.map ρ * (N.map ρ₁ ⊔ N.map ρ₂) ^ (r + 1 + 1)
        ≤ (m.map ρ₁ ⊔ m.map ρ₂) * ((N.map ρ₁) ^ (r + 1 + 1) ⊔
            (N.map ρ₁) ^ (r + 1) * N.map ρ₂ ⊔ (N.map ρ₂) ^ 2) :=
          Ideal.mul_mono hPρ (sup_pow_succ_le _ _ (r + 1))
      _ = m.map ρ₁ * (N.map ρ₁) ^ (r + 1) * N.map ρ₂ ⊔
            (N.map ρ₁) ^ (r + 1) * (m.map ρ₂ * N.map ρ₂) := by
          rw [hJ1, hJ2, bot_sup_eq, sup_bot_eq, Ideal.sup_mul]
          congr 1 <;> ring
      _ = ⊥ := by rw [e1, e2]; simp
  have hρA : ρ (A ^ (r + 2)) = 0 := by
    have := Ideal.mem_map_of_mem ρ hAq
    rwa [hvan, Ideal.mem_bot] at this
  -- in `B`, `(x ⊗ 1 + 1 ⊗ x) ^ q = q • x ^ (q - 1) ⊗ x`
  have hfin : (((r + 1 : ℕ) : S ⧸ K) + 1) * (ρ₁ x ^ (r + 1) * ρ₂ x) = 0 := by
    have hsq : ρ₂ x ^ 2 = 0 := by
      rw [← map_pow]
      exact hρ𝔟 _ (hN2 (Ideal.pow_mem_pow hxN 2))
    have hpow : ρ₁ x ^ (r + 1 + 1) = 0 := by
      rw [← map_pow]
      exact hρ𝔞 _ (hNq (Ideal.pow_mem_pow hxN _))
    have h := add_pow_succ_of_sq_eq_zero (ρ₁ x) (ρ₂ x) hsq (r + 1)
    rw [hpow, zero_add] at h
    have hA : ρ A = ρ₁ x + ρ₂ x := by rw [hAdef]; exact map_add ρ _ _
    rw [map_pow, hA, h] at hρA
    rw [← hρA]
    ring
  -- and `x ^ (q - 1) ⊗ x` is nonzero in `B`
  have hw : ρ₁ x ^ (r + 1) * ρ₂ x ≠ 0 := by
    intro h0
    have hann : ∀ (I : Ideal R) (y : R), y ∈ I → ∀ a,
        a * y - algebraMap k R (ε a) * y ∈ m * I := fun I y hy a => by
      rw [← sub_mul]
      refine Ideal.mul_mem_mul ?_ hy
      rw [hmdef, ← ker_eq_maximalIdeal ε]
      exact sub_algebraMap_mem_ker ε a
    apply tmul_notMem_map (S := S) ε 𝔞 𝔟 (x ^ (r + 1)) x
      (hann _ _ (Ideal.pow_mem_pow hxN _)) (hann _ _ hxN) hmin hxmN
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← ιL_mul_ιR, map_mul, map_pow]
    exact h0
  -- `q` is invertible in `k`, a contradiction
  let γ : k →+* S ⧸ K := ρ.comp (κ (R := R))
  have hc : (((r + 1 : ℕ) : k) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero (r + 1)
  have hγ : γ (((r + 1 : ℕ) : k) + 1) = ((r + 1 : ℕ) : S ⧸ K) + 1 := by simp
  apply hw
  have := congrArg (γ (((r + 1 : ℕ) : k) + 1)⁻¹ * ·) hfin
  simp only [mul_zero] at this
  rw [← this, ← hγ, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hc, map_one, one_mul]

end
