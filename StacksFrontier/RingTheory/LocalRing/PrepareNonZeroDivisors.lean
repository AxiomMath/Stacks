/-!
# Preparing two nonzerodivisors in a one-dimensional Noetherian local ring

Over a one-dimensional Noetherian local ring `R`, two nonzerodivisors `a` and `b` become `t * a'`
and `t * b'` with `a'` and `b'` comaximal, after a finite ring extension whose quotient by `R` is
annihilated by a power of the maximal ideal. This is
[Stacks, Tag 02Q7](https://stacks.math.columbia.edu/tag/02Q7), named by the predicate
`AlgebraicGeometry.FiniteExtensionPreparingTwoNonzerodivisors`.

This file proves everything in that statement except one geometric assertion, which it names:
`Stacks.PrepareNonZeroDivisors.InvertibleSpanPairAfterFiniteExtension` asks for a finite extension
in which the ideal generated by the two elements becomes *invertible*. Granting it, the full
statement follows, by `finiteExtensionPreparingTwoNonzerodivisors_of_invertibleSpanPair`.

## Main definitions

* `Stacks.PrepareNonZeroDivisors.InvertibleSpanPairAfterFiniteExtension` is the geometric input: a
  finite extension, with quotient annihilated by a power of the maximal ideal, in which the ideal
  generated by the two elements is invertible.

## Main results

* `Stacks.PrepareNonZeroDivisors.finiteExtensionPreparingTwoNonzerodivisors_of_invertibleSpanPair`
  derives `AlgebraicGeometry.FiniteExtensionPreparingTwoNonzerodivisors` from that input.
* `Stacks.PrepareNonZeroDivisors.exists_isRegular_span_singleton_eq_of_invertible` is the
  semilocal step: an invertible ideal of a ring with finitely many maximal ideals is generated by
  one regular element.
* `Stacks.PrepareNonZeroDivisors.exists_factorization_of_span_pair_eq_span_singleton` divides the
  common generator out of the pair, the cofactors being regular and comaximal.
* `Stacks.PrepareNonZeroDivisors.eq_maximalIdeal_of_isPrime_of_mem_nonZeroDivisors`: in dimension
  one, a prime containing a nonzerodivisor is the maximal ideal.
* `Stacks.PrepareNonZeroDivisors.exists_maximalIdeal_pow_le_annihilator_of_support_subset`: a
  finite module supported at the closed point is annihilated by a power of the maximal ideal.

## Implementation notes

Invertibility of the ideal is taken in the sense of `Module.Invertible`, that is, invertibility of
the class in the Picard group of the extension. Mathlib's
`Ideal.IsPrincipal.of_finite_maximals_of_isUnit` proves the same conclusion from invertibility as a
fractional ideal of `FractionRing R`, which is a different hypothesis over a ring that is not a
domain, so it is not used here.

The extension is presented as an injective algebra map with the target finite as a module, and the
quotient condition as a power of the maximal ideal annihilating the quotient by the range of the
algebra map: that is the form the predicate being proved uses.

## References

* [Stacks Project, Tag 02Q7](https://stacks.math.columbia.edu/tag/02Q7)
* [Stacks Project, Tag 02M9](https://stacks.math.columbia.edu/tag/02M9)
-/

@[expose] public section

open IsLocalRing

universe u

namespace Stacks.PrepareNonZeroDivisors

/-- In a one-dimensional Noetherian local ring, a prime ideal containing a nonzerodivisor is the
maximal ideal: a strictly smaller prime would have height zero, hence be a minimal prime, and
minimal primes are disjoint from the nonzerodivisors. -/
theorem eq_maximalIdeal_of_isPrime_of_mem_nonZeroDivisors
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (hdim : ringKrullDim R = 1) {a : R} (ha : a ∈ nonZeroDivisors R)
    (p : Ideal R) (hp : p.IsPrime) (hpa : a ∈ p) :
    p = maximalIdeal R := by
  let _ : p.IsPrime := hp
  let _ : (maximalIdeal R).IsPrime := (maximalIdeal.isMaximal R).isPrime
  by_contra hpmax
  have hpm : p ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal hp.ne_top
  have hmh : (maximalIdeal R).height = 1 := by
    exact_mod_cast IsLocalRing.maximalIdeal_height_eq_ringKrullDim.trans hdim
  have hstep := Ideal.height_add_one_le_of_lt_of_isPrime (lt_of_le_of_ne hpm hpmax)
  rw [hmh] at hstep
  have hpfin : p.height ≠ ⊤ :=
    ne_top_of_le_ne_top (by rw [hmh]; simp) (Ideal.height_mono hpm)
  have hpzero : p.height = 0 :=
    Order.lt_one_iff.mp ((ENat.add_one_le_iff hpfin).mp hstep)
  exact (Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes
    (Ideal.height_eq_zero_iff.mp hpzero))) hpa ha

/-- In a one-dimensional Noetherian local ring, the vanishing locus of an ideal generated by a
nonzerodivisor and a second nonunit is the closed point. -/
theorem zeroLocus_span_pair_eq_closedPoint
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (hdim : ringKrullDim R = 1) {a b : R} (ha : a ∈ nonZeroDivisors R)
    (hna : ¬ IsUnit a) (hnb : ¬ IsUnit b) :
    PrimeSpectrum.zeroLocus (Ideal.span ({a, b} : Set R)) = {closedPoint R} := by
  have ham : a ∈ maximalIdeal R := mem_maximalIdeal a |>.mpr (mem_nonunits_iff.mpr hna)
  have hbm : b ∈ maximalIdeal R := mem_maximalIdeal b |>.mpr (mem_nonunits_iff.mpr hnb)
  ext x
  rw [PrimeSpectrum.mem_zeroLocus, Set.mem_singleton_iff]
  refine ⟨fun hx => PrimeSpectrum.ext (eq_maximalIdeal_of_isPrime_of_mem_nonZeroDivisors hdim ha
    x.asIdeal x.isPrime (hx (Ideal.subset_span (by simp)))), fun hx => ?_⟩
  subst x
  exact Ideal.span_le.mpr (Set.pair_subset ham hbm)

/-- A finite module over a Noetherian local ring whose support is contained in the closed point
has its annihilator's radical equal to the maximal ideal, unless the annihilator is everything. -/
theorem radical_annihilator_eq_maximalIdeal_of_support_subset
    {R M : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hSupp : Module.support R M ⊆ {closedPoint R})
    (hA : Module.annihilator R M ≠ ⊤) :
    (Module.annihilator R M).radical = maximalIdeal R := by
  have hprimes : {P : Ideal R | Module.annihilator R M ≤ P ∧ P.IsPrime} = {maximalIdeal R} := by
    ext P
    simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff]
    refine ⟨fun ⟨hAP, hP⟩ => ?_, fun hP => ?_⟩
    · have hp : (⟨P, hP⟩ : PrimeSpectrum R) ∈ Module.support R M := by
        rw [Module.support_eq_zeroLocus, PrimeSpectrum.mem_zeroLocus]
        exact hAP
      simpa [closedPoint] using congrArg PrimeSpectrum.asIdeal (hSupp hp)
    · exact hP ▸ ⟨IsLocalRing.le_maximalIdeal hA, (maximalIdeal.isMaximal R).isPrime⟩
  rw [Ideal.radical_eq_sInf, hprimes, sInf_singleton]

/-- A finite module over a Noetherian local ring supported at the closed point is annihilated by
a power of the maximal ideal. -/
@[sga "6 IX 1.1" "special case"]
theorem exists_maximalIdeal_pow_le_annihilator_of_support_subset
    {R M : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hSupp : Module.support R M ⊆ {closedPoint R}) :
    ∃ n : ℕ, maximalIdeal R ^ n ≤ Module.annihilator R M := by
  by_cases htop : Module.annihilator R M = ⊤
  · exact ⟨0, by simp [htop]⟩
  · have hrad := radical_annihilator_eq_maximalIdeal_of_support_subset hSupp htop
    obtain ⟨n, hn⟩ := (Module.annihilator R M).exists_radical_pow_le_of_fg
      (by rw [hrad]; exact IsNoetherian.noetherian _)
    exact ⟨n, by simpa [hrad] using hn⟩

/-- An algebra finite as a module over a local ring has finitely many maximal ideals: each lies
over the maximal ideal of the base, and a quasi-finite algebra has finitely many primes over a
given one. -/
theorem finite_maximalSpectrum_of_moduleFinite
    {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [Algebra A B] [Module.Finite A B] :
    Finite (MaximalSpectrum B) := by
  have := (Algebra.QuasiFinite.finite_primesOver (S := B) (maximalIdeal A)).to_subtype
  exact Finite.of_injective
    (fun q : MaximalSpectrum B => (⟨q.asIdeal, q.isMaximal.isPrime,
      ⟨(IsLocalRing.eq_maximalIdeal (inferInstance : (q.asIdeal.under A).IsMaximal)).symm⟩⟩ :
        (maximalIdeal A).primesOver B))
    fun q q' h => MaximalSpectrum.ext (congrArg Subtype.val h)

/-- **Stacks Project, Tag 02M9** in the rank-one case. An invertible ideal of a commutative ring
with finitely many maximal ideals is generated by a single regular element. Invertibility is taken
in the Picard-group sense, `Module.Invertible`. -/
theorem exists_isRegular_span_singleton_eq_of_invertible
    {S : Type*} [CommRing S] [Finite (MaximalSpectrum S)]
    (I : Ideal S) [Module.Invertible S I] :
    ∃ t : S, IsRegular t ∧ I = Ideal.span ({t} : Set S) := by
  obtain ⟨e⟩ := (Module.Invertible.free_iff_linearEquiv (R := S) (M := I)).mp inferInstance
  refine ⟨(e.symm 1 : S), ?_, ?_⟩
  · have hleft : ∀ x y : S, (e.symm 1 : S) * x = (e.symm 1 : S) * y → x = y := by
      intro x y hxy
      have hsub : (x • e.symm 1 : I) = y • e.symm 1 := by
        apply Subtype.ext
        simpa [mul_comm] using hxy
      simpa using congrArg e hsub
    exact ⟨hleft, fun x y h => hleft x y (by simpa [mul_comm] using h)⟩
  · refine le_antisymm (fun x hx => ?_) (Ideal.span_le.mpr fun x hx => ?_)
    · refine Ideal.mem_span_singleton.mpr ⟨e ⟨x, hx⟩, ?_⟩
      have hy : (⟨x, hx⟩ : I) = (e ⟨x, hx⟩) • e.symm 1 := by
        apply e.injective
        simp
      simpa [smul_eq_mul, mul_comm] using congrArg (fun z : I => (z : S)) hy
    · exact (by simpa using hx : x = (e.symm 1 : S)) ▸ (e.symm 1).2

/-- Dividing the common generator out of a pair. If `a` and `b` are regular and together generate
the same ideal as a single element `t`, then `t` is regular, `a = t * a'` and `b = t * b'` with
`a'` and `b'` regular and comaximal. -/
theorem exists_factorization_of_span_pair_eq_span_singleton
    {S : Type*} [CommRing S] {a b t : S} (ha : IsRegular a) (hb : IsRegular b)
    (hI : Ideal.span ({a, b} : Set S) = Ideal.span ({t} : Set S)) :
    ∃ a' b' : S, IsRegular t ∧ IsRegular a' ∧ IsRegular b' ∧
      a = t * a' ∧ b = t * b' ∧ Ideal.span ({a', b'} : Set S) = ⊤ := by
  obtain ⟨a', hta⟩ : t ∣ a := Ideal.mem_span_singleton.mp (hI ▸ Ideal.subset_span (by simp))
  obtain ⟨b', htb⟩ : t ∣ b := Ideal.mem_span_singleton.mp (hI ▸ Ideal.subset_span (by simp))
  have hta' : IsRegular t ∧ IsRegular a' := isRegular_mul_iff.mp (hta ▸ ha)
  have htb' : IsRegular b' := (isRegular_mul_iff.mp (htb ▸ hb)).2
  obtain ⟨x, y, hxy⟩ := Ideal.mem_span_pair.mp
    (hI ▸ Ideal.mem_span_singleton.mpr dvd_rfl : t ∈ Ideal.span ({a, b} : Set S))
  refine ⟨a', b', hta'.1, hta'.2, htb', hta, htb, (Ideal.eq_top_iff_one _).mpr
    (Ideal.mem_span_pair.mpr ⟨x, y, hta'.1.left ?_⟩)⟩
  calc t * (x * a' + y * b') = x * (t * a') + y * (t * b') := by ring
    _ = x * a + y * b := by rw [← hta, ← htb]
    _ = t * 1 := by rw [hxy, mul_one]

/-- If the images of `a` and `b` generate a principal ideal with regular generator in an algebra
over a one-dimensional Noetherian local ring, and both are nonunits with `a` a nonzerodivisor,
then the image of `a` is regular. A zerodivisor image would lie in an associated prime of the
extension, which would then contract to the maximal ideal, hence contain both images, hence contain
the regular generator. -/
theorem isRegular_algebraMap_of_span_pair_eq_span_singleton
    {R S : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [CommRing S] [Algebra R S] [IsNoetherianRing S]
    (hdim : ringKrullDim R = 1) {a b : R}
    (ha : a ∈ nonZeroDivisors R) (hnb : ¬ IsUnit b) {t : S} (ht : IsRegular t)
    (hI : Ideal.span ({algebraMap R S a, algebraMap R S b} : Set S) =
      Ideal.span ({t} : Set S)) :
    IsRegular (algebraMap R S a) := by
  rw [isRegular_iff_mem_nonZeroDivisors]
  by_contra hreg
  have hzero : algebraMap R S a ∈ (nonZeroDivisors S : Set S)ᶜ := by simpa using hreg
  rw [← biUnion_associatedPrimes_eq_compl_nonZeroDivisors] at hzero
  obtain ⟨P, hP, hPa⟩ := Set.mem_iUnion₂.mp hzero
  have hPprime : P.IsPrime := (AssociatedPrimes.mem_iff.mp hP).isPrime
  have hpmax : P.comap (algebraMap R S) = maximalIdeal R :=
    eq_maximalIdeal_of_isPrime_of_mem_nonZeroDivisors hdim ha _
      (Ideal.IsPrime.comap (f := algebraMap R S)) (Ideal.mem_comap.mpr hPa)
  have hpb : algebraMap R S b ∈ P := by
    have hb : b ∈ P.comap (algebraMap R S) := by
      rw [hpmax]; exact mem_maximalIdeal b |>.mpr (mem_nonunits_iff.mpr hnb)
    simpa only [Ideal.mem_comap] using hb
  have htP : t ∈ P := (hI ▸ Ideal.span_le.mpr (Set.pair_subset hPa hpb) :
    Ideal.span ({t} : Set S) ≤ P) (Ideal.mem_span_singleton_self t)
  have htc : t ∈ (nonZeroDivisors S : Set S)ᶜ := by
    rw [← biUnion_associatedPrimes_eq_compl_nonZeroDivisors]
    exact Set.mem_iUnion₂.mpr ⟨P, hP, htP⟩
  exact htc (isRegular_iff_mem_nonZeroDivisors.mp ht)

/-- **The geometric input of Tag 02Q7.** Over a one-dimensional Noetherian local ring, two
nonzerodivisors which are not units generate, in some finite ring extension whose quotient by the
base is annihilated by a power of the maximal ideal, an *invertible* ideal.

In the Stacks proof this is the blowup of `Spec R` in the ideal they generate: it is proper,
its generic points all lie over the punctured spectrum, hence it is finite, hence affine, and the
ideal it pulls back to is locally principal. -/
def InvertibleSpanPairAfterFiniteExtension : Prop :=
  ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R],
    ringKrullDim R = 1 → ∀ a b : R, a ∈ nonZeroDivisors R → b ∈ nonZeroDivisors R →
      ¬ IsUnit a → ¬ IsUnit b →
      ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S) (_ : Module.Finite R S),
        Function.Injective (algebraMap R S) ∧
        (∃ n : ℕ, maximalIdeal R ^ n ≤
          Module.annihilator R (S ⧸ (Algebra.linearMap R S).range)) ∧
        Module.Invertible S (Ideal.span
          ({algebraMap R S a, algebraMap R S b} : Set S))

/-- **Stacks Project, Tag 02Q7**, granted its geometric input. Over a one-dimensional Noetherian
local ring, two nonzerodivisors acquire a common nonzerodivisor factor with comaximal cofactors in
a finite ring extension whose quotient by the base is annihilated by a power of the maximal ideal.

If either element is a unit the base itself works. Otherwise the input supplies an extension in
which the ideal they generate is invertible; it is then principal with a regular generator, by
`exists_isRegular_span_singleton_eq_of_invertible`, and dividing that generator out finishes. -/
theorem finiteExtensionPreparingTwoNonzerodivisors_of_invertibleSpanPair
    (h : InvertibleSpanPairAfterFiniteExtension.{u}) :
    AlgebraicGeometry.FiniteExtensionPreparingTwoNonzerodivisors.{u} := by
  intro R _ _ _ hdim a b ha hb
  by_cases hab : IsUnit a ∨ IsUnit b
  · -- One of the two is a unit: the base itself works, with `t = 1`.
    refine ⟨R, inferInstance, inferInstance, inferInstance, Function.injective_id,
      ⟨0, le_of_eq ?_⟩, 1, a, b, one_mem _, ha, hb, (one_mul a).symm, (one_mul b).symm, ?_⟩
    · have : Subsingleton (R ⧸ (Algebra.linearMap R R).range) := by
        refine ⟨fun x y => ?_⟩
        obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
        obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
        rw [Submodule.Quotient.eq]
        exact ⟨x - y, by simp⟩
      simpa using (Module.annihilator_eq_top_iff (R := R)
        (M := R ⧸ (Algebra.linearMap R R).range)).mpr inferInstance |>.symm
    · rcases hab with hu | hu <;>
        exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (by simp)) hu
  · push Not at hab
    obtain ⟨S, _, _, _, hinj, hann, _⟩ := h R hdim a b ha hb hab.1 hab.2
    have : IsNoetherianRing S := IsNoetherianRing.of_finite R S
    have : Finite (MaximalSpectrum S) := finite_maximalSpectrum_of_moduleFinite (A := R) (B := S)
    obtain ⟨t, ht, hspan⟩ := exists_isRegular_span_singleton_eq_of_invertible
      (Ideal.span ({algebraMap R S a, algebraMap R S b} : Set S))
    have haS : IsRegular (algebraMap R S a) :=
      isRegular_algebraMap_of_span_pair_eq_span_singleton hdim ha hab.2 ht hspan
    have hbS : IsRegular (algebraMap R S b) :=
      isRegular_algebraMap_of_span_pair_eq_span_singleton hdim hb hab.1 ht (by rwa [Set.pair_comm])
    obtain ⟨a', b', _, ha', hb', hta, htb, hcomax⟩ :=
      exists_factorization_of_span_pair_eq_span_singleton haS hbS hspan
    exact ⟨S, inferInstance, inferInstance, inferInstance, hinj, hann, t, a', b',
      isRegular_iff_mem_nonZeroDivisors.mp ht, isRegular_iff_mem_nonZeroDivisors.mp ha',
      isRegular_iff_mem_nonZeroDivisors.mp hb', hta, htb, hcomax⟩

end Stacks.PrepareNonZeroDivisors

end
