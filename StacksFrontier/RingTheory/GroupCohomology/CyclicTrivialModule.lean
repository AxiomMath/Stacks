module

public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.RepresentationTheory.Homological.GroupCohomology.FiniteCyclic
import StacksCore.Tactic.EgaSgaAttribute

@[expose] public section

universe u

/-!
# Cohomology of a finite cyclic group acting trivially on a module killed by the group order

Let `k` be a commutative ring, let `G` be a finite cyclic group generated by `g`, and let `A` be a
`k`-linear representation of `G` on which `G` acts trivially. The periodic resolution of the
trivial representation computes `H^n(G, A)` as the homology of
`A --N--> A --(ρ(g) - 1)--> A` in even positive degrees and of `A --(ρ(g) - 1)--> A --N--> A` in
odd degrees, where `N` is the norm. A trivial action makes `ρ(g) - 1` the zero map, and when the
order of `G` vanishes in `k` the norm `N = |G| • id` is zero as well. Both maps of both short
complexes therefore vanish, so every homology group is the middle term `A` itself, and the
degree zero group is the kernel of `ρ(g) - 1`, which is all of `A`.

The upshot is one isomorphism `H^n(G, A) ≅ A` valid in *every* degree `n ≥ 0`. For
`G = ℤ/pℤ` with `p` prime and `k` of characteristic `p` the hypothesis `(|G| : k) = 0` is
automatic, which is the computation the Stacks Project defers in its discussion of the derived
pushforward of quasi-coherent modules on `[Spec k[x] / (ℤ/pℤ)]` (Tag 07DC): there the text says
"the cohomology of the cyclic group `G` on `k[x]` is exactly one copy of `k[x]` in each
cohomological degree `≥ 0`" and marks the justification as an unwritten future reference.

## Main results

* `Stacks.GroupCohomology.TrivialCyclic.cohomologyIso`: for a finite cyclic `G` generated by `g`
  acting trivially on `A`, with `(Fintype.card G : k) = 0`, an isomorphism
  `H^n(G, A) ≅ A` of `k`-modules for every `n : ℕ`.
* `Stacks.GroupCohomology.TrivialCyclic.cohomologyIsoOfCharP`: the same isomorphism when `k` has
  characteristic `p` and `G` has order `p`.
* `Stacks.GroupCohomology.TrivialCyclic.zmodCohomologyIso`: the isomorphism
  `H^n(ℤ/pℤ, M) ≅ M` for a trivial module `M` over a ring of characteristic `p`, with `ℤ/pℤ`
  spelled out as `Multiplicative (ULift (ZMod p))`.
* `Stacks.GroupCohomology.TrivialCyclic.polynomialCohomologyIso` and
  `Stacks.GroupCohomology.TrivialCyclic.nontrivial_polynomialCohomology`: the case `M = k[x]`
  used by the Stacks Project, together with the fact that these cohomology modules are nonzero,
  so the computation is not vacuous.

## Implementation notes

The three degree ranges are assembled into a single degree-indexed isomorphism by a decidable
case split on `n = 0` and `Even n`; a case split on `Nat.even_or_odd` is unavailable because the
isomorphism is data and that disjunction is a proposition.

Mathlib's `groupCohomology` forces the coefficient ring, the group and the underlying module of
the representation into one universe, so `k`, `G` and `M` all live in `Type u` here. The `ℤ/pℤ`
statements use `Multiplicative (ULift (ZMod p))` rather than `Multiplicative (ZMod p)` precisely
so that `k` and `M` may be taken in an arbitrary universe.

`groupCohomology A n` is by definition the `n`-th homology of `inhomogeneousCochains A`, the
complex `A → Map(G, A) → Map(G², A) → ⋯` with the usual alternating differential. That is
verbatim the complex the Stacks Project writes down for `RΓ(𝒳, 𝒪_𝒳)` on the quotient stack, so
the isomorphisms below are statements about exactly that complex and not about some other model
of group cohomology.

## References

* [Stacks Project, Tag 07DC](https://stacks.math.columbia.edu/tag/07DC)
-/

open CategoryTheory

namespace Stacks.GroupCohomology.TrivialCyclic

section Cyclic

variable {k G : Type u} [CommRing k] [CommGroup G] [Fintype G] (A : Rep k G) [A.IsTrivial]
  (g : G)

omit [Fintype G] in
/-- A group acting trivially acts through the identity: `ρ(g) - 1 = 0`. -/
theorem applyAsHom_sub_id_eq_zero : A.applyAsHom g - 𝟙 A = 0 := by
  ext x
  simp [Rep.sub_hom, Rep.applyAsHom_apply, Representation.isTrivial_apply]

omit [Fintype G] in
/-- For a trivial action the kernel of `ρ(g) - 1` is the whole module. -/
theorem ker_applyAsHom_sub_id_eq_top :
    LinearMap.ker (A.applyAsHom g - 𝟙 A).hom.toLinearMap = ⊤ := by
  rw [applyAsHom_sub_id_eq_zero]
  exact LinearMap.ker_zero

/-- For a trivial action the norm map is multiplication by `|G|`, hence zero as soon as the order
of `G` vanishes in `k`. -/
theorem norm_apply_eq_zero (hcard : (Fintype.card G : k) = 0) (x : A) : A.ρ.norm x = 0 := by
  rw [Representation.norm, LinearMap.sum_apply]
  simp only [Representation.isTrivial_apply, Finset.sum_const, Finset.card_univ]
  rw [← Nat.cast_smul_eq_nsmul k, hcard, zero_smul]

/-- The first map of `A --N--> A --(ρ(g) - 1)--> A` vanishes. -/
theorem normHomCompSub_f_eq_zero (hcard : (Fintype.card G : k) = 0) :
    (Rep.FiniteCyclicGroup.normHomCompSub A g).f = 0 := by
  ext x
  exact norm_apply_eq_zero A hcard x

/-- The second map of `A --N--> A --(ρ(g) - 1)--> A` vanishes. -/
theorem normHomCompSub_g_eq_zero : (Rep.FiniteCyclicGroup.normHomCompSub A g).g = 0 := by
  ext x
  change (A.applyAsHom g - 𝟙 A).hom x = 0
  rw [applyAsHom_sub_id_eq_zero]
  rfl

/-- The first map of `A --(ρ(g) - 1)--> A --N--> A` vanishes. -/
theorem subCompNormHom_f_eq_zero : (Rep.FiniteCyclicGroup.subCompNormHom A g).f = 0 := by
  ext x
  change (A.applyAsHom g - 𝟙 A).hom x = 0
  rw [applyAsHom_sub_id_eq_zero]
  rfl

/-- The second map of `A --(ρ(g) - 1)--> A --N--> A` vanishes. -/
theorem subCompNormHom_g_eq_zero (hcard : (Fintype.card G : k) = 0) :
    (Rep.FiniteCyclicGroup.subCompNormHom A g).g = 0 := by
  ext x
  exact norm_apply_eq_zero A hcard x

variable (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- `H⁰(G, A) ≅ A` for a trivial action: the invariants are everything. -/
noncomputable def cohomologyIsoOfZero : groupCohomology A 0 ≅ ModuleCat.of k A.V :=
  Rep.FiniteCyclicGroup.groupCohomologyIso₀ A g hg ≪≫
    ((LinearEquiv.ofEq _ ⊤ (ker_applyAsHom_sub_id_eq_top A g)).trans
      Submodule.topEquiv).toModuleIso

/-- `Hⁿ(G, A) ≅ A` for a trivial action and `n` positive and even: both maps of the periodic
short complex `A --N--> A --(ρ(g) - 1)--> A` are zero, so its homology is the middle term. -/
noncomputable def cohomologyIsoOfEven (hcard : (Fintype.card G : k) = 0) (n : ℕ) [NeZero n]
    (hn : Even n) : groupCohomology A n ≅ ModuleCat.of k A.V :=
  Rep.FiniteCyclicGroup.groupCohomologyIsoEven A g hg n hn ≪≫
    (ShortComplex.LeftHomologyData.ofZeros _ (normHomCompSub_f_eq_zero A g hcard)
      (normHomCompSub_g_eq_zero A g)).homologyIso

/-- `Hⁿ(G, A) ≅ A` for a trivial action and `n` odd: both maps of the periodic short complex
`A --(ρ(g) - 1)--> A --N--> A` are zero, so its homology is the middle term. -/
noncomputable def cohomologyIsoOfOdd (hcard : (Fintype.card G : k) = 0) (n : ℕ) (hn : Odd n) :
    groupCohomology A n ≅ ModuleCat.of k A.V :=
  Rep.FiniteCyclicGroup.groupCohomologyIsoOdd A g hg n hn ≪≫
    (ShortComplex.LeftHomologyData.ofZeros _ (subCompNormHom_f_eq_zero A g)
      (subCompNormHom_g_eq_zero A g hcard)).homologyIso

/-- Let `G` be a finite cyclic group generated by `g` whose order vanishes in `k`, acting
trivially on a `k`-linear representation `A`. Then `Hⁿ(G, A) ≅ A` in every degree `n ≥ 0`. -/
@[sga "5 I 1.2" "partial"]
noncomputable def cohomologyIso (hcard : (Fintype.card G : k) = 0) (n : ℕ) :
    groupCohomology A n ≅ ModuleCat.of k A.V :=
  if hn : n = 0 then
    eqToIso (congrArg (groupCohomology A) hn) ≪≫ cohomologyIsoOfZero A g hg
  else if he : Even n then
    have : NeZero n := ⟨hn⟩
    cohomologyIsoOfEven A g hg hcard n he
  else
    cohomologyIsoOfOdd A g hg hcard n (Nat.not_even_iff_odd.mp he)

/-- Let `k` have characteristic `p`, let `G` be cyclic of order `p` generated by `g`, and let `G`
act trivially on `A`. Then `Hⁿ(G, A) ≅ A` in every degree `n ≥ 0`. -/
@[sga "5 I 1.2" "partial"]
noncomputable def cohomologyIsoOfCharP (p : ℕ) [CharP k p] (hp : Fintype.card G = p) (n : ℕ) :
    groupCohomology A n ≅ ModuleCat.of k A.V :=
  cohomologyIso A g hg (by rw [hp]; exact CharP.cast_eq_zero k p) n

end Cyclic

section ZMod

variable (p : ℕ) [NeZero p]

/-- `ℤ/pℤ`, written multiplicatively and lifted to an arbitrary universe, has order `p`. -/
theorem card_multiplicativeULiftZMod :
    Fintype.card (Multiplicative (ULift.{u} (ZMod p))) = p := by
  simp

/-- `ℤ/pℤ`, written multiplicatively and lifted to an arbitrary universe, is generated by the
image of `1`. -/
theorem mem_zpowers_ofAdd_up_one (x : Multiplicative (ULift.{u} (ZMod p))) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (ULift.up.{u} (1 : ZMod p))) := by
  refine ⟨((Multiplicative.toAdd x).down.val : ℤ), ?_⟩
  simp only [← ofAdd_zsmul]
  apply Multiplicative.toAdd.injective
  refine ULift.ext ?_
  change ((Multiplicative.toAdd x).down.val : ℤ) • (1 : ZMod p) = (Multiplicative.toAdd x).down
  simp [zsmul_eq_mul, ZMod.natCast_val, ZMod.cast_id]

variable (k : Type u) [CommRing k] [CharP k p] (M : Type u) [AddCommGroup M] [Module k M]

/-- **The cohomology of `ℤ/pℤ` on a trivial module in characteristic `p`.** For a commutative
ring `k` of characteristic `p` and any `k`-module `M` regarded as a trivial `ℤ/pℤ`-module,
`Hⁿ(ℤ/pℤ, M) ≅ M` in every degree `n ≥ 0`. -/
noncomputable def zmodCohomologyIso (n : ℕ) :
    groupCohomology (Rep.trivial k (Multiplicative (ULift.{u} (ZMod p))) M) n ≅
      ModuleCat.of k M :=
  cohomologyIsoOfCharP _ (Multiplicative.ofAdd (ULift.up.{u} (1 : ZMod p)))
    (mem_zpowers_ofAdd_up_one p) p (card_multiplicativeULiftZMod p) n

/-- The Stacks Project's instance of the computation: for `k` of characteristic `p`,
`Hⁿ(ℤ/pℤ, k[x]) ≅ k[x]` in every degree `n ≥ 0`, where `ℤ/pℤ` acts trivially on `k[x]`. -/
noncomputable def polynomialCohomologyIso (n : ℕ) :
    groupCohomology (Rep.trivial k (Multiplicative (ULift.{u} (ZMod p))) (Polynomial k)) n ≅
      ModuleCat.of k (Polynomial k) :=
  zmodCohomologyIso p k (Polynomial k) n

/-- The computation is not vacuous: when `k` is nontrivial, every one of the cohomology modules
`Hⁿ(ℤ/pℤ, k[x])` is nonzero. -/
theorem nontrivial_polynomialCohomology [Nontrivial k] (n : ℕ) :
    Nontrivial
      (groupCohomology (Rep.trivial k (Multiplicative (ULift.{u} (ZMod p))) (Polynomial k)) n) :=
  (polynomialCohomologyIso p k n).toLinearEquiv.toEquiv.nontrivial

end ZMod

end Stacks.GroupCohomology.TrivialCyclic

end
