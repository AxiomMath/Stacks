module

public import StacksFrontier.RingTheory.CohenMacaulay.RegularSequence
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A regular sequence inside the maximal ideal of the source (Stacks 06LC)

Stacks 06LC produces, from a ring homomorphism `φ : A →+* B` into a Noetherian Cohen–Macaulay
local ring whose maximal ideal is the radical of the ideal generated by `φ(m_A)`, a list `f` of
elements of `A` of length `dim B` whose images form a regular sequence in `B`.

Every geometric consumer of it needs in addition that the chosen elements lie in `m_A`: the
elements are used as equations cutting out a slice through the point of the source that `A` is
the local ring of, and the slice contains that point exactly when the equations vanish there.
This file records that strengthening.

## Main results

* `Stacks.CohenMacaulay.exists_isRegular_map_mem_maximalIdeal_length_eq_ringKrullDim`:
  **Stacks 06LC with the elements located in `m_A`.**

## Implementation notes

Nothing is added to the proof of Stacks 06LC: the membership is a consequence of the statement
it already has.  A regular sequence on `B` as a module over itself generates a proper ideal of
`B` (`RingTheory.Sequence.IsRegular.top_ne_smul`, which for `M = B` says
`Ideal.ofList (f.map φ) ≠ ⊤`), hence an ideal contained in `m_B`
(`IsLocalRing.le_maximalIdeal`); so each `φ fᵢ` is a non-unit, and `A` being local that forces
`fᵢ ∈ m_A`, since a unit of `A` has a unit image.  No locality of `φ` is used, and none is
available: the hypothesis of Stacks 06LC is the radical equation, not `φ(m_A) ⊆ m_B`.

## References

* [Stacks Project, Tag 06LC](https://stacks.math.columbia.edu/tag/06LC)
-/

@[expose] public section

namespace Stacks.CohenMacaulay

/-- **The ideal generated by a regular sequence on a ring is proper.**  This is the second
conjunct of `RingTheory.Sequence.IsRegular`, read at the module `B` over itself, where
`I • (⊤ : Submodule B B)` is `I` itself. -/
theorem ofList_ne_top_of_isRegular {B : Type*} [CommRing B] {l : List B}
    (hl : RingTheory.Sequence.IsRegular B l) : Ideal.ofList l ≠ ⊤ := by
  intro htop
  refine hl.top_ne_smul ?_
  rw [htop]
  simp

/-- **Stacks 06LC, with the elements located in the maximal ideal of the source.**  Let
`φ : A →+* B` be a ring homomorphism from a local ring to a Noetherian Cohen–Macaulay local ring
with `m_B = √(φ(m_A) B)`.  Then there is a list `f` of elements of `m_A` of length `dim B` whose
images `φ(f₁), …, φ(f_{dim B})` form a regular sequence in `B`.

The list is the one Stacks 06LC provides; the membership is read off its conclusion, the ideal
generated by a regular sequence being proper. -/
theorem exists_isRegular_map_mem_maximalIdeal_length_eq_ringKrullDim {A B : Type*} [CommRing A]
    [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing B]
    (hCM : IsCohenMacaulayLocalRing B) (φ : A →+* B)
    (h : IsLocalRing.maximalIdeal B = (Ideal.map φ (IsLocalRing.maximalIdeal A)).radical) :
    ∃ f : List A, (f.length : WithBot ℕ∞) = ringKrullDim B ∧
      (∀ x ∈ f, x ∈ IsLocalRing.maximalIdeal A) ∧
      RingTheory.Sequence.IsRegular B (f.map φ) := by
  obtain ⟨f, hlen, hreg⟩ := exists_isRegular_map_length_eq_ringKrullDim hCM φ h
  refine ⟨f, hlen, fun x hx => ?_, hreg⟩
  have hmem : φ x ∈ Ideal.ofList (f.map φ) :=
    Ideal.subset_span (List.mem_map_of_mem hx)
  have hle : Ideal.ofList (f.map φ) ≤ IsLocalRing.maximalIdeal B :=
    IsLocalRing.le_maximalIdeal (ofList_ne_top_of_isRegular hreg)
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  exact (IsLocalRing.mem_maximalIdeal (φ x)).1 (hle hmem) (hu.map φ)

/-- **A zero-dimensional closed fibre makes the maximal ideal the radical of the extended
maximal ideal.**  Let `φ : A →+* B` be a homomorphism of local rings carrying `m_A` into `m_B`
and suppose the closed fibre `B ⧸ φ(m_A)B` has Krull dimension zero.  Then
`m_B = √(φ(m_A) B)`, the hypothesis of Stacks 06LC.

A prime of `B` containing `φ(m_A)B` dominates a minimal prime of it, which the dimension
hypothesis makes maximal, hence equal to `m_B`; so `m_B` lies in every prime containing
`φ(m_A)B`, which is the nontrivial inclusion. -/
@[ega "IV 21.13.12.1" "partial", ega "IV 6.1.3" "partial"]
theorem maximalIdeal_eq_radical_map_of_ringKrullDim_quotient_eq_zero {A B : Type*} [CommRing A]
    [CommRing B] [IsLocalRing A] [IsLocalRing B] (φ : A →+* B)
    (hloc : ∀ x ∈ IsLocalRing.maximalIdeal A, φ x ∈ IsLocalRing.maximalIdeal B)
    (h0 : ringKrullDim (B ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) = 0) :
    IsLocalRing.maximalIdeal B = (Ideal.map φ (IsLocalRing.maximalIdeal A)).radical := by
  set I : Ideal B := Ideal.map φ (IsLocalRing.maximalIdeal A) with hI
  have hIle : I ≤ IsLocalRing.maximalIdeal B := by
    rw [hI, Ideal.map_le_iff_le_comap]
    exact fun x hx => hloc x hx
  have hIne : I ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal B).ne_top hIle
  have : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hIne
  have hdim : Ring.KrullDimLE 0 (B ⧸ I) := ringKrullDimZero_iff_ringKrullDim_eq_zero.mpr h0
  refine le_antisymm ?_ ?_
  · rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro J ⟨hIJ, hJ⟩
    have := hJ
    obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le hIJ
    have hpmax : p.IsMaximal :=
      Ideal.krullDimLE_zero_quotient_iff_forall_minimalPrimes_isMaximal.mp hdim p hp
    exact (IsLocalRing.eq_maximalIdeal hpmax) ▸ hpJ
  · exact (Ideal.radical_mono hIle).trans
      (le_of_eq (IsLocalRing.maximalIdeal.isMaximal B).isPrime.radical)

/-- **The slicing functions of Stacks 06LI from a zero-dimensional closed fibre.**  Let
`φ : A →+* B` be a homomorphism of local rings carrying `m_A` into `m_B`, with `B` Noetherian,
Cohen–Macaulay and with zero-dimensional closed fibre `B ⧸ φ(m_A)B`.  Then there is a list of
elements of `m_A` of length `dim B` whose images form a regular sequence in `B`.

This is `Stacks.CohenMacaulay.exists_isRegular_map_mem_maximalIdeal_length_eq_ringKrullDim`
with its radical hypothesis supplied by
`Stacks.CohenMacaulay.maximalIdeal_eq_radical_map_of_ringKrullDim_quotient_eq_zero`. -/
theorem exists_isRegular_map_mem_maximalIdeal_of_ringKrullDim_quotient_eq_zero {A B : Type*}
    [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing B]
    (hCM : IsCohenMacaulayLocalRing B) (φ : A →+* B)
    (hloc : ∀ x ∈ IsLocalRing.maximalIdeal A, φ x ∈ IsLocalRing.maximalIdeal B)
    (h0 : ringKrullDim (B ⧸ Ideal.map φ (IsLocalRing.maximalIdeal A)) = 0) :
    ∃ f : List A, (f.length : WithBot ℕ∞) = ringKrullDim B ∧
      (∀ x ∈ f, x ∈ IsLocalRing.maximalIdeal A) ∧
      RingTheory.Sequence.IsRegular B (f.map φ) :=
  exists_isRegular_map_mem_maximalIdeal_length_eq_ringKrullDim hCM φ
    (maximalIdeal_eq_radical_map_of_ringKrullDim_quotient_eq_zero φ hloc h0)

end Stacks.CohenMacaulay

end
