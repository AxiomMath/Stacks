open IsLocalRing RingTheory.Sequence

open scoped TensorProduct

attribute [local instance] Algebra.TensorProduct.rightAlgebra
attribute [local instance] Localization.AtPrime.algebraOfLiesOver

/-- A list of elements of `I·B`, for `f : A →+* B` surjective, is the image of a list of elements
of `I`. -/
lemma exists_list_map_eq {A B : Type*} [CommRing A] [CommRing B] {f : A →+* B}
    (hf : Function.Surjective f) {I : Ideal A} :
    ∀ {ss : List B}, (∀ s ∈ ss, s ∈ I.map f) →
      ∃ rs : List A, (∀ r ∈ rs, r ∈ I) ∧ rs.map f = ss
  | [], _ => ⟨[], by simp, rfl⟩
  | s :: ss, h => by
    obtain ⟨rs, hrs, hmap⟩ := exists_list_map_eq hf fun t ht => h t (List.mem_cons_of_mem _ ht)
    obtain ⟨a, ha, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ hf).mp (h s List.mem_cons_self)
    exact ⟨a :: rs, by simpa using ⟨ha, hrs⟩, by simp [hmap]⟩

/-- **Depth is transported along a compatible pair.** Let `f : A →+* B` be surjective and let
`l : M ≃+ N` be an additive equivalence from an `A`-module to a `B`-module with
`l (a • x) = f a • l x`. Then the `I`-depth of `M` over `A` is the `I·B`-depth of `N` over `B`:
the map `rs ↦ f ∘ rs` is a length-preserving bijection from the `M`-regular sequences in `I` onto
the `N`-regular sequences in `I·B` (surjectivity of `f` is what lifts a sequence back), and
`I • M = M` exactly when `I·B • N = N`. -/
lemma depth_eq_depth_map {A B : Type*} [CommRing A] [CommRing B] {f : A →+* B}
    (hf : Function.Surjective f) (I : Ideal A) {M N : Type*} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module B N] (l : M ≃+ N) (hl : ∀ (a : A) (x : M), l (a • x) = f a • l x) :
    Module.depth A I M = Module.depth B (I.map f) N := by
  have hreg : ∀ rs : List A, IsRegular M rs ↔ IsRegular N (rs.map f) := fun rs =>
    l.isRegular_congr <| List.forall₂_map_right_iff.mpr <|
      List.forall₂_same.mpr fun a _ x => hl a x
  have hset : List.map f '' {rs : List A | (∀ r ∈ rs, r ∈ I) ∧ IsRegular M rs}
      = {ss : List B | (∀ s ∈ ss, s ∈ I.map f) ∧ IsRegular N ss} := by
    ext ss
    simp only [Set.mem_image, Set.mem_ofPred_eq]
    refine ⟨?_, fun ⟨hI, hss⟩ => ?_⟩
    · rintro ⟨rs, ⟨hI, hrs⟩, rfl⟩
      exact ⟨fun s hs => by
        obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hs
        exact Ideal.mem_map_of_mem _ (hI r hr), (hreg rs).mp hrs⟩
    · obtain ⟨rs, hrs, rfl⟩ := exists_list_map_eq hf hI
      exact ⟨rs, ⟨hrs, (hreg rs).mpr hss⟩, rfl⟩
  have hsymm : ∀ y ∈ (I.map f) • (⊤ : Submodule B N), l.symm y ∈ I • (⊤ : Submodule A M) := by
    intro y hy
    refine Submodule.smul_induction_on hy (fun b hb z _ => ?_) fun u v hu hv => ?_
    · obtain ⟨a, ha, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ hf).mp hb
      have hz : l (a • l.symm z) = f a • z := by rw [hl, l.apply_symm_apply]
      rw [← hz, l.symm_apply_apply]
      exact Submodule.smul_mem_smul ha Submodule.mem_top
    · rw [map_add]; exact Submodule.add_mem _ hu hv
  have htop : I • (⊤ : Submodule A M) = ⊤ ↔ (I.map f) • (⊤ : Submodule B N) = ⊤ := by
    refine ⟨fun h => eq_top_iff.mpr fun y _ => ?_, fun h => eq_top_iff.mpr fun x _ => ?_⟩
    · obtain ⟨x, rfl⟩ := l.surjective y
      have hx : x ∈ I • (⊤ : Submodule A M) := by rw [h]; exact Submodule.mem_top
      refine Submodule.smul_induction_on hx (fun a ha m _ => ?_) fun u v hu hv => ?_
      · rw [hl]; exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ ha) Submodule.mem_top
      · rw [map_add]; exact Submodule.add_mem _ hu hv
    · exact by simpa using hsymm (l x) (by rw [h]; exact Submodule.mem_top)
  simp only [Module.depth, htop, ← hset, iSup_image, List.length_map]

/-- Cohen–Macaulayness of a local ring depends only on its isomorphism class. -/
public lemma isMaximalCohenMacaulay_self_congr {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] (e : A ≃+* B) :
    Module.IsMaximalCohenMacaulay A A ↔ Module.IsMaximalCohenMacaulay B B := by
  simp only [Module.IsMaximalCohenMacaulay, Module.depth_self_eq_of_ringEquiv e,
    ringKrullDim_eq_of_ringEquiv e]

/-- A ring is Cohen–Macaulay (Definition 00NC) exactly when each of its localisations at a prime
is a Cohen–Macaulay local ring (Definition 00N8): for `M = R` the support of the localisation is
its whole spectrum, so `dim Supp(R_𝔭) = dim R_𝔭`. -/
theorem isCohenMacaulay_self_iff {B : Type*} [CommRing B] :
    Module.IsCohenMacaulay B B ↔ ∀ (P : Ideal B) [P.IsPrime],
      Module.IsMaximalCohenMacaulay (Localization.AtPrime P) (Localization.AtPrime P) := by
  refine ⟨fun h P hP => ?_,
    Stacks.CohenMacaulayTensor.isCohenMacaulay_self_of_forall_isMaximalCohenMacaulay B⟩
  have hmem : (⟨P, hP⟩ : PrimeSpectrum B) ∈ Module.support B B :=
    Module.mem_support_iff.mpr (inferInstanceAs (Nontrivial (Localization.AtPrime P)))
  have := h _ hmem
  rwa [Module.supportDim_self_eq_ringKrullDim] at this

/-- Cohen–Macaulayness of a ring depends only on its isomorphism class. -/
theorem isCohenMacaulay_self_of_ringEquiv {B C : Type*} [CommRing B] [CommRing C]
    (e : B ≃+* C) (h : Module.IsCohenMacaulay C C) : Module.IsCohenMacaulay B B :=
  isCohenMacaulay_self_iff.mpr fun P _ =>
    (isMaximalCohenMacaulay_self_congr
      (Localization.localRingEquiv P (P.comap (e.symm : C →+* B)) e (by ext x; simp))).mpr
      (isCohenMacaulay_self_iff.mp h _)

/-- The depth over a local ring `B` of a proper quotient `B ⧸ I` is its own Krull dimension as
soon as `B ⧸ I` is isomorphic to a Cohen–Macaulay local ring: depth along `𝔪_B` and depth along
the maximal ideal of `B ⧸ I` agree, the two ideals corresponding under the quotient map. -/
private lemma depth_quotient_eq_ringKrullDim_of_ringEquiv {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] {I : Ideal B} (hI : I ≠ ⊤) (e : A ≃+* B ⧸ I)
    (h : Module.IsMaximalCohenMacaulay A A) :
    (Module.depth B (maximalIdeal B) (B ⧸ I) : WithBot ℕ∞) = ringKrullDim (B ⧸ I) := by
  have hsurj : Function.Surjective (algebraMap B (B ⧸ I)) := by
    rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective
  have : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  have : IsLocalRing (B ⧸ I) := .of_surjective' _ Ideal.Quotient.mk_surjective
  rw [depth_eq_depth_map hsurj _ (AddEquiv.refl (B ⧸ I))
      fun b x => (algebraMap_smul (B ⧸ I) b x).symm,
    map_maximalIdeal_of_surjective _ hsurj, ← Module.depth_self_eq_of_ringEquiv e,
    ← ringKrullDim_eq_of_ringEquiv e]
  exact h

/-- `𝔪_{S_𝔮} T_𝔯 = 𝔮 T_𝔯`: for `𝔯 ⊆ T` a prime lying over `𝔮 ⊆ S`, the ideal of `T_𝔯` generated by
the maximal ideal of `S_𝔮` is the one generated by `𝔮` itself, the localisation `S → S_𝔮` already
generating `𝔪_{S_𝔮}` from `𝔮`. -/
private lemma map_maximalIdeal_eq_map_of_liesOver {S T : Type*} [CommRing S] [CommRing T]
    [Algebra S T] (q : Ideal S) [q.IsPrime] (r : Ideal T) [r.IsPrime] [r.LiesOver q] :
    (maximalIdeal (Localization.AtPrime q)).map
        (algebraMap (Localization.AtPrime q) (Localization.AtPrime r))
      = q.map (algebraMap S (Localization.AtPrime r)) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, ← IsScalarTower.algebraMap_eq]

/-- **The fibre of a localisation is a localisation of the fibre.** Let `𝔯 ⊆ T` be a prime lying
over a prime `𝔮 ⊆ S`. The fibre `T_𝔯 / 𝔮 T_𝔯` of `S_𝔮 → T_𝔯` is the localisation of the fibre
ring `κ(𝔮) ⊗[S] T` at the prime corresponding to `𝔯`; so if `κ(𝔮) ⊗[S] T` is a Cohen–Macaulay
ring, then the fibre is a Cohen–Macaulay local ring, in the form the fibre condition of Stacks
045J asks for. -/
private lemma depth_eq_ringKrullDim_of_isCohenMacaulay_fiber {S T : Type*} [CommRing S]
    [CommRing T] [Algebra S T] (q : Ideal S) [q.IsPrime] (r : Ideal T) [r.IsPrime] [r.LiesOver q]
    (h : Module.IsCohenMacaulay (q.Fiber T) (q.Fiber T)) :
    (Module.depth (Localization.AtPrime r) (maximalIdeal (Localization.AtPrime r))
        (Localization.AtPrime r ⧸ (maximalIdeal (Localization.AtPrime q)).map
          (algebraMap (Localization.AtPrime q) (Localization.AtPrime r))) : WithBot ℕ∞) =
      ringKrullDim (Localization.AtPrime r ⧸ (maximalIdeal (Localization.AtPrime q)).map
        (algebraMap (Localization.AtPrime q) (Localization.AtPrime r))) := by
  set Q : Ideal (q.Fiber T) :=
    ((PrimeSpectrum.primesOverOrderIsoFiber S T q)
      ⟨r, inferInstance, inferInstance⟩).asIdeal with hQdef
  have hQ : Q.comap (Algebra.TensorProduct.includeRight : T →ₐ[S] q.Fiber T) = r := by
    rw [hQdef, ← PrimeSpectrum.coe_primesOverOrderIsoFiber_symm_apply, OrderIso.symm_apply_apply]
  have : (Q.comap (Algebra.TensorProduct.includeRight : T →ₐ[S] q.Fiber T)).LiesOver q :=
    ⟨by rw [hQ]; exact Ideal.LiesOver.over⟩
  have e2 : Localization.AtPrime (Q.comap (Algebra.TensorProduct.includeRight :
      T →ₐ[S] q.Fiber T)) ≃ₐ[S] Localization.AtPrime r :=
    Localization.localAlgEquiv _ r (AlgEquiv.refl : T ≃ₐ[S] T) (by rw [hQ]; ext x; simp)
  have E : Localization.AtPrime Q ≃+* Localization.AtPrime r ⧸
      (maximalIdeal (Localization.AtPrime q)).map
        (algebraMap (Localization.AtPrime q) (Localization.AtPrime r)) :=
    (Ideal.Fiber.algEquivAux₂ q Q).toRingEquiv.trans
      (Ideal.quotientEquiv _ _ e2.toRingEquiv
        (by
          rw [map_maximalIdeal_eq_map_of_liesOver, Ideal.map_map, Ideal.map_map,
            RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq]
          exact congrArg (Ideal.map · q) (RingHom.ext e2.commutes).symm))
  exact depth_quotient_eq_ringKrullDim_of_ringEquiv (map_maximalIdeal_lt_top _).ne E
    (isCohenMacaulay_self_iff.mp h Q)

/-- Base change commutes with taking the fibre: the fibre of `K ⊗[k] S` over `S` at a prime `𝔮`,
that is `κ(𝔮) ⊗[S] (K ⊗[k] S)`, is `κ(𝔮) ⊗[k] K`. -/
private noncomputable def fiberBaseChangeRingEquiv (k S : Type*) [Field k] [CommRing S]
    [Algebra k S] (q : Ideal S) [q.IsPrime] (K : Type*) [Field K] [Algebra k K] :
    q.Fiber (K ⊗[k] S) ≃+* q.ResidueField ⊗[k] K :=
  (Algebra.TensorProduct.congr (AlgEquiv.refl : q.ResidueField ≃ₐ[S] q.ResidueField)
      (Algebra.TensorProduct.commRight k S K).symm).toRingEquiv.trans
    (Algebra.TensorProduct.cancelBaseChange k S q.ResidueField q.ResidueField K).toRingEquiv

/-- For a Noetherian `k`-algebra `S`, a finitely generated field extension `K/k` and a prime `𝔮_K`
of `K ⊗[k] S` lying over the prime `𝔮` of `S`, the local ring `S_𝔮` is Cohen–Macaulay if and only
if `(K ⊗[k] S)_{𝔮_K}` is. -/
public theorem solution {k S : Type*} [Field k] [CommRing S] [Algebra k S] [IsNoetherianRing S]
    {K : Type*} [Field K] [Algebra k K] [Algebra.EssFiniteType k K]
    (q : Ideal S) [q.IsPrime] (qK : Ideal (K ⊗[k] S)) [qK.IsPrime]
    (hqK : q = qK.comap Algebra.TensorProduct.includeRight.toRingHom)
    (Sq : Type*) [CommRing Sq] [Algebra S Sq] [IsLocalization.AtPrime Sq q] [IsLocalRing Sq]
    (SKqK : Type*) [CommRing SKqK] [Algebra (K ⊗[k] S) SKqK]
    [IsLocalization.AtPrime SKqK qK] [IsLocalRing SKqK] :
    Module.IsMaximalCohenMacaulay Sq Sq ↔ Module.IsMaximalCohenMacaulay SKqK SKqK := by
  rw [isMaximalCohenMacaulay_self_congr
      (IsLocalization.algEquiv q.primeCompl Sq (Localization.AtPrime q)).toRingEquiv,
    isMaximalCohenMacaulay_self_congr
      (IsLocalization.algEquiv qK.primeCompl SKqK (Localization.AtPrime qK)).toRingEquiv]
  -- `K ⊗[k] S` is `S ⊗[k] K`: Noetherian by Stacks 045I, and flat over `S` because `K` is flat
  -- over `k`
  have : IsNoetherianRing (S ⊗[k] K) := Algebra.EssFiniteType.isNoetherianRing S (S ⊗[k] K)
  have : IsNoetherianRing (K ⊗[k] S) :=
    isNoetherianRing_of_ringEquiv (S ⊗[k] K) (Algebra.TensorProduct.commRight k S K).toRingEquiv
  have : Module.Flat S (K ⊗[k] S) :=
    Module.Flat.of_linearEquiv (Algebra.TensorProduct.commRight k S K).symm.toLinearEquiv
  have : qK.LiesOver q := ⟨hqK⟩
  rw [Module.isMaximalCohenMacaulay_self_iff_of_flat (Localization.AtPrime q)
    (Localization.AtPrime qK)]
  -- the fibre ring is `κ(𝔮) ⊗[k] K`, a Cohen–Macaulay ring by Stacks 045M
  exact (and_iff_left (depth_eq_ringKrullDim_of_isCohenMacaulay_fiber q qK
    (isCohenMacaulay_self_of_ringEquiv (fiberBaseChangeRingEquiv k S q K)
      (Algebra.TensorProduct.isNoetherianRing_and_isCohenMacaulay_of_essFiniteType k
        q.ResidueField K (.inr ‹Algebra.EssFiniteType k K›)).2))).symm

end Stacks.CohenMacaulay.BaseFieldExtension

end

/-!
# Cohen–Macaulayness is insensitive to a finitely generated field extension of the base

Let `k` be a field, let `S` be a Noetherian `k`-algebra and let `K/k` be a finitely generated
field extension. Put `S_K = K ⊗[k] S`. Let `𝔮 ⊆ S` be a prime and let `𝔮_K ⊆ S_K` be a prime
lying over it, that is `𝔮 = 𝔮_K ∩ S` along `s ↦ 1 ⊗ s`. Then the local ring `S_𝔮` is
Cohen–Macaulay if and only if the local ring `(S_K)_{𝔮_K}` is.

The mechanism is base change along a flat local homomorphism. The ring `S_K` is Noetherian
(Tag 045I), so `S_𝔮 → (S_K)_{𝔮_K}` is a flat local homomorphism of Noetherian local rings, flat
because `S → S_K` is a base change of `k → K` and localisation is flat. Its fibre
`(S_K)_{𝔮_K} / 𝔮(S_K)_{𝔮_K}` is a localisation of `κ(𝔮) ⊗[k] K`, which is a Noetherian
Cohen–Macaulay ring by Tag 045M, `K/k` being finitely generated. So the fibre is Cohen–Macaulay
whatever `𝔮` and `𝔮_K` are, and Tag 045J — `S` Cohen–Macaulay iff both the base and the fibre
are, for a flat local homomorphism — turns the equivalence "`S_𝔮` and the fibre" into the
equivalence "`(S_K)_{𝔮_K}`" alone.

## Main results

* `Algebra.TensorProduct.isMaximalCohenMacaulay_self_iff_of_essFiniteType`: Tag 045N.

## Implementation notes

Cohen–Macaulayness of a Noetherian local ring `A` (Definition 00N8: `A` is Cohen–Macaulay as a
module over itself, `depth_{𝔪_A}(A) = dim A`) is `Module.IsMaximalCohenMacaulay A A`, Tag 00NF,
as in the companion statements 00R5, 00ND, 045J and in the statement Tag 045M this one is proved
from.

Finite generation of the field extension `K/k` is `Algebra.EssFiniteType k K`, which by
`IntermediateField.fg_top_iff` says `(⊤ : IntermediateField k K).FG`, i.e. `K = k(x_1, …, x_n)`
for finitely many `x_i ∈ K`. This is the spelling of Tag 045M and of the neighbouring statements
00PH, 00TU and 030O, and it is strictly weaker than `Algebra.FiniteType k K`, which for a field
extension would force algebraicity and so exclude the source's transcendental generators.

The two localisations are abstract: `S_𝔮` is any `S`-algebra `Sq` with `IsLocalization.AtPrime
Sq q`, and `(S_K)_{𝔮_K}` any `(K ⊗[k] S)`-algebra `SKqK` with `IsLocalization.AtPrime SKqK qK`,
following Tag 00ND. Every such ring is canonically isomorphic to the concrete
`Localization.AtPrime`, so this is the source's statement for every model at once, and a user with
`Localization.AtPrime q` in hand supplies the instances by `inferInstance`. The two `IsLocalRing`
instances are not extra hypotheses but consequences, `IsLocalization.AtPrime.isLocalRing`; they
are assumed because the prime cannot be recovered from the ring, so that lemma is not an instance,
and `Module.IsMaximalCohenMacaulay` needs a local ring to be stated at all.

"`𝔮_K` lies over `𝔮`" is `q = qK.comap Algebra.TensorProduct.includeRight.toRingHom`, contraction
along the canonical `S`-side inclusion `s ↦ 1 ⊗ s` of `S` into `K ⊗[k] S`; this is Mathlib's
spelling of the same condition for the same base change in `Algebra.QuasiFiniteAt.baseChange`.
The `S`-algebra structure on `K ⊗[k] S` is not an instance (`Algebra.TensorProduct.rightAlgebra`
is an `abbrev`, the left and right structures clashing), so `Ideal.LiesOver` is unavailable here
and the contraction is written out.

`IsNoetherianRing (K ⊗[k] S)` is not assumed although the source's proof begins by establishing
it: it is a consequence of the hypotheses by Tag 045I, so assuming it would weaken the statement.

Faithfulness to [StacksProject 045N]:

1. No dead hypothesis. `IsNoetherianRing S` is what makes both `S_𝔮` and, through Tag 045I,
   `(S_K)_{𝔮_K}` Noetherian local rings, the setting in which `depth = dim` is Cohen–Macaulayness
   and in which the two depths are comparable at all; `Algebra.EssFiniteType k K` is what makes
   the fibre Cohen–Macaulay, and it is not decoration — for `K = k(x_1, x_2, …)` and
   `S = k(y_1, y_2, …)` the ring `K ⊗[k] S` is not Noetherian, so Tag 045I fails and the fibre
   ring is no longer covered by Tag 045M; `hqK` is the only link between the two sides, and
   without it they are the local rings of unrelated primes (for `S = k[x]`, `K = k`, `𝔮 = (x)`
   and `𝔮_K = (0)` the left side has dimension `1` and the right side is a field); primality of
   `𝔮` and of `𝔮_K` is what makes the localisations local rings. Both field structures and
   `Algebra k S` are used to form `K ⊗[k] S`.
2. The scalars and the base are the source's. The tensor product is over `k`, the extension
   `Algebra.EssFiniteType k K` is finite generation over `k`, `Sq` is a localisation of `S` as an
   `S`-algebra and `SKqK` one of `K ⊗[k] S` as a `(K ⊗[k] S)`-algebra, and each side of the
   equivalence is Cohen–Macaulayness of a local ring over *itself*: `depth_{𝔪}(S_𝔮)` is taken
   over `S_𝔮` and `depth_{𝔪}((S_K)_{𝔮_K})` over `(S_K)_{𝔮_K}`, not over `S` or over `k`.
3. The maps the source names are pinned. "Lying over" is contraction along the named ring
   homomorphism `Algebra.TensorProduct.includeRight`, not along an unspecified map; the two
   localisations are pinned by their universal property `IsLocalization.AtPrime` rather than
   asserted to exist; and the conclusion is an equivalence between two equations, not an
   existence statement.
4. The instantiation is not degenerate, in both directions. For `k = ℚ`, `K = ℚ(t)`, `S = ℚ[x]`,
   `𝔮 = (x)` and `𝔮_K = (x)` in `ℚ(t) ⊗[ℚ] ℚ[x] ≅ ℚ(t)[x]`, the hypotheses hold with `K/k`
   transcendental and both sides are true with `depth = dim = 1` on each side, computed rather
   than forced. Both sides also fail together: for `S = ℚ[x, y]/(x², xy)` and `𝔮 = (x, y)` the
   left side fails, `depth = 0 < 1 = dim`, and so does the right side over `𝔮_K = 𝔮 · S_K`. The
   right-hand side is never vacuous for lack of a prime: `κ(𝔮) ⊗[k] K ≠ 0`, so some `𝔮_K` lies
   over each `𝔮`.

