/-!
# Applications of Zariski's Main Theorem

All rings here are commutative with `1`, and a local ring is a (not necessarily Noetherian)
commutative ring with a unique maximal ideal.

Let `f : (R, m_R) → (S, m_S)` be a local homomorphism of local rings. Assume that `f` is
essentially of finite type, that the induced residue field extension `κ(m_R) ⊆ κ(m_S)` is finite,
and that the closed fiber has Krull dimension `0`, i.e. `dim (S / m_R S) = 0`. Then `S` is the
localization of a finite `R`-algebra: there are a finite `R`-algebra `S''` and a multiplicative
subset `T ⊆ S''` with `S ≅ T⁻¹S''` as `R`-algebras. Since `S` is local one may take `T` to be the
complement of a prime `q'' ⊆ S''`, so that `S ≅ S''_{q''}`.

## Main definitions

* `Stacks.LocalizationOfFiniteAlgebra.closedFiber`: the closed fiber `S / m_R S` of a local ring
  map `f`, namely the quotient of `S` by the ideal generated by the image of `m_R`.
* `Stacks.LocalizationOfFiniteAlgebra.residueAlgebra`: the `κ(m_R)`-algebra structure on `κ(m_S)`
  induced by `f`.

## Main results

* `Stacks.LocalizationOfFiniteAlgebra.essFiniteType_localization_finite`: the conclusion in
  submonoid form.
* `Stacks.LocalizationOfFiniteAlgebra.essFiniteType_localization_finite_prime`: the conclusion in
  prime form, `S ≅ S''_{q''}`.

-/

@[expose] public section

namespace Stacks.LocalizationOfFiniteAlgebra

universe u

/-- The closed fiber `S / m_R S` of a local ring map `f : R →+* S` (with `R`
local), as the quotient of `S` by the ideal generated by the image of the
maximal ideal of `R`. -/
abbrev closedFiber {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R]
    (f : R →+* S) : Type _ :=
  S ⧸ Ideal.map f (IsLocalRing.maximalIdeal R)

/-- The `κ(m_R)`-algebra structure on `κ(m_S)` induced by a local homomorphism `f : R →+* S`. -/
@[reducible] noncomputable def residueAlgebra {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f] :
    Algebra (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S) :=
  (IsLocalRing.ResidueField.map f).toAlgebra

/-- If `S` is a local ring that is a localization of `A`, then it is the localization of `A` at
the contraction of its maximal ideal. -/
private theorem isLocalization_primeCompl_comap_maximalIdeal {A S : Type*} [CommRing A]
    [CommRing S] [IsLocalRing S] [Algebra A S] (M : Submonoid A) [IsLocalization M S] :
    IsLocalization ((IsLocalRing.maximalIdeal S).comap (algebraMap A S)).primeCompl S := by
  apply IsLocalization.of_le M
  · exact fun m hm hmp ↦ (IsLocalRing.maximalIdeal.isMaximal S).ne_top
      (Ideal.eq_top_of_isUnit_mem _ hmp (IsLocalization.map_units S ⟨m, hm⟩))
  · exact fun r hr ↦ IsLocalRing.notMem_maximalIdeal.mp hr

/-- Let `f : R →+* S` be a local homomorphism of local rings which is essentially of finite type,
with finite residue field extension and closed fiber of Krull dimension `0`. With `S` carrying
the `R`-algebra structure `f.toAlgebra`, let `S' := Algebra.EssFiniteType.subalgebra R S` be the
finite type `R`-subalgebra exhibiting `S` as a localization, and let `p` be the contraction of
`m_S` to `S'`. Then `R → S'` is weakly quasi-finite at `p`. -/
theorem weaklyQuasiFiniteAt_subalgebra {R S : Type u} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f]
    (hft : f.EssFiniteType)
    (hres : @Module.Finite (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S)
      _ _ (residueAlgebra f).toModule)
    (hdim : ringKrullDim (closedFiber f) = 0) :
    letI : Algebra R S := f.toAlgebra
    haveI : Algebra.EssFiniteType R S := hft
    @Algebra.WeaklyQuasiFiniteAt R (Algebra.EssFiniteType.subalgebra R S) _ _ _
      ((IsLocalRing.maximalIdeal S).comap
        (Algebra.EssFiniteType.subalgebra R S).val.toRingHom)
      (by
        -- `p` is prime: contraction of the prime `m_S` along the inclusion `S' → S`.
        -- `IsLocalRing.maximalIdeal S` is prime (instance), and the comap of a
        -- prime ideal along a ring hom is prime.
        exact Ideal.IsPrime.comap _) := by
  let : Algebra R S := f.toAlgebra
  have : Algebra.EssFiniteType R S := hft
  rw [Algebra.weaklyQuasiFiniteAt_iff]
  set S' := Algebra.EssFiniteType.subalgebra R S with hS'
  set p : Ideal S' := (IsLocalRing.maximalIdeal S).comap S'.val.toRingHom with hp
  have hpp : p.IsPrime := Ideal.IsPrime.comap _
  have : IsLocalization (Algebra.EssFiniteType.submonoid R S) S :=
    Algebra.EssFiniteType.isLocalization R S
  have hSloc : IsLocalization p.primeCompl S :=
    isLocalization_primeCompl_comap_maximalIdeal (A := S') (S := S)
      (Algebra.EssFiniteType.submonoid R S)
  have hunder : Ideal.under R p = IsLocalRing.maximalIdeal R := by
    have hstep : Ideal.under R p = Ideal.under R (IsLocalRing.maximalIdeal S) := by
      rw [hp]; rfl
    rw [hstep]; exact IsLocalRing.maximalIdeal_comap (algebraMap R S)
  let e : Localization.AtPrime p ≃ₐ[R] S :=
    (IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p) S).restrictScalars R
  set T := Localization.AtPrime p with hT
  set J : Ideal T := Ideal.map (algebraMap R T) (Ideal.under R p) with hJ
  set K : Ideal S := Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) with hK
  have hJK : K = Ideal.map (e : T →+* S) J := by
    rw [hJ, hK, Ideal.map_map, hunder]
    congr 1
    ext x
    exact (e.commutes x).symm
  let e2 : (T ⧸ J) ≃ₐ[R] S ⧸ K := Ideal.quotientEquivAlg J K e hJK
  rw [Algebra.QuasiFinite.iff_of_algEquiv e2]
  suffices hfin : Module.Finite R (S ⧸ K) by infer_instance
  have hKle : K ≤ IsLocalRing.maximalIdeal S := by
    rw [hK, Ideal.map_le_iff_le_comap, ← IsLocalRing.maximalIdeal_comap (algebraMap R S)]
  have hmap : IsLocalRing.ResidueField.map f
      = algebraMap (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S) := by
    ext r
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective r
    rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.algebraMap_residue,
      RingHom.algebraMap_toAlgebra]
  have : Module.Finite (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S) := by
    have hrf : (IsLocalRing.ResidueField.map f).Finite := hres
    rw [hmap] at hrf
    exact RingHom.finite_algebraMap.mp hrf
  have hfR : Module.Finite R (IsLocalRing.ResidueField R) :=
    Module.Finite.of_surjective (Algebra.linearMap R (IsLocalRing.ResidueField R))
      Ideal.Quotient.mk_surjective
  have hfRS : Module.Finite R (IsLocalRing.ResidueField S) :=
    Module.Finite.trans (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S)
  have hKne : K ≠ ⊤ := fun h ↦ (IsLocalRing.maximalIdeal.isMaximal S).ne_top
    (top_le_iff.mp (h ▸ hKle))
  have : Nontrivial (S ⧸ K) := Ideal.Quotient.nontrivial_iff.mpr hKne
  have hlocSK : IsLocalRing (S ⧸ K) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have hmemMax : ∀ x ∈ IsLocalRing.maximalIdeal S,
      (Ideal.Quotient.mk K x) ∈ IsLocalRing.maximalIdeal (S ⧸ K) := by
    intro x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro hu
    obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (I := K) (↑hu.unit⁻¹ : (S ⧸ K))
    have hone : (Ideal.Quotient.mk K) (x * z) = 1 := by
      rw [map_mul, hz, IsUnit.mul_val_inv]
    have hmem : x * z - 1 ∈ K := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hone, map_one, sub_self]
    have h1 : (1 : S) ∈ IsLocalRing.maximalIdeal S := by
      simpa only [sub_sub_cancel] using
        Ideal.sub_mem _ (Ideal.mul_mem_right z _ hx) (hKle hmem)
    exact (IsLocalRing.maximalIdeal.isMaximal S).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
  have hfinJac : Module.Finite R ((S ⧸ K) ⧸ Ring.jacobson (S ⧸ K)) := by
    let φ : S →ₐ[R] ((S ⧸ K) ⧸ Ring.jacobson (S ⧸ K)) :=
      (Ideal.Quotient.mkₐ R (Ring.jacobson (S ⧸ K))).comp (Ideal.Quotient.mkₐ R K)
    have hφsurj : Function.Surjective φ :=
      (Ideal.Quotient.mkₐ_surjective R _).comp (Ideal.Quotient.mkₐ_surjective R _)
    have hker : IsLocalRing.maximalIdeal S ≤ RingHom.ker φ := by
      intro x hx
      rw [RingHom.mem_ker]
      show (Ideal.Quotient.mk (Ring.jacobson (S ⧸ K))) (Ideal.Quotient.mk K x) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, IsLocalRing.ringJacobson_eq_maximalIdeal]
      exact hmemMax x hx
    let ψ : IsLocalRing.ResidueField S →ₐ[R] ((S ⧸ K) ⧸ Ring.jacobson (S ⧸ K)) :=
      Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal S) φ hker
    have hψsurj : Function.Surjective ψ := by
      intro y
      obtain ⟨x, hx⟩ := hφsurj y
      exact ⟨IsLocalRing.residue S x, hx⟩
    exact Module.Finite.of_surjective ψ.toLinearMap hψsurj
  have hleR : IsLocalRing.maximalIdeal R ≤ Ideal.comap (algebraMap R S) K := by
    rw [hK]; exact Ideal.le_comap_map
  let : Algebra (IsLocalRing.ResidueField R) (S ⧸ K) :=
    Ideal.Quotient.algebraQuotientOfLEComap hleR
  have : IsScalarTower R (IsLocalRing.ResidueField R) (S ⧸ K) :=
    IsScalarTower.of_algebraMap_eq (fun _ ↦ rfl)
  have : Algebra.EssFiniteType R (S ⧸ K) := Algebra.instEssFiniteTypeQuotientIdeal R S K
  have : Algebra.EssFiniteType (IsLocalRing.ResidueField R) (S ⧸ K) :=
    Algebra.EssFiniteType.of_comp R (IsLocalRing.ResidueField R) (S ⧸ K)
  have hnoeth : IsNoetherianRing (S ⧸ K) :=
    Algebra.EssFiniteType.isNoetherianRing (IsLocalRing.ResidueField R) (S ⧸ K)
  have hkdim : Ring.KrullDimLE 0 (S ⧸ K) := by
    rw [Ring.krullDimLE_iff,
      show ringKrullDim (S ⧸ K) = ringKrullDim (closedFiber f) from rfl, hdim]
    simp
  have hart : IsArtinianRing (S ⧸ K) :=
    isArtinianRing_iff_isNoetherianRing_krullDimLE_zero.mpr ⟨hnoeth, hkdim⟩
  have : IsSemiprimaryRing (S ⧸ K) := inferInstance
  exact IsSemiprimaryRing.finite_of_isArtinian R (S ⧸ K) (S ⧸ K)

set_option maxHeartbeats 800000 in
-- needed: `localization_finite_prime_core` exhausts the default budget in `whnf`
set_option synthInstance.maxHeartbeats 100000 in
-- needed: instance search for the localization algebra structures in
-- `localization_finite_prime_core` exceeds the default instance budget
/-- Let `f : R →+* S` be a local homomorphism of local rings which is essentially of finite type,
with finite residue field extension and closed fiber of Krull dimension `0`. Then there are a
ring `S''`, a finite ring map `g : R →+* S''`, a prime `q''` of `S''` and a ring map
`h : S'' →+* S` with `h.comp g = f` exhibiting `S` as the localization of `S''` at `q''`. -/
@[ega "III 4.4.7" "more general"]
theorem localization_finite_prime_core {R S : Type u} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f]
    (hft : f.EssFiniteType)
    (hres : @Module.Finite (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S)
      _ _ (residueAlgebra f).toModule)
    (hdim : ringKrullDim (closedFiber f) = 0) :
    ∃ (S'' : Type u) (_ : CommRing S'') (g : R →+* S'') (h : S'' →+* S)
      (q'' : Ideal S'') (_ : q''.IsPrime),
      g.Finite ∧ h.comp g = f ∧
        @IsLocalization S'' _ q''.primeCompl S _ h.toAlgebra := by
  let : Algebra R S := f.toAlgebra
  have : Algebra.EssFiniteType R S := hft
  set B := Algebra.EssFiniteType.subalgebra R S with hB
  set p : Ideal B := (IsLocalRing.maximalIdeal S).comap B.val.toRingHom with hp
  have hpp : p.IsPrime := Ideal.IsPrime.comap _
  have hwqf := weaklyQuasiFiniteAt_subalgebra f hft hres hdim
  have : IsLocalization (Algebra.EssFiniteType.submonoid R S) S :=
    Algebra.EssFiniteType.isLocalization R S
  have hSloc : IsLocalization p.primeCompl S :=
    isLocalization_primeCompl_comap_maximalIdeal (A := B) (S := S)
      (Algebra.EssFiniteType.submonoid R S)
  obtain ⟨C, hFG, r, hr, hbij⟩ :=
    Algebra.QuasiFiniteAt.exists_fg_and_exists_notMem_and_awayMap_bijective
      (R := R) (S := B) p
  refine ⟨↥C, inferInstance, algebraMap R ↥C, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (B.val.toRingHom.comp C.val.toRingHom)
  · exact (IsLocalRing.maximalIdeal S).comap (B.val.toRingHom.comp C.val.toRingHom)
  · exact Ideal.IsPrime.comap _
  · rw [RingHom.Finite]
    exact Module.Finite.iff_fg.mpr hFG
  · rw [RingHom.comp_assoc]
    have h1 : C.val.toRingHom.comp (algebraMap R ↥C) = algebraMap R ↥B := by
      ext x; rfl
    rw [h1]
    show B.val.toRingHom.comp (algebraMap R ↥B) = f
    have h2 : B.val.toRingHom.comp (algebraMap R ↥B) = algebraMap R S := by
      ext x; rfl
    rw [h2]; rfl
  · set h : ↥C →+* S := B.val.toRingHom.comp C.val.toRingHom with hh
    let algCS : Algebra ↥C S := h.toAlgebra
    have hams : algebraMap ↥C S = h := rfl
    set cr : B := C.val.toRingHom r with hcr
    have hrp : cr ∉ p := hr
    have hple : Submonoid.powers cr ≤ p.primeCompl := Submonoid.powers_le.mpr hrp
    have hucr : IsUnit (algebraMap B S cr) := IsLocalization.map_units S (⟨cr, hrp⟩ : p.primeCompl)
    let algBwS : Algebra (Localization.Away cr) S :=
      (IsLocalization.Away.lift (S := Localization.Away cr) cr
        (g := algebraMap B S) hucr).toAlgebra
    have htowB : (algebraMap (Localization.Away cr) S).comp (algebraMap B (Localization.Away cr))
        = algebraMap B S :=
      IsLocalization.Away.lift_comp cr hucr
    have : IsScalarTower B (Localization.Away cr) S :=
      IsScalarTower.of_algebraMap_eq' htowB.symm
    have hlocBw : IsLocalization
        (Submonoid.map (algebraMap B (Localization.Away cr)) p.primeCompl) S :=
      IsLocalization.isLocalization_of_submonoid_le (Localization.Away cr) S
        (Submonoid.powers cr) p.primeCompl hple
    set amap : Localization.Away r →+* Localization.Away cr :=
      Localization.awayMap C.val.toRingHom r with hamap
    set e0 : Localization.Away cr ≃+* Localization.Away r :=
      (RingEquiv.ofBijective amap hbij).symm with he0
    let algAwS : Algebra (Localization.Away r) S :=
      ((algebraMap (Localization.Away cr) S).comp e0.symm.toRingHom).toAlgebra
    have hAwS : algebraMap (Localization.Away r) S
        = (algebraMap (Localization.Away cr) S).comp e0.symm.toRingHom :=
      RingHom.algebraMap_toAlgebra _
    have hlocAw : IsLocalization
        (Submonoid.map e0 (Submonoid.map (algebraMap B (Localization.Away cr)) p.primeCompl)) S :=
      IsLocalization.isLocalization_of_base_ringEquiv
        (Submonoid.map (algebraMap B (Localization.Away cr)) p.primeCompl) S e0
    have he0symm : e0.symm.toRingHom = amap := by rw [he0]; rfl
    have htowC : (algebraMap (Localization.Away r) S).comp (algebraMap ↥C (Localization.Away
        r)) = h := by
      rw [hAwS, he0symm, RingHom.comp_assoc]
      have hcomp : amap.comp (algebraMap ↥C (Localization.Away r))
          = (algebraMap B (Localization.Away cr)).comp C.val.toRingHom := by
        rw [hamap]
        ext c
        rw [RingHom.comp_apply, RingHom.comp_apply,
          Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq]
      rw [hcomp, ← RingHom.comp_assoc, htowB]; rfl
    have towCAwS : @IsScalarTower ↥C (Localization.Away r) S _ _ algCS.toSMul :=
      @IsScalarTower.of_algebraMap_eq' ↥C (Localization.Away r) S _ _ _ _ algAwS algCS
        (hams.trans htowC.symm)
    have : IsLocalization (Submonoid.powers r) (Localization.Away r) := inferInstance
    have hlocC : @IsLocalization ↥C _
        (IsLocalization.localizationLocalizationSubmodule (Submonoid.powers r)
          (Submonoid.map e0 (Submonoid.map (algebraMap B (Localization.Away cr)) p.primeCompl))) S _
          algCS :=
      @IsLocalization.localization_localization_isLocalization ↥C _ (Submonoid.powers r)
        (Localization.Away r) _ _ _ S _ algCS algAwS towCAwS _ _
    have := hlocC
    exact isLocalization_primeCompl_comap_maximalIdeal (A := ↥C) (S := S)
      (IsLocalization.localizationLocalizationSubmodule (Submonoid.powers r)
        (Submonoid.map e0 (Submonoid.map (algebraMap B (Localization.Away cr)) p.primeCompl)))

/-- Let `f : (R, m_R) → (S, m_S)` be a local homomorphism of local rings. Assume `f` is
essentially of finite type, the residue field extension `κ(m_R) ⊆ κ(m_S)` is finite, and the
closed fiber `S / m_R S` has Krull dimension `0`. Then `S` is a localization of a finite
`R`-algebra: there exist a ring `S''`, a finite ring map `g : R →+* S''`, a submonoid `T ≤ S''`,
and a ring map `h : S'' →+* S` exhibiting `S` as the localization of `S''` at `T`, with
`h ∘ g = f` as `R`-algebra maps. -/
@[stacks 052V]
theorem essFiniteType_localization_finite {R S : Type u} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f]
    (hft : f.EssFiniteType)
    (hres : @Module.Finite (IsLocalRing.ResidueField R) (IsLocalRing.ResidueField S)
      _ _ (residueAlgebra f).toModule)
    (hdim : ringKrullDim (closedFiber f) = 0) :
    ∃ (S'' : Type u) (_ : CommRing S'') (g : R →+* S'') (h : S'' →+* S)
      (T : Submonoid S''),
      g.Finite ∧ h.comp g = f ∧ @IsLocalization S'' _ T S _ h.toAlgebra := by
  obtain ⟨S'', _, g, h, q'', hq'', hg, hcomp, hloc⟩ :=
    localization_finite_prime_core f hft hres hdim
  exact ⟨S'', ‹_›, g, h, q''.primeCompl, hg, hcomp, hloc⟩

/-- Under the hypotheses of `essFiniteType_localization_finite`, the localization may be taken
at a prime: there exist a ring `S''`, a finite ring map `g : R →+* S''`, a prime ideal
`q'' ⊆ S''`, and a ring map `h : S'' →+* S` exhibiting `S` as the localization `S''_{q''}` of
`S''` at `q''`, with `h ∘ g = f`. -/
alias essFiniteType_localization_finite_prime :=
  Stacks.LocalizationOfFiniteAlgebra.localization_finite_prime_core

end Stacks.LocalizationOfFiniteAlgebra
