module

public import StacksFrontier.RingTheory.Henselian.Henselization.Defs
import StacksFrontier.RingTheory.Etale.FilteredColimit.Basic

/-!
# Henselization along a local ind-étale extension of the base

Let `R₀ → R → C` be local rings with `R` a filtered colimit of étale `R₀`-algebras and
`R₀ → R` local, and let `C` be a henselization of `R₀` with residue field `L`. If the residue
field extension `κ(R₀) ⊆ κ(R)` is trivial, then the same ring `C`, read as an `R`-algebra, is a
henselization of `R` with residue field `L`.

## Main results

* `IsLocalRing.IsHenselization.map_maximalIdeal_of_indEtale_tower`: the maximal ideal of `C` is
  extended from the maximal ideal of the intermediate ring `R`.
* `IsLocalRing.IsHenselization.isLocalHom_of_indEtale_tower`: the map `R → C` is local.
* `IsLocalRing.IsHenselization.of_indEtale_tower`: a henselization of `R₀` is a henselization of
  `R`.

## Implementation notes

All three rings live in one universe, as the ind-étale composition lemma
`CommAlgCat.ind_etale_of_comp` and the class `IsLocalRing.IsHenselization` both require; the
residue field `L` is in its own universe.

Locality of `R → C` is not an extra hypothesis: the maximal ideals of `R` and of `C` are both
extended from the maximal ideal of `R₀`, by `CommAlgCat.map_maximalIdeal_of_ind_etale` and by
`IsLocalRing.IsHenselization.map_maximalIdeal`, so the maximal ideal of `R` already generates the
maximal ideal of `C`.

`StacksDraft.exists_isHenselization_of_indEtale` is the variant at independent universes which
assumes locality of `R → C` and *produces* an `L`-structure on `κ(R)`; the statement here instead
derives locality and keeps a prescribed `L`-structure, which is what a consumer that already
carries one, such as Lemma 06DU, needs.

The triviality of `κ(R₀) ⊆ κ(R)` is needed, and is stated as surjectivity of
`algebraMap (ResidueField R₀) (ResidueField R)`: for a nontrivial finite separable extension
`κ(R₀) ⊆ κ(R)` a henselization of `R₀` with residue field `L` has residue field `L` over `κ(R₀)`
and cannot have residue field `L` over `κ(R)` compatibly with both inclusions unless the two
inclusions agree. The compatibility of the two `L`-structures is
`IsScalarTower (ResidueField R₀) (ResidueField R) L`.

## References

* [StacksProject 04GQ](https://stacks.math.columbia.edu/tag/04GQ), the definition
* [StacksProject 08HS](https://stacks.math.columbia.edu/tag/08HS), cancellation for ind-étale maps
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u v

namespace IsLocalRing.IsHenselization

variable {R₀ R C : Type u} [CommRing R₀] [IsLocalRing R₀] [CommRing R] [IsLocalRing R]
  [CommRing C] [IsLocalRing C] [Algebra R₀ R] [IsLocalHom (algebraMap R₀ R)]
  [Algebra R₀ C] [Algebra R C] [IsScalarTower R₀ R C]
  {L : Type v} [Field L] [Algebra (ResidueField R₀) L]

/-- The maximal ideal of a henselization `C` of a local ring `R₀` is generated by the maximal
ideal of any intermediate local ind-étale `R₀`-algebra `R`, both being generated by the maximal
ideal of `R₀`. -/
theorem map_maximalIdeal_of_indEtale_tower
    (hR : (CommAlgCat.etale.{u} R₀).ind.{u} (CommAlgCat.of R₀ R))
    [IsHenselization R₀ L C] :
    (maximalIdeal R).map (algebraMap R C) = maximalIdeal C := by
  have : IsLocalHom (algebraMap R₀ C) := isLocalHom (L := L)
  rw [← CommAlgCat.map_maximalIdeal_of_ind_etale hR, Ideal.map_map,
    ← IsScalarTower.algebraMap_eq R₀ R C]
  exact map_maximalIdeal (L := L)

/-- The structure map from an intermediate local ind-étale `R₀`-algebra to a henselization of
`R₀` is a local ring map. -/
theorem isLocalHom_of_indEtale_tower
    (hR : (CommAlgCat.etale.{u} R₀).ind.{u} (CommAlgCat.of R₀ R))
    [IsHenselization R₀ L C] :
    IsLocalHom (algebraMap R C) :=
  ((local_hom_TFAE (algebraMap R C)).out 3 1).mp
    (map_maximalIdeal_of_indEtale_tower (L := L) hR).le

/-- **A henselization of the base is a henselization of a local ind-étale extension.** Let
`R₀ → R` be a local map of local rings exhibiting `R` as a filtered colimit of étale
`R₀`-algebras and inducing a surjection on residue fields, and let `C` be a henselization of `R₀`
with residue field `L`. Then `C` is a henselization of `R` with residue field `L`. -/
theorem of_indEtale_tower [Algebra (ResidueField R) L]
    [IsScalarTower (ResidueField R₀) (ResidueField R) L]
    (hR : (CommAlgCat.etale.{u} R₀).ind.{u} (CommAlgCat.of R₀ R))
    (hres : Function.Surjective (algebraMap (ResidueField R₀) (ResidueField R)))
    [IsHenselization R₀ L C] :
    IsHenselization R L C := by
  have hlocal : IsLocalHom (algebraMap R C) := isLocalHom_of_indEtale_tower (L := L) hR
  refine of_ind_etale ‹IsHenselization R₀ L C›.henselian
    (CommAlgCat.ind_etale_of_comp hR (ind_etale_of_universe_le (R := R₀) L)) ?_
  obtain ⟨e, he⟩ := exists_residueFieldEquiv (R := R₀) (L := L) (Rh := C)
  refine ⟨e, fun y => ?_⟩
  obtain ⟨z, hz⟩ := hres (residue R y)
  obtain ⟨x, hx⟩ := residue_surjective (R := R₀) z
  have hxy : residue R (algebraMap R₀ R x) = residue R y := by
    rw [← ResidueField.algebraMap_residue (S := R) x, hx, hz]
  have hy : y - algebraMap R₀ R x ∈ maximalIdeal R := by
    rw [← residue_eq_zero_iff, map_sub, hxy, sub_self]
  calc e (algebraMap (ResidueField R) L (residue R y))
      = e (algebraMap (ResidueField R) L
          (algebraMap (ResidueField R₀) (ResidueField R) (residue R₀ x))) := by
        rw [ResidueField.algebraMap_residue, hxy]
    _ = e (algebraMap (ResidueField R₀) L (residue R₀ x)) := by
        rw [← IsScalarTower.algebraMap_apply]
    _ = residue C (algebraMap R₀ C x) := he x
    _ = residue C (algebraMap R C (algebraMap R₀ R x)) := by
        rw [IsScalarTower.algebraMap_apply R₀ R C]
    _ = residue C (algebraMap R C y) := by
        rw [eq_comm, ← sub_eq_zero, ← map_sub, ← map_sub, residue_eq_zero_iff]
        exact map_nonunit (algebraMap R C) _ hy

end IsLocalRing.IsHenselization

end
