module

public import Mathlib.RingTheory.Unramified.Basic
public import Mathlib.RingTheory.Unramified.Finite
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.Jacobson.Ideal
public import Mathlib.RingTheory.EssentialFiniteness
public import Mathlib.RingTheory.Ideal.IdempotentFG
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Algebra maps out of an unramified algebra are determined modulo the Jacobson radical

Two `R`-algebra maps `φ ψ : S → T` out of an unramified, essentially finite type `R`-algebra `S`
which agree modulo an ideal `I` of `T` contained in the Jacobson radical are equal.

Unramifiedness makes the kernel of the multiplication `S ⊗[R] S → S` an idempotent ideal
(`Ideal.cotangent_subsingleton_iff`); finite generation (`KaehlerDifferential.ideal_fg`) turns it
into the ideal generated by an idempotent `δ`. The two maps assemble into
`H : S ⊗[R] S →ₐ[R] T`, and agreement modulo `I` puts the idempotent `H δ` in the Jacobson
radical, so `H δ = 0`; since `s ⊗ 1 - 1 ⊗ s` is a multiple of `δ`, `φ s = ψ s`.

This is the faithfulness half of Lemma 04GK, needing neither finiteness of `S` nor henselianity.
The base file `StacksFrontier.RingTheory.Henselian.FiniteEtale` proves the special case
`I = 𝔪T`, `T` integral over a local `R`, privately.
-/

@[expose] public section

namespace Stacks.Henselian.FiniteEtaleEquivalence

open TensorProduct

/-- Two `R`-algebra maps out of an unramified, essentially finite type `R`-algebra `S` into an
`R`-algebra `T` which agree modulo an ideal `I` of `T` contained in the Jacobson radical are
equal.

This is the faithfulness half of Lemma 04GK, and it needs neither finiteness of `S` nor
henselianity of anything: unramifiedness makes the kernel of `S ⊗[R] S → S` generated by an
idempotent `δ`, the two maps assemble into `H : S ⊗[R] S →ₐ[R] T`, and agreement modulo `I` puts
the idempotent `H δ` in the Jacobson radical, so `H δ = 0`. Two instances are used: `I = 𝔪T` for
`T` integral over a local `R` (Lemma 04GK), and `I` the maximal ideal of a local `T`. -/
@[ega "IV 18.8.5" "more general"]
lemma algHom_ext_of_le_jacobson (R : Type*) [CommRing R] {S : Type*}
    [CommRing S] [Algebra R S] [Algebra.EssFiniteType R S] [Algebra.FormallyUnramified R S]
    {T : Type*} [CommRing T] [Algebra R T] {I : Ideal T}
    (hI : I ≤ Ideal.jacobson (⊥ : Ideal T)) {φ ψ : S →ₐ[R] T}
    (h : ∀ s : S, Ideal.Quotient.mk I (φ s) = Ideal.Quotient.mk I (ψ s)) :
    φ = ψ := by
  classical
  have idem_eq_zero_of_mem_jacobson : ∀ {x : T}, IsIdempotentElem x →
      x ∈ Ideal.jacobson (⊥ : Ideal T) → x = 0 := by
    intro x hx hmem
    have hu : IsUnit (1 - x) := by
      have := Ideal.mem_jacobson_bot.mp hmem (-1)
      simpa [sub_eq_add_neg, add_comm] using this
    have h0 : x * (1 - x) = 0 := by rw [mul_sub, mul_one, hx.eq, sub_self]
    simpa using (hu.mul_left_eq_zero).mp h0
  obtain ⟨δ, hδ, hspan⟩ :
    ∃ e, IsIdempotentElem e ∧ KaehlerDifferential.ideal R S = Ideal.span {e} :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg R S)).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton (Ω[S⁄R])
  set H : S ⊗[R] S →ₐ[R] T := Algebra.TensorProduct.lift φ ψ (fun _ _ => Commute.all _ _) with hH
  have key :
    (Ideal.Quotient.mkₐ R I).comp H =
      ((Ideal.Quotient.mkₐ R I).comp φ).comp (Algebra.TensorProduct.lmul' R) := by
    refine Algebra.TensorProduct.ext' fun a b => ?_
    simp [hH, Algebra.TensorProduct.lift_tmul, h b]
  have hδmem : δ ∈ KaehlerDifferential.ideal R S := by
    rw [hspan]; exact Ideal.mem_span_singleton_self _
  have hHδ : H δ = 0 := by
    refine idem_eq_zero_of_mem_jacobson (hδ.map H) (hI ?_)
    have hcong := AlgHom.congr_fun key δ
    simp only [AlgHom.comp_apply] at hcong
    rw [show (Algebra.TensorProduct.lmul' R (S := S)) δ = 0 from hδmem] at hcong
    simpa [Ideal.Quotient.eq_zero_iff_mem] using hcong
  ext s
  have hmem : s ⊗ₜ[R] (1 : S) - (1 : S) ⊗ₜ[R] s ∈ KaehlerDifferential.ideal R S := by
    simp [KaehlerDifferential.ideal, RingHom.mem_ker]
  rw [hspan, Ideal.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  have hz : H (s ⊗ₜ[R] (1 : S) - (1 : S) ⊗ₜ[R] s) = 0 := by rw [hc, map_mul, hHδ, zero_mul]
  rw [map_sub, hH] at hz
  simp only [Algebra.TensorProduct.lift_tmul, map_one, mul_one, one_mul, sub_eq_zero] at hz
  exact hz

end Stacks.Henselian.FiniteEtaleEquivalence
