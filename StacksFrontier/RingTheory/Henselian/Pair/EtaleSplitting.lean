module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.Idempotents
public import StacksFrontier.RingTheory.Henselian.Pair.LocalRing
public import StacksFrontier.RingTheory.Henselian.Pair.Operations
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Splitting an étale algebra over a henselian pair

Let `(A, I)` be a henselian pair and let `A'` be an étale `A`-algebra for which the induced map
`A ⧸ I → A' ⧸ I A'` is bijective. Then `A'` splits as a product `A × A''` of `A`-algebras, and the
projection onto the first factor reduces modulo `I` to the inverse of that bijection. In other
words the closed subscheme cut out by `I` meets `Spec A'` in exactly one sheet, and that sheet is
an open-and-closed copy of `Spec A`.

The general mechanism is separated out: an étale algebra `A'` admitting *any* `A`-algebra map
`τ : A' → A` splits as `A × A''`, with `τ` the first projection. This is the algebraic form of the
statement that a section of an étale morphism is an open immersion. The henselian hypothesis is
used only to produce `τ`, through the étale-lifting criterion for henselian pairs.

Also recorded are the two consequences of the closure properties of henselian pairs that an
algebra integral over a henselian local ring enjoys: the extension of the maximal ideal, and its
radical, both define henselian pairs.

## Main results

* `Algebra.Etale.exists_algEquiv_prod_of_algHom`: an étale algebra with an algebra map back to
  the base splits off the base as a factor.
* `Algebra.Etale.exists_isIdempotentElem_span_eq_ker`: the kernel of such an algebra map is
  generated by an idempotent, which is the datum cutting out the sheet.
* `exists_algEquiv_prod_of_etale_of_henselianPair`: the splitting over a henselian pair.
* `exists_algEquiv_prod_of_etale_of_isIntegral_of_henselianLocal`: the splitting for an algebra
  integral over a henselian local ring, at the radical of the extended maximal ideal.
* `exists_algEquiv_prod_of_etale_of_henselianPair_of_le` and
  `exists_algEquiv_prod_of_etale_of_isIntegral_of_henselianLocal_of_le`: the same splittings along
  an arbitrary ideal of `A'` above the extended one.
* `henselianPair_map_maximalIdeal_of_isIntegral` and
  `henselianPair_radical_map_maximalIdeal_of_isIntegral`: an algebra integral over a henselian
  local ring forms a henselian pair with the extension of the maximal ideal, and with its
  radical.

## Implementation notes

The splitting is returned as data: the existential carries an `AlgEquiv` together with the
equation identifying its first component, which determines the sheet of `Spec A'` being named.

Both rings are taken in the same universe, the shape in which the étale-lifting criterion
`henselianPair_tfae` is available.

## References

* [Stacks Project, Tag 09XI](https://stacks.math.columbia.edu/tag/09XI)
* [Stacks Project, Tag 09XJ](https://stacks.math.columbia.edu/tag/09XJ)
* [Stacks Project, Tag 09XK](https://stacks.math.columbia.edu/tag/09XK)
-/

@[expose] public section

universe u v

/-- The kernel of an algebra map from an étale algebra back to its base is generated by an
idempotent. -/
private theorem exists_isIdempotentElem_span_eq_ker_aux {A A' : Type u} [CommRing A] [CommRing A']
    [Algebra A A'] [Algebra.Etale A A'] (τ : A' →ₐ[A] A) :
    ∃ g : A', IsIdempotentElem g ∧ Ideal.span {g} = RingHom.ker τ := by
  have hτ : Function.Surjective τ := fun a => ⟨algebraMap A A' a, by simp⟩
  let _ : Algebra A' A := τ.toAlgebra
  have _ : IsScalarTower A A' A := .of_algebraMap_eq' τ.comp_algebraMap.symm
  have _ : Algebra.FormallyEtale A' A := .of_restrictScalars (R := A)
  have hsurj : Function.Surjective (algebraMap A' A) := hτ
  obtain ⟨g, hg, hspan⟩ := (Ideal.isIdempotentElem_iff_of_fg _
      (Algebra.FinitePresentation.ker_fG_of_surjective τ hτ)).mp
      ((Algebra.FormallyEtale.iff_of_surjective hsurj).mp inferInstance)
  exact ⟨g, hg, hspan.symm⟩

/-- An étale algebra admitting an algebra map back to its base splits off that base as a direct
factor, with the given map as the first projection. -/
theorem Algebra.Etale.exists_algEquiv_prod_of_algHom {A A' : Type u} [CommRing A] [CommRing A']
    [Algebra A A'] [Algebra.Etale A A'] (τ : A' →ₐ[A] A) :
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : Algebra A A'') (e : A' ≃ₐ[A] A × A''),
      ∀ x : A', (e x).1 = τ x := by
  obtain ⟨g, hg, hker⟩ := exists_isIdempotentElem_span_eq_ker_aux τ
  have hτ : Function.Surjective τ := fun a => ⟨algebraMap A A' a, by simp⟩
  have hmul : g * (1 - g) = 0 := by rw [mul_sub, mul_one, hg.eq, sub_self]
  let e₁ : A' ≃ₐ[A] (A' ⧸ Ideal.span {g}) × A' ⧸ Ideal.span {1 - g} :=
    AlgEquiv.prodQuotientOfIsIdempotentElem A hg hg.one_sub (by ring) hmul
  let e₂ : (A' ⧸ Ideal.span {g}) ≃ₐ[A] A :=
    (Ideal.quotientEquivAlgOfEq A hker).trans (Ideal.quotientKerAlgEquivOfSurjective hτ)
  refine ⟨A' ⧸ Ideal.span {1 - g}, inferInstance, inferInstance,
    e₁.trans (e₂.prodCongr AlgEquiv.refl), fun x => ?_⟩
  change Ideal.quotientKerAlgEquivOfSurjective hτ
      (Ideal.quotientEquivAlgOfEq A hker (Ideal.Quotient.mk (Ideal.span {g}) x)) = τ x
  rw [Ideal.quotientEquivAlgOfEq_mk, Ideal.quotientKerAlgEquivOfSurjective_mk]

/-- Splitting along an arbitrary ideal of `A'` above `I`, shared by the pair splittings. -/
private theorem exists_algEquiv_prod_of_etale_of_henselianPair_aux {A : Type u} [CommRing A]
    {I : Ideal A} (hI : HenselianPair A I) (A' : Type u) [CommRing A'] [Algebra A A']
    [Algebra.Etale A A'] {J' : Ideal A'} (hJ' : I ≤ J'.comap (algebraMap A A'))
    (hbij : Function.Bijective (Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ')) :
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : Algebra A A'') (τ : A' →ₐ[A] A)
      (e : A' ≃ₐ[A] A × A''),
      (∀ x : A', (e x).1 = τ x) ∧
        ∀ x : A', Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ'
            (Ideal.Quotient.mk I (τ x)) =
          Ideal.Quotient.mk J' x := by
  let qₐ : (A ⧸ I) →ₐ[A] (A' ⧸ J') := Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ'
  let qe : (A ⧸ I) ≃ₐ[A] (A' ⧸ J') := AlgEquiv.ofBijective qₐ hbij
  let σ : A' →ₐ[A] A ⧸ I := qe.symm.toAlgHom.comp (Ideal.Quotient.mkₐ A J')
  have hlift := ((henselianPair_tfae.{u, u} A I).out 1 2).mp hI
  obtain ⟨τ, hτ⟩ := hlift A' σ
  obtain ⟨A'', _, _, e, he⟩ := Algebra.Etale.exists_algEquiv_prod_of_algHom τ
  refine ⟨A'', inferInstance, inferInstance, τ, e, he, fun x => ?_⟩
  have h1 : Ideal.Quotient.mk I (τ x) = σ x := AlgHom.congr_fun hτ x
  have h2 : qₐ (σ x) = Ideal.Quotient.mk J' x := qe.apply_symm_apply _
  rw [h1]
  exact h2

/-- **Splitting an étale algebra over a henselian pair.** Let `(A, I)` be a henselian pair and
`A'` an étale `A`-algebra whose structure map induces a bijection `A ⧸ I → A' ⧸ I A'`. Then `A'`
splits as `A × A''`, and the first projection `τ` reduces modulo `I` to the inverse of that
bijection. -/
theorem exists_algEquiv_prod_of_etale_of_henselianPair {A : Type u} [CommRing A] (I : Ideal A)
    (hI : HenselianPair A I) (A' : Type u) [CommRing A'] [Algebra A A'] [Algebra.Etale A A']
    (hbij : Function.Bijective
      (Ideal.quotientMapₐ (I.map (algebraMap A A')) (Algebra.ofId A A') Ideal.le_comap_map)) :
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : Algebra A A'') (τ : A' →ₐ[A] A)
      (e : A' ≃ₐ[A] A × A''),
      (∀ x : A', (e x).1 = τ x) ∧
        ∀ x : A', Ideal.quotientMapₐ (I.map (algebraMap A A')) (Algebra.ofId A A')
            Ideal.le_comap_map (Ideal.Quotient.mk I (τ x)) =
          Ideal.Quotient.mk (I.map (algebraMap A A')) x := by
  exact exists_algEquiv_prod_of_etale_of_henselianPair_aux hI A' Ideal.le_comap_map hbij

/-- An algebra integral over a henselian local ring forms a henselian pair with the extension of
the maximal ideal. -/
theorem henselianPair_map_maximalIdeal_of_isIntegral {C : Type u} [CommRing C]
    [HenselianLocalRing C] (A : Type v) [CommRing A] [Algebra C A] [Algebra.IsIntegral C A] :
    HenselianPair A ((IsLocalRing.maximalIdeal C).map (algebraMap C A)) :=
  henselianPair_map_of_isIntegral (IsLocalRing.maximalIdeal C) (henselianPair_maximalIdeal C)

/-- An algebra integral over a henselian local ring forms a henselian pair with the radical of the
extension of the maximal ideal. -/
theorem henselianPair_radical_map_maximalIdeal_of_isIntegral {C : Type u} [CommRing C]
    [HenselianLocalRing C] (A : Type v) [CommRing A] [Algebra C A] [Algebra.IsIntegral C A] :
    HenselianPair A (((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical) :=
  (henselianPair_iff_of_zeroLocus_eq _ _ (PrimeSpectrum.zeroLocus_radical _).symm).mp
    (henselianPair_map_maximalIdeal_of_isIntegral A)

/-- **The idempotent cutting out the sheet of a section of an étale algebra.** If `A'` is an étale
`A`-algebra and `τ : A' →ₐ[A] A` is an `A`-algebra map, then the kernel of `τ` is generated by an
idempotent. Geometrically, the section of `Spec A' → Spec A` determined by `τ` has open and closed
image, cut out by that idempotent. -/
@[sga "7 XII 1.11" "special case"]
theorem Algebra.Etale.exists_isIdempotentElem_span_eq_ker {A A' : Type u} [CommRing A]
    [CommRing A'] [Algebra A A'] [Algebra.Etale A A'] (τ : A' →ₐ[A] A) :
    ∃ g : A', IsIdempotentElem g ∧ Ideal.span {g} = RingHom.ker τ := by
  exact exists_isIdempotentElem_span_eq_ker_aux τ

/-- **Splitting an étale algebra over an algebra integral over a henselian local ring.** Let `C` be
a henselian local ring with maximal ideal `m`, let `A` be a `C`-algebra integral over `C`, put
`J = √(m A)`, and let `A'` be an étale `A`-algebra for which `A ⧸ J → A' ⧸ J A'` is bijective. Then
`A'` splits as `A × A''`, and the first projection `τ` reduces modulo `J` to the inverse of that
bijection. -/
theorem exists_algEquiv_prod_of_etale_of_isIntegral_of_henselianLocal {C : Type u} [CommRing C]
    [HenselianLocalRing C] (A : Type u) [CommRing A] [Algebra C A] [Algebra.IsIntegral C A]
    (A' : Type u) [CommRing A'] [Algebra A A'] [Algebra.Etale A A']
    (hbij : Function.Bijective (Ideal.quotientMapₐ
      ((((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical).map (algebraMap A A'))
      (Algebra.ofId A A') Ideal.le_comap_map)) :
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : Algebra A A'') (τ : A' →ₐ[A] A)
      (e : A' ≃ₐ[A] A × A''),
      (∀ x : A', (e x).1 = τ x) ∧
        ∀ x : A', Ideal.quotientMapₐ
            ((((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical).map (algebraMap A A'))
            (Algebra.ofId A A') Ideal.le_comap_map
            (Ideal.Quotient.mk (((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical)
              (τ x)) =
          Ideal.Quotient.mk
            ((((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical).map
              (algebraMap A A')) x :=
  exists_algEquiv_prod_of_etale_of_henselianPair _
    (henselianPair_radical_map_maximalIdeal_of_isIntegral A) A' hbij

/-- **Splitting an étale algebra over a henselian pair, along an arbitrary ideal above the
extended one.** Let `(A, I)` be a henselian pair, let `A'` be an étale `A`-algebra, and let
`J' ⊆ A'` be *any* ideal containing the extension of `I` for which the induced map
`A ⧸ I → A' ⧸ J'` is bijective. Then `A'` splits as `A × A''`, and the first projection `τ`
reduces to the inverse of that bijection. The case `J' = I A'` is
`exists_algEquiv_prod_of_etale_of_henselianPair`. -/
theorem exists_algEquiv_prod_of_etale_of_henselianPair_of_le {A : Type u} [CommRing A]
    {I : Ideal A} (hI : HenselianPair A I) (A' : Type u) [CommRing A'] [Algebra A A']
    [Algebra.Etale A A'] {J' : Ideal A'} (hJ' : I ≤ J'.comap (algebraMap A A'))
    (hbij : Function.Bijective (Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ')) :
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : Algebra A A'') (τ : A' →ₐ[A] A)
      (e : A' ≃ₐ[A] A × A''),
      (∀ x : A', (e x).1 = τ x) ∧
        ∀ x : A', Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ'
            (Ideal.Quotient.mk I (τ x)) =
          Ideal.Quotient.mk J' x := by
  exact exists_algEquiv_prod_of_etale_of_henselianPair_aux hI A' hJ' hbij

/-- **Splitting an étale algebra over an algebra integral over a henselian local ring, along an
arbitrary ideal above the extended maximal ideal.** Let `C` be a henselian local ring with
maximal ideal `m`, let `A` be a `C`-algebra integral over `C`, put `J = √(m A)`, and let
`J' ⊆ A'` be any ideal of an étale `A`-algebra `A'` containing the extension of `J` and for
which `A ⧸ J → A' ⧸ J'` is bijective. Then `A'` splits as `A × A''`. -/
theorem exists_algEquiv_prod_of_etale_of_isIntegral_of_henselianLocal_of_le {C : Type u}
    [CommRing C] [HenselianLocalRing C] (A : Type u) [CommRing A] [Algebra C A]
    [Algebra.IsIntegral C A] (A' : Type u) [CommRing A'] [Algebra A A'] [Algebra.Etale A A']
    {J' : Ideal A'}
    (hJ' : (((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical) ≤
      J'.comap (algebraMap A A'))
    (hbij : Function.Bijective (Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ')) :
    ∃ (A'' : Type u) (_ : CommRing A'') (_ : Algebra A A'') (τ : A' →ₐ[A] A)
      (e : A' ≃ₐ[A] A × A''),
      (∀ x : A', (e x).1 = τ x) ∧
        ∀ x : A', Ideal.quotientMapₐ J' (Algebra.ofId A A') hJ'
            (Ideal.Quotient.mk
              (((IsLocalRing.maximalIdeal C).map (algebraMap C A)).radical) (τ x)) =
          Ideal.Quotient.mk J' x :=
  exists_algEquiv_prod_of_etale_of_henselianPair_of_le
    (henselianPair_radical_map_maximalIdeal_of_isIntegral A) A' hJ' hbij

end
