-/

@[expose] public section

open IsLocalRing

universe u

namespace IsLocalRing.IsHenselization

variable {R S Rp Sq Rh T Sh : Type u}
  [CommRing R] [CommRing S] [CommRing Rp] [CommRing Sq] [CommRing Rh] [CommRing T] [CommRing Sh]
  [Algebra R S] (p : Ideal R) (q : Ideal S) [p.IsPrime] [q.IsPrime] [q.LiesOver p]
  [IsLocalRing Rp] [Algebra R Rp] [IsLocalization.AtPrime Rp p]
  [IsLocalRing Sq] [Algebra S Sq] [IsLocalization.AtPrime Sq q]
  [Algebra R Sq] [Algebra Rp Sq] [IsScalarTower R S Sq] [IsScalarTower R Rp Sq]
  [IsLocalRing Rh] [Algebra Rp Rh] [IsHenselization Rp (ResidueField Rp) Rh]
  [Algebra Rp T] [Algebra Rh T] [Algebra Sq T] [IsScalarTower Rp Rh T] [IsScalarTower Rp Sq T]
  [Algebra.IsPushout Rp Sq Rh T]

include p q in
/-- For a prime `q` over `p`, the localization map `R_p → S_q` is local. -/
private theorem isLocalHom_algebraMap_localization : IsLocalHom (algebraMap Rp Sq) := by
  have hpq : (maximalIdeal Sq).comap (algebraMap R Sq) = p := by
    rw [IsScalarTower.algebraMap_eq R S Sq, ← Ideal.comap_comap,
      show (maximalIdeal Sq).comap (algebraMap S Sq) = q from
        IsLocalization.AtPrime.under_maximalIdeal Sq q]
    exact (Ideal.LiesOver.over).symm
  have hle : maximalIdeal Rp ≤ (maximalIdeal Sq).comap (algebraMap Rp Sq) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p Rp, Ideal.map_le_iff_le_comap,
      Ideal.comap_comap, ← IsScalarTower.algebraMap_eq R Rp Sq, hpq]
  exact ⟨fun a ha => notMem_maximalIdeal.mp fun hm => notMem_maximalIdeal.mpr ha (hle hm)⟩

include p q Rp Rh in
/-- Every element of `T = R_p^h ⊗_{R_p} S_q` is congruent to an element of `S_q` modulo the
ideal `𝔪_{S_q} T`: `R_p^h = R_p + 𝔪_{R_p} R_p^h` because `R_p → R_p^h` has trivial residue field
extension and `𝔪_{R_p} R_p^h = 𝔪_{R_p^h}`. -/
private theorem exists_sub_mem_map_maximalIdeal (t : T) :
    ∃ s : Sq, t - algebraMap Sq T s ∈ (maximalIdeal Sq).map (algebraMap Sq T) := by
  have := isLocalHom_algebraMap_localization (Rp := Rp) (Sq := Sq) p q
  have := isLocalHom (R := Rp) (L := ResidueField Rp) (Rh := Rh)
  set Q := (maximalIdeal Sq).map (algebraMap Sq T)
  -- the image of `𝔪_{R_p^h}` in `T` lies in `Q`
  have hRh : ∀ m ∈ maximalIdeal Rh, algebraMap Rh T m ∈ Q := by
    intro m hm
    rw [← map_maximalIdeal (R := Rp) (L := ResidueField Rp) (Rh := Rh)] at hm
    have h1 : algebraMap Rh T m ∈ (maximalIdeal Rp).map (algebraMap Rp T) := by
      rw [IsScalarTower.algebraMap_eq Rp Rh T, ← Ideal.map_map]
      exact Ideal.mem_map_of_mem _ hm
    have h2 : (maximalIdeal Rp).map (algebraMap Rp T) ≤ Q := by
      rw [IsScalarTower.algebraMap_eq Rp Sq T, ← Ideal.map_map]
      refine Ideal.map_mono ?_
      exact ((local_hom_TFAE (algebraMap Rp Sq)).out 1 3).mp ‹_›
    exact h2 h1
  refine (Algebra.IsPushout.out (R := Rp) (S := Sq) (R' := Rh) (S' := T)).inductionOn t
    (motive := fun x => ∃ s : Sq, x - algebraMap Sq T s ∈ Q) ?_ ?_ ?_
  · intro a
    obtain ⟨b, hb⟩ := (residueField_map_bijective (R := Rp) (Rh := Rh)).2 (residue Rh a)
    obtain ⟨r, rfl⟩ := residue_surjective b
    rw [ResidueField.map_residue, eq_comm, ← sub_eq_zero, ← map_sub, residue_eq_zero_iff] at hb
    refine ⟨algebraMap Rp Sq r, ?_⟩
    have := hRh _ hb
    rwa [map_sub, ← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply Rp Sq T] at this
  · rintro s x ⟨s', hs'⟩
    refine ⟨s * s', ?_⟩
    rw [Algebra.smul_def, map_mul, ← mul_sub]
    exact Q.mul_mem_left _ hs'
  · rintro x y ⟨s, hs⟩ ⟨s', hs'⟩
    refine ⟨s + s', ?_⟩
    rw [map_add, add_sub_add_comm]
    exact Q.add_mem hs hs'

variable [IsLocalRing Sh] [Algebra Sq Sh] [IsHenselization Sq (ResidueField Sq) Sh]
  [Algebra Rh Sh] [IsLocalHom (algebraMap Rh Sh)] [Algebra Rp Sh] [IsScalarTower Rp Rh Sh]
  [IsScalarTower Rp Sq Sh] [Algebra T Sh] [IsScalarTower Rh T Sh] [IsScalarTower Sq T Sh]

omit [Algebra Rh Sh] [IsLocalHom (algebraMap Rh Sh)] [Algebra Rp Sh] [IsScalarTower Rp Rh Sh]
  [IsScalarTower Rp Sq Sh] [IsScalarTower Rh T Sh] in
include p q Rp Rh in
/-- The ideal `𝔪_{S_q} T` of `T = R_p^h ⊗_{R_p} S_q` is the inverse image of `𝔪_{S_q^h}`. -/
private theorem map_maximalIdeal_eq_comap :
    (maximalIdeal Sq).map (algebraMap Sq T) = (maximalIdeal Sh).comap (algebraMap T Sh) := by
  have := isLocalHom (R := Sq) (L := ResidueField Sq) (Rh := Sh)
  have hSq : (maximalIdeal Sh).comap (algebraMap Sq Sh) = maximalIdeal Sq :=
    ((local_hom_TFAE (algebraMap Sq Sh)).out 1 5).mp ‹_›
  have hle : (maximalIdeal Sq).map (algebraMap Sq T) ≤
      (maximalIdeal Sh).comap (algebraMap T Sh) := by
    rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, hSq]
  refine le_antisymm hle fun t ht => ?_
  obtain ⟨s, hs⟩ := exists_sub_mem_map_maximalIdeal (Rp := Rp) (Sq := Sq) (Rh := Rh) p q t
  have hsm : s ∈ maximalIdeal Sq := by
    rw [← hSq, Ideal.mem_comap, IsScalarTower.algebraMap_apply Sq T Sh,
      show algebraMap T Sh (algebraMap Sq T s) =
        algebraMap T Sh t - algebraMap T Sh (t - algebraMap Sq T s) by rw [map_sub]; ring]
    exact Ideal.sub_mem _ ht (hle hs)
  rw [show t = (t - algebraMap Sq T s) + algebraMap Sq T s by ring]
  exact Ideal.add_mem _ hs (Ideal.mem_map_of_mem _ hsm)

variable (Rp) in
include p Rp in
/-- **Henselization and quasi-finite ring maps** (Stacks 05WP). Let `R → S` be of finite type,
let `q` be a prime of `S` lying over `p`, and assume `R → S` is quasi-finite at `q`. Let `Rh` and
`Sh` be henselizations of `R_p` and `S_q`, let `Rh → Sh` be the local ring map over `R_p → S_q`
of Lemma 04GS, and let `T = Rh ⊗_{R_p} S_q`, mapping to `Sh` through the square. Then the ideal
`𝔪_{S_q} T` generated by `q` is prime, `Sh` is the localization of `T` at it, and `Sh` is finite
over `Rh`. -/
@[stacks 05WP "The square of Lemma 04GS is the algebra structure `algebraMap Rh Sh`, local and
compatible with `R_p → S_q → S_q^h` — conditions which by Lemma 04GS determine it — and the
tensor product is any `Algebra.IsPushout Rp Sq Rh T`, whose map to `S_q^h` is the algebra
structure `algebraMap T Sh` compatible with `Rh` and `S_q`. The prime generated by `q` is
`𝔪_{S_q} T`. Quasi-finiteness at `q` is `Algebra.FiniteType R S` with
`Algebra.QuasiFiniteAt R q`, as in Lemma 04GH. See the module docstring."]
theorem isLocalization_and_finite_of_quasiFiniteAt
    [Algebra.FiniteType R S] [Algebra.QuasiFiniteAt R q] :
    ∃ _ : ((maximalIdeal Sq).map (algebraMap Sq T)).IsPrime,
      IsLocalization.AtPrime Sh ((maximalIdeal Sq).map (algebraMap Sq T)) ∧
        Module.Finite Rh Sh := by
  set Q := (maximalIdeal Sq).map (algebraMap Sq T) with hQdef
  have hQ : Q = (maximalIdeal Sh).comap (algebraMap T Sh) :=
    map_maximalIdeal_eq_comap p q (Rp := Rp) (Rh := Rh)
  have hQprime : Q.IsPrime := hQ ▸ Ideal.comap_isPrime _ _
  refine ⟨hQprime, ?_⟩
  have hRpSq := isLocalHom_algebraMap_localization (Rp := Rp) (Sq := Sq) p q
  have hRpRh := isLocalHom (R := Rp) (L := ResidueField Rp) (Rh := Rh)
  have hSqSh := isLocalHom (R := Sq) (L := ResidueField Sq) (Rh := Sh)
  have hRhhens := henselian (R := Rp) (L := ResidueField Rp) (Rh := Rh)
  have hShhens := henselian (R := Sq) (L := ResidueField Sq) (Rh := Sh)
  have hRhind := ind_etale_of_universe_le (R := Rp) (L := ResidueField Rp) (Rh := Rh)
  have hShind := ind_etale_of_universe_le (R := Sq) (L := ResidueField Sq) (Rh := Sh)
  have hSq : (maximalIdeal Sh).comap (algebraMap Sq Sh) = maximalIdeal Sq :=
    ((local_hom_TFAE (algebraMap Sq Sh)).out 1 5).mp ‹_›
  have hRh : (maximalIdeal Sh).comap (algebraMap Rh Sh) = maximalIdeal Rh :=
    ((local_hom_TFAE (algebraMap Rh Sh)).out 1 5).mp ‹_›
  let S' := Localization.AtPrime Q
  -- the contractions of `Q`
  have hQRh : Q.comap (algebraMap Rh T) = maximalIdeal Rh := by
    rw [hQ, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, hRh]
  have hQSq : Q.comap (algebraMap Sq T) = maximalIdeal Sq := by
    rw [hQ, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, hSq]
  -- Step 1 (Lemmas 00PN and 04GH): `S'` is henselian and finite over `Rh`.
  -- the algebra structures over `R` obtained from the tower through `Rp`
  let _ : Algebra R Rh := ((algebraMap Rp Rh).comp (algebraMap R Rp)).toAlgebra
  have towRRpRh : IsScalarTower R Rp Rh := .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  let _ : Algebra R T := ((algebraMap Rp T).comp (algebraMap R Rp)).toAlgebra
  have towRRpT : IsScalarTower R Rp T := .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  have towRRhT : IsScalarTower R Rh T := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply R Rp Rh, ← IsScalarTower.algebraMap_apply Rp Rh T]
    exact IsScalarTower.algebraMap_apply R Rp T x
  have towRSqT : IsScalarTower R Sq T := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply R Rp Sq, ← IsScalarTower.algebraMap_apply Rp Sq T]
    exact IsScalarTower.algebraMap_apply R Rp T x
  let _ : Algebra S T := ((algebraMap Sq T).comp (algebraMap S Sq)).toAlgebra
  have towSSqT : IsScalarTower S Sq T := .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  have towRST : IsScalarTower R S T := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply S Sq T, ← IsScalarTower.algebraMap_apply R S Sq]
    exact IsScalarTower.algebraMap_apply R Sq T x
  -- `Sq` is its own base change along the localization `R → Rp`
  have hunitp : Algebra.algebraMapSubmonoid Sq p.primeCompl ≤ IsUnit.submonoid Sq := by
    rintro _ ⟨r, hr, rfl⟩
    rw [IsScalarTower.algebraMap_apply R Rp Sq]
    exact ((IsLocalization.AtPrime.isUnit_to_map_iff Rp p r).mpr hr).map _
  have _ : IsLocalization (Algebra.algebraMapSubmonoid Sq p.primeCompl) Sq :=
    IsLocalization.of_le_isUnit hunitp
  have hpo1 : Algebra.IsPushout R Rp Sq Sq :=
    (Algebra.isPushout_of_isLocalization (S := p.primeCompl) (A := Rp) (T := Sq) (B := Sq)).symm
  -- so `T` is also the base change of `Sq` along `R → Rh`
  have hpo2 : Algebra.IsPushout R Sq Rh T :=
    ((Algebra.IsPushout.comp_iff R Rp Sq Sq (T := Rh) (T' := T)).mpr
      (Algebra.IsPushout.symm inferInstance)).symm
  -- the finite type `Rh`-algebra `U = Rh ⊗[R] S`
  let _ : Algebra S (TensorProduct R Rh S) := Algebra.TensorProduct.rightAlgebra
  have towRSU : IsScalarTower R S (TensorProduct R Rh S) :=
    Algebra.TensorProduct.right_isScalarTower
  have hpo3 : Algebra.IsPushout R S Rh (TensorProduct R Rh S) := TensorProduct.isPushout'
  let ρ : TensorProduct R Rh S →ₐ[Rh] T :=
    Algebra.TensorProduct.lift (Algebra.ofId Rh T) (IsScalarTower.toAlgHom R S T)
      fun _ _ => Commute.all _ _
  let _ : Algebra (TensorProduct R Rh S) T := (ρ : TensorProduct R Rh S →+* T).toAlgebra
  have towRhUT : IsScalarTower Rh (TensorProduct R Rh S) T :=
    .of_algebraMap_eq fun x => (ρ.commutes x).symm
  have towSUT : IsScalarTower S (TensorProduct R Rh S) T := .of_algebraMap_eq fun x => by
    change algebraMap S T x = ρ (1 ⊗ₜ x)
    rw [Algebra.TensorProduct.lift_tmul]
    simp
  have towRUT : IsScalarTower R (TensorProduct R Rh S) T :=
    .of_algebraMap_eq fun x => by
      rw [IsScalarTower.algebraMap_apply R S T,
        IsScalarTower.algebraMap_apply S (TensorProduct R Rh S) T,
        ← IsScalarTower.algebraMap_apply R S (TensorProduct R Rh S)]
  have hpo4 : Algebra.IsPushout S (TensorProduct R Rh S) Sq T :=
    ((Algebra.IsPushout.comp_iff R S Rh (TensorProduct R Rh S)
      (T := Sq) (T' := T)).mp hpo2).symm
  -- `T` is a localization of `U`, hence `S'` is a localization of `U` at a prime
  have hlocU : IsLocalization
      (Algebra.algebraMapSubmonoid (TensorProduct R Rh S) q.primeCompl) T :=
    (Algebra.isLocalization_iff_isPushout q.primeCompl Sq).mpr hpo4
  have towRhUS' : IsScalarTower Rh (TensorProduct R Rh S) S' := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply Rh T S',
      IsScalarTower.algebraMap_apply Rh (TensorProduct R Rh S) T,
      ← IsScalarTower.algebraMap_apply (TensorProduct R Rh S) T S']
  set q' : Ideal (TensorProduct R Rh S) := Q.comap (algebraMap (TensorProduct R Rh S) T) with hq'
  have hq'prime : q'.IsPrime := Ideal.comap_isPrime _ _
  have hlocS' : IsLocalization.AtPrime S' q' :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Algebra.algebraMapSubmonoid (TensorProduct R Rh S) q.primeCompl) S' Q
  -- the prime `q'` lies over the maximal ideal of `Rh`, and `U` is quasi-finite there (00PN)
  have hlies : q'.LiesOver (maximalIdeal Rh) := ⟨by
    rw [Ideal.under_def, hq', Ideal.comap_comap,
      ← IsScalarTower.algebraMap_eq Rh (TensorProduct R Rh S) T, hQRh]⟩
  have hkerS : Q.comap (algebraMap S T) = q := by
    rw [IsScalarTower.algebraMap_eq S Sq T, ← Ideal.comap_comap, hQSq]
    exact IsLocalization.AtPrime.under_maximalIdeal Sq q
  have hkerq : q = q'.comap
      (Algebra.TensorProduct.includeRight.toRingHom : S →+* TensorProduct R Rh S) := by
    rw [show (Algebra.TensorProduct.includeRight.toRingHom : S →+* TensorProduct R Rh S)
        = algebraMap S (TensorProduct R Rh S) from rfl, hq', Ideal.comap_comap,
      ← IsScalarTower.algebraMap_eq S (TensorProduct R Rh S) T, hkerS]
  have hqf : Algebra.QuasiFiniteAt Rh q' := Algebra.QuasiFiniteAt.baseChange q q' hkerq
  obtain ⟨hS'hens, hfinS'⟩ :=
    (HenselianLocalRing.henselianLocalRing_and_finite_of_finite_of_quasiFiniteAt Rh).2.2.1
      (TensorProduct R Rh S) (Algebra.FiniteType.baseChange Rh) q' hqf S'
  -- Step 2: `S'` is a filtered colimit of étale `Sq`-algebras, being a localization of `T`,
  -- which is ind-étale over `Sq` by Lemma 0BSH.
  have hindS' : (CommAlgCat.etale.{u} Sq).ind.{u} (CommAlgCat.of Sq S') :=
    CommAlgCat.ind_etale_comp (CommAlgCat.ind_etale_of_isPushout Rp Sq Rh T hRhind)
      (CommAlgCat.ind_etale_atPrime T S' Q)
  -- Step 3 (Lemma 08HT): `S'` and `Sh` are isomorphic over `Sq`.
  have hunit : ∀ y : Q.primeCompl, IsUnit ((residue Sh).comp (algebraMap T Sh) y) := by
    intro y
    refine isUnit_iff_ne_zero.mpr fun h => y.2 (hQ.ge ?_)
    rwa [Ideal.mem_comap, ← residue_eq_zero_iff]
  let φ : S' →+* ResidueField Sh := IsLocalization.lift (M := Q.primeCompl) hunit
  have hφ : ∀ x : T, φ (algebraMap T S' x) = residue Sh (algebraMap T Sh x) := fun x =>
    IsLocalization.lift_eq _ x
  let pS' : S' →ₐ[Sq] ResidueField Sh :=
    { φ with
      commutes' := fun s => by
        change φ (algebraMap Sq S' s) = algebraMap Sq (ResidueField Sh) s
        rw [IsScalarTower.algebraMap_apply Sq T S', hφ, ← IsScalarTower.algebraMap_apply,
          IsScalarTower.algebraMap_apply Sq Sh (ResidueField Sh)]
        rfl }
  let pSh : Sh →ₐ[Sq] ResidueField Sh := IsScalarTower.toAlgHom Sq Sh (ResidueField Sh)
  have hpSh : Function.Surjective pSh := residue_surjective
  have hpS' : Function.Surjective pS' := fun y => by
    obtain ⟨b, hb⟩ := (residueField_map_bijective (R := Sq) (Rh := Sh)).2 y
    obtain ⟨s, rfl⟩ := residue_surjective b
    refine ⟨algebraMap Sq S' s, ?_⟩
    rw [AlgHom.commutes, ← hb, ResidueField.map_residue]
    rfl
  obtain ⟨e, -⟩ :=
    HenselianLocalRing.existsUnique_algEquiv_of_ind_etale hindS' hShind pS' pSh hpS' hpSh
  -- Step 4 (Lemma 04GS): `e` is compatible with `Rh`.
  have hRpSh : IsLocalHom (algebraMap Rp Sh) := by
    rw [IsScalarTower.algebraMap_eq Rp Sq Sh]
    infer_instance
  have hfu := HenselianLocalRing.indEtaleAlgHom_unique (Sh := Sh)
    ((CommAlgCat.etale Rp).ind.prop_of_iso
      (CommAlgCat.isoMk (ULift.algEquiv (R := Rp) (A := Rh)).symm) hRhind)
    (residueField_map_bijective (R := Rp) (Rh := Rh)).2
  have hcommRp : ∀ r : Rp, algebraMap Rh S' (algebraMap Rp Rh r) =
      algebraMap Sq S' (algebraMap Rp Sq r) := fun r => by
    rw [IsScalarTower.algebraMap_apply Rh T S', IsScalarTower.algebraMap_apply Sq T S',
      ← IsScalarTower.algebraMap_apply Rp Rh T, ← IsScalarTower.algebraMap_apply Rp Sq T]
  let f₁ : Rh →ₐ[Rp] Sh :=
    { (e : S' →+* Sh).comp (algebraMap Rh S') with
      commutes' := fun r => by
        change e (algebraMap Rh S' (algebraMap Rp Rh r)) = algebraMap Rp Sh r
        rw [hcommRp, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply] }
  have hf₁loc : IsLocalHom f₁ := by
    have hS'max : (maximalIdeal Sh).comap (e : S' →+* Sh) = maximalIdeal S' :=
      maximalIdeal_comap _
    have hmax : (maximalIdeal Sh).comap (f₁ : Rh →+* Sh) = maximalIdeal Rh := by
      change (maximalIdeal Sh).comap
        (((e : S' →+* Sh).comp (algebraMap T S')).comp (algebraMap Rh T)) = _
      rw [← Ideal.comap_comap, ← Ideal.comap_comap, hS'max,
        show (maximalIdeal S').comap (algebraMap T S') = Q from
          IsLocalization.AtPrime.under_maximalIdeal S' Q, hQRh]
    have : IsLocalHom (f₁ : Rh →+* Sh) :=
      ((local_hom_TFAE (f₁ : Rh →+* Sh)).out 5 1).mp hmax
    exact ⟨fun a ha => this.map_nonunit a ha⟩
  have hf₀loc : IsLocalHom (IsScalarTower.toAlgHom Rp Rh Sh) :=
    ⟨fun a ha => (inferInstance : IsLocalHom (algebraMap Rh Sh)).map_nonunit a ha⟩
  have heRh : ∀ a : Rh, e (algebraMap Rh S' a) = algebraMap Rh Sh a :=
    AlgHom.congr_fun ((hfu f₁ hf₁loc).trans (hfu _ hf₀loc).symm)
  -- Step 5: `e` is compatible with `T`, by the universal property of the pushout.
  have heT : ∀ x : T, e (algebraMap T S' x) = algebraMap T Sh x := fun x => by
    refine (Algebra.IsPushout.out (R := Rp) (S := Sq) (R' := Rh) (S' := T)).inductionOn x
      (motive := fun x => e (algebraMap T S' x) = algebraMap T Sh x) ?_ ?_ ?_
    · intro a
      change e (algebraMap T S' (algebraMap Rh T a)) = algebraMap T Sh (algebraMap Rh T a)
      rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, heRh]
    · intro s y hy
      rw [Algebra.smul_def, map_mul, map_mul, map_mul, hy, ← IsScalarTower.algebraMap_apply,
        AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply]
    · intro y z hy hz
      rw [map_add, map_add, map_add, hy, hz]
  -- Step 6: conclusion.
  let eT : S' ≃ₐ[T] Sh := { e.toRingEquiv with commutes' := heT }
  let eRh : S' ≃ₐ[Rh] Sh := { e.toRingEquiv with commutes' := heRh }
  exact ⟨IsLocalization.isLocalization_of_algEquiv Q.primeCompl eT,
    Module.Finite.equiv eRh.toLinearEquiv⟩

end IsLocalRing.IsHenselization

/-! ### Strict henselizations and tensor products (Stacks 0GIP) -/

namespace IntermediateField

/-- Let `K / K₀` be an algebraic extension of a separably closed field, and let `K₁ → K` be a
field map over which `K` is separable. An intermediate field `K₀ ⊆ F ⊆ K` containing the image
of `K₁` is all of `K`: `K` is separable over `F`, and purely inseparable over `F` because it is so
over the separably closed `K₀`. -/
theorem eq_top_of_isSepClosed {K₀ K₁ K : Type*} [Field K₀] [Field K₁] [Field K]
    [Algebra K₀ K] [Algebra K₁ K] [IsSepClosed K₀] [Algebra.IsAlgebraic K₀ K]
    [Algebra.IsSeparable K₁ K] (F : IntermediateField K₀ K)
    (hF : ∀ x : K₁, algebraMap K₁ K x ∈ F) : F = ⊤ := by
  have : IsPurelyInseparable K₀ K := inferInstance
  have : IsPurelyInseparable F K := IsPurelyInseparable.tower_top K₀ F K
  refine eq_top_iff.mpr fun y _ => ?_
  let φ : K₁ →+* F := (algebraMap K₁ K).codRestrict F.toSubalgebra.toSubring hF
  have hφ : (algebraMap F K).comp φ = algebraMap K₁ K := rfl
  have hsep : IsSeparable F y := by
    refine Polynomial.Separable.of_dvd
      (Polynomial.Separable.map (Algebra.IsSeparable.isSeparable K₁ y) (f := φ))
      (minpoly.dvd F y ?_)
    rw [Polynomial.aeval_def, Polynomial.eval₂_map, hφ, ← Polynomial.aeval_def, minpoly.aeval]
  obtain ⟨z, rfl⟩ := IsPurelyInseparable.inseparable F y hsep
  exact z.2

end IntermediateField

namespace IsLocalRing.IsHenselization

open scoped TensorProduct
open CategoryTheory Limits

/-- The algebra structures `R → S_q`, `R_p → S_q` and `R_p → S^sh` induced by a ring map
`R → S`, a prime `q` over `p`, and a map `R^sh → S^sh` over `R → S`, with their scalar towers. -/
private theorem exists_algebra_localization
    {R S Rp Sq Rsh Ssh : Type u} [CommRing R] [CommRing S] [CommRing Rp] [CommRing Sq]
    [CommRing Rsh] [CommRing Ssh] [Algebra R S]
    (p : Ideal R) (q : Ideal S) [p.IsPrime] [q.IsPrime] [q.LiesOver p]
    [Algebra R Rp] [IsLocalization.AtPrime Rp p] [Algebra S Sq] [IsLocalization.AtPrime Sq q]
    [Algebra Rp Rsh] [Algebra R Rsh] [IsScalarTower R Rp Rsh]
    [Algebra Sq Ssh] [Algebra S Ssh] [IsScalarTower S Sq Ssh]
    [Algebra Rsh Ssh] [Algebra R Ssh] [IsScalarTower R Rsh Ssh] [IsScalarTower R S Ssh] :
    ∃ (_ : Algebra R Sq) (_ : Algebra Rp Sq) (_ : Algebra Rp Ssh),
      IsScalarTower R S Sq ∧ IsScalarTower R Rp Sq ∧ IsScalarTower Rp Rsh Ssh ∧
        IsScalarTower R Rp Ssh ∧ IsScalarTower Rp Sq Ssh := by
  have hpq : p.primeCompl ≤ q.primeCompl.comap (algebraMap R S) := fun x hx hq =>
    hx (by rwa [Ideal.LiesOver.over (P := q) (p := p)])
  let _ : Algebra R Sq := ((algebraMap S Sq).comp (algebraMap R S)).toAlgebra
  have towRSSq : IsScalarTower R S Sq := .of_algebraMap_eq' rfl
  let _ : Algebra Rp Sq := (IsLocalization.map Sq (algebraMap R S) hpq : Rp →+* Sq).toAlgebra
  have towRRpSq : IsScalarTower R Rp Sq := .of_algebraMap_eq fun x => by
    change _ = IsLocalization.map Sq (algebraMap R S) hpq (algebraMap R Rp x)
    rw [IsLocalization.map_eq]
    rfl
  let _ : Algebra Rp Ssh := ((algebraMap Rsh Ssh).comp (algebraMap Rp Rsh)).toAlgebra
  have towRpRshSsh : IsScalarTower Rp Rsh Ssh := .of_algebraMap_eq' rfl
  have towRRpSsh : IsScalarTower R Rp Ssh := .of_algebraMap_eq fun x => by
    change _ = algebraMap Rsh Ssh (algebraMap Rp Rsh (algebraMap R Rp x))
    rw [← IsScalarTower.algebraMap_apply R Rp Rsh, ← IsScalarTower.algebraMap_apply R Rsh Ssh]
  have towRpSqSsh : IsScalarTower Rp Sq Ssh := by
    refine .of_algebraMap_eq' (IsLocalization.ringHom_ext p.primeCompl (RingHom.ext fun x => ?_))
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply R Rp Sq, IsScalarTower.algebraMap_apply R S Sq,
      ← IsScalarTower.algebraMap_apply S Sq Ssh, ← IsScalarTower.algebraMap_apply R S Ssh,
      ← IsScalarTower.algebraMap_apply R Rp Ssh]
  exact ⟨_, _, _, towRSSq, towRRpSq, towRpRshSsh, towRRpSsh, towRpSqSsh⟩

/-- Two ring maps from a henselization `R_h` of `R_p` to a henselian local ring `X`, which agree on
`R_p` and agree after a surjection of `X` onto a field, are equal. -/
private theorem ringHom_ext_of_comp_eq_of_surjective {Rp Rh X K : Type u} [CommRing Rp]
    [CommRing Rh] [CommRing X] [Field K] [IsLocalRing Rp] [IsLocalRing Rh] [Algebra Rp Rh]
    [IsLocalHom (algebraMap Rp Rh)] [IsHenselization Rp (ResidueField Rh) Rh] [HenselianLocalRing X]
    {f g : Rh →+* X}
    (hfg : f.comp (algebraMap Rp Rh) = g.comp (algebraMap Rp Rh)) {π : X →+* K}
    (hπ : Function.Surjective π) (h : ∀ x, π (f x) = π (g x)) : f = g := by
  let _ : Algebra Rp X := (f.comp (algebraMap Rp Rh)).toAlgebra
  let _ : Algebra Rp K := (π.comp (algebraMap Rp X)).toAlgebra
  let πA : X →ₐ[Rp] K := { π with commutes' := fun _ => rfl }
  let f' : Rh →ₐ[Rp] X := { f with commutes' := fun _ => rfl }
  let g' : Rh →ₐ[Rp] X := { g with commutes' := RingHom.congr_fun hfg.symm }
  have hu := HenselianLocalRing.existsUnique_algHom_comp_of_ind_etale
    (ind_etale_of_universe_le (R := Rp) (L := ResidueField Rh) (Rh := Rh)) (πA.comp f') πA hπ
  exact RingHom.ext fun x => AlgHom.congr_fun
    (hu.unique (y₁ := f') rfl (y₂ := g') (AlgHom.ext fun x => (h x).symm)) x

/-- **The map of strict henselizations along a quasi-finite ring map.** Let `R → S` be of finite
type and quasi-finite at the prime `q` over `p`, let `R^sh` and `S^sh` be strict henselizations of
`R_p` and `S_q`, and let `R^sh → S^sh` be a local ring map over `R → S`. Then `R^sh → S^sh` is
finite, and the residue field extension is finite and purely inseparable.

This is Lemma 05WR, which constructs one strict henselization of `S_q` as a localization of
`R^sh ⊗_{R_p} S_q` with these properties, transported to the given `S^sh` along the isomorphism of
Lemma 08HT; the uniqueness of Lemma 08HR identifies the given `R^sh → S^sh` with the constructed
one. -/
theorem finite_and_isPurelyInseparable_of_quasiFiniteAt
    {R S Rp Sq Rsh Ssh : Type u} [CommRing R] [CommRing S] [CommRing Rp] [CommRing Sq]
    [CommRing Rsh] [CommRing Ssh] [Algebra R S]
    (p : Ideal R) (q : Ideal S) [p.IsPrime] [q.IsPrime] [q.LiesOver p]
    [Algebra.FiniteType R S] [Algebra.QuasiFiniteAt R q]
    [IsLocalRing Rp] [Algebra R Rp] [IsLocalization.AtPrime Rp p]
    [IsLocalRing Sq] [Algebra S Sq] [IsLocalization.AtPrime Sq q]
    [IsLocalRing Rsh] [Algebra Rp Rsh] [Algebra R Rsh] [IsScalarTower R Rp Rsh]
    [IsLocalHom (algebraMap Rp Rsh)] [IsSepClosure (ResidueField Rp) (ResidueField Rsh)]
    [IsHenselization Rp (ResidueField Rsh) Rsh]
    [IsLocalRing Ssh] [Algebra Sq Ssh] [Algebra S Ssh] [IsScalarTower S Sq Ssh]
    [IsLocalHom (algebraMap Sq Ssh)] [IsSepClosure (ResidueField Sq) (ResidueField Ssh)]
    [IsHenselization Sq (ResidueField Ssh) Ssh]
    [Algebra Rsh Ssh] [Algebra R Ssh] [IsScalarTower R Rsh Ssh] [IsScalarTower R S Ssh]
    [IsLocalHom (algebraMap Rsh Ssh)] :
    Module.Finite Rsh Ssh ∧ Module.Finite (ResidueField Rsh) (ResidueField Ssh) ∧
      IsPurelyInseparable (ResidueField Rsh) (ResidueField Ssh) := by
  obtain ⟨_, _, _, _, _, _, _, _⟩ := exists_algebra_localization p q (Rp := Rp) (Sq := Sq)
    (Rsh := Rsh) (Ssh := Ssh)
  -- the tensor product `T = R^sh ⊗_{R_p} S_q`
  let T := Rsh ⊗[Rp] Sq
  let _ : Algebra Sq T := Algebra.TensorProduct.rightAlgebra
  have towRpSqT : IsScalarTower Rp Sq T := Algebra.TensorProduct.right_isScalarTower
  have hT : Algebra.IsPushout Rp Sq Rsh T := TensorProduct.isPushout'
  let κ₂ := ResidueField Ssh
  let π : T →+* κ₂ := (Algebra.TensorProduct.productMap
    ((IsScalarTower.toAlgHom Rp Ssh κ₂).comp (IsScalarTower.toAlgHom Rp Rsh Ssh))
    ((IsScalarTower.toAlgHom Rp Ssh κ₂).comp (IsScalarTower.toAlgHom Rp Sq Ssh))).toRingHom
  have hπRsh : π.comp (algebraMap Rsh T) =
      (algebraMap (ResidueField Rsh) κ₂).comp (residue Rsh) := by
    ext x
    change π (x ⊗ₜ[Rp] (1 : Sq)) = _
    simp only [π, κ₂, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    simp
  have hπSq : π.comp (algebraMap Sq T) =
      (algebraMap (ResidueField Sq) κ₂).comp (residue Sq) := by
    ext x
    change π ((1 : Rsh) ⊗ₜ[Rp] x) = _
    simp only [π, κ₂, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    simp
  -- the ring `S'` of Lemma 05WR
  have : (RingHom.ker π).IsPrime := RingHom.ker_isPrime (R := T) (S := ResidueField Ssh) π
  let S' := Localization.AtPrime (RingHom.ker π)
  have hind := ind_etale_of_universe_le (R := Rp) (L := ResidueField Rsh) (Rh := Rsh)
  have hmax := map_maximalIdeal (R := Rp) (L := ResidueField Rsh) (Rh := Rsh)
  have := henselian (R := Rp) (L := ResidueField Rsh) (Rh := Rsh)
  obtain ⟨hloc, hfin, hloc', hhens', hind', hmax', hsep', ⟨e, he⟩, hfinκ, hinsκ⟩ :=
    Algebra.IsPushout.strictHenselization_and_finite_of_quasiFiniteAt (Ssh := S') p q hind hmax hT
      π hπRsh hπSq
  refine ⟨?_, hfinκ, hinsκ⟩
  -- Lemma 08HT identifies `S'` with `S^sh` over `S_q`, compatibly with the residue fields
  have he' : ∀ t : T, e (residue S' (algebraMap T S' t)) = π t := fun t => RingHom.congr_fun he t
  let p₀ : S' →ₐ[Sq] ResidueField Ssh :=
    { e.toRingHom.comp (residue S') with
      commutes' := fun r => by
        change e (residue S' (algebraMap Sq S' r)) = _
        rw [IsScalarTower.algebraMap_apply Sq T S', he']
        exact RingHom.congr_fun hπSq r }
  let p₁ : Ssh →ₐ[Sq] ResidueField Ssh := Ideal.Quotient.mkₐ Sq (maximalIdeal Ssh)
  have := henselian (R := Sq) (L := ResidueField Ssh) (Rh := Ssh)
  obtain ⟨σ, hσ⟩ := HenselianLocalRing.existsUnique_algEquiv_of_ind_etale hind'
    (ind_etale_of_universe_le (R := Sq) (L := ResidueField Ssh) (Rh := Ssh)) p₀ p₁
    (e.surjective.comp residue_surjective) (Ideal.Quotient.mkₐ_surjective _ _)
  have hσres : ∀ x, residue Ssh (σ x) = e (residue S' x) := fun x =>
    AlgHom.congr_fun ((hσ σ).mpr rfl) x
  -- by the uniqueness of Lemma 04GU, `σ` is compatible with the maps from `R^sh`
  have hRsh : ∀ x : Rsh, σ (algebraMap Rsh S' x) = algebraMap Rsh Ssh x := by
    have hfg : ((σ : S' →+* Ssh).comp (algebraMap Rsh S')).comp (algebraMap Rp Rsh) =
        (algebraMap Rsh Ssh).comp (algebraMap Rp Rsh) := RingHom.ext fun r => by
      simp only [RingHom.comp_apply]
      rw [IsScalarTower.algebraMap_apply Rsh T S', ← IsScalarTower.algebraMap_apply Rp Rsh T,
        IsScalarTower.algebraMap_apply Rp Sq T, ← IsScalarTower.algebraMap_apply Sq T S',
        ← IsScalarTower.algebraMap_apply Rp Rsh Ssh, IsScalarTower.algebraMap_apply Rp Sq Ssh]
      exact σ.commutes _
    refine RingHom.congr_fun (ringHom_ext_of_comp_eq_of_surjective hfg
      (π := residue Ssh) residue_surjective fun x => ?_)
    change residue Ssh (σ (algebraMap Rsh S' x)) = residue Ssh (algebraMap Rsh Ssh x)
    rw [hσres, IsScalarTower.algebraMap_apply Rsh T S', he']
    exact RingHom.congr_fun hπRsh x
  let l : S' →ₗ[Rsh] Ssh :=
    { toFun := σ
      map_add' := map_add σ
      map_smul' := fun r x => by
        simp only [Algebra.smul_def, map_mul, hRsh, RingHom.id_apply] }
  exact Module.Finite.of_surjective l σ.surjective

/-- The multiplication map `B ⊗_R A → A ⊗_R B`, for `A ⊗_R B` a `B`-algebra on the right, is
surjective. -/
theorem _root_.Algebra.TensorProduct.productMap_rightAlgebra_surjective (R A B : Type*)
    [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B] :
    letI : Algebra B (A ⊗[R] B) := Algebra.TensorProduct.rightAlgebra
    letI : IsScalarTower R B (A ⊗[R] B) := Algebra.TensorProduct.right_isScalarTower
    Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom R B (A ⊗[R] B)) (IsScalarTower.toAlgHom R A (A ⊗[R] B))) := by
  let : Algebra B (A ⊗[R] B) := Algebra.TensorProduct.rightAlgebra
  let : IsScalarTower R B (A ⊗[R] B) := Algebra.TensorProduct.right_isScalarTower
  intro t
  refine ⟨Algebra.TensorProduct.comm R A B t, ?_⟩
  induction t using TensorProduct.inductionOn with
  | tmul r b =>
    rw [Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.productMap_apply_tmul]
    change ((1 : A) ⊗ₜ[R] b) * (r ⊗ₜ[R] (1 : B)) = _
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
  | add x y hx hy => rw [map_add, map_add, hx, hy]


/-- **Strict henselizations along a colimit of quasi-finite algebras are integral.** Let `R → S`
be a ring map and `q` a prime of `S` over `p`, such that every finite subset of `S` lies in the
image of an `R`-algebra map `φ : S' → S` with `S'` of finite type over `R` and quasi-finite at
`φ⁻¹(q)`. Then for strict henselizations `R^sh`, `S^sh` of `R_p`, `S_q` and a local ring map
`R^sh → S^sh` over `R → S`, the ring `S^sh` is integral over `R^sh`.

By Lemma 08HV, `S^sh` is the strict henselization of `T_Q`, where `T = R^sh ⊗_R S` and `Q` is the
inverse image of `𝔪_{S^sh}`. An element of `T_Q` is a fraction of elements of `R^sh ⊗_R S'` for
some such `S'`, whose localization at the inverse image of `Q` is finite over `R^sh` by Lemmas 00PN
and 04GH; so `T_Q` is integral over `R^sh`. Hence `T_Q` is henselian and its residue field is
purely inseparable over the separably closed `κ(R^sh)`, so `κ(T_Q) = κ(S^sh)` and `T_Q = S^sh` by
Lemma 08HT. -/
theorem isIntegral_of_forall_finset
    {R S Rp Sq Rsh Ssh : Type u} [CommRing R] [CommRing S] [CommRing Rp] [CommRing Sq]
    [CommRing Rsh] [CommRing Ssh] [Algebra R S]
    (p : Ideal R) (q : Ideal S) [p.IsPrime] [q.IsPrime] [q.LiesOver p]
    [IsLocalRing Rp] [Algebra R Rp] [IsLocalization.AtPrime Rp p]
    [IsLocalRing Sq] [Algebra S Sq] [IsLocalization.AtPrime Sq q]
    [IsLocalRing Rsh] [Algebra Rp Rsh] [Algebra R Rsh] [IsScalarTower R Rp Rsh]
    [IsLocalHom (algebraMap Rp Rsh)] [IsSepClosure (ResidueField Rp) (ResidueField Rsh)]
    [IsHenselization Rp (ResidueField Rsh) Rsh]
    [IsLocalRing Ssh] [Algebra Sq Ssh] [Algebra S Ssh] [IsScalarTower S Sq Ssh]
    [IsLocalHom (algebraMap Sq Ssh)] [IsSepClosure (ResidueField Sq) (ResidueField Ssh)]
    [IsHenselization Sq (ResidueField Ssh) Ssh]
    [Algebra Rsh Ssh] [Algebra R Ssh] [IsScalarTower R Rsh Ssh] [IsScalarTower R S Ssh]
    [IsLocalHom (algebraMap Rsh Ssh)]
    (hS : ∀ F : Finset S, ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra R S')
      (φ : S' →ₐ[R] S), Algebra.FiniteType R S' ∧ Algebra.QuasiFiniteAt R (q.comap φ) ∧
        (F : Set S) ⊆ Set.range φ) :
    Algebra.IsIntegral Rsh Ssh := by
  obtain ⟨_, _, _, _, _, _, _, _⟩ := exists_algebra_localization p q (Rp := Rp) (Sq := Sq)
    (Rsh := Rsh) (Ssh := Ssh)
  -- Lemma 08HV
  have hphi : (ResidueField.map (algebraMap Rsh Ssh)).comp ((residue Rsh).comp (algebraMap R Rsh))
      = (residue Ssh).comp (algebraMap R Ssh) := by
    ext x
    simp [IsScalarTower.algebraMap_apply R Rsh Ssh]
  obtain ⟨f, -, -, hfu, Q, _, hl, hr, hQ, alg, hloc, algRes, hsep, hhens, hres, hcomp⟩ :=
    exists_prime_isStrictHenselization_tensorProduct p q (Rp := Rp) (Sq := Sq) (Rsh := Rsh)
      (Ssh := Ssh) _ hphi
  have hf : f = IsScalarTower.toAlgHom R Rsh Ssh :=
    (hfu _ ⟨(‹IsLocalHom (algebraMap Rsh Ssh)›).map_nonunit⟩ (by ext x; simp)).symm
  subst hf
  let T := Rsh ⊗[R] S
  let TQ := Localization.AtPrime Q
  have hRsh := henselian (R := Rp) (L := ResidueField Rsh) (Rh := Rsh)
  -- every element of `T` comes from `R^sh ⊗_R S'` for `S'` covering finitely many elements
  have hfin : ∀ t : T, ∃ F : Finset S, ∀ (S' : Type u) [CommRing S'] [Algebra R S']
      (φ : S' →ₐ[R] S), (F : Set S) ⊆ Set.range φ →
        t ∈ (Algebra.TensorProduct.map (AlgHom.id Rsh Rsh) φ).range := by
    classical
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul r b =>
      refine ⟨{b}, fun S' _ _ φ h => ?_⟩
      obtain ⟨b', hb'⟩ := h (Finset.mem_coe.mpr (Finset.mem_singleton_self b))
      exact ⟨r ⊗ₜ b', by simp [hb']⟩
    | add x y hx hy =>
      obtain ⟨F₁, h₁⟩ := hx
      obtain ⟨F₂, h₂⟩ := hy
      exact ⟨F₁ ∪ F₂, fun S' _ _ φ h =>
        add_mem (h₁ S' φ (subset_trans (by simp) h)) (h₂ S' φ (subset_trans (by simp) h))⟩
  -- `T_Q` is integral over `R^sh` (Lemmas 00PN and 04GH)
  have hint : Algebra.IsIntegral Rsh TQ := by
    classical
    refine ⟨fun z => ?_⟩
    obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
    obtain ⟨Fx, hFx⟩ := hfin x
    obtain ⟨Fs, hFs⟩ := hfin s
    obtain ⟨S', _, _, φ, hft, hqf, hcov⟩ := hS (Fx ∪ Fs)
    let T' := Rsh ⊗[R] S'
    let φ' : T' →ₐ[Rsh] T := Algebra.TensorProduct.map (AlgHom.id Rsh Rsh) φ
    obtain ⟨x', hx'⟩ := hFx S' φ (subset_trans (by simp) hcov)
    obtain ⟨s', hs'⟩ := hFs S' φ (subset_trans (by simp) hcov)
    replace hx' : φ' x' = x := hx'
    replace hs' : φ' s' = s := hs'
    let Q' := Q.comap φ'.toRingHom
    have hs'Q : s' ∈ Q'.primeCompl := by
      change φ' s' ∉ Q
      rw [hs']
      exact s.2
    let _ : Algebra S' T' := Algebra.TensorProduct.rightAlgebra
    have : IsScalarTower R S' T' := Algebra.TensorProduct.right_isScalarTower
    have hsurj : Function.Surjective (Algebra.TensorProduct.productMap
        (IsScalarTower.toAlgHom R S' T') (IsScalarTower.toAlgHom R Rsh T')) :=
      Algebra.TensorProduct.productMap_rightAlgebra_surjective R Rsh S'
    have hQ'S' : Q'.under S' = q.comap φ := by
      ext b
      change φ' ((1 : Rsh) ⊗ₜ[R] b) ∈ Q ↔ _
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, ← hr]
      rfl
    have : Algebra.QuasiFiniteAt R (Q'.under S') := by
      convert hqf using 2
    have hQ'qf : Algebra.QuasiFiniteAt Rsh Q' := four_rings_quasiFiniteAt R S' Rsh T' hsurj Q'
    have : Q'.LiesOver (maximalIdeal Rsh) := ⟨by
      rw [← hl]
      ext r
      change _ ↔ φ' (algebraMap Rsh T' r) ∈ Q
      rw [AlgHom.commutes]
      rfl⟩
    obtain ⟨-, hfinL⟩ :=
      (HenselianLocalRing.henselianLocalRing_and_finite_of_finite_of_quasiFiniteAt Rsh).2.2.1
        T' inferInstance Q' hQ'qf (Localization.AtPrime Q')
    let ψ : Localization.AtPrime Q' →ₐ[Rsh] TQ :=
      { Localization.localRingHom Q' Q φ'.toRingHom rfl with
        commutes' := fun r => by
          change Localization.localRingHom Q' Q φ'.toRingHom rfl
            (algebraMap T' _ (algebraMap Rsh T' r)) = algebraMap T TQ (algebraMap Rsh T r)
          rw [Localization.localRingHom_to_map]
          exact congrArg _ (φ'.commutes r) }
    have hw : IsIntegral Rsh (IsLocalization.mk' (Localization.AtPrime Q') x' ⟨s', hs'Q⟩) :=
      Algebra.IsIntegral.isIntegral _
    convert hw.map ψ using 1
    change _ = Localization.localRingHom Q' Q φ'.toRingHom rfl _
    rw [Localization.localRingHom_mk']
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hx', hs']
    rfl
  -- `T_Q` is henselian, local over `R^sh`, with residue field algebraic over `κ(R^sh)`
  have : HenselianLocalRing TQ := HenselianLocalRing.of_isIntegral (A := Rsh)
  have hlocRT : IsLocalHom (algebraMap Rsh TQ) := by
    refine ((local_hom_TFAE (algebraMap Rsh TQ)).out 5 1).mp ?_
    have hQ' : Ideal.comap (algebraMap T TQ) (maximalIdeal TQ) = Q :=
      Localization.AtPrime.under_maximalIdeal ..
    rwa [IsScalarTower.algebraMap_eq Rsh T TQ, ← Ideal.comap_comap, hQ']
  have halgT : Algebra.IsAlgebraic (ResidueField Rsh) (ResidueField TQ) := by
    refine ⟨fun y => ?_⟩
    obtain ⟨z, rfl⟩ := residue_surjective y
    have h₁ : IsIntegral Rsh (residue TQ z) :=
      (Algebra.IsIntegral.isIntegral z).map (IsScalarTower.toAlgHom Rsh TQ (ResidueField TQ))
    exact h₁.tower_top.isAlgebraic
  have hRT : ∀ r : Rsh, algebraMap TQ Ssh (algebraMap Rsh TQ r) = algebraMap Rsh Ssh r := by
    intro r
    rw [IsScalarTower.algebraMap_apply Rsh T TQ, ← RingHom.comp_apply, hcomp]
    change Algebra.TensorProduct.lift _ _ _ (r ⊗ₜ[R] (1 : S)) = _
    rw [Algebra.TensorProduct.lift_tmul]
    simp
  -- the residue field of `S^sh` is that of `T_Q`
  clear hloc
  have hsurjres : Function.Surjective ((residue Ssh).comp (algebraMap TQ Ssh)) := by
    have : IsScalarTower (ResidueField Rsh) (ResidueField TQ) (ResidueField Ssh) := by
      refine .of_algebraMap_eq fun y => ?_
      obtain ⟨r, rfl⟩ := residue_surjective y
      rw [ResidueField.algebraMap_residue, ResidueField.algebraMap_residue, hres, hRT]
    have : Algebra.IsAlgebraic (ResidueField Rsh) (ResidueField Ssh) :=
      Algebra.IsAlgebraic.trans (ResidueField Rsh) (ResidueField TQ) (ResidueField Ssh)
    have : IsSepClosed (ResidueField Rsh) := IsSepClosure.sep_closed (ResidueField Rp)
    have : IsPurelyInseparable (ResidueField Rsh) (ResidueField Ssh) := inferInstance
    have : IsPurelyInseparable (ResidueField TQ) (ResidueField Ssh) :=
      IsPurelyInseparable.tower_top (ResidueField Rsh) _ _
    have : Algebra.IsSeparable (ResidueField TQ) (ResidueField Ssh) := IsSepClosure.separable
    have hbij := IsPurelyInseparable.bijective_algebraMap_of_isSeparable (ResidueField TQ)
      (ResidueField Ssh)
    intro y
    obtain ⟨w, rfl⟩ := hbij.2 y
    obtain ⟨z, rfl⟩ := residue_surjective w
    exact ⟨z, (hres z).symm⟩
  -- so `T_Q → S^sh` is an isomorphism, by Lemma 08HT over `T_Q`
  have := henselian (R := Sq) (L := ResidueField Ssh) (Rh := Ssh)
  have hTQind : (CommAlgCat.etale.{u} TQ).ind.{u} (CommAlgCat.of TQ TQ) :=
    (CommAlgCat.etale.{u} TQ).le_ind _ (inferInstanceAs (Algebra.Etale TQ TQ))
  have hbijT : Function.Bijective (algebraMap TQ Ssh) := by
    let p₀ : TQ →ₐ[TQ] ResidueField Ssh :=
      (Ideal.Quotient.mkₐ TQ (maximalIdeal Ssh)).comp (Algebra.ofId TQ Ssh)
    let p₁ : Ssh →ₐ[TQ] ResidueField Ssh := Ideal.Quotient.mkₐ TQ (maximalIdeal Ssh)
    obtain ⟨e, he⟩ := HenselianLocalRing.existsUnique_algEquiv_of_ind_etale hTQind
      (ind_etale_of_universe_le (R := TQ) (L := ResidueField Ssh) (Rh := Ssh)) p₀ p₁ hsurjres
      (Ideal.Quotient.mkₐ_surjective TQ _)
    rw [show (algebraMap TQ Ssh : TQ → Ssh) = e from
      congrArg DFunLike.coe ((he (Algebra.ofId TQ Ssh)).mp rfl)]
    exact e.bijective
  -- and `S^sh` is integral over `R^sh`
  let ψ : TQ →ₐ[Rsh] Ssh := { algebraMap TQ Ssh with commutes' := hRT }
  refine ⟨fun y => ?_⟩
  obtain ⟨z, rfl⟩ := hbijT.2 y
  exact (Algebra.IsIntegral.isIntegral z).map ψ

/-- An integral algebra is covered by finite, hence quasi-finite, subalgebras. -/
theorem forall_finset_of_isIntegral {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.IsIntegral R S] (q : Ideal S) [q.IsPrime] (F : Finset S) :
    ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra R S') (φ : S' →ₐ[R] S),
      Algebra.FiniteType R S' ∧ Algebra.QuasiFiniteAt R (q.comap φ) ∧
        (F : Set S) ⊆ Set.range φ := by
  let S' := Algebra.adjoin R (F : Set S)
  have : Module.Finite R S' := Algebra.finite_adjoin_of_finite_of_isIntegral F.finite_toSet
    fun x _ => Algebra.IsIntegral.isIntegral x
  exact ⟨S', inferInstance, inferInstance, S'.val, inferInstance, inferInstance,
    fun x hx => ⟨⟨x, Algebra.subset_adjoin hx⟩, rfl⟩⟩

/-- The covering condition passes to the base change `D = B ⊗_A C` over `C`. -/
theorem forall_finset_of_isPushout {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C]
    [CommRing D] [Algebra A B] [Algebra A C] [Algebra A D] [Algebra B D] [Algebra C D]
    [IsScalarTower A B D] [IsScalarTower A C D] [Algebra.IsPushout A B C D]
    (P : Ideal D) [P.IsPrime]
    (hB : ∀ F : Finset B, ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra A S')
      (φ : S' →ₐ[A] B), Algebra.FiniteType A S' ∧ Algebra.QuasiFiniteAt A ((P.under B).comap φ) ∧
        (F : Set B) ⊆ Set.range φ) (F : Finset D) :
    ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra C S') (φ : S' →ₐ[C] D),
      Algebra.FiniteType C S' ∧ Algebra.QuasiFiniteAt C (P.comap φ) ∧
        (F : Set D) ⊆ Set.range φ := by
  classical
  let ψ : ∀ (S' : Type u) [CommRing S'] [Algebra A S'], (S' →ₐ[A] B) → (C ⊗[A] S' →ₐ[C] D) :=
    fun S' _ _ φ => Algebra.TensorProduct.lift (Algebra.ofId C D)
      ((IsScalarTower.toAlgHom A B D).comp φ) fun _ _ => .all _ _
  -- every element of `D` is a sum of products of elements of `B` and `C`
  have hgen : ∀ d : D, ∃ G : Finset B, ∀ (S' : Type u) [CommRing S'] [Algebra A S']
      (φ : S' →ₐ[A] B), (G : Set B) ⊆ Set.range φ → d ∈ Set.range (ψ S' φ) := by
    intro d
    obtain ⟨t, rfl⟩ := (Algebra.IsPushout.equiv A B C D).surjective d
    induction t using TensorProduct.inductionOn with
    | tmul b c =>
      refine ⟨{b}, fun S' _ _ φ h => ?_⟩
      obtain ⟨b', hb'⟩ := h (Finset.mem_coe.mpr (Finset.mem_singleton_self b))
      refine ⟨c ⊗ₜ b', ?_⟩
      simp [ψ, Algebra.IsPushout.equiv_tmul, hb', mul_comm]
    | add x y hx hy =>
      obtain ⟨G₁, h₁⟩ := hx
      obtain ⟨G₂, h₂⟩ := hy
      refine ⟨G₁ ∪ G₂, fun S' _ _ φ h => ?_⟩
      obtain ⟨x', hx'⟩ := h₁ S' φ (subset_trans (by simp) h)
      obtain ⟨y', hy'⟩ := h₂ S' φ (subset_trans (by simp) h)
      exact ⟨x' + y', by rw [map_add, hx', hy', map_add]⟩
  choose G hG using hgen
  obtain ⟨S', _, _, φ, hft, hqf, hcov⟩ := hB (F.biUnion G)
  let S'' := C ⊗[A] S'
  let _ : Algebra S' S'' := Algebra.TensorProduct.rightAlgebra
  have : IsScalarTower A S' S'' := Algebra.TensorProduct.right_isScalarTower
  have hsurj : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom A S' S'') (IsScalarTower.toAlgHom A C S'')) :=
    Algebra.TensorProduct.productMap_rightAlgebra_surjective A C S'
  have hunder : (P.comap (ψ S' φ)).under S' = (P.under B).comap φ := by
    ext b
    change ψ S' φ ((1 : C) ⊗ₜ[A] b) ∈ P ↔ _
    simp [ψ]
  have : Algebra.QuasiFiniteAt A ((P.comap (ψ S' φ)).under S') := by
    convert hqf using 2
  refine ⟨S'', inferInstance, inferInstance, ψ S' φ, inferInstance,
    four_rings_quasiFiniteAt A S' C S'' hsurj _, fun d hd => ?_⟩
  exact hG d S' φ (subset_trans (Finset.coe_subset.mpr (Finset.subset_biUnion_of_mem G hd)) hcov)

/-- A filtered colimit of finite type, quasi-finite algebras is covered by them. -/
theorem forall_finset_of_ind {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    (h : (ObjectProperty.ind.{u} fun X : CommAlgCat.{u} R =>
      Algebra.FiniteType R X ∧ Algebra.QuasiFinite R X) (CommAlgCat.of R S))
    (q : Ideal S) [q.IsPrime] (F : Finset S) :
    ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra R S') (φ : S' →ₐ[R] S),
      Algebra.FiniteType R S' ∧ Algebra.QuasiFiniteAt R (q.comap φ) ∧
        (F : Set S) ⊆ Set.range φ := by
  obtain ⟨J, _, _, pres, hP⟩ := h
  obtain ⟨j, hj⟩ :=
    Stacks.Henselization.EtaleColimit.exists_app_eq_finset R _ pres.isColimit F
  obtain ⟨hft, hqf⟩ := hP j
  exact ⟨pres.diag.obj j, inferInstance, inferInstance, (pres.ι.app j).hom, hft, inferInstance,
    fun x hx => hj x hx⟩

/-- The residue field extension of an integral local homomorphism is integral. -/
theorem _root_.Algebra.IsIntegral.residueField {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Algebra.IsIntegral R S] : Algebra.IsIntegral (ResidueField R) (ResidueField S) := by
  refine ⟨fun y => ?_⟩
  obtain ⟨z, rfl⟩ := residue_surjective y
  exact ((Algebra.IsIntegral.isIntegral (R := R) z).map
    (IsScalarTower.toAlgHom R S (ResidueField S))).tower_top

/-- If an intermediate field of `κ(S)` contains the residues of the elements of `R`, then it
contains the image of `κ(R_P)`, for a local map `R_P → S` of the localization of `R` at `P`. -/
private theorem algebraMap_residueField_mem {R Rp S K : Type*} [CommRing R] [CommRing Rp]
    [CommRing S] [Field K] (P : Ideal R) [P.IsPrime] [IsLocalRing Rp] [Algebra R Rp]
    [IsLocalization.AtPrime Rp P] [IsLocalRing S] [Algebra R S] [Algebra Rp S]
    [IsScalarTower R Rp S] [IsLocalHom (algebraMap Rp S)] [Algebra K (ResidueField S)]
    (F : IntermediateField K (ResidueField S)) (hF : ∀ x : R, residue S (algebraMap R S x) ∈ F)
    (r : ResidueField Rp) : algebraMap (ResidueField Rp) (ResidueField S) r ∈ F := by
  obtain ⟨z, rfl⟩ := residue_surjective r
  obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl z
  rw [ResidueField.algebraMap_residue]
  have hs : residue S (algebraMap R S s) ≠ 0 := by
    rw [residue_ne_zero_iff_isUnit, IsScalarTower.algebraMap_apply R Rp S]
    exact (IsLocalization.map_units Rp s).map _
  have key : residue S (algebraMap Rp S (IsLocalization.mk' Rp x s)) *
      residue S (algebraMap R S s) = residue S (algebraMap R S x) := by
    rw [← map_mul, IsScalarTower.algebraMap_apply R Rp S s, ← map_mul,
      IsLocalization.mk'_spec, ← IsScalarTower.algebraMap_apply]
  rw [eq_div_of_mul_eq hs key]
  exact div_mem (hF x) (hF s)

/-- Two ring maps out of a pushout `D = B ⊗_A C` agreeing on `B` and on `C` are equal. -/
private theorem ringHom_ext_of_isPushout (A B C D : Type*) [CommRing A] [CommRing B] [CommRing C]
    [CommRing D] [Algebra A B] [Algebra A C] [Algebra A D] [Algebra B D] [Algebra C D]
    [IsScalarTower A B D] [IsScalarTower A C D] [Algebra.IsPushout A B C D] {X : Type*}
    [CommSemiring X] {f g : D →+* X} (hB : f.comp (algebraMap B D) = g.comp (algebraMap B D))
    (hC : f.comp (algebraMap C D) = g.comp (algebraMap C D)) : f = g := by
  let _ : Algebra A X := (f.comp (algebraMap A D)).toAlgebra
  have hA : ∀ a : A, g (algebraMap A D a) = f (algebraMap A D a) := fun a => by
    rw [IsScalarTower.algebraMap_apply A B D]
    exact (RingHom.congr_fun hB _).symm
  let f' : D →ₐ[A] X := { f with commutes' := fun _ => rfl }
  let g' : D →ₐ[A] X := { g with commutes' := hA }
  have : f' = g' := Algebra.IsPushout.algHom_ext (R := A) (S := B) (R' := C) (S' := D)
    (h₁ := AlgHom.ext fun x => RingHom.congr_fun hC x)
    (h₂ := AlgHom.ext fun x => RingHom.congr_fun hB x)
  exact RingHom.ext fun x => AlgHom.congr_fun this x

variable {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
  [Algebra A B] [Algebra A C] [Algebra A D] [Algebra B D] [Algebra C D]
  [IsScalarTower A B D] [IsScalarTower A C D] [Algebra.IsPushout A B C D]
  (P : Ideal D) [P.IsPrime]
  {Bp Cp Dp : Type u} [CommRing Bp] [CommRing Cp] [CommRing Dp]
  [IsLocalRing Bp] [Algebra B Bp] [IsLocalization.AtPrime Bp (P.under B)]
  [IsLocalRing Cp] [Algebra C Cp] [IsLocalization.AtPrime Cp (P.under C)]
  [IsLocalRing Dp] [Algebra D Dp] [IsLocalization.AtPrime Dp P]
  {Ash Bsh Csh Dsh : Type u} [CommRing Ash] [CommRing Bsh] [CommRing Csh] [CommRing Dsh]
  [IsLocalRing Ash] [Algebra A Ash]
  [IsLocalRing Bsh] [Algebra Bp Bsh] [Algebra B Bsh] [IsScalarTower B Bp Bsh]
  [IsLocalHom (algebraMap Bp Bsh)] [IsHenselization Bp (ResidueField Bsh) Bsh]
  [IsLocalRing Csh] [Algebra Cp Csh] [Algebra C Csh] [IsScalarTower C Cp Csh]
  [IsLocalHom (algebraMap Cp Csh)] [IsSepClosure (ResidueField Cp) (ResidueField Csh)]
  [IsHenselization Cp (ResidueField Csh) Csh]
  [IsLocalRing Dsh] [Algebra Dp Dsh] [Algebra D Dsh] [IsScalarTower D Dp Dsh]
  [IsLocalHom (algebraMap Dp Dsh)] [IsSepClosure (ResidueField Dp) (ResidueField Dsh)]
  [IsHenselization Dp (ResidueField Dsh) Dsh]
  [Algebra Ash Bsh] [Algebra A Bsh] [IsScalarTower A Ash Bsh] [IsScalarTower A B Bsh]
  [Algebra Ash Csh] [Algebra A Csh] [IsScalarTower A Ash Csh] [IsScalarTower A C Csh]
  [Algebra Bsh Dsh] [Algebra B Dsh] [IsScalarTower B Bsh Dsh] [IsScalarTower B D Dsh]
  [Algebra Csh Dsh] [Algebra C Dsh] [IsScalarTower C Csh Dsh] [IsScalarTower C D Dsh]
  [Algebra Ash Dsh] [IsScalarTower Ash Bsh Dsh] [IsScalarTower Ash Csh Dsh]

include A B C D P Bp Cp Dp in
/-- **The criterion behind Lemma 0GIP.** In the situation of Lemma 0GIP, suppose that `B^sh` is
integral over `A^sh` with purely inseparable residue field extension, and that `κ(D^sh)` is
algebraic over `κ(C^sh)`. Then `B^sh ⊗_{A^sh} C^sh → D^sh` is an isomorphism.

The ring `E = C^sh ⊗_{A^sh} B^sh` is local by Lemma 092Y and henselian, being integral over
`C^sh`. The residue map `E → κ(D^sh)` is surjective: its image is a field containing `κ(C^sh)` and
the image of `κ(D_P)`, over which `κ(D^sh)` is both separable and purely inseparable. So `E` is a
`D_P`-algebra, and Lemma 08HR gives a `D_P`-algebra map `D^sh → E` over `κ(D^sh)`; the uniqueness
in Lemma 08HR, applied over `D_P`, `B_{P ∩ B}` and `C_{P ∩ C}`, shows that it is inverse to the
map `E → D^sh`. Here `A^sh` may be any local `A`-algebra and `B^sh` any henselization of
`B_{P ∩ B}`. -/
theorem bijective_tensorProduct_lift_of_isIntegral_of_isPurelyInseparable
    [IsLocalHom (algebraMap Ash Bsh)] [IsLocalHom (algebraMap Ash Csh)]
    [IsLocalHom (algebraMap Csh Dsh)]
    [Algebra.IsIntegral Ash Bsh] [IsPurelyInseparable (ResidueField Ash) (ResidueField Bsh)]
    [Algebra.IsAlgebraic (ResidueField Csh) (ResidueField Dsh)] :
    Function.Bijective (Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) fun _ _ => .all _ _) := by
  let E := Csh ⊗[Ash] Bsh
  have halg : (ResidueField.map (algebraMap Ash Bsh)).toAlgebra =
      (inferInstance : Algebra (ResidueField Ash) (ResidueField Bsh)) :=
    Algebra.algebra_ext _ _ fun x => by
      obtain ⟨x, rfl⟩ := residue_surjective x
      rfl
  obtain ⟨hEloc, -, -⟩ := isLocalRing_tensorProduct_of_isIntegral Ash Csh Bsh (Or.inl (halg ▸
    inferInstance))
  have := henselian (R := Cp) (L := ResidueField Csh) (Rh := Csh)
  have hEhens : HenselianLocalRing E := HenselianLocalRing.of_isIntegral (A := Csh)
  let c : E →ₐ[Csh] Dsh := Algebra.TensorProduct.lift (Algebra.ofId Csh Dsh)
    (IsScalarTower.toAlgHom Ash Bsh Dsh) fun _ _ => .all _ _
  let jB : Bsh →ₐ[Ash] E := Algebra.TensorProduct.includeRight
  have hcB : ∀ x, c (jB x) = algebraMap Bsh Dsh x := fun x => by
    change c ((1 : Csh) ⊗ₜ[Ash] x) = _
    rw [Algebra.TensorProduct.lift_tmul]
    simp
  have hcC : ∀ x, c (algebraMap Csh E x) = algebraMap Csh Dsh x := fun x => c.commutes x
  have hAE : ∀ a : A, algebraMap A E a = algebraMap Csh E (algebraMap A Csh a) := fun a => rfl
  -- the structure map `D → E`
  let fB : B →ₐ[A] E :=
    { (jB.toRingHom).comp (algebraMap B Bsh) with
      commutes' := fun a => by
        change jB (algebraMap B Bsh (algebraMap A B a)) = _
        rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply A Ash Bsh,
          AlgHom.commutes, hAE, IsScalarTower.algebraMap_apply A Ash Csh,
          ← IsScalarTower.algebraMap_apply Ash Csh E] }
  let fC : C →ₐ[A] E :=
    { (algebraMap Csh E).comp (algebraMap C Csh) with
      commutes' := fun a => by
        change algebraMap Csh E (algebraMap C Csh (algebraMap A C a)) = _
        rw [← IsScalarTower.algebraMap_apply A C Csh, hAE] }
  let jD : D →ₐ[A] E := Algebra.pushoutDesc D fB fC fun _ _ => mul_comm _ _
  have hjB : ∀ x, jD (algebraMap B D x) = jB (algebraMap B Bsh x) :=
    Algebra.pushoutDesc_left D fB fC _
  have hjC : ∀ x, jD (algebraMap C D x) = algebraMap Csh E (algebraMap C Csh x) :=
    Algebra.pushoutDesc_right D fB fC _
  have hcD : ∀ x, c (jD x) = algebraMap D Dsh x := by
    have := ringHom_ext_of_isPushout A B C D (f := (c.toRingHom).comp jD.toRingHom)
      (g := algebraMap D Dsh) (RingHom.ext fun x => ?_) (RingHom.ext fun x => ?_)
    · exact RingHom.congr_fun this
    · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hjB, hcB,
        ← IsScalarTower.algebraMap_apply]
    · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hjC, hcC]
      rw [← IsScalarTower.algebraMap_apply C Csh Dsh, IsScalarTower.algebraMap_apply C D Dsh]
  -- the residue map `E → κ(D^sh)` through `c`, and its surjectivity
  let π : E →+* ResidueField Dsh := (residue Dsh).comp c.toRingHom
  have hπC : ∀ x, π (algebraMap Csh E x) =
      algebraMap (ResidueField Csh) (ResidueField Dsh) (residue Csh x) := fun x => by
    simp [π, hcC]
  have hπD : ∀ x, π (jD x) = residue Dsh (algebraMap D Dsh x) := fun x => by
    simp [π, hcD]
  have hπsurj : Function.Surjective π := by
    let S : Subalgebra (ResidueField Csh) (ResidueField Dsh) :=
      { π.range with
        algebraMap_mem' := fun r => by
          obtain ⟨x, rfl⟩ := residue_surjective r
          exact ⟨_, hπC x⟩ }
    let F := IntermediateField.adjoin (ResidueField Csh) (S : Set (ResidueField Dsh))
    have hF := algebraMap_residueField_mem P (Rp := Dp) (S := Dsh) F fun x =>
      IntermediateField.subset_adjoin _ _ ⟨jD x, hπD x⟩
    have : IsSepClosed (ResidueField Csh) := IsSepClosure.sep_closed (ResidueField Cp)
    have : Algebra.IsSeparable (ResidueField Dp) (ResidueField Dsh) := IsSepClosure.separable
    have hFtop := IntermediateField.eq_top_of_isSepClosed F hF
    intro y
    have hy : y ∈ F := hFtop ▸ IntermediateField.mem_top
    rwa [← IntermediateField.mem_toSubalgebra, IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
      (fun x _ => Algebra.IsAlgebraic.isAlgebraic x), Algebra.adjoin_eq S] at hy
  -- `E` is a `D_p`-algebra: `D ∖ P` maps to units, the kernel of `π` being `𝔪_E`
  have hker : RingHom.ker π = maximalIdeal E := ker_eq_maximalIdeal π hπsurj
  have hunit : ∀ s : P.primeCompl, IsUnit (jD.toRingHom s) := fun s => by
    rw [← notMem_maximalIdeal, ← hker, RingHom.mem_ker]
    change π (jD s) ≠ 0
    rw [hπD, IsScalarTower.algebraMap_apply D Dp Dsh, residue_ne_zero_iff_isUnit]
    exact (IsLocalization.map_units Dp s).map _
  let _ : Algebra Dp E := (IsLocalization.lift (M := P.primeCompl) (S := Dp) hunit).toAlgebra
  have hg : ∀ x : D, algebraMap Dp E (algebraMap D Dp x) = jD x :=
    IsLocalization.lift_eq hunit
  have hcDp : ∀ z : Dp, c (algebraMap Dp E z) = algebraMap Dp Dsh z := by
    have : (c.toRingHom).comp (algebraMap Dp E) = algebraMap Dp Dsh :=
      IsLocalization.ringHom_ext P.primeCompl <| RingHom.ext fun x => by
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hg, hcD,
          ← IsScalarTower.algebraMap_apply]
    exact RingHom.congr_fun this
  -- Lemma 08HR over `D_p` produces `d : D^sh → E`
  let πD : E →ₐ[Dp] ResidueField Dsh :=
    { π with
      commutes' := fun z => by
        change residue Dsh (c (algebraMap Dp E z)) = _
        rw [hcDp]
        rfl }
  let rD : Dsh →ₐ[Dp] ResidueField Dsh := Ideal.Quotient.mkₐ Dp (maximalIdeal Dsh)
  have hDind := ind_etale_of_universe_le (R := Dp) (L := ResidueField Dsh) (Rh := Dsh)
  have := henselian (R := Dp) (L := ResidueField Dsh) (Rh := Dsh)
  obtain ⟨d, hd, -⟩ :=
    HenselianLocalRing.existsUnique_algHom_comp_of_ind_etale hDind rD πD hπsurj
  have hdres : ∀ y, π (d y) = residue Dsh y := fun y => AlgHom.congr_fun hd y
  -- `c ∘ d = id`, by the uniqueness of Lemma 08HR over `D_p`
  let cD : E →ₐ[Dp] Dsh := { c.toRingHom with commutes' := hcDp }
  have hcd : ∀ y, c (d y) = y := fun y => AlgHom.congr_fun
    ((HenselianLocalRing.existsUnique_algHom_comp_of_ind_etale hDind rD rD
      (Ideal.Quotient.mkₐ_surjective _ _)).unique (y₁ := cD.comp d) (AlgHom.ext fun y => hdres y)
      (y₂ := AlgHom.id Dp Dsh) (AlgHom.comp_id rD)) y
  have hπ : ∀ x, π x = residue Dsh (c x) := fun _ => rfl
  -- `d ∘ c = id` on `B^sh`, by the uniqueness of Lemma 08HR over `B_p`
  have hdB : ∀ x : Bsh, d (algebraMap Bsh Dsh x) = jB x := by
    have hBp : (d.toRingHom.comp (algebraMap Bsh Dsh)).comp (algebraMap Bp Bsh) =
        (jB.toRingHom).comp (algebraMap Bp Bsh) :=
      IsLocalization.ringHom_ext (P.under B).primeCompl <| RingHom.ext fun b => by
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          ← IsScalarTower.algebraMap_apply]
        rw [IsScalarTower.algebraMap_apply B D Dsh, IsScalarTower.algebraMap_apply D Dp Dsh,
          AlgHom.commutes, hg, hjB]
    refine RingHom.congr_fun (ringHom_ext_of_comp_eq_of_surjective (f := d.toRingHom.comp
      (algebraMap Bsh Dsh)) (g := jB.toRingHom) hBp hπsurj fun x => ?_)
    change π (d (algebraMap Bsh Dsh x)) = π (jB x)
    rw [hdres, hπ, hcB]
  -- `d ∘ c = id` on `C^sh`, by the uniqueness of Lemma 08HR over `C_p`
  have hdC : ∀ x : Csh, d (algebraMap Csh Dsh x) = algebraMap Csh E x := by
    have hCp : (d.toRingHom.comp (algebraMap Csh Dsh)).comp (algebraMap Cp Csh) =
        (algebraMap Csh E).comp (algebraMap Cp Csh) :=
      IsLocalization.ringHom_ext (P.under C).primeCompl <| RingHom.ext fun b => by
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [← IsScalarTower.algebraMap_apply C Cp Csh, ← IsScalarTower.algebraMap_apply C Csh Dsh,
          IsScalarTower.algebraMap_apply C D Dsh, IsScalarTower.algebraMap_apply D Dp Dsh,
          AlgHom.commutes, hg, hjC]
    refine RingHom.congr_fun (ringHom_ext_of_comp_eq_of_surjective (f := d.toRingHom.comp
      (algebraMap Csh Dsh)) (g := algebraMap Csh E) hCp hπsurj fun x => ?_)
    change π (d (algebraMap Csh Dsh x)) = π (algebraMap Csh E x)
    rw [hdres, hπ, hcC]
  have hdc : ∀ x : E, d (c x) = x := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul y z =>
      have : y ⊗ₜ[Ash] z = algebraMap Csh E y * jB z := by
        change y ⊗ₜ[Ash] z = (y ⊗ₜ[Ash] (1 : Bsh)) * ((1 : Csh) ⊗ₜ[Ash] z)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [this, map_mul, map_mul, hcC, hcB, hdC, hdB]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hc : Function.Bijective c :=
    ⟨Function.LeftInverse.injective hdc, Function.RightInverse.surjective hcd⟩
  have hL : ∀ w, Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) (fun _ _ => .all _ _) w =
        c (Algebra.TensorProduct.comm Ash Bsh Csh w) := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul y z =>
      simp only [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.comm_tmul, c,
        IsScalarTower.coe_toAlgHom']
      exact mul_comm _ _
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
  convert hc.comp (Algebra.TensorProduct.comm Ash Bsh Csh).bijective using 1
  exact funext hL

include A B C D P Bp Cp Dp in
/-- **Strict henselization and tensor products, quasi-finite case** (Stacks 0GIP (1)). Let
`D = B ⊗_A C` and let `P` be a prime of `D`, with contractions to `A`, `B`, `C`. Let `A^sh`,
`B^sh`, `C^sh`, `D^sh` be strict henselizations of the localizations of `A`, `B`, `C`, `D` at these
primes, with local ring maps forming a commutative square over the square `A → B, C → D`. If
`A → B` is of finite type and quasi-finite at `P ∩ B`, then
`B^sh ⊗_{A^sh} C^sh → D^sh` is an isomorphism. -/
@[stacks 0GIP "(1).
The field `κ` is replaced by the prime `P = ker(D → κ)` of `D`: the statement is proved for all
strict henselizations `A^sh`, `B^sh`, `C^sh`, `D^sh` of the localizations at the contractions of `P`
and all local maps between them forming a commutative square over `A → B, C → D`, which includes
the maps of Lemma 04GU attached to the embeddings of the residue fields in `κ`. The isomorphism is
the bijectivity of `Algebra.TensorProduct.lift` of the two maps into `D^sh`, and
`D = B ⊗_A C` is any `Algebra.IsPushout A B C D`. Quasi-finiteness at `P ∩ B` is
`Algebra.FiniteType A B` with
`Algebra.QuasiFiniteAt A (P.under B)`, as in Lemma 04GH. See the module docstring."]
theorem bijective_tensorProduct_lift_of_quasiFiniteAt
    {Ap : Type u} [CommRing Ap] [IsLocalRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap (P.under A)]
    [Algebra Ap Ash] [IsScalarTower A Ap Ash] [IsLocalHom (algebraMap Ap Ash)]
    [IsSepClosure (ResidueField Ap) (ResidueField Ash)] [IsHenselization Ap (ResidueField Ash) Ash]
    [IsSepClosure (ResidueField Bp) (ResidueField Bsh)]
    [IsLocalHom (algebraMap Ash Bsh)] [IsLocalHom (algebraMap Ash Csh)]
    [IsLocalHom (algebraMap Csh Dsh)]
    [Algebra.FiniteType A B] [Algebra.QuasiFiniteAt A (P.under B)] :
    Function.Bijective (Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) fun _ _ => .all _ _) := by
  have : (P.under B).LiesOver (P.under A) := ⟨(Ideal.under_under (B := B) P).symm⟩
  obtain ⟨hfin, -, hins⟩ := finite_and_isPurelyInseparable_of_quasiFiniteAt (P.under A) (P.under B)
    (R := A) (S := B) (Rp := Ap) (Sq := Bp) (Rsh := Ash) (Ssh := Bsh)
  -- `C → D` is of finite type and quasi-finite at `P` (Lemma 00PN)
  have : Algebra.IsPushout A C B D := Algebra.IsPushout.symm inferInstance
  have : Algebra.FiniteType C D :=
    Algebra.FiniteType.equiv inferInstance (Algebra.IsPushout.equiv A C B D)
  have hsurj : Function.Surjective (Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom A B D) (IsScalarTower.toAlgHom A C D)) := by
    have : ∀ w, Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom A B D)
        (IsScalarTower.toAlgHom A C D) w = Algebra.IsPushout.equiv A B C D w := fun w => by
      induction w using TensorProduct.inductionOn with
      | tmul x y =>
        rw [Algebra.TensorProduct.productMap_apply_tmul, Algebra.IsPushout.equiv_tmul]
        rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    exact fun z => ⟨(Algebra.IsPushout.equiv A B C D).symm z, by simp [this]⟩
  have : Algebra.QuasiFiniteAt C P := four_rings_quasiFiniteAt A B C D hsurj P
  obtain ⟨-, hfinκ, -⟩ := finite_and_isPurelyInseparable_of_quasiFiniteAt (P.under C) P
    (R := C) (S := D) (Rp := Cp) (Sq := Dp) (Rsh := Csh) (Ssh := Dsh)
  have : Algebra.IsIntegral Ash Bsh := Algebra.IsIntegral.of_finite Ash Bsh
  have : Algebra.IsAlgebraic (ResidueField Csh) (ResidueField Dsh) :=
    Algebra.IsAlgebraic.of_finite _ _
  exact bijective_tensorProduct_lift_of_isIntegral_of_isPurelyInseparable (A := A) (B := B) (C := C)
    P (Bp := Bp) (Cp := Cp) (Dp := Dp) (Ash := Ash) (Bsh := Bsh) (Csh := Csh) (Dsh := Dsh)

include A B C D P Bp Cp Dp in
/-- **Strict henselization and tensor products, covered case.** In the situation of Lemma 0GIP,
suppose that every finite subset of `B` lies in the image of an `A`-algebra map `φ : S' → B` with
`S'` of finite type over `A` and quasi-finite at `φ⁻¹(P ∩ B)`. Then
`B^sh ⊗_{A^sh} C^sh → D^sh` is an isomorphism. -/
theorem bijective_tensorProduct_lift_of_forall_finset
    {Ap : Type u} [CommRing Ap] [IsLocalRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap (P.under A)]
    [Algebra Ap Ash] [IsScalarTower A Ap Ash] [IsLocalHom (algebraMap Ap Ash)]
    [IsSepClosure (ResidueField Ap) (ResidueField Ash)] [IsHenselization Ap (ResidueField Ash) Ash]
    [IsSepClosure (ResidueField Bp) (ResidueField Bsh)]
    [IsLocalHom (algebraMap Ash Bsh)] [IsLocalHom (algebraMap Ash Csh)]
    [IsLocalHom (algebraMap Csh Dsh)]
    (hB : ∀ F : Finset B, ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra A S')
      (φ : S' →ₐ[A] B), Algebra.FiniteType A S' ∧ Algebra.QuasiFiniteAt A ((P.under B).comap φ) ∧
        (F : Set B) ⊆ Set.range φ) :
    Function.Bijective (Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) fun _ _ => .all _ _) := by
  have : (P.under B).LiesOver (P.under A) := ⟨(Ideal.under_under (B := B) P).symm⟩
  have : Algebra.IsIntegral Ash Bsh := isIntegral_of_forall_finset (P.under A) (P.under B)
    (R := A) (S := B) (Rp := Ap) (Sq := Bp) (Rsh := Ash) (Ssh := Bsh) hB
  have : Algebra.IsIntegral Csh Dsh := isIntegral_of_forall_finset (P.under C) P
    (R := C) (S := D) (Rp := Cp) (Sq := Dp) (Rsh := Csh) (Ssh := Dsh)
    (forall_finset_of_isPushout P hB)
  have : IsSepClosed (ResidueField Ash) := IsSepClosure.sep_closed (ResidueField Ap)
  have : Algebra.IsIntegral (ResidueField Ash) (ResidueField Bsh) := Algebra.IsIntegral.residueField
  have : Algebra.IsIntegral (ResidueField Csh) (ResidueField Dsh) := Algebra.IsIntegral.residueField
  have : IsPurelyInseparable (ResidueField Ash) (ResidueField Bsh) := inferInstance
  exact bijective_tensorProduct_lift_of_isIntegral_of_isPurelyInseparable (A := A) (B := B) (C := C)
    P (Bp := Bp) (Cp := Cp) (Dp := Dp) (Ash := Ash) (Bsh := Bsh) (Csh := Csh) (Dsh := Dsh)

include A B C D P Bp Cp Dp in
/-- **Strict henselization and tensor products, colimit case** (Stacks 0GIP (2)). In the
situation of Lemma 0GIP, if `B` is a filtered colimit of quasi-finite `A`-algebras, then
`B^sh ⊗_{A^sh} C^sh → D^sh` is an isomorphism. -/
@[stacks 0GIP "(2).
The field `κ` is replaced by the prime `P = ker(D → κ)` of `D`: the statement is proved for all
strict henselizations `A^sh`, `B^sh`, `C^sh`, `D^sh` of the localizations at the contractions of `P`
and all local maps between them forming a commutative square over `A → B, C → D`, which includes
the maps of Lemma 04GU attached to the embeddings of the residue fields in `κ`. The isomorphism is
the bijectivity of `Algebra.TensorProduct.lift` of the two maps into `D^sh`, and
`D = B ⊗_A C` is any `Algebra.IsPushout A B C D`.
\"Filtered colimit of quasi-finite `A`-algebras\" is
`ObjectProperty.ind` in `CommAlgCat A` of `Algebra.FiniteType A X ∧ Algebra.QuasiFinite A X`. See
the module docstring."]
theorem bijective_tensorProduct_lift_of_ind_quasiFinite
    {Ap : Type u} [CommRing Ap] [IsLocalRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap (P.under A)]
    [Algebra Ap Ash] [IsScalarTower A Ap Ash] [IsLocalHom (algebraMap Ap Ash)]
    [IsSepClosure (ResidueField Ap) (ResidueField Ash)] [IsHenselization Ap (ResidueField Ash) Ash]
    [IsSepClosure (ResidueField Bp) (ResidueField Bsh)]
    [IsLocalHom (algebraMap Ash Bsh)] [IsLocalHom (algebraMap Ash Csh)]
    [IsLocalHom (algebraMap Csh Dsh)]
    (hB : (ObjectProperty.ind.{u} fun X : CommAlgCat.{u} A =>
      Algebra.FiniteType A X ∧ Algebra.QuasiFinite A X) (CommAlgCat.of A B)) :
    Function.Bijective (Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) fun _ _ => .all _ _) :=
  bijective_tensorProduct_lift_of_forall_finset (A := A) (B := B) (C := C) P (Bp := Bp)
    (Cp := Cp) (Dp := Dp) (Ash := Ash) (Bsh := Bsh) (Csh := Csh) (Dsh := Dsh) (Ap := Ap)
    (forall_finset_of_ind hB (P.under B))

include A B C D P Bp Cp Dp in
/-- **Strict henselization and tensor products, local colimit case** (Stacks 0GIP (3)). In the
situation of Lemma 0GIP, if `B_{P ∩ B}` is a filtered colimit of quasi-finite algebras over
`A_{P ∩ A}`, then `B^sh ⊗_{A^sh} C^sh → D^sh` is an isomorphism. -/
@[stacks 0GIP "(3).
The field `κ` is replaced by the prime `P = ker(D → κ)` of `D`: the statement is proved for all
strict henselizations `A^sh`, `B^sh`, `C^sh`, `D^sh` of the localizations at the contractions of `P`
and all local maps between them forming a commutative square over `A → B, C → D`, which includes
the maps of Lemma 04GU attached to the embeddings of the residue fields in `κ`. The isomorphism is
the bijectivity of `Algebra.TensorProduct.lift` of the two maps into `D^sh`, and
`D = B ⊗_A C` is any `Algebra.IsPushout A B C D`. The filtered colimit is `ObjectProperty.ind` in
`CommAlgCat A_p` of `Algebra.FiniteType ∧ Algebra.QuasiFinite`, for the given `A_p`-algebra
structure on `B_p` over `A → B`. See the module docstring."]
theorem bijective_tensorProduct_lift_of_ind_quasiFinite_localization
    {Ap : Type u} [CommRing Ap] [IsLocalRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap (P.under A)]
    [Algebra Ap Ash] [IsScalarTower A Ap Ash] [IsLocalHom (algebraMap Ap Ash)]
    [IsSepClosure (ResidueField Ap) (ResidueField Ash)] [IsHenselization Ap (ResidueField Ash) Ash]
    [IsSepClosure (ResidueField Bp) (ResidueField Bsh)]
    [IsLocalHom (algebraMap Ash Bsh)] [IsLocalHom (algebraMap Ash Csh)]
    [IsLocalHom (algebraMap Csh Dsh)]
    [Algebra Ap Bp] [Algebra A Bp] [IsScalarTower A Ap Bp] [IsScalarTower A B Bp]
    (hB : (ObjectProperty.ind.{u} fun X : CommAlgCat.{u} Ap =>
      Algebra.FiniteType Ap X ∧ Algebra.QuasiFinite Ap X) (CommAlgCat.of Ap Bp)) :
    Function.Bijective (Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) fun _ _ => .all _ _) := by
  -- `A_p` and `B_p` are their own localizations at their maximal ideals
  have : IsLocalization.AtPrime Ap (maximalIdeal Ap) :=
    IsLocalization.self fun _ hx => notMem_maximalIdeal.mp hx
  have : IsLocalization.AtPrime Bp (maximalIdeal Bp) :=
    IsLocalization.self fun _ hx => notMem_maximalIdeal.mp hx
  -- `A_p → B_p` is local
  have : IsLocalHom (algebraMap Ap Bp) := by
    refine ((local_hom_TFAE (algebraMap Ap Bp)).out 5 1).mp ?_
    have h₁ : ((maximalIdeal Bp).comap (algebraMap Ap Bp)).comap (algebraMap A Ap) =
        P.under A := by
      rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq, IsScalarTower.algebraMap_eq A B Bp,
        ← Ideal.comap_comap, show (maximalIdeal Bp).comap (algebraMap B Bp) = P.under B from
          IsLocalization.AtPrime.under_maximalIdeal Bp (P.under B)]
      exact Ideal.under_under P
    rw [← IsLocalization.map_under (P.under A).primeCompl Ap ((maximalIdeal Bp).comap _)]
    change Ideal.map _ (Ideal.comap (algebraMap A Ap) _) = _
    rw [h₁, IsLocalization.AtPrime.map_eq_maximalIdeal]
  -- `A_p → A^sh → B^sh` agrees with `A_p → B_p → B^sh`
  let _ : Algebra Ap Bsh := ((algebraMap Ash Bsh).comp (algebraMap Ap Ash)).toAlgebra
  have : IsScalarTower Ap Ash Bsh := .of_algebraMap_eq' rfl
  have : IsScalarTower Ap Bp Bsh := by
    refine .of_algebraMap_eq' (IsLocalization.ringHom_ext (P.under A).primeCompl
      (RingHom.ext fun x => ?_))
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply A Ap Bp, IsScalarTower.algebraMap_apply A B Bp,
      ← IsScalarTower.algebraMap_apply B Bp Bsh, ← IsScalarTower.algebraMap_apply A B Bsh]
    change algebraMap Ash Bsh (algebraMap Ap Ash (algebraMap A Ap x)) = _
    rw [← IsScalarTower.algebraMap_apply A Ap Ash, ← IsScalarTower.algebraMap_apply A Ash Bsh]
  -- Lemmas 00PN and 04GH over `A_p`: `B^sh` is integral over `A^sh`
  have : Algebra.IsIntegral Ash Bsh := isIntegral_of_forall_finset (maximalIdeal Ap)
    (maximalIdeal Bp) (R := Ap) (S := Bp) (Rp := Ap) (Sq := Bp) (Rsh := Ash) (Ssh := Bsh)
    (forall_finset_of_ind hB _)
  have : IsSepClosed (ResidueField Ash) := IsSepClosure.sep_closed (ResidueField Ap)
  have : Algebra.IsIntegral (ResidueField Ash) (ResidueField Bsh) := Algebra.IsIntegral.residueField
  have : IsPurelyInseparable (ResidueField Ash) (ResidueField Bsh) := inferInstance
  -- `κ(D^sh)` is algebraic over `κ(C^sh)`: it is so over the field generated by `κ(B^sh)`
  have : Algebra.IsAlgebraic (ResidueField Csh) (ResidueField Dsh) := by
    let F := IntermediateField.adjoin (ResidueField Csh)
      (Set.range fun y : Bsh => residue Dsh (algebraMap Bsh Dsh y))
    have hgen : ∀ y : Bsh, IsIntegral (ResidueField Csh) (residue Dsh (algebraMap Bsh Dsh y)) := by
      intro y
      have h₁ : IsIntegral Ash (residue Dsh (algebraMap Bsh Dsh y)) :=
        ((Algebra.IsIntegral.isIntegral (R := Ash) y).map
          (IsScalarTower.toAlgHom Ash Bsh Dsh)).map
          (IsScalarTower.toAlgHom Ash Dsh (ResidueField Dsh))
      exact (h₁.tower_top (A := Csh)).tower_top
    have : Algebra.IsAlgebraic (ResidueField Csh) F :=
      IntermediateField.isAlgebraic_adjoin fun _ ⟨y, hy⟩ => hy ▸ hgen y
    have hrF : ∀ x : D, residue Dsh (algebraMap D Dsh x) ∈ F := by
      intro x
      obtain ⟨t, rfl⟩ := (Algebra.IsPushout.equiv A B C D).surjective x
      induction t using TensorProduct.inductionOn with
      | tmul b c =>
        rw [Algebra.IsPushout.equiv_tmul, map_mul, map_mul]
        refine mul_mem (IntermediateField.subset_adjoin _ _ ⟨algebraMap B Bsh b, ?_⟩) ?_
        · simp only [← IsScalarTower.algebraMap_apply]
        · rw [← IsScalarTower.algebraMap_apply C D Dsh, IsScalarTower.algebraMap_apply C Csh Dsh,
            ← ResidueField.algebraMap_residue]
          exact F.algebraMap_mem _
      | add x y hx hy =>
        rw [map_add, map_add, map_add]
        exact add_mem hx hy
    have hF := algebraMap_residueField_mem P (Rp := Dp) (S := Dsh) F hrF
    let φ : ResidueField Dp →+* F :=
      (algebraMap (ResidueField Dp) (ResidueField Dsh)).codRestrict F.toSubalgebra.toSubring hF
    have : Algebra.IsSeparable (ResidueField Dp) (ResidueField Dsh) := IsSepClosure.separable
    have : Algebra.IsAlgebraic F (ResidueField Dsh) := by
      refine ⟨fun y => ?_⟩
      obtain ⟨p, hp0, hpy⟩ := Algebra.IsAlgebraic.isAlgebraic (R := ResidueField Dp) y
      refine ⟨p.map φ, (Polynomial.map_ne_zero_iff φ.injective).mpr hp0, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact hpy
    exact Algebra.IsAlgebraic.trans (ResidueField Csh) F (ResidueField Dsh)
  exact bijective_tensorProduct_lift_of_isIntegral_of_isPurelyInseparable (A := A) (B := B) (C := C)
    P (Bp := Bp) (Cp := Cp) (Dp := Dp) (Ash := Ash) (Bsh := Bsh) (Csh := Csh) (Dsh := Dsh)

include A B C D P Bp Cp Dp in
/-- **Strict henselization and tensor products, integral case** (Stacks 0GIP (4)). In the
situation of Lemma 0GIP, if `B` is integral over `A`, then `B^sh ⊗_{A^sh} C^sh → D^sh` is an
isomorphism. -/
@[stacks 0GIP "(4).
The field `κ` is replaced by the prime `P = ker(D → κ)` of `D`: the statement is proved for all
strict henselizations `A^sh`, `B^sh`, `C^sh`, `D^sh` of the localizations at the contractions of `P`
and all local maps between them forming a commutative square over `A → B, C → D`, which includes
the maps of Lemma 04GU attached to the embeddings of the residue fields in `κ`. The isomorphism is
the bijectivity of `Algebra.TensorProduct.lift` of the two maps into `D^sh`, and
`D = B ⊗_A C` is any `Algebra.IsPushout A B C D`. See the module docstring."]
theorem bijective_tensorProduct_lift_of_isIntegral
    {Ap : Type u} [CommRing Ap] [IsLocalRing Ap] [Algebra A Ap]
    [IsLocalization.AtPrime Ap (P.under A)]
    [Algebra Ap Ash] [IsScalarTower A Ap Ash] [IsLocalHom (algebraMap Ap Ash)]
    [IsSepClosure (ResidueField Ap) (ResidueField Ash)] [IsHenselization Ap (ResidueField Ash) Ash]
    [IsSepClosure (ResidueField Bp) (ResidueField Bsh)]
    [IsLocalHom (algebraMap Ash Bsh)] [IsLocalHom (algebraMap Ash Csh)]
    [IsLocalHom (algebraMap Csh Dsh)] [Algebra.IsIntegral A B] :
    Function.Bijective (Algebra.TensorProduct.lift (IsScalarTower.toAlgHom Ash Bsh Dsh)
      (IsScalarTower.toAlgHom Ash Csh Dsh) fun _ _ => .all _ _) :=
  bijective_tensorProduct_lift_of_forall_finset (A := A) (B := B) (C := C) P (Bp := Bp)
    (Cp := Cp) (Dp := Dp) (Ash := Ash) (Bsh := Bsh) (Csh := Csh) (Dsh := Dsh) (Ap := Ap)
    (forall_finset_of_isIntegral (P.under B))

end IsLocalRing.IsHenselization
