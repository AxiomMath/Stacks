module

public import Mathlib.FieldTheory.IsSepClosed
public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.LocalRing.ResidueField.Instances
public import Mathlib.RingTheory.Polynomial.Subring
public import Mathlib.RingTheory.RingHom.PurelyInseparable
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Henselian.QuasiFinite

@[expose] public section

/-!
# Integral domains over henselian local rings

An integral domain over a henselian local ring is again a henselian local ring, and the
structure homomorphism is local. If the base is strictly henselian, then so is the domain and
the induced extension of residue fields is purely inseparable.

## Main results

* `RingHom.exists_henselianLocalRing_of_isIntegral_of_isDomain` (Stacks 092X): an integral
  homomorphism `f : A →+* B` from a henselian local ring to a domain gives the henselian and
  local structures on `B`, makes `f` a local homomorphism, and records the strictly henselian
  refinement: if the residue field of `A` is separably closed, then so is the residue field of
  `B`, and `ResidueField.map f` is purely inseparable.

## Implementation notes

A strictly henselian local ring is represented by `HenselianLocalRing` together with
`IsSepClosed` for its residue field. The conclusion packages the henselian and local structures
existentially so that the induced residue-field homomorphism can be stated canonically.

The proof reduces to the finite case: locality and the henselian simple-root lifting property
are both checked inside the finite `A`-subalgebra of `B` generated by the finitely many elements
involved, where `HenselianLocalRing.henselianLocalRing_and_finite_of_finite_of_quasiFiniteAt`
(Stacks 04GH, in `StacksFrontier.RingTheory.Henselian.QuasiFinite`) applies.

A domain finite over `A` is local because `exists_algEquiv_pi_isLocalRing` decomposes it, after
passing to `ULift`, as a finite product of local rings, and a domain admits only one factor; the
private lemma `henselianLocalRing_of_finite` then applies item (2) of 04GH, which allows the
base and the algebra to live in independent universes.

## References

* [The Stacks Project, Tag 092X](https://stacks.math.columbia.edu/tag/092X)
-/

universe u v

open IsLocalRing

/-- Henselianness of a local ring transfers along a ring isomorphism. -/
private lemma henselianLocalRing_of_ringEquiv {R : Type*} {S : Type*} [CommRing R] [CommRing S]
    [HenselianLocalRing R] (e : R ≃+* S) : HenselianLocalRing S := by
  let : IsLocalRing S := e.isLocalRing
  refine { is_henselian := ?_ }
  intro g hg a₀ hga₀ hgd
  have hmap : ∀ (p : Polynomial S) (x : S),
      (p.map (e.symm : S →+* R)).eval (e.symm x) = e.symm (p.eval x) :=
    fun p x ↦ Polynomial.eval_map_apply (e.symm : S →+* R) x
  have hmonic : (g.map (e.symm : S →+* R)).Monic := hg.map _
  have hmem : (g.map (e.symm : S →+* R)).eval (e.symm a₀) ∈ maximalIdeal R := by
    rw [mem_maximalIdeal, mem_nonunits_iff, hmap]
    intro hu
    exact ((mem_maximalIdeal _).mp hga₀) (by simpa using hu.map (e : R →+* S))
  have hderiv : IsUnit ((g.map (e.symm : S →+* R)).derivative.eval (e.symm a₀)) := by
    rw [Polynomial.derivative_map, hmap]
    exact hgd.map (e.symm : S →+* R)
  obtain ⟨a, ha, ha₀⟩ := HenselianLocalRing.is_henselian _ hmonic (e.symm a₀) hmem hderiv
  refine ⟨e a, ?_, ?_⟩
  · have h1 : (g.map (e.symm : S →+* R)).eval a = e.symm (g.eval (e a)) := by
      have h := hmap g (e a)
      rwa [e.symm_apply_apply] at h
    have h2 : e.symm (g.eval (e a)) = 0 := by rw [← h1]; exact ha
    simpa using congrArg (e : R →+* S) h2
  · rw [mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact ((mem_maximalIdeal _).mp ha₀) (by simpa using hu.map (e.symm : S →+* R))

/-- **04GH (2)** with the base and the algebra in independent universes: a local algebra which is
module-finite over a henselian local ring is henselian. -/
@[ega "IV 18.5.10" "special case"]
private lemma henselianLocalRing_of_finite (A : Type u) (B : Type v) [CommRing A]
    [HenselianLocalRing A] [CommRing B] [Algebra A B] [IsLocalRing B] [Module.Finite A B] :
    HenselianLocalRing B := by
  exact ((HenselianLocalRing.henselianLocalRing_and_finite_of_finite_of_quasiFiniteAt.{u, v, v}
    A).2.1 B inferInstance).1

/-- A finite integral domain over a henselian local ring is henselian. -/
private lemma henselianLocalRing_of_finite_of_isDomain
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [HenselianLocalRing A]
    [IsDomain B] [Algebra A B] [Module.Finite A B] : HenselianLocalRing B := by
  classical
  let : Module.Finite A (ULift.{u} B) := Module.Finite.equiv (ULift.moduleEquiv (R := A)).symm
  obtain ⟨n, C, hCcomm, hCalg, hCloc, hCfinite, ⟨e'⟩⟩ :=
    exists_algEquiv_pi_isLocalRing.{u, v} A (ULift.{u} B)
  let (i : Fin n) : CommRing (C i) := hCcomm i
  let (i : Fin n) : Algebra A (C i) := hCalg i
  let (i : Fin n) : IsLocalRing (C i) := hCloc i
  let e : B ≃+* ∀ i, C i :=
    (ULift.ringEquiv : ULift.{u} B ≃+* B).symm.trans e'.toRingEquiv
  have hnonempty : Nonempty (Fin n) := not_isEmpty_iff.mp fun h => by
    let : IsEmpty (Fin n) := h
    exact zero_ne_one (e.injective (Subsingleton.elim _ _))
  let : Nonempty (Fin n) := hnonempty
  have hsubsingleton : Subsingleton (Fin n) := by
    constructor
    intro i j
    by_contra hij
    let x : ∀ k, C k := fun k => if k = i then 1 else 0
    let y : ∀ k, C k := fun k => if k = j then 1 else 0
    have hx : x ≠ 0 := by
      intro hx
      have := congrFun hx i
      simp [x] at this
    have hy : y ≠ 0 := by
      intro hy
      have := congrFun hy j
      simp [y] at this
    have hxy : x * y = 0 := by
      funext k
      simp only [Pi.mul_apply, Pi.zero_apply]
      by_cases hki : k = i <;> by_cases hkj : k = j
      · exact (hij (hki.symm.trans hkj)).elim
      · have hij' : i ≠ j := fun h ↦ hkj (hki.trans h)
        simp [x, y, hki, hij']
      · have hji : j ≠ i := fun h ↦ hki (hkj.trans h)
        simp [x, y, hkj, hji]
      · simp [x, y, hki, hkj]
    have hp : e.symm x * e.symm y = 0 := by
      rw [← map_mul, hxy, map_zero]
    rcases mul_eq_zero.mp hp with hx0 | hy0
    · apply hx
      apply e.symm.injective
      simpa using hx0
    · apply hy
      apply e.symm.injective
      simpa using hy0
  let : Subsingleton (Fin n) := hsubsingleton
  let : Inhabited (Fin n) := ⟨Classical.choice hnonempty⟩
  let : Unique (Fin n) := Unique.mk' (Fin n)
  let : IsLocalRing (∀ i, C i) := (RingEquiv.piUnique C).symm.isLocalRing
  let : IsLocalRing B := e.symm.isLocalRing
  exact henselianLocalRing_of_finite A B

/-- The subalgebra of a domain integral over a henselian local ring generated by a finite set is
henselian. -/
private lemma henselianLocalRing_adjoin_of_isDomain
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [HenselianLocalRing A]
    [IsDomain B] [Algebra A B] [Algebra.IsIntegral A B] (s : Finset B) :
    HenselianLocalRing (Algebra.adjoin A (s : Set B)) := by
  have : Module.Finite A (Algebra.adjoin A (s : Set B)) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
      (fun x _ ↦ Algebra.IsIntegral.isIntegral x)
  exact henselianLocalRing_of_finite_of_isDomain (A := A)

/-- An integral extension of local rings is a local homomorphism. -/
private lemma isLocalHom_algebraMap_of_isIntegral {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S] [Algebra.IsIntegral R S] :
    IsLocalHom (algebraMap R S) :=
  ((IsLocalRing.local_hom_TFAE (algebraMap R S)).out 5 1).mp
    (IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := R) (maximalIdeal S)))

/-- Locality can be checked in the finite subalgebra generated by a single element. -/
private lemma isLocalRing_of_isIntegral_of_isDomain
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [HenselianLocalRing A]
    [IsDomain B] [Algebra A B] [Algebra.IsIntegral A B] : IsLocalRing B := by
  classical
  apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
  intro b
  let S : Subalgebra A B := Algebra.adjoin A (↑({b} : Finset B) : Set B)
  have : HenselianLocalRing S := henselianLocalRing_adjoin_of_isDomain (A := A) {b}
  have hb : b ∈ S := Algebra.subset_adjoin (by simp)
  exact (IsLocalRing.isUnit_or_isUnit_one_sub_self (⟨b, hb⟩ : S)).imp
    (fun h ↦ h.map S.val) (fun h ↦ by
      show IsUnit (S.val (1 - (⟨b, hb⟩ : S)))
      exact h.map S.val)

/-- A simple-root problem descends to a finite subalgebra, together with the inverse derivative. -/
private lemma henselianLocalRing_of_isIntegral_of_isDomain
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [HenselianLocalRing A]
    [IsDomain B] [Algebra A B] [Algebra.IsIntegral A B] : HenselianLocalRing B := by
  let : IsLocalRing B :=
    isLocalRing_of_isIntegral_of_isDomain (A := A) (B := B)
  refine { is_henselian := ?_ }
  intro g hg a₀ hga₀ hgd
  classical
  obtain ⟨d, hd⟩ := hgd
  let s : Finset B := g.support.image g.coeff ∪ {a₀, (↑(d⁻¹) : B)}
  let S : Subalgebra A B := Algebra.adjoin A (s : Set B)
  have : HenselianLocalRing S := henselianLocalRing_adjoin_of_isDomain (A := A) s
  have hcoeff (n : ℕ) : g.coeff n ∈ S := by
    by_cases hn : n ∈ g.support
    · have hmem : g.coeff n ∈ s := by
        show g.coeff n ∈ g.support.image g.coeff ∪ {a₀, (↑(d⁻¹) : B)}
        apply Finset.mem_union_left
        show g.coeff n ∈ g.support.image g.coeff
        exact Finset.mem_image.mpr ⟨n, hn, rfl⟩
      exact Algebra.subset_adjoin hmem
    · simp only [Polynomial.mem_support_iff, ne_eq, not_not] at hn
      rw [hn]
      exact S.zero_mem
  have hcoeffs : (↑g.coeffs : Set B) ⊆ S.toSubring := by
    intro b hb
    obtain ⟨n, _, rfl⟩ := Polynomial.mem_coeffs_iff.mp hb
    exact hcoeff n
  let p : Polynomial S := g.toSubring S.toSubring hcoeffs
  have hpmap : p.map S.val = g := by
    exact g.map_toSubring S.toSubring hcoeffs
  have hpmonic : p.Monic := by
    apply Polynomial.monic_of_injective (f := (S.val : S →+* B)) Subtype.val_injective
    simpa [hpmap] using hg
  have ha₀ : a₀ ∈ S := Algebra.subset_adjoin (by simp [s])
  have hdInv : (↑(d⁻¹) : B) ∈ S := Algebra.subset_adjoin (by simp [s])
  let aS : S := ⟨a₀, ha₀⟩
  have heval : S.val (p.eval aS) = g.eval a₀ := by
    rw [← hpmap, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (S.val : S →+* B) aS).symm
  have heval_mem : p.eval aS ∈ maximalIdeal S := by
    rw [mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact ((mem_maximalIdeal _).mp hga₀) (heval ▸ hu.map S.val)
  have hderiv : S.val (p.derivative.eval aS) = g.derivative.eval a₀ := by
    rw [← hpmap, Polynomial.derivative_map, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (S.val : S →+* B) aS).symm
  have hdval : (d : B) = g.derivative.eval a₀ := hd
  have hdmem : (d : B) ∈ S := by
    rw [hd, ← hderiv]
    exact (p.derivative.eval aS).property
  let dS : S := ⟨d, hdmem⟩
  let diS : S := ⟨↑(d⁻¹), hdInv⟩
  have hdunit : IsUnit (p.derivative.eval aS) := by
    refine ⟨⟨dS, diS, ?_, ?_⟩, ?_⟩
    · ext
      show (d : B) * ↑(d⁻¹) = 1
      exact d.val_inv
    · ext
      show (↑(d⁻¹) : B) * d = 1
      exact d.inv_val
    · ext
      exact (hderiv.trans hdval.symm).symm
  obtain ⟨z, hz, hza⟩ := HenselianLocalRing.is_henselian p hpmonic aS heval_mem hdunit
  refine ⟨z, ?_, ?_⟩
  · show g.eval (z : B) = 0
    calc
      g.eval (z : B) = S.val (p.eval z) := by
        rw [← hpmap, Polynomial.eval_map]
        exact Polynomial.eval₂_at_apply (S.val : S →+* B) z
      _ = 0 := by rw [hz, map_zero]
  · have hSB : Algebra.IsIntegral S B := Algebra.IsIntegral.tower_top A
    let : Algebra.IsIntegral S B := hSB
    have : IsLocalHom (S.val : S →+* B) := isLocalHom_algebraMap_of_isIntegral (R := S) (S := B)
    simpa using map_nonunit (S.val : S →+* B) (z - aS) hza

/-- An integral homomorphism from a henselian local ring to a domain makes the target a
henselian local ring and is a local homomorphism. If the source residue field is separably
closed, then the target residue field is separably closed and its extension along the induced
residue-field homomorphism is purely inseparable. -/
@[stacks 092X]
theorem RingHom.exists_henselianLocalRing_of_isIntegral_of_isDomain
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [HenselianLocalRing A] [IsDomain B] (f : A →+* B) (hf : f.IsIntegral) :
    ∃ (hB : HenselianLocalRing B) (hlocal : IsLocalHom f),
      letI : IsLocalRing B := hB.toIsLocalRing
      letI : IsLocalHom f := hlocal
      IsSepClosed (ResidueField A) →
        IsSepClosed (ResidueField B) ∧ (ResidueField.map f).IsPurelyInseparable := by
  let : Algebra A B := f.toAlgebra
  have halg : Algebra.IsIntegral A B := ⟨hf⟩
  let : Algebra.IsIntegral A B := halg
  let hB : HenselianLocalRing B :=
    henselianLocalRing_of_isIntegral_of_isDomain (A := A) (B := B)
  let : IsLocalRing B := hB.toIsLocalRing
  have hlocal : IsLocalHom f := isLocalHom_algebraMap_of_isIntegral (R := A) (S := B)
  refine ⟨hB, hlocal, ?_⟩
  let : IsLocalHom f := hlocal
  let : IsLocalHom (algebraMap A B) := by
    simpa [RingHom.algebraMap_toAlgebra] using hlocal
  intro hsep
  let : IsSepClosed (ResidueField A) := hsep
  have : Algebra.IsIntegral A (ResidueField B) := Algebra.IsIntegral.trans B
  have : Algebra.IsIntegral (ResidueField A) (ResidueField B) := Algebra.IsIntegral.tower_top A
  have halgebraic : Algebra.IsAlgebraic (ResidueField A) (ResidueField B) := inferInstance
  let : Algebra.IsAlgebraic (ResidueField A) (ResidueField B) := halgebraic
  refine ⟨Algebra.IsAlgebraic.isSepClosed (F := ResidueField A), ?_⟩
  show (algebraMap (ResidueField A) (ResidueField B)).IsPurelyInseparable
  exact RingHom.isPurelyInseparable_algebraMap_iff.mpr inferInstance
