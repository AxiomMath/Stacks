module

public import StacksFrontier.RingTheory.Henselian.QuasiFinite
public import StacksFrontier.RingTheory.Etale.FilteredColimit.Basic
public import StacksFrontier.RingTheory.Henselian.StrictHenselization.Existence
public import StacksFrontier.RingTheory.Henselian.Henselization.Existence

@[expose] public section

universe u

open IntermediateField in
/-- **The compositum of a separable algebraic closure with a finite extension.** Let `κ₁` be a
separable algebraic closure of `κp` and `κ₂` one of a finite extension `κq` of `κp`, with `κ₁`
embedded in `κ₂` over `κp`. Then `κ₂` is finite and purely inseparable over `κ₁`, and every
`κ₁`-subalgebra of `κ₂` containing the image of `κq` is everything — so `κ₂` is generated by `κ₁`
and `κq`.

The subfield `L` generated by `κ₁` and a `κp`-spanning set of `κq` is finite over `κ₁`; `κ₂` is
separable over `L` because it is separable over `κq ⊆ L`, and purely inseparable over `L` because
it is purely inseparable over the separably closed `κ₁`, so `L = κ₂`. -/
private theorem field_key {κp κq κ₁ κ₂ : Type*} [Field κp] [Field κq] [Field κ₁] [Field κ₂]
    [Algebra κp κq] [Algebra κp κ₁] [Algebra κp κ₂] [Algebra κq κ₂] [Algebra κ₁ κ₂]
    [IsScalarTower κp κq κ₂] [IsScalarTower κp κ₁ κ₂]
    [IsSepClosure κp κ₁] [IsSepClosure κq κ₂] [Module.Finite κp κq] :
    Module.Finite κ₁ κ₂ ∧ IsPurelyInseparable κ₁ κ₂ ∧
      ∀ A : Subalgebra κ₁ κ₂, (∀ x : κq, algebraMap κq κ₂ x ∈ A) → A = ⊤ := by
  have halgq : Algebra.IsAlgebraic κp κq := Algebra.IsAlgebraic.of_finite κp κq
  have hsepq : Algebra.IsSeparable κq κ₂ := IsSepClosure.separable
  have halg2 : Algebra.IsAlgebraic κq κ₂ := inferInstance
  have : Algebra.IsAlgebraic κp κ₂ := .trans κp κq κ₂
  have h1 : Algebra.IsAlgebraic κ₁ κ₂ := Algebra.IsAlgebraic.tower_top (K := κp) κ₁
  have : IsSepClosed κ₁ := IsSepClosure.sep_closed κp
  have hpi : IsPurelyInseparable κ₁ κ₂ := inferInstance
  obtain ⟨s, hs⟩ : (⊤ : Submodule κp κq).FG := Module.Finite.fg_top
  set t : Set κ₂ := algebraMap κq κ₂ '' (s : Set κq)
  have : Finite t := (s.finite_toSet.image _).to_subtype
  set L : IntermediateField κ₁ κ₂ := adjoin κ₁ t with hL
  have hfd : FiniteDimensional κ₁ L :=
    finiteDimensional_adjoin fun x _ => (Algebra.IsIntegral.isIntegral (R := κ₁) x)
  have hsub : ∀ x : κq, algebraMap κq κ₂ x ∈ L := by
    intro x
    have hx : x ∈ Submodule.span κp (s : Set κq) := hs ▸ Submodule.mem_top
    induction hx using Submodule.span_induction with
    | mem y hy => exact subset_adjoin κ₁ t ⟨y, hy, rfl⟩
    | zero => simp
    | add y z _ _ hy hz =>
        rw [map_add]
        exact add_mem hy hz
    | smul c y _ hy =>
        rw [Algebra.smul_def, map_mul]
        refine mul_mem ?_ hy
        rw [← IsScalarTower.algebraMap_apply κp κq κ₂ c,
          IsScalarTower.algebraMap_apply κp κ₁ κ₂ c]
        exact L.algebraMap_mem _
  let _ : Algebra κq L := ((algebraMap κq κ₂).codRestrict L.toSubalgebra hsub).toAlgebra
  have htow : IsScalarTower κq L κ₂ := .of_algebraMap_eq fun _ => rfl
  have : Algebra.IsSeparable L κ₂ := Algebra.isSeparable_tower_top_of_isSeparable κq L κ₂
  have : IsPurelyInseparable L κ₂ := IsPurelyInseparable.tower_top κ₁ L κ₂
  have hbij : Function.Bijective (algebraMap L κ₂) :=
    IsPurelyInseparable.bijective_algebraMap_of_isSeparable L κ₂
  have hfin : Module.Finite κ₁ κ₂ :=
    Module.Finite.of_surjective ((IsScalarTower.toAlgHom κ₁ L κ₂).toLinearMap) hbij.2
  refine ⟨hfin, hpi, fun A hA => ?_⟩
  have hLtop : L = ⊤ := eq_top_iff.mpr fun x _ => by
    obtain ⟨y, rfl⟩ := hbij.2 x
    exact y.2
  have hadj : Algebra.adjoin κ₁ t = ⊤ :=
    (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
      fun x _ => Algebra.IsAlgebraic.isAlgebraic x).mp (hL.symm.trans hLtop)
  refine top_le_iff.mp (hadj ▸ Algebra.adjoin_le ?_)
  rintro z ⟨y, -, rfl⟩
  exact hA y

/-- **A field isomorphic to a separably closed field is separably closed.** A monic irreducible
separable polynomial is carried to one over the separably closed field, where it has a root. -/
theorem IsSepClosed.of_ringEquiv {M N : Type*} [Field M] [Field N] [IsSepClosed M]
    (e : N ≃+* M) : IsSepClosed N := by
  refine IsSepClosed.of_exists_root N fun p _ hirr hsep => ?_
  have hdeg : (p.map (e : N →+* M)).degree ≠ 0 := by
    rw [Polynomial.degree_map_eq_of_injective e.injective]
    exact fun h => hirr.not_isUnit (Polynomial.isUnit_iff_degree_eq_zero.mpr h)
  obtain ⟨y, hy⟩ := IsSepClosed.exists_root (p.map (e : N →+* M)) hdeg hsep.map
  have key : ∀ x : N, (p.map (e : N →+* M)).eval (e x) = e (p.eval x) := fun x => by
    simpa [Polynomial.eval_map] using Polynomial.eval₂_at_apply (p := p) (e : N →+* M) x
  have h := key (e.symm y)
  rw [e.apply_symm_apply] at h
  exact ⟨e.symm y, (map_eq_zero_iff e e.injective).mp (h.symm.trans hy)⟩

/-- **A separable algebraic closure transported along a ring isomorphism of the target.** If `M` is
a separable algebraic closure of `K` and `e : N ≃+* M` is compatible with the two maps out of `K`,
then `N` is a separable algebraic closure of `K`. -/
private theorem isSepClosure_of_ringEquiv {K M N : Type*} [Field K] [Field M] [Field N]
    [Algebra K M] [Algebra K N] [IsSepClosure K M] (e : N ≃+* M)
    (he : (e : N →+* M).comp (algebraMap K N) = algebraMap K M) : IsSepClosure K N := by
  have := IsSepClosure.sep_closed K (K := M)
  refine isSepClosure_iff.mpr ⟨IsSepClosed.of_ringEquiv e, ?_⟩
  exact Algebra.IsSeparable.of_equiv_equiv (RingEquiv.refl K) e.symm
    (by ext x; exact (e.symm_apply_eq.mpr (RingHom.congr_fun he x).symm).symm)

/-- An `A`-algebra map from a finitely presented `A`-algebra to the localization of `A` at a
prime `𝔭` factors through `A` localized away from a single element outside `𝔭`. -/
private theorem exists_away_factorization {A B P : Type u} [CommRing A] [CommRing B] [CommRing P]
    [Algebra A B] [Algebra A P] (𝔭 : Ideal A) [𝔭.IsPrime] [IsLocalization.AtPrime B 𝔭]
    [Algebra.FinitePresentation A P] (φ : P →ₐ[A] B) :
    ∃ (g : A) (_ : g ∈ 𝔭.primeCompl) (θ : P →ₐ[A] Localization.Away g)
      (μ : Localization.Away g →ₐ[A] B), μ.comp θ = φ := by
  classical
  obtain ⟨n, ψ, hψ, sset, hsset⟩ : ∃ (n : ℕ) (ψ : MvPolynomial (Fin n) A →ₐ[A] P),
      Function.Surjective ψ ∧ ∃ sset : Finset (MvPolynomial (Fin n) A),
        Ideal.span (sset : Set (MvPolynomial (Fin n) A)) = RingHom.ker ψ.toRingHom := by
    obtain ⟨n, ψ, h1, sset, hsset⟩ := Algebra.FinitePresentation.out (R := A) (A := P)
    exact ⟨n, ψ, h1, sset, hsset⟩
  obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples_of_finite 𝔭.primeCompl
    (fun i : Fin n => φ (ψ (MvPolynomial.X i)))
  have hd' : ∀ i : Fin n, ∃ y : A, algebraMap A B y = (d : A) • φ (ψ (MvPolynomial.X i)) :=
    fun i => hd i
  choose a ha using hd'
  -- the first-stage localization, away from the common denominator `d`
  have hdunit : IsUnit (algebraMap A (Localization.Away (d : A)) (d : A)) :=
    IsLocalization.map_units _ (⟨(d : A), Submonoid.mem_powers _⟩ : Submonoid.powers (d : A))
  set v : Localization.Away (d : A) := ↑hdunit.unit⁻¹
  have hvmul : algebraMap A (Localization.Away (d : A)) (d : A) * v = 1 := hdunit.mul_val_inv
  set θ₀ : MvPolynomial (Fin n) A →ₐ[A] Localization.Away (d : A) :=
    MvPolynomial.aeval fun i => algebraMap A (Localization.Away (d : A)) (a i) * v with hθ₀
  have hlift : ∀ g ∈ 𝔭.primeCompl, ∃ μ : Localization.Away g →ₐ[A] B,
      ∀ x : A, μ (algebraMap A (Localization.Away g) x) = algebraMap A B x := fun g hg =>
    have hunit := (IsLocalization.AtPrime.isUnit_to_map_iff B 𝔭 g).mpr hg
    ⟨IsLocalization.Away.liftAlgHom (f := Algebra.ofId A B) g hunit,
      IsLocalization.Away.lift_eq g hunit⟩
  have hBunit : IsUnit (algebraMap A B (d : A)) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff B 𝔭 (d : A)).mpr d.2
  obtain ⟨μ₀, hμ₀alg⟩ := hlift d d.2
  have hcomp : μ₀.comp θ₀ = φ.comp ψ := by
    refine MvPolynomial.algHom_ext fun i => ?_
    rw [AlgHom.comp_apply, AlgHom.comp_apply, hθ₀, MvPolynomial.aeval_X, map_mul, hμ₀alg]
    have hvB : μ₀ v = ↑hBunit.unit⁻¹ := by
      refine hBunit.mul_left_cancel ?_
      rw [hBunit.mul_val_inv, ← hμ₀alg (d : A), ← map_mul, hvmul, map_one]
    rw [hvB, ha i, Algebra.smul_def, mul_right_comm,
      show (algebraMap A B) (d : A) * ↑hBunit.unit⁻¹ = 1 from hBunit.mul_val_inv, one_mul]
  -- `B` is also a localization of that first-stage localization
  let _ : Algebra (Localization.Away (d : A)) B := (μ₀ : Localization.Away (d : A) →+* B).toAlgebra
  have htow : IsScalarTower A (Localization.Away (d : A)) B :=
    .of_algebraMap_eq fun x => (hμ₀alg x).symm
  have hple : Submonoid.powers (d : A) ≤ 𝔭.primeCompl := by
    rintro _ ⟨k, rfl⟩
    exact pow_mem d.2 k
  have _ : IsLocalization (𝔭.primeCompl.map (algebraMap A (Localization.Away (d : A)))) B :=
    IsLocalization.isLocalization_of_submonoid_le (Localization.Away (d : A)) B
      (Submonoid.powers (d : A)) 𝔭.primeCompl hple
  -- each relation is annihilated by an element outside `𝔭`
  have hkill : ∀ r : {x // x ∈ sset}, ∃ t : A, t ∈ 𝔭.primeCompl ∧
      algebraMap A (Localization.Away (d : A)) t * θ₀ (r : MvPolynomial (Fin n) A) = 0 := by
    intro r
    have hmem : (r : MvPolynomial (Fin n) A) ∈ RingHom.ker ψ.toRingHom :=
      hsset ▸ Ideal.subset_span r.2
    have hr0 : algebraMap (Localization.Away (d : A)) B (θ₀ (r : MvPolynomial (Fin n) A))
        = algebraMap (Localization.Away (d : A)) B 0 := by
      rw [map_zero]
      show μ₀ (θ₀ (r : MvPolynomial (Fin n) A)) = 0
      rw [← AlgHom.comp_apply, hcomp, AlgHom.comp_apply,
        show ψ (r : MvPolynomial (Fin n) A) = 0 from RingHom.mem_ker.mp hmem, map_zero]
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq
      (M := 𝔭.primeCompl.map (algebraMap A (Localization.Away (d : A)))) hr0
    obtain ⟨t, ht, hct⟩ := c.2
    exact ⟨t, ht, by rw [hct]; simpa using hc⟩
  choose t ht hts using hkill
  set u : A := ∏ r : {x // x ∈ sset}, t r
  have hu' : u ∈ 𝔭.primeCompl := Submonoid.prod_mem _ fun r _ => ht r
  have hgmem : (d : A) * u ∈ 𝔭.primeCompl := mul_mem d.2 hu'
  -- the second-stage localization, away from `d * u`
  have hgunit : IsUnit (algebraMap A (Localization.Away ((d : A) * u)) ((d : A) * u)) :=
    IsLocalization.map_units _
      (⟨(d : A) * u, Submonoid.mem_powers _⟩ : Submonoid.powers ((d : A) * u))
  have hdunit2 : IsUnit (algebraMap A (Localization.Away ((d : A) * u)) (d : A)) :=
    isUnit_of_mul_isUnit_left (by rwa [← map_mul])
  have htunit : ∀ r : {x // x ∈ sset},
      IsUnit (algebraMap A (Localization.Away ((d : A) * u)) (t r)) := by
    intro r
    obtain ⟨c, hc⟩ := (Finset.dvd_prod_of_mem t (Finset.mem_univ r)).mul_left (d : A)
    refine isUnit_of_mul_isUnit_left (y := algebraMap A _ c) ?_
    rwa [← map_mul, ← hc]
  set ν : Localization.Away (d : A) →ₐ[A] Localization.Away ((d : A) * u) :=
    IsLocalization.Away.liftAlgHom (f := Algebra.ofId A (Localization.Away ((d : A) * u)))
      (d : A) hdunit2
  have hνalg : ∀ x : A, ν (algebraMap A (Localization.Away (d : A)) x)
      = algebraMap A (Localization.Away ((d : A) * u)) x :=
    fun x => IsLocalization.Away.lift_eq (d : A) hdunit2 x
  set χ : MvPolynomial (Fin n) A →ₐ[A] Localization.Away ((d : A) * u) := ν.comp θ₀ with hχ
  have hsub : Ideal.span (sset : Set (MvPolynomial (Fin n) A))
      ≤ RingHom.ker (χ : MvPolynomial (Fin n) A →+* Localization.Away ((d : A) * u)) := by
    refine Ideal.span_le.mpr fun y hy => ?_
    have h0 := congrArg ν (hts ⟨y, hy⟩)
    rw [map_mul, map_zero, hνalg] at h0
    refine RingHom.mem_ker.mpr ((htunit ⟨y, hy⟩).mul_left_cancel ?_)
    rw [mul_zero]
    show algebraMap A (Localization.Away ((d : A) * u)) (t ⟨y, hy⟩) * χ y = 0
    rwa [hχ, AlgHom.comp_apply]
  have hkerχ : ∀ x ∈ RingHom.ker ψ.toRingHom, χ x = 0 := fun x hx =>
    RingHom.mem_ker.mp (hsub (by rwa [hsset]))
  set θ : P →ₐ[A] Localization.Away ((d : A) * u) :=
    (Ideal.Quotient.liftₐ (RingHom.ker ψ.toRingHom) χ hkerχ).comp
      (Ideal.quotientKerAlgEquivOfSurjective hψ).symm.toAlgHom with hθ
  have hθψ : ∀ x, θ (ψ x) = χ x := by
    intro x
    have hsy : (Ideal.quotientKerAlgEquivOfSurjective hψ).symm (ψ x)
        = Ideal.Quotient.mk (RingHom.ker ψ.toRingHom) x :=
      (AlgEquiv.symm_apply_eq _).mpr rfl
    rw [hθ, AlgHom.comp_apply]
    show (Ideal.Quotient.liftₐ (RingHom.ker ψ.toRingHom) χ hkerχ)
      ((Ideal.quotientKerAlgEquivOfSurjective hψ).symm (ψ x)) = χ x
    rw [hsy]
    rfl
  obtain ⟨μ, hμalg⟩ := hlift _ hgmem
  have hμν : (μ.comp ν : Localization.Away (d : A) →+* B) = (μ₀ : _ →+* B) :=
    IsLocalization.ringHom_ext (Submonoid.powers (d : A))
      (RingHom.ext fun x => by
        show μ (ν (algebraMap A (Localization.Away (d : A)) x)) = μ₀ (algebraMap _ _ x)
        rw [hνalg, hμalg, hμ₀alg])
  refine ⟨(d : A) * u, hgmem, θ, μ, AlgHom.ext fun y => ?_⟩
  obtain ⟨x, rfl⟩ := hψ y
  rw [AlgHom.comp_apply, hθψ, hχ, AlgHom.comp_apply,
    show μ (ν (θ₀ x)) = μ₀ (θ₀ x) from RingHom.congr_fun hμν (θ₀ x),
    ← AlgHom.comp_apply, hcomp, AlgHom.comp_apply]

open CategoryTheory in
/-- **A localization at a prime is ind-étale**: it is a filtered colimit of the localizations away
from the elements outside the prime, each of which is étale. -/
theorem CommAlgCat.ind_etale_atPrime (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (𝔭 : Ideal A) [𝔭.IsPrime] [IsLocalization.AtPrime B 𝔭] :
    (CommAlgCat.etale.{u} A).ind.{u} (CommAlgCat.of A B) := by
  rw [CommAlgCat.ind_etale_iff_ind_algebraMap, MorphismProperty.ind_iff_ind_underMk,
    CommRingCat.ind_under_iff_exists_factorization _
      (fun (C : Under (CommRingCat.of A)) (h : CommRingCat.etale.underObj C) =>
        (RingHom.Etale.iff_flat_and_formallyUnramified.mp h).2.2)]
  intro Pu hP f
  let _ : Algebra A Pu.right := (CommRingCat.Hom.hom Pu.hom).toAlgebra
  have hfp : Algebra.FinitePresentation A Pu.right := RingHom.finitePresentation_algebraMap.mp hP
  let φ : Pu.right →ₐ[A] B :=
    { CommRingCat.Hom.hom f.right with
      commutes' := fun r => congrArg (fun h => CommRingCat.Hom.hom h r) (Under.w f) }
  obtain ⟨g, hg, θ, μ, hμθ⟩ := exists_away_factorization 𝔭 φ
  refine ⟨Under.mk (CommRingCat.ofHom (algebraMap A (Localization.Away g))),
    Under.homMk (CommRingCat.ofHom (θ : Pu.right →+* Localization.Away g)) ?_,
    Under.homMk (CommRingCat.ofHom (μ : Localization.Away g →+* B)) ?_, ?_, ?_⟩
  · ext a
    exact θ.commutes a
  · ext a
    exact μ.commutes a
  · ext a
    exact AlgHom.congr_fun hμθ a
  · exact RingHom.etale_algebraMap.mpr
      (Algebra.Etale.of_isLocalizationAway (A := Localization.Away g) g)

open CategoryTheory IsLocalRing in
/-- **Stacks 05WR**, proved without the hypothesis `hmax`, which the statement of the lemma keeps
because it is item (3) of the strict henselization of `R_p` but which this proof does not use: it
is a consequence of the other three items, by Lemmas 04GP and 08HT. -/
private theorem strictHenselization_aux
    {R S Rp Sq Rsh T Ssh κ₂ : Type u}
    [CommRing R] [CommRing S] [CommRing Rp] [CommRing Sq] [CommRing Rsh] [CommRing T]
    [CommRing Ssh] [Field κ₂] [Algebra R S]
    (p : Ideal R) (q : Ideal S) [p.IsPrime] [q.IsPrime] [q.LiesOver p]
    [Algebra.FiniteType R S] [Algebra.QuasiFiniteAt R q]
    [Algebra R Rp] [IsLocalRing Rp] [IsLocalization.AtPrime Rp p]
    [Algebra S Sq] [IsLocalRing Sq] [IsLocalization.AtPrime Sq q]
    [Algebra R Sq] [Algebra Rp Sq] [IsScalarTower R S Sq] [IsScalarTower R Rp Sq]
    [Algebra Rp Rsh] [HenselianLocalRing Rsh] [IsLocalHom (algebraMap Rp Rsh)]
    [IsSepClosure (ResidueField Rp) (ResidueField Rsh)]
    (hind : (CommAlgCat.etale.{u} Rp).ind.{u} (CommAlgCat.of Rp Rsh))
    (_hmax : (maximalIdeal Rp).map (algebraMap Rp Rsh) = maximalIdeal Rsh)
    [Algebra (ResidueField Sq) κ₂] [IsSepClosure (ResidueField Sq) κ₂]
    [Algebra (ResidueField Rsh) κ₂]
    [Algebra Rp T] [Algebra Rsh T] [Algebra Sq T]
    [IsScalarTower Rp Rsh T] [IsScalarTower Rp Sq T]
    (hT : Algebra.IsPushout Rp Sq Rsh T)
    (π : T →+* κ₂)
    (hπRsh : π.comp (algebraMap Rsh T) = (algebraMap (ResidueField Rsh) κ₂).comp (residue Rsh))
    (hπSq : π.comp (algebraMap Sq T) = (algebraMap (ResidueField Sq) κ₂).comp (residue Sq))
    [(RingHom.ker π).IsPrime]
    [Algebra T Ssh] [IsLocalRing Ssh] [IsLocalization.AtPrime Ssh (RingHom.ker π)]
    [Algebra Sq Ssh] [Algebra Rsh Ssh] [IsScalarTower Sq T Ssh] [IsScalarTower Rsh T Ssh] :
    ∃ _ : IsLocalHom (algebraMap Sq Ssh),
      Module.Finite Rsh Ssh ∧ IsLocalHom (algebraMap Rsh Ssh) ∧ HenselianLocalRing Ssh ∧
        (CommAlgCat.etale.{u} Sq).ind.{u} (CommAlgCat.of Sq Ssh) ∧
        (maximalIdeal Sq).map (algebraMap Sq Ssh) = maximalIdeal Ssh ∧
        IsSepClosure (ResidueField Sq) (ResidueField Ssh) ∧
        (∃ e : ResidueField Ssh ≃+* κ₂,
          (e : ResidueField Ssh →+* κ₂).comp ((residue Ssh).comp (algebraMap T Ssh)) = π) ∧
        Module.Finite (ResidueField Rsh) κ₂ ∧ IsPurelyInseparable (ResidueField Rsh) κ₂ := by
  -- `Rp → Sq` is a local ring map
  have hpq : (maximalIdeal Sq).comap (algebraMap R Sq) = p := by
    rw [IsScalarTower.algebraMap_eq R S Sq, ← Ideal.comap_comap,
      show (maximalIdeal Sq).comap (algebraMap S Sq) = q from
        IsLocalization.AtPrime.under_maximalIdeal Sq q]
    exact (Ideal.LiesOver.over).symm
  have hlocRpSq : IsLocalHom (algebraMap Rp Sq) := by
    have hle : maximalIdeal Rp ≤ (maximalIdeal Sq).comap (algebraMap Rp Sq) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p Rp, Ideal.map_le_iff_le_comap,
        Ideal.comap_comap, ← IsScalarTower.algebraMap_eq R Rp Sq, hpq]
    exact ⟨fun a ha => notMem_maximalIdeal.mp fun hm => notMem_maximalIdeal.mpr ha (hle hm)⟩
  -- the residue field of `Rp` acts on `κ₂` through `κ₁`
  let _ : Algebra (ResidueField Rp) κ₂ :=
    ((algebraMap (ResidueField Rsh) κ₂).comp
      (algebraMap (ResidueField Rp) (ResidueField Rsh))).toAlgebra
  have tow1 : IsScalarTower (ResidueField Rp) (ResidueField Rsh) κ₂ :=
    .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  have hsq : ∀ r : Rp, algebraMap (ResidueField Rsh) κ₂ (residue Rsh (algebraMap Rp Rsh r))
      = algebraMap (ResidueField Sq) κ₂ (residue Sq (algebraMap Rp Sq r)) := by
    intro r
    have e1 : algebraMap (ResidueField Rsh) κ₂ (residue Rsh (algebraMap Rp Rsh r))
        = π (algebraMap Rsh T (algebraMap Rp Rsh r)) :=
      (RingHom.congr_fun hπRsh (algebraMap Rp Rsh r)).symm
    have e2 : algebraMap (ResidueField Sq) κ₂ (residue Sq (algebraMap Rp Sq r))
        = π (algebraMap Sq T (algebraMap Rp Sq r)) :=
      (RingHom.congr_fun hπSq (algebraMap Rp Sq r)).symm
    rw [e1, e2, ← IsScalarTower.algebraMap_apply Rp Rsh T,
      ← IsScalarTower.algebraMap_apply Rp Sq T]
  have tow2 : IsScalarTower (ResidueField Rp) (ResidueField Sq) κ₂ := by
    refine .of_algebraMap_eq fun x => ?_
    obtain ⟨r, rfl⟩ := residue_surjective x
    rw [show algebraMap (ResidueField Rp) κ₂ = _ from RingHom.algebraMap_toAlgebra _]
    simp only [RingHom.comp_apply, IsLocalRing.ResidueField.algebraMap_residue]
    exact hsq r
  -- `κ(q)` is finite over `κ(p)`
  have hSqQF : Algebra.QuasiFinite R Sq :=
    (Algebra.QuasiFinite.iff_of_algEquiv
      ((IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) Sq).restrictScalars R)).mp
      ‹Algebra.QuasiFiniteAt R q›
  have : Algebra.QuasiFinite R (ResidueField Sq) :=
    Algebra.QuasiFinite.of_surjective_algHom (IsScalarTower.toAlgHom R Sq (ResidueField Sq))
      residue_surjective
  have : Algebra.QuasiFinite (ResidueField Rp) (ResidueField Sq) :=
    Algebra.QuasiFinite.of_restrictScalars R _ _
  have hfinres : Module.Finite (ResidueField Rp) (ResidueField Sq) := Module.Finite.of_quasiFinite
  obtain ⟨hfinκ, hpiκ, htopA⟩ := field_key (κp := ResidueField Rp) (κq := ResidueField Sq)
    (κ₁ := ResidueField Rsh) (κ₂ := κ₂)
  -- `π` is surjective
  have hrng1 : ∀ x : ResidueField Rsh, algebraMap (ResidueField Rsh) κ₂ x ∈ Set.range π := by
    intro x
    obtain ⟨y, rfl⟩ := residue_surjective x
    exact ⟨algebraMap Rsh T y, (RingHom.congr_fun hπRsh y)⟩
  have hrng2 : ∀ x : ResidueField Sq, algebraMap (ResidueField Sq) κ₂ x ∈ Set.range π := by
    intro x
    obtain ⟨y, rfl⟩ := residue_surjective x
    exact ⟨algebraMap Sq T y, (RingHom.congr_fun hπSq y)⟩
  have hπsurj : Function.Surjective π := by
    let A : Subalgebra (ResidueField Rsh) κ₂ :=
      { carrier := Set.range π
        mul_mem' := by
          rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
          exact ⟨a * b, map_mul π a b⟩
        one_mem' := ⟨1, map_one π⟩
        add_mem' := by
          rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
          exact ⟨a + b, map_add π a b⟩
        zero_mem' := ⟨0, map_zero π⟩
        algebraMap_mem' := hrng1 }
    intro z
    exact (htopA A hrng2 ▸ Algebra.mem_top : z ∈ A)
  -- the two structure maps into `Ssh` are local
  have hlocal : ∀ {X : Type u} [CommRing X] [IsLocalRing X] [Algebra X T] [Algebra X Ssh]
      [IsScalarTower X T Ssh], (∀ a ∈ maximalIdeal X, π (algebraMap X T a) = 0) →
      IsLocalHom (algebraMap X Ssh) := fun {X} _ _ _ _ _ h =>
    ⟨fun a ha => notMem_maximalIdeal.mp fun hm => notMem_maximalIdeal.mpr ha <| by
      rw [IsScalarTower.algebraMap_apply X T Ssh]
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Ssh (RingHom.ker π) _).mpr
        (RingHom.mem_ker.mpr (h a hm))⟩
  have hlocSq : IsLocalHom (algebraMap Sq Ssh) := hlocal fun a ha => by
    rw [← RingHom.comp_apply, hπSq, RingHom.comp_apply, (residue_eq_zero_iff _).mpr ha, map_zero]
  have hlocRsh : IsLocalHom (algebraMap Rsh Ssh) := hlocal fun a ha => by
    rw [← RingHom.comp_apply, hπRsh, RingHom.comp_apply, (residue_eq_zero_iff _).mpr ha, map_zero]
  -- the residue field of `Ssh` is `κ₂`
  have hunit : ∀ y : (RingHom.ker π).primeCompl, IsUnit (π y) := fun y =>
    isUnit_iff_ne_zero.mpr fun h => y.2 (RingHom.mem_ker.mpr h)
  let φ : Ssh →+* κ₂ := IsLocalization.lift (g := π) hunit
  have hφ : ∀ x : T, φ (algebraMap T Ssh x) = π x := fun x => IsLocalization.lift_eq _ x
  have hφsurj : Function.Surjective φ := fun z => by
    obtain ⟨x, rfl⟩ := hπsurj z
    exact ⟨algebraMap T Ssh x, hφ x⟩
  have hkerφ : RingHom.ker φ = maximalIdeal Ssh := ker_eq_maximalIdeal φ hφsurj
  let e : ResidueField Ssh ≃+* κ₂ :=
    (Ideal.quotEquivOfEq hkerφ.symm).trans (RingHom.quotientKerEquivOfSurjective hφsurj)
  have he : ∀ z : Ssh, e (residue Ssh z) = φ z := fun z => rfl
  have hcompat : (e : ResidueField Ssh →+* κ₂).comp
      (algebraMap (ResidueField Sq) (ResidueField Ssh)) = algebraMap (ResidueField Sq) κ₂ := by
    refine RingHom.ext fun x => ?_
    obtain ⟨y, rfl⟩ := residue_surjective x
    rw [RingHom.comp_apply, IsLocalRing.ResidueField.algebraMap_residue]
    show e (residue Ssh (algebraMap Sq Ssh y)) = _
    rw [he, IsScalarTower.algebraMap_apply Sq T Ssh, hφ, ← RingHom.comp_apply, hπSq]
    rfl
  have heq : (e : ResidueField Ssh →+* κ₂).comp ((residue Ssh).comp (algebraMap T Ssh)) = π :=
    RingHom.ext fun x => (he (algebraMap T Ssh x)).trans (hφ x)
  -- the algebra structures over `R` obtained from the tower through `Rp`
  let _ : Algebra R Rsh := ((algebraMap Rp Rsh).comp (algebraMap R Rp)).toAlgebra
  have towRRpRsh : IsScalarTower R Rp Rsh := .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  let _ : Algebra R T := ((algebraMap Rp T).comp (algebraMap R Rp)).toAlgebra
  have towRRpT : IsScalarTower R Rp T := .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  have towRRshT : IsScalarTower R Rsh T := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply R Rp Rsh, ← IsScalarTower.algebraMap_apply Rp Rsh T]
    exact IsScalarTower.algebraMap_apply R Rp T x
  have towRSqT : IsScalarTower R Sq T := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply R Rp Sq, ← IsScalarTower.algebraMap_apply Rp Sq T]
    exact IsScalarTower.algebraMap_apply R Rp T x
  let _ : Algebra S T := ((algebraMap Sq T).comp (algebraMap S Sq)).toAlgebra
  have towSSqT : IsScalarTower S Sq T := .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  have towRST : IsScalarTower R S T := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply S Sq T, ← IsScalarTower.algebraMap_apply R S Sq]
    exact IsScalarTower.algebraMap_apply R Sq T x
  -- `Sq` is its own base change along the localization `R → Rp`
  have hunitp : Algebra.algebraMapSubmonoid Sq p.primeCompl ≤ IsUnit.submonoid Sq := by
    rintro _ ⟨r, hr, rfl⟩
    rw [IsScalarTower.algebraMap_apply R Rp Sq]
    exact ((IsLocalization.AtPrime.isUnit_to_map_iff Rp p r).mpr hr).map _
  have _ : IsLocalization (Algebra.algebraMapSubmonoid Sq p.primeCompl) Sq :=
    IsLocalization.of_le_isUnit hunitp
  have hpo1 : Algebra.IsPushout R Rp Sq Sq :=
    (Algebra.isPushout_of_isLocalization (S := p.primeCompl) (A := Rp) (T := Sq) (B := Sq)).symm
  -- so `T` is also the base change of `Sq` along `R → Rsh`
  have hpo2 : Algebra.IsPushout R Sq Rsh T :=
    ((Algebra.IsPushout.comp_iff R Rp Sq Sq (T := Rsh) (T' := T)).mpr hT.symm).symm
  -- the finite type `Rsh`-algebra `U = Rsh ⊗[R] S`
  let _ : Algebra S (TensorProduct R Rsh S) := Algebra.TensorProduct.rightAlgebra
  have towRSU : IsScalarTower R S (TensorProduct R Rsh S) :=
    Algebra.TensorProduct.right_isScalarTower
  have hpo3 : Algebra.IsPushout R S Rsh (TensorProduct R Rsh S) := TensorProduct.isPushout'
  let ρ : TensorProduct R Rsh S →ₐ[Rsh] T :=
    Algebra.TensorProduct.lift (Algebra.ofId Rsh T) (IsScalarTower.toAlgHom R S T)
      fun _ _ => Commute.all _ _
  let _ : Algebra (TensorProduct R Rsh S) T := (ρ : TensorProduct R Rsh S →+* T).toAlgebra
  have towRshUT : IsScalarTower Rsh (TensorProduct R Rsh S) T :=
    .of_algebraMap_eq fun x => (ρ.commutes x).symm
  have towSUT : IsScalarTower S (TensorProduct R Rsh S) T := .of_algebraMap_eq fun x => by
    show algebraMap S T x = ρ (1 ⊗ₜ x)
    rw [Algebra.TensorProduct.lift_tmul]
    simp
  have towRUT : IsScalarTower R (TensorProduct R Rsh S) T :=
    .of_algebraMap_eq fun x => by
      rw [IsScalarTower.algebraMap_apply R S T,
        IsScalarTower.algebraMap_apply S (TensorProduct R Rsh S) T,
        ← IsScalarTower.algebraMap_apply R S (TensorProduct R Rsh S)]
  have hpo4 : Algebra.IsPushout S (TensorProduct R Rsh S) Sq T :=
    ((Algebra.IsPushout.comp_iff R S Rsh (TensorProduct R Rsh S)
      (T := Sq) (T' := T)).mp hpo2).symm
  -- `T` is a localization of `U`, hence `Ssh` is a localization of `U` at a prime
  have hlocU : IsLocalization
      (Algebra.algebraMapSubmonoid (TensorProduct R Rsh S) q.primeCompl) T :=
    (Algebra.isLocalization_iff_isPushout q.primeCompl Sq).mpr hpo4
  let _ : Algebra (TensorProduct R Rsh S) Ssh :=
    ((algebraMap T Ssh).comp (algebraMap (TensorProduct R Rsh S) T)).toAlgebra
  have towUTSsh : IsScalarTower (TensorProduct R Rsh S) T Ssh :=
    .of_algebraMap_eq' (RingHom.algebraMap_toAlgebra _)
  have towRshUSsh : IsScalarTower Rsh (TensorProduct R Rsh S) Ssh := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply Rsh T Ssh,
      IsScalarTower.algebraMap_apply Rsh (TensorProduct R Rsh S) T,
      ← IsScalarTower.algebraMap_apply (TensorProduct R Rsh S) T Ssh]
  set q' : Ideal (TensorProduct R Rsh S) :=
    (RingHom.ker π).comap (algebraMap (TensorProduct R Rsh S) T) with hq'
  have hq'prime : q'.IsPrime := Ideal.comap_isPrime _ _
  have hlocSsh : IsLocalization.AtPrime Ssh q' :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (Algebra.algebraMapSubmonoid (TensorProduct R Rsh S) q.primeCompl) Ssh (RingHom.ker π)
  -- the prime `q'` lies over the maximal ideal of `Rsh` and `U` is quasi-finite there
  have hkerRsh : (RingHom.ker π).comap (algebraMap Rsh T) = maximalIdeal Rsh := by
    ext x
    simp only [Ideal.mem_comap, RingHom.mem_ker, ← residue_eq_zero_iff x]
    rw [← RingHom.comp_apply, hπRsh, RingHom.comp_apply,
      map_eq_zero_iff _ (algebraMap (ResidueField Rsh) κ₂).injective]
  have hlies : q'.LiesOver (maximalIdeal Rsh) := ⟨by
    rw [Ideal.under_def, hq', Ideal.comap_comap,
      ← IsScalarTower.algebraMap_eq Rsh (TensorProduct R Rsh S) T, hkerRsh]⟩
  have hkerS : (RingHom.ker π).comap (algebraMap S T) = q := by
    ext x
    simp only [Ideal.mem_comap, RingHom.mem_ker]
    rw [IsScalarTower.algebraMap_apply S Sq T, ← RingHom.comp_apply, hπSq, RingHom.comp_apply,
      map_eq_zero_iff _ (algebraMap (ResidueField Sq) κ₂).injective, residue_eq_zero_iff]
    exact IsLocalization.AtPrime.to_map_mem_maximal_iff Sq q x
  have hkerq : q = q'.comap
      (Algebra.TensorProduct.includeRight.toRingHom : S →+* TensorProduct R Rsh S) := by
    rw [show (Algebra.TensorProduct.includeRight.toRingHom : S →+* TensorProduct R Rsh S)
        = algebraMap S (TensorProduct R Rsh S) from rfl, hq', Ideal.comap_comap,
      ← IsScalarTower.algebraMap_eq S (TensorProduct R Rsh S) T, hkerS]
  have hqf : Algebra.QuasiFiniteAt Rsh q' := Algebra.QuasiFiniteAt.baseChange q q' hkerq
  -- Lemma 04GH(3): `Ssh` is henselian and finite over `Rsh`
  obtain ⟨hhens, hfinRsh⟩ :=
    (HenselianLocalRing.henselianLocalRing_and_finite_of_finite_of_quasiFiniteAt Rsh).2.2.1
      (TensorProduct R Rsh S) (Algebra.FiniteType.baseChange Rsh) q' hqf Ssh
  -- `Ssh` is ind-étale over `Sq`: it is a localization of the cobase change `T`, which is
  -- ind-étale over `Sq` by Lemma 0BSH
  have hindSsh : (CommAlgCat.etale.{u} Sq).ind.{u} (CommAlgCat.of Sq Ssh) :=
    CommAlgCat.ind_etale_comp (CommAlgCat.ind_etale_of_isPushout Rp Sq Rsh T hind)
      (CommAlgCat.ind_etale_atPrime T Ssh (RingHom.ker π))
  -- comparison with an actual strict henselization of `Sq` gives the maximal ideal
  obtain ⟨Sqh, _, _, _, _, _, hSqhind, _, hSqhres⟩ := IsLocalRing.exists_henselization Sq
  obtain ⟨Sqsh, _, _, _, _, _, _, hh, -, hind', hmax', e', he'⟩ :=
    IsLocalRing.exists_strictHenselization Sq Sqh hSqhind hSqhres.2 κ₂
  let _ : Algebra Sq κ₂ := ((algebraMap (ResidueField Sq) κ₂).comp (residue Sq)).toAlgebra
  have halgSq : ∀ x : Sq, algebraMap Sq κ₂ x = algebraMap (ResidueField Sq) κ₂ (residue Sq x) :=
    fun x => rfl
  let pp : Ssh →ₐ[Sq] κ₂ :=
    { (e : ResidueField Ssh →+* κ₂).comp (residue Ssh) with
      commutes' := fun x => by
        show e (residue Ssh (algebraMap Sq Ssh x)) = algebraMap Sq κ₂ x
        rw [halgSq, ← IsLocalRing.ResidueField.algebraMap_residue]
        exact RingHom.congr_fun hcompat (residue Sq x) }
  let pp' : Sqsh →ₐ[Sq] κ₂ :=
    { (e'.symm : ResidueField Sqsh →+* κ₂).comp (residue Sqsh) with
      commutes' := fun x => by
        show e'.symm (residue Sqsh (algebraMap Sq Sqsh x)) = algebraMap Sq κ₂ x
        rw [halgSq, ← he' x, e'.symm_apply_apply] }
  have hppsurj : Function.Surjective pp := fun z => by
    obtain ⟨y, hy⟩ := residue_surjective (e.symm z)
    exact ⟨y, by change e (residue Ssh y) = z; rw [hy, e.apply_symm_apply]⟩
  have hpp'surj : Function.Surjective pp' := fun z => by
    obtain ⟨y, hy⟩ := residue_surjective (e' z)
    exact ⟨y, by change e'.symm (residue Sqsh y) = z; rw [hy, e'.symm_apply_apply]⟩
  obtain ⟨ee, -⟩ :=
    HenselianLocalRing.existsUnique_algEquiv_of_ind_etale hindSsh hind' pp pp' hppsurj hpp'surj
  have heesurj : Function.Surjective (ee : Ssh →+* Sqsh) := ee.surjective
  have heeloc : IsLocalHom (ee : Ssh →+* Sqsh) :=
    IsLocalHom.of_surjective (ee : Ssh →+* Sqsh) heesurj
  have hmapL : ((maximalIdeal Sq).map (algebraMap Sq Ssh)).map (ee : Ssh →+* Sqsh)
      = (maximalIdeal Sq).map (algebraMap Sq Sqsh) := by
    rw [Ideal.map_map,
      show (ee : Ssh →+* Sqsh).comp (algebraMap Sq Ssh) = algebraMap Sq Sqsh from
        RingHom.ext ee.commutes]
  refine ⟨hlocSq, hfinRsh, hlocRsh, hhens, hindSsh, ?_,
    isSepClosure_of_ringEquiv e hcompat, ⟨e, heq⟩, hfinκ, hpiκ⟩
  calc (maximalIdeal Sq).map (algebraMap Sq Ssh)
      = (((maximalIdeal Sq).map (algebraMap Sq Ssh)).map (ee : Ssh →+* Sqsh)).comap
          (ee : Ssh →+* Sqsh) := (Ideal.comap_map_of_bijective _ ee.bijective).symm
    _ = ((maximalIdeal Sq).map (algebraMap Sq Sqsh)).comap (ee : Ssh →+* Sqsh) := by rw [hmapL]
    _ = (maximalIdeal Sqsh).comap (ee : Ssh →+* Sqsh) := by rw [hmax']
    _ = maximalIdeal Ssh := maximalIdeal_comap _

open CategoryTheory IsLocalRing in
/-- **The strict henselization of `S_q` for a quasi-finite ring map** (Stacks 05WR). Let `R → S` be
of finite type, let `q` be a prime of `S` lying over `p` at which `R → S` is quasi-finite, and let
`Rp`, `Sq` be the localizations. Let `Rsh` be a strict henselization of `Rp`: henselian, ind-étale
over `Rp`, with maximal ideal generated by `𝔪_{R_p}` and residue field `κ₁` a separable algebraic
closure of `κ(p)`. Let `κ₂` be a separable algebraic closure of `κ(q)` containing `κ₁`, let `T` be
the base change `Rsh ⊗_{Rp} Sq` and let `π : T → κ₂` be the map induced by `Rsh → κ₁ → κ₂` and
`Sq → κ(q) → κ₂`. Let `Ssh` be the localization of `T` at the prime `ker π`. Then `Ssh` is finite
over `Rsh` by a local ring map, `Sq → Ssh` is a strict henselization of `Sq` whose residue field is
`κ₂`, and `κ₂/κ₁` is finite and purely inseparable. -/
@[stacks 05WR "Stated as the construction of `S_q^{sh}`: `Ssh` is the localization of the base
change `T` at the prime `ker π`, and the conclusion is that it is a strict henselization of `S_q` —
the items of Lemma 04GP, as in Lemmas 05WP and 05WS — with residue field `κ₂`, finite and local
over `R_p^{sh}`, and that `κ₂/κ₁` is finite purely inseparable. With the uniqueness of Lemma 08HT,
which the source's proof invokes here too, this is the source's identification of `S_q^{sh}` with
that localization; the top arrow of the source's square is `algebraMap Rsh Ssh`. `κ₁` is
`ResidueField Rsh`, and that its image in `κ₂` is the separable subfield of Lemma 030K is a
consequence, not a hypothesis. See the module docstring."]
theorem Algebra.IsPushout.strictHenselization_and_finite_of_quasiFiniteAt
    {R S Rp Sq Rsh T Ssh κ₂ : Type u}
    [CommRing R] [CommRing S] [CommRing Rp] [CommRing Sq] [CommRing Rsh] [CommRing T]
    [CommRing Ssh] [Field κ₂] [Algebra R S]
    (p : Ideal R) (q : Ideal S) [p.IsPrime] [q.IsPrime] [q.LiesOver p]
    [Algebra.FiniteType R S] [Algebra.QuasiFiniteAt R q]
    [Algebra R Rp] [IsLocalRing Rp] [IsLocalization.AtPrime Rp p]
    [Algebra S Sq] [IsLocalRing Sq] [IsLocalization.AtPrime Sq q]
    [Algebra R Sq] [Algebra Rp Sq] [IsScalarTower R S Sq] [IsScalarTower R Rp Sq]
    [Algebra Rp Rsh] [HenselianLocalRing Rsh] [IsLocalHom (algebraMap Rp Rsh)]
    [IsSepClosure (ResidueField Rp) (ResidueField Rsh)]
    (hind : (CommAlgCat.etale.{u} Rp).ind.{u} (CommAlgCat.of Rp Rsh))
    (hmax : (maximalIdeal Rp).map (algebraMap Rp Rsh) = maximalIdeal Rsh)
    [Algebra (ResidueField Sq) κ₂] [IsSepClosure (ResidueField Sq) κ₂]
    [Algebra (ResidueField Rsh) κ₂]
    [Algebra Rp T] [Algebra Rsh T] [Algebra Sq T]
    [IsScalarTower Rp Rsh T] [IsScalarTower Rp Sq T]
    (hT : Algebra.IsPushout Rp Sq Rsh T)
    (π : T →+* κ₂)
    (hπRsh : π.comp (algebraMap Rsh T) = (algebraMap (ResidueField Rsh) κ₂).comp (residue Rsh))
    (hπSq : π.comp (algebraMap Sq T) = (algebraMap (ResidueField Sq) κ₂).comp (residue Sq))
    [(RingHom.ker π).IsPrime]
    [Algebra T Ssh] [IsLocalRing Ssh] [IsLocalization.AtPrime Ssh (RingHom.ker π)]
    [Algebra Sq Ssh] [Algebra Rsh Ssh] [IsScalarTower Sq T Ssh] [IsScalarTower Rsh T Ssh] :
    ∃ _ : IsLocalHom (algebraMap Sq Ssh),
      Module.Finite Rsh Ssh ∧ IsLocalHom (algebraMap Rsh Ssh) ∧ HenselianLocalRing Ssh ∧
        (CommAlgCat.etale.{u} Sq).ind.{u} (CommAlgCat.of Sq Ssh) ∧
        (maximalIdeal Sq).map (algebraMap Sq Ssh) = maximalIdeal Ssh ∧
        IsSepClosure (ResidueField Sq) (ResidueField Ssh) ∧
        (∃ e : ResidueField Ssh ≃+* κ₂,
          (e : ResidueField Ssh →+* κ₂).comp ((residue Ssh).comp (algebraMap T Ssh)) = π) ∧
        Module.Finite (ResidueField Rsh) κ₂ ∧ IsPurelyInseparable (ResidueField Rsh) κ₂ :=
  strictHenselization_aux p q hind hmax hT π hπRsh hπSq

end
