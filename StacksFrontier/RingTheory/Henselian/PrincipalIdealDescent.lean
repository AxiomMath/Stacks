module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.Nakayama
public import StacksFrontier.RingTheory.Henselian.Henselization.Defs

/-!
# Descent of principal ideals along a henselization

Let `(A, m)` be a Noetherian local ring and let `Ash` be a henselization or a strict henselization
of `A`, that is, a local `A`-algebra with `IsLocalRing.IsHenselization A L Ash` for some extension
`L` of the residue field of `A`. Such an algebra is faithfully flat over `A`, and faithfully flat
algebras reflect equalities of ideals: the pushforward `Ideal.map (algebraMap A Ash)` is injective.
Principality of an ideal therefore descends: if `I` is an ideal of `A` whose extension to `Ash` is
the principal ideal generated by a nonzerodivisor `g`, then `I` is already principal, generated by
a nonzerodivisor of `A`.

The generator is found inside `I` itself. Every `a ∈ I` maps into `(g)`, say `algebraMap A Ash a =
c * g`, and the cofactor `c` is determined by `a` because `g` is a nonzerodivisor. Were every such
cofactor a nonunit — equivalently, a member of the maximal ideal of the local ring `Ash` — the
extension of `I` would be contained in `m_Ash * (g)`, so `(g) ⊆ m_Ash * (g)`, and Nakayama's lemma
applied to the finitely generated module `(g)` would force `g = 0`, contradicting that `g` is a
nonzerodivisor of a nontrivial ring. So some `f ∈ I` has a unit cofactor, whence
`(algebraMap A Ash f) = (g) = I * Ash`; injectivity of the pushforward turns this into `I = (f)`.
That `f` is a nonzerodivisor follows by transporting a relation `a * f = 0` to `Ash`, where
`algebraMap A Ash f` is a unit multiple of `g`, and using injectivity of `algebraMap A Ash`.

## Main results

* `exists_mem_nonZeroDivisors_span_singleton_eq_of_isHenselization`: an ideal of a Noetherian local
  ring whose extension to a henselization is generated by a nonzerodivisor is itself generated by a
  nonzerodivisor.

## Implementation notes

The argument uses only that `Ash` is a faithfully flat local `A`-algebra, which the henselization
hypothesis supplies through `IsLocalRing.IsHenselization.faithfullyFlat`; neither henselianness nor
the identification of the residue field of `Ash` with `L` is needed beyond that. For the same
reason the Noetherian hypothesis on `A` is not consumed: the generator is produced from `I`
directly rather than from a finite generating set, so the only finitely generated module Nakayama's
lemma is applied to is the principal ideal `(g)` of `Ash`. The hypothesis is retained because the
statement is used for Noetherian local rings, where principality of `I` is the intended reading.

Membership in `nonZeroDivisors` is a two-sided condition, so `mem_nonZeroDivisors_iff_right`
mediates between it and the one-sided cancellation statements that are actually used.

## References

* [Stacks Project, Tag 00DV](https://stacks.math.columbia.edu/tag/00DV), Nakayama's lemma
* [Stacks Project, Tag 07QM](https://stacks.math.columbia.edu/tag/07QM), faithful flatness of a
  henselization
-/

@[expose] public section

open IsLocalRing

universe u v

/-- In a local ring `Ash`, an ideal extended from `A` that becomes the principal ideal generated by
a nonzerodivisor `g` contains an element whose image is a unit multiple of `g`. -/
private theorem exists_isUnit_mul_eq_algebraMap_of_map_eq_span_singleton
    {A Ash : Type u} [CommRing A] [CommRing Ash] [IsLocalRing Ash] [Algebra A Ash]
    (I : Ideal A) {g : Ash} (hg : g ∈ nonZeroDivisors Ash)
    (hmap : I.map (algebraMap A Ash) = Ideal.span {g}) :
    ∃ f ∈ I, ∃ d : Ash, IsUnit d ∧ d * g = algebraMap A Ash f := by
  by_contra hcon
  push Not at hcon
  have hle : I.map (algebraMap A Ash) ≤ maximalIdeal Ash • Ideal.span ({g} : Set Ash) := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    obtain ⟨c, hc⟩ : ∃ c, c * g = algebraMap A Ash a :=
      Ideal.mem_span_singleton'.mp (by rw [← hmap]; exact Ideal.mem_map_of_mem _ ha)
    have hcm : c ∈ maximalIdeal Ash := by
      rw [mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => hcon a ha c hu hc
    have hmem : c * g ∈ maximalIdeal Ash • Ideal.span ({g} : Set Ash) := by
      rw [← smul_eq_mul]
      exact Submodule.smul_mem_smul hcm (Ideal.mem_span_singleton_self g)
    exact Ideal.mem_comap.mpr (hc ▸ hmem)
  have hbot : Ideal.span ({g} : Set Ash) = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _
      (Submodule.fg_span (Set.finite_singleton g)) (hmap.ge.trans hle)
      (maximalIdeal_le_jacobson ⊥)
  exact nonZeroDivisors.ne_zero hg (Ideal.span_singleton_eq_bot.mp hbot)

/-- **Principality of an ideal descends from a henselization.** Let `A` be a Noetherian local ring
and let `Ash` be a henselization or a strict henselization of `A` relative to an extension `L` of
its residue field. If an ideal `I` of `A` extends to the principal ideal of `Ash` generated by a
nonzerodivisor, then `I` is itself principal, generated by a nonzerodivisor of `A`. -/
theorem exists_mem_nonZeroDivisors_span_singleton_eq_of_isHenselization
    {A Ash : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [CommRing Ash] [IsLocalRing Ash] [Algebra A Ash]
    (L : Type v) [Field L] [Algebra (IsLocalRing.ResidueField A) L]
    [IsLocalRing.IsHenselization A L Ash]
    (I : Ideal A) {g : Ash} (hg : g ∈ nonZeroDivisors Ash)
    (hmap : I.map (algebraMap A Ash) = Ideal.span {g}) :
    ∃ f : A, f ∈ nonZeroDivisors A ∧ I = Ideal.span {f} := by
  have hff : Module.FaithfullyFlat A Ash := IsHenselization.faithfullyFlat (L := L)
  have hinj : Function.Injective (algebraMap A Ash) := FaithfulSMul.algebraMap_injective A Ash
  obtain ⟨f, -, d, hdu, hd⟩ :=
    exists_isUnit_mul_eq_algebraMap_of_map_eq_span_singleton I hg hmap
  refine ⟨f, mem_nonZeroDivisors_iff_right.mpr fun a ha => hinj ?_, ?_⟩
  · rw [map_zero]
    refine hdu.mul_left_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp hg _ ?_)
    rw [mul_assoc, hd, ← map_mul, ha, map_zero]
  · refine Ideal.map_injective_of_faithfullyFlat (B := Ash) ?_
    rw [hmap, Ideal.map_span, Set.image_singleton, ← hd,
      Ideal.span_singleton_mul_left_unit hdu]

end
