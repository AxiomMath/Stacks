@[expose] public section

/-!
# Characterisations of henselian local rings: root lifting and decompositions

This file continues the proof of Lemma 04GG begun in
`StacksFrontier.RingTheory.Henselian.TFAE.Conditions` (the statement and the plan of the proof are
in the module docstring of `StacksFrontier.RingTheory.Henselian.TFAE.Factorization`). It proves

* 1 ⇒ 2, root lifting for non-monic polynomials, by an elementary change of variables;
* 1 ⇒ 10 and 9 ⇒ 1, closing the cycle `1 → 10 → 9 → 1` through decompositions of finite algebras
  into products of local rings;
* 1 ⇒ 11, 11 ⇒ 12, 12 ⇒ 13, 11 ⇒ 13 and 13 ⇒ 1, through decompositions of finite type and
  quasi-finite algebras;
* 3 ⇒ 1, which leaves the factorisation block (3), (4), (5), (6);

and two steps towards 1 ⇒ 6: the reduction of item (6) to a monic `g₀` (`item6_of_monic`), and
the factorisation produced by a finite free factor of rank `deg g₀`.

## Main results

* `Stacks.Henselian.Characterizations.exists_factorization_of_free_algebra`: if `f̄ = g₀h₀` with
  `g₀` monic and a finite free `R`-algebra of rank `deg g₀` is generated by the powers of a root
  `y` of `f` annihilated by no polynomial whose reduction is prime to `g₀`, then `f = gh` with
  `ḡ = g₀`, `h̄ = h₀` and `deg g = deg g₀`.

## References

* [StacksProject 04GG](https://stacks.math.columbia.edu/tag/04GG)
-/

universe u

@[expose] public section

namespace Stacks.Henselian.Characterizations

open Polynomial IsLocalRing TensorProduct

variable (R : Type u) [CommRing R] [IsLocalRing R]
/-- 1 ⇒ 2. Root lifting for an arbitrary `f ∈ R[T]` follows from the monic case by an elementary
change of variables, so no étale algebra is needed here. Write `F = f(b + Y)` for a lift `b` of
`a₀` (Taylor expansion), so that `d₀ := F(0) ∈ 𝔪` and `d₁ := F'(0)` is a unit. Rescaling the
variable by `d₀` divides every coefficient of `F(d₀Y)` once by `d₀`, giving
`F(d₀ Y) = d₀ · P(Y)` with `P = 1 + Y · (F/Y)(d₀ Y)`; the point of the rescaling is that
`P̄ = 1 + d̄₁ Y`, all higher coefficients of `P` carrying a factor `d₀ ∈ 𝔪`. Reversing `P` in
formal degree `N = deg f` gives a *monic* `Q = reflect N P` with
`Q̄ = T^{N-1}(T + d̄₁)`, for which `-d̄₁ ≠ 0` is a simple root. Henselianness produces `s ∈ R`
with `Q(s) = 0` and `s̄ = -d̄₁ ≠ 0`, so `s` is a unit; then `P(s⁻¹) = 0`
(`Polynomial.eval₂_reflect_mul_pow`) and `a := b + d₀ s⁻¹` has `f(a) = d₀ P(s⁻¹) = 0` and
`ā = b̄ = a₀` because `d₀ ∈ 𝔪`. -/
private theorem item1_imp_item2 : Item1 R → Item2 R := by
  intro h1
  have key : ∀ (p : R[X]) (x : R), aeval (residue R x) p = residue R (p.eval x) := fun p x => by
    rw [aeval_eq_eval_map, eval_map_residue]
  intro f a₀ hf hf'
  obtain ⟨b, hb⟩ : ∃ b : R, residue R b = a₀ := Ideal.Quotient.mk_surjective a₀
  have hd₀ : residue R ((taylor b f).coeff 0) = 0 := by
    rw [taylor_coeff_zero, ← key, hb, hf]
  have hd₁ : residue R ((taylor b f).coeff 1) ≠ 0 := by
    rwa [taylor_coeff_one, ← key, hb]
  obtain ⟨M, hM⟩ : ∃ M, f.natDegree = M + 1 := by
    rcases Nat.eq_zero_or_pos f.natDegree with h | h
    · refine absurd ?_ hd₁
      have hdf : derivative f = 0 := by rw [Polynomial.eq_C_of_natDegree_eq_zero h]; simp
      rw [taylor_coeff_one, hdf]; simp
    · exact ⟨f.natDegree - 1, by omega⟩
  set F := taylor b f with hFdef
  set d₀ := F.coeff 0 with hd₀def
  set P : R[X] := 1 + X * ((divX F).comp (C d₀ * X)) with hPdef
  have hFdeg : F.natDegree = M + 1 := by rw [hFdef, natDegree_taylor, hM]
  have hP0 : P.coeff 0 = 1 := by simp [hPdef, Polynomial.mul_coeff_zero]
  have hPdeg : P.natDegree ≤ M + 1 := by
    refine (Polynomial.natDegree_add_le _ _).trans (max_le (by simp) ?_)
    refine (Polynomial.natDegree_mul_le).trans ?_
    have hdX : (divX F).natDegree ≤ M := by
      rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one, hFdeg]
      omega
    have h2 : ((divX F).comp (C d₀ * X)).natDegree ≤ M :=
      Polynomial.natDegree_comp_le.trans (by
        calc (divX F).natDegree * (C d₀ * X).natDegree ≤ M * 1 :=
              Nat.mul_le_mul hdX (Polynomial.natDegree_mul_le.trans (by simp))
          _ = M := by ring)
    simp only [natDegree_X]
    omega
  have hPmap : P.map (residue R) = 1 + C (residue R (F.coeff 1)) * X := by
    have hcomp : ((divX F).map (residue R)).comp (C (residue R d₀) * X)
        = C (((divX F).map (residue R)).coeff 0) := by
      rw [hd₀def, hd₀, map_zero, zero_mul, Polynomial.comp_zero,
        ← Polynomial.coeff_zero_eq_eval_zero]
    rw [hPdef]
    simp only [Polynomial.map_add, Polynomial.map_one, Polynomial.map_mul, Polynomial.map_X,
      Polynomial.map_comp, Polynomial.map_C, hcomp, Polynomial.coeff_map, Polynomial.coeff_divX]
    ring
  set c := residue R (F.coeff 1)
  have hc0 : c ≠ 0 := hd₁
  set Q := P.reflect (M + 1) with hQdef
  have hQdeg : Q.natDegree ≤ M + 1 := Polynomial.natDegree_reflect_le.trans (by omega)
  have hQmonic : Q.Monic := by
    refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one (M + 1) hQdeg ?_
    rw [hQdef, Polynomial.coeff_reflect, Polynomial.revAt_le (le_refl (M + 1))]
    simpa using hP0
  have hQmap : Q.map (residue R) = X ^ M * (X + C c) := by
    have h0 : Q.map (residue R) = (P.map (residue R)).reflect (M + 1) := by
      rw [hQdef]; simp [Polynomial.reflect_map]
    rw [h0, hPmap, Polynomial.reflect_add, Polynomial.reflect_one,
      show (C c * X : (ResidueField R)[X]) = C c * X ^ 1 by ring,
      Polynomial.reflect_C_mul_X_pow, Polynomial.revAt_le (by omega : 1 ≤ M + 1)]
    simp only [Nat.add_sub_cancel]
    ring
  have hroot1 : aeval (-c) Q = 0 := by rw [aeval_eq_eval_map, hQmap]; simp
  have hroot2 : aeval (-c) (derivative Q) ≠ 0 := by
    rw [aeval_eq_eval_map, ← Polynomial.derivative_map, hQmap, Polynomial.derivative_mul]
    simp only [Polynomial.derivative_add, Polynomial.derivative_X, Polynomial.derivative_C,
      add_zero, mul_one, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C, neg_add_cancel, mul_zero, zero_add]
    exact pow_ne_zero M (neg_ne_zero.mpr hc0)
  have hmonic : ∀ g : R[X], g.Monic → ∀ x : ResidueField R, aeval x g = 0 →
      aeval x (derivative g) ≠ 0 → ∃ a : R, g.IsRoot a ∧ residue R a = x :=
    ((HenselianLocalRing.TFAE R).out 1 2).mp h1
  obtain ⟨s, hsroot, hsres⟩ := hmonic Q hQmonic (-c) hroot1 hroot2
  have hsunit : IsUnit s :=
    (IsLocalRing.residue_ne_zero_iff_isUnit s).mp (by rw [hsres]; exact neg_ne_zero.mpr hc0)
  obtain ⟨t, hst⟩ : ∃ t : R, s * t = 1 :=
    ⟨↑hsunit.unit⁻¹, by simp⟩
  let _ : Invertible t := ⟨s, hst, by rw [mul_comm]; exact hst⟩
  have hPeval : P.eval t = 0 := by
    have h := Polynomial.eval₂_reflect_mul_pow (RingHom.id R) t (M + 1) P hPdeg
    simp only [Polynomial.eval₂_eq_eval_map, Polynomial.map_id] at h
    rw [← h, show (⅟t : R) = s from rfl, ← hQdef, hsroot.eq_zero, zero_mul]
  refine ⟨d₀ * t + b, ?_, ?_⟩
  · have hFsplit : F.eval (d₀ * t) = d₀ * P.eval t := by
      have h1 : X * divX F + C d₀ = F := by rw [hd₀def]; exact Polynomial.X_mul_divX_add F
      conv_lhs => rw [← h1]
      rw [hPdef]
      simp only [Polynomial.eval_add, Polynomial.eval_one, Polynomial.eval_mul,
        Polynomial.eval_X, Polynomial.eval_comp, Polynomial.eval_C]
      ring
    rw [Polynomial.IsRoot.def, ← Polynomial.taylor_eval b f, ← hFdef, hFsplit, hPeval, mul_zero]
  · rw [map_add, map_mul, hd₀, hb, zero_mul, zero_add]

omit [IsLocalRing R] in
/-- 1 ⇒ 10. A module-finite algebra over a henselian local ring is a finite product of local
algebras, each finite over `R`: reduce modulo `𝔪`, where the fibre is Artinian and so carries a
complete family of orthogonal idempotents with local corners, and lift that family through the
henselian property. This is `exists_algEquiv_pi_isLocalRing`, the shape (10) takes for the
index type `Fin n`; the item's `ι : Type u` is `ULift (Fin n)`. -/
@[ega "IV 18.5.9" "(ii), necessity", sga "4 VIII 4.1" "(i), forward direction"]
private theorem item1_imp_item10 : Item1 R → Item10 R := by
  intro h1 S _ _ hfin
  have := h1
  have := hfin
  obtain ⟨n, A, hcA, haA, hlA, hfA, ⟨e⟩⟩ := exists_algEquiv_pi_isLocalRing.{u, u} R S
  let _ := hcA
  let _ := haA
  refine ⟨ULift.{u} (Fin n), inferInstance, fun i => A i.down, fun i => hcA i.down,
    fun i => hlA i.down, ⟨e.toRingEquiv.trans ?_⟩⟩
  exact
    { toFun := fun x i => x i.down
      invFun := fun y i => y (ULift.up i)
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }

/-- If `f̄ = (X - ā)h̄` and `b` lifts `ā`, all coefficients of `f - (X - b)h` lie in `𝔪`. -/
private theorem coeff_sub_mem_maximalIdeal (f h : R[X]) (b : R) (a₀ : ResidueField R)
    (hb : residue R b = a₀) (hfac : f.map (residue R) = (X - C a₀) * h.map (residue R)) :
    ∀ n, (f - (X - C b) * h).coeff n ∈ maximalIdeal R := by
  refine coeff_mem_maximalIdeal_of_map_eq_zero R ?_
  rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
    Polynomial.map_C, hb, ← hfac, sub_self]

/-- A root `a₀` of `f` in the residue field gives an `R`-algebra map `R[X]/(f) → κ`
sending the class of `q` to `q(a₀)`. -/
private theorem exists_algHom_adjoinRoot_residue (f : R[X]) (a₀ : ResidueField R)
    (h₁ : aeval a₀ f = 0) :
    ∃ θ : AdjoinRoot f →ₐ[R] ResidueField R, ∀ q : R[X], θ (AdjoinRoot.mk f q) = aeval a₀ q :=
  ⟨AdjoinRoot.liftAlgHom f (Algebra.ofId R (ResidueField R)) a₀ h₁, fun _ => rfl⟩

/-- 9 ⇒ 1. For `f` monic with a simple root `a₀` of `f̄`, write `S = R[T]/(f)` as a product of
local rings. Reducing modulo `𝔪` decomposes the finite `κ`-algebra `κ[T]/(f̄)` as a product of
nonzero local rings, so there are finitely many factors, and one of them is
`κ[T]/(T - a₀)`. The corresponding factor `A` of `S` is a summand of the finite free module `S`,
hence finite free, and of rank `1` because `A/𝔪A` is one-dimensional; so `R → A` is an
isomorphism and the image of `T` in `R` is the desired root. The last step is
`Algebra.finrank_eq_one_iff_bijective_algebraMap`. -/
@[ega "IV 18.5.9" "(ii), sufficiency", sga "4 VIII 4.1" "(i)"]
private theorem item9_imp_item1 : Item9 R → Item1 R := by
  intro H
  refine ((HenselianLocalRing.TFAE R).out 2 1).mp ?_
  intro f hfm a₀ h₁ h₂
  classical
  obtain ⟨h, hfac, -, hha₀⟩ := exists_lift_divByMonic R f a₀ h₁ h₂
  obtain ⟨b, hb⟩ : ∃ b : R, residue R b = a₀ := Ideal.Quotient.mk_surjective a₀
  have hmcoeff := coeff_sub_mem_maximalIdeal R f h b a₀ hb hfac
  have hSfin : Module.Finite R (AdjoinRoot f) :=
    Module.Finite.of_basis (AdjoinRoot.powerBasis' hfm).basis
  have hSfree : Module.Free R (AdjoinRoot f) :=
    Module.Free.of_basis (AdjoinRoot.powerBasis' hfm).basis
  -- (9) decomposes `R[X]/(f)` into local factors, of which there are finitely many
  obtain ⟨ι, A, hcA, hlA, ⟨e⟩⟩ := H (AdjoinRoot f) hSfin
  let _ := hcA
  let _ := hlA
  have hιfin : Finite ι := finite_of_ringEquiv_pi_local R (AdjoinRoot f) A e
  let _ : DecidableEq ι := Classical.decEq ι
  -- the `κ`-point of `R[X]/(f)` at `a₀`
  obtain ⟨θ, hθ⟩ := exists_algHom_adjoinRoot_residue R f a₀ h₁
  set ε : ι → AdjoinRoot f := fun i => e.symm (Pi.single i 1) with hεdef
  have hεidem : ∀ i, ε i * ε i = ε i := by
    intro i
    have h0 : (Pi.single i (1 : A i)) * (Pi.single i (1 : A i)) = Pi.single i 1 := by
      funext k
      rcases eq_or_ne k i with rfl | hk
      · simp
      · simp [Pi.single_eq_of_ne hk]
    rw [hεdef]
    simp only [← map_mul, h0]
  -- one of the factors carries the point
  obtain ⟨j, hj⟩ : ∃ j : ι, θ (ε j) = 1 := by
    cases nonempty_fintype ι
    have hsum : ∑ i, ε i = 1 := by
      have h1 : ∑ i, (Pi.single i (1 : A i) : ∀ i, A i) = 1 := by
        rw [Finset.univ_sum_single]; rfl
      rw [← map_one e.symm, ← h1, map_sum]
    by_contra hcon
    have hzero : ∀ i, θ (ε i) = 0 := by
      intro i
      have hidem : θ (ε i) * θ (ε i) = θ (ε i) := by rw [← map_mul, hεidem]
      have hfac2 : θ (ε i) * (θ (ε i) - 1) = 0 := by linear_combination hidem
      rcases mul_eq_zero.mp hfac2 with hh | hh
      · exact hh
      · exact absurd ⟨i, sub_eq_zero.mp hh⟩ hcon
    have hone : (1 : ResidueField R) = 0 := by
      rw [← map_one θ, ← hsum, map_sum]
      exact Finset.sum_eq_zero (fun i _ => hzero i)
    exact one_ne_zero hone
  -- the factor at the point is `A' = S/(1 - ε j)`: local, finite and free over `R`
  set π : AdjoinRoot f →+* A j := (Pi.evalRingHom A j).comp (e : AdjoinRoot f →+* ∀ i, A i)
    with hπ
  have hπsurj : Function.Surjective π := fun z => ⟨e.symm (Pi.single j z), by simp [hπ]⟩
  have hπε : π (ε j) = 1 := by simp [hπ, hεdef]
  have hker : RingHom.ker π = Ideal.span {1 - ε j} := by
    apply le_antisymm
    · intro x hx
      refine Ideal.mem_span_singleton'.mpr ⟨x, ?_⟩
      have hεx : ε j * x = 0 := by
        have h0 : e (ε j * x) = 0 := by
          rw [map_mul, hεdef]
          simp only [RingEquiv.apply_symm_apply]
          funext k
          rcases eq_or_ne k j with rfl | hk
          · simpa [hπ] using (RingHom.mem_ker.mp hx)
          · simp [Pi.single_eq_of_ne hk]
        simpa using congrArg e.symm h0
      linear_combination -hεx
    · rw [Ideal.span_le]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      subst hz
      simp [RingHom.mem_ker, hπε]
  set I : Ideal (AdjoinRoot f) := Ideal.span {1 - ε j} with hI
  have hmul0 : (1 - ε j) * ε j = 0 := by linear_combination -(hεidem j)
  have hAfin : Module.Finite R (AdjoinRoot f ⧸ I) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ R I).toLinearMap Ideal.Quotient.mk_surjective
  have hAproj : Module.Projective R (AdjoinRoot f ⧸ I) :=
    projective_of_algEquiv_prod R
      (nonempty_algEquiv_quotient_prod R (1 - ε j) (ε j) 1 1 hmul0 (by ring)).some
  have hAfree : Module.Free R (AdjoinRoot f ⧸ I) := Module.free_of_flat_of_isLocalRing
  have hAloc : IsLocalRing (AdjoinRoot f ⧸ I) := by
    have eq1 : (AdjoinRoot f ⧸ I) ≃+* A j :=
      (Ideal.quotEquivOfEq (hI.trans hker.symm)).trans
        (RingHom.quotientKerEquivOfSurjective hπsurj)
    have hnt : Nontrivial (AdjoinRoot f ⧸ I) := eq1.toEquiv.nontrivial
    exact IsLocalRing.of_surjective' eq1.symm.toRingHom eq1.symm.surjective
  -- the point factors through that factor
  have hθI : ∀ z ∈ I, θ z = 0 := by
    intro z hz
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    rw [map_mul, map_sub, map_one, hj, sub_self, mul_zero]
  set θA : (AdjoinRoot f ⧸ I) →ₐ[R] ResidueField R := Ideal.Quotient.liftₐ I θ hθI with hθAdef
  have hθAmk : ∀ z : AdjoinRoot f, θA (Ideal.Quotient.mk I z) = θ z := fun _ => rfl
  have hθAsurj : Function.Surjective θA := by
    intro w
    obtain ⟨r, hr⟩ : ∃ r : R, residue R r = w := Ideal.Quotient.mk_surjective w
    refine ⟨algebraMap R _ r, ?_⟩
    rw [θA.commutes, IsLocalRing.ResidueField.algebraMap_eq]
    exact hr
  -- the image of `X`
  set y : AdjoinRoot f ⧸ I := Ideal.Quotient.mk I (AdjoinRoot.root f) with hy
  have haeval : ∀ q : R[X], aeval y q = Ideal.Quotient.mk I (AdjoinRoot.mk f q) := fun q => by
    have h1 : (Ideal.Quotient.mkₐ R I) (AdjoinRoot.root f) = y := rfl
    rw [← h1, Polynomial.aeval_algHom_apply, AdjoinRoot.aeval_eq, Ideal.Quotient.mkₐ_eq_mk]
  have hgen : Function.Surjective (aeval y : R[X] →ₐ[R] (AdjoinRoot f ⧸ I)) := by
    intro z
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective w
    exact ⟨q, haeval q⟩
  have hfy : aeval y f = 0 := by rw [haeval, AdjoinRoot.mk_self, map_zero]
  -- `h(y)` is a unit: the factor is local and the residue of `h(y)` is `h̄(a₀) ≠ 0`
  have hθAy : θA y = a₀ := by
    rw [hy, hθAmk, ← AdjoinRoot.mk_X, hθ, aeval_X]
  have hunit : IsUnit (aeval y h) := by
    have hval : θA (aeval y h) = aeval a₀ h := by
      rw [← Polynomial.aeval_algHom_apply θA y h, hθAy]
    have hne : θA (aeval y h) ≠ 0 := by
      rw [hval, aeval_eq_eval_map, hha₀]
      exact h₂
    have hmax : RingHom.ker (θA : (AdjoinRoot f ⧸ I) →+* ResidueField R)
        = maximalIdeal (AdjoinRoot f ⧸ I) :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ hθAsurj)
    rw [← notMem_maximalIdeal, ← hmax]
    intro hmem
    exact hne (RingHom.mem_ker.mp hmem)
  -- and `y ≡ b` modulo `𝔪 A'`, so `A' ≅ R` and the preimage of `y` is the root
  have hyb : y - algebraMap R (AdjoinRoot f ⧸ I) b ∈
      Ideal.map (algebraMap R (AdjoinRoot f ⧸ I)) (maximalIdeal R) :=
    sub_mem_of_isUnit_aeval R f h b y hmcoeff hfy hunit
  obtain ⟨a, haf, hares⟩ := exists_isRoot_of_sub_mem R (AdjoinRoot f ⧸ I) f b y
    (exists_sub_mem_map_maximalIdeal R y hgen b hyb) hfy hyb
  exact ⟨a, haf, by rw [hares, hb]⟩

/-- 1 ⇒ 11. A finite type algebra over a henselian local ring splits as
`A₁ × ⋯ × Aₙ × B` with each `Aᵢ` local and finite over `R` and `B` quasi-finite over `R` at no
prime over `𝔪`: the quasi-finite locus over `𝔪` is finite, and henselianness produces an
idempotent isolating it. This is `exists_algEquiv_prod_of_henselianLocalRing`, whose finite part `∀
  i, A i` is the `A` of (11). -/
private theorem item1_imp_item11 : Item1 R → Item11 R := by
  intro h1 S _ _ hFT
  have := h1
  have := hFT
  obtain ⟨n, A, hcA, haA, hlA, hfA, B, hcB, haB, hqB, ⟨e⟩⟩ :=
    exists_algEquiv_prod_of_henselianLocalRing R S
  let _ := hcA
  let _ := haA
  let _ := hfA
  refine ⟨∀ i, A i, B, inferInstance, hcB, inferInstance, haB, e, inferInstance, ?_⟩
  intro q _ hlo
  exact hqB q hlo

/-- 11 ⇒ 12: by the definition of being quasi-finite at a prime. A minimal prime `p` of
`κ ⊗_R B` is a prime of `B` over `𝔪`, at which `R → B` is not quasi-finite, so `p` is not
isolated in the fibre and the component it cuts out has dimension at least one. -/
private theorem item11_imp_item12 : Item11 R → Item12 R := by
  intro H S _ _ hFT
  obtain ⟨A, B, hcA, hcB, haA, haB, e, hAfin, hB⟩ := H S hFT
  refine ⟨A, B, hcA, hcB, haA, haB, e, hAfin, ?_⟩
  intro p hp
  by_contra hcon
  have hBFT : Algebra.FiniteType R B :=
    Algebra.FiniteType.of_surjective ((AlgHom.snd R A B).comp (e : S →ₐ[R] A × B))
      (Prod.snd_surjective.comp e.surjective)
  have hpp : p.IsPrime := hp.isPrime
  -- the component cut out by `p` has dimension zero, so `p` is maximal as well as minimal
  have hKD : Ring.KrullDimLE 0 ((ResidueField R ⊗[R] B) ⧸ p) :=
    Ring.krullDimLE_iff.mpr (Order.le_of_lt_succ (not_le.mp hcon))
  have hpmax : p.IsMaximal := by
    have hdom : IsDomain ((ResidueField R ⊗[R] B) ⧸ p) := Ideal.Quotient.isDomain p
    have hbot : (⊥ : Ideal ((ResidueField R ⊗[R] B) ⧸ p)).IsMaximal :=
      Ring.krullDimLE_zero_iff.mp hKD ⊥ inferInstance
    have hcm := Ideal.comap_isMaximal_of_surjective (K := (⊥ : Ideal _))
      (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
    rwa [← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at hcm
  -- the bridge `κ ≃ₐ[R] κ(𝔪)`, and the resulting identification of the two fibres
  have hsurjres : Function.Surjective (algebraMap R (maximalIdeal R).ResidueField) :=
    Ideal.algebraMap_residueField_surjective _
  have hkerres : RingHom.ker (algebraMap R (maximalIdeal R).ResidueField) = maximalIdeal R := by
    ext x
    simp
  let β : ResidueField R ≃ₐ[R] (maximalIdeal R).ResidueField :=
    AlgEquiv.ofRingEquiv (f := (Ideal.quotEquivOfEq hkerres.symm).trans
      (RingHom.quotientKerEquivOfSurjective hsurjres)) (fun _ => rfl)
  let Φ : (ResidueField R ⊗[R] B) ≃ₐ[R] (maximalIdeal R).Fiber B :=
    Algebra.TensorProduct.congr β AlgEquiv.refl
  let ee := PrimeSpectrum.comapEquiv (Φ.toRingEquiv)
  set P : PrimeSpectrum (ResidueField R ⊗[R] B) := ⟨p, hpp⟩ with hP
  set Q : PrimeSpectrum ((maximalIdeal R).Fiber B) := ee P with hQ
  have hminP : IsMin P := PrimeSpectrum.isMin_iff.mpr hp
  have hmaxP : IsMax P := PrimeSpectrum.isMax_iff.mpr hpmax
  have hminQ : IsMin Q := ee.isMin_apply.mpr hminP
  have hmaxQ : IsMax Q := ee.isMax_apply.mpr hmaxP
  -- `{Q}` is therefore open in the spectrum of the fibre, which is noetherian and jacobson
  have hnoeth : IsNoetherianRing ((maximalIdeal R).Fiber B) :=
    Algebra.FiniteType.isNoetherianRing (maximalIdeal R).ResidueField _
  have hjac : IsJacobsonRing ((maximalIdeal R).Fiber B) :=
    isJacobsonRing_of_finiteType (A := (maximalIdeal R).ResidueField)
  have hopen : IsOpen ({Q} : Set (PrimeSpectrum ((maximalIdeal R).Fiber B))) := by
    have htfae := (PrimeSpectrum.isOpen_singleton_tfae_of_isNoetherian_of_isJacobsonRing Q).out 3 1
    refine htfae.mp ⟨(PrimeSpectrum.isClosed_singleton_iff_isMaximal Q).mpr
      (PrimeSpectrum.isMax_iff.mp hmaxQ), ?_⟩
    intro x y hyx hx
    rw [Set.mem_singleton_iff] at hx ⊢
    subst hx
    have hle : y ≤ Q := (PrimeSpectrum.le_iff_specializes y Q).mpr hyx
    exact le_antisymm hle (hminQ hle)
  -- so `R → B` is quasi-finite at the prime `q` of `B` under `Q`, contradicting (11)
  have hqfQ : Algebra.QuasiFiniteAt ((maximalIdeal R).ResidueField) Q.asIdeal :=
    Algebra.QuasiFiniteAt.of_isOpen_singleton Q hopen
  set q : Ideal B := Ideal.comap (Algebra.TensorProduct.includeRight.toRingHom) Q.asIdeal with hq
  have hqp : q.IsPrime := Ideal.IsPrime.comap _
  have hlo : q.LiesOver (maximalIdeal R) := by
    refine ⟨?_⟩
    have h3 : (Algebra.TensorProduct.includeRight.toRingHom :
          B →+* (maximalIdeal R).Fiber B).comp (algebraMap R B)
        = algebraMap R ((maximalIdeal R).Fiber B) := by
      ext r
      simp
    have h2 : Ideal.under R q = Ideal.under R Q.asIdeal := by
      rw [hq, Ideal.under_def, Ideal.under_def, Ideal.comap_comap, h3]
    rw [h2]
    exact (inferInstance : Q.asIdeal.LiesOver (maximalIdeal R)).over
  exact hB q hlo
    (Algebra.QuasiFiniteAt.of_quasiFiniteAt_residueField (maximalIdeal R) q Q.asIdeal rfl)

/-- A quotient of a quasi-finite algebra `A × B` is quasi-finite: so is the factor `B`. -/
private theorem quasiFinite_snd_of_algEquiv {R' S A B : Type*} [CommRing R'] [CommRing S]
    [CommRing A] [CommRing B] [Algebra R' S] [Algebra R' A] [Algebra R' B]
    [Algebra.QuasiFinite R' S] (e : S ≃ₐ[R'] A × B) : Algebra.QuasiFinite R' B :=
  Algebra.QuasiFinite.of_surjective_algHom ((AlgHom.snd R' A B).comp (e : S →ₐ[R'] A × B))
    (Prod.snd_surjective.comp e.surjective)

/-- 12 ⇒ 13. The source closes the pair (11), (12) by reading the definition of quasi-finiteness
at a prime in both directions; the return edge is cheaper through (13). If `S` is quasi-finite
over `R` then so is the factor `B` of the decomposition given by (12), so the fibre
`F = κ ⊗_R B` is a finite `κ`-algebra, hence artinian. Were `F` nonzero it would have a minimal
prime `p`, necessarily maximal since `F` has Krull dimension zero, and then
`ringKrullDim (F/p) = 0`, contradicting the hypothesis `1 ≤ ringKrullDim (F/p)` of (12). So
`F = 0`. -/
private theorem item12_imp_item13 : Item12 R → Item13 R := by
  intro H S _ _ hFT hQF
  obtain ⟨A, B, hcA, hcB, haA, haB, e, hA, hB⟩ := H S hFT
  refine ⟨A, B, hcA, hcB, haA, haB, e, hA, ?_⟩
  have hQB := quasiFinite_snd_of_algEquiv e
  have hQfib : Algebra.QuasiFinite (ResidueField R) (ResidueField R ⊗[R] B) :=
    Algebra.QuasiFinite.baseChange
  have hfin : Module.Finite (ResidueField R) (ResidueField R ⊗[R] B) :=
    Algebra.QuasiFinite.iff_of_isArtinianRing.mp hQfib
  have hart : IsArtinianRing (ResidueField R ⊗[R] B) :=
    IsArtinianRing.of_finite (ResidueField R) _
  rw [← not_nontrivial_iff_subsingleton]
  intro hnt
  obtain ⟨p, hp⟩ := Ideal.nonempty_minimalPrimes
    (show (⊥ : Ideal (ResidueField R ⊗[R] B)) ≠ ⊤ from bot_ne_top)
  have hmax : p.IsMaximal := Ring.krullDimLE_zero_iff.mp inferInstance p hp.isPrime
  have h0 : ringKrullDim ((ResidueField R ⊗[R] B) ⧸ p) = 0 :=
    ringKrullDim_eq_zero_of_isField ((Ideal.Quotient.maximal_ideal_iff_isField_quotient p).mp hmax)
  have h1 := hB p hp
  rw [h0] at h1
  norm_num at h1

/-- 11 ⇒ 13: by the definition of being quasi-finite. If `S` is quasi-finite over `R` then so is
the factor `B`, so `R → B` is quasi-finite at every prime of `B`; by (11) it is quasi-finite at no
prime over `𝔪`, so `B` has no prime over `𝔪` and therefore `κ ⊗_R B = 0`. -/
private theorem item11_imp_item13 : Item11 R → Item13 R := by
  intro H S _ _ hFT hQF
  obtain ⟨A, B, hcA, hcB, haA, haB, e, hA, hB⟩ := H S hFT
  refine ⟨A, B, hcA, hcB, haA, haB, e, hA, ?_⟩
  have hQB := quasiFinite_snd_of_algEquiv e
  have key : (maximalIdeal R).map (algebraMap R B) = ⊤ := by
    by_contra hne
    obtain ⟨q, hq, hle⟩ := Ideal.exists_le_maximal _ hne
    have hqp : q.IsPrime := hq.isPrime
    have hcp : (q.comap (algebraMap R B)).IsPrime := Ideal.IsPrime.comap _
    have hlo : q.LiesOver (maximalIdeal R) :=
      ⟨le_antisymm (Ideal.map_le_iff_le_comap.mp hle) (le_maximalIdeal hcp.ne_top)⟩
    exact hB q hlo inferInstance
  have hsub : Subsingleton (B ⧸ (maximalIdeal R).map (algebraMap R B)) :=
    Ideal.Quotient.subsingleton_iff.mpr key
  exact (Algebra.TensorProduct.quotIdealMapEquivQuotTensor (A := R) (B := B)
    (I := maximalIdeal R)).surjective.subsingleton

/-- 13 ⇒ 1. For `f` monic with a simple root `a₀` of `f̄` pick `g ∈ R[T]` with
`ḡ = f̄/(T - a₀)`; then `S = (R[T]/(f))_g` is quasi-finite over `R` with `κ ⊗_R S ≅ κ`. Writing
`S = A × B` as in (13) gives `κ ≅ A/𝔪A`, and `A`, a summand of the flat algebra `S`, is finite
flat hence free of rank `1`; so `R → A` is an isomorphism by
`Algebra.finrank_eq_one_iff_bijective_algebraMap` and the image of `T` is the root. -/
private theorem item13_imp_item1 : Item13 R → Item1 R := by
  intro H
  refine ((HenselianLocalRing.TFAE R).out 2 1).mp ?_
  intro f hfm a₀ h₁ h₂
  classical
  obtain ⟨h, hfac, -, hha₀⟩ := exists_lift_divByMonic R f a₀ h₁ h₂
  obtain ⟨b, hb⟩ : ∃ b : R, residue R b = a₀ := Ideal.Quotient.mk_surjective a₀
  -- `h(b)` is a unit of `R`, its reduction being `f̄'(a₀) ≠ 0`
  have hab : residue R (h.eval b) = aeval a₀ (derivative f) := by
    rw [← eval_map_residue, hb, hha₀]
  have hcunit : IsUnit (h.eval b) :=
    (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [hab]; exact h₂)
  -- the coefficients of `f - (X - b) h` lie in `𝔪`
  have hmcoeff := coeff_sub_mem_maximalIdeal R f h b a₀ hb hfac
  -- the quasi-finite flat algebra `S = (R[X]/(f))_h`
  have hS₁fin : Module.Finite R (AdjoinRoot f) :=
    Module.Finite.of_basis (AdjoinRoot.powerBasis' hfm).basis
  have hS₁free : Module.Free R (AdjoinRoot f) :=
    Module.Free.of_basis (AdjoinRoot.powerBasis' hfm).basis
  have hFT : Algebra.FiniteType R (Localization.Away (AdjoinRoot.mk f h)) :=
    Algebra.FiniteType.trans (S := AdjoinRoot f) inferInstance inferInstance
  have hQF : Algebra.QuasiFinite R (Localization.Away (AdjoinRoot.mk f h)) :=
    Algebra.QuasiFinite.of_isLocalization (Submonoid.powers (AdjoinRoot.mk f h))
      (S := AdjoinRoot f)
  have hSflat : Module.Flat R (Localization.Away (AdjoinRoot.mk f h)) :=
    Module.Flat.trans R (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
  obtain ⟨A, B, hcA, hcB, haA, haB, e, hAfin, hBsub⟩ :=
    H (Localization.Away (AdjoinRoot.mk f h)) hFT hQF
  -- the projection onto the finite factor, which is finite flat hence free
  set p : Localization.Away (AdjoinRoot.mk f h) →ₐ[R] A :=
    (AlgHom.fst R A B).comp (e : Localization.Away (AdjoinRoot.mk f h) →ₐ[R] A × B) with hp
  have hpsurj : Function.Surjective p := Prod.fst_surjective.comp e.surjective
  have hAflat : Module.Flat R A := flat_of_algEquiv_prod R e
  have hAfree : Module.Free R A := Module.free_of_flat_of_isLocalRing
  -- the `κ`-point of `S` at `a₀`
  obtain ⟨θ₀, hθ₀⟩ := exists_algHom_adjoinRoot_residue R f a₀ h₁
  have hθγ : IsUnit (θ₀ (AdjoinRoot.mk f h)) := by
    rw [hθ₀]
    refine isUnit_iff_ne_zero.mpr ?_
    rw [aeval_eq_eval_map, hha₀]
    exact h₂
  set θ : Localization.Away (AdjoinRoot.mk f h) →ₐ[R] ResidueField R :=
    IsLocalization.Away.liftAlgHom (AdjoinRoot.mk f h) (f := θ₀) hθγ with hθ
  -- `A` is not the zero ring: were it, the `κ`-point would factor through `B`, which has no
  -- point over `𝔪`
  have hBsub' : Subsingleton ((R ⧸ maximalIdeal R) ⊗[R] B) := hBsub
  have hBtop : Ideal.map (algebraMap R B) (maximalIdeal R) = ⊤ :=
    Ideal.Quotient.subsingleton_iff.mp
      ((Algebra.TensorProduct.quotIdealMapEquivQuotTensor (A := R) (B := B)
        (I := maximalIdeal R)).symm.surjective.subsingleton)
  have hAnt : Nontrivial A := by
    refine ⟨⟨1, 0, ?_⟩⟩
    intro h10
    set ψ := θ.comp (e.symm : A × B →ₐ[R] Localization.Away (AdjoinRoot.mk f h)) with hψ
    have h0 : ψ ((1 : A), (0 : B)) = 0 := by
      rw [show ((1 : A), (0 : B)) = 0 by rw [h10]; rfl, map_zero]
    have hsum : ((1 : A), (0 : B)) + ((0 : A), (1 : B)) = 1 := by
      ext <;> simp
    have h1 : ψ ((0 : A), (1 : B)) = 1 := by
      have hone := map_one ψ
      rwa [← hsum, map_add, h0, zero_add] at hone
    let φ : B →+* ResidueField R :=
      { toFun := fun z => ψ ((0 : A), z)
        map_one' := h1
        map_mul' := fun x z => by rw [← map_mul]; congr 1; ext <;> simp
        map_zero' := by rw [show ((0 : A), (0 : B)) = 0 from rfl, map_zero]
        map_add' := fun x z => by rw [← map_add]; congr 1; ext <;> simp }
    have hker : Ideal.map (algebraMap R B) (maximalIdeal R) ≤ RingHom.ker φ := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      simp only [Ideal.mem_comap, RingHom.mem_ker]
      change ψ ((0 : A), algebraMap R B r) = 0
      have hfac2 : ((0 : A), algebraMap R B r) = ((0 : A), (1 : B)) * algebraMap R (A × B) r := by
        ext <;> simp
      rw [hfac2, map_mul, h1, one_mul, ψ.commutes, IsLocalRing.ResidueField.algebraMap_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
    have hone' : φ (1 : B) = 0 := hker (by rw [hBtop]; exact Submodule.mem_top)
    exact one_ne_zero ((map_one φ).symm.trans hone')
  -- the image of `X` in `A`
  set σA : AdjoinRoot f →ₐ[R] A :=
    p.comp (IsScalarTower.toAlgHom R (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h)))
    with hσA
  set y : A := σA (AdjoinRoot.root f) with hy
  have hσ : ∀ q : R[X], aeval y q = σA (AdjoinRoot.mk f q) := fun q => by
    rw [hy, Polynomial.aeval_algHom_apply, AdjoinRoot.aeval_eq]
  have hσp : ∀ t : AdjoinRoot f, σA t
      = p (algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h)) t) := fun _ => rfl
  have hΓ : IsUnit (aeval y h) := by
    rw [hσ h, hσp]
    exact (IsLocalization.Away.algebraMap_isUnit
      (S := Localization.Away (AdjoinRoot.mk f h)) (AdjoinRoot.mk f h)).map p
  have hfy : aeval y f = 0 := by rw [hσ f, AdjoinRoot.mk_self, map_zero]
  -- `X` is congruent to `b` modulo `𝔪 A`, because `h(y)` is invertible
  have hyb : y - algebraMap R A b ∈ Ideal.map (algebraMap R A) (maximalIdeal R) :=
    sub_mem_of_isUnit_aeval R f h b y hmcoeff hfy hΓ
  -- hence every element of `A` is congruent to a scalar modulo `𝔪 A`
  have hmod : ∀ z : A, ∃ r : R, z - algebraMap R A r ∈
      Ideal.map (algebraMap R A) (maximalIdeal R) := by
    intro z
    obtain ⟨w, rfl⟩ := hpsurj z
    obtain ⟨⟨s, n⟩, hn⟩ := IsLocalization.surj (Submonoid.powers (AdjoinRoot.mk f h)) w
    obtain ⟨k, hk⟩ := n.2
    obtain ⟨q, rfl⟩ := AdjoinRoot.mk_surjective s
    have hkey : p w * aeval y h ^ k = aeval y q := by
      have hpn := congrArg p hn
      rw [map_mul, ← hk] at hpn
      rw [hσ h, hσ q, hσp, hσp, ← map_pow, ← map_pow]
      simpa using hpn
    refine exists_sub_mem_of_mul_sub_mem R _ (p w) (aeval y h ^ k) (q.eval b)
      (h.eval b ^ k) (hcunit.pow k) ?_ ?_
    · rw [hkey]
      exact aeval_sub_mem R _ q y b hyb
    · have hpow := aeval_sub_mem R (Ideal.map (algebraMap R A) (maximalIdeal R)) (h ^ k) y b hyb
      rwa [map_pow, Polynomial.eval_pow] at hpow
  -- so `R → A` is an isomorphism and the preimage of the image of `X` is the root
  obtain ⟨a, haf, hares⟩ := exists_isRoot_of_sub_mem R A f b y hmod hfy hyb
  exact ⟨a, haf, by rw [hares, hb]⟩

/-- 3 ⇒ 1. For `f` monic with a simple root `a₀` of `f̄` the factorisation
`f̄ = (T - a₀)h₀` is coprime, so it lifts to `f = gh`. In `S = R[T]/(f)` one has `gS + hS = S`
by Nakayama (Lemma 00DV) and `gS ∩ hS = 0` since `gh = 0`, so `S = S/(g) × S/(h)` by the Chinese
remainder theorem. Then `A = S/(g)` is finite free of rank `1`, `R → A` is an isomorphism by
`Algebra.finrank_eq_one_iff_bijective_algebraMap`, and the image of `T` is the root. -/
private theorem item3_imp_item1 : Item3 R → Item1 R := by
  intro H
  refine ((HenselianLocalRing.TFAE R).out 2 1).mp ?_
  intro f hfm a₀ h₁ h₂
  obtain ⟨h, hfac, hcop, -⟩ := exists_lift_divByMonic R f a₀ h₁ h₂
  obtain ⟨g, h', hgh, hg, hh'⟩ := H f hfm (X - C a₀) (h.map (residue R)) hfac hcop
  exact exists_isRoot_of_map_eq_X_sub_C R f g h' hfm hgh a₀ hg (by rw [hg, hh']; exact hcop)

/-- Item (6) needs proving only for a **monic** `g₀`: a nonzero `g₀` is made monic by rescaling
with the inverse of its leading coefficient `c`, the factor `h₀` absorbing `C c`, and a unit `u` of
`R` lifting `c` carries the resulting factorisation of `f` back — multiplication by `C u`
changing neither the degree of the first factor nor, after reduction, the pair `(g₀, h₀)`. -/
private theorem item6_of_monic
    (H : ∀ f : R[X], ∀ g₀ h₀ : (ResidueField R)[X], g₀.Monic →
      f.map (residue R) = g₀ * h₀ → IsCoprime g₀ h₀ →
      ∃ g h : R[X], f = g * h ∧ g.map (residue R) = g₀ ∧ h.map (residue R) = h₀ ∧
        g.degree = g₀.degree) : Item6 R := by
  intro f g₀ h₀ hg₀0 hfac hcop
  set c := g₀.leadingCoeff with hcdef
  have hc0 : c ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg₀0
  obtain ⟨u, hu⟩ : ∃ u : R, residue R u = c := Ideal.Quotient.mk_surjective _
  have hunit : IsUnit u := (IsLocalRing.residue_ne_zero_iff_isUnit u).mp (by rw [hu]; exact hc0)
  set v : R := (↑hunit.unit⁻¹ : R) with hv
  have hvu : v * u = 1 := hunit.val_inv_mul
  have hvres : residue R v = c⁻¹ :=
    eq_inv_of_mul_eq_one_left (by rw [← hu, ← map_mul, hvu, map_one])
  have hcc : C c * C c⁻¹ = (1 : (ResidueField R)[X]) := by
    rw [← Polynomial.C_mul, mul_inv_cancel₀ hc0, Polynomial.C_1]
  have hg₀' : (g₀ * C c⁻¹).Monic := Polynomial.monic_mul_leadingCoeff_inv hg₀0
  have hfac' : f.map (residue R) = (g₀ * C c⁻¹) * (C c * h₀) := by
    rw [hfac, show (g₀ * C c⁻¹) * (C c * h₀) = g₀ * (C c * C c⁻¹) * h₀ by ring, hcc, mul_one]
  have hcop' : IsCoprime (g₀ * C c⁻¹) (C c * h₀) := by
    obtain ⟨x, y, hxy⟩ := hcop
    refine ⟨x * C c, y * C c⁻¹, ?_⟩
    rw [show x * C c * (g₀ * C c⁻¹) + y * C c⁻¹ * (C c * h₀)
      = (x * g₀ + y * h₀) * (C c * C c⁻¹) by ring, hxy, hcc, mul_one]
  obtain ⟨g, h, hgh, hgm, hhm, hdeg⟩ := H f (g₀ * C c⁻¹) (C c * h₀) hg₀' hfac' hcop'
  refine ⟨C u * g, C v * h, ?_, ?_, ?_, ?_⟩
  · rw [show C u * g * (C v * h) = C u * C v * (g * h) by ring, ← Polynomial.C_mul,
      mul_comm u v, hvu, Polynomial.C_1, one_mul, hgh]
  · rw [Polynomial.map_mul, Polynomial.map_C, hu, hgm,
      show C c * (g₀ * C c⁻¹) = g₀ * (C c * C c⁻¹) by ring, hcc, mul_one]
  · rw [Polynomial.map_mul, Polynomial.map_C, hvres, hhm,
      show C c⁻¹ * (C c * h₀) = h₀ * (C c * C c⁻¹) by ring, hcc, mul_one]
  · rw [degree_C_mul_of_isUnit hunit, hdeg, mul_comm g₀ (C c⁻¹),
      degree_C_mul_of_isUnit (isUnit_iff_ne_zero.mpr (inv_ne_zero hc0))]

/-- **The factorisation produced by a factor of rank `deg g₀`.** Let `g₀` be monic with
`f̄ = g₀h₀`, and let `A` be a finite free `R`-algebra of rank `d = deg_T(g₀)` containing an element
`y` which is a root of `f`, whose first `d` powers generate `A` as an `R`-module, and which is
annihilated by no polynomial whose reduction is prime to `g₀` — precisely: every `p ∈ R[T]` with
`p(y) = 0` has `g₀ ∣ p̄`. Then `f = gh` with `g` monic, `ḡ = g₀`, `h̄ = h₀` and
`deg_T(g) = deg_T(g₀)`.

The powers `1, y, …, y^{d-1}` are a basis, being a spanning family of `d = rank A` elements
(`linearIndependent_of_top_le_span_of_card_eq_finrank`). Expanding `y^d` in that basis gives a
monic `g` of degree `d` with `g(y) = 0`, whose reduction is a monic multiple of `g₀` of degree `d`,
hence `g₀` itself. Dividing, `f = g(f /ₘ g) + (f %ₘ g)` with `f %ₘ g` of degree `< d` vanishing at
`y`, so `f %ₘ g = 0` by independence; and `h̄ = h₀` by cancelling `g₀` in `κ[T]`.

This replaces the source's characteristic polynomial of `T : A → A` and its Cayley–Hamilton step
by the power basis, which gives `ḡ = g₀` directly. -/
theorem exists_factorization_of_free_algebra (f : R[X]) (g₀ h₀ : (ResidueField R)[X])
    (hg₀ : g₀.Monic) (hfac : f.map (residue R) = g₀ * h₀)
    (A : Type*) [CommRing A] [Algebra R A] [Module.Finite R A] [Module.Free R A] (y : A)
    (hrank : Module.finrank R A = g₀.natDegree)
    (hspan : (⊤ : Submodule R A) ≤
      Submodule.span R (Set.range fun i : Fin g₀.natDegree => y ^ (i : ℕ)))
    (hfy : aeval y f = 0)
    (hker : ∀ p : R[X], aeval y p = 0 → g₀ ∣ p.map (residue R)) :
    ∃ g h : R[X], f = g * h ∧ g.map (residue R) = g₀ ∧ h.map (residue R) = h₀ ∧
      g.degree = g₀.degree := by
  classical
  have hcard : Fintype.card (Fin g₀.natDegree) = Module.finrank R A := by
    rw [Fintype.card_fin, hrank]
  have hli : LinearIndependent R (fun i : Fin g₀.natDegree => y ^ (i : ℕ)) :=
    linearIndependent_of_top_le_span_of_card_eq_finrank hspan hcard
  obtain ⟨c, hc⟩ : ∃ c : Fin g₀.natDegree → R,
      ∑ i, c i • y ^ (i : ℕ) = y ^ g₀.natDegree := by
    have hmem : y ^ g₀.natDegree ∈
        Submodule.span R (Set.range fun i : Fin g₀.natDegree => y ^ (i : ℕ)) :=
      hspan Submodule.mem_top
    rwa [Submodule.mem_span_range_iff_exists_fun] at hmem
  set p : R[X] := ∑ i : Fin g₀.natDegree, C (c i) * X ^ (i : ℕ) with hp
  have hpcoeff : ∀ n, g₀.natDegree ≤ n → p.coeff n = 0 := by
    intro n hn
    rw [hp, Polynomial.finsetSum_coeff]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hi : (i : ℕ) < g₀.natDegree := i.isLt
    rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, ite_eq_right (by omega), mul_zero]
  set g : R[X] := X ^ g₀.natDegree - p with hg
  have hgnat : g.natDegree ≤ g₀.natDegree :=
    Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun n hn => by
      rw [hg, Polynomial.coeff_sub, Polynomial.coeff_X_pow, ite_eq_right (by omega),
        hpcoeff n (by omega), sub_zero]
  have hgcoeff : g.coeff g₀.natDegree = 1 := by
    rw [hg, Polynomial.coeff_sub, Polynomial.coeff_X_pow, ite_eq_left rfl, hpcoeff _ le_rfl,
      sub_zero]
  have hgmonic : g.Monic := Polynomial.monic_of_natDegree_le_of_coeff_eq_one _ hgnat hgcoeff
  have hgnat' : g.natDegree = g₀.natDegree :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hgnat (by rw [hgcoeff]; exact one_ne_zero)
  have hgy : aeval y g = 0 := by
    have hterm : ∀ i : Fin g₀.natDegree,
        (aeval y) (C (c i) * X ^ (i : ℕ)) = c i • y ^ (i : ℕ) := by
      intro i; simp [Algebra.smul_def]
    rw [hg, map_sub, map_pow, Polynomial.aeval_X, hp, map_sum]
    simp only [hterm]
    rw [hc, sub_self]
  have hgmap : g.map (residue R) = g₀ := by
    obtain ⟨q, hq⟩ := hker g hgy
    have hmm : (g.map (residue R)).Monic := hgmonic.map _
    have hq0 : q ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hq
      exact hmm.ne_zero hq
    have hdq : g₀.natDegree + q.natDegree = g₀.natDegree := by
      rw [← Polynomial.natDegree_mul hg₀.ne_zero hq0, ← hq, hgmonic.natDegree_map, hgnat']
    have hqn : q.natDegree = 0 := by omega
    have hlc : q.leadingCoeff = 1 := by
      have h1 := hmm.leadingCoeff
      rw [hq, Polynomial.leadingCoeff_mul, hg₀.leadingCoeff, one_mul] at h1
      exact h1
    have hq1 : q = 1 := by
      rw [Polynomial.eq_C_of_natDegree_eq_zero hqn]
      rw [Polynomial.leadingCoeff, hqn] at hlc
      rw [hlc, Polynomial.C_1]
    rw [hq, hq1, mul_one]
  have hgdeg : g.degree = g₀.degree := by
    rw [Polynomial.degree_eq_natDegree hgmonic.ne_zero,
      Polynomial.degree_eq_natDegree hg₀.ne_zero, hgnat']
  have hrdeg : (f %ₘ g).degree < g.degree := Polynomial.degree_modByMonic_lt f hgmonic
  have hry : aeval y (f %ₘ g) = 0 := by
    have h2 := congrArg (aeval y) (Polynomial.modByMonic_add_div f g)
    rw [map_add, map_mul, hgy, zero_mul, add_zero, hfy] at h2
    exact h2
  have hsumR : ∑ i ∈ Finset.range g₀.natDegree, (f %ₘ g).coeff i • y ^ i = 0 := by
    rcases eq_or_ne (f %ₘ g) 0 with h0 | h0
    · simp [h0]
    · have hlt : (f %ₘ g).natDegree < g₀.natDegree := by
        rw [← hgnat']
        exact Polynomial.natDegree_lt_natDegree h0 hrdeg
      rw [← Polynomial.aeval_eq_sum_range' hlt, hry]
  have hcoeffs : ∀ i : Fin g₀.natDegree, (f %ₘ g).coeff (i : ℕ) = 0 := by
    refine Fintype.linearIndependent_iff.mp hli (fun i => (f %ₘ g).coeff (i : ℕ)) ?_
    rw [← Fin.sum_univ_eq_sum_range (fun i => (f %ₘ g).coeff i • y ^ i) g₀.natDegree] at hsumR
    exact hsumR
  have hr0 : f %ₘ g = 0 := by
    ext n
    rcases lt_or_ge n g₀.natDegree with hn | hn
    · exact hcoeffs ⟨n, hn⟩
    · refine Polynomial.coeff_eq_zero_of_degree_lt (lt_of_lt_of_le hrdeg ?_)
      rw [hgdeg, Polynomial.degree_eq_natDegree hg₀.ne_zero]
      exact_mod_cast hn
  have hfgh : f = g * (f /ₘ g) := by
    have h1 := Polynomial.modByMonic_add_div f g
    rw [hr0, zero_add] at h1
    exact h1.symm
  refine ⟨g, f /ₘ g, hfgh, hgmap, ?_, hgdeg⟩
  refine mul_left_cancel₀ hg₀.ne_zero ?_
  calc g₀ * ((f /ₘ g).map (residue R)) = (g.map (residue R)) * ((f /ₘ g).map (residue R)) := by
        rw [hgmap]
    _ = (g * (f /ₘ g)).map (residue R) := by rw [Polynomial.map_mul]
    _ = f.map (residue R) := by rw [← hfgh]
    _ = g₀ * h₀ := hfac

end Stacks.Henselian.Characterizations
