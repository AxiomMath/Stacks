open CategoryTheory IsLocalRing

/-- The flatness and maximal-ideal assertions of Stacks 07QM for an independently
specified henselization. The residue extension, base, and target have independent universes;
no comparison map to another henselization is needed. -/
public theorem faithfullyFlat_and_map_maximalIdeal_of_isHenselization.{u, v}
    {R : Type u} [CommRing R] [IsLocalRing R]
    {L : Type v} [Field L] [Algebra (ResidueField R) L]
    {S : Type u} [CommRing S] [IsLocalRing S] [Algebra R S]
    [IsHenselization R L S] :
    Module.FaithfullyFlat R S ∧
      (maximalIdeal R).map (algebraMap R S) = maximalIdeal S :=
  ⟨IsHenselization.faithfullyFlat (L := L), IsHenselization.map_maximalIdeal (L := L)⟩

section

universe u v w

private theorem basis_of_flat_nilpotent_idealMap {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (I : Ideal A) (hI : IsNilpotent I) {ι : Type w} (x : ι → B)
    (b : Module.Basis ι (A ⧸ I) (B ⧸ I.map (algebraMap A B)))
    (hb : ∀ i, b i = Ideal.Quotient.mk _ (x i)) :
    ∃ b' : Module.Basis ι A B, ∀ i, b' i = x i := by
  let E : (B ⧸ I • (⊤ : Submodule A B)) ≃ₗ[A]
      (B ⧸ I.map (algebraMap A B)) :=
    (Submodule.quotEquivOfEq _ _ (Ideal.smul_top_eq_map I)) ≪≫ₗ
      (Submodule.Quotient.restrictScalarsEquiv A (I.map (algebraMap A B)))
  let E' : (B ⧸ I • (⊤ : Submodule A B)) ≃ₗ[A ⧸ I]
      (B ⧸ I.map (algebraMap A B)) :=
    { E.toAddEquiv with
      map_smul' := by
        intro a y
        induction a using Quotient.inductionOn with
        | _ a =>
          induction y using Submodule.Quotient.induction_on with
          | _ y => rfl }
  let b' := b.map E'.symm
  have hb' (i : ι) : b' i = (I • (⊤ : Submodule A B)).mkQ (x i) := by
    apply E'.injective
    calc
      E' (b' i) = b i := by simp [b']
      _ = Ideal.Quotient.mk _ (x i) := hb i
      _ = E' ((I • (⊤ : Submodule A B)).mkQ (x i)) := rfl
  have hfun : (I • (⊤ : Submodule A B)).mkQ ∘ x = b' :=
    funext fun i => (hb' i).symm
  have hbase :=
    (Module.Flat.linearIndependent_and_span_eq_top_mkQ_comp_iff_of_isNilpotent I hI x).mp
      (hfun ▸ ⟨b'.linearIndependent, b'.span_eq⟩)
  refine ⟨Module.Basis.mk hbase.1 hbase.2.ge, fun i => ?_⟩
  exact Module.Basis.mk_apply ..

private theorem basis_quotient_of_flat_of_nilpotent {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (I J : Ideal A) (hIJ : I ≤ J)
    (hnil : IsNilpotent (J.map (Ideal.Quotient.mk I)))
    {ι : Type w} (x : ι → B)
    (b : Module.Basis ι (A ⧸ J) (B ⧸ J.map (algebraMap A B)))
    (hb : ∀ i, b i = Ideal.Quotient.mk _ (x i)) :
    let : Algebra (A ⧸ I) (B ⧸ I.map (algebraMap A B)) :=
      Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
    ∃ b' : Module.Basis ι (A ⧸ I) (B ⧸ I.map (algebraMap A B)),
      ∀ i, b' i = Ideal.Quotient.mk _ (x i) := by
  let f := algebraMap A B
  let IA := J.map (Ideal.Quotient.mk I)
  let JB := J.map f
  let IB := IA.map (algebraMap (A ⧸ I) (B ⧸ I.map f))
  let : Algebra (A ⧸ I) (B ⧸ I.map f) :=
    Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
  let : Module.Flat (A ⧸ I) (B ⧸ I.map f) := flat_quotient_map I
  let : Algebra ((A ⧸ I) ⧸ IA) ((B ⧸ I.map f) ⧸ IB) :=
    Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
  let : Algebra (A ⧸ J) (B ⧸ JB) :=
    Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
  have hIB : IB = JB.map (Ideal.Quotient.mk (I.map f)) := by
    simp only [IB, IA, JB, Ideal.map_map]
    exact congrArg (fun g : A →+* (B ⧸ I.map f) => J.map g)
      (Ideal.quotientMap_comp_mk Ideal.le_comap_map)
  let eA : (A ⧸ I) ⧸ IA ≃+* A ⧸ J := DoubleQuot.quotQuotEquivQuotOfLE hIJ
  let eB : (B ⧸ I.map f) ⧸ IB ≃+* B ⧸ JB :=
    (Ideal.quotEquivOfEq hIB).trans
      (DoubleQuot.quotQuotEquivQuotOfLE (Ideal.map_mono hIJ))
  let : Module (A ⧸ J) ((B ⧸ I.map f) ⧸ IB) :=
    Module.compHom _ eA.symm.toRingHom
  let eBl : ((B ⧸ I.map f) ⧸ IB) ≃ₗ[A ⧸ J] B ⧸ JB :=
    { eB.toAddEquiv with
      map_smul' := by
        intro a y
        induction a using Quotient.inductionOn with
        | _ a =>
          induction y using Quotient.inductionOn with
          | _ y =>
            induction y using Quotient.inductionOn with
            | _ y =>
              rfl }
  let b' : Module.Basis ι ((A ⧸ I) ⧸ IA) ((B ⧸ I.map f) ⧸ IB) :=
    (b.map eBl.symm).mapCoeffs eA.symm (by intro c y; rfl)
  have hb' (i : ι) : b' i = Ideal.Quotient.mk IB
      (Ideal.Quotient.mk (I.map f) (x i)) := by
    apply eBl.injective
    have hcoeff : b' i = (b.map eBl.symm) i :=
      Module.Basis.mapCoeffs_apply (b.map eBl.symm) eA.symm
        (by intro c y; rfl) i
    calc
      eBl (b' i) = b i := by
        rw [hcoeff, Module.Basis.map_apply, LinearEquiv.apply_symm_apply]
      _ = Ideal.Quotient.mk JB (x i) := hb i
      _ = eBl (Ideal.Quotient.mk IB
          (Ideal.Quotient.mk (I.map f) (x i))) := by
            show _ = eB (Ideal.Quotient.mk IB
              (Ideal.Quotient.mk (I.map f) (x i)))
            show _ = (DoubleQuot.quotQuotEquivQuotOfLE
              (Ideal.map_mono hIJ))
                ((Ideal.quotEquivOfEq hIB)
                  (Ideal.Quotient.mk IB (Ideal.Quotient.mk (I.map f) (x i))))
            rw [Ideal.quotEquivOfEq_mk]
            show (Ideal.Quotient.mk JB) (x i) =
              (DoubleQuot.quotQuotEquivQuotOfLE (Ideal.map_mono hIJ))
                (DoubleQuot.quotQuotMk (I.map f) JB (x i))
            exact (DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk (x i)
              (Ideal.map_mono hIJ)).symm
  exact basis_of_flat_nilpotent_idealMap IA hnil
    (fun i => Ideal.Quotient.mk (I.map f) (x i)) b' hb'

end

/-- **Stacks 07QM.** Let `Rh` and `Rsh` be respectively a henselization and a strict
henselization of a local ring `R`, with residue field of `Rsh` identified with a separable
closure `κsep` of the residue field of `R`. Then `R → Rh → Rsh` is faithfully flat, the maximal
ideals are generated by those below them, reduction modulo every power of the maximal ideal is
unchanged by henselization, and the corresponding reduction of `Rsh` has a basis obtained by
reducing one fixed family of elements of `Rsh`. -/
@[stacks 07QM "The identification `_hRsh_res` of `ResidueField Rsh` with `κsep` is carried, for
faithfulness to the source statement, but is not needed by the proof: the basis comes from
ind-étaleness of `R → Rsh` together with `[IsSepClosed (ResidueField Rsh)]`. Hence the leading
underscore on that binder."]
public theorem henselization_faithfullyFlat_and_quotient_basis.{u, v, w, t}
    {R : Type u} {Rh : Type w} {Rsh : Type t} {κsep : Type v}
    [CommRing R] [IsLocalRing R]
    [CommRing Rh] [Algebra R Rh] [HenselianLocalRing Rh]
    [IsLocalHom (algebraMap R Rh)]
    [CommRing Rsh] [Algebra R Rsh] [Algebra Rh Rsh]
    [IsScalarTower R Rh Rsh] [HenselianLocalRing Rsh]
    [IsLocalHom (algebraMap Rh Rsh)]
    [Field κsep] [Algebra (ResidueField R) κsep]
    [IsSepClosure (ResidueField R) κsep] [IsSepClosed (ResidueField Rsh)]
    (hRh_ind : (CommAlgCat.etale.{w} R).ind.{w} (CommAlgCat.of R Rh))
    (hRh_res : Function.Bijective (ResidueField.map (algebraMap R Rh)))
    (hRsh_ind : (CommAlgCat.etale.{t} R).ind.{t} (CommAlgCat.of R Rsh))
    (_hRsh_res : ∃ e : κsep ≃+* ResidueField Rsh, ∀ x : R,
      e (algebraMap (ResidueField R) κsep (residue R x)) =
        residue Rsh (algebraMap R Rsh x)) :
    Module.FaithfullyFlat R Rh ∧
      Module.FaithfullyFlat Rh Rsh ∧
      (maximalIdeal R).map (algebraMap R Rh) = maximalIdeal Rh ∧
      (maximalIdeal R).map (algebraMap R Rsh) = maximalIdeal Rsh ∧
      (maximalIdeal Rh).map (algebraMap Rh Rsh) = maximalIdeal Rsh ∧
      (∀ n : ℕ, Function.Bijective
        (Ideal.quotientMap ((maximalIdeal R ^ n).map (algebraMap R Rh))
          (algebraMap R Rh) Ideal.le_comap_map)) ∧
      ∃ (ι : Type t) (x : ι → Rsh), ∀ n : ℕ,
        letI : Algebra (R ⧸ maximalIdeal R ^ n)
            (Rsh ⧸ (maximalIdeal R ^ n).map (algebraMap R Rsh)) :=
          Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
        ∃ b : Module.Basis ι (R ⧸ maximalIdeal R ^ n)
            (Rsh ⧸ (maximalIdeal R ^ n).map (algebraMap R Rsh)),
          ∀ i, b i = Ideal.Quotient.mk _ (x i) := by
  have hRh_flat : Module.Flat R Rh := CommAlgCat.flat_of_ind_etale hRh_ind
  have hRsh_flat : Module.Flat R Rsh := CommAlgCat.flat_of_ind_etale hRsh_ind
  have : IsLocalHom (algebraMap R Rsh) := by
    rw [IsScalarTower.algebraMap_eq R Rh Rsh]
    exact RingHom.isLocalHom_comp _ _
  have hRh_max : (maximalIdeal R).map (algebraMap R Rh) = maximalIdeal Rh :=
    CommAlgCat.map_maximalIdeal_of_ind_etale hRh_ind
  have hRsh_max : (maximalIdeal R).map (algebraMap R Rsh) = maximalIdeal Rsh :=
    CommAlgCat.map_maximalIdeal_of_ind_etale hRsh_ind
  have hRhRsh_max : (maximalIdeal Rh).map (algebraMap Rh Rsh) = maximalIdeal Rsh := by
    rw [← hRh_max, Ideal.map_map, ← IsScalarTower.algebraMap_eq R Rh Rsh, hRsh_max]
  have : Module.Flat Rh Rsh := CommAlgCat.flat_of_ind_etale_restrictScalars hRh_ind
  refine ⟨Module.FaithfullyFlat.of_flat_of_isLocalHom,
    Module.FaithfullyFlat.of_flat_of_isLocalHom, hRh_max, hRsh_max, hRhRsh_max, ?_, ?_⟩
  · intro n
    have hqres : Function.Bijective
        (Ideal.quotientMap ((maximalIdeal R).map (algebraMap R Rh))
          (algebraMap R Rh) Ideal.le_comap_map) := by
      let e : (Rh ⧸ (maximalIdeal R).map (algebraMap R Rh)) ≃+* ResidueField Rh :=
        Ideal.quotEquivOfEq hRh_max
      have hc (x : ResidueField R) :
          e ((Ideal.quotientMap ((maximalIdeal R).map (algebraMap R Rh))
            (algebraMap R Rh) Ideal.le_comap_map) x) =
            ResidueField.map (algebraMap R Rh) x := by
        induction x using Quotient.inductionOn with
        | _ x => rfl
      exact ⟨fun x y hxy => hRh_res.1 ((hc x).symm.trans ((congrArg e hxy).trans (hc y))),
        fun y => (hRh_res.2 (e y)).imp fun x hx => e.injective ((hc x).trans hx)⟩
    exact quotientMap_pow_bijective_of_flat (maximalIdeal R) hqres n
  · classical
    let m := maximalIdeal R
    let ms := m.map (algebraMap R Rsh)
    let : Algebra (R ⧸ m) (Rsh ⧸ ms) :=
      Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
    let : Field (R ⧸ m) := Ideal.Quotient.field m
    let b₀ := Module.Basis.ofVectorSpace (R ⧸ m) (Rsh ⧸ ms)
    let ι := Module.Basis.ofVectorSpaceIndex (R ⧸ m) (Rsh ⧸ ms)
    choose x hx using fun i : ι =>
      (Ideal.Quotient.mk_surjective (b₀ i))
    refine ⟨ι, x, ?_⟩
    intro n
    rcases n with _ | n
    · have : Subsingleton (R ⧸ m ^ 0) :=
        Ideal.Quotient.subsingleton_iff.mpr (by simp)
      have : Subsingleton (Rsh ⧸ (m ^ 0).map (algebraMap R Rsh)) :=
        Ideal.Quotient.subsingleton_iff.mpr (by simp [Ideal.map_top])
      let : Algebra (R ⧸ m ^ 0)
          (Rsh ⧸ (m ^ 0).map (algebraMap R Rsh)) :=
        Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
      exact ⟨default, fun i => Subsingleton.elim _ _⟩
    · let I := m ^ (n + 1)
      have hIJ : I ≤ m := Ideal.pow_le_self (Nat.succ_ne_zero n)
      have hnil : IsNilpotent (m.map (Ideal.Quotient.mk I)) :=
        ⟨n + 1, by rw [← Ideal.map_pow]; exact Ideal.map_quotient_self I⟩
      exact basis_quotient_of_flat_of_nilpotent I m hIJ hnil x b₀ fun i => (hx i).symm

end

