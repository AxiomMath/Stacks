open CategoryTheory

universe u v

private lemma etale_le_finitePresentation (R : CommRingCat.{u}) :
    (CommRingCat.etale.{u}).underObj (X := R) ≤
      fun C : Under R ↦ C.hom.hom.FinitePresentation :=
  fun _ h ↦ h.finitePresentation

public lemma isReduced_of_ind_etale {R S : Type u} [CommRing R] [CommRing S]
    [Algebra R S] [IsReduced R]
    (h : (CommAlgCat.etale.{u} R).ind.{u} (CommAlgCat.of R S)) : IsReduced S := by
  classical
  rw [CommAlgCat.ind_etale_iff_ind_algebraMap,
    MorphismProperty.ind_iff_ind_underMk,
    CommRingCat.ind_under_iff_exists_factorization _
      (etale_le_finitePresentation (CommRingCat.of R))] at h
  constructor
  intro x hx
  obtain ⟨n, hn⟩ := hx
  let p : Polynomial R := Polynomial.X ^ n
  let Z := AdjoinRoot p
  let g : Z →ₐ[R] S := AdjoinRoot.liftAlgHom p (Algebra.ofId R S) x (by simpa [p] using hn)
  have hp : (algebraMap R Z).FinitePresentation :=
    RingHom.finitePresentation_algebraMap.mpr inferInstance
  let P : Under (CommRingCat.of R) := Under.mk (CommRingCat.ofHom (algebraMap R Z))
  let Λ : Under (CommRingCat.of R) := Under.mk (CommRingCat.ofHom (algebraMap R S))
  let φ : P ⟶ Λ := Under.homMk (CommRingCat.ofHom g) (by ext r; exact g.commutes r)
  obtain ⟨W, a, b, hab, ha⟩ := h P hp φ
  let : Algebra R W.right := W.hom.hom.toAlgebra
  have : Algebra.Etale R W.right := ha
  have hW : IsReduced W.right := Algebra.isReduced_of_smooth R W.right
  let y : W.right := a.right.hom (AdjoinRoot.root p)
  have hyn : y ^ n = 0 := by
    show a.right.hom (AdjoinRoot.root p) ^ n = 0
    rw [← map_pow, show (AdjoinRoot.root p) ^ n = 0 by
      simpa [p] using AdjoinRoot.eval₂_root p, map_zero]
  have hy : y = 0 := IsReduced.eq_zero y ⟨n, hyn⟩
  have hbx : b.right.hom y = x := by
    show b.right.hom (a.right.hom (AdjoinRoot.root p)) = x
    have hcomp := congrArg (fun f : P ⟶ Λ => f.right.hom (AdjoinRoot.root p)) hab
    change b.right.hom (a.right.hom (AdjoinRoot.root p)) = g (AdjoinRoot.root p) at hcomp
    exact hcomp.trans (AdjoinRoot.liftAlgHom_root (p := p) (Algebra.ofId R S) x _)
  rw [← hbx, hy, map_zero]

private lemma isLocalHom_of_isHenselization
    {R S : Type u} {L : Type v} [CommRing R] [CommRing S] [Field L]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S]
    [Algebra (IsLocalRing.ResidueField R) L]
    [IsLocalRing.IsHenselization R L S] :
    IsLocalHom (algebraMap R S) := by
  obtain ⟨e, he⟩ :=
    IsLocalRing.IsHenselization.exists_residueFieldEquiv (R := R) (L := L) (Rh := S)
  apply ((IsLocalRing.local_hom_TFAE (algebraMap R S)).out 4 1).mp
  intro r hr
  apply (IsLocalRing.residue_eq_zero_iff _).mp
  have h := he r
  rw [(IsLocalRing.residue_eq_zero_iff _).mpr hr, map_zero, map_zero] at h
  exact h.symm

private lemma faithfullyFlat_of_etale_factor
    {R W S : Type u} [CommRing R] [CommRing W] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R W] [Algebra R S]
    (hW : Algebra.Etale R W) (b : W →ₐ[R] S)
    (hlocal : IsLocalHom (algebraMap R S)) : Module.FaithfullyFlat R W := by
  let : Algebra.Etale R W := hW
  have : IsLocalHom (algebraMap R S) := hlocal
  have hle : (IsLocalRing.maximalIdeal R).map (algebraMap R W) ≤
      (IsLocalRing.maximalIdeal S).comap b.toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    show b (algebraMap R W r) ∈ IsLocalRing.maximalIdeal S
    rw [b.commutes r]
    exact IsLocalRing.map_maximalIdeal_le (algebraMap R S)
      (Ideal.mem_map_of_mem (algebraMap R S) hr)
  have hproper : (IsLocalRing.maximalIdeal R).map (algebraMap R W) ≠ ⊤ := by
    intro ht
    have : (⊤ : Ideal W) ≤ (IsLocalRing.maximalIdeal S).comap b.toRingHom := ht ▸ hle
    exact Ideal.comap_ne_top b.toRingHom (IsLocalRing.maximalIdeal.isMaximal S).ne_top
      (top_le_iff.mp this)
  refine (Module.faithfullyFlat_iff R W).mpr ⟨inferInstance, fun m hm => ?_⟩
  rw [IsLocalRing.eq_maximalIdeal hm, Ideal.smul_top_eq_map]
  intro ht
  apply hproper
  have hone : (1 : W) ∈ Submodule.restrictScalars R
      ((IsLocalRing.maximalIdeal R).map (algebraMap R W) : Submodule W W) :=
    ht ▸ Submodule.mem_top
  exact (Ideal.eq_top_iff_one _).mpr hone

private lemma injective_of_ind_etale_of_isLocalHom
    {R S : Type u} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S]
    (hind : (CommAlgCat.etale.{u} R).ind.{u} (CommAlgCat.of R S))
    (hlocal : IsLocalHom (algebraMap R S)) :
    Function.Injective (algebraMap R S) := by
  classical
  rw [CommAlgCat.ind_etale_iff_ind_algebraMap,
    MorphismProperty.ind_iff_ind_underMk,
    CommRingCat.ind_under_iff_exists_factorization _
      (etale_le_finitePresentation (CommRingCat.of R))] at hind
  apply (RingHom.injective_iff_ker_eq_bot (algebraMap R S)).mpr
  apply (RingHom.ker_eq_bot_iff_eq_zero (algebraMap R S)).mpr
  intro r hr
  let I : Ideal R := Ideal.span {r}
  let Z := R ⧸ I
  have hI : I ≤ RingHom.ker (algebraMap R S) :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hr)
  let g : Z →ₐ[R] S := Ideal.Quotient.liftₐ I (Algebra.ofId R S) (fun a ha ↦ hI ha)
  have hp : (algebraMap R Z).FinitePresentation :=
    RingHom.finitePresentation_algebraMap.mpr
      (Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton r))
  let P : Under (CommRingCat.of R) := Under.mk (CommRingCat.ofHom (algebraMap R Z))
  let Λ : Under (CommRingCat.of R) := Under.mk (CommRingCat.ofHom (algebraMap R S))
  let φ : P ⟶ Λ := Under.homMk (CommRingCat.ofHom g) (by ext t; exact g.commutes t)
  obtain ⟨W, a, b, hab, ha⟩ := hind P hp φ
  let : Algebra R W.right := W.hom.hom.toAlgebra
  have hW : Algebra.Etale R W.right := ha
  let β : W.right →ₐ[R] S :=
    { b.right.hom with
      commutes' := fun t ↦ by
        have hb := congrArg
          (fun f : (CommRingCat.of R) ⟶ (CommRingCat.of S) ↦ f.hom t) (Under.w b)
        change b.right.hom (W.hom.hom t) = algebraMap R S t at hb
        exact hb }
  have : Module.FaithfullyFlat R W.right := faithfullyFlat_of_etale_factor hW β hlocal
  apply FaithfulSMul.algebraMap_injective R W.right
  rw [map_zero]
  have hwa := congrArg
    (fun f : (CommRingCat.of R) ⟶ W.right ↦ f.hom r) (Under.w a)
  change a.right.hom (algebraMap R Z r) = algebraMap R W.right r at hwa
  have hrZ : (algebraMap R Z) r = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self r)
  rw [hrZ, map_zero] at hwa
  exact hwa.symm

/-- Reducedness of a local ring, its henselization, and its strict henselization are equivalent. -/
@[stacks 06DH, ega "IV 18.6.9" "(i), special case", ega "IV 18.8.12" "(i), special case"]
public theorem isReduced_tfae_henselization_strictHenselization
    (R Rh Rsh : Type u) [CommRing R] [CommRing Rh] [CommRing Rsh]
    [IsLocalRing R] [IsLocalRing Rh] [IsLocalRing Rsh]
    [Algebra R Rh] [Algebra R Rsh]
    [IsLocalRing.IsHenselization R (IsLocalRing.ResidueField R) Rh]
    (κsep : Type v) [Field κsep] [Algebra (IsLocalRing.ResidueField R) κsep]
    [IsSepClosure (IsLocalRing.ResidueField R) κsep]
    [IsLocalRing.IsHenselization R κsep Rsh] :
    List.TFAE [IsReduced R, IsReduced Rh, IsReduced Rsh] := by
  have hlocH : IsLocalHom (algebraMap R Rh) :=
    isLocalHom_of_isHenselization (L := IsLocalRing.ResidueField R)
  have hlocSH : IsLocalHom (algebraMap R Rsh) :=
    isLocalHom_of_isHenselization (L := κsep)
  tfae_have 1 → 2 := fun _ ↦
    isReduced_of_ind_etale
      (IsLocalRing.IsHenselization.ind_etale_of_universe_le
        (R := R) (IsLocalRing.ResidueField R) (Rh := Rh))
  tfae_have 1 → 3 := fun _ ↦
    isReduced_of_ind_etale
      (IsLocalRing.IsHenselization.ind_etale_of_universe_le (R := R) κsep (Rh := Rsh))
  tfae_have 2 → 1 := fun _ ↦
    isReduced_of_injective (algebraMap R Rh)
      (injective_of_ind_etale_of_isLocalHom
        (IsLocalRing.IsHenselization.ind_etale_of_universe_le
        (R := R) (IsLocalRing.ResidueField R) (Rh := Rh))
        hlocH)
  tfae_have 3 → 1 := fun _ ↦
    isReduced_of_injective (algebraMap R Rsh)
      (injective_of_ind_etale_of_isLocalHom
        (IsLocalRing.IsHenselization.ind_etale_of_universe_le (R := R) κsep (Rh := Rsh)) hlocSH)
  tfae_finish

end

