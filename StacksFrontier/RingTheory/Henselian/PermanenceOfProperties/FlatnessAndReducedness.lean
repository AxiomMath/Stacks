  have hpo : Algebra.IsPushout R (R ⧸ nilradical R) S (S ⧸ I) :=
    Stacks.Henselian.isPushout_quotient_map (nilradical R)
  have hindQ : (CommAlgCat.etale.{u} (R ⧸ nilradical R)).ind.{u}
      (CommAlgCat.of (R ⧸ nilradical R) (S ⧸ I)) :=
    CommAlgCat.ind_etale_of_isPushout R (R ⧸ nilradical R) S (S ⧸ I) hind
  have hredR : IsReduced (R ⧸ nilradical R) := by
    rw [← Ideal.isRadical_iff_quotient_reduced]
