universe u v

open CategoryTheory Limits IsLocalRing

private theorem formallyEtale_of_ind_etale (R S : Type u) [CommRing R] [CommRing S]
    [Algebra R S] (h : (CommAlgCat.etale.{u} R).ind.{u} (CommAlgCat.of R S)) :
    Algebra.FormallyEtale R S := by
  obtain ⟨J, _, _, pres, het⟩ := h
  rw [Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth]
  constructor
  · rw [Algebra.FormallyUnramified.iff_comp_injective]
    intro B _ _ I hI g₁ g₂ hg
    have heq : CommAlgCat.ofHom g₁ = CommAlgCat.ofHom g₂ := by
      apply pres.isColimit.hom_ext
      intro i
      apply CommAlgCat.hom_ext
      apply Algebra.FormallyUnramified.lift_unique I ⟨2, by rw [hI]; rfl⟩
      exact congrArg (fun q => q.comp (pres.ι.app i).hom) hg
    exact congrArg CommAlgCat.Hom.hom heq
  · rw [Algebra.FormallySmooth.iff_comp_surjective]
    intro B _ _ I hI g
    have hnil : IsNilpotent I := ⟨2, by rw [hI]; rfl⟩
    have hfe (i : J) : Algebra.FormallyEtale R (pres.diag.obj i) :=
      (Algebra.formallyEtale_iff_etale R _ (het i).2).2 (het i)
    have hfs (i : J) : Algebra.FormallySmooth R (pres.diag.obj i) :=
      let _ := hfe i
      inferInstance
    choose f hf using fun i => by
      let : Algebra.FormallySmooth R (pres.diag.obj i) := hfs i
      exact Algebra.FormallySmooth.exists_lift I hnil (g.comp (pres.ι.app i).hom)
    let c : Cocone pres.diag :=
      { pt := CommAlgCat.of R B
        ι :=
          { app := fun i => CommAlgCat.ofHom (f i)
            naturality := by
              intro i j φ
              apply CommAlgCat.hom_ext
              simp only [CommAlgCat.hom_comp, CommAlgCat.hom_ofHom, Functor.const_obj_obj,
                Functor.const_obj_map, CommAlgCat.hom_id]
              apply Algebra.FormallyUnramified.lift_unique (A := pres.diag.obj i) I hnil
              simp only [AlgHom.id_comp]
              rw [← AlgHom.comp_assoc, hf j, hf i, AlgHom.comp_assoc]
              exact congrArg (fun q => g.comp q)
                (congrArg CommAlgCat.Hom.hom (pres.ι.naturality φ)) } }
    refine ⟨(pres.isColimit.desc c).hom, ?_⟩
    have heq : CommAlgCat.ofHom ((Ideal.Quotient.mkₐ R I).comp (pres.isColimit.desc c).hom) =
        CommAlgCat.ofHom g := by
      apply pres.isColimit.hom_ext
      intro i
      apply CommAlgCat.hom_ext
      simp only [CommAlgCat.hom_comp, CommAlgCat.hom_ofHom]
      have hd : (pres.isColimit.desc c).hom.comp (pres.ι.app i).hom = f i :=
        congrArg CommAlgCat.Hom.hom (pres.isColimit.fac c i)
      rw [AlgHom.comp_assoc, hd, hf i]
    exact congrArg CommAlgCat.Hom.hom heq

/-- A formally étale map to a local ring is formally smooth for the discrete topology on the source
and the maximal-ideal-adic topology on the target. -/
private theorem isFormallySmooth_adic_of_formallyEtale (A B : Type u) [CommRing A] [CommRing B]
    [IsLocalRing B] [Algebra A B] (h : Algebra.FormallyEtale A B) :
    letI : TopologicalSpace A := ⊥
    letI : DiscreteTopology A := ⟨rfl⟩
    letI := (maximalIdeal B).adicTopology
    letI : IsTopologicalRing B := (maximalIdeal B).ringFilterBasis.isTopologicalRing
    letI : IsLinearTopology B B := (maximalIdeal B).isLinearTopology
    IsFormallySmooth (algebraMap A B) := by
  let : TopologicalSpace A := ⊥
  let : DiscreteTopology A := ⟨rfl⟩
  let := (maximalIdeal B).adicTopology
  let : IsTopologicalRing B := (maximalIdeal B).ringFilterBasis.isTopologicalRing
  let : IsLinearTopology B B := (maximalIdeal B).isLinearTopology
  show IsFormallySmooth (algebraMap A B)
  apply (isFormallySmooth_of_formallySmooth_and_isAdic_and_iff_discrete _).1
  · exact ⟨maximalIdeal B, rfl⟩
  · exact RingHom.FormallySmooth.toAlgebra <|
      RingHom.formallySmooth_algebraMap.mpr
        (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mp h).2
  · fun_prop

/-- The maps from a local ring to its henselization, from its henselization to its strict
henselization, and from the original ring to its strict henselization are formally étale. With
the discrete topology on each source, they are formally smooth for the adic topology defined by
the maximal ideal of the corresponding target. -/
@[stacks 07QN]
public theorem henselization_formallyEtale_and_isFormallySmooth
    (R Rh Rsh : Type u)
    [CommRing R] [IsLocalRing R]
    [CommRing Rh] [IsLocalRing Rh] [Algebra R Rh]
    [CommRing Rsh] [IsLocalRing Rsh] [Algebra R Rsh] [Algebra Rh Rsh]
    [IsScalarTower R Rh Rsh]
    (κsep : Type v)
    [Field κsep] [Algebra (ResidueField R) κsep]
    [IsSepClosure (ResidueField R) κsep]
    [IsHenselization R (ResidueField R) Rh]
    [IsHenselization R κsep Rsh]
    [IsLocalHom (algebraMap Rh Rsh)] :
    Algebra.FormallyEtale R Rh ∧
      Algebra.FormallyEtale Rh Rsh ∧
      Algebra.FormallyEtale R Rsh ∧
      (letI : TopologicalSpace R := ⊥
       letI : DiscreteTopology R := ⟨rfl⟩
       letI := (maximalIdeal Rh).adicTopology
       letI : IsTopologicalRing Rh := (maximalIdeal Rh).ringFilterBasis.isTopologicalRing
       letI : IsLinearTopology Rh Rh := (maximalIdeal Rh).isLinearTopology
       IsFormallySmooth (algebraMap R Rh)) ∧
      (letI : TopologicalSpace Rh := ⊥
       letI : DiscreteTopology Rh := ⟨rfl⟩
       letI := (maximalIdeal Rsh).adicTopology
       letI : IsTopologicalRing Rsh := (maximalIdeal Rsh).ringFilterBasis.isTopologicalRing
       letI : IsLinearTopology Rsh Rsh := (maximalIdeal Rsh).isLinearTopology
       IsFormallySmooth (algebraMap Rh Rsh)) ∧
      (letI : TopologicalSpace R := ⊥
       letI : DiscreteTopology R := ⟨rfl⟩
       letI := (maximalIdeal Rsh).adicTopology
       letI : IsTopologicalRing Rsh := (maximalIdeal Rsh).ringFilterBasis.isTopologicalRing
       letI : IsLinearTopology Rsh Rsh := (maximalIdeal Rsh).isLinearTopology
       IsFormallySmooth (algebraMap R Rsh)) := by
  have hRh : Algebra.FormallyEtale R Rh :=
    formallyEtale_of_ind_etale R Rh
      (IsHenselization.ind_etale_of_universe_le (R := R) (L := ResidueField R))
  have hRsh : Algebra.FormallyEtale R Rsh :=
    formallyEtale_of_ind_etale R Rsh (IsHenselization.ind_etale_of_universe_le (R := R) (L := κsep))
  have hmid : Algebra.FormallyEtale Rh Rsh :=
    Algebra.FormallyEtale.of_restrictScalars (R := R) (A := Rh) (B := Rsh)
  exact ⟨hRh, hmid, hRsh, isFormallySmooth_adic_of_formallyEtale R Rh hRh,
    isFormallySmooth_adic_of_formallyEtale Rh Rsh hmid,
    isFormallySmooth_adic_of_formallyEtale R Rsh hRsh⟩

end

