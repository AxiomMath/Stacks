* [Stacks Project, Tag 0EE9](https://stacks.math.columbia.edu/tag/0EE9)
-/

@[expose] public section

open scoped TensorProduct

open IsLocalRing

universe u v w

namespace StacksDraft

section Fibre

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- **A reduced fibre stays reduced after localizing at a prime of the total space.** If the
fibre `κ(p) ⊗_R S` of an `R`-algebra `S` at a prime `p` is reduced, then for every prime `q` of
`S` lying over `p` the quotient of `S_q` by the ideal generated by `p` is reduced.

Both rings are localizations of the fibre at the prime of `κ(p) ⊗_R S` corresponding to `q`,
which `Ideal.Fiber.algEquivAux₂` identifies with `S_q ⧸ p S_q`. -/
theorem isReduced_quotient_map_localizationAtPrime_of_isReduced_fiber
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] [q.LiesOver p]
    (hred : IsReduced (p.Fiber S)) :
    IsReduced (Localization.AtPrime q ⧸
      Ideal.map (algebraMap R (Localization.AtPrime q)) p) := by
  have key : ∀ Q : PrimeSpectrum S, Q = (⟨q, ‹q.IsPrime›⟩ : PrimeSpectrum S) →
      IsReduced (Localization.AtPrime Q.asIdeal ⧸
          Ideal.map (algebraMap R (Localization.AtPrime Q.asIdeal)) p) →
        IsReduced (Localization.AtPrime q ⧸
          Ideal.map (algebraMap R (Localization.AtPrime q)) p) := by
    rintro _ rfl h
    exact h
  have hq : PrimeSpectrum.comap (algebraMap R S) (⟨q, ‹q.IsPrime›⟩ : PrimeSpectrum S) =
      (⟨p, ‹p.IsPrime›⟩ : PrimeSpectrum R) :=
    PrimeSpectrum.ext (Ideal.over_def q p).symm
  let α := PrimeSpectrum.preimageEquivFiber R S (⟨p, ‹p.IsPrime›⟩ : PrimeSpectrum R)
  let qbar : PrimeSpectrum (p.Fiber S) := α ⟨⟨q, ‹q.IsPrime›⟩, hq⟩
  have hunder : Ideal.comap (Algebra.TensorProduct.includeRight.toRingHom) qbar.asIdeal = q := by
    change (α.invFun qbar).1.asIdeal = q
    simpa [qbar, α, PrimeSpectrum.preimageEquivFiber] using
      congrArg
        (fun z : {r : PrimeSpectrum S //
            PrimeSpectrum.comap (algebraMap R S) r = (⟨p, ‹p.IsPrime›⟩ : PrimeSpectrum R)} =>
          z.1.asIdeal)
        (α.left_inv ⟨⟨q, ‹q.IsPrime›⟩, hq⟩)
  have : IsReduced (p.Fiber S) := hred
  have : IsReduced (Localization.AtPrime qbar.asIdeal) :=
    isReduced_localizationPreserves qbar.asIdeal.primeCompl
      (Localization.AtPrime qbar.asIdeal) inferInstance
  have h := isReduced_of_injective _ (Ideal.Fiber.algEquivAux₂ p qbar.asIdeal).symm.injective
  rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq] at h
  exact key ⟨_, Ideal.comap_isPrime _ _⟩ (PrimeSpectrum.ext hunder) h

/-- **The maximal ideal of the base extends to the maximal ideal, at a minimal prime over a
reduced fibre.** Let `S` be an `R`-algebra whose fibre `κ(p) ⊗_R S` at a prime `p` of `R` is
reduced, and let `q` be a *minimal* prime of `S` lying over `p`. Then the induced local
homomorphism `R_p ⟶ S_q` carries the maximal ideal of `R_p` onto the maximal ideal of `S_q`.

Minimality of `q` makes every element of the maximal ideal of `S_q` nilpotent (Stacks 00EU,
`minimal_prime_maximalIdeal_isNilpotent`), and
`StacksDraft.isReduced_quotient_map_localizationAtPrime_of_isReduced_fiber` makes the quotient
by the extended ideal reduced, so that nilpotent is already there. The other inclusion is
locality of the homomorphism. -/
theorem map_maximalIdeal_localRingHom_of_mem_minimalPrimes_of_isReduced_fiber
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] [q.LiesOver p]
    (hq : q ∈ minimalPrimes S) (hred : IsReduced (p.Fiber S)) :
    Ideal.map (Localization.localRingHom p q (algebraMap R S) Ideal.LiesOver.over)
        (maximalIdeal (Localization.AtPrime p)) =
      maximalIdeal (Localization.AtPrime q) := by
  have : IsLocalHom (Localization.localRingHom p q (algebraMap R S) Ideal.LiesOver.over) :=
    Localization.isLocalHom_localRingHom p q (algebraMap R S) Ideal.LiesOver.over
  have hmapeq :
      Ideal.map (Localization.localRingHom p q (algebraMap R S) Ideal.LiesOver.over)
          (maximalIdeal (Localization.AtPrime p)) =
        Ideal.map (algebraMap R (Localization.AtPrime q)) p := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map]
    refine congrArg (fun f : R →+* Localization.AtPrime q => Ideal.map f p) (RingHom.ext ?_)
    intro x
    rw [RingHom.comp_apply, Localization.localRingHom_to_map,
      IsScalarTower.algebraMap_apply R S (Localization.AtPrime q)]
  refine le_antisymm (IsLocalRing.map_maximalIdeal_le _) ?_
  rw [hmapeq]
  intro x hx
  obtain ⟨n, hn⟩ : IsNilpotent x := minimal_prime_maximalIdeal_isNilpotent S q hq x hx
  have : IsReduced (Localization.AtPrime q ⧸
      Ideal.map (algebraMap R (Localization.AtPrime q)) p) :=
    isReduced_quotient_map_localizationAtPrime_of_isReduced_fiber p q hred
  refine Ideal.Quotient.eq_zero_iff_mem.1 (IsNilpotent.eq_zero ⟨n, ?_⟩)
  rw [← map_pow, hn, map_zero]

end Fibre

end StacksDraft

namespace IsLocalRing

variable {A : Type u} {B : Type w} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
  [Algebra A B] (L : Type v) [Field L] [Algebra (IsLocalRing.ResidueField A) L]
  [IsLocalRing.IsHenselization A L B]

include L in
/-- **The localization of a henselization at a branch is unramified over the base.** Let `B` be
a henselization or a strict henselization of a local ring `A`, let `q` be a minimal prime of
`B` — a branch of `A` — and let `p` be the prime of `A` it lies over. Then the induced local
homomorphism `A_p ⟶ B_q` carries the maximal ideal of `A_p` onto the maximal ideal of `B_q`.

A henselization is ind-étale, so its fibres are reduced
(`StacksDraft.fiber_reduced_and_krullDimLE_zero`), and
`StacksDraft.map_maximalIdeal_localRingHom_of_mem_minimalPrimes_of_isReduced_fiber` applies. -/
theorem map_maximalIdeal_localRingHom_of_isHenselization
    (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime] [q.LiesOver p]
    (hq : q ∈ minimalPrimes B) :
    Ideal.map (Localization.localRingHom p q (algebraMap A B) Ideal.LiesOver.over)
        (maximalIdeal (Localization.AtPrime p)) =
      maximalIdeal (Localization.AtPrime q) :=
  StacksDraft.map_maximalIdeal_localRingHom_of_mem_minimalPrimes_of_isReduced_fiber p q hq
    (StacksDraft.fiber_reduced_and_krullDimLE_zero
      (IsLocalRing.IsHenselization.ind_etale (R := A) (L := L) (Rh := B)) p).1

include L in
/-- **The localization of a henselization at a prime is flat over the localization of the base.**
A henselization or strict henselization is flat, and flatness passes to the induced
homomorphism of localizations. -/
theorem flat_localRingHom_of_isHenselization
    (p : Ideal A) [p.IsPrime] (q : Ideal B) [q.IsPrime] [q.LiesOver p] :
    (Localization.localRingHom p q (algebraMap A B) Ideal.LiesOver.over).Flat :=
  RingHom.Flat.localRingHom
    (RingHom.flat_algebraMap_iff.2 (IsLocalRing.IsHenselization.flat (L := L))) q p
    Ideal.LiesOver.over

end IsLocalRing

end
