module

public import Mathlib.RingTheory.Spectrum.Prime.Topology
import StacksCore.Tactic.StacksAttribute

/-!
# `Spec(R_f)` is homeomorphic to the standard open `D(f)`

For `S` a localization of `R` away from `f`, the map `Spec S → Spec R` induced by `R → S` is a
homeomorphism onto the standard open `D(f)`, and its inverse sends a prime `𝔭 ∈ D(f)` to the
ideal `𝔭 · S` generated by its image.

## Main results

* `PrimeSpectrum.localizationAwayHomeomorphBasicOpen`: the homeomorphism `Spec S ≃ₜ D(f)`.
* `PrimeSpectrum.localizationAwayHomeomorphBasicOpen_symm_apply_asIdeal`: its inverse sends `𝔭`
  to `𝔭 · S`.
-/

@[expose] public section

variable {R : Type*} [CommSemiring R]

namespace PrimeSpectrum

/-- **Stacks 00E4**: for `S` a localization of `R` away from `f` (such as `R_f`), the map
`Spec S → Spec R` induced by `R → S` is a homeomorphism onto the standard open `D(f)`.

The forward map is `comap (algebraMap R S)` (`localizationAwayHomeomorphBasicOpen_apply_coe`)
and the inverse sends `𝔭` to `𝔭 · S` (`localizationAwayHomeomorphBasicOpen_symm_apply_asIdeal`).
It is assembled from Mathlib's `localization_away_isOpenEmbedding` (a homeomorphism onto the
range) and `localization_away_comap_range` (the range is `D(f)`). -/
@[stacks 00E4 "the homeomorphism `Spec(R_f) → D(f)`"]
noncomputable def localizationAwayHomeomorphBasicOpen (S : Type*) [CommSemiring S] [Algebra R S]
    (f : R) [IsLocalization.Away f S] : PrimeSpectrum S ≃ₜ basicOpen f :=
  (localization_away_isOpenEmbedding S f).isEmbedding.toHomeomorph.trans
    (Homeomorph.setCongr (localization_away_comap_range S f))

/-- The homeomorphism of Stacks 00E4 is induced by `R → S` through the functoriality of `Spec`:
it sends `𝔮` to its contraction `comap (algebraMap R S) 𝔮`. -/
@[simp]
theorem localizationAwayHomeomorphBasicOpen_apply_coe (S : Type*) [CommSemiring S] [Algebra R S]
    (f : R) [IsLocalization.Away f S] (q : PrimeSpectrum S) :
    (localizationAwayHomeomorphBasicOpen S f q : PrimeSpectrum R) = comap (algebraMap R S) q :=
  rfl

/-- **Stacks 00E4**, the inverse: the inverse of `Spec S → D(f)` sends `𝔭 ∈ D(f)` to the prime
`𝔭 · S`, the ideal of `S` generated by the image of `𝔭`. -/
@[stacks 00E4 "the inverse is `𝔭 ↦ 𝔭 · R_f`"]
theorem localizationAwayHomeomorphBasicOpen_symm_apply_asIdeal (S : Type*) [CommSemiring S]
    [Algebra R S] (f : R) [IsLocalization.Away f S] (p : basicOpen f) :
    ((localizationAwayHomeomorphBasicOpen S f).symm p).asIdeal =
      Ideal.map (algebraMap R S) (p : PrimeSpectrum R).asIdeal := by
  set q := (localizationAwayHomeomorphBasicOpen S f).symm p
  have hq : comap (algebraMap R S) q = p :=
    congrArg Subtype.val ((localizationAwayHomeomorphBasicOpen S f).apply_symm_apply p)
  rw [← hq, comap_asIdeal, IsLocalization.map_under (Submonoid.powers f) S]

end PrimeSpectrum
