module

public import Mathlib.Algebra.Colimit.Ring
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# The image of the spectrum of a directed colimit of algebras

Let `A` be a commutative ring and let `G` be a directed system of `A`-algebras over a directed
index order, with `A`-algebra transition maps. The spectrum of the colimit maps onto exactly the
primes of `A` that lie in the image of every stage.

## Main results

* `PrimeSpectrum.range_comap_algebraMap_directLimit`: the image of `Spec` of the colimit is the
  intersection of the images of the stages.

## Implementation notes

The inclusion into each stage image is formal. For the converse, a prime `p` lies in the image of
`Spec B → Spec A` exactly when the ideal generated by `p` in `B` contracts back to `p`
(`PrimeSpectrum.mem_range_comap_iff`), and the contraction only grows under enlarging `B`; so it
suffices to see that an element of `A` whose image lies in the extended ideal of the colimit
already does so at some stage. That is the content of `exists_of_mem_map_directLimit`, proved by
induction on the span presenting the extended ideal: a finite amount of data in the colimit comes
from a single stage, and an equation in the colimit between elements of a stage already holds at
some later stage.
-/

@[expose] public section

universe u

namespace PrimeSpectrum

variable {A : Type u} [CommRing A] {ι : Type u} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
  (G : ι → Type u) [∀ i, CommRing (G i)] [∀ i, Algebra A (G i)]
  (f : ∀ i j, i ≤ j → G i →+* G j)
  [DirectedSystem G fun i j h ↦ f i j h]
  (hf : ∀ i j (h : i ≤ j), (f i j h).comp (algebraMap A (G i)) = algebraMap A (G j))

omit [IsDirectedOrder ι] [Nonempty ι] [DirectedSystem G fun i j h ↦ f i j h] in
include hf in
/-- The transition maps carry the ideal generated by `I` at one stage into the ideal generated by
`I` at a later stage. -/
private theorem map_le_map_of_le (I : Ideal A) {i j : ι} (h : i ≤ j) :
    Ideal.map (f i j h) (Ideal.map (algebraMap A (G i)) I) ≤
      Ideal.map (algebraMap A (G j)) I := by
  rw [Ideal.map_map, hf i j h]

section

variable [Algebra A (Ring.DirectLimit G fun i j h ↦ f i j h)]
  (hof : ∀ i, (Ring.DirectLimit.of G (fun i j h ↦ f i j h) i).comp (algebraMap A (G i)) =
    algebraMap A (Ring.DirectLimit G fun i j h ↦ f i j h))

omit [DirectedSystem G fun i j h ↦ f i j h] in
include hf hof in
/-- An element of the ideal generated in the colimit by an ideal of the base comes from an element
of the ideal generated at some single stage. -/
theorem exists_of_mem_map_directLimit (I : Ideal A)
    {x : Ring.DirectLimit G fun i j h ↦ f i j h}
    (hx : x ∈ Ideal.map (algebraMap A (Ring.DirectLimit G fun i j h ↦ f i j h)) I) :
    ∃ (i : ι) (y : G i), Ring.DirectLimit.of G (fun i j h ↦ f i j h) i y = x ∧
      y ∈ Ideal.map (algebraMap A (G i)) I := by
  classical
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    exact ⟨Classical.arbitrary ι, algebraMap A (G _) a, RingHom.congr_fun (hof _) a,
      Ideal.mem_map_of_mem _ ha⟩
  | zero => exact ⟨Classical.arbitrary ι, 0, map_zero _, Submodule.zero_mem _⟩
  | add x₁ x₂ _ _ h₁ h₂ =>
    obtain ⟨i₁, y₁, hy₁, hm₁⟩ := h₁
    obtain ⟨i₂, y₂, hy₂, hm₂⟩ := h₂
    obtain ⟨k, hk₁, hk₂⟩ := exists_ge_ge i₁ i₂
    refine ⟨k, f i₁ k hk₁ y₁ + f i₂ k hk₂ y₂, ?_, ?_⟩
    · rw [map_add, Ring.DirectLimit.of_f, Ring.DirectLimit.of_f, hy₁, hy₂]
    · exact Submodule.add_mem _
        (map_le_map_of_le G f hf I hk₁ (Ideal.mem_map_of_mem _ hm₁))
        (map_le_map_of_le G f hf I hk₂ (Ideal.mem_map_of_mem _ hm₂))
  | smul c x _ h =>
    obtain ⟨i, y, hy, hm⟩ := h
    obtain ⟨i₂, y₂, hy₂⟩ := Ring.DirectLimit.exists_of c
    obtain ⟨k, hk, hk₂⟩ := exists_ge_ge i i₂
    refine ⟨k, f i₂ k hk₂ y₂ * f i k hk y, ?_, ?_⟩
    · rw [map_mul, Ring.DirectLimit.of_f, Ring.DirectLimit.of_f, hy, hy₂, smul_eq_mul]
    · exact Ideal.mul_mem_left _ _ (map_le_map_of_le G f hf I hk (Ideal.mem_map_of_mem _ hm))

include hf hof in
/-- The image of the spectrum of a directed colimit of `A`-algebras is the intersection of the
images of the spectra of the stages. -/
theorem range_comap_algebraMap_directLimit :
    Set.range (comap (algebraMap A (Ring.DirectLimit G fun i j h ↦ f i j h))) =
      ⋂ i, Set.range (comap (algebraMap A (G i))) := by
  refine Set.Subset.antisymm (Set.subset_iInter fun i ↦ ?_) fun p hp ↦ ?_
  · rw [← hof i, comap_comp]
    exact Set.range_comp_subset_range _ _
  · rw [Set.mem_iInter] at hp
    rw [mem_range_comap_iff]
    refine le_antisymm (fun a ha ↦ ?_) Ideal.le_comap_map
    obtain ⟨i, y, hy, hm⟩ := exists_of_mem_map_directLimit G f hf hof p.asIdeal ha
    have hzero : Ring.DirectLimit.of G (fun i j h ↦ f i j h) i
        (y - algebraMap A (G i) a) = 0 := by
      rw [map_sub, hy, ← hof i, RingHom.comp_apply, sub_self]
    obtain ⟨j, hij, hj⟩ := Ring.DirectLimit.of.zero_exact (f' := f) hzero
    have hmem : algebraMap A (G j) a ∈ Ideal.map (algebraMap A (G j)) p.asIdeal := by
      have hval : f i j hij (algebraMap A (G i) a) = f i j hij y := by
        rw [map_sub, sub_eq_zero] at hj
        exact hj.symm
      rw [← congrArg (fun g : A →+* _ ↦ g a) (hf i j hij)]
      simpa only [RingHom.coe_comp, Function.comp_apply, hval] using
        map_le_map_of_le G f hf p.asIdeal hij (Ideal.mem_map_of_mem _ hm)
    exact ((mem_range_comap_iff _).mp (hp j)).le hmem

end

end PrimeSpectrum

end
