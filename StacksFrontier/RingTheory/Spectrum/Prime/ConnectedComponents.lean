module

public import Mathlib.RingTheory.Localization.Away.Lemmas
public import Mathlib.RingTheory.Spectrum.Prime.Topology
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.TFAE
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Closed subsets of a spectrum that are unions of connected components

Proof of `PrimeSpectrum.isClosed_and_biUnion_connectedComponent_eq_tfae`: for a ring `R` and a
subset `T ⊆ Spec R`, being closed and a union of connected components, being an intersection of
clopen subsets, and being the zero locus of an ideal generated by idempotents are equivalent, and
the ideal is unique — it is the ideal generated by the idempotents vanishing on `T`.

## Main results

* `PrimeSpectrum.isClosed_and_biUnion_connectedComponent_eq_tfae`: Stacks Tag 04PP.
* `PrimeSpectrum.connectedComponent_eq_zeroLocus_span_isIdempotentElem`: the connected
  component of a prime is the zero locus of the ideal generated by its idempotents.

## Implementation notes

The equivalence of the source's (2) and (3) is the clopen/idempotent dictionary of Lemma 00EE,
available in Mathlib as `PrimeSpectrum.isClopen_iff_zeroLocus`. The uniqueness clause is the
source's radical argument of Lemma 00E0, carried by
`mem_of_isIdempotentElem_of_mem_radical`: an idempotent equals each of its own positive powers,
so an idempotent of `I.radical` lies in `I`.

The source deduces the equivalence of its (1) and (2) from the topology of spectral spaces
(Topology, Lemma 04PL, itself resting on Topology, Lemma 005F), which Mathlib does not have:
`connectedComponent_eq_iInter_isClopen` assumes a compact Hausdorff space, while `Spec R` is only
`T0`. That topology is replaced here by its ring-theoretic shadow, which is shorter and needs no
separation axiom. For a prime `p` write `I p` for the ideal generated by the idempotents lying in
`p`. Then `connectedComponent_eq_zeroLocus_span_isIdempotentElem` is Lemma 005F for `Spec R`:
`connectedComponent p = V (I p)`, the intersection of the clopen neighbourhoods of `p`. Its
substance is that `V (I p)` is preconnected — `isPreconnected_zeroLocus_span_isIdempotentElem`,
the heart of Lemma 005F — because a decomposition of `V (I p)` into two disjoint closed
pieces produces an element which is idempotent modulo `I p`
(`exists_isCoprime_mul_self_sub_mem`), idempotents lift along `R → R ⧸ I p`
(`mem_or_one_sub_mem_span_isIdempotentElem`), and `I p` contains no idempotent of `R` outside `p`.

The compactness step of the source's proof of 04PL — `T` closed in a quasi-compact space, so
`T ∩ V (I p) = ∅` already at a finite stage — becomes
`exists_isIdempotentElem_span_singleton_sup_eq_top`: an ideal generated by idempotents which is
comaximal with an ideal `A` contains a single idempotent already comaximal with `A`. The
finiteness lives one level below that, in
`exists_isIdempotentElem_mem_span_and_mem_span_singleton`: an element of an ideal generated by
idempotents involves only finitely many of the generators, and finitely many idempotents have a
least common idempotent multiple `e ⊔ f = e + f - e * f`, which generates
`Ideal.span {e} ⊔ Ideal.span {f}` (`span_singleton_add_sub_mul`).

## References

* [Stacks Project, Tag 04PP](https://stacks.math.columbia.edu/tag/04PP)
-/

@[expose] public section

namespace PrimeSpectrum

variable {R : Type*} [CommRing R]

/-! ### Ideals generated by idempotents -/

/-- The join `e + f - e * f` of an idempotent `e` with any element `f` is divisible by `e`. -/
private lemma add_sub_mul_dvd_left {e : R} (he : IsIdempotentElem e) (f : R) :
    e + f - e * f ∣ e :=
  ⟨e, by linear_combination (f - 1) * he.eq⟩

/-- The join `e + f - e * f` of two idempotents generates the sum of the ideals they generate. -/
private lemma span_singleton_add_sub_mul {e f : R} (he : IsIdempotentElem e)
    (hf : IsIdempotentElem f) :
    Ideal.span {e + f - e * f} = Ideal.span {e} ⊔ Ideal.span {f} := by
  refine le_antisymm ((Ideal.span_singleton_le_iff_mem _).mpr ?_) (sup_le
    (Ideal.span_singleton_le_span_singleton.mpr (add_sub_mul_dvd_left he f)) ?_)
  · have he' : e ∈ Ideal.span ({e} : Set R) ⊔ Ideal.span ({f} : Set R) :=
      Submodule.mem_sup_left (Ideal.mem_span_singleton_self e)
    have hf' : f ∈ Ideal.span ({e} : Set R) ⊔ Ideal.span ({f} : Set R) :=
      Submodule.mem_sup_right (Ideal.mem_span_singleton_self f)
    exact sub_mem (add_mem he' hf') (Ideal.mul_mem_left _ _ hf')
  · refine Ideal.span_singleton_le_span_singleton.mpr ?_
    have h := add_sub_mul_dvd_left hf e
    rwa [show f + e - f * e = e + f - e * f by ring] at h

/-- An element of an ideal generated by idempotents is a multiple of a single idempotent of that
ideal: it involves only finitely many generators `e₁, …, eₙ`, and each of those divides the
idempotent `e₁ ⊔ ⋯ ⊔ eₙ`. This is where the finiteness of the source's compactness argument
lives. -/
private lemma exists_isIdempotentElem_mem_span_and_mem_span_singleton {s : Set R}
    (hs : ∀ e ∈ s, IsIdempotentElem e) {b : R} (hb : b ∈ Ideal.span s) :
    ∃ g : R, IsIdempotentElem g ∧ g ∈ Ideal.span s ∧ b ∈ Ideal.span {g} := by
  induction hb using Submodule.span_induction with
  | mem e he => exact ⟨e, hs e he, Ideal.subset_span he, Ideal.mem_span_singleton_self e⟩
  | zero => exact ⟨0, .zero, zero_mem _, zero_mem _⟩
  | add b₁ b₂ _ _ ih₁ ih₂ =>
      obtain ⟨g₁, hg₁, hgs₁, hb₁⟩ := ih₁
      obtain ⟨g₂, hg₂, hgs₂, hb₂⟩ := ih₂
      refine ⟨g₁ + g₂ - g₁ * g₂, hg₁.add_sub_mul hg₂,
        sub_mem (add_mem hgs₁ hgs₂) (Ideal.mul_mem_left _ _ hgs₂), ?_⟩
      rw [span_singleton_add_sub_mul hg₁ hg₂]
      exact add_mem (Submodule.mem_sup_left hb₁) (Submodule.mem_sup_right hb₂)
  | smul r b _ ih => exact ih.imp fun g h => ⟨h.1, h.2.1, Submodule.smul_mem _ r h.2.2⟩

/-- Coprime elements of two ideals make those ideals comaximal. -/
private lemma sup_eq_top_of_isCoprime {I J : Ideal R} {x y : R} (h : IsCoprime x y) (hx : x ∈ I)
    (hy : y ∈ J) : I ⊔ J = ⊤ := by
  obtain ⟨u, v, huv⟩ := h
  exact (I ⊔ J).eq_top_iff_one.mpr (huv ▸ add_mem
    (Submodule.mem_sup_left (Ideal.mul_mem_left _ _ hx))
    (Submodule.mem_sup_right (Ideal.mul_mem_left _ _ hy)))

/-- An idempotent lying in the radical of an ideal lies in the ideal. -/
private lemma mem_of_isIdempotentElem_of_mem_radical {I : Ideal R} {e : R}
    (he : IsIdempotentElem e) (h : e ∈ I.radical) : e ∈ I := by
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp h
  cases n with
  | zero => rw [I.eq_top_iff_one.mpr (by simpa using hn)]; exact Submodule.mem_top
  | succ n => rwa [he.pow_succ_eq n] at hn

/-! ### The zero locus dictionary -/

/-- The zero locus of a set is the intersection of the zero loci of its elements. -/
@[ega "I 1.1.2" "(iii), special case"]
private lemma zeroLocus_eq_iInter₂ (s : Set R) : zeroLocus s = ⋂ f ∈ s, zeroLocus {f} := by
  rw [← zeroLocus_iUnion₂, Set.biUnion_of_singleton]

/-- Two ideals have disjoint zero loci in `Spec R` exactly when they are comaximal. -/
private lemma disjoint_zeroLocus_iff_sup_eq_top {I J : Ideal R} :
    Disjoint (zeroLocus (I : Set R)) (zeroLocus (J : Set R)) ↔ I ⊔ J = ⊤ := by
  rw [Set.disjoint_iff_inter_eq_empty, ← zeroLocus_sup, zeroLocus_empty_iff_eq_top]

/-- An idempotent vanishing on the zero locus of an ideal `I` lies in `I`. -/
private lemma mem_of_isIdempotentElem_of_zeroLocus_subset {I : Ideal R} {e : R}
    (he : IsIdempotentElem e) (h : zeroLocus (I : Set R) ⊆ zeroLocus {e}) : e ∈ I :=
  mem_of_isIdempotentElem_of_mem_radical he <| by
    rw [← vanishingIdeal_zeroLocus_eq_radical]
    exact vanishingIdeal_anti_mono h (subset_vanishingIdeal_zeroLocus {e} rfl)

/-- An ideal generated by idempotents is generated by *all* the idempotents vanishing on its zero
locus, hence is determined by that zero locus. -/
private lemma span_eq_span_isIdempotentElem_zeroLocus_subset {s : Set R}
    (hs : ∀ e ∈ s, IsIdempotentElem e) :
    Ideal.span s =
      Ideal.span {e : R | IsIdempotentElem e ∧
        zeroLocus (Ideal.span s : Set R) ⊆ zeroLocus {e}} :=
  le_antisymm
    (Ideal.span_le.mpr fun e he => Ideal.subset_span
      ⟨hs e he, fun _ hq => Set.singleton_subset_iff.mpr (hq (Ideal.subset_span he))⟩)
    (Ideal.span_le.mpr fun _ he => mem_of_isIdempotentElem_of_zeroLocus_subset he.1 he.2)

/-- **The compactness step.** If an ideal generated by idempotents is comaximal with an ideal `A`,
then already a single idempotent of it is comaximal with `A`. Geometrically: a closed subset of
`Spec R` disjoint from `V I` is disjoint from `V e` for a single idempotent `e ∈ I`. -/
private lemma exists_isIdempotentElem_span_singleton_sup_eq_top {s : Set R}
    (hs : ∀ e ∈ s, IsIdempotentElem e) {A : Ideal R} (h : Ideal.span s ⊔ A = ⊤) :
    ∃ g : R, IsIdempotentElem g ∧ g ∈ Ideal.span s ∧ Ideal.span {g} ⊔ A = ⊤ := by
  obtain ⟨b, hb, a, ha, hab⟩ :=
    Submodule.mem_sup.mp (show (1 : R) ∈ Ideal.span s ⊔ A from h ▸ Submodule.mem_top)
  obtain ⟨g, hg, hgs, hbg⟩ := exists_isIdempotentElem_mem_span_and_mem_span_singleton hs hb
  exact ⟨g, hg, hgs, (Ideal.span {g} ⊔ A).eq_top_iff_one.mpr
    (hab ▸ add_mem (Submodule.mem_sup_left hbg) (Submodule.mem_sup_right ha))⟩

/-! ### Connected components of a spectrum -/

/-- The ideal generated by the idempotents lying in an ideal `p` is contained in `p`. -/
private lemma span_isIdempotentElem_le (p : Ideal R) :
    Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p} ≤ p :=
  Ideal.span_le.mpr fun _ he => he.2

/-- Let `p` be a prime of `R` and let `I` be the ideal generated by the idempotents lying in `p`.
An element which is idempotent modulo `I` lies in `I` or is `1` modulo `I`; that is, idempotents
lift along `R → R ⧸ I`. Indeed if `g ∈ I` is an idempotent with `a * a - a ∈ (g)`, then
`(1 - g) * a` is an idempotent of `R` lifting `a`, and `I` contains every idempotent of `p`. -/
private lemma mem_or_one_sub_mem_span_isIdempotentElem {p : Ideal R} (hp : p.IsPrime) {a : R}
    (ha : a * a - a ∈ Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p}) :
    a ∈ Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p} ∨
      1 - a ∈ Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p} := by
  set s : Set R := {e : R | IsIdempotentElem e ∧ e ∈ p}
  have hmem : ∀ e : R, IsIdempotentElem e → e ∈ p → e ∈ Ideal.span s :=
    fun e h₁ h₂ => Ideal.subset_span ⟨h₁, h₂⟩
  obtain ⟨g, hg, hgs, hc⟩ :=
    exists_isIdempotentElem_mem_span_and_mem_span_singleton (fun e he => he.1) ha
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hc
  have hkey : (1 - g) * (a * a - a) = 0 := by rw [← hr]; linear_combination (-r) * hg.eq
  have he' : (1 - g) * a * ((1 - g) * a) = (1 - g) * a := by
    linear_combination hkey + a * a * hg.eq
  have he : IsIdempotentElem ((1 - g) * a) := isIdempotentElem_iff.mpr he'
  have hz : (1 - g) * a * (1 - (1 - g) * a) ∈ p := by
    rw [he.mul_one_sub_self]; exact p.zero_mem
  rcases hp.mem_or_mem hz with h | h
  · exact Or.inl <| show a ∈ _ from (show a = (1 - g) * a + g * a by ring) ▸
      add_mem (hmem _ he h) (Ideal.mul_mem_right _ _ hgs)
  · exact Or.inr <| show 1 - a ∈ _ from (show 1 - a = 1 - (1 - g) * a - g * a by ring) ▸
      sub_mem (hmem _ he.one_sub h) (Ideal.mul_mem_right _ _ hgs)

/-- If `α + β = 1` and `α * β` lies in the radical of `I`, then some `f` is idempotent modulo `I`,
coprime to `β`, with `1 - f` coprime to `α`: take `f = c * αⁿ` for a Bézout identity
`c * αⁿ + d * βⁿ = 1` with `(α * β) ^ n ∈ I`. -/
private lemma exists_isCoprime_mul_self_sub_mem {I : Ideal R} {α β : R} (hab : α + β = 1)
    (h : α * β ∈ I.radical) :
    ∃ f : R, f * f - f ∈ I ∧ IsCoprime f β ∧ IsCoprime (1 - f) α := by
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp h
  have hn' : (α * β) ^ (n + 1) ∈ I := by rw [pow_succ]; exact Ideal.mul_mem_right _ _ hn
  obtain ⟨c, d, hcd⟩ := (show IsCoprime α β from ⟨1, 1, by linear_combination hab⟩).pow
    (m := n + 1) (n := n + 1)
  refine ⟨c * α ^ (n + 1), ?_, ⟨1, d * β ^ n, by linear_combination hcd⟩, ⟨1, c * α ^ n, by ring⟩⟩
  have heq : c * α ^ (n + 1) * (c * α ^ (n + 1)) - c * α ^ (n + 1)
      = -(c * d) * (α * β) ^ (n + 1) := by
    rw [mul_pow]; linear_combination (c * α ^ (n + 1)) * hcd
  rw [heq]; exact Ideal.mul_mem_left _ _ hn'

/-- **Substitute for Topology, Lemma 005F.** For `p` a prime of `R`, the intersection of the clopen
neighbourhoods of `p` in `Spec R` — the zero locus of the ideal `I` generated by the idempotents
lying in `p` — is preconnected. A decomposition of `V I` into two disjoint closed pieces `V A`,
`V B` produces an element `f` which is idempotent modulo `I`; it lifts to an idempotent of `R`,
which lies in `I` or is `1` modulo `I`, and correspondingly `V I` meets only one of the pieces. -/
private lemma isPreconnected_zeroLocus_span_isIdempotentElem {p : Ideal R} (hp : p.IsPrime) :
    IsPreconnected (zeroLocus (Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p} : Set R)) := by
  set I : Ideal R := Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p}
  rw [isPreconnected_iff_subset_of_fully_disjoint_closed (isClosed_zeroLocus _)]
  intro u v hu hv hsub hdisj
  obtain ⟨A, rfl⟩ := (isClosed_iff_zeroLocus_ideal u).mp hu
  obtain ⟨B, rfl⟩ := (isClosed_iff_zeroLocus_ideal v).mp hv
  obtain ⟨α, hα, β, hβ, hab⟩ := Submodule.mem_sup.mp (show (1 : R) ∈ A ⊔ B from
    disjoint_zeroLocus_iff_sup_eq_top.mp hdisj ▸ Submodule.mem_top)
  have hprod : α * β ∈ I.radical := by
    rw [← vanishingIdeal_zeroLocus_eq_radical, mem_vanishingIdeal]
    exact fun q hq => (hsub hq).elim (fun h => Ideal.mul_mem_right _ _ (h hα))
      fun h => Ideal.mul_mem_left _ _ (h hβ)
  obtain ⟨f, hf, hfβ, hfα⟩ := exists_isCoprime_mul_self_sub_mem hab hprod
  rcases mem_or_one_sub_mem_span_isIdempotentElem hp hf with h | h
  · exact Or.inl <| (disjoint_zeroLocus_iff_sup_eq_top.mpr
      (sup_eq_top_of_isCoprime hfβ h hβ)).subset_left_of_subset_union hsub
  · exact Or.inr <| (disjoint_zeroLocus_iff_sup_eq_top.mpr
      (sup_eq_top_of_isCoprime hfα h hα)).subset_left_of_subset_union
      (hsub.trans (Set.union_comm _ _).subset)

/-- **Topology, Lemma 005F for `Spec R`.** The connected component of a point `p` of `Spec R` is
the intersection of the clopen neighbourhoods of `p`, namely the zero locus of the ideal generated
by the idempotents lying in `p`. -/
theorem connectedComponent_eq_zeroLocus_span_isIdempotentElem (p : PrimeSpectrum R) :
    connectedComponent p =
      zeroLocus (Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p.asIdeal} : Set R) := by
  have hp : p ∈ zeroLocus (Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p.asIdeal} : Set R) :=
    (mem_zeroLocus _ _).mpr (SetLike.coe_subset_coe.mpr (span_isIdempotentElem_le _))
  refine subset_antisymm ?_
    ((isPreconnected_zeroLocus_span_isIdempotentElem p.isPrime).subset_connectedComponent hp)
  rw [zeroLocus_span, zeroLocus_eq_iInter₂]
  refine Set.subset_iInter₂ fun e he => IsClopen.connectedComponent_subset
    (isClopen_iff_zeroLocus.mpr ⟨e, he.1, rfl⟩) (Set.singleton_subset_iff.mpr he.2)

/-- A union of connected components is disjoint from the connected component of every point
outside it. -/
private lemma disjoint_connectedComponent_of_notMem {X : Type*} [TopologicalSpace X] {T : Set X}
    (hT : (⋃ y ∈ T, connectedComponent y) = T) {x : X} (hx : x ∉ T) :
    Disjoint (connectedComponent x) T := by
  rw [Set.disjoint_left]
  intro y hy hyT
  exact hx (hT ▸ Set.mem_biUnion hyT (connectedComponent_eq hy ▸ mem_connectedComponent))

/-- **The source's proof of Topology, Lemma 04PL for `Spec R`.** A closed subset `T` of `Spec R`
disjoint from the connected component of `p` is contained in a clopen subset avoiding `p`: the
component is the zero locus of the ideal generated by the idempotents in `p`, and by the
compactness step a single one of those idempotents already separates `T` from `p`. -/
private lemma exists_isClopen_of_isClosed_of_disjoint_connectedComponent
    {T : Set (PrimeSpectrum R)} (hT : IsClosed T) {p : PrimeSpectrum R}
    (h : Disjoint (connectedComponent p) T) : ∃ U, IsClopen U ∧ T ⊆ U ∧ p ∉ U := by
  obtain ⟨A, rfl⟩ := (isClosed_iff_zeroLocus_ideal T).mp hT
  have htop : Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ p.asIdeal} ⊔ A = ⊤ :=
    disjoint_zeroLocus_iff_sup_eq_top.mp
      (connectedComponent_eq_zeroLocus_span_isIdempotentElem p ▸ h)
  obtain ⟨g, hg, hgp, hgA⟩ :=
    exists_isIdempotentElem_span_singleton_sup_eq_top (fun _ he => he.1) htop
  have hdisj : Disjoint (zeroLocus ({g} : Set R)) (zeroLocus (A : Set R)) := by
    rw [← zeroLocus_span, disjoint_zeroLocus_iff_sup_eq_top]; exact hgA
  exact ⟨(zeroLocus {g})ᶜ, (isClopen_iff_zeroLocus.mpr ⟨g, hg, rfl⟩).compl,
    hdisj.subset_compl_left,
    not_not_intro (Set.singleton_subset_iff.mpr (span_isIdempotentElem_le _ hgp))⟩

/-- Let `R` be a commutative ring and `T ⊆ Spec R`. The following are equivalent:
`T` is closed and a union of connected components of `Spec R`; `T` is an intersection of open and
closed subsets of `Spec R`; `T = V I` for some ideal `I` generated by idempotents; there is a
unique such ideal `I`; and `T` is the zero locus of the ideal generated by all idempotents
vanishing on `T`. -/
@[stacks 04PP]
theorem isClosed_and_biUnion_connectedComponent_eq_tfae (T : Set (PrimeSpectrum R)) :
    [IsClosed T ∧ (⋃ x ∈ T, connectedComponent x) = T,
      ∃ S : Set (Set (PrimeSpectrum R)), (∀ U ∈ S, IsClopen U) ∧ T = ⋂₀ S,
      ∃ I : Ideal R, (∃ s : Set R, (∀ e ∈ s, IsIdempotentElem e) ∧ I = Ideal.span s) ∧
        T = zeroLocus (I : Set R),
      ∃! I : Ideal R, (∃ s : Set R, (∀ e ∈ s, IsIdempotentElem e) ∧ I = Ideal.span s) ∧
        T = zeroLocus (I : Set R),
      T = zeroLocus
        (Ideal.span {e : R | IsIdempotentElem e ∧ T ⊆ zeroLocus {e}} : Set R)].TFAE := by
  tfae_have 1 → 2 := by
    rintro ⟨hcl, hcc⟩
    refine ⟨{U | IsClopen U ∧ T ⊆ U}, fun U hU => hU.1,
      subset_antisymm (fun x hx U hU => hU.2 hx) fun x hx => ?_⟩
    by_contra hxT
    obtain ⟨U, hU, hTU, hxU⟩ := exists_isClopen_of_isClosed_of_disjoint_connectedComponent hcl
      (disjoint_connectedComponent_of_notMem hcc hxT)
    exact hxU (hx U ⟨hU, hTU⟩)
  tfae_have 2 → 5 := by
    rintro ⟨S, hS, rfl⟩
    refine subset_antisymm (fun q hq => ?_) fun q hq U hU => ?_
    · rw [mem_zeroLocus, SetLike.coe_subset_coe]
      exact Ideal.span_le.mpr fun e he => he.2 hq rfl
    · obtain ⟨f, hf, rfl⟩ := isClopen_iff_zeroLocus.mp (hS U hU)
      exact Set.singleton_subset_iff.mpr (hq (Ideal.subset_span ⟨hf, Set.sInter_subset_of_mem hU⟩))
  tfae_have 5 → 3 := fun h => ⟨_, ⟨_, fun _ he => he.1, rfl⟩, h⟩
  tfae_have 3 → 4 := by
    rintro ⟨I, ⟨s, hs, rfl⟩, hT⟩
    refine ⟨Ideal.span s, ⟨⟨s, hs, rfl⟩, hT⟩, ?_⟩
    rintro J ⟨⟨t, ht, rfl⟩, hT'⟩
    rw [span_eq_span_isIdempotentElem_zeroLocus_subset ht,
      span_eq_span_isIdempotentElem_zeroLocus_subset hs, ← hT, ← hT']
  tfae_have 4 → 3 := fun h => h.exists
  tfae_have 3 → 2 := by
    rintro ⟨I, ⟨s, hs, rfl⟩, hT⟩
    refine ⟨(fun e => zeroLocus ({e} : Set R)) '' s, ?_, ?_⟩
    · rintro U ⟨e, he, rfl⟩
      exact isClopen_iff_zeroLocus.mpr ⟨e, hs e he, rfl⟩
    · rw [hT, zeroLocus_span, zeroLocus_eq_iInter₂, Set.sInter_image]
  tfae_have 2 → 1 := by
    rintro ⟨S, hS, rfl⟩
    exact ⟨isClosed_sInter fun U hU => (hS U hU).1,
      subset_antisymm (Set.iUnion₂_subset fun x hx y hy U hU =>
        (hS U hU).connectedComponent_subset (hx U hU) hy)
        fun x hx => Set.mem_biUnion hx mem_connectedComponent⟩
  tfae_finish

end PrimeSpectrum

end

@[expose] public section

/-! ## Connected components of `Spec R`

Each component is cut out by an ideal generated by idempotents, modulo which every
idempotent of the original ring is zero or one.
-/

open PrimeSpectrum TopologicalSpace Topology

variable {R : Type*} [CommRing R]

/-- **Stacks Tag 00EG.** For any commutative ring `R` and any point `x` of
`Spec R`, the connected component of `x` is `V(I)` for an ideal `I` generated by
idempotents such that every idempotent of `R` maps to `0` or `1` in `R/I`. -/
@[stacks 00EG]
theorem PrimeSpectrum.exists_connectedComponent_eq_zeroLocus_span_isIdempotentElem
    (x : PrimeSpectrum R) :
    ∃ I : Ideal R,
      connectedComponent x = PrimeSpectrum.zeroLocus (I : Set R) ∧
      I = Ideal.span {e : R | e ∈ I ∧ IsIdempotentElem e} ∧
      ∀ e : R, IsIdempotentElem e →
        (Ideal.Quotient.mk I e = 0 ∨ Ideal.Quotient.mk I e = 1) := by
  refine ⟨Ideal.span {e : R | IsIdempotentElem e ∧ e ∈ x.asIdeal},
    PrimeSpectrum.connectedComponent_eq_zeroLocus_span_isIdempotentElem x,
    le_antisymm (Ideal.span_le.mpr (Set.ofPred_subset.mpr fun e he =>
        Submodule.mem_span_of_mem ⟨Submodule.mem_span_of_mem he, he.1⟩))
      (Ideal.span_le.mpr (Set.ofPred_subset.mpr fun _ he => he.1)), fun e he => ?_⟩
  rcases x.isPrime.mem_or_mem_of_mul_eq_zero he.mul_one_sub_self with h | h
  · exact .inl (Ideal.Quotient.eq_zero_iff_mem.mpr (Submodule.mem_span_of_mem ⟨he, h⟩))
  · refine .inr ?_
    rw [← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq, ← neg_sub, neg_mem_iff]
    exact Submodule.mem_span_of_mem ⟨he.one_sub, h⟩

end

@[expose] public section

/--
The canonical ring homomorphism `R → R⧸(1-e) × R⧸e` for an element `e : R`,
given by `r ↦ ([r], [r])`. When `e` is idempotent it is a ring isomorphism.
-/
def RingHom.quotientProdOneSub {R : Type*} [CommRing R] (e : R) :
    R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
          (R ⧸ Ideal.span ({e} : Set R)) :=
  RingHom.prod (Ideal.Quotient.mk _) (Ideal.Quotient.mk _)

/-- The canonical product map sends an element to its two quotient classes. -/
@[simp]
lemma RingHom.quotientProdOneSub_apply {R : Type*} [CommRing R] (e r : R) :
    RingHom.quotientProdOneSub e r = (Ideal.Quotient.mk _ r, Ideal.Quotient.mk _ r) := rfl

/-- Injectivity of `RingHom.quotientProdOneSub` when `e` is idempotent. -/
private lemma RingHom.quotientProdOneSub_injective
    {R : Type*} [CommRing R] (e : R) (he : IsIdempotentElem e) :
    Function.Injective (RingHom.quotientProdOneSub e) := by
  rw [injective_iff_map_eq_zero]
  intro r hr
  simp only [RingHom.quotientProdOneSub_apply, Prod.mk_eq_zero] at hr
  obtain ⟨h1, h2⟩ := hr
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h1 h2
  obtain ⟨s, hs⟩ := h1
  obtain ⟨t, ht⟩ := h2
  have he01 : e * (1 - e) = 0 := he.mul_one_sub_self
  have hre : r * e = 0 := by
    rw [hs]; linear_combination s * he01
  have hr1e : r * (1 - e) = 0 := by
    rw [ht]; linear_combination t * he01
  have : r = r * e + r * (1 - e) := by ring
  rw [this, hre, hr1e, zero_add]

/-- In `R⧸(1-e)`, `[a * e + b * (1 - e)] = [a]`. -/
private lemma Ideal.Quotient.mk_mul_add_mul_one_sub_left {R : Type*} [CommRing R] (e a b : R) :
    (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set R))) (a * e + b * (1 - e))
      = (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set R))) a := by
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, Ideal.mem_span_singleton]
  exact ⟨b - a, by ring⟩

/-- In `R⧸e`, `[a * e + b * (1 - e)] = [b]`. -/
private lemma Ideal.Quotient.mk_mul_add_mul_one_sub_right {R : Type*} [CommRing R] (e a b : R) :
    (Ideal.Quotient.mk (Ideal.span ({e} : Set R))) (a * e + b * (1 - e))
      = (Ideal.Quotient.mk (Ideal.span ({e} : Set R))) b := by
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, Ideal.mem_span_singleton]
  exact ⟨a - b, by ring⟩

/-- Surjectivity of `RingHom.quotientProdOneSub`. -/
private lemma RingHom.quotientProdOneSub_surjective
    {R : Type*} [CommRing R] (e : R) :
    Function.Surjective (RingHom.quotientProdOneSub e) := by
  rintro ⟨q₁, q₂⟩
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q₁
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q₂
  refine ⟨a * e + b * (1 - e), ?_⟩
  rw [RingHom.quotientProdOneSub_apply, Ideal.Quotient.mk_mul_add_mul_one_sub_left,
    Ideal.Quotient.mk_mul_add_mul_one_sub_right]

/-- For an idempotent `e`, the canonical ring map `R → R⧸(1-e) × R⧸e` is bijective. -/
theorem RingHom.quotientProdOneSub_bijective
    {R : Type*} [CommRing R] (e : R) (he : IsIdempotentElem e) :
    Function.Bijective (RingHom.quotientProdOneSub e) :=
  ⟨RingHom.quotientProdOneSub_injective e he, RingHom.quotientProdOneSub_surjective e⟩

/-- The ring isomorphism `R ≃+* R⧸(1-e) × R⧸e` for an idempotent `e`. -/
noncomputable def IsIdempotentElem.ringEquivQuotientProd
    {R : Type*} [CommRing R] {e : R} (he : IsIdempotentElem e) :
    R ≃+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
          (R ⧸ Ideal.span ({e} : Set R)) :=
  RingEquiv.ofBijective (RingHom.quotientProdOneSub e) (RingHom.quotientProdOneSub_bijective e he)

/-- The product decomposition has the canonical product map as its underlying ring homomorphism. -/
@[simp]
lemma IsIdempotentElem.ringEquivQuotientProd_toRingHom {R : Type*} [CommRing R] {e : R}
    (he : IsIdempotentElem e) :
    (he.ringEquivQuotientProd : R →+* _) = RingHom.quotientProdOneSub e := rfl

/-- `Spec (R ⧸ J)` is homeomorphic, via `comap (mk J)`, to any `W` equal to `V(J)`. -/
private lemma PrimeSpectrum.exists_homeomorph_quotient_of_zeroLocus_eq
    {R : Type*} [CommRing R] (J : Ideal R) (W : Set (PrimeSpectrum R))
    (hW : PrimeSpectrum.zeroLocus (J : Set R) = W) :
    ∃ eW : PrimeSpectrum (R ⧸ J) ≃ₜ W,
      ∀ p, (eW p).1 = PrimeSpectrum.comap (Ideal.Quotient.mk J) p := by
  have hrange : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk J)) = W := by
    rw [range_comap_of_surjective (R ⧸ J) (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, hW]
  exact ⟨((PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ _
    Ideal.Quotient.mk_surjective).toIsEmbedding.toHomeomorph).trans (Homeomorph.setCongr hrange),
    fun p => rfl⟩

/--
The homeomorphism `Spec(R⧸(1-e)) ≃ₜ U`, factoring via the standard product map.

Given an idempotent `e` with `U = D(e)`, the canonical map
`comap (Ideal.Quotient.mk _) : Spec(R⧸(1-e)) → Spec R` is a closed embedding with
range `U`. Moreover, since `φ = RingHom.quotientProdOneSub e` is the diagonal of the two
quotient maps, the underlying map equals
`comap φ ∘ primeSpectrumProdHomeo.symm ∘ Sum.inl`.
-/
private lemma PrimeSpectrum.exists_homeomorph_quotient_span_one_sub
    (R : Type*) [CommRing R] (e : R) (he : IsIdempotentElem e)
    (U : Set (PrimeSpectrum R))
    (hUe : U = (PrimeSpectrum.basicOpen e : Set _))
    (φ : R ≃+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                (R ⧸ Ideal.span ({e} : Set R)))
    (hφ : (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                     (R ⧸ Ideal.span ({e} : Set R))) = RingHom.quotientProdOneSub e) :
    ∃ eU : PrimeSpectrum (R ⧸ Ideal.span ({1 - e} : Set R)) ≃ₜ U,
      ∀ p, (eU p).1 =
        PrimeSpectrum.comap
          (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                     (R ⧸ Ideal.span ({e} : Set R)))
          (PrimeSpectrum.primeSpectrumProdHomeo.symm (Sum.inl p)) := by
  obtain ⟨eU, h⟩ := PrimeSpectrum.exists_homeomorph_quotient_of_zeroLocus_eq
    (Ideal.span ({1 - e} : Set R)) U (by
      rw [hUe, PrimeSpectrum.basicOpen_eq_zeroLocus_of_isIdempotentElem e he,
        PrimeSpectrum.zeroLocus_span])
  refine ⟨eU, fun p => ?_⟩
  rw [h]
  erw [PrimeSpectrum.primeSpectrumProd_symm_inl, ← PrimeSpectrum.comap_comp_apply, hφ]
  rfl

/-- Symmetric statement for `V`. -/
private lemma PrimeSpectrum.exists_homeomorph_quotient_span
    (R : Type*) [CommRing R] (e : R) (he : IsIdempotentElem e)
    (V : Set (PrimeSpectrum R))
    (hVe : V = (PrimeSpectrum.basicOpen (1 - e) : Set _))
    (φ : R ≃+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                (R ⧸ Ideal.span ({e} : Set R)))
    (hφ : (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                     (R ⧸ Ideal.span ({e} : Set R))) = RingHom.quotientProdOneSub e) :
    ∃ eV : PrimeSpectrum (R ⧸ Ideal.span ({e} : Set R)) ≃ₜ V,
      ∀ p, (eV p).1 =
        PrimeSpectrum.comap
          (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                     (R ⧸ Ideal.span ({e} : Set R)))
          (PrimeSpectrum.primeSpectrumProdHomeo.symm (Sum.inr p)) := by
  obtain ⟨eV, h⟩ := PrimeSpectrum.exists_homeomorph_quotient_of_zeroLocus_eq
    (Ideal.span ({e} : Set R)) V (by
      rw [hVe, PrimeSpectrum.basicOpen_eq_zeroLocus_of_isIdempotentElem (1 - e) he.one_sub,
        sub_sub_cancel, PrimeSpectrum.zeroLocus_span])
  refine ⟨eV, fun p => ?_⟩
  rw [h]
  erw [PrimeSpectrum.primeSpectrumProd_symm_inr, ← PrimeSpectrum.comap_comp_apply, hφ]
  rfl

/--
A disjoint open cover of `Spec R` yields a product decomposition of `R`.

Let `R` be a commutative ring with `Spec(R) = U ⊔ V` for two open subsets `U, V`.
Then there is an idempotent `e ∈ R` such that, setting `R₁ := R⧸(1-e)` and
`R₂ := R⧸e`:

* the canonical ring map `φ := RingHom.quotientProdOneSub e : R →+* R₁ × R₂` lifts to a
  ring isomorphism `R ≃+* R₁ × R₂`;
* `Spec(R₁)` is homeomorphic to `U` (as a subspace of `Spec R`) and `Spec(R₂)`
  is homeomorphic to `V`, with both homeomorphisms realised by the canonical maps
  of the product decomposition, i.e. via `PrimeSpectrum.primeSpectrumProdHomeo`;
* each factor is simultaneously a quotient and a localization of `R`:
  the quotient maps make `R₁` a localization at `e` and `R₂` a localization at `1 - e`.
-/
@[stacks 00EM]
theorem PrimeSpectrum.exists_ringEquiv_prod_of_isOpen_of_isCompl
    {R : Type*} [CommRing R]
    {U V : Set (PrimeSpectrum R)}
    (hU : IsOpen U) (hV : IsOpen V)
    (h : IsCompl U V) :
    ∃ e : R, IsIdempotentElem e ∧
      ∃ φ : R ≃+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                  (R ⧸ Ideal.span ({e} : Set R)),
        (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                   (R ⧸ Ideal.span ({e} : Set R))) = RingHom.quotientProdOneSub e ∧
        (∃ eU : PrimeSpectrum (R ⧸ Ideal.span ({1 - e} : Set R)) ≃ₜ U,
          ∀ p, (eU p).1 =
            PrimeSpectrum.comap
              (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                         (R ⧸ Ideal.span ({e} : Set R)))
              (PrimeSpectrum.primeSpectrumProdHomeo.symm (Sum.inl p))) ∧
        (∃ eV : PrimeSpectrum (R ⧸ Ideal.span ({e} : Set R)) ≃ₜ V,
          ∀ p, (eV p).1 =
            PrimeSpectrum.comap
              (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                         (R ⧸ Ideal.span ({e} : Set R)))
              (PrimeSpectrum.primeSpectrumProdHomeo.symm (Sum.inr p))) ∧
        IsLocalization.Away e (R ⧸ Ideal.span ({1 - e} : Set R)) ∧
        IsLocalization.Away (1 - e) (R ⧸ Ideal.span ({e} : Set R)) := by
  -- By Lemma 00EE, `U = D(e)` for an idempotent `e`, and then `V = Uᶜ = D(1 - e)`.
  obtain ⟨e, he, hUe⟩ := PrimeSpectrum.isClopen_iff.mp
    (isClopen_of_disjoint_cover_open h.sup_eq_top.ge hU hV h.disjoint)
  have hVe : V = (PrimeSpectrum.basicOpen (1 - e) : Set _) := by
    rw [← h.compl_eq, hUe, PrimeSpectrum.basicOpen_eq_zeroLocus_compl, compl_compl,
      PrimeSpectrum.zeroLocus_eq_basicOpen_of_isIdempotentElem e he]
  -- Ring isomorphism.
  let φ : R ≃+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                 (R ⧸ Ideal.span ({e} : Set R)) := he.ringEquivQuotientProd
  have hφ : (φ : R →+* (R ⧸ Ideal.span ({1 - e} : Set R)) ×
                       (R ⧸ Ideal.span ({e} : Set R))) = RingHom.quotientProdOneSub e :=
    he.ringEquivQuotientProd_toRingHom
  -- Homeomorphisms.
  exact ⟨e, he, φ, hφ, PrimeSpectrum.exists_homeomorph_quotient_span_one_sub R e he U hUe φ hφ,
    PrimeSpectrum.exists_homeomorph_quotient_span R e he V hVe φ hφ,
    IsLocalization.Away.quotient_of_isIdempotentElem he,
    IsLocalization.away_of_isIdempotentElem he.one_sub (by simp) Ideal.Quotient.mk_surjective⟩

end
