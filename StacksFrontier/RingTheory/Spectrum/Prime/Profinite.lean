/-!
# Rings whose spectrum is profinite

Let `R` be a commutative ring and let `X = Spec(R)` denote its prime spectrum
(`PrimeSpectrum R`), viewed as a topological space with the Zariski topology.
The Zariski topology is generated by the standard (basic) open sets
  `D(f) = { p ∈ Spec(R) | f ∉ p }`,  `f ∈ R`  (Mathlib: `PrimeSpectrum.basicOpen f`).

The following eight conditions on `R` are equivalent:

  1. `X` is profinite: compact (quasi-compact), Hausdorff, and totally disconnected.
  2. `X` is Hausdorff (`T2Space`).
  3. `X` is totally disconnected (`TotallyDisconnectedSpace`).
  4. Every quasi-compact open subset of `X` is closed.
  5. There are no nontrivial inclusions between the prime ideals of `R`:
     for all primes `p, q`, `p ⊆ q` implies `p = q`.
  6. Every prime ideal of `R` is a maximal ideal.
  7. Every prime ideal of `R` is a minimal prime ideal.
  8. Every standard open `D(f) ⊆ X` (for `f ∈ R`) is closed.

## Conventions

"Quasi-compact" in the Stacks terminology is "compact" in Mathlib's. Condition (1) is the
conjunction of `CompactSpace`, `T2Space` and `TotallyDisconnectedSpace` on `PrimeSpectrum R`.

## Main results

* `spec_profinite_tfae`: the eight conditions above are equivalent.
-/

@[expose] public section

open PrimeSpectrum

variable {R : Type*} [CommRing R]

/-- If `Spec R` is Hausdorff, comparable prime ideals of `R` are equal. -/
private theorem eq_of_le_of_t2Space (h : T2Space (PrimeSpectrum R)) :
    ∀ p q : Ideal R, p.IsPrime → q.IsPrime → p ≤ q → p = q := fun p q hp hq hle =>
  congrArg PrimeSpectrum.asIdeal ((le_iff_specializes ⟨p, hp⟩ ⟨q, hq⟩).mp hle).eq

/-- If `Spec R` is totally disconnected, comparable prime ideals of `R` are equal. -/
private theorem eq_of_le_of_totallyDisconnectedSpace
    (h : TotallyDisconnectedSpace (PrimeSpectrum R)) :
    ∀ p q : Ideal R, p.IsPrime → q.IsPrime → p ≤ q → p = q := fun p q hp hq hle =>
  have := h.t1Space
  congrArg PrimeSpectrum.asIdeal ((le_iff_specializes ⟨p, hp⟩ ⟨q, hq⟩).mp hle).eq

/-- If comparable prime ideals of `R` are equal, every prime ideal of `R` is maximal. -/
private theorem isMaximal_of_forall_eq_of_le
    (h : ∀ p q : Ideal R, p.IsPrime → q.IsPrime → p ≤ q → p = q) :
    ∀ p : Ideal R, p.IsPrime → p.IsMaximal := by
  intro p hp
  obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p hp.ne_top
  rwa [h p m hp hm.isPrime hpm]

/-- If every prime ideal of `R` is maximal, every prime ideal of `R` is a minimal prime. -/
private theorem mem_minimalPrimes_of_forall_isMaximal
    (h : ∀ p : Ideal R, p.IsPrime → p.IsMaximal) :
    ∀ p : Ideal R, p.IsPrime → p ∈ minimalPrimes R := by
  intro p hp
  obtain ⟨q, hq, hqp⟩ := Ideal.exists_minimalPrimes_le (J := p) bot_le
  rwa [(h q hq.isPrime).eq_of_le hp.ne_top hqp] at hq

/-- If every prime ideal of `R` is a minimal prime, comparable prime ideals of `R` are equal. -/
private theorem eq_of_le_of_forall_mem_minimalPrimes
    (h : ∀ p : Ideal R, p.IsPrime → p ∈ minimalPrimes R) :
    ∀ p q : Ideal R, p.IsPrime → q.IsPrime → p ≤ q → p = q := by
  intro p q hp hq hle
  have hqm := h q hq
  rw [minimalPrimes_eq_minimals] at hqm
  exact le_antisymm hle (hqm.le_of_le hp hle)

/-- If comparable prime ideals of `R` are equal, every basic open `D(f)` of `Spec R` is
closed. -/
private theorem isClosed_basicOpen_of_forall_eq_of_le
    (h : ∀ p q : Ideal R, p.IsPrime → q.IsPrime → p ≤ q → p = q) :
    ∀ f : R, IsClosed (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) := by
  intro f
  refine isClosed_of_stableUnderSpecialization_of_isConstructible ?_ isConstructible_basicOpen
  intro x y hxy hx
  rwa [← PrimeSpectrum.ext (h x.asIdeal y.asIdeal x.isPrime y.isPrime
    ((le_iff_specializes x y).mpr hxy))]

/-- If every basic open `D(f)` of `Spec R` is closed, `Spec R` is totally separated. -/
private theorem totallySeparatedSpace_of_isClosed_basicOpen
    (h : ∀ f : R, IsClosed (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R))) :
    TotallySeparatedSpace (PrimeSpectrum R) := by
  have hbasis := PrimeSpectrum.isTopologicalBasis_basic_opens (R := R)
  have hsep : ∀ (a b : PrimeSpectrum R) (U : Set (PrimeSpectrum R)),
      IsOpen U → a ∈ U → b ∉ U → ∃ V, IsClopen V ∧ a ∈ V ∧ b ∉ V := by
    intro a b U hU haU hbU
    have hmem : U ∈ nhds a := hU.mem_nhds haU
    rw [hbasis.mem_nhds_iff] at hmem
    obtain ⟨t, ht_mem, hat, htU⟩ := hmem
    obtain ⟨f, hf⟩ := ht_mem
    refine ⟨t, ⟨?_, hbasis.isOpen ⟨f, hf⟩⟩, hat, fun hbt => hbU (htU hbt)⟩
    rw [← hf]
    exact h f
  rw [totallySeparatedSpace_iff_exists_isClopen]
  intro x y hxy
  have ht0 : T0Space (PrimeSpectrum R) := inferInstance
  rw [t0Space_iff_exists_isOpen_xor_mem] at ht0
  obtain ⟨U, hU, hxor⟩ := ht0 hxy
  rw [xor_iff_or_and_not_and] at hxor
  obtain ⟨hor, hnand⟩ := hxor
  rcases hor with hx | hy
  · exact hsep x y U hU hx fun hy => hnand ⟨hx, hy⟩
  · have hxU : x ∉ U := fun hx => hnand ⟨hx, hy⟩
    obtain ⟨V, hVc, hyV, hxV⟩ := hsep y x U hU hy hxU
    refine ⟨Vᶜ, hVc.compl, hxV, ?_⟩
    simp [hyV]

/-- If every basic open `D(f)` of `Spec R` is closed, `Spec R` is compact, Hausdorff and totally
disconnected. -/
private theorem compactSpace_t2Space_totallyDisconnectedSpace_of_isClosed_basicOpen
    (h : ∀ f : R, IsClosed (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R))) :
    CompactSpace (PrimeSpectrum R) ∧ T2Space (PrimeSpectrum R) ∧
      TotallyDisconnectedSpace (PrimeSpectrum R) := by
  have := totallySeparatedSpace_of_isClosed_basicOpen h
  exact ⟨inferInstance, TotallySeparatedSpace.t2Space,
    TotallySeparatedSpace.totallyDisconnectedSpace _⟩

/-- If `Spec R` is profinite, every quasi-compact open of `Spec R` is closed. -/
private theorem isClosed_of_isCompact_of_t2Space
    (h : CompactSpace (PrimeSpectrum R) ∧ T2Space (PrimeSpectrum R) ∧
      TotallyDisconnectedSpace (PrimeSpectrum R)) :
    ∀ U : Set (PrimeSpectrum R), IsOpen U → IsCompact U → IsClosed U := by
  have := h.2.1
  exact fun _ _ hcU => hcU.isClosed

/-- If every quasi-compact open of `Spec R` is closed, `Spec R` is totally disconnected. -/
private theorem totallyDisconnectedSpace_of_forall_isClosed_of_isCompact
    (h : ∀ U : Set (PrimeSpectrum R), IsOpen U → IsCompact U → IsClosed U) :
    TotallyDisconnectedSpace (PrimeSpectrum R) :=
  have := totallySeparatedSpace_of_isClosed_basicOpen fun f =>
    h _ PrimeSpectrum.isOpen_basicOpen (PrimeSpectrum.isCompact_basicOpen f)
  TotallySeparatedSpace.totallyDisconnectedSpace _

/-- For a ring `R` the following are equivalent: `Spec R` is profinite;
`Spec R` is Hausdorff; `Spec R` is totally disconnected; every quasi-compact open of
`Spec R` is closed; there are no nontrivial inclusions between primes of `R`; every prime
of `R` is maximal; every prime of `R` is a minimal prime; every basic open `D(f)` is
closed. -/
@[stacks 04MG]
theorem spec_profinite_tfae (R : Type*) [CommRing R] :
    [ -- (1) X is profinite: compact, Hausdorff, and totally disconnected
      CompactSpace (PrimeSpectrum R) ∧ T2Space (PrimeSpectrum R) ∧
        TotallyDisconnectedSpace (PrimeSpectrum R),
      -- (2) X is Hausdorff
      T2Space (PrimeSpectrum R),
      -- (3) X is totally disconnected
      TotallyDisconnectedSpace (PrimeSpectrum R),
      -- (4) every quasi-compact open subset of X is closed
      ∀ U : Set (PrimeSpectrum R), IsOpen U → IsCompact U → IsClosed U,
      -- (5) no nontrivial inclusions between prime ideals
      ∀ p q : Ideal R, p.IsPrime → q.IsPrime → p ≤ q → p = q,
      -- (6) every prime ideal is maximal
      ∀ p : Ideal R, p.IsPrime → p.IsMaximal,
      -- (7) every prime ideal is a minimal prime
      ∀ p : Ideal R, p.IsPrime → p ∈ minimalPrimes R,
      -- (8) every standard open D(f) is closed
      ∀ f : R, IsClosed (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) ].TFAE := by
  tfae_have 1 → 2 := fun h => h.right.left
  tfae_have 2 → 5 := eq_of_le_of_t2Space
  tfae_have 3 → 5 := eq_of_le_of_totallyDisconnectedSpace
  tfae_have 5 → 6 := isMaximal_of_forall_eq_of_le
  tfae_have 6 → 7 := mem_minimalPrimes_of_forall_isMaximal
  tfae_have 7 → 5 := eq_of_le_of_forall_mem_minimalPrimes
  tfae_have 5 → 8 := isClosed_basicOpen_of_forall_eq_of_le
  tfae_have 8 → 1 := compactSpace_t2Space_totallyDisconnectedSpace_of_isClosed_basicOpen
  tfae_have 1 → 4 := isClosed_of_isCompact_of_t2Space
  tfae_have 4 → 3 := totallyDisconnectedSpace_of_forall_isClosed_of_isCompact
  tfae_finish

end

add_to_stacks 090M "the spectrum of a ring is a spectral space" PrimeSpectrum.instSpectralSpace
