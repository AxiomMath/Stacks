module

public import Mathlib
public import StacksFrontier.LinearAlgebra.Matrix.MinorIdealRank

/-!
# The rank loci of a matrix on the prime spectrum

Let `R` be a commutative ring and let `A` be a matrix over `R` with finitely many rows and
columns.  For a prime `p` of `R` the matrix `A` may be read over the residue field `κ(p)`, and
its rank there is a function of `p`.  This module shows that the loci where that rank is at least
a given number, and where it equals a given number, are constructible subsets of
`PrimeSpectrum R`.

## Main results

* `StacksDraft.MinorRank.zeroLocus_compl_minorIdeal`: the locus where the rank at `p` is at least
  `r` is the complement of the zero locus of the ideal of `r × r` minors of `A`.
* `StacksDraft.MinorRank.isConstructible_le_rank`: that locus is constructible.
* `StacksDraft.MinorRank.isConstructible_rank_eq`: the locus where the rank at `p` equals `r` is
  constructible.

## Implementation notes

Constructibility, rather than mere openness, is what the ideal of minors buys: the ideal is
generated by the finitely many `r × r` minors, so the complement of its zero locus is a
*retrocompact* open by `PrimeSpectrum.isRetrocompact_zeroLocus_compl_of_fg`, and an open
retrocompact set is constructible.  A level set of the rank is the difference of two such opens,
hence constructible by `Topology.IsConstructible.sdiff`.

The identification of the locus itself is the determinantal description of the rank over a field,
`StacksDraft.MinorRank.minorIdeal_eq_top_iff_le_rank`, together with the transfer of the ideal of
minors along the map to the residue field, `StacksDraft.MinorRank.minorIdeal_map`.
-/

@[expose] public section

open Topology

namespace StacksDraft.MinorRank

/-! ### Finite generation of the ideal of minors -/

/-- The ideal of `r × r` minors of a matrix with finitely many rows and columns is finitely
generated: there are only finitely many `r × r` minors. -/
theorem minorIdeal_fg {R : Type*} [CommRing R] {l o : Type*} [Finite l] [Finite o]
    (A : Matrix l o R) (r : ℕ) :
    (minorIdeal A r).FG := by
  classical
  let d : (Fin r → l) × (Fin r → o) → R := fun q => (A.submatrix q.1 q.2).det
  have hs : {x : R | ∃ (f : Fin r → l) (g : Fin r → o), x = (A.submatrix f g).det} =
      Set.range d := by
    ext x
    simp [d, eq_comm]
  rw [minorIdeal, hs]
  exact Submodule.fg_span (Set.finite_range d)

/-! ### The image of an ideal in a residue field -/

/-- An ideal generates the unit ideal of the residue field at a prime exactly when it is not
contained in that prime. -/
theorem map_algebraMap_residueField_eq_top_iff {R : Type*} [CommRing R] (p : Ideal R)
    [p.IsPrime] (I : Ideal R) :
    Ideal.map (algebraMap R p.ResidueField) I = ⊤ ↔ ¬ I ≤ p := by
  refine ⟨fun htop hIp => ?_, fun hIp => ?_⟩
  · have hle : Ideal.map (algebraMap R p.ResidueField) I ≤ ⊥ :=
      Ideal.map_le_iff_le_comap.2 (hIp.trans p.ker_algebraMap_residueField.ge)
    rw [htop] at hle
    exact top_ne_bot (le_bot_iff.1 hle)
  · obtain ⟨x, hxI, hxp⟩ := Set.not_subset.mp hIp
    exact (Ideal.map (algebraMap R p.ResidueField) I).eq_top_of_isUnit_mem
      (Ideal.mem_map_of_mem _ hxI)
      (isUnit_iff_ne_zero.2 (mt Ideal.algebraMap_residueField_eq_zero.1 hxp))

/-! ### The rank loci -/

/-- **The locus where the rank is at least `r`.**  For a matrix `A` over `R`, the set of primes
`p` at which the rank of `A` over the residue field `κ(p)` is at least `r` is the complement of
the zero locus of the ideal `I_r(A)` of `r × r` minors of `A`. -/
theorem zeroLocus_compl_minorIdeal {R : Type*} [CommRing R] {b a : ℕ}
    (A : Matrix (Fin b) (Fin a) R) (r : ℕ) :
    {p : PrimeSpectrum R | r ≤ (A.map (algebraMap R p.asIdeal.ResidueField)).rank} =
      (PrimeSpectrum.zeroLocus (minorIdeal A r : Set R))ᶜ := by
  ext p
  simp only [Set.mem_ofPred_eq, Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus]
  rw [← minorIdeal_eq_top_iff_le_rank, minorIdeal_map,
    map_algebraMap_residueField_eq_top_iff]
  rfl

/-- **The locus where the rank is at least `r` is constructible.**  It is the complement of the
zero locus of the finitely generated ideal `I_r(A)`, hence a retrocompact open. -/
theorem isConstructible_le_rank {R : Type*} [CommRing R] {b a : ℕ}
    (A : Matrix (Fin b) (Fin a) R) (r : ℕ) :
    IsConstructible {p : PrimeSpectrum R |
      r ≤ (A.map (algebraMap R p.asIdeal.ResidueField)).rank} := by
  rw [zeroLocus_compl_minorIdeal]
  exact IsRetrocompact.isConstructible
    (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl
    (PrimeSpectrum.isRetrocompact_zeroLocus_compl_of_fg (minorIdeal_fg A r))

/-- **The locus where the rank equals `r` is constructible.**  It is the difference of the locus
where the rank is at least `r` and the locus where it is at least `r + 1`. -/
theorem isConstructible_rank_eq {R : Type*} [CommRing R] {b a : ℕ}
    (A : Matrix (Fin b) (Fin a) R) (r : ℕ) :
    IsConstructible {p : PrimeSpectrum R |
      (A.map (algebraMap R p.asIdeal.ResidueField)).rank = r} := by
  convert (isConstructible_le_rank A r).sdiff (isConstructible_le_rank A (r + 1)) using 1
  ext p
  simp only [Set.mem_ofPred_eq, Set.mem_sdiff]
  omega

end StacksDraft.MinorRank

end
