module

public import Mathlib
public import StacksFrontier.LinearAlgebra.ExteriorPower.TraceTop
public import StacksFrontier.LinearAlgebra.Matrix.Idempotent

/-!
# The scheme of idempotent matrices

Let `k` be a field and `R = k[{t_{ij}}] / 𝔞`, where `𝔞` is generated by the entries of
`T² - T` for the generic matrix `T = (t_{ij})`. This file treats the geometric part of the
Stacks example 00GG: the irreducible components of `Spec R`.

For a prime `p` of `R` the generic idempotent `T` has an image over the residue field `κ(p)`, and
`rankLocus k n r` is the set of primes at which that image has rank `r`. We show:

* `rankLocus k n r` is closed and open, the loci for `r = 0, …, n` cover `Spec R` and are pairwise
  disjoint, and each of them is irreducible: it is the image of the irreducible scheme `GLₙ`
  under the orbit map `g ↦ g diag(1, …, 1, 0, …, 0) g⁻¹`;
* hence the irreducible components of `Spec R` are exactly the `n + 1` loci `rankLocus k n r`;
* a `k`-point of `Spec R`, that is an idempotent matrix `M` over `k`, lies in `rankLocus k n r`
  exactly when `M` is in the `GLₙ(k)`-orbit of `diag(1, …, 1, 0, …, 0)` with `r` ones;
* the components are separated by polynomial functions: the coefficients of the characteristic
  polynomial of `T` cut out each component, the trace of `T` takes the value `r` on the
  `r`-th one, and `tr(⋀ⁿ T)` takes the value `1` on the component of the identity and `0` on the
  others.
-/

@[expose] public section

open Matrix Polynomial

namespace StacksDraft.IdempotentMatrices

/-! ### The standard idempotents and their characteristic polynomials -/

section Standard

variable (F : Type*) [CommRing F] (n : ℕ)

/-- The polynomial `(X - 1)ʳ Xⁿ⁻ʳ`, the characteristic polynomial of an idempotent of rank `r`. -/
noncomputable def stdCharpoly (r : ℕ) : F[X] := (X - 1) ^ r * X ^ (n - r)

/-- The standard idempotent `diag(1, …, 1, 0, …, 0)` with `r` ones. -/
def stdIdem (r : ℕ) : Matrix (Fin n) (Fin n) F :=
  diagonal fun i => if (i : ℕ) < r then 1 else 0

variable {F n}

lemma map_stdCharpoly {G : Type*} [CommRing G] (f : F →+* G) (r : ℕ) :
    (stdCharpoly F n r).map f = stdCharpoly G n r := by
  simp [stdCharpoly]

lemma stdIdem_mul_self (r : ℕ) : stdIdem F n r * stdIdem F n r = stdIdem F n r := by
  rw [stdIdem, diagonal_mul_diagonal]
  congr 1
  ext i
  split_ifs <;> simp

lemma charpoly_stdIdem {r : ℕ} (hr : r ≤ n) :
    (stdIdem F n r).charpoly = stdCharpoly F n r := by
  rw [stdIdem, charpoly_diagonal, stdCharpoly]
  have h : ∀ i : Fin n, (X - C (if (i : ℕ) < r then (1 : F) else 0)) =
      if (i : ℕ) < r then X - 1 else X := fun i => by split_ifs <;> simp
  simp_rw [h]
  rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const]
  have h1 : (Finset.univ.filter fun i : Fin n => (i : ℕ) < r).card = r := by
    rw [Fin.card_filter_val_lt]; omega
  have h2 := Finset.card_filter_add_card_filter_not
    (s := (Finset.univ : Finset (Fin n))) (fun i : Fin n => (i : ℕ) < r)
  rw [Finset.card_univ, Fintype.card_fin, h1] at h2
  rw [h1, show (Finset.univ.filter fun i : Fin n => ¬ (i : ℕ) < r).card = n - r by omega]

lemma det_stdIdem {r : ℕ} (hr : r ≤ n) :
    (stdIdem F n r).det = if r = n then 1 else 0 := by
  rw [stdIdem, det_diagonal]
  split_ifs with h
  · subst h
    exact Finset.prod_eq_one fun i _ => (ite_eq_left_iff.2 fun h => (h i.2).elim)
  · exact Finset.prod_eq_zero (i := ⟨r, by omega⟩) (Finset.mem_univ _) (by simp)

lemma eq_conj_of_semiconjBy {M D : Matrix (Fin n) (Fin n) F} (c : (Matrix (Fin n) (Fin n) F)ˣ)
    (hc : SemiconjBy (c : Matrix (Fin n) (Fin n) F) M D) :
    M = (↑c⁻¹ : Matrix (Fin n) (Fin n) F) * D * c := by
  rw [mul_assoc, ← hc.eq, ← mul_assoc, Units.inv_mul, one_mul]

lemma charpoly_eq_of_isConj {M D : Matrix (Fin n) (Fin n) F} (h : IsConj M D) :
    M.charpoly = D.charpoly := by
  obtain ⟨c, hc⟩ := h
  rw [eq_conj_of_semiconjBy c hc, Matrix.coe_units_inv, charpoly_units_conj']

lemma det_eq_of_isConj {M D : Matrix (Fin n) (Fin n) F} (h : IsConj M D) : M.det = D.det := by
  obtain ⟨c, hc⟩ := h
  rw [eq_conj_of_semiconjBy c hc, det_mul, det_mul, mul_comm, ← mul_assoc, ← det_mul,
    Units.mul_inv, det_one, one_mul]

/-- The characteristic polynomial of an idempotent matrix over a commutative local ring is
`(X - 1)ʳ Xⁿ⁻ʳ`, where `r` is its rank. -/
lemma charpoly_eq_stdCharpoly_of_mul_self_eq [IsLocalRing F] {M : Matrix (Fin n) (Fin n) F}
    (hM : M * M = M) : M.charpoly = stdCharpoly F n M.rank :=
  (charpoly_eq_of_isConj (isConj_diagonal_of_mul_self_eq hM)).trans
    (charpoly_stdIdem M.rank_le_width)

/-- Over a nontrivial domain, `(X - 1)ʳ Xⁿ⁻ʳ` determines `r ≤ n`. -/
lemma stdCharpoly_injective [IsDomain F] {r s : ℕ} (hr : r ≤ n) (hs : s ≤ n)
    (h : stdCharpoly F n r = stdCharpoly F n s) : r = s := by
  classical
  have key : ∀ t, (stdCharpoly F n t).roots.count 0 = n - t := fun t => by
    have h1 : ((X : F[X]) - 1) ^ t ≠ 0 := pow_ne_zero _ (X_sub_C_ne_zero 1)
    have h2 : (X : F[X]) ^ (n - t) ≠ 0 := pow_ne_zero _ X_ne_zero
    unfold stdCharpoly
    rw [roots_mul (mul_ne_zero h1 h2), ← C_1, roots_pow, roots_X_sub_C, roots_pow,
      roots_X]
    simp
  have := key r
  rw [h, key s] at this
  omega

/-- Over a field, an idempotent matrix has characteristic polynomial `(X - 1)ʳ Xⁿ⁻ʳ` exactly
when its rank is `r`. -/
lemma charpoly_eq_stdCharpoly_iff {K : Type*} [Field K] {M : Matrix (Fin n) (Fin n) K}
    (hM : M * M = M) {r : ℕ} (hr : r ≤ n) :
    M.charpoly = stdCharpoly K n r ↔ M.rank = r := by
  rw [charpoly_eq_stdCharpoly_of_mul_self_eq hM]
  exact ⟨stdCharpoly_injective M.rank_le_width hr, fun h => h ▸ rfl⟩

end Standard

/-! ### The ring `R` and its generic idempotent -/

variable (k : Type*) [Field k] (n : ℕ)

/-- The ideal `𝔞 ⊆ k[{t_{ij}}]` generated by the entries of `T² - T`, `T = (t_{ij})`. -/
noncomputable def idemIdeal : Ideal (MvPolynomial (Fin n × Fin n) k) :=
  Ideal.span (Set.range fun ij : Fin n × Fin n =>
    (mvPolynomialX (Fin n) (Fin n) k * mvPolynomialX (Fin n) (Fin n) k -
      mvPolynomialX (Fin n) (Fin n) k) ij.1 ij.2)

/-- The coordinate ring `R = k[{t_{ij}}] / 𝔞` of the scheme of idempotent `n × n` matrices. -/
abbrev IdemRing : Type _ := MvPolynomial (Fin n × Fin n) k ⧸ idemIdeal k n

/-- The generic idempotent matrix `T = (t_{ij})` over `R`. -/
noncomputable def genericIdem : Matrix (Fin n) (Fin n) (IdemRing k n) :=
  (mvPolynomialX (Fin n) (Fin n) k).map (Ideal.Quotient.mk (idemIdeal k n))

lemma genericIdem_mul_self : genericIdem k n * genericIdem k n = genericIdem k n := by
  rw [← sub_eq_zero]
  have h : genericIdem k n * genericIdem k n - genericIdem k n =
      (Ideal.Quotient.mk (idemIdeal k n)).mapMatrix
        (mvPolynomialX (Fin n) (Fin n) k * mvPolynomialX (Fin n) (Fin n) k -
          mvPolynomialX (Fin n) (Fin n) k) := by
    rw [map_sub, map_mul]; rfl
  rw [h]
  ext i j
  exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨(i, j), rfl⟩)

variable {k n}

/-- The image of the generic idempotent over the residue field `κ(p)` of a prime `p` of `R`. -/
noncomputable def matrixAt (p : PrimeSpectrum (IdemRing k n)) :
    Matrix (Fin n) (Fin n) p.asIdeal.ResidueField :=
  (algebraMap (IdemRing k n) p.asIdeal.ResidueField).mapMatrix (genericIdem k n)

lemma matrixAt_mul_self (p : PrimeSpectrum (IdemRing k n)) :
    matrixAt p * matrixAt p = matrixAt p := by
  rw [matrixAt, ← map_mul, genericIdem_mul_self]

variable (k n)

/-- The locus of primes `p` of `R` at which the generic idempotent has rank `r` over `κ(p)`. -/
def rankLocus (r : ℕ) : Set (PrimeSpectrum (IdemRing k n)) :=
  {p | (matrixAt p).rank = r}

/-- The coefficients of `charpoly T - (X - 1)ʳ Xⁿ⁻ʳ`, polynomial functions of the `t_{ij}`. -/
noncomputable def charpolyEqns (r : ℕ) : Set (IdemRing k n) :=
  Set.range fun i => ((genericIdem k n).charpoly - stdCharpoly (IdemRing k n) n r).coeff i

/-- The rank locus `rankLocus k n r` is the zero locus of the coefficients of
`charpoly T - (X - 1)ʳ Xⁿ⁻ʳ`. -/
theorem rankLocus_eq_zeroLocus {r : ℕ} (hr : r ≤ n) :
    rankLocus k n r = PrimeSpectrum.zeroLocus (charpolyEqns k n r) := by
  ext p
  rw [PrimeSpectrum.mem_zeroLocus, charpolyEqns, Set.range_subset_iff, rankLocus,
    Set.mem_ofPred_eq, ← charpoly_eq_stdCharpoly_iff (matrixAt_mul_self p) hr, matrixAt,
    RingHom.mapMatrix_apply, charpoly_map, ← map_stdCharpoly
      (algebraMap (IdemRing k n) p.asIdeal.ResidueField), ← sub_eq_zero, ← Polynomial.map_sub,
    Polynomial.ext_iff]
  simp only [coeff_map, coeff_zero, SetLike.mem_coe, Ideal.algebraMap_residueField_eq_zero]

theorem isClosed_rankLocus {r : ℕ} (hr : r ≤ n) : IsClosed (rankLocus k n r) := by
  rw [rankLocus_eq_zeroLocus k n hr]
  exact PrimeSpectrum.isClosed_zeroLocus _

theorem mem_rankLocus_rank (p : PrimeSpectrum (IdemRing k n)) :
    p ∈ rankLocus k n (matrixAt p).rank := rfl

theorem rankLocus_eq_empty {r : ℕ} (hr : n < r) : rankLocus k n r = ∅ :=
  Set.eq_empty_of_forall_notMem fun p hp => by
    have := (matrixAt p).rank_le_width
    rw [hp.out] at this
    omega

/-- The rank loci for `r = 0, …, n` cover `Spec R`. -/
theorem iUnion_rankLocus : ⋃ r ∈ Finset.range (n + 1), rankLocus k n r = Set.univ :=
  Set.eq_univ_of_forall fun p => Set.mem_biUnion
    (Finset.mem_range.2 (Nat.lt_succ_of_le (matrixAt p).rank_le_width)) (mem_rankLocus_rank k n p)

/-- Distinct rank loci are disjoint. -/
theorem disjoint_rankLocus {r s : ℕ} (h : r ≠ s) : Disjoint (rankLocus k n r) (rankLocus k n s) :=
  Set.disjoint_left.2 fun _ hr hs => h (hr.out.symm.trans hs.out)

theorem isClopen_rankLocus {r : ℕ} (hr : r ≤ n) : IsClopen (rankLocus k n r) := by
  refine ⟨isClosed_rankLocus k n hr, ?_⟩
  have : (rankLocus k n r)ᶜ = ⋃ s ∈ (Finset.range (n + 1)).erase r, rankLocus k n s := by
    ext p
    simp only [Set.mem_compl_iff, Set.mem_iUnion, Finset.mem_erase, Finset.mem_range,
      exists_prop]
    refine ⟨fun hp => ⟨(matrixAt p).rank, ⟨fun h => hp (h ▸ mem_rankLocus_rank k n p),
      Nat.lt_succ_of_le (matrixAt p).rank_le_width⟩, mem_rankLocus_rank k n p⟩, ?_⟩
    rintro ⟨s, ⟨hsr, -⟩, hs⟩ hp
    exact Set.disjoint_left.1 (disjoint_rankLocus k n hsr) hs hp
  rw [← isClosed_compl_iff, this]
  exact Set.Finite.isClosed_biUnion (Finset.finite_toSet _) fun s hs =>
    isClosed_rankLocus k n (Nat.lt_succ_iff.1 (Finset.mem_range.1 (Finset.mem_of_mem_erase hs)))

/-! ### The orbit map from `GLₙ` -/

/-- The coordinate ring `k[{x_{ij}}, det⁻¹]` of `GLₙ`. -/
abbrev GLRing : Type _ := Localization.Away (mvPolynomialX (Fin n) (Fin n) k).det

lemma isUnit_det_genericGL :
    IsUnit ((algebraMap (MvPolynomial (Fin n × Fin n) k) (GLRing k n)).mapMatrix
      (mvPolynomialX (Fin n) (Fin n) k)).det := by
  rw [← RingHom.map_det]
  exact IsLocalization.Away.algebraMap_isUnit _

/-- The generic invertible matrix over the coordinate ring of `GLₙ`. -/
noncomputable def genericGL : (Matrix (Fin n) (Fin n) (GLRing k n))ˣ :=
  ((Matrix.isUnit_iff_isUnit_det _).2 (isUnit_det_genericGL k n)).unit

lemma coe_genericGL : (genericGL k n : Matrix (Fin n) (Fin n) (GLRing k n)) =
    (algebraMap (MvPolynomial (Fin n × Fin n) k) (GLRing k n)).mapMatrix
      (mvPolynomialX (Fin n) (Fin n) k) := rfl

/-- The `GLₙ`-conjugate `g diag(1, …, 1, 0, …, 0) g⁻¹` of the standard idempotent of rank `r` by
the generic invertible matrix. -/
noncomputable def orbitMatrix (r : ℕ) : Matrix (Fin n) (Fin n) (GLRing k n) :=
  (genericGL k n : Matrix _ _ _) * stdIdem _ n r * (↑(genericGL k n)⁻¹ : Matrix _ _ _)

lemma orbitMatrix_mul_self (r : ℕ) : orbitMatrix k n r * orbitMatrix k n r = orbitMatrix k n r := by
  simp only [orbitMatrix, mul_assoc, Units.inv_mul_cancel_left]
  rw [← mul_assoc (stdIdem (GLRing k n) n r), stdIdem_mul_self]

/-- The orbit map `GLₙ → Spec R`, `g ↦ g diag(1, …, 1, 0, …, 0) g⁻¹`, on coordinate rings. -/
noncomputable def orbitHom (r : ℕ) : IdemRing k n →+* GLRing k n :=
  Ideal.Quotient.lift (idemIdeal k n)
    (MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin n × Fin n) k) (GLRing k n)).comp
      MvPolynomial.C) fun ij => orbitMatrix k n r ij.1 ij.2) (by
    have hX : (MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin n × Fin n) k)
        (GLRing k n)).comp MvPolynomial.C) fun ij => orbitMatrix k n r ij.1 ij.2).mapMatrix
          (mvPolynomialX (Fin n) (Fin n) k) = orbitMatrix k n r := by
      ext i j; simp
    intro a ha
    refine (Ideal.span_le (I := RingHom.ker _)).2 ?_ ha
    rintro _ ⟨⟨i, j⟩, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    have := congrFun (congrFun (congrArg (fun A => A) (show
      (MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin n × Fin n) k)
        (GLRing k n)).comp MvPolynomial.C) fun ij => orbitMatrix k n r ij.1 ij.2).mapMatrix
          (mvPolynomialX (Fin n) (Fin n) k * mvPolynomialX (Fin n) (Fin n) k -
            mvPolynomialX (Fin n) (Fin n) k) = 0 by
        rw [map_sub, map_mul, hX, orbitMatrix_mul_self, sub_self])) i) j
    simpa using this)

lemma mapMatrix_orbitHom_genericIdem (r : ℕ) :
    (orbitHom k n r).mapMatrix (genericIdem k n) = orbitMatrix k n r := by
  ext i j
  simp [genericIdem, orbitHom]

instance : IsDomain (GLRing k n) :=
  IsLocalization.isDomain_localization
    (powers_le_nonZeroDivisors_of_noZeroDivisors (det_mvPolynomialX_ne_zero (Fin n) k))

/-- The rank locus `rankLocus k n r` (for `r ≤ n`) is the image of `GLₙ` under the orbit map
`g ↦ g diag(1, …, 1, 0, …, 0) g⁻¹`. -/
theorem range_comap_orbitHom {r : ℕ} (hr : r ≤ n) :
    Set.range (PrimeSpectrum.comap (orbitHom k n r)) = rankLocus k n r := by
  apply subset_antisymm
  · rintro _ ⟨q, rfl⟩
    rw [rankLocus_eq_zeroLocus k n hr, PrimeSpectrum.mem_zeroLocus, charpolyEqns,
      Set.range_subset_iff]
    intro i
    rw [SetLike.mem_coe, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    have h0 : ((genericIdem k n).charpoly - stdCharpoly (IdemRing k n) n r).map
        (orbitHom k n r) = 0 := by
      rw [Polynomial.map_sub, ← charpoly_map, ← RingHom.mapMatrix_apply,
        mapMatrix_orbitHom_genericIdem, map_stdCharpoly, orbitMatrix, Matrix.coe_units_inv,
        charpoly_units_conj,
        charpoly_stdIdem hr, sub_self]
    have := congrArg (fun P => P.coeff i) h0
    simp only [coeff_map, coeff_zero] at this
    rw [this]
    exact q.asIdeal.zero_mem
  · intro p hp
    let κ := p.asIdeal.ResidueField
    obtain ⟨c, hc⟩ := isConj_diagonal_of_mul_self_eq (matrixAt_mul_self p)
    have hrank : (matrixAt p).rank = r := hp
    rw [hrank] at hc
    -- the point `g = c⁻¹` of `GLₙ` over `κ(p)`
    let g : (Matrix (Fin n) (Fin n) κ)ˣ := c⁻¹
    let χ₀ : MvPolynomial (Fin n × Fin n) k →+* κ :=
      MvPolynomial.eval₂Hom ((algebraMap (IdemRing k n) κ).comp
        ((Ideal.Quotient.mk (idemIdeal k n)).comp MvPolynomial.C))
        fun ij => (g : Matrix _ _ κ) ij.1 ij.2
    have hχ₀X : χ₀.mapMatrix (mvPolynomialX (Fin n) (Fin n) k) = g := by
      ext i j; simp [χ₀]
    have hdet : IsUnit (χ₀ (mvPolynomialX (Fin n) (Fin n) k).det) := by
      rw [RingHom.map_det, hχ₀X]
      exact (Matrix.isUnit_iff_isUnit_det _).1 g.isUnit
    let χ : GLRing k n →+* κ := IsLocalization.Away.lift _ hdet
    have hχ : χ.comp (algebraMap _ (GLRing k n)) = χ₀ := IsLocalization.Away.lift_comp _ hdet
    have hχG : Units.map χ.mapMatrix.toMonoidHom (genericGL k n) = g := by
      ext1
      rw [Units.coe_map, ← hχ₀X, ← hχ, coe_genericGL]
      rfl
    have hχM : χ.mapMatrix (orbitMatrix k n r) = matrixAt p := by
      have h1 : χ.mapMatrix (orbitMatrix k n r) =
          ((Units.map χ.mapMatrix.toMonoidHom (genericGL k n) : (Matrix (Fin n) (Fin n) κ)ˣ) :
            Matrix (Fin n) (Fin n) κ) * χ.mapMatrix (stdIdem _ n r) *
            ((Units.map χ.mapMatrix.toMonoidHom (genericGL k n)⁻¹ : (Matrix (Fin n) (Fin n) κ)ˣ) :
              Matrix (Fin n) (Fin n) κ) := by
        rw [orbitMatrix, map_mul, map_mul, Units.coe_map, Units.coe_map]
        rfl
      rw [map_inv, hχG] at h1
      have h2 : χ.mapMatrix (stdIdem (GLRing k n) n r) = stdIdem κ n r := by
        ext i j
        simp only [stdIdem, RingHom.mapMatrix_apply, map_apply, diagonal_apply]
        split_ifs <;> simp
      rw [h1, h2]
      simp only [g, inv_inv]
      exact (eq_conj_of_semiconjBy c hc).symm
    have hcomp : χ.comp (orbitHom k n r) = algebraMap (IdemRing k n) κ := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, orbitHom, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
        rw [← RingHom.comp_apply χ, hχ]
        simp [χ₀]
      · rintro ⟨i, j⟩
        have := congrFun (congrFun hχM i) j
        simp only [RingHom.comp_apply, orbitHom, Ideal.Quotient.lift_mk,
          MvPolynomial.eval₂Hom_X']
        simpa [matrixAt, genericIdem] using this
    refine ⟨⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩, PrimeSpectrum.ext ?_⟩
    rw [PrimeSpectrum.comap_asIdeal, RingHom.comap_ker, hcomp, Ideal.ker_algebraMap_residueField]

/-- Each rank locus `rankLocus k n r` with `r ≤ n` is irreducible. -/
theorem isIrreducible_rankLocus {r : ℕ} (hr : r ≤ n) : IsIrreducible (rankLocus k n r) := by
  rw [← range_comap_orbitHom k n hr, ← Set.image_univ]
  exact (IrreducibleSpace.isIrreducible_univ _).image _
    (PrimeSpectrum.continuous_comap (orbitHom k n r)).continuousOn

/-- An irreducible subset of `Spec R` lies in one of the rank loci. -/
lemma exists_subset_rankLocus {Z : Set (PrimeSpectrum (IdemRing k n))} (hZ : IsIrreducible Z) :
    ∃ s ≤ n, Z ⊆ rankLocus k n s := by
  classical
  obtain ⟨_, ht, hZt⟩ := (isIrreducible_iff_sUnion_isClosed.1 hZ)
    ((Finset.range (n + 1)).image (rankLocus k n))
    (by
      intro z hz
      obtain ⟨s, hs, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
      exact isClosed_rankLocus k n (Nat.lt_succ_iff.1 (Finset.mem_range.1 hs)))
    (by
      rw [Finset.coe_image, Set.sUnion_image]
      intro p _
      exact Set.mem_biUnion (Finset.mem_coe.2 (Finset.mem_range.2
        (Nat.lt_succ_of_le (matrixAt p).rank_le_width))) (mem_rankLocus_rank k n p))
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.1 ht
  exact ⟨s, Nat.lt_succ_iff.1 (Finset.mem_range.1 hs), hZt⟩

/-- **The irreducible components of the scheme of idempotent matrices.** The irreducible
components of `Spec R` are exactly the `n + 1` rank loci `rankLocus k n r`, `0 ≤ r ≤ n`; each
is the image of `GLₙ` under the orbit map (`range_comap_orbitHom`), and they are open, closed and
pairwise disjoint (`isClopen_rankLocus`, `disjoint_rankLocus`). -/
@[stacks 00GG "the irreducible components of Spec R are the n + 1 orbit loci of \
diag(1, …, 1, 0, …, 0), pairwise disjoint"]
theorem irreducibleComponents_eq :
    irreducibleComponents (PrimeSpectrum (IdemRing k n)) =
      {Z | ∃ r ≤ n, Z = rankLocus k n r} := by
  ext Z
  constructor
  · intro hZ
    obtain ⟨s, hs, hZs⟩ := exists_subset_rankLocus k n hZ.1
    exact ⟨s, hs, ((hZ.2 (isIrreducible_rankLocus k n hs) hZs).antisymm hZs).symm⟩
  · rintro ⟨r, hr, rfl⟩
    refine ⟨isIrreducible_rankLocus k n hr, fun T hT hsub => ?_⟩
    obtain ⟨s, -, hTs⟩ := exists_subset_rankLocus k n hT
    obtain ⟨p, hp⟩ := (isIrreducible_rankLocus k n hr).nonempty
    have hrs : r = s := hp.out.symm.trans (hTs (hsub hp)).out
    exact hrs ▸ hTs

/-! ### The `k`-points and the `GLₙ(k)`-orbits -/

/-- The `k`-point of `Spec R` given by an idempotent matrix `M` over `k`: the kernel of
evaluation `t_{ij} ↦ M_{ij}`. -/
noncomputable def evalHom {M : Matrix (Fin n) (Fin n) k} (hM : M * M = M) : IdemRing k n →+* k :=
  Ideal.Quotient.lift (idemIdeal k n) (MvPolynomial.eval fun ij => M ij.1 ij.2) (by
    intro a ha
    refine (Ideal.span_le (I := RingHom.ker _)).2 ?_ ha
    rintro _ ⟨⟨i, j⟩, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    have hX : (MvPolynomial.eval fun ij : Fin n × Fin n => M ij.1 ij.2).mapMatrix
        (mvPolynomialX (Fin n) (Fin n) k) = M := by
      ext i j; simp
    have := congrFun (congrFun (show (MvPolynomial.eval fun ij : Fin n × Fin n =>
        M ij.1 ij.2).mapMatrix (mvPolynomialX (Fin n) (Fin n) k * mvPolynomialX (Fin n) (Fin n) k -
          mvPolynomialX (Fin n) (Fin n) k) = 0 by rw [map_sub, map_mul, hX, hM, sub_self]) i) j
    simpa using this)

/-- The `k`-point of `Spec R` corresponding to an idempotent matrix `M` over `k`. -/
noncomputable def point {M : Matrix (Fin n) (Fin n) k} (hM : M * M = M) :
    PrimeSpectrum (IdemRing k n) :=
  ⟨RingHom.ker (evalHom k n hM), RingHom.ker_isPrime _⟩

/-- **The orbits are the `k`-points of the components.** The `k`-point of an idempotent matrix
`M` lies in the component `rankLocus k n r` exactly when `M` is in the `GLₙ(k)`-orbit
`{g D g⁻¹}` of the standard idempotent `D = diag(1, …, 1, 0, …, 0)` with `r` ones. -/
@[stacks 00GG "the k-points of the component rankLocus k n r form the GLₙ(k)-orbit of \
diag(1, …, 1, 0, …, 0) with r ones"]
theorem point_mem_rankLocus_iff {M : Matrix (Fin n) (Fin n) k} (hM : M * M = M) {r : ℕ}
    (hr : r ≤ n) : point k n hM ∈ rankLocus k n r ↔ IsConj M (stdIdem k n r) := by
  let p := point k n hM
  let κ := p.asIdeal.ResidueField
  let f : k →+* κ := (algebraMap (IdemRing k n) κ).comp
    ((Ideal.Quotient.mk (idemIdeal k n)).comp MvPolynomial.C)
  have hmat : matrixAt p = f.mapMatrix M := by
    ext i j
    simp only [matrixAt, genericIdem, RingHom.mapMatrix_apply, map_apply, mvPolynomialX_apply, f,
      RingHom.comp_apply]
    rw [← sub_eq_zero, ← RingHom.map_sub, Ideal.algebraMap_residueField_eq_zero]
    change _ ∈ RingHom.ker (evalHom k n hM)
    simp [RingHom.mem_ker, evalHom]
  have hiff : point k n hM ∈ rankLocus k n r ↔ M.charpoly = stdCharpoly k n r := by
    change (matrixAt p).rank = r ↔ _
    rw [← charpoly_eq_stdCharpoly_iff (matrixAt_mul_self p) hr, hmat, RingHom.mapMatrix_apply,
      charpoly_map, ← map_stdCharpoly f]
    exact (Polynomial.map_injective f f.injective).eq_iff
  rw [hiff, charpoly_eq_stdCharpoly_iff hM hr]
  constructor
  · rintro rfl
    exact isConj_diagonal_of_mul_self_eq hM
  · intro hconj
    exact (charpoly_eq_stdCharpoly_iff hM hr).1
      ((charpoly_eq_of_isConj hconj).trans (charpoly_stdIdem hr))

/-! ### Functions separating the components -/

/-- The coefficients of the characteristic polynomial of `T`, which are polynomials in the
`t_{ij}`, separate the components in every characteristic: on `rankLocus k n r` the polynomial
`charpoly T` takes the value `(X - 1)ʳ Xⁿ⁻ʳ`, and these values are distinct for distinct
`r ≤ n`. -/
@[stacks 00GG "in every characteristic the components are separated by polynomial functions, the \
coefficients of the characteristic polynomial of T"]
theorem charpoly_separates {r s : ℕ} (hr : r ≤ n) (hs : s ≤ n) (hrs : r ≠ s) :
    (∀ p ∈ rankLocus k n r, ∀ i,
      (genericIdem k n).charpoly.coeff i - (stdCharpoly (IdemRing k n) n r).coeff i ∈ p.asIdeal) ∧
    stdCharpoly k n r ≠ stdCharpoly k n s := by
  refine ⟨fun p hp i => ?_, fun h => hrs (stdCharpoly_injective hr hs h)⟩
  rw [rankLocus_eq_zeroLocus k n hr] at hp
  rw [← Polynomial.coeff_sub]
  exact hp ⟨i, rfl⟩

/-- On the component `rankLocus k n r` the trace `t₁₁ + ⋯ + tₙₙ` takes the value `r`. In
characteristic `0` these values are distinct, so the trace separates the components. -/
theorem trace_separates {r : ℕ} (p : PrimeSpectrum (IdemRing k n)) (hp : p ∈ rankLocus k n r) :
    (genericIdem k n).trace - (r : IdemRing k n) ∈ p.asIdeal := by
  rw [← Ideal.algebraMap_residueField_eq_zero, RingHom.map_sub, map_natCast, sub_eq_zero]
  have := Matrix.trace_eq_rank_of_isIdempotentElem (matrixAt p) (matrixAt_mul_self p)
  rw [hp.out] at this
  exact (AddMonoidHom.map_trace (algebraMap (IdemRing k n) p.asIdeal.ResidueField).toAddMonoidHom
    (genericIdem k n)).trans this

/-- In characteristic `0` the trace `f = t₁₁ + ⋯ + tₙₙ` separates the components: it takes the
value `r` on `rankLocus k n r` and the value `s` on `rankLocus k n s`, and `r ≠ s` in `k`. -/
@[stacks 00GG "in characteristic 0 the trace takes the distinct values r on the distinct \
components"]
theorem trace_separates_of_charZero [CharZero k] {r s : ℕ} (hrs : r ≠ s)
    {p q : PrimeSpectrum (IdemRing k n)} (hp : p ∈ rankLocus k n r) (hq : q ∈ rankLocus k n s) :
    (genericIdem k n).trace - algebraMap k (IdemRing k n) r ∈ p.asIdeal ∧
      (genericIdem k n).trace - algebraMap k (IdemRing k n) s ∈ q.asIdeal ∧ (r : k) ≠ (s : k) :=
  ⟨by simpa using trace_separates k n p hp, by simpa using trace_separates k n q hq,
    Nat.cast_injective.ne hrs⟩

/-- In characteristic `3` the trace of the identity matrix `diag(1, 1, 1)` is `3 = 0`, the value
the trace also takes at the zero matrix: the trace does not separate these components. -/
theorem trace_one_fin_three_eq_zero [CharP k 3] : (1 : Matrix (Fin 3) (Fin 3) k).trace = 0 := by
  rw [Matrix.trace_one, Fintype.card_fin]
  exact_mod_cast CharP.cast_eq_zero k 3

/-- On the component `rankLocus k n r` the function `tr(⋀ⁿ T)` (the trace of the top exterior
power of `T`) takes the value `1` if `r = n`, i.e. on the component of `diag(1, …, 1)`, and `0`
on every other component. This holds in every characteristic; for `n = 3` it is the function
`tr(⋀³ T)` of the example, which in characteristic `3` separates the component of
`diag(1, 1, 1)` although the trace vanishes there. -/
theorem trace_exteriorPower_separates {r : ℕ} (hr : r ≤ n) (p : PrimeSpectrum (IdemRing k n))
    (hp : p ∈ rankLocus k n r) :
    LinearMap.trace (IdemRing k n) _ (exteriorPower.map n (Matrix.toLin' (genericIdem k n))) -
      (if r = n then 1 else 0) ∈ p.asIdeal := by
  rw [exteriorPower.trace_map_toLin'_eq_det, ← Ideal.algebraMap_residueField_eq_zero,
    RingHom.map_sub, sub_eq_zero, RingHom.map_det]
  change (matrixAt p).det = _
  have hc := isConj_diagonal_of_mul_self_eq (matrixAt_mul_self p)
  rw [hp.out] at hc
  rw [(det_eq_of_isConj hc).trans (det_stdIdem hr)]
  split_ifs <;> simp

/-- For `n = 3`, the function `tr(⋀³ T)` takes the value `1` on the component of `diag(1, 1, 1)`
and `0` on the other components, in every characteristic and in particular in characteristic
`3`, where the trace `tr T` vanishes on the component of `diag(1, 1, 1)` as on that of `0`. -/
@[stacks 00GG "for n = 3, tr(⋀³T) is 1 on the component of diag(1, 1, 1) and 0 on the others, \
in every characteristic, in particular in characteristic 3"]
theorem trace_exteriorPower_three_separates {r : ℕ} (hr : r ≤ 3)
    (p : PrimeSpectrum (IdemRing k 3)) (hp : p ∈ rankLocus k 3 r) :
    LinearMap.trace (IdemRing k 3) _ (exteriorPower.map 3 (Matrix.toLin' (genericIdem k 3))) -
      (if r = 3 then 1 else 0) ∈ p.asIdeal :=
  trace_exteriorPower_separates k 3 hr p hp

/-- The components are cut out by idempotent functions: for each `r ≤ n` there is an idempotent
`e ∈ R` taking the value `1` on `rankLocus k n r` and `0` on its complement. -/
theorem exists_idempotent_separates {r : ℕ} (hr : r ≤ n) :
    ∃ e : IdemRing k n, IsIdempotentElem e ∧
      ∀ p : PrimeSpectrum (IdemRing k n),
        (p ∈ rankLocus k n r → e - 1 ∈ p.asIdeal) ∧ (p ∉ rankLocus k n r → e ∈ p.asIdeal) := by
  obtain ⟨e, he, hZ⟩ := PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen
    (isClopen_rankLocus k n hr)
  refine ⟨e, he, fun p => ⟨fun hp => ?_, fun hp => ?_⟩⟩
  · rw [hZ] at hp
    have h0 : e * (e - 1) ∈ p.asIdeal := by
      rw [mul_sub, mul_one, he.eq, sub_self]; exact p.asIdeal.zero_mem
    exact (p.isPrime.mem_or_mem h0).resolve_left hp
  · rw [hZ] at hp
    simpa [PrimeSpectrum.mem_basicOpen] using hp

end StacksDraft.IdempotentMatrices
