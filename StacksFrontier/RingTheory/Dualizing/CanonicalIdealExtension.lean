/-!
# Extending an ideal which is a dualizing module

Let `B → C` be an injective map of domains and `J ⊆ B` a nonzero ideal. This file gives two
situations in which the extended ideal `J C` is a dualizing module of `C`
([Stacks, Remark 0B4R] for the terminology). Both are steps of the proof of [Stacks, Tag 0BBV]:
there `J ≅ ω_A` is the dualizing module of the base, and the claim is propagated along a chain of
normalized blowups.

## Main results

* `Stacks.Duality.isDualizingRingModule_of_linearEquiv`: being a dualizing module is invariant
  under linear isomorphism.
* `Stacks.Duality.nonempty_linearEquiv_self_of_isGorensteinLocalRing`: over a Gorenstein local
  ring, every dualizing module is isomorphic to the ring.
* `Stacks.Duality.isDualizingRingModule_map_of_surjective`: if some dualizing module `ω` of `C`
  is a quotient of `C ⊗_B J`, then `J C ≅ ω`, so `J C` is a dualizing module of `C`.
* `Stacks.Duality.isDualizingRingModule_map_of_isRegularLocalRing`: if `B` and `C` are regular
  local rings and `J` is a dualizing module of `B`, then `J C` is a dualizing module of `C`.

## The arguments

For the first statement: the kernel of the multiplication map `C ⊗_B J → C` is the torsion
submodule, and its image is `J C`. A dualizing module of a Noetherian domain is torsion free
([Stacks, Tag 0AWK]), so the surjection `C ⊗_B J → ω` factors through a surjection `J C → ω`.
Such a surjection is injective: if `x ∈ J C` maps to zero then for every `y ∈ J C` we have
`x φ(y) = φ(x y) = φ(y x) = y φ(x) = 0`, so `x` kills the nonzero torsion free module `ω`.

For the second statement: a regular local ring is Gorenstein ([Stacks, Tag 0AWX]), and over a
Gorenstein local ring two dualizing complexes differ by a shift (uniqueness of normalized
dualizing complexes, [Stacks, Tag 0A83]), so `J ≅ B`. Hence `J = (b)` with `b ≠ 0`, `J C` is the
principal ideal generated by the nonzero image of `b`, which is isomorphic to `C`, and `C` is
Gorenstein.

## References

* [Stacks Project, Tag 0B4R](https://stacks.math.columbia.edu/tag/0B4R)
* [Stacks Project, Tag 0BBV](https://stacks.math.columbia.edu/tag/0BBV)
* [Stacks Project, Tag 0AWK](https://stacks.math.columbia.edu/tag/0AWK)
* [Stacks Project, Tag 0AWX](https://stacks.math.columbia.edu/tag/0AWX)
* [Stacks Project, Tag 0A83](https://stacks.math.columbia.edu/tag/0A83)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace Stacks.Duality

/-- **Being a dualizing module is invariant under linear isomorphism.** -/
theorem isDualizingRingModule_of_linearEquiv {A : Type u} [CommRing A] [IsNoetherianRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (hM : IsDualizingRingModule A M) (e : M ≃ₗ[A] N) : IsDualizingRingModule A N := by
  obtain ⟨hfin, n, hn⟩ := hM
  exact ⟨Module.Finite.equiv e, n, (Dualizing.isDualizingComplex_iff_of_iso
    ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).mapIso e.toModuleIso)).mp hn⟩

/-- **Over a Gorenstein local ring every dualizing module is isomorphic to the ring.** Shifting
`M[n]` and `A[0]` to normalized dualizing complexes, the two become isomorphic
([Stacks, Tag 0A83]); so `M` in a single degree is isomorphic to `A` in a single degree, the
degrees agree since `M ≠ 0`, and taking cohomology gives `M ≅ A`. -/
theorem nonempty_linearEquiv_self_of_isGorensteinLocalRing {A : Type u} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] (hA : Dualizing.IsGorensteinLocalRing A)
    {M : Type u} [AddCommGroup M] [Module A M] (hM : IsDualizingRingModule A M) :
    Nonempty (M ≃ₗ[A] A) := by
  have : Nontrivial M := IsDualizingRingModule.nontrivial (M := ModuleCat.of A M) hM
  obtain ⟨-, n, hn⟩ := hM
  obtain ⟨m₁, hm₁⟩ := Dualizing.exists_isNormalizedDualizingComplex_shift.{u, u} _ hn
  obtain ⟨m₂, hm₂⟩ := Dualizing.exists_isNormalizedDualizingComplex_shift.{u, u} _ hA
  obtain ⟨e⟩ := Dualizing.IsNormalizedDualizingComplex.nonempty_iso hm₁ hm₂
  obtain ⟨k, ⟨e'⟩⟩ : ∃ k : ℤ, Nonempty
      ((DerivedCategory.singleFunctor (ModuleCat.{u} A) k).obj (ModuleCat.of A M) ≅
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) m₂).obj (ModuleCat.of A A)) :=
    ⟨n + m₁, ⟨(((DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso (-m₁) (n + m₁) n
        (by ring)).app _).symm ≪≫ e ≪≫
      ((DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso (-m₂) m₂ 0 (by ring)).app _⟩⟩
  obtain ⟨hvan, ⟨eH⟩⟩ := (Dualizing.exists_iso_single_iff_homology _ _ m₂).mp ⟨e'⟩
  let eM := (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} A) k).app
    (ModuleCat.of A M)
  by_cases hk : k = m₂
  · subst hk
    exact ⟨(eM.symm ≪≫ eH).toLinearEquiv⟩
  · exact absurd (ModuleCat.isZero_iff_subsingleton.mp ((hvan k hk).of_iso eM.symm))
      (not_subsingleton M)

/-- **An extended ideal mapping onto a dualizing module is that dualizing module.** Let `B → C`
be an injective map of domains with `C` Noetherian, `J ≠ 0` an ideal of `B`, and `ω` a dualizing
module of `C` which is a quotient of `C ⊗_B J`. Then `J C` is a dualizing module of `C`; in fact
`J C ≅ ω`. -/
theorem isDualizingRingModule_map_of_surjective {B C : Type u} [CommRing B] [CommRing C]
    [IsDomain B] [IsDomain C] [IsNoetherianRing C] [Algebra B C]
    (hinj : Function.Injective (algebraMap B C)) (J : Ideal B) (hJ : J ≠ ⊥) (ω : Type u)
    [AddCommGroup ω] [Module C ω] (hω : IsDualizingRingModule C ω) (g : C ⊗[B] J →ₗ[C] ω)
    (hg : Function.Surjective g) :
    IsDualizingRingModule C (J.map (algebraMap B C)) := by
  have : Module.IsTorsionFree C ω := IsDualizingRingModule.isTorsionFree hω
  have : Nontrivial ω := by
    by_contra hsub
    rw [not_nontrivial_iff_subsingleton] at hsub
    have h1 := Dualizing.finrank_localizedModule_eq_one_of_isDualizingRingModule hω
    have : Subsingleton (LocalizedModule (nonZeroDivisors C) ω) := by
      refine ⟨fun y z => ?_⟩
      induction y using LocalizedModule.induction_on with
      | h x s =>
        induction z using LocalizedModule.induction_on with
        | h x' s' =>
          rw [Subsingleton.elim x 0, Subsingleton.elim x' 0, LocalizedModule.zero_mk,
            LocalizedModule.zero_mk]
    rw [Module.finrank_zero_of_subsingleton] at h1
    exact zero_ne_one h1
  -- `g` kills the torsion, which is the kernel of the multiplication map.
  have hle : LinearMap.ker (Dualizing.idealTensorMul (C := C) J) ≤ LinearMap.ker g := by
    rw [Dualizing.ker_idealTensorMul hinj J hJ]
    intro z hz
    obtain ⟨⟨r, hr⟩, hrz⟩ := hz
    rw [LinearMap.mem_ker]
    have h0 : r • g z = 0 := by
      rw [← map_smul]
      exact (congrArg g hrz).trans (map_zero g)
    exact (smul_eq_zero.mp h0).resolve_left (nonZeroDivisors.ne_zero hr)
  -- The induced surjection `J C → ω`.
  let eI : ((C ⊗[B] J) ⧸ LinearMap.ker (Dualizing.idealTensorMul (C := C) J)) ≃ₗ[C]
      (J.map (algebraMap B C) : Submodule C C) :=
    (LinearMap.quotKerEquivRange _).trans
      (LinearEquiv.ofEq _ _ (Dualizing.range_idealTensorMul J))
  let φ : (J.map (algebraMap B C) : Submodule C C) →ₗ[C] ω :=
    ((LinearMap.ker (Dualizing.idealTensorMul (C := C) J)).liftQ g hle) ∘ₗ eI.symm.toLinearMap
  have hφs : Function.Surjective φ := by
    intro w
    obtain ⟨z, rfl⟩ := hg w
    exact ⟨eI (Submodule.Quotient.mk z), by simp [φ]⟩
  -- A surjection from an ideal onto a nonzero torsion free module is injective.
  have hφi : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨w, hw⟩ := exists_ne (0 : ω)
    obtain ⟨y, rfl⟩ := hφs w
    have hxy : (x : C) • y = (y : C) • x := Subtype.ext (by simp [smul_eq_mul, mul_comm])
    have h1 : (x : C) • φ y = 0 := by
      rw [← map_smul, hxy, map_smul, hx, smul_zero]
    exact Subtype.ext ((smul_eq_zero.mp h1).resolve_right hw)
  exact isDualizingRingModule_of_linearEquiv hω (LinearEquiv.ofBijective φ ⟨hφi, hφs⟩).symm

/-- **A dualizing ideal of a regular local ring extends to a dualizing ideal.** Let `B → C` be an
injective map of regular local rings and `J` an ideal of `B` which is a dualizing module of `B`.
Then `J C` is a dualizing module of `C`: `B` is Gorenstein ([Stacks, Tag 0AWX]), so `J ≅ B` is
principal on a nonzero element, `J C` is principal on its nonzero image, hence `J C ≅ C`, and `C`
is Gorenstein. -/
theorem isDualizingRingModule_map_of_isRegularLocalRing {B C : Type u} [CommRing B]
    [IsRegularLocalRing B] [CommRing C] [IsRegularLocalRing C]
    [Algebra B C] (hinj : Function.Injective (algebraMap B C)) (J : Ideal B)
    (hJ : IsDualizingRingModule B J) :
    IsDualizingRingModule C (J.map (algebraMap B C)) := by
  have : IsDomain C := IsRegularLocalRing.isDomain C
  obtain ⟨e⟩ := nonempty_linearEquiv_self_of_isGorensteinLocalRing
    (Dualizing.IsRegularLocalRing.isGorensteinLocalRing B) hJ
  let b : J := e.symm 1
  have hb0 : (b : B) ≠ 0 := by
    intro h
    exact one_ne_zero (by simpa [b] using congrArg e (Subtype.ext h : b = 0) : (1 : B) = 0)
  have hspan : J = Ideal.span {(b : B)} := by
    apply le_antisymm
    · intro x hx
      rw [Ideal.mem_span_singleton']
      refine ⟨e ⟨x, hx⟩, ?_⟩
      have : (⟨x, hx⟩ : J) = e ⟨x, hx⟩ • b := by
        apply e.injective
        simp [b, map_smul, smul_eq_mul]
      exact (congrArg Subtype.val this).symm.trans (by simp)
    · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr b.2)
  have hmap : J.map (algebraMap B C) = Ideal.span {algebraMap B C b} :=
    (congrArg _ hspan).trans (by rw [Ideal.map_span, Set.image_singleton])
  have hc0 : algebraMap B C b ≠ 0 := (map_ne_zero_iff _ hinj).mpr hb0
  exact isDualizingRingModule_of_linearEquiv
    ⟨inferInstance, 0, Dualizing.IsRegularLocalRing.isGorensteinLocalRing C⟩
    ((LinearEquiv.toSpanNonzeroSingleton C C _ hc0).trans (LinearEquiv.ofEq _ _ hmap.symm))

end Stacks.Duality

end
