* [Stacks Project, Tag 064K](https://stacks.math.columbia.edu/tag/064K)
* [Stacks Project, Tag 064Y](https://stacks.math.columbia.edu/tag/064Y)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct
open CochainComplex.DerivedExtensionScalars

attribute [local instance] HasDerivedCategory.standard

universe u

noncomputable section

namespace Dualizing

/-- Acting on `B ⊗[A] M` through `algebraMap R B` is acting through the `R`-module structure of
the left factor: both multiply the left factor by `algebraMap R B r`. -/
private theorem smul_algebraMap_tensorDiagonal (R A : Type u) [CommRing R] [CommRing A]
    [Algebra R A] (M : Type u) [AddCommGroup M] [Module A M] [Module R M] [IsScalarTower R A M]
    (r : R) (x : TensorProduct A (A ⊗[R] A) M) :
    (algebraMap R (A ⊗[R] A) r) • x = r • x := by
  induction x using TensorProduct.inductionOn with
  | add y z hy hz => simp only [smul_add, hy, hz]
  | tmul b m =>
      rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul', smul_eq_mul, Algebra.smul_def]

/-- **A term of the diagonal base change is flat over the base.**  If `M` is an `A`-module flat
over `R`, then its extension of scalars along the left coprojection `A → B = A ⊗[R] A` is flat
over `R`.

The extension is `B ⊗[A] M`, and `B` is flat over `A` because `A` is flat over `R`, so
`Dualizing.flat_tensorProduct` applies.  The two isomorphisms are
`PseudoCoherence.extendScalarsAlgebraMapObjIso`, which recognises the carrier of the extension as
that tensor product, and `Dualizing.smul_algebraMap_tensorDiagonal`, which matches the two
`R`-module structures on it. -/
@[ega "IV 2.1.5" "special case"]
private theorem flat_restrictScalars_extendScalars_includeLeft (R A : Type u) [CommRing R]
    [CommRing A] [Algebra R A] [Module.Flat R A] (M : ModuleCat.{u} A)
    (hM : Module.Flat R ((ModuleCat.restrictScalars (algebraMap R A)).obj M)) :
    Module.Flat R ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj
      ((ModuleCat.extendScalars.{u, u, u}
        (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] A)).obj M)) := by
  let : Module R (M : Type u) := ((ModuleCat.restrictScalars (algebraMap R A)).obj M).isModule
  have : IsScalarTower R A (M : Type u) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have : Module.Flat R (M : Type u) := hM
  have : Module.Flat R (TensorProduct A (A ⊗[R] A) (M : Type u)) :=
    flat_tensorProduct R A (M : Type u) (A ⊗[R] A)
  have : Module.Flat R ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj
      (ModuleCat.of (A ⊗[R] A) (TensorProduct A (A ⊗[R] A) (M : Type u)))) :=
    Module.Flat.of_linearEquiv (M := TensorProduct A (A ⊗[R] A) (M : Type u))
      { AddEquiv.refl (TensorProduct A (A ⊗[R] A) (M : Type u)) with
        map_smul' := fun r x => smul_algebraMap_tensorDiagonal R A (M : Type u) r x }
  exact Module.Flat.of_linearEquiv
    ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).mapIso
      (PseudoCoherence.extendScalarsAlgebraMapObjIso (R := A) (S := A ⊗[R] A) M)).toLinearEquiv

/-- Over a Noetherian ring a bounded-above complex of finite modules is pseudo-coherent in every
degree: [stacks 066E] makes each term pseudo-coherent and [stacks 064Y] passes that to the
complex. -/
private theorem isPseudoCoherentFrom_of_boundedAbove_finite (B : Type u) [CommRing B]
    [IsNoetherianRing B] (L : CochainComplex (ModuleCat.{u} B) ℤ) (b : ℤ) [L.IsStrictlyLE b]
    (hfin : ∀ i : ℤ, Module.Finite B (L.X i)) (m : ℤ) :
    StacksDraft.PseudoCoherence.IsPseudoCoherentFrom (DerivedCategory.Q.obj L) m := by
  refine (StacksDraft.PseudoCoherence.pseudoCoherent_iff_all _).1 ?_ m
  refine (StacksDraft.PseudoCoherence.pseudoCoherentFrom_and_pseudoCoherent_of_boundedAbove
    L ⟨b, inferInstance⟩).2 fun i => ?_
  exact (StacksDraft.PseudoCoherence.pseudoCoherent_iff_boundedAbove_finite_homology
    (DerivedCategory.Q.obj L) m (L.X i)).2.2.mpr (hfin i)

/-- A functor preserving zero objects keeps a complex strictly bounded below termwise. -/
private theorem isStrictlyGE_map_obj {C D : Type*} [Category C] [Category D] [HasZeroMorphisms C]
    [HasZeroMorphisms D] (G : C ⥤ D) [G.PreservesZeroMorphisms] (L : CochainComplex C ℤ) (a : ℤ)
    [L.IsStrictlyGE a] :
    CochainComplex.IsStrictlyGE ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) a :=
  (CochainComplex.isStrictlyGE_iff _ a).mpr fun i hi =>
    G.map_isZero (L.isZero_of_isStrictlyGE a i hi)

/-- A functor preserving zero objects keeps a complex strictly bounded above termwise. -/
private theorem isStrictlyLE_map_obj {C D : Type*} [Category C] [Category D] [HasZeroMorphisms C]
    [HasZeroMorphisms D] (G : C ⥤ D) [G.PreservesZeroMorphisms] (L : CochainComplex C ℤ) (b : ℤ)
    [L.IsStrictlyLE b] :
    CochainComplex.IsStrictlyLE ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L) b :=
  (CochainComplex.isStrictlyLE_iff _ b).mpr fun i hi =>
    G.map_isZero (L.isZero_of_isStrictlyLE b i hi)

/-- A `K`-flat complex concentrated in degrees `[a, b]` has Tor amplitude in `[a, b]`: being
`K`-flat, its derived tensor product with a module is the termwise one, whose degree-`i` term
vanishes together with the degree-`i` term of the complex. -/
private theorem hasTorAmplitude_of_bounded_kFlat (B : Type u) [CommRing B]
    (L : CochainComplex (ModuleCat.{u} B) ℤ) (a b : ℤ) [L.IsStrictlyGE a] [L.IsStrictlyLE b]
    (hL : CochainComplex.KFlat.{u, u} L) :
    StacksDraft.TorAmplitude.FaithfullyFlat.HasTorAmplitude L a b := by
  intro M i hi
  refine (PseudoCoherence.derivedTensorHomologyIsoTermwise L hL M i).isZero_iff.2 ?_
  refine ShortComplex.isZero_homology_of_isZero_X₂ _ ?_
  change IsZero ((StacksDraft.TorAmplitude.Termwise.tensorComplex L M).X i)
  rw [StacksDraft.TorAmplitude.Termwise.tensorComplex_X]
  have hz : IsZero (L.X i) := by
    rcases hi with h | h
    · exact L.isZero_of_isStrictlyGE a i h
    · exact L.isZero_of_isStrictlyLE b i h
  exact (MonoidalCategory.tensorRight M).map_isZero hz

/-- **[stacks 0E1U] at the diagonal square, with the canonical base-change isomorphisms.**  Let
`R → A` be flat of finite presentation with `B = A ⊗[R] A` Noetherian, and let `K` be a relative
dualizing complex for `R → A`.  Then there are complexes `P^•`, `F^•` of `B`-modules such that

* `P^•` is bounded above with projective and `K`-flat terms and represents the diagonal `A` in
  degree zero;
* `F^•` is bounded above with terms flat over `R` and represents `K ⊗ᴸ_A B`;
* the Hom complex `E^• = Hom^•_B(P^•, F^•)` has terms flat over `R` and finite over `B`, and for
  *every* `R`-algebra `S'` its extension of scalars along `B → B ⊗[R] S'` is the Hom complex of the
  extensions of `P^•` and `F^•` by the canonical map
  (`StacksDraft.RelativelyPerfect.IsCanonicalHomComplexBaseChangeIso`).

This is the representative data consumed by the clause-(2) chase of [stacks 0E2F], read off
[stacks 0E1U] at [stacks 0E1U]'s `K` the diagonal module in degree zero and at its `L` the
termwise diagonal base change of the bounded representative of `K` from [stacks 0DHV]. -/
theorem exists_diagonalHomComplexRepresentation_canonical
    (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [Module.Flat R A]
    [Algebra.FinitePresentation R A] [IsNoetherianRing (A ⊗[R] A)]
    (K : DerivedCategory (ModuleCat.{u} A)) (hK : Dualizing.IsRelativeDualizingComplex R A K) :
    ∃ (P F : CochainComplex (ModuleCat.{u} (A ⊗[R] A)) ℤ) (dP d : ℤ),
      P.IsStrictlyLE dP ∧
      (∀ i : ℤ, CategoryTheory.Projective (P.X i)) ∧
      CochainComplex.KFlat.{u, u} P ∧
      Nonempty (DerivedCategory.Q.obj P ≅
        (DerivedCategory.singleFunctor (ModuleCat.{u} (A ⊗[R] A)) 0).obj
          (Dualizing.diagonalModule R A)) ∧
      F.IsStrictlyLE d ∧
      (∀ i : ℤ, Module.Flat R
        ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj (F.X i))) ∧
      Nonempty (DerivedCategory.Q.obj F ≅ (Dualizing.diagonalDerivedExtension R A).obj K) ∧
      (∀ (S' : Type u) [CommRing S'] [Algebra R S'],
        ∃ e : (Dualizing.diagonalIncludeLeftExtend R A S').obj
            (CochainComplex.HomComplexR (A ⊗[R] A) P F) ≅
          CochainComplex.HomComplexR ((A ⊗[R] A) ⊗[R] S')
            ((Dualizing.diagonalIncludeLeftExtend R A S').obj P)
            ((Dualizing.diagonalIncludeLeftExtend R A S').obj F),
          StacksDraft.RelativelyPerfect.IsCanonicalHomComplexBaseChangeIso
            (Algebra.TensorProduct.includeLeftRingHom : (A ⊗[R] A) →+* (A ⊗[R] A) ⊗[R] S')
            P F e) ∧
      (∀ i : ℤ, Module.Flat R
        ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj
          ((CochainComplex.HomComplexR (A ⊗[R] A) P F).X i))) ∧
      (∀ i : ℤ, Module.Finite (A ⊗[R] A) ((CochainComplex.HomComplexR (A ⊗[R] A) P F).X i)) := by
  -- The bounded representative of `K` over `A` supplied by [stacks 0DHV].
  obtain ⟨P₀, a₀, b₀, hP₀GE, hP₀LE, hP₀flat, hP₀fp, ⟨eP₀⟩⟩ :=
    (PseudoCoherence.isRelativelyPerfect_iff_exists_bounded_flat_finitePresentation.{u, u, u}
      _ _ _ K).1 hK.relativelyPerfect
  have := hP₀GE
  have := hP₀LE
  set f : A →+* A ⊗[R] A := Algebra.TensorProduct.includeLeftRingHom
  -- [stacks 0E1U]'s `L`: the termwise diagonal base change of that representative.
  set L := (CochainComplex.extendScalars f).obj P₀
  have eF₀ : (diagonalDerivedExtension R A).obj K ≅ DerivedCategory.Q.obj L :=
    diagonalDerivedExtensionIso R A K P₀ eP₀.symm
  have hLGE : L.IsStrictlyGE a₀ := isStrictlyGE_map_obj (ModuleCat.extendScalars f) P₀ a₀
  have hLLE : L.IsStrictlyLE b₀ := isStrictlyLE_map_obj (ModuleCat.extendScalars f) P₀ b₀
  have hLflat : ∀ i : ℤ, Module.Flat R
      ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj (L.X i)) :=
    fun i => flat_restrictScalars_extendScalars_includeLeft R A (P₀.X i) (hP₀flat i)
  have hLfin : ∀ i : ℤ, Module.Finite (A ⊗[R] A) (L.X i) := by
    intro i
    have := hP₀fp i
    have : Module.Finite A (P₀.X i) := inferInstance
    exact Module.Finite.equiv
      (PseudoCoherence.extendScalarsAlgebraMapObjIso
        (R := A) (S := A ⊗[R] A) (P₀.X i)).symm.toLinearEquiv
  have := hLGE
  have := hLLE
  have hLpc : ∀ m : ℤ, StacksDraft.PseudoCoherence.IsPseudoCoherentFrom
      (DerivedCategory.Q.obj L) m :=
    fun m => isPseudoCoherentFrom_of_boundedAbove_finite (A ⊗[R] A) L b₀ hLfin m
  -- The Tor-amplitude hypothesis of [stacks 0E1U], over the `ULift` of `R` it is stated at.
  set g : ULift.{u} R →+* (A ⊗[R] A) :=
    (algebraMap R (A ⊗[R] A)).comp (ULift.ringEquiv : ULift.{u} R ≃+* R).toRingHom
  set LR := ((ModuleCat.restrictScalars g).mapHomologicalComplex (ComplexShape.up ℤ)).obj L
  have hLRflat : ∀ n : ℤ, Module.Flat (ULift.{u} R) (LR.X n) := by
    intro n
    have h1 : Module.Flat (ULift.{u} R)
        ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj (L.X n)) :=
      Module.Flat.ulift_left_iff.mpr (hLflat n)
    exact h1
  have : CochainComplex.IsStrictlyGE LR a₀ :=
    isStrictlyGE_map_obj (ModuleCat.restrictScalars g) L a₀
  have : CochainComplex.IsStrictlyLE LR b₀ :=
    isStrictlyLE_map_obj (ModuleCat.restrictScalars g) L b₀
  have := hLRflat
  have hLtor : ∃ a b : ℤ, StacksDraft.TorAmplitude.FaithfullyFlat.HasTorAmplitude LR a b :=
    ⟨a₀, b₀, hasTorAmplitude_of_bounded_kFlat (ULift.{u} R) LR a₀ b₀
      (CochainComplex.KFlat.kFlat_of_flat.{u, u} LR b₀)⟩
  -- [stacks 0E1U]'s `K`: the diagonal module in degree zero, pseudo-coherent over `B`.
  let : Algebra (A ⊗[R] A) A :=
    (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom.toAlgebra
  have hsurj : Function.Surjective (algebraMap (A ⊗[R] A) A) := fun a =>
    ⟨a ⊗ₜ[R] 1, by
      change (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A) (a ⊗ₜ[R] 1) = a
      simp⟩
  have : Module.Finite (A ⊗[R] A) A :=
    Module.Finite.of_surjective (Algebra.linearMap (A ⊗[R] A) A) hsurj
  have hdfin : Module.Finite (A ⊗[R] A) (diagonalModule R A) :=
    inferInstanceAs (Module.Finite (A ⊗[R] A) A)
  have hdpc : StacksDraft.PseudoCoherence.IsModulePseudoCoherent (R := A ⊗[R] A)
      (diagonalModule R A : Type u) :=
    (StacksDraft.PseudoCoherence.pseudoCoherent_iff_boundedAbove_finite_homology
      ((DerivedCategory.singleFunctor (ModuleCat.{u} (A ⊗[R] A)) 0).obj
        (diagonalModule R A)) 0 (diagonalModule R A : Type u)).2.2.mpr hdfin
  set Ksingle := (CochainComplex.singleFunctor (ModuleCat.{u} (A ⊗[R] A)) 0).obj
    (diagonalModule R A)
  have eKs : (DerivedCategory.singleFunctor (ModuleCat.{u} (A ⊗[R] A)) 0).obj
      (diagonalModule R A) ≅ DerivedCategory.Q.obj Ksingle :=
    (DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{u} (A ⊗[R] A)) 0).app
      (diagonalModule R A)
  have hKspc : ∀ m : ℤ, StacksDraft.PseudoCoherence.IsPseudoCoherentFrom
      (DerivedCategory.Q.obj Ksingle) m := by
    refine fun m => (StacksDraft.PseudoCoherence.pseudoCoherent_iff_all _).1 ?_ m
    exact StacksDraft.PseudoCoherence.IsPseudoCoherent.ofIso hdpc eKs
  -- [stacks 0E1U] itself.
  obtain ⟨P, F, eP1, eF1, ⟨dP, hdP⟩, hPff, ⟨aF, bF, hFGE, hFLE⟩, hFflat, -, hEflat,
      -, hbc, hfin⟩ :=
    StacksDraft.RelativelyPerfect.exists_homComplex_representation.{u, u, u, u} R (A ⊗[R] A)
      Ksingle L hKspc hLtor
  have : Algebra.FinitePresentation A (A ⊗[R] A) :=
    Algebra.FinitePresentation.baseChange (R := R) (A := A) A
  have hBfp : Algebra.FinitePresentation R (A ⊗[R] A) :=
    Algebra.FinitePresentation.trans R A (A ⊗[R] A)
  have (i : ℤ) : Module.Finite (A ⊗[R] A) (P.X i) := (hPff i).1
  have (i : ℤ) : Module.Free (A ⊗[R] A) (P.X i) := (hPff i).2
  have (i : ℤ) : Module.Flat (A ⊗[R] A) (P.X i) := inferInstance
  have := hdP
  have := hFLE
  obtain ⟨hFfp, hEfp⟩ := hfin hBfp hLpc
  refine ⟨P, F, dP, bF, hdP,
    fun i => inferInstance, CochainComplex.KFlat.kFlat_of_flat.{u, u} P dP,
    ⟨eP1 ≪≫ eKs.symm⟩, hFLE, hFflat, ⟨eF1 ≪≫ eF₀.symm⟩, ?_, hEflat, fun i => ?_⟩
  · intro S' _ _
    obtain ⟨e, he, -⟩ := (hbc S').exists
    exact ⟨e, he⟩
  · have := hEfp i
    exact inferInstance

/-- **[stacks 0E1U] at the diagonal square.**  The representative data of
`Dualizing.exists_diagonalHomComplexRepresentation_canonical`, with the Hom complex named `E^•` and
its base-change identifications forgotten down to their existence. -/
theorem exists_diagonalHomComplexRepresentation
    (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [Module.Flat R A]
    [Algebra.FinitePresentation R A] [IsNoetherianRing (A ⊗[R] A)]
    (K : DerivedCategory (ModuleCat.{u} A)) (hK : Dualizing.IsRelativeDualizingComplex R A K) :
    ∃ (P F E : CochainComplex (ModuleCat.{u} (A ⊗[R] A)) ℤ) (dP d : ℤ),
      P.IsStrictlyLE dP ∧
      (∀ i : ℤ, CategoryTheory.Projective (P.X i)) ∧
      CochainComplex.KFlat.{u, u} P ∧
      Nonempty (DerivedCategory.Q.obj P ≅
        (DerivedCategory.singleFunctor (ModuleCat.{u} (A ⊗[R] A)) 0).obj
          (Dualizing.diagonalModule R A)) ∧
      F.IsStrictlyLE d ∧
      (∀ i : ℤ, Module.Flat R
        ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj (F.X i))) ∧
      Nonempty (DerivedCategory.Q.obj F ≅ (Dualizing.diagonalDerivedExtension R A).obj K) ∧
      (∀ (S' : Type u) [CommRing S'] [Algebra R S'],
        Nonempty ((Dualizing.diagonalIncludeLeftExtend R A S').obj E ≅
          CochainComplex.HomComplexR ((A ⊗[R] A) ⊗[R] S')
            ((Dualizing.diagonalIncludeLeftExtend R A S').obj P)
            ((Dualizing.diagonalIncludeLeftExtend R A S').obj F))) ∧
      (∀ i : ℤ, Module.Flat R
        ((ModuleCat.restrictScalars (algebraMap R (A ⊗[R] A))).obj (E.X i))) ∧
      (∀ i : ℤ, Module.Finite (A ⊗[R] A) (E.X i)) := by
  obtain ⟨P, F, dP, d, h1, h2, h3, h4, h5, h6, h7, hbc, h9, h10⟩ :=
    exists_diagonalHomComplexRepresentation_canonical R A K hK
  exact ⟨P, F, _, dP, d, h1, h2, h3, h4, h5, h6, h7,
    fun S' _ _ => ⟨(hbc S').choose⟩, h9, h10⟩

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- **Stacks Project, Tag 0E2F (2), from the residue-field vanishing alone.**  Let `R → A` be
flat of finite presentation with `A ⊗[R] A` Noetherian, let `K` be a relative dualizing complex
for `R → A` and let `R → R'` be any ring map.  If, at every prime of `R`, the derived Hom from the
diagonal into the base change of `K` to the residue field has no cohomology outside degree zero,
then `K ⊗ᴸ_A (A ⊗[R] R')` is a relative dualizing complex for `R' → A ⊗[R] R'`.

**Nothing is carried.**  This is
`Dualizing.isRelativeDualizingComplex_baseChange_of_residueFieldVanishing` with its representative
data over the diagonal discharged by
`Dualizing.exists_diagonalHomComplexRepresentation`, that is by [stacks 0E1U] at the diagonal
square. -/
theorem isRelativeDualizingComplex_baseChange_of_residueFieldVanishing'
    (R A R' : Type u) [CommRing R] [CommRing A] [CommRing R']
    [Algebra R A] [Algebra R R'] [Module.Flat R A] [Algebra.FinitePresentation R A]
    [IsNoetherianRing (A ⊗[R] A)]
    (K : DerivedCategory (ModuleCat.{u} A)) (hK : IsRelativeDualizingComplex R A K)
    (hres : ∀ (p : Ideal R) [p.IsPrime] (j : ℤ), j ≠ 0 → Limits.IsZero
      ((DerivedCategory.homologyFunctor
          (ModuleCat.{u} (A ⊗[R] StacksDraft.DegreewiseChase.ResidueFieldAt R p)) j).obj
        ((derivedHom.{u, u}
            (Algebra.TensorProduct.lmul'
              (StacksDraft.DegreewiseChase.ResidueFieldAt R p) :
              (A ⊗[R] StacksDraft.DegreewiseChase.ResidueFieldAt R p)
                  ⊗[StacksDraft.DegreewiseChase.ResidueFieldAt R p]
                (A ⊗[R] StacksDraft.DegreewiseChase.ResidueFieldAt R p)
                →ₐ[StacksDraft.DegreewiseChase.ResidueFieldAt R p]
                (A ⊗[R] StacksDraft.DegreewiseChase.ResidueFieldAt R p)).toRingHom).obj
          (diagonalBaseChangeTarget R A
            (StacksDraft.DegreewiseChase.ResidueFieldAt R p) K)))) :
    letI : Module.Flat R' (A ⊗[R] R') := flat_baseChange R A R'
    letI : Algebra.FinitePresentation R' (A ⊗[R] R') :=
      Algebra.FinitePresentation.equiv (baseChangeComm R A R')
    IsRelativeDualizingComplex R' (A ⊗[R] R')
      ((totalDerivedExtensionScalars.{u, u, u}
        (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] R')).functor.obj K) := by
  obtain ⟨P, F, E, dP, d, hdP, hproj, hP, ⟨eP⟩, hdF, hflat, ⟨eF⟩, hE, hEflat, hEfin⟩ :=
    exists_diagonalHomComplexRepresentation R A K hK
  have := hdP
  have := hproj
  have := hdF
  exact isRelativeDualizingComplex_baseChange_of_residueFieldVanishing R A R' K hK P dP hP eP
    F d hflat eF E hE hEflat hEfin hres

end Dualizing

