module

public import StacksFrontier.RingTheory.Dualizing.ExtRegularElement
public import StacksFrontier.RingTheory.Dualizing.FlatLocalGorenstein
import all StacksFrontier.RingTheory.Dualizing.FlatLocalGorenstein

/-!
# Gorenstein local rings modulo a nonzerodivisor

A Noetherian local ring is Gorenstein if and only if its quotient by a nonzerodivisor in the
maximal ideal is Gorenstein.

## Main results

* `Dualizing.isGorensteinLocalRing_quotient_span_singleton_iff`: quotienting a Noetherian local
  ring by a nonzerodivisor in its maximal ideal preserves and reflects the Gorenstein property.

## References

* [Stacks Project, Tag 0BJJ](https://stacks.math.columbia.edu/tag/0BJJ)
-/

@[expose] public section

open CategoryTheory
open scoped Pointwise

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Dualizing

/-! ### The quotient by a principal ideal as a module -/

section Modules

variable {R : Type u} [CommRing R]

/-- Multiplying the whole ring by `f` gives the ideal generated by `f`. -/
private lemma smul_top_eq_span_singleton (f : R) :
    f • (⊤ : Submodule R R) = Ideal.span {f} := by
  ext x
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Ideal.mem_span_singleton]
  exact ⟨fun ⟨y, hy⟩ => ⟨y, hy.symm⟩, fun ⟨c, hc⟩ => ⟨c, hc.symm⟩⟩

/-- `R/fR` is the quotient of `R` by the principal ideal `(f)`, as an `R`-module, where the
quotient ring carries the module structure obtained by restricting scalars along `R → R/(f)`. -/
private noncomputable def quotSMulTopUliftLinearEquiv (f : R) :
    QuotSMulTop f (ULift.{u} R) ≃ₗ[R]
      ((ModuleCat.restrictScalars (Ideal.Quotient.mk (Ideal.span {f}))).obj
        (ModuleCat.of (R ⧸ Ideal.span {f}) (ULift.{u} (R ⧸ Ideal.span {f})))) :=
  have hmap : Submodule.map
      (ULift.moduleEquiv : ULift.{u} R ≃ₗ[R] R).toLinearMap
      (f • (⊤ : Submodule R (ULift.{u} R))) = Ideal.span {f} := by
    rw [Submodule.map_pointwise_smul, ← smul_top_eq_span_singleton f]
    congr 1
    simp only [Submodule.map_top, LinearEquiv.range]
  (Submodule.Quotient.equiv _ (Ideal.span {f})
      (ULift.moduleEquiv : ULift.{u} R ≃ₗ[R] R) hmap).trans
    { toFun := fun x => ULift.up x
      invFun := fun x => x.down
      map_add' := fun _ _ => rfl
      map_smul' := fun r x => by
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        rfl
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }

end Modules

/-! ### Ext out of a free module of rank one -/

section FreeExt

variable {R : Type u} [CommRing R]

/-- `Ext^i_R(R, N)` vanishes outside degree `0`. -/
private lemma subsingleton_ext_ulift_self (N : ModuleCat.{u} R) {i : ℤ} (hi : i ≠ 0) :
    Subsingleton (DerivedCategory.Ext
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R (ULift.{u} R)))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj N) i) := by
  rcases lt_or_gt_of_ne hi with h | h
  · exact negative_ext_subsingleton _ _ i h
  · obtain ⟨n, rfl⟩ : ∃ n : ℕ, i = ((n + 1 : ℕ) : ℤ) := ⟨(i - 1).toNat, by omega⟩
    have hz : Subsingleton
        (Abelian.Ext (ModuleCat.of R (ULift.{u} R)) N (n + 1)) :=
      Abelian.Ext.subsingleton_of_projective _ _ n
    exact (Abelian.Ext.homLinearEquiv (R := R)
      (X := ModuleCat.of R (ULift.{u} R)) (Y := N) (n := n + 1)).symm.injective.subsingleton

/-- `Ext^0_R(R, R) = Hom_R(R, R) = R`. -/
private noncomputable def extZeroUliftSelfLinearEquiv (R : Type u) [CommRing R] :
    DerivedCategory.Ext
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R (ULift.{u} R)))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R (ULift.{u} R))) 0 ≃ₗ[R] ULift.{u} R :=
  (Abelian.Ext.homLinearEquiv (R := R) (X := ModuleCat.of R (ULift.{u} R))
        (Y := ModuleCat.of R (ULift.{u} R)) (n := 0)).symm.trans
    (Abelian.Ext.linearEquiv₀.trans
      ((ModuleCat.homLinearEquiv (S := R)).trans
        ((LinearEquiv.arrowCongr (ULift.moduleEquiv : ULift.{u} R ≃ₗ[R] R)
            (LinearEquiv.refl R (ULift.{u} R))).trans
          (LinearMap.ringLmapEquivSelf R R (ULift.{u} R)))))

/-- Multiplication by a nonzerodivisor `f` is injective on `Ext^i_R(R, R)` for every `i`. -/
private lemma isSMulRegular_ext_ulift_self {f : R} (hf : IsSMulRegular R f) (i : ℤ) :
    IsSMulRegular (DerivedCategory.Ext
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R (ULift.{u} R)))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R (ULift.{u} R))) i) f := by
  by_cases hi : i = 0
  · subst hi
    intro a b hab
    apply (extZeroUliftSelfLinearEquiv R).injective
    refine (ULift.isSMulRegular_iff.mpr hf) ?_
    simpa only [map_smul] using congrArg (extZeroUliftSelfLinearEquiv R) hab
  · have := subsingleton_ext_ulift_self (ModuleCat.of R (ULift.{u} R)) hi
    exact fun a b _ => Subsingleton.elim a b

end FreeExt

/-! ### Ext out of the quotient by a nonzerodivisor -/

section QuotientExt

variable {R : Type u} [CommRing R]

/-- For a nonzerodivisor `f`, `Ext^i_R(R/fR, R)` vanishes for `i ≠ 1`. -/
private lemma subsingleton_moduleExtInto_quotSMulTop {f : R}
    (hfR : IsSMulRegular R f) (hf : IsSMulRegular (ULift.{u} R) f) {i : ℤ} (hi : i ≠ 1) :
    Subsingleton (moduleExtInto (QuotSMulTop f (ULift.{u} R))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R (ULift.{u} R))) i) := by
  obtain ⟨j, rfl⟩ : ∃ j : ℤ, i = j + 1 := ⟨i - 1, by ring⟩
  have hj : j ≠ 0 := by omega
  have hsrc := subsingleton_ext_ulift_self (ModuleCat.of R (ULift.{u} R)) hj
  refine subsingleton_of_forall_eq 0 fun b => ?_
  have hzero : extFromQuotient (ULift.{u} R)
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R (ULift.{u} R))) f (j + 1) b = 0 := by
    have hsmul := (exact_extFromQuotient_lsmul (ULift.{u} R)
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R (ULift.{u} R))) f hf (j + 1)).apply_apply_eq_zero b
    refine isSMulRegular_ext_ulift_self hfR (j + 1) ?_
    simpa only [LinearMap.lsmul_apply, smul_zero] using hsmul
  obtain ⟨a, ha⟩ := (exact_extConnecting_extFromQuotient (ULift.{u} R)
    ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R (ULift.{u} R))) f hf j b).mp hzero
  rw [← ha, Subsingleton.elim a 0, map_zero]

/-- For a nonzerodivisor `f`, the linear equivalence `Ext^1_R(R/fR, R) ≃ R/fR`. -/
private noncomputable def moduleExtIntoQuotSMulTopOneLinearEquiv {f : R}
    (hf : IsSMulRegular (ULift.{u} R) f) :
    moduleExtInto (QuotSMulTop f (ULift.{u} R))
      ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R (ULift.{u} R))) 1 ≃ₗ[R] QuotSMulTop f (ULift.{u} R) := by
  classical
  have hone := subsingleton_ext_ulift_self (R := R) (ModuleCat.of R (ULift.{u} R))
    (i := 0 + 1) (by omega)
  set K := (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
    (ModuleCat.of R (ULift.{u} R))
  obtain ⟨ι, hinj, hspec⟩ := quotientExtEmbedding (ULift.{u} R) K f hf 0
  have hsurj : Function.Surjective ι := by
    intro b
    obtain ⟨x, hx⟩ :=
      (exact_extConnecting_extFromQuotient (ULift.{u} R) K f hf 0 b).mp (Subsingleton.elim _ _)
    exact ⟨(f • (⊤ : Submodule R (moduleExtInto (ULift.{u} R) K 0))).mkQ x,
      (hspec x).trans hx⟩
  exact (LinearEquiv.ofBijective ι ⟨hinj, hsurj⟩).symm.trans
    (QuotSMulTop.congr f (extZeroUliftSelfLinearEquiv R))

end QuotientExt

/-! ### The derived Hom of the quotient by a nonzerodivisor -/

/-- For a nonzerodivisor `f` of a commutative ring `R`, the derived Hom `RHom_R(R/(f), R)` is the
single complex on `R/(f)` in cohomological degree `1`. -/
private theorem derivedHom_quotSpanSingleton_iso_single (R : Type u) [CommRing R] {f : R}
    (hf : f ∈ nonZeroDivisors R) :
    Nonempty ((derivedHom.{u, u} (Ideal.Quotient.mk (Ideal.span {f}))).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
          (ModuleCat.of R (ULift.{u} R))) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} (R ⧸ Ideal.span {f})) 1).obj
        (ModuleCat.of (R ⧸ Ideal.span {f}) (ULift.{u} (R ⧸ Ideal.span {f})))) := by
  classical
  have hfR : IsSMulRegular R f := (isRegular_iff_mem_nonZeroDivisors.mpr hf).left
  have hfU : IsSMulRegular (ULift.{u} R) f := ULift.isSMulRegular_iff.mpr hfR
  set I := Ideal.span {f}
  set q := Ideal.Quotient.mk I
  set T := ModuleCat.restrictScalars.{u} q
  set K := (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
    (ModuleCat.of R (ULift.{u} R))
  set D := (derivedHom.{u, u} q).obj K
  set H := DerivedCategory.homologyFunctor (ModuleCat.{u} (R ⧸ I))
  set U := ModuleCat.of (R ⧸ I) (ULift.{u} (R ⧸ I))
  let eQ : ModuleCat.of R (QuotSMulTop f (ULift.{u} R)) ≅ T.obj U :=
    (quotSMulTopUliftLinearEquiv f).toModuleIso
  let cc (i : ℤ) : (T.obj ((H i).obj D)) ≃ₗ[R] moduleExtInto (QuotSMulTop f (ULift.{u} R)) K i :=
    (derivedHomHomologyLinearEquivExt.{u, u} q K i).trans
      (Linear.homCongr R ((DerivedCategory.singleFunctor _ 0).mapIso eQ.symm) (Iso.refl _))
  have hvanish (i : ℤ) (hi : i ≠ 1) : Limits.IsZero ((H i).obj D) :=
    ModuleCat.isZero_iff_subsingleton.mpr
      ((cc i).toEquiv.subsingleton_congr.mpr (subsingleton_moduleExtInto_quotSMulTop hfR hfU hi))
  have hGE : D.IsGE 1 := (DerivedCategory.isGE_iff D 1).mpr fun i hi => hvanish i (by omega)
  have hLE : D.IsLE 1 := (DerivedCategory.isLE_iff D 1).mpr fun i hi => hvanish i (by omega)
  have eH : (H 1).obj D ≅ U := quotientModuleIsoOfRestrictScalars I _ U
    ((cc 1).trans ((moduleExtIntoQuotSMulTopOneLinearEquiv hfU).trans
      (quotSMulTopUliftLinearEquiv f)))
  obtain ⟨W, ⟨eW⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE D 1
  let eWH : (H 1).obj D ≅ W := (H 1).mapIso eW ≪≫
    (DerivedCategory.singleFunctorCompHomologyFunctorIso _ 1).app W
  exact ⟨eW ≪≫ (DerivedCategory.singleFunctor _ 1).mapIso (eWH.symm ≪≫ eH)⟩

/-! ### Gorenstein local rings modulo a nonzerodivisor -/

/-- Quotienting a Noetherian local ring by a nonzerodivisor in its maximal ideal preserves and
reflects the Gorenstein property. -/
@[stacks 0BJJ]
theorem isGorensteinLocalRing_quotient_span_singleton_iff
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (f : A) (hf : f ∈ IsLocalRing.maximalIdeal A) (hfreg : f ∈ nonZeroDivisors A) :
    letI : Nontrivial (A ⧸ Ideal.span {f}) := Ideal.Quotient.nontrivial_iff.mpr
      (lt_of_le_of_lt (Ideal.span_le.2 (Set.singleton_subset_iff.mpr hf))
        (inferInstance : (IsLocalRing.maximalIdeal A).IsMaximal).lt_top).ne
    letI : IsLocalRing (A ⧸ Ideal.span {f}) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {f}))
        Ideal.Quotient.mk_surjective
    IsGorensteinLocalRing A ↔ IsGorensteinLocalRing (A ⧸ Ideal.span {f}) := by
  let _ : Nontrivial (A ⧸ Ideal.span {f}) := Ideal.Quotient.nontrivial_iff.mpr
    (lt_of_le_of_lt (Ideal.span_le.2 (Set.singleton_subset_iff.mpr hf))
      (inferInstance : (IsLocalRing.maximalIdeal A).IsMaximal).lt_top).ne
  let _ : IsLocalRing (A ⧸ Ideal.span {f}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {f}))
      Ideal.Quotient.mk_surjective
  obtain ⟨e⟩ := derivedHom_quotSpanSingleton_iso_single A hfreg
  exact isGorensteinLocalRing_iff_quotient_of_derivedHom_iso_single (Ideal.span {f}) 1 e

end Dualizing

end
