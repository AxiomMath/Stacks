@[expose] public section

open CategoryTheory
open scoped TensorProduct

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Dualizing

noncomputable section

variable (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [Module.Flat R A]

/-- **What one conjunct of `hdiag` asserts, read down in `D(A)` and in the internal-Hom
vocabulary.**  If the defining condition of [stacks 0E2C] holds for `K` and the tensor--Hom
diagonal of [stacks 0BYN] at the tensor factor `L₁`, the Hom target `K₁` and the Hom source the
diagonal is invertible, then the internal derived Hom from the diagonal into `L₁ ⊗ᴸ_B K₁`,
restricted along the left coprojection, is `L`.

This is the implication `Dualizing.nonempty_iso_of_isRelativeDualizingComplex` runs twice; it is
isolated here because it is what the witness of this module's documentation refutes. -/
theorem nonempty_restrictScalars_modelHom_tensor_iso_of_isIso_diagonal
    (K L : DerivedCategory (ModuleCat.{u} A))
    (hK : Nonempty
      ((derivedHom.{u, u} (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom).obj
          ((diagonalDerivedExtension R A).obj K) ≅
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A A)))
    (hd : IsIso (StacksDraft.DerivedHom.derivedTensorHomDiagonal
      ((diagonalDerivedExtension R A).obj L) ((diagonalDerivedExtension R A).obj K)
      (diagonalObject R A))) :
    Nonempty
      ((ModuleCat.restrictScalars.{u}
            (Algebra.TensorProduct.includeLeftRingHom :
              A →+* A ⊗[R] A)).mapDerivedCategory.obj
          ((StacksDraft.DerivedHom.DerivedInternalHom.Model.hom (A ⊗[R] A)).obj
            (Opposite.op (diagonalObject R A),
              (StacksDraft.DerivedHom.DerivedInternalHom.Model.tensor (A ⊗[R] A)).obj
                ((diagonalDerivedExtension R A).obj L,
                  (diagonalDerivedExtension R A).obj K))) ≅ L) := by
  let T := StacksDraft.DerivedHom.DerivedInternalHom.Model.tensor (A ⊗[R] A)
  let K₁ := (diagonalDerivedExtension R A).obj K
  let L₁ := (diagonalDerivedExtension R A).obj L
  let AB := diagonalObject R A
  obtain ⟨eK⟩ := modelHom_diagonalObject_iso_of_derivedHom R A K₁ hK
  obtain ⟨eL⟩ := nonempty_restrictScalars_includeLeft_tensor_diagonalObject_iso R A L
  let c : T.obj (L₁, AB) ≅
      (StacksDraft.DerivedHom.DerivedInternalHom.Model.hom (A ⊗[R] A)).obj
        (Opposite.op AB, T.obj (L₁, K₁)) :=
    T.mapIso (Iso.prod (Iso.refl L₁) eK.symm) ≪≫
      @asIso _ _ _ _ (StacksDraft.DerivedHom.derivedTensorHomDiagonal L₁ K₁ AB) hd
  exact ⟨(ModuleCat.restrictScalars.{u}
        (Algebra.TensorProduct.includeLeftRingHom :
          A →+* A ⊗[R] A)).mapDerivedCategory.mapIso
      (c.symm ≪≫
        ((StacksDraft.DerivedHom.DerivedInternalHom.Model.adjunction
          (A ⊗[R] A)).tensorSwap AB L₁).symm) ≪≫ eL⟩

/-- Restriction of scalars along the multiplication map followed by restriction along the left
coprojection is the identity of `D(A)`: the coprojection is a section of the multiplication map.
-/
def restrictScalarsIncludeLeftLmulIso :
    (ModuleCat.restrictScalars.{u}
          (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom).mapDerivedCategory ⋙
        (ModuleCat.restrictScalars.{u}
          (Algebra.TensorProduct.includeLeftRingHom :
            A →+* A ⊗[R] A)).mapDerivedCategory ≅
      𝟭 (DerivedCategory (ModuleCat.{u} A)) :=
  StacksDraft.DerivedInverseLimit.derivedRestrictScalarsComp.{u, u}
      (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] A)
      (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom (RingHom.id A)
      (lmul'_comp_includeLeftRingHom R A).symm ≪≫
    mapDerivedCategoryIdIso

/-- **What one conjunct of `hdiag` asserts, read down in `D(A)`.**  The statement of
`Dualizing.nonempty_restrictScalars_modelHom_tensor_iso_of_isIso_diagonal` written with
`Dualizing.derivedHom`, the derived coextension of scalars of [stacks 0A70], in which it reads
`Δ^!(L₁ ⊗ᴸ_B K₁) ≅ L`. -/
theorem nonempty_derivedHom_tensor_iso_of_isIso_diagonal
    (K L : DerivedCategory (ModuleCat.{u} A))
    (hK : Nonempty
      ((derivedHom.{u, u} (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom).obj
          ((diagonalDerivedExtension R A).obj K) ≅
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A A)))
    (hd : IsIso (StacksDraft.DerivedHom.derivedTensorHomDiagonal
      ((diagonalDerivedExtension R A).obj L) ((diagonalDerivedExtension R A).obj K)
      (diagonalObject R A))) :
    Nonempty
      ((derivedHom.{u, u} (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom).obj
          ((StacksDraft.DerivedHom.DerivedInternalHom.Model.tensor (A ⊗[R] A)).obj
            ((diagonalDerivedExtension R A).obj L,
              (diagonalDerivedExtension R A).obj K)) ≅ L) := by
  let Δ := (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom
  let W := (StacksDraft.DerivedHom.DerivedInternalHom.Model.tensor (A ⊗[R] A)).obj
    ((diagonalDerivedExtension R A).obj L, (diagonalDerivedExtension R A).obj K)
  obtain ⟨e⟩ := nonempty_modelHomIsoRestrictScalarsDerivedHom.{u} Δ W
  obtain ⟨e'⟩ := nonempty_restrictScalars_modelHom_tensor_iso_of_isIso_diagonal R A K L hK hd
  refine ⟨((restrictScalarsIncludeLeftLmulIso R A).app
      ((derivedHom.{u, u} Δ).obj W)).symm ≪≫ ?_⟩
  exact (ModuleCat.restrictScalars.{u}
      (Algebra.TensorProduct.includeLeftRingHom :
        A →+* A ⊗[R] A)).mapDerivedCategory.mapIso e.symm ≪≫ e'

/-- **The assertion that the witness of this module's documentation refutes.**  For a relative
dualizing complex `ω` for `R → A`, invertibility of the tensor--Hom diagonal of [stacks 0BYN] at
the tensor factor and the Hom target both equal to the derived base change `ω₁` of `ω` along the
left coprojection, with the diagonal as the Hom source, forces

`Δ^!(ω₁ ⊗ᴸ_B ω₁) ≅ ω`.

That is both conjuncts of the hypothesis `hdiag` of
`Dualizing.nonempty_iso_of_isRelativeDualizingComplex` at `K = L = ω`, read down in `D(A)`.  At
`R = k` a field, `A = k[x, y]/(x, y)²` and `ω = Hom_k(A, k) = φ^!(k)` the left-hand side is the
bidual `RHom_A(RHom_A(ω, A), A)`, whose degree-zero cohomology is `8`-dimensional, while `ω` is
`3`-dimensional; see this module's documentation. -/
theorem nonempty_derivedHom_tensor_self_iso_of_isIso_diagonal
    [Algebra.FinitePresentation R A] (ω : DerivedCategory (ModuleCat.{u} A))
    (hω : IsRelativeDualizingComplex R A ω)
    (hd : IsIso (StacksDraft.DerivedHom.derivedTensorHomDiagonal
      ((diagonalDerivedExtension R A).obj ω) ((diagonalDerivedExtension R A).obj ω)
      (diagonalObject R A))) :
    Nonempty
      ((derivedHom.{u, u} (Algebra.TensorProduct.lmul' R : A ⊗[R] A →ₐ[R] A).toRingHom).obj
          ((StacksDraft.DerivedHom.DerivedInternalHom.Model.tensor (A ⊗[R] A)).obj
            ((diagonalDerivedExtension R A).obj ω,
              (diagonalDerivedExtension R A).obj ω)) ≅ ω) :=
  nonempty_derivedHom_tensor_iso_of_isIso_diagonal R A ω ω hω.diagonalDerivedHom hd

end

end Dualizing

end
