module

public import StacksFrontier.RingTheory.Dualizing.DerivedTorsion
public import StacksFrontier.RingTheory.LocalCohomology.BaseChange.Coreflection

/-!
# Coreflection onto the common kernel of a finite family of localizations

Let `C` be a pretriangulated category and `F : C ⥤ C` a triangulated endofunctor equipped with a
unit `η : 𝟭 C ⟶ F` which is an isomorphism on objects and morphisms in the image of `F` — the
shape of an abstract localization functor. Then every object `X` of `C` sits in a distinguished
triangle whose first vertex is killed by `F` and corepresents maps from objects killed by `F`.
Iterating over a finite family of such functors produces a coreflection of `C` onto the full
subcategory of objects killed by all of them.

For a ring `A` and a finite set of elements of `A`, the relevant functors are the derived
localizations at the powers of those elements; their common kernel consists of the objects of
`D(A)` whose cohomology is torsion for the ideal generated by the set. This module also records
the material needed to recognise that kernel: the degreewise unit of an exact endofunctor read
on the derived category, and the criterion for an object of a derived category to vanish.

## Main definitions

* `Dualizing.Coreflection.complexUnit` — the unit of an exact endofunctor, degreewise on
  cochain complexes.
* `Dualizing.Coreflection.derivedUnit` — the induced unit on the derived category.

## Main results

* `Dualizing.Coreflection.exists_fiber_localization` — the fibre of the unit at `X`
  corepresents maps out of objects killed by `F`.
* `Dualizing.Coreflection.exists_finite_localization_coreflection` — the coreflection onto the
  common kernel of a finite family.
* `Dualizing.Coreflection.derivedUnit_obj_isIso`,
  `Dualizing.Coreflection.derivedUnit_map_isIso` — the derived unit inherits invertibility on
  the image of the functor from its degreewise counterpart.
* `Dualizing.Coreflection.isZero_iff_homology` — an object of a derived category vanishes
  exactly when all of its cohomology objects do.

## Implementation notes

The names are placed in the namespace `Dualizing.Coreflection`, which the abstract coreflection
subject matter justifies and which keeps `exists_fiber_localization` apart from the unrelated
statement about formal fibres of the same name.

## References

* [Stacks Project, Tag 0A6R](https://stacks.math.columbia.edu/tag/0A6R)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Dualizing.Coreflection

section Triangulated

open CategoryTheory.Pretriangulated

-- A map from an object killed by `F` into an object in the image of `F` vanishes.  This is an
-- alias spelling of `Stacks.LocalCohomology.hom_eq_zero_of_localization`, not a second copy.
export Stacks.LocalCohomology (hom_eq_zero_of_localization)

variable {C : Type*} [Category C] [Preadditive C] [HasZeroObject C]
    [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- The fibre of the unit `η.app X` of an abstract localization functor `F` is killed by `F`,
and corepresents maps into `X` out of objects killed by `F`. -/
lemma exists_fiber_localization
    (F : C ⥤ C) [F.Additive] [F.CommShift ℤ] [F.IsTriangulated]
    (η : 𝟭 C ⟶ F) (hη : ∀ X, IsIso (η.app (F.obj X)))
    (hFη : ∀ X, IsIso (F.map (η.app X))) (X : C) :
    ∃ (T : Triangle C), T ∈ distTriang C ∧ T.obj₂ = X ∧
      T.obj₃ = F.obj X ∧ IsZero (F.obj T.obj₁) ∧
      ∀ W, IsZero (F.obj W) →
        Function.Bijective (fun g : W ⟶ T.obj₁ => g ≫ T.mor₁) := by
  obtain ⟨Z, g, h, hT⟩ := distinguished_cocone_triangle (η.app X)
  let T := (Triangle.mk (η.app X) g h).invRotate
  have hT' : T ∈ distTriang C := inv_rot_of_distTriang _ hT
  refine ⟨T, hT', rfl, rfl, ?_, ?_⟩
  · exact Triangle.isZero₁_of_isIso₂ _ (F.map_distinguished _ hT') (hFη X)
  · intro W hW
    have hz : ∀ k : W ⟶ T.obj₃, k = 0 :=
      hom_eq_zero_of_localization F η hη hW
    have hz' : ∀ k : W ⟶ T.obj₃⟦(-1 : ℤ)⟧, k = 0 := fun k =>
      (cancel_mono ((F.commShiftIso (-1)).app X).inv).1
        ((hom_eq_zero_of_localization F η hη hW _).trans zero_comp.symm)
    have hker : ∀ k : W ⟶ T.obj₁, k ≫ T.mor₁ = 0 → k = 0 := by
      intro k hk
      obtain ⟨k', hk'⟩ := Triangle.coyoneda_exact₂ T.invRotate
        (inv_rot_of_distTriang _ hT') k hk
      rw [hk', hz' k']
      exact zero_comp
    refine ⟨fun k l hkl => sub_eq_zero.1 (hker _ ?_), fun k => ?_⟩
    · rw [Preadditive.sub_comp, sub_eq_zero]
      exact hkl
    · obtain ⟨l, hl⟩ := Triangle.coyoneda_exact₂ T hT' k (hz _)
      exact ⟨l, hl.symm⟩

/-- Iterating `exists_fiber_localization` over a finite family of abstract localization
functors, each preserving the kernels of the others, produces a coreflection of `C` onto the
full subcategory of objects killed by every member of the family. -/
lemma exists_finite_localization_coreflection
    {ι : Type*} (F : ι → C ⥤ C) [∀ i, (F i).Additive]
    [∀ i, (F i).CommShift ℤ] [∀ i, (F i).IsTriangulated]
    (η : ∀ i, 𝟭 C ⟶ F i)
    (hη : ∀ i X, IsIso ((η i).app ((F i).obj X)))
    (hFη : ∀ i X, IsIso ((F i).map ((η i).app X)))
    (hpres : ∀ i j X, IsZero ((F j).obj X) →
      IsZero ((F j).obj ((F i).obj X))) (s : Finset ι) (X : C) :
    ∃ (Y : C) (a : Y ⟶ X), (∀ i ∈ s, IsZero ((F i).obj Y)) ∧
      ∀ W, (∀ i ∈ s, IsZero ((F i).obj W)) →
        Function.Bijective (fun g : W ⟶ Y => g ≫ a) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨X, 𝟙 X, by simp, ?_⟩
    intro W _
    exact ⟨fun _ _ h => by simpa only [Category.comp_id] using h,
      fun g => ⟨g, Category.comp_id g⟩⟩
  | @insert i s hi ih =>
    obtain ⟨U, b, hU, hb⟩ := ih
    obtain ⟨T, hT, h₂, h₃, hFT, ha⟩ :=
      exists_fiber_localization (F i) (η i) (hη i) (hFη i) U
    let e : T.obj₂ ≅ U := eqToIso h₂
    refine ⟨T.obj₁, T.mor₁ ≫ e.hom ≫ b, ?_, ?_⟩
    · intro j hj
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact hFT
      · apply Triangle.isZero₁_of_isZero₂₃ _ ((F j).map_distinguished _ hT)
        · exact (hU j hj).of_iso ((F j).mapIso e)
        · rw [show ((F j).mapTriangle.obj T).obj₃ = (F j).obj T.obj₃ from rfl, h₃]
          exact hpres i j U (hU j hj)
    · intro W hW
      have h₁ := ha W (hW i (Finset.mem_insert_self _ _))
      have h₂' : Function.Bijective (fun g : W ⟶ T.obj₂ => g ≫ e.hom) :=
        ⟨fun _ _ h => (cancel_mono e.hom).1 h,
          fun g => ⟨g ≫ e.inv, by simp⟩⟩
      have h₃' := hb W (fun j hj => hW j (Finset.mem_insert_of_mem hj))
      simpa only [Function.comp_def, Category.assoc] using h₃'.comp (h₂'.comp h₁)

end Triangulated

section DerivedUnit

variable {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]
    (F : C ⥤ C) [F.Additive] [PreservesFiniteLimits F] [PreservesFiniteColimits F]
    (η : 𝟭 C ⟶ F)

/-- The unit of an endofunctor of an abelian category, applied degreewise to cochain
complexes. -/
def complexUnit : 𝟭 (CochainComplex C ℤ) ⟶
    F.mapHomologicalComplex (ComplexShape.up ℤ) where
  app K := { f i := η.app (K.X i)
             comm' i j _ := (η.naturality (K.d i j)).symm }
  naturality {K L} f := by ext i; exact (η.naturality (f.f i))

/-- The unit induced on the derived category by the degreewise unit of an exact endofunctor. -/
def derivedUnit : 𝟭 (DerivedCategory C) ⟶ F.mapDerivedCategory :=
  Localization.liftNatTrans DerivedCategory.Q (HomologicalComplex.quasiIso C (.up ℤ))
    DerivedCategory.Q (F.mapHomologicalComplex (.up ℤ) ⋙ DerivedCategory.Q)
    (𝟭 (DerivedCategory C)) F.mapDerivedCategory
    (Functor.whiskerRight (complexUnit F η) DerivedCategory.Q)

/-- The derived unit evaluated at the image of a cochain complex is the image of the degreewise
unit, up to the comparison identifying the derived functor. -/
lemma derivedUnit_app_Q (K : CochainComplex C ℤ) :
    (derivedUnit F η).app (DerivedCategory.Q.obj K) =
      DerivedCategory.Q.map ((complexUnit F η).app K) ≫
        F.mapDerivedCategoryFactors.inv.app K := by
  simp [derivedUnit, Localization.liftNatTrans_app, Localization.Lifting.iso]

/-- Invertibility of the component of a natural transformation transports along an isomorphism
of the object. -/
lemma isIso_app_of_iso {C' D : Type*} [Category C'] [Category D] {G H : C' ⥤ D}
    (τ : G ⟶ H) {X Y : C'} (e : X ≅ Y) (h : IsIso (τ.app Y)) : IsIso (τ.app X) := by
  let := h
  have : IsIso (τ.app X ≫ H.map e.hom) := by
    rw [← τ.naturality]
    infer_instance
  exact (isIso_comp_right_iff (τ.app X) (H.map e.hom)).mp inferInstance

/-- A natural transformation out of `DerivedCategory C` is invertible at every object as soon as
it is invertible at the image of every cochain complex. -/
private lemma isIso_app_of_forall_Q_obj {D : Type*} [Category D] {G H : DerivedCategory C ⥤ D}
    (τ : G ⟶ H) (h : ∀ K, IsIso (τ.app (DerivedCategory.Q.obj K))) (X : DerivedCategory C) :
    IsIso (τ.app X) :=
  isIso_app_of_iso τ (DerivedCategory.Q.objObjPreimageIso X).symm (h _)

/-- If the degreewise unit is invertible on the image of `F`, so is the derived unit. -/
lemma derivedUnit_obj_isIso
    (hη : ∀ X, IsIso (η.app (F.obj X))) (X : DerivedCategory C) :
    IsIso ((derivedUnit F η).app (F.mapDerivedCategory.obj X)) := by
  refine isIso_app_of_forall_Q_obj (Functor.whiskerLeft F.mapDerivedCategory (derivedUnit F η))
    (fun K => ?_) X
  suffices h : IsIso ((derivedUnit F η).app
      (DerivedCategory.Q.obj ((F.mapHomologicalComplex (.up ℤ)).obj K))) from
    isIso_app_of_iso (derivedUnit F η) (F.mapDerivedCategoryFactors.app K) h
  rw [derivedUnit_app_Q]
  have : IsIso ((complexUnit F η).app ((F.mapHomologicalComplex (.up ℤ)).obj K)) := by
    let : ∀ i, IsIso (((complexUnit F η).app
      ((F.mapHomologicalComplex (.up ℤ)).obj K)).f i) := fun i => hη (K.X i)
    exact HomologicalComplex.Hom.isIso_of_components _
  infer_instance

/-- If `F` sends the degreewise unit to an isomorphism, it sends the derived unit to an
isomorphism. -/
lemma derivedUnit_map_isIso
    (hη : ∀ X, IsIso (F.map (η.app X))) (X : DerivedCategory C) :
    IsIso (F.mapDerivedCategory.map ((derivedUnit F η).app X)) := by
  refine isIso_app_of_forall_Q_obj (Functor.whiskerRight (derivedUnit F η) F.mapDerivedCategory)
    (fun K => ?_) X
  change IsIso (F.mapDerivedCategory.map ((derivedUnit F η).app (DerivedCategory.Q.obj K)))
  rw [derivedUnit_app_Q, Functor.map_comp]
  have : IsIso ((F.mapHomologicalComplex (.up ℤ)).map ((complexUnit F η).app K)) := by
    let : ∀ i, IsIso (((F.mapHomologicalComplex (.up ℤ)).map
      ((complexUnit F η).app K)).f i) := fun i => hη (K.X i)
    exact HomologicalComplex.Hom.isIso_of_components _
  have : IsIso (F.mapDerivedCategory.map
      (DerivedCategory.Q.map ((complexUnit F η).app K))) := by
    apply (NatIso.isIso_map_iff F.mapDerivedCategoryFactors _).mpr
    change IsIso (DerivedCategory.Q.map
      ((F.mapHomologicalComplex (.up ℤ)).map ((complexUnit F η).app K)))
    infer_instance
  infer_instance

end DerivedUnit

section Vanishing

/-- An object is zero exactly when its zero endomorphism is an isomorphism. -/
lemma isZero_iff_zero_isIso {D : Type*} [Category D] [HasZeroMorphisms D] (Y : D) :
    IsZero Y ↔ IsIso (0 : Y ⟶ Y) := by
  rw [IsZero.iff_id_eq_zero]
  exact ⟨fun h => (isIsoZeroSelfEquiv Y).symm h, fun h => isIsoZeroSelfEquiv Y h⟩

/-- An object of a derived category is zero exactly when all of its cohomology objects are. -/
lemma isZero_iff_homology
    {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C] (X : DerivedCategory C) :
    IsZero X ↔ ∀ i, IsZero ((DerivedCategory.homologyFunctor C i).obj X) := by
  rw [isZero_iff_zero_isIso, DerivedCategory.isIso_iff]
  simp only [Functor.map_zero, ← isZero_iff_zero_isIso]

end Vanishing

end Dualizing.Coreflection
