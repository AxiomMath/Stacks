module

public import StacksFrontier.RingTheory.CompleteIntersection.RingMap.WeaklyRegularKernel
public import StacksFrontier.RingTheory.Dualizing.UpperShriek.Defs
public import StacksFrontier.RingTheory.MvPolynomial.MonicQuotientTower
public import StacksFrontier.RingTheory.MvPolynomial.MonicSequenceRegular
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The monic quotient of a polynomial ring, and the finite ring maps it presents

For monic `f₀, …, fₙ₋₁` in `R[T]` write

`C = R[T₀, …, Tₙ₋₁]/(f₀(T₀), …, fₙ₋₁(Tₙ₋₁))`.

Every *finite* `φ : R → A` factors as `R → C → A` with the second map surjective: a finite
algebra is generated by finitely many integral elements, and a monic polynomial killing a
generator is exactly the relation imposed in `C`.  This is the factorization the proof of
[Stacks, Tag 0C0G] uses, in the shape in which `C` comes with a presentation by `n` variables
modulo `n` equations — the relations being a weakly regular sequence
(`MvPolynomial.isWeaklyRegular_ofFn_aeval_X_of_monic`), so that `R → C` is a local complete
intersection and `ω_{C/R}` sits in degree `0`.

`Dualizing.nonempty_monicTowerFactorization` is the same factorization with `C` built as an
iterated `AdjoinRoot`; it records finiteness, freeness and self-duality of `C` but no
presentation, which is why the quotient form is given here as well.

## Main definitions

* `Dualizing.monicIdeal` — the ideal `(f₀(T₀), …, fₙ₋₁(Tₙ₋₁))`.
* `Dualizing.quotientPresentation` — the presentation of `R → R[T₀, …, Tₙ₋₁]/I` by the quotient
  map.

## Main results

* `Dualizing.isLocalCompleteIntersection_algebraMap_monicIdeal` — `R → C` is a local complete
  intersection homomorphism.
* `Dualizing.exists_monicIdeal_quotient_surjection` — **a finite ring map factors through a monic
  quotient by a surjection.**

## References

* [Stacks Project, Tag 0C0G](https://stacks.math.columbia.edu/tag/0C0G)
* [Stacks Project, Tag 00GK](https://stacks.math.columbia.edu/tag/00GK)
-/

@[expose] public noncomputable section

open MvPolynomial Polynomial

universe u

namespace Dualizing

variable {R A : Type u} [CommRing R] [CommRing A]

/-- **The ideal generated by one monic polynomial per variable**, `(f₀(T₀), …, fₙ₋₁(Tₙ₋₁))` in
`R[T₀, …, Tₙ₋₁]`.  Its generators are listed in the order of the variables, which is the order in
which they form a weakly regular sequence. -/
def monicIdeal (n : ℕ) (f : Fin n → Polynomial R) : Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range fun i =>
    Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin n) R) (f i))

/-- The generators of `Dualizing.monicIdeal`, read as a list in the order of the variables: that
is the form in which weak regularity of the sequence is stated. -/
theorem monicIdeal_eq_ofList (n : ℕ) (f : Fin n → Polynomial R) :
    monicIdeal n f = Ideal.ofList (List.ofFn fun i =>
      Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin n) R) (f i)) :=
  congrArg Ideal.span (Set.ext fun x => (List.mem_ofFn' _ x).symm)

/-- **The presentation of a quotient of a polynomial ring by its quotient map.**  The number of
variables is the number of variables of the polynomial ring, and the surjection is
`Ideal.Quotient.mk`. -/
def quotientPresentation (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) :
    PolynomialPresentation (algebraMap R (MvPolynomial (Fin n) R ⧸ I)) where
  variableCount := n
  toRingHom := Ideal.Quotient.mk I
  commutes := rfl
  surjective := Ideal.Quotient.mk_surjective

/-- The kernel of a quotient map is the ideal, read through `Ideal.Quotient.mk`. -/
private theorem ker_quotient_mk {P : Type u} [CommRing P] (I : Ideal P) :
    RingHom.ker (Ideal.Quotient.mk I) = I :=
  Ideal.mk_ker

/-- The kernel of the surjection of `Dualizing.quotientPresentation` is the ideal divided out. -/
theorem ker_quotientPresentation (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R)) :
    RingHom.ker (quotientPresentation n I).toRingHom = I :=
  ker_quotient_mk I

/-- **A monic quotient is a local complete intersection over the coefficient ring.**  The kernel
of the quotient presentation is generated by `f₀(T₀), …, fₙ₋₁(Tₙ₋₁)`, a weakly regular sequence by
`MvPolynomial.isWeaklyRegular_ofFn_aeval_X_of_monic`, so
`RingHom.isLocalCompleteIntersection_of_isWeaklyRegular_ker` applies. -/
theorem isLocalCompleteIntersection_algebraMap_monicIdeal (n : ℕ) (f : Fin n → Polynomial R)
    (hf : ∀ i, (f i).Monic) :
    (algebraMap R (MvPolynomial (Fin n) R ⧸ monicIdeal n f)).IsLocalCompleteIntersection :=
  RingHom.isLocalCompleteIntersection_of_isWeaklyRegular_ker _ n
    (Ideal.Quotient.mk (monicIdeal n f)) rfl Ideal.Quotient.mk_surjective
    (MvPolynomial.isWeaklyRegular_ofFn_aeval_X_of_monic n f hf)
    ((ker_quotientPresentation n (monicIdeal n f)).trans (monicIdeal_eq_ofList n f))

/-- **A monic quotient is finite and free over the coefficient ring, and is its own linear
dual.**  This is
`MvPolynomial.finite_free_selfDual_quotient_span_range_aeval_X_of_monic` read at
`Dualizing.monicIdeal`.  These are the three properties the proof of [Stacks, Tag 0C0G] needs of
the intermediate algebra. -/
@[ega "0 10.3.1.2" "more general", ega "0 22.4.1" "(i)"]
theorem finite_free_selfDual_monicIdeal (n : ℕ) (f : Fin n → Polynomial R)
    (hf : ∀ i, (f i).Monic) :
    Module.Finite R (MvPolynomial (Fin n) R ⧸ monicIdeal n f) ∧
      Module.Free R (MvPolynomial (Fin n) R ⧸ monicIdeal n f) ∧
      IsSelfDualAlgebra R (MvPolynomial (Fin n) R ⧸ monicIdeal n f) :=
  MvPolynomial.finite_free_selfDual_quotient_span_range_aeval_X_of_monic n f hf

/-- **A finite ring map factors through a monic quotient by a surjection.**  Let `φ : R → A` be
finite.  Then there are monic `f₀, …, fₙ₋₁` in `R[T]` and a surjection
`R[T₀, …, Tₙ₋₁]/(f₀(T₀), …, fₙ₋₁(Tₙ₋₁)) → A` whose composite with the structure map is `φ`.

`A` is a finite `R`-module, so finitely many of its elements span it; they generate it as an
algebra and each is integral over `R` ([Stacks, Tag 00GK]), so a monic polynomial over `R` kills
each of them.  Sending `Tᵢ` to the `i`-th of them is therefore a surjection from the polynomial
ring which kills `fᵢ(Tᵢ)`, and it factors through the quotient. -/
theorem exists_monicIdeal_quotient_surjection (φ : R →+* A) (hφ : φ.Finite) :
    ∃ (n : ℕ) (f : Fin n → Polynomial R), (∀ i, (f i).Monic) ∧
      ∃ ψ : (MvPolynomial (Fin n) R ⧸ monicIdeal n f) →+* A, Function.Surjective ψ ∧
        ψ.comp (algebraMap R (MvPolynomial (Fin n) R ⧸ monicIdeal n f)) = φ := by
  let : Algebra R A := φ.toAlgebra
  have : Module.Finite R A := hφ
  have : Algebra.IsIntegral R A := Algebra.IsIntegral.of_finite R A
  obtain ⟨n, a, hs⟩ := Module.Finite.exists_fin (R := R) (M := A)
  have htop : Algebra.adjoin R (Set.range a) = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    have hsub : Submodule.span R (Set.range a) ≤
        Subalgebra.toSubmodule (Algebra.adjoin R (Set.range a)) :=
      Submodule.span_le.mpr Algebra.subset_adjoin
    exact hsub (hs ▸ Submodule.mem_top)
  choose f hfm hfz using fun i => Algebra.IsIntegral.isIntegral (R := R) (a i)
  refine ⟨n, f, hfm, ?_⟩
  have hsurj : Function.Surjective
      (MvPolynomial.aeval a : MvPolynomial (Fin n) R →ₐ[R] A) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, htop]
  have hle : monicIdeal n f ≤ RingHom.ker (MvPolynomial.aeval a).toRingHom := by
    rw [monicIdeal, Ideal.span_le, Set.range_subset_iff]
    intro i
    change (MvPolynomial.aeval a) _ = 0
    rw [← Polynomial.aeval_algHom_apply (MvPolynomial.aeval a) (MvPolynomial.X i) (f i),
      MvPolynomial.aeval_X, Polynomial.aeval_def]
    exact hfz i
  refine ⟨Ideal.Quotient.lift _ (MvPolynomial.aeval a).toRingHom hle, ?_, ?_⟩
  · intro x
    obtain ⟨y, rfl⟩ := hsurj x
    exact ⟨Ideal.Quotient.mk _ y, rfl⟩
  · ext r
    change (MvPolynomial.aeval a) (MvPolynomial.C r) = φ r
    rw [MvPolynomial.aeval_C, RingHom.algebraMap_toAlgebra]

end Dualizing

end
