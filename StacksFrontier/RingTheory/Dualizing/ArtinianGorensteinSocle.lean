module

public import StacksFrontier.Algebra.Module.InjectiveHull.Basic
public import StacksFrontier.RingTheory.Dualizing.Gorenstein
import StacksFrontier.RingTheory.Dualizing.Artinian
import StacksFrontier.RingTheory.Dualizing.NormalizedZeroDimensional

/-!
# The socle of an Artinian Gorenstein local ring

Let `(C, 𝔪, κ)` be a Noetherian local ring of dimension zero which is Gorenstein. Then `C`, as a
module over itself, is an injective hull of `κ`: the dualizing complex `C[0]` is a shift of
`E[0]` for an injective hull `E` of `κ` ([Stacks, Tag 0A7R]), and comparing cohomology the shift is
zero. Since `κ ⊆ E` is essential, any two nonzero elements of `C` killed by `𝔪` generate the same
ideal: the socle `(0 : 𝔪)` of `C` is one-dimensional. In particular, if `𝔪² = 0` then `𝔪` is
principal.

## Main results

* `Dualizing.IsGorensteinLocalRing.mem_span_singleton_of_mul_eq_zero`: two elements of the socle
  of a zero-dimensional Gorenstein local ring, the first nonzero, generate nested ideals.
* `Dualizing.IsGorensteinLocalRing.exists_maximalIdeal_eq_span_singleton`: a zero-dimensional
  Gorenstein local ring whose maximal ideal squares to zero has principal maximal ideal.

## References

* [Stacks Project, Tag 0A7R](https://stacks.math.columbia.edu/tag/0A7R)
-/

@[expose] public section

open CategoryTheory IsLocalRing

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Dualizing

variable {C : Type u} [CommRing C] [IsNoetherianRing C] [IsLocalRing C]

/-- **A zero-dimensional Gorenstein local ring is an injective hull of its residue field**, as a
module over itself: there is an essential monomorphism from the residue field into a module
isomorphic to the ring. -/
theorem IsGorensteinLocalRing.exists_isInjectiveHull_iso_self (hC : IsGorensteinLocalRing C)
    (hdim : ringKrullDim C = 0) :
    ∃ (E : ModuleCat.{u} C)
      (i : (ModuleCat.uliftFunctor.{0} C).obj (ModuleCat.of C (ResidueField C)) ⟶ E)
      (_ : Mono i), Module.IsInjectiveHull i ∧ Nonempty (ModuleCat.of C C ≅ E) := by
  obtain ⟨E, i, hmono, hi⟩ := Module.exists_isInjectiveHull.{u, 0} C
    ((ModuleCat.uliftFunctor.{0} C).obj (ModuleCat.of C (ResidueField C)))
  refine ⟨E, i, hmono, hi, ?_⟩
  let K : DerivedCategory (ModuleCat.{u} C) :=
    (DerivedCategory.singleFunctor (ModuleCat.{u} C) 0).obj (ModuleCat.of C C)
  obtain ⟨n, ⟨e⟩⟩ := exists_shift_iso_single_injectiveHull_of_ringKrullDim_eq_zero.{u, 0}
    K hC hdim E i hi
  let H0 := DerivedCategory.homologyFunctor (ModuleCat.{u} C) 0
  have hK : H0.obj K ≅ ModuleCat.of C C :=
    (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} C) 0).app _
  have hn : n = 0 := by
    by_contra hn
    let S := (DerivedCategory.singleFunctor (ModuleCat.{u} C) 0).obj E
    have : (S⟦n⟧).IsGE (-n) := DerivedCategory.TStructure.t.isGE_shift S 0 n (-n) (by omega)
    have : (S⟦n⟧).IsLE (-n) := DerivedCategory.TStructure.t.isLE_shift S 0 n (-n) (by omega)
    have hz : Limits.IsZero (H0.obj (S⟦n⟧)) := by
      rcases lt_or_gt_of_ne (show (0 : ℤ) ≠ -n by omega) with h | h
      · exact DerivedCategory.isZero_of_isGE _ (-n) 0 h
      · exact DerivedCategory.isZero_of_isLE _ (-n) 0 h
    have hz' : Limits.IsZero (ModuleCat.of C C) := (hz.of_iso (H0.mapIso e)).of_iso hK.symm
    exact one_ne_zero (ModuleCat.isZero_iff_subsingleton.mp hz' |>.elim (1 : C) 0)
  subst hn
  exact ⟨hK.symm ≪≫ H0.mapIso (e ≪≫ (shiftFunctorZero _ ℤ).app _) ≪≫
    (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} C) 0).app E⟩

omit [IsNoetherianRing C] in
/-- In a cyclic module generated by an element killed by `𝔪`, every nonzero element generates. -/
private theorem span_singleton_eq_of_mem {M : Type*} [AddCommGroup M] [Module C M] {w z : M}
    (hw : ∀ c ∈ maximalIdeal C, c • w = 0) (hz : z ∈ Submodule.span C {w}) (hz0 : z ≠ 0) :
    Submodule.span C {z} = Submodule.span C {w} := by
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hz
  have hc : c ∉ maximalIdeal C := fun hc => hz0 (hw c hc)
  obtain ⟨u, rfl⟩ := (mem_maximalIdeal _ |>.not.mp hc |> not_not.mp : IsUnit c)
  exact Submodule.span_singleton_group_smul_eq C u w

/-- **The socle of a zero-dimensional Gorenstein local ring is one-dimensional.** If `x ≠ 0` and
`y` are both killed by the maximal ideal, then `y` is a multiple of `x`. -/
theorem IsGorensteinLocalRing.mem_span_singleton_of_mul_eq_zero (hC : IsGorensteinLocalRing C)
    (hdim : ringKrullDim C = 0) {x y : C} (hx0 : x ≠ 0)
    (hx : ∀ c ∈ maximalIdeal C, c * x = 0) (hy : ∀ c ∈ maximalIdeal C, c * y = 0) :
    y ∈ Ideal.span {x} := by
  by_cases hy0 : y = 0
  · rw [hy0]; exact Ideal.zero_mem _
  obtain ⟨E, i, hmono, hi, ⟨φ⟩⟩ := hC.exists_isInjectiveHull_iso_self hdim
  let ψ : C ≃ₗ[C] E := φ.toLinearEquiv
  have hess : ∀ N : Submodule C E, N ≠ ⊥ → N ⊓ LinearMap.range i.hom ≠ ⊥ := by
    intro N hN
    let e : Subobject E ≃o Submodule C E := ModuleCat.subobjectModule E
    have hS : e.symm N ≠ ⊥ := by
      intro h
      apply hN
      calc N = e (e.symm N) := (e.apply_symm_apply N).symm
        _ = ⊥ := by rw [h, e.map_bot]
    have h := hi.2 (e.symm N) hS
    intro hz
    apply h
    apply e.injective
    rw [e.map_inf, e.map_bot, e.apply_symm_apply]
    change N ⊓ (ModuleCat.subobjectModule E) (Subobject.mk i) = ⊥
    rw [subobjectModule_mk_eq_range i]
    exact hz
  -- a nonzero socle element `w` of `C` gives a point of the image of the residue field
  have hpt : ∀ w : C, w ≠ 0 → (∀ c ∈ maximalIdeal C, c * w = 0) →
      ∃ u, u ≠ 0 ∧ Submodule.span C {i.hom u} = Submodule.span C {ψ w} := by
    intro w hw0 hw
    have hψw : ∀ c ∈ maximalIdeal C, c • ψ w = 0 := fun c hc => by
      rw [← map_smul, smul_eq_mul, hw c hc, map_zero]
    have hne : Submodule.span C {ψ w} ≠ ⊥ := by
      rw [Ne, Submodule.span_singleton_eq_bot]
      exact fun h => hw0 (ψ.injective (h.trans ψ.map_zero.symm))
    obtain ⟨z, hz, hz0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (hess _ hne)
    obtain ⟨u, hu⟩ := (Submodule.mem_inf.mp hz).2
    refine ⟨u, fun h => hz0 (by rw [← hu, h, map_zero]), ?_⟩
    rw [hu]
    exact span_singleton_eq_of_mem hψw (Submodule.mem_inf.mp hz).1 hz0
  obtain ⟨u, hu0, hux⟩ := hpt x hx0 hx
  obtain ⟨u', -, huy⟩ := hpt y hy0 hy
  -- the image of the residue field is one-dimensional
  obtain ⟨c, hc⟩ : ∃ c : C, c • u = u' := by
    obtain ⟨c, hc⟩ := residue_surjective (u'.down * u.down⁻¹)
    refine ⟨c, ULift.ext ?_⟩
    have hu0' : u.down ≠ 0 := fun h => hu0 (ULift.ext h)
    change residue C c * u.down = u'.down
    rw [hc, mul_assoc, inv_mul_cancel₀ hu0', mul_one]
  have hmem : ψ y ∈ Submodule.span C {ψ x} := by
    have h1 : ψ y ∈ Submodule.span C {i.hom u'} := huy ▸ Submodule.mem_span_singleton_self _
    rw [← hux]
    rw [← hc, map_smul] at h1
    exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr
      (Submodule.smul_mem _ c (Submodule.mem_span_singleton_self _))) h1
  obtain ⟨d, hd⟩ := Submodule.mem_span_singleton.mp hmem
  rw [← map_smul] at hd
  exact Ideal.mem_span_singleton'.mpr ⟨d, by simpa [smul_eq_mul] using ψ.injective hd⟩

/-- **A zero-dimensional Gorenstein local ring whose maximal ideal squares to zero has principal
maximal ideal.** Every element of the maximal ideal lies in the socle, which is
one-dimensional. -/
theorem IsGorensteinLocalRing.exists_maximalIdeal_eq_span_singleton
    (hC : IsGorensteinLocalRing C) (hdim : ringKrullDim C = 0)
    (hsq : maximalIdeal C ^ 2 = ⊥) : ∃ x : C, maximalIdeal C = Ideal.span {x} := by
  have hsoc : ∀ y ∈ maximalIdeal C, ∀ c ∈ maximalIdeal C, c * y = 0 := fun y hy c hc => by
    have := Ideal.mul_mem_mul hc hy
    rwa [← pow_two, hsq, Ideal.mem_bot] at this
  by_cases hbot : maximalIdeal C = ⊥
  · exact ⟨0, by rw [hbot, Ideal.span_singleton_eq_bot.mpr rfl]⟩
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
  refine ⟨x, le_antisymm (fun y hy => ?_) ((Ideal.span_singleton_le_iff_mem _).mpr hx)⟩
  exact hC.mem_span_singleton_of_mul_eq_zero hdim hx0 (hsoc x hx) (hsoc y hy)

end Dualizing
