/-!
# Dualizing complexes and a regular element

Let `A` be a Noetherian ring, let `M` be an `A`-module whose placement `M[-n]` in degree `n` is a
dualizing complex, and let `t` be a nonzerodivisor on `A` which is also a nonzerodivisor on `M`.
Then `M ⧸ tM = (A ⧸ (t)) ⊗_A M`, placed in degree `n + 1`, is a dualizing complex over
`A ⧸ (t)`.

The proof has two halves. That `RHom_A(A ⧸ (t), M[-n])` is a dualizing complex over `A ⧸ (t)` is
[Stacks, Tag 0AX0] (`Dualizing.isDualizingComplex_derivedHom_of_finite`), a surjection being a
finite ring map. The content is the identification of that object with
`((A ⧸ (t)) ⊗_A M)[-n-1]`, and it runs as follows. Over `A` the complex
`RHom_A(A ⧸ (t), M[-n])` is the fibre of multiplication by `t` on `M[-n]`
(`Dualizing.exists_distinguishedTriangle_nonZeroDivisor`, the triangle half of
[Stacks, Tag 0A7T]), while the short exact sequence `0 → M → M → (A ⧸ (t)) ⊗_A M → 0` of
`A`-modules — exact because `t` is a nonzerodivisor on `M` — exhibits `((A ⧸ (t)) ⊗_A M)[-n]` as
the cofibre of the same map. Two distinguished triangles on one map have isomorphic third terms,
so after one shift the restriction of `RHom_A(A ⧸ (t), M[-n])` to `A` is
`((A ⧸ (t)) ⊗_A M)[-n-1]`.

That is an identification over `A`, and it has to be upgraded to one over `A ⧸ (t)`. Restriction
of scalars is exact and faithful, so it commutes with cohomology and reflects zero objects: the
cohomology of `RHom_A(A ⧸ (t), M[-n])` is therefore concentrated in degree `n + 1` as a complex of
`A ⧸ (t)`-modules too, which puts it in the image of the degree-`(n+1)` single-complex functor.
The resulting `A ⧸ (t)`-module is then pinned down over `A`, and that is enough: for a *surjective*
ring map `A → B` every `A`-linear map between `B`-modules is already `B`-linear, so the `A`-linear
identification is a `B`-linear one.

## Main results

* `Dualizing.nonempty_iso_derivedHom_single_extendScalars` — the identification
  `RHom_A(A ⧸ (t), M[-n]) ≅ ((A ⧸ (t)) ⊗_A M)[-n-1]` in `D(A ⧸ (t))`.
* `Dualizing.isDualizingComplex_single_extendScalars_quotient_span_singleton` — the dualizing
  statement itself.
* `Dualizing.isDualizingComplex_single_extendScalars_of_ker_eq_span_singleton` — the same, for any
  Noetherian ring presented as a quotient of `A` by a principal ideal generated by a
  nonzerodivisor, rather than literally `A ⧸ (t)`.
* `Dualizing.nonempty_iso_restrictScalars_derivedHom_single` — the identification over `A`, which
  is where the concentration in degree `n + 1` comes from.

## Implementation notes

Derived categories are at `HasDerivedCategory.standard`, forced by `Dualizing.derivedHom`, which
bakes that model into its own type.

`Dualizing.isDualizingComplex_of_iso` is `private` where it is proved, in
`StacksFrontier/RingTheory/Dualizing/DualizingComplexes/PolynomialBaseChange.lean`, and is reached
here by `import all` rather than restated, exactly as
`StacksFrontier/RingTheory/Dualizing/LocalizationAwayDualizing.lean` reaches it.

The reduction map `M → (A ⧸ (t)) ⊗_A M` is written through
`TensorProduct.quotTensorEquivQuotSMul`, which makes both its kernel and its surjectivity
immediate; the `A`-module underlying `ModuleCat.extendScalars` is the one that equivalence talks
about, so no comparison of scalar actions is needed.

## References

* [Stacks Project, Tag 0A7B](https://stacks.math.columbia.edu/tag/0A7B)
* [Stacks Project, Tag 0A7T](https://stacks.math.columbia.edu/tag/0A7T)
* [Stacks Project, Tag 0AX0](https://stacks.math.columbia.edu/tag/0AX0)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated TensorProduct

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Dualizing

section Auxiliary

variable {A B : Type u} [CommRing A] [CommRing B]

/-- Restriction of scalars commutes with the cohomology functors of the derived category and
reflects zero objects, so a cohomology module that vanishes over the source ring already
vanishes over the target ring. -/
theorem isZero_homologyFunctor_obj_of_restrictScalars (q : A →+* B)
    (X : DerivedCategory (ModuleCat.{u} B)) (i : ℤ)
    (h : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
      (((ModuleCat.restrictScalars q).mapDerivedCategory).obj X))) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} B) i).obj X) := by
  let F := ModuleCat.restrictScalars.{u} q
  let e : F.mapHomologicalComplex (ComplexShape.up ℤ) ⋙
      HomologicalComplex.homologyFunctor (ModuleCat.{u} A) (ComplexShape.up ℤ) i ≅
      HomologicalComplex.homologyFunctor (ModuleCat.{u} B) (ComplexShape.up ℤ) i ⋙ F :=
    NatIso.ofComponents (fun P ↦ (P.sc i).mapHomologyIso F) (fun φ ↦
      ShortComplex.mapHomologyIso_hom_naturality
        ((HomologicalComplex.shortComplexFunctor (ModuleCat.{u} B)
          (ComplexShape.up ℤ) i).map φ) F)
  let E : F.mapDerivedCategory ⋙ DerivedCategory.homologyFunctor (ModuleCat.{u} A) i ≅
      DerivedCategory.homologyFunctor (ModuleCat.{u} B) i ⋙ F :=
    Localization.liftNatIso DerivedCategory.Q
      (HomologicalComplex.quasiIso (ModuleCat.{u} B) (ComplexShape.up ℤ))
      (DerivedCategory.Q ⋙ (F.mapDerivedCategory ⋙
        DerivedCategory.homologyFunctor (ModuleCat.{u} A) i))
      (DerivedCategory.Q ⋙ (DerivedCategory.homologyFunctor (ModuleCat.{u} B) i ⋙ F)) _ _
      (Functor.isoWhiskerRight F.mapDerivedCategoryFactors
          (DerivedCategory.homologyFunctor (ModuleCat.{u} A) i) ≪≫
        Functor.associator _ _ _ ≪≫
        Functor.isoWhiskerLeft (F.mapHomologicalComplex (ComplexShape.up ℤ))
          (DerivedCategory.homologyFunctorFactors (ModuleCat.{u} A) i) ≪≫ e ≪≫
        Functor.isoWhiskerRight
          (DerivedCategory.homologyFunctorFactors (ModuleCat.{u} B) i).symm F)
  have h2 : IsZero (F.obj ((DerivedCategory.homologyFunctor (ModuleCat.{u} B) i).obj X)) :=
    h.of_iso (E.app X).symm
  rw [ModuleCat.isZero_iff_subsingleton] at h2 ⊢; assumption

/-- For a **surjective** ring map `q : A → B`, an `A`-linear isomorphism between two `B`-modules
is automatically `B`-linear: every scalar `b` is `q a` for some `a`, and `b • y = a • y` for the
restricted action. -/
theorem nonempty_iso_of_restrictScalars_iso (q : A →+* B) (hq : Function.Surjective q)
    {Y W : ModuleCat.{u} B}
    (e : (ModuleCat.restrictScalars q).obj Y ≅ (ModuleCat.restrictScalars q).obj W) :
    Nonempty (Y ≅ W) := by
  let eL := e.toLinearEquiv
  have hsmul : ∀ (b : B) (y : Y), eL (b • y) = b • eL y := by
    intro b y
    obtain ⟨a, rfl⟩ := hq b
    exact eL.map_smul a y
  exact ⟨LinearEquiv.toModuleIso
    ({ eL with map_smul' := hsmul } : (Y : Type u) ≃ₗ[B] (W : Type u))⟩

/-- The single-complex functor on cochain complexes is compatible with multiplication by a ring
element: it carries `t • 𝟙` to `t • 𝟙`. -/
theorem single_map_smul_id (M : ModuleCat.{u} A) (t : A) (n : ℤ) :
    (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) n).map (t • 𝟙 M) =
      t • 𝟙 ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) n).obj M) := by
  refine HomologicalComplex.hom_ext _ _ fun i => ?_
  obtain rfl | h := eq_or_ne i n
  · rw [HomologicalComplex.single_map_f_self]
    simp [CategoryTheory.Linear.comp_smul, CategoryTheory.Linear.smul_comp]
  · exact (HomologicalComplex.isZero_single_obj_X _ _ _ _ h).eq_of_src _ _

end Auxiliary

section Reduction

variable {A : Type u} [CommRing A]

/-- **The reduction sequence.** For `t` a nonzerodivisor on `M`, the reduction
`M → (A ⧸ (t)) ⊗_A M`, `x ↦ 1 ⊗ x`, sits in a short exact sequence
`0 → M --t--> M → (A ⧸ (t)) ⊗_A M → 0` of `A`-modules.

The map is read through `TensorProduct.quotTensorEquivQuotSMul`, which identifies the extension of
scalars with `M ⧸ tM`; its kernel and its surjectivity are then those of the quotient map. -/
theorem exists_shortExact_smul_extendScalars (M : ModuleCat.{u} A) (t : A)
    (htM : IsSMulRegular M t) :
    ∃ (g : M ⟶ (ModuleCat.restrictScalars (Ideal.Quotient.mk (Ideal.span {t}))).obj
          ((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {t}))).obj M))
        (hg : (t • 𝟙 M) ≫ g = 0), (ShortComplex.mk (t • 𝟙 M) g hg).ShortExact := by
  let L : (M : Type u) →ₗ[A] ((A ⧸ Ideal.span {t}) ⊗[A] (M : Type u)) :=
    (TensorProduct.quotTensorEquivQuotSMul (M : Type u)
        (Ideal.span {t})).symm.toLinearMap ∘ₗ
      Submodule.mkQ (Ideal.span {t} • (⊤ : Submodule A (M : Type u)))
  have hmem : ∀ y : (M : Type u),
      y ∈ Ideal.span {t} • (⊤ : Submodule A (M : Type u)) ↔ ∃ x : (M : Type u), t • x = y := by
    intro y
    rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists]
    exact ⟨fun ⟨z, _, hz⟩ => ⟨z, hz⟩, fun ⟨z, hz⟩ => ⟨z, Submodule.mem_top, hz⟩⟩
  have hLker : ∀ y : (M : Type u), L y = 0 ↔ ∃ x : (M : Type u), t • x = y := by
    intro y
    rw [← hmem y, ← Submodule.Quotient.mk_eq_zero]
    exact (TensorProduct.quotTensorEquivQuotSMul (M : Type u)
      (Ideal.span {t})).symm.map_eq_zero_iff
  have hLsurj : Function.Surjective L :=
    (TensorProduct.quotTensorEquivQuotSMul (M : Type u)
      (Ideal.span {t})).symm.surjective.comp (Submodule.mkQ_surjective _)
  refine ⟨ModuleCat.ofHom (Y := (A ⧸ Ideal.span {t}) ⊗[A] (M : Type u)) L, ?_, ?_⟩
  · ext x
    exact (hLker (t • x)).mpr ⟨x, rfl⟩
  · refine ModuleCat.shortComplex_shortExact _ ?_ htM hLsurj
    exact fun y => (hLker y).trans ⟨fun ⟨x, hx⟩ => ⟨x, hx⟩, fun ⟨x, hx⟩ => ⟨x, hx⟩⟩

end Reduction

section Main

variable {A : Type u} [CommRing A]

/-- **The identification over `A`.** If `M[-n]` has finite injective dimension and `t` is a
nonzerodivisor on `A` and on `M`, then `RHom_A(A ⧸ (t), M[-n])`, read as a complex of
`A`-modules, is `((A ⧸ (t)) ⊗_A M)[-n-1]`.

Both sides are the third term of a distinguished triangle on multiplication by `t` on `M[-n]`:
the left one as a fibre, by the triangle half of [Stacks, Tag 0A7T], the right one as a cofibre,
by the short exact sequence `0 → M → M → (A ⧸ (t)) ⊗_A M → 0`. -/
theorem nonempty_iso_restrictScalars_derivedHom_single (M : ModuleCat.{u} A) (n : ℤ) (t : A)
    (ht : t ∈ nonZeroDivisors A) (htM : IsSMulRegular M t)
    (hfid : StacksDraft.InjectiveDimension.HasFiniteInjectiveDimension
      ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M)) :
    Nonempty (((ModuleCat.restrictScalars
          (Ideal.Quotient.mk (Ideal.span {t}))).mapDerivedCategory).obj
        ((derivedHom.{u, u} (Ideal.Quotient.mk (Ideal.span {t}))).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M)) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} A) (n + 1)).obj
        ((ModuleCat.restrictScalars (Ideal.Quotient.mk (Ideal.span {t}))).obj
          ((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {t}))).obj M))) := by
  set K := (DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M
  obtain ⟨i, δ, hT⟩ := exists_distinguishedTriangle_nonZeroDivisor.{u, u} K hfid t ht
  obtain ⟨g, hg, hS⟩ := exists_shortExact_smul_extendScalars M t htM
  have hSp : ((ShortComplex.mk (t • 𝟙 M) g hg).map
      (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) n)).ShortExact :=
    hS.map_of_exact _
  have hmor : (DerivedCategory.triangleOfSES hSp).mor₁ = t • 𝟙 K := by
    change DerivedCategory.Q.map
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) n).map (t • 𝟙 M)) = _
    rw [single_map_smul_id, Functor.map_smul, DerivedCategory.Q.map_id]
    rfl
  let eT := Pretriangulated.isoTriangleOfIso₁₂ (Triangle.mk i (t • 𝟙 K) δ).rotate
    (DerivedCategory.triangleOfSES hSp) (rot_of_distTriang _ hT)
    (DerivedCategory.triangleOfSES_distinguished hSp) (Iso.refl _) (Iso.refl _) (by
      change (t • 𝟙 K) ≫ 𝟙 K = 𝟙 K ≫ (DerivedCategory.triangleOfSES hSp).mor₁
      rw [hmor, Category.comp_id]
      exact (Category.id_comp _).symm)
  let sh := (DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso 1 n (n + 1) (by ring)
  let u1 := (shiftFunctorCompIsoId (DerivedCategory (ModuleCat.{u} A)) (1 : ℤ) (-1)
    (by ring)).app
  exact ⟨(u1 _).symm ≪≫ (shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (-1 : ℤ)).mapIso
    (Triangle.π₃.mapIso eT ≪≫ (sh.app _).symm) ≪≫ u1 _⟩

/-- **The identification over `A ⧸ (t)`.** For `M[-n]` of finite injective dimension and `t` a
nonzerodivisor on `A` and on `M`, `RHom_A(A ⧸ (t), M[-n])` is `((A ⧸ (t)) ⊗_A M)[-n-1]` in
`D(A ⧸ (t))`.

The identification over `A` already forces the cohomology to be concentrated in degree `n + 1`
over `A ⧸ (t)`, because restriction of scalars commutes with cohomology and reflects zero
objects; and a surjective ring map makes the `A`-linear identification of the single cohomology
module a `A ⧸ (t)`-linear one. -/
theorem nonempty_iso_derivedHom_single_extendScalars (M : ModuleCat.{u} A) (n : ℤ) (t : A)
    (ht : t ∈ nonZeroDivisors A) (htM : IsSMulRegular M t)
    (hfid : StacksDraft.InjectiveDimension.HasFiniteInjectiveDimension
      ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M)) :
    Nonempty ((derivedHom.{u, u} (Ideal.Quotient.mk (Ideal.span {t}))).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} (A ⧸ Ideal.span {t})) (n + 1)).obj
        ((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {t}))).obj M)) := by
  set q : A →+* A ⧸ Ideal.span {t} := Ideal.Quotient.mk (Ideal.span {t})
  set X := (derivedHom.{u, u} q).obj
    ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M)
  obtain ⟨α⟩ := nonempty_iso_restrictScalars_derivedHom_single M n t ht htM hfid
  have hvanish : ∀ j : ℤ, j ≠ n + 1 →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} (A ⧸ Ideal.span {t})) j).obj X) := by
    intro j hj
    refine isZero_homologyFunctor_obj_of_restrictScalars q X j ?_
    refine IsZero.of_iso ?_ ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) j).mapIso α)
    obtain h | h := hj.lt_or_gt
    · exact DerivedCategory.isZero_of_isGE _ (n + 1) j h
    · exact DerivedCategory.isZero_of_isLE _ (n + 1) j h
  have hGE : X.IsGE (n + 1) := by
    rw [DerivedCategory.isGE_iff]
    exact fun j hj => hvanish j hj.ne
  have hLE : X.IsLE (n + 1) := by
    rw [DerivedCategory.isLE_iff]
    exact fun j hj => hvanish j hj.ne'
  obtain ⟨Y, ⟨eY⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE X (n + 1)
  let β := ((ModuleCat.restrictScalars q).mapDerivedCategorySingleFunctor (n + 1)).app Y
  let γ := β.symm ≪≫ ((ModuleCat.restrictScalars q).mapDerivedCategory.mapIso eY).symm ≪≫ α
  obtain ⟨ε⟩ := nonempty_iso_of_restrictScalars_iso q Ideal.Quotient.mk_surjective
    ((DerivedCategory.singleFunctor (ModuleCat.{u} A) (n + 1)).preimageIso γ)
  exact ⟨eY ≪≫ (DerivedCategory.singleFunctor
    (ModuleCat.{u} (A ⧸ Ideal.span {t})) (n + 1)).mapIso ε⟩

/-- **Dividing a dualizing module by a regular element.** Let `A` be a Noetherian ring, let `M`
be an `A`-module whose placement in degree `n` is a dualizing complex, and let `t` be a
nonzerodivisor on `A` which is also a nonzerodivisor on `M`. Then `(A ⧸ (t)) ⊗_A M = M ⧸ tM`,
placed in degree `n + 1`, is a dualizing complex over `A ⧸ (t)`. -/
theorem isDualizingComplex_single_extendScalars_quotient_span_singleton
    [IsNoetherianRing A] (M : ModuleCat.{u} A) (n : ℤ)
    (hM : IsDualizingComplex ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M))
    (t : A) (ht : t ∈ nonZeroDivisors A) (htM : IsSMulRegular M t) :
    letI : IsNoetherianRing (A ⧸ Ideal.span {t}) := inferInstance
    IsDualizingComplex
      ((DerivedCategory.singleFunctor (ModuleCat.{u} (A ⧸ Ideal.span {t})) (n + 1)).obj
        ((ModuleCat.extendScalars (Ideal.Quotient.mk (Ideal.span {t}))).obj M)) := by
  obtain ⟨e⟩ := nonempty_iso_derivedHom_single_extendScalars M n t ht htM
    hM.finiteInjectiveDimension
  exact isDualizingComplex_of_iso e
    (isDualizingComplex_derivedHom_of_finite.{u, u} (Ideal.Quotient.mk (Ideal.span {t}))
      (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective) _ hM)

/-- **Dividing a dualizing module by a regular element, for a presented quotient.** Let `q : A → B`
be a surjection of Noetherian rings whose kernel is generated by a nonzerodivisor `t`, and let `M`
be an `A`-module whose placement in degree `n` is a dualizing complex, with `t` a nonzerodivisor
on `M` as well. Then `B ⊗_A M`, placed in degree `n + 1`, is a dualizing complex over `B`.

This is `Dualizing.isDualizingComplex_single_extendScalars_quotient_span_singleton` carried along
the canonical isomorphism `A ⧸ (t) ≃+* B`, by
`Dualizing.isDualizingComplex_of_ringEquiv` and the functoriality
`ModuleCat.extendScalarsComp` of extension of scalars. It is the form consumers meet in practice,
where `B` is given as a ring of sections rather than as a quotient ring. -/
theorem isDualizingComplex_single_extendScalars_of_ker_eq_span_singleton
    {B : Type u} [CommRing B] [IsNoetherianRing A] [IsNoetherianRing B]
    (q : A →+* B) (hq : Function.Surjective q) (t : A) (ht : t ∈ nonZeroDivisors A)
    (hker : RingHom.ker q = Ideal.span {t}) (M : ModuleCat.{u} A) (n : ℤ)
    (hM : IsDualizingComplex ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj M))
    (htM : IsSMulRegular M t) :
    IsDualizingComplex
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) (n + 1)).obj
        ((ModuleCat.extendScalars q).obj M)) := by
  let φ : (A ⧸ Ideal.span {t}) ≃+* B :=
    (Ideal.quotEquivOfEq hker).symm.trans (RingHom.quotientKerEquivOfSurjective hq)
  have hcomp : (φ : (A ⧸ Ideal.span {t}) →+* B).comp
      (Ideal.Quotient.mk (Ideal.span {t})) = q := by
    refine RingHom.ext fun a => ?_
    change φ (Ideal.Quotient.mk (Ideal.span {t}) a) = q a
    simp only [φ, RingEquiv.coe_trans, Function.comp_apply, Ideal.quotEquivOfEq_symm,
      Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  let : Limits.PreservesFiniteLimits
      (ModuleCat.extendScalars.{u, u, u} (φ : (A ⧸ Ideal.span {t}) →+* B)) :=
    extendScalars_preservesFiniteLimits_of_flat'.{u, u} _
      (RingHom.Flat.of_bijective φ.bijective)
  refine isDualizingComplex_of_iso ?_ (isDualizingComplex_of_ringEquiv φ _
    (isDualizingComplex_single_extendScalars_quotient_span_singleton M n hM t ht htM))
  refine ((ModuleCat.extendScalars
      (φ : (A ⧸ Ideal.span {t}) →+* B)).mapDerivedCategorySingleFunctor (n + 1)).app _ ≪≫
    (DerivedCategory.singleFunctor (ModuleCat.{u} B) (n + 1)).mapIso ?_
  refine ((ModuleCat.extendScalarsComp (Ideal.Quotient.mk (Ideal.span {t}))
    (φ : (A ⧸ Ideal.span {t}) →+* B)).app M).symm ≪≫ ?_
  rw [hcomp]

end Main

end Dualizing

end
