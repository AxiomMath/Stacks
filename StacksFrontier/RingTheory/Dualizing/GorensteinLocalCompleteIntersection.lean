/-!
# Gorenstein rings under local complete intersection homomorphisms

A local complete intersection homomorphism with Gorenstein source has Gorenstein target.

## Main results

* `Dualizing.isGorensteinRing_of_isLocalCompleteIntersection` — the target of a local complete
  intersection homomorphism out of a Noetherian Gorenstein ring is Gorenstein.

## Implementation notes

A local complete intersection homomorphism `A → B` factors as a surjection `P → B` from a
polynomial ring `P = A[x₁, …, xₙ]` whose kernel is Koszul-regular. The proof localizes at a prime
`q` of `B`: the localization of `P` at the contracted prime is Gorenstein because `A → P` is flat
with regular closed fibres, and `Localization.AtPrime q` is obtained from it by quotienting by a
regular sequence generating the localized kernel, which preserves the Gorenstein property one
element at a time.

The finite type component of the local complete intersection hypothesis supplies the Noetherian
instance on the target, so the conclusion uses the Gorenstein predicate without a separate
Noetherian hypothesis on `B`.

## References

* [Stacks Project, Tag 0DWA](https://stacks.math.columbia.edu/tag/0DWA)
-/

@[expose] public section

universe u v w

namespace Dualizing

open RingTheory.Sequence
open scoped Pointwise TensorProduct

/-- Koszul-regularity of a sequence on a module only depends on the module up to a linear
equivalence. Alias of `RingHom.isKoszulRegularOn_linearEquiv`. -/
private alias isKoszulRegularOn_of_linearEquiv := RingHom.isKoszulRegularOn_linearEquiv

/-- The image of a Koszul-regular sequence under a flat ring map is Koszul-regular. -/
private theorem isKoszulRegular_algebraMap
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Flat R S] {r : ℕ} {f : Fin r → R} (hf : Koszul.IsKoszulRegular f) :
    Koszul.IsKoszulRegular (fun i => algebraMap R S (f i)) := by
  have h := KoszulC.isKoszulRegular_baseChange f R
    ((Koszul.isKoszulRegularOn_self_iff f).mpr hf) (S := S)
  exact (Koszul.isKoszulRegularOn_self_iff _).mp
    (isKoszulRegularOn_of_linearEquiv _ (TensorProduct.AlgebraTensorModule.rid R S S) h)

/-- The quotient of a ring by an ideal generated by a regular sequence is nontrivial. -/
private theorem nontrivial_quotient_ofList_of_isRegular {R : Type u} [CommRing R] {rs : List R}
    (hreg : RingTheory.Sequence.IsRegular R rs) : Nontrivial (R ⧸ Ideal.ofList rs) :=
  Ideal.Quotient.nontrivial_iff.mpr fun htop => hreg.top_ne_smul (by rw [htop]; simp)

/-- A sequence of `R ⧸ span {r}` that is regular on the module `R ⧸ r • ⊤` is regular on the ring
`R ⧸ span {r}`. -/
private theorem isRegular_quotient_span_singleton_map {R : Type u} [CommRing R] (r : R)
    (rs : List R)
    (h : RingTheory.Sequence.IsRegular (QuotSMulTop r R)
      (rs.map (Ideal.Quotient.mk (Ideal.span {r})))) :
    RingTheory.Sequence.IsRegular (R ⧸ Ideal.span {r})
      (rs.map (Ideal.Quotient.mk (Ideal.span {r}))) := by
  let I : Ideal R := Ideal.span {r}
  have heq : r • (⊤ : Submodule R R) = I :=
    (Submodule.ideal_span_singleton_smul r (⊤ : Submodule R R)).symm.trans (by simp [I])
  let e : QuotSMulTop r R ≃ₗ[R] (R ⧸ I) := Submodule.quotEquivOfEq _ _ heq
  apply (e.toAddEquiv.isRegular_congr ?_).mp h
  apply List.forall₂_map_left_iff.mpr
  apply List.forall₂_map_right_iff.mpr
  apply List.forall₂_same.mpr
  intro s hs x
  calc
    e ((Ideal.Quotient.mk I s) • x) = e (s • x) := by simp
    _ = s • e x := e.map_smul s x
    _ = (Ideal.Quotient.mk I s) • e x := (IsScalarTower.algebraMap_smul (R ⧸ I) s (e x)).symm

/-- Quotienting `R ⧸ span {r}` by the image of `rs` is quotienting `R` by `r :: rs`. -/
private noncomputable def quotientOfListConsEquiv {R : Type u} [CommRing R] (r : R)
    (rs : List R) :
    ((R ⧸ Ideal.span {r}) ⧸ Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span {r})))) ≃+*
      (R ⧸ Ideal.ofList (r :: rs)) :=
  (Ideal.quotEquivOfEq (by simp [Ideal.map_ofList])).trans
    ((DoubleQuot.quotQuotEquivQuotSup (Ideal.span {r}) (Ideal.ofList rs)).trans
      (Ideal.quotEquivOfEq (by rw [Ideal.ofList_cons])))

/-- The quotient of a Gorenstein Noetherian local ring by a regular sequence contained in the
maximal ideal is Gorenstein. -/
private theorem isGorensteinLocalRing_quotient_ofList
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (rs : List R) (hR : IsGorensteinLocalRing R)
    (hreg : RingTheory.Sequence.IsRegular R rs)
    (hmem : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R) :
    letI : Nontrivial (R ⧸ Ideal.ofList rs) := nontrivial_quotient_ofList_of_isRegular hreg
    letI : IsLocalRing (R ⧸ Ideal.ofList rs) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.ofList rs)) Ideal.Quotient.mk_surjective
    letI : IsNoetherianRing (R ⧸ Ideal.ofList rs) := inferInstance
    IsGorensteinLocalRing (R ⧸ Ideal.ofList rs) := by
  cases rs with
  | nil =>
      let : Nontrivial (R ⧸ Ideal.ofList ([] : List R)) :=
        nontrivial_quotient_ofList_of_isRegular hreg
      let : IsLocalRing (R ⧸ Ideal.ofList ([] : List R)) :=
        IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
      exact isGorensteinLocalRing_of_ringEquiv
        ((Ideal.quotEquivOfEq (by simp [Ideal.ofList])).trans (RingEquiv.quotientBot R)) hR
  | cons r rs =>
      have hcons := (RingTheory.Sequence.isRegular_cons_iff' R r rs).mp hreg
      have hrmem : r ∈ IsLocalRing.maximalIdeal R := hmem r (by simp)
      have hrreg : r ∈ nonZeroDivisors R := by
        rw [mem_nonZeroDivisors_iff_left]
        intro x hx
        exact (isSMulRegular_iff_right_eq_zero_of_smul.mp hcons.1) x
          (by simpa [smul_eq_mul] using hx)
      let I : Ideal R := Ideal.span {r}
      let : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr
        (lt_of_le_of_lt (Ideal.span_le.2 (Set.singleton_subset_iff.mpr hrmem))
          (IsLocalRing.maximalIdeal.isMaximal R).lt_top).ne
      let : IsLocalRing (R ⧸ I) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      let : IsLocalHom (Ideal.Quotient.mk I) :=
        IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
      have hR1 : IsGorensteinLocalRing (R ⧸ I) :=
        (isGorensteinLocalRing_quotient_span_singleton_iff R r hrmem hrreg).1 hR
      have htail : RingTheory.Sequence.IsRegular (R ⧸ I) (rs.map (Ideal.Quotient.mk I)) :=
        isRegular_quotient_span_singleton_map r rs hcons.2
      have hmemTail : ∀ t ∈ rs.map (Ideal.Quotient.mk I),
          t ∈ IsLocalRing.maximalIdeal (R ⧸ I) := by
        intro t ht
        obtain ⟨s, hs, rfl⟩ := List.mem_map.mp ht
        exact IsLocalRing.map_maximalIdeal_le (Ideal.Quotient.mk I)
          (Ideal.mem_map_of_mem _ (hmem s (List.mem_cons_of_mem r hs)))
      let hquot := isGorensteinLocalRing_quotient_ofList
        (R := R ⧸ I) (rs.map (Ideal.Quotient.mk I)) hR1 htail hmemTail
      let J : Ideal (R ⧸ I) := Ideal.ofList (rs.map (Ideal.Quotient.mk I))
      let : Nontrivial ((R ⧸ I) ⧸ J) := nontrivial_quotient_ofList_of_isRegular htail
      let : IsLocalRing ((R ⧸ I) ⧸ J) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      let : Nontrivial (R ⧸ Ideal.ofList (r :: rs)) := nontrivial_quotient_ofList_of_isRegular hreg
      let : IsLocalRing (R ⧸ Ideal.ofList (r :: rs)) :=
        IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
      let e' : ((R ⧸ I) ⧸ J) ≃+* (R ⧸ Ideal.ofList (r :: rs)) := quotientOfListConsEquiv r rs
      exact isGorensteinLocalRing_of_ringEquiv e'.symm hquot
  termination_by rs.length
  decreasing_by
    simp_wf
    simp_all only [List.length_cons]
    exact Nat.lt_succ_self _

/-- For a surjection `e : P →+* B` and a prime `q` of `B`, the image of the complement of the
contraction of `q` in `P ⧸ ker e` is the complement of the corresponding prime of `P ⧸ ker e`. -/
private theorem algebraMapSubmonoid_primeCompl_comap_eq
    {P B : Type*} [CommRing P] [CommRing B] (e : P →+* B) (he : Function.Surjective e)
    (q : Ideal B) [q.IsPrime] :
    Algebra.algebraMapSubmonoid (P ⧸ RingHom.ker e) (q.comap e).primeCompl =
      (q.comap (RingHom.quotientKerEquivOfSurjective he).toRingHom).primeCompl := by
  let I : Ideal P := RingHom.ker e
  let eQ : (P ⧸ I) ≃+* B := RingHom.quotientKerEquivOfSurjective he
  ext x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  constructor
  · rintro ⟨z, hz, hzy⟩ hmem
    have hzz : Ideal.Quotient.mk I z = Ideal.Quotient.mk I y := by
      simpa [Algebra.algebraMapSubmonoid] using hzy
    have heq : e z = e y := by
      have hdiff : z - y ∈ I := Ideal.Quotient.eq.mp hzz
      change e (z - y) = 0 at hdiff
      apply sub_eq_zero.mp
      simpa [map_sub] using hdiff
    change (RingHom.quotientKerEquivOfSurjective he) (Ideal.Quotient.mk I y) ∈ q at hmem
    rw [RingHom.quotientKerEquivOfSurjective_apply_mk] at hmem
    change e z ∉ q at hz
    exact hz (heq ▸ hmem)
  · intro hx
    change eQ (Ideal.Quotient.mk I y) ∉ q at hx
    refine ⟨y, fun hy => hx ?_, rfl⟩
    change e y ∈ q at hy
    change (RingHom.quotientKerEquivOfSurjective he) (Ideal.Quotient.mk I y) ∈ q
    rwa [RingHom.quotientKerEquivOfSurjective_apply_mk]

/-- For a surjection `e : P →+* B` and a prime `q` of `B` lying over `p`, the localization of `B`
at `q` is the quotient of the localization of `P` at `p` by the image of the kernel of `e`. -/
private noncomputable def localizationAtPrimeQuotientKerEquiv
    {P B : Type*} [CommRing P] [CommRing B] (e : P →+* B) (he : Function.Surjective e)
    (q : Ideal B) [q.IsPrime] :
    let p := q.comap e
    let I := RingHom.ker e
    let R := Localization.AtPrime p
    (R ⧸ (I.map (algebraMap P R))) ≃+* Localization.AtPrime q := by
  let I : Ideal P := RingHom.ker e
  let p : Ideal P := q.comap e
  let R := Localization.AtPrime p
  let eQ : (P ⧸ I) ≃+* B := RingHom.quotientKerEquivOfSurjective he
  let qbar : Ideal (P ⧸ I) := q.comap eQ.toRingHom
  have hqbar : qbar.IsPrime := Ideal.comap_isPrime eQ.toRingHom q
  let J : Ideal R := I.map (algebraMap P R)
  have hloc : IsLocalization (qbar.primeCompl) (R ⧸ J) := by
    have h0 : IsLocalization (Algebra.algebraMapSubmonoid (P ⧸ I) p.primeCompl) (R ⧸ J) :=
      IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
        (M := p.primeCompl) (S := R) I
    have hsub : Algebra.algebraMapSubmonoid (P ⧸ I) p.primeCompl = qbar.primeCompl :=
      algebraMapSubmonoid_primeCompl_comap_eq e he q
    rwa [hsub] at h0
  letI : Algebra (P ⧸ I) (Localization.AtPrime q) :=
    ((algebraMap B (Localization.AtPrime q)).comp eQ.toRingHom).toAlgebra
  letI : IsLocalization (qbar.primeCompl) (Localization.AtPrime q) := by
    have hloc' : IsLocalization (q.primeCompl.map eQ.symm.toMonoidHom)
        (Localization.AtPrime q) := IsLocalization.isLocalization_of_base_ringEquiv
          q.primeCompl (Localization.AtPrime q) eQ.symm
    have hmapSymm : q.primeCompl.map eQ.symm.toMonoidHom = qbar.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        change eQ (eQ.symm y) ∉ q
        simpa using hy
      · intro hx
        change eQ x ∉ q at hx
        exact ⟨eQ x, hx, by simp⟩
    rwa [hmapSymm] at hloc'
  have hmap : qbar.primeCompl.map eQ.toMonoidHom = q.primeCompl :=
    eQ.map_primeCompl_comap_eq q
  exact IsLocalization.ringEquivOfRingEquiv (R ⧸ J) (Localization.AtPrime q) eQ hmap

/-- A polynomial ring over a Noetherian Gorenstein ring has Gorenstein localizations at all of its
primes. -/
private theorem isGorensteinLocalRing_localization_mvPolynomial
    {A : Type u} [CommRing A] [IsNoetherianRing A]
    (hA : IsGorensteinRing A) {n : ℕ}
    (q : Ideal (MvPolynomial (Fin n) A)) [q.IsPrime] :
    IsGorensteinLocalRing (Localization.AtPrime q) := by
  let p := q.under A
  let R := Localization.AtPrime p
  let S := Localization.AtPrime q
  let : Algebra R S := Ideal.algebraLocalizationAtPrimeUnder q
  have hsource : IsGorensteinLocalRing R := hA p
  let I := (IsLocalRing.maximalIdeal R).map (algebraMap R S)
  let : Nontrivial (S ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr
    (IsLocalRing.map_maximalIdeal_lt_top (algebraMap R S)).ne
  let : IsLocalRing (S ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hfiber : IsGorensteinLocalRing (S ⧸ I) := by
    have hI : I = p.map (algebraMap A S) := by
      dsimp [I, R, S, p]
      exact Ideal.map_maximalIdeal_eq_map_under q
    let : IsRegularLocalRing (S ⧸ I) := by
      rw [hI]
      exact Ideal.isRegularLocalRing_fiberRing_mvPolynomial q
    exact IsRegularLocalRing.isGorensteinLocalRing (S ⧸ I)
  exact (isGorensteinLocalRing_iff_of_flat R S).2 ⟨hsource, hfiber⟩

/-- Let `e : P →+* B` be a surjection whose kernel is Koszul-regular and `q` a prime of `B`. Then
the image of the kernel in the localization of `P` at the contraction of `q` is generated by a
regular sequence in the maximal ideal. -/
private theorem exists_isRegular_ofList_eq_map_ker
    {P B : Type*} [CommRing P] [CommRing B] [IsNoetherianRing P]
    (e : P →+* B) (hker : Ideal.IsKoszulRegular (RingHom.ker e))
    (q : Ideal B) [q.IsPrime] :
    ∃ l : List (Localization.AtPrime (q.comap e)),
      RingTheory.Sequence.IsRegular (Localization.AtPrime (q.comap e)) l ∧
      (∀ x ∈ l, x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap e))) ∧
      Ideal.ofList l = (RingHom.ker e).map (algebraMap P (Localization.AtPrime (q.comap e))) := by
  let p : Ideal P := q.comap e
  let R := Localization.AtPrime p
  let I : Ideal P := RingHom.ker e
  let : p.IsPrime := Ideal.comap_isPrime e q
  have hIle : I ≤ p := fun x hx => by
    change e x ∈ q
    rw [RingHom.mem_ker.mp hx]
    exact q.zero_mem
  obtain ⟨g, hg, n, s, hs, hspan⟩ := hker ⟨p, inferInstance⟩ hIle
  have hpow' : Submonoid.powers g ≤ Submonoid.comap (RingHom.id P) p.primeCompl :=
    Submonoid.powers_le.2 hg
  let φ : Localization.Away g →+* R := IsLocalization.map R (RingHom.id P) hpow'
  let : Algebra (Localization.Away g) R := φ.toAlgebra
  have hcomp : φ.comp (algebraMap P (Localization.Away g)) = algebraMap P R :=
    RingHom.ext (IsLocalization.map_eq hpow')
  let : IsScalarTower P (Localization.Away g) R :=
    IsScalarTower.of_algebraMap_eq' hcomp.symm
  let : Module.Flat (Localization.Away g) R :=
    (Module.flat_iff_of_isLocalization (Localization.Away g) (Submonoid.powers g) R).2 inferInstance
  let sR : Fin n → R := fun i => algebraMap (Localization.Away g) R (s i)
  have hsR : Koszul.IsKoszulRegular sR := isKoszulRegular_algebraMap hs
  have hspanR : Ideal.map (algebraMap P R) I = Ideal.span (Set.range sR) := by
    rw [← hcomp, ← Ideal.map_map, hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  have hImax : Ideal.map (algebraMap P R) I ≤ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p R]
    exact Ideal.map_mono hIle
  have hsRmem : ∀ i, sR i ∈ IsLocalRing.maximalIdeal R := by
    intro i
    apply hImax
    rw [hspanR]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hsRreg : RingTheory.Sequence.IsRegular R (List.ofFn sR) :=
    (((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae (M := R) sR hsRmem).2.out
      2 1).mp hsR)
  have hsRmemList : ∀ x ∈ List.ofFn sR, x ∈ IsLocalRing.maximalIdeal R := fun x hx => by
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
    exact hsRmem i
  refine ⟨List.ofFn sR, hsRreg, hsRmemList, ?_⟩
  refine Eq.trans (congrArg Ideal.span (Set.ext fun x => ?_)) hspanR.symm
  simp

/-- Let `e : P →+* B` be a surjection of Noetherian rings whose kernel is Koszul-regular. If the
localization of `P` at the contraction of a prime `q` of `B` is Gorenstein, then so is the
localization of `B` at `q`. -/
private theorem isGorensteinLocalRing_of_isKoszulRegular_ker
    {P B : Type*} [CommRing P] [CommRing B] [IsNoetherianRing P] [IsNoetherianRing B]
    (e : P →+* B) (he : Function.Surjective e)
    (hker : Ideal.IsKoszulRegular (RingHom.ker e))
    (q : Ideal B) [q.IsPrime]
    (hsource : IsGorensteinLocalRing (Localization.AtPrime (q.comap e))) :
    IsGorensteinLocalRing (Localization.AtPrime q) := by
  let R := Localization.AtPrime (q.comap e)
  obtain ⟨l, hreg, hmem, hl⟩ := exists_isRegular_ofList_eq_map_ker e hker q
  have hquot := isGorensteinLocalRing_quotient_ofList l hsource hreg hmem
  let : Nontrivial (R ⧸ Ideal.ofList l) := nontrivial_quotient_ofList_of_isRegular hreg
  let : IsLocalRing (R ⧸ Ideal.ofList l) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  let eLoc : (R ⧸ (RingHom.ker e).map (algebraMap P R)) ≃+* Localization.AtPrime q :=
    localizationAtPrimeQuotientKerEquiv e he q
  let eJ : (R ⧸ Ideal.ofList l) ≃+* Localization.AtPrime q := (Ideal.quotEquivOfEq hl).trans eLoc
  exact isGorensteinLocalRing_of_ringEquiv eJ.symm hquot

/-- The target of a local complete intersection homomorphism from a Noetherian Gorenstein ring is
Gorenstein. -/
@[stacks 0DWA]
public theorem isGorensteinRing_of_isLocalCompleteIntersection
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [IsNoetherianRing A]
    (f : A →+* B) (hf : f.IsLocalCompleteIntersection)
    (hA : IsGorensteinRing A) :
    letI := f.toAlgebra
    letI : Algebra.FiniteType A B := hf.1
    letI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
    IsGorensteinRing B := by
  let : Algebra A B := f.toAlgebra
  let : Algebra.FiniteType A B := hf.1
  let : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  intro q hq
  let : q.IsPrime := hq
  obtain ⟨n, p, hp, hker⟩ := hf.2
  let Q : Ideal (MvPolynomial (Fin n) A) := q.comap p.toRingHom
  let : Q.IsPrime := Ideal.comap_isPrime p.toRingHom q
  exact isGorensteinLocalRing_of_isKoszulRegular_ker p.toRingHom hp hker q
    (isGorensteinLocalRing_localization_mvPolynomial hA Q)

end Dualizing

end
