module

public import StacksFrontier.RingTheory.Dualizing.Complexes.InvertibleImage.ResidueFieldImage

/-!
# A linear autoequivalence sends the ring to an invertible object

Let `A` be a Noetherian commutative ring and let `F` be an `A`-linear autoequivalence of the
category `D^b_{Coh}(A)`, the bounded derived category of complexes of `A`-modules with finite
cohomology. Nothing is assumed about how `F` interacts with the shift or with distinguished
triangles. Then `F(A[0])` is an invertible object of `D(A)` for the derived tensor product.

The source's proof reads `Ext^i_A(κ, κ)` off `Hom(F κ, (F κ)⟦i⟧)`, which presumes
`F(κ⟦i⟧) ≅ (F κ)⟦i⟧`. A bare equivalence need not commute with the shift: over a field, any
relabelling of the degrees is an `A`-linear autoequivalence of `D^b_{Coh}(A)`. The argument
here proves what it needs instead. Fix a maximal ideal `m` with residue field `κ`. The object
`κ[0]` is a brick (each endomorphism is zero or invertible) killed by `m`, and so is its image
under `F`.

* If `m` is not idempotent, there is a nonzero `e : κ ⟶ κ⟦1⟧`. In a triangle
  `κ ⟶ Y ⟶ κ ⟶ κ⟦1⟧` with last map `e`, the last two maps are weak cokernels of their
  predecessors. An equivalence preserves weak cokernels, and comparing them with a cone of
  `F(κ ⟶ Y)` gives `F(κ⟦n⟧) ≅ (F κ)⟦n⟧` for all `n`
  (`CategoryTheory.Pretriangulated.nonempty_iso_map_shift`). The source's argument then shows
  that `F(κ[0])` is a shift of `κ[0]`. If two cohomology modules of `F(κ[0])` were nonzero,
  their common `m`-torsion would give a nonzero map from the higher one to the lower one. The
  truncation triangles turn that map into a nonzero morphism from `F(κ[0])` to a negative
  shift of itself, which is impossible. The single cohomology module has no endomorphisms other
  than `0` and isomorphisms, so it is one-dimensional over `κ`.
* If `m` is idempotent, it is generated by an idempotent and `κ` is a projective module. A
  brick of `D^b_{Coh}(A)` killed by `m` is then a shift of `κ[0]`: a map from `κ` onto its top
  cohomology lifts by projectivity, and the brick property makes the lift invertible. This
  applies to `F(κ[0])` and to a preimage of each shift of `κ[0]`.

In both cases `F(κ[0])` is a shift of `κ[0]`, and every shift of `κ[0]` is the image of one. So
the maps from `F(A[0])` to the shifts of `κ[0]` are the maps from `A[0]` to the shifts of
`κ[0]`. They are nonzero in exactly one degree, where they form a line. This computes the
derived fibre of `F(A[0])` at `m`: it has one cohomology module, of rank one. Finally `F(A[0])`
is pseudo-coherent, and a pseudo-coherent complex whose fibres at maximal ideals vanish in all
low degrees is perfect, so `F(A[0])` is locally a shift of the ring, i.e. invertible.

## Main results

* `Dualizing.isInvertible_obj_ring_of_linear_isEquivalence` ([stacks 0A7E]): the image of the
  ring under an `A`-linear autoequivalence of `D^b_{Coh}(A)` is invertible.
* `Dualizing.residueObject_image_facts`: such an autoequivalence permutes the shifts of each
  residue field.

## Implementation notes

`F.Additive` is a consequence of `F.IsEquivalence`: a full functor preserves zero morphisms
(`Functor.preservesZeroMorphisms_of_full`) and an equivalence preserves binary products, whence
`Functor.additive_of_preserves_binary_products`.

The monoidal structure is the derived tensor product of [stacks 0FNQ], supplied by
`DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory`, rather than an arbitrary
monoidal structure on the derived category. The main theorem therefore uses that provider's
module universe, which is the universe of the ring.

## References

* [Stacks Project, Tag 0A7E](https://stacks.math.columbia.edu/tag/0A7E)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated ZeroObject

universe u

attribute [local instance] HasDerivedCategory.standard

namespace Dualizing

variable {A : Type u} [CommRing A]

/-- If a scalar kills the identity of a complex, it kills every cohomology module. -/
public theorem homology_smul_eq_zero_of_smul_id_eq_zero (K : DerivedCategory (ModuleCat.{u} A))
    (r : A) (hK : r • 𝟙 K = 0) (i : ℤ)
    (x : (DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj K) : r • x = 0 := by
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A) i
  let _ : Functor.Linear A H :=
    DerivedCategory.homologyFunctor_linear (C := ModuleCat.{u} A) A i
  have hH := congrArg H.map hK
  have hLinear : r • (LinearMap.id : (H.obj K) →ₗ[A] H.obj K) = 0 := by
    rw [Functor.map_smul, H.map_id, Functor.map_zero] at hH
    exact congrArg (fun f : (H.obj K) ⟶ (H.obj K) => f.hom) hH
  simpa only [LinearMap.smul_apply, LinearMap.id_apply, LinearMap.zero_apply] using
    congrArg (fun f : (H.obj K) →ₗ[A] H.obj K => f x) hLinear

/-- A nonzero bounded complex has a top nonzero cohomology module. -/
public theorem exists_isLE_not_isZero_homology (K : DerivedCategory (ModuleCat.{u} A))
    (hb : (DerivedCategory.TStructure.t).bounded K) (hK : ¬ IsZero K) :
    ∃ b : ℤ, K.IsLE b ∧
      ¬ IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) b).obj K) := by
  classical
  obtain ⟨⟨lo, hlo⟩, ⟨hi, hhi⟩⟩ := hb
  have hGE : K.IsGE lo := by simpa using hlo
  have hLE : K.IsLE hi := by simpa using hhi
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A)
  let s := (Finset.Icc lo hi).filter (fun i => ¬ IsZero ((H i).obj K))
  obtain ⟨a, haI, ha⟩ := exists_nonzero_homology_of_bounded_nonzero K lo hi hK
  have hs : s.Nonempty := ⟨a, Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr haI, ha⟩⟩
  have hb := Finset.mem_filter.mp (s.max'_mem hs)
  refine ⟨s.max' hs, (DerivedCategory.isLE_iff K _).2 (fun i hi' => ?_), hb.2⟩
  by_contra hz
  by_cases hihi : hi < i
  · exact hz (DerivedCategory.isZero_of_isLE K hi i hihi)
  by_cases hilo : i < lo
  · exact hz (DerivedCategory.isZero_of_isGE K lo i hilo)
  have hmem : i ∈ s := Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by omega, by omega⟩, hz⟩
  have := s.le_max' i hmem
  omega

/-- **The residue field is the only brick killed by the maximal ideal, when it is projective.**
Let `W` be a nonzero object of `D^b_Coh(A)` whose endomorphisms are zero or invertible and
which is killed by a maximal ideal `m` whose residue field is a projective module. Then `W` is
the residue field placed in a single degree: a map from `κ` onto its top cohomology lifts
along projectivity, and the two endomorphisms it builds with the top truncation are
invertible. -/
public theorem exists_iso_residueObject_of_isBrick_of_projective [IsNoetherianRing A]
    (m : Ideal A) [m.IsMaximal] [Module.Projective A m.ResidueField]
    (W : BoundedCoherentDerivedCategory.{u, u} A) (hW : IsBrick W)
    (hkill : ∀ r ∈ m, r • 𝟙 W = 0) (hW0 : ¬ IsZero W.obj) :
    ∃ b : ℤ, Nonempty (W ≅ residueObject m b) := by
  classical
  let K := W.obj
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A)
  let κA := ModuleCat.of A m.ResidueField
  let ι := ObjectProperty.ι (fun K : DerivedCategory (ModuleCat.{u} A) =>
    (∀ i : ℤ, Module.Finite A ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj K)) ∧
      (DerivedCategory.TStructure.t).bounded K)
  have htors : ∀ i, Module.IsTorsionBySet A ((H i).obj K) m := by
    intro i x r
    have h := congrArg (fun f : W ⟶ W => f.hom) (hkill r r.2)
    change (r : A) • 𝟙 K = 0 at h
    exact homology_smul_eq_zero_of_smul_id_eq_zero K r h i x
  obtain ⟨b, hLE, hb⟩ := exists_isLE_not_isZero_homology K W.property.2 hW0
  let M := (H b).obj K
  have hMnt : Nontrivial M := not_subsingleton_iff_nontrivial.mp
    fun hsub => hb (ModuleCat.isZero_iff_subsingleton.mpr hsub)
  have hκtors : Module.IsTorsionBySet A m.ResidueField m := by
    intro x r
    rw [Algebra.smul_def, Ideal.algebraMap_residueField_eq_zero.mpr r.2, zero_mul]
  obtain ⟨α, hα⟩ := exists_nonzero_linearMap_of_maximal_ideal_killed m hκtors (htors b)
    inferInstance hMnt
  let _ : Projective κA := ModuleCat.projective_of_categoryTheory_projective κA
  let s : (DerivedCategory.singleFunctor (ModuleCat.{u} A) b).obj κA ⟶ K :=
    (DerivedCategory.homologyFromSingleAddEquiv κA K b).symm (ModuleCat.ofHom α)
  have hs : (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} A) b).inv.app κA ≫
      (H b).map s = ModuleCat.ofHom α := by
    have := (DerivedCategory.homologyFromSingleAddEquiv κA K b).apply_symm_apply
      (ModuleCat.ofHom α)
    rwa [DerivedCategory.homologyFromSingleAddEquiv_apply] at this
  let t := DerivedCategory.TStructure.t (C := ModuleCat.{u} A)
  let U := (t.truncGE b).obj K
  have : U.IsLE b := isLE_truncGE_of_isLE K b
  obtain ⟨E, ⟨eU⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE U b
  let π := (t.truncGEπ b).app K
  have hπ : IsIso ((H b).map π) := isIso_homology_map_truncGEπ K b
  obtain ⟨ζ, hζ⟩ := (DerivedCategory.singleFunctor (ModuleCat.{u} A) b).map_surjective
    (s ≫ π ≫ eU.hom)
  have hζne : ζ ≠ 0 := by
    intro hz
    rw [hz, Functor.map_zero] at hζ
    have h0 : (H b).map s ≫ (H b).map π ≫ (H b).map eU.hom = 0 := by
      rw [← Functor.map_comp, ← Functor.map_comp, ← hζ, Functor.map_zero]
    have h1 : (H b).map s = 0 :=
      (cancel_mono ((H b).map π ≫ (H b).map eU.hom)).mp (h0.trans zero_comp.symm)
    rw [h1, comp_zero] at hs
    exact hα (congrArg (fun φ : κA ⟶ M => φ.hom) hs.symm)
  have hEtors : Module.IsTorsionBySet A E m := by
    let e₁ : E ≅ (H b).obj U :=
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} A) b).app E).symm ≪≫
        (H b).mapIso eU.symm
    let e₂ : E ≅ M := e₁ ≪≫ (asIso ((H b).map π)).symm
    exact isTorsionBySet_of_linearEquiv e₂.toLinearEquiv.symm (htors b)
  obtain ⟨c, hc⟩ : ∃ c, ζ.hom c ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hζne (ModuleCat.hom_ext (LinearMap.ext hcon))
  obtain ⟨ω, hω⟩ := exists_linearMap_residueField_apply_ne_zero m hEtors hc
  let tt : K ⟶ (DerivedCategory.singleFunctor (ModuleCat.{u} A) b).obj κA :=
    π ≫ eU.hom ≫ (DerivedCategory.singleFunctor (ModuleCat.{u} A) b).map (ModuleCat.ofHom ω)
  have hst : s ≫ tt = (DerivedCategory.singleFunctor (ModuleCat.{u} A) b).map
      (ζ ≫ ModuleCat.ofHom ω) := by
    rw [Functor.map_comp, hζ]
    simp [tt]
  have h1 : s ≫ tt ≠ 0 := by
    rw [hst]
    intro hz
    have hz' : ζ ≫ ModuleCat.ofHom ω = 0 :=
      (DerivedCategory.singleFunctor (ModuleCat.{u} A) b).map_injective
        (by rw [hz, Functor.map_zero])
    exact hω (congrArg (fun φ : κA ⟶ κA => φ.hom c) hz')
  have hiso1 : IsIso (s ≫ tt) := ((isBrick_residueObject_obj m b) _).resolve_left h1
  have h2 : tt ≫ s ≠ 0 := by
    intro hz
    apply not_isZero_residueObject_obj m b
    rw [IsZero.iff_id_eq_zero]
    calc 𝟙 _ = inv (s ≫ tt) ≫ inv (s ≫ tt) ≫ ((s ≫ tt) ≫ (s ≫ tt)) := by simp
      _ = 0 := by
        rw [show (s ≫ tt) ≫ (s ≫ tt) = 0 by
          rw [Category.assoc, ← Category.assoc tt, hz, zero_comp, comp_zero], comp_zero, comp_zero]
  have hiso2 : IsIso (tt ≫ s) := ((hW.map ι) _).resolve_left h2
  have : Mono s := mono_of_mono s tt
  have : IsSplitEpi s := IsSplitEpi.mk' ⟨inv (tt ≫ s) ≫ tt, by simp⟩
  have : IsIso s := isIso_of_mono_of_isSplitEpi s
  exact ⟨b, ⟨ObjectProperty.isoMk _ (asIso s).symm⟩⟩


/-- The residue field placed in two degrees gives isomorphic objects only when the degrees
agree: the cohomology in the first degree tells them apart. -/
public theorem eq_of_iso_residueObject (m : Ideal A) [m.IsMaximal] {a j : ℤ}
    (e : residueObject m a ≅ residueObject m j) : a = j := by
  by_contra h
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A) a
  let κA := ModuleCat.of A m.ResidueField
  let Sj := (DerivedCategory.singleFunctor (ModuleCat.{u} A) j).obj κA
  have hz : IsZero (H.obj Sj) := by
    rcases lt_or_gt_of_ne h with h | h
    · exact DerivedCategory.isZero_of_isGE Sj j a h
    · exact DerivedCategory.isZero_of_isLE Sj j a h
  have hκ : IsZero κA := IsZero.of_iso hz
    (((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} A) a).app κA).symm ≪≫
      H.mapIso ((ObjectProperty.ι _).mapIso e))
  exact not_subsingleton m.ResidueField (ModuleCat.isZero_iff_subsingleton.mp hκ)

/-- The ring in degree zero has no nonzero morphism to the residue field placed in a nonzero
degree: in positive degrees for degree reasons, in negative degrees because the ring is
projective. -/
public theorem hom_ringObject_residueObject_eq_zero (m : Ideal A) [m.IsMaximal] {n : ℤ}
    (hn : n ≠ 0) (h : ringObject A ⟶ residueObject m n) : h = 0 := by
  apply ObjectProperty.hom_ext
  let P : ModuleCat.{u} A := ModuleCat.of A A
  let κA := ModuleCat.of A m.ResidueField
  let f : (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj P ⟶
      (DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj κA := h.hom
  change f = 0
  rcases lt_or_gt_of_ne hn with hn | hn
  · let _ : Projective P := ModuleCat.projective_of_categoryTheory_projective P
    exact DerivedCategory.from_singleFunctor_obj_eq_zero_of_isLE_of_projective hn _ f
  · exact DerivedCategory.TStructure.t.zero f 0 n hn

/-- If every morphism from `X` to `Z` is zero, then so is every morphism from `F X` to an
object isomorphic to `F Z`, for a full functor `F` preserving zero morphisms. -/
private theorem eq_zero_of_iso_map {C D : Type*} [Category C] [Category D]
    [HasZeroMorphisms C] [HasZeroMorphisms D] (F : C ⥤ D) [F.Full] [F.PreservesZeroMorphisms]
    {X Z : C} {Y : D} (σ : F.obj Z ≅ Y) (g : F.obj X ⟶ Y) (hz : ∀ h : X ⟶ Z, h = 0) : g = 0 := by
  obtain ⟨h, hh⟩ := F.map_surjective (g ≫ σ.inv)
  rw [hz h, F.map_zero] at hh
  exact zero_of_comp_mono σ.inv hh.symm

/-- **The residue fields under a linear autoequivalence.** Let `F` be an `A`-linear
autoequivalence of `D^b_{Coh}(A)` and `m` a maximal ideal. Then `F` sends the residue field in
degree zero to the residue field in some degree, and the residue field in every degree is the
image of the residue field in some degree.

If the residue field `κ` has a nonzero self-extension `κ ⟶ κ⟦1⟧`, which happens exactly when
`m` is not idempotent, `F` commutes with the shifts of `κ`
(`CategoryTheory.Pretriangulated.nonempty_iso_map_shift`). Then `F κ` has no negative
self-extensions, so it is a shift of `κ` (`Dualizing.residueField_image_iso_residueField`), and
both claims follow. Otherwise `κ` is a projective module, and a brick of `D^b_{Coh}(A)` killed
by `m` is a shift of `κ` (`Dualizing.exists_iso_residueObject_of_isBrick_of_projective`). This
applies to `F κ` and to a preimage of each shift of `κ`. -/
public theorem residueObject_image_facts [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive] (m : Ideal A) [m.IsMaximal] :
    (∃ a : ℤ, Nonempty (F.obj (residueObject m 0) ≅ residueObject m a)) ∧
      ∀ j : ℤ, ∃ n : ℤ, Nonempty (F.obj (residueObject m n) ≅ residueObject m j) := by
  let ι := ObjectProperty.ι (fun K : DerivedCategory (ModuleCat.{u} A) =>
    (∀ i : ℤ, Module.Finite A ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj K)) ∧
      (DerivedCategory.TStructure.t).bounded K)
  let κA := ModuleCat.of A m.ResidueField
  let S := DerivedCategory.singleFunctors (ModuleCat.{u} A)
  let X := residueObject m 0
  by_cases hℓ : ∃ ℓ : m →ₗ[A] m.ResidueField, ℓ ≠ 0
  · obtain ⟨ℓ, hℓ⟩ := hℓ
    obtain ⟨e, he⟩ := exists_ne_zero_hom_residueObject_shift_one m ℓ hℓ
    have hshift : ∀ n : ℤ, Nonempty (F.obj (X⟦n⟧) ≅ (F.obj X)⟦n⟧) :=
      Pretriangulated.nonempty_iso_map_shift F (isBrick_residueObject m 0) e he
        (hom_shift_one_residueObject_eq_zero m) (not_isZero_residueObject m 0)
    have hneg : ∀ n : ℤ, n < 0 → ∀ g : (F.obj (finiteModuleObject A κA)).obj ⟶
        (F.obj (finiteModuleObject A κA)).obj⟦n⟧, g = 0 := by
      intro n hn g
      obtain ⟨σ⟩ := hshift n
      let cF := (ι.commShiftIso n).app (F.obj X)
      let cX := (ι.commShiftIso n).app X
      have h2 : g ≫ cF.inv = 0 := congrArg (fun φ => φ.hom)
        (eq_zero_of_iso_map F σ (ObjectProperty.homMk (g ≫ cF.inv)) fun h => ι.map_injective (by
          rw [ι.map_zero]
          exact zero_of_comp_mono cX.hom
            (hom_eq_zero_of_negative_shift_single_to A κA κA n hn (ι.map h ≫ cX.hom))))
      exact (cancel_mono cF.inv).mp (h2.trans zero_comp.symm)
    obtain ⟨a, ⟨eF⟩⟩ := residueField_image_iso_residueField F m hneg
    let ea : F.obj X ≅ residueObject m a := ObjectProperty.isoMk _ eF
    refine ⟨⟨a, ⟨ea⟩⟩, fun j => ⟨j - a, ?_⟩⟩
    obtain ⟨σ⟩ := hshift (a - j)
    let i₁ : residueObject m (j - a) ≅ X⟦a - j⟧ := ObjectProperty.isoMk _
      (((S.shiftIso (a - j) (j - a) 0 (by omega)).app κA).symm ≪≫
        ((ι.commShiftIso (a - j)).app X).symm)
    let i₄ : (residueObject m a)⟦a - j⟧ ≅ residueObject m j := ObjectProperty.isoMk _
      ((ι.commShiftIso (a - j)).app (residueObject m a) ≪≫
        (S.shiftIso (a - j) j a (by omega)).app κA)
    exact ⟨F.mapIso i₁ ≪≫ σ ≪≫ (shiftFunctor _ (a - j)).mapIso ea ≪≫ i₄⟩
  · push Not at hℓ
    have : Module.Projective A m.ResidueField :=
      projective_residueField_of_forall_linearMap_eq_zero m hℓ
    have hzero : ∀ {W : BoundedCoherentDerivedCategory.{u, u} A}, IsZero W.obj → IsZero W := by
      intro W hW
      rw [IsZero.iff_id_eq_zero]
      exact ι.map_injective (by rw [ι.map_id, ι.map_zero]; exact hW.eq_of_src _ _)
    have hkill₀ : ∀ r ∈ m, r • 𝟙 (F.obj X) = 0 := by
      intro r hr
      rw [← F.map_id, ← Functor.map_smul, residueObject_smul_id_eq_zero m 0 r hr, F.map_zero]
    have hne₀ : ¬ IsZero (F.obj X).obj := fun hz => not_isZero_residueObject m 0
      ((IsZero.iff_id_eq_zero _).2 (F.map_injective ((hzero hz).eq_of_src _ _)))
    refine ⟨exists_iso_residueObject_of_isBrick_of_projective m (F.obj X)
      ((isBrick_residueObject m 0).map F) hkill₀ hne₀, fun j => ?_⟩
    let W := F.objPreimage (residueObject m j)
    let eW : F.obj W ≅ residueObject m j := F.objObjPreimageIso _
    have hkill : ∀ r ∈ m, r • 𝟙 W = 0 := by
      intro r hr
      apply F.map_injective
      rw [Functor.map_smul, F.map_id, F.map_zero]
      calc r • 𝟙 (F.obj W) = eW.hom ≫ (r • 𝟙 (residueObject m j)) ≫ eW.inv := by simp
        _ = 0 := by rw [residueObject_smul_id_eq_zero m j r hr, zero_comp, comp_zero]
    have hne : ¬ IsZero W.obj := fun hz =>
      not_isZero_residueObject m j (IsZero.of_iso (F.map_isZero (hzero hz)) eW.symm)
    obtain ⟨n, ⟨eWn⟩⟩ := exists_iso_residueObject_of_isBrick_of_projective m W
      (IsBrick.of_map F ((isBrick_residueObject m j).of_iso eW.symm)) hkill hne
    exact ⟨n, ⟨F.mapIso eWn.symm ≪≫ eW⟩⟩

/-- **The Hom side of the fibre computation.** For a linear autoequivalence `F` and a maximal
ideal `m`, there is exactly one degree `a` in which the image of the ring maps to the residue
field, and there the maps form a one-dimensional vector space. Indeed the residue field in
degree `j` is `F` of the residue field in some degree `n`, so these maps are the maps from the
ring to the residue field in degree `n`, and `n = 0` happens for exactly one `j`. -/
public theorem exists_image_ring_hom_residueField [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive] (m : Ideal A) [m.IsMaximal] :
    ∃ a : ℤ, (∀ j : ℤ, j ≠ a → ∀ f : (F.obj (ringObject A)).obj ⟶
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) j).obj
          (ModuleCat.of A m.ResidueField), f = 0) ∧
      Nonempty (((F.obj (ringObject A)).obj ⟶
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) a).obj
          (ModuleCat.of A m.ResidueField)) ≃ₗ[A] m.ResidueField) := by
  obtain ⟨⟨a, ⟨ea⟩⟩, hsurj⟩ := residueObject_image_facts F m
  let ι := ObjectProperty.ι (fun K : DerivedCategory (ModuleCat.{u} A) =>
    (∀ i : ℤ, Module.Finite A ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj K)) ∧
      (DerivedCategory.TStructure.t).bounded K)
  refine ⟨a, fun j hj f => ?_, ?_⟩
  · obtain ⟨n, ⟨en⟩⟩ := hsurj j
    have hn : n ≠ 0 := by
      rintro rfl
      exact hj (eq_of_iso_residueObject m (ea.symm ≪≫ en)).symm
    let f' : F.obj (ringObject A) ⟶ residueObject m j := ObjectProperty.homMk f
    have hf' : f' = 0 := eq_zero_of_iso_map F en f' (hom_ringObject_residueObject_eq_zero m hn)
    exact congrArg (fun φ => φ.hom) hf'
  · let X := residueObject m 0
    let e₁ : ((F.obj (ringObject A)).obj ⟶ (residueObject m a).obj) ≃ₗ[A]
        (F.obj (ringObject A) ⟶ residueObject m a) :=
      (fullyFaithfulHomLinearEquiv (R := A) ι (Functor.FullyFaithful.ofFullyFaithful ι)
        (F.obj (ringObject A)) (residueObject m a)).symm
    let e₂ : (F.obj (ringObject A) ⟶ residueObject m a) ≃ₗ[A]
        (F.obj (ringObject A) ⟶ F.obj X) :=
      Linear.homCongr A (Iso.refl _) ea.symm
    let e₃ : (F.obj (ringObject A) ⟶ F.obj X) ≃ₗ[A] (ringObject A ⟶ X) :=
      (fullyFaithfulHomLinearEquiv (R := A) F (Functor.FullyFaithful.ofFullyFaithful F)
        (ringObject A) X).symm
    exact ⟨e₁.trans (e₂.trans (e₃.trans (boundedRingToResidueFieldHomLinearEquiv m)))⟩

/-- Maps from the image of the ring to a shifted residue field occur only in one shift. -/
public theorem hom_eq_zero_of_image_ring_to_residueField_shift [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive] (m : Ideal A) [m.IsMaximal] :
    ∃ a : ℤ, ∀ j : ℤ, j ≠ a →
      ∀ f : (F.obj (ringObject A)).obj ⟶
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) j).obj
          (ModuleCat.of A m.ResidueField), f = 0 :=
  (exists_image_ring_hom_residueField F m).imp fun _ h => h.1

/-- Maps from the image of the ring to the shifted residue field form, in some degree, a
one-dimensional vector space over that residue field. -/
public theorem exists_residueField_image_ring_hom_linearEquiv [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive] (m : Ideal A) [m.IsMaximal] :
    ∃ a : ℤ, Nonempty
      (((F.obj (ringObject A)).obj ⟶
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) a).obj
          (ModuleCat.of A m.ResidueField)) ≃ₗ[A] m.ResidueField) :=
  (exists_image_ring_hom_residueField F m).imp fun _ h => h.2


/-- The residue field, restricted to the base ring along its own structure map, is the residue
field as a module over the base ring. -/
public noncomputable def residueFieldRestrictScalarsIso
    (m : Ideal A) [m.IsMaximal] :
    (ModuleCat.restrictScalars (algebraMap A m.ResidueField)).obj
      (ModuleCat.of m.ResidueField m.ResidueField) ≅ ModuleCat.of A m.ResidueField := by
  let k := m.ResidueField
  let R := ModuleCat.restrictScalars (algebraMap A k)
  let E : ModuleCat.{u} A := ModuleCat.of A k
  let φ : (forget₂ (ModuleCat.{u} A) Ab).obj (R.obj (ModuleCat.of k k)) ≅
      (forget₂ (ModuleCat.{u} A) Ab).obj E := by
    change AddCommGrpCat.of k ≅ AddCommGrpCat.of k
    exact Iso.refl _
  exact ModuleCat.isoMk φ (fun r => by
    ext x
    change k at x
    change (E.smul r).asHom.hom x = ((R.obj (ModuleCat.of k k)).smul r).asHom.hom x
    rw [ModuleCat.smul_restrictScalars]
    dsimp [ModuleCat.smul, AddCommGrpCat.Hom.hom]
    rw [Algebra.smul_def]
    rfl)

/-- Derived extension of scalars turns the preceding Hom vanishing into vanishing of maps from
the derived fibre to the residue field. -/
public theorem residueField_image_fibre_hom_vanishes [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive]
    (m : Ideal A) [m.IsMaximal] :
    ∃ a : ℤ, ∀ j : ℤ, j ≠ a →
      ∀ f : (CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
          (algebraMap A m.ResidueField)).functor.obj (F.obj (ringObject A)).obj ⟶
        (DerivedCategory.singleFunctor (ModuleCat.{u} m.ResidueField) j).obj
          (ModuleCat.of m.ResidueField m.ResidueField), f = 0 := by
  obtain ⟨a, hvan⟩ := hom_eq_zero_of_image_ring_to_residueField_shift F m
  refine ⟨a, fun j haj f => ?_⟩
  let k := m.ResidueField
  let D := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
    (algebraMap A k)
  let R := ModuleCat.restrictScalars (algebraMap A k)
  let adj := @CochainComplex.DerivedExtensionScalars.derivedExtensionScalarsAdjunction.{u, u, u}
    A k _ _ (algebraMap A k) _ _ D.functor D.comparison D.isLeftDerived
  let E : ModuleCat.{u} A := ModuleCat.of A m.ResidueField
  let Sₐ := DerivedCategory.singleFunctor (ModuleCat.{u} A) j
  let Sₖ := DerivedCategory.singleFunctor (ModuleCat.{u} k) j
  let rIso : (R.mapDerivedCategory).obj (Sₖ.obj (ModuleCat.of k k)) ≅ Sₐ.obj E :=
    (R.mapDerivedCategorySingleFunctor j).app (ModuleCat.of k k) ≪≫
      Sₐ.mapIso (residueFieldRestrictScalarsIso m)
  have hg : adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) f ≫ rIso.hom
      = 0 :=
    hvan j haj _
  have hh : adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) f = 0 := by
    apply (cancel_mono rIso.hom).mp
    simpa using hg
  exact (adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k))).injective
    (by simpa using hh)

/-- Over a field, maps to the shifted one-dimensional module detect each cohomology module of a
pseudo-coherent complex. -/
public theorem isZero_homology_of_hom_to_field_vanishes
    {k : Type u} [Field k] (K : DerivedCategory (ModuleCat.{u} k))
    (hK : StacksDraft.PseudoCoherence.IsPseudoCoherent K) (i : ℤ)
    (hHom : ∀ f : K ⟶
      (DerivedCategory.singleFunctor (ModuleCat.{u} k) i).obj (ModuleCat.of k k), f = 0) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} k) i).obj K) := by
  classical
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} k) i
  let M := H.obj K
  by_contra hzero
  have hsub : ¬ Subsingleton M := fun hs => hzero (ModuleCat.isZero_iff_subsingleton.mpr hs)
  let N : Submodule k M := (⊥ : Ideal k) • ⊤
  have hN : N = ⊥ := by simp [N]
  let eQ := Submodule.quotEquivOfEqBot N hN
  have hquot : Nontrivial (M ⧸ N) := not_subsingleton_iff_nontrivial.mp
    fun _ => hsub (Equiv.subsingleton eQ.toEquiv.symm)
  obtain ⟨E, hfinite, _hkill, ⟨f, hf⟩⟩ :=
    StacksDraft.PseudoCoherence.exists_finite_module_detecting_homology_mod_ideal
      K hK (⊥ : Ideal k) i hquot
  let ε := (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} k) i)
  let g : (H.obj K) ⟶ E := H.map f ≫ ε.hom.app E
  obtain ⟨x, hx⟩ : ∃ x : M, g.hom x ≠ 0 := by
    by_contra h
    apply hf
    ext x
    exact not_ne_iff.mp (not_exists.mp h x)
  let _ : Module.Finite k E := hfinite
  let b := Module.finBasis k E
  have hrepr : b.repr (g.hom x) ≠ 0 := fun hz => hx (b.repr.injective (by simpa using hz))
  obtain ⟨t, ht⟩ := Finsupp.support_nonempty_iff.mpr hrepr
  let ℓ : E →ₗ[k] k := b.coord t
  have hℓ : ℓ (g.hom x) ≠ 0 := by
    simpa only [ℓ, b.coord_apply] using Finsupp.mem_support_iff.mp ht
  let q : E ⟶ ModuleCat.of k k := ModuleCat.ofHom ℓ
  let S := DerivedCategory.singleFunctor (ModuleCat.{u} k) i
  have hnat : H.map (S.map q) ≫ ε.hom.app (ModuleCat.of k k) = ε.hom.app E ≫ q := by
    simpa only [Functor.comp_map, Functor.id_map] using ε.hom.naturality q
  let f' := f ≫ S.map q
  have hcomp : H.map f' ≫ ε.hom.app (ModuleCat.of k k) = g ≫ q := by
    dsimp [f', g]
    rw [Functor.map_comp, Category.assoc, hnat, ← Category.assoc]
  have hcompne : H.map f' ≫ ε.hom.app (ModuleCat.of k k) ≠ 0 := by
    intro hz
    have hh := congrArg (fun z : (H.obj K ⟶ ModuleCat.of k k) => z.hom x)
      (hcomp.symm.trans hz)
    exact hℓ (by simpa [q] using hh)
  exact hcompne (by rw [hHom f', Functor.map_zero, zero_comp])

/-- The derived fibre of the image of the ring at a maximal ideal has a single cohomology
module, and it has rank one: its dual is the space of maps from the image of the ring to the
shifted residue field. -/
public theorem residueField_image_fibre_finrank_one [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive]
    (m : Ideal A) [m.IsMaximal] :
    ∃ a : ℤ, Module.finrank m.ResidueField
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} m.ResidueField) a).obj
        ((CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
          (algebraMap A m.ResidueField)).functor.obj (F.obj (ringObject A)).obj)) = 1 ∧
      ∀ i : ℤ, i ≠ a → IsZero
        ((DerivedCategory.homologyFunctor (ModuleCat.{u} m.ResidueField) i).obj
          ((CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
            (algebraMap A m.ResidueField)).functor.obj (F.obj (ringObject A)).obj)) := by
  let k := m.ResidueField
  let _ : Linear A (ModuleCat.{u} k) := ModuleCat.Algebra.instLinear
  let E : ModuleCat.{u} A := ModuleCat.of A k
  let D := CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
    (algebraMap A k)
  let K := D.functor.obj (F.obj (ringObject A)).obj
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} k)
  obtain ⟨a, ⟨hImage⟩⟩ := exists_residueField_image_ring_hom_linearEquiv F m
  obtain ⟨aVan, hvan⟩ := residueField_image_fibre_hom_vanishes F m
  let Sₐ := DerivedCategory.singleFunctor (ModuleCat.{u} A) a
  let Sₖ := DerivedCategory.singleFunctor (ModuleCat.{u} k) a
  let R := ModuleCat.restrictScalars (algebraMap A k)
  let _ : R.Linear A := { map_smul := by intros; ext; rfl }
  let adj := @CochainComplex.DerivedExtensionScalars.derivedExtensionScalarsAdjunction.{u, u, u}
    A k _ _ (algebraMap A k) _ _ D.functor D.comparison D.isLeftDerived
  let rIso : (R.mapDerivedCategory).obj (Sₖ.obj (ModuleCat.of k k)) ≅ Sₐ.obj E :=
    (R.mapDerivedCategorySingleFunctor a).app (ModuleCat.of k k) ≪≫
      Sₐ.mapIso (residueFieldRestrictScalarsIso m)
  let hAdjA : (K ⟶ Sₖ.obj (ModuleCat.of k k)) ≃ₗ[A]
      ((F.obj (ringObject A)).obj ⟶ Sₐ.obj E) := {
    toEquiv := {
      toFun := fun f =>
        adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) f ≫ rIso.hom
      invFun := fun g =>
        (adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k))).symm
          (g ≫ rIso.inv)
      left_inv := by intro f; simp [Category.assoc]
      right_inv := by intro g; simp [Category.assoc]
    }
    map_add' := by
      intro f g
      change
        adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) (f + g) ≫
            rIso.hom = _ + _
      have hh :=
        (adj.homAddEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k))).map_add f g
      change
        adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) (f + g) = _ at hh
      rw [hh]
      simp [Preadditive.add_comp]
    map_smul' := by
      intro r f
      change
        adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) (r • f) ≫
            rIso.hom =
          r • (adj.homEquiv (F.obj (ringObject A)).obj (Sₖ.obj (ModuleCat.of k k)) f ≫
            rIso.hom)
      rw [adj.homEquiv_apply, adj.homEquiv_apply, Functor.map_smul]
      simp [Linear.comp_smul, Linear.smul_comp, Category.assoc]
  }
  let g₀ : K ⟶ Sₖ.obj (ModuleCat.of k k) := hAdjA.symm (hImage.symm (1 : k))
  have hg₀ : g₀ ≠ 0 :=
    hAdjA.symm.map_ne_zero_iff.2 (hImage.symm.map_ne_zero_iff.2 one_ne_zero)
  have ha : a = aVan := by
    by_contra hne
    exact hg₀ (hvan a hne g₀)
  have hpc : StacksDraft.PseudoCoherence.IsPseudoCoherent K :=
    (StacksDraft.PseudoCoherence.totalDerivedExtensionScalars_preserves_pseudoCoherent
      (algebraMap A k) (F.obj (ringObject A)).obj).2
        (boundedCoherentObject_isPseudoCoherent (F.obj (ringObject A)))
  have hzero : ∀ i : ℤ, i ≠ a → IsZero ((H i).obj K) := fun i hi =>
    isZero_homology_of_hom_to_field_vanishes K hpc i (hvan i (by omega))
  let hTotalA : (K ⟶ Sₖ.obj (ModuleCat.of k k)) ≃ₗ[A] k := hAdjA.trans hImage
  let _ : IsScalarTower A k (K ⟶ Sₖ.obj (ModuleCat.of k k)) :=
    IsScalarTower.of_algebraMap_smul (by intro r f; rfl)
  let hTotalK : (K ⟶ Sₖ.obj (ModuleCat.of k k)) ≃ₗ[k] k := {
    toEquiv := hTotalA.toEquiv
    map_add' := hTotalA.map_add
    map_smul' := by
      intro s f
      obtain ⟨r, rfl⟩ := m.algebraMap_residueField_surjective s
      calc
        hTotalA ((algebraMap A k) r • f) = hTotalA (r • f) :=
          congrArg hTotalA (algebraMap_smul k r f)
        _ = r • hTotalA f := hTotalA.map_smul r f
        _ = (algebraMap A k) r • hTotalA f := (algebraMap_smul k r (hTotalA f)).symm
  }
  obtain ⟨M, ⟨eK'⟩⟩ := exists_iso_singleFunctor_obj_of_homology_vanish_off K a hzero
  let hHom : (H a).obj K ≅ M :=
    (H a).mapIso eK' ≪≫
      (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{u} k) a).app M
  let eK : K ≅ (Sₖ.obj ((H a).obj K)) := eK' ≪≫ Sₖ.mapIso hHom.symm
  let hS : ((Sₖ.obj ((H a).obj K)) ⟶ Sₖ.obj (ModuleCat.of k k)) ≃ₗ[k]
      ((H a).obj K ⟶ ModuleCat.of k k) :=
    (fullyFaithfulHomLinearEquiv (R := k) Sₖ (Functor.FullyFaithful.ofFullyFaithful Sₖ)
      ((H a).obj K) (ModuleCat.of k k)).symm
  let hDual : (K ⟶ Sₖ.obj (ModuleCat.of k k)) ≃ₗ[k] ((H a).obj K →ₗ[k] k) :=
    (Linear.homCongr k eK (Iso.refl _)).trans (hS.trans ModuleCat.homLinearEquiv)
  let _ : Module.Finite k ((H a).obj K) :=
    (((StacksDraft.PseudoCoherence.pseudoCoherent_iff_boundedAbove_finite_homology
      K 0 k).2.1.mp hpc).2 a)
  refine ⟨a, ?_, hzero⟩
  calc
    Module.finrank k ((H a).obj K) =
        Module.finrank k ((H a).obj K →ₗ[k] k) :=
      (Subspace.dual_finrank_eq (K := k) (V := (H a).obj K)).symm
    _ = Module.finrank k (K ⟶ Sₖ.obj (ModuleCat.of k k)) := hDual.finrank_eq.symm
    _ = 1 := hTotalK.finrank_eq.trans (Module.finrank_self k)

open StacksDraft.Perfect in
/-- The image of the ring is perfect: at every maximal ideal its derived fibre has no cohomology
in all sufficiently low degrees, and the pseudo-coherent stalk criterion applies. -/
public theorem isPerfect_image_ring [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory.{u, u} A ⥤ BoundedCoherentDerivedCategory.{u, u} A)
    [F.IsEquivalence] [F.Linear A] [F.Additive] :
    StacksDraft.Perfect.IsPerfect (F.obj (ringObject A)).obj := by
  let X := F.obj (ringObject A)
  let K := X.obj
  have hKpc : StacksDraft.PseudoCoherence.IsPseudoCoherent K :=
    boundedCoherentObject_isPseudoCoherent X
  have hFib : ∀ q : MaximalSpectrum A, ∃ a : ℤ, ∀ i : ℤ, i < a → IsZero
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} q.asIdeal.ResidueField) i).obj
        ((CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
          (algebraMap A q.asIdeal.ResidueField)).functor.obj K)) := by
    intro q
    let _ : q.asIdeal.IsMaximal := q.isMaximal
    obtain ⟨a, _, hzero⟩ := residueField_image_fibre_finrank_one F q.asIdeal
    exact ⟨a, fun i hi => hzero i (by omega)⟩
  rcases X.property.2 with ⟨⟨lo, hlo⟩, ⟨_, _⟩⟩
  have hGE : K.IsGE lo := by simpa [K] using hlo
  rcases isPerfect_iff_isPerfect_at_primes_of_isBoundedBelow_and_stalkwise_criteria K hKpc with
    ⟨_, hprimeMax, _, hmaxFiber, hbounded⟩
  exact (hbounded ⟨lo, hGE⟩).mpr (hprimeMax.mpr (hmaxFiber.mpr hFib))

/-- **Stacks 0A7E.** An `A`-linear autoequivalence of the bounded derived category of complexes
of `A`-modules with finite cohomology, an equivalence of categories with no compatibility with
the shift or the triangulated structure assumed, sends the ring, placed in degree zero, to an
invertible object of the unbounded derived category. -/
@[stacks 0A7E]
public theorem isInvertible_obj_ring_of_linear_isEquivalence [IsNoetherianRing A]
    (F : BoundedCoherentDerivedCategory A ⥤ BoundedCoherentDerivedCategory A)
    [F.IsEquivalence] [F.Linear A] :
    let m := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
    letI := m
    MonoidalCategory.IsInvertible (F.obj (ringObject A)).obj := by
  -- Additivity is not an extra hypothesis: `F` is full, so it preserves zero morphisms, and it
  -- preserves binary products, being an equivalence.
  have : F.Additive := F.additive_of_preserves_binary_products
  dsimp
  let _ := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
  let K := (F.obj (ringObject A)).obj
  have hrank : ∀ (m : Ideal A) (_ : m.IsMaximal), ∃ a : ℤ, ∀ i : ℤ,
      Module.finrank m.ResidueField
        ((DerivedCategory.homologyFunctor (ModuleCat.{u} m.ResidueField) i).obj
          ((CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
            (algebraMap A m.ResidueField)).functor.obj K)) = if i = a then 1 else 0 := by
    intro m hm
    let _ : m.IsMaximal := hm
    obtain ⟨a, ha, hzero⟩ := residueField_image_fibre_finrank_one F m
    refine ⟨a, fun i => ?_⟩
    by_cases hi : i = a
    · subst i
      simpa using ha
    · rw [ite_eq_right hi]
      have : Subsingleton
          ((DerivedCategory.homologyFunctor (ModuleCat.{u} m.ResidueField) i).obj
            ((CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars
              (algebraMap A m.ResidueField)).functor.obj K)) :=
        ModuleCat.isZero_iff_subsingleton.mp (hzero i hi)
      exact Module.finrank_zero_of_subsingleton
  exact (DerivedCategory.Invertible.isInvertible_iff_locallyShiftedUnit K).1.2
    (DerivedCategory.Invertible.isLocallyShiftedUnit_of_isPerfect_of_maximalFibre_finrank K
      (isPerfect_image_ring F) hrank)

end Dualizing

