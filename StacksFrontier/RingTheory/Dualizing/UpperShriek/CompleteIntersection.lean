namespace Dualizing

/-! ### Invertibility of a shifted copy of the ring -/

section Shift

open CochainComplex.DerivedExtensionScalars

/-- Derived extension of scalars takes the single complex on the ring in degree `n` to the single
complex on the extended ring in degree `n`. -/
private noncomputable def derivedExtensionScalarsSingleIso
    {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (n : ℤ) :
    (totalDerivedExtensionScalars.{u, u, u} f).functor.obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) n).obj (ModuleCat.of R R)) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} S) n).obj (ModuleCat.of S S) :=
  let D := totalDerivedExtensionScalars.{u, u, u} f
  letI := D.commShift
  D.functor.mapIso
      (((DerivedCategory.singleFunctors (ModuleCat.{u} R)).shiftIso (-n) n 0
        (by omega)).app (ModuleCat.of R R)).symm ≪≫
    (D.functor.commShiftIso (-n)).app _ ≪≫
    (shiftFunctor _ (-n)).mapIso
      (DerivedCategory.Invertible.derivedExtensionScalarsUnitIso f) ≪≫
    ((DerivedCategory.singleFunctors (ModuleCat.{u} S)).shiftIso (-n) n 0
      (by omega)).app (ModuleCat.of S S)

/-- A shifted copy of the ring is locally a shifted unit: it already is one on the whole
spectrum. -/
private theorem isLocallyShiftedUnit_single {A : Type u} [CommRing A] (n : ℤ) :
    DerivedCategory.Invertible.IsLocallyShiftedUnit
      ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj (ModuleCat.of A A)) := by
  intro p hp
  exact ⟨1, fun h => hp.ne_top ((Ideal.eq_top_iff_one p).mpr h), n,
    ⟨derivedExtensionScalarsSingleIso _ n⟩⟩

/-- A shift of an invertible object is invertible: the derived localizations that exhibit the
object as a shifted unit exhibit its shift as one too, with the degree moved. -/
private theorem isInvertible_shift {R : Type u} [CommRing R]
    (M : DerivedCategory (ModuleCat.{u} R)) (n : ℤ) :
    letI := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory R).choose
    MonoidalCategory.IsInvertible M → MonoidalCategory.IsInvertible (M⟦n⟧) := by
  let := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory R).choose
  intro hM
  apply (DerivedCategory.Invertible.isInvertible_iff_locallyShiftedUnit _).1.mpr
  intro p hp
  obtain ⟨a, ha, k, ⟨e⟩⟩ :=
    (DerivedCategory.Invertible.isInvertible_iff_locallyShiftedUnit M).1.mp hM p hp
  let D := totalDerivedExtensionScalars.{u, u, u} (algebraMap R (Localization.Away a))
  let := D.commShift
  refine ⟨a, ha, k - n, ⟨?_⟩⟩
  exact (D.functor.commShiftIso n).app M ≪≫
    (shiftFunctor _ n).mapIso e ≪≫
    ((DerivedCategory.singleFunctors (ModuleCat.{u} (Localization.Away a))).shiftIso
      n (k - n) k (by omega)).app _

/-- **A shifted copy of the ring is an invertible object of the derived category.** -/
private theorem isInvertible_single {A : Type u} [CommRing A] (n : ℤ) :
    letI := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
    MonoidalCategory.IsInvertible
      ((DerivedCategory.singleFunctor (ModuleCat.{u} A) n).obj (ModuleCat.of A A)) :=
  (DerivedCategory.Invertible.isInvertible_iff_locallyShiftedUnit _).1.mpr
    (isLocallyShiftedUnit_single n)

end Shift

/-! ### Derived Hom along a quotient by a regular sequence -/

section RegularSequence

open CochainComplex.DerivedExtensionScalars

/-- Along a bijective homomorphism, derived coextension of scalars is derived extension of
scalars: both are left adjoint to the restriction equivalence. -/
private noncomputable def derivedHomIsoDerivedExtensionScalarsOfBijective
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A) (hf : Function.Bijective f) :
    derivedHom.{u, u} f ≅ (totalDerivedExtensionScalars.{u, u, u} f).functor := by
  let D := totalDerivedExtensionScalars.{u, u, u} f
  let F := (ModuleCat.restrictScalars.{u} f).mapDerivedCategory
  letI : F.IsEquivalence := mapDerivedCategory_isEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv (RingEquiv.ofBijective f hf))
  let adjD : D.functor ⊣ F :=
    adjunctionOfModel.{u, u} f D.functor D.comparison D.isLeftDerived
  let adjH := Classical.choice (restrictScalarsDerived_adj_derivedHom.{u, u} f)
  exact adjH.rightAdjointUniq F.asEquivalence.toAdjunction ≪≫
    (adjD.leftAdjointUniq F.asEquivalence.symm.toAdjunction).symm

/-- The inverse of the conormal module of a surjection whose kernel is free of rank one, with a
chosen basis, is the target ring itself. -/
private noncomputable def conormalInverseEquivSelf {S T : Type u} [CommRing S] [CommRing T]
    [Algebra S T] (eI : RingHom.ker (algebraMap S T) ≃ₗ[S] S) :
    InvertibleKernel.conormalInverse.{u, u} S T ≃ₗ[T] T :=
  let e : InvertibleKernel.conormal.{u, u} S T ≃ₗ[T] T :=
    (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl T T)
        (ULift.moduleEquiv.trans eI)).trans
      (TensorProduct.AlgebraTensorModule.rid S T T)
  (e.arrowCongr (LinearEquiv.refl T T)).trans (LinearMap.ringLmapEquivSelf T T T)

/-- **Derived Hom along a quotient by a regular sequence.** If `g : S → T` is surjective with
kernel generated by a weakly regular sequence of length `c`, then `RHom_S(T, S)` is `T` placed in
degree `c`.

The sequence is run through one element at a time: the quotient by its first element has kernel
free of rank one, so derived Hom from it is the shift by `-1` of the unit by Stacks 0BZH, and
derived Hom composes by Stacks 0C0F. -/
private theorem nonempty_derivedHom_unitObject_iso_single (c : ℕ) :
    ∀ {S T : Type u} [CommRing S] [CommRing T] (g : S →+* T), Function.Surjective g →
      ∀ xs : List S, xs.length = c → RingTheory.Sequence.IsWeaklyRegular S xs →
        RingHom.ker g = Ideal.ofList xs →
        Nonempty ((derivedHom.{u, u} g).obj (_root_.Stacks0BZE.unitObject.{u, u} S) ≅
          (DerivedCategory.singleFunctor (ModuleCat.{u} T) (c : ℤ)).obj (ModuleCat.of T T)) := by
  induction c with
  | zero =>
    intro S T _ _ g hg xs hlen _ hker
    rw [List.length_eq_zero_iff] at hlen
    subst hlen
    have hbij : Function.Bijective g :=
      ⟨(RingHom.injective_iff_ker_eq_bot g).mpr (by simpa using hker), hg⟩
    refine ⟨(derivedHomIsoDerivedExtensionScalarsOfBijective g hbij).app _ ≪≫ ?_⟩
    exact (totalDerivedExtensionScalars.{u, u, u} g).functor.mapIso
        ((DerivedCategory.singleFunctor (ModuleCat.{u} S) 0).mapIso
          (ULift.moduleEquiv (R := S) (M := S)).toModuleIso) ≪≫
      (Nat.cast_zero (R := ℤ) ▸ DerivedCategory.Invertible.derivedExtensionScalarsUnitIso g)
  | succ c ih =>
    intro S T _ _ g hg xs hlen hxs hker
    obtain ⟨x, xs, rfl⟩ : ∃ (y : S) (ys : List S), xs = y :: ys := by
      cases xs with
      | nil => simp at hlen
      | cons y ys => exact ⟨y, ys, rfl⟩
    obtain ⟨hx, htail⟩ := (RingTheory.Sequence.isWeaklyRegular_cons_iff S x xs).mp hxs
    let J : Ideal S := Ideal.span {x}
    let S' := S ⧸ J
    let a : S →+* S' := algebraMap S S'
    have ha : Function.Surjective a := Ideal.Quotient.mk_surjective (I := J)
    have hJ : J ≤ RingHom.ker g := by
      rw [hker, Ideal.ofList_cons]
      exact le_sup_left
    let b : S' →+* T := Ideal.Quotient.lift J g fun r hr => RingHom.mem_ker.mp (hJ hr)
    have hab : b.comp a = g := rfl
    have hb : Function.Surjective b := by
      intro y
      obtain ⟨r, rfl⟩ := hg y
      exact ⟨a r, congrArg (· r) hab⟩
    have hkerA : RingHom.ker a = J := Ideal.mk_ker (I := J)
    -- the first element generates a free kernel of rank one
    have hx' : ∀ r : S, r * x = 0 → r = 0 := fun r hr => hx (by simpa [mul_comm] using hr)
    have hinv : Module.Invertible S (RingHom.ker (algebraMap S S')) :=
      (InvertibleKernel.surjective_and_invertible_ker_quotient x hx').2
    let eI : RingHom.ker (algebraMap S S') ≃ₗ[S] S :=
      (LinearEquiv.ofEq _ _ hkerA).trans
        (InvertibleKernel.spanSingletonEquiv x hx').symm
    -- the tail is weakly regular on the quotient and generates the kernel of `b`
    have he : (x • ⊤ : Submodule S S) = J := by
      rw [← Submodule.ideal_span_singleton_smul, Ideal.smul_top_eq_map]
      simp [J]
    have htail' : RingTheory.Sequence.IsWeaklyRegular S' (xs.map a) :=
      (RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff S' S' xs).mpr
        (((Submodule.quotEquivOfEq _ _ he).isWeaklyRegular_congr xs).mp htail)
    have hkb : RingHom.ker b = Ideal.ofList (xs.map a) := by
      rw [← Ideal.map_ofList,
        show b = Ideal.Quotient.lift J g (fun r hr => RingHom.mem_ker.mp (hJ hr)) from rfl,
        Ideal.ker_quotient_lift g hJ, hker, Ideal.ofList_cons, Ideal.map_sup,
        show a = Ideal.Quotient.mk J from Ideal.Quotient.algebraMap_eq J,
        Ideal.map_quotient_self, bot_sup_eq]
    -- the step at the first element
    let eStep : (derivedHom.{u, u} a).obj (_root_.Stacks0BZE.unitObject.{u, u} S) ≅
        (_root_.Stacks0BZE.unitObject.{u, u} S')⟦(-1 : ℤ)⟧ :=
      InvertibleKernel.derivedHomUnitObjectIsoSingle.{u, u} ha hinv ≪≫
        (DerivedCategory.singleFunctor (ModuleCat.{u} S') 1).mapIso
          ((conormalInverseEquivSelf eI).toModuleIso ≪≫
            (ULift.moduleEquiv (R := S') (M := S')).symm.toModuleIso) ≪≫
        (((DerivedCategory.singleFunctors (ModuleCat.{u} S')).shiftIso (-1) 1 0
          (by omega)).app (ModuleCat.of S' (ULift.{u} S'))).symm
    obtain ⟨eTail⟩ := ih b hb (xs.map a) (by simpa using hlen) htail' hkb
    obtain ⟨eComp⟩ := derivedHomCompIso.{u, u} a b
    let := derivedHomCommShift.{u, u, u} b
    refine ⟨?_⟩
    calc (derivedHom.{u, u} g).obj (_root_.Stacks0BZE.unitObject.{u, u} S)
        ≅ (derivedHom.{u, u} (b.comp a)).obj (_root_.Stacks0BZE.unitObject.{u, u} S) :=
          eqToIso (by rw [hab])
      _ ≅ (derivedHom.{u, u} b).obj
            ((derivedHom.{u, u} a).obj (_root_.Stacks0BZE.unitObject.{u, u} S)) :=
          (eComp.app _).symm
      _ ≅ (derivedHom.{u, u} b).obj ((_root_.Stacks0BZE.unitObject.{u, u} S')⟦(-1 : ℤ)⟧) :=
          (derivedHom.{u, u} b).mapIso eStep
      _ ≅ ((derivedHom.{u, u} b).obj (_root_.Stacks0BZE.unitObject.{u, u} S'))⟦(-1 : ℤ)⟧ :=
          ((derivedHom.{u, u} b).commShiftIso (-1)).app _
      _ ≅ ((DerivedCategory.singleFunctor (ModuleCat.{u} T) (c : ℤ)).obj
            (ModuleCat.of T T))⟦(-1 : ℤ)⟧ := (shiftFunctor _ (-1 : ℤ)).mapIso eTail
      _ ≅ (DerivedCategory.singleFunctor (ModuleCat.{u} T) ((c + 1 : ℕ) : ℤ)).obj
            (ModuleCat.of T T) :=
          ((DerivedCategory.singleFunctors (ModuleCat.{u} T)).shiftIso (-1)
            ((c + 1 : ℕ) : ℤ) (c : ℤ) (by push_cast; omega)).app (ModuleCat.of T T)

end RegularSequence

namespace PolynomialPresentation

variable {R A : Type u} [CommRing R] [CommRing A] {f : R →+* A}

/-- Extension of scalars takes the free module of rank one, in the module universe, to the free
module of rank one. -/
private noncomputable def extendScalarsULiftUnitIso {S T : Type u} [CommRing S] [CommRing T]
    (g : S →+* T) :
    (ModuleCat.extendScalars.{u, u, u} g).obj (ModuleCat.of S (ULift.{u} S)) ≅
      ModuleCat.of T (ULift.{u} T) := by
  letI := g.toAlgebra
  exact ((TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl T T)
        (ULift.moduleEquiv (R := S) (M := S))).trans
      (TensorProduct.AlgebraTensorModule.rid S T T)).toModuleIso ≪≫
    (ULift.moduleEquiv (R := T) (M := T)).symm.toModuleIso

/-- Derived base change along the polynomial algebra of a presentation takes the unit of `D(R)`
to the unit of `D(P)`. -/
private noncomputable def derivedExtensionUnitIso (p : PolynomialPresentation f) :
    p.derivedExtension.{u, u}.obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
          (ModuleCat.of R (ULift.{u} R))) ≅
      _root_.Stacks0BZE.unitObject.{u, u} p.Poly := by
  letI : Limits.PreservesFiniteLimits
      (ModuleCat.extendScalars.{u, u, u} (MvPolynomial.C : R →+* p.Poly)) :=
    extendScalars_preservesFiniteLimits_of_flat'.{u, u} _ p.flat_C
  exact ((ModuleCat.extendScalars.{u, u, u}
        (MvPolynomial.C : R →+* p.Poly)).mapDerivedCategorySingleFunctor 0).app
      (ModuleCat.of R (ULift.{u} R)) ≪≫
    (DerivedCategory.singleFunctor (ModuleCat.{u} p.Poly) 0).mapIso
      (extendScalarsULiftUnitIso (MvPolynomial.C : R →+* p.Poly))

/-- **The relative dualizing complex of a complete intersection presentation.**  Let `p` be a
polynomial presentation of `φ : R → A` in `n` variables whose kernel is generated by a weakly
regular sequence of length `c`.  Then `ω_{A/R} = φ^!(R)` is the free `A`-module of rank one
placed in degree `c - n`.

Upper shriek of a presentation is `RHom_P(A, - ⊗_R^L P)[n]`, the derived base change takes the
unit of `D(R)` to the unit of `D(P)`, and `RHom_P(A, P)` is `A` in degree `c`, the sequence being
run through one element at a time. -/
theorem nonempty_upperShriekFunctor_obj_unit_iso_single
    (p : PolynomialPresentation f) {xs : List p.Poly}
    (hxs : RingTheory.Sequence.IsWeaklyRegular p.Poly xs)
    (hker : RingHom.ker p.toRingHom = Ideal.ofList xs) :
    letI : MonoidalCategoryStruct (ModuleCat.{u} R) :=
      ModuleCat.liftedModuleMonoidalStruct.{u, u}
    letI : MonoidalCategory (ModuleCat.{u} R) := ModuleCat.liftedModuleMonoidal.{u, u}
    let R₀ := (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (MonoidalCategoryStruct.tensorUnit (ModuleCat.{u} R))
    Nonempty (p.upperShriekFunctor.{u, u}.obj R₀ ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} A)
        ((xs.length : ℤ) - (p.variableCount : ℤ))).obj (ModuleCat.of A A)) := by
  intro R₀
  obtain ⟨eChain⟩ := nonempty_derivedHom_unitObject_iso_single.{u} xs.length p.toRingHom
    p.surjective xs rfl hxs hker
  exact ⟨(shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ)).mapIso
        ((derivedHom.{u, u} p.toRingHom).mapIso (derivedExtensionUnitIso p) ≪≫ eChain) ≪≫
      ((DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso (p.variableCount : ℤ)
        ((xs.length : ℤ) - (p.variableCount : ℤ)) (xs.length : ℤ)
          (by omega)).app (ModuleCat.of A A)⟩

/-- **Stacks 0E4B**, invertibility of the relative dualizing complex, for a presentation whose
kernel is generated by a weakly regular sequence.  Let `p` be a polynomial presentation of
`φ : R → A` in `n` variables whose kernel is generated by a weakly regular sequence of length
`c`.  Then `ω_{A/R} = φ^!(R)` is an invertible object of `D(A)`.

It is the free module of rank one in degree `c - n` by
`nonempty_upperShriekFunctor_obj_unit_iso_single`, and such an object is
locally a shifted unit on the whole spectrum, hence invertible by [Stacks, Tag 0FNT].

This is the special case of a global complete intersection; the local complete intersection
hypothesis of the source is
`isInvertible_upperShriekFunctor_obj_unit_of_isKoszulRegular` below, which does not go through
this statement. -/
theorem isInvertible_upperShriekFunctor_obj_unit_of_isWeaklyRegular
    (p : PolynomialPresentation f) {xs : List p.Poly}
    (hxs : RingTheory.Sequence.IsWeaklyRegular p.Poly xs)
    (hker : RingHom.ker p.toRingHom = Ideal.ofList xs) :
    letI : MonoidalCategoryStruct (ModuleCat.{u} R) :=
      ModuleCat.liftedModuleMonoidalStruct.{u, u}
    letI : MonoidalCategory (ModuleCat.{u} R) := ModuleCat.liftedModuleMonoidal.{u, u}
    let R₀ := (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (MonoidalCategoryStruct.tensorUnit (ModuleCat.{u} R))
    letI := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
    MonoidalCategory.IsInvertible (p.upperShriekFunctor.{u, u}.obj R₀) := by
  intro R₀
  let := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
  obtain ⟨e⟩ :=
    nonempty_upperShriekFunctor_obj_unit_iso_single p hxs hker
  exact isInvertible_of_iso e.symm (isInvertible_single _)

/-- **Stacks 0E4B**, invertibility of the relative dualizing complex, the local complete
intersection case.  Let `p` be a polynomial presentation of `φ : R → A` with `R` Noetherian
whose kernel is a Koszul-regular ideal.  Then `ω_{A/R} = φ^!(R)` is an invertible object
of `D(A)`.

Invertibility is local by [Stacks, Tag 0FNT], so it is enough to exhibit, at each prime `𝔮` of
`A`, a localization `A_h` on which the relative dualizing complex becomes the free module of rank
one in some degree.  Over the contraction of `𝔮` to the polynomial algebra `P` the kernel becomes,
after one principal localization `P → P_g`, generated by an honest regular sequence
(`Dualizing.LocalCompleteIntersection.exists_away_regular_generators_of_isKoszulRegular`), so
`RHom_{P_g}(A_{φ(g)}, P_g)` is the free module of rank one in the degree given by its length.  That
computation is transported back to `A_{φ(g)}` by
`Dualizing.LocalCompleteIntersection.nonempty_iso_single_away`, which compares the derived
localization of `RHom_P(A, P)` with `RHom_{P_g}(A_{φ(g)}, P_g)` degreewise through `Ext`.  The
shift by the number of variables is harmless, a shift of an invertible object being
invertible. -/
theorem isInvertible_upperShriekFunctor_obj_unit_of_isKoszulRegular
    [IsNoetherianRing R] (p : PolynomialPresentation f)
    (hker : Ideal.IsKoszulRegular (RingHom.ker p.toRingHom)) :
    letI : MonoidalCategoryStruct (ModuleCat.{u} R) :=
      ModuleCat.liftedModuleMonoidalStruct.{u, u}
    letI : MonoidalCategory (ModuleCat.{u} R) := ModuleCat.liftedModuleMonoidal.{u, u}
    let R₀ := (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (MonoidalCategoryStruct.tensorUnit (ModuleCat.{u} R))
    letI := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
    MonoidalCategory.IsInvertible (p.upperShriekFunctor.{u, u}.obj R₀) := by
  intro R₀
  let := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
  let : Algebra p.Poly A := p.toRingHom.toAlgebra
  have hLSU : DerivedCategory.Invertible.IsLocallyShiftedUnit
      ((derivedHom.{u, u} p.toRingHom).obj (_root_.Stacks0BZE.unitObject.{u, u} p.Poly)) := by
    intro q hq
    let := hq
    let : (q.comap p.toRingHom).IsPrime := Ideal.IsPrime.comap p.toRingHom
    have hle : RingHom.ker p.toRingHom ≤ q.comap p.toRingHom := by
      intro x hx
      change p.toRingHom x ∈ q
      rw [RingHom.mem_ker.mp hx]
      exact q.zero_mem
    obtain ⟨g, hg, c, xs, hreg, hspan⟩ :=
      LocalCompleteIntersection.exists_away_regular_generators_of_isKoszulRegular
        (RingHom.ker p.toRingHom) hker (q.comap p.toRingHom) hle
    have hlist : Ideal.ofList (List.ofFn xs) = Ideal.span (Set.range xs) := by
      unfold Ideal.ofList
      congr 1
      ext z
      simp [List.mem_ofFn]
    refine ⟨p.toRingHom g, hg, (c : ℤ), ?_⟩
    refine LocalCompleteIntersection.nonempty_iso_single_away g p.surjective (c : ℤ) ?_
    have hb : Function.Surjective (IsLocalization.Away.map (Localization.Away g)
        (Localization.Away (p.toRingHom g)) p.toRingHom g) := by
      refine (IsLocalization.Away.map_surjective_iff (Localization.Away g)
        (Localization.Away (p.toRingHom g)) p.toRingHom g).mpr ?_
      intro y
      obtain ⟨x, rfl⟩ := p.surjective y
      exact ⟨x, 0, by simp⟩
    have hk : RingHom.ker (IsLocalization.Away.map (Localization.Away g)
        (Localization.Away (p.toRingHom g)) p.toRingHom g) =
        Ideal.ofList (List.ofFn xs) := by
      rw [hlist]
      change RingHom.ker (IsLocalization.map (Localization.Away (p.toRingHom g))
        p.toRingHom _) = _
      rw [IsLocalization.ker_map (Localization.Away (p.toRingHom g)) p.toRingHom
        (Submonoid.map_powers p.toRingHom g)]
      exact hspan
    exact nonempty_derivedHom_unitObject_iso_single.{u} c _ hb (List.ofFn xs)
      (by simp) hreg.toIsWeaklyRegular hk
  refine isInvertible_of_iso ?_ (isInvertible_shift _ (p.variableCount : ℤ)
    ((DerivedCategory.Invertible.isInvertible_iff_locallyShiftedUnit _).1.mpr hLSU))
  exact ((shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ)).mapIso
    ((derivedHom.{u, u} p.toRingHom).mapIso (derivedExtensionUnitIso p))).symm

/-- **Stacks 0E4B**, invertibility of the relative dualizing complex of a local complete
intersection homomorphism.  Let `φ : R → A` be a local complete intersection homomorphism with
`R` Noetherian and let `p` be any polynomial presentation of `φ`.  Then `ω_{A/R} = φ^!(R)` is an
invertible object of `D(A)`.

The kernel of one presentation is Koszul-regular by the definition of a local complete
intersection, hence the kernel of every presentation is, by [Stacks, Tag 07CZ]; so
`isInvertible_upperShriekFunctor_obj_unit_of_isKoszulRegular` applies to `p`. -/
@[stacks 0E4B]
theorem isInvertible_upperShriekFunctor_obj_unit_of_isLocalCompleteIntersection
    [IsNoetherianRing R] (p : PolynomialPresentation f)
    (hf : f.IsLocalCompleteIntersection) :
    letI : MonoidalCategoryStruct (ModuleCat.{u} R) :=
      ModuleCat.liftedModuleMonoidalStruct.{u, u}
    letI : MonoidalCategory (ModuleCat.{u} R) := ModuleCat.liftedModuleMonoidal.{u, u}
    let R₀ := (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (MonoidalCategoryStruct.tensorUnit (ModuleCat.{u} R))
    letI := (DerivedCategory.Invertible.derivedCategory_symmetricMonoidalCategory A).choose
    MonoidalCategory.IsInvertible (p.upperShriekFunctor.{u, u}.obj R₀) := by
  intro R₀
  let := f.toAlgebra
  obtain ⟨n, α, hα, hI⟩ := hf.2
  let β : MvPolynomial (Fin p.variableCount) R →ₐ[R] A :=
    { p.toRingHom with commutes' := fun r => RingHom.congr_fun p.commutes r }
  exact isInvertible_upperShriekFunctor_obj_unit_of_isKoszulRegular p
    (RingHom.isKoszulRegularIdeal_ker_of_surjective_mvPolynomial α hα hI β p.surjective)

/-- **Stacks 0E4B**, the formula for upper shriek.  Let `φ : R → A` be a local complete
intersection homomorphism and let `p` be a polynomial presentation of `φ`.
Then `φ^!(K) = K ⊗_R^L ω_{A/R}` with `ω_{A/R} = φ^!(R)`, naturally in `K` in `D(R)`.

A local complete intersection homomorphism is perfect by [Stacks, Tag 07EN], so `A` is a perfect
module over the polynomial algebra of `p` by [Stacks, Tag 068Y], which is what the tensor formula
of [Stacks, Tag 0BZU] asks for, and that formula asks for nothing else: the
conclusion of [Stacks, Tag 0BZE] for the surjection of the presentation holds at the arbitrary
module universe `max v u` of this statement, by
`Dualizing.nonempty_derivedHom_iso_canonicalDerivedTensor_of_perfect_anyModuleUniverse`. -/
@[stacks 0E4B "the formula φ^!(K) = K ⊗_R^L ω_{A/R}, at an arbitrary polynomial presentation and \
an arbitrary module universe"]
theorem upperShriekFunctor_iso_derivedTensorProduct_of_lci
    (p : PolynomialPresentation f)
    (hf : f.IsLocalCompleteIntersection) :
    letI : MonoidalCategoryStruct (ModuleCat.{max v u} R) :=
      ModuleCat.liftedModuleMonoidalStruct.{u, max v u}
    letI : MonoidalCategory (ModuleCat.{max v u} R) :=
      ModuleCat.liftedModuleMonoidal.{u, max v u}
    let R₀ := (DerivedCategory.singleFunctor (ModuleCat.{max v u} R) 0).obj
      (MonoidalCategoryStruct.tensorUnit (ModuleCat.{max v u} R))
    Nonempty (p.upperShriekFunctor.{u, v} ≅
      derivedTensorProductOver.{u, v} f (p.upperShriekFunctor.{u, v}.obj R₀)) :=
  p.upperShriekFunctor_iso_derivedTensorProduct.{u, v} (by
    have := hf.perfect
    algebraize [f]
    let : Module p.Poly A := Module.compHom A p.toRingHom
    exact (StacksDraft.Perfect.isPerfectModule_iff_exists_finite_projective_resolution A).mpr
      (Algebra.Perfect.exists_finite_projective_resolution
        (AlgHom.mk p.toRingHom fun r ↦ congrArg (· r) p.commutes) p.surjective))

end PolynomialPresentation

end Dualizing

