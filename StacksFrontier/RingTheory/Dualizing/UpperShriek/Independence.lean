/-- The conclusion of [Stacks, Tag 0BZH] at the evaluation surjection `B[x] ↠ B`, whose kernel is
generated by the nonzerodivisor `x - b`; it is the one input of [Stacks, Tag 0BZJ] not proved in
this file, and is proved as `Dualizing.polynomialEvalDuality`.  It says that `RHom_{B[x]}(B, -)`
is derived base change along the evaluation map, shifted by `-1`, the base change being presented
by an arbitrary total left derived functor of extension of scalars. -/
def PolynomialEvalDuality : Prop :=
  ∀ (B : Type w) [CommRing B] (b : B)
    (LF : DerivedCategory (ModuleCat.{w} (Polynomial B)) ⥤
      DerivedCategory (ModuleCat.{w} B))
    (alpha : DerivedCategory.Qh ⋙ LF ⟶
      (ModuleCat.extendScalars (Polynomial.evalRingHom b)).mapHomotopyCategory
        (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh),
    LF.IsLeftDerivedFunctor alpha
        (HomotopyCategory.quasiIso (ModuleCat.{w} (Polynomial B)) (ComplexShape.up ℤ)) →
    Nonempty (derivedHom.{w, w} (Polynomial.evalRingHom b) ≅
      LF ⋙ shiftFunctor (DerivedCategory (ModuleCat.{w} B)) (-1 : ℤ))

namespace Independence

variable {R A : Type u} [CommRing R] [CommRing A]
private abbrev polynomialEvalProjectives (B : Type u) [CommRing B] :
    ObjectProperty (ModuleCat.{u} B) := fun M => Projective M

private instance polynomialEvalProjectives_containsZero
    (B : Type u) [CommRing B] : (polynomialEvalProjectives B).ContainsZero :=
  ⟨ModuleCat.of B (Fin 0 → B), ModuleCat.isZero_of_subsingleton _, inferInstance⟩

private lemma polynomialEvalProjectives_biprod {B : Type u} [CommRing B]
    (M N : ModuleCat.{u} B) (hM : polynomialEvalProjectives B M)
    (hN : polynomialEvalProjectives B N) :
    polynomialEvalProjectives B (M ⊞ N) := by
  let := hM
  let := hN
  exact inferInstanceAs (Projective (M ⊞ N))

private lemma polynomialEvalProjectives_cover {B : Type u} [CommRing B]
    (M : ModuleCat.{u} B) :
    ∃ (N : ModuleCat.{u} B) (_ : polynomialEvalProjectives B N)
      (p : N ⟶ M), Epi p :=
  ⟨Projective.over M, inferInstance, Projective.π M, inferInstance⟩

private lemma acyclic_extendScalars_of_projective_eval
    {B C : Type u} [CommRing B] [CommRing C] (q : B →+* C) (a : ℤ)
    (L : CochainComplex (ModuleCat.{u} B) ℤ) (hLE : L.IsStrictlyLE a)
    (hproj : ∀ n : ℤ, Projective (L.X n)) (hac : L.Acyclic) :
    (((ModuleCat.extendScalars q).mapHomologicalComplex (ComplexShape.up ℤ)).obj L).Acyclic := by
  have : L.IsKProjective := CochainComplex.isKProjective_of_projective L a
  have hz : IsZero
      ((HomotopyCategory.quotient (ModuleCat.{u} B) (ComplexShape.up ℤ)).obj L) := by
    rw [IsZero.iff_id_eq_zero]
    exact CochainComplex.IsKProjective.leftOrthogonal L (𝟙 _)
      ((HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_acyclic L).2 hac)
  have hz2 := ((ModuleCat.extendScalars q).mapHomotopyCategory
    (ComplexShape.up ℤ)).map_isZero hz
  rw [← HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_acyclic]
  exact (HomotopyCategory.subcategoryAcyclic (ModuleCat.{u} C)).prop_of_isZero hz2

private theorem polynomialEval_derivedData
    {B : Type u} [CommRing B] (b : B) :
    ∃ (LF : DerivedCategory (ModuleCat.{u} (Polynomial B)) ⥤
        DerivedCategory (ModuleCat.{u} B))
      (alpha : DerivedCategory.Qh ⋙ LF ⟶
        (ModuleCat.extendScalars (Polynomial.evalRingHom b)).mapHomotopyCategory
          (.up ℤ) ⋙ DerivedCategory.Qh),
      LF.IsLeftDerivedFunctor alpha
        (HomotopyCategory.quasiIso (ModuleCat.{u} (Polynomial B)) (.up ℤ)) := by
  let q : Polynomial B →+* B := Polynomial.evalRingHom b
  let : AB5OfSize.{0, 0, u, u + 1} AddCommGrpCat.{u} :=
    AB5OfSize_of_univLE.{0, 0, u, u} AddCommGrpCat.{u}
  let : HasExactColimitsOfShape ℕ (ModuleCat.{u} (Polynomial B)) :=
    HasExactColimitsOfShape.domain_of_functor ℕ
      (forget₂ (ModuleCat.{u} (Polynomial B)) AddCommGrpCat.{u})
  let : HasExactColimitsOfShape ℕ (ModuleCat.{u} B) :=
    HasExactColimitsOfShape.domain_of_functor ℕ
      (forget₂ (ModuleCat.{u} B) AddCommGrpCat.{u})
  let G := ModuleCat.extendScalars q
  let H := G.mapHomotopyCategory (.up ℤ) ⋙ DerivedCategory.Qh
  let : H.HasPointwiseLeftDerivedFunctor
      (HomotopyCategory.quasiIso (ModuleCat.{u} (Polynomial B)) (.up ℤ)) :=
    CategoryTheory.Functor.hasPointwiseLeftDerivedFunctor_of_acyclic_mapHomologicalComplex
      G (polynomialEvalProjectives (Polynomial B)) polynomialEvalProjectives_biprod
      polynomialEvalProjectives_cover fun a L hLE hP hac =>
        acyclic_extendScalars_of_projective_eval q a L hLE hP hac
  let LF := H.totalLeftDerived DerivedCategory.Qh
    (HomotopyCategory.quasiIso (ModuleCat.{u} (Polynomial B)) (.up ℤ))
  let alpha0 := H.totalLeftDerivedCounit DerivedCategory.Qh
    (HomotopyCategory.quasiIso (ModuleCat.{u} (Polynomial B)) (.up ℤ))
  exact ⟨LF, alpha0, inferInstance⟩

private lemma rightKanPrecompLocalization {C C' D H : Type*}
    [Category* C] [Category* C'] [Category* D] [Category* H]
    (q : C' ⥤ C)
    [((whiskeringLeft C' C H).obj q).Full]
    [((whiskeringLeft C' C H).obj q).Faithful]
    {L : C ⥤ D} {F : C ⥤ H} (LF : D ⥤ H) (alpha : L ⋙ LF ⟶ F) :
    LF.IsRightKanExtension alpha ↔ LF.IsRightKanExtension
      ((Functor.associator _ _ _).hom ≫ Functor.whiskerLeft q alpha) := by
  have hPrecomp : (RightExtension.precomp L F q).IsEquivalence := by
    apply CostructuredArrow.isEquivalenceMap₂
  let e : (RightExtension.mk LF alpha).IsUniversal ≃
      (RightExtension.mk LF ((Functor.associator _ _ _).hom ≫
        Functor.whiskerLeft q alpha)).IsUniversal :=
    (IsTerminal.isTerminalIffObj (RightExtension.precomp L F q)
      (RightExtension.mk LF alpha)).trans
      (IsTerminal.equivOfIso (CostructuredArrow.isoMk (Iso.refl _)))
  exact ⟨fun h => ⟨⟨e (isUniversalOfIsRightKanExtension LF alpha)⟩⟩,
    fun h => ⟨⟨e.symm (isUniversalOfIsRightKanExtension LF _)⟩⟩⟩

private lemma rightKanIsoChange {C D H : Type*}
    [Category* C] [Category* D] [Category* H]
    {L₀ L₁ : C ⥤ D} {F₀ F₁ : C ⥤ H} (LF : D ⥤ H)
    (eL : L₀ ≅ L₁) (eF : F₁ ≅ F₀) (alpha : L₁ ⋙ LF ⟶ F₁) :
    LF.IsRightKanExtension alpha ↔
      LF.IsRightKanExtension (Functor.whiskerRight eL.hom LF ≫ alpha ≫ eF.hom) := by
  have h₁ := isRightKanExtension_iff_postcomp₁ (𝟭 D)
    (Functor.rightUnitor L₀ ≪≫ eL) alpha
  have heq : (Functor.associator L₀ (𝟭 D) LF).inv ≫
      Functor.whiskerRight (Functor.rightUnitor L₀ ≪≫ eL).hom LF ≫ alpha =
      Functor.whiskerRight eL.hom LF ≫ alpha := by
    ext
    simp
  rw [heq] at h₁
  exact h₁.trans (isRightKanExtension_iff_of_iso₂
    (Functor.whiskerRight eL.hom LF ≫ alpha)
    (Functor.whiskerRight eL.hom LF ≫ alpha ≫ eF.hom)
    eF (Iso.refl LF) (by simp))

private noncomputable def homotopyCategoryDerivedComparison
    {B D : Type u} [CommRing B] [CommRing D]
    (G : ModuleCat.{u} B ⥤ ModuleCat.{u} D) [G.Additive]
    (LF : DerivedCategory (ModuleCat.{u} B) ⥤ DerivedCategory (ModuleCat.{u} D))
    (alpha : DerivedCategory.Qh ⋙ LF ⟶
      G.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh) :
    DerivedCategory.Q ⋙ LF ⟶
        G.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q := by
  let qB := HomotopyCategory.quotient (ModuleCat.{u} B) (ComplexShape.up ℤ)
  let eF : qB ⋙ G.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh ≅
      G.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q :=
    (Functor.associator qB _ _).symm ≪≫
      Functor.isoWhiskerRight
        (Functor.mapHomotopyCategoryFactors G (ComplexShape.up ℤ)) _ ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft (G.mapHomologicalComplex (ComplexShape.up ℤ))
        (DerivedCategory.quotientCompQhIso (ModuleCat.{u} D))
  exact Functor.whiskerRight
      (DerivedCategory.quotientCompQhIso (ModuleCat.{u} B)).inv LF ≫
      (Functor.associator _ _ _).hom ≫ Functor.whiskerLeft qB alpha ≫ eF.hom

private theorem leftDerivedFunctor_of_homotopyCategory
    {B D : Type u} [CommRing B] [CommRing D]
    (G : ModuleCat.{u} B ⥤ ModuleCat.{u} D) [G.Additive]
    (LF : DerivedCategory (ModuleCat.{u} B) ⥤ DerivedCategory (ModuleCat.{u} D))
    (alpha : DerivedCategory.Qh ⋙ LF ⟶
      G.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh)
    [LF.IsLeftDerivedFunctor alpha
      (HomotopyCategory.quasiIso (ModuleCat.{u} B) (ComplexShape.up ℤ))] :
    LF.IsLeftDerivedFunctor (homotopyCategoryDerivedComparison G LF alpha)
      (HomologicalComplex.quasiIso (ModuleCat.{u} B) (ComplexShape.up ℤ)) := by
  let qB := HomotopyCategory.quotient (ModuleCat.{u} B) (ComplexShape.up ℤ)
  let Wht := HomologicalComplex.homotopyEquivalences (ModuleCat.{u} B) (ComplexShape.up ℤ)
  let eL := DerivedCategory.quotientCompQhIso (ModuleCat.{u} B)
  let eF : qB ⋙ G.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh ≅
      G.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q :=
    (Functor.associator qB _ _).symm ≪≫
      Functor.isoWhiskerRight
        (Functor.mapHomotopyCategoryFactors G (ComplexShape.up ℤ)) _ ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft (G.mapHomologicalComplex (ComplexShape.up ℤ))
        (DerivedCategory.quotientCompQhIso (ModuleCat.{u} D))
  have : qB.IsLocalization Wht := inferInstance
  have := CategoryTheory.Localization.full_whiskeringLeft qB Wht
    (DerivedCategory (ModuleCat.{u} D))
  have := CategoryTheory.Localization.faithful_whiskeringLeft qB Wht
    (DerivedCategory (ModuleCat.{u} D))
  have hAlpha : LF.IsRightKanExtension alpha :=
    IsLeftDerivedFunctor.isRightKanExtension LF alpha
      (HomotopyCategory.quasiIso (ModuleCat.{u} B) (ComplexShape.up ℤ))
  have hPre := (rightKanPrecompLocalization qB LF alpha).mp hAlpha
  let beta : DerivedCategory.Q ⋙ LF ⟶
      G.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q :=
    Functor.whiskerRight eL.inv LF ≫
      (Functor.associator _ _ _).hom ≫ Functor.whiskerLeft qB alpha ≫ eF.hom
  have hcomm : Functor.whiskerRight eL.hom LF ≫ beta ≫ eF.symm.hom =
      (Functor.associator _ _ _).hom ≫ Functor.whiskerLeft qB alpha := by
    simp only [beta, Category.assoc]
    rw [← whiskerRight_comp_assoc]
    simp
    rfl
  rw [Functor.isLeftDerivedFunctor_iff_isRightKanExtension]
  exact (rightKanIsoChange LF eL eF.symm beta).mpr (by rwa [hcomm])

private theorem mapDerivedCategory_isLeftDerived
    {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D]
    [HasDerivedCategory C] [HasDerivedCategory D]
    (F : C ⥤ D) [F.Additive]
    [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] :
    F.mapDerivedCategory.IsLeftDerivedFunctor F.mapDerivedCategoryFactors.hom
      (HomologicalComplex.quasiIso C (ComplexShape.up ℤ)) :=
  Functor.isLeftDerivedFunctor_of_inverts
    (HomologicalComplex.quasiIso C (ComplexShape.up ℤ))
    F.mapDerivedCategory F.mapDerivedCategoryFactors

/-- Extension of scalars along a flat ring map is additive and preserves finite limits and finite
colimits. -/
private lemma extendScalars_exact_of_flat {B C : Type u} [CommRing B] [CommRing C]
    (c : B →+* C) (hc : c.Flat) :
    (ModuleCat.extendScalars.{u, u, max w u} c).Additive ∧
      Limits.PreservesFiniteLimits (ModuleCat.extendScalars.{u, u, max w u} c) ∧
      Limits.PreservesFiniteColimits (ModuleCat.extendScalars.{u, u, max w u} c) := by
  have : Limits.PreservesFiniteLimits (ModuleCat.extendScalars.{u, u, max w u} c) :=
    extendScalars_preservesFiniteLimits_of_flat' c hc
  have : Limits.PreservesColimits (ModuleCat.extendScalars.{u, u, max w u} c) :=
    (ModuleCat.extendRestrictScalarsAdj c).leftAdjoint_preservesColimits
  have := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts
    (ModuleCat.extendScalars.{u, u, max w u} c)
  exact ⟨Functor.additive_of_preservesBinaryBiproducts _, inferInstance, inferInstance⟩

/-- Transport of a comparison for extension of scalars along `c` to an equal ring map `c'`. -/
private noncomputable def derivedComparisonOfEq {B C : Type u} [CommRing B] [CommRing C]
    {c c' : B →+* C} (h : c' = c)
    (LF : DerivedCategory (ModuleCat.{u} B) ⥤ DerivedCategory (ModuleCat.{u} C))
    (alpha : DerivedCategory.Q ⋙ LF ⟶
      (ModuleCat.extendScalars.{u, u, u} c).mapHomologicalComplex (ComplexShape.up ℤ) ⋙
        DerivedCategory.Q) :
    DerivedCategory.Q ⋙ LF ⟶
      (ModuleCat.extendScalars.{u, u, u} c').mapHomologicalComplex (ComplexShape.up ℤ) ⋙
        DerivedCategory.Q := by
  subst h
  exact alpha

/-- Transporting a left derived functor of extension of scalars along an equality of ring maps
keeps it a left derived functor. -/
private lemma isLeftDerivedFunctor_derivedComparisonOfEq {B C : Type u} [CommRing B] [CommRing C]
    {c c' : B →+* C} (h : c' = c)
    (LF : DerivedCategory (ModuleCat.{u} B) ⥤ DerivedCategory (ModuleCat.{u} C))
    (alpha : DerivedCategory.Q ⋙ LF ⟶
      (ModuleCat.extendScalars.{u, u, u} c).mapHomologicalComplex (ComplexShape.up ℤ) ⋙
        DerivedCategory.Q)
    [LF.IsLeftDerivedFunctor alpha
      (HomologicalComplex.quasiIso (ModuleCat.{u} B) (ComplexShape.up ℤ))] :
    LF.IsLeftDerivedFunctor (derivedComparisonOfEq h LF alpha)
      (HomologicalComplex.quasiIso (ModuleCat.{u} B) (ComplexShape.up ℤ)) := by
  subst h
  exact ‹_›

private noncomputable def derivedHom_ringEquivIso_right
    {B C : Type u} [CommRing B] [CommRing C]
    {B' : Type u} [CommRing B'] (eB : B' ≃+* B) (f : B →+* C) :
    let EB := mapDerivedCategoryEquivalenceOfEquivalence
      (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{u, u, u} eB)
    EB.functor ⋙ derivedHom.{u, 0}
      (RingHom.id C |>.comp (f.comp eB.toRingHom)) ≅
      derivedHom.{u, 0} f := by
  let EB := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{u, u, u} eB)
  let EC := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{u, u, u} (RingEquiv.refl C))
  let h := derivedHomRingEquivIso.{u, 0} eB (RingEquiv.refl C) f
  exact h ≪≫
    Functor.isoWhiskerLeft (derivedHom.{u, 0} f)
      (mapDerivedCategoryIdIso (B := C)) ≪≫
    Functor.rightUnitor (derivedHom.{u, 0} f)

private noncomputable def derivedHomCompIsoAux
    {B C D : Type u} [CommRing B] [CommRing C] [CommRing D]
    (f : B →+* C) (g : C →+* D) :
    derivedHom.{u, v} f ⋙ derivedHom.{u, v} g ≅
      derivedHom.{u, v} (g.comp f) := by
  let rF := ModuleCat.restrictScalars.{max v u} f
  let rG := ModuleCat.restrictScalars.{max v u} g
  let rComp := ModuleCat.restrictScalars.{max v u} (g.comp f)
  let F := derivedHom.{u, v} f
  let G := derivedHom.{u, v} g
  let H := derivedHom.{u, v} (g.comp f)
  let adjF := Classical.choice (restrictScalarsDerived_adj_derivedHom.{u, v} f)
  let adjG := Classical.choice (restrictScalarsDerived_adj_derivedHom.{u, v} g)
  let adjH := Classical.choice
    (restrictScalarsDerived_adj_derivedHom.{u, v} (g.comp f))
  let eR : rComp.mapDerivedCategory ≅ rG.mapDerivedCategory ⋙ rF.mapDerivedCategory :=
    mapDerivedCategoryNatIso rComp (rG ⋙ rF)
      (ModuleCat.restrictScalarsComp f g) ≪≫ mapDerivedCategoryComp rG rF
  exact (adjH.rightAdjointUniq ((adjG.comp adjF).ofNatIsoLeft eR.symm)).symm

private noncomputable def polynomialEval_derivedExtension
    {B : Type u} [CommRing B] (b : B) :
    DerivedCategory (ModuleCat.{u} (Polynomial B)) ⥤
      DerivedCategory (ModuleCat.{u} B) :=
  (polynomialEval_derivedData b).choose

private noncomputable def polynomialEval_derivedHomIso
    (hBZH : PolynomialEvalDuality.{u}) {B : Type u} [CommRing B] (b : B) :
    derivedHom.{u, u} (Polynomial.evalRingHom b) ≅
      polynomialEval_derivedExtension b ⋙
        shiftFunctor (DerivedCategory (ModuleCat.{u} B)) (-1 : ℤ) :=
  (hBZH B b (polynomialEval_derivedData b).choose
    (polynomialEval_derivedData b).choose_spec.choose
    (polynomialEval_derivedData b).choose_spec.choose_spec).some

private noncomputable def liftPolynomialPresentation
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A)
    (p : PolynomialPresentation f) :
    let eR : ULift.{max v u} R ≃+* R := ULift.ringEquiv
    let eA : ULift.{max v u} A ≃+* A := ULift.ringEquiv
    let f' := eA.symm.toRingHom.comp (f.comp eR.toRingHom)
    PolynomialPresentation f' := by
  let eR : ULift.{max v u} R ≃+* R := ULift.ringEquiv
  let eA : ULift.{max v u} A ≃+* A := ULift.ringEquiv
  let eP : MvPolynomial (Fin p.variableCount) (ULift.{max v u} R) ≃+*
      MvPolynomial (Fin p.variableCount) R :=
    MvPolynomial.mapEquiv (Fin p.variableCount) eR
  let f' := eA.symm.toRingHom.comp (f.comp eR.toRingHom)
  let g' := eA.symm.toRingHom.comp (p.toRingHom.comp eP.toRingHom)
  refine ⟨p.variableCount, g', ?_, ?_⟩
  · refine RingHom.ext fun r => ?_
    change ULift.up (p.toRingHom (eP (MvPolynomial.C r))) =
      ULift.up (f (eR r))
    congr 1
    change p.toRingHom (MvPolynomial.map eR (MvPolynomial.C r)) = f (eR r)
    rw [MvPolynomial.map_C]
    have hc : p.toRingHom (MvPolynomial.C (eR r)) = f (eR r) := by
      simpa [RingHom.comp_apply] using
        congrArg (fun h : R →+* A => h (eR r)) p.commutes
    simpa using hc
  · exact eA.symm.surjective.comp (p.surjective.comp eP.surjective)

private noncomputable def upperShriekFunctor_iso_liftPresentation
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A)
    (p : PolynomialPresentation f) :
    let eR : ULift.{max v u} R ≃+* R := ULift.ringEquiv
    let eA : ULift.{max v u} A ≃+* A := ULift.ringEquiv
    let p' := liftPolynomialPresentation f p
    let ER := mapDerivedCategoryEquivalenceOfEquivalence
      (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u} eR)
    let EA := mapDerivedCategoryEquivalenceOfEquivalence
      (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u} eA)
    ER.functor ⋙ p'.upperShriekFunctor.{max v u, 0} ≅
      p.upperShriekFunctor.{u, v} ⋙ EA.functor := by
  let eR : ULift.{max v u} R ≃+* R := ULift.ringEquiv
  let eA : ULift.{max v u} A ≃+* A := ULift.ringEquiv
  let p' := liftPolynomialPresentation f p
  let P := MvPolynomial (Fin p.variableCount) R
  let P' := MvPolynomial (Fin p.variableCount) (ULift.{max v u} R)
  let eP : P' ≃+* P := MvPolynomial.mapEquiv (Fin p.variableCount) eR
  let c : R →+* P := MvPolynomial.C
  let c' : ULift.{max v u} R →+* P' := MvPolynomial.C
  let ER := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u} eR)
  let EP := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u} eP)
  let eAMod :=
    ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u} eA
  let EA := mapDerivedCategoryEquivalenceOfEquivalence eAMod
  let F₀ := ModuleCat.extendScalars.{u, u, max v u} c
  let G₀ := ModuleCat.extendScalars.{max v u, max v u, max v u} c'
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{v, u} c
    (RingHom.flat_algebraMap_iff.mpr inferInstance)
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{max v u, max v u} c'
    (RingHom.flat_algebraMap_iff.mpr inferInstance)
  let alpha := F₀.mapDerivedCategoryFactors.hom
  let beta := G₀.mapDerivedCategoryFactors.hom
  haveI hAlpha : F₀.mapDerivedCategory.IsLeftDerivedFunctor alpha
      (HomologicalComplex.quasiIso (ModuleCat.{max v u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived F₀
  have hBeta : G₀.mapDerivedCategory.IsLeftDerivedFunctor beta
      (HomologicalComplex.quasiIso (ModuleCat.{max v u} (ULift.{max v u} R))
        (ComplexShape.up ℤ)) := mapDerivedCategory_isLeftDerived G₀
  have hcoeff : eP.symm.toRingHom.comp (c.comp eR.toRingHom) = c' := by
    refine RingHom.ext fun r => ?_
    change (MvPolynomial.mapEquiv (Fin p.variableCount) eR).symm
      (MvPolynomial.C (eR r)) = MvPolynomial.C r
    rw [MvPolynomial.mapEquiv_symm, MvPolynomial.mapEquiv_apply, MvPolynomial.map_C]
    exact congrArg MvPolynomial.C (eR.symm_apply_apply r)
  let beta' := derivedComparisonOfEq hcoeff G₀.mapDerivedCategory beta
  haveI := isLeftDerivedFunctor_derivedComparisonOfEq hcoeff G₀.mapDerivedCategory beta
  let hExt := derivedExtensionRingEquivIso eR eP c
    F₀.mapDerivedCategory alpha G₀.mapDerivedCategory beta'
  let hHom := derivedHomRingEquivIso eP eA p.toRingHom
  have hHom' : EP.functor ⋙ derivedHom.{max v u, 0} p'.toRingHom ≅
      derivedHom.{u, v} p.toRingHom ⋙ EA.functor := by
    have hp' : p'.toRingHom =
        eA.symm.toRingHom.comp (p.toRingHom.comp eP.toRingHom) := rfl
    simpa [hp'] using hHom
  let shiftNew := shiftFunctor
    (DerivedCategory (ModuleCat.{max v u} (ULift.{max v u} A)))
    (p.variableCount : ℤ)
  let shiftOld := shiftFunctor (DerivedCategory (ModuleCat.{max v u} A))
    (p.variableCount : ℤ)
  let h₁ : (ER.functor ⋙ G₀.mapDerivedCategory) ⋙
        derivedHom.{max v u, 0} p'.toRingHom ≅
      (p.derivedExtension ⋙ derivedHom.{u, v} p.toRingHom) ⋙ EA.functor :=
    Functor.isoWhiskerRight hExt (derivedHom.{max v u, 0} p'.toRingHom) ≪≫
      Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft p.derivedExtension hHom' ≪≫
      (Functor.associator _ _ _).symm
  haveI : EA.functor.CommShift ℤ := by
    change eAMod.functor.mapDerivedCategory.CommShift ℤ
    infer_instance
  let hShift := EA.functor.commShiftIso (p.variableCount : ℤ)
  change ER.functor ⋙ (G₀.mapDerivedCategory ⋙
      derivedHom.{max v u, 0} p'.toRingHom ⋙ shiftNew) ≅
    (p.derivedExtension ⋙ derivedHom.{u, v} p.toRingHom ⋙ shiftOld) ⋙ EA.functor
  exact (Functor.associator ER.functor G₀.mapDerivedCategory
      (derivedHom.{max v u, 0} p'.toRingHom ⋙ shiftNew)).symm ≪≫
    (Functor.associator (ER.functor ⋙ G₀.mapDerivedCategory)
      (derivedHom.{max v u, 0} p'.toRingHom) shiftNew).symm ≪≫
    Functor.isoWhiskerRight h₁ shiftNew ≪≫
    Functor.associator
      (p.derivedExtension ⋙ derivedHom.{u, v} p.toRingHom)
      EA.functor shiftNew ≪≫
    Functor.isoWhiskerLeft
      (p.derivedExtension ⋙ derivedHom.{u, v} p.toRingHom) hShift.symm ≪≫
    (Functor.associator
      (p.derivedExtension ⋙ derivedHom.{u, v} p.toRingHom)
      shiftOld EA.functor).symm

private noncomputable def appendPolynomialPresentation
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A)
    (p : PolynomialPresentation f)
    (g : MvPolynomial (Fin p.variableCount) R) : PolynomialPresentation f := by
  let π : MvPolynomial (Fin (p.variableCount + 1)) R →+*
      MvPolynomial (Fin p.variableCount) R :=
    (Polynomial.evalRingHom g).comp (MvPolynomial.finSuccEquiv R p.variableCount).toRingHom
  have hπC : π.comp MvPolynomial.C = MvPolynomial.C := by
    refine RingHom.ext fun r => ?_
    change Polynomial.eval g
      ((MvPolynomial.finSuccEquiv R p.variableCount) (MvPolynomial.C r)) =
      MvPolynomial.C r
    have hC : (MvPolynomial.finSuccEquiv R p.variableCount) (MvPolynomial.C r) =
        Polynomial.C (MvPolynomial.C r) := by
      simpa using (MvPolynomial.finSuccEquiv R p.variableCount).commutes r
    rw [hC, Polynomial.eval_C]
  have hπsurj : Function.Surjective π := by
    apply (show Function.Surjective (Polynomial.evalRingHom g) from ?_).comp
      (MvPolynomial.finSuccEquiv R p.variableCount).surjective
    intro x
    exact ⟨Polynomial.C x, by simp⟩
  refine ⟨p.variableCount + 1, p.toRingHom.comp π, ?_, p.surjective.comp hπsurj⟩
  rw [RingHom.comp_assoc, hπC, p.commutes]

private noncomputable def appendPolynomialPresentations
    {R A : Type u} [CommRing R] [CommRing A] {f : R →+* A}
    (p : PolynomialPresentation f) :
    (m : ℕ) → (Fin m → A) → PolynomialPresentation f
  | 0, _ => p
  | m + 1, g =>
      let p' := appendPolynomialPresentations p m (fun i => g i.succ)
      appendPolynomialPresentation f p' (Classical.choose (p'.surjective (g 0)))

private theorem appendPolynomialPresentations_count
    {R A : Type u} [CommRing R] [CommRing A] {f : R →+* A}
    (p : PolynomialPresentation f) :
    ∀ (m : ℕ) (g : Fin m → A),
      (appendPolynomialPresentations p m g).variableCount = p.variableCount + m
  | 0, _ => rfl
  | m + 1, g => by
      simp only [appendPolynomialPresentations, appendPolynomialPresentation]
      rw [appendPolynomialPresentations_count p m (fun i => g i.succ)]
      omega

private def appendVariableIndex (n m : ℕ) (i : Fin m) : Fin (n + m) :=
  ⟨i.val, by omega⟩

private def baseVariableIndex (n m : ℕ) (i : Fin n) : Fin (n + m) :=
  ⟨m + i.val, by omega⟩

private theorem appendPolynomialPresentations_X
    {R A : Type u} [CommRing R] [CommRing A] {f : R →+* A}
    (p : PolynomialPresentation f) :
    ∀ (m : ℕ) (g : Fin m → A),
      (∀ i : Fin m,
        (appendPolynomialPresentations p m g).toRingHom
          (MvPolynomial.X (Fin.cast (appendPolynomialPresentations_count p m g).symm
            (appendVariableIndex p.variableCount m i))) = g i) ∧
      (∀ i : Fin p.variableCount,
        (appendPolynomialPresentations p m g).toRingHom
          (MvPolynomial.X (Fin.cast (appendPolynomialPresentations_count p m g).symm
            (baseVariableIndex p.variableCount m i))) =
            p.toRingHom (MvPolynomial.X i))
  | 0, g => by
      refine ⟨fun i => i.elim0, fun i => ?_⟩
      simp [appendPolynomialPresentations, baseVariableIndex]
      rfl
  | m + 1, g => by
      let p' := appendPolynomialPresentations p m (fun i => g i.succ)
      let x := Classical.choose (p'.surjective (g 0))
      have hcount : p.variableCount + (m + 1) =
          (appendPolynomialPresentation f p' x).variableCount :=
        (appendPolynomialPresentations_count p (m + 1) g).symm
      obtain ⟨hnew, hold⟩ := appendPolynomialPresentations_X p m (fun i => g i.succ)
      have hsucc : ∀ k : Fin p'.variableCount,
          (appendPolynomialPresentation f p' x).toRingHom (MvPolynomial.X (Fin.succ k)) =
            p'.toRingHom (MvPolynomial.X k) := fun k => by
        change p'.toRingHom (Polynomial.eval x
          ((MvPolynomial.finSuccEquiv R p'.variableCount) (MvPolynomial.X (Fin.succ k)))) = _
        rw [MvPolynomial.finSuccEquiv_X_succ, Polynomial.eval_C]
      refine ⟨fun i => ?_, fun i => ?_⟩
      · refine Fin.cases ?_ (fun j => ?_) i
        · have hstep : (appendPolynomialPresentation f p' x).variableCount =
              p'.variableCount + 1 := rfl
          have hzero : Fin.cast hcount
              (appendVariableIndex p.variableCount (m + 1) (0 : Fin (m + 1))) =
                Fin.cast hstep.symm (0 : Fin (p'.variableCount + 1)) := by
            apply Fin.ext
            simp [appendVariableIndex]
          change (appendPolynomialPresentation f p' x).toRingHom
            (MvPolynomial.X (Fin.cast hcount
              (appendVariableIndex p.variableCount (m + 1) (0 : Fin (m + 1))))) = g 0
          rw [hzero]
          change p'.toRingHom (Polynomial.eval x
            ((MvPolynomial.finSuccEquiv R p'.variableCount)
              (MvPolynomial.X (0 : Fin (p'.variableCount + 1))))) = g 0
          rw [MvPolynomial.finSuccEquiv_X_zero, Polynomial.eval_X]
          exact Classical.choose_spec (p'.surjective (g 0))
        · let oldIdx := Fin.cast (appendPolynomialPresentations_count p m
            (fun i => g i.succ)).symm (appendVariableIndex p.variableCount m j)
          have hcast : Fin.cast (appendPolynomialPresentations_count p (m + 1) g).symm
              (appendVariableIndex p.variableCount (m + 1) j.succ) = Fin.succ oldIdx := by
            apply Fin.ext
            simp [oldIdx, appendVariableIndex]
          rw [hcast]
          exact (hsucc oldIdx).trans (by simpa [p'] using hnew j)
      · let oldIdx := Fin.cast (appendPolynomialPresentations_count p m
          (fun i => g i.succ)).symm (baseVariableIndex p.variableCount m i)
        have hcast : Fin.cast (appendPolynomialPresentations_count p (m + 1) g).symm
            (baseVariableIndex p.variableCount (m + 1) i) = Fin.succ oldIdx := by
          apply Fin.ext
          simp [oldIdx, baseVariableIndex]
          omega
        rw [hcast]
        exact (hsucc oldIdx).trans (by simpa [p'] using hold i)

private noncomputable def reindexPolynomialPresentation
    {f : R →+* A}
    (p : PolynomialPresentation f)
    (e : MvPolynomial (Fin p.variableCount) R ≃+*
      MvPolynomial (Fin p.variableCount) R)
    (hc : e.toRingHom.comp MvPolynomial.C = MvPolynomial.C) :
    PolynomialPresentation f := by
  refine ⟨p.variableCount, p.toRingHom.comp e.toRingHom, ?_, p.surjective.comp e.surjective⟩
  rw [RingHom.comp_assoc, hc, p.commutes]

private noncomputable def upperShriekFunctor_iso_reindex
    {f : R →+* A}
    (p : PolynomialPresentation f)
    (e : MvPolynomial (Fin p.variableCount) R ≃+*
      MvPolynomial (Fin p.variableCount) R)
    (hc : e.toRingHom.comp MvPolynomial.C = MvPolynomial.C)
    (hcs : e.symm.toRingHom.comp MvPolynomial.C = MvPolynomial.C) :
    PolynomialPresentation.upperShriekFunctor.{u, 0}
      (reindexPolynomialPresentation p e hc) ≅
      p.upperShriekFunctor.{u, 0} := by
  let P := MvPolynomial (Fin p.variableCount) R
  let c : R →+* P := MvPolynomial.C
  let q := reindexPolynomialPresentation p e hc
  let E := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{u, u, u} e)
  let F₀ := ModuleCat.extendScalars.{u, u, u} c
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} c
    (RingHom.flat_algebraMap_iff.mpr inferInstance)
  let alpha := F₀.mapDerivedCategoryFactors.hom
  haveI hAlpha : F₀.mapDerivedCategory.IsLeftDerivedFunctor alpha
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived F₀
  have hcoeff : e.symm.toRingHom.comp (c.comp (RingEquiv.refl R).toRingHom) = c :=
    RingHom.ext fun r => congrArg (fun h : R →+* P => h r) hcs
  let hBeta := derivedComparisonOfEq hcoeff F₀.mapDerivedCategory alpha
  haveI := isLeftDerivedFunctor_derivedComparisonOfEq hcoeff F₀.mapDerivedCategory alpha
  have hExt : F₀.mapDerivedCategory ≅ F₀.mapDerivedCategory ⋙ E.functor :=
    derivedExtensionRingEquivIsoRight.{u}
      e c F₀.mapDerivedCategory alpha F₀.mapDerivedCategory hBeta
  let hHom := derivedHom_ringEquivIso_right.{u} e p.toRingHom
  have hHom' : E.functor ⋙ derivedHom.{u, 0} q.toRingHom ≅
      derivedHom.{u, 0} p.toRingHom := by
    have hm : q.toRingHom = p.toRingHom.comp e.toRingHom := rfl
    simpa [q, reindexPolynomialPresentation, hm] using hHom
  let h₀ : F₀.mapDerivedCategory ⋙ derivedHom.{u, 0} q.toRingHom ≅
      F₀.mapDerivedCategory ⋙ derivedHom.{u, 0} p.toRingHom :=
    Functor.isoWhiskerRight hExt (derivedHom.{u, 0} q.toRingHom) ≪≫
      Functor.associator F₀.mapDerivedCategory E.functor
        (derivedHom.{u, 0} q.toRingHom) ≪≫
      Functor.isoWhiskerLeft F₀.mapDerivedCategory hHom'
  change (p.derivedExtension ⋙ derivedHom.{u, 0} q.toRingHom ⋙
      shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ)) ≅
    (p.derivedExtension ⋙ derivedHom.{u, 0} p.toRingHom ⋙
      shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ))
  exact Functor.isoWhiskerRight h₀
    (shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ))

private noncomputable def upperShriekFunctorIsoOfRingEquiv
    {R A : Type u} [CommRing R] [CommRing A] {f : R →+* A}
    (p q : PolynomialPresentation f)
    (e : MvPolynomial (Fin q.variableCount) R ≃+*
      MvPolynomial (Fin p.variableCount) R)
    (hBase : e.symm.toRingHom.comp MvPolynomial.C = MvPolynomial.C)
    (hMap : p.toRingHom.comp e.toRingHom = q.toRingHom)
    (hCount : q.variableCount = p.variableCount) :
    q.upperShriekFunctor.{u, 0} ≅ p.upperShriekFunctor.{u, 0} := by
  let P := MvPolynomial (Fin p.variableCount) R
  let Q := MvPolynomial (Fin q.variableCount) R
  let cP : R →+* P := MvPolynomial.C
  let cQ : R →+* Q := MvPolynomial.C
  let EMod := ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{u, u, u} e
  let E := mapDerivedCategoryEquivalenceOfEquivalence EMod
  let F₀ := ModuleCat.extendScalars.{u, u, u} cP
  let G₀ := ModuleCat.extendScalars.{u, u, u} cQ
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} cP
    (RingHom.flat_algebraMap_iff.mpr inferInstance)
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} cQ
    (RingHom.flat_algebraMap_iff.mpr inferInstance)
  let alpha := F₀.mapDerivedCategoryFactors.hom
  let beta := G₀.mapDerivedCategoryFactors.hom
  haveI hAlpha : F₀.mapDerivedCategory.IsLeftDerivedFunctor alpha
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived F₀
  have hBeta : G₀.mapDerivedCategory.IsLeftDerivedFunctor beta
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived G₀
  let c' := e.symm.toRingHom.comp (cP.comp (RingEquiv.refl R).toRingHom)
  have hBase' : c' = cQ := hBase
  let beta' := derivedComparisonOfEq hBase' G₀.mapDerivedCategory beta
  haveI := isLeftDerivedFunctor_derivedComparisonOfEq hBase' G₀.mapDerivedCategory beta
  have hExt := derivedExtensionRingEquivIsoRight.{u}
    e cP F₀.mapDerivedCategory alpha G₀.mapDerivedCategory beta'
  have hHom' : E.functor ⋙ derivedHom.{u, 0} q.toRingHom ≅
      derivedHom.{u, 0} p.toRingHom := by
    rw [← hMap]
    exact derivedHom_ringEquivIso_right.{u} e p.toRingHom
  let h₀ : q.derivedExtension ⋙ derivedHom.{u, 0} q.toRingHom ≅
      p.derivedExtension ⋙ derivedHom.{u, 0} p.toRingHom :=
    Functor.isoWhiskerRight hExt (derivedHom.{u, 0} q.toRingHom) ≪≫
      Functor.associator p.derivedExtension E.functor
        (derivedHom.{u, 0} q.toRingHom) ≪≫
      Functor.isoWhiskerLeft p.derivedExtension hHom'
  let sA := shiftFunctor (DerivedCategory (ModuleCat.{u} A))
    (q.variableCount : ℤ)
  let sB := shiftFunctor (DerivedCategory (ModuleCat.{u} A))
    (p.variableCount : ℤ)
  have hShift : sA = sB := congrArg
    (fun n : ℕ => shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (n : ℤ)) hCount
  change (q.derivedExtension ⋙ derivedHom.{u, 0} q.toRingHom ⋙ sA) ≅
    (p.derivedExtension ⋙ derivedHom.{u, 0} p.toRingHom ⋙ sB)
  exact Functor.isoWhiskerRight h₀ sA ≪≫
    Functor.isoWhiskerLeft _ (eqToIso hShift)

private noncomputable def upperShriekFunctor_iso_append
    (hBZH : PolynomialEvalDuality.{u}) {f : R →+* A} (p : PolynomialPresentation f)
    (g : MvPolynomial (Fin p.variableCount) R) :
    PolynomialPresentation.upperShriekFunctor.{u, 0}
      (appendPolynomialPresentation f p g) ≅ p.upperShriekFunctor.{u, 0} := by
  let n := p.variableCount
  let P := MvPolynomial (Fin n) R
  let Q := MvPolynomial (Fin (n + 1)) R
  let T := Polynomial P
  let eAlg : Q ≃ₐ[R] T := MvPolynomial.finSuccEquiv R n
  let e := eAlg.toRingEquiv
  let cQ : R →+* Q := MvPolynomial.C
  let cP : R →+* P := MvPolynomial.C
  let cT : R →+* T := e.toRingHom.comp cQ
  let ev : T →+* P := Polynomial.evalRingHom g
  let π := ev.comp e.toRingHom
  let q := appendPolynomialPresentation f p g
  have hcoeff : e.symm.toRingHom.comp (cT.comp (RingEquiv.refl R).toRingHom) = cQ :=
    RingHom.ext fun r => by simp [cT, RingHom.comp_apply]
  have hcomp : ev.comp cT = cP := by
    refine RingHom.ext fun r => ?_
    change Polynomial.eval g (eAlg (algebraMap R Q r)) = algebraMap R P r
    rw [eAlg.commutes r]
    change Polynomial.eval g (Polynomial.C (MvPolynomial.C r)) = MvPolynomial.C r
    exact Polynomial.eval_C
  have hflatQ : cQ.Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  have hflatE : e.toRingHom.Flat := RingHom.Flat.of_bijective e.bijective
  have hflatT : cT.Flat := hflatQ.comp hflatE
  have hflatP : cP.Flat := RingHom.flat_algebraMap_iff.mpr inferInstance
  let F₀ := ModuleCat.extendScalars.{u, u, u} cT
  let G₀ := ModuleCat.extendScalars.{u, u, u} cQ
  let compMap := ev.comp cT
  let H₀ := ModuleCat.extendScalars.{u, u, u} compMap
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} cT hflatT
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} cQ hflatQ
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} compMap
    (show (ev.comp cT).Flat from hcomp ▸ hflatP)
  let Eₚ := ModuleCat.extendScalars.{u, u, u} cP
  obtain ⟨_, _, _⟩ := extendScalars_exact_of_flat.{u, u} cP hflatP
  let alphaF := F₀.mapDerivedCategoryFactors.hom
  let alphaG := G₀.mapDerivedCategoryFactors.hom
  let gamma := H₀.mapDerivedCategoryFactors.hom
  haveI : F₀.mapDerivedCategory.IsLeftDerivedFunctor alphaF
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived F₀
  have hAlphaG : G₀.mapDerivedCategory.IsLeftDerivedFunctor alphaG
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived G₀
  haveI : H₀.mapDerivedCategory.IsLeftDerivedFunctor gamma
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) :=
    mapDerivedCategory_isLeftDerived H₀
  let c' := e.symm.toRingHom.comp (cT.comp (RingEquiv.refl R).toRingHom)
  let betaG := derivedComparisonOfEq hcoeff G₀.mapDerivedCategory alphaG
  haveI := isLeftDerivedFunctor_derivedComparisonOfEq hcoeff G₀.mapDerivedCategory alphaG
  let E := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{u, u, u} e)
  let hChange := derivedExtensionRingEquivIsoRight.{u}
    e cT F₀.mapDerivedCategory alphaF G₀.mapDerivedCategory betaG
  let hHomEval := derivedHom_ringEquivIso_right.{u} e ev
  let evalData := polynomialEval_derivedData (B := P) g
  let evalExt := evalData.choose
  let evalAlpha := evalData.choose_spec.choose
  haveI : evalExt.IsLeftDerivedFunctor evalAlpha
      (HomotopyCategory.quasiIso (ModuleCat.{u} T) (.up ℤ)) := evalData.choose_spec.choose_spec
  let evalAlphaQ := homotopyCategoryDerivedComparison
    (ModuleCat.extendScalars.{u, u, u} ev) evalExt evalAlpha
  haveI : evalExt.IsLeftDerivedFunctor evalAlphaQ
      (HomologicalComplex.quasiIso (ModuleCat.{u} T) (.up ℤ)) :=
    leftDerivedFunctor_of_homotopyCategory
      (ModuleCat.extendScalars.{u, u, u} ev) evalExt evalAlpha
  let hEval := polynomialEval_derivedHomIso hBZH (B := P) g
  let hDerivedExtComp := derivedExtensionCompIso cT ev F₀.mapDerivedCategory alphaF
    evalExt evalAlphaQ H₀.mapDerivedCategory gamma
  let eComp : H₀ ≅ ModuleCat.extendScalars.{u, u, u} cP :=
    eqToIso (congrArg (ModuleCat.extendScalars.{u, u, u}) hcomp)
  let hComp := mapDerivedCategoryNatIso H₀
    (ModuleCat.extendScalars.{u, u, u} cP) eComp
  let hLow : G₀.mapDerivedCategory ⋙ derivedHom.{u, 0} π ≅
      (ModuleCat.extendScalars.{u, u, u} cP).mapDerivedCategory ⋙
        shiftFunctor (DerivedCategory (ModuleCat.{u} P)) (-1 : ℤ) :=
    Functor.isoWhiskerRight hChange (derivedHom.{u, 0} π) ≪≫
      Functor.associator F₀.mapDerivedCategory E.functor
        (derivedHom.{u, 0} π) ≪≫
      Functor.isoWhiskerLeft F₀.mapDerivedCategory hHomEval ≪≫
      Functor.isoWhiskerLeft F₀.mapDerivedCategory hEval ≪≫
      (Functor.associator F₀.mapDerivedCategory evalExt
        (shiftFunctor (DerivedCategory (ModuleCat.{u} P)) (-1 : ℤ))).symm ≪≫
      Functor.isoWhiskerRight hDerivedExtComp (shiftFunctor
        (DerivedCategory (ModuleCat.{u} P)) (-1 : ℤ)) ≪≫
      Functor.isoWhiskerRight hComp (shiftFunctor
        (DerivedCategory (ModuleCat.{u} P)) (-1 : ℤ))
  let hHomComp := derivedHomCompIsoAux π p.toRingHom
  let shiftA := shiftFunctor (DerivedCategory (ModuleCat.{u} A))
    ((p.variableCount + 1 : ℕ) : ℤ)
  let shiftNeg := shiftFunctor (DerivedCategory (ModuleCat.{u} P)) (-1 : ℤ)
  let dhp := derivedHom.{u, 0} p.toRingHom
  let h₀ : G₀.mapDerivedCategory ⋙
      derivedHom.{u, 0} q.toRingHom ⋙ shiftA ≅
      p.derivedExtension ⋙ dhp ⋙
        shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ) := by
    let h₁ : G₀.mapDerivedCategory ⋙ derivedHom.{u, 0} q.toRingHom ≅
        (G₀.mapDerivedCategory ⋙ derivedHom.{u, 0} π) ⋙ dhp := by
      have hq : q.toRingHom = p.toRingHom.comp π := by
        dsimp [q, appendPolynomialPresentation, π, ev, e]
      rw [hq]
      exact Functor.isoWhiskerLeft G₀.mapDerivedCategory hHomComp.symm ≪≫
        (Functor.associator G₀.mapDerivedCategory
          (derivedHom.{u, 0} π) dhp).symm
    let ep := Eₚ.mapDerivedCategory
    let shiftNegA := shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (-1 : ℤ)
    let h₂ : G₀.mapDerivedCategory ⋙
        derivedHom.{u, 0} q.toRingHom ⋙ shiftA ≅
        (ep ⋙ dhp) ⋙ shiftFunctor (DerivedCategory (ModuleCat.{u} A))
          (p.variableCount : ℤ) :=
      Functor.isoWhiskerRight h₁ shiftA ≪≫
        Functor.isoWhiskerRight (Functor.isoWhiskerRight hLow dhp) shiftA ≪≫
        Functor.isoWhiskerRight (Functor.associator ep shiftNeg dhp) shiftA ≪≫
        Functor.associator ep (shiftNeg ⋙ dhp) shiftA ≪≫
        Functor.isoWhiskerLeft ep
          (Functor.isoWhiskerRight
            ((derivedHomCommShift.{u, 0, u} p.toRingHom).commShiftIso (-1 : ℤ)) shiftA) ≪≫
        Functor.isoWhiskerLeft ep
          (Functor.associator dhp shiftNegA shiftA) ≪≫
        (Functor.associator ep dhp (shiftNegA ⋙ shiftA)).symm ≪≫
        Functor.isoWhiskerLeft (ep ⋙ dhp)
          ((shiftFunctorAdd' (DerivedCategory (ModuleCat.{u} A)) (-1 : ℤ)
            ((p.variableCount + 1 : ℕ) : ℤ) (p.variableCount : ℤ) (by omega)).symm)
    exact h₂
  change q.derivedExtension ⋙ derivedHom.{u, 0} q.toRingHom ⋙
      shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (q.variableCount : ℤ) ≅
    p.derivedExtension ⋙ derivedHom.{u, 0} p.toRingHom ⋙
      shiftFunctor (DerivedCategory (ModuleCat.{u} A)) (p.variableCount : ℤ)
  exact h₀

private noncomputable def upperShriekFunctor_iso_appendMany
    {R A : Type u} [CommRing R] [CommRing A] (hBZH : PolynomialEvalDuality.{u})
    {f : R →+* A} (p : PolynomialPresentation f) :
    (m : ℕ) → (g : Fin m → A) →
      (appendPolynomialPresentations p m g).upperShriekFunctor.{u, 0} ≅
        p.upperShriekFunctor.{u, 0}
  | 0, _ => Iso.refl _
  | m + 1, g => by
      let p' := appendPolynomialPresentations p m (fun i => g i.succ)
      let x := Classical.choose (p'.surjective (g 0))
      exact upperShriekFunctor_iso_append hBZH p' x ≪≫
        upperShriekFunctor_iso_appendMany hBZH p m (fun i => g i.succ)

private def finBlockSwap (n m : ℕ) : Fin (n + m) ≃ Fin (m + n) where
  toFun i := if h : i.val < n then ⟨m + i.val, by omega⟩ else ⟨i.val - n, by omega⟩
  invFun i := if h : i.val < m then ⟨n + i.val, by omega⟩ else ⟨i.val - m, by omega⟩
  left_inv i := by grind
  right_inv i := by grind

private noncomputable def isoOfWhiskerEquivalence
    {C D E : Type*} [Category C] [Category D] [Category E]
    (F G : C ⥤ D) (e : D ≌ E) (h : F ⋙ e.functor ≅ G ⋙ e.functor) : F ≅ G :=
  (Functor.rightUnitor F).symm ≪≫
    Functor.isoWhiskerLeft F e.unitIso ≪≫
    (Functor.associator F e.functor e.inverse).symm ≪≫
    Functor.isoWhiskerRight h e.inverse ≪≫
    Functor.associator G e.functor e.inverse ≪≫
    Functor.isoWhiskerLeft G e.unitIso.symm ≪≫
    Functor.rightUnitor G

private noncomputable def upperShriekFunctor_iso_sameUniverse
    {R A : Type u} [CommRing R] [CommRing A] (hBZH : PolynomialEvalDuality.{u})
    {f : R →+* A} (p q : PolynomialPresentation f) :
    p.upperShriekFunctor.{u, 0} ≅ q.upperShriekFunctor.{u, 0} := by
  let n := p.variableCount
  let m := q.variableCount
  let pOnQ : Fin m → A := fun i => q.toRingHom (MvPolynomial.X i)
  let qOnP : Fin n → A := fun i => p.toRingHom (MvPolynomial.X i)
  let pr := appendPolynomialPresentations p m pOnQ
  let qr := appendPolynomialPresentations q n qOnP
  have hpr : pr.variableCount = n + m := appendPolynomialPresentations_count p m pOnQ
  have hqr' : qr.variableCount = m + n := appendPolynomialPresentations_count q n qOnP
  have hqr : qr.variableCount = n + m := hqr'.trans (Nat.add_comm m n)
  let eFin : Fin qr.variableCount ≃ Fin pr.variableCount :=
    (finCongr hqr).trans (finBlockSwap n m) |>.trans
      ((finCongr (Nat.add_comm m n)).trans (finCongr hpr.symm))
  let eAlg : MvPolynomial (Fin qr.variableCount) R ≃ₐ[R]
      MvPolynomial (Fin pr.variableCount) R := MvPolynomial.renameEquiv R eFin
  let e := eAlg.toRingEquiv
  have hBase : e.symm.toRingHom.comp MvPolynomial.C = MvPolynomial.C :=
    RingHom.ext fun r => by simp [e, eAlg, MvPolynomial.renameEquiv]
  have hpX := appendPolynomialPresentations_X p m pOnQ
  have hqX := appendPolynomialPresentations_X q n qOnP
  have hMap : pr.toRingHom.comp e.toRingHom = qr.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change pr.toRingHom (eAlg (algebraMap R _ r)) = qr.toRingHom (algebraMap R _ r)
      rw [eAlg.commutes r]
      have hp := congrArg (fun h : R →+* A => h r) pr.commutes
      have hq := congrArg (fun h : R →+* A => h r) qr.commutes
      simpa [RingHom.comp_apply] using hp.trans hq.symm
    · intro i
      change pr.toRingHom (eAlg (MvPolynomial.X i)) = qr.toRingHom (MvPolynomial.X i)
      rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X]
      by_cases hi : i.val < n
      · let j : Fin n := ⟨i.val, hi⟩
        have hsource : i = Fin.cast hqr'.symm (appendVariableIndex m n j) := by
          apply Fin.ext
          simp [j, appendVariableIndex]
        have htarget : eFin i = Fin.cast hpr.symm (baseVariableIndex n m j) := by
          apply Fin.ext
          simp [eFin, finBlockSwap, j, baseVariableIndex, hi]
        rw [htarget, hpX.2 j, hsource, hqX.1 j]
      · let j : Fin m := ⟨i.val - n, by omega⟩
        have hsource : i = Fin.cast hqr'.symm (baseVariableIndex m n j) := by
          apply Fin.ext
          simp [j, baseVariableIndex]
          omega
        have htarget : eFin i = Fin.cast hpr.symm (appendVariableIndex n m j) := by
          apply Fin.ext
          simp [eFin, finBlockSwap, j, appendVariableIndex, hi]
        rw [htarget, hpX.1 j, hsource, hqX.2 j]
  have hCount : qr.variableCount = pr.variableCount := by
    rw [hqr, hpr]
  let hCommon := upperShriekFunctorIsoOfRingEquiv pr qr e hBase hMap hCount
  let hP := upperShriekFunctor_iso_appendMany hBZH p m pOnQ
  let hQ := upperShriekFunctor_iso_appendMany hBZH q n qOnP
  exact hP.symm ≪≫ hCommon.symm ≪≫ hQ

end Independence

open Independence

namespace PolynomialPresentation

variable {R A : Type u} [CommRing R] [CommRing A] {f : R →+* A}

/-- Two polynomial presentations of `f` whose polynomial algebras are identified by a ring
isomorphism over `R` compatible with the two surjections onto `A`, and which use the same
number of variables, give isomorphic upper shriek functors.  This is the part of
[Stacks, Tag 0BZJ] that compares two presentations without changing the number of
variables; it needs no hypothesis beyond the data of the identification, and is stated at module
universe equal to the ring universe, the general module universe being reached only by the
`ULift.ringEquiv` transport that
`Dualizing.PolynomialPresentation.upperShriekFunctor_iso` performs. -/
theorem upperShriekFunctor_iso_of_ringEquiv
    (p q : PolynomialPresentation f)
    (e : MvPolynomial (Fin q.variableCount) R ≃+* MvPolynomial (Fin p.variableCount) R)
    (hBase : e.symm.toRingHom.comp MvPolynomial.C = MvPolynomial.C)
    (hMap : p.toRingHom.comp e.toRingHom = q.toRingHom)
    (hCount : q.variableCount = p.variableCount) :
    Nonempty (q.upperShriekFunctor.{u, 0} ≅ p.upperShriekFunctor.{u, 0}) :=
  ⟨upperShriekFunctorIsoOfRingEquiv p q e hBase hMap hCount⟩

/-- The algebraic upper shriek functors attached to any two polynomial presentations of the same
finite type homomorphism are naturally isomorphic, at an independent module universe, given
`hBZH`.  The hypothesis `hBZH` is
[Stacks, Tag 0BZH] at the evaluation surjections `B[x] ↠ B`, proved as
`Dualizing.polynomialEvalDuality`; supplying it gives
`Dualizing.PolynomialPresentation.nonempty_upperShriekFunctor_iso`. -/
theorem upperShriekFunctor_iso (hBZH : PolynomialEvalDuality.{max v u})
    (f : R →+* A) (p q : PolynomialPresentation f) :
    Nonempty (p.upperShriekFunctor.{u, v} ≅ q.upperShriekFunctor.{u, v}) := by
  let p' := liftPolynomialPresentation f p
  let q' := liftPolynomialPresentation f q
  let eA : ULift.{max v u} A ≃+* A := ULift.ringEquiv
  let ER := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u}
      (ULift.ringEquiv : ULift.{max v u} R ≃+* R))
  let EA := mapDerivedCategoryEquivalenceOfEquivalence
    (ModuleCat.restrictScalarsEquivalenceOfRingEquiv.{max v u, u, max v u} eA)
  let hP := upperShriekFunctor_iso_liftPresentation f p
  let hQ := upperShriekFunctor_iso_liftPresentation f q
  let hLift := upperShriekFunctor_iso_sameUniverse.{max v u} hBZH p' q'
  let hAfter : p.upperShriekFunctor.{u, v} ⋙ EA.functor ≅
      q.upperShriekFunctor.{u, v} ⋙ EA.functor :=
    hP.symm ≪≫ Functor.isoWhiskerLeft ER.functor hLift ≪≫ hQ
  exact ⟨isoOfWhiskerEquivalence p.upperShriekFunctor.{u, v} q.upperShriekFunctor.{u, v}
    EA hAfter⟩

end PolynomialPresentation

end Dualizing

