module

public import Mathlib.RingTheory.Ideal.UFD
public import StacksFrontier.RingTheory.AdicCompletion.PermanenceOfProperties
public import StacksFrontier.RingTheory.CohenMacaulay.Dimension
public import StacksFrontier.RingTheory.CompleteLocalRing.MinimalRegularPresentation
public import StacksFrontier.RingTheory.Dualizing.FlatLocalGorenstein
public import StacksFrontier.RingTheory.Dualizing.GorensteinRegularElement
public import StacksFrontier.RingTheory.RegularLocalRing.UniqueFactorization

/-!
# Local rings of embedding codimension at most one with domain completion are Gorenstein

Let `(R, 𝔪)` be a Noetherian local ring of dimension `d` whose maximal ideal is generated by
`d + 1` elements and whose completion `R^` is a domain. Then `R` is Gorenstein. No coefficient
field is assumed: the statement holds in every characteristic, mixed characteristic included.

The proof passes to the completion and presents it as a hypersurface. Gorensteinness descends
along the flat local map `R → R^`, whose closed fibre is a field (Stacks 0BJL), and completion
keeps the dimension (Stacks 07NV) and does not raise the number of generators of the maximal
ideal, which for `R^` is `𝔪R^`. A complete `R^` is a quotient of a regular local ring `S` of its
own embedding dimension
(`IsLocalRing.exists_isRegularLocalRing_surjective_spanFinrank_maximalIdeal_eq`, built on the
Cohen structure theorem, Stacks 032A), so `dim S ≤ d + 1`. The kernel `P` of
`S → R^` is prime because `R^` is a domain, and the dimension formula `dim S = ht P + dim R^` in
the Cohen–Macaulay ring `S` gives `ht P ≤ 1`. If `P = 0` then `R^ ≅ S` is regular. Otherwise `P`
is a prime of height one in the unique factorization domain `S` (Stacks 0AG0), hence `P = (g)`
with `g ≠ 0`, and `R^ ≅ S/(g)` is Gorenstein because `S` is (Stacks 0AWX) and `g` is a
nonzerodivisor in the maximal ideal (Stacks 0BJJ).

## Main results

* `Dualizing.isGorensteinLocalRing_of_isAdicComplete_of_spanFinrank_maximalIdeal_le_succ`: the
  complete case, for a complete local domain.
* `Dualizing.isGorensteinLocalRing_of_spanFinrank_maximalIdeal_le_succ`: the general case, for a
  Noetherian local ring with domain completion.
* `Dualizing.isGorensteinLocalRing_of_span_range_eq_maximalIdeal`: the same, with the embedding
  dimension given as a family of `d + 1` generators of the maximal ideal.

## Implementation notes

Why this is wanted. At a singular point of the blowup of a rational double point (Stacks 0BGE)
the local ring has dimension two, embedding dimension three and domain completion; this file
shows it is Gorenstein without a dualizing sheaf and without a coefficient field.

The embedding dimension is spelled `(maximalIdeal R).spanFinrank ≤ d + 1`, the form in which
`IsRegularLocalRing` is defined; `spanFinrank_maximalIdeal_eq_finrank_cotangentSpace` translates
it into the dimension of the cotangent space.

## References

* [Stacks Project, Tag 0BJL](https://stacks.math.columbia.edu/tag/0BJL)
* [Stacks Project, Tag 07NV](https://stacks.math.columbia.edu/tag/07NV)
* [Stacks Project, Tag 032A](https://stacks.math.columbia.edu/tag/032A)
* [Stacks Project, Tag 0AG0](https://stacks.math.columbia.edu/tag/0AG0)
* [Stacks Project, Tag 0AWX](https://stacks.math.columbia.edu/tag/0AWX)
* [Stacks Project, Tag 0BJJ](https://stacks.math.columbia.edu/tag/0BJJ)
-/

@[expose] public section

open IsLocalRing

universe u

namespace Dualizing

/-- **A complete local domain of embedding dimension at most one more than its dimension is
Gorenstein**, in every characteristic. It is a quotient of a regular local ring `S` of dimension
at most `d + 1` by a prime `P` of height `dim S - d ≤ 1`; either `P = 0` and the ring is regular,
or `P = (g)` is principal because `S` is factorial, and `S/(g)` is Gorenstein. -/
theorem isGorensteinLocalRing_of_isAdicComplete_of_spanFinrank_maximalIdeal_le_succ
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] [IsDomain R]
    [IsAdicComplete (maximalIdeal R) R] {d : ℕ} (hdim : ringKrullDim R = d)
    (hgen : (maximalIdeal R).spanFinrank ≤ d + 1) :
    IsGorensteinLocalRing R := by
  obtain ⟨S, _, _, φ, hφ, hS⟩ :=
    IsLocalRing.exists_isRegularLocalRing_surjective_spanFinrank_maximalIdeal_eq R
  have : IsDomain S := IsRegularLocalRing.isDomain S
  have : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
  have hSG : IsGorensteinLocalRing S := IsRegularLocalRing.isGorensteinLocalRing S
  by_cases hbot : RingHom.ker φ = ⊥
  · exact isGorensteinLocalRing_of_ringEquiv
      (RingEquiv.ofBijective φ ⟨(RingHom.injective_iff_ker_eq_bot φ).mpr hbot, hφ⟩).symm hSG
  have key := Module.IsMaximalCohenMacaulay.ringKrullDim_eq_height_add_ringKrullDim_quotient
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      S).2 (RingHom.ker φ)
  rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, hS,
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hφ), hdim] at key
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime
    (I := RingHom.ker φ))
  rw [← hm] at key
  have hnat : (maximalIdeal R).spanFinrank = m + d := by exact_mod_cast key
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hbot (Ideal.height_eq_zero_iff_eq_bot.mp (by rw [← hm]; rfl))
  have hheight : (RingHom.ker φ).height = 1 := by
    rw [← hm, show m = 1 by omega]
    rfl
  have : UniqueFactorizationMonoid S := IsRegularLocalRing.uniqueFactorizationMonoid S
  obtain ⟨g, hg⟩ := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hheight
  have hg0 : g ≠ 0 := by
    rintro rfl
    exact hbot (by rw [hg]; exact Submodule.span_singleton_eq_bot.mpr rfl)
  have hgmem : g ∈ maximalIdeal S := by
    refine IsLocalRing.le_maximalIdeal_of_isPrime (RingHom.ker φ) ?_
    rw [hg]
    exact Ideal.mem_span_singleton_self g
  let : Nontrivial (S ⧸ Ideal.span {g}) := Ideal.Quotient.nontrivial_iff.mpr
    (lt_of_le_of_lt (Ideal.span_le.2 (Set.singleton_subset_iff.mpr hgmem))
      (inferInstance : (maximalIdeal S).IsMaximal).lt_top).ne
  let : IsLocalRing (S ⧸ Ideal.span {g}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {g})) Ideal.Quotient.mk_surjective
  exact isGorensteinLocalRing_of_ringEquiv
    ((RingHom.quotientKerEquivOfSurjective hφ).symm.trans (Ideal.quotEquivOfEq hg))
    ((isGorensteinLocalRing_quotient_span_singleton_iff S g hgmem
      (mem_nonZeroDivisors_of_ne_zero hg0)).mp hSG)

/-- **A Noetherian local ring of embedding dimension at most one more than its dimension, with
domain completion, is Gorenstein**, in every characteristic (no coefficient field is assumed).
Gorensteinness descends along the flat local map `R → R^` (Stacks 0BJL); the completion has the
same dimension (Stacks 07NV), maximal ideal `𝔪R^` and so no larger embedding dimension, and is
Gorenstein by `isGorensteinLocalRing_of_isAdicComplete_of_spanFinrank_maximalIdeal_le_succ`.

This is the case needed at a singular point of the blowup of a rational double point, where
`d = 2` and the maximal ideal needs three generators. -/
theorem isGorensteinLocalRing_of_spanFinrank_maximalIdeal_le_succ
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {d : ℕ}
    (hdim : ringKrullDim R = d)
    (hgen : (maximalIdeal R).spanFinrank ≤ d + 1)
    (hdom : IsDomain (AdicCompletion (maximalIdeal R) R)) :
    IsGorensteinLocalRing R := by
  let B := AdicCompletion (maximalIdeal R) R
  have hgenB : (maximalIdeal B).spanFinrank ≤ d + 1 := by
    rw [AdicCompletion.maximalIdeal_eq_map]
    exact (Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian _)).trans hgen
  exact ((isGorensteinLocalRing_iff_of_flat R B).mp
    (isGorensteinLocalRing_of_isAdicComplete_of_spanFinrank_maximalIdeal_le_succ B
      ((ringKrullDim_adicCompletion_maximalIdeal (A := R)).symm.trans hdim) hgenB)).1

/-- **A Noetherian local ring of dimension `d` whose maximal ideal is generated by `d + 1`
elements, with domain completion, is Gorenstein**, in every characteristic. This is
`isGorensteinLocalRing_of_spanFinrank_maximalIdeal_le_succ` with the embedding dimension given by
an explicit generating family. -/
theorem isGorensteinLocalRing_of_span_range_eq_maximalIdeal
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {d : ℕ}
    (hdim : ringKrullDim R = d) (x : Fin (d + 1) → R)
    (hx : Ideal.span (Set.range x) = maximalIdeal R)
    (hdom : IsDomain (AdicCompletion (maximalIdeal R) R)) :
    IsGorensteinLocalRing R := by
  refine isGorensteinLocalRing_of_spanFinrank_maximalIdeal_le_succ R hdim ?_ hdom
  rw [← hx]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range x)).trans ?_
  simpa [← Set.image_univ] using Set.ncard_image_le (f := x) Set.finite_univ

end Dualizing
