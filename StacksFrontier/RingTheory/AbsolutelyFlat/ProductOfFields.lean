module

public import Mathlib.RingTheory.Flat.Tensor

@[expose] public section

/-!
# Absolute flatness of a product of fields

A product of fields is an absolutely flat ring (Stacks Tag 092G, Lemma 15.106.6).

Throughout, all rings are commutative with unit, and "module" means a module over
the ring in question.

## Definitions

- (Flat module) Let `A` be a commutative ring and `M` an `A`-module. `M` is *flat*
  if the functor `- ⊗_A M` is exact; equivalently, for every injective `A`-linear
  map `N' ↪ N` the induced map `N' ⊗_A M → N ⊗_A M` is injective. In Mathlib this
  is the predicate `Module.Flat A M`.

- (Absolutely flat ring) A commutative ring `A` is *absolutely flat* if every
  `A`-module is flat. Equivalently (Stacks Tag 092F with `d = 0`), `A` has weak
  dimension `≤ 0`. Classically this is a *von Neumann regular ring*. We adopt
  "every `A`-module is flat" as the defining property used in the formal statement.

- (Product of fields) For an index set `I` and a family of fields `(K i)_{i ∈ I}`,
  the product ring is `A = ∏ i, K i`, i.e. the Pi-type ring `∀ i, K i` with
  componentwise operations.

## Main statements

- `product_of_fields_absolutely_flat` (Stacks Tag 092G): the product ring
  `A = ∏ i, K i` of a family of fields is absolutely flat, i.e. every `A`-module
  is flat.
- `Ideal.exists_mul_eq_self_of_fg_pi_field`: in a product of fields, every finitely
  generated ideal contains an element acting as the identity on it.
- `Module.Flat.of_forall_fg_ideal_exists_mul_eq_self`: the general criterion deducing
  absolute flatness from that property of finitely generated ideals.

## Implementation notes

- "Flat module" is `Module.Flat A M` in Mathlib.
- "Product of fields" is the Pi-type ring `∀ i, K i` where each `K i` is a `Field`.
- "Absolutely flat" is encoded directly in the statement below as "every module is
  flat", the module being an explicit argument of the theorem.

## Notes

- The index set `I` is arbitrary (empty, finite, or infinite); when `I` is empty
  the product is the zero ring, which is vacuously absolutely flat.

- Proof sketch (Stacks 092G): for `f = (f i) ∈ ∏ i, K i`, the principal ideal `(f)`
  equals the ideal generated by the idempotent `e = (e i)` with `e i = 1` if
  `f i ≠ 0` and `e i = 0` otherwise. Hence every finitely generated ideal is
  generated by an idempotent, so `A` is reduced with every prime maximal, every
  local ring of `A` is a field, and therefore every `A`-module is flat.

- Provided dependencies (to be cited, not re-proven):
  - Stacks 00EC: `PrimeSpectrum.zeroLocus_eq_basicOpen_of_isIdempotentElem`
  - Stacks 00EU: `Ring.KrullDimLE.of_isLocalization`
-/

/-- If a linear map `f` admits a linear retraction `r`, that is `r ∘ₗ f = id`, then
tensoring `f` with any module `M` yields an injective map. This is because split
injections are preserved by any additive functor. -/
private lemma rTensor_injective_of_retraction {R : Type*} [CommSemiring R] {M N P : Type*}
    [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N] [AddCommMonoid P] [Module R P]
    {f : N →ₗ[R] P} (r : P →ₗ[R] N) (hr : r ∘ₗ f = LinearMap.id) :
    Function.Injective (LinearMap.rTensor M f) := by
  have hcomp : LinearMap.rTensor M r ∘ₗ LinearMap.rTensor M f = LinearMap.id := by
    rw [← LinearMap.rTensor_comp, hr, LinearMap.rTensor_id]
  exact Function.LeftInverse.injective fun x => by simpa using LinearMap.congr_fun hcomp x

/-- A commutative ring is absolutely flat as soon as every finitely generated ideal `J`
contains an element acting as the identity on `J`. -/
theorem Module.Flat.of_forall_fg_ideal_exists_mul_eq_self {R : Type*} [CommRing R]
    (h : ∀ J : Ideal R, J.FG → ∃ e ∈ J, ∀ y ∈ J, e * y = y)
    (M : Type*) [AddCommGroup M] [Module R M] : Module.Flat R M := by
  rw [Module.Flat.iff_rTensor_injective]
  intro J hJ
  obtain ⟨e, heJ, hey⟩ := h J hJ
  -- `x ↦ e * x` retracts the inclusion `J ↪ R`, and split injections survive `· ⊗ M`
  exact rTensor_injective_of_retraction (M := M)
    ((LinearMap.mulLeft R e).codRestrict J fun x => J.mul_mem_right x heJ)
    (LinearMap.ext fun y => Subtype.ext (hey y y.2))

/-- If every element of a set `s` of functions vanishes at the coordinate `i`, then so does
every element of the submodule it generates. -/
theorem Pi.apply_eq_zero_of_mem_span {I : Type*} {K : I → Type*} [∀ i, CommSemiring (K i)]
    {s : Set (∀ i, K i)} {i : I} (hs : ∀ x ∈ s, x i = 0) {y : ∀ i, K i}
    (hy : y ∈ Submodule.span (∀ i, K i) s) : y i = 0 := by
  refine Submodule.span_induction (p := fun z _ => z i = 0) hs rfl ?_ ?_ hy
  · intro x z _ _ hx hz
    simp [hx, hz]
  · intro a x _ hx
    simp [hx]

open Classical in
/-- A finite family `x` in a field that is not identically zero writes `1` as a combination of
itself: invert the entry of least index that is nonzero and discard the other entries. -/
private lemma sum_ite_inv_mul_eq_one {F : Type*} [Field F] {n : ℕ} (x : Fin n → F)
    (h : ∃ k, x k ≠ 0) :
    ∑ k, (if (x k ≠ 0 ∧ ∀ j < k, x j = 0) then (x k)⁻¹ else 0) * x k = 1 := by
  -- pick the minimal `k` with `x k ≠ 0`
  obtain ⟨k0, hk0mem, hk0min⟩ :=
    Finset.exists_min_image (Finset.univ.filter (fun k => x k ≠ 0)) Fin.val
      ⟨h.choose, by simp [h.choose_spec]⟩
  have hk0ne : x k0 ≠ 0 := (Finset.mem_filter.mp hk0mem).2
  have hk0minlt : ∀ j < k0, x j = 0 := by
    intro j hj
    by_contra hjne
    exact absurd (hk0min j (by simp [hjne])) (not_le.mpr (by exact_mod_cast hj))
  -- the sum collapses to the single `k0` term, which equals 1
  rw [Finset.sum_eq_single k0]
  · rw [ite_eq_left ⟨hk0ne, hk0minlt⟩, inv_mul_cancel₀ hk0ne]
  · intro b _ hb
    rw [ite_eq_right, zero_mul]
    rintro ⟨hbne, hbmin⟩
    rcases hb.lt_or_gt with hlt | hgt
    · exact hbne (hk0minlt b hlt)
    · exact hk0ne (hbmin k0 hgt)
  · simp

/-- In a product of fields, every finitely generated ideal `J` contains an element acting as
the identity on `J`, namely the idempotent supported on the coordinates where `J` is nonzero. -/
theorem Ideal.exists_mul_eq_self_of_fg_pi_field {I : Type*} {K : I → Type*} [∀ i, Field (K i)]
    {J : Ideal (∀ i, K i)} (hJ : J.FG) : ∃ e ∈ J, ∀ y ∈ J, e * y = y := by
  classical
  -- get a finite generating family for `J`
  obtain ⟨n, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hJ
  -- the idempotent `e` with `e i = 1` iff some generator is nonzero at `i`
  let e : ∀ i, K i := fun i => if (∃ k, s k i ≠ 0) then 1 else 0
  -- explicit coefficients writing `e` as a combination of the generators
  let c : Fin n → ∀ i, K i := fun k i =>
    if (s k i ≠ 0 ∧ ∀ j < k, s j i = 0) then (s k i)⁻¹ else 0
  -- at each coordinate, either some generator is nonzero and `e i = 1`, or all vanish and `e i = 0`
  have hcase : ∀ i, ((∃ k, s k i ≠ 0) ∧ e i = 1) ∨ ((∀ k, s k i = 0) ∧ e i = 0) := fun i => by
    by_cases hi : ∃ k, s k i ≠ 0 <;> simp_all [e]
  have hesum : e = ∑ k, c k * s k := by
    funext i
    simp only [Finset.sum_apply, Pi.mul_apply]
    rcases hcase i with ⟨hi, he⟩ | ⟨hz, he⟩
    · rw [he]
      exact (sum_ite_inv_mul_eq_one (fun k => s k i) hi).symm
    · simp [he, hz]
  refine ⟨e, ?_, fun y hy => funext fun i => ?_⟩
  · rw [hesum]
    refine Submodule.sum_mem _ fun k _ => J.smul_mem (c k) ?_
    rw [← hs]
    exact Submodule.subset_span ⟨k, rfl⟩
  rw [Pi.mul_apply]
  rcases hcase i with ⟨_, he⟩ | ⟨hz, he⟩
  · rw [he, one_mul]
  · -- `y i = 0` since `y ∈ span (range s)` and all `s k i = 0`
    simp [he, Pi.apply_eq_zero_of_mem_span (s := Set.range s) (i := i) (y := y)
      (by simpa using hz) (by rwa [hs])]

/-- **Stacks Tag 092G.** A product of fields is an absolutely flat ring: every module
over `∏ i, K i` is flat. -/
@[stacks 092G]
theorem product_of_fields_absolutely_flat {I : Type*} (K : I → Type*) [∀ i, Field (K i)]
    (M : Type*) [AddCommGroup M] [Module (∀ i, K i) M] : Module.Flat (∀ i, K i) M :=
  Module.Flat.of_forall_fg_ideal_exists_mul_eq_self
    (fun _ hJ => Ideal.exists_mul_eq_self_of_fg_pi_field hJ) M
