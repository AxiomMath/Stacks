@[expose] public section

/-!
# Absolutely flat rings

A commutative ring is *absolutely flat* if every module over it is flat. Classically these are
the von Neumann regular rings; by Stacks Tag 092F this is also the condition of having weak
dimension at most zero.

## Main definitions

* `IsAbsolutelyFlat`: the predicate that every module over a commutative ring is flat.

## Main results

* `IsAbsolutelyFlat.flat`: the universe-independent elimination API for absolute flatness —
  an absolutely flat ring makes a module in *any* universe flat.
* `absolutelyFlat_tfae` (Stacks 092F): weak dimension at most zero, absolute flatness, being
  reduced with every prime maximal, and having field localizations at every prime are
  equivalent. Weak dimension at most zero is `HasWeakDimensionLE ... 0` (Stacks 092D), so the
  first condition is the source's derived-functor one and not a restatement of the second.
* `absolutelyFlat_and_isReduced_of_flat_lmul'` (Stacks 092I): flatness of the multiplication
  map propagates absolute flatness along a ring map, and makes a weakly étale algebra over a
  reduced ring reduced.

## Implementation notes

The defining quantifier in `IsAbsolutelyFlat` ranges over modules in the ring's own universe.
This is no loss of generality: `IsAbsolutelyFlat.flat` applies the predicate to modules in an
arbitrary universe.

Absolute flatness is spelled out as an explicit quantifier in the statements of
`absolutelyFlat_tfae` and `absolutelyFlat_and_isReduced_of_flat_lmul'` rather than via
`IsAbsolutelyFlat`, because those statements range over two different universes.

The first condition of `absolutelyFlat_tfae` is the source's own derived-functor condition,
`HasWeakDimensionLE ... 0` of `StacksFrontier.RingTheory.WeaklyEtale.Defs` (Stacks 092D): every
module has Tor dimension at most zero. Like every statement about weak dimension it carries the
derived tensor product, its comparison with termwise tensor product, and the universal property
certifying the comparison as a total left derived functor, exactly as `weakDimensionLE_one_tfae`
(Stacks 092S) does. The equivalence of that condition with absolute flatness is the
degree-zero case of Stacks 066F, `hasTorDimensionLE_iff_hasFlatRepresentative` of
`StacksFrontier.Homology.TorAmplitude.Module`: a flat resolution of length zero of `M` is a flat
structure on `M` itself.

Products of fields are the basic examples; see `product_of_fields_absolutely_flat`
(Stacks 092G) in `StacksFrontier.RingTheory.AbsolutelyFlat.ProductOfFields`.

## References

* [The Stacks Project, Tag 066F](https://stacks.math.columbia.edu/tag/066F)
* [The Stacks Project, Tag 092B](https://stacks.math.columbia.edu/tag/092B)
* [The Stacks Project, Tag 092D](https://stacks.math.columbia.edu/tag/092D)
* [The Stacks Project, Tag 092F](https://stacks.math.columbia.edu/tag/092F)
* [The Stacks Project, Tag 092I](https://stacks.math.columbia.edu/tag/092I)
* [Olivier, *Anneaux absolument plats universels et épimorphismes à buts réduits*][Olivier-AF]
-/

universe u v

open CategoryTheory CategoryTheory.MonoidalCategory
open TensorProduct

attribute [local instance] HasDerivedCategory.standard

/-- **Stacks 092B.** A commutative ring is absolutely flat if every module over it is flat. -/
@[stacks 092B]
abbrev IsAbsolutelyFlat (A : Type u) [CommRing A] : Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M

/-- In an absolutely flat ring every finitely generated ideal is generated by an idempotent. -/
private lemma exists_idempotent_span_eq (A : Type u) [CommRing A]
    (h : ∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M) (I : Ideal A)
    (hI : I.FG) : ∃ e : A, IsIdempotentElem e ∧ I = Ideal.span {e} := by
  have : I.Pure := h (A ⧸ I)
  exact (Ideal.isIdempotentElem_iff_of_fg I hI).mp (Ideal.isIdempotentElem_of_pure I)

namespace IsAbsolutelyFlat

/-- Over an absolutely flat ring, every module is flat, independently of the universe in which
the module lives. -/
theorem flat {A : Type u} [CommRing A] (hA : IsAbsolutelyFlat A)
    (M : Type v) [AddCommGroup M] [Module A M] : Module.Flat A M := by
  rw [Module.Flat.iff_rTensor_injective]
  intro I hI
  obtain ⟨e, he, hIe⟩ : ∃ e : A, IsIdempotentElem e ∧ I = A ∙ e :=
    exists_idempotent_span_eq A hA I hI
  let r : A →ₗ[A] I :=
    { toFun := fun x ↦ ⟨x * e, by
          rw [hIe, Ideal.mem_span_singleton']
          exact ⟨x, rfl⟩⟩
      map_add' _ _ := Subtype.ext (add_mul _ _ _)
      map_smul' _ _ := Subtype.ext (mul_assoc _ _ _) }
  have hr : r ∘ₗ I.subtype = LinearMap.id := by
    refine LinearMap.ext fun x ↦ ?_
    have hx : x.1 ∈ A ∙ e := by
      rw [← hIe]
      exact x.property
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hx
    apply Subtype.ext
    dsimp [r]
    rw [← ha, mul_assoc, he.eq, ha]
  have hcomp : LinearMap.rTensor M r ∘ₗ LinearMap.rTensor M I.subtype = LinearMap.id := by
    rw [← LinearMap.rTensor_comp, hr, LinearMap.rTensor_id]
  exact Function.LeftInverse.injective fun x ↦ by simpa using LinearMap.congr_fun hcomp x

end IsAbsolutelyFlat

/-- In an absolutely flat ring, a principal ideal `(x)` is generated by an idempotent `e`, with
`e ∈ (x)` and `x ∈ (e)`. -/
private lemma exists_idempotent_mem_span_mem_span (A : Type u) [CommRing A]
    (h : ∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M) (x : A) :
    ∃ e : A, IsIdempotentElem e ∧ e ∈ Ideal.span {x} ∧ x ∈ Ideal.span {e} := by
  obtain ⟨e, he, hspan⟩ :=
    exists_idempotent_span_eq A h (Ideal.span {x}) (Submodule.fg_span_singleton x)
  exact ⟨e, he, hspan.symm ▸ Ideal.subset_span (Set.mem_singleton e),
    hspan ▸ Ideal.subset_span (Set.mem_singleton x)⟩

/-- An absolutely flat ring is reduced and all of its prime ideals are maximal. -/
private lemma isReduced_and_isMaximal_of_forall_flat (A : Type u) [CommRing A]
    (h : ∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M) :
    IsReduced A ∧ ∀ p : Ideal A, p.IsPrime → p.IsMaximal := by
  constructor
  · refine IsReduced.mk fun x hx ↦ ?_
    obtain ⟨e, he, hex, hxe⟩ := exists_idempotent_mem_span_mem_span A h x
    obtain ⟨a, hea⟩ := Ideal.mem_span_singleton.mp hex
    obtain ⟨n, hxn⟩ := hx
    cases n with
    | zero => simpa using congrArg (x * ·) (show (1 : A) = 0 by simpa using hxn)
    | succ n =>
      have hezero : e = 0 := calc
        e = e ^ (n + 1) := (he.pow_eq (Nat.succ_ne_zero n)).symm
        _ = (x * a) ^ (n + 1) := congrArg (fun z : A ↦ z ^ (n + 1)) hea
        _ = 0 := by rw [mul_pow, hxn, zero_mul]
      obtain ⟨b, hbx⟩ := Ideal.mem_span_singleton.mp hxe
      rwa [hezero, zero_mul] at hbx
  · intro p hp
    rw [Ideal.isMaximal_iff]
    refine ⟨hp.one_notMem, fun J x hpJ hxnot hxJ ↦ ?_⟩
    obtain ⟨e, he, hex, hxe⟩ := exists_idempotent_mem_span_mem_span A h x
    have heJ : e ∈ J := by
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hex
      exact J.mul_mem_right _ hxJ
    have henotp : e ∉ p := fun hep ↦ hxnot
      ((Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hep)) hxe)
    have hone : 1 - e ∈ p :=
      (hp.mem_or_mem (show e * (1 - e) ∈ p by rw [mul_sub, he.eq]; simp)).resolve_left henotp
    simpa using J.add_mem heJ (hpJ hone)

/-- The three conditions of Stacks 092F that do not mention the derived category: `A` is
absolutely flat; `A` is reduced and every prime ideal is maximal; and the localization of `A` at
every prime ideal is a field.

This is the part of `absolutelyFlat_tfae` available without exhibiting a derived tensor product,
and is what the consumers of Stacks 092F in this development use. -/
theorem forall_flat_tfae (A : Type u) [CommRing A] :
    [ (∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M),
      IsReduced A ∧ ∀ p : Ideal A, p.IsPrime → p.IsMaximal,
      ∀ (p : Ideal A) [p.IsPrime], IsField (Localization.AtPrime p) ].TFAE := by
  tfae_have 1 → 2 := isReduced_and_isMaximal_of_forall_flat A
  tfae_have 2 → 3 := by
    intro h p hp
    let : IsReduced A := h.1
    have hpmin : p ∈ minimalPrimes A := by
      obtain ⟨q, hq, hqp⟩ := Ideal.exists_minimalPrimes_le bot_le (J := p)
      exact (h.2 q hq.1.1).eq_of_le hp.ne_top hqp ▸ hq
    have : Ring.KrullDimLE 0 (Localization.AtPrime p) :=
      Ring.KrullDimLE.of_isLocalization p hpmin (Localization.AtPrime p)
    exact Ring.KrullDimLE.isField_of_isReduced
  tfae_have 3 → 1 := by
    intro h M _ _
    apply Module.flat_of_localized_maximal
    intro P _
    let := (h P).toField
    rw [← Module.flat_iff_of_isLocalization (Localization.AtPrime P) P.primeCompl]
    exact Module.Flat.of_free
  tfae_finish

/-- For a commutative ring `A`, the following are equivalent: `A` has weak dimension at most
zero; `A` is absolutely flat; `A` is reduced and every prime ideal is maximal; and the
localization of `A` at every prime ideal is a field.

Weak dimension is `HasWeakDimensionLE`, which carries the derived tensor product, its comparison
with termwise tensor product, and the universal property certifying that the comparison exhibits
the derived tensor product as a total left derived functor. Those data are part of the statement,
exactly as in the source and as in `weakDimensionLE_one_tfae` (Stacks 092S). -/
@[stacks 092F]
theorem absolutelyFlat_tfae (A : Type u) [CommRing A]
    (derivedTensor :
      DerivedCategory (ModuleCat.{u} A) ⥤
        DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory (ModuleCat.{u} A))
    (comparison : ∀ N : ModuleCat.{u} A,
      DerivedCategory.Q ⋙
          derivedTensor.flip.obj
            ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj N) ⟶
        ((tensoringRight (ModuleCat.{u} A)).obj N).mapHomologicalComplex
            (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    (isLeftDerived : ∀ N : ModuleCat.{u} A,
      (derivedTensor.flip.obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj N)).IsLeftDerivedFunctor
        (comparison N)
        (HomologicalComplex.quasiIso (ModuleCat.{u} A) (ComplexShape.up ℤ))) :
    [ HasWeakDimensionLE derivedTensor comparison isLeftDerived 0,
      (∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M),
      IsReduced A ∧ ∀ p : Ideal A, p.IsPrime → p.IsMaximal,
      ∀ (p : Ideal A) [p.IsPrime], IsField (Localization.AtPrime p) ].TFAE := by
  tfae_have 1 → 2 := fun h1 M _ _ ↦
    (StacksDraft.TorAmplitude.hasTorDimensionLE_iff_hasFlatRepresentative
      comparison isLeftDerived (ModuleCat.of A M) 0).2.mp (h1 (ModuleCat.of A M))
  tfae_have 2 → 1 := fun h2 M ↦
    (StacksDraft.TorAmplitude.hasTorDimensionLE_iff_hasFlatRepresentative
      comparison isLeftDerived M 0).2.mpr (h2 M)
  tfae_have 2 → 3 := ((forall_flat_tfae A).out 1 2).mp
  tfae_have 3 → 4 := ((forall_flat_tfae A).out 2 3).mp
  tfae_have 4 → 2 := ((forall_flat_tfae A).out 3 1).mp
  tfae_finish

/-- Flatness over a ring whose modules in one universe are all flat transfers to modules in an
arbitrary universe. -/
private theorem flat_of_forall_flat_same_universe
    (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]
    (h : ∀ (P : Type u) [AddCommGroup P] [Module R P], Module.Flat R P) :
    Module.Flat R M :=
  IsAbsolutelyFlat.flat h M

/-- If the multiplication map `B ⊗[A] B → B` is flat, then an absolutely flat base
ring makes `B` absolutely flat. Under the same hypothesis, if `A` is reduced and
`A → B` is weakly étale, then `B` is reduced. -/
@[stacks 092I]
theorem absolutelyFlat_and_isReduced_of_flat_lmul'
    (A : Type u) (B : Type v) [CommRing A] [CommRing B] [Algebra A B]
    (hμ : (Algebra.TensorProduct.lmul' A (S := B)).Flat) :
    ((∀ (M : Type u) [AddCommGroup M] [Module A M], Module.Flat A M) →
      ∀ (N : Type v) [AddCommGroup N] [Module B N], Module.Flat B N) ∧
    (IsReduced A → Algebra.WeaklyEtale A B → IsReduced B) := by
  constructor
  · intro hA N _ _
    let : Module A N := Module.compHom N (algebraMap A B)
    let : IsScalarTower A B N := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
    exact flat_of_flat_of_mul_flat A B hμ N
      (flat_of_forall_flat_same_universe A N hA)
  · intro hA hwe
    let : IsReduced A := hA
    obtain ⟨ι, K, hK, f, hf⟩ := exists_injective_ringHom_pi_field (R := A)
    let : ∀ i, Field (K i) := hK
    let A' := ∀ i, K i
    let : Algebra A A' := f.toAlgebra
    let B' := TensorProduct A A' B
    have hμ' := mulFlat_baseChange A B A' hμ
    have hB'flat : ∀ (M : Type (max u v)) [AddCommGroup M] [Module B' M],
        Module.Flat B' M := by
      intro M _ _
      let : Module A' M := Module.compHom M
        (Algebra.TensorProduct.includeLeft (R := A) (S := A') (A := A') (B := B)).toRingHom
      let : IsScalarTower A' B' M := ⟨fun a b m ↦ by
        change (a • b) • m = (a ⊗ₜ[A] (1 : B)) • (b • m)
        rw [← mul_smul]
        congr 1
        induction b using TensorProduct.inductionOn with
        | add x y hx hy => rw [smul_add, hx, hy, mul_add]
        | tmul x y =>
            simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
            apply congrArg (fun z : A' ↦ z ⊗ₜ[A] y)
            funext i
            rfl⟩
      exact flat_of_flat_of_mul_flat A' B' hμ' M
        (product_of_fields_absolutely_flat K M)
    have hred : IsReduced B' ∧ ∀ p : Ideal B', p.IsPrime → p.IsMaximal :=
      ((forall_flat_tfae B').out 1 2).mp hB'flat
    let : IsReduced B' := hred.1
    have : Module.Flat A B := hwe.flat
    exact isReduced_of_injective (Algebra.TensorProduct.includeRight : B →ₐ[A] B')
      (Algebra.TensorProduct.includeRight_injective hf)
