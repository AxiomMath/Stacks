module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.SimpleRing.Principal
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Equality of the images of two spectra attached to `S' ⊆ S`

Fix a field `k`. Let `R` and `S` be (commutative) `k`-algebras, let `S' ⊆ S` be a
sub-`k`-algebra, and write `ι : S' ↪ S` for the inclusion (a morphism of `k`-algebras).
Fix an element `f ∈ S' ⊗[k] R`. All tensor products are taken over `k`.

We single out the following maps.

1. The inclusion on tensor products
   `Φ = ι ⊗ id_R : S' ⊗[k] R → S ⊗[k] R`,
   the `k`-algebra homomorphism induced by `ι` on the first factor and the identity
   on `R`. We write `Φ(f)` for the image of `f`.

2. The localizations
   `A' = (S' ⊗[k] R)_f` and `A = (S ⊗[k] R)_{Φ(f)}`,
   localizations at the multiplicative set generated by `f` and `Φ(f)` respectively.
   Since `Φ` sends `f` to `Φ(f)`, it induces a unique `k`-algebra homomorphism on
   localizations `Φ̃ : A' → A`.

3. The `R`-algebra structures. The element `r ↦ 1_{S'} ⊗ r` defines `R → S' ⊗[k] R`,
   and likewise `r ↦ 1_S ⊗ r` defines `R → S ⊗[k] R`. Composing with the localization
   maps gives structure homomorphisms `α' : R → A'` and `α : R → A`. These are
   compatible with `Φ̃`, i.e. `Φ̃ ∘ α' = α`.

4. Applying `Spec(-)` (with morphisms given by taking preimages of prime ideals, i.e.
   `PrimeSpectrum.comap`) yields a commutative diagram with diagonal maps
   `Spec(α) : Spec(A) → Spec(R)` and `Spec(α') : Spec(A') → Spec(R)`.

## Main statement

With the notation above, the images in `Spec(R)` of the two diagonal maps coincide:
`im(Spec(α)) = im(Spec(α'))`.

## Notes

- The base ring `k` is a field; this is essential, since the proof uses that the residue
  fields `κ(p)` are flat (free) over `k`, making `S' ⊗[k] κ(p) → S ⊗[k] κ(p)` injective.
- No special hypotheses are placed on `f`: it may be a unit, a zero divisor, nilpotent,
  or zero. When a relevant localization is the zero ring, its spectrum is empty.
- The mathematical content uses that `ι` is injective (a subalgebra inclusion); this is
  recorded as a hypothesis `Function.Injective ι`, modelling `S' ⊆ S`.
-/

@[expose] public section

open TensorProduct

namespace Stacks.TensorProductSpecImage

variable (k R S S' : Type*) [Field k] [CommRing R] [CommRing S] [CommRing S']
variable [Algebra k R] [Algebra k S] [Algebra k S']

-- The inclusion `ι : S' ↪ S` as a `k`-algebra homomorphism.
-- (Its injectivity, modelling `S' ⊆ S`, is recorded as a hypothesis below.)
variable (ι : S' →ₐ[k] S)

/-- `Φ = ι ⊗ id_R : S' ⊗[k] R → S ⊗[k] R`, the base-change of the inclusion `ι`. -/
noncomputable def baseChangeIncl : S' ⊗[k] R →ₐ[k] S ⊗[k] R :=
  Algebra.TensorProduct.map ι (AlgHom.id k R)

-- The distinguished element `f ∈ S' ⊗[k] R`.
variable (f : S' ⊗[k] R)

/-- The structure homomorphism `α' : R → A' = (S' ⊗[k] R)_f`, obtained by composing
`r ↦ 1_{S'} ⊗ r` with the localization map. -/
noncomputable def alphaPrime : R →+* Localization.Away f :=
  (algebraMap (S' ⊗[k] R) (Localization.Away f)).comp
    (Algebra.TensorProduct.includeRight (R := k) (A := S') (B := R)).toRingHom

/-- The structure homomorphism `α : R → A = (S ⊗[k] R)_{Φ(f)}`, obtained by composing
`r ↦ 1_S ⊗ r` with the localization map. -/
noncomputable def alphaMap : R →+* Localization.Away (baseChangeIncl k R S S' ι f) :=
  (algebraMap (S ⊗[k] R) (Localization.Away (baseChangeIncl k R S S' ι f))).comp
    (Algebra.TensorProduct.includeRight (R := k) (A := S) (B := R)).toRingHom

/-- The induced map on localizations `Φ̃ : A' = (S' ⊗[k] R)_f → (S ⊗[k] R)_{Φ(f)} = A`. -/
noncomputable def PhiTilde :
    Localization.Away f →+* Localization.Away (baseChangeIncl k R S S' ι f) :=
  IsLocalization.Away.map (Localization.Away f) (Localization.Away (baseChangeIncl k R S S' ι f))
    (baseChangeIncl k R S S' ι).toRingHom f

/-- The diagram of structure maps commutes: `Φ̃ ∘ α' = α`. This characterises `PhiTilde`,
`alphaPrime` and `alphaMap` as the maps in the statement. -/
theorem phiTilde_comp_alphaPrime :
    (PhiTilde k R S S' ι f).comp (alphaPrime k R S' f) = alphaMap k R S S' ι f := by
  -- The diagram commutes by the universal property of localization. `PhiTilde`
  -- unfolds to `IsLocalization.map`, and `IsLocalization.map_comp` rewrites
  -- `(IsLocalization.map …).comp (algebraMap …)` to `(algebraMap …).comp Φ`. The
  -- residual goal `Φ ∘ includeRight = includeRight` reduces to `ι(1) = 1`, closed
  -- by `simp [baseChangeIncl]`.
  rw [PhiTilde, alphaPrime, alphaMap, ← RingHom.comp_assoc, IsLocalization.Away.map,
    IsLocalization.map_comp, RingHom.comp_assoc]
  congr 1
  ext r
  simp [baseChangeIncl]

/-- For a prime `p ⊆ R`, the residue field `κ(p)`. We use `abbrev` so that the
`Field`/`Algebra` instances on `IsLocalRing.ResidueField …` are found transparently. -/
@[sga "1 I 7.5" "more general"]
noncomputable abbrev residueField (p : PrimeSpectrum R) : Type _ :=
  IsLocalRing.ResidueField (Localization.AtPrime p.asIdeal)

/-- The canonical `k`-algebra (via `R`) reduction map `T ⊗[k] R → T ⊗[k] κ(p)` for a
`k`-algebra `T`, induced by the residue map `R → κ(p)` on the right factor. -/
noncomputable def toResidueTensor (T : Type*) [CommRing T] [Algebra k T]
    (p : PrimeSpectrum R) : T ⊗[k] R →+* T ⊗[k] residueField R p :=
  (Algebra.TensorProduct.map (AlgHom.id k T)
    (IsScalarTower.toAlgHom k R (residueField R p))).toRingHom

/-- `Nontrivial (Localization.Away a) ↔ ¬ IsNilpotent a`: the localization away from `a`
is the zero ring exactly when some power of `a` vanishes. -/
private theorem nontrivial_away_iff_aux (A : Type*) [CommRing A] (a : A) :
    Nontrivial (Localization.Away a) ↔ ¬ IsNilpotent a := by
  rw [← not_subsingleton_iff_nontrivial, not_iff_not]
  refine ⟨fun h ↦ ?_, IsLocalization.subsingleton (M := Submonoid.powers a)⟩
  have h₁ : (algebraMap A (Localization.Away a)) 1 = 0 := Subsingleton.elim _ _
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers a)] at h₁
  obtain ⟨⟨m, n, hn⟩, hm⟩ := h₁
  rw [mul_one] at hm
  exact ⟨n, hn.trans hm⟩

/-- The `R`-linear swap `T ⊗[k] R ≃ R ⊗[k] T`, where `T ⊗[k] R` carries the `R`-algebra
structure on the right factor. -/
private noncomputable def innerCommAux (T : Type*) [CommRing T] [Algebra k T] :
    letI : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
    (T ⊗[k] R) ≃ₐ[R] (R ⊗[k] T) :=
  letI : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
  AlgEquiv.ofRingEquiv (f := (Algebra.TensorProduct.comm k T R).toRingEquiv)
    (fun r ↦ by
      simp only [RingEquiv.coe_mk, AlgEquiv.toEquiv_eq_coe, EquivLike.coe_coe,
        Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      rfl)

/-- The fibre isomorphism `κ(p) ⊗[R] (T ⊗[k] R) ≃+* T ⊗[k] κ(p)`, combining the swap on
the inner factor, cancellation of the base change `κ(p) ⊗[R] (R ⊗[k] T) ≃ κ(p) ⊗[k] T`,
and a final swap. -/
private noncomputable def bigEquivAux (T : Type*) [CommRing T] [Algebra k T]
    (p : PrimeSpectrum R) :
    letI : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
    (residueField R p ⊗[R] (T ⊗[k] R)) ≃+* (T ⊗[k] residueField R p) :=
  letI : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
  ((Algebra.TensorProduct.congr (AlgEquiv.refl (R := residueField R p) (A₁ := residueField R p))
      (innerCommAux k R T)).toRingEquiv).trans
    (((Algebra.TensorProduct.cancelBaseChange k R (residueField R p) (residueField R p)
        T).toRingEquiv).trans
      (Algebra.TensorProduct.comm k (residueField R p) T).toRingEquiv)

/-- The fibre isomorphism sends `1 ⊗ₜ g` to the reduction `toResidueTensor … g`. -/
private theorem bigEquivAux_one_tmul (T : Type*) [CommRing T] [Algebra k T]
    (p : PrimeSpectrum R) (g : T ⊗[k] R) :
    letI : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
    (bigEquivAux k R T p) ((1 : residueField R p) ⊗ₜ[R] g) = (toResidueTensor k R T p) g := by
  let : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
  induction g with
  | zero => simp
  | tmul t r =>
    simp only [bigEquivAux, innerCommAux, RingEquiv.coe_trans, RingEquiv.coe_mk,
      AlgEquiv.toEquiv_eq_coe, EquivLike.coe_coe, Function.comp_apply,
      Algebra.TensorProduct.congr_apply, AlgEquiv.refl_toAlgHom, Algebra.TensorProduct.map_tmul,
      AlgHom.coe_id, id_eq, AlgEquiv.coe_toAlgHom, AlgEquiv.ofRingEquiv_apply,
      Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.cancelBaseChange_tmul, toResidueTensor,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe, IsScalarTower.coe_toAlgHom']
    rw [Algebra.smul_def, mul_one]
  | add x y hx hy => rw [tmul_add, map_add, map_add, hx, hy]

/-- **Fibre criterion (the analytic kernel; Stacks Tag 00E7 = 10.18.6).**
For a `k`-algebra `T`, an element `g : T ⊗[k] R`, and the structure map
`αT : R → (T ⊗[k] R)_g` (localization at the powers of `g`, composed with
`r ↦ 1_T ⊗ r`), a prime `p ⊆ R` lies in the image of `Spec(αT)` iff the fibre ring
`(T ⊗[k] R)_g ⊗_R κ(p) ≅ (T ⊗_k κ(p))_{ḡ}` is nonzero, i.e. iff the image `ḡ` of `g`
in `T ⊗[k] κ(p)` is **not** nilpotent.

Proof idea: `p ∈ im(Spec αT)` iff some prime of `(T⊗R)_g` lies over `p`, iff the fibre
ring `(T⊗R)_g ⊗_R κ(p)` is nonzero (Tag 00E7 / `PrimeSpectrum.mem_range_comap_iff`
combined with the standard "prime lying over ⟺ nonzero fibre"). Base change cancels
(`Algebra.TensorProduct.cancelBaseChange`) and localization commutes with base change
(the `IsLocalization (algebraMapSubmonoid …) (TensorProduct …)` instance), giving
`(T⊗_k R)_g ⊗_R κ(p) ≅ (T ⊗_k κ(p))_{ḡ}`. Finally `Nontrivial (Localization.Away ḡ) ↔
¬ IsNilpotent ḡ` (from `IsLocalization.subsingleton` + `IsLocalization.eq_iff_exists`). -/
theorem mem_range_iff_not_isNilpotent (T : Type*) [CommRing T] [Algebra k T]
    (g : T ⊗[k] R) (p : PrimeSpectrum R) :
    p ∈ Set.range (PrimeSpectrum.comap (R := R) (S := Localization.Away g)
        ((algebraMap (T ⊗[k] R) (Localization.Away g)).comp
          (Algebra.TensorProduct.includeRight (R := k) (A := T) (B := R)).toRingHom)) ↔
      ¬ IsNilpotent (toResidueTensor k R T p g) := by
  -- Equip `Localization.Away g` with the `R`-algebra structure via `r ↦ 1_T ⊗ r`.
  let algRTR : Algebra R (T ⊗[k] R) := Algebra.TensorProduct.rightAlgebra
  -- The structure map `R → (T ⊗ R)_g` is exactly `algebraMap R (Localization.Away g)`.
  have hmap : (algebraMap R (Localization.Away g)) =
      (algebraMap (T ⊗[k] R) (Localization.Away g)).comp
        (Algebra.TensorProduct.includeRight (R := k) (A := T) (B := R)).toRingHom := rfl
  -- Fibre criterion: `p ∈ image ↔ fibre `κ(p) ⊗_R (T⊗R)_g` is nontrivial.
  rw [← hmap, ← PrimeSpectrum.nontrivial_iff_mem_rangeComap (S := Localization.Away g)]
  -- The fibre is a localization of `κ(p) ⊗_R (T⊗R)` away from `1 ⊗ₜ g`.
  rw [(IsLocalization.Away.tensorProductEquivTMulRight (R := R)
        (S := p.asIdeal.ResidueField) (A := T ⊗[k] R) g
        (Localization.Away g)).toRingEquiv.toEquiv.nontrivial_congr,
      nontrivial_away_iff_aux]
  -- Reduce to nilpotency of `1 ⊗ₜ g`, then transport along the fibre isomorphism.
  show ¬ IsNilpotent ((1 : residueField R p) ⊗ₜ[R] g) ↔ _
  rw [not_iff_not, ← bigEquivAux_one_tmul k R T p g]
  exact (IsNilpotent.map_iff (bigEquivAux k R T p).injective).symm

/-- **Field-flatness injectivity.** Since `κ(p)` is a `k`-vector space (`k` a field),
it is flat over `k`, so tensoring the injective map `ι : S' ↪ S` with `κ(p)` keeps it
injective: `ι ⊗ id_{κ(p)} : S' ⊗[k] κ(p) → S ⊗[k] κ(p)` is injective.

Proof idea: `Module.Flat k (residueField R p)` holds by `inferInstance` (vector spaces
are flat); apply `Module.Flat.rTensor_preserves_injective_linearMap` to the injective
`k`-linear map underlying `ι`. -/
theorem baseChangeResidue_injective (hι : Function.Injective ι) (p : PrimeSpectrum R) :
    Function.Injective
      (Algebra.TensorProduct.map ι (AlgHom.id k (residueField R p))) := by
  -- `κ(p)` is a `k`-vector space, hence flat over `k`; tensoring the injective
  -- `k`-linear map underlying `ι` with `κ(p)` keeps it injective.
  have hinj : Function.Injective (LinearMap.rTensor (residueField R p) ι.toLinearMap) :=
    Module.Flat.rTensor_preserves_injective_linearMap (M := residueField R p)
      ι.toLinearMap (by simpa using hι)
  have hmap : ∀ x, (Algebra.TensorProduct.map ι (AlgHom.id k (residueField R p))) x
      = (LinearMap.rTensor (residueField R p) ι.toLinearMap) x := fun x ↦ by
    induction x with
    | zero => simp
    | tmul a b => simp
    | add x y hx hy => simp [hx, hy]
  exact fun x y hxy ↦ hinj (by simpa only [hmap] using hxy)

/-- **Compatibility of the reduction maps with `Φ = ι ⊗ id`.** The square
`(S'⊗R) → (S⊗R)` over `(S'⊗κ(p)) → (S⊗κ(p))` commutes: reducing then applying
`ι ⊗ id_{κ(p)}` equals applying `Φ = ι ⊗ id_R` then reducing. Hence the image of `f`
in `S ⊗ κ(p)` equals `(ι ⊗ id_{κ(p)})` applied to the image of `f` in `S' ⊗ κ(p)`.

Proof idea: both sides are `k`-algebra maps `S'⊗[k]R → S⊗[k]κ(p)`; check equality on the
generators `s'⊗r` by `Algebra.TensorProduct.ext` / `ext` + `simp [baseChangeIncl,
toResidueTensor]`. -/
theorem toResidueTensor_baseChange (p : PrimeSpectrum R) :
    (toResidueTensor k R S p).comp (baseChangeIncl k R S S' ι).toRingHom
      = (Algebra.TensorProduct.map ι (AlgHom.id k (residueField R p))).toRingHom.comp
          (toResidueTensor k R S' p) := by
  refine RingHom.ext fun x ↦ ?_
  induction x with
  | zero => simp
  | tmul s' r =>
    simp [baseChangeIncl, toResidueTensor, Algebra.TensorProduct.map_tmul]
  | add a b ha hb =>
    simp only [map_add, ha, hb]

/-- The images in `Spec(R)` of the two diagonal maps coincide:
`im(Spec(α)) = im(Spec(α'))`. -/
@[stacks 037F]
theorem images_eq (hι : Function.Injective ι) :
    Set.range (PrimeSpectrum.comap (R := R)
        (S := Localization.Away (baseChangeIncl k R S S' ι f)) (alphaMap k R S S' ι f)) =
      Set.range (PrimeSpectrum.comap (R := R) (S := Localization.Away f) (alphaPrime k R S'
          f)) := by
  ext p
  -- Apply the fibre criterion to `S` (with element `Φ f`) and to `S'` (with element `f`).
  refine (mem_range_iff_not_isNilpotent k R S (baseChangeIncl k R S S' ι f) p).trans
    (Iff.trans ?_ (mem_range_iff_not_isNilpotent k R S' f p).symm)
  -- The image of `f` in `S ⊗ κ(p)` is `(ι ⊗ id_{κ(p)})` applied to its image in `S' ⊗ κ(p)`,
  -- and this map is injective (field flatness), so it preserves and reflects nilpotency.
  erw [RingHom.congr_fun (toResidueTensor_baseChange k R S S' ι p) f]
  exact not_iff_not.2 (IsNilpotent.map_iff (baseChangeResidue_injective k R S S' ι hι p))

end Stacks.TensorProductSpecImage
