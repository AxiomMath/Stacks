module

public import StacksFrontier.RingTheory.TensorProduct.ContentNonZeroDivisor
public import Mathlib.RingTheory.Flat.Basic

/-!
# The coordinate ideal of an element of `C ⊗[k] A`

Let `k` be a field, `C` and `A` commutative `k`-algebras.  Choosing a `k`-basis `(e_i)` of `C`,
every `t : C ⊗[k] A` is uniquely `∑ e_i ⊗ a_i`; the *coordinate ideal* of `t` is the ideal of
`A` generated by the coordinates `a_i`.  It is finitely generated, and a `k`-algebra map
`g : A →ₐ[k] A'` kills `t` (after base change) exactly when it kills the coordinate ideal. Thus
the vanishing of `t` after base change, as a condition functorial in `A`, is represented by a
finitely generated ideal of `A`.

The file also records that the content lemma of
`StacksFrontier.RingTheory.TensorProduct.ContentNonZeroDivisor` is stable under base change: an
element of `C ⊗[k] A` which is nonzero in every fibre stays nonzero in every fibre after any
`k`-algebra map `A → A'`, so for `C` geometrically integral its image is a non-zero-divisor of
`C ⊗[k] A'` for every `A'`.

## Main definitions

* `TensorProduct.coordIdeal t`: the coordinate ideal of `t : C ⊗[k] A`.

## Main results

* `TensorProduct.coordIdeal_fg`: it is finitely generated.
* `TensorProduct.map_eq_zero_iff_coordIdeal_le_ker`: `g` kills `t` iff it kills `coordIdeal t`.
* `TensorProduct.map_mem_nonZeroDivisors_of_forall_residueField_ne_zero`: base-change stability
  of the integral content lemma.
-/

@[expose] public section

open scoped TensorProduct

namespace TensorProduct

open ContentNonZeroDivisor

universe u

variable {k C A A' : Type*} [Field k] [CommRing C] [Algebra k C] [CommRing A] [Algebra k A]
  [CommRing A'] [Algebra k A']

open Classical in
variable (C) in
/-- The coordinate ideal of `t : C ⊗[k] A`: the ideal of `A` generated by the coordinates of `t`
in the chosen `k`-basis of `C`. -/
noncomputable def coordIdeal (t : C ⊗[k] A) : Ideal A :=
  Ideal.span (((coord C A t).support.image (coord C A t)) : Set A)

/-- The coordinate ideal is finitely generated. -/
theorem coordIdeal_fg (t : C ⊗[k] A) : (coordIdeal C t).FG := by
  classical
  exact ⟨_, rfl⟩

/-- Each coordinate of `t` in the chosen `k`-basis of `C` lies in the coordinate ideal of `t`. -/
theorem coord_mem_coordIdeal (t : C ⊗[k] A) (i : ι k C) : coord C A t i ∈ coordIdeal C t := by
  classical
  by_cases hi : i ∈ (coord C A t).support
  · exact Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hi))
  · rw [Finsupp.notMem_support_iff.mp hi]
    exact Ideal.zero_mem _

/-- **A `k`-algebra map kills `t` exactly when it kills its coordinate ideal.** -/
theorem map_eq_zero_iff_coordIdeal_le_ker (g : A →ₐ[k] A') (t : C ⊗[k] A) :
    Algebra.TensorProduct.map (AlgHom.id k C) g t = 0 ↔ coordIdeal C t ≤ RingHom.ker g := by
  classical
  refine ⟨fun h ↦ Ideal.span_le.mpr fun a ha ↦ ?_, fun h ↦ (coord C A').injective ?_⟩
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp ha)
    simpa only [coord_map, map_zero, Finsupp.coe_zero, Pi.zero_apply, SetLike.mem_coe,
      RingHom.mem_ker] using congrArg (fun s ↦ coord C A' s i) h
  · ext i
    rw [coord_map, map_zero, Finsupp.coe_zero, Pi.zero_apply]
    exact h (coord_mem_coordIdeal t i)

variable (C) in
/-- Base change along an injective map of `k`-modules stays injective after tensoring with `C`
over the field `k`. -/
theorem injective_map_of_injective {K K' : Type*} [CommRing K] [Algebra k K] [CommRing K']
    [Algebra k K'] (φ : K →ₐ[k] K') (hφ : Function.Injective φ) :
    Function.Injective (Algebra.TensorProduct.map (AlgHom.id k C) φ) := by
  convert Module.Flat.lTensor_preserves_injective_linearMap (M := C) φ.toLinearMap hφ using 1
  ext x
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul c a => rfl
  | add s t hs ht => simp only [map_add, hs, ht]

/-- Base change to the residue field at `p'` factors through the residue field at a prime `p` of
`A` (the preimage of `p'`), via an injective `k`-algebra map `φ`. -/
private theorem exists_injective_map_residueField_comap (g : A →ₐ[k] A') (p' : PrimeSpectrum A')
    (t : C ⊗[k] A) :
    ∃ (p : PrimeSpectrum A) (φ : p.asIdeal.ResidueField →ₐ[k] p'.asIdeal.ResidueField),
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id k C) φ) ∧
      Algebra.TensorProduct.map (AlgHom.id k C)
        (IsScalarTower.toAlgHom k A' p'.asIdeal.ResidueField)
        (Algebra.TensorProduct.map (AlgHom.id k C) g t) =
      Algebra.TensorProduct.map (AlgHom.id k C) φ
        (Algebra.TensorProduct.map (AlgHom.id k C)
          (IsScalarTower.toAlgHom k A p.asIdeal.ResidueField) t) := by
  let p : PrimeSpectrum A := ⟨p'.asIdeal.comap g.toRingHom, Ideal.comap_isPrime _ _⟩
  let φ : p.asIdeal.ResidueField →ₐ[k] p'.asIdeal.ResidueField :=
    Ideal.ResidueField.mapₐ p.asIdeal p'.asIdeal g rfl
  have hcomp : (IsScalarTower.toAlgHom k A' p'.asIdeal.ResidueField).comp g =
      φ.comp (IsScalarTower.toAlgHom k A p.asIdeal.ResidueField) := by
    ext a
    change algebraMap A' p'.asIdeal.ResidueField (g a) =
      Ideal.ResidueField.map p.asIdeal p'.asIdeal g.toRingHom rfl
        (algebraMap A p.asIdeal.ResidueField a)
    rw [Ideal.ResidueField.map_algebraMap]
    rfl
  refine ⟨p, φ, injective_map_of_injective C φ φ.toRingHom.injective, ?_⟩
  rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, hcomp,
    Algebra.TensorProduct.map_comp, AlgHom.comp_apply]

/-- **The fibrewise-nonzero condition of the content lemma is stable under base change.** -/
theorem map_residueField_ne_zero_of_forall (g : A →ₐ[k] A') (t : C ⊗[k] A)
    (h : ∀ p : PrimeSpectrum A,
      Algebra.TensorProduct.map (AlgHom.id k C) (IsScalarTower.toAlgHom k A p.asIdeal.ResidueField)
        t ≠ 0)
    (p' : PrimeSpectrum A') :
    Algebra.TensorProduct.map (AlgHom.id k C)
      (IsScalarTower.toAlgHom k A' p'.asIdeal.ResidueField)
        (Algebra.TensorProduct.map (AlgHom.id k C) g t) ≠ 0 := by
  obtain ⟨p, φ, hφ, e⟩ := exists_injective_map_residueField_comap (C := C) g p' t
  rw [e]
  exact fun h0 ↦ h p (hφ (by rwa [map_zero]))

/-- **The integral content lemma after base change**: if `C` is geometrically integral and `t` is
nonzero in every fibre `C ⊗[k] κ(p)`, then the image of `t` in `C ⊗[k] A'` is a
non-zero-divisor for every `k`-algebra map `A → A'`. -/
theorem map_mem_nonZeroDivisors_of_forall_residueField_ne_zero {k C A A' : Type u} [Field k]
    [CommRing C] [Algebra k C] [CommRing A] [Algebra k A] [CommRing A'] [Algebra k A']
    [Algebra.IsGeometricallyIntegral k C] (g : A →ₐ[k] A') (t : C ⊗[k] A)
    (h : ∀ p : PrimeSpectrum A,
      Algebra.TensorProduct.map (AlgHom.id k C) (IsScalarTower.toAlgHom k A p.asIdeal.ResidueField)
        t ≠ 0) :
    Algebra.TensorProduct.map (AlgHom.id k C) g t ∈ nonZeroDivisors (C ⊗[k] A') :=
  mem_nonZeroDivisors_of_forall_residueField_ne_zero _ (map_residueField_ne_zero_of_forall g t h)

/-- **The nilpotent content lemma after base change**: if in every fibre `C ⊗[k] κ` (`κ` a field
over `k`) every zero divisor is nilpotent, and `t` is not nilpotent in any fibre `C ⊗[k] κ(p)`,
then the image of `t` in `C ⊗[k] A'` is a non-zero-divisor for every `k`-algebra map `A → A'`. -/
theorem map_mem_nonZeroDivisors_of_forall_not_isNilpotent {k C A A' : Type u} [Field k]
    [CommRing C] [Algebra k C] [CommRing A] [Algebra k A] [CommRing A'] [Algebra k A']
    (hC : ∀ (κ : Type u) [Field κ] [Algebra k κ] (z : C ⊗[k] κ),
      z ∉ nonZeroDivisors (C ⊗[k] κ) → IsNilpotent z)
    (g : A →ₐ[k] A') (t : C ⊗[k] A)
    (h : ∀ p : PrimeSpectrum A, ¬ IsNilpotent
      (Algebra.TensorProduct.map (AlgHom.id k C) (IsScalarTower.toAlgHom k A p.asIdeal.ResidueField)
        t)) :
    Algebra.TensorProduct.map (AlgHom.id k C) g t ∈ nonZeroDivisors (C ⊗[k] A') := by
  refine mem_nonZeroDivisors_of_forall_not_isNilpotent _ (fun p' ↦ hC _) fun p' hnil ↦ ?_
  obtain ⟨p, φ, hφ, e⟩ := exists_injective_map_residueField_comap (C := C) g p' t
  rw [e] at hnil
  exact h p ((IsNilpotent.map_iff hφ).mp hnil)

/-- **Points over `p` detect the fibre at `p`.**  Let `P` be identified with `C ⊗[k] A` by a ring
isomorphism `e` sending `c ⊗ a` to `i₁ c · i₂ a`.  If `Q` is a prime of `P` lying over the prime
`p` of `A` and `e t ∉ Q`, then the image of `t` in the fibre `C ⊗[k] κ(p)` is not nilpotent. -/
theorem not_isNilpotent_map_residueField_of_not_mem {k C A P : Type u} [Field k] [CommRing C]
    [Algebra k C] [CommRing A] [Algebra k A] [CommRing P] (e : C ⊗[k] A ≃+* P) (i₁ : C →+* P)
    (i₂ : A →+* P) (he : ∀ c a, e (c ⊗ₜ a) = i₁ c * i₂ a) (t : C ⊗[k] A) (Q : Ideal P)
    [Q.IsPrime] (p : Ideal A) [p.IsPrime] (hQp : p = Q.comap i₂) (ht : e t ∉ Q) :
    ¬ IsNilpotent
      (Algebra.TensorProduct.map (AlgHom.id k C) (IsScalarTower.toAlgHom k A p.ResidueField)
        t) := by
  have hw : ∀ r : k, i₁ (algebraMap k C r) = i₂ (algebraMap k A r) := by
    intro r
    have h1 := he (algebraMap k C r) 1
    have h2 := he 1 (algebraMap k A r)
    rw [map_one, mul_one] at h1
    rw [map_one, one_mul] at h2
    rw [← h1, ← h2, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
      TensorProduct.smul_tmul]
  let : Algebra k Q.ResidueField :=
    ((algebraMap P Q.ResidueField).comp (i₁.comp (algebraMap k C))).toAlgebra
  let f₁ : C →ₐ[k] Q.ResidueField :=
    { (algebraMap P Q.ResidueField).comp i₁ with commutes' := fun _ ↦ rfl }
  let f₂ : p.ResidueField →ₐ[k] Q.ResidueField :=
    { Ideal.ResidueField.map p Q i₂ hQp with
      commutes' := fun r ↦ by
        show Ideal.ResidueField.map p Q i₂ hQp (algebraMap k p.ResidueField r) = _
        rw [IsScalarTower.algebraMap_apply k A p.ResidueField, Ideal.ResidueField.map_algebraMap]
        show algebraMap P Q.ResidueField (i₂ (algebraMap k A r)) =
          algebraMap P Q.ResidueField (i₁ (algebraMap k C r))
        rw [hw] }
  let ψ := Algebra.TensorProduct.lift f₁ f₂ fun _ _ ↦ Commute.all _ _
  have key : ∀ x : C ⊗[k] A,
      ψ (Algebra.TensorProduct.map (AlgHom.id k C)
        (IsScalarTower.toAlgHom k A p.ResidueField) x) = algebraMap P Q.ResidueField (e x) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul c a =>
      rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.lift_tmul, he, map_mul]
      show algebraMap P Q.ResidueField (i₁ c) *
          Ideal.ResidueField.map p Q i₂ hQp (algebraMap A p.ResidueField a) = _
      rw [Ideal.ResidueField.map_algebraMap]
    | add x y hx hy => simp only [map_add, hx, hy]
  intro hnil
  have h1 : IsNilpotent (algebraMap P Q.ResidueField (e t)) := key t ▸ hnil.map ψ
  exact ht ((Ideal.algebraMap_residueField_eq_zero).mp h1.eq_zero)

end TensorProduct

end
