module

public import Mathlib.NumberTheory.Zsqrtd.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.PicardGroup

@[expose] public section

/-!
# An invertible module that is not free

The Picard group of a commutative ring `R` is trivial as soon as `R` is local, semilocal, or a
unique factorization domain, so a nontrivial example needs a genuinely non-principal invertible
ideal. This file produces one, in every universe.

The base ring is `ℤ[√-5]`, and the invertible module is the class of the ideal `(2, 1 + √-5)`,
viewed as an invertible submodule of the fraction field. That submodule squares to the principal
submodule generated by `2`, hence is invertible, and it is not principal because an element
generating it would have norm dividing `2` -- impossible for norm `2`, and for norm `1` it would
make `(2, 1 + √-5)` the unit ideal, contradicting a parity count on the coordinates.
-/

universe u

open CommRing

namespace Stacks.InvertibleNotFree

/-- The ring `ℤ[√-5]`, in which `(2, 1 + √-5)` is a non-principal invertible ideal. -/
abbrev Quad : Type := ℤ√(-5)

/-- `ℤ[√-5]` has no zero divisors, since the norm is multiplicative and vanishes only at `0`. -/
theorem noZeroDivisors_quad : NoZeroDivisors Quad where
  eq_zero_or_eq_zero_of_mul_eq_zero {a b} h := by
    have h2 : a.norm * b.norm = 0 := by rw [← Zsqrtd.norm_mul, h, Zsqrtd.norm_zero]
    rcases mul_eq_zero.mp h2 with h3 | h3
    · exact Or.inl ((Zsqrtd.norm_eq_zero_iff (by norm_num) a).mp h3)
    · exact Or.inr ((Zsqrtd.norm_eq_zero_iff (by norm_num) b).mp h3)

attribute [local instance] noZeroDivisors_quad

/-- `ℤ[√-5]` is a domain. -/
local instance isDomain_quad : IsDomain Quad := NoZeroDivisors.to_isDomain Quad

/-- The fraction field of `ℤ[√-5]`. -/
abbrev QuadFrac : Type := FractionRing Quad

/-- The element `1 + √-5` of `ℤ[√-5]`. -/
def beta : Quad := 1 + Zsqrtd.sqrtd

/-- The square of `1 + √-5` is `2 * (-2 + √-5)`. -/
theorem beta_sq : beta * beta = 2 * (-2 + Zsqrtd.sqrtd) := by
  simp [beta, Zsqrtd.ext_iff]

/-- `2` is a `ℤ[√-5]`-linear combination of the pairwise products of `2` and `1 + √-5`. -/
theorem two_eq_comb : (2 : Quad) = 2 * beta - beta * beta - 2 * 2 := by
  simp [beta, Zsqrtd.ext_iff]

/-- The product of two elements of the ideal `(2, 1 + √-5)` of `ℤ[√-5]` is `2` times an explicit
element. -/
theorem mul_mem_two_mul (c d e f : Quad) :
    (2 * c + beta * d) * (2 * e + beta * f) =
      2 * (c * (2 * e) + beta * (c * f) + beta * (d * e) + (-2 + Zsqrtd.sqrtd) * (d * f)) := by
  linear_combination (d * f) * beta_sq

/-- The norm of `2` in `ℤ[√-5]` is `4`. -/
theorem norm_two : (2 : Quad).norm = 4 := by simp [Zsqrtd.norm_def]

/-- The norm of `1 + √-5` is `6`. -/
theorem norm_beta : beta.norm = 6 := by simp [beta, Zsqrtd.norm_def]

/-- The image of `2` in the fraction field. -/
noncomputable abbrev gTwo : QuadFrac := algebraMap Quad QuadFrac 2

/-- The image of `1 + √-5` in the fraction field. -/
noncomputable abbrev gBeta : QuadFrac := algebraMap Quad QuadFrac beta

/-- The submodule `(2, 1 + √-5)` of the fraction field of `ℤ[√-5]`. -/
noncomputable def Idl : Submodule Quad QuadFrac := Submodule.span Quad {gTwo, gBeta}

/-- The image of `2` lies in `(2, 1 + √-5)`. -/
theorem gTwo_mem : gTwo ∈ Idl := Submodule.subset_span (by simp)

/-- The image of `1 + √-5` lies in `(2, 1 + √-5)`. -/
theorem gBeta_mem : gBeta ∈ Idl := Submodule.subset_span (by simp)

/-- A combination of the generators of `(2, 1 + √-5)` is the image of the corresponding element. -/
private theorem smul_gTwo_add_smul_gBeta (c d : Quad) :
    c • gTwo + d • gBeta = algebraMap Quad QuadFrac (2 * c + beta * d) := by
  simp only [Algebra.smul_def, map_add, map_mul, mul_comm]

/-- The square of the submodule `(2, 1 + √-5)` is the submodule generated by `2`. -/
theorem mul_self_Idl : Idl * Idl = Submodule.span Quad {gTwo} := by
  refine le_antisymm (Submodule.mul_le.mpr ?_) (Submodule.span_le.mpr ?_)
  · intro m hm n hn
    obtain ⟨c, d, rfl⟩ := Submodule.mem_span_pair.mp hm
    obtain ⟨e, f, rfl⟩ := Submodule.mem_span_pair.mp hn
    rw [smul_gTwo_add_smul_gBeta, smul_gTwo_add_smul_gBeta, ← map_mul, mul_mem_two_mul,
      map_mul]
    exact Submodule.mem_span_singleton.mpr ⟨_, by rw [Algebra.smul_def, mul_comm]⟩
  · rintro _ rfl
    have key : (gTwo : QuadFrac) = gTwo * gBeta - gBeta * gBeta - gTwo * gTwo := by
      simp only [← map_mul, ← map_sub]
      exact congrArg _ two_eq_comb
    rw [SetLike.mem_coe, key]
    exact Submodule.sub_mem _ (Submodule.sub_mem _ (Submodule.mul_mem_mul gTwo_mem gBeta_mem)
      (Submodule.mul_mem_mul gBeta_mem gBeta_mem)) (Submodule.mul_mem_mul gTwo_mem gTwo_mem)

/-- The image of `2` in the fraction field is nonzero. -/
theorem gTwo_ne_zero : (gTwo : QuadFrac) ≠ 0 := by
  rw [Ne, map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective Quad QuadFrac)]
  decide

/-- The submodule `(2, 1 + √-5)` of the fraction field is invertible. -/
theorem isUnit_Idl : IsUnit Idl := by
  have hc : IsUnit (Submodule.span Quad {gTwo} : Submodule Quad QuadFrac) :=
    IsUnit.of_mul_eq_one (Submodule.span Quad {(gTwo : QuadFrac)⁻¹}) <| by
      rw [Submodule.span_mul_span, Set.singleton_mul_singleton,
        mul_inv_cancel₀ gTwo_ne_zero, ← Submodule.one_eq_span]
  obtain ⟨y, hy⟩ := isUnit_iff_exists_inv.mp (mul_self_Idl ▸ hc)
  exact IsUnit.of_mul_eq_one (Idl * y) (by rwa [← mul_assoc])

/-- `(2, 1 + √-5)` as a unit of the monoid of submodules of the fraction field. -/
noncomputable def Idlu : (Submodule Quad QuadFrac)ˣ := isUnit_Idl.unit

/-- The submodule underlying the unit `Idlu` is `(2, 1 + √-5)`. -/
theorem Idlu_coe : (Idlu : Submodule Quad QuadFrac) = Idl := rfl

/-- The norm of `x = a + b√-5` is `a * a + 5 * (b * b)`. -/
theorem norm_eq (x : Quad) : x.norm = x.re * x.re + 5 * (x.im * x.im) := by
  rw [Zsqrtd.norm_def]
  ring

/-- No element of `ℤ[√-5]` has norm `2`. -/
theorem norm_ne_two (x : Quad) : x.norm ≠ 2 := by
  intro h
  rw [norm_eq] at h
  have hx : 0 ≤ x.re * x.re := mul_self_nonneg _
  have hy : 0 ≤ x.im * x.im := mul_self_nonneg _
  have hre : x.re * x.re = 2 := by omega
  obtain ⟨c, hc⟩ := (Int.even_mul.mp (⟨1, by omega⟩ : Even (x.re * x.re))).elim id id
  have hcc : (4 : ℤ) * (c * c) = 2 := by
    rw [hc] at hre
    linear_combination hre
  omega

/-- The submodule `Idl` is the span of the images of `2` and `1 + √-5`. -/
theorem Idl_def : Idl = Submodule.span Quad {gTwo, gBeta} := rfl

/-- The element `beta` is `1 + √-5`. -/
theorem beta_def : beta = 1 + Zsqrtd.sqrtd := rfl

/-- The rational part of `1 + √-5` is `1`. -/
theorem beta_re : beta.re = 1 := by simp [beta_def]

/-- The coefficient of `√-5` in `1 + √-5` is `1`. -/
theorem beta_im : beta.im = 1 := by simp [beta_def]

/-- The submodule `(2, 1 + √-5)` lies in the image of `ℤ[√-5]`. -/
theorem Idl_le_one : Idl ≤ (1 : Submodule Quad QuadFrac) := by
  rw [Idl_def, Submodule.span_le]
  rintro x (rfl | rfl)
  exacts [Submodule.algebraMap_mem 2, Submodule.algebraMap_mem beta]

/-- If a submodule of the fraction field is generated by the image of `x`, every element of
`ℤ[√-5]` whose image lies in it is divisible by `x`. -/
theorem dvd_of_mem {x y : Quad} {a : QuadFrac} (hx : algebraMap Quad QuadFrac x = a)
    (hy : algebraMap Quad QuadFrac y ∈ Submodule.span Quad {a}) : x ∣ y := by
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp hy
  refine ⟨r, FaithfulSMul.algebraMap_injective Quad QuadFrac ?_⟩
  rw [map_mul, hx, mul_comm, ← Algebra.smul_def, hr]

/-- If `x` divides `y` in `ℤ[√-5]`, the norm of `x` divides the norm of `y`. -/
theorem norm_dvd_of_dvd {x y : Quad} (h : x ∣ y) : x.norm ∣ y.norm := by
  obtain ⟨r, rfl⟩ := h
  exact ⟨r.norm, Zsqrtd.norm_mul x r⟩

/-- The invertible submodule `(2, 1 + √-5)` of the fraction field of `ℤ[√-5]` is not free:
it is not principal. -/
theorem not_free_Idl : ¬ Module.Free Quad ↥(Idlu : Submodule Quad QuadFrac) := by
  intro hfree
  obtain ⟨e⟩ := Module.Invertible.free_iff_linearEquiv.mp hfree
  obtain ⟨a, hspan⟩ : ∃ a : QuadFrac, Idl = Submodule.span Quad {a} :=
    ⟨_, Submodule.eq_span_singleton_of_surjective (f := e.symm.toLinearMap) e.symm.surjective⟩
  have hmem : a ∈ Idl := hspan ▸ Submodule.mem_span_singleton_self a
  obtain ⟨al, hal⟩ := Submodule.mem_one.mp (Idl_le_one hmem)
  have hn4 : al.norm ∣ 4 := norm_two ▸ norm_dvd_of_dvd (dvd_of_mem hal (hspan ▸ gTwo_mem))
  have hn6 : al.norm ∣ 6 := norm_beta ▸ norm_dvd_of_dvd (dvd_of_mem hal (hspan ▸ gBeta_mem))
  have hdvd : al.norm ∣ 2 := by
    have h := dvd_sub hn6 hn4
    rwa [show (6 : ℤ) - 4 = 2 by norm_num] at h
  have hnn : 0 ≤ al.norm := Zsqrtd.norm_nonneg (by norm_num) al
  have hle2 : al.norm ≤ 2 := Int.le_of_dvd (by norm_num) hdvd
  have hne0 : al.norm ≠ 0 := by
    intro h
    rw [h, zero_dvd_iff] at hdvd
    exact absurd hdvd (by norm_num)
  have hnorm1 : al.norm = 1 := by
    have := norm_ne_two al
    omega
  obtain ⟨u, v, huv⟩ : ∃ u v : Quad, al = 2 * u + beta * v := by
    obtain ⟨u, v, hv⟩ := Submodule.mem_span_pair.mp (Idl_def ▸ hmem)
    exact ⟨u, v, FaithfulSMul.algebraMap_injective Quad QuadFrac
      (by rw [hal, ← hv, smul_gTwo_add_smul_gBeta])⟩
  obtain ⟨g, hg⟩ :=
    isUnit_iff_exists_inv.mp ((Zsqrtd.norm_eq_one_iff' (by norm_num) al).mp hnorm1)
  have hone : (1 : Quad) = 2 * (u * g) + beta * (v * g) := by
    linear_combination -hg + g * huv
  have h1 := congrArg Zsqrtd.re hone
  have h2 := congrArg Zsqrtd.im hone
  simp only [Zsqrtd.re_mul, Zsqrtd.im_mul, Zsqrtd.re_add, Zsqrtd.im_add, Zsqrtd.re_one,
    Zsqrtd.im_one, Zsqrtd.re_ofNat, Zsqrtd.im_ofNat, beta_re, beta_im, mul_zero, zero_mul,
    add_zero, one_mul, mul_one] at h1 h2
  omega

/-- The class of `(2, 1 + √-5)` in the Picard group of `ℤ[√-5]`. -/
noncomputable def picClass : Pic Quad := Pic.mk Quad ↥(Idlu : Submodule Quad QuadFrac)

/-- The class of `(2, 1 + √-5)` in the Picard group of `ℤ[√-5]` is nontrivial. -/
theorem picClass_ne_one : picClass ≠ 1 := fun h =>
  not_free_Idl (Pic.mk_eq_one_iff_free.mp h)

/-- The base commutative ring: a copy of `ℤ[√-5]` in an arbitrary universe. -/
def Base : Type u := ULift.{u} Quad

/-- The commutative ring structure on `Base`, transported from `ℤ[√-5]`. -/
instance : CommRing Base.{u} := inferInstanceAs (CommRing (ULift Quad))

/-- The universe-lifting ring isomorphism `ℤ[√-5] ≃+* Base`. -/
noncomputable def baseEquiv : Quad ≃+* Base.{u} := ULift.ringEquiv.symm

/-- The class of `(2, 1 + √-5)` transported to the Picard group of `Base`. -/
noncomputable def basePicClass : Pic Base.{u} :=
  Pic.mapRingHom (baseEquiv.{u} : Quad →+* Base.{u}) picClass

/-- The witness module: an invertible `Base`-module that is not free. -/
def Witness : Type u := Pic.AsModule basePicClass.{u}

/-- The additive group structure on `Witness`, that of `Pic.AsModule basePicClass`. -/
noncomputable instance : AddCommGroup Witness.{u} :=
  inferInstanceAs (AddCommGroup (Pic.AsModule basePicClass.{u}))

/-- The `Base`-module structure on `Witness`, that of `Pic.AsModule basePicClass`. -/
noncomputable instance : Module Base.{u} Witness.{u} :=
  inferInstanceAs (Module Base.{u} (Pic.AsModule basePicClass.{u}))

/-- The `Base`-module `Witness` is invertible. -/
instance : Module.Invertible Base.{u} Witness.{u} :=
  inferInstanceAs (Module.Invertible Base.{u} (Pic.AsModule basePicClass.{u}))

/-- The invertible `Base`-module `Witness` is not free. -/
theorem not_free : ¬ Module.Free Base.{u} Witness.{u} := by
  intro hf
  refine picClass_ne_one ?_
  have h3 : basePicClass.{u} = 1 := by
    rw [← (Pic.mk_eq_self : Pic.mk Base.{u} (Pic.AsModule basePicClass.{u}) = basePicClass.{u})]
    exact Pic.mk_eq_one_iff_free.mpr hf
  have h4 : Pic.mapRingHom (baseEquiv.{u}.symm : Base.{u} →+* Quad) basePicClass.{u}
      = picClass := by
    rw [basePicClass, Pic.mapRingHom_mapRingHom,
      show (baseEquiv.{u}.symm : Base.{u} →+* Quad).comp (baseEquiv.{u} : Quad →+* Base.{u})
          = RingHom.id Quad from RingHom.ext fun x => baseEquiv.{u}.symm_apply_apply x]
    exact Pic.mapRingHom_id_apply
  rw [← h4, h3, map_one]

end Stacks.InvertibleNotFree
