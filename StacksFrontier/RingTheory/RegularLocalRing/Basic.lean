@[expose] public section

universe u

/-!
# The associated graded ring of a regular local ring is a polynomial algebra

Proof of `IsRegularLocalRing.isQuasiRegular` (Stacks 00NO): if `(R, 𝔪, κ)` is a regular local ring
and `xs = x_1, …, x_d` generates `𝔪` with `d` the minimal number of generators of `𝔪`, then `xs` is
a quasi-regular sequence, that is, the canonical map of graded `κ[X_1, …, X_d]`-modules
`κ[X_1, …, X_d] ⊗_κ (R/𝔪) → ⨁_{n ≥ 0} 𝔪^n/𝔪^{n+1}` of [StacksProject 061N] is bijective.
Equivalently, the graded ring `⨁_{n ≥ 0} 𝔪^n/𝔪^{n+1}` is the graded polynomial algebra
`κ[X_1, …, X_d]`.

The route is through regular sequences rather than through Hilbert functions. A minimal generating
sequence of the maximal ideal of a regular local ring is a regular sequence
(`isRegular_of_ofList_eq_maximalIdeal`, Stacks 00NQ): by induction on the length, the first element
`x_1` is a nonzerodivisor since a regular local ring is a domain and `x_1 ≠ 0`, while `R/(x_1)` is
again regular local with maximal ideal minimally generated by the images of `x_2, …, x_d`. A
regular sequence is quasi-regular in the elementary degreewise sense — a relation
`∑_{|e| = n} x^e a_e ∈ 𝔪^{n+1}` forces `a_e ∈ 𝔪` — which is
`Stacks.QuasiregularSequence.isRegular_isQuasiregularSeq_self` (Stacks 00LN), and that elementary
condition is exactly injectivity of the canonical map (`isQuasiRegular_of_isQuasiregularSeq`), the
map being always surjective.

## Main results

* `Stacks.RegularLocalRing.QuasiRegular.solution`: the statement of
  `IsRegularLocalRing.isQuasiRegular`, Lemma 00NO.

## Implementation notes

The source's proof reads off the degree of the numerical polynomial
`n ↦ dim_κ 𝔪^n/𝔪^{n+1}` from `d(R) = d` (Stacks 00KQ) and concludes with Stacks 00K3, that a
proper graded quotient of `κ[X_1, …, X_d]` has Hilbert polynomial of degree `< d - 1`. That route
is not taken here. The two arguments prove the same statement; the source itself derives
quasi-regularity of a minimal generating sequence from 00NQ in the same way elsewhere.

The general facts used here are in Mathlib in neither this form nor a form to specialise, so they
are proved as `private` helpers in this file.

* `isQuasiRegular_of_isQuasiregularSeq` — that the elementary degreewise condition
  `Stacks.QuasiregularSequence.IsQuasiregularSeq` implies `RingTheory.Sequence.IsQuasiRegular`,
  i.e. bijectivity of `quasiRegularCanonicalMap`. Together with
  `Stacks.QuasiregularSequence.isRegular_isQuasiregularSeq_self` this is Stacks 00LN(1) in the
  shape of tag 061P. Two facts carry it. First, the source `(R/J)[X] ⊗_{R/J} (M/JM)` is the free
  `M/JM`-module on multi-indices (`srcFinsuppEquiv`), so every element of it is a finite sum of
  monomials `X^e ⊗ s̄_e` (`exists_sum_srcMono`) and vanishes as soon as every coefficient lies in
  `JM`. Second, the degree-`n` component of the image of such a sum is the class of
  `∑_{|e| = n} f^e s_e` in `J^n M / J^{n+1} M` (`component_map_sum_srcMono_eq_zero_iff`), which
  turns the vanishing of the image into one degreewise relation for each `n`.
* `isRegular_of_ofList_eq_maximalIdeal` — Stacks 00NQ's regular-sequence clause, proved with
  `isDomain_of_isRegularLocalRing_aux`, which proves Stacks 00NP without 00NO, so nothing is
  circular. Its inductive step is
  `isRegularLocalRing_quotient_span_singleton_of_minimal_cons`: minimality of `x_1, …, x_d` is used
  twice there, once for `x_1 ≠ 0` and once, through the dimension drop, for minimality of the
  images of `x_2, …, x_d` in `R/(x_1)`.
* `isRegular_cons_iff_quotient_span_singleton` — Mathlib's `isRegular_cons_iff'` with the module
  quotient `QuotSMulTop x R` replaced by the ring quotient `R ⧸ (x)`, which is what an induction
  over rings needs, and `ringKrullDim_quotient_span_singleton_of_eq_succ` — the dimension drop of
  Krull's principal ideal theorem read in `ℕ` rather than in `WithBot ℕ∞`.

## References

* [StacksProject 00NO](https://stacks.math.columbia.edu/tag/00NO)
* [StacksProject 061P](https://stacks.math.columbia.edu/tag/061P), for quasi-regular sequences
* [StacksProject 00NQ](https://stacks.math.columbia.edu/tag/00NQ), for the regular sequence
* [StacksProject 00LN](https://stacks.math.columbia.edu/tag/00LN), regular implies quasi-regular
-/


namespace Stacks.RegularLocalRing.QuasiRegular

open IsLocalRing RingTheory.Sequence



/-! ## From the degreewise relation condition to injectivity of the canonical map -/

section Bridge

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {c : ℕ}

/-- **Every element of the source is a finite sum of monomials.** Writing an element in the
monomial basis and lifting its coefficients from `M/JM` to `M` presents it as
`∑_{e ∈ T} X^e ⊗ s̄_e` for a finite set `T` of multi-indices. -/
private theorem exists_sum_srcMono (f : Fin c → R) (x : Source M f) :
    ∃ (T : Finset (Fin c →₀ ℕ)) (s : (Fin c →₀ ℕ) → M), x = ∑ e ∈ T, srcMono f e (s e) := by
  classical
  set t := srcFinsuppEquiv M f x with ht
  choose s hs using fun e : Fin c →₀ ℕ =>
    Submodule.Quotient.mk_surjective (Jid f • (⊤ : Submodule R M)) (t e)
  refine ⟨t.support, s, (srcFinsuppEquiv M f).injective ?_⟩
  rw [← ht, map_sum, Finset.sum_congr rfl fun e _ => srcFinsuppEquiv_srcMono f e (s e)]
  simp only [hs]
  exact (Finsupp.sum_single t).symm

/-- A monomial whose coefficient lies in `JM` vanishes in the source, its coefficient being taken
in `M/JM`. -/
private theorem srcMono_eq_zero_of_mem_smul_top (f : Fin c → R) (e : Fin c →₀ ℕ) {m : M}
    (hm : m ∈ Jid f • (⊤ : Submodule R M)) : srcMono f e m = 0 := by
  rw [srcMono, show (Submodule.Quotient.mk m : qrMbar M f) = 0 from
    (Submodule.Quotient.mk_eq_zero _).mpr hm, TensorProduct.tmul_zero]

/-- The monomial image `f^e · m mod J^{|e|+1}M` lives in the degree-`|e|` summand of the target. -/
private theorem imgTargetLin_eq_lof (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) (n : ℕ)
    (h : qrMdeg e = n) (hm : fpow f e • m ∈ JpowM M f n) :
    imgTargetLin f e m = DirectSum.lof R ℕ (fun k => Tcomp M f k) n
      ((Tsub M f n).mkQ ⟨fpow f e • m, hm⟩) := by
  subst h; rfl

/-- **The degree-`n` part of the canonical map, on a homogeneous family of monomials.** The `n`-th
component of a finite sum of monomial images `f^e · s_e`, all of total degree `n`, is the class of
`∑_e f^e · s_e ∈ J^n M` in `J^n M / J^{n+1} M`. -/
private theorem component_sum_imgTargetLin (f : Fin c → R) (T : Finset (Fin c →₀ ℕ))
    (s : (Fin c →₀ ℕ) → M) (n : ℕ) (hdeg : ∀ e ∈ T, qrMdeg e = n) :
    DirectSum.component R ℕ (fun k => Tcomp M f k) n (∑ e ∈ T, imgTargetLin f e (s e))
      = (Tsub M f n).mkQ ⟨∑ e ∈ T, fpow f e • s e,
          Submodule.sum_mem _ fun e he => hdeg e he ▸ fpow_smul_mem f e (s e)⟩ := by
  classical
  have hmem : ∀ e : {e // e ∈ T}, fpow f e.1 • s e.1 ∈ JpowM M f n :=
    fun e => hdeg e.1 e.2 ▸ fpow_smul_mem f e.1 (s e.1)
  rw [← Finset.sum_attach T fun e => imgTargetLin f e (s e),
    Finset.sum_congr rfl fun e _ =>
      imgTargetLin_eq_lof f e.1 (s e.1) n (hdeg e.1 e.2) (hmem e), ← map_sum, ← map_sum,
    DirectSum.component.lof_self]
  refine congrArg _ (Subtype.ext ?_)
  rw [AddSubmonoidClass.coe_finsetSum]
  simpa using Finset.sum_attach T fun e => fpow f e • s e

/-- **The degreewise relation read off the canonical map.** The image of a monomial expansion
`∑_{e ∈ T} X^e ⊗ s̄_e` has vanishing degree-`n` component exactly when the degree-`n` part of the
expansion, `∑_{|e| = n} f^e · s_e`, lies in `J^{n+1}M`: monomials of other degrees contribute to
other summands of the target, and the degree-`n` summand is `J^n M / J^{n+1} M`. -/
private theorem component_map_sum_srcMono_eq_zero_iff (f : Fin c → R) (T : Finset (Fin c →₀ ℕ))
    (s : (Fin c →₀ ℕ) → M) (n : ℕ) :
    DirectSum.component R ℕ (fun k => Tcomp M f k)
        n (quasiRegularCanonicalMap f (∑ e ∈ T, srcMono f e (s e))) = 0 ↔
      (∑ e ∈ T.filter fun e => qrMdeg e = n, fpow f e • s e) ∈ JpowM M f (n + 1) := by
  classical
  have hother : DirectSum.component R ℕ (fun k => Tcomp M f k)
      n (∑ e ∈ T.filter fun e => ¬ qrMdeg e = n, imgTargetLin f e (s e)) = 0 := by
    rw [map_sum]
    exact Finset.sum_eq_zero fun e he =>
      component_imgTargetLin_of_ne f e (s e) (Finset.mem_filter.mp he).2
  rw [map_sum, Finset.sum_congr rfl fun e _ => canonicalMap_srcMono f e (s e),
    ← Finset.sum_filter_add_sum_filter_not T (fun e => qrMdeg e = n), map_add, hother, add_zero,
    component_sum_imgTargetLin f _ s n fun e he => (Finset.mem_filter.mp he).2,
    mkQ_Tsub_eq_zero_iff]

end Bridge

/-! ## The two spellings of quasi-regularity agree -/

section Spellings

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- `f^e` for `f = (rs[0], …, rs[c-1])` is the list power `rs^I` at the corresponding tuple. -/
private theorem listPow_eq_fpow (rs : List R) (e : Fin rs.length →₀ ℕ) :
    Stacks.QuasiregularSequence.listPow rs (Finsupp.equivFunOnFinite e)
      = fpow (fun i : Fin rs.length => rs[i]) e :=
  rfl

/-- The ideal generated by the sequence `(rs[0], …, rs[c-1])` is the ideal generated by `rs`. -/
private theorem Jid_eq_ofList (rs : List R) :
    Jid (fun i : Fin rs.length => rs[i]) = Ideal.ofList rs :=
  (Stacks.QuasiregularSequence.ofList_eq_span_range rs).symm

/-- **The degreewise relation condition, reindexed by multi-indices.** `IsQuasiregularSeq` speaks
of the family of *all* tuples of total degree `n`; the same conclusion holds for a family indexed
by an arbitrary finite set `T` of `Finsupp` multi-indices of total degree `n`, extending it by zero
to the full degree-`n` antidiagonal. -/
private theorem mem_smul_top_of_isQuasiregularSeq {rs : List R}
    (h : Stacks.QuasiregularSequence.IsQuasiregularSeq rs M) (n : ℕ) (T : Finset (Fin rs.length →₀
      ℕ))
    (s : (Fin rs.length →₀ ℕ) → M) (hdeg : ∀ e ∈ T, qrMdeg e = n)
    (hrel : (∑ e ∈ T, fpow (fun i : Fin rs.length => rs[i]) e • s e)
      ∈ JpowM M (fun i : Fin rs.length => rs[i]) (n + 1)) :
    ∀ e ∈ T, s e ∈ Jid (fun i : Fin rs.length => rs[i]) • (⊤ : Submodule R M) := by
  classical
  intro e he
  set φ : (Fin rs.length →₀ ℕ) → (Fin rs.length → ℕ) :=
    fun e => Finsupp.equivFunOnFinite e with hφ
  set m : (Fin rs.length → ℕ) → M := fun I =>
    if Finsupp.equivFunOnFinite.symm I ∈ T then s (Finsupp.equivFunOnFinite.symm I) else 0 with hm
  have hmφ : ∀ e' ∈ T, m (φ e') = s e' := fun e' he' => by simp [hm, hφ, he']
  have hsub : T.image φ ⊆ Finset.Nat.antidiagonalTuple rs.length n := fun I hI => by
    obtain ⟨e', he', rfl⟩ := Finset.mem_image.mp hI
    exact Finset.Nat.mem_antidiagonalTuple.mpr (hdeg e' he')
  have hzero : ∀ I ∈ Finset.Nat.antidiagonalTuple rs.length n, I ∉ T.image φ →
      Stacks.QuasiregularSequence.listPow rs I • m I = 0 := fun I _ hI => by
    have hnot : Finsupp.equivFunOnFinite.symm I ∉ T := fun hmem =>
      hI (Finset.mem_image.mpr ⟨_, hmem, by simp [hφ]⟩)
    simp [hm, hnot]
  have hsumeq : (∑ I ∈ Finset.Nat.antidiagonalTuple rs.length n, Stacks.QuasiregularSequence.listPow
    rs I • m I)
      = ∑ e' ∈ T, fpow (fun i : Fin rs.length => rs[i]) e' • s e' := by
    rw [← Finset.sum_subset hsub hzero,
      Finset.sum_image fun a _ b _ hab => Finsupp.equivFunOnFinite.injective hab]
    exact Finset.sum_congr rfl fun e' he' => by rw [hmφ e' he', listPow_eq_fpow]
  rw [Jid_eq_ofList rs, ← hmφ e he]
  refine h n m ?_ (φ e) (Finset.Nat.mem_antidiagonalTuple.mpr (hdeg e he))
  rw [hsumeq, ← Jid_eq_ofList rs]
  exact hrel

/-- **Stacks 00LN, in the shape of tag 061P.** The elementary degreewise formulation of
quasi-regularity — a relation `∑_{|I| = n} rs^I m_I ∈ J^{n+1}M` forces `m_I ∈ JM` — implies that
the canonical map of tag 061N is bijective, that is, `rs` is `M`-quasi-regular. -/
private theorem isQuasiRegular_of_isQuasiregularSeq (rs : List R)
    (h : Stacks.QuasiregularSequence.IsQuasiregularSeq rs M) : IsQuasiRegular M rs :=
  ⟨injective_of_mem_of_sum_fpow_smul_mem fun n T s hdeg hrel =>
    mem_smul_top_of_isQuasiregularSeq h n T s hdeg hrel,
   quasiRegularCanonicalMap_surjective _⟩

end Spellings

/-! ## A minimal set of generators of the maximal ideal is a regular sequence -/

section RegularSequence

open scoped Pointwise

variable {R : Type*} [CommRing R]

/-- The ideal generated by a list is generated by at most `length` elements. -/
public lemma spanFinrank_ofList_le (l : List R) :
    (Ideal.ofList l).spanFinrank ≤ l.length := by
  classical
  rw [show (Ideal.ofList l) = Submodule.span R (↑l.toFinset : Set R) by simp [Ideal.ofList]]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
  rw [Set.ncard_coe_finset]
  exact List.toFinset_card_le l

/-- Cancelling `+ 1` in `WithBot ℕ∞` against a natural number: neither `⊥` nor `⊤` survives, so the
cancellation happens in `ℕ`. -/
private lemma eq_natCast_of_add_one_eq {a : WithBot ℕ∞} {n : ℕ}
    (h : a + 1 = (n : WithBot ℕ∞) + 1) : a = (n : WithBot ℕ∞) := by
  have hcast : ((n : WithBot ℕ∞)) = (((n : ℕ∞)) : WithBot ℕ∞) := rfl
  induction a using WithBot.recBotCoe with
  | bot =>
    rw [WithBot.bot_add] at h
    exact absurd (by rw [h, hcast, ← WithBot.coe_one, ← WithBot.coe_add] :
      (⊥ : WithBot ℕ∞) = ((n : ℕ∞) + 1 : ℕ∞)) WithBot.bot_ne_coe
  | coe b =>
    rw [hcast, ← WithBot.coe_one, ← WithBot.coe_add, ← WithBot.coe_add, WithBot.coe_inj] at h
    rw [hcast, WithBot.coe_inj]
    induction b using ENat.recTopCoe with
    | top =>
      exact absurd (by push_cast; exact h.symm : ((n + 1 : ℕ) : ℕ∞) = ⊤) (ENat.natCast_ne_top _)
    | coe k =>
      rw [← Nat.cast_one, ← Nat.cast_add, ← Nat.cast_add, Nat.cast_inj] at h
      rw [Nat.cast_inj]
      omega

/-- **The dimension drop in natural-number form.** Killing a nonzerodivisor in the maximal ideal of
a Noetherian local ring of Krull dimension `n + 1` leaves Krull dimension exactly `n`. -/
private lemma ringKrullDim_quotient_span_singleton_of_eq_succ [IsNoetherianRing R] [IsLocalRing R]
    {x : R} (hx : IsSMulRegular R x) (hxm : x ∈ maximalIdeal R) {n : ℕ}
    (hdim : ringKrullDim R = (n : WithBot ℕ∞) + 1) :
    ringKrullDim (R ⧸ Ideal.span {x}) = (n : WithBot ℕ∞) :=
  eq_natCast_of_add_one_eq
    ((ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim hx hxm).trans hdim)

/-- The images of a generating list of the maximal ideal generate the maximal ideal of a proper
quotient. -/
private lemma ofList_map_quotient_mk_eq_maximalIdeal [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] {xs : List R} (hxs : Ideal.ofList xs = maximalIdeal R) :
    Ideal.ofList (xs.map (Ideal.Quotient.mk I)) = maximalIdeal (R ⧸ I) := by
  rw [← Ideal.map_ofList, hxs,
    IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]

/-- The images of `rest` alone generate the maximal ideal of `R ⧸ (x)` when `x :: rest` generates
the maximal ideal of `R`: the first generator becomes `0`. -/
private lemma ofList_map_quotient_mk_eq_maximalIdeal_of_cons [IsLocalRing R] {x : R}
    {rest : List R} [IsLocalRing (R ⧸ Ideal.span {x})]
    (hgen : Ideal.ofList (x :: rest) = maximalIdeal R) :
    Ideal.ofList (rest.map (Ideal.Quotient.mk (Ideal.span {x})))
      = maximalIdeal (R ⧸ Ideal.span {x}) := by
  rw [← ofList_map_quotient_mk_eq_maximalIdeal (Ideal.span {x}) hgen, List.map_cons,
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x),
    Stacks.QuasiregularSequence.ofList_cons_sup, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq]

/-- `x :: rs` is a regular sequence on `R` if and only if `x` is a nonzerodivisor and the images of
`rs` form a regular sequence on the ring `R ⧸ (x)`. This is Mathlib's
`RingTheory.Sequence.isRegular_cons_iff'` with `QuotSMulTop x R` replaced by `R ⧸ (x)`. -/
private lemma isRegular_cons_iff_quotient_span_singleton (x : R) (rs : List R) :
    IsRegular R (x :: rs) ↔ IsSMulRegular R x ∧
      IsRegular (R ⧸ Ideal.span {x}) (rs.map (Ideal.Quotient.mk (Ideal.span {x}))) := by
  let e : (R ⧸ Ideal.span {x}) ≃ₗ[R] QuotSMulTop x R :=
    Submodule.quotEquivOfEq _ _ (smul_top_eq_span_singleton x).symm
  rw [isRegular_cons_iff, AddEquiv.isRegular_congr (e := e.toAddEquiv)
    (List.forall₂_map_left_iff.mpr (List.forall₂_same.mpr fun r _ y => by
      change e ((Ideal.Quotient.mk (Ideal.span {x}) r) • y) = r • e y
      rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul, map_smul]))]

/-- **The inductive step of Stacks 00NQ.** Let `x :: rest` be a minimal generating list of the
maximal ideal of a regular local ring: then `x` is a nonzerodivisor, `R ⧸ (x)` is again a regular
local ring, and its maximal ideal has exactly `rest.length` as its minimal number of generators, so
that the images of `rest` are again a minimal generating list. Minimality of `x :: rest` enters
twice: `x ≠ 0`, because `rest` alone would otherwise generate the maximal ideal with one element
too few, and the generator count of `R ⧸ (x)`, through the dimension drop. -/
private theorem isRegularLocalRing_quotient_span_singleton_of_minimal_cons [IsRegularLocalRing R]
    {x : R} {rest : List R} (hgen : Ideal.ofList (x :: rest) = maximalIdeal R)
    (hmin : (x :: rest).length = (maximalIdeal R).spanFinrank)
    [IsLocalRing (R ⧸ Ideal.span {x})] :
    IsSMulRegular R x ∧ IsRegularLocalRing (R ⧸ Ideal.span {x}) ∧
      (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank = rest.length := by
  have hx : x ∈ maximalIdeal R := hgen ▸ Ideal.subset_span (by simp)
  have hspanR : (maximalIdeal R).spanFinrank = rest.length + 1 := by simpa using hmin.symm
  have hxne : x ≠ 0 := fun h0 => by
    have hgen' : Ideal.ofList rest = maximalIdeal R := by rw [← hgen, h0]; simp
    have hle : (maximalIdeal R).spanFinrank ≤ rest.length := by
      rw [← hgen']; exact spanFinrank_ofList_le rest
    omega
  have : IsDomain R := isDomain_of_isRegularLocalRing_aux (Submodule.spanFinrank (maximalIdeal R)) R
    (IsRegularLocalRing.spanFinrank_maximalIdeal).symm
  have hreg : IsSMulRegular R x := IsSMulRegular.of_ne_zero hxne
  have hdimS : ringKrullDim (R ⧸ Ideal.span {x}) = (rest.length : WithBot ℕ∞) :=
    ringKrullDim_quotient_span_singleton_of_eq_succ hreg hx (by
      rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, hspanR, Nat.cast_add_one])
  have hfrS : (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank ≤ rest.length := by
    rw [← ofList_map_quotient_mk_eq_maximalIdeal_of_cons hgen]
    exact (spanFinrank_ofList_le _).trans_eq (by simp)
  have : IsRegularLocalRing (R ⧸ Ideal.span {x}) :=
    IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ (by rw [hdimS]; exact_mod_cast hfrS)
  refine ⟨hreg, ‹_›, ?_⟩
  have hd := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ Ideal.span {x})
  rw [hdimS] at hd
  exact_mod_cast hd

/-- **A minimal set of generators of the maximal ideal of a regular local ring is a regular
sequence** (Stacks 00NQ). Induction on the length, over all regular local rings at once, with
`isRegularLocalRing_quotient_span_singleton_of_minimal_cons` as the step. -/
@[ega "0 17.1.4" "more general",
  ega "IV 16.9.12" "necessity",
  ega "IV 19.7.2" "(i), special case",
  ega "IV 19.7.3" "partial", sga "4½ Cycle 2.2.1" "special case"]
private theorem isRegular_of_ofList_eq_maximalIdeal (n : ℕ) :
    ∀ {R : Type u} [CommRing R] [IsRegularLocalRing R] (xs : List R), xs.length = n →
      Ideal.ofList xs = maximalIdeal R → xs.length = (maximalIdeal R).spanFinrank →
      IsRegular R xs := by
  induction n with
  | zero =>
    intro R _ _ xs hlen _ _
    rw [List.length_eq_zero_iff] at hlen
    subst hlen
    exact IsRegular.nil R R
  | succ n ih =>
    intro R _ _ xs hlen hgen hmin
    match xs with
    | [] => simp at hlen
    | x :: rest =>
    have hx : x ∈ maximalIdeal R := hgen ▸ Ideal.subset_span (by simp)
    have : IsLocalRing (R ⧸ Ideal.span {x}) := by
      have : Nontrivial (R ⧸ Ideal.span {x}) := Submodule.Quotient.nontrivial_iff.mpr fun h =>
        (maximalIdeal.isMaximal R).ne_top
          (top_le_iff.mp (h ▸ Ideal.span_le.mpr (by simpa using hx)))
      exact IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
    obtain ⟨hreg, _, hfr⟩ :=
      isRegularLocalRing_quotient_span_singleton_of_minimal_cons hgen hmin
    exact (isRegular_cons_iff_quotient_span_singleton x rest).mpr
      ⟨hreg, ih _ (by simpa using hlen) (ofList_map_quotient_mk_eq_maximalIdeal_of_cons hgen)
        (by simp [hfr])⟩

end RegularSequence

/-! ## The lemma -/

/-- **Stacks 00NO**: a list generating the maximal ideal of a regular local ring, of the minimal
length `(𝔪).spanFinrank`, is a quasi-regular sequence. -/
public theorem solution {R : Type*} [CommRing R] [IsRegularLocalRing R]
    (xs : List R) (hxs : Ideal.ofList xs = maximalIdeal R)
    (hmin : xs.length = (maximalIdeal R).spanFinrank) :
    RingTheory.Sequence.IsQuasiRegular R xs :=
  isQuasiRegular_of_isQuasiregularSeq xs
    (Stacks.QuasiregularSequence.isRegular_isQuasiregularSeq_self xs
      (isRegular_of_ofList_eq_maximalIdeal xs.length xs rfl hxs hmin))

end Stacks.RegularLocalRing.QuasiRegular

open Stacks.RegularLocalRing.QuasiRegular (spanFinrank_ofList_le)

/-!
# The associated graded ring of a regular local ring is a polynomial algebra

Let `(R, m, κ)` be a regular local ring of dimension `d` and let `x_1, …, x_d` be a minimal set
of generators of `m`. Then the graded ring `⨁_{n ≥ 0} m^n / m^(n + 1)` is the graded polynomial
algebra `κ[X_1, …, X_d]`: the canonical graded surjection sending `X_i` to the class of `x_i` in
`m/m^2` is an isomorphism. Equivalently, `x_1, …, x_d` is a quasi-regular sequence.

## Main results

* `IsRegularLocalRing.isQuasiRegular`: a minimal set of generators `x_1, …, x_d` of the maximal
  ideal of a regular local ring is a quasi-regular sequence, that is, the canonical map of graded
  `κ[X_1, …, X_d]`-modules `κ[X_1, …, X_d] ⊗_κ (R/m) → ⨁_{n ≥ 0} m^n/m^(n + 1)` determined by
  `X^e ⊗ 1 ↦ x^e mod m^(|e| + 1)` is bijective.

## Implementation notes

The conclusion is `RingTheory.Sequence.IsQuasiRegular R xs` [StacksProject 061P], bijectivity of
the canonical map `quasiRegularCanonicalMap` of [StacksProject 061N], rather than the existence of
a graded ring isomorphism `⨁_{n ≥ 0} m^n/m^(n + 1) ≅ κ[X_1, …, X_d]`. The two say the same thing.
The canonical map is a homomorphism of graded `κ[X_1, …, X_d]`-modules out of the free module of
rank one `κ[X_1, …, X_d] ⊗_κ (R/m)`, sending `1 ⊗ 1` to the class of `1` in `m^0/m^1`, and the
`κ[X_1, …, X_d]`-action on the target is multiplication by the classes of the `x_i` in `m/m^2`,
which for the module `R` is the multiplication of the graded ring `⨁_{n ≥ 0} m^n/m^(n + 1)`; so
the map is bijective exactly when the source's graded ring surjection `κ[X_1, …, X_d] → ⨁_{n ≥ 0}
m^n/m^(n + 1)`, `X_i ↦ x_i mod m^2`, is an isomorphism. Two reasons to prefer this form: the
direct sum `⨁_{n ≥ 0} m^n/m^(n + 1)` carries no ring structure in Mathlib, while both graded
objects and the map between them are already named in this library; and an unnamed isomorphism
would not pin the source's map, whereas naming it is the content of the lemma.

The source of the canonical map is `κ[X_1, …, X_d] ⊗_κ (R/m)`, which is the source's
`κ[X_1, …, X_d]` under the canonical identification `R/m = κ` and `V ⊗_κ κ = V`; nothing else
distinguishes the two.

The source's `d` is `xs.length`, and its "minimal set of generators" is
`xs.length = (maximalIdeal R).spanFinrank`, the hypothesis `hmin`: a generating list of length the
minimal number of generators. By `IsRegularLocalRing.spanFinrank_maximalIdeal` this common value
is `ringKrullDim R`, so the polynomial algebra really has `dim R` variables, as in the source.
The list, rather than a family `Fin d → R`, is the shape of `RingTheory.Sequence.IsRegular` and of
`IsQuasiRegular`, so that the comparison of regular and quasi-regular sequences speaks of one and
the same object; it is also the shape used for a minimal set of generators in [StacksProject 00NQ].

The statement is proved for one fixed regular local ring and every minimal generating list of its
maximal ideal, which is the strongest reading of the source's "let `x_1, …, x_d` be a minimal set
of generators"; there is nothing further to generalize, since quasi-regularity of a generating
sequence of `m` characterises regularity among Noetherian local rings.

Faithfulness. (1) No hypothesis is dead. Dropping `hmin` makes the statement false: for `R` a
field and `xs = [0]` one has `Ideal.ofList xs = ⊥ = m`, while the canonical map `κ[X] → κ` is not
injective. Dropping `[IsRegularLocalRing R]` makes it false: for `R = k[t]/(t^2)` and `xs = [t]`
both `hxs` and `hmin` hold, but `m^2/m^3 = 0` receives `X^2 ≠ 0`. Dropping `hxs` makes it false:
in a discrete valuation ring `xs = [0]` satisfies `hmin` (both sides are `1`) while the canonical
map `R[X] → R` is not injective. (2) The base is the source's: the ring is `R` itself,
with no localization or completion intervening, and the canonical map is `κ`-linear — indeed
`κ[X_1, …, X_d]`-linear — for `κ = R/m` the residue field, not `R`-linear, exactly as the graded
objects of the source are graded `κ`-algebras. (3) The source names the surjection
`κ[X_1, …, X_d] → ⨁ m^n/m^(n + 1)`, `X_i ↦ x_i mod m^2`, and the statement pins it:
quasi-regularity is a property of the named map `quasiRegularCanonicalMap`, whose value on a
monomial is `X^e ⊗ m̄ ↦ x^e m mod m^(|e| + 1)`; existence of some isomorphism is not asserted. (4)
The instantiation is not degenerate: for a discrete valuation ring with uniformizer `t` and
`xs = [t]` the conclusion is `κ[X] ≅ ⨁ (t^n)/(t^(n + 1))`, and for `R` the localization of
`k[X_1, …, X_d]` at the origin with `xs = [X_1, …, X_d]` it is the polynomial algebra in `d`
variables, for every `d`; so the hypotheses hold with `d` arbitrary and not only on fields.

## References

* [StacksProject 00NO](https://stacks.math.columbia.edu/tag/00NO)
* [StacksProject 061P](https://stacks.math.columbia.edu/tag/061P), for quasi-regular sequences
-/

open IsLocalRing

/-- **Stacks 00NO.** Let `(R, m, κ)` be a regular local ring of dimension `d` and let
`xs = x_1, …, x_d` be a minimal set of generators of `m`, that is, a list generating `m` whose
length is the minimal number of generators of `m` (which equals `dim R`). Then `xs` is a
quasi-regular sequence: the canonical map of graded `κ[X_1, …, X_d]`-modules
`κ[X_1, …, X_d] ⊗_κ (R/m) → ⨁_{n ≥ 0} m^n/m^(n + 1)`, `X^e ⊗ 1 ↦ x^e mod m^(|e| + 1)`, is
bijective. Equivalently, the graded ring `⨁_{n ≥ 0} m^n/m^(n + 1)` is the graded polynomial
algebra `κ[X_1, …, X_d]` over the residue field. -/
@[stacks 00NO "Stated as quasi-regularity (Tag 061P) of a minimal generating sequence of the \
maximal ideal, which is exactly the assertion that the source's graded surjection \
`κ[X_1, …, X_d] → ⨁ m^n/m^(n+1)`, `X_i ↦ x_i mod m^2`, is an isomorphism. See the module \
docstring."]
public theorem IsRegularLocalRing.isQuasiRegular {R : Type*} [CommRing R] [IsRegularLocalRing R]
    (xs : List R) (hxs : Ideal.ofList xs = maximalIdeal R)
    (hmin : xs.length = (maximalIdeal R).spanFinrank) :
    RingTheory.Sequence.IsQuasiRegular R xs :=
  Stacks.RegularLocalRing.QuasiRegular.solution xs hxs hmin

/-!
# A regular local ring is a domain

Proof of `IsRegularLocalRing.isDomain` (Stacks 00NP): a Noetherian local ring `(R, 𝔪)` whose
maximal ideal is generated by `dim R` elements has no zero divisors.

The argument is the source's. Fix a minimal set of generators `x_1, …, x_d` of `𝔪`; by Stacks
00NO it is a quasi-regular sequence, and what the proof then needs is a statement about an
arbitrary quasi-regular sequence `f_1, …, f_c` generating an ideal `J` with `R/J` a domain: an
element of `J^a ∖ J^(a+1)` times an element of `J^b ∖ J^(b+1)` never lies in `J^(a+b+1)`
(`mul_notMem_pow_add_succ`). Indeed such elements are the values `P(f)`, `Q(f)` of homogeneous
polynomials over `R` of degrees `a`, `b`, so `P Q` is homogeneous of degree `a + b`; were its
value in `J^(a+b+1)`, quasi-regularity would force every coefficient of `P Q` into `J`, that is,
the image of `P Q` in `(R/J)[X_1, …, X_c]` would vanish. That ring is a domain, so already `P` or
`Q` has all coefficients in `J`, and evaluating puts `P(f)` in `J · J^a = J^(a+1)` or `Q(f)` in
`J^(b+1)`. Here `J = 𝔪` is prime and `⋂_n 𝔪^n = 0`, so a relation `u v = 0` between
nonzero elements supplies exactly such an `a` and `b`.

## Main results

* `IsRegularLocalRing.isDomain`: Stacks 00NP.

## Implementation notes

Homogeneous polynomials over `R` replace the source's "`f ∈ 𝔪^a` with `a` maximal, expanded in
the monomials `x^e`": a family of coefficients indexed by the degree-`n` multi-indices *is* a
homogeneous polynomial of degree `n`, and phrasing it that way makes the one step of the proof
that multiplies two such expansions — the identity `(P Q)(f) = u v` — a ring homomorphism applied
to a product (`MvPolynomial.eval`), rather than a convolution of coefficient families. That `J^n`
consists of the values at `f` of the degree-`n` homogeneous polynomials is Mathlib's
`Ideal.mem_span_pow_iff_exists_isHomogeneous`; the refinement of its harder direction used here,
that coefficients in an ideal `I` put the value in `I · J^n`, is
`eval_mem_mul_pow_of_isHomogeneous`, and for `I = J` it is the final contradiction.

`mem_smul_top_of_sum_mem` is the degreewise, elementary form of quasi-regularity: a relation
`∑_{|e| = n} f^e m_e ∈ J^(n+1) M` forces every `m_e ∈ J M`. It is deduced from injectivity of the
canonical map of Stacks 061N by evaluating that map on `∑ X^e ⊗ m̄_e` and reading off the
coefficient of `X^e` in the source `(R/J)[X] ⊗_{R/J} (M/JM)` — which is where the freeness of
`(R/J)[X]` over `R/J` on the monomials enters, through `srcCoeff` and `srcCoeff_srcMono`. It is
stated for an arbitrary module `M` and an arbitrary finite set of multi-indices of a fixed total
degree, the generality it has; it is used for `M = R` and the support of a homogeneous
polynomial.

## References

* [StacksProject 00NP](https://stacks.math.columbia.edu/tag/00NP)
* [StacksProject 00NO](https://stacks.math.columbia.edu/tag/00NO), quasi-regularity of a minimal
  set of generators of the maximal ideal
* [StacksProject 00IP](https://stacks.math.columbia.edu/tag/00IP), `⋂_n 𝔪^n = 0`, used through
  Mathlib's `Ideal.iInf_pow_eq_bot_of_isLocalRing`
-/


namespace Stacks.RegularLocalRing.Domain

open IsLocalRing MvPolynomial RingTheory.Sequence

variable {R : Type*} [CommRing R]

/-! ### The `I`-adic filtration of a ring -/

/-- If the powers of `I` intersect in `0`, then every nonzero element lies in a largest power
of `I`. -/
private theorem exists_mem_pow_notMem_pow_succ {I : Ideal R} (hI : ⨅ n : ℕ, I ^ n = ⊥) {x : R}
    (hx : x ≠ 0) : ∃ a : ℕ, x ∈ I ^ a ∧ x ∉ I ^ (a + 1) := by
  classical
  have hex : ∃ n : ℕ, x ∉ I ^ n := by
    by_contra h
    push Not at h
    exact hx (by simpa [hI] using (Submodule.mem_iInf _).2 h)
  have hpos : Nat.find hex ≠ 0 := fun h => Nat.find_spec hex (by simp [h])
  refine ⟨Nat.find hex - 1, not_not.mp (Nat.find_min hex (by omega)), ?_⟩
  rw [show Nat.find hex - 1 + 1 = Nat.find hex by omega]
  exact Nat.find_spec hex

/-! ### Homogeneous polynomials and the powers of `J = (f_1, …, f_c)` -/

/-- A polynomial has zero image in `(R/I)[X_1, …, X_c]` exactly when all of its coefficients lie
in `I`. -/
private theorem map_mk_eq_zero_iff {σ : Type*} (I : Ideal R) (P : MvPolynomial σ R) :
    P.map (Ideal.Quotient.mk I) = 0 ↔ ∀ e, MvPolynomial.coeff e P ∈ I := by
  simp [MvPolynomial.ext_iff, MvPolynomial.coeff_map, Ideal.Quotient.eq_zero_iff_mem]

/-- Every multi-index in the support of a homogeneous polynomial of degree `n` has total
degree `n`. -/
private theorem qrMdeg_eq_of_mem_support {c n : ℕ} {P : MvPolynomial (Fin c) R}
    (hP : P.IsHomogeneous n) {e : Fin c →₀ ℕ} (he : e ∈ P.support) : qrMdeg e = n := by
  have hd : e.degree = n := by
    by_contra h
    exact (MvPolynomial.mem_support_iff.mp he) (hP.coeff_eq_zero h)
  rwa [Finsupp.degree_eq_sum] at hd

/-- The value at `f = (f_1, …, f_c)` of a homogeneous polynomial of degree `n` all of whose
coefficients lie in an ideal `I` lies in `I · J^n`, where `J = (f_1, …, f_c)`. -/
private theorem eval_mem_mul_pow_of_isHomogeneous {c : ℕ} (f : Fin c → R) (I : Ideal R) {n : ℕ}
    {P : MvPolynomial (Fin c) R} (hP : P.IsHomogeneous n)
    (hc : ∀ e, MvPolynomial.coeff e P ∈ I) : MvPolynomial.eval f P ∈ I * Jid f ^ n := by
  rw [MvPolynomial.eval_eq']
  refine Ideal.sum_mem _ fun e he => Ideal.mul_mem_mul (hc e) ?_
  exact qrMdeg_eq_of_mem_support hP he ▸ fpow_mem f e

/-- The value at `f = (f_1, …, f_c)` of a polynomial, expanded over its support in the shape a
relation between monomials takes: `P(f) = ∑_e f^e · P_e`. -/
private theorem sum_fpow_smul_coeff {c : ℕ} (f : Fin c → R) (P : MvPolynomial (Fin c) R) :
    ∑ e ∈ P.support, fpow f e • MvPolynomial.coeff e P = MvPolynomial.eval f P := by
  rw [MvPolynomial.eval_eq']
  exact Finset.sum_congr rfl fun e _ => by rw [smul_eq_mul, mul_comm]; rfl

/-- The value at `f` of a degree-`n` homogeneous polynomial whose image in `(R/J)[X_1, …, X_c]`
vanishes lies one step further down the filtration, in `J^(n+1)`, for `J = (f_1, …, f_c)`. -/
private theorem eval_mem_pow_succ_of_map_eq_zero {c : ℕ} (f : Fin c → R) {n : ℕ}
    {P : MvPolynomial (Fin c) R} (hP : P.IsHomogeneous n)
    (h : P.map (Ideal.Quotient.mk (Jid f)) = 0) : MvPolynomial.eval f P ∈ Jid f ^ (n + 1) := by
  rw [pow_succ']
  exact eval_mem_mul_pow_of_isHomogeneous f _ hP ((map_mk_eq_zero_iff _ P).1 h)

/-! ### Quasi-regularity, degreewise -/

section Graded

variable {M : Type*} [AddCommGroup M] [Module R M]

/-- The class of an element of `J^n M` in the degree-`n` summand `J^n M / J^(n+1) M` of the
associated graded module of Stacks 061N. -/
private noncomputable def tgtClass (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ}
    (f : Fin c → R) (n : ℕ) : JpowM M f n →ₗ[R] Target M f :=
  DirectSum.lof R ℕ (fun k => Tcomp M f k) n ∘ₗ (Tsub M f n).mkQ

/-- An element of `J^n M` that already lies in `J^(n+1) M` has zero class in degree `n`. -/
private theorem tgtClass_eq_zero {c : ℕ} (f : Fin c → R) {n : ℕ} (x : JpowM M f n)
    (hx : (x : M) ∈ JpowM M f (n + 1)) : tgtClass M f n x = 0 := by
  have hx' : x ∈ Tsub M f n := Submodule.mem_comap.2 hx
  rw [tgtClass, LinearMap.comp_apply, Submodule.mkQ_apply,
    (Submodule.Quotient.mk_eq_zero _).2 hx', map_zero]

/-- The canonical map of Stacks 061N on a monomial generator `X^e ⊗ m̄` with `|e| = n`, written as
a class in the degree-`n` summand. -/
private theorem imgTargetLin_eq_tgtClass {c : ℕ} (f : Fin c → R) {n : ℕ} (e : Fin c →₀ ℕ)
    (he : qrMdeg e = n) (x : M) (hmem : fpow f e • x ∈ JpowM M f n) :
    imgTargetLin f e x = tgtClass M f n ⟨fpow f e • x, hmem⟩ := by
  subst he
  rfl

/-- The coefficient of `X^e` in an element of the source `(R/J)[X_1, …, X_c] ⊗_{R/J} (M/JM)` of
the canonical map of Stacks 061N, read off in the monomial basis over `R/J`. -/
private noncomputable def srcCoeff {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) :
    Source M f →ₗ[qrRbar f] qrMbar M f :=
  (TensorProduct.lid (qrRbar f) (qrMbar M f)).toLinearMap ∘ₗ
    LinearMap.rTensor (qrMbar M f) ((MvPolynomial.basisMonomials (Fin c) (qrRbar f)).coord e)

/-- The monomials are a basis of `(R/J)[X_1, …, X_c]` over `R/J`: the coefficient of `X^{e'}` in
the generator `X^e ⊗ m̄` is `m̄` for `e = e'` and `0` otherwise. -/
private theorem srcCoeff_srcMono {c : ℕ} (f : Fin c → R) (e e' : Fin c →₀ ℕ) (x : M) :
    srcCoeff f e' (srcMono f e x) =
      if e = e' then (Submodule.Quotient.mk x : qrMbar M f) else 0 := by
  simp only [srcCoeff, srcMono, LinearMap.coe_comp, Function.comp_apply, LinearMap.rTensor_tmul,
    LinearEquiv.coe_coe, TensorProduct.lid_tmul, Module.Basis.coord_apply]
  rw [show (MvPolynomial.monomial e (1 : qrRbar f))
      = (MvPolynomial.basisMonomials (Fin c) (qrRbar f)) e from rfl, Module.Basis.repr_self,
    Finsupp.single_apply]
  split_ifs with h <;> simp

/-- **Quasi-regularity, degreewise and elementary.** If the canonical map of Stacks 061N is
injective, then a relation `∑_{|e| = n} f^e m_e ∈ J^(n+1) M` between the monomials of total
degree `n` forces every coefficient `m_e` into `J M`. -/
private theorem mem_smul_top_of_sum_mem {c : ℕ} {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := M) f)) {n : ℕ}
    {s : Finset (Fin c →₀ ℕ)} (hs : ∀ e ∈ s, qrMdeg e = n) {m : (Fin c →₀ ℕ) → M}
    (hsum : ∑ e ∈ s, fpow f e • m e ∈ JpowM M f (n + 1)) {e₀ : Fin c →₀ ℕ} (he₀ : e₀ ∈ s) :
    m e₀ ∈ Jid f • (⊤ : Submodule R M) := by
  have hterm : ∀ e ∈ s, fpow f e • m e ∈ JpowM M f n := fun e he =>
    hs e he ▸ fpow_smul_mem f e (m e)
  -- The source element `∑_e X^e ⊗ m̄_e` lies in the kernel, hence is zero.
  have hu : ∑ e ∈ s, srcMono f e (m e) = 0 := by
    have hcalc : ∀ e : {x // x ∈ s}, quasiRegularCanonicalMap f (srcMono f e.1 (m e.1))
        = tgtClass M f n ⟨fpow f e.1 • m e.1, hterm e.1 e.2⟩ := fun e => by
      rw [canonicalMap_srcMono, imgTargetLin_eq_tgtClass f e.1 (hs e.1 e.2)]
    have hsub : (⟨∑ e ∈ s, fpow f e • m e, Submodule.sum_mem _ hterm⟩ : JpowM M f n)
        = ∑ e ∈ s.attach, (⟨fpow f e.1 • m e.1, hterm e.1 e.2⟩ : JpowM M f n) :=
      Subtype.ext <| by
        rw [AddSubmonoidClass.coe_finsetSum]
        exact (Finset.sum_attach s fun e => fpow f e • m e).symm
    refine hinj ?_
    rw [map_zero, map_sum,
      ← Finset.sum_attach s fun e => quasiRegularCanonicalMap f (srcMono f e (m e)),
      Finset.sum_congr rfl fun e _ => hcalc e, ← map_sum, ← hsub]
    exact tgtClass_eq_zero f _ hsum
  -- Read off the coefficient of `X^{e₀}`.
  have hcoord := congrArg (srcCoeff f e₀) hu
  rw [map_sum, map_zero] at hcoord
  simp only [srcCoeff_srcMono, Finset.sum_ite_eq', he₀, ite_true] at hcoord
  exact (Submodule.Quotient.mk_eq_zero _).1 hcoord

end Graded

/-- **Quasi-regularity, for a homogeneous polynomial.** If the canonical map of Stacks 061N is
injective and a homogeneous polynomial of degree `n` over `R` has value at `f` inside `J^(n+1)`,
then every coefficient of that polynomial lies in `J = (f_1, …, f_c)`. -/
private theorem coeff_mem_of_isHomogeneous_of_eval_mem {c : ℕ} {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := R) f)) {n : ℕ}
    {P : MvPolynomial (Fin c) R} (hP : P.IsHomogeneous n)
    (hev : MvPolynomial.eval f P ∈ Jid f ^ (n + 1)) (e : Fin c →₀ ℕ) :
    MvPolynomial.coeff e P ∈ Jid f := by
  by_cases he : e ∈ P.support
  · have hsum : ∑ e' ∈ P.support, fpow f e' • MvPolynomial.coeff e' P ∈ JpowM R f (n + 1) := by
      rwa [sum_fpow_smul_coeff,
        show JpowM R f (n + 1) = Jid f ^ (n + 1) from Ideal.smul_top_eq_self _]
    have := mem_smul_top_of_sum_mem hinj (s := P.support)
      (fun e' he' => qrMdeg_eq_of_mem_support hP he') hsum he
    rwa [Ideal.smul_top_eq_self] at this
  · rw [MvPolynomial.notMem_support_iff.mp he]
    exact Submodule.zero_mem _

/-! ### No zero divisors -/

/-- **The content of Stacks 00NP.** Let `f_1, …, f_c` generate an ideal `J` with `R/J` a domain,
and let the canonical map of Stacks 061N for `M = R` be injective, that is, let `f_1, …, f_c` be
quasi-regular. If `u` lies in `J^a` but not in `J^(a+1)` and `v` lies in `J^b` but not in
`J^(b+1)`, then `u v` does not lie in `J^(a+b+1)`.

Write `u = P(f)` and `v = Q(f)` with `P`, `Q` homogeneous of degrees `a`, `b`. If `u v` were in
`J^(a+b+1)`, quasi-regularity would put every coefficient of the degree-`(a+b)` homogeneous
polynomial `P Q` into `J`, so the image of `P Q` in `(R/J)[X_1, …, X_c]` would vanish; that ring
is a domain, so already `P` or `Q` has all coefficients in `J`, forcing `u ∈ J^(a+1)` or
`v ∈ J^(b+1)`. -/
private theorem mul_notMem_pow_add_succ {c : ℕ} {f : Fin c → R} [(Jid f).IsPrime]
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := R) f)) {a b : ℕ} {u v : R}
    (hua : u ∈ Jid f ^ a) (hua' : u ∉ Jid f ^ (a + 1)) (hvb : v ∈ Jid f ^ b)
    (hvb' : v ∉ Jid f ^ (b + 1)) : u * v ∉ Jid f ^ (a + b + 1) := by
  obtain ⟨P, hP, hPev⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous f u).1 hua
  obtain ⟨Q, hQ, hQev⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous f v).1 hvb
  intro huv
  have hmapzero : P.map (Ideal.Quotient.mk (Jid f)) * Q.map (Ideal.Quotient.mk (Jid f)) = 0 := by
    rw [← map_mul]
    refine (map_mk_eq_zero_iff _ _).2 (coeff_mem_of_isHomogeneous_of_eval_mem hinj (hP.mul hQ) ?_)
    rw [map_mul, hPev, hQev]
    exact huv
  rcases mul_eq_zero.mp hmapzero with h | h
  · exact hua' (hPev ▸ eval_mem_pow_succ_of_map_eq_zero f hP h)
  · exact hvb' (hQev ▸ eval_mem_pow_succ_of_map_eq_zero f hQ h)

end Stacks.RegularLocalRing.Domain


/-!
# A regular local ring is a domain

A regular local ring is a Noetherian local ring `(R, m)` whose maximal ideal can be generated by
`dim R` elements. Such a ring has no zero divisors: writing `f ∈ m^a` and `g ∈ m^b` with `a`, `b`
maximal — possible because `⋂ n, m ^ n = 0` — a product `f * g = 0` lies in `m ^ (a + b + 1)`,
which contradicts the associated graded ring `⨁ m^n / m^(n + 1)` being the polynomial algebra
`κ[X₁, …, X_d]` over the residue field, hence a domain.

## Main results

* `IsRegularLocalRing.isDomain`: a regular local ring is a domain.

## Implementation notes

The source's "regular local ring" is Mathlib's `IsRegularLocalRing`, the class
`(maximalIdeal R).spanFinrank = ringKrullDim R` on a Noetherian local ring, which already carries
the source's own definition [StacksProject 00KU]; so the statement is the source's sentence with
no change of form. The source's "domain" is `IsDomain`, which bundles `Nontrivial` — no
strengthening, since `IsRegularLocalRing` extends `IsLocalRing` and hence `Nontrivial`, and a
domain is nonzero by convention on both sides.

This is deliberately a `theorem` rather than an `instance`: Mathlib already has the
converse-flavoured instance
`[IsLocalRing R] [IsDomain R] [IsPrincipalIdealRing R] → IsRegularLocalRing R`, so an
`IsRegularLocalRing R → IsDomain R` instance would make every search for `IsDomain R` re-enter
`IsRegularLocalRing R`. Users write `have := IsRegularLocalRing.isDomain R`.

There is nothing to generalize away: the single hypothesis is the entity, and the conclusion is
about the ring itself.

Faithfulness. (1) The only hypothesis, `[IsRegularLocalRing R]`, is used and cannot be weakened to
its two components: `R = k[X]/(X ^ 2)` is Noetherian local, is not a domain, and is not regular
(`dim R = 0` while `m = (X)` needs one generator). (2) The base is the source's: the ring in the
hypothesis and the ring in the conclusion are the same `R`, with no localization or completion
intervening — the graded ring and the residue field of the proof sketch do not appear in the
statement. (3) The source names no canonical map here; the conclusion is a property of `R`, pinned
as the class `IsDomain R` rather than asserted of some unnamed ring. (4) The instantiation is not
degenerate: `Localization.AtPrime (Ideal.span {(2 : ℤ)})` is a discrete valuation ring, hence
regular local by the instance above, and more to the point `R = k[X₁, …, X_d]` localized at the
origin is regular local of dimension `d` for every `d`, so the hypothesis holds on rings of every
dimension and not only on fields.

## References

* [StacksProject 00NP](https://stacks.math.columbia.edu/tag/00NP)
-/

/-- **A regular local ring is a domain.** If the maximal ideal of a Noetherian local ring `R` can
be generated by `dim R` elements, then `R` has no zero divisors. -/
@[stacks 00NP]
public theorem IsRegularLocalRing.isDomain (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    IsDomain R :=
  isDomain_of_isRegularLocalRing_aux (Submodule.spanFinrank (maximalIdeal R)) R
    (IsRegularLocalRing.spanFinrank_maximalIdeal).symm
/-!
# Minimal generators of a regular local ring form a regular sequence

Proof of `IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay`
(Stacks 00NQ). Let `(R, 𝔪)` be a regular local ring and let `x₁, …, x_d` be a minimal set of
generators of `𝔪`, so that `d = dim R`. Then `x₁, …, x_d` is a regular sequence on `R`, each
`R/(x₁, …, x_c)` is a regular local ring of dimension `d - c`, and `R` is Cohen-Macaulay.

The argument is the source's induction on `d`. For `d = 0` the empty sequence is regular because
`R` is nonzero. For `d > 0`: the ring `S = R/x₁R` is Noetherian local, its maximal ideal is the
image of `𝔪` and hence is generated by the `d - 1` elements `x₂, …, x_d`, while `x₁` is a
nonzerodivisor — `R` is a domain by Stacks 00NP, and `x₁ ≠ 0` because `𝔪` cannot be generated by
fewer than `d` elements — so `dim S = d - 1` by Stacks 00KW. Thus `dim S` is at most the number of
those generators, `S` is a regular local ring, and `x₂, …, x_d` is again a minimal set of
generators of its maximal ideal, so the induction hypothesis applies to `S`.

Both remaining assertions are read off from the regular sequence. The prefix `x₁, …, x_c` is again
a regular sequence, so `dim R/(x₁, …, x_c) + c = dim R = d`; the maximal ideal of
`R/(x₁, …, x_c)` is generated by the images of `x_{c+1}, …, x_d`, that is by `d - c` elements, and
so that ring is regular local. Finally the sequence `x₁, …, x_d` lies in `𝔪` and is regular, which
gives `depth_𝔪(R) ≥ d`, while every `R`-regular sequence in `𝔪` has length at most `dim R = d`
because the quotient by it is nonzero; hence `depth_𝔪(R) = d = dim R`.

## Main results

* `Stacks.RegularLocalRing.RegularSequence.solution`: the statement of Stacks 00NQ.

## Implementation notes

The induction is on the length of the generating list rather than on the list itself, because the
ring changes at each step: the statement proved is a statement about all regular local rings in a
fixed universe at once.

Two steps of the argument are lemmas of the general theory that are not in Mathlib and are proved
here as private helpers. The first, `map_maximalIdeal_quotient_mk`, is that the maximal ideal of a
quotient of a local ring is the image of the maximal ideal; Mathlib proves this inline inside
`IsLocalRing.exists_maximalIdeal_pow_le_of_isArtinianRing_quotient` rather than as a lemma. The
second, `isRegular_cons_iff_quotient_span_singleton`, restates Mathlib's
`RingTheory.Sequence.isRegular_cons_iff'` with the module `QuotSMulTop x R` replaced by the
quotient *ring* `R ⧸ (x)`, which is what an induction on rings needs; the two are identified by
`Submodule.quotEquivOfEq`.

## References

* [StacksProject 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
-/



namespace Stacks.RegularLocalRing.RegularSequence

open IsLocalRing Ideal Pointwise RingTheory.Sequence


/-- An element of `WithBot ℕ∞` whose sum with a natural number is a natural number is itself a
natural number. -/
private lemma exists_natCast_eq_of_add_natCast_eq {a : WithBot ℕ∞} {c d : ℕ}
    (h : a + (c : WithBot ℕ∞) = (d : WithBot ℕ∞)) : ∃ m : ℕ, a = (m : WithBot ℕ∞) ∧ m + c = d := by
  induction a using WithBot.recBotCoe with
  | bot => simp at h
  | coe b =>
    rw [show ((c : WithBot ℕ∞)) = ((c : ℕ∞) : WithBot ℕ∞) from rfl, ← WithBot.coe_add,
      show ((d : WithBot ℕ∞)) = ((d : ℕ∞) : WithBot ℕ∞) from rfl, WithBot.coe_eq_coe] at h
    induction b using ENat.recTopCoe with
    | top => simp at h
    | coe m => exact ⟨m, rfl, by exact_mod_cast h⟩

/-- The maximal ideal of a quotient of a local ring is the image of the maximal ideal. -/
@[ega "0 22.5.2" "partial"]
private lemma map_maximalIdeal_quotient_mk {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] :
    (maximalIdeal R).map (Ideal.Quotient.mk I) = maximalIdeal (R ⧸ I) := by
  have hI : I ≠ ⊤ := Submodule.Quotient.nontrivial_iff.mp inferInstance
  have : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  ext y
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  simp [sup_eq_left.mpr (le_maximalIdeal hI)]

/-- **The heart of Stacks 00NQ.** A list of `n` elements generating the maximal ideal of a regular
local ring, `n` being the minimal number of generators, is a regular sequence. The induction is on
`n`, over all regular local rings at once. -/
@[sga "4½ Cycle 2.2.1" "special case"]
private theorem isRegular_of_ofList_eq_maximalIdeal (n : ℕ) :
    ∀ {R : Type u} [CommRing R] [IsRegularLocalRing R] (xs : List R), xs.length = n →
      Ideal.ofList xs = maximalIdeal R → xs.length = (maximalIdeal R).spanFinrank →
      IsRegular R xs :=
  Stacks.RegularLocalRing.QuasiRegular.isRegular_of_ofList_eq_maximalIdeal n

/-- The quotient of a regular local ring by an initial segment of a minimal set of generators of
its maximal ideal is a regular local ring of the complementary dimension. -/
private lemma isRegularLocalRing_quotient_ofList_take {R : Type*} [CommRing R]
    [IsRegularLocalRing R] {xs : List R} (hgen : Ideal.ofList xs = maximalIdeal R)
    (hmin : xs.length = (maximalIdeal R).spanFinrank) (hreg : IsRegular R xs) {c : ℕ}
    (hc : c ≤ xs.length) :
    IsRegularLocalRing (R ⧸ Ideal.ofList (xs.take c)) ∧
      ringKrullDim (R ⧸ Ideal.ofList (xs.take c)) + c = ringKrullDim R := by
  have hmem : ∀ r ∈ xs, r ∈ maximalIdeal R := fun r hr => hgen ▸ Ideal.subset_span hr
  have hdimR : ringKrullDim R = ((xs.length : ℕ) : WithBot ℕ∞) := by
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, ← hmin]
  have htake : IsRegular R (xs.take c) := isRegular_take xs hreg c
  have hdim : ringKrullDim (R ⧸ Ideal.ofList (xs.take c)) + (c : WithBot ℕ∞) = ringKrullDim R := by
    have := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular (xs.take c) htake
    rwa [List.length_take, min_eq_left hc] at this
  refine ⟨?_, hdim⟩
  have hItop : Ideal.ofList (xs.take c) ≠ ⊤ := fun h => htake.top_ne_smul (by simp [h])
  have : Nontrivial (R ⧸ Ideal.ofList (xs.take c)) := Submodule.Quotient.nontrivial_iff.mpr hItop
  have : IsLocalRing (R ⧸ Ideal.ofList (xs.take c)) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have hbot :
      Ideal.ofList ((xs.take c).map (Ideal.Quotient.mk (Ideal.ofList (xs.take c)))) = ⊥ := by
    rw [Ideal.span_eq_bot]
    intro y hy
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hy
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hr)
  have hmax : maximalIdeal (R ⧸ Ideal.ofList (xs.take c)) =
      Ideal.ofList ((xs.drop c).map (Ideal.Quotient.mk (Ideal.ofList (xs.take c)))) := by
    have hsplit : Ideal.ofList xs = Ideal.ofList (xs.take c ++ xs.drop c) := by
      rw [List.take_append_drop]
    rw [← map_maximalIdeal_quotient_mk, ← hgen, hsplit, Ideal.map_ofList, List.map_append,
      Ideal.ofList_append, hbot, bot_sup_eq]
  have hfr : (maximalIdeal (R ⧸ Ideal.ofList (xs.take c))).spanFinrank ≤ xs.length - c := by
    rw [hmax]
    exact (spanFinrank_ofList_le _).trans_eq (by simp)
  obtain ⟨m, hm, hmc⟩ := exists_natCast_eq_of_add_natCast_eq (hdim.trans hdimR)
  exact IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _
    (by rw [hm]; exact_mod_cast hfr.trans (by omega))

/-- **Stacks 00NQ**: in a regular local ring every minimal generating list of the maximal ideal is
a regular sequence whose initial quotients `R ⧸ (x₁, …, x_c)` are regular local of dimension
`dim R - c`, and `R` is maximal Cohen-Macaulay over itself. -/
public theorem solution (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    (∀ xs : List R, Ideal.ofList xs = maximalIdeal R →
        xs.length = (maximalIdeal R).spanFinrank →
        RingTheory.Sequence.IsRegular R xs ∧
          ∀ c ≤ xs.length, IsRegularLocalRing (R ⧸ Ideal.ofList (xs.take c)) ∧
            ringKrullDim (R ⧸ Ideal.ofList (xs.take c)) + c = ringKrullDim R) ∧
      Module.IsMaximalCohenMacaulay R R := by
  have key : ∀ xs : List R, Ideal.ofList xs = maximalIdeal R →
      xs.length = (maximalIdeal R).spanFinrank → IsRegular R xs :=
    fun xs hgen hmin => isRegular_of_ofList_eq_maximalIdeal xs.length xs rfl hgen hmin
  refine ⟨fun xs hgen hmin => ⟨key xs hgen hmin, fun c hc =>
    isRegularLocalRing_quotient_ofList_take hgen hmin (key xs hgen hmin) hc⟩, ?_⟩
  -- Cohen-Macaulayness: `depth_𝔪(R) = d = dim R` for `d` the minimal number of generators of `𝔪`.
  obtain ⟨s, hcard, hspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
  have hgen : Ideal.ofList s.toList = maximalIdeal R := by rw [← hspan]; simp [Ideal.ofList]
  have hlen : s.toList.length = (maximalIdeal R).spanFinrank := by simp [hcard]
  have hdimR : ringKrullDim R = (((maximalIdeal R).spanFinrank : ℕ) : WithBot ℕ∞) :=
    (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).symm
  have hne : ¬ (maximalIdeal R • (⊤ : Submodule R R) = ⊤) := by
    simpa using (maximalIdeal.isMaximal R).ne_top
  change (Module.depth R (maximalIdeal R) R : WithBot ℕ∞) = ringKrullDim R
  have hdepth : Module.depth R (maximalIdeal R) R = (((maximalIdeal R).spanFinrank : ℕ) : ℕ∞) := by
    rw [Module.depth, ite_eq_right_of_eq_false _ _ (eq_false hne)]
    refine le_antisymm (iSup₂_le fun rs hrs => ?_) (le_iSup₂_of_le s.toList ⟨?_, ?_⟩ ?_)
    · obtain ⟨m, _, hmc⟩ := exists_natCast_eq_of_add_natCast_eq
        (a := ringKrullDim (R ⧸ Ideal.ofList rs)) (c := rs.length)
        (d := (maximalIdeal R).spanFinrank)
        ((ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hrs.2).trans hdimR)
      have hle : rs.length ≤ (maximalIdeal R).spanFinrank := by omega
      exact_mod_cast hle
    · exact fun r hr => hgen ▸ Ideal.subset_span hr
    · exact key s.toList hgen hlen
    · exact_mod_cast hlen.ge
  rw [hdepth, hdimR]
  norm_cast

end Stacks.RegularLocalRing.RegularSequence

/-!
# Minimal generators of a regular local ring form a regular sequence

Let `(R, 𝔪)` be a regular local ring and let `x₁, …, x_d` be a minimal set of generators of
`𝔪`, so `d = dim R`. Then `x₁, …, x_d` is a regular sequence on `R`, and for every
`0 ≤ c ≤ d` the ring `R/(x₁, …, x_c)` is again a regular local ring, of dimension `d - c`.
In particular `R` is Cohen-Macaulay.

The argument is an induction on `d`. The ring `R/x₁R` is Noetherian local of dimension `≥ d - 1`
by Lemma 00KW, with `x₂, …, x_d` generating its maximal ideal, hence regular of dimension exactly
`d - 1`; and `x₁` is a nonzerodivisor because a regular local ring is a domain, Lemma 00NP.

## Main results

* `IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay`:
  a minimal generating sequence of the maximal ideal of a regular local ring is a regular
  sequence, each of its initial quotients is a regular local ring of the complementary
  dimension, and the ring is maximal Cohen-Macaulay over itself.

## Implementation notes

A "minimal set of generators for `𝔪`" is a list `xs : List R` with `Ideal.ofList xs = 𝔪` whose
length is the minimal possible one, `(𝔪).spanFinrank`; this is minimality in the source's
sense and needs no regularity to state, while `IsRegularLocalRing R` then forces
`xs.length = dim R = d`. The subsequence `x₁, …, x_c` is pinned as the prefix `xs.take c` for
`c ≤ xs.length`, and `R/(x₁, …, x_c)` as `R ⧸ Ideal.ofList (xs.take c)`. "Of dimension `d - c`"
is stated additively, `ringKrullDim (R ⧸ Ideal.ofList (xs.take c)) + c = ringKrullDim R`, in the
shape of Mathlib's `ringKrullDim_add_length_eq_ringKrullDim_of_isRegular`: subtraction in
`WithBot ℕ∞` is truncated, whereas the additive form carries the same content with no side
condition, and is the form in which `x₁, …, x_c` regular delivers it.

The source's "in particular `R` is Cohen-Macaulay" is a statement about `R` alone: it mentions
no generating sequence. Cohen-Macaulayness of a ring is Definition 00N8, `R` Cohen-Macaulay as a
module over itself, and at `M = R` that condition is the named predicate
`Module.IsMaximalCohenMacaulay R R` of Definition 00NF — the equality `depth_𝔪(R) = dim R`, with
`Module.depth` of Definition 00LI — because `Supp(R) = Spec(R)`, so the module-level `dim Supp(M)`
of Definition 00N3 is `dim R` here. It is therefore stated in that form, and the sequence `xs`
and its two hypotheses are bound inside the clause that uses them, so that no hypothesis of the
theorem is dead and a user who wants only Cohen-Macaulayness never has to produce a minimal
generating list.

Cohen-Macaulayness is asserted here, alongside the regular sequence, rather than upstream of it:
it is a *consequence* of the first clause, a regular sequence of length `d` inside `𝔪` witnessing
`depth_𝔪(R) ≥ d` while `depth ≤ dim` is Tag 00LK, so assuming it instead would point the
dependence backwards.

Faithfulness. (1) No hypothesis is dead: `[IsRegularLocalRing R]` carries both conjuncts, and
inside the first clause all three of `xs`, generation and minimality are used. Regularity of `R`
fails to be dispensable: in `R = k[[x, y]]/(xy)` the minimal generators `x, y` of `𝔪` do not
form a regular sequence, since `xy = 0`. Minimality fails to be dispensable: in a discrete
valuation ring with uniformizer `x`, the list `[x, x]` generates `𝔪` but `x` is a zerodivisor
on `R/xR`. Generation fails to be dispensable: in that same ring `[0]` has the minimal length
`1`, and `0` is not a nonzerodivisor.
(2) Everything is over `R` itself: the sequence is `R`-regular on the module `R`, the quotients
are quotient rings of `R`, and the depth is the `𝔪`-depth of `R` as an `R`-module — no
localization or base change intervenes. (3) The source names no canonical map; what must be
pinned is which ideal `(x₁, …, x_c)` denotes, and `Ideal.ofList (xs.take c)` pins it to the ideal
generated by the first `c` entries of the given list rather than asserting some such flag of
ideals exists. (4) The instantiation is not degenerate: every regular local ring admits such
a list, obtained from `Submodule.FG.exists_span_finset_card_eq_spanFinrank` for `𝔪`, of length
`dim R` by `IsRegularLocalRing.spanFinrank_maximalIdeal`, so the first clause is not vacuously
quantified. For the localization of `ℤ` at `(p)` and `xs = [p]` it reads: `[p]` is a regular
sequence and `ℤ_(p)/p` is a regular local ring of dimension `0`; `k[[x₁, …, x_d]]` with the
coordinates gives an instance for every `d`. The range of `c` includes both `c = 0`, where the
quotient is `R` itself, and `c = d`, where it is the residue field, a regular local ring of
dimension `0`.

## References

* [StacksProject 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
-/

open IsLocalRing

namespace IsRegularLocalRing

/-- **A minimal set of generators of the maximal ideal of a regular local ring is a regular
sequence.** Let `(R, 𝔪)` be a regular local ring. Then every list `xs = x₁, …, x_d` generating
`𝔪` of the minimal length `d = (𝔪).spanFinrank` is a regular sequence on `R`, and each initial
quotient `R/(x₁, …, x_c)` is a regular local ring of dimension `d - c`; in particular `R` is
Cohen-Macaulay, that is, maximal Cohen-Macaulay over itself. -/
@[stacks 00NQ "Cohen-Macaulayness is the named predicate `Module.IsMaximalCohenMacaulay R R` \
  (Definition 00NF), the equality `depth_𝔪(R) = dim R`; the minimal generating sequence is \
  bound inside the clause that uses it, so the `in particular` is a statement about `R` alone. \
  See the module docstring.", ega "0 17.1.3" "CM clause", sga "4½ Cycle 2.2.1" "special case"]
public theorem isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
    (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    (∀ xs : List R, Ideal.ofList xs = maximalIdeal R →
        xs.length = (maximalIdeal R).spanFinrank →
        RingTheory.Sequence.IsRegular R xs ∧
          ∀ c ≤ xs.length, IsRegularLocalRing (R ⧸ Ideal.ofList (xs.take c)) ∧
            ringKrullDim (R ⧸ Ideal.ofList (xs.take c)) + c = ringKrullDim R) ∧
      Module.IsMaximalCohenMacaulay R R :=
  Stacks.RegularLocalRing.RegularSequence.solution R

end IsRegularLocalRing

/-!
# An ideal with regular quotient is generated by part of a minimal generating set

Proof of
`IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq` (Stacks
00NR). Let `(R, 𝔪)` be a regular local ring, let `I ⊆ R` be an ideal such that `R ⧸ I` is a regular
local ring, write `κ = R ⧸ 𝔪`, `d = dim R` and `d - c = dim (R ⧸ I)`. Then `𝔪` has a minimal set of
generators `x₁, …, x_d` with `I = (x₁, …, x_c)`.

The argument is the source's. Inside the cotangent space `𝔪/𝔪²`, whose dimension over `κ` is `d`,
sits the subspace `W = (I + 𝔪²)/𝔪²`, and the quotient `(𝔪/𝔪²)/W = 𝔪/(I + 𝔪²)` is spanned by the
images of any lift of a minimal set of generators of the maximal ideal `𝔪̄` of `R ⧸ I`, so
`dim_κ(W) ≥ d - dim_κ̄(𝔪̄/𝔪̄²) = c`. Every element of `W` is the class of an element of `I`, so a
`κ`-linearly independent family `x₁, …, x_c` in `W` may be chosen inside `I`, and extended to a
family of `d` elements of `𝔪` spanning `𝔪/𝔪²`, that is, to a minimal set of generators of `𝔪`.
Then `J = (x₁, …, x_c) ⊆ I`, and `R ⧸ J` is a regular local ring with `dim (R ⧸ J) = dim (R ⧸ I)`
by Stacks 00NQ. A regular local ring is a domain (Stacks 00NP), so if `J ≠ I` the surjection
`R ⧸ J → R ⧸ I` would kill a nonzerodivisor and force `dim (R ⧸ I) < dim (R ⧸ J)`. Hence `J = I`.

## Main results

* `Stacks.RegularLocalRing.RegularQuotient.solution`: the statement of Stacks 00NR.

## Implementation notes

The subspace `W = (I + 𝔪²)/𝔪²` of the cotangent space is `cotangentImage I`, the image of the
ideal `I` in `𝔪/𝔪²`. Its elements are exactly the classes of the elements of `𝔪` lying in `I`
(`mem_cotangentImage_iff`), which is where `κ = R/𝔪` being a quotient of `R` enters: the `R`-span
and the `κ`-span of the image of `I` in `𝔪/𝔪²` agree.

Four steps of the argument are general lemmas that Mathlib does not have, and are proved here as
auxiliary lemmas: that a linearly independent family in a finite-dimensional space extends to a
spanning family of `finrank` many vectors (`exists_span_range_union_range_eq_top`); that a
subspace `W` and a finite family which together span `V` satisfy `dim V ≤ dim W + #family`
(`finrank_le_finrank_add_card_of_sup_span_range_eq_top`); the numerical estimate
`d ≤ dim_κ̄(𝔪̄/𝔪̄²) + dim_κ(W)` (`spanFinrank_maximalIdeal_le_add_finrank_cotangentImage`); and
that nested ideals whose quotients have the same finite Krull dimension are equal as soon as the
smaller quotient is a domain (`eq_of_le_of_ringKrullDim_quotient_eq`), which is the last step of
the source's proof.

## References

* [StacksProject 00NR](https://stacks.math.columbia.edu/tag/00NR)
-/

namespace Stacks.RegularLocalRing.RegularQuotient

open IsLocalRing Module Submodule

/-- A linearly independent family `a₁, …, a_n` in a finite-dimensional vector space `V` can be
extended by `finrank V - n` further vectors to a family spanning `V`. -/
lemma exists_span_range_union_range_eq_top {K V : Type*} [DivisionRing K] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {n : ℕ} {a : Fin n → V} (ha : LinearIndependent K a) :
    ∃ b : Fin (finrank K V - n) → V, span K (Set.range a ∪ Set.range b) = ⊤ := by
  set W := span K (Set.range a) with hW
  have hq : finrank K (V ⧸ W) = finrank K V - n := by
    have h1 : finrank K W = n := by rw [hW, finrank_span_eq_card ha, Fintype.card_fin]
    have := Submodule.finrank_quotient_add_finrank W
    omega
  set B := (finBasis K (V ⧸ W)).reindex (finCongr hq) with hB
  set b : Fin (finrank K V - n) → V := fun j => Function.surjInv W.mkQ_surjective (B j) with hb
  have hmap : (span K (Set.range a ∪ Set.range b)).map W.mkQ = ⊤ := by
    rw [Submodule.map_span]
    refine top_le_iff.mp (B.span_eq.ge.trans (span_mono ?_))
    rintro _ ⟨j, rfl⟩
    exact ⟨b j, Or.inr ⟨j, rfl⟩, Function.surjInv_eq _ _⟩
  have hker : LinearMap.ker W.mkQ ≤ span K (Set.range a ∪ Set.range b) := by
    rw [Submodule.ker_mkQ]
    exact span_mono Set.subset_union_left
  have h := Submodule.comap_map_eq_self hker
  rw [hmap, Submodule.comap_top] at h
  exact ⟨b, h.symm⟩

/-- If a subspace `W` of a finite-dimensional vector space `V` and a finite family of vectors
together span `V`, then `dim V ≤ dim W + #family`. -/
private lemma finrank_le_finrank_add_card_of_sup_span_range_eq_top {K V ι : Type*} [Field K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] [Fintype ι] (W : Submodule K V)
    (v : ι → V) (hV : W ⊔ span K (Set.range v) = ⊤) :
    finrank K V ≤ finrank K W + Fintype.card ι := by
  classical
  have h := Submodule.finrank_add_le_finrank_add_finrank W (span K (Set.range v))
  rw [hV, finrank_top] at h
  refine h.trans (Nat.add_le_add_left ((finrank_span_le_card _).trans ?_) _)
  rw [Set.toFinset_card]
  exact Fintype.card_range_le v

/-- The image `(I + 𝔪²)/𝔪²` of an ideal `I` of a local ring `R` in the cotangent space `𝔪/𝔪²`,
as a subspace over the residue field `κ = R/𝔪`. -/
public noncomputable def cotangentImage {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R) :
    Submodule (ResidueField R) (CotangentSpace R) :=
  span (ResidueField R) ((maximalIdeal R).toCotangent ''
    (Submodule.comap (maximalIdeal R).subtype I : Set ↥(maximalIdeal R)))

/-- An element of the cotangent space `𝔪/𝔪²` lies in the image of the ideal `I` if and only if it
is the class of an element of `𝔪` lying in `I`: the `R`-span and the `κ`-span of the image of `I`
coincide, since `κ = R ⧸ 𝔪` is a quotient of `R`. -/
public lemma mem_cotangentImage_iff {R : Type*} [CommRing R] [IsLocalRing R] {I : Ideal R}
    {v : CotangentSpace R} : v ∈ cotangentImage I ↔
      ∃ x : ↥(maximalIdeal R), (x : R) ∈ I ∧ (maximalIdeal R).toCotangent x = v := by
  refine ⟨fun hv => ?_, fun ⟨x, hx, h⟩ => h ▸ Submodule.subset_span ⟨x, hx, rfl⟩⟩
  have hsurj : Function.Surjective (algebraMap R (ResidueField R)) := by
    rw [ResidueField.algebraMap_eq]
    exact Ideal.Quotient.mk_surjective
  have hv' : v ∈ (Submodule.comap (maximalIdeal R).subtype I).map
      (maximalIdeal R).toCotangent := by
    rw [← Submodule.span_eq (Submodule.comap (maximalIdeal R).subtype I), Submodule.map_span,
      ← Submodule.restrictScalars_span R (ResidueField R) hsurj]
    exact hv
  exact Submodule.mem_map.mp hv'

/-- The image `W = (I + 𝔪²)/𝔪²` of an ideal `I` of a Noetherian local ring `R` with `R ⧸ I` local
satisfies `dim_κ(𝔪/𝔪²) ≤ dim_κ̄(𝔪̄/𝔪̄²) + dim_κ(W)`: lifting a minimal set of generators of the
maximal ideal `𝔪̄` of `R ⧸ I` to `𝔪` gives, together with `I`, a set of generators of `𝔪`, hence a
family of `dim_κ̄(𝔪̄/𝔪̄²)` elements spanning the cotangent space together with `W`. -/
private lemma spanFinrank_maximalIdeal_le_add_finrank_cotangentImage {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)] :
    (maximalIdeal R).spanFinrank ≤ (maximalIdeal (R ⧸ I)).spanFinrank +
      finrank (ResidueField R) (cotangentImage I) := by
  classical
  have hIm : I ≤ maximalIdeal R :=
    le_maximalIdeal (Submodule.Quotient.nontrivial_iff.mp inferInstance)
  -- a minimal set of generators of the maximal ideal of `R ⧸ I`
  obtain ⟨G, hGcard, hGspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal (R ⧸ I))).exists_span_finset_card_eq_spanFinrank
  rw [Ideal.submodule_span_eq] at hGspan
  -- lift them to `𝔪`: a lift of a nonunit is a nonunit
  have hlift : ∀ y : {y // y ∈ G}, ∃ z : ↥(maximalIdeal R),
      Ideal.Quotient.mk I (z : R) = (y : R ⧸ I) := by
    intro y
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (y : R ⧸ I)
    have hy : (y : R ⧸ I) ∈ maximalIdeal (R ⧸ I) := hGspan ▸ Ideal.subset_span y.2
    exact ⟨⟨r, (mem_maximalIdeal r).mpr fun hu =>
      (mem_maximalIdeal _).mp hy (hr ▸ hu.map (Ideal.Quotient.mk I))⟩, hr⟩
  choose z hz using hlift
  -- `I` together with the lifts generates `𝔪`
  have hgen : span R ((Submodule.comap (maximalIdeal R).subtype I : Set ↥(maximalIdeal R)) ∪
      Set.range z) = ⊤ := by
    have himg : Ideal.Quotient.mk I '' Set.range (fun y => ((z y : ↥(maximalIdeal R)) : R)) =
        (G : Set (R ⧸ I)) := by
      rw [← Set.range_comp]
      simp [Function.comp_def, hz]
    have hmapeq : Ideal.map (Ideal.Quotient.mk I)
        (I ⊔ Ideal.span (Set.range fun y => ((z y : ↥(maximalIdeal R)) : R))) =
          Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R) := by
      rw [Ideal.map_sup, Ideal.map_span, Ideal.map_quotient_self, bot_sup_eq, himg, hGspan,
        map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
    have hI' : I ⊔ Ideal.span (Set.range fun y => ((z y : ↥(maximalIdeal R)) : R)) =
        maximalIdeal R := by
      have h1 := (Ideal.map_eq_iff_sup_ker_eq_of_surjective (Ideal.Quotient.mk I)
        Ideal.Quotient.mk_surjective).mp hmapeq
      rwa [Ideal.mk_ker, sup_right_comm, sup_idem, sup_eq_left.mpr hIm] at h1
    refine Submodule.map_injective_of_injective (Submodule.injective_subtype _) ?_
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, Set.image_union,
      Submodule.span_union, ← Submodule.map_span, Submodule.span_eq, Submodule.map_comap_eq,
      Submodule.range_subtype, inf_eq_right.mpr hIm, ← Set.range_comp, Ideal.submodule_span_eq]
    exact hI'
  -- so `W` and the classes of the lifts span the cotangent space
  have hsup : cotangentImage I ⊔ span (ResidueField R)
      (Set.range fun y => (maximalIdeal R).toCotangent (z y)) = ⊤ := by
    have h := CotangentSpace.span_image_eq_top_iff.mpr hgen
    rwa [Set.image_union, Submodule.span_union, ← Set.range_comp] at h
  have hcard : Fintype.card {y // y ∈ G} = (maximalIdeal (R ⧸ I)).spanFinrank := by
    simpa using hGcard
  rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, ← hcard, Nat.add_comm]
  exact finrank_le_finrank_add_card_of_sup_span_range_eq_top _ _ hsup

/-- If `c` is at most the dimension of the image `(I + 𝔪²)/𝔪²` of an ideal `I` of a Noetherian
local ring `R` in the cotangent space, then `𝔪` has a minimal set of generators whose first `c`
members lie in `I`: choose `c` elements of `I` whose classes in `𝔪/𝔪²` are `κ`-linearly
independent, and extend them to a family spanning `𝔪/𝔪²`. -/
private lemma exists_ofList_eq_maximalIdeal_ofList_take_le {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {I : Ideal R} {c : ℕ}
    (hc : c ≤ finrank (ResidueField R) (cotangentImage I)) :
    ∃ xs : List R, Ideal.ofList xs = maximalIdeal R ∧
      xs.length = (maximalIdeal R).spanFinrank ∧ c ≤ xs.length ∧
      Ideal.ofList (xs.take c) ≤ I := by
  classical
  have hd : finrank (ResidueField R) (CotangentSpace R) = (maximalIdeal R).spanFinrank :=
    (spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R).symm
  -- `c` elements of `I`, linearly independent in the cotangent space
  obtain ⟨f, hf⟩ := exists_linearIndependent_of_le_finrank (R := ResidueField R)
    (M := cotangentImage I) hc
  have hfli : LinearIndependent (ResidueField R) fun i => ((f i : CotangentSpace R)) :=
    hf.map' (cotangentImage I).subtype (by simp)
  choose x hxI hxf using fun i => mem_cotangentImage_iff.mp (f i).2
  -- extended by `d - c` further elements of `𝔪` to a minimal set of generators
  obtain ⟨b, hb⟩ := exists_span_range_union_range_eq_top hfli
  choose y hy using fun j => (maximalIdeal R).toCotangent_surjective (b j)
  set xs : List R := List.ofFn (fun i => ((x i : ↥(maximalIdeal R)) : R)) ++
    List.ofFn (fun j => ((y j : ↥(maximalIdeal R)) : R)) with hxs
  have hcd : c ≤ finrank (ResidueField R) (CotangentSpace R) :=
    hc.trans (Submodule.finrank_le _)
  have hlen : xs.length = (maximalIdeal R).spanFinrank := by
    rw [hxs]
    simp only [List.length_append, List.length_ofFn]
    omega
  refine ⟨xs, ?_, hlen, by omega, ?_⟩
  · have hS : span R (Set.range x ∪ Set.range y) = (⊤ : Submodule R ↥(maximalIdeal R)) := by
      refine CotangentSpace.span_image_eq_top_iff.mp ?_
      rw [Set.image_union, ← Set.range_comp, ← Set.range_comp,
        show (⇑(maximalIdeal R).toCotangent ∘ x) = fun i => ((f i : CotangentSpace R)) from
          funext hxf, show (⇑(maximalIdeal R).toCotangent ∘ y) = b from funext hy]
      exact hb
    have h3 := congrArg (Submodule.map (maximalIdeal R).subtype) hS
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, Set.image_union,
      ← Set.range_comp, ← Set.range_comp, Ideal.submodule_span_eq] at h3
    have hsets : {r : R | r ∈ xs} = Set.range (⇑(maximalIdeal R).subtype ∘ x) ∪
        Set.range (⇑(maximalIdeal R).subtype ∘ y) := by
      ext r
      simp [hxs, Function.comp_def]
    change Ideal.span {r : R | r ∈ xs} = maximalIdeal R
    rw [hsets]
    exact h3
  · rw [hxs, List.take_left' List.length_ofFn]
    refine Ideal.span_le.mpr fun r hr => ?_
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hr
    exact hxI i

/-- Nested ideals `J ≤ I` of a commutative ring whose quotients have the same finite Krull
dimension are equal, as soon as `R ⧸ J` is a domain: an element of `I \ J` is a nonzerodivisor of
`R ⧸ J` killed by the surjection `R ⧸ J → R ⧸ I`, which would force
`dim (R ⧸ I) < dim (R ⧸ J)`. -/
public lemma eq_of_le_of_ringKrullDim_quotient_eq {R : Type*} [CommRing R] {J I : Ideal R}
    (hJI : J ≤ I) [IsDomain (R ⧸ J)] {n : ℕ} (hJ : ringKrullDim (R ⧸ J) = n)
    (hI : ringKrullDim (R ⧸ I) = n) : J = I := by
  by_contra hne
  obtain ⟨a, haI, haJ⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hJI hne)
  have hkill : ringKrullDim (R ⧸ I) + 1 ≤ ringKrullDim (R ⧸ J) :=
    ringKrullDim_succ_le_of_surjective (Ideal.Quotient.factor hJI)
      (Ideal.Quotient.factor_surjective hJI)
      (mem_nonZeroDivisors_of_ne_zero fun hcon => haJ (Ideal.Quotient.eq_zero_iff_mem.mp hcon))
      (by simp [Ideal.Quotient.eq_zero_iff_mem.mpr haI])
  rw [hI, hJ] at hkill
  have h : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((n : ℕ) : WithBot ℕ∞) := by push_cast; exact hkill
  simpa using (Nat.cast_le (α := WithBot ℕ∞)).mp h

/-- **Stacks 00NR**: if `R` and `R ⧸ I` are regular local rings, then `I` is generated by a prefix
`x₁, …, x_c` of a minimal generating list of the maximal ideal of `R`, with
`dim (R ⧸ I) + c = dim R`. -/
public theorem solution {R : Type*} [CommRing R] [IsRegularLocalRing R] (I : Ideal R)
    (hI : IsRegularLocalRing (R ⧸ I)) :
    ∃ xs : List R, Ideal.ofList xs = maximalIdeal R ∧
      xs.length = (maximalIdeal R).spanFinrank ∧
      ∃ c ≤ xs.length, Ideal.ofList (xs.take c) = I ∧
        ringKrullDim (R ⧸ I) + c = ringKrullDim R := by
  set d := (maximalIdeal R).spanFinrank with hd
  set e := (maximalIdeal (R ⧸ I)).spanFinrank with he
  have hdimR : (d : WithBot ℕ∞) = ringKrullDim R :=
    hd ▸ IsRegularLocalRing.spanFinrank_maximalIdeal
  have hdimI : (e : WithBot ℕ∞) = ringKrullDim (R ⧸ I) :=
    he ▸ IsRegularLocalRing.spanFinrank_maximalIdeal
  have hedle : e ≤ d := by
    have hq := ringKrullDim_quotient_le (R := R) I
    rw [← hdimR, ← hdimI] at hq
    exact_mod_cast hq
  have hed : e + (d - e) = d := Nat.add_sub_cancel' hedle
  -- a minimal set of generators of `𝔪` whose first `d - e` members lie in `I`
  obtain ⟨xs, hspan, hlen, hcle, hJI⟩ :=
    exists_ofList_eq_maximalIdeal_ofList_take_le (I := I) (c := d - e)
      (by have := spanFinrank_maximalIdeal_le_add_finrank_cotangentImage (R := R) I; omega)
  have hdimIc : ringKrullDim (R ⧸ I) + ((d - e : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
    rw [← hdimI, ← hdimR, ← Nat.cast_add, hed]
  refine ⟨xs, hspan, hlen, d - e, hcle, ?_, hdimIc⟩
  -- `R ⧸ (x₁, …, x_c)` is a regular local ring of the same dimension as `R ⧸ I`, by Stacks 00NQ
  set J := Ideal.ofList (xs.take (d - e))
  obtain ⟨hregJ, hdimJ⟩ :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      R).1 xs hspan hlen |>.2 (d - e) hcle
  have hdom : IsDomain (R ⧸ J) := IsRegularLocalRing.isDomain (R ⧸ J)
  have hJdim : ringKrullDim (R ⧸ J) = ringKrullDim (R ⧸ I) :=
    ENat.WithBot.add_natCast_cancel.mp (hdimJ.trans hdimIc.symm)
  exact eq_of_le_of_ringKrullDim_quotient_eq hJI (hJdim.trans hdimI.symm) hdimI.symm

end Stacks.RegularLocalRing.RegularQuotient

/-!
# An ideal with regular quotient is generated by part of a minimal generating set

Let `(R, 𝔪)` be a regular local ring and let `I ⊆ R` be an ideal such that `R ⧸ I` is a regular
local ring as well. Then `𝔪` admits a minimal set of generators `x₁, …, x_d` such that
`I = (x₁, …, x_c)` for some `0 ≤ c ≤ d`; necessarily `c = dim R - dim (R ⧸ I)`.

The argument is the source's: writing `κ = R ⧸ 𝔪`, regularity of `R` and of `R ⧸ I` gives
`dim_κ ((I + 𝔪 ^ 2) / 𝔪 ^ 2) = dim_κ (𝔪 / 𝔪 ^ 2) - dim_κ (𝔪̄ / 𝔪̄ ^ 2) = d - (d - c) = c`, so one
may pick `x₁, …, x_c ∈ I` with linearly independent images in `𝔪 / 𝔪 ^ 2` and extend them to a
minimal system of generators of `𝔪`. The induced surjection `R ⧸ (x₁, …, x_c) → R ⧸ I` is then a
surjection of regular local rings of the same dimension (Tag 00NQ), hence an isomorphism.

## Main results

* `IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq`:
  an ideal of a regular local ring whose quotient is again a regular local ring is generated by
  an initial segment of a minimal generating list of the maximal ideal, of length
  `dim R - dim (R ⧸ I)`.

## Implementation notes

A "minimal set of generators `x₁, …, x_d` for `𝔪`" is, exactly as in Tag 00NQ, a list
`xs : List R` with `Ideal.ofList xs = 𝔪` whose length is the least possible one,
`(𝔪).spanFinrank`; minimality in this sense needs no regularity to state, and
`IsRegularLocalRing R` forces `xs.length = dim R = d` through
`IsRegularLocalRing.spanFinrank_maximalIdeal`. The subideal `(x₁, …, x_c)` is pinned as
`Ideal.ofList (xs.take c)`, the ideal generated by the first `c` entries of that very list, so
that the conclusion is about an *initial segment* of the chosen minimal system and not about some
unrelated `c`-element subset. Stating the ordered list rather than an unordered generating set is
what makes "the first `c` of them generate `I`" expressible, and is the form of Tag 00NQ.

The source leaves `c` existentially bound ("for some `0 ≤ c ≤ d`"); its own proof identifies
`c = d - dim (R ⧸ I)`. The final conjunct therefore pins `c` by the equation
`dim (R ⧸ I) + c = dim R`, written additively in the shape of Mathlib's
`ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank`: subtraction in `WithBot ℕ∞` is
truncated, whereas the additive form carries the same content with no side condition. That `c`
is in turn the minimal number of generators of `I`, `I.spanFinrank = c`, follows from this
conjunct together with that Mathlib inequality, and is left to the caller.

`IsRegularLocalRing (R ⧸ I)` is an explicit hypothesis rather than an instance argument: `I` is
an arbitrary ideal here, so no synthesis can produce it. It already entails `I ≠ ⊤`, since a
regular local ring is nontrivial; no separate properness hypothesis is needed.

Faithfulness. (1) No hypothesis is dead. `IsRegularLocalRing (R ⧸ I)` is indispensable: in
`R = k⟦x, y⟧` and `I = (xy)` the quotient is not regular and `xy ∈ 𝔪 ^ 2` lies in no minimal
generating set of `𝔪`, so no initial segment generates `I`. `IsRegularLocalRing R` is
indispensable: for the cusp `R = (k[t ^ 2, t ^ 3])_𝔪`, which is local Noetherian of dimension `1`
with `(𝔪).spanFinrank = 2`, and `I = 𝔪`, the quotient `R ⧸ 𝔪 = k` is a regular local ring, yet
the conclusion would force `c = 1` by the dimension equation and hence `𝔪` to be generated by one
element. (2) The scalars and base are the source's throughout: `xs` is a list in `R`, both ideals
are ideals of `R`, and `R ⧸ I` is the quotient of `R` itself — no localization or base change
intervenes. (3) The source names no canonical map; what needs pinning is which ideal
`(x₁, …, x_c)` denotes, and `Ideal.ofList (xs.take c) = I` pins it to the first `c` entries of the
exhibited list, together with the value of `c`. (4) The instantiation is not degenerate: for
`R = k⟦x, y⟧` and `I = (x)` the quotient `k⟦y⟧` is regular, and `xs = [x, y]`, `c = 1` witnesses
the conclusion; `R = k⟦x₁, …, x_d⟧` with `I = (x₁, …, x_c)` witnesses it for every `0 ≤ c ≤ d`.
The extremes occur: `c = 0` gives `I = ⊥`, and `c = d` gives `I = 𝔪` with `R ⧸ I` the residue
field.

## References

* [StacksProject 00NR](https://stacks.math.columbia.edu/tag/00NR)
-/

open IsLocalRing

namespace IsRegularLocalRing

/-- **An ideal of a regular local ring with regular quotient is generated by part of a minimal
set of generators of the maximal ideal.** Let `(R, 𝔪)` be a regular local ring and let `I` be an
ideal of `R` such that `R ⧸ I` is a regular local ring as well. Then there is a list
`xs = x₁, …, x_d` generating `𝔪` of the minimal length `d = (𝔪).spanFinrank` and a `c ≤ d` with
`I = (x₁, …, x_c)`; moreover `dim (R ⧸ I) + c = dim R`, i.e. `c = dim R - dim (R ⧸ I)`. -/
@[stacks 00NR "A minimal set of generators of `𝔪` is a list generating it whose length is \
  `(𝔪).spanFinrank`, and `(x₁, …, x_c)` is the ideal generated by the length-`c` prefix of that \
  list, as in Tag 00NQ. The source's existentially bound `c` is pinned by the dimension \
  equation `dim (R ⧸ I) + c = dim R` proved along with it. See the module docstring."]
public theorem exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
    {R : Type*} [CommRing R] [IsRegularLocalRing R] (I : Ideal R)
    (hI : IsRegularLocalRing (R ⧸ I)) :
    ∃ xs : List R, Ideal.ofList xs = maximalIdeal R ∧
      xs.length = (maximalIdeal R).spanFinrank ∧
      ∃ c ≤ xs.length, Ideal.ofList (xs.take c) = I ∧
        ringKrullDim (R ⧸ I) + c = ringKrullDim R :=
  Stacks.RegularLocalRing.RegularQuotient.solution I hI

end IsRegularLocalRing

/-!
# Being generated by a regular sequence does not depend on the regular local ring

Proof of `IsRegularLocalRing.exists_isRegular_ker_tfae` (Stacks 00SE). Let `A → B → C` be
surjective ring homomorphisms with `A` and `B` regular local rings and `C` nonzero. The following
are equivalent: `Ker(A → C)` is generated by a regular sequence; `dim C + μ(Ker(A → C)) = dim A`;
`Ker(B → C)` is generated by a regular sequence; `dim C + μ(Ker(B → C)) = dim B`. Here `μ(I)` is
the minimal number of generators `Submodule.spanFinrank I`, and the additive equalities express
the source's "generated by `dim A - dim C` (resp. `dim B - dim C`) elements", the inequality `≥`
being Krull's height theorem.

The argument is the source's. A regular local ring is Cohen-Macaulay (Stacks 00NQ), which gives
(1) ⇔ (2) and (3) ⇔ (4): a regular sequence generating an ideal has length `dim A - dim C`
(`ringKrullDim_add_length_eq_ringKrullDim_of_isRegular`) and is therefore a minimal generating
set, while conversely over a Cohen-Macaulay ring an ideal cutting the dimension down by the
number of its generators is generated by a regular sequence (`cohenMacaulay_dimDrop_isRegular`).
By Stacks 00NR the ideal `J = Ker(A → B)` is generated by a prefix `x₁, …, x_c` of a minimal set
of generators `x₁, …, x_d` of `𝔪_A`, with `c = dim A - dim B`; lifting a minimal generating list
of `Ker(B → C)` along the surjection `A → B` and adjoining `x₁, …, x_c` gives
`μ(Ker(A → C)) ≤ c + μ(Ker(B → C))`, which is (4) ⇒ (2).

For (1) ⇒ (4) the source descends along `A → B` by induction on `dim A - dim B`, replacing `A` by
`A/xA` for an `x ∈ J` nonzero in `J/𝔪J`: the composition `J/𝔪J → I/𝔪I → 𝔪/𝔪²` being injective,
such an `x` belongs to a minimal set of generators of `I = Ker(A → C)`, so both `dim A` and
`μ(I)` drop by one. Since Stacks 00NR produces the whole prefix `x₁, …, x_c` at once, the
induction is not needed: the `c` steps are taken together in `spanFinrank_map_add_le`, which is
the injectivity of `J/𝔪J → I/𝔪I → 𝔪/𝔪²` in the form `μ(p(I)) + c ≤ μ(I)` for the surjection
`p : A → B`. Combined with the reverse inequality above this pins `μ(Ker(A → C))` and gives
(2) ⇔ (4) as an equality of natural numbers.

## Main results

* `Stacks.RegularLocalRing.KernelRegularity.solution`: the statement of Stacks 00SE.

## Implementation notes

*The induction of the source is replaced by one application of Nakayama's lemma.* The source
descends one generator at a time because it takes only a single `x ∈ J \ 𝔪 J`. Stacks 00NR hands
over the entire prefix `x₁, …, x_c` of a minimal generating list of `𝔪_A` with
`(x₁, …, x_c) = Ker(A → B)`, and the linear algebra of the source's `J/𝔪J → I/𝔪I → 𝔪/𝔪²` then runs
once for all `c` of them: their images in the residue-field vector space `I/𝔪I` are linearly
independent (`linearIndependent_mkQ_take`), a basis of the quotient of `I/𝔪I` by their span lifts
to `t = μ(I) - c` elements of `I`, and those together with `Ker(A → B)` generate `I` by Nakayama
(`spanFinrank_map_le_of_top_le`), so their images generate `Ker(B → C)`. Both directions of
`dim A - dim B = c` come from Stacks 00NR as well.

*The Cohen-Macaulay input is Stacks 00NQ, transported between two spellings of depth.* Tag 00NQ
delivers `Module.IsMaximalCohenMacaulay A A`, phrased with `Module.depth` (Tag 00LI, whose first
branch sets the depth to `⊤` when `I • M = M`), whereas `cohenMacaulay_dimDrop_isRegular` is
phrased with `IsCohenMacaulay`, that is with `Module.depthSup`. The two agree off that first
branch (`depthSup_eq_depth`), and `𝔪 · A = 𝔪 ≠ A`.

*All three dimensions are natural numbers* (`exists_natCast_eq_ringKrullDim`), by
`ringKrullDim_ne_top` for a Noetherian local ring and `zero_le_ringKrullDim_iff_nontrivial`, so
the four items may be compared by `omega` after casting.

## References

* [StacksProject 00SE](https://stacks.math.columbia.edu/tag/00SE), Lemma 10.135.6.
-/

namespace Stacks.RegularLocalRing.KernelRegularity

open IsLocalRing RingTheory.Sequence

/-- The Krull dimension of a Noetherian local ring is a natural number. -/
theorem exists_natCast_eq_ringKrullDim (R : Type*) [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] : ∃ n : ℕ, ringKrullDim R = (n : WithBot ℕ∞) := by
  have hle : (0 : WithBot ℕ∞) ≤ ringKrullDim R :=
    (zero_le_ringKrullDim_iff_nontrivial (R := R)).mpr inferInstance
  have hbot : ringKrullDim R ≠ ⊥ := by
    intro h; rw [h] at hle; simp at hle
  have htop : ringKrullDim R ≠ ⊤ := ringKrullDim_ne_top
  cases hx : ringKrullDim R with
  | bot => exact absurd hx hbot
  | coe y =>
    cases y with
    | top => exact absurd (by simpa using hx) htop
    | coe n => exact ⟨n, by simp⟩

/-- For a proper ideal `I` of a Noetherian local ring `R`, `dim R ≤ dim (R ⧸ I) + μ(I)`, where
`μ(I)` is the minimal number of generators of `I`: Krull's height theorem. -/
public theorem le_add_spanFinrank {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : I ≠ ⊤) :
    ringKrullDim R ≤ ringKrullDim (R ⧸ I) + (I.spanFinrank : WithBot ℕ∞) := by
  refine ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I ?_
  rw [IsLocalRing.ringJacobson_eq_maximalIdeal R]
  exact IsLocalRing.le_maximalIdeal hI

/-- The kernel of a surjection onto a nontrivial ring is proper. -/
private theorem ker_ne_top {R C : Type*} [CommRing R] [CommRing C] [Nontrivial C]
    (p : R →+* C) : RingHom.ker p ≠ ⊤ := by
  intro h
  have : (1 : C) = 0 := by
    have h1 : (1 : R) ∈ RingHom.ker p := h ▸ Submodule.mem_top
    simp at h1
  exact one_ne_zero this

/-- A list of the minimal length generating an ideal. -/
private theorem exists_list_spanFinrank {R : Type*} [CommRing R] [IsNoetherianRing R]
    (I : Ideal R) : ∃ l : List R, l.length = I.spanFinrank ∧ Ideal.ofList l = I := by
  classical
  obtain ⟨s, hcard, hspan⟩ :=
    (IsNoetherian.noetherian I).exists_span_finset_card_eq_spanFinrank
  refine ⟨s.toList, by simpa using hcard, ?_⟩
  rw [Ideal.ofList, ← hspan]
  congr 1
  ext x
  simp


/-! ### (1) ⇒ (2) and (3) ⇒ (4) -/

private theorem eq_of_isRegular {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    {C : Type*} [CommRing C] [Nontrivial C] {p : R →+* C} (hp : Function.Surjective p)
    {rs : List R} (hrs : IsRegular R rs) (hgen : Ideal.ofList rs = RingHom.ker p) :
    ringKrullDim C + ((RingHom.ker p).spanFinrank : WithBot ℕ∞) = ringKrullDim R := by
  have : IsLocalRing C := IsLocalRing.of_surjective' p hp
  have : IsNoetherianRing C := isNoetherianRing_of_surjective R C p hp
  obtain ⟨dR, hdR⟩ := exists_natCast_eq_ringKrullDim R
  obtain ⟨dC, hdC⟩ := exists_natCast_eq_ringKrullDim C
  have hquot : ringKrullDim (R ⧸ RingHom.ker p) = ringKrullDim C :=
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hp)
  have h1 : ringKrullDim C + (rs.length : WithBot ℕ∞) = ringKrullDim R := by
    have := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hrs
    rwa [hgen, hquot] at this
  have h2 : (RingHom.ker p).spanFinrank ≤ rs.length := by
    rw [← hgen]; exact spanFinrank_ofList_le rs
  have h3 := le_add_spanFinrank (RingHom.ker p) (ker_ne_top p)
  rw [hquot] at h3
  rw [hdC, hdR] at h1 h3 ⊢
  have e1 : dC + rs.length = dR := by exact_mod_cast h1
  have e3 : dR ≤ dC + (RingHom.ker p).spanFinrank := by exact_mod_cast h3
  have : dC + (RingHom.ker p).spanFinrank = dR := by omega
  exact_mod_cast this

/-! ### (2) ⇒ (1) and (4) ⇒ (3) -/

/-- **Depth is the supremum of the lengths of regular sequences whenever `I • M ≠ M`.** The
source's definition of depth (Tag 00LI, `Module.depth`) has a first branch setting the depth to
`⊤` when `I • M = M`; off that branch it is `Module.depthSup`, in whose vocabulary the
Cohen-Macaulay predicate of `StacksFrontier.RingTheory.CohenMacaulay.Module` is phrased. -/
private theorem depthSup_eq_depth {R : Type*} [CommRing R] (I : Ideal R) (M : Type*)
    [AddCommGroup M] [Module R M] (h : I • (⊤ : Submodule R M) ≠ ⊤) :
    Module.depthSup R I M = Module.depth R I M := by
  rw [Module.depth, Module.depthSup_eq_iSup]
  split_ifs with hc
  · exact absurd hc h
  · rfl

/-- **A regular local ring is Cohen-Macaulay** (Stacks 00NQ, final conjunct), transported into the
vocabulary of `StacksFrontier.RingTheory.CohenMacaulay.Module`: the dimension of
`Supp(R) = Spec R` equals the depth of `R` along its maximal ideal. Tag 00NQ delivers
`Module.IsMaximalCohenMacaulay R R`, that is `depth_𝔪(R) = dim R` with the depth of Tag 00LI;
`dim Supp(R) = dim R` is `Module.supportDim_self_eq_ringKrullDim`, and the two spellings of depth
agree because `𝔪 · R = 𝔪 ≠ R`. -/
@[ega "IV 7.3.9" "(i)", sga "2 IV 5.3"]
private theorem isCohenMacaulay_self_of_isRegularLocalRing (R : Type*) [CommRing R]
    [IsRegularLocalRing R] : IsCohenMacaulay R R := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have hmcm :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay R).2
  rw [Module.IsMaximalCohenMacaulay] at hmcm
  have hne : maximalIdeal R • (⊤ : Submodule R R) ≠ ⊤ := by
    simpa using (maximalIdeal.isMaximal R).ne_top
  change Module.supportDim R R = (Module.depthSup R (maximalIdeal R) R : WithBot ℕ∞)
  rw [Module.supportDim_self_eq_ringKrullDim, ← hmcm, depthSup_eq_depth _ _ hne]

private theorem exists_isRegular_of_eq {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {C : Type*} [CommRing C] [Nontrivial C] {p : R →+* C} (hp : Function.Surjective p)
    (h : ringKrullDim C + ((RingHom.ker p).spanFinrank : WithBot ℕ∞) = ringKrullDim R) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker p := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have : IsLocalRing C := IsLocalRing.of_surjective' p hp
  have : IsNoetherianRing C := isNoetherianRing_of_surjective R C p hp
  obtain ⟨gs, hgslen, hgsgen⟩ := exists_list_spanFinrank (RingHom.ker p)
  refine ⟨gs, ?_, hgsgen⟩
  obtain ⟨d, hd⟩ := exists_natCast_eq_ringKrullDim R
  obtain ⟨dC, hdC⟩ := exists_natCast_eq_ringKrullDim C
  have hsum : dC + gs.length = d := by
    rw [hdC, hd] at h
    have h' : dC + (RingHom.ker p).spanFinrank = d := by exact_mod_cast h
    omega
  have hmem : ∀ g ∈ gs, g ∈ maximalIdeal R := by
    intro g hg
    refine IsLocalRing.le_maximalIdeal (ker_ne_top p) ?_
    rw [← hgsgen]
    exact Ideal.subset_span hg
  have hquot : ringKrullDim (R ⧸ RingHom.ker p) = ringKrullDim C :=
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hp)
  have hsmul : Ideal.ofList gs • (⊤ : Submodule R R) = RingHom.ker p := by
    rw [← hgsgen]; simp
  have hdd : dC = d - gs.length := by omega
  refine cohenMacaulay_dimDrop_isRegular d gs.length (by omega)
    (by rw [Module.supportDim_self_eq_ringKrullDim, hd])
    (isCohenMacaulay_self_of_isRegularLocalRing R) gs rfl hmem ?_
  rw [hsmul, Module.supportDim_quotient_eq_ringKrullDim, hquot, hdC, hdd]

/-! ### The key inequality

The minimal number of generators of an ideal `I` of a local ring `(A, 𝔪)` is the dimension of
`I ⧸ 𝔪 I` over the residue field `κ = A ⧸ 𝔪`
(`IsLocalRing.spanFinrank_eq_finrank_quotient`), and the lemmas below compute inside that
`κ`-vector space: `linearIndependent_mkQ_take` says that a prefix of a minimal system of
generators of `𝔪` stays linearly independent there, and `spanFinrank_map_le_of_top_le` converts
a spanning family of the quotient by the subspace it cuts out back into a generating set of the
image ideal.
-/

/-- On `M ⧸ I • M`, the `A`-action is the restriction of the `A ⧸ I`-action. -/
public theorem isScalarTower_quotient_smul_top {A : Type*} [CommRing A] {M : Type*}
    [AddCommGroup M] [Module A M] (I : Ideal A) :
    IsScalarTower A (A ⧸ I) (M ⧸ I • (⊤ : Submodule A M)) := by
  refine ⟨fun a b v => ?_⟩
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective (I • (⊤ : Submodule A M)) v
  change Ideal.Quotient.mk I (a • b) • _ = _
  rw [Module.Quotient.mk_smul_mk, Module.Quotient.mk_smul_mk, smul_assoc]
  rfl

/-- The algebra map `A → A ⧸ I` is surjective. -/
public theorem surjective_algebraMap_quotient {A : Type*} [CommRing A] (I : Ideal A) :
    Function.Surjective (algebraMap A (A ⧸ I)) := by
  rw [Ideal.Quotient.algebraMap_eq]
  exact Ideal.Quotient.mk_surjective

/-- The images of a generating family of `I` generate `I ⧸ T` for any `T ≤ I`. -/
private theorem span_range_mkQ_eq_top {A : Type*} [CommRing A] (I : Ideal A)
    (T : Submodule A ↥I) {ι : Type*} (y : ι → ↥I) (hy : Submodule.span A (Set.range y) = ⊤) :
    Submodule.span A (Set.range fun i => T.mkQ (y i)) = ⊤ := by
  have h1 : (Set.range fun i => T.mkQ (y i)) = T.mkQ '' Set.range y := by
    rw [← Set.range_comp]; rfl
  rw [h1, ← Submodule.map_span, hy, Submodule.map_top, Submodule.range_mkQ]

/-- A list generating an ideal `I` generates `I` as a module over itself. -/
public theorem span_range_eq_top_of_ofList {A : Type*} [CommRing A] (I : Ideal A) (xs : List A)
    (hxs : Ideal.ofList xs = I) (y : Fin xs.length → ↥I) (hy : ∀ i, (y i : A) = xs[(i : ℕ)]) :
    Submodule.span A (Set.range y) = ⊤ := by
  apply Submodule.map_injective_of_injective (Submodule.injective_subtype I)
  rw [Submodule.map_span, Submodule.map_subtype_top]
  have h : (I.subtype) '' Set.range y = {x | x ∈ xs} := by
    rw [← Set.range_comp]
    ext x
    simp only [Set.mem_range, Function.comp_apply, Set.mem_ofPred_eq, List.mem_iff_getElem,
      Submodule.subtype_apply]
    exact ⟨fun ⟨i, h⟩ => ⟨i, i.isLt, by rw [← h, hy]⟩,
      fun ⟨i, hi, h⟩ => ⟨⟨i, hi⟩, by rw [hy]; exact h⟩⟩
  rw [h]
  exact hxs

/-- **A minimal system of generators of `𝔪` is a basis of the cotangent space.** A generating
family of `𝔪 ⧸ 𝔪 ²` of cardinality `dim_κ (𝔪 ⧸ 𝔪 ²) = (𝔪).spanFinrank` is linearly
independent. -/
public theorem linearIndependent_mkQ_of_length_eq_spanFinrank
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (xs : List A) (hxs : Ideal.ofList xs = maximalIdeal A)
    (hlen : xs.length = (maximalIdeal A).spanFinrank)
    (y : Fin xs.length → ↥(maximalIdeal A)) (hy : ∀ i, (y i : A) = xs[(i : ℕ)]) :
    LinearIndependent (A ⧸ maximalIdeal A)
      (fun i => (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A)).mkQ (y i)) := by
  have := isScalarTower_quotient_smul_top (M := ↥(maximalIdeal A)) (maximalIdeal A)
  refine linearIndependent_of_top_le_span_of_card_eq_finrank ?_ ?_
  · rw [top_le_iff, ← Submodule.restrictScalars_eq_top_iff A,
      Submodule.restrictScalars_span A _ (surjective_algebraMap_quotient _)]
    exact span_range_mkQ_eq_top _ _ y (span_range_eq_top_of_ofList _ xs hxs y hy)
  · rw [Fintype.card_fin, hlen,
      IsLocalRing.spanFinrank_eq_finrank_quotient (maximalIdeal A)
        (IsNoetherian.noetherian (maximalIdeal A))]

/-- **A prefix of a minimal system of generators of `𝔪` stays independent in `I ⧸ 𝔪 I`.** For an
ideal `I ≤ 𝔪` containing `x₁, …, x_c`, the images of `x₁, …, x_c` in `I ⧸ 𝔪 I` are linearly
independent over the residue field: they already are in `𝔪 ⧸ 𝔪 ²` by
`linearIndependent_mkQ_of_length_eq_spanFinrank`, and `I ⧸ 𝔪 I → 𝔪 ⧸ 𝔪 ²` is a
`κ`-linear map carrying the one family to the other. -/
private theorem linearIndependent_mkQ_take
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (xs : List A) (hxs : Ideal.ofList xs = maximalIdeal A)
    (hlen : xs.length = (maximalIdeal A).spanFinrank)
    {I : Ideal A} (hI : I ≤ maximalIdeal A) {c : ℕ} (hc : c ≤ xs.length)
    (y : Fin c → ↥I) (hy : ∀ i : Fin c, (y i : A) = xs[(i : ℕ)]) :
    LinearIndependent (A ⧸ maximalIdeal A)
      (fun i => (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (y i)) := by
  have := isScalarTower_quotient_smul_top (M := ↥I) (maximalIdeal A)
  have := isScalarTower_quotient_smul_top (M := ↥(maximalIdeal A)) (maximalIdeal A)
  set ym : Fin xs.length → ↥(maximalIdeal A) := fun i =>
    ⟨xs[(i : ℕ)], by rw [← hxs]; exact Ideal.subset_span (List.getElem_mem i.isLt)⟩ with hym
  have hle : (maximalIdeal A • ⊤ : Submodule A ↥I) ≤ Submodule.comap (Submodule.inclusion hI)
      (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A)) := by
    rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
    exact Submodule.smul_mono le_rfl le_top
  set φ := ((maximalIdeal A • ⊤ : Submodule A ↥I).mapQ
      (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A)) (Submodule.inclusion hI)
      hle).extendScalarsOfSurjective (surjective_algebraMap_quotient (maximalIdeal A)) with hφ
  refine LinearIndependent.of_comp φ ?_
  have hcomp : (φ ∘ fun i => (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (y i)) =
      (fun i => (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A)).mkQ (ym i)) ∘
        Fin.castLE hc := by
    funext i
    simp only [Function.comp_apply, hφ]
    change (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A)).mkQ _ = _
    congr 1
    exact Subtype.ext (hy i)
  rw [hcomp]
  exact (linearIndependent_mkQ_of_length_eq_spanFinrank xs hxs hlen ym
    (fun i => rfl)).comp _ (Fin.castLE_injective hc)

private theorem ncard_range_le {B : Type*} {t : ℕ} (f : Fin t → B) : (Set.range f).ncard ≤ t := by
  classical
  have h : Set.range f = ((Finset.univ.image f : Finset B) : Set B) := by simp
  rw [h, Set.ncard_coe_finset]
  simpa using Finset.card_image_le (s := (Finset.univ : Finset (Fin t))) (f := f)

/-- **Nakayama, in the form used below.** If `t` elements of `I` together with `Ker p` and `𝔪 I`
generate `I`, then their images generate `p(I)`, so `p(I)` needs at most `t` generators. -/
private theorem spanFinrank_map_le_of_top_le
    {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsNoetherianRing A]
    {p : A →+* B} {I : Ideal A} (hJI : RingHom.ker p ≤ I) {t : ℕ} (z : Fin t → ↥I)
    (h : (⊤ : Submodule A ↥I) ≤
      (Submodule.span A (Set.range z) ⊔ Submodule.comap I.subtype (RingHom.ker p)) ⊔
        maximalIdeal A • (⊤ : Submodule A ↥I)) :
    (I.map p).spanFinrank ≤ t := by
  have hnak : (⊤ : Submodule A ↥I) ≤
      Submodule.span A (Set.range z) ⊔ Submodule.comap I.subtype (RingHom.ker p) := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot ((Submodule.fg_top I).mpr
      (IsNoetherian.noetherian I)) ?_ h
    exact le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).symm
  have htop : (⊤ : Submodule A ↥I) =
      Submodule.span A (Set.range z) ⊔ Submodule.comap I.subtype (RingHom.ker p) :=
    le_antisymm hnak le_top
  have himg : (I.subtype) '' Set.range z = Set.range fun j => (z j : A) := by
    rw [← Set.range_comp]; rfl
  have hIeq : I = Ideal.span (Set.range fun j => (z j : A)) ⊔ RingHom.ker p := by
    have h2 := congrArg (Submodule.map I.subtype) htop
    rwa [Submodule.map_subtype_top, Submodule.map_sup, Submodule.map_span, himg,
      Submodule.map_comap_eq, Submodule.range_subtype, inf_eq_right.mpr hJI] at h2
  have hker : Ideal.map p (RingHom.ker p) = ⊥ := by rw [Ideal.map_eq_bot_iff_le_ker]
  have hmap : I.map p = Ideal.span (Set.range fun j => p (z j : A)) := by
    conv_lhs => rw [hIeq]
    rw [Ideal.map_sup, Ideal.map_span, hker, sup_bot_eq, ← Set.range_comp]
    rfl
  rw [hmap]
  exact le_trans (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _))
    (ncard_range_le _)

/-- **A basis of `V ⧸ S` lifted to `V`.** Over a division ring, a finite-dimensional module `V`
is spanned by a submodule `S` together with `dim (V ⧸ S)` further vectors: lift a basis of
`V ⧸ S` along the projection. -/
private theorem exists_span_range_sup_eq_top {K V : Type*} [DivisionRing K] [AddCommGroup V]
    [Module K V] [Module.Finite K V] (S : Submodule K V) :
    ∃ z : Fin (Module.finrank K (V ⧸ S)) → V, Submodule.span K (Set.range z) ⊔ S = ⊤ := by
  classical
  set b := Module.finBasis K (V ⧸ S) with hbd
  refine ⟨fun j => Function.surjInv S.mkQ_surjective (b j), ?_⟩
  have hz : ∀ j, S.mkQ (Function.surjInv S.mkQ_surjective (b j)) = b j :=
    fun j => Function.surjInv_eq S.mkQ_surjective (b j)
  have hmap : Submodule.map S.mkQ (Submodule.span K
      (Set.range fun j => Function.surjInv S.mkQ_surjective (b j))) = ⊤ := by
    rw [Submodule.map_span]
    have himg : (S.mkQ '' Set.range fun j => Function.surjInv S.mkQ_surjective (b j))
        = Set.range b := by
      rw [← Set.range_comp]
      exact congrArg Set.range (funext hz)
    rw [himg, b.span_eq]
  have h := Submodule.comap_map_eq S.mkQ (Submodule.span K
    (Set.range fun j => Function.surjInv S.mkQ_surjective (b j)))
  rw [hmap, Submodule.comap_top, Submodule.ker_mkQ] at h
  exact h.symm

/-- **The minimal number of generators drops by the full amount.** Let `(A, 𝔪)` be a Noetherian
local ring, let `x₁, …, x_d` be a minimal set of generators of `𝔪`, and let `p : A → B` be a ring
homomorphism whose kernel is `(x₁, …, x_c)`. Then for every ideal `I` with `Ker(p) ≤ I ≤ 𝔪` the
ideal `p(I)` needs at least `c` fewer generators than `I`. The reverse inequality is the easy one,
a generating list of `p(I)` being liftable to `A`, and is proved where it is used.

Write `k = A ⧸ 𝔪`. By Nakayama the minimal number of generators of `I` is the `k`-dimension of
`I ⧸ 𝔪 I`, and the images of `x₁, …, x_c` there are linearly independent over `k`
(`linearIndependent_mkQ_take`, which is where minimality of `x₁, …, x_d` enters): they already are
in `𝔪 ⧸ 𝔪 ²`, a spanning family of the cotangent space of cardinality its dimension being a basis,
and `I ⧸ 𝔪 I → 𝔪 ⧸ 𝔪 ²` is `k`-linear since `𝔪 I ≤ 𝔪 ²`. So the subspace `S` they span has
dimension `c` and the quotient `(I ⧸ 𝔪 I) ⧸ S` has dimension `t = dim_k (I ⧸ 𝔪 I) - c`. Lifting a
basis of that quotient to `t` elements `z₁, …, z_t` of `I` (`exists_span_range_sup_eq_top`), the
`x_i` and the `z_j` together span `I ⧸ 𝔪 I` over `k`, hence over `A`; by Nakayama they generate
`I`, so `z₁, …, z_t` generate `I` modulo `Ker p` and their images generate `p(I)`, which therefore
needs at most `t` generators (`spanFinrank_map_le_of_top_le`). -/
private theorem spanFinrank_map_add_le
    {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsNoetherianRing A]
    {p : A →+* B} (xs : List A) (hxs : Ideal.ofList xs = maximalIdeal A)
    (hlen : xs.length = (maximalIdeal A).spanFinrank)
    {c : ℕ} (hc : c ≤ xs.length) (hker : Ideal.ofList (xs.take c) = RingHom.ker p)
    {I : Ideal A} (hJI : RingHom.ker p ≤ I) (hI : I ≤ maximalIdeal A) :
    (I.map p).spanFinrank + c ≤ I.spanFinrank := by
  classical
  let _inst : Field (A ⧸ maximalIdeal A) := Ideal.Quotient.field _
  have hst := isScalarTower_quotient_smul_top (M := ↥I) (maximalIdeal A)
  -- `x₁, …, x_c` lie in `Ker p`, hence in `I`
  have hmem : ∀ i : Fin c, xs[(i : ℕ)]'(lt_of_lt_of_le i.isLt hc) ∈ RingHom.ker p := by
    intro i
    rw [← hker]
    refine Ideal.subset_span ?_
    have hi : (i : ℕ) < (xs.take c).length := by rw [List.length_take]; omega
    have h := List.getElem_mem hi
    rwa [List.getElem_take] at h
  set y : Fin c → ↥I := fun i => ⟨xs[(i : ℕ)]'(lt_of_lt_of_le i.isLt hc), hJI (hmem i)⟩ with hyd
  -- their images are a linearly independent family in the `k`-vector space `I ⧸ 𝔪 I`
  have hindep := linearIndependent_mkQ_take xs hxs hlen hI hc y (fun i => rfl)
  have hfin : Module.Finite (A ⧸ maximalIdeal A)
      (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) :=
    Module.Finite.of_restrictScalars_finite A (A ⧸ maximalIdeal A) _
  set S : Submodule (A ⧸ maximalIdeal A) (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) :=
    Submodule.span (A ⧸ maximalIdeal A)
      (Set.range fun i => (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (y i)) with hSd
  have hSrank : Module.finrank (A ⧸ maximalIdeal A) S = c := by
    rw [hSd, finrank_span_eq_card hindep, Fintype.card_fin]
  have hVrank : Module.finrank (A ⧸ maximalIdeal A)
      (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) = I.spanFinrank :=
    (IsLocalRing.spanFinrank_eq_finrank_quotient I (IsNoetherian.noetherian I)).symm
  -- so the quotient by it has dimension `spanFinrank I - c`
  have hsum : Module.finrank (A ⧸ maximalIdeal A)
      ((↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) ⧸ S) + c = I.spanFinrank := by
    rw [← hSrank, ← hVrank]
    exact Submodule.finrank_quotient_add_finrank S
  -- lift a basis of that quotient to `I`
  obtain ⟨w, hw⟩ := exists_span_range_sup_eq_top S
  set z : Fin (Module.finrank (A ⧸ maximalIdeal A)
      ((↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) ⧸ S)) → ↥I :=
    fun j => Function.surjInv (Submodule.mkQ_surjective _) (w j) with hzd
  have hz : ∀ j, (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (z j) = w j :=
    fun j => Function.surjInv_eq (Submodule.mkQ_surjective _) (w j)
  have hrange : (Set.range fun j => (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (z j))
      = Set.range w := congrArg Set.range (funext hz)
  -- the `x_i` and the `z_j` together generate `I ⧸ 𝔪 I` over `k`, hence over `A`
  have hspanA : Submodule.span A
      ((Set.range fun j => (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (z j)) ∪
        (Set.range fun i => (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ (y i))) = ⊤ := by
    rw [← Submodule.restrictScalars_span A (A ⧸ maximalIdeal A)
      (surjective_algebraMap_quotient (maximalIdeal A)), Submodule.span_union, hrange, ← hSd, hw,
      Submodule.restrictScalars_top]
  have hmapY : Submodule.map (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ
      (Submodule.span A (Set.range z ∪ Set.range y)) = ⊤ := by
    rw [Submodule.map_span, Set.image_union, ← Set.range_comp, ← Set.range_comp]
    exact hspanA
  have hcomap := Submodule.comap_map_eq (maximalIdeal A • ⊤ : Submodule A ↥I).mkQ
    (Submodule.span A (Set.range z ∪ Set.range y))
  rw [hmapY, Submodule.comap_top, Submodule.ker_mkQ] at hcomap
  have hyker : Submodule.span A (Set.range y) ≤ Submodule.comap I.subtype (RingHom.ker p) := by
    rw [Submodule.span_le]
    rintro v ⟨i, rfl⟩
    exact Submodule.mem_comap.mpr (hmem i)
  have hfinal : (⊤ : Submodule A ↥I) ≤
      (Submodule.span A (Set.range z) ⊔ Submodule.comap I.subtype (RingHom.ker p)) ⊔
        maximalIdeal A • (⊤ : Submodule A ↥I) := by
    refine le_trans (le_of_eq hcomap) ?_
    rw [Submodule.span_union]
    exact sup_le_sup_right (sup_le_sup_left hyker _) _
  have hkey := spanFinrank_map_le_of_top_le hJI z hfinal
  omega

/-! ### The theorem -/

/-- **Stacks 00SE**: for surjections `A → B → C` with `A` and `B` regular local and `C`
nontrivial, the kernel of `A → C` is generated by a regular sequence iff it is generated by
`dim A - dim C` elements, iff the kernel of `B → C` is generated by a regular sequence, iff it is
generated by `dim B - dim C` elements. -/
public theorem solution
    {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    [IsRegularLocalRing A] [IsRegularLocalRing B] [Nontrivial C]
    {f : A →+* B} {g : B →+* C} (hf : Function.Surjective f) (hg : Function.Surjective g) :
    List.TFAE
      [∃ rs : List A, RingTheory.Sequence.IsRegular A rs ∧
          Ideal.ofList rs = RingHom.ker (g.comp f),
        ringKrullDim C + (RingHom.ker (g.comp f)).spanFinrank = ringKrullDim A,
        ∃ rs : List B, RingTheory.Sequence.IsRegular B rs ∧ Ideal.ofList rs = RingHom.ker g,
        ringKrullDim C + (RingHom.ker g).spanFinrank = ringKrullDim B] := by
  classical
  have hgf : Function.Surjective (g.comp f) := hg.comp hf
  have : IsLocalRing C := IsLocalRing.of_surjective' _ hgf
  have : IsNoetherianRing C := isNoetherianRing_of_surjective A C (g.comp f) hgf
  have eAB : (A ⧸ RingHom.ker f) ≃+* B := RingHom.quotientKerEquivOfSurjective hf
  have hregJ : IsRegularLocalRing (A ⧸ RingHom.ker f) := IsRegularLocalRing.of_ringEquiv eAB.symm
  obtain ⟨xs, hxs, hxslen, c, hc, hxsc, hdimJ⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
      (RingHom.ker f) hregJ
  obtain ⟨dA, hdA⟩ := exists_natCast_eq_ringKrullDim A
  obtain ⟨dB, hdB⟩ := exists_natCast_eq_ringKrullDim B
  obtain ⟨dC, hdC⟩ := exists_natCast_eq_ringKrullDim C
  have hquotA : ringKrullDim (A ⧸ RingHom.ker (g.comp f)) = ringKrullDim C :=
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hgf)
  have hquotB : ringKrullDim (B ⧸ RingHom.ker g) = ringKrullDim C :=
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hg)
  have hquotJ : ringKrullDim (A ⧸ RingHom.ker f) = ringKrullDim B :=
    ringKrullDim_eq_of_ringEquiv eAB
  have hABc : dB + c = dA := by
    rw [hquotJ, hdB, hdA] at hdimJ; exact_mod_cast hdimJ
  have hKrullA : dA ≤ dC + (RingHom.ker (g.comp f)).spanFinrank := by
    have h := le_add_spanFinrank (RingHom.ker (g.comp f)) (ker_ne_top _)
    rw [hquotA, hdA, hdC] at h; exact_mod_cast h
  have hKrullB : dB ≤ dC + (RingHom.ker g).spanFinrank := by
    have h := le_add_spanFinrank (RingHom.ker g) (ker_ne_top _)
    rw [hquotB, hdB, hdC] at h; exact_mod_cast h
  have hkey : (RingHom.ker g).spanFinrank + c ≤ (RingHom.ker (g.comp f)).spanFinrank := by
    have hJI : RingHom.ker f ≤ RingHom.ker (g.comp f) := by
      intro a ha
      simp only [RingHom.mem_ker, RingHom.coe_comp, Function.comp_apply] at ha ⊢
      rw [ha, map_zero]
    have h := spanFinrank_map_add_le xs hxs hxslen hc hxsc hJI
      (IsLocalRing.le_maximalIdeal (ker_ne_top (g.comp f)))
    have hmap : Ideal.map f (RingHom.ker (g.comp f)) = RingHom.ker g := by
      have hcm : RingHom.ker (g.comp f) = Ideal.comap f (RingHom.ker g) := rfl
      rw [hcm, Ideal.map_comap_of_surjective f hf]
    rwa [hmap] at h
  obtain ⟨lK, hlKlen, hlKgen⟩ := exists_list_spanFinrank (RingHom.ker g)
  have hmapA : (lK.map (Function.surjInv hf)).map f = lK := by
    rw [List.map_map]
    refine List.map_id'' ?_ _
    intro x
    exact Function.surjInv_eq hf x
  have hIeq : RingHom.ker (g.comp f)
      = Ideal.ofList (xs.take c ++ lK.map (Function.surjInv hf)) := by
    rw [Ideal.ofList_append, hxsc]
    have hm : Ideal.map f (Ideal.ofList (lK.map (Function.surjInv hf))) = RingHom.ker g := by
      rw [Ideal.map_ofList, hmapA, hlKgen]
    have : RingHom.ker (g.comp f)
        = Ideal.comap f (Ideal.map f (Ideal.ofList (lK.map (Function.surjInv hf)))) := by
      rw [hm]; rfl
    rw [this, Ideal.comap_map_of_surjective f hf, sup_comm]
    rfl
  have heasy : (RingHom.ker (g.comp f)).spanFinrank ≤ c + (RingHom.ker g).spanFinrank := by
    rw [hIeq]
    refine le_trans (spanFinrank_ofList_le _) ?_
    simp [hlKlen, hc]
  tfae_have 1 → 2 := fun h => eq_of_isRegular hgf h.choose_spec.1 h.choose_spec.2
  tfae_have 2 → 1 := fun h => exists_isRegular_of_eq hgf h
  tfae_have 3 → 4 := fun h => eq_of_isRegular hg h.choose_spec.1 h.choose_spec.2
  tfae_have 4 → 3 := fun h => exists_isRegular_of_eq hg h
  tfae_have 2 → 4 := by
    intro h
    rw [hdC, hdA] at h
    rw [hdC, hdB]
    have h2 : dC + (RingHom.ker (g.comp f)).spanFinrank = dA := by exact_mod_cast h
    have : dC + (RingHom.ker g).spanFinrank = dB := by omega
    exact_mod_cast this
  tfae_have 4 → 2 := by
    intro h
    rw [hdC, hdB] at h
    rw [hdC, hdA]
    have h4 : dC + (RingHom.ker g).spanFinrank = dB := by exact_mod_cast h
    have : dC + (RingHom.ker (g.comp f)).spanFinrank = dA := by omega
    exact_mod_cast this
  tfae_finish

end Stacks.RegularLocalRing.KernelRegularity

/-!
# Being generated by a regular sequence does not depend on the regular local ring

Let `A → B → C` be surjective local ring homomorphisms and assume `A` and `B` are regular local
rings. Then `Ker(A → C)` is generated by a regular sequence if and only if `Ker(B → C)` is, and
each of these is equivalent to the numerical condition that the ideal be generated by as many
elements as the drop in dimension: `dim A - dim C` elements for `Ker(A → C)`, and
`dim B - dim C` elements for `Ker(B → C)`.

The source's proof. A regular local ring is Cohen–Macaulay (Lemma 00NQ), so (1) ⇔ (2) and
(3) ⇔ (4) by Proposition 00N6. The ideal `Ker(A → B)` can be generated by `dim A - dim B`
elements (Lemma 00NR), whence (4) ⇒ (2). For (1) ⇒ (4) one descends along `A → B` by induction
on `dim A - dim B`: writing `I = Ker(A → C)` and `J = Ker(A → B) ⊆ I`, the composition
`J/𝔪J → I/𝔪I → 𝔪/𝔪²` is injective (Lemma 00NR and its proof), so an `x ∈ J` which is nonzero in
`J/𝔪J` belongs to a minimal set of generators of `I` by Nakayama's lemma; passing to `A/xA` and
`I/xA` drops both `dim A` and the minimal number of generators of `I` by one.

This is why the notion of a complete intersection (Definition 00SD) does not depend on the chosen
presentation.

## Main results

* `IsRegularLocalRing.exists_isRegular_ker_tfae`: the equivalence of the source's (1)–(4), in
  that order.

## Implementation notes

*"Generated by `dim A - dim C` elements" is stated additively, as
`ringKrullDim C + (RingHom.ker (g.comp f)).spanFinrank = ringKrullDim A`.* Krull dimensions live
in `WithBot ℕ∞`, where subtraction is truncated, so the difference `dim A - dim C` is not
available as such. It is not needed: the inequality
`ringKrullDim A ≤ ringKrullDim C + (RingHom.ker (g.comp f)).spanFinrank` holds under these
hypotheses always, being Krull's height theorem
(`ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank` for the ideal `Ker(A → C)`, which lies
in `Ring.jacobson A = 𝔪_A` since it is proper, transported along
`A ⧸ Ker(A → C) ≃+* C`), so the equality above says exactly that the minimal number of
generators of `Ker(A → C)` attains the lower bound `dim A - dim C`, which is the source's
assertion — all three dimensions being natural numbers, by `ringKrullDim_ne_top` for a Noetherian
local ring and `zero_le_ringKrullDim_iff_nontrivial`. Stating it this way needs no auxiliary
`c : ℕ` with `dim A = dim C + c`, so a caller has nothing to supply and nothing to discharge.

*The minimal number of generators is `Submodule.spanFinrank`,* as in Lemma 00SC. Both kernels are
finitely generated, `A` and `B` being Noetherian, and `I.spanFinrank ≤ n` holds precisely when
`I` is generated by `n` elements (a shorter generating list is padded with zeros), so this is the
source's "can be generated by `n` elements".

*Regular sequences are lists, with the ideal they generate spelled `Ideal.ofList`,* following
Mathlib's `RingTheory.Sequence.IsRegular`, which is Definition 00LF for the module `M = R`: no
length is imposed in items (1) and (3), the equivalence forcing it to be the drop in dimension
(`ringKrullDim_add_length_eq_ringKrullDim_of_isRegular`).

*The source's hypothesis that the two maps be local homomorphisms is not stated, being a
consequence of surjectivity* (`Function.Surjective.isLocalHom`: the kernel of a surjection onto a
nontrivial ring is a proper ideal, hence contained in the maximal ideal).

*`C` carries only `Nontrivial`, not `IsLocalRing`, the latter being a consequence*
(`IsLocalRing.of_surjective'`). Nontriviality is not dropped: it is the part of the source's
hypothesis on `C` that the dimension theory of `C` uses, and every caller with a local `C` has it
for free.

Faithfulness. (1) No hypothesis is dead: `IsRegularLocalRing A` is what items (1) and (2) are
about and is used in relating them, `IsRegularLocalRing B` likewise for (3) and (4), the
surjectivity of `f` is what makes `B` a quotient `A/J` and is what the descent along `A → B` uses
— without it the statement would assert an independence of the presentation that the source
proves only later and by other means — the surjectivity of `g` presents `C` as a quotient of `B`,
and `Nontrivial C` keeps `dim C` from being `⊥`. (2) There are no scalars to get wrong; the two
regular sequences are regular *on the ring in which they lie* (`IsRegular A rs` is regularity for
the module `A`, and `IsRegular B rs` for `B`), and the three dimensions are the Krull dimensions
of `A`, `B` and `C` themselves. (3) The ideals are pinned, not merely asserted to exist: they are
the kernels of the given maps, `Ker(A → C)` being the kernel of the composite `g.comp f`, which
is the source's `A → C`, and `Ker(B → C)` that of `g`. (4) The instantiation is not degenerate,
and both truth values occur: for `A = k[[x, y]]`, `B = A/(x) ≅ k[[y]]` and `C = k` all four hold
(`Ker(A → C) = (x, y)` with `0 + 2 = 2 = dim A`, `Ker(B → C) = (y)` with `0 + 1 = 1 = dim B`),
while for `A = B = k[[x, y]]` and `C = A/(x², xy)` all four fail, `(x², xy) = x · (x, y)` having
minimal number of generators `2` and radical `(x)`, so that `dim C + 2 = 1 + 2 ≠ 2 = dim A`.

## References

* [StacksProject 00SE](https://stacks.math.columbia.edu/tag/00SE), Lemma 10.135.6
  (`algebra-lemma-ci-well-defined`), in the section "Local complete intersections". Definition
  00LF of a regular sequence is Mathlib's `RingTheory.Sequence.IsRegular`, and the notion whose
  well-definedness is at stake is Definition 00SD, `IsCompleteIntersection`.
-/


/-- **Stacks 00SE.** Let `A → B → C` be surjective local ring homomorphisms with `A` and `B`
regular local rings. Then the following are equivalent: `Ker(A → C)` is generated by a regular
sequence; `Ker(A → C)` is generated by `dim A - dim C` elements; `Ker(B → C)` is generated by a
regular sequence; `Ker(B → C)` is generated by `dim B - dim C` elements.

Being generated by `n` elements is `Submodule.spanFinrank ≤ n`, stated here in the equivalent
additive form `dim C + spanFinrank (Ker) = dim A` (respectively `= dim B`), since the reverse
inequality is Krull's height theorem. See the module docstring. -/
@[stacks 00SE "Items (1)-(4) are the four items of the list, in the source's order. `Ker(A → C)`
is `RingHom.ker (g.comp f)`. `Generated by dim A - dim C elements` is the equality
`ringKrullDim C + (RingHom.ker (g.comp f)).spanFinrank = ringKrullDim A`: subtraction in
`WithBot ℕ∞` is truncated, while the inequality `≤` always holds here by Krull's height theorem,
so the equality says exactly that the minimal number of generators attains `dim A - dim C`. The
source's hypotheses that the maps be local homomorphisms and that `C` be local are omitted, all
three being consequences of surjectivity. See the module docstring."]
public theorem IsRegularLocalRing.exists_isRegular_ker_tfae
    {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    [IsRegularLocalRing A] [IsRegularLocalRing B] [Nontrivial C]
    {f : A →+* B} {g : B →+* C} (hf : Function.Surjective f) (hg : Function.Surjective g) :
    List.TFAE
      [∃ rs : List A, RingTheory.Sequence.IsRegular A rs ∧
          Ideal.ofList rs = RingHom.ker (g.comp f),
        ringKrullDim C + (RingHom.ker (g.comp f)).spanFinrank = ringKrullDim A,
        ∃ rs : List B, RingTheory.Sequence.IsRegular B rs ∧ Ideal.ofList rs = RingHom.ker g,
        ringKrullDim C + (RingHom.ker g).spanFinrank = ringKrullDim B] :=
  Stacks.RegularLocalRing.KernelRegularity.solution hf hg

/-!
# The minimal number of generators of the maximal ideal under a surjection

A surjection `π : R →+* S` of local rings with `R` Noetherian which kills an element of
`𝔪_R ∖ 𝔪_R²` needs strictly fewer generators for `𝔪_S` than for `𝔪_R`. Contrapositively, a
surjection that does not drop the minimal number of generators has its kernel inside `𝔪_R²`.

Both statements are elementary and concern no regular ring.
-/

open IsLocalRing

namespace Stacks.RegularLocalRing.SpanFinrank

/-- **An element of the maximal ideal with no unit coefficient lies in its square.** If
`x = ∑ g z * z` with every `z` in the maximal ideal and `x ∉ 𝔪²`, then some coefficient `g z` is
a unit. -/
public theorem exists_isUnit_of_notMem_sq {R : Type*} [CommRing R] [IsLocalRing R]
    {t : Finset R} (ht : ∀ z ∈ t, z ∈ maximalIdeal R) {g : R → R} {x : R}
    (hgsum : ∑ z ∈ t, g z * z = x) (hx2 : x ∉ maximalIdeal R ^ 2) : ∃ z ∈ t, IsUnit (g z) := by
  by_contra hcon
  push Not at hcon
  refine hx2 (hgsum ▸ ?_)
  rw [pow_two]
  exact Ideal.sum_mem _ fun z hz =>
    Ideal.mul_mem_mul ((mem_maximalIdeal _).mpr (hcon z hz)) (ht z hz)

/-- **Killing an element outside the square of the maximal ideal drops the minimal number of
generators.** Let `π : R →+* S` be a surjection of local rings with `R` Noetherian, and let
`x ∈ 𝔪_R ∖ 𝔪_R²` be killed by `π`. Then `𝔪_S` needs at least one generator fewer than `𝔪_R`.

Writing `x = ∑ g z • z` over a minimal generating set `t` of `𝔪_R`, some coefficient `g z` is a
unit. Applying `π` expresses `π z` through the `π z'` with `z' ∈ t ∖ {z}`, so those `#t - 1`
elements already generate `𝔪_S = π(𝔪_R)`. -/
public theorem spanFinrank_maximalIdeal_succ_le_of_surjective
    {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R] [IsNoetherianRing R]
    [IsLocalRing S] (π : R →+* S) (hπ : Function.Surjective π)
    {x : R} (hx : x ∈ maximalIdeal R) (hx2 : x ∉ maximalIdeal R ^ 2)
    (hker : π x = 0) :
    (maximalIdeal S).spanFinrank + 1 ≤ (maximalIdeal R).spanFinrank := by
  classical
  obtain ⟨t, htcard, htspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (IsNoetherian.noetherian (maximalIdeal R))
  obtain ⟨g, -, hgsum⟩ := Submodule.mem_span_finset.mp (htspan ▸ hx)
  simp only [smul_eq_mul] at hgsum
  obtain ⟨z, hzt, hzu⟩ := exists_isUnit_of_notMem_sq
    (fun a ha => htspan ▸ Ideal.subset_span ha) hgsum hx2
  have hzmem : π z ∈ Ideal.span (π '' (↑(t.erase z) : Set R)) := by
    have hsum : π (g z) * π z + ∑ a ∈ t.erase z, π (g a) * π a = 0 := by
      have h := congrArg π hgsum
      rw [hker, map_sum] at h
      rw [← Finset.add_sum_erase t _ hzt] at h
      simpa using h
    refine (Ideal.unit_mul_mem_iff_mem _ (hzu.map π)).mp ?_
    rw [show π (g z) * π z = -∑ a ∈ t.erase z, π (g a) * π a by linear_combination hsum]
    exact neg_mem (Submodule.sum_mem _ fun a ha =>
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a, Finset.mem_coe.mpr ha, rfl⟩))
  have hmS : maximalIdeal S = Ideal.span (π '' (↑(t.erase z) : Set R)) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective π hπ, ← htspan, Ideal.map_span]
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_mono (Set.image_mono ?_))
    · rintro _ ⟨a, hat, rfl⟩
      by_cases haz : a = z
      · exact haz ▸ hzmem
      · exact Ideal.subset_span ⟨a, Finset.mem_coe.mpr (Finset.mem_erase.mpr ⟨haz, hat⟩), rfl⟩
    · exact fun a ha => Finset.mem_of_mem_erase (Finset.mem_coe.mp ha)
  have hbound : (maximalIdeal S).spanFinrank ≤ (t.erase z).card := by
    rw [hmS]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite
      ((t.erase z).finite_toSet.image _)).trans ?_
    calc
      (π '' (↑(t.erase z) : Set R)).ncard ≤ (↑(t.erase z) : Set R).ncard :=
        Set.ncard_image_le (t.erase z).finite_toSet
      _ = (t.erase z).card := Set.ncard_coe_finset _
  have h1 : (t.erase z).card = t.card - 1 := Finset.card_erase_of_mem hzt
  have h2 : 1 ≤ t.card := Finset.card_pos.mpr ⟨z, hzt⟩
  omega

/-- A surjective map between Noetherian local rings with equal embedding dimension has no linear
relation in its kernel: the kernel is contained in the square of the maximal ideal. -/
public theorem ker_le_maximalIdeal_sq_of_surjective_of_spanFinrank_eq
    {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R]
    [IsNoetherianRing R] [IsLocalRing S]
    (π : R →+* S) (hπ : Function.Surjective π)
    (hd : (maximalIdeal R).spanFinrank = (maximalIdeal S).spanFinrank) :
    RingHom.ker π ≤ maximalIdeal R ^ 2 := by
  intro x hx
  by_contra hx2
  have hdrop := spanFinrank_maximalIdeal_succ_le_of_surjective π hπ
    (IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top π) hx) hx2 (RingHom.mem_ker.mp hx)
  omega

end Stacks.RegularLocalRing.SpanFinrank


