module

public import StacksFrontier.RingTheory.RegularLocalRing.FlatLocalHom
public import StacksFrontier.RingTheory.KrullDimension.SystemOfParameters.Defs
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Regular systems of parameters along a flat local homomorphism

Let `φ : R → S` be a flat local homomorphism of Noetherian local rings whose closed fibre
`F = S / m_R S` is regular. If `x₁, …, x_d` is a regular system of parameters of `R` and
`y₁, …, y_n ∈ S` are elements whose images form one of `F`, then `φ(x₁), …, φ(x_d), y₁, …, y_n`
is a regular system of parameters of `S`. Moreover, for `r ≤ d` the first `r` entries of the
concatenated list are the images of the first `r` entries of the original one, so the principal
ideal they generate is the extension of the principal ideal `(x₁ ⋯ x_r)`.

This is the local-algebra content of the argument that a smooth pullback preserves the local
shape of a strict normal crossings divisor: at a point `q` of the pullback lying over `p`, the
local equation `x₁ ⋯ x_r` of the divisor still cuts out the pullback, and it is still a product
of an initial segment of a regular system of parameters of the larger local ring.

## Main results

* `ClosedFibre.ofList_append_eq_maximalIdeal`: the concatenated list generates `m_S`.
* `ClosedFibre.exists_isSystemOfParameters_append`: the concatenated list is a regular system of
  parameters of `S`, for a suitable choice of lifts of a regular system of parameters of `F`.
* `ClosedFibre.exists_isSystemOfParameters_span_singleton_prod_take`: the packaged statement —
  a regular system of parameters of `S` together with an initial segment whose product generates
  the extension of the ideal generated by the product of the chosen initial segment of the
  original one.
* `Ideal.span_singleton_prod_take_append_map`: the elementary list computation behind the last
  clause, with no hypotheses on the rings.

## Implementation notes

A sequence is a `List`, as in `IsLocalRing.IsSystemOfParameters`, and the ideal it generates is
`Ideal.ofList`. A *regular* system of parameters is the conjunction
`IsLocalRing.IsSystemOfParameters rs ∧ Ideal.ofList rs = IsLocalRing.maximalIdeal R`, which is the
composite that `StacksFrontier/RingTheory/KrullDimension/SystemOfParameters/Defs.lean` declines to
name; both conjuncts are therefore carried explicitly, in the hypotheses and in the conclusions.

The closed fibre is `ClosedFibre R S` of
`StacksFrontier/RingTheory/RegularLocalRing/FlatLocalHom.lean`, that is the quotient of `S` by
`(maximalIdeal R).map (algebraMap R S)`, and the quotient map onto it is
`Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S))`. The
hypothesis about the fibre is stated as regularity of `ClosedFibre R S` rather than as a given
list of elements of `S`: a regular system of parameters of the fibre is then produced from the
`spanFinrank`-realizing generating finset of its maximal ideal and lifted through the quotient
map by `Function.surjInv`, so that no compatibility between a supplied list and the quotient has
to be assumed.

Flatness enters only through the dimension formula `dim S = dim R + dim F`, which is
`ringKrullDim_eq_add_ringKrullDim_closedFibre`; locality of the homomorphism enters both there
and in the identification `m_S = m_R S + (y₁, …, y_n)`. The latter is proved by passing to the
fibre: both `m_R S + (y₁, …, y_n)` and `m_S` contain `ker` of the quotient map and have the
same image in `F`, namely `m_F`, so they agree. Regularity of `S` itself is not restated here,
being `isRegularLocalRing_of_flat_of_closedFibre`.

The last clause needs `r ≤ rs.length` and nothing else: `List.take_append_of_le_length` makes
the initial segment of the concatenation an initial segment of `rs.map φ`, and a ring
homomorphism carries the product of a list to the product of its image.
-/

@[expose] public section

open IsLocalRing

universe u v

/-- For `r` at most the length of `rs`, the product of the first `r` entries of
`rs.map φ ++ ts` generates the extension along `φ` of the ideal generated by the product of the
first `r` entries of `rs`. No hypothesis on `φ`, `rs` or `ts` beyond the length bound. -/
theorem Ideal.span_singleton_prod_take_append_map {R : Type u} {S : Type v} [CommRing R]
    [CommRing S] (φ : R →+* S) (rs : List R) (ts : List S) {r : ℕ} (hr : r ≤ rs.length) :
    Ideal.span {((rs.map φ ++ ts).take r).prod} =
      Ideal.map φ (Ideal.span {(rs.take r).prod}) := by
  rw [List.take_append_of_le_length (by simpa using hr), ← List.map_take, ← map_list_prod,
    Ideal.map_span, Set.image_singleton]

namespace ClosedFibre

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
  [Algebra R S] [IsLocalHom (algebraMap R S)]

/-- A list generating `m_R` and a list of elements of `S` whose images generate the maximal ideal
of the closed fibre together generate `m_S`. -/
theorem ofList_append_eq_maximalIdeal {rs : List R} (hrs : Ideal.ofList rs = maximalIdeal R)
    {ts : List S}
    (hts : Ideal.ofList (ts.map (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S))))
      = maximalIdeal (ClosedFibre R S)) :
    Ideal.ofList (rs.map (algebraMap R S) ++ ts) = maximalIdeal S := by
  set q : S →+* ClosedFibre R S := Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S))
  have hsurj : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hker : RingHom.ker q = (maximalIdeal R).map (algebraMap R S) := Ideal.mk_ker
  have hmaprs : Ideal.ofList (rs.map (algebraMap R S)) = (maximalIdeal R).map (algebraMap R S) := by
    rw [← Ideal.map_ofList, hrs]
  have hbot : Ideal.map q (Ideal.ofList (rs.map (algebraMap R S))) = ⊥ :=
    (Ideal.map_eq_bot_iff_le_ker q).2 (by rw [hmaprs, hker])
  have hle : RingHom.ker q ≤ Ideal.ofList (rs.map (algebraMap R S) ++ ts) := by
    rw [hker, ← hmaprs, Ideal.ofList_append]
    exact le_sup_left
  have hle' : RingHom.ker q ≤ maximalIdeal S :=
    hker.trans_le (ClosedFibre.mapMaximalIdeal_le R S)
  have h : Ideal.map q (Ideal.ofList (rs.map (algebraMap R S) ++ ts)) =
      Ideal.map q (maximalIdeal S) := by
    rw [Ideal.ofList_append, Ideal.map_sup, hbot, bot_sup_eq, Ideal.map_ofList, hts,
      map_maximalIdeal_of_surjective q hsurj]
  rwa [Ideal.map_eq_iff_sup_ker_eq_of_surjective q hsurj, sup_of_le_left hle,
    sup_of_le_left hle'] at h

/-- A regular local ring has a regular system of parameters, that is a list generating the
maximal ideal whose length is the dimension. -/
@[ega "0 17.1.6" "partial", sga "2 IV 5.3" "partial"]
theorem _root_.IsRegularLocalRing.exists_ofList_eq_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] :
    ∃ as : List A, Ideal.ofList as = maximalIdeal A ∧
      (as.length : WithBot ℕ∞) = ringKrullDim A := by
  obtain ⟨s, hcard, hspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal A)).exists_span_finset_card_eq_spanFinrank
  refine ⟨s.toList, ?_, ?_⟩
  · rw [← hspan]
    exact congrArg Ideal.span (Set.ext fun x ↦ by simp)
  · rw [← IsRegularLocalRing.spanFinrank_maximalIdeal (R := A), ← hcard]
    simp

/-- **Steps 4 and 5 of Stacks 0CBP.** Let `φ : R → S` be a flat local homomorphism of Noetherian
local rings with regular closed fibre. A regular system of parameters `rs` of `R` extends, by
lifts of a regular system of parameters of the closed fibre, to a regular system of parameters
`rs.map φ ++ ts` of `S`. -/
@[ega "IV 7.5.1.1" "special case"]
theorem exists_isSystemOfParameters_append [IsNoetherianRing R] [IsNoetherianRing S]
    (hflat : Module.Flat R S) (hF : IsRegularLocalRing (ClosedFibre R S))
    {rs : List R} (hgen : Ideal.ofList rs = maximalIdeal R)
    (hdim : ringKrullDim R = rs.length) :
    ∃ ts : List S, IsSystemOfParameters (rs.map (algebraMap R S) ++ ts) ∧
      Ideal.ofList (rs.map (algebraMap R S) ++ ts) = maximalIdeal S := by
  set q : S →+* ClosedFibre R S := Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S))
  have hsurj : Function.Surjective q := Ideal.Quotient.mk_surjective
  obtain ⟨us, husgen, husdim⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal (ClosedFibre R S)
  have hlift : (us.map (Function.surjInv hsurj)).map q = us := by
    simp [Function.comp_def, Function.surjInv_eq hsurj]
  have hS : Ideal.ofList (rs.map (algebraMap R S) ++ us.map (Function.surjInv hsurj))
      = maximalIdeal S :=
    ofList_append_eq_maximalIdeal hgen (by rw [hlift, husgen])
  have hlen : ringKrullDim S
      = ((rs.map (algebraMap R S) ++ us.map (Function.surjInv hsurj)).length : WithBot ℕ∞) := by
    rw [ringKrullDim_eq_add_ringKrullDim_closedFibre R S hflat, hdim, ← husdim]
    simp
  exact ⟨us.map (Function.surjInv hsurj),
    ⟨by rw [hS, (maximalIdeal.isMaximal S).isPrime.radical], hlen⟩, hS⟩

/-- **The local step of Stacks 0CBP.** Let `φ : R → S` be a flat local homomorphism of Noetherian
local rings with regular closed fibre, let `rs` be a regular system of parameters of `R` and let
`1 ≤ r ≤ rs.length`. Then `S` has a regular system of parameters `ss` with an initial segment of
length `r` whose product generates the extension along `φ` of `(rs.take r).prod`.

The length `r` of the initial segment is unchanged: the new parameters are appended after the
images of the old ones. -/
@[ega "0 17.3.3" "partial"]
theorem exists_isSystemOfParameters_span_singleton_prod_take [IsNoetherianRing R]
    [IsNoetherianRing S] (hflat : Module.Flat R S) (hF : IsRegularLocalRing (ClosedFibre R S))
    {rs : List R} (hgen : Ideal.ofList rs = maximalIdeal R) (hdim : ringKrullDim R = rs.length)
    {r : ℕ} (hr1 : 1 ≤ r) (hr : r ≤ rs.length) :
    ∃ (ss : List S) (r' : ℕ), IsSystemOfParameters ss ∧ Ideal.ofList ss = maximalIdeal S ∧
      1 ≤ r' ∧ r' ≤ ss.length ∧
      Ideal.span {(ss.take r').prod}
        = Ideal.map (algebraMap R S) (Ideal.span {(rs.take r).prod}) := by
  obtain ⟨ts, hsop, hgenS⟩ := exists_isSystemOfParameters_append hflat hF hgen hdim
  refine ⟨rs.map (algebraMap R S) ++ ts, r, hsop, hgenS, hr1, ?_,
    Ideal.span_singleton_prod_take_append_map (algebraMap R S) rs ts hr⟩
  simpa using hr.trans (Nat.le_add_right _ _)

end ClosedFibre

end
