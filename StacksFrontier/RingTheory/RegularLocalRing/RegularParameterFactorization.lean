module

public import Mathlib.RingTheory.UniqueFactorizationDomain.Basic
public import StacksFrontier.RingTheory.KrullDimension.SystemOfParameters.Defs
public import StacksFrontier.RingTheory.RegularLocalRing.Basic
public import StacksFrontier.RingTheory.RegularLocalRing.UniqueFactorization
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Factoring a product of regular parameters in a regular local ring

Let `(R, m)` be a regular local ring. An element `f` of `R` whose quotient `R / (f)` is again a
regular local ring is a prime element, and so is every entry of a regular system of parameters of
`R`. Since `R` is a unique factorization domain, a product `f₁ ⋯ f_k` of elements of the first kind
which generates the same ideal as the product `h₁ ⋯ h_s` of an initial segment of a regular system
of parameters must match that initial segment factor for factor: `k = s`, and after a permutation
each `f_j` is an associate of `h_j`. Consequently `f₁, …, f_k` is itself an initial segment of a
regular system of parameters of `R`, namely of `f₁, …, f_k, h_{s+1}, …, h_d`.

The same conclusion is reached from a dimension count instead of a factorization: a list whose
quotient is a regular local ring of dimension `dim R - k` is an initial segment of a regular system
of parameters, because Stacks 00NR writes the ideal it generates as an initial segment of a minimal
generating set of `m` of exactly that length.

## Main results

* `IsRegularLocalRing.prime_of_isRegularLocalRing_quotient_span_singleton`: an element with regular
  quotient is prime.
* `IsRegularLocalRing.prime_of_mem_of_ofList_eq_maximalIdeal`: every entry of a regular system of
  parameters is prime.
* `IsRegularLocalRing.exists_isSystemOfParameters_append_of_isRegularLocalRing_quotient`: a list
  cutting out a regular quotient whose dimension drops by the length of the list is an initial
  segment of a regular system of parameters.
* `IsRegularLocalRing.exists_isSystemOfParameters_append_of_span_singleton_prod_eq`: a list of
  elements with regular quotients whose product generates the ideal generated by the product of an
  initial segment of a regular system of parameters is itself an initial segment of a regular
  system of parameters.

## Implementation notes

A sequence is a `List`, as in `IsLocalRing.IsSystemOfParameters`, and the ideal it generates is
`Ideal.ofList`. A *regular* system of parameters is the conjunction
`IsLocalRing.IsSystemOfParameters rs ∧ Ideal.ofList rs = IsLocalRing.maximalIdeal R`, the composite
that `StacksFrontier/RingTheory/KrullDimension/SystemOfParameters/Defs.lean` declines to name, so
both conjuncts are carried explicitly.

That an entry of a regular system of parameters is prime is read off from Stacks 00NQ applied to a
permutation of the list bringing that entry to the front: the length-one initial quotient is a
regular local ring, hence a domain, and the entry is a nonzerodivisor because the list is a regular
sequence. Membership of the `fᵢ` in `m` is not assumed: it follows from regularity, hence
nontriviality, of `R / (fᵢ)`.

The matching of the two factorizations is `UniqueFactorizationMonoid.factors_unique`, which returns
a `Multiset.Rel Associated`; `Ideal.ofList_eq_of_rel_associated` turns that into an equality of
generated ideals, and the length comparison `Multiset.card_eq_card_of_rel` gives `k = s`. The
completion of `f₁, …, f_k` to a regular system of parameters is then `hs.drop s`, which needs no
further choice.
-/

@[expose] public section

open IsLocalRing

/-- The ideal generated by a list depends only on the list up to permutation. -/
theorem Ideal.ofList_eq_of_perm {R : Type*} [Semiring R] {rs ss : List R} (h : rs.Perm ss) :
    Ideal.ofList rs = Ideal.ofList ss :=
  congrArg Ideal.span (Set.ext fun _ ↦ h.mem_iff)

/-- Two lists whose entries are matched up to associates generate the same ideal. -/
theorem Ideal.ofList_eq_of_rel_associated {R : Type*} [CommRing R] {rs ss : List R}
    (h : Multiset.Rel Associated (rs : Multiset R) (ss : Multiset R)) :
    Ideal.ofList rs = Ideal.ofList ss := by
  have key : ∀ ls ms : List R, Multiset.Rel Associated (ls : Multiset R) (ms : Multiset R) →
      Ideal.ofList ls ≤ Ideal.ofList ms := by
    intro ls ms hm
    rw [Ideal.ofList, Ideal.span_le]
    intro a ha
    obtain ⟨b, hb, hab⟩ := Multiset.exists_mem_of_rel_of_mem hm (Multiset.mem_coe.mpr ha)
    obtain ⟨c, rfl⟩ := hab.symm.dvd
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Multiset.mem_coe.mp hb))
  refine le_antisymm (key _ _ h) (key _ _ ?_)
  exact (Multiset.rel_flip.mpr h).mono fun _ _ _ _ hab ↦ hab.symm

namespace IsRegularLocalRing

/-- A nonzero element of a commutative ring whose quotient by the ideal it generates is a regular
local ring is a prime element. -/
@[ega "0 17.1.7" "Moreover clause, r=1"]
theorem prime_of_isRegularLocalRing_quotient_span_singleton {R : Type*} [CommRing R] {f : R}
    (hf : f ≠ 0) (hreg : IsRegularLocalRing (R ⧸ Ideal.span {f})) : Prime f := by
  have := hreg
  have hdom : IsDomain (R ⧸ Ideal.span {f}) := IsRegularLocalRing.isDomain _
  exact (Ideal.span_singleton_prime hf).mp
    ((Ideal.Quotient.isDomain_iff_prime (Ideal.span {f})).mp hdom)

variable {R : Type*} [CommRing R] [IsRegularLocalRing R]

/-- A list generating the same ideal as an initial segment of a regular system of parameters of
length `ringKrullDim R` is an initial segment of the regular system of parameters obtained by
appending the remaining entries. -/
private theorem isSystemOfParameters_append_drop_of_ofList_eq_take {fs xs : List R} {n : ℕ}
    (hxgen : Ideal.ofList xs = maximalIdeal R) (hdim : ringKrullDim R = xs.length)
    (hn : n ≤ xs.length) (hlen : fs.length = n) (hfs : Ideal.ofList fs = Ideal.ofList (xs.take n)) :
    IsLocalRing.IsSystemOfParameters (fs ++ xs.drop n) ∧
      Ideal.ofList (fs ++ xs.drop n) = maximalIdeal R := by
  have hgen : Ideal.ofList (fs ++ xs.drop n) = maximalIdeal R := by
    rw [Ideal.ofList_append, hfs, ← Ideal.ofList_append, List.take_append_drop, hxgen]
  refine ⟨⟨by rw [hgen]; exact (maximalIdeal.isMaximal R).isPrime.radical, ?_⟩, hgen⟩
  rw [hdim, List.length_append, hlen, List.length_drop]
  norm_cast
  omega

/-- Every entry of a regular system of parameters of a regular local ring is a prime element. -/
@[ega "0 17.1.7" "Moreover clause, r=1"]
theorem prime_of_mem_of_ofList_eq_maximalIdeal {xs : List R}
    (hgen : Ideal.ofList xs = maximalIdeal R)
    (hlen : xs.length = (maximalIdeal R).spanFinrank) {x : R} (hx : x ∈ xs) : Prime x := by
  obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem hx
  have hperm : (l₁ ++ x :: l₂).Perm (x :: (l₁ ++ l₂)) := List.perm_middle
  have hgen' : Ideal.ofList (x :: (l₁ ++ l₂)) = maximalIdeal R := by
    rw [← Ideal.ofList_eq_of_perm hperm]; exact hgen
  have hlen' : (x :: (l₁ ++ l₂)).length = (maximalIdeal R).spanFinrank := by
    rw [← hperm.length_eq]; exact hlen
  obtain ⟨hmain, -⟩ :=
    IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay R
  obtain ⟨hseq, hquot⟩ := hmain _ hgen' hlen'
  have hx0 : x ≠ 0 := by
    have := ((RingTheory.Sequence.isWeaklyRegular_cons_iff R x (l₁ ++ l₂)).mp
      hseq.toIsWeaklyRegular).1
    intro h0
    exact (not_subsingleton R) (h0 ▸ this).subsingleton
  have hreg : IsRegularLocalRing (R ⧸ Ideal.span {x}) := by
    have h1 := (hquot 1 (by simp)).1
    rwa [List.take_succ_cons, List.take_zero, Ideal.ofList_singleton] at h1
  exact prime_of_isRegularLocalRing_quotient_span_singleton hx0 hreg

/-- **A list cutting out a regular quotient of complementary dimension is an initial segment of a
regular system of parameters.** Let `(R, m)` be a regular local ring and let `f₁, …, f_k` be
elements of `R` such that `R / (f₁, …, f_k)` is a regular local ring of dimension `dim R - k`.
Then `f₁, …, f_k` extends to a regular system of parameters of `R` of which it is the initial
segment. -/
@[ega "0 17.1.7" "b⇒a", ega "0 17.1.9" "(a) ⇒ (b)"]
theorem exists_isSystemOfParameters_append_of_isRegularLocalRing_quotient {fs : List R}
    (hq : IsRegularLocalRing (R ⧸ Ideal.ofList fs))
    (hdim : ringKrullDim (R ⧸ Ideal.ofList fs) + fs.length = ringKrullDim R) :
    ∃ ts : List R, IsLocalRing.IsSystemOfParameters (fs ++ ts) ∧
      Ideal.ofList (fs ++ ts) = maximalIdeal R := by
  obtain ⟨xs, hxgen, hxlen, c, hcle, hcI, hcdim⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
      (Ideal.ofList fs) hq
  -- The dimension of the quotient is a natural number, so the two codimension equations
  -- can be cancelled against each other.
  have hdimq := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ Ideal.ofList fs)
  have hdimR := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  have hc : c = fs.length := by
    rw [← hdimq, ← hdimR] at hdim hcdim
    have h : (maximalIdeal (R ⧸ Ideal.ofList fs)).spanFinrank + c
        = (maximalIdeal (R ⧸ Ideal.ofList fs)).spanFinrank + fs.length := by
      exact_mod_cast hcdim.trans hdim.symm
    omega
  subst hc
  have hdimx : ringKrullDim R = xs.length := by rw [← hdimR, hxlen]
  exact ⟨xs.drop fs.length, isSystemOfParameters_append_drop_of_ofList_eq_take hxgen hdimx hcle
    rfl hcI.symm⟩

/-- **Unique factorization of a local equation against a regular system of parameters.** Let
`(R, m)` be a regular local ring, let `f₁, …, f_k` be elements of `R` whose quotients `R / (fⱼ)`
are regular local rings, and let `h₁, …, h_d` be a regular system of parameters of `R`. If the
product `f₁ ⋯ f_k` generates the same ideal as the product `h₁ ⋯ h_s` of an initial segment of
`h₁, …, h_d`, then `k = s` and `f₁, …, f_k` is itself an initial segment of a regular system of
parameters of `R`, namely of `f₁, …, f_k, h_{s+1}, …, h_d`. -/
theorem exists_isSystemOfParameters_append_of_span_singleton_prod_eq {fs hs : List R} {s : ℕ}
    (hfreg : ∀ f ∈ fs, IsRegularLocalRing (R ⧸ Ideal.span {f}))
    (hgen : Ideal.ofList hs = maximalIdeal R) (hdim : ringKrullDim R = hs.length)
    (hsle : s ≤ hs.length)
    (hprod : Ideal.span {fs.prod} = Ideal.span {(hs.take s).prod}) :
    fs.length = s ∧ ∃ ts : List R, IsLocalRing.IsSystemOfParameters (fs ++ ts) ∧
      Ideal.ofList (fs ++ ts) = maximalIdeal R := by
  have hdom : IsDomain R := IsRegularLocalRing.isDomain R
  have huf : UniqueFactorizationMonoid R := IsRegularLocalRing.uniqueFactorizationMonoid R
  have hlen : hs.length = (maximalIdeal R).spanFinrank := by
    have := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [hdim] at this
    exact_mod_cast this.symm
  -- The entries of the chosen initial segment are prime, hence its product is nonzero.
  have hhprime : ∀ h ∈ hs.take s, Prime h := fun h hh ↦
    prime_of_mem_of_ofList_eq_maximalIdeal hgen hlen (List.mem_of_mem_take hh)
  have hhprod : (hs.take s).prod ≠ 0 :=
    List.prod_ne_zero fun h0 ↦ (hhprime 0 h0).ne_zero rfl
  -- The products are associated, so the `fⱼ` are nonzero and therefore prime.
  have hass : Associated fs.prod (hs.take s).prod :=
    Ideal.span_singleton_eq_span_singleton.mp hprod
  have hfprod : fs.prod ≠ 0 := fun h0 ↦ hhprod (hass.eq_zero_iff.mp h0)
  have hfprime : ∀ f ∈ fs, Prime f := by
    intro f hf
    refine prime_of_isRegularLocalRing_quotient_span_singleton (fun h0 ↦ hfprod ?_) (hfreg f hf)
    exact List.prod_eq_zero_iff.mpr (h0 ▸ hf)
  -- Unique factorization matches the two lists up to associates.
  have hrel : Multiset.Rel Associated (fs : Multiset R) ((hs.take s : List R) : Multiset R) :=
    UniqueFactorizationMonoid.factors_unique
      (fun x hx ↦ (hfprime x (Multiset.mem_coe.mp hx)).irreducible)
      (fun x hx ↦ (hhprime x (Multiset.mem_coe.mp hx)).irreducible)
      (by simpa using hass)
  have hcard : fs.length = s := by
    have := Multiset.card_eq_card_of_rel hrel
    simpa [List.length_take, Nat.min_eq_left hsle] using this
  exact ⟨hcard, hs.drop s, isSystemOfParameters_append_drop_of_ofList_eq_take hgen hdim hsle hcard
    (Ideal.ofList_eq_of_rel_associated hrel)⟩

end IsRegularLocalRing

end
