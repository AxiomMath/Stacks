module

public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.LocalRing.RingHom.Basic
public import Mathlib.RingTheory.Nakayama
public import Mathlib.RingTheory.RegularLocalRing.Defs

/-!
# Krull dimension under a surjection with small kernel onto a regular local ring

Let `φ : A →+* B` be a surjective local homomorphism of Noetherian local rings whose kernel is
contained in `𝔪_A ^ 2`. Lifting a minimal generating set of `𝔪_B` along `φ` gives a subset of
`𝔪_A` that generates `𝔪_A` modulo `𝔪_A ^ 2`, hence generates `𝔪_A` by Nakayama's lemma. So
`𝔪_A` needs no more generators than `𝔪_B` does, and `dim A ≤ dim B` whenever `B` is regular.

## Main results

* `IsLocalRing.span_eq_maximalIdeal_of_span_image_eq`: a subset of `A` whose image generates
  `𝔪_B` already generates `𝔪_A`.
* `IsLocalRing.spanFinrank_maximalIdeal_le_of_surjective`: `𝔪_A` can be generated by
  `(𝔪_B).spanFinrank` elements.
* `IsLocalRing.ringKrullDim_le_of_surjective_of_ker_le_maximalIdeal_sq`: `dim A ≤ dim B` when `B`
  is a regular local ring.
-/

@[expose] public section

open IsLocalRing Submodule

namespace IsLocalRing

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A]

/-- Let `φ : A →+* B` be a surjective local homomorphism of local rings with `A` Noetherian and
`RingHom.ker φ ≤ 𝔪_A ^ 2`. Any subset of `A` whose image under `φ` generates `𝔪_B` generates
`𝔪_A`. -/
theorem span_eq_maximalIdeal_of_span_image_eq [IsNoetherianRing A] [IsLocalRing B] (φ : A →+* B)
    [IsLocalHom φ] (hφ : Function.Surjective φ) (hker : RingHom.ker φ ≤ maximalIdeal A ^ 2)
    {s : Set A} (hs : Ideal.span (φ '' s) = maximalIdeal B) : Ideal.span s = maximalIdeal A := by
  have hmap : Ideal.map φ (Ideal.span s) = maximalIdeal B := by rwa [Ideal.map_span]
  have hle : Ideal.span s ≤ maximalIdeal A := by
    rw [← maximalIdeal_comap φ, Ideal.span_le]
    exact fun a ha ↦ hs ▸ Ideal.subset_span ⟨a, ha, rfl⟩
  -- Surjectivity turns `𝔪_B = φ (span s)` into `𝔪_A = span s + ker φ`.
  have hsup : Ideal.span s ⊔ RingHom.ker φ = maximalIdeal A := by
    rw [RingHom.ker_eq_comap_bot, ← Ideal.comap_map_of_surjective φ hφ, hmap, maximalIdeal_comap]
  have hsq : RingHom.ker φ ≤ maximalIdeal A • maximalIdeal A :=
    hker.trans (by rw [sq, ← Ideal.smul_eq_mul])
  exact hle.antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
    (maximalIdeal_le_jacobson ⊥) (hsup.ge.trans (sup_le_sup_left hsq _)))

/-- Let `φ : A →+* B` be a surjective local homomorphism of Noetherian local rings with
`RingHom.ker φ ≤ 𝔪_A ^ 2`. Then `𝔪_A` can be generated by as few elements as `𝔪_B`. -/
theorem spanFinrank_maximalIdeal_le_of_surjective [IsNoetherianRing A] [IsLocalRing B]
    [IsNoetherianRing B] (φ : A →+* B) [IsLocalHom φ] (hφ : Function.Surjective φ)
    (hker : RingHom.ker φ ≤ maximalIdeal A ^ 2) :
    (maximalIdeal A).spanFinrank ≤ (maximalIdeal B).spanFinrank := by
  obtain ⟨t, ht, hts⟩ :=
    (IsNoetherian.noetherian (maximalIdeal B)).exists_span_finset_card_eq_spanFinrank
  calc (maximalIdeal A).spanFinrank = (span A (Function.surjInv hφ '' ↑t)).spanFinrank :=
        congrArg _ (span_eq_maximalIdeal_of_span_image_eq φ hφ hker
          (by rwa [← Set.image_comp, Function.comp_surjInv, Set.image_id])).symm
    _ ≤ (Function.surjInv hφ '' ↑t).ncard :=
        spanFinrank_span_le_ncard_of_finite (t.finite_toSet.image _)
    _ ≤ (↑t : Set B).ncard := Set.ncard_image_le t.finite_toSet
    _ = t.card := Set.ncard_coe_finset t
    _ = (maximalIdeal B).spanFinrank := ht

/-- Let `φ : A →+* B` be a surjective local homomorphism of Noetherian local rings with
`RingHom.ker φ ≤ 𝔪_A ^ 2`. If `B` is a regular local ring, then `dim A ≤ dim B`. -/
theorem ringKrullDim_le_of_surjective_of_ker_le_maximalIdeal_sq [IsNoetherianRing A]
    [IsRegularLocalRing B] (φ : A →+* B) [IsLocalHom φ] (hφ : Function.Surjective φ)
    (hker : RingHom.ker φ ≤ maximalIdeal A ^ 2) : ringKrullDim A ≤ ringKrullDim B :=
  calc ringKrullDim A ≤ ((maximalIdeal A).spanFinrank : WithBot ℕ∞) :=
        ringKrullDim_le_spanFinrank_maximalIdeal A
    _ ≤ ((maximalIdeal B).spanFinrank : WithBot ℕ∞) := by
        exact_mod_cast spanFinrank_maximalIdeal_le_of_surjective φ hφ hker
    _ = ringKrullDim B := IsRegularLocalRing.spanFinrank_maximalIdeal

end IsLocalRing

end
