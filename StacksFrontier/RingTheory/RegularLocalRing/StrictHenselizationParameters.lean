/-!
# Recognizing regular parameters of a local ring in its strict henselization

Let `(A, 𝔪)` be a Noetherian local ring and let `A → A^{sh}` be a strict henselization of `A`,
that is, a henselization whose prescribed residue extension is a separable algebraic closure of
the residue field of `A`. Regularity of a local ring and its Krull dimension are both unchanged on
passing to the strict henselization, and the strict henselization of a quotient `A / I` by an
ideal `I ⊆ 𝔪` is the corresponding quotient `A^{sh} / I A^{sh}`. Combining the two, a statement
about regular parameters of `A` can be checked after base change to `A^{sh}`.

Concretely, let `f₁, …, f_k` be elements of `A` whose quotients `A / (fⱼ)` are regular local
rings, let `h₁, …, h_d` be a regular system of parameters of `A^{sh}`, and suppose the ideal of
`A^{sh}` generated by the image of the product `f₁ ⋯ f_k` is the ideal generated by the product
`h₁ ⋯ h_s` of an initial segment. Then `A` is itself regular, `k = s`, and `f₁, …, f_k` is an
initial segment of a regular system of parameters of `A`.

## Main results

* `IsRegularLocalRing.isRegularLocalRing_and_exists_isSystemOfParameters_append_of_isHenselization`
  is the statement above.

## Implementation notes

A strict henselization is `IsLocalRing.IsHenselization A L Ash` for a separably closed extension
`L` of the residue field of `A`, so `IsSepClosure (IsLocalRing.ResidueField A) L` is carried as a
separate instance. Sequences are `List`s, as in `IsLocalRing.IsSystemOfParameters`, and the ideal
generated by a list is `Ideal.ofList`; a *regular* system of parameters is the conjunction
`IsLocalRing.IsSystemOfParameters rs ∧ Ideal.ofList rs = IsLocalRing.maximalIdeal A`, so both
conjuncts are carried explicitly.

Regularity of `Ash` is an instance rather than a hypothesis, which also supplies the localness and
Noetherianity of `Ash` that the henselization hypothesis needs; the equality `k = s` falls out of
the argument and is part of the conclusion.

Both transfer statements rest on the same two inputs, so they are packaged together. Stacks 06LN
and Stacks 06LK each compare a ring simultaneously with a henselization and with a strict
henselization, so an auxiliary henselization is produced by Stacks 04GN
(`IsLocalRing.exists_isHenselization_residueField`) and immediately discarded. For a quotient the
inputs are assembled from Stacks 05WS, which returns the defining properties of a strict
henselization of `A / I` as a package rather than as an `IsLocalRing.IsHenselization` instance;
the instance is rebuilt from it by `IsLocalRing.IsHenselization.of_ind_etale`, taking the residue
field of `A^{sh} / I A^{sh}` itself as the prescribed residue extension, for which the required
residue field identification is the identity. Applying Stacks 05WS also needs the separable
closedness of that actual residue field rather than of the prescribed `L`, which is
`IsLocalRing.IsHenselization.exists_residueFieldAlgebra` once the algebra structure it produces is
identified with the canonical one.

The membership `fⱼ ∈ 𝔪` is not assumed: it follows from nontriviality of `A / (fⱼ)`, which
regularity provides. In `A^{sh}` the hypotheses of
`IsRegularLocalRing.exists_isSystemOfParameters_append_of_span_singleton_prod_eq` are met by the
images `f₁, …, f_k`, and the complementary dimension count needed to descend the conclusion to `A`
comes from Stacks 00NQ applied to the resulting regular system of parameters of `A^{sh}`.

## References

* [StacksProject 06LN](https://stacks.math.columbia.edu/tag/06LN), regularity ascends and descends
  along a (strict) henselization
* [StacksProject 06LK](https://stacks.math.columbia.edu/tag/06LK), Krull dimension is unchanged by
  a (strict) henselization
* [StacksProject 05WS](https://stacks.math.columbia.edu/tag/05WS), strict henselization is
  compatible with quotients
* [StacksProject 00NQ](https://stacks.math.columbia.edu/tag/00NQ), the initial quotients of a
  minimal generating sequence of the maximal ideal of a regular local ring
-/

@[expose] public section

open IsLocalRing

universe u v

/-- **Regularity and Krull dimension are unchanged by a strict henselization.** If `Ash` is a
strict henselization of a Noetherian local ring `A`, then `A` is a regular local ring exactly when
`Ash` is, and the two have the same Krull dimension. -/
@[ega "IV 18.8.13", sga "4 VIII 4.4" "special case", sga "5 I 3.1.3"]
private theorem isRegularLocalRing_iff_and_ringKrullDim_eq_of_isHenselization
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    {Ash : Type u} [CommRing Ash] [IsLocalRing Ash] [Algebra A Ash]
    (L : Type v) [Field L] [Algebra (ResidueField A) L] [IsSepClosure (ResidueField A) L]
    [IsHenselization A L Ash] :
    (IsRegularLocalRing A ↔ IsRegularLocalRing Ash) ∧ ringKrullDim A = ringKrullDim Ash := by
  obtain ⟨Ah, _, _, _, _⟩ := IsLocalRing.exists_isHenselization_residueField A
  obtain ⟨hd₁, hd₂⟩ := ringKrullDim_eq_henselization_eq_strictHenselization A Ah Ash L
  exact ⟨(isRegularLocalRing_iff_henselizations A Ah Ash L).2, hd₁.trans hd₂⟩

/-- **Regularity and Krull dimension of a quotient are unchanged by a strict henselization.** Let
`Ash` be a strict henselization of a Noetherian local ring `(A, 𝔪)` and let `I ⊆ 𝔪` be an ideal.
Then `A / I` is a regular local ring exactly when `Ash / I Ash` is, and the two have the same
Krull dimension. -/
@[ega "IV 18.8.13" "more general", sga "5 I 3.1.3" "more general"]
private theorem isRegularLocalRing_iff_and_ringKrullDim_eq_quotient_of_isHenselization
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    {Ash : Type u} [CommRing Ash] [IsLocalRing Ash] [Algebra A Ash]
    (L : Type v) [Field L] [Algebra (ResidueField A) L] [IsSepClosure (ResidueField A) L]
    [IsHenselization A L Ash] (I : Ideal A) (hI : I ≤ maximalIdeal A) :
    (IsRegularLocalRing (A ⧸ I) ↔ IsRegularLocalRing (Ash ⧸ I.map (algebraMap A Ash))) ∧
      ringKrullDim (A ⧸ I) = ringKrullDim (Ash ⧸ I.map (algebraMap A Ash)) := by
  have : IsLocalHom (algebraMap A Ash) := IsHenselization.isLocalHom (L := L)
  have : HenselianLocalRing Ash := IsHenselization.henselian (R := A) (L := L)
  -- Replace the prescribed residue extension `L` by the actual residue field of `Ash`.
  obtain ⟨a, _, hsep, hres⟩ :=
    IsHenselization.exists_residueFieldAlgebra (R := A) (L := L) (Rh := Ash)
  have halg : a = ResidueField.instAlgebra (R := A) (S := Ash) :=
    Algebra.algebra_ext _ _ fun z ↦ by
      obtain ⟨r, rfl⟩ := residue_surjective z
      exact (hres r).trans (ResidueField.algebraMap_residue (S := Ash) r).symm
  subst halg
  have : IsSepClosure (ResidueField A) (ResidueField Ash) := hsep inferInstance
  -- Stacks 05WS: the quotient of `Ash` is a strict henselization of the quotient of `A`.
  obtain ⟨hlocQ, hlocAQ, _, hhens, hind, _, hsepQ⟩ :=
    IsLocalRing.strictHenselization_quotient (R := A) (Rsh := Ash)
      (IsHenselization.ind_etale_of_universe_le.{u, v, u} L)
      (IsHenselization.map_maximalIdeal (R := A) (L := L) (Rh := Ash)) I hI
  have := hlocQ
  have := hlocAQ
  have := hsepQ
  have : IsHenselization (A ⧸ I) (ResidueField (Ash ⧸ I.map (algebraMap A Ash)))
      (Ash ⧸ I.map (algebraMap A Ash)) :=
    IsHenselization.of_ind_etale hhens hind
      ⟨RingEquiv.refl _, fun z ↦ ResidueField.algebraMap_residue z⟩
  exact isRegularLocalRing_iff_and_ringKrullDim_eq_of_isHenselization
    (A := A ⧸ I) (Ash := Ash ⧸ I.map (algebraMap A Ash))
    (ResidueField (Ash ⧸ I.map (algebraMap A Ash)))

namespace IsRegularLocalRing

/-- **A local equation recognized against a regular system of parameters of the strict
henselization.** Let `(A, 𝔪)` be a Noetherian local ring, let `Ash` be a strict henselization of
`A` relative to a separably closed extension `L` of the residue field of `A`, and suppose `Ash` is
a regular local ring. Let `f₁, …, f_k` be elements of `A` whose quotients `A / (fⱼ)` are regular
local rings, and let `h₁, …, h_d` be a regular system of parameters of `Ash`. If the ideal of
`Ash` generated by the image of `f₁ ⋯ f_k` is the ideal generated by the product `h₁ ⋯ h_s` of an
initial segment of `h₁, …, h_d`, then `A` is a regular local ring, `k = s`, and `f₁, …, f_k` is an
initial segment of a regular system of parameters of `A`. -/
@[ega "0 17.3.3" "(i), special case", ega "IV 18.8.13" "(c)"]
theorem isRegularLocalRing_and_exists_isSystemOfParameters_append_of_isHenselization
    {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    {Ash : Type u} [CommRing Ash] [IsRegularLocalRing Ash] [Algebra A Ash]
    (L : Type v) [Field L] [Algebra (ResidueField A) L] [IsSepClosure (ResidueField A) L]
    [IsHenselization A L Ash]
    {fs : List A} (hfs : ∀ f ∈ fs, IsRegularLocalRing (A ⧸ Ideal.span {f}))
    {hs : List Ash} {s : ℕ} (hsop : IsSystemOfParameters hs)
    (hsgen : Ideal.ofList hs = maximalIdeal Ash) (hsle : s ≤ hs.length)
    (hprod : (Ideal.span {fs.prod}).map (algebraMap A Ash) = Ideal.span {(hs.take s).prod}) :
    IsRegularLocalRing A ∧ fs.length = s ∧ ∃ ts : List A,
      IsSystemOfParameters (fs ++ ts) ∧ Ideal.ofList (fs ++ ts) = maximalIdeal A := by
  -- Each `fⱼ` lies in `𝔪`, because `A / (fⱼ)` is nontrivial.
  have hfmem : ∀ f ∈ fs, f ∈ maximalIdeal A := by
    intro f hf
    have := hfs f hf
    by_contra hmem
    exact not_subsingleton (A ⧸ Ideal.span {f}) (Ideal.Quotient.subsingleton_iff.mpr
      (Ideal.span_singleton_eq_top.mpr (IsLocalRing.notMem_maximalIdeal.mp hmem)))
  have hofListle : Ideal.ofList fs ≤ maximalIdeal A := Ideal.span_le.mpr fun _ hx ↦ hfmem _ hx
  -- Regularity of the quotients `A / (fⱼ)` ascends to `Ash`.
  have hfsh : ∀ f ∈ fs, IsRegularLocalRing (Ash ⧸ Ideal.span {algebraMap A Ash f}) := by
    intro f hf
    have h := (isRegularLocalRing_iff_and_ringKrullDim_eq_quotient_of_isHenselization
      (A := A) (Ash := Ash) L (Ideal.span {f})
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (hfmem f hf)))).1.mp (hfs f hf)
    rwa [Ideal.map_span, Set.image_singleton] at h
  -- Match the images of the `fⱼ` against the given regular system of parameters of `Ash`.
  have hprod' : Ideal.span {(fs.map (algebraMap A Ash)).prod}
      = Ideal.span {(hs.take s).prod} := by
    rw [(map_list_prod (algebraMap A Ash) fs).symm, ← hprod, Ideal.map_span, Set.image_singleton]
  obtain ⟨hlen, ts, htsop, htsgen⟩ :=
    IsRegularLocalRing.exists_isSystemOfParameters_append_of_span_singleton_prod_eq
      (fs := fs.map (algebraMap A Ash))
      (fun f hf ↦ by obtain ⟨g, hg, rfl⟩ := List.mem_map.mp hf; exact hfsh g hg)
      hsgen hsop.2 hsle hprod'
  -- Stacks 00NQ: the quotient of `Ash` by that initial segment is regular of dimension `d - k`.
  have hlenspan : (fs.map (algebraMap A Ash) ++ ts).length = (maximalIdeal Ash).spanFinrank := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Ash)
    rw [htsop.2] at h
    exact_mod_cast h.symm
  obtain ⟨-, hquot⟩ :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      Ash).1 (fs.map (algebraMap A Ash) ++ ts) htsgen hlenspan
  obtain ⟨hregq, hdimq⟩ := hquot (fs.map (algebraMap A Ash)).length (by simp)
  rw [List.take_left, ← Ideal.map_ofList] at hregq hdimq
  -- Descend regularity and the dimension count to `A`.
  obtain ⟨hiffq, hdimeqq⟩ :=
    isRegularLocalRing_iff_and_ringKrullDim_eq_quotient_of_isHenselization
      (A := A) (Ash := Ash) L (Ideal.ofList fs) hofListle
  obtain ⟨hiffA, hdimA⟩ := isRegularLocalRing_iff_and_ringKrullDim_eq_of_isHenselization
    (A := A) (Ash := Ash) L
  have hA : IsRegularLocalRing A := hiffA.mpr inferInstance
  have hfl : (fs.map (algebraMap A Ash)).length = fs.length := by simp
  have hdim : ringKrullDim (A ⧸ Ideal.ofList fs) + fs.length = ringKrullDim A := by
    rw [hdimeqq, hdimA, ← hfl]
    exact hdimq
  have := hA
  exact ⟨hA, hfl ▸ hlen,
    IsRegularLocalRing.exists_isSystemOfParameters_append_of_isRegularLocalRing_quotient
      (hiffq.mpr hregq) hdim⟩

end IsRegularLocalRing

end
