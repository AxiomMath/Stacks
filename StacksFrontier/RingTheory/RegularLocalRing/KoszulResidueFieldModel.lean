module

public import StacksFrontier.RingTheory.Koszul.DerivedQuotientModel
public import StacksFrontier.RingTheory.Koszul.Regular
public import StacksFrontier.RingTheory.RegularLocalRing.Basic

/-!
# The residue field of a regular local ring as a K-flat complex

Let `A` be a regular local ring. A minimal generating family of the maximal ideal is a regular
sequence ([Stacks, Tag 00NQ]), hence a Koszul-regular one ([Stacks, Tag 062F]), so the cochain
Koszul complex of that family is a bounded complex of finite free `A`-modules representing the
residue field `A ⧸ 𝔪` in the derived category of `A`-modules.

## Main results

* `IsRegularLocalRing.exists_isKoszulRegular_span_eq_maximalIdeal` — the maximal ideal of a
  regular local ring is generated by a Koszul-regular sequence, indexed by `Fin r`.
* `Koszul.exists_kFlat_seqCochainComplex_iso_residueField` — hence `A ⧸ 𝔪`, placed in degree zero
  of the derived category, is the image of a K-flat cochain complex.

## Implementation notes

The generating family comes from `Submodule.FG.exists_span_finset_card_eq_spanFinrank` applied to
the maximal ideal of the Noetherian ring `A`, whose cardinality is then
`(IsLocalRing.maximalIdeal A).spanFinrank` by construction; that is exactly the minimality
hypothesis of
`IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay`. The
passage from a regular sequence to a Koszul-regular one is the third conjunct of
`Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular`.

### The step of Tag 0ECC that this covers

The proof of [Stacks, Tag 0ECC] tensors `RΓ(V, 𝒪_V)` with `A/𝔪` over `A`. The complex supplied
here is the K-flat model of the right-hand factor that
`Stacks.DerivedTensor.isZero_derivedTensor_of_acyclic_tensor_kFlat_of_iso` consumes; no tag is
claimed.

## References

* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
* [Stacks Project, Tag 062F](https://stacks.math.columbia.edu/tag/062F)
* [Stacks Project, Tag 0ECC](https://stacks.math.columbia.edu/tag/0ECC)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

/-- **The maximal ideal of a regular local ring is generated by a Koszul-regular sequence.** A
minimal generating family is a regular sequence, and a regular sequence is Koszul-regular. -/
theorem IsRegularLocalRing.exists_isKoszulRegular_span_eq_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] :
    ∃ (r : ℕ) (x : Fin r → A), Ideal.span (Set.range x) = IsLocalRing.maximalIdeal A ∧
      Koszul.IsKoszulRegular x := by
  obtain ⟨s, hcard, hspan⟩ := (IsNoetherian.noetherian
    (IsLocalRing.maximalIdeal A)).exists_span_finset_card_eq_spanFinrank
  have hgen : Ideal.ofList s.toList = IsLocalRing.maximalIdeal A := by
    rw [← hspan]
    simp [Ideal.ofList]
  have hlen : s.toList.length = (IsLocalRing.maximalIdeal A).spanFinrank := by simp [hcard]
  have hreg : RingTheory.Sequence.IsRegular A s.toList :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      A).1 s.toList hgen hlen |>.1
  refine ⟨s.toList.length, s.toList.get, ?_, ?_⟩
  · rw [show Set.range s.toList.get = {y | y ∈ s.toList} from by
      ext y
      exact List.mem_iff_get.symm]
    exact hgen
  · refine (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular (M := A)).2.2 ?_
    rwa [show (List.ofFn fun i : Fin s.toList.length => s.toList.get i) = s.toList from
      List.ofFn_get s.toList]

namespace Koszul

attribute [local instance] HasDerivedCategory.standard

/-- **The residue field of a regular local ring is represented by a K-flat complex.** The cochain
Koszul complex of a Koszul-regular generating family of the maximal ideal is K-flat and its image
in the derived category is `A ⧸ 𝔪` placed in degree zero. -/
theorem exists_kFlat_seqCochainComplex_iso_residueField (A : Type u) [CommRing A]
    [IsRegularLocalRing A] :
    ∃ (r : ℕ) (x : Fin r → A), (seqCochainComplex x).KFlat ∧
      Nonempty (DerivedCategory.Q.obj (seqCochainComplex x) ≅
        (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
          (ModuleCat.of A (A ⧸ IsLocalRing.maximalIdeal A))) := by
  obtain ⟨r, x, hspan, hreg⟩ :=
    IsRegularLocalRing.exists_isKoszulRegular_span_eq_maximalIdeal A
  obtain ⟨e⟩ := nonempty_Q_obj_seqCochainComplex_iso_single x hreg
  rw [hspan] at e
  exact ⟨r, x, kFlat_seqCochainComplex x, ⟨e⟩⟩

end Koszul

end
