/-!
# Freeness of a module from freeness modulo a nonzerodivisor

Let `R` be a Noetherian local ring with maximal ideal `m`, let `x ∈ m`, and let `M` be a finite
`R`-module such that `x` is a nonzerodivisor on `M` and `M / xM` is free over `R / xR`. Then `M`
is free over `R`.

## Main results

* `free_mod_x`: the statement above.

## Background

Every notion involved is already available, and the statement is phrased directly in terms of
the corresponding Mathlib constructions:

* a Noetherian local ring, a commutative ring with a unique maximal ideal `m` in which every
  ideal is finitely generated, is `[IsNoetherianRing R] [IsLocalRing R]`, with `m` given by
  `maximalIdeal R`;
* a finite module, an `R`-module generated by finitely many elements, is `[Module.Finite R M]`;
* `x` is a nonzerodivisor on `M` when the multiplication map `M → M`, `m ↦ x • m`, is injective;
  this is `IsSMulRegular M x`, definitionally `Function.Injective (x • ·)`;
* the quotient `M / xM` is `M ⧸ (Ideal.span {x} • (⊤ : Submodule R M))`, and it carries a natural
  module structure over the quotient ring `R / xR = R ⧸ Ideal.span {x}` because `x` annihilates
  it;
* freeness, the existence of a basis, is `Module.Free R M`. As `M` is finite over the Noetherian
  local ring `R`, free is equivalent to finite free, with a well-defined rank.

## Proof outline

Lift a basis of `M / xM` over `R / xR` to elements `v i` of `M`. The induced map
`(ι → R) →ₗ[R] M` is surjective by Nakayama, and injective because a relation among the `v i`
has all coefficients divisible by `x`, so the kernel `K` satisfies `K ≤ xK` and hence vanishes.
-/

@[expose] public section

open IsLocalRing

/-- **Stacks Tag 00NS.** Let `R` be a Noetherian local ring with maximal ideal
`m`, and let `x ∈ m`. Let `M` be a finite `R`-module on which `x` is a
nonzerodivisor and such that `M / xM` is free over `R / xR`. Then `M` is free
over `R`. -/
@[stacks 00NS,
  ega "0 10.1.2" "special case",
  ega "0 10.2.2" "(x), special case",
  sga "1 IV 4.1" "(b), special case"]
theorem free_mod_x
    (R : Type*) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (x : R) (hx : x ∈ maximalIdeal R)
    (hnzd : IsSMulRegular M x)
    (hfree : Module.Free (R ⧸ Ideal.span {x})
      (M ⧸ (Ideal.span {x} • (⊤ : Submodule R M)))) :
    Module.Free R M := by
  classical
  set I : Ideal R := Ideal.span {x} with hI
  set S := R ⧸ I with hS
  set N : Submodule R M := I • (⊤ : Submodule R M) with hN
  set Q := M ⧸ N with hQ
  have hQfinR : Module.Finite R Q := inferInstance
  have hQfin : Module.Finite S Q := Module.Finite.of_restrictScalars_finite R S Q
  have hIne : I ≠ ⊤ := Ideal.span_singleton_ne_top (mem_nonunits_iff.mp hx)
  have : Nontrivial S := by
    rw [hS]
    exact (Ideal.Quotient.nontrivial_iff).mpr hIne
  obtain ⟨ι, b⟩ := (inferInstance : Module.Free S Q).exists_basis
  have hιfin' : Finite ι := Module.Finite.finite_basis b
  let : Fintype ι := Fintype.ofFinite ι
  have hsurj : Function.Surjective (Submodule.Quotient.mk : M → Q) :=
    Submodule.Quotient.mk_surjective N
  choose v hv using fun i => hsurj (b i)
  set f : (ι → R) →ₗ[R] M := Fintype.linearCombination R v with hf
  set mkI : R → S := fun r => Ideal.Quotient.mk I r with hmkI
  set mkM : M → Q := Submodule.Quotient.mk with hmkM
  have htor : ∀ (r : R) (q : Q), (mkI r) • q = r • q := fun r q =>
    Module.IsTorsionBySet.mk_smul (Module.isTorsionBySet_quotient_ideal_smul M I) r q
  have hkey : ∀ k : ι → R,
      mkM (f k) = Fintype.linearCombination S b (fun i => mkI (k i)) := by
    intro k
    have hmkQ : ∀ m : M, mkM m = N.mkQ m := fun m => rfl
    rw [hf, Fintype.linearCombination_apply, hmkQ, map_sum,
      Fintype.linearCombination_apply]
    apply Finset.sum_congr rfl
    intro i _
    rw [N.mkQ_apply, Submodule.Quotient.mk_smul, htor]
    change k i • mkM (v i) = k i • b i
    rw [hv i]
  have hxle : I ≤ maximalIdeal R := by
    rwa [hI, Ideal.span_le, Set.singleton_subset_iff]
  have hjac : I ≤ (⊥ : Ideal R).jacobson := hxle.trans (IsLocalRing.maximalIdeal_le_jacobson _)
  have hf_surj : Function.Surjective f := by
    rw [← LinearMap.range_eq_top]
    have hTfg : (⊤ : Submodule R M).FG := by
      rw [← Module.finite_def]; infer_instance
    refine top_le_iff.mp ?_
    refine Submodule.le_of_le_smul_of_le_jacobson_bot hTfg
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) ?_
    intro m _
    set s : ι → S := fun i => b.repr (mkM m) i with hs
    choose r hr using fun i => Ideal.Quotient.mk_surjective (s i)
    have hmkfr : mkM (f r) = mkM m := by
      rw [hkey r]
      have : (fun i => mkI (r i)) = s := by
        funext i; rw [hmkI]; exact hr i
      rw [this]
      rw [Fintype.linearCombination_apply]
      exact (Module.Basis.sum_equivFun b (mkM m))
    have hmem : m - f r ∈ N := by
      have hz : (Submodule.Quotient.mk (m - f r) : Q) = 0 := by
        rw [Submodule.Quotient.mk_sub]
        change mkM m - mkM (f r) = 0
        rw [hmkfr, sub_self]
      rwa [Submodule.Quotient.mk_eq_zero] at hz
    have hsplit : m = f r + (m - f r) := by abel
    rw [hsplit]
    exact Submodule.add_mem_sup (LinearMap.mem_range_self f r)
      (Submodule.smul_mono hxle le_rfl hmem)
  have hker_mem : ∀ k : ι → R, f k = 0 → ∀ i, k i ∈ I := by
    intro k hk i
    have h0 : Fintype.linearCombination S b (fun i => mkI (k i)) = 0 := by
      rw [← hkey k, hk]; simp [hmkM]
    have hli := b.linearIndependent
    rw [Fintype.linearIndependent_iff] at hli
    have : mkI (k i) = 0 := hli (fun i => mkI (k i)) h0 i
    rw [hmkI] at this
    exact (Ideal.Quotient.eq_zero_iff_mem).mp this
  have hf_inj : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot]
    have hKfg : (LinearMap.ker f).FG := IsNoetherian.noetherian _
    have hsub : LinearMap.ker f ≤ I • LinearMap.ker f := by
      intro k hk
      have hfk : f k = 0 := by rwa [LinearMap.mem_ker] at hk
      have hdvd : ∀ i, ∃ c, k i = x * c := by
        intro i
        have := hker_mem k hfk i
        rw [hI, Ideal.mem_span_singleton'] at this
        obtain ⟨c, hc⟩ := this
        exact ⟨c, by rw [← hc, mul_comm]⟩
      choose c hc using hdvd
      have hkc : k = x • c := by
        funext i; simp [Pi.smul_apply, smul_eq_mul, hc i]
      have hck : c ∈ LinearMap.ker f := by
        rw [LinearMap.mem_ker]
        apply hnzd
        change x • f c = x • 0
        rw [smul_zero, ← map_smul, ← hkc, hfk]
      have : k = x • c := hkc
      rw [this]
      exact Submodule.smul_mem_smul (by rw [hI]; exact Ideal.mem_span_singleton_self x) hck
    exact Submodule.eq_bot_of_le_smul_of_le_jacobson_bot I _ hKfg hsub hjac
  have e : (ι → R) ≃ₗ[R] M := LinearEquiv.ofBijective f ⟨hf_inj, hf_surj⟩
  exact Module.Free.of_equiv e

end

/-!
# Maximal Cohen-Macaulay modules over a regular local ring

Throughout, `R` is a commutative Noetherian local ring with maximal ideal `m = maximalIdeal R`,
and `M` is an `R`-module. The main result (Stacks Tag 00NT, Lemma 10.106.6) is that over a
regular local ring every maximal Cohen-Macaulay module is free.

## Main definitions

* `IsMaxCM`: a nonzero finite `R`-module `M` over a local ring `R` is *maximal Cohen-Macaulay*
  if there is an `M`-regular sequence contained in `m` whose length equals `ringKrullDim R`.

## Main results

* `regular_mcm_free`: over a regular local ring, a nonzero finitely generated maximal
  Cohen-Macaulay module is free.
* `isDomain_of_isRegularLocalRing_aux`: a regular local ring is an integral domain.
* `free_of_quotSMulTop_free`: if `x ∈ m` is a nonzerodivisor on the finite module `M` and
  `M / xM` is free over `R / xR`, then `M` is free over `R`.
* `rees_length_le_of_maximalIdeal_mem_associatedPrimes_quotient`: the inequality direction of
  Rees's theorem comparing the lengths of two regular sequences.

## Definitions used

A commutative ring `R` is a *regular local ring* if it is Noetherian, local with maximal ideal
`m`, and the minimal number of generators of `m` equals the Krull dimension of `R`. That minimal
number is `Submodule.spanFinrank (maximalIdeal R)`, which equals `dim_{R/m} (m / m²)` by
Nakayama, and the dimension is `ringKrullDim R`; the predicate is `IsRegularLocalRing`.

A finite sequence `x₁, …, x_n ∈ R` is an *`M`-regular sequence* if multiplication by `x_i` on
`M / (x₁, …, x_{i-1}) M` is injective for every `i`, and `(x₁, …, x_n) M ≠ M`. This is
`RingTheory.Sequence.IsRegular M [x₁, …, x_n]`.

For a Noetherian local ring `R`, the *depth* of a finite `R`-module `M` with `m M ≠ M` is the
supremum of the lengths of `M`-regular sequences contained in `m`, and `M` is *maximal
Cohen-Macaulay* (Stacks Tag 00N3) when `depth M = dim R`. Since `depth M ≤ dim R` always holds
and the depth is attained by some maximal `M`-regular sequence (Stacks 00LE), for a nonzero
finite module this is equivalent to the existence of an `M`-regular sequence in `m` of length
`dim R`, and that is the form `IsMaxCM` takes.

A regular local ring is Noetherian, so `dim R` is a finite natural number and the comparison
`(rs.length : WithBot ℕ∞) = ringKrullDim R` pins down an honest natural number length for the
regular sequence. The hypothesis `Nontrivial M`, i.e. `M ≠ 0`, appears because the
regular-sequence characterization requires it; it loses no generality, the zero module being
trivially free.

## Proof outline

Induction on `d = ringKrullDim R`. Unpack the maximal Cohen-Macaulay hypothesis into an
`M`-regular sequence `rs ⊆ m` with `rs.length = d`.

* Base `d = 0`: then `rs = []`. A regular local ring is an integral domain
  (`isDomain_of_isRegularLocalRing_aux`), and an integral domain of Krull dimension
  `0` is a field, over which every finite module is free.
* Step `d = n + 1`: by prime avoidance pick `x ∈ m` that is a regular parameter, `x ∉ m²`, and
  `M`-regular (`exists_regular_parameter`). Then `R / xR` is regular local of dimension `n`
  (`quotient_isRegularLocalRing`), and `M / xM` is a nonzero finite maximal Cohen-Macaulay
  `R / xR`-module whose regular sequence has length `n` (`mcm_of_quotient`). By the induction
  hypothesis `M / xM` is `R / xR`-free, and freeness lifts back to `M` over `R`
  (`free_of_quotSMulTop_free`, Stacks 00NS).

That a regular local ring is an integral domain (Stacks 00NP) is itself proved by induction on
`d`, through `exists_param_avoiding_minimalPrimes`,
`quotient_regular_of_param_avoiding_minimalPrimes`, `isDomain_of_span_singleton_isPrime` and the
inductive driver `isDomain_of_isRegularLocalRing_aux`.
-/

@[expose] public section

open IsLocalRing RingTheory.Sequence in
/-- A nonzero finite `R`-module `M` over a local ring `R` is *maximal Cohen-Macaulay* if there
exists an `M`-regular sequence contained in the maximal ideal whose length equals the Krull
dimension of `R`.  For nonzero finite modules this is equivalent to `depth M = dim R`. -/
@[ega "IV 7.5.3"]
def IsMaxCM (R : Type*) [CommRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] : Prop :=
  ∃ rs : List R,
    (∀ r ∈ rs, r ∈ maximalIdeal R) ∧
    RingTheory.Sequence.IsRegular M rs ∧
    (rs.length : WithBot ℕ∞) = ringKrullDim R

open IsLocalRing RingTheory.Sequence

universe u v

/-- Prime avoidance: a finite family of primes, none equal to `m`, is avoided by
some element of `m`. -/
private theorem exists_mem_maximalIdeal_notMem_of_finite_primes
    (R : Type*) [CommRing R] [IsLocalRing R]
    (S : Set (Ideal R)) (hSfin : S.Finite)
    (hprime : ∀ p ∈ S, p.IsPrime) (hne : ∀ p ∈ S, p ≠ maximalIdeal R) :
    ∃ c ∈ maximalIdeal R, ∀ p ∈ S, c ∉ p := by
  by_contra h
  push Not at h
  have hsub : (maximalIdeal R : Set R) ⊆ ⋃ p ∈ S, (id p : Ideal R) := by
    intro c hc
    obtain ⟨p, hp, hcp⟩ := h c hc
    exact Set.mem_biUnion hp hcp
  have hprime' : ∀ i ∈ S, i ≠ ⊥ → i ≠ ⊥ → (id i).IsPrime := by
    intro i hi _ _; exact hprime i hi
  obtain ⟨i, hi, hle⟩ := (Ideal.subset_union_prime_finite hSfin ⊥ ⊥ hprime').mp hsub
  have : i.IsPrime := hprime i hi
  have hle' : i ≤ maximalIdeal R := IsLocalRing.le_maximalIdeal_of_isPrime i
  exact hne i hi (le_antisymm hle' hle)

/-- Prime avoidance in positive dimension: a finite family of primes, none equal to `m`, is
avoided by some element of `m` outside `m²`. -/
private theorem exists_mem_maximalIdeal_notMem_sq_of_finite_primes
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (hdim : ringKrullDim R ≠ 0)
    (S : Set (Ideal R)) (hSfin : S.Finite)
    (hprime : ∀ p ∈ S, p.IsPrime) (hne : ∀ p ∈ S, p ≠ maximalIdeal R) :
    ∃ x ∈ maximalIdeal R, x ∉ (maximalIdeal R) ^ 2 ∧ ∀ p ∈ S, x ∉ p := by
  set m := maximalIdeal R with hm
  by_contra h
  push Not at h
  have hsub : (m : Set R) ⊆ ⋃ i ∈ insert (m ^ 2) S, (id i : Ideal R) := by
    intro x hx
    by_cases hx2 : x ∈ m ^ 2
    · exact Set.mem_biUnion (Set.mem_insert _ _) hx2
    · obtain ⟨p, hp, hxp⟩ := h x hx hx2
      exact Set.mem_biUnion (Set.mem_insert_of_mem _ hp) hxp
  have hprime' : ∀ i ∈ insert (m ^ 2) S, i ≠ m ^ 2 → i ≠ m ^ 2 → (id i).IsPrime := by
    rintro i (rfl | hi) hne' _
    · exact absurd rfl hne'
    · exact hprime i hi
  obtain ⟨i, hi, hle⟩ := (Ideal.subset_union_prime_finite (hSfin.insert _) (m ^ 2) (m ^ 2)
    hprime').mp hsub
  rcases hi with rfl | hi
  · -- `m ≤ m²`: Nakayama forces `m = ⊥`, so `R` is a field, contradicting `dim R ≠ 0`.
    have hNN : m ≤ ⊥ ⊔ m • m := by rwa [bot_sup_eq, smul_eq_mul, ← pow_two]
    have hle' := Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hNN
    exact hdim (ringKrullDim_eq_zero_of_isField
      (isField_iff_maximalIdeal_eq.mpr (le_bot_iff.mp hle')))
  · have := hprime i hi
    exact hne i hi (le_antisymm (IsLocalRing.le_maximalIdeal_of_isPrime i) hle)

/-- An element of `m` regular on `M` shows that `m` is not an associated prime of `M`. -/
private theorem maximalIdeal_notMem_associatedPrimes_of_isSMulRegular
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (c : R) (hcmem : c ∈ maximalIdeal R) (hcreg : IsSMulRegular M c) :
    maximalIdeal R ∉ associatedPrimes R M := by
  intro hmass
  have : c ∈ ⋃ p ∈ associatedPrimes R M, (p : Set R) := Set.mem_biUnion hmass hcmem
  rw [biUnion_associatedPrimes_eq_compl_regular] at this
  exact this hcreg

/-- An element avoiding all associated primes of `M` is `M`-regular. -/
private theorem isSMulRegular_of_forall_notMem_associatedPrimes_aux
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (c : R) (h : ∀ p ∈ associatedPrimes R M, c ∉ p) :
    IsSMulRegular M c := by
  by_contra hreg
  have hmem : c ∈ ⋃ p ∈ associatedPrimes R M, (p : Set R) := by
    rwa [biUnion_associatedPrimes_eq_compl_regular]
  rw [Set.mem_iUnion₂] at hmem
  obtain ⟨p, hp, hcp⟩ := hmem
  exact h p hp hcp

/-- If no element of `m` is `M`-regular, then `m` is an associated prime of `M`. -/
private theorem maximalIdeal_mem_associatedPrimes_of_forall_not_isSMulRegular
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (h : ∀ c ∈ maximalIdeal R, ¬ IsSMulRegular M c) :
    maximalIdeal R ∈ associatedPrimes R M := by
  by_contra hm
  obtain ⟨c, hcm, hc⟩ := exists_mem_maximalIdeal_notMem_of_finite_primes R (associatedPrimes R M)
    (associatedPrimes.finite R M) (fun p hp => hp.isPrime) (fun p hp hpm => hm (hpm ▸ hp))
  exact h c hcm (isSMulRegular_of_forall_notMem_associatedPrimes_aux R M c hc)

/-- **A good parameter for the domain induction.** In a regular
local ring of positive dimension there is `x ∈ maximalIdeal R` with
`x ∉ (maximalIdeal R)^2` that lies in no minimal prime of `R`.

Proof (prime avoidance): the minimal primes
`p₁,…,p_r` are finite (`minimalPrimes.finite_of_isNoetherianRing`); were
`m ⊆ m² ∪ ⋃ pᵢ`, then `Ideal.subset_union_prime` (only `m²` is possibly
non-prime) forces `m ⊆ m²` (⇒ `m = 0` by Nakayama ⇒ `dim = 0`, contra) or
`m ⊆ pᵢ` (⇒ `m = pᵢ` minimal ⇒ `dim = 0`, contra).  So pick
`x ∈ m \ (m² ∪ ⋃ pᵢ)`. -/
theorem exists_param_avoiding_minimalPrimes
    (R : Type*) [CommRing R] [IsRegularLocalRing R] (hdim : ringKrullDim R ≠ 0) :
    ∃ x ∈ maximalIdeal R, x ∉ (maximalIdeal R) ^ 2 ∧
      ∀ p ∈ minimalPrimes R, x ∉ p := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  refine exists_mem_maximalIdeal_notMem_sq_of_finite_primes R hdim _
    (minimalPrimes.finite_of_isNoetherianRing R) (fun p hp => hp.1.1) ?_
  -- `m` is not a minimal prime, since otherwise `height m = 0 = dim R`.
  rintro p hp rfl
  have hdimeq : (↑(maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
    IsLocalRing.maximalIdeal_height_eq_ringKrullDim
  rw [Ideal.height_eq_zero_iff.mpr hp] at hdimeq
  simp at hdimeq
  exact hdim hdimeq.symm

open scoped Pointwise in
/-- The pointwise scalar action `x • ⊤` on the unit ideal equals `span {x}`.  Stated separately
so that the `Pointwise` scoped notation does not leak. -/
theorem smul_top_eq_span_singleton {R : Type*} [CommRing R] (x : R) :
    (x • (⊤ : Ideal R) : Ideal R) = Ideal.span {x} := by
  ext y; simp [Submodule.mem_smul_pointwise_iff_exists, Ideal.mem_span_singleton,
    dvd_iff_exists_eq_mul_left, eq_comm, mul_comm]

open scoped Pointwise in
/-- Krull's principal-ideal inequality in the form `ringKrullDim R ≤ ringKrullDim (R ⧸ span {x})
+ 1`, for `x` in the maximal ideal of a Noetherian local ring. -/
@[ega "0 16.3.4" "special case",
  ega "0 16.3.7" "Local ring; M = A; k = 1",
  ega "IV 5.5.1" "special case",
  ega "IV 5.5.2" "special case"]
theorem ringKrullDim_le_quotient_span_singleton_succ
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {x : R}
    (hx : x ∈ maximalIdeal R) :
    ringKrullDim R ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1 := by
  have h := ringKrullDim_le_ringKrullDim_quotSMulTop_succ (R := R) hx
  rwa [smul_top_eq_span_singleton] at h

/-- **The quotient is regular of one lower dimension.** If `R` is a
regular local ring of positive dimension and `x ∈ maximalIdeal R` with
`x ∉ (maximalIdeal R)^2` lies in no minimal prime of `R`, then `R ⧸ span{x}` is
a regular local ring and `ringKrullDim (R ⧸ span{x}) + 1 = ringKrullDim R`.

Proof:
* dimension drop by exactly one — `≥` from
  `ringKrullDim_le_ringKrullDim_quotSMulTop_succ`; `≤` because any prime of
  `R/(x)` lifts to a prime of `R` containing `x`, which (as `x` avoids minimal
  primes) strictly contains a minimal prime, so a chain of length `ℓ` lifts to
  one of length `ℓ+1` in `R`;
* `spanFinrank` of `m̄` is `d-1`: the cotangent map kills exactly the line
  `k·x̄` since `x ∉ m²` (`IsRegularLocalRing.of_spanFinrank_maximalIdeal_le`). -/
@[ega "0 16.1.2" "special case",
  ega "0 16.2.3.1" "(ii), special case",
  ega "0 16.3.4" "special case",
  ega "0 17.1.7" "r=1: a'⇒b",
  ega "0 17.1.9" "(b) ⇒ (a), one generator"]
theorem quotient_regular_of_param_avoiding_minimalPrimes
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (x : R) (hx : x ∈ maximalIdeal R) (hx2 : x ∉ (maximalIdeal R) ^ 2)
    (hxmin : ∀ p ∈ minimalPrimes R, x ∉ p) :
    IsRegularLocalRing (R ⧸ Ideal.span {x}) ∧
      ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R := by
  classical
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have : IsLocalRing R := IsRegularLocalRing.toIsLocalRing
  set m := maximalIdeal R with hm
  -- `span{x} ≠ ⊤` since `x ∈ m`.
  have hne : Ideal.span {x} ≠ ⊤ := Ideal.span_singleton_ne_top (mem_nonunits_iff.mp hx)
  have hntq : Nontrivial (R ⧸ Ideal.span {x}) := (Ideal.Quotient.nontrivial_iff).mpr hne
  have hlocq : IsLocalRing (R ⧸ Ideal.span {x}) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  set mk := Ideal.Quotient.mk (Ideal.span {x}) with hmk
  ------------------------------------------------------------------
  -- Dimension drop: `≥` direction.
  ------------------------------------------------------------------
  have hge : ringKrullDim R ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1 :=
    ringKrullDim_le_quotient_span_singleton_succ hx
  ------------------------------------------------------------------
  -- Dimension drop: `≤` direction.  Any prime chain in `R/(x)` lifts to a
  -- chain of primes of `R` containing `x`; the bottom one is not minimal
  -- (since `x` avoids all minimal primes), so we prepend a minimal prime.
  ------------------------------------------------------------------
  have hle : ringKrullDim (R ⧸ Ideal.span {x}) + 1 ≤ ringKrullDim R := by
    have : Nonempty ↑(PrimeSpectrum.zeroLocus (R := R) (Ideal.span {x})) :=
      ⟨⟨⟨maximalIdeal R, Ideal.IsMaximal.isPrime (maximalIdeal.isMaximal R)⟩, by
        rw [PrimeSpectrum.mem_zeroLocus]; exact (Ideal.span_singleton_le_iff_mem _).mpr hx⟩⟩
    have perelem : ∀ (p : LTSeries ↑(PrimeSpectrum.zeroLocus (R := R) (Ideal.span {x}))),
        (p.length : ℕ∞) + 1 ≤ (maximalIdeal R).height := by
      intro p
      have hsm : StrictMono
          (Subtype.val : ↑(PrimeSpectrum.zeroLocus (R := R) (Ideal.span {x})) → PrimeSpectrum R) :=
        fun a b h => h
      set p' := p.map (Subtype.val) hsm with hp'
      have hhead : x ∈ (p'.head).asIdeal := by
        have hmem : (p.head : PrimeSpectrum R) ∈ PrimeSpectrum.zeroLocus (Ideal.span {x}) :=
            (p.head).property
        rw [PrimeSpectrum.mem_zeroLocus] at hmem
        have hx' : x ∈ (p.head : PrimeSpectrum R).asIdeal := hmem (Ideal.subset_span rfl)
        rwa [hp', LTSeries.head_map]
      have : (p'.head).asIdeal.IsPrime := (p'.head).isPrime
      obtain ⟨p₀, hp₀min, hp₀le⟩ :=
        Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal R)) (J := (p'.head).asIdeal) bot_le
      have hxp₀ : x ∉ p₀ := hxmin p₀ hp₀min
      have hlt : p₀ < (p'.head).asIdeal := lt_of_le_of_ne hp₀le (by rintro rfl; exact hxp₀ hhead)
      let P₀ : PrimeSpectrum R := ⟨p₀, hp₀min.1.1⟩
      have hPlt : P₀ < p'.head := hlt
      let p'' := p'.cons P₀ hPlt
      have hlast_le : p''.last ≤ IsLocalRing.closedPoint R := by
        rw [RelSeries.last_cons, hp', LTSeries.last_map]
        change (p.last : PrimeSpectrum R).asIdeal ≤ maximalIdeal R
        exact IsLocalRing.le_maximalIdeal_of_isPrime _
      have hlen : p''.length = p.length + 1 := by
        rw [show p'' = p'.cons P₀ hPlt from rfl, RelSeries.cons_length, hp', LTSeries.map_length]
      have hkey := Order.length_le_height (x := IsLocalRing.closedPoint R) (p := p'') hlast_le
      rw [hlen] at hkey
      rw [show (maximalIdeal R).height = Order.height (IsLocalRing.closedPoint R) from
          PrimeSpectrum.height_eq_orderHeight (IsLocalRing.closedPoint R)]
      exact_mod_cast hkey
    rw [ringKrullDim_quotient, Order.krullDim_eq_iSup_length,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← WithBot.coe_one, ← WithBot.coe_add, WithBot.coe_le_coe, add_comm, ENat.add_iSup]
    exact iSup_le (fun p => by rw [add_comm]; exact perelem p)
  have hdimeq : ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R := le_antisymm hle hge
  ------------------------------------------------------------------
  -- Regularity: `spanFinrank(m̄) + 1 ≤ spanFinrank(m)`, since `x ∉ m²` makes
  -- `x` part of a minimal generating set of `m`, so killing it drops the
  -- minimal number of generators of `m` by one.
  ------------------------------------------------------------------
  have hsfbound :
      (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank + 1 ≤ m.spanFinrank := by
    have hmfg : m.FG := IsNoetherian.noetherian _
    obtain ⟨s0, hs0card, hs0span⟩ := Submodule.exists_span_set_card_eq_spanRank m
    have hs0fin : s0.Finite := by
      have hlt : m.spanRank < Cardinal.aleph0 := by
        rw [Submodule.FG.spanRank_eq_spanFinrank hmfg]
        exact Cardinal.natCast_lt_aleph0
      rw [← hs0card] at hlt
      exact Cardinal.lt_aleph0_iff_set_finite.mp hlt
    have := hs0fin.fintype
    set G := hs0fin.toFinset with hG
    have hGspan : Ideal.span (G : Set R) = m := by rwa [hG, Set.Finite.coe_toFinset]
    have hGcard : G.card = m.spanFinrank := by
      rw [hG, Set.Finite.card_toFinset]
      have h2 : m.spanFinrank = m.spanRank.toNat := by
        simp [Submodule.FG.spanRank_eq_spanFinrank hmfg]
      rw [h2, ← hs0card, Cardinal.mk_fintype, Cardinal.toNat_natCast]
    have hxmem : x ∈ Submodule.span R (G : Set R) := by
      rwa [show Submodule.span R (G : Set R) = m from hGspan]
    rw [Submodule.mem_span_finset] at hxmem
    obtain ⟨c, hcsupp, hcsum⟩ := hxmem
    have hex : ∃ g₀ ∈ G, c g₀ ∉ m := by
      by_contra hcon
      push Not at hcon
      apply hx2
      rw [← hcsum, pow_two]
      exact Ideal.sum_mem _
        (fun g hg => Ideal.mul_mem_mul (hcon g hg) (hGspan ▸ Ideal.subset_span hg))
    obtain ⟨g₀, hg₀G, hg₀m⟩ := hex
    have hunit : IsUnit (c g₀) := IsLocalRing.notMem_maximalIdeal.mp hg₀m
    have hmbar : maximalIdeal (R ⧸ Ideal.span {x}) = Ideal.span (mk '' (G : Set R)) := by
      rw [← IsLocalRing.map_maximalIdeal_of_surjective mk Ideal.Quotient.mk_surjective,
        show maximalIdeal R = Ideal.span (G : Set R) from hGspan.symm, Ideal.map_span]
    have hspaneq : Ideal.span (mk '' (G.erase g₀ : Set R)) = Ideal.span (mk '' (G : Set R)) := by
      have hmkx : mk x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x)
      apply le_antisymm
      · exact Ideal.span_mono (Set.image_mono fun _ ha => Finset.mem_of_mem_erase ha)
      · rw [Ideal.span_le]
        rintro _ ⟨a, haG, rfl⟩
        by_cases hag₀ : a = g₀
        · subst hag₀
          have hsum0 : (mk (c a)) * (mk a) + ∑ b ∈ G.erase a, (mk (c b)) * (mk b) = 0 := by
            have hh : mk (∑ a ∈ G, c a • a) = 0 := by rwa [hcsum]
            rw [map_sum, ← Finset.add_sum_erase _ _ haG] at hh
            simpa only [smul_eq_mul, map_mul] using hh
          obtain ⟨u, hu⟩ := hunit.map mk
          have hmaeq : mk a = ↑u⁻¹ * (- ∑ b ∈ G.erase a, (mk (c b)) * (mk b)) := by
            have h1 : (↑u) * mk a = - ∑ b ∈ G.erase a, (mk (c b)) * (mk b) := by
              rw [hu]; linear_combination hsum0
            rw [← h1, ← mul_assoc, Units.inv_mul, one_mul]
          rw [hmaeq]
          exact Ideal.mul_mem_left _ _ (neg_mem (Ideal.sum_mem _
            (fun b hb => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, hb, rfl⟩))))
        · exact Ideal.subset_span ⟨a, Finset.mem_erase.mpr ⟨hag₀, haG⟩, rfl⟩
    have hsfle : (maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank ≤ (G.erase g₀).card := by
      rw [hmbar, ← hspaneq]
      calc Submodule.spanFinrank (Ideal.span (mk '' (G.erase g₀ : Set R)))
          ≤ (mk '' (G.erase g₀ : Set R)).ncard :=
            Submodule.spanFinrank_span_le_ncard_of_finite
              (Set.Finite.image _ (G.erase g₀).finite_toSet)
        _ ≤ (G.erase g₀ : Set R).ncard := Set.ncard_image_le (G.erase g₀).finite_toSet
        _ = (G.erase g₀).card := Set.ncard_coe_finset _
    have hcarderase : (G.erase g₀).card = m.spanFinrank - 1 := by
      rw [Finset.card_erase_of_mem hg₀G, hGcard]
    rw [hcarderase] at hsfle
    have hdpos : 1 ≤ m.spanFinrank := by rw [← hGcard]; exact Finset.card_pos.mpr ⟨g₀, hg₀G⟩
    omega
  ------------------------------------------------------------------
  -- Conclude regularity from the `spanFinrank` bound and the dimension drop.
  ------------------------------------------------------------------
  have hreg : IsRegularLocalRing (R ⧸ Ideal.span {x}) := by
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    -- `↑(sf m̄) + 1 ≤ ↑(sf m) = ringKrullDim R = ringKrullDim(R/(x)) + 1`, then cancel `+1`.
    have hRdim : ringKrullDim R = (↑m.spanFinrank : WithBot ℕ∞) :=
      (IsRegularLocalRing.spanFinrank_maximalIdeal).symm
    have hbound : (↑(maximalIdeal (R ⧸ Ideal.span {x})).spanFinrank : WithBot ℕ∞) + 1
        ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1 := by
      rw [hdimeq, hRdim]
      exact_mod_cast hsfbound
    exact ENat.WithBot.add_le_add_natCast_right_iff.mp hbound
  exact ⟨hreg, hdimeq⟩

/-- **The domain finish, via Nakayama on a minimal prime.** If
`x ∈ maximalIdeal R` lies in no minimal prime of `R` and the ideal `span{x}` is
prime, then `R` is an integral domain.

Proof: `span{x}` prime contains a minimal prime
`q` (`Ideal.exists_minimalPrimes_le`).  For `q ∈ q ⊆ (x)`, write `q = a·x`;
since `x ∉ q` and `q` is prime, `a ∈ q`; hence `q ⊆ x·q ⊆ m·q`, so `q = m·q`,
and Nakayama (`Submodule.eq_bot_of_le_smul_of_le_jacobson_bot`) gives `q = ⊥`.
Thus `⊥` is prime and `IsDomain.of_bot_isPrime` applies. -/
theorem isDomain_of_span_singleton_isPrime
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (x : R) (hxmin : ∀ p ∈ minimalPrimes R, x ∉ p)
    (hxprime : (Ideal.span {x}).IsPrime) : IsDomain R := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  set m := maximalIdeal R with hm
  -- `span{x}` is prime and contains `⊥`, so a minimal prime `q` of `R` lies below it.
  obtain ⟨q, hqmin, hqle⟩ :=
    Ideal.exists_minimalPrimes_le (J := Ideal.span {x}) (I := ⊥) bot_le
  have hqprime : q.IsPrime := hqmin.left.left
  -- `x ∉ q` since `q` is a minimal prime of `R`.
  have hxq : x ∉ q := hxmin q hqmin
  -- `span{x}` is prime hence proper, so `x ∈ span{x} ≤ m`.
  have hxm : x ∈ m :=
    IsLocalRing.le_maximalIdeal_of_isPrime (Ideal.span {x}) (Ideal.subset_span (Set.mem_singleton
        x))
  -- Show `q ≤ m • q`.
  have hqsmul : q ≤ m • q := by
    intro y hy
    -- `y ∈ q ⊆ span{x}`, so `y = c * x`.
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hqle hy)
    -- `c * x ∈ q`, `q` prime, `x ∉ q` ⟹ `c ∈ q`.
    have hcx : c * x ∈ q := hc ▸ hy
    have hcq : c ∈ q := (hqprime.mem_or_mem hcx).resolve_right hxq
    -- `y = c * x = x * c ∈ m • q` since `x ∈ m` and `c ∈ q`.
    have : y = x • c := by rw [← hc, smul_eq_mul, mul_comm]
    rw [this]
    exact Submodule.smul_mem_smul hxm hcq
  -- Nakayama: `q ≤ ⊥ ⊔ m • q` and `m ≤ jacobson ⊥` ⟹ `q ≤ ⊥`.
  have hfg : q.FG := IsNoetherian.noetherian _
  have hjac : m ≤ Ideal.jacobson ⊥ := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  have hNN : q ≤ ⊥ ⊔ m • q := by rwa [bot_sup_eq]
  have hle' := Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac hNN
  have hbot : q = ⊥ := le_bot_iff.mp hle'
  -- `⊥` is prime, so `R` is a domain.
  have : (⊥ : Ideal R).IsPrime := hbot ▸ hqprime
  exact IsDomain.of_bot_isPrime R

/-- A regular local ring is a domain, by induction on the natural number
`n = ringKrullDim R`.  Base `n = 0`: `m = ⊥`, so `R` is a field, hence a domain.
Step: choose `x` via `exists_param_avoiding_minimalPrimes`; `R/(x)` is regular
of dimension `n-1` (`quotient_regular_of_param_avoiding_minimalPrimes`), a domain
by IH, so `span{x}` is prime, and `isDomain_of_span_singleton_isPrime` finishes. -/
@[ega "0 17.1.3"]
theorem isDomain_of_isRegularLocalRing_aux :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsRegularLocalRing R],
      ringKrullDim R = (n : WithBot ℕ∞) → IsDomain R := by
  intro n
  induction n with
  | zero =>
    intro R _ _ hd
    -- `ringKrullDim R = 0` ⇒ `spanFinrank m = 0` ⇒ `m = ⊥` ⇒ `R` is a field.
    -- A field is a domain.
    have hfg : (maximalIdeal R).FG := IsNoetherian.noetherian _
    have hsf : Submodule.spanFinrank (maximalIdeal R) = 0 := by
      have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
      rw [hd] at h
      exact_mod_cast h
    have hbot : maximalIdeal R = ⊥ := (Submodule.spanFinrank_eq_zero_iff_eq_bot hfg).mp hsf
    have hfield : IsField R := isField_iff_maximalIdeal_eq.mpr hbot
    exact hfield.isDomain
  | succ n ih =>
    intro R _ _ hd
    have hdim : ringKrullDim R ≠ 0 := by
      rw [hd]; exact_mod_cast (Nat.succ_ne_zero n)
    obtain ⟨x, hx, hx2, hxmin⟩ := exists_param_avoiding_minimalPrimes R hdim
    obtain ⟨hRq, hdimq⟩ :=
      quotient_regular_of_param_avoiding_minimalPrimes R x hx hx2 hxmin
    have : IsRegularLocalRing (R ⧸ Ideal.span {x}) := hRq
    -- `dim (R/(x)) = n`, so the IH applies.
    have hdq : ringKrullDim (R ⧸ Ideal.span {x}) = (n : WithBot ℕ∞) := by
      have hRdim : ringKrullDim R = ((n : ℕ) + 1 : ℕ) := by exact_mod_cast hd
      rw [hRdim] at hdimq
      -- hdimq : ringKrullDim (R/(x)) + 1 = ↑(n+1); cancel the `+1` using finiteness
      -- of the (regular local) quotient's dimension.
      have hfin : ringKrullDim (R ⧸ Ideal.span {x})
          = ((Submodule.spanFinrank (maximalIdeal (R ⧸ Ideal.span {x})) : ℕ) : WithBot ℕ∞) :=
        (IsRegularLocalRing.spanFinrank_maximalIdeal).symm
      set m := Submodule.spanFinrank (maximalIdeal (R ⧸ Ideal.span {x})) with hm
      rw [hfin] at hdimq ⊢
      have hcast : ((m + 1 : ℕ) : WithBot ℕ∞) = ((n + 1 : ℕ) : WithBot ℕ∞) := by
        push_cast; push_cast at hdimq; exact hdimq
      have hmn : m = n := by have := Nat.cast_injective (R := WithBot ℕ∞) hcast; omega
      rw [hmn]
    have hRqDom : IsDomain (R ⧸ Ideal.span {x}) := ih (R ⧸ Ideal.span {x}) hdq
    -- `R/(x)` a domain ⇒ `span{x}` prime ⇒ finish via A3.
    have : (Ideal.span {x}).IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime (Ideal.span {x})).mp hRqDom
    exact isDomain_of_span_singleton_isPrime R x hxmin ‹(Ideal.span {x}).IsPrime›

/-- A regular local ring is an integral domain. -/
private theorem isDomain_of_isRegularLocalRing (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    IsDomain R :=
  isDomain_of_isRegularLocalRing_aux (Submodule.spanFinrank (maximalIdeal R)) R
    (IsRegularLocalRing.spanFinrank_maximalIdeal).symm

/-- **The base case.** A finite module over a regular local ring of
Krull dimension `0` is free, because such a ring is a field.

From `hd` get `Ring.KrullDimLE 0 R`
(`Ring.krullDimLE_iff` + `simp`/`norm_num` for `0 ≤ ↑0`); with `IsDomain R`
(`isDomain_of_isRegularLocalRing_aux`) apply `Ring.KrullDimLE.isField_of_isDomain` to get
`IsField R`; turn that into a `Field R` instance (`IsField.toField` / `letI`) and conclude
with `Module.Free.of_divisionRing`. -/
@[ega "0 17.3.5" "(i), special case"]
theorem free_of_isRegularLocalRing_dim_zero
    (R : Type*) [CommRing R] [IsRegularLocalRing R] (hd : ringKrullDim R = 0)
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    Module.Free R M := by
  have : IsDomain R := isDomain_of_isRegularLocalRing R
  have : Ring.KrullDimLE 0 R := by
    rw [Ring.krullDimLE_iff, hd]; norm_num
  have hfield : IsField R := Ring.KrullDimLE.isField_of_isDomain
  let := hfield.toField
  exact Module.Free.of_divisionRing R M

/-- **The quotient is regular local of one lower dimension.**
If `x ∈ maximalIdeal R`, `x` lies outside `(maximalIdeal R)^2` (equivalently `x`
is part of a regular system of parameters), then `R ⧸ span{x}` is again a
regular local ring, and its Krull dimension is `ringKrullDim R - 1`.  Here we
record the dimension drop in the convenient `succ` form.

Killing a regular parameter `x ∉ m²` of a regular local
ring yields a regular local ring (its maximal ideal is minimally generated by
`d-1` elements and its dimension drops by exactly one,
`ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors`). -/
@[ega "0 16.1.2" "special case",
  ega "0 16.2.3.1" "(ii), special case",
  ega "0 16.3.4" "special case",
  ega "0 17.1.7" "r=1: a'⇒b",
  ega "0 17.1.8" "b ⇒ a",
  ega "0 17.1.9" "(b) ⇒ (a), one generator",
  ega "IV 5.5.1" "DVR base, special case"]
theorem quotient_isRegularLocalRing
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (x : R) (hx : x ∈ maximalIdeal R) (hx2 : x ∉ (maximalIdeal R) ^ 2) :
    IsRegularLocalRing (R ⧸ Ideal.span {x}) ∧
      ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R := by
  have : IsDomain R := isDomain_of_isRegularLocalRing R
  -- `x ≠ 0` since `0 ∈ m²` but `x ∉ m²`.
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hx2 (Submodule.zero_mem _)
  -- In a domain, the only minimal prime is `⊥`, which `x ≠ 0` avoids.
  have hxmin : ∀ p ∈ minimalPrimes R, x ∉ p := by
    intro p hp
    rw [IsDomain.minimalPrimes_eq_singleton_bot, Set.mem_singleton_iff] at hp
    subst hp
    simpa [Ideal.mem_bot] using hx0
  exact quotient_regular_of_param_avoiding_minimalPrimes R x hx hx2 hxmin

/-- **Existence of a good parameter.** If `R` is a regular local
ring of positive Krull dimension and `M` is a nonzero finite MCM `R`-module (so
in particular `m ∉ Ass M`, equivalently `depth M = dim R ≥ 1`), then there is an
element `x ∈ maximalIdeal R` with `x ∉ (maximalIdeal R)^2` (a regular parameter)
that is also a nonzerodivisor on `M` (`IsSMulRegular M x`).

Reason (Stacks 10.106.6 / prime avoidance): the union of the (finitely many)
associated primes of `M` together with `m²` does not cover `m` when
`dim R ≥ 1` — since `m ∉ Ass M` (as `depth M ≥ 1`) and `m² ⊊ m`
(`maximalIdeal_sq_lt_of_ringKrullDim_ne_zero`) — so by prime avoidance
(`Ideal.subset_union_prime`, Stacks 00DS) some `x ∈ m \ (m² ∪ ⋃ Ass M)`
exists; such `x` is both a regular parameter and `M`-regular.  The hypothesis bundles a nonzero,
finite, MCM `M` via its regular-sequence witness so that `depth M ≥ 1`. -/
theorem exists_regular_parameter
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (hdim : ringKrullDim R ≠ 0) (hM : IsMaxCM R M) :
    ∃ x ∈ maximalIdeal R, x ∉ (maximalIdeal R) ^ 2 ∧ IsSMulRegular M x := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  set m := maximalIdeal R with hm
  -- Unpack the MCM witness.  Since `dim R ≠ 0`, the regular sequence is nonempty.
  obtain ⟨rs, hmem, hreg, hleneq⟩ := hM
  -- The head of `rs` is `M`-regular and lies in `m`.
  obtain ⟨r, tl, rfl⟩ : ∃ r tl, rs = r :: tl := by
    cases rs with
    | nil => simp at hleneq; exact absurd hleneq.symm hdim
    | cons r tl => exact ⟨r, tl, rfl⟩
  have hrmem : r ∈ m := hmem r (List.mem_cons_self ..)
  have hrreg : IsSMulRegular M r :=
    ((RingTheory.Sequence.isWeaklyRegular_cons_iff M r tl).mp
      hreg.toIsWeaklyRegular).left
  -- `m` is NOT an associated prime of `M`, because `r ∈ m` is `M`-regular.
  have hmnotass := maximalIdeal_notMem_associatedPrimes_of_isSMulRegular R M r hrmem hrreg
  -- Prime avoidance over `Ass M` and `m²`.
  obtain ⟨x, hxm, hx2, hx⟩ := exists_mem_maximalIdeal_notMem_sq_of_finite_primes R hdim
    (associatedPrimes R M) (associatedPrimes.finite R M) (fun p hp => hp.isPrime)
    (fun p hp hpm => hmnotass (hpm ▸ hp))
  exact ⟨x, hxm, hx2, isSMulRegular_of_forall_notMem_associatedPrimes_aux R M x hx⟩

/-- **(⋆⋆) Exchange equivalence for two regular elements.**
Over a Noetherian local ring `R`, if `a, b ∈ m = maximalIdeal R` are both
`M`-regular (where `M` is a nonzero finite module), then `b` is regular on `M/aM`
iff `a` is regular on `M/bM`.  This is the engine of Rees's exchange: it follows
purely from `isRegular_cons_iff` (a two-element sequence is regular iff the head
is regular and the tail is regular on the quotient) and the permutation
invariance of regular sequences in a local ring (`IsLocalRing.isRegular_of_perm`). -/
theorem exchange_isSMulRegular_quotSMulTop
    (R : Type*) [CommRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [IsNoetherian R M] [Nontrivial M]
    [Module.Finite R M]
    (a b : R) (ha : a ∈ maximalIdeal R) (hb : b ∈ maximalIdeal R)
    (haReg : IsSMulRegular M a) (hbReg : IsSMulRegular M b) :
    IsSMulRegular (QuotSMulTop a M) b ↔ IsSMulRegular (QuotSMulTop b M) a := by
  have key : ∀ x y : R, x ∈ maximalIdeal R → y ∈ maximalIdeal R →
      IsSMulRegular M x → IsSMulRegular (QuotSMulTop x M) y →
      RingTheory.Sequence.IsRegular M [x, y] := by
    intro x y hx hy hxr hyr
    refine RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal
      (L := M) ?_ ?_
    · intro w hw
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hw
      rcases hw with rfl | rfl <;> assumption
    · rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
      refine ⟨hxr, ?_⟩
      rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff]
      exact hyr
  have unfold : ∀ x y : R, RingTheory.Sequence.IsRegular M [x, y] →
      IsSMulRegular (QuotSMulTop x M) y := by
    intro x y h
    rw [RingTheory.Sequence.isRegular_cons_iff, RingTheory.Sequence.isRegular_cons_iff] at h
    exact h.right.left
  exact ⟨fun h => unfold b a (IsLocalRing.isRegular_of_perm (key a b ha hb haReg h)
      (List.Perm.swap b a [])),
    fun h => unfold a b (IsLocalRing.isRegular_of_perm (key b a hb ha hbReg h)
      (List.Perm.swap a b []))⟩

/-- **Common regular element (prime avoidance; input to Bruns–Herzog 1.2.5).**
Given two nonzero finite `R`-modules `M`, `N` over a Noetherian local ring, neither
having `m = maximalIdeal R` as an associated prime, there is a single `c ∈ m` that is
both `M`-regular and `N`-regular.  This is pure prime avoidance over the finite family
`Ass M ∪ Ass N`, none of whose members is `m`, mirroring `exists_regular_parameter`. -/
theorem exists_isSMulRegular_two
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M N : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] [Nontrivial M] [Nontrivial N]
    (hM : maximalIdeal R ∉ associatedPrimes R M)
    (hN : maximalIdeal R ∉ associatedPrimes R N) :
    ∃ c ∈ maximalIdeal R, IsSMulRegular M c ∧ IsSMulRegular N c := by
  -- Prime avoidance over the finite family `Ass M ∪ Ass N`, none of whose members is `m`.
  obtain ⟨c, hcmem, hc⟩ := exists_mem_maximalIdeal_notMem_of_finite_primes R
    (associatedPrimes R M ∪ associatedPrimes R N)
    ((associatedPrimes.finite R M).union (associatedPrimes.finite R N))
    (fun p hp => hp.elim (·.isPrime) (·.isPrime))
    (fun p hp hpm => hp.elim (fun h => hM (hpm ▸ h)) (fun h => hN (hpm ▸ h)))
  exact ⟨c, hcmem,
    isSMulRegular_of_forall_notMem_associatedPrimes_aux R M c fun p hp => hc p (Or.inl hp),
    isSMulRegular_of_forall_notMem_associatedPrimes_aux R N c fun p hp => hc p (Or.inr hp)⟩

open scoped Pointwise in
/-- **Socle transfer between regular quotients.**  Over a Noetherian local ring `R`, if
`a, z ∈ m = maximalIdeal R` are both `M`-regular (`M` finite, nonzero), then
`m ∈ Ass(M/zM)` implies `m ∈ Ass(M/aM)`.  The criterion `m ∈ Ass(M/cM)` for an `M`-regular
`c ∈ m` is independent of `c`, being the depth-`0` condition `Ext¹(R/m, M) ≠ 0`.

The proof is the elementary socle construction: given a socle element `x` of `M/zM`, i.e.
`x̃ ∈ M` with `x̃ ∉ zM` and `m·x̃ ⊆ zM`, we have `a·x̃ = z·w` for some `w` since `a ∈ m`, and `w`
is a socle element of `M/aM` — with `m·w ⊆ aM` by regularity of `z` and `w ∉ aM` by regularity
of `a`. -/
theorem mem_associatedPrimes_quotSMulTop_of_isSMulRegular
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (a z : R) (ha : a ∈ maximalIdeal R) (haReg : IsSMulRegular M a)
    (hzReg : IsSMulRegular M z)
    (hmass : maximalIdeal R ∈ associatedPrimes R (QuotSMulTop z M)) :
    maximalIdeal R ∈ associatedPrimes R (QuotSMulTop a M) := by
  set m := maximalIdeal R with hm
  rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff] at hmass
  obtain ⟨hp, y, hyeq⟩ := hmass
  obtain ⟨w, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  have hmem_iff : ∀ r : R, r ∈ m ↔ r • w ∈ z • (⊤ : Submodule R M) := by
    intro r
    rw [hyeq, Submodule.mem_colon_singleton]
    change r • (Submodule.Quotient.mk w : QuotSMulTop z M) = 0 ↔ _
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  have haw : a • w ∈ z • (⊤ : Submodule R M) := (hmem_iff a).mp ha
  rw [Submodule.mem_smul_pointwise_iff_exists] at haw
  obtain ⟨w', -, hw'⟩ := haw
  have hw'notmem : w' ∉ a • (⊤ : Submodule R M) := by
    intro hcon
    rw [Submodule.mem_smul_pointwise_iff_exists] at hcon
    obtain ⟨v, -, hv⟩ := hcon
    have hwzv : w = z • v := haReg (show a • w = a • (z • v) by rw [← hw', ← hv, smul_comm])
    have h0 : (Submodule.Quotient.mk w : QuotSMulTop z M) = 0 := by
      rw [Submodule.Quotient.mk_eq_zero, hwzv]
      exact Submodule.smul_mem_pointwise_smul _ _ _ trivial
    apply hp.ne_top
    rw [hyeq, eq_top_iff]
    intro r _
    rw [Submodule.mem_colon_singleton]
    change r • (Submodule.Quotient.mk w : QuotSMulTop z M) ∈ (⊥ : Submodule R (QuotSMulTop z M))
    rw [h0, smul_zero]
    exact Submodule.zero_mem _
  set y' : QuotSMulTop a M := Submodule.Quotient.mk w' with hy'
  have hy'_iff : ∀ r : R, (r • y' = 0) ↔ r • w' ∈ a • (⊤ : Submodule R M) := by
    intro r
    rw [hy', ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  have hkey : ∀ r ∈ m, r • w' ∈ a • (⊤ : Submodule R M) := by
    intro r hr
    have hrw : r • w ∈ z • (⊤ : Submodule R M) := (hmem_iff r).mp hr
    rw [Submodule.mem_smul_pointwise_iff_exists] at hrw
    obtain ⟨s, -, hs⟩ := hrw
    have : r • w' = a • s := hzReg (show z • (r • w') = z • (a • s) by
      rw [smul_comm z r w', hw', smul_comm r a w, ← hs, smul_comm a z s])
    rw [this]
    exact Submodule.smul_mem_pointwise_smul _ _ _ trivial
  have hy'ne : y' ≠ 0 := by
    rwa [hy', Ne, Submodule.Quotient.mk_eq_zero]
  rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff]
  refine ⟨hp, y', ?_⟩
  apply le_antisymm
  · exact fun r hr => Submodule.mem_colon_singleton.mpr
      ((Submodule.mem_bot _).mpr ((hy'_iff r).mpr (hkey r hr)))
  · intro r hr
    rw [Submodule.mem_colon_singleton] at hr
    have hr0 : r • y' = 0 := by
      have : r • y' ∈ (⊥ : Submodule R (QuotSMulTop a M)) := hr
      rwa [Submodule.mem_bot] at this
    by_contra hrm
    have hunit : IsUnit r := (IsLocalRing.notMem_maximalIdeal).mp hrm
    have hy'0 : y' = 0 := (hunit.isSMulRegular (QuotSMulTop a M)) (by simpa using hr0)
    exact hy'ne hy'0

/-- **Depth-0 base kernel (Bruns–Herzog 1.2.5 base).**  If `z ∈ m` is
`M`-regular and `m = maximalIdeal R` is an associated prime of `M/zM`
(i.e. `z` is a *maximal* `M`-regular sequence), then any `M`-regular sequence
`rs ⊆ m` has length `≤ 1`.  This is the depth-`0` case of Rees's theorem, proved from the
exchange equivalence `exchange_isSMulRegular_quotSMulTop`. -/
@[ega "0 16.4.2" "special case", ega "0 16.4.4" "special case"]
theorem rees_length_le_one_of_maximalIdeal_mem_quotSMulTop
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (z : R) (hzreg : IsSMulRegular M z)
    (hmass : maximalIdeal R ∈ associatedPrimes R (QuotSMulTop z M))
    (rs : List R) (hrsmem : ∀ r ∈ rs, r ∈ maximalIdeal R)
    (hrsreg : RingTheory.Sequence.IsRegular M rs) :
    rs.length ≤ 1 := by
  by_contra hlen
  push Not at hlen
  rcases rs with _ | ⟨a, _ | ⟨b, rs''⟩⟩
  · simp at hlen
  · simp at hlen
  · have hamem : a ∈ maximalIdeal R := hrsmem a (by simp)
    have haReg : IsSMulRegular M a :=
      ((RingTheory.Sequence.isWeaklyRegular_cons_iff M a (b :: rs'')).mp
        hrsreg.toIsWeaklyRegular).left
    have htailReg : RingTheory.Sequence.IsRegular (QuotSMulTop a M) (b :: rs'') :=
      ((RingTheory.Sequence.isRegular_cons_iff (M := M) a (b :: rs'')).mp hrsreg).right
    have hbmem : b ∈ maximalIdeal R := hrsmem b (by simp)
    have hbReg_quot : IsSMulRegular (QuotSMulTop a M) b :=
      ((RingTheory.Sequence.isWeaklyRegular_cons_iff (QuotSMulTop a M) b rs'').mp
        htailReg.toIsWeaklyRegular).left
    -- By the Core Lemma, `m ∈ Ass(M/aM)` (transferred from `m ∈ Ass(M/zM)`).
    have hmassa : maximalIdeal R ∈ associatedPrimes R (QuotSMulTop a M) :=
      mem_associatedPrimes_quotSMulTop_of_isSMulRegular R M a z hamem haReg hzreg hmass
    -- But `b ∈ m` is `(M/aM)`-regular, contradicting this.
    exact maximalIdeal_notMem_associatedPrimes_of_isSMulRegular R (QuotSMulTop a M) b hbmem
      hbReg_quot hmassa

/- **Rees depth-shift lemma.**  Over a Noetherian local ring `R`, if
`z ∈ m = maximalIdeal R` is an `M`-regular element (`M` finite) and `rs ⊆ m` is
an `M`-regular sequence of length `n`, then there is an `(M/zM)`-regular sequence
`vs ⊆ m` of length at least `n - 1`.

This is the existence/depth-decrement half of Rees's theorem.  Proof: induct on
`rs.length`.  Write `rs = r :: rs'`.
- If the head `r` is `(M/zM)`-regular: by the exchange equivalence `(⋆⋆)`
  `exchange_isSMulRegular_quotSMulTop` (with `a = r`, `b = z`), `z` is
  `(M/rM)`-regular; apply the induction hypothesis to `(M/rM, z, rs')` to get a
  `((M/rM)/z(M/rM))`-regular `ws` of length `≥ n-2`; transport along
  `(M/zM)/r(M/zM) ≅ M/(r,z)M ≅ (M/rM)/z(M/rM)` (the isomorphisms
  `Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner` and `…Outer`) and prepend `r`
  via `IsRegular.cons` to obtain `vs := r :: ws` of length
  `≥ n-1`.
- If the head is NOT `(M/zM)`-regular: pick (prime avoidance over the finite
  `Ass(M) ∪ Ass(M/rM) ∪ Ass(M/zM)`, when `m ∉ Ass(M/zM)`) a fresh `y ∈ m`
  regular on `M`, `M/rM` and `M/zM`; use `(⋆⋆)` to exchange and the induction
  hypothesis on the smaller `rs'` to build the sequence.  The remaining
  possibility `m ∈ Ass(M/zM)` forces `n ≤ 1` (else the induction hypothesis on
  `(M, z, rs')` would produce a nonempty `(M/zM)`-regular sequence, impossible
  when `m ∈ Ass(M/zM)`), and then the empty `vs` suffices. -/


open scoped Pointwise in
/-- Commutation isomorphism for double regular quotients:
`(M/zM)/r(M/zM) ≅ M/(r,z)M ≅ (M/rM)/z(M/rM)`, hence
`QuotSMulTop z (QuotSMulTop r M) ≃ₗ QuotSMulTop r (QuotSMulTop z M)`.
This is a pure module isomorphism, needing no regularity, built from the isomorphisms
`Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner` and `…Outer`. -/
def quotSMulTop_comm_linearEquiv
    (R : Type*) [CommRing R] (M : Type*) [AddCommGroup M] [Module R M] (r z : R) :
    (QuotSMulTop z (QuotSMulTop r M)) ≃ₗ[R] (QuotSMulTop r (QuotSMulTop z M)) := by
  have hz0 : Ideal.ofList [z] • (⊤ : Submodule R M) = z • (⊤ : Submodule R M) := by
    rw [Ideal.ofList]
    have : {x | x ∈ [z]} = ({z} : Set R) := by ext x; simp
    rw [this, Submodule.ideal_span_singleton_smul]
  have ezr : Ideal.ofList [z] • (⊤ : Submodule R (QuotSMulTop r M)) =
      z • (⊤ : Submodule R (QuotSMulTop r M)) := by
    rw [Ideal.ofList]
    have : {x | x ∈ [z]} = ({z} : Set R) := by ext x; simp
    rw [this, Submodule.ideal_span_singleton_smul]
  have eInner :=
    Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner (R := R) (M := M) r [z]
  have eOuter :=
    Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter (R := R) (M := M) r [z]
  have eLast : (QuotSMulTop r (M ⧸ Ideal.ofList [z] • (⊤ : Submodule R M))) ≃ₗ[R]
      (QuotSMulTop r (QuotSMulTop z M)) := by
    refine Submodule.Quotient.equiv (r • ⊤) (r • ⊤)
      (Submodule.quotEquivOfEq _ _ hz0) ?_
    rw [Submodule.map_pointwise_smul, Submodule.map_top, LinearEquiv.range]
  exact (Submodule.quotEquivOfEq _ _ ezr.symm).trans
    (eInner.symm.trans (eOuter.trans eLast))

open scoped Pointwise in
/-- The isomorphism `N ⧸ (∅)·N ≅ N` coming from the empty `Ideal.ofList`. -/
def quotOfListNilSMulTopEquiv
    (R : Type*) [CommRing R] (N : Type*) [AddCommGroup N] [Module R N] :
    (N ⧸ Ideal.ofList ([] : List R) • (⊤ : Submodule R N)) ≃ₗ[R] N := by
  have heq : Ideal.ofList ([] : List R) • (⊤ : Submodule R N) = ⊥ := by simp [Ideal.ofList]
  exact (Submodule.quotEquivOfEq _ _ heq).trans (Submodule.quotEquivOfEqBot _ rfl)

open scoped Pointwise in
/-- The isomorphism `N ⧸ [x]·N ≅ QuotSMulTop x N` identifying the quotient by a one-element
list with the quotient by a single scalar. -/
def quotOfListSingletonSMulTopEquiv
    (R : Type*) [CommRing R] (N : Type*) [AddCommGroup N] [Module R N] (x : R) :
    (N ⧸ Ideal.ofList [x] • (⊤ : Submodule R N)) ≃ₗ[R] QuotSMulTop x N := by
  have e := Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner (R := R) (M := N) x []
  exact e.trans (quotOfListNilSMulTopEquiv R (QuotSMulTop x N))

open scoped Pointwise in
/-- The isomorphism `(N/cN) ⧸ (x :: xs₁)·(N/cN) ≅ (N/cN̄) ⧸ xs₁·(N/cN̄)`, where `N̄ = N/xN`,
obtained by combining the `Inner` peeling isomorphism with the commutation isomorphism
`quotSMulTop_comm_linearEquiv`.  It is the transport used by the associated-prime transfer
in the front-move recursion. -/
def quotCSMulTopConsEquivCommQuot
    (R : Type*) [CommRing R] (N : Type*) [AddCommGroup N] [Module R N] (c x : R) (xs₁ : List R) :
    (QuotSMulTop c N ⧸ Ideal.ofList (x :: xs₁) • (⊤ : Submodule R (QuotSMulTop c N))) ≃ₗ[R]
      (QuotSMulTop c (QuotSMulTop x N) ⧸
        Ideal.ofList xs₁ • (⊤ : Submodule R (QuotSMulTop c (QuotSMulTop x N)))) := by
  have e1 :=
    Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner (R := R) (M := QuotSMulTop c N) x xs₁
  have ecomm := quotSMulTop_comm_linearEquiv R N c x
  have e2 : (QuotSMulTop x (QuotSMulTop c N) ⧸
        Ideal.ofList xs₁ • (⊤ : Submodule R (QuotSMulTop x (QuotSMulTop c N)))) ≃ₗ[R]
      (QuotSMulTop c (QuotSMulTop x N) ⧸
        Ideal.ofList xs₁ • (⊤ : Submodule R (QuotSMulTop c (QuotSMulTop x N)))) := by
    refine Submodule.Quotient.equiv _ _ ecomm ?_
    rw [Submodule.map_smul'']
    congr 1
    rw [Submodule.map_top, LinearEquiv.range]
  exact e1.trans e2

/-- **Front-move lemma**, the core of Bruns–Herzog, *Cohen-Macaulay Rings*, Thm. 1.2.5.
Over a Noetherian local ring `R`, let `N` be a finite nonzero module, `c ∈ m`
an `N`-regular element, and `xs ≠ []` an `N`-regular sequence in `m` such that
`c` is regular on every *proper* partial quotient of `xs`.  Then there
is an `(N/cN)`-regular sequence `xs₁ ⊆ m` of length `xs.length - 1` such that
`c :: xs₁` is `N`-regular and, whenever `m` is an associated prime of the full
quotient `N/xs·N`, it is also an associated prime of `(N/cN)/xs₁·(N/cN)`
(equivalently of `N/(c :: xs₁)·N`, via the peeling isomorphism).

The transfer of maximality, i.e. of the condition `m ∈ Ass`, is what
`rees_length_le_aux` needs.  It replaces the tempting but false bare-module
isomorphism `N/(c :: xs₁)·N ≅ N/xs·N`: for `R = k[[s,t]]`, `xs = [s² - t³]` a cusp and `c = t`,
the quotient `N/cN` is a discrete valuation ring, not isomorphic to the cusp `N/xs·N`.

The proof moves `c` to the front by iterated use of the exchange equivalence
`exchange_isSMulRegular_quotSMulTop` together with `quotSMulTop_comm_linearEquiv` and the
peeling isomorphisms, transferring the socle data through the symmetric double quotients
`(N/cN)/x ≅ (N/xN)/c`; the base step uses the socle lemma
`mem_associatedPrimes_quotSMulTop_of_isSMulRegular`. -/
theorem frontMove_isRegular_of_isSMulRegular_proper
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (N : Type*) [AddCommGroup N] [Module R N] [Module.Finite R N] [Nontrivial N]
    (c : R) (hcmem : c ∈ maximalIdeal R) (hcreg : IsSMulRegular N c)
    (xs : List R) (hxsne : xs ≠ []) (hxsmem : ∀ x ∈ xs, x ∈ maximalIdeal R)
    (hxsreg : RingTheory.Sequence.IsRegular N xs)
    (hcprop : ∀ j : ℕ, j < xs.length →
      IsSMulRegular (N ⧸ Ideal.ofList (xs.take j) • (⊤ : Submodule R N)) c) :
    ∃ xs₁ : List R, (∀ x ∈ xs₁, x ∈ maximalIdeal R) ∧
      xs₁.length = xs.length - 1 ∧
      RingTheory.Sequence.IsRegular (QuotSMulTop c N) xs₁ ∧
      RingTheory.Sequence.IsRegular N (c :: xs₁) ∧
      (maximalIdeal R ∈ associatedPrimes R (N ⧸ Ideal.ofList xs • (⊤ : Submodule R N)) →
        maximalIdeal R ∈ associatedPrimes R
          (QuotSMulTop c N ⧸ Ideal.ofList xs₁ • (⊤ : Submodule R (QuotSMulTop c N)))) := by
  -- Acyclic front-move via INDUCTION on `xs` (generalizing `N`, `c`).  Clauses 1–4 are
  -- the standard Bruns–Herzog front move (exchange/perm + peel/commutation isos); the
  -- Ass-transfer clause uses the socle lemma `mem_associatedPrimes_quotSMulTop_of_isSMulRegular`
  -- in the base step and the peel/commutation isos in the recursive step.
  have : IsNoetherian R N := isNoetherian_of_isNoetherianRing_of_finite R N
  induction xs generalizing N c with
  | nil => exact absurd rfl hxsne
  | cons x xs' ih =>
    -- `x` is the regular head of `xs = x :: xs'`.
    have hxmem : x ∈ maximalIdeal R := hxsmem x (List.mem_cons_self ..)
    obtain ⟨hxreg, hxs'reg⟩ :=
      (RingTheory.Sequence.isRegular_cons_iff (M := N) x xs').mp hxsreg
    have : Nontrivial (QuotSMulTop c N) :=
      nontrivial_quotSMulTop_of_mem_maximalIdeal (L := N) hcmem
    cases xs' with
    | nil =>
      -- Base case `xs = [x]`: take `xs₁ = []`.
      refine ⟨[], by simp, by simp, RingTheory.Sequence.IsRegular.nil R _,
        RingTheory.Sequence.IsRegular.cons hcreg (RingTheory.Sequence.IsRegular.nil R _), ?_⟩
      intro hmass
      -- Transport hypothesis `m ∈ Ass(N ⧸ [x]·N)` to `m ∈ Ass(QuotSMulTop x N)`.
      have hmassx : maximalIdeal R ∈ associatedPrimes R (QuotSMulTop x N) := by
        rw [← LinearEquiv.AssociatedPrimes.eq (quotOfListSingletonSMulTopEquiv R N x)]
        exact hmass
      -- Socle lemma: `m ∈ Ass(QuotSMulTop c N)`.
      have hmassc : maximalIdeal R ∈ associatedPrimes R (QuotSMulTop c N) :=
        mem_associatedPrimes_quotSMulTop_of_isSMulRegular R N c x hcmem hcreg hxreg hmassx
      -- Transport goal `m ∈ Ass(QuotSMulTop c N ⧸ []·)` back to `m ∈ Ass(QuotSMulTop c N)`.
      rw [LinearEquiv.AssociatedPrimes.eq (quotOfListNilSMulTopEquiv R (QuotSMulTop c N))]
      exact hmassc
    | cons x' xs'' =>
      -- Recursive case: `xs' = x' :: xs''` is nonempty.  Set `N̄ := QuotSMulTop x N`.
      set Nbar := QuotSMulTop x N with hNbar
      have : Nontrivial Nbar := nontrivial_quotSMulTop_of_mem_maximalIdeal (L := N) hxmem
      have : IsNoetherian R Nbar := isNoetherian_of_isNoetherianRing_of_finite R Nbar
      -- `xs'` is `Nbar`-regular (tail of the regular `xs`).
      have hxs'mem : ∀ w ∈ (x' :: xs''), w ∈ maximalIdeal R :=
        fun w hw => hxsmem w (List.mem_cons_of_mem _ hw)
      -- `c` is `Nbar`-regular: `hcprop 1` ≅ `IsSMulRegular (QuotSMulTop x N) c`.
      have hcregNbar : IsSMulRegular Nbar c := by
        have h1 := hcprop 1 (by simp)
        have he : ((x :: x' :: xs'').take 1) = [x] := rfl
        rw [he] at h1
        exact (LinearEquiv.isSMulRegular_congr (quotOfListSingletonSMulTopEquiv R N x) c).mp h1
      -- `c` is regular on every proper partial quotient of `xs'` over `Nbar`.
      have hcpropNbar : ∀ j : ℕ, j < (x' :: xs'').length →
          IsSMulRegular (Nbar ⧸ Ideal.ofList ((x' :: xs'').take j) • (⊤ : Submodule R Nbar)) c := by
        intro j hj
        have h := hcprop (j + 1) (by simpa using Nat.succ_lt_succ hj)
        have he : ((x :: x' :: xs'').take (j + 1)) = x :: (x' :: xs'').take j := rfl
        rw [he] at h
        -- `N ⧸ (x :: tail)·N ≅ Nbar ⧸ tail·Nbar` via the Inner peel iso.
        have eiso := Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner (R := R) (M := N) x
          ((x' :: xs'').take j)
        exact (LinearEquiv.isSMulRegular_congr eiso c).mp h
      -- Apply the induction hypothesis to `(Nbar, c, xs')`.
      obtain ⟨xs₁', hxs1'mem, hxs1'len, hxs1'reg, hxs1'cons, hxs1'ass⟩ :=
        ih Nbar c hcmem hcregNbar (by simp) hxs'mem hxs'reg hcpropNbar inferInstance
      -- We take `xs₁ := x :: xs₁'`.
      refine ⟨x :: xs₁', ?_, ?_, ?_, ?_, ?_⟩
      · -- entries ∈ m
        intro v hv
        rcases List.mem_cons.mp hv with rfl | hv
        · exact hxmem
        · exact hxs1'mem v hv
      · -- length: `(x :: xs₁').length = (x :: x' :: xs'').length - 1`
        simp only [List.length_cons] at hxs1'len ⊢
        omega
      · -- `IsRegular (QuotSMulTop c N) (x :: xs₁')`: from `IsRegular N (c :: x :: xs₁')`.
        -- First build `IsRegular N (c :: x :: xs₁')` (proved below), then take the tail.
        have hNcons : RingTheory.Sequence.IsRegular N (c :: x :: xs₁') := by
          -- `IsRegular Nbar (c :: xs₁')` from IH (clause 4); prepend `x` regular on `N`.
          have hxcons : RingTheory.Sequence.IsRegular N (x :: c :: xs₁') :=
            RingTheory.Sequence.IsRegular.cons hxreg hxs1'cons
          exact IsLocalRing.isRegular_of_perm hxcons (List.Perm.swap c x _)
        exact ((RingTheory.Sequence.isRegular_cons_iff (M := N) c (x :: xs₁')).mp hNcons).right
      · -- `IsRegular N (c :: x :: xs₁')`
        have hxcons : RingTheory.Sequence.IsRegular N (x :: c :: xs₁') :=
          RingTheory.Sequence.IsRegular.cons hxreg hxs1'cons
        exact IsLocalRing.isRegular_of_perm hxcons (List.Perm.swap c x _)
      · -- Ass-transfer.
        intro hmass
        -- Transport `m ∈ Ass(N ⧸ (x::xs')·N)` to `m ∈ Ass(Nbar ⧸ xs'·Nbar)` via Inner.
        have hmassNbar : maximalIdeal R ∈
            associatedPrimes R (Nbar ⧸ Ideal.ofList (x' :: xs'') • (⊤ : Submodule R Nbar)) := by
          rw [← LinearEquiv.AssociatedPrimes.eq
            (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner (R := R) (M := N) x (x' :: xs''))]
          exact hmass
        -- IH clause 5: `m ∈ Ass(QuotSMulTop c Nbar ⧸ xs₁'·)`.
        have hmassQ : maximalIdeal R ∈ associatedPrimes R
            (QuotSMulTop c Nbar ⧸ Ideal.ofList xs₁' • (⊤ : Submodule R (QuotSMulTop c Nbar))) :=
          hxs1'ass hmassNbar
        -- Transport goal `m ∈ Ass(QuotSMulTop c N ⧸ (x::xs₁')·)` to the same via the
        -- Inner+commutation iso `quotCSMulTopConsEquivCommQuot`.
        rw [LinearEquiv.AssociatedPrimes.eq (quotCSMulTopConsEquivCommQuot R N c x xs₁')]
        exact hmassQ

/-- A regular element of the maximal ideal forces `m ∉ Ass M`. -/
@[sga "2 III 2.1" "(iv) ⇒ (v)"]
theorem notMem_associatedPrimes_of_isSMulRegular
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (c : R) (hcmem : c ∈ maximalIdeal R) (hcreg : IsSMulRegular M c) :
    maximalIdeal R ∉ associatedPrimes R M :=
  maximalIdeal_notMem_associatedPrimes_of_isSMulRegular R M c hcmem hcreg

open scoped Pointwise in
/-- For an `M`-regular sequence `xs ⊆ m`, every *proper* partial quotient `M/(xs.take j)·M`
with `j < xs.length` has the regular element `xs[j] ∈ m`, so `m` is not one of its associated
primes. -/
@[ega "0 16.4.2" "sufficiency"]
theorem notMem_associatedPrimes_take_of_isRegular
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (xs : List R) (hxsmem : ∀ x ∈ xs, x ∈ maximalIdeal R)
    (hxsreg : RingTheory.Sequence.IsRegular M xs)
    (j : ℕ) (hj : j < xs.length) :
    maximalIdeal R ∉
      associatedPrimes R (M ⧸ Ideal.ofList (xs.take j) • (⊤ : Submodule R M)) := by
  have hweak := hxsreg.toIsWeaklyRegular
  rw [RingTheory.Sequence.isWeaklyRegular_iff_Fin] at hweak
  have hreg := hweak ⟨j, hj⟩
  have hmem : xs[j] ∈ maximalIdeal R := hxsmem xs[j] (List.getElem_mem hj)
  exact notMem_associatedPrimes_of_isSMulRegular R _ xs[j] hmem hreg

/-- Prime avoidance: a finite family of primes, none equal to `m`, is avoided by
some element of `m`. -/
@[sga "3 V 4.1" "local ring, special case"]
theorem exists_mem_maximalIdeal_notMem_biUnion
    (R : Type*) [CommRing R] [IsLocalRing R]
    (S : Set (Ideal R)) (hSfin : S.Finite)
    (hprime : ∀ p ∈ S, p.IsPrime) (hne : ∀ p ∈ S, p ≠ maximalIdeal R) :
    ∃ c ∈ maximalIdeal R, ∀ p ∈ S, c ∉ p :=
  exists_mem_maximalIdeal_notMem_of_finite_primes R S hSfin hprime hne

/-- An element avoiding all associated primes of `M` is `M`-regular. -/
@[ega "IV 3.1.9" "sufficiency direction", sga "2 III 2.1" "(ii) ⇒ (iv)", sga "3 V 7.2" "partial"]
theorem isSMulRegular_of_forall_notMem_associatedPrimes
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (c : R) (h : ∀ p ∈ associatedPrimes R M, c ∉ p) :
    IsSMulRegular M c :=
  isSMulRegular_of_forall_notMem_associatedPrimes_aux R M c h

open scoped Pointwise in
/-- **A common regular element on all proper partial quotients of two sequences.**
By prime avoidance over the finite union of the finite sets of associated primes of all proper
partial quotients of `rs` and of `zs`, none of which contains `m`, there is a single `c ∈ m`
that is regular on every proper partial quotient of `rs` and of `zs`.  This supplies the
hypothesis that both invocations of the front-move lemma require. -/
theorem exists_isSMulRegular_proper_quotients_two
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (rs zs : List R)
    (hrsmem : ∀ r ∈ rs, r ∈ maximalIdeal R) (hrsreg : RingTheory.Sequence.IsRegular M rs)
    (hzsmem : ∀ z ∈ zs, z ∈ maximalIdeal R) (hzsreg : RingTheory.Sequence.IsRegular M zs) :
    ∃ c ∈ maximalIdeal R,
      (∀ j : ℕ, j < rs.length →
        IsSMulRegular (M ⧸ Ideal.ofList (rs.take j) • (⊤ : Submodule R M)) c) ∧
      (∀ j : ℕ, j < zs.length →
        IsSMulRegular (M ⧸ Ideal.ofList (zs.take j) • (⊤ : Submodule R M)) c) := by
  classical
  set Srs : Set (Ideal R) :=
    ⋃ j ∈ Finset.range rs.length,
      associatedPrimes R (M ⧸ Ideal.ofList (rs.take j) • (⊤ : Submodule R M)) with hSrs
  set Szs : Set (Ideal R) :=
    ⋃ j ∈ Finset.range zs.length,
      associatedPrimes R (M ⧸ Ideal.ofList (zs.take j) • (⊤ : Submodule R M)) with hSzs
  set S : Set (Ideal R) := Srs ∪ Szs with hS
  have hSrsfin : Srs.Finite := by
    rw [hSrs]
    exact Set.Finite.biUnion (Finset.range rs.length).finite_toSet
      (fun j _ => associatedPrimes.finite R _)
  have hSzsfin : Szs.Finite := by
    rw [hSzs]
    exact Set.Finite.biUnion (Finset.range zs.length).finite_toSet
      (fun j _ => associatedPrimes.finite R _)
  have hSfin : S.Finite := hSrsfin.union hSzsfin
  have hprime : ∀ p ∈ S, p.IsPrime := by
    intro p hp
    rcases hp with hp | hp
    · rw [hSrs, Set.mem_iUnion₂] at hp
      obtain ⟨j, _, hp⟩ := hp; exact hp.isPrime
    · rw [hSzs, Set.mem_iUnion₂] at hp
      obtain ⟨j, _, hp⟩ := hp; exact hp.isPrime
  have hne : ∀ p ∈ S, p ≠ maximalIdeal R := by
    intro p hp
    rcases hp with hp | hp
    · rw [hSrs, Set.mem_iUnion₂] at hp
      obtain ⟨j, hjr, hp⟩ := hp
      rw [Finset.mem_range] at hjr
      rintro rfl
      exact notMem_associatedPrimes_take_of_isRegular R M rs hrsmem hrsreg j hjr hp
    · rw [hSzs, Set.mem_iUnion₂] at hp
      obtain ⟨j, hjz, hp⟩ := hp
      rw [Finset.mem_range] at hjz
      rintro rfl
      exact notMem_associatedPrimes_take_of_isRegular R M zs hzsmem hzsreg j hjz hp
  obtain ⟨c, hcmem, hcavoid⟩ := exists_mem_maximalIdeal_notMem_biUnion R S hSfin hprime hne
  refine ⟨c, hcmem, ?_, ?_⟩
  · intro j hj
    apply isSMulRegular_of_forall_notMem_associatedPrimes
    intro p hp hcp
    refine hcavoid p ?_ hcp
    rw [hS, hSrs]
    exact Set.mem_union_left _ (Set.mem_iUnion₂.mpr ⟨j, Finset.mem_range.mpr hj, hp⟩)
  · intro j hj
    apply isSMulRegular_of_forall_notMem_associatedPrimes
    intro p hp hcp
    refine hcavoid p ?_ hcp
    rw [hS, hSzs]
    exact Set.mem_union_right _ (Set.mem_iUnion₂.mpr ⟨j, Finset.mem_range.mpr hj, hp⟩)

open scoped Pointwise in
/-- **The Rees length inequality in generalized form**, by strong induction on `zs.length`.
It is generalized over `R` and `M` so that the inductive step may instantiate the statement at
`QuotSMulTop c M`.  The argument is the Bruns–Herzog front-move rearrangement. -/
@[ega "0 16.4.4" "more general", ega "0 16.4.6" "(i)"]
theorem rees_length_le_aux :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]
      (rs zs : List R),
      (∀ r ∈ rs, r ∈ maximalIdeal R) → RingTheory.Sequence.IsRegular M rs →
      (∀ z ∈ zs, z ∈ maximalIdeal R) → RingTheory.Sequence.IsRegular M zs →
      maximalIdeal R ∈ associatedPrimes R (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) →
      zs.length = n →
      rs.length ≤ zs.length := by
  intro n
  induction n with
  | zero =>
    intro R _ _ _ M _ _ _ rs zs hrsmem hrsreg hzsmem hzsreg hmass hn
    have hzs : zs = [] := List.length_eq_zero_iff.mp hn
    subst hzs
    have hmassM : maximalIdeal R ∈ associatedPrimes R M := by
      rwa [← LinearEquiv.AssociatedPrimes.eq (quotOfListNilSMulTopEquiv R M)]
    rcases rs with _ | ⟨r, rs'⟩
    · simp
    · exfalso
      have hrmem : r ∈ maximalIdeal R := hrsmem r (by simp)
      have hrreg : IsSMulRegular M r :=
        ((RingTheory.Sequence.isWeaklyRegular_cons_iff M r rs').mp
          hrsreg.toIsWeaklyRegular).left
      exact notMem_associatedPrimes_of_isSMulRegular R M r hrmem hrreg hmassM
  | succ n ih =>
    intro R _ _ _ M _ _ _ rs zs hrsmem hrsreg hzsmem hzsreg hmass hn
    have hzlen : 0 < zs.length := by omega
    have hMnt : Nontrivial M := by
      have hQnt : Nontrivial (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) := by
        rw [AssociatedPrimes.mem_iff] at hmass
        obtain ⟨hp, x, hx⟩ := hmass
        refine ⟨x, 0, ?_⟩
        intro h; apply hp.ne_top; rw [hx, h]; simp
      by_contra hM
      rw [not_nontrivial_iff_subsingleton] at hM
      have := hM
      exact (not_subsingleton _)
        (inferInstance : Subsingleton (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)))
    obtain ⟨c, hcmem, hcrs, hczs⟩ :=
      exists_isSMulRegular_proper_quotients_two R M rs zs hrsmem hrsreg hzsmem hzsreg
    have hc0 : IsSMulRegular (M ⧸ Ideal.ofList (zs.take 0) • (⊤ : Submodule R M)) c :=
      hczs 0 hzlen
    have hcreg : IsSMulRegular M c :=
      (LinearEquiv.isSMulRegular_congr (quotOfListNilSMulTopEquiv R M) c).mp hc0
    obtain ⟨zs₁, hzs1mem, hzs1len, hzs1reg, hzcons, hAsstransfer⟩ :=
      frontMove_isRegular_of_isSMulRegular_proper R M c hcmem hcreg zs
        (by rintro rfl; simp at hzlen) hzsmem hzsreg hczs
    have hmass1 : maximalIdeal R ∈
        associatedPrimes R
          (QuotSMulTop c M ⧸ Ideal.ofList zs₁ • (⊤ : Submodule R (QuotSMulTop c M))) :=
      hAsstransfer hmass
    rcases rs with _ | ⟨r, rs'⟩
    · simp
    · obtain ⟨rs₁, hrs1mem, hrs1len, hrs1reg, hrcons, _⟩ :=
        frontMove_isRegular_of_isSMulRegular_proper R M c hcmem hcreg (r :: rs')
          (List.cons_ne_nil r rs') hrsmem hrsreg hcrs
      have : Module.Finite R (QuotSMulTop c M) := inferInstance
      have hzs1n : zs₁.length = n := by omega
      have hkey : rs₁.length ≤ zs₁.length :=
        ih R (QuotSMulTop c M) rs₁ zs₁ hrs1mem hrs1reg hzs1mem hzs1reg hmass1 hzs1n
      simp only [List.length_cons] at *
      omega

/-- **Rees length inequality (LC).**  For `M`-regular sequences `rs, zs ⊆ m`
over a Noetherian local ring, if the maximal ideal is an associated prime of the
partial quotient `M ⧸ (zs)·M`, then `rs.length ≤ zs.length` (the inequality
direction of Rees's theorem).

Proof — the Bruns–Herzog 1.2.5 **front-move** rearrangement, by **strong induction on
`zs.length`**.
Base `zs = []`: `m ∈ Ass M`, but a nonempty `rs` has an `M`-regular head ⇒
`m ∉ Ass M`, contradiction ⇒ `rs = []`.  Step `n = zs.length ≥ 1`:
1. choose a COMMON `c ∈ m` regular on `M` and on ALL PROPER partial quotients of
   BOTH `rs` and `zs` (each proper quotient has a further regular element ⇒
   `m ∉ Ass`; prime avoidance over the finite union of their finite `Ass`-sets
   yields `c`; the FULL quotient `M/zs·M` where `m ∈ Ass` is EXCLUDED);
2. **Front-Move Lemma** on `zs`: replace by length-preserving `c :: zs₁`
   (`zs₁` `(M/cM)`-regular, length `n-1`); transport `m ∈ Ass` along the iso
   `M/(c::zs₁)M ≅ M/zs·M` + the peel iso ⇒ `m ∈ Ass((M/cM)/zs₁·(M/cM))`;
3. **Front-Move Lemma** on `rs`: `c :: rs₁` (length-preserving, `rs₁` `(M/cM)`-regular);
4. the induction hypothesis on the shorter `zs₁` over the module `M/cM` gives
   `rs₁.length ≤ zs₁.length`, i.e. `rs.length - 1 ≤ n - 1`, so `rs.length ≤ zs.length`.
The one substantive input is `frontMove_isRegular_of_isSMulRegular_proper`. -/
@[ega "0 16.4.4" "more general", sga "2 III 2.6" "Local case"]
theorem rees_length_le_of_maximalIdeal_mem_associatedPrimes_quotient
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (rs zs : List R)
    (hrsmem : ∀ r ∈ rs, r ∈ maximalIdeal R) (hrsreg : RingTheory.Sequence.IsRegular M rs)
    (hzsmem : ∀ z ∈ zs, z ∈ maximalIdeal R) (hzsreg : RingTheory.Sequence.IsRegular M zs)
    (hmass : maximalIdeal R ∈
      associatedPrimes R (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M))) :
    rs.length ≤ zs.length :=
  rees_length_le_aux zs.length R M rs zs hrsmem hrsreg hzsmem hzsreg hmass rfl

/- **Maximal Cohen-Macaulayness descends to the quotient.**  This is decomposed
into the depth-positivity fact `notMem_associatedPrimes_quotient_of_mcm` and the constructive
extension `exists_mcm_regular_seq_cons`, which together let `mcm_of_quotient` produce the
`(M/xM)`-regular sequence over `R/xR` of the correct length `d - 1`. -/

/-- **The Rees exchange inequality.** Over a Noetherian local ring
`R`, let `rs` and `zs` be two `M`-regular sequences with all entries in
`m = maximalIdeal R`, and suppose `zs.length < rs.length`.  Then there is an
element `t ∈ m` that is regular on `N := M / (zs)·M` (equivalently `zs ++ [t]` is
again `M`-regular).

This is the inequality direction of **Rees's theorem** (any two maximal
`M`-regular sequences in `m` have the same length; a sequence is maximal iff `m`
is an associated prime of the quotient).  Contrapositively: if `zs` is shorter
than the `M`-regular sequence `rs`, then `zs` is *not* maximal, so the maximal
ideal is avoidable by some `N`-regular element.

The statement involves only regular sequences, `IsSMulRegular`, `associatedPrimes` and prime
avoidance, no `depth` or Cohen–Macaulay machinery.  Reference: Bruns–Herzog,
*Cohen–Macaulay Rings*, Thm. 1.2.5, the classical Rees regular-sequence exchange.

Proof: by contradiction.  If no `t ∈ m` is `N`-regular then prime avoidance over the finite
`Ass N`, via `biUnion_associatedPrimes_eq_compl_regular`, gives `m ∈ Ass(N)`, and the Rees
length inequality `rees_length_le_of_maximalIdeal_mem_associatedPrimes_quotient` then yields
`rs.length ≤ zs.length`, contradicting `zs.length < rs.length`. -/
theorem exists_smulRegular_of_lt_length_isRegular
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (rs zs : List R)
    (hrsmem : ∀ r ∈ rs, r ∈ maximalIdeal R) (hrsreg : RingTheory.Sequence.IsRegular M rs)
    (hzsmem : ∀ z ∈ zs, z ∈ maximalIdeal R) (hzsreg : RingTheory.Sequence.IsRegular M zs)
    (hlt : zs.length < rs.length) :
    ∃ t ∈ maximalIdeal R,
      IsSMulRegular (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) t := by
  -- Strategy: by contradiction.  If no `t ∈ m` is `N`-regular, prime avoidance over
  -- the finite `Ass N` (via `biUnion_associatedPrimes_eq_compl_regular`) gives
  -- `m ∈ Ass N`; then the Rees length inequality
  -- `rees_length_le_of_maximalIdeal_mem_associatedPrimes_quotient` yields
  -- `rs.length ≤ zs.length`, contradicting `hlt`.
  set m := maximalIdeal R with hm
  set N := M ⧸ Ideal.ofList zs • (⊤ : Submodule R M) with hN
  -- `N` is nontrivial because `(zs)·M ≠ M` for an `M`-regular `zs`.
  have : Nontrivial N := by
    rw [hN]
    have h : Ideal.ofList zs • (⊤ : Submodule R M) ≠ ⊤ := fun hc => hzsreg.top_ne_smul hc.symm
    exact (Submodule.Quotient.nontrivial_iff).mpr h
  by_contra h
  push Not at h
  -- `h : ∀ t ∈ m, ¬ IsSMulRegular N t`, so `m` is an associated prime of `N`.
  have hmass := maximalIdeal_mem_associatedPrimes_of_forall_not_isSMulRegular R N h
  -- The Rees length inequality contradicts `zs.length < rs.length`.
  have hlen :=
    rees_length_le_of_maximalIdeal_mem_associatedPrimes_quotient R M rs zs
      hrsmem hrsreg hzsmem hzsreg hmass
  omega

/-- The support dimension of the quotient of `M` by a regular sequence is nonnegative. -/
private theorem zero_le_supportDim_quotient_of_isRegular
    (R : Type*) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (ws : List R) (hws : RingTheory.Sequence.IsRegular M ws) :
    (0 : WithBot ℕ∞) ≤ Module.supportDim R (M ⧸ Ideal.ofList ws • (⊤ : Submodule R M)) := by
  have hne : Module.supportDim R (M ⧸ Ideal.ofList ws • (⊤ : Submodule R M)) ≠ ⊥ := by
    rw [Module.supportDim_ne_bot_iff_nontrivial]
    exact (Submodule.Quotient.nontrivial_iff).mpr fun hc => hws.top_ne_smul hc.symm
  cases hsd : Module.supportDim R (M ⧸ Ideal.ofList ws • (⊤ : Submodule R M)) with
  | bot => exact absurd hsd hne
  | coe y => exact_mod_cast bot_le

/-- A maximal Cohen-Macaulay module has support dimension `dim R`. -/
private theorem supportDim_eq_ringKrullDim_of_isMaxCM
    (R : Type*) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] (hM : IsMaxCM R M) :
    Module.supportDim R M = ringKrullDim R := by
  obtain ⟨rs, -, hrsreg, hrslen⟩ := hM
  have hadd := Module.supportDim_add_length_eq_supportDim_of_isRegular (R := R) (M := M) rs hrsreg
  rw [hrslen] at hadd
  exact le_antisymm (Module.supportDim_le_ringKrullDim R M)
    ((le_add_of_nonneg_left (zero_le_supportDim_quotient_of_isRegular R M rs hrsreg)).trans_eq hadd)

/-- **Depth positivity for a Cohen-Macaulay quotient.** Let `M` be a nonzero finite maximal
Cohen-Macaulay module over the regular local ring `R` and let `zs` be an `M`-regular sequence
whose quotient `N := M / (zs)·M` has *positive* support dimension, `1 ≤ supportDim R N`.  Then
`m ∉ Ass(N)`.

This is the Cohen-Macaulay-theoretic content of the descent: for the Cohen-Macaulay module `N`,
a quotient of the maximal Cohen-Macaulay module `M` by the `M`-regular sequence `zs`, one has
`depth_m N = supportDim N`, so `supportDim N ≥ 1` forces `depth_m N ≥ 1`, i.e. some element of
`m` is `N`-regular; since the `N`-regular elements are the complement of `⋃ Ass(N)`, by
`biUnion_associatedPrimes_eq_compl_regular`, the maximal ideal `m` cannot be an associated prime.

Note that the implication `supportDim N ≥ 1 ⇒ m ∉ Ass N` is *false* for a general finite module,
because of embedded primes; it holds here only via the Cohen-Macaulay structure.  The proof below
routes around the missing depth–dimension theory by converting positive support dimension into a
strict length inequality and appealing to the Rees exchange inequality
`exists_smulRegular_of_lt_length_isRegular`.  Reference: Bruns–Herzog, *Cohen–Macaulay Rings*,
Thm. 1.2.5 (`depth ≤ dim`, with equality in the Cohen-Macaulay case) and Thm. 2.1.2 /
Cor. 2.1.3–2.1.4 (Cohen-Macaulay unmixedness). -/
theorem notMem_associatedPrimes_of_supportDim_pos_of_mcm
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (hM : IsMaxCM R M)
    (zs : List R) (hzmem : ∀ z ∈ zs, z ∈ maximalIdeal R)
    (hzreg : RingTheory.Sequence.IsRegular M zs)
    (hpos : 1 ≤ Module.supportDim R (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M))) :
    maximalIdeal R ∉ associatedPrimes R (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) := by
  -- Reduced to the Rees-exchange inequality `exists_smulRegular_of_lt_length_isRegular`
  -- via a bridge deriving `zs.length < rs.length` from `supportDim N ≥ 1`
  -- (forward additivity), then exchange supplies an `N`-regular `t ∈ m`, and prime
  -- avoidance (`biUnion_associatedPrimes_eq_compl_regular`) gives `m ∉ Ass N`.
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have : IsLocalRing R := inferInstance
  set m := maximalIdeal R with hm
  set N := M ⧸ Ideal.ofList zs • (⊤ : Submodule R M) with hN
  have hMdim := supportDim_eq_ringKrullDim_of_isMaxCM R M hM
  -- Unpack the MCM witness `rs` (`M`-regular, in `m`, length `= dim R`).
  obtain ⟨rs, hrsmem, hrsreg, hrslen⟩ := hM
  -- `supportDim N + zs.length = dim R` and `supportDim N ≥ 1` give `zs.length < dim R`.
  have haddz :=
    Module.supportDim_add_length_eq_supportDim_of_isRegular (R := R) (M := M) zs hzreg
  rw [hMdim] at haddz
  -- Turn the `WithBot ℕ∞` data into a strict length inequality `zs.length < rs.length`.
  have hltlen : zs.length < rs.length := by
    -- From `supportDim N + zs.length = dim R = rs.length` and `1 ≤ supportDim N`:
    -- `(rs.length : WithBot ℕ∞) = supportDim N + zs.length ≥ 1 + zs.length > zs.length`.
    have hge : (1 : WithBot ℕ∞) + (zs.length : WithBot ℕ∞) ≤ ringKrullDim R := by
      calc (1 : WithBot ℕ∞) + (zs.length : WithBot ℕ∞)
          ≤ Module.supportDim R N + (zs.length : WithBot ℕ∞) := by gcongr
        _ = ringKrullDim R := haddz
    rw [← hrslen] at hge
    -- `1 + ↑zs.length ≤ ↑rs.length` in `WithBot ℕ∞`, hence `zs.length < rs.length` in ℕ.
    have : ((zs.length + 1 : ℕ) : WithBot ℕ∞) ≤ ((rs.length : ℕ) : WithBot ℕ∞) := by
      push_cast
      rw [add_comm] at hge
      exact hge
    have hnat : zs.length + 1 ≤ rs.length := by exact_mod_cast this
    omega
  -- Rees exchange: there is an `N`-regular element `t ∈ m`.
  obtain ⟨t, htmem, htreg⟩ :=
    exists_smulRegular_of_lt_length_isRegular R M rs zs hrsmem hrsreg hzmem hzreg hltlen
  -- Wiring: an `N`-regular `t ∈ m` cannot lie in `⋃ Ass N`, so `m ∉ Ass N`.
  exact maximalIdeal_notMem_associatedPrimes_of_isSMulRegular R N t htmem htreg

/-- **Depth positivity.** Let `M` be a
nonzero finite MCM module over the regular (hence Cohen–Macaulay) local ring `R`,
and let `zs` be an `M`-regular sequence contained in `m = maximalIdeal R` whose
length is *strictly less* than `dim R`.  Then the maximal ideal is **not** an
associated prime of the partial quotient `N := M / (zs)·M`.

This is the genuine Cohen–Macaulay-theoretic heart of the depth-descent step
(Bruns–Herzog, *Cohen–Macaulay Rings*, Thm. 2.1.2 / Cor. 2.1.3–2.1.4; Stacks
unmixedness for CM modules).  `N` is a maximal Cohen–Macaulay module over the
regular local ring `R/(zs)`, of support dimension `dim R - zs.length ≥ 1`; CM
modules are unmixed, so every associated prime `p` of `N` has
`dim(R/p) = supportDim N ≥ 1`, hence `p ⊊ m` and `m ∉ Ass(N)`.

Equivalent operational consequence (used below): since the set of `N`-regular
elements is the complement of `⋃ Ass(N)` (`biUnion_associatedPrimes_eq_compl_regular`)
and `Ass(N)` is finite, prime avoidance over `Ass(N)` then produces an
`N`-regular element of `m`, i.e. `depth N ≥ 1`.

Additivity of the support dimension (`Module.supportDim_add_length_eq_supportDim_of_isRegular`,
`Module.supportDim_quotSMulTop_succ_eq_supportDim`) together with the bound
`Module.supportDim_le_ringKrullDim` supply `supportDim N = dim R - zs.length ≥ 1`; the remaining
implication `supportDim N ≥ 1 ⇒ m ∉ Ass N` for these Cohen-Macaulay quotients is
`notMem_associatedPrimes_of_supportDim_pos_of_mcm`. -/
theorem notMem_associatedPrimes_quotient_of_mcm
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (hM : IsMaxCM R M)
    (zs : List R) (hzmem : ∀ z ∈ zs, z ∈ maximalIdeal R)
    (hzreg : RingTheory.Sequence.IsRegular M zs)
    (hlt : (zs.length : WithBot ℕ∞) < ringKrullDim R) :
    maximalIdeal R ∉ associatedPrimes R (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have : IsLocalRing R := inferInstance
  -- ========================================================================
  -- PART 1: `1 ≤ supportDim R N` where `N := M / (zs)·M`.
  --   `supportDim N = supportDim M - zs.length = dim R - zs.length ≥ 1`,
  --   the last `≥ 1` from the *strict* hypothesis `hlt : zs.length < dim R`.
  -- ========================================================================
  -- Generic `WithBot ℕ∞` arithmetic: `a + n = d`, `n < d`, `0 ≤ a` ⟹ `1 ≤ a`.
  have arith : ∀ (a n d : WithBot ℕ∞), a + n = d → n < d → 0 ≤ a → 1 ≤ a := by
    intro a n d hadd hlt' ha
    rcases lt_or_ge a 1 with hc | hc
    · exfalso
      have ha0 : a = 0 := by
        have hle0 : a ≤ 0 := by
          cases a with
          | bot => simp at ha
          | coe x => cases x with
            | top => simp at hc
            | coe k => norm_cast at hc ⊢; omega
        exact le_antisymm hle0 ha
      rw [ha0, zero_add] at hadd
      rw [hadd] at hlt'
      exact lt_irrefl _ hlt'
    · exact hc
  -- `M` is MCM, so `supportDim M = dim R`.
  have hMdim := supportDim_eq_ringKrullDim_of_isMaxCM R M hM
  -- `supportDim N + zs.length = supportDim M = dim R`, so `1 ≤ supportDim N`.
  have haddz :=
    Module.supportDim_add_length_eq_supportDim_of_isRegular (R := R) (M := M) zs hzreg
  rw [hMdim] at haddz
  have hsuppdim :
      1 ≤ Module.supportDim R (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) :=
    arith _ _ _ haddz hlt (zero_le_supportDim_quotient_of_isRegular R M zs hzreg)
  -- ========================================================================
  -- PART 2 (Cohen–Macaulay bridge — `1 ≤ supportDim N ⟹ m ∉ Ass N`).
  -- Delegated to the analytic kernel `notMem_associatedPrimes_of_supportDim_pos_of_mcm`
  -- (the CM depth–dimension equality / unmixedness fact; see its docstring).
  -- ========================================================================
  exact notMem_associatedPrimes_of_supportDim_pos_of_mcm R M hM zs hzmem hzreg hsuppdim

/-- Nakayama: over a local ring, an ideal `I ≤ m` cannot satisfy `I • ⊤ = ⊤` on a
nonzero finite module. -/
@[ega "0 1.7.5" "Nakayama step: mM ≠ M",
  ega "0 7.1.13" "local ring, special case",
  ega "IV 2.5.5.4" "more general"]
theorem ofList_smul_top_ne_top_of_le_maximalIdeal
    (R : Type*) [CommRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    I • (⊤ : Submodule R M) ≠ ⊤ := by
  intro h
  have hsub : I • (⊤ : Submodule R M) ≤ maximalIdeal R • ⊤ := Submodule.smul_mono hI le_rfl
  have hmtop : maximalIdeal R • (⊤ : Submodule R M) = ⊤ :=
    le_antisymm le_top (le_trans (le_of_eq h.symm) hsub)
  have hfg : (⊤ : Submodule R M).FG := Module.finite_def.mp inferInstance
  have hjac : maximalIdeal R ≤ Ideal.jacobson ⊥ := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  have hNN : (⊤ : Submodule R M) ≤ ⊥ ⊔ maximalIdeal R • ⊤ := by rw [bot_sup_eq, hmtop]
  have hle := Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac hNN
  have hbot : (⊤ : Submodule R M) = ⊥ := le_bot_iff.mp hle
  rw [Submodule.eq_bot_iff] at hbot
  obtain ⟨a, ha⟩ := exists_ne (0 : M)
  exact ha (hbot a trivial)

/-- Snoc step for regular sequences: if `zs` is `M`-regular and `t` is regular on
`N := M/(zs)·M`, and all of `zs ++ [t]` lie in `m`, then `zs ++ [t]` is `M`-regular. -/
theorem isRegular_append_singleton_of_isSMulRegular_quotient
    (R : Type*) [CommRing R] [IsLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (zs : List R) (t : R)
    (hzreg : RingTheory.Sequence.IsRegular M zs)
    (htreg : IsSMulRegular (M ⧸ Ideal.ofList zs • (⊤ : Submodule R M)) t)
    (hmem : ∀ z ∈ zs ++ [t], z ∈ maximalIdeal R) :
    RingTheory.Sequence.IsRegular M (zs ++ [t]) := by
  refine ⟨?_, ?_⟩
  · rw [RingTheory.Sequence.isWeaklyRegular_append_iff']
    refine ⟨hzreg.toIsWeaklyRegular, ?_⟩
    rw [show ([t].map (Ideal.Quotient.mk (Ideal.ofList zs)))
          = [(Ideal.Quotient.mk (Ideal.ofList zs)) t] from rfl,
        RingTheory.Sequence.isWeaklyRegular_singleton_iff]
    exact (isSMulRegular_map (Ideal.Quotient.mk (Ideal.ofList zs)) (congrFun rfl)).mp htreg
  · -- `⊤ ≠ Ideal.ofList (zs ++ [t]) • ⊤` by Nakayama, since `ofList (zs ++ [t]) ≤ m`.
    have hIle : Ideal.ofList (zs ++ [t]) ≤ maximalIdeal R := by
      rw [Ideal.ofList, Ideal.span_le]
      intro z hz
      simp only [Set.mem_ofPred_eq] at hz
      exact hmem z hz
    exact fun hc =>
      ofList_smul_top_ne_top_of_le_maximalIdeal R M (Ideal.ofList (zs ++ [t])) hIle hc.symm

/-- **A regular parameter extends to a maximal regular sequence.**
Given the MCM module `M` over the regular local ring `R` (`dim R = d`) and a
regular parameter `x ∈ m \ m²` that is `M`-regular, there is an `M`-regular
sequence `x :: ys` of length `d`, all of whose members lie in `m`.

Proof sketch (induction on the gap `d - (length so far)`, using the kernel
`notMem_associatedPrimes_quotient_of_mcm`): starting from the length-1 regular
sequence `[x]`, as long as the current length is `< d` the partial quotient
`N = M/(seq)·M` has `m ∉ Ass(N)` (kernel), so by prime avoidance over the finite
`Ass(N)` — mirroring the proof of `exists_regular_parameter` but with
`Ass(N)` in place of `Ass(M)` and no `m²` constraint — there is `t ∈ m` that is
`N`-regular; appending `t` (via `RingTheory.Sequence.isRegular_cons_iff` /
`.cons`) keeps the sequence `M`-regular and increases its length by one.  Iterate
until length `= d`.  Each appended `t ∈ m`. -/
theorem exists_mcm_regular_seq_cons
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (x : R) (hx : x ∈ maximalIdeal R) (hxreg : IsSMulRegular M x)
    (hM : IsMaxCM R M) :
    ∃ ys : List R, (∀ y ∈ ys, y ∈ maximalIdeal R) ∧
      RingTheory.Sequence.IsRegular M (x :: ys) ∧
      ((x :: ys).length : WithBot ℕ∞) = ringKrullDim R := by
  -- Inductive construction via prime avoidance + the kernel; see docstring.
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have : IsLocalRing R := inferInstance
  -- `d : ℕ` with `(d : WithBot ℕ∞) = ringKrullDim R`, from the MCM witness.
  obtain ⟨rs, hrsmem, hrsreg, hrslen⟩ := hM
  set d : ℕ := rs.length with hd
  have hdR : (d : WithBot ℕ∞) = ringKrullDim R := hrslen
  -- The base sequence `[x]` is `M`-regular (`x` regular, `M` nonzero) and `⊆ m`.
  have hntq : Nontrivial (QuotSMulTop x M) :=
    nontrivial_quotSMulTop_of_mem_maximalIdeal (L := M) hx
  have hxseq : RingTheory.Sequence.IsRegular M [x] :=
    RingTheory.Sequence.IsRegular.cons hxreg (RingTheory.Sequence.IsRegular.nil R _)
  -- `1 ≤ d`: `supportDim (M/xM) + 1 = supportDim M = dim R`, with `supportDim ≥ 0`.
  have hone : (1 : WithBot ℕ∞) ≤ ringKrullDim R := by
    have haddx := Module.supportDim_add_length_eq_supportDim_of_isRegular (R := R) (M := M) [x]
        hxseq
    rw [supportDim_eq_ringKrullDim_of_isMaxCM R M ⟨rs, hrsmem, hrsreg, hrslen⟩] at haddx
    calc (1 : WithBot ℕ∞) = 0 + ((([x]).length : ℕ) : WithBot ℕ∞) := by simp
      _ ≤ Module.supportDim R (M ⧸ Ideal.ofList [x] • (⊤ : Submodule R M))
            + ((([x]).length : ℕ) : WithBot ℕ∞) := by
          gcongr; exact zero_le_supportDim_quotient_of_isRegular R M [x] hxseq
      _ = ringKrullDim R := haddx
  have hdge1 : 1 ≤ d := by
    rw [← hdR] at hone
    exact_mod_cast hone
  -- ======================================================================
  -- The induction `key`: any `M`-regular `zs ⊆ m` with `zs.length + k = d`
  -- extends to `zs ++ ws` of length `d`, `M`-regular, with all entries in `m`.
  -- ======================================================================
  have key : ∀ (k : ℕ) (zs : List R), (∀ z ∈ zs, z ∈ maximalIdeal R) →
      RingTheory.Sequence.IsRegular M zs →
      (zs.length : WithBot ℕ∞) + (k : WithBot ℕ∞) = ringKrullDim R →
      ∃ ws : List R, (∀ w ∈ ws, w ∈ maximalIdeal R) ∧
        RingTheory.Sequence.IsRegular M (zs ++ ws) ∧
        ((zs ++ ws).length : WithBot ℕ∞) = ringKrullDim R := by
    intro k
    induction k with
    | zero =>
      intro zs hzmem hzreg hlen
      refine ⟨[], by simp, ?_, ?_⟩
      · simpa using hzreg
      · simpa using by simpa using hlen
    | succ n ih =>
      intro zs hzmem hzreg hlen
      -- `zs.length < dim R` from `zs.length + (n+1) = dim R`.
      have hlennat : zs.length + (n + 1) = d := by
        have hc : ((zs.length + (n + 1) : ℕ) : WithBot ℕ∞) = (d : WithBot ℕ∞) := by
          rw [hdR, ← hlen]; push_cast; ring
        exact_mod_cast hc
      have hlt : (zs.length : WithBot ℕ∞) < ringKrullDim R := by
        rw [← hdR]
        have : zs.length < d := by omega
        exact_mod_cast this
      -- Set up the quotient `N` and its instances.
      set N := M ⧸ Ideal.ofList zs • (⊤ : Submodule R M) with hN
      have : Module.Finite R N := inferInstance
      have : Nontrivial N :=
        (Submodule.Quotient.nontrivial_iff).mpr (fun hc => hzreg.top_ne_smul hc.symm)
      -- Kernel: `m ∉ Ass N`.
      have hmass : maximalIdeal R ∉ associatedPrimes R N :=
        notMem_associatedPrimes_quotient_of_mcm R M ⟨rs, hrsmem, hrsreg, hrslen⟩ zs hzmem hzreg hlt
      -- Extract an `N`-regular `t ∈ m` by prime avoidance over the finite `Ass N`.
      obtain ⟨t, htmem, htreg⟩ : ∃ t ∈ maximalIdeal R, IsSMulRegular N t := by
        by_contra h
        push Not at h
        exact hmass (maximalIdeal_mem_associatedPrimes_of_forall_not_isSMulRegular R N h)
      -- New sequence `zs ++ [t]` is `M`-regular, `⊆ m`, of length `zs.length + 1`.
      have hmem' : ∀ z ∈ zs ++ [t], z ∈ maximalIdeal R := by
        intro z hz
        rcases List.mem_append.mp hz with hz | hz
        · exact hzmem z hz
        · rcases List.mem_singleton.mp hz with rfl; exact htmem
      have hzt : RingTheory.Sequence.IsRegular M (zs ++ [t]) :=
        isRegular_append_singleton_of_isSMulRegular_quotient R M zs t hzreg htreg hmem'
      -- Length bookkeeping: `(zs ++ [t]).length + n = dim R`.
      have hlen' : ((zs ++ [t]).length : WithBot ℕ∞) + (n : WithBot ℕ∞) = ringKrullDim R := by
        have hcast : ((zs ++ [t]).length : WithBot ℕ∞) = (zs.length : WithBot ℕ∞) + 1 := by
          simp [List.length_append]
        rw [hcast]
        rw [show (zs.length : WithBot ℕ∞) + 1 + (n : WithBot ℕ∞)
              = (zs.length : WithBot ℕ∞) + ((n : WithBot ℕ∞) + 1) by ring]
        rw [show (n : WithBot ℕ∞) + 1 = ((n + 1 : ℕ) : WithBot ℕ∞) by push_cast; ring]
        simpa [Nat.cast_succ] using hlen
      -- Apply the induction hypothesis to `zs ++ [t]`.
      obtain ⟨ws, hwsmem, hwsreg, hwslen⟩ := ih (zs ++ [t]) hmem' hzt hlen'
      refine ⟨[t] ++ ws, ?_, ?_, ?_⟩
      · intro w hw
        rcases List.mem_append.mp hw with hw | hw
        · rcases List.mem_singleton.mp hw with rfl; exact htmem
        · exact hwsmem w hw
      · rwa [← List.append_assoc]
      · rwa [← List.append_assoc]
  -- Apply `key` to `[x]` with `k = d - 1`.
  have hbaseLen : (([x]).length : WithBot ℕ∞) + ((d - 1 : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
    have : (1 : ℕ) + (d - 1) = d := by omega
    calc (([x]).length : WithBot ℕ∞) + ((d - 1 : ℕ) : WithBot ℕ∞)
        = (((1 : ℕ) + (d - 1) : ℕ) : WithBot ℕ∞) := by push_cast [List.length_singleton]; ring
      _ = (d : WithBot ℕ∞) := by rw [this]
      _ = ringKrullDim R := hdR
  obtain ⟨ws, hwsmem, hwsreg, hwslen⟩ :=
    key (d - 1) [x] (by intro z hz; rcases List.mem_singleton.mp hz with rfl; exact hx)
      hxseq hbaseLen
  refine ⟨ws, hwsmem, ?_, ?_⟩
  · have : [x] ++ ws = x :: ws := rfl
    rwa [← this]
  · have : [x] ++ ws = x :: ws := rfl
    rwa [← this]

/-- **Maximal Cohen-Macaulayness descends to the quotient.**  Let `M` be a nonzero
finite maximal Cohen-Macaulay module over the regular local ring `R` and let `x ∈ m \ m²` be a
regular parameter that is `M`-regular.  Then `M / xM` is a nonzero finite `R / xR`-module and is
maximal Cohen-Macaulay over `R / xR`, its regular sequence having length `dim R - 1`. -/
theorem mcm_of_quotient
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (x : R) [IsLocalRing (R ⧸ Ideal.span {x})]
    (hx : x ∈ maximalIdeal R) (hx2 : x ∉ (maximalIdeal R) ^ 2)
    (hxreg : IsSMulRegular M x) (hM : IsMaxCM R M) :
    Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x M) ∧
      Nontrivial (QuotSMulTop x M) ∧
      IsMaxCM (R ⧸ Ideal.span {x}) (QuotSMulTop x M) := by
  have : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  -- Part 1: `M/xM` is a finite `R/xR`-module (scalar-tower transfer).
  have hFinR : Module.Finite R (QuotSMulTop x M) := inferInstance
  have hfin : Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x M) :=
    Module.Finite.of_restrictScalars_finite R (R ⧸ Ideal.span {x}) (QuotSMulTop x M)
  -- Part 2: `M/xM ≠ 0` by Nakayama (`x ∈ m`).
  have hnt : Nontrivial (QuotSMulTop x M) :=
    nontrivial_quotSMulTop_of_mem_maximalIdeal (L := M) hx
  refine ⟨hfin, hnt, ?_⟩
  -- Part 3 (genuine content): `M/xM` is MCM over `R/xR`.
  -- `x ≠ 0` and `x ∈ nonZeroDivisors` (domain + regular parameter), so the
  -- dimension of the quotient drops by exactly one.
  have : IsDomain R := isDomain_of_isRegularLocalRing R
  have hx0 : x ≠ 0 := fun h => hx2 (h ▸ Submodule.zero_mem _)
  have hxnzd : x ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hx0
  have hdimq : ringKrullDim (R ⧸ Ideal.span {x}) + 1 = ringKrullDim R :=
    ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors hxnzd hx
  -- Extend `x` to a maximal `M`-regular sequence `x :: ys` of length `dim R`.
  obtain ⟨ys, hymem, hreg, hlen⟩ := exists_mcm_regular_seq_cons R M x hx hxreg hM
  -- Push `ys` down to `R/xR`: the images form a `(M/xM)`-regular sequence.
  have hregq : RingTheory.Sequence.IsRegular (QuotSMulTop x M)
      (ys.map (Ideal.Quotient.mk (Ideal.span {x}))) :=
    ((RingTheory.Sequence.isRegular_cons_iff' M x ys).mp hreg).right
  refine ⟨ys.map (Ideal.Quotient.mk (Ideal.span {x})), ?_, hregq, ?_⟩
  · -- Each image lies in `maximalIdeal (R/xR)`.
    intro y hy
    simp only [List.mem_map] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    -- The image of `m` under the quotient is `maximalIdeal (R/xR)`.
    have : (Ideal.Quotient.mk (Ideal.span {x})) z ∈
        (maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x})) :=
      Ideal.mem_map_of_mem _ (hymem z hz)
    rwa [IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective] at this
  · -- Length bookkeeping: `length ys = dim(R/xR)`.
    -- `↑(x :: ys).length = dim R = dim(R/xR) + 1` and `(x::ys).length = ys.length + 1`.
    have h1 : ((ys.length + 1 : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
      simpa [List.length_cons] using hlen
    rw [List.length_map]
    -- From `dim(R/xR) + 1 = dim R = ↑(ys.length) + 1` cancel the `+1`.
    rw [← hdimq] at h1
    -- h1 : ↑(ys.length + 1) = ringKrullDim (R/xR) + 1
    have h2 : (ys.length : WithBot ℕ∞) + 1 = ringKrullDim (R ⧸ Ideal.span {x}) + 1 := by
      push_cast at h1; exact h1
    exact ENat.WithBot.add_one_cancel.mp h2

open scoped Pointwise in
/-- **Freeness lifts (Stacks 00NS, Lemma 10.106.5).** Let `x` be a
nonzerodivisor on the finite `R`-module `M` with `x ∈ maximalIdeal R`. If the
quotient `M/xM` is free as an `R/xR`-module, then `M` is free as an `R`-module.

Standard proof: lift an `R/xR`-basis of `M/xM` to elements `e_i ∈ M`. By
Nakayama (`x ∈ m`) they generate `M`.  They are `R`-linearly independent: a
relation `∑ a_i e_i = 0` reduces mod `x` to a relation over `R/xR`, forcing all
`a_i ∈ (x)`; writing `a_i = x b_i`, regularity of `x` on `M` cancels `x` to give
`∑ b_i e_i = 0`, and an infinite-descent / `m`-adic-separatedness argument
(Krull intersection) forces all `a_i = 0`.  Hence the `e_i` form an `R`-basis.

`free_of_flat_of_isLocalRing` offers an alternative finish, by showing `M` flat, but
the direct basis-lifting argument above is the Stacks route.

The hypothesis `[IsNoetherianRing R]` is required, as in Stacks 00NS; without it the statement is
false, a counterexample being a non-Noetherian rank-`2` valuation ring with `⋂ₙ xⁿR ≠ 0`, where
Krull intersection and hence Nakayama on the kernel fails.  At the call site `R` is
`IsRegularLocalRing`, which extends `IsNoetherian R R`, so the instance is supplied
automatically. -/
@[ega "0 10.1.2" "special case",
  ega "0 10.2.2" "(x), special case",
  sga "1 IV 4.1" "(b), special case"]
theorem free_of_quotSMulTop_free
    (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M]
    (x : R) (hx : x ∈ maximalIdeal R) (hxreg : IsSMulRegular M x)
    (hfree : Module.Free (R ⧸ Ideal.span {x}) (QuotSMulTop x M)) :
    Module.Free R M := by
  classical
  have : Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x M) :=
    Module.Finite.of_restrictScalars_finite R _ _
  set b := Module.Free.chooseBasis (R ⧸ Ideal.span {x}) (QuotSMulTop x M) with hb
  set ι := Module.Free.ChooseBasisIndex (R ⧸ Ideal.span {x}) (QuotSMulTop x M) with hι
  have : Fintype ι := inferInstance
  have hsurj : Function.Surjective (Submodule.Quotient.mk : M → QuotSMulTop x M) :=
    Submodule.Quotient.mk_surjective _
  choose e he using fun i => hsurj (b i)
  -- ONE-STEP reduction: any `R`-relation among the `e i` reduces mod `x` to a
  -- relation among the basis vectors `b i`, so each coefficient lies in `(x)`.
  have onestep : ∀ (h : ι → R), (∑ i, h i • e i = 0) → ∀ i, h i ∈ Ideal.span {x} := by
    intro h hrel
    have hmk : ∑ i, (Ideal.Quotient.mk (Ideal.span {x}) (h i)) • b i = 0 := by
      have hcong := congrArg (Submodule.mkQ (x • ⊤ : Submodule R M)) hrel
      rw [map_sum, map_zero] at hcong
      rw [← hcong]
      apply Finset.sum_congr rfl
      intro i _
      rw [Submodule.mkQ_apply, ← he i]; rfl
    have hli := b.linearIndependent
    rw [Fintype.linearIndependent_iff] at hli
    intro i
    have := hli (fun i => Ideal.Quotient.mk (Ideal.span {x}) (h i)) hmk i
    rwa [Ideal.Quotient.eq_zero_iff_mem] at this
  -- LINEAR INDEPENDENCE via infinite descent + Krull intersection.
  have hlinindep : LinearIndependent R e := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    -- For every `n`, the coefficients are divisible by `xⁿ`.
    have desc : ∀ n : ℕ, ∃ h : ι → R, (∑ i, h i • e i = 0) ∧ (∀ i, g i = x^n * h i) := by
      intro n
      induction n with
      | zero => exact ⟨g, hg, by intro i; simp⟩
      | succ n ih =>
        obtain ⟨h, hrel, hgi⟩ := ih
        have hmem := onestep h hrel
        choose h' hh' using fun i => Ideal.mem_span_singleton'.mp (hmem i)
        have hxrel : x • (∑ i, h' i • e i) = x • (0 : M) := by
          rw [smul_zero, Finset.smul_sum, ← hrel]
          apply Finset.sum_congr rfl
          intro i _
          rw [smul_smul, ← hh' i, mul_comm]
        have hrel' : ∑ i, h' i • e i = 0 := hxreg hxrel
        refine ⟨h', hrel', ?_⟩
        intro i
        rw [hgi i, ← hh' i, pow_succ]; ring
    -- Krull intersection: `⋂ₙ (x)ⁿ = ⊥` over a Noetherian local ring.
    have hbot : (⨅ k : ℕ, (Ideal.span {x})^k) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing (Ideal.span {x})
        (Ideal.span_singleton_ne_top (mem_nonunits_iff.mp hx))
    intro i
    have hmem_all : ∀ n : ℕ, g i ∈ (Ideal.span {x})^n := by
      intro n
      obtain ⟨h, _, hgi⟩ := desc n
      rw [hgi i]
      exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self x) n)
    have hin : g i ∈ (⨅ k : ℕ, (Ideal.span {x})^k) := Ideal.mem_iInf.mpr hmem_all
    rwa [hbot] at hin
  -- SPANNING via Nakayama: the `e i` generate `M` because their images generate `M/xM`.
  have hspan : ⊤ ≤ Submodule.span R (Set.range e) := by
    set N := Submodule.span R (Set.range e) with hN
    have hfg : (⊤ : Submodule R M).FG := Module.finite_def.mp inferInstance
    have hjac : Ideal.span {x} ≤ Ideal.jacobson ⊥ := by
      rwa [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.span_le,
        Set.singleton_subset_iff]
    have hmapN : Submodule.map (Submodule.mkQ (x • ⊤ : Submodule R M)) N = ⊤ := by
      rw [eq_top_iff]
      have hbsub : Set.range (b : ι → QuotSMulTop x M) ⊆
          (Submodule.map (Submodule.mkQ (x • ⊤ : Submodule R M)) N : Set (QuotSMulTop x M)) := by
        rintro _ ⟨i, rfl⟩
        rw [← he i]
        exact ⟨e i, Submodule.subset_span ⟨i, rfl⟩, rfl⟩
      calc (⊤ : Submodule R (QuotSMulTop x M))
          = (Submodule.span R (Set.range (b : ι → QuotSMulTop x M))) := by
            rw [← Submodule.restrictScalars_span R (R ⧸ Ideal.span {x})
                Ideal.Quotient.mk_surjective, b.span_eq]
            rfl
        _ ≤ _ := Submodule.span_le.mpr hbsub
    have hkey : (⊤ : Submodule R M) ≤ N ⊔ (Ideal.span {x}) • ⊤ := by
      intro m _
      have hm : (Submodule.mkQ (x • ⊤ : Submodule R M)) m ∈
          Submodule.map (Submodule.mkQ (x • ⊤ : Submodule R M)) N := by
        simp [hmapN]
      obtain ⟨y, hyN, hy⟩ := hm
      have hmy : m - y ∈ (Ideal.span {x}) • (⊤ : Submodule R M) := by
        rw [Submodule.ideal_span_singleton_smul, ← Submodule.ker_mkQ (x • ⊤ : Submodule R M),
          LinearMap.mem_ker, map_sub, hy, sub_self]
      simpa using Submodule.add_mem_sup hyN hmy
    exact Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac hkey
  -- Assemble the `R`-basis and conclude freeness.
  exact Module.Free.of_basis (Module.Basis.mk hlinindep hspan)

/-- Generalized form used for the induction on the length `n` of the regular
sequence (equivalently `ringKrullDim R`).  We generalize over `R` and `M` so the
inductive step may instantiate the hypothesis at `R/xR` and `M/xM`. -/
@[ega "0 17.3.5" "(i), sufficiency"]
theorem regular_mcm_free_aux :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsRegularLocalRing R]
      (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
      (rs : List R), (∀ r ∈ rs, r ∈ maximalIdeal R) →
      RingTheory.Sequence.IsRegular M rs →
      (rs.length : WithBot ℕ∞) = ringKrullDim R →
      rs.length = n →
      Module.Free R M := by
  intro n
  induction n with
  | zero =>
    -- `rs.length = 0`, so `ringKrullDim R = 0`: the base case.
    intro R _ _ M _ _ _ _ rs _ _ hlen hn
    have hd : ringKrullDim R = 0 := by
      rw [← hlen, hn]; rfl
    exact free_of_isRegularLocalRing_dim_zero R hd M
  | succ n ih =>
    -- `ringKrullDim R = n+1 ≠ 0`.  Reassemble the MCM witness `hM`.
    intro R _ _ M _ _ _ _ rs hmem hreg hlen hn
    have hM : IsMaxCM R M := ⟨rs, hmem, hreg, hlen⟩
    have hdim : ringKrullDim R ≠ 0 := by
      rw [← hlen, hn]; exact_mod_cast (Nat.succ_ne_zero n)
    -- Pick a regular parameter `x` (`x ∈ m \ m²`, `M`-regular).
    obtain ⟨x, hx, hx2, hxreg⟩ := exists_regular_parameter R M hdim hM
    -- `R/xR` is regular local, with `dim(R/xR) + 1 = dim R`.
    obtain ⟨hRq, hdimq⟩ := quotient_isRegularLocalRing R x hx hx2
    have : IsRegularLocalRing (R ⧸ Ideal.span {x}) := hRq
    -- `M/xM` is a nonzero finite MCM `R/xR`-module.
    obtain ⟨hFinq, hNT, hMCMq⟩ := mcm_of_quotient R M x hx hx2 hxreg hM
    have : Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x M) := hFinq
    -- Unpack the new witness and apply the induction hypothesis: its regular
    -- sequence has length `n` (= dim(R/xR)), so `M/xM` is `R/xR`-free.
    obtain ⟨rs2, hmem2, hreg2, hlen2⟩ := hMCMq
    have hn2 : rs2.length = n := by
      -- `↑(n+1) = dim R = dim(R/xR) + 1 = ↑rs2.length + 1` in `WithBot ℕ∞`.
      have hRdim : ringKrullDim R = ((n : ℕ) + 1 : ℕ) := by rw [← hlen, hn]
      rw [hRdim, ← hlen2] at hdimq
      -- hdimq : ↑rs2.length + 1 = ↑(n+1); turn LHS into ↑(rs2.length+1) and use
      -- injectivity of the `ℕ → WithBot ℕ∞` cast.
      have hcast : ((rs2.length + 1 : ℕ) : WithBot ℕ∞) = ((n + 1 : ℕ) : WithBot ℕ∞) := by
        push_cast
        push_cast at hdimq
        exact hdimq
      have := Nat.cast_injective (R := WithBot ℕ∞) hcast
      omega
    have hfree : Module.Free (R ⧸ Ideal.span {x}) (QuotSMulTop x M) :=
      ih (R ⧸ Ideal.span {x}) (QuotSMulTop x M) rs2 hmem2 hreg2 hlen2 hn2
    -- Stacks 00NS: lift freeness from `M/xM` over `R/xR` to `M` over `R`.
    exact free_of_quotSMulTop_free R M x hx hxreg hfree

/-- Stacks Tag 00NT (Lemma 10.106.6): over a regular local ring, any nonzero
finitely generated maximal Cohen-Macaulay module is free. -/
@[stacks 00NT, ega "0 17.3.5" "(i), sufficiency", ega "IV 6.1.5" "special case"]
theorem regular_mcm_free
    (R : Type*) [CommRing R] [IsRegularLocalRing R]
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Finite R M] [Nontrivial M]
    (hM : IsMaxCM R M) : Module.Free R M := by
  -- Unpack the MCM witness and reduce to `regular_mcm_free_aux` at `n = rs.length`.
  obtain ⟨rs, hrs_mem, hrs_reg, hrs_len⟩ := hM
  exact regular_mcm_free_aux rs.length R M rs hrs_mem hrs_reg hrs_len rfl

end

/-! ### The depth form of maximal Cohen-Macaulayness

`Module.IsMaximalCohenMacaulay R M` (Stacks Tag 00NF) is the equality `depth_m(M) = dim R`, while
`IsMaxCM R M` above is the existence of an `M`-regular sequence in `m` of length `dim R`, the form
the proof of Stacks Tag 00NT consumes.  For a nonzero finite module over a Noetherian local ring
the two agree: `exists_isRegular_length_eq_ringKrullDim_of_isMaximalCohenMacaulay` and
`isMaximalCohenMacaulay_of_exists_isRegular` convert between them. -/

@[expose] public section

open IsLocalRing RingTheory.Sequence in
/-- **A maximal Cohen-Macaulay module has a regular sequence of length `dim R`.** For a nonzero
finite module over a Noetherian local ring the supremum defining the depth is attained
(Stacks 00LE), so `depth M = dim R` produces an `M`-regular sequence inside the maximal ideal
whose length is `dim R`.  Both the finiteness and the nontriviality are needed: no sequence at
all is `0`-regular, while `depth R 𝔪 0 = 0`. -/
@[ega "0 16.5.9" "special case"]
public theorem exists_isRegular_length_eq_ringKrullDim_of_isMaximalCohenMacaulay (R : Type*)
    [CommRing R] [IsNoetherianRing R] [IsLocalRing R] (M : Type*) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Nontrivial M] (hM : Module.IsMaximalCohenMacaulay R M) :
    ∃ rs : List R,
      (∀ r ∈ rs, r ∈ maximalIdeal R) ∧
      RingTheory.Sequence.IsRegular M rs ∧
      (rs.length : WithBot ℕ∞) = ringKrullDim R := by
  have hI : maximalIdeal R • (⊤ : Submodule R M) ≠ ⊤ :=
    Module.maximalIdeal_smul_top_ne_top M
  have hd : (Module.depth R (maximalIdeal R) M : WithBot ℕ∞) = ringKrullDim R := hM
  obtain ⟨rs, hmem, hreg, hlen⟩ :=
    (Module.depth_quotSMulTop_succ_eq_depth_and_exists_isRegular_append
      (maximalIdeal R) M).2 hI [] (by simp) (IsRegular.nil R M)
  rw [List.nil_append] at hreg hlen
  refine ⟨rs, hmem, hreg, ?_⟩
  rw [← hd, ← hlen]
  norm_cast

open IsLocalRing RingTheory.Sequence in
/-- **A regular sequence of length `dim R` makes a module maximal Cohen-Macaulay.** An
`M`-regular sequence inside the maximal ideal of length `dim R` forces `dim R ≤ depth M`, while
`depth M ≤ dim Supp M ≤ dim R` holds for every nonzero finite module; so `depth M = dim R`, which
is `Module.IsMaximalCohenMacaulay R M` (Stacks 00NF). -/
@[ega "0 16.5.7" "special case"]
public theorem isMaximalCohenMacaulay_of_exists_isRegular (R : Type*) [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] (M : Type*) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Nontrivial M]
    (h : ∃ rs : List R,
      (∀ r ∈ rs, r ∈ maximalIdeal R) ∧
      RingTheory.Sequence.IsRegular M rs ∧
      (rs.length : WithBot ℕ∞) = ringKrullDim R) :
    Module.IsMaximalCohenMacaulay R M := by
  have hI : maximalIdeal R • (⊤ : Submodule R M) ≠ ⊤ :=
    Module.maximalIdeal_smul_top_ne_top M
  have hub : (Module.depth R (maximalIdeal R) M : WithBot ℕ∞) ≤ ringKrullDim R :=
    (Module.depth_le_supportDim R (maximalIdeal R) M hI).trans
      (Module.supportDim_le_ringKrullDim (R := R) (M := M))
  rw [Module.IsMaximalCohenMacaulay]
  obtain ⟨rs, hmem, hreg, hlen⟩ := h
  refine le_antisymm hub ?_
  rw [← hlen]
  exact_mod_cast Module.le_depth_of_isRegular (maximalIdeal R) hmem hreg

end
