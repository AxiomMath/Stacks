/-!
# Graded pieces, the Hilbert function, and graded quotients

The `S_0`-module structure on the graded pieces `M_n`, the irrelevant ideal `S_+`,
finiteness of the graded pieces over `S_0` (Stacks Lemma 10.58.6, Tag 00K0), the Hilbert
function `hilbertFun`, the quotient grading of a graded module by a homogeneous submodule,
and the vanishing of the Hilbert function when `S_1 = 0` (the base case of the proof of
Stacks Proposition 10.58.7, Tag 00K1).
-/

@[expose] public section
-- needed file-wide: `FinModule.cls_eq_of_linearEquiv`, `FinModule.cls_add_of_ses`,
-- `KPrime0.hom_ext`, `xpow_four_term_class` and `hilbertFun_xpow_step_identity` all rewrite
-- through the `FinModule`/`KPrime0` quotient wrappers and the graded-piece subgroup coercions,
-- which only unfold with defeq transparency relaxed.  See also the note before
-- `section MainPieces`, which depends on this option holding for the whole file.
set_option backward.isDefEq.respectTransparency false
universe u

/-! ## Graded ring / graded module setup and the grade-zero module structure -/

section GradeZeroModule

variable {S M : Type u}
variable [CommRing S]
variable (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
variable [AddCommGroup M] [Module S M]
variable (ℳ : ℤ → AddSubgroup M)
variable [SetLike.GradedSMul 𝒮 ℳ]

/-- The natural scalar multiplication of the degree-zero ring `↥(𝒮 0)` on each
homogeneous piece `↥(ℳ n)`, coming from `S_0 · M_n ⊆ M_{0+n} = M_n`. -/
instance gradePieceSMul (n : ℤ) : SMul ↥(𝒮 0) ↥(ℳ n) where
  smul s m :=
    ⟨(s : S) • (m : M), by
      have := SetLike.GradedSMul.smul_mem s.property m.property
      simpa using this⟩

omit [GradedRing 𝒮] in
/-- The action of `s ∈ ↥(𝒮 0)` on `m ∈ ↥(ℳ n)`, viewed in `M`, is `(s : S) • (m : M)`. -/
@[simp]
lemma gradePieceSMul_coe (n : ℤ) (s : ↥(𝒮 0)) (m : ↥(ℳ n)) :
    ((s • m : ↥(ℳ n)) : M) = (s : S) • (m : M) :=
  rfl

/-- Each homogeneous piece `↥(ℳ n)` is a module over the degree-zero ring
`↥(𝒮 0)`. -/
@[ega "II 2.1.1"]
instance gradePieceModule (n : ℤ) : Module ↥(𝒮 0) ↥(ℳ n) where
  one_smul m := by
    ext; simp
  mul_smul s t m := by
    ext
    simp only [gradePieceSMul_coe]
    rw [SetLike.GradeZero.coe_mul, mul_smul]
  smul_zero s := by
    ext; simp
  smul_add s m₁ m₂ := by
    ext; simp [smul_add]
  add_smul s t m := by
    ext
    simp only [gradePieceSMul_coe, AddMemClass.coe_add]
    rw [add_smul]
  zero_smul m := by
    ext
    simp only [gradePieceSMul_coe, ZeroMemClass.coe_zero, zero_smul]

end GradeZeroModule

/-! ## The irrelevant ideal and degree-one generation -/

section Irrelevant

variable {S : Type u} [CommRing S]

/-- The irrelevant ideal `S_+ = ⨁_{d > 0} S_d`, defined as the ideal of `S`
generated by all homogeneous elements of positive degree. -/
@[ega "II 2.1.1"]
def irrelevantIdeal (𝒮 : ℤ → AddSubgroup S) : Ideal S :=
  Ideal.span {s : S | ∃ d : ℤ, 0 < d ∧ s ∈ 𝒮 d}

/-- `S_+` is *generated in degree 1* if the irrelevant ideal is generated, as an
ideal of `S`, by the degree-`1` homogeneous elements `S_1`. -/
def GeneratedInDegreeOne (𝒮 : ℤ → AddSubgroup S) : Prop :=
  irrelevantIdeal 𝒮 = Ideal.span (𝒮 1 : Set S)

end Irrelevant

/-- The `j`-th component of a decomposed element is nonzero when `j` lies in its support. -/
private theorem coe_decompose_ne_zero {M : Type u} [AddCommGroup M] (ℳ : ℤ → AddSubgroup M)
    [DirectSum.Decomposition ℳ] [∀ (i : ℤ) (x : ℳ i), Decidable (x ≠ 0)] {x : M} {j : ℤ}
    (hj : j ∈ (DirectSum.decompose ℳ x).support) : (DirectSum.decompose ℳ x j : M) ≠ 0 :=
  fun h => DFinsupp.mem_support_iff.mp hj (Subtype.ext h)

/-- A component of `s • x` is the sum of the components of `s` times the homogeneous parts
of `x`. -/
private theorem coe_decompose_smul_eq_sum {S M : Type u} [CommRing S] [AddCommGroup M]
    [Module S M] (ℳ : ℤ → AddSubgroup M) [DirectSum.Decomposition ℳ]
    [∀ (i : ℤ) (x : ℳ i), Decidable (x ≠ 0)] (s : S) (x : M) (k : ℤ) :
    (DirectSum.decompose ℳ (s • x) k : M) = ∑ j ∈ (DirectSum.decompose ℳ x).support,
      (DirectSum.decompose ℳ (s • (DirectSum.decompose ℳ x j : M)) k : M) := by
  conv_lhs => rw [← DirectSum.sum_support_decompose ℳ x, Finset.smul_sum]
  rw [DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum]

/-- In a nonnegatively graded ring, the degree-`k` component of `s • m`, for `m ∈ ℳ j` with
`k ≤ j`, is `s₀ • m` if `j = k` and `0` otherwise. -/
private theorem coe_decompose_smul_of_le {S M : Type u} [CommRing S] [AddCommGroup M]
    [Module S M] (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮] (ℳ : ℤ → AddSubgroup M)
    [SetLike.GradedSMul 𝒮 ℳ] [DirectSum.Decomposition ℳ] (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥)
    (s : S) {m : M} {j k : ℤ} (hm : m ∈ ℳ j) (hk : k ≤ j) :
    (DirectSum.decompose ℳ (s • m) k : M) =
      if j = k then (DirectSum.decompose 𝒮 s 0 : S) • m else 0 := by
  classical
  have hmem : ∀ d : ℤ, ((DirectSum.decompose 𝒮 s d : 𝒮 d) : S) • m ∈ ℳ (d + j) := fun d =>
    SetLike.GradedSMul.smul_mem (DirectSum.decompose 𝒮 s d).property hm
  have hterm : ∀ d ∈ (DirectSum.decompose 𝒮 s).support, d ≠ 0 →
      (DirectSum.decompose ℳ ((DirectSum.decompose 𝒮 s d : S) • m) k : M) = 0 := by
    intro d _ hd
    rcases lt_or_gt_of_ne hd with h | h
    · have hz : ((DirectSum.decompose 𝒮 s d : 𝒮 d) : S) ∈ 𝒮 d :=
        (DirectSum.decompose 𝒮 s d).property
      simp only [hneg d h, AddSubgroup.mem_bot] at hz
      simp [hz]
    · exact DirectSum.decompose_of_mem_ne ℳ (hmem d) (by omega)
  conv_lhs => rw [← DirectSum.sum_support_decompose 𝒮 s, Finset.sum_smul]
  rw [DirectSum.decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum,
    Finset.sum_eq_single 0 hterm]
  · have h0 : ((DirectSum.decompose 𝒮 s 0 : 𝒮 0) : S) • m ∈ ℳ j := by simpa using hmem 0
    split_ifs with h
    · subst h
      exact DirectSum.decompose_of_mem_same ℳ h0
    · exact DirectSum.decompose_of_mem_ne ℳ h0 h
  · intro h0
    have : DirectSum.decompose 𝒮 s 0 = 0 := by simpa using h0
    simp [this]

/-! ## The Hilbert function and the main statement (core definitions)

`gradedPiece_finite`, `gradedFinModule`, and `hilbertFun` are placed here, *before*
any `def` whose signature abstracts the `M`-side `AddSubgroupClass.toAddSubmonoidClass`
auxiliary (from `[DirectSum.Decomposition ℳ]`) or the `S`-side `SetLike.GradeZero.instRing`
auxiliary (from `FinModule ↥(𝒮 0)`).  This guarantees that `gradedFinModule` itself owns the
auto-generated DATA-instance auxiliaries `gradedFinModule._proof_1/2`, matching the
elaboration of the reference statement exactly (any earlier `def` mentioning
`[DirectSum.Decomposition ℳ]` in its type would otherwise steal these auxiliaries, breaking that
match under
`set_option backward.isDefEq.respectTransparency false`).  The finiteness proof is therefore
kept self-contained (the reusable `gp_*` helpers live further down, after `hilbertFun`). -/

section MainPieces

variable {S M : Type u}
variable [CommRing S] [IsNoetherianRing S]
variable (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
variable [AddCommGroup M] [Module S M] [Module.Finite S M]
variable (ℳ : ℤ → AddSubgroup M)
variable [SetLike.GradedSMul 𝒮 ℳ] [DirectSum.Decomposition ℳ]

/- **Finiteness of homogeneous pieces (Stacks Lemma 10.58.6, Tag 00K0).**
For a Noetherian graded ring `S` and a finite graded `S`-module `M`, each
homogeneous piece `M_n = ℳ n` is a finite module over the degree-zero ring
`S_0 = ↥(𝒮 0)`.  This is the input that makes each class `[M_n]` a well-defined
element of `K'_0(S_0)`.

This proof is intentionally self-contained (it does not reference any reusable
graded-projection `def`, all of which would otherwise appear earlier and steal
the auxiliaries) so that `gradedFinModule` remains the first `def` to abstract the
graded-decomposition auxiliaries. -/
-- this proof's elaboration needs more than the default heartbeat budget
/-- Each graded piece `ℳ n` of a finite graded module over a nonnegatively graded ring is
a finite module over the degree-zero part `𝒮 0`. -/
@[ega "II 2.1.6" "(i), special case"]
theorem gradedPiece_finite (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥) (n : ℤ) :
    Module.Finite ↥(𝒮 0) ↥(ℳ n) := by
  classical
  -- local projection M →+ ↥(ℳ k)
  let pn : (k : ℤ) → M →+ ↥(ℳ k) := fun k =>
    (DFinsupp.evalAddMonoidHom k).comp (DirectSum.decomposeAddEquiv ℳ).toAddMonoidHom
  have pn_coe : ∀ (k : ℤ) (x : M), ((pn k x : ↥(ℳ k)) : M) = (DirectSum.decompose ℳ x k : M) :=
    fun k x => rfl
  have pn_of_mem : ∀ (k : ℤ) (m : M) (hm : m ∈ ℳ k), (pn k m : ↥(ℳ k)) = ⟨m, hm⟩ := by
    intro k m hm; apply Subtype.ext; rw [pn_coe]; exact DirectSum.decompose_of_mem_same ℳ hm
  -- submodule of elements supported in degrees ≥ k
  let Mge : ℤ → Submodule S M := fun k =>
    { carrier := {x : M | ∀ i : ℤ, i < k → (DirectSum.decompose ℳ x i : M) = 0}
      add_mem' := by
        intro a b ha hb i hi
        simp [DirectSum.decompose_add, ha i hi, hb i hi]
      zero_mem' := by
        intro i hi; simp
      smul_mem' := by
        intro c x hx i hi
        change (DirectSum.decompose ℳ (c • x) i : M) = 0
        rw [coe_decompose_smul_eq_sum]
        apply Finset.sum_eq_zero
        intro j hj
        have hjk : k ≤ j := by
          by_contra h
          exact coe_decompose_ne_zero ℳ hj (hx j (not_le.mp h))
        rw [coe_decompose_smul_of_le 𝒮 ℳ hneg c (DirectSum.decompose ℳ x j).property (by omega),
          ite_eq_right (by omega)] }
  have mem_Mge_of_mem : ∀ (k : ℤ) (m : M), m ∈ ℳ k → m ∈ Mge k := fun k m hm => fun i hi =>
    DirectSum.decompose_of_mem_ne ℳ hm (by omega)
  -- pn (s • m) = s₀ • pn m for m ∈ Mge n
  have pn_smul_mem :
    ∀ (s : S) (x : M),
      x ∈ Mge n →
        (pn n (s • x) : ↥(ℳ n)) =
          (⟨(DirectSum.decompose 𝒮 s 0 : S), (DirectSum.decompose 𝒮 s 0).property⟩ : ↥(𝒮 0)) •
            pn n x := by
    intro s x hx
    apply Subtype.ext
    have h1 := coe_decompose_smul_eq_sum ℳ (1 : S) x n
    simp only [one_smul] at h1
    rw [pn_coe, gradePieceSMul_coe, pn_coe, coe_decompose_smul_eq_sum, h1, Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    have hxj := (DirectSum.decompose ℳ x j).property
    have hj' : n ≤ j := by
      by_contra h
      exact coe_decompose_ne_zero ℳ hj (hx j (not_le.mp h))
    rw [coe_decompose_smul_of_le 𝒮 ℳ hneg s hxj hj']
    by_cases hjn : j = n
    · subst hjn
      rw [ite_eq_left rfl, DirectSum.decompose_of_mem_same ℳ hxj]
    · rw [ite_eq_right hjn, DirectSum.decompose_of_mem_ne ℳ hxj hjn, smul_zero]
  -- main argument
  have hNoeth : IsNoetherian S M := isNoetherian_of_isNoetherianRing_of_finite S M
  obtain ⟨G, hG⟩ := (isNoetherian_def.mp hNoeth) (Mge n)
  rw [Module.finite_def]
  refine ⟨G.image (fun g => pn n g), ?_⟩
  rw [eq_top_iff]
  intro m _
  have hmMge : (m : M) ∈ Mge n := mem_Mge_of_mem n m m.property
  have hmspan : (m : M) ∈ Submodule.span S (G : Set M) := hG ▸ hmMge
  have hmpn : m = pn n (m : M) := (pn_of_mem n m m.property).symm
  rw [hmpn]
  have key :
    ∀ x ∈ Submodule.span S (G : Set M),
      (pn n x : ↥(ℳ n)) ∈ Submodule.span ↥(𝒮 0) (↑(G.image (fun g => pn n g)) : Set ↥(ℳ n)) := by
    intro x hx
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
    · intro z hz
      apply Submodule.subset_span
      simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe]
      exact ⟨z, hz, rfl⟩
    · simp
    · intro a b _ _ ha hb
      rw [map_add]
      exact Submodule.add_mem _ ha hb
    · intro s x hx ihx
      have hxMge : x ∈ Mge n := hG ▸ hx
      rw [pn_smul_mem s x hxMge]
      exact Submodule.smul_mem _ _ ihx
  exact key (m : M) hmspan

/-- The `n`-th homogeneous piece `M_n = ℳ n`, packaged as a finite
`↥(𝒮 0)`-module, using finiteness over the degree-zero ring. -/
def gradedFinModule (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥) (n : ℤ) : FinModule ↥(𝒮 0) where
  carrier := ↥(ℳ n)
  finite := gradedPiece_finite 𝒮 ℳ hneg n

/-- The Hilbert function `φ : ℤ → K'_0(S_0)`, `φ(n) = [M_n]`, of a finite graded
module over a Noetherian graded ring. -/
noncomputable def hilbertFun (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥) : ℤ → KPrime0 ↥(𝒮 0) := fun n =>
  (gradedFinModule 𝒮 ℳ hneg n).cls

end MainPieces

/-! ## Generic graded-quotient bundle

For a homogeneous submodule `N ⊆ M` of a graded module `(M, ℳ)` over a graded ring
`(S, 𝒮)`, the quotient `M ⧸ N` inherits a graded-module structure: a grading
`quotGrading ℳ N`, a `DirectSum.Decomposition`, a `SetLike.GradedSMul`, and
`Module.Finite`.  Mathlib only provides the homogeneity *predicate*
`Submodule.IsHomogeneous`; the graded-decomposition instance on the quotient is
built here by hand.  This is the central piece of infrastructure missing from
Mathlib that the `·xʳ` four-term-sequence argument (Stacks 00K1) needs in order to
even *state* the Hilbert function of `M/xʳM`. -/

section GradedQuotient

open DirectSum

variable {S M : Type u} [CommRing S]
variable (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
variable [AddCommGroup M] [Module S M]
variable (ℳ : ℤ → AddSubgroup M) [DirectSum.Decomposition ℳ]

/-- The grading on `M ⧸ N` induced from `ℳ`: the `i`-th piece is the image of
`ℳ i` under the quotient map `M → M ⧸ N`. -/
noncomputable def quotGrading (N : Submodule S M) : ℤ → AddSubgroup (M ⧸ N) := fun i =>
  (ℳ i).map (N.mkQ.toAddMonoidHom)

omit [Decomposition ℳ] in
/-- The class of a degree-`i` element lies in the degree-`i` piece of the quotient grading. -/
theorem quotGrading_mem (N : Submodule S M) (i : ℤ) (m : M) (hm : m ∈ ℳ i) :
    (N.mkQ m) ∈ quotGrading ℳ N i :=
  ⟨m, hm, rfl⟩

/-- The fibre map `ℳ i →+ (quotGrading ℳ N) i` given by `mkQ`. -/
noncomputable def quotFiber (N : Submodule S M) (i : ℤ) : ↥(ℳ i) →+ ↥(quotGrading ℳ N i) :=
  AddMonoidHom.codRestrict ((N.mkQ.toAddMonoidHom).comp (AddSubmonoidClass.subtype (ℳ i)))
    (quotGrading ℳ N i) (fun z => ⟨z, z.property, rfl⟩)

/-- The decompose map of `M` into the quotient pieces, prior to descending through `N`. -/
noncomputable def quotDecompM (N : Submodule S M) : M →+ ⨁ i, ↥(quotGrading ℳ N i) :=
  (DirectSum.map (quotFiber ℳ N)).comp (DirectSum.decomposeAddEquiv ℳ).toAddMonoidHom

omit [Decomposition ℳ] in
/-- `quotFiber` is the quotient map on underlying elements. -/
theorem quotFiber_coe (N : Submodule S M) (i : ℤ) (z : ↥(ℳ i)) :
    ((quotFiber ℳ N i z : ↥(quotGrading ℳ N i)) : M ⧸ N) = N.mkQ (z : M) :=
  rfl

/-- For a homogeneous submodule `N`, the map `quotDecompM` vanishes on `N`, so it descends
to `M ⧸ N`. -/
theorem quotDecompM_ker (N : Submodule S M) (hN : N.IsHomogeneous ℳ) (m : M) (hm : m ∈ N) :
    quotDecompM ℳ N m = 0 := by
  classical
  rw [quotDecompM]
  simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
  ext i
  rw [DirectSum.map_apply]
  show ((quotFiber ℳ N i (DirectSum.decompose ℳ m i) : ↥(quotGrading ℳ N i)) : M ⧸ N) = _
  rw [quotFiber_coe, show ((0 : ⨁ i, ↥(quotGrading ℳ N i)) i : M ⧸ N) = 0 by simp,
    Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact (Submodule.IsHomogeneous.mem_iff ℳ hN).mp hm i

omit [Decomposition ℳ] in
/-- Summing the fibrewise quotient maps agrees with taking the quotient of the sum. -/
theorem coe_map_quotFiber (N : Submodule S M) (y : ⨁ i, ↥(ℳ i)) :
    DirectSum.coeAddMonoidHom (quotGrading ℳ N) (DirectSum.map (quotFiber ℳ N) y) =
      N.mkQ (DirectSum.coeAddMonoidHom ℳ y) := by
  classical
    induction y using DirectSum.induction_on with
  | zero => simp
  | of i z =>
    rw [DirectSum.map_of, DirectSum.coeAddMonoidHom_of, DirectSum.coeAddMonoidHom_of,
      quotFiber_coe]
  | add a b ha hb => rw [map_add, map_add, map_add, ha, hb, map_add]

omit [Decomposition ℳ] in
/-- Each fibre map `ℳ i → (quotGrading ℳ N) i` is surjective. -/
theorem quotFiber_surj (N : Submodule S M) (i : ℤ) : Function.Surjective (quotFiber ℳ N i) := by
  rintro ⟨q, hq⟩
  simp only [quotGrading, AddSubgroup.mem_map] at hq
  obtain ⟨m, hm, rfl⟩ := hq
  exact ⟨⟨m, hm⟩, rfl⟩

/-- The decompose map descended to the quotient `M ⧸ N` (well-defined because `N` is
homogeneous, so `quotDecompM` kills `N`). -/
noncomputable def quotDecomp' (N : Submodule S M) (hN : N.IsHomogeneous ℳ) :
    (M ⧸ N) →+ ⨁ i, ↥(quotGrading ℳ N i) :=
  QuotientAddGroup.lift N.toAddSubgroup (quotDecompM ℳ N) (fun m hm => quotDecompM_ker ℳ N hN m hm)

/-- `quotDecomp'` computes on a class `N.mkQ m` by applying `quotDecompM` to `m`. -/
theorem quotDecomp'_mk (N : Submodule S M) (hN : N.IsHomogeneous ℳ) (m : M) :
    quotDecomp' ℳ N hN (N.mkQ m) = quotDecompM ℳ N m :=
  rfl

omit [Decomposition ℳ] in
/-- The direct sum of the fibre maps is surjective. -/
theorem map_quotFiber_surj (N : Submodule S M) :
    Function.Surjective (DirectSum.map (quotFiber ℳ N)) := by
  classical
  intro y
  induction y using DirectSum.induction_on with
  | zero => exact ⟨0, by simp⟩
  | of i z =>
    obtain ⟨w, rfl⟩ := quotFiber_surj ℳ N i z
    exact ⟨DirectSum.of _ i w, by rw [DirectSum.map_of]⟩
  | add a b ha hb =>
    obtain ⟨wa, rfl⟩ := ha; obtain ⟨wb, rfl⟩ := hb
    exact ⟨wa + wb, by rw [map_add]⟩

/-- **The graded `DirectSum.Decomposition` on the quotient `M ⧸ N`** for a
homogeneous submodule `N`.  This is the key construction absent from Mathlib. -/
@[reducible]
noncomputable def quotDecomposition (N : Submodule S M) (hN : N.IsHomogeneous ℳ) :
    DirectSum.Decomposition (quotGrading ℳ N)
    where
  decompose' := quotDecomp' ℳ N hN
  left_inv := by
    intro q
    obtain ⟨m, rfl⟩ := N.mkQ_surjective q
    rw [quotDecomp'_mk]
    change DirectSum.coeAddMonoidHom (quotGrading ℳ N) (quotDecompM ℳ N m) = N.mkQ m
    rw [quotDecompM]
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
    rw [coe_map_quotFiber]
    congr 1
    exact DirectSum.Decomposition.left_inv (ℳ := ℳ) m
  right_inv := by
    intro y
    obtain ⟨z, rfl⟩ := map_quotFiber_surj ℳ N y
    change
      quotDecomp' ℳ N hN
          (DirectSum.coeAddMonoidHom (quotGrading ℳ N) (DirectSum.map (quotFiber ℳ N) z)) =
        _
    rw [coe_map_quotFiber]
    show quotDecomp' ℳ N hN (N.mkQ (DirectSum.coeAddMonoidHom ℳ z)) = _
    rw [quotDecomp'_mk, quotDecompM]
    simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
    rw [show (DirectSum.decomposeAddEquiv ℳ) (DirectSum.coeAddMonoidHom ℳ z) = z from
        DirectSum.Decomposition.right_inv (ℳ := ℳ) z]

/-- **The graded scalar multiplication on the quotient `M ⧸ N`.** -/
instance quotGradedSMul [SetLike.GradedSMul 𝒮 ℳ] (N : Submodule S M) :
    SetLike.GradedSMul 𝒮 (quotGrading ℳ N)
    where
  smul_mem := by
    intro d i s q hs hq
    simp only [quotGrading, AddSubgroup.mem_map] at hq ⊢
    obtain ⟨m, hm, rfl⟩ := hq
    refine ⟨s • m, SetLike.GradedSMul.smul_mem (A := 𝒮) (B := ℳ) hs hm, ?_⟩
    simp only [Submodule.mkQ_apply, LinearMap.toAddMonoidHom_coe]
    rw [Submodule.Quotient.mk_smul]

end GradedQuotient

/-! ## The Hilbert function and the main statement -/

section Main

/- `S` is a commutative Noetherian ring, graded by `ℤ` via
`𝒮 : ℤ → AddSubgroup S` with `[GradedRing 𝒮]` (which includes the internal
direct-sum decomposition `S = ⨁ d, 𝒮 d`).  Nonnegativity of the grading is
imposed as a separate hypothesis `∀ d < 0, 𝒮 d = ⊥`.  The degree-zero ring is
`↥(𝒮 0)`.

`M` is a finite `S`-module, graded by `ℤ` via `ℳ : ℤ → AddSubgroup M` with
`[SetLike.GradedSMul 𝒮 ℳ]` (the compatibility `S_d · M_n ⊆ M_{n+d}`) and
`[DirectSum.Decomposition ℳ]` (the internal direct-sum decomposition
`M = ⨁ n, ℳ n`).  Each `↥(ℳ n)` is an `↥(𝒮 0)`-module via `gradePieceModule`. -/
variable {S M : Type u}
variable [CommRing S] [IsNoetherianRing S]
variable (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
variable [AddCommGroup M] [Module S M] [Module.Finite S M]
variable (ℳ : ℤ → AddSubgroup M)
variable [SetLike.GradedSMul 𝒮 ℳ] [DirectSum.Decomposition ℳ]

omit [IsNoetherianRing S] [GradedRing 𝒮] [Module.Finite S M] [DirectSum.Decomposition ℳ] in
/-- Degree-shift for the graded scalar action: `S_d · M_j ⊆ M_{d+j}`. -/
theorem gp_hsmul_mem (d j : ℤ) (s : S) (hs : s ∈ 𝒮 d) (m : M) (hm : m ∈ ℳ j) :
    s • m ∈ ℳ (d + j) :=
  SetLike.GradedSMul.smul_mem hs hm

omit [IsNoetherianRing S] [GradedRing 𝒮] in
/-- **Base case (Stacks 00K1).** If the degree-one part `S_1` is trivial, then —
since `S_+` is generated in degree `1` — the irrelevant ideal `S_+` is zero, so
`S = S_0` and every positive-degree piece `S_d` (`d ≥ 1`) vanishes. A finite
graded `S = S_0`-module is concentrated in finitely many degrees, hence
`M_n = 0` for `n ≫ 0`; thus the Hilbert function is eventually `0`.

RIGOROUS ARGUMENT. `GeneratedInDegreeOne 𝒮` gives `S_+ = Ideal.span (𝒮 1)`.
If `𝒮 1 = ⊥` then `S_+ = 0`, so for every `d ≥ 1` we have `S_d ⊆ S_+ = 0`, i.e.
`𝒮 d = ⊥`. Combined with `hneg` (`𝒮 d = ⊥` for `d < 0`), the ring is supported
only in degree `0`. `M` is generated by finitely many homogeneous elements (cf.
`module_homogeneous_generators` from `gradedPiece_finite`); since `S_d · M_n ⊆
M_{n+d}` and `S_d = 0` for `d ≠ 0`, the `S`-submodule generated by a homogeneous
element of degree `e` lives entirely in degree `e`. Hence `M = ⊕_{e ∈ D} M_e`
for the finite set `D` of generator degrees, so `M_n = 0` for `n ∉ D`, in
particular for `n` larger than `max D`.

Natural decomposition: split off
`Sd_bot_of_S1_bot : 𝒮 1 = ⊥ → ∀ d, 1 ≤ d → 𝒮 d = ⊥` and the eventual-vanishing
`Mn_eventually_bot`. -/
theorem Sd_bot_of_S1_bot (hgen : GeneratedInDegreeOne 𝒮) (hS1 : 𝒮 1 = ⊥) :
    ∀ d : ℤ, 1 ≤ d → 𝒮 d = ⊥ := by
  -- The irrelevant ideal is ⊥.
  have hbot : irrelevantIdeal 𝒮 = ⊥ := by
    rw [hgen]
    have : (𝒮 1 : Set S) = {0} := Set.ext fun x => by simp [hS1]
    rw [this, Ideal.span_singleton_eq_bot.mpr rfl]
  intro d hd
  rw [eq_bot_iff]
  intro s hs
  have hsmem : s ∈ irrelevantIdeal 𝒮 := Ideal.subset_span ⟨d, by omega, hs⟩
  rw [hbot] at hsmem
  simpa using hsmem

omit [IsNoetherianRing S] in
/-- Every element of `S` lies in the degree-zero piece when all other graded
pieces vanish. -/
theorem mem_grade_zero (hS0 : ∀ d : ℤ, d ≠ 0 → 𝒮 d = ⊥) (s : S) : s ∈ 𝒮 0 := by
  classical
  have hsum := DirectSum.sum_support_decompose 𝒮 s
  rw [← hsum]
  apply AddSubgroup.sum_mem
  intro d hd
  by_cases hd0 : d = 0
  · subst hd0; exact (DirectSum.decompose 𝒮 s 0).property
  · have hmem : ((DirectSum.decompose 𝒮 s d : 𝒮 d) : S) ∈ 𝒮 d :=
      (DirectSum.decompose 𝒮 s d).property
    have hz : ((DirectSum.decompose 𝒮 s d : 𝒮 d) : S) = 0 := by
      have hsub : (𝒮 d : AddSubgroup S) = ⊥ := hS0 d hd0
      simp only [hsub, AddSubgroup.mem_bot] at hmem; exact hmem
    rw [hz]; exact AddSubgroup.zero_mem _

omit [IsNoetherianRing S] [GradedRing 𝒮] [Module.Finite S M] [DirectSum.Decomposition ℳ] in
/-- A degree-zero scalar preserves the homogeneous degree of a module element. -/
theorem smul_mem_grade (s : S) (hs : s ∈ 𝒮 0) (j : ℤ) (m : M) (hm : m ∈ ℳ j) : s • m ∈ ℳ j := by
  simpa using gp_hsmul_mem 𝒮 ℳ 0 j s hs m hm

omit [IsNoetherianRing S] [Module.Finite S M] in
/-- If `x` has homogeneous support contained in a finite set `D` and the ring is
concentrated in degree `0`, then `s • x` also has support in `D` (multiplication
by a scalar does not move the degrees). -/
theorem decompose_smul_eq_zero_of_not_mem (hS0 : ∀ d : ℤ, d ≠ 0 → 𝒮 d = ⊥) (D : Finset ℤ) (s : S)
    (x : M) (hx : ∀ k : ℤ, k ∉ D → (DirectSum.decompose ℳ x k : M) = 0) (k : ℤ) (hk : k ∉ D) :
    (DirectSum.decompose ℳ (s • x) k : M) = 0 := by
  classical
  have hs0 : s ∈ 𝒮 0 := mem_grade_zero 𝒮 hS0 s
  rw [coe_decompose_smul_eq_sum]
  apply Finset.sum_eq_zero
  intro j hj
  have hjk : j ≠ k := by
    rintro rfl
    exact coe_decompose_ne_zero ℳ hj (hx j (fun hjD => hk hjD))
  exact DirectSum.decompose_of_mem_ne ℳ
    (smul_mem_grade 𝒮 ℳ s hs0 j _ (DirectSum.decompose ℳ x j).property) hjk

omit [IsNoetherianRing S] in
/-- **Eventual vanishing of `M_n`.** When the ring is concentrated in degree `0`
(every `𝒮 d` with `d ≠ 0` is trivial), a finite graded `S`-module is supported in
finitely many degrees, so `M_n = ⊥` for `n` large. -/
@[sga "6 VI 1.5.1" "partial"]
theorem Mn_eventually_bot (hS0 : ∀ d : ℤ, d ≠ 0 → 𝒮 d = ⊥) : ∀ᶠ n in Filter.atTop, ℳ n = ⊥ := by
  classical
  obtain ⟨t, ht⟩ := (Module.Finite.fg_top : (⊤ : Submodule S M).FG)
  set D : Finset ℤ := t.biUnion (fun x => (DirectSum.decompose ℳ x).support) with hD
  have hkey : ∀ n : ℤ, n ∉ D → ℳ n = ⊥ := by
    intro n hn
    rw [eq_bot_iff]
    intro y hy
    have hytop : y ∈ (⊤ : Submodule S M) := Submodule.mem_top
    rw [← ht] at hytop
    have hC :
      ∀ x ∈ Submodule.span S (t : Set M),
        ∀ k : ℤ, k ∉ D → (DirectSum.decompose ℳ x k : M) = 0 := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · intro z hz k hk
        have hzD : (DirectSum.decompose ℳ z).support ⊆ D := by
          intro i hi
          rw [hD]
          exact Finset.mem_biUnion.mpr ⟨z, hz, hi⟩
        have hknz : k ∉ (DirectSum.decompose ℳ z).support := fun h => hk (hzD h)
        simp only [DFinsupp.mem_support_toFun, ne_eq, not_not] at hknz
        rw [hknz]; rfl
      · intro k hk; simp
      · intro a b _ _ ha hb k hk
        have hadd :
          (DirectSum.decompose ℳ (a + b) k : M) =
            (DirectSum.decompose ℳ a k : M) + (DirectSum.decompose ℳ b k : M) := by
          rw [DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add]
        rw [hadd, ha k hk, hb k hk, add_zero]
      · intro s a _ ha k hk
        exact decompose_smul_eq_zero_of_not_mem 𝒮 ℳ hS0 D s a ha k hk
    have hyn := hC y hytop n hn
    rw [DirectSum.decompose_of_mem_same ℳ hy] at hyn
    rw [AddSubgroup.mem_bot]; exact hyn
  rw [Filter.eventually_atTop]
  by_cases hDe : D.Nonempty
  · refine ⟨D.max' hDe + 1, ?_⟩
    intro n hn
    apply hkey
    intro hnD
    have hle : n ≤ D.max' hDe := Finset.le_max' D n hnD
    omega
  · rw [Finset.not_nonempty_iff_eq_empty] at hDe
    refine ⟨0, ?_⟩
    intro n _
    apply hkey
    rw [hDe]; simp

/-- If the irrelevant ideal is generated in degree one and `𝒮 1 = ⊥`, then the ring is
concentrated in degree `0` and the Hilbert function vanishes for large `n`. -/
theorem hilbertFun_eventually_zero_of_S1_bot (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥)
    (hgen : GeneratedInDegreeOne 𝒮) (hS1 : 𝒮 1 = ⊥) :
    ∀ᶠ n in Filter.atTop, hilbertFun 𝒮 ℳ hneg n = 0 := by
  -- The ring is concentrated in degree 0: 𝒮 d = ⊥ for d ≠ 0.
  have hSd : ∀ d : ℤ, 1 ≤ d → 𝒮 d = ⊥ := Sd_bot_of_S1_bot 𝒮 hgen hS1
  have hS0 : ∀ d : ℤ, d ≠ 0 → 𝒮 d = ⊥ := by
    intro d hd
    rcases lt_or_gt_of_ne hd with h | h
    · exact hneg d h
    · exact hSd d (by omega)
  -- Hence M_n = ⊥ for n large.
  have hM := Mn_eventually_bot 𝒮 ℳ hS0
  filter_upwards [hM] with n hn
  -- when ℳ n = ⊥, the graded piece is subsingleton, so its class is 0.
  have hsub : Subsingleton ↥(ℳ n) := by
    rw [hn]
    infer_instance
  show (gradedFinModule 𝒮 ℳ hneg n).cls = 0
  have : Subsingleton (gradedFinModule 𝒮 ℳ hneg n).carrier := hsub
  exact FinModule.cls_zero_of_subsingleton (gradedFinModule 𝒮 ℳ hneg n)

end Main
