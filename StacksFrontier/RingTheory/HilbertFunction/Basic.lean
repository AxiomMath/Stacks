/-! ## The Grothendieck group `K'_0(R)` of finite modules

`Mathlib` has `Algebra.GrothendieckGroup`, but that is merely the group
completion of a commutative monoid and does *not* impose the short-exact-sequence
relations.  The Grothendieck group `K'_0(R)` of finitely generated modules is
therefore constructed by hand here. -/

/-- A bundled finitely generated `R`-module (with carrier in a fixed universe). -/
structure FinModule (R : Type u) [Ring R] where
  /-- The underlying carrier type. -/
  carrier : Type u
  [addCommGroup : AddCommGroup carrier]
  [module : Module R carrier]
  [finite : Module.Finite R carrier]

namespace FinModule

attribute [instance] FinModule.addCommGroup FinModule.module FinModule.finite

variable (R : Type u) [Ring R]

/-- The generating relations defining `K'_0(R)`: isomorphic modules are
identified, and a short exact sequence `0 → N' → N → N'' → 0` yields the relation
`[N] - [N'] - [N''] = 0`. -/
inductive Rel : FreeAbelianGroup (FinModule R) → Prop
  |
  iso (N N' : FinModule R) (e : N.carrier ≃ₗ[R] N'.carrier) :
    Rel (FreeAbelianGroup.of N - FreeAbelianGroup.of N')
  |
  ses (N N' N'' : FinModule R) (f : N'.carrier →ₗ[R] N.carrier) (g : N.carrier →ₗ[R] N''.carrier)
    (hf : Function.Injective f) (hg : Function.Surjective g)
    (hexact : LinearMap.range f = LinearMap.ker g) :
    Rel (FreeAbelianGroup.of N - FreeAbelianGroup.of N' - FreeAbelianGroup.of N'')

/-- The subgroup of relations generated by `FinModule.Rel`. -/
def relSubgroup : AddSubgroup (FreeAbelianGroup (FinModule R)) :=
  AddSubgroup.closure {x | Rel R x}

end FinModule

/-- The Grothendieck group `K'_0(R)` of finite `R`-modules. -/
@[sga "6 0 3.1" "(X), special case",
  sga "6 IV 2.2" "special case",
  sga "6 X 1.1" "(X), special case"]
def KPrime0 (R : Type u) [Ring R] :=
  FreeAbelianGroup (FinModule R) ⧸ FinModule.relSubgroup R

namespace KPrime0

/-- `K'_0(R)` is an additive commutative group, inherited from the quotient. -/
instance (R : Type u) [Ring R] : AddCommGroup (KPrime0 R) := by
  unfold KPrime0; infer_instance

end KPrime0

/-- The class `[N] ∈ K'_0(R)` of a finite `R`-module. -/
@[sga "6 X 1.1" "(F), special case"]
def FinModule.cls {R : Type u} [Ring R] (N : FinModule R) : KPrime0 R :=
  QuotientAddGroup.mk (FreeAbelianGroup.of N)

/-! ### Correctness statements characterizing `K'_0(R)` -/

/-- Correctness (isomorphism invariance): isomorphic finite modules have equal
classes in `K'_0(R)`. -/
theorem FinModule.cls_eq_of_linearEquiv {R : Type u} [Ring R] (N N' : FinModule R)
    (e : N.carrier ≃ₗ[R] N'.carrier) : N.cls = N'.cls := by
  unfold FinModule.cls
  rw [← sub_eq_zero, ← QuotientAddGroup.mk_sub, QuotientAddGroup.eq_zero_iff]
  exact AddSubgroup.subset_closure (FinModule.Rel.iso N N' e)

/-- Correctness (additivity): a short exact sequence `0 → N' → N → N'' → 0` of
finite `R`-modules induces `[N] = [N'] + [N'']` in `K'_0(R)`. -/
theorem FinModule.cls_add_of_ses {R : Type u} [Ring R] (N N' N'' : FinModule R)
    (f : N'.carrier →ₗ[R] N.carrier) (g : N.carrier →ₗ[R] N''.carrier) (hf : Function.Injective f)
    (hg : Function.Surjective g) (hexact : LinearMap.range f = LinearMap.ker g) :
    N.cls = N'.cls + N''.cls := by
  unfold FinModule.cls
  rw [← sub_eq_zero, ← QuotientAddGroup.mk_add, ← QuotientAddGroup.mk_sub,
    QuotientAddGroup.eq_zero_iff]
  have hmem :
    FreeAbelianGroup.of N - FreeAbelianGroup.of N' - FreeAbelianGroup.of N'' ∈
      FinModule.relSubgroup R :=
    AddSubgroup.subset_closure (FinModule.Rel.ses N N' N'' f g hf hg hexact)
  have :
    FreeAbelianGroup.of N - (FreeAbelianGroup.of N' + FreeAbelianGroup.of N'') =
      FreeAbelianGroup.of N - FreeAbelianGroup.of N' - FreeAbelianGroup.of N'' := by
    abel
  rw [this]
  exact hmem

/-- A finite `R`-module with trivial (subsingleton) carrier has class `0` in
`K'_0(R)`: apply additivity to the short exact sequence `0 → N → N → N → 0` with
zero maps, giving `[N] = [N] + [N]`, hence `[N] = 0`. -/
theorem FinModule.cls_zero_of_subsingleton {R : Type u} [Ring R] (N : FinModule R)
    [Subsingleton N.carrier] : N.cls = 0 := by
  have h :=
    FinModule.cls_add_of_ses N N N (0 : N.carrier →ₗ[R] N.carrier) (0 : N.carrier →ₗ[R] N.carrier)
      ?_ ?_ ?_
  · have hsum : N.cls + N.cls = N.cls := h.symm
    simpa using add_right_cancel (a := N.cls) (b := N.cls) (c := 0) (by simpa using hsum)
  · intro a b _; exact Subsingleton.elim a b
  · intro a; exact ⟨0, Subsingleton.elim _ _⟩
  · ext x; simp [Subsingleton.elim x 0]

/-- Correctness (universal property — existence): for any abelian group `A`, an
additive function on finite `R`-modules (an assignment `N ↦ a N` that is
isomorphism invariant and satisfies `a N = a N' + a N''` for short exact
sequences) factors through a group homomorphism `K'_0(R) → A`. -/
theorem KPrime0.universalProperty_existence {R : Type u} [Ring R] {A : Type*} [AddCommGroup A]
    (a : FinModule R → A)
    (hiso : ∀ (N N' : FinModule R), (N.carrier ≃ₗ[R] N'.carrier) → a N = a N')
    (hses :
      ∀ (N N' N'' : FinModule R) (f : N'.carrier →ₗ[R] N.carrier)
        (g : N.carrier →ₗ[R] N''.carrier),
        Function.Injective f →
          Function.Surjective g → LinearMap.range f = LinearMap.ker g → a N = a N' + a N'') :
    ∃ φ : KPrime0 R →+ A, ∀ N : FinModule R, φ N.cls = a N := by
  -- Lift `a` to a hom out of the free abelian group.
  let F : FreeAbelianGroup (FinModule R) →+ A := FreeAbelianGroup.lift a
  -- Show the relation subgroup is contained in the kernel of `F`.
  have hker : FinModule.relSubgroup R ≤ F.ker := by
    unfold FinModule.relSubgroup
    rw [AddSubgroup.closure_le]
    intro x hx
    simp only [SetLike.mem_coe, AddMonoidHom.mem_ker]
    cases hx with
    | iso N N' e =>
      simp only [F, map_sub, FreeAbelianGroup.lift_apply_of, sub_eq_zero]
      exact hiso N N' e
    | ses N N' N'' f g hf hg hexact =>
      simp only [F, map_sub, FreeAbelianGroup.lift_apply_of, sub_eq_zero]
      rw [hses N N' N'' f g hf hg hexact, add_sub_cancel_left]
  -- Descend to the quotient.
  refine ⟨QuotientAddGroup.lift (FinModule.relSubgroup R) F hker, fun N => ?_⟩
  change
    QuotientAddGroup.lift (FinModule.relSubgroup R) F hker
        (QuotientAddGroup.mk (FreeAbelianGroup.of N)) =
      a N
  rw [QuotientAddGroup.lift_mk']
  simp only [F, FreeAbelianGroup.lift_apply_of]

/-- Correctness (universal property — uniqueness): a group homomorphism out of
`K'_0(R)` is determined by its values on the classes `[N]`.  Together with
`KPrime0.universalProperty_existence` this expresses that additive functions on
finite `R`-modules correspond *bijectively* to group homomorphisms
`K'_0(R) → A`. -/
theorem KPrime0.hom_ext {R : Type u} [Ring R] {A : Type*} [AddCommGroup A] (φ ψ : KPrime0 R →+ A)
    (h : ∀ N : FinModule R, φ N.cls = ψ N.cls) : φ = ψ := by
  ext x
  obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective (FinModule.relSubgroup R) x
  -- y : FreeAbelianGroup (FinModule R)
  have key :
    (φ.comp (QuotientAddGroup.mk' (FinModule.relSubgroup R))) =
      (ψ.comp (QuotientAddGroup.mk' (FinModule.relSubgroup R))) :=
    FreeAbelianGroup.lift_ext _ _ h
  exact DFunLike.congr_fun key y

/-! ## Numerical polynomials -/

open Filter in
/-- A function `f : ℤ → A` valued in an abelian group `A` is a *numerical
polynomial* if there exist `r : ℕ` and coefficients `a : ℕ → A` such that for all
sufficiently large `n`,
`f n = ∑_{i=0}^{r} binom(n,i) • (a i)`, where `binom(n,i) = Ring.choose n i ∈ ℤ`
is the generalized binomial coefficient `n(n-1)⋯(n-i+1)/i!`, acting via the
integer action `zsmul`. -/
def IsEventualNumericalPolynomial {A : Type*} [AddCommGroup A] (f : ℤ → A) : Prop :=
  ∃ (r : ℕ) (a : ℕ → A),
    ∀ᶠ n in atTop, f n = ∑ i ∈ Finset.range (r + 1), (Ring.choose (n : ℤ) i) • a i

/-! ### Closure properties of numerical polynomials

These two facts about numerical polynomials are purely combinatorial (they only
involve the generalized binomial coefficients `Ring.choose` and finite sums in an
abelian group) and are completely independent of the graded-ring theory.  They
are the engine that converts the inductive step's "first difference is a
numerical polynomial" conclusion into the desired statement for `φ` itself. -/

open Filter in
/-- A function that is eventually zero is a numerical polynomial (take `r = 0`,
`a ≡ 0`). This is the base-case packaging: when `M_n = 0` for `n ≫ 0`, the
Hilbert function is the zero numerical polynomial.  PROVED. -/
theorem numpoly_of_eventually_zero {A : Type*} [AddCommGroup A] (f : ℤ → A)
    (h : ∀ᶠ n in atTop, f n = 0) : IsEventualNumericalPolynomial f := by
  refine ⟨0, (fun _ => 0), ?_⟩
  filter_upwards [h] with n hn
  simp [hn]

open Filter in
/-- A numerical polynomial plus a (pointwise eventual) constant is a numerical
polynomial: if `f` is a numerical polynomial then so is `n ↦ f n + c`, since the
constant `c` is `Ring.choose n 0 • c` (`Ring.choose n 0 = 1`).  Used to absorb the
integration constant in `numpoly_of_diff`.

PROOF STRATEGY (Mathlib-closable): given `f n = ∑_{i≤r} choose(n,i) • a i` for
`n ≫ 0`, set `a' 0 := a 0 + c` and `a' i := a i` for `i ≥ 1`; then for `n ≫ 0`,
`f n + c = ∑_{i≤r} choose(n,i) • a' i` because `choose(n,0) = 1`
(`Ring.choose_zero_right`) so the `i = 0` term picks up the extra `c`. Split the
range-sum off the `0` term with `Finset.sum_range_succ'` / `Finset.range_eq_Ico`,
or just `Finset.sum_congr` after rewriting `a'`. -/
theorem numpoly_add_const {A : Type*} [AddCommGroup A] (f : ℤ → A) (c : A)
    (hf : IsEventualNumericalPolynomial f) : IsEventualNumericalPolynomial (fun n => f n + c) := by
  obtain ⟨r, a, ha⟩ := hf
  refine ⟨r, (fun i => if i = 0 then a 0 + c else a i), ?_⟩
  filter_upwards [ha] with n hn
  rw [hn]
  rw [Finset.sum_range_succ' _ r, Finset.sum_range_succ' _ r]
  simp only [Ring.choose_zero_right, one_zsmul, Nat.succ_ne_zero, ite_false, ite_true]
  rw [add_assoc]

/-- If `P` holds eventually, then so does `n ↦ P (n + c)`. -/
private theorem eventually_atTop_add_const {P : ℤ → Prop} (h : ∀ᶠ n in Filter.atTop, P n) (c : ℤ) :
    ∀ᶠ n in Filter.atTop, P (n + c) :=
  (Filter.tendsto_atTop_add_const_right Filter.atTop c Filter.tendsto_id).eventually h

open Filter in
/-- Shifting the argument by `+1` preserves the numerical-polynomial property.
Re-expand each `Ring.choose (n+1) i` via Pascal's rule `Ring.choose_succ_succ`
(a finite triangular recombination of the coefficients). -/
theorem numpoly_shift {A : Type*} [AddCommGroup A] (p : ℤ → A)
    (h : IsEventualNumericalPolynomial p) :
    IsEventualNumericalPolynomial (fun n => p (n + 1)) := by
  obtain ⟨r, a, ha⟩ := h
  refine ⟨r, (fun j => a j + (if j < r then a (j + 1) else 0)), ?_⟩
  filter_upwards [eventually_atTop_add_const ha 1] with n hn
  rw [hn]
  have key :
    ∑ i ∈ Finset.range (r + 1), Ring.choose (n + 1) i • a i =
      (∑ j ∈ Finset.range (r + 1), Ring.choose n j • a j) +
        (∑ i ∈ Finset.range r, Ring.choose n i • a (i + 1)) := by
    rw [Finset.sum_range_succ' (fun i => Ring.choose (n + 1) i • a i) r]
    rw [Finset.sum_range_succ' (fun j => Ring.choose n j • a j) r]
    simp only [Ring.choose_zero_right, one_smul]
    rw [add_assoc, add_comm (a 0), ← add_assoc]
    congr 1
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [Ring.choose_succ_succ n i, add_smul]; abel
  rw [key]
  rw [show
      (∑ j ∈ Finset.range (r + 1), Ring.choose n j • (a j + if j < r then a (j + 1) else 0)) =
        (∑ j ∈ Finset.range (r + 1), Ring.choose n j • a j) +
          (∑ j ∈ Finset.range (r + 1), Ring.choose n j • (if j < r then a (j + 1) else 0))
      from by
      rw [← Finset.sum_add_distrib]; apply Finset.sum_congr rfl; intro i _; rw [smul_add]]
  congr 1
  rw [Finset.sum_range_succ (fun j => Ring.choose n j • (if j < r then a (j + 1) else 0)) r]
  simp only [lt_irrefl, ite_false, smul_zero, add_zero]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  rw [ite_eq_left hi]

/-- Negation preserves numerical polynomials (negate the coefficient family). -/
theorem numpoly_neg {A : Type*} [AddCommGroup A] (p : ℤ → A)
    (h : IsEventualNumericalPolynomial p) : IsEventualNumericalPolynomial (fun n => -p n) := by
  obtain ⟨r, a, ha⟩ := h
  refine ⟨r, (fun j => -a j), ?_⟩
  filter_upwards [ha] with n hn
  rw [hn]
  simp only [smul_neg]
  rw [Finset.sum_neg_distrib]

/-- Pascal's rule in the form `choose (n + 1) (i + 1) - choose n (i + 1) = choose n i`. -/
private theorem choose_succ_sub_choose (n : ℤ) (i : ℕ) :
    Ring.choose (n + 1) (i + 1) - Ring.choose n (i + 1) = Ring.choose n i := by
  rw [Ring.choose_succ_succ]; abel

/-- Dropping a term past the end of a range: the `if i = k` modification is invisible
on `range m` when `m ≤ k`. -/
private theorem sum_range_smul_ite_of_le {A : Type*} [AddCommGroup A] (f : ℕ → ℤ) (a : ℕ → A)
    (x : A) {m k : ℕ} (hmk : m ≤ k) :
    ∑ i ∈ Finset.range m, f i • (if i = k then x else a i) = ∑ i ∈ Finset.range m, f i • a i := by
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [ite_eq_right_iff.mpr fun h => absurd h (by have := Finset.mem_range.mp hi; omega)]

/-- Down-shift by one preserves numerical polynomials: `p` numerical ⇒ `n ↦ p (n-1)`
numerical. Analogue of `numpoly_shift` (which does `n ↦ p (n+1)`); same Pascal
`Ring.choose_succ_succ` recombination of coefficients (here in the downward direction).
Mathlib hints: `Ring.choose_succ_succ`, `Finset.sum_range_succ'`,
`tendsto_atTop_add_const_right atTop (-1)`. -/
theorem numpoly_shift_down {A : Type*} [AddCommGroup A] (p : ℤ → A)
    (h : IsEventualNumericalPolynomial p) :
    IsEventualNumericalPolynomial (fun n => p (n - 1)) := by
  obtain ⟨r, a, ha⟩ := h
  -- Key combinatorial fact: the down-shifted sum is again a range-sum, with
  -- transformed coefficients.  Proved by induction on the degree `R`, peeling the
  -- top term and using Pascal's rule `choose (n-1) (R+1) = choose n (R+1) - choose (n-1) R`.
  have key :
    ∀ (R : ℕ) (a : ℕ → A),
      ∃ c : ℕ → A,
        ∀ n : ℤ,
          ∑ i ∈ Finset.range (R + 1), Ring.choose ((n : ℤ) - 1) i • a i =
            ∑ j ∈ Finset.range (R + 1), Ring.choose (n : ℤ) j • c j := by
    intro R
    induction R with
    | zero =>
      intro a
      refine ⟨a, ?_⟩
      intro n
      simp []
    | succ R ih =>
      intro a
      -- coefficients fed to IH: same as `a` except the top one absorbs `- a (R+1)`.
      obtain ⟨c', hc'⟩ := ih (fun i => if i = R then a R - a (R + 1) else a i)
      refine ⟨fun j => if j = R + 1 then a (R + 1) else c' j, ?_⟩
      intro n
      -- peel the top term i = R+1 from the LHS
      rw [Finset.sum_range_succ (fun i => Ring.choose ((n : ℤ) - 1) i • a i) (R + 1)]
      -- Pascal: choose (n-1) (R+1) = choose n (R+1) - choose (n-1) R
      have hpascal :
        Ring.choose ((n : ℤ) - 1) (R + 1) =
          Ring.choose (n : ℤ) (R + 1) - Ring.choose ((n : ℤ) - 1) R := by
        have := choose_succ_sub_choose ((n : ℤ) - 1) R
        rw [sub_add_cancel] at this
        linarith
      rw [hpascal, sub_smul]
      -- Now LHS = (∑_{i<R+1} choose(n-1) i • a i) + (choose n (R+1) • a(R+1) - choose(n-1) R •
      -- a(R+1))
      -- rewrite the inner sum to match the IH input
      have hsum_eq :
        ∑ i ∈ Finset.range (R + 1), Ring.choose ((n : ℤ) - 1) i • a i =
          (∑ i ∈ Finset.range (R + 1),
              Ring.choose ((n : ℤ) - 1) i • (if i = R then a R - a (R + 1) else a i)) +
            Ring.choose ((n : ℤ) - 1) R • a (R + 1) := by
        rw [Finset.sum_range_succ (fun i => Ring.choose ((n : ℤ) - 1) i • a i) R]
        rw [Finset.sum_range_succ
            (fun i => Ring.choose ((n : ℤ) - 1) i • (if i = R then a R - a (R + 1) else a i)) R]
        rw [sum_range_smul_ite_of_le _ a _ le_rfl, ite_eq_left rfl, smul_sub]
        abel
      rw [hsum_eq, hc']
      -- peel the top term j = R+1 from the RHS
      rw [Finset.sum_range_succ
          (fun j => Ring.choose (n : ℤ) j • (if j = R + 1 then a (R + 1) else c' j)) (R + 1)]
      simp only []
      rw [sum_range_smul_ite_of_le _ c' _ le_rfl]
      abel
  obtain ⟨c, hc⟩ := key r a
  refine ⟨r, c, ?_⟩
  filter_upwards [eventually_atTop_add_const ha (-1)] with n hn
  rw [← hc n]
  simpa [← sub_eq_add_neg] using hn

open Filter in
/-- The function `m ↦ ∑_{i≤r} choose(m,i+1) • b i` is a numerical polynomial: it is
literally of the required form with shifted coefficients `a 0 = 0`, `a (j+1) = b j`
(via `Finset.sum_range_succ'`). -/
theorem numpoly_succ_index {A : Type*} [AddCommGroup A] (r : ℕ) (b : ℕ → A) :
    IsEventualNumericalPolynomial
      (fun m => ∑ i ∈ Finset.range (r + 1), Ring.choose m (i + 1) • b i) := by
  refine ⟨r + 1, (fun j => if j = 0 then 0 else b (j - 1)), ?_⟩
  filter_upwards with n
  rw [Finset.sum_range_succ' (fun j => Ring.choose n j • (if j = 0 then (0 : A) else b (j - 1)))
      (r + 1)]
  simp only [Nat.add_sub_cancel, Nat.succ_ne_zero, ite_false, ite_true, Ring.choose_zero_right,
    smul_zero, add_zero]

open Filter in
/-- **Stacks Lemma 10.58.5 (Tag 00JV / numerical-polynomial integration).**
If the first difference `n ↦ f n - f (n-1)` is a numerical polynomial, then so is
`f`.  This is the combinatorial heart that "integrates" the inductive step.

RIGOROUS ARGUMENT.  Suppose `f n - f (n-1) = ∑_{i=0}^{r} choose(n,i) • b i` for
all `n ≥ N`.  The key binomial identity (Pascal's rule, `Ring.choose_succ_succ`
in the form `choose(n, i+1) - choose(n-1, i+1) = choose(n-1, i)`, equivalently
after re-indexing `choose(n+1,i+1) - choose(n,i+1) = choose(n,i)`) shows that the
*difference operator* `Δ` sends `n ↦ choose(n, i+1)` to `n ↦ choose(n-1, i)`.
A second application of the same identity, summed/telescoped, shows more usefully
that `Δ (n ↦ choose(n, i+1)) = (n ↦ choose(n, i))` *up to* a numerical polynomial
of strictly smaller degree; iterating, the ℤ-span of `{n ↦ choose(n,i)}_{i≤r+1}`
is closed under `Δ` and `Δ` is "upper triangular with unit shift" on this basis.
Concretely: define `g n := ∑_{i=0}^{r+1} choose(n,i) • c i` where the `c i` are
obtained by back-substitution so that `Δ g = Δ f` on `[N, ∞)` (this is a finite
upper-triangular linear system over `ℤ`, solvable because each `choose(·,i+1)` has
`Δ` equal to `choose(·,i)` plus lower terms with leading coefficient `1`).  Then
`Δ (f - g) = 0` for `n > N`, so `f - g` is eventually constant, say `= e`;
hence `f n = g n + e = ∑_{i=0}^{r+1} choose(n,i) • c i + e` for `n ≫ 0`, and
absorbing `e` into the `i = 0` coefficient via `numpoly_add_const` exhibits `f`
as a numerical polynomial of degree `≤ r+1`.

The cleanest Lean route: prove the single-step basis identity
`Ring.choose (n) (i+1) - Ring.choose (n-1) (i+1) = Ring.choose (n-1) i`
(a rearrangement of `Ring.choose_succ_succ` with `r := n-1`, `k := i`), then
induct on `r` (the degree of the difference). Natural decomposition: this lemma
should be branched into (a) the basis difference identity and (b) the telescoping
induction on `r`. -/
theorem numpoly_of_diff {A : Type*} [AddCommGroup A] (f : ℤ → A)
    (h : IsEventualNumericalPolynomial (fun n => f n - f (n - 1))) :
    IsEventualNumericalPolynomial f := by
  -- incl. negative args; eventual/atTop quantifier benign). Mathlib-tractable,
  -- no ring theory needed.
  obtain ⟨r, b, hb⟩ := h
  obtain ⟨N, hN⟩ := eventually_atTop.mp hb
  -- The "antiderivative": g n := ∑_{i≤r} choose(n+1,i+1) • b i.
  set g : ℤ → A := fun n => ∑ i ∈ Finset.range (r + 1), Ring.choose (n + 1) (i + 1) • b i with hg
  -- Lemma A (Pascal / discrete first difference of g).
  have hA : ∀ n : ℤ, g n - g (n - 1) = ∑ i ∈ Finset.range (r + 1), Ring.choose n i • b i := by
    intro n
    simp only [hg]
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [sub_add_cancel, ← sub_smul, choose_succ_sub_choose]
  -- `f - g` has zero first difference on `[N, ∞)`, hence is eventually constant.
  have hconst : ∀ n : ℤ, N ≤ n → f n - g n = f N - g N := by
    intro n hn
    induction n, hn using Int.leInduction with
    | base => rfl
    | succ m hm
      ih =>
      have hfdiff :
        f (m + 1) - f m = ∑ i ∈ Finset.range (r + 1), Ring.choose (m + 1 : ℤ) i • b i := by
        simpa using hN (m + 1) (by omega)
      have hgdiff :
        g (m + 1) - g m = ∑ i ∈ Finset.range (r + 1), Ring.choose (m + 1 : ℤ) i • b i := by
        have := hA (m + 1)
        rwa [show (m + 1) - 1 = m by ring] at this
      have hdiff : f (m + 1) - f m = g (m + 1) - g m := by rw [hfdiff, hgdiff]
      have hstep : f (m + 1) - g (m + 1) = f m - g m := sub_eq_sub_iff_sub_eq_sub.mp hdiff
      rw [hstep, ih]
  -- `g` is a numerical polynomial (shift of `numpoly_succ_index`).
  have hg_poly : IsEventualNumericalPolynomial g := by
    have h1 := numpoly_succ_index r b
    have h2 := numpoly_shift _ h1
    convert h2 using 1
  -- Absorb the integration constant `e := f N - g N` via `numpoly_add_const`.
  set e : A := f N - g N with he
  have hfg : IsEventualNumericalPolynomial (fun n => g n + e) := numpoly_add_const g e hg_poly
  have hev : ∀ᶠ n : ℤ in atTop, f n = g n + e := by
    rw [eventually_atTop]
    refine ⟨N, ?_⟩
    intro n hn
    have hcn := hconst n hn
    rw [add_comm]
    exact sub_eq_iff_eq_add.mp hcn
  obtain ⟨s, c, hc⟩ := hfg
  refine ⟨s, c, ?_⟩
  filter_upwards [hev, hc] with n h1 h2
  rw [h1, h2]
