/-!
# The module-level induction engine for the Hilbert function

Finite degree-one generation of `S_+`, the base case `S_+ · M = 0`, homogeneity of the
`x`-torsion submodules, the quotient-only induction route, and the per-degree
multiplication-by-`xʳ` maps and their kernels, which enter the four-term sequence.
-/

@[expose] public section
-- needed file-wide: `FinModule.cls_eq_of_linearEquiv`, `FinModule.cls_add_of_ses`,
-- `KPrime0.hom_ext`, `xpow_four_term_class` and `hilbertFun_xpow_step_identity` all rewrite
-- through the `FinModule`/`KPrime0` quotient wrappers and the graded-piece subgroup coercions,
-- which only unfold with defeq transparency relaxed.  See also the note before
-- `section MainPieces`, which depends on this option holding for the whole file.
set_option backward.isDefEq.respectTransparency false
universe u

section Main

variable {S M : Type u}
variable [CommRing S] [IsNoetherianRing S]
variable (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
variable [AddCommGroup M] [Module S M] [Module.Finite S M]
variable (ℳ : ℤ → AddSubgroup M)
variable [SetLike.GradedSMul 𝒮 ℳ] [DirectSum.Decomposition ℳ]

/- **Inductive engine / first-difference is a numerical polynomial (Stacks
00K1, the heart of Prop 10.58.7).** Overview of the decomposition realized below
by `irrelevant_fg_degree_one`, `hilbertDiff_numpoly_aux`, and
`hilbertFun_diff_isNumericalPolynomial`. Under the standing hypotheses, the first
difference `n ↦ φ(n) - φ(n-1)` of the Hilbert function is a numerical polynomial.

RIGOROUS ARGUMENT (induction on the minimal number `k` of `S_0`-module
generators of `S_1`; this lemma is the inductive step, with the *outer* induction
hypothesis being the Main statement for graded modules whose `S_1` needs fewer
generators).
  • If `k = 0`, i.e. `S_1 = ⊥`, the difference is eventually `0` (base case
    `hilbertFun_eventually_zero_of_S1_bot`), hence a numerical polynomial.
  • If `k ≥ 1`, pick `x ∈ S_1` from a minimal generating set.
    – Let `M' ⊆ M` be the largest graded submodule on which multiplication by `x`
      is locally nilpotent (`M' = ⋃_r ker(x^r : M → M)`, a graded `S`-submodule
      because `x` is homogeneous). Using additivity
      `[M_d] = [M'_d] + [(M/M')_d]` in `K'_0(S_0)` (`FinModule.cls_add_of_ses`
      applied to the degreewise-exact `0 → M'_d → M_d → (M/M')_d → 0`), and the
      fact that `M'` is annihilated by a power `x^N` so is a graded module over
      `S/x^N S` — whose `S_1` is generated by `< k` elements — the outer IH makes
      `n ↦ [M'_n]` and its difference numerical polynomials; thus it suffices to
      treat `M/M'`, on which `x` acts INJECTIVELY.
    – Assume now `x : M → M` is injective. Put `M̄ = M/xM`. For each `d`, the
      degree-shifted multiplication-by-`x` and the quotient give a short exact
      sequence of `S_0`-modules
        `0 → M_d --(·x)--> M_{d+1} → M̄_{d+1} → 0`
      (left-exact because `x` is injective; right-exact by definition of `M̄`;
      `·x` lands in degree `d+1` since `x ∈ S_1`). By `FinModule.cls_add_of_ses`,
        `[M_{d+1}] = [M_d] + [M̄_{d+1}]`,  i.e.  `φ(d+1) - φ(d) = [M̄_{d+1}]`.
    – `M̄ = M/xM` is a finite graded module over `S/xS`, whose degree-one part is
      generated by `k - 1` elements. By the outer induction hypothesis (the Main
      statement for `M̄` over `S/xS`), `n ↦ [M̄_n]` is a numerical polynomial; in
      particular `n ↦ [M̄_{n}]`, reindexed, equals `n ↦ φ(n) - φ(n-1)` up to the
      shift handled by `M' `, so the first difference of `φ` is a numerical
      polynomial.

Natural decomposition (each a separate lemma):
  • `xNilpotentSubmodule` and the additivity reduction to `x` injective;
  • `ses_mul_x` : the degree-shift SES `0 → M_d →(·x) M_{d+1} → M̄_{d+1} → 0`;
  • `quotient_graded_over_quotient_ring` : `M/xM` is graded over `S/xS` with
    `S_1` needing one fewer generator (the index for the outer induction);
  • the outer `Nat.strong_induction` on the generator count, which forces this
    lemma to be restated with that count as an explicit parameter and the Main
    theorem proven simultaneously. -/
omit [GradedRing 𝒮] in
/-- **`S_1` is a finite generating set for the irrelevant ideal (degree-1 case).**
Under `GeneratedInDegreeOne 𝒮`, the irrelevant ideal `S_+` is `Ideal.span (𝒮 1)`.
Since `S` is Noetherian, `S_+` is a finitely generated ideal, and one can choose a
finite generating set consisting of degree-one elements (because `𝒮 1` spans `S_+`
and a Noetherian ideal is generated by finitely many elements of any spanning set).
This finite set's cardinality is the induction parameter `k` for Stacks 00K1.

Note: `IsNoetherian.noetherian`/`Ideal.fg_of_isNoetherian` gives an
arbitrary finite generating set `G`; intersect with the degree-one spanning set via
`Submodule.fg_iff_exists_fin_generating_family` / `Ideal.span` membership, expressing
each generator as a finite `S`-combination of elements of `𝒮 1` and collecting those
degree-one elements. Mathlib: `isNoetherian_def`, `Ideal.fg_span_of_finite` is the
wrong direction; the right tool is to start from `IsNoetherianRing` ⇒ `(S_+).FG`
(`IsNoetherian.noetherian` on `Submodule S S`), then refine to degree-one generators
using `Ideal.span (𝒮 1)` membership of each generator (`Submodule.mem_span_finset`). -/
@[ega "II 2.7.6" "more general"]
theorem irrelevant_fg_degree_one (hgen : GeneratedInDegreeOne 𝒮) :
    ∃ t : Finset S, (∀ x ∈ t, x ∈ 𝒮 1) ∧ irrelevantIdeal 𝒮 = Ideal.span (t : Set S) := by
  classical
  -- `hgen` : irrelevantIdeal 𝒮 = Ideal.span (𝒮 1 : Set S).
  -- `S` Noetherian ⟹ this ideal is FG.
  have hfg : (Ideal.span (𝒮 1 : Set S)).FG := IsNoetherian.noetherian _
  obtain ⟨G, hG⟩ := hfg
  -- Each generator g ∈ G lies in span (𝒮 1), hence in span of a finite subset of 𝒮 1.
  have hgmem : ∀ g ∈ G, g ∈ Ideal.span (𝒮 1 : Set S) := by
    intro g hg
    rw [← hG]
    exact Ideal.subset_span hg
  have hfin : ∀ g ∈ G, ∃ tt : Finset S, ↑tt ⊆ (𝒮 1 : Set S) ∧ g ∈ Ideal.span (tt : Set S) := by
    intro g hg
    exact Submodule.mem_span_finite_of_mem_span (hgmem g hg)
  choose! tt htt_sub htt_mem using hfin
  refine ⟨G.biUnion tt, ?_, ?_⟩
  · -- every element of the biUnion is in 𝒮 1
    intro x hx
    rw [Finset.mem_biUnion] at hx
    obtain ⟨g, hg, hxg⟩ := hx
    exact htt_sub g hg hxg
  · -- irrelevantIdeal 𝒮 = Ideal.span (biUnion)
    rw [hgen]
    apply le_antisymm
    · -- span (𝒮 1) = span G ⊆ span (biUnion)
      rw [← hG, Ideal.span_le]
      intro g hg
      refine Ideal.span_mono (fun y hy => ?_) (htt_mem g hg)
      rw [Finset.coe_biUnion, Set.mem_iUnion]
      exact ⟨g, by simpa using ⟨hg, hy⟩⟩
    · -- span (biUnion) ⊆ span (𝒮 1) since biUnion ⊆ 𝒮 1
      rw [Ideal.span_le]
      intro x hx
      rw [Finset.coe_biUnion, Set.mem_iUnion] at hx
      obtain ⟨g, hg⟩ := hx
      rw [Set.mem_iUnion] at hg
      obtain ⟨hgG, hxg⟩ := hg
      exact Ideal.subset_span (htt_sub g hgG hxg)

/- **Generalized inductive engine (Stacks 00K1, Proposition 10.58.7).** (ORIGINAL
base-change outline; SUPERSEDED below by the module-level no-base-change engine.)
The statement is quantified over the graded ring/module data and a bound `k` on the
number of degree-one ideal generators of the irrelevant ideal, so that the outer
induction (on `k`) can recurse through a *different* ring `S/xS` (and module `M/xM`).
The conclusion is that the first difference of the Hilbert function is a numerical
polynomial.

RIGOROUS ARGUMENT — `Nat.strong_induction` on `k`:
  • **Base (`k = 0`).** Then `irrelevantIdeal 𝒮 = Ideal.span ∅ = ⊥`, so in
    particular `𝒮 1 = ⊥` (every element of `𝒮 1` lies in `S_+`). By
    `hilbertFun_eventually_zero_of_S1_bot` the Hilbert function is eventually `0`,
    hence so is its first difference (`numpoly_of_eventually_zero`).
  • **Step (`k = j+1`).** Pick `x` in the generating set `t` (`x ∈ 𝒮 1`).
    – `x`-nilpotent reduction: let `M' = ⋃_r ker (x^r · : M → M)`, the largest
      graded submodule on which `x` is locally nilpotent. The degreewise short exact
      sequences `0 → M'_d → M_d → (M/M')_d → 0` give, via `FinModule.cls_add_of_ses`,
      `[M_d] = [M'_d] + [(M/M')_d]`; `M'` is a module over `S/x^N S` (`x^N M' = 0`)
      whose `S_+` needs `≤ j` degree-one generators, and `M/M'` has `x` acting
      injectively. Both reduce to strictly fewer generators (outer IH) or to the
      injective case.
    – Injective case: with `M̄ = M/xM`, the SES of `S_0`-modules
      `0 → M_d --(·x)--> M_{d+1} → M̄_{d+1} → 0` gives
      `φ(d+1) - φ(d) = [M̄_{d+1}]` (`FinModule.cls_add_of_ses`). `M̄` is a finite
      graded `S/xS`-module whose irrelevant ideal needs `≤ j` degree-one generators,
      so by the outer IH `n ↦ [M̄_n]` has numerical-polynomial first difference; a
      shift identifies `n ↦ φ(n) - φ(n-1)` with (a reindex of) `n ↦ [M̄_n]`.

DECOMPOSITION CANDIDATES (each a separate open-goal lemma to be branched):
  • `xNilpotentSubmodule` + additivity reduction to `x` injective;
  • `ses_mul_x` : the degree-shift SES `0 → M_d →(·x) M_{d+1} → M̄_{d+1} → 0`;
  • `quotient_ring_graded` : `S/xS` is a Noetherian graded ring with `S_+` needing
    one fewer degree-one generator, and `M/xM` is a finite graded `S/xS`-module
    (the base-ring change — the genuine Mathlib gap);
  • the `Nat.strong_induction` wrapper itself. -/

/-! ### Module-level induction engine (NO base-ring change)

There is a genuine Mathlib gap here: constructing the
graded quotient ring `S/xS` (with fresh `GradedRing`, `DirectSum.Decomposition`,
`SetLike.GradedSMul` instances for `M/xM`) is absent from Mathlib and is the only
obstruction to the standard Stacks proof.

KEY INSIGHT: the base-ring change
is AVOIDABLE. Promote the induction parameter from "number of degree-one generators
of the ring ideal `S_+`" to the **module-level invariant**
`S_+ · M = ∑_{x ∈ t} x · M` (in Lean: `irrelevantIdeal 𝒮 • (⊤ : Submodule S M)
= Ideal.span ↑t • (⊤ : Submodule S M)`). This invariant is
  • monotone under quotients (replaces "M/xM is still a graded S/xS-module"), and
  • **drops by one when `x` annihilates the module** (replaces "S/xS has one fewer
    degree-one generator") — because if `x · N = 0` then `x · N = 0` contributes
    nothing to `S_+ · N = x·N + ∑_{y∈t'} y·N = ∑_{y∈t'} y·N`.
Everything stays over the FIXED ring `S`; the only new infrastructure is gradedness
of the `x`-power-torsion submodule and of `x·M`, `M/xM` as graded `S`-modules
(inheriting `DirectSum.Decomposition` from `M`), which needs no new ring.

The engine `hilbertDiff_numpoly_module_aux` carries the module-level invariant and
is proven by strong induction on `k`. `hilbertDiff_numpoly_aux` reduces to it by the
trivial observation that under `GeneratedInDegreeOne` a ring-level degree-one
generating set `t` of `S_+` automatically satisfies the module invariant. -/

/-- The degree-`k` component of a finite sum is the sum of the degree-`k` components. -/
private theorem coe_decompose_sum {ι R σ κ : Type*} [DecidableEq ι] [AddCommMonoid R]
    [SetLike σ R] [AddSubmonoidClass σ R] (ℳ : ι → σ) [DirectSum.Decomposition ℳ]
    (s : Finset κ) (f : κ → R) (k : ι) :
    (DirectSum.decompose ℳ (∑ j ∈ s, f j) k : R) =
      ∑ j ∈ s, (DirectSum.decompose ℳ (f j) k : R) := by
  simp [DirectSum.decompose_sum]

/-- For `s ∈ 𝒮 d`, the degree-`(d+n)` component of `s • m` is `s` times the degree-`n`
component of `m`. -/
private theorem coe_decompose_smul_homog {R N : Type u} [CommRing R] [AddCommGroup N] [Module R N]
    (𝒜 : ℤ → AddSubgroup R) (𝒩 : ℤ → AddSubgroup N) [SetLike.GradedSMul 𝒜 𝒩]
    [DirectSum.Decomposition 𝒩] (d : ℤ) (s : R) (hs : s ∈ 𝒜 d) (m : N) (n : ℤ) :
    (DirectSum.decompose 𝒩 (s • m) (d + n) : N) = s • (DirectSum.decompose 𝒩 m n : N) := by
  classical
  induction m using DirectSum.Decomposition.inductionOn 𝒩 with
  | zero => simp
  | @homogeneous j m =>
    have h := gp_hsmul_mem 𝒜 𝒩 d j s hs _ m.property
    by_cases hjn : j = n
    · subst hjn
      rw [DirectSum.decompose_of_mem_same 𝒩 h, DirectSum.decompose_of_mem_same 𝒩 m.property]
    · rw [DirectSum.decompose_of_mem_ne 𝒩 h (by omega),
        DirectSum.decompose_of_mem_ne 𝒩 m.property hjn, smul_zero]
  | add x y hx hy => simp [smul_add, hx, hy]

omit [IsNoetherianRing S] in
/-- **Module-level base case (Sub-lemma B).** If the irrelevant ideal annihilates
`M` in the sense `S_+ · M = 0`, then every homogeneous piece `M_n` vanishes for
`n` large, so the Hilbert function is eventually `0`.

RIGOROUS ARGUMENT: `S_+ · M = 0` means `S_d · M = 0` for every `d > 0`. `M` is a
finite graded `S`-module, hence generated by finitely many homogeneous elements of
degrees `≤ D` (some `D`). For `n > D`, any `m ∈ M_n` is an `S`-combination
`∑ sᵢ gᵢ` of the generators `gᵢ` (degree `dᵢ ≤ D`); projecting to degree `n` only
the components with coefficient in `S_{n-dᵢ}` survive, and `n - dᵢ > 0` so that
coefficient lies in `S_+`; since `S_+ · M = 0`, `m = 0`. Hence `M_n = ⊥` for `n > D`.
Mathlib hints: `Module.Finite.fg_top`, the support-degree bound as in
`Mn_eventually_bot`, `DirectSum.decompose`, `Submodule.smul_mem_smul`. -/
theorem module_smul_top_eq_bot_eventually_zero (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥)
    (hann : irrelevantIdeal 𝒮 • (⊤ : Submodule S M) = ⊥) : ∀ᶠ n in Filter.atTop, ℳ n = ⊥ := by
  classical
  -- Every positive-degree homogeneous scalar annihilates `M` (from `hann`).
  have hkill : ∀ d : ℤ, 0 < d → ∀ sd : S, sd ∈ 𝒮 d → ∀ m : M, sd • m = 0 := by
    intro d hd sd hsd m
    have hmem : sd ∈ irrelevantIdeal 𝒮 := Ideal.subset_span (Set.mem_ofPred.mpr ⟨d, hd, hsd⟩)
    have hsm : sd • m ∈ irrelevantIdeal 𝒮 • (⊤ : Submodule S M) :=
      Submodule.smul_mem_smul hmem Submodule.mem_top
    rw [hann] at hsm
    rwa [Submodule.mem_bot] at hsm
  -- Variant of `decompose_smul_eq_zero_of_not_mem`: when `x` is supported in `D`,
  -- so is `s • x`.  Positive-degree pieces of `s` annihilate (via `hann`/`hkill`);
  -- negative-degree pieces vanish (via `hneg`); the degree-`0` piece preserves
  -- degree, hence support.
  have hsmulsupp :
    ∀ (D : Finset ℤ) (s : S) (x : M),
      (∀ k : ℤ, k ∉ D → (DirectSum.decompose ℳ x k : M) = 0) →
        ∀ (k : ℤ), k ∉ D → (DirectSum.decompose ℳ (s • x) k : M) = 0 := by
    intro D s x hx k hk
    rw [← DirectSum.sum_support_decompose 𝒮 s, Finset.sum_smul, coe_decompose_sum]
    refine Finset.sum_eq_zero fun d _ => ?_
    have hsdmem := (DirectSum.decompose 𝒮 s d).property
    generalize ((DirectSum.decompose 𝒮 s d : 𝒮 d) : S) = sd at hsdmem ⊢
    by_cases hdpos : 0 < d
    · rw [hkill d hdpos sd hsdmem x]; simp
    · rcases (not_lt.1 hdpos).lt_or_eq with hdneg | rfl
      · rw [hneg d hdneg, AddSubgroup.mem_bot] at hsdmem
        simp [hsdmem]
      · rw [← zero_add k, coe_decompose_smul_homog 𝒮 ℳ 0 sd hsdmem x k, hx k hk, smul_zero]
  obtain ⟨t, ht⟩ := (Module.Finite.fg_top : (⊤ : Submodule S M).FG)
  set D : Finset ℤ := t.biUnion (fun x => (DirectSum.decompose ℳ x).support) with hD
  have hkey : ∀ n : ℤ, n ∉ D → ℳ n = ⊥ := by
    intro n hn
    rw [eq_bot_iff]
    intro y hy
    have hytop : y ∈ (⊤ : Submodule S M) := Submodule.mem_top
    rw [← ht] at hytop
    have hC :
      ∀ x ∈ Submodule.span S (t : Set M),
        ∀ k : ℤ, k ∉ D → (DirectSum.decompose ℳ x k : M) = 0 := by
      intro x hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
      · intro z hz k hk
        have hzD : (DirectSum.decompose ℳ z).support ⊆ D := by
          intro i hi
          rw [hD]
          exact Finset.mem_biUnion.mpr ⟨z, hz, hi⟩
        have hknz : k ∉ (DirectSum.decompose ℳ z).support := fun h => hk (hzD h)
        simp only [DFinsupp.mem_support_toFun, ne_eq, not_not] at hknz
        rw [hknz]; rfl
      · intro k hk; simp
      · intro a b _ _ ha hb k hk
        simp [ha k hk, hb k hk]
      · intro s a _ ha k hk
        exact hsmulsupp D s a ha k hk
    have hyn := hC y hytop n hn
    rw [DirectSum.decompose_of_mem_same ℳ hy] at hyn
    rw [AddSubgroup.mem_bot]; exact hyn
  rw [Filter.eventually_atTop]
  by_cases hDe : D.Nonempty
  · refine ⟨D.max' hDe + 1, ?_⟩
    intro n hn
    apply hkey
    intro hnD
    have hle : n ≤ D.max' hDe := Finset.le_max' D n hnD
    omega
  · rw [Finset.not_nonempty_iff_eq_empty] at hDe
    refine ⟨0, ?_⟩
    intro n _
    apply hkey
    rw [hDe]; simp

omit [IsNoetherianRing S] [GradedRing 𝒮] [Module.Finite S M] in
/-- For a homogeneous scalar `s ∈ 𝒮 d`, the degree-`(d+n)` component of `s • m`
equals `s` times the degree-`n` component of `m`. -/
theorem gp_decompose_smul_homog (d : ℤ) (s : S) (hs : s ∈ 𝒮 d) (m : M) (n : ℤ) :
    (DirectSum.decompose ℳ (s • m) (d + n) : M) = s • (DirectSum.decompose ℳ m n : M) :=
  coe_decompose_smul_homog 𝒮 ℳ d s hs m n

omit [IsNoetherianRing S] [Module.Finite S M] in
/-- **Graded `x`-power-torsion submodule (Sub-lemma C, structural).** For a
homogeneous `x ∈ 𝒮 1`, the set of `x`-power-torsion elements
`{m | ∃ r, x^r • m = 0}` is a graded `S`-submodule of `M`; equivalently it carries
an inherited `DirectSum.Decomposition`. We package only the (homogeneous-closed)
submodule here; gradedness is used to obtain degreewise short exact sequences. -/
theorem xtorsion_isHomogeneous (x : S) (hx : x ∈ 𝒮 1) :
    ∃ N : Submodule S M,
      (∀ m : M, m ∈ N ↔ ∃ r : ℕ, x ^ r • m = 0) ∧
        (∀ m ∈ N, ∀ n : ℤ, (DirectSum.decompose ℳ m n : M) ∈ N) := by
  classical
  refine
    ⟨{  carrier := {m : M | ∃ r : ℕ, x ^ r • m = 0}
        add_mem' := ?_
        zero_mem' := ?_
        smul_mem' := ?_ }, ?_, ?_⟩
  · rintro a b ⟨r, hr⟩ ⟨s, hs⟩
    refine ⟨max r s, ?_⟩
    have ha : x ^ (max r s) • a = 0 := by
      rw [show max r s = (max r s - r) + r by omega, pow_add, mul_smul, hr, smul_zero]
    have hb : x ^ (max r s) • b = 0 := by
      rw [show max r s = (max r s - s) + s by omega, pow_add, mul_smul, hs, smul_zero]
    rw [smul_add, ha, hb, add_zero]
  · exact ⟨0, by rw [pow_zero, one_smul]⟩
  · rintro c a ⟨r, hr⟩
    refine ⟨r, ?_⟩
    rw [smul_comm, hr, smul_zero]
  · intro m
    rfl
  · rintro m ⟨r, hr⟩ n
    refine ⟨r, ?_⟩
    have hxr : x ^ r ∈ 𝒮 r := by simpa using SetLike.pow_mem_graded r hx
    have hkey := gp_decompose_smul_homog 𝒮 ℳ r (x ^ r) hxr m n
    have hzero : (DirectSum.decompose ℳ (x ^ r • m) (r + n) : M) = 0 := by
      rw [hr]; simp
    rw [hzero] at hkey
    exact hkey.symm

/-- **Closure of numerical polynomials under addition.** Purely combinatorial:
pad both coefficient families to the larger degree and add coefficientwise. EASY
(Mathlib-only; mirror `numpoly_add_const`/`numpoly_shift` padding pattern). -/
theorem eventualNumpoly_add {A : Type*} [AddCommGroup A] (f g : ℤ → A)
    (hf : IsEventualNumericalPolynomial f) (hg : IsEventualNumericalPolynomial g) :
    IsEventualNumericalPolynomial (fun n => f n + g n) := by
  obtain ⟨rf, a, ha⟩ := hf
  obtain ⟨rg, b, hb⟩ := hg
  classical
  refine ⟨max rf rg, fun i => (if i ≤ rf then a i else 0) + (if i ≤ rg then b i else 0), ?_⟩
  -- padding helper: a degree-r expansion equals a degree-(max)-expansion with zero-padded coeffs
  have pad :
    ∀ (r : ℕ) (c : ℕ → A),
      r ≤ max rf rg →
        ∀ n : ℤ,
          (∑ i ∈ Finset.range (r + 1), Ring.choose n i • c i) =
            ∑ i ∈ Finset.range (max rf rg + 1), Ring.choose n i • (if i ≤ r then c i else 0) := by
    intro r c hr n
    have hsub : Finset.range (r + 1) ⊆ Finset.range (max rf rg + 1) :=
      Finset.range_subset_range.mpr (Nat.succ_le_succ hr)
    rw [← Finset.sum_subset hsub]
    · apply Finset.sum_congr rfl
      intro i hi
      rw [Finset.mem_range, Nat.lt_succ_iff] at hi
      rw [ite_eq_left hi]
    · intro i _ hni
      rw [Finset.mem_range, Nat.lt_succ_iff] at hni
      rw [ite_eq_right hni, smul_zero]
  filter_upwards [ha, hb] with n hfn hgn
  rw [hfn, hgn]
  rw [pad rf a (le_max_left rf rg) n, pad rg b (le_max_right rf rg) n]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  rw [smul_add]

omit [IsNoetherianRing S] [Module.Finite S M] in
/-- **`x` annihilates `M` ⇒ drop `x` from the module-generation witness.**
If `x • m = 0` for all `m`, then `Ideal.span ↑t • ⊤ = Ideal.span ↑(t.erase x) • ⊤`
as submodules of `M` (the generator `x` contributes nothing to the action). EASY,
pure submodule/ideal algebra (`Submodule.smul_le`, `Submodule.span_smul`,
`Finset.coe_erase`, `Ideal.span` monotonicity; the `x` term is killed by `hxann`). -/
theorem module_inv_drop_annihilator [DecidableEq S] (x : S) (t : Finset S)
    (hxann : ∀ m : M, x • m = (0 : M)) :
    Ideal.span (t : Set S) • (⊤ : Submodule S M) =
      Ideal.span ((t.erase x : Finset S) : Set S) • (⊤ : Submodule S M) := by
  classical
  by_cases hx : x ∈ t
  · have hcoe : (t : Set S) = insert x ((t.erase x : Finset S) : Set S) := by
      rw [Finset.coe_erase, Set.insert_sdiff_singleton, Set.insert_eq_of_mem hx]
    have hxtop : Ideal.span {x} • (⊤ : Submodule S M) = ⊥ := by
      refine le_antisymm ?_ bot_le
      rw [Submodule.smul_le]
      intro r hr n _
      rw [Ideal.mem_span_singleton] at hr
      obtain ⟨c, rfl⟩ := hr
      rw [Submodule.mem_bot, mul_smul, hxann (c • n)]
    rw [hcoe, Ideal.span_insert, Submodule.sup_smul, hxtop, bot_sup_eq]
  · rw [Finset.erase_eq_of_notMem hx]

/- ⛔ DEAD STRATEGY (branch-5, UNSOUND): the additive x-torsion split
`hilbertFun_split_of_xtorsion` + `hilbertDiff_xinjective` + `hilbertDiff_xnilpotent`
required the x-torsion SUBMODULE to inherit the module-generation invariant
(`module_inv_restrict`), which is FALSE (verified counterexample
`S=k[x,y,z]`, `t={y,z}`, `r₀=2`; `e₀∈N` torsion but `x·e₀=ye₁+ze₂ ∉ J·N`).
These three lemmas have been REMOVED from the critical path and replaced by the
SOUND quotient-only route below. -/

/-! ### SOUND quotient-only route (replaces the dead torsion-split)

The inductive step is now proved WITHOUT ever forming the x-power-torsion submodule
and WITHOUT any generation witness on a submodule of `M`. The decisive device
is:

* Four-term degreewise exact sequence for `·xʳ` (`x ∈ 𝒮 1`, raises degree by `r`):
  `0 → (ker xʳ)_n → M_n →^{·xʳ} M_{n+r} → (M/xʳM)_{n+r} → 0`,
  so by `K'_0(S_0)` additivity `[ker xʳ_n] = [M_n] − [M_{n+r}] + [(M/xʳM)_{n+r}]`.
* The kernel chain `ker xʳ` STABILIZES (`M` Noetherian): `ker x^{r₀+1} = ker x^{r₀}`.
  Subtracting the additivity identity at `r₀+1` and `r₀` KILLS the kernel term, giving,
  for all `m ∈ ℤ`,  `Δφ_M(m) = c_{r₀}(m−1) − c_{r₀+1}(m)`, where `c_r := φ_{M/xʳM}`.
* Each `c_r = φ_{M/xʳM}` is the Hilbert function of a QUOTIENT of `M`. It is a numerical
  polynomial because `M/xʳM` has a finite filtration by the graded subquotients
  `P_j := xʲM/x^{j+1}M` (`j = 0..r−1`), each a QUOTIENT of `M` (via `xʲ : M ↠ xʲM ↠ P_j`)
  with `x·P_j = 0`; so `module_inv_quotient` + `module_inv_drop_annihilator` give `P_j` the
  witness `t.erase x` (size `< k`), the strong `IH` gives `Δφ_{P_j}` numerical, and
  `numpoly_of_diff` upgrades to `φ_{P_j}` numerical. Then `φ_{M/xʳM} = Σⱼ φ_{P_j}` (finite
  `K'_0` additivity along the filtration) is numerical (`eventualNumpoly_add`).

No submodule ever needs a witness; the false counterexample is therefore never invoked.
The two new open-goal sub-lemmas below isolate (i) the x-annihilated quotient IH-consumer and
(ii) the four-term/stabilization identity producing the two quotient gradings. -/

/-- **(N1) x-annihilated quotient is numerical (the IH consumer).** Self-quantified
over the graded data so it can be applied to a fresh `S`-module. If `x ∈ 𝒮 1`,
`x ∈ t`, `t.card ≤ k`, `x` annihilates `Q` (`∀ q, x • q = 0`), and `Q` carries the
module-generation invariant with witness `t`, then, given the strong `IH`, the Hilbert
function `φ_Q` itself is a numerical polynomial.

PROOF (clean, no further infra): `x · Q = 0` ⇒ by `module_inv_drop_annihilator` the
invariant holds with `t' = t.erase x`, `|t'| = t.card − 1 < k` (since `x ∈ t`); the
strong `IH` at `m = t'.card` gives `Δφ_Q` numerical; `numpoly_of_diff` (with `Q_n = 0`
for `n ≪ 0`, from `Module.Finite` + nonneg grading) upgrades `Δφ_Q` to `φ_Q`. -/
theorem hilbertFun_xann_quotient_isNumpoly (k : ℕ)
    (IH :
      ∀ m : ℕ,
        m < k →
          ∀ {S M : Type u} [CommRing S] [IsNoetherianRing S] (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
            [AddCommGroup M] [Module S M] [Module.Finite S M] (ℳ : ℤ → AddSubgroup M)
            [SetLike.GradedSMul 𝒮 ℳ] [DirectSum.Decomposition ℳ] (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥)
            (_ : GeneratedInDegreeOne 𝒮) (t : Finset S) (_ : t.card ≤ m) (_ : ∀ x ∈ t, x ∈ 𝒮 1)
            (_ :
              irrelevantIdeal 𝒮 • (⊤ : Submodule S M) =
                Ideal.span (t : Set S) • (⊤ : Submodule S M)),
            IsEventualNumericalPolynomial
              (fun n => hilbertFun 𝒮 ℳ hneg n - hilbertFun 𝒮 ℳ hneg (n - 1))) :
    ∀ {S Q : Type u} [CommRing S] [IsNoetherianRing S] (𝒮 : ℤ → AddSubgroup S) [GradedRing 𝒮]
      [AddCommGroup Q] [Module S Q] [Module.Finite S Q] (𝒬 : ℤ → AddSubgroup Q)
      [SetLike.GradedSMul 𝒮 𝒬] [DirectSum.Decomposition 𝒬] (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥)
      (_ : GeneratedInDegreeOne 𝒮) (x : S) (_ : x ∈ 𝒮 1) (t : Finset S) (_ : x ∈ t)
      (_ : t.card ≤ k) (_ : ∀ y ∈ t, y ∈ 𝒮 1) (_ : ∀ q : Q, x • q = (0 : Q))
      (_ : irrelevantIdeal 𝒮 • (⊤ : Submodule S Q) = Ideal.span (t : Set S) • (⊤ : Submodule S Q)),
      IsEventualNumericalPolynomial (hilbertFun 𝒮 𝒬 hneg) := by
  intro S Q _ _ 𝒮 _ _ _ _ 𝒬 _ _ hneg hgen x hx t hxt hcard ht1 hxann hinv
  classical
  set t' : Finset S := t.erase x with ht'
  have hdrop :
    Ideal.span (t : Set S) • (⊤ : Submodule S Q) =
      Ideal.span ((t' : Finset S) : Set S) • (⊤ : Submodule S Q) :=
    module_inv_drop_annihilator x t hxann
  have hinv' :
    irrelevantIdeal 𝒮 • (⊤ : Submodule S Q) =
      Ideal.span ((t' : Finset S) : Set S) • (⊤ : Submodule S Q) := by
    rw [hinv, hdrop]
  have hcard' : t'.card < k := by
    have he : t'.card = t.card - 1 := Finset.card_erase_of_mem hxt
    have hpos : 1 ≤ t.card := Finset.one_le_card.mpr ⟨x, hxt⟩
    omega
  have ht1' : ∀ y ∈ t', y ∈ 𝒮 1 := fun y hy => ht1 y (Finset.mem_of_mem_erase hy)
  have hdiff := IH t'.card hcard' 𝒮 𝒬 hneg hgen t' (le_refl t'.card) ht1' hinv'
  exact numpoly_of_diff (hilbertFun 𝒮 𝒬 hneg) hdiff

