omit [Module.Finite S M] in
/-- **(N2a) `Ideal.span {xʳ} • ⊤` is a homogeneous submodule of `M`.** For `x ∈ 𝒮 1`,
`xʳ ∈ 𝒮 r`, so every element of `Ideal.span {xʳ} • ⊤` has its graded components again in
the submodule (using `gp_decompose_smul_homog` to move the degree-`r` scalar `xʳ` past the
projection). This is what lets the generic `quotGrading`/`quotDecomposition`/`quotGradedSMul`
bundle equip `M ⧸ (Ideal.span {xʳ} • ⊤)` with its graded `S`-module structure.

PROOF SKETCH: an element of `Ideal.span {xʳ} • ⊤` is a finite sum `∑ cᵢ • (xʳ • mᵢ)`; each
`decompose ℳ (xʳ • m) n` is `xʳ • decompose ℳ m (n-r)` (shifted `gp_decompose_smul_homog`
with `d = r`, `xʳ ∈ 𝒮 r` via `SetLike.pow_mem_graded`), hence again in
`Ideal.span {xʳ} • ⊤`. Use `Submodule.smul_induction_on` / `Submodule.IsHomogeneous`
componentwise membership + `decompose` additivity. Mirror the homogeneity part of
`xtorsion_isHomogeneous`. -/
theorem idealSpanPow_smul_top_homog (x : S) (hx : x ∈ 𝒮 1) (r : ℕ) :
    (Ideal.span {x ^ r} • (⊤ : Submodule S M)).IsHomogeneous ℳ := by
  classical
  intro n m hm
  refine Submodule.smul_induction_on hm ?_ ?_
  · intro a ha b _
    rw [Ideal.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    have hxr : x ^ r ∈ 𝒮 r := by simpa using SetLike.pow_mem_graded r hx
    have hcomm : (x ^ r * c) • b = x ^ r • (c • b) := by rw [mul_smul]
    rw [hcomm]
    have hkey := gp_decompose_smul_homog 𝒮 ℳ r (x ^ r) hxr (c • b) (n - r)
    rw [show (r : ℤ) + (n - r) = n by ring] at hkey
    rw [hkey]
    refine Submodule.smul_mem_smul ?_ Submodule.mem_top
    rw [Ideal.mem_span_singleton]
  · intro y z hy hz
    simpa using Submodule.add_mem _ hy hz

omit [IsNoetherianRing S] [GradedRing 𝒮] [Module.Finite S M] in
/-- **(N2b) The module-generation invariant descends to a homogeneous quotient.**
If `N ⊆ M` is `ℳ`-homogeneous and `M` carries the witness `t`, then so does `M ⧸ N`
(the `module_inv_quotient` of the informal proof). PROOF: for any ideal `I`,
`Submodule.map N.mkQ (I • ⊤_M) = I • Submodule.map N.mkQ ⊤_M = I • ⊤_{M⧸N}` (the last step
because `N.mkQ` is surjective so `Submodule.map N.mkQ ⊤ = ⊤`); apply `Submodule.map N.mkQ`
to both sides of `hinv`. Mathlib: `Submodule.map_smul''`, `Submodule.map_top`,
`Submodule.mkQ_surjective`/`Submodule.range_mkQ`. -/
theorem module_inv_quotient (t : Finset S) (N : Submodule S M)
    (hinv :
      irrelevantIdeal 𝒮 • (⊤ : Submodule S M) = Ideal.span (t : Set S) • (⊤ : Submodule S M)) :
    irrelevantIdeal 𝒮 • (⊤ : Submodule S (M ⧸ N)) =
      Ideal.span (t : Set S) • (⊤ : Submodule S (M ⧸ N)) := by
  have hmap :
    ∀ (I : Ideal S),
      Submodule.map N.mkQ (I • (⊤ : Submodule S M)) = I • (⊤ : Submodule S (M ⧸ N)) := by
    intro I
    rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ]
  calc
    irrelevantIdeal 𝒮 • (⊤ : Submodule S (M ⧸ N)) =
        Submodule.map N.mkQ (irrelevantIdeal 𝒮 • (⊤ : Submodule S M)) :=
      (hmap _).symm
    _ = Submodule.map N.mkQ (Ideal.span (t : Set S) • (⊤ : Submodule S M)) := by rw [hinv]
    _ = Ideal.span (t : Set S) • (⊤ : Submodule S (M ⧸ N)) := hmap _

/- **(N2c) `φ_Q` is a numerical polynomial for an `xʳ`-annihilated quotient `Q = M/xʳM`
(consumes IH).** Stated over an abstract finite graded `S`-module `Q` carrying the witness
`t` and annihilated by `xʳ` (the caller `hilbertDiff_eq_xpow_quot` instantiates
`Q = M ⧸ (Ideal.span {xʳ} • ⊤)`), to avoid threading the quotient bundle's
`DirectSum.Decomposition` instance through this signature.

PROOF (fixing the `x` versus `xʳ` gap): refine `Q` by the finite filtration
with subquotients `P_j = xʲQ / x^{j+1}Q` (`j = 0..r-1`); each `P_j` is a QUOTIENT of `Q`
(hence of `M`), x-annihilated (`x · P_j = 0`), carrying witness `t` (`module_inv_quotient`),
hence witness `t.erase x` of card `< k` (`module_inv_drop_annihilator`);
`hilbertFun_xann_quotient_isNumpoly k IH … P_j` gives `φ_{P_j}` numerical; finite `K'_0`
additivity along the filtration `φ_Q = Σⱼ φ_{P_j}` (`FinModule.cls_add_of_ses`) +
`eventualNumpoly_add` ⇒ numerical. (Needs the graded structures on `xʲQ`, `P_j` from the `quot*`
bundle + `idealSpanPow_smul_top_homog`.) -/

/-! ### Per-degree `·xʳ` multiplication map and its kernel (for the four-term sequence) -/

/-- **The degree-zero subring `𝒮 0` of a non-negatively graded Noetherian ring is Noetherian.**
For non-negative gradings (`hneg`) the degree-0 projection `S → 𝒮 0` is a surjective ring
homomorphism (cross terms of a product of degree-0 elements land in nonzero degrees, so it
respects multiplication), whence `𝒮 0` is Noetherian as a quotient of the Noetherian `S`.
(Mathlib's `GradedRing.projZeroRingHom'_surjective` / `GradedRing.GradeZero.isNoetherianRing`
both require `CanonicallyOrderedAdd ι`, unavailable for `ι = ℤ`; this rebuilds the projection
ring hom using `hneg`.) -/
@[ega "II 2.1.5" "necessity"]
theorem gradeZero_isNoetherianRing (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥) :
    IsNoetherianRing ↥(𝒮 0) := by
  classical
  -- The degree-0 projection respects multiplication (the place where `hneg` is essential).
  have hmul :
    ∀ a b : S,
      (DirectSum.decompose 𝒮 (a * b) 0 : S) =
        (DirectSum.decompose 𝒮 a 0 : S) * (DirectSum.decompose 𝒮 b 0 : S) := by
    intro a b
    -- A homogeneous factor of strictly positive degree contributes nothing to the
    -- degree-0 component of a product (its cross terms land in nonzero degrees).
    have hpos :
      ∀ (d : ℤ), 0 < d → ∀ (c : S), c ∈ 𝒮 d → (DirectSum.decompose 𝒮 (c * b) 0 : S) = 0 := by
      intro d hd c hc
      rw [← DirectSum.sum_support_decompose 𝒮 b, Finset.mul_sum, coe_decompose_sum]
      refine Finset.sum_eq_zero fun e _ => ?_
      by_cases he0 : e < 0
      · have hsub : (𝒮 e : AddSubgroup S) = ⊥ := hneg e he0
        have hmem : ((DirectSum.decompose 𝒮 b e : 𝒮 e) : S) ∈ 𝒮 e :=
          (DirectSum.decompose 𝒮 b e).property
        simp only [hsub, AddSubgroup.mem_bot] at hmem
        rw [hmem, mul_zero]; simp
      · push Not at he0
        have hbe : ((DirectSum.decompose 𝒮 b e : 𝒮 e) : S) ∈ 𝒮 e :=
          (DirectSum.decompose 𝒮 b e).property
        have hcbe : c * ((DirectSum.decompose 𝒮 b e : 𝒮 e) : S) ∈ 𝒮 (d + e) :=
          SetLike.mul_mem_graded hc hbe
        have hne : d + e ≠ 0 := by omega
        exact DirectSum.decompose_of_mem_ne 𝒮 hcbe hne
    set a0 : S := (DirectSum.decompose 𝒮 a 0 : S) with ha0def
    have ha0mem : a0 ∈ 𝒮 0 := (DirectSum.decompose 𝒮 a 0).property
    set a' : S := a - a0 with ha'def
    have hga' : (DirectSum.decompose 𝒮 a' 0 : S) = 0 := by
      simp [ha'def, ha0def]
    have habsplit : a * b = a0 * b + a' * b := by
      rw [ha'def]; ring
    have key1 : (DirectSum.decompose 𝒮 (a0 * b) 0 : S) = a0 * (DirectSum.decompose 𝒮 b 0 : S) :=
      DirectSum.coe_decompose_mul_of_left_mem_zero 𝒮 ha0mem
    have key2 : (DirectSum.decompose 𝒮 (a' * b) 0 : S) = 0 := by
      rw [← DirectSum.sum_support_decompose 𝒮 a', Finset.sum_mul, coe_decompose_sum]
      refine Finset.sum_eq_zero fun d hd => ?_
      rw [DFinsupp.mem_support_toFun] at hd
      have hmemd : ((DirectSum.decompose 𝒮 a' d : 𝒮 d) : S) ∈ 𝒮 d :=
        (DirectSum.decompose 𝒮 a' d).property
      by_cases hdneg : d < 0
      · exfalso
        have hsub : (𝒮 d : AddSubgroup S) = ⊥ := hneg d hdneg
        apply hd; apply Subtype.ext
        simp only [hsub, AddSubgroup.mem_bot] at hmemd
        simp [hmemd]
      · push Not at hdneg
        by_cases hd0 : d = 0
        · exfalso; apply hd; subst hd0
          exact
            Subtype.ext
              (by
                rw [hga']; rfl)
        · have hdpos : 0 < d := lt_of_le_of_ne hdneg (Ne.symm hd0)
          exact hpos d hdpos _ hmemd
    rw [habsplit, DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add, key1, key2,
      add_zero, ha0def]
  -- The degree-0 component of `1` is `1`.
  have hone : (DirectSum.decompose 𝒮 (1 : S) 0 : S) = 1 :=
    DirectSum.decompose_of_mem_same 𝒮 (SetLike.one_mem_graded 𝒮)
  -- Assemble the degree-0 projection as a surjective ring homomorphism `S →+* ↥(𝒮 0)`.
  let π : S →+* ↥(𝒮 0) :=
    { toFun := fun a => ⟨(DirectSum.decompose 𝒮 a 0 : S), (DirectSum.decompose 𝒮 a 0).property⟩
      map_one' := by
        apply Subtype.ext; simpa using hone
      map_mul' := by
        intro a b; apply Subtype.ext; simpa using hmul a b
      map_zero' := by
        apply Subtype.ext; simp
      map_add' := by
        intro a b; apply Subtype.ext; simp }
  have hsurj : Function.Surjective π := by
    intro y
    refine ⟨(y : S), ?_⟩
    apply Subtype.ext
    change (DirectSum.decompose 𝒮 (y : S) 0 : S) = (y : S)
    exact DirectSum.decompose_of_mem_same 𝒮 y.property
  exact isNoetherianRing_of_surjective S ↥(𝒮 0) π hsurj

/-- For `x ∈ 𝒮 1`, multiplication by `xʳ` sends `ℳ n` into `ℳ (n+r)` (degree shift by `r`),
giving an `𝒮 0`-linear map `μ_{r,n} : ℳ n → ℳ (n+r)`. -/
noncomputable def xpowDegMap (x : S) (hx : x ∈ 𝒮 1) (r : ℕ) (n : ℤ) :
    ↥(ℳ n) →ₗ[↥(𝒮 0)] ↥(ℳ (n + r)) where
  toFun m :=
    ⟨x ^ r • (m : M), by
      have hxr : x ^ r ∈ 𝒮 r := by simpa using SetLike.pow_mem_graded r hx
      have := gp_hsmul_mem 𝒮 ℳ r n (x ^ r) hxr (m : M) m.property
      simpa [add_comm] using this⟩
  map_add' a b := by
    ext; simp [smul_add]
  map_smul' s m := by
    ext
    simp only [gradePieceSMul_coe, RingHom.id_apply]
    rw [smul_comm]

/-- The kernel submodule of `μ_{r,n}` (a submodule of the finite `𝒮 0`-module `ℳ n`). -/
noncomputable def xpowDegKerSub (x : S) (hx : x ∈ 𝒮 1) (r : ℕ) (n : ℤ) : Submodule ↥(𝒮 0) ↥(ℳ n) :=
  LinearMap.ker (xpowDegMap 𝒮 ℳ x hx r n)

/-- The kernel of `μ_{r,n}`, packaged as a finite `𝒮 0`-module (it is a submodule of the
finite module `ℳ n`, and `𝒮 0` is Noetherian since `S` is). -/
noncomputable def xpowDegKerFin (hneg : ∀ d : ℤ, d < 0 → 𝒮 d = ⊥) (x : S) (hx : x ∈ 𝒮 1) (r : ℕ)
    (n : ℤ) : FinModule ↥(𝒮 0)
    where
  carrier := ↥(xpowDegKerSub 𝒮 ℳ x hx r n)
  finite := by
    have : Module.Finite ↥(𝒮 0) ↥(ℳ n) := gradedPiece_finite 𝒮 ℳ hneg n
    have : IsNoetherianRing ↥(𝒮 0) := gradeZero_isNoetherianRing 𝒮 hneg
    have : IsNoetherian ↥(𝒮 0) ↥(ℳ n) := isNoetherian_of_isNoetherianRing_of_finite _ _
    exact Module.Finite.of_injective (xpowDegKerSub 𝒮 ℳ x hx r n).subtype Subtype.val_injective
end Main
