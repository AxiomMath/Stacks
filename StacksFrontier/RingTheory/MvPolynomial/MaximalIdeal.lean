/-!
# Maximal ideals of a polynomial ring over a field

Let `k` be a field, let `n : ℕ` and let `R = k[x_1, …, x_n]`, formalized as
`MvPolynomial (Fin n) k`. For a maximal ideal `m ⊆ R`:

1. `m` is generated by `n` elements: there is a family `g : Fin n → R` whose range spans `m`;
2. the localization `R_m` has Krull dimension `n`;
3. `R_m` is a regular local ring of dimension `n`.

For `n = 0`, `R = k` is a field, the only maximal ideal is `(0)`, generated by `0` elements, and
`R_m = k` has dimension `0`. "Generated by `n` elements" is read as "generated by at most `n`
elements" and formalized as `GeneratedByAtMost`: the existence of a family `g : Fin n → R` whose
range generates `m`. Krull dimension takes values in `WithBot ℕ∞`, so `dim R_m = n` is equality
with the image of `n` under the canonical coercion.

## Main definitions

* `GeneratedByAtMost`: an ideal is generated by at most `n` elements.

## Main results

* `jacobsonConstruction`: a maximal ideal `m` of `R` is generated by a family `Fin n → R`, and
  is the top of a strictly increasing chain of primes of length `n`.
* `height_maximal_ideal_eq`: the height of a maximal ideal of `R` is `n`.
* `maximal_ideal_generated_by_n`: a maximal ideal of `R` is generated by at most `n` elements.
* `ringKrullDim_localization_atPrime_eq`: the localization `R_m` has Krull dimension `n`.
* `isRegularLocalRing_localization_atPrime`: the localization `R_m` is a regular local ring.
-/

@[expose] public section


/-- An ideal `I` of a commutative ring `R` is generated by at most `n` elements when there is a
family `g : Fin n → R` whose range generates `I`. -/
def GeneratedByAtMost {R : Type*} [CommRing R] (n : ℕ) (I : Ideal R) : Prop :=
  ∃ g : Fin n → R, Ideal.span (Set.range g) = I

section JacobsonInduction

private theorem comap_C_map_C {R : Type*} [CommRing R] (I : Ideal R) :
    (I.map Polynomial.C).comap Polynomial.C = I := by
  refine le_antisymm (fun x hx ↦ ?_) Ideal.le_comap_map
  simpa using Ideal.mem_map_C_iff.mp (Ideal.mem_comap.mp hx) 0

private noncomputable def primeMapC {R : Type*} [CommRing R] (x : PrimeSpectrum R) :
    PrimeSpectrum (Polynomial R) :=
  ⟨x.asIdeal.map Polynomial.C, @Ideal.isPrime_map_C_of_isPrime R _ x.asIdeal x.isPrime⟩

private theorem primeMapC_strictMono {R : Type*} [CommRing R] :
    StrictMono (primeMapC (R := R)) := by
  intro x y hxy
  change (primeMapC x).asIdeal < (primeMapC y).asIdeal
  refine lt_of_le_of_ne (Ideal.map_mono hxy.le) fun heq ↦ hxy.ne (PrimeSpectrum.ext ?_)
  simpa only [primeMapC, comap_C_map_C] using congrArg (Ideal.comap Polynomial.C) heq

private theorem maximalIdeal_decomposition {R : Type*} [CommRing R] (p : Ideal R) [hp : p.IsMaximal]
    (M : Ideal (Polynomial R)) (hle : p.map Polynomial.C ≤ M) :
    ∃ Q : Polynomial R, M = p.map Polynomial.C ⊔ Ideal.span {Q} := by
  let : Field (R ⧸ p) := Ideal.Quotient.field p
  set φ := (Ideal.polynomialQuotientEquivQuotientPolynomial p).toRingHom with hφ
  set q := Ideal.Quotient.mk (p.map (Polynomial.C : R →+* Polynomial R)) with hq
  have hqsurj : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hφsurj : Function.Surjective φ :=
    (Ideal.polynomialQuotientEquivQuotientPolynomial p).surjective
  set M' := M.map q with hM'
  set N := M'.comap φ with hN
  obtain ⟨q0', hq0'⟩ := (IsPrincipalIdealRing.principal N).principal
  have hq0 : N = Ideal.span {q0'} := by rw [hq0', Ideal.submodule_span_eq]
  have hM'eq : M' = N.map φ := by rw [hN, Ideal.map_comap_of_surjective φ hφsurj]
  obtain ⟨Q, hQ⟩ := hqsurj (φ q0')
  refine ⟨Q, ?_⟩
  have hker : RingHom.ker q = p.map (Polynomial.C : R →+* Polynomial R) := by rw [hq, Ideal.mk_ker]
  have hMcomap : M = M'.comap q := by
    rw [hM', Ideal.comap_map_of_surjective q hqsurj, ← RingHom.ker_eq_comap_bot, hker]
    exact (sup_eq_left.mpr hle).symm
  rw [hMcomap, hM'eq, hq0, Ideal.map_span, Set.image_singleton, ← hQ, ← Set.image_singleton,
    ← Ideal.map_span, Ideal.comap_map_of_surjective q hqsurj, ← RingHom.ker_eq_comap_bot, hker,
    sup_comm]

/-- The span of a family composed with a ring map is the image of the span. -/
private theorem span_range_comp_eq_map {R S ι : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (g : ι → R) :
    Ideal.span (Set.range fun i ↦ f (g i)) = (Ideal.span (Set.range g)).map f := by
  rw [Ideal.map_span, ← Set.range_comp]; rfl

private theorem mapC_lt {R : Type*} [CommRing R] (p : Ideal R) [p.IsMaximal]
    (M : Ideal (Polynomial R)) (hM : M.IsMaximal) (hle : p.map Polynomial.C ≤ M) :
    p.map Polynomial.C < M := by
  refine lt_of_le_of_ne hle fun heq ↦ ?_
  rw [← heq] at hM
  let : Field (R ⧸ p) := Ideal.Quotient.field p
  have hfield : IsField (Polynomial R ⧸ p.map Polynomial.C) :=
    Ideal.Quotient.maximal_ideal_iff_isField_quotient _ |>.mp hM
  exact Polynomial.not_isField (R ⧸ p)
    (MulEquiv.isField hfield (Ideal.polynomialQuotientEquivQuotientPolynomial p).toMulEquiv)

-- needed: `jacobson_induction_step` leaves unsolved goals without it — the `LTSeries` endpoint
-- goals close only when `Ideal.comap Polynomial.C M` and `RelSeries.last c` are
-- identified up to non-transparent unfolding.
set_option backward.isDefEq.respectTransparency false in
private theorem jacobson_induction_step {R : Type*} [CommRing R] [IsJacobsonRing R] (n : ℕ)
    (M : Ideal (Polynomial R)) (hM : M.IsMaximal)
    (g : Fin n → R) (hg : Ideal.span (Set.range g) = M.comap Polynomial.C)
    (c : LTSeries (PrimeSpectrum R)) (hclen : c.length = n)
    (hclast : c.last =
      ⟨M.comap Polynomial.C, Polynomial.isMaximal_comap_C_of_isJacobsonRing M |>.isPrime⟩) :
    ∃ f : Fin (n+1) → Polynomial R, Ideal.span (Set.range f) = M ∧
      ∃ chain : LTSeries (PrimeSpectrum (Polynomial R)),
        chain.length = n+1 ∧ chain.last = ⟨M, hM.isPrime⟩ := by
  have hpmax : (M.comap Polynomial.C).IsMaximal :=
    Polynomial.isMaximal_comap_C_of_isJacobsonRing M
  have hle : (M.comap Polynomial.C).map Polynomial.C ≤ M := by rw [Ideal.map_le_iff_le_comap]
  obtain ⟨Q, hQ⟩ := maximalIdeal_decomposition (M.comap Polynomial.C) M hle
  refine ⟨Fin.cons Q (fun i ↦ Polynomial.C (g i)), ?_, ?_⟩
  · rw [Fin.range_cons, Ideal.span_insert,
      span_range_comp_eq_map (Polynomial.C : R →+* Polynomial R) g, hg, sup_comm, ← hQ]
  · have hrel : (c.map primeMapC primeMapC_strictMono).last <
        (⟨M, hM.isPrime⟩ : PrimeSpectrum (Polynomial R)) := by
      change (c.map primeMapC primeMapC_strictMono).last.asIdeal < M
      rw [LTSeries.last_map, hclast]
      exact mapC_lt _ M hM hle
    refine ⟨(c.map primeMapC primeMapC_strictMono).snoc ⟨M, hM.isPrime⟩ hrel, ?_,
      RelSeries.last_snoc _ _ _⟩
    simp only [RelSeries.snoc_length]
    exact congrArg (· + 1) hclen

private theorem transport_along_ringEquiv {A B : Type*} [CommRing A] [CommRing B]
    (e : A ≃+* B) (N : ℕ)
    (M : Ideal B) (hM : M.IsMaximal)
    (h : ∃ f : Fin N → B, Ideal.span (Set.range f) = M ∧
      ∃ chain : LTSeries (PrimeSpectrum B), chain.length = N ∧ chain.last = ⟨M, hM.isPrime⟩) :
    ∃ f : Fin N → A, Ideal.span (Set.range f) = M.comap (e : A →+* B) ∧
      ∃ chain : LTSeries (PrimeSpectrum A), chain.length = N ∧
        chain.last = ⟨M.comap (e : A →+* B), (Ideal.comap_isMaximal_of_equiv e).isPrime⟩ := by
  obtain ⟨f, hf, chain, hlen, hlast⟩ := h
  refine ⟨fun i ↦ e.symm (f i), ?_, ?_⟩
  · refine (span_range_comp_eq_map (e.symm : B →+* A) f).trans ?_
    rw [hf]
    exact Ideal.map_symm e
  · have hsm : StrictMono (PrimeSpectrum.comap (e : A →+* B)) := by
      have heq : PrimeSpectrum.comap (e : A →+* B) = (PrimeSpectrum.comapEquiv e).symm := by
        ext x : 2; rfl
      rw [heq]; exact (PrimeSpectrum.comapEquiv e).symm.strictMono
    refine ⟨chain.map (PrimeSpectrum.comap (e : A →+* B)) hsm, ?_, ?_⟩
    · rw [show (chain.map (PrimeSpectrum.comap (e : A →+* B)) hsm).length = chain.length from rfl,
        hlen]
    · rw [LTSeries.last_map, hlast]; rfl

private theorem jacobson_maximalIdeal_induction.{u} (n : ℕ) :
    ∀ {k : Type u} [Field k] (m : Ideal (MvPolynomial (Fin n) k)) (hm : m.IsMaximal),
    ∃ f : Fin n → MvPolynomial (Fin n) k, Ideal.span (Set.range f) = m ∧
      ∃ chain : LTSeries (PrimeSpectrum (MvPolynomial (Fin n) k)),
        chain.length = n ∧ chain.last = ⟨m, hm.isPrime⟩ := by
  induction n with
  | zero =>
    intro k _ m hm
    set e := MvPolynomial.isEmptyRingEquiv k (Fin 0) with he
    have hmbot : m = ⊥ := by
      have : (Ideal.map (e : MvPolynomial (Fin 0) k →+* k) m).IsMaximal :=
        Ideal.map_isMaximal_of_equiv e
      have hM : Ideal.map (e : MvPolynomial (Fin 0) k →+* k) m = ⊥ :=
        (Ideal.map (e : MvPolynomial (Fin 0) k →+* k) m).eq_bot_or_top.resolve_right this.ne_top
      have h2 : Ideal.comap (e : MvPolynomial (Fin 0) k →+* k)
          (Ideal.map (e : MvPolynomial (Fin 0) k →+* k) m) = m :=
        Ideal.comap_map_of_bijective _ e.bijective
      rw [← h2, hM]
      exact Ideal.comap_bot_of_injective _ e.injective
    refine ⟨Fin.elim0, ?_, ?_⟩
    · rw [Set.range_eq_empty, Ideal.span_empty, hmbot]
    · exact ⟨RelSeries.singleton _ ⟨m, hm.isPrime⟩, rfl, rfl⟩
  | succ n ih =>
    intro k _ m hm
    set e := (MvPolynomial.finSuccEquiv k n).toRingEquiv with he
    set M := Ideal.map (e : MvPolynomial (Fin (n+1)) k →+* Polynomial (MvPolynomial (Fin n) k)) m
      with hMdef
    have hMmax : M.IsMaximal := Ideal.map_isMaximal_of_equiv e
    have : IsJacobsonRing (MvPolynomial (Fin n) k) := MvPolynomial.isJacobsonRing
    have hpmax : (M.comap Polynomial.C).IsMaximal :=
      Polynomial.isMaximal_comap_C_of_isJacobsonRing M
    obtain ⟨g, hg, c, hclen, hclast⟩ := ih (M.comap Polynomial.C) hpmax
    obtain ⟨f, hf, chain, hlen2, hlast2⟩ := transport_along_ringEquiv e (n+1) M hMmax
      (jacobson_induction_step n M hMmax g hg c hclen hclast)
    have hcm : M.comap (e : MvPolynomial (Fin (n+1)) k →+* Polynomial (MvPolynomial (Fin n)
        k)) = m := by
      rw [hMdef]; exact Ideal.comap_map_of_bijective _ e.bijective
    exact ⟨f, by rw [hf, hcm], chain, hlen2, by rw [hlast2]; exact PrimeSpectrum.ext hcm⟩

end JacobsonInduction

/-- For a maximal ideal `m` of `R = MvPolynomial (Fin n) k` there is a family `f : Fin n → R`
generating `m`, together with a strictly increasing chain of primes of length `n` whose top element
is `m`. -/
theorem jacobsonConstruction
    {k : Type*} [Field k] (n : ℕ) (m : Ideal (MvPolynomial (Fin n) k))
    (hm : m.IsMaximal) :
    haveI : m.IsPrime := hm.isPrime
    ∃ f : Fin n → MvPolynomial (Fin n) k,
      Ideal.span (Set.range f) = m ∧
      ∃ chain : LTSeries (PrimeSpectrum (MvPolynomial (Fin n) k)),
        chain.length = n ∧ chain.last = ⟨m, hm.isPrime⟩ :=
  jacobson_maximalIdeal_induction n m hm

/-- A family `g : Fin n → R` generating `I` witnesses `Submodule.spanFinrank I ≤ n`. -/
theorem spanFinrank_le_of_generatedByAtMost {R : Type*} [CommRing R] (n : ℕ) (I : Ideal R)
    (h : GeneratedByAtMost n I) : Submodule.spanFinrank I ≤ n := by
  obtain ⟨g, rfl⟩ := h
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (R := R) (Set.finite_range g)).trans ?_
  rw [← Set.image_univ]
  exact (Set.ncard_image_le Set.finite_univ).trans (by simp)

/-- The height of a maximal ideal of `MvPolynomial (Fin n) k` is `n`. -/
theorem height_maximal_ideal_eq
    {k : Type*} [Field k] (n : ℕ) (m : Ideal (MvPolynomial (Fin n) k))
    (hm : m.IsMaximal) :
    m.height = (n : ℕ∞) := by
  have : m.IsPrime := hm.isPrime
  obtain ⟨f, _, chain, hlen, hlast⟩ := jacobsonConstruction n m hm
  apply le_antisymm
  · have h1 : (m.height : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin n) k) :=
      Ideal.height_le_ringKrullDim_of_ne_top hm.ne_top
    have h2 : ringKrullDim (MvPolynomial (Fin n) k) = (n : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]; simp
    rw [h2] at h1
    exact_mod_cast h1
  · have hh := Order.length_le_height (p := chain) (x := ⟨m, hm.isPrime⟩) (by rw [hlast])
    rw [hlen] at hh
    rw [show m.height = Order.height (⟨m, hm.isPrime⟩ : PrimeSpectrum _) from
        PrimeSpectrum.height_eq_orderHeight (⟨m, hm.isPrime⟩ : PrimeSpectrum _)]
    exact hh

/-- A maximal ideal `m` of `k[x_1, …, x_n]` is generated by at most `n` elements. -/
@[stacks 00OP]
theorem maximal_ideal_generated_by_n
    {k : Type*} [Field k] (n : ℕ) (m : Ideal (MvPolynomial (Fin n) k))
    (hm : m.IsMaximal) :
    GeneratedByAtMost n m := by
  obtain ⟨f, hf, _⟩ := jacobsonConstruction n m hm
  exact ⟨f, hf⟩

/-- Part 2 of tag 00OP: the localization of `k[x_1, …, x_n]` at a maximal ideal has Krull
dimension `n`. -/
@[stacks 00OP, ega "IV 5.5.3" "special case", ega "IV 5.6.1" "special case"]
theorem ringKrullDim_localization_atPrime_eq
    {k : Type*} [Field k] (n : ℕ) (m : Ideal (MvPolynomial (Fin n) k))
    (hm : m.IsMaximal) :
    haveI : m.IsPrime := hm.isPrime
    ringKrullDim (Localization.AtPrime m) = (n : WithBot ℕ∞) := by
  have : m.IsPrime := hm.isPrime
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height m (Localization.AtPrime m),
    height_maximal_ideal_eq n m hm]
  rfl

/-- The localization of `k[x_1, …, x_n]` at a maximal ideal is a regular local ring. -/
@[stacks 00OP]
theorem isRegularLocalRing_localization_atPrime
    {k : Type*} [Field k] (n : ℕ) (m : Ideal (MvPolynomial (Fin n) k))
    (hm : m.IsMaximal) :
    haveI : m.IsPrime := hm.isPrime
    IsRegularLocalRing (Localization.AtPrime m) := by
  have : m.IsPrime := hm.isPrime
  have : IsNoetherianRing (Localization.AtPrime m) :=
    IsLocalization.isNoetherianRing m.primeCompl _ inferInstance
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  rw [ringKrullDim_localization_atPrime_eq n m hm, ← Localization.AtPrime.map_eq_maximalIdeal]
  exact_mod_cast (Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian m)).trans
    (spanFinrank_le_of_generatedByAtMost n m (maximal_ideal_generated_by_n n m hm))
