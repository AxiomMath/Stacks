module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.Algebra.Polynomial.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.Nilpotent.Basic
public import Mathlib.RingTheory.Polynomial.Basic

/-!
# An ideal of nilpotents with no uniform nilpotence exponent

Let `A = ℤ[x₀, x₁, x₂, …]` be the polynomial ring on countably many variables and let
`R = A ⧸ (x₀, x₁², x₂³, …)` be its quotient by the ideal generated by `xₙ ^ (n + 1)`. In `R`
every variable is nilpotent, so the ideal generated by the images of the variables is contained
in the nilradical; but that ideal is *not* nilpotent, because the exponent needed to kill `xₘ`
grows with `m`.

This is the ring-theoretic content of the counterexample of [Stacks, Tag 0H8N]: the completion
of `Spec A` along the closed subscheme `(x₀, x₁, …)` differs from its completion along the
underlying closed subset, and the section of `Spec A` exhibiting the difference is
`Spec R ⟶ Spec A`, whose image is set-theoretically inside the closed subset while no single
infinitesimal neighbourhood of the closed subscheme contains it.

## Main definitions

* `MvPolynomial.powerIdeal` is the ideal `(xₙ ^ (n + 1) : n)` of `ℤ[x₀, x₁, …]`.

## Main results

* `MvPolynomial.X_pow_notMem_powerIdeal`: `xₘ ^ (N + 1)` does not lie in `powerIdeal` when
  `N + 1 ≤ m`.
* `MvPolynomial.isNilpotent_powerIdealMk_X`: every variable is nilpotent in the quotient.
* `MvPolynomial.exists_powerIdealMk_X_pow_ne_zero`: no exponent kills every variable in the
  quotient, so the ideal generated by their images is contained in the nilradical without being
  nilpotent.

## Implementation notes

Non-membership is proved by mapping to `ℤ[t]`: the `ℤ`-algebra map sending `xₘ ↦ t` and every
other variable to `0` carries `xₙ ^ (n + 1)` to `0` for `n ≠ m` and to `t ^ (m + 1)` for
`n = m`, so it carries `powerIdeal` into `(t ^ (m + 1))`; it carries `xₘ ^ (N + 1)` to
`t ^ (N + 1)`, which is not divisible by `t ^ (m + 1)` once `N + 1 ≤ m`, by degrees.
-/

@[expose] public noncomputable section

open MvPolynomial

namespace MvPolynomial

/-- The ideal `(xₙ ^ (n + 1) : n)` of the polynomial ring `ℤ[x₀, x₁, x₂, …]`. -/
def powerIdeal : Ideal (MvPolynomial ℕ ℤ) :=
  Ideal.span (Set.range fun n : ℕ => (X n : MvPolynomial ℕ ℤ) ^ (n + 1))

/-- The generator `xₙ ^ (n + 1)` lies in `MvPolynomial.powerIdeal`. -/
theorem X_pow_succ_mem_powerIdeal (n : ℕ) :
    (X n : MvPolynomial ℕ ℤ) ^ (n + 1) ∈ powerIdeal :=
  Ideal.subset_span ⟨n, rfl⟩

/-- **No exponent below `m` kills `xₘ` modulo `MvPolynomial.powerIdeal`.** If `N + 1 ≤ m` then
`xₘ ^ (N + 1)` is not in the ideal generated by the `xₙ ^ (n + 1)`.

Send `xₘ` to `t` and every other variable to `0`: the ideal goes into `(t ^ (m + 1))` while
`xₘ ^ (N + 1)` goes to `t ^ (N + 1)`, of degree too small to be divisible by `t ^ (m + 1)`. -/
theorem X_pow_notMem_powerIdeal {m N : ℕ} (hN : N + 1 ≤ m) :
    (X m : MvPolynomial ℕ ℤ) ^ (N + 1) ∉ powerIdeal := by
  classical
  intro hmem
  set φ : MvPolynomial ℕ ℤ →+* Polynomial ℤ :=
    (MvPolynomial.aeval
      (fun n : ℕ => if n = m then (Polynomial.X : Polynomial ℤ) else 0)).toRingHom with hφ
  have hval (n k : ℕ) : φ ((X n : MvPolynomial ℕ ℤ) ^ k) =
      (if n = m then (Polynomial.X : Polynomial ℤ) else 0) ^ k := by
    simp [hφ]
  have hspan : powerIdeal ≤
      Ideal.comap φ (Ideal.span {(Polynomial.X : Polynomial ℤ) ^ (m + 1)}) := by
    rw [powerIdeal, Ideal.span_le]
    rintro _ ⟨n, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    refine Ideal.mem_span_singleton.2 ?_
    rw [hval]
    by_cases h : n = m
    · subst h; simp
    · simp [h]
  have h2 := hspan hmem
  rw [Ideal.mem_comap] at h2
  rw [hval] at h2
  simp only [↓reduceIte, Ideal.mem_span_singleton] at h2
  have hne : (Polynomial.X : Polynomial ℤ) ^ (N + 1) ≠ 0 := pow_ne_zero _ Polynomial.X_ne_zero
  have hdeg := Polynomial.natDegree_le_of_dvd h2 hne
  rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X_pow] at hdeg
  omega

/-- Every variable is nilpotent in `ℤ[x₀, x₁, …] ⧸ (xₙ ^ (n + 1) : n)`. -/
theorem isNilpotent_powerIdealMk_X (n : ℕ) :
    IsNilpotent (Ideal.Quotient.mk powerIdeal (X n : MvPolynomial ℕ ℤ)) :=
  ⟨n + 1, by
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact X_pow_succ_mem_powerIdeal n⟩

/-- **The images of the variables generate an ideal of nilpotents which is not nilpotent.** For
every exponent `N` some variable survives it in
`ℤ[x₀, x₁, …] ⧸ (xₙ ^ (n + 1) : n)`. -/
theorem exists_powerIdealMk_X_pow_ne_zero (N : ℕ) :
    ∃ m : ℕ, (Ideal.Quotient.mk powerIdeal (X m : MvPolynomial ℕ ℤ)) ^ (N + 1) ≠ 0 := by
  refine ⟨N + 1, ?_⟩
  rw [← map_pow, Ne, Ideal.Quotient.eq_zero_iff_mem]
  exact X_pow_notMem_powerIdeal (Nat.le_refl (N + 1))

end MvPolynomial

end
