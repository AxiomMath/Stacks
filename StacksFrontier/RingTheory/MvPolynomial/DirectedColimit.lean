module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Data.Finset.Order
public import Mathlib.Order.DirectedInverseSystem
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Polynomials, ideal membership and units over a directed colimit of rings

Let `(G i)` be a directed system of commutative rings with transition maps `f i j` and let `A` be
its colimit, presented by a compatible family of ring maps `φ i : G i →+* A` which is *jointly
surjective* and whose *kernels are exhausted at later stages*.  This file collects the lifting
lemmas that such a presentation supports:

* finitely many elements of `A` come from one stage, above any prescribed stage;
* finitely many elements of a stage that die in `A` die simultaneously at a later stage;
* a unit of `A` coming from a stage is a unit at a later stage;
* membership, and radical membership, in the ideal generated by a finite family of elements of a
  stage descends to a later stage;
* a polynomial, or a finite family of polynomials, over `A` is the image of one over a stage;
* a polynomial over a stage that maps to `0` over `A` maps to `0` already at a later stage;
* membership in the ideal generated by a finite family of polynomials descends to a stage;
* invertibility in `MvPolynomial σ A ⧸ (g)` descends to invertibility in
  `MvPolynomial σ (G j) ⧸ (g)` at a later stage.

The last two are the ring-theoretic core of the step "after enlarging the index the Jacobian
determinant is again invertible" in Stacks 07SQ.

## Implementation notes

The colimit is *not* taken to be a particular construction.  Instead the two defining properties
are hypotheses, `hsurj` and `hzero`, on a cocone `φ` of ring maps, and each lemma assumes only the
ones it needs: the lifting lemmas use `hsurj`, the vanishing lemmas use `hzero`, and the lemmas
about ideals and units use both.  This is the form in which the statements apply both to
`Ring.DirectLimit` (through `Ring.DirectLimit.exists_of` and `Ring.DirectLimit.of.zero_exact`) and
to the global sections of a limit of affine schemes (through
`AlgebraicGeometry.exists_appTop_eq_of_isAffine_of_isLimit_of_directed` and
`AlgebraicGeometry.exists_ge_appTop_map_eq_zero_of_isAffine_of_isLimit_of_directed`), which is
where Stacks 07SQ consumes them.  It also leaves the index poset, the stages and the colimit in
three unrelated universes.

Mathlib has the single-variable lifting lemma for its own construction of the direct limit,
`Ring.DirectLimit.Polynomial.exists_of`, and nothing for `MvPolynomial`.
-/

@[expose] public section

universe u v w

open MvPolynomial

namespace Ring

variable {ι : Type u} [Preorder ι] {G : ι → Type v} [∀ i, CommRing (G i)]
  {f : ∀ i j, i ≤ j → G i →+* G j} {A : Type w} [CommRing A] {φ : ∀ i, G i →+* A}

/-! ### Lifting elements to a stage -/

/-- A finite family of indices has a common upper bound, which may be taken above a given index. -/
private theorem exists_ge_forall_le_of_finite [IsDirectedOrder ι] {κ : Type*} [Finite κ]
    (j : κ → ι) (i₀ : ι) : ∃ m, i₀ ≤ m ∧ ∀ k, j k ≤ m := by
  classical
  cases nonempty_fintype κ
  have : Nonempty ι := ⟨i₀⟩
  obtain ⟨m, hm⟩ := Finset.exists_le (insert i₀ (Finset.univ.image j))
  exact ⟨m, hm i₀ (Finset.mem_insert_self _ _), fun k ↦
    hm (j k) (Finset.mem_insert_of_mem (Finset.mem_image_of_mem j (Finset.mem_univ k)))⟩

/-- **Finitely many elements of a directed colimit come from a common stage.**  Given a jointly
surjective compatible family `φ` of ring maps from a directed system to `A`, a finite family of
elements of `A` is the image of a family at a single stage, which may be taken above any
prescribed stage. -/
theorem exists_ge_forall_eq_of_directed [IsDirectedOrder ι] [Nonempty ι]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    {κ : Type*} [Finite κ] (a : κ → A) (i₀ : ι) :
    ∃ (j : ι) (_ : i₀ ≤ j) (x : κ → G j), ∀ k, φ j (x k) = a k := by
  choose i x hx using fun k ↦ hsurj (a k)
  obtain ⟨j, hj, hmem⟩ := exists_ge_forall_le_of_finite i i₀
  exact ⟨j, hj, fun k ↦ f (i k) j (hmem k) (x k), fun k ↦ by rw [hφ, hx]⟩

/-- **An element of a directed colimit comes from any sufficiently late stage.** -/
theorem exists_ge_eq_of_directed [IsDirectedOrder ι] [Nonempty ι]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a) (a : A) (i₀ : ι) :
    ∃ (j : ι) (_ : i₀ ≤ j) (x : G j), φ j x = a := by
  obtain ⟨j, hj, x, hx⟩ := exists_ge_forall_eq_of_directed hφ hsurj (fun _ : Unit ↦ a) i₀
  exact ⟨j, hj, x (), hx ()⟩

/-- **Finitely many elements of a stage that die in a directed colimit die at one later stage.** -/
theorem exists_ge_forall_eq_zero_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {κ : Type*} [Finite κ] {i : ι} (x : κ → G i) (hx : ∀ k, φ i (x k) = 0) :
    ∃ (j : ι) (h : i ≤ j), ∀ k, f i j h (x k) = 0 := by
  choose j hij hj using fun k ↦ hzero i (x k) (hx k)
  obtain ⟨m, him, hjm⟩ := exists_ge_forall_le_of_finite j i
  refine ⟨m, him, fun k ↦ ?_⟩
  rw [← DirectedSystem.map_map' f (hij k) (hjm k), hj k, map_zero]

/-- **A unit of a directed colimit coming from a stage is already a unit at a later stage.** -/
theorem exists_ge_isUnit_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {i : ι} (x : G i) (hx : IsUnit (φ i x)) :
    ∃ (j : ι) (h : i ≤ j), IsUnit (f i j h x) := by
  have : Nonempty ι := ⟨i⟩
  obtain ⟨u, hu⟩ := hx
  obtain ⟨j, hij, y, hy⟩ := exists_ge_eq_of_directed hφ hsurj (↑u⁻¹ : A) i
  have h2 : φ j (f i j hij x * y - 1) = 0 := by
    rw [map_sub, map_mul, map_one, hφ, hy, ← hu, Units.mul_inv, sub_self]
  obtain ⟨m, hjm, hm⟩ := hzero j _ h2
  rw [map_sub, map_mul, map_one, sub_eq_zero, DirectedSystem.map_map' f hij hjm x] at hm
  exact ⟨m, hij.trans hjm, IsUnit.of_mul_eq_one _ hm⟩

/-- **Membership in the ideal generated by a finite family descends to a stage.**  If an element of
a stage lies, after passing to the directed colimit, in the ideal generated by the images of a
finite family from that stage, then already at a later stage it lies in the ideal generated by the
images of that family. -/
theorem exists_ge_mem_span_range_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {τ : Type*} [Finite τ] {i : ι} (b : τ → G i) (x : G i)
    (hx : φ i x ∈ Ideal.span (Set.range fun t ↦ φ i (b t))) :
    ∃ (j : ι) (h : i ≤ j), f i j h x ∈ Ideal.span (Set.range fun t ↦ f i j h (b t)) := by
  classical
  cases nonempty_fintype τ
  have : Nonempty ι := ⟨i⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx
  obtain ⟨j, hij, d, hd⟩ := exists_ge_forall_eq_of_directed hφ hsurj c i
  have hvanish : φ j (∑ t, d t * f i j hij (b t) - f i j hij x) = 0 := by
    rw [map_sub, map_sum, hφ]
    rw [show ∑ t, φ j (d t * f i j hij (b t)) = ∑ t, c t * φ i (b t) from
      Finset.sum_congr rfl fun t _ ↦ by rw [map_mul, hφ, hd]]
    rw [hc, sub_self]
  obtain ⟨m, hjm, hm⟩ := hzero j _ hvanish
  refine ⟨m, hij.trans hjm, Ideal.mem_span_range_iff_exists_fun.mpr
    ⟨fun t ↦ f j m hjm (d t), ?_⟩⟩
  rw [map_sub, map_sum, DirectedSystem.map_map' f hij hjm, sub_eq_zero] at hm
  rw [← hm]
  exact Finset.sum_congr rfl fun t _ ↦ by
    rw [map_mul, DirectedSystem.map_map' f hij hjm]

/-- **Radical membership in the ideal generated by a finite family descends to a stage.**  The
radical form of `Ring.exists_ge_mem_span_range_of_directed`, with the same exponent at the later
stage. -/
theorem exists_ge_mem_radical_span_range_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {τ : Type*} [Finite τ] {i : ι} (b : τ → G i) (x : G i)
    (hx : φ i x ∈ (Ideal.span (Set.range fun t ↦ φ i (b t))).radical) :
    ∃ (j : ι) (h : i ≤ j),
      f i j h x ∈ (Ideal.span (Set.range fun t ↦ f i j h (b t))).radical := by
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hx
  rw [← map_pow] at hn
  obtain ⟨j, hij, hj⟩ := exists_ge_mem_span_range_of_directed hφ hsurj hzero b (x ^ n) hn
  exact ⟨j, hij, Ideal.mem_radical_iff.mpr ⟨n, by rwa [map_pow] at hj⟩⟩

end Ring

/-! ### Polynomials over a directed colimit -/

namespace MvPolynomial

variable {ι : Type u} [Preorder ι] {G : ι → Type v} [∀ i, CommRing (G i)]
  {f : ∀ i j, i ≤ j → G i →+* G j} {A : Type w} [CommRing A] {φ : ∀ i, G i →+* A}
  {σ : Type*}

/-- The transition maps on polynomial rings are compatible with the maps to the colimit. -/
theorem map_map_eq_of_comp (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    {i j : ι} (h : i ≤ j) (p : MvPolynomial σ (G i)) :
    map (φ j) (map (f i j h) p) = map (φ i) p := by
  rw [map_map]
  exact congrArg (fun g ↦ map g p) (RingHom.ext (hφ i j h))

/-- The transition maps on polynomial rings form a directed system. -/
theorem map_map_eq_map_of_directedSystem [DirectedSystem G fun i j h ↦ f i j h]
    {i j k : ι} (hij : i ≤ j) (hjk : j ≤ k) (p : MvPolynomial σ (G i)) :
    map (f j k hjk) (map (f i j hij) p) = map (f i k (hij.trans hjk)) p := by
  rw [map_map]
  exact congrArg (fun g ↦ map g p)
    (RingHom.ext fun x ↦ DirectedSystem.map_map' f hij hjk x)

/-- **A polynomial over a directed colimit of rings comes from a stage.**  Its finitely many
coefficients are lifted to a common stage, which may be taken above any prescribed stage. -/
theorem exists_ge_map_eq_of_directed [IsDirectedOrder ι] [Nonempty ι]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    (p : MvPolynomial σ A) (i₀ : ι) :
    ∃ (j : ι) (_ : i₀ ≤ j) (q : MvPolynomial σ (G j)), map (φ j) q = p := by
  classical
  obtain ⟨j, hj, x, hx⟩ := Ring.exists_ge_forall_eq_of_directed hφ hsurj
    (fun m : {m // m ∈ p.support} ↦ p.coeff (m : σ →₀ ℕ)) i₀
  refine ⟨j, hj, ∑ m ∈ p.support.attach, monomial (m : σ →₀ ℕ) (x m), ?_⟩
  rw [map_sum]
  calc ∑ m ∈ p.support.attach, map (φ j) (monomial (m : σ →₀ ℕ) (x m))
      = ∑ m ∈ p.support.attach, monomial (m : σ →₀ ℕ) (p.coeff (m : σ →₀ ℕ)) := by
        refine Finset.sum_congr rfl fun m _ ↦ ?_
        rw [map_monomial, hx]
    _ = ∑ m ∈ p.support, monomial m (p.coeff m) :=
        Finset.sum_attach p.support fun m ↦ monomial m (p.coeff m)
    _ = p := support_sum_monomial_coeff p

/-- **Finitely many polynomials over a directed colimit of rings come from a common stage.** -/
theorem exists_ge_forall_map_eq_of_directed [IsDirectedOrder ι] [Nonempty ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    {κ : Type*} [Finite κ] (p : κ → MvPolynomial σ A) (i₀ : ι) :
    ∃ (j : ι) (_ : i₀ ≤ j) (q : κ → MvPolynomial σ (G j)), ∀ k, map (φ j) (q k) = p k := by
  choose j hj q hq using fun k ↦ exists_ge_map_eq_of_directed hφ hsurj (p k) i₀
  obtain ⟨m, hm, hjm⟩ := Ring.exists_ge_forall_le_of_finite j i₀
  refine ⟨m, hm, fun k ↦ map (f (j k) m (hjm k)) (q k), fun k ↦ ?_⟩
  rw [map_map_eq_of_comp hφ, hq]

/-- **A polynomial over a stage that vanishes over the colimit vanishes at a later stage.** -/
theorem exists_ge_map_eq_zero_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {i : ι} (q : MvPolynomial σ (G i)) (hq : map (φ i) q = 0) :
    ∃ (j : ι) (h : i ≤ j), map (f i j h) q = 0 := by
  classical
  have hcoeff : ∀ m : σ →₀ ℕ, φ i (q.coeff m) = 0 := fun m ↦ by
    rw [← coeff_map, hq, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  obtain ⟨j, hij, hj⟩ := Ring.exists_ge_forall_eq_zero_of_directed hzero
    (fun m : {m // m ∈ q.support} ↦ q.coeff (m : σ →₀ ℕ)) fun m ↦ hcoeff m
  refine ⟨j, hij, MvPolynomial.ext _ _ fun m ↦ ?_⟩
  rw [coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  by_cases hm : m ∈ q.support
  · exact hj ⟨m, hm⟩
  · rw [notMem_support_iff.mp hm, map_zero]

/-! ### Ideal membership and units in a quotient -/

/-- **Membership in the ideal generated by a finite family of polynomials descends to a stage.**
If a polynomial over a stage lies, after passing to the colimit, in the ideal generated by the
images of a finite family of polynomials over that stage, then already at a later stage it lies in
the ideal generated by the images of that family. -/
theorem exists_ge_mem_span_range_map_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {κ : Type*} [Finite κ] {i : ι} (g : κ → MvPolynomial σ (G i)) (q : MvPolynomial σ (G i))
    (hq : map (φ i) q ∈ Ideal.span (Set.range fun k ↦ map (φ i) (g k))) :
    ∃ (j : ι) (h : i ≤ j),
      map (f i j h) q ∈ Ideal.span (Set.range fun k ↦ map (f i j h) (g k)) := by
  have : Nonempty ι := ⟨i⟩
  have : DirectedSystem (fun j ↦ MvPolynomial σ (G j)) fun i j h ↦ map (f i j h) :=
    ⟨fun i p ↦ by
      rw [show f i i le_rfl = RingHom.id _ from
        RingHom.ext fun x ↦ DirectedSystem.map_self' f x, map_id],
      fun _ _ _ hij hjk p ↦ map_map_eq_map_of_directedSystem hij hjk p⟩
  exact Ring.exists_ge_mem_span_range_of_directed (f := fun i j h ↦ map (f i j h))
    (φ := fun i ↦ map (φ i)) (fun _ _ h p ↦ map_map_eq_of_comp hφ h p)
    (fun p ↦ by
      obtain ⟨j, -, q, hq⟩ := exists_ge_map_eq_of_directed hφ hsurj p i
      exact ⟨j, q, hq⟩)
    (fun _ q hq ↦ exists_ge_map_eq_zero_of_directed hzero q hq) g q hq

/-- **Invertibility in a finitely presented quotient descends to a stage.**  Let `g` be a finite
family of polynomials over a stage `G i` and let `q` be a polynomial over `G i`.  If the class of
`q` is invertible in `MvPolynomial σ A ⧸ (g)`, then at some later stage `j` the class of `q` is
already invertible in `MvPolynomial σ (G j) ⧸ (g)`. -/
theorem exists_ge_isUnit_quotientMk_of_directed [IsDirectedOrder ι]
    [DirectedSystem G fun i j h ↦ f i j h]
    (hφ : ∀ i j (h : i ≤ j) (x : G i), φ j (f i j h x) = φ i x)
    (hsurj : ∀ a : A, ∃ (i : ι) (x : G i), φ i x = a)
    (hzero : ∀ (i : ι) (x : G i), φ i x = 0 → ∃ (j : ι) (h : i ≤ j), f i j h x = 0)
    {κ : Type*} [Finite κ] {i : ι} (g : κ → MvPolynomial σ (G i)) (q : MvPolynomial σ (G i))
    (hq : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range fun k ↦ map (φ i) (g k)))
      (map (φ i) q))) :
    ∃ (j : ι) (h : i ≤ j), IsUnit (Ideal.Quotient.mk
      (Ideal.span (Set.range fun k ↦ map (f i j h) (g k))) (map (f i j h) q)) := by
  classical
  have : Nonempty ι := ⟨i⟩
  obtain ⟨b, hb⟩ := hq.exists_right_inv
  obtain ⟨B, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at hb
  obtain ⟨j, hij, C, hC⟩ := exists_ge_map_eq_of_directed hφ hsurj B i
  have hmem : map (φ j) (map (f i j hij) q * C - 1) ∈
      Ideal.span (Set.range fun k ↦ map (φ j) (map (f i j hij) (g k))) := by
    have he : (fun k ↦ map (φ j) (map (f i j hij) (g k))) = fun k ↦ map (φ i) (g k) :=
      funext fun k ↦ map_map_eq_of_comp hφ hij (g k)
    rw [he, map_sub, map_mul, map_one, map_map_eq_of_comp hφ, hC]
    exact hb
  obtain ⟨m, hjm, hm⟩ := exists_ge_mem_span_range_map_of_directed hφ hsurj hzero
    (fun k ↦ map (f i j hij) (g k)) _ hmem
  refine ⟨m, hij.trans hjm,
    IsUnit.of_mul_eq_one (Ideal.Quotient.mk _ (map (f j m hjm) C)) ?_⟩
  rw [map_sub, map_mul, map_one, map_map_eq_map_of_directedSystem hij hjm] at hm
  rw [show (fun k ↦ map (f j m hjm) (map (f i j hij) (g k)))
      = fun k ↦ map (f i m (hij.trans hjm)) (g k) from
    funext fun k ↦ map_map_eq_map_of_directedSystem hij hjm (g k)] at hm
  rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq]
  exact hm

end MvPolynomial

end
