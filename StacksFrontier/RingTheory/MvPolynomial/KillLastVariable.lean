module

public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Setting the last variable of a polynomial ring to zero

Sending the last variable of `R[X₀, …, Xₙ]` to zero and every other variable to the variable of
the same index is a surjection onto `R[X₀, …, X_{n-1}]` whose kernel is generated by the last
variable, and it preserves the grading by total degree. So the quotient of `R[X₀, …, Xₙ]` by the
ideal generated by its last variable is the polynomial ring in one variable fewer, as graded
rings.

The kernel is computed without any coefficient bookkeeping: the composition with the inclusion of
the first `n` variables is the identity, and the classes of polynomials in the first `n` variables
already exhaust the quotient, so a polynomial in the kernel is congruent to the inclusion of its
own image, which must vanish.

## Main definitions

* `Stacks.killLast`: the map setting the last variable to zero.
* `Stacks.killLastGradedHom`: that map as a homomorphism of graded rings.

## Main results

* `Stacks.ker_killLast`: the kernel is the ideal generated by the last variable.
* `Stacks.surjective_killLast`: the map is surjective.
* `Stacks.exists_isHomogeneous_killLast_eq`: it carries the homogeneous polynomials of a given
  degree onto the homogeneous polynomials of that degree.
-/

@[expose] public noncomputable section

namespace Stacks

open MvPolynomial

universe u

variable (R : Type u) [CommRing R] (n : ℕ)

/-- Setting the last variable of `R[X₀, …, Xₙ]` to zero. -/
def killLast : MvPolynomial (Fin (n + 1)) R →ₐ[R] MvPolynomial (Fin n) R :=
  aeval (Fin.lastCases 0 X)

/-- Setting the last variable to zero sends `X i` to `X i` for each of the first `n` variables. -/
@[simp]
theorem killLast_X_castSucc (i : Fin n) : killLast R n (X i.castSucc) = X i := by
  simp [killLast]

/-- Setting the last variable to zero sends the last variable to zero. -/
@[simp]
theorem killLast_X_last : killLast R n (X (Fin.last n)) = 0 := by
  simp [killLast]

/-- Setting the last variable to zero undoes the inclusion of the first `n` variables. -/
theorem killLast_rename_castSucc (q : MvPolynomial (Fin n) R) :
    killLast R n (rename Fin.castSucc q) = q := by
  simp [killLast, aeval_rename, Function.comp_def, aeval_X_left_apply]

/-- Setting the last variable to zero is surjective. -/
theorem surjective_killLast : Function.Surjective (killLast R n) :=
  fun q => ⟨rename Fin.castSucc q, killLast_rename_castSucc R n q⟩

/-- The ideal generated by the last variable lies in the kernel of `killLast`. -/
theorem span_X_last_le_ker_killLast :
    Ideal.span {X (Fin.last n)} ≤ RingHom.ker (killLast R n).toRingHom := by
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
  exact killLast_X_last R n

/-- The last variable vanishes in the quotient by the ideal it generates. -/
theorem mk_X_last_eq_zero :
    Ideal.Quotient.mk (Ideal.span {X (Fin.last n)} :
      Ideal (MvPolynomial (Fin (n + 1)) R)) (X (Fin.last n)) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)

/-- Modulo the last variable, every class is the class of a polynomial in the first `n`
variables. -/
theorem exists_mk_rename_castSucc_eq
    (x : MvPolynomial (Fin (n + 1)) R ⧸ (Ideal.span {X (Fin.last n)} :
      Ideal (MvPolynomial (Fin (n + 1)) R))) :
    ∃ q : MvPolynomial (Fin n) R,
      Ideal.Quotient.mk _ (rename Fin.castSucc q) = x := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction p using MvPolynomial.induction_on with
  | C r => exact ⟨C r, by rw [rename_C]⟩
  | add p q hp hq =>
    obtain ⟨p', hp'⟩ := hp
    obtain ⟨q', hq'⟩ := hq
    exact ⟨p' + q', by rw [map_add, map_add, hp', hq', map_add]⟩
  | mul_X p i hp =>
    obtain ⟨p', hp'⟩ := hp
    induction i using Fin.lastCases with
    | last =>
      refine ⟨0, ?_⟩
      rw [map_zero, map_zero, map_mul, mk_X_last_eq_zero, mul_zero]
    | cast j =>
      refine ⟨p' * X j, ?_⟩
      rw [map_mul, map_mul, map_mul, rename_X, hp']

/-- **The kernel of setting the last variable to zero is generated by that variable.** -/
theorem ker_killLast :
    RingHom.ker (killLast R n).toRingHom = Ideal.span {X (Fin.last n)} := by
  refine le_antisymm (fun p hp => ?_) (span_X_last_le_ker_killLast R n)
  obtain ⟨q, hq⟩ := exists_mk_rename_castSucc_eq R n (Ideal.Quotient.mk _ p)
  have hmem : rename Fin.castSucc q - p ∈
      (Ideal.span {X (Fin.last n)} : Ideal (MvPolynomial (Fin (n + 1)) R)) :=
    Ideal.Quotient.eq.mp hq
  have hp' : killLast R n p = 0 := RingHom.mem_ker.mp hp
  have hzero : killLast R n (rename Fin.castSucc q - p) = 0 :=
    RingHom.mem_ker.mp (span_X_last_le_ker_killLast R n hmem)
  rw [map_sub, killLast_rename_castSucc, hp', sub_zero] at hzero
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← hq, hzero, map_zero, map_zero]

/-- Setting the last variable to zero preserves the grading by total degree. -/
theorem killLast_mem_homogeneousSubmodule {i : ℕ} {p : MvPolynomial (Fin (n + 1)) R}
    (hp : p ∈ homogeneousSubmodule (Fin (n + 1)) R i) :
    killLast R n p ∈ homogeneousSubmodule (Fin n) R i := by
  have hg : ∀ j : Fin (n + 1),
      ((Fin.lastCases 0 X : Fin (n + 1) → MvPolynomial (Fin n) R) j).IsHomogeneous 1 := by
    intro j
    induction j using Fin.lastCases with
    | last =>
      simpa using (mem_homogeneousSubmodule 1 (0 : MvPolynomial (Fin n) R)).1 (Submodule.zero_mem _)
    | cast k => simpa using isHomogeneous_X R k
  have h := ((mem_homogeneousSubmodule i p).1 hp).aeval (Fin.lastCases 0 X) hg
  rw [one_mul] at h
  exact (mem_homogeneousSubmodule i _).2 h

/-- **Setting the last variable to zero carries the homogeneous polynomials of each degree onto
the homogeneous polynomials of that degree**: a homogeneous polynomial in the first `n` variables
is the image of itself, included in one variable more. -/
theorem exists_isHomogeneous_killLast_eq (i : ℕ) (q : MvPolynomial (Fin n) R)
    (hq : q ∈ homogeneousSubmodule (Fin n) R i) :
    ∃ p ∈ homogeneousSubmodule (Fin (n + 1)) R i, killLast R n p = q := by
  refine ⟨rename Fin.castSucc q, ?_, killLast_rename_castSucc R n q⟩
  exact (mem_homogeneousSubmodule i _).2
    (((mem_homogeneousSubmodule i q).1 hq).rename_isHomogeneous)

/-- Setting the last variable to zero, as a homomorphism of graded rings. -/
def killLastGradedHom :
    homogeneousSubmodule (Fin (n + 1)) R →+*ᵍ homogeneousSubmodule (Fin n) R where
  __ := (killLast R n).toRingHom
  map_mem ha := killLast_mem_homogeneousSubmodule R n ha

/-- The graded homomorphism `killLastGradedHom` acts on polynomials as `killLast`. -/
@[simp]
theorem killLastGradedHom_apply (p : MvPolynomial (Fin (n + 1)) R) :
    killLastGradedHom R n p = killLast R n p := rfl

end Stacks

end
