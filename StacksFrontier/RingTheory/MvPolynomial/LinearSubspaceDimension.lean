module

public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.LinearAlgebra.StdBasis
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import StacksFrontier.RingTheory.MvPolynomial.HypersurfaceDimension

/-!
# The dimension of a linear subspace of affine space

A linear subspace of codimension `c` in affine `r`-space over a field `κ` — the closed subscheme
of `𝔸^r_κ` cut out by an ideal generated by `c` linearly independent linear forms — has dimension
`r - c`.  The bound `≤ r - c` needs no hypothesis on the ideal beyond *containing* a
`c`-dimensional space of linear forms: cutting by more can only make the quotient smaller.

The subspace arrives as the kernel of a surjective linear map `φ : κ^r → κ^c` (in the dimension
count of [Stacks, Tag 0FD6], as the kernel of the evaluation `ev_x` at a closed point), and the
ideal cutting it out is then generated by the `c` coordinate forms of `φ`.

## Main definitions

* `Stacks.LinearSubspace.linearForm`: the `κ`-linear map sending a coefficient vector
  `a : ι → κ` to the linear form `∑ i, a i * X i` of `κ[ι]`.

## Main results

* `Stacks.LinearSubspace.ringKrullDim_quotient_le_of_linearForm_mem`: **`dim κ[ι]/I ≤ r - c`**
  for an ideal `I` containing the linear forms of a `c`-dimensional space of coefficient
  vectors, where `r = #ι`.
* `Stacks.LinearSubspace.ringKrullDim_quotient_le_of_linearIndependent`: the same for an ideal
  containing `c` linearly independent linear forms.
* `Stacks.LinearSubspace.ringKrullDim_quotient_le_of_surjective`: the same for the ideal cutting
  out the kernel of a surjective linear map `φ : κ^ι → κ^τ`, which is generated by the
  coordinate forms of `φ`; here `c = #τ`.
* `Stacks.LinearSubspace.ringKrullDim_quotient_span_linearForm`: **equality** `dim κ[ι]/I = r - c`
  for the ideal `I` generated by *all* the linear forms of a `c`-dimensional space of coefficient
  vectors, i.e. for the ideal cutting out the subspace itself.
* `Stacks.LinearSubspace.ringKrullDim_quotient_span_eq_of_surjective`: the same equality for the
  kernel of a surjective linear map `φ : κ^ι → κ^τ`, whose ideal is generated by the coordinate
  forms of `φ`.
* `Stacks.LinearSubspace.topologicalKrullDim_quotient_le_of_linearForm_mem`,
  `Stacks.LinearSubspace.topologicalKrullDim_quotient_le_of_surjective` and
  `Stacks.LinearSubspace.topologicalKrullDim_quotient_span_eq_of_surjective`: the topological
  forms of the three statements above.
* `Stacks.LinearSubspace.topologicalKrullDim_quotient_le_finrank_ker` and
  `Stacks.LinearSubspace.topologicalKrullDim_quotient_span_eq_finrank_ker`: the last two with
  the bound read as `dim (ker φ)`, which is the form in which a fibre dimension arrives.

## Implementation notes

Both bounds are comparisons with a polynomial ring, not inductions on the number of equations.

For `≤`: the images of the variables in `κ[ι]/I` span a `κ`-subspace of dimension at most
`r - c`, because they are the image of the `r`-dimensional space of linear forms under a map
whose kernel contains the `c`-dimensional space cut away.  A basis of that image generates
`κ[ι]/I` as a `κ`-algebra, so `κ[ι]/I` is a quotient of a polynomial ring in `r - c` variables
and `ringKrullDim_le_of_surjective` applies.

For `≥`: the substitution `X i ↦ ` the `i`-th coordinate form of the quotient map
`κ^ι → κ^ι/W` is an algebra map `κ[ι] → κ[r - c]` killing every linear form of `W`, so it
factors through `κ[ι]/I`, and it is surjective because it hits every variable.  So `κ[r - c]` is
in turn a quotient of `κ[ι]/I`.  (Both maps together are the isomorphism `κ[ι]/I ≅ κ[r - c]`,
but only the two surjections are needed.)

Dimensions live in `WithBot ℕ∞`, which has no subtraction, so `r - c` is computed in `ℕ` and
cast; the inequality `c ≤ r` that makes this the honest difference is automatic, `c` being the
dimension of a subspace of an `r`-dimensional space.

No `@[stacks]` attribute is attached: this is dimension theory used inside the proof of
Tag 0FD6, not the assertion of a tag.

## References

* [Stacks Project, Tag 0FD6](https://stacks.math.columbia.edu/tag/0FD6)
-/

@[expose] public noncomputable section

open MvPolynomial

universe u v w

namespace Stacks.LinearSubspace

variable {κ : Type u} [Field κ] {ι : Type v} [Fintype ι]

/-- The linear form `∑ i, a i * X i` of `κ[ι]` with coefficient vector `a`, as a `κ`-linear map
in `a`.  A linear subspace of `𝔸^ι_κ` is cut out by an ideal generated by such forms. -/
def linearForm : (ι → κ) →ₗ[κ] MvPolynomial ι κ where
  toFun a := ∑ i, C (a i) * X i
  map_add' a b := by
    simp only [Pi.add_apply, map_add, add_mul]
    exact Finset.sum_add_distrib
  map_smul' c a := by
    simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, Finset.smul_sum,
      smul_eq_C_mul, mul_assoc]

/-- The linear form with coefficient vector `a` is `∑ i, C (a i) * X i`. -/
theorem linearForm_apply (a : ι → κ) : linearForm a = ∑ i, C (a i) * X i := rfl

/-- The linear form with coefficient vector `Pi.single i 1` is the variable `X i`. -/
@[simp]
theorem linearForm_single [DecidableEq ι] (i : ι) :
    linearForm (Pi.single i 1 : ι → κ) = X i := by
  rw [linearForm_apply, Finset.sum_eq_single i (fun j _ hj => by simp [Pi.single_eq_of_ne hj])
    (fun h => absurd (Finset.mem_univ i) h)]
  simp

omit [Fintype ι] in
/-- **A quotient generated by few elements has small dimension.**  If the images of the variables
in `κ[ι]/I` lie in the `κ`-span of a family `t` indexed by a finite type `σ`, then `κ[ι]/I` is a
quotient of the polynomial ring `κ[σ]`, so its Krull dimension is at most `#σ`. -/
theorem ringKrullDim_quotient_le_of_mem_span {I : Ideal (MvPolynomial ι κ)} {σ : Type w}
    [Finite σ] (t : σ → MvPolynomial ι κ ⧸ I)
    (h : ∀ i, Ideal.Quotient.mk I (X i) ∈ Submodule.span κ (Set.range t)) :
    ringKrullDim (MvPolynomial ι κ ⧸ I) ≤ (Nat.card σ : WithBot ℕ∞) := by
  have hspan : Submodule.span κ (Set.range t) ≤
      Subalgebra.toSubmodule (Algebra.adjoin κ (Set.range t)) :=
    Submodule.span_le.2 fun _ hx => Algebra.subset_adjoin hx
  have hX : Algebra.adjoin κ (Set.range fun i => Ideal.Quotient.mk I (X i)) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    have he : (aeval (fun i => (Ideal.Quotient.mk I (X i) : MvPolynomial ι κ ⧸ I)) :
        MvPolynomial ι κ →ₐ[κ] _) = Ideal.Quotient.mkₐ κ I :=
      MvPolynomial.algHom_ext fun i => by simp
    rw [he, AlgHom.range_eq_top]
    exact Ideal.Quotient.mkₐ_surjective κ I
  have hsurj : Function.Surjective (aeval t : MvPolynomial σ κ →ₐ[κ] MvPolynomial ι κ ⧸ I) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, eq_top_iff, ← hX]
    exact Algebra.adjoin_le (Set.range_subset_iff.2 fun i => hspan (h i))
  exact (ringKrullDim_le_of_surjective (aeval t : MvPolynomial σ κ →ₐ[κ] _).toRingHom
    hsurj).trans_eq (Stacks.MvPolynomial.ringKrullDim_mvPolynomial κ σ)

/-- **An ideal containing a `c`-dimensional space of linear forms cuts the dimension of `κ[ι]`
down to at most `r - c`**, where `r = #ι`.  No hypothesis is made on the rest of `I`: a larger
ideal only makes the quotient smaller. -/
theorem ringKrullDim_quotient_le_of_linearForm_mem (I : Ideal (MvPolynomial ι κ))
    (W : Submodule κ (ι → κ)) (hW : ∀ a ∈ W, linearForm a ∈ I) :
    ringKrullDim (MvPolynomial ι κ ⧸ I) ≤
      ((Fintype.card ι - Module.finrank κ W : ℕ) : WithBot ℕ∞) := by
  classical
  set g : (ι → κ) →ₗ[κ] (MvPolynomial ι κ ⧸ I) :=
    (Ideal.Quotient.mkₐ κ I).toLinearMap ∘ₗ linearForm with hg
  have hker : W ≤ LinearMap.ker g := fun a ha => by
    simpa [hg] using (Ideal.Quotient.eq_zero_iff_mem (I := I)).2 (hW a ha)
  have hrk : Module.finrank κ (LinearMap.range g) ≤ Fintype.card ι - Module.finrank κ W := by
    have h1 := LinearMap.finrank_range_add_finrank_ker g
    have h2 : Module.finrank κ W ≤ Module.finrank κ (LinearMap.ker g) :=
      Submodule.finrank_mono hker
    have h3 : Module.finrank κ (ι → κ) = Fintype.card ι := by simp
    omega
  set b := Module.finBasis κ (LinearMap.range g) with hb
  have hspan : Submodule.span κ (Set.range fun j => ((b j : MvPolynomial ι κ ⧸ I))) =
      LinearMap.range g := by
    have hr : (Set.range fun j => ((b j : MvPolynomial ι κ ⧸ I))) =
        (LinearMap.range g).subtype '' Set.range b := by
      rw [← Set.range_comp]
      rfl
    rw [hr, ← Submodule.map_span, b.span_eq, Submodule.map_subtype_top]
  refine le_trans (ringKrullDim_quotient_le_of_mem_span (fun j => ((b j : _))) ?_) ?_
  · intro i
    rw [hspan]
    exact ⟨Pi.single i 1, by simp [hg]⟩
  · simpa using (Nat.cast_le (α := WithBot ℕ∞)).2 hrk

/-- If an ideal contains the linear forms of a family `a`, it contains those of its `κ`-span. -/
private theorem linearForm_mem_of_mem_span {σ : Type w} {I : Ideal (MvPolynomial ι κ)}
    {a : σ → (ι → κ)} (hmem : ∀ j, linearForm (a j) ∈ I) {x : ι → κ}
    (hx : x ∈ Submodule.span κ (Set.range a)) : linearForm x ∈ I :=
  (Submodule.span_le.2 (Set.range_subset_iff.2 hmem) :
    Submodule.span κ (Set.range a) ≤ (Submodule.restrictScalars κ I).comap linearForm) hx

/-- **An ideal containing `c` linearly independent linear forms cuts the dimension of `κ[ι]`
down to at most `r - c`**, where `r = #ι`. -/
theorem ringKrullDim_quotient_le_of_linearIndependent {τ : Type w} [Fintype τ]
    (I : Ideal (MvPolynomial ι κ)) (a : τ → (ι → κ)) (ha : LinearIndependent κ a)
    (hmem : ∀ j, linearForm (a j) ∈ I) :
    ringKrullDim (MvPolynomial ι κ ⧸ I) ≤
      ((Fintype.card ι - Fintype.card τ : ℕ) : WithBot ℕ∞) := by
  have := ringKrullDim_quotient_le_of_linearForm_mem I (Submodule.span κ (Set.range a))
    fun _ hx => linearForm_mem_of_mem_span hmem hx
  rwa [finrank_span_eq_card ha] at this

variable {τ : Type w} [Fintype τ]

omit [Fintype ι] [Fintype τ] in
/-- The coefficient vectors of a surjective linear map `φ : κ^ι → κ^τ` — the `j`-th being
`i ↦ (φ eᵢ) j`, the coefficient vector of the `j`-th coordinate form of `φ` — are linearly
independent. -/
theorem linearIndependent_coeff_of_surjective [Finite ι] [Finite τ] [DecidableEq ι]
    {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ) :
    LinearIndependent κ fun (j : τ) (i : ι) => φ (Pi.single i 1) j := by
  classical
  have := Fintype.ofFinite τ
  rw [Fintype.linearIndependent_iff]
  intro c hc j₀
  set χ : (τ → κ) →ₗ[κ] κ := ∑ j, c j • LinearMap.proj j with hχ
  have hχφ : χ ∘ₗ φ = 0 := by
    refine (Pi.basisFun κ ι).ext fun i => ?_
    have hci : ∑ j, c j * φ (Pi.single i 1) j = 0 := by simpa using congrFun hc i
    simpa [hχ, Pi.basisFun_apply, mul_comm] using hci
  have hχ0 : χ = 0 := by
    refine LinearMap.ext fun y => ?_
    obtain ⟨x, rfl⟩ := hφ y
    simpa using LinearMap.congr_fun hχφ x
  simpa [hχ, Pi.single_apply, Finset.sum_ite_eq] using LinearMap.congr_fun hχ0 (Pi.single j₀ 1)

/-- **The ideal cutting out the kernel of a surjective linear map `φ : κ^ι → κ^τ` cuts the
dimension of `κ[ι]` down to at most `r - c`**, where `r = #ι` and `c = #τ`: it suffices that the
ideal contain the `c` coordinate forms of `φ`.  This is the shape in which a linear subspace
given as a kernel is met. -/
theorem ringKrullDim_quotient_le_of_surjective [DecidableEq ι] (I : Ideal (MvPolynomial ι κ))
    {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ)
    (hmem : ∀ j, linearForm (fun i => φ (Pi.single i 1) j) ∈ I) :
    ringKrullDim (MvPolynomial ι κ ⧸ I) ≤
      ((Fintype.card ι - Fintype.card τ : ℕ) : WithBot ℕ∞) :=
  ringKrullDim_quotient_le_of_linearIndependent I _
    (linearIndependent_coeff_of_surjective hφ) hmem

/-- **The ideal generated by the linear forms of a `c`-dimensional space `W` of coefficient
vectors cuts `κ[ι]` down to dimension exactly `r - c`**, where `r = #ι`: this is the subspace
`{a ∈ κ^r | ∀ w ∈ W, ∑ wᵢ aᵢ = 0}` of `𝔸^r_κ`, of dimension `r - c`.

Beyond the bound of `Stacks.LinearSubspace.ringKrullDim_quotient_le_of_linearForm_mem` this
needs the reverse surjection, the substitution sending `X i` to the `i`-th coordinate form of
the quotient map `κ^ι → κ^ι/W`, which kills every linear form of `W` and hits every variable. -/
theorem ringKrullDim_quotient_span_linearForm (W : Submodule κ (ι → κ)) :
    ringKrullDim (MvPolynomial ι κ ⧸ Ideal.span (linearForm '' (W : Set (ι → κ)))) =
      ((Fintype.card ι - Module.finrank κ W : ℕ) : WithBot ℕ∞) := by
  classical
  refine le_antisymm (ringKrullDim_quotient_le_of_linearForm_mem _ W
    fun a ha => Ideal.subset_span ⟨a, ha, rfl⟩) ?_
  set d := Fintype.card ι - Module.finrank κ W with hd
  have hdq : Module.finrank κ ((ι → κ) ⧸ W) = d := by
    rw [hd, Submodule.finrank_quotient]
    simp
  set β := Module.finBasisOfFinrankEq κ ((ι → κ) ⧸ W) hdq
  set μ : (ι → κ) →ₗ[κ] (Fin d → κ) := β.equivFun.toLinearMap ∘ₗ W.mkQ with hμ
  have hμW : ∀ a ∈ W, μ a = 0 := fun a ha => by
    simp [hμ, (Submodule.Quotient.mk_eq_zero W).2 ha]
  have hμsurj : Function.Surjective μ := β.equivFun.surjective.comp W.mkQ_surjective
  set ψ : MvPolynomial ι κ →ₐ[κ] MvPolynomial (Fin d) κ :=
    aeval (fun i => linearForm (μ (Pi.single i 1))) with hψ
  have hkey : ∀ a, ψ (linearForm a) = linearForm (μ a) := by
    have h : (ψ.toLinearMap ∘ₗ linearForm : (ι → κ) →ₗ[κ] MvPolynomial (Fin d) κ)
        = linearForm ∘ₗ μ :=
      (Pi.basisFun κ ι).ext fun i => by simp [hψ, Pi.basisFun_apply]
    exact LinearMap.congr_fun h
  have hker : Ideal.span (linearForm '' (W : Set (ι → κ))) ≤
      RingHom.ker (ψ : MvPolynomial ι κ →+* MvPolynomial (Fin d) κ) := by
    rw [Ideal.span_le]
    rintro _ ⟨a, ha, rfl⟩
    simp [RingHom.mem_ker, hkey a, hμW a ha]
  set Ψ := Ideal.Quotient.liftₐ (Ideal.span (linearForm '' (W : Set (ι → κ)))) ψ
    fun _ hx => hker hx
  have hΨsurj : Function.Surjective Ψ := by
    rw [← AlgHom.range_eq_top, eq_top_iff, ← MvPolynomial.adjoin_range_X]
    refine Algebra.adjoin_le ?_
    rintro _ ⟨j, rfl⟩
    obtain ⟨a, ha⟩ := hμsurj (Pi.single j 1)
    refine ⟨Ideal.Quotient.mk _ (linearForm a), ?_⟩
    show ψ (linearForm a) = X j
    rw [hkey a, ha, linearForm_single]
  calc ((d : ℕ) : WithBot ℕ∞)
      = ringKrullDim (MvPolynomial (Fin d) κ) := by
        rw [Stacks.MvPolynomial.ringKrullDim_mvPolynomial]
        simp
    _ ≤ ringKrullDim (MvPolynomial ι κ ⧸ Ideal.span (linearForm '' (W : Set (ι → κ)))) :=
        ringKrullDim_le_of_surjective Ψ.toRingHom hΨsurj

/-- **The kernel of a surjective linear map `φ : κ^ι → κ^τ`, as a closed subscheme of `𝔸^ι_κ`,
has dimension exactly `r - c`**, where `r = #ι` and `c = #τ`: the ideal cutting it out is the one
generated by the `c` coordinate forms of `φ`. -/
theorem ringKrullDim_quotient_span_eq_of_surjective [DecidableEq ι]
    {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ) :
    ringKrullDim (MvPolynomial ι κ ⧸ Ideal.span
        (Set.range fun j => linearForm (fun i => φ (Pi.single i 1) j))) =
      ((Fintype.card ι - Fintype.card τ : ℕ) : WithBot ℕ∞) := by
  classical
  set a : τ → (ι → κ) := fun j i => φ (Pi.single i 1) j
  set W := Submodule.span κ (Set.range a) with hW
  have hspan : Ideal.span (linearForm '' (W : Set (ι → κ))) =
      Ideal.span (Set.range fun j => linearForm (a j)) := by
    refine le_antisymm ?_ (Ideal.span_mono ?_)
    · rw [Ideal.span_le]
      rintro _ ⟨x, hx, rfl⟩
      exact linearForm_mem_of_mem_span (a := a)
        (I := Ideal.span (Set.range fun j => linearForm (a j)))
        (fun j => Ideal.subset_span ⟨j, rfl⟩) hx
    · rintro _ ⟨j, rfl⟩
      exact ⟨a j, Submodule.subset_span ⟨j, rfl⟩, rfl⟩
  rw [← hspan, ringKrullDim_quotient_span_linearForm,
    hW, finrank_span_eq_card (linearIndependent_coeff_of_surjective hφ)]

/-- The topological form of `Stacks.LinearSubspace.ringKrullDim_quotient_le_of_linearForm_mem`. -/
theorem topologicalKrullDim_quotient_le_of_linearForm_mem (I : Ideal (MvPolynomial ι κ))
    (W : Submodule κ (ι → κ)) (hW : ∀ a ∈ W, linearForm a ∈ I) :
    topologicalKrullDim (PrimeSpectrum (MvPolynomial ι κ ⧸ I)) ≤
      ((Fintype.card ι - Module.finrank κ W : ℕ) : WithBot ℕ∞) :=
  (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).trans_le
    (ringKrullDim_quotient_le_of_linearForm_mem I W hW)

/-- **The closed subscheme of `𝔸^ι_κ` cut out by an ideal containing the coordinate forms of a
surjective linear map `φ : κ^ι → κ^τ` has dimension at most `r - c`**, `r = #ι` and `c = #τ`:
the topological form of `Stacks.LinearSubspace.ringKrullDim_quotient_le_of_surjective`, and the
bound a dimension count consumes. -/
theorem topologicalKrullDim_quotient_le_of_surjective [DecidableEq ι]
    (I : Ideal (MvPolynomial ι κ)) {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ)
    (hmem : ∀ j, linearForm (fun i => φ (Pi.single i 1) j) ∈ I) :
    topologicalKrullDim (PrimeSpectrum (MvPolynomial ι κ ⧸ I)) ≤
      ((Fintype.card ι - Fintype.card τ : ℕ) : WithBot ℕ∞) :=
  (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).trans_le
    (ringKrullDim_quotient_le_of_surjective I hφ hmem)

/-- **The kernel of a surjective linear map `φ : κ^ι → κ^τ`, as a closed subscheme of `𝔸^ι_κ`,
has dimension exactly `r - c`**: the topological form of
`Stacks.LinearSubspace.ringKrullDim_quotient_span_eq_of_surjective`. -/
theorem topologicalKrullDim_quotient_span_eq_of_surjective [DecidableEq ι]
    {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ) :
    topologicalKrullDim (PrimeSpectrum (MvPolynomial ι κ ⧸ Ideal.span
        (Set.range fun j => linearForm (fun i => φ (Pi.single i 1) j)))) =
      ((Fintype.card ι - Fintype.card τ : ℕ) : WithBot ℕ∞) :=
  (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).trans
    (ringKrullDim_quotient_span_eq_of_surjective hφ)

/-- The number `r - c` of the statements above is the dimension of the subspace `ker φ`
itself. -/
private theorem finrank_ker_eq_sub {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ) :
    Module.finrank κ (LinearMap.ker φ) = Fintype.card ι - Fintype.card τ := by
  have h := LinearMap.finrank_range_add_finrank_ker φ
  rw [LinearMap.range_eq_top.2 hφ, finrank_top] at h
  have hι : Module.finrank κ (ι → κ) = Fintype.card ι := by simp
  have hτ : Module.finrank κ (τ → κ) = Fintype.card τ := by simp
  omega

omit [Fintype τ] in
/-- **A closed subscheme of `𝔸^ι_κ` cut out by an ideal containing the coordinate forms of a
surjective linear map `φ` has dimension at most that of the subspace `ker φ`.**  This is
`Stacks.LinearSubspace.topologicalKrullDim_quotient_le_of_surjective` with its bound read as the
dimension of the kernel, which is the form in which a fibre bound arrives. -/
theorem topologicalKrullDim_quotient_le_finrank_ker [Finite τ] [DecidableEq ι]
    (I : Ideal (MvPolynomial ι κ)) {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ)
    (hmem : ∀ j, linearForm (fun i => φ (Pi.single i 1) j) ∈ I) :
    topologicalKrullDim (PrimeSpectrum (MvPolynomial ι κ ⧸ I)) ≤
      ((Module.finrank κ (LinearMap.ker φ) : ℕ) : WithBot ℕ∞) := by
  have := Fintype.ofFinite τ
  rw [finrank_ker_eq_sub hφ]
  exact topologicalKrullDim_quotient_le_of_surjective I hφ hmem

omit [Fintype τ] in
/-- **The kernel of a surjective linear map `φ : κ^ι → κ^τ`, as a closed subscheme of `𝔸^ι_κ`,
has dimension the dimension of `ker φ`.** -/
theorem topologicalKrullDim_quotient_span_eq_finrank_ker [Finite τ] [DecidableEq ι]
    {φ : (ι → κ) →ₗ[κ] (τ → κ)} (hφ : Function.Surjective φ) :
    topologicalKrullDim (PrimeSpectrum (MvPolynomial ι κ ⧸ Ideal.span
        (Set.range fun j => linearForm (fun i => φ (Pi.single i 1) j)))) =
      ((Module.finrank κ (LinearMap.ker φ) : ℕ) : WithBot ℕ∞) := by
  have := Fintype.ofFinite τ
  rw [finrank_ker_eq_sub hφ]
  exact topologicalKrullDim_quotient_span_eq_of_surjective hφ

end Stacks.LinearSubspace

end
