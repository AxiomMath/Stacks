module

public import Mathlib.LinearAlgebra.DFinsupp
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import StacksFrontier.RingTheory.GradedAlgebra.NoetherianModel

/-!
# Ideals of a polynomial ring cut out coefficientwise

For a family of ideals `K` indexed by the monomials of `R[xᵢ : i ∈ σ]`, the monomials `m · a`
with `a ∈ K m` generate an ideal which, when the family is monotone for the divisibility order
on monomials, consists of exactly the polynomials whose coefficient at each monomial `m` lies in
`K m`. Such an ideal is homogeneous for the grading by total degree, and the graded pieces of the
quotient are direct sums of the cyclic modules `R ⧸ K m`.

## Main definitions

* `Stacks.coefficientIdeal`: the ideal generated by the monomials with coefficient in the ideal
  of their degree.
* `Stacks.coefficientQuotientMap`: a polynomial read as the family of its coefficients modulo the
  ideals of their degrees.

## Main results

* `Stacks.mem_coefficientIdeal_iff`: membership is the coefficientwise condition.
* `Stacks.coefficientIdeal_isHomogeneous`: the ideal is homogeneous for the total-degree grading.
* `Stacks.flat_quotientGrading`: each graded piece of the quotient is a flat `R`-module as soon as
  every `R ⧸ K m` is.
* `Stacks.bijective_algebraMap_quotientGrading_zero`: the base ring is the degree-zero part of the
  quotient when the family is trivial in degree zero.
* `Stacks.adjoin_range_X_quotientGrading_zero`: the variables generate the quotient over its
  degree-zero part.
-/

@[expose] public noncomputable section

namespace Stacks

open MvPolynomial Stacks.GradedModel

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable {σ : Type*} {R : Type u} [CommRing R]

/-- The ideal of `R[xᵢ]` generated by the monomials whose coefficient lies in the ideal attached
to their degree. -/
def coefficientIdeal (K : (σ →₀ ℕ) → Ideal R) : Ideal (MvPolynomial σ R) :=
  Ideal.span {p | ∃ d, ∃ a ∈ K d, p = monomial d a}

variable (K : (σ →₀ ℕ) → Ideal R)

/-- A monomial whose coefficient lies in the ideal of its degree belongs to the coefficient
ideal. -/
theorem monomial_mem_coefficientIdeal {d : σ →₀ ℕ} {a : R} (ha : a ∈ K d) :
    monomial d a ∈ coefficientIdeal K :=
  Ideal.subset_span ⟨d, a, ha, rfl⟩

/-- The polynomials all of whose coefficients lie in the ideal of their degree. This is an ideal
because the family is monotone. -/
private def coeffwiseIdeal (hK : Monotone K) : Ideal (MvPolynomial σ R) where
  carrier := {p | ∀ d, p.coeff d ∈ K d}
  zero_mem' := by simp
  add_mem' := fun hp hq d => by simpa using (K d).add_mem (hp d) (hq d)
  smul_mem' := by
    classical
    intro p q hq d
    change (p * q).coeff d ∈ K d
    rw [coeff_mul]
    refine Ideal.sum_mem _ fun ab hab => ?_
    have he := Finset.HasAntidiagonal.mem_antidiagonal.mp hab
    exact (K d).mul_mem_left _ (hK (he ▸ le_add_left le_rfl) (hq ab.2))

/-- Membership in the coefficient ideal is the coefficientwise condition. -/
theorem mem_coefficientIdeal_iff (hK : Monotone K) {p : MvPolynomial σ R} :
    p ∈ coefficientIdeal K ↔ ∀ d, p.coeff d ∈ K d := by
  classical
  refine ⟨fun hp => ?_, fun hp => ?_⟩
  · refine (?_ : coefficientIdeal K ≤ coeffwiseIdeal K hK) hp
    rw [coefficientIdeal, Ideal.span_le]
    rintro q ⟨d, a, ha, rfl⟩ e
    rw [coeff_monomial]
    split_ifs with h
    · exact h ▸ ha
    · exact zero_mem _
  · rw [← p.support_sum_monomial_coeff]
    exact Ideal.sum_mem _ fun d _ => monomial_mem_coefficientIdeal K (hp d)

/-- The coefficient ideal is homogeneous for the grading by total degree. -/
theorem coefficientIdeal_isHomogeneous :
    (coefficientIdeal K).IsHomogeneous (homogeneousSubmodule σ R) := by
  refine Ideal.homogeneous_span _ _ ?_
  rintro q ⟨d, a, _, rfl⟩
  exact ⟨d.degree, isHomogeneous_monomial a rfl⟩

/-- The quotient of a polynomial ring by a coefficient ideal is graded by total degree. -/
instance gradedAlgebraQuotientCoefficientIdeal :
    GradedAlgebra (quotientGrading (homogeneousSubmodule σ R) (coefficientIdeal K)) :=
  quotientGradedAlgebra _ (coefficientIdeal_isHomogeneous K)

/-- Reading off the coefficients of a polynomial modulo the ideals of their degrees. -/
def coefficientQuotientMap : MvPolynomial σ R →ₗ[R] Π₀ d, R ⧸ K d := by
  classical
  exact (DFinsupp.mapRange.linearMap fun d => (K d).mkQ).comp
    ((finsuppLequivDFinsupp R).toLinearMap.comp (basisMonomials σ R).repr.toLinearMap)

/-- The `d`-th component of `coefficientQuotientMap K p` is the class of the coefficient of `p` at
`d` modulo `K d`. -/
@[simp]
theorem coefficientQuotientMap_apply (p : MvPolynomial σ R) (d : σ →₀ ℕ) :
    coefficientQuotientMap K p d = Ideal.Quotient.mk (K d) (p.coeff d) := rfl

/-- A polynomial maps to zero exactly when each of its coefficients lies in the ideal of its
degree. -/
theorem coefficientQuotientMap_eq_zero_iff {p : MvPolynomial σ R} :
    coefficientQuotientMap K p = 0 ↔ ∀ d, p.coeff d ∈ K d := by
  rw [DFinsupp.ext_iff]
  exact forall_congr' fun d => Ideal.Quotient.eq_zero_iff_mem

/-- Every family of classes modulo the ideals `K d` is the image of a polynomial. -/
theorem coefficientQuotientMap_surjective :
    Function.Surjective (coefficientQuotientMap K) := by
  classical
  have h : Function.Surjective (DFinsupp.mapRange.linearMap fun d => (K d).mkQ) :=
    (DFinsupp.mapRange_surjective _ fun d => map_zero ((K d).mkQ)).mpr
      fun d => Submodule.mkQ_surjective _
  intro q
  obtain ⟨q', rfl⟩ := h q
  obtain ⟨q'', rfl⟩ := (finsuppLequivDFinsupp R).surjective q'
  obtain ⟨p, rfl⟩ := (basisMonomials σ R).repr.surjective q''
  exact ⟨p, rfl⟩

/-- The kernel of the quotient map by the coefficient ideal, read as an `R`-linear map. -/
private theorem ker_mkₐ_coefficientIdeal :
    LinearMap.ker (Ideal.Quotient.mkₐ R (coefficientIdeal K)).toLinearMap =
      (coefficientIdeal K).restrictScalars R := by
  ext p
  exact Ideal.Quotient.eq_zero_iff_mem

/-- On the degree-`n` polynomials, `coefficientQuotientMap K` is surjective when `K` is trivial
outside degree `n`. -/
private theorem coefficientQuotientMap_comp_subtype_surjective (n : ℕ)
    (hK : ∀ d : σ →₀ ℕ, d.degree ≠ n → K d = ⊤) :
    Function.Surjective
      (coefficientQuotientMap K ∘ₗ (homogeneousSubmodule σ R n).subtype) := by
  classical
  intro x
  choose rep hrep using fun d => Ideal.Quotient.mk_surjective (I := K d) (x d)
  have hsupp : ∀ d ∈ x.support, d.degree = n := by
    intro d hd
    by_contra hdn
    refine (DFinsupp.mem_support_iff.mp hd) ?_
    have : Subsingleton (R ⧸ K d) := by
      rw [hK d hdn]
      exact Ideal.Quotient.subsingleton_iff.mpr rfl
    exact Subsingleton.elim _ _
  refine ⟨⟨∑ d ∈ x.support, monomial d (rep d),
    Submodule.sum_mem _ fun d hd => isHomogeneous_monomial _ (hsupp d hd)⟩, ?_⟩
  refine DFinsupp.ext fun d => ?_
  have hcoeff : (∑ e ∈ x.support, monomial e (rep e)).coeff d =
      if d ∈ x.support then rep d else 0 := by
    simp [coeff_sum, coeff_monomial, Finset.sum_ite_eq' x.support d rep]
  simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype,
    coefficientQuotientMap_apply, hcoeff]
  split_ifs with hd
  · exact hrep d
  · rw [map_zero]
    exact (DFinsupp.notMem_support_iff.mp hd).symm

/-- The degree-`n` graded piece of `R[xᵢ] ⧸ coefficientIdeal K` is a flat `R`-module as soon as
every `R ⧸ K d` is. -/
theorem flat_quotientGrading (hK : Monotone K)
    (hflat : ∀ d, Module.Flat R (R ⧸ K d)) (n : ℕ) :
    Module.Flat R (quotientGrading (homogeneousSubmodule σ R) (coefficientIdeal K) n) := by
  classical
  obtain ⟨K', hK'⟩ : ∃ K' : (σ →₀ ℕ) → Ideal R,
      ∀ d, K' d = if d.degree = n then K d else ⊤ := ⟨_, fun _ => rfl⟩
  have hflat' : ∀ d, Module.Flat R (R ⧸ K' d) := by
    intro d
    by_cases h : d.degree = n
    · rw [hK' d, if_pos h]
      exact hflat d
    · rw [hK' d, if_neg h]
      infer_instance
  set 𝒜 := homogeneousSubmodule σ R
  set J := coefficientIdeal K with hJ
  set h : ↥(𝒜 n) →ₗ[R] MvPolynomial σ R ⧸ J :=
    (Ideal.Quotient.mkₐ R J).toLinearMap ∘ₗ (𝒜 n).subtype with hh
  set g : ↥(𝒜 n) →ₗ[R] Π₀ d, R ⧸ K' d :=
    coefficientQuotientMap K' ∘ₗ (𝒜 n).subtype
  have hmem : ∀ p ∈ 𝒜 n, (p ∈ J ↔ ∀ d, p.coeff d ∈ K' d) := by
    intro p hp
    rw [hJ, mem_coefficientIdeal_iff K hK]
    refine ⟨fun hpJ d => ?_, fun hpK d => ?_⟩
    · rw [hK' d]
      split_ifs with hd
      · exact hpJ d
      · exact Submodule.mem_top
    · by_cases hd : d.degree = n
      · simpa [hK' d, hd] using hpK d
      · rw [(mem_homogeneousSubmodule n p).mp hp |>.coeff_eq_zero hd]
        exact zero_mem _
  have hker : LinearMap.ker h = LinearMap.ker g := by
    ext q
    have h1 : h q = 0 ↔ (q : MvPolynomial σ R) ∈ J := Ideal.Quotient.eq_zero_iff_mem
    have h2 : g q = 0 ↔ ∀ d, (q : MvPolynomial σ R).coeff d ∈ K' d :=
      coefficientQuotientMap_eq_zero_iff K'
    simp only [LinearMap.mem_ker, h1, h2]
    exact hmem _ q.2
  have hgsurj : Function.Surjective g :=
    coefficientQuotientMap_comp_subtype_surjective K' n fun d hd => by rw [hK' d, if_neg hd]
  have hrange : LinearMap.range h = quotientGrading 𝒜 J n := by
    rw [hh, LinearMap.range_comp, Submodule.range_subtype]
    rfl
  refine Module.Flat.of_linearEquiv (?_ : _ ≃ₗ[R] Π₀ d, R ⧸ K' d)
  exact (LinearEquiv.ofEq _ _ hrange.symm).trans
    (h.quotKerEquivRange.symm.trans
      ((Submodule.quotEquivOfEq _ _ hker).trans (g.quotKerEquivOfSurjective hgsurj)))

/-- The base ring is the degree-zero part of `R[xᵢ] ⧸ coefficientIdeal K` when the family is
trivial in degree zero. -/
theorem bijective_algebraMap_quotientGrading_zero (hK : Monotone K) (hK0 : K 0 = ⊥) :
    Function.Bijective
      (algebraMap R ↥(quotientGrading (homogeneousSubmodule σ R) (coefficientIdeal K) 0)) := by
  classical
  refine ⟨fun r s hrs => ?_, ?_⟩
  · have h : Ideal.Quotient.mk (coefficientIdeal K) (C (r - s)) = 0 := by
      rw [map_sub, map_sub, sub_eq_zero]
      exact congrArg Subtype.val hrs
    rw [Ideal.Quotient.eq_zero_iff_mem, mem_coefficientIdeal_iff K hK] at h
    have h0 := h 0
    rw [hK0, Submodule.mem_bot, MvPolynomial.coeff_zero_C] at h0
    exact sub_eq_zero.mp h0
  · rintro ⟨x, p, hp, rfl⟩
    refine ⟨p.coeff 0, Subtype.ext ?_⟩
    have hpC : C (p.coeff 0) = p := by
      ext d
      rcases eq_or_ne d 0 with rfl | hd
      · simp
      · rw [coeff_C, if_neg (Ne.symm hd),
          (mem_homogeneousSubmodule 0 p).mp hp |>.coeff_eq_zero
            (fun hdeg => hd ((Finsupp.degree_eq_zero_iff d).mp hdeg))]
    exact congrArg (Ideal.Quotient.mk (coefficientIdeal K)) hpC

/-- The variables generate `R[xᵢ] ⧸ coefficientIdeal K` as an algebra over its degree-zero
part. -/
theorem adjoin_range_X_quotientGrading_zero :
    Algebra.adjoin ↥(quotientGrading (homogeneousSubmodule σ R) (coefficientIdeal K) 0)
        (Set.range fun i : σ => Ideal.Quotient.mk (coefficientIdeal K) (X i)) = ⊤ := by
  classical
  refine top_unique fun x hx => ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective (I := coefficientIdeal K) x
  clear hx
  induction p using MvPolynomial.induction_on with
  | C r =>
    have hx : Ideal.Quotient.mk (coefficientIdeal K) (C r) ∈
        quotientGrading (homogeneousSubmodule σ R) (coefficientIdeal K) 0 :=
      ⟨C r, isHomogeneous_C σ r, rfl⟩
    exact Subalgebra.algebraMap_mem _
      (⟨Ideal.Quotient.mk (coefficientIdeal K) (C r), hx⟩ :
        ↥(quotientGrading (homogeneousSubmodule σ R) (coefficientIdeal K) 0))
  | add p q hp hq =>
    rw [map_add]
    exact Subalgebra.add_mem _ hp hq
  | mul_X p i hp =>
    rw [map_mul]
    exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨i, rfl⟩)

end Stacks

end
