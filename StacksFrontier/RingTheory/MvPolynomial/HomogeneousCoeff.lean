module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Coefficients of a multiple of a homogeneous polynomial

Let `q` be a homogeneous polynomial of degree `n` and let `d` be a multidegree of total degree
`n`. The coefficient of `p * q` at `d` sees nothing of `p` beyond its constant term: it is
`p.coeff 0 * q.coeff d`. Indeed `MvPolynomial.coeff_mul` expands it as a sum over the
antidiagonal of `d`, and in a pair `(a, b)` with `a + b = d` the factor `q.coeff b` vanishes
unless `b` has total degree `n`, which forces `a = 0` and `b = d`.

This is the computation that makes a degree-`n` coefficient a linear functional on a polynomial
ring modulo an ideal generated by homogeneous polynomials of degree `n`: on such an ideal the
functional is determined by its values on the generators.

## Main results

* `MvPolynomial.IsHomogeneous.coeff_mul_of_degree_eq`: the coefficient of `p * q` at a
  multidegree of total degree `n`, for `q` homogeneous of degree `n`.
-/

@[expose] public section

namespace MvPolynomial

variable {σ R : Type*} [CommSemiring R]

/-- For `q` homogeneous of degree `n` and `d` a multidegree of total degree `n`, the coefficient
of `p * q` at `d` is `p.coeff 0 * q.coeff d`. -/
theorem IsHomogeneous.coeff_mul_of_degree_eq {n : ℕ} {q : MvPolynomial σ R}
    (hq : q.IsHomogeneous n) (p : MvPolynomial σ R) {d : σ →₀ ℕ} (hd : d.degree = n) :
    (p * q).coeff d = p.coeff 0 * q.coeff d := by
  classical
  rw [coeff_mul]
  refine Finset.sum_eq_single (0, d) ?_ ?_
  · rintro ⟨a, b⟩ hab hne
    rw [Finset.mem_antidiagonal] at hab
    rcases eq_or_ne b.degree n with hb | hb
    · exact absurd (Prod.ext (by
        have : a.degree + b.degree = d.degree := by rw [← map_add, hab]
        exact (Finsupp.degree_eq_zero_iff a).mp (by omega)) (by
        have : a.degree = 0 := by
          have : a.degree + b.degree = d.degree := by rw [← map_add, hab]
          omega
        rw [← hab, (Finsupp.degree_eq_zero_iff a).mp this, zero_add])) hne
    · rw [hq.coeff_eq_zero hb, mul_zero]
  · exact fun h => absurd (Finset.mem_antidiagonal.mpr (zero_add d)) h

end MvPolynomial

end
