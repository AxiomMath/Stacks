module

public import Mathlib.Algebra.MonoidAlgebra.MapDomain
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksFrontier.RingTheory.MvPolynomial.AwayMonomialBasis

/-!
# Polynomials as Laurent polynomials, and powers of an ideal of variables

Let `R` be a commutative ring and `σ` a set of variables. A polynomial `p ∈ R[σ]` is a finitely
supported function on exponent vectors `σ →₀ ℕ`; reading the exponents as integers embeds
`R[σ]` into the Laurent polynomial ring `R[σ →₀ ℤ]`, in which every variable is invertible. This
file records that embedding and the description of the powers of the ideal generated by a family
of variables in terms of exponents: `p ∈ (X_{v j} : j)^D` exactly when every monomial of `p` has
total degree at least `D` in the variables `X_{v j}`.

## Main definitions

* `Stacks.LaurentCoeff.toLaurent`: the embedding `R[σ] → R[σ →₀ ℤ]`.
* `Stacks.LaurentCoeff.partialDegree`: the total degree of an exponent vector in a finite family
  of the variables.

## Main results

* `Stacks.LaurentCoeff.toLaurent_injective`, `Stacks.LaurentCoeff.coeff_toLaurent_natToInt` and
  `Stacks.LaurentCoeff.exists_eq_natToInt_of_mem_support`: the embedding is injective and keeps
  the coefficients.
* `Stacks.LaurentCoeff.le_partialDegree_of_mem_pow`: every monomial of an element of the `D`-th
  power of the ideal of the variables `X_{v j}` has degree at least `D` in those variables.
* `Stacks.LaurentCoeff.monomial_mem_pow`: conversely a monomial of degree at least `D` in those
  variables lies in the `D`-th power.
-/

@[expose] public noncomputable section

open MvPolynomial

namespace Stacks.LaurentCoeff

open Stacks.PartialLaurent (natToInt natToInt_injective)

variable (R : Type*) [CommRing R] {σ : Type*}

/-- **The embedding of polynomials into Laurent polynomials**: the exponents of a monomial are
read as integers. -/
def toLaurent : MvPolynomial σ R →+* AddMonoidAlgebra R (σ →₀ ℤ) :=
  AddMonoidAlgebra.mapDomainRingHom R natToInt

variable {R}

/-- The coefficients of `toLaurent R p` are those of `p`, with exponents read as integers. -/
theorem coeff_toLaurent (p : MvPolynomial σ R) :
    (toLaurent R p).coeff = Finsupp.mapDomain natToInt (AddMonoidAlgebra.coeff p) := rfl

/-- The embedding keeps the coefficients. -/
theorem coeff_toLaurent_natToInt (p : MvPolynomial σ R) (β : σ →₀ ℕ) :
    (toLaurent R p).coeff (natToInt β) = p.coeff β := by
  rw [coeff_toLaurent]
  exact Finsupp.mapDomain_apply_of_injective natToInt_injective _ _

/-- A Laurent monomial occurring in the image of a polynomial has nonnegative exponents. -/
theorem exists_eq_natToInt_of_mem_support (p : MvPolynomial σ R) {w : σ →₀ ℤ}
    (hw : w ∈ (toLaurent R p).coeff.support) : ∃ β ∈ p.support, w = natToInt β := by
  classical
  rw [coeff_toLaurent] at hw
  obtain ⟨β, hβ, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support hw)
  exact ⟨β, hβ, rfl⟩

/-- The embedding is injective. -/
theorem toLaurent_injective : Function.Injective (toLaurent (R := R) (σ := σ)) :=
  AddMonoidAlgebra.mapDomain_injective natToInt_injective

/-- The image of a monomial. -/
theorem toLaurent_monomial (β : σ →₀ ℕ) (r : R) :
    toLaurent R (monomial β r) = AddMonoidAlgebra.single (natToInt β) r :=
  AddMonoidAlgebra.mapDomain_single

/-- The image of a variable. -/
theorem toLaurent_X (v : σ) :
    toLaurent R (X v) = AddMonoidAlgebra.single (Finsupp.single v 1) 1 := by
  rw [X, toLaurent_monomial]
  congr 1
  ext
  simp [natToInt]

/-- A Laurent monomial with coefficient one is invertible. -/
theorem isUnit_single (w : σ →₀ ℤ) : IsUnit (AddMonoidAlgebra.single w (1 : R)) :=
  ⟨⟨AddMonoidAlgebra.single w 1, AddMonoidAlgebra.single (-w) 1,
    by rw [AddMonoidAlgebra.single_mul_single, add_neg_cancel, one_mul]; rfl,
    by rw [AddMonoidAlgebra.single_mul_single, neg_add_cancel, one_mul]; rfl⟩, rfl⟩

/-- Every variable is invertible in the Laurent polynomial ring. -/
theorem isUnit_toLaurent_X (v : σ) : IsUnit (toLaurent R (X v)) := by
  rw [toLaurent_X]
  exact isUnit_single _

/-! ### Powers of the ideal of a family of variables -/

variable {ι : Type*} [Fintype ι] (v : ι → σ)

/-- The total degree of an exponent vector in the variables `X_{v j}`. -/
def partialDegree (β : σ →₀ ℕ) : ℕ := ∑ j, β (v j)

/-- The degree in the variables `X_{v j}` is additive in the exponent vector. -/
theorem partialDegree_add (β γ : σ →₀ ℕ) :
    partialDegree v (β + γ) = partialDegree v β + partialDegree v γ := by
  simp [partialDegree, Finset.sum_add_distrib]

/-- **Every monomial of an element of the `D`-th power of the ideal of the variables `X_{v j}`
has degree at least `D` in those variables**, provided `v` is injective. -/
theorem le_partialDegree_of_mem_pow (hv : Function.Injective v) {D : ℕ} {p : MvPolynomial σ R}
    (hp : p ∈ Ideal.span (Set.range fun j => (X (v j) : MvPolynomial σ R)) ^ D) :
    ∀ β ∈ p.support, D ≤ partialDegree v β := by
  classical
  induction D generalizing p with
  | zero => exact fun _ _ => Nat.zero_le _
  | succ D ih =>
    rw [pow_succ] at hp
    refine Submodule.mul_induction_on hp ?_ ?_
    · intro a ha b hb β hβ
      obtain ⟨β₁, hβ₁, β₂, hβ₂, rfl⟩ : ∃ β₁ ∈ a.support, ∃ β₂ ∈ b.support, β = β₁ + β₂ := by
        have := support_mul a b hβ
        simpa [Finset.mem_add, eq_comm] using this
      have h1 := ih ha β₁ hβ₁
      have hrange : Set.range (fun j => (X (v j) : MvPolynomial σ R)) =
          (X : σ → MvPolynomial σ R) '' Set.range v := Set.range_comp X v
      have hb' := hb
      rw [hrange, mem_ideal_span_X_image] at hb'
      obtain ⟨s, ⟨j, rfl⟩, hj⟩ := hb' β₂ hβ₂
      rw [partialDegree_add]
      have h2 : 1 ≤ partialDegree v β₂ :=
        le_trans (Nat.one_le_iff_ne_zero.2 hj) (Finset.single_le_sum (f := fun j => β₂ (v j))
          (fun _ _ => Nat.zero_le _) (Finset.mem_univ j))
      omega
    · intro a b ha hb β hβ
      rcases Finset.mem_union.1 (support_add hβ) with h | h
      · exact ha β h
      · exact hb β h

/-- The degree of a single variable `X_{v j}` in the variables of the family is one. -/
theorem partialDegree_single (hv : Function.Injective v) (j : ι) :
    partialDegree v (Finsupp.single (v j) 1) = 1 := by
  classical
  rw [partialDegree, Finset.sum_eq_single j]
  · simp
  · intro k _ hk
    rw [Finsupp.single_apply, if_neg (fun h => hk (hv h).symm)]
  · simp

/-- **A monomial of degree at least `D` in the variables `X_{v j}` lies in the `D`-th power of
their ideal**, provided `v` is injective. -/
theorem monomial_mem_pow (hv : Function.Injective v) {D : ℕ} (β : σ →₀ ℕ)
    (hβ : D ≤ partialDegree v β) (r : R) :
    monomial β r ∈ Ideal.span (Set.range fun j => (X (v j) : MvPolynomial σ R)) ^ D := by
  classical
  induction D generalizing β with
  | zero => simp
  | succ D ih =>
    obtain ⟨j, hj⟩ : ∃ j, 0 < β (v j) := by
      by_contra h
      push Not at h
      have : partialDegree v β = 0 :=
        Finset.sum_eq_zero fun j _ => Nat.le_zero.1 (h j)
      omega
    have hle : Finsupp.single (v j) 1 ≤ β := by
      intro s
      rw [Finsupp.single_apply]
      split_ifs with hs
      · rw [← hs]; exact hj
      · exact Nat.zero_le _
    have hβ' : β = (β - Finsupp.single (v j) 1) + Finsupp.single (v j) 1 :=
      (tsub_add_cancel_of_le hle).symm
    have hdeg : D ≤ partialDegree v (β - Finsupp.single (v j) 1) := by
      have h := congrArg (partialDegree v) hβ'
      rw [partialDegree_add, partialDegree_single v hv] at h
      omega
    rw [hβ', monomial_add_single, pow_one, pow_succ]
    exact Ideal.mul_mem_mul (ih _ hdeg) (Ideal.subset_span ⟨j, rfl⟩)

end Stacks.LaurentCoeff

end
