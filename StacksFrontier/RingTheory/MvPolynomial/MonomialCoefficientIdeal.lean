module

public import Mathlib.Algebra.MvPolynomial.Division
public import StacksFrontier.RingTheory.MvPolynomial.CoefficientIdeal

/-!
# Coefficientwise ideals cut out by a single monomial

Two coefficientwise families of ideals of `R` are computed here: the family which is zero in
every degree, whose coefficientwise ideal is the zero ideal, and the family attached to a
monomial `d₀`, which is the unit ideal in the degrees divisible by `d₀` and zero elsewhere and
whose coefficientwise ideal is generated by the monomial `d₀` itself.

These are the families that appear as the fibres of a coefficientwise projective family: a
family of ideals becomes one of these two after extending the coefficients to a residue field,
because the ideals in play extend to either `⊥` or `⊤` there.

## Main definitions

* `Stacks.monomialFamily`: the coefficientwise family of a single monomial.

## Main results

* `Stacks.coefficientIdeal_const_bot`: the zero family cuts out the zero ideal.
* `Stacks.coefficientIdeal_monomialFamily`: the family of a monomial cuts out the ideal
  generated by that monomial.
-/

@[expose] public section

namespace Stacks

open MvPolynomial

universe u

variable {σ : Type*} {R : Type u} [CommRing R]

/-- The coefficientwise ideal of the family that is zero in every degree is the zero ideal. -/
theorem coefficientIdeal_const_bot :
    coefficientIdeal (fun _ : σ →₀ ℕ => (⊥ : Ideal R)) = ⊥ := by
  rw [coefficientIdeal, Ideal.span_eq_bot]
  rintro q ⟨d, a, ha, rfl⟩
  rw [Ideal.mem_bot.mp ha, map_zero]

open scoped Classical in
/-- The coefficientwise family attached to a monomial `d₀`: the unit ideal in the degrees
divisible by `d₀`, the zero ideal elsewhere. -/
noncomputable def monomialFamily (R : Type u) [CommRing R] (d₀ : σ →₀ ℕ) :
    (σ →₀ ℕ) → Ideal R :=
  fun d => if d₀ ≤ d then ⊤ else ⊥

/-- The family of the monomial `d₀` is the unit ideal in a degree divisible by `d₀`. -/
theorem monomialFamily_of_le {d₀ d : σ →₀ ℕ} (h : d₀ ≤ d) :
    monomialFamily R d₀ d = ⊤ := by
  classical
  rw [monomialFamily, ite_eq_left h]

/-- The family of the monomial `d₀` is the zero ideal in a degree not divisible by `d₀`. -/
theorem monomialFamily_of_not_le {d₀ d : σ →₀ ℕ} (h : ¬ d₀ ≤ d) :
    monomialFamily R d₀ d = ⊥ := by
  classical
  rw [monomialFamily, ite_eq_right h]

/-- The family of a monomial is monotone in the degree. -/
theorem monotone_monomialFamily (d₀ : σ →₀ ℕ) : Monotone (monomialFamily R d₀) := by
  intro d e hde
  by_cases h : d₀ ≤ d
  · rw [monomialFamily_of_le h, monomialFamily_of_le (h.trans hde)]
  · rw [monomialFamily_of_not_le h]
    exact bot_le

/-- The family of a nonzero monomial is zero in degree zero. -/
theorem monomialFamily_zero {d₀ : σ →₀ ℕ} (h : d₀ ≠ 0) : monomialFamily R d₀ 0 = ⊥ :=
  monomialFamily_of_not_le fun hle => h (le_bot_iff.mp hle)

/-- An element lies in the family of `d₀` in degree `d` iff it vanishes when `d₀ ∤ d`. -/
private theorem mem_monomialFamily_iff {d₀ d : σ →₀ ℕ} {a : R} :
    a ∈ monomialFamily R d₀ d ↔ (¬ d₀ ≤ d → a = 0) := by
  by_cases h : d₀ ≤ d
  · simp [monomialFamily_of_le h, h]
  · rw [monomialFamily_of_not_le h, Ideal.mem_bot]
    simp [h]

/-- The coefficientwise ideal of the family of the monomial `d₀` is the ideal generated by the
monomial `d₀`. -/
theorem coefficientIdeal_monomialFamily (d₀ : σ →₀ ℕ) :
    coefficientIdeal (monomialFamily R d₀) = Ideal.span {monomial d₀ (1 : R)} := by
  refine le_antisymm ?_ ?_
  · rw [coefficientIdeal, Ideal.span_le]
    rintro q ⟨d, a, ha, rfl⟩
    by_cases h : d₀ ≤ d
    · refine Ideal.mem_span_singleton.mpr ?_
      rw [monomial_dvd_monomial]
      exact ⟨Or.inr h, one_dvd a⟩
    · rw [SetLike.mem_coe, mem_monomialFamily_iff.mp ha h, map_zero]
      exact Ideal.zero_mem _
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    exact monomial_mem_coefficientIdeal _
      (mem_monomialFamily_iff.mpr fun h => (h le_rfl).elim)

/-- Membership in the ideal generated by a monomial is the vanishing of every coefficient at a
degree not divisible by that monomial. -/
theorem mem_span_monomial_iff {d₀ : σ →₀ ℕ} {p : MvPolynomial σ R} :
    p ∈ Ideal.span {monomial d₀ (1 : R)} ↔ ∀ d, ¬ d₀ ≤ d → p.coeff d = 0 := by
  rw [← coefficientIdeal_monomialFamily, mem_coefficientIdeal_iff _ (monotone_monomialFamily d₀)]
  simp_rw [mem_monomialFamily_iff]

end Stacks

end
