module

public import Mathlib.Algebra.MvPolynomial.Variables
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Span

/-!
# Setting a set of variables to zero

For a set `s` of variables, `MvPolynomial.killSet R s` is the `R`-algebra endomorphism of
`MvPolynomial σ R` sending the variables in `s` to zero and fixing the others. Its kernel is the
ideal generated by the variables in `s`, which is therefore prime when `R` is a domain.

## Main definitions

* `MvPolynomial.killSet R s`: the substitution `X i ↦ 0` for `i ∈ s`, `X i ↦ X i` otherwise.

## Main results

* `MvPolynomial.ker_killSet`: its kernel is `Ideal.span (X '' s)`.
* `MvPolynomial.isPrime_span_X_image`: the ideal generated by a set of variables over a domain is
  prime.
* `MvPolynomial.X_mem_span_X_image_iff`: a variable lies in it exactly when it is one of the
  generators.
* `MvPolynomial.killSet_eq_self`, `MvPolynomial.killSet_killSet`: the substitution fixes the
  polynomials not involving the killed variables, and two such substitutions commute.
-/

@[expose] public noncomputable section

namespace MvPolynomial

variable {σ : Type*} (R : Type*) [CommRing R]

/-- The substitution sending the variables in `s` to zero and fixing the others. -/
def killSet (s : Set σ) : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
  open scoped Classical in aeval fun i => if i ∈ s then 0 else X i

variable {R}

/-- The substitution sends a killed variable to zero. -/
theorem killSet_X_of_mem {s : Set σ} {i : σ} (hi : i ∈ s) : killSet R s (X i) = 0 := by
  classical
  simp [killSet, hi]

/-- The substitution fixes a variable that is not killed. -/
theorem killSet_X_of_notMem {s : Set σ} {i : σ} (hi : i ∉ s) : killSet R s (X i) = X i := by
  classical
  simp [killSet, hi]

/-- The substitution fixes constant polynomials. -/
@[simp]
theorem killSet_C (s : Set σ) (a : R) : killSet R s (C a) = C a :=
  (killSet R s).commutes a

/-- The substitution fixes a polynomial none of whose variables it kills. -/
theorem killSet_eq_self {s : Set σ} {f : MvPolynomial σ R} (hf : ∀ i ∈ f.vars, i ∉ s) :
    killSet R s f = f := by
  have hX : ∀ i ∈ f.vars, i ∈ f.vars → (killSet R s).toRingHom (X i) = RingHom.id _ (X i) :=
    fun i hi _ => killSet_X_of_notMem (hf i hi)
  have h := hom_congr_vars (f₁ := (killSet R s).toRingHom) (f₂ := RingHom.id _) (p₁ := f)
    (p₂ := f) (by ext a; simp) hX rfl
  simpa using h

/-- Two substitutions killing sets of variables commute. -/
theorem killSet_killSet (s t : Set σ) (f : MvPolynomial σ R) :
    killSet R s (killSet R t f) = killSet R t (killSet R s f) := by
  have : (killSet R s).comp (killSet R t) = (killSet R t).comp (killSet R s) := by
    refine algHom_ext fun i => ?_
    by_cases hs : i ∈ s <;> by_cases ht : i ∈ t <;>
      simp [killSet_X_of_mem, killSet_X_of_notMem, hs, ht]
  exact AlgHom.congr_fun this f

/-- A polynomial differs from its image under `MvPolynomial.killSet` by an element of the ideal
generated by the killed variables. -/
theorem sub_killSet_mem_span (s : Set σ) (g : MvPolynomial σ R) :
    g - killSet R s g ∈ Ideal.span (X '' s : Set (MvPolynomial σ R)) := by
  induction g using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    rw [map_add, add_sub_add_comm]
    exact add_mem hp hq
  | mul_X p i hp =>
    by_cases hi : i ∈ s
    · rw [map_mul, killSet_X_of_mem hi, mul_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, hi, rfl⟩)
    · rw [map_mul, killSet_X_of_notMem hi, ← sub_mul]
      exact Ideal.mul_mem_right _ _ hp

/-- The kernel of `MvPolynomial.killSet` is the ideal generated by the killed variables. -/
theorem ker_killSet (s : Set σ) :
    RingHom.ker (killSet R s) = Ideal.span (X '' s : Set (MvPolynomial σ R)) := by
  refine le_antisymm (fun g hg => ?_) (Ideal.span_le.mpr ?_)
  · simpa [RingHom.mem_ker.mp hg] using sub_killSet_mem_span s g
  · rintro _ ⟨i, hi, rfl⟩
    exact killSet_X_of_mem hi

/-- A polynomial lies in the ideal generated by a set of variables exactly when
`MvPolynomial.killSet` sends it to zero. -/
theorem mem_span_X_image_iff_killSet {s : Set σ} {f : MvPolynomial σ R} :
    f ∈ Ideal.span (X '' s : Set (MvPolynomial σ R)) ↔ killSet R s f = 0 := by
  rw [← ker_killSet, RingHom.mem_ker]

/-- The ideal generated by a set of variables over a domain is prime. -/
instance isPrime_span_X_image [IsDomain R] (s : Set σ) :
    (Ideal.span (X '' s : Set (MvPolynomial σ R))).IsPrime := by
  rw [← ker_killSet]
  exact RingHom.ker_isPrime _

/-- A variable lies in the ideal generated by a set of variables exactly when it is one of
them. -/
theorem X_mem_span_X_image_iff [Nontrivial R] {s : Set σ} {i : σ} :
    (X i : MvPolynomial σ R) ∈ Ideal.span (X '' s : Set (MvPolynomial σ R)) ↔ i ∈ s := by
  rw [mem_span_X_image_iff_killSet]
  by_cases hi : i ∈ s
  · simp [killSet_X_of_mem hi, hi]
  · simp [killSet_X_of_notMem hi, hi, X_ne_zero]

end MvPolynomial
