module

public import Mathlib.LinearAlgebra.Pi
public import Mathlib.RingTheory.Finiteness.Nakayama
public import Mathlib.RingTheory.Finiteness.Projective
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.Nilpotent.Basic
public import Mathlib.RingTheory.Nilpotent.Lemmas
public import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Unital split coordinates on a finite projective algebra

Let `S` be a finite projective algebra over a commutative ring `R` whose map on prime spectra
`Spec S → Spec R` is **surjective**. Then `S` admits a system of `R`-linear coordinates
`crd : S → Rᵏ⁺¹` split by a retraction `rtr : Rᵏ⁺¹ → S`, in which the unit of `S` is the first
basis vector: `crd 1 = Pi.single 0 1`.

A finite projective module always admits *some* split coordinate system, by
`Module.Finite.exists_comp_eq_id_of_projective`; what the surjectivity of `Spec S → Spec R` buys
is that the coordinates can be *normalised at the unit*. The point is that the ideal of `R`
generated by the coordinates of `1` must then be the unit ideal: Nakayama produces `r` with
`r - 1` in that ideal and `r • S = 0`, so `r` maps to `0` in `S` and hence lies in every prime of
`R` (lift the prime along the surjection), i.e. `r` is nilpotent, so `r - 1` is a unit.

## Main results

* `Stacks.UnitalSplitCoordinates.isNilpotent_of_algebraMap_eq_zero`: an element of `R` killed by
  `R → S` is nilpotent as soon as `Spec S → Spec R` is surjective.
* `Stacks.UnitalSplitCoordinates.exists_of_linearFunctional_eq_one`: a split coordinate system
  together with an `R`-linear functional sending `1` to `1` can be rearranged into one carrying
  `1` to the first basis vector.
* `Stacks.UnitalSplitCoordinates.exists_split_coordinates`: the theorem itself.

## Implementation notes

The rearrangement in `exists_of_linearFunctional_eq_one` is the explicit change of coordinates

    crd x = Fin.cons (φ x) (fun m => g x m - φ x * g 1 m)
    rtr v = v 0 • 1 + (f w - φ (f w) • 1)     (`w` the tail of `v`)

with `f`, `g` the given split pair and `φ` the functional. Both maps are assembled from
`LinearMap.pi`, `LinearMap.proj` and `LinearMap.smulRight` so that linearity is free; each is
introduced by `obtain` from an existential recording only its values, so the rest of the argument
never unfolds the bundled term. The tail of `v` is passed as an extra universally quantified
argument `w` with `∀ m, w m = v m.succ` rather than as `Fin.tail v`, which keeps the two uses of
`f w` syntactically identical to the vector `g x - φ x • g 1` produced by `crd`.

Nakayama's lemma is used in the form
`Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul`, applied to `⊤ : Submodule R S`
and the ideal spanned by the coordinates of `1`; `⊤ ≤ I • ⊤` holds because `I • ⊤` contains `1`
(expand `f (g 1)` with `LinearMap.pi_apply_eq_sum_univ`) and is closed under multiplication by
elements of `S`.
-/

@[expose] public section

universe u

namespace Stacks.UnitalSplitCoordinates

/-- **An element killed by a structure map with surjective spectral map is nilpotent.** If
`Spec S → Spec R` is surjective and `r : R` dies in `S`, then `r` lies in every prime of `R`:
lift the prime to a prime `q` of `S` and use that the image of `r` is `0 ∈ q`. -/
theorem isNilpotent_of_algebraMap_eq_zero {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R S))) {r : R}
    (hr : algebraMap R S r = 0) : IsNilpotent r := by
  rw [nilpotent_iff_mem_prime]
  intro p hp
  obtain ⟨q, hq⟩ := hsurj ⟨p, hp⟩
  have hmem : r ∈ (PrimeSpectrum.comap (algebraMap R S) q).asIdeal := by
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hr]
    exact Submodule.zero_mem _
  rw [hq] at hmem
  exact hmem

/-- **Normalising a split coordinate system at the unit.** Given `f`, `g` with `f ∘ g = id` and an
`R`-linear functional `φ : S → R` with `φ 1 = 1`, the coordinates `x ↦ (φ x, g x - φ x • g 1)` are
again split, and now carry `1` to the first basis vector. -/
theorem exists_of_linearFunctional_eq_one {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {n : ℕ} (f : (Fin n → R) →ₗ[R] S) (g : S →ₗ[R] (Fin n → R)) (hfg : ∀ x : S, f (g x) = x)
    (φ : S →ₗ[R] R) (hφ : φ 1 = 1) :
    ∃ (crd : S →ₗ[R] (Fin (n + 1) → R)) (rtr : (Fin (n + 1) → R) →ₗ[R] S),
      (∀ x : S, rtr (crd x) = x) ∧ crd 1 = Pi.single 0 1 := by
  obtain ⟨crd, hcrd0, hcrds⟩ :
      ∃ crd : S →ₗ[R] (Fin (n + 1) → R), (∀ x : S, crd x 0 = φ x) ∧
        ∀ (x : S) (m : Fin n), crd x m.succ = g x m - φ x * g 1 m :=
    ⟨LinearMap.pi (Fin.cons φ fun m => LinearMap.proj m ∘ₗ (g - LinearMap.smulRight φ (g 1))),
      fun x => by simp, fun x m => by simp⟩
  obtain ⟨rtr, hrtr⟩ :
      ∃ rtr : (Fin (n + 1) → R) →ₗ[R] S, ∀ (v : Fin (n + 1) → R) (w : Fin n → R),
        (∀ m, w m = v m.succ) → rtr v = v 0 • (1 : S) + (f w - φ (f w) • (1 : S)) := by
    refine ⟨LinearMap.smulRight (LinearMap.proj 0) (1 : S)
      + (LinearMap.id - LinearMap.smulRight φ (1 : S)) ∘ₗ f ∘ₗ
        LinearMap.pi fun m : Fin n => LinearMap.proj m.succ, fun v w hw => ?_⟩
    have hvw : (LinearMap.pi fun m : Fin n => LinearMap.proj (R := R) m.succ) v = w :=
      funext fun m => (hw m).symm
    simp only [LinearMap.add_apply, LinearMap.coe_comp, Function.comp_apply, hvw,
      LinearMap.sub_apply, LinearMap.id_coe, id_eq, LinearMap.smulRight_apply,
      LinearMap.proj_apply]
  refine ⟨crd, rtr, fun x => ?_, ?_⟩
  · have hw : ∀ m, (g x - φ x • g 1) m = crd x m.succ := by
      intro m
      rw [hcrds x m, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    have hfw : f (g x - φ x • g 1) = x - φ x • (1 : S) := by
      rw [map_sub, map_smul, hfg x, hfg 1]
    have hφw : φ (f (g x - φ x • g 1)) = 0 := by
      rw [hfw, map_sub, map_smul, hφ, smul_eq_mul, mul_one, sub_self]
    rw [hrtr (crd x) (g x - φ x • g 1) hw, hcrd0 x, hφw, hfw, zero_smul, sub_zero]
    abel
  · ext i
    induction i using Fin.cases with
    | zero => rw [hcrd0 1, hφ, Pi.single_eq_same]
    | succ m =>
      rw [hcrds 1 m, hφ, one_mul, sub_self, Pi.single_eq_of_ne (Fin.succ_ne_zero m)]

/-- **A finite projective algebra with surjective spectral map has split coordinates carrying the
unit to a basis vector.** There are `R`-linear maps `crd : S → R^(k+1)` and `rtr : R^(k+1) → S`
with `rtr ∘ crd = id` and `crd 1 = Pi.single 0 1`. -/
theorem exists_split_coordinates (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    [Module.Finite R S] [Module.Projective R S]
    (hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap R S))) :
    ∃ (k : ℕ) (crd : S →ₗ[R] (Fin (k + 1) → R)) (rtr : (Fin (k + 1) → R) →ₗ[R] S),
      (∀ x : S, rtr (crd x) = x) ∧ crd 1 = Pi.single 0 1 := by
  obtain ⟨n, f, g, -, -, hfg⟩ := Module.Finite.exists_comp_eq_id_of_projective R S
  have hfg' : ∀ x : S, f (g x) = x := by
    intro x
    have h := LinearMap.congr_fun hfg x
    simpa using h
  set I : Ideal R := Ideal.span (Set.range (g 1)) with hI
  have hone : (1 : S) ∈ I • (⊤ : Submodule R S) := by
    have hsum : (1 : S) = ∑ m, g 1 m • f fun j => if m = j then 1 else 0 := by
      rw [← LinearMap.pi_apply_eq_sum_univ f (g 1), hfg']
    rw [hsum]
    exact Submodule.sum_mem _ fun m _ =>
      Submodule.smul_mem_smul (Ideal.subset_span (Set.mem_range_self m)) Submodule.mem_top
  have hmul : ∀ x y : S, y ∈ I • (⊤ : Submodule R S) → x * y ∈ I • (⊤ : Submodule R S) := by
    intro x y hy
    refine Submodule.smul_induction_on hy ?_ ?_
    · intro r hr z _
      rw [mul_smul_comm]
      exact Submodule.smul_mem_smul hr Submodule.mem_top
    · intro a b ha hb
      rw [mul_add]
      exact Submodule.add_mem _ ha hb
  have htop : (⊤ : Submodule R S) ≤ I • (⊤ : Submodule R S) := by
    intro x _
    have h := hmul x 1 hone
    rwa [mul_one] at h
  obtain ⟨r, hrI, hr0⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I
    (⊤ : Submodule R S) (Module.Finite.fg_top (R := R) (M := S)) htop
  have hrz : algebraMap R S r = 0 := by
    have h := hr0 1 Submodule.mem_top
    rwa [Algebra.smul_def, mul_one] at h
  have hItop : I = ⊤ :=
    I.eq_top_of_isUnit_mem hrI
      (IsNilpotent.isUnit_sub_one (isNilpotent_of_algebraMap_eq_zero hsurj hrz))
  obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.mp
    (show (1 : R) ∈ Ideal.span (Set.range (g 1)) from hI ▸ (Ideal.eq_top_iff_one I).mp hItop)
  obtain ⟨φ, hφ⟩ : ∃ φ : S →ₗ[R] R, ∀ x : S, φ x = ∑ m, b m * g x m :=
    ⟨∑ m, b m • (LinearMap.proj m ∘ₗ g), fun x => by simp⟩
  obtain ⟨crd, rtr, hsplit, hunit⟩ :=
    exists_of_linearFunctional_eq_one f g hfg' φ ((hφ 1).trans hb)
  exact ⟨n, crd, rtr, hsplit, hunit⟩

end Stacks.UnitalSplitCoordinates

end
