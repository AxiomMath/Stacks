module

public import Mathlib.Algebra.Polynomial.Bivariate
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.FieldTheory.SeparableDegree
public import StacksFrontier.RingTheory.GeometricallyIntegral.HypersurfaceFibreIrreducibility0559
public import StacksFrontier.RingTheory.GeometricallyReduced.TensorProduct

/-!
# Absolute irreducibility of a minimal polynomial over a polynomial ring

Let `L` be a field over `E[X]`, with `X` going to a transcendental element `τ`, and let `η ∈ L` be
integral over `E[X]`. The minimal polynomial `R` of `η` over `E[X]` generates the kernel of
evaluation `E[X][Y] → L` at `(τ, η)`, because `E[X]` is integrally closed. So `E[X][Y]/(R)` embeds
in `L`, and after base change to a field `Ω` it embeds in `L ⊗[E] Ω`. If the latter is a domain,
`R` stays irreducible over `Ω`.

The second half of the module supplies that hypothesis for `Ω = Ē`. A geometrically irreducible
plane-curve function field `L = E(τ, η)`, in which `η` is a simple root of some `Q ∈ E[X][Y]`, is
separably generated over `E`, hence geometrically reduced, hence geometrically integral.

## Main results

* `Polynomial.aeval_equivMvPolynomial_eq_zero_iff`: the kernel of evaluation at `(τ, η)` is
  generated by the minimal polynomial, read in two variables.
* `Polynomial.irreducible_map_equivMvPolynomial_minpoly`: the minimal polynomial stays irreducible
  over any `Ω` with `L ⊗[E] Ω` a domain.
* `Polynomial.isDomain_tensorProduct_algebraicClosure_of_separable_root`: `L ⊗[E] Ē` is a domain
  for a geometrically irreducible plane-curve function field with a separable fibre coordinate.

## Implementation notes

Polynomials in two variables appear in two guises: `E[X][Y]`, where `minpoly` lives, and
`MvPolynomial (Fin 2) E`, where the hypersurface base change of Stacks Tag 0559's last step
(`MvPolynomial.quotientSpanTensorRingEquiv`) and Stacks Tag 0557 live. They are identified by
Mathlib's `Polynomial.Bivariate.equivMvPolynomial`, with the inner variable going to `X 0`.
-/

@[expose] public section

open Polynomial TensorProduct

namespace Polynomial

variable {E L : Type*} [Field E] [Field L] [Algebra E L] [Algebra E[X] L]
  [IsScalarTower E E[X] L]

/-- Evaluating the two-variable polynomial attached to `f ∈ E[X][Y]` at `(τ, η)`, with `τ` the
image of `X`, is evaluating `f` at `η` over `E[X]`. -/
theorem aeval_equivMvPolynomial (η : L) (f : Polynomial E[X]) :
    MvPolynomial.aeval ![algebraMap E[X] L X, η] (Bivariate.equivMvPolynomial E f) =
      aeval η f := by
  have h : (MvPolynomial.aeval ![algebraMap E[X] L X, η]).comp
      (Bivariate.equivMvPolynomial E).toAlgHom = (aeval η).restrictScalars E := by
    ext <;> simp
  exact DFunLike.congr_fun h f

variable [Module.IsTorsionFree E[X] L]

/-- The kernel of evaluation at `(τ, η)` is generated by the minimal polynomial of `η` over
`E[X]`, read as a polynomial in two variables. -/
theorem aeval_equivMvPolynomial_eq_zero_iff {η : L} (hη : IsIntegral E[X] η)
    (f : MvPolynomial (Fin 2) E) :
    MvPolynomial.aeval ![algebraMap E[X] L X, η] f = 0 ↔
      Bivariate.equivMvPolynomial E (minpoly E[X] η) ∣ f := by
  obtain ⟨f, rfl⟩ := (Bivariate.equivMvPolynomial E).surjective f
  rw [aeval_equivMvPolynomial, minpoly.isIntegrallyClosed_dvd_iff hη, map_dvd_iff]

/-- **The minimal polynomial stays irreducible over a field `Ω` with `L ⊗ Ω` a domain.** Let `L`
be a field over `E[X]`, with `X` mapping to a transcendental `τ`, and let `η ∈ L` be integral over
`E[X]`. If `L ⊗[E] Ω` is a domain, then the minimal polynomial of `η` over `E[X]`, read as a
polynomial `R(X, Y)` in two variables, remains irreducible over `Ω`. -/
theorem irreducible_map_equivMvPolynomial_minpoly (Ω : Type*) [Field Ω] [Algebra E Ω]
    [IsDomain (L ⊗[E] Ω)] {η : L} (hη : IsIntegral E[X] η) :
    Irreducible ((Bivariate.equivMvPolynomial E (minpoly E[X] η)).map (algebraMap E Ω)) := by
  set R := Bivariate.equivMvPolynomial E (minpoly E[X] η)
  let q : MvPolynomial (Fin 2) E →ₐ[E] L := MvPolynomial.aeval ![algebraMap E[X] L X, η]
  have hker : ∀ f, q f = 0 ↔ f ∈ Ideal.span {R} := fun f =>
    (aeval_equivMvPolynomial_eq_zero_iff hη f).trans Ideal.mem_span_singleton.symm
  let q' : (MvPolynomial (Fin 2) E ⧸ Ideal.span {R}) →ₐ[E] L :=
    Ideal.Quotient.liftₐ (Ideal.span {R}) q fun f hf => (hker f).mpr hf
  have hq' : Function.Injective q' := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective a
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hker f).mp ha)
  have : IsDomain ((MvPolynomial (Fin 2) E ⧸ Ideal.span {R}) ⊗[E] Ω) :=
    (Module.Flat.rTensor_preserves_injective_linearMap q'.toLinearMap hq').isDomain
      (Algebra.TensorProduct.map q' (AlgHom.id E Ω)).toRingHom
  let e := MvPolynomial.quotientSpanTensorRingEquiv E (Fin 2) Ω R
  have : IsDomain (MvPolynomial (Fin 2) Ω ⧸ Ideal.span {R.map (algebraMap E Ω)}) :=
    e.symm.injective.isDomain e.symm.toRingHom
  have hprime : (Ideal.span {R.map (algebraMap E Ω)}).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
  have hR : R ≠ 0 := by
    simpa [R] using minpoly.ne_zero hη
  have hne : R.map (algebraMap E Ω) ≠ 0 := fun h =>
    hR (MvPolynomial.map_injective _ (algebraMap E Ω).injective (by rw [h, map_zero]))
  exact ((Ideal.span_singleton_prime hne).mp hprime).irreducible

end Polynomial

namespace Polynomial

universe u

variable {E L : Type u} [Field E] [Field L] [Algebra E L] [Algebra E[X] L]
  [IsScalarTower E E[X] L]

/-- **A plane curve function field with a separable fibre coordinate is geometrically integral.**
Let `L/E` be geometrically irreducible and generated by the image `τ` of `X`, transcendental over
`E`, and by an element `η` which is a simple root of some `Q ∈ E[X][Y]`. Then `L` is separably
generated over `E`, hence geometrically reduced, so `L ⊗[E] Ē` is a domain. -/
theorem isDomain_tensorProduct_algebraicClosure_of_separable_root
    [hL : Algebra.IsGeometricallyIrreducible E L] (hτ : Transcendental E (algebraMap E[X] L X))
    {η : L} (hgen : IntermediateField.adjoin E {algebraMap E[X] L X, η} = ⊤) {Q : E[X][X]}
    (hQ : aeval η Q = 0) (hQ' : aeval η (derivative Q) ≠ 0) :
    IsDomain (L ⊗[E] AlgebraicClosure E) := by
  set τ := algebraMap E[X] L X
  set N := IntermediateField.adjoin E {τ}
  let φ : E[X] →ₐ[E] N := aeval (⟨τ, IntermediateField.mem_adjoin_simple_self E τ⟩ : N)
  let : Algebra E[X] N := φ.toRingHom.toAlgebra
  have hsc : IsScalarTower.toAlgHom E E[X] L = aeval τ := by
    apply Polynomial.algHom_ext
    simp [τ]
  have h2 : ∀ p : E[X], algebraMap E[X] L p = aeval τ p := fun p => DFunLike.congr_fun hsc p
  have hcomp : ∀ p : E[X], algebraMap N L (φ p) = algebraMap E[X] L p := by
    intro p
    rw [h2, ← aeval_algebraMap_apply]
    rfl
  have : IsScalarTower E[X] N L := IsScalarTower.of_algebraMap_eq fun p => (hcomp p).symm
  have hφinj : Function.Injective (algebraMap E[X] N) := by
    intro a b hab
    have := congrArg (algebraMap N L) hab
    change algebraMap N L (φ a) = algebraMap N L (φ b) at this
    rw [hcomp, hcomp, h2, h2] at this
    exact (transcendental_iff_injective.mp hτ) this
  have hQ0 : Q ≠ 0 := fun h => hQ' (by simp [h])
  have hsepη : IsSeparable N η := by
    have hroot : aeval η (Q.map (algebraMap E[X] N)) = 0 := by
      rw [aeval_map_algebraMap, hQ]
    have hint : IsIntegral N η :=
      (IsAlgebraic.isIntegral ⟨_, (Polynomial.map_ne_zero_iff hφinj).mpr hQ0, hroot⟩)
    obtain ⟨h, hh⟩ := minpoly.dvd N η hroot
    have h1 : aeval η (derivative (Q.map (algebraMap E[X] N))) ≠ 0 := by
      rwa [derivative_map, aeval_map_algebraMap]
    rw [hh, derivative_mul, map_add, map_mul, map_mul, minpoly.aeval, zero_mul, add_zero] at h1
    have h2 : derivative (minpoly N η) ≠ 0 := fun h0 => h1 (by rw [h0, map_zero, zero_mul])
    exact (separable_iff_derivative_ne_zero (minpoly.irreducible hint)).mpr h2
  have htop : IntermediateField.adjoin N {η} = ⊤ := by
    apply IntermediateField.restrictScalars_injective E
    rw [IntermediateField.adjoin_adjoin_left, IntermediateField.restrictScalars_top, ← hgen,
      Set.singleton_union]
  have hsepL : Algebra.IsSeparable N L := by
    have h := (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable N L).mpr hsepη
    rw [htop] at h
    exact AlgEquiv.Algebra.isSeparable IntermediateField.topEquiv
  have : Algebra.IsSeparablyGenerated E L := by
    refine ⟨⟨{τ}, ?_, hsepL⟩⟩
    have hind : AlgebraicIndependent E ((↑) : ({τ} : Set L) → L) :=
      algebraicIndependent_unique_type_iff.mpr hτ
    rw [hind.isTranscendenceBasis_iff_isAlgebraic, Subtype.range_coe,
      ← IntermediateField.isAlgebraic_adjoin_iff_top]
    infer_instance
  have : Algebra.IsGeometricallyReduced E L :=
    Stacks.GeometricallyReduced.Separability.isGeometricallyReduced_of_isSeparablyGenerated E L
  rw [isDomain_iff_irreducibleSpace_and_isReduced]
  exact ⟨(Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_tensorProduct E
    L).mp hL _, isReduced_of_injective
      (Algebra.TensorProduct.comm E L (AlgebraicClosure E)).toRingHom
      (Algebra.TensorProduct.comm E L (AlgebraicClosure E)).injective⟩

end Polynomial
