module

public import Mathlib.RingTheory.Ideal.GoingUp
public import Mathlib.RingTheory.Polynomial.IsIntegral
public import StacksCore.Tactic.StacksAttribute

/-!
# Coefficients of a monic factor of a monic polynomial

Let `K` be a field and let `g = xⁿ + aₙ₋₁xⁿ⁻¹ + ⋯ + a₀` and `f = xᵐ + bₘ₋₁xᵐ⁻¹ + ⋯ + b₀` be
monic polynomials in `K[x]` with `g ∣ f`. Then

1. the `aᵢ` are integral over every subring `R₀ ⊆ K` containing the `bⱼ`, and
2. each `aᵢ` (`i < n`) lies in `√((b₀, …, bₘ₋₁)R)` for every subring `R ⊆ K` containing the
   `aᵢ` and the `bⱼ`.

Part (1) is Mathlib's `Polynomial.isIntegral_coeff_of_dvd`. For part (2), fix a prime `𝔭` of
`R` containing the `bⱼ`. The coefficients of `f / g` are integral over `R` by part (1), so
all three polynomials have coefficients in the integral closure `S` of `R` in `K`. Choose a
prime `𝔮` of `S` lying over `𝔭`; in the domain `S / 𝔮` the image of `f` is `xᵐ`, so the image
of `g` is a monic divisor of `xᵐ`, hence equal to `xⁿ`, and every `aᵢ` with `i < n` lies in
`𝔮 ∩ R = 𝔭`.

## Main results

* `Polynomial.coeff_mem_radical_span_coeff_of_monic_dvd`: part (2).
* `Polynomial.isIntegral_coeff_and_coeff_mem_radical_of_monic_dvd`: both parts together.
-/

@[expose] public section

open Polynomial

namespace Polynomial

variable {K : Type*} [Field K]

/-- A monic polynomial over a domain dividing `X ^ m` is a power of `X`. -/
private lemma eq_X_pow_of_monic_dvd_X_pow {D : Type*} [CommRing D] [IsDomain D] {q : D[X]}
    (hq : q.Monic) {m : ℕ} (h : q ∣ X ^ m) : q = X ^ q.natDegree := by
  obtain ⟨k, -, hk⟩ := (dvd_prime_pow prime_X m).mp h
  have hqk : q = X ^ k := eq_of_monic_of_associated hq (monic_X_pow k) hk
  rw [hqk, natDegree_X_pow]

/-- Every coefficient of a polynomial over `K` whose coefficients are integral over a subring
`R` lifts to the integral closure of `R` in `K`. -/
private lemma lifts_integralClosure (R : Subring K) {p : K[X]}
    (hp : ∀ i, IsIntegral R (p.coeff i)) : p ∈ lifts (algebraMap (integralClosure R K) K) :=
  (lifts_iff_coeff_lifts p).mpr fun i ↦ ⟨⟨p.coeff i, hp i⟩, rfl⟩

/-- **Stacks 00H6 (2).** Let `K` be a field, `R ⊆ K` a subring, and `f`, `g` monic polynomials
over `K` with `g ∣ f`, all of whose coefficients lie in `R`. Then each coefficient `aᵢ`
(`i < deg g`) of `g` lies in the radical of the ideal of `R` generated by the coefficients
`b₀, …, bₘ₋₁` (`m = deg f`) of `f`. -/
theorem coeff_mem_radical_span_coeff_of_monic_dvd {f g : K[X]} (hf : f.Monic) (hg : g.Monic)
    (hgf : g ∣ f) (R : Subring K) (hfR : ∀ j, f.coeff j ∈ R) (hgR : ∀ i, g.coeff i ∈ R)
    {i : ℕ} (hi : i < g.natDegree) :
    (⟨g.coeff i, hgR i⟩ : R) ∈
      (Ideal.span {x : R | ∃ j < f.natDegree, (x : K) = f.coeff j}).radical := by
  obtain ⟨h, rfl⟩ := hgf
  have hh : h.Monic := hg.of_mul_monic_left hf
  rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
  rintro P ⟨hIP, hP⟩
  set S := integralClosure R K
  have hRS : Function.Injective (algebraMap R S) := fun x y hxy ↦
    Subtype.val_injective (congrArg (fun s : S ↦ (s : K)) hxy)
  have hSK : Function.Injective (algebraMap S K) := Subtype.val_injective
  obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral (S := S) P ⊥
    (by
      intro x hx
      rw [Ideal.mem_comap, Ideal.mem_bot, ← map_zero (algebraMap R S)] at hx
      rw [hRS hx]
      exact P.zero_mem)
  -- Lift `g`, `h` and `g * h` to the integral closure `S` of `R` in `K`.
  have hRint (p : K[X]) (hpR : ∀ j, p.coeff j ∈ R) (j : ℕ) : IsIntegral R (p.coeff j) :=
    isIntegral_algebraMap (x := (⟨p.coeff j, hpR j⟩ : R))
  obtain ⟨gS, hgS⟩ := (mem_lifts _).mp (lifts_integralClosure R (hRint g hgR))
  obtain ⟨fS, hfS⟩ := (mem_lifts _).mp (lifts_integralClosure R (hRint _ hfR))
  have hhint : ∀ j, IsIntegral R (h.coeff j) := by
    obtain ⟨fR, hfR'⟩ := (mem_lifts _).mp ((lifts_iff_coeff_lifts (f := algebraMap R K)
      (g * h)).mpr fun j ↦ ⟨⟨_, hfR j⟩, rfl⟩)
    refine isIntegral_coeff_of_dvd fR h (monic_of_injective Subtype.val_injective
      (hfR' ▸ hf)) hh ?_
    rw [hfR']
    exact dvd_mul_left h g
  obtain ⟨hS, hhS⟩ := (mem_lifts _).mp (lifts_integralClosure R hhint)
  have hmul : fS = gS * hS :=
    map_injective _ hSK (by rw [Polynomial.map_mul, hfS, hgS, hhS])
  have hgSm : gS.Monic := monic_of_injective hSK (hgS ▸ hg)
  -- Every coefficient of `g` or of `g * h` comes from `R`.
  have hcoeff (p : K[X]) (pS : S[X]) (hpS : pS.map (algebraMap S K) = p)
      (hpR : ∀ j, p.coeff j ∈ R) (j : ℕ) : pS.coeff j = algebraMap R S ⟨p.coeff j, hpR j⟩ :=
    hSK (by rw [← coeff_map, hpS]; rfl)
  have hdeg : gS.natDegree = g.natDegree := by
    rw [← hgS, natDegree_map_eq_of_injective hSK]
  -- In the domain `S ⧸ Q` the image of `g * h` is `X ^ m`.
  let φ := Ideal.Quotient.mk Q
  have hfX : fS.map φ = X ^ (g * h).natDegree := by
    ext j
    rw [coeff_map, coeff_X_pow]
    split_ifs with hj
    · subst hj
      have : fS.coeff (g * h).natDegree = 1 :=
        hSK (by rw [← coeff_map, hfS, map_one]; exact hf)
      rw [this, map_one]
    · rcases lt_or_gt_of_ne hj with hj | hj
      · rw [Ideal.Quotient.eq_zero_iff_mem, hcoeff _ fS hfS hfR j, ← Ideal.mem_under, hQP]
        exact hIP (Ideal.subset_span ⟨j, hj, rfl⟩)
      · have : fS.coeff j = 0 :=
          hSK (by rw [← coeff_map, hfS, map_zero]; exact coeff_eq_zero_of_natDegree_lt hj)
        rw [this, map_zero]
  have hgX : gS.map φ = X ^ g.natDegree := by
    have hdvd : gS.map φ ∣ X ^ (g * h).natDegree := by
      rw [← hfX, hmul, Polynomial.map_mul]
      exact dvd_mul_right _ _
    rw [eq_X_pow_of_monic_dvd_X_pow (hgSm.map φ) hdvd, hgSm.natDegree_map, hdeg]
  have hi0 : φ (gS.coeff i) = 0 := by
    rw [← coeff_map, hgX, coeff_X_pow]
    exact ite_eq_right_iff.mpr fun h ↦ absurd h hi.ne
  rw [Ideal.Quotient.eq_zero_iff_mem, hcoeff g gS hgS hgR i, ← Ideal.mem_under, hQP] at hi0
  exact hi0

/-- **Stacks 00H6.** Let `K` be a field, and let `g = xⁿ + aₙ₋₁xⁿ⁻¹ + ⋯ + a₀` divide
`f = xᵐ + bₘ₋₁xᵐ⁻¹ + ⋯ + b₀` in `K[x]`. Then
1. the `aᵢ` are integral over any subring `R₀ ⊆ K` containing the `bⱼ`, and
2. each `aᵢ` lies in `√((b₀, …, bₘ₋₁)R)` for any subring `R ⊆ K` containing the `aᵢ` and the
   `bⱼ`. -/
@[stacks 00H6 "(1) is Mathlib's `Polynomial.isIntegral_coeff_of_dvd`; (2) proved here"]
theorem isIntegral_coeff_and_coeff_mem_radical_of_monic_dvd {f g : K[X]} (hf : f.Monic)
    (hg : g.Monic) (hgf : g ∣ f) :
    (∀ R₀ : Subring K, (∀ j, f.coeff j ∈ R₀) → ∀ i, IsIntegral R₀ (g.coeff i)) ∧
    (∀ R : Subring K, (∀ j, f.coeff j ∈ R) → ∀ hgR : ∀ i, g.coeff i ∈ R,
      ∀ i < g.natDegree, (⟨g.coeff i, hgR i⟩ : R) ∈
        (Ideal.span {x : R | ∃ j < f.natDegree, (x : K) = f.coeff j}).radical) := by
  refine ⟨fun R₀ hfR₀ i ↦ ?_, fun R hfR hgR i hi ↦
    coeff_mem_radical_span_coeff_of_monic_dvd hf hg hgf R hfR hgR hi⟩
  obtain ⟨fR, hfR'⟩ := (mem_lifts _).mp ((lifts_iff_coeff_lifts (f := algebraMap R₀ K)
    f).mpr fun j ↦ ⟨⟨_, hfR₀ j⟩, rfl⟩)
  refine isIntegral_coeff_of_dvd fR g (monic_of_injective Subtype.val_injective (hfR' ▸ hf))
    hg ?_ i
  rw [hfR']
  exact hgf

end Polynomial
