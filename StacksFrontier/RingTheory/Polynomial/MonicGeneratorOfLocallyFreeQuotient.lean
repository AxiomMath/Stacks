module

public import Mathlib.LinearAlgebra.Charpoly.Basic
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.LocalProperties.Exactness
public import Mathlib.RingTheory.Localization.Module
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFreeRank.Field

/-!
# Ideals of a polynomial ring with finite locally free quotient

Let `R` be a commutative ring and `J ⊆ R[X]` an ideal such that `R[X] ⧸ J` is a finite locally
free `R`-module of rank `d`. Then `J` is generated by a unique monic polynomial of degree `d`.
Conversely the quotient by a monic polynomial of degree `d` is free of rank `d`.

## Main definitions

* `Polynomial.monicOfCoeffs c`: the monic polynomial `X ^ d + ∑ i, c i * X ^ i` attached to
  `c : Fin d → R`.

## Main results

* `Polynomial.bijective_linearCombination_of_isFiniteLocallyFreeOfRank`: if `R[X] ⧸ J` is finite
  locally free of rank `d`, the classes of `1, X, …, X ^ (d - 1)` form a basis of it.
* `Polynomial.existsUnique_eq_span_monicOfCoeffs`: such a `J` is generated by `monicOfCoeffs c`
  for exactly one `c`.
* `Polynomial.isFiniteLocallyFreeOfRank_quotient_monicOfCoeffs`: conversely the quotient by
  `monicOfCoeffs c` is finite locally free of rank `d`.
-/

@[expose] public noncomputable section

open Polynomial

universe u v

namespace Polynomial

section Span

variable {R : Type u} [CommRing R] {N : Type v} [AddCommGroup N] [Module R N]

/-- If an endomorphism `ξ` is killed by a monic polynomial of degree at most `d`, then every
iterate `ξ ^ k m` lies in the span of the first `d` iterates `m, ξ m, …, ξ ^ (d - 1) m`. -/
theorem pow_apply_mem_span_of_aeval_eq_zero {χ : R[X]} (hχ : χ.Monic) {d : ℕ}
    (hd : χ.natDegree ≤ d) {ξ : Module.End R N} (hξ : aeval ξ χ = 0) (m : N) (k : ℕ) :
    (ξ ^ k) m ∈ Submodule.span R (Set.range fun i : Fin d ↦ (ξ ^ (i : ℕ)) m) := by
  rcases Nat.eq_zero_or_pos d with rfl | hdpos
  · have h1 : χ = 1 := Polynomial.eq_one_of_monic_natDegree_zero hχ (Nat.le_zero.mp hd)
    rw [h1, map_one] at hξ
    have : (ξ ^ k) m = (1 : Module.End R N) ((ξ ^ k) m) := rfl
    rw [this, hξ]
    exact Submodule.zero_mem _
  set p := X ^ k %ₘ χ with hp
  have h1 : aeval ξ p = ξ ^ k := by
    rw [hp, aeval_modByMonic_eq_self_of_root hξ, map_pow, aeval_X]
  have hdeg : p.natDegree < d := by
    by_cases hχ1 : χ = 1
    · rw [hp, hχ1, modByMonic_one, natDegree_zero]
      exact hdpos
    · exact (natDegree_modByMonic_lt _ hχ hχ1).trans_le hd
  rw [← h1, aeval_eq_sum_range' hdeg, LinearMap.sum_apply]
  refine Submodule.sum_mem _ fun i hi ↦ ?_
  rw [LinearMap.smul_apply]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨i, Finset.mem_range.mp hi⟩, rfl⟩)

end Span

section Quotient

variable {R : Type u} [CommRing R]

/-- The monic polynomial `X ^ d + ∑ i, c i * X ^ i` of degree `d` attached to `c : Fin d → R`. -/
def monicOfCoeffs {d : ℕ} (c : Fin d → R) : R[X] :=
  X ^ d + ∑ i : Fin d, C (c i) * X ^ (i : ℕ)

/-- A polynomial `∑ i, c i * X ^ i` with `c : Fin d → R` has degree less than `d`. -/
theorem degree_sum_C_mul_X_pow_lt {d : ℕ} (c : Fin d → R) :
    (∑ i : Fin d, C (c i) * X ^ (i : ℕ)).degree < (d : WithBot ℕ) :=
  degree_sum_fin_lt c

/-- `monicOfCoeffs c` is monic. -/
theorem monic_monicOfCoeffs {d : ℕ} (c : Fin d → R) : (monicOfCoeffs c).Monic := by
  nontriviality R
  unfold monicOfCoeffs
  exact (monic_X_pow d).add_of_left (by
    rw [degree_X_pow]
    exact degree_sum_C_mul_X_pow_lt c)

/-- Over a nontrivial ring, `monicOfCoeffs c` has degree `d`. -/
theorem natDegree_monicOfCoeffs [Nontrivial R] {d : ℕ} (c : Fin d → R) :
    (monicOfCoeffs c).natDegree = d := by
  unfold monicOfCoeffs
  rw [natDegree_add_eq_left_of_degree_lt, natDegree_X_pow]
  rw [degree_X_pow]
  exact degree_sum_C_mul_X_pow_lt c

/-- `monicOfCoeffs c` has degree at most `d`. -/
theorem natDegree_monicOfCoeffs_le {d : ℕ} (c : Fin d → R) :
    (monicOfCoeffs c).natDegree ≤ d := by
  nontriviality R
  exact (natDegree_monicOfCoeffs c).le

/-- The coefficient of `X ^ n` in `∑ i, c i * X ^ i` is `c n` if `n < d` and `0` otherwise. -/
private theorem coeff_sum_C_mul_X_pow {d : ℕ} (c : Fin d → R) (n : ℕ) :
    (∑ i : Fin d, C (c i) * X ^ (i : ℕ)).coeff n = if h : n < d then c ⟨n, h⟩ else 0 := by
  simp only [finsetSum_coeff, coeff_C_mul_X_pow]
  split_ifs with hn
  · rw [Finset.sum_eq_single ⟨n, hn⟩]
    · simp
    · intro j _ hj
      exact ite_eq_right_iff.mpr fun h ↦ (hj (Fin.ext h.symm)).elim
    · simp
  · exact Finset.sum_eq_zero fun j _ ↦
    ite_eq_right_iff.mpr fun h ↦ (hn (h ▸ j.2)).elim

/-- For `i < d`, the coefficient of `X ^ i` in `monicOfCoeffs c` is `c i`. -/
theorem coeff_monicOfCoeffs {d : ℕ} (c : Fin d → R) (i : Fin d) :
    (monicOfCoeffs c).coeff i = c i := by
  rw [monicOfCoeffs, coeff_add, coeff_X_pow, ite_eq_right (Nat.ne_of_lt i.2), zero_add,
    coeff_sum_C_mul_X_pow]
  simp

/-- The classes of `1, X, …, X ^ (d - 1)` in `R[X] ⧸ J`, as a linear map out of `R ^ d`. -/
abbrev lowDegreeClasses (J : Ideal R[X]) (d : ℕ) : (Fin d → R) →ₗ[R] R[X] ⧸ J :=
  Fintype.linearCombination R fun i : Fin d ↦ Ideal.Quotient.mk J (X ^ (i : ℕ))

/-- `lowDegreeClasses J d c` is the class of `∑ i, c i * X ^ i`. -/
theorem lowDegreeClasses_apply (J : Ideal R[X]) {d : ℕ} (c : Fin d → R) :
    lowDegreeClasses J d c = Ideal.Quotient.mk J (∑ i : Fin d, C (c i) * X ^ (i : ℕ)) := by
  rw [Fintype.linearCombination_apply, map_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [map_mul, Algebra.smul_def]
  rfl

/-- Multiplication by `X` on `R[X] ⧸ J`, as an `R`-linear endomorphism. -/
abbrev mulXQuotient (J : Ideal R[X]) : Module.End R (R[X] ⧸ J) :=
  LinearMap.mulLeft R (Ideal.Quotient.mk J X)

/-- **The low-degree classes form a basis.** If `R[X] ⧸ J` is finite locally free of rank `d`,
the classes of `1, X, …, X ^ (d - 1)` form a basis of it. -/
theorem bijective_linearCombination_of_isFiniteLocallyFreeOfRank (J : Ideal R[X]) (d : ℕ)
    (h : Module.IsFiniteLocallyFreeOfRank R (R[X] ⧸ J) d) :
    Function.Bijective (lowDegreeClasses J d) := by
  obtain ⟨ι, f, hspan, hb⟩ := h
  refine bijective_of_isLocalized_span (Set.range f) hspan
    (fun r ↦ LocalizedModule (.powers r.1) (Fin d → R))
    (fun r ↦ LocalizedModule.mkLinearMap (.powers r.1) (Fin d → R))
    (fun r ↦ LocalizedModule (.powers r.1) (R[X] ⧸ J))
    (fun r ↦ LocalizedModule.mkLinearMap (.powers r.1) (R[X] ⧸ J)) _ ?_
  rintro ⟨r, i, rfl⟩
  set S := Submonoid.powers (f i)
  let Rₛ := Localization.Away (f i)
  let N := LocalizedModule S (R[X] ⧸ J)
  let P := LocalizedModule S (Fin d → R)
  obtain ⟨bN⟩ := hb i
  let bP : Module.Basis (Fin d) Rₛ P :=
    Module.Basis.ofIsLocalizedModule Rₛ S (LocalizedModule.mkLinearMap S (Fin d → R))
      (Pi.basisFun R (Fin d))
  let L' : P →ₗ[Rₛ] N := IsLocalizedModule.mapExtendScalars S
    (LocalizedModule.mkLinearMap S (Fin d → R)) (LocalizedModule.mkLinearMap S (R[X] ⧸ J)) Rₛ
    (lowDegreeClasses J d)
  have hL : ⇑(IsLocalizedModule.map S (LocalizedModule.mkLinearMap S (Fin d → R))
      (LocalizedModule.mkLinearMap S (R[X] ⧸ J)) (lowDegreeClasses J d)) = ⇑L' := rfl
  rw [hL]
  have hsurj : Function.Surjective L' := by
    rcases subsingleton_or_nontrivial Rₛ with hR | hR
    · have : Subsingleton N := Module.subsingleton Rₛ N
      exact fun n ↦ ⟨0, Subsingleton.elim _ _⟩
    let ξ : Module.End Rₛ N := IsLocalizedModule.mapExtendScalars S
      (LocalizedModule.mkLinearMap S (R[X] ⧸ J)) (LocalizedModule.mkLinearMap S (R[X] ⧸ J)) Rₛ
      (mulXQuotient J)
    have hξ (m : R[X] ⧸ J) :
        ξ (LocalizedModule.mk m 1) = LocalizedModule.mk (Ideal.Quotient.mk J X * m) 1 := by
      change IsLocalizedModule.map S (LocalizedModule.mkLinearMap S (R[X] ⧸ J))
        (LocalizedModule.mkLinearMap S (R[X] ⧸ J)) (mulXQuotient J)
          (LocalizedModule.mkLinearMap S _ m) = _
      rw [IsLocalizedModule.map_apply]
      rfl
    have hξpow (k : ℕ) (g : R[X]) : (ξ ^ k) (LocalizedModule.mk (Ideal.Quotient.mk J g) 1) =
        LocalizedModule.mk (Ideal.Quotient.mk J (X ^ k * g)) 1 := by
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ', Module.End.mul_apply, ih, hξ, ← map_mul, pow_succ', mul_assoc]
    have : Module.Free Rₛ N := Module.Free.of_basis bN
    have : Module.Finite Rₛ N := Module.Finite.of_basis bN
    have hχ := LinearMap.aeval_self_charpoly ξ
    have hdeg : ξ.charpoly.natDegree ≤ d := by
      rw [LinearMap.charpoly_natDegree, Module.finrank_eq_card_basis bN, Fintype.card_fin]
    set m₀ : N := LocalizedModule.mk (Ideal.Quotient.mk J 1) 1
    have hrange : Submodule.span Rₛ (Set.range fun i : Fin d ↦ (ξ ^ (i : ℕ)) m₀) ≤
        LinearMap.range L' := by
      rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      refine ⟨LocalizedModule.mk (Pi.single j 1) 1, ?_⟩
      change _ = (ξ ^ (j : ℕ)) m₀
      rw [hξpow, mul_one]
      change IsLocalizedModule.map S (LocalizedModule.mkLinearMap S (Fin d → R))
        (LocalizedModule.mkLinearMap S (R[X] ⧸ J)) (lowDegreeClasses J d)
          (LocalizedModule.mkLinearMap S _ (Pi.single j 1)) = _
      rw [IsLocalizedModule.map_apply, Fintype.linearCombination_apply_single, one_smul]
      rfl
    have hmk (g : R[X]) : LocalizedModule.mk (Ideal.Quotient.mk J g) (1 : S) ∈
        LinearMap.range L' := by
      refine hrange ?_
      induction g using Polynomial.induction_on' with
      | add p q hp hq =>
        have hadd : LocalizedModule.mk (Ideal.Quotient.mk J (p + q)) (1 : S) =
            LocalizedModule.mk (Ideal.Quotient.mk J p) 1 +
              LocalizedModule.mk (Ideal.Quotient.mk J q) 1 := by
          rw [LocalizedModule.mk_add_mk, map_add]
          simp
        rw [hadd]
        exact Submodule.add_mem _ hp hq
      | monomial k a =>
        have he : LocalizedModule.mk (Ideal.Quotient.mk J (monomial k a)) (1 : S) =
            algebraMap R Rₛ a • (ξ ^ k) m₀ := by
          rw [hξpow, mul_one, algebraMap_smul, LocalizedModule.smul'_mk,
            ← C_mul_X_pow_eq_monomial, map_mul, Algebra.smul_def]
          rfl
        rw [he]
        exact Submodule.smul_mem _ _
          (pow_apply_mem_span_of_aeval_eq_zero (LinearMap.charpoly_monic ξ) hdeg hχ m₀ k)
    intro n
    induction n using LocalizedModule.induction_on with
    | h m s =>
      obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective m
      obtain ⟨p, hp⟩ := hmk g
      refine ⟨(Localization.mk (1 : R) s : Rₛ) • p, ?_⟩
      rw [map_smul, hp, LocalizedModule.mk_smul_mk, one_smul, mul_one]
  refine ⟨?_, hsurj⟩
  let e : N ≃ₗ[Rₛ] P := bN.equiv bP (Equiv.refl _)
  have : Module.Finite Rₛ P := Module.Finite.of_basis bP
  have := OrzechProperty.injective_of_surjective_endomorphism (e.toLinearMap ∘ₗ L')
    (e.surjective.comp hsurj)
  exact fun a b hab ↦ this (by simp [hab])

/-- `monicOfCoeffs c` lies in `J` iff the class of `∑ i, c i * X ^ i` is minus the class of
`X ^ d`. -/
theorem monicOfCoeffs_mem_iff (J : Ideal R[X]) {d : ℕ} (c : Fin d → R) :
    monicOfCoeffs c ∈ J ↔ lowDegreeClasses J d c = - Ideal.Quotient.mk J (X ^ d) := by
  rw [lowDegreeClasses_apply, eq_neg_iff_add_eq_zero, ← map_add, Ideal.Quotient.eq_zero_iff_mem,
    monicOfCoeffs, add_comm]

/-- **Monic generators.** If `R[X] ⧸ J` is finite locally free of rank `d`, then `J` is
generated by `monicOfCoeffs c` for exactly one `c : Fin d → R`. -/
theorem existsUnique_eq_span_monicOfCoeffs (J : Ideal R[X]) (d : ℕ)
    (h : Module.IsFiniteLocallyFreeOfRank R (R[X] ⧸ J) d) :
    ∃! c : Fin d → R, J = Ideal.span {monicOfCoeffs c} := by
  have hbij := bijective_linearCombination_of_isFiniteLocallyFreeOfRank J d h
  obtain ⟨c, hc⟩ := hbij.2 (- Ideal.Quotient.mk J (X ^ d))
  have hmem : monicOfCoeffs c ∈ J := (monicOfCoeffs_mem_iff J c).mpr hc
  refine ⟨c, le_antisymm (fun g hg ↦ ?_) ((Ideal.span_singleton_le_iff_mem J).mpr hmem), ?_⟩
  · set p := monicOfCoeffs c
    have hpm : p.Monic := monic_monicOfCoeffs c
    have hr : g %ₘ p ∈ J := by
      rw [modByMonic_eq_sub_mul_div g p]
      exact J.sub_mem hg (J.mul_mem_right _ hmem)
    have hdeg : (g %ₘ p).degree < d := by
      nontriviality R
      rw [← natDegree_monicOfCoeffs c]
      exact (degree_modByMonic_lt g hpm).trans_le (degree_le_natDegree)
    have hsum : g %ₘ p = ∑ i : Fin d, C ((g %ₘ p).coeff i) * X ^ (i : ℕ) := by
      ext n
      rw [coeff_sum_C_mul_X_pow]
      split_ifs with hn
      · rfl
      · exact coeff_eq_zero_of_degree_lt (hdeg.trans_le (WithBot.coe_le_coe.mpr (not_lt.mp hn)))
    have hzero : lowDegreeClasses J d (fun i ↦ (g %ₘ p).coeff i) = lowDegreeClasses J d 0 := by
      rwa [lowDegreeClasses_apply, ← hsum, map_zero, Ideal.Quotient.eq_zero_iff_mem]
    have hc0 := hbij.1 hzero
    have hr0 : g %ₘ p = 0 := by
      rw [hsum]
      refine Finset.sum_eq_zero fun i _ ↦ ?_
      rw [show (g %ₘ p).coeff i = 0 from congrFun hc0 i, map_zero, zero_mul]
    rw [← modByMonic_add_div g p, hr0, zero_add]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self p)
  · intro c' hc'
    have hmem' : monicOfCoeffs c' ∈ J := hc' ▸ Ideal.mem_span_singleton_self _
    exact hbij.1 (((monicOfCoeffs_mem_iff J c').mp hmem').trans hc.symm)

/-- **The quotient by a monic polynomial.** The quotient of `R[X]` by `monicOfCoeffs c` is free,
hence finite locally free, of rank `d`. -/
theorem isFiniteLocallyFreeOfRank_quotient_monicOfCoeffs {d : ℕ} (c : Fin d → R) :
    Module.IsFiniteLocallyFreeOfRank R (R[X] ⧸ Ideal.span {monicOfCoeffs c}) d := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · have : Subsingleton (R[X] ⧸ Ideal.span {monicOfCoeffs c}) := Module.subsingleton R _
    exact Module.isFiniteLocallyFreeOfRank_of_basis
      (Module.Basis.ofRepr (LinearEquiv.ofSubsingleton _ _))
  let pb := AdjoinRoot.powerBasis' (monic_monicOfCoeffs c)
  have hdim : pb.dim = d := by
    rw [AdjoinRoot.powerBasis'_dim, natDegree_monicOfCoeffs]
  exact Module.isFiniteLocallyFreeOfRank_of_basis
    (pb.basis.reindex (finCongr hdim))

end Quotient

end Polynomial

end
