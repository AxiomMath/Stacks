module

public import Mathlib.RingTheory.PowerSeries.Ideal
public import StacksFrontier.RingTheory.RegularLocalRing.Criteria
public import StacksFrontier.RingTheory.RegularRing.Defs
public import StacksFrontier.RingTheory.RegularRing.GlobalDimension
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The power series ring over a regular ring is regular

Let `R` be a regular ring. Every maximal ideal `𝔪` of `R⟦X⟧` contains `X`, the quotient
`R⟦X⟧_𝔪 / X` is a localization of `R⟦X⟧ / X ≅ R` at a prime, hence a regular local ring, and `X`
is a nonzerodivisor; so `R⟦X⟧_𝔪` is a regular local ring by Tag 00NU. Regularity at the
remaining primes follows because a regular local ring is a regular ring (Tag 0AFS).

## Main results

* `isRegularRing_of_isRegularLocalRing_localization_isMaximal`: a Noetherian ring whose
  localizations at the *maximal* ideals are regular local rings is a regular ring.
* `PowerSeries.X_mem_of_isMaximal`: every maximal ideal of `R⟦X⟧` contains `X`.
* `PowerSeries.isRegularRing_of_isRegularRing`: `R⟦X⟧` is regular when `R` is.
-/

@[expose] public section

universe u v

open PowerSeries

/-- **Regularity need only be checked at the maximal ideals.** A Noetherian ring whose
localization at every maximal ideal is a regular local ring is a regular ring: a localization at
an arbitrary prime is a localization of one of those, and a regular local ring is regular. -/
@[ega "0 17.3.6"]
public theorem isRegularRing_of_isRegularLocalRing_localization_isMaximal (R : Type u)
    [CommRing R] [IsNoetherianRing R]
    (h : ∀ (m : Ideal R) [m.IsMaximal], IsRegularLocalRing (Localization.AtPrime m)) :
    IsRegularRing R := by
  rw [isRegularRing_iff]
  intro p hp
  obtain ⟨m, hm, hpm⟩ := p.exists_le_maximal hp.ne_top
  let := hm
  let : IsRegularLocalRing (Localization.AtPrime m) := h m
  let : IsRegularRing (Localization.AtPrime m) :=
    ((IsLocalRing.isRegularRing_tfae (R := Localization.AtPrime m)).out 1 3).mp (h m)
  have disj : Disjoint (m.primeCompl : Set R) (p : Set R) := by
    simpa [Ideal.primeCompl, ← le_compl_iff_disjoint_left] using hpm
  let : (p.map (algebraMap R (Localization.AtPrime m))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint m.primeCompl _ p hp disj
  let : IsLocalization.AtPrime
      (Localization.AtPrime (p.map (algebraMap R (Localization.AtPrime m)))) p := by
    convert IsLocalization.isLocalization_isLocalization_atPrime_isLocalization m.primeCompl
      (Localization.AtPrime (p.map (algebraMap R (Localization.AtPrime m))))
      (p.map (algebraMap R (Localization.AtPrime m)))
    exact (IsLocalization.under_map_of_isPrime_disjoint m.primeCompl _ hp disj).symm
  exact IsRegularLocalRing.of_ringEquiv (IsLocalization.algEquiv p.primeCompl
    (Localization.AtPrime (p.map (algebraMap R (Localization.AtPrime m))))
    (Localization.AtPrime p)).toRingEquiv

namespace PowerSeries

variable {R : Type u} [CommRing R]

/-- The variable is a nonzerodivisor of `R⟦X⟧`: multiplication by `X` shifts the coefficients. -/
public theorem X_mem_nonZeroDivisors : (X : R⟦X⟧) ∈ nonZeroDivisors R⟦X⟧ := by
  have key : ∀ f : R⟦X⟧, f * X = 0 → f = 0 := by
    intro f hf
    refine PowerSeries.ext fun n => ?_
    simpa [coeff_succ_mul_X] using congrArg (coeff (n + 1)) hf
  rw [mem_nonZeroDivisors_iff]
  exact ⟨fun f hf => key f (by rwa [mul_comm]), key⟩

/-- **Every maximal ideal of `R⟦X⟧` contains `X`**: a power series with constant coefficient `1`
is a unit, so `X` lies in the Jacobson radical. -/
public theorem X_mem_of_isMaximal (m : Ideal R⟦X⟧) [hm : m.IsMaximal] : (X : R⟦X⟧) ∈ m := by
  by_contra hX
  have htop : m ⊔ Ideal.span {(X : R⟦X⟧)} = ⊤ := by
    by_contra hne
    exact hX ((hm.eq_of_le hne le_sup_left) ▸
      Ideal.mem_sup_right (Ideal.mem_span_singleton_self _))
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 (htop ▸ Submodule.mem_top (x := (1 : R⟦X⟧)))
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.1 hb
  have hconst : constantCoeff a = 1 := by
    have := congrArg constantCoeff hab
    simpa using this
  exact hm.ne_top (m.eq_top_of_isUnit_mem ha
    (isUnit_iff_constantCoeff.2 (hconst ▸ isUnit_one)))

/-- The quotient of `R⟦X⟧` by the ideal generated by the variable is `R`. -/
public noncomputable def quotientSpanXEquiv :
    (R⟦X⟧ ⧸ Ideal.span {(X : R⟦X⟧)}) ≃+* R :=
  (Ideal.quotEquivOfEq (R := R⟦X⟧) (by
      ext f
      rw [RingHom.mem_ker, Ideal.mem_span_singleton, X_dvd_iff] :
        Ideal.span {(X : R⟦X⟧)} = RingHom.ker (constantCoeff (R := R)))).trans
    (RingHom.quotientKerEquivOfSurjective constantCoeff_surj)

/-- **The power series ring over a regular ring is regular.** -/
public instance isRegularRing_of_isRegularRing [IsRegularRing R] : IsRegularRing R⟦X⟧ := by
  refine isRegularRing_of_isRegularLocalRing_localization_isMaximal _ fun m hm => ?_
  let := hm
  let : IsNoetherianRing (Localization.AtPrime m) :=
    IsLocalization.isNoetherianRing m.primeCompl _ inferInstance
  have hXm : (X : R⟦X⟧) ∈ m := X_mem_of_isMaximal m
  have hIm : Ideal.span {(X : R⟦X⟧)} ≤ m := by simpa using hXm
  -- the ideal `(X)` and the identification `R⟦X⟧ / X ≅ R`
  let : IsRegularRing (R⟦X⟧ ⧸ Ideal.span {(X : R⟦X⟧)}) :=
    IsRegularRing.of_ringEquiv quotientSpanXEquiv.symm
  let : (m.map (Ideal.Quotient.mk (Ideal.span {(X : R⟦X⟧)}))).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hIm)
  -- the complement of the image prime is the image of the complement
  have hsub : Algebra.algebraMapSubmonoid (R⟦X⟧ ⧸ Ideal.span {(X : R⟦X⟧)}) m.primeCompl =
      (m.map (Ideal.Quotient.mk (Ideal.span {(X : R⟦X⟧)}))).primeCompl := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨a, ha, rfl⟩ hmem
      refine ha ?_
      have hcomap : a ∈ m ⊔ Ideal.span {(X : R⟦X⟧)} := by
        simpa [Ideal.Quotient.algebraMap_eq] using hmem
      rwa [sup_of_le_left hIm] at hcomap
    · intro b hb
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      exact ⟨a, fun ham => hb (Ideal.mem_map_of_mem _ ham), by simp⟩
  let : IsLocalization.AtPrime
      (Localization.AtPrime m ⧸
        (Ideal.span {(X : R⟦X⟧)}).map (algebraMap R⟦X⟧ (Localization.AtPrime m)))
      (m.map (Ideal.Quotient.mk (Ideal.span {(X : R⟦X⟧)}))) := by
    have hloc : IsLocalization
        (Algebra.algebraMapSubmonoid (R⟦X⟧ ⧸ Ideal.span {(X : R⟦X⟧)}) m.primeCompl)
        (Localization.AtPrime m ⧸
          (Ideal.span {(X : R⟦X⟧)}).map (algebraMap R⟦X⟧ (Localization.AtPrime m))) :=
      inferInstance
    rwa [hsub] at hloc
  refine isRegularLocalRing_of_nonZeroDivisor (Localization.AtPrime m)
    (algebraMap R⟦X⟧ (Localization.AtPrime m) X)
    (IsLocalization.map_nonZeroDivisors_le m.primeCompl _
      (Submonoid.mem_map_of_mem _ X_mem_nonZeroDivisors)) ?_
  have hspan : Ideal.span {algebraMap R⟦X⟧ (Localization.AtPrime m) (X : R⟦X⟧)} =
      (Ideal.span {(X : R⟦X⟧)}).map (algebraMap R⟦X⟧ (Localization.AtPrime m)) := by
    rw [Ideal.map_span]
    simp
  rw [hspan]
  exact IsRegularRing.isRegularLocalRing_of_isLocalization
    (m.map (Ideal.Quotient.mk (Ideal.span {(X : R⟦X⟧)}))) _

end PowerSeries

end
