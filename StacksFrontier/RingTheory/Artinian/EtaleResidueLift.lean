module

public import Mathlib.FieldTheory.Minpoly.Field
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.RingHom.Etale
public import Mathlib.RingTheory.Unramified.Field
public import Mathlib.RingTheory.Unramified.LocalRing
public import Mathlib.RingTheory.EssentialFiniteness
public import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# Lifting a residue point through a monogenic extension

Let `res : A → k` be a surjection onto a field with nilpotent kernel, let `L / k` be a field
extension generated by one element `θ`, and let `G ∈ A[X]` be monic with reduction the minimal
polynomial of `θ`. The evaluation `A[X] / (G) → L` at `θ` is then surjective with nilpotent
kernel. Consequently a formally smooth algebra `E` over a ring `R` whose structure maps to `A`
and to `L` are compatible admits an `R`-algebra map `E → A[X] / (G)`.

## Main definitions

* `Stacks.EtaleResidueLift.adjoinRootEval`: the evaluation `A[X] / (G) → L` at `θ`.

## Main results

* `Stacks.EtaleResidueLift.adjoinRootEval_surjective` and
  `Stacks.EtaleResidueLift.isNilpotent_ker_adjoinRootEval`: the evaluation is surjective with
  nilpotent kernel.
* `Stacks.EtaleResidueLift.exists_ringHom_adjoinRoot`: the lift `E → A[X] / (G)`.
* `Stacks.EtaleResidueLift.exists_monic_ringHom_adjoinRoot_of_etale`: an étale algebra over a
  local ring with nilpotent maximal ideal has a point with values in `A[X] / (g)` for every monic
  `g` reducing to a suitable monic polynomial over the residue field.

## Implementation notes

This is used to lift a point of an étale chart of an algebraic space over the spectrum of an
Artinian local ring after a finite *monogenic* extension of that ring: the residue field of the
chart point is generated by one element over the residue field of the ring, being finite
separable over it, and the monic extension is the one for which the retraction of
`Stacks.MonicExtension.retraction` is available.
-/

@[expose] public section

open Polynomial

namespace Stacks.EtaleResidueLift

variable {A : Type*} [CommRing A] {k : Type*} [Field k] (res : A →+* k)
  {L : Type*} [Field L] [Algebra k L] (θ : L) {G : A[X]} (hG : G.Monic)
  (hGθ : G.map res = minpoly k θ)

include hGθ in
/-- `θ` is a root of `G`, viewed as a polynomial over `L` through `res`. -/
theorem eval₂_eq_zero : G.eval₂ ((algebraMap k L).comp res) θ = 0 := by
  rw [← eval₂_map, hGθ, ← aeval_def, minpoly.aeval]

/-- The evaluation `A[X] / (G) → L` sending the root to `θ`. -/
noncomputable def adjoinRootEval : AdjoinRoot G →+* L :=
  AdjoinRoot.lift ((algebraMap k L).comp res) θ (eval₂_eq_zero res θ hGθ)

/-- The evaluation sends the class of `p` to `p` reduced by `res` and evaluated at `θ`. -/
theorem adjoinRootEval_mk (p : A[X]) :
    adjoinRootEval res θ hGθ (AdjoinRoot.mk G p) = aeval θ (p.map res) := by
  rw [adjoinRootEval, AdjoinRoot.lift_mk, aeval_def, eval₂_map]

/-- The evaluation restricted to `A` is `res` followed by the inclusion `k → L`. -/
theorem adjoinRootEval_of (a : A) :
    adjoinRootEval res θ hGθ (AdjoinRoot.of G a) = algebraMap k L (res a) := by
  rw [adjoinRootEval, AdjoinRoot.lift_of]
  rfl

/-- If `res` is surjective and `θ` generates `L` over `k`, the evaluation is surjective. -/
theorem adjoinRootEval_surjective (hres : Function.Surjective res)
    (hgen : Algebra.adjoin k {θ} = ⊤) : Function.Surjective (adjoinRootEval res θ hGθ) := by
  intro y
  have hy : y ∈ Algebra.adjoin k {θ} := hgen ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨q, rfl⟩ := hy
  obtain ⟨p, hp⟩ := Polynomial.map_surjective res hres q
  refine ⟨AdjoinRoot.mk G p, ?_⟩
  rw [adjoinRootEval_mk, hp]
  rfl

include hG in
/-- The kernel of the evaluation lies in the extension of the kernel of `res`. -/
theorem ker_adjoinRootEval_le (_hθ : IsIntegral k θ) :
    RingHom.ker (adjoinRootEval res θ hGθ) ≤ (RingHom.ker res).map (AdjoinRoot.of G) := by
  intro x hx
  rcases subsingleton_or_nontrivial A with hA | hA
  · have : Subsingleton (AdjoinRoot G) := Module.subsingleton A (AdjoinRoot G)
    rw [Subsingleton.elim x 0]
    exact Ideal.zero_mem _
  obtain ⟨f, rfl⟩ := AdjoinRoot.mk_surjective x
  set p := f %ₘ G with hp
  have hxp : AdjoinRoot.mk G p = AdjoinRoot.mk G f := by
    rw [hp, ← AdjoinRoot.modByMonicHom_mk hG f]
    exact AdjoinRoot.mk_leftInverse hG _
  have hdeg : (p.map res).degree < (minpoly k θ).degree := by
    rw [← hGθ]
    refine lt_of_le_of_lt degree_map_le (lt_of_lt_of_le (degree_modByMonic_lt _ hG) ?_)
    rw [hG.degree_map]
  have h0 : p.map res = 0 := by
    by_contra hne
    have hzero : aeval θ (p.map res) = 0 := by
      rw [← adjoinRootEval_mk, hxp]
      exact hx
    exact not_le.2 hdeg (minpoly.degree_le_of_ne_zero k θ hne hzero)
  have hcoeff : ∀ n, p.coeff n ∈ RingHom.ker res := fun n => by
    simpa [coeff_map, RingHom.mem_ker] using congrArg (fun q => q.coeff n) h0
  rw [← hxp, p.as_sum_range_C_mul_X_pow, map_sum]
  refine Ideal.sum_mem _ fun n _ => ?_
  rw [map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hcoeff n))

include hG in
/-- If `θ` is integral over `k` and the kernel of `res` is nilpotent, the kernel of the
evaluation is nilpotent. -/
theorem isNilpotent_ker_adjoinRootEval (hθ : IsIntegral k θ)
    (hker : IsNilpotent (RingHom.ker res)) :
    IsNilpotent (RingHom.ker (adjoinRootEval res θ hGθ)) := by
  obtain ⟨n, hn⟩ := hker
  refine ⟨n, le_bot_iff.1 ?_⟩
  calc RingHom.ker (adjoinRootEval res θ hGθ) ^ n
      ≤ ((RingHom.ker res).map (AdjoinRoot.of G)) ^ n :=
        Ideal.pow_right_mono (ker_adjoinRootEval_le res θ hG hGθ hθ) n
    _ = (RingHom.ker res ^ n).map (AdjoinRoot.of G) := (Ideal.map_pow _ _ _).symm
    _ = ⊥ := by rw [hn, Ideal.zero_eq_bot, Ideal.map_bot]

include hG hGθ in
/-- **The lift.** Let `E` be a formally smooth `R`-algebra, `φ : R → A`, and `ε : E → L` with
`res ∘ φ` and `ε` inducing the same map `R → L`. Then there is a ring map
`E → A[X] / (G)` restricting to `φ` on `R`. -/
theorem exists_ringHom_adjoinRoot {R E : Type*} [CommRing R] [CommRing E] [Algebra R E]
    [Algebra.FormallySmooth R E] (φ : R →+* A) (ε : E →+* L)
    (hcompat : ∀ r, algebraMap k L (res (φ r)) = ε (algebraMap R E r))
    (hres : Function.Surjective res) (hker : IsNilpotent (RingHom.ker res))
    (hθ : IsIntegral k θ) (hgen : Algebra.adjoin k {θ} = ⊤) :
    ∃ ℓ : E →+* AdjoinRoot G, ℓ.comp (algebraMap R E) = (AdjoinRoot.of G).comp φ := by
  let : Algebra R A := φ.toAlgebra
  let : Algebra R (AdjoinRoot G) := ((AdjoinRoot.of G).comp φ).toAlgebra
  let : Algebra R L := (ε.comp (algebraMap R E)).toAlgebra
  let εR : E →ₐ[R] L := { ε with commutes' := fun r => rfl }
  let ψR : AdjoinRoot G →ₐ[R] L :=
    { adjoinRootEval res θ hGθ with
      commutes' := fun r => by
        change adjoinRootEval res θ hGθ (AdjoinRoot.of G (φ r)) = ε (algebraMap R E r)
        rw [adjoinRootEval_of, hcompat] }
  let ℓR := Algebra.FormallySmooth.liftOfSurjective εR ψR
    (adjoinRootEval_surjective res θ hGθ hres hgen)
    (isNilpotent_ker_adjoinRootEval res θ hG hGθ hθ hker)
  exact ⟨ℓR.toRingHom, RingHom.ext ℓR.commutes⟩

/-- A ring map out of a local ring with nilpotent maximal ideal to a nontrivial ring is local. -/
theorem isLocalHom_of_isNilpotent {A : Type*} [CommRing A] [IsLocalRing A]
    (hm : IsNilpotent (IsLocalRing.maximalIdeal A)) {S : Type*} [CommRing S]
    [Nontrivial S] (f : A →+* S) : IsLocalHom f := by
  refine ⟨fun x hx => ?_⟩
  by_contra hnx
  obtain ⟨n, hn⟩ := hm
  have hxm : x ∈ IsLocalRing.maximalIdeal A := hnx
  have hxn : x ^ n = 0 := by
    have : x ^ n ∈ IsLocalRing.maximalIdeal A ^ n := Ideal.pow_mem_pow hxm n
    rw [hn, Ideal.zero_eq_bot] at this
    exact Ideal.mem_bot.1 this
  exact (IsNilpotent.map ⟨n, hxn⟩ f).not_isUnit hx

/-- **A point of an étale algebra after a monogenic extension.** Let `A` be a local ring with
nilpotent maximal ideal and `φ : A → R` an étale ring map to a nontrivial ring. There is a monic
polynomial `gbar` of positive degree over the residue field of `A` such that for every monic
`g ∈ A[X]` reducing to `gbar` there is a ring map `R → A[X]/(g)` under `A`. -/
theorem exists_monic_ringHom_adjoinRoot_of_etale {A R : Type*} [CommRing A] [IsLocalRing A]
    (hm : IsNilpotent (IsLocalRing.maximalIdeal A)) [CommRing R] [Nontrivial R] (φ : A →+* R)
    (hφ : φ.Etale) :
    ∃ gbar : (IsLocalRing.ResidueField A)[X], gbar.Monic ∧ 0 < gbar.natDegree ∧
      ∀ g : A[X], g.Monic → g.map (IsLocalRing.residue A) = gbar →
        ∃ ℓ : R →+* AdjoinRoot g, ℓ.comp φ = AdjoinRoot.of g := by
  classical
  let : Algebra A R := φ.toAlgebra
  have : Algebra.Etale A R := RingHom.Etale.toAlgebra hφ
  obtain ⟨q, hq⟩ := Ideal.exists_maximal R
  let Sq := Localization.AtPrime q
  have : IsLocalHom (algebraMap A Sq) := isLocalHom_of_isNilpotent hm _
  have : Algebra.EssFiniteType A Sq := Algebra.EssFiniteType.comp A R Sq
  let kA := IsLocalRing.ResidueField A
  let kS := IsLocalRing.ResidueField Sq
  have : Algebra.IsSeparable kA kS := Algebra.FormallyUnramified.isSeparable _ _
  have : Module.Finite kA kS := Algebra.FormallyUnramified.finite_of_free _ _
  obtain ⟨θ, hθ⟩ := Field.exists_primitive_element kA kS
  have hθint : IsIntegral kA θ := Algebra.IsIntegral.isIntegral θ
  refine ⟨minpoly kA θ, minpoly.monic hθint, minpoly.natDegree_pos hθint, fun g hg hgθ => ?_⟩
  have hgen : Algebra.adjoin kA {θ} = ⊤ := by
    simpa [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic] using
      (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hθint.isAlgebraic).1 hθ
  have hker : IsNilpotent (RingHom.ker (IsLocalRing.residue A)) := by
    rwa [IsLocalRing.ker_residue]
  obtain ⟨ℓ, hℓ⟩ := exists_ringHom_adjoinRoot (IsLocalRing.residue A) θ hg hgθ
    (R := A) (E := Sq) (RingHom.id A) (IsLocalRing.residue Sq)
    (fun a => by simp [kS])
    IsLocalRing.residue_surjective hker hθint hgen
  refine ⟨ℓ.comp (algebraMap R Sq), ?_⟩
  have : (algebraMap R Sq).comp φ = algebraMap A Sq := (IsScalarTower.algebraMap_eq A R Sq).symm
  rw [RingHom.comp_assoc, this, hℓ, RingHom.comp_id]

end Stacks.EtaleResidueLift
