/-!
# A finitely presented ring map whose smooth locus is not quasi-compact

For a nontrivial commutative ring `k`, let
`R = k[x, y_0, y_1, …] / (x y_0, x y_1, …)` and let `A = R/(x)`. The ring map `R → A` is of
finite presentation, its smooth locus is the union of the standard opens `D(y_i)`, and that
union is not quasi-compact. So the smooth locus of a finitely presented ring map need not be
quasi-compact.

The two halves of the computation of the smooth locus are: away from all the `y_i` the map is
not smooth, because the kernel of the localized map is generated by the image of `x`, which is
nonzero there and yet must be idempotent by formal smoothness; and on `D(y_i)` the map becomes
an isomorphism after inverting `y_i`, hence is smooth. Non-compactness follows by exhibiting,
for each finite subfamily, a prime containing exactly the `y_i` in it.

## Main definitions

* `Stacks.Smoothing.NotQuasiCompact.relationIdeal` and
  `Stacks.Smoothing.NotQuasiCompact.baseRing`: the ring `R`.
* `Stacks.Smoothing.NotQuasiCompact.xIdeal` and
  `Stacks.Smoothing.NotQuasiCompact.quotientRing`: the ideal `(x)` and the ring `A`.
* `Stacks.Smoothing.NotQuasiCompact.y`: the images of the variables `y_i` in `A`.

## Main results

* `Stacks.Smoothing.NotQuasiCompact.finitePresentation`: `R → A` is of finite presentation.
* `Stacks.Smoothing.NotQuasiCompact.smoothLocus_eq_iUnion`: its smooth locus is `⋃ i, D(y_i)`.
* `Stacks.Smoothing.NotQuasiCompact.smoothLocus_not_compact`: that smooth locus is not
  quasi-compact.

## Implementation notes

The variable type is `Option ℕ`: `none` is `x` and `some i` is `y_i`. Quasi-compactness is
compactness of the corresponding subset of the prime spectrum.

## References

* [Stacks Project, Tag 07CB](https://stacks.math.columbia.edu/tag/07CB)
-/

@[expose] public section

open Algebra

namespace Stacks.Smoothing.NotQuasiCompact

variable (k : Type*) [CommRing k] [Nontrivial k]

/-- The ideal `(x y_0, x y_1, …)` of the polynomial ring `k[x, y_0, y_1, …]`. -/
noncomputable def relationIdeal (k : Type*) [CommRing k] [Nontrivial k] :
    Ideal (MvPolynomial (Option ℕ) k) :=
  Ideal.span (Set.range (fun i : ℕ => MvPolynomial.X none * MvPolynomial.X (some i)))

/-- The ring `R = k[x, y_0, y_1, …] / (x y_0, x y_1, …)`. -/
abbrev baseRing (k : Type*) [CommRing k] [Nontrivial k] :=
  MvPolynomial (Option ℕ) k ⧸ relationIdeal k

/-- The ideal `(x)` of `R`. -/
noncomputable def xIdeal (k : Type*) [CommRing k] [Nontrivial k] : Ideal (baseRing k) :=
  Ideal.span {Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X none)}

/-- The ring `A = R/(x)`. -/
abbrev quotientRing (k : Type*) [CommRing k] [Nontrivial k] := baseRing k ⧸ xIdeal k

/-- The image of the variable `y_i` in `A`. -/
noncomputable def y (k : Type*) [CommRing k] [Nontrivial k] (i : ℕ) : quotientRing k :=
  Ideal.Quotient.mk (xIdeal k)
    (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i)))

private noncomputable abbrev polynomialYIdeal : Ideal (MvPolynomial (Option ℕ) k) :=
  Ideal.span (Set.range (fun i : ℕ => MvPolynomial.X (some i)))

private lemma relationIdeal_eq_mul_polynomialYIdeal :
    relationIdeal k = Ideal.span {MvPolynomial.X none} * polynomialYIdeal k := by
  rw [relationIdeal, polynomialYIdeal, Submodule.span_mul_span]
  congr 1
  ext p
  simp [mul_comm]

private lemma annihilator_x_mem_prime (q : Ideal (quotientRing k))
    [q.IsPrime] (hq : ∀ i, y k i ∈ q) {a : baseRing k}
    (ha : a * Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X none) = 0) :
    Ideal.Quotient.mk (xIdeal k) a ∈ q := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hpRel : MvPolynomial.X none * p ∈ relationIdeal k := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    simpa [mul_comm] using ha
  rw [relationIdeal_eq_mul_polynomialYIdeal] at hpRel
  obtain ⟨z, hz, hzp⟩ := Ideal.mem_span_singleton_mul.mp hpRel
  obtain rfl : p = z := (MvPolynomial.X_mul_cancel_left_iff (i := none)).mp hzp.symm
  let ψ : MvPolynomial (Option ℕ) k →+* quotientRing k :=
    (Ideal.Quotient.mk (xIdeal k)).comp (Ideal.Quotient.mk (relationIdeal k))
  have hmap : Ideal.map ψ (polynomialYIdeal k) ≤ q := by
    rw [Ideal.map_le_iff_le_comap]
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    simpa [ψ, y] using hq i
  simpa [ψ] using hmap (Ideal.mem_map_of_mem ψ hz)

private lemma primeCompl_map_quotient (q : Ideal (quotientRing k)) [q.IsPrime] :
    Submonoid.map (Ideal.Quotient.mk (xIdeal k))
      ((Ideal.comap (Ideal.Quotient.mk (xIdeal k)) q).primeCompl) = q.primeCompl := by
  ext z
  constructor
  · rintro ⟨r, hr, rfl⟩
    simpa [Ideal.mem_comap] using hr
  · intro hz
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨r, by simpa using hz, rfl⟩

/-- In the localization at a prime `p`, an element `x ∈ p` whose annihilator lies in `p` is not a
multiple of its own square. -/
private lemma algebraMap_notMem_span_mul_self {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime]
    {x : R} (hx : x ∈ p) (hann : ∀ a, a * x = 0 → a ∈ p) :
    algebraMap R (Localization.AtPrime p) x ∉
      Ideal.span {algebraMap R (Localization.AtPrime p) x *
        algebraMap R (Localization.AtPrime p) x} := by
  intro h
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp h
  obtain ⟨r, s, rfl⟩ := IsLocalization.exists_mk'_eq (S := Localization.AtPrime p) p.primeCompl t
  have hnum : IsLocalization.mk' (Localization.AtPrime p) (r * x ^ 2) s =
      algebraMap R (Localization.AtPrime p) x := by
    calc
      IsLocalization.mk' (Localization.AtPrime p) (r * x ^ 2) s =
          IsLocalization.mk' (Localization.AtPrime p) r s *
            algebraMap R (Localization.AtPrime p) (x ^ 2) := by
            rw [← IsLocalization.mk'_one (S := Localization.AtPrime p) (M := p.primeCompl) (x ^ 2),
              ← IsLocalization.mk'_mul]
            simp
      _ = algebraMap R (Localization.AtPrime p) x := by
        rw [pow_two, map_mul]
        exact ht
  obtain ⟨c, hc⟩ : ∃ c : p.primeCompl, (c : R) * (r * x ^ 2) = (c : R) * (x * (s : R)) := by
    apply (IsLocalization.eq_iff_exists p.primeCompl (Localization.AtPrime p)).mp
    simpa [map_mul] using (IsLocalization.mk'_eq_iff_eq_mul.mp hnum)
  have hmul : (c : R) * ((s : R) - x * r) ∈ p := hann _ <| by linear_combination -hc
  have hdiff := (‹p.IsPrime›.mem_or_mem hmul).resolve_left
    (by simpa [Ideal.primeCompl, Set.mem_compl_iff] using c.2)
  exact (show (s : R) ∉ p by simpa [Ideal.primeCompl, Set.mem_compl_iff] using s.2)
    (by simpa using p.add_mem hdiff (p.mul_mem_right r hx))

private lemma not_smoothAt_of_all_y_mem (z : PrimeSpectrum (quotientRing k))
    (hq : ∀ i, y k i ∈ z.asIdeal) :
    ¬ Algebra.IsSmoothAt (R := baseRing k) (A := quotientRing k) z.asIdeal := by
  intro hsm
  let q := z.asIdeal
  let : q.IsPrime := z.isPrime
  let R := baseRing k
  let A := quotientRing k
  let : CommRing R := Ideal.Quotient.commRing (relationIdeal k)
  let : CommRing A := Ideal.Quotient.commRing (xIdeal k)
  let π : R →+* A := Ideal.Quotient.mk (xIdeal k)
  let p : Ideal R := Ideal.comap π q
  let : p.IsPrime := Ideal.comap_isPrime π q
  let M := p.primeCompl
  let Rₘ := Localization M
  let Sₘ := Localization.AtPrime q
  let x : R := Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X none)
  let xₘ : Rₘ := algebraMap R Rₘ x
  have hπx : π x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr <| by
    rw [xIdeal]
    exact Ideal.subset_span (by simp [x])
  let : IsLocalization (M.map π) Sₘ := by
    rw [show M.map π = q.primeCompl by simpa [M, p] using primeCompl_map_quotient k q]
    infer_instance
  let ψ : Rₘ →+* Sₘ := IsLocalization.map Sₘ π (Submonoid.le_comap_map M)
  let : Algebra Rₘ Sₘ := ψ.toAlgebra
  have hcomp : algebraMap R Sₘ = ψ.comp (algebraMap R Rₘ) := by
    rw [show ψ = IsLocalization.map Sₘ π (Submonoid.le_comap_map M) from rfl,
      IsLocalization.map_comp]
    exact IsScalarTower.algebraMap_eq R A Sₘ
  let : IsScalarTower R Rₘ Sₘ := IsScalarTower.of_algebraMap_eq' hcomp
  have hformal : Algebra.FormallySmooth Rₘ Sₘ :=
    Algebra.FormallySmooth.localization_base M
  have hidem : IsIdempotentElem (RingHom.ker ψ) := by
    apply (Algebra.FormallySmooth.iff_of_surjective (R := Rₘ) (A := Sₘ)
      (IsLocalization.map_surjective_of_surjective M Rₘ Sₘ Ideal.Quotient.mk_surjective)).mp
    simpa [RingHom.algebraMap_toAlgebra] using hformal
  have hxker : xₘ ∈ RingHom.ker ψ := by
    change (ψ.comp (algebraMap R Rₘ)) x = 0
    rw [← hcomp]
    have hxmap : algebraMap R Sₘ x = algebraMap A Sₘ (π x) :=
      congrArg (fun f => f x) (IsScalarTower.algebraMap_eq R A Sₘ)
    rw [hxmap, hπx]
    simp
  have hker : RingHom.ker ψ = Ideal.span {xₘ} := by
    change RingHom.ker (IsLocalization.map Sₘ π (Submonoid.le_comap_map M)) = _
    rw [IsLocalization.ker_map (Q := Sₘ) (g := π) (hT := rfl), Ideal.mk_ker]
    simp [xIdeal, xₘ, x, Ideal.map_span]
  have hxSq : xₘ ∈ RingHom.ker ψ * RingHom.ker ψ := by rwa [hidem]
  rw [hker, Ideal.span_singleton_mul_span_singleton] at hxSq
  have hxp : x ∈ p := Ideal.mem_comap.mpr <| by
    rw [hπx]
    exact q.zero_mem
  exact algebraMap_notMem_span_mul_self p hxp
    (fun a ha => Ideal.mem_comap.mpr (annihilator_x_mem_prime k q hq ha)) hxSq

/-- Expanding the quotient ideal reduces the kernel test to the defining relations. -/
private lemma awayMap_bijective (i : ℕ) :
    Function.Bijective (@Localization.awayMap (baseRing k) _ (quotientRing k) _
      (Ideal.Quotient.mk (xIdeal k) : baseRing k →+* quotientRing k)
      (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i)))) := by
  constructor
  · apply (Localization.awayMap_injective_iff).2
    intro a ha
    refine ⟨1, ?_⟩
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp ha)
    have hxy :
        (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X none)) *
            (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i))) = 0 := by
      rw [← map_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    linear_combination b * hxy
  · apply (Localization.awayMap_surjective_iff).2
    intro a
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective a
    exact ⟨b, 0, by simp⟩

/-- Smoothness is transported through the two successive quotient localizations. -/
private lemma smooth_away (i : ℕ) :
    Algebra.Smooth (baseRing k) (Localization.Away (y k i)) := by
  let : CommRing (baseRing k) := Ideal.Quotient.commRing (relationIdeal k)
  let : CommRing (quotientRing k) := Ideal.Quotient.commRing (xIdeal k)
  rw [← RingHom.smooth_algebraMap]
  let g : (@RingHom (Localization.Away (Ideal.Quotient.mk (relationIdeal k)
      (MvPolynomial.X (some i))))
      (Localization.Away (y k i))
      NonAssocCommSemiring.toNonAssocSemiring NonAssocCommSemiring.toNonAssocSemiring) :=
    @Localization.awayMap (baseRing k) CommRing.toCommSemiring (quotientRing k)
      CommRing.toCommSemiring
      (Ideal.Quotient.mk (xIdeal k) : baseRing k →+* quotientRing k)
      (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i)))
  have hg : g.Smooth := RingHom.Smooth.of_bijective (awayMap_bijective k i)
  have hf : (algebraMap (baseRing k)
      (Localization.Away (Ideal.Quotient.mk (relationIdeal k)
        (MvPolynomial.X (some i))))).Smooth :=
    RingHom.Smooth.holdsForLocalizationAway
      (Localization.Away (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i))))
      (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i)))
  change (algebraMap (baseRing k) (Localization.Away (y k i))).Smooth
  let r : baseRing k := Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (some i))
  let π : baseRing k →+* quotientRing k := Ideal.Quotient.mk (xIdeal k)
  have hpow : Submonoid.powers r ≤ (Submonoid.powers (π r)).comap π := by
    rintro _ ⟨n, rfl⟩
    exact ⟨n, by simp⟩
  have hpowEq : Submonoid.powers (π r) = Submonoid.powers (y k i) := by
    ext z
    simp [π, r, y]
  have : IsLocalization (Submonoid.powers (π r)) (Localization.Away (y k i)) := by
    rw [hpowEq]
    infer_instance
  have hmap : g.comp (algebraMap (baseRing k)
      (Localization.Away (Ideal.Quotient.mk (relationIdeal k)
        (MvPolynomial.X (some i))))) =
      algebraMap (baseRing k) (Localization.Away (y k i)) := by
    refine RingHom.ext fun a => ?_
    calc
      g (algebraMap (baseRing k) (Localization.Away r) a) =
          IsLocalization.map (Q := Localization.Away (y k i)) π hpow
            (algebraMap (baseRing k) (Localization.Away r) a) := rfl
      _ = algebraMap (quotientRing k) (Localization.Away (y k i)) (π a) :=
        IsLocalization.map_eq hpow a
      _ = algebraMap (baseRing k) (Localization.Away (y k i)) a :=
        congrArg (fun f => f a)
          (IsScalarTower.algebraMap_eq (baseRing k) (quotientRing k)
            (Localization.Away (y k i))).symm
  rw [← hmap]
  exact hf.comp hg

/-- The ring map `R → A = R/(x)` is of finite presentation. -/
@[stacks 07CB]
theorem finitePresentation : Algebra.FinitePresentation (baseRing k) (quotientRing k) :=
  Algebra.FinitePresentation.quotient (Submodule.fg_span_singleton _)

/-- A prime of `A` lies in `⋃ i, D(y_i)` iff some `y_i` is not in it. -/
private lemma mem_iUnion_basicOpen_y_iff (z : PrimeSpectrum (quotientRing k)) :
    z ∈ ⋃ i : ℕ, (PrimeSpectrum.basicOpen (y k i) : Set (PrimeSpectrum (quotientRing k))) ↔
      ∃ i, y k i ∉ z.asIdeal := by
  simp

/-- The smooth locus of `R → A` is the union of the standard opens `D(y_i)`. -/
@[stacks 07CB]
theorem smoothLocus_eq_iUnion :
    Algebra.smoothLocus (baseRing k) (quotientRing k) =
      ⋃ i : ℕ, (PrimeSpectrum.basicOpen (y k i) : Set (PrimeSpectrum (quotientRing k))) := by
  have : Algebra.FinitePresentation (baseRing k) (quotientRing k) := finitePresentation k
  ext z
  rw [mem_iUnion_basicOpen_y_iff]
  constructor
  · intro hz
    change Algebra.IsSmoothAt (R := baseRing k) (A := quotientRing k) z.asIdeal at hz
    by_contra hnot
    exact (not_smoothAt_of_all_y_mem k z (by simpa using hnot)) hz
  · rintro ⟨i, hi⟩
    exact (Algebra.basicOpen_subset_smoothLocus_iff_smooth
      (R := baseRing k) (A := quotientRing k) (f := y k i)).mpr (smooth_away k i)
      ((PrimeSpectrum.mem_basicOpen (y k i) z).mpr hi)

/-- For every finite set `t` of indices there is a prime of `A` containing `y_i` for `i ∈ t` and
not containing `y_i` for `i ∉ t`. -/
private lemma exists_primeSpectrum_y_mem_and_notMem (t : Finset ℕ) :
    ∃ z : PrimeSpectrum (quotientRing k),
      (∀ i ∈ t, y k i ∈ z.asIdeal) ∧ ∀ i ∉ t, y k i ∉ z.asIdeal := by
  classical
  obtain ⟨m, hm⟩ := Ideal.exists_maximal k
  let : m.IsMaximal := hm
  let vars : Option ℕ → MvPolynomial ℕ (k ⧸ m)
    | none => 0
    | some i => if i ∈ t then 0 else MvPolynomial.X i
  let φ₀ : MvPolynomial (Option ℕ) k →+* MvPolynomial ℕ (k ⧸ m) :=
    MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (Ideal.Quotient.mk m)) vars
  have hrel : relationIdeal k ≤ RingHom.ker φ₀ := by
    rw [relationIdeal]
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    simp [φ₀, vars]
  let φR : baseRing k →+* MvPolynomial ℕ (k ⧸ m) :=
    Ideal.Quotient.lift (relationIdeal k) φ₀ (fun a ha => RingHom.mem_ker.mp (hrel ha))
  have hxIdeal : xIdeal k ≤ RingHom.ker φR := by
    rw [xIdeal, Ideal.span_le]
    rintro _ rfl
    exact RingHom.mem_ker.mpr (by simp [φR, φ₀, vars])
  let φA : quotientRing k →+* MvPolynomial ℕ (k ⧸ m) :=
    Ideal.Quotient.lift (xIdeal k) φR (fun a ha => RingHom.mem_ker.mp (hxIdeal ha))
  refine ⟨⟨RingHom.ker φA, RingHom.ker_isPrime φA⟩, fun i hi => ?_, fun i hi hiq => ?_⟩
  · exact RingHom.mem_ker.mpr (by simp [φA, y, φR, φ₀, vars, hi])
  · have hX : MvPolynomial.X i = (0 : MvPolynomial ℕ (k ⧸ m)) := by
      simpa [φA, y, φR, φ₀, vars, hi] using RingHom.mem_ker.mp hiq
    exact MvPolynomial.X_ne_zero i hX

/-- The smooth locus of the finitely presented ring map `R → A` is not quasi-compact. -/
@[stacks 07CB]
theorem smoothLocus_not_compact :
    ¬ IsCompact (Algebra.smoothLocus (baseRing k) (quotientRing k)) := by
  intro hcompact
  let U : ℕ → Set (PrimeSpectrum (quotientRing k)) := fun i => PrimeSpectrum.basicOpen (y k i)
  obtain ⟨t, ht⟩ := hcompact.elim_finite_subcover U
    (fun _ => PrimeSpectrum.isOpen_basicOpen) (smoothLocus_eq_iUnion k).subset
  obtain ⟨j, hjnot⟩ := Infinite.exists_notMem_finset t
  obtain ⟨z, hzt, hzj⟩ := exists_primeSpectrum_y_mem_and_notMem k t
  have hzsm : z ∈ Algebra.smoothLocus (baseRing k) (quotientRing k) := by
    rw [smoothLocus_eq_iUnion, mem_iUnion_basicOpen_y_iff]
    exact ⟨j, hzj j hjnot⟩
  obtain ⟨i, hit, hzi⟩ := Set.mem_iUnion₂.mp (ht hzsm)
  exact (PrimeSpectrum.mem_basicOpen (y k i) z).mp hzi (hzt i hit)

end Stacks.Smoothing.NotQuasiCompact

end
