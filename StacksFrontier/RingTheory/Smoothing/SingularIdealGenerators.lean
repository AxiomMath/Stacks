module

public import StacksFrontier.RingTheory.Smoothing.PresentationRelabel
public import StacksFrontier.RingTheory.Smoothing.SingularIdeals
public import StacksFrontier.RingTheory.Smoothing.StandardElementAtSmoothPrime
public import StacksFrontier.RingTheory.Smoothing.StandardnessConditions

/-!
# Generators of the singular ideal: standard elements

Let `R → A` be a ring map of finite presentation. The singular ideal `H_{A/R}` is the radical of
the ideal generated by the strictly standard elements of `A` over `R`, and also the radical of the
ideal generated by the elementary standard elements.

Both descriptions come from one computation: for a prime `q` of `A`, the map `R → A` fails to be
smooth at `q` exactly when every elementary standard element lies in `q`, and likewise exactly
when every strictly standard element lies in `q`. Since an ideal generated by a set of elements is
contained in a prime exactly when each of those elements is, this identifies the vanishing locus
of each radical with the non-smooth locus, and the uniqueness in the definition of the singular
ideal does the rest.

## Main definitions

* `Presentation.relabel`: the presentation obtained by permuting the variables and the relations.

## Main results

* `Stacks.Smoothing.exists_notMem_isElementaryStandard_of_smoothAt`: at a prime of smoothness
  some elementary standard element avoids that prime.
* `Stacks.Smoothing.singularIdeal_eq_radical_span_isElementaryStandard` and
  `Stacks.Smoothing.singularIdeal_eq_radical_span_isStrictlyStandard`: the two descriptions of the
  singular ideal.
* `Stacks.Smoothing.smoothAt_of_isElementaryStandard_of_notMem` and
  `Stacks.Smoothing.smoothAt_of_isStrictlyStandard_of_notMem`: a standard element avoiding a prime
  witnesses smoothness there.

## Implementation notes

The direction with content is that smoothness at `q` produces an elementary standard element
outside `q`. `Stacks.Smoothing.exists_notMem_eq_mul_jacobianMinorOn_of_smoothAt` produces the two
defining conditions of elementary standardness, but with respect to an arbitrary set `U` of `c`
variables and an arbitrary set `V` of `c` relations instead of the first `c` of each; `relabel`
permutes the variables and the relations of a presentation so that `U` and `V` become the first
`c`, which is what turns the conclusion into an instance of `IsElementaryStandard`.

The converse needs no new input: an elementary standard element `a` has `A_a` standard smooth over
`R` (Stacks 07EZ), hence smooth, so `R → A` is smooth at every prime avoiding `a`. For the
strictly standard description, a strictly standard `a` outside `q` has one of its Jacobian minors
`δ` outside `q` as well, and `a · δ` is elementary standard — the same relabelling, now with the
relations left in place — so the two radicals lie under the same primes.

## References

* [Stacks Project, Tag 07CA](https://stacks.math.columbia.edu/tag/07CA)
-/

@[expose] public section

open MvPolynomial

universe u v

namespace Presentation

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- An algebra of finite presentation admits a presentation: a polynomial ring in finitely many
variables modulo a finite family of relations. -/
theorem nonempty_of_finitePresentation [Algebra.FinitePresentation R A] :
    Nonempty (Presentation R A) := by
  classical
  obtain ⟨n, φ, hsurj, hfg⟩ := ‹Algebra.FinitePresentation R A›.out
  obtain ⟨s, hs⟩ := hfg
  have hrange : Set.range (fun i => (s.equivFin.symm i : MvPolynomial (Fin n) R)) =
      (↑s : Set (MvPolynomial (Fin n) R)) := by
    ext x
    refine ⟨fun ⟨i, hi⟩ => hi ▸ (s.equivFin.symm i).2, fun hx => ⟨s.equivFin ⟨x, hx⟩, ?_⟩⟩
    simp
  have hker : RingHom.ker φ.toRingHom =
      Ideal.span (Set.range fun i => (s.equivFin.symm i : MvPolynomial (Fin n) R)) := by
    rw [hrange]
    exact hs.symm
  exact ⟨⟨n, s.card, fun i => (s.equivFin.symm i : MvPolynomial (Fin n) R),
    (Ideal.quotientKerAlgEquivOfSurjective hsurj).symm.trans
      (Ideal.quotientEquivAlgOfEq R hker)⟩⟩

/-- `lift` is multiplicative. -/
theorem lift_mul (P : Presentation R A) (p q : MvPolynomial (Fin P.n) R) :
    P.lift (p * q) = P.lift p * P.lift q := by
  simp only [Presentation.lift, map_mul]

/-- `lift` is additive. -/
theorem lift_sub (P : Presentation R A) (p q : MvPolynomial (Fin P.n) R) :
    P.lift (p - q) = P.lift p - P.lift q := by
  simp only [Presentation.lift, map_sub]

/-- A polynomial represents `0` exactly when it is a relation. -/
theorem lift_eq_zero_iff (P : Presentation R A) (p : MvPolynomial (Fin P.n) R) :
    P.lift p = 0 ↔ p ∈ P.relIdeal :=
  (map_eq_zero_iff _ P.iso.symm.injective).trans Ideal.Quotient.eq_zero_iff_mem

/-- Permuting the variables and the relations does not change the relation ideal, up to the
induced automorphism of the polynomial ring. -/
theorem span_range_renameEquiv_comp (P : Presentation R A) (e : Fin P.n ≃ Fin P.n)
    (σ : Fin P.m ≃ Fin P.m) :
    Ideal.span (Set.range fun j => MvPolynomial.renameEquiv R e (P.f (σ j))) =
      Ideal.map (MvPolynomial.renameEquiv R e).toRingHom (Ideal.span (Set.range P.f)) := by
  rw [Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨P.f (σ j), ⟨σ j, rfl⟩, rfl⟩
  · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
    exact ⟨σ.symm i, by simp⟩

/-- The presentation obtained from `P` by permuting the variables by `e` and the relations
by `σ`. -/
noncomputable def relabel (P : Presentation R A) (e : Fin P.n ≃ Fin P.n)
    (σ : Fin P.m ≃ Fin P.m) : Presentation R A :=
  ⟨P.n, P.m, fun j => MvPolynomial.renameEquiv R e (P.f (σ j)),
    P.iso.trans (Ideal.quotientEquivAlg (Ideal.span (Set.range P.f))
      (Ideal.span (Set.range fun j => MvPolynomial.renameEquiv R e (P.f (σ j))))
      (MvPolynomial.renameEquiv R e) (P.span_range_renameEquiv_comp e σ))⟩

/-- Relabelling a presentation does not change its number of variables. -/
@[simp]
theorem relabel_n (P : Presentation R A) (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m) :
    (P.relabel e σ).n = P.n := rfl

/-- Relabelling a presentation does not change its number of relations. -/
@[simp]
theorem relabel_m (P : Presentation R A) (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m) :
    (P.relabel e σ).m = P.m := rfl

/-- The `j`-th relation of the relabelled presentation is the `σ j`-th relation of `P` with its
variables renamed by `e`. -/
theorem relabel_f (P : Presentation R A) (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m)
    (j : Fin P.m) : (P.relabel e σ).f j = MvPolynomial.rename e (P.f (σ j)) := rfl

/-- The relabelled presentation represents the same elements of `A`, after renaming the
variables. -/
theorem relabel_lift (P : Presentation R A) (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m)
    (p : MvPolynomial (Fin P.n) R) :
    (P.relabel e σ).lift (MvPolynomial.rename e p) = P.lift p := by
  let J : Ideal (MvPolynomial (Fin P.n) R) := Ideal.span (Set.range P.f)
  let J' : Ideal (MvPolynomial (Fin P.n) R) :=
    Ideal.span (Set.range fun j => MvPolynomial.renameEquiv R e (P.f (σ j)))
  have hJ : J' = Ideal.map (MvPolynomial.renameEquiv R e).toRingHom J :=
    P.span_range_renameEquiv_comp e σ
  let qiso : (MvPolynomial (Fin P.n) R ⧸ J) ≃ₐ[R] (MvPolynomial (Fin P.n) R ⧸ J') :=
    Ideal.quotientEquivAlg J J' (MvPolynomial.renameEquiv R e) hJ
  change P.iso.symm (qiso.symm (Ideal.Quotient.mkₐ R J' (MvPolynomial.rename e p))) =
    P.iso.symm (Ideal.Quotient.mkₐ R J p)
  refine congrArg P.iso.symm (qiso.injective ?_)
  rw [qiso.apply_symm_apply]
  rfl

/-- The relation ideal of the relabelled presentation is the image of the relation ideal of `P`
under the renaming of the variables by `e`. -/
theorem relabel_relIdeal (P : Presentation R A) (e : Fin P.n ≃ Fin P.n)
    (σ : Fin P.m ≃ Fin P.m) :
    (P.relabel e σ).relIdeal =
      Ideal.map (MvPolynomial.renameEquiv R e).toRingHom P.relIdeal :=
  P.span_range_renameEquiv_comp e σ

/-- The first `c` relations of the relabelled presentation are the chosen relations of `P`,
renamed. -/
private theorem relabel_f_castLE (P : Presentation R A) (c : ℕ) (hcm : c ≤ P.m)
    (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m)
    (V : Finset (Fin P.m)) (hV : V.card = c)
    (hσ : ∀ j : Fin c, σ (Fin.castLE hcm j) = (V.orderIsoOfFin hV j : Fin P.m)) (j : Fin c) :
    (P.relabel e σ).f (Fin.castLE hcm j) =
      MvPolynomial.rename e (P.f ((V.orderIsoOfFin hV j : Fin P.m))) := by
  rw [← hσ j]
  rfl

/-- If `e` carries the chosen `c` variables onto the first `c` and `σ` carries the first `c`
relations onto the chosen ones, the principal minor of the relabelled presentation is the chosen
minor of `P`, renamed. -/
theorem relabel_jacobianMinorPrincipal (P : Presentation R A) (c : ℕ) (hcn : c ≤ P.n)
    (hcm : c ≤ P.m) (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m)
    (U : Finset (Fin P.n)) (hU : U.card = c) (V : Finset (Fin P.m)) (hV : V.card = c)
    (he : ∀ i : Fin c, e (U.orderIsoOfFin hU i : Fin P.n) = Fin.castLE hcn i)
    (hσ : ∀ j : Fin c, σ (Fin.castLE hcm j) = (V.orderIsoOfFin hV j : Fin P.m)) :
    (P.relabel e σ).jacobianMinorPrincipal c hcn hcm =
      MvPolynomial.rename e (P.jacobianMinorOn c U V hU hV) := by
  have hmat : ∀ j i : Fin c,
      pderiv (Fin.castLE hcn i) ((P.relabel e σ).f (Fin.castLE hcm j)) =
        (MvPolynomial.rename (R := R) e).toRingHom.mapMatrix
          (fun (j i : Fin c) => pderiv ((U.orderIsoOfFin hU i : Fin P.n))
            (P.f ((V.orderIsoOfFin hV j : Fin P.m)))) j i := by
    intro j i
    rw [P.relabel_f_castLE c hcm e σ V hV hσ j, ← he i]
    exact MvPolynomial.pderiv_rename e.injective _ _
  have hstep : (P.relabel e σ).jacobianMinorPrincipal c hcn hcm =
      Matrix.det ((MvPolynomial.rename (R := R) e).toRingHom.mapMatrix
        (fun (j i : Fin c) => pderiv ((U.orderIsoOfFin hU i : Fin P.n))
          (P.f ((V.orderIsoOfFin hV j : Fin P.m))))) :=
    congrArg Matrix.det (funext fun j => funext fun i => hmat j i)
  rw [hstep]
  exact (RingHom.map_det _ _).symm

/-- Under the same relabelling, the ideal of the first `c` relations of the relabelled
presentation is the ideal of the chosen relations of `P`, renamed. -/
theorem relabel_firstRelIdeal (P : Presentation R A) (c : ℕ) (hcm : c ≤ P.m)
    (e : Fin P.n ≃ Fin P.n) (σ : Fin P.m ≃ Fin P.m)
    (V : Finset (Fin P.m)) (hV : V.card = c)
    (hσ : ∀ j : Fin c, σ (Fin.castLE hcm j) = (V.orderIsoOfFin hV j : Fin P.m)) :
    (P.relabel e σ).firstRelIdeal c hcm =
      Ideal.map (MvPolynomial.renameEquiv R e).toRingHom (P.selectedRelIdeal V) := by
  have hset : Set.range (fun j : Fin c => (P.relabel e σ).f (Fin.castLE hcm j)) =
      (MvPolynomial.renameEquiv R e).toRingHom '' Set.range (fun j : ↑V => P.f j.1) := by
    ext x
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨P.f ((V.orderIsoOfFin hV j : Fin P.m)), ⟨V.orderIsoOfFin hV j, rfl⟩,
        (P.relabel_f_castLE c hcm e σ V hV hσ j).symm⟩
    · rintro ⟨y, ⟨k, rfl⟩, rfl⟩
      refine ⟨(V.orderIsoOfFin hV).symm k, ?_⟩
      have hk := P.relabel_f_castLE c hcm e σ V hV hσ
        ((V.orderIsoOfFin hV).symm k)
      rw [OrderIso.apply_symm_apply] at hk
      exact hk
  have hstep : (P.relabel e σ).firstRelIdeal c hcm =
      Ideal.span ((MvPolynomial.renameEquiv R e).toRingHom ''
        Set.range (fun j : ↑V => P.f j.1)) := by
    rw [← hset]
    rfl
  rw [hstep]
  exact (Ideal.map_span _ _).symm

end Presentation

namespace Stacks.Smoothing

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- Any `c`-element subset of `Fin N` is carried onto the first `c` elements by a permutation. -/
private theorem exists_equiv_coe_orderIsoOfFin_eq_castLE {N c : ℕ} (hcN : c ≤ N)
    (U : Finset (Fin N)) (hU : U.card = c) :
    ∃ e : Fin N ≃ Fin N, ∀ i : Fin c,
      e (U.orderIsoOfFin hU i : Fin N) = Fin.castLE hcN i := by
  classical
  have hccomp : (Uᶜ : Finset (Fin N)).card = N - c := by simp [Finset.card_compl, hU]
  let ec : Fin (N - c) ≃ (Uᶜ : Finset (Fin N)) := (Uᶜ).orderIsoOfFin hccomp
  let ecomp : {x : Fin N // x ∉ U} ≃ (Uᶜ : Finset (Fin N)) :=
    Equiv.subtypeEquiv (Equiv.refl _) (by intro x; simp)
  have hn : c + (N - c) = N := by omega
  let eFirstToU : Fin N ≃ Fin N :=
    (finSumFinEquiv.trans (Fin.castOrderIso hn).toEquiv).symm.trans
      ((Equiv.sumCongr (U.orderIsoOfFin hU).toEquiv (ec.trans ecomp.symm)).trans
        (Equiv.sumCompl (· ∈ U)))
  refine ⟨eFirstToU.symm, fun i => ?_⟩
  have hleft : Fin.castOrderIso hn (Fin.castAdd (N - c) i) = Fin.castLE hcN i := by
    apply Fin.ext
    simp [Fin.castOrderIso, Fin.castLE, Fin.castAdd]
  have hr : eFirstToU (Fin.castLE hcN i) = (U.orderIsoOfFin hU i : Fin N) := by
    have hpre : (finSumFinEquiv.trans (Fin.castOrderIso hn).toEquiv).symm
        (Fin.castLE hcN i) = Sum.inl i := by
      apply (finSumFinEquiv.trans (Fin.castOrderIso hn).toEquiv).injective
      simp [finSumFinEquiv_apply_left, hleft]
    change ((Equiv.sumCongr (U.orderIsoOfFin hU).toEquiv
        (ec.trans ecomp.symm)).trans (Equiv.sumCompl (· ∈ U)))
      ((finSumFinEquiv.trans (Fin.castOrderIso hn).toEquiv).symm
        (Fin.castLE hcN i)) = (U.orderIsoOfFin hU i : Fin N)
    rw [hpre]
    simp
  rw [← hr, Equiv.symm_apply_apply]

/-- **At a prime of smoothness there is an elementary standard element avoiding the prime.**
This is Stacks 07C6 read through the definition of an elementary standard element: the Jacobian
minor it produces is taken on an arbitrary set of `c` variables and an arbitrary set of `c`
relations, and relabelling the presentation so that these come first turns its two conditions
into elementary standardness. -/
theorem exists_notMem_isElementaryStandard_of_smoothAt [Algebra.FinitePresentation R A]
    (q : Ideal A) [q.IsPrime] (hq : Algebra.SmoothAt R A q) :
    ∃ a : A, a ∉ q ∧ IsElementaryStandard (R := R) a := by
  classical
  obtain ⟨P⟩ := Presentation.nonempty_of_finitePresentation (R := R) (A := A)
  obtain ⟨a, haq, c, U, V, hcn, hcm, hU, hV, a', haeq, hcond⟩ :=
    exists_notMem_eq_mul_jacobianMinorOn_of_smoothAt P q hq
  obtain ⟨e, he⟩ := exists_equiv_coe_orderIsoOfFin_eq_castLE hcn U hU
  obtain ⟨τ, hτ⟩ := exists_equiv_coe_orderIsoOfFin_eq_castLE hcm V hV
  have hσ : ∀ j : Fin c, τ.symm (Fin.castLE hcm j) = (V.orderIsoOfFin hV j : Fin P.m) :=
    fun j => by rw [Equiv.symm_apply_eq, hτ j]
  have hminor := P.relabel_jacobianMinorPrincipal c hcn hcm e τ.symm U hU V hV he hσ
  have hfirst := P.relabel_firstRelIdeal c hcm e τ.symm V hV hσ
  have hideal : (P.relabel e τ.symm).firstRelIdeal c hcm +
      (P.relabel e τ.symm).relIdeal ^ 2 =
      Ideal.map (MvPolynomial.renameEquiv R e).toRingHom (P.selectedRelIdeal V) ⊔
        (Ideal.map (MvPolynomial.renameEquiv R e).toRingHom P.relIdeal) ^ 2 := by
    rw [hfirst, P.relabel_relIdeal e τ.symm]
    exact Ideal.add_eq_sup
  refine ⟨a, haq, P.relabel e τ.symm, c, hcn, hcm, ⟨⟨a', ?_⟩, ?_⟩⟩
  · rw [hminor, P.relabel_lift e τ.symm (P.jacobianMinorOn c U V hU hV)]
    exact haeq
  · intro j p hp
    have hjm : (j : ℕ) < P.m - c := j.2
    have hlt : c + (j : ℕ) < P.m := by omega
    obtain ⟨p₀, rfl⟩ := (MvPolynomial.renameEquiv R e).surjective p
    have hlift : P.IsLift a p₀ := (P.relabel_lift e τ.symm p₀).symm.trans hp
    have hbase := hcond (τ.symm ⟨c + (j : ℕ), hlt⟩) p₀ hlift
    have hmap : (MvPolynomial.renameEquiv R e) (p₀ * P.f (τ.symm ⟨c + (j : ℕ), hlt⟩)) ∈
        Ideal.map (MvPolynomial.renameEquiv R e).toRingHom (P.selectedRelIdeal V) ⊔
          (Ideal.map (MvPolynomial.renameEquiv R e).toRingHom P.relIdeal) ^ 2 := by
      have hm := Ideal.mem_map_of_mem (MvPolynomial.renameEquiv R e).toRingHom hbase
      rwa [Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_pow] at hm
    rw [← hideal, map_mul] at hmap
    exact hmap

/-- An elementary standard element lies in every prime at which `R → A` is not smooth, and
conversely, if every elementary standard element lies in `q` then `R → A` is not smooth at `q`. -/
private theorem elementaryStandard_notMem_iff [Algebra.FinitePresentation R A]
    (q : Ideal A) [q.IsPrime] :
    (∀ a, IsElementaryStandard (R := R) a → a ∈ q) ↔ ¬ Algebra.SmoothAt R A q := by
  constructor
  · intro h hsm
    obtain ⟨a, haq, hae⟩ := exists_notMem_isElementaryStandard_of_smoothAt q hsm
    exact haq (h a hae)
  · intro h a ha
    by_contra haq
    have hstd := isStandardSmooth_localizationAway_of_isElementaryStandard
      (⟨R, A, a⟩ : SixStandardnessConditions) ha
    have : Algebra.IsStandardSmooth R (Localization.Away a) := hstd
    have hsm : Algebra.Smooth R (Localization.Away a) := by infer_instance
    exact h ((Algebra.smoothAt_iff R A q).mpr ⟨a, haq, hsm⟩)

/-- A strictly standard element lies in every prime at which `R → A` is not smooth, and
conversely. -/
private theorem strictlyStandard_notMem_iff [Algebra.FinitePresentation R A]
    (q : Ideal A) [q.IsPrime] :
    (∀ a, IsStrictlyStandard (R := R) a → a ∈ q) ↔ ¬ Algebra.SmoothAt R A q := by
  constructor
  · intro hall hsm
    refine (elementaryStandard_notMem_iff q).1 (fun a ha => ?_) hsm
    exact hall a
      (elementaryStandard_implies_strictlyStandard (⟨R, A, a⟩ : SixStandardnessConditions) ha)
  · intro hns a ha
    by_contra haq
    obtain ⟨P, c, hcn, hcm, ⟨⟨aI, haeq⟩, hcond⟩⟩ := ha
    have hex : ∃ s, ∃ hs : s ∈ Finset.powersetCard c (Finset.univ : Finset (Fin P.n)),
        P.lift (P.jacobianMinor c hcm s (Finset.mem_powersetCard.mp hs).2) ∉ q := by
      by_contra hno
      refine haq ?_
      rw [haeq]
      refine Ideal.sum_mem _ fun s hs => ?_
      have hsCard := (Finset.mem_powersetCard.mp hs).2
      have hminor : P.lift (P.jacobianMinor c hcm s hsCard) ∈ q := by
        by_contra hmin
        exact hno ⟨s, hs, hmin⟩
      simp only [dite_eq_left hsCard]
      exact q.mul_mem_left (aI s) hminor
    obtain ⟨s, hs, hminor⟩ := hex
    have hsCard : s.card = c := (Finset.mem_powersetCard.mp hs).2
    have hprod : a * P.lift (P.jacobianMinor c hcm s hsCard) ∉ q := fun hprod =>
      ((‹q.IsPrime›.mul_mem_iff_mem_or_mem).mp hprod).elim haq hminor
    exact hprod ((elementaryStandard_notMem_iff q).2 hns _
      (isElementaryStandard_mul_lift_jacobianMinor P a c hcn hcm hcond s hsCard))

/-- An elementary standard element outside a prime `q` witnesses smoothness of `R → A` at `q`. -/
theorem smoothAt_of_isElementaryStandard_of_notMem [Algebra.FinitePresentation R A]
    {a : A} (ha : IsElementaryStandard (R := R) a) (q : Ideal A) [q.IsPrime] (haq : a ∉ q) :
    Algebra.SmoothAt R A q := by
  by_contra hns
  exact haq ((elementaryStandard_notMem_iff q).2 hns a ha)

/-- A strictly standard element outside a prime `q` witnesses smoothness of `R → A` at `q`. -/
theorem smoothAt_of_isStrictlyStandard_of_notMem [Algebra.FinitePresentation R A]
    {a : A} (ha : IsStrictlyStandard (R := R) a) (q : Ideal A) [q.IsPrime] (haq : a ∉ q) :
    Algebra.SmoothAt R A q := by
  by_contra hns
  exact haq ((strictlyStandard_notMem_iff q).2 hns a ha)

/-- A family of elements that jointly avoid exactly the primes of smoothness generates, up to
radical, the singular ideal. -/
private theorem singularIdeal_eq_radical_span_of_notMem_iff (s : A → Prop)
    (hs : ∀ (q : Ideal A) [q.IsPrime], (∀ a, s a → a ∈ q) ↔ ¬ Algebra.SmoothAt R A q) :
    singularIdeal R A = (Ideal.span {a : A | s a}).radical := by
  refine ((eq_singularIdeal_iff_of_isRadical R A (Ideal.radical_isRadical _)).2 ?_).symm
  ext q
  change (Ideal.span {a : A | s a}).radical ≤ q.asIdeal ↔ ¬ Algebra.SmoothAt R A q.asIdeal
  have hq : q.asIdeal.IsPrime := q.isPrime
  rw [Ideal.IsPrime.radical_le_iff hq, Ideal.span_le]
  exact hs q.asIdeal

/-- **Stacks 07CA.** The singular ideal is the radical of the ideal generated by the elementary
standard elements of `A` over `R`. -/
@[stacks 07CA "elementary standard elements"]
theorem singularIdeal_eq_radical_span_isElementaryStandard (R : Type u) [CommRing R] (A : Type v)
    [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] :
    singularIdeal R A = (Ideal.span {a : A | IsElementaryStandard (R := R) a}).radical :=
  singularIdeal_eq_radical_span_of_notMem_iff _ fun q => elementaryStandard_notMem_iff q

/-- **Stacks 07CA.** The singular ideal is the radical of the ideal generated by the strictly
standard elements of `A` over `R`. -/
@[stacks 07CA "strictly standard elements"]
theorem singularIdeal_eq_radical_span_isStrictlyStandard (R : Type u) [CommRing R] (A : Type v)
    [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] :
    singularIdeal R A = (Ideal.span {a : A | IsStrictlyStandard (R := R) a}).radical :=
  singularIdeal_eq_radical_span_of_notMem_iff _ fun q => strictlyStandard_notMem_iff q

end Stacks.Smoothing

