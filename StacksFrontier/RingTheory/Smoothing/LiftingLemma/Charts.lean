/-!
# Lifting lemma: the charts of the lift

The chart ideals of the lift constructed in
`Stacks.Smoothing.exists_finitePresentation_lift_smoothAt` (Stacks Project, Tag 07CP),
and smoothness of the lift and of its reduction at a prime where a chart multiplier
and the chart Jacobian minor stay invertible.
-/

@[expose] public section

namespace Stacks.Smoothing

open Stacks.Smooth.NaiveCotangentCriterion

open scoped Pointwise

universe u v w

section Charts

variable {R : Type u} [CommRing R] {n m r : ℕ}

/-- The ideal of relations retained on the `i`-th chart: the selected relations together
with the chart relations at the indices outside the selection. -/
private noncomputable def chartIdeal (V : Fin r → Finset (Fin m))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R) (i : Fin r) :
    Ideal (MvPolynomial (Fin n ⊕ Fin m) R) :=
  Ideal.span (Set.range (Sum.elim (fun j : V i => rel j.1)
    (fun l : {l : Fin m // l ∉ V i} => crel (i, l.1))))

/-- A selected relation lies in the ideal of the chart that selected it. -/
private lemma rel_mem_chartIdeal (V : Fin r → Finset (Fin m))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R) (i : Fin r) (j : V i) :
    rel j.1 ∈ chartIdeal V rel crel i :=
  Ideal.subset_span ⟨Sum.inl j, rfl⟩

/-- A chart relation at an index outside the selection lies in the chart ideal. -/
private lemma crel_mem_chartIdeal (V : Fin r → Finset (Fin m))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R) (i : Fin r) {l : Fin m}
    (hl : l ∉ V i) : crel (i, l) ∈ chartIdeal V rel crel i :=
  Ideal.subset_span ⟨Sum.inr ⟨l, hl⟩, rfl⟩

/-- The chart ideal is contained in the ideal generated by all the relations. -/
private lemma chartIdeal_le (V : Fin r → Finset (Fin m))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel)) (i : Fin r) :
    chartIdeal V rel crel i ≤ J := by
  rw [hJ]
  simp only [chartIdeal]
  apply Ideal.span_le.mpr
  rintro _ ⟨j, rfl⟩
  cases j with
  | inl j => exact Ideal.subset_span (Or.inl ⟨j.1, rfl⟩)
  | inr l => exact Ideal.subset_span (Or.inr ⟨(i, l.1), rfl⟩)

/-- The chart ideal is finitely generated. -/
private lemma chartIdeal_fg (V : Fin r → Finset (Fin m))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R) (i : Fin r) :
    (chartIdeal V rel crel i).FG :=
  Submodule.fg_span (Set.finite_range _)

/-- The quotient map from the `i`-th chart onto the quotient by all the relations. -/
private noncomputable def chartQuot (V : Fin r → Finset (Fin m))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel)) (i : Fin r) :
    (MvPolynomial (Fin n ⊕ Fin m) R ⧸ chartIdeal V rel crel i) →ₐ[R]
      (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) :=
  Ideal.Quotient.factorₐ R (chartIdeal_le V rel crel hJ i)

/-- At a prime of a chart containing `π` where the chart multiplier stays invertible, every
lifted relation already vanishes in the local ring of that prime. -/
private lemma chart_relations_vanish (π : R)
    (G : Fin m → MvPolynomial (Fin n) R) (V : Fin r → Finset (Fin m))
    (aP : Fin r → MvPolynomial (Fin n) R)
    (Hc : (i : Fin r) → Fin m → V i → MvPolynomial (Fin n) R)
    (Qc : Fin r → Fin m → Fin m × Fin m → MvPolynomial (Fin n) R)
    (liftX : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n ⊕ Fin m) R)
    (zz : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel))
    (hRelJ : ∀ j : Fin m,
      (Ideal.Quotient.mk J (liftX (G j)) : MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) =
        algebraMap R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) π *
          Ideal.Quotient.mk J (zz j))
    (hPi : ∀ ij : Fin r × Fin m, ij.2 ∉ V ij.1 →
      MvPolynomial.C π * crel ij = -liftX (aP ij.1) * rel ij.2 +
        (∑ j : V ij.1, liftX (Hc ij.1 ij.2 j) * rel j.1) +
        (∑ ab : Fin m × Fin m, liftX (Qc ij.1 ij.2 ab) *
          (rel ab.1 * liftX (G ab.2) + MvPolynomial.C π * zz ab.1 * rel ab.2)))
    (i : Fin r) (q : Ideal (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J)) [q.IsPrime]
    (hπq : algebraMap R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) π ∈ q)
    (haq : (Ideal.Quotient.mk J (liftX (aP i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q) :
    ∀ j : Fin m,
      algebraMap (MvPolynomial (Fin n ⊕ Fin m) R ⧸ chartIdeal V rel crel i)
        (Localization.AtPrime (q.comap (chartQuot V rel crel hJ i).toRingHom))
        (Ideal.Quotient.mk (chartIdeal V rel crel i) (rel j)) = 0 := by
  classical
  let Jc := chartIdeal V rel crel i
  let p := q.comap (chartQuot V rel crel hJ i).toRingHom
  let U := Localization.AtPrime p
  let β : MvPolynomial (Fin n ⊕ Fin m) R →ₐ[R] U :=
    (IsScalarTower.toAlgHom R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ Jc) U).comp
      (Ideal.Quotient.mkₐ R Jc)
  have hβ (s : MvPolynomial (Fin n ⊕ Fin m) R) : β s =
      algebraMap (MvPolynomial (Fin n ⊕ Fin m) R ⧸ Jc) U
        (Ideal.Quotient.mk Jc s) := rfl
  have hmax (s : MvPolynomial (Fin n ⊕ Fin m) R)
      (hs : (Ideal.Quotient.mk J s : MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∈ q) :
      β s ∈ IsLocalRing.maximalIdeal U :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff U p (Ideal.Quotient.mk Jc s)).mpr hs
  have hβ0 (s : MvPolynomial (Fin n ⊕ Fin m) R) (hs : s ∈ Jc) : β s = 0 := by
    rw [hβ, Ideal.Quotient.eq_zero_iff_mem.mpr hs, map_zero]
  have hπU : β (MvPolynomial.C π) ∈ IsLocalRing.maximalIdeal U := hmax _ hπq
  have hπz (j : Fin m) : β (MvPolynomial.C π) * β (zz j) ∈
      IsLocalRing.maximalIdeal U :=
    (IsLocalRing.maximalIdeal U).mul_mem_right _ hπU
  have hGU (j : Fin m) : β (liftX (G j)) ∈ IsLocalRing.maximalIdeal U :=
    hmax _ (by rw [hRelJ j]; exact q.mul_mem_right _ hπq)
  have haU : IsUnit (β (liftX (aP i))) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff U p (Ideal.Quotient.mk Jc (liftX (aP i)))).mpr haq
  have hsel (j : V i) : β (rel j.1) = 0 := hβ0 _ (rel_mem_chartIdeal V rel crel i j)
  have hp (l : Fin m) (hl : l ∉ V i) : β (crel (i, l)) = 0 :=
    hβ0 _ (crel_mem_chartIdeal V rel crel i hl)
  have hid (l : Fin m) (hl : l ∉ V i) :
      β (MvPolynomial.C π) * β (crel (i, l)) =
        -β (liftX (aP i)) * β (rel l) +
          (∑ j : V i, β (liftX (Hc i l j)) * β (rel j.1)) +
          (∑ ab : Fin m × Fin m,
            β (liftX (Qc i l ab)) *
              (β (rel ab.1) * β (liftX (G ab.2)) +
                β (MvPolynomial.C π) * β (zz ab.1) * β (rel ab.2))) := by
    simpa only [map_mul, map_add, map_neg, map_sum] using
      congrArg β (hPi (i, l) hl)
  exact relations_vanish_of_chart_equations (V i)
    (β (MvPolynomial.C π)) (β (liftX (aP i)))
    (fun j => β (rel j)) (fun j => β (liftX (G j)))
    (fun j => β (zz j)) (fun j => β (crel (i, j)))
    (fun l j => β (liftX (Hc i l j)))
    (fun l ab => β (liftX (Qc i l ab)))
    haU hsel hp hGU hπz hid

/-- A ring homomorphism killing `π` and the `G l` satisfies the `hDeriv` relation exactly. -/
private lemma deriv_relation_of_map_eq_zero {A : Type*} [CommRing A] (π : R)
    (G : Fin m → MvPolynomial (Fin n) R) (V : Fin r → Finset (Fin m))
    (aP : Fin r → MvPolynomial (Fin n) R)
    (Hc : (i : Fin r) → Fin m → V i → MvPolynomial (Fin n) R)
    (hDeriv : ∀ (x : Fin r) (l : Fin m) (d : Fin n),
      aP x * MvPolynomial.pderiv d (G l) -
        (∑ j : V x, Hc x l j * MvPolynomial.pderiv d (G j.1)) ∈
        Ideal.span (Set.range G) ⊔ Ideal.span {MvPolynomial.C π})
    (δ : MvPolynomial (Fin n) R →+* A) (hδπ : δ (MvPolynomial.C π) = 0)
    (hδG : ∀ l : Fin m, δ (G l) = 0) (x : Fin r) (l : Fin m) (d : Fin n) :
    δ (aP x) * δ (MvPolynomial.pderiv d (G l)) =
      ∑ t : V x, δ (Hc x l t) * δ (MvPolynomial.pderiv d (G t.1)) := by
  have hker : Ideal.span (Set.range G) ⊔ Ideal.span {MvPolynomial.C π} ≤ RingHom.ker δ :=
    sup_le (Ideal.span_le.mpr (Set.range_subset_iff.mpr hδG))
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hδπ))
  have hh : δ _ = 0 := hker (hDeriv x l d)
  simpa only [map_sub, map_mul, map_sum, sub_eq_zero] using hh

/-- Each chart relation is divisible by `π` in the local ring of a prime of the chart that
contains `π` and keeps the chart multiplier and the chart minor invertible. -/
private lemma chart_relation_mem_pi (π : R)
    (G : Fin m → MvPolynomial (Fin n) R) (V : Fin r → Finset (Fin m))
    (aP : Fin r → MvPolynomial (Fin n) R)
    (Hc : (i : Fin r) → Fin m → V i → MvPolynomial (Fin n) R)
    (Qc : Fin r → Fin m → Fin m × Fin m → MvPolynomial (Fin n) R)
    (Ec : Fin r → Fin m → MvPolynomial (Fin n) R)
    (liftX : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n ⊕ Fin m) R)
    (zz : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hrel : ∀ j, rel j = liftX (G j) - MvPolynomial.C π * zz j)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hcrel0 : ∀ ij : Fin r × Fin m, ij.2 ∈ V ij.1 → crel ij = 0)
    (hcrel : ∀ ij : Fin r × Fin m, ij.2 ∉ V ij.1 →
      crel ij = liftX (aP ij.1) * zz ij.2 -
        (∑ j : V ij.1, liftX (Hc ij.1 ij.2 j) * zz j.1) -
        MvPolynomial.C π * (liftX (Ec ij.1 ij.2) +
          ∑ ab : Fin m × Fin m,
            liftX (Qc ij.1 ij.2 ab) * (zz ab.1 * zz ab.2)))
    (selCols : (i : Fin r) → V i ↪ Fin n)
    (jacL : Fin r → MvPolynomial (Fin n) R)
    (hjac : ∀ i : Fin r, (Matrix.det fun d e : V i =>
      MvPolynomial.pderiv (selCols i e) (G d.1)) = jacL i)
    (hDeriv : ∀ (x : Fin r) (l : Fin m) (d : Fin n),
      aP x * MvPolynomial.pderiv d (G l) -
        (∑ j : V x, Hc x l j * MvPolynomial.pderiv d (G j.1)) ∈
        Ideal.span (Set.range G) ⊔ Ideal.span {MvPolynomial.C π})
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel))
    (i : Fin r) (q : Ideal (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J)) [q.IsPrime]
    (hvanish : ∀ j : Fin m,
      algebraMap (MvPolynomial (Fin n ⊕ Fin m) R ⧸ chartIdeal V rel crel i)
        (Localization.AtPrime (q.comap (chartQuot V rel crel hJ i).toRingHom))
        (Ideal.Quotient.mk (chartIdeal V rel crel i) (rel j)) = 0)
    (haq : (Ideal.Quotient.mk J (liftX (aP i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q)
    (hjq : (Ideal.Quotient.mk J (liftX (jacL i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q)
    (ij : Fin r × Fin m) :
    algebraMap (MvPolynomial (Fin n ⊕ Fin m) R ⧸ chartIdeal V rel crel i)
      (Localization.AtPrime (q.comap (chartQuot V rel crel hJ i).toRingHom))
      (Ideal.Quotient.mk (chartIdeal V rel crel i) (crel ij)) ∈
    Ideal.span {algebraMap R
      (Localization.AtPrime (q.comap (chartQuot V rel crel hJ i).toRingHom)) π} := by
  classical
  let Jc := chartIdeal V rel crel i
  let p := q.comap (chartQuot V rel crel hJ i).toRingHom
  let U := Localization.AtPrime p
  let : CommRing U := inferInstance
  let β : MvPolynomial (Fin n ⊕ Fin m) R →ₐ[R] U :=
    (IsScalarTower.toAlgHom R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ Jc) U).comp
      (Ideal.Quotient.mkₐ R Jc)
  let γ : U →+* U ⧸ Ideal.span {algebraMap R U π} := Ideal.Quotient.mk _
  let δ : MvPolynomial (Fin n) R →+* U ⧸ Ideal.span {algebraMap R U π} :=
    γ.comp (β.toRingHom.comp liftX.toRingHom)
  have hδapply (b : MvPolynomial (Fin n) R) : δ b = γ (β (liftX b)) := rfl
  have hπ : γ (β (MvPolynomial.C π)) = 0 := by
    show γ (algebraMap R U π) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  have hGδ (l : Fin m) : δ (G l) = 0 := by
    have hh := congrArg γ (hvanish l)
    change γ (β (rel l)) = γ 0 at hh
    rw [hrel l] at hh
    simpa only [hδapply, map_sub, map_mul, map_zero, hπ, zero_mul, sub_zero] using hh
  have hδπ : δ (MvPolynomial.C π) = 0 := by
    rw [hδapply, show liftX (MvPolynomial.C π) = MvPolynomial.C π from liftX.commutes π]
    exact hπ
  have hd (x : Fin r) (l : Fin m) (j : V i) :
      δ (aP x) * δ (MvPolynomial.pderiv (selCols i j) (G l)) =
      ∑ t : V x, δ (Hc x l t) *
        δ (MvPolynomial.pderiv (selCols i j) (G t.1)) :=
    deriv_relation_of_map_eq_zero π G V aP Hc hDeriv δ hδπ hGδ x l _
  have hunit (s : MvPolynomial (Fin n ⊕ Fin m) R)
      (hs : (Ideal.Quotient.mk J s : MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q) :
      IsUnit (β s) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff U p (Ideal.Quotient.mk Jc s)).mpr hs
  have haβ : IsUnit (β (liftX (aP i))) := hunit _ haq
  have hjβ : IsUnit (β (liftX (jacL i))) := hunit _ hjq
  have hdet : IsUnit (Matrix.det fun d e : V i =>
      δ (MvPolynomial.pderiv (selCols i e) (G d.1))) := by
    have he := (RingHom.map_det δ (fun d e : V i =>
      MvPolynomial.pderiv (selCols i e) (G d.1))).symm
    rw [hjac] at he
    exact he ▸ hjβ.map γ
  have hz (l : Fin m) (hl : l ∉ V i) :
      δ (aP i) * γ (β (zz l)) =
      ∑ t : V i, δ (Hc i l t) * γ (β (zz t.1)) := by
    have hp : β (crel (i, l)) = 0 := by
      show algebraMap (MvPolynomial (Fin n ⊕ Fin m) R ⧸ Jc) U
        (Ideal.Quotient.mk Jc (crel (i, l))) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr
        (crel_mem_chartIdeal V rel crel i hl), map_zero]
    have hh := congrArg γ hp
    rw [hcrel (i, l) hl] at hh
    simpa only [hδapply, map_sub, map_mul, map_sum,
      hπ, zero_mul, sub_zero, map_zero, sub_eq_zero] using hh
  obtain ⟨v, hv⟩ := exists_coordinates_of_linear_relations (V i)
    (fun l j => δ (MvPolynomial.pderiv (selCols i j) (G l)))
    (fun l => γ (β (zz l))) (δ (aP i))
    (fun l t => δ (Hc i l t)) (haβ.map γ) hdet (hd i) hz
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  show γ (β (crel ij)) = 0
  by_cases hij : ij.2 ∈ V ij.1
  · rw [hcrel0 ij hij, map_zero, map_zero]
  have hh := relation_of_coordinates
    (fun l j => δ (MvPolynomial.pderiv (selCols i j) (G l)))
    (fun l => γ (β (zz l))) v hv (δ (aP ij.1))
    (fun t => δ (Hc ij.1 ij.2 t)) Subtype.val ij.2 (hd ij.1 ij.2)
  rw [hcrel ij hij]
  simpa only [hδapply, map_sub, map_mul, map_sum,
    hπ, zero_mul, sub_zero, sub_eq_zero] using hh

/-- The `i`-th chart is standard smooth at a prime containing `π` where the chart multiplier
and the chart minor are invertible, hence smooth at the contracted prime. -/
private lemma chart_isSmoothAt (π : R)
    (G : Fin m → MvPolynomial (Fin n) R) (V : Fin r → Finset (Fin m))
    (aP : Fin r → MvPolynomial (Fin n) R)
    (Hc : (i : Fin r) → Fin m → V i → MvPolynomial (Fin n) R)
    (Qc : Fin r → Fin m → Fin m × Fin m → MvPolynomial (Fin n) R)
    (Ec : Fin r → Fin m → MvPolynomial (Fin n) R)
    (liftX : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n ⊕ Fin m) R)
    (hliftX : ∀ b, liftX b = MvPolynomial.rename Sum.inl b)
    (zz : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hzz : ∀ j, zz j = MvPolynomial.X (Sum.inr j))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hrel : ∀ j, rel j = liftX (G j) - MvPolynomial.C π * zz j)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hcrel : ∀ ij : Fin r × Fin m, ij.2 ∉ V ij.1 →
      crel ij = liftX (aP ij.1) * zz ij.2 -
        (∑ j : V ij.1, liftX (Hc ij.1 ij.2 j) * zz j.1) -
        MvPolynomial.C π * (liftX (Ec ij.1 ij.2) +
          ∑ ab : Fin m × Fin m,
            liftX (Qc ij.1 ij.2 ab) * (zz ab.1 * zz ab.2)))
    (selCols : (i : Fin r) → V i ↪ Fin n)
    (jacL : Fin r → MvPolynomial (Fin n) R)
    (hjac : ∀ i : Fin r, (Matrix.det fun d e : V i =>
      MvPolynomial.pderiv (selCols i e) (G d.1)) = jacL i)
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel))
    (i : Fin r) (q : Ideal (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J)) [q.IsPrime]
    (hπq : algebraMap R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) π ∈ q)
    (haq : (Ideal.Quotient.mk J (liftX (aP i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q)
    (hjq : (Ideal.Quotient.mk J (liftX (jacL i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q) :
    Algebra.IsSmoothAt R (q.comap (chartQuot V rel crel hJ i).toRingHom) := by
  classical
  let Jc := chartIdeal V rel crel i
  have hspan : Ideal.span (Set.range (Sum.elim (fun j : V i => rel j.1)
      (fun l : {l : Fin m // l ∉ V i} => crel (i, l.1)))) = Jc := rfl
  let Pchart : Algebra.Presentation R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ Jc)
      (Fin n ⊕ Fin m) (V i ⊕ {l : Fin m // l ∉ V i}) :=
    (Algebra.Presentation.naive (v := Sum.elim (fun j : V i => rel j.1)
      (fun l : {l : Fin m // l ∉ V i} => crel (i, l.1)))).ofAlgEquiv
        (Ideal.quotientEquivAlgOfEq R hspan)
  have hPchartVal (j : Fin n ⊕ Fin m) :
      Pchart.val j = Ideal.Quotient.mk Jc (MvPolynomial.X j) := by
    show (Ideal.quotientEquivAlgOfEq R hspan)
      ((Algebra.Presentation.naive (v := Sum.elim (fun j : V i => rel j.1)
        (fun l : {l : Fin m // l ∉ V i} => crel (i, l.1)))).val j) = _
    exact Ideal.quotientEquivAlgOfEq_mk R hspan (MvPolynomial.X j)
  have hPchartEval : MvPolynomial.aeval Pchart.val = Ideal.Quotient.mkₐ R Jc := by
    apply MvPolynomial.algHom_ext
    intro j
    rw [MvPolynomial.aeval_X]
    exact hPchartVal j
  let rest : {l : Fin m // l ∉ V i} ↪ Fin m := ⟨Subtype.val, Subtype.val_injective⟩
  apply isSmoothAt_of_presentation_jacobian_notMem Pchart _
    (Function.Embedding.sumMap (selCols i) rest)
  apply chart_jacobian_notMem Pchart (selCols i) (fun j => j.1) rest
    (fun d l h => l.2 (by change d.1 = l.1 at h; exact h ▸ d.2)) π (fun j => G j.1) (aP i)
    (fun l j => Hc i l.1 j)
    (fun l => MvPolynomial.rename Sum.inl (Ec i l.1) + ∑ ab : Fin m × Fin m,
      MvPolynomial.rename Sum.inl (Qc i l.1 ab) *
        (MvPolynomial.X (Sum.inr ab.1) * MvPolynomial.X (Sum.inr ab.2)))
  · intro j
    show rel j.1 = _
    simp only [hrel, hliftX, hzz]
  · intro l
    show crel (i, l.1) = _
    rw [hcrel (i, l.1) l.2]
    simp only [hliftX, hzz, rest, Function.Embedding.coeFn_mk]
  · exact hπq
  · rw [hPchartEval, ← hliftX]
    exact haq
  · rw [hPchartEval, hjac, ← hliftX]
    exact hjq

/-- A prime containing `π` at which some chart keeps its multiplier and its minor invertible
is a smooth point of the lift. -/
lemma isSmoothAt_of_chart (π : R)
    (hR : ∀ x : R, x * π = 0 ↔ x * π ^ 2 = 0)
    (G : Fin m → MvPolynomial (Fin n) R) (V : Fin r → Finset (Fin m))
    (aP : Fin r → MvPolynomial (Fin n) R)
    (Hc : (i : Fin r) → Fin m → V i → MvPolynomial (Fin n) R)
    (Qc : Fin r → Fin m → Fin m × Fin m → MvPolynomial (Fin n) R)
    (Ec : Fin r → Fin m → MvPolynomial (Fin n) R)
    (liftX : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n ⊕ Fin m) R)
    (hliftX : ∀ b, liftX b = MvPolynomial.rename Sum.inl b)
    (zz : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hzz : ∀ j, zz j = MvPolynomial.X (Sum.inr j))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hrel : ∀ j, rel j = liftX (G j) - MvPolynomial.C π * zz j)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hcrel0 : ∀ ij : Fin r × Fin m, ij.2 ∈ V ij.1 → crel ij = 0)
    (hcrel : ∀ ij : Fin r × Fin m, ij.2 ∉ V ij.1 →
      crel ij = liftX (aP ij.1) * zz ij.2 -
        (∑ j : V ij.1, liftX (Hc ij.1 ij.2 j) * zz j.1) -
        MvPolynomial.C π * (liftX (Ec ij.1 ij.2) +
          ∑ ab : Fin m × Fin m,
            liftX (Qc ij.1 ij.2 ab) * (zz ab.1 * zz ab.2)))
    (hPi : ∀ ij : Fin r × Fin m, ij.2 ∉ V ij.1 →
      MvPolynomial.C π * crel ij = -liftX (aP ij.1) * rel ij.2 +
        (∑ j : V ij.1, liftX (Hc ij.1 ij.2 j) * rel j.1) +
        (∑ ab : Fin m × Fin m, liftX (Qc ij.1 ij.2 ab) *
          (rel ab.1 * liftX (G ab.2) + MvPolynomial.C π * zz ab.1 * rel ab.2)))
    (hPiMem : ∀ ij : Fin r × Fin m,
      MvPolynomial.C π * crel ij ∈ Ideal.span (Set.range rel))
    (selCols : (i : Fin r) → V i ↪ Fin n)
    (jacL : Fin r → MvPolynomial (Fin n) R)
    (hjac : ∀ i : Fin r, (Matrix.det fun d e : V i =>
      MvPolynomial.pderiv (selCols i e) (G d.1)) = jacL i)
    (hDeriv : ∀ (x : Fin r) (l : Fin m) (d : Fin n),
      aP x * MvPolynomial.pderiv d (G l) -
        (∑ j : V x, Hc x l j * MvPolynomial.pderiv d (G j.1)) ∈
        Ideal.span (Set.range G) ⊔ Ideal.span {MvPolynomial.C π})
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel))
    (hRelJ : ∀ j : Fin m,
      (Ideal.Quotient.mk J (liftX (G j)) : MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) =
        algebraMap R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) π *
          Ideal.Quotient.mk J (zz j))
    (i : Fin r) (q : Ideal (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J)) [q.IsPrime]
    (hπq : algebraMap R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) π ∈ q)
    (haq : (Ideal.Quotient.mk J (liftX (aP i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q)
    (hjq : (Ideal.Quotient.mk J (liftX (jacL i)) :
      MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ∉ q) :
    Algebra.IsSmoothAt R q := by
  classical
  let Jc := chartIdeal V rel crel i
  let p := q.comap (chartQuot V rel crel hJ i).toRingHom
  let U := Localization.AtPrime p
  let : Algebra.FinitePresentation R
      (MvPolynomial (Fin n ⊕ Fin m) R ⧸ chartIdeal V rel crel i) :=
    Algebra.FinitePresentation.quotient (chartIdeal_fg V rel crel i)
  have hvanish := chart_relations_vanish π G V aP Hc Qc liftX zz rel crel hJ hRelJ hPi
    i q hπq haq
  let : Algebra.IsSmoothAt R p := chart_isSmoothAt π G V aP Hc Qc Ec liftX hliftX zz hzz
    rel hrel crel hcrel selCols jacL hjac hJ i q hπq haq hjq
  let : Algebra.FormallySmooth R U := inferInstance
  let : Module.Flat R U := flat_atPrime_of_isSmoothAt p
  let β : MvPolynomial (Fin n ⊕ Fin m) R →ₐ[R] U :=
    (IsScalarTower.toAlgHom R (MvPolynomial (Fin n ⊕ Fin m) R ⧸ Jc) U).comp
      (Ideal.Quotient.mkₐ R Jc)
  have hgen : Set.range rel ∪ Set.range crel ⊆
      (RingHom.ker β.toRingHom : Set (MvPolynomial (Fin n ⊕ Fin m) R)) := by
    rintro _ (⟨j, rfl⟩ | ⟨ij, rfl⟩)
    · exact hvanish j
    · show β (crel ij) = 0
      apply eq_zero_of_mul_pi_eq_zero_of_mem_pi (S := U) π hR (β (crel ij))
      · exact chart_relation_mem_pi π G V aP Hc Qc Ec liftX zz rel hrel crel hcrel0
          hcrel selCols jacL hjac hDeriv hJ i q hvanish haq hjq ij
      · have hrelker : Ideal.span (Set.range rel) ≤ RingHom.ker β.toRingHom := by
          apply Ideal.span_le.mpr
          rintro _ ⟨j, rfl⟩
          exact (RingHom.mem_ker).mpr (hvanish j)
        have hzero := (RingHom.mem_ker).mp (hrelker (hPiMem ij))
        change β (MvPolynomial.C π * crel ij) = 0 at hzero
        rw [map_mul] at hzero
        change algebraMap R U π * β (crel ij) = 0 at hzero
        exact (mul_comm _ _).trans hzero
  have hJβ : J ≤ RingHom.ker β.toRingHom :=
    le_of_eq hJ |>.trans (Ideal.span_le.mpr hgen)
  apply isSmoothAt_of_surjective_of_localized_kernel
    (chartQuot V rel crel hJ i) (fun d => by
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mkₐ_surjective R J d
      exact ⟨Ideal.Quotient.mk Jc s, rfl⟩) q inferInstance
  intro x hx
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hs : s ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp hx
  exact hJβ hs

/-- A prime of the reduction of the lift which contracts to a smooth point of `C` is a
smooth point of the reduction, via a retraction of the chart onto a polynomial algebra. -/
lemma isSmoothAt_reduction_of_chart (π : R)
    (G : Fin m → MvPolynomial (Fin n) R) (V : Fin r → Finset (Fin m))
    (aP : Fin r → MvPolynomial (Fin n) R)
    (Hc : (i : Fin r) → Fin m → V i → MvPolynomial (Fin n) R)
    (Qc : Fin r → Fin m → Fin m × Fin m → MvPolynomial (Fin n) R)
    (Ec : Fin r → Fin m → MvPolynomial (Fin n) R)
    (liftX : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n ⊕ Fin m) R)
    (hliftX : ∀ b, liftX b = MvPolynomial.rename Sum.inl b)
    (zz : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hzz : ∀ j, zz j = MvPolynomial.X (Sum.inr j))
    (rel : Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hrel : ∀ j, rel j = liftX (G j) - MvPolynomial.C π * zz j)
    (crel : Fin r × Fin m → MvPolynomial (Fin n ⊕ Fin m) R)
    (hcrel0 : ∀ ij : Fin r × Fin m, ij.2 ∈ V ij.1 → crel ij = 0)
    (hcrel : ∀ ij : Fin r × Fin m, ij.2 ∉ V ij.1 →
      crel ij = liftX (aP ij.1) * zz ij.2 -
        (∑ j : V ij.1, liftX (Hc ij.1 ij.2 j) * zz j.1) -
        MvPolynomial.C π * (liftX (Ec ij.1 ij.2) +
          ∑ ab : Fin m × Fin m,
            liftX (Qc ij.1 ij.2 ab) * (zz ab.1 * zz ab.2)))
    (selCols : (i : Fin r) → V i ↪ Fin n)
    (jacL : Fin r → MvPolynomial (Fin n) R)
    (hjac : ∀ i : Fin r, (Matrix.det fun d e : V i =>
      MvPolynomial.pderiv (selCols i e) (G d.1)) = jacL i)
    (hDeriv : ∀ (x : Fin r) (l : Fin m) (d : Fin n),
      aP x * MvPolynomial.pderiv d (G l) -
        (∑ j : V x, Hc x l j * MvPolynomial.pderiv d (G j.1)) ∈
        Ideal.span (Set.range G) ⊔ Ideal.span {MvPolynomial.C π})
    {J : Ideal (MvPolynomial (Fin n ⊕ Fin m) R)}
    (hJ : J = Ideal.span (Set.range rel ∪ Set.range crel))
    {D : Type*} [CommRing D] [Algebra R D]
    (e : (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) ≃ₐ[R] D)
    {A : Type*} [CommRing A]
    [Algebra A (D ⧸ Ideal.span {algebraMap R D π})]
    (δ : MvPolynomial (Fin n) R →+* A)
    (hδsurj : Function.Surjective δ)
    (hδ : ∀ b : MvPolynomial (Fin n) R,
      algebraMap A (D ⧸ Ideal.span {algebraMap R D π}) (δ b) =
        Ideal.Quotient.mk (Ideal.span {algebraMap R D π})
          (e (Ideal.Quotient.mk J (liftX b))))
    (hδπ : δ (MvPolynomial.C π) = 0)
    (hδG : ∀ l : Fin m, δ (G l) = 0)
    (q : Ideal (D ⧸ Ideal.span {algebraMap R D π})) [q.IsPrime]
    (i : Fin r)
    (haρ : Ideal.Quotient.mk (Ideal.span {algebraMap R D π})
      (e (Ideal.Quotient.mk J (liftX (aP i)))) ∉ q)
    (hjρ : Ideal.Quotient.mk (Ideal.span {algebraMap R D π})
      (e (Ideal.Quotient.mk J (liftX (jacL i)))) ∉ q) :
    Algebra.IsSmoothAt A q := by
  classical
  let Bred := D ⧸ Ideal.span {algebraMap R D π}
  let T := Localization.AtPrime q
  let κ : Bred →ₐ[A] T := IsScalarTower.toAlgHom A Bred T
  let ρ : MvPolynomial (Fin n ⊕ Fin m) R →+* Bred :=
    (Ideal.Quotient.mk _).comp (e.toRingHom.comp (Ideal.Quotient.mk J))
  let dd (l : Fin m) (j : V i) : A := δ (MvPolynomial.pderiv (selCols i j) (G l))
  have hd (x : Fin r) (l : Fin m) (j : V i) :
      δ (aP x) * dd l j = ∑ t : V x, δ (Hc x l t) * dd t.1 j :=
    deriv_relation_of_map_eq_zero π G V aP Hc hDeriv δ hδπ hδG x l _
  let Pfree := MvPolynomial (V i) A
  let y (l : Fin m) : Pfree :=
    ∑ j : V i, MvPolynomial.C (dd l j) * MvPolynomial.X j
  let hS : MvPolynomial (Fin n ⊕ Fin m) R →+* Pfree := MvPolynomial.eval₂Hom
    (MvPolynomial.C.comp (δ.comp MvPolynomial.C))
    (Sum.elim (fun l => MvPolynomial.C (δ (MvPolynomial.X l))) y)
  have hSC (b : R) : hS (MvPolynomial.C b) =
      MvPolynomial.C (δ (MvPolynomial.C b)) := MvPolynomial.eval₂Hom_C _ _ _
  have hSXi (l : Fin n) : hS (MvPolynomial.X (Sum.inl l)) =
      MvPolynomial.C (δ (MvPolynomial.X l)) := MvPolynomial.eval₂Hom_X' _ _ _
  have hSX (b : MvPolynomial (Fin n) R) : hS (liftX b) = MvPolynomial.C (δ b) := by
    have hh : hS.comp liftX.toRingHom = MvPolynomial.C.comp δ := by
      apply MvPolynomial.ringHom_ext
      · intro b
        show hS (liftX (MvPolynomial.C b)) = MvPolynomial.C (δ (MvPolynomial.C b))
        rw [show liftX (MvPolynomial.C b) = MvPolynomial.C b from liftX.commutes b]
        exact hSC b
      · intro l
        show hS (liftX (MvPolynomial.X l)) = MvPolynomial.C (δ (MvPolynomial.X l))
        rw [hliftX, MvPolynomial.rename_X]
        exact hSXi l
    exact RingHom.congr_fun hh b
  have hSz (l : Fin m) : hS (zz l) = y l := by
    rw [hzz]
    exact MvPolynomial.eval₂Hom_X' _ _ _
  have hSπ : hS (MvPolynomial.C π) = 0 := by
    rw [hSC, hδπ, map_zero]
  have hy (x : Fin r) (l : Fin m) :
      MvPolynomial.C (δ (aP x)) * y l =
        ∑ t : V x, MvPolynomial.C (δ (Hc x l t)) * y t.1 := by
    apply relation_of_coordinates (fun l j => (MvPolynomial.C (dd l j) : Pfree))
      y (fun j => MvPolynomial.X j) (fun l => rfl)
    intro j
    simpa only [map_mul, map_sum] using congrArg
      (MvPolynomial.C : A →+* Pfree) (hd x l j)
  have hSJ : J ≤ RingHom.ker hS := by
    rw [hJ]
    apply Ideal.span_le.mpr
    rintro _ (⟨l, rfl⟩ | ⟨ij, rfl⟩)
    · show hS (rel l) = 0
      rw [hrel l]
      simp only [map_sub, map_mul, hSX, hSπ, hδG, map_zero, zero_mul, sub_self]
    · show hS (crel ij) = 0
      by_cases hij : ij.2 ∈ V ij.1
      · rw [hcrel0 ij hij, map_zero]
      · rw [hcrel ij hij]
        simp only [map_sub, map_mul, map_sum, map_add,
          hSX, hSz, hSπ, zero_mul, sub_zero, sub_eq_zero, hy]
  let h₀ : (MvPolynomial (Fin n ⊕ Fin m) R ⧸ J) →+* Pfree :=
    Ideal.Quotient.lift J hS hSJ
  let hDm : D →+* Pfree := h₀.comp e.symm.toRingHom
  let hB : Bred →+* Pfree := Ideal.Quotient.lift _ hDm (by
    intro b hb
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton.mp hb
    rw [map_mul]
    have hπD : hDm (algebraMap R D π) = 0 := by
      show h₀ (e.symm (algebraMap R D π)) = 0
      rw [e.symm.commutes π]
      show hS (MvPolynomial.C π) = 0
      exact hSπ
    rw [hπD, zero_mul])
  have hBρ (s : MvPolynomial (Fin n ⊕ Fin m) R) : hB (ρ s) = hS s := by
    show h₀ (e.symm (e (Ideal.Quotient.mk J s))) = hS s
    rw [e.symm_apply_apply]
    rfl
  let hAlg : Bred →ₐ[A] Pfree :=
    { hB with
      commutes' := by
        intro a
        obtain ⟨b, rfl⟩ := hδsurj a
        rw [hδ b]
        exact (hBρ (liftX b)).trans (hSX b) }
  let β : MvPolynomial (Fin n ⊕ Fin m) R →+* T := κ.toRingHom.comp ρ
  have hβδ (b : MvPolynomial (Fin n) R) :
      algebraMap A T (δ b) = β (liftX b) := by
    rw [IsScalarTower.algebraMap_apply A Bred T, hδ]
    rfl
  have haβ : IsUnit (algebraMap A T (δ (aP i))) := by
    rw [hβδ]
    exact IsLocalization.map_units T (⟨ρ (liftX (aP i)), haρ⟩ : q.primeCompl)
  have hjβ : IsUnit (algebraMap A T (δ (jacL i))) := by
    rw [hβδ]
    exact IsLocalization.map_units T (⟨ρ (liftX (jacL i)), hjρ⟩ : q.primeCompl)
  have hdet : IsUnit (Matrix.det fun d' e' : V i =>
      algebraMap A T (dd d'.1 e')) := by
    have he : (Matrix.det fun d' e' : V i => dd d'.1 e') = δ (jacL i) :=
      (RingHom.map_det δ (fun d' e' : V i =>
        MvPolynomial.pderiv (selCols i e') (G d'.1))).symm.trans
        (congrArg δ (hjac i))
    have he' := RingHom.map_det (algebraMap A T)
      (fun d' e' : V i => dd d'.1 e')
    rw [he] at he'
    exact he' ▸ hjβ
  have hdT (l : Fin m) (j : V i) :
      algebraMap A T (δ (aP i)) * algebraMap A T (dd l j) =
      ∑ t : V i, algebraMap A T (δ (Hc i l t)) * algebraMap A T (dd t.1 j) := by
    simpa only [map_mul, map_sum] using congrArg (algebraMap A T) (hd i l j)
  have hβπ : β (MvPolynomial.C π) = 0 := by
    have hh := hβδ (MvPolynomial.C π)
    rw [show liftX (MvPolynomial.C π) = MvPolynomial.C π from liftX.commutes π,
      hδπ, map_zero] at hh
    exact hh.symm
  have hzT (l : Fin m) (hl : l ∉ V i) :
      algebraMap A T (δ (aP i)) * β (zz l) =
      ∑ t : V i, algebraMap A T (δ (Hc i l t)) * β (zz t.1) := by
    have hh : β (crel (i, l)) = 0 := by
      have hmem : crel (i, l) ∈ J := by
        rw [hJ]
        exact Ideal.subset_span (Or.inr ⟨(i, l), rfl⟩)
      have hρ0 : ρ (crel (i, l)) = 0 := by
        show Ideal.Quotient.mk _ (e (Ideal.Quotient.mk J (crel (i, l)))) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero, map_zero]
      show κ (ρ (crel (i, l))) = 0
      rw [hρ0, map_zero]
    rw [hcrel (i, l) hl] at hh
    simpa only [map_sub, map_mul, map_sum, map_add, ← hβδ, hβπ,
      zero_mul, sub_zero, sub_eq_zero] using hh
  obtain ⟨v, hv⟩ := exists_coordinates_of_linear_relations (V i)
    (fun l j => algebraMap A T (dd l j)) (fun l => β (zz l))
    (algebraMap A T (δ (aP i)))
    (fun l t => algebraMap A T (δ (Hc i l t))) haβ hdet hdT hzT
  let ffree : Pfree →ₐ[A] T := MvPolynomial.aeval v
  have hfS : ffree.toRingHom.comp hS = β := by
    apply MvPolynomial.ringHom_ext
    · intro b
      show ffree (hS (MvPolynomial.C b)) = β (MvPolynomial.C b)
      rw [hSC, MvPolynomial.aeval_C]
      have hh := hβδ (MvPolynomial.C b)
      rw [show liftX (MvPolynomial.C b) = MvPolynomial.C b from liftX.commutes b] at hh
      exact hh
    · intro j
      cases j with
      | inl l =>
        show ffree (hS (MvPolynomial.X (Sum.inl l))) = β (MvPolynomial.X (Sum.inl l))
        rw [hSXi, MvPolynomial.aeval_C]
        have hh := hβδ (MvPolynomial.X l)
        rw [hliftX, MvPolynomial.rename_X] at hh
        exact hh
      | inr l =>
        show ffree (hS (MvPolynomial.X (Sum.inr l))) =
          β (MvPolynomial.X (Sum.inr l))
        rw [← hzz l, hSz]
        calc
          ffree (y l) = ∑ j : V i, algebraMap A T (dd l j) * v j := by
            rw [show y l = ∑ j : V i,
              MvPolynomial.C (dd l j) * MvPolynomial.X j from rfl, map_sum]
            apply Finset.sum_congr rfl
            intro j _
            rw [map_mul]
            exact congrArg₂ (· * ·) (ffree.commutes (dd l j))
              (MvPolynomial.aeval_X v j)
          _ = β (zz l) := (hv l).symm
  apply isSmoothAt_of_factorization_through_formallySmooth q hAlg ffree
  ext b
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨b, rfl⟩ := e.surjective b
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  show ffree (hB (ρ b)) = κ (ρ b)
  rw [hBρ b]
  exact RingHom.congr_fun hfS b

end Charts

