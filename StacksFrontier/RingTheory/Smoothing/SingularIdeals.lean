/-!
# Strictly standard elements and the Jacobian matrix of a presentation

Let `R → A` be a ring map of finite presentation, presented as
`A = R[x_1, …, x_n]/(f_1, …, f_m)`, and let `a ∈ A`. The element `a` is *strictly standard* when
there is a presentation and an integer `c` with `a = ∑_I a_I det(∂f_j/∂x_i)_{j ≤ c, i ∈ I}`, the
sum running over the `c`-element subsets `I` of the variables, together with the containment
condition `a · f_{c+j} ∈ (f_1, …, f_c) + I²`.

This file relates that equation to the Jacobian map `A^n → A^c` of the first `c` relations: a
strictly standard equation for `a` is the same thing as a left inverse to the Jacobian map after
multiplying by `a`, and conversely a left inverse to the Jacobian map exhibits `a^c` as a
combination of the maximal minors, which is the equation of Stacks 07ER.

## Main definitions

* `Stacks.Smoothing.jacobianMatrix`: the `n × c` matrix over `A` of the differentials of the
  first `c` relations of a presentation.

## Main results

* `Stacks.Smoothing.exists_comp_eq_lsmul_of_eq_sum_jacobianMinor`: a strictly standard equation
  supplies a left inverse to the Jacobian map.
* `Stacks.Smoothing.exists_pow_eq_sum_jacobianMinor_of_comp_eq_lsmul`: a left inverse to the
  Jacobian map writes `a ^ c` as a combination of the `c × c` Jacobian minors.

## Implementation notes

The coordinate module of differentials of the presentation is modelled by the finite function
module `Fin n → A`, the direct sum of the `A · dx_i`; its coordinate map is `jacobianMatrix`.
The ideal generated by the maximal minors of a matrix and the two transfer lemmas between
membership in it and the existence of a left inverse are
`StacksFrontier.LinearAlgebra.Matrix.MaximalMinors`.

The predicate `IsStrictlyStandard` of Stacks 07C7 is not redefined here: it is the one built
from the presentation data in `StacksFrontier.RingTheory.Smoothing.BaseChangeOfPresentation`, where
it carries the Stacks tag 07C7.

## References

* [Stacks Project, Tag 07C7](https://stacks.math.columbia.edu/tag/07C7)
* [Stacks Project, Tag 07ET](https://stacks.math.columbia.edu/tag/07ET)
-/

@[expose] public section

open MvPolynomial

namespace Stacks.Smoothing

universe u v

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- The Jacobian matrix of the first `c` relations of a presentation: the `(i, j)` entry is the
element of `A` represented by `∂f_j/∂x_i`. -/
noncomputable def jacobianMatrix (P : Presentation R A) (c : ℕ) (hcm : c ≤ P.m) :
    Matrix (Fin P.n) (Fin c) A :=
  fun i j => P.lift (pderiv i (P.f (Fin.castLE hcm j)))

private theorem det_jacobianMatrix_submatrix (P : Presentation R A) (c : ℕ)
    (hcm : c ≤ P.m) (s : Finset (Fin P.n)) (hs : s.card = c) :
    Matrix.det ((jacobianMatrix P c hcm).submatrix
      (fun i => (s.orderIsoOfFin hs i).1) id) = P.lift (P.jacobianMinor c hcm s hs) := by
  let g : MvPolynomial (Fin P.n) R →+* A :=
    P.iso.symm.toRingHom.comp (Ideal.Quotient.mkₐ R (Ideal.span (Set.range P.f))).toRingHom
  let N : Matrix (Fin c) (Fin c) (MvPolynomial (Fin P.n) R) :=
    fun j i => pderiv ((s.orderIsoOfFin hs i).1) (P.f (Fin.castLE hcm j))
  change Matrix.det (Matrix.transpose (N.map g)) = g (Matrix.det N)
  rw [Matrix.det_transpose]
  exact (RingHom.map_det g N).symm

/-- The `c × c` minor of the Jacobian matrix on the rows `s`, listed in increasing order. -/
private theorem det_submatrix_orderEmbOfFin_jacobianMatrix (P : Presentation R A) (c : ℕ)
    (hcm : c ≤ P.m) (s : Finset (Fin P.n)) (hsc : s.card = c) :
    ((jacobianMatrix P c hcm).submatrix (s.orderEmbOfFin hsc) id).det =
      P.lift (if h : s.card = c then P.jacobianMinor c hcm s h else 0) := by
  rw [dite_eq_left hsc]
  simpa only [Finset.coe_orderIsoOfFin_apply] using det_jacobianMatrix_submatrix P c hcm s hsc

/-- A strictly standard equation supplies a left inverse to its Jacobian map. Only the equation
16.2.3.3 is used; the relation-ideal condition 16.2.3.4 is not needed. -/
@[stacks 07ET "the forward half: the equation of 07ER implies that there is an `A`-linear \
`ψ : ⊕_{i = 1,…,n} A dx_i → A^{⊕c}` whose composition with \
`A^{⊕c} →^{(f_1,…,f_c)} I/I² →^{f ↦ df} ⊕_{i = 1,…,n} A dx_i` is multiplication by `a`. The \
two-step composite is the Jacobian map `jacobianMatrix`, whose `j`-th column is `d f_j`. Only \
07ER is hypothesised, as in the source; the condition of 07ES is not assumed"]
theorem exists_comp_eq_lsmul_of_eq_sum_jacobianMinor
    (P : Presentation R A) (a : A) (c : ℕ) (hcm : c ≤ P.m)
    (ha : ∃ aI : Finset (Fin P.n) → A,
      a = ∑ s ∈ Finset.powersetCard c (Finset.univ : Finset (Fin P.n)),
        aI s * P.lift (if h : s.card = c then P.jacobianMinor c hcm s h else 0)) :
    ∃ ψ : (Fin P.n → A) →ₗ[A] (Fin c → A),
      ψ.comp (Matrix.toLin' (jacobianMatrix P c hcm)) =
        LinearMap.lsmul A (Fin c → A) a := by
  rcases ha with ⟨aI, haI⟩
  have hmem : a ∈ maximalMinorsIdeal (jacobianMatrix P c hcm) := by
    rw [haI]
    apply Submodule.sum_mem
    intro s hs
    have hsc := (Finset.mem_powersetCard.mp hs).2
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span
      ⟨s.orderEmbOfFin hsc, det_submatrix_orderEmbOfFin_jacobianMatrix P c hcm s hsc⟩)
  obtain ⟨B, hB⟩ := exists_matrix_of_mem_minorIdeal _ _ hmem
  refine ⟨Matrix.toLin' B, ?_⟩
  rw [← Matrix.toLin'_mul, hB]
  ext x i
  simp

private theorem exists_jacobianMinor_sum_of_mem_maximalMinorsIdeal
    (P : Presentation R A) (a : A) (c : ℕ) (hcm : c ≤ P.m)
    (hmem : a ^ c ∈ maximalMinorsIdeal (jacobianMatrix P c hcm)) :
    ∃ aI : Finset (Fin P.n) → A,
      a ^ c = ∑ s ∈ Finset.powersetCard c (Finset.univ : Finset (Fin P.n)),
        aI s * P.lift (if h : s.card = c then P.jacobianMinor c hcm s h else 0) := by
  classical
  let minor : Finset (Fin P.n) → A := fun s =>
    P.lift (if h : s.card = c then P.jacobianMinor c hcm s h else 0)
  have hle : maximalMinorsIdeal (jacobianMatrix P c hcm) ≤
      Ideal.span (Set.range minor) := by
    rw [maximalMinorsIdeal, minorsSet]
    apply Ideal.span_le.2
    rintro x ⟨r, rfl⟩
    apply Ideal.subset_span
    let s : Finset (Fin P.n) := Finset.univ.image r
    have hsc : s.card = c := by simp [s, Finset.card_image_of_injective _ r.injective]
    refine ⟨s, ?_⟩
    have hrs : r = s.orderEmbOfFin hsc :=
      Finset.orderEmbOfFin_unique' hsc (by intro i; simp [s])
    rw [hrs]
    exact (det_submatrix_orderEmbOfFin_jacobianMatrix P c hcm s hsc).symm
  obtain ⟨aI, haI⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hle hmem)
  refine ⟨aI, ?_⟩
  rw [← haI]
  symm
  apply Finset.sum_subset
  · simp
  · intro s _ hs
    have hsc : s.card ≠ c := by simpa using hs
    simp [hsc, Presentation.lift]

/-- A left inverse to the Jacobian expresses the corresponding power as a sum of Jacobian minors
(the equation of Stacks 07ER). This also holds for `c = 0`, when the empty minor is `1`; the
relation-ideal condition of Stacks 07ES is a separate requirement. -/
@[stacks 07ET "the converse half: if such a `ψ` exists — that is, if some `A`-linear \
`ψ : ⊕_{i = 1,…,n} A dx_i → A^{⊕c}` composed with \
`A^{⊕c} →^{(f_1,…,f_c)} I/I² →^{f ↦ df} ⊕_{i = 1,…,n} A dx_i` is multiplication by `a` — then \
`a ^ c` satisfies the equation of 07ER. As in the source the conclusion is only that equation, \
not the condition of 07ES"]
theorem exists_pow_eq_sum_jacobianMinor_of_comp_eq_lsmul
    (P : Presentation R A) (a : A) (c : ℕ) (hcm : c ≤ P.m)
    (ψ : (Fin P.n → A) →ₗ[A] (Fin c → A))
    (hψ : ψ.comp (Matrix.toLin' (jacobianMatrix P c hcm)) =
      LinearMap.lsmul A (Fin c → A) a) :
    ∃ aI : Finset (Fin P.n) → A,
      a ^ c = ∑ s ∈ Finset.powersetCard c (Finset.univ : Finset (Fin P.n)),
        aI s * P.lift (if h : s.card = c then P.jacobianMinor c hcm s h else 0) := by
  have hB : LinearMap.toMatrix' ψ * jacobianMatrix P c hcm = a • 1 := by
    rw [← LinearMap.toMatrix'_toLin' (jacobianMatrix P c hcm), ← LinearMap.toMatrix'_comp, hψ]
    ext i j
    by_cases hij : i = j <;> simp [LinearMap.toMatrix'_apply, hij]
  exact exists_jacobianMinor_sum_of_mem_maximalMinorsIdeal P a c hcm
    (pow_mem_minorIdeal_of_matrix _ _ _ hB)

end Stacks.Smoothing

/-!
# The singular ideal of a ring map

For a ring map `R → A` the *singular ideal* `H_{A/R} ⊂ A` is the unique radical ideal whose
vanishing locus is the set of primes of `A` at which `R → A` is not smooth. It exists because that
set is closed: smoothness at a prime is Definition 00TB, "some principal localization away from the
prime is smooth", so the smooth locus is a union of standard opens.

## Main definitions

* `Stacks.Smoothing.singularIdeal`: the singular ideal `H_{A/R}`.

## Main results

* `Stacks.Smoothing.singularIdeal_isRadical`, `Stacks.Smoothing.zeroLocus_singularIdeal` and
  `Stacks.Smoothing.eq_singularIdeal_iff_of_isRadical`: the singular ideal is radical, its
  vanishing locus is the non-smooth locus, and these two properties characterize it.
* `Stacks.Smoothing.singularIdeal_le_iff_not_smoothAt`: the pointwise form of the previous
  statement, that the singular ideal lies under a prime exactly when the map is not smooth there.
* `Stacks.Smoothing.smooth_localization_away_of_mem_singularIdeal`: for `f` in the singular ideal
  of an algebra of finite presentation, `A_f` is smooth over `R`.
* `Stacks.Smoothing.mem_singularIdeal_of_smooth_of_isLocalizationAway`: conversely, if some model
  of `A_f` is smooth over `R` then `f` lies in the singular ideal.

## Implementation notes

The non-smooth locus is formed from `Algebra.SmoothAt`, the Stacks notion of smoothness at a prime
(Definition 00TB), and not from Mathlib's `Algebra.smoothLocus`, whose pointwise predicate is
formal smoothness of the local ring. This is what makes the definition correct without a finite
presentation hypothesis: the two loci differ in general — the first is empty and the second is all
of `Spec` for `k[x_i : i ∈ ℕ]` over `k` — and agree exactly when `A` is of finite presentation over
`R`, which is recorded by `Stacks.Smoothing.singularIdeal_eq_vanishingIdeal_compl_smoothLocus`.
Consumers need none of this: the three characterizing results above determine the ideal.

## References

* [Stacks Project, Tag 07C5](https://stacks.math.columbia.edu/tag/07C5)
-/

namespace Stacks.Smoothing

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]

/-- The *singular ideal* `H_{A/R}` of `A` over `R`: the vanishing ideal of the set of primes of
`A` at which `R → A` is not smooth. -/
@[stacks 07C5 "the singular ideal"]
noncomputable def singularIdeal : Ideal A :=
  PrimeSpectrum.vanishingIdeal {q : PrimeSpectrum A | ¬ Algebra.SmoothAt R A q.asIdeal}

/-- The singular ideal is radical. -/
@[stacks 07C5 "radicality"]
theorem singularIdeal_isRadical : (singularIdeal R A).IsRadical :=
  PrimeSpectrum.isRadical_vanishingIdeal _

/-- The vanishing locus of the singular ideal is exactly the locus of primes at which `R → A` is
not smooth. -/
@[stacks 07C5 "vanishing locus"]
theorem zeroLocus_singularIdeal :
    PrimeSpectrum.zeroLocus (singularIdeal R A : Set A) =
      {q : PrimeSpectrum A | ¬ Algebra.SmoothAt R A q.asIdeal} := by
  rw [singularIdeal, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure]
  exact IsClosed.closure_eq (Algebra.isOpen_setOf_smoothAt R A).isClosed_compl

/-- A radical ideal is the singular ideal exactly when its vanishing locus is the non-smooth
locus; this is the uniqueness in the definition of the singular ideal. -/
@[stacks 07C5 "uniqueness"]
theorem eq_singularIdeal_iff_of_isRadical {I : Ideal A} (hI : I.IsRadical) :
    I = singularIdeal R A ↔
      PrimeSpectrum.zeroLocus (I : Set A) =
        {q : PrimeSpectrum A | ¬ Algebra.SmoothAt R A q.asIdeal} := by
  rw [← zeroLocus_singularIdeal R A, PrimeSpectrum.zeroLocus_eq_iff, hI.radical,
    (singularIdeal_isRadical R A).radical]

/-- The singular ideal lies under a prime `q` exactly when `R → A` is not smooth at `q`; this is
the pointwise form of `Stacks.Smoothing.zeroLocus_singularIdeal`. -/
theorem singularIdeal_le_iff_not_smoothAt (q : Ideal A) [q.IsPrime] :
    singularIdeal R A ≤ q ↔ ¬ Algebra.SmoothAt R A q := by
  have h := Set.ext_iff.mp (zeroLocus_singularIdeal R A) ⟨q, ‹_›⟩
  rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] at h
  exact h

/-- For `f` in the singular ideal, the standard open `D(f)` is contained in the smooth locus. -/
theorem basicOpen_subset_smoothLocus_of_mem_singularIdeal {f : A} (hf : f ∈ singularIdeal R A) :
    (↑(PrimeSpectrum.basicOpen f) : Set (PrimeSpectrum A)) ⊆ Algebra.smoothLocus R A := by
  intro p hp
  have hfp : f ∉ p.asIdeal := (PrimeSpectrum.mem_basicOpen f p).mp hp
  by_contra hns
  exact hfp ((PrimeSpectrum.mem_vanishingIdeal _ _).1 hf p
    fun h => hns (Algebra.isSmoothAt_of_smoothAt R A h))

/-- For `f` in the singular ideal of an algebra of finite presentation, the localization `A_f` is
smooth over `R`. -/
theorem smooth_localization_away_of_mem_singularIdeal [Algebra.FinitePresentation R A]
    {f : A} (hf : f ∈ singularIdeal R A) : Algebra.Smooth R (Localization.Away f) :=
  Algebra.basicOpen_subset_smoothLocus_iff_smooth.1
    (basicOpen_subset_smoothLocus_of_mem_singularIdeal R A hf)

/-- Conversely, if some model `L` of the localization `A_f` is smooth over `R`, then `f` lies in
the singular ideal. No finiteness hypothesis is needed. -/
theorem mem_singularIdeal_of_smooth_of_isLocalizationAway {f : A} (L : Type*) [CommRing L]
    [Algebra A L] [Algebra R L] [IsScalarTower R A L] [IsLocalization.Away f L]
    (hL : Algebra.Smooth R L) : f ∈ singularIdeal R A := by
  let : Algebra.Smooth R L := hL
  have hcanon : Algebra.Smooth R (Localization.Away f) :=
    Algebra.Smooth.of_equiv
      ((IsLocalization.algEquiv (Submonoid.powers f) (Localization.Away f)
        L).symm.restrictScalars R)
  rw [singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
  intro q hq
  by_contra hf
  exact hq ⟨f, hf, hcanon⟩

/-- For an algebra of finite presentation the singular ideal is the vanishing ideal of the
complement of Mathlib's `Algebra.smoothLocus`. -/
theorem singularIdeal_eq_vanishingIdeal_compl_smoothLocus [Algebra.FinitePresentation R A] :
    singularIdeal R A = PrimeSpectrum.vanishingIdeal (Algebra.smoothLocus R A)ᶜ := by
  rw [singularIdeal, ← Algebra.setOf_smoothAt_eq_smoothLocus R A]
  rfl

end Stacks.Smoothing

end
