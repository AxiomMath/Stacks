module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Smooth.SmoothAt
public import StacksFrontier.RingTheory.Smoothing.AlgebraPresentation
public import StacksFrontier.RingTheory.Smoothing.BaseChangeOfPresentation

/-!
# A standard element near a prime of smoothness

Let `A = R[x_1, …, x_n]/(f_1, …, f_m)` and let `q ⊂ A` be a prime at which `R → A` is smooth in
the sense of Definition 00TB. Then some `a ∈ A` outside `q` is a multiple of a `c × c` Jacobian
minor `det(∂f_j/∂x_i)_{j ∈ V, i ∈ U}` and, modulo the square of the full relation ideal, carries
every relation into the ideal generated by the relations indexed by `V`. These are the two
conditions defining an elementary standard element, with the rows `V` and the columns `U`
arbitrary rather than the first `c` of each.

## Main results

* `Stacks.Smoothing.exists_notMem_eq_mul_jacobianMinorOn_of_smoothAt`: the element and the
  Jacobian minor at a prime of smoothness.
* `Stacks.Smoothing.exists_strictly_standard_element`: an alias of the same statement.
* `Stacks.Smoothing.formallySmooth_of_retraction`: formal smoothness passes to a retract.

## References

* [Stacks Project, Tag 07C6](https://stacks.math.columbia.edu/tag/07C6)
-/

@[expose] public section

open MvPolynomial
open scoped TensorProduct

universe u v

namespace Stacks.Smoothing

/-- Spanning families remain spanning after extension of scalars. -/
private lemma span_tmul_family {R S M : Type*} [CommSemiring R] [Semiring S]
    [Algebra R S] [AddCommMonoid M] [Module R M]
    {ι : Type*} (v : ι → M) (hv : Submodule.span R (Set.range v) = ⊤) :
    Submodule.span S (Set.range fun i ↦ (1 : S) ⊗ₜ[R] v i) = ⊤ := by
  calc
    _ = (Submodule.span R (Set.range v)).baseChange S := by
      rw [Submodule.baseChange_span]
      congr 1
      ext x
      simp
    _ = ⊤ := by rw [hv, Submodule.baseChange_top]

/-- The reindexing of `Fin c` by the increasing enumeration of the image of an injective family
indexed by `Fin c`. -/
private noncomputable def imageOrderEquiv {c : ℕ} {α : Type*} [LinearOrder α]
    (f : Fin c → α) (hf : Function.Injective f)
    (hcard : (Finset.univ.image f).card = c) : Fin c ≃ Fin c :=
  (Equiv.ofBijective
    (fun i : Fin c => (⟨f i, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩ :
      ↑(Finset.univ.image f)))
    ⟨fun _ _ h => hf (congrArg Subtype.val h), fun x => by
      obtain ⟨i, _, hi⟩ := Finset.mem_image.mp x.2
      exact ⟨i, Subtype.ext hi⟩⟩).trans
    ((Finset.univ.image f).orderIsoOfFin hcard).symm

private lemma imageOrderEquiv_apply {c : ℕ} {α : Type*} [LinearOrder α]
    (f : Fin c → α) (hf : Function.Injective f)
    (hcard : (Finset.univ.image f).card = c) (i : Fin c) :
    (((Finset.univ.image f).orderIsoOfFin hcard) (imageOrderEquiv f hf hcard i) : α) =
      f i := by
  simp [imageOrderEquiv]
  rfl

/-- **Stacks 07C6.** If a finite polynomial presentation of `A` over `R` is smooth at a prime `q`
(Definition 00TB), then some element `a ∈ A` outside `q` is a multiple of a `c × c` Jacobian minor
`det(∂f_j/∂x_i)_{j ∈ V, i ∈ U}` on sets `U`, `V` of `c` variables and `c` relations, and, modulo
the square of the full relation ideal, every lift of `a` carries every relation into the ideal
generated by the relations indexed by `V`. -/
@[stacks 07C6]
theorem exists_notMem_eq_mul_jacobianMinorOn_of_smoothAt
    {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]
    (P : _root_.Presentation R A) (q : Ideal A) [q.IsPrime]
    (hq : Algebra.SmoothAt R A q) :
    ∃ (a : A), a ∉ q ∧
      ∃ (c : ℕ) (U : Finset (Fin P.n)) (V : Finset (Fin P.m))
        (_hcn : c ≤ P.n) (_hcm : c ≤ P.m) (hU : U.card = c) (hV : V.card = c),
        ∃ a' : A,
          a = a' * P.lift (P.jacobianMinorOn c U V hU hV) ∧
          (∀ (ℓ : Fin P.m) (ã : MvPolynomial (Fin P.n) R), P.IsLift a ã →
            ã * P.f ℓ ∈ P.selectedRelIdeal V + P.relIdeal ^ 2) := by
  let : Algebra.FormallySmooth R (Localization.AtPrime q) :=
    Algebra.isSmoothAt_of_smoothAt R A hq
  let P' := toAlgebraPresentation P
  have hspanA := Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker
    (P := P'.toExtension) P'.relation P'.span_range_relation_eq_ker
  obtain ⟨r, hr⟩ :=
    Stacks.Smooth.JacobianCriterion.exists_leftInverse_baseChange_cotangentComplex
      (T := Localization.AtPrime q) P'.toGenerators q.primeCompl
  let T := Localization.AtPrime q
  let C := T ⊗[A] P'.toExtension.Cotangent
  let D := T ⊗[A] P'.toExtension.CotangentSpace
  let d : C →ₗ[T] D := P'.toExtension.cotangentComplex.baseChange T
  let bD : Module.Basis (Fin P.n) T D := P'.toGenerators.cotangentSpaceBasis.baseChange T
  have hfiniteD : Module.Finite T D := Module.Finite.of_basis bD
  have hleft : Function.LeftInverse r d := DFunLike.congr_fun hr
  let : Module.Projective T C := Module.Projective.of_split d r (by simpa [d] using hr)
  let : Module.Finite T C := Module.Finite.of_surjective r hleft.surjective
  let : Module.FinitePresentation T C := Module.finitePresentation_of_projective T C
  let relClass : Fin P.m → P'.toExtension.Cotangent := fun j =>
    Algebra.Extension.Cotangent.mk (P := P'.toExtension)
      ⟨P'.relation j, P'.relation_mem_ker j⟩
  let relClassT : Fin P.m → C := fun j => (1 : T) ⊗ₜ[A] relClass j
  have hspanT : Submodule.span T (Set.range relClassT) = ⊤ :=
    span_tmul_family relClass hspanA
  obtain ⟨κ, j, b, hb⟩ := Module.exists_basis_of_span_of_flat relClassT hspanT
  have hj : Function.Injective j := by
    intro i i' hi
    apply b.injective
    rw [hb i, hb i', hi]
  have hκfinite : Finite κ := Module.Finite.finite_basis b
  let : Fintype κ := Fintype.ofFinite κ
  let c := Fintype.card κ
  let eκ : κ ≃ Fin c := Fintype.equivFin κ
  let jFin : Fin c → Fin P.m := j ∘ eκ.symm
  have hjFin : Function.Injective jFin := hj.comp eκ.symm.injective
  have hcM : c ≤ P.m := by
    simpa using Fintype.card_le_of_injective jFin hjFin
  let V : Finset (Fin P.m) := Finset.univ.image jFin
  have hcardImage {α : Type} [DecidableEq α] {f : Fin c → α} (hf : Function.Injective f) :
      (Finset.univ.image f).card = c := by
    rw [Finset.card_image_of_injective _ hf]
    simp
  have hV : V.card = c := hcardImage (f := jFin) hjFin
  have hcN : c ≤ P.n := by
    have hdim := LinearMap.finrank_le_finrank_of_injective hleft.injective
    rw [Module.finrank_eq_card_basis b, Module.finrank_eq_card_basis bD] at hdim
    simpa [c] using hdim
  classical
  let precomp : Module.Dual T D →ₗ[T] Module.Dual T C := d.dualMap
  have hprecomp : Function.Surjective precomp := fun φ =>
    ⟨φ.comp r, LinearMap.ext fun x => by simp [precomp, LinearMap.dualMap_apply, hleft x]⟩
  let ψ : Fin P.n → Module.Dual T C := fun k => precomp (bD.dualBasis k)
  have hspanψ : Submodule.span T (Set.range ψ) = ⊤ := by
    rw [show ψ = precomp ∘ bD.dualBasis from rfl, Set.range_comp, ← Submodule.map_span,
      bD.dualBasis.span_eq, Submodule.map_top, LinearMap.range_eq_top.mpr hprecomp]
  have hfiniteDual : Module.Finite T (Module.Dual T C) :=
    Module.Finite.of_basis b.dualBasis
  let : Module.Free T (Module.Dual T C) := Module.Free.of_basis b.dualBasis
  let : Module.Projective T (Module.Dual T C) := Module.Projective.of_free
  let : Module.FinitePresentation T (Module.Dual T C) :=
    Module.finitePresentation_of_projective T (Module.Dual T C)
  obtain ⟨κ', u, bψ, hbψ⟩ := Module.exists_basis_of_span_of_flat ψ hspanψ
  have hκ'finite : Finite κ' := Module.Finite.finite_basis bψ
  let : Fintype κ' := Fintype.ofFinite κ'
  have hcardκ' : Fintype.card κ' = c := by
    calc
      Fintype.card κ' = Module.finrank T (Module.Dual T C) :=
        (Module.finrank_eq_card_basis bψ).symm
      _ = Fintype.card κ := Module.finrank_eq_card_basis b.dualBasis
      _ = c := rfl
  let eψ : κ' ≃ Fin c := Fintype.equivOfCardEq (by simpa using hcardκ')
  let uFin : Fin c → Fin P.n := u ∘ eψ.symm
  let U : Finset (Fin P.n) := Finset.univ.image uFin
  have huFin : Function.Injective uFin := by
    intro i i' h
    apply eψ.symm.injective
    apply bψ.injective
    rw [hbψ (eψ.symm i), hbψ (eψ.symm i')]
    simpa [uFin] using congrArg ψ h
  have hU : U.card = c := hcardImage (f := uFin) huFin
  let bψFin : Module.Basis (Fin c) T (Module.Dual T C) := bψ.reindex eψ
  have hbψFin (i : Fin c) : bψFin i = ψ (uFin i) := by
    simp [bψFin, uFin, hbψ]
  let bFin : Module.Basis (Fin c) T C := b.reindex eκ
  have hbFin (i : Fin c) : bFin i = relClassT (jFin i) := by
    simp [bFin, jFin, hb]
  let : Module.Free T C := Module.Free.of_basis b
  let evalEquiv : C ≃ₗ[T] Module.Dual T (Module.Dual T C) := Module.evalEquiv T C
  let evalCoord : C ≃ₗ[T] (Fin c → T) := evalEquiv.trans bψFin.dualBasis.equivFun
  have hevalCoord (x : C) (i : Fin c) : evalCoord x i = ψ (uFin i) x := by
    simp [evalCoord, evalEquiv, hbψFin]
  let bPi : Module.Basis (Fin c) T (Fin c → T) := Pi.basisFun T (Fin c)
  have hdetEval : IsUnit (LinearMap.toMatrix bFin bPi evalCoord.toLinearMap).det :=
    LinearEquiv.isUnit_det evalCoord bFin bPi
  let relMatrix : Matrix (Fin c) (Fin c) T := fun i k =>
    bD.repr (d (bFin i)) (uFin k)
  have hdetRel : IsUnit relMatrix.det := by
    have hmatrix : LinearMap.toMatrix bFin bPi evalCoord.toLinearMap = relMatrix.transpose := by
      ext k i
      calc
        (LinearMap.toMatrix bFin bPi evalCoord.toLinearMap) k i =
            evalCoord (bFin i) k := by simp [LinearMap.toMatrix_apply, bPi]
        _ = ψ (uFin k) (bFin i) := hevalCoord _ _
        _ = bD.repr (d (bFin i)) (uFin k) := by
          simp [ψ, precomp, LinearMap.dualMap_apply]
        _ = relMatrix.transpose k i := rfl
    rwa [hmatrix, Matrix.det_transpose] at hdetEval
  have hEntry (i k : Fin c) : relMatrix i k = algebraMap A T
      (MvPolynomial.aeval P'.toGenerators.val
        (pderiv (uFin k) (P'.relation (jFin i)))) := by
    change bD.repr (d (bFin i)) (uFin k) = _
    rw [hbFin i]
    dsimp only [relClassT, d]
    rw [LinearMap.baseChange_tmul]
    dsimp only [relClass]
    rw [Algebra.Extension.cotangentComplex_mk]
    dsimp only [bD]
    rw [Module.Basis.baseChange_repr_tmul, Algebra.smul_def, mul_one]
    exact congrArg (algebraMap A T) (P'.cotangentSpaceBasis_repr_one_tmul _ _)
  let eV : Fin c ≃ Fin c := imageOrderEquiv jFin hjFin hV
  have heV (i : Fin c) :
      ((V.orderIsoOfFin hV) (eV i) : Fin P.m) = jFin i :=
    imageOrderEquiv_apply jFin hjFin hV i
  let eU : Fin c ≃ Fin c := imageOrderEquiv uFin huFin hU
  have heU (i : Fin c) :
      ((U.orderIsoOfFin hU) (eU i) : Fin P.n) = uFin i :=
    imageOrderEquiv_apply uFin huFin hU i
  let minorMatrix : Matrix (Fin c) (Fin c) (MvPolynomial (Fin P.n) R) :=
    fun j i => pderiv ((U.orderIsoOfFin hU i : Fin P.n))
      (P.f ((V.orderIsoOfFin hV j : Fin P.m)))
  let φ : MvPolynomial (Fin P.n) R →ₐ[R] A :=
    P.iso.symm.toAlgHom.comp (Ideal.Quotient.mkₐ R P.relIdeal)
  let evalA : MvPolynomial (Fin P.n) R →+* A := algebraMap P'.Ring A
  let evalT : MvPolynomial (Fin P.n) R →+* T := (algebraMap A T).comp evalA
  have hφ : MvPolynomial.aeval P'.toGenerators.val = φ := by
    ext i
    simp [P', toAlgebraPresentation, φ, Algebra.Generators.ofAlgHom,
      Algebra.Generators.ofSurjective]
  have hEvalA (p : MvPolynomial (Fin P.n) R) : evalA p = P.lift p := by
    rw [Algebra.Generators.algebraMap_apply, hφ]
    rfl
  have hMatrix : relMatrix = (minorMatrix.map evalT).submatrix eV eU := by
    ext i k
    rw [hEntry]
    dsimp [minorMatrix]
    rw [← heV, ← heU, ← Algebra.Generators.algebraMap_apply P'.toGenerators]
    rfl
  have hDetMatrix : IsUnit (evalT minorMatrix.det) := by
    rw [hMatrix] at hdetRel
    have hunit : IsUnit (minorMatrix.map evalT) :=
      (Matrix.isUnit_submatrix_equiv eV eU).mp
        ((Matrix.isUnit_iff_isUnit_det _).mpr hdetRel)
    simpa [RingHom.map_det] using (Matrix.isUnit_iff_isUnit_det _).mp hunit
  have hminorUnitA : IsUnit (algebraMap A T (P.lift minorMatrix.det)) := by
    simpa [evalT, hEvalA] using hDetMatrix
  have hminorNotMem : P.lift minorMatrix.det ∉ q :=
    (IsLocalization.AtPrime.isUnit_to_map_iff T q (P.lift minorMatrix.det)).mp hminorUnitA
  have hlocSpan (ℓ : Fin P.m) : relClassT ℓ ∈
      Submodule.span T (Set.range fun i : Fin c => relClassT (jFin i)) := by
    simpa only [← hbFin, bFin.span_eq] using
      (Submodule.mem_top : relClassT ℓ ∈ (⊤ : Submodule T C))
  choose dden hdden using fun ℓ => multiple_mem_span_of_mem_localization_span
    (M := q.primeCompl) (R := A) (R' := T) (N := C)
    (Set.range fun i : Fin c => relClassT (jFin i)) (relClassT ℓ) (hlocSpan ℓ)
  let fLoc : P'.toExtension.Cotangent →ₗ[A] C :=
    TensorProduct.mk A T P'.toExtension.Cotangent 1
  have hLocZero (x : P'.toExtension.Cotangent) (hx : fLoc x = 0) :
      ∃ s : q.primeCompl, (s : A) • x = 0 :=
    (IsLocalizedModule.eq_zero_iff (S := q.primeCompl) fLoc).mp hx
  choose coeff hcoeff using fun ℓ => (Submodule.mem_span_range_iff_exists_fun A).mp (hdden ℓ)
  let z : Fin P.m → P'.toExtension.Cotangent := fun ℓ =>
    (dden ℓ : A) • relClass ℓ - ∑ i, coeff ℓ i • relClass (jFin i)
  have hfrel (ℓ : Fin P.m) : fLoc (relClass ℓ) = relClassT ℓ := rfl
  have hzLoc (ℓ : Fin P.m) : fLoc (z ℓ) = 0 := by
    simp only [z, map_sub, map_sum, LinearMap.map_smul, hfrel, hcoeff, Submonoid.smul_def, sub_self]
  let s : Fin P.m → q.primeCompl := fun ℓ => Classical.choose (hLocZero (z ℓ) (hzLoc ℓ))
  have hs (ℓ : Fin P.m) : (s ℓ : A) • z ℓ = 0 :=
    Classical.choose_spec (hLocZero (z ℓ) (hzLoc ℓ))
  let g : Fin P.m → q.primeCompl := fun ℓ => dden ℓ * s ℓ
  have hglobalEq (ℓ : Fin P.m) : (g ℓ : A) • relClass ℓ =
      ∑ i, ((s ℓ : A) * coeff ℓ i) • relClass (jFin i) := by
    have hz := hs ℓ
    dsimp [z] at hz
    rw [smul_sub, Finset.smul_sum, smul_smul, sub_eq_zero] at hz
    calc
      (g ℓ : A) • relClass ℓ = ((s ℓ : A) * (dden ℓ : A)) • relClass ℓ := by
        rw [mul_comm]; rfl
      _ = _ := by simpa only [smul_smul] using hz
  let gProd : q.primeCompl := ∏ ℓ : Fin P.m, g ℓ
  have hglobalSpan (ℓ : Fin P.m) : (gProd : A) • relClass ℓ ∈
      Submodule.span A (Set.range fun i : Fin c => relClass (jFin i)) := by
    have hfactor : (gProd : A) =
        (∏ k ∈ Finset.univ.erase ℓ, (g k : A)) * (g ℓ : A) := by
      push_cast [gProd]
      rw [Finset.prod_erase_mul _ _ (Finset.mem_univ ℓ)]
    rw [hfactor, mul_smul, hglobalEq, Finset.smul_sum]
    exact Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
  let aFactor : q.primeCompl := ⟨P.lift minorMatrix.det, hminorNotMem⟩ * gProd
  let a : A := aFactor
  have ha : a ∉ q := aFactor.property
  have haFactorEq : a = P.lift minorMatrix.det * (gProd : A) := rfl
  have haEq : a = (gProd : A) * P.lift minorMatrix.det := mul_comm _ _
  have hfinalSpan (ℓ : Fin P.m) : a • relClass ℓ ∈
      Submodule.span A (Set.range fun i : Fin c => relClass (jFin i)) := by
    rw [haFactorEq, mul_smul]
    exact Submodule.smul_mem _ _ (hglobalSpan ℓ)
  refine ⟨a, ha, c, U, V, hcN, hcM, hU, hV, (gProd : A), haEq, ?_⟩
  intro ℓ ã hã
  let σa : P'.Ring := P'.toGenerators.σ a
  have hσa : P.lift σa = a := by
    rw [← hEvalA σa, Algebra.Generators.algebraMap_apply]
    exact P'.toGenerators.aeval_val_σ a
  obtain ⟨k, hk⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp (hfinalSpan ℓ)
  let y : P'.Ring :=
    ∑ i, P'.toGenerators.σ (k i) * P'.relation (jFin i)
  have hyJ : y ∈ P.selectedRelIdeal V := Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _
    (Ideal.subset_span ⟨⟨jFin i, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩, rfl⟩)
  have hkerEq : P'.ker = P.relIdeal := by
    rw [← P'.span_range_relation_eq_ker]
    rfl
  have hyker : y ∈ P'.toExtension.ker :=
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (P'.relation_mem_ker (jFin i))
  have hleftKer : σa * P'.relation ℓ ∈ P'.toExtension.ker :=
    Ideal.mul_mem_left _ _ (P'.relation_mem_ker ℓ)
  let kerRel (i : Fin c) : P'.toExtension.ker :=
    ⟨P'.relation (jFin i), P'.relation_mem_ker (jFin i)⟩
  have hscalar (b : A) (x : P'.toExtension.Cotangent) :
      b • x = (P'.toGenerators.σ b) • x := by
    apply Algebra.Extension.Cotangent.ext
    simp [Algebra.Extension.Cotangent.val_smul''']
  have hleftClass : Algebra.Extension.Cotangent.mk (P := P'.toExtension)
      ⟨σa * P'.relation ℓ, hleftKer⟩ = a • relClass ℓ :=
    (map_smul (Algebra.Extension.Cotangent.mk (P := P'.toExtension)) (P'.toExtension.σ a)
      ⟨P'.relation ℓ, P'.relation_mem_ker ℓ⟩).trans (hscalar a (relClass ℓ)).symm
  have hkerSum : (⟨y, hyker⟩ : P'.toExtension.ker) =
      ∑ i, P'.toExtension.σ (k i) • kerRel i := by
    apply Subtype.ext
    simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul, smul_eq_mul]
    simp [y, kerRel, Algebra.Generators.toExtension]
    rfl
  have hrightClass : Algebra.Extension.Cotangent.mk (P := P'.toExtension) ⟨y, hyker⟩ =
      ∑ i, k i • relClass (jFin i) := by
    rw [hkerSum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul]
    exact (hscalar (k i) (relClass (jFin i))).symm
  have hclassEq : Algebra.Extension.Cotangent.mk (P := P'.toExtension)
      ⟨σa * P'.relation ℓ, hleftKer⟩ =
        Algebra.Extension.Cotangent.mk (P := P'.toExtension) ⟨y, hyker⟩ :=
    hleftClass.trans (hk.symm.trans hrightClass.symm)
  have hsq : σa * P'.relation ℓ - y ∈ P'.toExtension.ker ^ 2 :=
    (Algebra.Extension.Cotangent.mk_eq_mk_iff_sub_mem _ _).mp hclassEq
  have hsq' : σa * P.f ℓ - y ∈ P.relIdeal ^ 2 := by
    change σa * P'.relation ℓ - y ∈ P'.ker ^ 2 at hsq
    rwa [hkerEq] at hsq
  have hcanonical : σa * P.f ℓ ∈ P.selectedRelIdeal V + P.relIdeal ^ 2 := by
    rw [show σa * P.f ℓ = y + (σa * P.f ℓ - y) by ring]
    exact Submodule.add_mem_sup hyJ hsq'
  have hdiff : ã - σa ∈ P.relIdeal := by
    have hLiftDiff : P.lift (ã - σa) = 0 := by
      rw [← hEvalA, map_sub, hEvalA ã, hEvalA σa, hã, hσa, sub_self]
    have hmk : Ideal.Quotient.mkₐ R P.relIdeal (ã - σa) = 0 :=
      P.iso.symm.injective (hLiftDiff.trans (map_zero P.iso.symm).symm)
    exact Ideal.Quotient.eq_zero_iff_mem.mp (by simpa using hmk)
  have hprod : (ã - σa) * P.f ℓ ∈ P.relIdeal ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul hdiff (Ideal.subset_span ⟨ℓ, rfl⟩)
  rw [show ã * P.f ℓ = σa * P.f ℓ + (ã - σa) * P.f ℓ by ring]
  exact Ideal.add_mem _ hcanonical (Ideal.mem_sup_right hprod)

/-- **Stacks 16.2.2 (Tag 07C6)**: an alias of `exists_notMem_eq_mul_jacobianMinorOn_of_smoothAt`.
The two conditions it asserts are those of a strictly standard element, with the rows `V` and the
columns `U` arbitrary rather than the first `c` of each. -/
alias exists_strictly_standard_element :=
  Stacks.Smoothing.exists_notMem_eq_mul_jacobianMinorOn_of_smoothAt

/-- Formal smoothness passes to a retract: if `f : A →ₐ[R] B` has a section `g` and `A` is
formally smooth over `R`, then so is `B`. -/
public theorem formallySmooth_of_retraction {R A B : Type*} [CommRing R] [CommRing A]
    [CommRing B] [Algebra R A] [Algebra R B] [Algebra.FormallySmooth R A] (f : A →ₐ[R] B)
    (g : B →ₐ[R] A) (h : f.comp g = AlgHom.id R B) : Algebra.FormallySmooth R B := by
  apply Algebra.FormallySmooth.of_split f ((Ideal.Quotient.mkₐ R _).comp g)
  ext x
  exact DFunLike.congr_fun h x

end Stacks.Smoothing

end
