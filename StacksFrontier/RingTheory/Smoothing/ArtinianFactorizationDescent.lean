/-!
# Descending a resolution to a chain with local Artinian target

Over a local Artinian target the resolvability of a chain `R → A → Λ` at the maximal ideal is the
same as the existence of a factorization `A → T → Λ` with `T` smooth over `R`. This file records
that equivalence, the transport of such a factorization along a map of the middle term, and the
fact that an algebra which is a localization of one of finite presentation and is formally smooth
over the base is a filtered colimit of smooth algebras.
It also records the transport of a smooth factorization along a base change of the chain, and the
remaining reductions in the proof of Lemma 07FJ.

## Main definitions

* `Stacks.Smoothing.HasSmoothFactorization`: the map `A → Λ` factors through an `R`-algebra
  smooth over `R`.

## Main results

* `Stacks.Smoothing.canBeResolved_of_hasSmoothFactorization` and
  `Stacks.Smoothing.hasSmoothFactorization_of_canBeResolved`: the two directions of the
  equivalence over a local target.
* `Stacks.Smoothing.indSmooth_of_formallySmooth_of_isLocalization`: an essentially smooth
  algebra — a formally smooth localization of an algebra of finite presentation — is a filtered
  colimit of smooth algebras.
* `Stacks.Smoothing.LocalSmoothingSituation.canBeResolved_of_nilpotent_generators` and
  `Stacks.Smoothing.hasSmoothFactorization_of_algHom`: steps 20 and 24 of the proof of 07FJ.
* `Stacks.Smoothing.hasSmoothFactorization_baseChange`: a smooth factorization is carried along
  a base change of the chain.
* `Stacks.Smoothing.span_range_pow_le_span_range_pow_of_le`: the ideal generated by
  `π_1, …, π_d` has its `n`-th power inside `(π_1^e, …, π_d^e)` once `d(e - 1) < n`.
* `Stacks.Smoothing.canBeResolved_of_canBeResolved_baseChange`,
  `Stacks.Smoothing.canBeResolved_quotient_of_canBeResolved`,
  `Stacks.Smoothing.canBeResolved_of_factorization_mvPolynomial` and
  `Stacks.Smoothing.exists_algHom_parameterPowerAlgebra_mvPolynomial`: steps 22, 23, 25 and 26
  of the proof of 07FJ.

## References

* [Stacks Project, Tag 07FJ](https://stacks.math.columbia.edu/tag/07FJ)
-/

@[expose] public section

open scoped TensorProduct

namespace Stacks.Smoothing

universe u v w

/-! ### Chains that factor through a smooth algebra -/

/-- The chain `R → A → Λ` *has a smooth factorization* if the map `A → Λ` factors through an
`R`-algebra smooth over `R`. -/
def HasSmoothFactorization (R : Type u) (A : Type v) (Λ : Type w) [CommRing R] [CommRing A]
    [CommRing Λ] [Algebra R A] [Algebra A Λ] [Algebra R Λ] [IsScalarTower R A Λ] : Prop :=
  ∃ (T : Type (max u v w)) (_ : CommRing T) (_ : Algebra R T),
    Algebra.Smooth R T ∧ ∃ (g : A →ₐ[R] T) (k : T →ₐ[R] Λ),
      k.comp g = IsScalarTower.toAlgHom R A Λ

/-- The singular ideal of a smooth algebra is the unit ideal. -/
theorem singularIdeal_eq_top_of_smooth (R : Type*) (A : Type*) [CommRing R] [CommRing A]
    [Algebra R A] (h : Algebra.Smooth R A) : singularIdeal R A = ⊤ := by
  have : IsLocalization.Away (1 : A) A := IsLocalization.self (fun x hx => by
    obtain ⟨n, rfl⟩ := hx
    simp)
  exact (Ideal.eq_top_iff_one _).mpr
    (mem_singularIdeal_of_smooth_of_isLocalizationAway R A A h)

section Resolution

variable {R : Type u} {A : Type v} {Λ : Type w} [CommRing R] [CommRing A] [CommRing Λ]
  [Algebra R A] [Algebra A Λ] [Algebra R Λ] [IsScalarTower R A Λ]

/-- A chain whose middle term maps to the target through an algebra smooth over the base can be
resolved at any prime. -/
theorem canBeResolved_of_hasSmoothFactorization {q : Ideal Λ} (hq : q ≠ ⊤)
    (h : HasSmoothFactorization R A Λ) : CanBeResolved R A Λ q := by
  obtain ⟨T, _, _, hT, g, k, hgk⟩ := h
  let : Algebra A T := g.toRingHom.toAlgebra
  let : Algebra T Λ := k.toRingHom.toAlgebra
  have : IsScalarTower R A T := IsScalarTower.of_algHom g
  have : IsScalarTower R T Λ := IsScalarTower.of_algHom k
  have : IsScalarTower A T Λ :=
    IsScalarTower.of_algebraMap_eq fun a => (AlgHom.congr_fun hgk a).symm
  have htop : (Ideal.map (algebraMap T Λ) (singularIdeal R T)).radical = ⊤ := by
    rw [singularIdeal_eq_top_of_smooth R T hT]
    exact Ideal.radical_eq_top.mpr (Ideal.map_top _)
  exact ⟨T, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, hT.finitePresentation, htop ▸ le_top,
    fun hle => hq (top_le_iff.mp (htop ▸ hle))⟩

/-- Over a local target, a chain that can be resolved at the maximal ideal has a smooth
factorization: an element of the singular ideal of the resolving algebra avoiding the maximal
ideal becomes invertible, and inverting it produces a smooth algebra. -/
theorem hasSmoothFactorization_of_canBeResolved [IsLocalRing Λ]
    (h : CanBeResolved R A Λ (IsLocalRing.maximalIdeal Λ)) : HasSmoothFactorization R A Λ := by
  obtain ⟨B, _, _, _, _, _, _, _, hfp, -, hnot⟩ := h
  have hprime : (IsLocalRing.maximalIdeal Λ).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal Λ).isPrime
  rw [← hprime.radical, Ideal.radical_le_radical_iff, hprime.radical,
    Ideal.map_le_iff_le_comap, SetLike.not_le_iff_exists] at hnot
  obtain ⟨c, hc, hcq⟩ := hnot
  have hunit : IsUnit ((IsScalarTower.toAlgHom R B Λ) c) :=
    IsLocalRing.notMem_maximalIdeal.mp hcq
  refine ⟨Localization.Away c, inferInstance, inferInstance,
    smooth_localization_away_of_mem_singularIdeal R B hc,
    (IsScalarTower.toAlgHom R B (Localization.Away c)).comp (IsScalarTower.toAlgHom R A B),
    IsLocalization.Away.liftAlgHom (A := R) c hunit, AlgHom.ext fun a => ?_⟩
  show IsLocalization.Away.lift c hunit
      (algebraMap B (Localization.Away c) (algebraMap A B a)) = algebraMap A Λ a
  rw [IsLocalization.Away.lift_eq c hunit]
  exact (IsScalarTower.algebraMap_apply A B Λ a).symm

end Resolution

/-! ### Essentially smooth ring maps are ind-smooth -/

section IndSmooth

variable {R B S : Type u} [CommRing R] [CommRing B] [CommRing S] [Algebra R B] [Algebra B S]
  [Algebra R S] [IsScalarTower R B S]

/-- A finite family of elements of a localization `M⁻¹B` already lies in the localization of `B`
away from a single element of `M`. -/
private theorem exists_localizationAway_of_isLocalization (M : Submonoid B) [IsLocalization M S]
    {n : ℕ} (x : Fin n → S) :
    ∃ (b : M) (y : Fin n → Localization.Away (b : B))
      (κ : Localization.Away (b : B) →ₐ[R] S),
      (∀ v : B, κ (algebraMap B (Localization.Away (b : B)) v) = algebraMap B S v) ∧
        ∀ i, κ (y i) = x i := by
  classical
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite M x
  choose a ha using fun i => RingHom.mem_range.mp (hb i)
  have hunit : IsUnit ((IsScalarTower.toAlgHom R B S) (b : B)) := IsLocalization.map_units S b
  have hbunit : IsUnit (algebraMap B S (b : B)) := hunit
  have hu : IsUnit (algebraMap B (Localization.Away (b : B)) (b : B)) :=
    IsLocalization.Away.algebraMap_isUnit _
  let κ : Localization.Away (b : B) →ₐ[R] S :=
    IsLocalization.Away.liftAlgHom (A := R) (b : B) hunit
  have hκbase : ∀ v : B, κ (algebraMap B (Localization.Away (b : B)) v) = algebraMap B S v :=
    fun v => IsLocalization.Away.lift_eq (b : B) hunit v
  have hunitκ : κ (↑hu.unit) = algebraMap B S (b : B) := by
    rw [hu.unit_spec, hκbase]
  have hinv : κ (↑hu.unit⁻¹) * algebraMap B S (b : B) = 1 := by
    rw [← hunitκ, ← map_mul, Units.inv_mul, map_one]
  refine ⟨b, fun i => ↑hu.unit⁻¹ * algebraMap B (Localization.Away (b : B)) (a i), κ, hκbase,
    fun i => hbunit.mul_left_cancel ?_⟩
  calc algebraMap B S (b : B) * κ (↑hu.unit⁻¹ * algebraMap B (Localization.Away (b : B)) (a i))
      = (κ (↑hu.unit⁻¹) * algebraMap B S (b : B)) * algebraMap B S (a i) := by
        rw [map_mul, hκbase]; ring
    _ = algebraMap B S (b : B) * x i := by rw [hinv, one_mul, ha i, Algebra.smul_def]

/-- If a localization `S` of `B` is an algebra over `B_g` compatibly with `B`, for some `g` in the
localizing submonoid, then `S` is a scalar tower over `B_g` and a localization of it. -/
private theorem isScalarTower_isLocalization_away (M : Submonoid B) [IsLocalization M S] {g : B}
    (hg : g ∈ M) [Algebra (Localization.Away g) S]
    (h : ∀ v : B, algebraMap (Localization.Away g) S (algebraMap B _ v) = algebraMap B S v) :
    IsScalarTower B (Localization.Away g) S ∧
      IsLocalization (M.map (algebraMap B (Localization.Away g))) S := by
  have : IsScalarTower B (Localization.Away g) S :=
    IsScalarTower.of_algebraMap_eq fun v => (h v).symm
  exact ⟨this, IsLocalization.isLocalization_of_submonoid_le (Localization.Away g) S
    (Submonoid.powers g) M (Submonoid.powers_le.mpr hg)⟩

/-- An `R`-algebra map from an algebra of finite presentation into a localization `M⁻¹B` factors
through the localization of `B` away from a single element of `M`. -/
private theorem exists_algHom_localizationAway (M : Submonoid B) [IsLocalization M S]
    {A : Type u} [CommRing A] [Algebra R A] [Algebra.FinitePresentation R A] (φ : A →ₐ[R] S) :
    ∃ (g : B) (χ : A →ₐ[R] Localization.Away g) (κ : Localization.Away g →ₐ[R] S),
      κ.comp χ = φ := by
  classical
  obtain ⟨n, f, hsurj, hfg⟩ := Algebra.FinitePresentation.out (R := R) (A := A)
  obtain ⟨b, y, κ₁, hκ₁base, hκ₁⟩ := exists_localizationAway_of_isLocalization (R := R) M
    (fun i : Fin n => φ (f (MvPolynomial.X i)))
  have hψ₁ : ∀ p, κ₁ (MvPolynomial.aeval (R := R) y p) = φ (f p) := by
    have h : κ₁.comp (MvPolynomial.aeval (R := R) y) = φ.comp f :=
      MvPolynomial.algHom_ext fun i => by simpa using hκ₁ i
    exact fun p => AlgHom.congr_fun h p
  let : Algebra (Localization.Away (b : B)) S := κ₁.toRingHom.toAlgebra
  obtain ⟨_, _⟩ := isScalarTower_isLocalization_away M b.2 hκ₁base
  obtain ⟨s, hs⟩ := hfg
  have hkill : ∀ p : {z // z ∈ s}, ∃ v : B, v ∈ M ∧
      algebraMap B (Localization.Away (b : B)) v * MvPolynomial.aeval (R := R) y p.1 = 0 := by
    intro p
    have hp : f p.1 = 0 := RingHom.mem_ker.mp (hs ▸ Ideal.subset_span p.2)
    obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists
      (M.map (algebraMap B (Localization.Away (b : B)))) S).mp
      (show algebraMap (Localization.Away (b : B)) S (MvPolynomial.aeval (R := R) y p.1) =
          algebraMap (Localization.Away (b : B)) S 0 by
        show κ₁ (MvPolynomial.aeval (R := R) y p.1) = κ₁ 0
        rw [hψ₁, hp, map_zero, map_zero])
    obtain ⟨v, hvM, hv⟩ := c.2
    exact ⟨v, hvM, by rw [hv]; simpa using hc⟩
  choose v hvM hv using hkill
  refine ⟨(b : B) * ∏ p : {z // z ∈ s}, v p, ?_⟩
  have hgM : (b : B) * ∏ p : {z // z ∈ s}, v p ∈ M :=
    M.mul_mem b.2 (Submonoid.prod_mem M fun p _ => hvM p)
  have hu1 : IsUnit ((IsScalarTower.toAlgHom R B
      (Localization.Away ((b : B) * ∏ p : {z // z ∈ s}, v p))) (b : B)) :=
    IsLocalization.Away.isUnit_of_dvd ((b : B) * ∏ p : {z // z ∈ s}, v p)
      (dvd_mul_right (b : B) _)
  have hunitg : IsUnit ((IsScalarTower.toAlgHom R B S) ((b : B) * ∏ p : {z // z ∈ s}, v p)) :=
    IsLocalization.map_units S (⟨_, hgM⟩ : M)
  let θ : Localization.Away (b : B) →ₐ[R]
      Localization.Away ((b : B) * ∏ p : {z // z ∈ s}, v p) :=
    IsLocalization.Away.liftAlgHom (A := R) (b : B) hu1
  have hθbase : ∀ z : B, θ (algebraMap B (Localization.Away (b : B)) z) =
      algebraMap B (Localization.Away ((b : B) * ∏ p : {z // z ∈ s}, v p)) z :=
    fun z => IsLocalization.Away.lift_eq (b : B) hu1 z
  have hkerle : RingHom.ker f.toRingHom ≤
      RingHom.ker (θ.comp (MvPolynomial.aeval (R := R) y)).toRingHom := by
    rw [← hs, Ideal.span_le]
    intro p hp
    have hdvd : v ⟨p, hp⟩ ∣ (b : B) * ∏ p : {z // z ∈ s}, v p :=
      (Finset.dvd_prod_of_mem _ (Finset.mem_univ (⟨p, hp⟩ : {z // z ∈ s}))).trans
        (dvd_mul_left _ _)
    have hzero := congrArg θ (hv ⟨p, hp⟩)
    rw [map_mul, hθbase, map_zero] at hzero
    exact (IsLocalization.Away.isUnit_of_dvd
      ((b : B) * ∏ p : {z // z ∈ s}, v p) hdvd).mul_left_cancel
      (by rw [mul_zero]; exact hzero)
  refine ⟨AlgHom.liftOfSurjective f hsurj (θ.comp (MvPolynomial.aeval (R := R) y)) hkerle,
    IsLocalization.Away.liftAlgHom (A := R) _ hunitg, AlgHom.ext fun c => ?_⟩
  obtain ⟨p, rfl⟩ := hsurj c
  have hcomp : ∀ z : Localization.Away (b : B),
      IsLocalization.Away.lift ((b : B) * ∏ p : {z // z ∈ s}, v p) hunitg (θ z) = κ₁ z := by
    have h : (IsLocalization.Away.lift ((b : B) * ∏ p : {z // z ∈ s}, v p) hunitg).comp
        (θ : Localization.Away (b : B) →+* _) = (κ₁ : Localization.Away (b : B) →+* S) :=
      IsLocalization.ringHom_ext (Submonoid.powers (b : B)) (RingHom.ext fun z => by
        show IsLocalization.Away.lift ((b : B) * ∏ p : {z // z ∈ s}, v p) hunitg
            (θ (algebraMap B (Localization.Away (b : B)) z)) =
          κ₁ (algebraMap B (Localization.Away (b : B)) z)
        rw [hθbase, hκ₁base,
          IsLocalization.Away.lift_eq ((b : B) * ∏ p : {z // z ∈ s}, v p) hunitg z]
        rfl)
    exact fun z => RingHom.congr_fun h z
  show IsLocalization.Away.lift ((b : B) * ∏ p : {z // z ∈ s}, v p) hunitg
    (AlgHom.liftOfSurjective f hsurj (θ.comp (MvPolynomial.aeval (R := R) y)) hkerle (f p)) =
      φ (f p)
  rw [AlgHom.liftOfSurjective_apply]
  show IsLocalization.Away.lift ((b : B) * ∏ p : {z // z ∈ s}, v p) hunitg
    (θ (MvPolynomial.aeval (R := R) y p)) = φ (f p)
  rw [hcomp, hψ₁]

/-- For a localization `S` of an algebra `B` of finite presentation over `R`, formal smoothness of
`S` over `R` makes `B` smooth over `R` away from some element of the localizing submonoid. -/
private theorem exists_mem_smooth_localizationAway [Algebra.FinitePresentation R B]
    (M : Submonoid B) [IsLocalization M S] (hS : Algebra.FormallySmooth R S) :
    ∃ f ∈ M, Algebra.Smooth R (Localization.Away f) := by
  classical
  have hzl : PrimeSpectrum.zeroLocus
      (PrimeSpectrum.vanishingIdeal (Algebra.smoothLocus R B)ᶜ : Set B) =
      (Algebra.smoothLocus R B)ᶜ := by
    rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure]
    exact Algebra.isOpen_smoothLocus.isClosed_compl.closure_eq
  have hnd : ¬ Disjoint
      (PrimeSpectrum.vanishingIdeal (Algebra.smoothLocus R B)ᶜ : Set B) (M : Set B) := by
    intro hdisj
    obtain ⟨P, hP, hIP, hPM⟩ := Ideal.exists_le_prime_disjoint _ M hdisj
    have hd : Disjoint (M : Set B) (P : Set B) := hPM.symm
    have hp : (Ideal.map (algebraMap B S) P).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M S P hP hd
    have hcomap : (Ideal.map (algebraMap B S) P).comap (algebraMap B S) = P :=
      IsLocalization.under_map_of_isPrime_disjoint M S hP hd
    have hpc : ((Ideal.map (algebraMap B S) P).comap (algebraMap B S)).primeCompl =
        P.primeCompl := by
      refine Submonoid.ext fun x => ?_
      show x ∉ (Ideal.map (algebraMap B S) P).comap (algebraMap B S) ↔ x ∉ P
      rw [hcomap]
    have hloc0 := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (R := B) (S := S) (T := Localization.AtPrime (Ideal.map (algebraMap B S) P)) M
      (Ideal.map (algebraMap B S) P)
    have : IsLocalization P.primeCompl
        (Localization.AtPrime (Ideal.map (algebraMap B S) P)) := hpc ▸ hloc0
    have : Algebra.FormallySmooth S (Localization.AtPrime (Ideal.map (algebraMap B S) P)) :=
      Algebra.FormallySmooth.of_isLocalization (Ideal.map (algebraMap B S) P).primeCompl
    have : Algebra.FormallySmooth R S := hS
    have : Algebra.FormallySmooth R
        (Localization.AtPrime (Ideal.map (algebraMap B S) P)) :=
      Algebra.FormallySmooth.comp R S _
    have hsmoothAt : Algebra.FormallySmooth R (Localization.AtPrime P) :=
      Algebra.FormallySmooth.of_equiv
        ((IsLocalization.algEquiv P.primeCompl
          (Localization.AtPrime (Ideal.map (algebraMap B S) P))
          (Localization.AtPrime P)).restrictScalars R)
    have hmem : (⟨P, hP⟩ : PrimeSpectrum B) ∈ (Algebra.smoothLocus R B)ᶜ := by
      rw [← hzl]
      exact (PrimeSpectrum.mem_zeroLocus _ _).mpr (SetLike.coe_subset_coe.mpr hIP)
    exact hmem hsmoothAt
  obtain ⟨g, hgI, hgM⟩ := Set.not_disjoint_iff.mp hnd
  refine ⟨g, hgM, Algebra.basicOpen_subset_smoothLocus_iff_smooth.mp fun xp hx => ?_⟩
  by_contra hns
  exact ((PrimeSpectrum.mem_basicOpen g xp).mp hx)
    ((PrimeSpectrum.mem_vanishingIdeal _ _).mp hgI xp hns)

/-- A localization of a smooth algebra is a filtered colimit of smooth algebras. -/
theorem indSmooth_of_smooth_of_isLocalization (M : Submonoid B) [IsLocalization M S]
    (hB : Algebra.Smooth R B) : IndSmooth R S := by
  rw [indSmooth_iff_exists_factorization]
  intro A instA algA hfp φ
  let : CommRing A := instA
  let : Algebra R A := algA
  have : Algebra.FinitePresentation R A := hfp
  obtain ⟨g, χ, κ, hκχ⟩ := exists_algHom_localizationAway M φ
  have : Algebra.FinitePresentation B (Localization.Away g) :=
    IsLocalization.Away.finitePresentation g
  have : Algebra.FormallySmooth R B := hB.formallySmooth
  have : Algebra.FinitePresentation R B := hB.finitePresentation
  exact ⟨Localization.Away g, inferInstance, inferInstance,
    ⟨Algebra.FormallySmooth.comp R B (Localization.Away g),
      Algebra.FinitePresentation.trans R B (Localization.Away g)⟩, χ, κ, hκχ⟩

/-- **An essentially smooth algebra is ind-smooth.** If `S` is a localization of an `R`-algebra of
finite presentation and `S` is formally smooth over `R`, then `S` is a filtered colimit of smooth
`R`-algebras. -/
theorem indSmooth_of_formallySmooth_of_isLocalization [Algebra.FinitePresentation R B]
    (M : Submonoid B) [IsLocalization M S] (hS : Algebra.FormallySmooth R S) : IndSmooth R S := by
  obtain ⟨g, hgM, hg⟩ := exists_mem_smooth_localizationAway M hS
  have hunit : IsUnit ((IsScalarTower.toAlgHom R B S) g) := IsLocalization.map_units S ⟨g, hgM⟩
  let κ : Localization.Away g →ₐ[R] S := IsLocalization.Away.liftAlgHom (A := R) g hunit
  let : Algebra (Localization.Away g) S := κ.toRingHom.toAlgebra
  obtain ⟨_, _⟩ := isScalarTower_isLocalization_away M hgM (IsLocalization.Away.lift_eq g hunit)
  exact indSmooth_of_smooth_of_isLocalization (M.map (algebraMap B (Localization.Away g))) hg

end IndSmooth

/-! ### Numbered steps of the proof of Stacks 07FJ -/

/-- **Stacks 07FJ, step 20** (tag 07G4). It suffices to resolve the localized chain
`(R/I)_𝔯 → C ⊗ (R/I)_𝔯 → Λ_𝔮/IΛ_𝔮`: a chain `R → A → Λ ⊃ 𝔮` whose prime is minimal over
`𝔥_A`, whose localized chain can be resolved, and in whose localization `Λ_𝔮` the maximal ideal
is generated by finitely many nilpotent elements, can be resolved. The last condition is the
one supplied by the step: the images of the parameters `π_1, …, π_d` generate the maximal ideal
and their `e`-th powers already lie in the ideal `I` divided out. -/
@[stacks 07G4 "for a chain whose localized target has maximal ideal generated by finitely many \
nilpotents, which is the form taken by the quotient by (γ_1^e, …, γ_d^e)"]
theorem LocalSmoothingSituation.canBeResolved_of_nilpotent_generators
    (S : LocalSmoothingSituation.{u, v, w}) {d : ℕ} (π : Fin d → Localization.AtPrime S.q)
    (hgen : IsLocalRing.maximalIdeal (Localization.AtPrime S.q) = Ideal.span (Set.range π))
    (hnil : ∀ i, IsNilpotent (π i))
    (hq : S.q ∈ S.radicalSingularIdealExtension.minimalPrimes)
    (hres : S.IsResolvableAfterLocalizing) : S.CanBeResolved := by
  refine canBeResolved_of_localization_dim_zero S hq hres ?_
  have hle : IsLocalRing.maximalIdeal (Localization.AtPrime S.q) ≤
      nilradical (Localization.AtPrime S.q) := by
    rw [hgen, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact mem_nilradical.mpr (hnil i)
  have heq : nilradical (Localization.AtPrime S.q) =
      IsLocalRing.maximalIdeal (Localization.AtPrime S.q) :=
    le_antisymm (nilradical_le_prime _) hle
  have : (nilradical (Localization.AtPrime S.q)).IsMaximal :=
    heq ▸ IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime S.q)
  exact ringKrullDimZero_iff_ringKrullDim_eq_zero.mp
    (Ring.KrullDimLE.of_isMaximal_nilradical (Localization.AtPrime S.q))

section Steps

variable {R₀ A₀ L : Type u} [CommRing R₀] [CommRing A₀] [CommRing L] [Algebra R₀ A₀]
  [Algebra A₀ L] [Algebra R₀ L] [IsScalarTower R₀ A₀ L]

/-- **Stacks 07FJ, step 24** (tag 07G8). It suffices to resolve the chain with `B` in place of
`C`: an `R`-algebra section `C → B` compatible with the maps to the target carries a smooth
factorization of `B → Λ` to one of `C → Λ`. -/
@[stacks 07G8]
theorem hasSmoothFactorization_of_algHom {C₀ : Type u} [CommRing C₀] [Algebra R₀ C₀]
    [Algebra C₀ L] [IsScalarTower R₀ C₀ L] (σ : C₀ →ₐ[R₀] A₀)
    (hσ : ∀ c, algebraMap A₀ L (σ c) = algebraMap C₀ L c)
    (h : HasSmoothFactorization R₀ A₀ L) : HasSmoothFactorization R₀ C₀ L := by
  obtain ⟨T, _, _, hT, g, k, hgk⟩ := h
  refine ⟨T, inferInstance, inferInstance, hT, g.comp σ, k, AlgHom.ext fun c => ?_⟩
  show k (g (σ c)) = algebraMap C₀ L c
  rw [show k (g (σ c)) = algebraMap A₀ L (σ c) from AlgHom.congr_fun hgk (σ c), hσ c]

end Steps

/-! ### Base change of a smooth factorization -/

section BaseChange

variable {R₁ A₁ L₁ R₂ A₂ L₂ : Type u} [CommRing R₁] [CommRing A₁] [CommRing L₁] [CommRing R₂]
  [CommRing A₂] [CommRing L₂] [Algebra R₁ A₁] [Algebra A₁ L₁] [Algebra R₁ L₁]
  [IsScalarTower R₁ A₁ L₁] [Algebra R₂ A₂] [Algebra A₂ L₂] [Algebra R₂ L₂]
  [IsScalarTower R₂ A₂ L₂] [Algebra R₁ R₂] [Algebra A₁ A₂] [Algebra L₁ L₂] [Algebra R₁ A₂]
  [IsScalarTower R₁ R₂ A₂] [IsScalarTower R₁ A₁ A₂] [Algebra R₁ L₂] [IsScalarTower R₁ R₂ L₂]
  [IsScalarTower R₁ L₁ L₂] [Algebra A₁ L₂] [IsScalarTower A₁ A₂ L₂] [IsScalarTower A₁ L₁ L₂]

/-- A smooth factorization is carried along a base change of the chain: if `A₂` is the pushout of
`A₁` along `R₁ → R₂` and the target `L₂` receives `L₁` compatibly, then a factorization of
`A₁ → L₁` through an algebra `T` smooth over `R₁` gives one of `A₂ → L₂` through `R₂ ⊗[R₁] T`. -/
theorem hasSmoothFactorization_baseChange [Algebra.IsPushout R₁ A₁ R₂ A₂]
    (h : HasSmoothFactorization R₁ A₁ L₁) : HasSmoothFactorization R₂ A₂ L₂ := by
  obtain ⟨T, _, _, hT, g, k, hgk⟩ := h
  have : Algebra.Smooth R₁ T := hT
  let g₁ : A₂ →ₐ[R₁] R₂ ⊗[R₁] T :=
    Algebra.pushoutDesc A₂ (Algebra.TensorProduct.includeRight.comp g)
      (IsScalarTower.toAlgHom R₁ R₂ (R₂ ⊗[R₁] T)) fun _ _ => mul_comm _ _
  let k₂ : R₂ ⊗[R₁] T →ₐ[R₂] L₂ :=
    Algebra.TensorProduct.lift (Algebra.ofId R₂ L₂)
      ((IsScalarTower.toAlgHom R₁ L₁ L₂).comp k) fun _ _ => Commute.all _ _
  have hg₁right : ∀ r : R₂, g₁ (algebraMap R₂ A₂ r) = algebraMap R₂ (R₂ ⊗[R₁] T) r := fun r =>
    Algebra.pushoutDesc_right A₂ _ _ _ r
  have hg₁left : ∀ a : A₁, g₁ (algebraMap A₁ A₂ a) = (1 : R₂) ⊗ₜ[R₁] g a := fun a =>
    Algebra.pushoutDesc_left A₂ _ _ _ a
  have hk₂right : ∀ t : T, k₂ ((1 : R₂) ⊗ₜ[R₁] t) = algebraMap L₁ L₂ (k t) := fun t => by
    show Algebra.ofId R₂ L₂ 1 * algebraMap L₁ L₂ (k t) = _
    rw [map_one, one_mul]
  refine ⟨R₂ ⊗[R₁] T, inferInstance, inferInstance, inferInstance,
    { toRingHom := g₁.toRingHom, commutes' := hg₁right }, k₂, AlgHom.ext fun x => ?_⟩
  show k₂ (g₁ x) = algebraMap A₂ L₂ x
  have key : (k₂.restrictScalars R₁).comp g₁ =
      (IsScalarTower.toAlgHom R₂ A₂ L₂).restrictScalars R₁ := by
    refine Algebra.IsPushout.algHom_ext (R := R₁) (S := A₁) (R' := R₂) A₂
      (AlgHom.ext fun r => ?_) (AlgHom.ext fun a => ?_)
    · show k₂ (g₁ (algebraMap R₂ A₂ r)) = algebraMap A₂ L₂ (algebraMap R₂ A₂ r)
      rw [hg₁right, k₂.commutes, ← IsScalarTower.algebraMap_apply R₂ A₂ L₂]
    · show k₂ (g₁ (algebraMap A₁ A₂ a)) = algebraMap A₂ L₂ (algebraMap A₁ A₂ a)
      rw [hg₁left, hk₂right, show k (g a) = algebraMap A₁ L₁ a from AlgHom.congr_fun hgk a,
        ← IsScalarTower.algebraMap_apply A₁ L₁ L₂, ← IsScalarTower.algebraMap_apply A₁ A₂ L₂]
  exact AlgHom.congr_fun key x

/-- **Stacks 07FJ, step 22** (tag 07G6). It suffices to resolve the chain over `(R/JR)_𝔭`: a
solution there, localized at `𝔯`, solves the chain of step (20) over `(R/I)_𝔯`. Over a local
Artinian target resolvability is the existence of a smooth factorization, and a smooth
factorization is carried along any base change of the chain. -/
@[stacks 07G6 "for an arbitrary base change R₁ → R₂ of the chain in place of the passage from \
(R/JR)_𝔭 to its localization (R/I)_𝔯, the base-changed target receiving the original target"]
theorem canBeResolved_of_canBeResolved_baseChange [IsLocalRing L₁]
    [Algebra.IsPushout R₁ A₁ R₂ A₂] {q : Ideal L₂} (hq : q ≠ ⊤)
    (h : CanBeResolved R₁ A₁ L₁ (IsLocalRing.maximalIdeal L₁)) : CanBeResolved R₂ A₂ L₂ q :=
  canBeResolved_of_hasSmoothFactorization hq
    (hasSmoothFactorization_baseChange (hasSmoothFactorization_of_canBeResolved h))

end BaseChange

/-! ### Powers of the ideal generated by a system of parameters -/

section SpanPow

variable {Y : Type u} [CommRing Y]

/-- Sharpening of `Ideal.sup_pow_add_le_pow_sup_pow` by one: in a product of `a + b + 1`
elements of `I ⊔ J` either `a + 1` factors come from `I` or `b + 1` come from `J`. -/
private theorem sup_pow_succ_le_sup_pow (I J : Ideal Y) (a b : ℕ) :
    (I ⊔ J) ^ (a + b + 1) ≤ I ^ (a + 1) ⊔ J ^ (b + 1) := by
  rw [← Ideal.add_eq_sup, ← Ideal.add_eq_sup, add_pow, Ideal.sum_eq_sup]
  refine Finset.sup_le fun i _ => ?_
  by_cases h : a + 1 ≤ i
  · exact Ideal.mul_le_left.trans
      (Ideal.mul_le_left.trans ((Ideal.pow_le_pow_right h).trans le_sup_left))
  · refine Ideal.mul_le_left.trans
      (Ideal.mul_le_right.trans ((Ideal.pow_le_pow_right ?_).trans le_sup_right))
    omega

/-- For a finite family `π i`, `i ∈ s`, the `n`-th power of the ideal they generate lies in the
ideal generated by their `e'+1`-st powers as soon as `s.card * e' < n`. -/
private theorem pow_sup_span_singleton_le {ι : Type*} (π : ι → Y) (e' : ℕ) :
    ∀ (s : Finset ι) (n : ℕ), s.card * e' + 1 ≤ n →
      (s.sup fun i => Ideal.span {π i}) ^ n ≤ s.sup fun i => Ideal.span {π i ^ (e' + 1)} := by
  classical
  intro s
  induction s using Finset.induction_on with
  | empty =>
    intro n hn
    rw [Finset.sup_empty, Finset.sup_empty]
    exact Ideal.pow_le_self (by omega)
  | insert a s ha ih =>
    intro n hn
    rw [Finset.card_insert_of_notMem ha, Nat.add_mul, one_mul] at hn
    rw [Finset.sup_insert, Finset.sup_insert]
    refine (Ideal.pow_le_pow_right (show e' + s.card * e' + 1 ≤ n by omega)).trans ?_
    refine (sup_pow_succ_le_sup_pow _ _ e' (s.card * e')).trans
      (sup_le_sup ?_ (ih (s.card * e' + 1) le_rfl))
    rw [Ideal.span_singleton_pow]

/-- **The bound of Stacks 07FJ, step 23, corrected.** If `𝔭 = (π_1, …, π_d)` and
`J = (π_1^e, …, π_d^e)` then `𝔭^n ⊆ J` as soon as `d(e - 1) < n`, and this is sharp: a monomial
of degree `n` in the `π_i` is forced into `J` only when one of its exponents reaches `e`. The
bound `d·e < n` of `Stacks.AlgebraicGeometry.IdealPowerSections.span_range_pow_le_span_range_pow`
is the same statement with a weaker hypothesis. -/
@[stacks 07G7 "with the hypothesis d*(e-1)+1 ≤ n in place of the source's n = N + dc, which \
does not give 𝔭^n ⊆ J: a degree-n monomial in the regular system of parameters π_1, …, π_d \
lies in (π_1^e, …, π_d^e) only if some exponent reaches e, so the containment needs d*(e-1) < \
n, whereas N is fixed in step (1) before c and hence before e = 8c"]
theorem span_range_pow_le_span_range_pow_of_le {d : ℕ} (π : Fin d → Y) {e n : ℕ} (he : 1 ≤ e)
    (hn : d * (e - 1) + 1 ≤ n) :
    Ideal.span (Set.range π) ^ n ≤ Ideal.span (Set.range fun i => π i ^ e) := by
  classical
  have hspan : ∀ f : Fin d → Y,
      Ideal.span (Set.range f) = Finset.univ.sup fun i => Ideal.span {f i} := by
    intro f
    refine le_antisymm (Ideal.span_le.mpr ?_) (Finset.sup_le fun i _ => ?_)
    · rintro x ⟨i, rfl⟩
      exact Finset.le_sup (f := fun i => Ideal.span {f i}) (Finset.mem_univ i)
        (Ideal.mem_span_singleton_self _)
    · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.subset_span ⟨i, rfl⟩))
  obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
  rw [hspan, hspan]
  exact pow_sup_span_singleton_le π e' Finset.univ n (by simpa using hn)

end SpanPow

/-! ### Dividing a chain by an ideal of the base -/

section QuotientStep

/-- The quotient of an algebra by the extension of an ideal of the base is the base change of the
algebra along the quotient map of the base. -/
theorem isPushout_quotient_idealMap (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]
    (I : Ideal R) : Algebra.IsPushout R A (R ⧸ I) (A ⧸ Ideal.map (algebraMap R A) I) :=
  ⟨IsBaseChange.of_equiv
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A I).symm.toLinearEquiv fun x => by
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      show (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A I).symm _ = _
      rw [AlgEquiv.symm_apply_eq]
      show _ = Algebra.TensorProduct.quotIdealMapEquivTensorQuot A I
        (Ideal.Quotient.mk _ (algebraMap R A y))
      rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk,
        Algebra.algebraMap_eq_smul_one y, TensorProduct.smul_tmul,
        ← Algebra.algebraMap_eq_smul_one]
      rfl⟩

variable {R A L : Type u} [CommRing R] [CommRing A] [CommRing L] [Algebra R A] [Algebra A L]
  [Algebra R L] [IsScalarTower R A L]

/-- **Stacks 07FJ, step 23** (tag 07G7). It suffices to resolve the chain before dividing by the
ideal: dividing a solution of `R → A → Λ` by an ideal `I` of the base gives a solution of
`R/I → A/IA → Λ/IΛ`, because `A/IA` is the base change of `A` along `R → R/I`. In step (23) the
base is `(R/𝔭^nR)_𝔭`, the ideal is `J = (π_1^e, …, π_d^e)`, and
`span_range_pow_le_span_range_pow_of_le` is what makes `(R/JR)_𝔭` that quotient. -/
@[stacks 07G7 "the reduction half of the step: the solution of the chain over (R/p^nR)_p is \
divided by J, which is a base change of the chain; the numeric input p^n ⊆ J is \
span_range_pow_le_span_range_pow_of_le, stated with the corrected bound"]
theorem canBeResolved_quotient_of_canBeResolved [IsLocalRing L] (I : Ideal R)
    (h : CanBeResolved R A L (IsLocalRing.maximalIdeal L)) :
    let IA := Ideal.map (algebraMap R A) I
    let IL := Ideal.map (algebraMap A L) IA
    letI : Algebra (R ⧸ I) (L ⧸ IL) :=
      ((algebraMap (A ⧸ IA) (L ⧸ IL)).comp (algebraMap (R ⧸ I) (A ⧸ IA))).toAlgebra
    letI : IsScalarTower (R ⧸ I) (A ⧸ IA) (L ⧸ IL) := IsScalarTower.of_algebraMap_eq fun _ => rfl
    ∀ q : Ideal (L ⧸ IL), q ≠ ⊤ → CanBeResolved (R ⧸ I) (A ⧸ IA) (L ⧸ IL) q := by
  intro IA IL q hq
  have : Algebra.IsPushout R A (R ⧸ I) (A ⧸ IA) := isPushout_quotient_idealMap R A I
  let : Algebra (R ⧸ I) (L ⧸ IL) :=
    ((algebraMap (A ⧸ IA) (L ⧸ IL)).comp (algebraMap (R ⧸ I) (A ⧸ IA))).toAlgebra
  let : IsScalarTower (R ⧸ I) (A ⧸ IA) (L ⧸ IL) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R (R ⧸ I) (L ⧸ IL) := IsScalarTower.of_algebraMap_eq fun r => by
    show Ideal.Quotient.mk IL (algebraMap R L r) =
      Ideal.Quotient.mk IL (algebraMap A L (algebraMap R A r))
    rw [← IsScalarTower.algebraMap_apply R A L]
  have : IsScalarTower A (A ⧸ IA) (L ⧸ IL) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact canBeResolved_of_canBeResolved_baseChange hq h

end QuotientStep

/-! ### Factoring through an ind-smooth algebra -/

section IndSmoothFactorization

open MvPolynomial

/-- A chain `A → E → L` with `A` of finite presentation over `R` and `E` ind-smooth over `R` has
a smooth factorization: the map `A → E` already factors through a smooth `R`-algebra. -/
theorem hasSmoothFactorization_of_indSmooth {R A E L : Type u} [CommRing R] [CommRing A]
    [CommRing E] [CommRing L] [Algebra R A] [Algebra A L] [Algebra R L] [IsScalarTower R A L]
    [Algebra R E] [Algebra.FinitePresentation R A] (hE : IndSmooth R E) (g : A →ₐ[R] E)
    (k : E →ₐ[R] L) (hgk : k.comp g = IsScalarTower.toAlgHom R A L) :
    HasSmoothFactorization R A L := by
  rw [indSmooth_iff_exists_factorization] at hE
  obtain ⟨T, instT, algT, hT, g', k', hg'k'⟩ := hE A inferInstance inferInstance inferInstance g
  refine ⟨T, instT, algT, hT, g', k.comp k', ?_⟩
  rw [AlgHom.comp_assoc, hg'k', hgk]

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- **An essentially smooth algebra stays ind-smooth after adjoining variables.** If `D` is a
localization of a `Λ₀`-algebra of finite presentation and is formally smooth over `Λ₀`, then
`D[t_1, …, t_d]` is a filtered colimit of smooth `Λ₀[t_1, …, t_d]`-algebras. -/
theorem indSmooth_mvPolynomial_of_formallySmooth_of_isLocalization {Λ₀ B₀ D : Type u}
    [CommRing Λ₀] [CommRing B₀] [CommRing D] [Algebra Λ₀ B₀] [Algebra B₀ D] [Algebra Λ₀ D]
    [IsScalarTower Λ₀ B₀ D] [Algebra.FinitePresentation Λ₀ B₀] (M : Submonoid B₀)
    [IsLocalization M D] (hD : Algebra.FormallySmooth Λ₀ D) (d : ℕ) :
    IndSmooth (MvPolynomial (Fin d) Λ₀) (MvPolynomial (Fin d) D) := by
  have : Algebra.FormallySmooth Λ₀ D := hD
  have htower : IsScalarTower (MvPolynomial (Fin d) Λ₀) (MvPolynomial (Fin d) B₀)
      (MvPolynomial (Fin d) D) :=
    IsScalarTower.of_algebraMap_eq fun p => by
      simp only [MvPolynomial.algebraMap_def, MvPolynomial.map_map,
        ← IsScalarTower.algebraMap_eq]
  have hfp : Algebra.FinitePresentation (MvPolynomial (Fin d) Λ₀) (MvPolynomial (Fin d) B₀) :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation
      (R := Λ₀) (A := MvPolynomial (Fin d) Λ₀) (B := MvPolynomial (Fin d) B₀)
  exact indSmooth_of_formallySmooth_of_isLocalization (M.map (C (σ := Fin d)))
    (Algebra.FormallySmooth.of_equiv
      (Algebra.IsPushout.equiv Λ₀ (MvPolynomial (Fin d) Λ₀) D (MvPolynomial (Fin d) D)))

/-- **Stacks 07FJ, step 25** (tag 07G9). It suffices to find a factorization
`B ⊗_{k[x_1, …, x_d]} (R/𝔭^nR)_𝔭 → D'[t_1, …, t_d] → Λ_𝔮/𝔮^nΛ_𝔮`: the ring
`R_𝔭/𝔭^nR_𝔭` is the polynomial ring `Λ₀[t_1, …, t_d]` over
`Λ₀ = k[y_1, …, y_m]_𝔭/𝔭^nk[y_1, …, y_m]_𝔭`, the algebra `D'` is essentially smooth over `Λ₀`,
hence `D'[t_1, …, t_d]` is a filtered colimit of smooth `Λ₀[t_1, …, t_d]`-algebras and the
finitely presented middle term factors through one of them. -/
@[stacks 07G9 "for a chain whose middle term is an arbitrary algebra of finite presentation \
over Λ₀[t_1, …, t_d] in place of B ⊗_{k[x_1, …, x_d]} (R/p^nR)_p, with essential smoothness of \
Λ₀ → D' spelled out as: D' is a localization of a Λ₀-algebra of finite presentation and is \
formally smooth over Λ₀"]
theorem canBeResolved_of_factorization_mvPolynomial {Λ₀ B₀ D A L : Type u} [CommRing Λ₀]
    [CommRing B₀] [CommRing D] [CommRing A] [CommRing L] [Algebra Λ₀ B₀] [Algebra B₀ D]
    [Algebra Λ₀ D] [IsScalarTower Λ₀ B₀ D] [Algebra.FinitePresentation Λ₀ B₀] (M : Submonoid B₀)
    [IsLocalization M D] (hD : Algebra.FormallySmooth Λ₀ D) {d : ℕ}
    [Algebra (MvPolynomial (Fin d) Λ₀) A] [Algebra A L] [Algebra (MvPolynomial (Fin d) Λ₀) L]
    [IsScalarTower (MvPolynomial (Fin d) Λ₀) A L]
    [Algebra.FinitePresentation (MvPolynomial (Fin d) Λ₀) A]
    (g : A →ₐ[MvPolynomial (Fin d) Λ₀] MvPolynomial (Fin d) D)
    (k : MvPolynomial (Fin d) D →ₐ[MvPolynomial (Fin d) Λ₀] L)
    (hgk : k.comp g = IsScalarTower.toAlgHom (MvPolynomial (Fin d) Λ₀) A L)
    {q : Ideal L} (hq : q ≠ ⊤) :
    CanBeResolved (MvPolynomial (Fin d) Λ₀) A L q :=
  canBeResolved_of_hasSmoothFactorization hq
    (hasSmoothFactorization_of_indSmooth
      (indSmooth_mvPolynomial_of_formallySmooth_of_isLocalization M hD d) g k hgk)

end IndSmoothFactorization

/-! ### The twisted factorization of step 26 -/

section FinalTwist

open MvPolynomial

/-- **Stacks 07FJ, step 26** (tag 07GA). The factorization required by step (25) exists. Its
twist is that `B = A[x_i, z_{ij}]/(x_i^{2N} - Σ_j z_{ij}a_j)` must send `x_i` to `π_i t_i`, not
to `π'_i = δ_i π_i`, for the square over `k[x_1, …, x_d] → R_𝔭/𝔭^nR_𝔭` to commute; the defining
relation then forces `z_{ij} ↦ λ_{ij} t_i^{2N}/δ_i^{2N}`, which lies in `D'[t_1, …, t_d]`
because `δ_i` is a unit of the local ring `D'`. The map is produced as a
`k[x_1, …, x_d]`-algebra map for the structure `x_i ↦ π_i t_i` on `D'[t_1, …, t_d]`, which is
exactly the commutation of the square in the source. -/
@[stacks 07GA "the choices of (07FT), (07FU) and (07FX) are hypotheses: the map A → D' whose \
existence is the condition E ⊆ D of (07FT), the images π_i, δ_i, λ_{ij} in D' of (07FU) and \
(07FX), the invertibility of δ_i in the local ring D', and clause (a) of (07FX) read in D'. \
The target D'[t_1, …, t_d] is MvPolynomial (Fin d) D'"]
theorem exists_algHom_parameterPowerAlgebra_mvPolynomial (k : Type u) {A D : Type u} [CommRing k]
    [CommRing A] [CommRing D] [Algebra k A] [Algebra k D] {d r N : ℕ} (a : Fin r → A)
    (φ : A →ₐ[k] D) (π δ : Fin d → D) (lam : Fin d → Fin r → D) (hδ : ∀ i, IsUnit (δ i))
    (hrel : ∀ i, (δ i * π i) ^ (2 * N) = ∑ j, φ (a j) * lam i j) :
    letI : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) D) :=
      (MvPolynomial.aeval (R := k) fun i => C (π i) * X i).toRingHom.toAlgebra
    ∃ ψ : parameterPowerAlgebra A d N a →ₐ[MvPolynomial (Fin d) k] MvPolynomial (Fin d) D,
      (∀ x : A, ψ (algebraMap A (parameterPowerAlgebra A d N a) x) = C (φ x)) ∧
      (∀ i, ψ (Ideal.Quotient.mk (parameterPowerIdeal d N a) (X (Sum.inl i))) = C (π i) * X i) ∧
      ∀ i j, ψ (Ideal.Quotient.mk (parameterPowerIdeal d N a) (X (Sum.inr (i, j)))) =
        C (lam i j * (↑(hδ i).unit⁻¹ : D) ^ (2 * N)) * X i ^ (2 * N) := by
  let : Algebra (MvPolynomial (Fin d) k) (MvPolynomial (Fin d) D) :=
    (MvPolynomial.aeval (R := k) fun i => C (π i) * X i).toRingHom.toAlgebra
  have hpow : ∀ i, π i ^ (2 * N) =
      (∑ j, φ (a j) * lam i j) * (↑(hδ i).unit⁻¹ : D) ^ (2 * N) := fun i => by
    rw [← hrel i, ← mul_pow, mul_comm (δ i) (π i), mul_assoc, (hδ i).mul_val_inv, mul_one]
  let v : Fin d ⊕ Fin d × Fin r → MvPolynomial (Fin d) D :=
    Sum.elim (fun i => C (π i) * X i)
      fun p => C (lam p.1 p.2 * (↑(hδ p.1).unit⁻¹ : D) ^ (2 * N)) * X p.1 ^ (2 * N)
  let Φ : MvPolynomial (Fin d ⊕ Fin d × Fin r) A →ₐ[k] MvPolynomial (Fin d) D :=
    aevalTower ((IsScalarTower.toAlgHom k D (MvPolynomial (Fin d) D)).comp φ) v
  have hΦC : ∀ x : A, Φ (C x) = C (φ x) := fun x => by
    simp only [Φ, aevalTower_C, AlgHom.coe_comp, Function.comp_apply,
      IsScalarTower.coe_toAlgHom', MvPolynomial.algebraMap_eq]
  have hker : ∀ x ∈ parameterPowerIdeal d N a, Φ x = 0 := by
    intro x hx
    have hle : parameterPowerIdeal d N a ≤ RingHom.ker (Φ : _ →+* MvPolynomial (Fin d) D) := by
      rw [parameterPowerIdeal, Ideal.span_le]
      rintro y ⟨i, rfl⟩
      refine RingHom.mem_ker.mpr ?_
      show Φ (X (Sum.inl i) ^ (2 * N) - ∑ j, C (a j) * X (Sum.inr (i, j))) = 0
      have hXl : Φ (X (Sum.inl i)) = C (π i) * X i := aevalTower_X _ _ _
      have hXr : ∀ j, Φ (X (Sum.inr (i, j))) =
          C (lam i j * (↑(hδ i).unit⁻¹ : D) ^ (2 * N)) * X i ^ (2 * N) :=
        fun j => aevalTower_X _ _ _
      rw [map_sub, map_pow, map_sum, sub_eq_zero, hXl, mul_pow, ← C_pow, hpow i,
        Finset.sum_mul, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => Eq.symm ?_
      rw [map_mul, hΦC (a j), hXr j, ← mul_assoc, ← C_mul, mul_assoc]
    exact RingHom.mem_ker.mp (hle hx)
  have hcomm : ((Ideal.Quotient.liftₐ _ Φ hker).comp (IsScalarTower.toAlgHom k
      (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a))) =
      MvPolynomial.aeval (R := k) fun i => C (π i) * X i :=
    MvPolynomial.algHom_ext fun i => by
      show Ideal.Quotient.liftₐ _ Φ hker
        (algebraMap (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) (X i)) = _
      rw [algebraMap_mvPolynomial_parameterPowerAlgebra_X, MvPolynomial.aeval_X]
      exact aevalTower_X _ _ _
  refine ⟨{ toRingHom := (Ideal.Quotient.liftₐ _ Φ hker).toRingHom
            commutes' := fun p => AlgHom.congr_fun hcomm p }, fun x => ?_, fun i => ?_,
    fun i j => ?_⟩
  · have hC : algebraMap A (parameterPowerAlgebra A d N a) x =
        Ideal.Quotient.mk (parameterPowerIdeal d N a) (C x) := by
      rw [IsScalarTower.algebraMap_apply A (MvPolynomial (Fin d ⊕ Fin d × Fin r) A)
        (parameterPowerAlgebra A d N a), MvPolynomial.algebraMap_eq]
      rfl
    rw [hC]
    exact hΦC x
  · exact aevalTower_X _ _ _
  · exact aevalTower_X _ _ _

end FinalTwist

end Stacks.Smoothing

