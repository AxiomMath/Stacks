/-!
# Torsion lengths and affine blowup charts

Localizations and subalgebras of localizations, torsion lengths of finite modules over a
discrete valuation ring (`torsion_length_toNat_eq_zero_iff_free`: such a module is free exactly
when its torsion submodule has length zero), saturations of submodules, and kernels and
fractions on an affine blowup chart, for Néron's desingularization by affine blowups.
-/

@[expose] public section

namespace Stacks.Smoothing

open CategoryTheory
open scoped TensorProduct

universe uV u v w w'

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-! ## Localizations and subalgebras of localizations -/

/-- A localization of `A` is also a localization of a subalgebra `B ⊆ L` at the image of the
multiplicative set, since `B → L` is injective. -/
private lemma isLocalization_subalgebra
    {A L : Type*} [CommRing A] [CommRing L] [Algebra A L]
    (M : Submonoid A) [IsLocalization M L] (B : Subalgebra A L) :
    IsLocalization (M.map (algebraMap A B)) L where
  map_units := by
    rintro ⟨_, x, hx, rfl⟩
    exact IsLocalization.map_units L ⟨x, hx⟩
  surj z := by
    obtain ⟨⟨x, m⟩, hm⟩ := IsLocalization.surj M z
    exact ⟨⟨algebraMap A B x, algebraMap A B m, m, m.property, rfl⟩, hm⟩
  exists_of_eq {x y} h := by
    have hxy : x = y := Subtype.ext h
    exact ⟨1, by simpa using hxy⟩

/-- Smoothness at a prime passes from `A` to a subalgebra `B` of a localization `A[1/a]`, at any
prime of `B` avoiding `a`: localizing `B` further at `a` recovers a localization of `A`. -/
private lemma smoothAt_subalgebra_localization
    {R A L : Type*} [CommRing R] [CommRing A] [CommRing L]
    [Algebra R A] [Algebra A L] [Algebra R L] [IsScalarTower R A L]
    (a : A) [IsLocalization.Away a L] (B : Subalgebra A L)
    (q : Ideal B) [q.IsPrime] (ha : algebraMap A B a ∉ q)
    (hsm : Algebra.SmoothAt R A (q.comap (algebraMap A B))) :
    Algebra.SmoothAt R B q := by
  obtain ⟨g, hg, hgs⟩ := hsm
  let : Algebra.Smooth R (Localization.Away g) := hgs
  let D := Localization.Away (algebraMap A L g)
  let E := Localization.Away (algebraMap A (Localization.Away g) a)
  let : Algebra.Smooth (Localization.Away g) E :=
    Algebra.Smooth.of_isLocalization_Away (algebraMap A (Localization.Away g) a)
  let : Algebra.Smooth R E := Algebra.Smooth.comp R (Localization.Away g) E
  let : IsLocalization.Away (a * g) E :=
    IsLocalization.Away.mul (Localization.Away g) E g a
  let : IsLocalization.Away (a * g) D := IsLocalization.Away.mul' L D a g
  let : Algebra.Smooth R D := Algebra.Smooth.of_equiv
    ((IsLocalization.algEquiv (Submonoid.powers (a * g)) E D).restrictScalars R)
  let : IsLocalization.Away (algebraMap A B a) L := by
    simpa only [Submonoid.map_powers] using isLocalization_subalgebra
      (Submonoid.powers a) B
  have : IsLocalization.Away (algebraMap B L (algebraMap A B g)) D := by
    rw [← IsScalarTower.algebraMap_apply A B L]
    infer_instance
  let : IsLocalization.Away (algebraMap A B (a * g)) D := by
    rw [map_mul]
    exact IsLocalization.Away.mul' L D (algebraMap A B a) (algebraMap A B g)
  refine ⟨algebraMap A B (a * g), ?_, ?_⟩
  · rw [map_mul]
    exact q.primeCompl.mul_mem ha hg
  · exact Algebra.Smooth.of_equiv
      ((IsLocalization.algEquiv (Submonoid.powers (algebraMap A B (a * g)))
        D (Localization.Away (algebraMap A B (a * g)))).restrictScalars R)

/-- The affine blowup `A[I/a]` of a finitely generated ideal is of finite type over `A`: it is
generated by the fractions `y/a` for `y` in a finite generating set of `I`. -/
private lemma finiteType_affineBlowupAlgebra
    {A : Type*} [CommRing A] (I : Ideal A) (a : A) (hI : I.FG) :
    Algebra.FiniteType A (affineBlowupAlgebra I a (Localization.Away a)) := by
  classical
  let L := Localization.Away a
  let d : L := IsLocalization.mk' L 1 ⟨a, Submonoid.mem_powers a⟩
  let f : A →ₗ[A] L := d • Algebra.linearMap A L
  have hf (x : A) : f x = IsLocalization.mk' L x ⟨a, Submonoid.mem_powers a⟩ := by
    simp only [f, LinearMap.smul_apply, Algebra.linearMap_apply, smul_eq_mul]
    rw [IsLocalization.mk'_eq_mul_mk'_one, mul_comm]
  obtain ⟨t, ht⟩ := hI
  apply (Subalgebra.fg_iff_finiteType _).mp
  apply Subalgebra.fg_def.mpr
  refine ⟨f '' (t : Set A), t.finite_toSet.image f, ?_⟩
  have hgen : {z : L | ∃ y ∈ I,
      z = IsLocalization.mk' L y ⟨a, Submonoid.mem_powers a⟩} =
      (Submodule.map f I : Set L) := by
    ext z
    simp only [Submodule.mem_map, SetLike.mem_coe, Set.mem_ofPred_eq, hf]
    constructor <;> rintro ⟨y, hy, hz⟩ <;> exact ⟨y, hy, hz.symm⟩
  rw [affineBlowupAlgebra, hgen, ← ht, Submodule.map_span, Algebra.adjoin_span]

/-- A non-zero element of a domain `R` acts as a regular element on a torsion-free `R`-algebra. -/
private lemma isRegular_algebraMap_of_isTorsionFree
    {R A : Type*} [CommRing R] [IsDomain R] [CommRing A] [Algebra R A]
    [Module.IsTorsionFree R A] {π : R} (hπ : π ≠ 0) :
    IsRegular (algebraMap R A π) :=
  ⟨fun _ _ hxy => smul_right_injective A hπ (by simpa only [Algebra.smul_def] using hxy),
    fun _ _ hxy => smul_right_injective A hπ
      (by simpa only [Algebra.smul_def, mul_comm] using hxy)⟩

/-- For `A` torsion-free over a domain `R` and `π ≠ 0`, the map from `A` to the affine blowup
`A[I/π]`, formed inside the localization away from the image of `π`, is injective. -/
private lemma algebraMap_affineBlowup_injective
    {R A : Type*} [CommRing R] [IsDomain R] [CommRing A] [Algebra R A]
    [Module.IsTorsionFree R A] (I : Ideal A) (π : R) (hπ : π ≠ 0) :
    Function.Injective (algebraMap A
      (affineBlowupAlgebra I (algebraMap R A π)
        (Localization.Away (algebraMap R A π)))) := by
  intro x y hxy
  have hloc : algebraMap A (Localization.Away (algebraMap R A π)) x =
      algebraMap A (Localization.Away (algebraMap R A π)) y := congrArg Subtype.val hxy
  obtain ⟨n, hn⟩ := IsLocalization.Away.exists_of_eq (algebraMap R A π) hloc
  apply smul_right_injective A (pow_ne_zero n hπ)
  simpa only [Algebra.smul_def, map_pow] using hn

/-- If `A[1/s]` is smooth over `R` and `s` becomes a unit in a local ring `Λ` receiving `A`,
then `Λ ⊗_A Ω_{A/R}` is a free `Λ`-module. -/
private lemma free_baseChange_differentials_of_smooth_localization
    {R B Λ : Type*} [CommRing R] [CommRing B] [CommRing Λ] [IsLocalRing Λ]
    [Algebra R B] [Algebra B Λ] (s : B) (hs : IsUnit (algebraMap B Λ s))
    [Algebra.Smooth R (Localization.Away s)] :
    Module.Free Λ (Λ ⊗[B] Ω[B⁄R]) := by
  let C := Localization.Away s
  let f : C →+* Λ := IsLocalization.Away.lift s hs
  let : Algebra C Λ := f.toAlgebra
  have : IsScalarTower B C Λ := IsScalarTower.of_algebraMap_eq'
    (IsLocalization.Away.lift_comp s hs).symm
  have : Module.Projective C Ω[C⁄R] := Algebra.FormallySmooth.projective_kaehlerDifferential
  have : Module.Free Λ (Λ ⊗[C] Ω[C⁄R]) := Module.free_of_flat_of_isLocalRing
  let e : (Λ ⊗[B] Ω[B⁄R]) ≃ₗ[Λ] (Λ ⊗[C] Ω[C⁄R]) :=
    (TensorProduct.AlgebraTensorModule.cancelBaseChange B C Λ Λ Ω[B⁄R]).symm.trans
      (LinearEquiv.baseChange C Λ _ _
        (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R B C))
  exact Module.Free.of_equiv e.symm

/-- The affine blowup of a flat algebra over a Dedekind domain is again flat: it is a
torsion-free submodule of a flat localization. -/
private lemma flat_affineBlowupAlgebra
    {R A : Type*} [CommRing R] [IsDedekindDomain R]
    [CommRing A] [Algebra R A] [Module.Flat R A]
    (I : Ideal A) (a : A) :
    Module.Flat R (affineBlowupAlgebra I a (Localization.Away a)) := by
  let B := affineBlowupAlgebra I a (Localization.Away a)
  have : Module.Flat R (Localization.Away a) :=
    Module.Flat.trans R A (Localization.Away a)
  have : Module.IsTorsionFree R B :=
    Function.Injective.moduleIsTorsionFree
      (fun x : B => (x : Localization.Away a)) Subtype.val_injective (fun _ _ => rfl)
  infer_instance

/-! ## Torsion lengths and saturations -/

/-- If an injection `f : M' → M` carries `N'` to a submodule strictly containing `N`, the length
of `M'/N'` is strictly smaller than the length of `M/N`. -/
private lemma length_quotient_lt_of_lt_map
    {R M M' : Type*} [Ring R] [AddCommGroup M] [Module R M]
    [AddCommGroup M'] [Module R M']
    (f : M' →ₗ[R] M) (hf : Function.Injective f)
    (N : Submodule R M) (N' : Submodule R M')
    [IsArtinian R (M ⧸ N)] [IsNoetherian R (M ⧸ N)]
    (h : N < N'.map f) :
    Module.length R (M' ⧸ N') < Module.length R (M ⧸ N) := by
  let g := N'.mapQ (N'.map f) f (Submodule.le_comap_map _ _)
  have hg : Function.Injective g := by
    rw [← LinearMap.ker_eq_bot, Submodule.ker_mapQ,
      Submodule.comap_map_eq_of_injective hf, Submodule.mkQ_map_self]
  have hne : (N'.map f).map N.mkQ ≠ ⊥ := by
    intro heq
    have hle : N'.map f ≤ N := by
      simpa only [Submodule.comap_bot, Submodule.ker_mkQ] using
        (Submodule.map_le_iff_le_comap).mp heq.le
    exact (not_le_of_gt h) hle
  calc
    Module.length R (M' ⧸ N') ≤ Module.length R (M ⧸ N'.map f) :=
      Module.length_le_of_injective g hg
    _ = Module.length R ((M ⧸ N) ⧸ (N'.map f).map N.mkQ) :=
      (Submodule.quotientQuotientEquivQuotient N (N'.map f) h.le).length_eq.symm
    _ < Module.length R (M ⧸ N) :=
      Submodule.length_quotient_lt _ hne

/-- A finite torsion module over a discrete valuation ring has finite length. -/
private lemma isFiniteLength_of_isTorsion
    {R M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (hM : Module.IsTorsion R M) : IsFiniteLength R M := by
  obtain ⟨a, ha, ha0⟩ := Submodule.annihilator_top_inter_nonZeroDivisors hM
  have haM : Module.IsTorsionBy R M a := fun x =>
    (Submodule.mem_annihilator.mp ha) x (Submodule.mem_top)
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, u, hu, he⟩ :=
    IsLocalRing.exists_eq_unit_mul_pow_of_maximalIdeal_eq_span hπ.maximalIdeal_eq
      (mem_nonZeroDivisors_iff_ne_zero.mp ha0)
  have hlen : Module.length R (R ⧸ Ideal.span {a}) = n := by
    rw [he, Ideal.span_singleton_mul_left_unit hu, ← Ideal.span_singleton_pow,
      ← hπ.maximalIdeal_eq]
    exact IsDiscreteValuationRing.length_quotient_pow_maximalIdeal R n
  let I : Ideal R := Ideal.span {a}
  have haI : Module.IsTorsionBySet R M I :=
    (Module.isTorsionBySet_span_singleton_iff a).mpr haM
  let : Module (R ⧸ I) M := haI.module
  let : IsScalarTower R (R ⧸ I) M := haI.isScalarTower
  have : Module.Finite (R ⧸ I) M := Module.Finite.of_restrictScalars_finite R _ _
  have hfin : IsFiniteLength R (R ⧸ I) :=
    Module.length_ne_top_iff.mp (by rw [hlen]; exact ENat.natCast_ne_top _)
  have : IsArtinian R (R ⧸ I) :=
    (isFiniteLength_iff_isNoetherian_isArtinian.mp hfin).2
  have : IsArtinianRing (R ⧸ I) := isArtinian_of_tower R inferInstance
  have : IsArtinian (R ⧸ I) M := inferInstance
  have : IsArtinian R M := isArtinian_of_surjective_algebraMap
    (Ideal.Quotient.mk_surjective (I := I))
  exact isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩

/-- An injective linear map does not decrease the length of the torsion submodule. -/
private lemma torsion_length_le_of_injective
    {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (f : M →ₗ[R] N) (hf : Function.Injective f) :
    Module.length R (Submodule.torsion R M) ≤
      Module.length R (Submodule.torsion R N) := by
  have hmap (x : M) (hx : x ∈ Submodule.torsion R M) : f x ∈ Submodule.torsion R N := by
    obtain ⟨r, hr⟩ := hx
    change (r : R) • x = 0 at hr
    refine ⟨r, ?_⟩
    show (r : R) • f x = 0
    rw [← map_smul, hr, map_zero]
  let g : Submodule.torsion R M →ₗ[R] Submodule.torsion R N :=
    (f.comp (Submodule.torsion R M).subtype).codRestrict _ (fun x => hmap x x.property)
  exact Module.length_le_of_injective g fun x y hxy =>
    Subtype.ext (hf (congrArg Subtype.val hxy))

/-- Isomorphic modules have torsion submodules of equal length. -/
private lemma torsion_length_eq_of_linearEquiv
    {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) :
    Module.length R (Submodule.torsion R M) =
      Module.length R (Submodule.torsion R N) :=
  le_antisymm (torsion_length_le_of_injective e.toLinearMap e.injective)
    (torsion_length_le_of_injective e.symm.toLinearMap e.symm.injective)

/-- The torsion submodule of a finite module over a discrete valuation ring has finite length. -/
private lemma torsion_length_ne_top
    {R M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    Module.length R (Submodule.torsion R M) ≠ ⊤ :=
  Module.length_ne_top_iff.mpr (isFiniteLength_of_isTorsion (Submodule.torsion_isTorsion))

/-- A finite module over a discrete valuation ring is free exactly when its torsion submodule
has length zero. -/
@[ega "0 6.3.4" "more general", sga "3 XV 4.7" "special case"]
lemma torsion_length_toNat_eq_zero_iff_free
    {R M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    (Module.length R (Submodule.torsion R M)).toNat = 0 ↔ Module.Free R M := by
  rw [ENat.toNat_eq_zero, or_iff_left torsion_length_ne_top,
    Module.length_eq_zero_iff, Submodule.subsingleton_iff_eq_bot,
    ← Submodule.isTorsionFree_iff_torsion_eq_bot, Module.free_iff_isTorsionFree]

/-- The saturation of a submodule `N ⊆ M`: the elements of `M` a non-zero scalar multiple of
which lies in `N`, i.e. the preimage of the torsion submodule of `M ⧸ N`. -/
private abbrev torsionSaturation {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] (N : Submodule R M) : Submodule R M :=
  (Submodule.torsion R (M ⧸ N)).comap N.mkQ

/-- Membership in the saturation is divisibility into `N` by a non-zero scalar. -/
private lemma mem_torsionSaturation_iff
    {R M : Type*} [CommRing R] [IsDomain R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) (x : M) :
    x ∈ torsionSaturation N ↔ ∃ r : R, r ≠ 0 ∧ r • x ∈ N := by
  show (∃ r : nonZeroDivisors R, r • N.mkQ x = 0) ↔ _
  constructor
  · rintro ⟨r, hr⟩
    refine ⟨r, nonZeroDivisors.coe_ne_zero r, ?_⟩
    change (r : R) • N.mkQ x = 0 at hr
    exact (Submodule.Quotient.mk_eq_zero N).mp (by
      show N.mkQ ((r : R) • x) = 0
      rw [map_smul]
      exact hr)
  · rintro ⟨r, hr, hx⟩
    exact ⟨⟨r, mem_nonZeroDivisors_of_ne_zero hr⟩, by
      show r • N.mkQ x = 0
      rw [← map_smul]
      exact (Submodule.Quotient.mk_eq_zero N).mpr hx⟩

/-- A submodule is contained in its saturation. -/
private lemma le_torsionSaturation
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) : N ≤ torsionSaturation N :=
  N.le_comap_mkQ _

/-- The torsion submodule of `M ⧸ N` is the quotient of the saturation of `N` by `N`. -/
private noncomputable def torsionSaturationQuotientEquiv
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) :
    (torsionSaturation N ⧸ N.comap (torsionSaturation N).subtype) ≃ₗ[R]
      Submodule.torsion R (M ⧸ N) := by
  let f : torsionSaturation N →ₗ[R] Submodule.torsion R (M ⧸ N) :=
    (N.mkQ.comp (torsionSaturation N).subtype).codRestrict _ (fun x => x.property)
  have hf : Function.Surjective f := by
    intro x
    obtain ⟨y, hy⟩ := N.mkQ_surjective x.val
    refine ⟨⟨y, ?_⟩, Subtype.ext hy⟩
    change N.mkQ y ∈ Submodule.torsion R (M ⧸ N)
    rw [hy]
    exact x.property
  have hk : LinearMap.ker f = N.comap (torsionSaturation N).subtype := by
    ext x
    change f x = 0 ↔ (x : M) ∈ N
    rw [Subtype.ext_iff]
    exact Submodule.Quotient.mk_eq_zero N
  exact (Submodule.quotEquivOfEq _ _ hk.symm).trans (f.quotKerEquivOfSurjective hf)

/-- Saturation is idempotent over a domain. -/
private lemma torsionSaturation_idem
    {R M : Type*} [CommRing R] [IsDomain R] [AddCommGroup M] [Module R M]
    (N : Submodule R M) :
    torsionSaturation (torsionSaturation N) = torsionSaturation N := by
  refine le_antisymm (fun x hx => ?_) (le_torsionSaturation _)
  obtain ⟨r, hr, hx'⟩ := (mem_torsionSaturation_iff _ _).mp hx
  obtain ⟨s, hs, hsr⟩ := (mem_torsionSaturation_iff _ _).mp hx'
  exact (mem_torsionSaturation_iff _ _).mpr
    ⟨s * r, mul_ne_zero hs hr, by simpa only [mul_smul] using hsr⟩

/-- If an injection `f : M' → M` sends the saturation of `N'` into the saturation of `N` and
`N < N'.map f`, the torsion of `M' ⧸ N'` is strictly shorter than that of `M ⧸ N`. -/
private lemma torsion_length_lt_of_lt_map
    {R M M' : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup M'] [Module R M']
    (f : M' →ₗ[R] M) (hf : Function.Injective f)
    (N : Submodule R M) (N' : Submodule R M')
    (hfin : IsFiniteLength R (Submodule.torsion R (M ⧸ N)))
    (hsat : ∀ x ∈ torsionSaturation N', f x ∈ torsionSaturation N)
    (h : N < N'.map f) :
    Module.length R (Submodule.torsion R (M' ⧸ N')) <
      Module.length R (Submodule.torsion R (M ⧸ N)) := by
  let H := torsionSaturation N
  let H' := torsionSaturation N'
  let g : H' →ₗ[R] H := (f.comp H'.subtype).codRestrict H (fun x => hsat x x.property)
  let P := N.comap H.subtype
  let P' := N'.comap H'.subtype
  have hg : Function.Injective g := fun x y hxy => Subtype.ext (hf (congrArg Subtype.val hxy))
  have hP : P < P'.map g := by
    refine lt_iff_le_not_ge.mpr ⟨?_, ?_⟩
    · intro x hx
      obtain ⟨y, hy, hxy⟩ := h.le hx
      exact ⟨⟨y, le_torsionSaturation N' hy⟩, hy, Subtype.ext hxy⟩
    · intro hle
      apply (not_le_of_gt h)
      rintro x ⟨y, hy, rfl⟩
      have hy' : (⟨y, le_torsionSaturation N' hy⟩ : H') ∈ P' := hy
      exact hle (Submodule.mem_map_of_mem hy')
  have hfin' : IsFiniteLength R (H ⧸ P) :=
    hfin.of_injective (torsionSaturationQuotientEquiv N).injective
  obtain ⟨_, _⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp hfin'
  rw [← (torsionSaturationQuotientEquiv N').length_eq,
    ← (torsionSaturationQuotientEquiv N).length_eq]
  exact length_quotient_lt_of_lt_map g hg P P' hP

/-- Saturation is monotone. -/
private lemma torsionSaturation_mono
    {R M : Type*} [CommRing R] [IsDomain R] [AddCommGroup M] [Module R M]
    {N P : Submodule R M} (h : N ≤ P) :
    torsionSaturation N ≤ torsionSaturation P := by
  intro x hx
  obtain ⟨r, hr, hx⟩ := (mem_torsionSaturation_iff N x).mp hx
  exact (mem_torsionSaturation_iff P x).mpr ⟨r, hr, h hx⟩

/-- Saturation commutes with pullback along an injection: the preimage of the saturation of
`N.map f` is the saturation of `N`. -/
private lemma comap_torsionSaturation_map
    {R M M' : Type*} [CommRing R] [IsDomain R] [AddCommGroup M] [Module R M]
    [AddCommGroup M'] [Module R M'] (f : M →ₗ[R] M') (hf : Function.Injective f)
    (N : Submodule R M) :
    (torsionSaturation (N.map f)).comap f = torsionSaturation N := by
  ext x
  show f x ∈ torsionSaturation (N.map f) ↔ x ∈ torsionSaturation N
  rw [mem_torsionSaturation_iff, mem_torsionSaturation_iff]
  constructor
  · rintro ⟨r, hr, y, hy, hxy⟩
    refine ⟨r, hr, ?_⟩
    have he : y = r • x := hf (by simpa only [map_smul] using hxy)
    exact he ▸ hy
  · rintro ⟨r, hr, hx⟩
    exact ⟨r, hr, r • x, hx, map_smul f r x⟩

/-- If an injection `f : M → N` has `π • N ⊆ range f`, there is a map back which composes with
`f` to multiplication by `π` on either side. -/
private lemma exists_mul_inverse_of_injective
    {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (f : M →ₗ[R] N) (hf : Function.Injective f)
    (π : R) (hπ : ∀ y : N, π • y ∈ LinearMap.range f) :
    ∃ g : N →ₗ[R] M, (∀ y, f (g y) = π • y) ∧ ∀ x, g (f x) = π • x := by
  let e := LinearEquiv.ofInjective f hf
  let g : N →ₗ[R] M := e.symm.toLinearMap.comp
    ((π • LinearMap.id : N →ₗ[R] N).codRestrict (LinearMap.range f) hπ)
  have hfg (y : N) : f (g y) = π • y := LinearEquiv.ofInjective_symm_apply f (h := hf) _
  refine ⟨g, hfg, fun x => hf ?_⟩
  rw [hfg, map_smul]

/-- If `f ∘ g` is multiplication by `π`, so is the base change of `f` composed with that of `g`. -/
private lemma baseChange_comp_eq_smul
    {R A M N : Type*} [CommRing R] [CommRing A] [Algebra R A]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) (g : N →ₗ[R] M) (π : R) (hfg : ∀ x, f (g x) = π • x)
    (z : A ⊗[R] N) :
    LinearMap.baseChange A f (LinearMap.baseChange A g z) = algebraMap R A π • z := by
  induction z using TensorProduct.induction_on with
  | zero => simp only [map_zero, smul_zero]
  | add x y hx hy => simp only [map_add, hx, hy, smul_add]
  | tmul a x =>
    rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul, hfg,
      TensorProduct.tmul_smul, algebraMap_smul, TensorProduct.smul_tmul']

/-- A left inverse up to the factor `π` makes the base change of `f` injective whenever `π` acts
regularly on the base-changed source. -/
private lemma baseChange_injective_of_mul_inverse
    {R A M N : Type*} [CommRing R] [CommRing A] [Algebra R A]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (f : M →ₗ[R] N) (g : N →ₗ[R] M) (π : R)
    (hgf : ∀ x, g (f x) = π • x)
    (hπ : IsSMulRegular (A ⊗[R] M) (algebraMap R A π)) :
    Function.Injective (LinearMap.baseChange A f) := by
  intro x y hxy
  apply hπ
  show algebraMap R A π • x = algebraMap R A π • y
  rw [← baseChange_comp_eq_smul g f π hgf, ← baseChange_comp_eq_smul g f π hgf, hxy]

/-- For an exact sequence `M → N → Q` with injective first map and `Q` killed by `π`, the base
change of `M → N` to a domain `A` is injective and admits a section up to the factor `π`. -/
private lemma exists_baseChange_mul_inverse_of_exact
    {R A M N Q : Type*} [CommRing R] [CommRing A] [IsDomain A] [Algebra R A]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup Q] [Module R Q]
    [Module.IsTorsionFree A (A ⊗[R] M)]
    (f : M →ₗ[R] N) (g : N →ₗ[R] Q) (hex : Function.Exact f g)
    (hf : Function.Injective f) (π : R) (hπ : algebraMap R A π ≠ 0)
    (hQ : ∀ x : Q, π • x = 0) :
    ∃ v : (A ⊗[R] N) →ₗ[A] (A ⊗[R] M),
      Function.Injective (LinearMap.baseChange A f) ∧
      ∀ y, LinearMap.baseChange A f (v y) = algebraMap R A π • y := by
  have hπrange (y : N) : π • y ∈ LinearMap.range f :=
    (hex _).mp (by rw [map_smul]; exact hQ _)
  obtain ⟨v, hfv, hvf⟩ := exists_mul_inverse_of_injective f hf π hπrange
  refine ⟨LinearMap.baseChange A v,
    baseChange_injective_of_mul_inverse f v π hvf (smul_right_injective _ hπ), ?_⟩
  exact baseChange_comp_eq_smul f v π hfv

/-- Comparing two lattices across a pair `u`, `v` with `u ∘ v = π`: if `N'` lies in the
saturation of `N.map u` and `N < N'.map v`, the torsion of `M' ⧸ N'` is strictly shorter. -/
private lemma torsion_length_lt_of_lattice_comparison
    {R M M' : Type*} [CommRing R] [IsDomain R]
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M']
    [Module.IsTorsionFree R M']
    (u : M →ₗ[R] M') (v : M' →ₗ[R] M)
    (hu : Function.Injective u) (π : R) (hπ : π ≠ 0)
    (huv : ∀ x, u (v x) = π • x)
    (N : Submodule R M) (N' : Submodule R M')
    (hfin : IsFiniteLength R (Submodule.torsion R (M ⧸ N)))
    (hgen : N' ≤ torsionSaturation (N.map u))
    (hstrict : N < N'.map v) :
    Module.length R (Submodule.torsion R (M' ⧸ N')) <
      Module.length R (Submodule.torsion R (M ⧸ N)) := by
  have hv : Function.Injective v := by
    intro x y hxy
    apply smul_right_injective _ hπ
    simpa only [huv] using congrArg u hxy
  apply torsion_length_lt_of_lt_map v hv N N' hfin ?_ hstrict
  intro x hx
  have hx' : x ∈ torsionSaturation (N.map u) := by
    have := torsionSaturation_mono hgen hx
    rwa [torsionSaturation_idem] at this
  have hπx : u (v x) ∈ torsionSaturation (N.map u) := by
    rw [huv]
    exact (torsionSaturation (N.map u)).smul_mem π hx'
  have : v x ∈ (torsionSaturation (N.map u)).comap u := hπx
  rwa [comap_torsionSaturation_map u hu] at this

/-- Over a discrete valuation ring, a module on which a uniformizer acts regularly is
torsion-free. -/
private lemma isTorsionFree_of_uniformizer_regular
    {R M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [AddCommGroup M] [Module R M] (π : R)
    (hπ : IsLocalRing.maximalIdeal R = Ideal.span ({π} : Set R))
    (hM : IsSMulRegular M π) : Module.IsTorsionFree R M := by
  constructor
  intro r hr
  obtain ⟨n, u, hu, rfl⟩ :=
    IsLocalRing.exists_eq_unit_mul_pow_of_maximalIdeal_eq_span hπ
      (mem_nonZeroDivisors_iff_ne_zero.mp hr.mem_nonZeroDivisors)
  exact (hu.isSMulRegular M).mul (hM.pow n)

/-- A finite quotient `M ⧸ N` over a discrete valuation ring is free as soon as `N` is saturated
with respect to a uniformizer. -/
private lemma free_quotient_of_uniformizer_saturated
    {R M : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [AddCommGroup M] [Module R M] (N : Submodule R M)
    [Module.Finite R (M ⧸ N)] (π : R)
    (hπ : IsLocalRing.maximalIdeal R = Ideal.span ({π} : Set R))
    (hN : ∀ x : M, π • x ∈ N → x ∈ N) : Module.Free R (M ⧸ N) := by
  have hreg : IsSMulRegular (M ⧸ N) π := by
    show Function.Injective (π • LinearMap.id : (M ⧸ N) →ₗ[R] (M ⧸ N))
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨y, rfl⟩ := N.mkQ_surjective x
    exact (Submodule.Quotient.mk_eq_zero N).mpr
      (hN y ((Submodule.Quotient.mk_eq_zero N).mp (by
        show N.mkQ (π • y) = 0
        rw [map_smul]
        exact hx)))
  have := isTorsionFree_of_uniformizer_regular π hπ hreg
  exact Module.free_iff_isTorsionFree.mpr inferInstance

/-- If `M ⧸ N` is not free, the inclusion `N ≤ N'.map v` is strict, provided every `x` with
`π • x ∈ N` has `u x ∈ π • N'`. -/
private lemma lt_map_of_not_free_quotient
    {R M M' : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M']
    (u : M →ₗ[R] M') (v : M' →ₗ[R] M) (hu : Function.Injective u)
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span ({π} : Set R))
    (huv : ∀ x, u (v x) = π • x)
    (N : Submodule R M) (N' : Submodule R M') [Module.Finite R (M ⧸ N)]
    (hle : N ≤ N'.map v)
    (hdiv : ∀ x : M, π • x ∈ N → ∃ y ∈ N', u x = π • y)
    (hnfree : ¬ Module.Free R (M ⧸ N)) : N < N'.map v := by
  refine lt_iff_le_not_ge.mpr ⟨hle, ?_⟩
  intro hge
  apply hnfree
  apply free_quotient_of_uniformizer_saturated N π hπ
  intro x hx
  obtain ⟨y, hy, he⟩ := hdiv x hx
  have hxy : x = v y := hu (he.trans (huv y).symm)
  exact hxy ▸ hge (Submodule.mem_map_of_mem hy)

/-- The natural-number form of the strict drop in torsion length across a lattice
comparison. -/
private lemma torsion_length_toNat_lt_of_lattice_comparison
    {R M M' : Type*} [CommRing R] [IsDomain R]
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M']
    [Module.IsTorsionFree R M']
    (u : M →ₗ[R] M') (v : M' →ₗ[R] M)
    (hu : Function.Injective u) (π : R) (hπ : π ≠ 0)
    (huv : ∀ x, u (v x) = π • x)
    (N : Submodule R M) (N' : Submodule R M')
    (hfin : IsFiniteLength R (Submodule.torsion R (M ⧸ N)))
    (hgen : N' ≤ torsionSaturation (N.map u))
    (hstrict : N < N'.map v) :
    (Module.length R (Submodule.torsion R (M' ⧸ N'))).toNat <
      (Module.length R (Submodule.torsion R (M ⧸ N))).toNat := by
  have h := torsion_length_lt_of_lattice_comparison u v hu π hπ huv N N' hfin hgen hstrict
  have hold := Module.length_ne_top_iff.mpr hfin
  have hnew := ne_top_of_lt h
  rw [← ENat.natCast_toNat hnew, ← ENat.natCast_toNat hold] at h
  exact_mod_cast h

/-! ## Kernels and fractions on an affine blowup chart -/

/-- Two ring maps out of a subalgebra `B` of a localization `A[1/a]` agree as soon as they agree
on `A` and the image of `a` is regular. -/
private lemma ringHom_ext_subalgebra_localization
    {A L D : Type*} [CommRing A] [CommRing L] [CommRing D] [Algebra A L]
    (a : A) [IsLocalization.Away a L] (B : Subalgebra A L)
    (f g : B →+* D) (ha : IsRegular (f (algebraMap A B a)))
    (h : ∀ x : A, f (algebraMap A B x) = g (algebraMap A B x)) : f = g := by
  ext z
  obtain ⟨n, x, hx⟩ := IsLocalization.Away.surj a (z : L)
  have hz : z * algebraMap A B a ^ n = algebraMap A B x := Subtype.ext hx
  apply (ha.pow n).right
  show f z * f (algebraMap A B a) ^ n = g z * f (algebraMap A B a) ^ n
  calc
    f z * f (algebraMap A B a) ^ n = f (algebraMap A B x) := by
      rw [← map_pow, ← map_mul, hz]
    _ = g (algebraMap A B x) := h x
    _ = g z * f (algebraMap A B a) ^ n := by
      rw [h a, ← map_pow, ← map_mul, hz]

/-- An element of the kernel of `C → D`, for `C` a subalgebra of a localization `B[1/a]`
compatible with `B → A ↪ D`, has a numerator in the kernel of `B → A`. -/
private lemma exists_kernel_numerator_subalgebra_localization
    {B L A D : Type*} [CommRing B] [CommRing L] [CommRing A] [CommRing D]
    [Algebra B L] (a : B) [IsLocalization.Away a L] (C : Subalgebra B L)
    (f : B →+* A) (g : C →+* D) (i : A →+* D) (hi : Function.Injective i)
    (h : ∀ x : B, g (algebraMap B C x) = i (f x))
    {z : C} (hz : z ∈ RingHom.ker g) :
    ∃ (n : ℕ) (x : B), x ∈ RingHom.ker f ∧
      algebraMap B C x = algebraMap B C a ^ n * z := by
  obtain ⟨n, x, hx⟩ := IsLocalization.Away.surj a (z : L)
  have he : z * algebraMap B C a ^ n = algebraMap B C x := Subtype.ext hx
  refine ⟨n, x, ?_, by rw [← he, mul_comm]⟩
  apply hi
  rw [map_zero, ← h x, ← he, map_mul]
  show g z * _ = 0
  rw [show g z = 0 from hz, zero_mul]

/-- A surjection `A → B` of `R`-algebras induces a surjection of affine blowup charts
`A[f^{-1}J/a] → B[J/b]` when `a` maps to `b`. -/
private lemma exists_surjective_affineBlowup_map
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (f : A →ₐ[R] B) (hf : Function.Surjective f)
    (J : Ideal B) (I : Ideal A) (hI : I = J.comap f) (a : A) (b : B) (hab : f a = b) :
    ∃ F : affineBlowupAlgebra I a (Localization.Away a) →ₐ[R]
        affineBlowupAlgebra J b (Localization.Away b),
      Function.Surjective F ∧ ∀ x : A,
        F (algebraMap A _ x) = algebraMap B _ (f x) := by
  subst hI
  let A' := affineBlowupAlgebra (J.comap f) a (Localization.Away a)
  let B' := affineBlowupAlgebra J b (Localization.Away b)
  have hy : Submonoid.powers a ≤ (Submonoid.powers b).comap f.toRingHom := by
    rintro x ⟨n, rfl⟩
    refine ⟨n, ?_⟩
    show b ^ n = f (a ^ n)
    rw [map_pow, hab]
  let fL : Localization.Away a →ₐ[R] Localization.Away b :=
    { toRingHom := IsLocalization.map (Localization.Away b) f.toRingHom hy
      commutes' := fun r => by
        show IsLocalization.map (Localization.Away b) f.toRingHom hy
          (algebraMap R (Localization.Away a) r) = _
        rw [IsScalarTower.algebraMap_apply R A (Localization.Away a),
          IsLocalization.map_eq]
        show algebraMap B (Localization.Away b) (f (algebraMap R A r)) = _
        rw [f.commutes, ← IsScalarTower.algebraMap_apply R B (Localization.Away b)] }
  have hmap (x : A) : fL (algebraMap A (Localization.Away a) x) =
      algebraMap B (Localization.Away b) (f x) := IsLocalization.map_eq hy x
  have hfrac (x : A) :
      fL (IsLocalization.mk' (Localization.Away a) x ⟨a, Submonoid.mem_powers a⟩) =
        IsLocalization.mk' (Localization.Away b) (f x) ⟨b, Submonoid.mem_powers b⟩ := by
    show IsLocalization.map (Localization.Away b) f.toRingHom hy _ = _
    rw [IsLocalization.map_mk']
    congr 1
    exact Subtype.ext hab
  have hmem (z : Localization.Away a) (hz : z ∈ A') : fL z ∈ B' := by
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨x, hx, rfl⟩ := hz
      rw [hfrac]
      exact Algebra.subset_adjoin ⟨f x, hx, rfl⟩
    | algebraMap x =>
      rw [hmap]
      exact B'.algebraMap_mem _
    | add x y hx hy hx' hy' =>
      rw [map_add]
      exact B'.add_mem hx' hy'
    | mul x y hx hy hx' hy' =>
      rw [map_mul]
      exact B'.mul_mem hx' hy'
  let F : A' →ₐ[R] B' :=
    (fL.comp (A'.val.restrictScalars R)).codRestrict (B'.restrictScalars R)
      (fun z => hmem z z.property)
  refine ⟨F, ?_, fun x => Subtype.ext (hmap x)⟩
  rintro ⟨z, hz⟩
  have hsurj : ∃ x : A', (F x : Localization.Away b) = z := by
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨y, hy, rfl⟩ := hz
      obtain ⟨x, rfl⟩ := hf y
      exact ⟨⟨IsLocalization.mk' (Localization.Away a) x
        ⟨a, Submonoid.mem_powers a⟩, Algebra.subset_adjoin ⟨x, hy, rfl⟩⟩, hfrac x⟩
    | algebraMap y =>
      obtain ⟨x, rfl⟩ := hf y
      exact ⟨algebraMap A A' x, hmap x⟩
    | add x y hx hy hx' hy' =>
      obtain ⟨x', rfl⟩ := hx'
      obtain ⟨y', rfl⟩ := hy'
      exact ⟨x' + y', by simp only [map_add, Subalgebra.coe_add]⟩
    | mul x y hx hy hx' hy' =>
      obtain ⟨x', rfl⟩ := hx'
      obtain ⟨y', rfl⟩ := hy'
      exact ⟨x' * y', by simp only [map_mul, Subalgebra.coe_mul]⟩
  exact hsurj.imp fun _ hx => Subtype.ext hx

/-- An element of the ideal `I` becomes divisible by the denominator in the affine blowup
`A[I/a]`. -/
private lemma map_ideal_le_span_affineBlowup
    {A : Type*} [CommRing A] (I : Ideal A) (a : A) :
    Ideal.map (algebraMap A (affineBlowupAlgebra I a (Localization.Away a))) I ≤
      Ideal.span {algebraMap A (affineBlowupAlgebra I a (Localization.Away a)) a} := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  exact Ideal.mem_span_singleton.mpr ⟨⟨IsLocalization.mk' (Localization.Away a) x
    ⟨a, Submonoid.mem_powers a⟩, Algebra.subset_adjoin ⟨x, hx, rfl⟩⟩, Subtype.ext
      (IsLocalization.mk'_spec' (Localization.Away a) x ⟨a, Submonoid.mem_powers a⟩).symm⟩

/-- If `J` becomes divisible by `π` in `B'` and `g ∈ J^n` dies in `C`, then the image of `g` is
`π^n` times an element of the kernel of `B' → C`. -/
private lemma exists_kernel_division_of_mem_pow
    {B B' C : Type*} [CommRing B] [CommRing B'] [CommRing C]
    (j : B →+* B') (φ : B' →+* C) (J : Ideal B) (π : B')
    (hπ : IsRegular (φ π)) (hJ : Ideal.map j J ≤ Ideal.span {π})
    (n : ℕ) {g : B} (hg : g ∈ J ^ n) (hg0 : φ (j g) = 0) :
    ∃ g' ∈ RingHom.ker φ, j g = π ^ n * g' := by
  have hmap : Ideal.map j (J ^ n) ≤ Ideal.span {π ^ n} := by
    rw [Ideal.map_pow, ← Ideal.span_singleton_pow]
    exact pow_le_pow_left' hJ n
  obtain ⟨g', he⟩ := Ideal.mem_span_singleton.mp (hmap (Ideal.mem_map_of_mem j hg))
  refine ⟨g', ?_, he⟩
  show φ g' = 0
  apply (hπ.pow n).left
  show (φ π) ^ n * φ g' = (φ π) ^ n * 0
  rw [mul_zero, ← map_pow, ← map_mul, ← he, hg0]

/-- The differential of an element of `𝔭^n` dying in `C` is `π^n` times the differential of an
element of the kernel of `B' → C`. -/
private lemma exists_tensor_differential_division_of_kernel_mem_pow
    {R B B' C Λ : Type*} [CommRing R] [CommRing B] [CommRing B']
    [CommRing C] [CommRing Λ] [Algebra R B'] [Algebra B B']
    [Algebra B' Λ] [Algebra R Λ] [IsScalarTower R B' Λ]
    (φ : B' →+* C) (p : Ideal B) (π : R)
    (hπ : IsRegular (φ (algebraMap R B' π)))
    (hp : Ideal.map (algebraMap B B') p ≤ Ideal.span {algebraMap R B' π})
    (n : ℕ) {z : B} (hz : z ∈ p ^ n) (hz0 : φ (algebraMap B B' z) = 0) :
    ∃ y ∈ RingHom.ker φ,
      (1 : Λ) ⊗ₜ[B'] KaehlerDifferential.D R B' (algebraMap B B' z) =
        algebraMap R Λ π ^ n • ((1 : Λ) ⊗ₜ[B'] KaehlerDifferential.D R B' y) := by
  obtain ⟨y, hy, he⟩ := exists_kernel_division_of_mem_pow
    (algebraMap B B') φ p (algebraMap R B' π) hπ hp n hz hz0
  refine ⟨y, hy, ?_⟩
  rw [he, ← map_pow, Derivation.leibniz, Derivation.map_algebraMap,
    smul_zero, add_zero, TensorProduct.tmul_smul]
  simp only [Algebra.smul_def, map_pow, mul_one,
    ← IsScalarTower.algebraMap_apply, TensorProduct.smul_tmul']

/-- Let `f : P → A` be a surjection of `R`-algebras with `A` flat over a Dedekind domain `R`,
let `π ≠ 0`, and let `pP` be the inverse image of an ideal `pA ⊆ A`. The induced map
`F : P[pP/π] → A[pA/π]` of affine blowup charts is surjective, and the two kernels determine
each other: an element of `Ker f` becomes `π` times an element of `Ker F`, and an element of
`Ker F` has a `π`-power multiple coming from `Ker f`. -/
private lemma exists_surjective_affineBlowup_map_kernel_division
    {R A P : Type*} [CommRing R] [IsDedekindDomain R] [CommRing A] [CommRing P]
    [Algebra R A] [Algebra R P] [Module.Flat R A]
    (f : P →ₐ[R] A) (hf : Function.Surjective f) (pA : Ideal A) (pP : Ideal P)
    (hpP : pP = pA.comap f) (π : R) (hπ : π ≠ 0) :
    ∃ F : affineBlowupAlgebra pP (algebraMap R P π)
          (Localization.Away (algebraMap R P π)) →ₐ[R]
        affineBlowupAlgebra pA (algebraMap R A π)
          (Localization.Away (algebraMap R A π)),
      Function.Surjective F ∧
        (∀ x : P, F (algebraMap P _ x) = algebraMap A _ (f x)) ∧
        (∀ x ∈ RingHom.ker f.toRingHom, ∃ y ∈ RingHom.ker F.toRingHom,
          algebraMap P _ x = algebraMap R _ π * y) ∧
        ∀ x ∈ RingHom.ker F.toRingHom, ∃ (k : ℕ) (y : P),
          y ∈ RingHom.ker f.toRingHom ∧
            algebraMap P _ y = (algebraMap R _ π) ^ k * x := by
  subst hpP
  obtain ⟨F, hF, hFcomp⟩ :=
    exists_surjective_affineBlowup_map f hf pA (pA.comap f) rfl (algebraMap R P π)
      (algebraMap R A π) (f.commutes π)
  let A' := affineBlowupAlgebra pA (algebraMap R A π)
    (Localization.Away (algebraMap R A π))
  let P' := affineBlowupAlgebra (pA.comap f) (algebraMap R P π)
    (Localization.Away (algebraMap R P π))
  have : Module.Flat R A' := flat_affineBlowupAlgebra pA _
  have : Module.IsTorsionFree R A' := Module.Flat.isTorsionFree
  have hFreg : IsRegular (F (algebraMap R P' π)) := by
    rw [show F (algebraMap R P' π) = algebraMap R A' π from F.commutes π]
    exact isRegular_algebraMap_of_isTorsionFree hπ
  have hmapI : Ideal.map (algebraMap P P') (RingHom.ker f.toRingHom) ≤
      Ideal.span {algebraMap R P' π} := by
    apply le_trans (Ideal.map_mono ?_) (map_ideal_le_span_affineBlowup (pA.comap f) _)
    intro x hx
    show f x ∈ pA
    rw [show f x = 0 from hx]
    exact pA.zero_mem
  have hj : Function.Injective (algebraMap A A') :=
    algebraMap_affineBlowup_injective pA π hπ
  refine ⟨F, hF, hFcomp, ?_, ?_⟩
  · intro x hx
    obtain ⟨y, hy, he⟩ := exists_kernel_division_of_mem_pow (algebraMap P P')
      F.toRingHom (RingHom.ker f.toRingHom) (algebraMap R P' π) hFreg hmapI 1
      (by simpa using hx) (by
        show F (algebraMap P P' x) = 0
        rw [show F (algebraMap P P' x) = algebraMap A A' (f x) from hFcomp x,
          show f x = 0 from hx]
        exact map_zero _)
    exact ⟨y, hy, by simpa using he⟩
  · intro x hx
    obtain ⟨k, y, hy, he⟩ := exists_kernel_numerator_subalgebra_localization
      (algebraMap R P π) P' f.toRingHom F.toRingHom (algebraMap A A') hj
      (fun z => hFcomp z) hx
    exact ⟨k, y, hy, by
      simpa only [map_pow, ← IsScalarTower.algebraMap_apply R P P' π] using he⟩

end Stacks.Smoothing

