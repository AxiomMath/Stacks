/-!
# The desingularization lemma

Let `R` be a Noetherian ring, let `Λ` be an `R`-algebra and let `π ∈ R` be an element whose
annihilator in `Λ` does not change upon squaring. Let `A` be an `R`-algebra of finite
presentation equipped with an `R`-algebra map `A → Λ`. If the image of `π` in `A` is strictly
standard over `R`, and if the map `A → Λ` is compatible with a retraction `A/π⁴A → R/π⁴R`, then
`A → Λ` factors as `A → B → Λ` through an `R`-algebra `B` of finite presentation whose singular
ideal `H_{B/R}` contains the extension of `𝔞 = Ann_R (Ann_R (π²) / Ann_R (π))`.

The algebra `B` is explicit. Choose a presentation `A = R[x_1, …, x_n]/(f_1, …, f_m)` and a
`c ≤ m` exhibiting `π` as strictly standard. The retraction lets one assume that each `x_i` is
sent to a constant `r_i` modulo `π⁴`, and the strictly standard equation then produces a
`c × n` matrix `s` over `R` inverting, modulo `π⁴`, the Jacobian of the first `c` relations at
`r`. Substituting `x_i ↦ r_i + π² ∑_k s_{ki} y_k + π³ z_i` into the relations divides the first
`c` of them by `π³`, with quotients `g_1, …, g_c` that are, modulo `π`, the linear forms
`y_j + ∑_i (∂f_j/∂x_i)(r) z_i`; the algebra `B` is the quotient of `R[y, z]` by the substituted
relations together with the `g_j`. The map `A → B` comes from the substitution and the map
`B → Λ` from `y ↦ 0`, `z ↦ π λ`.

Smoothness of `R → B` is checked at each prime `𝔮` avoiding the extension of `𝔞`, in two cases.
If `π` is invertible at `𝔮` the substitution lifts along square-zero extensions because `π` is
strictly standard in `A`. If `π` lies in `𝔮` then the linear shape of the `g_j` makes
`R[y, z]/(g)` smooth at `𝔮`, while the standardness condition gives `π · I ⊆ I²` for the ideal
`I` generated by the substituted relations; the Nakayama lemma then forces `I` to vanish in the
local ring, so `B` agrees there with `R[y, z]/(g)`.

## Main definitions

* `Stacks.Smoothing.annihilatorDefectIdeal`: the ideal `Ann_R (Ann_R (π²) / Ann_R (π))`
  measuring the failure of `Ann_R (π) = Ann_R (π²)`.

## Main results

* `Stacks.Smoothing.exists_finitePresentation_factorization_singularIdeal`: the desingularizing
  factorization `A → B → Λ`.

## Implementation notes

The retraction modulo `π⁴` is recorded as an `R`-algebra map `A/π⁴A → R/π⁴R`. Being an
`R`-algebra map is exactly its being a section of `R/π⁴R → A/π⁴A`, since the only `R`-algebra
endomorphism of `R/π⁴R` is the identity; compatibility with the maps to `Λ/π⁴Λ` is stated on
representatives.

The algebra `B` is produced in the universe of `R`, which is where the construction naturally
lives: it is a quotient of a polynomial ring over `R`. A consumer needing `B` in a larger
universe can transport it along `ULift.algEquiv`.

## References

* [Stacks Project, Tag 07CR](https://stacks.math.columbia.edu/tag/07CR)
* [Stacks Project, Tag 07C5](https://stacks.math.columbia.edu/tag/07C5)
* [Stacks Project, Tag 07CA](https://stacks.math.columbia.edu/tag/07CA)
-/

@[expose] public section

open MvPolynomial

namespace Stacks.Smoothing

universe u v w

/-! ### The annihilator defect ideal -/

/-- The ideal `𝔞 = Ann_R (Ann_R (π²) / Ann_R (π))`, which measures the failure of the
annihilator of `π` to agree with the annihilator of `π²`. It is the unit ideal exactly when the
two annihilators coincide. -/
def annihilatorDefectIdeal (R : Type*) [CommRing R] (π : R) : Ideal R :=
  (Submodule.span R {π}).annihilator.colon ((Submodule.span R {π ^ 2}).annihilator : Set R)

/-- An element lies in `annihilatorDefectIdeal R π` exactly when it carries the annihilator of
`π²` into the annihilator of `π`. -/
theorem mem_annihilatorDefectIdeal_iff {R : Type*} [CommRing R] (π r : R) :
    r ∈ annihilatorDefectIdeal R π ↔
      ∀ y ∈ (Submodule.span R {π ^ 2}).annihilator,
        r * y ∈ (Submodule.span R {π}).annihilator := by
  simp only [annihilatorDefectIdeal, Submodule.mem_colon, SetLike.mem_coe, smul_eq_mul]

/-- If the annihilators of `π` and `π²` agree, then `π² x = 0` already forces `π x = 0`. -/
private theorem mul_eq_zero_of_sq_mul_eq_zero (Λ : Type*) [CommRing Λ] (π x : Λ)
    (hAnn : (Submodule.span Λ {π}).annihilator = (Submodule.span Λ {π ^ 2}).annihilator)
    (h : π ^ 2 * x = 0) : π * x = 0 := by
  have hx : x ∈ (Submodule.span Λ {π ^ 2}).annihilator := by
    simpa only [Submodule.mem_annihilator_span_singleton, smul_eq_mul, mul_comm] using h
  rw [← hAnn, Submodule.mem_annihilator_span_singleton, smul_eq_mul] at hx
  exact mul_comm x π ▸ hx

/-- A multiple of `π` killed by `π³` is zero, when the annihilators of `π` and `π²` agree. -/
private theorem eq_zero_of_eq_mul_of_pow_three_mul_eq_zero (Λ : Type*) [CommRing Λ] (π t y : Λ)
    (hAnn : (Submodule.span Λ {π}).annihilator = (Submodule.span Λ {π ^ 2}).annihilator)
    (ht : t = π * y) (h : π ^ 3 * t = 0) : t = 0 := by
  have h4 : π ^ 4 * y = 0 := by simpa [ht, pow_succ, mul_assoc] using h
  have h3' : π * (π ^ 2 * y) = 0 :=
    mul_eq_zero_of_sq_mul_eq_zero Λ π (π ^ 2 * y) hAnn (by
      simpa [pow_succ, mul_assoc] using h4)
  have h3 : π ^ 3 * y = 0 := by simpa [pow_succ, mul_assoc] using h3'
  have h2' : π * (π * y) = 0 :=
    mul_eq_zero_of_sq_mul_eq_zero Λ π (π * y) hAnn (by
      simpa [pow_succ, mul_assoc] using h3)
  have h2 : π ^ 2 * y = 0 := by simpa [pow_succ, mul_assoc] using h2'
  rw [ht, mul_eq_zero_of_sq_mul_eq_zero Λ π y hAnn h2]

/-- An element of the defect ideal kills `Ann(π²)/Ann(π)` in every flat module: if `π² x = 0`
in a flat `R`-module `M` and `r ∈ 𝔞`, then `r π x = 0`. -/
private theorem defect_mul_smul_eq_zero_of_flat {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [Module.Flat R M] (π r : R) (hr : r ∈ annihilatorDefectIdeal R π) (x : M)
    (hx : π ^ 2 • x = 0) : (r * π) • x = 0 := by
  obtain ⟨k, a, y, hxy, ha⟩ :=
    Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (f := fun _ : Unit => π ^ 2) (x := fun _ : Unit => x) (by simpa using hx)
  dsimp only at hxy ha
  rw [hxy ()]
  simp only [Finset.smul_sum, smul_smul]
  refine Finset.sum_eq_zero fun j _ => ?_
  have hj : a () j ∈ (Submodule.span R {π ^ 2}).annihilator := by
    rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]
    simpa [mul_comm] using ha j
  have hz := (mem_annihilatorDefectIdeal_iff π r).mp hr _ hj
  rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul] at hz
  have hzero : r * π * a () j = 0 := by convert hz using 1; ring
  rw [hzero, zero_smul]

/-- In a flat `R`-algebra in which some element of the defect ideal is invertible, `π² x = 0`
forces `π x = 0`. -/
private theorem mul_eq_zero_of_sq_mul_eq_zero_of_flat {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] (π r : R) (hr : r ∈ annihilatorDefectIdeal R π)
    (hu : IsUnit (algebraMap R S r)) (x : S) (hx : (algebraMap R S π) ^ 2 * x = 0) :
    algebraMap R S π * x = 0 := by
  have hx' : π ^ 2 • x = 0 := by simpa [Algebra.smul_def] using hx
  have hz := defect_mul_smul_eq_zero_of_flat π r hr x hx'
  rw [Algebra.smul_def, map_mul, mul_assoc] at hz
  exact (hu.mul_right_eq_zero).mp hz

/-! ### A presentation adapted to a strictly standard element -/

/-- The surjection `R[x_1, …, x_n] → A` attached to a presentation, as an `R`-algebra map. -/
private noncomputable abbrev presentationHom {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] (P : Presentation R A) : MvPolynomial (Fin P.n) R →ₐ[R] A :=
  P.iso.symm.toAlgHom.comp (Ideal.Quotient.mkₐ R (Ideal.span (Set.range P.f)))

private theorem presentationHom_relation {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (P : Presentation R A) (j : Fin P.m) : presentationHom P (P.f j) = 0 := by
  change P.iso.symm (Ideal.Quotient.mk _ (P.f j)) = 0
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self j)), map_zero]

/-- A strictly standard element `a` has a presentation together with a matrix that, after
multiplication by `a`, inverts the Jacobian matrix of the first `c` relations on the left. -/
private theorem exists_presentation_matrix_of_isStrictlyStandard
    (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]
    (a : A) (ha : IsStrictlyStandard (R := R) a) :
    ∃ (P : Presentation R A) (c : ℕ) (hcm : c ≤ P.m) (B : Matrix (Fin c) (Fin P.n) A),
      (∀ k j, ∑ i, B k i * P.lift (pderiv i (P.f (Fin.castLE hcm j))) =
        if k = j then a else 0) ∧ P.StandardCond2 a c hcm := by
  classical
  obtain ⟨P, c, -, hcm, hstd⟩ := ha
  obtain ⟨ψ, hψ⟩ := exists_comp_eq_lsmul_of_eq_sum_jacobianMinor P a c hcm hstd.1
  have hB : LinearMap.toMatrix' ψ * jacobianMatrix P c hcm = a • 1 := by
    calc LinearMap.toMatrix' ψ * jacobianMatrix P c hcm
        = LinearMap.toMatrix' ((LinearMap.lsmul A (Fin c → A)) a) := by
          simpa [LinearMap.toMatrix'_comp] using congrArg LinearMap.toMatrix' hψ
      _ = a • 1 := by
          ext i j
          by_cases hij : i = j <;> simp [LinearMap.toMatrix'_apply, hij]
  refine ⟨P, c, hcm, LinearMap.toMatrix' ψ, fun k j => ?_, hstd.2⟩
  have h := congrFun (congrFun hB k) j
  rw [Matrix.mul_apply] at h
  simpa only [jacobianMatrix, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, mul_ite,
    mul_one, mul_zero] using h

/-! ### Lifting the retraction and the Jacobian inverse to `R` -/

/-- A retraction `A/π⁴A → R/π⁴R` compatible with the map to `Λ/π⁴Λ` lifts the images of the
variables of a presentation to elements `r_i ∈ R`: the relations evaluate into `π⁴R` at `r`, and
the map to `Λ` sends the `i`-th variable to `r_i` up to `π⁴`. -/
private theorem exists_presentation_section_lifts
    {R A Λ : Type*} [CommRing R] [CommRing A] [CommRing Λ] [Algebra R A] [Algebra R Λ]
    (P : Presentation R A) (π : R) (f : A →ₐ[R] Λ)
    (ρ : (A ⧸ Ideal.span {(algebraMap R A π) ^ 4}) →ₐ[R] (R ⧸ Ideal.span {π ^ 4}))
    (hρ : ∀ (x : A) (r : R),
      ρ (Ideal.Quotient.mk (Ideal.span {(algebraMap R A π) ^ 4}) x) =
          Ideal.Quotient.mk (Ideal.span {π ^ 4}) r →
        Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 4}) (f x) =
          Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 4}) (algebraMap R Λ r)) :
    ∃ (r : Fin P.n → R) (l : Fin P.n → Λ),
      (∀ p, ρ (Ideal.Quotient.mk (Ideal.span {(algebraMap R A π) ^ 4}) (P.lift p)) =
        Ideal.Quotient.mk (Ideal.span {π ^ 4}) (eval r p)) ∧
      (∀ j, eval r (P.f j) ∈ Ideal.span {π ^ 4}) ∧
      (∀ i, f (P.lift (X i)) = algebraMap R Λ (r i) + (algebraMap R Λ π) ^ 4 * l i) := by
  classical
  let qA := Ideal.Quotient.mkₐ R (Ideal.span {(algebraMap R A π) ^ 4})
  let qR := Ideal.Quotient.mk (Ideal.span {π ^ 4})
  let e := (ρ.comp qA).comp (presentationHom P)
  choose r hr using fun i : Fin P.n => Ideal.Quotient.mk_surjective (e (X i))
  have he : e.toRingHom = qR.comp (eval r) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [qR]
    · intro i
      simpa [qR] using (hr i).symm
  have heval (p) : ρ (qA (P.lift p)) = qR (eval r p) := DFunLike.congr_fun he p
  have hrel (j) : eval r (P.f j) ∈ Ideal.span {π ^ 4} := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [← heval]
    change ρ (qA (presentationHom P (P.f j))) = 0
    rw [presentationHom_relation, map_zero, map_zero]
  have hl (i : Fin P.n) : ∃ l : Λ,
      f (P.lift (X i)) = algebraMap R Λ (r i) + (algebraMap R Λ π) ^ 4 * l := by
    have h := hρ (P.lift (X i)) (r i) (by simpa [qA, qR] using heval (X i))
    have hm : f (P.lift (X i)) - algebraMap R Λ (r i) ∈
        Ideal.span {(algebraMap R Λ π) ^ 4} := Ideal.Quotient.eq.mp h
    obtain ⟨l, hl⟩ := Ideal.mem_span_singleton.mp hm
    exact ⟨l, by rw [← hl]; ring⟩
  choose l hl using hl
  exact ⟨r, l, heval, hrel, hl⟩

/-- The left inverse to the Jacobian matrix descends, modulo `π⁴`, to a matrix over `R`
evaluated at the lifted variables. -/
private theorem exists_jacobian_matrix_lifts {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] (P : Presentation R A) (π : R) (c : ℕ) (hcm : c ≤ P.m)
    (B : Matrix (Fin c) (Fin P.n) A)
    (hB : ∀ k j, ∑ i, B k i * P.lift (pderiv i (P.f (Fin.castLE hcm j))) =
      if k = j then algebraMap R A π else 0)
    (e : A →ₐ[R] R ⧸ Ideal.span {π ^ 4}) (r : Fin P.n → R)
    (he : ∀ p, e (P.lift p) = Ideal.Quotient.mk (Ideal.span {π ^ 4}) (eval r p)) :
    ∃ s : Matrix (Fin c) (Fin P.n) R, ∀ k j,
      (∑ i, s k i * eval r (pderiv i (P.f (Fin.castLE hcm j)))) - (if k = j then π else 0) ∈
        Ideal.span {π ^ 4} := by
  classical
  let q := Ideal.Quotient.mk (Ideal.span {π ^ 4})
  choose s hs using fun k i => Ideal.Quotient.mk_surjective (e (B k i))
  refine ⟨s, fun k j => ?_⟩
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q _ = 0
  rw [map_sub, sub_eq_zero, map_sum]
  have h := congrArg e (hB k j)
  simp only [map_sum, map_mul, he] at h
  simpa only [map_mul, hs, apply_ite e, map_zero, e.commutes, apply_ite q, q,
    Ideal.Quotient.algebraMap_eq] using h

/-! ### First-order expansion along a square-zero deformation -/

/-- Evaluation at `r + z`, where the increments `z` multiply to zero, is the first-order Taylor
expansion of evaluation at `r`. -/
private theorem eval₂Hom_firstOrder (R : Type u) (T : Type v) (n : ℕ) [CommRing R] [CommRing T]
    (φ : R →+* T) (r z : Fin n → T) (hz : ∀ i j, z i * z j = 0) (p : MvPolynomial (Fin n) R) :
    eval₂Hom φ (fun i => r i + z i) p =
      eval₂Hom φ r p + ∑ i : Fin n, eval₂Hom φ r (pderiv i p) * z i := by
  classical
  let E : MvPolynomial (Fin n) R →+* T := eval₂Hom φ r
  let Ez : MvPolynomial (Fin n) R →+* T := eval₂Hom φ (fun i => r i + z i)
  let D := fun q : MvPolynomial (Fin n) R => ∑ i : Fin n, E (pderiv i q) * z i
  change Ez p = E p + D p
  induction p using MvPolynomial.induction_on with
  | C a => simp [E, Ez, D]
  | add p q hp hq =>
      rw [Ez.map_add, hp, hq, E.map_add]
      have hD : D (p + q) = D p + D q := by
        dsimp [D]
        simp only [map_add, E.map_add]
        simp_rw [add_mul]
        rw [Finset.sum_add_distrib]
      rw [hD]
      ring
  | mul_X p i hp =>
      have hcross : D p * z i = 0 := by
        dsimp [D]
        rw [Finset.sum_mul]
        refine Finset.sum_eq_zero fun j _ => ?_
        rw [mul_assoc, hz j i, mul_zero]
      have hderiv (j : Fin n) :
          E (pderiv j (p * X i)) = E (pderiv j p) * r i + E p * (if j = i then 1 else 0) := by
        rw [MvPolynomial.pderiv_mul, E.map_add, E.map_mul, E.map_mul, eval₂Hom_X']
        by_cases h : j = i <;> simp [h, MvPolynomial.pderiv_X]
      have hDmul : D (p * X i) = D p * r i + E p * z i := by
        dsimp [D]
        calc
          (∑ j : Fin n, E (pderiv j (p * X i)) * z j) =
              ∑ j : Fin n, (E (pderiv j p) * r i + E p * (if j = i then 1 else 0)) * z j :=
                Finset.sum_congr rfl fun j _ => by rw [hderiv j]
          _ = (∑ j : Fin n, E (pderiv j p) * z j) * r i + E p * z i := by
                simp_rw [add_mul]
                rw [Finset.sum_add_distrib]
                have hfirst : (∑ j : Fin n, (E (pderiv j p) * r i) * z j) =
                    (∑ j : Fin n, E (pderiv j p) * z j) * r i := by
                  calc
                    _ = ∑ j : Fin n, (E (pderiv j p) * z j) * r i :=
                      Finset.sum_congr rfl fun j _ => by ring
                    _ = _ := by rw [Finset.sum_mul]
                have hsecond :
                    (∑ j : Fin n, (E p * (if j = i then 1 else 0)) * z j) = E p * z i := by
                  simp [eq_comm]
                rw [hfirst, hsecond]
      have hEX : E (X i) = r i := eval₂Hom_X' φ r i
      have hEzX : Ez (X i) = r i + z i := eval₂Hom_X' φ (fun k => r k + z k) i
      rw [Ez.map_mul, hp, E.map_mul, hEzX, hEX, hDmul]
      calc
        (E p + D p) * (r i + z i) = E p * r i + D p * r i + E p * z i := by
          simp only [mul_add, add_mul]
          rw [hcross]
          simp only [add_zero]
        _ = E p * r i + (D p * r i + E p * z i) := by ring

/-- The first-order expansion, with the increments only required to multiply into an ideal. -/
private theorem eval₂Hom_firstOrder_mod {R S : Type*} [CommRing R] [CommRing S] (n : ℕ)
    (φ : R →+* S) (r z : Fin n → S) (I : Ideal S) (hz : ∀ i j, z i * z j ∈ I)
    (p : MvPolynomial (Fin n) R) :
    eval₂Hom φ (fun i => r i + z i) p -
      (eval₂Hom φ r p + ∑ i, eval₂Hom φ r (pderiv i p) * z i) ∈ I := by
  let q := Ideal.Quotient.mk I
  have heval (a : Fin n → S) (p : MvPolynomial (Fin n) R) :
      q (eval₂Hom φ a p) = eval₂Hom (q.comp φ) (fun i => q (a i)) p :=
    RingHom.congr_fun (MvPolynomial.comp_eval₂Hom φ a q) p
  have hzQ (i j : Fin n) : q (z i) * q (z j) = 0 := by
    rw [← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hz i j)
  have hTaylor := eval₂Hom_firstOrder R (S ⧸ I) n (q.comp φ) (fun i => q (r i))
    (fun i => q (z i)) hzQ p
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q _ = 0
  simp only [map_sub, map_add, map_sum, map_mul, heval]
  simpa only [map_add, sub_eq_zero] using hTaylor

/-! ### Dividing the first `c` relations by `π³` -/

/-- Substituting `r_i + a² ∑_k s_{ki} v_k + a³ w_i` into a polynomial whose value at `r` lies in
`(a⁴)` and whose Jacobian is inverted by `s` modulo `(a⁴)` produces a multiple of `a³`, with
cofactor congruent to `v_j + ∑_i (∂p/∂x_i)(r) w_i` modulo `(a)`. -/
private theorem exists_divided_relation {R S : Type*} [CommRing R] [CommRing S] (n c : ℕ)
    (φ : R →+* S) (r : Fin n → S) (a : S) (s : Fin c → Fin n → S) (v : Fin c → S) (w : Fin n → S)
    (p : MvPolynomial (Fin n) R) (j : Fin c)
    (hconst : eval₂Hom φ r p ∈ Ideal.span {a ^ 4})
    (hs : ∀ k, (∑ i, s k i * eval₂Hom φ r (pderiv i p)) - (if k = j then a else 0) ∈
      Ideal.span {a ^ 4}) :
    ∃ g : S,
      eval₂Hom φ (fun i => r i + (a ^ 2 * ∑ k, s k i * v k + a ^ 3 * w i)) p = a ^ 3 * g ∧
      g - (v j + ∑ i, eval₂Hom φ r (pderiv i p) * w i) ∈ Ideal.span {a} := by
  classical
  let I : Ideal S := Ideal.span {a ^ 4}
  let d (i : Fin n) := eval₂Hom φ r (pderiv i p)
  let z (i : Fin n) := a ^ 2 * (∑ k, s k i * v k) + a ^ 3 * w i
  let L := v j + ∑ i, d i * w i
  have hz (i i' : Fin n) : z i * z i' ∈ I := by
    refine Ideal.mem_span_singleton.mpr
      ⟨((∑ k, s k i * v k) + a * w i) * ((∑ k, s k i' * v k) + a * w i'), ?_⟩
    dsimp [z]
    ring
  have ht := eval₂Hom_firstOrder_mod n φ r z I hz p
  have hlin : (∑ i, d i * z i) - a ^ 3 * L ∈ I := by
    have hcalc : (∑ i, d i * z i) - a ^ 3 * L =
        a ^ 2 * ∑ k, ((∑ i, s k i * d i) - if k = j then a else 0) * v k := by
      dsimp [z, L]
      simp only [mul_add, Finset.sum_add_distrib, Finset.mul_sum, sub_mul,
        Finset.sum_sub_distrib, mul_sub]
      rw [Finset.sum_comm]
      have hdiag : (∑ x : Fin c, a ^ 2 * ((if x = j then a else 0) * v x)) = a ^ 3 * v j := by
        simp [ite_mul, mul_ite, ← mul_assoc, ← pow_succ]
      rw [hdiag]
      simp only [Finset.mul_sum, mul_assoc, mul_left_comm, mul_comm]
      ring
    rw [hcalc]
    exact I.mul_mem_left _ (I.sum_mem fun k _ => I.mul_mem_right _ (hs k))
  have hdiff : eval₂Hom φ (fun i => r i + z i) p - a ^ 3 * L ∈ I := by
    convert I.add_mem (I.add_mem ht hconst) hlin using 1; ring
  obtain ⟨t, ht'⟩ := Ideal.mem_span_singleton.mp hdiff
  refine ⟨L + a * t, ?_, ?_⟩
  · change eval₂Hom φ (fun i => r i + z i) p = _
    linear_combination ht'
  · change (L + a * t) - L ∈ Ideal.span {a}
    rw [add_sub_cancel_left]
    exact Ideal.mem_span_singleton.mpr ⟨t, rfl⟩

/-- The substitution `x_i ↦ r_i + π² ∑_k s_{ki} y_k + π³ z_i` of the desingularization. -/
private noncomputable abbrev deformationSubstitution {R : Type*} [CommRing R] (n c : ℕ) (π : R)
    (r : Fin n → R) (s : Fin c → Fin n → R) :
    MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin (c + n)) R :=
  aeval fun i => C (r i) +
    (C π ^ 2 * ∑ k, C (s k i) * X (Fin.castAdd n k) + C π ^ 3 * X (Fin.natAdd c i))

/-- After the substitution the first `c` relations are divisible by `π³`, with quotients `g_j`
that are linear modulo `π`. -/
private theorem exists_deformation_relations {R : Type*} [CommRing R] (n m c : ℕ) (hcm : c ≤ m)
    (π : R) (r : Fin n → R) (s : Fin c → Fin n → R) (f : Fin m → MvPolynomial (Fin n) R)
    (hf : ∀ j, eval r (f j) ∈ Ideal.span {π ^ 4})
    (hs : ∀ k j, (∑ i, s k i * eval r (pderiv i (f (Fin.castLE hcm j)))) -
      (if k = j then π else 0) ∈ Ideal.span {π ^ 4}) :
    ∃ g : Fin c → MvPolynomial (Fin (c + n)) R,
      (∀ j, deformationSubstitution n c π r s (f (Fin.castLE hcm j)) = C π ^ 3 * g j) ∧
      (∀ j, g j - (X (Fin.castAdd n j) +
        ∑ i, C (eval r (pderiv i (f (Fin.castLE hcm j)))) * X (Fin.natAdd c i)) ∈
          Ideal.span {(C π : MvPolynomial (Fin (c + n)) R)}) := by
  classical
  let Cm : R →+* MvPolynomial (Fin (c + n)) R := C
  have heval (p : MvPolynomial (Fin n) R) :
      eval₂Hom Cm (fun i => Cm (r i)) p = Cm (eval r p) := (MvPolynomial.eval₂_comp Cm r p).symm
  have hmap {x : R} (hx : x ∈ Ideal.span {π ^ 4}) : Cm x ∈ Ideal.span {Cm π ^ 4} := by
    rw [Ideal.mem_span_singleton, ← map_pow]
    exact map_dvd Cm (Ideal.mem_span_singleton.mp hx)
  have hj (j : Fin c) := exists_divided_relation n c Cm (fun i => Cm (r i)) (Cm π)
    (fun k i => Cm (s k i)) (fun k => X (Fin.castAdd n k)) (fun i => X (Fin.natAdd c i))
    (f (Fin.castLE hcm j)) j (by rw [heval]; exact hmap (hf _)) (fun k => by
      simpa only [heval, map_sub, map_sum, map_mul, apply_ite Cm, map_zero] using hmap (hs k j))
  choose g hg hgmod using hj
  exact ⟨g, hg, fun j => by simpa only [heval] using hgmod j⟩

/-- All of the substituted relations are divisible by `π²`. -/
private theorem deformation_relation_mem_square {R : Type*} [CommRing R] (n c : ℕ) (π : R)
    (r : Fin n → R) (s : Fin c → Fin n → R) (p : MvPolynomial (Fin n) R)
    (hp : eval r p ∈ Ideal.span {π ^ 4}) :
    deformationSubstitution n c π r s p ∈
      Ideal.span {(C π : MvPolynomial (Fin (c + n)) R) ^ 2} := by
  classical
  let S := MvPolynomial (Fin (c + n)) R
  let I : Ideal S := Ideal.span {C π ^ 2}
  let q := Ideal.Quotient.mkₐ R I
  have hz (i : Fin n) : (C π ^ 2 * (∑ k, C (s k i) * X (Fin.castAdd n k)) +
      C π ^ 3 * X (Fin.natAdd c i) : S) ∈ I := by
    refine Ideal.mem_span_singleton.mpr
      ⟨(∑ k, C (s k i) * X (Fin.castAdd n k)) + C π * X (Fin.natAdd c i), ?_⟩
    ring
  have he : q.comp (deformationSubstitution n c π r s) =
      (Algebra.ofId R (S ⧸ I)).comp (aeval r) := by
    ext i
    simp only [AlgHom.comp_apply, deformationSubstitution, aeval_X]
    rw [map_add, show q _ = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr (hz i), add_zero]
    exact q.commutes (r i)
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q (deformationSubstitution n c π r s p) = 0
  rw [show q (deformationSubstitution n c π r s p) = algebraMap R (S ⧸ I) (eval r p) from
    DFunLike.congr_fun he p]
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton.mp hp
  rw [ht, map_mul, map_pow]
  have hπ : (algebraMap R (S ⧸ I) π) ^ 2 = 0 := by
    change q (C π) ^ 2 = 0
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
  rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hπ, zero_pow (by decide), zero_mul]

/-! ### The relation ideal after the substitution -/

/-- If the first `c` substituted relations vanish in `T`, the standardness condition gives
`π · I_T ⊆ I_T²` for the ideal `I_T` generated by the images of all the relations. -/
private theorem map_relIdeal_mul_le_square {R A T : Type*} [CommRing R] [CommRing A]
    [CommRing T] [Algebra R A] [Algebra R T] (P : Presentation R A) (π : R) (c : ℕ)
    (hcm : c ≤ P.m) (hcond : P.StandardCond2 (algebraMap R A π) c hcm)
    (θ : MvPolynomial (Fin P.n) R →ₐ[R] T) (hfirst : ∀ j : Fin c, θ (P.f (Fin.castLE hcm j)) = 0) :
    Ideal.span {algebraMap R T π} * Ideal.map θ.toRingHom P.relIdeal ≤
      (Ideal.map θ.toRingHom P.relIdeal) ^ 2 := by
  classical
  let J := Ideal.map θ.toRingHom P.relIdeal
  have hmapfirst : Ideal.map θ.toRingHom (P.firstRelIdeal c hcm) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, Presentation.firstRelIdeal, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact hfirst j
  have hmap : Ideal.map θ.toRingHom (P.firstRelIdeal c hcm + P.relIdeal ^ 2) = J ^ 2 := by
    change Ideal.map θ.toRingHom (P.firstRelIdeal c hcm ⊔ P.relIdeal ^ 2) = J ^ 2
    rw [Ideal.map_sup, Ideal.map_pow, hmapfirst, bot_sup_eq]
  rw [Ideal.span_singleton_mul_le_iff]
  have hgen (j : Fin P.m) : algebraMap R T π * θ (P.f j) ∈ J ^ 2 := by
    by_cases hj : j.val < c
    · have hcast : Fin.castLE hcm (⟨j.val, hj⟩ : Fin c) = j := Fin.ext rfl
      rw [← hcast, hfirst, mul_zero]
      exact Ideal.zero_mem _
    · let k : Fin (P.m - c) := ⟨j.val - c, by omega⟩
      have hk : (⟨c + k.val, by have := k.isLt; omega⟩ : Fin P.m) = j := by
        apply Fin.ext
        dsimp [k]
        omega
      have hp := hcond k (C π)
        (show P.lift (C π) = algebraMap R A π from (presentationHom P).commutes π)
      rw [hk] at hp
      have hm := Ideal.mem_map_of_mem θ.toRingHom hp
      rw [hmap] at hm
      change θ (C π * P.f j) ∈ J ^ 2 at hm
      rwa [map_mul, show θ (C π) = algebraMap R T π from θ.commutes π] at hm
  intro x hx
  rw [Presentation.relIdeal, Ideal.map_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨_, ⟨j, rfl⟩, rfl⟩ := hy
    exact hgen j
  | zero => simp
  | add x y hx hy hx' hy' => simpa only [mul_add] using (J ^ 2).add_mem hx' hy'
  | smul a x hx hx' => simpa only [smul_eq_mul, mul_left_comm] using (J ^ 2).mul_mem_left a hx'

/-- An ideal contained in `(a²)` with `(a) J ⊆ J²` vanishes, provided `a` lies in the Jacobson
radical of a Noetherian ring and `a² x = 0` implies `a x = 0`. -/
private theorem ideal_eq_bot_of_le_square_of_mul_le_square {S : Type*} [CommRing S]
    [IsNoetherianRing S] (a : S) (ha : a ∈ (⊥ : Ideal S).jacobson) (J : Ideal S)
    (hJ : J ≤ Ideal.span {a ^ 2}) (hmul : Ideal.span {a} * J ≤ J ^ 2)
    (hAnn : ∀ x : S, a ^ 2 * x = 0 → a * x = 0) : J = ⊥ := by
  let I : Ideal S := Ideal.span {a}
  have hJ' : J ≤ I ^ 2 := by simpa [I, Ideal.span_singleton_pow] using hJ
  have hle : I * J ≤ I * (I * J) := by
    calc
      I * J ≤ J ^ 2 := hmul
      _ = J * J := pow_two J
      _ ≤ I ^ 2 * J := Ideal.mul_mono hJ' le_rfl
      _ = I * (I * J) := by rw [pow_two, mul_assoc]
  have hzero : I * J = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot I (I * J) (IsNoetherian.noetherian _) hle
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha))
  refine le_antisymm (fun x hx => ?_) bot_le
  obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp (hJ hx)
  have hz : a * (a ^ 2 * y) = 0 := by
    have hmem := Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_singleton a)) hx
    rwa [hzero] at hmem
  have hz' : a ^ 2 * (a * y) = 0 := by convert hz using 1; ring
  simpa [pow_two, mul_assoc] using hAnn (a * y) hz'

/-- In a flat Noetherian `R`-algebra in which some element of the defect ideal is invertible,
the whole relation ideal of the substituted presentation vanishes. -/
private theorem map_relIdeal_eq_bot_of_flat_of_defect {R A T : Type*} [CommRing R] [CommRing A]
    [CommRing T] [Algebra R A] [Algebra R T] [Module.Flat R T] [IsNoetherianRing T]
    (P : Presentation R A) (π r : R) (c : ℕ) (hcm : c ≤ P.m)
    (hcond : P.StandardCond2 (algebraMap R A π) c hcm)
    (θ : MvPolynomial (Fin P.n) R →ₐ[R] T) (hfirst : ∀ j : Fin c, θ (P.f (Fin.castLE hcm j)) = 0)
    (hdiv : ∀ j, θ (P.f j) ∈ Ideal.span {(algebraMap R T π) ^ 2})
    (hπ : algebraMap R T π ∈ (⊥ : Ideal T).jacobson) (hr : r ∈ annihilatorDefectIdeal R π)
    (hu : IsUnit (algebraMap R T r)) : Ideal.map θ.toRingHom P.relIdeal = ⊥ := by
  refine ideal_eq_bot_of_le_square_of_mul_le_square (algebraMap R T π) hπ _ ?_
    (map_relIdeal_mul_le_square P π c hcm hcond θ hfirst)
    (mul_eq_zero_of_sq_mul_eq_zero_of_flat π r hr hu)
  rw [Presentation.relIdeal, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
  exact hdiv j

/-! ### Factoring through the deformed algebra -/

/-- A presentation whose relations map into an ideal `I ≤ ker e` factors the given map through
`S ⧸ I`. -/
private theorem exists_quotient_factorization {R A S Λ : Type*} [CommRing R] [CommRing A]
    [CommRing S] [CommRing Λ] [Algebra R A] [Algebra R S] [Algebra R Λ]
    (P : Presentation R A) (f : A →ₐ[R] Λ) (θ : MvPolynomial (Fin P.n) R →ₐ[R] S)
    (e : S →ₐ[R] Λ) (I : Ideal S) (hθ : ∀ j, θ (P.f j) ∈ I) (he : I ≤ RingHom.ker e)
    (hcomp : e.comp θ = f.comp (presentationHom P)) :
    ∃ (u : A →ₐ[R] S ⧸ I) (v : S ⧸ I →ₐ[R] Λ),
      v.comp u = f ∧ u.comp (presentationHom P) = (Ideal.Quotient.mkₐ R I).comp θ := by
  let q := Ideal.Quotient.mkₐ R I
  have hker : Ideal.span (Set.range P.f) ≤ RingHom.ker (q.comp θ) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hθ j)
  let u : A →ₐ[R] S ⧸ I :=
    (Ideal.Quotient.liftₐ (Ideal.span (Set.range P.f)) (q.comp θ) hker).comp P.iso.toAlgHom
  let v : S ⧸ I →ₐ[R] Λ := Ideal.Quotient.liftₐ I e he
  have hu (p : MvPolynomial (Fin P.n) R) : u (presentationHom P p) = q (θ p) := by
    simp only [u, presentationHom, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
      AlgEquiv.apply_symm_apply]
    rfl
  refine ⟨u, v, AlgHom.ext fun a => ?_, AlgHom.ext hu⟩
  obtain ⟨p, hp⟩ := (P.iso.symm.surjective.comp
    (Ideal.Quotient.mkₐ_surjective R (Ideal.span (Set.range P.f)))) a
  change presentationHom P p = a at hp
  rw [← hp, AlgHom.comp_apply, hu]
  exact DFunLike.congr_fun hcomp p

/-- Evaluating the substitution at `y = 0`, `z = π λ` is evaluation at `r + π⁴ λ`. -/
private theorem eval_deformationSubstitution {R Λ : Type*} [CommRing R] [CommRing Λ]
    [Algebra R Λ] (n c : ℕ) (π : R) (r : Fin n → R) (s : Fin c → Fin n → R) (l : Fin n → Λ) :
    (aeval (Fin.addCases (fun _ : Fin c => 0) (fun i => algebraMap R Λ π * l i))).comp
        (deformationSubstitution n c π r s) =
      aeval (fun i => algebraMap R Λ (r i) + (algebraMap R Λ π) ^ 4 * l i) := by
  ext i
  simp [deformationSubstitution, ← mul_assoc, ← pow_succ]

/-- The divided relations `g_j` also vanish in `Λ`: their image is a multiple of `π` killed by
`π³`, hence zero because the annihilators of `π` and `π²` agree in `Λ`. -/
private theorem eval_deformation_relation_eq_zero {R Λ : Type*} [CommRing R] [CommRing Λ]
    [Algebra R Λ] (n c : ℕ) (π : R) (l : Fin n → Λ)
    (hAnn : (Submodule.span Λ {algebraMap R Λ π}).annihilator =
      (Submodule.span Λ {(algebraMap R Λ π) ^ 2}).annihilator)
    (g : MvPolynomial (Fin (c + n)) R) (j : Fin c) (d : Fin n → R)
    (hg : g - (X (Fin.castAdd n j) + ∑ i, C (d i) * X (Fin.natAdd c i)) ∈ Ideal.span {C π})
    (hf : aeval (Fin.addCases (fun _ : Fin c => 0) (fun i => algebraMap R Λ π * l i))
      (C π ^ 3 * g) = 0) :
    aeval (Fin.addCases (fun _ : Fin c => 0) (fun i => algebraMap R Λ π * l i)) g = 0 := by
  let e : MvPolynomial (Fin (c + n)) R →ₐ[R] Λ :=
    aeval (Fin.addCases (fun _ : Fin c => 0) (fun i => algebraMap R Λ π * l i))
  have hcube : (algebraMap R Λ π) ^ 3 * e g = 0 := by simpa [e] using hf
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton.mp hg
  have he : e g = algebraMap R Λ π * ((∑ i, algebraMap R Λ (d i) * l i) + e t) := by
    have h := congrArg e ht
    simp only [map_sub, map_add, map_sum, map_mul] at h
    simp only [Finset.mul_sum, mul_add]
    simp only [e, aeval_C, aeval_X, Fin.addCases_left, Fin.addCases_right] at h
    change e g - (0 + ∑ i, algebraMap R Λ (d i) * (algebraMap R Λ π * l i)) =
      algebraMap R Λ π * e t at h
    simp only [mul_left_comm, mul_comm] at h ⊢
    linear_combination h
  exact eq_zero_of_eq_mul_of_pow_three_mul_eq_zero Λ (algebraMap R Λ π) (e g) _ hAnn he hcube

/-! ### Smoothness of the deformed algebra -/

/-- The localization at a prime of smoothness is flat over the base. -/
private theorem flat_atPrime_of_smoothAt {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (q : Ideal S) [q.IsPrime] (hq : Algebra.SmoothAt R S q) :
    Module.Flat R (Localization.AtPrime q) := by
  obtain ⟨t, ht, hsm⟩ := hq
  let U := Localization.Away t
  let V := Localization.AtPrime q
  have hle : Submonoid.powers t ≤ q.primeCompl := Submonoid.powers_le.mpr ht
  let : Algebra U V := IsLocalization.localizationAlgebraOfSubmonoidLe U V _ _ hle
  have : IsScalarTower S U V :=
    IsLocalization.localization_isScalarTower_of_submonoid_le U V _ _ hle
  have : IsScalarTower R U V := IsScalarTower.to₁₃₄ R S U V
  have : IsLocalization (Algebra.algebraMapSubmonoid U q.primeCompl) V :=
    IsLocalization.isLocalization_of_submonoid_le U V _ _ hle
  have : Algebra.Smooth R U := hsm
  have : Module.Flat U V := IsLocalization.flat V (Algebra.algebraMapSubmonoid U q.primeCompl)
  exact Module.Flat.trans R U V

/-- The image of a prime lies in the Jacobson radical of the localization at that prime. -/
private theorem algebraMap_mem_jacobson_atPrime {S : Type*} [CommRing S] (p : Ideal S)
    [p.IsPrime] (x : S) (hx : x ∈ p) :
    algebraMap S (Localization.AtPrime p) x ∈ (⊥ : Ideal (Localization.AtPrime p)).jacobson := by
  apply IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal (Localization.AtPrime p))
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p (Localization.AtPrime p)]
  exact Ideal.mem_map_of_mem _ hx

/-- Smoothness at a prime descends along a surjection whose kernel dies in the local ring. -/
private theorem smoothAt_of_surjective_of_localized_kernel {R S B : Type*} [CommRing R]
    [CommRing S] [CommRing B] [Algebra R S] [Algebra R B] [Algebra.FinitePresentation R B]
    (f : S →ₐ[R] B) (hf : Function.Surjective f) (q : Ideal B) [q.IsPrime]
    (hsm : Algebra.SmoothAt R S (q.comap f.toRingHom))
    (hker : RingHom.ker f.toRingHom ≤
      RingHom.ker (algebraMap S (Localization.AtPrime (q.comap f.toRingHom)))) :
    Algebra.SmoothAt R B q := by
  let p := q.comap f.toRingHom
  let U := Localization.AtPrime p
  let V := Localization.AtPrime q
  let ι : S →ₐ[R] U := IsScalarTower.toAlgHom R S U
  let κ : B →ₐ[R] V := IsScalarTower.toAlgHom R B V
  let g : B →ₐ[R] U := f.liftOfSurjective hf ι hker
  have hg (x : S) : g (f x) = ι x := AlgHom.liftOfSurjective_apply ..
  have hgu (b : q.primeCompl) : IsUnit (g b) := by
    obtain ⟨c, hc⟩ := hf b
    have hc' : c ∈ p.primeCompl := by change f c ∉ q; rw [hc]; exact b.property
    rw [← hc, hg]
    exact IsLocalization.map_units U ⟨c, hc'⟩
  let G : V →ₐ[R] U := IsLocalization.liftAlgHom hgu
  have hfu (c : p.primeCompl) : IsUnit ((κ.comp f) c) :=
    IsLocalization.map_units V (⟨f c, c.property⟩ : q.primeCompl)
  let F : U →ₐ[R] V := IsLocalization.liftAlgHom hfu
  have hFG : F.comp G = AlgHom.id R V := by
    apply IsLocalization.algHom_ext q.primeCompl
    ext b
    obtain ⟨c, rfl⟩ := hf b
    change F (G (algebraMap B V (f c))) = algebraMap B V (f c)
    rw [show G (algebraMap B V (f c)) = g (f c) from IsLocalization.lift_eq hgu (f c), hg]
    exact IsLocalization.lift_eq hfu c
  have : Algebra.FormallySmooth R U := Algebra.isSmoothAt_of_smoothAt R S hsm
  have : Algebra.FormallySmooth R V := formallySmooth_of_retraction F G hFG
  exact Algebra.IsSmoothAt.exists_notMem_smooth R q

/-- The quotient of a polynomial ring by relations that are linear modulo `π` is smooth at every
prime containing `π`: the Jacobian of those relations is the identity there, so the principal
Jacobian minor is an elementary standard element avoiding the prime. -/
private theorem smoothAt_quotient_of_linear_relations_mod {R : Type*} [CommRing R] (n c : ℕ)
    (π : R) (g : Fin c → MvPolynomial (Fin (c + n)) R) (d : Fin c → Fin n → R)
    (hg : ∀ j, g j - (X (Fin.castAdd n j) + ∑ i, C (d j i) * X (Fin.natAdd c i)) ∈
      Ideal.span {C π})
    (q : Ideal (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g))) [q.IsPrime]
    (hπ : algebraMap R (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g)) π ∈ q) :
    Algebra.SmoothAt R (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g)) q := by
  classical
  let T := (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g)) ⧸ q
  let : CommRing T := inferInstance
  have : Algebra.FinitePresentation R
      (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g)) :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range g))
  let P : Presentation R (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g)) :=
    ⟨c + n, c, g, AlgEquiv.refl⟩
  let D : (MvPolynomial (Fin (c + n)) R ⧸ Ideal.span (Set.range g)) :=
    P.lift (P.jacobianMinorPrincipal c (Nat.le_add_right c n) le_rfl)
  have hD : IsElementaryStandard (R := R) D := by
    refine ⟨P, c, Nat.le_add_right c n, le_rfl, ⟨1, (one_mul _).symm⟩, fun j => ?_⟩
    simpa [P] using j.isLt
  let ψ : (MvPolynomial (Fin (c + n)) R) →+* T :=
    (Ideal.Quotient.mk q).comp (Ideal.Quotient.mk (Ideal.span (Set.range g)))
  have hψπ : ψ (C π) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hπ
  have hderiv (j i : Fin c) : ψ (pderiv (Fin.castAdd n i) (g j)) = if j = i then 1 else 0 := by
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton.mp (hg j)
    have hg' : g j = (X (Fin.castAdd n j) + ∑ k, C (d j k) * X (Fin.natAdd c k)) + C π * t := by
      linear_combination ht
    have hneq (k : Fin n) : Fin.castAdd n i ≠ Fin.natAdd c k := by
      intro heq
      have hval := congrArg Fin.val heq
      simp only [Fin.val_castAdd, Fin.val_natAdd] at hval
      omega
    have hneq' (k : Fin n) := (hneq k).symm
    rw [hg']
    simp only [map_add, map_sum, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, zero_mul,
      zero_add, MvPolynomial.pderiv_X, Pi.single_apply, Fin.castAdd_inj, hneq', ite_false,
      mul_zero, Finset.sum_const_zero, add_zero, map_mul, hψπ, map_zero, apply_ite ψ, map_one]
  have hdet : Ideal.Quotient.mk q D = 1 := by
    let M : Matrix (Fin c) (Fin c) (MvPolynomial (Fin (c + n)) R) :=
      fun j i => pderiv (Fin.castAdd n i) (g j)
    change ψ (Matrix.det M) = 1
    calc
      ψ M.det = (M.map ψ).det := RingHom.map_det ψ M
      _ = (1 : Matrix (Fin c) (Fin c) T).det := by
        congr 1
        ext j i
        exact hderiv j i
      _ = 1 := Matrix.det_one (n := Fin c) (R := T)
  refine smoothAt_of_isElementaryStandard_of_notMem hD q fun hDq => ?_
  refine (‹q.IsPrime›.ne_top ((Ideal.eq_top_iff_one q).mpr ?_))
  refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
  rw [map_one, ← hdet]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hDq

/-- An element of the base whose image avoids a prime becomes a unit in the localization there. -/
private theorem isUnit_algebraMap_atPrime {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]
    (q : Ideal B) [q.IsPrime] (x : R) (hx : algebraMap R B x ∉ q) :
    IsUnit (algebraMap R (Localization.AtPrime q) x) := by
  rw [IsScalarTower.algebraMap_apply R B (Localization.AtPrime q)]
  exact IsLocalization.map_units _ (⟨algebraMap R B x, hx⟩ : q.primeCompl)

/-- The ideal generated by two families lies in a kernel when both families are killed. -/
private theorem sup_span_range_le_ker {S T F : Type*} [CommRing S] [CommRing T] [FunLike F S T]
    [RingHomClass F S T] {ι κ : Type*} (e : F) (a : ι → S) (b : κ → S) (ha : ∀ i, e (a i) = 0)
    (hb : ∀ j, e (b j) = 0) :
    Ideal.span (Set.range a) ⊔ Ideal.span (Set.range b) ≤ RingHom.ker e :=
  sup_le (Ideal.span_le.mpr (Set.range_subset_iff.mpr ha))
    (Ideal.span_le.mpr (Set.range_subset_iff.mpr hb))

/-- The quotient of a finitely presented algebra by an ideal generated by two finite families is
finitely presented. -/
private theorem finitePresentation_quotient_sup_span_range {R S ι κ : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [Algebra.FinitePresentation R S] [Finite ι] [Finite κ]
    (a : ι → S) (b : κ → S) (I : Ideal S)
    (hI : I = Ideal.span (Set.range a) ⊔ Ideal.span (Set.range b)) :
    Algebra.FinitePresentation R (S ⧸ I) :=
  Algebra.FinitePresentation.quotient (hI ▸
    (Submodule.fg_span (Set.finite_range a)).sup (Submodule.fg_span (Set.finite_range b)))

/-- Away from `π` the deformed algebra is smooth over `R`: the substitution lifts along a
square-zero extension because `π` is strictly standard in `A`. -/
private theorem smoothAt_deformation_quotient_of_notMem {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [Algebra.FinitePresentation R A]
    (P : Presentation R A) (π : R) (c : ℕ) (hcm : c ≤ P.m) (r : Fin P.n → R)
    (s : Fin c → Fin P.n → R) (g : Fin c → MvPolynomial (Fin (c + P.n)) R)
    (hg : ∀ j, deformationSubstitution P.n c π r s (P.f (Fin.castLE hcm j)) = C π ^ 3 * g j)
    (I : Ideal (MvPolynomial (Fin (c + P.n)) R))
    (hI : I = Ideal.span (Set.range fun j => deformationSubstitution P.n c π r s (P.f j)) ⊔
      Ideal.span (Set.range g))
    (u : A →ₐ[R] (MvPolynomial (Fin (c + P.n)) R ⧸ I))
    (hu : u.comp (presentationHom P) =
      (Ideal.Quotient.mkₐ R I).comp (deformationSubstitution P.n c π r s))
    (hstd : IsStrictlyStandard (R := R) (algebraMap R A π))
    (q : Ideal (MvPolynomial (Fin (c + P.n)) R ⧸ I)) [q.IsPrime]
    (hπq : algebraMap R _ π ∉ q) :
    Algebra.SmoothAt R (MvPolynomial (Fin (c + P.n)) R ⧸ I) q := by
  classical
  let S := MvPolynomial (Fin (c + P.n)) R
  let B := S ⧸ I
  let qB : S →ₐ[R] B := Ideal.Quotient.mkₐ R I
  let T := Localization.AtPrime q
  let κ : B →ₐ[R] T := IsScalarTower.toAlgHom R B T
  let θ := deformationSubstitution P.n c π r s
  let p := q.comap u.toRingHom
  have hpπ : algebraMap R A π ∉ p := by change u (algebraMap R A π) ∉ q; rwa [u.commutes]
  have : Algebra.FormallySmooth R (Localization.AtPrime p) :=
    Algebra.isSmoothAt_of_smoothAt R A (smoothAt_of_isStrictlyStandard_of_notMem hstd p hpπ)
  have hπT : IsUnit (algebraMap R T π) := isUnit_algebraMap_atPrime q π hπq
  have : Algebra.FormallySmooth R T := by
    apply Algebra.FormallySmooth.of_comp_surjective
    intro D _ _ K hK φ
    let Q := D ⧸ K
    let k : D →ₐ[R] Q := Ideal.Quotient.mkₐ R K
    let ψ : S →ₐ[R] Q := (φ.comp κ).comp qB
    have hψC (a : R) : ψ (C a) = algebraMap R Q a := ψ.commutes a
    let ψA : A →ₐ[R] Q := (φ.comp κ).comp u
    have hunits (a : p.primeCompl) : IsUnit (ψA a) :=
      (IsLocalization.map_units T (⟨u a, a.property⟩ : q.primeCompl)).map φ
    let ψL : Localization.AtPrime p →ₐ[R] Q := IsLocalization.liftAlgHom hunits
    obtain ⟨αL, hαL⟩ :=
      Algebra.FormallySmooth.comp_surjective R (Localization.AtPrime p) K hK ψL
    let α : A →ₐ[R] D := αL.comp (IsScalarTower.toAlgHom R A (Localization.AtPrime p))
    have hα (a : A) : k (α a) = ψA a := by
      have h := DFunLike.congr_fun hαL (algebraMap A (Localization.AtPrime p) a)
      exact h.trans (IsLocalization.lift_eq hunits a)
    have hπD : IsUnit (algebraMap R D π) := by
      apply (IsNilpotent.isUnit_quotient_mk_iff (I := K) ⟨2, hK⟩).mp
      simpa only [Ideal.Quotient.mk_algebraMap, φ.commutes] using hπT.map φ
    obtain ⟨t, ht⟩ := id hπD
    let b : D := algebraMap R D π
    let z : D := (↑t⁻¹ : D) ^ 3
    have hbz : b ^ 3 * z = 1 := by dsimp [b, z]; rw [← ht, ← mul_pow]; simp
    have hks : Function.Surjective k := Ideal.Quotient.mkₐ_surjective R K
    choose v hv using fun j : Fin c => hks (ψ (X (Fin.castAdd P.n j)))
    let w (i : Fin P.n) : D := z * (α (presentationHom P (X i)) - algebraMap R D (r i) -
      b ^ 2 * ∑ j, algebraMap R D (s j i) * v j)
    let E : S →ₐ[R] D := aeval (Fin.addCases v w)
    have hEC (a : R) : E (C a) = algebraMap R D a := E.commutes a
    have hEX (i : Fin (c + P.n)) : E (X i) = Fin.addCases v w i := aeval_X _ _
    have hEθ : E.comp θ = α.comp (presentationHom P) := by
      apply MvPolynomial.algHom_ext
      intro i
      change E (θ (X i)) = α (presentationHom P (X i))
      rw [show θ (X i) = C (r i) + (C π ^ 2 * ∑ j, C (s j i) * X (Fin.castAdd P.n j) +
        C π ^ 3 * X (Fin.natAdd c i)) from aeval_X _ _]
      simp only [map_add, map_mul, map_pow, map_sum, hEC, hEX, Fin.addCases_left,
        Fin.addCases_right]
      change algebraMap R D (r i) + (b ^ 2 * (∑ j, algebraMap R D (s j i) * v j) +
        b ^ 3 * (z * (α (presentationHom P (X i)) - algebraMap R D (r i) -
          b ^ 2 * ∑ j, algebraMap R D (s j i) * v j))) = _
      rw [← mul_assoc, hbz, one_mul]
      ring
    have hE (i : Fin P.n) : b ^ 3 * w i = α (presentationHom P (X i)) - algebraMap R D (r i) -
        b ^ 2 * ∑ j, algebraMap R D (s j i) * v j := by
      dsimp [w]; rw [← mul_assoc, hbz, one_mul]
    have hkE : k.comp E = ψ := by
      ext i
      refine Fin.addCases (fun j => ?_) (fun j => ?_) i
      · simpa only [AlgHom.comp_apply, E, aeval_X, Fin.addCases_left] using hv j
      · simp only [AlgHom.comp_apply, E, aeval_X, Fin.addCases_right]
        change k (w j) = ψ (X (Fin.natAdd c j))
        apply ((hπD.map k).pow 3).mul_right_inj.mp
        have h := congrArg k (hE j)
        simp only [map_mul, map_pow, map_sub, map_sum, hα, k.commutes, hv] at h
        have hθ := DFunLike.congr_fun hu (X j)
        have hθ' := congrArg (φ.comp κ) hθ
        change ψA (presentationHom P (X j)) = ψ (θ (X j)) at hθ'
        rw [hθ'] at h
        simp only [θ, deformationSubstitution, aeval_X, map_add, map_mul, map_pow, map_sum,
          hψC] at h
        change (k b) ^ 3 * k (w j) = (k b) ^ 3 * ψ (X (Fin.natAdd c j))
        simpa only [b, k.commutes, add_sub_cancel_left, add_sub_cancel_right] using h
    have hErel (j : Fin P.m) : E (θ (P.f j)) = 0 := by
      rw [show E (θ (P.f j)) = α (presentationHom P (P.f j)) from DFunLike.congr_fun hEθ _]
      rw [presentationHom_relation, map_zero]
    have hEg (j : Fin c) : E (g j) = 0 := by
      apply (hπD.pow 3).mul_right_eq_zero.mp
      have h := hErel (Fin.castLE hcm j)
      rwa [hg, map_mul, map_pow, show E (C π) = algebraMap R D π from E.commutes π] at h
    have hEI : I ≤ RingHom.ker E.toRingHom :=
      hI.le.trans (sup_span_range_le_ker E _ _ hErel hEg)
    let L : B →ₐ[R] D := Ideal.Quotient.liftₐ I E hEI
    have hL (x : B) : k (L x) = φ (κ x) := by
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R I x
      exact DFunLike.congr_fun hkE x
    have hLu (x : q.primeCompl) : IsUnit (L x) := by
      apply (IsNilpotent.isUnit_quotient_mk_iff (I := K) ⟨2, hK⟩).mp
      rw [show Ideal.Quotient.mk K (L x) = φ (κ x) from hL x]
      exact (IsLocalization.map_units T x).map φ
    refine ⟨IsLocalization.liftAlgHom hLu, ?_⟩
    apply IsLocalization.algHom_ext q.primeCompl
    ext x
    change k (IsLocalization.lift hLu (algebraMap B T x)) = φ (κ x)
    rw [IsLocalization.lift_eq]
    exact hL x
  have : Algebra.FinitePresentation R B :=
    finitePresentation_quotient_sup_span_range _ _ I hI
  exact Algebra.IsSmoothAt.exists_notMem_smooth R q

/-- At a prime containing `π` but avoiding an element of the defect ideal, the deformed algebra
is smooth over `R`: the substituted relations already vanish in the local ring, so the algebra
agrees there with the quotient by the linear relations `g_j`. -/
private theorem smoothAt_deformation_quotient_of_mem {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] [IsNoetherianRing R]
    (P : Presentation R A) (π : R) (c : ℕ) (hcm : c ≤ P.m) (r : Fin P.n → R)
    (s : Fin c → Fin P.n → R) (hf : ∀ j, eval r (P.f j) ∈ Ideal.span {π ^ 4})
    (hcond : P.StandardCond2 (algebraMap R A π) c hcm)
    (g : Fin c → MvPolynomial (Fin (c + P.n)) R)
    (hg : ∀ j, deformationSubstitution P.n c π r s (P.f (Fin.castLE hcm j)) = C π ^ 3 * g j)
    (hgmod : ∀ j, g j - (X (Fin.castAdd P.n j) +
      ∑ i, C (eval r (pderiv i (P.f (Fin.castLE hcm j)))) * X (Fin.natAdd c i)) ∈
        Ideal.span {C π})
    (I : Ideal (MvPolynomial (Fin (c + P.n)) R))
    (hI : I = Ideal.span (Set.range fun j => deformationSubstitution P.n c π r s (P.f j)) ⊔
      Ideal.span (Set.range g))
    (q : Ideal (MvPolynomial (Fin (c + P.n)) R ⧸ I)) [q.IsPrime]
    (hπq : algebraMap R _ π ∈ q) (a : R) (ha : a ∈ annihilatorDefectIdeal R π)
    (haq : algebraMap R _ a ∉ q) :
    Algebra.SmoothAt R (MvPolynomial (Fin (c + P.n)) R ⧸ I) q := by
  classical
  let S := MvPolynomial (Fin (c + P.n)) R
  let J : Ideal S := Ideal.span (Set.range g)
  let Clin := S ⧸ J
  let B := S ⧸ I
  let θ := deformationSubstitution P.n c π r s
  let qC : S →ₐ[R] Clin := Ideal.Quotient.mkₐ R J
  let qB : S →ₐ[R] B := Ideal.Quotient.mkₐ R I
  have hJI : J ≤ I := hI ▸ le_sup_right
  let τ : Clin →ₐ[R] B := Ideal.Quotient.liftₐ J qB (fun x hx =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (hJI hx))
  have hsurj : Function.Surjective τ := by
    intro b
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R I b
    exact ⟨qC x, rfl⟩
  let p := q.comap τ.toRingHom
  let T := Localization.AtPrime p
  let α : Clin →ₐ[R] T := IsScalarTower.toAlgHom R Clin T
  let β : S →ₐ[R] T := α.comp qC
  have : Algebra.FinitePresentation R Clin :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range g))
  have : Algebra.FinitePresentation R B :=
    finitePresentation_quotient_sup_span_range _ _ I hI
  have hpπ : algebraMap R Clin π ∈ p := by change τ (algebraMap R Clin π) ∈ q; rwa [τ.commutes]
  have hsm : Algebra.SmoothAt R Clin p :=
    smoothAt_quotient_of_linear_relations_mod P.n c π g _ hgmod p hpπ
  have : Module.Flat R T := flat_atPrime_of_smoothAt p hsm
  have : IsNoetherianRing Clin := inferInstance
  have : IsNoetherianRing T := inferInstance
  have hg0 (j : Fin c) : β (g j) = 0 := by
    change α (qC (g j)) = 0
    rw [show qC (g j) = 0 from
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self j)), map_zero]
  have hfirst (j : Fin c) : (β.comp θ) (P.f (Fin.castLE hcm j)) = 0 := by
    change β (θ _) = 0
    rw [hg, map_mul, hg0, mul_zero]
  have hdiv (j : Fin P.m) : (β.comp θ) (P.f j) ∈ Ideal.span {(algebraMap R T π) ^ 2} := by
    obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp
      (deformation_relation_mem_square P.n c π r s (P.f j) (hf j))
    refine Ideal.mem_span_singleton.mpr ⟨β z, ?_⟩
    change β (θ (P.f j)) = _
    rw [hz, map_mul, map_pow, show β (C π) = algebraMap R T π from β.commutes π]
  have hπ : algebraMap R T π ∈ (⊥ : Ideal T).jacobson := by
    rw [IsScalarTower.algebraMap_apply R Clin T]
    exact algebraMap_mem_jacobson_atPrime p _ hpπ
  have hau : IsUnit (algebraMap R T a) := by
    refine isUnit_algebraMap_atPrime p a ?_
    change τ (algebraMap R Clin a) ∉ q
    rwa [τ.commutes]
  have hzero := map_relIdeal_eq_bot_of_flat_of_defect (A := A) (T := T) (θ := β.comp θ)
    P π a c hcm hcond hfirst hdiv hπ ha hau
  have hβI : I ≤ RingHom.ker β.toRingHom := by
    refine hI.le.trans (sup_span_range_le_ker β _ _ (fun j => ?_) hg0)
    have hm := Ideal.mem_map_of_mem (β.comp θ).toRingHom
      (show P.f j ∈ P.relIdeal from Ideal.subset_span (Set.mem_range_self j))
    rwa [hzero] at hm
  refine smoothAt_of_surjective_of_localized_kernel τ hsurj q hsm fun x hx => ?_
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mkₐ_surjective R J x
  exact hβI (Ideal.Quotient.eq_zero_iff_mem.mp hx)

/-! ### The desingularization lemma -/

/-- **The desingularization lemma.** Let `R` be Noetherian, let `Λ` be an `R`-algebra in which
the annihilators of `π` and of `π²` agree, and let `A` be an `R`-algebra of finite presentation
with an `R`-algebra map `f : A → Λ`. If the image of `π` in `A` is strictly standard over `R`,
and if there is a retraction `ρ : A/π⁴A → R/π⁴R` compatible with the maps to `Λ/π⁴Λ`, then `f`
factors through an `R`-algebra `B` of finite presentation with `𝔞 B ⊆ H_{B/R}`, where
`𝔞 = Ann_R (Ann_R (π²) / Ann_R (π))`. -/
@[stacks 07CR]
theorem exists_finitePresentation_factorization_singularIdeal
    (R : Type u) (A : Type v) (Λ : Type w) [CommRing R] [CommRing A] [CommRing Λ]
    [Algebra R A] [Algebra R Λ] [IsNoetherianRing R] [Algebra.FinitePresentation R A]
    (π : R) (f : A →ₐ[R] Λ)
    (hAnn : (Submodule.span Λ {algebraMap R Λ π}).annihilator =
      (Submodule.span Λ {(algebraMap R Λ π) ^ 2}).annihilator)
    (hstandard : IsStrictlyStandard (R := R) (algebraMap R A π))
    (ρ : (A ⧸ Ideal.span {(algebraMap R A π) ^ 4}) →ₐ[R] (R ⧸ Ideal.span {π ^ 4}))
    (hρ : ∀ (x : A) (r : R),
      ρ (Ideal.Quotient.mk (Ideal.span {(algebraMap R A π) ^ 4}) x) =
          Ideal.Quotient.mk (Ideal.span {π ^ 4}) r →
        Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 4}) (f x) =
          Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 4}) (algebraMap R Λ r)) :
    ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FinitePresentation R B)
      (g : A →ₐ[R] B) (h : B →ₐ[R] Λ),
      h.comp g = f ∧
        Ideal.map (algebraMap R B) (annihilatorDefectIdeal R π) ≤ singularIdeal R B := by
  classical
  obtain ⟨P, c, hcm, M, hM, hcond⟩ :=
    exists_presentation_matrix_of_isStrictlyStandard R A (algebraMap R A π) hstandard
  obtain ⟨r, l, heval, hf, hl⟩ := exists_presentation_section_lifts P π f ρ hρ
  obtain ⟨s, hs⟩ := exists_jacobian_matrix_lifts P π c hcm M hM
    (ρ.comp (Ideal.Quotient.mkₐ R (Ideal.span {(algebraMap R A π) ^ 4}))) r heval
  obtain ⟨g, hg, hgmod⟩ := exists_deformation_relations P.n P.m c hcm π r s P.f hf hs
  let S := MvPolynomial (Fin (c + P.n)) R
  let θ : MvPolynomial (Fin P.n) R →ₐ[R] S := deformationSubstitution P.n c π r s
  let e : S →ₐ[R] Λ :=
    aeval (Fin.addCases (fun _ : Fin c => 0) (fun i => algebraMap R Λ π * l i))
  have hcomp : e.comp θ = f.comp (presentationHom P) := by
    rw [show e.comp θ = _ from eval_deformationSubstitution P.n c π r s l]
    ext i
    rw [aeval_X]
    change algebraMap R Λ (r i) + (algebraMap R Λ π) ^ 4 * l i = f (P.lift (X i))
    exact (hl i).symm
  have heθ (j : Fin P.m) : e (θ (P.f j)) = 0 :=
    (DFunLike.congr_fun hcomp (P.f j)).trans
      (by rw [AlgHom.comp_apply, presentationHom_relation, map_zero])
  have heg (j : Fin c) : e (g j) = 0 := by
    refine eval_deformation_relation_eq_zero P.n c π l hAnn (g j) j _ (hgmod j) ?_
    rw [← hg j]
    exact heθ _
  let I : Ideal S := Ideal.span (Set.range fun j => θ (P.f j)) ⊔ Ideal.span (Set.range g)
  have heI : I ≤ RingHom.ker e := sup_span_range_le_ker e _ _ heθ heg
  obtain ⟨u, v, hvu, hu⟩ := exists_quotient_factorization P f θ e I
    (fun j => Ideal.mem_sup_left (Ideal.subset_span (Set.mem_range_self j))) heI hcomp
  have : Algebra.FinitePresentation R (S ⧸ I) :=
    finitePresentation_quotient_sup_span_range _ _ I rfl
  refine ⟨S ⧸ I, inferInstance, inferInstance, inferInstance, u, v, hvu, ?_⟩
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
  intro q hq
  by_contra haq
  refine hq ?_
  by_cases hπq : algebraMap R (S ⧸ I) π ∈ q.asIdeal
  · exact smoothAt_deformation_quotient_of_mem P π c hcm r s hf hcond g hg hgmod I rfl
      q.asIdeal hπq a ha haq
  · exact smoothAt_deformation_quotient_of_notMem P π c hcm r s g hg I rfl u hu hstandard
      q.asIdeal hπq

end Stacks.Smoothing

end
