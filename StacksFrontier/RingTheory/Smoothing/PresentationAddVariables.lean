module

public import StacksFrontier.RingTheory.Smoothing.AlgebraPresentation

/-!
# Adding variables to a presentation

Let `R → A` be a ring map and let `P` be a presentation
`A = R[x_1, …, x_n]/(f_1, …, f_m)` in the sense of Stacks 16.2. For every `r` this file
builds the presentation
`A = R[x_1, …, x_n, y_1, …, y_r]/(f_1, …, f_m, y_1, …, y_r)`
obtained by adjoining `r` variables and killing them, and allows a further list
`w_1, …, w_c` of elements of the relation ideal to be put in front of the relations. This
is the move the proof of Stacks 16.3.7 (e) makes to realize a free direct summand inside
the conormal module of a presentation.

## Main definitions

* `Stacks.Smoothing.killLastVars`: the map `R[x, y] → R[x]` setting the last `r`
  variables to zero.
* `Stacks.Smoothing.addVarsHom`: the induced surjection `R[x, y] → A`.
* `Stacks.Smoothing.addVarsRels`: the relations `f_1, …, f_m, y_1, …, y_r`.
* `Stacks.Smoothing.addVarsPresentation`: the presentation of `A` they define, with a
  prescribed list of further relations in front.

## Main results

* `Stacks.Smoothing.ker_addVarsHom`: the kernel of the surjection is generated by the
  relations, i.e. the displayed presentation is one.
* `Stacks.Smoothing.addVarsPresentation_lift`: its lift map is `addVarsHom`.
* `Stacks.Smoothing.pderiv_castAdd_rename` and
  `Stacks.Smoothing.pderiv_natAdd_rename`: the partial derivatives of an old polynomial
  in the old and in the new variables.

## References

* [Stacks Project, Tag 07EZ](https://stacks.math.columbia.edu/tag/07EZ)
-/

@[expose] public section

namespace Stacks.Smoothing

open MvPolynomial

universe u v

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- Every index of `Fin (n + r)` is either one of the first `n` or one of the last `r`. -/
theorem fin_eq_castAdd_or_natAdd {n r : ℕ} (i : Fin (n + r)) :
    (∃ j : Fin n, i = Fin.castAdd r j) ∨ ∃ j : Fin r, i = Fin.natAdd n j := by
  by_cases h : (i : ℕ) < n
  · exact Or.inl ⟨⟨i, h⟩, Fin.ext rfl⟩
  · refine Or.inr ⟨⟨(i : ℕ) - n, by omega⟩, Fin.ext ?_⟩
    show (i : ℕ) = n + ((i : ℕ) - n)
    omega

section KillLastVars

variable (R) in
/-- The `R`-algebra map `R[x_1, …, x_n, y_1, …, y_r] → R[x_1, …, x_n]` setting the last
`r` variables to zero. -/
noncomputable def killLastVars (n r : ℕ) :
    MvPolynomial (Fin (n + r)) R →ₐ[R] MvPolynomial (Fin n) R :=
  aeval (Fin.append X 0)

variable {n r : ℕ}

/-- `killLastVars` sends each of the first `n` variables `x_i` to `x_i`. -/
@[simp] theorem killLastVars_X_castAdd (i : Fin n) :
    killLastVars R n r (X (Fin.castAdd r i)) = X i := by
  simp [killLastVars]

/-- `killLastVars` sends each of the last `r` variables `y_i` to zero. -/
@[simp] theorem killLastVars_X_natAdd (i : Fin r) :
    killLastVars R n r (X (Fin.natAdd n i)) = 0 := by
  simp [killLastVars]

/-- `killLastVars` is a retraction of the inclusion
`R[x_1, …, x_n] → R[x_1, …, x_n, y_1, …, y_r]`. -/
theorem killLastVars_rename (p : MvPolynomial (Fin n) R) :
    killLastVars R n r (rename (Fin.castAdd r) p) = p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp]

variable (R n r) in
/-- The ideal of `R[x_1, …, x_n, y_1, …, y_r]` generated by the last `r` variables. -/
noncomputable def lastVarsIdeal : Ideal (MvPolynomial (Fin (n + r)) R) :=
  Ideal.span (Set.range fun i : Fin r => X (Fin.natAdd n i))

/-- Each of the last `r` variables `y_i` lies in `lastVarsIdeal`. -/
theorem X_natAdd_mem_lastVarsIdeal (i : Fin r) :
    (X (Fin.natAdd n i) : MvPolynomial (Fin (n + r)) R) ∈ lastVarsIdeal R n r :=
  Ideal.subset_span ⟨i, rfl⟩

/-- A polynomial agrees with the image of its specialization modulo the last variables. -/
theorem sub_rename_killLastVars_mem (p : MvPolynomial (Fin (n + r)) R) :
    p - rename (Fin.castAdd r) (killLastVars R n r p) ∈ lastVarsIdeal R n r := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
      have := Ideal.add_mem (lastVarsIdeal R n r) hp hq
      simpa only [map_add, add_sub_add_comm] using this
  | mul_X p i hp =>
      rcases fin_eq_castAdd_or_natAdd i with ⟨j, rfl⟩ | ⟨j, rfl⟩
      · have := Ideal.mul_mem_right (X (Fin.castAdd r j)) (lastVarsIdeal R n r) hp
        simpa only [map_mul, killLastVars_X_castAdd, rename_X, sub_mul] using this
      · simpa only [map_mul, killLastVars_X_natAdd, mul_zero, map_zero, sub_zero] using
          Ideal.mul_mem_left (lastVarsIdeal R n r) p (X_natAdd_mem_lastVarsIdeal j)

variable (R n r) in
/-- The kernel of `killLastVars` is `lastVarsIdeal`, the ideal generated by the last `r`
variables. -/
theorem ker_killLastVars :
    RingHom.ker (killLastVars R n r).toRingHom = lastVarsIdeal R n r := by
  apply le_antisymm
  · intro p hp
    have hp0 : killLastVars R n r p = 0 := hp
    have := sub_rename_killLastVars_mem (R := R) (n := n) (r := r) p
    rwa [hp0, map_zero, sub_zero] at this
  · rw [lastVarsIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact killLastVars_X_natAdd i

end KillLastVars

section AddVars

/-- Membership in the relation ideal of a presentation is vanishing of the lift. -/
theorem mem_relIdeal_iff_lift_eq_zero (P : Presentation R A)
    (p : MvPolynomial (Fin P.n) R) : p ∈ P.relIdeal ↔ P.lift p = 0 := by
  rw [Presentation.lift, map_eq_zero_iff _ P.iso.symm.injective, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq_zero_iff_mem]
  rfl

/-- The surjection `R[x_1, …, x_n, y_1, …, y_r] → A` of the presentation with `r` extra
variables: the old surjection precomposed with setting the new variables to zero. -/
noncomputable def addVarsHom (P : Presentation R A) (r : ℕ) :
    MvPolynomial (Fin (P.n + r)) R →ₐ[R] A :=
  (aeval (toAlgebraPresentation P).toGenerators.val).comp (killLastVars R P.n r)

variable (P : Presentation R A) (r : ℕ)

/-- On polynomials in the old variables, `addVarsHom` is the lift map of `P`. -/
theorem addVarsHom_rename (p : MvPolynomial (Fin P.n) R) :
    addVarsHom P r (rename (Fin.castAdd r) p) = P.lift p := by
  show aeval (toAlgebraPresentation P).toGenerators.val
    (killLastVars R P.n r (rename (Fin.castAdd r) p)) = _
  rw [killLastVars_rename, aeval_toAlgebraPresentation]

/-- `addVarsHom` sends each of the new variables `y_i` to zero. -/
@[simp] theorem addVarsHom_X_natAdd (i : Fin r) :
    addVarsHom P r (X (Fin.natAdd P.n i)) = 0 := by
  show aeval (toAlgebraPresentation P).toGenerators.val
    (killLastVars R P.n r (X (Fin.natAdd P.n i))) = _
  rw [killLastVars_X_natAdd, map_zero]

/-- The map `addVarsHom P r : R[x_1, …, x_n, y_1, …, y_r] → A` is surjective. -/
theorem addVarsHom_surjective : Function.Surjective (addVarsHom P r) := by
  intro x
  obtain ⟨p, hp⟩ := Ideal.Quotient.mkₐ_surjective R (Ideal.span (Set.range P.f)) (P.iso x)
  refine ⟨rename (Fin.castAdd r) p, ?_⟩
  rw [addVarsHom_rename]
  show P.iso.symm (Ideal.Quotient.mkₐ R (Ideal.span (Set.range P.f)) p) = x
  rw [hp]
  simp

/-- The relations of the presentation with `r` extra variables: the old relations,
renamed, followed by the new variables. -/
noncomputable def addVarsRels : Fin (P.m + r) → MvPolynomial (Fin (P.n + r)) R :=
  Fin.append (fun j => rename (Fin.castAdd r) (P.f j)) fun i => X (Fin.natAdd P.n i)

/-- The first `m` relations of `addVarsRels` are the relations `f_j` of `P`. -/
@[simp] theorem addVarsRels_castAdd (j : Fin P.m) :
    addVarsRels P r (Fin.castAdd r j) = rename (Fin.castAdd r) (P.f j) :=
  Fin.append_left _ _ j

/-- The last `r` relations of `addVarsRels` are the new variables `y_i`. -/
@[simp] theorem addVarsRels_natAdd (i : Fin r) :
    addVarsRels P r (Fin.natAdd P.m i) = X (Fin.natAdd P.n i) :=
  Fin.append_right _ _ i

/-- Each relation of `addVarsRels` lies in the kernel of `addVarsHom`. -/
theorem addVarsRels_mem_ker (j : Fin (P.m + r)) :
    addVarsRels P r j ∈ RingHom.ker (addVarsHom P r).toRingHom := by
  rcases fin_eq_castAdd_or_natAdd j with ⟨k, rfl⟩ | ⟨k, rfl⟩
  · show addVarsHom P r (addVarsRels P r (Fin.castAdd r k)) = 0
    rw [addVarsRels_castAdd, addVarsHom_rename]
    exact (mem_relIdeal_iff_lift_eq_zero P (P.f k)).1 (Ideal.subset_span ⟨k, rfl⟩)
  · show addVarsHom P r (addVarsRels P r (Fin.natAdd P.m k)) = 0
    rw [addVarsRels_natAdd, addVarsHom_X_natAdd]

/-- The kernel of `addVarsHom` is the ideal generated by the relations
`f_1, …, f_m, y_1, …, y_r`. -/
theorem ker_addVarsHom :
    RingHom.ker (addVarsHom P r).toRingHom = Ideal.span (Set.range (addVarsRels P r)) := by
  apply le_antisymm
  · intro p hp
    have hp0 : addVarsHom P r p = 0 := hp
    set q := killLastVars R P.n r p with hq
    have hqmem : q ∈ P.relIdeal := by
      refine (mem_relIdeal_iff_lift_eq_zero P q).2 ?_
      rw [← aeval_toAlgebraPresentation]
      exact hp0
    obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.1 hqmem
    have hrenq : rename (Fin.castAdd r) q ∈ Ideal.span (Set.range (addVarsRels P r)) := by
      rw [← hb, map_sum]
      refine Ideal.sum_mem _ fun j _ => ?_
      rw [map_mul]
      refine Ideal.mul_mem_left _ _ ?_
      exact Ideal.subset_span ⟨Fin.castAdd r j, by rw [addVarsRels_castAdd]⟩
    have hdiff : p - rename (Fin.castAdd r) q ∈ Ideal.span (Set.range (addVarsRels P r)) := by
      refine Ideal.span_mono ?_ (sub_rename_killLastVars_mem (R := R) (n := P.n) (r := r) p)
      rintro _ ⟨i, rfl⟩
      exact ⟨Fin.natAdd P.m i, by rw [addVarsRels_natAdd]⟩
    simpa using Ideal.add_mem _ hdiff hrenq
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact addVarsRels_mem_ker P r j

variable {c : ℕ} (w : Fin c → MvPolynomial (Fin (P.n + r)) R)
  (hw : ∀ k, addVarsHom P r (w k) = 0)

include hw in
/-- If `w_1, …, w_c` lie in the kernel of `addVarsHom`, then together with `addVarsRels` they
generate that kernel. -/
theorem span_range_addVars_f :
    Ideal.span (Set.range (Fin.append w (addVarsRels P r))) =
      RingHom.ker (addVarsHom P r).toRingHom := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rcases fin_eq_castAdd_or_natAdd j with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · rw [show Fin.append w (addVarsRels P r) (Fin.castAdd (P.m + r) k) = w k from
        Fin.append_left _ _ k]
      exact hw k
    · rw [show Fin.append w (addVarsRels P r) (Fin.natAdd c k) = addVarsRels P r k from
        Fin.append_right _ _ k]
      exact addVarsRels_mem_ker P r k
  · rw [ker_addVarsHom, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨Fin.natAdd c j, Fin.append_right _ _ j⟩

/-- The presentation of `A` with `r` extra variables, the relations `w_1, …, w_c` in
front of the old relations and the new variables. -/
noncomputable def addVarsPresentation : Presentation R A where
  n := P.n + r
  m := c + (P.m + r)
  f := Fin.append w (addVarsRels P r)
  iso := (Ideal.quotientKerAlgEquivOfSurjective (addVarsHom_surjective P r)).symm.trans
    (Ideal.quotientEquivAlgOfEq R (span_range_addVars_f P r w hw).symm)

/-- `addVarsPresentation` has `n + r` variables. -/
@[simp] theorem addVarsPresentation_n : (addVarsPresentation P r w hw).n = P.n + r := rfl

/-- `addVarsPresentation` has `c + (m + r)` relations. -/
@[simp] theorem addVarsPresentation_m :
    (addVarsPresentation P r w hw).m = c + (P.m + r) := rfl

/-- The relations of `addVarsPresentation` are `w_1, …, w_c` followed by `addVarsRels`. -/
@[simp] theorem addVarsPresentation_f :
    (addVarsPresentation P r w hw).f = Fin.append w (addVarsRels P r) := rfl

/-- The lift map of `addVarsPresentation` is `addVarsHom`. -/
theorem addVarsPresentation_lift (p : MvPolynomial (Fin (P.n + r)) R) :
    (addVarsPresentation P r w hw).lift p = addVarsHom P r p := by
  show ((Ideal.quotientKerAlgEquivOfSurjective (addVarsHom_surjective P r)).symm.trans
    (Ideal.quotientEquivAlgOfEq R (span_range_addVars_f P r w hw).symm)).symm
      (Ideal.Quotient.mkₐ R _ p) = _
  rw [AlgEquiv.symm_trans_apply]
  show (Ideal.quotientKerAlgEquivOfSurjective (addVarsHom_surjective P r))
    ((Ideal.quotientEquivAlgOfEq R (span_range_addVars_f P r w hw).symm).symm
      (Ideal.Quotient.mk _ p)) = _
  rw [show (Ideal.quotientEquivAlgOfEq R (span_range_addVars_f P r w hw).symm).symm
    (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ p from rfl]
  rfl

/-- The relation ideal of `addVarsPresentation` is the kernel of `addVarsHom`. -/
theorem addVarsPresentation_relIdeal :
    (addVarsPresentation P r w hw).relIdeal = RingHom.ker (addVarsHom P r).toRingHom :=
  span_range_addVars_f P r w hw

end AddVars

section Pderiv

variable {n r : ℕ}

/-- The partial derivative of an old polynomial in an old variable `x_i` is the renamed
partial derivative in `x_i`. -/
theorem pderiv_castAdd_rename (i : Fin n) (p : MvPolynomial (Fin n) R) :
    pderiv (Fin.castAdd r i) (rename (Fin.castAdd r) p) =
      rename (Fin.castAdd r) (pderiv i p) :=
  pderiv_rename (Fin.castAdd_injective n r) i p

/-- An old polynomial has zero partial derivative in each new variable `y_i`. -/
theorem pderiv_natAdd_rename (i : Fin r) (p : MvPolynomial (Fin n) R) :
    pderiv (Fin.natAdd n i) (rename (Fin.castAdd r) p) = 0 := by
  refine pderiv_eq_zero_of_notMem_vars fun hmem => ?_
  obtain ⟨j, -, hj⟩ := Finset.mem_image.1 (vars_rename (Fin.castAdd r) p hmem)
  exact absurd (congrArg Fin.val hj) (by simp; omega)

end Pderiv


section Combination

variable {n r : ℕ}

/-- A last index of `Fin (n + r)` is never one of the first `n` indices. -/
theorem natAdd_ne_castAdd (i : Fin n) (i' : Fin r) :
    (Fin.natAdd n i' : Fin (n + r)) ≠ Fin.castAdd r i := by
  intro h
  have hv : n + (i' : ℕ) = (i : ℕ) := congrArg Fin.val h
  have := i.isLt
  omega

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- An element of the relation ideal of `addVarsPresentation`, written out in the
relations of `P` and the new variables. -/
noncomputable def addVarsCombination (P : Presentation R A) (r : ℕ)
    (up : Fin P.m → MvPolynomial (Fin P.n) R) (vp : Fin r → MvPolynomial (Fin P.n) R) :
    MvPolynomial (Fin (P.n + r)) R :=
  (∑ j : Fin P.m, rename (Fin.castAdd r) (up j) * rename (Fin.castAdd r) (P.f j)) +
    ∑ i : Fin r, rename (Fin.castAdd r) (vp i) * X (Fin.natAdd P.n i)

variable (P : Presentation R A) (r : ℕ) (up : Fin P.m → MvPolynomial (Fin P.n) R)
  (vp : Fin r → MvPolynomial (Fin P.n) R)

/-- The lift map of `P` kills each relation `f_j`. -/
theorem lift_relation_eq_zero (j : Fin P.m) : P.lift (P.f j) = 0 :=
  (mem_relIdeal_iff_lift_eq_zero P (P.f j)).1 (Ideal.subset_span ⟨j, rfl⟩)

/-- The partial derivative of `addVarsCombination` in any variable, after applying
`addVarsHom`. -/
private theorem addVarsHom_pderiv_addVarsCombination (v : Fin (P.n + r)) :
    addVarsHom P r (pderiv v (addVarsCombination P r up vp)) =
      (∑ j : Fin P.m, P.lift (up j) * addVarsHom P r (pderiv v (rename (Fin.castAdd r) (P.f j)))) +
        ∑ i : Fin r, P.lift (vp i) * addVarsHom P r (pderiv v (X (Fin.natAdd P.n i))) := by
  simp only [addVarsCombination, map_add, map_sum, pderiv_mul, map_mul, addVarsHom_rename,
    addVarsHom_X_natAdd, lift_relation_eq_zero, mul_zero, zero_add]

/-- `addVarsHom` kills `addVarsCombination`. -/
@[simp] theorem addVarsHom_addVarsCombination :
    addVarsHom P r (addVarsCombination P r up vp) = 0 := by
  have h1 : ∀ j : Fin P.m, addVarsHom P r
      (rename (Fin.castAdd r) (up j) * rename (Fin.castAdd r) (P.f j)) = 0 := by
    intro j
    rw [map_mul, addVarsHom_rename, addVarsHom_rename, lift_relation_eq_zero, mul_zero]
  have h2 : ∀ i : Fin r, addVarsHom P r
      (rename (Fin.castAdd r) (vp i) * X (Fin.natAdd P.n i)) = 0 := by
    intro i
    rw [map_mul, addVarsHom_X_natAdd, mul_zero]
  simp only [addVarsCombination, map_add, map_sum, h1, h2, Finset.sum_const_zero, add_zero]

/-- The partial derivative of `addVarsCombination` in an old variable is, in `A`, the
corresponding entry of the product of the Jacobian matrix of `P` with the coefficients. -/
theorem addVarsHom_pderiv_castAdd_addVarsCombination (i : Fin P.n) :
    addVarsHom P r (pderiv (Fin.castAdd r i) (addVarsCombination P r up vp)) =
      ∑ j : Fin P.m, P.lift (up j) * P.lift (pderiv i (P.f j)) := by
  rw [addVarsHom_pderiv_addVarsCombination]
  simp [pderiv_castAdd_rename, addVarsHom_rename, pderiv_X_of_ne (natAdd_ne_castAdd i _)]

/-- The partial derivative of `addVarsCombination` in a new variable is, in `A`, the
corresponding coefficient. -/
theorem addVarsHom_pderiv_natAdd_addVarsCombination (i : Fin r) :
    addVarsHom P r (pderiv (Fin.natAdd P.n i) (addVarsCombination P r up vp)) =
      P.lift (vp i) := by
  classical
  rw [addVarsHom_pderiv_addVarsCombination]
  simp [pderiv_natAdd_rename, pderiv_X, Pi.single_apply]

end Combination

end Stacks.Smoothing

end
