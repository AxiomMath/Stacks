module

public import Mathlib.RingTheory.Extension.Cotangent.LocalizationAway
public import Mathlib.RingTheory.Flat.Localization
public import StacksCore.Tactic.StacksAttribute

/-!
# The localized conormal sequence

The conormal sequence associated to presentations of `R → A → C` remains exact after localizing
`C` at the image of an element of `A`. The presentations obtained by adjoining an inverse have an
additional free rank-one conormal summand, generated by the relation `aX - 1`.

## Main definitions

* `Stacks.Smoothing.localizationRelationCotangent`: the conormal class of the relation
  `aX - 1` adjoined when an inverse of `a` is adjoined to a presentation.
* `Stacks.Smoothing.localizedConormalEquiv`: the conormal module of the presentation obtained by
  adjoining an inverse, with its free generator explicitly fixed.
* `Stacks.Smoothing.localizedConormalIncoming` and `Stacks.Smoothing.localizedConormalOutgoing`:
  the maps in the displayed localized sequence.

## Main results

* `Stacks.Smoothing.localizedConormalEquiv_freeGenerator` identifies the free generator, while
  `Stacks.Smoothing.localizedConormalEquiv_symm_comp_inr` records compatibility with the canonical
  conormal map.
* `Stacks.Smoothing.localizedConormalSequence_exact` and
  `Stacks.Smoothing.localizedConormalSequence_surjective` state that the displayed sequence is
  exact and terminates in zero.

## Implementation notes

Write `P` for the presentation of `A`, `Q.comp P` for the presentation of `C`, and `K` for the
kernel module in the symmetric-algebra construction. The equivalence `eK` is its canonical
identification between the localization of the relative conormal module and `K ⊗_A C_a`. Thus the
three modules below are exactly `C_a ⊕ (I/I² ⊗_A C_a)`, `C_a ⊕ (J/J²)_a`, and `K ⊗_A C_a`. The
free factors are the conormal classes of the actual localization relations, as fixed by
`localizedConormalEquiv_freeGenerator`.

Tensor products put the scalar algebra first, following Mathlib's convention.

## References

* [Stacks Project, Tag 07EX](https://stacks.math.columbia.edu/tag/07EX)
-/

@[expose] public section

open scoped TensorProduct
open MvPolynomial

namespace Stacks.Smoothing

universe uR uA uC uL uK uι uκ

variable {R : Type uR} {A : Type uA} {C : Type uC} {L : Type uL}
  [CommRing R] [CommRing A] [CommRing C] [CommRing L]
  [Algebra R A] [Algebra R C] [Algebra A C] [IsScalarTower R A C]
  [Algebra A L] [Algebra C L] [IsScalarTower A C L]

/-- The class of `P.σ(a) X - 1` in the conormal module of the presentation obtained from `P` by
adjoining an inverse to `a`. -/
noncomputable def localizationRelationCotangent
    {S : Type*} [CommRing S] [Algebra R S] [Algebra A S] [IsScalarTower R A S]
    {I : Type uι} (P : Algebra.Generators R A I) (a : A)
    [IsLocalization.Away a S] :
    ((Algebra.Generators.localizationAway S a).comp P).toExtension.Cotangent :=
  Algebra.Extension.Cotangent.mk ⟨
    rename Sum.inr (P.σ a) * X (Sum.inl ()) - 1,
    by
      change rename Sum.inr (P.σ a) * X (Sum.inl ()) - 1 ∈
        ((Algebra.Generators.localizationAway S a).comp P).ker
      rw [Algebra.Generators.comp_localizationAway_ker (T := S) a P (P.σ a) (by simp)]
      exact Submodule.mem_sup_right (Ideal.mem_span_singleton_self _)⟩

/-- The canonical description of the conormal module of the genuine localization presentation.
The first factor is generated by the newly adjoined relation `P.σ(a) X - 1`; the second is the
localized old conormal module. -/
@[stacks 07EX "the two localized conormal-module identifications"]
noncomputable def localizedConormalEquiv
    {S : Type*} [CommRing S] [Algebra R S] [Algebra A S] [IsScalarTower R A S]
    {I : Type uι} (P : Algebra.Generators R A I) (a : A)
    [IsLocalization.Away a S] :
    ((Algebra.Generators.localizationAway S a).comp P).toExtension.Cotangent ≃ₗ[S]
      S × (S ⊗[A] P.toExtension.Cotangent) :=
  let h : (Algebra.Extension.Cotangent.map
      ((Algebra.Generators.localizationAway S a).ofComp P).toExtensionHom)
      (localizationRelationCotangent P a) =
      Algebra.Generators.cMulXSubOneCotangent S a := by
      rw [localizationRelationCotangent, Algebra.Extension.Cotangent.map_mk]
      congr 1
      exact Subtype.ext (Algebra.Generators.toAlgHom_ofComp_localizationAway P a)
  let eFree : (Algebra.Generators.localizationAway S a).toExtension.Cotangent ≃ₗ[S] S :=
    ((Algebra.Generators.basisCotangentAway S a).repr.trans
      (Finsupp.linearEquivFunOnFinite S S Unit)).trans
      (LinearEquiv.funUnique Unit S S)
  ((Algebra.Generators.cotangentCompLocalizationAwayEquiv (T := S) a P
      (x := localizationRelationCotangent P a) h).trans
    (LinearEquiv.prodCongr
      (LinearEquiv.refl S (S ⊗[A] P.toExtension.Cotangent)) eFree)).trans
    (LinearEquiv.prodComm S (S ⊗[A] P.toExtension.Cotangent) S)

/-- The direct-sum identification sends the class of the new relation `P.σ(a) X - 1` to the free
generator. -/
@[stacks 07EX "the free generator in the localized identifications"]
theorem localizedConormalEquiv_freeGenerator
    {S : Type*} [CommRing S] [Algebra R S] [Algebra A S] [IsScalarTower R A S]
    {I : Type uι} (P : Algebra.Generators R A I) (a : A)
    [IsLocalization.Away a S] :
    (localizedConormalEquiv (S := S) P a)
        (localizationRelationCotangent (S := S) P a) = (1, 0) := by
  have h : (Algebra.Extension.Cotangent.map
      ((Algebra.Generators.localizationAway S a).ofComp P).toExtensionHom)
      (localizationRelationCotangent P a) =
      Algebra.Generators.cMulXSubOneCotangent S a := by
    rw [localizationRelationCotangent, Algebra.Extension.Cotangent.map_mk]
    congr 1; exact Subtype.ext (Algebra.Generators.toAlgHom_ofComp_localizationAway P a)
  have hx : (Algebra.Generators.cotangentCompLocalizationAwayEquiv a P h)
      (localizationRelationCotangent P a) =
      (0, Algebra.Generators.cMulXSubOneCotangent S a) :=
    LinearEquiv.eq_symm_apply _ |>.mp
      (Algebra.Generators.cotangentCompLocalizationAwayEquiv_symm_inr a P h).symm
  simp only [localizedConormalEquiv, hx, LinearEquiv.trans_apply,
    LinearEquiv.prodCongr_apply, LinearEquiv.refl_apply, LinearEquiv.prodComm_apply]
  rw [← Algebra.Generators.basisCotangentAway_apply (S := S) (r := a) ()]; simp

/-- On the localized old conormal summand, the inverse direct-sum identification is the canonical
base-changed conormal map. -/
@[stacks 07EX "compatibility of the localized identifications"]
theorem localizedConormalEquiv_symm_comp_inr
    {S : Type*} [CommRing S] [Algebra R S] [Algebra A S] [IsScalarTower R A S]
    {I : Type uι} (P : Algebra.Generators R A I) (a : A)
    [IsLocalization.Away a S] :
    (localizedConormalEquiv (S := S) P a).symm.toLinearMap ∘ₗ
        LinearMap.inr S S (S ⊗[A] P.toExtension.Cotangent) =
      (Algebra.Extension.Cotangent.map
        ((Algebra.Generators.localizationAway S a).toComp P).toExtensionHom).liftBaseChange S := by
  ext x
  simp [localizedConormalEquiv,
    Algebra.Generators.cotangentCompLocalizationAwayEquiv_symm_inl]

variable {I : Type uι} {J : Type uκ}
  (P : Algebra.Generators R A I) (Q : Algebra.Generators A C J)

/-- The localized arrow `C_a ⊕ (I/I² ⊗_A C_a) → C_a ⊕ (J/J²)_a`. It is the identity on the
localization relation and the base change of the canonical conormal map on the other summand. -/
noncomputable def localizedConormalIncoming :
    L × (L ⊗[A] P.toExtension.Cotangent) →ₗ[L]
      L × (L ⊗[C] (Q.comp P).toExtension.Cotangent) :=
  LinearMap.prodMap LinearMap.id
    ((LinearMap.baseChange L
        ((Algebra.Extension.Cotangent.map (Q.toComp P).toExtensionHom).liftBaseChange C)) ∘ₗ
      (TensorProduct.AlgebraTensorModule.cancelBaseChange A C L L
        P.toExtension.Cotangent).symm.toLinearMap)

/-- The localized arrow `C_a ⊕ (J/J²)_a → K ⊗_A C_a`. The equivalence `eK` is the canonical
symmetric-algebra identification of its target. -/
noncomputable def localizedConormalOutgoing
    {K : Type uK} [AddCommGroup K] [Module A K]
    (eK : (L ⊗[C] Q.toExtension.Cotangent) ≃ₗ[L] (L ⊗[A] K)) :
    L × (L ⊗[C] (Q.comp P).toExtension.Cotangent) →ₗ[L] (L ⊗[A] K) :=
  eK.toLinearMap ∘ₗ
    LinearMap.baseChange L
      (Algebra.Extension.Cotangent.map (Q.ofComp P).toExtensionHom) ∘ₗ
    LinearMap.snd L L (L ⊗[C] (Q.comp P).toExtension.Cotangent)

/-- Exactness at `C_a ⊕ (J/J²)_a` in the localized conormal sequence. -/
@[stacks 07EX "exactness at the middle term"]
theorem localizedConormalSequence_exact
    (a : A) [IsLocalization.Away (algebraMap A C a) L]
    {K : Type uK} [AddCommGroup K] [Module A K]
    (eK : (L ⊗[C] Q.toExtension.Cotangent) ≃ₗ[L] (L ⊗[A] K)) :
    Function.Exact (localizedConormalIncoming P Q)
      (localizedConormalOutgoing P Q eK) := by
  let : Module.Flat C L := IsLocalization.flat L (Submonoid.powers (algebraMap A C a))
  have h := Module.Flat.lTensor_exact L (Algebra.Generators.Cotangent.exact Q P)
  simp only [← LinearMap.baseChange_eq_lTensor] at h
  let e := TensorProduct.AlgebraTensorModule.cancelBaseChange A C L L P.toExtension.Cotangent
  rintro ⟨x, y⟩
  simp only [localizedConormalOutgoing, localizedConormalIncoming,
    LinearMap.comp_apply, LinearMap.snd_apply]
  constructor
  · intro hy
    obtain ⟨z, hz⟩ := (h y).mp (eK.injective (hy.trans (map_zero eK).symm))
    refine ⟨(x, e z), ?_⟩
    ext <;> simp [e, hz]
  · rintro ⟨z, hz⟩
    simp [(h y).mpr ⟨e.symm z.2, congrArg Prod.snd hz⟩]

omit [IsScalarTower A C L]

/-- The final arrow is surjective, so the localized conormal sequence ends in zero. -/
@[stacks 07EX "surjectivity onto the final term"]
theorem localizedConormalSequence_surjective
    (a : A) [IsLocalization.Away (algebraMap A C a) L]
    {K : Type uK} [AddCommGroup K] [Module A K]
    (eK : (L ⊗[C] Q.toExtension.Cotangent) ≃ₗ[L] (L ⊗[A] K)) :
    Function.Surjective (localizedConormalOutgoing P Q eK) :=
  eK.surjective.comp ((LinearMap.baseChange_surjective L
    (Algebra.Generators.Cotangent.surjective_map_ofComp Q P)).comp
      LinearMap.snd_surjective)

end Stacks.Smoothing
