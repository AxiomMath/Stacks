/-!
# A prime minimal over the singular ideal of a local smoothing situation

Let `R → A → Λ ⊃ q` be a local smoothing situation and write `H_{A/R}` for the singular ideal of
`A` over `R` and `𝔥_A = √(H_{A/R} Λ)`. The singular ideal is finitely generated, because `A` is
Noetherian. If moreover `Λ` is Noetherian, the Krull dimension of `Λ_q` is a natural number, and
if `q` is minimal over `𝔥_A` then `q Λ_q` is the radical of `H_{A/R} Λ_q`, so a positive power of
`q` already extends into `H_{A/R} Λ_q`.

## Main results

* `Stacks.Smoothing.LocalSmoothingSituation.exists_pos_map_pow_le_map_singularIdeal`:
  `q ^ N Λ_q ⊆ H_{A/R} Λ_q` for some `N > 0`, when `q` is minimal over `𝔥_A`.
* `Stacks.Smoothing.LocalSmoothingSituation.exists_fin_span_range_eq_singularIdeal`: a finite
  family of elements of `A` generating `H_{A/R}`.
* `Stacks.Smoothing.LocalSmoothingSituation.exists_nat_eq_ringKrullDim_localization`: the Krull
  dimension of `Λ_q` is a natural number.

## Implementation notes

The localization `Λ_q` is modelled by `Localization.AtPrime q`, and the containment
`q ^ N Λ_q ⊆ H_{A/R} Λ_q` is the inequality between the extensions of `q ^ N` and of
`H_{A/R} Λ` along the canonical algebra map; this is the shape in which
`Stacks.Smoothing.exists_parameters_pow_mem_and_annihilator_sq_eq` requires the same
containment.

## References

* [Stacks Project, Tag 07FK](https://stacks.math.columbia.edu/tag/07FK)
* [Stacks Project, Tag 07FL](https://stacks.math.columbia.edu/tag/07FL)
* [Stacks Project, Tag 07FM](https://stacks.math.columbia.edu/tag/07FM)
-/

@[expose] public section

namespace Stacks.Smoothing

universe u v w

namespace LocalSmoothingSituation

variable (S : LocalSmoothingSituation.{u, v, w})

/-- **Stacks 07FK.** In a local smoothing situation with `Λ` Noetherian and `q` minimal over
`𝔥_A = √(H_{A/R} Λ)`, some positive power of `q` extends into `H_{A/R} Λ_q`. -/
@[stacks 07FK]
theorem exists_pos_map_pow_le_map_singularIdeal [IsNoetherianRing S.Λ]
    (hq : S.q ∈ S.radicalSingularIdealExtension.minimalPrimes) :
    ∃ N : ℕ, 0 < N ∧
      Ideal.map (algebraMap S.Λ (Localization.AtPrime S.q)) (S.q ^ N) ≤
        Ideal.map (algebraMap S.Λ (Localization.AtPrime S.q))
          (Ideal.map (algebraMap S.A S.Λ) (singularIdeal S.R S.A)) := by
  set L := Localization.AtPrime S.q with hL
  set H : Ideal S.Λ := Ideal.map (algebraMap S.A S.Λ) (singularIdeal S.R S.A) with hH
  -- `q` is minimal over `H` itself, since `𝔥_A` is the radical of `H`.
  have hqH : S.q ∈ H.minimalPrimes := by
    have h : S.q ∈ H.radical.minimalPrimes := hq
    rwa [Ideal.radical_minimalPrimes] at h
  -- Minimality says that `H Λ_q` has radical the maximal ideal of `Λ_q`.
  have hrad : (Ideal.map (algebraMap S.Λ L) H).radical = Ideal.map (algebraMap S.Λ L) S.q :=
    IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes L S.q H hqH
  have hmax : Ideal.map (algebraMap S.Λ L) S.q = IsLocalRing.maximalIdeal L :=
    IsLocalization.AtPrime.map_eq_maximalIdeal S.q L
  -- That maximal ideal is finitely generated, so a power of it lies in `H Λ_q`.
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg
    (I := IsLocalRing.maximalIdeal L) (J := Ideal.map (algebraMap S.Λ L) H)
    (by rw [← hmax]; exact hrad.symm.le) (Ideal.fg_of_isNoetherianRing _)
  refine ⟨n + 1, Nat.succ_pos n, ?_⟩
  rw [Ideal.map_pow, hmax]
  exact (Ideal.pow_le_pow_right (Nat.le_succ n)).trans hn

/-- **Stacks 07FL.** The singular ideal `H_{A/R}` of a local smoothing situation is generated by
finitely many elements of `A`. -/
@[stacks 07FL]
theorem exists_fin_span_range_eq_singularIdeal :
    ∃ (t : ℕ) (a : Fin t → S.A), Ideal.span (Set.range a) = singularIdeal S.R S.A := by
  have : IsNoetherianRing S.A := Algebra.FiniteType.isNoetherianRing S.R S.A
  exact Submodule.fg_iff_exists_fin_generating_family.mp
    (Ideal.fg_of_isNoetherianRing (singularIdeal S.R S.A))

/-- **Stacks 07FM.** The Krull dimension of the localization `Λ_q` of a local smoothing situation
with `Λ` Noetherian is a natural number. -/
@[stacks 07FM]
theorem exists_nat_eq_ringKrullDim_localization [IsNoetherianRing S.Λ] :
    ∃ d : ℕ, ringKrullDim (Localization.AtPrime S.q) = (d : WithBot ℕ∞) := by
  set L := Localization.AtPrime S.q with hL
  have hbot : ringKrullDim L ≠ ⊥ := by
    intro h
    have hnn := (zero_le_ringKrullDim_iff_nontrivial (R := L)).mpr inferInstance
    rw [h] at hnn
    simp at hnn
  cases hx : ringKrullDim L with
  | bot => exact (hbot hx).elim
  | coe x =>
    cases x with
    | top => exact (ringKrullDim_ne_top hx).elim
    | coe d => exact ⟨d, by simp⟩

end LocalSmoothingSituation

end Stacks.Smoothing

end
