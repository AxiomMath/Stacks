module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Smoothing.ImprovingPresentations

/-!
# Adjoining generic elements with a prescribed power in an ideal

Let `A` be an algebra of finite type over a ring `k`, let `a_1, …, a_t ∈ A` and fix `d, N`.
Adjoining to `A` indeterminates `x_1, …, x_d` and `z_{ij}` subject to the relations
`x_i^{2N} = Σ_j z_{ij} a_j` produces an `A`-algebra `B` in which the `2N`-th power of each `x_i`
lies in the ideal `(a_1, …, a_t) B`, and `B` is of finite presentation over `k[x_1, …, x_d]`
through `x_i ↦ x_i`. Applying Stacks 07CE over that base yields a finite-type `B`-algebra `C`
with a `k[x_1, …, x_d]`-algebra retraction `C → B`.

## Main definitions

* `Stacks.Smoothing.parameterPowerIdeal`: the ideal `(x_i^{2N} - Σ_j z_{ij} a_j)`.
* `Stacks.Smoothing.parameterPowerAlgebra`: the algebra `B`.

## Main results

* `Stacks.Smoothing.exists_retraction_parameterPowerAlgebra`: the algebra `C` of Stacks 07CE
  over `k[x_1, …, x_d]` together with its retraction `C → B`.

## Implementation notes

The variables of the presenting polynomial ring are indexed by `Fin d ⊕ Fin d × Fin t`, with
`x_i = X (Sum.inl i)` and `z_{ij} = X (Sum.inr (i, j))`.

The `k[x_1, …, x_d]`-algebra structure on `B` is registered as an instance: its head mentions
`parameterPowerIdeal`, so it can only fire for this construction. Finite presentation over
`k[x_1, …, x_d]` is deduced from finite type over it, the base being Noetherian.

## References

* [Stacks Project, Tag 07FN](https://stacks.math.columbia.edu/tag/07FN)
* [Stacks Project, Tag 07FP](https://stacks.math.columbia.edu/tag/07FP)
-/

@[expose] public section

namespace Stacks.Smoothing

universe u v

/-- The ideal `(x_i^{2N} - Σ_j z_{ij} a_j : i = 1, …, d)` of the polynomial ring
`A[x_1, …, x_d, z_{ij}]`, whose variables are indexed by `Fin d ⊕ Fin d × Fin t` so that
`x_i = X (Sum.inl i)` and `z_{ij} = X (Sum.inr (i, j))`. -/
@[stacks 07FN]
noncomputable def parameterPowerIdeal {A : Type v} [CommRing A] (d : ℕ) {t : ℕ} (N : ℕ)
    (a : Fin t → A) : Ideal (MvPolynomial (Fin d ⊕ Fin d × Fin t) A) :=
  Ideal.span (Set.range fun i : Fin d =>
    MvPolynomial.X (Sum.inl i) ^ (2 * N) -
      ∑ j, MvPolynomial.C (a j) * MvPolynomial.X (Sum.inr (i, j)))

/-- The algebra `B = A[x_1, …, x_d, z_{ij}]/(x_i^{2N} - Σ_j z_{ij} a_j)`: the algebra `A` with
`d` generic elements `x_i` adjoined whose `2N`-th powers lie in the ideal generated by
`a_1, …, a_t`. -/
@[stacks 07FN]
abbrev parameterPowerAlgebra (A : Type v) [CommRing A] (d : ℕ) {t : ℕ} (N : ℕ)
    (a : Fin t → A) : Type v :=
  MvPolynomial (Fin d ⊕ Fin d × Fin t) A ⧸ parameterPowerIdeal d N a

/-- The defining relation of `B`: the `2N`-th power of the generator `x_i` is the combination
`Σ_j z_{ij} a_j` of `a_1, …, a_t`. -/
lemma parameterPowerAlgebra_X_pow {A : Type v} [CommRing A] {d t : ℕ} (N : ℕ) (a : Fin t → A)
    (i : Fin d) :
    Ideal.Quotient.mk (parameterPowerIdeal d N a) (MvPolynomial.X (Sum.inl i)) ^ (2 * N) =
      ∑ j, algebraMap A (parameterPowerAlgebra A d N a) (a j) *
        Ideal.Quotient.mk (parameterPowerIdeal d N a) (MvPolynomial.X (Sum.inr (i, j))) := by
  have hC (x : A) : algebraMap A (parameterPowerAlgebra A d N a) x =
      Ideal.Quotient.mk (parameterPowerIdeal d N a) (MvPolynomial.C x) := by
    rw [IsScalarTower.algebraMap_apply A (MvPolynomial (Fin d ⊕ Fin d × Fin t) A)
      (parameterPowerAlgebra A d N a), MvPolynomial.algebraMap_eq]
    rfl
  have hmem : Ideal.Quotient.mk (parameterPowerIdeal d N a)
      (MvPolynomial.X (Sum.inl i) ^ (2 * N) -
        ∑ j, MvPolynomial.C (a j) * MvPolynomial.X (Sum.inr (i, j))) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  rw [map_sub, map_pow, map_sum, sub_eq_zero] at hmem
  simpa [hC] using hmem

/-- The `k`-algebra map `k[x_1, …, x_d] → B = A[x_i, z_{ij}]/(x_i^{2N} - Σ_j z_{ij} a_j)` sending
the variable `x_i` of the source to the generator `x_i` of `B`. -/
noncomputable def parameterPowerBaseHom (k : Type u) {A : Type v} [CommRing k] [CommRing A]
    [Algebra k A] (d : ℕ) {t : ℕ} (N : ℕ) (a : Fin t → A) :
    MvPolynomial (Fin d) k →ₐ[k] parameterPowerAlgebra A d N a :=
  MvPolynomial.aeval fun i : Fin d => Ideal.Quotient.mk _ (MvPolynomial.X (Sum.inl i))

/-- The `k[x_1, …, x_d]`-algebra structure on `B = A[x_i, z_{ij}]/(x_i^{2N} - Σ_j z_{ij} a_j)`
sending the variable `x_i` of the base to the generator `x_i` of `B`. -/
noncomputable instance algebraMvPolynomialParameterPowerAlgebra (k : Type u) {A : Type v}
    [CommRing k] [CommRing A] [Algebra k A] (d : ℕ) {t : ℕ} (N : ℕ) (a : Fin t → A) :
    Algebra (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) :=
  (parameterPowerBaseHom k d N a).toRingHom.toAlgebra

/-- The structure map `k[x_1, …, x_d] → B` sends the variable `x_i` to the generator `x_i`. -/
@[simp]
lemma algebraMap_mvPolynomial_parameterPowerAlgebra_X (k : Type u) {A : Type v} [CommRing k]
    [CommRing A] [Algebra k A] {d : ℕ} {t : ℕ} (N : ℕ) (a : Fin t → A) (i : Fin d) :
    algebraMap (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) (MvPolynomial.X i) =
      Ideal.Quotient.mk (parameterPowerIdeal d N a) (MvPolynomial.X (Sum.inl i)) :=
  MvPolynomial.aeval_X _ _

/-- The structure maps `k → k[x_1, …, x_d] → B` compose to the structure map `k → B`. -/
instance isScalarTowerMvPolynomialParameterPowerAlgebra (k : Type u) {A : Type v} [CommRing k]
    [CommRing A] [Algebra k A] (d : ℕ) {t : ℕ} (N : ℕ) (a : Fin t → A) :
    IsScalarTower k (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) :=
  IsScalarTower.of_algebraMap_eq fun x => ((parameterPowerBaseHom k d N a).commutes x).symm

/-- Over a Noetherian ring `k`, with `A` of finite type over `k`, the algebra `B` is of finite
presentation over `k[x_1, …, x_d]`. -/
instance finitePresentation_parameterPowerAlgebra (k : Type u) {A : Type v} [CommRing k]
    [IsNoetherianRing k] [CommRing A] [Algebra k A] [Algebra.FiniteType k A] (d : ℕ) {t : ℕ}
    (N : ℕ) (a : Fin t → A) :
    Algebra.FinitePresentation (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) :=
  Algebra.FinitePresentation.of_finiteType.mp
    (Algebra.FiniteType.of_restrictScalars_finiteType k (MvPolynomial (Fin d) k)
      (parameterPowerAlgebra A d N a))

/-- Let `B = A[x_i, z_{ij}]/(x_i^{2N} - Σ_j z_{ij} a_j)`, viewed as a `k[x_1, …, x_d]`-algebra.
There is a finite-type `B`-algebra `C`, of finite presentation over `k[x_1, …, x_d]`, with a
`k[x_1, …, x_d]`-algebra retraction `C → B`, such that for each `b ∈ B`: if `B_b` is a local
complete intersection over `k[x_1, …, x_d]`, then `C_b` is smooth over `B_b` and has a
presentation over `k[x_1, …, x_d]` with free conormal module; and if `B_b` is smooth over
`k[x_1, …, x_d]`, then the module of differentials of `C_b` over `k[x_1, …, x_d]` is free. -/
@[stacks 07FP]
theorem exists_retraction_parameterPowerAlgebra (k : Type u) (A : Type v) [Field k] [CommRing A]
    [Algebra k A] [Algebra.FiniteType k A] (d : ℕ) {t : ℕ} (N : ℕ) (a : Fin t → A) :
    ∃ (C : Type v) (_ : CommRing C) (_ : Algebra (MvPolynomial (Fin d) k) C)
      (_ : Algebra (parameterPowerAlgebra A d N a) C)
      (_ : IsScalarTower (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) C)
      (_ : Algebra.FiniteType (parameterPowerAlgebra A d N a) C)
      (_ : Algebra.FinitePresentation (MvPolynomial (Fin d) k) C)
      (g : C →ₐ[MvPolynomial (Fin d) k] parameterPowerAlgebra A d N a),
      g.comp (IsScalarTower.toAlgHom (MvPolynomial (Fin d) k)
          (parameterPowerAlgebra A d N a) C) =
        AlgHom.id (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) ∧
      (∀ b : parameterPowerAlgebra A d N a,
        RingHom.IsLocalCompleteIntersection
            (algebraMap (MvPolynomial (Fin d) k) (Localization.Away b)) →
          (letI : Algebra (Localization.Away b)
              (Localization.Away (algebraMap (parameterPowerAlgebra A d N a) C b)) :=
            (Localization.awayMap
              (algebraMap (parameterPowerAlgebra A d N a) C) b).toAlgebra;
          Algebra.Smooth (Localization.Away b)
              (Localization.Away (algebraMap (parameterPowerAlgebra A d N a) C b)) ∧
            HasFreeConormalPresentation (MvPolynomial (Fin d) k)
              (Localization.Away (algebraMap (parameterPowerAlgebra A d N a) C b)))) ∧
      (∀ b : parameterPowerAlgebra A d N a,
        Algebra.Smooth (MvPolynomial (Fin d) k) (Localization.Away b) →
          Module.Free (Localization.Away (algebraMap (parameterPowerAlgebra A d N a) C b))
            (KaehlerDifferential (MvPolynomial (Fin d) k)
              (Localization.Away (algebraMap (parameterPowerAlgebra A d N a) C b)))) := by
  obtain ⟨C, hCommC, hAlgRC, hAlgBC, hTower, hFT, g, nC, PC, eC, _, _, _, hRetract,
      hLocalCI, hLocalSmoothFree⟩ :=
    exists_finiteType_retraction_improving_presentation (MvPolynomial (Fin d) k)
      (parameterPowerAlgebra A d N a)
  let instCommRing : CommRing C := hCommC
  let instAlgR : Algebra (MvPolynomial (Fin d) k) C := hAlgRC
  let instAlgB : Algebra (parameterPowerAlgebra A d N a) C := hAlgBC
  let instTower : IsScalarTower (MvPolynomial (Fin d) k) (parameterPowerAlgebra A d N a) C :=
    hTower
  let instFT : Algebra.FiniteType (parameterPowerAlgebra A d N a) C := hFT
  refine ⟨C, hCommC, hAlgRC, hAlgBC, hTower, hFT, ?_, g, hRetract, hLocalCI,
    hLocalSmoothFree⟩
  exact Algebra.FinitePresentation.of_finiteType.mp
    (Algebra.FiniteType.trans (R := MvPolynomial (Fin d) k)
      (S := parameterPowerAlgebra A d N a) (A := C) inferInstance hFT)

end Stacks.Smoothing

end
