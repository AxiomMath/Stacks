module

public import Mathlib.RingTheory.Localization.Away.Basic
public import StacksFrontier.RingTheory.Smoothing.BaseChangeOfPresentation

/-!
# A Jacobian criterion for elementary standardness of powers

Let `R → A` be a ring map of finite presentation, let `a : A` and let `A_a` be the localization
of `A` away from `a`. Stacks 16.3.7 compares six conditions on `a`; two of its parts concern
the conditions satisfied by the powers `a ^ e` for all large `e`.

This file isolates the localization content of condition 16.2.3.1. For a fixed presentation
`P` of `A` over `R` and a fixed `c`, write `Δ` for the principal `c × c` Jacobian minor of `P`
and `Δ_A` for the element of `A` it represents. Then the equation `a ^ e = a' * Δ_A` is
solvable for all large `e` precisely when `Δ_A` becomes invertible in `A_a`. Condition 16.2.3.2
for `a ^ e` is in turn implied by a single divisibility statement for the trailing relations,
because the condition does not depend on the chosen lift of `a ^ e`. Together these give a
criterion reducing elementary standardness of the powers of `a` to the construction of a
presentation of `A` with the two displayed properties.

## Main definitions

* `Stacks.Smoothing.presentationLiftHom`: the map `Presentation.lift` packaged as an
  `R`-algebra homomorphism, so that it can be used with `map_pow` and `map_sub`.

## Main results

* `Stacks.Smoothing.isUnit_algebraMap_iff_exists_pow_eq_mul`: an element `x : A` divides
  `a ^ e` for all large `e` if and only if the image of `x` in `A_a` is a unit.
* `Stacks.Smoothing.isUnit_algebraMap_lift_jacobianMinorPrincipal`: the converse direction at
  a presentation, namely that elementary standardness with respect to `P` and `c` forces the
  principal `c × c` Jacobian minor of `P` to be invertible in `A_a`.
* `Stacks.Smoothing.standardCond2_pow_of_pow_mul_mem_firstRelIdeal`: if some fixed power of a
  lift of `a` multiplies every trailing relation into the ideal generated by the first `c`
  relations, then condition 16.2.3.2 holds for `a ^ e` for every larger `e`, for every lift.
* `Stacks.Smoothing.exists_pow_isElementaryStandard_of_dvd_of_pow_mul_mem`: the resulting
  criterion for `a ^ e` to be elementary standard for all large `e`.

## Implementation notes

The presentations, the Jacobian minors, the ideal of the first `c` relations and the two
conditions 16.2.3.1 and 16.2.3.2 are the ones from
`StacksFrontier.RingTheory.Smoothing.BaseChangeOfPresentation`, where condition 16.2.3.2 is
`Presentation.StandardCond2`, quantified over all lifts. The
localization is kept abstract as any `IsLocalization.Away a` algebra, so that the criterion
applies both to `Localization.Away a` and to a localization already present in a construction.

## References

* [Stacks Project, Tag 07EZ](https://stacks.math.columbia.edu/tag/07EZ)
* [Stacks Project, Tag 07C7](https://stacks.math.columbia.edu/tag/07C7)
-/

@[expose] public section

namespace Stacks.Smoothing

universe u v w

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- `Presentation.lift`, which sends a polynomial to the element of `A` it represents,
packaged as an `R`-algebra homomorphism. -/
noncomputable def presentationLiftHom (P : Presentation R A) :
    MvPolynomial (Fin P.n) R →ₐ[R] A :=
  P.iso.symm.toAlgHom.comp (Ideal.Quotient.mkₐ R (Ideal.span (Set.range P.f)))

/-- `presentationLiftHom P` sends a polynomial `p` to `P.lift p`. -/
@[simp]
theorem presentationLiftHom_apply (P : Presentation R A) (p : MvPolynomial (Fin P.n) R) :
    presentationLiftHom P p = P.lift p :=
  rfl

/-- `Presentation.lift` is multiplicative, hence commutes with taking powers. -/
theorem presentationLift_pow (P : Presentation R A) (p : MvPolynomial (Fin P.n) R) (k : ℕ) :
    P.lift (p ^ k) = P.lift p ^ k := by
  rw [← presentationLiftHom_apply, ← presentationLiftHom_apply, map_pow]

/-- Two polynomials representing the same element of `A` differ by an element of the ideal of
relations. -/
theorem sub_mem_relIdeal_of_presentationLift_eq (P : Presentation R A)
    {p q : MvPolynomial (Fin P.n) R} (h : P.lift p = P.lift q) : p - q ∈ P.relIdeal := by
  have h0 : presentationLiftHom P (p - q) = 0 := by
    rw [map_sub, presentationLiftHom_apply, presentationLiftHom_apply, h, sub_self]
  have h1 : Ideal.Quotient.mk (Ideal.span (Set.range P.f)) (p - q) = 0 := by
    simpa [presentationLiftHom] using congrArg P.iso h0
  rw [Presentation.relIdeal]
  exact (Ideal.Quotient.eq_zero_iff_mem).mp h1

section Localization

variable {Aₐ : Type w} [CommRing Aₐ] [Algebra A Aₐ]

/-- Condition 16.2.3.1 for a fixed divisor, read off from the localization: `x` divides `a ^ e`
for every sufficiently large `e` if and only if the image of `x` in `A_a` is a unit. -/
theorem isUnit_algebraMap_iff_exists_pow_eq_mul (a x : A) [IsLocalization.Away a Aₐ] :
    IsUnit (algebraMap A Aₐ x) ↔ ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → ∃ y : A, a ^ e = y * x := by
  constructor
  · intro h
    obtain ⟨n, k, hk⟩ := (IsLocalization.Away.algebraMap_isUnit_iff a).mp h
    refine ⟨n, fun e he => ⟨a ^ (e - n) * k, ?_⟩⟩
    rw [← pow_sub_mul_pow a he, hk]
    ring
  · rintro ⟨e₀, he₀⟩
    obtain ⟨y, hy⟩ := he₀ e₀ le_rfl
    exact (IsLocalization.Away.algebraMap_isUnit_iff a).mpr ⟨e₀, Dvd.intro_left y hy.symm⟩

/-- The Jacobian hypothesis of the criterion below is also necessary: if `a` is elementary
standard with respect to `P` and `c`, then the element of `A` represented by the principal
`c × c` Jacobian minor of `P` is invertible in `A_a`. -/
theorem isUnit_algebraMap_lift_jacobianMinorPrincipal (P : Presentation R A) {a : A} {c : ℕ}
    (hcn : c ≤ P.n) (hcm : c ≤ P.m) [IsLocalization.Away a Aₐ]
    (h : P.IsElementaryStandardFor a c hcn hcm) :
    IsUnit (algebraMap A Aₐ (P.lift (P.jacobianMinorPrincipal c hcn hcm))) := by
  obtain ⟨⟨a', ha'⟩, -⟩ := h
  exact (IsLocalization.Away.algebraMap_isUnit_iff a).mpr
    ⟨1, by simpa using Dvd.intro_left a' ha'.symm⟩

end Localization

/-- Condition 16.2.3.2 for `a ^ e`, from a single divisibility statement for the trailing
relations. If `α` is a lift of `a` and `α ^ e₂` multiplies each `f_{c + j}` into the ideal
generated by `f_1, …, f_c`, then for every `e ≥ e₂` and every lift `ã` of `a ^ e` we have
`ã * f_{c + j} ∈ (f_1, …, f_c) + I ^ 2`. -/
theorem standardCond2_pow_of_pow_mul_mem_firstRelIdeal (P : Presentation R A) {a : A} {c : ℕ}
    (hcm : c ≤ P.m) {α : MvPolynomial (Fin P.n) R} (hα : P.IsLift a α) {e₂ e : ℕ} (he : e₂ ≤ e)
    (htail : ∀ j : Fin (P.m - c),
      α ^ e₂ * P.f ⟨c + j.1, by have := j.2; omega⟩ ∈ P.firstRelIdeal c hcm) :
    P.StandardCond2 (a ^ e) c hcm := by
  intro j ã hlift
  have hαe : P.lift (α ^ e) = a ^ e := by
    rw [presentationLift_pow]
    exact congrArg (· ^ e) hα
  have hfirst : α ^ e * P.f ⟨c + j.1, by have := j.2; omega⟩ ∈ P.firstRelIdeal c hcm := by
    rw [← pow_sub_mul_pow α he, mul_assoc]
    exact Ideal.mul_mem_left _ _ (htail j)
  have hsq : (ã - α ^ e) * P.f ⟨c + j.1, by have := j.2; omega⟩ ∈ P.relIdeal ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul (sub_mem_relIdeal_of_presentationLift_eq P (by rw [hlift, hαe]))
      (Ideal.subset_span ⟨_, rfl⟩)
  convert Ideal.add_mem _ (Submodule.mem_sup_left hfirst) (Submodule.mem_sup_right hsq) using 1
  ring

/-- The criterion. Suppose `P` is a presentation of `A` over `R`, `c ≤ min (P.n) (P.m)`, and
`α` is a lift of `a`. If the element of `A` represented by the principal `c × c` Jacobian minor
of `P` becomes invertible in `A_a`, and if some fixed power of `α` multiplies each trailing
relation of `P` into the ideal generated by the first `c` relations, then `a ^ e` is elementary
standard in `A` over `R` for every sufficiently large `e`, with `P` and `c` as witnesses. -/
theorem exists_pow_isElementaryStandard_of_dvd_of_pow_mul_mem {Aₐ : Type w} [CommRing Aₐ]
    [Algebra A Aₐ] (P : Presentation R A) {a : A} {c : ℕ} (hcn : c ≤ P.n) (hcm : c ≤ P.m)
    {α : MvPolynomial (Fin P.n) R} (hα : P.IsLift a α) [IsLocalization.Away a Aₐ]
    (hjac : IsUnit (algebraMap A Aₐ (P.lift (P.jacobianMinorPrincipal c hcn hcm)))) (e₂ : ℕ)
    (htail : ∀ j : Fin (P.m - c),
      α ^ e₂ * P.f ⟨c + j.1, by have := j.2; omega⟩ ∈ P.firstRelIdeal c hcm) :
    ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e → IsElementaryStandard (R := R) (a ^ e) := by
  obtain ⟨e₁, he₁⟩ := (isUnit_algebraMap_iff_exists_pow_eq_mul (Aₐ := Aₐ) a _).mp hjac
  exact ⟨max e₁ e₂, fun e he => ⟨P, c, hcn, hcm, he₁ e (le_of_max_le_left he),
    standardCond2_pow_of_pow_mul_mem_firstRelIdeal P hcm hα (le_of_max_le_right he) htail⟩⟩

end Stacks.Smoothing

end
