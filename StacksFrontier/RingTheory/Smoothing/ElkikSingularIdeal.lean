module

public import StacksFrontier.RingTheory.Smoothing.SingularIdealGenerators
public import StacksFrontier.RingTheory.Smoothing.StandardElementAtSmoothPrime
public import StacksFrontier.RingTheory.Smoothing.StandardElementsSingular

/-!
# Elkik's description of the singular ideal

For a ring map `R → A` of finite presentation, the singular ideal `H_{A/R}` of
Stacks 07C5 is the radical of the ideal generated by the strictly standard elements
of `A` over `R`, and likewise the radical of the ideal generated by the elementary
standard elements.

Both descriptions come from one statement about primes: for a prime `q` of `A`, the
standard elements all lie in `q` exactly when `R → A` is not smooth at `q`. One
direction is that the localization at a standard element is smooth, which is the
content of `StacksFrontier.RingTheory.Smoothing.StandardElementsSingular`. The other is
Stacks 16.2.2, which at a prime of smoothness produces an element outside it that is
standard after renumbering the variables and the relations; that renumbering is
carried out here, the relations by `Stacks.Smoothing.relabelRels` and the variables
by `Stacks.Smoothing.relabelVars`.

## Main definitions

* `Stacks.Smoothing.relabelRels`: the presentation obtained by permuting the
  relations.

## Main results

* `Stacks.Smoothing.exists_notMem_isElementaryStandard`: at a prime where `R → A` is
  smooth, some elementary standard element lies outside it.
* `Stacks.Smoothing.forall_mem_iff_not_smoothAt_isStrictlyStandard` and
  `Stacks.Smoothing.forall_mem_iff_not_smoothAt_isElementaryStandard`: the standard
  elements all lie in a prime exactly when `R → A` is not smooth there. The two
  descriptions of the singular ideal that follow,
  `Stacks.Smoothing.singularIdeal_eq_radical_span_isStrictlyStandard` and
  `Stacks.Smoothing.singularIdeal_eq_radical_span_isElementaryStandard`, are those of
  `StacksFrontier.RingTheory.Smoothing.SingularIdealGenerators`, re-exported here.

## Implementation notes

The ideal of relations does not change when the relations are permuted, so
`relabelRels` keeps the same quotient and only transports the isomorphism along
`Ideal.quotientEquivAlgOfEq`. A presentation of `A` in the sense of Stacks 16.2 is
obtained from Mathlib's `Algebra.Presentation` by
`Stacks.Smoothing.ofAlgebraPresentation`, so that the finite presentation hypothesis
can be used to produce one.

## References

* [Stacks Project, Tag 07CA](https://stacks.math.columbia.edu/tag/07CA)
* [Stacks Project, Tag 07C5](https://stacks.math.columbia.edu/tag/07C5)
* [Stacks Project, Tag 07C6](https://stacks.math.columbia.edu/tag/07C6)
-/

@[expose] public section

namespace Stacks.Smoothing

open MvPolynomial

universe u v

variable {R : Type u} [CommRing R] {A : Type v} [CommRing A] [Algebra R A]

/-- Permuting the relations of a presentation does not change the ideal they span. -/
theorem span_range_relabelRels (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m) :
    Ideal.span (Set.range P.f) = Ideal.span (Set.range fun j ↦ P.f (σ j)) := by
  congr 1
  ext x
  simp only [Set.mem_range]
  exact ⟨fun ⟨j, hj⟩ ↦ ⟨σ.symm j, by rwa [σ.apply_symm_apply]⟩, fun ⟨j, hj⟩ ↦ ⟨σ j, hj⟩⟩

/-- The presentation of `A` obtained from `P` by permuting the relations along `σ`. -/
@[implicit_reducible]
noncomputable def relabelRels (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m) :
    Presentation R A where
  n := P.n
  m := P.m
  f := fun j ↦ P.f (σ j)
  iso := P.iso.trans (Ideal.quotientEquivAlgOfEq R (span_range_relabelRels P σ))

/-- Permuting the relations does not change the number of variables. -/
@[simp]
theorem relabelRels_n (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m) :
    (relabelRels P σ).n = P.n := rfl

/-- Permuting the relations does not change the number of relations. -/
@[simp]
theorem relabelRels_m (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m) :
    (relabelRels P σ).m = P.m := rfl

/-- The `j`-th relation of `relabelRels P σ` is the `σ j`-th relation of `P`. -/
@[simp]
theorem relabelRels_f (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m) (j : Fin P.m) :
    (relabelRels P σ).f j = P.f (σ j) := rfl

/-- Permuting the relations does not change the ideal of relations. -/
theorem relIdeal_relabelRels (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m) :
    (relabelRels P σ).relIdeal = P.relIdeal :=
  (span_range_relabelRels P σ).symm

/-- Permuting the relations does not change which element of `A` a polynomial
represents. -/
theorem lift_relabelRels (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m)
    (p : MvPolynomial (Fin P.n) R) : (relabelRels P σ).lift p = P.lift p := by
  have hφ := Ideal.quotientEquivAlgOfEq_mk R (span_range_relabelRels P σ) p
  show P.iso.symm ((Ideal.quotientEquivAlgOfEq R (span_range_relabelRels P σ)).symm
      (Ideal.Quotient.mk (Ideal.span (Set.range fun j ↦ P.f (σ j))) p)) = P.lift p
  rw [← hφ, AlgEquiv.symm_apply_apply]
  rfl

/-- If `σ` carries the first `c` indices onto `V` in increasing order, then the ideal
generated by the first `c` relations of the permuted presentation is the ideal
generated by the relations indexed by `V`. -/
theorem firstRelIdeal_relabelRels (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m)
    (c : ℕ) (hcm : c ≤ P.m) (hcm' : c ≤ (relabelRels P σ).m)
    (V : Finset (Fin P.m)) (hV : V.card = c)
    (hσ : ∀ i : Fin c, σ (Fin.castLE hcm i) = (V.orderIsoOfFin hV i : Fin P.m)) :
    (relabelRels P σ).firstRelIdeal c hcm' = P.selectedRelIdeal V := by
  have hrange : (Set.range fun i : Fin c ↦ (relabelRels P σ).f (Fin.castLE hcm' i)) =
      Set.range fun j : ↑V ↦ P.f j.1 := by
    ext x
    simp only [Set.mem_range]
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨⟨(V.orderIsoOfFin hV i : Fin P.m), (V.orderIsoOfFin hV i).2⟩,
        congrArg P.f (hσ i).symm⟩
    · rintro ⟨j, rfl⟩
      obtain ⟨i, hi⟩ := (V.orderIsoOfFin hV).surjective j
      exact ⟨i, by rw [show (relabelRels P σ).f (Fin.castLE hcm' i) = P.f (σ (Fin.castLE hcm i))
        from rfl, hσ i, hi]⟩
  show Ideal.span (Set.range fun i : Fin c ↦ (relabelRels P σ).f (Fin.castLE hcm' i)) = _
  rw [hrange]
  rfl

/-- If `σ` carries the first `c` indices onto `V` in increasing order, then the
Jacobian minor of the permuted presentation on the columns `U` is the Jacobian minor
of `P` on the rows `V` and the columns `U`. -/
theorem jacobianMinor_relabelRels (P : Presentation R A) (σ : Fin P.m ≃ Fin P.m)
    (c : ℕ) (hcm : c ≤ P.m) (hcm' : c ≤ (relabelRels P σ).m)
    (U : Finset (Fin P.n)) (hU : U.card = c)
    (hU' : U.card = c) (V : Finset (Fin P.m)) (hV : V.card = c)
    (hσ : ∀ i : Fin c, σ (Fin.castLE hcm i) = (V.orderIsoOfFin hV i : Fin P.m)) :
    (relabelRels P σ).jacobianMinor c hcm' U hU' = P.jacobianMinorOn c U V hU hV := by
  exact congrArg Matrix.det (Matrix.ext fun j i ↦ by
    change pderiv _ (P.f (σ (Fin.castLE hcm j))) = _
    rw [hσ j])

/-- A presentation in the sense of Stacks 16.2 built from Mathlib's
`Algebra.Presentation`. -/
noncomputable def ofAlgebraPresentation {n m : ℕ}
    (Q : Algebra.Presentation R A (Fin n) (Fin m)) : Presentation R A where
  n := n
  m := m
  f := Q.relation
  iso := (Q.quotientEquiv.restrictScalars R).symm.trans
    (Ideal.quotientEquivAlgOfEq R Q.span_range_relation_eq_ker.symm)

/-- An algebra of finite presentation admits a presentation in the sense of
Stacks 16.2. -/
theorem nonempty_presentation (R : Type u) [CommRing R] (A : Type v) [CommRing A]
    [Algebra R A] [Algebra.FinitePresentation R A] : Nonempty (Presentation R A) := by
  obtain ⟨n, m, ⟨Q⟩⟩ := Algebra.Presentation.exists_presentation_fin R A
  exact ⟨ofAlgebraPresentation Q⟩

/-- **Stacks 16.2.2, in the form used for the singular ideal.** At a prime where
`R → A` is smooth, some elementary standard element of `A` over `R` lies outside that
prime. -/
theorem exists_notMem_isElementaryStandard [Algebra.FinitePresentation R A]
    (q : Ideal A) [q.IsPrime] (hq : Algebra.SmoothAt R A q) :
    ∃ a : A, a ∉ q ∧ IsElementaryStandard (R := R) (A := A) a := by
  classical
  obtain ⟨P⟩ := nonempty_presentation R A
  obtain ⟨a, haq, c, U, V, hcn, hcm, hU, hV, a', haeq, hacond⟩ :=
    exists_strictly_standard_element P q hq
  obtain ⟨e, he⟩ := exists_equiv_orderIsoOfFin_eq_castLE c hcm V hV
  have hσ (i : Fin c) :
      e.symm (Fin.castLE hcm i) = (V.orderIsoOfFin hV i : Fin P.m) :=
    e.symm_apply_eq.2 (he i).symm
  have hcn' : c ≤ (relabelRels P e.symm).n := hcn
  have hcm' : c ≤ (relabelRels P e.symm).m := hcm
  refine ⟨a, haq, ?_⟩
  refine isElementaryStandard_of_standardCond2 (relabelRels P e.symm) a a' c hcn' hcm'
    U hU ?_ ?_
  · rw [jacobianMinor_relabelRels P e.symm c hcm hcm' U hU hU V hV hσ, lift_relabelRels]
    exact haeq
  · intro j p hp
    have hj : (j : ℕ) < P.m - c := j.2
    have hjm : c + (j : ℕ) < P.m := by omega
    have hplift : P.IsLift a p := by
      have h := hp
      rwa [Presentation.IsLift, lift_relabelRels] at h
    have hmem := hacond (e.symm ⟨c + (j : ℕ), hjm⟩) p hplift
    rw [Ideal.add_eq_sup, firstRelIdeal_relabelRels P e.symm c hcm hcm' V hV hσ,
      relIdeal_relabelRels]
    rw [Ideal.add_eq_sup] at hmem
    exact hmem

/-- A prime lies in the smooth locus exactly when `R → A` is smooth at it in the
sense of Stacks 00TB. -/
theorem mem_smoothLocus_iff_smoothAt [Algebra.FinitePresentation R A]
    (q : PrimeSpectrum A) :
    q ∈ Algebra.smoothLocus R A ↔ Algebra.SmoothAt R A q.asIdeal := by
  have hqp : q.asIdeal.IsPrime := q.isPrime
  constructor
  · intro hmem
    have : Algebra.IsSmoothAt R q.asIdeal := hmem
    obtain ⟨b, hbq, hbstd⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth R q.asIdeal
    have := hbstd
    exact ⟨b, hbq, ⟨inferInstance, inferInstance⟩⟩
  · rintro ⟨g, hgq, hgsm⟩
    exact Algebra.basicOpen_subset_smoothLocus_iff_smooth.2 hgsm
      ((PrimeSpectrum.mem_basicOpen g q).2 hgq)

/-- A radical ideal cutting out the non-smooth locus prime by prime is the singular
ideal. -/
theorem singularIdeal_eq_of_isRadical [Algebra.FinitePresentation R A] (J : Ideal A)
    (hJ : J.IsRadical)
    (h : ∀ (q : Ideal A) (_ : q.IsPrime), J ≤ q ↔ ¬ Algebra.SmoothAt R A q) :
    singularIdeal R A = J := by
  have hzero : PrimeSpectrum.zeroLocus (J : Set A) = (Algebra.smoothLocus R A)ᶜ := by
    ext q
    have hqp : q.asIdeal.IsPrime := q.isPrime
    rw [PrimeSpectrum.mem_zeroLocus, Set.mem_compl_iff,
      mem_smoothLocus_iff_smoothAt q, SetLike.coe_subset_coe]
    exact h q.asIdeal hqp
  calc singularIdeal R A = PrimeSpectrum.vanishingIdeal (Algebra.smoothLocus R A)ᶜ :=
      singularIdeal_eq_vanishingIdeal_compl_smoothLocus R A
    _ = PrimeSpectrum.vanishingIdeal (PrimeSpectrum.zeroLocus (J : Set A)) := by rw [hzero]
    _ = J.radical := PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical J
    _ = J := hJ.radical

/-- If every prime of smoothness avoids some element satisfying `S`, and localizing at
elements satisfying `S` is smooth, then all `S`-elements lie in `q` iff `R → A` is not
smooth at `q`. -/
private theorem forall_mem_iff_not_smoothAt_of {S : A → Prop} (q : Ideal A) [q.IsPrime]
    (hex : Algebra.SmoothAt R A q → ∃ a : A, a ∉ q ∧ S a)
    (hS : ∀ a : A, S a → Algebra.Smooth R (Localization.Away a)) :
    (∀ a : A, S a → a ∈ q) ↔ ¬ Algebra.SmoothAt R A q := by
  constructor
  · intro h hsm
    obtain ⟨a, haq, ha⟩ := hex hsm
    exact haq (h a ha)
  · intro hns a ha
    by_contra haq
    exact hns ⟨a, haq, hS a ha⟩

/-- **Stacks 16.2.3 criterion for elementary standard elements.** For a prime `q`,
every elementary standard element lies in `q` exactly when `R → A` is not smooth
at `q`. -/
theorem forall_mem_iff_not_smoothAt_isElementaryStandard
    [Algebra.FinitePresentation R A] (q : Ideal A) (hq : q.IsPrime) :
    (∀ a : A, IsElementaryStandard (R := R) (A := A) a → a ∈ q) ↔
      ¬ Algebra.SmoothAt R A q := by
  have := hq
  exact forall_mem_iff_not_smoothAt_of q (exists_notMem_isElementaryStandard q)
    fun _ ha ↦ smooth_localizationAway_of_isElementaryStandard ha

/-- **Stacks 16.2.3 criterion for strictly standard elements.** For a prime `q`,
every strictly standard element lies in `q` exactly when `R → A` is not smooth
at `q`. -/
theorem forall_mem_iff_not_smoothAt_isStrictlyStandard
    [Algebra.FinitePresentation R A] (q : Ideal A) (hq : q.IsPrime) :
    (∀ a : A, IsStrictlyStandard (R := R) (A := A) a → a ∈ q) ↔
      ¬ Algebra.SmoothAt R A q := by
  have := hq
  exact forall_mem_iff_not_smoothAt_of q
    (fun hsm ↦ let ⟨a, haq, ha⟩ := exists_notMem_isElementaryStandard q hsm
      ⟨a, haq, elementaryStandard_implies_strictlyStandard
        ({ R := R, A := A, a := a } : SixStandardnessConditions) ha⟩)
    fun _ ha ↦ smooth_localizationAway_of_isStrictlyStandard ha

end Stacks.Smoothing

end
