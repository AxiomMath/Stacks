module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.MvPolynomial.Monad
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.MvPolynomial.IrreducibleQuadratic

@[expose] public section

set_option backward.isDefEq.respectTransparency false

/-!
# Standard smooth presentations with prescribed generators

Let `R → A` be a standard smooth ring map and let `E ⊆ A` be a finite subset with `n` elements.
Then `A` has a standard smooth presentation `R[x_1, ..., x_{n+m}]/(f_1, ..., f_c)` with `c ≥ n`
in which `E` is the set of congruence classes of the first `n` variables.

## Main definitions

* `jacobianDet`: the `c × c` Jacobian determinant of `f_1, ..., f_c` with respect to the first
  `c` variables.
* `IsStandardSmoothPresentation`: a standard smooth presentation (Tag 00T6).
* `IsStandardSmoothRingMap`: a standard smooth ring map (Tag 00T6).

## Main results

* `standardSmooth_presentation_with_prescribed_generators` (Tag 07EY).

## Implementation notes

The hypothesis `|E| = n` is modelled by taking `E : Finset A` with `E.card = n`.

Starting from a standard smooth presentation `A = R[y_1, ..., y_m]/(g_1, ..., g_d)`, lift
`E = {a_1, ..., a_n}` to `h_i ∈ R[y]`, introduce `n` new variables `x_i`, and take the relations
`(x_1 - h_1, ..., x_n - h_n, g_1, ..., g_d)`, so that `n ≤ c = n + d ≤ n + m`. The `c × c`
Jacobian is block lower triangular with an identity block, so its determinant is the Jacobian
determinant of `(g_1, ..., g_d)`, which is invertible.

## References

* [Stacks Project, Tag 07EY](https://stacks.math.columbia.edu/tag/07EY)
* [Stacks Project, Tag 00T6](https://stacks.math.columbia.edu/tag/00T6)
-/

open MvPolynomial

/-- The `c x c` Jacobian determinant of `f_1, ..., f_c` with respect to the first
`c` of the `n` variables: the determinant of the matrix whose `(i, j)` entry is the
formal partial derivative `d f_j / d x_i`. -/
noncomputable def jacobianDet {R : Type*} [CommRing R] {n c : ℕ} (hcn : c ≤ n)
    (f : Fin c → MvPolynomial (Fin n) R) : MvPolynomial (Fin n) R :=
  Matrix.det (fun i j : Fin c => pderiv (Fin.castLE hcn i) (f j))

/-- The data of polynomials `f_1, ..., f_c` in
`R[x_1, ..., x_n]` with `c ≤ n` forms a *standard smooth presentation* if the image
of the Jacobian determinant is invertible in the quotient `R[x_1, ..., x_n]/(f)`. -/
def IsStandardSmoothPresentation {R : Type*} [CommRing R] {n c : ℕ} (hcn : c ≤ n)
    (f : Fin c → MvPolynomial (Fin n) R) : Prop :=
  IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range f)) (jacobianDet hcn f))

/-- An `R`-algebra `A` is *standard smooth* if there exist
`m ≥ d ≥ 0` and polynomials `g_1, ..., g_d` in `R[y_1, ..., y_m]` forming a standard
smooth presentation (`IsStandardSmoothPresentation`) such that `A` is `R`-algebra isomorphic to
`R[y_1, ..., y_m]/(g_1, ..., g_d)`. -/
def IsStandardSmoothRingMap (R A : Type*) [CommRing R] [CommRing A] [Algebra R A] : Prop :=
  ∃ (m d : ℕ) (hdm : d ≤ m) (g : Fin d → MvPolynomial (Fin m) R),
    IsStandardSmoothPresentation hdm g ∧
      Nonempty (A ≃ₐ[R] (MvPolynomial (Fin m) R ⧸ Ideal.span (Set.range g)))

/-- For any substitution `w : Fin N → R[x]`, the polynomial `p` is congruent to
`aeval w p` modulo the ideal generated by `{X k - w k}`. -/
theorem sub_aeval_mem_span_X_sub {R : Type*} [CommRing R] {N : ℕ}
    (w : Fin N → MvPolynomial (Fin N) R) (p : MvPolynomial (Fin N) R) :
    p - aeval w p ∈ Ideal.span (Set.range (fun k => X k - w k)) := by
  induction p using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq =>
      have : p + q - aeval w (p + q) = (p - aeval w p) + (q - aeval w q) := by
        rw [map_add]; ring
      rw [this]
      exact Ideal.add_mem _ hp hq
  | mul_X p k hp =>
      have key : p * X k - aeval w (p * X k)
          = (p - aeval w p) * X k + aeval w p * (X k - w k) := by
        simp only [map_mul, aeval_X]; ring
      rw [key]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) ?_
      refine Ideal.mul_mem_left _ _ ?_
      exact Ideal.subset_span ⟨k, rfl⟩

/-- The partial derivative of a renamed polynomial with respect to a variable not in
the image of the renaming is zero. -/
theorem pderiv_rename_eq_zero_of_not_mem_range {R : Type*} [CommRing R] {σ τ : Type*}
    (j : σ → τ) (k : τ) (hk : k ∉ Set.range j)
    (p : MvPolynomial σ R) : pderiv k (rename j p) = 0 := by
  classical
  refine MvPolynomial.pderiv_eq_zero_of_notMem_vars fun hmem ↦ ?_
  obtain ⟨s, -, hs⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename j p hmem)
  exact hk ⟨s, hs⟩

/-- The partial derivative of a polynomial in the *last* `m'` variables (i.e. one renamed along
`Fin.natAdd n : Fin m' → Fin (n + m')`) with respect to one of the *first* `n` variables
`Fin.castAdd m' i` is zero. -/
theorem pderiv_castAdd_rename_natAdd {R : Type*} [CommRing R] {n m' : ℕ}
    (i : Fin n) (p : MvPolynomial (Fin m') R) :
    pderiv (Fin.castAdd m' i) (rename (Fin.natAdd n) p) = (0 : MvPolynomial (Fin (n + m')) R) := by
  -- The variable `Fin.castAdd m' i` (value `i < n`) is not in the range of
  -- `Fin.natAdd n` (whose values are `≥ n`), so the partial derivative vanishes.
  apply pderiv_rename_eq_zero_of_not_mem_range
  rintro ⟨t, ht⟩
  exact absurd ht (by simp [Fin.natAdd, Fin.castAdd, Fin.ext_iff]; omega)

/-- Renaming commutes with taking determinants of matrices over a polynomial ring: for an algebra
map `rename e` and a square matrix `N` of polynomials,
`det (fun i j => rename e (N i j)) = rename e (det N)`. -/
theorem det_rename_comm {R : Type*} [CommRing R] {σ τ : Type*} {k : ℕ}
    (e : σ → τ) (N : Matrix (Fin k) (Fin k) (MvPolynomial σ R)) :
    Matrix.det (fun i j => rename e (N i j)) = rename e (Matrix.det N) := by
  -- `rename e` is a ring hom; `RingHom.map_det` says it commutes with `det`.
  have := RingHom.map_det (rename e (R := R)).toRingHom N
  simp only [RingHom.mapMatrix_apply] at this
  exact this.symm

/-- Let `R → A` be a standard smooth ring map and
let `E ⊆ A` be a finite subset with exactly `n` elements. Then there exist `m ≥ 0`,
`c ≥ n`, and polynomials `f_1, ..., f_c` in `R[x_1, ..., x_{n+m}]` together with a
surjective `R`-algebra map `π` with kernel `(f_1, ..., f_c)` such that:
1. `π` is surjective with kernel `(f)` (so `A ≅ R[x]/(f)`);
2. the image of the Jacobian determinant (using the first `c` variables) is invertible
   in `A`;
3. the images of the first `n` variables `x_1, ..., x_n` are exactly `E`. -/
@[stacks 07EY]
theorem standardSmooth_presentation_with_prescribed_generators
    (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
    (hA : IsStandardSmoothRingMap R A) (E : Finset A) (n : ℕ) (hn : E.card = n) :
    ∃ (m c : ℕ) (_ : n ≤ c) (hcnm : c ≤ n + m)
      (f : Fin c → MvPolynomial (Fin (n + m)) R)
      (π : MvPolynomial (Fin (n + m)) R →ₐ[R] A),
      -- (1) Presentation: `π` is surjective with kernel `(f_1, ..., f_c)`.
      (Function.Surjective π ∧
        RingHom.ker π.toRingHom = Ideal.span (Set.range f)) ∧
      -- (2) Standard smooth Jacobian condition: the image of the Jacobian
      -- determinant is invertible in `A`.
      IsUnit (π (jacobianDet hcnm f)) ∧
      -- (3) Generators include `E`: `E` equals the set of images of the first `n`
      -- variables `x_1, ..., x_n`.
      (E : Set A) = Set.range (fun i : Fin n => π (X (Fin.castAdd m i))) := by
  classical
  -- Unpack the standard smooth presentation of `A`.
  obtain ⟨m', d, hdm, g, hss, ⟨φ⟩⟩ := hA
  set Q := MvPolynomial (Fin m') R ⧸ Ideal.span (Set.range g) with hQ
  -- Enumerate `E` by `Fin n`.
  let eE : Fin n ≃ {x // x ∈ E} := ((finCongr hn).symm).trans (Finset.equivFin E).symm
  let a : Fin n → A := fun i => (eE i : A)
  have haE : Set.range a = (E : Set A) :=
    (eE.surjective.range_comp Subtype.val).trans Subtype.range_coe
  -- The quotient map.
  let mkg : MvPolynomial (Fin m') R →ₐ[R] Q := Ideal.Quotient.mkₐ R (Ideal.span (Set.range g))
  have hmkg_surj : Function.Surjective mkg := Ideal.Quotient.mkₐ_surjective R _
  -- Lifts `h i` of `φ (a i)`.
  let h : Fin n → MvPolynomial (Fin m') R := fun i => Function.surjInv hmkg_surj (φ (a i))
  have hh : ∀ i, mkg (h i) = φ (a i) := fun i => Function.surjInv_eq hmkg_surj (φ (a i))
  -- Embedding of the `y` variables into the `(n + m')` variables.
  let yemb : Fin m' → Fin (n + m') := Fin.natAdd n
  have yemb_inj : Function.Injective yemb := fun i j hij => by
    simpa [yemb, Fin.natAdd, Fin.ext_iff] using hij
  -- The relations.
  let H : Fin n → MvPolynomial (Fin (n + m')) R := fun i => rename yemb (h i)
  let G : Fin d → MvPolynomial (Fin (n + m')) R := fun j => rename yemb (g j)
  let f : Fin (n + d) → MvPolynomial (Fin (n + m')) R :=
    Fin.addCases (fun i => X (Fin.castAdd m' i) - H i) (fun j => G j)
  -- The evaluation map `π`.
  let v : Fin (n + m') → A := Fin.addCases a (fun j => φ.symm (mkg (X j)))
  let π : MvPolynomial (Fin (n + m')) R →ₐ[R] A := aeval v
  -- Bounds.
  have hnc : n ≤ n + d := Nat.le_add_right n d
  have hcnm : n + d ≤ n + m' := Nat.add_le_add_left hdm n
  -- Key: `π` restricted to the `y`-variables is `φ⁻¹ ∘ mkg`.
  have hπy : ∀ q : MvPolynomial (Fin m') R, π (rename yemb q) = φ.symm (mkg q) := by
    have key : (aeval (v ∘ yemb) : MvPolynomial (Fin m') R →ₐ[R] A)
        = (φ.symm.toAlgHom).comp mkg := by
      apply MvPolynomial.algHom_ext
      intro j
      change aeval (v ∘ yemb) (X j) = φ.symm (mkg (X j))
      rw [aeval_X]
      change v (yemb j) = φ.symm (mkg (X j))
      simp only [yemb, v, Fin.addCases_right]
    intro q
    have h1 : π (rename yemb q) = aeval (v ∘ yemb) q := by
      simp only [π, aeval_rename]
    rw [h1, key]
    rfl
  have hπXcast : ∀ i : Fin n, π (X (Fin.castAdd m' i)) = a i := by
    intro i; simp only [π, aeval_X, v, Fin.addCases_left]
  have hπH : ∀ i : Fin n, π (H i) = a i := by
    intro i
    simp only [H, hπy, hh]
    exact (φ.left_inv (a i))
  have hmkg_eq_zero : ∀ q, mkg q = 0 ↔ q ∈ Ideal.span (Set.range g) := fun q =>
    Ideal.Quotient.eq_zero_iff_mem
  have hmkg_g : ∀ j : Fin d, mkg (g j) = 0 := fun j =>
    (hmkg_eq_zero _).2 (Ideal.subset_span ⟨j, rfl⟩)
  have hπG : ∀ j : Fin d, π (G j) = 0 := by
    intro j; simp only [G, hπy, hmkg_g, map_zero]
  have hπf : ∀ k, π (f k) = 0 := by
    intro k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · simp only [f, Fin.addCases_left, map_sub, hπXcast, hπH, sub_self]
    · simp only [f, Fin.addCases_right, hπG]
  have hfmem : ∀ k, f k ∈ Ideal.span (Set.range f) := fun k => Ideal.subset_span ⟨k, rfl⟩
  have hf_cast : ∀ i : Fin n, f (Fin.castAdd d i) = X (Fin.castAdd m' i) - H i := by
    intro i; simp only [f, Fin.addCases_left]
  have hf_nat : ∀ j : Fin d, f (Fin.natAdd n j) = G j := by
    intro j; simp only [f, Fin.addCases_right]
  refine ⟨m', n + d, hnc, hcnm, f, π, ⟨?_, ?_⟩, ?_, ?_⟩
  · -- surjectivity
    intro b
    obtain ⟨q, hq⟩ := hmkg_surj (φ b)
    refine ⟨rename yemb q, ?_⟩
    rw [hπy, hq]
    simp
  · -- kernel
    -- span(range f) ≤ ker
    have hspan_le_ker : Ideal.span (Set.range f) ≤ RingHom.ker π.toRingHom := by
      rw [Ideal.span_le]
      rintro x ⟨k, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      exact hπf k
    apply le_antisymm
    · -- ker ⊆ span
      intro p hp
      rw [RingHom.mem_ker] at hp
      have hp' : π p = 0 := hp
      -- substitution targets
      set w : Fin (n + m') → MvPolynomial (Fin (n + m')) R :=
        Fin.addCases (fun i : Fin n => H i) (fun j : Fin m' => X (Fin.natAdd n j)) with hw
      -- step 1 : p - aeval w p ∈ span(range f)
      have hstep1 : p - aeval w p ∈ Ideal.span (Set.range f) := by
        have hmem := sub_aeval_mem_span_X_sub w p
        refine Ideal.span_le.2 ?_ hmem
        rintro x ⟨k, rfl⟩
        simp only [SetLike.mem_coe]
        refine Fin.addCases (fun i => ?_) (fun j => ?_) k
        · -- X (castAdd i) - w (castAdd i) = X(castAdd i) - H i = f (castAdd i)
          show X (Fin.castAdd m' i) - w (Fin.castAdd m' i) ∈ _
          have heq : X (Fin.castAdd m' i) - w (Fin.castAdd m' i)
              = f (Fin.castAdd d i) := by
            rw [hf_cast]; congr 1; simp only [w, Fin.addCases_left]
          rw [heq]
          exact hfmem _
        · -- X (natAdd j) - w (natAdd j) = 0
          show X (Fin.natAdd n j) - w (Fin.natAdd n j) ∈ _
          have heq : X (Fin.natAdd n j) - w (Fin.natAdd n j) = 0 := by
            simp only [w, Fin.addCases_right, sub_self]
          rw [heq]
          exact Ideal.zero_mem _
      -- step 2 : aeval w p is a renamed polynomial
      have hrange : ∀ k, w k ∈ (rename yemb (R := R)).range := by
        intro k
        refine Fin.addCases (fun i => ?_) (fun j => ?_) k
        · simp only [w, Fin.addCases_left, H, AlgHom.mem_range]; exact ⟨h i, rfl⟩
        · simp only [w, Fin.addCases_right, AlgHom.mem_range]
          exact ⟨X j, by rw [rename_X]⟩
      have hawp_range : aeval w p ∈ (rename yemb (R := R)).range := by
        have hle : (aeval w).range ≤ (rename yemb (R := R)).range := by
          rw [← Algebra.adjoin_range_eq_range_aeval, Algebra.adjoin_le_iff]
          rintro x ⟨k, rfl⟩
          exact hrange k
        exact hle ⟨p, rfl⟩
      rw [AlgHom.mem_range] at hawp_range
      obtain ⟨q, hq⟩ := hawp_range
      -- step 3 : π (aeval w p) = 0
      have hπawp : π (aeval w p) = 0 := by
        have h2 : π (p - aeval w p) = 0 := hspan_le_ker hstep1
        rw [map_sub, hp', zero_sub, neg_eq_zero] at h2
        exact h2
      -- thus mkg q = 0
      have hmkgq : mkg q = 0 := by
        have hz : φ.symm (mkg q) = 0 := by rw [← hπy, hq]; exact hπawp
        have := congrArg φ hz
        simpa using this
      -- q ∈ span(range g)
      have hq_mem : q ∈ Ideal.span (Set.range g) := (hmkg_eq_zero q).1 hmkgq
      -- rename yemb q ∈ span(range f)
      have hawp_span : aeval w p ∈ Ideal.span (Set.range f) := by
        rw [← hq]
        have hmap : rename yemb q ∈ Ideal.map (rename yemb) (Ideal.span (Set.range g)) :=
          Ideal.mem_map_of_mem _ hq_mem
        rw [Ideal.map_span] at hmap
        refine Ideal.span_le.2 ?_ hmap
        rintro x ⟨y, ⟨j, rfl⟩, rfl⟩
        simp only [SetLike.mem_coe]
        have heq : rename yemb (g j) = f (Fin.natAdd n j) := by rw [hf_nat]
        rw [heq]
        exact hfmem _
      -- conclude
      have hsum : p = (p - aeval w p) + aeval w p := by ring
      rw [hsum]
      exact Ideal.add_mem _ hstep1 hawp_span
    · exact hspan_le_ker
  · -- jacobian
    -- key reduction: jacobianDet of f equals renamed jacobianDet of g
    have hcastLE_cast : ∀ i : Fin n,
        Fin.castLE hcnm (Fin.castAdd d i) = Fin.castAdd m' i := by
      intro i; apply Fin.ext; simp [Fin.castLE, Fin.castAdd, Fin.castAdd]
    have hcastLE_nat : ∀ j : Fin d,
        Fin.castLE hcnm (Fin.natAdd n j) = Fin.natAdd n (Fin.castLE hdm j) := by
      intro j; apply Fin.ext; simp [Fin.castLE, Fin.natAdd]
    -- the matrix
    set M : Matrix (Fin (n + d)) (Fin (n + d)) (MvPolynomial (Fin (n + m')) R) :=
      fun i' j' => pderiv (Fin.castLE hcnm i') (f j') with hM
    -- reindexing equiv
    set e := (finSumFinEquiv : Fin n ⊕ Fin d ≃ Fin (n + d)) with he
    -- block form: the submatrix is block lower-triangular with identity top-left and
    -- a zero top-right block.
    have hblock : M.submatrix e e
        = Matrix.fromBlocks 1 0
            (fun (i : Fin d) (j : Fin n) =>
              pderiv (Fin.natAdd n (Fin.castLE hdm i)) (f (Fin.castAdd d j)))
            (fun (i j : Fin d) =>
              rename yemb (pderiv (Fin.castLE hdm i) (g j))) := by
      refine Matrix.ext fun i' j' => ?_
      rcases i' with i | i <;> rcases j' with j | j
      · -- top-left: identity.  Entry = ∂(X (castAdd j) - H j)/∂(X (castAdd i)).
        -- `∂(X (castAdd j))/∂(X (castAdd i)) = δ_{ij}` and `∂(H j)/∂(X (castAdd i)) = 0`
        -- (H j is renamed along natAdd, so by `pderiv_castAdd_rename_natAdd` it has no
        -- castAdd-variable), leaving `δ_{ij} = (1 : Matrix) i j`.
        simp only [Matrix.submatrix_apply, Matrix.fromBlocks_apply₁₁, e,
          finSumFinEquiv_apply_left, M, hf_cast, hcastLE_cast]
        have h2 : pderiv (Fin.castAdd m' i) (H j) = 0 := by
          simpa only [H] using pderiv_castAdd_rename_natAdd i (h j)
        rw [map_sub, h2, sub_zero, pderiv_X, Matrix.one_apply, Pi.single_apply]
        congr 1
        simp only [eq_iff_iff]
        exact ⟨fun hh ↦ (Fin.castAdd_injective _ _ hh).symm, fun hh ↦ by rw [hh]⟩
      · -- top-right: zero.  Entry = ∂(G j)/∂(X (castAdd i)) = 0 since G j is renamed
        -- along natAdd (no castAdd-variable), by `pderiv_castAdd_rename_natAdd`.
        simp only [Matrix.submatrix_apply, Matrix.fromBlocks_apply₁₂, e,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, M, hf_nat,
          hcastLE_cast, G, Matrix.zero_apply]
        exact pderiv_castAdd_rename_natAdd i (g j)
      · -- bottom-left
        simp only [Matrix.submatrix_apply, Matrix.fromBlocks_apply₂₁, e,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, M, hcastLE_nat]
      · -- bottom-right
        simp only [Matrix.submatrix_apply, Matrix.fromBlocks_apply₂₂, e,
          finSumFinEquiv_apply_right, M, hf_nat, hcastLE_nat, G]
        rw [pderiv_rename yemb_inj]
    -- compute the determinant: block lower-triangular ⇒ det = det(top-left)·det(bottom-right)
    -- = det(bottom-right) = rename yemb (jacobianDet hdm g).
    have hdet : jacobianDet hcnm f = rename yemb (jacobianDet hdm g) := by
      rw [jacobianDet, ← Matrix.det_submatrix_equiv_self e, hblock,
        Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, one_mul, jacobianDet]
      exact det_rename_comm yemb _
    rw [hdet, hπy]
    -- IsUnit (φ.symm (mkg (jacobianDet hdm g)))
    have huq : IsUnit (mkg (jacobianDet hdm g)) := hss
    exact huq.map φ.symm.toRingHom
  · -- generators
    rw [← haE]
    ext x
    simp only [Set.mem_range, hπXcast]
