-/

@[expose] public section

namespace Stacks.Smoothing

universe u v w x

/-- The elementwise form of the equality `Ann(t) = Ann(t²)`. -/
private theorem mul_eq_zero_iff_of_annihilator_eq {S : Type*} [CommRing S] {t : S}
    (h : (Submodule.span S {t}).annihilator = (Submodule.span S {t ^ 2}).annihilator) (x : S) :
    x * t = 0 ↔ x * t ^ 2 = 0 := by
  simpa only [Submodule.mem_annihilator_span_singleton, smul_eq_mul] using SetLike.ext_iff.mp h x

/-- If the annihilators of `t` and `t²` agree, then those of `tⁿ⁺¹` and `tⁿ⁺²` agree. -/
public theorem mul_pow_succ_eq_zero_iff {S : Type*} [CommRing S] {t : S}
    (h : ∀ x : S, x * t = 0 ↔ x * t ^ 2 = 0) (x : S) (n : ℕ) :
    x * t ^ (n + 1) = 0 ↔ x * t ^ (n + 2) = 0 := by
  have h1 : x * t ^ (n + 1) = x * t ^ n * t := by ring
  have h2 : x * t ^ (n + 2) = x * t ^ n * t ^ 2 := by ring
  rw [h1, h2]
  exact h (x * t ^ n)

/-- If the annihilators of `t` and `t²` agree, then those of `t⁴` and `t⁸` agree. -/
private theorem mul_pow_four_eq_zero_iff_pow_eight {S : Type*} [CommRing S] {t : S}
    (h : ∀ x : S, x * t = 0 ↔ x * t ^ 2 = 0) (x : S) :
    x * t ^ 4 = 0 ↔ x * t ^ 8 = 0 :=
  (mul_pow_succ_eq_zero_iff h x 3).trans <| (mul_pow_succ_eq_zero_iff h x 4).trans <|
    (mul_pow_succ_eq_zero_iff h x 5).trans (mul_pow_succ_eq_zero_iff h x 6)

/-- The lifting lemma for an element `ρ` whose square is a given element `θ`, in the form in
which it is applied below: the hypotheses and the conclusion refer to the ideals generated by
`θ` and by the image of `θ`, rather than to the squares of `ρ` and of its image. Only the parts
of the conclusion used below are retained. -/
private theorem exists_finitePresentation_lift_smoothAt_of_sq_eq
    (R : Type u) (Λ : Type v) (C : Type w)
    [CommRing R] [CommRing Λ] [CommRing C] [IsNoetherianRing R] [Algebra R Λ]
    (ρ θ : R) (μ : Λ) (hθ : θ = ρ ^ 2) (hμ : μ = (algebraMap R Λ ρ) ^ 2)
    (hR : ∀ r : R, r * ρ = 0 ↔ r * θ = 0)
    (hΛ : ∀ z : Λ, z * algebraMap R Λ ρ = 0 ↔ z * μ = 0)
    [Algebra (R ⧸ Ideal.span {θ}) C]
    [Algebra.FinitePresentation (R ⧸ Ideal.span {θ}) C]
    [Algebra (R ⧸ Ideal.span {θ}) (Λ ⧸ Ideal.span {μ})]
    (hquot : ∀ r : R, algebraMap (R ⧸ Ideal.span {θ}) (Λ ⧸ Ideal.span {μ})
      (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (algebraMap R Λ r))
    (f : C →ₐ[R ⧸ Ideal.span {θ}] Λ ⧸ Ideal.span {μ}) :
    ∃ (D : Type (max u v w)) (_ : CommRing D) (_ : Algebra R D)
      (_ : Algebra.FinitePresentation R D) (g : D →ₐ[R] Λ)
      (c : C →+* D ⧸ Ideal.span {algebraMap R D ρ})
      (reduceΛ : (Λ ⧸ Ideal.span {μ}) →+* Λ ⧸ Ideal.span {algebraMap R Λ ρ})
      (reduceD : (D ⧸ Ideal.span {algebraMap R D ρ}) →+*
        Λ ⧸ Ideal.span {algebraMap R Λ ρ}),
      (∀ z : Λ, reduceΛ (Ideal.Quotient.mk _ z) = Ideal.Quotient.mk _ z) ∧
      (∀ z : D, reduceD (Ideal.Quotient.mk _ z) = Ideal.Quotient.mk _ (g z)) ∧
      (∀ y : C, reduceD (c y) = reduceΛ (f y)) ∧
      (∀ r : R, c (algebraMap (R ⧸ Ideal.span {θ}) C (Ideal.Quotient.mk _ r)) =
        Ideal.Quotient.mk _ (algebraMap R D r)) ∧
      (∀ (q : Ideal D) [q.IsPrime], algebraMap R D ρ ∉ q → Algebra.IsSmoothAt R q) ∧
      ∀ (q : Ideal D) [q.IsPrime], algebraMap R D ρ ∈ q →
        (∃ (p : Ideal C) (_ : p.IsPrime), Algebra.IsSmoothAt (R ⧸ Ideal.span {θ}) p ∧
          p = Ideal.comap c (Ideal.map
            (Ideal.Quotient.mk (Ideal.span {algebraMap R D ρ})) q)) →
        Algebra.IsSmoothAt R q := by
  subst hθ
  subst hμ
  obtain ⟨D, instD, algD, fpD, g, c, reduceΛ, reduceD, _, h1, h2, h3, h4, _, h6, h7, _⟩ :=
    exists_finitePresentation_lift_smoothAt R Λ C ρ hR hΛ hquot f
  exact ⟨D, instD, algD, fpD, g, c, reduceΛ, reduceD, h1, h2, h3, h4, h6, h7⟩

/-- An element lies in the singular ideal if `R → A` is smooth at every prime not containing it. -/
private theorem mem_singularIdeal_of_forall_smoothAt {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {f : A}
    (h : ∀ (q : Ideal A) [q.IsPrime], f ∉ q → Algebra.SmoothAt R A q) :
    f ∈ singularIdeal R A := by
  rw [singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
  intro q hq
  by_contra hmem
  exact hq (h q.asIdeal hmem)

/-- **Stacks 07F0.** Let `R` be Noetherian, let `Λ` be an `R`-algebra and let `π ∈ R` be an
element with `Ann_R(π) = Ann_R(π²)` and `Ann_Λ(π) = Ann_Λ(π²)`. Let `A → Λ` be an `R`-algebra
map with `A` of finite presentation and with the image of `π` strictly standard in `A` over `R`,
and let `A/π⁸A → C̄ → Λ/π⁸Λ` be a factorization of the induced map with `C̄` of finite
presentation over `R/π⁸R`. Then `A → Λ` factors as `A → B → Λ` with `B` of finite presentation
such that `R_π → B_π` is smooth and
`H_{C̄/(R/π⁸R)} · Λ/π⁸Λ ⊆ √(H_{B/R}Λ) mod π⁸Λ`. -/
@[stacks 07F0]
theorem exists_finitePresentation_factorization_smoothAway_singularIdeal_le
    (R : Type u) (Λ : Type v) (A : Type w) (C : Type x)
    [CommRing R] [CommRing Λ] [CommRing A] [CommRing C] [IsNoetherianRing R]
    [Algebra R Λ] [Algebra R A] [Algebra.FinitePresentation R A] (π : R)
    (hR : (Submodule.span R {π}).annihilator = (Submodule.span R {π ^ 2}).annihilator)
    (hΛ : (Submodule.span Λ {algebraMap R Λ π}).annihilator =
      (Submodule.span Λ {(algebraMap R Λ π) ^ 2}).annihilator)
    (fA : A →ₐ[R] Λ) (hπ : IsStrictlyStandard (R := R) (A := A) (algebraMap R A π))
    [Algebra (R ⧸ Ideal.span {π ^ 8}) C]
    [Algebra.FinitePresentation (R ⧸ Ideal.span {π ^ 8}) C]
    [Algebra (R ⧸ Ideal.span {π ^ 8}) (Λ ⧸ Ideal.span {(algebraMap R Λ π) ^ 8})]
    (hquot : ∀ r : R, algebraMap (R ⧸ Ideal.span {π ^ 8})
        (Λ ⧸ Ideal.span {(algebraMap R Λ π) ^ 8}) (Ideal.Quotient.mk _ r) =
      Ideal.Quotient.mk _ (algebraMap R Λ r))
    (toC : (A ⧸ Ideal.span {(algebraMap R A π) ^ 8}) →+* C)
    (htoC : ∀ r : R, toC (Ideal.Quotient.mk _ (algebraMap R A r)) =
      algebraMap (R ⧸ Ideal.span {π ^ 8}) C (Ideal.Quotient.mk _ r))
    (fC : C →ₐ[R ⧸ Ideal.span {π ^ 8}] Λ ⧸ Ideal.span {(algebraMap R Λ π) ^ 8})
    (hfC : ∀ a : A, fC (toC (Ideal.Quotient.mk _ a)) = Ideal.Quotient.mk _ (fA a)) :
    ∃ (B : Type (max u v x)) (_ : CommRing B) (_ : Algebra R B)
      (_ : Algebra.FinitePresentation R B) (a : A →ₐ[R] B) (g : B →ₐ[R] Λ),
      g.comp a = fA ∧
      (letI : Algebra (Localization.Away π) (Localization.Away (algebraMap R B π)) :=
        (Localization.awayMap (algebraMap R B) π).toAlgebra
       Algebra.Smooth (Localization.Away π) (Localization.Away (algebraMap R B π))) ∧
      Ideal.map fC.toRingHom (singularIdeal (R ⧸ Ideal.span {π ^ 8}) C) ≤
        Ideal.map (Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 8}))
          (Ideal.map g.toRingHom (singularIdeal R B)).radical := by
  classical
  obtain ⟨ρ, hρ⟩ : ∃ ρ : R, ρ = π ^ 4 := ⟨_, rfl⟩
  have hRe : ∀ r : R, r * π = 0 ↔ r * π ^ 2 = 0 := mul_eq_zero_iff_of_annihilator_eq hR
  have hΛe : ∀ z : Λ, z * algebraMap R Λ π = 0 ↔ z * (algebraMap R Λ π) ^ 2 = 0 :=
    mul_eq_zero_iff_of_annihilator_eq hΛ
  have hθ : (π : R) ^ 8 = ρ ^ 2 := by rw [hρ]; ring
  have hμ : (algebraMap R Λ π) ^ 8 = (algebraMap R Λ ρ) ^ 2 := by rw [hρ, map_pow]; ring
  have hRρ : ∀ r : R, r * ρ = 0 ↔ r * π ^ 8 = 0 := by
    intro r
    rw [hρ]
    exact mul_pow_four_eq_zero_iff_pow_eight hRe r
  have hΛρ : ∀ z : Λ, z * algebraMap R Λ ρ = 0 ↔ z * (algebraMap R Λ π) ^ 8 = 0 := by
    intro z
    rw [hρ, map_pow]
    exact mul_pow_four_eq_zero_iff_pow_eight hΛe z
  obtain ⟨D, instD, algD, fpD, g, c, reduceΛ, reduceD, hreduceΛ, hreduceD, hreduceCompat,
      hreduceR, hDaway, hDsmooth⟩ :=
    exists_finitePresentation_lift_smoothAt_of_sq_eq R Λ C ρ (π ^ 8)
      ((algebraMap R Λ π) ^ 8) hθ hμ hRρ hΛρ hquot fC
  let : CommRing D := instD
  let : Algebra R D := algD
  let : Algebra.FinitePresentation R D := fpD
  -- The maps `A/π⁴A → D/π⁴D` and their compatibility with the maps to `Λ/π⁴Λ`.
  have hJD : (Ideal.span {algebraMap R D ρ} : Ideal D) =
      Ideal.span {(algebraMap R D π) ^ 4} := by rw [hρ, map_pow]
  have hJL : (Ideal.span {algebraMap R Λ ρ} : Ideal Λ) =
      Ideal.span {(algebraMap R Λ π) ^ 4} := by rw [hρ, map_pow]
  have hψcomm : ∀ r : R,
      c (toC (Ideal.Quotient.mk (Ideal.span {(algebraMap R A π) ^ 8}) (algebraMap R A r))) =
        algebraMap R (D ⧸ Ideal.span {algebraMap R D ρ}) r := by
    intro r
    rw [htoC r, hreduceR r]
    rfl
  let ψ : A →ₐ[R] D ⧸ Ideal.span {algebraMap R D ρ} :=
    { c.comp (toC.comp (Ideal.Quotient.mk (Ideal.span {(algebraMap R A π) ^ 8}))) with
      commutes' := hψcomm }
  have hψzero : ψ ((algebraMap R A π) ^ 4) = 0 := by
    rw [← map_pow, ← hρ, ψ.commutes]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  let eD : (D ⧸ Ideal.span {algebraMap R D ρ}) ≃ₐ[R]
      (D ⧸ Ideal.span {(algebraMap R D π) ^ 4}) := Ideal.quotientEquivAlgOfEq R hJD
  let bar : (A ⧸ Ideal.span {(algebraMap R A π) ^ 4}) →ₐ[R]
      D ⧸ Ideal.span {(algebraMap R D π) ^ 4} :=
    eD.toAlgHom.comp (Ideal.Quotient.liftₐ _ ψ fun y hy => by
      obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hy
      rw [← ht, map_mul, hψzero, mul_zero])
  have hbar : ∀ (a₀ : A) (y : D),
      bar (Ideal.Quotient.mk (Ideal.span {(algebraMap R A π) ^ 4}) a₀) =
          Ideal.Quotient.mk (Ideal.span {(algebraMap R D π) ^ 4}) y →
        Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 4}) (fA a₀) =
          Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 4}) (g y) := by
    intro a₀ y hy
    have hlift : ψ a₀ = Ideal.Quotient.mk (Ideal.span {algebraMap R D ρ}) y :=
      eD.injective (hy.trans (Ideal.quotientEquivAlgOfEq_mk R hJD y).symm)
    have hleft : reduceD (ψ a₀) =
        Ideal.Quotient.mk (Ideal.span {algebraMap R Λ ρ}) (g y) := by
      rw [hlift, hreduceD y]
    have hright : reduceD (ψ a₀) =
        Ideal.Quotient.mk (Ideal.span {algebraMap R Λ ρ}) (fA a₀) := by
      have hψa : ψ a₀ = c (toC (Ideal.Quotient.mk
        (Ideal.span {(algebraMap R A π) ^ 8}) a₀)) := rfl
      rw [hψa, hreduceCompat, hfC a₀, hreduceΛ]
    have hdiff : fA a₀ - g y ∈ (Ideal.span {algebraMap R Λ ρ} : Ideal Λ) :=
      Ideal.Quotient.eq.mp (hright.symm.trans hleft)
    rw [hJL] at hdiff
    exact Ideal.Quotient.eq.mpr hdiff
  -- The common desingularization of `A` and `D`.
  obtain ⟨B, instB, algDB, algB, towerB, fpB, a, G, hGa, hGd, _, hHBR⟩ :=
    exists_finitePresentation_factorization_singularIdeal_le R A D Λ π hR hΛ fA g hπ bar hbar
  let : CommRing B := instB
  let : Algebra D B := algDB
  let : Algebra R B := algB
  let : IsScalarTower R D B := towerB
  let : Algebra.FinitePresentation R B := fpB
  -- `R → B` is smooth at every prime not containing `π`.
  have hBaway : ∀ (q : Ideal B) [q.IsPrime], algebraMap R B π ∉ q →
      Algebra.SmoothAt R B q := by
    intro q _ hπq
    let : (q.comap (algebraMap D B)).IsPrime := Ideal.IsPrime.comap _
    have hπp : algebraMap R D ρ ∉ q.comap (algebraMap D B) := by
      rw [hρ, map_pow]
      intro hmem
      have h1 : algebraMap R D π ∈ q.comap (algebraMap D B) :=
        ((inferInstance : (q.comap (algebraMap D B)).IsPrime).pow_mem_iff_mem 4
          (by norm_num)).mp hmem
      rw [Ideal.mem_comap, ← IsScalarTower.algebraMap_apply R D B] at h1
      exact hπq h1
    have hDsm : Algebra.SmoothAt R D (q.comap (algebraMap D B)) :=
      (Algebra.smoothAt_iff_isSmoothAt R D _).mpr (hDaway _ hπp)
    by_contra hns
    have hq : singularIdeal R B ≤ q := (singularIdeal_le_iff_not_smoothAt R B q).mpr hns
    have hp : singularIdeal R D ≤ q.comap (algebraMap D B) := fun z hz =>
      Ideal.mem_comap.mpr (hq (hHBR (Ideal.mem_map_of_mem _ hz)))
    exact (singularIdeal_le_iff_not_smoothAt R D _).mp hp hDsm
  have hπB : algebraMap R B π ∈ singularIdeal R B :=
    mem_singularIdeal_of_forall_smoothAt fun q _ => hBaway q
  refine ⟨B, instB, algB, fpB, a, G, hGa, ?_, ?_⟩
  · let : Algebra (Localization.Away π) (Localization.Away (algebraMap R B π)) :=
      (Localization.awayMap (algebraMap R B) π).toAlgebra
    have hmapComp := IsLocalization.map_comp (M := Submonoid.powers π)
      (S := Localization.Away π) (g := algebraMap R B)
      (T := Submonoid.powers (algebraMap R B π))
      (Q := Localization.Away (algebraMap R B π))
      (fun y hy => by
        rcases (Submonoid.mem_powers_iff y π).1 hy with ⟨n, rfl⟩
        exact ⟨n, by simp [map_pow]⟩)
    let : IsScalarTower R (Localization.Away π) (Localization.Away (algebraMap R B π)) :=
      IsScalarTower.of_algebraMap_eq'
        ((IsScalarTower.algebraMap_eq R B (Localization.Away (algebraMap R B π))).trans
          hmapComp.symm)
    let : Algebra.Smooth R (Localization.Away (algebraMap R B π)) :=
      smooth_localization_away_of_mem_singularIdeal R B hπB
    exact Algebra.Smooth.localization_base (Submonoid.powers π)
  · rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap]
    obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (c y)
    obtain ⟨wΛ, hw⟩ := Ideal.Quotient.mk_surjective (fC y)
    have hzD : z ∈ singularIdeal R D := by
      refine mem_singularIdeal_of_forall_smoothAt fun q _ hznot => ?_
      by_cases hπρ : algebraMap R D ρ ∈ q
      swap
      · exact (Algebra.smoothAt_iff_isSmoothAt R D q).mpr (hDaway q hπρ)
      have hle : (Ideal.span {algebraMap R D ρ} : Ideal D) ≤ q :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπρ)
      let : (Ideal.map (Ideal.Quotient.mk
          (Ideal.span {algebraMap R D ρ})) q).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
      let : (Ideal.comap c (Ideal.map (Ideal.Quotient.mk
          (Ideal.span {algebraMap R D ρ})) q)).IsPrime := Ideal.IsPrime.comap c
      have hynot : y ∉ Ideal.comap c (Ideal.map (Ideal.Quotient.mk
          (Ideal.span {algebraMap R D ρ})) q) := by
        intro hmem
        rw [Ideal.mem_comap, ← hz, Ideal.mem_quotient_iff_mem hle] at hmem
        exact hznot hmem
      have hsm : Algebra.SmoothAt (R ⧸ Ideal.span {π ^ 8}) C
          (Ideal.comap c (Ideal.map (Ideal.Quotient.mk
            (Ideal.span {algebraMap R D ρ})) q)) := by
        by_contra hns
        exact hynot ((singularIdeal_le_iff_not_smoothAt _ C _).mpr hns hy)
      exact (Algebra.smoothAt_iff_isSmoothAt R D q).mpr (hDsmooth q hπρ
        ⟨_, inferInstance, Algebra.isSmoothAt_of_smoothAt _ C hsm, rfl⟩)
    have hρH : algebraMap R Λ ρ ∈ Ideal.map G.toRingHom (singularIdeal R B) := by
      rw [← G.commutes ρ]
      refine Ideal.mem_map_of_mem _ ?_
      rw [hρ, map_pow]
      exact Ideal.pow_mem_of_mem _ hπB 4 (by norm_num)
    have hgz : g z ∈ Ideal.map G.toRingHom (singularIdeal R B) := by
      have hGdz : G (algebraMap D B z) = g z := DFunLike.congr_fun hGd z
      rw [← hGdz]
      exact Ideal.mem_map_of_mem _ (hHBR (Ideal.mem_map_of_mem _ hzD))
    have hrel : g z - wΛ ∈ (Ideal.span {algebraMap R Λ ρ} : Ideal Λ) := by
      refine Ideal.Quotient.eq.mp ?_
      rw [← hreduceD, hz, hreduceCompat, ← hw, hreduceΛ]
    have hwH : wΛ ∈ Ideal.map G.toRingHom (singularIdeal R B) := by
      simpa using Ideal.sub_mem _ hgz
        (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hρH) hrel)
    have hgoal : fC.toRingHom y =
        Ideal.Quotient.mk (Ideal.span {(algebraMap R Λ π) ^ 8}) wΛ := hw.symm
    rw [hgoal]
    exact Ideal.mem_map_of_mem _ (Ideal.le_radical hwH)

end Stacks.Smoothing

end
