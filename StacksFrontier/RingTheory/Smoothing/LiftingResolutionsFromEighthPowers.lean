module

public import Mathlib.RingTheory.Localization.BaseChange
public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Smoothing.BaseChangeOfPresentation
public import StacksFrontier.RingTheory.Smoothing.DesingularizationLifting
public import StacksFrontier.RingTheory.Smoothing.LocalSmoothingSituation

/-!
# Lifting a resolution from the quotient by eighth powers

Let `R → A → Λ ⊃ q` be a local smoothing situation and let `π₁, …, π_r ∈ R`, `r ≥ 1`, be
elements mapping into `q`. Assume that for each `i` the annihilator of `π_i` agrees with the
annihilator of `π_i²` both in `R/(π₁⁸, …, π_{i-1}⁸)R` and in `Λ/(π₁⁸, …, π_{i-1}⁸)Λ`, and that
each `π_i` maps to a strictly standard element of `A` over `R`. If the chain

`R/(π₁⁸, …, π_r⁸)R → A/(π₁⁸, …, π_r⁸)A → Λ/(π₁⁸, …, π_r⁸)Λ ⊃ q/(π₁⁸, …, π_r⁸)Λ`

can be resolved, then so can `R → A → Λ ⊃ q`.

The proof is an induction on `r`. For `r = 1` the hypotheses are exactly those of
`Stacks.Smoothing.exists_finitePresentation_factorization_smoothAway_singularIdeal_le`, which
lifts the resolving algebra over `R/π₁⁸R` to a factorization `A → B → Λ` of finite presentation
whose singular ideal both dominates that of `A` and is not contained in `q`: the containment
`𝔥_A ⊆ 𝔥_B` is read off modulo `π₁⁸Λ` and improved to a containment in `Λ` because `π₁⁸Λ`
already lies in `𝔥_B`, while `𝔥_B ⊄ q` follows from the corresponding statement for the
resolution modulo `π₁⁸`. For `r > 1` one applies the inductive hypothesis to the situation
obtained by dividing by `π₁⁸`, whose strictly standard elements are supplied by the base-change
statement `Stacks.Smoothing.isStrictlyStandard_basechange`.

## Main definitions

* `Stacks.Smoothing.eighthPowerIdeal`: the ideal `(π₁⁸, …, π_r⁸)` of a finite family.
* `Stacks.Smoothing.eighthPowerPrefixIdeal`: the ideal `(π₁⁸, …, π_{i-1}⁸)` of the members
  strictly preceding an index.

## Main results

* `Stacks.Smoothing.canBeResolved_of_quotient_eighthPowerIdeal`: **a resolution of the chain
  modulo the eighth powers of `π₁, …, π_r` lifts to a resolution of the chain itself.**

## Implementation notes

The chain modulo the eighth powers is the triple of quotient rings `R/(π₁⁸, …, π_r⁸)R`,
`A/(π₁⁸, …, π_r⁸)A`, `Λ/(π₁⁸, …, π_r⁸)Λ` together with the induced maps, and resolvability of it
is the unbundled predicate `Stacks.Smoothing.CanBeResolved` applied to that triple; the ideal
`q/(π₁⁸, …, π_r⁸)Λ` is its image under the quotient map. The intermediate situations of the
induction are packaged back into `Stacks.Smoothing.LocalSmoothingSituation`, whose Noetherian
and finite-presentation hypotheses are inherited by the quotients.

The annihilator conditions are stated as equalities of `Submodule.annihilator` of the spans of
the relevant element and of its square, which is the form in which they are consumed by
`Stacks.Smoothing.exists_finitePresentation_factorization_smoothAway_singularIdeal_le`.

## References

* [Stacks Project, Tag 07F8](https://stacks.math.columbia.edu/tag/07F8)
* [Stacks Project, Tag 07F7](https://stacks.math.columbia.edu/tag/07F7)
* [Stacks Project, Tag 07F0](https://stacks.math.columbia.edu/tag/07F0)
* [Stacks Project, Tag 07CC](https://stacks.math.columbia.edu/tag/07CC)
-/

@[expose] public section

namespace Stacks.Smoothing

open scoped TensorProduct

universe u v w
universe u₁ v₁ w₁

/-- Equality of the annihilator of an element with that of its square, in the elementwise
form in which it is used. -/
private theorem annihilator_span_singleton_eq_sq_iff {T : Type*} [CommRing T] (t : T) :
    (Submodule.span T {t}).annihilator = (Submodule.span T {t ^ 2}).annihilator ↔
      ∀ x : T, x * t = 0 ↔ x * t ^ 2 = 0 := by
  rw [SetLike.ext_iff]
  simp only [Submodule.mem_annihilator_span_singleton, smul_eq_mul]

/-- The ideal generated by the eighth powers of a finite indexed family. -/
def eighthPowerIdeal {R : Type u} [CommRing R] {r : ℕ}
    (π : Fin r → R) : Ideal R :=
  Ideal.span {x | ∃ i, x = π i ^ 8}

/-- The ideal generated by the eighth powers of the members of `π` strictly
before `i`. -/
def eighthPowerPrefixIdeal {R : Type u} [CommRing R] {r : ℕ}
    (π : Fin r → R) (i : Fin r) : Ideal R :=
  Ideal.span {x | ∃ j, j < i ∧ x = π j ^ 8}

/-- The ideal generated by the eighth powers of a nonempty family is the ideal generated by
the eighth powers of the earlier members together with the eighth power of the last one. -/
private lemma eighthPowerIdeal_eq_prefix_sup_last
    {R : Type*} [CommRing R] {r : ℕ} (π : Fin (r + 1) → R) :
    eighthPowerIdeal π =
      eighthPowerPrefixIdeal π (Fin.last r) ⊔ Ideal.span {π (Fin.last r) ^ 8} := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro x ⟨i, rfl⟩
    by_cases hi : i.val < r
    · exact Submodule.mem_sup_left (Ideal.subset_span ⟨i, Fin.lt_def.mpr hi, rfl⟩)
    · have hieq : i = Fin.last r := Fin.ext (by simp only [Fin.val_last]; omega)
      subst i
      exact Submodule.mem_sup_right (Ideal.subset_span rfl)
  · apply sup_le
    · apply Ideal.span_le.mpr
      rintro x ⟨i, hi, rfl⟩
      exact Ideal.subset_span ⟨i, rfl⟩
    · exact (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.subset_span ⟨Fin.last r, rfl⟩)

/-- If every member of a family maps into an ideal `q` of `Λ`, then each ideal generated by the
eighth powers of an initial segment is contained in the contraction of `q`. -/
private lemma eighthPowerPrefixIdeal_le_comap
    {R Λ : Type*} [CommRing R] [CommRing Λ] [Algebra R Λ] {r : ℕ}
    (π : Fin r → R) (q : Ideal Λ) (i : Fin r)
    (hπq : ∀ j, algebraMap R Λ (π j) ∈ q) :
    eighthPowerPrefixIdeal π i ≤ q.comap (algebraMap R Λ) := by
  apply Ideal.span_le.mpr
  rintro x ⟨j, hj, rfl⟩
  show algebraMap R Λ (π j ^ 8) ∈ q
  rw [map_pow]
  exact Ideal.pow_mem_of_mem (I := q) (a := algebraMap R Λ (π j))
    (hπq j) 8 (by norm_num)

/-- The elementwise equality of the annihilators of an element and of its square transports
along a ring isomorphism. -/
private lemma annihilator_condition_ringEquiv
    {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S) (t : R)
    (h : ∀ x : R, x * t = 0 ↔ x * t ^ 2 = 0) :
    ∀ y : S, y * e t = 0 ↔ y * (e t) ^ 2 = 0 := by
  intro y
  have heq (x : R) : x = 0 ↔ e x = 0 := by
    constructor
    · rintro rfl; simp
    · intro hx; exact e.injective (by simpa using hx)
  have hh := h (e.symm y)
  simp only [heq, e.map_mul, e.map_pow, e.apply_symm_apply] at hh
  exact hh

/-- Precomposing a ring map with a ring isomorphism does not change whether it is smooth. -/
private lemma smooth_comp_ringEquiv_iff
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    (e : R ≃+* S) (f : S →+* T) :
    (f.comp e.toRingHom).Smooth ↔ f.Smooth := by
  constructor
  · intro hf
    have h := RingHom.Smooth.comp
      (RingHom.Smooth.of_bijective (f := e.symm.toRingHom) e.symm.bijective) hf
    convert h using 1
    ext x
    simp
  · exact fun hf => RingHom.Smooth.comp
      (RingHom.Smooth.of_bijective (f := e.toRingHom) e.bijective) hf

/-- An `R`-algebra isomorphism `A ≃ B` induces an `R`-algebra isomorphism between the
localization of `A` away from an element and the localization of `B` away from its image. -/
private noncomputable def localizationAwayAlgEquiv
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (e : A ≃ₐ[R] B) (a : A) :
    Localization.Away a ≃ₐ[R] Localization.Away (e a) := by
  let f := Localization.awayMapₐ e.toAlgHom a
  have hf : Function.Bijective f := by
    constructor
    · apply (Localization.awayMap_injective_iff (f := e.toRingEquiv.toRingHom) (r := a)).2
      intro x hx
      have hx' : x = 0 := e.injective (by simpa using hx)
      exact ⟨0, by simp [hx']⟩
    · apply (Localization.awayMap_surjective_iff
        (f := e.toRingEquiv.toRingHom) (r := a)).2
      intro x
      refine ⟨e.symm x, 0, ?_⟩
      simp
  exact AlgEquiv.ofBijective f hf

/-- Smoothness at a prime transports along an `R`-algebra isomorphism, the prime being carried
over by the isomorphism. -/
private lemma smoothAt_algEquiv
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (e : A ≃ₐ[R] B) (p : Ideal A) [p.IsPrime] :
    letI : (Ideal.map e.toRingHom p).IsPrime :=
      Ideal.map_isPrime_of_surjective e.surjective (by simp)
    Algebra.SmoothAt R A p ↔
      Algebra.SmoothAt R B (Ideal.map e.toRingHom p) := by
  let p' : Ideal B := Ideal.map e.toRingHom p
  let : p'.IsPrime := Ideal.map_isPrime_of_surjective e.surjective (by simp)
  constructor
  · rintro ⟨a, ha, hsm⟩
    refine ⟨e a, ?_, ?_⟩
    · intro hm
      have hm' : e a ∈ Ideal.map e.toRingHom p := hm
      obtain ⟨x, hx, hxeq⟩ :=
        (Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective).1 hm'
      exact ha (e.injective hxeq ▸ hx)
    · exact Algebra.Smooth.of_equiv (localizationAwayAlgEquiv e a)
  · rintro ⟨b, hb, hsm⟩
    refine ⟨e.symm b, ?_, ?_⟩
    · exact fun hm => hb (by simpa using Ideal.mem_map_of_mem e.toRingHom hm)
    · exact Algebra.Smooth.of_equiv (localizationAwayAlgEquiv e.symm b)

/-- If `R → A` is smooth at the contraction of a prime of `A/IA`, then the induced map
`R/I → A/IA` is smooth at that prime. -/
private lemma smoothAt_quotient_of_smoothAt
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (I : Ideal R) (p : Ideal (A ⧸ I.map (algebraMap R A)))
    [p.IsPrime]
    (h : Algebra.SmoothAt R A
      (p.comap (algebraMap A (A ⧸ I.map (algebraMap R A))))) :
    letI : Algebra (R ⧸ I) (A ⧸ I.map (algebraMap R A)) :=
      Ideal.Quotient.algebraQuotientMapQuotient
    Algebra.SmoothAt (R ⧸ I) (A ⧸ I.map (algebraMap R A)) p := by
  let R' := R ⧸ I
  let IA := I.map (algebraMap R A)
  let A' := A ⧸ IA
  let mkA : A →+* A' := Ideal.Quotient.mk IA
  let : Algebra R' A' := Ideal.Quotient.algebraQuotientMapQuotient
  let eA : A' ≃ₐ[R'] R' ⊗[R] A :=
    Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I
  obtain ⟨a, ha, hsm⟩ := h
  have hamk : mkA a ∉ p := by
    intro hp
    exact ha hp
  let tA : R' ⊗[R] A := (1 : R') ⊗ₜ[R] a
  have hpoint : eA (mkA a) = tA := by
    show eA (Ideal.Quotient.mk IA a) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk]
  have hnot : tA ∉ Ideal.map eA.toRingHom p := by
    intro hm
    obtain ⟨x, hx, hxeq⟩ :=
      (Ideal.mem_map_iff_of_surjective eA.toRingHom eA.surjective).1 hm
    apply hamk
    have hx' : x = mkA a := eA.injective (hxeq.trans hpoint.symm)
    exact hx' ▸ hx
  have hsmoothTensor : Algebra.Smooth R' (R' ⊗[R] Localization.Away a) := by
    let : Algebra.Smooth R (Localization.Away a) := hsm
    infer_instance
  let eAway : R' ⊗[R] Localization.Away a ≃ₐ[R'] Localization.Away tA :=
    IsLocalization.Away.tensorProductEquivTMulRight R R' a (Localization.Away a)
  have hsmoothAway : Algebra.Smooth R' (Localization.Away tA) := by
    let : Algebra.Smooth R' (R' ⊗[R] Localization.Away a) := hsmoothTensor
    exact Algebra.Smooth.of_equiv eAway
  have : (Ideal.map eA.toRingHom p).IsPrime :=
    Ideal.map_isPrime_of_surjective eA.surjective (by simp)
  have hTensor : Algebra.SmoothAt R' (R' ⊗[R] A)
      (Ideal.map eA.toRingHom p) :=
    ⟨tA, hnot, hsmoothAway⟩
  have hA' := (smoothAt_algEquiv eA p).mpr hTensor
  simpa [mkA] using hA'

/-- The image in `A/IA` of the singular ideal of `A` over `R` is contained in the singular ideal
of `A/IA` over `R/I`. -/
private lemma singularIdeal_map_quotient_le
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (I : Ideal R) :
    Ideal.map (Ideal.Quotient.mk (I.map (algebraMap R A)))
        (singularIdeal R A) ≤
      singularIdeal (R ⧸ I)
        (A ⧸ I.map (algebraMap R A)) := by
  let R' := R ⧸ I
  let IA := I.map (algebraMap R A)
  let A' := A ⧸ IA
  let mkA : A →+* A' := Ideal.Quotient.mk IA
  let : Algebra R' A' := Ideal.Quotient.algebraQuotientMapQuotient
  apply Ideal.map_le_iff_le_comap.mpr
  intro a ha
  show a ∈ (singularIdeal R' A' : Ideal A').comap mkA
  rw [Ideal.mem_comap, singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
  intro p hp
  let pA : Ideal A := p.comap mkA
  have : pA.IsPrime := Ideal.IsPrime.comap mkA
  have hns : ¬ Algebra.SmoothAt R A pA := by
    intro hs
    exact hp (smoothAt_quotient_of_smoothAt (R := R) (A := A) I p.asIdeal hs)
  have hmem := (PrimeSpectrum.mem_vanishingIdeal _ _).mp ha ⟨pA, inferInstance⟩ hns
  simpa [pA, Ideal.mem_comap] using hmem

/-- Finite presentation transports along a ring isomorphism of the base ring. -/
private lemma finitePresentation_transport_base_equiv
    {R S A : Type*} [CommRing R] [CommRing S] [CommRing A]
    [Algebra R A] [Algebra.FinitePresentation R A]
    (e : R ≃+* S) :
    letI : Algebra S A :=
      RingHom.toAlgebra ((algebraMap R A).comp e.symm.toRingHom)
    Algebra.FinitePresentation S A := by
  let : Algebra S A :=
    RingHom.toAlgebra ((algebraMap R A).comp e.symm.toRingHom)
  rw [← RingHom.finitePresentation_algebraMap]
  exact (RingHom.finitePresentation_algebraMap.mpr ‹Algebra.FinitePresentation R A›).comp
    (RingHom.FinitePresentation.of_bijective e.symm.bijective)

/-- An `R`-algebra isomorphism carries the singular ideal of its source onto the singular ideal
of its target. -/
private lemma singularIdeal_algEquiv
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (e : A ≃ₐ[R] B) :
    Ideal.map e.toRingHom (singularIdeal R A) =
      singularIdeal R B := by
  apply Ideal.ext
  intro b
  rw [Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective]
  constructor
  · rintro ⟨a, ha, rfl⟩
    rw [singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
    intro q hq
    let p : Ideal A := Ideal.comap e.toRingHom q.asIdeal
    have : p.IsPrime := Ideal.IsPrime.comap e.toRingHom
    have hpeq : Ideal.map e.toRingHom p = q.asIdeal := by
      dsimp [p]
      exact Ideal.map_comap_of_surjective _ e.surjective _
    have hns : ¬ Algebra.SmoothAt R A p := by
      intro hs
      rcases (smoothAt_algEquiv e p).mp hs with ⟨g, hg, hgsmooth⟩
      apply hq
      refine ⟨g, ?_, hgsmooth⟩
      intro hgq
      apply hg
      have hgq' := hgq
      rw [← hpeq] at hgq'
      exact hgq'
    have hmem := (PrimeSpectrum.mem_vanishingIdeal _ _).mp ha ⟨p, inferInstance⟩ hns
    simpa [p, Ideal.mem_comap] using hmem
  · intro hb
    refine ⟨e.symm b, ?_, ?_⟩
    · rw [singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
      intro p hp
      let q : Ideal B := Ideal.map e.toRingHom p.asIdeal
      have : q.IsPrime := Ideal.map_isPrime_of_surjective e.surjective (by simp)
      have hns : ¬ Algebra.SmoothAt R B q := by
        intro hs
        have hs' : Algebra.SmoothAt R B (Ideal.map e.toRingHom p.asIdeal) := by
          simpa [q] using hs
        exact hp ((smoothAt_algEquiv e p.asIdeal).mpr hs')
      have hmem := (PrimeSpectrum.mem_vanishingIdeal _ _).mp hb ⟨q, inferInstance⟩ hns
      have hmem' : b ∈ Ideal.map e.toRingHom p.asIdeal := by
        simpa [q] using hmem
      obtain ⟨x, hx, hxeq⟩ :=
        (Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective).1 hmem'
      have hxsym : x = e.symm b := by
        apply e.injective
        simpa using hxeq
      exact hxsym ▸ hx
    · simp

/-- Smoothness at a prime is unchanged when the base ring is replaced by an isomorphic one
along the isomorphism. -/
private lemma smoothAt_base_ring_equiv
    {R S A : Type*} [CommRing R] [CommRing S] [CommRing A] [Algebra S A]
    (e : R ≃+* S) (q : Ideal A) [q.IsPrime] :
    letI : Algebra R A := RingHom.toAlgebra ((algebraMap S A).comp e.toRingHom)
    Algebra.SmoothAt R A q ↔ Algebra.SmoothAt S A q := by
  let : Algebra R A := RingHom.toAlgebra ((algebraMap S A).comp e.toRingHom)
  have hsm (a : A) : Algebra.Smooth R (Localization.Away a) ↔
      Algebra.Smooth S (Localization.Away a) := by
    let fR : R →+* Localization.Away a := algebraMap R (Localization.Away a)
    let fS : S →+* Localization.Away a := algebraMap S (Localization.Away a)
    have hcomp : fR = fS.comp e.toRingHom := by
      ext x
      rfl
    calc
      _ ↔ fR.Smooth := (RingHom.smooth_algebraMap).symm
      _ ↔ fS.Smooth := hcomp ▸ smooth_comp_ringEquiv_iff e fS
      _ ↔ _ := RingHom.smooth_algebraMap
  constructor <;> rintro ⟨a, ha, hs⟩
  · exact ⟨a, ha, (hsm a).mp hs⟩
  · exact ⟨a, ha, (hsm a).mpr hs⟩

/-- The singular ideal is unchanged when the base ring is replaced by an isomorphic one along
the isomorphism. -/
private lemma singularIdeal_base_ring_equiv
    {R S A : Type*} [CommRing R] [CommRing S] [CommRing A] [Algebra S A]
    (e : R ≃+* S) :
    letI : Algebra R A := RingHom.toAlgebra ((algebraMap S A).comp e.toRingHom)
    singularIdeal R A = singularIdeal S A := by
  let : Algebra R A := RingHom.toAlgebra ((algebraMap S A).comp e.toRingHom)
  unfold singularIdeal
  congr 1
  ext p
  simp only [Set.mem_ofPred_eq]
  exact not_congr (smoothAt_base_ring_equiv e p.asIdeal)

/-- Resolvability transports along a triple of ring isomorphisms compatible with the displayed
algebra maps and carrying the chosen ideal to the chosen ideal. -/
private lemma isResolvableAt_transport
    {R : Type u₁} {A : Type v₁} {Λ : Type w₁}
    {R' : Type u₁} {A' : Type v₁} {Λ' : Type w₁}
    [CommRing R] [CommRing A] [CommRing Λ]
    [Algebra R A] [Algebra R Λ] [Algebra A Λ] [IsScalarTower R A Λ]
    [CommRing R'] [CommRing A'] [CommRing Λ']
    [Algebra R' A'] [Algebra R' Λ']
    [Algebra A' Λ'] [IsScalarTower R' A' Λ']
    (eR : R ≃+* R') (eA : A ≃+* A') (eΛ : Λ ≃+* Λ')
    (hRA : ∀ r, eA (algebraMap R A r) = algebraMap R' A' (eR r))
    (hAΛ : ∀ a, eΛ (algebraMap A Λ a) = algebraMap A' Λ' (eA a))
    (q : Ideal Λ) (q' : Ideal Λ')
    (hq : Ideal.map eΛ.toRingHom q = q') :
    CanBeResolved R A Λ q →
      CanBeResolved R' A' Λ' q' := by
  intro h
  rcases h with ⟨B, hBcomm, hRB, hAB, hBΛ, hRAB, hABΛ, hRBΛ, hBfp, hSing, hNot⟩
  let : CommRing B := hBcomm
  let : Algebra R B := hRB
  let : Algebra A B := hAB
  let : Algebra B Λ := hBΛ
  let : Algebra.FinitePresentation R B := hBfp
  let : Algebra R' A :=
    RingHom.toAlgebra ((algebraMap R A).comp eR.symm.toRingHom)
  let : Algebra R' B :=
    RingHom.toAlgebra ((algebraMap R B).comp eR.symm.toRingHom)
  let : Algebra A' B :=
    RingHom.toAlgebra ((algebraMap A B).comp eA.symm.toRingHom)
  let : Algebra B Λ' :=
    RingHom.toAlgebra (eΛ.toRingHom.comp (algebraMap B Λ))
  let : IsScalarTower R A B := hRAB
  let : IsScalarTower A B Λ := hABΛ
  let : IsScalarTower R B Λ := hRBΛ
  let : IsScalarTower R' A' B := IsScalarTower.of_algebraMap_eq' (by
    ext r
    show (algebraMap R B) (eR.symm r) =
      (algebraMap A B) (eA.symm (algebraMap R' A' r))
    have hr : eA (algebraMap R A (eR.symm r)) = algebraMap R' A' r := by
      simpa using hRA (eR.symm r)
    rw [← hr, eA.symm_apply_apply,
      IsScalarTower.algebraMap_apply R A B (eR.symm r)])
  let : IsScalarTower A' B Λ' := IsScalarTower.of_algebraMap_eq' (by
    ext a
    show algebraMap A' Λ' a =
      eΛ ((algebraMap B Λ) ((algebraMap A B) (eA.symm a)))
    calc
      algebraMap A' Λ' a = eΛ (algebraMap A Λ (eA.symm a)) := by
        simpa using (hAΛ (eA.symm a)).symm
      _ = eΛ ((algebraMap B Λ) ((algebraMap A B) (eA.symm a))) := by
        rw [← IsScalarTower.algebraMap_apply A B Λ (eA.symm a)])
  let : IsScalarTower R' B Λ' := IsScalarTower.of_algebraMap_eq' (by
    ext r
    show algebraMap R' Λ' r =
      eΛ ((algebraMap B Λ) ((algebraMap R B) (eR.symm r)))
    calc
      algebraMap R' Λ' r = eΛ (algebraMap R Λ (eR.symm r)) := by
        rw [IsScalarTower.algebraMap_apply R A Λ,
          IsScalarTower.algebraMap_apply R' A' Λ', hAΛ, hRA]
        simp
      _ = eΛ ((algebraMap B Λ) ((algebraMap R B) (eR.symm r))) := by
        rw [← IsScalarTower.algebraMap_apply R B Λ (eR.symm r)])
  have hbaseA : singularIdeal R' A = singularIdeal R A :=
    singularIdeal_base_ring_equiv eR.symm
  have hbaseB : singularIdeal R' B = singularIdeal R B :=
    singularIdeal_base_ring_equiv eR.symm
  let eAA : A ≃ₐ[R'] A' := AlgEquiv.ofRingEquiv (f := eA) (by
    intro r
    show eA (algebraMap R A (eR.symm r)) = algebraMap R' A' r
    simpa using hRA (eR.symm r))
  have hsingA : Ideal.map eA.toRingHom (singularIdeal R A) =
      singularIdeal R' A' := by
    calc
      _ = Ideal.map eA.toRingHom (singularIdeal R' A) := by rw [← hbaseA]
      _ = singularIdeal R' A' := singularIdeal_algEquiv eAA
  have hAcomp : eΛ.toRingHom.comp (algebraMap A Λ) =
      (algebraMap A' Λ').comp eA.toRingHom := by
    ext a
    exact hAΛ a
  have hmapA : Ideal.map eΛ.toRingHom
      (Ideal.map (algebraMap A Λ) (singularIdeal R A)) =
      Ideal.map (algebraMap A' Λ')
        (singularIdeal R' A') := by
    calc
      _ = Ideal.map (eΛ.toRingHom.comp (algebraMap A Λ))
          (singularIdeal R A) := by rw [Ideal.map_map]
      _ = Ideal.map ((algebraMap A' Λ').comp eA.toRingHom)
          (singularIdeal R A) := by rw [hAcomp]
      _ = Ideal.map (algebraMap A' Λ')
          (Ideal.map eA.toRingHom (singularIdeal R A)) := by rw [Ideal.map_map]
      _ = _ := by rw [hsingA]
  have hmapB : Ideal.map eΛ.toRingHom
      (Ideal.map (algebraMap B Λ) (singularIdeal R B)) =
      Ideal.map (algebraMap B Λ') (singularIdeal R' B) := by
    calc
      _ = Ideal.map (eΛ.toRingHom.comp (algebraMap B Λ))
          (singularIdeal R B) := by rw [Ideal.map_map]
      _ = Ideal.map (algebraMap B Λ') (singularIdeal R B) := by rfl
      _ = _ := by rw [← hbaseB]
  have hrad (J : Ideal Λ) :
      Ideal.map eΛ.toRingHom J.radical = (Ideal.map eΛ.toRingHom J).radical :=
    Ideal.map_radical_of_surjective eΛ.surjective (by simp)
  have hSing' : (Ideal.map (algebraMap A' Λ')
      (singularIdeal R' A')).radical ≤
      (Ideal.map (algebraMap B Λ')
        (singularIdeal R' B)).radical := by
    have h := Ideal.map_mono (f := eΛ.toRingHom) hSing
    rwa [hrad, hrad, hmapA, hmapB] at h
  have hNot' : ¬ (Ideal.map (algebraMap B Λ')
      (singularIdeal R' B)).radical ≤ q' := by
    intro hle
    refine hNot ?_
    have hm : Ideal.map eΛ.toRingHom
        (Ideal.map (algebraMap B Λ) (singularIdeal R B)).radical ≤
        Ideal.map eΛ.toRingHom q := by
      rw [hrad, hmapB, hq]
      exact hle
    have hm := Ideal.comap_mono (f := eΛ.toRingHom) hm
    rwa [Ideal.comap_map_of_bijective eΛ.toRingHom eΛ.bijective,
      Ideal.comap_map_of_bijective eΛ.toRingHom eΛ.bijective] at hm
  have hFP' : Algebra.FinitePresentation R' B :=
    finitePresentation_transport_base_equiv eR
  exact ⟨B, hBcomm, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, hFP', hSing', hNot'⟩

/-- Being strictly standard transports along an `R`-algebra isomorphism. -/
private lemma strictlyStandard_transport_equiv
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] (e : A ≃ₐ[R] B) (a : A)
    (ha : IsStrictlyStandard (R := R) a) :
    IsStrictlyStandard (R := R) (e a) := by
  obtain ⟨P, c, hcn, hcm, ⟨aI, haI⟩, hcond⟩ := ha
  let P' : Presentation R B := { P with iso := e.symm.trans P.iso }
  refine ⟨P', c, hcn, hcm, ⟨fun s => e (aI s), ?_⟩, ?_⟩
  · rw [haI, map_sum]
    refine Finset.sum_congr rfl (fun s hs => ?_)
    rw [map_mul]
    rfl
  · intro j x hx
    have hx' : P.IsLift a x := by
      apply e.injective
      simpa [P', Presentation.IsLift, Presentation.lift] using hx
    simpa [P', Presentation.StandardCond2, Presentation.firstRelIdeal,
      Presentation.relIdeal] using hcond j x hx'

/-- Resolvability of the chain obtained from a local smoothing situation by dividing out an
ideal of the base ring. -/
private abbrev quotientResolvable
    (S : LocalSmoothingSituation.{u, v, w}) (I : Ideal S.R) : Prop :=
  let IA := Ideal.map (algebraMap S.R S.A) I
  let IL := Ideal.map (algebraMap S.A S.Λ) IA
  letI : Algebra (S.R ⧸ I) (S.Λ ⧸ IL) :=
    ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)).comp
      (algebraMap (S.R ⧸ I) (S.A ⧸ IA))).toAlgebra
  letI : IsScalarTower (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IL) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  CanBeResolved
    (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IL)
    (Ideal.map (Ideal.Quotient.mk IL) S.q)

/-- The local smoothing situation obtained by dividing a given one by an ideal of the base ring
contained in the contraction of the chosen prime. -/
private noncomputable abbrev quotientSmoothingSituation
    (S : LocalSmoothingSituation.{u, v, w}) (I : Ideal S.R)
    (hI : I ≤ S.q.comap (algebraMap S.R S.Λ)) :
    LocalSmoothingSituation.{u, v, w} := by
  let IA := I.map (algebraMap S.R S.A)
  let IL := IA.map (algebraMap S.A S.Λ)
  letI : Algebra (S.R ⧸ I) (S.Λ ⧸ IL) :=
    ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)).comp
      (algebraMap (S.R ⧸ I) (S.A ⧸ IA))).toAlgebra
  letI : IsScalarTower (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IL) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hILq : IL ≤ S.q := by
    dsimp [IL, IA]
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
    exact Ideal.map_le_iff_le_comap.mpr hI
  letI : (Ideal.map (Ideal.Quotient.mk IL) S.q).IsPrime :=
    Ideal.isPrime_map_quotientMk_of_isPrime hILq
  let eA := Algebra.TensorProduct.quotIdealMapEquivQuotTensor S.A I
  letI : Algebra.FinitePresentation (S.R ⧸ I) (S.A ⧸ IA) :=
    Algebra.FinitePresentation.equiv eA.symm
  exact
    { R := S.R ⧸ I
      A := S.A ⧸ IA
      Λ := S.Λ ⧸ IL
      q := Ideal.map (Ideal.Quotient.mk IL) S.q }

/-- The image of a strictly standard element of `A` over `R` is strictly standard in `A/IA`
over `R/I`. -/
private lemma strictlyStandard_quotient
    {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (I : Ideal R) (a : A)
    (ha : IsStrictlyStandard (R := R) (A := A) a) :
    IsStrictlyStandard (R := R ⧸ I)
      (A := A ⧸ I.map (algebraMap R A))
      (Ideal.Quotient.mk (I.map (algebraMap R A)) a) := by
  let e := Algebra.TensorProduct.quotIdealMapEquivQuotTensor A I
  have hbridge : e
      (Ideal.Quotient.mk (I.map (algebraMap R A)) a) =
      Algebra.TensorProduct.includeRight a := by
    rw [Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk]
    rfl
  have he : IsStrictlyStandard (R := R ⧸ I)
      (e (Ideal.Quotient.mk (I.map (algebraMap R A)) a)) := by
    rw [hbridge]
    exact isStrictlyStandard_basechange (R := R) (A := A)
      (R' := R ⧸ I) a ha
  simpa using strictlyStandard_transport_equiv e.symm _ he

/-- The iterated quotient `(R/I)/J(R/I)` is canonically `R/(I ⊔ J)`. -/
private noncomputable def quotientQuotientEquivSup
    {R : Type*} [CommRing R] (I J : Ideal R) :
    (R ⧸ I) ⧸ J.map (Ideal.Quotient.mk I) ≃+* R ⧸ (I ⊔ J) := by
  let f : (R ⧸ I) →+* R ⧸ (I ⊔ J) :=
    Ideal.quotientMap (I := I) (I ⊔ J) (RingHom.id R) le_sup_left
  have hf : Function.Surjective f :=
    Ideal.quotientMap_surjective (by intro x; exact ⟨x, rfl⟩)
  have hker : RingHom.ker f = J.map (Ideal.Quotient.mk I) := by
    have hI : ∀ x ∈ I, Ideal.Quotient.mk (I ⊔ J) x = 0 := by
      intro x hx
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Submodule.mem_sup_left hx)
    have hI' : I ≤ RingHom.ker (Ideal.Quotient.mk (I ⊔ J)) := hI
    change RingHom.ker
        (Ideal.Quotient.lift I (Ideal.Quotient.mk (I ⊔ J)) hI) = _
    have hk := Ideal.ker_quotient_lift (I := I)
      (f := Ideal.Quotient.mk (I ⊔ J)) hI'
    simpa [Ideal.mk_ker, Ideal.map_sup, Ideal.map_quotient_self] using hk
  exact (Ideal.quotientEquiv (J.map (Ideal.Quotient.mk I)) (RingHom.ker f)
      (RingEquiv.refl _) (by simpa using hker)).trans
    (RingHom.quotientKerEquivOfSurjective hf)

/-- The isomorphism `(R/I)/J(R/I) ≃ R/(I ⊔ J)` sends the class of the class of an element to
the class of that element. -/
private lemma quotientQuotientEquivSup_mk
    {R : Type*} [CommRing R] (I J : Ideal R) (x : R) :
    quotientQuotientEquivSup I J
      (Ideal.Quotient.mk (J.map (Ideal.Quotient.mk I)) (Ideal.Quotient.mk I x)) =
        Ideal.Quotient.mk (I ⊔ J) x := by
  simp only [quotientQuotientEquivSup, RingEquiv.trans_apply,
    Ideal.quotientEquiv_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]
  simp [Ideal.quotientMap]

/-- The isomorphism `(R/I)/L ≃ R/K` attached to presentations `L = J(R/I)` and `K = I ⊔ J`. -/
private noncomputable def quotientQuotientEquivOfEq
    {R : Type*} [CommRing R] (I J K : Ideal R)
    (L : Ideal (R ⧸ I)) (hL : J.map (Ideal.Quotient.mk I) = L)
    (hK : I ⊔ J = K) : (R ⧸ I) ⧸ L ≃+* R ⧸ K :=
  (Ideal.quotientEquiv L (J.map (Ideal.Quotient.mk I)) (RingEquiv.refl _)
    (by simpa using hL)).trans
    ((quotientQuotientEquivSup I J).trans
      (Ideal.quotientEquiv (I ⊔ J) K (RingEquiv.refl _)
        (by simpa using hK.symm)))

/-- The isomorphism `(R/I)/L ≃ R/K` sends the class of the class of an element to the class of
that element. -/
private lemma quotientQuotientEquivOfEq_mk
    {R : Type*} [CommRing R] (I J K : Ideal R)
    (L : Ideal (R ⧸ I)) (hL : J.map (Ideal.Quotient.mk I) = L)
    (hK : I ⊔ J = K) (x : R) :
    quotientQuotientEquivOfEq I J K L hL hK
      (Ideal.Quotient.mk L (Ideal.Quotient.mk I x)) = Ideal.Quotient.mk K x := by
  simp [quotientQuotientEquivOfEq,
    quotientQuotientEquivSup_mk]

/-- Resolvability of the chain modulo `I ⊔ J` is resolvability, modulo the image of `J`, of the
chain already divided by `I`. -/
private lemma quotientResolvable_quotient
    (S : LocalSmoothingSituation.{u, v, w}) (I J : Ideal S.R)
    (hI : I ≤ S.q.comap (algebraMap S.R S.Λ))
    (h : quotientResolvable S (I ⊔ J)) :
    quotientResolvable (quotientSmoothingSituation S I hI)
      (J.map (Ideal.Quotient.mk I)) := by
  let T := quotientSmoothingSituation S I hI
  let IA := I.map (algebraMap S.R S.A)
  let IL := IA.map (algebraMap S.A S.Λ)
  let JA := J.map (algebraMap S.R S.A)
  let JL := JA.map (algebraMap S.A S.Λ)
  let K := I ⊔ J
  let KA := K.map (algebraMap S.R S.A)
  let KL := KA.map (algebraMap S.A S.Λ)
  let J' : Ideal T.R := J.map (Ideal.Quotient.mk I)
  let JA' := J'.map (algebraMap T.R T.A)
  let JL' := JA'.map (algebraMap T.A T.Λ)
  let : Algebra (S.R ⧸ K) (S.Λ ⧸ KL) :=
    ((algebraMap (S.A ⧸ KA) (S.Λ ⧸ KL)).comp
      (algebraMap (S.R ⧸ K) (S.A ⧸ KA))).toAlgebra
  let : IsScalarTower (S.R ⧸ K) (S.A ⧸ KA) (S.Λ ⧸ KL) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let : Algebra (T.R ⧸ J') (T.Λ ⧸ JL') :=
    ((algebraMap (T.A ⧸ JA') (T.Λ ⧸ JL')).comp
      (algebraMap (T.R ⧸ J') (T.A ⧸ JA'))).toAlgebra
  let : IsScalarTower (T.R ⧸ J') (T.A ⧸ JA') (T.Λ ⧸ JL') :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hJA' : JA.map (Ideal.Quotient.mk IA) = JA' := by
    show Ideal.map (Ideal.Quotient.mk IA) (Ideal.map (algebraMap S.R S.A) J) =
      Ideal.map (algebraMap T.R T.A) (Ideal.map (Ideal.Quotient.mk I) J)
    rw [Ideal.map_map, Ideal.map_map]
    congr 1
  have hJL' : JL.map (Ideal.Quotient.mk IL) = JL' := by
    show Ideal.map (Ideal.Quotient.mk IL)
        (Ideal.map (algebraMap S.A S.Λ) (Ideal.map (algebraMap S.R S.A) J)) =
      Ideal.map (algebraMap T.A T.Λ)
        (Ideal.map (algebraMap T.R T.A) (Ideal.map (Ideal.Quotient.mk I) J))
    simp only [Ideal.map_map]
    congr 1
  have hKA : IA ⊔ JA = KA := (Ideal.map_sup _ _ _).symm
  have hKL : IL ⊔ JL = KL := by
    dsimp [IL, JL, KL, KA, K, IA, JA]
    simp only [Ideal.map_sup]
  let eR : (T.R ⧸ J') ≃+* S.R ⧸ K := quotientQuotientEquivSup I J
  let eA : (T.A ⧸ JA') ≃+* S.A ⧸ KA :=
    quotientQuotientEquivOfEq IA JA KA JA' hJA' hKA
  let eL : (T.Λ ⧸ JL') ≃+* S.Λ ⧸ KL :=
    quotientQuotientEquivOfEq IL JL KL JL' hJL' hKL
  have heR (x : S.R) : eR (Ideal.Quotient.mk J' (Ideal.Quotient.mk I x)) =
      Ideal.Quotient.mk K x := quotientQuotientEquivSup_mk I J x
  have heA (x : S.A) : eA (Ideal.Quotient.mk JA' (Ideal.Quotient.mk IA x)) =
      Ideal.Quotient.mk KA x := quotientQuotientEquivOfEq_mk IA JA KA JA' hJA' hKA x
  have heL (x : S.Λ) : eL (Ideal.Quotient.mk JL' (Ideal.Quotient.mk IL x)) =
      Ideal.Quotient.mk KL x := quotientQuotientEquivOfEq_mk IL JL KL JL' hJL' hKL x
  have hRA : ∀ x, eA (algebraMap (T.R ⧸ J') (T.A ⧸ JA') x) =
      algebraMap (S.R ⧸ K) (S.A ⧸ KA) (eR x) := by
    intro x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    show eA (Ideal.Quotient.mk JA' (Ideal.Quotient.mk IA (algebraMap S.R S.A x))) = _
    rw [heA, heR]
    rfl
  have hAL : ∀ x, eL (algebraMap (T.A ⧸ JA') (T.Λ ⧸ JL') x) =
      algebraMap (S.A ⧸ KA) (S.Λ ⧸ KL) (eA x) := by
    intro x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    show eL (Ideal.Quotient.mk JL' (Ideal.Quotient.mk IL (algebraMap S.A S.Λ x))) = _
    rw [heL, heA]
    rfl
  have hq : Ideal.map eL.symm.toRingHom (Ideal.map (Ideal.Quotient.mk KL) S.q) =
      Ideal.map (Ideal.Quotient.mk JL') T.q := by
    show Ideal.map eL.symm.toRingHom (Ideal.map (Ideal.Quotient.mk KL) S.q) =
      Ideal.map (Ideal.Quotient.mk JL') (Ideal.map (Ideal.Quotient.mk IL) S.q)
    simp only [Ideal.map_map]
    congr 1
    ext x
    exact eL.symm_apply_eq.mpr (heL x).symm
  exact isResolvableAt_transport eR.symm eA.symm eL.symm
    (fun x => eA.injective (by simpa using (hRA (eR.symm x)).symm))
    (fun x => eL.injective (by simpa using (hAL (eA.symm x)).symm))
    _ _ hq h

/-- The condition that the map `R_π → B_π` induced by an `R`-algebra `B` on the localizations
away from `π` and from its image is smooth. -/
private def smoothAwayCondition
    {R B : Type*} [CommRing R] [CommRing B] [Algebra R B] (π : R) : Prop :=
  letI : Algebra (Localization.Away π)
      (Localization.Away (algebraMap R B π)) :=
    (Localization.awayMap (algebraMap R B) π).toAlgebra
  Algebra.Smooth (Localization.Away π) (Localization.Away (algebraMap R B π))

/-- If the induced map `R_π → B_π` is smooth, then the image of `π` lies in the singular ideal
of `B` over `R`. -/
private lemma mem_singularIdeal_of_smoothAway
    {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]
    (π : R) (hsm : smoothAwayCondition (R := R) (B := B) π) :
    algebraMap R B π ∈ singularIdeal R B := by
  let : Algebra (Localization.Away π)
      (Localization.Away (algebraMap R B π)) :=
    (Localization.awayMap (algebraMap R B) π).toAlgebra
  change Algebra.Smooth (Localization.Away π)
    (Localization.Away (algebraMap R B π)) at hsm
  have hsmR : Algebra.Smooth R (Localization.Away (algebraMap R B π)) := by
    let : Algebra.Smooth R (Localization.Away π) := Algebra.Smooth.localization_away π
    let : Algebra.Smooth (Localization.Away π)
        (Localization.Away (algebraMap R B π)) := hsm
    let : IsScalarTower R (Localization.Away π)
        (Localization.Away (algebraMap R B π)) := IsScalarTower.of_algebraMap_eq' (by
          let f : R →ₐ[R] B :=
            { toRingHom := algebraMap R B
              commutes' := fun r => by simp }
          let awayF := Localization.awayMapₐ f π
          ext r
          exact (awayF.commutes r).symm)
    exact Algebra.Smooth.comp R (Localization.Away π)
      (Localization.Away (algebraMap R B π))
  rw [singularIdeal, PrimeSpectrum.mem_vanishingIdeal]
  intro p hp
  by_cases hπ : algebraMap R B π ∈ p.asIdeal
  · exact hπ
  · exact (hp ⟨algebraMap R B π, hπ, hsmR⟩).elim

/-- The case `r = 1` of Stacks 07F8: a resolution of the chain modulo `π⁸` lifts to a
resolution of the chain itself. -/
private lemma resolve_of_quotient_single_eighthPower
    (S : LocalSmoothingSituation.{u, v, w}) (π : S.R)
    (hπq : algebraMap S.R S.Λ π ∈ S.q)
    (hR : ∀ x : S.R, x * π = 0 ↔ x * π ^ 2 = 0)
    (hΛ : ∀ x : S.Λ,
      x * algebraMap S.R S.Λ π = 0 ↔
        x * (algebraMap S.R S.Λ π) ^ 2 = 0)
    (hstandard : IsStrictlyStandard (R := S.R) (A := S.A)
      (algebraMap S.R S.A π))
    (hresolve :
      let IR : Ideal S.R := Ideal.span {π ^ 8}
      let IA : Ideal S.A := Ideal.map (algebraMap S.R S.A) IR
      let IL : Ideal S.Λ := Ideal.map (algebraMap S.A S.Λ) IA
      letI : Algebra (S.R ⧸ IR) (S.A ⧸ IA) :=
        Ideal.Quotient.algebraQuotientMapQuotient
      letI : Algebra (S.A ⧸ IA) (S.Λ ⧸ IL) :=
        Ideal.Quotient.algebraQuotientMapQuotient
      letI : Algebra (S.R ⧸ IR) (S.Λ ⧸ IL) :=
        ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)).comp
          (algebraMap (S.R ⧸ IR) (S.A ⧸ IA))).toAlgebra
      letI : IsScalarTower (S.R ⧸ IR) (S.A ⧸ IA) (S.Λ ⧸ IL) :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      CanBeResolved
        (S.R ⧸ IR) (S.A ⧸ IA) (S.Λ ⧸ IL)
        (Ideal.map (Ideal.Quotient.mk IL) S.q)) :
    CanBeResolved S.R S.A S.Λ S.q := by
  let IR : Ideal S.R := Ideal.span {π ^ 8}
  let IA : Ideal S.A := Ideal.map (algebraMap S.R S.A) IR
  let IL : Ideal S.Λ := Ideal.map (algebraMap S.A S.Λ) IA
  let mkR : S.R →+* S.R ⧸ IR := Ideal.Quotient.mk IR
  let mkA : S.A →+* S.A ⧸ IA := Ideal.Quotient.mk IA
  let : Algebra (S.R ⧸ IR) (S.A ⧸ IA) :=
    Ideal.Quotient.algebraQuotientMapQuotient
  let : Algebra (S.A ⧸ IA) (S.Λ ⧸ IL) :=
    Ideal.Quotient.algebraQuotientMapQuotient
  let : Algebra (S.R ⧸ IR) (S.Λ ⧸ IL) :=
    ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)).comp
      (algebraMap (S.R ⧸ IR) (S.A ⧸ IA))).toAlgebra
  have hIAspan : IA = Ideal.span {(algebraMap S.R S.A π) ^ 8} := by
    show Ideal.map (algebraMap S.R S.A) (Ideal.span {π ^ 8}) = _
    rw [Ideal.map_span]
    simp [map_pow]
  have hILspan : IL = Ideal.span {(algebraMap S.R S.Λ π) ^ 8} := by
    show Ideal.map (algebraMap S.A S.Λ)
        (Ideal.map (algebraMap S.R S.A) (Ideal.span {π ^ 8})) = _
    rw [Ideal.map_map, IsScalarTower.algebraMap_eq S.R S.A S.Λ]
    rw [Ideal.map_span]
    simp [map_pow]
  dsimp only at hresolve
  let IA' : Ideal S.A := Ideal.span {(algebraMap S.R S.A π) ^ 8}
  let IL' : Ideal S.Λ := Ideal.span {(algebraMap S.R S.Λ π) ^ 8}
  let eR : (S.R ⧸ IR) ≃+* (S.R ⧸ IR) := RingEquiv.refl _
  let eA : (S.A ⧸ IA) ≃+* (S.A ⧸ IA') :=
    Ideal.quotientEquiv IA IA' (RingEquiv.refl _) (by simpa using hIAspan.symm)
  let eL : (S.Λ ⧸ IL) ≃+* (S.Λ ⧸ IL') :=
    Ideal.quotientEquiv IL IL' (RingEquiv.refl _) (by simpa using hILspan.symm)
  let : IsScalarTower (S.R ⧸ IR) (S.A ⧸ IA) (S.Λ ⧸ IL) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let : Algebra (S.R ⧸ IR) (S.A ⧸ IA') :=
    (eA.toRingHom.comp (algebraMap (S.R ⧸ IR) (S.A ⧸ IA))).toAlgebra
  let : Algebra (S.A ⧸ IA') (S.Λ ⧸ IL') :=
    (eL.toRingHom.comp ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)).comp
      eA.symm.toRingHom)).toAlgebra
  let : Algebra (S.R ⧸ IR) (S.Λ ⧸ IL') :=
    ((algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL')).comp
      (algebraMap (S.R ⧸ IR) (S.A ⧸ IA'))).toAlgebra
  let : IsScalarTower (S.R ⧸ IR) (S.A ⧸ IA') (S.Λ ⧸ IL') :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hbaseA : ∀ x : S.R,
      algebraMap (S.R ⧸ IR) (S.A ⧸ IA') (mkR x) =
        Ideal.Quotient.mk IA' (algebraMap S.R S.A x) := by
    intro x
    show eA.toRingHom
      (algebraMap (S.R ⧸ IR) (S.A ⧸ IA) (mkR x)) = _
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
    show eA (Ideal.Quotient.mk IA (algebraMap S.R S.A x)) = _
    exact Ideal.quotientEquiv_mk IA IA' (RingEquiv.refl S.A)
      (by simpa using hIAspan.symm) (algebraMap S.R S.A x)
  have hbaseAL : ∀ a : S.A,
      algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL') (Ideal.Quotient.mk IA' a) =
        Ideal.Quotient.mk IL' (algebraMap S.A S.Λ a) := by
    intro a
    show eL.toRingHom
      (algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)
        (eA.symm.toRingHom (Ideal.Quotient.mk IA' a))) = _
    show eL (algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)
      (eA.symm (Ideal.Quotient.mk IA' a))) = _
    have hA : eA.symm (Ideal.Quotient.mk IA' a) = Ideal.Quotient.mk IA a := by
      simp [eA]
    rw [hA]
    show eL (Ideal.Quotient.mk IL (algebraMap S.A S.Λ a)) = _
    exact Ideal.quotientEquiv_mk IL IL' (RingEquiv.refl S.Λ)
      (by simpa using hILspan.symm) (algebraMap S.A S.Λ a)
  have hRA : ∀ r, eA (algebraMap (S.R ⧸ IR) (S.A ⧸ IA) r) =
      algebraMap (S.R ⧸ IR) (S.A ⧸ IA') (eR r) := by
    intro r
    show eA.toRingHom (algebraMap (S.R ⧸ IR) (S.A ⧸ IA) r) =
      (eA.toRingHom.comp (algebraMap (S.R ⧸ IR) (S.A ⧸ IA))) (eR r)
    simp [eR]
  have hAΛ : ∀ a, eL (algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL) a) =
      algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL') (eA a) := by
    intro a
    show eL.toRingHom ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)) a) =
      (eL.toRingHom.comp ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IL)).comp
        eA.symm.toRingHom) (eA.toRingHom a))
    simp
  have hmk : eL.toRingHom.comp (Ideal.Quotient.mk IL) =
      Ideal.Quotient.mk IL' := by
    ext x
    simp [eL]
  have hq : Ideal.map eL.toRingHom (Ideal.map (Ideal.Quotient.mk IL) S.q) =
      Ideal.map (Ideal.Quotient.mk IL') S.q := by
    rw [Ideal.map_map, hmk]
  have hresolve' := isResolvableAt_transport eR eA eL hRA hAΛ
    (Ideal.map (Ideal.Quotient.mk IL) S.q)
    (Ideal.map (Ideal.Quotient.mk IL') S.q) hq hresolve
  rcases hresolve' with ⟨B, hBcomm, hRB, hAB, hBΛ, hRAB, hABΛ,
    hRBΛ, hBfp, hSing, hNot⟩
  let mkL' : S.Λ →+* S.Λ ⧸ IL' := Ideal.Quotient.mk IL'
  let : CommRing B := hBcomm
  let : Algebra (S.R ⧸ IR) B := hRB
  let : Algebra (S.A ⧸ IA') B := hAB
  let : Algebra B (S.Λ ⧸ IL') := hBΛ
  let : IsScalarTower (S.R ⧸ IR) (S.A ⧸ IA') B := hRAB
  let : IsScalarTower (S.A ⧸ IA') B (S.Λ ⧸ IL') := hABΛ
  let : IsScalarTower (S.R ⧸ IR) B (S.Λ ⧸ IL') := hRBΛ
  let f : S.A →ₐ[S.R] S.Λ :=
    { toRingHom := algebraMap S.A S.Λ
      commutes' := fun x => (IsScalarTower.algebraMap_apply S.R S.A S.Λ x).symm }
  let bar : (S.A ⧸ IA') →+* B := algebraMap (S.A ⧸ IA') B
  let c : B →ₐ[S.R ⧸ IR] (S.Λ ⧸ IL') :=
    { toRingHom := algebraMap B (S.Λ ⧸ IL')
      commutes' := fun x => (IsScalarTower.algebraMap_apply _ _ _ x).symm }
  have hquot : ∀ x : S.R,
      algebraMap (S.R ⧸ IR) (S.Λ ⧸ IL') (mkR x) =
        Ideal.Quotient.mk IL' (algebraMap S.R S.Λ x) := by
    intro x
    rw [IsScalarTower.algebraMap_apply (S.R ⧸ IR) (S.A ⧸ IA')
      (S.Λ ⧸ IL') (mkR x), hbaseA x, hbaseAL]
    simp [IsScalarTower.algebraMap_eq S.R S.A S.Λ]
  have hbar : ∀ x : S.R,
      bar (Ideal.Quotient.mk IA' (algebraMap S.R S.A x)) =
        algebraMap (S.R ⧸ IR) B (mkR x) := by
    intro x
    show algebraMap (S.A ⧸ IA') B
      (Ideal.Quotient.mk IA' (algebraMap S.R S.A x)) = _
    rw [← hbaseA x,
      IsScalarTower.algebraMap_apply (S.R ⧸ IR) (S.A ⧸ IA') B (mkR x)]
  have hfactor : ∀ a : S.A,
      c (bar (Ideal.Quotient.mk IA' a)) =
        Ideal.Quotient.mk IL' (f a) := by
    intro a
    calc
      c (bar (Ideal.Quotient.mk IA' a)) =
          algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL')
            (Ideal.Quotient.mk IA' a) :=
          (IsScalarTower.algebraMap_apply (S.A ⧸ IA') B
            (S.Λ ⧸ IL') (Ideal.Quotient.mk IA' a)).symm
      _ = Ideal.Quotient.mk IL' (algebraMap S.A S.Λ a) := hbaseAL a
      _ = Ideal.Quotient.mk IL' (f a) := by simp [f]
  obtain ⟨B', hB'comm, hB'alg, hB'fp, a, G, hGa, hAway, hCsing⟩ :=
    exists_finitePresentation_factorization_smoothAway_singularIdeal_le
      S.R S.Λ S.A B π ((annihilator_span_singleton_eq_sq_iff π).mpr hR)
      ((annihilator_span_singleton_eq_sq_iff (algebraMap S.R S.Λ π)).mpr hΛ)
      f hstandard hquot bar hbar c hfactor
  let : CommRing B' := hB'comm
  let : Algebra S.R B' := hB'alg
  let : Algebra.FinitePresentation S.R B' := hB'fp
  let : Algebra S.A B' := a.toRingHom.toAlgebra
  let : Algebra B' S.Λ := G.toRingHom.toAlgebra
  let : IsScalarTower S.R S.A B' := IsScalarTower.of_algebraMap_eq' (by
    ext x
    exact (a.commutes x).symm)
  let : IsScalarTower S.A B' S.Λ := IsScalarTower.of_algebraMap_eq' (by
    ext x
    exact (congrArg (fun k : S.A →ₐ[S.R] S.Λ => k x) hGa).symm)
  let : IsScalarTower S.R B' S.Λ := IsScalarTower.of_algebraMap_eq' (by
    ext x
    exact (G.commutes x).symm)
  refine ⟨B', hB'comm, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, hB'fp, ?_, ?_⟩
  · let H_A : Ideal S.Λ :=
      (Ideal.map (algebraMap S.A S.Λ) (singularIdeal S.R S.A)).radical
    let H_B : Ideal S.Λ :=
      (Ideal.map G (singularIdeal S.R B')).radical
    let eAA : (S.A ⧸ IA) ≃ₐ[S.R ⧸ IR] (S.A ⧸ IA') :=
      AlgEquiv.ofRingEquiv (f := eA) (by
        intro r
        exact hRA r)
    have hsingA : Ideal.map eA.toRingHom
        (singularIdeal (S.R ⧸ IR) (S.A ⧸ IA)) =
          singularIdeal (S.R ⧸ IR) (S.A ⧸ IA') :=
      singularIdeal_algEquiv eAA
    have hquotSing : Ideal.map mkA (singularIdeal S.R S.A) ≤
        singularIdeal (S.R ⧸ IR) (S.A ⧸ IA) :=
      singularIdeal_map_quotient_le (R := S.R) (A := S.A) IR
    have hcomp : mkL'.comp (algebraMap S.A S.Λ) =
        (algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL')).comp
          (eA.toRingHom.comp mkA) := by
      ext a
      show Ideal.Quotient.mk IL' (algebraMap S.A S.Λ a) =
        algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL')
          (eA (Ideal.Quotient.mk IA a))
      rw [show eA (Ideal.Quotient.mk IA a) = Ideal.Quotient.mk IA' a by
        simp [eA]]
      exact (hbaseAL a).symm
    have hmapSing :
        Ideal.map mkL' (Ideal.map (algebraMap S.A S.Λ)
          (singularIdeal S.R S.A)) =
        Ideal.map (algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL'))
          (Ideal.map eA.toRingHom (Ideal.map mkA
            (singularIdeal S.R S.A))) := by
      calc
        _ = Ideal.map (mkL'.comp (algebraMap S.A S.Λ))
            (singularIdeal S.R S.A) := by rw [Ideal.map_map]
        _ = Ideal.map ((algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL')).comp
              (eA.toRingHom.comp mkA))
            (singularIdeal S.R S.A) := by rw [hcomp]
        _ = _ := by
          rw [← RingHom.comp_assoc, ← Ideal.map_map, ← Ideal.map_map]
    have hsource : Ideal.map mkL' H_A ≤
        (Ideal.map (algebraMap B (S.Λ ⧸ IL'))
          (singularIdeal (S.R ⧸ IR) B)).radical := by
      calc
        _ ≤ (Ideal.map mkL'
              (Ideal.map (algebraMap S.A S.Λ)
                (singularIdeal S.R S.A))).radical :=
                Ideal.map_radical_le _
        _ = (Ideal.map (algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL'))
              (Ideal.map eA.toRingHom
                (Ideal.map mkA (singularIdeal S.R S.A)))).radical := by
                rw [hmapSing]
        _ ≤ (Ideal.map (algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL'))
              (Ideal.map eA.toRingHom
                (singularIdeal (S.R ⧸ IR) (S.A ⧸ IA)))).radical :=
                Ideal.radical_mono (Ideal.map_mono (Ideal.map_mono hquotSing))
        _ = (Ideal.map (algebraMap (S.A ⧸ IA') (S.Λ ⧸ IL'))
              (singularIdeal (S.R ⧸ IR) (S.A ⧸ IA'))).radical := by
                rw [hsingA]
        _ ≤ (Ideal.map (algebraMap B (S.Λ ⧸ IL'))
              (singularIdeal (S.R ⧸ IR) B)).radical := hSing
    have hmod : Ideal.map mkL' H_A ≤ (Ideal.map mkL' H_B).radical := by
      calc
        _ ≤ (Ideal.map (algebraMap B (S.Λ ⧸ IL'))
              (singularIdeal (S.R ⧸ IR) B)).radical := hsource
        _ ≤ (Ideal.map mkL' H_B).radical := by
              apply Ideal.radical_mono
              have hx : Ideal.map c.toRingHom
                  (singularIdeal (S.R ⧸ IR) B) ≤ Ideal.map mkL' H_B := by
                show Ideal.map c.toRingHom
                    (singularIdeal (S.R ⧸ IR) B) ≤
                  Ideal.map (Ideal.Quotient.mk IL')
                    ((Ideal.map G.toRingHom
                      (singularIdeal S.R B')).radical)
                simpa [c, H_B, IR, IL', RingHom.comp_apply, Ideal.map_map] using hCsing
              simpa [c] using hx
    have hπ8 : (algebraMap S.R S.Λ π) ^ 8 ∈ H_B := by
      apply Ideal.mem_radical_iff.mpr
      refine ⟨1, ?_⟩
      simpa [H_B] using Ideal.mem_map_of_mem G
        (Ideal.pow_mem_of_mem (I := singularIdeal S.R B')
          (mem_singularIdeal_of_smoothAway (R := S.R) (B := B') π hAway)
          8 (by norm_num))
    have hker : IL' ≤ H_B := by
      show Ideal.span {(algebraMap S.R S.Λ π) ^ 8} ≤ H_B
      exact (Ideal.span_singleton_le_iff_mem _).mpr hπ8
    have hpre : H_A ≤ Ideal.comap mkL' ((Ideal.map mkL' H_B).radical) :=
      Ideal.map_le_iff_le_comap.mp hmod
    rw [Ideal.comap_radical,
      Ideal.comap_map_of_surjective mkL' Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker,
      sup_eq_left.mpr hker] at hpre
    change H_A ≤ H_B.radical at hpre
    rw [show H_B.radical = H_B by
      dsimp [H_B]
      exact Ideal.radical_idem _] at hpre
    exact hpre
  · intro hle
    let H_B : Ideal S.Λ :=
      (Ideal.map G.toRingHom (singularIdeal S.R B')).radical
    have hILq : IL' ≤ S.q := by
      apply Ideal.span_le.mpr
      rintro x hx
      rw [Set.mem_singleton_iff.mp hx]
      exact Ideal.pow_mem_of_mem (I := S.q) (a := algebraMap S.R S.Λ π)
        hπq 8 (by norm_num)
    let : (Ideal.map mkL' S.q).IsPrime :=
      Ideal.isPrime_map_quotientMk_of_isPrime hILq
    have hmod : Ideal.map mkL' H_B ≤ Ideal.map mkL' S.q := Ideal.map_mono hle
    have hsing : Ideal.map c.toRingHom
        (singularIdeal (S.R ⧸ IR) B) ≤ Ideal.map mkL' S.q :=
      hCsing.trans hmod
    exact hNot ((Ideal.IsPrime.radical_le_iff (by infer_instance)).2 hsing)

/-- The ideal generated by the eighth powers of the members preceding the last index is the
ideal generated by the eighth powers of the family with its last member removed. -/
private lemma eighthPowerPrefixIdeal_last
    {R : Type*} [CommRing R] {n : ℕ} (π : Fin (n + 1) → R) :
    eighthPowerPrefixIdeal π (Fin.last n) =
      eighthPowerIdeal (fun i : Fin n => π i.castSucc) := by
  unfold eighthPowerPrefixIdeal eighthPowerIdeal
  congr 1
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    let j : Fin n := ⟨i.val, hi⟩
    exact ⟨j, congrArg (fun k => π k ^ 8) (Fin.ext rfl)⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i.castSucc, i.isLt, rfl⟩

/-- The ideals generated by the eighth powers of initial segments of the family with the last
member removed are those of the original family at the corresponding indices. -/
private lemma eighthPowerPrefixIdeal_castSucc
    {R : Type*} [CommRing R] {n : ℕ} (π : Fin (n + 1) → R) (i : Fin n) :
    eighthPowerPrefixIdeal (fun j : Fin n => π j.castSucc) i =
      eighthPowerPrefixIdeal π i.castSucc := by
  unfold eighthPowerPrefixIdeal
  congr 1
  ext x
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨j.castSucc, hj, rfl⟩
  · rintro ⟨j, hj, rfl⟩
    let k : Fin n := ⟨j.val, lt_trans hj i.isLt⟩
    exact ⟨k, hj, congrArg (fun l => π l ^ 8) (Fin.ext rfl)⟩

/-- The induction on `r` behind `canBeResolved_of_quotient_eighthPowerIdeal`, with the
annihilator conditions in their elementwise form. -/
private theorem canBeResolved_of_quotient_eighthPowerIdeal_aux
    (S : LocalSmoothingSituation.{u, v, w})
    {r : ℕ} (hr : 1 ≤ r) (π : Fin r → S.R)
    (hπq : ∀ i, algebraMap S.R S.Λ (π i) ∈ S.q)
    (hannR : ∀ i,
      let I := eighthPowerPrefixIdeal π i
      ∀ x : S.R ⧸ I,
        x * Ideal.Quotient.mk I (π i) = 0 ↔
          x * (Ideal.Quotient.mk I (π i)) ^ 2 = 0)
    (hannΛ : ∀ i,
      let I := Ideal.map (algebraMap S.R S.Λ)
        (eighthPowerPrefixIdeal π i)
      ∀ x : S.Λ ⧸ I,
        x * Ideal.Quotient.mk I (algebraMap S.R S.Λ (π i)) = 0 ↔
          x * (Ideal.Quotient.mk I
            (algebraMap S.R S.Λ (π i))) ^ 2 = 0)
    (hstandard : ∀ i,
      IsStrictlyStandard (R := S.R) (A := S.A)
        (algebraMap S.R S.A (π i)))
    (hresolve :
      let I := eighthPowerIdeal π
      let IA := Ideal.map (algebraMap S.R S.A) I
      let IΛ := Ideal.map (algebraMap S.A S.Λ) IA
      letI : Algebra (S.R ⧸ I) (S.Λ ⧸ IΛ) :=
        ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IΛ)).comp
          (algebraMap (S.R ⧸ I) (S.A ⧸ IA))).toAlgebra
      letI : IsScalarTower (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IΛ) :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      CanBeResolved
        (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IΛ)
        (Ideal.map (Ideal.Quotient.mk IΛ) S.q)) :
    CanBeResolved S.R S.A S.Λ S.q := by
  classical
  revert S hr π hπq hannR hannΛ hstandard hresolve
  induction r using Nat.strong_induction_on with
  | h r ih =>
      intro S hr π hπq hannR hannΛ hstandard hresolve
      cases r with
      | zero => omega
      | succ n =>
        by_cases hn : n = 0
        · subst n
          have hI : eighthPowerIdeal π = Ideal.span {(π 0) ^ 8} := by
            unfold eighthPowerIdeal
            congr 1
            ext x
            constructor
            · rintro ⟨i, rfl⟩; fin_cases i; rfl
            · intro h; exact ⟨0, h⟩
          have hprefix : eighthPowerPrefixIdeal π 0 = ⊥ := by
            simp [eighthPowerPrefixIdeal]
          have hR0 : ∀ x : S.R ⧸ (⊥ : Ideal S.R),
              x * Ideal.Quotient.mk ⊥ (π 0) = 0 ↔
                x * (Ideal.Quotient.mk ⊥ (π 0)) ^ 2 = 0 := by
            have h := hannR 0
            dsimp only at h
            rw [hprefix] at h
            exact h
          have hΛ0 : ∀ x : S.Λ ⧸ (⊥ : Ideal S.Λ),
              x * Ideal.Quotient.mk ⊥ (algebraMap S.R S.Λ (π 0)) = 0 ↔
                x * (Ideal.Quotient.mk ⊥ (algebraMap S.R S.Λ (π 0))) ^ 2 = 0 := by
            have h := hannΛ 0
            dsimp only at h
            rw [hprefix, Ideal.map_bot] at h
            exact h
          have hR : ∀ x : S.R, x * π 0 = 0 ↔ x * (π 0) ^ 2 = 0 := by
            have := annihilator_condition_ringEquiv
              (e := RingEquiv.quotientBot S.R)
              (t := Ideal.Quotient.mk ⊥ (π 0)) hR0
            simpa using this
          have hΛ : ∀ x : S.Λ,
              x * algebraMap S.R S.Λ (π 0) = 0 ↔
                x * (algebraMap S.R S.Λ (π 0)) ^ 2 = 0 := by
            have := annihilator_condition_ringEquiv
              (e := RingEquiv.quotientBot S.Λ)
              (t := Ideal.Quotient.mk ⊥ (algebraMap S.R S.Λ (π 0))) hΛ0
            have hmap : RingEquiv.quotientBot S.Λ
                (algebraMap S.R (S.Λ ⧸ (⊥ : Ideal S.Λ)) (π 0)) =
                  algebraMap S.R S.Λ (π 0) :=
              (AlgEquiv.quotientBot S.R S.Λ).commutes (π 0)
            simpa only [hmap, RingEquiv.quotientBot_mk] using this
          apply resolve_of_quotient_single_eighthPower S (π 0) (hπq 0) hR hΛ
            (hstandard 0)
          change quotientResolvable S (eighthPowerIdeal π) at hresolve
          rw [hI] at hresolve
          exact hresolve
        · let θ : Fin n → S.R := fun i => π i.castSucc
          let I := eighthPowerIdeal θ
          have hprefix : eighthPowerPrefixIdeal π (Fin.last n) = I :=
            eighthPowerPrefixIdeal_last π
          have hI : I ≤ S.q.comap (algebraMap S.R S.Λ) := by
            rw [← hprefix]
            exact eighthPowerPrefixIdeal_le_comap π S.q (Fin.last n) hπq
          let T := quotientSmoothingSituation S I hI
          let : Algebra T.R T.Λ := T.algebraRΛ
          let : IsScalarTower T.R T.A T.Λ := T.isScalarTower
          let t : T.R := Ideal.Quotient.mk I (π (Fin.last n))
          have htotal : eighthPowerIdeal π = I ⊔ Ideal.span {π (Fin.last n) ^ 8} := by
            rw [eighthPowerIdeal_eq_prefix_sup_last, hprefix]
          have hquot : quotientResolvable T (Ideal.span {t ^ 8}) := by
            have h := hresolve
            change quotientResolvable S (eighthPowerIdeal π) at h
            rw [htotal] at h
            have h' := quotientResolvable_quotient S I
              (Ideal.span {π (Fin.last n) ^ 8}) hI h
            have hm : Ideal.map (Ideal.Quotient.mk I)
                (Ideal.span {π (Fin.last n) ^ 8}) = Ideal.span {t ^ 8} := by
              rw [Ideal.map_span]
              simp [t]
              rfl
            rw [hm] at h'
            exact h'
          have htq : algebraMap T.R T.Λ t ∈ T.q := by
            apply Ideal.mem_map_of_mem
            show algebraMap S.A S.Λ (algebraMap S.R S.A (π (Fin.last n))) ∈ S.q
            rw [← IsScalarTower.algebraMap_apply]
            exact hπq (Fin.last n)
          have htR : ∀ x : T.R, x * t = 0 ↔ x * t ^ 2 = 0 := by
            have h := hannR (Fin.last n)
            dsimp only at h
            rw [hprefix] at h
            exact h
          have htL : ∀ x : T.Λ,
              x * algebraMap T.R T.Λ t = 0 ↔
                x * (algebraMap T.R T.Λ t) ^ 2 = 0 := by
            have h := hannΛ (Fin.last n)
            dsimp only at h
            rw [hprefix, IsScalarTower.algebraMap_eq S.R S.A S.Λ,
              ← Ideal.map_map] at h
            exact h
          have htstandard : IsStrictlyStandard (R := T.R) (A := T.A)
              (algebraMap T.R T.A t) :=
            by
              show IsStrictlyStandard (R := S.R ⧸ I)
                (Ideal.Quotient.mk (I.map (algebraMap S.R S.A))
                  (algebraMap S.R S.A (π (Fin.last n))))
              exact strictlyStandard_quotient I _ (hstandard (Fin.last n))
          have hT := resolve_of_quotient_single_eighthPower T t htq htR htL
            htstandard hquot
          refine ih n (Nat.lt_succ_self n) S (by omega) θ
            (fun i => hπq i.castSucc) ?_ ?_ (fun i => hstandard i.castSucc) ?_
          · intro i
            have h := hannR i.castSucc
            dsimp only at h ⊢
            rw [← eighthPowerPrefixIdeal_castSucc] at h
            exact h
          · intro i
            have h := hannΛ i.castSucc
            dsimp only at h ⊢
            rw [← eighthPowerPrefixIdeal_castSucc] at h
            exact h
          · exact hT

/-- **Stacks 07F8.** Let `R → A → Λ ⊃ q` be a local smoothing situation, let `r ≥ 1` and let
`π₁, …, π_r ∈ R` map into `q`. Assume that for `i = 1, …, r` the annihilator of `π_i` equals
the annihilator of `π_i²` in `R/(π₁⁸, …, π_{i-1}⁸)R` and likewise in
`Λ/(π₁⁸, …, π_{i-1}⁸)Λ`, and that `π_i` maps to a strictly standard element of `A` over `R`.
If the chain `R/(π₁⁸, …, π_r⁸)R → A/(π₁⁸, …, π_r⁸)A → Λ/(π₁⁸, …, π_r⁸)Λ`
can be resolved at `q/(π₁⁸, …, π_r⁸)Λ`, then `R → A → Λ ⊃ q` can be resolved. -/
@[stacks 07F8]
theorem canBeResolved_of_quotient_eighthPowerIdeal
    (S : LocalSmoothingSituation.{u, v, w})
    {r : ℕ} (hr : 1 ≤ r) (π : Fin r → S.R)
    (hπq : ∀ i, algebraMap S.R S.Λ (π i) ∈ S.q)
    (hannR : ∀ i,
      let I := eighthPowerPrefixIdeal π i
      (Submodule.span (S.R ⧸ I) {Ideal.Quotient.mk I (π i)}).annihilator =
        (Submodule.span (S.R ⧸ I) {(Ideal.Quotient.mk I (π i)) ^ 2}).annihilator)
    (hannΛ : ∀ i,
      let I := Ideal.map (algebraMap S.R S.Λ) (eighthPowerPrefixIdeal π i)
      (Submodule.span (S.Λ ⧸ I)
          {Ideal.Quotient.mk I (algebraMap S.R S.Λ (π i))}).annihilator =
        (Submodule.span (S.Λ ⧸ I)
          {(Ideal.Quotient.mk I (algebraMap S.R S.Λ (π i))) ^ 2}).annihilator)
    (hstandard : ∀ i,
      IsStrictlyStandard (R := S.R) (A := S.A) (algebraMap S.R S.A (π i)))
    (hresolve :
      let I := eighthPowerIdeal π
      let IA := Ideal.map (algebraMap S.R S.A) I
      let IΛ := Ideal.map (algebraMap S.A S.Λ) IA
      letI : Algebra (S.R ⧸ I) (S.Λ ⧸ IΛ) :=
        ((algebraMap (S.A ⧸ IA) (S.Λ ⧸ IΛ)).comp
          (algebraMap (S.R ⧸ I) (S.A ⧸ IA))).toAlgebra
      letI : IsScalarTower (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IΛ) :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      CanBeResolved
        (S.R ⧸ I) (S.A ⧸ IA) (S.Λ ⧸ IΛ)
        (Ideal.map (Ideal.Quotient.mk IΛ) S.q)) :
    S.CanBeResolved :=
  canBeResolved_of_quotient_eighthPowerIdeal_aux S hr π hπq
    (fun i => (annihilator_span_singleton_eq_sq_iff _).mp (hannR i))
    (fun i => (annihilator_span_singleton_eq_sq_iff _).mp (hannΛ i))
    hstandard hresolve

end Stacks.Smoothing

end
