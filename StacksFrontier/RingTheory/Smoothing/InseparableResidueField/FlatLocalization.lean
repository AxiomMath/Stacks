module

public import StacksFrontier.RingTheory.Smoothing.InseparableResidueField.FibreFlatness

/-!
# Inseparable residue fields: Stacks 07FH, clause (1)

The λ-choice in the setting `Λ_𝔮/𝔮^nΛ_𝔮` of Stacks 07FH, a regular system of parameters coming
from the prime, clause (1) of Stacks 07FH, and the essential smoothness of the map on prime-power
quotients.

This is the fourth part of `StacksFrontier.RingTheory.Smoothing.InseparableResidueField`.

## Main results

* `Stacks.Smoothing.exists_coefficientStage_basis_kaehlerDifferential_primePowerQuotient`: the
  λ-choice in the setting of Stacks 07FH.
* `Stacks.Smoothing.exists_mvPolynomial_flat_localization`: Stacks 07FH, clause (1).
* `Stacks.Smoothing.isEssentiallySmooth_quotient_of_flat`: essential smoothness of the map on
  prime-power quotients.
-/

@[expose] public section

namespace Stacks.Smoothing

open IsLocalRing MvPolynomial
open scoped TensorProduct

universe u v

/-- Every element of the residue field of `Λ_𝔮/𝔮^n Λ_𝔮` is a quotient of two residues of
elements of `Λ`: that residue field is the fraction field of `Λ/𝔮`. -/
private lemma exists_mul_residue_eq_residue_primePowerQuotient {Λ : Type*} [CommRing Λ]
    (𝔮 : Ideal Λ) [𝔮.IsPrime] {n : ℕ} [IsLocalRing (primePowerQuotient 𝔮 n)]
    (c : ResidueField (primePowerQuotient 𝔮 n)) :
    ∃ a b : Λ,
      residue (primePowerQuotient 𝔮 n) (algebraMap Λ (primePowerQuotient 𝔮 n) b) ≠ 0 ∧
      c * residue (primePowerQuotient 𝔮 n) (algebraMap Λ (primePowerQuotient 𝔮 n) b)
        = residue (primePowerQuotient 𝔮 n) (algebraMap Λ (primePowerQuotient 𝔮 n) a) := by
  obtain ⟨z, hz⟩ := residue_surjective c
  obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl u
  refine ⟨a, (s : Λ), ?_, ?_⟩
  · have h1 : IsUnit (algebraMap Λ (Localization.AtPrime 𝔮) (s : Λ)) :=
      IsLocalization.map_units (Localization.AtPrime 𝔮) s
    have h2 : IsUnit (algebraMap Λ (primePowerQuotient 𝔮 n) (s : Λ)) :=
      h1.map (Ideal.Quotient.mk (Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n)))
    intro h0
    exact (mem_maximalIdeal _).mp ((residue_eq_zero_iff _).mp h0) h2
  · have hspec := IsLocalization.mk'_spec (Localization.AtPrime 𝔮) a s
    rw [show IsLocalization.mk' (Localization.AtPrime 𝔮) a s = u from hs] at hspec
    have := congrArg (fun y : Localization.AtPrime 𝔮 => residue (primePowerQuotient 𝔮 n)
      (Ideal.Quotient.mk (Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n)) y)) hspec
    simp only [map_mul, hu, hz] at this
    exact this

/-- **The λ-choice of Stacks 07FH, in the setting of that lemma.** Let `k` be a field of
characteristic `p > 0`, let `Λ` be a Noetherian `k`-algebra, let `𝔮` be a prime of `Λ`, let
`n ≥ 1` and assume `dim_K H₁(L_{K/k}) < ∞` for the residue field `K = κ(𝔮)` of
`Λ̄ = Λ_𝔮/𝔮^nΛ_𝔮`. Then for every finite subset `S` of `Λ` there are a ring-theoretic section
`σ : K → Λ̄` of the residue map, generators `λ₁, …, λ_d` of the maximal ideal of `Λ̄`, a finite
`S ⊆ Y ⊆ Λ` and elements `μ₁, …, μ_t` of `Y` such that the stage
`A = Ψ_σ(F[λ₁, …, λ_d])` of the coefficient field `F = k(ȳ : y ∈ Y)` contains the image of `k`
and the images of all elements of `Y`, has residue image exactly `F`, and has
`dμ̄₁, …, dμ̄_t` a basis of `Ω_{F/k}`.

The hypothesis of `exists_coefficientStage_basis_kaehlerDifferential` on the map `Λ → Λ̄` is
automatic here: `κ(𝔮)` is the fraction field of `Λ/𝔮`. -/
@[stacks 07FG "A strengthening of the central claim of the source's proof, needed by Stacks 07FH
and not proved there. 07FH picks λ₁, …, λ_t ∈ Λ whose images lie in the approximating subalgebra
A ⊆ Λ_𝔮/𝔮^nΛ_𝔮 of 07FG and whose differentials form a basis of Ω_{F/k} for F = A/𝔪_A; no
argument is given, A is never enlarged afterwards, and for a general member of the directed
family the residues of elements of Λ lying in F do not generate F. With Λ/𝔮 = k[x, y], so
K = k(x, y), and F = k(x/y) one has F ∩ k[x, y] = k, because a nonconstant element of k(x/y) is
homogeneous of degree 0, so the differentials of the residues of Λ lying in F span 0 ≠ Ω_{F/k};
and by exists_subalgebra_residueField_image_eq_of_charP every finitely generated subfield of K
above a bound does occur as A/𝔪_A. What is added here is that the section σ and
the generators λ of 𝔪 may be chosen so that the coefficient field is generated by residues of
elements of Λ — it is k(Ȳ) for a finite Y ⊆ Λ containing any prescribed finite set, with the
images of all elements of Y inside the stage — whence a basis of Ω_{k(Ȳ)/k} among the
differentials of residues of elements of Λ whose images lie in the stage. NOT covered: flatness
of Λ_𝔮/𝔮^nΛ_𝔮 over this particular stage, which exists_stage supplies only for coefficient
fields large enough to contain the b-coordinates of the generators of 𝔪."]
theorem exists_coefficientStage_basis_kaehlerDifferential_primePowerQuotient {k Λ : Type*}
    [Field k] [CommRing Λ] [Algebra k Λ] [IsNoetherianRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] {n : ℕ}
    [IsLocalRing (primePowerQuotient 𝔮 n)] (p : ℕ) [Fact p.Prime] [CharP k p]
    [Module.Finite (ResidueField (primePowerQuotient 𝔮 n))
      (Algebra.H1Cotangent k (ResidueField (primePowerQuotient 𝔮 n)))] (S : Finset Λ) :
    ∃ (Y : Finset Λ) (σ : ResidueField (primePowerQuotient 𝔮 n) →+* primePowerQuotient 𝔮 n)
      (d : ℕ) (x : Fin d → primePowerQuotient 𝔮 n)
      (F : IntermediateField k (ResidueField (primePowerQuotient 𝔮 n))) (t : ℕ) (lam : Fin t → Λ)
      (hlam : ∀ j, residue (primePowerQuotient 𝔮 n)
        (algebraMap Λ (primePowerQuotient 𝔮 n) (lam j)) ∈ F),
      S ⊆ Y ∧ (∀ j, lam j ∈ Y) ∧ (∀ c, residue (primePowerQuotient 𝔮 n) (σ c) = c) ∧
      Ideal.span (Set.range x) = maximalIdeal (primePowerQuotient 𝔮 n) ∧
      F = IntermediateField.adjoin k ((fun y => residue (primePowerQuotient 𝔮 n)
        (algebraMap Λ (primePowerQuotient 𝔮 n) y)) '' (Y : Set Λ)) ∧ F.FG ∧
      (∀ a : k, algebraMap k (primePowerQuotient 𝔮 n) a ∈ coefficientStage σ F x) ∧
      (∀ y ∈ Y, algebraMap Λ (primePowerQuotient 𝔮 n) y ∈ coefficientStage σ F x) ∧
      (∀ z ∈ coefficientStage σ F x, residue (primePowerQuotient 𝔮 n) z ∈ F) ∧
      ∃ b : Module.Basis (Fin t) F (Ω[F⁄k]), ∀ j, b j = KaehlerDifferential.D k F
        ⟨residue (primePowerQuotient 𝔮 n) (algebraMap Λ (primePowerQuotient 𝔮 n) (lam j)),
          hlam j⟩ := by
  have : IsArtinianRing (primePowerQuotient 𝔮 n) := isArtinianRing_primePowerQuotient 𝔮
  exact exists_coefficientStage_basis_kaehlerDifferential (k := k) p
    (algebraMap Λ (primePowerQuotient 𝔮 n))
    (fun c => exists_mul_residue_eq_residue_primePowerQuotient 𝔮 c) S

/-! ### A regular system of parameters coming from the prime -/

/-- Every element of the maximal ideal of `Λ_𝔮` becomes, after multiplication by a unit, the
image of an element of `𝔮`. -/
private theorem exists_mem_unit_mul_eq_algebraMap {Λ : Type*} [CommRing Λ] (𝔮 : Ideal Λ)
    [𝔮.IsPrime] {z : Localization.AtPrime 𝔮} (hz : z ∈ maximalIdeal (Localization.AtPrime 𝔮)) :
    ∃ a : Λ, a ∈ 𝔮 ∧ ∃ u : Localization.AtPrime 𝔮, IsUnit u ∧
      algebraMap Λ (Localization.AtPrime 𝔮) a = u * z := by
  obtain ⟨⟨a, s⟩, hat⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl z
  have heq : algebraMap Λ (Localization.AtPrime 𝔮) (s : Λ) * z
      = algebraMap Λ (Localization.AtPrime 𝔮) a := by
    rw [← hat, mul_comm]
    exact IsLocalization.mk'_spec _ a s
  have hmem : algebraMap Λ (Localization.AtPrime 𝔮) a
      ∈ maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← heq]
    exact Ideal.mul_mem_left _ _ hz
  refine ⟨a, ?_, algebraMap Λ (Localization.AtPrime 𝔮) (s : Λ),
    IsLocalization.map_units _ s, heq.symm⟩
  exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 a).mp hmem

/-- The maximal ideal of `Λ_𝔮` is generated by the images of finitely many elements of `𝔮`,
as many as the minimal number of generators of that maximal ideal. -/
theorem exists_fin_span_eq_maximalIdeal_localization {Λ : Type*} [CommRing Λ]
    [IsNoetherianRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] :
    ∃ (r : ℕ) (mu : Fin r → Λ), (∀ j, mu j ∈ 𝔮) ∧
      Ideal.span (Set.range fun j => algebraMap Λ (Localization.AtPrime 𝔮) (mu j))
        = maximalIdeal (Localization.AtPrime 𝔮) ∧
      (maximalIdeal (Localization.AtPrime 𝔮)).spanFinrank = r := by
  classical
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (IsNoetherian.noetherian (maximalIdeal (Localization.AtPrime 𝔮)))
  have hmem : ∀ x : s, (x : Localization.AtPrime 𝔮) ∈ maximalIdeal (Localization.AtPrime 𝔮) :=
    fun x => hspan ▸ Ideal.subset_span x.2
  choose a ha u hu hau using fun x : s => exists_mem_unit_mul_eq_algebraMap 𝔮 (hmem x)
  refine ⟨s.card, fun j => a (s.equivFin.symm j), fun j => ha _, ?_, hcard.symm⟩
  have hrange : (Set.range fun j : Fin s.card =>
        algebraMap Λ (Localization.AtPrime 𝔮) (a (s.equivFin.symm j)))
      = Set.range fun x : s => algebraMap Λ (Localization.AtPrime 𝔮) (a x) :=
    s.equivFin.symm.surjective.range_comp fun x : s => algebraMap Λ (Localization.AtPrime 𝔮) (a x)
  rw [hrange, ← hspan]
  refine le_antisymm (Ideal.span_le.mpr (Set.range_subset_iff.mpr fun x => ?_))
    (Ideal.span_le.mpr fun z hz => ?_)
  · show algebraMap Λ (Localization.AtPrime 𝔮) (a x)
      ∈ Ideal.span (s : Set (Localization.AtPrime 𝔮))
    rw [hau x]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Finset.mem_coe.mpr x.2))
  · show z ∈ Ideal.span (Set.range fun x : s => algebraMap Λ (Localization.AtPrime 𝔮) (a x))
    have hzs : z ∈ s := Finset.mem_coe.mp hz
    rw [← Ideal.unit_mul_mem_iff_mem _ (hu ⟨z, hzs⟩), ← hau ⟨z, hzs⟩]
    exact Ideal.subset_span ⟨⟨z, hzs⟩, rfl⟩

/-- Modulo the ideal generated by the variables, a polynomial is its constant term. -/
private theorem sub_C_constantCoeff_mem_span_X {k : Type*} [CommRing k] {r : ℕ}
    (f : MvPolynomial (Fin r) k) :
    f - MvPolynomial.C (MvPolynomial.constantCoeff f)
      ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k)) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add q s hq hs =>
      simp only [map_add]
      rw [← sub_add_sub_comm]
      exact Ideal.add_mem _ hq hs
  | mul_X q j hq =>
      have h0 : MvPolynomial.constantCoeff (q * MvPolynomial.X j) = 0 := by simp
      rw [h0, map_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

/-- The contraction of a prime `𝔮` of `Λ` along a `k`-algebra map from a polynomial ring which
sends every variable into `𝔮` is the ideal generated by the variables: the quotient by that
ideal is `k`, which maps injectively to `Λ ⧸ 𝔮`. -/
private theorem comap_eq_span_range_X {k Λ : Type*} [Field k] [CommRing Λ] [Algebra k Λ]
    {r : ℕ} (φ : MvPolynomial (Fin r) k →ₐ[k] Λ) (𝔮 : Ideal Λ) (h𝔮 : 𝔮 ≠ ⊤)
    (hX : ∀ j, φ (MvPolynomial.X j) ∈ 𝔮) :
    Ideal.comap φ.toRingHom 𝔮
      = Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k)) := by
  have hle : Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k))
      ≤ Ideal.comap φ.toRingHom 𝔮 :=
    Ideal.span_le.mpr (Set.range_subset_iff.mpr fun j => hX j)
  refine le_antisymm (fun f hf => ?_) hle
  have hsub := hle (sub_C_constantCoeff_mem_span_X f)
  have hC : MvPolynomial.C (MvPolynomial.constantCoeff f) ∈ Ideal.comap φ.toRingHom 𝔮 := by
    have h := Ideal.sub_mem _ hf hsub
    rwa [sub_sub_cancel] at h
  have h0 : MvPolynomial.constantCoeff f = 0 := by
    by_contra hne
    refine h𝔮 (Ideal.eq_top_of_isUnit_mem 𝔮 (Ideal.mem_comap.mp hC) ?_)
    have hcom : φ.toRingHom (MvPolynomial.C (MvPolynomial.constantCoeff f))
        = algebraMap k Λ (MvPolynomial.constantCoeff f) := by
      rw [← MvPolynomial.algebraMap_eq]
      exact φ.commutes _
    rw [hcom]
    exact (isUnit_iff_ne_zero.mpr hne).map (algebraMap k Λ)
  have hfe : f = f - MvPolynomial.C (MvPolynomial.constantCoeff f) := by
    rw [h0, map_zero, sub_zero]
  rw [hfe]
  exact sub_C_constantCoeff_mem_span_X f

/-! ### Stacks 07FH, clause (1) -/

/-- **Stacks 07FH, clause (1).** Let `k` be a field, let `Λ` be a Noetherian `k`-algebra which is
geometrically regular over `k` and let `𝔮` be a prime of `Λ`. Then there are `m ≥ 0` and a
`k`-algebra map `φ : k[y_1, …, y_m] → Λ` such that, with `𝔭 = φ^{-1}(𝔮)`, one has
`𝔭 Λ_𝔮 = 𝔮 Λ_𝔮` and the induced local map `k[y_1, …, y_m]_𝔭 → Λ_𝔮` is flat. -/
@[stacks 07FH "clause (1), unconditionally. The source's choice of `λ_1, …, λ_t ∈ Λ` whose
differentials form a basis of `Ω_{F/k}` for the residue field `F` of an approximating subalgebra
`A ⊆ Λ_𝔮/𝔮^nΛ_𝔮` of Stacks 07FG is not justified by the source's TEXT, which fixes `A` by 07FG
and only afterwards asks for the `λ`, never enlarging `A` again: for SOME members of the directed
family no such `λ` exist, the residues of those elements of `Λ` which land in `F` need not
generate `F` (see the module docstring for the counterexample `Λ/𝔮 = k[x, y]`, `F = k(x/y)`).
That is all the counterexample shows. It says nothing against the source's ROUTE, since `A` may
be chosen for the purpose rather than taken as given, and
`exists_coefficientStage_basis_kaehlerDifferential` chooses it so. The choice is not needed for
clause (1) in any case: the clause is the
source's own construction specialized to `F = k`, where `t = 0`, the fibre of `Λ_𝔮` over `k` is
`Λ_𝔮` itself, and `λ_1, …, λ_m` is a regular system of parameters of `Λ_𝔮` lifted to `𝔮`. What
the λ-choice is needed for is the essential smoothness in clause (2); only regularity of `Λ_𝔮`,
not geometric regularity, is used here. `𝔭 Λ_𝔮 = 𝔮 Λ_𝔮` is the stated equality of extended
ideals and the flat arrow is the unique `g` with `g ∘ (k[y] → k[y]_𝔭) = (k[y] → Λ → Λ_𝔮)`,
flatness being `RingHom.Flat`. The source proves this from Lemma 07E6 and More on Algebra
15.36.2; the route here is miracle flatness, Lemma 00R4."]
theorem exists_mvPolynomial_flat_localization {k Λ : Type u} [Field k] [CommRing Λ] [Algebra k Λ]
    [IsNoetherianRing Λ] [Algebra.IsGeometricallyRegular k Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] :
    ∃ (m : ℕ) (φ : MvPolynomial (Fin m) k →ₐ[k] Λ)
      (g : Localization.AtPrime (Ideal.comap φ.toRingHom 𝔮) →+* Localization.AtPrime 𝔮),
      Ideal.map ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ.toRingHom)
          (Ideal.comap φ.toRingHom 𝔮)
        = Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) 𝔮 ∧
      (∀ f, g (algebraMap (MvPolynomial (Fin m) k)
            (Localization.AtPrime (Ideal.comap φ.toRingHom 𝔮)) f)
          = algebraMap Λ (Localization.AtPrime 𝔮) (φ f)) ∧
      g.Flat := by
  classical
  obtain ⟨r, mu, hmuq, hspanmu, hcard⟩ := exists_fin_span_eq_maximalIdeal_localization 𝔮
  have hregT : IsRegularRing (k ⊗[k] Λ) :=
    Algebra.IsGeometricallyRegular.isRegularRing_tensorProduct k
  have hregΛ : IsRegularRing Λ :=
    IsRegularRing.of_ringEquiv (Algebra.TensorProduct.lid k Λ).toRingEquiv
  have hregL : IsRegularLocalRing (Localization.AtPrime 𝔮) := inferInstance
  set φ : MvPolynomial (Fin r) k →ₐ[k] Λ := MvPolynomial.aeval mu with hφdef
  have hφX : ∀ j, φ.toRingHom (MvPolynomial.X j) = mu j := fun j => by
    simp [hφdef]
  set 𝔭 : Ideal (MvPolynomial (Fin r) k) := Ideal.comap φ.toRingHom 𝔮 with h𝔭def
  have h𝔭prime : 𝔭.IsPrime := inferInstance
  have hcomapmax : Ideal.comap (algebraMap Λ (Localization.AtPrime 𝔮))
      (maximalIdeal (Localization.AtPrime 𝔮)) = 𝔮 :=
    Ideal.ext fun x =>
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔮) 𝔮 x
  have h𝔭 : 𝔭 = Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k)) :=
    comap_eq_span_range_X φ 𝔮 (‹𝔮.IsPrime›.ne_top) fun j => (hφX j) ▸ hmuq j
  -- the ideal identity of clause (1)
  have hmapeq : Ideal.map ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ.toRingHom) 𝔭
      = Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) 𝔮 := by
    have hcomp : ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ.toRingHom)
          ∘ (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k)
        = fun j => algebraMap Λ (Localization.AtPrime 𝔮) (mu j) := by
      funext j
      simp only [Function.comp_apply, RingHom.coe_comp]
      rw [hφX j]
    rw [h𝔭, Ideal.map_span, ← Set.range_comp, hcomp, hspanmu,
      IsLocalization.AtPrime.map_eq_maximalIdeal 𝔮 (Localization.AtPrime 𝔮)]
  -- the local map `g`
  have hunit : ∀ y : 𝔭.primeCompl, IsUnit
      (((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ.toRingHom) (y : _)) := by
    intro y
    have hy : (y : MvPolynomial (Fin r) k) ∉ 𝔭 := Ideal.mem_primeCompl_iff.mp y.2
    have hc : φ.toRingHom (y : MvPolynomial (Fin r) k) ∈ 𝔮.primeCompl :=
      Ideal.mem_primeCompl_iff.mpr fun hmem =>
        hy (h𝔭def.ge (Ideal.mem_comap.mpr hmem))
    exact IsLocalization.map_units (Localization.AtPrime 𝔮) ⟨φ.toRingHom (y : _), hc⟩
  refine ⟨r, φ, IsLocalization.lift hunit, hmapeq,
    fun f => IsLocalization.lift_eq hunit f, ?_⟩
  -- the algebra structures carried by `ψ` and by its localization `g`
  let instPL : Algebra (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔮) :=
    ((algebraMap Λ (Localization.AtPrime 𝔮)).comp φ.toRingHom).toAlgebra
  have hPL : (algebraMap (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔮))
      = (algebraMap Λ (Localization.AtPrime 𝔮)).comp φ.toRingHom :=
    RingHom.algebraMap_toAlgebra _
  let instAL : Algebra (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮) :=
    (IsLocalization.lift hunit).toAlgebra
  have hAL : (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮))
      = IsLocalization.lift hunit :=
    RingHom.algebraMap_toAlgebra _
  have hgalg : ∀ f, algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮)
        (algebraMap (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔭) f)
      = algebraMap (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔮) f := by
    intro f
    rw [hAL, hPL]
    exact IsLocalization.lift_eq hunit f
  have hmaxL : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) 𝔮
      = maximalIdeal (Localization.AtPrime 𝔮) :=
    IsLocalization.AtPrime.map_eq_maximalIdeal 𝔮 (Localization.AtPrime 𝔮)
  have hmapeq' : Ideal.map (algebraMap (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔮)) 𝔭
      = maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [hPL, hmapeq, hmaxL]
  -- the maximal ideal of the localized polynomial ring generates that of `Λ_𝔮`
  have hmaxmap : Ideal.map (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮))
        (maximalIdeal (Localization.AtPrime 𝔭))
      = maximalIdeal (Localization.AtPrime 𝔮) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭 (Localization.AtPrime 𝔭), Ideal.map_map,
      show (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮)).comp
            (algebraMap (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔭))
          = algebraMap (MvPolynomial (Fin r) k) (Localization.AtPrime 𝔮) from
        RingHom.ext hgalg, hmapeq']
  have hlocalhom : IsLocalHom
      (algebraMap (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮)) := by
    exact ((local_hom_TFAE _).out 3 1).mp hmaxmap.le
  -- the dimension count
  have hheight : 𝔭.height ≤ (r : ℕ∞) := by
    refine (Ideal.height_le_spanFinrank 𝔭 h𝔭prime.ne_top).trans ?_
    rw [h𝔭, show (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k))
        = ((Finset.univ.image MvPolynomial.X : Finset (MvPolynomial (Fin r) k)) :
          Set (MvPolynomial (Fin r) k)) by simp]
    refine Nat.cast_le.mpr ((Submodule.spanFinrank_span_le_ncard_of_finite
      (Finset.finite_toSet _)).trans ?_)
    rw [Set.ncard_coe_finset]
    exact Finset.card_image_le.trans (by simp)
  have hdimL : ringKrullDim (Localization.AtPrime 𝔮) = (r : WithBot ℕ∞) := by
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, hcard]
  have hlies : (maximalIdeal (Localization.AtPrime 𝔮)).LiesOver 𝔭 := by
    refine ⟨?_⟩
    rw [Ideal.under_def, hPL, ← Ideal.comap_comap, hcomapmax]
  have hdimA : ringKrullDim (Localization.AtPrime 𝔭) = (r : WithBot ℕ∞) := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔭 (Localization.AtPrime 𝔭)]
    have hge : ringKrullDim (Localization.AtPrime 𝔮) ≤ ((𝔭.height : ℕ∞) : WithBot ℕ∞) :=
      ringKrullDim_le_height (R := MvPolynomial (Fin r) k) 𝔭 hmapeq'
    rw [hdimL] at hge
    exact le_antisymm (by exact_mod_cast hheight) (by exact_mod_cast hge)
  -- miracle flatness
  have hflat : Module.Flat (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔮) := by
    refine Module.Flat.of_isMaximalCohenMacaulay_of_ringKrullDim_eq_add
      (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
        (Localization.AtPrime 𝔮)).2 ?_
    rw [hmaxmap, hdimA, hdimL,
      show ringKrullDim (Localization.AtPrime 𝔮 ⧸ maximalIdeal (Localization.AtPrime 𝔮)) = 0 from
        ringKrullDim_eq_zero_of_field (ResidueField (Localization.AtPrime 𝔮)),
      add_zero]
  have hfl := RingHom.flat_algebraMap_iff.mpr hflat
  rwa [hAL] at hfl

/-! ### A basis of `Ω[κ(𝔮)⁄k]` among differentials of residues of `Λ` -/

/-- Multiplying each member of a family of generators by a unit does not change the ideal it
generates. -/
private theorem span_range_unit_mul {R : Type*} [CommRing R] {ι : Type*} (x y u : ι → R)
    (hu : ∀ i, IsUnit (u i)) (hxy : ∀ i, y i = u i * x i) :
    Ideal.span (Set.range y) = Ideal.span (Set.range x) := by
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨i, rfl⟩
    rw [hxy i]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · rintro _ ⟨i, rfl⟩
    obtain ⟨v, hv⟩ := hu i
    have hxi : (↑v⁻¹ : R) * y i = x i := by
      rw [hxy i, ← hv, ← mul_assoc, Units.inv_mul, one_mul]
    rw [← hxi]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The maximal ideal of a quotient of `Λ_𝔮` is generated by the images of as many elements of
`𝔮` as its own minimal number of generators. -/
theorem exists_fin_span_eq_maximalIdeal_quotient {Λ : Type*} [CommRing Λ]
    [IsNoetherianRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime]
    (I : Ideal (Localization.AtPrime 𝔮)) [IsLocalRing (Localization.AtPrime 𝔮 ⧸ I)] :
    ∃ (r : ℕ) (mu : Fin r → Λ), (∀ j, mu j ∈ 𝔮) ∧
      Ideal.map (Ideal.Quotient.mk I) (maximalIdeal (Localization.AtPrime 𝔮))
        = Ideal.span (Set.range fun j => Ideal.Quotient.mk I
            (algebraMap Λ (Localization.AtPrime 𝔮) (mu j))) ∧
      (maximalIdeal (Localization.AtPrime 𝔮 ⧸ I)).spanFinrank = r := by
  classical
  have hnoeL : IsNoetherianRing (Localization.AtPrime 𝔮) :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (IsNoetherian.noetherian (maximalIdeal (Localization.AtPrime 𝔮 ⧸ I)))
  have hmem : ∀ c : s, (c : Localization.AtPrime 𝔮 ⧸ I)
      ∈ Ideal.map (Ideal.Quotient.mk I) (maximalIdeal (Localization.AtPrime 𝔮)) := by
    intro c
    rw [← maximalIdeal_quotient_of_eq_pow, ← hspan]
    exact Ideal.subset_span c.2
  choose z hz hzc using fun c : s => (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective).mp (hmem c)
  choose a ha u hu hau using fun c : s => exists_mem_unit_mul_eq_algebraMap 𝔮 (hz c)
  refine ⟨s.card, fun j => a (s.equivFin.symm j), fun j => ha _, ?_, hcard.symm⟩
  have key : Ideal.span (Set.range fun c : s => Ideal.Quotient.mk I
        (algebraMap Λ (Localization.AtPrime 𝔮) (a c)))
      = Ideal.span (Set.range fun c : s => (c : Localization.AtPrime 𝔮 ⧸ I)) := by
    refine span_range_unit_mul _ _ (fun c => Ideal.Quotient.mk I (u c))
      (fun c => (hu c).map _) fun c => ?_
    rw [← hzc c, ← map_mul, ← hau c]
  have hre : (Set.range fun j : Fin s.card => Ideal.Quotient.mk I
        (algebraMap Λ (Localization.AtPrime 𝔮) (a (s.equivFin.symm j))))
      = Set.range fun c : s => Ideal.Quotient.mk I
        (algebraMap Λ (Localization.AtPrime 𝔮) (a c)) :=
    s.equivFin.symm.surjective.range_comp fun c : s => Ideal.Quotient.mk I
      (algebraMap Λ (Localization.AtPrime 𝔮) (a c))
  have hrc : (Set.range fun c : s => (c : Localization.AtPrime 𝔮 ⧸ I))
      = (s : Set (Localization.AtPrime 𝔮 ⧸ I)) := by
    ext y
    simp
  rw [hre, key, hrc]
  exact maximalIdeal_quotient_of_eq_pow.symm.trans hspan.symm

/-- **A minimal generating subfamily, by Nakayama.** If the maximal ideal of a Noetherian local
ring `C` is generated by a finite family `y`, then it is generated by a *subfamily* of `y` with
exactly `spanFinrank 𝔪_C` members.

The images of the `y j` span the cotangent space `𝔪_C/𝔪_C²` over the residue field; a maximal
linearly independent subfamily of those images is a basis, so has
`finrank = spanFinrank 𝔪_C` members, and it generates `𝔪_C` again by
`IsLocalRing.CotangentSpace.span_image_eq_top_iff`, which is Nakayama's lemma.

This is what lets the regular parameters of the fibre demanded by clause (1) of Stacks 07FH be
taken among the *global* generators `μ_j` of `𝔪_{Λ_𝔮}` in Nugent's repair, keeping both their
globality and the dimension count that `map_eq_and_flat_of_fibre` consumes. -/
theorem exists_subfamily_span_eq_maximalIdeal {C : Type*} [CommRing C] [IsLocalRing C]
    [IsNoetherianRing C] {r : ℕ} (y : Fin r → C)
    (hy : Ideal.span (Set.range y) = maximalIdeal C) :
    ∃ (r' : ℕ) (idx : Fin r' → Fin r),
      Ideal.span (Set.range fun i => y (idx i)) = maximalIdeal C ∧
      (maximalIdeal C).spanFinrank = r' := by
  classical
  -- read the family inside the maximal ideal, and translate spanning into `⊤`
  have hmemy : ∀ j, y j ∈ maximalIdeal C := fun j =>
    hy ▸ Ideal.subset_span (Set.mem_range_self j)
  set y' : Fin r → maximalIdeal C := fun j => ⟨y j, hmemy j⟩ with hy'def
  have htop : ∀ (ι : Type) (z : ι → Fin r),
      Submodule.span C (Set.range fun i => y' (z i)) = ⊤ ↔
        Ideal.span (Set.range fun i => y (z i)) = maximalIdeal C := by
    intro ι z
    rw [← Submodule.map_injective_of_injective
      (Submodule.injective_subtype (maximalIdeal C)) |>.eq_iff]
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype,
      ← Set.range_comp]
    rfl
  have hspan' : Submodule.span C (Set.range fun i => y' (id i)) = ⊤ := (htop _ id).mpr hy
  -- pass to the cotangent space, where spanning is a statement about a vector space
  set v : Fin r → CotangentSpace C := fun j => (maximalIdeal C).toCotangent (y' j) with hvdef
  have hcot : ∀ (ι : Type) (z : ι → Fin r),
      Submodule.span (ResidueField C) (Set.range fun i => v (z i)) = ⊤ ↔
        Submodule.span C (Set.range fun i => y' (z i)) = ⊤ := by
    intro ι z
    rw [← CotangentSpace.span_image_eq_top_iff (s := Set.range fun i => y' (z i)),
      ← Set.range_comp]
    rfl
  have hvspan : Submodule.span (ResidueField C) (Set.range fun i => v (id i)) = ⊤ :=
    (hcot _ id).mpr hspan'
  -- extract a linearly independent subfamily; it is a basis, so has `finrank` members
  obtain ⟨κ, a, hainj, haspan, hali⟩ :=
    exists_linearIndependent' (K := ResidueField C) (V := CotangentSpace C) v
  have hκfin : Finite κ := Finite.of_injective a hainj
  have : Fintype κ := Fintype.ofFinite κ
  have hatop : Submodule.span (ResidueField C) (Set.range fun i => v (a i)) = ⊤ := by
    rw [show (fun i => v (a i)) = v ∘ a from rfl, haspan]
    exact hvspan
  set bas : Module.Basis κ (ResidueField C) (CotangentSpace C) :=
    Module.Basis.mk hali (by rw [show (v ∘ a) = fun i => v (a i) from rfl, hatop]) with hbasdef
  have hcard : Module.finrank (ResidueField C) (CotangentSpace C) = Fintype.card κ :=
    Module.finrank_eq_card_basis bas
  -- reindex by `Fin` and read the conclusion back in `C`
  refine ⟨Fintype.card κ, fun i => a ((Fintype.equivFin κ).symm i), ?_, ?_⟩
  · refine (htop _ _).mp ((hcot _ _).mp ?_)
    have hrange : (Set.range fun i => v (a ((Fintype.equivFin κ).symm i)))
        = Set.range fun i => v (a i) :=
      (Fintype.equivFin κ).symm.surjective.range_comp (fun i => v (a i))
    rw [hrange]
    exact hatop
  · rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, hcard]

/-- If `K/k` is a finitely generated field extension and every element of `K` is a quotient of
two elements of the image of a ring map `g : R → K`, then `Ω[K⁄k]` — read on the intermediate
field `⊤` — has a basis given by the differentials of finitely many elements of the image of
`g`. -/
theorem exists_basis_kaehlerDifferential_top {k K : Type*} [Field k] [Field K]
    [Algebra k K] [Algebra.EssFiniteType k K] {R : Type*} [CommRing R] (g : R →+* K)
    (hfrac : ∀ c : K, ∃ a b : R, g b ≠ 0 ∧ c * g b = g a) :
    ∃ (t : ℕ) (lam : Fin t → R) (b : Module.Basis (Fin t)
        (⊤ : IntermediateField k K) (Ω[(⊤ : IntermediateField k K)⁄k])),
      ∀ j, b j = KaehlerDifferential.D k (⊤ : IntermediateField k K)
        ⟨g (lam j), IntermediateField.mem_top⟩ := by
  classical
  obtain ⟨T, hTfin, hT⟩ := IntermediateField.fg_def.mp (IntermediateField.fg_top k K)
  obtain ⟨Y, hY⟩ := exists_finset_mem_adjoin_image (k := k) (fun y => g y) hfrac hTfin.toFinset
  set U : Set K := (fun y => g y) '' (Y : Set R) with hUdef
  have hUtop : IntermediateField.adjoin k U = (⊤ : IntermediateField k K) := by
    refine top_le_iff.mp ?_
    rw [← hT]
    exact IntermediateField.adjoin_le_iff.mpr fun c hc => hY c (hTfin.mem_toFinset.mpr hc)
  have hUG : U ⊆ ((⊤ : IntermediateField k K) : Set K) := fun _ _ => trivial
  have hspanD := span_derivation_eq_top_of_adjoin_eq (⊤ : IntermediateField k K) U hUG hUtop
  have hfin : Finite ↥U := (Y.finite_toSet.image _).to_subtype
  have hfd : FiniteDimensional (⊤ : IntermediateField k K)
      (Ω[(⊤ : IntermediateField k K)⁄k]) :=
    Module.finite_def.mpr (hspanD ▸ Submodule.fg_span (Set.finite_range _))
  obtain ⟨t, b, wmap, hb⟩ := exists_basis_fin_range _ hspanD
  have hmem : ∀ j, ∃ y : R, g y = ((wmap j : K)) := by
    intro j
    obtain ⟨y, _, hyeq⟩ := (wmap j).2
    exact ⟨y, hyeq⟩
  choose lam hlameq using hmem
  refine ⟨t, lam, b, fun j => ?_⟩
  rw [hb j]
  congr 1
  exact Subtype.ext (hlameq j).symm


/-! ### Differentials and the residue extension -/

/-- If `Ω[K⁄k]` is spanned over `K` by the differentials of finitely many elements of a subfield
`F`, then `Ω[K⁄F]` vanishes. -/
theorem subsingleton_kaehlerDifferential_of_span {k F K : Type*} [Field k] [Field F]
    [Field K] [Algebra k F] [Algebra k K] [Algebra F K] [IsScalarTower k F K] {t : ℕ}
    (c : Fin t → F)
    (hspan : Submodule.span K (Set.range fun j => KaehlerDifferential.D k K
      (algebraMap F K (c j))) = ⊤) :
    Subsingleton (Ω[K⁄F]) := by
  have hsurj := KaehlerDifferential.map_surjective k F K
  have hle : Submodule.span K (Set.range fun j => KaehlerDifferential.D k K
        (algebraMap F K (c j)))
      ≤ LinearMap.ker (KaehlerDifferential.map k F K K) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    simp [LinearMap.mem_ker, KaehlerDifferential.map_D]
  rw [hspan] at hle
  have hz : ∀ z, KaehlerDifferential.map k F K K z = 0 := fun z => hle Submodule.mem_top
  refine ⟨fun a d => ?_⟩
  obtain ⟨a', rfl⟩ := hsurj a
  obtain ⟨d', rfl⟩ := hsurj d
  rw [hz, hz]

/-- The quotient map onto a quotient of a local ring which is again local is a local
homomorphism. -/
theorem isLocalHom_quotientMk {R : Type*} [CommRing R] [IsLocalRing R] {I : Ideal R}
    [IsLocalRing (R ⧸ I)] : IsLocalHom (Ideal.Quotient.mk I) := by
  exact ((local_hom_TFAE _).out 3 1).mp maximalIdeal_quotient_of_eq_pow.ge

/-! ### Essential smoothness of the map on prime-power quotients -/

/-- The map of residue fields induced by the quotient map to a local quotient is surjective. -/
private theorem residueField_map_mk_surjective {R : Type*} [CommRing R] [IsLocalRing R]
    (I : Ideal R) [IsLocalRing (R ⧸ I)] [IsLocalHom (Ideal.Quotient.mk I)] :
    Function.Surjective (ResidueField.map (Ideal.Quotient.mk I)) := by
  intro z
  obtain ⟨w, rfl⟩ := residue_surjective z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective w
  exact ⟨residue R a, ResidueField.map_residue _ a⟩

/-- **The map on prime-power quotients induced by a flat local homomorphism.** For a flat
`A`-algebra `L` with `A`, `L` local and `𝔪_A L = 𝔪_L`, and for `I = 𝔪_A^n`, `J = 𝔪_L^n` with
`n ≥ 1`, the induced map `A/I → L/J` is flat, local, and carries the maximal ideal of `A/I` onto
that of `L/J`.

Flatness is base change along `A → A/I`, since `I L = J`; the rest is formal. -/
theorem exists_quotient_flat_map_maximalIdeal_eq {A L : Type*} [CommRing A]
    [IsLocalRing A] [CommRing L] [IsLocalRing L] [Algebra A L] [Module.Flat A L]
    (hmax : Ideal.map (algebraMap A L) (maximalIdeal A) = maximalIdeal L)
    {n : ℕ} (hn : 1 ≤ n) {I : Ideal A} {J : Ideal L}
    (hI : I = maximalIdeal A ^ n) (hJ : J = maximalIdeal L ^ n) :
    ∃ u : (A ⧸ I) →+* (L ⧸ J),
      (∀ a, u (Ideal.Quotient.mk I a) = Ideal.Quotient.mk J (algebraMap A L a)) ∧ u.Flat ∧
      ∃ (_ : IsLocalRing (A ⧸ I)) (_ : IsLocalRing (L ⧸ J)),
        Ideal.map u (maximalIdeal (A ⧸ I)) = maximalIdeal (L ⧸ J) ∧ IsLocalHom u := by
  have hlocR : IsLocalRing (A ⧸ I) := isLocalRing_quotient_of_eq_pow hn hI
  have hlocQ : IsLocalRing (L ⧸ J) := isLocalRing_quotient_of_eq_pow hn hJ
  have hIJ : Ideal.map (algebraMap A L) I = J := by rw [hI, hJ, Ideal.map_pow, hmax]
  have hker : ∀ a ∈ I, (Ideal.Quotient.mk J) (algebraMap A L a) = 0 := by
    intro a haI
    rw [Ideal.Quotient.eq_zero_iff_mem, ← hIJ]
    exact Ideal.mem_map_of_mem _ haI
  set u : (A ⧸ I) →+* (L ⧸ J) :=
    Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp (algebraMap A L)) hker with hudef
  have hu : ∀ a, u (Ideal.Quotient.mk I a) = Ideal.Quotient.mk J (algebraMap A L a) := fun a =>
    Ideal.Quotient.lift_mk _ _ _
  have hucomp : u.comp (Ideal.Quotient.mk I) = (Ideal.Quotient.mk J).comp (algebraMap A L) :=
    RingHom.ext hu
  -- flatness, by base change along `A → A/I`
  have hflatQ : Module.Flat (A ⧸ I) (L ⧸ Ideal.map (algebraMap A L) I) :=
    Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor L I).toLinearEquiv
  have hflatu : u.Flat := by
    have hcomp : u = ((Ideal.quotEquivOfEq hIJ :
          (L ⧸ Ideal.map (algebraMap A L) I) ≃+* (L ⧸ J)) :
        (L ⧸ Ideal.map (algebraMap A L) I) →+* (L ⧸ J)).comp
          (algebraMap (A ⧸ I) (L ⧸ Ideal.map (algebraMap A L) I)) := by
      refine RingHom.ext fun z => ?_
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [hu a]
      rfl
    rw [hcomp, RingHom.Flat.comp_iff_of_bijective_left
      (Ideal.quotEquivOfEq hIJ).bijective, RingHom.flat_algebraMap_iff]
    exact hflatQ
  -- the maximal ideal of `A/I` generates that of `L/J`
  have hmaxu : Ideal.map u (maximalIdeal (A ⧸ I)) = maximalIdeal (L ⧸ J) := by
    rw [maximalIdeal_quotient_of_eq_pow, maximalIdeal_quotient_of_eq_pow, Ideal.map_map, hucomp,
      ← Ideal.map_map, hmax]
  have hlocu : IsLocalHom u := by
    exact ((local_hom_TFAE _).out 3 1).mp hmaxu.le
  exact ⟨u, hu, hflatu, hlocR, hlocQ, hmaxu, hlocu⟩

/-- **The closing step of Stacks 07FH.** Let `A → L` be a flat local homomorphism of Noetherian
local `k`-algebras with `𝔪_A L = 𝔪_L`, let `n ≥ 1` and let `I = 𝔪_A^n`, `J = 𝔪_L^n`. If the
residue field extension `κ(L)/k` is finitely generated and `Ω[κ(L)⁄k]` is spanned by the
differentials of finitely many elements of `κ(A)`, then the induced map `A/I → L/J` is
essentially smooth in the sense of `RingHom.IsEssentiallySmooth`.

The residue field extension `κ(L)/κ(A)` is then finitely generated with vanishing module of
differentials, hence finite separable, so `L/J` is finite and flat over `A/I` with
`𝔪_{A/I}(L/J) = 𝔪_{L/J}`, and Lemma [stacks, 00U6] applies. -/
theorem isEssentiallySmooth_quotient_of_flat {k A L : Type u} [Field k] [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] [CommRing L] [IsLocalRing L] [IsNoetherianRing L]
    [Algebra k A] [Algebra k L] [Algebra A L] [IsScalarTower k A L] [Module.Flat A L]
    [IsLocalHom (algebraMap A L)] [Algebra.EssFiniteType k (ResidueField L)]
    (hmax : Ideal.map (algebraMap A L) (maximalIdeal A) = maximalIdeal L)
    {t : ℕ} (c : Fin t → ResidueField A)
    (hspan : Submodule.span (ResidueField L) (Set.range fun j => KaehlerDifferential.D k
      (ResidueField L) (ResidueField.map (algebraMap A L) (c j))) = ⊤)
    {n : ℕ} (hn : 1 ≤ n) {I : Ideal A} {J : Ideal L}
    (hI : I = maximalIdeal A ^ n) (hJ : J = maximalIdeal L ^ n) :
    ∃ u : (A ⧸ I) →+* (L ⧸ J),
      (∀ a, u (Ideal.Quotient.mk I a) = Ideal.Quotient.mk J (algebraMap A L a)) ∧
      u.IsEssentiallySmooth := by
  classical
  obtain ⟨u, hu, hflatu, hlocR, hlocQ, hmaxu, hlocu⟩ :=
    exists_quotient_flat_map_maximalIdeal_eq hmax hn hI hJ
  have hartQ : IsArtinianRing (L ⧸ J) := isArtinianRing_quotient_of_eq_pow hJ
  refine ⟨u, hu, ?_⟩
  have hucomp : u.comp (Ideal.Quotient.mk I) = (Ideal.Quotient.mk J).comp (algebraMap A L) :=
    RingHom.ext hu
  have hlocmkA : IsLocalHom (Ideal.Quotient.mk I) := isLocalHom_quotientMk
  have hlocmkL : IsLocalHom (Ideal.Quotient.mk J) := isLocalHom_quotientMk
  -- the residue fields of the quotients
  have hsurjA := residueField_map_mk_surjective I
  have hsurjL := residueField_map_mk_surjective J
  set eA : ResidueField A ≃+* ResidueField (A ⧸ I) :=
    RingEquiv.ofBijective _ ⟨(ResidueField.map (Ideal.Quotient.mk I)).injective, hsurjA⟩
    with heAdef
  set eL : ResidueField L ≃+* ResidueField (L ⧸ J) :=
    RingEquiv.ofBijective _ ⟨(ResidueField.map (Ideal.Quotient.mk J)).injective, hsurjL⟩
    with heLdef
  have hsq : ∀ z, (ResidueField.map u) (ResidueField.map (Ideal.Quotient.mk I) z)
      = (ResidueField.map (Ideal.Quotient.mk J)) (ResidueField.map (algebraMap A L) z) := by
    intro z
    obtain ⟨a, rfl⟩ := residue_surjective z
    rw [ResidueField.map_residue, ResidueField.map_residue, ResidueField.map_residue,
      ResidueField.map_residue, hu a]
  -- the residue extension of `A → L` is finite separable
  let instRes : Algebra (ResidueField A) (ResidueField L) :=
    (ResidueField.map (algebraMap A L)).toAlgebra
  have hResMap : (algebraMap (ResidueField A) (ResidueField L))
      = ResidueField.map (algebraMap A L) := RingHom.algebraMap_toAlgebra _
  have htowRes : IsScalarTower k (ResidueField A) (ResidueField L) := by
    refine IsScalarTower.of_algebraMap_eq fun a => ?_
    rw [hResMap]
    show residue L (algebraMap k L a)
      = ResidueField.map (algebraMap A L) (residue A (algebraMap k A a))
    rw [ResidueField.map_residue, ← IsScalarTower.algebraMap_apply k A L]
  have hEFTres : Algebra.EssFiniteType (ResidueField A) (ResidueField L) :=
    Algebra.EssFiniteType.of_comp k (ResidueField A) (ResidueField L)
  have hsub : Subsingleton (Ω[ResidueField L⁄ResidueField A]) :=
    subsingleton_kaehlerDifferential_of_span c (by rw [hResMap]; exact hspan)
  obtain ⟨-, hsepres⟩ := finite_and_isSeparable_of_subsingleton_kaehlerDifferential
    (ResidueField A) (ResidueField L) hsub
  -- transport to the residue fields of the quotients
  let instResQ : Algebra (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)) :=
    (ResidueField.map u).toAlgebra
  have hResQMap : (algebraMap (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)))
      = ResidueField.map u := RingHom.algebraMap_toAlgebra _
  have hsepQ : Algebra.IsSeparable (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)) := by
    refine Algebra.IsSeparable.of_equiv_equiv eA eL (RingHom.ext fun z => ?_)
    rw [RingHom.comp_apply, RingHom.comp_apply, hResQMap, hResMap]
    exact hsq z
  have htowResQ : IsScalarTower k (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)) := by
    refine IsScalarTower.of_algebraMap_eq fun a => ?_
    rw [hResQMap]
    show residue (L ⧸ J) (algebraMap k (L ⧸ J) a)
      = ResidueField.map u (residue (A ⧸ I) (algebraMap k (A ⧸ I) a))
    rw [ResidueField.map_residue]
    congr 1
    show algebraMap k (L ⧸ J) a = u (Ideal.Quotient.mk I (algebraMap k A a))
    rw [hu]
    show Ideal.Quotient.mk J (algebraMap k L a) = _
    rw [IsScalarTower.algebraMap_apply k A L]
  have hEFTQk : Algebra.EssFiniteType k (ResidueField (L ⧸ J)) := by
    have hcomm : ∀ a : k, eL.toRingHom (algebraMap k (ResidueField L) a)
        = algebraMap k (ResidueField (L ⧸ J)) a := by
      intro a
      show ResidueField.map (Ideal.Quotient.mk J) (residue L (algebraMap k L a))
        = residue (L ⧸ J) (algebraMap k (L ⧸ J) a)
      rw [ResidueField.map_residue]
      rfl
    exact Algebra.EssFiniteType.of_surjective
      ({ eL.toRingHom with commutes' := hcomm } : ResidueField L →ₐ[k] ResidueField (L ⧸ J))
      eL.surjective
  have hEFTQ : Algebra.EssFiniteType (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)) :=
    Algebra.EssFiniteType.of_comp k (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J))
  have hunram : Algebra.FormallyUnramified (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)) :=
    (Algebra.FormallyUnramified.iff_isSeparable _ _).mpr hsepQ
  have hfinQ : Module.Finite (ResidueField (A ⧸ I)) (ResidueField (L ⧸ J)) :=
    Algebra.FormallyUnramified.finite_of_free _ _
  -- `L/J` is finite over `A/I`
  have hfinu : u.Finite := by
    rw [finite_iff_residue_finite u]
    have h1 : (residue (L ⧸ J)).comp u = (ResidueField.map u).comp (residue (A ⧸ I)) :=
      RingHom.ext fun a => (ResidueField.map_residue u a).symm
    rw [h1]
    refine RingHom.Finite.comp ?_ (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective)
    exact hResQMap ▸ hfinQ
  -- the étale step
  let instu : Algebra (A ⧸ I) (L ⧸ J) := u.toAlgebra
  have halgu : (algebraMap (A ⧸ I) (L ⧸ J)) = u := RingHom.algebraMap_toAlgebra _
  have hfinmod : Module.Finite (A ⧸ I) (L ⧸ J) := hfinu
  have hflatmod : Module.Flat (A ⧸ I) (L ⧸ J) :=
    RingHom.flat_algebraMap_iff.mp (halgu ▸ hflatu)
  have hres := isEssentiallySmooth_of_finite_flat (R := A ⧸ I) (D := L ⧸ J)
    (fun x => by rw [hResQMap, halgu]; exact ResidueField.map_residue u x)
    (by rw [halgu]; exact hmaxu)
  rwa [halgu] at hres

end Stacks.Smoothing
