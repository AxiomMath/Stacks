module

public import StacksFrontier.RingTheory.Smoothing.InseparableResidueField.CentralClaim

/-!
# Inseparable residue fields: flatness through the fibre and the λ-choice

Generalities used in the proof of Stacks 07FH: bases of `Ω_{F/k}` among differentials of
generators, the dimension theory that recovers flatness over a larger polynomial ring through
the fibre, the passage from finite flat to essentially smooth, the Artinian local ring
`Λ_𝔮/𝔮^nΛ_𝔮`, and the λ-choice of Stacks 07FH for a stage whose coefficient field is generated
by residues.

This is the third part of `StacksFrontier.RingTheory.Smoothing.InseparableResidueField`.

## Main definitions

* `Stacks.Smoothing.primePowerQuotient`: the ring `Λ_𝔮/𝔮^nΛ_𝔮`.

## Main results

* `Stacks.Smoothing.map_eq_and_flat_of_fibre`: flatness over `k[y_1, …, y_m]_𝔭` from flatness
  over a localization of a smaller polynomial ring.
* `Stacks.Smoothing.exists_coefficientStage_basis_kaehlerDifferential`: the λ-choice of
  Stacks 07FH.
-/

@[expose] public section

namespace Stacks.Smoothing

open IsLocalRing MvPolynomial
open scoped TensorProduct

universe u

/-! ### Generalities used in the proof of Stacks 07FH -/

open MvPolynomial in
/-- Substituting `0` for the last `m - t` variables undoes the renaming along `Fin.castLE h`. -/
private theorem aeval_rename_castLE {k : Type*} [CommRing k] {t m : ℕ} (h : t ≤ m)
    (g : MvPolynomial (Fin t) k) :
    MvPolynomial.aeval
        (fun i : Fin m => if hi : (i : ℕ) < t then MvPolynomial.X (⟨i, hi⟩ : Fin t) else 0)
        (MvPolynomial.rename (Fin.castLE h) g) = g := by
  induction g using MvPolynomial.induction_on with
  | C a => simp
  | add q r hq hr => rw [map_add, map_add, hq, hr]
  | mul_X q j hq =>
      have hj : ((Fin.castLE h j : Fin m) : ℕ) < t := j.isLt
      have hfin : (⟨((Fin.castLE h j : Fin m) : ℕ), hj⟩ : Fin t) = j := rfl
      rw [map_mul, map_mul, rename_X, aeval_X, dite_eq_left hj, hfin, hq]

open MvPolynomial in
/-- Every polynomial in `m` variables is congruent, modulo the ideal generated by the variables
`X i` with `t ≤ i`, to the polynomial obtained by substituting `0` for those variables, which
lies in the image of the polynomial ring in the first `t` variables. -/
private theorem sub_rename_aeval_mem_span {k : Type*} [CommRing k] {t m : ℕ} (h : t ≤ m)
    (f : MvPolynomial (Fin m) k) :
    f - MvPolynomial.rename (Fin.castLE h)
          (MvPolynomial.aeval
            (fun i : Fin m => if hi : (i : ℕ) < t then MvPolynomial.X (⟨i, hi⟩ : Fin t) else 0) f)
      ∈ Ideal.span (Set.range fun j : {i : Fin m // t ≤ (i : ℕ)} =>
          (MvPolynomial.X (j : Fin m) : MvPolynomial (Fin m) k)) := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add q r hq hr =>
      simp only [map_add]
      rw [← sub_add_sub_comm]
      exact Ideal.add_mem _ hq hr
  | mul_X q j hq =>
      by_cases hj : (j : ℕ) < t
      · have hcast : Fin.castLE h ⟨(j : ℕ), hj⟩ = j := rfl
        rw [map_mul, aeval_X, dite_eq_left hj, map_mul, rename_X, hcast, ← sub_mul]
        exact Ideal.mul_mem_right _ _ hq
      · rw [map_mul, aeval_X, dite_eq_right hj, mul_zero, map_zero, sub_zero]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨j, not_lt.mp hj⟩, rfl⟩)

/-- A finite-dimensional vector space spanned by the image of a family has a basis, indexed by
`Fin t`, each of whose members is a value of the family. -/
theorem exists_basis_fin_range {K V ι : Type*} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (v : ι → V) (hs : Submodule.span K (Set.range v) = ⊤) :
    ∃ (t : ℕ) (b : Module.Basis (Fin t) K V) (w : Fin t → ι), ∀ i, b i = v (w i) := by
  classical
  obtain ⟨s, hss, hspan, hli⟩ := exists_linearIndependent K (Set.range v)
  have hfin : s.Finite := hli.setFinite
  have : Fintype s := hfin.fintype
  let B : Module.Basis s K V := Module.Basis.mk hli (by rw [Subtype.range_coe, hspan, hs])
  have hmem : ∀ i : Fin (Fintype.card s), (B.reindex (Fintype.equivFin s)) i ∈ Set.range v := by
    intro i
    simpa [B] using hss ((Fintype.equivFin s).symm i).2
  choose w hw using hmem
  exact ⟨Fintype.card s, B.reindex (Fintype.equivFin s), w, fun i => (hw i).symm⟩

/-- If a field extension `K/k` is generated by a set `U`, then `Ω[K⁄k]` is spanned over `K` by
the differentials of the elements of `U`. -/
private theorem span_image_derivation_eq_top {k K : Type*} [Field k] [Field K] [Algebra k K]
    (U : Set K) (hU : IntermediateField.adjoin k U = ⊤) :
    Submodule.span K ((KaehlerDifferential.D k K) '' U) = ⊤ := by
  set V : Submodule K (Ω[K⁄k]) := Submodule.span K ((KaehlerDifferential.D k K) '' U)
  have hUV : ∀ x ∈ U, KaehlerDifferential.D k K x ∈ V := fun x hx =>
    Submodule.subset_span ⟨x, hx, rfl⟩
  let G : IntermediateField k K :=
    { carrier := {x : K | KaehlerDifferential.D k K x ∈ V}
      zero_mem' := by simp only [Set.mem_ofPred_eq, map_zero]; exact V.zero_mem
      one_mem' := by
        simp only [Set.mem_ofPred_eq, Derivation.map_one_eq_zero]; exact V.zero_mem
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq, map_add] at *
        exact V.add_mem ha hb
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq, Derivation.leibniz] at *
        exact V.add_mem (V.smul_mem _ hb) (V.smul_mem _ ha)
      algebraMap_mem' := by
        intro r
        simp only [Set.mem_ofPred_eq, Derivation.map_algebraMap]
        exact V.zero_mem
      inv_mem' := by
        intro a ha
        simp only [Set.mem_ofPred_eq, Derivation.leibniz_inv] at *
        exact V.smul_mem _ ha }
  have hle : IntermediateField.adjoin k U ≤ G := IntermediateField.adjoin_le_iff.mpr hUV
  rw [hU] at hle
  have hall : ∀ x : K, KaehlerDifferential.D k K x ∈ V := fun x =>
    hle (show x ∈ (⊤ : IntermediateField k K) from trivial)
  refine top_unique ?_
  rw [← KaehlerDifferential.span_range_derivation]
  exact Submodule.span_le.mpr (Set.range_subset_iff.mpr hall)

/-- If an intermediate field `G` of `K/k` is generated over `k` by a subset `U ⊆ G`, then
`Ω[G⁄k]` is spanned over `G` by the differentials of the elements of `U`. -/
theorem span_derivation_eq_top_of_adjoin_eq {k K : Type*} [Field k] [Field K]
    [Algebra k K] (G : IntermediateField k K) (U : Set K) (hUG : U ⊆ (G : Set K))
    (hU : IntermediateField.adjoin k U = G) :
    Submodule.span G (Set.range fun u : U => KaehlerDifferential.D k G ⟨(u : K), hUG u.2⟩) = ⊤ := by
  set U' : Set G := {x : G | (x : K) ∈ U}
  have himage : (Subtype.val : G → K) '' U' = U := by
    ext y
    exact ⟨fun ⟨x, hx, hxy⟩ => hxy ▸ hx, fun hy => ⟨⟨y, hUG hy⟩, hy, rfl⟩⟩
  have htop : IntermediateField.adjoin k U' = ⊤ := by
    refine IntermediateField.lift_injective G ?_
    rw [IntermediateField.lift_adjoin, himage, hU, IntermediateField.lift_top]
  have hspan := span_image_derivation_eq_top (k := k) (K := G) U' htop
  have hset : (KaehlerDifferential.D k G) '' U' =
      Set.range fun u : U => KaehlerDifferential.D k G ⟨(u : K), hUG u.2⟩ := by
    ext y
    exact ⟨fun ⟨x, hx, hxy⟩ => ⟨⟨(x : K), hx⟩, hxy⟩, fun ⟨u, hu⟩ => ⟨⟨(u : K), hUG u.2⟩, u.2, hu⟩⟩
  rwa [hset] at hspan

/-- A finitely generated field extension whose module of Kähler differentials vanishes is finite
and separable. -/
@[ega "0 20.6.20" "(ii)"]
theorem finite_and_isSeparable_of_subsingleton_kaehlerDifferential (K F : Type*) [Field K]
    [Field F] [Algebra K F] [Algebra.EssFiniteType K F] (h : Subsingleton (Ω[F⁄K])) :
    Module.Finite K F ∧ Algebra.IsSeparable K F :=
  have hu : Algebra.FormallyUnramified K F := ⟨h⟩
  ⟨Algebra.FormallyUnramified.finite_of_free K F,
    (Algebra.FormallyUnramified.iff_isSeparable K F).mp hu⟩

/-- A quotient of a local ring by an ideal equal to a power of the maximal ideal is local. -/
theorem isLocalRing_quotient_of_eq_pow {R : Type*} [CommRing R] [IsLocalRing R] {n : ℕ}
    (hn : 1 ≤ n) {I : Ideal R} (hI : I = maximalIdeal R ^ n) : IsLocalRing (R ⧸ I) := by
  subst hI
  have hne : maximalIdeal R ^ n ≠ ⊤ := fun h =>
    (maximalIdeal.isMaximal R).ne_top <| top_le_iff.mp <| h.ge.trans (Ideal.pow_le_self (by omega))
  have : Nontrivial (R ⧸ maximalIdeal R ^ n) := Ideal.Quotient.nontrivial_iff.mpr hne
  exact IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective

/-- The maximal ideal of such a quotient is the image of the maximal ideal. -/
theorem maximalIdeal_quotient_of_eq_pow {R : Type*} [CommRing R] [IsLocalRing R]
    {I : Ideal R} [IsLocalRing (R ⧸ I)] :
    maximalIdeal (R ⧸ I) = (maximalIdeal R).map (Ideal.Quotient.mk I) :=
  (IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm

/-- The maximal ideal of such a quotient has vanishing `n`-th power. -/
theorem maximalIdeal_quotient_pow_eq_bot {R : Type*} [CommRing R] [IsLocalRing R] {n : ℕ}
    {I : Ideal R} (hI : I = maximalIdeal R ^ n) [IsLocalRing (R ⧸ I)] :
    maximalIdeal (R ⧸ I) ^ n = ⊥ := by
  rw [maximalIdeal_quotient_of_eq_pow, ← Ideal.map_pow, ← hI, Ideal.map_quotient_self]

/-- Such a quotient of a Noetherian local ring is Artinian. -/
theorem isArtinianRing_quotient_of_eq_pow {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] {n : ℕ} {I : Ideal R} (hI : I = maximalIdeal R ^ n) [IsLocalRing (R ⧸ I)] :
    IsArtinianRing (R ⧸ I) :=
  (isArtinianRing_iff_isNilpotent_maximalIdeal _).mpr
    ⟨n, by rw [Ideal.zero_eq_bot]; exact maximalIdeal_quotient_pow_eq_bot hI⟩



/-- The variables of `k[y_1, …, y_{t+r}]` with index `≥ t` are exactly the `X (Fin.natAdd t j)`. -/
private theorem range_natAdd (k : Type*) [CommRing k] (t r : ℕ) :
    (Set.range fun j : Fin r => (MvPolynomial.X (Fin.natAdd t j) : MvPolynomial (Fin (t + r)) k))
      = Set.range fun j : {i : Fin (t + r) // t ≤ (i : ℕ)} =>
          (MvPolynomial.X (j : Fin (t + r)) : MvPolynomial (Fin (t + r)) k) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨j, rfl⟩
    exact ⟨⟨Fin.natAdd t j, by simp⟩, rfl⟩
  · rintro _ ⟨⟨i, hi⟩, rfl⟩
    have hlt : (i : ℕ) < t + r := i.isLt
    refine ⟨⟨(i : ℕ) - t, by omega⟩, ?_⟩
    have he : Fin.natAdd t (⟨(i : ℕ) - t, by omega⟩ : Fin r) = i := by
      apply Fin.ext
      simp only [Fin.natAdd_mk]
      omega
    exact congrArg MvPolynomial.X he

/-- Let `φ : k[y_1, …, y_{t+r}] → R` be a ring map sending the last `r` variables into a prime
`𝔮` of `R`, and let `ι : k[y_1, …, y_t] → k[y_1, …, y_{t+r}]` be the inclusion renaming the
variables. Then the contraction of `𝔮` along `φ` is generated by the contraction along `φ ∘ ι`
together with the last `r` variables. -/
theorem comap_eq_sup_span {k R : Type*} [CommRing k] [CommRing R] {t r : ℕ}
    (φ : MvPolynomial (Fin (t + r)) k →+* R) (𝔮 : Ideal R)
    (hX : ∀ j : Fin r, φ (MvPolynomial.X (Fin.natAdd t j)) ∈ 𝔮) :
    Ideal.comap φ 𝔮 =
      Ideal.map
          ((MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) :
            MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
            MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)
          (Ideal.comap (φ.comp
            ((MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) :
              MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
              MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)) 𝔮)
        ⊔ Ideal.span (Set.range fun j : Fin r =>
            (MvPolynomial.X (Fin.natAdd t j) : MvPolynomial (Fin (t + r)) k)) := by
  have hS : Ideal.span (Set.range fun j : Fin r =>
      (MvPolynomial.X (Fin.natAdd t j) : MvPolynomial (Fin (t + r)) k)) ≤ Ideal.comap φ 𝔮 := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact hX j
  apply le_antisymm
  · intro f hf
    set g : MvPolynomial (Fin t) k := MvPolynomial.aeval
      (fun i : Fin (t + r) => if hi : (i : ℕ) < t then MvPolynomial.X (⟨i, hi⟩ : Fin t) else 0) f
    have hmem : f - MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) g
        ∈ Ideal.span (Set.range fun j : Fin r =>
          (MvPolynomial.X (Fin.natAdd t j) : MvPolynomial (Fin (t + r)) k)) := by
      rw [range_natAdd]
      exact sub_rename_aeval_mem_span (Nat.le_add_right t r) f
    have h1 : φ f - φ (f - MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) g) ∈ 𝔮 :=
      Ideal.sub_mem _ hf (hS hmem)
    have h2 : φ (MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) g) ∈ 𝔮 := by
      rwa [map_sub, sub_sub_cancel] at h1
    have h3 : MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) g
        ∈ Ideal.map
          ((MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) :
            MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
            MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)
          (Ideal.comap (φ.comp
            ((MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) :
              MvPolynomial (Fin t) k →ₐ[k] MvPolynomial (Fin (t + r)) k) :
              MvPolynomial (Fin t) k →+* MvPolynomial (Fin (t + r)) k)) 𝔮) :=
      Ideal.mem_map_of_mem _ h2
    have hsplit : f = (f - MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) g)
        + MvPolynomial.rename (Fin.castLE (Nat.le_add_right t r)) g := by ring
    rw [hsplit]
    exact Ideal.add_mem _ (Ideal.mem_sup_right hmem) (Ideal.mem_sup_left h3)
  · refine sup_le ?_ hS
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact hx

/-! ### Dimension theory used in the proof of Stacks 07FH -/

/-- **The dimension formula for a flat local homomorphism.** For a flat local homomorphism of
Noetherian local rings the dimension of the target is the dimension of the source plus the
dimension of the fibre. -/
@[ega "IV 17.5.8" "more general", ega "IV 6.1.2"]
private theorem ringKrullDim_eq_add_of_flat {R S : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] [CommRing S] [IsNoetherianRing S] [IsLocalRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)] [Module.Flat R S] :
    ringKrullDim S = ringKrullDim R +
      ringKrullDim (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R)) := by
  have hlies : (maximalIdeal S).LiesOver (maximalIdeal R) :=
    ⟨(maximalIdeal_comap (algebraMap R S)).symm⟩
  have hnt : Nontrivial (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R)) :=
    Ideal.Quotient.nontrivial_iff.mpr (map_maximalIdeal_lt_top (algebraMap R S)).ne
  have hloc : IsLocalRing (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R)) :=
    .of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have key := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (maximalIdeal R) (maximalIdeal S)
  rw [map_maximalIdeal_of_surjective (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective] at key
  rw [← maximalIdeal_height_eq_ringKrullDim (R := S),
    ← maximalIdeal_height_eq_ringKrullDim (R := R),
    ← maximalIdeal_height_eq_ringKrullDim (R := S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R))]
  exact_mod_cast key

/-- If the maximal ideal of a Noetherian local ring `S` lies over a prime `𝔭` of a Noetherian
ring `R` and `𝔭 S` is that maximal ideal, then `dim S ≤ height 𝔭`. -/
theorem ringKrullDim_le_height {R S : Type*} [CommRing R] [IsNoetherianRing R]
    [CommRing S] [IsNoetherianRing S] [IsLocalRing S] [Algebra R S] (𝔭 : Ideal R) [𝔭.IsPrime]
    [(maximalIdeal S).LiesOver 𝔭] (h : Ideal.map (algebraMap R S) 𝔭 = maximalIdeal S) :
    ringKrullDim S ≤ ((𝔭.height : ℕ∞) : WithBot ℕ∞) := by
  have key := Ideal.height_le_height_add_of_liesOver 𝔭 (maximalIdeal S)
  rw [h, Ideal.map_quotient_self, Ideal.height_bot, add_zero] at key
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
  exact_mod_cast key

/-- If a prime `𝔭` of `S` lies over a prime `𝔭'` of `R` and the image of `𝔭` in `S ⧸ 𝔭' S` is
generated by `r` elements, then `height 𝔭 ≤ height 𝔭' + r`. -/
private theorem height_le_add_of_span {R S : Type*} [CommRing R] [IsNoetherianRing R]
    [CommRing S] [IsNoetherianRing S] [Algebra R S] (𝔭' : Ideal R) [𝔭'.IsPrime] (𝔭 : Ideal S)
    [𝔭.IsPrime] [𝔭.LiesOver 𝔭'] {r : ℕ} (s : Finset S) (hcard : s.card ≤ r)
    (hspan : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) 𝔭')) 𝔭
      = Ideal.span ((Ideal.Quotient.mk (Ideal.map (algebraMap R S) 𝔭')) '' (s : Set S))) :
    𝔭.height ≤ 𝔭'.height + r := by
  have hle : Ideal.map (algebraMap R S) 𝔭' ≤ 𝔭 :=
    Ideal.map_le_iff_le_comap.mpr (Ideal.over_def 𝔭 𝔭').le
  have hp : (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) 𝔭')) 𝔭).IsPrime :=
    Ideal.isPrime_map_quotientMk_of_isPrime hle
  have hfin :
      (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) 𝔭')) 𝔭).spanFinrank ≤ r := by
    rw [hspan]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (s.finite_toSet.image _)).trans ?_
    exact (Set.ncard_image_le s.finite_toSet).trans (by simpa using hcard)
  have hmain : (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) 𝔭')) 𝔭).height ≤ r :=
    (Ideal.height_le_spanFinrank _ hp.ne_top).trans (by exact_mod_cast hfin)
  exact (Ideal.height_le_height_add_of_liesOver 𝔭' 𝔭).trans (by gcongr)

/-- Two ideals sandwiching a third, `I ≤ J ≤ J'`, are equal as soon as `J` and `J'` have the
same image in `R ⧸ I`: taking preimages along `R → R ⧸ I` recovers `J` from its image, since `J`
already contains the kernel `I`. -/
private theorem ideal_eq_of_map_mk_eq {R : Type*} [CommRing R] {I J J' : Ideal R} (hIJ : I ≤ J)
    (hJK : J ≤ J') (h : Ideal.map (Ideal.Quotient.mk I) J = Ideal.map (Ideal.Quotient.mk I) J') :
    J = J' := by
  refine le_antisymm hJK ?_
  have h1 : Ideal.comap (Ideal.Quotient.mk I) (Ideal.map (Ideal.Quotient.mk I) J) = J := by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, sup_eq_left.mpr hIJ]
  rw [← h1, h]
  exact Ideal.le_comap_map

/-- If `A` is the localization of `P` at `𝔭 = (P → L)⁻¹(𝔪_L)`, sitting inside the local ring `L`,
then the maximal ideal of `A` and the prime `𝔭` generate the same ideal of `L`. -/
theorem map_maximalIdeal_localization {L P A : Type*} [CommRing L] [IsLocalRing L]
    [CommRing P] [Algebra P L] [CommRing A] [IsLocalRing A] [Algebra P A] [Algebra A L]
    [IsScalarTower P A L]
    [IsLocalization.AtPrime A (Ideal.comap (algebraMap P L) (maximalIdeal L))] :
    Ideal.map (algebraMap A L) (maximalIdeal A)
      = Ideal.map (algebraMap P L) (Ideal.comap (algebraMap P L) (maximalIdeal L)) := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal
    (Ideal.comap (algebraMap P L) (maximalIdeal L)) A, Ideal.map_map,
    ← IsScalarTower.algebraMap_eq P A L]

/-- If `A` is the localization of `P` at `𝔭 = (P → L)⁻¹(𝔪_L)`, sitting inside the local ring `L`,
then `A → L` is a homomorphism of local rings. -/
theorem isLocalHom_localization {L P A : Type*} [CommRing L] [IsLocalRing L]
    [CommRing P] [Algebra P L] [CommRing A] [IsLocalRing A] [Algebra P A] [Algebra A L]
    [IsScalarTower P A L]
    [IsLocalization.AtPrime A (Ideal.comap (algebraMap P L) (maximalIdeal L))] :
    IsLocalHom (algebraMap A L) :=
  ((local_hom_TFAE (algebraMap A L)).out 3 1 rfl rfl).mp (by
    rw [map_maximalIdeal_localization (P := P)]
    exact Ideal.map_le_iff_le_comap.mpr le_rfl)

/-- **The flatness step in the proof of Stacks 07FH.** Let `L` be a regular local Noetherian
ring, let `P' → P → L` be a tower of Noetherian rings, let `𝔭 = (P → L)⁻¹(𝔪_L)` and
`𝔭' = (P' → L)⁻¹(𝔪_L)`, and suppose `𝔭` is generated by `𝔭' P` together with `r` elements
`x 1, …, x r` of `P` whose images generate the maximal ideal of the fibre `C = L / 𝔭' L`, which
has dimension `r`. If `L` is flat over the localization `A₀` of `P'` at `𝔭'`, then `𝔭 L = 𝔪_L`
and `L` is flat over the localization `A` of `P` at `𝔭`.

This is the step the source performs when it enlarges `k[y_1, …, y_t]` to `k[y_1, …, y_m]` by
adjoining a regular system of parameters of the fibre: Lemma [stacks, 07E6] gives flatness only
over the smaller polynomial ring, and flatness over the larger one is recovered here from the
dimension formula for a flat local homomorphism, Krull's height theorem and miracle flatness
(Lemma [stacks, 00R4]). -/
theorem map_eq_and_flat_of_fibre {L P' P A₀ A : Type*} [CommRing L]
    [IsRegularLocalRing L] [CommRing P'] [IsNoetherianRing P'] [CommRing P] [IsNoetherianRing P]
    [Algebra P' P] [Algebra P L] [Algebra P' L] [IsScalarTower P' P L]
    [CommRing A₀] [Algebra P' A₀] [Algebra A₀ L] [IsScalarTower P' A₀ L]
    [CommRing A] [Algebra P A] [Algebra A L] [IsScalarTower P A L]
    [IsLocalization.AtPrime A₀ (Ideal.comap (algebraMap P' L) (maximalIdeal L))]
    [IsLocalization.AtPrime A (Ideal.comap (algebraMap P L) (maximalIdeal L))]
    [IsRegularLocalRing A] [Module.Flat A₀ L] {r : ℕ} (x : Fin r → P)
    (hdecomp : Ideal.comap (algebraMap P L) (maximalIdeal L)
      = Ideal.map (algebraMap P' P) (Ideal.comap (algebraMap P' L) (maximalIdeal L))
        ⊔ Ideal.span (Set.range x))
    (hgen : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap P' L)
          (Ideal.comap (algebraMap P' L) (maximalIdeal L)))) (maximalIdeal L)
      = Ideal.span (Set.range fun j : Fin r => Ideal.Quotient.mk
          (Ideal.map (algebraMap P' L) (Ideal.comap (algebraMap P' L) (maximalIdeal L)))
          (algebraMap P L (x j))))
    (hdim : ringKrullDim (L ⧸ Ideal.map (algebraMap P' L)
      (Ideal.comap (algebraMap P' L) (maximalIdeal L))) = (r : WithBot ℕ∞)) :
    Ideal.map (algebraMap P L) (Ideal.comap (algebraMap P L) (maximalIdeal L)) = maximalIdeal L
      ∧ Module.Flat A L := by
  classical
  have i0 : IsLocalRing A₀ :=
    IsLocalization.AtPrime.isLocalRing A₀ (Ideal.comap (algebraMap P' L) (maximalIdeal L))
  have i1 : IsNoetherianRing A₀ :=
    IsLocalization.isNoetherianRing
      (Ideal.comap (algebraMap P' L) (maximalIdeal L)).primeCompl A₀ inferInstance
  have i2 : IsLocalHom (algebraMap A₀ L) := isLocalHom_localization (P := P')
  have i3 : IsLocalHom (algebraMap A L) := isLocalHom_localization (P := P)
  have hovL : (maximalIdeal L).LiesOver (Ideal.comap (algebraMap P L) (maximalIdeal L)) := ⟨rfl⟩
  have hovP : (Ideal.comap (algebraMap P L) (maximalIdeal L)).LiesOver
      (Ideal.comap (algebraMap P' L) (maximalIdeal L)) :=
    ⟨by rw [Ideal.under_def, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq P' P L]⟩
  -- the ideal `𝔭 L` is `𝔭' L` together with the images of the `x j`
  have hJ : Ideal.map (algebraMap P L) (Ideal.comap (algebraMap P L) (maximalIdeal L))
      = Ideal.map (algebraMap P' L) (Ideal.comap (algebraMap P' L) (maximalIdeal L))
        ⊔ Ideal.span (Set.range fun j : Fin r => algebraMap P L (x j)) := by
    rw [hdecomp, Ideal.map_sup, Ideal.map_map, ← IsScalarTower.algebraMap_eq P' P L,
      Ideal.map_span, ← Set.range_comp]
    rfl
  -- `𝔭 L = 𝔪_L`, since the two agree modulo `𝔭' L` and `𝔭' L ≤ 𝔭 L ≤ 𝔪_L`
  have hmap : Ideal.map (algebraMap P L) (Ideal.comap (algebraMap P L) (maximalIdeal L))
      = maximalIdeal L := by
    refine ideal_eq_of_map_mk_eq
      (I := Ideal.map (algebraMap P' L) (Ideal.comap (algebraMap P' L) (maximalIdeal L)))
      (hJ ▸ le_sup_left) (Ideal.map_le_iff_le_comap.mpr le_rfl) ?_
    rw [hJ, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span, ← Set.range_comp,
      hgen]
    rfl
  refine ⟨hmap, ?_⟩
  -- `dim L = height 𝔭' + r`, by flatness of `A₀ → L` and the dimension of the fibre
  have hdimL : ringKrullDim L
      = ((Ideal.comap (algebraMap P' L) (maximalIdeal L)).height : WithBot ℕ∞)
        + (r : WithBot ℕ∞) := by
    have h := ringKrullDim_eq_add_of_flat (R := A₀) (S := L)
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height
        (Ideal.comap (algebraMap P' L) (maximalIdeal L)) A₀,
      map_maximalIdeal_localization (P := P') (A := A₀), hdim] at h
    exact h
  -- `height 𝔭 ≤ height 𝔭' + r`, as `𝔭` needs only `r` generators over `𝔭' P`
  have hheight : (Ideal.comap (algebraMap P L) (maximalIdeal L)).height
      ≤ (Ideal.comap (algebraMap P' L) (maximalIdeal L)).height + r := by
    refine height_le_add_of_span (Ideal.comap (algebraMap P' L) (maximalIdeal L))
      (Ideal.comap (algebraMap P L) (maximalIdeal L)) (Finset.image x Finset.univ)
      (Finset.card_image_le.trans (le_of_eq (Finset.card_fin r))) ?_
    rw [hdecomp, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_span,
      Finset.coe_image, Finset.coe_univ, Set.image_univ]
  -- `dim L ≤ height 𝔭 ≤ height 𝔭' + r = dim L`, so `dim L = dim A`
  have hAeq : ringKrullDim L = ringKrullDim A := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height
      (Ideal.comap (algebraMap P L) (maximalIdeal L)) A]
    refine le_antisymm (ringKrullDim_le_height _ hmap) ?_
    rw [hdimL]
    exact_mod_cast hheight
  -- miracle flatness: `A` is regular, `L` is Cohen-Macaulay and the fibre is a field
  refine Module.Flat.of_isMaximalCohenMacaulay_of_ringKrullDim_eq_add
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay L).2
    ?_
  have hres : ringKrullDim (L ⧸ maximalIdeal L) = 0 :=
    ringKrullDim_eq_zero_of_field (IsLocalRing.ResidueField L)
  rw [map_maximalIdeal_localization (P := P) (A := A), hmap, ← hAeq, hres, add_zero]

/-- **The étale step in the proof of Stacks 07FH.** A local ring which is finite and flat over a
Noetherian local ring, with `𝔪_R D = 𝔪_D` and with finite separable residue field extension, is
essentially smooth over that ring.

The source concludes étaleness from Lemma [stacks, 00U6] and then reads essential smoothness off
it. Lemma 00U6 produces `Algebra.IsEtaleAt R 𝔪_D`, a statement about the localization of `D` at
its own maximal ideal; `RingHom.IsEssentiallySmooth.comp_ringEquiv` carries the conclusion back to
`D` itself. -/
theorem isEssentiallySmooth_of_finite_flat {R D : Type u} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [CommRing D] [IsLocalRing D] [Algebra R D]
    [Module.Finite R D] [Module.Flat R D]
    [Algebra (ResidueField R) (ResidueField D)]
    [Algebra.IsSeparable (ResidueField R) (ResidueField D)]
    (hcompat : ∀ x : R, algebraMap (ResidueField R) (ResidueField D) (residue R x)
      = residue D (algebraMap R D x))
    (hmax : Ideal.map (algebraMap R D) (maximalIdeal R) = maximalIdeal D) :
    (algebraMap R D).IsEssentiallySmooth := by
  have hlies : (maximalIdeal D).LiesOver (maximalIdeal R) := by
    have hlocal : IsLocalHom (algebraMap R D) :=
      ((local_hom_TFAE (algebraMap R D)).out 3 1 rfl rfl).mp hmax.le
    exact ⟨(maximalIdeal_comap (algebraMap R D)).symm⟩
  have hfp : Algebra.FinitePresentation R D :=
    Algebra.FinitePresentation.of_finiteType.mp (Module.Finite.finiteType D)
  let eR : R ≃ₐ[R] Localization.AtPrime (maximalIdeal R) :=
    IsLocalization.atUnits R (maximalIdeal R).primeCompl
      (fun x hx => (IsUnit.mem_submonoid_iff x).mpr (notMem_maximalIdeal.mp hx))
  let eD : D ≃ₐ[D] Localization.AtPrime (maximalIdeal D) :=
    IsLocalization.atUnits D (maximalIdeal D).primeCompl
      (fun x hx => (IsUnit.mem_submonoid_iff x).mpr (notMem_maximalIdeal.mp hx))
  have hbijR : Function.Bijective
      (algebraMap R (Localization.AtPrime (maximalIdeal R))) := eR.bijective
  have hbijD : Function.Bijective
      (algebraMap D (Localization.AtPrime (maximalIdeal D))) := eD.bijective
  let := Localization.AtPrime.algebraOfLiesOver (maximalIdeal R) (maximalIdeal D)
  have hsq : (Localization.localRingHom (maximalIdeal R) (maximalIdeal D) (algebraMap R D)
        Ideal.LiesOver.over).comp (algebraMap R (Localization.AtPrime (maximalIdeal R)))
      = (algebraMap D (Localization.AtPrime (maximalIdeal D))).comp (algebraMap R D) :=
    RingHom.ext fun x => Localization.localRingHom_to_map (maximalIdeal R) (maximalIdeal D)
      (algebraMap R D) Ideal.LiesOver.over x
  have hflat : Module.Flat (Localization.AtPrime (maximalIdeal R))
      (Localization.AtPrime (maximalIdeal D)) := by
    rw [← RingHom.flat_algebraMap_iff,
      Localization.AtPrime.algebraMap_eq (maximalIdeal R) (maximalIdeal D),
      ← RingHom.Flat.comp_iff_of_bijective_right hbijR, hsq,
      RingHom.Flat.comp_iff_of_bijective_left hbijD, RingHom.flat_algebraMap_iff]
    infer_instance
  have hfin : Module.Finite (maximalIdeal R).ResidueField
      (maximalIdeal D).ResidueField := by infer_instance
  have halgeq : (Ideal.Quotient.algebraOfLiesOver (maximalIdeal D) (maximalIdeal R) :
      Algebra (ResidueField R) (ResidueField D))
      = ‹Algebra (ResidueField R) (ResidueField D)› :=
    Algebra.algebra_ext _ _ fun r => by
      obtain ⟨y, rfl⟩ := residue_surjective r
      exact (hcompat y).symm
  have hsepcanon : @Algebra.IsSeparable (ResidueField R) (ResidueField D) _ _
      (Ideal.Quotient.algebraOfLiesOver (maximalIdeal D) (maximalIdeal R)) :=
    halgeq ▸ ‹Algebra.IsSeparable (ResidueField R) (ResidueField D)›
  have hsep : Algebra.IsSeparable (maximalIdeal R).ResidueField
      (maximalIdeal D).ResidueField := Algebra.isSeparable_residueField_iff.mpr hsepcanon
  have hmapeq : Ideal.map (algebraMap R (Localization.AtPrime (maximalIdeal D)))
      (maximalIdeal R) = maximalIdeal (Localization.AtPrime (maximalIdeal D)) := by
    rw [IsScalarTower.algebraMap_eq R D (Localization.AtPrime (maximalIdeal D)),
      ← Ideal.map_map, hmax]
    exact IsLocalization.AtPrime.map_eq_maximalIdeal (maximalIdeal D) _
  have hetale : Algebra.IsEtaleAt R (maximalIdeal D) :=
    Algebra.IsEtaleAt.of_flat_of_map_eq_maximalIdeal (maximalIdeal R) (maximalIdeal D) hmapeq
  have hcomp := (RingHom.IsEssentiallySmooth.of_isEtaleAt (R := R) (S := D)
    (maximalIdeal D)).comp_ringEquiv eD.symm.toRingEquiv
  have hrw : ((eD.symm.toRingEquiv : Localization.AtPrime (maximalIdeal D) →+* D).comp
      (algebraMap R (Localization.AtPrime (maximalIdeal D)))) = algebraMap R D := by
    refine RingHom.ext fun x => ?_
    simpa [eD] using
      congrArg eD.symm (IsScalarTower.algebraMap_apply R D
        (Localization.AtPrime (maximalIdeal D)) x)
  rwa [hrw] at hcomp

/-! ### Stacks 07FH -/

universe v

/-- The Artinian local ring `Λ_𝔮/𝔮^n Λ_𝔮` attached to a prime `𝔮` of a ring and an exponent `n`:
the quotient of the localization of `Λ` at `𝔮` by the ideal generated by `𝔮^n`. -/
abbrev primePowerQuotient {Λ : Type*} [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime] (n : ℕ) : Type _ :=
  Localization.AtPrime 𝔮 ⧸ Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n)

/-- The ideal `𝔮^n Λ_𝔮` is the `n`-th power of the maximal ideal of `Λ_𝔮`. -/
theorem map_pow_eq_maximalIdeal_pow {Λ : Type*} [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime]
    (n : ℕ) : Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n)
      = maximalIdeal (Localization.AtPrime 𝔮) ^ n := by
  rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]

/-- `Λ_𝔮/𝔮^n Λ_𝔮` is a local ring. -/
theorem isLocalRing_primePowerQuotient {Λ : Type*} [CommRing Λ] (𝔮 : Ideal Λ) [𝔮.IsPrime]
    {n : ℕ} (hn : 1 ≤ n) : IsLocalRing (primePowerQuotient 𝔮 n) :=
  isLocalRing_quotient_of_eq_pow hn (map_pow_eq_maximalIdeal_pow 𝔮 n)

/-- `Λ_𝔮/𝔮^n Λ_𝔮` is an Artinian ring when `Λ` is Noetherian. -/
theorem isArtinianRing_primePowerQuotient {Λ : Type*} [CommRing Λ] [IsNoetherianRing Λ]
    (𝔮 : Ideal Λ) [𝔮.IsPrime] {n : ℕ} [IsLocalRing (primePowerQuotient 𝔮 n)] :
    IsArtinianRing (primePowerQuotient 𝔮 n) :=
  isArtinianRing_quotient_of_eq_pow (map_pow_eq_maximalIdeal_pow 𝔮 n)

/-- The maximal ideal of `Λ_𝔮/𝔮^n Λ_𝔮` is the image of the maximal ideal of `Λ_𝔮`. -/
theorem maximalIdeal_primePowerQuotient {Λ : Type*} [CommRing Λ] (𝔮 : Ideal Λ)
    [𝔮.IsPrime] {n : ℕ} [IsLocalRing (primePowerQuotient 𝔮 n)] :
    maximalIdeal (primePowerQuotient 𝔮 n) = (maximalIdeal (Localization.AtPrime 𝔮)).map
      (Ideal.Quotient.mk (Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n))) :=
  maximalIdeal_quotient_of_eq_pow

/-- The quotient map `Λ_𝔮 → Λ_𝔮/𝔮^n Λ_𝔮` is a homomorphism of local rings. -/
private theorem isLocalHom_mk_primePowerQuotient {Λ : Type*} [CommRing Λ] (𝔮 : Ideal Λ)
    [𝔮.IsPrime] {n : ℕ} [IsLocalRing (primePowerQuotient 𝔮 n)] :
    IsLocalHom
      (Ideal.Quotient.mk (Ideal.map (algebraMap Λ (Localization.AtPrime 𝔮)) (𝔮 ^ n))) :=
  IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective

/-! ### The coefficient field generated by residues: the input of Stacks 07FH -/

/-- Enlarging the family of generators of the maximal ideal enlarges the stage: a polynomial in
the first `d` variables is one in all `d + e` of them. -/
private lemma coefficientStage_le_append {k K Λ : Type*} [Field k] [Field K] [CommRing Λ]
    [Algebra k K] (σ : K →+* Λ) (F : IntermediateField k K) {d e : ℕ} (x : Fin d → Λ)
    (x' : Fin e → Λ) :
    coefficientStage σ F x ≤ coefficientStage σ F (Fin.append x x') := by
  rintro _ ⟨f, rfl⟩
  refine ⟨MvPolynomial.rename (Fin.castAdd e) f, ?_⟩
  simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename]
  rw [show Fin.append x x' ∘ Fin.castAdd e = x from funext (Fin.append_left x x')]

/-- If every element of `K` is a quotient of two elements of the image of `g : R → K`, then every
finite subset of `K` lies in the subfield generated over `k` by the images of finitely many
elements of `R`.

In other words, the subfields `k(g(Y))` for finite `Y ⊆ R` are cofinal among the finitely
generated subfields of `K` as soon as `K` is the fraction field of the image of `g`. This is what
makes the coefficient field of a stage choosable of that shape. -/
lemma exists_finset_mem_adjoin_image {k K R : Type*} [Field k] [Field K] [Algebra k K]
    [CommRing R] (g : R → K) (hfrac : ∀ c : K, ∃ a b : R, g b ≠ 0 ∧ c * g b = g a)
    (T : Finset K) :
    ∃ Y : Finset R, ∀ c ∈ T, c ∈ IntermediateField.adjoin k (g '' (Y : Set R)) := by
  classical
  induction T using Finset.induction with
  | empty => exact ⟨∅, by simp⟩
  | insert c T _ ih =>
    obtain ⟨Y, hY⟩ := ih
    obtain ⟨a, b, hb, hab⟩ := hfrac c
    refine ⟨insert a (insert b Y), fun z hz => ?_⟩
    have hsub : g '' (Y : Set R) ⊆ g '' ((insert a (insert b Y) : Finset R) : Set R) :=
      Set.image_mono (by
        simpa only [Finset.coe_insert] using
          (Set.subset_insert (b : R) _).trans (Set.subset_insert (a : R) _))
    rcases Finset.mem_insert.mp hz with rfl | hzT
    · have h1 : g a ∈ IntermediateField.adjoin k
          (g '' ((insert a (insert b Y) : Finset R) : Set R)) :=
        IntermediateField.subset_adjoin k _ ⟨a, by simp, rfl⟩
      have h2 : g b ∈ IntermediateField.adjoin k
          (g '' ((insert a (insert b Y) : Finset R) : Set R)) :=
        IntermediateField.subset_adjoin k _ ⟨b, by simp, rfl⟩
      rw [(eq_div_iff hb).mpr hab]
      exact div_mem h1 h2
    · exact IntermediateField.adjoin.mono k _ _ hsub (hY z hzT)

/-- The `Λ`-version of the central claim of Stacks 07FG: the coefficient field of a stage can be
taken to be generated by residues of elements of a ring mapping to `Λ`.

Let `k` be a field of characteristic `p > 0`, let `(Λ, 𝔪, K)` be an Artinian local `k`-algebra
with `dim_K H₁(L_{K/k}) < ∞`, let `q : R → Λ` be a ring map whose residues generate `K` as a
fraction field, and let `S` be a finite subset of `R`. Then there are a ring-theoretic section
`σ : K → Λ` of the residue map, generators `λ₁, …, λ_d` of `𝔪` and a finite `S ⊆ Y ⊆ R` such
that, for `F = k(q(y)‾ : y ∈ Y)`, the image of `k` in `Λ` and the elements `q(y)` for `y ∈ Y`
all lie in the stage `Ψ_σ(F[λ₁, …, λ_d])`, whose residues are exactly `F`.

The section and the base field come from `nonempty_coefficientSectionData_of_finite_h1Cotangent`;
the base field is pushed into one of the shape `k(q(Y)‾)` by `exists_finset_mem_adjoin_image`,
and `q(Y)` is put into the stage by adjoining the elements `q(y) - σ(q(y)‾)` of `𝔪` to the
generating family, which `coefficientStage_le_append` shows only enlarges the stage. -/
private theorem exists_coefficientStage_adjoin_residue_image {k Λ R : Type*} [Field k]
    [CommRing Λ] [Algebra k Λ] [IsArtinianRing Λ] [IsLocalRing Λ] [CommRing R] (p : ℕ)
    [Fact p.Prime] [CharP k p]
    [Module.Finite (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))]
    (q : R →+* Λ) (hfrac : ∀ c : ResidueField Λ, ∃ a b : R,
      residue Λ (q b) ≠ 0 ∧ c * residue Λ (q b) = residue Λ (q a)) (S : Finset R) :
    ∃ (Y : Finset R) (σ : ResidueField Λ →+* Λ) (d : ℕ) (x : Fin d → Λ)
      (F : IntermediateField k (ResidueField Λ)), S ⊆ Y ∧ (∀ c, residue Λ (σ c) = c) ∧
      Ideal.span (Set.range x) = maximalIdeal Λ ∧
      F = IntermediateField.adjoin k ((fun y => residue Λ (q y)) '' (Y : Set R)) ∧
      F.FG ∧ (∀ a : k, algebraMap k Λ a ∈ coefficientStage σ F x) ∧
      (∀ y ∈ Y, q y ∈ coefficientStage σ F x) ∧
      ∀ z ∈ coefficientStage σ F x, residue Λ z ∈ F := by
  classical
  obtain ⟨C⟩ := nonempty_coefficientSectionData_of_finite_h1Cotangent (k := k) (Λ := Λ) p
  obtain ⟨T, hT⟩ := C.base_fg
  obtain ⟨Y₀, hY₀⟩ := exists_finset_mem_adjoin_image (k := k)
    (fun y : R => residue Λ (q y)) hfrac T
  set Y : Finset R := S ∪ Y₀ with hYdef
  set F : IntermediateField k (ResidueField Λ) :=
    IntermediateField.adjoin k ((fun y => residue Λ (q y)) '' (Y : Set R)) with hFdef
  set w : ↥Y → Λ := fun y => q y - C.σ (residue Λ (q y)) with hwdef
  set x : Fin (C.numGen + Y.card) → Λ :=
    Fin.append C.gen (fun j => w (Y.equivFin.symm j)) with hxdef
  have hwm : ∀ y : ↥Y, w y ∈ maximalIdeal Λ := fun y => by
    rw [← residue_eq_zero_iff, hwdef]
    simp [C.residue_σ]
  have hgenm : ∀ i, C.gen i ∈ maximalIdeal Λ := fun i =>
    C.span_range_gen ▸ Ideal.subset_span (Set.mem_range_self i)
  have hxm : ∀ i, x i ∈ maximalIdeal Λ := by
    intro i
    induction i using Fin.addCases with
    | left j => rw [hxdef, Fin.append_left]; exact hgenm j
    | right j => rw [hxdef, Fin.append_right]; exact hwm _
  have hresY : ∀ y ∈ Y, residue Λ (q y) ∈ F :=
    fun y hy => IntermediateField.subset_adjoin k _ ⟨y, hy, rfl⟩
  have hbase : C.base ≤ F := by
    rw [← hT]
    refine IntermediateField.adjoin_le_iff.mpr fun c hc => ?_
    refine IntermediateField.adjoin.mono k _ _ ?_ (hY₀ c hc)
    exact Set.image_mono (by simpa only [hYdef, Finset.coe_union] using Set.subset_union_right)
  refine ⟨Y, C.σ, _, x, F, Finset.subset_union_left, C.residue_σ, ?_, rfl,
    IntermediateField.fg_def.mpr ⟨_, (Y.finite_toSet.image _), rfl⟩, fun a => ?_, fun y hy => ?_,
    fun z hz => residue_mem_of_mem_coefficientStage C.σ C.residue_σ x hxm F hz⟩
  · refine le_antisymm ?_ ?_
    · rw [Ideal.span_le]
      rintro z ⟨i, rfl⟩
      exact hxm i
    · rw [← C.span_range_gen, Ideal.span_le]
      rintro z ⟨i, rfl⟩
      exact Ideal.subset_span ⟨Fin.castAdd _ i, by rw [hxdef, Fin.append_left]⟩
  · exact coefficientStage_le_append C.σ F C.gen _
      (coefficientStage_mono C.σ C.gen hbase (C.range_algebraMap_mem a))
  · have h2 : C.σ (residue Λ (q y)) ∈ coefficientStage C.σ F x :=
      mem_coefficientStage_of_mem C.σ x F ⟨residue Λ (q y), hresY y hy⟩
    have h3 : w ⟨y, hy⟩ ∈ coefficientStage C.σ F x := by
      have he : x (Fin.natAdd C.numGen (Y.equivFin ⟨y, hy⟩)) = w ⟨y, hy⟩ := by
        rw [hxdef, Fin.append_right]
        simp
      rw [← he]
      exact mem_coefficientStage_gen C.σ x F _
    have hsum : q y = C.σ (residue Λ (q y)) + w ⟨y, hy⟩ := by rw [hwdef]; ring
    rw [hsum]
    exact Subring.add_mem _ h2 h3

/-- **The λ-choice of Stacks 07FH.** Let `k` be a field of characteristic `p > 0`, let
`(Λ, 𝔪, K)` be an Artinian local `k`-algebra with `dim_K H₁(L_{K/k}) < ∞`, let `q : R → Λ` be a
ring map whose residues generate `K` as a fraction field, and let `S` be a finite subset of `R`.
Then there are a ring-theoretic section `σ : K → Λ` of the residue map, generators
`λ₁, …, λ_d` of `𝔪`, a finite `S ⊆ Y ⊆ R` and elements `μ₁, …, μ_t` of `Y` such that, with
`A = Ψ_σ(F[λ₁, …, λ_d])` the stage of `F = k(q(y)‾ : y ∈ Y)`:

* `A` contains the image of `k` and the elements `q(y)` for `y ∈ Y`, in particular `q(S)`;
* the residues of the elements of `A` are exactly the elements of `F`;
* the differentials of the residues `q(μ₁)‾, …, q(μ_t)‾` form a basis of `Ω_{F/k}`.

This is the step of Stacks 07FH which the source performs without justification, and which is
false for a general member of the directed family of
`exists_directedOn_flat_essFiniteType_of_charP`; see the implementation notes. Only the
properties of the stage proved in `exists_coefficientStage_adjoin_residue_image` are asserted
here: flatness of `Λ` over this particular stage is not. -/
theorem exists_coefficientStage_basis_kaehlerDifferential {k Λ R : Type*} [Field k] [CommRing Λ]
    [Algebra k Λ] [IsArtinianRing Λ] [IsLocalRing Λ] [CommRing R] (p : ℕ) [Fact p.Prime]
    [CharP k p] [Module.Finite (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))]
    (q : R →+* Λ) (hfrac : ∀ c : ResidueField Λ, ∃ a b : R,
      residue Λ (q b) ≠ 0 ∧ c * residue Λ (q b) = residue Λ (q a)) (S : Finset R) :
    ∃ (Y : Finset R) (σ : ResidueField Λ →+* Λ) (d : ℕ) (x : Fin d → Λ)
      (F : IntermediateField k (ResidueField Λ)) (t : ℕ) (lam : Fin t → R)
      (hlam : ∀ j, residue Λ (q (lam j)) ∈ F),
      S ⊆ Y ∧ (∀ j, lam j ∈ Y) ∧ (∀ c, residue Λ (σ c) = c) ∧
      Ideal.span (Set.range x) = maximalIdeal Λ ∧
      F = IntermediateField.adjoin k ((fun y => residue Λ (q y)) '' (Y : Set R)) ∧ F.FG ∧
      (∀ a : k, algebraMap k Λ a ∈ coefficientStage σ F x) ∧
      (∀ y ∈ Y, q y ∈ coefficientStage σ F x) ∧
      (∀ z ∈ coefficientStage σ F x, residue Λ z ∈ F) ∧
      ∃ b : Module.Basis (Fin t) F (Ω[F⁄k]),
        ∀ j, b j = KaehlerDifferential.D k F ⟨residue Λ (q (lam j)), hlam j⟩ := by
  classical
  obtain ⟨Y, σ, d, x, F, hSY, hσ, hspan, hFeq, hFfg, hk, hqY, hres⟩ :=
    exists_coefficientStage_adjoin_residue_image (k := k) p q hfrac S
  have hUF : (fun y => residue Λ (q y)) '' (Y : Set R) ⊆ (F : Set (ResidueField Λ)) := by
    rintro _ ⟨y, hy, rfl⟩
    exact hres _ (hqY y hy)
  have hspanD := span_derivation_eq_top_of_adjoin_eq F _ hUF hFeq.symm
  have hfin : Finite ↥((fun y => residue Λ (q y)) '' (Y : Set R)) :=
    (Y.finite_toSet.image _).to_subtype
  have hfd : FiniteDimensional F (Ω[F⁄k]) :=
    Module.finite_def.mpr (hspanD ▸ Submodule.fg_span (Set.finite_range _))
  obtain ⟨t, b, wmap, hb⟩ := exists_basis_fin_range _ hspanD
  have hmem : ∀ j, ∃ y : R, y ∈ Y ∧ residue Λ (q y) = ((wmap j : ResidueField Λ)) := by
    intro j
    obtain ⟨y, hy, hyeq⟩ := (wmap j).2
    exact ⟨y, hy, hyeq⟩
  choose lam hlamY hlameq using hmem
  have hlam : ∀ j, residue Λ (q (lam j)) ∈ F := fun j => (hlameq j) ▸ hUF (wmap j).2
  refine ⟨Y, σ, d, x, F, t, lam, hlam, hSY, hlamY, hσ, hspan, hFeq, hFfg, hk, hqY, hres,
    b, fun j => ?_⟩
  rw [hb j]
  congr 1
  exact Subtype.ext (hlameq j).symm

end Stacks.Smoothing
