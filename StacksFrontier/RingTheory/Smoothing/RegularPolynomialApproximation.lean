namespace Stacks.Smoothing

open IntermediateField

/-! ### `p`-th roots descend along a separable extension -/

/-- Let `K/F` be a separable field extension of exponential characteristic `p`. If the `p`-th
power of `y ∈ K` lies in `F`, then `y` lies in `F`.

The `p`-th power criterion for separability (`Algebra.isSeparableExtension_tfae`, condition (2))
says that `p`-th powering preserves `F`-linear independence of subsets of `K`. If `y` were not in
`F` then `{1, y}` would be `F`-linearly independent while `{1, y^p}` is not, `y^p` being a scalar
multiple of `1`. -/
private theorem mem_range_of_pow_mem_range (F K : Type*) [Field F] [Field K] [Algebra F K]
    (p : ℕ) [ExpChar F p] [Algebra.IsSeparableExtension F K] {y : K}
    (hy : y ^ p ∈ Set.range (algebraMap F K)) : y ∈ Set.range (algebraMap F K) := by
  by_contra hny
  have hpow := ((Algebra.isSeparableExtension_tfae F K p).out 1 2).mp ‹_›
  have hne : (1 : K) ≠ y := fun h => hny ⟨1, by simp [h]⟩
  have hind : LinearIndepOn F _root_.id ({1, y} : Set K) := by
    rw [linearIndepOn_pair_iff _ hne one_ne_zero]
    intro c hc
    exact hny ⟨c, by simpa [Algebra.smul_def] using hc⟩
  have hdep := hpow _ hind
  rw [linearIndepOn_pair_iff _ hne (by simp)] at hdep
  obtain ⟨c, hc⟩ := hy
  exact hdep c (by simpa [Algebra.smul_def] using hc)

/-! ### The purely inseparable part of the base is forced into the subfield -/

/-- **The obstruction.** Let `k ⊆ F ⊆ K` be fields with `K` separable over `F`. Then every element
of `K` which is purely inseparable over `k` already lies in `F`; that is, the relative perfect
closure `k^{1/p^∞} ∩ K` of `k` in `K` is contained in `F`.

Iterating `mem_range_of_pow_mem_range` descends from `x ^ p ^ n ∈ F` to `x ∈ F`. No finiteness of
any kind is assumed of `F` or of `K`. -/
theorem perfectClosure_le_of_isSeparableExtension (k K : Type*) [Field k] [Field K] [Algebra k K]
    (p : ℕ) [ExpChar k p] (F : IntermediateField k K)
    [Algebra.IsSeparableExtension F K] : perfectClosure k K ≤ F := by
  have : ExpChar F p := expChar_of_injective_algebraMap (algebraMap k F).injective p
  have key : ∀ (n : ℕ) (x : K), x ^ p ^ n ∈ Set.range (algebraMap F K) →
      x ∈ Set.range (algebraMap F K) := by
    intro n
    induction n with
    | zero => intro x hx; simpa using hx
    | succ n ih =>
        intro x hx
        refine ih x (mem_range_of_pow_mem_range F K p ?_)
        rw [← pow_mul, ← pow_succ]
        exact hx
  intro x hx
  obtain ⟨n, c, hc⟩ := (mem_perfectClosure_iff_pow_mem (F := k) (E := K) p).mp hx
  obtain ⟨y, hy⟩ := key n x ⟨algebraMap k F c, by
    rw [← IsScalarTower.algebraMap_apply k F K]; exact hc⟩
  exact hy ▸ y.2

/-- If `K/k` is purely inseparable, then the only intermediate field over which `K` is separable
is `K` itself: a purely inseparable extension has no proper separating subfield. -/
theorem eq_top_of_isPurelyInseparable_of_isSeparableExtension (k K : Type*) [Field k] [Field K]
    [Algebra k K] (p : ℕ) [ExpChar k p] [IsPurelyInseparable k K] (F : IntermediateField k K)
    [Algebra.IsSeparableExtension F K] : F = ⊤ := by
  refine eq_top_iff.mpr fun x _ => ?_
  refine perfectClosure_le_of_isSeparableExtension k K p F ?_
  exact (mem_perfectClosure_iff_pow_mem (F := k) (E := K) p).mpr
    (IsPurelyInseparable.pow_mem k p x)

/-! ### No finitely generated subfield separates an infinite purely inseparable extension -/

/-- Let `K/k` be purely inseparable and of infinite degree. Then `K` is separable over no
subfield of the form `k(S)` with `S ⊆ K` finite.

Such a subfield is finite over `k` because every element of `K` is integral over `k`
(`IntermediateField.finiteDimensional_adjoin`), so it cannot be all of `K`, which is what
separability would force. -/
theorem not_isSeparableExtension_adjoin_of_not_finiteDimensional (k K : Type*) [Field k] [Field K]
    [Algebra k K] (p : ℕ) [ExpChar k p] [IsPurelyInseparable k K]
    (hinf : ¬ FiniteDimensional k K) (S : Set K) [Finite S] :
    ¬ Algebra.IsSeparableExtension (adjoin k S) K := by
  intro hsep
  have hfd : FiniteDimensional k (adjoin k S) :=
    IntermediateField.finiteDimensional_adjoin fun x _ => IsPurelyInseparable.isIntegral' k x
  rw [eq_top_of_isPurelyInseparable_of_isSeparableExtension k K p (adjoin k S)] at hfd
  exact hinf IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

/-- The same obstruction for an arbitrary base that is essentially of finite type over `k`, not
only for a localized polynomial ring: if `K/k` is purely inseparable and infinite, then `K` is
separable over no finitely generated subextension. So no factorization `k → A → Λ_𝔮` with `A`
essentially of finite type over `k` can have `A → Λ_𝔮` regular; the failure is not special to the
polynomial shape of clause (1). -/
theorem not_isSeparableExtension_of_essFiniteType (k K : Type*) [Field k] [Field K] [Algebra k K]
    (p : ℕ) [ExpChar k p] [IsPurelyInseparable k K] (hinf : ¬ FiniteDimensional k K)
    (F : IntermediateField k K) [Algebra.EssFiniteType k F] :
    ¬ Algebra.IsSeparableExtension F K := by
  obtain ⟨S, hSfin, hS⟩ := fg_def.mp (essFiniteType_iff.mp ‹_›)
  have : Finite S := hSfin
  rw [← hS]
  exact not_isSeparableExtension_adjoin_of_not_finiteDimensional k K p hinf S

/-! ### The shape in which clause (1) presents the subfield -/

/-- The subfield of `K` generated by the image of a `k`-algebra map `ψ` from a polynomial ring in
`m` variables is generated by the `m` images of the variables. This is why the residue field
`κ(𝔭)` of `𝔭 = φ^{-1}(𝔮)` is a finitely generated extension of `k`: it is the fraction field of
the image of `k[y_1, …, y_m]` in `κ(𝔮)`, hence `k` adjoined to the residues of the
`φ(y_i)`. -/
theorem adjoin_range_eq_adjoin_range_X (k K : Type*) [Field k] [Field K] [Algebra k K] {m : ℕ}
    (ψ : MvPolynomial (Fin m) k →ₐ[k] K) :
    adjoin k (Set.range ψ) = adjoin k (Set.range fun i => ψ (MvPolynomial.X i)) := by
  set S : Set K := Set.range fun i => ψ (MvPolynomial.X i) with hS
  refine le_antisymm (adjoin_le_iff.mpr ?_) (adjoin_le_iff.mpr ?_)
  · rintro x ⟨f, rfl⟩
    induction f using MvPolynomial.induction_on with
    | C a =>
        show ψ (MvPolynomial.C a) ∈ adjoin k S
        have hc : ψ (MvPolynomial.C a) = algebraMap k K a := by
          rw [← MvPolynomial.algebraMap_eq]; exact ψ.commutes a
        rw [hc]
        exact (adjoin k S).algebraMap_mem a
    | add f g hf hg => simpa using add_mem hf hg
    | mul_X f i hf =>
        show ψ (f * MvPolynomial.X i) ∈ adjoin k S
        rw [map_mul]
        exact mul_mem hf (subset_adjoin k S ⟨i, rfl⟩)
  · rintro x ⟨i, rfl⟩
    exact subset_adjoin k _ ⟨MvPolynomial.X i, rfl⟩

/-- **Clause (1) of Stacks 07FH cannot be strengthened to a regular homomorphism.** Let `K/k` be
purely inseparable of infinite degree. Then for every `m` and every `k`-algebra map
`ψ : k[y_1, …, y_m] → K`, the extension of `K` by the subfield generated by the image of `ψ` is
not separable.

Applied with `K = κ(𝔮)` and `ψ` the composition of a `φ` as in clause (1) with `Λ → Λ/𝔮 ↪ κ(𝔮)`,
whose kernel is `𝔭 = φ^{-1}(𝔮)` and whose generated subfield is the image of `κ(𝔭)`, this says
that `κ(𝔮)/κ(𝔭)` is separable for no `φ` whatever — so `k[y]_𝔭 → Λ_𝔮` cannot be made regular.
The module docstring exhibits a Noetherian geometrically regular `k`-algebra, namely
`K[[z]]` with `t ↦ t + z` over `k = 𝐅_p(t)` and `K` the perfect closure of `k`, to which the
hypotheses apply at its maximal ideal. -/
theorem not_isSeparableExtension_adjoin_range_of_not_finiteDimensional (k K : Type*) [Field k]
    [Field K] [Algebra k K] (p : ℕ) [ExpChar k p] [IsPurelyInseparable k K]
    (hinf : ¬ FiniteDimensional k K) {m : ℕ} (ψ : MvPolynomial (Fin m) k →ₐ[k] K) :
    ¬ Algebra.IsSeparableExtension (adjoin k (Set.range ψ)) K := by
  rw [adjoin_range_eq_adjoin_range_X k K ψ]
  exact not_isSeparableExtension_adjoin_of_not_finiteDimensional k K p hinf _

end Stacks.Smoothing

end
