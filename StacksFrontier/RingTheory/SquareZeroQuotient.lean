module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Ideal.AssociatedPrime.Functoriality

/-!
# The square-zero-variable quotient is a local ring

For a field `k`, let `S k` be the quotient of `MvPolynomial ℕ k` by the ideal `sqIdeal k`
generated by the squares of the variables. Every variable becomes a square-zero element, so
every element of `S k` differs from a constant by a nilpotent; the augmentation `aug k`, which
reads off the constant coefficient, therefore has the nilradical as its kernel. That kernel is
maximal because the augmentation is surjective, which makes `S k` a local ring.

## Main results

* `Stacks.SquareZero.squareZero_generator`: each variable squares to zero in `S k`.
* `Stacks.SquareZero.nilpotent_sub_constant`: every element of `S k` differs from a constant by
  a nilpotent.
* `Stacks.SquareZero.aug_mk`: the augmentation reads off the constant coefficient.
* `Stacks.SquareZero.nilradical_eq_ker_aug`: the nilradical of `S k` is the kernel of `aug k`.
* `Stacks.SquareZero.isLocalRing`: `S k` is a local ring.

## Implementation notes

These facts about `S k` are shared by the two counterexamples built on it — the auto-associated
ring of Stacks tag 05GL and the associated-points counterexample of Stacks tag 05AI — whose
modules are mutually incomparable in the import graph, so the vocabulary lives here rather than
in either of them. The ring `S k`, its defining ideal `sqIdeal k` and the augmentation `aug k`
are the ones introduced for the associated-primes counterexample of Stacks tag 05BX.

## References

* [Stacks Project, Tag 05AI](https://stacks.math.columbia.edu/tag/05AI)
-/

@[expose] public section

universe u

namespace Stacks.SquareZero

/-- Each variable squares to zero in the quotient. -/
theorem squareZero_generator (k : Type u) [Field k] (i : ℕ) :
    (Ideal.Quotient.mk (sqIdeal k) (MvPolynomial.X i) : S k) ^ 2 = 0 := by
  rw [← map_pow]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)

/-- Every element of the quotient differs from a constant by a nilpotent. -/
theorem nilpotent_sub_constant (k : Type u) [Field k] (f : MvPolynomial ℕ k) :
    IsNilpotent ((Ideal.Quotient.mk (sqIdeal k) f : S k) -
      Ideal.Quotient.mk (sqIdeal k) (MvPolynomial.C (MvPolynomial.constantCoeff f))) := by
  let q : MvPolynomial ℕ k →+* S k := Ideal.Quotient.mk (sqIdeal k)
  change IsNilpotent (q f - q (MvPolynomial.C (MvPolynomial.constantCoeff f)))
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add p r hp hr =>
      -- `S k` is reducible, so `convert … using 1` would also expose an instance-equality
      -- goal; rewriting the sum explicitly keeps the step independent of that.
      have hadd : q (p + r) - q (MvPolynomial.C (MvPolynomial.constantCoeff (p + r))) =
          (q p - q (MvPolynomial.C (MvPolynomial.constantCoeff p))) +
            (q r - q (MvPolynomial.C (MvPolynomial.constantCoeff r))) := by
        simp only [map_add]
        ring
      rw [hadd]
      exact (Commute.all _ _).isNilpotent_add hp hr
  | mul_X p i hp =>
      have hx : IsNilpotent (q (MvPolynomial.X i)) := ⟨2, squareZero_generator k i⟩
      simpa only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero] using
        (Commute.all _ _).isNilpotent_mul_left hx

/-- The augmentation reads off the constant coefficient. -/
theorem aug_mk (k : Type u) [Field k] (f : MvPolynomial ℕ k) :
    aug k (Ideal.Quotient.mk (sqIdeal k) f : S k) = MvPolynomial.constantCoeff f := by
  change (MvPolynomial.aeval (fun _ : ℕ => (0 : k))) f = _
  simp

/-- The nilradical of the quotient is the kernel of the augmentation. -/
theorem nilradical_eq_ker_aug (k : Type u) [Field k] :
    nilradical (S k) = RingHom.ker (aug k).toRingHom := by
  ext s
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective s
  change IsNilpotent (Ideal.Quotient.mk (sqIdeal k) f : S k) ↔ aug k _ = 0
  rw [aug_mk]
  refine ⟨fun hn => ?_, fun h => by simpa [h] using nilpotent_sub_constant k f⟩
  have hm := hn.map (aug k)
  rw [aug_mk] at hm
  exact isNilpotent_iff_eq_zero.mp hm

/-- The augmentation is surjective. -/
theorem aug_surjective (k : Type u) [Field k] :
    Function.Surjective (aug k).toRingHom := fun a => ⟨algebraMap k (S k) a, by simp⟩

/-- **Stacks 05AI.** The quotient by the squares of countably many variables is local. -/
@[instance, stacks 05AI "local ring"]
theorem isLocalRing (k : Type u) [Field k] : IsLocalRing (S k) := by
  have : (nilradical (S k)).IsMaximal := by
    rw [nilradical_eq_ker_aug]
    exact RingHom.ker_isMaximal_of_surjective _ (aug_surjective k)
  exact IsLocalRing.of_isMaximal_nilradical (S k)

end Stacks.SquareZero

end
