/-!
# Nilpotent and locally nilpotent ideals

Let `R` be a ring and `I ⊂ R` an ideal. The ideal `I` is *locally nilpotent* if for every
`x ∈ I` there is an `n ∈ ℕ` with `x ^ n = 0`, and `I` is *nilpotent* if there is an `n ∈ ℕ`
with `I ^ n = 0`. A nilpotent ideal is locally nilpotent, and local nilpotence is preserved by
extension along a ring map. Over a Noetherian ring the two notions agree.

Fix a field `k`, and let `R = k[x_n | n ∈ ℕ]`, `I = (x_n ^ (n + 1) : n ∈ ℕ)`, `S = R / I` and
`J = (x̄_n : n ∈ ℕ) ⊆ S`. Then `J` is locally nilpotent but not nilpotent.

## Main definitions

* `Ideal.LocallyNilpotent`: every element of the ideal is nilpotent.
* `Ideal.Nilpotent`: some power of the ideal is zero.
* `Stacks.LocallyNilpotentNotNilpotent.idealI`: the ideal `(x_n ^ (n + 1) : n ∈ ℕ)` of
  `k[x_n | n ∈ ℕ]`.
* `Stacks.LocallyNilpotentNotNilpotent.idealJ`: the ideal of `S = R / I` generated by the
  images of the variables.

## Main results

* `Ideal.nilpotent_iff_isNilpotent`: `Ideal.Nilpotent I` is `IsNilpotent I` in `Ideal R`.
* `Ideal.Nilpotent.locallyNilpotent`: a nilpotent ideal is locally nilpotent.
* `Ideal.IsLocallyNilpotent0544.map`: the extension of a locally nilpotent ideal along a ring
  map is locally nilpotent.
* `Stacks.LocallyNilpotentNotNilpotent.idealJ_le_nilradical`: `J` is locally nilpotent.
* `Stacks.LocallyNilpotentNotNilpotent.not_isNilpotent_idealJ`: `J` is not nilpotent.
* `isReduced_pi_component`: a factor of a reduced product is reduced.
-/

@[expose] public section

/-- An ideal `I` of a commutative ring `A` is *locally nilpotent* if every
element of `I` is nilpotent. -/
@[sga "6 VI 6.1"]
def Ideal.IsLocallyNilpotent {A : Type*} [CommRing A] (I : Ideal A) : Prop :=
  ∀ x ∈ I, IsNilpotent x

end

@[expose] public section

namespace Ideal

variable {R : Type*} [CommSemiring R]

/-- An ideal `I ⊂ R` is *locally nilpotent* if every element of `I` is nilpotent,
i.e. for every `x ∈ I` there exists `n ∈ ℕ` with `x ^ n = 0`. -/
@[stacks 00IL "locally nilpotent", sga "6 VI 6.1"]
def LocallyNilpotent (I : Ideal R) : Prop :=
  ∀ x ∈ I, IsNilpotent x

/-- An ideal `I ⊂ R` is *nilpotent* if there exists `n ∈ ℕ` with `I ^ n = 0`,
where `0 = ⊥` is the zero ideal. -/
@[stacks 00IL "nilpotent"]
def Nilpotent (I : Ideal R) : Prop :=
  ∃ n : ℕ, I ^ n = ⊥

/-- `Ideal.Nilpotent I` is equivalent to Mathlib's `IsNilpotent I` in the monoid `Ideal R`. -/
theorem nilpotent_iff_isNilpotent (I : Ideal R) : Nilpotent I ↔ IsNilpotent I := by
  simp only [Nilpotent, IsNilpotent, Ideal.zero_eq_bot]

/-- A nilpotent ideal is locally nilpotent. -/
theorem Nilpotent.locallyNilpotent {I : Ideal R} (h : Nilpotent I) : LocallyNilpotent I := by
  obtain ⟨n, hn⟩ := h
  exact fun x hx => ⟨n, by simpa [hn] using Ideal.pow_mem_pow hx n⟩

end Ideal

end

/-!
### Ideals of a Noetherian ring

Over a Noetherian ring, `J ≤ √I` implies `J ^ n ≤ I` for some `n`: this is
`Ideal.exists_pow_le_of_le_radical_of_fg`, with `Ideal.fg_of_isNoetherianRing`. Hence a locally
nilpotent ideal is nilpotent: `Ideal.FG.isNilpotent_iff_le_nilradical`.
-/

@[expose] public section

add_to_stacks 00IM Ideal.exists_pow_le_of_le_radical_of_fg
add_to_ega "I 6.1.6" "affine case" Ideal.exists_pow_le_of_le_radical_of_fg
add_to_stacks 00IM "every ideal of a Noetherian ring is finitely generated"
  Ideal.fg_of_isNoetherianRing
add_to_stacks 00IM "locally nilpotent = nilpotent" Ideal.FG.isNilpotent_iff_le_nilradical
add_to_ega "I 6.1.6" "affine case" Ideal.FG.isNilpotent_iff_le_nilradical

end

@[expose] public section

/-- An ideal `I` is *locally nilpotent* if every element of `I` is nilpotent. -/
def Ideal.IsLocallyNilpotent0544 {R : Type*} [CommSemiring R] (I : Ideal R) : Prop :=
  ∀ x ∈ I, IsNilpotent x

/-- If `R → R'` is a ring map and `I ⊂ R` is a locally nilpotent ideal, then
the extended ideal `IR' = I.map f` is locally nilpotent in `R'`. -/
@[stacks 0544, ega "III 5.4.6" "more general"]
theorem Ideal.IsLocallyNilpotent0544.map
    {R R' : Type*} [CommRing R] [CommRing R']
    (f : R →+* R') (I : Ideal R)
    (hI : Ideal.IsLocallyNilpotent0544 I) :
    Ideal.IsLocallyNilpotent0544 (I.map f) := by
  intro y hy
  refine Submodule.span_induction (p := fun z _ => IsNilpotent z) ?_ IsNilpotent.zero
    (fun a b _ _ ha hb => Commute.isNilpotent_add (.all a b) ha hb)
    (fun r a _ ha => Commute.isNilpotent_mul_left (.all r a) ha) hy
  rintro z ⟨x, hx, rfl⟩
  exact (hI x hx).map f

end

/-!
### A locally nilpotent ideal that is not nilpotent

The variables are indexed by `ℕ`, and `I` is generated by the `x_n ^ (n + 1)`.
-/

@[expose] public section

open MvPolynomial

namespace Stacks.LocallyNilpotentNotNilpotent

variable (k : Type*) [Field k]

/-- The ideal `I` of `k[x_n | n ∈ ℕ]` generated by the `x_n ^ (n + 1)` for `n ∈ ℕ`. -/
noncomputable def idealI : Ideal (MvPolynomial ℕ k) :=
  Ideal.span (Set.range (fun n : ℕ => (X n : MvPolynomial ℕ k) ^ (n + 1)))

/-- The quotient ring `S = R / I`. -/
noncomputable abbrev S_ring : Type _ := MvPolynomial ℕ k ⧸ idealI k

/-- The ideal `J ⊆ S` generated by the images `x̄_n` of the variables. -/
noncomputable def idealJ : Ideal (S_ring k) :=
  Ideal.span (Set.range (fun n : ℕ => Ideal.Quotient.mk (idealI k) (X n)))

/-- Each generator `x̄_n` is nilpotent: `(x̄_n) ^ (n + 1) = 0` in `S`. -/
theorem mk_X_pow_succ_eq_zero (n : ℕ) :
    (Ideal.Quotient.mk (idealI k) (X n)) ^ (n + 1) = 0 := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨n, rfl⟩

/-- `J ≤ nilradical S`, i.e. every element of `J` is nilpotent. -/
@[stacks 0EGG]
theorem idealJ_le_nilradical : idealJ k ≤ nilradical (S_ring k) := by
  rw [idealJ, Ideal.span_le]
  rintro x ⟨n, rfl⟩
  exact ⟨n + 1, mk_X_pow_succ_eq_zero k n⟩

/-- The monomial `X m ^ m` does not lie in `I`. -/
theorem X_pow_self_notMem_idealI (m : ℕ) :
    (X m : MvPolynomial ℕ k) ^ m ∉ idealI k := by
  set Q := Polynomial k ⧸ (Ideal.span {(Polynomial.X : Polynomial k) ^ (m + 1)})
  set π : Polynomial k →+* Q := Ideal.Quotient.mk _ with hπ
  set ψ : MvPolynomial ℕ k →ₐ[k] Q :=
    aeval (fun n : ℕ => if n = m then π Polynomial.X else 0) with hψ
  have key : ∀ e : ℕ, ψ ((X m : MvPolynomial ℕ k) ^ e) = 0 ↔ m + 1 ≤ e := fun e => by
    rw [map_pow, hψ, aeval_X, ite_eq_left rfl, ← map_pow, hπ, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton, pow_dvd_pow_iff Polynomial.X_ne_zero Polynomial.not_isUnit_X]
  intro hmem
  have hI : idealI k ≤ RingHom.ker ψ.toRingHom := by
    rw [idealI, Ideal.span_le]
    rintro _ ⟨n, rfl⟩
    rcases eq_or_ne n m with rfl | hn
    · exact (key _).2 le_rfl
    · simp [hψ, hn]
  have := (key m).1 (hI hmem)
  omega

/-- `J` is not nilpotent: there is no `m` with `J ^ m = 0`. -/
@[stacks 0EGG]
theorem not_isNilpotent_idealJ : ¬ IsNilpotent (idealJ k) := by
  rintro ⟨m, hbot⟩
  have hpow : (Ideal.Quotient.mk (idealI k) (X m)) ^ m ∈ idealJ k ^ m :=
    Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self m)) m
  rw [hbot, Ideal.zero_eq_bot, Ideal.mem_bot, ← map_pow, Ideal.Quotient.eq_zero_iff_mem] at hpow
  exact X_pow_self_notMem_idealI k m hpow

end Stacks.LocallyNilpotentNotNilpotent

/-! ### Reducedness of a factor of a product -/

/-- A factor of a reduced product is reduced. -/
public lemma isReduced_pi_component {ι : Type*} {R : ι → Type*}
    [∀ i, MonoidWithZero (R i)] [IsReduced (∀ i, R i)] (i : ι) : IsReduced (R i) := by
  classical
  rw [isReduced_iff]
  rintro x ⟨n, he⟩
  have h : IsNilpotent (Pi.single i x : ∀ j, R j) := by
    refine ⟨n + 1, funext fun j => ?_⟩
    by_cases hji : j = i
    · subst j
      simp [pow_succ, he]
    · simp [Pi.single_eq_of_ne hji]
  simpa using congrFun h.eq_zero i

end
