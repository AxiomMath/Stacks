module

public import StacksFrontier.RingTheory.Nilpotent.Ideal
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Surjectivity modulo a locally nilpotent ideal

Theorem (Stacks Tag 07RD, "lemma-surjective-mod-locally-nilpotent").

All rings are commutative with unit. Fix a base ring `R`.

Let `R` be a commutative ring and let `I ⊆ R` be a locally nilpotent ideal
(every element of `I` is nilpotent). Let `f : S → S'` be an `R`-algebra map
such that:
  - the induced map `S → S'/IS'` is surjective (equivalently `f(S) + IS' = S'`), and
  - `S'` is of finite type as an `R`-algebra.
Then `f : S → S'` is surjective.

## Definitions (informal -> Lean)

1. Locally nilpotent ideal: an ideal `I ⊆ R` with every element nilpotent.
   In Mathlib this is `Ideal.IsLocallyNilpotent I`, unfolding to
   `∀ x ∈ I, IsNilpotent x`, matching the definition above exactly.

2. `R`-algebra and `R`-algebra map: `[Algebra R S]`, `[Algebra R S']`, and
   `f : S →ₐ[R] S'` (a ring hom commuting with the structure maps).

3. Extended ideal `IS' ⊆ S'`: the ideal generated by the image of `I` under
   the structure map `φ' : R → S'`. In Mathlib this is
   `Ideal.map (algebraMap R S') I`.

4. Finite type `R`-algebra: `Algebra.FiniteType R S'`.

5. The induced map `S → S'/IS'`: the composite of `f` with the quotient map
   `π : S' → S'/IS'`. "`S → S'/IS'` is surjective" means `π ∘ f` is surjective.

## Notes

- Dependency (cited, not part of the statement): Stacks Tag 00IM, available in
  Mathlib as `Ideal.exists_pow_le_of_le_radical_of_fg`.
-/

@[expose] public section

variable {R : Type*} [CommRing R]
variable {S S' : Type*} [CommRing S] [CommRing S'] [Algebra R S] [Algebra R S']

-- The extended ideal `I S'` of an ideal `I ⊆ R` in an `R`-algebra `S'` is the
-- ideal of `S'` generated by the image of `I` under the structure map.

/-- The extended ideal `S⁻¹I`, i.e. the ideal of `A_S` generated by the image of `I`
under the structure map. -/
@[ega "0 1.2.6", ega "0 4.3.5" "special case", ega "0 7.6.15" "special case"]
abbrev extendedIdeal {A : Type*} [CommRing A] (I : Ideal A)
    (A_S : Type*) [CommRing A_S] [Algebra A A_S] : Ideal A_S :=
  Ideal.map (algebraMap A A_S) I

open MvPolynomial in
/-- **Coefficient filtration membership.** For `𝔐 = Ideal.map C 𝔫` (`𝔫 ⊆ R`),
`p ∈ 𝔐 ^ k` iff every coefficient of `p` lies in `𝔫 ^ k`.

This identifies the ideal `𝔐 ^ k`
with the "coefficient filtration" `{p | ∀ m, coeff m p ∈ 𝔫 ^ k}`. The key tool
is `MvPolynomial.mem_map_C_iff` (`f ∈ Ideal.map C I ↔ ∀ m, coeff m f ∈ I`) for
the `k = 1` case, lifted to powers by induction using `MvPolynomial.coeff_mul`
and `MvPolynomial.as_sum`. -/
theorem mem_map_C_pow_iff
    {R : Type*} [CommRing R] {ι : Type*}
    (𝔫 : Ideal R) (k : ℕ) (p : MvPolynomial ι R) :
    p ∈ (Ideal.map (C : R →+* MvPolynomial ι R) 𝔫) ^ k ↔
      ∀ m : ι →₀ ℕ, p.coeff m ∈ 𝔫 ^ k := by
  -- Induction on `k`.
  --  k = 0: both sides are `p ∈ ⊤` / `∀ m, coeff m p ∈ ⊤` (𝔫^0 = ⊤), true.
  --  k → k+1 (⊆): `𝔐^(k+1) = 𝔐^k * 𝔐` generated by `u*v`, `u ∈ 𝔐^k`, `v ∈ 𝔐`;
  --   `coeff_mul` gives `coeff α (u v) = ∑_{β+γ=α} coeff β u * coeff γ v ∈ 𝔫^k*𝔫`.
  --   Use `Submodule.mul_induction_on` / `Ideal.pow_succ`.
  --  k → k+1 (⊇): write `p = ∑_α monomial α (coeff α p)` (`as_sum`); each
  --   `coeff α p ∈ 𝔫^(k+1) = 𝔫^k*𝔫`, split as `∑ a_i b_i`, and
  --   `monomial α (a_i b_i) = C a_i * monomial α b_i ∈ 𝔐^k * 𝔐`.
  -- Mathlib: `MvPolynomial.mem_map_C_iff`, `MvPolynomial.coeff_mul`,
  -- `MvPolynomial.as_sum`, `Ideal.pow_succ`, `Ideal.mul_mem_mul`, `Ideal.pow_zero`.
  rw [← Ideal.map_pow, MvPolynomial.mem_map_C_iff]

open MvPolynomial in
/-- **`δ = id - σ` raises the coefficient filtration by one.**  For
`𝔐 = Ideal.map C 𝔫`, `σ = aeval (X j ↦ X j - h j)` with `h j ∈ 𝔐`, and
`δ p := p - σ p`: if `p ∈ 𝔐 ^ k` then `δ p ∈ 𝔐 ^ (k+1)`.

This holds precisely because `𝔐 = map C 𝔫` lives in the coefficients (it is false for a
general `𝔐`). By `R`-linearity reduce to `p = monomial α c` with `c ∈ 𝔫 ^ k`
(`mem_map_C_pow_iff` + `as_sum`). Then `δ (C c * X^α) = C c * (X^α - σ (X^α))`
since `σ` fixes constants (`aeval_C`); and `E := X^α - σ (X^α) = X^α - ∏ (X j - h j)^{α j} ∈ 𝔐`
(in `P/𝔐`, `X j - h j ≡ X j`, so `σ (X^α) ≡ X^α`, i.e. `E ∈ 𝔐`). With
`C c ∈ 𝔐 ^ k` we get `δ p = C c * E ∈ 𝔐 ^ k * 𝔐 = 𝔐 ^ (k+1)`.
Mathlib: `MvPolynomial.aeval_C`, `Ideal.Quotient.mk_eq_zero`, `map_pow`,
`Ideal.mul_mem_mul`, `Ideal.pow_succ`. -/
theorem delta_mem_map_C_pow_succ
    {R : Type*} [CommRing R] {ι : Type*}
    (𝔫 : Ideal R)
    (h : ι → MvPolynomial ι R)
    (hh : ∀ j, h j ∈ Ideal.map (C : R →+* MvPolynomial ι R) 𝔫)
    (k : ℕ) (p : MvPolynomial ι R)
    (hp : p ∈ (Ideal.map (C : R →+* MvPolynomial ι R) 𝔫) ^ k) :
    p - (MvPolynomial.aeval (fun j => (X j - h j)) :
          MvPolynomial ι R →ₐ[R] MvPolynomial ι R) p
        ∈ (Ideal.map (C : R →+* MvPolynomial ι R) 𝔫) ^ (k + 1) := by
  classical
  set 𝔐 : Ideal (MvPolynomial ι R) := Ideal.map (C : R →+* MvPolynomial ι R) 𝔫 with h𝔐
  set σ : MvPolynomial ι R →ₐ[R] MvPolynomial ι R :=
    MvPolynomial.aeval (fun j => (MvPolynomial.X j - h j)) with hσ
  -- σ fixes constants and sends X i ↦ X i - h i
  have hσC : ∀ c : R, σ (C c) = C c := fun c => by
    rw [hσ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  -- key fact: x - σ x ∈ 𝔐 for all x
  have key : ∀ x : MvPolynomial ι R, x - σ x ∈ 𝔐 := by
    intro x
    induction x using MvPolynomial.induction_on with
    | C a =>
        rw [hσC a, sub_self]
        exact Submodule.zero_mem _
    | add x y hx hy =>
        rw [map_add, add_sub_add_comm]
        exact Submodule.add_mem _ hx hy
    | mul_X x j hx =>
        have hexp : x * X j - σ (x * X j) = (x - σ x) * X j + σ x * h j := by
          rw [map_mul, hσ, MvPolynomial.aeval_X]
          ring
        rw [hexp]
        exact Submodule.add_mem _ (Ideal.mul_mem_right _ _ hx) (Ideal.mul_mem_left _ _ (hh j))
  -- Reduce p to its monomial expansion.
  -- It suffices to handle each monomial.
  have hmono : ∀ v ∈ p.support,
      (MvPolynomial.monomial v (p.coeff v))
        - σ (MvPolynomial.monomial v (p.coeff v)) ∈ 𝔐 ^ (k + 1) := by
    intro v _
    set c := p.coeff v
    -- C c ∈ 𝔐 ^ k
    have hCc : C c ∈ 𝔐 ^ k := by
      rw [h𝔐, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ ((mem_map_C_pow_iff 𝔫 k p).mp hp v)
    -- C c * E ∈ 𝔐^k * 𝔐 = 𝔐^(k+1)
    rw [show MvPolynomial.monomial v c = C c * MvPolynomial.monomial v (1 : R) by
      rw [MvPolynomial.C_mul_monomial, mul_one], map_mul, hσC, ← mul_sub, pow_succ]
    exact Ideal.mul_mem_mul hCc (key _)
  -- Now assemble: p = ∑ monomial, T additive.
  have hTsum : p - σ p
      = ∑ v ∈ p.support,
          ((MvPolynomial.monomial v (p.coeff v))
            - σ (MvPolynomial.monomial v (p.coeff v))) := by
    conv_lhs => rw [MvPolynomial.as_sum p]
    rw [map_sum, Finset.sum_sub_distrib]
  rw [hTsum]
  exact Submodule.sum_mem _ hmono

open MvPolynomial in
/-- **Central "unipotent automorphism" lemma (coefficient-nilpotent form).**
In `P = MvPolynomial ι R`, let `𝔫 ⊆ R` be a *nilpotent* ideal (`𝔫 ^ N = ⊥`) and
let `g j = X j - h j` where every `h j ∈ Ideal.map C 𝔫`. Then the `R`-algebra
endomorphism `aeval g : P → P` is surjective (in fact bijective).

Here the nilpotent ideal of `P` is `𝔐 = Ideal.map C 𝔫` for a nilpotent `𝔫 ⊆ R`. The
statement for a general nilpotent `𝔐` is also true, but its proof is much harder: the
coefficient filtration only works for `𝔐 = map C 𝔫`.

Write `σ = aeval g` and
`δ = id - σ` as an `R`-linear endomorphism of `P` (`Module.End R P`).
The coefficient filtration `F^k = 𝔐^k` (`mem_map_C_pow_iff`) satisfies
`δ (𝔐^k) ⊆ 𝔐^(k+1)` (`delta_mem_map_C_pow_succ`), so by induction
`δ^m p ∈ 𝔐^m` for all `p`; at `m = N`, `δ^N p ∈ 𝔐^N = (map C 𝔫)^N = map C (𝔫^N) = ⊥`,
hence `δ^N = 0`, i.e. `IsNilpotent δ` in `Module.End R P`. Then
`σ = id - δ = 1 - δ` is a unit (`IsNilpotent.isUnit_one_sub`), so `σ` is
bijective as an `R`-linear map, in particular surjective. -/
theorem aeval_sub_nilpotent_surjective
    {R : Type*} [CommRing R] {ι : Type*}
    (𝔫 : Ideal R) (N : ℕ) (hN : 𝔫 ^ N = ⊥)
    (h : ι → MvPolynomial ι R)
    (hh : ∀ j, h j ∈ Ideal.map (C : R →+* MvPolynomial ι R) 𝔫) :
    Function.Surjective
      (MvPolynomial.aeval (fun j => (X j - h j)) :
        MvPolynomial ι R →ₐ[R] MvPolynomial ι R) := by
  -- Show `IsNilpotent (id - σ)` via the coefficient filtration.
  classical
  set 𝔐 : Ideal (MvPolynomial ι R) := Ideal.map (C : R →+* MvPolynomial ι R) 𝔫 with h𝔐
  set σ : MvPolynomial ι R →ₐ[R] MvPolynomial ι R :=
    MvPolynomial.aeval (fun j => (MvPolynomial.X j - h j)) with hσ
  -- δ as an R-linear endomorphism of P.
  set δ : Module.End R (MvPolynomial ι R) :=
    LinearMap.id - σ.toLinearMap with hδ
  -- δ p = p - σ p definitionally.
  have hδapp : ∀ p, δ p = p - σ p := fun p => by simp [hδ]
  -- Step A: δ^m maps into 𝔐^m (coefficient filtration descent).
  --   Proof: induction on m using `delta_mem_map_C_pow_succ` (𝔐^0 = ⊤ base).
  have hpow : ∀ (m : ℕ) (p : MvPolynomial ι R), (δ ^ m) p ∈ 𝔐 ^ m := by
    intro m
    induction m with
    | zero => simp
    | succ k ih =>
        intro p
        -- (δ^(k+1)) p = δ ((δ^k) p);  apply delta_mem_map_C_pow_succ to (δ^k) p ∈ 𝔐^k.
        have hstep : (δ ^ (k + 1)) p = δ ((δ ^ k) p) := by
          rw [pow_succ']
          rfl
        rw [hstep, hδapp]
        -- `(δ^k) p - σ ((δ^k) p) ∈ (map C 𝔫)^(k+1)`; 𝔐 = map C 𝔫, σ defeq.
        simpa [h𝔐, hσ] using delta_mem_map_C_pow_succ 𝔫 h hh k ((δ ^ k) p) (ih p)
  -- Step B: δ^N = 0, because 𝔐^N = map C (𝔫^N) = map C ⊥ = ⊥.
  have hMN : 𝔐 ^ N = ⊥ := by
    -- `Ideal.map_pow` : (map C 𝔫)^N = map C (𝔫^N); then 𝔫^N = ⊥ and `Ideal.map_bot`.
    rw [h𝔐, ← Ideal.map_pow, hN, Ideal.map_bot]
  have hδN : (δ ^ N) = 0 := LinearMap.ext fun p => by simpa [hMN] using hpow N p
  -- Step C: σ = 1 - δ is a unit in Module.End, hence surjective.
  have hσeq : σ.toLinearMap = (1 - δ : Module.End R (MvPolynomial ι R)) := by
    -- 1 - δ = 1 - (id - σ) = σ.toLinearMap ; note (1 : Module.End) = LinearMap.id
    rw [hδ, show (1 : Module.End R (MvPolynomial ι R)) = LinearMap.id from rfl]
    abel
  -- A unit linear map is surjective; transfer to σ as a function.
  change Function.Surjective σ.toLinearMap
  rw [hσeq]
  exact ((Module.End.isUnit_iff _).mp (IsNilpotent.isUnit_one_sub ⟨N, hδN⟩)).surjective

/-- **Stacks Tag 07RD.** Let `R` be a commutative ring, `I ⊆ R` a locally
nilpotent ideal, and `f : S →ₐ[R] S'` an `R`-algebra map such that the induced
map `S → S'/IS'` is surjective and `S'` is of finite type over `R`. Then `f`
is surjective.

The proof is the Stacks 07RD argument, reorganized to avoid
the `R₀` reduction by observing that the finitely many nilpotent coefficients
generate a nilpotent ideal directly via Tag 00IM with `J = ⊥`.

Let `P := MvPolynomial ι R` for a `Fintype ι`. Since `S'` is finite type over
`R`, choose a *surjective* `R`-algebra hom `φ : P →ₐ[R] S'` (generators
`xⱼ := φ (X j)`).

`hsurj` says `π ∘ f` is surjective, where `π = Ideal.Quotient.mk (IS')`. Hence
for each `j` there is `sⱼ ∈ S` with `π (xⱼ) = π (f sⱼ)`, i.e.
`xⱼ - f sⱼ ∈ IS' = Ideal.map (algebraMap R S') I`.

An element of `IS'` is a finite sum `Σ_k (algebraMap aₖ)·bₖ` with `aₖ ∈ I`,
`bₖ ∈ S'`. Lift each `bₖ` through `φ` to `βₖ ∈ P`, and set
`h j := Σ_k (C aₖ) · βₖ ∈ P`, so that `φ (h j) = xⱼ - f sⱼ`. Define
`g j := X j - h j`, whence `φ (g j) = xⱼ - (xⱼ - f sⱼ) = f sⱼ ∈ range f`.

Let `𝔫 ⊆ R` be the ideal generated by the finite set `{aₖ}` of coefficients
used above. Each `aₖ ∈ I` is nilpotent (`hI`), so `𝔫 ≤ (⊥ : Ideal R).radical`
(the nilradical); and `𝔫` is finitely generated. By Tag 00IM
(`Ideal.exists_pow_le_of_le_radical_of_fg`) there is `N` with `𝔫 ^ N ≤ ⊥`, i.e.
`𝔫 ^ N = ⊥`: `𝔫` is nilpotent. Put `𝔐 := Ideal.map C 𝔫 ⊆ P`; then
`𝔐 ^ N ≤ Ideal.map C (𝔫 ^ N) = ⊥`, so `𝔐` is nilpotent, and each `h j ∈ 𝔐`
(it is a combination of `C aₖ` with `aₖ ∈ 𝔫`).

By `aeval_sub_nilpotent_surjective`, `σ := aeval g : P →ₐ[R] P` is surjective.
Therefore the `R`-subalgebra of `P` generated by `{g j}` is `⊤` (it contains
`σ.range = ⊤`, and `Algebra.adjoin R {g j} = σ.range`). Applying `φ`:
`S' = φ '' P = φ '' (adjoin R {g j}) = Algebra.adjoin R {φ (g j)}
     = Algebra.adjoin R {f sⱼ} ≤ (f.range : Subalgebra R S')`,
since each `f sⱼ ∈ f.range` and `f.range` is an `R`-subalgebra. Hence
`f.range = ⊤`, i.e. `f` is surjective. ∎ -/
@[stacks 07RD]
theorem surjective_of_surjective_mod_locallyNilpotent
    (I : Ideal R) (hI : I.IsLocallyNilpotent)
    (f : S →ₐ[R] S')
    (hsurj : Function.Surjective
      ((Ideal.Quotient.mk (extendedIdeal I S')).comp f.toRingHom))
    (hft : Algebra.FiniteType R S') :
    Function.Surjective f := by
  classical
  -- Step 1: a surjective `R`-algebra presentation `φ : P ↠ S'` from finite type.
  -- `Algebra.FiniteType.iff_quotient_mvPolynomial'` gives `⟨ι, _, φ, hφ⟩` with
  -- `φ : MvPolynomial ι R →ₐ[R] S'` surjective; the generators are indexed by a
  -- `Fintype ι`, not by `Fin n`.
  obtain ⟨ι, _, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial'.mp hft
  -- Step 2: for each generator, a preimage in `S` modulo `IS'`.
  -- For `j`, apply `hsurj` to `φ (X j)` to get `sⱼ ∈ S` with
  -- `φ (X j) - f sⱼ ∈ extendedIdeal I S'`. This uses
  -- `Ideal.Quotient.eq` / `RingHom.comp_apply` to turn the quotient equality
  -- into a membership.
  have hgen : ∀ j : ι, ∃ s : S,
      φ (MvPolynomial.X j) - f s ∈ extendedIdeal I S' := by
    intro j
    obtain ⟨s, hs⟩ := hsurj (Ideal.Quotient.mk (extendedIdeal I S') (φ (MvPolynomial.X j)))
    rw [RingHom.comp_apply] at hs
    exact ⟨s, Ideal.Quotient.eq.mp hs.symm⟩
  -- Step 3: build the lift `h j ∈ P` and the displacement `g j = X j - h j`
  -- with `φ (g j) = f (s j) ∈ f.range`, and a finitely generated ideal `𝔫 ⊆ I`
  -- collecting the (nilpotent) coefficients used. Each generator of `𝔫` is in
  -- `I`, hence nilpotent, so `𝔫 ≤ (⊥).radical`; `𝔫.FG`; then Tag 00IM
  -- (`Ideal.exists_pow_le_of_le_radical_of_fg`) gives `N` with `𝔫 ^ N = ⊥`.
  -- Set `𝔐 := Ideal.map MvPolynomial.C 𝔫`; then `𝔐 ^ N = ⊥`
  -- (`Ideal.map_pow`, `Ideal.map_bot`) and `h j ∈ 𝔐`.
  -- Apply `aeval_sub_nilpotent_surjective` to get `aeval g` surjective, hence
  -- `Algebra.adjoin R (Set.range g) = ⊤`. Push through `φ` (surjective):
  -- `Algebra.adjoin R (Set.range (φ ∘ g)) = ⊤`, and `φ (g j) ∈ f.range`, so
  -- `f.range = ⊤`, i.e. `f` surjective (`AlgHom.range_eq_top`).
  -- Choose the witnesses s j from hgen.
  choose s hs using hgen
  -- Single-element lifting lemma: lift any element of the extended ideal through φ,
  -- with coefficients controlled by a finite subset of I.
  have hlift : ∀ w : S', w ∈ extendedIdeal I S' →
      ∃ (p : MvPolynomial ι R) (T : Finset R), ↑T ⊆ (I : Set R) ∧ φ p = w ∧
        p ∈ Ideal.map (MvPolynomial.C : R →+* MvPolynomial ι R) (Ideal.span ↑T) := by
    intro w hw
    rw [show extendedIdeal I S' = Ideal.span (algebraMap R S' '' I) from rfl,
      Submodule.mem_span_iff_exists_finset_subset] at hw
    obtain ⟨c, t, htsub, -, hsum⟩ := hw
    choose! r hrI hra using fun a (ha : a ∈ t) => htsub ha
    choose! β hβ using fun a => hφ (c a)
    refine ⟨∑ a ∈ t, MvPolynomial.C (r a) * β a, t.image r, ?_, ?_, ?_⟩
    · rw [Finset.coe_image]
      rintro _ ⟨a, ha, rfl⟩
      exact hrI a ha
    · rw [map_sum, ← hsum]
      refine Finset.sum_congr rfl fun a ha => ?_
      rw [map_mul, show φ (MvPolynomial.C (r a)) = algebraMap R S' (r a) by simp,
        hra a ha, hβ a, smul_eq_mul]
      ring
    · exact Ideal.sum_mem _ fun a ha => Ideal.mul_mem_right _ _ <| Ideal.mem_map_of_mem _ <|
        Ideal.subset_span <| Finset.mem_coe.mpr <| Finset.mem_image_of_mem r ha
  -- Apply the lifting lemma to each w j := φ (X j) - f (s j).
  choose p T hTI hφp hpmem using fun j => hlift _ (hs j)
  -- Collect all coefficient sets into one finset Tall (ι is a Fintype).
  set Tall : Finset R := Finset.univ.biUnion T with hTall
  set 𝔫 : Ideal R := Ideal.span (↑Tall : Set R)
  -- Tall ⊆ I.
  have hTallI : ↑Tall ⊆ (I : Set R) := by
    rw [hTall, Finset.coe_biUnion]
    exact Set.iUnion₂_subset fun j _ => hTI j
  -- Each generator a ∈ Tall ⊆ I is nilpotent, so 𝔫 ≤ (⊥).radical.
  have hrad : 𝔫 ≤ (⊥ : Ideal R).radical :=
    Ideal.span_le.mpr fun a ha => Ideal.mem_radical_iff.mpr (hI a (hTallI ha))
  -- Tag 00IM: 𝔫 is nilpotent.
  obtain ⟨N, hNle⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad ⟨Tall, rfl⟩
  -- Define the lift family h : ι → P, with h j ∈ Ideal.map C 𝔫.
  have hpmem' : ∀ j, p j ∈ Ideal.map (MvPolynomial.C : R →+* MvPolynomial ι R) 𝔫 :=
    fun j => Ideal.map_mono (Ideal.span_mono (Finset.coe_subset.mpr
      (Finset.subset_biUnion_of_mem T (Finset.mem_univ j)))) (hpmem j)
  -- Apply the central unipotent lemma: σ := aeval (X j - p j) is surjective.
  set σ : MvPolynomial ι R →ₐ[R] MvPolynomial ι R :=
    MvPolynomial.aeval (fun j => (MvPolynomial.X j - p j)) with hσ
  -- φ (σ (X j)) = f (s j).
  have hφg : ∀ j, φ (σ (MvPolynomial.X j)) = f (s j) := by
    intro j
    rw [hσ, MvPolynomial.aeval_X, map_sub, hφp j, sub_sub_cancel]
  -- Conclude f surjective via the adjoin argument.
  rw [← AlgHom.range_eq_top]
  have hcomp : Function.Surjective (φ.comp σ) :=
    hφ.comp (aeval_sub_nilpotent_surjective 𝔫 N (le_bot_iff.mp hNle) p hpmem')
  rw [← AlgHom.range_eq_top] at hcomp
  have hle : (φ.comp σ).range ≤ f.range := by
    rw [← Algebra.map_top, ← MvPolynomial.adjoin_range_X, AlgHom.map_adjoin,
      Algebra.adjoin_le_iff]
    rintro y ⟨x, ⟨j, rfl⟩, rfl⟩
    change (φ.comp σ) (MvPolynomial.X j) ∈ f.range
    rw [AlgHom.comp_apply, hφg j]
    exact ⟨s j, rfl⟩
  exact top_le_iff.mp (hcomp ▸ hle)

/-!
# Finite type modulo a nilpotent ideal

Let `R` be a ring, let `I ⊂ R` be a nilpotent ideal, and let `S` be an `R`-algebra such
that the induced ring map `R/I → S/IS` is of finite type. Then the structure map `R → S`
is of finite type. All rings are commutative with unit and ring homomorphisms send `1`
to `1`.

## Conventions

An `A`-algebra `B` is *of finite type* if it is generated as an `A`-algebra by finitely
many elements, equivalently if it is a quotient of a polynomial ring in finitely many
variables; this is `Algebra.FiniteType A B`. An ideal `I ⊂ R` is *nilpotent* if
`I ^ m = 0` for some `m ≥ 1`, i.e. `IsNilpotent I` for `I` viewed as an element of the
semiring of ideals. Here `IS` denotes `I.map (algebraMap R S)`, the ideal of `S`
generated by the image of `I`; the quotient `S ⧸ IS` is an `R ⧸ I`-algebra because the
composite `R → S → S/IS` kills `I`, and the induced map sends `mk I r` to
`mk IS (algebraMap R S r)`.

## Outline

Lift generators `t` of `S/IS` over `R/I` to a finite set `liftSet ⊆ S` and put
`A := adjoin R liftSet`. Then `A` maps onto `S/IS`, because the `R/I`-subalgebra
generated by `t` is everything and is contained in the `R`-subalgebra generated by the
same set; hence `⊤ ≤ A.toSubmodule ⊔ I • ⊤`, every `x` differing from an element of `A`
by something in `IS = I • ⊤`. Since also `I • A ≤ A`, iterating and using `I ^ m = 0`
gives `⊤ ≤ A.toSubmodule ⊔ I ^ m • ⊤ = A.toSubmodule`, so `A = ⊤` and `S` is generated
over `R` by the finite set `liftSet`.
-/

@[expose] public section

open Algebra in
/-- Any `R`-subalgebra of `B` is also an `R ⧸ I`-subalgebra, the scalar map `R → R ⧸ I`
being surjective; hence the `R ⧸ I`-subalgebra generated by `X` is contained in the
`R`-subalgebra generated by `X`. -/
private lemma finiteType_of_isNilpotent_quotient_finiteType.adjoin_subset_helper
    (R : Type*) [CommRing R] (I : Ideal R) (B : Type*) [CommRing B]
    [Algebra (R ⧸ I) B] [Algebra R B] [IsScalarTower R (R ⧸ I) B] (X : Set B) :
    (adjoin (R⧸I) X : Set B) ⊆ (adjoin R X : Set B) := by
  let A : Subalgebra R B := adjoin R X
  let T : Subalgebra (R⧸I) B :=
    { carrier := (A : Set B)
      mul_mem' := fun ha hb => A.mul_mem ha hb
      add_mem' := fun ha hb => A.add_mem ha hb
      one_mem' := A.one_mem
      zero_mem' := A.zero_mem
      algebraMap_mem' := by
        intro c
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective c
        rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
        exact A.algebraMap_mem r }
  exact adjoin_le (S := T) fun _ hx => subset_adjoin hx

/-- From `I • M ≤ M` and `⊤ ≤ M ⊔ I • ⊤`, iterating gives `⊤ ≤ M ⊔ I ^ (k+1) • ⊤` for
every `k`. -/
private lemma finiteType_of_isNilpotent_quotient_finiteType.iterate_helper
    (R : Type*) [CommRing R] (S : Type*) [CommRing S] [Algebra R S]
    (I : Ideal R) (M : Submodule R S)
    (hIM : I • M ≤ M)
    (hstep : (⊤ : Submodule R S) ≤ M ⊔ I • ⊤) :
    ∀ k : ℕ, (⊤ : Submodule R S) ≤ M ⊔ (I^(k+1)) • (⊤ : Submodule R S) := by
  intro k
  induction k with
  | zero => simpa using hstep
  | succ n ih =>
      have h1 : I • (⊤ : Submodule R S) ≤ M ⊔ I^(n+2) • ⊤ := by
        calc I • (⊤ : Submodule R S) ≤ I • (M ⊔ I^(n+1) • ⊤) := Submodule.smul_mono le_rfl ih
          _ = I • M ⊔ I • (I^(n+1) • ⊤) := by rw [Submodule.smul_sup]
          _ = I • M ⊔ (I * I^(n+1)) • ⊤ := by rw [Submodule.mul_smul]
          _ = I • M ⊔ I^(n+2) • ⊤ := by ring_nf
          _ ≤ M ⊔ I^(n+2) • ⊤ := sup_le_sup_right hIM _
      exact hstep.trans (sup_le le_sup_left h1)

open Algebra in
/-- **Stacks Tag 0G8U (Lemma 10.126.8).** Let `R` be a ring, let `I` be a nilpotent ideal
of `R`, and let `S` be an `R`-algebra such that the induced ring map `R ⧸ I → S ⧸ IS` is
of finite type. Then the structure map `R → S` is of finite type. -/
@[stacks 0G8U, sga "3 VIB 1.3.0" "(i)"]
theorem finiteType_of_isNilpotent_quotient_finiteType
    (R : Type*) [CommRing R] (I : Ideal R)
    (S : Type*) [CommRing S] [Algebra R S]
    (hI : IsNilpotent I)
    (hft : Algebra.FiniteType (R ⧸ I) (S ⧸ I.map (algebraMap R S))) :
    Algebra.FiniteType R S := by
  set IS : Ideal S := I.map (algebraMap R S)
  let f : S →ₐ[R] S ⧸ IS := Ideal.Quotient.mkₐ R IS
  have hfsurj : Function.Surjective f := Ideal.Quotient.mk_surjective
  obtain ⟨t, htfin, htgen⟩ := Subalgebra.fg_def.mp hft.out
  let g : (S ⧸ IS) → S := Function.surjInv hfsurj
  let liftSet : Set S := g '' t
  let A : Subalgebra R S := adjoin R liftSet
  have hmap : Subalgebra.map f A = ⊤ := by
    rw [AlgHom.map_adjoin, show f '' liftSet = t from
      Function.LeftInverse.image_image (Function.surjInv_eq hfsurj) t]
    exact eq_top_iff.mpr fun x _ =>
      finiteType_of_isNilpotent_quotient_finiteType.adjoin_subset_helper R I (S ⧸ IS) t
        (by simp [htgen])
  have hstep : (⊤ : Submodule R S) ≤ A.toSubmodule ⊔ I • ⊤ := by
    intro x _
    obtain ⟨a, ha, hfa⟩ : f x ∈ Subalgebra.map f A := by simp [hmap]
    have hxa : x - a ∈ I • (⊤ : Submodule R S) := by
      rw [Ideal.smul_top_eq_map]
      exact Ideal.Quotient.eq.mp hfa.symm
    rw [show x = a + (x - a) by ring]
    exact Submodule.add_mem_sup ha hxa
  have hIM : I • A.toSubmodule ≤ A.toSubmodule :=
    Submodule.smul_le.mpr fun r _ n hn => A.toSubmodule.smul_mem r hn
  obtain ⟨m, hm⟩ := hI
  have hAtop : A.toSubmodule = ⊤ := by
    have key := finiteType_of_isNilpotent_quotient_finiteType.iterate_helper R S I
      A.toSubmodule hIM hstep m
    rw [pow_succ, hm, zero_mul] at key
    simpa using key
  refine ⟨Subalgebra.fg_def.mpr ⟨liftSet, htfin.image g, Subalgebra.toSubmodule_injective ?_⟩⟩
  rw [hAtop]
  rfl
