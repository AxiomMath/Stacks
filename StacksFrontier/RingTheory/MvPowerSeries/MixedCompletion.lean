module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.Completeness
public import StacksFrontier.RingTheory.AdicCompletion.Algebraization
public import StacksFrontier.RingTheory.AdicCompletion.IteratedMvPolynomial
public import StacksFrontier.RingTheory.CompleteLocalRing.CohenStructureTheorem
public import StacksFrontier.RingTheory.MvPowerSeries.PolynomialTruncation
public import StacksFrontier.RingTheory.MvPowerSeries.AdicTopology

/-!
# The completion of a polynomial ring at a mixed maximal ideal is a power series ring

Let `R` be a Noetherian local ring with maximal ideal `𝔪` and let `A` be its completion. The
ideal `𝔫 = 𝔪 · R[x_0, …, x_{n-1}] + (x_0, …, x_{n-1})` of the polynomial ring is maximal, with
the same residue field as `R`, and this file identifies the `𝔫`-adic completion of
`R[x_0, …, x_{n-1}]` with the power series ring `A⟦x_0, …, x_{n-1}⟧`.

This is the statement that computes a completed local ring of an affine space, or of a closed
subscheme of one, at a point lying over the closed point of the base: combined with
`adicCompletionQuotientAlgEquiv`, which says that completion commutes with a quotient over a
Noetherian ring, it computes the completion of `R[x_0, …, x_{n-1}] ⧸ J` at the image of `𝔫` as
`A⟦x_0, …, x_{n-1}⟧ ⧸ J A⟦x_0, …, x_{n-1}⟧`.

## Main definitions

* `Stacks.MixedCompletion.polyMixed` — the ideal `I · B[x] + (x_0, …, x_{n-1})`.
* `Stacks.MixedCompletion.seriesMixed` — the ideal `I · B⟦x⟧ + (x_0, …, x_{n-1})`.
* `Stacks.MixedCompletion.coeffIdeal` — the ideal of power series whose coefficient at a
  multidegree `d` lies in `I ^ (N - |d|)`; it contains `seriesMixed I n ^ N`.
* `Stacks.MixedCompletion.toSeries` — the comparison map `R[x] → A⟦x⟧`.

## Main results

* `Stacks.MixedCompletion.seriesMixed_pow_le_coeffIdeal` — a power of the mixed ideal of a power
  series ring is contained in the corresponding coefficient ideal.
* `Stacks.MixedCompletion.mem_polyMixed_pow_of_coeff_mem` — the reverse containment for
  polynomials, where the finiteness of the support makes it available.
* `Stacks.MixedCompletion.quotEquiv` — the comparison map is an isomorphism modulo every power of
  the mixed ideal.
* `Stacks.MixedCompletion.polynomialAdicCompletionAlgEquiv` — **the completion of the polynomial
  ring at the mixed maximal ideal is the power series ring over the completed base**, as
  `R`-algebras, and it carries the canonical image of a polynomial to its image under the
  comparison map.

## Implementation notes

The two containments are proved separately because only one of them holds in both rings: a power
series in `𝔫 ^ N` has its coefficient at `d` in `𝔪 ^ (N - |d|)`, because `𝔫 ^ N` is generated by
products of `N` of the generators `C a` and `x_i`; and a *polynomial* whose coefficients satisfy
that condition lies in `𝔫 ^ N`, because it is a finite sum of monomials each of which visibly
does. For a power series the second containment fails, which is why the comparison is set up
between the polynomial ring and the power series ring rather than inside one of them.

Multidegrees are measured by `∑ i, d i`, as in
`StacksFrontier/RingTheory/MvPowerSeries/PolynomialTruncation.lean`, whose description of a power of
the ideal of variables by the vanishing of low-degree coefficients supplies both the truncation
used for surjectivity and the membership of a monomial used for the polynomial containment.

Truncated subtraction of naturals is the right convention for the exponent `N - |d|`: a
coefficient in total degree at least `N` is unconstrained.
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace Stacks.MixedCompletion

/-! ### The mixed ideal and its coefficientwise description -/

section Ideals

variable {B : Type u} [CommRing B]

/-- The ideal `I · B[x_0, …, x_{n-1}] + (x_0, …, x_{n-1})` of a polynomial ring. For `I` the
maximal ideal of a local ring `B` it is the maximal ideal at the origin of the fibre over the
closed point. -/
public def polyMixed (I : Ideal B) (n : ℕ) : Ideal (MvPolynomial (Fin n) B) :=
  I.map MvPolynomial.C ⊔
    Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B))

/-- The ideal `I · B⟦x_0, …, x_{n-1}⟧ + (x_0, …, x_{n-1})` of a power series ring. For `I` the
maximal ideal of a local ring `B` it is the maximal ideal of the power series ring. -/
public def seriesMixed (I : Ideal B) (n : ℕ) : Ideal (MvPowerSeries (Fin n) B) :=
  I.map MvPowerSeries.C ⊔
    Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) B))

/-- The extension of `I` along the constant polynomials is contained in `polyMixed I n`. -/
public theorem map_C_le_polyMixed (I : Ideal B) (n : ℕ) :
    I.map MvPolynomial.C ≤ polyMixed I n := by
  rw [polyMixed]; exact le_sup_left

/-- The ideal generated by the variables is contained in `polyMixed I n`. -/
public theorem span_X_le_polyMixed (I : Ideal B) (n : ℕ) :
    Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B)) ≤
      polyMixed I n := by
  rw [polyMixed]; exact le_sup_right

/-- The extension of `I` along the constant power series is contained in `seriesMixed I n`. -/
public theorem map_C_le_seriesMixed (I : Ideal B) (n : ℕ) :
    I.map MvPowerSeries.C ≤ seriesMixed I n := by
  rw [seriesMixed]; exact le_sup_left

/-- The ideal generated by the variables is contained in `seriesMixed I n`. -/
public theorem span_X_le_seriesMixed (I : Ideal B) (n : ℕ) :
    Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) B)) ≤
      seriesMixed I n := by
  rw [seriesMixed]; exact le_sup_right

/-- A multidegree with total degree zero is zero. -/
private theorem eq_zero_of_sum_eq_zero {n : ℕ} {d : Fin n →₀ ℕ} (h : ∑ i, d i = 0) : d = 0 := by
  ext j
  simpa using Finset.sum_eq_zero_iff.mp h j (Finset.mem_univ j)

/-- The ideal of power series whose coefficient at a multidegree `d` lies in `I ^ (N - |d|)`,
where `|d| = ∑ i, d i`. It is an ideal because multiplying by an arbitrary series only moves a
coefficient of the factor to a higher degree. -/
public def coeffIdeal (I : Ideal B) (n N : ℕ) : Ideal (MvPowerSeries (Fin n) B) where
  carrier := {f | ∀ d : Fin n →₀ ℕ, MvPowerSeries.coeff d f ∈ I ^ (N - ∑ i, d i)}
  add_mem' := fun {f g} hf hg d => by
    simpa using Ideal.add_mem _ (hf d) (hg d)
  zero_mem' := fun d => by simp
  smul_mem' := fun c f hf d => by
    classical
    rw [smul_eq_mul, MvPowerSeries.coeff_mul]
    refine Ideal.sum_mem _ fun p hp => ?_
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
    have hcoord : ∀ i, d i = p.1 i + p.2 i := fun i => by rw [← hp]; simp
    have hsum : ∑ i, d i = (∑ i, p.1 i) + (∑ i, p.2 i) := by
      simp only [hcoord]
      exact Finset.sum_add_distrib
    refine Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right ?_ (hf p.2))
    omega

/-- A power series lies in `coeffIdeal I n N` if and only if its coefficient at every
multidegree `d` lies in `I ^ (N - ∑ i, d i)`. -/
@[simp] public theorem mem_coeffIdeal {I : Ideal B} {n N : ℕ} {f : MvPowerSeries (Fin n) B} :
    f ∈ coeffIdeal I n N ↔
      ∀ d : Fin n →₀ ℕ, MvPowerSeries.coeff d f ∈ I ^ (N - ∑ i, d i) :=
  Iff.rfl

/-- The coefficient ideals are multiplicative: the product of the `a`-th and the `b`-th lands in
the `(a + b)`-th. -/
public theorem coeffIdeal_mul_le (I : Ideal B) (n a b : ℕ) :
    coeffIdeal I n a * coeffIdeal I n b ≤ coeffIdeal I n (a + b) := by
  classical
  rw [Ideal.mul_le]
  intro f hf g hg d
  rw [MvPowerSeries.coeff_mul]
  refine Ideal.sum_mem _ fun p hp => ?_
  rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
  have hcoord : ∀ i, d i = p.1 i + p.2 i := fun i => by rw [← hp]; simp
  have hsum : ∑ i, d i = (∑ i, p.1 i) + (∑ i, p.2 i) := by
    simp only [hcoord]
    exact Finset.sum_add_distrib
  have hmul : MvPowerSeries.coeff p.1 f * MvPowerSeries.coeff p.2 g ∈
      I ^ ((a - ∑ i, p.1 i) + (b - ∑ i, p.2 i)) := by
    rw [pow_add]
    exact Ideal.mul_mem_mul (hf p.1) (hg p.2)
  exact Ideal.pow_le_pow_right (by omega) hmul

/-- The mixed ideal lies in the first coefficient ideal: an element of `I · B⟦x⟧ + (x)` has its
constant coefficient in `I`. -/
public theorem seriesMixed_le_coeffIdeal_one (I : Ideal B) (n : ℕ) :
    seriesMixed I n ≤ coeffIdeal I n 1 := by
  rw [seriesMixed]
  refine sup_le (fun f hf d => ?_) (Ideal.span_le.2 ?_)
  · refine Ideal.pow_le_pow_right (Nat.sub_le 1 _) ?_
    rw [pow_one]
    exact MvPowerSeries.coeff_mem_of_mem_map_C hf d
  · rintro _ ⟨i, rfl⟩
    intro d
    rcases Nat.eq_zero_or_pos (∑ j, d j) with h0 | hpos
    · obtain rfl := eq_zero_of_sum_eq_zero h0
      simp
    · have hz : 1 - ∑ j, d j = 0 := by omega
      rw [hz]
      simp

/-- **A power of the mixed ideal of a power series ring, coefficientwise.** A series in the
`N`-th power of `I · B⟦x⟧ + (x)` has its coefficient at `d` in `I ^ (N - |d|)`. -/
public theorem seriesMixed_pow_le_coeffIdeal (I : Ideal B) (n N : ℕ) :
    seriesMixed I n ^ N ≤ coeffIdeal I n N := by
  induction N with
  | zero =>
      rw [SetLike.le_def]
      intro f _
      rw [mem_coeffIdeal]
      intro d
      simp
  | succ N ih =>
      rw [pow_succ]
      exact (Ideal.mul_mono ih (seriesMixed_le_coeffIdeal_one I n)).trans
        (coeffIdeal_mul_le I n N 1)

/-- **A power of the mixed ideal of a polynomial ring, coefficientwise.** A polynomial whose
coefficient at every `d` lies in `I ^ (N - |d|)` lies in the `N`-th power of `I · B[x] + (x)`: it
is the finite sum of its monomials, and the monomial at `d` is the product of a constant in
`I ^ (N - |d|)` with a monomial in the `|d|`-th power of the ideal of variables. -/
public theorem mem_polyMixed_pow_of_coeff_mem {I : Ideal B} {n N : ℕ}
    {p : MvPolynomial (Fin n) B}
    (hp : ∀ d : Fin n →₀ ℕ, MvPolynomial.coeff d p ∈ I ^ (N - ∑ i, d i)) :
    p ∈ polyMixed I n ^ N := by
  classical
  rw [MvPolynomial.as_sum p]
  refine Ideal.sum_mem _ fun d _ => ?_
  have hmon : (MvPolynomial.monomial d (1 : B)) ∈ polyMixed I n ^ (∑ i, d i) := by
    refine Ideal.pow_right_mono (span_X_le_polyMixed I n) _ ?_
    rw [Stacks.MvPowerSeries.RegularParameters.mem_pow_span_range_MvPolynomial_X_iff]
    intro e he
    have hne : d ≠ e := by
      intro hde
      rw [hde] at he
      exact lt_irrefl _ he
    rw [MvPolynomial.coeff_monomial, if_neg hne]
  have hC : (MvPolynomial.C (MvPolynomial.coeff d p)) ∈ polyMixed I n ^ (N - ∑ i, d i) := by
    refine Ideal.pow_right_mono (map_C_le_polyMixed I n) _ ?_
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ (hp d)
  have hprod : MvPolynomial.C (MvPolynomial.coeff d p) * MvPolynomial.monomial d (1 : B) ∈
      polyMixed I n ^ ((N - ∑ i, d i) + ∑ i, d i) := by
    rw [pow_add]
    exact Ideal.mul_mem_mul hC hmon
  have hmem : MvPolynomial.C (MvPolynomial.coeff d p) * MvPolynomial.monomial d (1 : B) ∈
      polyMixed I n ^ N := Ideal.pow_le_pow_right (by omega) hprod
  rwa [MvPolynomial.C_mul_monomial, mul_one] at hmem

/-! ### The mixed ideal is the kernel of evaluation at the origin -/

/-- The ideal of variables is killed by evaluating at the origin with coefficients reduced
modulo `I`. -/
public theorem span_X_le_ker_eval (I : Ideal B) (n : ℕ) :
    Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B)) ≤
      RingHom.ker (MvPolynomial.eval₂Hom (Ideal.Quotient.mk I)
        (fun _ : Fin n => (0 : B ⧸ I))) := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  simp [RingHom.mem_ker]

/-- **The mixed ideal is the kernel of evaluation at the origin of the fibre.** A polynomial lies
in `I · B[x] + (x)` exactly when its constant term lies in `I`. -/
public theorem polyMixed_eq_ker_eval (I : Ideal B) (n : ℕ) :
    polyMixed I n =
      RingHom.ker (MvPolynomial.eval₂Hom (Ideal.Quotient.mk I)
        (fun _ : Fin n => (0 : B ⧸ I))) := by
  classical
  refine le_antisymm ?_ ?_
  · rw [polyMixed]
    refine sup_le ?_ (span_X_le_ker_eval I n)
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem.2 ha]
  · intro p hp
    have hsplit : p - MvPolynomial.C (MvPolynomial.coeff 0 p) ∈
        Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B)) := by
      rw [← pow_one (Ideal.span (Set.range
          (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B))),
        Stacks.MvPowerSeries.RegularParameters.mem_pow_span_range_MvPolynomial_X_iff]
      intro e he
      obtain rfl := eq_zero_of_sum_eq_zero (by omega : ∑ i, e i = 0)
      simp
    have hc : MvPolynomial.coeff 0 p ∈ I := by
      have h2 : (MvPolynomial.eval₂Hom (Ideal.Quotient.mk I) (fun _ : Fin n => (0 : B ⧸ I)))
          (p - MvPolynomial.C (MvPolynomial.coeff 0 p)) = 0 :=
        RingHom.mem_ker.1 (span_X_le_ker_eval I n hsplit)
      rw [map_sub, RingHom.mem_ker.1 hp, zero_sub, neg_eq_zero] at h2
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      simpa using h2
    have hdecomp : p = MvPolynomial.C (MvPolynomial.coeff 0 p) +
        (p - MvPolynomial.C (MvPolynomial.coeff 0 p)) := by ring
    rw [hdecomp]
    exact Ideal.add_mem _ (map_C_le_polyMixed I n (Ideal.mem_map_of_mem _ hc))
      (span_X_le_polyMixed I n hsplit)

/-- **The mixed ideal of a maximal ideal is maximal**: the residue field at the origin of the
fibre over the closed point is the residue field of the base. -/
public theorem polyMixed_isMaximal (I : Ideal B) [I.IsMaximal] (n : ℕ) :
    (polyMixed I n).IsMaximal := by
  let : Field (B ⧸ I) := Ideal.Quotient.field I
  rw [polyMixed_eq_ker_eval]
  refine RingHom.ker_isMaximal_of_surjective _ ?_
  intro z
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact ⟨MvPolynomial.C b, by simp⟩

/-- **A constant lies in the mixed ideal exactly when it lies in the base ideal.** -/
public theorem C_mem_polyMixed_iff {I : Ideal B} {n : ℕ} {b : B} :
    (MvPolynomial.C b : MvPolynomial (Fin n) B) ∈ polyMixed I n ↔ b ∈ I := by
  rw [polyMixed_eq_ker_eval, RingHom.mem_ker, MvPolynomial.eval₂Hom_C,
    Ideal.Quotient.eq_zero_iff_mem]

/-- **The mixed ideal is compatible with a change of coefficients**: the image of `polyMixed I n`
under a ring map of coefficients is the mixed ideal of the image of `I`. -/
public theorem map_polyMixed {B' : Type*} [CommRing B'] (φ : B →+* B') (I : Ideal B) (n : ℕ) :
    (polyMixed I n).map (MvPolynomial.map φ) = polyMixed (I.map φ) n := by
  have hC : (MvPolynomial.map (σ := Fin n) φ).comp MvPolynomial.C =
      (MvPolynomial.C : B' →+* MvPolynomial (Fin n) B').comp φ :=
    RingHom.ext fun b => MvPolynomial.map_C φ b
  have hX : (MvPolynomial.map (σ := Fin n) φ) ''
      Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B) =
      Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) B') := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i => MvPolynomial.map_X φ i)
  rw [polyMixed, polyMixed, Ideal.map_sup, Ideal.map_map, hC, ← Ideal.map_map, Ideal.map_span, hX]

/-- **The mixed ideal of a prime ideal is prime**: the quotient is the residue ring of the base
at that prime, because the mixed ideal is the kernel of evaluation at the origin of the fibre. -/
public theorem polyMixed_isPrime (I : Ideal B) [I.IsPrime] (n : ℕ) :
    (polyMixed I n).IsPrime := by
  let : IsDomain (B ⧸ I) := Ideal.Quotient.isDomain I
  rw [polyMixed_eq_ker_eval, RingHom.ker_eq_comap_bot]
  exact Ideal.comap_isPrime _ _

end Ideals

/-! ### The comparison map -/

section Comparison

variable (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (n : ℕ)

/-- The comparison homomorphism `R[x_0, …, x_{n-1}] → A⟦x_0, …, x_{n-1}⟧`, where `A` is the
completion of `R`: complete the coefficients and regard the polynomial as a power series. -/
public def toSeries :
    MvPolynomial (Fin n) R →ₐ[R]
      MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R) :=
  { MvPolynomial.coeToMvPowerSeries.ringHom.comp
      (MvPolynomial.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) with
    commutes' := fun r => by
      change ((MvPolynomial.map (algebraMap R (AdicCompletion (maximalIdeal R) R))
          (algebraMap R (MvPolynomial (Fin n) R) r) :
            MvPolynomial (Fin n) (AdicCompletion (maximalIdeal R) R)) :
          MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) = _
      rw [MvPolynomial.algebraMap_eq, MvPolynomial.map_C, MvPolynomial.coe_C,
        MvPowerSeries.algebraMap_apply] }

omit [IsNoetherianRing R] in
/-- `toSeries R n p` is the polynomial `p` with its coefficients mapped into the completion,
regarded as a power series. -/
public theorem toSeries_apply (p : MvPolynomial (Fin n) R) :
    toSeries R n p =
      ((MvPolynomial.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) p :
        MvPolynomial (Fin n) (AdicCompletion (maximalIdeal R) R)) :
          MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) := rfl

omit [IsNoetherianRing R] in
/-- The coefficient of `toSeries R n p` at `d` is the image in the completion of the
coefficient of `p` at `d`. -/
@[simp] public theorem coeff_toSeries (p : MvPolynomial (Fin n) R) (d : Fin n →₀ ℕ) :
    MvPowerSeries.coeff d (toSeries R n p) =
      algebraMap R (AdicCompletion (maximalIdeal R) R) (MvPolynomial.coeff d p) := by
  rw [toSeries_apply, MvPolynomial.coeff_coe, MvPolynomial.coeff_map]

omit [IsNoetherianRing R] in
/-- The comparison map sends each polynomial variable to the corresponding power series
variable. -/
@[simp] public theorem toSeries_X (i : Fin n) :
    toSeries R n (MvPolynomial.X i) = MvPowerSeries.X i := by
  rw [toSeries_apply, MvPolynomial.map_X, MvPolynomial.coe_X]

/-- The comparison map carries the mixed ideal of the polynomial ring into the mixed ideal of
the power series ring. -/
public theorem map_polyMixed_le_seriesMixed :
    (polyMixed (maximalIdeal R) n).map (toSeries R n).toRingHom ≤
      seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n := by
  rw [polyMixed, Ideal.map_sup, Ideal.map_map, Ideal.map_span]
  refine sup_le ?_ (Ideal.span_le.2 ?_)
  · have hcomp : (toSeries R n).toRingHom.comp
        (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) =
        (MvPowerSeries.C : AdicCompletion (maximalIdeal R) R →+*
            MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)).comp
          (algebraMap R (AdicCompletion (maximalIdeal R) R)) := by
      refine RingHom.ext fun r => ?_
      show toSeries R n (MvPolynomial.C r) = _
      rw [toSeries_apply, MvPolynomial.map_C, MvPolynomial.coe_C]
      rfl
    rw [hcomp, ← Ideal.map_map, ← AdicCompletion.maximalIdeal_eq_map]
    exact map_C_le_seriesMixed _ n
  · rintro _ ⟨y, ⟨i, rfl⟩, rfl⟩
    refine span_X_le_seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n ?_
    refine Ideal.subset_span ⟨i, ?_⟩
    exact (toSeries_X R n i).symm

/-- A power of the mixed ideal is carried into the corresponding power. -/
public theorem map_polyMixed_pow_le (N : ℕ) :
    (polyMixed (maximalIdeal R) n ^ N).map (toSeries R n).toRingHom ≤
      seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n ^ N := by
  rw [Ideal.map_pow]
  exact Ideal.pow_right_mono (map_polyMixed_le_seriesMixed R n) N

/-- **The comparison map detects the powers of the mixed ideal.** A polynomial whose image lies
in the `N`-th power of the mixed ideal of the power series ring already lies in the `N`-th power
of the mixed ideal of the polynomial ring, because the completion map `R → A` detects `𝔪 ^ k`. -/
public theorem mem_polyMixed_pow_of_toSeries_mem {N : ℕ} {p : MvPolynomial (Fin n) R}
    (hp : toSeries R n p ∈
      seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n ^ N) :
    p ∈ polyMixed (maximalIdeal R) n ^ N := by
  have hfg : (maximalIdeal R).FG := IsNoetherian.noetherian _
  refine mem_polyMixed_pow_of_coeff_mem fun d => ?_
  have h1 := mem_coeffIdeal.1 (seriesMixed_pow_le_coeffIdeal _ n N hp) d
  rw [coeff_toSeries, AdicCompletion.maximalIdeal_eq_map, ← Ideal.map_pow] at h1
  exact (AdicCompletion.algebraMap_mem_map_pow_iff _ hfg _ _).1 h1

/-- A polynomial with coefficients in an ideal `J` lies, as a power series, in the extension
of `J`. -/
private theorem coe_mem_map_C_of_mem_map_C {S σ : Type*} [CommRing S] {J : Ideal S}
    {q : MvPolynomial σ S} (hq : q ∈ Ideal.map MvPolynomial.C J) :
    (q : MvPowerSeries σ S) ∈ Ideal.map MvPowerSeries.C J := by
  have hmap :=
    Ideal.mem_map_of_mem (MvPolynomial.coeToMvPowerSeries.ringHom (σ := σ) (R := S)) hq
  rw [Ideal.map_map] at hmap
  have hcompC : (MvPolynomial.coeToMvPowerSeries.ringHom (σ := σ) (R := S)).comp
      MvPolynomial.C = MvPowerSeries.C := by
    refine RingHom.ext fun a => ?_
    show ((MvPolynomial.C a : MvPolynomial σ S) : MvPowerSeries σ S) = _
    rw [MvPolynomial.coe_C]
  rwa [hcompC] at hmap

/-- Every polynomial over the completion of `R` is congruent, modulo the extension of `𝔪 ^ N`,
to the image of a polynomial over `R`. -/
private theorem exists_sub_map_mem_map_C (N : ℕ)
    (q : MvPolynomial (Fin n) (AdicCompletion (maximalIdeal R) R)) :
    ∃ p : MvPolynomial (Fin n) R,
      q - MvPolynomial.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) p ∈
        Ideal.map MvPolynomial.C
          ((maximalIdeal R ^ N).map (algebraMap R (AdicCompletion (maximalIdeal R) R))) := by
  classical
  have hfg : (maximalIdeal R).FG := IsNoetherian.noetherian _
  choose r hr using fun d : Fin n →₀ ℕ =>
    AdicCompletion.exists_sub_mem_map_pow (maximalIdeal R) hfg N (MvPolynomial.coeff d q)
  set p : MvPolynomial (Fin n) R := ∑ d ∈ q.support, MvPolynomial.monomial d (r d) with hpdef
  have hcoeffp : ∀ e : Fin n →₀ ℕ,
      MvPolynomial.coeff e p = if e ∈ q.support then r e else 0 := by
    intro e
    rw [hpdef, MvPolynomial.coeff_sum]
    simp [MvPolynomial.coeff_monomial, Finset.sum_ite_eq']
  refine ⟨p, ?_⟩
  rw [MvPolynomial.mem_map_C_iff]
  intro e
  rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_map, hcoeffp]
  by_cases he : e ∈ q.support
  · rw [if_pos he]
    exact hr e
  · rw [if_neg he, map_zero, MvPolynomial.notMem_support_iff.mp he, sub_zero]
    exact Submodule.zero_mem _

/-- **The comparison map is surjective modulo every power of the mixed ideal.** Truncate the
series to a polynomial over `A`, then approximate each of its finitely many coefficients by an
element of `R`. -/
public theorem exists_sub_toSeries_mem (N : ℕ)
    (f : MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) :
    ∃ p : MvPolynomial (Fin n) R, f - toSeries R n p ∈
      seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n ^ N := by
  obtain ⟨q, hq⟩ :=
    Stacks.MvPowerSeries.RegularParameters.exists_polynomial_sub_mem_pow_span_range_X N f
  obtain ⟨p, hp⟩ := exists_sub_map_mem_map_C R n N q
  have hsub := map_sub (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin n)
    (R := AdicCompletion (maximalIdeal R) R)) q
    (MvPolynomial.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) p)
  simp only [MvPolynomial.coeToMvPowerSeries.ringHom_apply] at hsub
  refine ⟨p, ?_⟩
  rw [show f - toSeries R n p = (f - (q : MvPowerSeries (Fin n) _)) +
      ((q - MvPolynomial.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) p :
        MvPolynomial (Fin n) _) : MvPowerSeries (Fin n) _) by
    rw [toSeries_apply, hsub]; ring]
  refine Ideal.add_mem _ (Ideal.pow_right_mono
    (span_X_le_seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n) N hq) ?_
  have hgoal : Ideal.map (MvPowerSeries.C :
        AdicCompletion (maximalIdeal R) R →+*
          MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))
        ((maximalIdeal R ^ N).map (algebraMap R (AdicCompletion (maximalIdeal R) R))) ≤
      seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n ^ N := by
    rw [Ideal.map_pow, ← AdicCompletion.maximalIdeal_eq_map, Ideal.map_pow]
    exact Ideal.pow_right_mono
      (map_C_le_seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n) N
  exact hgoal (coe_mem_map_C_of_mem_map_C hp)

/-! ### The induced isomorphisms of quotients and of completions -/

/-- **The comparison map is an isomorphism modulo every power of the mixed ideal.** -/
public def quotEquiv (N : ℕ) :
    (MvPolynomial (Fin n) R ⧸ polyMixed (maximalIdeal R) n ^ N) ≃ₐ[R]
      (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R) ⧸
        seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n ^ N) :=
  AlgEquiv.ofBijective
    (Ideal.quotientMapₐ _ (toSeries R n)
      (Ideal.map_le_iff_le_comap.1 (map_polyMixed_pow_le R n N)))
    (by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [Ideal.Quotient.eq_zero_iff_mem]
        refine mem_polyMixed_pow_of_toSeries_mem R n ?_
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact hx
      · intro y
        obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨p, hp⟩ := exists_sub_toSeries_mem R n N g
        refine ⟨Ideal.Quotient.mk _ p, ?_⟩
        exact ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).2 hp).symm)

/-- `quotEquiv R n N` sends the class of a polynomial `p` to the class of `toSeries R n p`. -/
public theorem quotEquiv_mk (N : ℕ) (p : MvPolynomial (Fin n) R) :
    quotEquiv R n N (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (toSeries R n p) := rfl

/-- The comparison isomorphisms of quotients are compatible with the transition maps. -/
public theorem quotEquiv_factorPow {m N : ℕ} (h : m ≤ N)
    (x : MvPolynomial (Fin n) R ⧸ polyMixed (maximalIdeal R) n ^ N) :
    Ideal.Quotient.factorPow
        (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n) h
        (quotEquiv R n N x) =
      quotEquiv R n m (Ideal.Quotient.factorPow (polyMixed (maximalIdeal R) n) h x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- The comparison isomorphism of completions. -/
public def toAdicCompletionSeries :
    AdicCompletion (polyMixed (maximalIdeal R) n) (MvPolynomial (Fin n) R) ≃ₐ[R]
      AdicCompletion (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
        (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) :=
  adicCompletionAlgEquivOfQuotientEquiv _ _ (quotEquiv R n) (quotEquiv_factorPow R n)

/-- The comparison isomorphism of completions sends the image of a polynomial `p` to the image
of the power series `toSeries R n p`. -/
@[simp] public theorem toAdicCompletionSeries_of (p : MvPolynomial (Fin n) R) :
    toAdicCompletionSeries R n
        (algebraMap (MvPolynomial (Fin n) R)
          (AdicCompletion (polyMixed (maximalIdeal R) n) (MvPolynomial (Fin n) R)) p) =
      algebraMap (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))
        (AdicCompletion (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
          (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))) (toSeries R n p) := by
  refine AdicCompletion.ext_evalₐ fun N => ?_
  rw [toAdicCompletionSeries, AdicCompletion.evalₐ_adicCompletionAlgEquivOfQuotientEquiv,
    AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply, AdicCompletion.evalₐ_of,
    AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply, AdicCompletion.evalₐ_of,
    quotEquiv_mk]

/-- The mixed ideal of the power series ring over a local ring is its maximal ideal. -/
public theorem seriesMixed_eq_maximalIdeal (C : Type u) [CommRing C] [IsLocalRing C] (m : ℕ) :
    seriesMixed (maximalIdeal C) m = maximalIdeal (MvPowerSeries (Fin m) C) :=
  (Stacks.CompleteLocalRing.RegularSubring.maximalIdeal_mvPowerSeries C m).symm

/-- The power series ring over the completion of `R` is complete for the mixed ideal. -/
public theorem isAdicComplete_seriesMixed :
    IsAdicComplete (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
      (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) := by
  rw [seriesMixed_eq_maximalIdeal]
  exact MvPowerSeries.isAdicComplete_maximalIdeal n (AdicCompletion (maximalIdeal R) R)
    inferInstance

/-- The power series ring over the completion of `R` is its own completion at the mixed
ideal. -/
public def seriesAlgEquivAdicCompletion :
    MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R) ≃ₐ[R]
      AdicCompletion (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
        (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) :=
  AlgEquiv.restrictScalars R
    (AlgEquiv.ofBijective
      (Algebra.ofId (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))
        (AdicCompletion (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
          (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))))
      (by
        have hbij := AdicCompletion.of_bijective_iff.2 (isAdicComplete_seriesMixed R n)
        have hfun : (Algebra.ofId (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))
              (AdicCompletion
                (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
                (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))) :
            MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R) → _) =
            (AdicCompletion.of
              (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
              (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) :
                MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R) → _) := by
          funext b
          rw [Algebra.ofId_apply, AdicCompletion.algebraMap_apply,
            Algebra.algebraMap_self_apply]
        rw [hfun]
        exact hbij))

/-- `seriesAlgEquivAdicCompletion R n` sends a power series to its image in its adic
completion. -/
public theorem seriesAlgEquivAdicCompletion_apply
    (b : MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R)) :
    seriesAlgEquivAdicCompletion R n b =
      algebraMap (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))
        (AdicCompletion (seriesMixed (maximalIdeal (AdicCompletion (maximalIdeal R) R)) n)
          (MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R))) b :=
  Algebra.ofId_apply _ b

/-- **The completion of a polynomial ring at the mixed maximal ideal is a power series ring over
the completed base.** For `R` a Noetherian local ring with completion `A`, the completion of
`R[x_0, …, x_{n-1}]` at `𝔪 · R[x] + (x_0, …, x_{n-1})` is `A⟦x_0, …, x_{n-1}⟧`. -/
public def polynomialAdicCompletionAlgEquiv :
    AdicCompletion (polyMixed (maximalIdeal R) n) (MvPolynomial (Fin n) R) ≃ₐ[R]
      MvPowerSeries (Fin n) (AdicCompletion (maximalIdeal R) R) :=
  (toAdicCompletionSeries R n).trans (seriesAlgEquivAdicCompletion R n).symm

/-- The completion isomorphism carries the canonical image of a polynomial to its image under
the comparison map. -/
@[simp] public theorem polynomialAdicCompletionAlgEquiv_of (p : MvPolynomial (Fin n) R) :
    polynomialAdicCompletionAlgEquiv R n
        (algebraMap (MvPolynomial (Fin n) R)
          (AdicCompletion (polyMixed (maximalIdeal R) n) (MvPolynomial (Fin n) R)) p) =
      toSeries R n p := by
  rw [polynomialAdicCompletionAlgEquiv, AlgEquiv.trans_apply, toAdicCompletionSeries_of,
    ← seriesAlgEquivAdicCompletion_apply, AlgEquiv.symm_apply_apply]

end Comparison

