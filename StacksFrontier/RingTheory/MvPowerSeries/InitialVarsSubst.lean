module

public import Mathlib.RingTheory.MvPowerSeries.Derivative
public import StacksFrontier.RingTheory.MvPowerSeries.CotangentSpace

/-!
# Killing the first variables of a power-series ring

The quotient of `R[[x_0, …, x_{n-1}]]` by the ideal generated by the first `r` variables is
realised by the substitution `x_i ↦ 0` (`i < r`), `x_i ↦ x_{i-r}` (`i ≥ r`) into
`R[[x_0, …, x_{n-r-1}]]`, which has the section `x_j ↦ x_{r+j}`. This substitution preserves
constant terms and intertwines the partial derivatives in the surviving variables.

## Main definitions

* `Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom`: the substitution killing the first
  `r` variables.
* `Stacks.MvPowerSeries.RegularParameters.initialVarsSection`: the section `x_j ↦ x_{r+j}`.

## Main results

* `Stacks.MvPowerSeries.RegularParameters.coeff_initialVarsAlgHom`: its coefficients are read off
  through `Stacks.MvPowerSeries.RegularParameters.QuotInitVars.embedIdx`.
* `Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom_surjective`: it is surjective.
* `Stacks.MvPowerSeries.RegularParameters.ker_initialVarsAlgHom`: its kernel is the ideal generated
  by the first `r` variables.
* `Stacks.MvPowerSeries.RegularParameters.constantCoeff_initialVarsAlgHom`: it preserves constant
  terms.
* `Stacks.MvPowerSeries.RegularParameters.initialVarsAlgHom_pderiv`: differentiating in `x_{r+i}`
  and then substituting is substituting and then differentiating in `x_i`.

## Implementation notes

The commutation with `pderiv` is proved coefficient by coefficient: `embedIdx` is
`Finsupp.mapDomain` along an injective map, so it is additive and carries `Finsupp.single i 1` to
`Finsupp.single (embedFn hr i) 1`, which is exactly the shift `MvPowerSeries.coeff_pderiv`
performs.

## References

* [Stacks Project, Tag 07NM](https://stacks.math.columbia.edu/tag/07NM)
-/

@[expose] public section

open IsLocalRing MvPowerSeries

namespace Stacks.MvPowerSeries.RegularParameters

open QuotInitVars

variable {R : Type*} [CommRing R] {n r : ℕ}

/-- The substitution family sending `x_i` to `0` for `i < r` and to `x_{i-r}` for `i ≥ r`. -/
noncomputable def initialVarsFamily (R : Type*) [CommRing R] (hr : r ≤ n) :
    Fin n → MvPowerSeries (Fin (n - r)) R := fun i =>
  if _h : (i : ℕ) < r then 0 else MvPowerSeries.X ⟨(i : ℕ) - r, by omega⟩

/-- For `i < r`, the substitution family sends `x_i` to `0`. -/
theorem initialVarsFamily_of_lt (hr : r ≤ n) (i : Fin n) (hi : (i : ℕ) < r) :
    initialVarsFamily R hr i = 0 := by
  simp only [initialVarsFamily, dite_eq_left hi]

/-- For `i ≥ r`, the substitution family sends `x_i` to `x_{i-r}`. -/
theorem initialVarsFamily_of_not_lt (hr : r ≤ n) (i : Fin n) (hi : ¬(i : ℕ) < r) :
    initialVarsFamily R hr i = MvPowerSeries.X ⟨(i : ℕ) - r, by omega⟩ := by
  simp only [initialVarsFamily, dite_eq_right hi]

/-- The family `initialVarsFamily R hr` is a valid substitution: all its members have zero
constant coefficient. -/
theorem hasSubst_initialVarsFamily (hr : r ≤ n) :
    MvPowerSeries.HasSubst (initialVarsFamily R hr) :=
  MvPowerSeries.hasSubst_of_constantCoeff_zero fun i => by
    by_cases hi : (i : ℕ) < r
    · rw [initialVarsFamily_of_lt hr i hi, map_zero]
    · rw [initialVarsFamily_of_not_lt hr i hi, MvPowerSeries.constantCoeff_X]

/-- The substitution killing the first `r` variables of `R[[x_0, …, x_{n-1}]]`. -/
noncomputable def initialVarsAlgHom (R : Type*) [CommRing R] (hr : r ≤ n) :
    MvPowerSeries (Fin n) R →ₐ[R] MvPowerSeries (Fin (n - r)) R :=
  MvPowerSeries.substAlgHom (hasSubst_initialVarsFamily hr)

/-- The coefficients of `initialVarsAlgHom` are those of the original series at the exponents
supported on the last `n - r` variables. -/
theorem coeff_initialVarsAlgHom (hr : r ≤ n) (u : MvPowerSeries (Fin n) R)
    (β : Fin (n - r) →₀ ℕ) :
    MvPowerSeries.coeff β (initialVarsAlgHom R hr u) =
      MvPowerSeries.coeff (embedIdx hr β) u := by
  rw [initialVarsAlgHom, MvPowerSeries.substAlgHom_apply]
  exact coeff_subst_forward hr _ (fun i hi => initialVarsFamily_of_lt hr i hi)
    (fun i hi => initialVarsFamily_of_not_lt hr i hi) (hasSubst_initialVarsFamily hr) u β

/-- The ideal generated by the first `r` variables of `R[[x_0, …, x_{n-1}]]`. -/
noncomputable def initialVarsIdeal (R : Type*) [CommRing R] (hr : r ≤ n) :
    Ideal (MvPowerSeries (Fin n) R) :=
  Ideal.span (Set.range fun i : Fin r =>
    (MvPowerSeries.X (Fin.castLE hr i) : MvPowerSeries (Fin n) R))

/-- `initialVarsIdeal R hr` is the span of the variables `x_i` with `i < r`. -/
theorem initialVarsIdeal_eq_span (hr : r ≤ n) :
    initialVarsIdeal R hr = Ideal.span (Set.range fun i : Fin r =>
      (MvPowerSeries.X (Fin.castLE hr i) : MvPowerSeries (Fin n) R)) := rfl

/-- The kernel of `initialVarsAlgHom` is the ideal generated by the first `r` variables. -/
theorem ker_initialVarsAlgHom (hr : r ≤ n) :
    RingHom.ker (initialVarsAlgHom R hr) = initialVarsIdeal R hr :=
  ker_substAlgHom_initial_vars hr _ (fun i hi => initialVarsFamily_of_lt hr i hi)
    (fun i hi => initialVarsFamily_of_not_lt hr i hi) (hasSubst_initialVarsFamily hr)

/-- The section `x_j ↦ x_{r+j}` of `initialVarsAlgHom`. -/
noncomputable def initialVarsSection (R : Type*) [CommRing R] (hr : r ≤ n) :
    MvPowerSeries (Fin (n - r)) R →ₐ[R] MvPowerSeries (Fin n) R :=
  MvPowerSeries.substAlgHom (R := R)
    (MvPowerSeries.hasSubst_of_constantCoeff_zero (a := fun j : Fin (n - r) =>
        (MvPowerSeries.X (embedFn hr j) : MvPowerSeries (Fin n) R))
      fun _ => MvPowerSeries.constantCoeff_X _)

/-- `initialVarsSection` is a right inverse of `initialVarsAlgHom`. -/
theorem initialVarsAlgHom_comp_section (hr : r ≤ n) (z : MvPowerSeries (Fin (n - r)) R) :
    initialVarsAlgHom R hr (initialVarsSection R hr z) = z := by
  have hbsub : MvPowerSeries.HasSubst (fun j : Fin (n - r) =>
      (MvPowerSeries.X (embedFn hr j) : MvPowerSeries (Fin n) R)) :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero fun _ => MvPowerSeries.constantCoeff_X _
  have hasub := hasSubst_initialVarsFamily (R := R) hr
  rw [initialVarsAlgHom, initialVarsSection, MvPowerSeries.substAlgHom_apply,
    MvPowerSeries.substAlgHom_apply, ← Function.comp_apply
      (f := MvPowerSeries.subst (initialVarsFamily R hr))
      (g := MvPowerSeries.subst (fun j : Fin (n - r) =>
        (MvPowerSeries.X (embedFn hr j) : MvPowerSeries (Fin n) R))),
    MvPowerSeries.subst_comp_subst hbsub hasub]
  have hid : (fun j : Fin (n - r) => MvPowerSeries.subst (initialVarsFamily R hr)
      (MvPowerSeries.X (embedFn hr j) : MvPowerSeries (Fin n) R)) = MvPowerSeries.X := by
    funext j
    rw [MvPowerSeries.subst_X hasub,
      initialVarsFamily_of_not_lt hr (embedFn hr j) (by simp only [embedFn_val]; omega)]
    congr 1
    exact Fin.ext (by simp only [embedFn_val]; omega)
  rw [hid, MvPowerSeries.subst_self]
  rfl

/-- The substitution killing the first `r` variables is surjective. -/
theorem initialVarsAlgHom_surjective (hr : r ≤ n) :
    Function.Surjective (initialVarsAlgHom R hr) :=
  fun z => ⟨initialVarsSection R hr z, initialVarsAlgHom_comp_section hr z⟩

/-- Killing the first variables does not change the constant term. -/
@[simp]
theorem constantCoeff_initialVarsAlgHom (hr : r ≤ n) (u : MvPowerSeries (Fin n) R) :
    MvPowerSeries.constantCoeff (initialVarsAlgHom R hr u) = MvPowerSeries.constantCoeff u := by
  rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply,
    ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, coeff_initialVarsAlgHom]
  congr 1

/-- The substitution killing the first `r` variables intertwines the partial derivatives:
differentiating in `x_{r+i}` and then substituting is substituting and then differentiating in
`x_i`. -/
theorem initialVarsAlgHom_pderiv (hr : r ≤ n) (i : Fin (n - r))
    (u : MvPowerSeries (Fin n) R) :
    initialVarsAlgHom R hr (MvPowerSeries.pderiv (embedFn hr i) u) =
      MvPowerSeries.pderiv i (initialVarsAlgHom R hr u) := by
  ext β
  rw [coeff_initialVarsAlgHom, MvPowerSeries.coeff_pderiv, MvPowerSeries.coeff_pderiv,
    coeff_initialVarsAlgHom]
  have hadd : embedIdx hr (β + Finsupp.single i 1) =
      embedIdx hr β + Finsupp.single (embedFn hr i) 1 := by
    simp only [embedIdx, Finsupp.mapDomain_add, Finsupp.mapDomain_single]
  have happ : embedIdx hr β (embedFn hr i) = β i := by
    rw [embedIdx, Finsupp.mapDomain_apply_of_injective (embedFn_injective hr)]
  rw [hadd, happ]

end Stacks.MvPowerSeries.RegularParameters

end
