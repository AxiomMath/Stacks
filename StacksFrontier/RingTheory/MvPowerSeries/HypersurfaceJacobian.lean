/-!
# The Jacobian quotient of a formal hypersurface

Let `k` be a field and `f` a formal power series in `S = k[[x_1, …, x_n]]`. The *Jacobian
ideal* of `f` is the ideal generated by `f` together with its formal derivatives
`∂f/∂x_1, …, ∂f/∂x_n`. This file proves that the quotient of `S` by that ideal is a
finite-dimensional `k`-vector space as soon as the radical of the Jacobian ideal is the ideal
generated by the variables, that is, as soon as the singularity is isolated; and it deduces
that every finite `S`-module annihilated by the Jacobian ideal is finite-dimensional over `k`.

This is the commutative-algebra half of the proof of Tag 0DY5(2): the tangent space of the
deformation category of `P = k[[x_1, …, x_n]]/(f)` is, by the computation of 0DY5(2), a module
over the Jacobian quotient, so this is what makes it finite-dimensional.

The argument is the standard support criterion in the form in which the hypothesis is given.
The radical condition says the Jacobian ideal is primary to the maximal ideal `m` of `S`, so
a power of `m` is contained in it; hence the kernel of the residue map of the Jacobian
quotient is nilpotent, and `Module.finite_of_surjective_of_ker_le_nilradical` descends
finiteness over `k` from the residue field to the whole quotient.

## Main results

* `Stacks.MvPowerSeries.Hypersurface.finiteDimensional_quotient_jacobian`: the quotient of
  `k[[x_1, …, x_n]]` by the Jacobian ideal of `f` is finite-dimensional over `k` under the
  radical condition of Tag 0DY5(2).
* `Stacks.MvPowerSeries.Hypersurface.finiteDimensional_of_jacobian_annihilates`: a finite
  module over `k[[x_1, …, x_n]]` annihilated by the Jacobian ideal is finite-dimensional
  over `k`.

## Implementation notes

The Jacobian ideal is spelled out as `Ideal.span ({f} ∪ Set.range fun i ↦ pderiv k i f)` rather
than abbreviated, so that the radical hypothesis is visibly the one of the source.

The maximal ideal of `k[[x_1, …, x_n]]` is identified with the ideal generated by the variables
by `MvPowerSeries.maximalIdeal_eq_span_range_X`, and the Noetherian hypothesis needed for the
radical argument is Mathlib's `MvPowerSeries.isNoetherianRing`.

## References

* [Stacks Project, Tag 0DY5](https://stacks.math.columbia.edu/tag/0DY5)
-/

@[expose] public section

namespace Stacks.MvPowerSeries.Hypersurface

universe w

/-- An isolated Jacobian ideal contains a power of the maximal ideal: the radical condition
says the maximal ideal is contained in the radical of the Jacobian ideal, and the maximal
ideal is finitely generated. -/
theorem exists_pow_maximalIdeal_le_jacobian
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hjac : (Ideal.span ({f} ∪ Set.range
      (fun i : Fin n => MvPowerSeries.pderiv k i f))).radical =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) :
    ∃ r : ℕ, IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k) ^ r ≤
      Ideal.span ({f} ∪ Set.range (fun i : Fin n => MvPowerSeries.pderiv k i f)) :=
  Ideal.exists_pow_le_of_le_radical_of_fg
    (by rw [hjac, MvPowerSeries.maximalIdeal_eq_span_range_X k n]) (IsNoetherian.noetherian _)

/-- The Jacobian quotient of a formal power series with isolated Jacobian ideal is a finite
module over the base field. -/
theorem moduleFinite_quotient_jacobian
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hjac : (Ideal.span ({f} ∪ Set.range
      (fun i : Fin n => MvPowerSeries.pderiv k i f))).radical =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) :
    Module.Finite k (MvPowerSeries (Fin n) k ⧸
      Ideal.span ({f} ∪ Set.range (fun i : Fin n => MvPowerSeries.pderiv k i f))) := by
  let S := MvPowerSeries (Fin n) k
  let J : Ideal S := Ideal.span
    ({f} ∪ Set.range (fun i : Fin n => MvPowerSeries.pderiv k i f))
  have hrad : J.radical = IsLocalRing.maximalIdeal S := by
    rw [hjac, MvPowerSeries.maximalIdeal_eq_span_range_X k n]
  have hcc : RingHom.ker (MvPowerSeries.constantCoeff : S →+* k) =
      IsLocalRing.maximalIdeal S :=
    IsLocalRing.ker_eq_maximalIdeal
      (MvPowerSeries.constantCoeff : S →+* k)
      (fun c => ⟨MvPowerSeries.C c, by simp⟩)
  have hJcc : J ≤ RingHom.ker (MvPowerSeries.constantCoeff : S →+* k) :=
    Ideal.le_radical.trans (hrad.trans hcc.symm).le
  let cc : S →ₐ[k] k :=
    { toRingHom := MvPowerSeries.constantCoeff
      commutes' := MvPowerSeries.constantCoeff_C }
  let φ : S ⧸ J →ₐ[k] k := Ideal.Quotient.liftₐ J cc fun a ha => RingHom.mem_ker.mp (hJcc ha)
  have hφq : φ.comp (Ideal.Quotient.mkₐ k J) = cc := by
    ext x
    rfl
  have hsurj : Function.Surjective φ := fun c => ⟨Ideal.Quotient.mkₐ k J (MvPowerSeries.C c),
    (DFunLike.congr_fun hφq _).trans (MvPowerSeries.constantCoeff_C c)⟩
  obtain ⟨r, hr⟩ := exists_pow_maximalIdeal_le_jacobian n f hjac
  have hker_nil : RingHom.ker φ.toRingHom ≤ nilradical (S ⧸ J) := by
    intro x hx
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    have ha : a ∈ IsLocalRing.maximalIdeal S := by
      rw [← hcc]
      exact RingHom.mem_ker.mpr (RingHom.mem_ker.mp hx)
    exact mem_nilradical.mpr ⟨r, Ideal.Quotient.eq_zero_iff_mem.mpr (hr (Ideal.pow_mem_pow ha r))⟩
  exact Module.finite_of_surjective_of_ker_le_nilradical φ hsurj hker_nil
    (IsNoetherian.noetherian _)

/-- **Stacks 0DY5(2)**, the commutative-algebra half. Let `k` be a field and `f` a formal power
series in `n` variables over `k` whose Jacobian ideal `(f, ∂f/∂x_1, …, ∂f/∂x_n)` has radical
the ideal generated by the variables. Then `k[[x_1, …, x_n]]` modulo that Jacobian ideal is a
finite-dimensional `k`-vector space. By the computation of Tag 0DY5(2) the tangent space of the
deformation category of `k[[x_1, …, x_n]]/(f)` is a quotient of a finite module over this ring,
which is why the radical condition implies the finite-dimensionality asserted there. -/
theorem finiteDimensional_quotient_jacobian
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hjac : (Ideal.span ({f} ∪ Set.range
      (fun i : Fin n => MvPowerSeries.pderiv k i f))).radical =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) :
    FiniteDimensional k (MvPowerSeries (Fin n) k ⧸
      Ideal.span ({f} ∪ Set.range (fun i : Fin n => MvPowerSeries.pderiv k i f))) :=
  moduleFinite_quotient_jacobian n f hjac

/-- A finite module over a ring which is annihilated by an ideal with finite-dimensional
quotient is finite-dimensional: the module equals its quotient by the ideal, which is finite
over the finite-dimensional quotient ring. -/
theorem finiteDimensional_of_finite_quotient_annihilates
    {k S E : Type*} [Field k] [CommRing S] [Algebra k S]
    [AddCommGroup E] [Module S E] [Module k E] [IsScalarTower k S E]
    [Module.Finite S E] (I : Ideal S) [Module.Finite k (S ⧸ I)]
    (hI : I ≤ Module.annihilator S E) : FiniteDimensional k E := by
  have hbot : I • (⊤ : Submodule S E) = ⊥ := eq_bot_iff.mpr <| Submodule.smul_le.mpr
    fun r hr x _ => (Module.mem_annihilator.mp (hI hr) x).symm ▸ Submodule.zero_mem _
  have hq : Module.Finite k (E ⧸ I • (⊤ : Submodule S E)) :=
    Module.Finite.trans (S ⧸ I) _
  exact Module.Finite.equiv (R := k)
    (((I • (⊤ : Submodule S E)).quotEquivOfEqBot hbot).restrictScalars k)

/-- A finite module over `k[[x_1, …, x_n]]` on which the Jacobian ideal of `f` acts by zero is
finite-dimensional over `k`, when that Jacobian ideal has radical the ideal generated by the
variables. This is the form in which the Jacobian quotient controls the tangent space of
Tag 0DY5(2). -/
theorem finiteDimensional_of_jacobian_annihilates
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hjac : (Ideal.span ({f} ∪ Set.range
      (fun i : Fin n => MvPowerSeries.pderiv k i f))).radical =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k)))
    {E : Type*} [AddCommGroup E] [Module (MvPowerSeries (Fin n) k) E]
    [Module k E] [IsScalarTower k (MvPowerSeries (Fin n) k) E]
    [Module.Finite (MvPowerSeries (Fin n) k) E]
    (hJ : Ideal.span ({f} ∪ Set.range
      (fun i : Fin n => MvPowerSeries.pderiv k i f)) ≤
      Module.annihilator (MvPowerSeries (Fin n) k) E) :
    FiniteDimensional k E := by
  have : Module.Finite k (MvPowerSeries (Fin n) k ⧸
      Ideal.span ({f} ∪ Set.range (fun i : Fin n => MvPowerSeries.pderiv k i f))) :=
    moduleFinite_quotient_jacobian n f hjac
  exact finiteDimensional_of_finite_quotient_annihilates _ hJ

end Stacks.MvPowerSeries.Hypersurface

end
