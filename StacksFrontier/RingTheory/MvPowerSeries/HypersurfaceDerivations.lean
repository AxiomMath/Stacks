/-!
# Derivations of a formal hypersurface (Stacks 0DY5)

Let `k` be a field and `f` a nonzero formal power series in `k[[x_1, …, x_n]]` lying in the
square of the ideal generated by the variables. This file shows that the `k`-derivations of
`P = k[[x_1, …, x_n]]/(f)` into itself form a finite-dimensional `k`-vector space exactly when
`n = 1`.

For `n = 1` the hypothesis `f ≠ 0` forces `(f) = (x ^ d)` with `d` the order of `f`, because a
nonzero power series in one variable is `x ^ d` times a unit; so `P` is spanned over `k` by the
powers `1, x, …, x ^ (d - 1)` and the derivations, being a subspace of the `k`-linear
endomorphisms of `P`, are finite-dimensional.

For `n ≥ 2` the ring `P` has positive Krull dimension: `k[[x_1, …, x_n]]` is a regular local
ring of dimension `n` and `f` is a nonzerodivisor in its maximal ideal, so dividing by `f`
drops the dimension by exactly one. Pick a prime `q` of `P` which is not maximal and an element
`x` of the maximal ideal outside `q`. A vector `v` with `∑ v i * ∂f/∂x i = 0` in `P` gives a
derivation `D` of `P` sending the class of `x i` to `v i`, and `n ≥ 2` allows such a `v` to be
chosen with some `v j` nonzero in the localization of `P` at `q` — either a Koszul relation
between two of the partials, or a witness that one of them already vanishes there. Then
`p ↦ p(x) • D` is an injective `k`-linear map from the polynomial ring `k[X]` into the
derivations: for `p ≠ 0` the value `p(x)` is a unit in that localization, since factoring out
the powers of `x` dividing `p` leaves a polynomial with nonzero constant term, hence a unit of
the local ring `P`. So the derivations contain a copy of `k[X]` and are not finite-dimensional.

## Main results

* `Stacks.MvPowerSeries.Hypersurface.finiteDimensional_derivation_iff_eq_one`:
  **Stacks 0DY5(1)** for the derivations, the stated equivalence.

## Implementation notes

The failure of finite-dimensionality for `n ≥ 2` is obtained from an injection of the
polynomial ring rather than from a length computation on the kernel of the Jacobian map:
multiplying a single derivation by the powers of one element of the maximal ideal outside `q`
already produces infinitely many `k`-linearly independent derivations, and the unit criterion
needed for that is elementary in a local ring.

Tag 0DY5(1) is stated in the source for the infinitesimal automorphisms of the deformation
category of `P`. Those are canonically `Derivation k P P` by Tag 0DY3, and the mathematics
lives here, on the derivations, where no choice of an object over the dual numbers is involved;
the transported statement is in
`StacksFrontier.Deformation.Examples.Geometric.RingsHypersurface`.

## References

* [Stacks Project, Tag 0DY5](https://stacks.math.columbia.edu/tag/0DY5)
-/

@[expose] public section

namespace Stacks.MvPowerSeries.Hypersurface

universe w

private theorem equation_variables_ne_zero {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hf : f ≠ 0)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2) : n ≠ 0 := by
  rintro rfl
  exact hf (by simpa [Set.range_eq_empty, Ideal.span_empty] using hord)

private theorem mem_maximalIdeal_of_mem_span_X_sq {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2) :
    f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) k) := by
  rw [← maximalIdeal_mvPowerSeries_eq_span_X k n] at hord
  exact Ideal.pow_le_self (by decide : 2 ≠ 0) hord

/-- The quotient of a local ring by a principal ideal generated by a non-unit is nontrivial. -/
private theorem nontrivial_quotient_span_singleton_of_mem_maximalIdeal
    {R : Type*} [CommRing R] [IsLocalRing R] {f : R} (hf : f ∈ IsLocalRing.maximalIdeal R) :
    Nontrivial (R ⧸ Ideal.span {f}) :=
  Ideal.Quotient.nontrivial_iff.mpr fun h =>
    IsLocalRing.notMem_maximalIdeal.mpr (Ideal.span_singleton_eq_top.mp h) hf

private theorem hypersurface_ringKrullDim_pos {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) (hf : f ≠ 0)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2)
    (hn : 2 ≤ n) :
    0 < ringKrullDim
      (MvPowerSeries (Fin n) k ⧸ Ideal.span {f}) := by
  let R := MvPowerSeries (Fin n) k
  let : IsRegularLocalRing R := MvPowerSeries.isRegularLocalRing k n
  have hfm : f ∈ IsLocalRing.maximalIdeal R := mem_maximalIdeal_of_mem_span_X_sq n f hord
  have hreg : f ∈ nonZeroDivisors R := mem_nonZeroDivisors_iff_ne_zero.mpr hf
  have hdim := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    (R := R) hreg hfm
  have hspan : (IsLocalRing.maximalIdeal R).spanFinrank ≤ n := by
    rw [maximalIdeal_mvPowerSeries_eq_span_X]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    simpa [← Set.image_univ] using
      Set.ncard_image_le (f := (MvPowerSeries.X : Fin n → R)) Set.finite_univ
  have hdimR : ringKrullDim R = (n : WithBot ℕ∞) := by
    refine le_antisymm ?_ (by simpa using ringKrullDim_add_le_mvPowerSeries k n)
    calc
      ringKrullDim R = (IsLocalRing.maximalIdeal R).spanFinrank :=
        (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).symm
      _ ≤ (n : WithBot ℕ∞) := by exact_mod_cast hspan
  have hdimP : ringKrullDim (R ⧸ Ideal.span {f}) + 1 = (n : WithBot ℕ∞) := by
    rwa [hdimR] at hdim
  have hPnt := nontrivial_quotient_span_singleton_of_mem_maximalIdeal hfm
  have hPnonneg : 0 ≤ ringKrullDim (R ⧸ Ideal.span {f}) :=
    ringKrullDim_nonneg_of_nontrivial
  have hPne : ringKrullDim (R ⧸ Ideal.span {f}) ≠ 0 := by
    intro hzero
    rw [hzero, zero_add] at hdimP
    have hn2 : (2 : WithBot ℕ∞) ≤ (n : WithBot ℕ∞) := by exact_mod_cast hn
    rw [← hdimP] at hn2
    norm_num at hn2
  exact hPnonneg.lt_of_ne' hPne

private theorem exists_variable_power_mem_span_of_nonzero_oneVariable
    {k : Type w} [Field k] (f : MvPowerSeries (Fin 1) k) (hf : f ≠ 0) :
    ∃ d : ℕ, (MvPowerSeries.X (0 : Fin 1) : MvPowerSeries (Fin 1) k) ^ d ∈
      Ideal.span {f} := by
  classical
  let i : Fin 1 := 0
  let d := f.order.toNat
  have hfinite : f.order.toNat = f.order :=
    (MvPowerSeries.ne_zero_iff_order_finite).mp hf
  have hdegree (m : Fin 1 →₀ ℕ) : (Finsupp.degree (R := ℕ) m : ℕ∞) = (m i : ℕ∞) := by
    rw [Finsupp.degree_eq_sum (R := ℕ)]
    simp [i]
  obtain ⟨m, hm, hmdeg⟩ := f.exists_coeff_ne_zero_and_order hfinite
  have hmi : m i = d := by
    have heq : (m i : ℕ∞) = d := by
      calc
        (m i : ℕ∞) = Finsupp.degree m := (hdegree m).symm
        _ = f.order := hmdeg
        _ = d := by simp [d, hfinite]
    exact_mod_cast heq
  have hm' : m = Finsupp.single i d := Finsupp.ext fun j => by
    have hj : j = i := Subsingleton.elim _ _
    subst j
    simp [hmi]
  have hcoeff : MvPowerSeries.coeff (Finsupp.single i d) f ≠ 0 := by
    simpa [hm'] using hm
  have hlow : ∀ a : Fin 1 →₀ ℕ, a i < d → MvPowerSeries.coeff a f = 0 := by
    intro a ha
    have hdeglt : (Finsupp.degree (R := ℕ) a : ℕ∞) < f.order := by
      rw [hdegree, ← hfinite]
      exact_mod_cast ha
    exact MvPowerSeries.coeff_of_lt_order hdeglt
  have hdiv : (MvPowerSeries.X i : MvPowerSeries (Fin 1) k) ^ d ∣ f :=
    (MvPowerSeries.X_pow_dvd_iff).mpr hlow
  obtain ⟨u, hfactor⟩ := hdiv
  have hcoeffu : MvPowerSeries.constantCoeff u ≠ 0 := by
    have hcoef : MvPowerSeries.coeff (Finsupp.single i d) f =
        MvPowerSeries.constantCoeff u := by
      rw [hfactor, MvPowerSeries.X_pow_eq, MvPowerSeries.coeff_monomial_mul]
      simp [MvPowerSeries.coeff_zero_eq_constantCoeff]
    rwa [← hcoef]
  have hu : IsUnit u :=
    (MvPowerSeries.isUnit_iff_constantCoeff).mpr (isUnit_iff_ne_zero.mpr hcoeffu)
  refine ⟨d, Ideal.mem_span_singleton.mpr ?_⟩
  rw [hfactor]
  exact hu.mul_right_dvd.mpr dvd_rfl

private theorem quotient_decompose_constant_variable
    {k : Type w} [Field k]
    (I : Ideal (MvPowerSeries (Fin 1) k)) (y : MvPowerSeries (Fin 1) k ⧸ I) :
    ∃ c : k, ∃ z : MvPowerSeries (Fin 1) k ⧸ I,
      y = algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) c +
        Ideal.Quotient.mk I (MvPowerSeries.X (0 : Fin 1)) * z := by
  classical
  let R := MvPowerSeries (Fin 1) k
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective y
  let c := MvPowerSeries.constantCoeff g
  have hmem : g - MvPowerSeries.C c ∈ IsLocalRing.maximalIdeal R := by
    rw [RegularParameters.mem_maximalIdeal_iff_constantCoeff_eq_zero_field]
    simp [c]
  rw [maximalIdeal_mvPowerSeries_eq_span_X] at hmem
  have hrange : Set.range (MvPowerSeries.X : Fin 1 → R) ⊆
      ({MvPowerSeries.X (0 : Fin 1)} : Set R) := by
    rintro _ ⟨i, rfl⟩
    simp only [Set.mem_singleton_iff]
    congr 1
    exact Subsingleton.elim _ _
  have hspan : Ideal.span (Set.range (MvPowerSeries.X : Fin 1 → R)) ≤
      Ideal.span ({MvPowerSeries.X (0 : Fin 1)} : Set R) := Ideal.span_mono hrange
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hspan hmem)
  have hrepr : g = MvPowerSeries.C c +
      MvPowerSeries.X (0 : Fin 1) * r := by
    linear_combination -hr
  refine ⟨c, Ideal.Quotient.mk I r, ?_⟩
  have hC : algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) c =
      Ideal.Quotient.mk I (MvPowerSeries.C c) := by
    change Ideal.Quotient.mk I (algebraMap k R c) = _
    congr 1
  rw [hrepr]
  simp [hC]

private theorem exists_quotient_expansion_mod_variable_power
    {k : Type w} [Field k]
    (I : Ideal (MvPowerSeries (Fin 1) k)) :
    ∀ n : ℕ, ∀ y : MvPowerSeries (Fin 1) k ⧸ I,
      ∃ c : Fin n → k, ∃ z : MvPowerSeries (Fin 1) k ⧸ I,
        y = (∑ i : Fin n,
          algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) (c i) *
            (Ideal.Quotient.mk I (MvPowerSeries.X (0 : Fin 1))) ^ (i : ℕ)) +
          (Ideal.Quotient.mk I (MvPowerSeries.X (0 : Fin 1))) ^ n * z := by
  classical
  intro n
  induction n with
  | zero =>
      intro y
      refine ⟨fun i => i.elim0, y, ?_⟩
      simp
  | succ n ih =>
      intro y
      let x : MvPowerSeries (Fin 1) k ⧸ I :=
        Ideal.Quotient.mk I (MvPowerSeries.X (0 : Fin 1))
      obtain ⟨a, z₀, h₀⟩ := quotient_decompose_constant_variable I y
      obtain ⟨c, z, hc⟩ := ih z₀
      let c' : Fin (n + 1) → k := Fin.cons a c
      refine ⟨c', z, ?_⟩
      have hmul : x *
          (∑ i : Fin n,
            algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) (c i) * x ^ (i : ℕ) +
            x ^ n * z) =
          (∑ i : Fin n,
            algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) (c i) * x ^ (i.succ : ℕ)) +
            x ^ (n + 1) * z := by
        rw [mul_add, Finset.mul_sum]
        congr 1
        · refine Finset.sum_congr rfl fun i _ => ?_
          simp only [Fin.val_succ, pow_succ]
          ring
        · ring
      calc
        y = algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) a + x * z₀ := h₀
        _ = algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) a +
            x * ((∑ i : Fin n,
              algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) (c i) * x ^ (i : ℕ)) +
              x ^ n * z) := by rw [hc]
        _ = algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) a +
            ((∑ i : Fin n,
              algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) (c i) * x ^ (i.succ : ℕ)) +
              x ^ (n + 1) * z) := by rw [hmul]
        _ = (∑ i : Fin (n + 1),
              algebraMap k (MvPowerSeries (Fin 1) k ⧸ I) (c' i) * x ^ (i : ℕ)) +
              x ^ (n + 1) * z := by
          simp [c', Fin.sum_univ_succ]
          ac_rfl

private theorem moduleFinite_hypersurface_oneVariable
    {k : Type w} [Field k] (f : MvPowerSeries (Fin 1) k)
    (hf : f ≠ 0) :
    Module.Finite k (MvPowerSeries (Fin 1) k ⧸ Ideal.span {f}) := by
  classical
  let R := MvPowerSeries (Fin 1) k
  let I : Ideal R := Ideal.span {f}
  let P := R ⧸ I
  let x : P := Ideal.Quotient.mk I (MvPowerSeries.X (0 : Fin 1))
  obtain ⟨d, hXd⟩ := exists_variable_power_mem_span_of_nonzero_oneVariable f hf
  have hxpow : x ^ d = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hXd
  let S : Submodule k P := Submodule.span k
    (Set.range fun i : Fin d => x ^ (i : ℕ))
  have htop : S = ⊤ := by
    apply top_unique
    intro y hy
    obtain ⟨c, z, hrepr⟩ := exists_quotient_expansion_mod_variable_power I d y
    have hlast : x ^ d * z = 0 := by rw [hxpow, zero_mul]
    rw [hlast, add_zero] at hrepr
    rw [hrepr]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [← Algebra.smul_def]
    exact S.smul_mem _ (Submodule.subset_span ⟨i, rfl⟩)
  let : Module.Finite k S := Module.Finite.span_of_finite k (Set.finite_range _)
  exact Module.Finite.of_surjective S.subtype fun y => ⟨⟨y, htop ▸ Submodule.mem_top⟩, rfl⟩

private theorem finiteDimensional_derivations_of_moduleFinite
    {k P : Type*} [Field k] [CommRing P] [Algebra k P]
    (hP : Module.Finite k P) : FiniteDimensional k (Derivation k P P) := by
  let : Module.Finite k P := hP
  let L : Derivation k P P →ₗ[k] (P →ₗ[k] P) := {
    toFun := fun D => D.toLinearMap
    map_add' := by intro D E; simp
    map_smul' := by intro c D; simp }
  exact FiniteDimensional.of_injective L fun D E h =>
    Derivation.ext fun y => LinearMap.congr_fun h y

private noncomputable def hypersurfaceJacobianMap {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) :
    (Fin n → (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})) →ₗ[
      MvPowerSeries (Fin n) k ⧸ Ideal.span {f}]
      (MvPowerSeries (Fin n) k ⧸ Ideal.span {f}) where
  toFun v := ∑ i, v i * Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.pderiv (R := k) i f)
  map_add' v w := by
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' a v := by
    simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    simp only [RingHom.id_apply]
    ring_nf

private noncomputable abbrev hypersurfaceJacobianKernel {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) :=
    LinearMap.ker (hypersurfaceJacobianMap n f)

private noncomputable def hypersurfaceJacobianKernelDerivation {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (v : hypersurfaceJacobianKernel n f) :
    Derivation k (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})
      (MvPowerSeries (Fin n) k ⧸ Ideal.span {f}) := by
  let R := MvPowerSeries (Fin n) k
  let I : Ideal R := Ideal.span {f}
  let P := R ⧸ I
  let π : R →ₗ[R] P := {
    toFun := Ideal.Quotient.mk I
    map_add' := fun x y => map_add (Ideal.Quotient.mk I) x y
    map_smul' := by
      intro a x
      change Ideal.Quotient.mk I (a * x) = Ideal.Quotient.mk I a * Ideal.Quotient.mk I x
      exact map_mul (Ideal.Quotient.mk I) a x }
  let D : Derivation k R P := ∑ i : Fin n,
    v.1 i • (π.compDer (MvPowerSeries.pderiv (R := k) i))
  have hDformula (g : R) : D g =
      ∑ i : Fin n, v.1 i * Ideal.Quotient.mk I (MvPowerSeries.pderiv (R := k) i g) := by
    change Derivation.coeFnAddMonoidHom
      (∑ i : Fin n, v.1 i • (π.compDer (MvPowerSeries.pderiv (R := k) i))) g = _
    rw [map_sum]
    simp [Derivation.coeFnAddMonoidHom,
      Derivation.coe_comp, π]
  have hDf : D f = 0 := by
    rw [hDformula]
    change hypersurfaceJacobianMap n f v.1 = 0
    exact v.2
  let I' : Submodule k R := I.restrictScalars k
  have hI : I' ≤ D.toLinearMap.ker := by
    intro x hx
    change x ∈ I at hx
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hx
    apply LinearMap.mem_ker.mpr
    rw [hr]
    change D (f * r) = 0
    rw [D.leibniz, hDf]
    simp only [smul_zero, add_zero]
    change (algebraMap R P f) • D r = 0
    have hfzero : algebraMap R P f = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)
    rw [hfzero]
    simp
  let Dbar : P →ₗ[k] P := I'.liftQ D.toLinearMap hI
  refine Derivation.mk' Dbar ?_
  intro x y
  refine Quotient.inductionOn' x ?_
  intro a
  refine Quotient.inductionOn' y ?_
  intro b
  change D (a * b) = (Ideal.Quotient.mk I a) * D b +
    (Ideal.Quotient.mk I b) * D a
  exact D.leibniz a b

private theorem hypersurfaceJacobianKernelDerivation_apply_mk {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) (v : hypersurfaceJacobianKernel n f)
    (g : MvPowerSeries (Fin n) k) :
    hypersurfaceJacobianKernelDerivation n f v
      (Ideal.Quotient.mk (Ideal.span {f}) g) =
      ∑ i : Fin n, v.1 i * Ideal.Quotient.mk (Ideal.span {f})
        (MvPowerSeries.pderiv (R := k) i g) := by
  classical
  let R := MvPowerSeries (Fin n) k
  let I : Ideal R := Ideal.span {f}
  let P := R ⧸ I
  let π : R →ₗ[R] P := {
    toFun := Ideal.Quotient.mk I
    map_add' := fun x y => map_add (Ideal.Quotient.mk I) x y
    map_smul' := by
      intro a x
      change Ideal.Quotient.mk I (a * x) = Ideal.Quotient.mk I a * Ideal.Quotient.mk I x
      exact map_mul (Ideal.Quotient.mk I) a x }
  unfold hypersurfaceJacobianKernelDerivation
  dsimp only
  change ((Submodule.restrictScalars k I).liftQ _ _)
    (Submodule.Quotient.mk g) = _
  rw [Submodule.liftQ_apply]
  change Derivation.coeFnAddMonoidHom
    (∑ i : Fin n, v.1 i • (π.compDer (MvPowerSeries.pderiv (R := k) i))) g = _
  rw [map_sum, Fintype.sum_apply]
  rfl

private theorem hypersurfaceJacobianKernelDerivation_apply_X {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) (v : hypersurfaceJacobianKernel n f)
    (i : Fin n) :
    hypersurfaceJacobianKernelDerivation n f v
      (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X i)) = v.1 i := by
  classical
  rw [hypersurfaceJacobianKernelDerivation_apply_mk]
  rw [Finset.sum_eq_single i]
  · simp [MvPowerSeries.pderiv_X_self]
  · intro j _ hji
    simp [MvPowerSeries.pderiv_X_of_ne hji.symm]
  · simp

private noncomputable def hypersurfaceJacobianKernelToDerivation {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) :
    hypersurfaceJacobianKernel n f →ₗ[k]
      Derivation k (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})
        (MvPowerSeries (Fin n) k ⧸ Ideal.span {f}) where
  toFun := hypersurfaceJacobianKernelDerivation n f
  map_add' v w := by
    apply Derivation.ext
    intro x
    refine Quotient.inductionOn' x ?_
    intro g
    change hypersurfaceJacobianKernelDerivation n f (v + w)
        (Ideal.Quotient.mk (Ideal.span {f}) g) =
      (hypersurfaceJacobianKernelDerivation n f v +
        hypersurfaceJacobianKernelDerivation n f w)
        (Ideal.Quotient.mk (Ideal.span {f}) g)
    rw [hypersurfaceJacobianKernelDerivation_apply_mk, Derivation.add_apply,
      hypersurfaceJacobianKernelDerivation_apply_mk,
      hypersurfaceJacobianKernelDerivation_apply_mk]
    simp [Finset.sum_add_distrib, add_mul]
  map_smul' c v := by
    apply Derivation.ext
    intro x
    refine Quotient.inductionOn' x ?_
    intro g
    change hypersurfaceJacobianKernelDerivation n f (c • v)
        (Ideal.Quotient.mk (Ideal.span {f}) g) =
      (c • hypersurfaceJacobianKernelDerivation n f v)
        (Ideal.Quotient.mk (Ideal.span {f}) g)
    rw [hypersurfaceJacobianKernelDerivation_apply_mk, Derivation.smul_apply,
      hypersurfaceJacobianKernelDerivation_apply_mk]
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    simp

private theorem hypersurfaceJacobianKernelToDerivation_injective {k : Type w} [Field k]
    (n : ℕ) (f : MvPowerSeries (Fin n) k) :
    Function.Injective (hypersurfaceJacobianKernelToDerivation n f) := by
  intro v w h
  apply Subtype.ext
  funext i
  have hi := congrArg (fun D : Derivation k
      (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})
      (MvPowerSeries (Fin n) k ⧸ Ideal.span {f}) =>
        D (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X i))) h
  change hypersurfaceJacobianKernelDerivation n f v
      (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X i)) =
    hypersurfaceJacobianKernelDerivation n f w
      (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X i)) at hi
  rw [hypersurfaceJacobianKernelDerivation_apply_X,
    hypersurfaceJacobianKernelDerivation_apply_X] at hi
  exact hi

private theorem exists_prime_not_maximal_of_ringKrullDim_pos
    (P : Type*) [CommRing P] (hP : 0 < ringKrullDim P) :
    ∃ q : Ideal P, q.IsPrime ∧ ¬ q.IsMaximal := by
  by_contra! h
  exact not_le_of_gt hP (Ring.krullDimLE_iff.mp (Ring.KrullDimLE.mk₀ h))

private theorem exists_maximalIdeal_not_mem_of_prime_not_maximal
    (P : Type*) [CommRing P] [IsLocalRing P] (q : Ideal P) [q.IsPrime]
    (hq : ¬ q.IsMaximal) :
    ∃ x : P, x ∈ IsLocalRing.maximalIdeal P ∧ x ∉ q := by
  have hqle : q ≤ IsLocalRing.maximalIdeal P :=
    IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top (inferInstance : q.IsPrime))
  have hnot : ¬ IsLocalRing.maximalIdeal P ≤ q := by
    intro hm
    have heq : q = IsLocalRing.maximalIdeal P := le_antisymm hqle hm
    exact hq (heq ▸ IsLocalRing.maximalIdeal.isMaximal P)
  exact IsConcreteLE.not_le_iff_exists.mp hnot

private theorem exists_vector_in_kernel_nonzero_at_prime
    (P : Type*) [CommRing P] (n : ℕ) (hn : 2 ≤ n) (a : Fin n → P)
    (q : Ideal P) [q.IsPrime] :
    ∃ v : Fin n → P, (∑ i, v i * a i = 0) ∧
      ∃ j, algebraMap P (Localization.AtPrime q) (v j) ≠ 0 := by
  classical
  let A := Localization.AtPrime q
  let i : Fin n := ⟨0, by omega⟩
  let j : Fin n := ⟨1, by omega⟩
  have hij : i ≠ j := by simp [i, j, Fin.ext_iff]
  have hsingle (l : Fin n) (c : P) :
      (∑ x : Fin n, (Pi.single l c : Fin n → P) x * a x) = c * a l := by
    rw [Fintype.sum_eq_single l]
    · simp
    · intro x hx
      simp [hx]
  by_cases hzero : algebraMap P A (a i) = 0
  · obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff
      (S := A) (M := q.primeCompl) (a i)).mp hzero
    let v : Fin n → P := Pi.single i (s : P)
    refine ⟨v, ?_, ?_⟩
    · change (∑ x : Fin n, (Pi.single i (s : P) : Fin n → P) x * a x) = 0
      rw [hsingle]
      simpa [mul_comm] using hs
    · refine ⟨i, ?_⟩
      simpa [v] using (IsLocalization.map_units A s).ne_zero
  · let u : Fin n → P := Pi.single i (-a j)
    let w : Fin n → P := Pi.single j (a i)
    let v : Fin n → P := u + w
    refine ⟨v, ?_, ?_⟩
    · change (∑ x : Fin n, (u x + w x) * a x) = 0
      simp only [add_mul, Finset.sum_add_distrib, u, w, hsingle]
      ring
    · refine ⟨j, ?_⟩
      simpa [v, u, w, hij, map_add] using hzero

private theorem exists_hypersurfaceJacobianKernel_nonzero_at_prime
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hn : 2 ≤ n) (q : Ideal (MvPowerSeries (Fin n) k ⧸ Ideal.span {f}))
    [q.IsPrime] :
    ∃ v : hypersurfaceJacobianKernel n f, ∃ j : Fin n,
      algebraMap (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})
        (Localization.AtPrime q) (v.1 j) ≠ 0 := by
  let P := MvPowerSeries (Fin n) k ⧸ Ideal.span {f}
  let a : Fin n → P := fun i =>
    Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.pderiv (R := k) i f)
  obtain ⟨v, hv, j, hj⟩ := exists_vector_in_kernel_nonzero_at_prime
    P n hn a q
  refine ⟨⟨v, ?_⟩, j, ?_⟩
  · apply LinearMap.mem_ker.mpr
    change hypersurfaceJacobianMap n f v = 0
    simpa [hypersurfaceJacobianMap, a] using hv
  · simpa [P] using hj

private theorem polynomial_aeval_isUnit_at_nonmaximalPrime
    {k P : Type*} [Field k] [CommRing P] [Algebra k P] [IsLocalRing P]
    (q : Ideal P) [q.IsPrime] (x : P)
    (hx : x ∈ IsLocalRing.maximalIdeal P) (hxq : x ∉ q)
    (p : Polynomial k) (hp : p ≠ 0) :
    IsUnit (algebraMap P (Localization.AtPrime q) (Polynomial.aeval x p)) := by
  classical
  let A := Localization.AtPrime q
  have hrec : ∀ d (p : Polynomial k), p.natDegree ≤ d → p ≠ 0 →
      IsUnit (algebraMap P A (Polynomial.aeval x p)) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
        intro p hdeg hp
        let c := p.coeff 0
        have hform : p = Polynomial.X * p.divX + Polynomial.C c := by
          simp [c]
        by_cases hc : c = 0
        · have hnpos : 0 < p.natDegree := by
            by_contra h'
            have hzero : p.natDegree = 0 := Nat.eq_zero_of_not_pos h'
            apply hp
            rw [Polynomial.eq_C_of_natDegree_eq_zero hzero]
            simp [c, hc]
          have hdiv : p.divX ≠ 0 := by
            intro hdiv
            apply hp
            rw [hform, hdiv, hc]
            simp
          have hdivdeg : p.divX.natDegree < d := by
            rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
            omega
          have hdivunit : IsUnit (algebraMap P A (Polynomial.aeval x p.divX)) :=
            ih p.divX.natDegree hdivdeg p.divX le_rfl hdiv
          have hxunit : IsUnit (algebraMap P A x) :=
            IsLocalization.map_units A ⟨x, Ideal.mem_primeCompl_iff.mpr hxq⟩
          rw [hform, hc]
          simp only [Polynomial.aeval_X,
            map_mul, map_zero, add_zero]
          exact hxunit.mul hdivunit
        · have hxt : x * Polynomial.aeval x p.divX ∈ IsLocalRing.maximalIdeal P := by
            rw [mul_comm]
            exact Ideal.mul_mem_left _ _ hx
          have hval : Polynomial.aeval x p =
              x * Polynomial.aeval x p.divX + algebraMap k P c := by
            calc
              Polynomial.aeval x p =
                  Polynomial.aeval x (Polynomial.X * p.divX + Polynomial.C c) :=
                congrArg (Polynomial.aeval x) hform
              _ = x * Polynomial.aeval x p.divX + algebraMap k P c := by
                simp [Polynomial.aeval_add, Polynomial.aeval_mul,
                  Polynomial.aeval_X, Polynomial.aeval_C]
          have hnot : Polynomial.aeval x p ∉ IsLocalRing.maximalIdeal P := by
            intro hm
            have hcm : algebraMap k P c ∈ IsLocalRing.maximalIdeal P := by
              rw [show algebraMap k P c = Polynomial.aeval x p -
                  x * Polynomial.aeval x p.divX by rw [hval]; ring]
              exact sub_mem hm hxt
            have hunitc : IsUnit (algebraMap k P c) :=
              (isUnit_iff_ne_zero.mpr hc).map (algebraMap k P)
            exact (IsLocalRing.notMem_maximalIdeal.mpr hunitc) hcm
          exact (IsLocalRing.notMem_maximalIdeal.mp hnot).map (algebraMap P A)
  exact hrec p.natDegree p le_rfl hp

private noncomputable def polynomialMultipleDerivationLinearMap
    {k P : Type*} [Field k] [CommRing P] [Algebra k P]
    (x : P) (D : Derivation k P P) :
    Polynomial k →ₗ[k] Derivation k P P where
  toFun p := Polynomial.aeval x p • D
  map_add' p q := by
    simp [Polynomial.aeval_add, add_smul]
  map_smul' c p := by
    simp [Algebra.smul_def, mul_smul]

private theorem not_finiteDimensional_of_polynomialMultipleDerivation_injective
    {k P : Type*} [Field k] [CommRing P] [Algebra k P]
    (x : P) (D : Derivation k P P)
    (hinj : Function.Injective (polynomialMultipleDerivationLinearMap x D)) :
    ¬ FiniteDimensional k (Derivation k P P) := by
  intro hfd
  let L := polynomialMultipleDerivationLinearMap x D
  have hker : LinearMap.ker L = ⊥ := LinearMap.ker_eq_bot.mpr hinj
  have hli : LinearIndependent k (L ∘ Polynomial.basisMonomials k) :=
    (Polynomial.basisMonomials k).linearIndependent.map' L hker
  let : FiniteDimensional k (Derivation k P P) := hfd
  have hlt := hli.lt_aleph0_of_finiteDimensional
  have hinf : Cardinal.aleph0 ≤ Cardinal.mk ℕ := Cardinal.aleph0_le_mk ℕ
  exact (not_lt_of_ge hinf) hlt

private theorem polynomialMultipleDerivationLinearMap_injective
    {k P : Type*} [Field k] [CommRing P] [Algebra k P] [IsLocalRing P]
    (q : Ideal P) [q.IsPrime] (x y : P)
    (hx : x ∈ IsLocalRing.maximalIdeal P) (hxq : x ∉ q)
    (D : Derivation k P P)
    (hD : algebraMap P (Localization.AtPrime q) (D y) ≠ 0) :
    Function.Injective (polynomialMultipleDerivationLinearMap x D) := by
  intro p r h
  have hr : polynomialMultipleDerivationLinearMap x D (p - r) = 0 := by
    rw [map_sub, h]
    simp
  have hvalue := congrArg (fun E : Derivation k P P => E y) hr
  have hmul : Polynomial.aeval x (p - r) * D y = 0 := by
    simpa [polynomialMultipleDerivationLinearMap, smul_eq_mul] using hvalue
  have hloc := congrArg (algebraMap P (Localization.AtPrime q)) hmul
  rw [map_mul] at hloc
  by_cases hp : p - r = 0
  · exact sub_eq_zero.mp hp
  · have hu := polynomial_aeval_isUnit_at_nonmaximalPrime q x hx hxq (p - r) hp
    have hloc' :
        algebraMap P (Localization.AtPrime q) (Polynomial.aeval x (p - r)) *
          algebraMap P (Localization.AtPrime q) (D y) = 0 := by
      simpa using hloc
    exact absurd ((IsUnit.mul_right_eq_zero hu).mp hloc') hD

private theorem not_finiteDimensional_hypersurfaceDerivations
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hf : f ≠ 0)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2)
    (hn : 2 ≤ n) :
    ¬ FiniteDimensional k
      (Derivation k (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})
        (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})) := by
  let P := MvPowerSeries (Fin n) k ⧸ Ideal.span {f}
  have hdim : 0 < ringKrullDim P :=
    hypersurface_ringKrullDim_pos n f hf hord hn
  obtain ⟨q, hqprime, hqmax⟩ := exists_prime_not_maximal_of_ringKrullDim_pos P hdim
  let : q.IsPrime := hqprime
  let : IsLocalRing P := by
    dsimp [P]
    have := nontrivial_quotient_span_singleton_of_mem_maximalIdeal
      (mem_maximalIdeal_of_mem_span_X_sq n f hord)
    exact IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  obtain ⟨x, hx, hxq⟩ := exists_maximalIdeal_not_mem_of_prime_not_maximal P q hqmax
  obtain ⟨v, j, hj⟩ := exists_hypersurfaceJacobianKernel_nonzero_at_prime n f hn q
  let D := hypersurfaceJacobianKernelToDerivation n f v
  have hD : algebraMap P (Localization.AtPrime q)
      (D (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X j))) ≠ 0 := by
    change algebraMap P (Localization.AtPrime q)
      (hypersurfaceJacobianKernelDerivation n f v
        (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X j))) ≠ 0
    rwa [hypersurfaceJacobianKernelDerivation_apply_X]
  exact not_finiteDimensional_of_polynomialMultipleDerivation_injective x D
    (polynomialMultipleDerivationLinearMap_injective q x
      (Ideal.Quotient.mk (Ideal.span {f}) (MvPowerSeries.X j)) hx hxq D hD)

/-- **Stacks 0DY5(1)** for the derivations. Let `k` be a field, `n` a number of variables and
`f` a nonzero formal power series in `k[[x_1, …, x_n]]` lying in the square of the ideal
generated by the variables. The `k`-derivations of `P = k[[x_1, …, x_n]]/(f)` into itself form
a finite-dimensional `k`-vector space if and only if `n = 1`. Through Tag 0DY3, which
identifies the infinitesimal automorphisms of the deformation category of `P` with
`Derivation k P P`, this is the finite-dimensionality criterion for those automorphisms. -/
theorem finiteDimensional_derivation_iff_eq_one
    {k : Type w} [Field k] (n : ℕ) (f : MvPowerSeries (Fin n) k)
    (hf : f ≠ 0)
    (hord : f ∈ (Ideal.span (Set.range
      (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))) ^ 2) :
    FiniteDimensional k
      (Derivation k (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})
        (MvPowerSeries (Fin n) k ⧸ Ideal.span {f})) ↔ n = 1 := by
  constructor
  · intro hfinite
    have := equation_variables_ne_zero n f hf hord
    by_contra hne
    exact not_finiteDimensional_hypersurfaceDerivations n f hf hord (by omega) hfinite
  · rintro rfl
    exact finiteDimensional_derivations_of_moduleFinite
      (moduleFinite_hypersurface_oneVariable f hf)

end Stacks.MvPowerSeries.Hypersurface

