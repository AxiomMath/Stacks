/-!
# The maximal ideal of a power series ring, and its adic topology

Let `A` be a local ring. The maximal ideal of `A⟦X⟧` is generated by the maximal ideal of `A`
together with `X`, so membership in a power of it is a finite condition on coefficients. Two
consequences are recorded here.

First, `A⟦X⟧` is complete for its own maximal-ideal-adic topology as soon as `A` is, and hence
so is `MvPowerSeries (Fin d) A` by induction on `d`.

Second, the product topology on `MvPowerSeries (Fin d) A` — the topology
`MvPowerSeries.WithPiTopology.instTopologicalSpace`, for `A` discrete — is finer than the
maximal-ideal-adic topology: each power of the maximal ideal is cut out by finitely many
coefficient conditions and is therefore open. This is what makes a power series substitution
continuous for the product topology, and so uniquely determined by the images of the
variables.

## Main results

* `PowerSeries.maximalIdeal_eq_map_C_sup_span_X`: the maximal ideal of `A⟦X⟧` is
  `m_A · A⟦X⟧ + (X)`.
* `PowerSeries.mem_map_C_sup_span_X_pow_iff`: membership in `I · A⟦X⟧ + (X ^ n)` is the
  condition that the coefficients below degree `n` lie in `I`.
* `PowerSeries.isAdicComplete_maximalIdeal` and
  `MvPowerSeries.isAdicComplete_maximalIdeal`: adic completeness of a power series ring in
  one, resp. finitely many, variables over a Noetherian complete local ring.
* `MvPowerSeries.exists_finset_subset_maximalIdeal_pow`: a power of the maximal ideal of
  `MvPowerSeries (Fin d) A` contains every series whose coefficients at some fixed finite set
  of exponents lie in the corresponding power of `m_A`.
* `MvPowerSeries.WithPiTopology.isOpen_maximalIdeal_pow`: every power of the maximal ideal is
  open for the product topology over a discrete local ring.
* `MvPowerSeries.WithPiTopology.continuous_id_adicTopology`: the product topology refines the
  maximal-ideal-adic topology.
* `RingHom.continuous_adic_of_isLocalHom`: a local homomorphism of local rings is continuous
  for the maximal-ideal-adic topologies.

## Implementation notes

The product topology and the adic topology are both supplied explicitly to `Continuous` and
to `IsOpen`, since a power series ring carries neither as an instance; a local `let`
introduces whichever of the two a given step argues in.

Adic completeness is transported along a ring isomorphism of local rings by
`IsAdicComplete.congr_ringEquiv`, after identifying the image of the maximal ideal with the
maximal ideal of the target; this is how the induction on the number of variables passes
through `MvPowerSeries.finSuccEquiv`.
-/

@[expose] public section

open IsLocalRing

namespace PowerSeries

variable {A : Type*} [CommRing A]

/-- A power series lies in `I · A⟦X⟧ + (X ^ n)` exactly when its coefficients in degrees
below `n` lie in `I`. -/
theorem mem_map_C_sup_span_X_pow_iff (I : Ideal A) :
    ∀ (n : ℕ) (φ : PowerSeries A),
      φ ∈ I.map (PowerSeries.C : A →+* PowerSeries A) ⊔ Ideal.span {(X : PowerSeries A) ^ n} ↔
        ∀ j < n, coeff j φ ∈ I := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    intro φ
    refine ⟨fun h j hj => ?_, fun h => ?_⟩
    · obtain ⟨α, hα, β, hβ, rfl⟩ := Submodule.mem_sup.1 h
      have hβj : coeff j β = 0 := (X_pow_dvd_iff.1 (Ideal.mem_span_singleton.1 hβ)) j hj
      simpa [hβj] using MvPowerSeries.coeff_mem_of_mem_map_C hα (Finsupp.single () j)
    · obtain ⟨ρ, hρ⟩ : (X : PowerSeries A) ∣ (φ - PowerSeries.C (coeff 0 φ)) := by
        rw [X_dvd_iff]
        simp
      have hφ : φ = PowerSeries.C (coeff 0 φ) + X * ρ := by rw [← hρ]; ring
      have hρc : ∀ j < n, coeff j ρ ∈ I := fun j hj => by
        have hc : coeff (j + 1) φ = coeff j ρ := by rw [hφ]; simp [coeff_succ_X_mul]
        exact hc ▸ h (j + 1) (by omega)
      obtain ⟨α, hα, β, hβ, hαβ⟩ := Submodule.mem_sup.1 ((ih ρ).2 hρc)
      obtain ⟨γ, hγ⟩ := Ideal.mem_span_singleton.1 hβ
      rw [hφ, ← hαβ, mul_add, ← add_assoc]
      refine Submodule.add_mem_sup (Ideal.add_mem _
        (Ideal.mem_map_of_mem (PowerSeries.C : A →+* PowerSeries A) (h 0 n.succ_pos))
        (Ideal.mul_mem_left _ _ hα)) (Ideal.mem_span_singleton.2 ⟨γ, ?_⟩)
      rw [hγ, pow_succ]; ring

variable [IsLocalRing A]

/-- The maximal ideal of `A⟦X⟧` over a local ring `A` is generated by the maximal ideal of
`A` together with `X`. -/
theorem maximalIdeal_eq_map_C_sup_span_X :
    maximalIdeal (PowerSeries A) =
      (maximalIdeal A).map (PowerSeries.C : A →+* PowerSeries A) ⊔
        Ideal.span {(PowerSeries.X : PowerSeries A)} := by
  refine le_antisymm (fun φ hφ => ?_) (sup_le ?_ ?_)
  · have hc : constantCoeff φ ∈ maximalIdeal A := by
      rw [mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (mem_maximalIdeal _).1 hφ (PowerSeries.isUnit_iff_constantCoeff.2 hu)
    have h1 : φ - PowerSeries.C (constantCoeff φ) ∈
        Ideal.span {(PowerSeries.X : PowerSeries A)} :=
      Ideal.mem_span_singleton.2 (X_dvd_iff.2 (by simp))
    simpa using Submodule.add_mem_sup
      (Ideal.mem_map_of_mem (PowerSeries.C : A →+* PowerSeries A) hc) h1
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    simp only [Ideal.mem_comap, mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (mem_maximalIdeal _).1 ha (by simpa using PowerSeries.isUnit_iff_constantCoeff.1 hu)
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    simpa using PowerSeries.isUnit_iff_constantCoeff.1 hu

/-- The `n`-th power of the maximal ideal of `A⟦X⟧` contains `m_A^n · A⟦X⟧ + (X ^ n)`. -/
theorem map_C_pow_sup_span_X_pow_le_maximalIdeal_pow (n : ℕ) :
    (maximalIdeal A ^ n).map (PowerSeries.C : A →+* PowerSeries A) ⊔
        Ideal.span {(PowerSeries.X : PowerSeries A) ^ n} ≤ maximalIdeal (PowerSeries A) ^ n := by
  rw [maximalIdeal_eq_map_C_sup_span_X (A := A), Ideal.map_pow, ← Ideal.span_singleton_pow]
  exact sup_le (Ideal.pow_right_mono le_sup_left n) (Ideal.pow_right_mono le_sup_right n)

/-- A power series in `m^(n + n)` has all its coefficients below degree `n` in `m_A^m`, for
every `m ≤ n`. -/
theorem coeff_mem_pow_maximalIdeal {m n j : ℕ} (hj : j < n) (hmn : m ≤ n)
    {φ : PowerSeries A} (hφ : φ ∈ maximalIdeal (PowerSeries A) ^ (n + n)) :
    coeff j φ ∈ maximalIdeal A ^ m := by
  have hle : maximalIdeal (PowerSeries A) ^ (n + n) ≤
      (maximalIdeal A ^ n).map (PowerSeries.C : A →+* PowerSeries A) ⊔
        Ideal.span {(PowerSeries.X : PowerSeries A) ^ n} := by
    rw [maximalIdeal_eq_map_C_sup_span_X (A := A), Ideal.map_pow, ← Ideal.span_singleton_pow]
    exact Ideal.sup_pow_add_le_pow_sup_pow
  exact Ideal.pow_le_pow_right hmn ((mem_map_C_sup_span_X_pow_iff _ n φ).1 (hle hφ) j hj)

/-- Coefficientwise limit of a Cauchy sequence of power series over a precomplete local
ring. -/
private theorem exists_coeff_sub_mem_pow [IsPrecomplete (maximalIdeal A) A]
    {f : ℕ → PowerSeries A}
    (hf : ∀ m n, m ≤ n → f m - f n ∈ maximalIdeal (PowerSeries A) ^ m) (j : ℕ) :
    ∃ L : A, ∀ n, j < n → coeff j (f (n + n)) - L ∈ maximalIdeal A ^ n := by
  have hcau : ∀ {p q : ℕ}, p ≤ q →
      coeff j (f ((p + j + 1) + (p + j + 1))) ≡ coeff j (f ((q + j + 1) + (q + j + 1)))
        [SMOD (maximalIdeal A ^ p • ⊤ : Submodule A A)] := fun {p q} hpq => by
    rw [SModEq.sub_mem]
    simpa using coeff_mem_pow_maximalIdeal (A := A) (m := p) (n := p + j + 1) (j := j)
      (by omega) (by omega) (hf _ _ (by omega))
  obtain ⟨L, hL⟩ := IsPrecomplete.prec (I := maximalIdeal A) (M := A) inferInstance
    (f := fun c => coeff j (f ((c + j + 1) + (c + j + 1)))) hcau
  refine ⟨L, fun n hjn => ?_⟩
  have h1 : coeff j (f ((n + j + 1) + (n + j + 1))) - L ∈ maximalIdeal A ^ n := by
    simpa [SModEq.sub_mem] using hL n
  have h2 : coeff j (f (n + n)) - coeff j (f ((n + j + 1) + (n + j + 1))) ∈
      maximalIdeal A ^ n := by
    simpa using coeff_mem_pow_maximalIdeal (A := A) (m := n) (n := n) (j := j) hjn le_rfl
      (hf _ _ (by omega))
  simpa using Ideal.add_mem _ h2 h1

/-- A power series ring in one variable over a Noetherian complete local ring is complete for
its own maximal-ideal-adic topology. -/
theorem isAdicComplete_maximalIdeal [IsNoetherianRing A]
    [IsAdicComplete (maximalIdeal A) A] :
    IsAdicComplete (maximalIdeal (PowerSeries A)) (PowerSeries A) := by
  have hprec : IsPrecomplete (maximalIdeal (PowerSeries A)) (PowerSeries A) := by
    refine ⟨fun f hf => ?_⟩
    have hf' : ∀ m n, m ≤ n → f m - f n ∈ maximalIdeal (PowerSeries A) ^ m :=
      fun m n hmn => by simpa [SModEq.sub_mem] using hf hmn
    choose L hL using exists_coeff_sub_mem_pow (A := A) hf'
    refine ⟨PowerSeries.mk L, fun n => ?_⟩
    rw [SModEq.sub_mem]
    have hB : f (n + n) - PowerSeries.mk L ∈ maximalIdeal (PowerSeries A) ^ n :=
      map_C_pow_sup_span_X_pow_le_maximalIdeal_pow n
        ((mem_map_C_sup_span_X_pow_iff _ n _).2 fun j hj => by simpa using hL j n hj)
    simpa using Ideal.add_mem _ (hf' n (n + n) (by omega)) hB
  exact ⟨⟩

end PowerSeries

namespace MvPowerSeries

/-- A power series ring in finitely many variables over a Noetherian complete local ring is
complete for its own maximal-ideal-adic topology. -/
theorem isAdicComplete_maximalIdeal :
    ∀ (d : ℕ) (A : Type*) [CommRing A] [IsNoetherianRing A] [IsLocalRing A],
      IsAdicComplete (maximalIdeal A) A →
        IsAdicComplete (maximalIdeal (MvPowerSeries (Fin d) A)) (MvPowerSeries (Fin d) A) := by
  intro d
  induction d with
  | zero =>
      intro A _ _ _ h
      have := h
      exact isAdicComplete_maximalIdeal_of_ringEquiv
        (MvPowerSeries.isEmptyEquiv (σ := Fin 0) (R := A)).symm.toRingEquiv
  | succ d ih =>
      intro A _ _ _ h
      have : IsAdicComplete (maximalIdeal (MvPowerSeries (Fin d) A))
          (MvPowerSeries (Fin d) A) := ih A h
      have : IsAdicComplete (maximalIdeal A) A := h
      have : IsAdicComplete (maximalIdeal (PowerSeries (MvPowerSeries (Fin d) A)))
          (PowerSeries (MvPowerSeries (Fin d) A)) :=
        PowerSeries.isAdicComplete_maximalIdeal (A := MvPowerSeries (Fin d) A)
      exact isAdicComplete_maximalIdeal_of_ringEquiv
        (MvPowerSeries.finSuccEquiv A d).symm.toRingEquiv

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- If the image of `x` under a ring isomorphism of local rings lies in the `N`-th power of the
maximal ideal, then so does `x`. -/
private theorem mem_pow_maximalIdeal_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (e : R ≃+* S) {N : ℕ} {x : R}
    (h : e x ∈ maximalIdeal S ^ N) : x ∈ maximalIdeal R ^ N := by
  have hmax : Ideal.map e (maximalIdeal R) = maximalIdeal S :=
    IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)
  have hmem : e x ∈ Ideal.map e (maximalIdeal R ^ N) := by rwa [Ideal.map_pow, hmax]
  obtain ⟨g, hg, hgx⟩ := (Ideal.mem_map_iff_of_surjective e e.surjective).1 hmem
  simpa [e.injective hgx] using hg

/-- Membership of the `N`-th power of the maximal ideal of `MvPowerSeries (Fin d) A` is
implied by finitely many coefficient conditions: there is a finite set `E` of exponents such
that having all coefficients at `E` in `m_A ^ N` suffices. -/
theorem exists_finset_subset_maximalIdeal_pow (d : ℕ) :
    ∀ N : ℕ, ∃ E : Finset (Fin d →₀ ℕ),
      ∀ f : MvPowerSeries (Fin d) A,
        (∀ e ∈ E, MvPowerSeries.coeff e f ∈ maximalIdeal A ^ N) →
          f ∈ maximalIdeal (MvPowerSeries (Fin d) A) ^ N := by
  induction d with
  | zero =>
      intro N
      refine ⟨{0}, ?_⟩
      intro f hf
      let e : MvPowerSeries (Fin 0) A ≃+* A :=
        (MvPowerSeries.isEmptyEquiv (Fin 0) A).toRingEquiv
      refine mem_pow_maximalIdeal_of_ringEquiv e ?_
      have heval : e f = MvPowerSeries.coeff (0 : Fin 0 →₀ ℕ) f := by
        simp [e, MvPowerSeries.coeff_zero_eq_constantCoeff]
      rw [heval]
      exact hf 0 (by simp)
  | succ d ih =>
      intro N
      obtain ⟨E, hE⟩ := ih N
      classical
      let e : MvPowerSeries (Fin (d + 1)) A ≃+* PowerSeries (MvPowerSeries (Fin d) A) :=
        (MvPowerSeries.finSuccEquiv A d).toRingEquiv
      let E' : Finset (Fin (d + 1) →₀ ℕ) :=
        ((Finset.range N).product E).image (fun x => Finsupp.cons x.1 x.2)
      refine ⟨E', ?_⟩
      intro f hf
      let m₀ := maximalIdeal (MvPowerSeries (Fin d) A)
      let m₁ := maximalIdeal (PowerSeries (MvPowerSeries (Fin d) A))
      have hcoeff (j : ℕ) (hj : j < N) : PowerSeries.coeff j (e f) ∈ m₀ ^ N := by
        apply hE (PowerSeries.coeff j (e f))
        intro c hc
        have hmem : Finsupp.cons j c ∈ E' :=
          Finset.mem_image.mpr ⟨(j, c), Finset.mem_product.mpr ⟨Finset.mem_range.mpr hj, hc⟩, rfl⟩
        have hcc := MvPowerSeries.coeff_coeff_finSuccEquiv (R := A) (n := d) f (k := j) (x := c)
        simpa [e] using hcc ▸ hf (Finsupp.cons j c) hmem
      have hsum : e f ∈ (m₀ ^ N).map (PowerSeries.C : _ →+* _) ⊔
          Ideal.span {(PowerSeries.X : PowerSeries (MvPowerSeries (Fin d) A)) ^ N} :=
        (PowerSeries.mem_map_C_sup_span_X_pow_iff (m₀ ^ N) N (e f)).2 hcoeff
      have hle := PowerSeries.map_C_pow_sup_span_X_pow_le_maximalIdeal_pow
        (A := MvPowerSeries (Fin d) A) N
      exact mem_pow_maximalIdeal_of_ringEquiv e (hle hsum)

namespace WithPiTopology

/-- Over a discrete local ring, every power of the maximal ideal of `MvPowerSeries (Fin d) A`
is open for the product topology. -/
theorem isOpen_maximalIdeal_pow [TopologicalSpace A] [IsTopologicalRing A]
    [DiscreteTopology A] (d N : ℕ) :
    @IsOpen (MvPowerSeries (Fin d) A) (MvPowerSeries.WithPiTopology.instTopologicalSpace A)
      ((maximalIdeal (MvPowerSeries (Fin d) A) ^ N : Ideal (MvPowerSeries (Fin d) A)) :
        Set (MvPowerSeries (Fin d) A)) := by
  let _ : TopologicalSpace (MvPowerSeries (Fin d) A) :=
    MvPowerSeries.WithPiTopology.instTopologicalSpace A
  obtain ⟨E, hE⟩ := exists_finset_subset_maximalIdeal_pow (A := A) d N
  let U : Set (MvPowerSeries (Fin d) A) :=
    ⋂ e ∈ E, (MvPowerSeries.coeff e) ⁻¹' ((maximalIdeal A ^ N : Ideal A) : Set A)
  have hU : IsOpen U := isOpen_biInter_finset fun e _ =>
    (isOpen_discrete _).preimage (MvPowerSeries.WithPiTopology.continuous_coeff A e)
  have hU0 : U ∈ nhds (0 : MvPowerSeries (Fin d) A) := hU.mem_nhds (by simp [U])
  have hUsub : U ⊆ ((maximalIdeal (MvPowerSeries (Fin d) A) ^ N :
      Ideal (MvPowerSeries (Fin d) A)) : Set (MvPowerSeries (Fin d) A)) :=
    fun f hf => hE f (Set.mem_iInter₂.1 hf)
  let _ : IsTopologicalRing (MvPowerSeries (Fin d) A) :=
    MvPowerSeries.WithPiTopology.instIsTopologicalRing (Fin d) A
  apply isOpen_iff_mem_nhds.2
  intro f hf
  have htrans : (fun x : MvPowerSeries (Fin d) A => f + x) '' U ∈ nhds f := by
    rw [← map_add_left_nhds_zero f]
    exact Filter.mem_map.mpr (Filter.mem_of_superset hU0 (fun x hx => ⟨x, hx, rfl⟩))
  refine Filter.mem_of_superset htrans ?_
  rintro g ⟨x, hx, rfl⟩
  exact Ideal.add_mem _ hf (hUsub hx)

/-- Over a discrete local ring, the product topology on `MvPowerSeries (Fin d) A` is finer
than the maximal-ideal-adic topology. -/
theorem continuous_id_adicTopology [TopologicalSpace A] [IsTopologicalRing A]
    [DiscreteTopology A] (d : ℕ) :
    @Continuous (MvPowerSeries (Fin d) A) (MvPowerSeries (Fin d) A)
      (MvPowerSeries.WithPiTopology.instTopologicalSpace A)
      (maximalIdeal (MvPowerSeries (Fin d) A)).adicTopology id := by
  let _ : TopologicalSpace (MvPowerSeries (Fin d) A) :=
    MvPowerSeries.WithPiTopology.instTopologicalSpace A
  let _ : IsTopologicalRing (MvPowerSeries (Fin d) A) :=
    MvPowerSeries.WithPiTopology.instIsTopologicalRing (Fin d) A
  have hopen (N : ℕ) : IsOpen ((maximalIdeal (MvPowerSeries (Fin d) A) ^ N :
      Ideal (MvPowerSeries (Fin d) A)) : Set (MvPowerSeries (Fin d) A)) :=
    isOpen_maximalIdeal_pow d N
  apply continuous_iff_le_induced.2
  rw [@induced_id _ (maximalIdeal (MvPowerSeries (Fin d) A)).adicTopology]
  apply TopologicalSpace.le_def.2
  intro s hs
  apply isOpen_iff_mem_nhds.2
  intro f hf
  have hBasis := Ideal.hasBasis_nhds_adic (maximalIdeal (MvPowerSeries (Fin d) A)) f
  have hmemAdic : s ∈ @nhds _ (maximalIdeal (MvPowerSeries (Fin d) A)).adicTopology f := by
    let _ : TopologicalSpace (MvPowerSeries (Fin d) A) :=
      (maximalIdeal (MvPowerSeries (Fin d) A)).adicTopology
    exact hs.mem_nhds hf
  obtain ⟨N, -, hN⟩ := hBasis.mem_iff.mp hmemAdic
  let V : Set (MvPowerSeries (Fin d) A) :=
    (fun y => y - f) ⁻¹' ((maximalIdeal (MvPowerSeries (Fin d) A) ^ N :
      Ideal (MvPowerSeries (Fin d) A)) : Set (MvPowerSeries (Fin d) A))
  have hVopen : IsOpen V := (hopen N).preimage (continuous_id.sub continuous_const)
  have hVmem : V ∈ nhds f := hVopen.mem_nhds (by simp [V])
  refine Filter.mem_of_superset hVmem fun y hy => hN ⟨y - f, hy, by simp⟩

end WithPiTopology

end MvPowerSeries

/-- A local homomorphism of local rings is continuous for the maximal-ideal-adic
topologies. -/
theorem RingHom.continuous_adic_of_isLocalHom {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f] :
    @Continuous R S (maximalIdeal R).adicTopology (maximalIdeal S).adicTopology f :=
  (f.continuous_adic_iff _ _).2 ⟨1, le_rfl, fun x hx =>
    map_maximalIdeal_le f (Ideal.mem_map_of_mem f (by simpa using hx))⟩

namespace PowerSeries

/-- Two ring maps out of a one-variable power series ring agreeing on constants and on the
variable, with nilpotent image of the variable, are equal. -/
@[ega "0 19.3.4.1" "(ii)"]
theorem hom_ext_of_isNilpotent
    {R A : Type*} [CommRing R] [CommRing A] (f g : PowerSeries R →+* A)
    (hC : ∀ r, f (PowerSeries.C r) = g (PowerSeries.C r))
    (hX : f PowerSeries.X = g PowerSeries.X)
    (hnil : IsNilpotent (f PowerSeries.X)) : f = g := by
  obtain ⟨n, hn⟩ := hnil
  have hpoly (p : Polynomial R) : f p = g p := by
    induction p using Polynomial.induction_on' with
    | add p q hp hq => simp only [Polynomial.coe_add, map_add, hp, hq]
    | monomial n r =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial]
      simp only [Polynomial.coe_mul, Polynomial.coe_C, Polynomial.coe_pow,
        Polynomial.coe_X, map_mul, map_pow, hC, hX]
  ext p
  rw [PowerSeries.eq_X_pow_mul_shift_add_trunc n p]
  simp only [map_add, map_mul, map_pow, ← hX, hn, zero_mul, zero_add, hpoly]

end PowerSeries

namespace MvPowerSeries

/-- Two ring maps out of a power series ring in finitely many variables agreeing on constants
and on the variables, with nilpotent images of the variables, are equal. -/
@[ega "0 19.3.4.1" "(ii)"]
theorem hom_ext_of_isNilpotent
    {R A : Type*} [CommRing R] [CommRing A] (d : ℕ)
    (f g : MvPowerSeries (Fin d) R →+* A)
    (hC : ∀ r, f (MvPowerSeries.C r) = g (MvPowerSeries.C r))
    (hX : ∀ i, f (MvPowerSeries.X i) = g (MvPowerSeries.X i))
    (hnil : ∀ i, IsNilpotent (f (MvPowerSeries.X i))) : f = g := by
  induction d with
  | zero =>
    ext p
    have hp : p = MvPowerSeries.C (MvPowerSeries.constantCoeff p) :=
      ((MvPowerSeries.isEmptyEquiv (Fin 0) R).symm_apply_apply p).symm
    rw [hp, hC]
  | succ d ih =>
    let e := MvPowerSeries.finSuccEquiv R d
    let f' := f.comp e.symm.toRingHom
    let g' := g.comp e.symm.toRingHom
    have hzero : e.symm PowerSeries.X = MvPowerSeries.X 0 :=
      e.symm_apply_eq.mpr (MvPowerSeries.finSuccEquiv_X_zero (R := R) (n := d)).symm
    have hsucc (i : Fin d) :
        e.symm (PowerSeries.C (MvPowerSeries.X i)) = MvPowerSeries.X i.succ :=
      e.symm_apply_eq.mpr (MvPowerSeries.finSuccEquiv_X_succ (R := R) i).symm
    have hconst (r : R) : e.symm (PowerSeries.C (MvPowerSeries.C r)) = MvPowerSeries.C r :=
      e.symm_apply_eq.mpr (MvPowerSeries.finSuccEquiv_C (n := d) r).symm
    have hcoeff : f'.comp PowerSeries.C = g'.comp PowerSeries.C := by
      apply ih
      · intro r
        change f (e.symm (PowerSeries.C (MvPowerSeries.C r))) =
          g (e.symm (PowerSeries.C (MvPowerSeries.C r)))
        rw [hconst, hC]
      · intro i
        change f (e.symm (PowerSeries.C (MvPowerSeries.X i))) =
          g (e.symm (PowerSeries.C (MvPowerSeries.X i)))
        rw [hsucc, hX]
      · intro i
        change IsNilpotent (f (e.symm (PowerSeries.C (MvPowerSeries.X i))))
        rw [hsucc]
        exact hnil i.succ
    have hh : f' = g' := PowerSeries.hom_ext_of_isNilpotent f' g'
      (fun r ↦ DFunLike.congr_fun hcoeff r)
      (by change f (e.symm PowerSeries.X) = g (e.symm PowerSeries.X); rw [hzero, hX])
      (by change IsNilpotent (f (e.symm PowerSeries.X)); rw [hzero]; exact hnil 0)
    ext p
    have H := DFunLike.congr_fun hh (e p)
    change f (e.symm (e p)) = g (e.symm (e p)) at H
    simpa only [AlgEquiv.symm_apply_apply] using H

end MvPowerSeries

