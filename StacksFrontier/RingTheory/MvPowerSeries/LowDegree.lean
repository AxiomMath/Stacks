module

public import StacksFrontier.RingTheory.CompleteLocalRing.Regular
public import StacksFrontier.RingTheory.MvPowerSeries.CotangentSpace

/-!
# Coefficients of low total degree of a power series in a power of the maximal ideal

A multivariate formal power series lying in the `t`-th power of the ideal generated by the
variables has vanishing coefficient in every total degree below `t`. This is the converse of
`Stacks.MvPowerSeries.RegularParameters.mem_sq_maximalIdeal_of_linear_coeff_zero`, and holds for
every exponent rather than for `t = 2`.

## Main definitions

* `Stacks.MvPowerSeries.RegularParameters.lowDegreeVanishing` — the ideal of power series whose
  coefficients in total degree below `t` all vanish.

## Main results

* `Stacks.MvPowerSeries.RegularParameters.coeff_eq_zero_of_mem_pow_span_range_X` — a series in
  `(X_0, …, X_{n-1}) ^ t` has vanishing coefficients in total degree below `t`.
* `Stacks.MvPowerSeries.RegularParameters.coeff_eq_zero_of_mem_pow_maximalIdeal` — the same over a
  field, with the ideal written as the maximal ideal.

## Implementation notes

The proof is the standard filtration argument, run with `lowDegreeVanishing` as an ideal in its
own right: the variables lie in `lowDegreeVanishing 1`, the product of `lowDegreeVanishing s` and
`lowDegreeVanishing t` lies in `lowDegreeVanishing (s + t)`, and the conclusion follows by
induction on `t`. Total degree is spelled `∑ i, d i` rather than through `Finsupp.degree`, because
the two facts needed about it — monotonicity in the index and additivity along the antidiagonal —
are then `Finset.sum_le_sum` and `Finset.sum_add_distrib`.
-/

@[expose] public section

open IsLocalRing

namespace Stacks.MvPowerSeries.RegularParameters

variable {R : Type*} [CommRing R] {n : ℕ}

/-- The ideal of those power series in `n` variables all of whose coefficients in total degree
less than `t` vanish. -/
def lowDegreeVanishing (R : Type*) [CommRing R] (n t : ℕ) : Ideal (MvPowerSeries (Fin n) R) where
  carrier := {u | ∀ d : Fin n →₀ ℕ, (∑ i, d i) < t → MvPowerSeries.coeff d u = 0}
  add_mem' hu hv d hd := by rw [map_add, hu d hd, hv d hd, add_zero]
  zero_mem' d _ := by rw [map_zero]
  smul_mem' c u hu d hd := by
    rw [smul_eq_mul, MvPowerSeries.coeff_mul]
    refine Finset.sum_eq_zero fun p hp => ?_
    have hsum : p.1 + p.2 = d := Finset.mem_antidiagonal.mp hp
    have hle : (∑ i, p.2 i) ≤ ∑ i, d i :=
      Finset.sum_le_sum fun i _ => by
        have := congrArg (fun e : Fin n →₀ ℕ => e i) hsum
        simp only [Finsupp.add_apply] at this
        omega
    rw [hu p.2 (lt_of_le_of_lt hle hd), mul_zero]

/-- A power series lies in `lowDegreeVanishing R n t` if and only if all its coefficients in
total degree less than `t` vanish. -/
theorem mem_lowDegreeVanishing_iff {t : ℕ} {u : MvPowerSeries (Fin n) R} :
    u ∈ lowDegreeVanishing R n t ↔
      ∀ d : Fin n →₀ ℕ, (∑ i, d i) < t → MvPowerSeries.coeff d u = 0 :=
  Iff.rfl

/-- A variable has no coefficient in total degree `0`. -/
theorem span_range_X_le_lowDegreeVanishing_one :
    Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) ≤
      lowDegreeVanishing R n 1 := by
  rw [Ideal.span_le]
  rintro x ⟨i, rfl⟩ d hd
  have hd0 : d = 0 := by
    refine Finsupp.ext fun j => ?_
    have := Finset.single_le_sum (f := fun i : Fin n => d i) (fun _ _ => Nat.zero_le _)
      (Finset.mem_univ j)
    simp only [Finsupp.coe_zero, Pi.zero_apply]
    omega
  rw [hd0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPowerSeries.constantCoeff_X]

/-- The degrees add: a product of a series vanishing below degree `s` and one vanishing below
degree `t` vanishes below degree `s + t`. -/
theorem lowDegreeVanishing_mul_le (s t : ℕ) :
    lowDegreeVanishing R n s * lowDegreeVanishing R n t ≤ lowDegreeVanishing R n (s + t) := by
  refine Ideal.mul_le.mpr fun u hu v hv d hd => ?_
  rw [MvPowerSeries.coeff_mul]
  refine Finset.sum_eq_zero fun p hp => ?_
  have hsum : p.1 + p.2 = d := Finset.mem_antidiagonal.mp hp
  have hadd : (∑ i, p.1 i) + (∑ i, p.2 i) = ∑ i, d i := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => by
      have := congrArg (fun e : Fin n →₀ ℕ => e i) hsum
      simpa only [Finsupp.add_apply] using this
  by_cases h : (∑ i, p.1 i) < s
  · rw [hu p.1 h, zero_mul]
  · rw [hv p.2 (by omega), mul_zero]

/-- The `t`-th power of the ideal generated by the variables is contained in
`lowDegreeVanishing R n t`. -/
theorem pow_span_range_X_le_lowDegreeVanishing (t : ℕ) :
    Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) ^ t ≤
      lowDegreeVanishing R n t := by
  induction t with
  | zero =>
    rw [pow_zero, Ideal.one_eq_top]
    exact fun u _ d hd => absurd hd (by omega)
  | succ t ih =>
    calc Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) ^ (t + 1)
        = Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) ^ t *
            Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) :=
          pow_succ _ t
      _ ≤ lowDegreeVanishing R n t * lowDegreeVanishing R n 1 :=
          Ideal.mul_mono ih span_range_X_le_lowDegreeVanishing_one
      _ ≤ lowDegreeVanishing R n (t + 1) := lowDegreeVanishing_mul_le t 1

/-- **A power series in the `t`-th power of the ideal of variables has no coefficient in total
degree below `t`.** -/
theorem coeff_eq_zero_of_mem_pow_span_range_X {t : ℕ} {u : MvPowerSeries (Fin n) R}
    (hu : u ∈ Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) ^ t)
    (d : Fin n →₀ ℕ) (hd : (∑ i, d i) < t) : MvPowerSeries.coeff d u = 0 :=
  pow_span_range_X_le_lowDegreeVanishing t hu d hd

/-- **A power series over a field in the `t`-th power of the maximal ideal has no coefficient in
total degree below `t`.** -/
theorem coeff_eq_zero_of_mem_pow_maximalIdeal {K : Type*} [Field K] {t : ℕ}
    {u : MvPowerSeries (Fin n) K} (hu : u ∈ (maximalIdeal (MvPowerSeries (Fin n) K)) ^ t)
    (d : Fin n →₀ ℕ) (hd : (∑ i, d i) < t) : MvPowerSeries.coeff d u = 0 := by
  refine coeff_eq_zero_of_mem_pow_span_range_X ?_ d hd
  rwa [MvPowerSeries.maximalIdeal_eq_span_range_X K n] at hu

end Stacks.MvPowerSeries.RegularParameters

end
