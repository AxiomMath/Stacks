/-!
# A formal power series ring over a field is regular local

`k[[x_1, ..., x_n]]` is a regular local ring: its maximal ideal is generated by the `n`
variables, and adjoining each variable raises the Krull dimension by at least one, so the
dimension and the minimal number of generators of the maximal ideal agree.
-/

open IsLocalRing

@[expose] public section

namespace MvPowerSeries

/-- In finitely many variables the ideal generated by the variables is the kernel of the constant
coefficient: a power series with vanishing constant term is a combination of the variables. This
is the multivariate `PowerSeries.maximalIdeal_eq_span_X`, over an arbitrary base. -/
public theorem span_X_eq_ker_constantCoeff (R : Type*) [CommRing R] (n : ℕ) :
    Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) R)) =
      RingHom.ker (constantCoeff : MvPowerSeries (Fin n) R →+* R) := by
  refine le_antisymm (Ideal.span_le.2 ?_) ?_
  · rintro _ ⟨j, rfl⟩
    simp [RingHom.mem_ker]
  · induction n with
    | zero =>
      intro φ hφ
      have hφ0 : φ = 0 := by
        ext m
        rw [Subsingleton.elim m 0]
        simpa using RingHom.mem_ker.1 hφ
      simp [hφ0]
    | succ n ih =>
      intro φ hφ
      set e := MvPowerSeries.finSuccEquiv R n with he
      -- `T` is the inclusion of `R[[x_1, …, x_n]]` as the constant term in `x_0`
      set T : MvPowerSeries (Fin n) R →+* MvPowerSeries (Fin (n + 1)) R :=
        ((e.symm : _ →ₐ[R] _).toRingHom).comp PowerSeries.C with hT
      have hTX : ∀ j : Fin n, T (X j) = X j.succ := fun j => by
        simp only [hT, RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
          AlgHom.coe_toRingHom, AlgEquiv.coe_toAlgHom]
        rw [he, ← finSuccEquiv_X_succ (R := R) j, AlgEquiv.symm_apply_apply]
      set a : MvPowerSeries (Fin n) R := PowerSeries.coeff 0 (e φ) with hadef
      have ha : a ∈ RingHom.ker (constantCoeff : MvPowerSeries (Fin n) R →+* R) := by
        have h1 := MvPowerSeries.coeff_coeff_finSuccEquiv (R := R) (n := n) φ (k := 0) (x := 0)
        rw [Finsupp.cons_zero_zero] at h1
        rw [RingHom.mem_ker, ← coeff_zero_eq_constantCoeff]
        simpa [hadef] using
          h1.trans (by rw [coeff_zero_eq_constantCoeff]; exact RingHom.mem_ker.1 hφ)
      obtain ⟨q, hq⟩ : PowerSeries.X ∣ (e φ - PowerSeries.C a) := by
        rw [PowerSeries.X_dvd_iff]
        simp [hadef, ← PowerSeries.coeff_zero_eq_constantCoeff]
      have hφ' : φ = T a + X 0 * e.symm q := by
        have h2 : φ = e.symm (PowerSeries.C a + PowerSeries.X * q) := by
          rw [show PowerSeries.C a + PowerSeries.X * q = e φ by rw [← hq]; ring,
            AlgEquiv.symm_apply_apply]
        rw [h2, map_add, map_mul]
        congr 1
        rw [he, ← finSuccEquiv_X_zero (R := R) (n := n), AlgEquiv.symm_apply_apply]
      have hmap : Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) R)) ≤
          (Ideal.span (Set.range (X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) R))).comap T :=
        Ideal.span_le.2 <| by
          rintro _ ⟨j, rfl⟩
          simp only [SetLike.mem_coe, Ideal.mem_comap, hTX]
          exact Ideal.subset_span ⟨j.succ, rfl⟩
      rw [hφ']
      exact Ideal.add_mem _ (hmap (ih ha))
        (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨0, rfl⟩))
end MvPowerSeries

/-- The maximal ideal of `k[[x_1, ..., x_n]]` is generated by the variables. -/
public theorem maximalIdeal_mvPowerSeries_eq_span_X (k : Type*) [Field k] (n : ℕ) :
    maximalIdeal (MvPowerSeries (Fin n) k) =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k)) := by
  rw [MvPowerSeries.span_X_eq_ker_constantCoeff,
    IsLocalRing.ker_eq_maximalIdeal
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) k →+* k)
      fun c => ⟨MvPowerSeries.C c, by simp⟩]

/-- Adjoining `n` formal variables raises the Krull dimension by at least `n`. -/
@[ega "0 17.1.4" "more general"]
public theorem ringKrullDim_add_le_mvPowerSeries (R : Type*) [CommRing R] (n : ℕ) :
    ringKrullDim R + n ≤ ringKrullDim (MvPowerSeries (Fin n) R) := by
  induction n with
  | zero =>
      simpa using (ringKrullDim_eq_of_ringEquiv
        (MvPowerSeries.isEmptyEquiv (Fin 0) R).toRingEquiv).ge
  | succ n ih =>
      rw [ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv R n).toRingEquiv]
      simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using
        (add_le_add ih (le_refl (1 : WithBot ℕ∞))).trans
          (ringKrullDim_succ_le_ringKrullDim_powerseries (R := MvPowerSeries (Fin n) R))

/-- `k[[x_1, ..., x_n]]` is a regular local ring. -/
@[sga "1 II 5.6" "(iii)"]
public theorem isRegularLocalRing_mvPowerSeries (k : Type*) [Field k] (n : ℕ) :
    IsRegularLocalRing (MvPowerSeries (Fin n) k) := by
  have hspan : (maximalIdeal (MvPowerSeries (Fin n) k)).spanFinrank ≤ n := by
    rw [maximalIdeal_mvPowerSeries_eq_span_X]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    simpa [← Set.image_univ] using
      Set.ncard_image_le (f := (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) k))
        Set.finite_univ
  have hdim : (n : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin n) k) := by
    simpa using ringKrullDim_add_le_mvPowerSeries k n
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ (le_trans ?_ hdim)
  exact_mod_cast hspan

end
