module

public import Mathlib.Algebra.Module.LocalizedModule.Exact
public import StacksFrontier.RingTheory.Dualizing.DerivedTorsion
public import StacksFrontier.RingTheory.Dualizing.LocalCohomology.Coreflection
public import StacksFrontier.RingTheory.LocalCohomology.BaseChange.ExtendLoc

/-!
# Derived localization away from an element, and the power-torsion criterion

Localization away from an element `a` of a commutative ring `A` is exact, so it induces an
endofunctor of the derived category `D(A)`. An object of `D(A)` has `I`-power-torsion
cohomology, for `I` generated by a finite set `s`, exactly when all its localizations at the
elements of `s` vanish.

The localization unit `M ⟶ M[1/a]`, read on the derived category, is invertible on objects in
the image of the localization functor, and the localization functor inverts it.

## Main definitions

* `Stacks.LocalCohomology.derivedLoc` — localization away from `a` on `D(A)`.
* `Stacks.LocalCohomology.derivedLocUnit` — the localization unit on `D(A)`.

## Main results

* `Stacks.LocalCohomology.derivedPowerTorsion_iff_loc` — the power-torsion criterion.
* `Stacks.LocalCohomology.derivedLocUnit_obj_isIso`,
  `Stacks.LocalCohomology.derivedLocUnit_map_isIso` — idempotence of the unit.
* `Stacks.LocalCohomology.derivedLoc_preserves_kernel` — localizing at `a` an object killed by
  localization at `b` leaves it killed by localization at `b`.

## References

* [Stacks Project, Tag 0A6R](https://stacks.math.columbia.edu/tag/0A6R)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

namespace Stacks.LocalCohomology

export Dualizing.Coreflection (complexUnit derivedUnit derivedUnit_app_Q isIso_app_of_iso
  derivedUnit_obj_isIso derivedUnit_map_isIso isZero_iff_zero_isIso isZero_iff_homology)

section Loc

universe u w

variable {A : Type u} [CommRing A]

/-- Localization away from `a` preserves exact short complexes of modules. -/
lemma locFunctor_map_exact (a : A) (T : ShortComplex (ModuleCat.{max u w} A)) (hT : T.Exact) :
    (T.map (locFunctor.{u, w} a)).Exact := by
  rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact] at hT ⊢
  exact IsLocalizedModule.map_exact (Submonoid.powers a)
    (LocalizedModule.mkLinearMap _ T.X₁) (LocalizedModule.mkLinearMap _ T.X₂)
    (LocalizedModule.mkLinearMap _ T.X₃) T.f.hom T.g.hom hT

/-- Localization away from `a` preserves finite limits. -/
instance locFunctor_preservesFiniteLimits (a : A) :
    PreservesFiniteLimits (locFunctor.{u, w} a) := by
  have h := ((Functor.exact_tfae (locFunctor.{u, w} a)).out 2 4).mp (locFunctor_map_exact a)
  exact h.1

/-- Localization away from `a` preserves finite colimits. -/
instance locFunctor_preservesFiniteColimits (a : A) :
    PreservesFiniteColimits (locFunctor.{u, w} a) := by
  have h := ((Functor.exact_tfae (locFunctor.{u, w} a)).out 2 4).mp (locFunctor_map_exact a)
  exact h.2

/-- The localization unit `M ⟶ M[1/a]`, as a natural transformation out of the identity. -/
def locUnit (a : A) : 𝟭 (ModuleCat.{max u w} A) ⟶ locFunctor.{u, w} a where
  app M := ModuleCat.ofHom (LocalizedModule.mkLinearMap (Submonoid.powers a) M)
  naturality {M N} g :=
    ModuleCat.hom_ext (IsLocalizedModule.map_comp (Submonoid.powers a)
      (LocalizedModule.mkLinearMap _ M) (LocalizedModule.mkLinearMap _ N) g.hom).symm

/-- The localization of `M` away from `a` vanishes exactly when every element of `M` is killed
by a power of `a`. -/
lemma locObj_isZero_iff (a : A) (M : ModuleCat.{max u w} A) :
    IsZero (locObj a M) ↔ ∀ m : M, ∃ s : Submonoid.powers a, (s : A) • m = 0 := by
  rw [ModuleCat.isZero_iff_subsingleton,
    IsLocalizedModule.subsingleton_iff (Submonoid.powers a)
      (LocalizedModule.mkLinearMap (Submonoid.powers a) M)]
  exact ⟨fun h m => by obtain ⟨r, hr, hm⟩ := h m; exact ⟨⟨r, hr⟩, hm⟩,
    fun h m => by obtain ⟨r, hr⟩ := h m; exact ⟨r, r.property, hr⟩⟩

/-- If the localization of `M` away from `a` vanishes, so does the localization away from `a` of
the localization of `M` away from `b`. -/
lemma locObj_preserves_kernel (a b : A) (M : ModuleCat.{max u w} A)
    (h : IsZero (locObj.{u, w} a M)) : IsZero (locObj.{u, w} a (locObj.{u, w} b M)) := by
  rw [locObj_isZero_iff] at h ⊢
  intro x
  obtain ⟨⟨m, t⟩, rfl⟩ := IsLocalizedModule.mk'_surjective (Submonoid.powers b)
    (LocalizedModule.mkLinearMap (Submonoid.powers b) M) x
  obtain ⟨s, hs⟩ := h m
  refine ⟨s, ?_⟩
  simp only [Function.uncurry_apply_pair]
  rw [← IsLocalizedModule.mk'_smul, hs, IsLocalizedModule.mk'_zero]

/-- A module over a ring in which the powers of `a` act invertibly is its own localization
away from `a`. -/
lemma locUnit_bijective (a : A) (M : ModuleCat.{max u w} A)
    (h : ∀ s : Submonoid.powers a, IsUnit (algebraMap A (Module.End A M) s)) :
    Function.Bijective (LocalizedModule.mkLinearMap (Submonoid.powers a) M) := by
  let : IsLocalizedModule (Submonoid.powers a) (LinearMap.id : M →ₗ[A] M) :=
    { map_units := h
      surj x := ⟨⟨x, 1⟩, by simp⟩
      exists_of_eq hx := ⟨1, by simpa using hx⟩ }
  have he : (IsLocalizedModule.linearEquiv (Submonoid.powers a) (LinearMap.id : M →ₗ[A] M)
      (LocalizedModule.mkLinearMap (Submonoid.powers a) M)).toLinearMap =
      LocalizedModule.mkLinearMap (Submonoid.powers a) M := by
    ext x
    exact IsLocalizedModule.linearEquiv_apply (Submonoid.powers a) _ _ x
  rw [← he]
  exact (IsLocalizedModule.linearEquiv _ _ _).bijective

/-- The localization unit is an isomorphism on a module localized away from `a`. -/
lemma locUnit_obj_isIso (a : A) (M : ModuleCat.{max u w} A) :
    IsIso ((locUnit.{u, w} a).app ((locFunctor.{u, w} a).obj M)) := by
  change IsIso (ModuleCat.ofHom
    (LocalizedModule.mkLinearMap (Submonoid.powers a) (locObj a M)))
  exact (ConcreteCategory.isIso_iff_bijective _).2 <| locUnit_bijective a (locObj a M)
    (IsLocalizedModule.map_units (LocalizedModule.mkLinearMap (Submonoid.powers a) M))

/-- Localizing the localization unit of `M` gives the localization unit of the localization
of `M`. -/
lemma locUnit_map_eq (a : A) (M : ModuleCat.{max u w} A) :
    (locFunctor.{u, w} a).map ((locUnit.{u, w} a).app M) =
      (locUnit.{u, w} a).app ((locFunctor.{u, w} a).obj M) := by
  apply ModuleCat.hom_ext
  apply IsLocalizedModule.ext (Submonoid.powers a)
    (LocalizedModule.mkLinearMap (Submonoid.powers a) M)
    (IsLocalizedModule.map_units
      (LocalizedModule.mkLinearMap (Submonoid.powers a) (locObj a M)))
  exact IsLocalizedModule.map_comp (Submonoid.powers a)
    (LocalizedModule.mkLinearMap (Submonoid.powers a) M)
    (LocalizedModule.mkLinearMap (Submonoid.powers a) (locObj a M))
    (LocalizedModule.mkLinearMap (Submonoid.powers a) M)

/-- Localization away from `a` inverts the localization unit. -/
lemma locUnit_map_isIso (a : A) (M : ModuleCat.{max u w} A) :
    IsIso ((locFunctor.{u, w} a).map ((locUnit.{u, w} a).app M)) :=
  locUnit_map_eq a M ▸ locUnit_obj_isIso a M

/-- Localization away from `a`, read on the derived category. -/
abbrev derivedLoc (a : A) :
    DerivedCategory (ModuleCat.{max u w} A) ⥤ DerivedCategory (ModuleCat.{max u w} A) :=
  (locFunctor.{u, w} a).mapDerivedCategory

/-- The localization unit, read on the derived category. -/
abbrev derivedLocUnit (a : A) :
    𝟭 (DerivedCategory (ModuleCat.{max u w} A)) ⟶ derivedLoc.{u, w} a :=
  derivedUnit (locFunctor.{u, w} a) (locUnit.{u, w} a)

/-- The derived localization unit is an isomorphism on objects in the image of `derivedLoc a`. -/
lemma derivedLocUnit_obj_isIso (a : A) (X : DerivedCategory (ModuleCat.{max u w} A)) :
    IsIso ((derivedLocUnit.{u, w} a).app ((derivedLoc.{u, w} a).obj X)) :=
  derivedUnit_obj_isIso _ _ (locUnit_obj_isIso a) X

/-- The derived localization functor inverts the derived localization unit. -/
lemma derivedLocUnit_map_isIso (a : A) (X : DerivedCategory (ModuleCat.{max u w} A)) :
    IsIso ((derivedLoc.{u, w} a).map ((derivedLocUnit.{u, w} a).app X)) :=
  derivedUnit_map_isIso _ _ (locUnit_map_isIso a) X

/-- The derived localization of `X` away from `a` vanishes exactly when the localization away
from `a` of every cohomology module of `X` vanishes. -/
lemma derivedLoc_isZero_iff (a : A) (X : DerivedCategory (ModuleCat.{max u w} A)) :
    IsZero ((derivedLoc.{u, w} a).obj X) ↔
      ∀ i, IsZero (locObj a ((DerivedCategory.homologyFunctor _ i).obj X)) := by
  rw [isZero_iff_homology]
  exact forall_congr' fun i =>
    ((Dualizing.mapDerivedCategoryHomologyIso (locFunctor.{u, w} a) i).app X).isZero_iff

/-- If the derived localization of `X` away from `a` vanishes, so does the derived localization
away from `a` of the derived localization of `X` away from `b`. -/
lemma derivedLoc_preserves_kernel (a b : A) (X : DerivedCategory (ModuleCat.{max u w} A))
    (h : IsZero ((derivedLoc.{u, w} a).obj X)) :
    IsZero ((derivedLoc.{u, w} a).obj ((derivedLoc.{u, w} b).obj X)) := by
  rw [derivedLoc_isZero_iff] at h ⊢
  intro i
  exact (locObj_preserves_kernel a b _ (h i)).of_iso
    ((locFunctor.{u, w} a).mapIso
      ((Dualizing.mapDerivedCategoryHomologyIso (locFunctor.{u, w} b) i).app X))

/-- A module is `I`-power torsion, for `I` spanned by a finite set `s`, exactly when all the
localizations at the elements of `s` vanish. -/
lemma isIPowerTorsion_iff_loc (s : Finset A) (M : ModuleCat.{max u w} A) :
    IsIPowerTorsion A M (Ideal.span (s : Set A)) ↔
      ∀ a ∈ s, IsZero (locObj.{u, w} a M) := by
  constructor
  · intro h a ha
    rw [locObj_isZero_iff]
    intro m
    obtain ⟨n, _, hn⟩ := h m
    exact ⟨⟨a ^ n, (Submonoid.mem_powers_iff _ _).2 ⟨n, rfl⟩⟩,
      hn _ (Ideal.pow_mem_pow (Ideal.subset_span ha) n)⟩
  · intro h m
    have hle : Ideal.span (s : Set A) ≤ (A ∙ m).annihilator.radical := by
      rw [Ideal.span_le]
      intro a ha
      obtain ⟨t, ht⟩ := (locObj_isZero_iff a M).mp (h a ha) m
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp t.property
      exact ⟨n, (Submodule.mem_annihilator_span_singleton m _).2 (hn ▸ ht)⟩
    obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hle
      (Submodule.fg_span s.finite_toSet)
    exact ⟨n + 1, Nat.succ_pos _, fun c hc => (Submodule.mem_annihilator_span_singleton m c).1
      (hn (Ideal.pow_le_pow_right n.le_succ hc))⟩

/-- An object of `D(A)` has `I`-power-torsion cohomology
exactly when all its localizations at a finite generating set of `I` vanish. -/
lemma derivedPowerTorsion_iff_loc (I : Ideal A) (hI : I.FG) (s : Finset A)
    (hs : Ideal.span (s : Set A) = I) (X : DerivedCategory (ModuleCat.{max u w} A)) :
    Dualizing.derivedPowerTorsionProperty A I hI X ↔
      ∀ a ∈ s, IsZero ((derivedLoc.{u, w} a).obj X) := by
  subst hs
  change (∀ i, IsIPowerTorsion A
    ((DerivedCategory.homologyFunctor (ModuleCat.{max u w} A) i).obj X)
      (Ideal.span (s : Set A))) ↔ _
  exact ⟨fun h a ha => (derivedLoc_isZero_iff a X).2 fun i =>
      (isIPowerTorsion_iff_loc.{u, w} s _).1 (h i) a ha,
    fun h i => (isIPowerTorsion_iff_loc.{u, w} s _).2 fun a ha =>
      (derivedLoc_isZero_iff.{u, w} a X).1 (h a ha) i⟩

end Loc

end Stacks.LocalCohomology

end
