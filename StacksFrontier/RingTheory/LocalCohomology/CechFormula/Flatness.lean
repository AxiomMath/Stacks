/-!
# Flat modules and the derived tensor product of a localization

A flat module tensors exactly, so tensoring with it in the derived category computes the
cohomology of its argument degreewise: this is `flatTensorHomologyIso`, which identifies
`H^i(M[0] ⊗^L_A X)` with `M ⊗_A H^i(X)` for flat `M`. Specialized to `M = A_g`, a localization
of the ring, it turns the vanishing of a derived tensor product into a torsion condition on
cohomology, and that is the criterion this file is built for: an object of `D(A)` has
`I`-power-torsion cohomology, for `I` generated by `f₁, …, f_r`, exactly when its derived
tensor product with each `A_{f_j}` vanishes.

That criterion is what makes the Čech formula of Stacks 0A6R provable. The Čech complex is
built from localizations, and the statement that tensoring with it lands in the power-torsion
subcategory is, after this translation, the statement that a localization of a localization at
a different element dies.

The lemmas are stated for an arbitrary `CochainComplex.DerivedTensor.DerivedTensorProductGeneral`
in an independent module universe, so they apply to any implementation of the derived tensor
product rather than to one choice of it.

## Main results

* `Stacks.LocalCohomology.CechFormula.flatTensorHomologyIso` — a flat module tensors
  cohomology degreewise.
* `Stacks.LocalCohomology.CechFormula.localizedTensor_isZero_iff` — tensoring a module with a
  localization of the ring vanishes exactly on the torsion.
* `Stacks.LocalCohomology.CechFormula.powerTorsion_iff_localizedTensor_isZero` — the
  power-torsion criterion through derived tensor products with localizations.

## References

* [Stacks Project, Tag 0A6R](https://stacks.math.columbia.edu/tag/0A6R)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory

attribute [local instance] HasDerivedCategory.standard

universe u v

namespace Stacks.LocalCohomology.CechFormula

open CochainComplex.DerivedTensor
open Dualizing.Coreflection (isZero_iff_homology)

attribute [local instance] ModuleCat.liftedModuleMonoidalStruct
  ModuleCat.liftedModuleMonoidal ModuleCat.liftedModuleMonoidalPreadditive

/-- A complex concentrated in one degree on a flat module is K-flat. -/
theorem single_isKFlat {A : Type u} [CommRing A]
    (M : ModuleCat.{max u v} A) [Module.Flat A M] (n : ℤ) :
    ((CochainComplex.singleFunctor (ModuleCat.{max u v} A) n).obj M).KFlat := by
  let K := (CochainComplex.singleFunctor (ModuleCat.{max u v} A) n).obj M
  have (i : ℤ) : Module.Flat A (K.X i) := by
    by_cases hi : i = n
    · exact Module.Flat.of_linearEquiv
        (HomologicalComplex.singleObjXIsoOfEq (ComplexShape.up ℤ) n M i hi).toLinearEquiv
    · exact Module.Flat.of_linearEquiv
        (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) n M i hi).isoZero.toLinearEquiv
  exact CochainComplex.KFlat.kFlat_of_flat K n

/-- Tensoring with a flat module preserves finite limits and finite colimits. -/
theorem flat_tensor_preservesFinite {A : Type u} [CommRing A]
    (M : ModuleCat.{max u v} A) [Module.Flat A M] :
    PreservesFiniteLimits (tensorLeft M) ∧ PreservesFiniteColimits (tensorLeft M) := by
  refine ((Functor.exact_tfae (tensorLeft M)).out 2 4).mp fun S hS => ?_
  rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact] at hS ⊢
  exact Module.Flat.lTensor_exact M hS

/-- Every object of the derived category is represented by a K-flat complex. -/
theorem exists_kFlat_representative {A : Type u} [CommRing A]
    (X : DerivedCategory (ModuleCat.{max u v} A)) :
    ∃ K : CochainComplex (ModuleCat.{max u v} A) ℤ,
      K.KFlat ∧ Nonempty (DerivedCategory.Q.obj K ≅ X) := by
  let M := DerivedCategory.Q.objPreimage X
  obtain ⟨K, p, hK, _, hp, _⟩ := CochainComplex.KFlat.exists_kFlat_resolution M
  exact ⟨K, hK,
    ⟨asIso (DerivedCategory.Q.map p) ≪≫ DerivedCategory.Q.objObjPreimageIso X⟩⟩

/-- **A flat module tensors cohomology degreewise.** For `M` a flat `A`-module, the `i`-th
cohomology of `M[0] ⊗^L_A X` is `M ⊗_A H^i(X)`. Flatness is what makes the derived tensor
product computable term by term: a K-flat representative of `X` may be tensored with `M`
directly, and tensoring with a flat module commutes with taking homology. -/
def flatTensorHomologyIso {A : Type u} [CommRing A]
    (T : DerivedTensorProductGeneral.{u, v} A)
    (M : ModuleCat.{max u v} A) [Module.Flat A M]
    (X : DerivedCategory (ModuleCat.{max u v} A)) (i : ℤ) :
    (DerivedCategory.homologyFunctor _ i).obj
        ((T.tensor.obj ((DerivedCategory.singleFunctor _ 0).obj M)).obj X) ≅
      (tensorLeft M).obj ((DerivedCategory.homologyFunctor _ i).obj X) := by
  classical
  refine Classical.choice ?_
  obtain ⟨K, hK, ⟨e⟩⟩ := exists_kFlat_representative X
  refine ⟨?_⟩
  let S := (CochainComplex.singleFunctor (ModuleCat.{max u v} A) 0).obj M
  let F := tensorLeft M
  have := (flat_tensor_preservesFinite M).1
  have := (flat_tensor_preservesFinite M).2
  let c : (T.tensor.obj ((DerivedCategory.singleFunctor _ 0).obj M)).obj X ≅
      DerivedCategory.Q.obj (F.mapHomologicalComplex (.up ℤ) |>.obj K) :=
    ((T.tensor.mapIso ((DerivedCategory.singleFunctorIsoCompQ _ 0).app M)).app X) ≪≫
      (T.tensor.obj (DerivedCategory.Q.obj S)).mapIso e.symm ≪≫
      T.comparison S K (single_isKFlat M 0) hK ≪≫
      DerivedCategory.Q.mapIso (TotalTensorComplex.SingleTensor.singleTensorIso M K)
  exact (DerivedCategory.homologyFunctor _ i).mapIso c ≪≫
    (DerivedCategory.homologyFunctorFactors _ i).app _ ≪≫ (K.sc i).mapHomologyIso F ≪≫
    F.mapIso ((DerivedCategory.homologyFunctorFactors _ i).app K).symm ≪≫
    F.mapIso ((DerivedCategory.homologyFunctor _ i).mapIso e)

/-- A localization of the ring is flat as a module over the ring. -/
theorem localized_flat {A : Type u} [CommRing A] (S : Submonoid A) :
    Module.Flat A (LocalizedModule S (ULift.{v} A)) := by
  have : Module.Flat A (ULift.{v} A) := Module.Flat.of_linearEquiv ULift.moduleEquiv
  have : Module.Flat (Localization S) (LocalizedModule S (ULift.{v} A)) :=
    Module.Flat.localizedModule S
  have : Module.Flat A (Localization S) := IsLocalization.flat (Localization S) S
  exact Module.Flat.trans A (Localization S) (LocalizedModule S (ULift.{v} A))

/-- The localization of `ULift A` at `S` is the localization of the ring: both are localizations
of `A` at `S`, after the universe lift is undone. -/
def localizedULiftEquiv {A : Type u} [CommRing A] (S : Submonoid A) :
    LocalizedModule S (ULift.{v} A) ≃ₗ[A] Localization S :=
  IsLocalizedModule.linearEquiv S
    (LocalizedModule.mkLinearMap S (ULift.{v} A))
    (Algebra.linearMap A (Localization S) ∘ₗ ULift.moduleEquiv.toLinearMap)

/-- Tensoring a module with a localization of the ring is the localization of the module. -/
def localizedTensorEquiv {A : Type u} [CommRing A]
    (S : Submonoid A) (M : ModuleCat.{max u v} A) :
    TensorProduct A (LocalizedModule S (ULift.{v} A)) M ≃ₗ[A] LocalizedModule S M :=
  TensorProduct.congr (localizedULiftEquiv.{u, v} S) (LinearEquiv.refl A M) ≪≫ₗ
    ((LocalizedModule.equivTensorProduct S M).restrictScalars A).symm

/-- **Tensoring with a localization detects torsion.** The tensor product of `M` with the
localization `A_S` vanishes exactly when every element of `M` is killed by some element of `S`.
-/
theorem localizedTensor_isZero_iff {A : Type u} [CommRing A]
    (S : Submonoid A) (M : ModuleCat.{max u v} A) :
    IsZero (ModuleCat.of A (TensorProduct A (LocalizedModule S (ULift.{v} A)) M)) ↔
      ∀ x : M, ∃ s : S, s • x = 0 := by
  rw [(localizedTensorEquiv S M).toModuleIso.isZero_iff,
    ModuleCat.isZero_iff_subsingleton,
    IsLocalizedModule.subsingleton_iff S (LocalizedModule.mkLinearMap S M)]
  exact ⟨fun h x => by obtain ⟨s, hs, hx⟩ := h x; exact ⟨⟨s, hs⟩, hx⟩,
    fun h x => by obtain ⟨s, hs⟩ := h x; exact ⟨s, s.property, hs⟩⟩

/-- The derived tensor product of `X` with a localization of the ring vanishes exactly when
every cohomology class of `X` is killed by an element of the submonoid. -/
theorem derived_localizedTensor_isZero_iff {A : Type u} [CommRing A]
    (T : DerivedTensorProductGeneral.{u, v} A) (S : Submonoid A)
    (X : DerivedCategory (ModuleCat.{max u v} A)) :
    IsZero ((T.tensor.obj ((DerivedCategory.singleFunctor _ 0).obj
      (ModuleCat.of A (LocalizedModule S (ULift.{v} A))))).obj X) ↔
      ∀ i (x : (DerivedCategory.homologyFunctor (ModuleCat.{max u v} A) i).obj X),
        ∃ s : S, s • x = 0 := by
  have := localized_flat.{u, v} S
  rw [isZero_iff_homology]
  exact forall_congr' fun i =>
    ((flatTensorHomologyIso T
      (ModuleCat.of A (LocalizedModule S (ULift.{v} A))) X i).isZero_iff).trans
      (localizedTensor_isZero_iff S _)

/-- **The power-torsion criterion.** For an ideal generated by a finite family `f`, an object of
`D(A)` has `I`-power-torsion cohomology exactly when its derived tensor product with each of
the localizations `A_{f_j}` vanishes.

The forward direction localizes a torsion element at the generator that kills it. The converse
collects, for each generator, an exponent killing a fixed cohomology class; the ideal therefore
lies in the radical of the annihilator of that class, and finite generation upgrades this to a
power of the ideal annihilating it. -/
theorem powerTorsion_iff_localizedTensor_isZero {A : Type u} [CommRing A]
    (T : DerivedTensorProductGeneral.{u, v} A) {r : ℕ} (f : Fin r → A)
    (X : DerivedCategory (ModuleCat.{max u v} A)) :
    (∀ i, IsIPowerTorsion A ((DerivedCategory.homologyFunctor (ModuleCat.{max u v} A) i).obj X)
      (Ideal.span (Set.range f))) ↔
    ∀ j, IsZero ((T.tensor.obj ((DerivedCategory.singleFunctor _ 0).obj
      (ModuleCat.of A (LocalizedModule (Submonoid.powers (f j)) (ULift.{v} A))))).obj X) := by
  simp_rw [derived_localizedTensor_isZero_iff]
  constructor
  · intro h j i x
    obtain ⟨n, _, hn⟩ := h i x
    exact ⟨⟨f j ^ n, ⟨n, rfl⟩⟩,
      hn _ (Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self j)) n)⟩
  · intro h i x
    have hle : Ideal.span (Set.range f) ≤ (A ∙ x).annihilator.radical := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      obtain ⟨s, hs⟩ := h j i x
      obtain ⟨n, hn⟩ := s.property
      refine ⟨n, (Submodule.mem_annihilator_span_singleton x _).2 ?_⟩
      simpa only [Submonoid.smul_def, hn] using hs
    obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hle
      (Submodule.fg_span (Set.finite_range f))
    exact ⟨n + 1, Nat.succ_pos _, fun a ha =>
      (Submodule.mem_annihilator_span_singleton x a).1 (hn (Ideal.pow_le_pow_right n.le_succ ha))⟩

/-- Each term of the Čech complex of a family `f` on the regular module is flat: it is a finite
direct sum of localizations of the ring. -/
theorem cechTerm_flat {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (p : ℕ) : Module.Flat A (Cech.cechTerm f (ULift.{v} A) p) := by
  have (s : {s : Finset (Fin r) // s.card = p}) :
      Module.Flat A (Cech.cechMod f (ULift.{v} A) s.1) := localized_flat (Cech.cechSub f s.1)
  unfold Cech.cechTerm
  infer_instance

end Stacks.LocalCohomology.CechFormula
