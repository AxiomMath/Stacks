module

public import Mathlib.Algebra.Module.Injective
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Matlis duality detects zero maps, images and kernels

Let `R` be a commutative ring and `J` an injective `R`-module which is a cogenerator: every
nonzero element of every module is detected by a linear map into `J`. Over a local ring an
injective module containing a copy of the residue field is such a cogenerator. Then the
contravariant functor `Hom_R(-, J)` is exact and faithful, so it detects whether a map vanishes,
whether two maps into the same module have the same image, and whether a map is injective on the
image of another.

## Main results

* `Module.exists_apply_ne_zero_of_injective_residueField` — the cogenerator property over a
  local ring.
* `LinearMap.lcomp_eq_zero_iff`, `LinearMap.range_eq_range_iff_ker_lcomp_eq`,
  `LinearMap.forall_ker_comp_iff_range_lcomp_eq` — the three detection statements.
-/

@[expose] public section

open Function

universe u v w

variable {R : Type u} [CommRing R]

/-- Over an injective module `J`, a map `j` vanishing on `ker g` factors through `g`. -/
private theorem exists_comp_eq_of_ker_le {J : Type v} [AddCommGroup J] [Module R J]
    [Module.Injective R J] {M : Type*} {N : Type v} [AddCommGroup M] [Module R M] [AddCommGroup N]
    [Module R N] (g : M →ₗ[R] N) (j : M →ₗ[R] J) (h : LinearMap.ker g ≤ LinearMap.ker j) :
    ∃ f : N →ₗ[R] J, ∀ m, f (g m) = j m := by
  obtain ⟨f, hf⟩ := Module.Injective.out (LinearMap.range g).subtype Subtype.val_injective
    (((LinearMap.ker g).liftQ j h).comp g.quotKerEquivRange.symm.toLinearMap)
  refine ⟨f, fun m ↦ ?_⟩
  simpa [LinearMap.quotKerEquivRange_symm_apply_image] using
    hf ⟨g m, LinearMap.mem_range_self g m⟩

/-- **Over a local ring, an injective module containing the residue field is a cogenerator.**
If `ι : κ →ₗ J` is injective and `J` is an injective module, then every nonzero element of every
module is detected by a linear map into `J`. The cyclic submodule generated by `x` is a quotient
of `R` by an ideal contained in the maximal ideal, so it maps onto `κ`; compose with `ι` and
extend by injectivity. -/
theorem Module.exists_apply_ne_zero_of_injective_residueField [IsLocalRing R]
    {J : Type v} [AddCommGroup J] [Module R J] [Module.Injective R J]
    (ι : IsLocalRing.ResidueField R →ₗ[R] J) (hι : Function.Injective ι)
    {M : Type v} [AddCommGroup M] [Module R M] {x : M} (hx : x ≠ 0) :
    ∃ f : M →ₗ[R] J, f x ≠ 0 := by
  let g := LinearMap.toSpanSingleton R M x
  have hg : LinearMap.ker g ≠ ⊤ := by
    intro h
    have h1 : g 1 = 0 := (LinearMap.mem_ker).mp (h ▸ Submodule.mem_top)
    exact hx (by simpa [g] using h1)
  let j : R →ₗ[R] J := ι.comp (Algebra.linearMap R (IsLocalRing.ResidueField R))
  have hker : LinearMap.ker g ≤ LinearMap.ker j := by
    intro r hr
    have hz : algebraMap R (IsLocalRing.ResidueField R) r = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (IsLocalRing.le_maximalIdeal hg hr)
    change ι (algebraMap R (IsLocalRing.ResidueField R) r) = 0
    rw [hz, map_zero]
  obtain ⟨f, hf⟩ := exists_comp_eq_of_ker_le g j hker
  refine ⟨f, ?_⟩
  have hfx : f x = ι 1 := by simpa [g, j] using hf 1
  rw [hfx]
  intro h
  exact one_ne_zero (hι (h.trans (map_zero ι).symm))

section Cogenerator

variable {J : Type v} [AddCommGroup J] [Module R J]
  (hJ : ∀ {M : Type v} [AddCommGroup M] [Module R M] {x : M}, x ≠ 0 → ∃ f : M →ₗ[R] J, f x ≠ 0)

include hJ

variable {X Y Z : Type v} [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y]
  [AddCommGroup Z] [Module R Z]

/-- A map vanishes exactly when its Matlis dual does. -/
theorem LinearMap.lcomp_eq_zero_iff (a : X →ₗ[R] Y) :
    LinearMap.lcomp R J a = 0 ↔ a = 0 := by
  refine ⟨fun h ↦ ?_, fun h ↦ by subst h; ext; simp⟩
  ext x
  by_contra hx
  obtain ⟨f, hf⟩ := hJ hx
  exact hf (by simpa using LinearMap.congr_fun (LinearMap.congr_fun h f) x)

/-- **Images are detected by the Matlis dual.** If `a₁ = a₂ ∘ c`, then `a₁` and `a₂` have the
same image exactly when their duals have the same kernel. -/
theorem LinearMap.range_eq_range_iff_ker_lcomp_eq [Module.Injective R J]
    (a₂ : Y →ₗ[R] Z) (c : X →ₗ[R] Y) :
    LinearMap.range (a₂ ∘ₗ c) = LinearMap.range a₂ ↔
      LinearMap.ker (LinearMap.lcomp R J (a₂ ∘ₗ c)) = LinearMap.ker (LinearMap.lcomp R J a₂) := by
  constructor
  · intro h
    ext φ
    simp only [LinearMap.mem_ker]
    constructor
    · intro hφ
      ext y
      obtain ⟨x, hx⟩ : a₂ y ∈ LinearMap.range (a₂ ∘ₗ c) := h ▸ LinearMap.mem_range_self a₂ y
      simp only [LinearMap.lcomp_apply', LinearMap.comp_apply, LinearMap.zero_apply]
      rw [← hx]
      simpa using LinearMap.congr_fun hφ x
    · intro hφ
      ext x
      simpa using LinearMap.congr_fun hφ (c x)
  · intro h
    refine le_antisymm (LinearMap.range_comp_le_range c a₂) ?_
    rintro _ ⟨y, rfl⟩
    by_contra hy
    let W := LinearMap.range (a₂ ∘ₗ c)
    have hq : W.mkQ (a₂ y) ≠ 0 := by
      rwa [Ne, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    obtain ⟨f, hf⟩ := hJ hq
    let φ : Z →ₗ[R] J := f ∘ₗ W.mkQ
    have hφ : φ ∈ LinearMap.ker (LinearMap.lcomp R J (a₂ ∘ₗ c)) := by
      rw [LinearMap.mem_ker]
      ext x
      change f (W.mkQ ((a₂ ∘ₗ c) x)) = 0
      rw [Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero W).mpr
        (LinearMap.mem_range_self _ x), map_zero]
    rw [h, LinearMap.mem_ker] at hφ
    exact hf (by simpa [φ] using LinearMap.congr_fun hφ y)

/-- **Injectivity on an image is detected by the Matlis dual.** For `t : X → Y` and `u : Y → Z`,
`u` is injective on the image of `t` exactly when `t^∨` and `(u ∘ t)^∨` have the same image. -/
theorem LinearMap.forall_ker_comp_iff_range_lcomp_eq [Module.Injective R J]
    (t : X →ₗ[R] Y) (u : Y →ₗ[R] Z) :
    (∀ x, t x ∈ LinearMap.ker u → t x = 0) ↔
      LinearMap.range (LinearMap.lcomp R J (u ∘ₗ t)) = LinearMap.range (LinearMap.lcomp R J t) := by
  constructor
  · intro h
    refine le_antisymm ?_ ?_
    · rintro _ ⟨φ, rfl⟩
      exact ⟨φ ∘ₗ u, by ext; simp⟩
    · rintro _ ⟨ψ, rfl⟩
      -- `ψ ∘ t` vanishes on `ker (u ∘ t)`, so it factors through `range (u ∘ t) ⊆ Z`
      have hker : LinearMap.ker (u ∘ₗ t) ≤ LinearMap.ker (ψ ∘ₗ t) := by
        intro x hx
        simp [h x (by simpa using hx)]
      obtain ⟨φ, hφ⟩ := exists_comp_eq_of_ker_le (u ∘ₗ t) (ψ ∘ₗ t) hker
      exact ⟨φ, LinearMap.ext hφ⟩
  · intro h x hx
    by_contra hne
    obtain ⟨ψ, hψ⟩ := hJ hne
    obtain ⟨φ, hφ⟩ : LinearMap.lcomp R J t ψ ∈ LinearMap.range (LinearMap.lcomp R J (u ∘ₗ t)) :=
      h ▸ LinearMap.mem_range_self _ ψ
    have := LinearMap.congr_fun hφ x
    simp only [LinearMap.lcomp_apply', LinearMap.comp_apply] at this
    rw [LinearMap.mem_ker.mp hx, map_zero] at this
    exact hψ this.symm

end Cogenerator

section Transport

/-! ### Transporting the detection statements along a natural identification of the duals

If the Matlis duals of `X₀ → X₁ → X₂` are identified, compatibly with the maps, with a
contravariant diagram `Y₂ → Y₁ → Y₀` of additive groups, the three detection statements become
statements about the `Y`'s. -/

variable {J : Type v} [AddCommGroup J] [Module R J]
  (hJ : ∀ {M : Type v} [AddCommGroup M] [Module R M] {x : M}, x ≠ 0 → ∃ f : M →ₗ[R] J, f x ≠ 0)
variable {X₀ X₁ X₂ : Type v} [AddCommGroup X₀] [Module R X₀] [AddCommGroup X₁] [Module R X₁]
  [AddCommGroup X₂] [Module R X₂]
  {Y₀ Y₁ Y₂ : Type w} [AddCommGroup Y₀] [AddCommGroup Y₁] [AddCommGroup Y₂]
  (Φ₀ : (X₀ →ₗ[R] J) ≃+ Y₀) (Φ₁ : (X₁ →ₗ[R] J) ≃+ Y₁) (Φ₂ : (X₂ →ₗ[R] J) ≃+ Y₂)

include hJ in
/-- Vanishing of a map is detected on the identified duals. -/
theorem LinearMap.eq_zero_iff_of_dual_addEquiv (a : X₀ →ₗ[R] X₁) (τ : Y₁ →+ Y₀)
    (hτ : ∀ φ, Φ₀ (φ ∘ₗ a) = τ (Φ₁ φ)) : a = 0 ↔ τ = 0 := by
  rw [← LinearMap.lcomp_eq_zero_iff hJ a]
  constructor
  · intro h
    ext y
    obtain ⟨φ, rfl⟩ := Φ₁.surjective y
    rw [← hτ]
    have := LinearMap.congr_fun h φ
    simp only [LinearMap.lcomp_apply', LinearMap.zero_apply] at this
    rw [this, map_zero]
    rfl
  · intro h
    ext φ x
    have h1 := hτ φ
    rw [h, AddMonoidHom.zero_apply, AddEquiv.map_eq_zero_iff] at h1
    simpa using LinearMap.congr_fun h1 x

include hJ in
/-- Equality of images is detected on the identified duals. -/
theorem LinearMap.range_comp_eq_iff_of_dual_addEquiv [Module.Injective R J]
    (c : X₀ →ₗ[R] X₁) (a₂ : X₁ →ₗ[R] X₂) (τc : Y₁ →+ Y₀) (τa : Y₂ →+ Y₁)
    (hc : ∀ φ, Φ₀ (φ ∘ₗ c) = τc (Φ₁ φ)) (ha : ∀ φ, Φ₁ (φ ∘ₗ a₂) = τa (Φ₂ φ)) :
    LinearMap.range (a₂ ∘ₗ c) = LinearMap.range a₂ ↔
      (τc.comp τa).ker = τa.ker := by
  rw [LinearMap.range_eq_range_iff_ker_lcomp_eq hJ a₂ c]
  have key : ∀ φ : X₂ →ₗ[R] J,
      (φ ∈ LinearMap.ker (LinearMap.lcomp R J (a₂ ∘ₗ c)) ↔ Φ₂ φ ∈ (τc.comp τa).ker) ∧
      (φ ∈ LinearMap.ker (LinearMap.lcomp R J a₂) ↔ Φ₂ φ ∈ τa.ker) := by
    intro φ
    simp only [LinearMap.mem_ker, AddMonoidHom.mem_ker, AddMonoidHom.comp_apply, ← ha, ← hc,
      AddEquiv.map_eq_zero_iff]
    constructor <;> rfl
  constructor
  · intro h
    ext y
    obtain ⟨φ, rfl⟩ := Φ₂.surjective y
    rw [← (key φ).1, h, (key φ).2]
  · intro h
    ext φ
    rw [(key φ).1, h, (key φ).2]

include hJ in
/-- Injectivity on an image is detected on the identified duals. -/
theorem LinearMap.forall_ker_comp_iff_of_dual_addEquiv [Module.Injective R J]
    (t : X₀ →ₗ[R] X₁) (u : X₁ →ₗ[R] X₂) (τt : Y₁ →+ Y₀) (τu : Y₂ →+ Y₁)
    (ht : ∀ φ, Φ₀ (φ ∘ₗ t) = τt (Φ₁ φ)) (hu : ∀ φ, Φ₁ (φ ∘ₗ u) = τu (Φ₂ φ)) :
    (∀ x, t x ∈ LinearMap.ker u → t x = 0) ↔
      (τt.comp τu).range = τt.range := by
  rw [LinearMap.forall_ker_comp_iff_range_lcomp_eq hJ t u]
  have key : ∀ ψ : X₀ →ₗ[R] J,
      (ψ ∈ LinearMap.range (LinearMap.lcomp R J (u ∘ₗ t)) ↔ Φ₀ ψ ∈ (τt.comp τu).range) ∧
      (ψ ∈ LinearMap.range (LinearMap.lcomp R J t) ↔ Φ₀ ψ ∈ τt.range) := by
    intro ψ
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
    · rintro ⟨φ, rfl⟩
      refine ⟨Φ₂ φ, ?_⟩
      simp only [AddMonoidHom.comp_apply, ← hu, ← ht]
      rfl
    · rintro ⟨y, hy⟩
      obtain ⟨φ, rfl⟩ := Φ₂.surjective y
      refine ⟨φ, Φ₀.injective ?_⟩
      rw [← hy]
      simp only [AddMonoidHom.comp_apply, ← hu, ← ht]
      rfl
    · rintro ⟨φ, rfl⟩
      exact ⟨Φ₁ φ, (ht φ).symm⟩
    · rintro ⟨y, hy⟩
      obtain ⟨φ, rfl⟩ := Φ₁.surjective y
      exact ⟨φ, Φ₀.injective ((ht φ).trans hy)⟩
  constructor
  · intro h
    ext y
    obtain ⟨ψ, rfl⟩ := Φ₀.surjective y
    rw [← (key ψ).1, ← (key ψ).2, h]
  · intro h
    ext ψ
    rw [(key ψ).1, (key ψ).2, h]

end Transport
