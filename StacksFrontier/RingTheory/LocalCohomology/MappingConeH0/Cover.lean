module

public import StacksFrontier.RingTheory.LocalCohomology.BasicOpenSections.Glue

/-!
# The complement of a zero locus as a union of standard opens

Let `R` be a commutative ring and let `I = (f₁, …, f_r)` be an ideal generated by finitely many
elements. The open `U = Spec R \ V(I)` is covered by the standard opens `D(f_i)`: a prime fails to
contain `I` exactly when it fails to contain one of the generators. This file records that equality
of opens and feeds it into the sheaf axiom of
`StacksFrontier/RingTheory/LocalCohomology/BasicOpenSections/Glue.lean`, giving the sections of the
associated sheaf on `U` as the compatible families of sections on the `D(f_i)`.

Together with `Stacks.LocalCohomology.isLocalizedModule_moduleSectionsMk_basicOpen`, which
identifies the sections on `D(f_i)` with the localization `M_{f_i}`, this is the sheaf-theoretic
half of the degree-zero comparison of Stacks 0DWR; the other half, the degree-zero cohomology of
the Čech cone, is
`StacksFrontier/RingTheory/LocalCohomology/MappingConeH0/Cech.lean`.

## Main definitions

* `Stacks.LocalCohomology.moduleSectionsCongr` — transport of locally fractional sections along an
  equality of opens, as a linear equivalence. Both directions are restriction maps, so the two
  composites are the identity by definition.
* `Stacks.LocalCohomology.moduleSectionsComplementCoverEquiv` — **the sheaf axiom at `U`**: the
  sections of `M̃` on `Spec R \ V(I)` are the families of sections on the `D(f_i)` agreeing at
  every common point.

## Main results

* `Stacks.LocalCohomology.mem_complementZeroLocus_iff`,
  `Stacks.LocalCohomology.complementZeroLocus_eq_iSup_basicOpen` — `U = ⨆ i, D(f_i)`.

## References

* [Stacks Project, Tag 0DWR](https://stacks.math.columbia.edu/tag/0DWR)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace AlgebraicGeometry
open PrimeSpectrum (basicOpen)

universe v u

namespace Stacks.LocalCohomology

variable {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) (I : Ideal R)

/-- A prime lies outside the zero locus of `I = (f₁, …, f_r)` exactly when it misses one of the
generators. -/
theorem mem_complementZeroLocus_iff (hIf : Ideal.span (Set.range f) = I) (p : PrimeSpectrum R) :
    p ∈ (complementZeroLocus R I : Opens (PrimeSpectrum.Top R)) ↔ ∃ i, p ∈ basicOpen (f i) := by
  show p ∉ PrimeSpectrum.zeroLocus (I : Set R) ↔ _
  rw [← hIf, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe, Ideal.span_le,
    Set.range_subset_iff]
  simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_forall]

/-- **`Spec R \ V(I)` is covered by the standard opens of a generating family.** -/
theorem complementZeroLocus_eq_iSup_basicOpen (hIf : Ideal.span (Set.range f) = I) :
    (complementZeroLocus R I : Opens (PrimeSpectrum.Top R)) = ⨆ i, basicOpen (f i) :=
  SetLike.ext fun p =>
    (mem_complementZeroLocus_iff f I hIf p).trans (Opens.mem_iSup (x := p)).symm

variable (M : ModuleCat.{v} R)

/-- Locally fractional sections transported along an equality of opens. A section is a function on
the points of the open, so both directions are restriction maps and the two composites are the
identity by definition. -/
def moduleSectionsCongr {U V : Opens (PrimeSpectrum.Top R)} (h : U = V) :
    moduleSections M U ≃ₗ[R] moduleSections M V :=
  LinearEquiv.ofLinearMap (moduleSectionsRestrict M h.ge) (moduleSectionsRestrict M h.le) rfl rfl

/-- **The sheaf axiom on the complement of a zero locus.** For `I = (f₁, …, f_r)`, the sections of
the quasi-coherent module generated by `M` on `U = Spec R \ V(I)` are the families of sections on
the standard opens `D(f_i)` that agree at every point lying in two of them. The module universe is
independent of the ring universe. -/
def moduleSectionsComplementCoverEquiv (hIf : Ideal.span (Set.range f) = I) :
    moduleSections M (complementZeroLocus R I) ≃ₗ[R]
      compatibleModuleSections M (fun i => basicOpen (f i)) :=
  (moduleSectionsCongr M (complementZeroLocus_eq_iSup_basicOpen f I hIf)).trans
    (moduleSectionsCoverEquiv M _)

end Stacks.LocalCohomology

end
