module

public import Mathlib.RingTheory.Ideal.AssociatedPrime.Finiteness
public import Mathlib.RingTheory.Ideal.AssociatedPrime.Localization
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import StacksFrontier.RingTheory.LocalCohomology.ModulesSupportedIn

/-!
# Pro-vanishing of sections with support from its local counterparts

Let `A` be a Noetherian ring, `T ⊆ Spec(A)` a subset and `(M_k)` an inverse system of finite
`A`-modules with transition maps `M_k → M_m` for `m ≤ k`. This file proves that the inverse
system `{H⁰_T(M_k)}` of sections with support in `T` is *pro-zero* — for every `m` there is a
`k ≥ m` such that `H⁰_T(M_k) → M_m` vanishes — as soon as the analogous statement holds at every
prime `𝔮 ∈ T` for the sections of the localizations supported at the closed point: for every `m`
there is an `m₂ ≥ m` such that an element of `M_{m₂}` whose annihilator has no prime strictly
between itself and `𝔮` maps to an element of `M_m` killed by some `t ∉ 𝔮`.

## Main results

* `Stacks.LocalCohomology.wellFounded_lt_primeSpectrum_of_isNoetherianRing` — the primes of a
  Noetherian ring satisfy the descending chain condition.
* `Stacks.LocalCohomology.mem_associatedPrimes_of_mem_minimalPrimes_torsionOf` — a minimal prime
  over the annihilator of an element of a module over a Noetherian ring is an associated prime.
* `Stacks.LocalCohomology.exists_forall_sectionsWithSupportIn_map_eq_zero` — the pro-vanishing.

## References

* [Stacks Project, Tag 0EJE](https://stacks.math.columbia.edu/tag/0EJE)
* [Stacks Project, Tag 0EF9](https://stacks.math.columbia.edu/tag/0EF9), for the shape of the
  argument.
-/

@[expose] public section

universe u v

namespace Stacks.LocalCohomology

variable {A : Type u} [CommRing A]

/-- **The primes of a Noetherian ring satisfy the descending chain condition.** Every prime has
finite height and the height is strictly monotone on primes. -/
theorem wellFounded_lt_primeSpectrum_of_isNoetherianRing [IsNoetherianRing A] :
    WellFounded (fun p q : PrimeSpectrum A => p < q) :=
  Subrelation.wf (fun {p q} (h : p < q) =>
      show p.asIdeal.height < q.asIdeal.height from
        Ideal.height_strict_mono_of_isPrime_of_isPrime
          ((PrimeSpectrum.asIdeal_lt_asIdeal p q).mpr h))
    (InvImage.wf (fun p : PrimeSpectrum A => p.asIdeal.height) wellFounded_lt)

/-- The annihilator of the cyclic submodule generated by `x` is the annihilator of `x`. -/
theorem annihilator_span_singleton_eq_torsionOf {M : Type v} [AddCommGroup M] [Module A M]
    (x : M) : Module.annihilator A (A ∙ x) = Ideal.torsionOf A M x := by
  ext a
  rw [Module.mem_annihilator, Ideal.mem_torsionOf_iff]
  refine ⟨fun h => ?_, fun h m => ?_⟩
  · exact congrArg Subtype.val (h ⟨x, Submodule.mem_span_singleton_self x⟩)
  · obtain ⟨m, hm⟩ := m
    obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.mp hm
    apply Subtype.ext
    change a • b • x = 0
    rw [smul_comm, h, smul_zero]

/-- **A minimal prime over the annihilator of an element is an associated prime.** -/
theorem mem_associatedPrimes_of_mem_minimalPrimes_torsionOf [IsNoetherianRing A]
    {M : Type v} [AddCommGroup M] [Module A M] (x : M) {p : Ideal A}
    (hp : p ∈ (Ideal.torsionOf A M x).minimalPrimes) : p ∈ associatedPrimes A M := by
  have h1 : p ∈ associatedPrimes A (A ∙ x) := by
    apply Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes A (A ∙ x)
    rwa [annihilator_span_singleton_eq_torsionOf]
  exact associatedPrimes.subset_of_injective (f := (A ∙ x).subtype) Subtype.val_injective h1

/-- A linear map does not shrink the annihilator of an element. -/
theorem torsionOf_le_torsionOf_map {M N : Type v} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (f : M →ₗ[A] N) (x : M) :
    Ideal.torsionOf A M x ≤ Ideal.torsionOf A N (f x) := fun a ha => by
  rw [Ideal.mem_torsionOf_iff] at ha ⊢
  rw [← map_smul, ha, map_zero]

/-- A linear map carries sections with support in `T` to sections with support in `T`. -/
theorem map_mem_sectionsWithSupportIn (T : Set (PrimeSpectrum A)) {M N : Type v}
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] (f : M →ₗ[A] N) {x : M}
    (hx : x ∈ sectionsWithSupportIn A T M) : f x ∈ sectionsWithSupportIn A T N := by
  rw [mem_sectionsWithSupportIn_iff] at hx ⊢
  exact (PrimeSpectrum.zeroLocus_anti_mono (torsionOf_le_torsionOf_map f x)).trans hx

/-- A section with support in `T` is killed by an element outside every prime not in `T`. -/
theorem exists_smul_eq_zero_of_mem_sectionsWithSupportIn {T : Set (PrimeSpectrum A)}
    {M : Type v} [AddCommGroup M] [Module A M] {x : M} (hx : x ∈ sectionsWithSupportIn A T M)
    {q : PrimeSpectrum A} (hq : q ∉ T) : ∃ t ∉ q.asIdeal, t • x = 0 := by
  rw [mem_sectionsWithSupportIn_iff] at hx
  by_contra h
  push Not at h
  exact hq (hx fun a ha => by_contra fun hn => h a hn ha)

/-- If for each `p` in a finite set the sections with support in `T` are eventually killed by an
element outside `p`, then a single level works for all `p` simultaneously. -/
private theorem exists_forall_sectionsWithSupportIn_smul_eq_zero (T : Set (PrimeSpectrum A))
    (M : ℕ → Type v) [∀ n, AddCommGroup (M n)] [∀ n, Module A (M n)]
    (tr : ∀ {k m : ℕ}, m ≤ k → M k →ₗ[A] M m) {S : Set (Ideal A)}
    (htr : ∀ {l k m : ℕ} (h₁ : m ≤ k) (h₂ : k ≤ l) (x : M l),
      tr h₁ (tr h₂ x) = tr (h₁.trans h₂) x)
    (hS : S.Finite) {m : ℕ}
    (hlev : ∀ p ∈ S, ∃ k : ℕ, ∃ h : m ≤ k, ∀ x ∈ sectionsWithSupportIn A T (M k),
      ∃ t ∉ p, t • tr h x = 0) :
    ∃ k : ℕ, ∃ h : m ≤ k, ∀ x ∈ sectionsWithSupportIn A T (M k),
      ∀ p ∈ S, ∃ t ∉ p, t • tr h x = 0 := by
  choose! kk hkk hkill using hlev
  have hkk' : ∀ p ∈ S, kk p ≤ hS.toFinset.sup kk ⊔ m := fun p hp =>
    le_sup_of_le_left (Finset.le_sup (f := kk) (hS.mem_toFinset.mpr hp))
  refine ⟨hS.toFinset.sup kk ⊔ m, le_sup_right, fun x hx p hp => ?_⟩
  obtain ⟨t, ht, hty⟩ := hkill p hp (tr (hkk' p hp) x) (map_mem_sectionsWithSupportIn T _ hx)
  exact ⟨t, ht, by rwa [← htr (hkk p hp) (hkk' p hp) x]⟩

variable [IsNoetherianRing A] (T : Set (PrimeSpectrum A))
  (M : ℕ → Type v) [∀ n, AddCommGroup (M n)] [∀ n, Module A (M n)]
  [∀ n, Module.Finite A (M n)]
  (tr : ∀ {k m : ℕ}, m ≤ k → M k →ₗ[A] M m)
  (htr : ∀ {l k m : ℕ} (h₁ : m ≤ k) (h₂ : k ≤ l) (x : M l),
    tr h₁ (tr h₂ x) = tr (h₁.trans h₂) x)

/-- The local hypothesis at a prime `𝔮`: for every `m` there is a level `m₂ ≥ m` such that an
element of `M_{m₂}` whose annihilator has no prime strictly between itself and `𝔮` — an element
supported at the closed point after localizing at `𝔮` — maps to an element of `M_m` which is zero
after localizing at `𝔮`. -/
def LocalProZeroAt (q : PrimeSpectrum A) : Prop :=
  ∀ m : ℕ, ∃ m₂ : ℕ, ∃ h : m ≤ m₂, ∀ x : M m₂,
    (∀ p : Ideal A, p.IsPrime → Ideal.torsionOf A (M m₂) x ≤ p → p ≤ q.asIdeal →
      p = q.asIdeal) →
    ∃ t ∉ q.asIdeal, t • tr h x = 0

include htr in
/-- The induction step: locally at every prime `𝔮` the images of the sections with support in
`T` eventually vanish. -/
theorem exists_forall_sectionsWithSupportIn_localization_eq_zero
    (hloc : ∀ q ∈ T, LocalProZeroAt M tr q) (q : PrimeSpectrum A) :
    ∀ m : ℕ, ∃ k : ℕ, ∃ h : m ≤ k, ∀ x ∈ sectionsWithSupportIn A T (M k),
      ∃ t ∉ q.asIdeal, t • tr h x = 0 := by
  induction q using (wellFounded_lt_primeSpectrum_of_isNoetherianRing (A := A)).induction with
  | _ q ih =>
  intro m
  by_cases hqT : q ∉ T
  · exact ⟨m, le_rfl, fun x hx =>
      exists_smul_eq_zero_of_mem_sectionsWithSupportIn
        (map_mem_sectionsWithSupportIn T (tr le_rfl) hx) hqT⟩
  push Not at hqT
  obtain ⟨m₂, hm₂, hloc'⟩ := hloc q hqT m
  let S : Set (Ideal A) := {p | p ∈ associatedPrimes A (M m₂) ∧ p < q.asIdeal}
  have hSfin : S.Finite := (associatedPrimes.finite A (M m₂)).subset fun p hp => hp.1
  have hSprime : ∀ p ∈ S, p.IsPrime := fun p hp => hp.1.isPrime
  have hlev : ∀ p ∈ S, ∃ k : ℕ, ∃ h : m₂ ≤ k, ∀ x ∈ sectionsWithSupportIn A T (M k),
      ∃ t ∉ p, t • tr h x = 0 := fun p hp =>
    ih ⟨p, hSprime p hp⟩ ((PrimeSpectrum.asIdeal_lt_asIdeal _ q).mp hp.2) m₂
  obtain ⟨k, hm₂k, hS⟩ := exists_forall_sectionsWithSupportIn_smul_eq_zero T M tr htr hSfin hlev
  refine ⟨k, hm₂.trans hm₂k, fun x hx => ?_⟩
  set y := tr hm₂k x with hy
  have hprim : ∀ p : Ideal A, p.IsPrime → Ideal.torsionOf A (M m₂) y ≤ p →
      p ≤ q.asIdeal → p = q.asIdeal := by
    intro p hp hyp hpq
    by_contra hne
    obtain ⟨p₀, hp₀, hp₀p⟩ := Ideal.exists_minimalPrimes_le hyp
    have hp₀S : p₀ ∈ S :=
      ⟨mem_associatedPrimes_of_mem_minimalPrimes_torsionOf y hp₀,
        lt_of_le_of_lt hp₀p (lt_of_le_of_ne hpq hne)⟩
    obtain ⟨t, ht, hty⟩ := hS x hx p₀ hp₀S
    exact ht (hp₀.1.2 ((Ideal.mem_torsionOf_iff y t).mpr hty))
  obtain ⟨t, ht, hty⟩ := hloc' y hprim
  rw [hy, htr] at hty
  exact ⟨t, ht, hty⟩

include htr in
/-- **Pro-vanishing of the sections with support in `T`.** If at every prime of `T` the images of
the sections supported at the closed point eventually vanish locally, then for every `m` there is
a `k ≥ m` such that every section of `M_k` with support in `T` maps to zero in `M_m`. -/
theorem exists_forall_sectionsWithSupportIn_map_eq_zero
    (hloc : ∀ q ∈ T, LocalProZeroAt M tr q) (m : ℕ) :
    ∃ k : ℕ, ∃ h : m ≤ k, ∀ x ∈ sectionsWithSupportIn A T (M k), tr h x = 0 := by
  let S : Set (Ideal A) := {p | p ∈ associatedPrimes A (M m) ∧ ∀ hp : p.IsPrime, ⟨p, hp⟩ ∈ T}
  have hSfin : S.Finite := (associatedPrimes.finite A (M m)).subset fun p hp => hp.1
  have hSprime : ∀ p ∈ S, p.IsPrime := fun p hp => hp.1.isPrime
  have hlev : ∀ p ∈ S, ∃ k : ℕ, ∃ h : m ≤ k, ∀ x ∈ sectionsWithSupportIn A T (M k),
      ∃ t ∉ p, t • tr h x = 0 := fun p hp =>
    exists_forall_sectionsWithSupportIn_localization_eq_zero T M tr htr hloc
      ⟨p, hSprime p hp⟩ m
  obtain ⟨k, hmk, hS⟩ := exists_forall_sectionsWithSupportIn_smul_eq_zero T M tr htr hSfin hlev
  refine ⟨k, hmk, fun x hx => ?_⟩
  by_contra hne
  have hy := map_mem_sectionsWithSupportIn T (tr hmk) hx
  have htop : Ideal.torsionOf A (M m) (tr hmk x) ≠ ⊤ := fun h =>
    hne (by simpa using (Ideal.mem_torsionOf_iff (tr hmk x) (1 : A)).mp (h ▸ Submodule.mem_top))
  obtain ⟨⟨p₀, hp₀⟩⟩ := Ideal.nonempty_minimalPrimes htop
  have hp₀prime : p₀.IsPrime := hp₀.1.1
  have hp₀T : (⟨p₀, hp₀prime⟩ : PrimeSpectrum A) ∈ T :=
    (mem_sectionsWithSupportIn_iff A T (M m) _).mp hy hp₀.1.2
  have hp₀S : p₀ ∈ S :=
    ⟨mem_associatedPrimes_of_mem_minimalPrimes_torsionOf _ hp₀, fun _ => hp₀T⟩
  obtain ⟨t, ht, hty⟩ := hS x hx p₀ hp₀S
  exact ht (hp₀.1.2 ((Ideal.mem_torsionOf_iff _ t).mpr hty))

end Stacks.LocalCohomology

end
