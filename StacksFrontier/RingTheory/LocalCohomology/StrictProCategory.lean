module

public import Mathlib.CategoryTheory.Category.Preorder
public import Mathlib.CategoryTheory.PathCategory.Basic
public import Mathlib.CategoryTheory.Quotient
public import StacksCore.Tactic.StacksAttribute

/-!
# The strict pro-category

Given a category `C`, the *strict* pro-category of `C` has inverse sequences `(Xₙ)` indexed by
`ℕᵒᵖ` as objects, and as morphisms `(Xₙ) ⟶ (Yₙ)` the tuples `(c, φₙ)` consisting of a uniform
shift `c ≥ 0` and maps `φₙ : X_{n+c} ⟶ Yₙ` compatible with the transition maps, taken up to the
equivalence generated by increasing `c`. It is strict in that the shift is uniform in `n`, which
is what distinguishes it from the ordinary pro-category and makes the question of Stacks 0GA5 —
whether the four inverse systems computing local cohomology are *strictly* pro-isomorphic —
different from the question of pro-isomorphism.

## Main definitions

* `Stacks.LocalCohomology.StrictProHomRep` — a representative of a strict pro-morphism: a shift
  together with a compatible family of component maps.
* `Stacks.LocalCohomology.StrictProHomRep.Equivalent` — eventual agreement of two
  representatives after passing to a common shift.
* `Stacks.LocalCohomology.StrictProCategory` — the strict pro-category of `C`.

## Implementation notes

An inverse sequence is a functor `ℕᵒᵖ ⥤ C`, and the shift by `c` is reindexing along the cofinal
map `n ↦ n + c`, so a representative is a natural transformation out of the shifted sequence.
Composition of representatives adds the shifts, which is associative only up to the
`eqToHom` of `Nat.add_assoc`; the category is therefore presented by generators and relations,
the relations identifying formal composition with composition of representatives, formal
identities with the identity representatives, and eventually-equal representatives with one
another.

## References

* [Stacks Project, Tag 0GA5](https://stacks.math.columbia.edu/tag/0GA5)
-/

@[expose] public section

open CategoryTheory

namespace Stacks.LocalCohomology

universe v u

variable {C : Type u} [Category.{v} C]

/-- Reindex an inverse sequence by the cofinal map `n ↦ n + c`. -/
@[implicit_reducible]
public def inverseSequenceShift (c : ℕ) : CategoryTheory.Functor ℕᵒᵖ ℕᵒᵖ where
  obj n := Opposite.op (n.unop + c)
  map f := (homOfLE (Nat.add_le_add_right (leOfHom f.unop) c)).op
  map_id _ := by apply Subsingleton.elim
  map_comp _ _ := by apply Subsingleton.elim

/-- Reindex an inverse sequence by the cofinal map `n ↦ n + c`. -/
@[implicit_reducible]
public def shiftedInverseSequence (X : CategoryTheory.Functor ℕᵒᵖ C) (c : ℕ) :
    CategoryTheory.Functor ℕᵒᵖ C := inverseSequenceShift c ⋙ X

/-- A representative of a strict pro-morphism from `X` to `Y`: a uniform shift and a compatible
family of maps `X_(n+c) ⟶ Y_n`. -/
public structure StrictProHomRep (X Y : CategoryTheory.Functor ℕᵒᵖ C) where
  /-- The uniform shift. -/
  shift : ℕ
  /-- The compatible family of component maps. -/
  hom : shiftedInverseSequence X shift ⟶ Y

/-- Transition from a larger shift to a smaller shift. -/
public def shiftedInverseSequenceTransition (X : CategoryTheory.Functor ℕᵒᵖ C)
    {c d : ℕ} (h : c ≤ d) : shiftedInverseSequence X d ⟶ shiftedInverseSequence X c where
  app n := X.map (opHomOfLE (Nat.add_le_add_left h n.unop))
  naturality _ _ f := by
    dsimp [shiftedInverseSequence, inverseSequenceShift]
    rw [← X.map_comp, ← X.map_comp]
    congr 1

/-- Two representatives give the same strict pro-morphism when, at a common larger shift, their
component maps agree from some point onward. -/
public def StrictProHomRep.Equivalent {X Y : CategoryTheory.Functor ℕᵒᵖ C}
    (f g : StrictProHomRep X Y) : Prop :=
  ∃ (d N : ℕ) (hf : f.shift ≤ d) (hg : g.shift ≤ d), ∀ n ≥ N,
    (shiftedInverseSequenceTransition X hf).app (Opposite.op n) ≫ f.hom.app (Opposite.op n) =
    (shiftedInverseSequenceTransition X hg).app (Opposite.op n) ≫ g.hom.app (Opposite.op n)

/-- Identity representative. -/
public def StrictProHomRep.id (X : CategoryTheory.Functor ℕᵒᵖ C) : StrictProHomRep X X where
  shift := 0
  hom :=
    { app := fun _ ↦ 𝟙 _
      naturality := by
        intro i j f
        simp only [Category.comp_id, Category.id_comp]
        dsimp [shiftedInverseSequence, inverseSequenceShift]
        congr 1 }

/-- Composition of representatives; its shift is the sum of their shifts. -/
public def StrictProHomRep.comp {X Y Z : CategoryTheory.Functor ℕᵒᵖ C}
    (f : StrictProHomRep X Y) (g : StrictProHomRep Y Z) : StrictProHomRep X Z where
  shift := g.shift + f.shift
  hom :=
    { app := fun n ↦
        X.map (eqToHom (congrArg Opposite.op (Nat.add_assoc n.unop g.shift f.shift).symm)) ≫
          f.hom.app (Opposite.op (n.unop + g.shift)) ≫ g.hom.app n
      naturality := by
        intro i j a
        dsimp [shiftedInverseSequence, inverseSequenceShift]
        have h : X.map (homOfLE (Nat.add_le_add_right (leOfHom a.unop) (g.shift + f.shift))).op ≫
            X.map (eqToHom (congrArg Opposite.op (Nat.add_assoc j.unop g.shift f.shift).symm)) =
            X.map (eqToHom (congrArg Opposite.op (Nat.add_assoc i.unop g.shift f.shift).symm)) ≫
            X.map (homOfLE (Nat.add_le_add_right
              (leOfHom ((inverseSequenceShift g.shift).map a).unop) f.shift)).op := by
          rw [← X.map_comp, ← X.map_comp]
          congr 1
        have hf := f.hom.naturality ((inverseSequenceShift g.shift).map a)
        have hg := g.hom.naturality a
        dsimp [shiftedInverseSequence, inverseSequenceShift] at hf hg
        have hf' := congrArg (fun k ↦ k ≫ g.hom.app j) hf
        simp only [Category.assoc] at hf'
        rw [← Category.assoc, h]
        simp only [Category.assoc, hf', hg] }

/-- The quiver of inverse sequences whose arrows are representatives of strict pro-morphisms. -/
public abbrev strictProQuiver (C : Type u) [Category.{v} C] := CategoryTheory.Functor ℕᵒᵖ C

/-- The arrows of `strictProQuiver C` are the representatives `StrictProHomRep X Y`. -/
public instance : Quiver.{v} (strictProQuiver C) where
  Hom X Y := StrictProHomRep X Y

/-- Relations presenting the strict pro-category: identities and composites are represented by
the corresponding shifted systems, and eventually equal representatives are identified. -/
public inductive strictProRelations : HomRel (CategoryTheory.Paths (strictProQuiver C))
  | id (X : strictProQuiver C) : strictProRelations
      (𝟙 (show CategoryTheory.Paths (strictProQuiver C) from X))
      ((CategoryTheory.Paths.of _).map (StrictProHomRep.id X))
  | comp {X Y Z : strictProQuiver C} (f : X ⟶ Y) (g : Y ⟶ Z) : strictProRelations
      ((CategoryTheory.Paths.of _).map f ≫ (CategoryTheory.Paths.of _).map g)
      ((CategoryTheory.Paths.of _).map (StrictProHomRep.comp f g))
  | equivalent {X Y : strictProQuiver C} (f g : X ⟶ Y) (h : f.Equivalent g) :
      strictProRelations ((CategoryTheory.Paths.of _).map f) ((CategoryTheory.Paths.of _).map g)

/-- The strict pro-category of `C`. Its objects are inverse sequences in `C`; its morphisms are
uniformly shifted compatible maps modulo eventual agreement after passing to a common shift. -/
-- NO `@[stacks 0GA5]` ATTRIBUTE HERE, DELIBERATELY. Tag 0GA5 is covered by
-- 10 declarations and this library has 1. Coverage is keyed on the
-- BARE four-character tag and treats the quoted suffix as free text, so an attribute here
-- would mark 0GA5 formalized on 1 of 10 of its covering set. The attribute belongs here
-- once the rest are formalized.
public abbrev StrictProCategory (C : Type u) [Category.{v} C] :=
  CategoryTheory.Quotient (strictProRelations (C := C))

end Stacks.LocalCohomology

end
