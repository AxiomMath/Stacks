module

public import StacksFrontier.Algebra.DirectSum.GradedQuotient
public import StacksFrontier.Algebra.Module.IPowerTorsion
public import StacksFrontier.RingTheory.Cech.GradedSubcomplex
public import StacksFrontier.RingTheory.LocalCohomology.SectionsIso.Reduction
public import StacksFrontier.RingTheory.LocalCohomology.SectionsIso.Restriction

/-!
# The grading of the sections of a graded module on the complement of a homogeneous locus

Let `A = ⨁_{i ≥ 0} 𝒜 i` be a graded ring, let `𝔞 ⊆ A` be an ideal generated by finitely many
homogeneous elements `f₀, …, f_{r-1}`, let `U = Spec(A) ∖ V(𝔞)` and let `M` be a `ℤ`-graded
`A`-module. This file puts a `ℤ`-grading on `Γ(U, M̃|U)` for which the restriction map
`M → Γ(U, M̃|U)` preserves degrees.

The grading is read off the Čech model. By
`Stacks.LocalCohomology.kerCechDOneEquivComplementGlobalSections` the sections on `U` are the
degree-one cocycles of the extended alternating Čech complex of `f`, whose terms are localizations
of `M` at the homogeneous products `∏_{i ∈ s} f i` and are therefore graded
(`Stacks.GradedLocalization.gradedPiece`); the differential preserves the degrees
(`Cech.cechD_mem_gradedCechTerm`), so the cocycles are a graded submodule of the degree-one term,
and the comparison transports that grading to the sections.

## Main definitions

* `Stacks.LocalCohomology.complementPiece` — the degree-`e` part of `Γ(U, M̃|U)`.
* `Stacks.LocalCohomology.complementRes` — the restriction map `M → Γ(U, M̃|U)`, `m ↦ m/1`.

## Main results

* `Stacks.LocalCohomology.isInternal_complementPiece` — **`Γ(U, M̃|U)` is the direct sum of its
  graded pieces**, so `complementDecomposition` is a `DirectSum.Decomposition`.
* `Stacks.LocalCohomology.smul_mem_complementPiece` — the grading is compatible with the grading
  of `A`.
* `Stacks.LocalCohomology.complementRes_mem_complementPiece` — **the restriction map preserves
  degrees**.
* `Stacks.LocalCohomology.eq_zero_of_isIPowerTorsion_complementGlobalSections` — the sections on
  `U` have no `𝔞`-power torsion.
* `Stacks.GradedLocalization.exists_fin_homogeneous_span` — a finitely generated homogeneous ideal
  is spanned by a finite family of homogeneous elements, which is the input `f` above.
* `Stacks.LocalCohomology.mem_complementPiece_of_comp_complementRes` — **a map of sections
  commuting with the restriction maps preserves degrees**, which is how the transition maps of an
  inverse system of such sections become degree-preserving.

## Implementation notes

The grading is defined by pulling the degree-`e` part of the Čech term back along the injective
map `complementSectionsCech`, which reads a section as a degree-one cochain; membership is then
by definition homogeneity of every Čech coordinate. The two halves of the decomposition are
inherited from `Cech.exists_sum_mem_gradedCechTerm` and
`Cech.eq_zero_of_sum_mem_gradedCechTerm_eq_zero`, the only extra point being that the homogeneous
parts of a cocycle are again cocycles, which is independence of the degrees in the degree-two
term.

Degrees of the ring are naturals and degrees of the module are integers, as in
`StacksFrontier.RingTheory.HomogeneousLocalization.GradedLocalizedModule`, whose `VAdd ℕ ℤ` instance
is activated here rather than declared again.

## References

* [Stacks Project, Tag 0EL4](https://stacks.math.columbia.edu/tag/0EL4)
* [Stacks Project, Tag 0DWR](https://stacks.math.columbia.edu/tag/0DWR)
-/

@[expose] public noncomputable section

universe u v w t

open CategoryTheory Opposite AlgebraicGeometry

attribute [local instance] instVAddNatIntGradedLocalizedModule

namespace Stacks.GradedLocalization

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type t}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨]

/-- **A homogeneous scalar shifts the degree of a fraction.** Multiplying a degree-`e` element of
`M_g` by a homogeneous element of degree `i` gives a degree-`i + e` element. -/
public theorem smul_mem_gradedPiece_add {g : S} {d : ℕ} (hg : g ∈ 𝒜 d) {i : ℕ} {e : ℤ} {a : S}
    (ha : a ∈ 𝒜 i) {y : LocalizedModule.Away (R := S) g M} (hy : y ∈ gradedPiece 𝒜 𝒨 g e) :
    a • y ∈ gradedPiece 𝒜 𝒨 g ((i : ℤ) + e) := by
  obtain ⟨n, x, hx, rfl⟩ := (mem_gradedPiece_iff 𝒜 𝒨 hg e y).1 hy
  rw [LocalizedModule.smul'_mk]
  refine mk_mem_gradedPiece 𝒜 𝒨 hg ?_
  have h := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) ha hx
  have hdeg : (i : ℕ) +ᵥ (e + n • (d : ℤ)) = ((i : ℤ) + e) + n • (d : ℤ) := by
    show ((i : ℕ) : ℤ) + (e + n • (d : ℤ)) = ((i : ℤ) + e) + n • (d : ℤ)
    ring
  rwa [hdeg] at h

end Stacks.GradedLocalization

/-! ### A finite homogeneous generating family of a homogeneous ideal -/

namespace Stacks.GradedLocalization

/-- **A finitely generated homogeneous ideal of a graded ring is spanned by a finite family of
homogeneous elements**, presented as a tuple together with its degrees. This is the shape the Čech
model of the sections on `U = Spec(A) ∖ V(𝔞)` needs: a family `f : Fin r → A` spanning the ideal,
each `f i` homogeneous. -/
public theorem exists_fin_homogeneous_span {A : Type u} [CommRing A] {σ : Type w}
    [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜]
    {J : Ideal A} (hJ : J.IsHomogeneous 𝒜) (hfg : J.FG) :
    ∃ (r : ℕ) (f : Fin r → A) (c : Fin r → ℕ), (∀ i, f i ∈ 𝒜 (c i)) ∧
      Ideal.span (Set.range f) = J := by
  classical
  obtain ⟨s, hs⟩ := hfg
  set P : Finset (ℕ × A) := s.biUnion fun x =>
    (DirectSum.decompose 𝒜 x).support.image fun i => (i, ((DirectSum.decompose 𝒜 x i : A)))
    with hP
  have hmem : ∀ p ∈ P, p.2 ∈ 𝒜 p.1 := by
    intro p hp
    simp only [hP, Finset.mem_biUnion, Finset.mem_image] at hp
    obtain ⟨x, -, i, -, rfl⟩ := hp
    exact (DirectSum.decompose 𝒜 x i).2
  have hspan : Ideal.span (Prod.snd '' (P : Set (ℕ × A))) = J := by
    refine le_antisymm (Ideal.span_le.2 ?_) ?_
    · rintro y ⟨p, hp, rfl⟩
      simp only [Finset.mem_coe, hP, Finset.mem_biUnion, Finset.mem_image] at hp
      obtain ⟨x, hxs, i, -, rfl⟩ := hp
      exact hJ i (hs ▸ Ideal.subset_span hxs)
    · rw [← hs, Ideal.span_le]
      intro x hx
      rw [← DirectSum.sum_support_decompose 𝒜 x]
      refine Submodule.sum_mem _ fun i hi => Ideal.subset_span ⟨(i, _), ?_, rfl⟩
      simp only [Finset.mem_coe, hP, Finset.mem_biUnion]
      exact ⟨x, hx, Finset.mem_image.mpr ⟨i, hi, rfl⟩⟩
  refine ⟨P.card, fun i => (P.equivFin.symm i).1.2, fun i => (P.equivFin.symm i).1.1,
    fun i => hmem _ (P.equivFin.symm i).2, ?_⟩
  rw [← hspan]
  refine congrArg Ideal.span (Set.ext fun y => ⟨?_, ?_⟩)
  · rintro ⟨i, rfl⟩
    exact ⟨(P.equivFin.symm i).1, (P.equivFin.symm i).2, rfl⟩
  · rintro ⟨p, hp, rfl⟩
    exact ⟨P.equivFin ⟨p, hp⟩, by simp⟩

end Stacks.GradedLocalization

namespace Cech

variable {R : Type u} [CommRing R] {r : ℕ} {σ : Type w} {τ : Type t}
  [SetLike σ R] [AddSubgroupClass σ R] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {M : Type v} [AddCommGroup M] [Module R M]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨]
  (f : Fin r → R)

/-- **A homogeneous scalar shifts the degree of a cochain.** -/
public theorem smul_mem_gradedCechTerm {c : Fin r → ℕ} (hc : ∀ i, f i ∈ 𝒜 (c i)) {i : ℕ} {e : ℤ}
    {a : R} (ha : a ∈ 𝒜 i) {p : ℕ} {z : cechTerm f M p} (hz : z ∈ gradedCechTerm 𝒜 𝒨 f e p) :
    a • z ∈ gradedCechTerm 𝒜 𝒨 f ((i : ℤ) + e) p := by
  refine mem_gradedCechTerm.2 fun s => ?_
  rw [DFinsupp.smul_apply]
  exact Stacks.GradedLocalization.smul_mem_gradedPiece_add 𝒜 𝒨
    (SetLike.prod_mem_graded 𝒜 c f fun i _ => hc i) ha (mem_gradedCechTerm.1 hz s)

end Cech

namespace Stacks.LocalCohomology

/-! ### Reading a section as a Čech cochain -/

section Cochain

variable {A : Type u} [CommRing A] (I : Ideal A) {M : ModuleCat.{max u v} A} {r : ℕ} (f : Fin r → A)

/-- A section of `M̃` on `U = Spec(A) ∖ V(𝔞)`, read as a degree-one cochain of the extended
alternating Čech complex: the inverse of the comparison with the cocycles, followed by the
inclusion of the cocycles into the term. -/
public def complementSectionsCech (hIf : Ideal.span (Set.range f) = I) :
    complementGlobalSections A I (complementTilde A I M) →ₗ[A] Cech.cechTerm f (M : Type _) 1 :=
  (LinearMap.ker (Cech.cechD f (M : Type _) 1)).subtype.comp
    (kerCechDOneEquivComplementGlobalSections I M f hIf).symm.toLinearMap

public theorem injective_complementSectionsCech (hIf : Ideal.span (Set.range f) = I) :
    Function.Injective (complementSectionsCech I f hIf (M := M)) :=
  Subtype.coe_injective.comp
    (kerCechDOneEquivComplementGlobalSections I M f hIf).symm.injective

public theorem complementSectionsCech_mem_ker (hIf : Ideal.span (Set.range f) = I)
    (s : complementGlobalSections A I (complementTilde A I M)) :
    complementSectionsCech I f hIf s ∈ LinearMap.ker (Cech.cechD f (M : Type _) 1) :=
  ((kerCechDOneEquivComplementGlobalSections I M f hIf).symm s).2

/-- Every degree-one cocycle is the cochain of a section. -/
public theorem exists_complementSectionsCech_eq (hIf : Ideal.span (Set.range f) = I)
    {z : Cech.cechTerm f (M : Type _) 1} (hz : z ∈ LinearMap.ker (Cech.cechD f (M : Type _) 1)) :
    ∃ s : complementGlobalSections A I (complementTilde A I M),
      complementSectionsCech I f hIf s = z :=
  ⟨kerCechDOneEquivComplementGlobalSections I M f hIf ⟨z, hz⟩,
    congrArg Subtype.val
      ((kerCechDOneEquivComplementGlobalSections I M f hIf).symm_apply_apply ⟨z, hz⟩)⟩

end Cochain

/-! ### The grading of the sections -/

section Graded

variable {A : Type u} [CommRing A] {σ : Type w} [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {M : ModuleCat.{max u v} A} {τ : Type t}
  [SetLike τ (M : Type (max u v))] [AddSubgroupClass τ (M : Type (max u v))]
  (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨] [SetLike.GradedSMul 𝒜 𝒨]
  {r : ℕ} (f : Fin r → A) (I : Ideal A) (hIf : Ideal.span (Set.range f) = I)

/-- **The degree-`e` part of `Γ(U, M̃|U)`**: the sections all of whose Čech coordinates are
homogeneous of degree `e`. -/
public def complementPiece (e : ℤ) :
    AddSubgroup (complementGlobalSections A I (complementTilde A I M)) :=
  (Cech.gradedCechTerm 𝒜 𝒨 f e 1).comap
    (complementSectionsCech I f hIf (M := M)).toAddMonoidHom

public theorem mem_complementPiece {e : ℤ}
    {s : complementGlobalSections A I (complementTilde A I M)} :
    s ∈ complementPiece 𝒜 𝒨 f I hIf e ↔
      complementSectionsCech I f hIf s ∈ Cech.gradedCechTerm 𝒜 𝒨 f e 1 :=
  Iff.rfl

variable {c : Fin r → ℕ}

/-- **Independence of the degrees.** A vanishing finite sum of homogeneous sections of distinct
degrees has vanishing summands. -/
public theorem eq_zero_of_sum_mem_complementPiece_eq_zero (hc : ∀ i, f i ∈ 𝒜 (c i))
    (t : Finset ℤ)
    (y : ℤ → complementGlobalSections A I (complementTilde A I M))
    (hy : ∀ e ∈ t, y e ∈ complementPiece 𝒜 𝒨 f I hIf e)
    (hsum : (∑ e ∈ t, y e) = 0) {e₀ : ℤ} (he₀ : e₀ ∈ t) : y e₀ = 0 := by
  refine injective_complementSectionsCech I f hIf ?_
  rw [map_zero]
  refine Cech.eq_zero_of_sum_mem_gradedCechTerm_eq_zero 𝒜 𝒨 f hc 1 t
    (fun e => complementSectionsCech I f hIf (y e)) (fun e he => hy e he) ?_ he₀
  rw [← map_sum, hsum, map_zero]

/-- **Every section is a finite sum of homogeneous ones.** The homogeneous parts of the Čech
cochain of a section are again cocycles, because the differential preserves degrees and the
degrees are independent in the degree-two term. -/
public theorem exists_sum_mem_complementPiece (hc : ∀ i, f i ∈ 𝒜 (c i))
    (s : complementGlobalSections A I (complementTilde A I M)) :
    ∃ (t : Finset ℤ) (y : ℤ → complementGlobalSections A I (complementTilde A I M)),
      (∀ e, y e ∈ complementPiece 𝒜 𝒨 f I hIf e) ∧ (∀ e ∉ t, y e = 0) ∧
        (∑ e ∈ t, y e) = s := by
  classical
  obtain ⟨t, w, hw, hwzero, hwsum⟩ :=
    Cech.exists_sum_mem_gradedCechTerm 𝒜 𝒨 f hc 1 (complementSectionsCech I f hIf s)
  have hker : ∀ e, w e ∈ LinearMap.ker (Cech.cechD f (M : Type _) 1) := by
    intro e
    by_cases he : e ∈ t
    · refine Cech.eq_zero_of_sum_mem_gradedCechTerm_eq_zero 𝒜 𝒨 f hc 2 t
        (fun e => Cech.cechD f (M : Type _) 1 (w e))
        (fun e _ => Cech.cechD_mem_gradedCechTerm 𝒜 𝒨 f hc e 1 (hw e)) ?_ he
      rw [← map_sum, hwsum]
      exact complementSectionsCech_mem_ker I f hIf s
    · rw [hwzero e he]
      exact zero_mem _
  choose y hy using fun e =>
    exists_complementSectionsCech_eq I f hIf (M := M) (hker e)
  refine ⟨t, y, fun e => ?_, fun e he => ?_, ?_⟩
  · rw [mem_complementPiece, hy e]
    exact hw e
  · refine injective_complementSectionsCech I f hIf ?_
    rw [hy e, map_zero, hwzero e he]
  · refine injective_complementSectionsCech I f hIf ?_
    rw [map_sum, ← hwsum]
    exact Finset.sum_congr rfl fun e _ => hy e

/-- **`Γ(U, M̃|U)` is the direct sum of its graded pieces.** -/
public theorem isInternal_complementPiece (hc : ∀ i, f i ∈ 𝒜 (c i)) :
    DirectSum.IsInternal (complementPiece 𝒜 𝒨 f I hIf (M := M)) := by
  classical
  have hof : ∀ (e : ℤ) (x : ↥(complementPiece 𝒜 𝒨 f I hIf (M := M) e)),
      DirectSum.coeAddMonoidHom (complementPiece 𝒜 𝒨 f I hIf (M := M)) (DirectSum.of _ e x) = x :=
    DirectSum.coeAddMonoidHom_of _
  have hval : ∀ ζ : DirectSum ℤ fun e => ↥(complementPiece 𝒜 𝒨 f I hIf (M := M) e),
      (DirectSum.coeAddMonoidHom (complementPiece 𝒜 𝒨 f I hIf (M := M))) ζ =
        ∑ e ∈ DFinsupp.support ζ,
          ((ζ e : complementGlobalSections A I (complementTilde A I M))) := fun ζ => by
    conv_lhs => rw [← DirectSum.sum_support_of ζ]
    simp [hof]
  refine ⟨(injective_iff_map_eq_zero _).2 fun ζ hζ => DFinsupp.ext fun e => ?_, fun s => ?_⟩
  · by_cases he : e ∈ DFinsupp.support ζ
    · refine Subtype.ext (eq_zero_of_sum_mem_complementPiece_eq_zero 𝒜 𝒨 f I hIf hc
        (DFinsupp.support ζ)
        (fun e => ((ζ e : complementGlobalSections A I (complementTilde A I M))))
        (fun e _ => (ζ e).2) ?_ he)
      rwa [← hval ζ]
    · exact DFinsupp.notMem_support_iff.1 he
  · obtain ⟨t, y, hy, -, hsum⟩ := exists_sum_mem_complementPiece 𝒜 𝒨 f I hIf hc s
    refine ⟨∑ e ∈ t, DirectSum.of _ e (⟨y e, hy e⟩ :
      ↥(complementPiece 𝒜 𝒨 f I hIf (M := M) e)), ?_⟩
    simp [hof, ← hsum]

/-- The grading of `Γ(U, M̃|U)`, as a `DirectSum.Decomposition`. -/
@[instance_reducible] public def complementDecomposition (hc : ∀ i, f i ∈ 𝒜 (c i)) :
    DirectSum.Decomposition (complementPiece 𝒜 𝒨 f I hIf (M := M)) :=
  (isInternal_complementPiece 𝒜 𝒨 f I hIf hc).chooseDecomposition

/-- **The grading of `Γ(U, M̃|U)` is compatible with the grading of `A`.** -/
public theorem smul_mem_complementPiece (hc : ∀ i, f i ∈ 𝒜 (c i))
    {i : ℕ} {e : ℤ} {a : A} (ha : a ∈ 𝒜 i)
    {s : complementGlobalSections A I (complementTilde A I M)}
    (hs : s ∈ complementPiece 𝒜 𝒨 f I hIf e) :
    a • s ∈ complementPiece 𝒜 𝒨 f I hIf ((i : ℤ) + e) := by
  rw [mem_complementPiece, map_smul]
  exact Cech.smul_mem_gradedCechTerm 𝒜 𝒨 f hc ha hs

end Graded

/-! ### The restriction map preserves degrees -/

section Res

variable {A : Type u} [CommRing A] {M : ModuleCat.{max u v} A} {r : ℕ} (f : Fin r → A) (I : Ideal A)
  (hIf : Ideal.span (Set.range f) = I)

/-- **The restriction map `M → Γ(U, M̃|U)`**, sending `m` to the section `m/1`. -/
public def complementRes :
    (M : Type (max u v)) →ₗ[A] complementGlobalSections A I (complementTilde A I M) :=
  (complementGlobalSectionsEquiv I M).toLinearMap.comp
    (moduleSectionsMk M ((complementZeroLocus A I).ι ''ᵁ ⊤))

/-- The degree-one Čech cochain of the section `m/1` is the degree-zero differential applied to
`m`, whose coordinates are the constant fractions `m/1`. -/
public theorem complementSectionsCech_complementRes (m : (M : Type (max u v))) :
    complementSectionsCech I f hIf (complementRes I m) =
      Cech.cechD f (M : Type _) 0 ((cechTermZeroEquiv f M).symm m) := by
  have hmem : Cech.cechD f (M : Type _) 0 ((cechTermZeroEquiv f M).symm m) ∈
      LinearMap.ker (Cech.cechD f (M : Type _) 1) := by
    rw [LinearMap.mem_ker, ← LinearMap.comp_apply, Cech.cechD_comp_cechD]
    rfl
  have h := kerCechDOneEquivComplementGlobalSections_moduleSectionsMk f I M hIf m
    ⟨_, hmem⟩ (cechTermOneEquiv_cechD_zero f M m)
  have hx := congrArg (kerCechDOneEquivComplementGlobalSections I M f hIf).symm h
  rw [LinearEquiv.symm_apply_apply] at hx
  exact (congrArg Subtype.val hx).symm

/-- The `i`-th Čech coordinate of the section `m/1` is the constant fraction `m/1`. -/
public theorem complementSectionsCech_complementRes_apply (m : (M : Type (max u v)))
    (i : Fin r) (h1 : (({i} : Finset (Fin r))).card = 1) :
    complementSectionsCech I f hIf (complementRes I m) ⟨{i}, h1⟩ =
      LocalizedModule.mkLinearMap (Cech.cechSub f {i}) (M : Type _) m := by
  rw [complementSectionsCech_complementRes]
  exact cechTermOneEquiv_cechD_zero f M m i

end Res

section ResGraded

variable {A : Type u} [CommRing A] {σ : Type w} [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {M : ModuleCat.{max u v} A} {τ : Type t}
  [SetLike τ (M : Type (max u v))] [AddSubgroupClass τ (M : Type (max u v))]
  (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨] [SetLike.GradedSMul 𝒜 𝒨]
  {r : ℕ} (f : Fin r → A) (I : Ideal A) (hIf : Ideal.span (Set.range f) = I)
  {c : Fin r → ℕ}

/-- **The restriction map preserves degrees.** A homogeneous element of degree `e` of `M`
restricts to a section of `Γ(U, M̃|U)` of degree `e`, since its Čech coordinates are the constant
fractions `m/1`. -/
public theorem complementRes_mem_complementPiece (hc : ∀ i, f i ∈ 𝒜 (c i)) {e : ℤ}
    {m : (M : Type (max u v))} (hm : m ∈ 𝒨 e) :
    complementRes I m ∈ complementPiece 𝒜 𝒨 f I hIf e := by
  show complementSectionsCech I f hIf (complementRes I m) ∈ Cech.gradedCechTerm 𝒜 𝒨 f e 1
  refine Cech.mem_gradedCechTerm.2 fun s => ?_
  obtain ⟨st, hst⟩ := s
  obtain ⟨i, rfl⟩ := Finset.card_eq_one.1 hst
  rw [complementSectionsCech_complementRes_apply f I hIf m i hst]
  have hden : (1 : Submonoid.powers (∏ j ∈ ({i} : Finset (Fin r)), f j)) =
      ⟨(∏ j ∈ ({i} : Finset (Fin r)), f j) ^ 0, ⟨0, rfl⟩⟩ := Subtype.ext (pow_zero _).symm
  show LocalizedModule.mk m (1 : Submonoid.powers (∏ j ∈ ({i} : Finset (Fin r)), f j)) ∈ _
  rw [hden]
  refine Stacks.GradedLocalization.mk_mem_gradedPiece 𝒜 𝒨
    (SetLike.prod_mem_graded 𝒜 c f fun j _ => hc j) ?_
  simpa using hm

end ResGraded

/-! ### The sections on `U` have no torsion -/

/-- A fraction annihilated by a power of the inverted element vanishes. -/
public theorem eq_zero_of_pow_smul_eq_zero_away {S : Type u} [CommRing S] {N : Type v}
    [AddCommGroup N] [Module S N] {g : S} (k : ℕ)
    {x : LocalizedModule.Away (R := S) g N} (h : (g ^ k) • x = 0) : x = 0 := by
  refine IsLocalizedModule.smul_injective (LocalizedModule.mkLinearMap (Submonoid.powers g) N)
    (⟨g ^ k, ⟨k, rfl⟩⟩ : Submonoid.powers g) ?_
  simpa [Submonoid.smul_def] using h

section Torsion

variable {A : Type u} [CommRing A] {M : ModuleCat.{max u v} A} {r : ℕ} (f : Fin r → A)
  (I : Ideal A)

/-- **The sections on `U` have no `𝔞`-power torsion.** A section annihilated by a power of `𝔞`
vanishes: its Čech coordinate at `{i}` is annihilated by a power of `f i`, which is invertible
there. -/
public theorem eq_zero_of_pow_smul_eq_zero_complementGlobalSections
    (hIf : Ideal.span (Set.range f) = I)
    {s : complementGlobalSections A I (complementTilde A I M)} {k : ℕ}
    (h : ∀ i : Fin r, (f i ^ k) • s = 0) : s = 0 := by
  classical
  refine injective_complementSectionsCech I f hIf ?_
  rw [map_zero]
  refine DFinsupp.ext fun u => ?_
  obtain ⟨ut, hut⟩ := u
  obtain ⟨i, rfl⟩ := Finset.card_eq_one.1 hut
  have hz : (∏ j ∈ ({i} : Finset (Fin r)), f j) ^ k •
      complementSectionsCech I f hIf (M := M) s ⟨{i}, hut⟩ = 0 := by
    have h1 : (f i ^ k) • complementSectionsCech I f hIf (M := M) s = 0 := by
      rw [← map_smul, h i, map_zero]
    have h2 := congrArg (fun z : Cech.cechTerm f (M : Type _) 1 =>
      z (⟨{i}, hut⟩ : {t : Finset (Fin r) // t.card = 1})) h1
    simp only [DFinsupp.smul_apply, DFinsupp.zero_apply] at h2
    rw [Finset.prod_singleton]
    exact h2
  rw [DFinsupp.zero_apply]
  exact eq_zero_of_pow_smul_eq_zero_away k hz

end Torsion

/-! ### Degree preservation of a map of systems of sections -/

section Transition

variable {A : Type u} [CommRing A] {σ : Type w} [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]
  {P Q : ModuleCat.{max u v} A} {τP : Type t} {τQ : Type t}
  [SetLike τP (P : Type (max u v))] [AddSubgroupClass τP (P : Type (max u v))]
  (𝒩 : ℤ → τP) [DirectSum.Decomposition 𝒩] [SetLike.GradedSMul 𝒜 𝒩]
  [SetLike τQ (Q : Type (max u v))] [AddSubgroupClass τQ (Q : Type (max u v))]
  (𝒬 : ℤ → τQ) [DirectSum.Decomposition 𝒬] [SetLike.GradedSMul 𝒜 𝒬]
  {r : ℕ} (f : Fin r → A) (I : Ideal A) (hIf : Ideal.span (Set.range f) = I)
  {c : Fin r → ℕ}

/-- **A map of sections commuting with the restriction maps preserves degrees.** Let `P → Q` be a
degree-preserving map of graded modules and let `t : Γ(U, P̃|U) → Γ(U, Q̃|U)` commute with the
restriction maps `m ↦ m/1`. Then `t` preserves the grading of the sections.

The restriction map does not hit every section, only every section up to `𝔞`-power torsion; so a
homogeneous `s` is only known to satisfy `a • s = m/1` for `a` in a power of `𝔞`, and the degree of
`a • t s` is then read off the degree of `m`. Since the sections on `U` have no `𝔞`-power torsion,
that is enough to pin the degree of `t s` itself
(`DirectSum.mem_graded_of_smul_mem_graded`). -/
public theorem mem_complementPiece_of_comp_complementRes
    (hc : ∀ i, f i ∈ 𝒜 (c i)) (hIhom : I.IsHomogeneous 𝒜)
    (φ : (P : Type (max u v)) →ₗ[A] (Q : Type (max u v)))
    (hφ : ∀ (d : ℤ) (x : (P : Type (max u v))), x ∈ 𝒩 d → φ x ∈ 𝒬 d)
    (hcoker : IsIPowerTorsion A
      (complementGlobalSections A I (complementTilde A I P) ⧸
        LinearMap.range (complementRes (M := P) I)) I)
    (t : complementGlobalSections A I (complementTilde A I P) →ₗ[A]
      complementGlobalSections A I (complementTilde A I Q))
    (ht : ∀ m : (P : Type (max u v)), t (complementRes I m) = complementRes I (φ m))
    {d : ℤ} {s : complementGlobalSections A I (complementTilde A I P)}
    (hs : s ∈ complementPiece 𝒜 𝒩 f I hIf d) :
    t s ∈ complementPiece 𝒜 𝒬 f I hIf d := by
  classical
  let iP : DirectSum.Decomposition (complementPiece 𝒜 𝒩 f I hIf (M := P)) :=
    complementDecomposition 𝒜 𝒩 f I hIf hc
  let iQ : DirectSum.Decomposition (complementPiece 𝒜 𝒬 f I hIf (M := Q)) :=
    complementDecomposition 𝒜 𝒬 f I hIf hc
  obtain ⟨k, -, hk⟩ := hcoker (Submodule.Quotient.mk s)
  refine DirectSum.mem_graded_of_smul_mem_graded 𝒜 (complementPiece 𝒜 𝒬 f I hIf (M := Q))
    (fun i e a y ha hy => smul_mem_complementPiece 𝒜 𝒬 f I hIf hc ha hy)
    (J := I) (k := k) (Ideal.IsHomogeneous.pow 𝒜 hIhom k) (fun z hz => ?_) (fun i a ha haI => ?_)
  · refine eq_zero_of_pow_smul_eq_zero_complementGlobalSections f I hIf (k := k) fun j => ?_
    refine hz _ (Ideal.pow_mem_pow ?_ k)
    rw [← hIf]
    exact Ideal.subset_span ⟨j, rfl⟩
  · -- `a • s` comes from `P`, and its source may be taken homogeneous of degree `i + d`
    obtain ⟨m, hm⟩ : ∃ m : (P : Type (max u v)), complementRes I m = a • s := by
      have h0 : a • Submodule.Quotient.mk
          (p := LinearMap.range (complementRes (M := P) I)) s = 0 := hk a haI
      rwa [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at h0
    have hcomp : complementRes I ((DirectSum.decompose 𝒩 m ((i : ℤ) + d) : (P : Type (max u v))))
        = a • s := by
      have h1 := DirectSum.coe_decompose_apply_of_mem_graded (𝒱 := 𝒩)
        (𝒱' := complementPiece 𝒜 𝒩 f I hIf (M := P))
        (complementRes (M := P) I).toAddMonoidHom
        (fun e x hx => complementRes_mem_complementPiece 𝒜 𝒩 f I hIf hc hx) ((i : ℤ) + d) m
      refine h1.symm.trans ?_
      rw [show (complementRes (M := P) I).toAddMonoidHom m = complementRes I m from rfl, hm]
      exact DirectSum.decompose_of_mem_same (complementPiece 𝒜 𝒩 f I hIf (M := P))
        (smul_mem_complementPiece 𝒜 𝒩 f I hIf hc ha hs)
    rw [← map_smul t a s, ← hcomp, ht]
    exact complementRes_mem_complementPiece 𝒜 𝒬 f I hIf hc
      (hφ _ _ (DirectSum.decompose 𝒩 m ((i : ℤ) + d)).2)

end Transition

end Stacks.LocalCohomology

