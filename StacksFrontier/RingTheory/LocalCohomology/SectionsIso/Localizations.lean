module

public import StacksFrontier.RingTheory.Cech.Substrate
public import StacksFrontier.RingTheory.LocalCohomology.MappingConeH0.Cover

/-!
# Sections of the associated sheaf on the standard opens of the Čech cover

Let `R` be a commutative ring, `f : Fin r → R` a finite family and `M` an `R`-module whose universe
is independent of the ring's. The extended alternating Čech complex of
`StacksFrontier/RingTheory/Cech/Substrate.lean` is built from the localizations
`Cech.cechMod f M t = M_{∏ i ∈ t, f i}`, indexed by the finite sets `t` of indices. On the
geometric side those localizations are the sections of the quasi-coherent module `M̃` on the
standard opens

`D(∏ i ∈ t, f i) = ⋂ i ∈ t, D(f i)`,

and this file sets up that dictionary: the open attached to a finite set of indices, the
identification of the sections on it with the Čech localization, and — the point of the file — the
fact that the *restriction maps* of the sheaf correspond to the *transition maps* of the Čech
complex.

The last statement is the only thing with content, and it is the uniqueness of maps out of a
localization: both composites in question are `R`-linear maps out of `Γ(D(∏ i ∈ s, f i), M̃)`,
which is a localization of `M` at the powers of `∏ i ∈ s, f i` by
`Stacks.LocalCohomology.isLocalizedModule_moduleSectionsMk_basicOpen`, and both send the constant
fraction `m / 1` to `m / 1`.

The index set is kept as `∏ i ∈ t, f i` even for a singleton `t = {i}`, rather than being
simplified to `f i`: the Čech complex localizes at the products, so using them throughout avoids
transporting a localization along the equality of submonoids
`Submonoid.powers (∏ i ∈ {j}, f i) = Submonoid.powers (f j)`.

## Main definitions

* `Stacks.LocalCohomology.cechBasicOpen` — the standard open `D(∏ i ∈ t, f i)`.
* `Stacks.LocalCohomology.cechSectionsEquiv` — `Γ(D(∏ i ∈ t, f i), M̃) ≅ M_{∏ i ∈ t, f i}`.

## Main results

* `Stacks.LocalCohomology.mem_cechBasicOpen_iff` — a prime lies in `D(∏ i ∈ t, f i)` exactly when
  it misses every `f i` with `i ∈ t`.
* `Stacks.LocalCohomology.cechSectionsEquiv_restrict` — **restriction is the Čech transition map**:
  under the identifications above, restricting sections from `D(∏ i ∈ s, f i)` to
  `D(∏ i ∈ t, f i)` for `s ⊆ t` is `Cech.cechι`.
* `Stacks.LocalCohomology.complementZeroLocus_eq_iSup_cechBasicOpen` — `Spec R \ V(I)` is the union
  of the opens attached to the singletons.

## References

* [Stacks Project, Tag 01HR](https://stacks.math.columbia.edu/tag/01HR)
* [Stacks Project, Tag 0DWR](https://stacks.math.columbia.edu/tag/0DWR)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace AlgebraicGeometry
open PrimeSpectrum (basicOpen)

universe v u

namespace Stacks.LocalCohomology

variable {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)

/-- The standard open attached to a finite set of indices: the locus where every `f i`, `i ∈ t`,
is invertible. It is the open on which the Čech localization `Cech.cechMod f M t` is the module of
sections of `M̃`. -/
abbrev cechBasicOpen (t : Finset (Fin r)) : Opens (PrimeSpectrum.Top R) :=
  basicOpen (∏ i ∈ t, f i)

/-- A prime lies in `D(∏ i ∈ t, f i)` exactly when it contains none of the `f i`, `i ∈ t`: a prime
contains a product over a finite set precisely when it contains one of the factors. -/
theorem mem_cechBasicOpen_iff (t : Finset (Fin r)) (p : PrimeSpectrum R) :
    p ∈ cechBasicOpen f t ↔ ∀ i ∈ t, p ∈ basicOpen (f i) := by
  change (∏ i ∈ t, f i) ∉ p.asIdeal ↔ _
  simp only [PrimeSpectrum.mem_basicOpen, Ideal.IsPrime.prod_mem_iff, not_exists, not_and]

/-- The open attached to a singleton is the standard open of the corresponding element. -/
theorem cechBasicOpen_singleton (i : Fin r) : cechBasicOpen f {i} = basicOpen (f i) :=
  congrArg basicOpen (Finset.prod_singleton f i)

/-- Enlarging the set of indices shrinks the open. -/
theorem cechBasicOpen_le_of_subset {s t : Finset (Fin r)} (h : s ⊆ t) :
    cechBasicOpen f t ≤ cechBasicOpen f s := fun p hp =>
  (mem_cechBasicOpen_iff f s p).2 fun i hi => (mem_cechBasicOpen_iff f t p).1 hp i (h hi)

variable (I : Ideal R)

/-- **`Spec R \ V(I)` is the union of the opens attached to the singletons.** This is
`Stacks.LocalCohomology.complementZeroLocus_eq_iSup_basicOpen` in the indexing used by the Čech
complex. -/
theorem complementZeroLocus_eq_iSup_cechBasicOpen (hIf : Ideal.span (Set.range f) = I) :
    (complementZeroLocus R I : Opens (PrimeSpectrum.Top R)) = ⨆ i, cechBasicOpen f {i} :=
  (complementZeroLocus_eq_iSup_basicOpen f I hIf).trans
    (iSup_congr fun i => (cechBasicOpen_singleton f i).symm)

variable (M : ModuleCat.{v} R)

/-- **`Γ(D(∏ i ∈ t, f i), M̃) ≅ M_{∏ i ∈ t, f i}`.** The sections of the quasi-coherent module
generated by `M` on the standard open attached to `t` are the Čech localization at `t`; this is
`Stacks.LocalCohomology.moduleSectionsBasicOpenEquiv` at the element `∏ i ∈ t, f i`, whose powers
are exactly the submonoid `Cech.cechSub f t` the Čech complex localizes at. -/
def cechSectionsEquiv (t : Finset (Fin r)) :
    moduleSections M (cechBasicOpen f t) ≃ₗ[R] Cech.cechMod f (M : Type _) t :=
  moduleSectionsBasicOpenEquiv M (∏ i ∈ t, f i)

/-- `Stacks.LocalCohomology.cechSectionsEquiv` sends the section of `M̃` on `D(∏ i ∈ t, f i)`
determined by `m : M` to the fraction `m / 1` in `M_{∏ i ∈ t, f i}`. -/
@[simp]
theorem cechSectionsEquiv_moduleSectionsMk (t : Finset (Fin r)) (m : M) :
    cechSectionsEquiv f M t (moduleSectionsMk M (cechBasicOpen f t) m) =
      LocalizedModule.mkLinearMap (Cech.cechSub f t) (M : Type _) m :=
  moduleSectionsBasicOpenEquiv_moduleSectionsMk M (∏ i ∈ t, f i) m

/-- **Restriction of sections is the Čech transition map.** For `s ⊆ t`, restricting a section of
`M̃` from `D(∏ i ∈ s, f i)` to `D(∏ i ∈ t, f i)` becomes, under
`Stacks.LocalCohomology.cechSectionsEquiv`, the canonical map `M_{∏ i ∈ s, f i} ⟶ M_{∏ i ∈ t, f i}`
of localizations. Both sides are `R`-linear maps out of a localization of `M` at the powers of
`∏ i ∈ s, f i` which agree on the constant fractions `m / 1`, so they agree. -/
theorem cechSectionsEquiv_restrict {s t : Finset (Fin r)} (h : s ⊆ t) :
    (cechSectionsEquiv f M t).toLinearMap.comp
        (moduleSectionsRestrict M (cechBasicOpen_le_of_subset f h)) =
      (Cech.cechι f (M : Type _) h).comp (cechSectionsEquiv f M s).toLinearMap := by
  refine IsLocalizedModule.ext (Cech.cechSub f s) (moduleSectionsMk M (cechBasicOpen f s))
    (fun x => Cech.isUnit_algebraMap f (M : Type _) h
      (LocalizedModule.mkLinearMap (Cech.cechSub f t) (M : Type _)) x) ?_
  refine LinearMap.ext fun m => ?_
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
  rw [show moduleSectionsRestrict M (cechBasicOpen_le_of_subset f h)
      (moduleSectionsMk M (cechBasicOpen f s) m) = moduleSectionsMk M (cechBasicOpen f t) m from
    LinearMap.congr_fun
      (moduleSectionsRestrict_comp_moduleSectionsMk M (cechBasicOpen_le_of_subset f h)) m]
  rw [cechSectionsEquiv_moduleSectionsMk, cechSectionsEquiv_moduleSectionsMk,
    Cech.cechι_mk]

/-- `Stacks.LocalCohomology.cechSectionsEquiv_restrict`, applied to a section. -/
theorem cechSectionsEquiv_restrict_apply {s t : Finset (Fin r)} (h : s ⊆ t)
    (x : moduleSections M (cechBasicOpen f s)) :
    cechSectionsEquiv f M t (moduleSectionsRestrict M (cechBasicOpen_le_of_subset f h) x) =
      Cech.cechι f (M : Type _) h (cechSectionsEquiv f M s x) :=
  LinearMap.congr_fun (cechSectionsEquiv_restrict f M h) x

end Stacks.LocalCohomology

end
