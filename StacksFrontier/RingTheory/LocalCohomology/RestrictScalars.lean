module

public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRingsExact
public import Mathlib.CategoryTheory.Adjunction.Restrict
public import Mathlib.CategoryTheory.Adjunction.Unique
public import StacksFrontier.Homology.Tor.DerivedChangeOfRingsAdjunction
public import StacksFrontier.RingTheory.Dualizing.PowerTorsionComparison.LocalCohomologyFunctor
public import StacksFrontier.RingTheory.LocalCohomology.BaseChange.Commutation

/-!
# Local cohomology and restriction of scalars

Let `f : A →+* B` be a homomorphism of commutative rings, let `I ⊆ A` be a finitely generated
ideal, and set `J = I B = Ideal.map f I`. Write `Z = V(I) ⊆ Spec(A)` and `Y = V(J) ⊆ Spec(B)`.
A `B`-module is `J`-power torsion exactly when it is `I`-power torsion after restriction of
scalars, because `J ^ n = Ideal.map f (I ^ n)` is generated by the image of `I ^ n`.
Consequently restriction of scalars carries `D_{J^∞-torsion}(B)` into `D_{I^∞-torsion}(A)`, and
local cohomology commutes with restriction of scalars:

`RΓ_Z(M_A) = RΓ_Y(M)_A` functorially in `M ∈ D(B)`.

The proof is the first of the two the source offers: both sides are right adjoint to the functor
`D_{I^∞-torsion}(A) ⥤ D(B)`, `K ↦ K ⊗ᴸ_A B`. The content hidden in that sentence is that derived
extension of scalars carries `I`-power-torsion cohomology to `J`-power-torsion cohomology, which
is proved here from the commutation of derived extension of scalars with localization away from an
element (`Stacks.LocalCohomology.derivedExtendLocIso`) together with the criterion that an object
of `D(A)` has `I`-power-torsion cohomology exactly when it is killed by localization at each
generator of `I`. Everything else is uniqueness of adjoints.

## Main definitions

* `Stacks.LocalCohomology.powerTorsionRestrictScalars` — restriction of scalars between the
  power-torsion derived categories, `D_{J^∞-torsion}(B) ⥤ D_{I^∞-torsion}(A)`.
* `Stacks.LocalCohomology.derivedExtensionRestrictAdjunction` — the adjunction of Stacks 0GMT
  at the module universe used here, for the canonical model of derived extension of scalars.

## Main results

* `Stacks.LocalCohomology.isIPowerTorsion_restrictScalars_iff` — a `B`-module is
  `Ideal.map f I`-power torsion if and only if it is `I`-power torsion after restriction of
  scalars.
* `Stacks.LocalCohomology.powerTorsionRestrictScalarsData` — the torsion-valued restriction
  functor together with its comparison to ordinary derived restriction after inclusion.
* `Stacks.LocalCohomology.powerTorsionRestrictScalarsCompInclusionIso` — that comparison.
* `Stacks.LocalCohomology.derivedPowerTorsionProperty_derivedExtensionScalars` — derived
  extension of scalars along `f` carries `I`-power-torsion cohomology to `Ideal.map f I`-power
  torsion cohomology.
* `Stacks.LocalCohomology.localCohomologyRestrictScalarsIso` — local cohomology commutes with
  restriction of scalars.

## References

* [Stacks Project, Tag 0BJB](https://stacks.math.columbia.edu/tag/0BJB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CochainComplex.DerivedExtensionScalars

attribute [local instance] HasDerivedCategory.standard

universe uA uB v

namespace Stacks.LocalCohomology

section Modules

variable {A : Type uA} {B : Type uB} [CommRing A] [CommRing B]

/-- Restriction of scalars along `f : A →+* B` identifies the `Ideal.map f I`-power-torsion
`B`-modules with the `I`-power-torsion `A`-modules: the ideal `Ideal.map f (I ^ n)` is generated
by the image of `I ^ n`, so a `B`-module is killed by `(Ideal.map f I) ^ n` exactly when it is
killed by `I ^ n` through `f`. -/
theorem isIPowerTorsion_restrictScalars_iff (f : A →+* B) (I : Ideal A) (M : ModuleCat.{v} B) :
    IsIPowerTorsion A ((ModuleCat.restrictScalars.{v} f).obj M) I ↔
      IsIPowerTorsion B M (I.map f) := by
  refine ⟨fun h m => ?_, fun h m => ?_⟩
  · obtain ⟨n, hn, hkill⟩ := h m
    refine ⟨n, hn, fun b hb => ?_⟩
    rw [← Ideal.map_pow] at hb
    refine (Submodule.mem_annihilator_span_singleton (R := B) m b).1
      (Ideal.map_le_iff_le_comap.2 (fun a ha => ?_) hb)
    exact (Submodule.mem_annihilator_span_singleton (R := B) m (f a)).2 (hkill a ha)
  · obtain ⟨n, hn, hkill⟩ := h m
    exact ⟨n, hn, fun a ha => hkill (f a) (Ideal.map_pow f I n ▸ Ideal.mem_map_of_mem f ha)⟩

/-- Restriction of scalars carries the objects of `D(B)` with `Ideal.map f I`-power-torsion
cohomology to objects of `D(A)` with `I`-power-torsion cohomology. -/
theorem derivedPowerTorsionProperty_restrictScalars (f : A →+* B) (I : Ideal A) (hI : I.FG)
    (K : DerivedCategory (ModuleCat.{v} B))
    (hK : Dualizing.derivedPowerTorsionProperty B (I.map f) (hI.map f) K) :
    Dualizing.derivedPowerTorsionProperty A I hI
      ((ModuleCat.restrictScalars.{v} f).mapDerivedCategory.obj K) := by
  intro i
  refine (Dualizing.powerTorsionModuleProperty A I hI).prop_of_iso
    ((Dualizing.mapDerivedCategoryHomologyIso (ModuleCat.restrictScalars.{v} f) i).app K).symm ?_
  exact (isIPowerTorsion_restrictScalars_iff f I _).2 (hK i)

end Modules

/-- Restriction of scalars on power-torsion derived categories, together with its comparison to
ordinary derived restriction after inclusion. -/
@[stacks 0BJB "the torsion-valued restriction functor"]
noncomputable def powerTorsionRestrictScalarsData
    {A : Type uA} {B : Type uB} [CommRing A] [CommRing B]
    (f : A →+* B) (I : Ideal A) (hI : I.FG) :
    Σ' F : Dualizing.PowerTorsionDerivedCategory B (I.map f) (hI.map f) ⥤
        Dualizing.PowerTorsionDerivedCategory A I hI,
      F ⋙ (Dualizing.derivedPowerTorsionProperty A I hI).ι ≅
        (Dualizing.derivedPowerTorsionProperty B (I.map f) (hI.map f)).ι ⋙
          (ModuleCat.restrictScalars.{max uA uB v} f).mapDerivedCategory :=
  ⟨(Dualizing.derivedPowerTorsionProperty A I hI).lift
      ((Dualizing.derivedPowerTorsionProperty B (I.map f) (hI.map f)).ι ⋙
        (ModuleCat.restrictScalars.{max uA uB v} f).mapDerivedCategory)
      (fun K => derivedPowerTorsionProperty_restrictScalars f I hI K.obj K.property),
    (Dualizing.derivedPowerTorsionProperty A I hI).liftCompιIso _ _⟩

/-- Restriction of scalars between the derived categories of power-torsion modules. -/
noncomputable def powerTorsionRestrictScalars
    {A : Type uA} {B : Type uB} [CommRing A] [CommRing B]
    (f : A →+* B) (I : Ideal A) (hI : I.FG) :
    Dualizing.PowerTorsionDerivedCategory B (I.map f) (hI.map f) ⥤
      Dualizing.PowerTorsionDerivedCategory A I hI :=
  (powerTorsionRestrictScalarsData.{uA, uB, v} f I hI).1

/-- Derived restriction of scalars on torsion objects agrees with ambient derived restriction
after inclusion. -/
noncomputable def powerTorsionRestrictScalarsCompInclusionIso
    {A : Type uA} {B : Type uB} [CommRing A] [CommRing B]
    (f : A →+* B) (I : Ideal A) (hI : I.FG) :
    powerTorsionRestrictScalars.{uA, uB, v} f I hI ⋙
        (Dualizing.derivedPowerTorsionProperty A I hI).ι ≅
      (Dualizing.derivedPowerTorsionProperty B (I.map f) (hI.map f)).ι ⋙
        (ModuleCat.restrictScalars.{max uA uB v} f).mapDerivedCategory :=
  (powerTorsionRestrictScalarsData.{uA, uB, v} f I hI).2

section Adjoint

variable {A : Type uA} {B : Type uB} [CommRing A] [CommRing B]

/-- Derived extension of scalars along `f` carries `I`-power-torsion cohomology to
`Ideal.map f I`-power-torsion cohomology. For a generator `a` of `I` the object is killed by
localization at `a`, and derived extension of scalars commutes with that localization, so the
image is killed by localization at `f a`; the generators `f a` of `Ideal.map f I` then give the
criterion. -/
theorem derivedPowerTorsionProperty_derivedExtensionScalars
    (f : A →+* B) (I : Ideal A) (hI : I.FG)
    (W : DerivedCategory (ModuleCat.{max uA uB v} A))
    (hW : Dualizing.derivedPowerTorsionProperty A I hI W) :
    Dualizing.derivedPowerTorsionProperty B (I.map f) (hI.map f)
      ((derivedExtensionScalarsGeneral.{uA, v, uB} f).functor.obj W) := by
  classical
  obtain ⟨s, hs⟩ := id hI
  have hs' : Ideal.span ((s.image f : Finset B) : Set B) = I.map f := by
    rw [Finset.coe_image, ← Ideal.map_span, hs]
  rw [derivedPowerTorsion_iff_loc.{uB, max uA v} _ _ (s.image f) hs']
  intro b hb
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hb
  have hz : IsZero ((derivedLoc.{uA, max uB v} a).obj W) :=
    (derivedPowerTorsion_iff_loc.{uA, max uB v} _ _ s hs W).mp hW a ha
  exact ((derivedExtensionScalarsGeneral.{uA, v, uB} f).functor.map_isZero hz).of_iso
    (derivedExtendLocIso.{uA, uB, v} f a W).symm

/-- Derived extension of scalars along `f` is left adjoint to derived restriction of scalars,
at the module universe `max uA uB v`. This is Stacks 0GMT, specialized to the canonical
model. -/
noncomputable def derivedExtensionRestrictAdjunction (f : A →+* B) :
    (derivedExtensionScalarsGeneral.{uA, v, uB} f).functor ⊣
      (ModuleCat.restrictScalars.{max uA uB v} f).mapDerivedCategory :=
  let D := derivedExtensionScalarsGeneral.{uA, v, uB} f
  @derivedExtensionScalarsAdjunction.{uA, uB, v} A B _ _ f _ _
    D.functor D.comparison D.isLeftDerived

/-- **Stacks Project, Tag 0BJB.** Local cohomology commutes with restriction of scalars,
naturally in the derived `B`-module, as an isomorphism valued in the power-torsion derived
category.

Both functors are right adjoint to `K ↦ K ⊗ᴸ_A B` on `D_{I^∞-torsion}(A)`: for the left-hand
side this is the composite of the local-cohomology adjunction over `A` with the
extension–restriction adjunction, and for the right-hand side it is the composite of the
local-cohomology adjunction over `B` with the restriction of the extension–restriction
adjunction to the two power-torsion subcategories. -/
@[stacks 0BJB "the local-cohomology isomorphism"]
noncomputable def localCohomologyRestrictScalarsIso
    (f : A →+* B) (I : Ideal A) (hI : I.FG) :
    (ModuleCat.restrictScalars.{max uA uB v} f).mapDerivedCategory ⋙
        Dualizing.localCohomologyFunctor A I hI ≅
      Dualizing.localCohomologyFunctor B (I.map f) (hI.map f) ⋙
        powerTorsionRestrictScalars.{uA, uB, v} f I hI := by
  set PA := Dualizing.derivedPowerTorsionProperty.{uA, max uA uB v} A I hI
  set PB := Dualizing.derivedPowerTorsionProperty.{uB, max uA uB v} B (I.map f) (hI.map f)
  have hb (W : PA.FullSubcategory) :
      PB ((derivedExtensionScalarsGeneral.{uA, v, uB} f).functor.obj (PA.ι.obj W)) :=
    derivedPowerTorsionProperty_derivedExtensionScalars.{uA, uB, v} f I hI _ W.property
  have comm₁ : PA.ι ⋙ (derivedExtensionScalarsGeneral.{uA, v, uB} f).functor ≅
      PB.lift (PA.ι ⋙ (derivedExtensionScalarsGeneral.{uA, v, uB} f).functor) hb ⋙ PB.ι :=
    (PB.liftCompιIso _ hb).symm
  have comm₂ : PB.ι ⋙ (ModuleCat.restrictScalars.{max uA uB v} f).mapDerivedCategory ≅
      powerTorsionRestrictScalars.{uA, uB, v} f I hI ⋙ PA.ι :=
    (powerTorsionRestrictScalarsCompInclusionIso.{uA, uB, v} f I hI).symm
  exact Adjunction.rightAdjointUniq
    (((Dualizing.localCohomologyAdjunction.{uA, max uA uB v} A I hI).comp
      (derivedExtensionRestrictAdjunction.{uA, uB, v} f)).ofNatIsoLeft comm₁)
    ((Adjunction.restrictFullyFaithful (derivedExtensionRestrictAdjunction.{uA, uB, v} f)
        PA.fullyFaithfulι PB.fullyFaithfulι comm₁ comm₂).comp
      (Dualizing.localCohomologyAdjunction.{uB, max uA uB v} B (I.map f) (hI.map f)))

end Adjoint

end Stacks.LocalCohomology

end
