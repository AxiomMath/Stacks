module

public import StacksFrontier.RingTheory.LocalCohomology.VanishingTFAE.CohomologicalDimension

/-!
# Bounding the cohomological dimension by a number of generators

Let `I` be a finitely generated ideal of a commutative ring `A` and let `Y = V(I) ⊆ X = Spec A`.
The cohomological dimension `cd(A, I)` of [Stacks, Tag 0DX8] is the least integer `d ≥ -1` with
`H^i_Y(A) = 0` for all `i > d`. If `I` is generated by `n` elements then `cd(A, I) ≤ n`, and more
generally `cd(A, I) ≤ n` as soon as there are `n` elements whose common zero locus is `Y`.

## Main results

* `Stacks.LocalCohomology.derivedPowerTorsionProperty_iff_of_zeroLocus_eq` — two finitely
  generated ideals with the same zero locus cut out the same full subcategory of `D(A)`.
* `Stacks.LocalCohomology.isZero_homology_localCohomologyFunctor_of_zeroLocus_eq` — the
  cohomological dimension bound for `RΓ_{V(I)}`, with the generating family taken for any
  finitely generated ideal having the same zero locus as `I`.
* `Stacks.LocalCohomology.cohomologicalDimension_le_card_zeroLocus_generators` — `cd(A, I)` is
  at most the number of elements of a finite family with zero locus `V(I)`.
* `Stacks.LocalCohomology.cohomologicalDimension_le_card_generators` — `cd(A, I)` is at most the
  number of elements of a finite family generating `I`.

## References

* [Stacks Project, Tag 0DX9](https://stacks.math.columbia.edu/tag/0DX9)
* [Stacks Project, Tag 0DX8](https://stacks.math.columbia.edu/tag/0DX8)
* [Stacks Project, Tag 0953](https://stacks.math.columbia.edu/tag/0953)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

universe v u

namespace Stacks.LocalCohomology

variable {A : Type u} [CommRing A]

/-- Two finitely generated ideals with the same zero locus single out the same objects of
`D(A)`: those all of whose cohomology modules are power torsion. -/
theorem derivedPowerTorsionProperty_iff_of_zeroLocus_eq
    (I J : Ideal A) (hI : I.FG) (hJ : J.FG)
    (h : PrimeSpectrum.zeroLocus (I : Set A) = PrimeSpectrum.zeroLocus (J : Set A))
    (X : DerivedCategory (ModuleCat.{max v u} A)) :
    Dualizing.derivedPowerTorsionProperty A I hI X ↔
      Dualizing.derivedPowerTorsionProperty A J hJ X := by
  refine forall_congr' fun i => ?_
  rw [isIPowerTorsion_iff_support_subset _ _ _ hI,
    isIPowerTorsion_iff_support_subset _ _ _ hJ, h]

/-- If the cohomology of `X` vanishes in degrees above `n`, then the cohomology of
`RΓ_{V(I)}(X)` vanishes in degrees above `n + r`, where `r` is the size of a finite generating
set of any finitely generated ideal `J` with `V(J) = V(I)`. -/
theorem isZero_homology_localCohomologyFunctor_of_zeroLocus_eq
    (I : Ideal A) (hI : I.FG) (J : Ideal A) (hJ : J.FG)
    (hIJ : PrimeSpectrum.zeroLocus (I : Set A) = PrimeSpectrum.zeroLocus (J : Set A))
    (s : Finset A) (hs : Ideal.span (s : Set A) = J)
    (X : DerivedCategory (ModuleCat.{max v u} A)) (n : ℤ)
    (hX : ∀ j, n < j →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{max v u} A) j).obj X))
    (j : ℤ) (hj : n + s.card < j) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{max v u} A) j).obj
      ((Dualizing.derivedPowerTorsionProperty A I hI).ι.obj
        ((Dualizing.localCohomologyFunctor A I hI).obj X))) := by
  obtain ⟨Y, a, hYloc, hbY, hYbd⟩ :=
    exists_coreflection_isZero_homology
      (fun f : A => Dualizing.PowerTorsionBaseChange.locDerived.{v} f)
      (fun f : A => Dualizing.PowerTorsionBaseChange.locDerivedUnit.{v} f)
      (fun f => Dualizing.PowerTorsionBaseChange.isIso_locDerivedUnit_locDerived f)
      (fun f => Dualizing.PowerTorsionBaseChange.isIso_locDerived_map_locDerivedUnit f)
      (fun f g W h => Dualizing.PowerTorsionBaseChange.locDerived_isZero_locDerived g f W h)
      (fun f W m hW k hk => ((Dualizing.PowerTorsionBaseChange.locFunctor.{v} f).map_isZero
        (hW k hk)).of_iso
          ((Dualizing.mapDerivedCategoryHomologyIso
            (Dualizing.PowerTorsionBaseChange.locFunctor.{v} f) k).app W))
      s X n hX
  have key := fun W => (derivedPowerTorsionProperty_iff_of_zeroLocus_eq I J hI hJ hIJ W).trans
    (Dualizing.PowerTorsionBaseChange.derivedPowerTorsion_iff_locDerived_isZero J hJ s hs W)
  obtain ⟨e⟩ := nonempty_localCohomology_iso_coreflection I hI ((key Y).mpr hYloc) a
    (fun W hW => hbY W ((key W).mp hW))
  exact (hYbd j hj).of_iso
    ((DerivedCategory.homologyFunctor (ModuleCat.{max v u} A) j).mapIso e)

/-- The cohomological dimension is at most the number of equations in any finite family
defining the same zero locus. -/
@[stacks 0DX9 "part (2): the bound by a family cutting out the same zero locus"]
theorem cohomologicalDimension_le_card_zeroLocus_generators
    (A : Type u) [CommRing A] (I : Ideal A) (hI : I.FG)
    {n : ℕ} (f : Fin n → A)
    (hf : PrimeSpectrum.zeroLocus ((Ideal.span (Set.range f) : Ideal A) : Set A) =
      PrimeSpectrum.zeroLocus (I : Set A)) :
    cohomologicalDimension A I hI ≤ (n : ℤ) := by
  classical
  refine cohomologicalDimension_le A I hI _ ⟨by omega, fun i hi => ?_⟩
  set s : Finset A := Finset.image f Finset.univ with hsdef
  have hs : Ideal.span (s : Set A) = Ideal.span (Set.range f) := by
    rw [hsdef, Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hcard : (s.card : ℤ) ≤ (n : ℤ) := by
    exact_mod_cast (Finset.card_image_le.trans_eq (by simp) : (Finset.univ.image f).card ≤ n)
  exact isZero_homology_localCohomologyFunctor_of_zeroLocus_eq.{u, u} I hI _ ⟨s, hs⟩ hf.symm
    s hs _ 0 (fun j hj => isZero_homology_singleFunctor_obj _ j (by omega)) i (by omega)

/-- The cohomological dimension is at most the number of generators in any finite generating
family of the ideal. -/
@[stacks 0DX9 "part (1): the bound by the number of generators"]
theorem cohomologicalDimension_le_card_generators
    (A : Type u) [CommRing A] (I : Ideal A) (hI : I.FG)
    {n : ℕ} (f : Fin n → A) (hf : I = Ideal.span (Set.range f)) :
    cohomologicalDimension A I hI ≤ (n : ℤ) :=
  cohomologicalDimension_le_card_zeroLocus_generators A I hI f (by rw [hf])

end Stacks.LocalCohomology
