module

public import StacksFrontier.Homology.DerivedComplete.CechReflectionTriangulated
public import StacksFrontier.RingTheory.LocalCohomology.LocalizationTriangle

/-!
# The derived completion of the affine localization triangle

Let `I = (f₁, …, f_r)` be a finitely generated ideal of a commutative ring `R`, let
`U = Spec R ∖ V(I)` and let `J` be the ideal generated by a second finite family `g`. Derived
`J`-adic completion is exact, so applying it to the localization triangle
`RΓ_{V(I)}(M) ⟶ M ⟶ RΓ(U, M̃|U) ⟶ RΓ_{V(I)}(M)[1]`
again gives a distinguished triangle. This is the step at which a comparison of localization
triangles may be carried out after completion.

## Main results

* `Stacks.LocalCohomology.derivedCompletion_cechLocalizationTriangle_distinguished` — the derived
  completion of the localization triangle is distinguished.

## References

* [Stacks Project, Tag 0DWR](https://stacks.math.columbia.edu/tag/0DWR)
* [Stacks Project, Tag 091V](https://stacks.math.columbia.edu/tag/091V)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

attribute [local instance] HasDerivedCategory.standard
  Dualizing.hasProductsOfShape_nat_derivedCategory

universe u

namespace Stacks.LocalCohomology

/-- **The localization triangle survives derived completion.** For a finitely generated ideal
`I = (f₁, …, f_r)` of `R` and a second finite family `g`, derived completion along the ideal
generated by `g` carries the localization triangle of an `R`-module to a distinguished
triangle. -/
theorem derivedCompletion_cechLocalizationTriangle_distinguished {R : Type u} [CommRing R]
    {r : ℕ} (f : Fin r → R) (I : Ideal R) (hI : I.FG)
    (hIf : Ideal.span (Set.range f) = I) {s : ℕ} (g : Fin s → R) (M : ModuleCat.{u} R) :
    (DerivedCompletion.derivedCompletionFunctor R g).mapTriangle.obj
        (Triangle.mk ((Dualizing.localCohomologyAdjunction R I hI).counit.app
            ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M))
          ((cechRestriction.{u} f).app M)
          ((cechBoundary.{u} f I hI hIf).app M)) ∈ distTriang _ :=
  (DerivedCompletion.derivedCompletionFunctor R g).map_distinguished _
    (cechLocalizationTriangle_distinguished.{u, u} f I hI hIf M)

end Stacks.LocalCohomology

end
