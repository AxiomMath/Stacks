module

public import StacksFrontier.RingTheory.LocalCohomology.BasicOpenSections.Normalize
public import Mathlib.Algebra.Module.LocalizedModule.Away
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Sections of the associated sheaf on a standard open, at independent universes

Let `A` be a commutative ring, `M` an `A`-module and `f ∈ A`. The sections of the quasi-coherent
module `M̃` generated by `M` on the standard open `D(f) ⊆ Spec A` are the localization `M_f`:

`Γ(D(f), M̃) ≅ M_f`,

the isomorphism sending `m / fⁿ` to the section which is the constant fraction `m / fⁿ` at every
prime of `D(f)`. Here `M : ModuleCat.{v} A` with `A : Type u`, the universes `u` and `v` being
independent.

## Main definitions

* `Stacks.LocalCohomology.moduleSectionsBasicOpenEquiv`: the isomorphism `Γ(D(f), M̃) ≅ M_f` of
  `A`-modules.

## Main results

* `Stacks.LocalCohomology.isLocalizedModule_moduleSectionsMk_basicOpen`: the map `m ↦ m / 1`
  from `M` to the sections of `M̃` on `D(f)` exhibits those sections as the localization of `M`
  away from `f`.
* `Stacks.LocalCohomology.isUnit_algebraMap_moduleSections_basicOpen`: `f` acts invertibly on
  `Γ(D(f), M̃)`.
* `Stacks.LocalCohomology.exists_pow_smul_eq_moduleSectionsMk`: a power of `f` carries any
  section on `D(f)` into the image of `M`.

## References

* [Stacks Project, Tag 01HR](https://stacks.math.columbia.edu/tag/01HR)
* [Stacks Project, Tag 08D0](https://stacks.math.columbia.edu/tag/08D0)
* [Stacks Project, Tag 0DWR](https://stacks.math.columbia.edu/tag/0DWR)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open PrimeSpectrum (basicOpen)

universe u v

namespace Stacks.LocalCohomology

variable {A : Type u} [CommRing A] (M : ModuleCat.{v} A)

/-- An element outside a prime acts invertibly on the localization of a module at that prime. -/
theorem isUnit_algebraMap_localizedModule {p : PrimeSpectrum A} {g : A} (hg : g ∉ p.asIdeal) :
    IsUnit (algebraMap A (Module.End A (LocalizedModule p.asIdeal.primeCompl M)) g) :=
  IsLocalizedModule.map_units (LocalizedModule.mkLinearMap p.asIdeal.primeCompl M)
    (⟨g, hg⟩ : p.asIdeal.primeCompl)

/-- An element outside a prime acts bijectively on the localization of a module at that prime. -/
private theorem bijective_smul_localizedModule {p : PrimeSpectrum A} {g : A} (hg : g ∉ p.asIdeal) :
    Function.Bijective fun y : LocalizedModule p.asIdeal.primeCompl M ↦ g • y :=
  (Module.End.isUnit_iff _).mp (isUnit_algebraMap_localizedModule M hg)

/-- An element outside a prime acts injectively on the localization of a module at that prime. -/
theorem smul_injective_localizedModule {p : PrimeSpectrum A} {g : A} (hg : g ∉ p.asIdeal)
    {y z : LocalizedModule p.asIdeal.primeCompl M} (h : g • y = g • z) : y = z :=
  (bijective_smul_localizedModule M hg).1 h

/-- An element outside a prime acts surjectively on the localization of a module at that
prime. -/
theorem exists_smul_eq_localizedModule {p : PrimeSpectrum A} {g : A} (hg : g ∉ p.asIdeal)
    (y : LocalizedModule p.asIdeal.primeCompl M) : ∃ z, g • z = y :=
  (bijective_smul_localizedModule M hg).2 y

variable (f : A)

/-- Scaling by `f` is injective on the sections of `M̃` over `D(f)`. -/
theorem smul_injective_moduleSections_basicOpen :
    Function.Injective fun s : moduleSections M (basicOpen f) ↦ f • s := fun _ _ hst ↦
  Subtype.ext (funext fun x ↦ smul_injective_localizedModule M x.2
    (congrFun (congrArg Subtype.val hst) x))

/-- Scaling by `f` is surjective on the sections of `M̃` over `D(f)`. -/
theorem smul_surjective_moduleSections_basicOpen :
    Function.Surjective fun s : moduleSections M (basicOpen f) ↦ f • s := by
  choose w hw using fun (x : basicOpen f) (y : LocalizedModule x.1.asIdeal.primeCompl M) ↦
    exists_smul_eq_localizedModule M x.2 y
  intro s
  refine ⟨⟨fun x ↦ w x (s.1 x), fun x ↦ ?_⟩, Subtype.ext (funext fun x ↦ hw x (s.1 x))⟩
  obtain ⟨V, hxV, i, m, a, hma⟩ := s.2 x
  refine ⟨V, hxV, i, m, a * f, fun y ↦ ?_⟩
  obtain ⟨hay, hy⟩ := hma y
  refine ⟨y.1.asIdeal.primeCompl.mul_mem hay (i y).2, ?_⟩
  refine smul_injective_localizedModule M (i y).2 ?_
  refine (hw (i y) (s.1 (i y))).trans (hy.trans ?_)
  exact (LocalizedModule.mk_eq.mpr ⟨1, by simp [Submonoid.smul_def, mul_smul]⟩).trans
    (LocalizedModule.smul'_mk f m _).symm

/-- `f` acts invertibly on `Γ(D(f), M̃)`. -/
theorem isUnit_algebraMap_moduleSections_basicOpen :
    IsUnit (algebraMap A (Module.End A (moduleSections M (basicOpen f))) f) :=
  (Module.End.isUnit_iff _).mpr
    ⟨smul_injective_moduleSections_basicOpen M f, smul_surjective_moduleSections_basicOpen M f⟩

/-- A power of `f` carries any section of `M̃` on `D(f)` into the image of `M`. -/
theorem exists_pow_smul_eq_moduleSectionsMk (s : moduleSections M (basicOpen f)) :
    ∃ (n : ℕ) (m : M), f ^ n • s = moduleSectionsMk M (basicOpen f) m := by
  obtain ⟨ι, _, a, b, hbU, hcover, hab, H⟩ :=
    exists_fintype_forall_eq_mk M (basicOpen f) (PrimeSpectrum.isCompact_basicOpen f) s
  obtain ⟨n, hn⟩ : f ∈ (Ideal.span (Set.range b)).radical := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, PrimeSpectrum.zeroLocus_span,
      PrimeSpectrum.mem_vanishingIdeal]
    intro p hp
    by_contra hfp
    obtain ⟨i, hpi⟩ := Opens.mem_iSup.mp (hcover hfp)
    exact hpi (hp ⟨i, rfl⟩)
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp
    (pow_succ' f n ▸ Ideal.mul_mem_left _ f hn : f ^ (n + 1) ∈ Ideal.span (Set.range b))
  rw [Finsupp.sum_fintype _ _ (by simp)] at hc
  refine ⟨n + 1, ∑ i, c i • a i, Subtype.ext (funext fun x ↦ ?_)⟩
  have hfx : f ^ (n + 1) ∉ x.1.asIdeal := fun h ↦ x.2 (x.1.2.mem_of_pow_mem _ h)
  have hstep : s.1 x = LocalizedModule.mk (∑ i, c i • a i) ⟨f ^ (n + 1), hfx⟩ := by
    obtain ⟨i, hpi⟩ := Opens.mem_iSup.mp (hcover x.2)
    refine (H i ⟨x.1, hpi⟩).trans (LocalizedModule.mk_eq.mpr ⟨1, ?_⟩)
    simp only [Submonoid.smul_def, one_smul, ← hc, Finset.sum_smul, Finset.smul_sum]
    exact Finset.sum_congr rfl fun j _ ↦ by
      rw [smul_eq_mul, mul_smul, hab i j, smul_comm]
  change f ^ (n + 1) • s.1 x = LocalizedModule.mk (∑ i, c i • a i) 1
  rw [hstep, LocalizedModule.smul'_mk]
  exact LocalizedModule.mk_eq.mpr ⟨1, by simp [Submonoid.smul_def]⟩

/-- A constant fraction `m / 1` that vanishes on all of `D(f)` is killed by a power of `f`. -/
theorem exists_pow_smul_eq_zero_of_moduleSectionsMk_eq_zero (m : M)
    (h : moduleSectionsMk M (basicOpen f) m = 0) : ∃ n : ℕ, f ^ n • m = 0 := by
  refine exists_pow_smul_eq_zero_of_forall_mem_basicOpen (M := M) f m fun p hp ↦ ?_
  have h0 : LocalizedModule.mk m (1 : p.asIdeal.primeCompl) = 0 :=
    congrFun (congrArg Subtype.val h) ⟨p, hp⟩
  rw [← LocalizedModule.zero_mk 1] at h0
  obtain ⟨u, hu⟩ := LocalizedModule.mk_eq.mp h0
  exact ⟨u.1, u.2, by simpa [Submonoid.smul_def] using hu⟩

/-- The sections of the quasi-coherent module generated by an `A`-module `M` on the standard open
`D(f)` are the localization of `M` away from `f`, via the map `m ↦ m / 1`. -/
@[ega "III 1.4.6" "Degree-zero affine case"]
instance isLocalizedModule_moduleSectionsMk_basicOpen :
    IsLocalizedModule.Away f (moduleSectionsMk M (basicOpen f)) :=
  .mk_of_addCommGroup (isUnit_algebraMap_moduleSections_basicOpen M f)
    (fun s ↦ (exists_pow_smul_eq_moduleSectionsMk M f s).imp fun _ ↦ id)
    (exists_pow_smul_eq_zero_of_moduleSectionsMk_eq_zero M f)

/-- The isomorphism `Γ(D(f), M̃) ≅ M_f` of `A`-modules, carrying the section which is the
constant fraction `m / 1` at every prime of `D(f)` to `m / 1 ∈ M_f`. -/
def moduleSectionsBasicOpenEquiv :
    moduleSections M (basicOpen f) ≃ₗ[A] LocalizedModule (Submonoid.powers f) M :=
  IsLocalizedModule.linearEquiv (Submonoid.powers f) (moduleSectionsMk M (basicOpen f))
    (LocalizedModule.mkLinearMap (Submonoid.powers f) M)

/-- `Stacks.LocalCohomology.moduleSectionsBasicOpenEquiv` carries the constant fraction `m / 1`
to `m / 1 ∈ M_f`. -/
@[simp]
theorem moduleSectionsBasicOpenEquiv_moduleSectionsMk (m : M) :
    moduleSectionsBasicOpenEquiv M f (moduleSectionsMk M (basicOpen f) m) =
      LocalizedModule.mk m 1 :=
  IsLocalizedModule.linearEquiv_apply (Submonoid.powers f) _ _ m

/-- The inverse of `Stacks.LocalCohomology.moduleSectionsBasicOpenEquiv` carries `m / 1 ∈ M_f`
to the constant fraction `m / 1`. -/
@[simp]
theorem moduleSectionsBasicOpenEquiv_symm_mk (m : M) :
    (moduleSectionsBasicOpenEquiv M f).symm (LocalizedModule.mk m 1) =
      moduleSectionsMk M (basicOpen f) m :=
  IsLocalizedModule.linearEquiv_symm_apply (Submonoid.powers f) _ _ m

end Stacks.LocalCohomology

end
