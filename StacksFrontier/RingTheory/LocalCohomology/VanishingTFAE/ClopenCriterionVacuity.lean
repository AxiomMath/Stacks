module

public import StacksFrontier.RingTheory.LocalCohomology.VanishingTFAE.LowBoundTFAE

/-!
# The clopen criterion has teeth on both sides

`StacksFrontier.RingTheory.LocalCohomology.VanishingTFAE.ClopenCriterion` proves that for a finitely
generated ideal `I` of a commutative ring `A` the local cohomology `H^i_{V(I)}(A)` vanishes in
every positive degree exactly when `V(I)` is open and closed. A criterion of that shape is
worthless if either side happens to hold always, so this file exhibits both failures.

* On the **positive** side the hypothesis is satisfiable non-degenerately: in a product of two
  nontrivial rings the idempotent `(1, 0)` cuts out a clopen zero locus that is neither empty nor
  the whole spectrum, so `H^i_{V(I)}(A) = 0` for all `i > 0` there. That is
  `Stacks.LocalCohomology.isClopen_zeroLocus_ne_empty_ne_univ_prod`, which this file feeds through
  the equivalence of Tag 0DX7 to get the whole of condition (1), (2) and (3) at `d = 0` at a
  concrete ring.
* On the **negative** side the conclusion genuinely fails: `V(2) ⊆ Spec ℤ` is not open, because
  `Spec ℤ` is irreducible and a nonempty clopen of a preconnected space is everything, while `2`
  is not nilpotent. Running the criterion backwards therefore *proves a non-vanishing*: some
  `H^i_{V(2)}(ℤ)` with `i > 0` is nonzero. This is the one statement here that is not bookkeeping
  — it is a lower bound on local cohomology obtained from the criterion, and nothing in this
  development computes such a module directly.

## Main results

* `Stacks.LocalCohomology.localCohomology_vanishing_tfae_prod_witness` — the equivalence of
  Tag 0DX7 at `d = 0` instantiated at `R × S`, together with the fact that the zero locus there is
  clopen and proper and nonempty.
* `Stacks.LocalCohomology.not_isClopen_zeroLocus_two_int` — `V(2)` is not clopen in `Spec ℤ`.
* `Stacks.LocalCohomology.not_isZero_localCohomologyModule_two_int` — **some positive-degree local
  cohomology of `ℤ` along `V(2)` is nonzero.**
* `Stacks.LocalCohomology.isZero_localCohomologyModule_prodIdempotent` and
  `Stacks.LocalCohomology.isZero_localCohomologyModule_forall_of_zeroLocus_empty` — the equivalence
  consumed through `List.TFAE.out` at a concrete ring, which is also what checks that the list has
  three usable indices.

## References

* [Stacks Project, Tag 0DX7](https://stacks.math.columbia.edu/tag/0DX7)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

universe u

namespace Stacks.LocalCohomology

/-! ### The hypothesis holds non-degenerately -/

/-- **The equivalence of Tag 0DX7 at `d = 0`, at a concrete ring.** In a product of two nontrivial
rings the ideal generated by the idempotent `(1, 0)` is finitely generated, its zero locus is
clopen and is neither empty nor the whole spectrum, and all three conditions of Tag 0DX7 hold
at `d = 0` — so the equivalence is not being read at a degenerate instance. -/
theorem localCohomology_vanishing_tfae_prod_witness (R S : Type u) [CommRing R] [CommRing S]
    [Nontrivial R] [Nontrivial S] :
    ∃ hI : (Ideal.span {((1, 0) : R × S)}).FG,
      IsClopen (PrimeSpectrum.zeroLocus
          ((Ideal.span {((1, 0) : R × S)} : Ideal (R × S)) : Set (R × S))) ∧
        PrimeSpectrum.zeroLocus
            ((Ideal.span {((1, 0) : R × S)} : Ideal (R × S)) : Set (R × S)) ≠ ∅ ∧
          PrimeSpectrum.zeroLocus
              ((Ideal.span {((1, 0) : R × S)} : Ideal (R × S)) : Set (R × S)) ≠ Set.univ ∧
            ∀ i : ℤ, 0 < i → IsZero (localCohomologyModule (R × S)
              (Ideal.span {((1, 0) : R × S)}) hI (ModuleCat.of (R × S) (R × S)) i) := by
  obtain ⟨hI, hclopen, hne, huniv⟩ := isClopen_zeroLocus_ne_empty_ne_univ_prod R S
  exact ⟨hI, hclopen, hne, huniv,
    (isClopen_zeroLocus_iff_isZero_localCohomologyModule _ hI).2 hclopen⟩

/-! ### The conclusion genuinely fails -/

/-- The ideal `(2) ⊆ ℤ` is finitely generated. -/
theorem fg_span_two_int : (Ideal.span {(2 : ℤ)}).FG :=
  Submodule.fg_span (Set.finite_singleton _)

/-- **`V(2)` is not clopen in `Spec ℤ`.** It is nonempty, because `(2)` is not the unit ideal; so
if it were also open it would be the whole spectrum, `Spec ℤ` being irreducible and hence
preconnected, and then `2` would be nilpotent. -/
theorem not_isClopen_zeroLocus_two_int :
    ¬ IsClopen (PrimeSpectrum.zeroLocus ((Ideal.span {(2 : ℤ)} : Ideal ℤ) : Set ℤ)) := by
  intro hc
  have hne : (PrimeSpectrum.zeroLocus ((Ideal.span {(2 : ℤ)} : Ideal ℤ) : Set ℤ)).Nonempty := by
    rw [Set.nonempty_iff_ne_empty]
    intro he
    have htop := PrimeSpectrum.zeroLocus_empty_iff_eq_top.1 he
    have h2 : (1 : ℤ) ∈ Ideal.span {(2 : ℤ)} := htop ▸ Submodule.mem_top
    rw [Ideal.mem_span_singleton] at h2
    omega
  obtain ⟨n, hn⟩ :=
    (PrimeSpectrum.zeroLocus_eq_univ_iff _).1 (hc.eq_univ hne) (Ideal.subset_span rfl)
  exact pow_ne_zero n (by norm_num : (2 : ℤ) ≠ 0) hn

/-- **Some positive-degree local cohomology of `ℤ` along `V(2)` is nonzero.** The criterion of
`Stacks.LocalCohomology.isClopen_zeroLocus_of_isZero_localCohomologyModule`, read backwards from
the failure of `V(2)` to be clopen.

Besides witnessing that the criterion's hypothesis is refutable, this is a statement no part of
this development proves directly: the Čech model computes `H^i_{V(I)}(M)` as the cohomology of an
explicit complex, but nothing here evaluates such a cohomology module to something nonzero. -/
theorem not_isZero_localCohomologyModule_two_int :
    ¬ ∀ i : ℤ, 0 < i → IsZero (localCohomologyModule ℤ (Ideal.span {(2 : ℤ)}) fg_span_two_int
      (ModuleCat.of ℤ ℤ) i) := fun h =>
  not_isClopen_zeroLocus_two_int
    (isClopen_zeroLocus_of_isZero_localCohomologyModule _ fg_span_two_int h)

/-! ### The equivalence consumed through `List.TFAE.out` -/

/-- **The whole equivalence at a concrete ring.** For `A = ℤ × ℤ` and `I` generated by the
idempotent `(1, 0)`, going from condition (3) to condition (1) of Tag 0DX7 at `d = 0` gives the
vanishing of every positive-degree local cohomology module of `ℤ × ℤ` along `V(I)`. -/
theorem isZero_localCohomologyModule_prodIdempotent :
    ∀ i : ℤ, 0 < i → IsZero (localCohomologyModule (ℤ × ℤ) (Ideal.span {((1, 0) : ℤ × ℤ)})
      (Submodule.fg_span (Set.finite_singleton _)) (ModuleCat.of (ℤ × ℤ) (ℤ × ℤ)) i) := by
  have H := localCohomology_vanishing_tfae_of_nonpos.{0} (ℤ × ℤ) (Ideal.span {((1, 0) : ℤ × ℤ)})
    (Submodule.fg_span (Set.finite_singleton _)) 0 (by omega) (by omega)
  obtain ⟨-, hclopen, -, -⟩ := isClopen_zeroLocus_ne_empty_ne_univ_prod ℤ ℤ
  refine (H.out 3 1).mp ?_
  exact ⟨fun hc => absurd hc (by decide), fun _ => hclopen, fun hc => absurd hc (by decide)⟩

/-- **The equivalence at `d = -1`, landing in the cross-universe condition (2).** An empty zero
locus kills the local cohomology of *every* module, which is the clause of Tag 0DX7 stated at a
module universe independent of the ring's. -/
theorem isZero_localCohomologyModule_forall_of_zeroLocus_empty (A : Type u) [CommRing A]
    (I : Ideal A) (hI : I.FG) (h : PrimeSpectrum.zeroLocus (I : Set A) = ∅) :
    ∀ (M : ModuleCat.{u} A) (i : ℤ), (-1 : ℤ) < i → IsZero (localCohomologyModule A I hI M i) := by
  have H := localCohomology_vanishing_tfae_of_nonpos.{u} A I hI (-1) (by omega) (by omega)
  refine (H.out 3 2).mp ?_
  exact ⟨fun _ => h, fun hc => absurd hc (by decide), fun hc => absurd hc (by decide)⟩

end Stacks.LocalCohomology

end
