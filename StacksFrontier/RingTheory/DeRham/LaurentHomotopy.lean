module

public import Mathlib.Algebra.MonoidAlgebra.Module
public import Mathlib.Algebra.Polynomial.Laurent
public import StacksFrontier.LinearAlgebra.ExteriorPower.BaseChange
public import StacksFrontier.LinearAlgebra.ExteriorPower.Koszul
public import StacksFrontier.RingTheory.DeRham.PolynomialQuasiIso

/-!
# The de Rham complex of a Laurent polynomial algebra

Let `R` be a commutative ring, `A` an `R`-algebra and `A[T;T⁻¹]` the Laurent polynomial algebra
over `A`.  The module of relative differentials of `A[T;T⁻¹]` over `R`, and each of its exterior
powers, splits into a part pulled back from `A` and a part generated by the logarithmic
differential `dlog T = T⁻¹ dT`.

In degree one the splitting is `Ω[A[T;T⁻¹]⁄R] ≅ (A[T;T⁻¹] ⊗_A Ω[A⁄R]) ⊕ A[T;T⁻¹] dlog T`.  Its
two projections are the `dlog T`-component, the unique `A[T;T⁻¹]`-linear map sending `d g` to
`T ∂g/∂T`, and the coefficient component, the lift of the derivation `∑ aₙ Tⁿ ↦ ∑ Tⁿ ⊗ d aₙ`.

Since `A[T;T⁻¹] dlog T` is free of rank one, taking exterior powers gives, for every `p`,
`⋀^{p+1} Ω[A[T;T⁻¹]⁄R] ≅ (A[T;T⁻¹] ⊗_A ⋀^{p+1} Ω[A⁄R]) ⊕ (A[T;T⁻¹] ⊗_A ⋀^p Ω[A⁄R])`, the second
summand being `dlog T ∧ (−)`; in degree zero there is no `dlog T`-component and the splitting
degenerates to `⋀^0 Ω[A[T;T⁻¹]⁄R] ≅ A[T;T⁻¹] ⊗_A ⋀^0 Ω[A⁄R]`.

## Main definitions

* `LaurentPolynomial.eulerDerivation`: the derivation `T ∂/∂T` of `A[T;T⁻¹]` over `A`, sending
  `a Tⁿ` to `n a Tⁿ` for every integer `n`.
* `LaurentDeRham.dlogT`: the logarithmic differential `dlog T = T⁻¹ dT` of the variable.
* `LaurentDeRham.dlogProj`: the `dlog T`-component `Ω[A[T;T⁻¹]⁄R] → A[T;T⁻¹]` of a relative
  `1`-form.
* `LaurentDeRham.coeffDerivation` and `LaurentDeRham.coeffProj`: coefficientwise differentiation
  `∑ aₙ Tⁿ ↦ ∑ Tⁿ ⊗ d aₙ`, and the coefficient component `Ω[A[T;T⁻¹]⁄R] → A[T;T⁻¹] ⊗_A Ω[A⁄R]`
  of a relative `1`-form that it lifts to.
* `LaurentDeRham.kaehlerProdEquiv`: the degree-one splitting
  `Ω[A[T;T⁻¹]⁄R] ≅ (A[T;T⁻¹] ⊗_A Ω[A⁄R]) ⊕ A[T;T⁻¹] dlog T`.
* `LaurentDeRham.coeffProjPow` and `LaurentDeRham.mapBaseChangePow`: the exterior powers of the
  coefficient component and of the base-change inclusion.
* `LaurentDeRham.deRhamProdEquiv`: the splitting
  `⋀^{p+1} Ω[A[T;T⁻¹]⁄R] ≅ (A[T;T⁻¹] ⊗_A ⋀^{p+1} Ω[A⁄R]) ⊕ (A[T;T⁻¹] ⊗_A ⋀^p Ω[A⁄R])`, with
  `LaurentDeRham.deRhamProdZeroEquiv` the degenerate case `p = 0`.

## Main results

* `LaurentDeRham.D_T`: `d Tⁿ = n Tⁿ dlog T`, for every integer `n`.
* `LaurentDeRham.dlogProj_smul_dlogT` and `LaurentDeRham.dlogProj_map_incl`:
  `A[T;T⁻¹] dlog T` is a free rank-one summand of `Ω[A[T;T⁻¹]⁄R]`, complementary to the image
  of `Ω[A⁄R]`.
* `LaurentDeRham.coeffProj_mapBaseChange`: the coefficient component retracts
  `KaehlerDifferential.mapBaseChange`.
* `LaurentDeRham.mapBaseChange_coeffProj_add_dlogProj_smul`: a relative `1`-form is the sum of
  its coefficient component and its `dlog T`-component.
* `LaurentDeRham.mapBaseChangePow_coeffProjPow_add_wedgeLeft_contraction`: a relative form of
  positive degree is the sum of its coefficient part and `dlog T` wedged with its
  `dlog T`-contraction.

## References

* [Stacks Project, Tag 0FUF](https://stacks.math.columbia.edu/tag/0FUF), the local computation
  for the de Rham complex of a Laurent polynomial algebra
-/

open Function KaehlerDifferential LaurentPolynomial

open scoped TensorProduct

@[expose] public section

noncomputable section

universe u

namespace LaurentPolynomial

variable (A : Type u) [CommRing A]

/-- The Euler operator `T ∂/∂T` on Laurent polynomials, as an `A`-linear map: it multiplies the
coefficient of `Tⁿ` by `n`. -/
def eulerDerivMap : A[T;T⁻¹] →ₗ[A] A[T;T⁻¹] :=
  (Finsupp.lsum A fun n ↦ (n : ℤ) • AddMonoidAlgebra.lsingle (R := A) n) ∘ₗ
    (AddMonoidAlgebra.coeffLinearEquiv A).toLinearMap

/-- The Euler operator multiplies the coefficient of `Tⁿ` by the exponent `n`. -/
@[simp]
theorem eulerDerivMap_single (n : ℤ) (a : A) :
    eulerDerivMap A (.single n a) = n • (.single n a : A[T;T⁻¹]) := by
  rw [eulerDerivMap]
  simp only [LinearMap.coe_comp, comp_apply, LinearEquiv.coe_coe,
    AddMonoidAlgebra.coeffLinearEquiv_apply, AddMonoidAlgebra.coeff_single, Finsupp.lsum_single,
    LinearMap.smul_apply, AddMonoidAlgebra.lsingle_apply]

/-- The Euler derivation `T ∂/∂T` of a Laurent polynomial algebra over its ring of coefficients:
the `A`-derivation sending `a Tⁿ` to `n a Tⁿ`. -/
def eulerDerivation : Derivation A A[T;T⁻¹] A[T;T⁻¹] where
  toLinearMap := eulerDerivMap A
  map_one_eq_zero' := by
    rw [← single_zero_one_eq_one, eulerDerivMap_single]
    simp
  leibniz' p q := by
    induction p using LaurentPolynomial.induction_on' with
    | add p p' hp hp' =>
        rw [add_mul, map_add, hp, hp', map_add, smul_add, add_smul]
        abel
    | C_mul_T m a =>
      induction q using LaurentPolynomial.induction_on' with
      | add q q' hq hq' =>
          rw [mul_add, map_add, hq, hq', map_add, smul_add, add_smul]
          abel
      | C_mul_T n b =>
          rw [← single_eq_C_mul_T, ← single_eq_C_mul_T, AddMonoidAlgebra.single_mul_single,
            eulerDerivMap_single, eulerDerivMap_single, eulerDerivMap_single,
            smul_comm (.single m a : A[T;T⁻¹]), smul_comm (.single n b : A[T;T⁻¹]),
            smul_eq_mul, smul_eq_mul, AddMonoidAlgebra.single_mul_single,
            AddMonoidAlgebra.single_mul_single, mul_comm b a, add_comm n m, add_smul]
          exact add_comm _ _

/-- The Euler derivation sends the monomial `a Tⁿ` to `n a Tⁿ`. -/
@[simp]
theorem eulerDerivation_single (n : ℤ) (a : A) :
    eulerDerivation A (.single n a) = n • (.single n a : A[T;T⁻¹]) :=
  eulerDerivMap_single A n a

/-- The Euler derivation sends `a Tⁿ` to `n a Tⁿ`, the monomial written as a product. -/
@[simp]
theorem eulerDerivation_C_mul_T (n : ℤ) (a : A) :
    eulerDerivation A (C a * T n) = n • (C a * T n) := by
  rw [← single_eq_C_mul_T, eulerDerivation_single]

/-- The Euler derivation multiplies a power of the variable by its exponent. -/
@[simp]
theorem eulerDerivation_T (n : ℤ) : eulerDerivation A (T n) = n • (T n : A[T;T⁻¹]) := by
  rw [T, eulerDerivation_single]

/-- The Euler derivation kills the constants. -/
@[simp]
theorem eulerDerivation_C (a : A) : eulerDerivation A (C a) = 0 := by
  rw [← single_eq_C, eulerDerivation_single]
  simp

/-- The product of two Laurent monomials is the monomial on the sum of their exponents. -/
theorem C_mul_T_mul_C_mul_T (m n : ℤ) (a b : A) :
    (C a * T m : A[T;T⁻¹]) * (C b * T n) = C (a * b) * T (m + n) := by
  rw [← single_eq_C_mul_T, ← single_eq_C_mul_T, ← single_eq_C_mul_T,
    AddMonoidAlgebra.single_mul_single]

end LaurentPolynomial

namespace LaurentDeRham

variable (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]

/-! ### The logarithmic differential of the variable -/

/-- The logarithmic differential `dlog T = T⁻¹ dT` of the variable of a Laurent polynomial
algebra.  It generates a free rank-one summand of `Ω[A[T;T⁻¹]⁄R]`. -/
def dlogT : Ω[A[T;T⁻¹]⁄R] := (T (-1) : A[T;T⁻¹]) • D R A[T;T⁻¹] (T 1)

/-- Powers of the variable act on differentials through their product. -/
theorem T_smul_T_smul (m n : ℤ) (ω : Ω[A[T;T⁻¹]⁄R]) :
    (T m : A[T;T⁻¹]) • (T n : A[T;T⁻¹]) • ω = (T (m + n) : A[T;T⁻¹]) • ω := by
  rw [smul_smul, ← T_add]

/-- The logarithmic differential becomes `dT` after multiplication by `T`. -/
@[simp]
theorem T_smul_dlogT : (T 1 : A[T;T⁻¹]) • dlogT R A = D R A[T;T⁻¹] (T 1) := by
  rw [dlogT, T_smul_T_smul]
  norm_num

/-- The differential of `T⁻¹` is `-T⁻¹ dlog T`. -/
theorem D_T_neg_one :
    D R A[T;T⁻¹] (T (-1)) = -((T (-1) : A[T;T⁻¹]) • dlogT R A) := by
  have h : (T (-1) : A[T;T⁻¹]) * T 1 = 1 := by rw [← T_add]; norm_num
  rw [(D R A[T;T⁻¹]).leibniz_of_mul_eq_one h, ← T_smul_dlogT, T_pow, neg_smul, T_smul_T_smul]
  norm_num

/-- The differential of a power of the variable is `d Tⁿ = n Tⁿ dlog T`, for every integer `n`. -/
theorem D_T (n : ℤ) :
    D R A[T;T⁻¹] (T n) = n • ((T n : A[T;T⁻¹]) • dlogT R A) := by
  induction n using Int.induction_on with
  | zero => simp
  | succ i hi =>
      have h1 : (T ((i : ℤ) + 1) : A[T;T⁻¹]) = T i * T 1 := T_add _ _
      calc D R A[T;T⁻¹] (T ((i : ℤ) + 1))
          = (T i : A[T;T⁻¹]) • D R A[T;T⁻¹] (T 1) +
              (T 1 : A[T;T⁻¹]) • D R A[T;T⁻¹] (T i) := by rw [h1, Derivation.leibniz]
        _ = ((i : ℤ) + 1) • ((T ((i : ℤ) + 1) : A[T;T⁻¹]) • dlogT R A) := by
            rw [hi, ← T_smul_dlogT, T_smul_T_smul, smul_comm (T 1 : A[T;T⁻¹]), T_smul_T_smul,
              add_comm (1 : ℤ) (i : ℤ), add_smul, one_smul]
            exact add_comm _ _
  | pred i hi =>
      have h2 : (T (-(i : ℤ) - 1) : A[T;T⁻¹]) = T (-i) * T (-1) := T_sub _ _
      calc D R A[T;T⁻¹] (T (-(i : ℤ) - 1))
          = (T (-i) : A[T;T⁻¹]) • D R A[T;T⁻¹] (T (-1)) +
              (T (-1) : A[T;T⁻¹]) • D R A[T;T⁻¹] (T (-i)) := by rw [h2, Derivation.leibniz]
        _ = (-(i : ℤ) - 1) • ((T (-(i : ℤ) - 1) : A[T;T⁻¹]) • dlogT R A) := by
            rw [hi, D_T_neg_one, smul_neg, T_smul_T_smul, smul_comm (T (-1) : A[T;T⁻¹]),
              T_smul_T_smul, add_comm (-1 : ℤ) (-(i : ℤ)), ← sub_eq_add_neg, sub_smul, one_smul]
            exact neg_add_eq_sub _ _

/-- On differentials the inclusion of the coefficients sends `d a` to `d a`, the differential of
the corresponding constant Laurent polynomial. -/
@[simp]
theorem map_incl_D (a : A) :
    map R R A A[T;T⁻¹] (D R A a) = D R A[T;T⁻¹] (C a) := by
  rw [map_D, ← C_eq_algebraMap]

/-! ### The two components of a relative `1`-form -/

/-- The `dlog T`-component of a relative `1`-form: the unique `A[T;T⁻¹]`-linear map
`Ω[A[T;T⁻¹]⁄R] → A[T;T⁻¹]` sending `d g` to `T ∂g/∂T`.  It splits off the free rank-one summand
`A[T;T⁻¹] dlog T` of `Ω[A[T;T⁻¹]⁄R]`. -/
def dlogProj : Ω[A[T;T⁻¹]⁄R] →ₗ[A[T;T⁻¹]] A[T;T⁻¹] :=
  ((eulerDerivation A).restrictScalars R).liftKaehlerDifferential

/-- The `dlog T`-component of the differential of `g` is `T ∂g/∂T`. -/
@[simp]
theorem dlogProj_D (q : A[T;T⁻¹]) : dlogProj R A (D R A[T;T⁻¹] q) = eulerDerivation A q :=
  Derivation.congr_fun (Derivation.liftKaehlerDifferential_comp _) q

/-- The `dlog T`-component of `dlog T` itself is `1`. -/
@[simp]
theorem dlogProj_dlogT : dlogProj R A (dlogT R A) = 1 := by
  rw [dlogT, map_smul, dlogProj_D, eulerDerivation_T, smul_eq_mul, one_smul, ← T_add]
  norm_num

/-- The `dlog T`-component of a form pulled back from `Ω[A⁄R]` vanishes. -/
@[simp]
theorem dlogProj_map_incl (ω : Ω[A⁄R]) : dlogProj R A (map R R A A[T;T⁻¹] ω) = 0 := by
  refine LinearMap.congr_fun (LinearMap.ext_on (span_range_derivation R A)
    (f := (dlogProj R A).restrictScalars A ∘ₗ map R R A A[T;T⁻¹]) (g := 0) ?_) ω
  rintro _ ⟨a, rfl⟩
  simp

/-- `g ↦ g dlog T` is split by the `dlog T`-component, so `A[T;T⁻¹] dlog T` is a free rank-one
summand of `Ω[A[T;T⁻¹]⁄R]`. -/
@[simp]
theorem dlogProj_smul_dlogT (g : A[T;T⁻¹]) : dlogProj R A (g • dlogT R A) = g := by
  rw [map_smul, dlogProj_dlogT, smul_eq_mul, mul_one]

/-- Differentiation of the coefficients of a Laurent polynomial, as an `R`-linear map:
`∑ aₙ Tⁿ ↦ ∑ Tⁿ ⊗ d aₙ`. -/
def coeffDerivationMap : A[T;T⁻¹] →ₗ[R] A[T;T⁻¹] ⊗[A] Ω[A⁄R] :=
  (Finsupp.lsum R fun n ↦
      ((TensorProduct.mk A A[T;T⁻¹] (Ω[A⁄R]) (T n)).restrictScalars R).comp
        (D R A).toLinearMap) ∘ₗ
    (AddMonoidAlgebra.coeffLinearEquiv R).toLinearMap

/-- Coefficientwise differentiation sends the monomial `a Tⁿ` to `Tⁿ ⊗ d a`. -/
@[simp]
theorem coeffDerivationMap_single (n : ℤ) (a : A) :
    coeffDerivationMap R A (.single n a) = (T n : A[T;T⁻¹]) ⊗ₜ[A] D R A a := by
  rw [coeffDerivationMap]
  simp only [LinearMap.coe_comp, comp_apply, LinearEquiv.coe_coe,
    AddMonoidAlgebra.coeffLinearEquiv_apply, AddMonoidAlgebra.coeff_single, Finsupp.lsum_single,
    LinearMap.coe_restrictScalars, Derivation.coeFn_coe, TensorProduct.mk_apply]

/-- Coefficientwise differentiation sends the monomial `a Tⁿ` to `Tⁿ ⊗ d a`. -/
@[simp]
theorem coeffDerivationMap_C_mul_T (n : ℤ) (a : A) :
    coeffDerivationMap R A (C a * T n) = (T n : A[T;T⁻¹]) ⊗ₜ[A] D R A a := by
  rw [← single_eq_C_mul_T, coeffDerivationMap_single]

/-- Differentiation of the coefficients of a Laurent polynomial: the `R`-derivation
`A[T;T⁻¹] → A[T;T⁻¹] ⊗[A] Ω[A⁄R]` sending `∑ aₙ Tⁿ` to `∑ Tⁿ ⊗ d aₙ`. -/
def coeffDerivation : Derivation R A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) where
  toLinearMap := coeffDerivationMap R A
  map_one_eq_zero' := by
    rw [← single_zero_one_eq_one, coeffDerivationMap_single]
    simp
  leibniz' p q := by
    induction p using LaurentPolynomial.induction_on' with
    | add p p' hp hp' =>
        rw [add_mul, map_add, hp, hp', map_add, smul_add, add_smul]
        abel
    | C_mul_T m a =>
      induction q using LaurentPolynomial.induction_on' with
      | add q q' hq hq' =>
          rw [mul_add, map_add, hq, hq', map_add, smul_add, add_smul]
          abel
      | C_mul_T n b =>
          rw [C_mul_T_mul_C_mul_T, coeffDerivationMap_C_mul_T, coeffDerivationMap_C_mul_T,
            coeffDerivationMap_C_mul_T, Derivation.leibniz, TensorProduct.tmul_add,
            TensorProduct.tmul_smul, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
            TensorProduct.smul_tmul', TensorProduct.smul_tmul', TensorProduct.smul_tmul',
            smul_eq_C_mul, smul_eq_C_mul, smul_eq_mul, smul_eq_mul, mul_T_assoc, mul_T_assoc,
            add_comm n m]

/-- The derivation of coefficientwise differentiation sends `a Tⁿ` to `Tⁿ ⊗ d a`. -/
@[simp]
theorem coeffDerivation_single (n : ℤ) (a : A) :
    coeffDerivation R A (.single n a) = (T n : A[T;T⁻¹]) ⊗ₜ[A] D R A a :=
  coeffDerivationMap_single R A n a

/-- Coefficientwise differentiation sends `a Tⁿ` to `Tⁿ ⊗ d a`, the monomial written as a
product. -/
@[simp]
theorem coeffDerivation_C_mul_T (n : ℤ) (a : A) :
    coeffDerivation R A (C a * T n) = (T n : A[T;T⁻¹]) ⊗ₜ[A] D R A a := by
  rw [← single_eq_C_mul_T, coeffDerivation_single]

/-- Coefficientwise differentiation sends a constant `a` to `1 ⊗ d a`. -/
@[simp]
theorem coeffDerivation_C (a : A) :
    coeffDerivation R A (C a) = (1 : A[T;T⁻¹]) ⊗ₜ[A] D R A a := by
  rw [← single_eq_C, coeffDerivation_single, T_zero]

/-- Coefficientwise differentiation kills the powers of the variable. -/
@[simp]
theorem coeffDerivation_T (n : ℤ) : coeffDerivation R A (T n) = 0 := by
  rw [T, coeffDerivation_single]
  simp

/-- The coefficient component of a relative `1`-form: the unique `A[T;T⁻¹]`-linear map
`Ω[A[T;T⁻¹]⁄R] → A[T;T⁻¹] ⊗[A] Ω[A⁄R]` sending `d g` to `∑ Tⁿ ⊗ d gₙ`.  It retracts
`KaehlerDifferential.mapBaseChange` and kills `dlog T`. -/
def coeffProj : Ω[A[T;T⁻¹]⁄R] →ₗ[A[T;T⁻¹]] A[T;T⁻¹] ⊗[A] Ω[A⁄R] :=
  (coeffDerivation R A).liftKaehlerDifferential

/-- The coefficient component of the differential of `g` is the coefficientwise differential
of `g`. -/
@[simp]
theorem coeffProj_D (q : A[T;T⁻¹]) : coeffProj R A (D R A[T;T⁻¹] q) = coeffDerivation R A q :=
  Derivation.congr_fun (Derivation.liftKaehlerDifferential_comp _) q

/-- The coefficient component of `dlog T` vanishes. -/
@[simp]
theorem coeffProj_dlogT : coeffProj R A (dlogT R A) = 0 := by
  rw [dlogT, map_smul, coeffProj_D, coeffDerivation_T, smul_zero]

/-- The coefficient component of a form pulled back from `Ω[A⁄R]` is that form tensored with
`1`. -/
@[simp]
theorem coeffProj_map (ω : Ω[A⁄R]) :
    coeffProj R A (map R R A A[T;T⁻¹] ω) = (1 : A[T;T⁻¹]) ⊗ₜ[A] ω := by
  refine LinearMap.congr_fun (LinearMap.ext_on (span_range_derivation R A)
    (f := (coeffProj R A).restrictScalars A ∘ₗ map R R A A[T;T⁻¹])
    (g := TensorProduct.mk A A[T;T⁻¹] (Ω[A⁄R]) 1) ?_) ω
  rintro _ ⟨a, rfl⟩
  simp

/-- A linear map out of `Ω[A[T;T⁻¹]⁄R]` is determined on the image of `mapBaseChange` by its
values on forms pulled back from `Ω[A⁄R]`. -/
private theorem apply_mapBaseChange {M : Type*} [AddCommGroup M] [Module A[T;T⁻¹] M]
    (f : Ω[A[T;T⁻¹]⁄R] →ₗ[A[T;T⁻¹]] M) (h : A[T;T⁻¹] ⊗[A] Ω[A⁄R] →ₗ[A[T;T⁻¹]] M)
    (hf : ∀ ω, f (map R R A A[T;T⁻¹] ω) = h ((1 : A[T;T⁻¹]) ⊗ₜ[A] ω))
    (ξ : A[T;T⁻¹] ⊗[A] Ω[A⁄R]) : f (mapBaseChange R A A[T;T⁻¹] ξ) = h ξ := by
  induction ξ using TensorProduct.inductionOn with
  | tmul g ω =>
      rw [mapBaseChange_tmul, map_smul, hf, ← map_smul, TensorProduct.smul_tmul', smul_eq_mul,
        mul_one]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]

/-- The coefficient component retracts the base change map
`A[T;T⁻¹] ⊗[A] Ω[A⁄R] → Ω[A[T;T⁻¹]⁄R]`, so the latter is a split monomorphism. -/
@[simp]
theorem coeffProj_mapBaseChange (ξ : A[T;T⁻¹] ⊗[A] Ω[A⁄R]) :
    coeffProj R A (mapBaseChange R A A[T;T⁻¹] ξ) = ξ :=
  apply_mapBaseChange R A _ LinearMap.id (by simp) ξ

/-- The `dlog T`-component of a form coming from `A[T;T⁻¹] ⊗[A] Ω[A⁄R]` vanishes. -/
@[simp]
theorem dlogProj_mapBaseChange (ξ : A[T;T⁻¹] ⊗[A] Ω[A⁄R]) :
    dlogProj R A (mapBaseChange R A A[T;T⁻¹] ξ) = 0 :=
  apply_mapBaseChange R A _ 0 (by simp) ξ

/-- The splitting identity on the generators `d q` of `Ω[A[T;T⁻¹]⁄R]`. -/
private theorem mapBaseChange_coeffDerivation (q : A[T;T⁻¹]) :
    mapBaseChange R A A[T;T⁻¹] (coeffDerivation R A q) +
        eulerDerivation A q • dlogT R A = D R A[T;T⁻¹] q := by
  induction q using LaurentPolynomial.induction_on' with
  | add p q hp hq =>
      rw [map_add (D R A[T;T⁻¹]) p q, ← hp, ← hq]
      simp only [map_add, add_smul]
      abel
  | C_mul_T n a =>
      rw [← single_eq_C_mul_T, coeffDerivation_single, eulerDerivation_single,
        mapBaseChange_tmul, map_incl_D, smul_assoc, single_eq_C_mul_T, Derivation.leibniz, D_T,
        smul_comm (C a : A[T;T⁻¹]) ((n : ℤ)), smul_smul, ← single_eq_C_mul_T]
      exact add_comm _ _

/-- Every relative `1`-form of `A[T;T⁻¹]` over `R` is the sum of its coefficient component and
its `dlog T`-component. -/
theorem mapBaseChange_coeffProj_add_dlogProj_smul (ω : Ω[A[T;T⁻¹]⁄R]) :
    mapBaseChange R A A[T;T⁻¹] (coeffProj R A ω) + dlogProj R A ω • dlogT R A = ω := by
  refine LinearMap.congr_fun (LinearMap.ext_on (span_range_derivation R A[T;T⁻¹])
    (f := (mapBaseChange R A A[T;T⁻¹]).comp (coeffProj R A) +
      (LinearMap.toSpanSingleton A[T;T⁻¹] (Ω[A[T;T⁻¹]⁄R]) (dlogT R A)).comp (dlogProj R A))
    (g := LinearMap.id) ?_) ω
  rintro _ ⟨q, rfl⟩
  simpa using mapBaseChange_coeffDerivation R A q

/-- **The degree-one splitting** `Ω[A[T;T⁻¹]⁄R] ≅ (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) ⊕ A[T;T⁻¹] dlog T`: a
relative `1`-form of `A[T;T⁻¹]` over `R` is determined by its coefficient component and its
`dlog T`-component, and these may be prescribed independently. -/
def kaehlerProdEquiv :
    Ω[A[T;T⁻¹]⁄R] ≃ₗ[A[T;T⁻¹]] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) × A[T;T⁻¹] :=
  LinearEquiv.ofLinearMap ((coeffProj R A).prod (dlogProj R A))
    ((mapBaseChange R A A[T;T⁻¹]).comp
        (LinearMap.fst A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹]) +
      (LinearMap.toSpanSingleton A[T;T⁻¹] (Ω[A[T;T⁻¹]⁄R]) (dlogT R A)).comp
        (LinearMap.snd A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹]))
    (LinearMap.ext fun x ↦ Prod.ext (by
        simp [LinearMap.toSpanSingleton_apply]) (by
        simp [LinearMap.toSpanSingleton_apply]))
    (LinearMap.ext fun ω ↦ by
      simpa [LinearMap.toSpanSingleton_apply] using
        mapBaseChange_coeffProj_add_dlogProj_smul R A ω)

/-- The splitting sends a relative `1`-form to the pair of its two components. -/
@[simp]
theorem kaehlerProdEquiv_apply (ω : Ω[A[T;T⁻¹]⁄R]) :
    kaehlerProdEquiv R A ω = (coeffProj R A ω, dlogProj R A ω) := rfl

/-- The inverse of the splitting sends a pair `(ξ, g)` to `ξ + g dlog T`. -/
@[simp]
theorem kaehlerProdEquiv_symm_apply (ξ : A[T;T⁻¹] ⊗[A] Ω[A⁄R]) (g : A[T;T⁻¹]) :
    (kaehlerProdEquiv R A).symm (ξ, g) =
      mapBaseChange R A A[T;T⁻¹] ξ + g • dlogT R A := rfl

/-! ### The splitting of the exterior powers -/

/-- The coefficient component of a relative `p`-form of `A[T;T⁻¹]` over `R`: the `p`-th exterior
power of `LaurentDeRham.coeffProj`. -/
def coeffProjPow (p : ℕ) :
    ⋀[A[T;T⁻¹]]^p (Ω[A[T;T⁻¹]⁄R]) →ₗ[A[T;T⁻¹]] ⋀[A[T;T⁻¹]]^p (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) :=
  exteriorPower.map p (coeffProj R A)

/-- The base-change inclusion in degree `p`: the `p`-th exterior power of
`KaehlerDifferential.mapBaseChange`. -/
def mapBaseChangePow (p : ℕ) :
    ⋀[A[T;T⁻¹]]^p (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) →ₗ[A[T;T⁻¹]] ⋀[A[T;T⁻¹]]^p (Ω[A[T;T⁻¹]⁄R]) :=
  exteriorPower.map p (mapBaseChange R A A[T;T⁻¹])

/-- The coefficient component retracts the base-change inclusion in every degree. -/
theorem coeffProjPow_comp_mapBaseChangePow (p : ℕ) :
    coeffProjPow R A p ∘ₗ mapBaseChangePow R A p = LinearMap.id := by
  rw [coeffProjPow, mapBaseChangePow, ← exteriorPower.map_comp,
    show (coeffProj R A) ∘ₗ (mapBaseChange R A A[T;T⁻¹]) = LinearMap.id from
      LinearMap.ext (coeffProj_mapBaseChange R A), exteriorPower.map_id]

/-- A `dlog T`-free form has vanishing `dlog T`-contraction. -/
theorem contraction_comp_mapBaseChangePow (p : ℕ) :
    exteriorPower.contraction (dlogProj R A) p ∘ₗ mapBaseChangePow R A (p + 1) = 0 :=
  exteriorPower.contraction_comp_map _ _ (LinearMap.ext (dlogProj_mapBaseChange R A)) p

/-- Contracting against the `dlog T`-component undoes wedging by `dlog T` on `dlog T`-free
forms. -/
theorem contraction_wedgeLeft_mapBaseChangePow (p : ℕ) :
    exteriorPower.contraction (dlogProj R A) p ∘ₗ
        exteriorPower.wedgeLeft (dlogT R A) p ∘ₗ mapBaseChangePow R A p =
      mapBaseChangePow R A p :=
  exteriorPower.contraction_comp_wedgeLeft_comp_map _ _ _ (dlogProj_dlogT R A)
    (LinearMap.ext (dlogProj_mapBaseChange R A)) p

/-- A `dlog T`-free form of degree `p` is recovered from its coefficient component. -/
theorem coeffProjPow_mapBaseChangePow (p : ℕ)
    (y : ↥(⋀[A[T;T⁻¹]]^p (A[T;T⁻¹] ⊗[A] Ω[A⁄R]))) :
    coeffProjPow R A p (mapBaseChangePow R A p y) = y :=
  LinearMap.congr_fun (coeffProjPow_comp_mapBaseChangePow R A p) y

/-- Contracting a `dlog T`-free form against the `dlog T`-component gives zero. -/
theorem contraction_mapBaseChangePow (p : ℕ)
    (y : ↥(⋀[A[T;T⁻¹]]^(p + 1) (A[T;T⁻¹] ⊗[A] Ω[A⁄R]))) :
    exteriorPower.contraction (dlogProj R A) p (mapBaseChangePow R A (p + 1) y) = 0 :=
  LinearMap.congr_fun (contraction_comp_mapBaseChangePow R A p) y

/-- Wedging a `dlog T`-free form by `dlog T` and contracting again recovers the form. -/
theorem contraction_wedgeLeft_mapBaseChangePow_apply (p : ℕ)
    (y : ↥(⋀[A[T;T⁻¹]]^p (A[T;T⁻¹] ⊗[A] Ω[A⁄R]))) :
    exteriorPower.contraction (dlogProj R A) p
        (exteriorPower.wedgeLeft (dlogT R A) p (mapBaseChangePow R A p y)) =
      mapBaseChangePow R A p y :=
  LinearMap.congr_fun (contraction_wedgeLeft_mapBaseChangePow R A p) y

/-- The first component of the degree-one splitting is the coefficient component. -/
theorem fst_comp_kaehlerProdEquiv :
    LinearMap.fst A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹] ∘ₗ
        (kaehlerProdEquiv R A).toLinearMap = coeffProj R A := rfl

/-- The second component of the degree-one splitting is the `dlog T`-component. -/
theorem snd_comp_kaehlerProdEquiv :
    LinearMap.snd A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹] ∘ₗ
        (kaehlerProdEquiv R A).toLinearMap = dlogProj R A := rfl

/-- The splitting identifies the first summand with the image of the base-change inclusion. -/
theorem kaehlerProdEquiv_symm_comp_inl :
    (kaehlerProdEquiv R A).symm.toLinearMap ∘ₗ
        LinearMap.inl A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹] =
      mapBaseChange R A A[T;T⁻¹] :=
  LinearMap.ext fun ξ ↦ by simp [kaehlerProdEquiv_symm_apply]

/-- The splitting identifies the generator of the second summand with `dlog T`. -/
theorem kaehlerProdEquiv_symm_zero_one :
    (kaehlerProdEquiv R A).symm.toLinearMap
        ((0, 1) : (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) × A[T;T⁻¹]) = dlogT R A := by
  change (kaehlerProdEquiv R A).symm (0, 1) = _
  rw [kaehlerProdEquiv_symm_apply]
  simp

/-- **The splitting of the exterior powers of `Ω[A[T;T⁻¹]⁄R]`**:
`⋀^{p+1} Ω[A[T;T⁻¹]⁄R] ≅ (A[T;T⁻¹] ⊗_A ⋀^{p+1} Ω[A⁄R]) ⊕ (A[T;T⁻¹] ⊗_A ⋀^p Ω[A⁄R])`.  The first
component is the coefficient component and the second is the `dlog T`-component. -/
def deRhamProdEquiv (p : ℕ) :
    ⋀[A[T;T⁻¹]]^(p + 1) (Ω[A[T;T⁻¹]⁄R]) ≃ₗ[A[T;T⁻¹]]
      (A[T;T⁻¹] ⊗[A] ↥(⋀[A]^(p + 1) (Ω[A⁄R]))) × (A[T;T⁻¹] ⊗[A] ↥(⋀[A]^p (Ω[A⁄R]))) :=
  (exteriorPower.mapEquiv (kaehlerProdEquiv R A) (p + 1)).trans
    ((exteriorPower.prodRightEquiv A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) p).trans
      ((ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) (p + 1)).symm.prodCongr
        (ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) p).symm))

/-- In degree zero the splitting is `⋀^0 Ω[A[T;T⁻¹]⁄R] ≅ A[T;T⁻¹] ⊗_A ⋀^0 Ω[A⁄R]`: there is no
`dlog T`-component. -/
def deRhamProdZeroEquiv :
    ⋀[A[T;T⁻¹]]^0 (Ω[A[T;T⁻¹]⁄R]) ≃ₗ[A[T;T⁻¹]] A[T;T⁻¹] ⊗[A] ↥(⋀[A]^0 (Ω[A⁄R])) :=
  (exteriorPower.mapEquiv (kaehlerProdEquiv R A) 0).trans
    ((exteriorPower.prodRightZeroEquiv A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R])).trans
      (ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) 0).symm)

/-- The splitting of the exterior powers sends a form to its coefficient part and the
coefficient part of its `dlog T`-contraction. -/
@[simp]
theorem deRhamProdEquiv_apply (p : ℕ) (x : ↥(⋀[A[T;T⁻¹]]^(p + 1) (Ω[A[T;T⁻¹]⁄R]))) :
    deRhamProdEquiv R A p x =
      ((ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) (p + 1)).symm
          (coeffProjPow R A (p + 1) x),
        (ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) p).symm
          (coeffProjPow R A p (exteriorPower.contraction (dlogProj R A) p x))) := by
  have h1 : exteriorPower.map (p + 1)
      (LinearMap.fst A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹])
      (exteriorPower.map (p + 1) (kaehlerProdEquiv R A).toLinearMap x) =
      coeffProjPow R A (p + 1) x := by
    rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, fst_comp_kaehlerProdEquiv, coeffProjPow]
  have h2 : exteriorPower.map p (LinearMap.fst A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹])
      (exteriorPower.contraction (LinearMap.snd A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹]) p
        (exteriorPower.map (p + 1) (kaehlerProdEquiv R A).toLinearMap x)) =
      coeffProjPow R A p (exteriorPower.contraction (dlogProj R A) p x) := by
    rw [← LinearMap.comp_apply (exteriorPower.contraction _ p),
      exteriorPower.contraction_comp_map', snd_comp_kaehlerProdEquiv, LinearMap.comp_apply,
      ← LinearMap.comp_apply, ← exteriorPower.map_comp, fst_comp_kaehlerProdEquiv, coeffProjPow]
  rw [← h1, ← h2]
  rfl

/-- The inverse of the splitting of the exterior powers sends `(ζ, η)` to `ζ + dlog T ∧ η`,
both summands pulled back from `A`. -/
@[simp]
theorem deRhamProdEquiv_symm_apply (p : ℕ)
    (ζ : A[T;T⁻¹] ⊗[A] ↥(⋀[A]^(p + 1) (Ω[A⁄R]))) (η : A[T;T⁻¹] ⊗[A] ↥(⋀[A]^p (Ω[A⁄R]))) :
    (deRhamProdEquiv R A p).symm (ζ, η) =
      mapBaseChangePow R A (p + 1)
          (ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) (p + 1) ζ) +
        exteriorPower.wedgeLeft (dlogT R A) p (mapBaseChangePow R A p
          (ExteriorAlgebra.exteriorPowerBaseChange A A[T;T⁻¹] (Ω[A⁄R]) p η)) := by
  have key (y : ↥(⋀[A[T;T⁻¹]]^(p + 1) (A[T;T⁻¹] ⊗[A] Ω[A⁄R])))
      (z : ↥(⋀[A[T;T⁻¹]]^p (A[T;T⁻¹] ⊗[A] Ω[A⁄R]))) :
      exteriorPower.map (p + 1) (kaehlerProdEquiv R A).symm.toLinearMap
        (exteriorPower.map (p + 1)
            (LinearMap.inl A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹]) y +
          exteriorPower.wedgeLeft ((0, 1) : (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) × A[T;T⁻¹]) p
            (exteriorPower.map p
              (LinearMap.inl A[T;T⁻¹] (A[T;T⁻¹] ⊗[A] Ω[A⁄R]) A[T;T⁻¹]) z)) =
        mapBaseChangePow R A (p + 1) y +
          exteriorPower.wedgeLeft (dlogT R A) p (mapBaseChangePow R A p z) := by
    rw [map_add]
    congr 1
    · rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, kaehlerProdEquiv_symm_comp_inl,
        mapBaseChangePow]
    · rw [← LinearMap.comp_apply, exteriorPower.map_comp_wedgeLeft', LinearMap.comp_apply,
        kaehlerProdEquiv_symm_zero_one]
      congr 1
      rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, kaehlerProdEquiv_symm_comp_inl,
        mapBaseChangePow]
  exact key _ _

/-- In degree zero every relative form is `dlog T`-free. -/
theorem mapBaseChangePow_comp_coeffProjPow_zero :
    mapBaseChangePow R A 0 ∘ₗ coeffProjPow R A 0 = LinearMap.id := by
  refine exteriorPower.linearMap_ext (AlternatingMap.ext fun v ↦ ?_)
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.coe_comp, comp_apply,
    coeffProjPow, mapBaseChangePow, exteriorPower.map_apply_ιMulti, LinearMap.id_coe, id_eq]
  congr 1
  funext i
  exact i.elim0

/-- A relative form of degree zero is recovered from its coefficient component. -/
theorem mapBaseChangePow_coeffProjPow_zero (x : ↥(⋀[A[T;T⁻¹]]^0 (Ω[A[T;T⁻¹]⁄R]))) :
    mapBaseChangePow R A 0 (coeffProjPow R A 0 x) = x :=
  LinearMap.congr_fun (mapBaseChangePow_comp_coeffProjPow_zero R A) x

/-- A relative form of positive degree is its coefficient part plus `dlog T` wedged with the
coefficient part of its `dlog T`-contraction. -/
private theorem mapBaseChangePow_add_wedgeLeft_mapBaseChangePow (p : ℕ)
    (x : ↥(⋀[A[T;T⁻¹]]^(p + 1) (Ω[A[T;T⁻¹]⁄R]))) :
    mapBaseChangePow R A (p + 1) (coeffProjPow R A (p + 1) x) +
        exteriorPower.wedgeLeft (dlogT R A) p (mapBaseChangePow R A p
          (coeffProjPow R A p (exteriorPower.contraction (dlogProj R A) p x))) = x := by
  have hsplit := (deRhamProdEquiv R A p).symm_apply_apply x
  rwa [deRhamProdEquiv_apply, deRhamProdEquiv_symm_apply, LinearEquiv.apply_symm_apply,
    LinearEquiv.apply_symm_apply] at hsplit

/-- The `dlog T`-contraction of a relative form is `dlog T`-free. -/
theorem mapBaseChangePow_coeffProjPow_contraction (p : ℕ)
    (x : ↥(⋀[A[T;T⁻¹]]^(p + 1) (Ω[A[T;T⁻¹]⁄R]))) :
    mapBaseChangePow R A p
        (coeffProjPow R A p (exteriorPower.contraction (dlogProj R A) p x)) =
      exteriorPower.contraction (dlogProj R A) p x := by
  have h := congrArg (exteriorPower.contraction (dlogProj R A) p)
    (mapBaseChangePow_add_wedgeLeft_mapBaseChangePow R A p x)
  rwa [map_add, contraction_mapBaseChangePow, contraction_wedgeLeft_mapBaseChangePow_apply,
    zero_add] at h

/-- Every relative form of positive degree is the sum of its coefficient part and `dlog T`
wedged with its `dlog T`-contraction. -/
theorem mapBaseChangePow_coeffProjPow_add_wedgeLeft_contraction (p : ℕ)
    (x : ↥(⋀[A[T;T⁻¹]]^(p + 1) (Ω[A[T;T⁻¹]⁄R]))) :
    mapBaseChangePow R A (p + 1) (coeffProjPow R A (p + 1) x) +
        exteriorPower.wedgeLeft (dlogT R A) p
          (exteriorPower.contraction (dlogProj R A) p x) = x := by
  rw [← mapBaseChangePow_coeffProjPow_contraction R A p x]
  exact mapBaseChangePow_add_wedgeLeft_mapBaseChangePow R A p x

end LaurentDeRham

