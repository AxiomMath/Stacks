module

public import StacksFrontier.RingTheory.DeRham.LogPolesWedge

/-!
# The log forms are the maps from the equation ideal into the forms vanishing on the divisor

Let `A → R` be a ring map and let `t ∈ R` cut out the effective Cartier divisor
`Y = Spec (R ⧸ (t))` in `X = Spec R`. Write `𝒦^p` for the forms vanishing on the divisor, that
is for the kernel of the restriction `⋀^p Ω[R⁄A] → ⋀^p_{R ⧸ (t)} Ω[R ⧸ (t)⁄A]`. Stacks Tag 0FMW
describes the forms with a logarithmic pole along `Y` as

`Ω^p_{X/S}(log Y) = Hom_{𝒪_X}(ℐ, 𝒦^p)`,

and this file proves that description for `ℐ = (t)`: the `R`-linear maps from the ideal `(t)` to
`𝒦^p` are the log forms `Stacks.LogPoles.logFormsR`, equivalently the degree-`p` term
`Stacks.LogPoles.logFormsX` of the complex of Tag 0FMW.

Both halves are multiplication by `t`. A map out of the principal ideal generated by a
nonzerodivisor is its value at the generator, so `Hom_R((t), 𝒦^p)` is `𝒦^p`; and `𝒦^p` is `t`
times the log forms, because `t · (ω + dlog t ∧ η) = t ω + dt ∧ η` is
`Stacks.LogPoles.logMulT`, whose image is the logarithmic submodule
`Stacks.LogPoles.logSubmodule` and hence the kernel of restriction. Composing, the log form
attached to `φ : (t) → 𝒦^p` is `t⁻¹ φ(t)`. The only assumption is that `t` is a nonzerodivisor
on `R`.

## Main definitions

* `Stacks.LogPoles.homSpanSingletonEquiv`: an `R`-linear map out of the ideal generated by a
  nonzerodivisor is its value at the generator.
* `Stacks.LogPoles.logFormsRKerEquiv`: **multiplication by `t` identifies the log forms with the
  forms vanishing on the divisor**, as `R`-modules.
* `Stacks.LogPoles.logMulTX` and `Stacks.LogPoles.logFormsXKerEquiv`: the same identification for
  the terms of the complex of Tag 0FMW, as `A`-modules.
* `Stacks.LogPoles.homIdealEquivLogFormsR` and `Stacks.LogPoles.homIdealEquivLogFormsX`:
  **Stacks Tag 0FMW's local description**, that `Hom_R((t), 𝒦^p)` is the module of log forms,
  over `R` and over `A` respectively.

## Main results

* `Stacks.LogPoles.range_logPairMap` and `Stacks.LogPoles.range_logMulT`: the image of
  multiplication by `t` is the kernel of restriction to the divisor, in every degree.
* `Stacks.LogPoles.injective_logMulT`: multiplication by `t` is injective on the log forms.
* `Stacks.LogPoles.logMulTX_zero_apply` and `Stacks.LogPoles.logMulTX_succ_apply`: the `A`-linear
  multiplication by `t` has the formula of the `R`-linear one.
* `Stacks.LogPoles.homIdealEquivLogFormsR_symm_apply_coe` and
  `Stacks.LogPoles.homIdealEquivLogFormsX_symm_apply_coe`: the identification read in the other
  direction, the value at `t` of the map attached to a log form `α` is `t α`.

## References

* [Stacks Project, Tag 0FMW](https://stacks.math.columbia.edu/tag/0FMW)
* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS), the local equation of an
  effective Cartier divisor
-/

@[expose] public noncomputable section

open CategoryTheory KaehlerDifferential

universe u

namespace Stacks.LogPoles

variable {A R : Type u} [CommRing A] [CommRing R] [Algebra A R]

/-! ### Maps out of a principal ideal -/

/-- Multiplication by `t` is injective on the degree-zero forms as soon as it is injective on
`R`, the degree-zero forms being a copy of `R`. -/
theorem isSMulRegular_exteriorPower_zero {M : Type u} [AddCommGroup M] [Module R M] {t : R}
    (ht : IsSMulRegular R t) : IsSMulRegular (↥(⋀[R]^0 M)) t := by
  intro a b hab
  refine (exteriorPower.zeroEquiv R M).injective (ht ?_)
  simpa only [map_smul] using congrArg (exteriorPower.zeroEquiv R M) hab

/-- The ideal generated by a nonzerodivisor is free of rank one on the generator. -/
def spanSingletonSelfEquiv {t : R} (ht : IsSMulRegular R t) :
    ↥(Ideal.span {t}) ≃ₗ[R] R :=
  (LinearEquiv.ofEq _ _ (LinearMap.span_singleton_eq_range R R t)).trans
    (LinearEquiv.ofInjective (LinearMap.toSpanSingleton R R t) (by
      intro a b hab
      simp only [LinearMap.toSpanSingleton_apply, smul_eq_mul] at hab
      refine ht ?_
      simp only [smul_eq_mul, mul_comm t]
      exact hab)).symm

/-- **An `R`-linear map out of the ideal generated by a nonzerodivisor is its value at the
generator.** -/
def homSpanSingletonEquiv {t : R} (ht : IsSMulRegular R t) (M : Type u) [AddCommGroup M]
    [Module R M] : (↥(Ideal.span {t}) →ₗ[R] M) ≃ₗ[R] M :=
  (LinearEquiv.arrowCongr (spanSingletonSelfEquiv ht) (LinearEquiv.refl R M)).trans
    (LinearMap.ringLmapEquivSelf R R M)

/-- `Stacks.LogPoles.homSpanSingletonEquiv` sends a map `φ` to its value `φ t` at the
generator `t`. -/
@[simp]
theorem homSpanSingletonEquiv_apply {t : R} (ht : IsSMulRegular R t) (M : Type u)
    [AddCommGroup M] [Module R M] (φ : ↥(Ideal.span {t}) →ₗ[R] M) :
    homSpanSingletonEquiv ht M φ = φ ⟨t, Ideal.mem_span_singleton_self t⟩ := by
  show φ ((spanSingletonSelfEquiv ht).symm 1) = _
  refine congrArg φ (Subtype.ext ?_)
  simp [spanSingletonSelfEquiv, LinearMap.toSpanSingleton_apply]

/-! ### The forms vanishing on the divisor are `t` times the log forms -/

/-- **The image of multiplication by `t` on the pair model is the kernel of restriction to the
divisor.** Here a pair `(ω, η)` goes to `t ω + dt ∧ η`. -/
theorem range_logPairMap (t : R) (p : ℕ) :
    LinearMap.range (logPairMap A t p) =
      LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) (p + 1)) := by
  rw [ker_mapExteriorPower_quotient_succ, logSubmodule_span_singleton]
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · rintro _ ⟨x, rfl⟩
    exact Submodule.add_mem _
      (Submodule.mem_sup_right (Submodule.smul_mem_smul
        (Ideal.mem_span_singleton_self t) Submodule.mem_top))
      (Submodule.mem_sup_left ⟨x.2, rfl⟩)
  · rintro _ ⟨η, rfl⟩
    refine ⟨(0, η), ?_⟩
    show t • (0 : ⋀[R]^(p + 1) (Ω[R⁄A])) +
      exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p η = _
    rw [smul_zero, zero_add]
  · refine Submodule.smul_le.mpr fun a ha ω _ ↦ ?_
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    refine ⟨(c • ω, 0), ?_⟩
    show t • (c • ω) + exteriorPower.wedgeLeft (KaehlerDifferential.D A R t) p 0 = _
    rw [map_zero, add_zero, smul_smul, mul_comm]

/-- **The image of multiplication by `t` on the log forms is the kernel of restriction to the
divisor**, in every degree. -/
theorem range_logMulT (t : R) (p : ℕ) :
    LinearMap.range (logMulT A t p) =
      LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) p) := by
  cases p with
  | zero =>
      rw [ker_mapExteriorPower_quotient_zero]
      refine le_antisymm ?_ (Submodule.smul_le.mpr fun a ha ω _ ↦ ?_)
      · rintro _ ⟨ω, rfl⟩
        exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self t) Submodule.mem_top
      · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
        refine ⟨c • ω, ?_⟩
        show t • (c • ω) = (c * t) • ω
        rw [smul_smul, mul_comm]
  | succ q =>
      rw [← range_logPairMap (A := A) t q]
      exact Submodule.range_liftQ _ _ _

/-- **Multiplication by `t` is injective on the log forms.** -/
theorem injective_logMulT {t : R} (ht : IsSMulRegular R t) (p : ℕ) :
    Function.Injective (logMulT A t p) := by
  cases p with
  | zero => exact isSMulRegular_exteriorPower_zero ht
  | succ q => exact LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot _ _ _ le_rfl)

/-- **Multiplication by `t` identifies the log forms with the forms vanishing on the divisor.**
A log form `ω + dlog t ∧ η` goes to `t ω + dt ∧ η`, a form with no pole whose restriction to the
divisor vanishes, and every such form arises exactly once this way. -/
def logFormsRKerEquiv {t : R} (ht : IsSMulRegular R t) (p : ℕ) :
    logFormsR A t p ≃ₗ[R]
      ↥(LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) p)) :=
  (LinearEquiv.ofInjective (logMulT A t p) (injective_logMulT ht p)).trans
    (LinearEquiv.ofEq _ _ (range_logMulT t p))

/-- The form underlying the image of a log form `α` under `Stacks.LogPoles.logFormsRKerEquiv` is
`t α`. -/
@[simp]
theorem logFormsRKerEquiv_apply_coe {t : R} (ht : IsSMulRegular R t) (p : ℕ)
    (α : logFormsR A t p) :
    (logFormsRKerEquiv ht p α : ⋀[R]^p (Ω[R⁄A])) = logMulT A t p α := rfl

/-! ### The same identification for the terms of the complex -/

/-- Multiplication by `t`, out of the degree-`p` term of the complex of Stacks Tag 0FMW: the
`A`-linear map with the same formula as the `R`-linear `Stacks.LogPoles.logMulT`. -/
def logMulTX (A : Type u) [CommRing A] [Algebra A R] (t : R) :
    (p : ℕ) → (logFormsX A t p →ₗ[A] ⋀[R]^p (Ω[R⁄A]))
  | 0 => (t • (LinearMap.id : ⋀[R]^0 (Ω[R⁄A]) →ₗ[R] ⋀[R]^0 (Ω[R⁄A]))).restrictScalars A
  | p + 1 => Submodule.liftQ _ ((logPairMap A t p).restrictScalars A) fun _ hx ↦ hx

/-- In degree zero, `Stacks.LogPoles.logMulTX` is multiplication by `t`. -/
@[simp]
theorem logMulTX_zero_apply (t : R) (ω : ⋀[R]^0 (Ω[R⁄A])) :
    logMulTX A t 0 ω = t • ω := rfl

/-- In positive degree, `Stacks.LogPoles.logMulTX` sends the class of a pair `(ω, η)` to
`t ω + dt ∧ η`. -/
@[simp]
theorem logMulTX_succ_apply (t : R) (p : ℕ)
    (x : ⋀[R]^(p + 1) (Ω[R⁄A]) × ⋀[R]^p (Ω[R⁄A])) :
    logMulTX A t (p + 1)
        (Submodule.Quotient.mk (p := Submodule.restrictScalars A (logRel A t p)) x) =
      logPairMap A t p x := rfl

/-- The image of the `A`-linear multiplication by `t` is the kernel of restriction to the
divisor, as an `A`-submodule. -/
theorem range_logMulTX (t : R) (p : ℕ) :
    LinearMap.range (logMulTX A t p) =
      Submodule.restrictScalars A
        (LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) p)) := by
  rw [← range_logMulT (A := A) t p]
  cases p <;> rfl

/-- Multiplication by `t` is injective on the terms of the complex of Stacks Tag 0FMW. -/
theorem injective_logMulTX {t : R} (ht : IsSMulRegular R t) (p : ℕ) :
    Function.Injective (logMulTX A t p) := by
  cases p with
  | zero => exact injective_logMulT ht 0
  | succ q => exact injective_logMulT ht (q + 1)

/-- **Multiplication by `t` identifies the degree-`p` term of the complex of Stacks Tag 0FMW with
the forms vanishing on the divisor**, as `A`-modules. -/
def logFormsXKerEquiv {t : R} (ht : IsSMulRegular R t) (p : ℕ) :
    logFormsX A t p ≃ₗ[A]
      ↥(LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) p)) :=
  (LinearEquiv.ofInjective (logMulTX A t p) (injective_logMulTX ht p)).trans
    (LinearEquiv.ofEq _ _ (range_logMulTX t p))

/-- The form underlying the image of `α` under `Stacks.LogPoles.logFormsXKerEquiv` is `t α`. -/
@[simp]
theorem logFormsXKerEquiv_apply_coe {t : R} (ht : IsSMulRegular R t) (p : ℕ)
    (α : logFormsX A t p) :
    (logFormsXKerEquiv ht p α : ⋀[R]^p (Ω[R⁄A])) = logMulTX A t p α := rfl

/-! ### The local description of Stacks Tag 0FMW -/

/-- **Stacks Tag 0FMW's local description of the forms with a logarithmic pole.** For `t` a
nonzerodivisor cutting out the divisor, the `R`-linear maps from the ideal `(t)` to the forms
`𝒦^p` vanishing on the divisor are the log forms of degree `p`: a map `φ` is read as the log form
`t⁻¹ φ(t)`. -/
def homIdealEquivLogFormsR {t : R} (ht : IsSMulRegular R t) (p : ℕ) :
    (↥(Ideal.span {t}) →ₗ[R]
        ↥(LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) p)))
      ≃ₗ[R] logFormsR A t p :=
  (homSpanSingletonEquiv ht _).trans (logFormsRKerEquiv ht p).symm

/-- The identification read in the other direction: the map out of the ideal attached to a log
form `α` takes at `t` the value `Stacks.LogPoles.logFormsRKerEquiv ht p α`. -/
theorem homIdealEquivLogFormsR_symm_apply {t : R} (ht : IsSMulRegular R t) (p : ℕ)
    (α : logFormsR A t p) :
    ((homIdealEquivLogFormsR ht p).symm α) ⟨t, Ideal.mem_span_singleton_self t⟩ =
      logFormsRKerEquiv ht p α :=
  Eq.trans (homSpanSingletonEquiv_apply ht _ _).symm
    ((homSpanSingletonEquiv ht _).apply_symm_apply _)

/-- The value at `t` of the map out of the ideal attached to a log form `α`, read among the forms
with no pole, is `t α`. -/
theorem homIdealEquivLogFormsR_symm_apply_coe {t : R} (ht : IsSMulRegular R t) (p : ℕ)
    (α : logFormsR A t p) :
    (((homIdealEquivLogFormsR ht p).symm α) ⟨t, Ideal.mem_span_singleton_self t⟩ :
        ⋀[R]^p (Ω[R⁄A])) = logMulT A t p α := by
  rw [homIdealEquivLogFormsR_symm_apply, logFormsRKerEquiv_apply_coe]

/-- **Stacks Tag 0FMW's local description, as `A`-modules**: the `R`-linear maps from the ideal
`(t)` to the forms vanishing on the divisor are the degree-`p` term
`Stacks.LogPoles.logFormsX` of the complex of log poles. -/
def homIdealEquivLogFormsX {t : R} (ht : IsSMulRegular R t) (p : ℕ) :
    (↥(Ideal.span {t}) →ₗ[R]
        ↥(LinearMap.ker (KaehlerDifferential.mapExteriorPower A R (R ⧸ Ideal.span {t}) p)))
      ≃ₗ[A] logFormsX A t p :=
  ((homSpanSingletonEquiv ht _).restrictScalars A).trans (logFormsXKerEquiv ht p).symm

/-- The `A`-linear identification read in the other direction: the map out of the ideal attached
to a term `α` of the complex of Stacks Tag 0FMW takes at `t` the value
`Stacks.LogPoles.logFormsXKerEquiv ht p α`. -/
theorem homIdealEquivLogFormsX_symm_apply {t : R} (ht : IsSMulRegular R t) (p : ℕ)
    (α : logFormsX A t p) :
    ((homIdealEquivLogFormsX ht p).symm α) ⟨t, Ideal.mem_span_singleton_self t⟩ =
      logFormsXKerEquiv ht p α :=
  Eq.trans (homSpanSingletonEquiv_apply ht _ _).symm
    ((homSpanSingletonEquiv ht _).apply_symm_apply _)

/-- The value at `t` of the map out of the ideal attached to a term `α` of the complex of Stacks
Tag 0FMW, read among the forms with no pole, is `t α`. -/
theorem homIdealEquivLogFormsX_symm_apply_coe {t : R} (ht : IsSMulRegular R t) (p : ℕ)
    (α : logFormsX A t p) :
    (((homIdealEquivLogFormsX ht p).symm α) ⟨t, Ideal.mem_span_singleton_self t⟩ :
        ⋀[R]^p (Ω[R⁄A])) = logMulTX A t p α := by
  rw [homIdealEquivLogFormsX_symm_apply, logFormsXKerEquiv_apply_coe]

end Stacks.LogPoles

end
