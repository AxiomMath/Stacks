/-!
# Freeness modulo a nilpotent ideal: the multiplication maps

The basic objects for the freeness criterion modulo a nilpotent ideal `I`: the submodule `IM`
and the reduction `M → M/IM`, the multiplication maps `I ⊗_R M → M` and `I^k ⊗_R M → M`,
the coordinate projections, flat base change, the exactness of the tensored columns and rows
used in the snake-lemma arguments, and the `R ⧸ I`-module structure on an `I`-torsion module.
-/

@[expose] public section

namespace Stacks.FreeOfNilpotentIdeal

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- **Definition 2.** The submodule `IM ⊆ M`, i.e. `I • (⊤ : Submodule R M)`, the
submodule generated by all products `a • m` with `a ∈ I` and `m ∈ M`. The quotient
`M ⧸ smul I M` is the module `M/IM`; it carries a canonical `(R ⧸ I)`-module
structure (`inferInstance`). -/
@[ega "0 4.1.6" "special case"]
abbrev smul (I : Ideal R) : Submodule R M := I • (⊤ : Submodule R M)

/-- The canonical reduction map `M → M/IM`. -/
abbrev reduction (I : Ideal R) : M →ₗ[R] (M ⧸ smul (M := M) I) :=
  Submodule.mkQ _

/-- **Definition 4 (multiplication map).** The `R`-linear multiplication map
`I ⊗_R M → M`, `a ⊗ m ↦ a • m`. By the long exact sequence for `Tor`, the
canonical identification of `Tor₁^R(R/I, M)` with the kernel of this map shows that
`Tor₁^R(R/I, M) = 0` is equivalent to the injectivity of this map. -/
noncomputable def torMul (I : Ideal R) : TensorProduct R I M →ₗ[R] M :=
  TensorProduct.lift ((LinearMap.lsmul R M).comp I.subtype)

/-- `torMul` sends `a ⊗ m` to `a • m`. -/
@[simp]
theorem torMul_tmul (I : Ideal R) (a : I) (m : M) :
    torMul I (TensorProduct.tmul R a m) = (a : R) • m := by
  simp [torMul, LinearMap.lsmul_apply]

/-- **Nakayama for nilpotent ideals (no finiteness needed).**
If `I` is nilpotent and `M = N + I·M` (i.e. `⊤ ≤ N ⊔ I • ⊤`), then `N = M`.

*Argument.* Since `I` is nilpotent, `I ^ n = ⊥` for some `n`. From `⊤ = N ⊔ I • ⊤`
one shows by induction on `k` that `⊤ = N ⊔ I ^ k • ⊤`: the base case `k = 0` is
`I ^ 0 • ⊤ = ⊤`; for the step, substitute the hypothesis `⊤ = N ⊔ I • ⊤` into
`I ^ k • ⊤` using `Submodule.smul_sup`, `Submodule.smul_le_right`,
`Submodule.pow_succ`/`Submodule.mul_smul` and absorb `I ^ k • N ≤ N`. At `k = n`
we get `⊤ = N ⊔ (⊥ : Submodule) = N`. Unlike the standard Nakayama this needs no
`N.FG` hypothesis, which is essential here since the index set `A` is arbitrary. -/
@[sga "3 III 3.3" "Footnote (67)",
  sga "3 III 4.6.4" "more general",
  sga "3 VIB 6.2.2" "cokernel vanishing",
  sga "3 VIII 6.2" "nilpotent Nakayama step"]
theorem eq_top_of_isNilpotent_of_le_sup_smul
    (I : Ideal R) (hI : IsNilpotent I) (N : Submodule R M)
    (h : (⊤ : Submodule R M) ≤ N ⊔ I • (⊤ : Submodule R M)) :
    N = ⊤ := by
  -- STRATEGY: obtain ⟨n, hn⟩ := hI (with hn : I ^ n = 0 = ⊥); prove
  --   `key : ∀ k, (⊤ : Submodule R M) ≤ N ⊔ (I ^ k) • ⊤` by induction on k;
  -- then specialize at k = n, rewrite `I ^ n = ⊥`, `Submodule.bot_smul`, `sup_bot_eq`.
  -- Induction step uses: I^(k+1)•⊤ = I•(I^k•⊤) ≤ I•⊤, and the hypothesis h to
  -- replace ⊤ inside; algebraically `N ⊔ I^(k+1)•⊤ = N ⊔ I•(N ⊔ I^k•⊤) ... ⊇ ⊤`.
  -- The load-bearing inclusion `I•(N ⊔ J) ≤ N ⊔ I•J` compiles via
  -- `Submodule.smul_sup` + `Submodule.smul_le_right`.
  obtain ⟨n, hn⟩ := hI
  have key : ∀ k, (⊤ : Submodule R M) ≤ N ⊔ (I ^ k) • (⊤ : Submodule R M) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
        refine ih.trans ?_
        rw [pow_succ, Submodule.mul_smul]
        have step : I ^ k • (⊤ : Submodule R M) ≤ N ⊔ I ^ k • (I • (⊤ : Submodule R M)) := by
          calc I ^ k • (⊤ : Submodule R M)
              ≤ I ^ k • (N ⊔ I • (⊤ : Submodule R M)) := Submodule.smul_mono le_rfl h
            _ = I ^ k • N ⊔ I ^ k • (I • (⊤ : Submodule R M)) := Submodule.smul_sup _ _ _
            _ ≤ N ⊔ I ^ k • (I • (⊤ : Submodule R M)) :=
                sup_le_sup_right (Submodule.smul_le_right) _
        exact sup_le le_sup_left (step.trans (sup_le_sup_left le_rfl _))
  have hfin := key n
  rw [hn, Ideal.zero_eq_bot, Submodule.bot_smul, sup_bot_eq] at hfin
  exact top_le_iff.mp hfin

/-- The reductions `x̄_α` generate `M/IM`, hence `span R (range x) ⊔ IM = ⊤`.
This is the "generating mod `I`" input to Nakayama.

*Argument.* `b` is a basis of `M/IM`, so `span_{R/I} (range b) = ⊤`, and a fortiori
`span_R (range b) = ⊤` (a generating set over `R/I` is generating over `R` via the
quotient ring map, by `Submodule.span_eq_top_of_span_eq_top` for the scalar tower
`R → R/I`). Since `b α = reduction I (x α) = (smul I).mkQ (x α)`, we have
`range b = (smul I).mkQ '' (range x)`, so `span_R ((smul I).mkQ '' range x) = ⊤`.
By `Submodule.map_span`, `map (smul I).mkQ (span R (range x)) = ⊤`, and then
`Submodule.map_mkQ_eq_top` gives `(smul I) ⊔ span R (range x) = ⊤`, i.e.
`span R (range x) ⊔ smul I = ⊤`. -/
@[sga "3 VIII 6.2" "lifts generate modulo IM"]
theorem span_sup_smul_eq_top_of_basis
    {A : Type*} (x : A → M) (I : Ideal R)
    (b : Module.Basis A (R ⧸ I) (M ⧸ smul (M := M) I))
    (hb : ∀ α, b α = reduction I (x α)) :
    (⊤ : Submodule R M) ≤ Submodule.span R (Set.range x) ⊔ smul (M := M) I := by
  -- STRATEGY: from `b.span_eq : span (R⧸I) (range b) = ⊤`, push to `span R (range b) = ⊤`
  -- (scalar tower R → R⧸I, `Submodule.span_eq_top_of_span_eq_top`). Rewrite
  -- `range b = (reduction I) '' (range x)` from hb (Set.range_comp / Set.image_eq_range).
  -- Then `Submodule.map_span` turns `span R ((reduction I) '' range x)` into
  -- `Submodule.map (reduction I) (span R (range x))`; conclude with
  -- `Submodule.map_mkQ_eq_top` (reduction I = (smul I).mkQ) and rewrite the sup order.
  -- range b = reduction I '' range x
  have hrange : Set.range (⇑b) = (reduction I) '' (Set.range x) := by
    rw [← Set.range_comp]
    congr 1
    funext α
    exact hb α
  -- span R (range b) = ⊤
  have hsurj : Function.Surjective ⇑(algebraMap R (R ⧸ I)) := Ideal.Quotient.mk_surjective
  have hspanR : Submodule.span R (Set.range (⇑b)) = ⊤ := by
    have := Submodule.restrictScalars_span R (R ⧸ I) hsurj (Set.range (⇑b))
    rw [b.span_eq] at this
    rw [← this]
    rfl
  -- map (reduction I) (span R (range x)) = ⊤
  have hmap : Submodule.map (reduction I) (Submodule.span R (Set.range x)) = ⊤ := by
    rw [Submodule.map_span, ← hrange, hspanR]
  -- conclude
  rw [top_le_iff, sup_comm]
  exact (Submodule.map_mkQ_eq_top (smul I) _).mp hmap

/-- Compatibility of the `R`-action with the `R/J`-action on the quotient `M/(J • ⊤)`:
`r • y = (Quotient.mk J r) • y`. (The quotient module `M ⧸ (J • ⊤)` is `J`-torsion, so its
`R`-module structure factors through `R/J`.) -/
theorem mk_smul_quot (J : Ideal R) (r : R) (y : M ⧸ (J • (⊤ : Submodule R M))) :
    r • y = (Ideal.Quotient.mk J r) • y :=
  Eq.symm (Module.IsTorsionBySet.mk_smul (Module.isTorsionBySet_quotient_ideal_smul M J) r y)

/-- **Multiplication map `μ^{(k)} : I^k ⊗_R M → M`,** `a ⊗ m ↦ a • m` (the `I^k`-analogue of
`torMul`). Its image is `I^kM`. -/
noncomputable def mulPow (I : Ideal R) (k : ℕ) :
    TensorProduct R (I ^ k : Ideal R) M →ₗ[R] M :=
  TensorProduct.lift ((LinearMap.lsmul R M).comp (I ^ k : Ideal R).subtype)

/-- `mulPow` sends `a ⊗ m` to `a • m`. -/
@[simp]
theorem mulPow_tmul (I : Ideal R) (k : ℕ) (a : (I ^ k : Ideal R)) (m : M) :
    mulPow (M := M) I k (TensorProduct.tmul R a m) = (a : R) • m := by
  simp [mulPow, LinearMap.lsmul_apply]

/-- The `R`-linear "graded multiplication" map sending `ā ∈ I^k/I^{k+1}` (here represented
by an element `a : I^k`) and `c̄ ∈ R/I` to `ac mod I^{k+1} ∈ R/I^{k+1}`. This is the scalar
ingredient of the coordinate projection `coordProj`; it is well-defined on `R/I` in the
second variable because `a ∈ I^k`, so `a·I ⊆ I^{k+1}`. -/
noncomputable def mulMapL (I : Ideal R) (k : ℕ) :
    (I ^ k : Ideal R) →ₗ[R] ((R ⧸ I) →ₗ[R] (R ⧸ I ^ (k + 1))) where
  toFun a := Submodule.liftQ I
    ((Ideal.Quotient.mkₐ R (I ^ (k + 1))).toLinearMap.comp (LinearMap.mulLeft R (a : R))) (by
      intro c hc
      simp only [LinearMap.mem_ker, LinearMap.coe_comp, Function.comp_apply,
        AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk, LinearMap.mulLeft_apply,
        Ideal.Quotient.eq_zero_iff_mem]
      rw [pow_succ]
      exact Ideal.mul_mem_mul a.property hc)
  map_add' a a' := by
    refine LinearMap.ext fun y => ?_
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective I y
    simp only [LinearMap.add_apply, Submodule.liftQ_apply, LinearMap.coe_comp,
      Function.comp_apply, LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply,
      Ideal.Quotient.mkₐ_eq_mk, Submodule.coe_add]
    rw [← map_add]
    congr 1
    ring
  map_smul' c a := by
    refine LinearMap.ext fun y => ?_
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective I y
    simp only [LinearMap.smul_apply, RingHom.id_apply, Submodule.liftQ_apply, LinearMap.coe_comp,
      Function.comp_apply, LinearMap.mulLeft_apply, AlgHom.toLinearMap_apply,
      Ideal.Quotient.mkₐ_eq_mk, SetLike.val_smul, smul_eq_mul]
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul]
    congr 1
    ring

/-- `mulMapL` sends the class of `r` in `R/I` to the class of `a * r` in `R/I^{k+1}`. -/
theorem mulMapL_apply_mk (I : Ideal R) (k : ℕ) (a : (I ^ k : Ideal R)) (r : R) :
    mulMapL I k a (Ideal.Quotient.mk I r) = Ideal.Quotient.mk (I ^ (k + 1)) ((a : R) * r) := rfl

/-- **The coordinate projection `p_k : I^k ⊗_R M → (A →₀ R/I^{k+1})`,** sending `a ⊗ m` to
the family `α ↦ ā · (b.repr m̄)_α` where `m̄ ∈ M/IM` is expressed in the basis `b`. This is
the basis coordinatization of the graded projection
`I^k⊗M ↠ (I^k/I^{k+1})⊗_{R/I}(M/IM) ≅ (A →₀ I^k/I^{k+1})`, landing in `A →₀ R/I^{k+1}`,
the `I^k/I^{k+1}` part. -/
noncomputable def coordProj {A : Type*} (I : Ideal R)
    (b : Module.Basis A (R ⧸ I) (M ⧸ smul (M := M) I)) (k : ℕ) :
    TensorProduct R (I ^ k : Ideal R) M →ₗ[R] (A →₀ (R ⧸ I ^ (k + 1))) :=
  TensorProduct.lift
    { toFun := fun a =>
        (Finsupp.mapRange.linearMap (mulMapL I k a)).comp
          ((b.repr.toLinearMap.restrictScalars R).comp (reduction I))
      map_add' a a' := by ext m α; simp
      map_smul' c a := by ext m α; simp }

/-- The `α`-component of `coordProj` applied to `a ⊗ m` is the class of `a` times the
`α`-coordinate of the reduction of `m` in the basis `b`. -/
theorem coordProj_tmul {A : Type*} (I : Ideal R)
    (b : Module.Basis A (R ⧸ I) (M ⧸ smul (M := M) I)) (k : ℕ)
    (a : (I ^ k : Ideal R)) (m : M) (α : A) :
    coordProj I b k (TensorProduct.tmul R a m) α
      = mulMapL I k a (b.repr (reduction I m) α) := by
  simp [coordProj]

/-- If the scalar `a : I^k` actually lies in `I^{k+1}`, then `mulMapL I k a = 0`
(it sends `mk I r` to `mk (I^{k+1}) (a*r)` and `a*r ∈ I^{k+1}`). -/
theorem mulMapL_eq_zero_of_mem (I : Ideal R) (k : ℕ) (a : (I ^ k : Ideal R))
    (ha : (a : R) ∈ I ^ (k + 1)) : mulMapL I k a = 0 := by
  refine LinearMap.ext fun y => ?_
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [mulMapL_apply_mk, LinearMap.zero_apply, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mul_mem_right r _ ha

/-- The coordinate projection kills any simple tensor whose first factor lies in `I^{k+1}`
(its reduction in `I^k/I^{k+1}` is zero). -/
theorem coordProj_tmul_eq_zero_of_mem {A : Type*} (I : Ideal R)
    (b : Module.Basis A (R ⧸ I) (M ⧸ smul (M := M) I)) (k : ℕ)
    (a : (I ^ k : Ideal R)) (ha : (a : R) ∈ I ^ (k + 1)) (m : M) :
    coordProj I b k (TensorProduct.tmul R a m) = 0 := by
  refine Finsupp.ext fun α => ?_
  rw [coordProj_tmul, mulMapL_eq_zero_of_mem I k a ha, LinearMap.zero_apply, Finsupp.zero_apply]

/-- **Flat base change preserves injectivity of `rTensor`.**
Let `S = R ⧸ I`. If `(R⧸I) ⊗[R] Mod` (i.e. `Mod/IMod`) is flat as an `S`-module, then for any
injective `S`-linear map `φ : K →ₗ[S] F` between `S`-modules (regarded as `R`-modules via the
scalar tower along `R → S`), the induced `R`-linear map `rTensor Mod (φ.restrictScalars R)` is
injective.

*Proof.* By `cancelBaseChange`, `K ⊗[R] Mod ≃ K ⊗[S] ((R⧸I)⊗[R]Mod)` and similarly for `F`, and
under these isomorphisms `rTensor_R Mod (φ.restrictScalars R)` corresponds to
`rTensor_S ((R⧸I)⊗[R]Mod) φ`. The latter is injective because `(R⧸I)⊗[R]Mod` is `S`-flat and `φ` is
injective (`Module.Flat.rTensor_preserves_injective_linearMap`). Transporting along the isos gives
the claim. This is the key flatness ingredient of Stacks 051H (informal proof §3.4, Step 2). -/
theorem rTensor_injective_of_flat_baseChange
    (I : Ideal R) [Module.Flat (R ⧸ I) (TensorProduct R (R ⧸ I) M)]
    {K F : Type*} [AddCommGroup K] [Module (R ⧸ I) K] [Module R K] [IsScalarTower R (R ⧸ I) K]
    [AddCommGroup F] [Module (R ⧸ I) F] [Module R F] [IsScalarTower R (R ⧸ I) F]
    (φ : K →ₗ[R ⧸ I] F) (hφ : Function.Injective φ) :
    Function.Injective (LinearMap.rTensor M (φ.restrictScalars R)) := by
  have hflat_inj : Function.Injective (LinearMap.rTensor (TensorProduct R (R ⧸ I) M) φ) :=
    Module.Flat.rTensor_preserves_injective_linearMap φ hφ
  set eK := TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I) K M with heK
  set eF := TensorProduct.AlgebraTensorModule.cancelBaseChange R (R ⧸ I) (R ⧸ I) F M with heF
  have nat : ∀ z, (LinearMap.rTensor M (φ.restrictScalars R)) (eK z)
      = eF (LinearMap.rTensor (TensorProduct R (R ⧸ I) M) φ z) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul k y =>
        induction y using TensorProduct.inductionOn with
        | tmul s m =>
            simp only [heK, heF, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul,
              LinearMap.rTensor_tmul, LinearMap.coe_restrictScalars]
            rw [map_smul]
        | add y z hy hz =>
            rw [TensorProduct.tmul_add, map_add, map_add, hy, hz, map_add, map_add]
    | add z w hz hw => rw [map_add, map_add, hz, hw, map_add, map_add]
  intro a c hac
  obtain ⟨a', rfl⟩ := eK.surjective a
  obtain ⟨c', rfl⟩ := eK.surjective c
  rw [nat, nat] at hac
  have h3 := hflat_inj (eF.injective hac)
  rw [h3]

/-- Flatness of `(R ⧸ I) ⊗[R] M ≅ M/IM` as an `R ⧸ I`-module, given a basis `b` of `M/IM`.
`M/IM` is free on `b` (`Module.Free.of_basis`), hence flat (`Module.Flat.of_free`); the
`R`-linear iso `TensorProduct.quotTensorEquivQuotSMul` is upgraded to an `R ⧸ I`-linear
equivalence (the `R ⧸ I`-action factors through `R`), and flatness transports across it. -/
@[sga "3 VIII 6.2" "(a), special case"]
theorem flat_quotTensor_of_basis
    {A : Type*} (I : Ideal R)
    (b : Module.Basis A (R ⧸ I) (M ⧸ smul (M := M) I)) :
    Module.Flat (R ⧸ I) (TensorProduct R (R ⧸ I) M) := by
  have : Module.Free (R ⧸ I) (M ⧸ smul (M := M) I) := Module.Free.of_basis b
  have : Module.Flat (R ⧸ I) (M ⧸ smul (M := M) I) := Module.Flat.of_free
  have e : TensorProduct R (R ⧸ I) M ≃ₗ[R] M ⧸ smul (M := M) I :=
    TensorProduct.quotTensorEquivQuotSMul M I
  let e' : TensorProduct R (R ⧸ I) M ≃ₗ[R ⧸ I] M ⧸ smul (M := M) I :=
    { e with
      map_smul' := by
        intro c z
        induction c using Quotient.inductionOn with
        | _ r =>
          change e ((Ideal.Quotient.mk I r) • z) = (Ideal.Quotient.mk I r) • e z
          have h1 : (Ideal.Quotient.mk I r) • z = (algebraMap R (R ⧸ I) r) • z := by
            rw [Ideal.Quotient.algebraMap_eq]
          have h2 : (Ideal.Quotient.mk I r) • e z = (algebraMap R (R ⧸ I) r) • e z := by
            rw [Ideal.Quotient.algebraMap_eq]
          rw [h1, h2, algebraMap_smul, algebraMap_smul, map_smul] }
  exact Module.Flat.of_linearEquiv e'

/-- **(C-i) The `P`-column is left-injective for `R`-free `P`** (informal Sub-lemma 5′).
For an `R`-FREE module `P`, the map `lTensor P (torMul I) : P ⊗ (I ⊗ M) → P ⊗ M` is injective.

*Proof (elementary).* Choosing an `R`-basis of `P` identifies `P ⊗ (-)` with a direct sum
`(-)^{(Λ)}` (`finsuppScalarRight` after picking `Module.Free.chooseBasis`), turning `lTensor P τ`
into the direct sum `⨁ τ`. Each summand `τ = torMul I : I⊗M → M` is injective by `hTor`, and
a direct sum of injective maps is injective. (Equivalently: `Module.Flat.of_free P` makes
`P` flat, so
`P ⊗ (-)` preserves injectivity; but the orientation here is `lTensor`, so use
`Module.Flat.lTensor_preserves_injective_linearMap` with `[Module.Flat R P]` from
`Module.Flat.of_free`,
applied to the injective `torMul I`.) -/
theorem tor_one_quot_pColumn_injective
    (I : Ideal R) (hTor : Function.Injective (torMul (M := M) I))
    {P : Type*} [AddCommGroup P] [Module R P] [Module.Free R P] :
    Function.Injective (LinearMap.lTensor P (torMul (M := M) I)) := by
  -- `P` free ⇒ `P` flat (`Module.Flat.of_free`); flat ⇒ `lTensor P` preserves injectivity of the
  -- injective `torMul I` (`Module.Flat.lTensor_preserves_injective_linearMap`).
  have : Module.Flat R P := Module.Flat.of_free
  exact Module.Flat.lTensor_preserves_injective_linearMap (torMul (M := M) I) hTor

/-- The range of `torMul I : I ⊗ M → M` is exactly `IM = smul I`. (Helper for `(★)`.) -/
theorem range_torMul (I : Ideal R) :
    LinearMap.range (torMul (M := M) I) = smul (M := M) I := by
  apply le_antisymm
  · rintro _ ⟨u, rfl⟩
    induction u using TensorProduct.inductionOn with
    | tmul a m => rw [torMul_tmul]; exact Submodule.smul_mem_smul a.property trivial
    | add y z hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
  · rw [Submodule.smul_le]
    intro a ha m _
    exact ⟨TensorProduct.tmul R ⟨a, ha⟩ m, by simp⟩

/-- **(★) is a short exact sequence (exactness in the middle).**
`0 → I⊗M →[torMul I] M →[reduction I] M/IM → 0` is exact at `M`:
`range (torMul I) = ker (reduction I) = IM`. -/
theorem exact_torMul_reduction (I : Ideal R) :
    Function.Exact (torMul (M := M) I) (reduction (M := M) I) := by
  rw [LinearMap.exact_iff]
  change LinearMap.ker (Submodule.mkQ _) = LinearMap.range (torMul (M := M) I)
  rw [Submodule.ker_mkQ, range_torMul]

/-- **Commuting square `ρ ∘ jK = jP ∘ ρ_I`** (naturality of `lTensor τ` against `rTensor κ`):
for `κ : K →ₗ[R] P`,
`(rTensor M κ) ∘ (lTensor K (torMul I)) = (lTensor P (torMul I)) ∘ (rTensor (I⊗M) κ)`. -/
theorem square_rTensor_lTensor_torMul (I : Ideal R)
    {K P : Type*} [AddCommGroup K] [Module R K] [AddCommGroup P] [Module R P]
    (κ : K →ₗ[R] P) :
    (LinearMap.rTensor M κ) ∘ₗ (LinearMap.lTensor K (torMul (M := M) I))
      = (LinearMap.lTensor P (torMul (M := M) I)) ∘ₗ
          (LinearMap.rTensor (TensorProduct R I M) κ) := by
  rw [LinearMap.rTensor_comp_lTensor, LinearMap.lTensor_comp_rTensor]

/-- **Commuting square `cP ∘ ρ = ρ̄ ∘ cK`** (naturality of `lTensor π` against `rTensor κ`):
for `κ : K →ₗ[R] P`,
`(lTensor P (reduction I)) ∘ (rTensor M κ) = (rTensor (M/IM) κ) ∘ (lTensor K (reduction I))`. -/
theorem square_lTensor_reduction_rTensor (I : Ideal R)
    {K P : Type*} [AddCommGroup K] [Module R K] [AddCommGroup P] [Module R P]
    (κ : K →ₗ[R] P) :
    (LinearMap.lTensor P (reduction (M := M) I)) ∘ₗ (LinearMap.rTensor M κ)
      = (LinearMap.rTensor (M ⧸ smul (M := M) I) κ) ∘ₗ
          (LinearMap.lTensor K (reduction (M := M) I)) := by
  rw [LinearMap.lTensor_comp_rTensor, LinearMap.rTensor_comp_lTensor]

/-- **The `K`-column is right-exact:** `Function.Exact (lTensor K τ) (lTensor K π)`
(tensoring the right-exact `(★)` on the left by `K`). -/
theorem column_exact_lTensor (I : Ideal R)
    {K : Type*} [AddCommGroup K] [Module R K] :
    Function.Exact (LinearMap.lTensor K (torMul (M := M) I))
      (LinearMap.lTensor K (reduction (M := M) I)) :=
  lTensor_exact K (exact_torMul_reduction I) (Submodule.mkQ_surjective _)

/-- **The `K`-column right map `lTensor K π` is surjective.** -/
theorem column_surjective_lTensor (I : Ideal R)
    {K : Type*} [AddCommGroup K] [Module R K] :
    Function.Surjective (LinearMap.lTensor K (reduction (M := M) I)) :=
  LinearMap.lTensor_surjective K (Submodule.mkQ_surjective _)

/-- If `I • ⊤ = ⊥` in `N`, then every `a ∈ I` annihilates every `n : N`. -/
private theorem smul_eq_zero_of_mem_of_smul_eq_bot {N : Type*} [AddCommGroup N] [Module R N]
    (I : Ideal R) (hN : I • (⊤ : Submodule R N) = ⊥) {a : R} (ha : a ∈ I) (n : N) :
    a • n = 0 := by
  simpa [hN] using Submodule.smul_mem_smul ha (Submodule.mem_top : n ∈ ⊤)

/-- **(N-column, part 1)** If `I • N = ⊥` then the `N`-column left map `lTensor N τ`
(`= id_N ⊗ torMul I`) is the zero map: on `n ⊗ (a ⊗ m)` it is `n ⊗ (a • m) = (a • n) ⊗ m = 0`
because `a ∈ I` annihilates `N`. (Verified, reusable: this is the elementary content of
`N ⊗_S Tor₁^R(S,M) = 0` after the chase, and it makes the `N`-column reduction an iso.) -/
theorem lTensor_torMul_eq_zero_of_smul_eq_bot (I : Ideal R)
    {N : Type*} [AddCommGroup N] [Module R N]
    (hN : I • (⊤ : Submodule R N) = ⊥) :
    LinearMap.lTensor N (torMul (M := M) I) = 0 := by
  apply TensorProduct.ext'
  intro n u
  induction u using TensorProduct.inductionOn with
  | tmul a m =>
      rw [LinearMap.lTensor_tmul, torMul_tmul, LinearMap.zero_apply, TensorProduct.tmul_smul,
        TensorProduct.smul_tmul', smul_eq_zero_of_mem_of_smul_eq_bot I hN a.property n,
        TensorProduct.zero_tmul]
  | add u v hu hv =>
      rw [TensorProduct.tmul_add, map_add, hu, hv]
      simp

/-- **(N-column, part 2 / the `N`-column iso)** If `I • N = ⊥` then the `N`-column reduction map
`lTensor N π : N ⊗ M → N ⊗ M̄` is INJECTIVE (indeed an isomorphism). *Proof:* the `N`-column is
right-exact (`column_exact_lTensor`), so `ker (lTensor N π) = range (lTensor N τ)`, and the latter
is `range 0 = 0` by `lTensor_torMul_eq_zero_of_smul_eq_bot`. This is the precise sense in which
`I • N = ⊥` makes `c_N` an iso (informal proof §227 / Summary item 4); reusable in the snake tail.
-/
theorem lTensor_reduction_injective_of_smul_eq_bot (I : Ideal R)
    {N : Type*} [AddCommGroup N] [Module R N]
    (hN : I • (⊤ : Submodule R N) = ⊥) :
    Function.Injective (LinearMap.lTensor N (reduction (M := M) I)) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  have hker : z ∈ LinearMap.ker (LinearMap.lTensor N (reduction (M := M) I)) :=
    LinearMap.mem_ker.mpr hz
  rw [(column_exact_lTensor I (K := N)).linearMap_ker_eq] at hker
  obtain ⟨w, rfl⟩ := hker
  rw [lTensor_torMul_eq_zero_of_smul_eq_bot I hN, LinearMap.zero_apply]

/-- **Snake-input builder.** Given a morphism `v : L₁ ⟶ L₂` of short complexes in an abelian
category with both rows exact, `L₁.g` epi and `L₂.f` mono, assemble a `ShortComplex.SnakeInput`,
taking the zeroth and third rows to be the (categorical) kernel and cokernel of `v`. This is the
clean general entry point to the snake lemma `SnakeInput.snake_lemma` / connecting map `δ`; the
hard `IsLimit`/`IsColimit` data is supplied by the abelian-category `kernelIsKernel`/
`cokernelIsCokernel`. (Verified reusable; the categorical route for `tor_one_quot_ker_eq_bot`.) -/
noncomputable def mkSnakeInput {C : Type*} [CategoryTheory.Category C]
    [CategoryTheory.Abelian C]
    {L₁ L₂ : CategoryTheory.ShortComplex C} (v : L₁ ⟶ L₂)
    (h1 : L₁.Exact) (he : CategoryTheory.Epi L₁.g)
    (h2 : L₂.Exact) (hm : CategoryTheory.Mono L₂.f) :
    CategoryTheory.ShortComplex.SnakeInput C where
  L₀ := CategoryTheory.Limits.kernel v
  L₁ := L₁
  L₂ := L₂
  L₃ := CategoryTheory.Limits.cokernel v
  v₀₁ := CategoryTheory.Limits.kernel.ι v
  v₁₂ := v
  v₂₃ := CategoryTheory.Limits.cokernel.π v
  w₀₂ := CategoryTheory.Limits.kernel.condition v
  w₁₃ := CategoryTheory.Limits.cokernel.condition v
  h₀ := CategoryTheory.Limits.kernelIsKernel v
  h₃ := CategoryTheory.Limits.cokernelIsCokernel v
  L₁_exact := h1
  epi_L₁_g := he
  L₂_exact := h2
  mono_L₂_f := hm

/-- **An `I`-torsion `R`-module is torsion by the set `I`** (verified, reusable). If
`I • (⊤ : Submodule R N) = ⊥` then every `a ∈ I` annihilates every `n ∈ N`. This is the entry point
to the `R ⧸ I`-module structure on the I-torsion module `N` of the local criterion. -/
theorem isTorsionBySet_of_smul_eq_bot {N : Type*} [AddCommGroup N] [Module R N] (I : Ideal R)
    (hN : I • (⊤ : Submodule R N) = ⊥) : Module.IsTorsionBySet R N (I : Set R) := by
  intro n a
  exact smul_eq_zero_of_mem_of_smul_eq_bot I hN a.property n

/-- **The `R ⧸ I`-module structure on an `I`-torsion module `N`** (verified, reusable). Marked
`@[reducible]` so it can be supplied as a local instance via `letI`. -/
@[reducible] noncomputable def moduleQuotOfSmulEqBot {N : Type*} [AddCommGroup N] [Module R N]
    (I : Ideal R) (hN : I • (⊤ : Submodule R N) = ⊥) : Module (R ⧸ I) N :=
  (isTorsionBySet_of_smul_eq_bot I hN).module

/-- **The scalar tower `R → R ⧸ I → N`** for the `R ⧸ I`-structure on the `I`-torsion `N`.
This is the second piece, after `moduleQuotOfSmulEqBot`, needed to view `N` as an
`S = R ⧸ I`-module compatibly with its `R`-structure, which is required to feed the `S`-free
resolution of `N` into `rTensor_injective_of_flat_baseChange` for the right flank. -/
theorem isScalarTower_of_smul_eq_bot {N : Type*} [AddCommGroup N] [Module R N] (I : Ideal R)
    (hN : I • (⊤ : Submodule R N) = ⊥) :
    @IsScalarTower R (R ⧸ I) N _ (by letI := moduleQuotOfSmulEqBot I hN; exact
        inferInstance) _ := by
  let := moduleQuotOfSmulEqBot I hN
  have hts := isTorsionBySet_of_smul_eq_bot I hN
  refine ⟨fun r s n => ?_⟩
  obtain ⟨s', rfl⟩ := Ideal.Quotient.mk_surjective s
  have key : ∀ (c : R) (m : N), (Ideal.Quotient.mk I c) • m = c • m := fun c m =>
    Module.IsTorsionBySet.mk_smul hts c m
  change (r • (Ideal.Quotient.mk I s')) • n = (Ideal.Quotient.mk I r) • s' • n
  have h1 : r • Ideal.Quotient.mk I s' = Ideal.Quotient.mk I (r * s') := by
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul]
  rw [h1, key (r * s') n, key r (s' • n), mul_smul]

end Stacks.FreeOfNilpotentIdeal
