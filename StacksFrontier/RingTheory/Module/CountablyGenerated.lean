/-!
# Descending a countably generated submodule of a base change

Let `R → S` be a ring map, modelled as a commutative `R`-algebra `S`, let `M` be an
`R`-module, and consider the base change `S ⊗[R] M`, an `S`-module with `S` acting on the
left factor. For an `R`-submodule `P ⊆ M` the inclusion `P ↪ M` induces an `S`-module map
`S ⊗[R] P → S ⊗[R] M`, whose image is the `S`-submodule of `S ⊗[R] M` generated by the
elements `s ⊗ p`.

The main result (Stacks Tag 05A7, Lemma 10.95.4) is that if `Q` is a countably generated
`S`-submodule of `S ⊗[R] M`, then there is a countably generated `R`-submodule `P` of `M`
with `Q ⊆ Im (S ⊗[R] P → S ⊗[R] M)`.

## Conventions

* All rings are commutative with identity and ring maps are unital.
* The source writes `M ⊗_R S`; here the algebra factor is on the left, `S ⊗[R] M`, which is
  the side carrying the `S`-module structure. The two are canonically isomorphic.
* "Countably generated" includes the finitely generated case: the generating set is only
  required to be `Set.Countable`, mirroring `Submodule.FG`, which uses a `Finset`.
-/

@[expose] public section

open TensorProduct

/-- A submodule `p` is *countably generated* if it is spanned by some countable subset,
equivalently if it is the span of a finite or countably infinite set of elements. This is
the countable analogue of `Submodule.FG`, which uses a `Finset`; since `Set.Countable`
admits finite sets, countable generation includes the finitely generated case. -/
def Submodule.IsCountablyGenerated {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    (p : Submodule R M) : Prop :=
  ∃ s : Set M, s.Countable ∧ Submodule.span R s = p

/-- A countably generated `S`-submodule of `S ⊗[R] M` lies in the base change of a countably
generated `R`-submodule of `M`. -/
private theorem exists_countablyGenerated_le_baseChange_aux
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {M : Type*} [AddCommGroup M] [Module R M]
    (Q : Submodule S (S ⊗[R] M)) (hQ : Q.IsCountablyGenerated) :
    ∃ P : Submodule R M, P.IsCountablyGenerated ∧ Q ≤ P.baseChange S := by
  classical
  obtain ⟨s, hs_count, hs_span⟩ := hQ
  set G : Set M :=
    ⋃ q ∈ s, (((TensorProduct.exists_finset q).choose).image Prod.snd : Finset M)
    with hG
  have hG_count : G.Countable :=
    hs_count.biUnion fun q _ => Finset.countable_toSet _
  refine ⟨Submodule.span R G, ⟨G, hG_count, rfl⟩, ?_⟩
  rw [← hs_span, Submodule.span_le]
  intro q hq
  have hqeq : q = ∑ i ∈ (TensorProduct.exists_finset q).choose, i.fst ⊗ₜ[R] i.snd :=
    (TensorProduct.exists_finset q).choose_spec
  rw [SetLike.mem_coe, hqeq]
  apply Submodule.sum_mem
  intro i hi
  apply Submodule.tmul_mem_baseChange_of_mem
  apply Submodule.subset_span
  rw [hG]
  simp only [Set.mem_iUnion, Finset.coe_image, Set.mem_image, Finset.mem_coe]
  exact ⟨q, hq, i, hi, rfl⟩

/-- **Stacks Tag 05A7, Lemma 10.95.4.**
Let `R → S` be a ring map, `M` an `R`-module, and `Q` a countably generated
`S`-submodule of `S ⊗[R] M`. Then there exists a countably generated
`R`-submodule `P` of `M` such that `Q ⊆ Im(S ⊗[R] P → S ⊗[R] M)`, where the map
is induced by the inclusion `P ↪ M`. -/
@[stacks 05A7]
theorem exists_countablyGenerated_submodule_le_baseChange_range
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {M : Type*} [AddCommGroup M] [Module R M]
    (Q : Submodule S (S ⊗[R] M)) (hQ : Q.IsCountablyGenerated) :
    ∃ P : Submodule R M, P.IsCountablyGenerated ∧
      Q ≤ LinearMap.range (LinearMap.baseChange S P.subtype) := by
  exact exists_countablyGenerated_le_baseChange_aux Q hQ

