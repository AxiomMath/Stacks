/-!
# Descending a direct-sum decomposition of a base change to a countably generated submodule

Throughout, `R` and `S` are commutative rings, `R → S` is a ring homomorphism encoded as an
`R`-algebra structure on `S`, and `M` is an `R`-module. Via `R → S` every `S`-module is an
`R`-module, and the base change `M ⊗_R S` is an `S`-module.

The main result (Stacks Tag 05A8, Lemma 10.95.5) is the following. Suppose that as an
`S`-module `M ⊗_R S = ⨁_{i ∈ I} Qᵢ` is an internal direct sum of countably generated
`S`-submodules `Qᵢ`, and let `N` be a countably generated `R`-submodule of `M`. Then there
are a countably generated `R`-submodule `N' ⊆ M` and a subset `I' ⊆ I` with `N ⊆ N'` and
`Im (N' ⊗_R S → M ⊗_R S) = ⨁_{i ∈ I'} Qᵢ`.

## Implementation notes

* *Base change.* `M ⊗_R S` is modelled by `TensorProduct R S M`, i.e. `S ⊗_R M`; the two are
  canonically isomorphic via `TensorProduct.comm`, and putting the algebra on the left is
  Mathlib's base-change convention. The `S`-module structure is the standard one on `S ⊗_R M`.
* *Image of `N' ⊗_R S → M ⊗_R S`.* This is `Submodule.baseChange S N'`, the `S`-submodule of
  `S ⊗_R M` spanned by `{1 ⊗ n | n ∈ N'}`: `Submodule.baseChange_eq_span` gives
  `N'.baseChange S = Submodule.span S (N'.map (TensorProduct.mk R S M 1))`, and the `S`-span
  of `{1 ⊗ n}` is exactly the set of elements `∑ sₖ ⊗ ι nₖ = ∑ sₖ • (1 ⊗ ι nₖ)`, i.e. the
  image of the canonical map.
* *Direct sum decomposition.* The hypothesis `M ⊗_R S = ⨁_{i ∈ I} Qᵢ` is `DirectSum.IsInternal Q`,
  which says the canonical `S`-linear map `⨁ᵢ Qᵢ → S ⊗_R M` is bijective; this records both
  that the internal sum is everything and that it is direct.
* *Internal sub-direct-sum indexed by `I' ⊆ I`.* For `I' : Set I` this is the submodule
  `⨆ i : I', Q i = ∑_{i ∈ I'} Qᵢ`, automatically direct as a subfamily of a direct sum.
* *Countability.* "Countable" includes finite, matching `Set.Countable`.
-/

@[expose] public section

open scoped TensorProduct

variable {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M]
variable {I : Type*} [DecidableEq I]

/-- If every index at which the direct-sum decomposition of `x` is nonzero lies in `J`,
then `x` lies in the supremum of the summands indexed by `J`. -/
theorem mem_iSup_of_support_subset {ι A N : Type*} [DecidableEq ι] [Semiring A]
    [AddCommMonoid N] [Module A N] {Q : ι → Submodule A N} [DirectSum.Decomposition Q]
    (x : N) (J : Set ι) (h : ∀ i, DirectSum.decompose Q x i ≠ 0 → i ∈ J) :
    x ∈ ⨆ i ∈ J, Q i := by
  classical
  rw [← DirectSum.sum_support_decompose Q x]
  exact Submodule.sum_mem _ fun i hi =>
    le_iSup₂ (f := fun i (_ : i ∈ J) => Q i) i (h i (DFinsupp.mem_support_iff.mp hi))
      (SetLike.coe_mem _)

/-!
## Supporting fact (Stacks Tag 05A7 / Lemma 10.95.4)

Used in the proof of the main theorem: every countably generated `S`-submodule
`Q` of `M ⊗_R S` is contained in the image of `P ⊗_R S → M ⊗_R S` for some
countably generated `R`-submodule `P ⊆ M`.
-/

/-- **Stacks Tag 05A7 / Lemma 10.95.4.**  Every countably generated `S`-submodule
`Q` of `M ⊗_R S` is contained in the image `P.baseChange S` of some countably
generated `R`-submodule `P ⊆ M`. -/
theorem exists_countablyGenerated_of_le_baseChange
    (Q : Submodule S (TensorProduct R S M)) (hQ : Q.IsCountablyGenerated) :
    ∃ P : Submodule R M, P.IsCountablyGenerated ∧ Q ≤ P.baseChange S := by
  exact exists_countablyGenerated_le_baseChange_aux Q hQ

/-- A countable supremum of countably generated submodules is countably generated. -/
theorem Submodule.isCountablyGenerated_biSup {ι R M : Type*} [Semiring R] [AddCommMonoid M]
    [Module R M] {Q : ι → Submodule R M} (hQ : ∀ i, (Q i).IsCountablyGenerated) {J : Set ι}
    (hJ : J.Countable) : (⨆ i ∈ J, Q i).IsCountablyGenerated := by
  choose s hs hspan using hQ
  exact ⟨⋃ i ∈ J, s i, hJ.biUnion fun i _ => hs i, by simp only [Submodule.span_iUnion₂, hspan]⟩

/-- **Stacks Tag 05A8 / Lemma 10.95.5.**  If `M ⊗_R S` decomposes as an internal
direct sum of countably generated `S`-submodules `Q_i`, then any countably
generated `R`-submodule `N` of `M` is contained in a countably generated
`R`-submodule `N'` whose image `Im(N' ⊗_R S → M ⊗_R S) = N'.baseChange S` equals
the partial direct sum `⨁_{i ∈ I'} Q_i` over some subset `I' ⊆ I`. -/
@[stacks 05A8]
theorem exists_countablyGenerated_baseChange_eq_iSup_of_internal_directSum
    (Q : I → Submodule S (TensorProduct R S M))
    (hQ : DirectSum.IsInternal Q)
    (hQcg : ∀ i, (Q i).IsCountablyGenerated)
    (N : Submodule R M) (hN : N.IsCountablyGenerated) :
    ∃ (N' : Submodule R M) (I' : Set I),
      N'.IsCountablyGenerated ∧ N ≤ N' ∧
      N'.baseChange S = ⨆ i : I', Q i := by
  classical
  let := hQ.chooseDecomposition Q
  set bsupp : Set M → Set I := fun s =>
    ⋃ m ∈ s, {i | (DirectSum.decompose Q ((TensorProduct.mk R S M 1) m)) i ≠ 0}
  have step_exists : ∀ s : {t : Set M // t.Countable},
      ∃ s' : {t : Set M // t.Countable}, (s : Set M) ⊆ s' ∧
        ⨆ i ∈ bsupp s, Q i ≤ (Submodule.span R (s' : Set M)).baseChange S := by
    rintro ⟨s, hs⟩
    have hb : (bsupp s).Countable := hs.biUnion fun m _ =>
      ((DirectSum.decompose Q (TensorProduct.mk R S M 1 m)).support.finite_toSet.subset
        fun i hi => DFinsupp.mem_support_iff.mpr hi).countable
    obtain ⟨P, ⟨p, hp, rfl⟩, hPle⟩ := exists_countablyGenerated_of_le_baseChange _
      (Submodule.isCountablyGenerated_biSup hQcg hb)
    exact ⟨⟨s ∪ p, hs.union hp⟩, Set.subset_union_left,
      hPle.trans (Submodule.baseChange_mono _ (Submodule.span_mono Set.subset_union_right))⟩
  choose step hstep_sub hstep_le using step_exists
  obtain ⟨s₀, hs₀, rfl⟩ := hN
  set g : ℕ → {t : Set M // t.Countable} := fun n => step^[n] ⟨s₀, hs₀⟩ with hg
  have hg_succ : ∀ n, g (n + 1) = step (g n) := fun n => by
    simp only [hg, Function.iterate_succ_apply']
  have hgn_sub : ∀ n, (g n : Set M) ⊆ ⋃ n, (g n : Set M) :=
    Set.subset_iUnion fun n => (g n : Set M)
  refine ⟨Submodule.span R (⋃ n, (g n : Set M)), ⋃ n, bsupp (g n),
    ⟨_, Set.countable_iUnion fun n => (g n).property, rfl⟩, Submodule.span_mono (hgn_sub 0), ?_⟩
  rw [iSup_subtype]
  apply le_antisymm
  · rw [Submodule.baseChange_span, Submodule.span_le]
    rintro x ⟨m, hm, rfl⟩
    obtain ⟨n, hmn⟩ := Set.mem_iUnion.mp hm
    exact mem_iSup_of_support_subset _ _ fun i hi =>
      Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion₂.mpr ⟨m, hmn, hi⟩⟩
  · refine iSup₂_le fun i hi => ?_
    obtain ⟨n, hin⟩ := Set.mem_iUnion.mp hi
    have h := hstep_le (g n)
    rw [← hg_succ] at h
    exact (le_iSup₂ (f := fun j (_ : j ∈ bsupp (g n)) => Q j) i hin).trans
      (h.trans (Submodule.baseChange_mono _ (Submodule.span_mono (hgn_sub (n + 1)))))
