module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.Module.StablyFree.Basic
public import Mathlib.RingTheory.PicardGroup
public import Mathlib.RingTheory.TotallySplit
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Splitting a map of finite modules from its reductions mod `Iⁿ`

Throughout, `R` is a commutative ring and all modules are `R`-modules with `R`-linear maps.

Let `R` be a Noetherian commutative ring, `I ⊆ R` an ideal contained in the Jacobson radical of
`R`, and `φ : N → M` an `R`-linear map between finite `R`-modules. If for arbitrarily large `n`
the induced map `φ̄ₙ : N / Iⁿ N → M / Iⁿ M` is a split injection, then `φ` is a split injection.

## Implementation notes

* "Finite `R`-module" means finitely generated, `Module.Finite R M`.
* "Split injection" is the existence of a left inverse, a retraction: for a split injection `φ`
  with retraction `ψ`, `φ` is injective and `M ≅ φ(N) ⊕ ker ψ`.
* "Arbitrarily large `n`" is strictly weaker than "for all sufficiently large `n`": the
  splitting hypothesis is required only for an unbounded set of exponents.
* The hypotheses that `R` is Noetherian, that `I ⊆ Jac(R)`, and that `N`, `M` are finite are
  exactly what is needed to invoke the Krull intersection / Artin–Rees consequence.
* The Jacobson radical of `R` is `Ideal.jacobson ⊥`, the intersection of all maximal ideals.
* `Iⁿ N` is modelled by `I ^ n • (⊤ : Submodule R N)`, the submodule generated by the products
  `a • m` with `a ∈ Iⁿ` and `m ∈ N`.
-/

@[expose] public section

open Submodule LinearMap

universe u

/-- An `R`-linear map `φ : N → M` is a *split injection*
if it admits a left inverse (a retraction): there exists an `R`-linear map `ψ : M → N`
such that `ψ ∘ φ = id`. (The existence of such a `ψ` automatically forces `φ` to be
injective, and is equivalent to saying that `φ(N)` is a direct summand of `M`.) -/
@[ega "0 22.6.2"]
def IsSplitInjection {R N M : Type*} [CommRing R] [AddCommGroup N] [Module R N]
    [AddCommGroup M] [Module R M] (φ : N →ₗ[R] M) : Prop :=
  ∃ ψ : M →ₗ[R] N, ψ ∘ₗ φ = LinearMap.id

/-- For an `R`-linear map
`φ : N → M`, since `φ (Iⁿ N) ⊆ Iⁿ M`, it induces a well-defined `R`-linear map
`φ̄ₙ : N / Iⁿ N → M / Iⁿ M`, `n + Iⁿ N ↦ φ(n) + Iⁿ M`. Here `Iⁿ N` is modelled by
`I ^ n • (⊤ : Submodule R N)`. -/
noncomputable def inducedMapModPow {R N M : Type*} [CommRing R] [AddCommGroup N] [Module R N]
    [AddCommGroup M] [Module R M] (φ : N →ₗ[R] M) (I : Ideal R) (n : ℕ) :
    (N ⧸ (I ^ n • (⊤ : Submodule R N))) →ₗ[R] (M ⧸ (I ^ n • (⊤ : Submodule R M))) :=
  Submodule.mapQ _ _ φ (by
    rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
    exact Submodule.smul_mono le_rfl le_top)

/-- A property `P` of natural numbers holds for
*arbitrarily large* `n` if for every `n₀ : ℕ` there exists `n ≥ n₀` such that `P n` holds
(equivalently, the set `{ n | P n }` is unbounded / infinite). -/
def ForArbitrarilyLarge (P : ℕ → Prop) : Prop :=
  ∀ n₀ : ℕ, ∃ n ≥ n₀, P n

/-- **Closedness of submodules in the `I`-adic topology** (consequence of Krull's
intersection theorem). If `R` is Noetherian, `M` is a finite `R`-module, and
`I ≤ Jac(R)`, then every submodule `K` is closed: `(⨅ n, (K ⊔ Iⁿ M)) ≤ K`.

This is the *correct* and reusable closedness fact; in the proof below it is applied
to `K = range(Hom(F₀,N) → Hom(F₁,N))` inside the finite module `Hom(F₁,N)`. -/
@[ega "0 7.3.5" "a⇒c, a⇒d", ega "0 7.4.2" "more general"]
theorem submodule_iInf_sup_pow_smul_le
    {R W : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup W] [Module R W] [Module.Finite R W]
    (I : Ideal R) (hI : I ≤ Ideal.jacobson ⊥) (K : Submodule R W) :
    (⨅ n : ℕ, (K ⊔ I ^ n • (⊤ : Submodule R W))) ≤ K := by
  have key := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := W ⧸ K) I hI
  intro x hx
  rw [Submodule.mem_iInf] at hx
  have hmem : (K.mkQ x) ∈ (⨅ n : ℕ, I ^ n • (⊤ : Submodule R (W ⧸ K))) := by
    rw [Submodule.mem_iInf]
    intro n
    have hxn := hx n
    have hmap : Submodule.map K.mkQ (K ⊔ I ^ n • (⊤ : Submodule R W))
        = I ^ n • (⊤ : Submodule R (W ⧸ K)) := by
      rw [Submodule.map_sup, Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ,
        Submodule.mkQ_map_self, bot_sup_eq]
    rw [← hmap]
    exact ⟨x, hxn, rfl⟩
  rw [key, Submodule.mem_bot] at hmem
  rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hmem

/-- **Injectivity of `φ`** (first half of Stacks 02HO). If for arbitrarily large `n`
the reduction `φ̄ₙ` is a split injection, then `φ` is injective.

*Argument.* A split injection is injective, so `φ̄ₙ` is injective for arbitrarily large
`n`. Injectivity of `φ̄ₙ` gives `Ker φ ⊆ Iⁿ • N` (if `φ x = 0` then `⟦x⟧` maps to `0`,
hence `⟦x⟧ = 0`, i.e. `x ∈ IⁿN`). As this holds for arbitrarily large `n` and the
family `Iⁿ • N` is antitone, `Ker φ ⊆ ⋂ₙ Iⁿ • N = 0` by the Krull intersection theorem
(`Ideal.iInf_pow_smul_eq_bot_of_le_jacobson`). -/
theorem injective_of_arbitrarily_large_split
    {R N M : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (I : Ideal R) (hI : I ≤ Ideal.jacobson ⊥) (φ : N →ₗ[R] M)
    (h : ForArbitrarilyLarge (fun n => IsSplitInjection (inducedMapModPow φ I n))) :
    Function.Injective φ := by
  rw [← LinearMap.ker_eq_bot, ← le_bot_iff,
    ← Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := N) I hI, le_iInf_iff]
  intro i
  obtain ⟨n, hni, hsplit⟩ := h i
  obtain ⟨s, hs⟩ := hsplit
  have hinj : Function.Injective (inducedMapModPow φ I n) := by
    have hli : Function.LeftInverse s (inducedMapModPow φ I n) := by
      intro y; have := LinearMap.congr_fun hs y; simpa using this
    exact hli.injective
  have hsub : LinearMap.ker φ ≤ I ^ n • (⊤ : Submodule R N) := by
    intro x hx
    rw [LinearMap.mem_ker] at hx
    have h0 : inducedMapModPow φ I n (Submodule.Quotient.mk x) = 0 := by
      simp only [inducedMapModPow, Submodule.mapQ_apply, hx]; rfl
    have hker : (Submodule.Quotient.mk x : N ⧸ (I ^ n • (⊤ : Submodule R N))) = 0 := by
      apply hinj; rw [h0, map_zero]
    rwa [Submodule.Quotient.mk_eq_zero] at hker
  exact le_trans hsub (Submodule.smul_mono (Ideal.pow_le_pow_right hni) le_rfl)

/-!
## The Ext-obstruction reduction (Stacks 02HO, second half)

We follow the Stacks proof.  Having shown `φ` is injective, set `Q := M ⧸ range φ`,
giving a short exact sequence `0 → N →φ M →(mkQ) Q → 0`.  Since `Q` is a finite module
over the Noetherian ring `R`, it is finitely presented, so there is a finite free
*presentation*
`F₁ →(d₁) F₀ →(p₀) Q → 0`  (exact, with `F₀`, `F₁` finite free).
Lift `p₀` through the surjection `mkQ : M ↠ Q` (possible as `F₀` is projective) to
`α : F₀ →ₗ[R] M` with `mkQ ∘ α = p₀`.  Then `mkQ ∘ (α ∘ d₁) = p₀ ∘ d₁ = 0`, so
`α ∘ d₁` has image in `ker (mkQ) = range φ`; by injectivity of `φ` there is a unique
`β : F₁ →ₗ[R] N` with `φ ∘ β = α ∘ d₁`.

Write `D : (F₀ →ₗ[R] N) →ₗ[R] (F₁ →ₗ[R] N)`, `D γ = γ ∘ d₁` (precomposition by `d₁`).
The two homological facts are isolated as the lemmas below.
-/

/-- **Splitting criterion (Ext¹ obstruction vanishes ⇒ split).**
With the presentation data as above, if the class of `β` is trivial — i.e. `β = γ ∘ d₁`
for some `γ : F₀ →ₗ[R] N` — then `φ` is a split injection.

*Argument.* Given `γ` with `β = γ ∘ d₁`, the map `α - φ ∘ γ : F₀ →ₗ[R] M` kills
`range d₁ = ker p₀` (since `(α - φ∘γ) ∘ d₁ = α∘d₁ - φ∘β = 0`), so — using that `p₀` is
**surjective**, whence `F₀ / ker p₀ ≅ Q` via `p₀` — it factors through `p₀` as
`θ ∘ p₀` for a unique `θ : Q →ₗ[R] M`.  Then `pQ ∘ θ ∘ p₀ = pQ ∘ (α - φ∘γ) =
p₀ - 0 = p₀` (as `pQ ∘ φ = 0`), and `p₀` surjective gives `pQ ∘ θ = id_Q`: `θ` is a
section of `pQ`.  A section of `pQ` splits the SES `0→N→M→Q→0`, equivalently yields a
retraction `ρ : M →ₗ[R] N` of `φ` (`ρ := ` the projection to `N` along `θ(Q)`).  Hence
`φ` is a split injection. -/
theorem split_of_obstruction_trivial
    {R N M Q F₀ F₁ : Type*} [CommRing R]
    [AddCommGroup N] [Module R N] [AddCommGroup M] [Module R M]
    [AddCommGroup Q] [Module R Q] [AddCommGroup F₀] [Module R F₀]
    [AddCommGroup F₁] [Module R F₁]
    (φ : N →ₗ[R] M) (hφ : Function.Injective φ)
    (pQ : M →ₗ[R] Q) (hpQ : LinearMap.range φ = LinearMap.ker pQ)
    (p₀ : F₀ →ₗ[R] Q) (hp₀ : Function.Surjective p₀)
    (d₁ : F₁ →ₗ[R] F₀) (hp₀d₁ : LinearMap.range d₁ = LinearMap.ker p₀)
    (α : F₀ →ₗ[R] M) (hα : pQ ∘ₗ α = p₀)
    (β : F₁ →ₗ[R] N) (hβ : φ ∘ₗ β = α ∘ₗ d₁)
    (hsplit : ∃ γ : F₀ →ₗ[R] N, β = γ ∘ₗ d₁) :
    IsSplitInjection φ := by
  obtain ⟨γ, hγ⟩ := hsplit
  -- pQ ∘ φ = 0
  have hpQφ : pQ ∘ₗ φ = 0 := by
    ext x
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.zero_apply]
    rw [← LinearMap.mem_ker, ← hpQ]
    exact LinearMap.mem_range_self φ x
  -- δ := α - φ ∘ γ
  set δ : F₀ →ₗ[R] M := α - φ ∘ₗ γ with hδ
  -- δ ∘ d₁ = 0
  have hδd₁ : δ ∘ₗ d₁ = 0 := by
    have hφγd : φ ∘ₗ (γ ∘ₗ d₁) = α ∘ₗ d₁ := by rw [← hγ]; exact hβ
    rw [hδ, LinearMap.sub_comp, LinearMap.comp_assoc, hφγd, sub_self]
  -- ker p₀ ≤ ker δ
  have hδker : LinearMap.ker p₀ ≤ LinearMap.ker δ := by
    rw [← hp₀d₁]
    rintro y ⟨x, rfl⟩
    rw [LinearMap.mem_ker]
    have := LinearMap.congr_fun hδd₁ x
    simpa using this
  -- θ : Q →ₗ M, section of pQ
  set θ : Q →ₗ[R] M :=
    ((LinearMap.ker p₀).liftQ δ hδker) ∘ₗ (LinearMap.quotKerEquivOfSurjective p₀ hp₀).symm
    with hθdef
  -- θ ∘ p₀ = δ
  have hθp₀ : θ ∘ₗ p₀ = δ := by
    ext f
    simp only [hθdef, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe]
    have hq : (LinearMap.quotKerEquivOfSurjective p₀ hp₀).symm (p₀ f)
        = Submodule.Quotient.mk f := by
      rw [LinearEquiv.symm_apply_eq, LinearMap.quotKerEquivOfSurjective_apply_mk]
    rw [hq, Submodule.liftQ_apply]
  -- pQ ∘ θ = id
  have hpQθ : pQ ∘ₗ θ = LinearMap.id := by
    apply (LinearMap.cancel_right hp₀).mp
    rw [LinearMap.comp_assoc, hθp₀, LinearMap.id_comp]
    rw [hδ, LinearMap.comp_sub]
    rw [show pQ ∘ₗ (φ ∘ₗ γ) = (pQ ∘ₗ φ) ∘ₗ γ by rw [LinearMap.comp_assoc]]
    rw [hpQφ, LinearMap.zero_comp, sub_zero, hα]
  -- e := id - θ ∘ pQ ; range e ≤ range φ
  set e : M →ₗ[R] M := LinearMap.id - θ ∘ₗ pQ with hedef
  have hrange : ∀ m : M, e m ∈ LinearMap.range φ := by
    intro m
    rw [hpQ, LinearMap.mem_ker]
    have : pQ (e m) = pQ m - pQ (θ (pQ m)) := by
      simp only [hedef, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.id_apply, map_sub]
    rw [this]
    have hid : pQ (θ (pQ m)) = pQ m := by
      have := LinearMap.congr_fun hpQθ (pQ m)
      simpa using this
    rw [hid, sub_self]
  -- ψ := (ofInjective φ hφ).symm ∘ codRestrict (range φ) e hrange
  refine ⟨(LinearEquiv.ofInjective φ hφ).symm.toLinearMap ∘ₗ
    LinearMap.codRestrict (LinearMap.range φ) e hrange, ?_⟩
  ext x
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq,
    LinearEquiv.coe_coe]
  -- e (φ x) = φ x
  have hex : e (φ x) = φ x := by
    have hpqφx : pQ (φ x) = 0 := by
      have := LinearMap.congr_fun hpQφ x
      simpa using this
    simp only [hedef, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.id_apply, hpqφx,
      map_zero, sub_zero]
  -- conclude
  rw [LinearEquiv.symm_apply_eq]
  apply Subtype.ext
  rw [LinearEquiv.ofInjective_apply]
  simpa using hex

/-- **Obstruction membership modulo `Iⁿ` (where the freeness of `F₁` is used).**
With the presentation data, if `φ̄ₙ : N/IⁿN → M/IⁿM` is a split injection, then the
class of `β` lies in `range D ⊔ Iⁿ • Hom(F₁,N)`, where `D γ = γ ∘ d₁`.

*Argument (Stacks).* Reduce the whole diagram mod `Iⁿ`. Because `φ̄ₙ` is a split
injection, the reduced sequence `0 → N/IⁿN → M/IⁿM → Q/IⁿQ → 0` is still short exact,
and `F₁/IⁿF₁ →(d̄₁) F₀/IⁿF₀ → Q/IⁿQ → 0` is still exact (right-exactness of `⊗R/Iⁿ`).
Arguing as in the integral case (the obstruction vanishes mod `Iⁿ`), the reduced map
`β̄ₙ : F₁/IⁿF₁ → N/IⁿN` equals `gbarₙ ∘ d̄₁` for some `gbarₙ : F₀/IⁿF₀ → N/IⁿN`.  Since
`F₀` is **free**, lift `gbarₙ` to `γₙ : F₀ →ₗ[R] N`.  Then `β - γₙ ∘ d₁ : F₁ → N` has
image contained in `IⁿN` (its reduction mod `Iⁿ` is `β̄ₙ - gbarₙ ∘ d̄₁ = 0`).  Now use
that `F₁` is **finite free**: a homomorphism `F₁ → N` landing in `IⁿN` lies in
`Iⁿ • Hom(F₁,N)` (for `F₁ ≅ Rᵏ`, `Hom(F₁,N) ≅ Nᵏ` and `Hom(F₁,IⁿN) ≅ (IⁿN)ᵏ =
Iⁿ•Nᵏ`).  Hence `β = (γₙ ∘ d₁) + (β - γₙ ∘ d₁) ∈ range D ⊔ Iⁿ • ⊤`.

The freeness of `F₁` is what makes this step work; it fails for non-free modules. -/
theorem obstruction_mem_sup_pow
    {R N M F₀ F₁ : Type*} [CommRing R]
    [AddCommGroup N] [Module R N] [AddCommGroup M] [Module R M]
    [AddCommGroup F₀] [Module R F₀] [Module.Free R F₀] [Module.Finite R F₀]
    [AddCommGroup F₁] [Module R F₁] [Module.Free R F₁] [Module.Finite R F₁]
    (I : Ideal R) (n : ℕ)
    (φ : N →ₗ[R] M)
    (d₁ : F₁ →ₗ[R] F₀)
    (α : F₀ →ₗ[R] M)
    (β : F₁ →ₗ[R] N) (hβ : φ ∘ₗ β = α ∘ₗ d₁)
    (hn : IsSplitInjection (inducedMapModPow φ I n)) :
    β ∈ (LinearMap.range (LinearMap.lcomp R N d₁ : (F₀ →ₗ[R] N) →ₗ[R] (F₁ →ₗ[R] N)))
      ⊔ I ^ n • (⊤ : Submodule R (F₁ →ₗ[R] N)) := by
  classical
  -- Abbreviations for the reduction quotients.
  obtain ⟨ψ, hψ⟩ := hn
  -- the reduced map ᾱₙ : F₀/Iⁿ → M/Iⁿ
  set ᾱ : (F₀ ⧸ (I ^ n • (⊤ : Submodule R F₀))) →ₗ[R] (M ⧸ (I ^ n • (⊤ : Submodule R M))) :=
    inducedMapModPow α I n with hᾱ
  -- gbarₙ := ψ ∘ ᾱₙ : F₀/Iⁿ → N/Iⁿ
  set gbar : (F₀ ⧸ (I ^ n • (⊤ : Submodule R F₀))) →ₗ[R] (N ⧸ (I ^ n • (⊤ : Submodule R N))) :=
    ψ ∘ₗ ᾱ with hgbar
  -- the surjection N ↠ N/Iⁿ
  set qN : N →ₗ[R] (N ⧸ (I ^ n • (⊤ : Submodule R N))) := (I ^ n • (⊤ : Submodule R N)).mkQ with hqN
  have hqNsurj : Function.Surjective qN := Submodule.mkQ_surjective _
  set qF0 : F₀ →ₗ[R] (F₀ ⧸ (I ^ n • (⊤ : Submodule R F₀))) :=
    (I ^ n • (⊤ : Submodule R F₀)).mkQ with hqF0
  -- lift gbar ∘ qF0 : F₀ → N/Iⁿ to γ : F₀ → N
  obtain ⟨γ, hγ⟩ := Module.projective_lifting_property qN (gbar ∘ₗ qF0) hqNsurj
  -- the candidate obstruction defect
  set g : F₁ →ₗ[R] N := β - γ ∘ₗ d₁ with hg
  -- key: g x ∈ Iⁿ • N for all x
  have hgmem : ∀ x : F₁, g x ∈ I ^ n • (⊤ : Submodule R N) := by
    intro x
    rw [← Submodule.Quotient.mk_eq_zero]
    change qN (g x) = 0
    have hgx : qN (g x) = qN (β x) - qN (γ (d₁ x)) := by
      simp [hg, map_sub]
    rw [hgx]
    -- qN (γ (d₁ x)) = gbar (qF0 (d₁ x))
    have h1 : qN (γ (d₁ x)) = gbar (qF0 (d₁ x)) := by
      have := LinearMap.congr_fun hγ (d₁ x)
      simpa using this
    -- gbar (qF0 (d₁ x)) = ψ (ᾱ (qF0 (d₁ x)))
    -- ᾱ (qF0 (d₁ x)) = mkQ (α (d₁ x))
    have h2 : ᾱ (qF0 (d₁ x)) = Submodule.Quotient.mk (α (d₁ x)) := by
      rw [hᾱ, hqF0]
      change (inducedMapModPow α I n) (Submodule.Quotient.mk (d₁ x)) = _
      unfold inducedMapModPow
      rw [Submodule.mapQ_apply]
    -- α (d₁ x) = φ (β x)
    have h3 : α (d₁ x) = φ (β x) := by
      have := LinearMap.congr_fun hβ x
      simpa using this.symm
    -- mkQ (φ (β x)) = φ̄ₙ (qN (β x))
    have h4 : (Submodule.Quotient.mk (φ (β x)) : M ⧸ (I ^ n • (⊤ : Submodule R M)))
        = (inducedMapModPow φ I n) (qN (β x)) := by
      rw [hqN]
      change _ = (inducedMapModPow φ I n) (Submodule.Quotient.mk (β x))
      unfold inducedMapModPow
      rw [Submodule.mapQ_apply]
    -- ψ (φ̄ₙ (qN (β x))) = qN (β x)
    have h5 : ψ ((inducedMapModPow φ I n) (qN (β x))) = qN (β x) := by
      have := LinearMap.congr_fun hψ (qN (β x))
      simpa using this
    rw [h1, hgbar]
    change qN (β x) - ψ (ᾱ (qF0 (d₁ x))) = 0
    rw [h2, h3, h4, h5]
    exact sub_self _
  -- Lemma A: g landing in Iⁿ•N ⟹ g ∈ Iⁿ • Hom(F₁,N)
  have hgsmul : g ∈ I ^ n • (⊤ : Submodule R (F₁ →ₗ[R] N)) := by
    let ι := Module.Free.ChooseBasisIndex R F₁
    let b : Module.Basis ι R F₁ := Module.Free.chooseBasis R F₁
    have hfin : Fintype ι := inferInstance
    let Φ : ι → (N →ₗ[R] (F₁ →ₗ[R] N)) := fun i => (LinearMap.smulRightₗ) (b.coord i)
    have hrep : g = ∑ i, Φ i (g (b i)) := by
      ext x
      simp only [Φ, LinearMap.smulRightₗ_apply, LinearMap.smulRight_apply,
        Finset.sum_apply, LinearMap.coe_sum]
      have hsw : ∀ i, (b.coord i) x • g (b i) = g ((b.coord i x) • b i) := by
        intro i; rw [map_smul]
      simp_rw [hsw, ← map_sum]
      congr 1
      conv_lhs => rw [← b.sum_repr x]
      simp [b.coord_apply]
    rw [hrep]
    apply Submodule.sum_mem
    intro i _
    have hbi : g (b i) ∈ I ^ n • (⊤ : Submodule R N) := hgmem (b i)
    have hmem : Φ i (g (b i)) ∈ (I ^ n • (⊤ : Submodule R N)).map (Φ i) :=
      Submodule.mem_map_of_mem hbi
    rw [Submodule.map_smul''] at hmem
    exact Submodule.smul_mono le_rfl le_top hmem
  -- conclude: β = (γ ∘ d₁) + g, first term in range(lcomp d₁), second in Iⁿ•⊤
  have hβeq : β = (LinearMap.lcomp R N d₁) γ + g := by
    rw [hg]; ext x; simp [LinearMap.lcomp_apply]
  rw [hβeq]
  exact Submodule.add_mem_sup (LinearMap.mem_range_self _ γ) hgsmul

/-- **Existence of the presentation data** (set-up of the Stacks 02HO diagram).
Given the SES `0 → N →φ M →pQ Q → 0` with `φ` injective and `pQ` the cokernel map,
there is a finite free presentation `F₁ →d₁ F₀ →p₀ Q → 0` of `Q` together with a lift
`α : F₀ → M` of `p₀` and the induced cocycle `β : F₁ → N`.

*Argument.* `Q` is a finite module over the Noetherian ring `R`, hence finitely
presented (`Module.finitePresentation_of_finite`): there is a surjection
`p₀ : F₀ ↠ Q` from a finite free `F₀` whose kernel is finitely generated, and a
surjection from a finite free `F₁` onto `ker p₀`, giving `d₁ : F₁ → F₀` with
`range d₁ = ker p₀`.  As `F₀` is projective and `pQ` is surjective, lift `p₀` to
`α : F₀ → M` with `pQ ∘ α = p₀` (`projective_lifting_property`).  Then
`pQ ∘ (α ∘ d₁) = p₀ ∘ d₁ = 0`, so `range (α ∘ d₁) ≤ ker pQ = range φ`; injectivity
of `φ` lets us factor `α ∘ d₁ = φ ∘ β` for a unique `β : F₁ → N`.

The free modules `F₀`, `F₁` are taken in the universe of `R`, since `Fin n → R` lives there. -/
@[ega "0 1.0.5" "more general",
  ega "0 1.3.5" "Over a Noetherian ring",
  sga "6 I 1.3" "partial, special case"]
theorem exists_presentation_data
    {R : Type u} {N M Q : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup N] [Module R N] [AddCommGroup M] [Module R M]
    [AddCommGroup Q] [Module R Q] [Module.Finite R Q]
    (φ : N →ₗ[R] M) (hφ : Function.Injective φ)
    (pQ : M →ₗ[R] Q) (hpQ : LinearMap.range φ = LinearMap.ker pQ)
    (hpQsurj : Function.Surjective pQ) :
    ∃ (F₀ F₁ : Type u) (_ : AddCommGroup F₀) (_ : Module R F₀) (_ : Module.Free R F₀)
      (_ : Module.Finite R F₀) (_ : AddCommGroup F₁) (_ : Module R F₁)
      (_ : Module.Free R F₁) (_ : Module.Finite R F₁)
      (p₀ : F₀ →ₗ[R] Q) (_ : Function.Surjective p₀)
      (d₁ : F₁ →ₗ[R] F₀) (_ : LinearMap.range d₁ = LinearMap.ker p₀)
      (α : F₀ →ₗ[R] M) (_ : pQ ∘ₗ α = p₀)
      (β : F₁ →ₗ[R] N), φ ∘ₗ β = α ∘ₗ d₁ := by
  -- Step 1: finite free surjection p₀ : (Fin n → R) ↠ Q
  obtain ⟨n, p₀, hp₀⟩ := Module.Finite.exists_fin' R Q
  -- Step 2: finite free surjection onto ker p₀, giving d₁
  obtain ⟨m, g, hg⟩ := Module.Finite.exists_fin' R ↥(LinearMap.ker p₀)
  set d₁ : (Fin m → R) →ₗ[R] (Fin n → R) := (LinearMap.ker p₀).subtype ∘ₗ g with hd₁def
  have hd₁range : LinearMap.range d₁ = LinearMap.ker p₀ := by
    rw [hd₁def, LinearMap.range_comp, LinearMap.range_eq_top.mpr hg, Submodule.map_top,
      Submodule.range_subtype]
  -- Step 3: lift p₀ through pQ to α
  obtain ⟨α, hα⟩ := Module.projective_lifting_property pQ p₀ hpQsurj
  -- Step 4: α ∘ d₁ lands in range φ
  have hmem : ∀ x, (α ∘ₗ d₁) x ∈ LinearMap.range φ := by
    intro x
    rw [hpQ, LinearMap.mem_ker]
    have h1 : pQ ((α ∘ₗ d₁) x) = (pQ ∘ₗ α) (d₁ x) := by
      simp [LinearMap.comp_apply]
    rw [h1, hα]
    have : d₁ x ∈ LinearMap.range d₁ := LinearMap.mem_range_self d₁ x
    rw [hd₁range, LinearMap.mem_ker] at this
    exact this
  -- Construct β
  set β : (Fin m → R) →ₗ[R] N :=
    (LinearEquiv.ofInjective φ hφ).symm.toLinearMap ∘ₗ
      LinearMap.codRestrict (LinearMap.range φ) (α ∘ₗ d₁) hmem with hβdef
  have hβ : φ ∘ₗ β = α ∘ₗ d₁ := by
    apply LinearMap.ext
    intro x
    have hgoal : φ (β x) = (α ∘ₗ d₁) x := by
      have hcr : (LinearMap.codRestrict (LinearMap.range φ) (α ∘ₗ d₁) hmem) x
          = ⟨(α ∘ₗ d₁) x, hmem x⟩ := rfl
      have hβx : β x = (LinearEquiv.ofInjective φ hφ).symm ⟨(α ∘ₗ d₁) x, hmem x⟩ := by
        rw [hβdef]
        simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe]
        rw [hcr]
        rfl
      rw [hβx]
      have := LinearEquiv.apply_symm_apply (LinearEquiv.ofInjective φ hφ)
        ⟨(α ∘ₗ d₁) x, hmem x⟩
      have h2 : (LinearEquiv.ofInjective φ hφ) ((LinearEquiv.ofInjective φ hφ).symm
          ⟨(α ∘ₗ d₁) x, hmem x⟩) = ⟨(α ∘ₗ d₁) x, hmem x⟩ := this
      have h3 := congrArg (Subtype.val) h2
      rw [LinearEquiv.ofInjective_apply] at h3
      exact h3
    simpa using hgoal
  exact ⟨Fin n → R, Fin m → R, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance, inferInstance, p₀, hp₀, d₁, hd₁range,
    α, hα, β, hβ⟩

/-- **Theorem (Stacks Tag 02HO, Lemma 10.74.1).**
Let `R` be a Noetherian commutative ring, `I ⊆ R` an ideal contained in the Jacobson
radical of `R`, and `N`, `M` finite `R`-modules. Let `φ : N → M` be `R`-linear. If for
arbitrarily large `n` the induced map `φ̄ₙ : N / Iⁿ N → M / Iⁿ M` is a split injection,
then `φ` itself is a split injection. -/
@[stacks 02HO, ega "0 19.1.8" "partial"]
theorem split_injection_of_arbitrarily_large_split_mod_pow
    {R N M : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup N] [Module R N] [Module.Finite R N]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (I : Ideal R) (hI : I ≤ Ideal.jacobson ⊥) (φ : N →ₗ[R] M)
    (h : ForArbitrarilyLarge (fun n => IsSplitInjection (inducedMapModPow φ I n))) :
    IsSplitInjection φ := by
  classical
  -- Step 1: `φ` is injective.
  have hφinj : Function.Injective φ := injective_of_arbitrarily_large_split I hI φ h
  -- Step 2: form the cokernel `Q := M ⧸ range φ` and the SES `0→N→M→Q→0`.
  set pQ : M →ₗ[R] (M ⧸ LinearMap.range φ) := (LinearMap.range φ).mkQ with hpQdef
  have hpQsurj : Function.Surjective pQ := Submodule.mkQ_surjective _
  have hpQker : LinearMap.range φ = LinearMap.ker pQ := by rw [hpQdef, Submodule.ker_mkQ]
  -- Step 3+4: choose the finite free presentation and the lift/cocycle data.
  obtain ⟨F₀, F₁, _, _, _, _, _, _, _, _, p₀, hp₀, d₁, hp₀d₁, α, hα, β, hβ⟩ :=
    exists_presentation_data φ hφinj pQ hpQker hpQsurj
  -- The precomposition-by-`d₁` map `D : Hom(F₀,N) → Hom(F₁,N)`, `D γ = γ ∘ d₁`.
  set D : (F₀ →ₗ[R] N) →ₗ[R] (F₁ →ₗ[R] N) := LinearMap.lcomp R N d₁ with hD
  -- Step 5a: the obstruction `β` lies in `range D ⊔ Iⁿ•⊤` for *every* `n`, because the
  -- hypothesis gives, for each `n`, some split level `m ≥ n` (`obstruction_mem_sup_pow`)
  -- and the family `range D ⊔ Iⁿ•⊤` is antitone in `n`.
  have hmem : β ∈ (⨅ n : ℕ, LinearMap.range D ⊔ I ^ n • (⊤ : Submodule R (F₁ →ₗ[R] N))) := by
    rw [Submodule.mem_iInf]
    intro n
    obtain ⟨m, hmn, hm⟩ := h n
    have hmem_m : β ∈ LinearMap.range D ⊔ I ^ m • (⊤ : Submodule R (F₁ →ₗ[R] N)) :=
      obstruction_mem_sup_pow I m φ d₁ α β hβ hm
    have hanti : LinearMap.range D ⊔ I ^ m • (⊤ : Submodule R (F₁ →ₗ[R] N))
        ≤ LinearMap.range D ⊔ I ^ n • (⊤ : Submodule R (F₁ →ₗ[R] N)) :=
      sup_le_sup_left (Submodule.smul_mono (Ideal.pow_le_pow_right hmn) le_rfl) _
    exact hanti hmem_m
  -- Step 5b: Krull closedness ⇒ `β ∈ range D`, i.e. the obstruction class vanishes.
  have hβmem : β ∈ LinearMap.range D := submodule_iInf_sup_pow_smul_le I hI _ hmem
  obtain ⟨γ, hγ⟩ := hβmem
  -- Step 5c: a trivial obstruction class ⇒ `φ` is a split injection.
  exact split_of_obstruction_trivial φ hφinj pQ hpQker p₀ hp₀ d₁ hp₀d₁ α hα β hβ
    ⟨γ, by rw [← hγ]; rfl⟩
