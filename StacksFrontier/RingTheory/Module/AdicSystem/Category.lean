  {E F G : AdicModuleSystem.{u, v} A I}

/-- The representative obtained from `r` by raising its delay to any `d ≥ r.delay`. -/
def raiseDelay (r : HomRepresentative E F) (d : ℕ) (hd : r.delay ≤ d) :
    HomRepresentative E F where
  delay := d
  map n hn := (quotientTransitionOfLE F n hd).comp
    ((r.map n (hd.trans hn)).comp (Submodule.inclusion (powerPart_antitone E n hd)))

/-- Raising the delay of a representative to its own delay returns that representative. -/
theorem raiseDelay_refl (r : HomRepresentative E F) :
    raiseDelay r r.delay le_rfl = r :=
  representative_ext rfl fun n _ _ =>
    heq_of_eq <| LinearMap.ext fun _ => quotientTransitionOfLE_refl F n r.delay _

/-- Raising the delay to `d` and then passing to the successor raises the delay to `d + 1`. -/
theorem raiseDelay_succ (r : HomRepresentative E F) (d : ℕ) (hd : r.delay ≤ d) :
    (raiseDelay r d hd).succ = raiseDelay r (d + 1) (hd.trans (Nat.le_succ d)) :=
  representative_ext rfl fun n _ _ =>
    heq_of_eq <| LinearMap.ext fun _ => quotientTransitionOfLE_comp F n hd (Nat.le_succ d) _

private theorem hom_raiseDelay (r : HomRepresentative E F) (d : ℕ) (hd : r.delay ≤ d) :
    homOfRepresentative (raiseDelay r d hd) = homOfRepresentative r := by
  induction d, hd using Nat.le_induction with
  | base => rw [raiseDelay_refl]
  | succ d hd ih => rw [← raiseDelay_succ r d hd, homOfRepresentative_succ, ih]

/-- Taking `k` successors of a representative raises its delay to `r.delay + k`. -/
theorem iteratedSucc_eq_raiseDelay (r : HomRepresentative E F) (k : ℕ) :
    r.iteratedSucc k = raiseDelay r (r.delay + k) (Nat.le_add_right _ _) := by
  induction k with
  | zero => exact (raiseDelay_refl r).symm
  | succ k ih =>
    rw [HomRepresentative.iteratedSucc_succ, ih, raiseDelay_succ]
    simp only [Nat.add_assoc]

private theorem hom_eq_identity_of_map (r : HomRepresentative E E) (d : ℕ)
    (hd : r.delay ≤ d)
    (hm : ∀ (n : ℕ+) (hn : d ≤ (n : ℕ)) (x : powerPart E n d),
      (raiseDelay r d hd).map n hn x = (torsionPart E n d).mkQ x.1) :
    homOfRepresentative r = homOfRepresentative (identityRepresentative E) := by
  have he : raiseDelay r d hd = raiseDelay (identityRepresentative E) d (Nat.zero_le d) :=
    representative_ext rfl fun n hr _ => heq_of_eq <| LinearMap.ext (hm n hr)
  exact (hom_raiseDelay r d hd).symm.trans
    ((congrArg homOfRepresentative he).trans (hom_raiseDelay _ d (Nat.zero_le d)))

/-- A representative of the identity morphism becomes, after its delay is raised to some `d`,
the canonical map `I ^ d Eₙ → Eₙ / Eₙ[I ^ d]`. -/
theorem exists_map_eq_identity (r : HomRepresentative E E)
    (h : homOfRepresentative r = homOfRepresentative (identityRepresentative E)) :
    ∃ d, ∃ hd : r.delay ≤ d,
      ∀ (n : ℕ+) (hn : d ≤ (n : ℕ)) (x : powerPart E n d),
        (raiseDelay r d hd).map n hn x = (torsionPart E n d).mkQ x.1 := by
  obtain ⟨k, l, hkl⟩ := (homOfRepresentative_eq_iff_exists_iteratedSucc_eq _ _).mp h
  have hd : r.delay + k = l := by
    simpa [identityRepresentative] using congrArg HomRepresentative.delay hkl
  rw [iteratedSucc_eq_raiseDelay, iteratedSucc_eq_raiseDelay] at hkl
  simp only [identityRepresentative, Nat.zero_add] at hkl
  subst l
  refine ⟨r.delay + k, Nat.le_add_right _ _, ?_⟩
  intro n hn x
  exact LinearMap.congr_fun (eq_of_heq (representative_maps_heq_of_eq hkl n hn hn)) x

private theorem hom_eq_identity_of_components (r : HomRepresentative E E)
    (hm : ∀ (n : ℕ+) (hn : r.delay ≤ (n : ℕ)) (x : powerPart E n r.delay),
      r.map n hn x = (torsionPart E n r.delay).mkQ x.1) :
    homOfRepresentative r = homOfRepresentative (identityRepresentative E) :=
  hom_eq_identity_of_map r r.delay le_rfl fun n hn x =>
    (quotientTransitionOfLE_refl E n r.delay _).trans (hm n hn x)

/-- A linear map `g` whose kernel contains the kernel of `f` factors through the range of `f`. -/
theorem exists_factor_range
    {M N P : Type*} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] [AddCommGroup P] [Module A P]
    (f : M →ₗ[A] N) (g : M →ₗ[A] P) (h : f.ker ≤ g.ker) :
    ∃ t : f.range →ₗ[A] P, ∀ x, t ⟨f x, LinearMap.mem_range_self f x⟩ = g x := by
  refine ⟨(f.ker.liftQ g h).comp f.quotKerEquivRange.symm.toLinearMap, ?_⟩
  intro x
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe,
    f.quotKerEquivRange_symm_apply_image]
  rfl

private theorem exists_inverse_component (r : HomRepresentative E F) (d : ℕ)
    (n : ℕ+) (hn : r.delay ≤ (n : ℕ))
    (hk : Module.IsTorsionBySet A (r.map n hn).ker (↑(I ^ d) : Set A))
    (hc : Module.IsTorsionBySet A
      ((underlying F n ⧸ torsionPart F n r.delay) ⧸ (r.map n hn).range)
      (↑(I ^ d) : Set A)) :
    ∃ s : powerPart F n d →ₗ[A] underlying E n ⧸ torsionPart E n d,
      (∀ x : powerPart F n d, ∃ y, r.map n hn y =
        (torsionPart F n r.delay).mkQ x.1) ∧
      ∀ (x : powerPart F n d) (y : powerPart E n r.delay),
        r.map n hn y = (torsionPart F n r.delay).mkQ x.1 →
          s x = (torsionPart E n d).mkQ y.1 := by
  let f := r.map n hn
  let g := (torsionPart E n d).mkQ.comp (powerPart E n r.delay).subtype
  have hker : f.ker ≤ g.ker := fun y hy =>
    (Submodule.Quotient.mk_eq_zero _).mpr <| (Submodule.mem_torsionBySet_iff _ _).mpr fun a =>
      congrArg (fun z : f.ker => (z.1 : underlying E n)) (@hk ⟨y, hy⟩ a)
  obtain ⟨t, ht⟩ := exists_factor_range f g hker
  have hmem (x : powerPart F n d) : (torsionPart F n r.delay).mkQ x.1 ∈ f.range := by
    have hx := map_powerPart_mem (I ^ d) (torsionPart F n r.delay).mkQ x.1 x.2
    have hc' := (Module.isTorsionBySet_quotient_iff f.range _).mp hc
    exact Submodule.smul_induction_on hx (fun a ha z _ => hc' z a ha)
      fun _ _ => f.range.add_mem
  let q := ((torsionPart F n r.delay).mkQ.comp (powerPart F n d).subtype).codRestrict
    f.range hmem
  refine ⟨t.comp q, fun x => LinearMap.mem_range.mp (hmem x), fun x y hy => ?_⟩
  have he : q x = ⟨f y, LinearMap.mem_range_self f y⟩ := Subtype.ext hy.symm
  change t (q x) = g y
  rw [he, ht]

private theorem composite_eq_identity_of_inverse_components
    (r : HomRepresentative E F) (s : HomRepresentative F E)
    (hr : r.delay ≤ s.delay)
    (hlift : ∀ (n : ℕ+) (hn : s.delay ≤ (n : ℕ)) (x : powerPart F n s.delay),
      ∃ y, r.map n (hr.trans hn) y = (torsionPart F n r.delay).mkQ x.1)
    (hs : ∀ (n : ℕ+) (hn : s.delay ≤ (n : ℕ))
      (x : powerPart F n s.delay) (y : powerPart E n r.delay),
      r.map n (hr.trans hn) y = (torsionPart F n r.delay).mkQ x.1 →
