/-!
# The category of systems of modules with delayed morphisms

Let `I` be an ideal of a commutative ring `A`.  A *system of modules* in the sense of the
Stacks project assigns to every positive integer `n` a finite module `Eₙ` over `A ⧸ I ^ n`.
A morphism of such systems is not a family of maps `Eₙ → Fₙ`: it is only required to be
defined on the ideal multiples `I ^ c Eₙ` and only up to the torsion `Fₙ[I ^ c]`, for some
*delay* `c` allowed to grow.  This file builds those morphisms and the category they form,
and characterises the isomorphisms.

## Main definitions

* `Stacks.Modules.AdicSystem.AdicModuleSystem`: a positive-indexed system of finite `A ⧸ I ^
  n`-modules.
* `Stacks.Modules.AdicSystem.AdicModuleSystem.HomRepresentative`: a delayed representative of a
  morphism,
  namely a delay `c` together with `A`-linear maps `I ^ c Eₙ → Fₙ / Fₙ[I ^ c]` for `n ≥ c`.
* `Stacks.Modules.AdicSystem.AdicModuleSystem.Hom`: representatives modulo increasing the delay.
* `Stacks.Modules.AdicSystem.AdicModuleSystem.CategoryData`: the category operations on these
  morphisms
  together with their laws.

## Main results

* `Stacks.Modules.AdicSystem.AdicModuleSystem.delayedCategory`: systems of modules with delayed
  morphisms
  form a category; composition is the induced composition at delay `c + c'`.
* `Stacks.Modules.AdicSystem.AdicModuleSystem.homOfRepresentative_eq_iff_eventual_maps_eq`: two
  morphisms
  agree exactly when their component maps agree after a common finite delay.
* `Stacks.AdicModuleSystem.IsomorphismCriterion.isIso_homOfRepresentative_iff`: a representative
  `r` of delay `c` defines an
  isomorphism of systems if and only if there is a single `c'` such that, for all large `n`,
  the kernel and the cokernel of `r` at level `n` are annihilated by `I ^ c'`.

## Implementation notes

Modules over `A ⧸ I ^ n` are restricted to `A` when forming ideal multiples and torsion
submodules.  The identification of representatives is the equivalence relation generated by
the canonical one-step increase of the delay, so `Hom` is a `Quot`.  Neither construction
uses Noetherianity, so both are stated for an arbitrary commutative ring; Noetherianity
enters only through the consumers of 0EGX.

## References

* [Stacks Project, Tag 0EGW](https://stacks.math.columbia.edu/tag/0EGW)
* [Stacks Project, Tag 0EGX](https://stacks.math.columbia.edu/tag/0EGX)
-/

/-! ## Tag 0EGW -/

section

open CategoryTheory

universe u v

namespace Stacks.Modules.AdicSystem

noncomputable section


/-- A system of finitely generated modules `Eₙ` over `A ⧸ I ^ n`, indexed by positive
integers. -/
public structure AdicModuleSystem (A : Type u) [CommRing A] (I : Ideal A) where
  /-- The `n`th term `Eₙ`, a finitely generated module over `A ⧸ I ^ n`. -/
  module : (n : ℕ+) → FGModuleCat.{v} (A ⧸ I ^ (n : ℕ))

namespace AdicModuleSystem

variable {A : Type u} [CommRing A] {I : Ideal A}

/-- The underlying `A`-module of the `n`th term of an adic module system. -/
public noncomputable def underlying (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) : ModuleCat.{v} A :=
  (ModuleCat.restrictScalars (Ideal.Quotient.mk (I ^ (n : ℕ)))).obj (E.module n).obj

/-- The submodule `I ^ c Eₙ` of the `n`th term of a system. -/
public def powerPart (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c : ℕ) :
    Submodule A (underlying E n) :=
  I ^ c • ⊤

/-- The submodule `Eₙ[I ^ c]` annihilated by every element of `I ^ c`. -/
public def torsionPart (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c : ℕ) :
    Submodule A (underlying E n) :=
  Submodule.torsionBySet A (underlying E n) (↑(I ^ c) : Set A)

/-- A representative of a morphism of systems with delay `c`: for each `n ≥ c`, it is a
map `I ^ c Eₙ → Fₙ / Fₙ[I ^ c]`. -/
public structure HomRepresentative (E F : AdicModuleSystem.{u, v} A I) where
  /-- The delay `c` of the representative. -/
  delay : ℕ
  /-- The component `I ^ c Eₙ → Fₙ / Fₙ[I ^ c]` at each level `n ≥ c`. -/
  map : ∀ (n : ℕ+), delay ≤ (n : ℕ) →
    powerPart E n delay →ₗ[A] underlying F n ⧸ torsionPart F n delay

namespace HomRepresentative

/-- Increasing the exponent shrinks the ideal multiple of a module. -/
public theorem powerPart_succ_le (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c : ℕ) :
    powerPart E n (c + 1) ≤ powerPart E n c :=
  Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ c))

/-- Increasing the exponent enlarges the submodule annihilated by the ideal power. -/
public theorem torsionPart_le_succ (F : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c : ℕ) :
    torsionPart F n c ≤ torsionPart F n (c + 1) :=
  Submodule.torsionBySet_le_torsionBySet_pow c (c + 1) (Nat.le_succ c) I

/-- The canonical map from the quotient by `Fₙ[I ^ c]` to the quotient by
`Fₙ[I ^ (c + 1)]`. -/
public def quotientTransition (F : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c : ℕ) :
    (underlying F n ⧸ torsionPart F n c) →ₗ[A]
      (underlying F n ⧸ torsionPart F n (c + 1)) :=
  (torsionPart F n c).mapQ (torsionPart F n (c + 1)) LinearMap.id <| by
    simpa only [Submodule.comap_id] using torsionPart_le_succ F n c

/-- The map at level `n` induced from a representative after increasing its delay by one. -/
public def succMap {E F : AdicModuleSystem A I} (r : HomRepresentative E F)
    (n : ℕ+) (h : r.delay + 1 ≤ (n : ℕ)) :
    powerPart E n (r.delay + 1) →ₗ[A]
      underlying F n ⧸ torsionPart F n (r.delay + 1) :=
  (quotientTransition F n r.delay).comp <|
    (r.map n (le_trans (Nat.le_succ r.delay) h)).comp <|
      Submodule.inclusion (powerPart_succ_le E n r.delay)

/-- The representative induced by increasing the delay from `c` to `c + 1`. -/
public def succ {E F : AdicModuleSystem A I} (r : HomRepresentative E F) :
    HomRepresentative E F where
  delay := r.delay + 1
  map := r.succMap

end HomRepresentative

/-- The identity representative has delay zero and is the quotient map from the whole
module to the quotient by its `I ^ 0`-torsion. -/
public def identityRepresentative (E : AdicModuleSystem.{u, v} A I) :
    HomRepresentative E E where
  delay := 0
  map n _ := (torsionPart E n 0).mkQ.comp (powerPart E n 0).subtype

/-- The canonical map between torsion quotients associated to an inequality of exponents. -/
public def quotientTransitionOfLE (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {c d : ℕ} (h : c ≤ d) :
    (underlying F n ⧸ torsionPart F n c) →ₗ[A]
      (underlying F n ⧸ torsionPart F n d) :=
  (torsionPart F n c).mapQ (torsionPart F n d) LinearMap.id <| by
    simp only [Submodule.comap_id]
    change Submodule.torsionBySet A (underlying F n) (↑(I ^ c) : Set A) ≤
      Submodule.torsionBySet A (underlying F n) (↑(I ^ d) : Set A)
    exact Submodule.torsionBySet_le_torsionBySet_pow c d h I

/-- The ideal-power part at exponent `c + d` is contained in that at exponent `c`. -/
public theorem powerPart_add_le_left (E : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    (c d : ℕ) : powerPart E n (c + d) ≤ powerPart E n c :=
  Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_add_right c d))

/-- A representative `t` is the canonical composite of `r` and `s` when its delay is the
sum of their delays and its values are obtained as follows.  On an element of
`I ^ (c + c') Eₙ`, choose its image in `I ^ c' Fₙ` modulo `Fₙ[I ^ c]`, apply `s`, and
then pass from the quotient by `Gₙ[I ^ c']` to the quotient by `Gₙ[I ^ (c + c')]`.
The condition is independent of the chosen lift. -/
public def IsCanonicalComposite {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G)
    (t : HomRepresentative E G) : Prop :=
  ∃ hdelay : t.delay = r.delay + s.delay,
    ∀ (n : ℕ+) (h : r.delay + s.delay ≤ (n : ℕ))
      (x : powerPart E n (r.delay + s.delay)),
      ∃ y : powerPart F n s.delay,
        r.map n (le_trans (Nat.le_add_right r.delay s.delay) h)
            ⟨x, powerPart_add_le_left E n r.delay s.delay x.2⟩ =
          (torsionPart F n r.delay).mkQ y.1 ∧
        t.map n (hdelay ▸ h) (hdelay ▸ x) = hdelay.symm ▸
          quotientTransitionOfLE G n (Nat.le_add_left s.delay r.delay) (
            s.map n (le_trans (Nat.le_add_left s.delay r.delay) h) y)

/-- Morphisms of systems are delayed representatives modulo the equivalence generated by
identifying each representative with the one induced at the next delay. -/
public def Hom (E F : AdicModuleSystem.{u, v} A I) :=
  Quot fun r s : HomRepresentative E F => s = r.succ

/-- The morphism represented by a delayed family of linear maps. -/
public def homOfRepresentative {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) : Hom E F := Quot.mk _ r

/-- Category operations on systems with `Hom` as their morphisms. This bundles the identity,
the composition induced by the evident composites at delay `c + c'`, and all category laws. -/
public structure CategoryData where
  /-- The identity morphism of a system. -/
  id : ∀ E : AdicModuleSystem.{u, v} A I, Hom E E
  /-- The composition of morphisms of systems. -/
  comp : ∀ {E F G : AdicModuleSystem.{u, v} A I}, Hom E F → Hom F G → Hom E G
  /-- The composite of two representatives. -/
  representativeComp : ∀ {E F G : AdicModuleSystem.{u, v} A I},
    HomRepresentative E F → HomRepresentative F G → HomRepresentative E G
  /-- The composite of two representatives is their canonical composite. -/
  representativeComp_isCanonical : ∀ {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G),
    IsCanonicalComposite r s (representativeComp r s)
  /-- The identity morphism is represented by the identity representative. -/
  id_eq : ∀ E : AdicModuleSystem.{u, v} A I,
    id E = homOfRepresentative (identityRepresentative E)
  /-- Composition of morphisms is induced by the composition of representatives. -/
  comp_eq : ∀ {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G),
    comp (homOfRepresentative r) (homOfRepresentative s) =
      homOfRepresentative (representativeComp r s)
  /-- Composition with the identity on the left is trivial. -/
  id_comp : ∀ {E F : AdicModuleSystem.{u, v} A I} (f : Hom E F), comp (id E) f = f
  /-- Composition with the identity on the right is trivial. -/
  comp_id : ∀ {E F : AdicModuleSystem.{u, v} A I} (f : Hom E F), comp f (id F) = f
  /-- Composition is associative. -/
  assoc : ∀ {E F G H : AdicModuleSystem.{u, v} A I}
    (f : Hom E F) (g : Hom F G) (h : Hom G H),
    comp (comp f g) h = comp f (comp g h)

/-- The category structure underlying bundled delayed category data. -/
@[instance_reducible]
public def CategoryData.toCategory (C : CategoryData (A := A) (I := I)) :
    Category (AdicModuleSystem A I) where
  Hom := Hom
  id := C.id
  comp := C.comp
  id_comp := C.id_comp
  comp_id := C.comp_id
  assoc := C.assoc

/-- The identity morphism of the category data is the class of the identity representative. -/
@[simp]
public theorem CategoryData.id_eq_homOfRepresentative
    (C : CategoryData (A := A) (I := I)) (E : AdicModuleSystem A I) :
    C.id E = homOfRepresentative (identityRepresentative E) := C.id_eq E

/-- The composite of the classes of two representatives is the class of their composite. -/
@[simp]
public theorem CategoryData.comp_homOfRepresentative
    (C : CategoryData (A := A) (I := I)) {E F G : AdicModuleSystem A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G) :
    C.comp (homOfRepresentative r) (homOfRepresentative s) =
      homOfRepresentative (C.representativeComp r s) := C.comp_eq r s

/-- Every element of an ideal multiple in a quotient module lifts to the same ideal
multiple in the original module. -/
public theorem mem_map_mkQ_powerPart
    {M : Type v} [AddCommGroup M] [Module A M] (T : Submodule A M)
    (J : Ideal A) (x : M ⧸ T) (hx : x ∈ J • (⊤ : Submodule A (M ⧸ T))) :
    ∃ y : (J • (⊤ : Submodule A M) : Submodule A M), T.mkQ y.1 = x := by
  refine Submodule.smul_induction_on hx ?_ ?_
  · intro a ha z _
    obtain ⟨z, rfl⟩ := T.mkQ_surjective z
    exact ⟨⟨a • z, Submodule.smul_mem_smul ha Submodule.mem_top⟩, by simp⟩
  · intro x y hx hy
    obtain ⟨x, hx⟩ := hx
    obtain ⟨y, hy⟩ := hy
    refine ⟨x + y, ?_⟩
    change T.mkQ (x.1 + y.1) = _
    rw [map_add, hx, hy]

/-- A linear map sends the ideal multiple `J M` into the ideal multiple `J N`. -/
public theorem map_powerPart_mem
    {M N : Type v} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (J : Ideal A) (f : M →ₗ[A] N) (x : M) (hx : x ∈ J • (⊤ : Submodule A M)) :
    f x ∈ J • (⊤ : Submodule A N) := by
  refine Submodule.smul_induction_on hx ?_ ?_
  · intro a ha x _
    rw [map_smul]
    exact Submodule.smul_mem_smul ha Submodule.mem_top
  · intro x y hx hy
    rw [map_add]
    exact Submodule.add_mem _ hx hy

/-- An element of `J P` for a submodule `P` lifts to an element of the ideal multiple `J P`
formed inside `P` itself. -/
public theorem mem_smul_subtype_top
    {M : Type v} [AddCommGroup M] [Module A M]
    (P : Submodule A M) (J : Ideal A) (x : M) (hx : x ∈ J • P) :
    ∃ y : (J • (⊤ : Submodule A P) : Submodule A P), (y.1 : M) = x := by
  refine Submodule.smul_induction_on hx ?_ ?_
  · intro a ha z hz
    refine ⟨⟨a • (⟨z, hz⟩ : P), Submodule.smul_mem_smul ha Submodule.mem_top⟩, rfl⟩
  · intro x y hx hy
    obtain ⟨x', rfl⟩ := hx
    obtain ⟨y', rfl⟩ := hy
    refine ⟨x' + y', rfl⟩

/-- The ideal-power part at exponent `c + d` is `I ^ d` times the one at exponent `c`. -/
public theorem powerPart_add_eq_smul
    (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c d : ℕ) :
    powerPart E n (c + d) = I ^ d • powerPart E n c := by
  rw [powerPart, powerPart, pow_add, mul_comm]
  exact smul_assoc _ _ _

/-- If every product `a * b` with `a ∈ I ^ c` and `b ∈ I ^ d` sends `z` into `N`, then so does
every element of `I ^ (c + d)`. -/
private theorem smul_mem_of_mul_smul_mem {M : Type v} [AddCommGroup M] [Module A M]
    (N : Submodule A M) (c d : ℕ) (z : M)
    (h : ∀ a ∈ I ^ c, ∀ b ∈ I ^ d, (a * b) • z ∈ N) (t : A) (ht : t ∈ I ^ (c + d)) :
    t • z ∈ N := by
  rw [pow_add] at ht
  refine Submodule.mul_induction_on ht h fun a b ha hb => ?_
  rw [add_smul]
  exact N.add_mem ha hb

/-- An element whose class modulo `M[I ^ d]` is killed by `I ^ c` is itself killed by
`I ^ (c + d)`. -/
public theorem torsion_quotient_lift
    {M : Type v} [AddCommGroup M] [Module A M] (c d : ℕ) (z : M)
    (hz : (Submodule.torsionBySet A M (↑(I ^ d) : Set A)).mkQ z ∈
      Submodule.torsionBySet A
        (M ⧸ Submodule.torsionBySet A M (↑(I ^ d) : Set A))
        (↑(I ^ c) : Set A)) :
    z ∈ Submodule.torsionBySet A M (↑(I ^ (c + d)) : Set A) := by
  rw [Submodule.mem_torsionBySet_iff] at hz ⊢
  intro ⟨t, ht⟩
  change t • z = 0
  refine (Submodule.mem_bot A).mp
    (smul_mem_of_mul_smul_mem ⊥ c d z (fun a ha b hb => ?_) t ht)
  rw [Submodule.mem_bot]
  have hza : a • z ∈ Submodule.torsionBySet A M (↑(I ^ d) : Set A) := by
    have h := hz ⟨a, ha⟩
    rw [← map_smul] at h
    exact (Submodule.Quotient.mk_eq_zero _).mp h
  have hzb := (Submodule.mem_torsionBySet_iff _ _).mp hza ⟨b, hb⟩
  simpa only [mul_smul, smul_comm b a z] using hzb

/-- The transition from the quotient by `Gₙ[I ^ d]` to the quotient by `Gₙ[I ^ (c + d)]`
kills every element annihilated by `I ^ c`. -/
public theorem quotientTransitionOfLE_eq_zero_of_torsion
    (G : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c d : ℕ)
    (z : underlying G n ⧸ torsionPart G n d)
    (hz : z ∈ Submodule.torsionBySet A
      (underlying G n ⧸ torsionPart G n d) (↑(I ^ c) : Set A)) :
    quotientTransitionOfLE G n (Nat.le_add_left d c) z = 0 := by
  induction z using Submodule.Quotient.induction_on with
  | H z =>
    have h := torsion_quotient_lift (I := I) c d z hz
    change (torsionPart G n (c + d)).mkQ z = 0
    exact (Submodule.Quotient.mk_eq_zero _).mpr h

/-- The transition between torsion quotients sends the class of `x` to the class of `x`. -/
public theorem quotientTransitionOfLE_mkQ
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {c d : ℕ} (h : c ≤ d) (x : underlying F n) :
    quotientTransitionOfLE F n h ((torsionPart F n c).mkQ x) =
      (torsionPart F n d).mkQ x := rfl

/-- The transitions between torsion quotients compose. -/
public theorem quotientTransitionOfLE_comp
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {a b c : ℕ} (hab : a ≤ b) (hbc : b ≤ c)
    (x : underlying F n ⧸ torsionPart F n a) :
    quotientTransitionOfLE F n hbc (quotientTransitionOfLE F n hab x) =
      quotientTransitionOfLE F n (hab.trans hbc) x := by
  induction x using Submodule.Quotient.induction_on with
  | H x => rfl

/-- The transition between torsion quotients along `c ≤ c` is the identity. -/
public theorem quotientTransitionOfLE_refl
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    (c : ℕ) (x : underlying F n ⧸ torsionPart F n c) :
    quotientTransitionOfLE F n (le_refl c) x = x := by
  induction x using Submodule.Quotient.induction_on with
  | H x => rfl

/-- The transition between torsion quotients along an equality of exponents is the identity, up
to the identification of the two quotients. -/
public theorem quotientTransitionOfLE_heq_of_eq
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {c d : ℕ} (h : c = d)
    (x : underlying F n ⧸ torsionPart F n c) :
    HEq (quotientTransitionOfLE F n (le_of_eq h) x) x := by
  cases h
  exact heq_of_eq (quotientTransitionOfLE_refl F n c x)

/-- For equal exponents, the classes of `x` in the two torsion quotients agree. -/
public theorem quotient_mkQ_heq_of_eq
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {c d : ℕ} (h : c = d) (x : underlying F n) :
    HEq ((torsionPart F n c).mkQ x) ((torsionPart F n d).mkQ x) := by
  cases h
  rfl

/-- Transitions to torsion quotients with equal target exponents agree. -/
public theorem quotientTransitionOfLE_heq_target
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {a b c : ℕ} (h : b = c) (hab : a ≤ b) (hac : a ≤ c)
    (x : underlying F n ⧸ torsionPart F n a) :
    HEq (quotientTransitionOfLE F n hab x)
      (quotientTransitionOfLE F n hac x) := by
  cases h
  exact HEq.rfl

/-- The kernel of `I ^ c' Fₙ → Fₙ / Fₙ[I ^ c]` is contained in the kernel of the map
`I ^ c' Fₙ → Gₙ / Gₙ[I ^ (c + c')]` induced by a representative `s` of delay `c'`. -/
public theorem composite_kernel_le
    {F G : AdicModuleSystem.{u, v} A I}
    (s : HomRepresentative F G) (n : ℕ+) (h : s.delay ≤ (n : ℕ)) (c : ℕ) :
    LinearMap.ker ((torsionPart F n c).mkQ.comp
      (powerPart F n s.delay).subtype) ≤
      LinearMap.ker ((quotientTransitionOfLE G n
        (Nat.le_add_left s.delay c)).comp (s.map n h)) := by
  intro y hy
  rw [LinearMap.mem_ker] at hy ⊢
  have hyT : (y : underlying F n) ∈ torsionPart F n c :=
    (Submodule.Quotient.mk_eq_zero _).mp hy
  have hz : s.map n h y ∈ Submodule.torsionBySet A
      (underlying G n ⧸ torsionPart G n s.delay) (↑(I ^ c) : Set A) := by
    rw [Submodule.mem_torsionBySet_iff]
    intro ⟨a, ha⟩
    rw [← map_smul]
    have hay : (a : A) • y = 0 :=
      Subtype.ext ((Submodule.mem_torsionBySet_iff _ _).mp hyT ⟨a, ha⟩)
    rw [hay, map_zero]
  exact quotientTransitionOfLE_eq_zero_of_torsion G n c s.delay _ hz

/-- The image under a representative `r` of delay `c` of an element of `I ^ (c + d) Eₙ` is the
class of an element of `I ^ d Fₙ`. -/
public theorem composite_lift
    {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (d : ℕ) (n : ℕ+)
    (h : r.delay + d ≤ (n : ℕ)) (x : powerPart E n (r.delay + d)) :
    ∃ y : powerPart F n d,
      r.map n (le_trans (Nat.le_add_right r.delay d) h)
        ⟨x, powerPart_add_le_left E n r.delay d x.2⟩ =
        (torsionPart F n r.delay).mkQ y.1 := by
  have hx : (x : underlying E n) ∈ I ^ d • powerPart E n r.delay := by
    rw [← powerPart_add_eq_smul]
    exact x.2
  obtain ⟨y, hy⟩ := mem_smul_subtype_top (powerPart E n r.delay) (I ^ d) _ hx
  have hxy : (⟨x, powerPart_add_le_left E n r.delay d x.2⟩ :
      powerPart E n r.delay) = y.1 := Subtype.ext hy.symm
  have hmap : r.map n (le_trans (Nat.le_add_right r.delay d) h)
      ⟨x, powerPart_add_le_left E n r.delay d x.2⟩ ∈
      I ^ d • (⊤ : Submodule A (underlying F n ⧸ torsionPart F n r.delay)) := by
    rw [hxy]
    exact map_powerPart_mem (I ^ d)
      (r.map n (le_trans (Nat.le_add_right r.delay d) h)) y.1 y.2
  obtain ⟨z, hz⟩ := mem_map_mkQ_powerPart
    (torsionPart F n r.delay) (I ^ d) _ hmap
  exact ⟨z, hz.symm⟩

/-- The map `I ^ d Fₙ → Fₙ / Fₙ[I ^ c]` induced by the inclusion. -/
public def compositeSourceMap
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+) (c d : ℕ) :
    powerPart F n d →ₗ[A] underlying F n ⧸ torsionPart F n c :=
  (torsionPart F n c).mkQ.comp (powerPart F n d).subtype

/-- The map `I ^ c' Fₙ → Gₙ / Gₙ[I ^ (c + c')]` induced by a representative `s` of delay `c'`. -/
public def compositeTargetMap
    {F G : AdicModuleSystem.{u, v} A I}
    (s : HomRepresentative F G) (n : ℕ+)
    (h : s.delay ≤ (n : ℕ)) (c : ℕ) :
    powerPart F n s.delay →ₗ[A]
      underlying G n ⧸ torsionPart G n (c + s.delay) :=
  (quotientTransitionOfLE G n (Nat.le_add_left s.delay c)).comp (s.map n h)

/-- The map `I ^ (c + c') Eₙ → Fₙ / Fₙ[I ^ c]` induced by a representative `r` of delay `c`,
with values in the image of `I ^ c' Fₙ`. -/
public def compositeRangeMap
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G)
    (n : ℕ+) (h : r.delay + s.delay ≤ (n : ℕ)) :
    powerPart E n (r.delay + s.delay) →ₗ[A]
      LinearMap.range (compositeSourceMap F n r.delay s.delay) := by
  let fr : powerPart E n (r.delay + s.delay) →ₗ[A]
      underlying F n ⧸ torsionPart F n r.delay :=
    (r.map n (le_trans (Nat.le_add_right r.delay s.delay) h)).comp
      (Submodule.inclusion (powerPart_add_le_left E n r.delay s.delay))
  exact fr.codRestrict (LinearMap.range (compositeSourceMap F n r.delay s.delay)) (by
    intro x
    obtain ⟨y, hy⟩ := composite_lift r s.delay n h x
    exact ⟨y, hy.symm⟩)

/-- The component at level `n` of the canonical composite of `r` and `s`: lift the image of an
element of `I ^ (c + c') Eₙ` under `r` to `I ^ c' Fₙ`, apply `s`, and pass to the quotient by
`Gₙ[I ^ (c + c')]`. -/
public noncomputable def canonicalCompositeMap
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G)
    (n : ℕ+) (h : r.delay + s.delay ≤ (n : ℕ)) :
    powerPart E n (r.delay + s.delay) →ₗ[A]
      underlying G n ⧸ torsionPart G n (r.delay + s.delay) :=
  let k := compositeSourceMap F n r.delay s.delay
  ((LinearMap.ker k).liftQ
    (compositeTargetMap s n (le_trans (Nat.le_add_left s.delay r.delay) h) r.delay)
    (composite_kernel_le s n (le_trans (Nat.le_add_left s.delay r.delay) h)
      r.delay)).comp
    (k.quotKerEquivRange.symm.toLinearMap.comp (compositeRangeMap r s n h))

/-- The canonical composite map may be computed through any lift of the image under `r`. -/
public theorem canonicalCompositeMap_apply_lift
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G)
    (n : ℕ+) (h : r.delay + s.delay ≤ (n : ℕ))
    (x : powerPart E n (r.delay + s.delay))
    (y : powerPart F n s.delay)
    (hy : r.map n (le_trans (Nat.le_add_right r.delay s.delay) h)
        ⟨x, powerPart_add_le_left E n r.delay s.delay x.2⟩ =
      (torsionPart F n r.delay).mkQ y.1) :
    canonicalCompositeMap r s n h x =
      quotientTransitionOfLE G n (Nat.le_add_left s.delay r.delay)
        (s.map n (le_trans (Nat.le_add_left s.delay r.delay) h) y) := by
  let k := compositeSourceMap F n r.delay s.delay
  have harg : compositeRangeMap r s n h x =
      ⟨k y, LinearMap.mem_range_self k y⟩ :=
    Subtype.ext hy
  simp only [canonicalCompositeMap, LinearMap.comp_apply, harg]
  change ((LinearMap.ker k).liftQ
      (compositeTargetMap s n (le_trans (Nat.le_add_left s.delay r.delay) h)
        r.delay) _)
      (k.quotKerEquivRange.symm ⟨k y, LinearMap.mem_range_self k y⟩) =
    (compositeTargetMap s n (le_trans (Nat.le_add_left s.delay r.delay) h)
      r.delay) y
  rw [show k.quotKerEquivRange.symm ⟨k y, LinearMap.mem_range_self k y⟩ =
    (LinearMap.ker k).mkQ y from k.quotKerEquivRange_symm_apply_image y _]
  rfl

/-- The canonical composite of two representatives, of delay the sum of their delays. -/
public noncomputable def representativeComp
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G) :
    HomRepresentative E G where
  delay := r.delay + s.delay
  map := canonicalCompositeMap r s

/-- The composite of two representatives is a canonical composite. -/
public theorem representativeComp_isCanonical
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G) :
    IsCanonicalComposite r s (representativeComp r s) := by
  refine ⟨rfl, fun n h x => ?_⟩
  obtain ⟨y, hy⟩ := composite_lift r s.delay n h x
  exact ⟨y, hy, canonicalCompositeMap_apply_lift r s n h x y hy⟩

/-- Two representatives with the same delay and the same components are equal. -/
public theorem representative_ext
    {E F : AdicModuleSystem.{u, v} A I}
    {r s : HomRepresentative E F} (hd : r.delay = s.delay)
    (hm : ∀ (n : ℕ+) (hr : r.delay ≤ (n : ℕ)) (hs : s.delay ≤ (n : ℕ)),
      HEq (r.map n hr) (s.map n hs)) : r = s := by
  cases r with
  | mk c f =>
    cases s with
    | mk d g =>
      dsimp at hd
      subst d
      have hfg : f = g := by
        funext n hn
        exact eq_of_heq (hm n hn hn)
      cases hfg
      rfl

/-- Two representatives with the same delay whose components agree on every element are equal. -/
public theorem representative_ext_of_pointwise
    {E F : AdicModuleSystem.{u, v} A I}
    {r s : HomRepresentative E F} (hd : r.delay = s.delay)
    (hm : ∀ (n : ℕ+) (hr : r.delay ≤ (n : ℕ)) (hs : s.delay ≤ (n : ℕ))
      (x : powerPart E n r.delay) (y : powerPart E n s.delay),
      HEq x y → HEq (r.map n hr x) (s.map n hs y)) : r = s := by
  refine representative_ext hd fun n hr hs => ?_
  cases r with
  | mk c f =>
    cases s with
    | mk d g =>
      dsimp at hd hr hs ⊢
      subst d
      exact heq_of_eq (LinearMap.ext fun x => eq_of_heq (hm n hr hs x x HEq.rfl))

/-- The ideal-power part at exponent zero is the whole module. -/
public theorem powerPart_zero_eq_top
    (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) :
    powerPart E n 0 = ⊤ := by
  simp [powerPart]

/-- The ideal-power parts decrease as the exponent increases. -/
public theorem powerPart_antitone
    (E : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {c d : ℕ} (h : c ≤ d) : powerPart E n d ≤ powerPart E n c :=
  Submodule.smul_mono_left (Ideal.pow_le_pow_right h)

/-- Elements of ideal-power parts with equal exponents that agree have the same underlying
element. -/
public theorem powerPart_val_eq_of_heq
    (E : AdicModuleSystem.{u, v} A I) (n : ℕ+)
    {c d : ℕ} (h : c = d)
    (x : powerPart E n c) (y : powerPart E n d) (hxy : HEq x y) :
    (x : underlying E n) = y := by
  cases h
  exact congrArg Subtype.val (eq_of_heq hxy)

/-- The successor of a representative restricts its argument and passes to the next torsion
quotient. -/
public theorem succMap_apply
    {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (n : ℕ+)
    (h : r.delay + 1 ≤ (n : ℕ))
    (x : powerPart E n (r.delay + 1)) :
    r.succ.map n h x =
      quotientTransitionOfLE F n (Nat.le_succ r.delay)
        (r.map n (le_trans (Nat.le_succ r.delay) h)
          ⟨x, HomRepresentative.powerPart_succ_le E n r.delay x.2⟩) :=
  rfl

/-- The submodule annihilated by `I ^ 0` is zero. -/
public theorem torsionPart_zero_eq_bot
    (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) :
    torsionPart E n 0 = ⊥ := by
  simp [torsionPart]

/-- Composing with the identity representative on the left is trivial. -/
public theorem representativeComp_identity_left
    {E F : AdicModuleSystem.{u, v} A I} (r : HomRepresentative E F) :
    representativeComp (identityRepresentative E) r = r := by
  apply representative_ext_of_pointwise
    (r := representativeComp (identityRepresentative E) r) (s := r)
    (by simp [representativeComp, identityRepresentative])
  intro n hr hs x y hxy
  have hd : (identityRepresentative E).delay + r.delay = r.delay := by
    simp [identityRepresentative]
  have hv : (x : underlying E n) = y :=
    powerPart_val_eq_of_heq E n hd x y hxy
  have hy : (identityRepresentative E).map n
      (le_trans (Nat.le_add_right (identityRepresentative E).delay r.delay) hr)
      ⟨x, powerPart_add_le_left E n
        (identityRepresentative E).delay r.delay x.2⟩ =
      (torsionPart E n (identityRepresentative E).delay).mkQ y.1 := by
    simp only [identityRepresentative, hv]
    rfl
  have heval := canonicalCompositeMap_apply_lift
    (identityRepresentative E) r n hr x y hy
  exact (heq_of_eq heval).trans
    (quotientTransitionOfLE_heq_of_eq F n hd.symm (r.map n hs y))

/-- Composing with the identity representative on the right is trivial. -/
public theorem representativeComp_identity_right
    {E F : AdicModuleSystem.{u, v} A I} (r : HomRepresentative E F) :
    representativeComp r (identityRepresentative F) = r := by
  apply representative_ext_of_pointwise
    (r := representativeComp r (identityRepresentative F)) (s := r)
    (by simp [representativeComp, identityRepresentative])
  intro n hr hs x y hxy
  have hd : r.delay + (identityRepresentative F).delay = r.delay := by
    simp [identityRepresentative]
  have hv : (x : underlying E n) = y :=
    powerPart_val_eq_of_heq E n hd x y hxy
  have hxy' : (⟨x, powerPart_add_le_left E n r.delay
      (identityRepresentative F).delay x.2⟩ : powerPart E n r.delay) = y :=
    Subtype.ext hv
  obtain ⟨z, hz⟩ := (torsionPart F n r.delay).mkQ_surjective (r.map n hs y)
  let z₀ : powerPart F n (identityRepresentative F).delay :=
    ⟨z, by
      rw [show (identityRepresentative F).delay = 0 from rfl, powerPart_zero_eq_top]
      trivial⟩
  have hy : r.map n
      (le_trans (Nat.le_add_right r.delay (identityRepresentative F).delay) hr)
      ⟨x, powerPart_add_le_left E n r.delay
        (identityRepresentative F).delay x.2⟩ =
      (torsionPart F n r.delay).mkQ z₀.1 := by
    rw [hxy']
    exact hz.symm
  have heval := canonicalCompositeMap_apply_lift
    r (identityRepresentative F) n hr x z₀ hy
  have hmk : quotientTransitionOfLE F n
      (Nat.le_add_left (identityRepresentative F).delay r.delay)
      ((identityRepresentative F).map n
        (le_trans (Nat.le_add_left (identityRepresentative F).delay r.delay) hr) z₀) =
      (torsionPart F n (r.delay + (identityRepresentative F).delay)).mkQ z :=
    rfl
  exact (heq_of_eq (heval.trans hmk)).trans
    ((quotient_mkQ_heq_of_eq F n hd z).trans (heq_of_eq hz))

/-- Two transitions out of the same quotient, to quotients with equal exponents, agree up to
`HEq`. -/
private theorem heq_of_quotientTransitionOfLE_eq
    (F : AdicModuleSystem.{u, v} A I) (n : ℕ+) {a b c : ℕ} (h : b = c) {hab : a ≤ b}
    {hac : a ≤ c} {x : underlying F n ⧸ torsionPart F n a} {u : underlying F n ⧸ torsionPart F n b}
    {v : underlying F n ⧸ torsionPart F n c} (hu : u = quotientTransitionOfLE F n hab x)
    (hv : v = quotientTransitionOfLE F n hac x) : HEq u v :=
  (heq_of_eq hu).trans ((quotientTransitionOfLE_heq_target F n h hab hac x).trans
    (heq_of_eq hv).symm)

/-- The successor of a composite of `r` and `s` sends `y` to the transition of `s` applied to
any lift `z` of the image under `r` of `y`. -/
private theorem representativeComp_succ_map_eq
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G) (n : ℕ+)
    (hr : (representativeComp r s).succ.delay ≤ (n : ℕ)) (hbase : r.delay + s.delay ≤ (n : ℕ))
    (y : powerPart E n (representativeComp r s).succ.delay)
    (y₀ : powerPart E n (r.delay + s.delay)) (hy : (y₀ : underlying E n) = y)
    (z : powerPart F n s.delay)
    (hz : r.map n (le_trans (Nat.le_add_right r.delay s.delay) hbase)
      ⟨y₀, powerPart_add_le_left E n r.delay s.delay y₀.2⟩ =
        (torsionPart F n r.delay).mkQ z.1) :
    (representativeComp r s).succ.map n hr y =
      quotientTransitionOfLE G n
        ((Nat.le_add_left s.delay r.delay).trans (Nat.le_succ (r.delay + s.delay)))
        (s.map n (le_trans (Nat.le_add_left s.delay r.delay) hbase) z) := by
  have hy₀ : y₀ = ⟨y, HomRepresentative.powerPart_succ_le E n _ y.2⟩ := Subtype.ext hy
  change quotientTransitionOfLE G n (Nat.le_succ (r.delay + s.delay))
    (canonicalCompositeMap r s n hbase ⟨y, _⟩) = _
  rw [← hy₀, canonicalCompositeMap_apply_lift r s n hbase y₀ z hz]
  exact quotientTransitionOfLE_comp G n
    (Nat.le_add_left s.delay r.delay) (Nat.le_succ (r.delay + s.delay)) _

/-- Composing the successor of `r` with `s` gives the successor of the composite of `r` and `s`. -/
public theorem representativeComp_succ_left
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G) :
    representativeComp r.succ s = (representativeComp r s).succ := by
  have hd : (r.delay + 1) + s.delay = (r.delay + s.delay) + 1 := by omega
  apply representative_ext_of_pointwise
    (r := representativeComp r.succ s) (s := (representativeComp r s).succ)
    (by simpa [representativeComp, HomRepresentative.succ] using hd)
  intro n hl hr x y hxy
  have hv : (x : underlying E n) = y :=
    powerPart_val_eq_of_heq E n hd x y hxy
  have hbase : r.delay + s.delay ≤ (n : ℕ) := by
    have := hr
    dsimp [representativeComp, HomRepresentative.succ] at this
    omega
  let y₀ : powerPart E n (r.delay + s.delay) :=
    ⟨y, HomRepresentative.powerPart_succ_le E n (r.delay + s.delay) y.2⟩
  obtain ⟨z, hz⟩ := composite_lift r s.delay n hbase y₀
  let x₁ : powerPart E n (r.delay + 1) :=
    ⟨x, powerPart_add_le_left E n (r.delay + 1) s.delay x.2⟩
  let x₀ : powerPart E n r.delay :=
    ⟨x₁, HomRepresentative.powerPart_succ_le E n r.delay x₁.2⟩
  let y₁ : powerPart E n r.delay :=
    ⟨y₀, powerPart_add_le_left E n r.delay s.delay y₀.2⟩
  have hxy₁ : x₀ = y₁ := Subtype.ext hv
  have hleftlift : r.succ.map n
      (le_trans (Nat.le_add_right (r.delay + 1) s.delay) hl) x₁ =
      (torsionPart F n (r.delay + 1)).mkQ z.1 := by
    change quotientTransitionOfLE F n (Nat.le_succ r.delay)
      (r.map n _ x₀) = _
    rw [hxy₁, hz]
    exact quotientTransitionOfLE_mkQ F n (Nat.le_succ r.delay) z.1
  have hleft := canonicalCompositeMap_apply_lift r.succ s n hl x z hleftlift
  exact heq_of_quotientTransitionOfLE_eq G n hd hleft
    (representativeComp_succ_map_eq r s n hr hbase y y₀ rfl z hz)

/-- Composing `r` with the successor of `s` gives the successor of the composite of `r` and `s`. -/
public theorem representativeComp_succ_right
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G) :
    representativeComp r s.succ = (representativeComp r s).succ := by
  have hd : r.delay + (s.delay + 1) = (r.delay + s.delay) + 1 := by omega
  apply representative_ext_of_pointwise
    (r := representativeComp r s.succ) (s := (representativeComp r s).succ)
    (by simpa [representativeComp, HomRepresentative.succ] using hd)
  intro n hl hr x y hxy
  have hv : (x : underlying E n) = y :=
    powerPart_val_eq_of_heq E n hd x y hxy
  have hbase : r.delay + s.delay ≤ (n : ℕ) := by
    have := hr
    dsimp [representativeComp, HomRepresentative.succ] at this
    omega
  let y₀ : powerPart E n (r.delay + s.delay) :=
    ⟨y, HomRepresentative.powerPart_succ_le E n (r.delay + s.delay) y.2⟩
  obtain ⟨z, hz⟩ := composite_lift r (s.delay + 1) n hl x
  let z₀ : powerPart F n s.delay :=
    ⟨z, HomRepresentative.powerPart_succ_le F n s.delay z.2⟩
  let x₁ : powerPart E n r.delay :=
    ⟨x, powerPart_add_le_left E n r.delay (s.delay + 1) x.2⟩
  let y₁ : powerPart E n r.delay :=
    ⟨y₀, powerPart_add_le_left E n r.delay s.delay y₀.2⟩
  have hxy₁ : x₁ = y₁ := Subtype.ext hv
  have hy : r.map n (le_trans (Nat.le_add_right r.delay s.delay) hbase) y₁ =
      (torsionPart F n r.delay).mkQ z₀.1 := by
    rwa [← hxy₁]
  have hleft := canonicalCompositeMap_apply_lift r s.succ n hl x z hz
  have hsucc : s.succ.map n
      (le_trans (Nat.le_add_left s.succ.delay r.delay) hl) z =
      quotientTransitionOfLE G n (Nat.le_succ s.delay)
        (s.map n (le_trans (Nat.le_add_left s.delay r.delay) hbase) z₀) :=
    rfl
  have hleft' : canonicalCompositeMap r s.succ n hl x =
      quotientTransitionOfLE G n
        ((Nat.le_succ s.delay).trans
          (Nat.le_add_left (s.delay + 1) r.delay))
        (s.map n (le_trans (Nat.le_add_left s.delay r.delay) hbase) z₀) := by
    rw [hleft, hsucc]
    exact quotientTransitionOfLE_comp G n
      (Nat.le_succ s.delay) (Nat.le_add_left (s.delay + 1) r.delay) _
  exact heq_of_quotientTransitionOfLE_eq G n hd hleft'
    (representativeComp_succ_map_eq r s n hr hbase y y₀ rfl z₀ hy)

/-- The composition of representatives is associative. -/
public theorem representativeComp_assoc
    {E F G H : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G)
    (t : HomRepresentative G H) :
    representativeComp (representativeComp r s) t =
      representativeComp r (representativeComp s t) := by
  have hd : (r.delay + s.delay) + t.delay =
      r.delay + (s.delay + t.delay) := Nat.add_assoc _ _ _
  apply representative_ext_of_pointwise
    (r := representativeComp (representativeComp r s) t)
    (s := representativeComp r (representativeComp s t))
    (by simpa [representativeComp] using hd)
  intro n hl hr x y hxy
  have hv : (x : underlying E n) = y :=
    powerPart_val_eq_of_heq E n hd x y hxy
  have hrs : r.delay + s.delay ≤ (n : ℕ) := by
    have := hl
    dsimp [representativeComp] at this
    omega
  have hst : s.delay + t.delay ≤ (n : ℕ) := by
    have := hr
    dsimp [representativeComp] at this
    omega
  let x₀ : powerPart E n (r.delay + s.delay) :=
    ⟨x, powerPart_add_le_left E n (r.delay + s.delay) t.delay x.2⟩
  obtain ⟨v, hvLift⟩ := composite_lift r (s.delay + t.delay) n hr y
  let v₀ : powerPart F n s.delay :=
    ⟨v, powerPart_add_le_left F n s.delay t.delay v.2⟩
  let xr : powerPart E n r.delay :=
    ⟨x₀, powerPart_add_le_left E n r.delay s.delay x₀.2⟩
  let yr : powerPart E n r.delay :=
    ⟨y, powerPart_add_le_left E n r.delay (s.delay + t.delay) y.2⟩
  have hxr : xr = yr := Subtype.ext hv
  have hrv : r.map n (le_trans (Nat.le_add_right r.delay s.delay) hrs) xr =
      (torsionPart F n r.delay).mkQ v₀.1 := by
    rwa [hxr]
  obtain ⟨w, hw⟩ := composite_lift s t.delay n hst v
  have hcompRS := canonicalCompositeMap_apply_lift r s n hrs x₀ v₀ hrv
  have hcompRS' : canonicalCompositeMap r s n hrs x₀ =
      (torsionPart G n (r.delay + s.delay)).mkQ w.1 := by
    rw [hcompRS, hw]
    exact quotientTransitionOfLE_mkQ G n
      (Nat.le_add_left s.delay r.delay) w.1
  have hleft := canonicalCompositeMap_apply_lift
    (representativeComp r s) t n hl x w hcompRS'
  have hcompST := canonicalCompositeMap_apply_lift s t n hst v w hw
  have hright := canonicalCompositeMap_apply_lift
    r (representativeComp s t) n hr y v hvLift
  have hright' : canonicalCompositeMap r (representativeComp s t) n hr y =
      quotientTransitionOfLE H n
        ((Nat.le_add_left t.delay s.delay).trans
          (Nat.le_add_left (s.delay + t.delay) r.delay))
        (t.map n (le_trans (Nat.le_add_left t.delay s.delay) hst) w) := by
    rw [hright]
    change quotientTransitionOfLE H n (Nat.le_add_left (s.delay + t.delay) r.delay)
      (canonicalCompositeMap s t n hst v) = _
    rw [hcompST]
    exact quotientTransitionOfLE_comp H n
      (Nat.le_add_left t.delay s.delay)
      (Nat.le_add_left (s.delay + t.delay) r.delay) _
  exact heq_of_quotientTransitionOfLE_eq H n hd hleft hright'

/-- A representative and its successor represent the same morphism. -/
public theorem homOfRepresentative_succ
    {E F : AdicModuleSystem.{u, v} A I} (r : HomRepresentative E F) :
    homOfRepresentative r.succ = homOfRepresentative r :=
  (Quot.sound (r := fun x y : HomRepresentative E F => y = x.succ)
    (a := r) (b := r.succ) rfl).symm

/-- Increase the delay of a representative a finite number of times. -/
public def HomRepresentative.iteratedSucc {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (k : ℕ) : HomRepresentative E F :=
  Nat.rec r (fun _ t => t.succ) k

/-- Raising the delay zero times does nothing. -/
@[simp]
public theorem HomRepresentative.iteratedSucc_zero {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) : r.iteratedSucc 0 = r := rfl

/-- Raising the delay `k + 1` times is the successor of raising it `k` times. -/
@[simp]
public theorem HomRepresentative.iteratedSucc_succ {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (k : ℕ) :
    r.iteratedSucc (k + 1) = (r.iteratedSucc k).succ := rfl

/-- Raising the delay `k + l` times is raising it `k` times and then `l` times. -/
public theorem HomRepresentative.iteratedSucc_add {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (k l : ℕ) :
    r.iteratedSucc (k + l) = (r.iteratedSucc k).iteratedSucc l := by
  induction l with
  | zero => simp
  | succ l ih => simp only [Nat.add_succ, iteratedSucc_succ, ih]

/-- Raising the delay `k` times adds `k` to the delay. -/
@[simp]
public theorem HomRepresentative.iteratedSucc_delay {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (k : ℕ) :
    (r.iteratedSucc k).delay = r.delay + k := by
  induction k with
  | zero => rfl
  | succ k ih => simp only [iteratedSucc_succ, succ, ih, Nat.add_succ]

/-- Raising the delay of a representative does not change the morphism it represents. -/
public theorem homOfRepresentative_iteratedSucc {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (k : ℕ) :
    homOfRepresentative (r.iteratedSucc k) = homOfRepresentative r := by
  induction k with
  | zero => rfl
  | succ k ih => rw [HomRepresentative.iteratedSucc_succ, homOfRepresentative_succ, ih]

/-- Two delayed representatives give the same morphism exactly when their successors
agree after some common increase in delay. Equality of the resulting representatives
includes equality of every component map. -/
public theorem homOfRepresentative_eq_iff_exists_iteratedSucc_eq
    {E F : AdicModuleSystem.{u, v} A I} (r s : HomRepresentative E F) :
    homOfRepresentative r = homOfRepresentative s ↔
      ∃ k l : ℕ, r.iteratedSucc k = s.iteratedSucc l := by
  constructor
  · intro h
    have hgen : Relation.EqvGen
        (fun a b : HomRepresentative E F => b = a.succ) r s :=
      Quot.eqvGen_exact h
    clear h
    induction hgen with
    | rel a b hab => exact ⟨1, 0, hab.symm⟩
    | refl a => exact ⟨0, 0, rfl⟩
    | symm a b _ ih =>
        obtain ⟨k, l, hkl⟩ := ih
        exact ⟨l, k, hkl.symm⟩
    | trans a b c _ _ ih₁ ih₂ =>
        obtain ⟨k, l, hkl⟩ := ih₁
        obtain ⟨m, n, hmn⟩ := ih₂
        refine ⟨k + m, n + l, ?_⟩
        calc
          a.iteratedSucc (k + m) = (a.iteratedSucc k).iteratedSucc m :=
            HomRepresentative.iteratedSucc_add a k m
          _ = (b.iteratedSucc l).iteratedSucc m := congrArg (·.iteratedSucc m) hkl
          _ = b.iteratedSucc (m + l) := by rw [← HomRepresentative.iteratedSucc_add, Nat.add_comm]
          _ = (b.iteratedSucc m).iteratedSucc l := HomRepresentative.iteratedSucc_add b m l
          _ = (c.iteratedSucc n).iteratedSucc l := congrArg (·.iteratedSucc l) hmn
          _ = c.iteratedSucc (n + l) := (HomRepresentative.iteratedSucc_add c n l).symm
  · rintro ⟨k, l, hkl⟩
    exact (homOfRepresentative_iteratedSucc r k).symm.trans
      ((congrArg homOfRepresentative hkl).trans (homOfRepresentative_iteratedSucc s l))

/-- Equal representatives have the same components. -/
public theorem representative_maps_heq_of_eq
    {E F : AdicModuleSystem.{u, v} A I} {r s : HomRepresentative E F}
    (h : r = s) (n : ℕ+) (hr : r.delay ≤ (n : ℕ)) (hs : s.delay ≤ (n : ℕ)) :
    HEq (r.map n hr) (s.map n hs) := by
  cases h
  exact HEq.rfl

/-- Equality of morphisms can be tested componentwise after a common finite delay. -/
public theorem homOfRepresentative_eq_iff_eventual_maps_eq
    {E F : AdicModuleSystem.{u, v} A I} (r s : HomRepresentative E F) :
    homOfRepresentative r = homOfRepresentative s ↔
      ∃ k l : ℕ,
        r.delay + k = s.delay + l ∧
        ∀ (n : ℕ+)
          (hr : (r.iteratedSucc k).delay ≤ (n : ℕ))
          (hs : (s.iteratedSucc l).delay ≤ (n : ℕ)),
          HEq ((r.iteratedSucc k).map n hr) ((s.iteratedSucc l).map n hs) := by
  rw [homOfRepresentative_eq_iff_exists_iteratedSucc_eq]
  constructor
  · rintro ⟨k, l, h⟩
    refine ⟨k, l, ?_, representative_maps_heq_of_eq h⟩
    simpa only [HomRepresentative.iteratedSucc_delay] using congrArg HomRepresentative.delay h
  · rintro ⟨k, l, hd, hm⟩
    refine ⟨k, l, representative_ext ?_ hm⟩
    simpa only [HomRepresentative.iteratedSucc_delay] using hd

/-- The composition of morphisms of systems, induced by the composition of representatives. -/
public noncomputable def delayedComp
    {E F G : AdicModuleSystem.{u, v} A I}
    (f : Hom E F) (g : Hom F G) : Hom E G :=
  Quot.liftOn₂ f g
    (fun r s => homOfRepresentative (representativeComp r s))
    (by
      intro r s s' hss'
      subst s'
      rw [representativeComp_succ_right, homOfRepresentative_succ])
    (by
      intro r r' s hrr'
      subst r'
      rw [representativeComp_succ_left, homOfRepresentative_succ])

/-- **Stacks 0EGW.** Systems of finite `A ⧸ I ^ n`-modules, with morphisms represented by
maps `I ^ c Eₙ → Fₙ / Fₙ[I ^ c]` modulo increasing `c`, form a category. Composition is
the induced composition at delay `c + c'`. -/
@[stacks 0EGW]
public noncomputable def delayedCategory : CategoryData (A := A) (I := I) where
  id E := homOfRepresentative
    (identityRepresentative E)
  comp := delayedComp
  representativeComp := representativeComp
  representativeComp_isCanonical := representativeComp_isCanonical
  id_eq _ := rfl
  comp_eq _ _ := rfl
  id_comp := by
    intro E F f
    induction f using Quot.inductionOn with
    | h r =>
      change homOfRepresentative
        (representativeComp
          (identityRepresentative E) r) =
        homOfRepresentative r
      rw [representativeComp_identity_left]
  comp_id := by
    intro E F f
    induction f using Quot.inductionOn with
    | h r =>
      change homOfRepresentative
        (representativeComp r
          (identityRepresentative F)) =
        homOfRepresentative r
      rw [representativeComp_identity_right]
  assoc := by
    intro E F G H f g h
    induction f using Quot.inductionOn with
    | h r =>
      induction g using Quot.inductionOn with
      | h s =>
        induction h using Quot.inductionOn with
        | h t =>
          change homOfRepresentative
            (representativeComp
              (representativeComp r s) t) =
            homOfRepresentative
              (representativeComp r
                (representativeComp s t))
          rw [representativeComp_assoc]

/-- A composite is the identity precisely when its canonical representative and the
identity representative agree after increasing both delays. -/
public theorem CategoryData.comp_eq_id_iff_exists_iteratedSucc_eq
    (C : CategoryData (A := A) (I := I))
    {E F : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F E) :
    C.comp (homOfRepresentative r) (homOfRepresentative s) = C.id E ↔
      ∃ k l : ℕ,
        (C.representativeComp r s).iteratedSucc k =
          (identityRepresentative E).iteratedSucc l := by
  rw [C.comp_homOfRepresentative, C.id_eq_homOfRepresentative]
  exact homOfRepresentative_eq_iff_exists_iteratedSucc_eq _ _

/-- Component maps of a canonical composite can be compared with any representative
of the same morphism after increasing both delays. -/
public theorem CategoryData.comp_eq_iff_eventual_maps_eq
    (C : CategoryData (A := A) (I := I))
    {E F G : AdicModuleSystem.{u, v} A I}
    (r : HomRepresentative E F) (s : HomRepresentative F G)
    (t : HomRepresentative E G) :
    C.comp (homOfRepresentative r) (homOfRepresentative s) = homOfRepresentative t ↔
      ∃ k l : ℕ,
        (C.representativeComp r s).delay + k = t.delay + l ∧
        ∀ (n : ℕ+)
          (hr : ((C.representativeComp r s).iteratedSucc k).delay ≤ (n : ℕ))
          (ht : (t.iteratedSucc l).delay ≤ (n : ℕ)),
          HEq (((C.representativeComp r s).iteratedSucc k).map n hr)
            ((t.iteratedSucc l).map n ht) := by
  rw [C.comp_homOfRepresentative]
  exact homOfRepresentative_eq_iff_eventual_maps_eq _ _


end AdicModuleSystem

end


