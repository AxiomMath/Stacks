      ⟨x, powerPart_antitone E n hd x.2⟩) = _ at he
  rw [canonicalCompositeMap_apply_lift r s n (hd.trans hn) _ y hy] at he
  exact (quotientTransitionOfLE_comp E n (Nat.le_add_left _ _) hd _).symm.trans he

/-- If the composite of two representatives is the identity, the kernel of the first is
annihilated by a power of the ideal, uniformly in the level. -/
public theorem kernel_torsion_of_composite_eq_identity
    (r : HomRepresentative E F) (s : HomRepresentative F E)
