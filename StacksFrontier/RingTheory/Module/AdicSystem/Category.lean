/-- If the composite of two representatives is the identity, some common delay `d` makes the
two maps mutually inverse on the `d`-th power parts at every level. -/
public theorem exists_composite_identity_formula
    (r : HomRepresentative E F) (s : HomRepresentative F E)
    (h : homOfRepresentative (representativeComp r s) =
      homOfRepresentative (identityRepresentative E)) :
    ∃ d, ∃ hd : r.delay + s.delay ≤ d,
      ∀ (n : ℕ+) (hn : d ≤ (n : ℕ)) (x : powerPart E n d)
        (y : powerPart F n s.delay),
        r.map n ((Nat.le_add_right _ _).trans (hd.trans hn))
          ⟨x, powerPart_antitone E n ((Nat.le_add_right _ _).trans hd) x.2⟩ =
          (torsionPart F n r.delay).mkQ y.1 →
        quotientTransitionOfLE E n ((Nat.le_add_left _ _).trans hd)
