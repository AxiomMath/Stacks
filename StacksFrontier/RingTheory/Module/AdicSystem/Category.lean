/-- Two elements with the same image under the quotient transition agree after multiplication
by a scalar of the ideal power. -/
public theorem smul_eq_of_quotientTransition_eq
    (E : AdicModuleSystem.{u, v} A I) (n : ℕ+) {c d : ℕ} (hd : c ≤ d)
    (z : underlying E n ⧸ torsionPart E n c) (x : underlying E n)
    (h : quotientTransitionOfLE E n hd z = (torsionPart E n d).mkQ x)
    (a : A) (ha : a ∈ I ^ d) :
    a • z = (torsionPart E n c).mkQ (a • x) := by
  induction z using Submodule.Quotient.induction_on with
  | H z =>
    have hzx : z - x ∈ torsionPart E n d := (Submodule.Quotient.eq _).mp h
    have he := (Submodule.mem_torsionBySet_iff _ _).mp hzx ⟨a, ha⟩
    rw [smul_sub, sub_eq_zero] at he
    change a • (torsionPart E n c).mkQ z = _
    rw [← map_smul, he]

/-- If the composite of two representatives is the identity, the cokernel of the first is
annihilated by a power of the ideal, uniformly in the level. -/
public theorem cokernel_torsion_of_composite_eq_identity
    (r : HomRepresentative E F) (s : HomRepresentative F E)
    (h : homOfRepresentative (representativeComp s r) =
      homOfRepresentative (identityRepresentative F)) :
    ∃ d, ∀ (n : ℕ+), d ≤ (n : ℕ) → ∀ hn : r.delay ≤ (n : ℕ),
      Module.IsTorsionBySet A
        ((underlying F n ⧸ torsionPart F n r.delay) ⧸ (r.map n hn).range)
        (↑(I ^ (d + d)) : Set A) := by
  obtain ⟨d, hd, hm⟩ := exists_composite_identity_formula s r h
  refine ⟨d, ?_⟩
  intro n hn hr
  rw [Module.isTorsionBySet_quotient_iff]
  intro z t ht
  induction z using Submodule.Quotient.induction_on with
  | H z =>
    refine smul_mem_of_mul_smul_mem (r.map n hr).range d d _ (fun a ha b hb => ?_) t ht
    let x : powerPart F n d :=
      ⟨b • z, Submodule.smul_mem_smul hb Submodule.mem_top⟩
    let x₀ : powerPart F n (s.delay + r.delay) :=
      ⟨x, powerPart_antitone F n hd x.2⟩
    obtain ⟨y, hy⟩ := composite_lift s r.delay n (hd.trans hn) x₀
    have he := hm n hn x y hy
    have hae := smul_eq_of_quotientTransition_eq F n
      ((Nat.le_add_left _ _).trans hd) (r.map n hr y) x.1 he a ha
    refine ⟨a • y, ?_⟩
    rw [map_smul, hae]
    change (torsionPart F n r.delay).mkQ (a • (b • z)) =
      (a * b) • (torsionPart F n r.delay).mkQ z
    rw [mul_smul, map_smul, map_smul]

/-- If `r` and `s` compose to the identity both ways, then eventually the kernels and cokernels
of the components of `r` are annihilated by a single fixed power of the ideal. -/
public theorem eventually_torsion_of_composites_eq_identity
    (r : HomRepresentative E F) (s : HomRepresentative F E)
    (hs₁ : homOfRepresentative (representativeComp r s) =
      homOfRepresentative (identityRepresentative E))
    (hs₂ : homOfRepresentative (representativeComp s r) =
      homOfRepresentative (identityRepresentative F)) :
    ∃ c' : ℕ, ∀ᶠ n : ℕ+ in atTop, ∀ h : r.delay ≤ (n : ℕ),
      Module.IsTorsionBySet A (r.map n h).ker (↑(I ^ c') : Set A) ∧
        Module.IsTorsionBySet A
          ((underlying F n ⧸ torsionPart F n r.delay) ⧸
            LinearMap.range (r.map n h)) (↑(I ^ c') : Set A) := by
  obtain ⟨d, hd⟩ := kernel_torsion_of_composite_eq_identity r s hs₁
  obtain ⟨e, he⟩ := cokernel_torsion_of_composite_eq_identity r s hs₂
  refine ⟨(d + d) + (e + e), Filter.eventually_atTop.mpr ⟨⟨d + e + 1, by omega⟩, ?_⟩⟩
  intro n hn hr
  have hn' : d + e + 1 ≤ (n : ℕ) := hn
  exact ⟨Module.isTorsionBySet_of_subset
      (Ideal.pow_le_pow_right (by omega : d + d ≤ (d + d) + (e + e))) (hd n (by omega) hr),
    Module.isTorsionBySet_of_subset
      (Ideal.pow_le_pow_right (by omega : e + e ≤ (d + d) + (e + e))) (he n (by omega) hr)⟩

/-- If eventually the kernels and cokernels of the components of `r` are annihilated by a fixed
power of the ideal, then `r` has a representative inverse on both sides. -/
public theorem exists_inverse_of_eventually_torsion (r : HomRepresentative E F)
    (h : ∃ c' : ℕ, ∀ᶠ n : ℕ+ in atTop, ∀ h : r.delay ≤ (n : ℕ),
      Module.IsTorsionBySet A (r.map n h).ker (↑(I ^ c') : Set A) ∧
        Module.IsTorsionBySet A
          ((underlying F n ⧸ torsionPart F n r.delay) ⧸
            LinearMap.range (r.map n h)) (↑(I ^ c') : Set A)) :
    ∃ s : HomRepresentative F E,
      homOfRepresentative (representativeComp r s) =
        homOfRepresentative (identityRepresentative E) ∧
      homOfRepresentative (representativeComp s r) =
        homOfRepresentative (identityRepresentative F) := by
  obtain ⟨c, hc⟩ := h
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp hc
  let d := r.delay + c + (N : ℕ)
  have hrd : r.delay ≤ d := by
    dsimp [d]
    omega
  have hcd : c ≤ d := by
    dsimp [d]
    omega
  have hcomponents (n : ℕ+) (hn : d ≤ (n : ℕ)) :
      ∃ s : powerPart F n d →ₗ[A] underlying E n ⧸ torsionPart E n d,
        (∀ x : powerPart F n d, ∃ y, r.map n (hrd.trans hn) y =
          (torsionPart F n r.delay).mkQ x.1) ∧
        ∀ (x : powerPart F n d) (y : powerPart E n r.delay),
          r.map n (hrd.trans hn) y = (torsionPart F n r.delay).mkQ x.1 →
            s x = (torsionPart E n d).mkQ y.1 := by
    have hNn : N ≤ n := by
      change (N : ℕ) ≤ (n : ℕ)
      dsimp [d] at hn
      omega
    obtain ⟨hk, hq⟩ := hN n hNn (hrd.trans hn)
    exact exists_inverse_component r d n (hrd.trans hn)
      (Module.isTorsionBySet_of_subset (Ideal.pow_le_pow_right hcd) hk)
      (Module.isTorsionBySet_of_subset (Ideal.pow_le_pow_right hcd) hq)
  choose f hf using hcomponents
  let s : HomRepresentative F E := ⟨d, f⟩
  exact ⟨s, composite_eq_identity_of_inverse_components r s hrd
    (fun n hn => (hf n hn).1) (fun n hn => (hf n hn).2)⟩

/-- **Stacks 0EGX.** A delayed representative induces an isomorphism in the category of
systems if and only if, eventually, the kernels and cokernels of all its component maps are
annihilated by a single fixed power of the ideal. -/
@[stacks 0EGX]
public theorem isIso_homOfRepresentative_iff (r : HomRepresentative E F) :
    letI := (AdicModuleSystem.delayedCategory (A := A) (I := I)).toCategory
    IsIso (show E ⟶ F from homOfRepresentative r) ↔
      ∃ c' : ℕ, ∀ᶠ n : ℕ+ in atTop, ∀ h : r.delay ≤ (n : ℕ),
        Module.IsTorsionBySet A (r.map n h).ker (↑(I ^ c') : Set A) ∧
          Module.IsTorsionBySet A
            ((underlying F n ⧸ torsionPart F n r.delay) ⧸
              LinearMap.range (r.map n h)) (↑(I ^ c') : Set A) := by
  let := (AdicModuleSystem.delayedCategory (A := A) (I := I)).toCategory
  change IsIso (show E ⟶ F from homOfRepresentative r) ↔ _
  constructor
  · intro hi
    obtain ⟨s, hs₁, hs₂⟩ := hi.out
    change Hom F E at s
    obtain ⟨s, rfl⟩ := Quot.exists_rep s
    change homOfRepresentative (representativeComp r s) =
      homOfRepresentative (identityRepresentative E) at hs₁
    change homOfRepresentative (representativeComp s r) =
      homOfRepresentative (identityRepresentative F) at hs₂
    exact eventually_torsion_of_composites_eq_identity r s hs₁ hs₂
  · intro h
    obtain ⟨s, hs₁, hs₂⟩ := exists_inverse_of_eventually_torsion r h
    exact ⟨⟨homOfRepresentative s, hs₁, hs₂⟩⟩

end

end Stacks.AdicModuleSystem.IsomorphismCriterion

