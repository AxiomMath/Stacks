/-!
# Ext over adic quotients: the delay cannot be removed (Tag 0EH2)

For `A = k[[x, y]] ⧸ (xy)` and `M = A ⧸ (y)`, the group `Ext^2_A(M, M)` is nonzero while every
`Ext^2` over the adic quotients `Aₙ` vanishes, computed with the periodic resolution of
`A ⧸ (y)`.
-/

@[expose] public section

/-! ## Tag 0EH2 -/

section

open CategoryTheory CategoryTheory.Abelian

universe u

namespace Stacks.AdicSystem.ExtCounterexample

noncomputable section

private theorem exact_mul_of_mul_zero {R : Type*} [CommRing R] [IsDomain R]
    (a b : R) (ha : a ≠ 0) :
    let Q := R ⧸ Ideal.span {a * b}
    Function.Exact (LinearMap.lsmul Q Q (Ideal.Quotient.mk _ b))
      (LinearMap.lsmul Q Q (Ideal.Quotient.mk _ a)) := by
  intro Q
  rw [LinearMap.exact_iff]
  ext z
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [LinearMap.mem_ker, LinearMap.lsmul_apply, smul_eq_mul,
    LinearMap.mem_range]
  constructor
  · intro h
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h
    obtain ⟨s, hs⟩ := h
    have hrs : r = b * s := by
      apply mul_left_cancel₀ ha
      simpa only [mul_assoc] using hs
    refine ⟨Ideal.Quotient.mk _ s, ?_⟩
    simp [hrs]
  · rintro ⟨v, hv⟩
    rw [← hv, ← mul_assoc, ← map_mul, Ideal.Quotient.mk_singleton_self, zero_mul]

private theorem x_ne_zero (k : Type*) [Field k] (i : Fin 2) :
    (MvPowerSeries.X i : MvPowerSeries (Fin 2) k) ≠ 0 :=
  nonZeroDivisors.ne_zero (MvPowerSeries.X_mem_nonzeroDivisors (i := i) (R := k))

private theorem exact_lsmul_mkQ_ideal {R : Type*} [CommRing R] (y : R) :
    Function.Exact (LinearMap.lsmul R R y) (Submodule.mkQ (Ideal.span {y})) := by
  rw [LinearMap.exact_iff]
  ext z
  simp only [LinearMap.mem_ker, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    LinearMap.mem_range, LinearMap.lsmul_apply, smul_eq_mul,
    Ideal.mem_span_singleton]
  constructor <;> rintro ⟨a, ha⟩ <;> exact ⟨a, by simpa [mul_comm] using ha.symm⟩

private theorem node_exactness (k : Type u) [Field k] :
    let R := MvPowerSeries (Fin 2) k
    let X : R := MvPowerSeries.X 0
    let Y : R := MvPowerSeries.X 1
    let A := R ⧸ Ideal.span {X * Y}
    let x : A := Ideal.Quotient.mk _ X
    let y : A := Ideal.Quotient.mk _ Y
    Function.Exact (LinearMap.lsmul A A y) (LinearMap.lsmul A A x) ∧
      Function.Exact (LinearMap.lsmul A A x) (LinearMap.lsmul A A y) ∧
      Function.Exact (LinearMap.lsmul A A y) (Submodule.mkQ (Ideal.span {y})) ∧
      Function.Surjective (Submodule.mkQ (Ideal.span {y})) := by
  dsimp
  let : IsDomain (MvPowerSeries (Fin 2) k) := NoZeroDivisors.to_isDomain _
  refine ⟨exact_mul_of_mul_zero _ _ (x_ne_zero k 0), ?_, ?_, ?_⟩
  · have hswap : (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k) *
        MvPowerSeries.X 0 = MvPowerSeries.X 0 * MvPowerSeries.X 1 := mul_comm _ _
    have h := exact_mul_of_mul_zero (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)
      (MvPowerSeries.X 0) (x_ne_zero k 1)
    dsimp at h
    rwa [hswap] at h
  · exact exact_lsmul_mkQ_ideal _
  · exact Submodule.mkQ_surjective _

/-- The new relation `x^(n+1) = 0` adds precisely `x^n` to the kernel of
multiplication by `x`, provided the original kernel is generated by `y`. -/
private theorem exact_mul_coprod_quotient_pow {R : Type*} [CommRing R]
    (x y : R) (hxy : x * y = 0)
    (h : Function.Exact (LinearMap.lsmul R R y) (LinearMap.lsmul R R x))
    (n : ℕ) :
    let Q := R ⧸ Ideal.span {x ^ (n + 1)}
    Function.Exact
      ((LinearMap.lsmul Q Q (Ideal.Quotient.mk _ y)).coprod
        (LinearMap.lsmul Q Q ((Ideal.Quotient.mk _ x) ^ n)))
      (LinearMap.lsmul Q Q (Ideal.Quotient.mk _ x)) := by
  intro Q
  rw [LinearMap.exact_iff]
  ext z
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [LinearMap.mem_ker, LinearMap.lsmul_apply, smul_eq_mul,
    LinearMap.mem_range]
  constructor
  · intro hz
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hz
    obtain ⟨s, hs⟩ := hz
    have hxrs : x * (r - x ^ n * s) = 0 := by
      calc
        x * (r - x ^ n * s) = x * r - x ^ (n + 1) * s := by ring
        _ = 0 := by rw [← hs]; ring
    obtain ⟨t, ht⟩ := (h _).mp hxrs
    refine ⟨(Ideal.Quotient.mk _ t, Ideal.Quotient.mk _ s), ?_⟩
    simp only [LinearMap.coprod_apply, LinearMap.lsmul_apply, smul_eq_mul,
      ← map_pow, ← map_mul, ← map_add]
    congr 1
    calc
      y * t + x ^ n * s = (r - x ^ n * s) + x ^ n * s := by
        simpa only [LinearMap.lsmul_apply, smul_eq_mul] using
          congrArg (fun z => z + x ^ n * s) ht
      _ = r := by ring
  · rintro ⟨v, hv⟩
    rw [← hv]
    simp only [LinearMap.coprod_apply, LinearMap.lsmul_apply, smul_eq_mul]
    rw [mul_add, ← mul_assoc, ← map_mul, hxy, map_zero, zero_mul, zero_add, ← mul_assoc,
      ← pow_succ', ← map_pow, Ideal.Quotient.mk_singleton_self, zero_mul]

/-- Exactness at multiplication by `y` survives quotienting by a positive
power of `x` when the images of multiplication by `x` and `y` meet only in zero. -/
private theorem exact_mul_quotient_pow_of_disjoint {R : Type*} [CommRing R]
    (x y : R) (hxy : x * y = 0)
    (h : Function.Exact (LinearMap.lsmul R R x) (LinearMap.lsmul R R y))
    (hsep : ∀ a b : R, x * a = y * b → y * b = 0) (n : ℕ) :
    let Q := R ⧸ Ideal.span {x ^ (n + 1)}
    Function.Exact (LinearMap.lsmul Q Q (Ideal.Quotient.mk _ x))
      (LinearMap.lsmul Q Q (Ideal.Quotient.mk _ y)) := by
  intro Q
  rw [LinearMap.exact_iff]
  ext z
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
  simp only [LinearMap.mem_ker, LinearMap.lsmul_apply, smul_eq_mul,
    LinearMap.mem_range]
  constructor
  · intro hz
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at hz
    obtain ⟨s, hs⟩ := hz
    have hxr : x * (x ^ n * s) = y * r := by
      calc
        x * (x ^ n * s) = x ^ (n + 1) * s := by ring
        _ = y * r := hs.symm
    have hyr : y * r = 0 := hsep _ _ hxr
    obtain ⟨t, ht⟩ := (h _).mp (by simpa only [LinearMap.lsmul_apply, smul_eq_mul] using hyr)
    refine ⟨Ideal.Quotient.mk _ t, ?_⟩
    simpa only [LinearMap.lsmul_apply, smul_eq_mul, ← map_mul] using
      congrArg (Ideal.Quotient.mk (Ideal.span {x ^ (n + 1)})) ht
  · rintro ⟨t, ht⟩
    rw [← ht]
    rw [← mul_assoc, ← map_mul, mul_comm y x, hxy, map_zero, zero_mul]

private def extSuccEquiv {R : Type u} [CommRing R]
    {S : ShortComplex (ModuleCat.{u} R)} (hS : S.ShortExact)
    [Projective S.X₂] (N : ModuleCat.{u} R) (n : ℕ) :
    Ext S.X₁ N (n + 1) ≃ₗ[R] Ext S.X₃ N (n + 2) :=
  LinearEquiv.ofBijective (hS.extClass.precompOfLinear R N (by omega)) (by
    constructor
    · rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨b, hb⟩ := Ext.contravariant_sequence_exact₁ hS N a (by omega) ha
      rw [Ext.eq_zero_of_projective b, Ext.comp_zero] at hb
      exact hb.symm
    · intro a
      exact Ext.contravariant_sequence_exact₃ hS N a
        (Ext.eq_zero_of_projective _) (by omega))

private def homToExtOne {R : Type u} [CommRing R]
    {S : ShortComplex (ModuleCat.{u} R)} (hS : S.ShortExact)
    (N : ModuleCat.{u} R) : (S.X₁ ⟶ N) →ₗ[R] Ext S.X₃ N 1 :=
  (hS.extClass.precompOfLinear R N rfl).comp Ext.linearEquiv₀.symm.toLinearMap

private theorem homToExtOne_surjective {R : Type u} [CommRing R]
    {S : ShortComplex (ModuleCat.{u} R)} (hS : S.ShortExact)
    [Projective S.X₂] (N : ModuleCat.{u} R) :
    Function.Surjective (homToExtOne hS N) := by
  intro a
  obtain ⟨b, hb⟩ := Ext.contravariant_sequence_exact₃ hS N a
    (Ext.eq_zero_of_projective _) (show 1 + 0 = 1 from rfl)
  exact ⟨Ext.linearEquiv₀ (R := R) b, by simpa [homToExtOne] using hb⟩

private theorem homToExtOne_eq_zero_iff {R : Type u} [CommRing R]
    {S : ShortComplex (ModuleCat.{u} R)} (hS : S.ShortExact)
    (N : ModuleCat.{u} R) (f : S.X₁ ⟶ N) :
    homToExtOne hS N f = 0 ↔ ∃ g : S.X₂ ⟶ N, S.f ≫ g = f := by
  constructor
  · intro hf
    obtain ⟨g, hg⟩ := Ext.contravariant_sequence_exact₁ hS N (Ext.mk₀ f) rfl hf
    refine ⟨Ext.linearEquiv₀ (R := R) g, ?_⟩
    apply Ext.homEquiv₀.symm.injective
    show Ext.mk₀ (S.f ≫ Ext.linearEquiv₀ (R := R) g) = Ext.mk₀ f
    rw [← Ext.mk₀_comp_mk₀, Ext.mk₀_linearEquiv₀_apply]
    exact hg
  · rintro ⟨g, rfl⟩
    simp [homToExtOne, ← Ext.mk₀_comp_mk₀]

/-- A linear map out of `R` is determined by its value at `1`. -/
private theorem map_eq_smul_map_one {R P : Type*} [CommRing R] [AddCommGroup P] [Module R P]
    (f : R →ₗ[R] P) (r : R) : f r = r • f 1 := by
  rw [← f.map_smul, smul_eq_mul, mul_one]

private def homEquivAnnihilator {R P N : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup N] [Module R N]
    (f : R →ₗ[R] P) (hf : Function.Surjective f) (T : Submodule R N)
    (hT : ∀ z : N, z ∈ T ↔ ∀ r : R, f r = 0 → r • z = 0) :
    (P →ₗ[R] N) ≃ₗ[R] T := by
  let ev : (P →ₗ[R] N) →ₗ[R] T :=
    { toFun := fun g => ⟨g (f 1), (hT _).mpr (by
        intro r hr
        rw [← g.map_smul, ← f.map_smul, smul_eq_mul, mul_one, hr, g.map_zero])⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  refine LinearEquiv.ofBijective ev ⟨?_, ?_⟩
  · intro g h he
    have he' : g (f 1) = h (f 1) := congrArg Subtype.val he
    ext p
    obtain ⟨r, rfl⟩ := hf p
    rw [map_eq_smul_map_one f, g.map_smul, h.map_smul, he']
  · intro z
    let g : R →ₗ[R] N := (LinearMap.id : R →ₗ[R] R).smulRight z.1
    have hg : LinearMap.ker f ≤ LinearMap.ker g := by
      intro r hr
      exact (hT z.1).mp z.2 r hr
    let h := (f.ker.liftQ g hg).comp (f.quotKerEquivOfSurjective hf).symm.toLinearMap
    refine ⟨h, Subtype.ext ?_⟩
    change h (f 1) = z.1
    change f.ker.liftQ g hg ((f.quotKerEquivOfSurjective hf).symm (f 1)) = z.1
    rw [LinearMap.quotKerEquivOfSurjective_symm_apply, Submodule.liftQ_apply]
    exact one_smul R z.1

private theorem homEquivAnnihilator_apply {R P N : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup N] [Module R N]
    (f : R →ₗ[R] P) (hf : Function.Surjective f) (T : Submodule R N)
    (hT : ∀ z : N, z ∈ T ↔ ∀ r : R, f r = 0 → r • z = 0)
    (g : P →ₗ[R] N) : (homEquivAnnihilator f hf T hT g).1 = g (f 1) := rfl

private theorem homEquivAnnihilator_symm_apply {R P N : Type*} [CommRing R]
    [AddCommGroup P] [Module R P] [AddCommGroup N] [Module R N]
    (f : R →ₗ[R] P) (hf : Function.Surjective f) (T : Submodule R N)
    (hT : ∀ z : N, z ∈ T ↔ ∀ r : R, f r = 0 → r • z = 0)
    (z : T) (r : R) : (homEquivAnnihilator f hf T hT).symm z (f r) = r • z.1 := by
  have h := congrArg Subtype.val ((homEquivAnnihilator f hf T hT).apply_symm_apply z)
  rw [homEquivAnnihilator_apply] at h
  rw [map_eq_smul_map_one f, LinearMap.map_smul, h]


private theorem extTwoEquivQuotient {R M N : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (p : R →ₗ[R] M) (g : R →ₗ[R] R) (x : R)
    (hp : Function.Surjective p) (hgp : Function.Exact g p)
    (hxg : Function.Exact (LinearMap.lsmul R R x) g)
    (T : Submodule R N)
    (hT : ∀ z : N, z ∈ T ↔ ∀ r : R, x * r = 0 → r • z = 0) :
    Nonempty (Ext (ModuleCat.of R M) (ModuleCat.of R N) 2 ≃ₗ[R]
      (T ⧸ (LinearMap.range (LinearMap.lsmul R N x)).comap T.subtype)) := by
  let q : R →ₗ[R] p.ker := g.codRestrict p.ker (fun r => (hgp (g r)).mpr ⟨r, rfl⟩)
  have hq : Function.Surjective q := by
    intro z
    obtain ⟨r, hr⟩ := (hgp z.1).mp z.2
    exact ⟨r, Subtype.ext hr⟩
  let f : R →ₗ[R] q.ker := (LinearMap.lsmul R R x).codRestrict q.ker
    fun r => Subtype.ext ((hxg _).mpr ⟨r, rfl⟩)
  have hf : Function.Surjective f := by
    intro z
    obtain ⟨r, hr⟩ := (hxg z.1).mp (congrArg Subtype.val z.2)
    exact ⟨r, Subtype.ext hr⟩
  have hTf : ∀ z : N, z ∈ T ↔ ∀ r : R, f r = 0 → r • z = 0 := by
    intro z
    rw [hT]
    have he : ∀ r, f r = 0 ↔ x * r = 0 := fun r => Subtype.ext_iff
    simp_rw [he]
  let e := (ModuleCat.homLinearEquiv (R := R) (S := R)
    (M := ModuleCat.of R q.ker) (N := ModuleCat.of R N)).trans
    (homEquivAnnihilator f hf T hTf)
  let hS := LinearMap.shortExact_shortComplexKer hp
  let hS' := LinearMap.shortExact_shortComplexKer hq
  let d : (q.shortComplexKer.X₁ ⟶ ModuleCat.of R N) →ₗ[R]
      Ext (ModuleCat.of R M) (ModuleCat.of R N) 2 :=
    (extSuccEquiv hS (ModuleCat.of R N) 0).toLinearMap.comp
      (homToExtOne hS' (ModuleCat.of R N))
  have hd : Function.Surjective d :=
    (extSuccEquiv hS (ModuleCat.of R N) 0).surjective.comp
      (homToExtOne_surjective hS' (ModuleCat.of R N))
  have hd0 (a) : d a = 0 ↔ ∃ b : q.shortComplexKer.X₂ ⟶ ModuleCat.of R N,
      q.shortComplexKer.f ≫ b = a := by
    rw [← homToExtOne_eq_zero_iff hS' (ModuleCat.of R N) a]
    exact (extSuccEquiv hS (ModuleCat.of R N) 0).map_eq_zero_iff
  let H := d.comp e.symm.toLinearMap
  have hH : Function.Surjective H := hd.comp e.symm.surjective
  have hker : H.ker = (LinearMap.range (LinearMap.lsmul R N x)).comap T.subtype := by
    ext z
    show H z = 0 ↔ ∃ m : N, x • m = z.1
    show d (e.symm z) = 0 ↔ _
    rw [hd0]
    constructor
    · rintro ⟨b, hb⟩
      refine ⟨b 1, ?_⟩
      have he := congrArg (fun a => (e a).1) hb
      change b ((f 1).1) = (e (e.symm z)).1 at he
      rw [e.apply_symm_apply] at he
      have hx : (f 1).1 = x := by change x * 1 = x; exact mul_one x
      rw [hx] at he
      simpa only [← b.hom.map_smul, smul_eq_mul, mul_one] using he
    · rintro ⟨m, hm⟩
      let b : q.shortComplexKer.X₂ ⟶ ModuleCat.of R N :=
        ModuleCat.ofHom ((LinearMap.id : R →ₗ[R] R).smulRight m)
      refine ⟨b, e.injective ?_⟩
      rw [e.apply_symm_apply]
      apply Subtype.ext
      show (f 1).1 • m = z.1
      show (x * 1) • m = z.1
      simpa only [mul_one] using hm
  exact ⟨((Submodule.quotEquivOfEq _ _ hker).symm.trans
    (H.quotKerEquivOfSurjective hH)).symm⟩



private theorem range_lsmul_eq_span_smul_top {R N : Type*} [CommRing R]
    [AddCommGroup N] [Module R N] (x : R) :
    LinearMap.range (LinearMap.lsmul R N x) = Ideal.span {x} • (⊤ : Submodule R N) := by
  rw [Submodule.ideal_span_singleton_smul]
  ext z
  simp [Submodule.mem_smul_pointwise_iff_exists]

private theorem extTwoEquivOfPeriodic {R N : Type u} [CommRing R]
    [AddCommGroup N] [Module R N] (x y : R)
    (hxy : Function.Exact (LinearMap.lsmul R R x) (LinearMap.lsmul R R y))
    (hyx : Function.Exact (LinearMap.lsmul R R y) (LinearMap.lsmul R R x)) :
    let T := LinearMap.ker (LinearMap.lsmul R N y)
    Nonempty (Ext (ModuleCat.of R (R ⧸ Ideal.span {y})) (ModuleCat.of R N) 2 ≃ₗ[R]
      (T ⧸ (Ideal.span {x} • (⊤ : Submodule R N)).comap T.subtype)) := by
  intro T
  have hT : ∀ z : N, z ∈ T ↔ ∀ r : R, x * r = 0 → r • z = 0 := by
    intro z
    show y • z = 0 ↔ _
    constructor
    · intro hz r hr
      obtain ⟨t, ht⟩ := (hyx r).mp hr
      rw [← ht]
      show (y * t) • z = 0
      rw [mul_comm y t, mul_smul, hz, smul_zero]
    · intro hz
      apply hz y
      apply (hyx y).mpr
      exact ⟨1, by simp⟩
  rw [← range_lsmul_eq_span_smul_top (N := N) x]
  exact
    extTwoEquivQuotient (Submodule.mkQ (Ideal.span {y}))
      (LinearMap.lsmul R R y) x (Submodule.mkQ_surjective _) (exact_lsmul_mkQ_ideal y)
      hxy T hT

private theorem extTwoEquivOfCoprod {R M N : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (p : R →ₗ[R] M) (x y z : R) (hp : Function.Surjective p)
    (hyp : Function.Exact (LinearMap.lsmul R R y) p)
    (hxy : Function.Exact (LinearMap.lsmul R R x) (LinearMap.lsmul R R y))
    (hyzx : Function.Exact ((LinearMap.lsmul R R y).coprod (LinearMap.lsmul R R z))
      (LinearMap.lsmul R R x)) :
    let T := LinearMap.ker (LinearMap.lsmul R N y) ⊓ LinearMap.ker (LinearMap.lsmul R N z)
    Nonempty (Ext (ModuleCat.of R M) (ModuleCat.of R N) 2 ≃ₗ[R]
      (T ⧸ (Ideal.span {x} • (⊤ : Submodule R N)).comap T.subtype)) := by
  intro T
  have hT : ∀ v : N, v ∈ T ↔ ∀ r : R, x * r = 0 → r • v = 0 := by
    intro v
    show (y • v = 0 ∧ z • v = 0) ↔ _
    constructor
    · rintro ⟨hy, hz⟩ r hr
      obtain ⟨⟨a, b⟩, hab⟩ := (hyzx r).mp hr
      rw [← hab]
      show (y * a + z * b) • v = 0
      rw [add_smul, mul_comm y a, mul_comm z b, mul_smul, mul_smul, hy, hz,
        smul_zero, smul_zero, zero_add]
    · intro hv
      constructor
      · exact hv y ((hyzx y).mpr ⟨(1, 0), by simp⟩)
      · exact hv z ((hyzx z).mpr ⟨(0, 1), by simp⟩)
  rw [← range_lsmul_eq_span_smul_top (N := N) x]
  exact
    extTwoEquivQuotient p (LinearMap.lsmul R R y) x hp hyp hxy T hT

private abbrev xAxis : Unit ↪ Fin 2 := ⟨fun _ => 0, fun _ _ _ => rfl⟩

private theorem killCompl_xAxis_eq_zero_iff {k : Type*} [CommRing k]
    (p : MvPowerSeries (Fin 2) k) :
    MvPowerSeries.killCompl xAxis p = 0 ↔ MvPowerSeries.X 1 ∣ p := by
  rw [MvPowerSeries.X_dvd_iff]
  constructor
  · intro h m hm
    have he : Finsupp.embDomain xAxis (Finsupp.single () (m 0)) = m := by
      rw [Finsupp.embDomain_single]
      show Finsupp.single 0 (m 0) = m
      ext i
      fin_cases i <;> simp [hm]
    rw [← he, ← MvPowerSeries.coeff_killCompl, h, map_zero]
  · intro h
    apply MvPowerSeries.ext
    intro m
    rw [MvPowerSeries.coeff_killCompl, map_zero]
    apply h
    exact Finsupp.embDomain_of_notMem_range xAxis m 1 (by
      rintro ⟨a, ha⟩
      have : (0 : Fin 2) = 1 := ha
      exact Fin.zero_ne_one this)

private theorem node_disjoint (k : Type*) [Field k] :
    let R := MvPowerSeries (Fin 2) k
    let X : R := MvPowerSeries.X 0
    let Y : R := MvPowerSeries.X 1
    let A := R ⧸ Ideal.span {X * Y}
    let x : A := Ideal.Quotient.mk _ X
    let y : A := Ideal.Quotient.mk _ Y
    ∀ a b : A, x * a = y * b → y * b = 0 := by
  intro R X Y A x y a b hab
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hab0 := hab
  change Ideal.Quotient.mk _ X * _ = Ideal.Quotient.mk _ Y * _ at hab
  rw [← map_mul, ← map_mul, Ideal.Quotient.eq, Ideal.mem_span_singleton] at hab
  obtain ⟨c, hc⟩ := hab
  have hY : Y ∣ X * a := by
    refine ⟨b + X * c, ?_⟩
    calc
      X * a = X * a - Y * b + Y * b := by ring
      _ = (X * Y) * c + Y * b := by rw [hc]
      _ = Y * (b + X * c) := by ring
  have hka := (killCompl_xAxis_eq_zero_iff (X * a)).mpr hY
  rw [map_mul] at hka
  have hkX : MvPowerSeries.killCompl xAxis X = PowerSeries.X :=
    MvPowerSeries.killCompl_X (e := xAxis) ()
  rw [hkX] at hka
  have ha : MvPowerSeries.killCompl xAxis a = 0 :=
    (mul_eq_zero.mp hka).resolve_left
      (nonZeroDivisors.ne_zero (MvPowerSeries.X_mem_nonzeroDivisors (i := ()) (R := k)))
  obtain ⟨d, hd⟩ := (killCompl_xAxis_eq_zero_iff a).mp ha
  have hxa : X * a ∈ Ideal.span {X * Y} := by
    rw [Ideal.mem_span_singleton]
    exact ⟨d, by rw [hd, mul_assoc]⟩
  rw [← hab0]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hxa
private theorem quotient_span_adic_presentation {R : Type*} [CommRing R]
    (x y : R) (n : ℕ) :
    let I := Ideal.span {x}
    let M := R ⧸ Ideal.span {y}
    let Q := R ⧸ I ^ n
    let Mn := M ⧸ (I ^ n • (⊤ : Submodule R M))
    ∃ q : Q →ₗ[Q] Mn,
      q 1 = Submodule.Quotient.mk (Ideal.Quotient.mk (Ideal.span {y}) 1) ∧
      Function.Surjective q ∧
      Function.Exact (LinearMap.lsmul Q Q (Ideal.Quotient.mk _ y)) q := by
  intro I M Q Mn
  let q : Q →ₗ[Q] Mn :=
    (LinearMap.id : Q →ₗ[Q] Q).smulRight
      (Submodule.Quotient.mk (Ideal.Quotient.mk (Ideal.span {y}) 1))
  have hq (r : R) : q (Ideal.Quotient.mk _ r) =
      Submodule.Quotient.mk (Ideal.Quotient.mk (Ideal.span {y}) r) := by
    show Ideal.Quotient.mk (I ^ n) r •
      (Submodule.Quotient.mk (Ideal.Quotient.mk (Ideal.span {y}) 1) : Mn) = _
    rw [Module.Quotient.mk_smul_mk]
    congr 1
    show Ideal.Quotient.mk _ (r * 1) = _
    rw [mul_one]
  refine ⟨q, by simpa using hq 1, ?_, ?_⟩
  · intro z
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (I ^ n • (⊤ : Submodule R M)) z
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective m
    exact ⟨Ideal.Quotient.mk _ r, hq r⟩
  · intro z
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [hq, Submodule.Quotient.mk_eq_zero]
    have hI : I ^ n • (⊤ : Submodule R M) =
        LinearMap.range (LinearMap.lsmul R M (x ^ n)) := by
      rw [range_lsmul_eq_span_smul_top, ← Ideal.span_singleton_pow]
    rw [hI]
    constructor
    · rintro ⟨m, hm⟩
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective m
      change Ideal.Quotient.mk (Ideal.span {y}) (x ^ n * a) =
        Ideal.Quotient.mk (Ideal.span {y}) r at hm
      have hr : r - x ^ n * a ∈ Ideal.span {y} :=
        Ideal.Quotient.eq.mp hm.symm
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hr
      refine ⟨Ideal.Quotient.mk _ b, ?_⟩
      show Ideal.Quotient.mk _ y * Ideal.Quotient.mk _ b = _
      rw [← map_mul, ← hb, map_sub, map_mul]
      have hxn : Ideal.Quotient.mk (I ^ n) (x ^ n) = 0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        rw [show I = Ideal.span {x} from rfl, Ideal.span_singleton_pow]
        exact Ideal.mem_span_singleton_self _
      rw [hxn, zero_mul, sub_zero]
    · rintro ⟨b, hb⟩
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      change Ideal.Quotient.mk _ y * Ideal.Quotient.mk _ a = _ at hb
      rw [← map_mul, Ideal.Quotient.eq] at hb
      rw [show I = Ideal.span {x} from rfl, Ideal.span_singleton_pow,
        Ideal.mem_span_singleton] at hb
      obtain ⟨b, hb⟩ := hb
      refine ⟨Ideal.Quotient.mk _ (-b), ?_⟩
      show Ideal.Quotient.mk (Ideal.span {y}) (x ^ n * -b) =
        Ideal.Quotient.mk (Ideal.span {y}) r
      have hr : x ^ n * -b = r - y * a := by rw [mul_neg, ← hb]; ring
      rw [hr, map_sub, map_mul]
      rw [Ideal.Quotient.mk_singleton_self, zero_mul, sub_zero]
private theorem node_axis_equiv (k : Type*) [Field k] :
    let R := MvPowerSeries (Fin 2) k
    let X : R := MvPowerSeries.X 0
    let Y : R := MvPowerSeries.X 1
    let A := R ⧸ Ideal.span {X * Y}
    let x : A := Ideal.Quotient.mk _ X
    let y : A := Ideal.Quotient.mk _ Y
    ∃ e : (A ⧸ Ideal.span {y}) ≃ₐ[k] PowerSeries k,
      e (Ideal.Quotient.mk _ x) = PowerSeries.X := by
  intro R X Y A x y
  let f : R →ₐ[k] PowerSeries k := MvPowerSeries.killCompl xAxis
  have hfX : f X = PowerSeries.X := MvPowerSeries.killCompl_X (e := xAxis) ()
  have hfY : f Y = 0 := (killCompl_xAxis_eq_zero_iff Y).mpr dvd_rfl
  let g : A →ₐ[k] PowerSeries k := Ideal.Quotient.liftₐ _ f (by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp ha
    simp [map_mul, hfY])
  have hg (a : R) : g (Ideal.Quotient.mk _ a) = f a := rfl
  have hgy : g y = 0 := hfY
  let h : (A ⧸ Ideal.span {y}) →ₐ[k] PowerSeries k :=
    Ideal.Quotient.liftₐ _ g (by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton.mp ha
      rw [map_mul, hgy, zero_mul])
  have hh (a : A) : h (Ideal.Quotient.mk _ a) = g a := rfl
  have hi : Function.Injective h := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    change f a = 0 at ha
    obtain ⟨b, hb⟩ := (killCompl_xAxis_eq_zero_iff a).mp ha
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
    exact ⟨Ideal.Quotient.mk _ b, by rw [hb, map_mul]⟩
  have hs : Function.Surjective h := by
    intro p
    refine ⟨Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.rename xAxis p)), ?_⟩
    exact MvPowerSeries.killCompl_rename_app (e := xAxis) p
  exact ⟨AlgEquiv.ofBijective h ⟨hi, hs⟩, hfX⟩

private theorem linearEquiv_smul_pow {k R M : Type*} [CommRing k] [CommRing R]
    [AddCommGroup M] [Module R M] [Module k M]
    (e : M ≃ₗ[k] PowerSeries k) (x : R)
    (he : ∀ m, e (x • m) = PowerSeries.X * e m) (n : ℕ) (m : M) :
    e (x ^ n • m) = PowerSeries.X ^ n * e m := by
  induction n with
  | zero => simp
  | succ n hn => rw [pow_succ', mul_smul, he, hn, pow_succ', mul_assoc]

private theorem mem_adic_smul_iff {k R M : Type*} [CommRing k] [CommRing R]
    [AddCommGroup M] [Module R M] [Module k M]
    (e : M ≃ₗ[k] PowerSeries k) (x : R)
    (he : ∀ m, e (x • m) = PowerSeries.X * e m) (n : ℕ) (m : M) :
    m ∈ (Ideal.span {x}) ^ n • (⊤ : Submodule R M) ↔ PowerSeries.X ^ n ∣ e m := by
  rw [Ideal.span_singleton_pow, ← range_lsmul_eq_span_smul_top, LinearMap.mem_range]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨e a, linearEquiv_smul_pow e x he n a⟩
  · rintro ⟨p, hp⟩
    refine ⟨e.symm p, e.injective ?_⟩
    show e (x ^ n • e.symm p) = e m
    rw [linearEquiv_smul_pow e x he, e.apply_symm_apply, hp]

private theorem adic_quotient_equiv_polynomial {k R M : Type*} [CommRing k] [CommRing R]
    [Algebra k R] [AddCommGroup M] [Module R M] [Module k M] [IsScalarTower k R M]
    (e : M ≃ₗ[k] PowerSeries k) (x : R)
    (he : ∀ m, e (x • m) = PowerSeries.X * e m) (n : ℕ) :
    Nonempty ((M ⧸ ((Ideal.span {x}) ^ n • (⊤ : Submodule R M))) ≃ₗ[k]
      (Polynomial k ⧸ (Ideal.span {Polynomial.X ^ n} : Ideal (Polynomial k)))) := by
  let p := (Ideal.span {x}) ^ n • (⊤ : Submodule R M)
  let J : Ideal (Polynomial k) := Ideal.span {Polynomial.X ^ n}
  let f : M →ₗ[k] (Polynomial k ⧸ J) :=
    ((Ideal.Quotient.mkₐ k J).toLinearMap.comp (PowerSeries.trunc n)).comp e.toLinearMap
  have hf (m : M) : f m = Ideal.Quotient.mk J (PowerSeries.trunc n (e m)) := rfl
  have hker : f.ker = p.restrictScalars k := by
    ext m
    rw [LinearMap.mem_ker, hf, Ideal.Quotient.eq_zero_iff_mem]
    show PowerSeries.trunc n (e m) ∈ J ↔ m ∈ p
    rw [mem_adic_smul_iff e x he, Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff,
      PowerSeries.X_pow_dvd_iff]
    simp only [PowerSeries.coeff_trunc]
    exact ⟨fun h i hi => by simpa [hi] using h i hi,
      fun h i hi => by simp [hi, h i hi]⟩
  have hsurj : Function.Surjective f := by
    intro z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    refine ⟨e.symm (a : PowerSeries k), ?_⟩
    rw [hf, e.apply_symm_apply, Ideal.Quotient.eq]
    rw [Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff]
    intro i hi
    simp [PowerSeries.coeff_trunc, hi]
  exact ⟨(Submodule.Quotient.restrictScalarsEquiv k p).symm.trans
    ((Submodule.quotEquivOfEq _ _ hker).symm.trans (f.quotKerEquivOfSurjective hsurj))⟩

private theorem exact_adic_smul_pow {k R M : Type*} [Field k] [CommRing R]
    [AddCommGroup M] [Module R M] [Module k M]
    (e : M ≃ₗ[k] PowerSeries k) (x : R)
    (he : ∀ m, e (x • m) = PowerSeries.X * e m) (n : ℕ+) :
    let I := Ideal.span {x}
    let Q := R ⧸ I ^ (n : ℕ)
    let xn : Q := Ideal.Quotient.mk _ x
    let Mn := M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule R M))
    Function.Exact (LinearMap.lsmul Q Mn xn)
      (LinearMap.lsmul Q Mn (xn ^ ((n : ℕ) - 1))) := by
  intro I Q xn Mn z
  obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (I ^ (n : ℕ) • (⊤ : Submodule R M)) z
  show xn ^ ((n : ℕ) - 1) • (Submodule.Quotient.mk m : Mn) = 0 ↔ _
  have hn : (n : ℕ) - 1 + 1 = n := Nat.sub_add_cancel n.property
  rw [← map_pow, Module.Quotient.mk_smul_mk, Submodule.Quotient.mk_eq_zero,
    mem_adic_smul_iff e x he, linearEquiv_smul_pow e x he]
  constructor
  · rintro ⟨p, hp⟩
    have hem : e m = PowerSeries.X * p := by
      apply mul_left_cancel₀ (pow_ne_zero _ PowerSeries.X_ne_zero)
      calc
        PowerSeries.X ^ ((n : ℕ) - 1) * e m = PowerSeries.X ^ (n : ℕ) * p := hp
        _ = PowerSeries.X ^ ((n : ℕ) - 1) * (PowerSeries.X * p) := by
          rw [← mul_assoc, ← pow_succ, hn]
    refine ⟨Submodule.Quotient.mk (e.symm p), ?_⟩
    show xn • (Submodule.Quotient.mk (e.symm p) : Mn) = Submodule.Quotient.mk m
    rw [Module.Quotient.mk_smul_mk]
    congr 1
    apply e.injective
    rw [he, e.apply_symm_apply, hem]
  · rintro ⟨a, ha⟩
    obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective (I ^ (n : ℕ) • (⊤ : Submodule R M)) a
    change xn • (Submodule.Quotient.mk a : Mn) = Submodule.Quotient.mk m at ha
    rw [Module.Quotient.mk_smul_mk, Submodule.Quotient.eq] at ha
    have hd := (mem_adic_smul_iff e x he (n : ℕ) (x • a - m)).mp ha
    have hxa : PowerSeries.X ^ (n : ℕ) ∣
        PowerSeries.X ^ ((n : ℕ) - 1) * e (x • a) := by
      refine ⟨e a, ?_⟩
      rw [he, ← mul_assoc, ← pow_succ, hn]
    have hh := dvd_mul_of_dvd_right hd (PowerSeries.X ^ ((n : ℕ) - 1))
    rw [map_sub, mul_sub] at hh
    simpa only [sub_sub_cancel] using dvd_sub hxa hh
private theorem annihilator_quotient_equiv {k R M : Type*} [CommRing k] [CommRing R]
    [Algebra k R] [AddCommGroup M] [Module R M] [Module k M] [IsScalarTower k R M]
    (e : M ≃ₗ[k] PowerSeries k) (x y : R)
    (he : ∀ m, e (x • m) = PowerSeries.X * e m) (hy : ∀ m : M, y • m = 0) :
    let T := LinearMap.ker (LinearMap.lsmul R M y)
    Nonempty ((T ⧸ (Ideal.span {x} • (⊤ : Submodule R M)).comap T.subtype) ≃ₗ[k] k) := by
  intro T
  let p := (Ideal.span {x} • (⊤ : Submodule R M)).comap T.subtype
  let f : T →ₗ[k] k := (PowerSeries.coeff 0).comp
    (e.toLinearMap.comp (T.subtype.restrictScalars k))
  have hf (m : T) : f m = PowerSeries.constantCoeff (e m.1) :=
    PowerSeries.coeff_zero_eq_constantCoeff_apply _
  have hker : f.ker = p.restrictScalars k := by
    ext m
    rw [LinearMap.mem_ker, hf, ← PowerSeries.X_dvd_iff]
    show PowerSeries.X ∣ e m.1 ↔ m.1 ∈ Ideal.span {x} • (⊤ : Submodule R M)
    simpa using (mem_adic_smul_iff e x he 1 m.1).symm
  have hsurj : Function.Surjective f := by
    intro a
    refine ⟨⟨e.symm (PowerSeries.C a), hy _⟩, ?_⟩
    rw [hf, e.apply_symm_apply, PowerSeries.constantCoeff_C]
  exact ⟨(Submodule.Quotient.restrictScalarsEquiv k p).symm.trans
    ((Submodule.quotEquivOfEq _ _ hker).symm.trans (f.quotKerEquivOfSurjective hsurj))⟩

private theorem quotient_inf_ker_subsingleton {R N : Type*} [CommRing R]
    [AddCommGroup N] [Module R N] (x y z : R)
    (h : Function.Exact (LinearMap.lsmul R N x) (LinearMap.lsmul R N z)) :
    let T := LinearMap.ker (LinearMap.lsmul R N y) ⊓ LinearMap.ker (LinearMap.lsmul R N z)
    Subsingleton (T ⧸ (Ideal.span {x} • (⊤ : Submodule R N)).comap T.subtype) := by
  intro T
  apply Submodule.Quotient.subsingleton_iff.mpr
  apply top_unique
  intro m _
  rw [Submodule.mem_comap, ← range_lsmul_eq_span_smul_top]
  exact (h m.1).mp m.2.2
private theorem extTwo_subsingleton_of_exact {R M N : Type u} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (p : R →ₗ[R] M) (x y z : R) (hp : Function.Surjective p)
    (hyp : Function.Exact (LinearMap.lsmul R R y) p)
    (hxy : Function.Exact (LinearMap.lsmul R R x) (LinearMap.lsmul R R y))
    (hyzx : Function.Exact ((LinearMap.lsmul R R y).coprod (LinearMap.lsmul R R z))
      (LinearMap.lsmul R R x))
    (hN : Function.Exact (LinearMap.lsmul R N x) (LinearMap.lsmul R N z)) :
    Subsingleton (Ext (ModuleCat.of R M) (ModuleCat.of R N) 2) := by
  obtain ⟨e⟩ := extTwoEquivOfCoprod (R := R) (M := M) (N := N) p x y z hp hyp hxy hyzx
  have := quotient_inf_ker_subsingleton (N := N) x y z hN
  exact e.injective.subsingleton
private theorem exact_quotient_span_pow {R : Type*} [CommRing R]
    (x y : R) (hzero : x * y = 0)
    (hxy : Function.Exact (LinearMap.lsmul R R x) (LinearMap.lsmul R R y))
    (hyx : Function.Exact (LinearMap.lsmul R R y) (LinearMap.lsmul R R x))
    (hsep : ∀ a b : R, x * a = y * b → y * b = 0) (n : ℕ+) :
    let Q := R ⧸ (Ideal.span {x}) ^ (n : ℕ)
    let a : Q := Ideal.Quotient.mk _ x
    let b : Q := Ideal.Quotient.mk _ y
    Function.Exact (LinearMap.lsmul Q Q a) (LinearMap.lsmul Q Q b) ∧
      Function.Exact ((LinearMap.lsmul Q Q b).coprod
        (LinearMap.lsmul Q Q (a ^ ((n : ℕ) - 1)))) (LinearMap.lsmul Q Q a) := by
  have aux (J : Ideal R) (hJ : J = Ideal.span {x ^ ((n : ℕ) - 1 + 1)}) :
      let Q := R ⧸ J
      let a : Q := Ideal.Quotient.mk _ x
      let b : Q := Ideal.Quotient.mk _ y
      Function.Exact (LinearMap.lsmul Q Q a) (LinearMap.lsmul Q Q b) ∧
        Function.Exact ((LinearMap.lsmul Q Q b).coprod
          (LinearMap.lsmul Q Q (a ^ ((n : ℕ) - 1)))) (LinearMap.lsmul Q Q a) := by
    subst J
    exact ⟨exact_mul_quotient_pow_of_disjoint x y hzero hxy hsep _,
      exact_mul_coprod_quotient_pow x y hzero hyx _⟩
  apply aux
  have hn : (n : ℕ) - 1 + 1 = (n : ℕ) := Nat.sub_add_cancel n.property
  rw [hn, Ideal.span_singleton_pow]

/-- **Stacks 0EH2.** For `A = k[[x, y]] / (xy)` and `M = A / (y)`, the periodic
resolution computes `Ext_A^2(M, N)` as `N[y] / xN`.  At the finite level the numerator
is the intersection of the `y`-torsion and the `x^(n - 1)`-torsion.  In particular,
for `N = M`, the original Ext group is additively isomorphic to `k`, while every
finite-level Ext group vanishes. -/
@[stacks 0EH2]
public theorem extTwo_not_preserved_by_adicQuotients (k : Type u) [Field k] :
    let R := MvPowerSeries (Fin 2) k
    let X : R := MvPowerSeries.X 0
    let Y : R := MvPowerSeries.X 1
    let A := R ⧸ Ideal.span {X * Y}
    let x : A := Ideal.Quotient.mk _ X
    let y : A := Ideal.Quotient.mk _ Y
    let I : Ideal A := Ideal.span {x}
    let M := A ⧸ Ideal.span {y}
    Function.Exact (LinearMap.lsmul A A y) (LinearMap.lsmul A A x) ∧
      Function.Exact (LinearMap.lsmul A A x) (LinearMap.lsmul A A y) ∧
      Function.Exact (LinearMap.lsmul A A y) (Submodule.mkQ (Ideal.span {y})) ∧
      Function.Surjective (Submodule.mkQ (Ideal.span {y})) ∧
      (∀ (N : Type u) [AddCommGroup N] [Module A N],
        let Ky := LinearMap.ker (LinearMap.lsmul A N y)
        Nonempty (Ext (ModuleCat.of A M) (ModuleCat.of A N) 2 ≃ₗ[A]
          (Ky ⧸ ((I • (⊤ : Submodule A N)).comap Ky.subtype)))) ∧
      (∀ (n : ℕ+),
        let An := A ⧸ I ^ (n : ℕ)
        let xn : An := Ideal.Quotient.mk _ x
        let yn : An := Ideal.Quotient.mk _ y
        let Mn := M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A M))
        ∃ q : An →ₗ[An] Mn,
          q 1 = Submodule.Quotient.mk (Ideal.Quotient.mk (Ideal.span {y}) 1) ∧
          Function.Surjective q ∧
          Function.Exact (LinearMap.lsmul An An yn) q ∧
          Function.Exact (LinearMap.lsmul An An xn) (LinearMap.lsmul An An yn) ∧
          Function.Exact
            ((LinearMap.lsmul An An yn).coprod
              (LinearMap.lsmul An An (xn ^ ((n : ℕ) - 1))))
            (LinearMap.lsmul An An xn)) ∧
      (∀ (N : Type u) [AddCommGroup N] [Module A N] (n : ℕ+),
        let An := A ⧸ I ^ (n : ℕ)
        let anCommRing : CommRing An := Ideal.Quotient.commRing (I ^ (n : ℕ))
        letI : Ring An := anCommRing.toRing
        letI : CommSemiring An := anCommRing.toCommSemiring
        letI : Semiring An := anCommRing.toSemiring
        letI : Linear An (ModuleCat An) := ModuleCat.Algebra.instLinear
        let xn : An := Ideal.Quotient.mk _ x
        let yn : An := Ideal.Quotient.mk _ y
        let Nn := N ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A N))
        let K := LinearMap.ker (LinearMap.lsmul An Nn yn) ⊓
          LinearMap.ker (LinearMap.lsmul An Nn (xn ^ ((n : ℕ) - 1)))
        let xNn : Submodule An Nn := Ideal.span {xn} • ⊤
        let xK : Submodule An K := xNn.comap K.subtype
        Nonempty (Ext (ModuleCat.of An
            (M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A M))))
          (ModuleCat.of An Nn) 2 ≃ₗ[An] (K ⧸ xK))) ∧
      letI : Module k (Ext (ModuleCat.of A M) (ModuleCat.of A M) 2) :=
        Module.compHom _ (algebraMap k A)
      Nonempty (Ext (ModuleCat.of A M) (ModuleCat.of A M) 2 ≃ₗ[k] k) ∧
      (∀ (n : ℕ+),
        let An := A ⧸ I ^ (n : ℕ)
        let xn : An := Ideal.Quotient.mk _ x
        let Mn := M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A M))
        Nonempty (Mn ≃ₗ[k] ((Polynomial k) ⧸
          (Ideal.span {Polynomial.X ^ (n : ℕ)} : Ideal (Polynomial k)))) ∧
          Function.Exact (LinearMap.lsmul An Mn xn)
            (LinearMap.lsmul An Mn (xn ^ ((n : ℕ) - 1))) ∧
          Subsingleton (Ext (ModuleCat.of An Mn) (ModuleCat.of An Mn) 2)) := by
  intro R X Y A x y I M
  obtain ⟨hyx, hxy, hyp, hp⟩ := node_exactness k
  have hzero : x * y = 0 := by
    show Ideal.Quotient.mk _ X * Ideal.Quotient.mk _ Y = 0
    rw [← map_mul]
    exact Ideal.Quotient.mk_singleton_self _
  have hsep : ∀ a b : A, x * a = y * b → y * b = 0 := node_disjoint k
  have hfin (n : ℕ+) :
      let An := A ⧸ I ^ (n : ℕ)
      let xn : An := Ideal.Quotient.mk _ x
      let yn : An := Ideal.Quotient.mk _ y
      let Mn := M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A M))
      ∃ q : An →ₗ[An] Mn,
        q 1 = Submodule.Quotient.mk (Ideal.Quotient.mk (Ideal.span {y}) 1) ∧
        Function.Surjective q ∧
        Function.Exact (LinearMap.lsmul An An yn) q ∧
        Function.Exact (LinearMap.lsmul An An xn) (LinearMap.lsmul An An yn) ∧
        Function.Exact
          ((LinearMap.lsmul An An yn).coprod
            (LinearMap.lsmul An An (xn ^ ((n : ℕ) - 1))))
          (LinearMap.lsmul An An xn) := by
    intro An xn yn Mn
    obtain ⟨q, hq1, hqs, hqe⟩ := quotient_span_adic_presentation x y (n : ℕ)
    obtain ⟨hxy', hyzx⟩ := exact_quotient_span_pow x y hzero hxy hyx hsep n
    exact ⟨q, hq1, hqs, hqe, hxy', hyzx⟩
  refine ⟨hyx, hxy, hyp, hp, ?_, hfin, ?_, ?_⟩
  · intro N _ _
    exact extTwoEquivOfPeriodic x y hxy hyx
  · intro N _ _ n
    obtain ⟨q, _, hqs, hqe, hxy', hyzx⟩ := hfin n
    exact extTwoEquivOfCoprod q _ _ _ hqs hqe hxy' hyzx
  · obtain ⟨e0, hex0⟩ := node_axis_equiv k
    let e : M ≃ₐ[k] PowerSeries k := e0
    have hex : e (Ideal.Quotient.mk _ x) = PowerSeries.X := hex0
    have he (m : M) : e.toLinearEquiv (x • m) = PowerSeries.X * e m := by
      show e (Ideal.Quotient.mk _ x * m) = _
      rw [map_mul, hex]
    have hym (m : M) : y • m = 0 := by
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective m
      show Ideal.Quotient.mk (Ideal.span {y}) (y * a) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
      exact ⟨a, rfl⟩
    constructor
    · obtain ⟨eExt⟩ := extTwoEquivOfPeriodic (N := M) x y hxy hyx
      obtain ⟨eK⟩ := annihilator_quotient_equiv e.toLinearEquiv x y he hym
      let : Module k (Ext (ModuleCat.of A M) (ModuleCat.of A M) 2) :=
        Module.compHom _ (algebraMap k A)
      let : IsScalarTower k A (Ext (ModuleCat.of A M) (ModuleCat.of A M) 2) :=
        IsScalarTower.of_compHom k A _
      exact ⟨(eExt.restrictScalars k).trans eK⟩
    · intro n
      refine ⟨adic_quotient_equiv_polynomial e.toLinearEquiv x he (n : ℕ), ?_, ?_⟩
      · exact exact_adic_smul_pow e.toLinearEquiv x he n
      · obtain ⟨q, _, hqs, hqe, hxy', hyzx⟩ := hfin n
        exact extTwo_subsingleton_of_exact (R := A ⧸ I ^ (n : ℕ))
          (M := M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A M)))
          (N := M ⧸ (I ^ (n : ℕ) • (⊤ : Submodule A M)))
          q _ _ _ hqs hqe hxy' hyzx
          (exact_adic_smul_pow e.toLinearEquiv x he n)

end
end Stacks.AdicSystem.ExtCounterexample

