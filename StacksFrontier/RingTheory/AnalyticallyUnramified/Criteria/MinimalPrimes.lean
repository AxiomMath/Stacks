* [Stacks Project, Tag 032W](https://stacks.math.columbia.edu/tag/032W)
-/

namespace Stacks.AnalyticallyUnramified.MinimalPrimeCriterion

open Stacks.AnalyticallyUnramified.CuttingCriterion

open IsLocalRing TensorProduct

/-! ### Base change of ideals along a flat algebra

The two facts about the completion used in parts (2) and (3) are facts about an arbitrary flat
algebra: an annihilator ideal, and a finite intersection of ideals, both base change. They are
proved here from right exactness of the tensor product together with `Module.Flat.rTensor_exact`.
-/

/-- An element `y` of an `R`-algebra `S` lies in the ideal generated by `I` if and only if it is
the image of an element of `I ⊗[R] S`. -/
private theorem mem_map_algebraMap_iff_exists_rTensor_subtype_eq {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (I : Ideal R) (y : S) :
    y ∈ I.map (algebraMap R S) ↔ ∃ z, (I.subtype.rTensor S) z = (TensorProduct.lid R S).symm y := by
  have h : y ∈ ((TensorProduct.lid R S).toLinearMap.comp (I.subtype.rTensor S)).range ↔
      y ∈ I.map (algebraMap R S) := by
    rw [Ideal.subtype_rTensor_range, Ideal.smul_top_eq_map]
    rfl
  rw [← h]
  refine exists_congr fun z => ?_
  rw [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.eq_symm_apply]

/-- An element `y` of an `R`-algebra `S` lies in the ideal generated by `I` if and only if it dies
in `(R ⧸ I) ⊗[R] S`. -/
private theorem mem_map_algebraMap_iff_rTensor_mkQ_eq_zero {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (I : Ideal R) (y : S) :
    y ∈ I.map (algebraMap R S) ↔ (I.mkQ.rTensor S) ((TensorProduct.lid R S).symm y) = 0 := by
  have hex : Function.Exact (I.subtype.rTensor S) (I.mkQ.rTensor S) :=
    rTensor_exact S (LinearMap.exact_subtype_mkQ I) I.mkQ_surjective
  rw [hex ((TensorProduct.lid R S).symm y), mem_map_algebraMap_iff_exists_rTensor_subtype_eq]
  rfl

/-- Base change along a flat algebra commutes with the intersection of two ideals. -/
private theorem map_inf_of_flat {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Flat R S] (I J : Ideal R) :
    (I ⊓ J).map (algebraMap R S) = I.map (algebraMap R S) ⊓ J.map (algebraMap R S) := by
  refine le_antisymm (Ideal.map_inf_le (algebraMap R S)) ?_
  rintro y ⟨hyI, hyJ⟩
  obtain ⟨z, hz⟩ := (mem_map_algebraMap_iff_exists_rTensor_subtype_eq I y).mp hyI
  set α : (I : Submodule R R) →ₗ[R] R ⧸ J := J.mkQ ∘ₗ I.subtype with hα
  set β : (I ⊓ J : Ideal R) →ₗ[R] (I : Submodule R R) := Submodule.inclusion inf_le_left with hβ
  have hexαβ : Function.Exact β α := by
    intro x
    simp only [hα, hβ, LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply,
      Submodule.subtype_apply, Submodule.Quotient.mk_eq_zero]
    refine ⟨fun hx => ⟨⟨(x : R), ⟨x.2, hx⟩⟩, rfl⟩, ?_⟩
    rintro ⟨w, rfl⟩
    exact w.2.2
  have hflat := Module.Flat.rTensor_exact (M := S) hexαβ
  have hzα : (α.rTensor S) z = 0 := by
    have hJ : (J.mkQ.rTensor S) ((TensorProduct.lid R S).symm y) = 0 :=
      (mem_map_algebraMap_iff_rTensor_mkQ_eq_zero J y).mp hyJ
    rw [hα, LinearMap.rTensor_comp]
    simpa [hz] using hJ
  obtain ⟨w, hw⟩ := (hflat z).mp hzα
  refine (mem_map_algebraMap_iff_exists_rTensor_subtype_eq _ y).mpr ⟨w, ?_⟩
  have hsub : (I ⊓ J : Ideal R).subtype = I.subtype ∘ₗ β := rfl
  rw [hsub, LinearMap.rTensor_comp, LinearMap.comp_apply, hw, hz]

/-- Base change along a flat algebra commutes with the intersection of a finite family of
ideals. -/
private theorem map_biInf_of_flat {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Flat R S] {T : Set (Ideal R)} (hT : T.Finite) :
    (⨅ I ∈ T, I).map (algebraMap R S) = ⨅ I ∈ T, I.map (algebraMap R S) := by
  induction T, hT using Set.Finite.induction_on with
  | empty => simpa using Ideal.map_top (algebraMap R S)
  | @insert a T _ _ ih => rw [iInf_insert, iInf_insert, map_inf_of_flat, ih]

/-- If the ideal `q` of `R` is the annihilator of `f : R`, then in a flat `R`-algebra `S` the ideal
generated by `q` is the annihilator of the image of `f`. -/
private theorem mem_map_iff_mul_eq_zero_of_flat {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] (f : R) (q : Ideal R) (hq : ∀ x : R, x ∈ q ↔ f * x = 0)
    (y : S) : y ∈ q.map (algebraMap R S) ↔ algebraMap R S f * y = 0 := by
  have hex : Function.Exact q.subtype (LinearMap.lsmul R R f) := by
    intro x
    simp only [LinearMap.lsmul_apply, smul_eq_mul]
    refine ⟨fun h => ⟨⟨x, (hq x).mpr h⟩, rfl⟩, ?_⟩
    rintro ⟨w, rfl⟩
    exact (hq _).mp w.2
  have hflat := Module.Flat.rTensor_exact (M := S) hex
  have key :
    ∀ z : R ⊗[R] S,
      (TensorProduct.lid R S) ((LinearMap.lsmul R R f).rTensor S z) =
        algebraMap R S f * (TensorProduct.lid R S) z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul a
      b =>
      simp only [LinearMap.rTensor_tmul, LinearMap.lsmul_apply, TensorProduct.lid_tmul,
        smul_eq_mul, map_mul, Algebra.smul_def]
      ring
    | add x y hx hy => simp [hx, hy, mul_add]
  constructor
  · intro hy
    have hle :
      q.map (algebraMap R S) ≤ LinearMap.ker (LinearMap.lsmul S S (algebraMap R S f)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      simp only [Ideal.mem_comap, LinearMap.mem_ker, LinearMap.lsmul_apply, smul_eq_mul, ← map_mul,
        (hq x).mp hx, map_zero]
    simpa using hle hy
  · intro hy
    have h0 : (LinearMap.lsmul R R f).rTensor S ((TensorProduct.lid R S).symm y) = 0 := by
      apply (TensorProduct.lid R S).injective
      rw [key]
      simpa using hy
    obtain ⟨z, hz⟩ := (hflat _).mp h0
    exact (mem_map_algebraMap_iff_exists_rTensor_subtype_eq q y).mpr ⟨z, hz⟩


/-- If the `I`-adic completion of `R` is reduced and `R` is `I`-adically Hausdorff, then `R` is
reduced: the canonical map `R → R^` is then injective, and reducedness passes to subrings. -/
@[ega "IV 7.8.3" "(v)"]
private theorem isReduced_of_isReduced_adicCompletion {R : Type*} [CommRing R] (I : Ideal R)
    [IsHausdorff I R] (h : IsReduced (AdicCompletion I R)) : IsReduced R :=
  isReduced_of_injective (algebraMap R (AdicCompletion I R)) (AdicCompletion.of_injective I R)

/-! ### The completion of a quotient

The identification `(R ⧸ I)^ = R^ ⧸ I R^` is `nonempty_ringEquiv_adicCompletion_quotient`; it is
used here to turn analytic unramifiedness of `R ⧸ I` into reducedness of `R^ ⧸ I R^`.
-/

/-- Analytic unramifiedness of `R ⧸ I` says that `R^ ⧸ I R^` is reduced. -/
private theorem isAnalyticallyUnramified_quotient_iff {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)] :
    IsAnalyticallyUnramified (R ⧸ I) ↔
      IsReduced
        (AdicCompletion (maximalIdeal R) R ⧸
          I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) := by
  obtain ⟨e⟩ := nonempty_ringEquiv_adicCompletion_quotient I
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have : IsReduced (AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I)) := h
    exact isReduced_of_injective e.symm e.symm.injective
  · have := h
    exact isReduced_of_injective e e.injective

/-- In a reduced Noetherian ring the minimal primes intersect in `⊥`, and completion is flat, so
the ideals they generate in the completion still intersect in `⊥`. -/
private theorem iInf_map_minimalPrimes_eq_bot {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (hred : IsReduced R) :
    ⨅ q ∈ minimalPrimes R, Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) q = ⊥ := by
  have := hred
  rw [← map_biInf_of_flat (minimalPrimes.finite_of_isNoetherianRing R), ← sInf_eq_iInf,
    show minimalPrimes R = (⊥ : Ideal R).minimalPrimes from rfl, Ideal.sInf_minimalPrimes,
    Ideal.radical_bot_of_isReduced, Ideal.map_bot]

/-- If an ideal `J` of a reduced ring `A` is the annihilator of an element `f`, then `A ⧸ J` is
reduced: from `f x ^ n = 0` one gets `(f x) ^ n = 0`, hence `f x = 0`, hence `x ∈ J`. -/
private theorem isReduced_quotient_of_mem_iff_mul_eq_zero {A : Type*} [CommRing A] [IsReduced A]
    (J : Ideal A) (f : A) (hf : ∀ x : A, x ∈ J ↔ f * x = 0) : IsReduced (A ⧸ J) := by
  constructor
  intro y hy
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨n, hn⟩ := hy
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, hf] at hn
  rw [Ideal.Quotient.eq_zero_iff_mem, hf]
  rcases n with _ | n
  · simp only [pow_zero, mul_one] at hn
    simp [hn]
  · have h2 : IsNilpotent (f * x) :=
      ⟨n + 1, by
        rw [mul_pow]
        calc
          f ^ (n + 1) * x ^ (n + 1) = f ^ n * (f * x ^ (n + 1)) := by ring
          _ = 0 := by rw [hn, mul_zero]⟩
    exact h2.eq_zero

/-- A minimal prime `q` of a Noetherian ring `R` is an associated prime (Tag 02CE), so
`q = {x ∈ R | f x = 0}` for some `f ∈ R`; since completion is exact (Tag 00MB), the ideal `q R^`
of the completion is again the annihilator of `f`. -/
private theorem exists_forall_mem_map_iff_mul_eq_zero {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {q : Ideal R} (hq : q ∈ minimalPrimes R) :
    ∃ f : AdicCompletion (maximalIdeal R) R,
      ∀ x : AdicCompletion (maximalIdeal R) R,
        x ∈ Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) q ↔ f * x = 0 := by
  have hann : Module.annihilator R R = ⊥ :=
    Module.annihilator_eq_bot.mpr ((faithfulSMul_iff_algebraMap_injective R R).mpr fun {_ _} a ↦ a)
  have hass : q ∈ associatedPrimes R R := by
    apply Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes
    rwa [hann]
  obtain ⟨-, g, hg⟩ := (Submodule.isAssociatedPrime_iff (R := R)).mp hass
  refine ⟨algebraMap R _ g, fun x => ?_⟩
  refine mem_map_iff_mul_eq_zero_of_flat g q (fun y => ?_) x
  rw [hg, Submodule.mem_colon_singleton, smul_eq_mul, Submodule.mem_bot, mul_comm]

/-- **Part (2) of the source.** A minimal prime of an analytically unramified Noetherian local
ring is analytically unramified. -/
private theorem isAnalyticallyUnramified_quotient_of_mem_minimalPrimes {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (h : IsAnalyticallyUnramified R) {q : Ideal R}
    (hq : q ∈ minimalPrimes R) [IsLocalRing (R ⧸ q)] : IsAnalyticallyUnramified (R ⧸ q) := by
  have : IsReduced (AdicCompletion (maximalIdeal R) R) := h
  obtain ⟨f, hf⟩ := exists_forall_mem_map_iff_mul_eq_zero hq
  exact
    (isAnalyticallyUnramified_quotient_iff q).mpr
      (isReduced_quotient_of_mem_iff_mul_eq_zero _ f hf)

/-- **Part (3) of the source.** A reduced Noetherian local ring all of whose minimal primes are
analytically unramified is analytically unramified. -/
private theorem isAnalyticallyUnramified_of_forall_mem_minimalPrimes {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (hred : IsReduced R)
    (h : ∀ q ∈ minimalPrimes R, ∀ [IsLocalRing (R ⧸ q)], IsAnalyticallyUnramified (R ⧸ q)) :
    IsAnalyticallyUnramified R := by
  constructor
  intro x hx
  have key :
    ∀ q ∈ minimalPrimes R, x ∈ Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) q := by
    intro q hq
    have : IsLocalRing (R ⧸ q) := isLocalRing_quotient hq.1.1.ne_top
    have := (isAnalyticallyUnramified_quotient_iff q).mp (h q hq)
    have :=
      (hx.map
          (Ideal.Quotient.mk
            (Ideal.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) q))).eq_zero
    exact (Ideal.Quotient.eq_zero_iff_mem).mp this
  have : x ∈ (⊥ : Ideal (AdicCompletion (maximalIdeal R) R)) := by
    rw [← iInf_map_minimalPrimes_eq_bot hred]
    simpa using key
  simpa using this

/-! ### Part (4): finiteness of the integral closure

The completion `R^` is Noetherian (Tag 05GH) and complete, hence a Nagata ring (Tag 032W), so each
quotient of `R^` by a prime is N-2 and in particular N-1. Since `R^` is reduced this makes `R^`
itself N-1, and N-1 descends along the faithfully flat map `R → R^`.
-/

/-- The completion of a Noetherian local ring is a faithfully flat `R`-module: it is flat, and
`m R^` is the maximal ideal of `R^`, hence proper. -/
@[ega "0 7.3.3" "special case", sga "1 IV 3.1" "special case", sga "3 VIIB 5.5.2" "partial"]
private theorem faithfullyFlat_adicCompletion (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] : Module.FaithfullyFlat R (AdicCompletion (maximalIdeal R) R) := by
  rw [Module.faithfullyFlat_iff]
  refine ⟨AdicCompletion.flat_of_isNoetherian _, fun {m} hm hcon => ?_⟩
  rw [eq_maximalIdeal hm, Ideal.smul_top_eq_map, Submodule.restrictScalars_eq_top_iff, ←
    AdicCompletion.maximalIdeal_eq_map] at hcon
  exact (maximalIdeal.isMaximal (AdicCompletion (maximalIdeal R) R)).ne_top hcon

/-- **N-1 descends along a faithfully flat extension of Noetherian rings.** If `S` is a Noetherian
faithfully flat `R`-algebra and `S` is N-1, then `R` is N-1.

This is the descent step of part (4) of the source, in the generality the argument has: all it uses
of `R → R^` is Noetherianity of the two rings and faithful flatness. A nonzerodivisor of `R` stays
one in `S` because `S` is flat, so the total ring of fractions `Q(R)` base changes to a
localization `S ⊗[R] Q(R)` of `S` at a submonoid of nonzerodivisors (`IsLocalization.tensor`),
which therefore embeds into `Q(S)`. The image of `S ⊗[R] R'` there is integral over `S`, hence
lies in the integral closure of `S` in `Q(S)`, a finite `S`-module; as `S` is Noetherian
`S ⊗[R] R'` is a finite `S`-module, and faithful flatness brings the finiteness down to `R`. -/
private theorem isN1_of_faithfullyFlat (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    [IsNoetherianRing R] [IsNoetherianRing S] [Module.FaithfullyFlat R S] (h : IsN1 S) :
    IsN1 R := by
  have : Module.Flat R S := Module.FaithfullyFlat.toFlat
  have hnzd : ∀ s ∈ nonZeroDivisors R, algebraMap R S s ∈ nonZeroDivisors S := by
    intro s hs
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    have hq : ∀ x : R, x ∈ (⊥ : Ideal R) ↔ s * x = 0 := by
      intro x
      rw [Submodule.mem_bot]
      exact
        ⟨fun hx => by simp [hx], fun hx =>
          (mem_nonZeroDivisors_iff_right.mp hs) x (by rwa [mul_comm] at hx)⟩
    simpa using (mem_map_iff_mul_eq_zero_of_flat s ⊥ hq y).mpr (by rwa [mul_comm])
  have hWle : Algebra.algebraMapSubmonoid S (nonZeroDivisors R) ≤ nonZeroDivisors S := by
    rintro _ ⟨s, hs, rfl⟩
    exact hnzd s hs
  have :
    IsLocalization (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)) (S ⊗[R] FractionRing R) :=
    IsLocalization.tensor (FractionRing R) (nonZeroDivisors R)
  have hu :
    ∀ y : Algebra.algebraMapSubmonoid S (nonZeroDivisors R),
      IsUnit (algebraMap S (FractionRing S) y) :=
    fun y => IsLocalization.map_units (FractionRing S) ⟨y.1, hWle y.2⟩
  set f : (S ⊗[R] FractionRing R) →+* FractionRing S := IsLocalization.lift hu with hfdef
  have hfc :
    ∀ x : S, f (algebraMap S (S ⊗[R] FractionRing R) x) = algebraMap S (FractionRing S) x :=
    fun x => IsLocalization.lift_eq hu x
  have hSinj : Function.Injective (algebraMap S (FractionRing S)) :=
    IsLocalization.injective (FractionRing S) le_rfl
  have hfinj : Function.Injective f := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨⟨a, s⟩, hs⟩ :=
      IsLocalization.surj (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)) x
    have h1 : algebraMap S (FractionRing S) a = 0 := by rw [← hfc a, ← hs, map_mul, hx, zero_mul]
    have h2 : a = 0 := hSinj (by rw [h1, map_zero])
    have h3 : x * algebraMap S (S ⊗[R] FractionRing R) (s : S) = 0 := by rw [hs, h2, map_zero]
    exact (IsLocalization.map_units (S ⊗[R] FractionRing R) s).mul_left_eq_zero.mp h3
  set fA : (S ⊗[R] FractionRing R) →ₐ[S] FractionRing S := { f with commutes' := hfc } with hfAdef
  set φ : FractionRing R →ₐ[R] FractionRing S :=
    (fA.restrictScalars R).comp Algebra.TensorProduct.includeRight with hφdef
  set ι : (integralClosure R (FractionRing R)) →ₗ[R] FractionRing R :=
    (integralClosure R (FractionRing R)).val.toLinearMap with hιdef
  have hιinj : Function.Injective ι := Subtype.coe_injective
  set g : S ⊗[R] (integralClosure R (FractionRing R)) →ₗ[S] FractionRing S :=
    fA.toLinearMap ∘ₗ ι.baseChange S with hgdef
  have hbinj : Function.Injective (ι.baseChange S) := by
    rw [LinearMap.baseChange_eq_lTensor]
    exact Module.Flat.lTensor_preserves_injective_linearMap ι hιinj
  have hginj : Function.Injective g := hfinj.comp hbinj
  have hmem : ∀ z, g z ∈ (integralClosure S (FractionRing S)).toSubmodule := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul s
      x =>
      have hz : (s ⊗ₜ[R] x : S ⊗[R] (integralClosure R (FractionRing R))) = s • (1 ⊗ₜ[R] x) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have hgx : g (1 ⊗ₜ[R] x) = φ (x : FractionRing R) := by simp [hgdef, hφdef, hιdef]
      rw [hz, map_smul, hgx]
      exact
        Submodule.smul_mem _ _
          ((Subalgebra.mem_toSubmodule _).mpr ((x.2.map φ).tower_top (A := S)))
    | add a b ha hb =>
      rw [map_add]; exact add_mem ha hb
  have : IsNoetherian S (integralClosure S (FractionRing S)) :=
    have : Module.Finite S (integralClosure S (FractionRing S)) := h
    isNoetherian_of_isNoetherianRing_of_finite _ _
  have : Module.Finite S (S ⊗[R] (integralClosure R (FractionRing R))) := by
    refine
      Module.Finite.of_injective
        (LinearMap.codRestrict (integralClosure S (FractionRing S)).toSubmodule g hmem)
        fun a b hab => hginj (congrArg Subtype.val hab)
  exact Module.Finite.of_finite_tensorProduct_of_faithfullyFlat S

/-- The fraction field of a quotient of `A` by a prime `q`, in the form `Ideal.ResidueField q`,
receives the integral closure of `A ⧸ q`: if `A ⧸ q` is N-1, then the integral closure of `A`
itself in `q.ResidueField` is a finite `A`-module.

The integral closure of `A` in `q.ResidueField` is contained in that of `A ⧸ q`, because
`A → A ⧸ q` is surjective, and the latter is finite over `A ⧸ q` by hypothesis, hence over `A`. -/
private theorem module_finite_integralClosure_residueField {A : Type*} [CommRing A]
    [IsNoetherianRing A] (q : Ideal A) [q.IsPrime]
    (h : Module.Finite (A ⧸ q) (integralClosure (A ⧸ q) (FractionRing (A ⧸ q)))) :
    Module.Finite A (integralClosure A q.ResidueField) := by
  have := h
  have : Module.Finite (A ⧸ q) (integralClosure (A ⧸ q) q.ResidueField) :=
    Module.Finite.equiv
      (IsLocalization.algEquiv (nonZeroDivisors (A ⧸ q)) (FractionRing (A ⧸ q))
          q.ResidueField).mapIntegralClosure.toLinearEquiv
  have : Module.Finite A (A ⧸ q) :=
    Module.Finite.of_surjective (Algebra.linearMap A (A ⧸ q)) Ideal.Quotient.mk_surjective
  have : Module.Finite A (integralClosure (A ⧸ q) q.ResidueField) := Module.Finite.trans (A ⧸ q) _
  have hfin :
    Module.Finite A (Subalgebra.restrictScalars A (integralClosure (A ⧸ q) q.ResidueField)) :=
    inferInstanceAs (Module.Finite A (integralClosure (A ⧸ q) q.ResidueField))
  have hle :
    integralClosure A q.ResidueField ≤
      Subalgebra.restrictScalars A (integralClosure (A ⧸ q) q.ResidueField) :=
    fun _ hx => IsIntegral.tower_top hx
  exact
    Module.Finite.of_injective (Subalgebra.inclusion hle).toLinearMap
      (Subalgebra.inclusion_injective hle)

/-- A nonzerodivisor of `A` becomes a unit in the residue field at a minimal prime `q`: it does not
lie in `q`, since every element of a minimal prime is a zerodivisor. -/
private theorem isUnit_algebraMap_residueField {A : Type*} [CommRing A] {q : Ideal A} [q.IsPrime]
    (hq : q ∈ minimalPrimes A) (s : nonZeroDivisors A) : IsUnit (algebraMap A q.ResidueField s) :=
  isUnit_iff_ne_zero.mpr fun hz =>
    notMem_nonZeroDivisors_of_mem_mem_minimalPrimes (Ideal.algebraMap_residueField_eq_zero.mp hz)
      hq s.2

/-- The map from the total ring of fractions of `A` to the residue field at a minimal prime `q`,
i.e. to the fraction field of `A ⧸ q`. It exists because the nonzerodivisors of `A` become units
there (`isUnit_algebraMap_residueField`). -/
private noncomputable def liftResidueField {A : Type*} [CommRing A] {q : Ideal A} [q.IsPrime]
    (hq : q ∈ minimalPrimes A) : FractionRing A →ₐ[A] q.ResidueField :=
  { IsLocalization.lift (isUnit_algebraMap_residueField hq) with
    commutes' := fun r => IsLocalization.lift_eq _ r }

/-- `liftResidueField` is the localization lift it is built from. -/
private theorem liftResidueField_apply {A : Type*} [CommRing A] {q : Ideal A} [q.IsPrime]
    (hq : q ∈ minimalPrimes A) (x : FractionRing A) :
    liftResidueField hq x = IsLocalization.lift (isUnit_algebraMap_residueField hq) x :=
  rfl

/-- A fraction `a / s` dies in the residue field at a minimal prime `q` exactly when `a ∈ q`. -/
private theorem liftResidueField_eq_zero_iff {A : Type*} [CommRing A] {q : Ideal A} [q.IsPrime]
    (hq : q ∈ minimalPrimes A) (a : A) (s : nonZeroDivisors A) :
    liftResidueField hq (IsLocalization.mk' (FractionRing A) a s) = 0 ↔ a ∈ q := by
  rw [liftResidueField_apply]
  refine (IsLocalization.lift_mk'_spec (isUnit_algebraMap_residueField hq) a 0 s).trans ?_
  simp [Ideal.algebraMap_residueField_eq_zero]

/-- A reduced Noetherian ring is N-1 as soon as each of its quotients by a minimal prime is.

The source's route: `A` reduced has `⋂ qᵢ = 0`, so `Q(A)` embeds into the product of the fraction
fields `Q(A ⧸ qᵢ)` over the (finitely many) minimal primes — realized here as the residue fields
`Ideal.ResidueField qᵢ`, the map being `liftResidueField` and its injectivity
`Stacks.Flatness.ReducedFibreAscent.eq_zero_of_forall_mem_minimalPrimes` — and the integral
closure of `A` in `Q(A)` lands in the product of the integral closures of `A` in the
`Q(A ⧸ qᵢ)`; each factor is a finite `A`-module by
`module_finite_integralClosure_residueField`, so the integral closure of `A` in `Q(A)` is an
`A`-submodule of a finite `A`-module over the Noetherian ring `A`. -/
private theorem isN1_of_forall_isN1_quotient_minimalPrimes {A : Type*} [CommRing A]
    [IsNoetherianRing A] (hred : IsReduced A) (h : ∀ q ∈ minimalPrimes A, IsN1 (A ⧸ q)) :
    IsN1 A := by
  have := hred
  have hprime : ∀ q : minimalPrimes A, (q : Ideal A).IsPrime := fun q => q.2.1.1
  have : Finite (minimalPrimes A) := (minimalPrimes.finite_of_isNoetherianRing A).to_subtype
  have hzero :
    ∀ z : FractionRing A, (∀ q : minimalPrimes A, liftResidueField q.2 z = 0) → z = 0 := by
    intro z hz
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) z
    change IsLocalization.mk' (FractionRing A) a s = 0
    have ha : ∀ q ∈ minimalPrimes A, a ∈ q := by
      intro q hq
      have : q.IsPrime := hq.1.1
      exact (liftResidueField_eq_zero_iff hq a s).mp (hz ⟨q, hq⟩)
    rw [Stacks.Flatness.ReducedFibreAscent.eq_zero_of_forall_mem_minimalPrimes ha]
    simp
  have : ∀ q : minimalPrimes A, Module.Finite A (integralClosure A (q : Ideal A).ResidueField) :=
    fun q => module_finite_integralClosure_residueField _ (h q q.2)
  refine
    Module.Finite.of_injective (N :=
      ∀ q : minimalPrimes A, integralClosure A (q : Ideal A).ResidueField)
      (LinearMap.pi fun q =>
        LinearMap.codRestrict (integralClosure A (q : Ideal A).ResidueField).toSubmodule
          ((liftResidueField q.2).toLinearMap ∘ₗ
            (integralClosure A (FractionRing A)).val.toLinearMap)
          fun x => x.2.map (liftResidueField q.2))
      ?_
  refine (injective_iff_map_eq_zero _).mpr fun u hu => ?_
  refine Subtype.ext (hzero _ fun q => ?_)
  have h1 := congrFun hu q
  rw [LinearMap.pi_apply] at h1
  exact congrArg Subtype.val h1

/-- **Part (4) of the source.** An analytically unramified Noetherian local ring is N-1: the
integral closure of `R` in its total ring of fractions is a finite `R`-module. -/
private theorem isN1_of_isAnalyticallyUnramified {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (h : IsAnalyticallyUnramified R) : IsN1 R := by
  have := isNoetherianRing_adicCompletion R
  have hred : IsReduced (AdicCompletion (maximalIdeal R) R) := h
  have :
    IsPrecomplete (maximalIdeal (AdicCompletion (maximalIdeal R) R))
      (AdicCompletion (maximalIdeal R) R) := by
    rw [AdicCompletion.maximalIdeal_eq_map]
    exact
      (completion_noetherian R (maximalIdeal R) inferInstance
          (maximalIdeal R).fg_of_isNoetherianRing).2.toIsPrecomplete
  have := faithfullyFlat_adicCompletion R
  have hnag : IsNagataRing (AdicCompletion (maximalIdeal R) R) :=
    IsNagataRing.of_isPrecomplete_maximalIdeal
  refine
    isN1_of_faithfullyFlat R (AdicCompletion (maximalIdeal R) R)
      (isN1_of_forall_isN1_quotient_minimalPrimes hred fun q hq => ?_)
  have : q.IsPrime := hq.1.1
  exact (hnag.isJapaneseRing_quotient q).finite _

/-- The proof of `isAnalyticallyUnramified_iff_minimalPrimes_and_isN1`. -/
public theorem solution (R : Type*) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] :
    (IsAnalyticallyUnramified R ↔
        IsReduced R ∧
          ∀ q ∈ minimalPrimes R, ∀ [IsLocalRing (R ⧸ q)], IsAnalyticallyUnramified (R ⧸ q)) ∧
      (IsAnalyticallyUnramified R → IsN1 R) :=
  ⟨⟨fun h =>
      ⟨isReduced_of_isReduced_adicCompletion (maximalIdeal R) h, fun _ hq _ =>
        isAnalyticallyUnramified_quotient_of_mem_minimalPrimes h hq⟩,
      fun h => isAnalyticallyUnramified_of_forall_mem_minimalPrimes h.1 h.2⟩,
    isN1_of_isAnalyticallyUnramified⟩

end Stacks.AnalyticallyUnramified.MinimalPrimeCriterion

/-!
# Consequences of analytic unramifiedness

Let `(R, m)` be a Noetherian local ring and let `R^ = lim_n R ⧸ mⁿ` be its `m`-adic completion.
Recall from Tag 032X that `R` is *analytically unramified* when `R^` is reduced, and that a prime
`q ⊂ R` is analytically unramified when the local ring `R ⧸ q` is.

Reducedness of `R^` is strictly stronger than reducedness of `R`, and this file records how the
two are related and what the stronger one buys. The canonical map `R → R^` is injective, so an
analytically unramified ring is reduced. Reducedness of `R` alone does not suffice for the
converse, but it does suffice together with analytic unramifiedness of the (finitely many)
minimal primes of `R`: a reduced ring embeds into the product of its quotients by its minimal
primes, and completion is exact. Analytic unramifiedness also travels down to those minimal
primes, so for a Noetherian local ring `R` the conditions

`R` analytically unramified ⟺ `R` reduced and every minimal prime of `R` analytically unramified

are equivalent. Finally, the finiteness theorem: for analytically unramified `R` the integral
closure of `R` in its total ring of fractions `Q(R)` is a finite `R`-module, that is, `R` is N-1
in the sense of Tag 032F. This is the point of the notion — it is what makes the Nagata property
of the complete ring `R^` (Tag 032W) descend, along the faithfully flat map `R → R^`, to a
finiteness statement about `R` itself.

## Main results

* `isAnalyticallyUnramified_iff_minimalPrimes_and_isN1`: the equivalence displayed above,
  together with the N-1 property of an analytically unramified Noetherian local ring.

## Implementation notes

The five parts of the source are the conjuncts of a single statement. Parts (1) and (2) are the
forward direction of the equivalence, part (3) is its converse, and part (4) is the second
conjunct. Part (5), that an analytically unramified Noetherian local *domain* is N-1, is part (4)
with `[IsDomain R]` adjoined and no change of content: part (4) is verbatim `IsN1 R` of Tag 032F,
whose N-1 predicate is stated for an arbitrary commutative ring, `FractionRing R` being the
localization at the nonzerodivisors, i.e. the total ring of fractions `Q(R)`. The source says the
same ("Part (5) is a special case of part (4)"), so spelling (5) out separately would only
restate (4) with a dead hypothesis. Packing (1)–(3) into an equivalence rather than three
implications loses nothing: the forward direction is exactly (1) and (2), the converse exactly
(3), and it is the form a user of the tag wants.

The source's enumeration `q_1, …, q_t` of the minimal primes is replaced by the set
`minimalPrimes R`. That set is finite because `R` is Noetherian, so naming a length `t` adds
nothing to the statement, while a proof may still use the finiteness.

Analytic unramifiedness of a prime `q` is, as in Tag 032X, the composite
`IsAnalyticallyUnramified (R ⧸ q)`, which asks for `IsLocalRing (R ⧸ q)`. That is not an instance
in Mathlib, so it appears as an instance binder. It is always fillable — `q ≠ ⊤` gives
`Nontrivial (R ⧸ q)`, and `IsLocalRing.of_surjective'` applies to `Ideal.Quotient.mk q` — so
neither the quantifier in the forward direction nor the hypothesis in the converse is vacuous;
and since `IsLocalRing` is a `Prop`-valued class and `IsLocalRing.maximalIdeal` is the ideal of
nonunits of the ring, which instance is supplied does not affect the proposition.

Part (1) holds without `[IsNoetherianRing R]`, under `[IsHausdorff (IsLocalRing.maximalIdeal R) R]`
instead: all it consumes is injectivity of `R → R^`, which is `AdicCompletion.of_injective`.
Mathlib infers that instance from `[IsNoetherianRing R] [IsLocalRing R]` by Krull's intersection
theorem, so the version stated here is a specialization of the general one, and the shared
Noetherian hypothesis is not dead — parts (2), (3) and (4) all consume it.

On faithfulness, point by point. (1) No hypothesis is dead: `IsNoetherianRing R` is used for a
minimal prime being an associated prime in part (2), for the finiteness of `minimalPrimes R` and
the exactness of completion in part (3), and for `R^` being Noetherian and Nagata in part (4);
`IsLocalRing R` supplies the ideal completed along; and `IsReduced R` in part (3) is essential
rather than decorative, `k[X] ⧸ (X²)` being a Noetherian complete local ring whose unique minimal
prime `(X)` has the field `k` as quotient, hence is analytically unramified, while the ring itself
is not reduced and so not analytically unramified. (2) The scalars and base are the source's: the
module-finiteness in part (4) is over `R` itself, of the integral closure of `R` in `Q(R)` — not
over `R^`, and not of the integral closure of `R^`; and the completions in parts (2) and (3) are
each taken along the maximal ideal of the ring named, so the ring completed in
`IsAnalyticallyUnramified (R ⧸ q)` is `R ⧸ q` and not `R`. (3) The canonical maps are pinned, not
merely assumed to exist: analytic unramifiedness is reducedness of `AdicCompletion` along `R`'s
own maximal ideal, and part (4) pins `Q(R)` to `FractionRing R` and the closure to
`integralClosure R (FractionRing R)`; the identification `(R ⧸ q)^ = R^ ⧸ q R^` used in the proofs
is a lemma about those pinned objects rather than part of the statement. (4) The instantiation is
not degenerate: `ℚ`, and any field, is analytically unramified — `m = ⊥`, so `R ≅ R^`, which is
reduced (compiled) — and `⊥ ∈ minimalPrimes ℚ` with `ℚ ⧸ ⊥` local, so the quantifier over minimal
primes is not empty and part (4) has content there.

