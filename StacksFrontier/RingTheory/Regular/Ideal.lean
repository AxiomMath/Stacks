@[expose] public section

/-!
# Regular, Koszul-regular, H₁-regular and quasi-regular ideals

An ideal of a commutative ring is regular, Koszul-regular, `H₁`-regular, or quasi-regular when,
locally on every prime containing it, its extension is generated by a finite sequence having the
corresponding regularity property. Following the definition we record the implications between
these conditions, and we prove that if `I ⊆ J` are ideals of `A` with `J / I` an `H₁`-regular
ideal of `A ⧸ I`, then `I ∩ J² = I J`.

## Main definitions

* `Ideal.IsRegular`: ideals locally generated by regular sequences.
* `Ideal.IsKoszulRegular`: ideals locally generated by Koszul-regular sequences.
* `Ideal.IsH1Regular`: ideals locally generated by `H₁`-regular sequences.
* `Quasiregular.IsQuasiregularIdeal'`: ideals locally generated by quasi-regular sequences.

## Main results

* `Ideal.IsRegular.isKoszulRegular`: regular ideals are Koszul-regular.
* `Ideal.IsKoszulRegular.isH1Regular`: Koszul-regular ideals are `H₁`-regular.
* `Ideal.IsH1Regular.isQuasiregular`: `H₁`-regular ideals are quasi-regular.
* `Ideal.IsKoszulRegular.isQuasiregular`: Koszul-regular ideals are quasi-regular.
* `Ideal.inf_sq_eq_mul_of_quotient_isH1RegularIdeal`: if `I ⊆ J` and `J / I` is an `H₁`-regular
  ideal of `A ⧸ I`, then `I ⊓ J ^ 2 = I * J`.

## Implementation notes

The localization `R_g` is represented by `Localization.Away g`, and the localized ideal by its
image under the canonical algebra map. Regular sequences use the library's list-based predicate,
applied to the list associated to the finite family of generators. The quasi-regular ideal
predicate is registered directly as `Quasiregular.IsQuasiregularIdeal'`. The implication
chain following Definition 07CV is obtained from 062F, 0CEM, and 062I without changing the local
generators. The monomial basis identifies the tensor-product canonical map of 062I with the
finitely supported canonical map used in the quasi-regular ideal predicate.

The quotient ideal `J / I` is represented by the image of `J` under the canonical quotient map
`A → A ⧸ I`. The conormal intersection formula is reduced to the statement for an explicit
`H₁`-regular generating sequence, Tag 0666, after localizing at a maximal ideal and transporting
the local generators along the identification of `(A_g) ⧸ I A_g` with the localization of `A ⧸ I`
away from the image of `g`.

## References

* [Stacks Project, Tag 07CV](https://stacks.math.columbia.edu/tag/07CV)
* [Stacks Project, Tag 07CX](https://stacks.math.columbia.edu/tag/07CX)
-/

namespace Ideal

/-- An ideal is regular if, at every prime containing it, some principal localization away from
the prime is generated by a regular sequence. -/
@[stacks 07CV "(1)", ega "IV 16.9.7", ega "IV 19.3.1", sga "1 II 4.14"]
public def IsRegular {R : Type*} [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R, I ≤ p.asIdeal →
    ∃ g : R, g ∉ p.asIdeal ∧
      ∃ (r : ℕ) (f : Fin r → Localization.Away g),
        RingTheory.Sequence.IsRegular (Localization.Away g) (List.ofFn f) ∧
          Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

/-- An ideal is Koszul-regular if, at every prime containing it, some principal localization away
from the prime is generated by a Koszul-regular sequence. -/
@[stacks 07CV "(2)"]
public def IsKoszulRegular {R : Type*} [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R, I ≤ p.asIdeal →
    ∃ g : R, g ∉ p.asIdeal ∧
      ∃ (r : ℕ) (f : Fin r → Localization.Away g),
        Koszul.IsKoszulRegular f ∧
          Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

/-- An ideal is `H₁`-regular if, at every prime containing it, some principal localization away
from the prime is generated by an `H₁`-regular sequence. -/
@[stacks 07CV "(3)"]
public def IsH1Regular {R : Type*} [CommRing R] (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R, I ≤ p.asIdeal →
    ∃ g : R, g ∉ p.asIdeal ∧
      ∃ (r : ℕ) (f : Fin r → Localization.Away g),
        Koszul.IsH1Regular f ∧
          Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

add_to_stacks 07CV "(4)" Quasiregular.IsQuasiregularIdeal'

section Implications

universe u

variable {R : Type u} [CommRing R]

/-- A regular ideal is Koszul-regular, by applying 062F to its local generators. -/
public theorem IsRegular.isKoszulRegular {I : Ideal R}
    (hI : IsRegular I) : IsKoszulRegular I := by
  intro p hp
  obtain ⟨g, hg, r, f, hf, hspan⟩ := hI p hp
  exact ⟨g, hg, r, f,
    (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular
      (M := Localization.Away g)).2.2 hf, hspan⟩

/-- A Koszul-regular ideal is `H₁`-regular, by applying 0CEM to its local generators. -/
public theorem IsKoszulRegular.isH1Regular {I : Ideal R}
    (hI : IsKoszulRegular I) : IsH1Regular I := by
  intro p hp
  obtain ⟨g, hg, r, f, hf, hspan⟩ := hI p hp
  exact ⟨g, hg, r, f, hf.isH1Regular, hspan⟩

end Implications

section ConormalIntersection

private theorem localizationAway_quotient_equiv {A : Type*} [CommRing A]
    (I : Ideal A) (g : A) :
    Nonempty
      (((Localization.Away g) ⧸ Ideal.map (algebraMap A (Localization.Away g)) I) ≃ₐ[A ⧸ I]
        Localization.Away (Ideal.Quotient.mk I g)) := by
  have hm : Algebra.algebraMapSubmonoid (A ⧸ I) (Submonoid.powers g) =
      Submonoid.powers (Ideal.Quotient.mk I g) := by
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
    rfl
  have hloc : IsLocalization (Submonoid.powers (Ideal.Quotient.mk I g))
      ((Localization.Away g) ⧸ Ideal.map (algebraMap A (Localization.Away g)) I) := by
    rw [← hm]
    infer_instance
  let _ := hloc
  exact ⟨IsLocalization.algEquiv (Submonoid.powers (Ideal.Quotient.mk I g)) _ _⟩

private theorem span_range_algEquiv_symm_eq_map {A : Type*} [CommRing A] (I J : Ideal A) (g : A)
    (e : (Localization.Away g ⧸ Ideal.map (algebraMap A (Localization.Away g)) I) ≃ₐ[A ⧸ I]
      Localization.Away (Ideal.Quotient.mk I g))
    {m : ℕ} (f : Fin m → Localization.Away (Ideal.Quotient.mk I g))
    (hfspan : Ideal.map (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I g)))
      (Ideal.map (Ideal.Quotient.mk I) J) = Ideal.span (Set.range f)) :
    Ideal.span (Set.range fun i => e.symm (f i)) =
      Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away g)) I))
        (Ideal.map (algebraMap A (Localization.Away g)) J) := by
  let q : A →+* A ⧸ I := Ideal.Quotient.mk I
  let a : A →+* Localization.Away g := algebraMap A (Localization.Away g)
  let Ig := Ideal.map a I
  let Jg := Ideal.map a J
  let f' : Fin m → Localization.Away g ⧸ Ig := fun i => e.symm (f i)
  have hmap : Ideal.map e.toRingHom (Ideal.span (Set.range f')) =
      Ideal.map e.toRingHom (Ideal.map (Ideal.Quotient.mk Ig) Jg) := by
    rw [Ideal.map_span]
    have hrange : e.toRingEquiv.toRingHom '' Set.range f' = Set.range f := by
      ext x
      simp [f']
    rw [hrange, ← hfspan, Ideal.map_map, Ideal.map_map]
    simp only [Jg, a]
    rw [Ideal.map_map]
    have hmaps : (e.toRingHom.comp (Ideal.Quotient.mk Ig)).comp a =
        (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I g))).comp q := by
      ext x
      exact e.commutes (q x)
    show Ideal.map ((algebraMap (A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I g))).comp q) J =
      Ideal.map ((e.toRingHom.comp (Ideal.Quotient.mk Ig)).comp a) J
    exact congrArg (Ideal.map · J) hmaps.symm
  have hc := congrArg (Ideal.comap e.toRingHom) hmap
  rwa [Ideal.comap_map_of_bijective e.toRingHom e.bijective,
    Ideal.comap_map_of_bijective e.toRingHom e.bijective] at hc

private theorem map_inf_sq_eq_map_mul_atPrime_of_le {A : Type*} [CommRing A] {I J : Ideal A}
    (hIJ : I ≤ J) (hreg : IsH1Regular (Ideal.map (Ideal.Quotient.mk I) J)) (P : Ideal A)
    [P.IsPrime] (hIP : I ≤ P) (hJP : J ≤ P) :
    Ideal.map (algebraMap A (Localization.AtPrime P)) (I ⊓ J ^ 2) =
      Ideal.map (algebraMap A (Localization.AtPrime P)) (I * J) := by
  let AP := Localization.AtPrime P
  let aP : A →+* AP := algebraMap A AP
  show Ideal.map aP (I ⊓ J ^ 2) = Ideal.map aP (I * J)
  let q : A →+* A ⧸ I := Ideal.Quotient.mk I
  let Pbar : Ideal (A ⧸ I) := Ideal.map q P
  have hPbar : Pbar.IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by simpa [q] using hIP)
  obtain ⟨gbar, hgbar, m, f, hfreg, hfspan⟩ := hreg ⟨Pbar, hPbar⟩ (Ideal.map_mono hJP)
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective gbar
  have hgP : g ∉ P := fun hg => hgbar (Ideal.mem_map_of_mem q hg)
  let Ag := Localization.Away g
  let a : A →+* Ag := algebraMap A Ag
  let Ig := Ideal.map a I
  let Jg := Ideal.map a J
  obtain ⟨e⟩ := localizationAway_quotient_equiv I g
  let f' : Fin m → Ag ⧸ Ig := fun i => e.symm (f i)
  have hfreg' : Koszul.IsH1Regular f' :=
    isH1Regular_map_ringEquiv e.symm.toRingEquiv f hfreg
  have hfspan' : Ideal.span (Set.range f') = Ideal.map (Ideal.Quotient.mk Ig) Jg :=
    span_range_algEquiv_symm_eq_map I J g e f hfspan
  have hlocal : Ig ⊓ Jg ^ 2 = Ig * Jg :=
    Koszul.inf_sq_eq_mul_of_quotient_generated_by_isH1Regular
      Ig Jg (Ideal.map_mono hIJ) f' hfspan' hfreg'
  have hgunit : IsUnit (aP g) :=
    IsLocalization.map_units (M := P.primeCompl) AP ⟨g, hgP⟩
  let φ : Ag →+* AP := IsLocalization.Away.lift g hgunit
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap]
    have hxa : a x ∈ Ig ⊓ Jg ^ 2 := by
      refine ⟨Ideal.mem_map_of_mem a hx.1, ?_⟩
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem a hx.2
    rw [hlocal] at hxa
    have hxφ := Ideal.mem_map_of_mem φ hxa
    change φ (a x) ∈ Ideal.map φ (Ideal.map a I * Ideal.map a J) at hxφ
    rw [← Ideal.map_mul, Ideal.map_map] at hxφ
    simpa [φ, a, aP, IsLocalization.Away.lift_eq] using hxφ
  · exact Ideal.map_mono (le_inf Ideal.mul_le_left (by
      rw [pow_two]
      exact Ideal.mul_mono hIJ le_rfl))

/-- If `I ⊆ J` and `J / I` is an H₁-regular ideal of `A / I`, then `I ∩ J² = I J`. -/
@[stacks 07CX]
public theorem inf_sq_eq_mul_of_quotient_isH1RegularIdeal
    {A : Type*} [CommRing A] (I J : Ideal A) (hIJ : I ≤ J)
    (hreg : IsH1Regular (Ideal.map (Ideal.Quotient.mk I) J)) :
    I ⊓ J ^ 2 = I * J := by
  apply Ideal.eq_of_localization_maximal
  intro P hP
  by_cases hJP : J ≤ P
  · exact map_inf_sq_eq_map_mul_atPrime_of_le hIJ hreg P (hIJ.trans hJP) hJP
  · rw [IsLocalization.map_inf P.primeCompl (Localization.AtPrime P), Ideal.map_pow,
      Ideal.map_mul, IsLocalization.AtPrime.map_eq_top_of_not_le (Localization.AtPrime P) hJP,
      show (⊤ : Ideal (Localization.AtPrime P)) ^ 2 = ⊤ by simp]
    simp

end ConormalIntersection

/-! ## Quasi-regularity -/

section Quasiregularity

universe u v

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
variable {r : ℕ} {f : Fin r → R}

set_option backward.isDefEq.respectTransparency false in
/-- Reindexing the list of a finite family does not change its canonical map. -/
private theorem bijective_canonicalMap_of_isQuasiRegular
    (h : RingTheory.Sequence.IsQuasiRegular M (List.ofFn f)) :
    Function.Bijective (quasiRegularCanonicalMap (M := M) f) := by
  let P := fun s : Σ n, Fin n → R =>
    Function.Bijective (quasiRegularCanonicalMap (M := M) s.2)
  change P (List.equivSigmaTuple (List.equivSigmaTuple.symm ⟨r, f⟩)) at h
  show P ⟨r, f⟩
  simpa only [Equiv.apply_symm_apply] using h

set_option backward.isDefEq.respectTransparency false in
/-- The monomial basis identifies the two canonical maps defining quasi-regularity. -/
private theorem isMQuasiregularSeq_of_bijective_canonicalMap
    (h : Function.Bijective (quasiRegularCanonicalMap (M := M) f)) :
    Quasiregular.IsMQuasiregularSeq M f := by
  classical
  let e := TensorProduct.equivFinsuppOfBasisLeft (N := qrMbar M f)
    (MvPolynomial.basisMonomials (Fin r) (qrRbar f))
  have hmap :
      (Finsupp.lsum R fun d => phiMonoR (M := M) f d) =
        (quasiRegularCanonicalMap (M := M) f).restrictScalars R ∘ₗ
          e.symm.toLinearMap.restrictScalars R := by
    apply Finsupp.lhom_ext
    intro d m
    simp only [LinearMap.comp_apply, LinearMap.restrictScalars_apply,
      LinearEquiv.coe_coe, Finsupp.lsum_single]
    show phiMonoR f d m = quasiRegularCanonicalMap f (e.symm (Finsupp.single d m))
    simp only [e, TensorProduct.equivFinsuppOfBasisLeft_symm_apply, Finsupp.sum_single_index,
      TensorProduct.tmul_zero]
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective (Jid f • (⊤ : Submodule R M)) m
    exact (canonicalMap_srcMono f d m).symm
  let q : (M ⧸ Quasiregular.jpow (Ideal.span (Set.range f)) M 1) ≃ₗ[R] qrMbar M f :=
    Submodule.quotEquivOfEq _ _ (by simp [Quasiregular.jpow, Jid])
  let qf : ((Fin r →₀ ℕ) →₀ (M ⧸ Quasiregular.jpow (Ideal.span (Set.range f)) M 1)) ≃ₗ[R]
      ((Fin r →₀ ℕ) →₀ qrMbar M f) := Finsupp.mapRange.linearEquiv q
  have hphi : Quasiregular.qregPhi (M := M) f =
      (Finsupp.lsum R fun d => phiMonoR (M := M) f d) ∘ₗ qf.toLinearMap := by
    apply Finsupp.lhom_ext
    intro d m
    obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective _ m
    show Quasiregular.qregPhi f (Finsupp.single d (Submodule.Quotient.mk m)) =
      (Finsupp.lsum R fun d => phiMonoR f d)
        (qf (Finsupp.single d (Submodule.Quotient.mk m)))
    rw [show qf (Finsupp.single d (Submodule.Quotient.mk m)) =
        Finsupp.single d (Submodule.Quotient.mk m)
      by simp [qf, Finsupp.mapRange.linearEquiv_apply, q]]
    simp only [Quasiregular.qregPhi, Finsupp.lsum_single, LinearMap.comp_apply]
    show DirectSum.lof R ℕ (fun n => Tcomp M f n) (d.sum fun _ k => k)
      (Submodule.Quotient.mk ⟨(∏ i, f i ^ d i) • m, _⟩) = imgTargetLin f d m
    have hd : d.sum (fun _ k => k) = qrMdeg d := by
      simp [Finsupp.sum_fintype, qrMdeg]
    have hl : ∀ (n : ℕ) (hm : (∏ i, f i ^ d i) • m ∈ JpowM M f n),
        n = qrMdeg d →
        DirectSum.lof R ℕ (fun n => Tcomp M f n) n
          (Submodule.Quotient.mk ⟨(∏ i, f i ^ d i) • m, hm⟩) =
        imgTargetLin f d m := by
      rintro n hm rfl
      rfl
    exact hl _ _ hd
  show Function.Bijective (Quasiregular.qregPhi (M := M) f)
  rw [hphi, hmap]
  exact (h.comp e.symm.bijective).comp qf.bijective

/-- An `H₁`-regular ideal is quasi-regular, by applying 062I to its local generators. -/
public theorem IsH1Regular.isQuasiregular {I : Ideal R}
    (hI : IsH1Regular I) : Quasiregular.IsQuasiregularIdeal' I := by
  intro p hp
  obtain ⟨g, hg, r, f, hf, hspan⟩ := hI p hp
  exact ⟨g, hg, r, f, isMQuasiregularSeq_of_bijective_canonicalMap
    (bijective_canonicalMap_of_isQuasiRegular
      (Koszul.isQuasiRegular_of_isH1RegularOn ((Koszul.isH1RegularOn_self_iff f).mpr hf))), hspan⟩

/-- A Koszul-regular ideal is quasi-regular. -/
@[sga "6 VII 1.3" "more general"]
public theorem IsKoszulRegular.isQuasiregular {I : Ideal R}
    (hI : IsKoszulRegular I) : Quasiregular.IsQuasiregularIdeal' I :=
  hI.isH1Regular.isQuasiregular

end Quasiregularity

end Ideal

