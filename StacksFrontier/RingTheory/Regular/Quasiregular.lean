module

public import StacksCore.LinearAlgebra.Matrix.CommSemiring
public import StacksFrontier.RingTheory.LocalProperties.StandardCover
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Quasi-regular ideals

Let `R` be a commutative ring, `M` an `R`-module and `f_1, ..., f_c ∈ R` with
`J = (f_1, ..., f_c)`. There is a canonical graded map
`Φ : (M/JM)[X_1, ..., X_c] → ⨁_n J^n M / J^{n+1} M` sending `m X^e` to `f^e m`, and the
sequence is `M`-quasi-regular if `Φ` is bijective. An ideal `I` of `R` is quasi-regular if,
locally on `V(I)`, it is generated by a quasi-regular sequence. We show that a quasi-regular
ideal is finitely generated, and that its conormal module `I/I²` is a finite projective
`R/I`-module.

## Main definitions

* `Quasiregular.qregPhi`: the canonical graded map `Φ`.
* `Quasiregular.IsMQuasiregularSeq`: `M`-quasi-regular sequences.
* `Quasiregular.IsQuasiregularSeq`: quasi-regular sequences.
* `Quasiregular.IsQuasiregularIdeal`: quasi-regular ideals.

## Main results

* `Quasiregular.cotangent_finite_projective_of_quasiregular`: if `I` is quasi-regular, then
  `I/I²` is a finite projective `R/I`-module.
* `Quasiregular.isQuasiregularIdeal_fg`: a quasi-regular ideal is finitely generated.

## Implementation notes

The source of `Φ` is modelled as the free `M/JM`-module on all monomials,
`(Fin c →₀ ℕ) →₀ M/JM`, and `J^n M / J^{n+1} M` as the quotient of the submodule `J^n • ⊤`.

## References

* [Stacks: Tags 061P, 07CV, 07CW, 08RK](https://stacks.math.columbia.edu)
-/

@[expose] public section

/-- If `f : M →ₗ[A] N` is a localization at `Algebra.algebraMapSubmonoid A S`, the image in `A`
of a submonoid `S` of `R`, then its restriction of scalars to `R` is a localization at `S`. -/
@[ega "0 1.5.2"]
theorem isLocalizedModule_restrictScalars_of_algebraMapSubmonoid
    {R A M N : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
    [AddCommMonoid M] [Module R M] [Module A M] [IsScalarTower R A M]
    [AddCommMonoid N] [Module R N] [Module A N] [IsScalarTower R A N]
    (S : Submonoid R) (f : M →ₗ[A] N)
    [IsLocalizedModule (Algebra.algebraMapSubmonoid A S) f] :
    IsLocalizedModule S (f.restrictScalars R) := by
  have hmem : ∀ s : S, (algebraMap R A s) ∈ Algebra.algebraMapSubmonoid A S :=
    fun s ↦ ⟨s, s.2, rfl⟩
  have hsmulN : ∀ (s : R) (x : N), s • x = (algebraMap R A s) • x :=
    fun s x ↦ (IsScalarTower.algebraMap_smul A s x).symm
  have hsmulM : ∀ (s : R) (x : M), s • x = (algebraMap R A s) • x :=
    fun s x ↦ (IsScalarTower.algebraMap_smul A s x).symm
  refine IsLocalizedModule.mk ?_ ?_ ?_
  · intro s
    have hu := IsLocalizedModule.map_units f ⟨algebraMap R A s, hmem s⟩
    rw [Module.End.isUnit_iff] at hu ⊢
    refine ⟨fun x y hxy ↦ hu.1 ?_, fun y ↦ ?_⟩
    · simp only [Module.algebraMap_end_apply] at hxy ⊢
      rwa [← hsmulN (s : R), ← hsmulN (s : R)]
    · obtain ⟨x, hx⟩ := hu.2 y
      refine ⟨x, ?_⟩
      simp only [Module.algebraMap_end_apply] at hx ⊢
      rwa [hsmulN (s : R)]
  · intro y
    obtain ⟨⟨m, t⟩, ht⟩ := IsLocalizedModule.surj (Algebra.algebraMapSubmonoid A S) f y
    obtain ⟨s, hs, hst⟩ := t.2
    refine ⟨⟨m, ⟨s, hs⟩⟩, ?_⟩
    simp only [LinearMap.restrictScalars_apply]
    change (s : R) • y = f m
    rwa [hsmulN s, hst]
  · intro m₁ m₂ h
    simp only [LinearMap.restrictScalars_apply] at h
    obtain ⟨c, hc⟩ := (IsLocalizedModule.eq_iff_exists (Algebra.algebraMapSubmonoid A S) f).1 h
    obtain ⟨s, hs, hst⟩ := c.2
    refine ⟨⟨s, hs⟩, ?_⟩
    change (s : R) • m₁ = (s : R) • m₂
    rwa [hsmulM s, hsmulM s, hst]

namespace Quasiregular

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
variable {c : ℕ}

/-- `J^n M` as a submodule of `M`, i.e. `J ^ n • ⊤`. Here `J^0 M = M`. -/
def jpow (J : Ideal R) (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ) : Submodule R M :=
  J ^ n • (⊤ : Submodule R M)

/-- `J^0 M` is all of `M`. -/
@[simp]
theorem jpow_zero (J : Ideal R) : jpow J M 0 = ⊤ := by
  rw [jpow, pow_zero, Ideal.one_eq_top, Submodule.top_smul]

/-- Taken in `M = R`, the submodule `J^1 R` is the ideal `J` itself. -/
theorem jpow_one_eq_self (J : Ideal R) : jpow J R 1 = J := by
  rw [jpow, pow_one]; simp

/-- The submodules `J^n M` decrease as `n` grows. -/
theorem jpow_le_jpow_of_le (J : Ideal R) {m n : ℕ} (h : m ≤ n) : jpow J M n ≤ jpow J M m := by
  rw [jpow, jpow]
  exact Submodule.smul_mono_left (Ideal.pow_le_pow_right h)

/-- The `n`-th graded piece `J^n M / J^{n+1} M`. -/
abbrev GPiece (J : Ideal R) (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ) : Type _ :=
  (jpow J M n) ⧸ (Submodule.comap (jpow J M n).subtype (jpow J M (n + 1)))

/-- For a monomial `e` of total degree `|e|`, the coefficient `∏ f_i^{e_i}` lies in
`J^{|e|}`, where `J = (f_1, ..., f_c)`. -/
theorem coeff_mem (f : Fin c → R) (e : Fin c →₀ ℕ) :
    (∏ i, f i ^ e i) ∈ (Ideal.span (Set.range f)) ^ (e.sum fun _ k => k) := by
  have hf : ∀ i, f i ∈ Ideal.span (Set.range f) := fun i ↦ Ideal.subset_span ⟨i, rfl⟩
  rw [Finsupp.sum_fintype _ _ (by simp),
    (Finset.prod_pow_eq_pow_sum Finset.univ (fun i ↦ e i) (Ideal.span (Set.range f))).symm]
  exact Ideal.prod_mem_prod (fun i _ ↦ Ideal.pow_mem_pow (hf i) (e i))

/-- The `R`-linear map `M → J^{|e|} M`, `m ↦ (∏ f_i^{e_i}) • m`. -/
noncomputable def monoSmul (f : Fin c → R) (e : Fin c →₀ ℕ) :
    M →ₗ[R] jpow (Ideal.span (Set.range f)) M (e.sum fun _ k => k) where
  toFun m := ⟨(∏ i, f i ^ e i) • m, Submodule.smul_mem_smul (coeff_mem f e) trivial⟩
  map_add' a b := by ext; simp [smul_add]
  map_smul' r a := by ext; exact smul_comm _ _ _

/-- The `R`-linear map `M → J^{|e|} M / J^{|e|+1} M`, `m ↦ (∏ f_i^{e_i}) m`. -/
noncomputable def monoSmulMk (f : Fin c → R) (e : Fin c →₀ ℕ) :
    M →ₗ[R] GPiece (Ideal.span (Set.range f)) M (e.sum fun _ k => k) :=
  (Submodule.mkQ _).comp (monoSmul f e)

/-- The submodule `JM` is contained in the kernel of `monoSmulMk f e`. -/
theorem jpow_one_le_ker_monoSmulMk (f : Fin c → R) (e : Fin c →₀ ℕ) :
    jpow (Ideal.span (Set.range f)) M 1 ≤ LinearMap.ker (monoSmulMk f e) := by
  intro m hm
  rw [LinearMap.mem_ker, monoSmulMk, LinearMap.comp_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
  change (∏ i, f i ^ e i) • m ∈ jpow (Ideal.span (Set.range f)) M ((e.sum fun _ k ↦ k) + 1)
  have h1 : (∏ i, f i ^ e i) • m ∈
      ((Ideal.span (Set.range f)) ^ (e.sum fun _ k ↦ k)) •
        ((Ideal.span (Set.range f)) ^ 1 • (⊤ : Submodule R M)) :=
    Submodule.smul_mem_smul (coeff_mem f e) hm
  rwa [← Submodule.smul_assoc, smul_eq_mul, ← pow_add] at h1

/-- The `R`-linear map `M/JM -> J^{|e|} M / J^{|e|+1} M` induced by a monomial `e`. -/
@[ega "0 15.1.1" "partial"]
noncomputable def monoMap (f : Fin c → R) (e : Fin c →₀ ℕ) :
    (M ⧸ jpow (Ideal.span (Set.range f)) M 1) →ₗ[R]
      GPiece (Ideal.span (Set.range f)) M (e.sum fun _ k => k) :=
  Submodule.liftQ _ (monoSmulMk f e) (jpow_one_le_ker_monoSmulMk f e)

/-- The canonical graded map
`Φ : (M/JM)[X_1, ..., X_c] → ⨁_n J^n M / J^{n+1} M`,
realized as a map from the free `M/JM`-module on all monomials into the direct sum of the
graded pieces, with the monomial `e` of total degree `|e|` mapping into degree `|e|`. -/
@[ega "0 15.1.1",
  ega "0 15.1.5" "special case",
  ega "0 15.2.1" "module case of φ_k",
  ega "IV 19.5.4" "more general",
  ega "IV 19.6.2" "special case",
  ega "IV 19.7.1" "ψ_M of (0, special case"]
noncomputable def qregPhi (f : Fin c → R) :
    ((Fin c →₀ ℕ) →₀ (M ⧸ jpow (Ideal.span (Set.range f)) M 1)) →ₗ[R]
      DirectSum ℕ (fun n => GPiece (Ideal.span (Set.range f)) M n) :=
  Finsupp.lsum R (fun e ↦
    (DirectSum.lof R ℕ (fun n ↦ GPiece (Ideal.span (Set.range f)) M n)
      (e.sum fun _ k ↦ k)).comp (monoMap f e))

/-- `qregPhi f` sends the monomial `e` with coefficient `m` into degree `|e|`. -/
@[simp]
theorem qregPhi_single (f : Fin c → R) (e : Fin c →₀ ℕ)
    (m : M ⧸ jpow (Ideal.span (Set.range f)) M 1) :
    qregPhi f (Finsupp.single e m)
      = DirectSum.lof R ℕ (fun n => GPiece (Ideal.span (Set.range f)) M n)
          (e.sum fun _ k => k) (monoMap f e m) := by
  rw [qregPhi, Finsupp.lsum_single, LinearMap.comp_apply]

/-- The sequence `f_1, ..., f_c` is `M`-quasi-regular if the canonical map `\Phi` is
bijective. -/
@[ega "0 15.1.4" "more general",
  ega "0 15.1.7",
  ega "0 15.2.2" "special case",
  ega "IV 19.5.1",
  ega "IV 19.5.5.2" "more general"]
def IsMQuasiregularSeq (M : Type*) [AddCommGroup M] [Module R M] (f : Fin c → R) : Prop :=
  Function.Bijective (qregPhi (M := M) f)

/-- A quasi-regular sequence (the case `M = R`). -/
@[ega "0 15.1.4" "special case", ega "0 15.1.7", ega "0 15.2.2" "special case", sga "1 II 4.14"]
def IsQuasiregularSeq (f : Fin c → R) : Prop :=
  IsMQuasiregularSeq R f

/-- An ideal `I \subseteq R` is quasi-regular if for every prime `p` with `I \le p` there exist
`g \notin p`, a length `r`, and a quasi-regular sequence `f : Fin r -> R_g` with
`I R_g = (f_1, ..., f_r)`. -/
@[ega "IV 16.9.1" "special case", ega "IV 16.9.7", sga "6 VII 1.3"]
def IsQuasiregularIdeal (I : Ideal R) : Prop :=
  ∀ p : PrimeSpectrum R, I ≤ p.asIdeal →
    ∃ (g : R), g ∉ p.asIdeal ∧
      ∃ (r : ℕ) (f : Fin r → Localization.Away g),
        IsQuasiregularSeq f ∧
        Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

/-- A synonym for `IsQuasiregularIdeal`. -/
abbrev IsQuasiregularIdeal' (I : Ideal R) : Prop := IsQuasiregularIdeal I

/-- For a quasi-regular ideal `I`, the images in `R/I` of the elements `g` chosen by
quasi-regularity, one for each prime `p ⊇ I`, generate the unit ideal of `R/I`. -/
theorem span_range_choose_eq_top (I : Ideal R)
    (hI : IsQuasiregularIdeal I) :
    Ideal.span
        (Set.range fun p : {p : PrimeSpectrum R // I ≤ p.asIdeal} =>
          algebraMap R (R ⧸ I) (hI p.1 p.2).choose) = ⊤ := by
  by_contra h
  obtain ⟨m, hm_max, hm_le⟩ := Ideal.exists_le_maximal _ h
  have : m.IsPrime := hm_max.isPrime
  set p₀ : Ideal R := Ideal.comap (Ideal.Quotient.mk I) m with hp₀
  have : p₀.IsPrime := Ideal.comap_isPrime _ m
  have hIp₀ : I ≤ p₀ := by
    intro x hx
    rw [hp₀, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact m.zero_mem
  set p : {p : PrimeSpectrum R // I ≤ p.asIdeal} := ⟨⟨p₀, inferInstance⟩, hIp₀⟩
  have hg : (hI p.1 p.2).choose ∉ p.1.asIdeal := (hI p.1 p.2).choose_spec.1
  exact hg (hm_le (Ideal.subset_span (Set.mem_range_self p)))

/-- For `J = (f_1, ..., f_r)` in `R_g`, the graded piece `J R_g / J^2 R_g` is `R_g`-linearly
isomorphic to the cotangent module `J/J²`. -/
theorem nonempty_gPiece_one_linearEquiv_cotangent (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) :
    Nonempty (GPiece (Ideal.span (Set.range f)) (Localization.Away g) 1
      ≃ₗ[Localization.Away g] (Ideal.Cotangent (Ideal.span (Set.range f)))) := by
  have hEq : jpow (Ideal.span (Set.range f)) (Localization.Away g) 1
      = Ideal.span (Set.range f) := jpow_one_eq_self _
  let e := LinearEquiv.ofEq (jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)
    (Ideal.span (Set.range f)) hEq
  let P := Submodule.comap (jpow (Ideal.span (Set.range f)) (Localization.Away g) 1).subtype
    (jpow (Ideal.span (Set.range f)) (Localization.Away g) (1 + 1))
  let Q := (Ideal.span (Set.range f)) • (⊤ : Submodule (Localization.Away g)
    ↥(Ideal.span (Set.range f)))
  have h : Submodule.map
      (e : ↥(jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)
        →ₗ[Localization.Away g] ↥(Ideal.span (Set.range f))) P = Q := by
    apply Submodule.map_injective_of_injective
      (Submodule.injective_subtype (Ideal.span (Set.range f)))
    rw [← Submodule.map_comp]
    have hcomp : ((Ideal.span (Set.range f)).subtype.comp
        (e : ↥(jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)
          →ₗ[Localization.Away g] ↥(Ideal.span (Set.range f))))
        = (jpow (Ideal.span (Set.range f)) (Localization.Away g) 1).subtype := by
      ext x; rfl
    rw [hcomp, Submodule.map_comap_subtype]
    have hle : jpow (Ideal.span (Set.range f)) (Localization.Away g) (1 + 1)
        ≤ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1 :=
      jpow_le_jpow_of_le _ (by norm_num)
    rw [inf_of_le_right hle, Submodule.map_smul'', Submodule.map_subtype_top, jpow]
    have hpow : (Ideal.span (Set.range f)) ^ (1 + 1)
        = (Ideal.span (Set.range f)) * (Ideal.span (Set.range f)) := by ring
    rw [hpow]
    simp
  exact ⟨Submodule.Quotient.equiv P Q e h⟩

/-- The quotients `R_g ⧸ J R_g` and `R_g ⧸ J` are `R_g`-linearly isomorphic, where
`J = (f_1, ..., f_r)`. -/
theorem nonempty_quot_jpow_one_linearEquiv (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) :
    Nonempty ((Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)
      ≃ₗ[Localization.Away g] (Localization.Away g ⧸ Ideal.span (Set.range f))) := by
  refine ⟨Submodule.Quotient.equiv _ _ (LinearEquiv.refl _ _) ?_⟩
  rw [show ((LinearEquiv.refl (Localization.Away g) (Localization.Away g)) :
      Localization.Away g →ₗ[Localization.Away g] Localization.Away g) = LinearMap.id from rfl,
    Submodule.map_id]
  exact jpow_one_eq_self _

/-- The `R_g`-linear map `(Fin r → R_g ⧸ J R_g) → ((Fin r →₀ ℕ) →₀ R_g ⧸ J R_g)` sending the
`i`-th coordinate to the degree-one monomial `Finsupp.single i 1`. -/
noncomputable def degOneIota (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) :
    (Fin r → (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1))
      →ₗ[Localization.Away g]
      ((Fin r →₀ ℕ) →₀
        (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)) :=
  (Finsupp.lsum (Localization.Away g)
      (fun i ↦ Finsupp.lsingle (Finsupp.single i 1))).comp
    (Finsupp.linearEquivFunOnFinite (Localization.Away g) _ _).symm.toLinearMap

/-- The degree-one component of `qregPhi f ∘ degOneIota g f`, an `R_g`-linear map
`(Fin r → R_g ⧸ J R_g) → J R_g / J^2 R_g`. -/
noncomputable def degOnePsi (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) :
    (Fin r → (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1))
      →ₗ[Localization.Away g]
      GPiece (Ideal.span (Set.range f)) (Localization.Away g) 1 :=
  (DirectSum.component (Localization.Away g) ℕ
      (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1).comp
    ((qregPhi (M := Localization.Away g) f).comp (degOneIota g f))

/-- `degOneIota g f c` is the finitely supported function `∑ i, single (single i 1) (c i)`. -/
theorem degOneIota_apply (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g)
    (c : Fin r → (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)) :
    degOneIota g f c
      = ∑ i, Finsupp.single (Finsupp.single i 1) (c i) := by
  unfold degOneIota
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Finsupp.lsum_apply]
  rw [Finsupp.sum_fintype _ _ (by intro i; simp)]
  apply Finset.sum_congr rfl
  intro i _
  simp [Finsupp.linearEquivFunOnFinite]

/-- The coefficient of `degOneIota g f c` at the monomial `X_i` is `c i`. -/
private theorem degOneIota_apply_single (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g)
    (c : Fin r → (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1))
    (i : Fin r) : (degOneIota g f c) (Finsupp.single i 1) = c i := by
  simp [degOneIota_apply, Finset.sum_apply', Finsupp.single_apply,
    Finsupp.single_left_inj one_ne_zero]

/-- The image `qregPhi f (degOneIota g f c)` lies in degree one and equals
`lof 1 (degOnePsi g f c)`. -/
theorem qregPhi_degOneIota (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g)
    (c : Fin r → (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1)) :
    (qregPhi (M := Localization.Away g) f) (degOneIota g f c)
      = DirectSum.lof (Localization.Away g) ℕ
          (fun n => GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1
          (degOnePsi g f c) := by
  unfold degOnePsi
  simp only [LinearMap.comp_apply]
  set L := DirectSum.lof (Localization.Away g) ℕ
    (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1 with hL
  set P := DirectSum.component (Localization.Away g) ℕ
    (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1 with hP
  have collapse : ∀ (d : ℕ) (_ : d = 1)
      (y : GPiece (Ideal.span (Set.range f)) (Localization.Away g) d),
      DirectSum.lof (Localization.Away g) ℕ
          (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) d y
        = L (P (DirectSum.lof (Localization.Away g) ℕ
          (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) d y)) := by
    intro d hd y
    subst hd
    rw [hL, hP, DirectSum.component.lof_self]
  have key : ∀ i : Fin r,
      (qregPhi (M := Localization.Away g) f)
          (Finsupp.single (Finsupp.single i 1) (c i))
        = L (P ((qregPhi (M := Localization.Away g) f)
          (Finsupp.single (Finsupp.single i 1) (c i)))) := by
    intro i
    rw [qregPhi_single]
    exact collapse _ (by simp) _
  rw [degOneIota_apply, map_sum, map_sum, map_sum]
  exact Finset.sum_congr rfl (fun i _ ↦ key i)

/-- The map `degOneIota g f` is injective. -/
theorem degOneIota_injective (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) :
    Function.Injective (degOneIota g f) := by
  intro c1 c2 h
  funext j
  rw [← degOneIota_apply_single g f c1 j, h, degOneIota_apply_single]

/-- If `f` is a quasi-regular sequence, then `degOnePsi g f` is injective. -/
theorem degOnePsi_injective (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f) :
    Function.Injective (degOnePsi g f) := by
  intro c1 c2 h
  have hΦ : (qregPhi (M := Localization.Away g) f) (degOneIota g f c1)
      = (qregPhi (M := Localization.Away g) f) (degOneIota g f c2) := by
    rw [qregPhi_degOneIota, qregPhi_degOneIota, h]
  have hι : degOneIota g f c1 = degOneIota g f c2 := hqr.injective hΦ
  exact degOneIota_injective g f hι

/-- The degree-one component of `qregPhi f a` equals `degOnePsi g f c`, where
`c i = a (single i 1)`. -/
theorem component_qregPhi_eq_degOnePsi (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g)
    (a : (Fin r →₀ ℕ) →₀ (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away
        g) 1)) :
    degOnePsi g f (fun i => a (Finsupp.single i 1))
      = (DirectSum.component (Localization.Away g) ℕ
          (fun n => GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1)
          ((qregPhi (M := Localization.Away g) f) a) := by
  classical
  set π₁ := DirectSum.component (Localization.Away g) ℕ
    (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1 with hπ
  set T : (Fin r →₀ ℕ) → (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away
      g) 1)
      → GPiece (Ideal.span (Set.range f)) (Localization.Away g) 1 :=
    fun e m ↦ π₁ (DirectSum.lof (Localization.Away g) ℕ
      (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n)
      (e.sum fun _ k ↦ k) (monoMap f e m)) with hT
  have comp_formula : ∀ b : (Fin r →₀ ℕ) →₀
        (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1),
      π₁ ((qregPhi (M := Localization.Away g) f) b) = b.sum (fun e m ↦ T e m) := by
    intro b
    rw [qregPhi, Finsupp.lsum_apply, map_finsuppSum]
    rfl
  have hT_zero : ∀ (e : Fin r →₀ ℕ)
      (m : Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1),
      (e.sum fun _ k ↦ k) ≠ 1 → T e m = 0 := by
    intro e m he
    simp only [hT, hπ]
    rw [DirectSum.component.of]
    exact dite_eq_right he
  have hT_zero' : ∀ e : Fin r →₀ ℕ, T e 0 = 0 := by
    intro e
    rw [hT]
    simp
  have sum_T_eq : ∀ b : (Fin r →₀ ℕ) →₀
        (Localization.Away g ⧸ jpow (Ideal.span (Set.range f)) (Localization.Away g) 1),
      b.sum (fun e m ↦ T e m)
        = ∑ i : Fin r, T (Finsupp.single i 1) (b (Finsupp.single i 1)) := by
    intro b
    set D : Finset (Fin r →₀ ℕ) :=
      (Finset.univ : Finset (Fin r)).image (fun i ↦ Finsupp.single i 1) with hD
    have hinj : Set.InjOn (fun i ↦ (Finsupp.single i 1 : Fin r →₀ ℕ))
        (Finset.univ : Finset (Fin r)) := by
      intro i _ j _ h
      exact Finsupp.single_left_injective (by norm_num) h
    have hRHS : ∑ i : Fin r, T (Finsupp.single i 1) (b (Finsupp.single i 1))
        = ∑ e ∈ D, T e (b e) := by
      rw [hD, Finset.sum_image hinj]
    rw [hRHS, Finsupp.sum]
    have hmemD : ∀ e : Fin r →₀ ℕ, e ∈ D ↔ ∃ i : Fin r, e = Finsupp.single i 1 := by
      intro e
      rw [hD, Finset.mem_image]
      exact ⟨fun ⟨i, _, h⟩ ↦ ⟨i, h.symm⟩, fun ⟨i, h⟩ ↦ ⟨i, Finset.mem_univ i, h.symm⟩⟩
    have h1 : ∑ e ∈ b.support, T e (b e)
        = ∑ e ∈ (b.support ∪ D), T e (b e) := by
      apply Finset.sum_subset (Finset.subset_union_left)
      intro e _ he
      rw [Finsupp.notMem_support_iff.mp he, hT_zero']
    have h2 : ∑ e ∈ D, T e (b e)
        = ∑ e ∈ (b.support ∪ D), T e (b e) := by
      refine Finset.sum_subset Finset.subset_union_right fun e _ he ↦ hT_zero _ _ fun hdeg ↦ ?_
      obtain ⟨i, hi⟩ := (Finsupp.sum_eq_one_iff e).mp hdeg
      exact he ((hmemD e).mpr ⟨i, hi⟩)
    rw [h1, h2]
  unfold degOnePsi
  simp only [LinearMap.comp_apply]
  rw [comp_formula, comp_formula, sum_T_eq, sum_T_eq]
  apply Finset.sum_congr rfl
  intro i _
  rw [degOneIota_apply_single]

/-- If `f` is a quasi-regular sequence, then `degOnePsi g f` is surjective. -/
theorem degOnePsi_surjective (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f) :
    Function.Surjective (degOnePsi g f) := by
  intro y
  obtain ⟨a, ha⟩ := hqr.surjective
    (DirectSum.lof (Localization.Away g) ℕ
      (fun n ↦ GPiece (Ideal.span (Set.range f)) (Localization.Away g) n) 1 y)
  refine ⟨fun i ↦ a (Finsupp.single i 1), ?_⟩
  rw [component_qregPhi_eq_degOnePsi, ha, DirectSum.component.lof_self]

/-- If `f` is a quasi-regular sequence, then `degOnePsi g f` is bijective. -/
theorem degOnePsi_bijective (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f) :
    Function.Bijective (degOnePsi g f) :=
  ⟨degOnePsi_injective g f hqr, degOnePsi_surjective g f hqr⟩

/-- If `f : Fin r → R_g` is a quasi-regular sequence generating `J`, then `J/J²` is isomorphic
to `(R_g/J)^r` as an `R_g/J`-module. -/
theorem nonempty_cotangent_quot_pi_linearEquiv (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f) :
    Nonempty ((Fin r → (Localization.Away g ⧸ Ideal.span (Set.range f)))
      ≃ₗ[Localization.Away g ⧸ Ideal.span (Set.range f)]
      (Ideal.Cotangent (Ideal.span (Set.range f)))) := by
  obtain ⟨e1⟩ := nonempty_quot_jpow_one_linearEquiv g f
  obtain ⟨e2⟩ := nonempty_gPiece_one_linearEquiv_cotangent g f
  exact ⟨((LinearEquiv.piCongrRight fun _ ↦ e1.symm).trans
    ((LinearEquiv.ofBijective (degOnePsi g f)
      (degOnePsi_bijective g f hqr)).trans e2)).extendScalarsOfSurjective
    Ideal.Quotient.mk_surjective⟩

/-- If `f : Fin r → R_g` is a quasi-regular sequence generating `J`, then `J/J²` is a free
`R_g/J`-module. -/
@[ega "IV 19.1.3" "special case", sga "7 VI 4.14" "J/J² is a free A₀-module"]
theorem cotangent_quot_isFree (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f) :
    Module.Free (Localization.Away g ⧸ Ideal.span (Set.range f))
      (Ideal.Cotangent (Ideal.span (Set.range f))) := by
  obtain ⟨e⟩ := nonempty_cotangent_quot_pi_linearEquiv g f hqr
  exact Module.Free.of_equiv e

/-- If `J = I R_g`, then there is a ring isomorphism `R_g/J ≃+* (R/I)_{ḡ}`, where
`ḡ = algebraMap R (R ⧸ I) g`, compatible with the maps from `R`. -/
theorem locAway_quot_ringEquiv (I : Ideal R) (g : R) {J : Ideal (Localization.Away g)}
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = J) :
    ∃ C : (Localization.Away g ⧸ J) ≃+* Localization.Away (algebraMap R (R ⧸ I) g),
      ∀ x : R, C (algebraMap R (Localization.Away g ⧸ J) x)
        = algebraMap R (Localization.Away (algebraMap R (R ⧸ I) g)) x := by
  rw [← hJ]
  have hloc : IsLocalization (Algebra.algebraMapSubmonoid (R ⧸ I) (Submonoid.powers g))
      (Localization.Away g ⧸ Ideal.map (algebraMap R (Localization.Away g)) I) :=
    IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
      (Submonoid.powers g) (Localization.Away g) I
  rw [Algebra.algebraMapSubmonoid_powers] at hloc
  set AE := IsLocalization.algEquiv (Submonoid.powers (algebraMap R (R ⧸ I) g))
    (Localization.Away g ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)
    (Localization.Away (algebraMap R (R ⧸ I) g)) with hAE
  refine ⟨AE.toRingEquiv, ?_⟩
  intro x
  have hSJ : algebraMap R (Localization.Away g ⧸ Ideal.map (algebraMap R (Localization.Away g)) I) x
      = algebraMap (R ⧸ I) _ (algebraMap R (R ⧸ I) x) :=
    (IsScalarTower.algebraMap_apply R (R ⧸ I) _ x)
  have hT : algebraMap R (Localization.Away (algebraMap R (R ⧸ I) g)) x
      = algebraMap (R ⧸ I) _ (algebraMap R (R ⧸ I) x) :=
    (IsScalarTower.algebraMap_apply R (R ⧸ I) _ x)
  rw [hSJ, hT]
  exact AE.commutes _

/-- The `R`-linear map `I/I² → J/J²`, `[a] ↦ [algebraMap R R_g a]`, induced by
`algebraMap R R_g`, where `J = I R_g`. -/
noncomputable def cotangentMapAway (I : Ideal R) (g : R) {J : Ideal (Localization.Away g)}
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = J) :
    I.Cotangent →ₗ[R] J.Cotangent :=
  Ideal.mapCotangent I J (Algebra.ofId R (Localization.Away g))
    (by rw [← hJ]; exact Ideal.le_comap_map)

/-- The map `cotangentMapAway I g hJ : I/I² → J/J²` is a localization at the powers of `g`. -/
theorem cotangentMapAway_isLocalizedModule (I : Ideal R) (g : R)
    {J : Ideal (Localization.Away g)}
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = J) :
    IsLocalizedModule (Submonoid.powers g) (cotangentMapAway I g hJ) := by
  have θval : ∀ (a : R) (ha : a ∈ I),
      (cotangentMapAway I g hJ) (I.toCotangent ⟨a, ha⟩)
        = J.toCotangent
            ⟨algebraMap R (Localization.Away g) a,
              by rw [← hJ]; exact Ideal.mem_map_of_mem _ ha⟩ := by
    intro a ha
    rw [cotangentMapAway, Ideal.mapCotangent_toCotangent]
    rfl
  have smulJ : ∀ (k : ℕ) (w : Localization.Away g) (hw : w ∈ J),
      g^k • (J.toCotangent ⟨w, hw⟩)
        = J.toCotangent
            ⟨(algebraMap R (Localization.Away g) g)^k * w, Ideal.mul_mem_left _ _ hw⟩ := by
    intro k w hw
    rw [← IsScalarTower.algebraMap_smul (Localization.Away g), ← map_pow, ← LinearMap.map_smul]
    congr 1
  have smulI : ∀ (k : ℕ) (a : R) (ha : a ∈ I),
      g^k • (I.toCotangent ⟨a, ha⟩) = I.toCotangent ⟨g^k * a, Ideal.mul_mem_left _ _ ha⟩ := by
    intro k a ha
    rw [← LinearMap.map_smul]
    congr 1
  refine IsLocalizedModule.mk ?_ ?_ ?_
  · rintro ⟨x, n, rfl⟩
    obtain ⟨u, hu⟩ := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away g) g).pow n
    let e : J.Cotangent →ₗ[R] J.Cotangent :=
      { toFun := fun m ↦ (↑u⁻¹ : Localization.Away g) • m
        map_add' := fun a b ↦ by rw [smul_add]
        map_smul' := fun c m ↦ by dsimp; rw [smul_comm] }
    refine ⟨⟨(algebraMap R (Module.End R J.Cotangent)) (g^n), e, ?_, ?_⟩,
        rfl⟩
    · ext m
      simp only [Module.End.mul_apply, Module.End.one_apply]
      change ((algebraMap R (Module.End R J.Cotangent)) (g^n))
          ((↑u⁻¹ : Localization.Away g) • m) = m
      rw [Module.algebraMap_end_apply,
        show (g^n) • ((↑u⁻¹ : Localization.Away g) • m)
            = (algebraMap R (Localization.Away g) (g^n)) • ((↑u⁻¹ : Localization.Away g) • m) from
          (IsScalarTower.algebraMap_smul _ _ _).symm,
        map_pow, ← hu, smul_smul, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_smul]
    · ext m
      simp only [Module.End.mul_apply, Module.End.one_apply]
      change (↑u⁻¹ : Localization.Away g)
          • ((algebraMap R (Module.End R J.Cotangent)) (g^n)) m = m
      rw [Module.algebraMap_end_apply,
        show (g^n) • m = (algebraMap R (Localization.Away g) (g^n)) • m from
          (IsScalarTower.algebraMap_smul _ _ _).symm,
        map_pow, ← hu, smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]
  · intro y
    obtain ⟨⟨w, hw⟩, rfl⟩ := J.toCotangent_surjective y
    have hwmem : w ∈ Ideal.map (algebraMap R (Localization.Away g)) I := by rwa [hJ]
    rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers g) (Localization.Away g)] at hwmem
    obtain ⟨⟨⟨a, ha⟩, ⟨s, hs⟩⟩, heq⟩ := hwmem
    simp only at heq
    obtain ⟨k, rfl⟩ := hs
    refine ⟨⟨I.toCotangent ⟨a, ha⟩, ⟨g^k, k, rfl⟩⟩, ?_⟩
    change g^k • (J.toCotangent ⟨w, hw⟩) = _
    rw [smulJ, θval]
    congr 1
    apply Subtype.ext
    change (algebraMap R (Localization.Away g) g)^k * w = algebraMap R (Localization.Away g) a
    rw [← heq, map_pow]
    ring
  · intro x₁ x₂ hx
    have hm : (cotangentMapAway I g hJ) (x₁ - x₂) = 0 := by rw [map_sub, hx, sub_self]
    obtain ⟨⟨a, ha⟩, hrep⟩ := I.toCotangent_surjective (x₁ - x₂)
    rw [← hrep, θval] at hm
    have hker : (⟨algebraMap R (Localization.Away g) a,
        by rw [← hJ]; exact Ideal.mem_map_of_mem _ ha⟩
        : ↥J) ∈ J.toCotangent.ker := hm
    rw [Ideal.mem_toCotangent_ker] at hker
    have hmem : algebraMap R (Localization.Away g) a ∈ J^2 := hker
    have hpow : ∃ M : ℕ, g^M * a ∈ I^2 := by
      rw [← hJ, ← Ideal.map_pow] at hmem
      rw [IsLocalization.mem_map_algebraMap_iff (Submonoid.powers g) (Localization.Away g)] at hmem
      obtain ⟨⟨⟨b, hb⟩, ⟨s, hs⟩⟩, heq⟩ := hmem
      simp only [← map_mul] at heq
      rw [IsLocalization.eq_iff_exists (Submonoid.powers g) (Localization.Away g)] at heq
      obtain ⟨⟨c, hc⟩, hceq⟩ := heq
      obtain ⟨k, rfl⟩ := hs
      obtain ⟨j, rfl⟩ := hc
      refine ⟨j + k, ?_⟩
      have : g^(j+k) * a = g^j * (a * g^k) := by ring
      rw [this, hceq]
      exact Ideal.mul_mem_left _ _ hb
    obtain ⟨M, hM⟩ := hpow
    refine ⟨⟨g^M, M, rfl⟩, ?_⟩
    have hz : g^M • (x₁ - x₂) = (0 : I.Cotangent) := by
      rw [← hrep, smulI,
        show (I.toCotangent ⟨g^M * a, Ideal.mul_mem_left _ _ ha⟩ : I.Cotangent) = 0 ↔ _ from
          (Ideal.toCotangent_eq_zero I _)]
      exact hM
    rwa [smul_sub, sub_eq_zero] at hz

/-- For `J = I R_g` and a ring isomorphism `C : R_g/J ≃+* (R/I)_{ḡ}` compatible with the maps
from `R`, the module `J/J²` is `C`-semilinearly isomorphic to `LocalizedModule.Away ḡ (I/I²)`. -/
theorem nonempty_cotangent_localizedAway_semilinearEquiv (I : Ideal R) (g : R)
    {J : Ideal (Localization.Away g)}
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = J)
    (C : (Localization.Away g ⧸ J) ≃+* Localization.Away (algebraMap R (R ⧸ I) g))
    (hC : ∀ x : R, C (algebraMap R (Localization.Away g ⧸ J) x)
        = algebraMap R (Localization.Away (algebraMap R (R ⧸ I) g)) x)
    [RingHomInvPair (C : (Localization.Away g ⧸ J) →+* Localization.Away (algebraMap R (R ⧸ I) g))
      (C.symm : Localization.Away (algebraMap R (R ⧸ I) g) →+* (Localization.Away g ⧸ J))]
    [RingHomInvPair (C.symm : Localization.Away (algebraMap R (R ⧸ I) g) →+*
        (Localization.Away g ⧸ J))
      (C : (Localization.Away g ⧸ J) →+* Localization.Away (algebraMap R (R ⧸ I) g))] :
    Nonempty (Ideal.Cotangent J
      ≃ₛₗ[(C : (Localization.Away g ⧸ J) →+* Localization.Away (algebraMap R (R ⧸ I) g))]
      LocalizedModule.Away (algebraMap R (R ⧸ I) g) I.Cotangent) := by
  have := cotangentMapAway_isLocalizedModule I g hJ
  have e : LocalizedModule (Submonoid.powers g) I.Cotangent ≃ₗ[R] J.Cotangent :=
    IsLocalizedModule.iso (Submonoid.powers g) (cotangentMapAway I g hJ)
  have inst0 : IsLocalizedModule (Algebra.algebraMapSubmonoid (R ⧸ I) (Submonoid.powers g))
      (LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap R (R ⧸ I) g)) I.Cotangent) := by
    rw [Algebra.algebraMapSubmonoid_powers]; infer_instance
  have : IsLocalizedModule (Submonoid.powers g)
      ((LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap R (R ⧸ I) g))
        I.Cotangent).restrictScalars R) :=
    isLocalizedModule_restrictScalars_of_algebraMapSubmonoid (A := R ⧸ I)
      (Submonoid.powers g)
      (LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap R (R ⧸ I) g)) I.Cotangent)
  let b : LocalizedModule (Submonoid.powers g) I.Cotangent ≃ₗ[R]
      LocalizedModule.Away (algebraMap R (R ⧸ I) g) I.Cotangent :=
    IsLocalizedModule.iso (Submonoid.powers g)
      ((LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap R (R ⧸ I) g))
        I.Cotangent).restrictScalars R)
  let eR : Ideal.Cotangent J ≃ₗ[R]
      LocalizedModule.Away (algebraMap R (R ⧸ I) g) I.Cotangent := e.symm.trans b
  refine ⟨{ eR.toAddEquiv with map_smul' := ?_ }⟩
  intro a x
  change eR (a • x) = C a • eR x
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective a
  have hsx : (Ideal.Quotient.mk J s) • x = s • x := by
    rw [← IsScalarTower.algebraMap_smul (Localization.Away g ⧸ J) s x]
    congr 1
  rw [hsx]
  obtain ⟨⟨r₀, t⟩, hsurj⟩ := IsLocalization.surj (Submonoid.powers g) s
  have key1 : ((t : R)) • (s • x) = (r₀ : R) • x := by
    have e1 : ((t : R)) • (s • x) = (algebraMap R (Localization.Away g) (t : R)) • (s • x) :=
      (IsScalarTower.algebraMap_smul (Localization.Away g) (t:R) (s • x)).symm
    have e2 : (r₀ : R) • x = (algebraMap R (Localization.Away g) r₀) • x :=
      (IsScalarTower.algebraMap_smul (Localization.Away g) r₀ x).symm
    rw [e1, e2, smul_smul, mul_comm, hsurj]
  have hLHS : ((t : R)) • eR (s • x) = (r₀ : R) • eR x := by
    rw [← map_smul, ← map_smul, key1]
  have hmk : algebraMap R (Localization.Away g ⧸ J) (t:R)
      = Ideal.Quotient.mk J
          (algebraMap R (Localization.Away g) (t:R)) := by
    rw [IsScalarTower.algebraMap_apply R (Localization.Away g)
      (Localization.Away g ⧸ J) (t:R)]; rfl
  have hmk2 : algebraMap R (Localization.Away g ⧸ J) r₀
      = Ideal.Quotient.mk J (algebraMap R (Localization.Away g) r₀) := by
    rw [IsScalarTower.algebraMap_apply R (Localization.Away g)
      (Localization.Away g ⧸ J) r₀]; rfl
  have hRHS : ((t : R)) • (C ((Ideal.Quotient.mk J) s) • eR x)
      = (r₀ : R) • eR x := by
    rw [← IsScalarTower.algebraMap_smul (Localization.Away (algebraMap R (R ⧸ I) g)) (t:R)
      (C ((Ideal.Quotient.mk J) s) • eR x), smul_smul,
      ← IsScalarTower.algebraMap_smul (Localization.Away (algebraMap R (R ⧸ I) g)) r₀ (eR x)]
    congr 1
    rw [← hC (t:R), hmk, ← map_mul,
      show Ideal.Quotient.mk J (algebraMap R (Localization.Away g) (t:R))
          * Ideal.Quotient.mk J s
        = Ideal.Quotient.mk J (algebraMap R (Localization.Away g) r₀) by
        rw [← map_mul]; congr 1; rw [mul_comm]; exact hsurj,
      ← hmk2, hC r₀]
  have hcancel : ((t:R)) • eR (s • x)
      = ((t:R)) • (C ((Ideal.Quotient.mk J) s) • eR x) := by
    rw [hLHS, hRHS]
  have hunit : IsUnit (algebraMap R (Localization.Away (algebraMap R (R ⧸ I) g)) (t:R)) := by
    obtain ⟨n, hn⟩ := t.2
    rw [← hn, map_pow,
      IsScalarTower.algebraMap_apply R (R ⧸ I) (Localization.Away (algebraMap R (R ⧸ I) g)) g]
    exact (IsLocalization.Away.algebraMap_isUnit (algebraMap R (R ⧸ I) g)).pow n
  rw [← IsScalarTower.algebraMap_smul (Localization.Away (algebraMap R (R ⧸ I) g)) (t:R) (eR (s•x)),
    ← IsScalarTower.algebraMap_smul (Localization.Away (algebraMap R (R ⧸ I) g)) (t:R)
      (C ((Ideal.Quotient.mk J) s) • eR x)] at hcancel
  obtain ⟨v, hv⟩ := hunit
  rw [← hv] at hcancel
  have hfin := congrArg (fun y ↦ (↑v⁻¹ : Localization.Away (algebraMap R (R ⧸ I) g)) • y) hcancel
  simpa [smul_smul] using hfin

/-- If `I R_g` is generated by `f`, there is a ring isomorphism `C : R_g/J ≃+* (R/I)_{ḡ}` and a
`C`-semilinear isomorphism from `J/J²` to the localization of `I/I²` away from `ḡ`. -/
private theorem exists_semilinearEquiv_cotangent_localizedAway (I : Ideal R) (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g)
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)) :
    ∃ (C : (Localization.Away g ⧸ Ideal.span (Set.range f)) ≃+*
        Localization.Away (algebraMap R (R ⧸ I) g))
      (_ : RingHomInvPair (C : (Localization.Away g ⧸ Ideal.span (Set.range f)) →+*
        Localization.Away (algebraMap R (R ⧸ I) g))
        (C.symm : Localization.Away (algebraMap R (R ⧸ I) g) →+*
          (Localization.Away g ⧸ Ideal.span (Set.range f))))
      (_ : RingHomInvPair (C.symm : Localization.Away (algebraMap R (R ⧸ I) g) →+*
        (Localization.Away g ⧸ Ideal.span (Set.range f)))
        (C : (Localization.Away g ⧸ Ideal.span (Set.range f)) →+*
          Localization.Away (algebraMap R (R ⧸ I) g))),
      Nonempty (Ideal.Cotangent (Ideal.span (Set.range f))
        ≃ₛₗ[(C : (Localization.Away g ⧸ Ideal.span (Set.range f)) →+*
          Localization.Away (algebraMap R (R ⧸ I) g))]
        LocalizedModule.Away (algebraMap R (R ⧸ I) g) I.Cotangent) := by
  obtain ⟨C, hC⟩ := locAway_quot_ringEquiv I g hJ
  have h₁ := RingHomInvPair.of_ringEquiv C
  have h₂ := RingHomInvPair.of_ringEquiv_symm C
  exact ⟨C, h₁, h₂, nonempty_cotangent_localizedAway_semilinearEquiv I g hJ C hC⟩

/-- If `I R_g` is generated by a quasi-regular sequence `f : Fin r → R_g`, then the localization
of `I/I²` away from `ḡ` is a free `(R/I)_{ḡ}`-module. -/
theorem cotangent_localizedAway_isFree_of_span_eq (I : Ideal R) (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f)
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)) :
    Module.Free (Localization.Away (algebraMap R (R ⧸ I) g))
      (LocalizedModule.Away (algebraMap R (R ⧸ I) g) I.Cotangent) := by
  have hA : Module.Free (Localization.Away g ⧸ Ideal.span (Set.range f))
      (Ideal.Cotangent (Ideal.span (Set.range f))) := cotangent_quot_isFree g f hqr
  obtain ⟨C, _, _, ⟨D⟩⟩ := exists_semilinearEquiv_cotangent_localizedAway I g f hJ
  exact Module.Free.of_equiv D

/-- If `I R_g` is generated by a quasi-regular sequence `f : Fin r → R_g`, then the localization
of `I/I²` away from `ḡ` is a finite `(R/I)_{ḡ}`-module. -/
theorem cotangent_localizedAway_finite_of_span_eq (I : Ideal R) (g : R) {r : ℕ}
    (f : Fin r → Localization.Away g) (hqr : IsQuasiregularSeq f)
    (hJ : Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)) :
    Module.Finite (Localization.Away (algebraMap R (R ⧸ I) g))
      (LocalizedModule.Away (algebraMap R (R ⧸ I) g) I.Cotangent) := by
  obtain ⟨e⟩ := nonempty_cotangent_quot_pi_linearEquiv g f hqr
  have hAfin : Module.Finite (Localization.Away g ⧸ Ideal.span (Set.range f))
      (Ideal.Cotangent (Ideal.span (Set.range f))) := Module.Finite.equiv e
  obtain ⟨C, _, _, ⟨D⟩⟩ := exists_semilinearEquiv_cotangent_localizedAway I g f hJ
  exact Module.Finite.of_surjective D.toLinearMap D.surjective

/-- For a quasi-regular ideal `I`, a prime `p ⊇ I`, and the element `g ∉ p` chosen by
quasi-regularity, the localization of `I/I²` away from `ḡ` is a free `(R/I)_{ḡ}`-module. -/
@[ega "IV 16.9.4" "(ii)", ega "IV 19.1.3" "special case"]
theorem cotangent_localizedAway_isFree (I : Ideal R) (hI : IsQuasiregularIdeal I)
    (p : PrimeSpectrum R) (hp : I ≤ p.asIdeal) :
    Module.Free (Localization.Away (algebraMap R (R ⧸ I) (hI p hp).choose))
      (LocalizedModule.Away (algebraMap R (R ⧸ I) (hI p hp).choose) I.Cotangent) := by
  obtain ⟨-, r, f, hqr, hJ⟩ := (hI p hp).choose_spec
  exact cotangent_localizedAway_isFree_of_span_eq I _ f hqr hJ

/-- For a quasi-regular ideal `I`, a prime `p ⊇ I`, and the element `g ∉ p` chosen by
quasi-regularity, the localization of `I/I²` away from `ḡ` is a finite `(R/I)_{ḡ}`-module. -/
theorem cotangent_localizedAway_finite (I : Ideal R) (hI : IsQuasiregularIdeal I)
    (p : PrimeSpectrum R) (hp : I ≤ p.asIdeal) :
    Module.Finite (Localization.Away (algebraMap R (R ⧸ I) (hI p hp).choose))
      (LocalizedModule.Away (algebraMap R (R ⧸ I) (hI p hp).choose) I.Cotangent) := by
  obtain ⟨-, r, f, hqr, hJ⟩ := (hI p hp).choose_spec
  exact cotangent_localizedAway_finite_of_span_eq I _ f hqr hJ

/-- If `I` is a quasi-regular ideal, then `I/I²` is a finite `R/I`-module. -/
@[sga "6 VII 1.6" "partial"]
theorem cotangent_finite (I : Ideal R)
    (hI : IsQuasiregularIdeal I) : Module.Finite (R ⧸ I) I.Cotangent := by
  refine Module.Finite.of_localizationSpan
    (Set.range fun p : {p : PrimeSpectrum R // I ≤ p.asIdeal} ↦
      algebraMap R (R ⧸ I) (hI p.1 p.2).choose)
    (span_range_choose_eq_top I hI) ?_
  rintro ⟨g, p, rfl⟩
  exact cotangent_localizedAway_finite I hI p.1 p.2

/-- If `I` is a quasi-regular ideal, then `I/I²` is a finitely presented `R/I`-module. -/
@[sga "6 VII 1.6" "partial"]
theorem cotangent_finitePresentation (I : Ideal R)
    (hI : IsQuasiregularIdeal I) : Module.FinitePresentation (R ⧸ I) I.Cotangent := by
  set f : {p : PrimeSpectrum R // I ≤ p.asIdeal} → R ⧸ I :=
    fun p ↦ algebraMap R (R ⧸ I) (hI p.1 p.2).choose
  have hcov : Ideal.span (Set.range f) = ⊤ := span_range_choose_eq_top I hI
  refine Module.FinitePresentation.of_localizationSpan_range f hcov fun p ↦ ?_
  have := cotangent_localizedAway_isFree I hI p.1 p.2
  have := cotangent_localizedAway_finite I hI p.1 p.2
  exact Module.finitePresentation_of_projective _ _

/-- If `I` is a quasi-regular ideal, then `I/I²` is a projective `R/I`-module. -/
@[sga "6 VII 1.6" "partial"]
theorem cotangent_projective (I : Ideal R)
    (hI : IsQuasiregularIdeal I) : Module.Projective (R ⧸ I) I.Cotangent := by
  have : Module.FinitePresentation (R ⧸ I) I.Cotangent := cotangent_finitePresentation I hI
  rw [← Module.freeLocus_eq_univ_iff]
  set f : {p : PrimeSpectrum R // I ≤ p.asIdeal} → R ⧸ I :=
    fun p ↦ algebraMap R (R ⧸ I) (hI p.1 p.2).choose
  have hsub : ∀ p, (↑(PrimeSpectrum.basicOpen (f p)) : Set (PrimeSpectrum (R ⧸ I)))
      ⊆ Module.freeLocus (R ⧸ I) I.Cotangent := by
    intro p
    refine (Module.basicOpen_subset_freeLocus_iff).mpr ?_
    have : Module.Free (Localization.Away (f p)) (LocalizedModule.Away (f p) I.Cotangent) :=
      cotangent_localizedAway_isFree I hI p.1 p.2
    exact Module.Projective.of_free
  have htop : (⨆ p, PrimeSpectrum.basicOpen (f p)) = ⊤ :=
    (PrimeSpectrum.iSup_basicOpen_eq_top_iff).mpr (span_range_choose_eq_top I hI)
  apply Set.eq_univ_of_univ_subset
  intro x _
  have hx : x ∈ (⨆ p, PrimeSpectrum.basicOpen (f p)) := by rw [htop]; trivial
  rw [TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨p, hpx⟩ := hx
  exact hsub p hpx

/-- **Stacks 08RK**.
If `I \subseteq R` is a quasi-regular ideal, then `I/I^2` is a finite projective `R/I`-module. -/
@[stacks 08RK, ega "IV 16.9.4" "(ii)", ega "IV 19.1.3" "special case"]
theorem cotangent_finite_projective_of_quasiregular
    {R : Type*} [CommRing R] (I : Ideal R) (hI : IsQuasiregularIdeal' I) :
    Module.Finite (R ⧸ I) I.Cotangent ∧ Module.Projective (R ⧸ I) I.Cotangent :=
  ⟨cotangent_finite I hI, cotangent_projective I hI⟩

/-- **Stacks 07CW**.
A quasi-regular ideal is finitely generated. -/
@[stacks 07CW, ega "IV 16.9.4" "(i)"]
theorem isQuasiregularIdeal_fg {I : Ideal R} (hI : IsQuasiregularIdeal' I) : I.FG := by
  have hcover : ∀ p : PrimeSpectrum R, ∃ g : R,
      (Ideal.map (algebraMap R (Localization.Away g)) I).FG ∧ g ∉ p.asIdeal := by
    intro p
    by_cases hIp : I ≤ p.asIdeal
    · obtain ⟨g, hg, r, fg, -, hspan⟩ := hI p hIp
      refine ⟨g, ?_, hg⟩
      rw [hspan]
      exact Submodule.fg_span (Set.finite_range fg)
    · rw [IsConcreteLE.not_le_iff_exists] at hIp
      obtain ⟨g, hgI, hgp⟩ := hIp
      refine ⟨g, ?_, hgp⟩
      rw [Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hgI)
        (IsLocalization.Away.algebraMap_isUnit g)]
      exact ⟨{1}, by simp⟩
  have hspan_top :
      Ideal.span {g : R | (Ideal.map (algebraMap R (Localization.Away g)) I).FG} = ⊤ := by
    by_contra hne
    obtain ⟨m, hm, hsub⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨g, hgt, hgm⟩ := hcover ⟨m, hm.isPrime⟩
    exact hgm (hsub (Ideal.subset_span hgt))
  exact Ideal.fg_of_localizationSpan _ hspan_top fun g ↦ g.2

end Quasiregular
