/-- The maximal ideal of `A^` extends along the completed map to the extension of `𝔪_A S`. -/
private lemma map_maximalIdeal_adicCompletionMap {A B : Type*} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] :
    (maximalIdeal (AdicCompletion (maximalIdeal A) A)).map
        (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
          (IsLocalRing.map_maximalIdeal_le f)) =
      ((maximalIdeal A).map f).map (algebraMap B (AdicCompletion (maximalIdeal B) B)) := by
  rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_map,
    adicCompletionMap_comp_algebraMap f _ _ _, ← Ideal.map_map]

private lemma isLocalHom_adicCompletionMap {A B : Type*} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] :
    IsLocalHom (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
      (IsLocalRing.map_maximalIdeal_le f)) := by
  apply ((IsLocalRing.local_hom_TFAE _).out 3 1).mp
  rw [map_maximalIdeal_adicCompletionMap]
  exact (Ideal.map_mono (IsLocalRing.map_maximalIdeal_le f)).trans
    (AdicCompletion.maximalIdeal_eq_map (R := B)).ge

private def completionLevelMap {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (J : Ideal R) (I : Ideal S) (hf : J.map f ≤ I) (n : ℕ) :
    R ⧸ J ^ n →+* S ⧸ I ^ n :=
  Ideal.quotientMap (I ^ n) f (Ideal.map_le_iff_le_comap.mp (by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono hf n))

private lemma completionLevelMap_lift_compatible {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (J : Ideal R) (I : Ideal S) (hf : J.map f ≤ I)
    {m n : ℕ} (hmn : m ≤ n) :
    (Ideal.Quotient.factorPow I hmn).comp
        ((completionLevelMap f J I hf n).comp (AdicCompletion.evalₐ J n).toRingHom) =
      (completionLevelMap f J I hf m).comp (AdicCompletion.evalₐ J m).toRingHom := by
  ext x
  induction x using AdicCompletion.induction_on with
  | h a =>
    change Ideal.Quotient.factorPow I hmn
        (completionLevelMap f J I hf n
          (Ideal.Quotient.mk (J ^ n) (a.val n))) =
      completionLevelMap f J I hf m (Ideal.Quotient.mk (J ^ m) (a.val m))
    simp only [completionLevelMap, Ideal.quotientMap_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk]
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, ← map_sub]
    apply Ideal.map_le_iff_le_comap.mp (by rw [Ideal.map_pow]; exact Ideal.pow_right_mono hf m)
    simpa only [neg_sub, smul_eq_mul, Ideal.mul_top] using
      (Submodule.neg_mem (J ^ m • (⊤ : Submodule R R))
        (SModEq.sub_mem.mp (a.property hmn)))

private lemma adicCompletionMap_eval {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (J : Ideal R) (I : Ideal S) (hf : J.map f ≤ I)
    (n : ℕ) (x : AdicCompletion J R) :
    AdicCompletion.evalₐ I n (adicCompletionMap f J I hf x) =
      completionLevelMap f J I hf n (AdicCompletion.evalₐ J n x) := by
  change (AdicCompletion.evalₐ I n).toRingHom
      ((AdicCompletion.liftRingHom I
        (fun m ↦ (completionLevelMap f J I hf m).comp
          (AdicCompletion.evalₐ J m).toRingHom)
        (fun {m k} hmk => completionLevelMap_lift_compatible f J I hf hmk) x)) = _
  exact DFunLike.congr_fun
    (AdicCompletion.evalₐ_comp_liftRingHom I
      (fun m ↦ (completionLevelMap f J I hf m).comp (AdicCompletion.evalₐ J m).toRingHom)
      (fun {m k} hmk => completionLevelMap_lift_compatible f J I hf hmk) n) x

private lemma adicCompletionMap_comp {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    (f : R →+* S) (g : S →+* T) (J : Ideal R) (I : Ideal S) (K : Ideal T)
    (hf : J.map f ≤ I) (hg : I.map g ≤ K) :
    (adicCompletionMap g I K hg).comp
        (adicCompletionMap f J I hf) =
      adicCompletionMap (g.comp f) J K (by
        rw [← Ideal.map_map]
        exact (Ideal.map_mono hf).trans hg) := by
  refine RingHom.ext fun x => AdicCompletion.ext_evalₐ fun n => ?_
  change AdicCompletion.evalₐ K n
      (adicCompletionMap g I K hg (adicCompletionMap f J I hf x)) = _
  rw [adicCompletionMap_eval, adicCompletionMap_eval, adicCompletionMap_eval]
  have hlevel : (completionLevelMap g I K hg n).comp
        (completionLevelMap f J I hf n) = completionLevelMap (g.comp f) J K (by
          rw [← Ideal.map_map]
          exact (Ideal.map_mono hf).trans hg) n := by
    refine RingHom.ext fun a => ?_
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    simp [completionLevelMap, Ideal.quotientMap_mk]
  exact DFunLike.congr_fun hlevel (AdicCompletion.evalₐ J n x)

/-- The maximal-ideal-adic completion of a Noetherian local ring is faithfully flat. -/
private theorem faithfullyFlat_adicCompletion_maximalIdeal {R : Type u} [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] :
    Module.FaithfullyFlat R (AdicCompletion (maximalIdeal R) R) :=
  AdicCompletion.faithfullyFlat_of_le_ringJacobson (maximalIdeal R) (by
    rw [IsLocalRing.ringJacobson_eq_maximalIdeal])

private theorem isRegular_adicCompletion_iff {R : Type u} [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] (rs : List R) :
    IsRegular (AdicCompletion (maximalIdeal R) R)
        (rs.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) ↔ IsRegular R rs := by
  have := faithfullyFlat_adicCompletion_maximalIdeal (R := R)
  exact isRegular_map_algebraMap_iff_of_faithfullyFlat_of_isBaseChange
    (IsBaseChange.linearMap R (AdicCompletion (maximalIdeal R) R)) rs

private theorem range_map_ideal_subtype {R : Type u} [CommRing R] [IsNoetherianRing R]
    (I J : Ideal R) :
    Submodule.restrictScalars R
        (LinearMap.range (AdicCompletion.map J (Submodule.subtype (I : Submodule R R)))) =
      Submodule.restrictScalars R (I.map (algebraMap R (AdicCompletion J R))) := by
  apply le_antisymm
  · rintro x ⟨y, rfl⟩
    rw [← Ideal.smul_top_eq_map]
    exact Stacks.AdicCompletion.QuotientDescent.map_subtype_mem_smul_top I J
      (IsNoetherian.noetherian I) y
  · rw [← Ideal.smul_top_eq_map, Submodule.smul_le]
    intro a ha x hx
    refine ⟨x • AdicCompletion.of J (I : Submodule R R) ⟨a, ha⟩, ?_⟩
    rw [map_smul, AdicCompletion.map_of]
    change x * AdicCompletion.of J R a =
      algebraMap R (AdicCompletion J R) a * x
    rw [AdicCompletion.algebraMap_apply, mul_comm]
    simp

private theorem ker_map_adicCompletion {R T : Type u}
    [CommRing R] [AddCommGroup T] [Module R T] [IsNoetherianRing R] (J : Ideal R)
    (I : Ideal R) (f : R →ₗ[R] T) (hf : Function.Surjective f)
    (hker : (I : Submodule R R) = LinearMap.ker f) :
    Submodule.restrictScalars R (LinearMap.ker (AdicCompletion.map J f)) =
      Submodule.restrictScalars R
        (I.map (algebraMap R (AdicCompletion J R))) := by
  have : Module.Finite R T := Module.Finite.of_surjective f hf
  have hExact := AdicCompletion.map_exact (I := J)
    (Submodule.injective_subtype (LinearMap.ker f)) f.exact_subtype_ker_map hf
  rw [← hker] at hExact
  ext x
  rw [← range_map_ideal_subtype I J]
  exact hExact x

private theorem regular_adicCompletion_closedFiber
    {A : Type u} {S : Type w} [CommRing A] [CommRing S]
    [IsNoetherianRing A] [IsNoetherianRing S] [IsLocalRing A] [IsLocalRing S]
    (f : A →+* S) [IsLocalHom f] :
    IsRegularLocalRing (S ⧸ (maximalIdeal A).map f) →
      IsRegularLocalRing
        (AdicCompletion (maximalIdeal S) S ⧸
          (maximalIdeal (AdicCompletion (maximalIdeal A) A)).map
            (adicCompletionMap f (maximalIdeal A) (maximalIdeal S)
              (IsLocalRing.map_maximalIdeal_le f))) := by
  intro hF
  let I : Ideal S := (maximalIdeal A).map f
  let F := S ⧸ I
  let q : S →+* F := Ideal.Quotient.mk I
  have hmaxF : (maximalIdeal S).map (algebraMap S F) = maximalIdeal F := by
    change (maximalIdeal S).map q = maximalIdeal F
    exact IsLocalRing.map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective
  have : IsRegularLocalRing (AdicCompletion ((maximalIdeal S).map (algebraMap S F)) F) := by
    rw [hmaxF]
    exact (isRegularLocalRing_iff_adicCompletion_maximalIdeal (A := F)).mp hF
  rw [map_maximalIdeal_adicCompletionMap]
  exact IsRegularLocalRing.of_ringEquiv
    (adicCompletionQuotientAlgEquiv (maximalIdeal S) I).toRingEquiv.symm

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

private theorem exists_regular_generators_of_koszulRegularIdeal_local
    {R : Type u} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : Ideal.IsKoszulRegular I) (hIm : I ≤ maximalIdeal R) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = I := by
  obtain ⟨g, hgp, r, f, hf, hspan⟩ := hI ⟨maximalIdeal R, inferInstance⟩ hIm
  have hgunit : IsUnit g := IsLocalRing.notMem_maximalIdeal.mp hgp
  let : IsLocalization.Away g R :=
    IsLocalization.away_of_isUnit_of_bijective R hgunit Function.bijective_id
  let e : R ≃ₐ[R] Localization.Away g :=
    IsLocalization.atUnit R (Localization.Away g) g hgunit
  let : IsLocalRing (Localization.Away g) := e.toRingEquiv.isLocalRing
  let : IsNoetherianRing (Localization.Away g) :=
    isNoetherianRing_of_ringEquiv R e.toRingEquiv
  let : RingHomInvPair e.symm.toRingHom e.toRingHom :=
    RingHomInvPair.of_ringEquiv_symm e.toRingEquiv
  let : RingHomInvPair e.toRingHom e.symm.toRingHom :=
    RingHomInvPair.of_ringEquiv e.toRingEquiv
  let : RingHomInvPair e.symm.toRingHom e.symm.symm.toRingHom :=
    RingHomInvPair.of_ringEquiv e.symm.toRingEquiv
  let fs : Fin r → R := fun i => e.symm (f i)
  have halg : (algebraMap R (Localization.Away g)) = e.toRingHom := by
    ext x
    exact (e.commutes x).symm
  have hregularAway : IsRegular (Localization.Away g) (List.ofFn f) := by
    have hmemAway : ∀ i, f i ∈ maximalIdeal (Localization.Away g) := by
      have hmax : (maximalIdeal R).map (algebraMap R (Localization.Away g)) =
          maximalIdeal (Localization.Away g) := by
        rw [halg]
        exact IsLocalRing.map_ringEquiv_maximalIdeal e.toRingEquiv
      intro i
      have hmap : (Ideal.map (algebraMap R (Localization.Away g)) I) ≤
          maximalIdeal (Localization.Away g) := by
        rw [← hmax]
        exact Ideal.map_mono hIm
      have hi : f i ∈ Ideal.map (algebraMap R (Localization.Away g)) I := by
        rw [hspan]
        exact Ideal.subset_span ⟨i, rfl⟩
      exact hmap hi
    exact ((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae
      (M := Localization.Away g) f hmemAway).2.out 2 1).mp hf
  have hreg : IsRegular R (List.ofFn fs) := by
    have := (e.symm.toRingEquiv.toSemilinearEquiv.isRegular_congr' (List.ofFn f)).mp hregularAway
    rwa [List.map_ofFn] at this
  refine ⟨List.ofFn fs, hreg, ?_⟩
  have hmap : (Ideal.ofList (List.ofFn fs)).map e.toRingHom = I.map e.toRingHom := by
    have hrange : (e.toRingHom ∘ fs) = f := funext fun i => by simp [fs]
    rw [Ideal.map_ofList, List.map_ofFn, hrange]
    have hofn : Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
      unfold Ideal.ofList
      congr 1
      ext x
      simp [List.mem_ofFn]
    rw [hofn, ← hspan, ← halg]
  have hcomap := congrArg (Ideal.comap e.toRingHom) hmap
  rw [Ideal.comap_map_of_surjective e.toRingHom e.surjective,
    Ideal.comap_map_of_surjective e.toRingHom e.surjective,
    Ideal.comap_bot_of_injective e.toRingHom e.injective] at hcomap
  simpa only [sup_bot_eq] using hcomap

private theorem adicCompletionMap_algebraMap_apply
    {S B : Type*} [CommRing S] [CommRing B] [Algebra S B]
    (J : Ideal S) (x : AdicCompletion J S) :
    adicCompletionMap (algebraMap S B) J (J.map (algebraMap S B)) le_rfl x =
      adicCompletionLinearEquivMap J B (AdicCompletion.map J (Algebra.linearMap S B) x) := by
  let g : S →+* B := algebraMap S B
  let E := adicCompletionLinearEquivMap J B
  obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective J S x
  let cB : AdicCauchySequence (J.map (algebraMap S B)) B := ⟨
    fun n => g (c n), fun {m n} hmn => by
      rw [SModEq.sub_mem]
      simpa [smul_eq_mul, Ideal.mul_top, ← Ideal.map_pow, map_sub,
        show g = algebraMap S B from rfl] using
        Ideal.mem_map_of_mem g (SModEq.sub_mem.mp (c.property hmn))⟩
  have he : E (AdicCompletion.map J (Algebra.linearMap S B) (AdicCompletion.mk J S c)) =
      AdicCompletion.mk (J.map (algebraMap S B)) B cB := by
    apply AdicCompletion.ext
    intro n
    change quotEquivMapPow J B n
        ((AdicCompletion.map J (Algebra.linearMap S B) (AdicCompletion.mk J S c)).val n) =
      Submodule.Quotient.mk (g (c n))
    simp only [AdicCompletion.map_mk, AdicCompletion.mk_apply_coe,
      AdicCauchySequence.map_apply_coe]
    change quotEquivMapPow J B n (Submodule.Quotient.mk (g (c n))) = _
    rw [quotEquivMapPow_mk]
    rfl
  refine AdicCompletion.ext_evalₐ fun n => ?_
  rw [adicCompletionMap_eval, he]
  simp only [completionLevelMap]
  rw [AdicCompletion.evalₐ_mk]
  rfl

/-- The completion of a surjective homomorphism of Noetherian rings, along an ideal and its
extension, is surjective. -/
@[ega "0 7.3.1" "surjectivity of v̂"]
public theorem adicCompletionMap_surjective_of_map_eq
    {S B : Type*} [CommRing S] [CommRing B]
    [IsNoetherianRing S] [IsNoetherianRing B]
    (g : S →+* B) (J : Ideal S) (I : Ideal B)
    (hmax : J.map g = I) (hg : Function.Surjective g) :
    Function.Surjective (adicCompletionMap g J I hmax.le) := by
  let : Algebra S B := g.toAlgebra
  have hmaxAlg : J.map (algebraMap S B) = I := by
    simpa only [show g = algebraMap S B from rfl] using hmax
  cases hmaxAlg
  let E : AdicCompletion J B ≃ₗ[S] AdicCompletion (J.map (algebraMap S B)) B :=
    adicCompletionLinearEquivMap J B
  intro y
  obtain ⟨z, hz⟩ := E.surjective y
  obtain ⟨x, hx⟩ := AdicCompletion.map_surjective J (M := S) (N := B)
    (f := Algebra.linearMap S B) hg z
  exact ⟨x, (adicCompletionMap_algebraMap_apply J x).trans (by rw [hx, hz])⟩

/-- The completion of a surjective homomorphism of Noetherian rings, along an ideal and its
extension, has kernel the extension of the kernel. -/
public theorem adicCompletionMap_ker_eq_map_ker_of_surjective
    {S B : Type*} [CommRing S] [CommRing B]
    [IsNoetherianRing S] [IsNoetherianRing B]
    (g : S →+* B) (J : Ideal S) (I : Ideal B)
    (hmax : J.map g = I) (hg : Function.Surjective g) :
    RingHom.ker (adicCompletionMap g J I hmax.le) =
      (RingHom.ker g).map (algebraMap S (AdicCompletion J S)) := by
  let : Algebra S B := g.toAlgebra
  have hmaxAlg : J.map (algebraMap S B) = I := by
    simpa only [show g = algebraMap S B from rfl] using hmax
  cases hmaxAlg
  let E : AdicCompletion J B ≃ₗ[S] AdicCompletion (J.map (algebraMap S B)) B :=
    adicCompletionLinearEquivMap J B
  let Q := S ⧸ RingHom.ker g
  let q : S →+* Q := Ideal.Quotient.mk (RingHom.ker g)
  let e : Q ≃+* B := RingHom.quotientKerEquivOfSurjective (f := g) hg
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  let eL : Q ≃ₗ[S] B :=
    { toFun := e
      invFun := e.symm
      left_inv := fun x => e.symm_apply_apply x
      right_inv := fun x => e.apply_symm_apply x
      map_add' := e.map_add
      map_smul' := by
        intro r x
        change e (q r * x) = g r * e x
        rw [map_mul, RingHom.quotientKerEquivOfSurjective_apply_mk] }
  have hcomp : (AdicCompletion.map J eL.toLinearMap).comp
      (AdicCompletion.map J (Algebra.linearMap S Q)) =
        AdicCompletion.map J (Algebra.linearMap S B) := by
    rw [AdicCompletion.map_comp]
    congr 1
  have hE : Function.Injective (AdicCompletion.map J eL.toLinearMap) :=
    (AdicCompletion.congr J eL).injective
  have hkerMaps :
      LinearMap.ker (AdicCompletion.map J (Algebra.linearMap S B)) =
        LinearMap.ker (AdicCompletion.map J (Algebra.linearMap S Q)) := by
    rw [← hcomp]
    exact LinearMap.ker_comp_of_ker_eq_bot _ (LinearMap.ker_eq_bot.mpr hE)
  have hkerq : (RingHom.ker q : Submodule S S) = LinearMap.ker (Algebra.linearMap S Q) := rfl
  have hkerMapQ := ker_map_adicCompletion J (RingHom.ker q) (Algebra.linearMap S Q) hq hkerq
  have hkerqI : RingHom.ker q = RingHom.ker g := by
    ext x
    exact Ideal.Quotient.eq_zero_iff_mem
  have hkerMap :
      Submodule.restrictScalars S (LinearMap.ker (AdicCompletion.map J
        (Algebra.linearMap S B))) =
      Submodule.restrictScalars S
        ((RingHom.ker g).map (algebraMap S (AdicCompletion J S))) := by
    rw [hkerMaps, hkerMapQ, hkerqI]
  ext x
  change _ ↔ x ∈ Submodule.restrictScalars S
    ((RingHom.ker g).map (algebraMap S (AdicCompletion J S)))
  rw [← hkerMap, RingHom.mem_ker]
  exact (iff_of_eq (congrArg (· = 0) (adicCompletionMap_algebraMap_apply (B := B) J x))).trans
    E.map_eq_zero_iff

private theorem completionFactorization_isGood
    {A : Type u} {B : Type v} {S : Type w}
    [CommRing A] [CommRing B] [CommRing S]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsNoetherianRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing S]
    (h : A →+* B) (f : A →+* S) (g : S →+* B)
    [IsLocalHom h] [IsLocalHom f] [IsLocalHom g]
    (hgood : IsGoodFactorization h f g) :
    IsGoodFactorization
      (adicCompletionMap h (maximalIdeal A) (maximalIdeal B)
        (IsLocalRing.map_maximalIdeal_le h))
      (adicCompletionMap f (maximalIdeal A) (maximalIdeal S)
        (IsLocalRing.map_maximalIdeal_le f))
      (adicCompletionMap g (maximalIdeal S) (maximalIdeal B)
        (IsLocalRing.map_maximalIdeal_le g)) := by
  rcases hgood with ⟨hfg, hfLocal, hgLocal, hsurj, hflat, hreg⟩
  let hc := adicCompletionMap h (maximalIdeal A) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le h)
  let fc := adicCompletionMap f (maximalIdeal A) (maximalIdeal S)
    (IsLocalRing.map_maximalIdeal_le f)
  let gc := adicCompletionMap g (maximalIdeal S) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le g)
  have hcomp : gc.comp fc =
      adicCompletionMap (g.comp f) (maximalIdeal A) (maximalIdeal B)
        (by
          rw [← Ideal.map_map]
          exact (Ideal.map_mono (IsLocalRing.map_maximalIdeal_le f)).trans
            (IsLocalRing.map_maximalIdeal_le g)) :=
    adicCompletionMap_comp f g (maximalIdeal A) (maximalIdeal S)
      (maximalIdeal B) (IsLocalRing.map_maximalIdeal_le f)
      (IsLocalRing.map_maximalIdeal_le g)
  exact ⟨by change gc.comp fc = hc; simpa [hc, hfg] using hcomp,
    isLocalHom_adicCompletionMap f, isLocalHom_adicCompletionMap g,
    adicCompletionMap_surjective_of_map_eq g _ _
      (IsLocalRing.map_maximalIdeal_of_surjective g hsurj) hsurj,
    (adicCompletionMap_flat_iff f).2 hflat, regular_adicCompletion_closedFiber f hreg⟩

private lemma small_completion_of_residueField {S : Type*} [CommRing S]
    [IsNoetherianRing S] [IsLocalRing S] [Small.{u} (ResidueField S)] :
    Small.{u} (AdicCompletion (maximalIdeal S) S) := by
  let : Small.{u} (S ⧸ maximalIdeal S) := ‹Small.{u} (ResidueField S)›
  let (n : ℕ) : Small.{u} (S ⧸ maximalIdeal S ^ n) :=
    Ideal.small_quotient_pow (maximalIdeal S) (IsNoetherian.noetherian _) n
  exact small_of_injective.{u} (f := fun x : AdicCompletion (maximalIdeal S) S =>
    fun n => AdicCompletion.evalₐ (maximalIdeal S) n x)
    (fun x y h => AdicCompletion.ext_evalₐ (fun n => congrFun h n))

private lemma goodFactorization_equiv {A B S T : Type*}
    [CommRing A] [CommRing B] [CommRing S] [CommRing T]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing S] [IsLocalRing T]
    [IsNoetherianRing S] [IsNoetherianRing T]
    (h : A →+* B) (f : A →+* S) (g : S →+* B) (e : T ≃+* S)
    (hg : IsGoodFactorization h f g) :
    IsGoodFactorization h (e.symm.toRingHom.comp f) (g.comp e.toRingHom) := by
  let : IsLocalHom f := hg.2.1
  let : IsLocalHom g := hg.2.2.1
  let : IsLocalHom e.toRingHom :=
    ⟨fun x hx => by simpa using hx.map e.symm.toMonoidHom⟩
  let : IsLocalHom e.symm.toRingHom :=
    ⟨fun x hx => by simpa using hx.map e.toMonoidHom⟩
  refine ⟨?_, RingHom.isLocalHom_comp _ _, RingHom.isLocalHom_comp _ _,
    hg.2.2.2.1.comp e.surjective,
    (RingHom.Flat.comp_iff_of_bijective_left e.symm.bijective).mpr hg.2.2.2.2.1, ?_⟩
  · ext x
    simpa using DFunLike.congr_fun hg.1 x
  · let := hg.2.2.2.2.2
    exact IsRegularLocalRing.of_ringEquiv
      (Ideal.quotientEquiv ((maximalIdeal A).map f)
        ((maximalIdeal A).map (e.symm.toRingHom.comp f)) e.symm
        (by rw [Ideal.map_map]; rfl))

private lemma regularGenerators_equiv {S T B : Type*}
    [CommRing S] [CommRing T] [CommRing B] (g : S →+* B) (e : T ≃+* S) :
    (∃ rs : List T, IsRegular T rs ∧ Ideal.ofList rs = RingHom.ker (g.comp e.toRingHom)) ↔
      ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker g := by
  constructor
  · rintro ⟨rs, hr, hi⟩
    refine ⟨rs.map e, (e.toSemilinearEquiv.isRegular_congr' rs).mp hr, ?_⟩
    change Ideal.ofList (rs.map e.toRingHom) = _
    rw [← Ideal.map_ofList, hi, ← RingHom.comap_ker,
      Ideal.map_comap_of_surjective e.toRingHom e.surjective]
  · rintro ⟨rs, hr, hi⟩
    refine ⟨rs.map e.symm, (e.symm.toSemilinearEquiv.isRegular_congr' rs).mp hr, ?_⟩
    change Ideal.ofList (rs.map e.symm.toRingHom) = _
    rw [← Ideal.map_ofList, hi, ← RingHom.comap_ker]
    exact Ideal.map_symm e

private lemma isRegularIdeal_of_regular_generators {R : Type*} [CommRing R]
    (rs : List R) (hrs : IsRegular R rs) : Ideal.IsRegular (Ideal.ofList rs) := by
  let e : R ≃ₐ[R] Localization.Away (1 : R) :=
    IsLocalization.atUnit R (Localization.Away (1 : R)) 1 isUnit_one
  have hreg := (e.toRingEquiv.toSemilinearEquiv.isRegular_congr' rs).mp hrs
  intro p hp
  refine ⟨1, p.asIdeal.ne_top_iff_one.mp p.isPrime.ne_top, rs.length,
    fun i => e (rs.get i), ?_, ?_⟩
  · change IsRegular _ (List.ofFn (e ∘ rs.get))
    rw [← List.map_ofFn, List.ofFn_get]
    exact hreg
  · rw [Ideal.ofList, Ideal.map_span]
    congr 1
    ext x
    simp only [Set.mem_image, Set.mem_range]
    constructor
    · rintro ⟨y, hy, rfl⟩
      obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hy
      exact ⟨i, e.commutes _⟩
    · rintro ⟨i, rfl⟩
      exact ⟨rs.get i, List.get_mem .., (e.commutes _).symm⟩

/-- In a good factorization `A → S → B`, the kernel of `S → B` is generated by a
regular sequence if and only if the induced map `A^∧ → B^∧` is a complete intersection
homomorphism. -/
@[stacks 09QD]
public theorem isGeneratedByRegularSequence_ker_iff_isCompleteIntersectionHom
    {A : Type u} {B : Type v} {S : Type w} [CommRing A] [CommRing B] [CommRing S]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsNoetherianRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing S]
    (h : A →+* B) (f : A →+* S) (g : S →+* B)
    [IsLocalHom h] (hgood : IsGoodFactorization h f g) :
    (RingHom.ker g).IsGeneratedByRegularSequence ↔
      IsCompleteIntersectionHom
        (adicCompletionMap h (maximalIdeal A) (maximalIdeal B)
          (IsLocalRing.map_maximalIdeal_le h)) := by
  let : IsLocalHom f := hgood.2.1
  let : IsLocalHom g := hgood.2.2.1
  let Ac := AdicCompletion (maximalIdeal A) A
  let Bc := AdicCompletion (maximalIdeal B) B
  let Sc := AdicCompletion (maximalIdeal S) S
  let hc := adicCompletionMap h (maximalIdeal A) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le h)
  let fc := adicCompletionMap f (maximalIdeal A) (maximalIdeal S)
    (IsLocalRing.map_maximalIdeal_le f)
  let gc := adicCompletionMap g (maximalIdeal S) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le g)
  let : IsLocalHom hc := isLocalHom_adicCompletionMap h
  have hgoodc : IsGoodFactorization hc fc gc :=
    completionFactorization_isGood h f g hgood
  have hker : RingHom.ker gc = (RingHom.ker g).map (algebraMap S Sc) :=
    adicCompletionMap_ker_eq_map_ker_of_surjective g _ _
      (IsLocalRing.map_maximalIdeal_of_surjective g hgood.2.2.2.1) hgood.2.2.2.1
  let : Small.{max u v} (ResidueField B) := small_max _
  let : Small.{max u v} (ResidueField S) :=
    small_of_injective (ResidueField.map g).injective
  let : Small.{max u v} Sc := small_completion_of_residueField
  let T := Shrink.{max u v} Sc
  let e : T ≃+* Sc := Shrink.ringEquiv Sc
  let : IsLocalRing T := e.symm.isLocalRing
  let : IsNoetherianRing T := isNoetherianRing_of_ringEquiv Sc e.symm
  let fT := e.symm.toRingHom.comp fc
  let gT := gc.comp e.toRingHom
  have hgoodT : IsGoodFactorization hc fT gT :=
    goodFactorization_equiv hc fc gc e hgoodc
  have hcriterion :
      (∃ rs : List T, IsRegular T rs ∧ Ideal.ofList rs = RingHom.ker gT) ↔
        IsCompleteIntersectionHom hc :=
    ⟨fun hr => ⟨T, inferInstance, inferInstance, inferInstance, fT, gT, hgoodT, hr⟩,
      fun hci => (isCompleteIntersectionHom_iff_forall_goodFactorization.{u, v, 0}
        hc).mp hci T fT gT hgoodT⟩
  have hregularc :
      (∃ rs : List Sc, IsRegular Sc rs ∧ Ideal.ofList rs = RingHom.ker gc) ↔
        IsCompleteIntersectionHom hc :=
    (regularGenerators_equiv gc e).symm.trans hcriterion
  change _ ↔ IsCompleteIntersectionHom hc
  rw [← hregularc]
  constructor
  · rintro ⟨rs, hreg, hspan⟩
    refine ⟨rs.map (algebraMap S Sc), (isRegular_adicCompletion_iff rs).mpr hreg, ?_⟩
    rw [← Ideal.map_ofList, hspan, hker]
  · rintro ⟨rs, hreg, hspan⟩
    have hkoszul : Ideal.IsKoszulRegular ((RingHom.ker g).map (algebraMap S Sc)) := by
      rw [← hker, ← hspan]
      exact (isRegularIdeal_of_regular_generators rs hreg).isKoszulRegular
    have hff : (algebraMap S Sc).FaithfullyFlat := by
      rw [RingHom.faithfullyFlat_algebraMap_iff]
      exact faithfullyFlat_adicCompletion_maximalIdeal
    exact exists_regular_generators_of_koszulRegularIdeal_local (RingHom.ker g)
      ((Koszul.regular_ideals_of_faithfullyFlat (algebraMap S Sc) hff _).1 hkoszul)
      (IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top g))

end LocalCompleteIntersection

