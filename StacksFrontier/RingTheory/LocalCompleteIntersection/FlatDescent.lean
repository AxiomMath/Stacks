module

public import StacksFrontier.RingTheory.LocalCompleteIntersection.FlatLocalHomomorphism

/-!
# Complete intersections descend along flat local homomorphisms

Let `A → B` be a flat local homomorphism of Noetherian local rings. Then `B` is a complete
intersection if and only if `A` and the closed fibre `B / 𝔪_A B` are. This is the
completion-free form of the criterion
`LocalCompleteIntersection.isCompleteIntersectionCompleteLocalRing_adicCompletion_iff_of_flat`:
a Noetherian local ring is a complete intersection exactly when its completion is a complete
intersection complete local ring, so the three conditions of that criterion are the three
conditions here.

The global consequence is that being a local complete intersection ring descends along a
faithfully flat ring map of Noetherian rings. A prime of the source is the contraction of a
prime of the target, the induced map of local rings is a flat local homomorphism, and the
criterion applies to it.

## Main results

* `LocalCompleteIntersection.isCompleteIntersectionRing_iff_adicCompletion`: a Noetherian local
  ring is a complete intersection exactly when its completion is.
* `LocalCompleteIntersection.isCompleteIntersectionRing_iff_of_flat`: the criterion for a flat
  local homomorphism, in the completion-free form.
* `LocalCompleteIntersection.isCompleteIntersectionRing_of_flat` and
  `LocalCompleteIntersection.isCompleteIntersectionRing_quotient_of_flat`: its two
  consequences, stated separately so that neither drags in the instances the other needs.
* `LocalCompleteIntersection.isLocalCompleteIntersectionRing_of_faithfullyFlat`: descent of the
  local complete intersection condition along a faithfully flat ring map.

## Implementation notes

`LocalCompleteIntersection.IsCompleteIntersectionRing` is a condition on the completion already,
and `LocalCompleteIntersection.IsCompleteIntersectionCompleteLocalRing` is that same condition
together with the ring being a Noetherian complete local ring. For the completion of a
Noetherian local ring the latter is automatic, which is all
`isCompleteIntersectionRing_iff_adicCompletion` says.

The local rings of a faithfully flat extension are compared through
`Localization.localRingHom`, supplied as an algebra structure by
`Localization.algebraOfLiesOver`; that this algebra structure is flat is Mathlib's instance for
a prime lying over a prime of a flat algebra, and that it is local is
`Localization.isLocalHom_localRingHom`.

## References

* [Stacks Project, Tag 09Q2](https://stacks.math.columbia.edu/tag/09Q2)
* [Stacks Project, Tag 09Q7](https://stacks.math.columbia.edu/tag/09Q7)
-/

@[expose] public section

open IsLocalRing RingTheory.Sequence

universe u v

namespace LocalCompleteIntersection

/-- A Noetherian local ring is a complete intersection exactly when its completion is a complete
intersection complete local ring. Both conditions ask for a presentation of the completion by a
regular local ring whose kernel is generated by a regular sequence; the extra requirement that
the completion be a Noetherian complete local ring is automatic.

See [Stacks Project, Tag 09Q3](https://stacks.math.columbia.edu/tag/09Q3). -/
theorem isCompleteIntersectionRing_iff_adicCompletion (A : Type u) [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] :
    IsCompleteIntersectionRing A ↔
      IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal A) A) := by
  refine ⟨fun h ↦ ⟨⟨inferInstance, inferInstance, ?_⟩, h⟩, fun h ↦ h.2⟩
  exact AdicCompletion.isAdicComplete_of_fg (maximalIdeal A).fg_of_isNoetherianRing

variable (A : Type u) (B : Type v) [CommRing A] [CommRing B]
  [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
  [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B]

/-- **Stacks 09Q7.** For a flat local homomorphism `A → B` of Noetherian local rings, `B` is a
complete intersection if and only if `A` and the closed fibre `B / 𝔪_A B` are. -/
@[stacks 09Q7]
theorem isCompleteIntersectionRing_iff_of_flat :
    letI I := (maximalIdeal A).map (algebraMap A B)
    letI _ : Nontrivial (B ⧸ I) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (IsLocalRing.map_maximalIdeal_lt_top (algebraMap A B)).ne
    letI _ : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    letI _ : IsLocalRing (B ⧸ I) :=
      IsLocalRing.of_surjective _ Ideal.Quotient.mk_surjective
    IsCompleteIntersectionRing B ↔
      (IsCompleteIntersectionRing A ∧ IsCompleteIntersectionRing (B ⧸ I)) := by
  simp only [isCompleteIntersectionRing_iff_adicCompletion]
  exact isCompleteIntersectionCompleteLocalRing_adicCompletion_iff_of_flat A B

/-- For a flat local homomorphism `A → B` of Noetherian local rings, `A` is a complete
intersection as soon as `B` is. This is one half of [Stacks Project, Tag
09Q7](https://stacks.math.columbia.edu/tag/09Q7). -/
theorem isCompleteIntersectionRing_of_flat (hB : IsCompleteIntersectionRing B) :
    IsCompleteIntersectionRing A := by
  exact ((isCompleteIntersectionRing_iff_of_flat A B).mp hB).1

/-- For a flat local homomorphism `A → B` of Noetherian local rings, the closed fibre
`B / 𝔪_A B` is a complete intersection as soon as `B` is. This is the other half of [Stacks
Project, Tag 09Q7](https://stacks.math.columbia.edu/tag/09Q7). -/
theorem isCompleteIntersectionRing_quotient_of_flat (hB : IsCompleteIntersectionRing B) :
    letI I := (maximalIdeal A).map (algebraMap A B)
    letI _ : Nontrivial (B ⧸ I) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (IsLocalRing.map_maximalIdeal_lt_top (algebraMap A B)).ne
    letI _ : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    letI _ : IsLocalRing (B ⧸ I) :=
      IsLocalRing.of_surjective _ Ideal.Quotient.mk_surjective
    IsCompleteIntersectionRing (B ⧸ I) :=
  ((isCompleteIntersectionRing_iff_of_flat A B).mp hB).2

/-- Being a local complete intersection ring descends along a faithfully flat ring map of
Noetherian rings: a prime `p` of the source is the contraction of a prime `P` of the target, and
`R_p → S_P` is then a flat local homomorphism to a complete intersection. -/
theorem isLocalCompleteIntersectionRing_of_faithfullyFlat (R : Type u) (S : Type v) [CommRing R]
    [CommRing S] [Algebra R S] [IsNoetherianRing R] [IsNoetherianRing S]
    [Module.FaithfullyFlat R S] (hS : IsLocalCompleteIntersectionRing S) :
    IsLocalCompleteIntersectionRing R := by
  intro p hp
  obtain ⟨P, hP⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := S) ⟨p, hp⟩
  have : P.asIdeal.LiesOver p := ⟨(congrArg PrimeSpectrum.asIdeal hP).symm⟩
  let _ : Algebra (Localization.AtPrime p) (Localization.AtPrime P.asIdeal) :=
    Localization.AtPrime.algebraOfLiesOver p P.asIdeal
  let _ : Localization.AtPrime.IsLiesOverAlgebra p P.asIdeal := ⟨rfl⟩
  let _ : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime P.asIdeal)) :=
    Localization.isLocalHom_localRingHom p P.asIdeal (algebraMap R S) Ideal.LiesOver.over
  exact isCompleteIntersectionRing_of_flat (Localization.AtPrime p)
    (Localization.AtPrime P.asIdeal) (hS P.asIdeal)

/-- Being a local complete intersection over a field descends along a faithfully flat algebra:
for a tower `k → A → B` of finite type `k`-algebras with `B` faithfully flat over `A`, if `B` is
a local complete intersection over `k` then so is `A`.

See [Stacks Project, Tag 00S9](https://stacks.math.columbia.edu/tag/00S9) for the condition and
[Stacks Project, Tag 09Q6](https://stacks.math.columbia.edu/tag/09Q6) for its identification with
the absolute one used in the proof. -/
theorem isLocalCompleteIntersection_of_faithfullyFlat (k : Type u) [Field k] (A B : Type v)
    [CommRing A] [CommRing B] [Algebra k A] [Algebra k B] [Algebra A B] [IsScalarTower k A B]
    [Algebra.FiniteType k A] [Algebra.FiniteType k B] [Module.FaithfullyFlat A B]
    (hB : IsLocalCompleteIntersection k B) : IsLocalCompleteIntersection k A := by
  have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing k B
  rw [isLocalCompleteIntersection_iff_isLocalCompleteIntersectionRing] at hB ⊢
  exact isLocalCompleteIntersectionRing_of_faithfullyFlat A B hB

end LocalCompleteIntersection

end
