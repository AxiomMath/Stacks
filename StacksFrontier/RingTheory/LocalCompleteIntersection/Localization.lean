/-!
# Complete intersections and localization

A localization of a Noetherian local complete intersection ring at a prime is again a complete
intersection, and a Noetherian ring is a local complete intersection exactly when its
localizations at the maximal ideals are complete intersections.

The first statement is reduced to the flat local criterion: completing `A` at its maximal ideal
is faithfully flat, so a prime `𝔭` of `A` is dominated by a prime `𝔮` of `A^`, and a presentation
`R ↠ A^` localizes to a presentation `R_𝔮 ↠ (A^)_𝔮` whose kernel is generated by a regular
sequence because regular sequences localize. The quotient criterion for a regular ring then makes
`((A^)_𝔮)^` a complete intersection, and `A_𝔭 → (A^)_𝔮` is a flat local homomorphism, so the flat
local criterion makes `(A_𝔭)^` one as well.

For the second statement only primes have to be replaced by maximal ideals: every prime is
contained in a maximal ideal `𝔪`, and the localization of `A` at `𝔭` is the localization of
`A_𝔪` at the image of `𝔭`, which the first statement makes a complete intersection.

## Main results

* `LocalCompleteIntersection.isCompleteIntersectionRing_localizationAtPrime`: complete
  intersection rings stay complete intersections after localizing at a prime.
* `LocalCompleteIntersection.isLocalCompleteIntersectionRing_iff_localizationsAtMaximal`: the
  maximal-ideal criterion for being a local complete intersection.

## Implementation notes

The local rings are the canonical localizations `Localization.AtPrime`, and the complete
intersection conditions are the completion-based ones of
`StacksFrontier.RingTheory.LocalCompleteIntersection.Basic`.

## References

* [Stacks Project, Tag 09Q4](https://stacks.math.columbia.edu/tag/09Q4)
* [Stacks Project, Tag 09Q5](https://stacks.math.columbia.edu/tag/09Q5)
-/

@[expose] public section

namespace LocalCompleteIntersection

open IsLocalRing RingTheory.Sequence

universe u

/-- **Stacks 09Q4.** The localization of a Noetherian local complete intersection ring at a prime
ideal is a complete intersection ring. -/
@[stacks 09Q4]
theorem isCompleteIntersectionRing_localizationAtPrime
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (p : Ideal A) [p.IsPrime] (hA : IsCompleteIntersectionRing A) :
    IsCompleteIntersectionRing (Localization.AtPrime p) := by
  classical
  let C := AdicCompletion (maximalIdeal A) A
  obtain ⟨R, hR, hRreg, f, hf, hflocal, rs, hrs, hker⟩ := hA
  let : CommRing R := hR
  let : IsRegularLocalRing R := hRreg
  let : IsRegularRing R := ((IsLocalRing.isRegularRing_tfae (R := R)).out 1 3).mp hRreg
  let : Module.FaithfullyFlat A C :=
    AdicCompletion.faithfullyFlat_of_le_ringJacobson (maximalIdeal A)
      (by rw [IsLocalRing.ringJacobson_eq_maximalIdeal])
  obtain ⟨q, _, _⟩ := Ideal.exists_isPrime_liesOver_of_faithfullyFlat (A := A) (B := C) p
  let Q : Ideal R := q.comap f
  let Rp := Localization.AtPrime Q
  let B := Localization.AtPrime q
  have hM : Q.primeCompl.map f = q.primeCompl := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩ hx
      exact hy hx
    · intro hx
      obtain ⟨y, rfl⟩ := hf x
      exact ⟨y, hx, rfl⟩
  let : IsLocalization (Q.primeCompl.map f) B := hM.symm ▸ inferInstance
  let φ : Rp →+* B := IsLocalization.map B f (hM ▸ Submonoid.le_comap_map Q.primeCompl)
  have hIp : RingHom.ker f ≤ Q := Ideal.ker_le_comap f
  have hseq : ∃ xs : List Rp, IsRegular Rp xs ∧
      Ideal.ofList xs = (RingHom.ker f).map (algebraMap R Rp) := by
    refine ⟨rs.map (algebraMap R Rp),
      hrs.toIsWeaklyRegular.isRegular_of_isLocalization_of_mem Rp Q
        (fun x hx => hIp (hker ▸ Ideal.subset_span hx)), ?_⟩
    rw [← hker, Ideal.map_ofList]
  have hBcomplete : IsCompleteIntersectionCompleteLocalRing
      (AdicCompletion (maximalIdeal B) B) :=
    ((quotient_regular_ring_tfae Q (RingHom.ker f) hIp Rp B φ
      (IsLocalization.map_surjective_of_surjective _ _ _ hf)
      (IsLocalization.ker_map B f hM)).out 2 1 rfl rfl).mp hseq
  let P := Localization.AtPrime p
  let : Algebra P B := Localization.AtPrime.algebraOfLiesOver p q
  exact (isCompleteIntersectionCompleteLocalRing_adicCompletion_iff_of_flat P B
    |>.mp hBcomplete).1.2

/-- **Stacks 09Q5.** A Noetherian ring is a local complete intersection precisely when its
localizations at the maximal ideals are complete intersections. -/
@[stacks 09Q5]
theorem isLocalCompleteIntersectionRing_iff_localizationsAtMaximal
    (A : Type u) [CommRing A] [IsNoetherianRing A] :
    IsLocalCompleteIntersectionRing A ↔
      ∀ (m : Ideal A) [m.IsMaximal],
        IsCompleteIntersectionRing (Localization.AtPrime m) := by
  refine ⟨fun h m _ => h m, fun h p hp => ?_⟩
  obtain ⟨m, hm, hpm⟩ := p.exists_le_maximal hp.ne_top
  let q : Ideal (Localization.AtPrime m) := p.map (algebraMap A (Localization.AtPrime m))
  let : q.IsPrime := Ideal.isPrime_map_of_isLocalizationAtPrime m (p := p) hpm
  have hunder : q.comap (algebraMap A (Localization.AtPrime m)) = p := by
    simpa [q] using (Ideal.under_map_of_isLocalizationAtPrime m (p := p) hpm)
  have : IsLocalization.AtPrime (Localization.AtPrime q)
      (q.comap (algebraMap A (Localization.AtPrime m))) :=
    IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (m.primeCompl : Submonoid A) (Localization.AtPrime q) q
  have hcompl : p.primeCompl =
      (q.comap (algebraMap A (Localization.AtPrime m))).primeCompl := by
    ext
    simp [hunder]
  have : IsLocalization.AtPrime (Localization.AtPrime q) p := by
    change IsLocalization p.primeCompl (Localization.AtPrime q)
    rwa [hcompl]
  exact isCompleteIntersectionRing_of_ringEquiv
    (IsLocalization.algEquiv p.primeCompl
      (Localization.AtPrime p) (Localization.AtPrime q)).symm.toRingEquiv
    (isCompleteIntersectionRing_localizationAtPrime _ q (h m))

end LocalCompleteIntersection

end
