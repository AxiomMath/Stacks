private theorem exists_regular_generators_map_iff
    {R S : Type*} [CommRing R] [CommRing S] [IsNoetherianRing R] [IsNoetherianRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Module.FaithfullyFlat R S] (I : Ideal R) :
    (∃ xs : List S, IsRegular S xs ∧ Ideal.ofList xs = I.map (algebraMap R S)) ↔
      ∃ xs : List R, IsRegular R xs ∧ Ideal.ofList xs = I := by
  constructor
  · intro h
    obtain ⟨xs, hlen, hgen⟩ := exists_list_spanFinrank I (IsNoetherian.noetherian I)
    have hmap : Ideal.ofList (xs.map (algebraMap R S)) = I.map (algebraMap R S) := by
      rw [← Ideal.map_ofList, hgen]
    have hlenmap : (xs.map (algebraMap R S)).length =
        (I.map (algebraMap R S)).spanFinrank := by
      rw [List.length_map, hlen,
        Stacks.CompleteIntersection.BaseChange.spanFinrank_map_of_flat_of_isLocalHom I
          (IsNoetherian.noetherian I)]
    have hx := isRegular_of_minimal_generators _ _ hmap hlenmap h
    exact ⟨xs, (isRegular_map_algebraMap_iff_of_faithfullyFlat_of_isBaseChange
      (IsBaseChange.linearMap R S) xs).mp hx, hgen⟩
  · rintro ⟨xs, hx, hgen⟩
    exact ⟨xs.map (algebraMap R S), hx.of_faithfullyFlat,
      by rw [← Ideal.map_ofList, hgen]⟩

private theorem regular_kernel_of_equiv
    {R S B : Type*} [CommRing R] [CommRing S] [CommRing B]
    (e : R ≃+* S) (g : S →+* B)
    (h : ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker g) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker (g.comp e) := by
  obtain ⟨rs, hrs, hgen⟩ := h
  refine ⟨rs.map e.symm, ?_, ?_⟩
  · exact (isRegular_map_ringEquiv_iff e.symm rs).mpr hrs
  · show Ideal.ofList (rs.map e.symm.toRingHom) = _
    rw [← Ideal.map_ofList, hgen]
    ext x
    rw [Ideal.mem_map_iff_of_surjective e.symm.toRingHom e.symm.surjective]
    simp only [RingHom.mem_ker, RingHom.coe_comp, Function.comp_apply,
      RingEquiv.coe_toRingHom]
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa using hy
    · intro hx
      exact ⟨e x, hx, e.symm_apply_apply x⟩

private theorem goodFactorization_of_equiv
    {A B R S : Type*} [CommRing A] [CommRing B] [CommRing R] [CommRing S]
    [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing R] [IsLocalRing R]
    [IsNoetherianRing S] [IsLocalRing S]
    (h : A →+* B) (f : A →+* R) (g : R →+* B) (e : R ≃+* S)
    (hgood : IsGoodFactorization h f g) :
    IsGoodFactorization h (e.toRingHom.comp f) (g.comp e.symm.toRingHom) := by
  obtain ⟨hc, hf, hg, hsurj, hflat, hreg⟩ := hgood
  have : IsLocalHom f := hf
  have : IsLocalHom g := hg
  have : IsLocalHom e.toRingHom := isLocalHom_of_leftInverse e.symm e.left_inv
  have : IsLocalHom e.symm.toRingHom := isLocalHom_of_leftInverse e e.right_inv
  have : IsRegularLocalRing (R ⧸ (maximalIdeal A).map f) := hreg
  refine ⟨?_, inferInstance, inferInstance, hsurj.comp e.symm.surjective,
    hflat.comp (RingHom.Flat.of_bijective e.bijective), ?_⟩
  · ext a
    simpa using RingHom.congr_fun hc a
  · exact IsRegularLocalRing.of_ringEquiv
      (Ideal.quotientEquiv ((maximalIdeal A).map f)
        ((maximalIdeal A).map (e.toRingHom.comp f)) e (Ideal.map_map _ _).symm)

private theorem exists_complete_goodFactorization
    {A B S : Type*} [CommRing A] [CommRing B] [CommRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing S] [IsNoetherianRing S]
    [IsAdicComplete (maximalIdeal B) B]
    (h : A →+* B) (f : A →+* S) (g : S →+* B) (hg : IsGoodFactorization h f g) :
    ∃ (p : AdicCompletion (maximalIdeal S) S →+* B),
      IsGoodFactorization h ((algebraMap S (AdicCompletion (maximalIdeal S) S)).comp f) p ∧
      ((∃ xs : List S, IsRegular S xs ∧ Ideal.ofList xs = RingHom.ker g) ↔
        ∃ xs : List (AdicCompletion (maximalIdeal S) S),
          IsRegular (AdicCompletion (maximalIdeal S) S) xs ∧ Ideal.ofList xs = RingHom.ker p) := by
  obtain ⟨hc, hf, hg, hsurj, hflat, hreg⟩ := hg
  have : IsLocalHom f := hf
  have : IsLocalHom g := hg
  let T := AdicCompletion (maximalIdeal S) S
  let K := RingHom.ker g
  let e : S ⧸ K ≃+* B := RingHom.quotientKerEquivOfSurjective hsurj
  have : IsLocalRing (S ⧸ K) := e.symm.isLocalRing
  have : IsAdicComplete (maximalIdeal (S ⧸ K)) (S ⧸ K) := by
    rw [← IsLocalRing.map_ringEquiv_maximalIdeal e.symm]
    exact (IsAdicComplete.congr_ringEquiv (maximalIdeal B) e.symm).2 inferInstance
  let eC := (AdicCompletion.ofAlgEquiv (maximalIdeal (S ⧸ K))).symm.toRingEquiv.trans e
  let p : T →+* B := eC.toRingHom.comp (adicCompletionMapQuotient K)
  have hp : Function.Surjective p := eC.surjective.comp (adicCompletionMapQuotient_surjective K)
  have hpc (s : S) : p (algebraMap S T s) = g s := by
    show eC (adicCompletionMapQuotient K (algebraMap S T s)) = g s
    rw [completionQuotientMap_algebraMap]
    show e ((AdicCompletion.ofAlgEquiv (maximalIdeal (S ⧸ K))).symm
      (AdicCompletion.of (maximalIdeal (S ⧸ K)) (S ⧸ K) (Ideal.Quotient.mk K s))) = g s
    rw [AdicCompletion.ofAlgEquiv_symm_of]
    exact RingHom.quotientKerEquivOfSurjective_apply_mk hsurj s
  have hpk : RingHom.ker p = K.map (algebraMap S T) := by
    rw [← ker_adicCompletionMapQuotient K]
    ext x
    exact map_eq_zero_iff eC eC.injective
  have : Module.FaithfullyFlat S T :=
    AdicCompletion.faithfullyFlat_of_le_ringJacobson (maximalIdeal S)
      (by rw [IsLocalRing.ringJacobson_eq_maximalIdeal])
  have : IsLocalHom p := IsLocalHom.of_surjective p hp
  have hgood : IsGoodFactorization h ((algebraMap S T).comp f) p := by
    refine ⟨?_, inferInstance, inferInstance, hp,
      hflat.comp (RingHom.flat_algebraMap_iff.mpr inferInstance), ?_⟩
    · ext a
      exact (hpc (f a)).trans (RingHom.congr_fun hc a)
    · let I := (maximalIdeal A).map f
      have : IsRegularLocalRing (S ⧸ I) := hreg
      have : IsRegularLocalRing (AdicCompletion (maximalIdeal (S ⧸ I)) (S ⧸ I)) :=
        isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp inferInstance
      rw [← Ideal.map_map]
      have he : T ⧸ I.map (algebraMap S T) ≃+*
          AdicCompletion (maximalIdeal (S ⧸ I)) (S ⧸ I) := by
        rw [← ker_adicCompletionMapQuotient I]
        exact RingHom.quotientKerEquivOfSurjective (adicCompletionMapQuotient_surjective I)
      exact IsRegularLocalRing.of_ringEquiv he.symm
  exact ⟨p, hgood, by rw [hpk]; exact (exists_regular_generators_map_iff K).symm⟩

private theorem exists_goodFactorization_of_presentation
    {A : Type u} {B : Type v} {R S : Type (max u v)}
    [CommRing A] [CommRing B] [CommRing R] [CommRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing R] [IsLocalRing S]
    [IsNoetherianRing S]
    (h : A →+* B) [IsLocalHom h]
    (g : R →+* S) (qA : R →+* A) (qB : S →+* B)
    (hqA : Function.Surjective qA) (hqB : Function.Surjective qB)
    [IsLocalHom g] (hcomm : h.comp qA = qB.comp g)
    (hflat : g.Flat) (hreg : IsRegularLocalRing (S ⧸ (maximalIdeal R).map g)) :
    ∃ (T : Type (max u v)) (_ : CommRing T) (_ : IsNoetherianRing T)
      (_ : IsLocalRing T) (f : A →+* T) (p : T →+* B), IsGoodFactorization h f p := by
  let : Algebra R S := g.toAlgebra
  let K := RingHom.ker qA
  let I := K.map (algebraMap R S)
  let T := S ⧸ I
  have hIK : I ≤ RingHom.ker qB := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    show qB (g x) = 0
    rw [← RingHom.comp_apply, ← hcomm, RingHom.comp_apply]
    exact (congrArg h hx).trans (map_zero h)
  let p : T →+* B := Ideal.Quotient.lift I qB hIK
  have hp : Function.Surjective p := by
    intro b
    obtain ⟨s, rfl⟩ := hqB b
    exact ⟨Ideal.Quotient.mk I s, rfl⟩
  have : Nontrivial T := p.domain_nontrivial
  have : IsLocalRing T := IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective
  have : IsLocalHom p := IsLocalHom.of_surjective p hp
  let e := RingHom.quotientKerEquivOfSurjective hqA
  let : Algebra (R ⧸ K) T := Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
  let f₀ : R ⧸ K →+* T := algebraMap (R ⧸ K) T
  let f : A →+* T := f₀.comp e.symm.toRingHom
  have hfq : f.comp qA = (Ideal.Quotient.mk I).comp g := by
    ext x
    show f₀ (e.symm (qA x)) = _
    rw [RingHom.quotientKerEquivOfSurjective_symm_apply]
    rfl
  have hpf : p.comp f = h := by
    refine RingHom.ext fun a => ?_
    obtain ⟨r, rfl⟩ := hqA a
    show p ((f.comp qA) r) = h (qA r)
    rw [hfq]
    exact (RingHom.congr_fun hcomm r).symm
  have : IsLocalHom f := by
    have : IsLocalHom (p.comp f) := hpf ▸ inferInstance
    exact isLocalHom_of_comp f p
  have : Module.Flat R S := hflat
  have hflat₀ : f₀.Flat := by
    show (algebraMap (R ⧸ K) T).Flat
    rw [RingHom.flat_algebraMap_iff]
    exact Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S K).toLinearEquiv
  have hfFlat : f.Flat := (RingHom.Flat.of_bijective e.symm.bijective).comp hflat₀
  have hmax : (maximalIdeal A).map f =
      ((maximalIdeal R).map g).map (Ideal.Quotient.mk I) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective qA hqA, Ideal.map_map, hfq,
      ← Ideal.map_map]
  have hIle : I ≤ (maximalIdeal R).map g :=
    Ideal.map_mono (IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top qA))
  let eF : T ⧸ (maximalIdeal A).map f ≃+* S ⧸ (maximalIdeal R).map g := by
    rw [hmax]
    exact DoubleQuot.quotQuotEquivQuotOfLE hIle
  have : IsRegularLocalRing (S ⧸ (maximalIdeal R).map g) := hreg
  exact ⟨T, inferInstance, inferInstance, inferInstance, f, p,
    hpf, inferInstance, inferInstance, hp, hfFlat,
    IsRegularLocalRing.of_ringEquiv eF.symm⟩

private theorem exists_goodFactorization
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [IsAdicComplete (maximalIdeal A) A] [IsAdicComplete (maximalIdeal B) B]
    (h : A →+* B) [IsLocalHom h] :
    ∃ (S : Type (max u v)) (_ : CommRing S) (_ : IsNoetherianRing S)
      (_ : IsLocalRing S) (f : A →+* S) (g : S →+* B), IsGoodFactorization h f g := by
  obtain ⟨R, S, _, _, _, _, _, _, g, qA, qB, hqA, hqB, hg, _, _, hc, _, hf, hr⟩ :=
    exists_powerSeries_presentation_of_isLocalHom h
  have : IsLocalHom g := hg
  exact exists_goodFactorization_of_presentation h g qA qB hqA hqB hc hf hr

private theorem span_range_mkQ_eq_top {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    (T : Submodule A M) {ι : Type*} (y : ι → M) (hy : Submodule.span A (Set.range y) = ⊤) :
    Submodule.span A (Set.range fun i => T.mkQ (y i)) = ⊤ := by
  have h1 : (Set.range fun i => T.mkQ (y i)) = T.mkQ '' Set.range y := by
    rw [← Set.range_comp]; rfl
  rw [h1, ← Submodule.map_span, hy, Submodule.map_top, Submodule.range_mkQ]

private theorem exists_minimal_generators_append
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (I : Ideal R) (xs : List R) (x : Fin xs.length → I)
    (hx : ∀ i, (x i : R) = xs[i.val])
    (hli : LinearIndependent (R ⧸ maximalIdeal R)
      (fun i => (maximalIdeal R • ⊤ : Submodule R I).mkQ (x i))) :
    ∃ ys : List R, Ideal.ofList (xs ++ ys) = I ∧ (xs ++ ys).length = I.spanFinrank := by
  classical
  let : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field _
  let k := R ⧸ maximalIdeal R
  let N : Submodule R I := maximalIdeal R • ⊤
  let V := I ⧸ N
  have := Stacks.RegularLocalRing.KernelRegularity.isScalarTower_quotient_smul_top (M := I)
    (maximalIdeal R)
  have : Module.Finite k V := Module.Finite.of_restrictScalars_finite R k V
  have hdim : Module.finrank k V = I.spanFinrank :=
    (IsLocalRing.spanFinrank_eq_finrank_quotient I (IsNoetherian.noetherian I)).symm
  have hle : xs.length ≤ I.spanFinrank := by
    have he : xs.length ≤ Module.finrank k V := by
      simpa only [Fintype.card_fin] using hli.fintype_card_le_finrank
    exact he.trans_eq hdim
  obtain ⟨b, hb⟩ := Stacks.RegularLocalRing.RegularQuotient.exists_span_range_union_range_eq_top
    (K := R ⧸ maximalIdeal R) hli
  let y : Fin (Module.finrank k V - xs.length) → I :=
    fun j => Function.surjInv N.mkQ_surjective (b j)
  have hy (j) : N.mkQ (y j) = b j := Function.surjInv_eq N.mkQ_surjective (b j)
  let L := Submodule.span R (Set.range x ∪ Set.range y)
  have hmap : L.map N.mkQ = ⊤ := by
    rw [Submodule.map_span, Set.image_union, ← Set.range_comp, ← Set.range_comp]
    have hy' : N.mkQ ∘ y = b := funext hy
    rw [hy', ← Submodule.restrictScalars_span R k
      (Stacks.RegularLocalRing.KernelRegularity.surjective_algebraMap_quotient _)]
    exact congrArg (Submodule.restrictScalars R) hb
  have hc := Submodule.comap_map_eq N.mkQ L
  rw [hmap, Submodule.comap_top, Submodule.ker_mkQ] at hc
  have htop : L = ⊤ := top_le_iff.mp <| Submodule.le_of_le_smul_of_le_jacobson_bot
    ((Submodule.fg_top I).mpr (IsNoetherian.noetherian I))
    (IsLocalRing.maximalIdeal_le_jacobson ⊥) hc.le
  let ys := List.ofFn (fun j => (y j : R))
  refine ⟨ys, ?_, ?_⟩
  · have hl := congrArg (Submodule.map I.subtype) htop
    rw [Submodule.map_span, Submodule.map_subtype_top, Set.image_union,
      ← Set.range_comp, ← Set.range_comp] at hl
    have hx' : Set.range (I.subtype ∘ x) = {a | a ∈ xs} := by
      ext a
      simp only [Set.mem_range, Function.comp_apply, Submodule.subtype_apply,
        Set.mem_ofPred_eq, List.mem_iff_getElem]
      exact ⟨fun ⟨i, hi⟩ => ⟨i, i.isLt, (hx i).symm.trans hi⟩,
        fun ⟨i, hi, he⟩ => ⟨⟨i, hi⟩, (hx ⟨i, hi⟩).trans he⟩⟩
    have hy' : Set.range (I.subtype ∘ y) = {a | a ∈ ys} := by
      ext a
      simp [ys, Function.comp_def]
    rw [hx', hy'] at hl
    simpa only [Ideal.ofList, List.mem_append, Set.ofPred_or] using hl
  · simp only [List.length_append, ys, List.length_ofFn, hdim]
    omega


private theorem linearIndependent_mkQ_of_local_semilinear
    {R F M N ι : Type*} [CommRing R] [CommRing F] [IsLocalRing R] [IsLocalRing F]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module F N]
    (p : R →+* F) [IsLocalHom p] (f : M →ₛₗ[p] N) (x : ι → M)
    (hli : LinearIndependent (F ⧸ maximalIdeal F)
      (fun i => (maximalIdeal F • ⊤ : Submodule F N).mkQ (f (x i)))) :
    LinearIndependent (R ⧸ maximalIdeal R)
      (fun i => (maximalIdeal R • ⊤ : Submodule R M).mkQ (x i)) := by
  classical
  let MR : Submodule R M := maximalIdeal R • ⊤
  let NF : Submodule F N := maximalIdeal F • ⊤
  have := Stacks.RegularLocalRing.KernelRegularity.isScalarTower_quotient_smul_top (M := M)
    (maximalIdeal R)
  have := Stacks.RegularLocalRing.KernelRegularity.isScalarTower_quotient_smul_top (M := N)
    (maximalIdeal F)
  have hle : MR ≤ NF.comap f := by
    intro z hz
    show f z ∈ NF
    refine Submodule.smul_induction_on hz ?_ ?_
    · intro r hr n hn
      show f (r • n) ∈ NF
      rw [map_smulₛₗ]
      exact Submodule.smul_mem_smul
        ((map_maximalIdeal_le p) (Ideal.mem_map_of_mem p hr)) Submodule.mem_top
    · intro z w hz hw
      rw [map_add]
      exact NF.add_mem hz hw
  let fbar := MR.mapQ NF f hle
  apply linearIndependent_iff'.mpr
  intro s c hc i hi
  let a : ι → R := fun j => Function.surjInv (Ideal.Quotient.mk_surjective) (c j)
  have ha (j) : Ideal.Quotient.mk (maximalIdeal R) (a j) = c j :=
    Function.surjInv_eq Ideal.Quotient.mk_surjective (c j)
  have hsR (r : R) (z : M ⧸ MR) :
      Ideal.Quotient.mk (maximalIdeal R) r • z = r • z :=
    IsScalarTower.algebraMap_smul (R ⧸ maximalIdeal R) r z
  have hsF (r : F) (z : N ⧸ NF) :
      Ideal.Quotient.mk (maximalIdeal F) r • z = r • z :=
    IsScalarTower.algebraMap_smul (F ⧸ maximalIdeal F) r z
  have hc' : ∑ j ∈ s, a j • MR.mkQ (x j) = 0 := by
    simpa only [← hsR, ha] using hc
  have hfzero := congrArg fbar hc'
  simp only [map_sum, map_smulₛₗ, map_zero] at hfzero
  have hzero : ∑ j ∈ s, Ideal.Quotient.mk (maximalIdeal F) (p (a j)) •
      NF.mkQ (f (x j)) = 0 := by
    simpa only [hsF, fbar, Submodule.mkQ_apply, Submodule.mapQ_apply] using hfzero
  have hci := (linearIndependent_iff'.mp hli s _ hzero) i hi
  rw [← ha i, Ideal.Quotient.eq_zero_iff_mem]
  have hmem := Ideal.Quotient.eq_zero_iff_mem.mp hci
  change a i ∈ (maximalIdeal F).comap p at hmem
  rwa [maximalIdeal_comap] at hmem


private theorem regular_kernel_of_minimal_append
    {T S B : Type*} [CommRing T] [CommRing S] [CommRing B]
    [IsNoetherianRing T] [IsLocalRing T]
    (q : T →+* S) (g : S →+* B) (hq : Function.Surjective q)
    (xs ys : List T) (hxs : Ideal.ofList xs = RingHom.ker q)
    (hgen : Ideal.ofList (xs ++ ys) = RingHom.ker (g.comp q))
    (hlen : (xs ++ ys).length = (RingHom.ker (g.comp q)).spanFinrank)
    (hreg : ∃ zs : List T, IsRegular T zs ∧ Ideal.ofList zs = RingHom.ker (g.comp q)) :
    ∃ zs : List S, IsRegular S zs ∧ Ideal.ofList zs = RingHom.ker g := by
  have hr := isRegular_of_minimal_generators _ _ hgen hlen hreg
  have hy := ((isRegular_append_iff_ofList_quotient xs ys).mp hr).2
  rw [hxs] at hy
  let e := RingHom.quotientKerEquivOfSurjective hq
  have he : (ys.map (Ideal.Quotient.mk (RingHom.ker q))).map e = ys.map q := by
    rw [List.map_map]
    exact List.map_congr_left fun x _ => RingHom.quotientKerEquivOfSurjective_apply_mk hq x
  have hy' : IsRegular S ((ys.map (Ideal.Quotient.mk (RingHom.ker q))).map e) :=
    (isRegular_map_ringEquiv_iff e _).mpr hy
  rw [he] at hy'
  refine ⟨ys.map q, hy', ?_⟩
  have hzero : (RingHom.ker q).map q = ⊥ := by
    rw [RingHom.ker_eq_comap_bot, Ideal.map_comap_of_surjective q hq]
  have hmap := congrArg (Ideal.map q) hgen
  rw [Ideal.ofList_append, Ideal.map_sup, hxs, hzero, bot_sup_eq,
    Ideal.map_ofList] at hmap
  rw [hmap]
  exact Ideal.map_comap_of_surjective q hq (RingHom.ker g)

private theorem exists_minimal_generators_append_of_regular_fibre
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (I K L : Ideal R) [IsRegularLocalRing (R ⧸ I)]
    (hquot : IsRegularLocalRing ((R ⧸ I) ⧸ K.map (Ideal.Quotient.mk I)))
    (hI : I ≤ maximalIdeal R) (hKL : K ≤ L) (hL : L ≤ maximalIdeal R)
    (hinter : K ⊓ I = I * K) :
    ∃ xs ys : List R, Ideal.ofList xs = K ∧ Ideal.ofList (xs ++ ys) = L ∧
      (xs ++ ys).length = L.spanFinrank := by
  let p : R →+* R ⧸ I := Ideal.Quotient.mk I
  have : IsLocalHom p := IsLocalHom.of_surjective p Ideal.Quotient.mk_surjective
  obtain ⟨bs, hbs, hblen, c, hc, hbK, _⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
      (K.map p) hquot
  obtain ⟨xs, hxsmap, hxsgen⟩ := exists_list_lifting_generators I K hI (bs.take c) hbK hinter
  have hlen : xs.length = c := by
    simpa only [List.length_map, List.length_take, Nat.min_eq_left hc] using
      congrArg List.length hxsmap
  let x : Fin xs.length → L := fun i =>
    ⟨xs[i.val], by
      apply hKL
      rw [← hxsgen]
      exact Ideal.subset_span (List.getElem_mem i.isLt)⟩
  let b : Fin bs.length → maximalIdeal (R ⧸ I) := fun i =>
    ⟨bs[i.val], by
      rw [← hbs]
      exact Ideal.subset_span (List.getElem_mem i.isLt)⟩
  let f : L →ₛₗ[p] maximalIdeal (R ⧸ I) :=
    { toFun := fun a =>
        ⟨p (a : R), (map_maximalIdeal_le p) (Ideal.mem_map_of_mem p (hL a.property))⟩
      map_add' := fun a b => Subtype.ext (map_add p (a : R) (b : R))
      map_smul' := fun r a => Subtype.ext (map_mul p r (a : R)) }
  have hbound : xs.length ≤ bs.length := hlen ▸ hc
  have hfx (i : Fin xs.length) : f (x i) = b (Fin.castLE hbound i) := by
    apply Subtype.ext
    show p (xs[i.val]) = bs[i.val]
    have he := congrArg (fun l : List (R ⧸ I) => l[i.val]?) hxsmap
    simpa only [List.getElem?_map, List.getElem?_eq_getElem i.isLt, Option.map_some,
      List.getElem?_take, show i.val < c from hlen ▸ i.isLt, ↓reduceIte,
      List.getElem?_eq_getElem (lt_of_lt_of_le i.isLt hbound), Option.some.injEq] using he
  have hli : LinearIndependent (R ⧸ maximalIdeal R)
      (fun i => (maximalIdeal R • ⊤ : Submodule R L).mkQ (x i)) := by
    apply linearIndependent_mkQ_of_local_semilinear p f x
    have hb :=
      Stacks.RegularLocalRing.KernelRegularity.linearIndependent_mkQ_of_length_eq_spanFinrank bs
        hbs hblen b (fun _ => rfl)
    have he : (fun i => (maximalIdeal (R ⧸ I) • ⊤ :
        Submodule (R ⧸ I) (maximalIdeal (R ⧸ I))).mkQ (f (x i))) =
        (fun j => (maximalIdeal (R ⧸ I) • ⊤ :
          Submodule (R ⧸ I) (maximalIdeal (R ⧸ I))).mkQ (b j)) ∘ Fin.castLE hbound := by
      funext i
      rw [hfx]
      rfl
    rw [he]
    exact hb.comp _ (Fin.castLE_injective hbound)
  obtain ⟨ys, hygen, hylen⟩ := exists_minimal_generators_append L xs x (fun _ => rfl) hli
  exact ⟨xs, ys, hxsgen, hygen, hylen⟩

private theorem regular_kernel_comp_iff_of_goodFactorization
    {A S T B : Type*} [CommRing A] [CommRing S] [CommRing T] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing S] [IsNoetherianRing T]
    [IsLocalRing A] [IsLocalRing S] [IsLocalRing T] [IsLocalRing B]
    (h : A →+* B) (fS : A →+* S) (fT : A →+* T) (g : S →+* B)
    (q : T →+* S) (hq : Function.Surjective q) (hqf : q.comp fT = fS)
    (hS : IsGoodFactorization h fS g) (hT : IsGoodFactorization h fT (g.comp q)) :
    (∃ xs : List S, IsRegular S xs ∧ Ideal.ofList xs = RingHom.ker g) ↔
      ∃ xs : List T, IsRegular T xs ∧ Ideal.ofList xs = RingHom.ker (g.comp q) := by
  let : Algebra A S := fS.toAlgebra
  let : Algebra A T := fT.toAlgebra
  have : IsLocalHom (algebraMap A S) := hS.2.1
  have : IsLocalHom (algebraMap A T) := hT.2.1
  have : Module.Flat A S := hS.2.2.2.2.1
  have : Module.Flat A T := hT.2.2.2.2.1
  have : IsRegularLocalRing (S ⧸ (maximalIdeal A).map (algebraMap A S)) := hS.2.2.2.2.2
  have : IsRegularLocalRing (T ⧸ (maximalIdeal A).map (algebraMap A T)) := hT.2.2.2.2.2
  let φ : T →ₐ[A] S := { __ := q, commutes' a := RingHom.congr_fun hqf a }
  have hinter := ker_inf_map_maximalIdeal_eq_mul φ hq
  constructor
  · exact fun hreg => exists_regular_kernel_comp_of_surjective_regular_kernels q g hq hreg
      (exists_regular_kernel_of_surj_regular_fibres φ hq)
  · intro hreg
    let I : Ideal T := (maximalIdeal A).map (algebraMap A T)
    let K : Ideal T := RingHom.ker q
    obtain ⟨ψ, hψsurj, hψker⟩ := exists_surjective_fibre_map φ hq
    have hquot : IsRegularLocalRing ((T ⧸ I) ⧸ K.map (Ideal.Quotient.mk I)) := by
      rw [← hψker]
      exact IsRegularLocalRing.of_ringEquiv (RingHom.quotientKerEquivOfSurjective hψsurj).symm
    have hKL : K ≤ RingHom.ker (g.comp q) := by
      intro x hx
      show g (q x) = 0
      rw [show q x = 0 from hx, map_zero]
    obtain ⟨xs, ys, hx, hxy, hlen⟩ :=
      exists_minimal_generators_append_of_regular_fibre I K (RingHom.ker (g.comp q)) hquot
        (map_maximalIdeal_le (algebraMap A T)) hKL (le_maximalIdeal (RingHom.ker_ne_top _)) hinter
    exact regular_kernel_of_minimal_append q g hq xs ys hx hxy hlen hreg

private theorem exists_common_goodFactorization
    {A : Type u} {B : Type v} {S T : Type w}
    [CommRing A] [CommRing B] [CommRing S] [CommRing T]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsNoetherianRing S] [IsNoetherianRing T]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing S] [IsLocalRing T]
    [IsAdicComplete (maximalIdeal A) A] [IsAdicComplete (maximalIdeal B) B]
    [IsAdicComplete (maximalIdeal S) S] [IsAdicComplete (maximalIdeal T) T]
    (h : A →+* B) [IsLocalHom h]
    (fS : A →+* S) (gS : S →+* B) (fT : A →+* T) (gT : T →+* B)
    (hS : IsGoodFactorization h fS gS) (hT : IsGoodFactorization h fT gT) :
    ∃ (P : Type (max u w)) (_ : CommRing P) (_ : IsNoetherianRing P)
      (_ : IsLocalRing P) (f : A →+* P) (qS : P →+* S) (qT : P →+* T),
      IsGoodFactorization h f (gS.comp qS) ∧
      Function.Surjective qS ∧ Function.Surjective qT ∧
      qS.comp f = fS ∧ qT.comp f = fT ∧ gS.comp qS = gT.comp qT := by
  have : IsLocalHom fS := hS.2.1
  have : IsLocalHom gS := hS.2.2.1
  have : IsLocalHom gT := hT.2.2.1
  obtain ⟨hloc, hn, hcomplete⟩ := isNoetherianCompleteLocalRing_pullback gS gT
    hS.2.2.2.1 hT.2.2.2.1
  let U := gS.pullback gT
  have : IsLocalRing U := hloc
  have : IsNoetherianRing U := hn
  have : IsAdicComplete (maximalIdeal U) U := hcomplete
  let H : A →+* U := (fS.prod fT).codRestrict U (fun a =>
    (RingHom.congr_fun hS.1 a).trans (RingHom.congr_fun hT.1 a).symm)
  have hHS : (gS.pullbackFst gT).comp H = fS := rfl
  have hHT : (gS.pullbackSnd gT).comp H = fT := rfl
  have : IsLocalHom H := by
    have : IsLocalHom ((gS.pullbackFst gT).comp H) := hHS ▸ inferInstance
    exact isLocalHom_of_comp H (gS.pullbackFst gT)
  obtain ⟨P, _, _, _, f, p, hp⟩ := exists_goodFactorization H
  let qS := (gS.pullbackFst gT).comp p
  let qT := (gS.pullbackSnd gT).comp p
  have hqS : Function.Surjective qS :=
    (RingHom.surjective_pullbackFst_of_surjective gS gT hT.2.2.2.1).comp hp.2.2.2.1
  have hqT : Function.Surjective qT :=
    (RingHom.surjective_pullbackSnd_of_surjective gS gT hS.2.2.2.1).comp hp.2.2.2.1
  have hqSf : qS.comp f = fS := by
    show (gS.pullbackFst gT).comp (p.comp f) = fS
    rw [hp.1, hHS]
  have hqTf : qT.comp f = fT := by
    show (gS.pullbackSnd gT).comp (p.comp f) = fT
    rw [hp.1, hHT]
  have hc : gS.comp qS = gT.comp qT := by
    ext x
    exact (p x).property
  refine ⟨P, inferInstance, inferInstance, inferInstance, f, qS, qT,
    ⟨?_, hp.2.1, IsLocalHom.of_surjective _ (hS.2.2.2.1.comp hqS),
      hS.2.2.2.1.comp hqS, hp.2.2.2.2⟩, hqS, hqT, hqSf, hqTf, hc⟩
  show gS.comp (qS.comp f) = h
  rw [hqSf, hS.1]

/-- For a local homomorphism of Noetherian complete local rings, the kernel is generated by a
regular sequence in one good factorization if and only if it is so generated in every good
factorization. -/
@[stacks 09QA]
public theorem isCompleteIntersectionHom_iff_forall_goodFactorization
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [IsAdicComplete (maximalIdeal A) A] [IsAdicComplete (maximalIdeal B) B]
    (h : A →+* B) [IsLocalHom h] :
    IsCompleteIntersectionHom h ↔
      ∀ (S : Type (max u v w)) [CommRing S] [IsNoetherianRing S] [IsLocalRing S]
        (f : A →+* S) (g : S →+* B),
        IsGoodFactorization h f g → (RingHom.ker g).IsGeneratedByRegularSequence := by
  constructor
  · intro hCI S _ _ _ f g hgood
    obtain ⟨R, _, _, _, fR, gR, hR, hregR⟩ := hCI
    let e : R ≃+* ULift.{w} R := ULift.ringEquiv.symm
    have : IsLocalRing (ULift.{w} R) := e.isLocalRing
    have : IsNoetherianRing (ULift.{w} R) := isNoetherianRing_of_ringEquiv R e
    let fL := e.toRingHom.comp fR
    let gL := gR.comp (e.symm : ULift.{w} R →+* R)
    have hL : IsGoodFactorization h fL gL := goodFactorization_of_equiv h fR gR e hR
    have hregL := regular_kernel_of_equiv e.symm gR hregR
    obtain ⟨gLC, hLC, hLCreg⟩ := exists_complete_goodFactorization h fL gL hL
    obtain ⟨gSC, hSC, hSCreg⟩ := exists_complete_goodFactorization h f g hgood
    apply hSCreg.mpr
    have hregLC := hLCreg.mp hregL
    obtain ⟨P, _, _, _, fP, qR, qS, hP, hqR, hqS, hqRf, hqSf, hcomm⟩ :=
      exists_common_goodFactorization h _ gLC _ gSC hLC hSC
    have hregP := (regular_kernel_comp_iff_of_goodFactorization h _ fP gLC qR hqR hqRf
      hLC hP).mp hregLC
    rw [hcomm] at hP hregP
    exact (regular_kernel_comp_iff_of_goodFactorization h _ fP gSC qS hqS hqSf hSC hP).mpr hregP
  · intro hall
    obtain ⟨S, _, _, _, f, g, hgood⟩ := exists_goodFactorization h
    let e : S ≃+* ULift.{w} S := ULift.ringEquiv.symm
    have : IsLocalRing (ULift.{w} S) := e.isLocalRing
    have : IsNoetherianRing (ULift.{w} S) := isNoetherianRing_of_ringEquiv S e
    have hgood' := goodFactorization_of_equiv h f g e hgood
    have hreg := hall (ULift.{w} S) (e.toRingHom.comp f)
      (g.comp e.symm.toRingHom) hgood'
    refine ⟨S, inferInstance, inferInstance, inferInstance, f, g, hgood, ?_⟩
    have he : (g.comp e.symm.toRingHom).comp (e : S →+* ULift.{w} S) = g := by
      ext x
      simp
    -- `Ideal.IsGeneratedByRegularSequence` is a `def`, so `simp` will not unfold it; state the
    -- transported fact at the folded type and rewrite there.
    have hker : (RingHom.ker
        ((g.comp e.symm.toRingHom).comp (e : S →+* ULift.{w} S))).IsGeneratedByRegularSequence :=
      regular_kernel_of_equiv e (g.comp e.symm.toRingHom) hreg
    simpa only [he] using hker


end LocalCompleteIntersection

