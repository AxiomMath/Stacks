/-!
# Complete intersection homomorphisms of complete local rings

A *good factorization* of a local homomorphism `A → B` of Noetherian local rings is a
factorization `A → S → B` through a Noetherian local ring `S` with `A → S` flat, `S → B`
surjective and the closed fibre `S / 𝔪_A S` a regular local ring.  By the Cohen structure
theorem such a factorization always exists when `A` and `B` are complete, and `A → B` is called a
*complete intersection homomorphism* when the kernel of `S → B` is generated by a regular
sequence for some good factorization.  The main result of this file is that this does not depend
on the factorization chosen.

The proof first replaces a good factorization by one with `S` complete, which is harmless because
`S → S^` is flat, the closed fibre of `A → S^` is the completion of a regular local ring, and
`S^ / (f₁, …, f_r) = B` already when `B` is complete.  Two complete good factorizations are both
dominated by a good factorization of `A → S ×_B S'`, which is again Noetherian complete local, so
it suffices to compare two *comparable* good factorizations `A → S' → S → B`.  There the kernel
`I` of `S' → S` is generated by a regular sequence lifting a regular system of parameters of
`ker(S' / 𝔪_A S' → S / 𝔪_A S)`, and generation of `ker(S → B)` by a regular sequence transfers
across `I` in both directions: concatenation gives one implication, and minimality of the
generators of `I` inside `𝔪_{S'} / 𝔪_{S'}^2` gives the other.

## Main definitions

* `LocalCompleteIntersection.IsGoodFactorization`: a good factorization of a local ring
  homomorphism.
* `LocalCompleteIntersection.IsCompleteIntersectionHom`: existence of a good factorization whose
  kernel is generated by a regular sequence.

## Main results

* `LocalCompleteIntersection.isCompleteIntersectionHom_iff_forall_goodFactorization`: one good
  factorization has regular-sequence kernel if and only if every good factorization does.

## Implementation notes

The closed fibre of `A → S` is represented as `S ⧸ 𝔪_A S`, where extension of the maximal ideal
is `Ideal.map`, and generation of an ideal by a regular sequence is
`Ideal.IsGeneratedByRegularSequence`.  The intermediate ring in `IsCompleteIntersectionHom` is
placed in the canonical universe `max u v`, while the intermediate ring quantified over in the
main theorem may live in the further lifted universe `max u v w`; the theorem therefore also
records the universe-invariance implicit in the statement.

## References

* [Stacks Project, Tag 09QA](https://stacks.math.columbia.edu/tag/09QA)
-/

@[expose] public section

namespace LocalCompleteIntersection

universe u v w

open IsLocalRing RingTheory.Sequence

/-! The proof works by reducing to complete factorizations, taking a common refinement, and
comparing factorizations which are related by a surjection.  The following small bridges package
the regular-local-ring and faithfully-flat steps used in that comparison. -/

private theorem ideal_eq_of_same_image_mod_intersection
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I K L : Ideal R) (hL : L ≤ K) (hI : I ≤ maximalIdeal R)
    (hmap : L.map (Ideal.Quotient.mk I) = K.map (Ideal.Quotient.mk I))
    (hinter : K ⊓ I = I * K) : K = L := by
  have hle : K ≤ L ⊔ I * K := by
    intro x hx
    have hxmap : Ideal.Quotient.mk I x ∈ L.map (Ideal.Quotient.mk I) := by
      rw [hmap]
      exact Ideal.mem_map_of_mem _ hx
    obtain ⟨y, hy, hxy⟩ :=
      (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk I)
        Ideal.Quotient.mk_surjective).mp hxmap
    have hdiffI : x - y ∈ I := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_sub, hxy, sub_self]
    have hdiff : x - y ∈ I * K := by
      rw [← hinter]
      exact ⟨K.sub_mem hx (hL hy), hdiffI⟩
    simpa using Submodule.add_mem_sup hy hdiff
  exact le_antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian K)
    (hI.trans (IsLocalRing.maximalIdeal_le_jacobson ⊥)) (by simpa [Ideal.smul_eq_mul] using hle)) hL

private theorem exists_list_lifting_generators
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (I K : Ideal R) (hI : I ≤ maximalIdeal R) (rs : List (R ⧸ I))
    (hmap : Ideal.ofList rs = K.map (Ideal.Quotient.mk I))
    (hinter : K ⊓ I = I * K) :
    ∃ xs : List R, xs.map (Ideal.Quotient.mk I) = rs ∧ Ideal.ofList xs = K := by
  classical
  let q : R →+* R ⧸ I := Ideal.Quotient.mk I
  have hlift_exists (r : R ⧸ I) (hr : r ∈ rs) : ∃ x : R, x ∈ K ∧ q x = r := by
    apply (Ideal.mem_map_iff_of_surjective q Ideal.Quotient.mk_surjective).mp
    rw [← hmap]
    exact Ideal.subset_span hr
  let lift (r : R ⧸ I) (hr : r ∈ rs) : R := (hlift_exists r hr).choose
  let xs := rs.attach.map (fun r => lift r.1 r.2)
  have hlift (r : R ⧸ I) (hr : r ∈ rs) :
      lift r hr ∈ K ∧ q (lift r hr) = r := (hlift_exists r hr).choose_spec
  have hxsmap : xs.map q = rs := by
    have : xs.map q = rs.attach.map Subtype.val := by
      dsimp [xs]
      rw [List.map_map]
      exact List.map_congr_left fun r _ => (hlift r.1 r.2).2
    simpa using this
  have hxsle : Ideal.ofList xs ≤ K := by
    apply Submodule.span_le.mpr
    intro _ hx
    obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hx
    exact (hlift r.1 r.2).1
  refine ⟨xs, hxsmap, ?_⟩
  apply (ideal_eq_of_same_image_mod_intersection I K (Ideal.ofList xs) hxsle hI _ hinter).symm
  rw [Ideal.map_ofList, hxsmap, hmap]

/-! If a kernel becomes a regular-sequence ideal in the closed fibre, flatness lets us lift
those generators to the original kernel.  The intersection formula supplies the final
Nakayama step. -/

private theorem ker_induced_quotient_map_eq_map_ker
    {T S : Type*} [CommRing T] [CommRing S]
    (φ : T →+* S) (hφ : Function.Surjective φ) (I : Ideal T) (J : Ideal S)
    (hJ : J = I.map φ) :
    RingHom.ker
        (Ideal.Quotient.lift I
          ((Ideal.Quotient.mk J).comp φ)
          (fun _x hx => Ideal.Quotient.eq_zero_iff_mem.mpr
            (hJ ▸ Ideal.mem_map_of_mem φ hx))) =
      (RingHom.ker φ).map (Ideal.Quotient.mk I) := by
  have hIker : I ≤ RingHom.ker ((Ideal.Quotient.mk J).comp φ) := by
    intro x hx
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, hJ]
    exact Ideal.mem_map_of_mem φ hx
  rw [Ideal.ker_quotient_lift ((Ideal.Quotient.mk J).comp φ) hIker]
  have hker : RingHom.ker ((Ideal.Quotient.mk J).comp φ) = J.comap φ := by
    ext x
    simp [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
  rw [hker, hJ, Ideal.comap_map_of_surjective φ hφ I, Ideal.map_sup,
    Ideal.map_quotient_self, bot_sup_eq, RingHom.ker_eq_comap_bot]

private theorem exists_surjective_fibre_map
    {A T S : Type*} [CommRing A] [CommRing T] [CommRing S]
    [IsLocalRing A] [Algebra A T] [Algebra A S]
    (φ : T →ₐ[A] S) (hφ : Function.Surjective φ) :
    ∃ ψ : T ⧸ (maximalIdeal A).map (algebraMap A T) →+*
        S ⧸ (maximalIdeal A).map (algebraMap A S),
      Function.Surjective ψ ∧
        RingHom.ker ψ = (RingHom.ker φ.toRingHom).map
          (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A T))) := by
  let I : Ideal T := (maximalIdeal A).map (algebraMap A T)
  let J : Ideal S := (maximalIdeal A).map (algebraMap A S)
  have hJ : J = I.map φ.toRingHom := by
    dsimp [I, J]
    rw [Ideal.map_map]
    congr 1
    ext a
    exact (φ.commutes a).symm
  let ψ : T ⧸ I →+* S ⧸ J :=
    Ideal.Quotient.lift I ((Ideal.Quotient.mk J).comp φ.toRingHom)
      (fun x hx => Ideal.Quotient.eq_zero_iff_mem.mpr
        (hJ ▸ Ideal.mem_map_of_mem φ.toRingHom hx))
  refine ⟨ψ, ?_, ?_⟩
  · intro y
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨t, rfl⟩ := hφ s
    exact ⟨Ideal.Quotient.mk I t, rfl⟩
  · exact ker_induced_quotient_map_eq_map_ker φ.toRingHom hφ I J hJ

/-- For a surjection `φ` of `A`-algebras with flat target, `ker φ ∩ 𝔪_A T = 𝔪_A T * ker φ`. -/
private theorem ker_inf_map_maximalIdeal_eq_mul
    {A T S : Type*} [CommRing A] [CommRing T] [CommRing S] [IsLocalRing A]
    [Algebra A T] [Algebra A S] [Module.Flat A S] (φ : T →ₐ[A] S) (hφ : Function.Surjective φ) :
    RingHom.ker φ.toRingHom ⊓ (maximalIdeal A).map (algebraMap A T) =
      (maximalIdeal A).map (algebraMap A T) * RingHom.ker φ.toRingHom := by
  let : Module.Flat A (T ⧸ RingHom.ker φ.toRingHom) :=
    Module.Flat.of_linearEquiv (Ideal.quotientKerAlgEquivOfSurjective (f := φ) hφ).toLinearEquiv
  simpa only [Ideal.smul_eq_mul] using
    Ideal.inf_map_eq_smul_of_flat_quotient (R := A) (B := T) (RingHom.ker φ.toRingHom)
      (maximalIdeal A)

private theorem exists_regular_kernel_of_surj_regular_fibres
    {A T S : Type*} [CommRing A] [CommRing T] [CommRing S]
    [IsNoetherianRing A] [IsNoetherianRing T] [IsNoetherianRing S]
    [IsLocalRing A] [IsLocalRing T] [IsLocalRing S]
    [Algebra A T] [Algebra A S]
    [IsLocalHom (algebraMap A T)] [IsLocalHom (algebraMap A S)]
    [Module.Flat A T] [Module.Flat A S]
    [IsRegularLocalRing (T ⧸ (maximalIdeal A).map (algebraMap A T))]
    [IsRegularLocalRing (S ⧸ (maximalIdeal A).map (algebraMap A S))]
    (φ : T →ₐ[A] S) (hφ : Function.Surjective φ) :
    ∃ rs : List T, IsRegular T rs ∧ Ideal.ofList rs = RingHom.ker φ.toRingHom := by
  let I : Ideal T := (maximalIdeal A).map (algebraMap A T)
  let K : Ideal T := RingHom.ker φ.toRingHom
  obtain ⟨ψ, hψsurj, hψker⟩ := exists_surjective_fibre_map φ hφ
  have hregker : ∃ rs : List (T ⧸ I), IsRegular (T ⧸ I) rs ∧
      Ideal.ofList rs = RingHom.ker ψ := by
    apply (IsRegularLocalRing.exists_isRegular_ker_tfae
      (f := ψ) (g := RingHom.id _) hψsurj Function.surjective_id).out 3 1 |>.mp
    refine ⟨[], RingTheory.Sequence.IsRegular.nil _ _, ?_⟩
    ext x
    simp [RingHom.mem_ker]
  obtain ⟨rs, hrs, hrsker⟩ := hregker
  have hIle : I ≤ maximalIdeal T := IsLocalRing.map_maximalIdeal_le (algebraMap A T)
  obtain ⟨xs, hxsmap, hxsgen⟩ :=
    exists_list_lifting_generators I K hIle rs (by rw [hrsker, hψker])
      (ker_inf_map_maximalIdeal_eq_mul φ hφ)
  exact ⟨xs, (Module.Flat.isRegular_and_flat_quotient_ofList_take_of_isRegular_maximalIdeal
    (R := A) (S := T) (fs := xs) (by
      rw [← show I = (maximalIdeal A).map (algebraMap A T) from rfl]
      simpa only [hxsmap] using hrs)).1, hxsgen⟩

private theorem isRegular_append_iff_ofList_quotient
    {R : Type*} [CommRing R] (xs ys : List R) :
    IsRegular R (xs ++ ys) ↔
      IsRegular R xs ∧
        IsRegular (R ⧸ Ideal.ofList xs)
          (ys.map (Ideal.Quotient.mk (Ideal.ofList xs))) := by
  let q := Ideal.ofList xs
  let r := Ideal.ofList ys
  have hsup : q ⊔ r = Ideal.ofList (xs ++ ys) := by
    simp [q, r, Ideal.ofList_append]
  let e : (R ⧸ q) ⧸ Ideal.map (Ideal.Quotient.mk q) r ≃+*
      R ⧸ Ideal.ofList (xs ++ ys) :=
    (DoubleQuot.quotQuotEquivQuotSup q r).trans (Ideal.quotEquivOfEq hsup)
  have hq : Ideal.ofList xs • (⊤ : Submodule R R) = q := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
  let eQ : (R ⧸ (Ideal.ofList xs • (⊤ : Submodule R R))) ≃+
      (R ⧸ q) := Submodule.quotEquivOfEq _ _ hq
  have hrel : List.Forall₂
      (fun (a b : R ⧸ q) => ∀ x, eQ (a • x) = b • eQ x)
      (ys.map (Ideal.Quotient.mk q)) (ys.map (Ideal.Quotient.mk q)) := by
    apply List.forall₂_same.mpr
    intro a ha x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    induction x using Quotient.ind
    rfl
  constructor
  · intro h
    have hw := h.toIsWeaklyRegular
    rw [RingTheory.Sequence.isWeaklyRegular_append_iff'] at hw
    have hxs : IsRegular R xs := by
      refine ⟨hw.1, fun htop => ?_⟩
      apply h.top_ne_smul
      have hxstop : Ideal.ofList xs = ⊤ := by
        simpa [Ideal.smul_eq_mul, Ideal.mul_top] using htop.symm
      rw [Ideal.ofList_append, Submodule.sup_smul, hxstop]
      simp
    have hnon : Nontrivial (R ⧸ Ideal.ofList (xs ++ ys)) := by
      apply Ideal.Quotient.nontrivial_iff.mpr
      intro htop
      apply h.top_ne_smul
      simp [htop, Ideal.mul_top]
    have hwys : IsWeaklyRegular (R ⧸ q) (ys.map (Ideal.Quotient.mk q)) :=
      (AddEquiv.isWeaklyRegular_congr (e := eQ) hrel).mp hw.2
    have hnonQ : Nontrivial ((R ⧸ q) ⧸ Ideal.map (Ideal.Quotient.mk q) r) :=
      e.nontrivial_congr.mpr hnon
    have hys : IsRegular (R ⧸ q) (ys.map (Ideal.Quotient.mk q)) := by
      refine ⟨hwys, fun htop => ?_⟩
      have htop' : Ideal.map (Ideal.Quotient.mk q) r = ⊤ := by
        simpa [r, Ideal.map_ofList, Ideal.smul_top_eq_map] using htop.symm
      exact (Ideal.Quotient.nontrivial_iff.mp hnonQ) htop'
    exact ⟨hxs, hys⟩
  · rintro ⟨hxs, hys⟩
    have hysM : IsRegular (R ⧸ (Ideal.ofList xs • (⊤ : Submodule R R)))
        (ys.map (Ideal.Quotient.mk q)) :=
      (AddEquiv.isRegular_congr
        (e := (Submodule.quotEquivOfEq _ _ hq).toAddEquiv) hrel).mpr hys
    have hw := (RingTheory.Sequence.isWeaklyRegular_append_iff'
      (M := R) xs ys).2 ⟨hxs.toIsWeaklyRegular, hysM.toIsWeaklyRegular⟩
    refine ⟨hw, fun htop => ?_⟩
    have hnonQ : Nontrivial ((R ⧸ q) ⧸ Ideal.map (Ideal.Quotient.mk q) r) := by
      apply Ideal.Quotient.nontrivial_iff.mpr
      intro htop'
      exact hys.top_ne_smul (by
        rw [Ideal.map_ofList] at htop'
        simpa [Ideal.smul_top_eq_map] using htop'.symm)
    have hnon : Nontrivial (R ⧸ Ideal.ofList (xs ++ ys)) := e.nontrivial_congr.mp hnonQ
    exact (Ideal.Quotient.nontrivial_iff.mp hnon) (by
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using htop.symm)

/-- Regularity of a list is transported along a ring isomorphism. -/
private theorem isRegular_map_ringEquiv_iff {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (xs : List R) : IsRegular S (xs.map e) ↔ IsRegular R xs :=
  (e.toAddEquiv.isRegular_congr (List.forall₂_map_right_iff.mpr
    (List.forall₂_same.mpr fun r _ x => by simp))).symm

private theorem exists_regular_kernel_comp_of_surjective_regular_kernels
    {T S B : Type*} [CommRing T] [CommRing S] [CommRing B]
    (q : T →+* S) (g : S →+* B) (hq : Function.Surjective q)
    (hgreg : ∃ ys : List S, IsRegular S ys ∧ Ideal.ofList ys = RingHom.ker g)
    (hqreg : ∃ xs : List T, IsRegular T xs ∧ Ideal.ofList xs = RingHom.ker q) :
    ∃ zs : List T, IsRegular T zs ∧ Ideal.ofList zs = RingHom.ker (g.comp q) := by
  classical
  obtain ⟨ys, hys, hysker⟩ := hgreg
  obtain ⟨xs, hxs, hxsker⟩ := hqreg
  let lift (s : S) : T := Classical.choose (hq s)
  have hlift (s : S) : q (lift s) = s := Classical.choose_spec (hq s)
  let zs := ys.map lift
  have hseq : zs.map q = ys := by
    dsimp [zs]
    calc
      (ys.map lift).map q = ys.map (fun s => q (lift s)) := by
        rw [List.map_map]
        rfl
      _ = ys.map id := List.map_congr_left fun s _ => hlift s
      _ = ys := by simp
  let e := RingHom.quotientKerEquivOfSurjective (f := q) hq
  have hysbar : IsRegular (T ⧸ RingHom.ker q)
      (zs.map (Ideal.Quotient.mk (RingHom.ker q))) := by
    have heq : (zs.map (Ideal.Quotient.mk (RingHom.ker q))).map e = ys := by
      rw [List.map_map]
      exact (List.map_congr_left fun t _ =>
        RingHom.quotientKerEquivOfSurjective_apply_mk (f := q) hq t).trans hseq
    rw [← isRegular_map_ringEquiv_iff e, heq]
    exact hys
  let K := RingHom.ker q
  let L := Ideal.ofList zs
  have hLmap : L.map q = RingHom.ker g := by
    rw [Ideal.map_ofList, hseq, hysker]
  have hysbar' : IsRegular (T ⧸ Ideal.ofList xs)
      (zs.map (Ideal.Quotient.mk (Ideal.ofList xs))) := by
    rw [hxsker]
    exact hysbar
  have hcomp : RingHom.ker (g.comp q) = K ⊔ L := by
    rw [RingHom.ker_eq_comap_bot, ← Ideal.comap_comap]
    show Ideal.comap q (RingHom.ker g) = K ⊔ L
    rw [← hLmap, Ideal.comap_map_of_surjective q hq L]
    exact sup_comm L K
  have happend : Ideal.ofList (xs ++ zs) = K ⊔ L := by
    rw [Ideal.ofList_append, hxsker]
  exact ⟨xs ++ zs, (isRegular_append_iff_ofList_quotient xs zs).2 ⟨hxs, hysbar'⟩,
    happend.trans hcomp.symm⟩

/-- A factorization `A → S → B` is good if its maps are local, its second map is surjective, its
first map is flat, and its closed fibre is a regular local ring.  The ambient typeclass binders
record that `S` is a Noetherian local ring. -/
public def IsGoodFactorization
    {A : Type u} {B : Type v} {S : Type w} [CommRing A] [CommRing B] [CommRing S]
    [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing S] [IsLocalRing S]
    (h : A →+* B) (f : A →+* S) (g : S →+* B) : Prop :=
  g.comp f = h ∧ IsLocalHom f ∧ IsLocalHom g ∧ Function.Surjective g ∧ f.Flat ∧
    IsRegularLocalRing (S ⧸ (maximalIdeal A).map f)

/-- A local homomorphism is a complete intersection homomorphism if it has a good factorization
whose surjective map has kernel generated by a regular sequence. -/
public def IsCompleteIntersectionHom
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
    (h : A →+* B) : Prop :=
  ∃ (S : Type (max u v)) (_ : CommRing S) (_ : IsNoetherianRing S) (_ : IsLocalRing S)
      (f : A →+* S) (g : S →+* B),
    IsGoodFactorization h f g ∧ (RingHom.ker g).IsGeneratedByRegularSequence

/-- A list of the minimal length generating an ideal. -/
private theorem exists_list_spanFinrank {R : Type*} [CommRing R]
    (I : Ideal R) (hI : Submodule.FG (I : Submodule R R)) :
    ∃ l : List R, l.length = I.spanFinrank ∧ Ideal.ofList l = I := by
  classical
  obtain ⟨s, hcard, hspan⟩ := hI.exists_span_finset_card_eq_spanFinrank
  refine ⟨s.toList, by simpa using hcard, ?_⟩
  rw [Ideal.ofList, ← hspan]
  congr 1
  ext x
  simp

private theorem length_eq_spanFinrank_of_isRegular
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (rs : List R) (hrs : IsRegular R rs) : rs.length = (Ideal.ofList rs).spanFinrank := by
  let I := Ideal.ofList rs
  have hI : I ≠ ⊤ := by
    intro ht
    exact hrs.top_ne_smul (by change ⊤ = I • (⊤ : Ideal R); simp [ht])
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  have : IsLocalRing (R ⧸ I) := IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective
  obtain ⟨dR, hdR⟩ :=
    Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim R
  obtain ⟨dI, hdI⟩ :=
    Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim (R ⧸ I)
  have h1 := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hrs
  have h2 := Stacks.RegularLocalRing.KernelRegularity.le_add_spanFinrank I hI
  have h3 := Stacks.RegularLocalRing.QuasiRegular.spanFinrank_ofList_le rs
  change ringKrullDim (R ⧸ I) + (rs.length : WithBot ℕ∞) = ringKrullDim R at h1
  rw [hdR, hdI] at h1 h2
  have h1' : dI + rs.length = dR := by exact_mod_cast h1
  have h2' : dR ≤ dI + I.spanFinrank := by exact_mod_cast h2
  dsimp [I] at h2'
  omega

/-- The ideal generated by the entries of a list `List.ofFn f` is the span of the range of `f`. -/
private theorem ofList_ofFn {R : Type*} [CommRing R] {n : ℕ} (f : Fin n → R) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  rw [Ideal.ofList]
  congr 1
  ext x
  simp

private theorem isRegular_of_length_eq_of_ofList_eq
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (xs ys : List R) (hreg : IsRegular R xs) (hlen : xs.length = ys.length)
    (hgen : Ideal.ofList xs = Ideal.ofList ys) : IsRegular R ys := by
  let f : Fin xs.length → R := fun i => ys[i.val]'(by omega)
  have hf : List.ofFn f = ys := by
    apply List.ext_getElem
    · simpa using hlen
    · intro i hi hi'
      simp [f]
  have hI : Ideal.ofList xs ≤ maximalIdeal R := by
    apply le_maximalIdeal
    intro ht
    exact hreg.top_ne_smul (by simp [ht])
  have hmem (i : Fin xs.length) : xs.get i ∈ maximalIdeal R :=
    hI (Ideal.subset_span (List.get_mem ..))
  have hq : IsQuasiRegular R (List.ofFn xs.get) :=
    ((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae (M := R)
      xs.get hmem).2.out 1 4).mp (by simpa using hreg)
  have hspan : Ideal.span (Set.range f) = Ideal.ofList xs := by
    rw [hgen, ← hf, ofList_ofFn]
  have hqf := (Koszul.regularity_of_generators_of_eq_span_range
    (Ideal.ofList xs) f hspan).1 ⟨xs.get, by rw [← ofList_ofFn, List.ofFn_get], hq⟩
  rw [hf] at hqf
  refine IsRegular.of_isQuasiRegular_of_mem_maximalIdeal (fun x hx => hI ?_) hqf
  rw [hgen]
  exact Ideal.subset_span hx

private theorem isRegular_of_minimal_generators
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (xs : List R) (hgen : Ideal.ofList xs = I)
    (hlen : xs.length = I.spanFinrank)
    (hreg : ∃ ys : List R, IsRegular R ys ∧ Ideal.ofList ys = I) : IsRegular R xs := by
  obtain ⟨ys, hy, hygen⟩ := hreg
  apply isRegular_of_length_eq_of_ofList_eq ys xs hy
  · rw [length_eq_spanFinrank_of_isRegular ys hy, hygen, hlen]
  · exact hygen.trans hgen.symm

