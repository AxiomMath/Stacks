/-!
# Complete intersections and finite Tor for local homomorphisms

Let `A → B` be a local homomorphism of Noetherian local rings.  Then `B` is a complete
intersection and `Tor_p^A(B, A / 𝔪_A)` vanishes for all but finitely many `p` if and only if `A`
is a complete intersection and `A^ → B^` is a complete intersection homomorphism.

The Tor condition is unchanged by completion: a resolution of `A / 𝔪_A` by finite free
`A`-modules completes to a resolution of `A^ / 𝔪_{A^}` by finite free `A^`-modules, and
`B → B^` is flat, so `Tor_p^{A^}(B^, A^ / 𝔪_{A^}) = Tor_p^A(B, A / 𝔪_A) ⊗_B B^`.  Both other
conditions are already conditions on the completions, so the statement reduces to the case of
complete rings.  There a presentation of `A → B` by a flat local homomorphism `R → S` of regular
complete local rings with regular closed fibre is available, and with `I = ker(R → A)` and
`J = ker(S → B)` the three equivalent conditions for a regular sequence in a quotient of a flat
local extension turn the Tor statement for `A → B` into the statement that `I` and `J / IS` are
generated by regular sequences, which is exactly the right-hand side.

## Main results

* `LocalCompleteIntersection.isCompleteIntersectionRing_and_eventually_tor_isZero_iff`: the two
  equivalent conditions.

## Implementation notes

The eventual vanishing condition is expressed by a bound beyond which the corresponding `Tor`
objects in the category of modules are zero.  The map on completions is `adicCompletionMap`
specialized to the maximal ideals.

## References

* [Stacks Project, Tag 09QB](https://stacks.math.columbia.edu/tag/09QB)
-/

@[expose] public section

namespace LocalCompleteIntersection

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory IsLocalRing

universe u

private theorem isCompleteIntersectionRing_iff_isGeneratedByRegularSequence_ker
    {A R : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [CommRing R] [IsRegularLocalRing R]
    (q : R →+* AdicCompletion (maximalIdeal A) A) (hq : Function.Surjective q) :
    IsCompleteIntersectionRing A ↔
      Ideal.IsGeneratedByRegularSequence (RingHom.ker q) := by
  let C := AdicCompletion (maximalIdeal A) A
  let : IsNoetherianRing C := inferInstance
  let : IsLocalRing C := inferInstance
  have : IsAdicComplete (maximalIdeal C) C :=
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal A).fg_of_isNoetherianRing
  refine ⟨fun ⟨R₀, hR₀, hreg₀, f, hf, _, rs, hrs, hker⟩ =>
    (forall_regularPresentation_iff_exists C).mpr ⟨R₀, hR₀, hreg₀, f, hf, rs, hrs, hker⟩ R q hq,
    fun hqreg => ⟨R, inferInstance, inferInstance, q, hq, IsLocalHom.of_surjective q hq, hqreg⟩⟩

private theorem adicCompletionMap_isLocalHom
    {A B : Type u} [CommRing A] [CommRing B] [IsNoetherianRing A]
    [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] :
    IsLocalHom (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
      (IsLocalRing.map_maximalIdeal_le f)) := by
  let C := AdicCompletion (maximalIdeal A) A
  let D := AdicCompletion (maximalIdeal B) B
  let fhat := adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le f)
  let iA : A →+* C := algebraMap A C
  let iB : B →+* D := algebraMap B D
  have hcomp : fhat.comp iA = iB.comp f :=
    adicCompletionMap_comp_algebraMap f _ _ _
  have hmaxA : maximalIdeal C = Ideal.map iA (maximalIdeal A) :=
    AdicCompletion.maximalIdeal_eq_map_of_fg
      (maximalIdeal A).fg_of_isNoetherianRing
  have hmaxB : maximalIdeal D = Ideal.map iB (maximalIdeal B) :=
    AdicCompletion.maximalIdeal_eq_map_of_fg
      (maximalIdeal B).fg_of_isNoetherianRing
  have hle : Ideal.map fhat (maximalIdeal C) ≤ maximalIdeal D := by
    rw [hmaxA, hmaxB, Ideal.map_map, hcomp, ← Ideal.map_map]
    exact Ideal.map_mono (IsLocalRing.map_maximalIdeal_le f)
  exact ((IsLocalRing.local_hom_TFAE fhat).out 3 1).mp hle

private noncomputable def torRestrictScalarsIsoHomology
    {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    (N : ModuleCat.{u} R) (P : ProjectiveResolution N) (n : ℕ) :
    (((Tor (ModuleCat.{u} R) n).obj
        ((ModuleCat.restrictScalars f).obj (ModuleCat.of S S))).obj N) ≅
      (((ModuleCat.restrictScalars f).mapHomologicalComplex (ComplexShape.down ℕ)).obj
        (((ModuleCat.extendScalars f).mapHomologicalComplex (ComplexShape.down ℕ)).obj
          P.complex)).homology n :=
  P.isoLeftDerivedObj
    ((tensoringLeft (ModuleCat.{u} R)).obj
      ((ModuleCat.restrictScalars f).obj (ModuleCat.of S S))) n

private noncomputable def extendScalarsHomologyIso
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    (K : HomologicalComplex (ModuleCat.{u} R) (ComplexShape.down ℕ)) (n : ℕ) :
    (ModuleCat.extendScalars (algebraMap R S)).obj (K.homology n) ≅
      (((ModuleCat.extendScalars (algebraMap R S)).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj K).homology n := by
  let E := ModuleCat.extendScalars (algebraMap R S)
  let : PreservesFiniteLimits E :=
    ModuleCat.preservesFiniteLimits_extendScalars_of_flat
      (RingHom.flat_algebraMap_iff.mpr ‹Module.Flat R S›)
  exact (ShortComplex.mapHomologyIso (K.sc n) E).symm ≪≫
    HomologicalComplex.homologyMapIso (Iso.refl ((E.mapHomologicalComplex
      (ComplexShape.down ℕ)).obj K)) n

private noncomputable def projectiveResolutionOfIso
    {C : Type u} [CommRing C] {X Y : ModuleCat.{u} C}
    (P : ProjectiveResolution X) (e : X ≅ Y) : ProjectiveResolution Y where
  complex := P.complex
  projective := P.projective
  π := P.π ≫ (ChainComplex.single₀ (ModuleCat.{u} C)).map e.hom
  quasiIso := by
    have : IsIso ((ChainComplex.single₀ (ModuleCat.{u} C)).map e.hom) :=
      (ChainComplex.single₀ (ModuleCat.{u} C)).map_isIso e.hom
    infer_instance

private noncomputable def completionResidueAlgEquiv
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] :
    TensorProduct A (AdicCompletion (maximalIdeal A) A) (ResidueField A) ≃ₐ[
      AdicCompletion (maximalIdeal A) A] (ResidueField (AdicCompletion (maximalIdeal A) A)) := by
  let C := AdicCompletion (maximalIdeal A) A
  exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot C (maximalIdeal A)).symm.trans
    (Ideal.quotientEquivAlgOfEq C
      (AdicCompletion.maximalIdeal_eq_map_of_fg
        (maximalIdeal A).fg_of_isNoetherianRing).symm)

/-- `Tor_p^R(S, N)` vanishes iff the `p`-th homology of `S ⊗_R P` does, for a resolution `P`
of `N`. -/
private theorem tor_isZero_iff_homology_isZero
    {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    (N : ModuleCat.{u} R) (P : ProjectiveResolution N) (p : ℕ) :
    IsZero (((Tor (ModuleCat.{u} R) p).obj
      ((ModuleCat.restrictScalars f).obj (ModuleCat.of S S))).obj N) ↔
    IsZero ((((ModuleCat.extendScalars f).mapHomologicalComplex (.down ℕ)).obj
      P.complex).homology p) := by
  let e := torRestrictScalarsIsoHomology f N P p ≪≫
    ((((ModuleCat.extendScalars f).mapHomologicalComplex (.down ℕ)).obj P.complex).sc
      p).mapHomologyIso (ModuleCat.restrictScalars f)
  rw [e.isZero_iff, ModuleCat.isZero_iff_subsingleton, ModuleCat.isZero_iff_subsingleton]
  rfl

private theorem tor_isZero_iff_of_flat_square
    {A B C D : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    (f : A →+* B) (i : A →+* C) (j : B →+* D) (g : C →+* D)
    (hcomm : g.comp i = j.comp f) (hi : i.Flat)
    (hj : let := j.toAlgebra; Module.FaithfullyFlat B D)
    (N : ModuleCat.{u} A) (N' : ModuleCat.{u} C)
    (e : (ModuleCat.extendScalars i).obj N ≅ N') (p : ℕ) :
    IsZero (((Tor (ModuleCat.{u} A) p).obj
      ((ModuleCat.restrictScalars f).obj (ModuleCat.of B B))).obj N) ↔
    IsZero (((Tor (ModuleCat.{u} C) p).obj
      ((ModuleCat.restrictScalars g).obj (ModuleCat.of D D))).obj N') := by
  let : Algebra A C := i.toAlgebra
  let : Algebra B D := j.toAlgebra
  have : Module.Flat A C := hi
  have : Module.FaithfullyFlat B D := hj
  let P := ProjectiveResolution.of N
  let E := ModuleCat.extendScalars i
  let F := ModuleCat.extendScalars j
  let : E.Additive := (ModuleCat.extendRestrictScalarsAdj i).left_adjoint_additive
  let : E.PreservesProjectiveObjects :=
    Functor.preservesProjectiveObjects_of_adjunction_of_preservesEpimorphisms
      (ModuleCat.extendRestrictScalarsAdj i)
  let : PreservesFiniteLimits E := ModuleCat.preservesFiniteLimits_extendScalars_of_flat hi
  let : E.PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels E
  let P' := projectiveResolutionOfIso (E.mapProjectiveResolution P) e
  let K := ((ModuleCat.extendScalars f).mapHomologicalComplex (.down ℕ)).obj P.complex
  let K' := ((ModuleCat.extendScalars g).mapHomologicalComplex (.down ℕ)).obj P'.complex
  let t : ModuleCat.extendScalars f ⋙ F ≅ E ⋙ ModuleCat.extendScalars g :=
    (ModuleCat.extendScalarsComp f j).symm ≪≫
      eqToIso (congrArg ModuleCat.extendScalars hcomm.symm) ≪≫
      ModuleCat.extendScalarsComp i g
  let eK : (F.mapHomologicalComplex (.down ℕ)).obj K ≅ K' :=
    (NatIso.mapHomologicalComplex t (.down ℕ)).app P.complex
  let eH : F.obj (K.homology p) ≅ K'.homology p :=
    extendScalarsHomologyIso K p ≪≫
      (HomologicalComplex.homologyFunctor (ModuleCat.{u} D) (.down ℕ) p).mapIso eK
  have hF : IsZero (F.obj (K.homology p)) ↔ IsZero (K.homology p) := by
    rw [ModuleCat.isZero_iff_subsingleton, ModuleCat.isZero_iff_subsingleton]
    exact Module.FaithfullyFlat.subsingleton_tensorProduct_iff_right B D
  have hH : IsZero (K.homology p) ↔ IsZero (K'.homology p) :=
    hF.symm.trans ⟨fun h => h.of_iso eH.symm, fun h => h.of_iso eH⟩
  exact (tor_isZero_iff_homology_isZero f N P p).trans
    (hH.trans (tor_isZero_iff_homology_isZero g N' P' p).symm)

private theorem completion_tor_isZero_iff
    {A B : Type u} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] (p : ℕ) :
    IsZero (((Tor (ModuleCat.{u} A) p).obj
      ((ModuleCat.restrictScalars f).obj (ModuleCat.of B B))).obj
      (ModuleCat.of A (ResidueField A))) ↔
    IsZero (((Tor (ModuleCat.{u} (AdicCompletion (maximalIdeal A) A)) p).obj
      ((ModuleCat.restrictScalars
        (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
          (IsLocalRing.map_maximalIdeal_le f))).obj
        (ModuleCat.of (AdicCompletion (maximalIdeal B) B)
          (AdicCompletion (maximalIdeal B) B)))).obj
      (ModuleCat.of (AdicCompletion (maximalIdeal A) A)
        (ResidueField (AdicCompletion (maximalIdeal A) A)))) := by
  let C := AdicCompletion (maximalIdeal A) A
  let D := AdicCompletion (maximalIdeal B) B
  let : IsNoetherianRing C := inferInstance
  let : IsLocalRing C := inferInstance
  let : IsNoetherianRing D := inferInstance
  let : IsLocalRing D := inferInstance
  let iA : A →+* C := algebraMap A C
  let iB : B →+* D := algebraMap B D
  let fhat := adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le f)
  have hcomp : fhat.comp iA = iB.comp f :=
    adicCompletionMap_comp_algebraMap f _ _ _
  have hi : iA.Flat := RingHom.flat_algebraMap_iff.mpr
    (AdicCompletion.flat_of_isNoetherian (maximalIdeal A))
  have hj : let := iB.toAlgebra; Module.FaithfullyFlat B D := by
    let : Module.Flat B D := AdicCompletion.flat_of_isNoetherian (maximalIdeal B)
    exact Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact tor_isZero_iff_of_flat_square f iA iB fhat hcomp hi hj
    (ModuleCat.of A (ResidueField A)) (ModuleCat.of C (ResidueField C))
    (LinearEquiv.toModuleIso (completionResidueAlgEquiv A).toLinearEquiv) p

private theorem quotient_tor_isZero_iff
    {R S A B : Type u} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [IsLocalRing R] [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) (g : R →+* S) (qA : R →+* A) (qB : S →+* B)
    (hqA : Function.Surjective qA) (hqB : Function.Surjective qB)
    (hcomm : f.comp qA = qB.comp g)
    (hI : RingHom.ker qA ≤ maximalIdeal R)
    (hIJ : (RingHom.ker qA).map g ≤ RingHom.ker qB) (p : ℕ) :
    IsZero (((Tor (ModuleCat.{u} (R ⧸ RingHom.ker qA)) p).obj
      (Stacks.CompleteIntersection.quotientModule (Ideal.quotientMap (RingHom.ker qB) g
        (Ideal.map_le_iff_le_comap.mp hIJ)))).obj
      (Stacks.CompleteIntersection.quotientModule (Ideal.quotientMap (maximalIdeal R)
        (RingHom.id R) (by simpa using hI)))) ↔
    IsZero (((Tor (ModuleCat.{u} A) p).obj
      ((ModuleCat.restrictScalars f).obj (ModuleCat.of B B))).obj
      (ModuleCat.of A (ResidueField A))) := by
  let I := RingHom.ker qA
  let J := RingHom.ker qB
  have : IsLocalHom qA := IsLocalHom.of_surjective qA hqA
  let eA : R ⧸ I ≃+* A := qA.quotientKerEquivOfSurjective hqA
  let eB : S ⧸ J ≃+* B := qB.quotientKerEquivOfSurjective hqB
  let q : R ⧸ I →+* S ⧸ J := Ideal.quotientMap J g
    (Ideal.map_le_iff_le_comap.mp hIJ)
  let qk : R ⧸ I →+* ResidueField R := Ideal.quotientMap (maximalIdeal R)
    (RingHom.id R) (by simpa using hI)
  let N := Stacks.CompleteIntersection.quotientModule qk
  let N' := ModuleCat.of A (ResidueField A)
  have hsq : f.comp eA.toRingHom = eB.toRingHom.comp q :=
    Ideal.Quotient.ringHom_ext (RingHom.ext fun r => RingHom.congr_fun hcomm r)
  let l : N →ₗ[R ⧸ I] (ModuleCat.restrictScalars eA.toRingHom).obj N' :=
    { (ResidueField.map qA).toAddMonoidHom with
      map_smul' := by
        intro r x
        change ResidueField R at x
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        change ResidueField.map qA (residue R r * x) =
          residue A (qA r) * ResidueField.map qA x
        rw [map_mul, ResidueField.map_residue] }
  have hl : Function.Bijective l := ⟨(ResidueField.map qA).injective, fun y => by
    obtain ⟨a, rfl⟩ := residue_surjective y
    obtain ⟨r, rfl⟩ := hqA a
    exact ⟨residue R r, ResidueField.map_residue qA r⟩⟩
  let eN := (LinearEquiv.ofBijective l hl).toModuleIso
  let e : (ModuleCat.extendScalars eA.toRingHom).obj N ≅ N' :=
    (ModuleCat.extendScalars eA.toRingHom).mapIso eN ≪≫
      asIso ((ModuleCat.extendRestrictScalarsAdj eA.toRingHom).counit.app N')
  have : IsLocalRing (S ⧸ J) := eB.symm.isLocalRing
  have hj : let := eB.toRingHom.toAlgebra; Module.FaithfullyFlat (S ⧸ J) B := by
    let := eB.toRingHom.toAlgebra
    have : Module.Flat (S ⧸ J) B := RingHom.Flat.of_bijective eB.bijective
    have : IsLocalHom (algebraMap (S ⧸ J) B) :=
      IsLocalHom.of_surjective _ eB.surjective
    exact Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact tor_isZero_iff_of_flat_square q eA.toRingHom eB.toRingHom f hsq
    (RingHom.Flat.of_bijective eA.bijective) hj N N' e p

private theorem isCompleteIntersectionHom_iff_quotient_kernel
    {R S A B : Type u} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [IsNoetherianRing S]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing A] [IsLocalRing B]
    [IsAdicComplete (maximalIdeal A) A] [IsAdicComplete (maximalIdeal B) B]
    [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (f : A →+* B) [IsLocalHom f]
    (qA : R →+* A) (qB : S →+* B)
    (hqA : Function.Surjective qA) (hqB : Function.Surjective qB)
    (hcomm : f.comp qA = qB.comp (algebraMap R S))
    (hfiber : IsRegularLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S))) :
    IsCompleteIntersectionHom f ↔
      Ideal.IsGeneratedByRegularSequence
        ((RingHom.ker qB).map
          (Ideal.Quotient.mk ((RingHom.ker qA).map (algebraMap R S)))) := by
  let I := RingHom.ker qA
  let L := I.map (algebraMap R S)
  let T := S ⧸ L
  have hL : L ≤ RingHom.ker qB := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    change qB (algebraMap R S r) = 0
    rw [← RingHom.comp_apply, ← hcomm, RingHom.comp_apply, RingHom.mem_ker.mp hr,
      map_zero]
  have hLtop : L ≠ ⊤ := ne_top_of_le_ne_top (RingHom.ker_ne_top qB) hL
  have : Nontrivial T := Ideal.Quotient.nontrivial_iff.mpr hLtop
  have : IsLocalRing T := IsLocalRing.of_surjective' (Ideal.Quotient.mk L)
    Ideal.Quotient.mk_surjective
  let e : R ⧸ I ≃+* A := qA.quotientKerEquivOfSurjective hqA
  let a : R ⧸ I →+* T := algebraMap (R ⧸ I) T
  let b : A →+* T := a.comp e.symm.toRingHom
  let c : T →+* B := Ideal.Quotient.lift L qB hL
  have hc : Function.Surjective c := by
    intro y
    obtain ⟨s, rfl⟩ := hqB y
    exact ⟨Ideal.Quotient.mk L s, rfl⟩
  have hba : b.comp qA = (Ideal.Quotient.mk L).comp (algebraMap R S) := by
    ext r
    change a (e.symm (qA r)) = _
    have he : e.symm (qA r) = Ideal.Quotient.mk I r :=
      e.injective ((e.apply_symm_apply _).trans
        (RingHom.quotientKerEquivOfSurjective_apply_mk hqA r).symm)
    rw [he]
    rfl
  have hbc : c.comp b = f := by
    apply RingHom.ext
    intro x
    obtain ⟨r, rfl⟩ := hqA x
    change c ((b.comp qA) r) = (f.comp qA) r
    rw [hba, hcomm]
    rfl
  have hflat : b.Flat := by
    have : Module.Flat (R ⧸ I) T :=
      Module.Flat.of_linearEquiv
        (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S I).toLinearEquiv
    exact (RingHom.Flat.of_bijective e.symm.bijective).comp
      (RingHom.flat_algebraMap_iff.mpr inferInstance)
  have hm : (maximalIdeal A).map b =
      ((maximalIdeal R).map (algebraMap R S)).map (Ideal.Quotient.mk L) := by
    rw [← map_maximalIdeal_of_surjective qA hqA, Ideal.map_map, hba, ← Ideal.map_map]
  have hlocal : IsLocalHom b := by
    apply ((IsLocalRing.local_hom_TFAE b).out 3 1).mp
    rw [hm]
    exact (Ideal.map_mono (map_maximalIdeal_le (algebraMap R S))).trans
      (map_maximalIdeal_of_surjective (Ideal.Quotient.mk L)
        Ideal.Quotient.mk_surjective).le
  have hreg : IsRegularLocalRing (T ⧸ (maximalIdeal A).map b) := by
    have hle : L ≤ (maximalIdeal R).map (algebraMap R S) :=
      Ideal.map_mono (le_maximalIdeal (RingHom.ker_ne_top qA))
    rw [hm]
    exact IsRegularLocalRing.of_ringEquiv
      (DoubleQuot.quotQuotEquivQuotOfLE hle).symm
  have hgood : IsGoodFactorization f b c :=
    ⟨hbc, hlocal, IsLocalHom.of_surjective c hc, hc, hflat, hreg⟩
  have hker : RingHom.ker c = (RingHom.ker qB).map (Ideal.Quotient.mk L) :=
    Ideal.ker_quotient_lift qB hL
  refine ⟨fun h => ?_, fun h => ⟨T, inferInstance, inferInstance, inferInstance, b, c, hgood,
    by simpa only [Ideal.IsGeneratedByRegularSequence, hker] using h⟩⟩
  have hh := (isCompleteIntersectionHom_iff_forall_goodFactorization f).mp h T b c hgood
  simpa only [Ideal.IsGeneratedByRegularSequence, hker] using hh

/-- Avramov's characterization for a local homomorphism of Noetherian local rings. -/
@[stacks 09QB]
public theorem isCompleteIntersectionRing_and_eventually_tor_isZero_iff
    {A B : Type u} [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] :
    (letI : Algebra A B := f.toAlgebra
     IsCompleteIntersectionRing B ∧
       ∃ n : ℕ, ∀ p : ℕ, n < p →
         IsZero (((Tor (ModuleCat.{u} A) p).obj (ModuleCat.of A B)).obj
           (ModuleCat.of A (ResidueField A)))) ↔
      (IsCompleteIntersectionRing A ∧
        IsCompleteIntersectionHom
          (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
            (IsLocalRing.map_maximalIdeal_le f))) := by
  let C := AdicCompletion (maximalIdeal A) A
  let D := AdicCompletion (maximalIdeal B) B
  let fhat := adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
    (IsLocalRing.map_maximalIdeal_le f)
  let : IsNoetherianRing C := inferInstance
  let : IsLocalRing C := inferInstance
  have : IsAdicComplete (maximalIdeal C) C :=
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal A).fg_of_isNoetherianRing
  let : IsNoetherianRing D := inferInstance
  let : IsLocalRing D := inferInstance
  have : IsAdicComplete (maximalIdeal D) D :=
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal B).fg_of_isNoetherianRing
  have : IsLocalHom fhat := adicCompletionMap_isLocalHom f
  obtain ⟨R, S, hRcomm, hRreg, hRcomplete, hScomm, hSreg, hScomplete,
      g, qA, qB, hqA, hqB, hg, hqAlocal, hqBlocal, hcomm,
      hparameters, hflat, hfiber⟩ := exists_powerSeries_presentation_of_isLocalHom fhat
  let I : Ideal R := RingHom.ker qA
  let J : Ideal S := RingHom.ker qB
  let : Algebra R S := g.toAlgebra
  have hI : I ≤ maximalIdeal R := le_maximalIdeal (RingHom.ker_ne_top qA)
  have hIJ : I.map (algebraMap R S) ≤ J := by
    refine Ideal.map_le_iff_le_comap.mpr ?_
    intro x hx
    change (qB.comp g) x = 0
    rw [← hcomm]
    change fhat (qA x) = 0
    exact (congrArg fhat (RingHom.mem_ker.mp hx)).trans (map_zero fhat)
  have hTFAE := Stacks.CompleteIntersection.regularSequence_quotient_tfae_of_flat
    I J hI hIJ hfiber
  have hCI_A := isCompleteIntersectionRing_iff_isGeneratedByRegularSequence_ker
    (A := A) (R := R) qA hqA
  have hCI_B := isCompleteIntersectionRing_iff_isGeneratedByRegularSequence_ker
    (A := B) (R := S) qB hqB
  have hCI_map := isCompleteIntersectionHom_iff_quotient_kernel
    fhat qA qB hqA hqB hcomm hfiber
  have hTor : (let : Algebra A B := f.toAlgebra
      ∃ n : ℕ, ∀ p : ℕ, n < p →
        IsZero (((Tor (ModuleCat.{u} A) p).obj (ModuleCat.of A B)).obj
          (ModuleCat.of A (ResidueField A)))) ↔
      ∃ n : ℕ, ∀ p : ℕ, n < p →
        IsZero (((Tor (ModuleCat.{u} (R ⧸ I)) p).obj
          (Stacks.CompleteIntersection.quotientModule
            (Ideal.quotientMap J (algebraMap R S)
              (Ideal.map_le_iff_le_comap.mp hIJ)))).obj
          (Stacks.CompleteIntersection.quotientModule
            (Ideal.quotientMap (maximalIdeal R) (RingHom.id R)
              (by simpa using hI)))) :=
    exists_congr fun n => forall_congr' fun p => imp_congr_right fun _ =>
      (completion_tor_isZero_iff f p).trans
        (quotient_tor_isZero_iff fhat (algebraMap R S) qA qB hqA hqB hcomm hI hIJ p).symm
  exact (and_congr hCI_B hTor).trans
    ((hTFAE.out 2 3).trans (and_congr hCI_A.symm hCI_map.symm))

end LocalCompleteIntersection

