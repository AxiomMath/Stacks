-/

@[expose] public section

namespace LocalCompleteIntersection

open IsLocalRing RingTheory.Sequence
open scoped TensorProduct

universe u v

/-- **Stacks 09Q3 (1).** A Noetherian local ring is a complete intersection if its completion at
the maximal ideal is a quotient of a regular local ring by an ideal generated by a regular
sequence. -/
@[stacks 09Q3 "(1)", ega "IV 19.3.1" "local ring definition", sga "3 VIIB 5.5"]
public def IsCompleteIntersectionRing (A : Type u) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] : Prop :=
  ∃ (R : Type u) (_ : CommRing R) (_ : IsRegularLocalRing R)
      (f : R →+* AdicCompletion (maximalIdeal A) A),
    Function.Surjective f ∧ IsLocalHom f ∧
      ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f

/-- A Noetherian local ring is a complete intersection exactly when its completion admits a
regular-local presentation whose kernel is generated by a regular sequence. -/
public theorem isCompleteIntersectionRing_iff (A : Type u) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] :
    IsCompleteIntersectionRing A ↔
      ∃ (R : Type u) (_ : CommRing R) (_ : IsRegularLocalRing R)
        (f : R →+* AdicCompletion (maximalIdeal A) A),
        Function.Surjective f ∧ IsLocalHom f ∧
          ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f :=
  Iff.rfl

/-- **Stacks 09Q3 (2).** A Noetherian ring is a local complete intersection if every localization
at a prime ideal is a complete intersection local ring. -/
@[stacks 09Q3 "(2)"]
public def IsLocalCompleteIntersectionRing (A : Type u) [CommRing A] [IsNoetherianRing A] : Prop :=
  ∀ (p : Ideal A) [p.IsPrime], IsCompleteIntersectionRing (Localization.AtPrime p)

/-- A Noetherian ring is a local complete intersection exactly when all its local rings are
complete intersections. -/
public theorem isLocalCompleteIntersectionRing_iff (A : Type u) [CommRing A]
    [IsNoetherianRing A] :
    IsLocalCompleteIntersectionRing A ↔
      ∀ (p : Ideal A) [p.IsPrime], IsCompleteIntersectionRing (Localization.AtPrime p) :=
  Iff.rfl

/-- A Noetherian complete local ring is a complete intersection if it is the quotient of a
regular local ring by an ideal generated by a regular sequence.  This is the base-free notion for
complete local rings used in Section 09PY of the Stacks Project. -/
@[ega "IV 19.3.1" "complete local rings",
  sga "2 X 3.4" "special case",
  sga "3 VIIB 5.5" "special case"]
public def IsCompleteIntersectionCompleteLocalRing (A : Type u) [CommRing A] : Prop :=
  IsNoetherianCompleteLocalRing A ∧
    ∃ (S : Type u) (_ : CommRing S) (_ : IsRegularLocalRing S) (f : S →+* A),
      Function.Surjective f ∧ IsLocalHom f ∧
        ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker f

/-- The ideal generated by a regular sequence is proper. -/
private theorem ne_top_of_isRegular_ofList {R : Type*} [CommRing R] {rs : List R}
    (hrs : IsRegular R rs) : Ideal.ofList rs ≠ ⊤ := by
  intro h
  apply hrs.top_ne_smul
  simpa [smul_eq_mul] using congrArg (fun J : Ideal R => J • (⊤ : Ideal R)) h.symm

/-- A regular sequence in a Noetherian local ring stays regular in its completion. -/
private theorem isRegular_map_adicCompletion {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] {rs : List R} (hrs : IsRegular R rs) :
    IsRegular (AdicCompletion (maximalIdeal R) R)
      (rs.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) := by
  have : Module.FaithfullyFlat R (AdicCompletion (maximalIdeal R) R) :=
    AdicCompletion.faithfullyFlat_of_le_ringJacobson (maximalIdeal R) (by
      rw [IsLocalRing.ringJacobson_eq_maximalIdeal])
  exact hrs.of_faithfullyFlat

/-- A regular sequence stays regular after mapping along a ring isomorphism. -/
private theorem isRegular_map_ringEquiv {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S)
    {rs : List R} (hrs : IsRegular R rs) : IsRegular S (rs.map e) :=
  (e.toAddEquiv.isRegular_congr
    (List.forall₂_map_right_iff.mpr <|
      List.forall₂_same.mpr (fun r _ x => by simp))).mp hrs

/-- **Stacks 09Q0.** If `R` is regular, `p` is a prime of `R`, and `rs` is a regular
sequence contained in `p`, then the completion of `Rₚ/(rs)Rₚ` at its maximal ideal is a complete
intersection. -/
@[stacks 09Q0, ega "IV 19.3.2" "reg seq ⇒ CI"]
public theorem isCompleteIntersectionCompleteLocalRing_adicCompletion_quotientAtPrime
    (R : Type u) [CommRing R] [IsRegularRing R] (p : Ideal R) [p.IsPrime] (rs : List R)
    (hrs : IsRegular R rs) (hmem : ∀ x ∈ rs, x ∈ p) :
    let Rp := Localization.AtPrime p
    let rs' : List Rp := rs.map (algebraMap R Rp)
    let I : Ideal Rp := Ideal.ofList rs'
    let A := Rp ⧸ I
    IsCompleteIntersectionCompleteLocalRing
      (AdicCompletion ((maximalIdeal Rp).map (Ideal.Quotient.mk I)) A) := by
  let Rp := Localization.AtPrime p
  let rs' : List Rp := rs.map (algebraMap R Rp)
  let I : Ideal Rp := Ideal.ofList rs'
  let A := Rp ⧸ I
  show IsCompleteIntersectionCompleteLocalRing
    (AdicCompletion ((maximalIdeal Rp).map (Ideal.Quotient.mk I)) A)
  let m : Ideal Rp := maximalIdeal Rp
  let B := AdicCompletion m Rp
  have hloc : IsRegular Rp rs' :=
    hrs.toIsWeaklyRegular.isRegular_of_isLocalization_of_mem Rp p hmem
  have hI : I ≠ ⊤ := ne_top_of_isRegular_ofList hloc
  have : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr hI
  have : IsLocalRing A :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  rw [IsLocalRing.map_maximalIdeal_of_surjective
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective]
  have hRp : IsRegularLocalRing Rp := IsRegularRing.isRegularLocalRing_of_isLocalization p Rp
  have hBreg : IsRegularLocalRing B := isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp hRp
  have hs : IsRegular B (rs'.map (algebraMap Rp B)) := isRegular_map_adicCompletion hloc
  let C := AdicCompletion (maximalIdeal A) A
  have hCcomp : IsNoetherianCompleteLocalRing C := ⟨inferInstance, inferInstance,
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal A).fg_of_isNoetherianRing⟩
  let f : B →+* C := adicCompletionMapQuotient I
  have hf : Function.Surjective f := adicCompletionMapQuotient_surjective I
  refine ⟨hCcomp, B, inferInstance, hBreg, f, hf, ?_, ?_⟩
  · exact IsLocalHom.of_surjective f hf
  · let xs : List B := rs'.map (algebraMap Rp B)
    refine ⟨xs, hs, ?_⟩
    show Ideal.ofList (rs'.map (algebraMap Rp B)) =
      RingHom.ker (adicCompletionMapQuotient I)
    rw [← Ideal.map_ofList, ker_adicCompletionMapQuotient I]

private theorem exists_adicCompletion_ringEquiv_of_ringEquiv
    {R S : Type*} [CommRing R] [CommRing S] (e : R ≃+* S)
    (I : Ideal R) (J : Ideal S) (hIJ : Ideal.map (↑e) I = J) :
    ∃ E : AdicCompletion I R ≃+* AdicCompletion J S,
      ∀ x : R, E (algebraMap R (AdicCompletion I R) x) =
        algebraMap S (AdicCompletion J S) (e x) := by
  classical
  change Ideal.map (e : R →+* S) I = J at hIJ
  have he : ∀ n : ℕ, ∃ eₙ : (R ⧸ I ^ n) ≃+* (S ⧸ J ^ n),
      ∀ x : R, eₙ (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (e x) := by
    intro n
    refine ⟨Ideal.quotientEquiv _ _ e ?_, ?_⟩
    · rw [← hIJ]
      exact (Ideal.map_pow _ _ _).symm
    · intro x
      exact Ideal.quotientEquiv_mk _ _ _ _ _
  choose eₙ heₙ using he
  have hnaturality {m n : ℕ} (hmn : m ≤ n) (x : R ⧸ I ^ n) :
      eₙ m (Ideal.Quotient.factorPow I hmn x) =
        Ideal.Quotient.factorPow J hmn (eₙ n x) := by
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp only [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, heₙ]
  let F : AdicCompletion I R →+* AdicCompletion J S :=
    adicCompletionMap (e : R →+* S) I J hIJ.le
  have hmap (n : ℕ) (x : AdicCompletion I R) :
      AdicCompletion.evalₐ J n (F x) = eₙ n (AdicCompletion.evalₐ I n x) := by
    rw [show F = adicCompletionMap (e : R →+* S) I J hIJ.le by rfl,
      adicCompletionMap_evalₐ]
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
    rw [← hr, Ideal.quotientMap_mk, heₙ]
    rfl
  let G : AdicCompletion J S →+* AdicCompletion I R :=
    AdicCompletion.liftRingHom I
      (fun n => (eₙ n).symm.toRingHom.comp (AdicCompletion.evalₐ J n).toRingHom)
      (fun {m n} hmn => by
        ext x
        apply (eₙ m).injective
        show eₙ m (Ideal.Quotient.factorPow I hmn
            ((eₙ n).symm (AdicCompletion.evalₐ J n x))) =
          eₙ m ((eₙ m).symm (AdicCompletion.evalₐ J m x))
        rw [hnaturality, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply,
          AdicCompletion.factorPow_evalₐ])
  have hG (n : ℕ) (x : AdicCompletion J S) :
      AdicCompletion.evalₐ I n (G x) = (eₙ n).symm (AdicCompletion.evalₐ J n x) :=
    AdicCompletion.evalₐ_liftRingHom I _ _ n x
  have hleft : Function.LeftInverse G F := by
    intro x
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hG, hmap, RingEquiv.symm_apply_apply]
  have hright : Function.RightInverse G F := by
    intro x
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hmap, hG, RingEquiv.apply_symm_apply]
  refine ⟨RingEquiv.ofBijective F ⟨hleft.injective, hright.surjective⟩, fun x => ?_⟩
  apply AdicCompletion.ext_evalₐ
  intro n
  show AdicCompletion.evalₐ J n (F (algebraMap R (AdicCompletion I R) x)) = _
  rw [hmap]
  simpa only [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    AdicCompletion.evalₐ_of] using heₙ n x

private theorem regularKernel_iff_of_surjective
    {P R A : Type*} [CommRing P] [CommRing R] [CommRing A]
    [IsRegularLocalRing P] [IsRegularLocalRing R] [Nontrivial A]
    (q : P →+* R) (f : R →+* A)
    (hq : Function.Surjective q) (hf : Function.Surjective f) :
    (∃ rs : List P, RingTheory.Sequence.IsRegular P rs ∧
      Ideal.ofList rs = RingHom.ker (f.comp q)) ↔
    (∃ rs : List R, RingTheory.Sequence.IsRegular R rs ∧
      Ideal.ofList rs = RingHom.ker f) :=
  (IsRegularLocalRing.exists_isRegular_ker_tfae hq hf).out 1 3

private theorem regularKernel_iff_of_commonCover
    {P R S A : Type*} [CommRing P] [CommRing R] [CommRing S] [CommRing A]
    [IsRegularLocalRing P] [IsRegularLocalRing R] [IsRegularLocalRing S] [Nontrivial A]
    (qR : P →+* R) (qS : P →+* S) (fR : R →+* A) (fS : S →+* A)
    (hqR : Function.Surjective qR) (hqS : Function.Surjective qS)
    (hfR : Function.Surjective fR) (hfS : Function.Surjective fS)
    (hcomm : fR.comp qR = fS.comp qS) :
    (∃ rs : List R, RingTheory.Sequence.IsRegular R rs ∧
      Ideal.ofList rs = RingHom.ker fR) ↔
    (∃ rs : List S, RingTheory.Sequence.IsRegular S rs ∧
      Ideal.ofList rs = RingHom.ker fS) := by
  rw [← regularKernel_iff_of_surjective qR fR hqR hfR,
    ← regularKernel_iff_of_surjective qS fS hqS hfS, hcomm]

private theorem regularKernel_iff_dim
    {R A : Type*} [CommRing R] [CommRing A]
    [IsRegularLocalRing R] [Nontrivial A]
    (f : R →+* A) (hf : Function.Surjective f) :
    (∃ rs : List R, RingTheory.Sequence.IsRegular R rs ∧
      Ideal.ofList rs = RingHom.ker f) ↔
    ringKrullDim A + (RingHom.ker f).spanFinrank = ringKrullDim R := by
  simpa only [RingHom.comp_id] using
    (IsRegularLocalRing.exists_isRegular_ker_tfae
      (f := RingHom.id R) (g := f) Function.surjective_id hf).out 1 2

private theorem exists_completionPresentation
    {R : Type u} {A : Type v} [CommRing R] [CommRing A]
    [IsRegularLocalRing R] [IsNoetherianRing A] [IsLocalRing A]
    [IsAdicComplete (maximalIdeal A) A]
    (f : R →+* A) (hf : Function.Surjective f) :
    ∃ g : AdicCompletion (maximalIdeal R) R →+* A,
      Function.Surjective g ∧
      g.comp (algebraMap R (AdicCompletion (maximalIdeal R) R)) = f ∧
      RingHom.ker g = (RingHom.ker f).map
        (algebraMap R (AdicCompletion (maximalIdeal R) R)) := by
  let J : Ideal R := RingHom.ker f
  have hJ : J ≠ ⊤ := RingHom.ker_ne_top f
  let : Nontrivial (R ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  let : IsLocalRing (R ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  let e : R ⧸ J ≃+* A := RingHom.quotientKerEquivOfSurjective hf
  let : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have hmaxEq : Ideal.map (↑e) (maximalIdeal (R ⧸ J)) = maximalIdeal A :=
    IsLocalRing.map_ringEquiv_maximalIdeal e
  obtain ⟨eC, heC⟩ :=
    exists_adicCompletion_ringEquiv_of_ringEquiv e (maximalIdeal (R ⧸ J))
      (maximalIdeal A) hmaxEq
  let g : AdicCompletion (maximalIdeal R) R →+* A :=
    (AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm.toRingEquiv.toRingHom.comp
      (eC.toRingHom.comp (adicCompletionMapQuotient J))
  refine ⟨g, ?_, ?_, ?_⟩
  · exact (AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm.surjective.comp
      (eC.surjective.comp (adicCompletionMapQuotient_surjective J))
  · apply RingHom.ext
    intro r
    show (AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm
      (eC (adicCompletionMapQuotient J
        (algebraMap R (AdicCompletion (maximalIdeal R) R) r))) = f r
    rw [completionQuotientMap_algebraMap, heC]
    show (AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm
      (AdicCompletion.of (maximalIdeal A) A (e (Ideal.Quotient.mk J r))) = f r
    rw [AdicCompletion.ofAlgEquiv_symm_of]
    exact RingHom.quotientKerEquivOfSurjective_apply_mk hf r
  · show RingHom.ker
        ((AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm.toRingEquiv.toRingHom.comp
          (eC.toRingHom.comp (adicCompletionMapQuotient J))) = _
    rw [RingHom.ker_comp_of_injective _
          (f := (AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm.toRingEquiv.toRingHom)
          (AdicCompletion.ofAlgEquiv (maximalIdeal A)).symm.injective,
      RingHom.ker_comp_of_injective _ (f := eC.toRingHom) eC.injective,
      ker_adicCompletionMapQuotient J]

private theorem regularKernel_iff_completion
    {R : Type u} {A : Type v} [CommRing R] [CommRing A]
    [IsRegularLocalRing R] [IsNoetherianRing A] [IsLocalRing A]
    [IsAdicComplete (maximalIdeal A) A]
    (f : R →+* A) (hf : Function.Surjective f)
    (g : AdicCompletion (maximalIdeal R) R →+* A)
    (hg : Function.Surjective g)
    (hker : RingHom.ker g = (RingHom.ker f).map
      (algebraMap R (AdicCompletion (maximalIdeal R) R))) :
    (∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f) ↔
      ∃ rs : List (AdicCompletion (maximalIdeal R) R),
        IsRegular (AdicCompletion (maximalIdeal R) R) rs ∧
          Ideal.ofList rs = RingHom.ker g := by
  let : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  let : IsRegularLocalRing (AdicCompletion (maximalIdeal R) R) :=
    isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp inferInstance
  let : Module.Flat R (AdicCompletion (maximalIdeal R) R) :=
    AdicCompletion.flat_of_isNoetherian _
  rw [regularKernel_iff_dim f hf, regularKernel_iff_dim g hg, hker,
    ringKrullDim_adicCompletion_maximalIdeal (A := R),
    Stacks.CompleteIntersection.BaseChange.spanFinrank_map_of_flat_of_isLocalHom _
      (IsNoetherian.noetherian _)]

private theorem regularKernel_iff_of_completePresentations_of_isAdicComplete
    {R S A : Type*} [CommRing R] [CommRing S] [CommRing A]
    [IsRegularLocalRing R] [IsRegularLocalRing S]
    [IsAdicComplete (maximalIdeal R) R] [IsAdicComplete (maximalIdeal S) S]
    [IsNoetherianRing A] [IsLocalRing A] [IsAdicComplete (maximalIdeal A) A]
    (f : R →+* A) (g : S →+* A)
    (hf : Function.Surjective f) (hg : Function.Surjective g) :
    (∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f) ↔
      ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker g := by
  obtain ⟨_, _, _⟩ := isNoetherianCompleteLocalRing_pullback f g hf hg
  obtain ⟨P, Q, iP, hP, cP, iQ, hQ, cQ, t, q, q', hq, hq', _⟩ :=
    exists_powerSeries_presentation_of_isLocalHom (RingHom.id (f.pullback g))
  let qR : P →+* R := (f.pullbackFst g).comp q
  let qS : P →+* S := (f.pullbackSnd g).comp q
  have hqR : Function.Surjective qR :=
    (RingHom.surjective_pullbackFst_of_surjective f g hg).comp hq
  have hqS : Function.Surjective qS :=
    (RingHom.surjective_pullbackSnd_of_surjective f g hf).comp hq
  have hcomm : f.comp qR = g.comp qS := by
    simpa [qR, qS, RingHom.comp_assoc] using
      congrArg (fun h : f.pullback g →+* A => h.comp q) (RingHom.pullback_comm_sq f g)
  exact regularKernel_iff_of_commonCover qR qS f g hqR hqS hf hg hcomm

private theorem regularKernel_iff_of_completePresentations
    {R S A : Type*} [CommRing R] [CommRing S] [CommRing A]
    [IsRegularLocalRing R] [IsRegularLocalRing S]
    [IsNoetherianRing A] [IsLocalRing A] [IsAdicComplete (maximalIdeal A) A]
    (f : R →+* A) (g : S →+* A)
    (hf : Function.Surjective f) (hg : Function.Surjective g) :
    (∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f) ↔
      ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker g := by
  obtain ⟨f', hf', _, hkerf⟩ := exists_completionPresentation f hf
  obtain ⟨g', hg', _, hkerg⟩ := exists_completionPresentation g hg
  let : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  let : IsNoetherianRing S := IsRegularLocalRing.toIsNoetherian
  let : IsRegularLocalRing (AdicCompletion (maximalIdeal R) R) :=
    isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp inferInstance
  let : IsRegularLocalRing (AdicCompletion (maximalIdeal S) S) :=
    isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp inferInstance
  let : IsAdicComplete
      (maximalIdeal (AdicCompletion (maximalIdeal R) R))
      (AdicCompletion (maximalIdeal R) R) :=
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal R).fg_of_isNoetherianRing
  let : IsAdicComplete
      (maximalIdeal (AdicCompletion (maximalIdeal S) S))
      (AdicCompletion (maximalIdeal S) S) :=
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal S).fg_of_isNoetherianRing
  exact (regularKernel_iff_completion f hf f' hf' hkerf).trans
    ((regularKernel_iff_of_completePresentations_of_isAdicComplete f' g' hf' hg').trans
      (regularKernel_iff_completion g hg g' hg' hkerg).symm)

/-- Let `A` be a Noetherian complete local ring.  The kernel of every surjection onto `A` from
a regular local ring is generated by a regular sequence if and only if this holds for one such
surjection. -/
@[stacks 09PZ, ega "IV 19.3.2" "special case"]
public theorem forall_regularPresentation_iff_exists
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [IsAdicComplete (maximalIdeal A) A] :
    (∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (f : R →+* A),
      Function.Surjective f →
        ∃ rs : List R, RingTheory.Sequence.IsRegular R rs ∧
          Ideal.ofList rs = RingHom.ker f) ↔
      ∃ (R : Type u) (_ : CommRing R) (_ : IsRegularLocalRing R) (f : R →+* A),
        Function.Surjective f ∧
          ∃ rs : List R, RingTheory.Sequence.IsRegular R rs ∧
            Ideal.ofList rs = RingHom.ker f := by
  constructor
  · intro h
    obtain ⟨R, S, iR, hR, cR, iS, hS, cS, g, qA, qB, hqA, hqB, _⟩ :=
      exists_powerSeries_presentation_of_isLocalHom (RingHom.id A)
    exact ⟨R, iR, hR, qA, hqA, h R qA hqA⟩
  · rintro ⟨R, iR, hR, f, hf, hrs⟩ S iS hS g hg
    exact (regularKernel_iff_of_completePresentations f g hf hg).mp hrs

private theorem ideal_map_comp_eq_self {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (g : S →+* R) (hgf : g.comp f = RingHom.id R)
    (J : Ideal R) : Ideal.map g (Ideal.map f J) = J := by
  rw [Ideal.map_map, hgf, Ideal.map_id]

/-- Being a complete intersection, as a Noetherian complete local ring, transports along a ring
isomorphism, possibly between different universes. -/
private theorem IsCompleteIntersectionCompleteLocalRing.of_ringEquiv
    {B : Type u} {C : Type v} [CommRing B] [CommRing C]
    (hB : IsCompleteIntersectionCompleteLocalRing B) (e : B ≃+* C) :
    IsCompleteIntersectionCompleteLocalRing C := by
  let : IsLocalRing B := hB.1.isLocal
  let : IsNoetherianRing B := hB.1.isNoetherian
  let : IsAdicComplete (maximalIdeal B) B := hB.1.isComplete
  let : IsLocalRing C := e.isLocalRing
  let : IsNoetherianRing C := isNoetherianRing_of_ringEquiv B e
  let : IsAdicComplete (maximalIdeal C) C := by
    rw [← IsLocalRing.map_ringEquiv_maximalIdeal e]
    exact (IsAdicComplete.congr_ringEquiv (maximalIdeal B) e).mpr hB.1.isComplete
  obtain ⟨T, _, hTreg, g, hg, -, rs, hrs, hker⟩ := hB.2
  obtain ⟨P, Q, iP, hP, cP, iQ, hQ, cQ, t, qP, qQ, hqP, hqQ, _, hlocalP, _, _, _⟩ :=
    exists_powerSeries_presentation_of_isLocalHom (RingHom.id C)
  let : IsAdicComplete (maximalIdeal P) P := cP
  obtain ⟨xs, hxs, hkerxs⟩ := (regularKernel_iff_of_completePresentations
    (e.toRingHom.comp g) qP (e.surjective.comp hg) hqP).mp
    ⟨rs, hrs, by rw [RingHom.ker_comp_of_injective _ (f := e.toRingHom) e.injective, hker]⟩
  exact ⟨⟨inferInstance, inferInstance, inferInstance⟩, P, inferInstance, hP,
    qP, hqP, hlocalP, xs, hxs, hkerxs⟩

private theorem exists_isRegular_ofList_eq_of_isCompleteIntersectionCompleteLocalRing
    {Rp : Type u} [CommRing Rp] [IsRegularLocalRing Rp]
    {A : Type v} [CommRing A] [IsLocalRing A]
    (K : Ideal Rp) (hK : K ≠ ⊤) (e : Rp ⧸ K ≃+* A)
    (hci : IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal A) A)) :
    ∃ rs : List Rp, IsRegular Rp rs ∧ Ideal.ofList rs = K := by
  have : IsNoetherianRing Rp := IsRegularLocalRing.toIsNoetherian
  have hCM : Module.IsMaximalCohenMacaulay Rp Rp :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      Rp).2
  let A0 := Rp ⧸ K
  have : Nontrivial A0 := Ideal.Quotient.nontrivial_iff.mpr hK
  let : IsLocalRing A0 := IsLocalRing.of_surjective' (Ideal.Quotient.mk K)
    Ideal.Quotient.mk_surjective
  let : IsNoetherianRing A0 := isNoetherianRing_of_surjective Rp A0
    (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  let B0 := AdicCompletion (maximalIdeal A0) A0
  obtain ⟨eC, -⟩ := exists_adicCompletion_ringEquiv_of_ringEquiv e (maximalIdeal A0)
    (maximalIdeal A) (IsLocalRing.map_ringEquiv_maximalIdeal e)
  have hB0 : IsCompleteIntersectionCompleteLocalRing B0 := hci.of_ringEquiv eC.symm
  obtain ⟨_, _, _⟩ := hB0.1
  let S := AdicCompletion (maximalIdeal Rp) Rp
  let f : S →+* B0 := adicCompletionMapQuotient K
  have hfsurj : Function.Surjective f := adicCompletionMapQuotient_surjective K
  have hSreg : IsRegularLocalRing S :=
    (isRegularLocalRing_iff_adicCompletion_maximalIdeal (A := Rp)).mp inferInstance
  have hJreg : ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker f := by
    obtain ⟨T, _, hTreg, g, hg, -, rs, hrs, hker⟩ := hB0.2
    exact (regularKernel_iff_of_completePresentations f g hfsurj hg).mpr ⟨rs, hrs, hker⟩
  let mS : Ideal S := (maximalIdeal Rp).map (algebraMap Rp S)
  have hJbar : ∃ rs : List (S ⧸ mS), IsRegular (S ⧸ mS) rs ∧
      Ideal.ofList rs = (RingHom.ker f).map (Ideal.Quotient.mk mS) := by
    refine ⟨[], RingTheory.Sequence.IsRegular.nil (S ⧸ mS) (S ⧸ mS), ?_⟩
    rw [Ideal.ofList_nil, ker_adicCompletionMapQuotient, eq_comm,
      Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
    exact Ideal.map_mono (le_maximalIdeal hK)
  let : Algebra Rp A0 := (Ideal.Quotient.mk K).toAlgebra
  let : Algebra Rp S := inferInstance
  let : Algebra A0 B0 := inferInstance
  let : Algebra S B0 := f.toAlgebra
  let : Algebra Rp B0 :=
    Algebra.compHom B0 ((algebraMap A0 B0).comp (algebraMap Rp A0))
  have hcomm : f.comp (algebraMap Rp S) = (algebraMap A0 B0).comp (algebraMap Rp A0) :=
    RingHom.ext fun r => completionQuotientMap_algebraMap K r
  have hTowerRA : IsScalarTower Rp A0 B0 :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let : IsScalarTower Rp S B0 := IsScalarTower.of_algebraMap_eq' hcomm.symm
  let : Module.Flat Rp S := AdicCompletion.flat_of_isNoetherian (maximalIdeal Rp)
  let : Module.Flat A0 B0 := AdicCompletion.flat_of_isNoetherian (maximalIdeal A0)
  have hAsurj : Function.Surjective (algebraMap Rp A0) := Ideal.Quotient.mk_surjective (I := K)
  obtain ⟨rs, hrs, hgen⟩ := @exists_isRegular_ofList_eq_ker_algebraMap_of_flat Rp S A0 B0
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    inferInstance inferInstance inferInstance hTowerRA (inferInstance : IsScalarTower Rp S B0)
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    hCM hAsurj hfsurj hJreg hJbar
  exact ⟨rs, hrs, hgen.trans (Ideal.mk_ker (I := K))⟩

private theorem isCompleteIntersectionCompleteLocalRing_of_isRegular_ofList_eq
    {Rp : Type u} [CommRing Rp] [IsRegularLocalRing Rp]
    {A : Type v} [CommRing A] [IsLocalRing A]
    (K : Ideal Rp) (hK : K ≠ ⊤) (e : Rp ⧸ K ≃+* A)
    (rs : List Rp) (hrs : IsRegular Rp rs) (hrsK : Ideal.ofList rs = K) :
    IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal A) A) := by
  let m : Ideal Rp := maximalIdeal Rp
  let : IsRegularRing Rp :=
    ((IsLocalRing.isRegularRing_tfae (R := Rp)).out 1 3).mp ‹IsRegularLocalRing Rp›
  have : m.IsPrime := (maximalIdeal.isMaximal Rp).isPrime
  have : IsLocalization.AtPrime Rp m :=
    IsLocalization.of_le_isUnit (fun x hx => IsLocalRing.notMem_maximalIdeal.mp hx)
  let Q := Localization.AtPrime m
  let ψAlg : Q ≃ₐ[Rp] Rp := IsLocalization.algEquiv m.primeCompl Q Rp
  let ψ : Q ≃+* Rp := ψAlg.toRingEquiv
  let Iq : Ideal Q := Ideal.ofList (rs.map (algebraMap Rp Q))
  have hmem : ∀ x ∈ rs, x ∈ m := fun x hx =>
    le_maximalIdeal hK (hrsK.le (Ideal.subset_span hx))
  have hciQ :=
    isCompleteIntersectionCompleteLocalRing_adicCompletion_quotientAtPrime Rp m rs hrs hmem
  have hIq : Iq = K.map (algebraMap Rp Q) := by
    show Ideal.ofList (rs.map (algebraMap Rp Q)) = K.map (algebraMap Rp Q)
    rw [← Ideal.map_ofList, hrsK]
  have hψK : Ideal.map (↑ψ) Iq = K := by
    have hcomp : (ψ : Q →+* Rp).comp (algebraMap Rp Q) = RingHom.id Rp :=
      RingHom.ext ψAlg.commutes
    rw [hIq]
    exact ideal_map_comp_eq_self (algebraMap Rp Q) (ψ : Q →+* Rp) hcomp K
  have hKQle : Iq ≤ maximalIdeal Q := by
    rw [hIq, ← IsLocalization.AtPrime.map_eq_maximalIdeal m Q]
    exact Ideal.map_mono (le_maximalIdeal hK)
  have hIqne : Iq ≠ ⊤ :=
    ne_top_of_le_ne_top (maximalIdeal.isMaximal Q).ne_top hKQle
  let : Nontrivial (Q ⧸ Iq) := Ideal.Quotient.nontrivial_iff.mpr hIqne
  let : IsLocalRing (Q ⧸ Iq) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk Iq) Ideal.Quotient.mk_surjective
  let eQ : Q ⧸ Iq ≃+* A := (Ideal.quotientEquiv Iq K ψ hψK.symm).trans e
  let LQ : Ideal (Q ⧸ Iq) := (maximalIdeal Q).map (Ideal.Quotient.mk Iq)
  have hLQ : LQ = maximalIdeal (Q ⧸ Iq) :=
    IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk Iq)
      Ideal.Quotient.mk_surjective
  have hL : Ideal.map (↑eQ) LQ = maximalIdeal A := by
    rw [hLQ]
    exact IsLocalRing.map_ringEquiv_maximalIdeal eQ
  obtain ⟨eC, _⟩ := exists_adicCompletion_ringEquiv_of_ringEquiv eQ LQ (maximalIdeal A) hL
  have hciQB : IsCompleteIntersectionCompleteLocalRing (AdicCompletion LQ (Q ⧸ Iq)) := hciQ
  exact hciQB.of_ringEquiv eC

/-- For a quotient of the localization of a regular ring at a prime, the completion is a complete
intersection if and only if the extended ideal is generated by a regular sequence, if and only if
its conormal module can be generated by the codimension number of elements. -/
@[stacks 09Q1, ega "IV 19.3.2"]
public lemma quotient_regular_ring_tfae
    {R : Type u} [CommRing R] [IsRegularRing R]
    (p : Ideal R) [p.IsPrime] (I : Ideal R) (hIp : I ≤ p)
    (Rp : Type u) [CommRing Rp] [Algebra R Rp] [IsLocalization.AtPrime Rp p]
    (A : Type v) [CommRing A] [IsLocalRing A]
    (q : Rp →+* A) (hq : Function.Surjective q)
    (hker : RingHom.ker q = I.map (algebraMap R Rp)) :
    List.TFAE
      [IsCompleteIntersectionCompleteLocalRing
          (AdicCompletion (maximalIdeal A) A),
        ∃ rs : List Rp, IsRegular Rp rs ∧
          Ideal.ofList rs = I.map (algebraMap R Rp),
    ∃ c : ℕ,
          ringKrullDim A + (c : WithBot ℕ∞) = ringKrullDim Rp ∧
            (⊤ : Submodule
              (Rp ⧸ (I.map (algebraMap R Rp)))
              (I.map (algebraMap R Rp)).Cotangent).spanFinrank ≤ c] := by
  let K : Ideal Rp := I.map (algebraMap R Rp)
  -- The hypothesis `I ≤ p` enters only through `K`, which the localization makes proper.
  have _hIp : I ≤ p := hIp
  have hRp : IsRegularLocalRing Rp :=
    IsRegularRing.isRegularLocalRing_of_isLocalization p Rp
  have hCM : Module.IsMaximalCohenMacaulay Rp Rp :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      Rp).2
  have hK : K ≠ ⊤ := fun htop => RingHom.ker_ne_top q (hker.trans htop)
  have e : Rp ⧸ K ≃+* A :=
    (Ideal.quotientEquivAlgOfEq Rp hker.symm).toRingEquiv.trans
      (RingHom.quotientKerEquivOfSurjective hq)
  tfae_have 1 → 2 :=
    exists_isRegular_ofList_eq_of_isCompleteIntersectionCompleteLocalRing K hK e
  tfae_have 2 → 3 := by
    rintro ⟨rs, hrs, hrsK⟩
    have h00SE := IsRegularLocalRing.exists_isRegular_ker_tfae
      (A := Rp) (B := Rp) (C := A) (f := RingHom.id Rp) (g := q)
      (Function.surjective_id) hq
    have hex : ∃ rs' : List Rp, IsRegular Rp rs' ∧
        Ideal.ofList rs' = RingHom.ker (q.comp (RingHom.id Rp)) :=
      ⟨rs, hrs, by simpa using hrsK.trans hker.symm⟩
    have hdim := (h00SE.out 1 2).mp hex
    refine ⟨K.spanFinrank, ?_, ?_⟩
    · simpa [K, hker] using hdim
    · rw [Ideal.spanFinrank_top_cotangent_eq_spanFinrank K hK]
  tfae_have 3 → 2 := by
    rintro ⟨c, hc, hcot⟩
    have hc' : ringKrullDim (Rp ⧸ K) + (c : WithBot ℕ∞) = ringKrullDim Rp := by
      simpa [← ringKrullDim_eq_of_ringEquiv e] using hc
    have hlocal :=
      Module.IsMaximalCohenMacaulay.tfae_spanFinrank_cotangent hCM hK c hc'
    exact (hlocal.out 2 4).mp hcot
  tfae_have 2 → 1 := fun ⟨rs, hrs, hrsK⟩ =>
    isCompleteIntersectionCompleteLocalRing_of_isRegular_ofList_eq K hK e rs hrs hrsK
  tfae_finish

private theorem isCompleteIntersectionRing_quotient_of_regularSequence
    {R : Type*} [CommRing R] [IsRegularLocalRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)]
    [IsNoetherianRing (R ⧸ I)] (rs : List R)
    (hrs : IsRegular R rs) (hI : Ideal.ofList rs = I) :
    IsCompleteIntersectionRing (R ⧸ I) := by
  let A := R ⧸ I
  have hIne : I ≠ ⊤ := hI ▸ ne_top_of_isRegular_ofList hrs
  let : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr hIne
  let : IsLocalRing A := IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective
  let B := AdicCompletion (maximalIdeal R) R
  have hBreg : IsRegularLocalRing B :=
    (isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp inferInstance)
  have hs : IsRegular B (rs.map (algebraMap R B)) := isRegular_map_adicCompletion hrs
  let C := AdicCompletion (maximalIdeal A) A
  let f : B →+* C := adicCompletionMapQuotient I
  have hf : Function.Surjective f := adicCompletionMapQuotient_surjective I
  refine ⟨B, inferInstance, hBreg, f, ⟨hf, IsLocalHom.of_surjective f hf, ?_⟩⟩
  refine ⟨rs.map (algebraMap R B), hs, ?_⟩
  show Ideal.ofList (rs.map (algebraMap R B)) = RingHom.ker f
  rw [ker_adicCompletionMapQuotient I, ← Ideal.map_ofList, hI]

/-- Being a complete intersection ring transports along a ring isomorphism: the isomorphism
carries the maximal ideal to the maximal ideal and is an isomorphism on residue fields, so it
lifts to the completions, and composing a regular-local presentation of one completion with that
lift is a regular-local presentation of the other. -/
public theorem isCompleteIntersectionRing_of_ringEquiv
    {A B : Type v} [CommRing A] [CommRing B] [IsNoetherianRing A] [IsNoetherianRing B]
    [IsLocalRing A] [IsLocalRing B] (e : A ≃+* B)
    (hA : IsCompleteIntersectionRing A) :
    IsCompleteIntersectionRing B := by
  obtain ⟨eC, -⟩ := exists_adicCompletion_ringEquiv_of_ringEquiv e (maximalIdeal A)
    (maximalIdeal B) (IsLocalRing.map_ringEquiv_maximalIdeal e)
  obtain ⟨R, hR, hreg, f, hf, hlocal, rs, hrs, hker⟩ := hA
  refine ⟨R, hR, hreg, eC.toRingHom.comp f, eC.surjective.comp hf,
    IsLocalHom.of_surjective (eC.toRingHom.comp f) (eC.surjective.comp hf), rs, hrs, ?_⟩
  ext x
  show x ∈ Ideal.ofList rs ↔ eC (f x) = 0
  rw [map_eq_zero_iff _ eC.injective, ← RingHom.mem_ker, hker]

section PrivateUniverse

universe w

private theorem small_of_essFiniteType {K : Type u} {A : Type v} [CommRing K] [CommRing A]
    [Algebra K A] [Small.{w} K] [Algebra.EssFiniteType K A] : Small.{w} A := by
  classical
  obtain ⟨s, hs⟩ := Algebra.EssFiniteType.cond (R := K) (S := A)
  let A₀ := Algebra.adjoin K (s : Set A)
  have : Small.{w} A₀ := Algebra.small_adjoin
  let M := Submonoid.comap (algebraMap A₀ A) (IsUnit.submonoid A)
  have : IsLocalization M A := hs
  exact small_of_surjective (f := fun p : A₀ × M => IsLocalization.mk' A p.1 p.2)
    (fun z => by obtain ⟨x, y, h⟩ := IsLocalization.exists_mk'_eq M z; exact ⟨(x, y), h⟩)

private theorem isCompleteIntersectionRing_of_isCompleteIntersection
    (k : Type u) [Field k] (A : Type v) [CommRing A] [Algebra k A]
    [IsNoetherianRing A] [IsLocalRing A]
    (hA : IsCompleteIntersection k A) : IsCompleteIntersectionRing A := by
  have hinj : Function.Injective (algebraMap k A) := FaithfulSMul.algebraMap_injective k A
  let : Small.{v} k := small_of_injective hinj
  obtain ⟨R, hR, hRk, hreg, hess, rs, hrs, ⟨eA⟩⟩ := hA
  let : Small.{v} R := small_of_essFiniteType (K := k) (A := R)
  let R' := Shrink.{v} R
  let eR : R' ≃+* R := Shrink.ringEquiv.{v} R
  let : IsRegularLocalRing R' := IsRegularLocalRing.of_ringEquiv eR.symm
  let I₀ : Ideal R := Ideal.ofList rs
  let rs' : List R' := rs.map eR.symm
  let I' : Ideal R' := Ideal.ofList rs'
  have hrs' : IsRegular R' rs' := isRegular_map_ringEquiv eR.symm hrs
  let f : R' →+* A := eA.symm.toRingHom.comp
    ((Ideal.Quotient.mk I₀).comp eR.toRingHom)
  have hf : Function.Surjective f := eA.symm.surjective.comp
    (Ideal.Quotient.mk_surjective.comp eR.surjective)
  have hI' : I' = I₀.map eR.symm := by
    dsimp [I', rs', I₀]
    exact (Ideal.map_ofList eR.symm.toRingHom rs).symm
  have hmem (x : R') : eR x ∈ I₀ ↔ x ∈ I' := by
    rw [hI']
    show eR x ∈ I₀ ↔ x ∈ I₀.map eR.symm.toRingHom
    rw [Ideal.mem_map_iff_of_surjective eR.symm.toRingHom eR.symm.surjective]
    refine ⟨fun hx => ⟨eR x, hx, eR.symm_apply_apply x⟩, ?_⟩
    rintro ⟨y, hy, rfl⟩
    simpa using hy
  have hker : RingHom.ker f = I' := by
    ext x
    show eA.symm (Ideal.Quotient.mk I₀ (eR x)) = 0 ↔ x ∈ I'
    rw [map_eq_zero_iff _ eA.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem x
  let eQ : (R' ⧸ I') ≃+* A :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hf)
  let : IsLocalRing (R' ⧸ I') := eQ.symm.isLocalRing
  let : IsNoetherianRing (R' ⧸ I') := isNoetherianRing_of_ringEquiv A eQ.symm
  exact isCompleteIntersectionRing_of_ringEquiv eQ
    (isCompleteIntersectionRing_quotient_of_regularSequence I' rs' hrs' rfl)

private theorem isCompleteIntersectionCompleteLocalRing_of_isCompleteIntersectionRing
    (A : Type v) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (hA : IsCompleteIntersectionRing A) :
    IsCompleteIntersectionCompleteLocalRing
      (AdicCompletion (maximalIdeal A) A) :=
  ⟨⟨inferInstance, inferInstance,
    AdicCompletion.isAdicComplete_of_fg (maximalIdeal A).fg_of_isNoetherianRing⟩, hA⟩

private theorem exists_regularSequence_of_completeIntersectionRing
    {A R : Type v} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [CommRing R] [IsRegularRing R] [IsLocalRing R] (f : R →+* A) (hf : Function.Surjective f)
    (hA : IsCompleteIntersectionRing A) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f := by
  let p := maximalIdeal R
  let I := RingHom.ker f
  have hIp : I ≤ p := le_maximalIdeal (RingHom.ker_ne_top f)
  let : IsLocalization.AtPrime R p :=
    IsLocalization.of_le_isUnit (fun x hx => IsLocalRing.notMem_maximalIdeal.mp hx)
  have hker : RingHom.ker f = I.map (algebraMap R R) := by
    simp [I]
  obtain ⟨rs, hrs, hseq⟩ := ((quotient_regular_ring_tfae p I hIp R A f hf hker).out 1 2).mp
    (isCompleteIntersectionCompleteLocalRing_of_isCompleteIntersectionRing A hA)
  exact ⟨rs, hrs, hseq.trans hker.symm⟩

private theorem isCompleteIntersectionRing_ulift
    (A : Type v) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (hA : IsCompleteIntersectionRing A)
    (hN : IsNoetherianRing (ULift.{w} A)) (hL : IsLocalRing (ULift.{w} A)) :
    IsCompleteIntersectionRing (ULift.{w} A) := by
  let eA : ULift.{w} A ≃+* A := ULift.ringEquiv
  let eA' : A ≃+* ULift.{w} A := eA.symm
  obtain ⟨eC, -⟩ := exists_adicCompletion_ringEquiv_of_ringEquiv eA' (maximalIdeal A)
    (maximalIdeal (ULift.{w} A)) (IsLocalRing.map_ringEquiv_maximalIdeal eA')
  obtain ⟨R, hR, hreg, f, hf, hlocalf, rs, hrs, hker⟩ := hA
  let eR : R ≃+* ULift.{w} R := ULift.ringEquiv.symm
  let f' : ULift.{w} R →+*
      AdicCompletion (maximalIdeal (ULift.{w} A)) (ULift.{w} A) :=
    eC.toRingHom.comp (f.comp eR.symm.toRingHom)
  have hf' : Function.Surjective f' := eC.surjective.comp (hf.comp eR.symm.surjective)
  have hreg' : IsRegularLocalRing (ULift.{w} R) := IsRegularLocalRing.of_ringEquiv eR
  have hseq : IsRegular (ULift.{w} R) (rs.map eR) := isRegular_map_ringEquiv eR hrs
  have hker' : Ideal.ofList (rs.map eR) = RingHom.ker f' := by
    calc
      Ideal.ofList (rs.map eR) = (Ideal.ofList rs).map eR.toRingHom :=
        (Ideal.map_ofList eR.toRingHom rs).symm
      _ = (Ideal.ofList rs).comap eR.symm.toRingHom := Ideal.map_comap_of_equiv eR
      _ = (RingHom.ker f).comap eR.symm.toRingHom := by rw [hker]
      _ = RingHom.ker (f.comp eR.symm.toRingHom) := by rw [RingHom.comap_ker]
      _ = RingHom.ker f' := by
        rw [RingHom.ker_comp_of_injective _ (f := eC.toRingHom) eC.injective]
  exact ⟨ULift.{w} R, inferInstance, hreg', f', hf', IsLocalHom.of_surjective f' hf',
    rs.map eR, hseq, hker'⟩

private theorem isCompleteIntersection_of_algEquiv
    (k : Type u) [Field k] {A B : Type v} [CommRing A] [CommRing B]
    [Algebra k A] [Algebra k B] (e : A ≃ₐ[k] B)
    (hA : IsCompleteIntersection k A) : IsCompleteIntersection k B := by
  obtain ⟨R, hR, hRk, hreg, hess, fs, hfs, ⟨eA⟩⟩ := hA
  exact ⟨R, hR, hRk, hreg, hess, fs, hfs, ⟨e.symm.trans eA⟩⟩

end PrivateUniverse

attribute [-instance] IsPrincipalIdealRing.of_isSimpleRing IsDomain.of_isSimpleRing in
/-- **Stacks 09Q6 (1).** For a finite type algebra over a field, its local ring at a prime is a
complete intersection over the field if and only if it is a complete intersection ring in the
completion-based sense. -/
@[stacks 09Q6 "part (1)"]
public theorem isCompleteIntersection_atPrime_iff_isCompleteIntersectionRing
    (k : Type u) [Field k] (S : Type v) [CommRing S] [Algebra k S]
    [Algebra.FiniteType k S] (q : Ideal S) [q.IsPrime] :
    letI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
    letI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
    IsCompleteIntersection k (Localization.AtPrime q) ↔
      IsCompleteIntersectionRing (Localization.AtPrime q) := by
  let A := Localization.AtPrime q
  let : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
  let : IsNoetherianRing A := IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
  let : IsLocalRing A := IsLocalization.AtPrime.isLocalRing A q
  refine ⟨isCompleteIntersectionRing_of_isCompleteIntersection k A, fun hA => ?_⟩
  let : Algebra.EssFiniteType k A := Algebra.EssFiniteType.comp k S A
  have hseq :
      ∀ (R : Type (max u (max u v))) (hR : CommRing R) (hRk : Algebra k R)
        (hreg : IsRegularLocalRing R) (hess : Algebra.EssFiniteType k R)
        (f : R →ₐ[k] A), Function.Surjective f →
          ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker f := by
    intro R _ _ hreg _ f hf
    let : IsRegularRing R := ((IsLocalRing.isRegularRing_tfae (R := R)).out 1 3).mp hreg
    let eA : ULift.{max u v} A ≃+* A := ULift.ringEquiv
    let : IsLocalRing (ULift.{max u v} A) := eA.symm.isLocalRing
    let : IsNoetherianRing (ULift.{max u v} A) :=
      isNoetherianRing_of_ringEquiv A eA.symm
    have hAlift : IsCompleteIntersectionRing (ULift.{max u v} A) :=
      isCompleteIntersectionRing_ulift A hA inferInstance inferInstance
    let f' : R →+* ULift.{max u v} A := eA.symm.toRingHom.comp f
    have hf' : Function.Surjective f' := eA.symm.surjective.comp hf
    obtain ⟨rs, hrs, hker⟩ :=
      exists_regularSequence_of_completeIntersectionRing f' hf' hAlift
    exact ⟨rs, hrs,
      hker.trans (RingHom.ker_comp_of_injective _ (f := eA.symm.toRingHom) eA.symm.injective)⟩
  exact ((IsCompleteIntersection.tfae k A).out 2 1).mp hseq

attribute [-instance] IsPrincipalIdealRing.of_isSimpleRing IsDomain.of_isSimpleRing in
/-- **Stacks 09Q6 (2).** For a finite type algebra over a field, being a local complete
intersection over that field is equivalent to being a local complete intersection ring in the
completion-based sense. -/
@[stacks 09Q6 "part (2)"]
public theorem isLocalCompleteIntersection_iff_isLocalCompleteIntersectionRing
    (k : Type u) [Field k] (S : Type v) [CommRing S] [Algebra k S]
    [Algebra.FiniteType k S] :
    letI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
    IsLocalCompleteIntersection k S ↔ IsLocalCompleteIntersectionRing S := by
  let t := IsLocalCompleteIntersection.tfae k S
  refine ⟨fun hS q _ => ?_, fun hS => (t.out 2 1).mp ?_⟩
  · have hpoint := (t.out 1 2).mp hS
    exact (isCompleteIntersection_atPrime_iff_isCompleteIntersectionRing k S q).mp
      (hpoint q (Localization.AtPrime q))
  · intro q _ Sq _ _ _ _ _
    exact isCompleteIntersection_of_algEquiv k
      ((IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) Sq).restrictScalars k)
      ((isCompleteIntersection_atPrime_iff_isCompleteIntersectionRing k S q).mpr (hS q))

end LocalCompleteIntersection

end
