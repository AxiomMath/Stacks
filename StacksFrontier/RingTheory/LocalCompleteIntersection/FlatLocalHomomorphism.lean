/-!
# Complete intersections and flat local homomorphisms

Let `A → B` be a flat local homomorphism of Noetherian local rings. This file proves that the
completion of `B` is a complete intersection exactly when the completion of `A` and the
completion of the closed fibre `B / 𝔪_A B` both are.

Both completions are quotients of regular local rings by an explicit comparison of presentations:
a flat local homomorphism of complete local rings is dominated by a flat local homomorphism
`R → S` of regular complete local rings with regular closed fibre, and the two kernels `I ⊆ R`
and `J ⊆ S` then satisfy `IS ⊆ J`. In that situation the three conditions of
[Stacks, Tag 09PX] apply: `B^` is a complete intersection iff `J` is generated by a regular
sequence, which — since `S / J` is flat over `R / I` and therefore of finite Tor dimension —
happens iff `I` and `J / IS` are generated by regular sequences. The first of these is `A^` being
a complete intersection and the second is the closed fibre being one, the latter after
identifying `J / IS` inside `S / IS` with the ideal cutting out the fibre.

## Main results

* `LocalCompleteIntersection.isCompleteIntersectionCompleteLocalRing_congr`: the complete
  intersection condition on a complete local ring transports along a ring isomorphism.
* `LocalCompleteIntersection.isCompleteIntersectionCompleteLocalRing_iff_adicCompletion`: a
  Noetherian complete local ring is a complete intersection exactly when its completion is.
* `LocalCompleteIntersection.isCompleteIntersectionCompleteLocalRing_adicCompletion_iff_of_flat`:
  the criterion for a flat local homomorphism.

## Implementation notes

The closed fibre is represented as the quotient of the target by the extension of the maximal
ideal of the source. The condition used throughout is
`LocalCompleteIntersection.IsCompleteIntersectionCompleteLocalRing`, the presentation-free
condition on a Noetherian complete local ring.

The step `regIdeal_iff_fiber_regIdeal` — that for a flat local homomorphism with flat quotient an
ideal of the target is generated by a regular sequence exactly when its image in the closed fibre
is — is where the flatness hypothesis does its work: Koszul `H₁`-regularity base changes along
`A → A / 𝔪_A`, and a lift of a regular sequence generating the image generates the ideal itself
by Nakayama.

## References

* [Stacks Project, Tag 09Q2](https://stacks.math.columbia.edu/tag/09Q2)
-/

@[expose] public section

namespace LocalCompleteIntersection

open scoped TensorProduct
open IsLocalRing
open CategoryTheory RingTheory.Sequence
open Stacks.Flatness.RegularSequenceQuotient

universe u v

/-- Generation of an ideal by a regular sequence is invariant under a ring isomorphism. -/
private theorem generatedRegularSequence_map_ringEquiv
    {A B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B) (I : Ideal A) :
    Ideal.IsGeneratedByRegularSequence I ↔
      Ideal.IsGeneratedByRegularSequence (I.map e.toRingHom) := by
  constructor
  · rintro ⟨rs, hrs, hgen⟩
    refine ⟨rs.map e.toRingHom, (isRegular_ringEquiv_congr e rs).mp hrs, ?_⟩
    rw [← Ideal.map_ofList]
    exact congrArg (Ideal.map e.toRingHom) hgen
  · rintro ⟨rs, hrs, hgen⟩
    refine ⟨rs.map e.symm.toRingHom, (isRegular_ringEquiv_congr e.symm rs).mp hrs, ?_⟩
    calc
      Ideal.ofList (rs.map e.symm.toRingHom) =
          (I.map e.toRingHom).map e.symm.toRingHom := by
        rw [← Ideal.map_ofList, ← hgen]
      _ = I := by simp [Ideal.map_map]

private theorem isCompleteIntersectionCompleteLocalRing_of_ringEquiv
    {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B)
    (h : IsCompleteIntersectionCompleteLocalRing A) :
    IsCompleteIntersectionCompleteLocalRing B := by
  obtain ⟨hA, T, hTRing, hT, f, hf, hflocal, rs, hrs, hker⟩ := h
  have : IsNoetherianRing A := hA.isNoetherian
  have : IsLocalRing A := hA.isLocal
  have : IsAdicComplete (maximalIdeal A) A := hA.isComplete
  let : CommRing T := hTRing
  have : IsRegularLocalRing T := hT
  have : IsLocalRing B := e.isLocalRing
  have hB : IsNoetherianCompleteLocalRing B := by
    refine ⟨isNoetherianRing_of_ringEquiv A e, inferInstance, ?_⟩
    simpa only [IsLocalRing.map_ringEquiv_maximalIdeal] using
      (IsAdicComplete.congr_ringEquiv (maximalIdeal A) e).mpr hA.isComplete
  have : IsLocalHom e.toRingHom := IsLocalHom.of_surjective _ e.surjective
  have : IsLocalHom f := hflocal
  refine ⟨hB, T, inferInstance, hT, e.toRingHom.comp f, e.surjective.comp hf,
    RingHom.isLocalHom_comp e.toRingHom f, rs, hrs, ?_⟩
  rw [RingHom.ker_comp_of_injective f e.injective, hker]

/-- Being a complete intersection, as a Noetherian complete local ring, transports along a ring
isomorphism. -/
theorem isCompleteIntersectionCompleteLocalRing_congr
    {A B : Type u} [CommRing A] [CommRing B] (e : A ≃+* B) :
    IsCompleteIntersectionCompleteLocalRing A ↔
      IsCompleteIntersectionCompleteLocalRing B :=
  ⟨isCompleteIntersectionCompleteLocalRing_of_ringEquiv e,
    isCompleteIntersectionCompleteLocalRing_of_ringEquiv e.symm⟩

/-- A Noetherian complete local ring is a complete intersection exactly when its completion at
the maximal ideal is: the two are isomorphic. -/
theorem isCompleteIntersectionCompleteLocalRing_iff_adicCompletion
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (hA : IsNoetherianCompleteLocalRing A) :
    IsCompleteIntersectionCompleteLocalRing A ↔
      IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal A) A) :=
  let _ : IsAdicComplete (maximalIdeal A) A := hA.isComplete
  isCompleteIntersectionCompleteLocalRing_congr
    (RingEquiv.ofBijective (algebraMap A (AdicCompletion (maximalIdeal A) A))
      (by
        show Function.Bijective (AdicCompletion.of (maximalIdeal A) A)
        exact AdicCompletion.of_bijective _ _))

/-- The kernel of a ring homomorphism into a nonzero ring consists of nonunits. -/
private theorem ker_le_maximalIdeal
    {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [Nontrivial S]
    (f : R →+* S) : RingHom.ker f ≤ maximalIdeal R := by
  intro x hx hunit
  exact not_isUnit_zero (RingHom.mem_ker.mp hx ▸ hunit.map f)

/-- For a surjection onto a Noetherian local ring from a regular local ring, the completion of
the target is a complete intersection exactly when the kernel is generated by a regular
sequence. -/
@[ega "IV 19.3.1" "more general"]
private theorem completeIntersection_adicCompletion_iff_regularSequence_ker
    {R : Type u} {C : Type v} [CommRing R] [IsRegularLocalRing R]
    [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
    (q : R →+* C) [IsLocalHom q] (hq : Function.Surjective q) :
    IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal C) C) ↔
      ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker q := by
  let p := maximalIdeal R
  have : p.IsPrime := (maximalIdeal.isMaximal R).isPrime
  have : IsLocalization.AtPrime R p :=
    IsLocalization.self (fun x hx => IsLocalRing.notMem_maximalIdeal.mp hx)
  have hker : RingHom.ker q = (RingHom.ker q).map (algebraMap R R) := by
    simp [Algebra.algebraMap_self]
  have : IsRegularRing R :=
    ((IsLocalRing.isRegularRing_tfae (R := R)).out 1 3).mp (inferInstance : IsRegularLocalRing R)
  have h12 :
      IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal C) C) ↔
        ∃ rs : List R, IsRegular R rs ∧
          Ideal.ofList rs = (RingHom.ker q).map (algebraMap R R) :=
    (quotient_regular_ring_tfae (R := R) p (RingHom.ker q) (ker_le_maximalIdeal q)
      (Rp := R) (A := C) q hq hker).out 1 2
  simpa only [← hker] using h12

/-- For a surjection onto a Noetherian complete local ring from a regular local ring, the target
is a complete intersection exactly when the kernel is generated by a regular sequence. -/
private theorem completeIntersection_iff_regularSequence_ker
    {R : Type u} {C : Type v} [CommRing R] [IsRegularLocalRing R]
    [CommRing C] [IsLocalRing C] [IsNoetherianRing C]
    (hC : IsNoetherianCompleteLocalRing C)
    (q : R →+* C) [IsLocalHom q] (hq : Function.Surjective q) :
    IsCompleteIntersectionCompleteLocalRing C ↔
      ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker q :=
  (isCompleteIntersectionCompleteLocalRing_iff_adicCompletion hC).trans
    (completeIntersection_adicCompletion_iff_regularSequence_ker q hq)

/-- The quotient of a local ring by an ideal inside the maximal ideal is local. -/
private theorem isLocalRing_quotient_of_le_maximalIdeal
    {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    IsLocalRing (R ⧸ I) :=
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hI)
  .of_surjective' _ Ideal.Quotient.mk_surjective

/-- The image of an ideal inside the maximal ideal lies in the maximal ideal of a local quotient. -/
private theorem map_mk_le_maximalIdeal_quotient
    {R : Type*} [CommRing R] [IsLocalRing R] (I J : Ideal R) [IsLocalRing (R ⧸ I)]
    (hJ : J ≤ maximalIdeal R) : J.map (Ideal.Quotient.mk I) ≤ maximalIdeal (R ⧸ I) := by
  rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective]
  exact Ideal.map_mono hJ

/-- A flat module has Tor dimension zero. -/
private theorem finiteTorDimension_of_flat
    {R : Type u} [CommRing R] (M : ModuleCat.{u} R) [Module.Flat R M] :
    Stacks.CompleteIntersection.FiniteTorDimension M := by
  refine ⟨0, fun N p hp => ?_⟩
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : p ≠ 0)
  exact Tor_iso_Tor'.tor_flat_isZero (R := R) M N n

/-- The quotient of a flat algebra by the extension of an ideal is flat over the quotient by that
ideal: it is the base change of the flat algebra along the quotient map. -/
private theorem flat_quotient_base_change
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
    (I : Ideal R) :
    Module.Flat (R ⧸ I) (S ⧸ (I.map (algebraMap R S))) := by
  let r0 := R ⧸ I
  let s0 := S ⧸ (I.map (algebraMap R S))
  let eS := Algebra.TensorProduct.quotIdealMapEquivTensorQuot S I
  let ec := Algebra.TensorProduct.comm R S r0
  let e : s0 ≃+* TensorProduct R r0 S := eS.toRingEquiv.trans ec.toRingEquiv
  have hscalar : ∀ a, e (algebraMap r0 s0 a) = algebraMap r0 (TensorProduct R r0 S) a := by
    intro a
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
    show ec (eS (Ideal.Quotient.mk (I.map (algebraMap R S)) (algebraMap R S r))) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk,
      Algebra.TensorProduct.tmul_one_eq_one_tmul, Algebra.TensorProduct.comm_tmul]
    rfl
  have : Module.Flat r0 (TensorProduct R r0 S) := Module.Flat.baseChange R r0 S
  exact Module.Flat.of_linearEquiv (AlgEquiv.ofRingEquiv (f := e) hscalar).toLinearEquiv

/-- Koszul `H₁`-regularity of a sequence whose quotient is flat over a local base passes to the
closed fibre. -/
private theorem isH1Regular_fiber_of_isH1Regular
    {A : Type u} {T : Type v} [CommRing A] [CommRing T] [IsLocalRing A] [Algebra A T]
    {n : ℕ} (f : Fin n → T) (hflat : Module.Flat A (T ⧸ Ideal.span (Set.range f)))
    (hf : Koszul.IsH1Regular f) :
    Koszul.IsH1Regular fun i =>
      Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A T)) (f i) := by
  let k := A ⧸ maximalIdeal A
  let e : T ⧸ (maximalIdeal A).map (algebraMap A T) ≃+* (T ⊗[A] k) :=
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T (maximalIdeal A)).toRingEquiv
  have h := isH1Regular_map_ringEquiv e.symm _
    ((Koszul.quasiRegular_and_h1Regular_baseChange_of_quotient_flat
      (A := A) (B := T) (A' := k) f hflat).2 hf)
  have hpoint : (fun i => e.symm (KoszulH1.fp (A := A) (A' := k) f i)) =
      fun i => Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A T)) (f i) := by
    funext i
    show (Algebra.TensorProduct.quotIdealMapEquivTensorQuot T (maximalIdeal A)).symm
      (f i ⊗ₜ[A] (Ideal.Quotient.mk (maximalIdeal A) (1 : A))) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    simp
  rwa [hpoint] at h

/-- For a flat local homomorphism `A → T` and an ideal `Q` inside the maximal ideal with `T / Q`
flat over `A`, if `Q` is generated by a regular sequence then so is its image in the closed
fibre. -/
private theorem regIdeal_fiber_of_regIdeal
    {A : Type u} {T : Type v} [CommRing A] [CommRing T]
    [IsNoetherianRing A] [IsNoetherianRing T] [IsLocalRing A] [IsLocalRing T]
    [Algebra A T] [IsLocalHom (algebraMap A T)] [Module.Flat A T]
    (Q : Ideal T) (hQ : Q ≤ maximalIdeal T) (hflat : Module.Flat A (T ⧸ Q))
    (hreg : Ideal.IsGeneratedByRegularSequence Q) :
    Ideal.IsGeneratedByRegularSequence
      (Q.map (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A T)))) := by
  obtain ⟨rs, hrs, hspan⟩ := hreg
  let M := (maximalIdeal A).map (algebraMap A T)
  let F := T ⧸ M
  have : IsLocalRing F :=
    isLocalRing_quotient_of_le_maximalIdeal M (IsLocalRing.map_maximalIdeal_le (algebraMap A T))
  let qF : T →+* F := Ideal.Quotient.mk M
  have : IsLocalHom qF := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  let n := rs.length
  let f : Fin n → T := List.get rs
  have hlist : List.ofFn f = rs := List.ofFn_get rs
  have hmem : ∀ i, f i ∈ maximalIdeal T := by
    intro i
    refine hQ ?_
    rw [← hspan]
    exact Ideal.subset_span (List.get_mem ..)
  have hh1 : Koszul.IsH1Regular f := by
    apply ((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae
      (M := T) f hmem).2.out 1 3).mp
    simpa [hlist] using hrs
  have hfspan : Ideal.span (Set.range f) = Q := by
    have hspanFn : Ideal.ofList (List.ofFn f) = Q := by rwa [hlist]
    rw [← hspanFn, Ideal.ofList, show {x | x ∈ List.ofFn f} = Set.range f from
      Set.ext (List.mem_ofFn' f)]
  have h1fiber : Koszul.IsH1Regular (fun i => qF (f i)) :=
    isH1Regular_fiber_of_isH1Regular f (by rwa [hfspan]) hh1
  have hfmem : ∀ i, qF (f i) ∈ maximalIdeal F := fun i =>
    map_mk_le_maximalIdeal_quotient M _ le_rfl (Ideal.mem_map_of_mem qF (hmem i))
  have hregF : IsRegular F (List.ofFn (fun i => qF (f i))) :=
    ((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae
      (M := F) (fun i => qF (f i)) hfmem).2.out 3 1).mp h1fiber
  have hspanF : Ideal.ofList (rs.map qF) = Q.map qF := by
    simpa only [Ideal.map_ofList] using congrArg (Ideal.map qF) hspan
  have hmaplist : rs.map qF = List.ofFn (fun i => qF (f i)) := by
    rw [← hlist]
    simp only [List.map_ofFn, Function.comp_def]
  exact ⟨rs.map qF, hmaplist ▸ hregF, hspanF⟩

/-- For a flat local homomorphism `A → T` and an ideal `Q` with `T / Q` flat over `A`, a regular
sequence generating the image of `Q` in the closed fibre lifts to one generating `Q`. -/
private theorem regIdeal_of_fiber_regIdeal
    {A : Type u} {T : Type v} [CommRing A] [CommRing T]
    [IsNoetherianRing A] [IsNoetherianRing T] [IsLocalRing A] [IsLocalRing T]
    [Algebra A T] [IsLocalHom (algebraMap A T)] [Module.Flat A T]
    (Q : Ideal T) (hflat : Module.Flat A (T ⧸ Q))
    (hreg : Ideal.IsGeneratedByRegularSequence
      (Q.map (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A T))))) :
    Ideal.IsGeneratedByRegularSequence Q := by
  obtain ⟨rsF, hrsF, hspanF⟩ := hreg
  let M := (maximalIdeal A).map (algebraMap A T)
  let F := T ⧸ M
  let qF : T →+* F := Ideal.Quotient.mk M
  let fF : Fin rsF.length → F := List.get rsF
  have hlift : ∀ i, ∃ y : T, y ∈ Q ∧ qF y = fF i := by
    intro i
    have hxi : fF i ∈ Q.map qF := by
      rw [← hspanF]
      exact Ideal.subset_span (List.get_mem ..)
    exact (Ideal.mem_map_iff_of_surjective qF Ideal.Quotient.mk_surjective).mp hxi
  choose f hfQ hqf using hlift
  have hmaprs : (List.ofFn f).map qF = rsF :=
    calc
      List.map qF (List.ofFn f) = List.ofFn (fun i => qF (f i)) := by
        simp only [List.map_ofFn, Function.comp_def]
      _ = List.ofFn fF := congrArg List.ofFn (funext hqf)
      _ = rsF := List.ofFn_get rsF
  have hrsF' : IsRegular F ((List.ofFn f).map qF) := by rwa [hmaprs]
  obtain ⟨hrsT, -⟩ :=
    Module.Flat.isRegular_and_flat_quotient_ofList_take_of_isRegular_maximalIdeal
      (R := A) (S := T) (fs := List.ofFn f) (by simpa [M, qF] using hrsF')
  let J0 := Ideal.ofList (List.ofFn f)
  have hJ0Q : J0 ≤ Q := by
    refine Ideal.span_le.2 fun x hx => ?_
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
    exact hfQ i
  have hmapJ0 : J0.map qF = Q.map qF := by
    rw [← hspanF, ← hmaprs]
    exact Ideal.map_ofList qF _
  have hQsup : Q ≤ J0 ⊔ M := by
    intro x hx
    have hxm : qF x ∈ J0.map qF := hmapJ0 ▸ Ideal.mem_map_of_mem qF hx
    obtain ⟨y, hy, hxy⟩ :=
      (Ideal.mem_map_iff_of_surjective qF Ideal.Quotient.mk_surjective).mp hxm
    refine Submodule.mem_sup.mpr ⟨y, hy, x - y, ?_, by abel⟩
    refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
    show qF (x - y) = 0
    rw [map_sub, hxy, sub_self]
  exact ⟨List.ofFn f, hrsT, (Ideal.eq_of_le_sup_map_of_flat_quotient
    (Ideal.fg_of_isNoetherianRing Q) hJ0Q (maximalIdeal A)
    ((IsLocalRing.map_maximalIdeal_le (algebraMap A T)).trans (maximalIdeal_le_jacobson _))
    hQsup).symm⟩

/-- For a flat local homomorphism `A → T` of Noetherian local rings and an ideal `Q` of `T`
inside the maximal ideal with `T / Q` flat over `A`, the ideal `Q` is generated by a regular
sequence exactly when its image in the closed fibre `T / 𝔪_A T` is. -/
@[sga "6 VIII 1.4" "special case"]
private theorem regIdeal_iff_fiber_regIdeal
    {A : Type u} {T : Type v} [CommRing A] [CommRing T]
    [IsNoetherianRing A] [IsNoetherianRing T] [IsLocalRing A] [IsLocalRing T]
    [Algebra A T] [IsLocalHom (algebraMap A T)] [Module.Flat A T]
    (Q : Ideal T) (hQ : Q ≤ maximalIdeal T) (hflat : Module.Flat A (T ⧸ Q)) :
    Ideal.IsGeneratedByRegularSequence Q ↔
      Ideal.IsGeneratedByRegularSequence
        (Q.map (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A T)))) :=
  ⟨regIdeal_fiber_of_regIdeal Q hQ hflat, regIdeal_of_fiber_regIdeal Q hflat⟩

/-- The completion of a Noetherian local ring at its maximal ideal is a Noetherian complete
local ring. -/
private theorem isNoetherianCompleteLocalRing_adicCompletion
    (A : Type*) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] :
    IsNoetherianCompleteLocalRing (AdicCompletion (maximalIdeal A) A) :=
  ⟨AdicCompletion.isNoetherianRing (maximalIdeal A), inferInstance, by
    rw [AdicCompletion.maximalIdeal_eq_map]
    exact AdicCompletion.isAdicComplete_self (maximalIdeal A)
      (Ideal.fg_of_isNoetherianRing (maximalIdeal A))⟩

/-- If `S / J` is flat over `R / I`, then so is `(S / IS) / (J / IS)`. -/
private theorem flat_doubleQuot_of_flat
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (I : Ideal R) (J : Ideal S)
    (hIJ : I.map (algebraMap R S) ≤ J)
    (hflat : (Ideal.quotientMap J (algebraMap R S) (Ideal.map_le_iff_le_comap.mp hIJ)).Flat) :
    Module.Flat (R ⧸ I)
      ((S ⧸ I.map (algebraMap R S)) ⧸ J.map (Ideal.Quotient.mk (I.map (algebraMap R S)))) := by
  let := (Ideal.quotientMap J (algebraMap R S) (Ideal.map_le_iff_le_comap.mp hIJ)).toAlgebra
  have : Module.Flat (R ⧸ I) (S ⧸ J) := RingHom.flat_algebraMap_iff.mp hflat
  exact Module.Flat.of_linearEquiv
    (AlgEquiv.ofRingEquiv (f := DoubleQuot.quotQuotEquivQuotOfLE hIJ) fun a => by
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
      rfl).toLinearEquiv

/-- For a flat local homomorphism `R → S` and ideals `I ⊆ R`, `J ⊆ S` with `IS ⊆ J` and `S / J`
flat over `R / I`, the ideal `J / IS` is generated by a regular sequence exactly when its image
`J / 𝔪_R S` in the closed fibre is. -/
private theorem regIdeal_quotient_iff_fiber
    {R S : Type u} [CommRing R] [CommRing S] [IsNoetherianRing R] [IsNoetherianRing S]
    [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Module.Flat R S] (I : Ideal R) (J : Ideal S) (hI : I ≤ maximalIdeal R)
    (hJ : J ≤ maximalIdeal S) (hIJ : I.map (algebraMap R S) ≤ J)
    (hflat : (Ideal.quotientMap J (algebraMap R S) (Ideal.map_le_iff_le_comap.mp hIJ)).Flat) :
    Ideal.IsGeneratedByRegularSequence (J.map (Ideal.Quotient.mk (I.map (algebraMap R S)))) ↔
      Ideal.IsGeneratedByRegularSequence
        (J.map (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S)))) := by
  let IS := I.map (algebraMap R S)
  let K := (maximalIdeal R).map (algebraMap R S)
  have hISK : IS ≤ K := Ideal.map_mono hI
  have : IsLocalRing (R ⧸ I) := isLocalRing_quotient_of_le_maximalIdeal I hI
  have : IsLocalRing (S ⧸ IS) := isLocalRing_quotient_of_le_maximalIdeal IS
    (hISK.trans (IsLocalRing.map_maximalIdeal_le _))
  have hcomp : (algebraMap (R ⧸ I) (S ⧸ IS)).comp (Ideal.Quotient.mk I) =
      (Ideal.Quotient.mk IS).comp (algebraMap R S) := rfl
  have hmax : (maximalIdeal (R ⧸ I)).map (algebraMap (R ⧸ I) (S ⧸ IS)) =
      K.map (Ideal.Quotient.mk IS) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective, Ideal.map_map, hcomp, Ideal.map_map]
  have : IsLocalHom (algebraMap (R ⧸ I) (S ⧸ IS)) :=
    ((IsLocalRing.local_hom_TFAE _).out 3 1).mp <| by
      rw [hmax]
      exact map_mk_le_maximalIdeal_quotient IS K (IsLocalRing.map_maximalIdeal_le _)
  have : Module.Flat (R ⧸ I) (S ⧸ IS) := flat_quotient_base_change I
  have h := regIdeal_iff_fiber_regIdeal _ (map_mk_le_maximalIdeal_quotient IS J hJ)
    (flat_doubleQuot_of_flat I J hIJ hflat)
  rw [hmax] at h
  refine h.trans ((generatedRegularSequence_map_ringEquiv
    (DoubleQuot.quotQuotEquivQuotOfLE hISK) _).trans ?_)
  rw [Ideal.map_map, Ideal.map_map,
    show ((DoubleQuot.quotQuotEquivQuotOfLE hISK).toRingHom.comp
      (Ideal.Quotient.mk (K.map (Ideal.Quotient.mk IS)))).comp (Ideal.Quotient.mk IS) =
        Ideal.Quotient.mk K from
      RingHom.ext fun s => DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk s hISK]

/-- Given a lift `g : R → S` of a local homomorphism `fc : Ah → Bh` along surjections from `R`
and `S`, the closed fibre `Bh / 𝔪_Ah Bh` is a complete intersection exactly when the image of
`ker (S → Bh)` in the closed fibre `S / 𝔪_R S` is generated by a regular sequence. -/
private theorem completeIntersection_fiber_iff
    {Ah Bh R S : Type*} [CommRing Ah] [CommRing Bh] [CommRing R] [CommRing S]
    [IsLocalRing Ah] [IsLocalRing Bh] [IsNoetherianRing Bh] [IsLocalRing R]
    (hBh : IsNoetherianCompleteLocalRing Bh) (fc : Ah →+* Bh) [IsLocalHom fc]
    (g : R →+* S) (qA : R →+* Ah) (qB : S →+* Bh)
    (hqA : Function.Surjective qA) (hqB : Function.Surjective qB)
    (hcomm : fc.comp qA = qB.comp g) [IsRegularLocalRing (S ⧸ (maximalIdeal R).map g)] :
    IsCompleteIntersectionCompleteLocalRing (Bh ⧸ (maximalIdeal Ah).map fc) ↔
      Ideal.IsGeneratedByRegularSequence
        ((RingHom.ker qB).map (Ideal.Quotient.mk ((maximalIdeal R).map g))) := by
  let K := (maximalIdeal R).map g
  let L := (maximalIdeal Ah).map fc
  have hLproper : L ≠ ⊤ :=
    ne_top_of_le_ne_top (maximalIdeal.isMaximal Bh).ne_top (IsLocalRing.map_maximalIdeal_le fc)
  have hL : L = K.map qB := by
    dsimp only [L, K]
    rw [← IsLocalRing.map_maximalIdeal_of_surjective qA hqA, Ideal.map_map, hcomm,
      ← Ideal.map_map]
  have hKq : K ≤ RingHom.ker ((Ideal.Quotient.mk L).comp qB) := fun s hs =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (hL ▸ Ideal.mem_map_of_mem qB hs)
  let qD : (S ⧸ K) →+* Bh ⧸ L := Ideal.Quotient.lift K ((Ideal.Quotient.mk L).comp qB) hKq
  have hqD : Function.Surjective qD :=
    Ideal.Quotient.lift_surjective_of_surjective K hKq
      (Ideal.Quotient.mk_surjective.comp hqB)
  have hker : RingHom.ker qD = (RingHom.ker qB).map (Ideal.Quotient.mk K) := by
    rw [Ideal.ker_quotient_lift, ← RingHom.comap_ker, Ideal.mk_ker, hL,
      Ideal.comap_map_of_surjective' qB hqB K, Ideal.map_sup, Ideal.map_quotient_self,
      bot_sup_eq]
  have : IsLocalRing (Bh ⧸ L) :=
    isLocalRing_quotient_of_le_maximalIdeal L (IsLocalRing.map_maximalIdeal_le fc)
  have : IsLocalHom qD := IsLocalHom.of_surjective _ hqD
  simpa [Ideal.IsGeneratedByRegularSequence, hker] using
    (isCompleteIntersectionCompleteLocalRing_iff_adicCompletion
      (quotient_isNoetherianCompleteLocalRing hBh L hLproper)).trans
      (completeIntersection_adicCompletion_iff_regularSequence_ker qD hqD)

/-- Given a flat local homomorphism `R → S` of regular local rings with regular closed fibre,
lifting a flat local homomorphism `fc : Ah → Bh` of Noetherian complete local rings along
surjections, `Bh` is a complete intersection iff `Ah` and the closed fibre `Bh / 𝔪_Ah Bh`
are. -/
private theorem completeIntersection_iff_of_presentation
    {Ah Bh : Type*} {R S : Type u} [CommRing Ah] [CommRing Bh]
    [IsNoetherianRing Ah] [IsNoetherianRing Bh] [IsLocalRing Ah] [IsLocalRing Bh]
    (hAh : IsNoetherianCompleteLocalRing Ah) (hBh : IsNoetherianCompleteLocalRing Bh)
    (fc : Ah →+* Bh) [IsLocalHom fc] (hfc : fc.Flat)
    [CommRing R] [IsRegularLocalRing R] [CommRing S] [IsRegularLocalRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    [IsRegularLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S))]
    (qA : R →+* Ah) (qB : S →+* Bh) [IsLocalHom qA] [IsLocalHom qB]
    (hqA : Function.Surjective qA) (hqB : Function.Surjective qB)
    (hcomm : fc.comp qA = qB.comp (algebraMap R S)) :
    IsCompleteIntersectionCompleteLocalRing Bh ↔
      IsCompleteIntersectionCompleteLocalRing Ah ∧
        IsCompleteIntersectionCompleteLocalRing (Bh ⧸ (maximalIdeal Ah).map fc) := by
  let I := RingHom.ker qA
  let J := RingHom.ker qB
  have hIJ : I.map (algebraMap R S) ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    show (qB.comp (algebraMap R S)) r = 0
    rw [← hcomm]
    show fc (qA r) = 0
    rw [RingHom.mem_ker.mp hr, map_zero]
  let qbar := Ideal.quotientMap J (algebraMap R S) (Ideal.map_le_iff_le_comap.mp hIJ)
  let eA : (R ⧸ I) ≃+* Ah := RingHom.quotientKerEquivOfSurjective hqA
  let eB : (S ⧸ J) ≃+* Bh := RingHom.quotientKerEquivOfSurjective hqB
  have hcomm' : eB.toRingHom.comp qbar = fc.comp eA.toRingHom := by
    refine RingHom.ext fun x => ?_
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    dsimp [qbar]
    rw [Ideal.quotientMap_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk hqB,
      RingHom.quotientKerEquivOfSurjective_apply_mk hqA]
    exact (DFunLike.congr_fun hcomm r).symm
  have hqbar_eq : qbar = eB.symm.toRingHom.comp (fc.comp eA.toRingHom) :=
    RingHom.ext fun x => eB.injective <|
      (DFunLike.congr_fun hcomm' x).trans (eB.apply_symm_apply _).symm
  have hqbarflat : qbar.Flat := by
    rw [hqbar_eq]
    exact (RingHom.Flat.comp (RingHom.Flat.of_bijective eA.bijective) hfc).comp
      (RingHom.Flat.of_bijective eB.symm.bijective)
  have htor : Stacks.CompleteIntersection.FiniteTorDimension
      (Stacks.CompleteIntersection.quotientModule qbar) := by
    let := qbar.toAlgebra
    have : Module.Flat (R ⧸ I) (S ⧸ J) := RingHom.flat_algebraMap_iff.mp hqbarflat
    show Stacks.CompleteIntersection.FiniteTorDimension (ModuleCat.of (R ⧸ I) (S ⧸ J))
    exact finiteTorDimension_of_flat (ModuleCat.of (R ⧸ I) (S ⧸ J))
  have h13 := (Stacks.CompleteIntersection.regularSequence_quotient_tfae_of_flat
    (R := R) (S := S) I J (ker_le_maximalIdeal qA) hIJ inferInstance).out 1 3
  refine (completeIntersection_iff_regularSequence_ker hBh qB hqB).trans <|
    Iff.trans ?_ <| Iff.and (completeIntersection_iff_regularSequence_ker hAh qA hqA).symm <|
      (regIdeal_quotient_iff_fiber I J (ker_le_maximalIdeal qA) (ker_le_maximalIdeal qB) hIJ
        hqbarflat).trans (completeIntersection_fiber_iff hBh fc _ qA qB hqA hqB hcomm).symm
  exact ⟨fun hJ => h13.mp ⟨hJ, htor⟩, fun h => (h13.mpr h).1⟩

/-- **Stacks 09Q2.** For a flat local homomorphism `A → B` of Noetherian local rings, the
completion of `B` is a complete intersection if and only if the completion of `A` and the
completion of the closed fibre `B / 𝔪_A B` both are. -/
@[stacks 09Q2]
theorem isCompleteIntersectionCompleteLocalRing_adicCompletion_iff_of_flat
    (A : Type u) (B : Type v) [CommRing A] [CommRing B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Flat A B] :
    let I := (maximalIdeal A).map (algebraMap A B)
    let _ : Nontrivial (B ⧸ I) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (IsLocalRing.map_maximalIdeal_lt_top (algebraMap A B)).ne
    let _ : IsLocalHom (Ideal.Quotient.mk I) :=
      IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    let _ : IsLocalRing (B ⧸ I) :=
      IsLocalRing.of_surjective _ Ideal.Quotient.mk_surjective
    IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal B) B) ↔
      (IsCompleteIntersectionCompleteLocalRing (AdicCompletion (maximalIdeal A) A) ∧
        IsCompleteIntersectionCompleteLocalRing
          (AdicCompletion (maximalIdeal (B ⧸ I)) (B ⧸ I))) := by
  dsimp only
  let Ah := AdicCompletion (maximalIdeal A) A
  let Bh := AdicCompletion (maximalIdeal B) B
  let fc : Ah →+* Bh :=
    adicCompletionMap (algebraMap A B) (maximalIdeal A) (maximalIdeal B)
      (IsLocalRing.map_maximalIdeal_le (algebraMap A B))
  have hfccomm : fc.comp (algebraMap A Ah) = (algebraMap B Bh).comp (algebraMap A B) :=
    adicCompletionMap_comp_algebraMap (algebraMap A B) _ _ _
  have hfcflat : fc.Flat :=
    (adicCompletionMap_flat_iff (algebraMap A B)).2
      (RingHom.flat_algebraMap_iff.mpr (inferInstance : Module.Flat A B))
  have hAh : IsNoetherianCompleteLocalRing Ah := isNoetherianCompleteLocalRing_adicCompletion A
  have hBh : IsNoetherianCompleteLocalRing Bh := isNoetherianCompleteLocalRing_adicCompletion B
  have : IsAdicComplete (maximalIdeal Ah) Ah := hAh.isComplete
  have : IsAdicComplete (maximalIdeal Bh) Bh := hBh.isComplete
  have hfcmax : (maximalIdeal Ah).map fc ≤ maximalIdeal Bh := by
    rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_map, hfccomm,
      ← Ideal.map_map, AdicCompletion.maximalIdeal_eq_map]
    exact Ideal.map_mono (IsLocalRing.map_maximalIdeal_le (algebraMap A B))
  have : IsLocalHom fc := ((IsLocalRing.local_hom_TFAE fc).out 3 1).mp hfcmax
  obtain ⟨R, S, hRcomm, hRreg, hRcomplete, hScomm, hSreg, hScomplete, g, qA, qB,
      hqA, hqB, hg, hqAlocal, hqBlocal, hcomm, -, hflat, hfiber⟩ :=
    exists_powerSeries_presentation_of_isLocalHom fc
  let : CommRing R := hRcomm
  let : CommRing S := hScomm
  have : IsRegularLocalRing R := hRreg
  have : IsRegularLocalRing S := hSreg
  have : IsLocalHom qA := hqAlocal
  have : IsLocalHom qB := hqBlocal
  let : Algebra R S := g.toAlgebra
  have : IsLocalHom (algebraMap R S) := hg
  have : Module.Flat R S := hflat
  have : IsRegularLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S)) := hfiber
  let Icl : Ideal B := (maximalIdeal A).map (algebraMap A B)
  have hL : (maximalIdeal Ah).map fc = Icl.map (algebraMap B Bh) := by
    rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_map, hfccomm, ← Ideal.map_map]
  have : IsLocalRing (B ⧸ Icl) :=
    isLocalRing_quotient_of_le_maximalIdeal Icl (IsLocalRing.map_maximalIdeal_le _)
  let eFiber : AdicCompletion (maximalIdeal (B ⧸ Icl)) (B ⧸ Icl) ≃+*
      Bh ⧸ (maximalIdeal Ah).map fc :=
    (nonempty_ringEquiv_adicCompletion_quotient Icl).some.trans (Ideal.quotEquivOfEq hL.symm)
  exact (completeIntersection_iff_of_presentation hAh hBh fc hfcflat qA qB hqA hqB
    hcomm).trans (Iff.and Iff.rfl (isCompleteIntersectionCompleteLocalRing_congr eFiber).symm)

end LocalCompleteIntersection

