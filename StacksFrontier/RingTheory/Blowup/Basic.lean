/-!
# Basic properties of the affine blowup algebra

Throughout, `R` is a commutative ring, `I ⊆ R` an ideal and `a ∈ I`; `I ^ n` is the `n`-th power
of `I`, with `I ^ 0 = R`. The blowup, or Rees, algebra is `Bl_I(R) = ⨁_{n ≥ 0} Iⁿ`, and the affine
blowup algebra `R[I/a]` is the degree-zero part of the localization of `Bl_I(R)` at the degree-one
element `a`. Its elements are the formal expressions `x / aⁿ` with `n ≥ 0` and `x ∈ Iⁿ`, where
`x / aⁿ` and `y / aᵐ` are equal exactly when `aᵏ (aᵐ x - aⁿ y) = 0` in `R` for some `k ≥ 0`.
This is the equality of fractions in `R_a = Localization.Away a`, so `R[I/a]` is also the
`R`-subalgebra of `R_a` generated by the elements `x / a` with `x ∈ I`.

## Main definitions

* `affineBlowup`: `R[I/a]` as the `R`-subalgebra of `Localization.Away a` generated by the
  elements `x / a` with `x ∈ I`.
* `Blowup`: `R[I/a]` as a quotient of representatives `x / aⁿ`.
* `torsionIdeal`: the `b`-power torsion ideal `A[b^∞] = {z | ∃ m, bᵐ z = 0}` of a ring `A`.

## Main results

* `affineBlowup_isDomain`: if `R` is a domain and `a ≠ 0`, then `R[I/a]` is a domain.
* `isReduced_affineBlowup`: if `R` is reduced, then `R[I/a]` is reduced.
* `blowup_image_a_mem_nonZeroDivisors`: the image of `a` in `R[I/a]` is a nonzerodivisor.
* `blowup_idealMap_eq_span`: `I R[I/a] = a R[I/a]`.
* `blowup_localization_away_bijective`: the map `R_a → R[I/a]_a` is bijective.
* `AffineBlowup.fImage_mem_nonZeroDivisors`: if `V(f) = V(I)`, the image of `f` in `R[I/a]` is a
  nonzerodivisor.
* `AffineBlowup.blowup_localization_f_iso_a`: if `V(f) = V(I)`, then `R[I/a]_f ≅ R[I/a]_a`.
* `AffineBlowup.ringLocalization_a_iso_blowup_localization_a`: `R_a ≅ R[I/a]_a`.
* `affineBlowup_baseChange_iso`: for a ring map `R → S`, `J = I S` and `b` the image of `a`,
  `(S ⊗[R] R[I/a]) / (S ⊗[R] R[I/a])[b^∞] ≅ S[J/b]`.

## References

* [Stacks Project, Tag 052R](https://stacks.math.columbia.edu/tag/052R)
* [Stacks Project, Tag 052S](https://stacks.math.columbia.edu/tag/052S)
* [Stacks Project, Tag 07Z3](https://stacks.math.columbia.edu/tag/07Z3)
* [Stacks Project, Tag 080U](https://stacks.math.columbia.edu/tag/080U)
* [Stacks Project, Tag 0BIP](https://stacks.math.columbia.edu/tag/0BIP)
-/

@[expose] public section

variable {R : Type*} [CommRing R] (I : Ideal R) (a : R)

/-- The generating set `{ x / a : x ∈ I }` of `R[I/a]` inside `Localization.Away a`. -/
noncomputable def affineBlowupGenSet : Set (Localization.Away a) :=
  (fun x : R => Localization.mk x ⟨a, Submonoid.mem_powers a⟩) '' (I : Set R)

/-- The affine blowup algebra `R[I/a]`: the `R`-subalgebra of the away-localization
`Localization.Away a` generated by the elements `x / a` for `x ∈ I`. -/
noncomputable def affineBlowup : Subalgebra R (Localization.Away a) :=
  Algebra.adjoin R (affineBlowupGenSet I a)

/-- The elements `x / aⁿ` with `x ∈ Iⁿ` form an `R`-subalgebra of `Localization.Away a`
when `a ∈ I`. -/
noncomputable def affineBlowupReprSubalgebra (haI : a ∈ I) :
    Subalgebra R (Localization.Away a) where
  carrier := {z | ∃ (n : ℕ) (x : R), x ∈ I ^ n ∧
    z = Localization.mk x (⟨a ^ n, n, rfl⟩ : Submonoid.powers a)}
  mul_mem' := by
    rintro _ _ ⟨n, x, hx, rfl⟩ ⟨m, y, hy, rfl⟩
    refine ⟨n + m, x * y, pow_add I n m ▸ Ideal.mul_mem_mul hx hy, ?_⟩
    rw [Localization.mk_mul]
    congr 1
    exact Subtype.ext (pow_add a n m).symm
  add_mem' := by
    rintro _ _ ⟨n, x, hx, rfl⟩ ⟨m, y, hy, rfl⟩
    refine ⟨n + m, a ^ m * x + a ^ n * y, add_mem ?_ ?_, ?_⟩
    · rw [pow_add, mul_comm (a ^ m)]
      exact Ideal.mul_mem_mul hx (Ideal.pow_mem_pow haI m)
    · rw [pow_add, mul_comm (I ^ n), mul_comm (a ^ n)]
      exact Ideal.mul_mem_mul hy (Ideal.pow_mem_pow haI n)
    · rw [Localization.add_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul]; ring⟩
  algebraMap_mem' r := ⟨0, r, by simp, by
    rw [← Localization.mk_one_eq_algebraMap]
    congr 1
    exact Subtype.ext (pow_zero a).symm⟩

/-- Every `x / aⁿ` with `x ∈ Iⁿ` lies in `R[I/a]`. -/
theorem mk_mem_affineBlowup_of_mem_pow {n : ℕ} {x : R} (hx : x ∈ I ^ n) :
    (Localization.mk x ⟨a ^ n, n, rfl⟩ : Localization.Away a) ∈ affineBlowup I a := by
  induction n generalizing x with
  | zero =>
    have : (⟨a ^ 0, 0, rfl⟩ : Submonoid.powers a) = 1 := Subtype.ext (pow_zero a)
    rw [this, Localization.mk_one_eq_algebraMap]
    exact Subalgebra.algebraMap_mem _ x
  | succ n ih =>
    rw [pow_succ] at hx
    refine Submodule.mul_induction_on' (M := I ^ n) (N := I) (fun p hp q hq => ?_)
      (fun p _ q _ hp hq => ?_) hx
    · have heq : (Localization.mk p ⟨a ^ n, n, rfl⟩ : Localization.Away a)
          * Localization.mk q ⟨a, Submonoid.mem_powers a⟩
          = Localization.mk (p * q) (⟨a ^ (n + 1), n + 1, rfl⟩ : Submonoid.powers a) := by
        rw [Localization.mk_mul]
        congr 1
        exact Subtype.ext (pow_succ a n).symm
      exact heq ▸ mul_mem (ih hp) (Algebra.subset_adjoin ⟨q, hq, rfl⟩)
    · rw [← Localization.add_mk_self]
      exact add_mem hp hq

/-- Membership in `R[I/a]` by representatives: under the hypothesis `a ∈ I`, an
element of `Localization.Away a` lies in `R[I/a]` exactly when it can be written
as `x / aⁿ` with `x ∈ Iⁿ`. -/
theorem affineBlowup_mem_iff (haI : a ∈ I) (z : Localization.Away a) :
    z ∈ affineBlowup I a ↔
      ∃ (n : ℕ) (x : R), x ∈ I ^ n ∧
        z = Localization.mk x (⟨a ^ n, n, rfl⟩ : Submonoid.powers a) := by
  refine ⟨fun hz => ?_, fun ⟨_, _, hx, h⟩ => h ▸ mk_mem_affineBlowup_of_mem_pow I a hx⟩
  refine Algebra.adjoin_le (S := affineBlowupReprSubalgebra I a haI) ?_ hz
  rintro _ ⟨x, hx, rfl⟩
  exact ⟨1, x, (pow_one I).symm ▸ hx, by simp only [pow_one]⟩

/-- Equality of representatives: `x / aⁿ` and `y / aᵐ` are equal in
`Localization.Away a` (hence in `R[I/a]` when they lie in it) exactly when
`aᵏ (aᵐ x - aⁿ y) = 0` in `R` for some `k`. -/
theorem affineBlowup_repr_eq_iff (n m : ℕ) (x y : R) :
    (Localization.mk x (⟨a ^ n, n, rfl⟩ : Submonoid.powers a) : Localization.Away a)
        = Localization.mk y (⟨a ^ m, m, rfl⟩ : Submonoid.powers a)
      ↔ ∃ k : ℕ, a ^ k * (a ^ m * x - a ^ n * y) = 0 := by
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨fun ⟨⟨_, k, rfl⟩, hc⟩ => ⟨k, by linear_combination hc⟩,
    fun ⟨k, hk⟩ => ⟨⟨a ^ k, k, rfl⟩, by linear_combination hk⟩⟩

/-- If `R` is a domain, `I ⊆ R` an ideal, and `a ∈ I` is a nonzero element, then the affine
blowup algebra `R[I/a]` is a domain. -/
@[stacks 052R]
theorem affineBlowup_isDomain [IsDomain R] (ha : a ≠ 0) :
    IsDomain (affineBlowup I a) := by
  have : IsDomain (Localization.Away a) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ (M := Submonoid.powers a)
      (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero ha))
  infer_instance

end

/-!
### The affine blowup algebra of a reduced ring

Here `R[I/a]` is `affineBlowupAlgebraAway I a`, the `R`-subalgebra of `R_a` generated by the
elements `(1/a) x` with `x ∈ I`; for `a ∈ I` its elements are the `x / aⁿ` with `x ∈ Iⁿ`
(`mem_affineBlowup_iff`). If `R` is reduced, so is `R[I/a]`.
-/

@[expose] public section

variable {R : Type*} [CommRing R] (I : Ideal R) (a : R)

/-- `R` is reduced iff every `x` with `x ^ m = 0` for some `m ≥ 1` is zero. -/
theorem isReduced_iff_forall_pow_eq_zero :
    IsReduced R ↔ ∀ x : R, ∀ m : ℕ, 1 ≤ m → x ^ m = 0 → x = 0 := by
  rw [isReduced_iff]
  refine ⟨fun h x m _ hxm => h x ⟨m, hxm⟩, fun h x ⟨m, hxm⟩ => ?_⟩
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · have : Subsingleton R := subsingleton_of_zero_eq_one (by simpa using hxm.symm)
    exact Subsingleton.elim _ _
  · exact h x m hm hxm

/-- The affine blowup algebra `R[I/a]`, for `a ∈ I`, realized as the
`R`-subalgebra of the localization `R_a = Localization.Away a` generated by the
elements `x / a` for `x ∈ I`. Here `IsLocalization.Away.invSelf a` is the element
`1 / a`. -/
noncomputable def affineBlowupAlgebraAway : Subalgebra R (Localization.Away a) :=
  Algebra.adjoin R
    { z | ∃ x ∈ I, z = IsLocalization.Away.invSelf a * algebraMap R (Localization.Away a) x }

/-- The set of elements of `R_a` of the form `(1/a)^n * x` with `x ∈ I^n`. -/
def affineBlowupSet : Set (Localization.Away a) :=
  { z | ∃ n : ℕ, ∃ x ∈ I ^ n,
      z = (IsLocalization.Away.invSelf a) ^ n * algebraMap R (Localization.Away a) x }

/-- `0` lies in `affineBlowupSet I a`. -/
theorem zero_mem_affineBlowupSet : (0 : Localization.Away a) ∈ affineBlowupSet I a :=
  ⟨0, 0, by simp, by simp⟩

/-- In `R_a`, `(1/a)^k * a^k = 1`. -/
theorem invSelf_pow_mul_algebraMap_pow (k : ℕ) :
    IsLocalization.Away.invSelf a ^ k * algebraMap R (Localization.Away a) a ^ k = 1 := by
  rw [← mul_pow, mul_comm, IsLocalization.Away.mul_invSelf, one_pow]

/-- `affineBlowupSet I a` is closed under addition when `a ∈ I`. -/
theorem add_mem_affineBlowupSet (ha : a ∈ I) {z w : Localization.Away a}
    (hz : z ∈ affineBlowupSet I a) (hw : w ∈ affineBlowupSet I a) :
    z + w ∈ affineBlowupSet I a := by
  obtain ⟨n, x, hx, rfl⟩ := hz
  obtain ⟨m, y, hy, rfl⟩ := hw
  refine ⟨n + m, a ^ m * x + a ^ n * y, ?_, ?_⟩
  · rw [pow_add]
    exact add_mem (Ideal.mul_mem_mul_rev hx (Ideal.pow_mem_pow ha m))
      (Ideal.mul_mem_mul (Ideal.pow_mem_pow ha n) hy)
  · rw [map_add, map_mul, map_mul, map_pow, map_pow, pow_add, mul_add]
    rw [show (IsLocalization.Away.invSelf a) ^ n * (IsLocalization.Away.invSelf a) ^ m
        * (algebraMap R (Localization.Away a) a ^ m * algebraMap R (Localization.Away a) x)
        = ((IsLocalization.Away.invSelf a) ^ m * algebraMap R (Localization.Away a) a ^ m)
          * ((IsLocalization.Away.invSelf a) ^ n * algebraMap R (Localization.Away a) x) by ring]
    rw [show (IsLocalization.Away.invSelf a) ^ n * (IsLocalization.Away.invSelf a) ^ m
        * (algebraMap R (Localization.Away a) a ^ n * algebraMap R (Localization.Away a) y)
        = ((IsLocalization.Away.invSelf a) ^ n * algebraMap R (Localization.Away a) a ^ n)
          * ((IsLocalization.Away.invSelf a) ^ m * algebraMap R (Localization.Away a) y) by ring]
    rw [invSelf_pow_mul_algebraMap_pow, invSelf_pow_mul_algebraMap_pow, one_mul, one_mul]

/-- `affineBlowupSet I a` is closed under multiplication. -/
theorem mul_mem_affineBlowupSet {z w : Localization.Away a}
    (hz : z ∈ affineBlowupSet I a) (hw : w ∈ affineBlowupSet I a) :
    z * w ∈ affineBlowupSet I a := by
  obtain ⟨n, x, hx, rfl⟩ := hz
  obtain ⟨m, y, hy, rfl⟩ := hw
  refine ⟨n + m, x * y, pow_add I n m ▸ Ideal.mul_mem_mul hx hy, ?_⟩
  rw [pow_add, map_mul]
  ring

/-- `affineBlowupSet I a` is closed under the `R`-action. -/
theorem smul_mem_affineBlowupSet {z : Localization.Away a} (r : R) (hz : z ∈ affineBlowupSet I a) :
    r • z ∈ affineBlowupSet I a := by
  obtain ⟨n, x, hx, rfl⟩ := hz
  refine ⟨n, r * x, Ideal.mul_mem_left _ r hx, ?_⟩
  rw [Algebra.smul_def, map_mul]
  ring

/-- For `x ∈ I`, the element `x / a` lies in `affineBlowupSet I a`. -/
theorem generator_mem_affineBlowupSet {x : R} (hx : x ∈ I) :
    IsLocalization.Away.invSelf a * algebraMap R (Localization.Away a) x
      ∈ affineBlowupSet I a :=
  ⟨1, x, by simpa using hx, by simp⟩

/-- Every element `(1/a)^n * x` with `x ∈ I^n` lies in `R[I/a]`. -/
theorem invSelf_pow_mul_mem_affineBlowup {n : ℕ} {x : R} (hx : x ∈ I ^ n) :
    IsLocalization.Away.invSelf a ^ n * algebraMap R (Localization.Away a) x
      ∈ affineBlowupAlgebraAway I a := by
  induction n generalizing x with
  | zero => simp
  | succ k ih =>
    rw [pow_succ'] at hx
    refine Submodule.mul_induction_on hx (fun b hb c hc => ?_) fun u v hu hv => ?_
    · have hfac : IsLocalization.Away.invSelf a ^ (k + 1)
          * algebraMap R (Localization.Away a) (b * c)
          = (IsLocalization.Away.invSelf a * algebraMap R (Localization.Away a) b)
            * (IsLocalization.Away.invSelf a ^ k * algebraMap R (Localization.Away a) c) := by
        rw [map_mul]
        ring
      rw [hfac]
      exact Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨b, hb, rfl⟩) (ih hc)
    · rw [map_add, mul_add]
      exact add_mem hu hv

/-- For `a ∈ I`, an element `z ∈ R_a` lies in `R[I/a]` if and only if it has the form `x / a^n`
for some `n ≥ 0` and `x ∈ I^n`, where `(1/a)^n * x` is the image of `x / a^n` in `R_a`. -/
theorem mem_affineBlowup_iff (ha : a ∈ I) {z : Localization.Away a} :
    z ∈ affineBlowupAlgebraAway I a ↔
      ∃ n : ℕ, ∃ x ∈ I ^ n,
        z = (IsLocalization.Away.invSelf a) ^ n * algebraMap R (Localization.Away a) x := by
  let S : Subalgebra R (Localization.Away a) :=
    { carrier := affineBlowupSet I a
      zero_mem' := zero_mem_affineBlowupSet I a
      add_mem' := fun hz hw => add_mem_affineBlowupSet I a ha hz hw
      mul_mem' := fun hz hw => mul_mem_affineBlowupSet I a hz hw
      one_mem' := ⟨0, 1, by simp [Submodule.mem_top], by simp⟩
      algebraMap_mem' := fun r => ⟨0, r, by simp [Submodule.mem_top], by simp⟩ }
  refine ⟨fun hz => (Algebra.adjoin_le fun w ⟨x, hx, hw⟩ =>
    hw ▸ generator_mem_affineBlowupSet I a hx : affineBlowupAlgebraAway I a ≤ S) hz, ?_⟩
  rintro ⟨n, x, hx, rfl⟩
  exact invSelf_pow_mul_mem_affineBlowup I a hx

/-- An element of `R` maps to `0` in `R_a` exactly when some power of `a`
annihilates it. -/
@[ega "0 1.2.3" "partial"]
theorem algebraMap_away_eq_zero_iff (x : R) :
    algebraMap R (Localization.Away a) x = 0 ↔ ∃ k : ℕ, a ^ k * x = 0 := by
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers a)]
  constructor
  · rintro ⟨⟨m, k, hk⟩, hmx⟩
    exact ⟨k, by simpa [hk] using hmx⟩
  · rintro ⟨k, hk⟩
    exact ⟨⟨a ^ k, k, rfl⟩, hk⟩

/-- If `R` is reduced and `a ∈ I`, then the affine blowup algebra `R[I/a]` is reduced. -/
@[stacks 052S]
theorem isReduced_affineBlowup [IsReduced R] (ha : a ∈ I) :
    IsReduced (affineBlowupAlgebraAway I a) := by
  rw [isReduced_iff_forall_pow_eq_zero]
  intro w m hm hwm
  rw [← Subalgebra.coe_eq_zero (affineBlowupAlgebraAway I a)]
  obtain ⟨n, x, hx, hwz⟩ := (mem_affineBlowup_iff I a ha).mp w.property
  have hwm' : (w : Localization.Away a) ^ m = 0 := by
    simpa using congrArg (Subalgebra.val _) hwm
  have hax : algebraMap R (Localization.Away a) (x ^ m) = 0 := by
    rw [hwz, mul_pow, ← pow_mul, ← map_pow] at hwm'
    exact ((IsUnit.of_mul_eq_one_right _
      (IsLocalization.Away.mul_invSelf a)).pow (n * m)).mul_right_eq_zero.mp hwm'
  obtain ⟨k, hk⟩ := (algebraMap_away_eq_zero_iff a (x ^ m)).mp hax
  have hk' : a ^ (m * k) * x ^ m = 0 := pow_mul_eq_zero_of_le (Nat.le_mul_of_pos_left k hm) hk
  have hred : a ^ k * x = 0 :=
    IsNilpotent.eq_zero ⟨m, by rwa [mul_pow, ← pow_mul, mul_comm k m]⟩
  rw [hwz, (algebraMap_away_eq_zero_iff a x).mpr ⟨k, hred⟩, mul_zero]

end

/-!
### The affine blowup algebra as a quotient of representatives

Here `R' = R[I/a]` is `Blowup I a`, the quotient of the representatives `x / aⁿ` with `x ∈ Iⁿ` by
the relation `x/aⁿ = y/aᵐ` exactly when `aᵏ (aᵐ x - aⁿ y) = 0` in `R` for some `k ≥ 0`, with
`x/aⁿ + y/aᵐ = (aᵐ x + aⁿ y)/a^(n+m)`, `(x/aⁿ)(y/aᵐ) = (x y)/a^(n+m)` and structure map
`r ↦ r/1`. The image of `a` in `R'` is a nonzerodivisor, `I R' = a R'`, and the map `R_a → R'_a`
induced by `R → R'` is bijective.
-/

@[expose] public section

variable {R : Type*} [CommRing R]

/-- A representative `(deg, num)` with `num ∈ I ^ deg`, standing for the formal
fraction `num / a ^ deg`. -/
structure BlowupRepr (I : Ideal R) where
  /-- The exponent `n` of the denominator `a ^ n`. -/
  deg : ℕ
  /-- The numerator, an element of `I ^ deg`. -/
  num : R
  num_mem : num ∈ I ^ deg

namespace BlowupRepr
variable {I : Ideal R} {a : R}

/-- The equality relation on representatives: `x/aⁿ = y/aᵐ` iff
`∃ k, aᵏ (aᵐ x - aⁿ y) = 0`. -/
def rel (a : R) (p q : BlowupRepr I) : Prop :=
  ∃ k : ℕ, a ^ k * (a ^ q.deg * p.num - a ^ p.deg * q.num) = 0

/-- The relation on representatives is an equivalence relation. -/
theorem rel_equiv (I : Ideal R) (a : R) : Equivalence (rel (I := I) a) := by
  constructor
  · exact fun p => ⟨0, by ring⟩
  · rintro p q ⟨k, hk⟩
    exact ⟨k, by linear_combination -hk⟩
  · rintro p q r ⟨k, hk⟩ ⟨l, hl⟩
    exact ⟨k + l + q.deg, by linear_combination a ^ (l + r.deg) * hk + a ^ (k + p.deg) * hl⟩

/-- The setoid on representatives. -/
def setoid (I : Ideal R) (a : R) : Setoid (BlowupRepr I) where
  r := rel a
  iseqv := rel_equiv I a

/-- The representative for `0 = 0 / a^0`. -/
def zeroRepr (I : Ideal R) : BlowupRepr I where
  deg := 0
  num := 0
  num_mem := Submodule.zero_mem _

/-- The representative for `1 = 1 / a^0`. -/
def oneRepr (I : Ideal R) : BlowupRepr I where
  deg := 0
  num := 1
  num_mem := by simp

/-- Negation `-(x/aⁿ) = (-x)/aⁿ`. -/
def negRepr (p : BlowupRepr I) : BlowupRepr I where
  deg := p.deg
  num := -p.num
  num_mem := Submodule.neg_mem _ p.num_mem

/-- Addition `x/aⁿ + y/aᵐ = (aᵐ x + aⁿ y)/a^(n+m)`. -/
def addRepr (ha : a ∈ I) (p q : BlowupRepr I) : BlowupRepr I where
  deg := p.deg + q.deg
  num := a ^ q.deg * p.num + a ^ p.deg * q.num
  num_mem := by
    rw [pow_add]
    exact add_mem (Ideal.mul_mem_mul_rev p.num_mem (Ideal.pow_mem_pow ha q.deg))
      (Ideal.mul_mem_mul (Ideal.pow_mem_pow ha p.deg) q.num_mem)

/-- Multiplication `(x/aⁿ)(y/aᵐ) = (x y)/a^(n+m)`. -/
def mulRepr (p q : BlowupRepr I) : BlowupRepr I where
  deg := p.deg + q.deg
  num := p.num * q.num
  num_mem := by rw [pow_add]; exact Ideal.mul_mem_mul p.num_mem q.num_mem

/-- Negation of representatives respects the equality relation. -/
theorem negRepr_rel {p p' : BlowupRepr I} (h : rel a p p') : rel a (negRepr p) (negRepr p') := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k, ?_⟩
  simp only [negRepr]
  linear_combination -hk

/-- Multiplication of representatives respects the equality relation in its left
argument. -/
theorem mulRepr_rel_left (p p' q : BlowupRepr I) (h : rel a p p') :
    rel a (mulRepr p q) (mulRepr p' q) := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k, ?_⟩
  simp only [mulRepr]
  linear_combination q.num * a ^ q.deg * hk

/-- Multiplication of representatives is commutative up to the equality relation. -/
theorem mulRepr_comm (p q : BlowupRepr I) : rel a (mulRepr p q) (mulRepr q p) := by
  refine ⟨0, ?_⟩
  simp only [mulRepr]
  rw [Nat.add_comm q.deg p.deg]; ring

/-- Multiplication of representatives respects the equality relation in its right
argument. -/
theorem mulRepr_rel_right (q p p' : BlowupRepr I) (h : rel a p p') :
    rel a (mulRepr q p) (mulRepr q p') :=
  (rel_equiv I a).trans (mulRepr_comm q p)
    ((rel_equiv I a).trans (mulRepr_rel_left p p' q h) (mulRepr_comm p' q))

/-- Addition of representatives respects the equality relation in its left
argument. -/
theorem addRepr_rel_left (ha : a ∈ I) (p p' q : BlowupRepr I) (h : rel a p p') :
    rel a (addRepr ha p q) (addRepr ha p' q) := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k, ?_⟩
  simp only [addRepr]
  linear_combination a ^ q.deg * a ^ q.deg * hk

/-- Addition of representatives is commutative up to the equality relation. -/
theorem addRepr_comm (ha : a ∈ I) (p q : BlowupRepr I) :
    rel a (addRepr ha p q) (addRepr ha q p) := by
  refine ⟨0, ?_⟩
  simp only [addRepr]
  rw [Nat.add_comm q.deg p.deg]; ring

/-- Addition of representatives respects the equality relation in its right
argument. -/
theorem addRepr_rel_right (ha : a ∈ I) (q p p' : BlowupRepr I) (h : rel a p p') :
    rel a (addRepr ha q p) (addRepr ha q p') :=
  (rel_equiv I a).trans (addRepr_comm ha q p)
    ((rel_equiv I a).trans (addRepr_rel_left ha p p' q h) (addRepr_comm ha p' q))

end BlowupRepr

/-- The affine blowup algebra `R[I/a]`, as the quotient of
representatives `x / aⁿ` (`x ∈ Iⁿ`) by the relation `x/aⁿ = y/aᵐ ↔ ∃ k, aᵏ(aᵐx - aⁿy) = 0`. -/
def Blowup (I : Ideal R) (a : R) : Type _ := Quotient (BlowupRepr.setoid I a)

namespace Blowup
variable {I : Ideal R} {a : R}

/-- The class of a representative. -/
def mk (p : BlowupRepr I) : Blowup I a := Quotient.mk (BlowupRepr.setoid I a) p

/-- Two representatives have the same class exactly when they are related. -/
theorem mk_eq_mk {p q : BlowupRepr I} : (mk p : Blowup I a) = mk q ↔ BlowupRepr.rel a p q :=
  Quotient.eq

/-- The zero of `R[I/a]`, the class of `0 / a ^ 0`. -/
instance : Zero (Blowup I a) := ⟨mk (BlowupRepr.zeroRepr I)⟩

/-- The one of `R[I/a]`, the class of `1 / a ^ 0`. -/
instance : One (Blowup I a) := ⟨mk (BlowupRepr.oneRepr I)⟩

/-- Negation on `R[I/a]`, induced by negating the numerator of a representative. -/
instance : Neg (Blowup I a) :=
  ⟨Quotient.lift (fun p => mk (BlowupRepr.negRepr p))
    (fun _ _ h => Quotient.sound (BlowupRepr.negRepr_rel h))⟩

/-- Multiplication on `R[I/a]`, induced by `(x/aⁿ)(y/aᵐ) = (x y)/a^(n+m)`. -/
instance : Mul (Blowup I a) :=
  ⟨Quotient.lift₂ (fun p q => mk (BlowupRepr.mulRepr p q))
    (fun _ _ _ _ h₁ h₂ => Quotient.sound
      ((BlowupRepr.rel_equiv I a).trans (BlowupRepr.mulRepr_rel_left _ _ _ h₁)
        (BlowupRepr.mulRepr_rel_right _ _ _ h₂)))⟩

/-- The product of two classes is the class of the product of the representatives. -/
@[simp] theorem mk_mul (p q : BlowupRepr I) :
    (mk p : Blowup I a) * mk q = mk (BlowupRepr.mulRepr p q) := rfl

/-- The negative of a class is the class of the negated representative. -/
@[simp] theorem mk_neg (p : BlowupRepr I) :
    (-(mk p) : Blowup I a) = mk (BlowupRepr.negRepr p) := rfl

/-- The zero of `R[I/a]` is the class of `0 / a ^ 0`. -/
@[simp] theorem zero_def : (0 : Blowup I a) = mk (BlowupRepr.zeroRepr I) := rfl

/-- The one of `R[I/a]` is the class of `1 / a ^ 0`. -/
@[simp] theorem one_def : (1 : Blowup I a) = mk (BlowupRepr.oneRepr I) := rfl

/-- Addition on `R[I/a]` for `a ∈ I`, induced by `x/aⁿ + y/aᵐ = (aᵐ x + aⁿ y)/a^(n+m)`. -/
instance [ha : Fact (a ∈ I)] : Add (Blowup I a) :=
  ⟨Quotient.lift₂ (fun p q => mk (BlowupRepr.addRepr ha.out p q))
    (fun _ _ _ _ h₁ h₂ => Quotient.sound
      ((BlowupRepr.rel_equiv I a).trans (BlowupRepr.addRepr_rel_left ha.out _ _ _ h₁)
        (BlowupRepr.addRepr_rel_right ha.out _ _ _ h₂)))⟩

/-- The sum of two classes is the class of the sum of the representatives. -/
@[simp] theorem mk_add [ha : Fact (a ∈ I)] (p q : BlowupRepr I) :
    (mk p : Blowup I a) + mk q = mk (BlowupRepr.addRepr ha.out p q) := rfl

variable [ha : Fact (a ∈ I)]

omit ha in
/-- A witness `k` for the equality relation identifies the classes of two
representatives. -/
theorem mk_sound {p q : BlowupRepr I} (k : ℕ)
    (h : a ^ k * (a ^ q.deg * p.num - a ^ p.deg * q.num) = 0) : (mk p : Blowup I a) = mk q :=
  Quotient.sound ⟨k, h⟩

/-- The commutative ring structure on `R[I/a]`. -/
instance : CommRing (Blowup I a) where
  add := (· + ·)
  add_assoc := by
    rintro x y z
    induction x using Quotient.inductionOn with | _ p =>
    induction y using Quotient.inductionOn with | _ q =>
    induction z using Quotient.inductionOn with | _ r =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.addRepr]
    ring
  zero_add := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.addRepr, BlowupRepr.zeroRepr]
    ring
  add_zero := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.addRepr, BlowupRepr.zeroRepr]
    ring
  add_comm := by
    rintro x y
    induction x using Quotient.inductionOn with | _ p =>
    induction y using Quotient.inductionOn with | _ q =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.addRepr]
    ring
  neg := Neg.neg
  zsmul := zsmulRec
  nsmul := nsmulRec
  neg_add_cancel := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.addRepr, BlowupRepr.negRepr, BlowupRepr.zeroRepr]
    ring
  mul := (· * ·)
  mul_assoc := by
    rintro x y z
    induction x using Quotient.inductionOn with | _ p =>
    induction y using Quotient.inductionOn with | _ q =>
    induction z using Quotient.inductionOn with | _ r =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr]
    ring
  one_mul := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr, BlowupRepr.oneRepr]
    ring
  mul_one := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr, BlowupRepr.oneRepr]
    ring
  left_distrib := by
    rintro x y z
    induction x using Quotient.inductionOn with | _ p =>
    induction y using Quotient.inductionOn with | _ q =>
    induction z using Quotient.inductionOn with | _ r =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr, BlowupRepr.addRepr]
    ring
  right_distrib := by
    rintro x y z
    induction x using Quotient.inductionOn with | _ p =>
    induction y using Quotient.inductionOn with | _ q =>
    induction z using Quotient.inductionOn with | _ r =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr, BlowupRepr.addRepr]
    ring
  mul_comm := by
    rintro x y
    induction x using Quotient.inductionOn with | _ p =>
    induction y using Quotient.inductionOn with | _ q =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr]
    ring
  zero_mul := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr, BlowupRepr.zeroRepr]
    ring
  mul_zero := by
    rintro x
    induction x using Quotient.inductionOn with | _ p =>
    refine mk_sound 0 ?_
    simp only [BlowupRepr.mulRepr, BlowupRepr.zeroRepr]
    ring

/-- The representative `r / a^0 = r / 1` for `r ∈ R`. -/
def ofRepr (r : R) : BlowupRepr I where
  deg := 0
  num := r
  num_mem := by simp

/-- The structure ring map `R → R[I/a]`, `r ↦ r / 1`. -/
def of : R →+* Blowup I a where
  toFun r := mk (ofRepr r)
  map_one' := rfl
  map_mul' x y := by
    refine (mk_sound 0 ?_).symm
    simp only [BlowupRepr.mulRepr, ofRepr]
    ring
  map_zero' := rfl
  map_add' x y := by
    refine (mk_sound 0 ?_).symm
    simp only [BlowupRepr.addRepr, ofRepr]
    ring

/-- The structure map sends `r` to the class of `r / a ^ 0`. -/
@[simp] theorem of_apply (r : R) : (of r : Blowup I a) = mk (ofRepr r) := rfl

/-- The `R`-algebra structure on `R[I/a]`, with structure map `r ↦ r / a ^ 0`. -/
instance : Algebra R (Blowup I a) where
  algebraMap := of
  commutes' r x := by rw [mul_comm]
  smul r x := of r * x
  smul_def' r x := rfl

/-- The algebra map `R → R[I/a]` sends `r` to the class of `r / a ^ 0`. -/
@[simp] theorem algebraMap_apply (r : R) :
    (algebraMap R (Blowup I a)) r = mk (ofRepr r) := rfl

end Blowup

open Blowup

/-- The image of `a` in `R[I/a]` is a nonzerodivisor. -/
@[stacks 07Z3 "(1)", ega "IV 19.4.1" "partial"]
theorem blowup_image_a_mem_nonZeroDivisors {R : Type*} [CommRing R] (I : Ideal R) (a : R)
    (ha : a ∈ I) :
    haveI : Fact (a ∈ I) := ⟨ha⟩
    (algebraMap R (Blowup I a)) a ∈ nonZeroDivisors (Blowup I a) := by
  have : Fact (a ∈ I) := ⟨ha⟩
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  induction x using Quotient.inductionOn with | _ p =>
  have hx2 : (Blowup.mk p : Blowup I a) * Blowup.mk (Blowup.ofRepr a) = 0 := hx
  rw [Blowup.mk_mul, Blowup.zero_def, Blowup.mk_eq_mk] at hx2
  obtain ⟨k, hk⟩ := hx2
  simp only [BlowupRepr.mulRepr, Blowup.ofRepr, BlowupRepr.zeroRepr] at hk
  change (Blowup.mk p : Blowup I a) = 0
  rw [Blowup.zero_def, Blowup.mk_eq_mk]
  refine ⟨k + 1, ?_⟩
  simp only [BlowupRepr.zeroRepr, pow_zero, one_mul, mul_zero, sub_zero, add_zero] at hk ⊢
  linear_combination hk

/-- The ideal of `R[I/a]` generated by the image of `I` equals the principal ideal generated by
the image of `a`. -/
@[stacks 07Z3 "(2)", ega "IV 19.4.1" "partial"]
theorem blowup_idealMap_eq_span {R : Type*} [CommRing R] (I : Ideal R) (a : R) (ha : a ∈ I) :
    haveI : Fact (a ∈ I) := ⟨ha⟩
    Ideal.map (algebraMap R (Blowup I a)) I
      = Ideal.span {(algebraMap R (Blowup I a)) a} := by
  have : Fact (a ∈ I) := ⟨ha⟩
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap, Ideal.mem_span_singleton]
    refine ⟨Blowup.mk ⟨1, y, by simpa using hy⟩, ?_⟩
    rw [Blowup.algebraMap_apply]
    change (Blowup.mk (Blowup.ofRepr y) : Blowup I a) = Blowup.mk (Blowup.ofRepr a) * _
    rw [Blowup.mk_mul]
    apply Blowup.mk_sound 0
    simp only [BlowupRepr.mulRepr, Blowup.ofRepr]
    ring
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    exact Ideal.mem_map_of_mem _ ha

/-- In `R[I/a]`, multiplying the class of `x / aⁿ` by `(a/1)ⁿ` gives `x/1`. -/
theorem blowup_of_pow_mul_mk {R : Type*} [CommRing R] (I : Ideal R) (a : R) (ha : a ∈ I)
    (n : ℕ) (x : R) (hx : x ∈ I ^ n) :
    haveI : Fact (a ∈ I) := ⟨ha⟩
    (Blowup.of a : Blowup I a) ^ n * Blowup.mk ⟨n, x, hx⟩ = Blowup.of x := by
  have : Fact (a ∈ I) := ⟨ha⟩
  rw [← map_pow, Blowup.of_apply, Blowup.of_apply, Blowup.mk_mul]
  apply Blowup.mk_sound 0
  simp only [BlowupRepr.mulRepr, Blowup.ofRepr]
  ring

/-- The map `R_a → (R[I/a])_a` induced by the structure map `R → R[I/a]` on localizations at the
powers of `a` is bijective. -/
@[stacks 07Z3 "(3)"]
theorem blowup_localization_away_bijective {R : Type*} [CommRing R] (I : Ideal R) (a : R)
    (ha : a ∈ I) :
    haveI : Fact (a ∈ I) := ⟨ha⟩
    Function.Bijective (Localization.awayMap (Blowup.of : R →+* Blowup I a) a) := by
  have : Fact (a ∈ I) := ⟨ha⟩
  set R' := Blowup I a with hR'
  set B := Localization.Away (Blowup.of a : R') with hB
  let fR : R →+* B := (algebraMap R' B).comp (Blowup.of : R →+* R')
  let algRB : Algebra R B := fR.toAlgebra
  set g : Localization.Away a →+* B := Localization.awayMap (Blowup.of : R →+* R') a with hg
  have hLoc : IsLocalization (Submonoid.powers a) B := by
    have hmap : ∀ r : R, algebraMap R B r = algebraMap R' B (Blowup.of r) := fun _ => rfl
    refine IsLocalization.Away.mk a ?_ ?_ ?_
    · rw [hmap a]
      exact IsLocalization.Away.algebraMap_isUnit (S := B) (Blowup.of a : R')
    · intro s
      obtain ⟨m, w, hw⟩ := IsLocalization.Away.surj (S := B) (Blowup.of a : R') s
      induction w using Quotient.inductionOn with | _ p =>
      obtain ⟨k, x, hx⟩ := p
      refine ⟨m + k, x, ?_⟩
      have hkey : (algebraMap R' B) (Blowup.mk ⟨k, x, hx⟩) * (algebraMap R' B (Blowup.of a))^k
          = algebraMap R' B (Blowup.of x) := by
        rw [← map_pow, ← map_mul, mul_comm]
        congr 1
        exact blowup_of_pow_mul_mk I a ha k x hx
      have hw' : s * (algebraMap R' B (Blowup.of a)) ^ m
          = algebraMap R' B (Blowup.mk ⟨k, x, hx⟩) := hw
      rw [hmap a, hmap x, pow_add, ← mul_assoc, hw', hkey]
    · intro u v huv
      rw [hmap u, hmap v] at huv
      obtain ⟨n, hn⟩ := IsLocalization.Away.exists_of_eq (S := B) (Blowup.of a : R') huv
      rw [← map_pow, ← map_mul, ← map_mul, Blowup.of_apply, Blowup.of_apply, Blowup.mk_eq_mk] at hn
      obtain ⟨j, hj⟩ := hn
      refine ⟨j + n, ?_⟩
      simp only [Blowup.ofRepr, pow_zero, one_mul] at hj
      rw [pow_add]
      linear_combination hj
  have hcomp : g.comp (algebraMap R (Localization.Away a)) = algebraMap R B := by
    rw [hg, Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_comp]
    rfl
  exact IsLocalization.bijective (Submonoid.powers a) g hcomp

end

/-!
### Localizing the affine blowup algebra at `f` when `V(f) = V(I)`

Here `R' = R[I/a]` is `AffineBlowup.blowup I a`, the `R`-subalgebra of `R_a` generated by the
elements `x/a` with `x ∈ I`. For `S ⊆ R` the vanishing locus is
`V(S) = {𝔭 ∈ Spec R | S ⊆ 𝔭}`, and `V(f) = V({f})`.

If `a ∈ I` and `f : R` satisfies `V(f) = V(I)`, then the image of `f` in `R'` is a
nonzerodivisor, and there are canonical isomorphisms of `R`-algebras `R'_f ≅ R'_a ≅ R_a`: the
canonical map `R_a → R'_a` is bijective, and a localization of `R'` away from `f` is also a
localization of `R'` away from `a`.
-/

@[expose] public section

open scoped Polynomial

namespace AffineBlowup

variable {R : Type*} [CommRing R] (I : Ideal R) (a : R)

/-- `R_a`, the localization of `R` at the powers of `a`. -/
@[ega "0 1.2.3", ega "0 7.6.15" "special case", ega "I 1.3.1"]
abbrev Ra : Type _ := Localization.Away a

/-- The element `x / a` of `R_a`, for `x ∈ R`. -/
noncomputable def divByA (x : R) : Ra a :=
  IsLocalization.mk' (Localization.Away a) x ⟨a, Submonoid.mem_powers a⟩

/-- The generating set `{ x / a : x ∈ I }` inside `R_a`. -/
def gens : Set (Ra a) := {z | ∃ x ∈ I, z = divByA a x}

/-- The **affine blowup algebra** `R' = R[I/a]` (for `a ∈ I`), realized as the
`R`-subalgebra of `R_a = Localization.Away a` generated by the elements `x / a`
with `x ∈ I`. -/
noncomputable def blowup : Subalgebra R (Ra a) :=
  Algebra.adjoin R (gens I a)

/-- The structural `R`-algebra `R' = R[I/a]`. -/
noncomputable abbrev Rprime : Type _ := blowup I a

/-- The commutative ring structure on `R' = R[I/a]`, that of the subalgebra `blowup I a`. -/
noncomputable instance : CommRing (Rprime I a) := inferInstanceAs (CommRing (blowup I a))

/-- The structure map `R → R'` sends `r` to `r/1`: the image of `r` in `R'`, mapped to `R_a`,
is `algebraMap R R_a r`. -/
theorem algebraMap_blowup_coe (r : R) :
    ((algebraMap R (Rprime I a)) r : Ra a) = algebraMap R (Ra a) r := by
  rfl

/-- For `x ∈ I`, the element `x/a` lies in `R'` and `a · (x/a) = x/1` in `R_a`. -/
theorem mul_divByA_mem (x : R) (hx : x ∈ I) :
    divByA a x ∈ blowup I a ∧
      algebraMap R (Ra a) a * divByA a x = algebraMap R (Ra a) x := by
  refine ⟨Algebra.subset_adjoin ⟨x, hx, rfl⟩, ?_⟩
  rw [divByA, mul_comm]
  exact IsLocalization.mk'_spec (Localization.Away a) x ⟨a, Submonoid.mem_powers a⟩

/-- Every element of the blowup subalgebra, multiplied by a suitable power of `a`, lies in the
image of `R`. -/
theorem exists_pow_mul_mem_range (w : Ra a) (hw : w ∈ blowup I a) :
    ∃ (n : ℕ) (x : R),
      (algebraMap R (Ra a) a) ^ n * w = algebraMap R (Ra a) x := by
  induction hw using Algebra.adjoin_induction with
  | mem z hz =>
      obtain ⟨x, hx, rfl⟩ := hz
      refine ⟨1, x, ?_⟩
      rw [pow_one]
      exact (mul_divByA_mem I a x hx).2
  | algebraMap r =>
      exact ⟨0, r, by rw [pow_zero, one_mul]⟩
  | add x y hx hy hpx hpy =>
      obtain ⟨n, u, hu⟩ := hpx
      obtain ⟨m, v, hv⟩ := hpy
      refine ⟨n + m, a ^ m * u + a ^ n * v, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, mul_add]
      rw [show (algebraMap R (Ra a) a) ^ (n + m) * x
          = (algebraMap R (Ra a) a) ^ m * ((algebraMap R (Ra a) a) ^ n * x) by ring,
        show (algebraMap R (Ra a) a) ^ (n + m) * y
          = (algebraMap R (Ra a) a) ^ n * ((algebraMap R (Ra a) a) ^ m * y) by ring,
        hu, hv]
  | mul x y hx hy hpx hpy =>
      obtain ⟨n, u, hu⟩ := hpx
      obtain ⟨m, v, hv⟩ := hpy
      refine ⟨n + m, u * v, ?_⟩
      rw [map_mul, ← hu, ← hv]
      ring

/-- For `w` in the blowup subalgebra, a power of `a` times `w` lands in the image
of `R`, stated inside the subalgebra itself. -/
theorem exists_pow_mul_eq_algebraMap (w : Rprime I a) :
    ∃ (n : ℕ) (x : R),
      (algebraMap R (Rprime I a) a) ^ n * w = algebraMap R (Rprime I a) x := by
  obtain ⟨n, x, hx⟩ := exists_pow_mul_mem_range I a (w : Ra a) w.property
  refine ⟨n, x, ?_⟩
  apply Subtype.coe_injective
  push_cast
  simpa [algebraMap_blowup_coe] using hx

/-- Any localization of the blowup `R'` away from the image of `a` is also a
localization of `R` away from `a`. -/
theorem isLocalizationAway_of_blowupAway
    (T : Type*) [CommRing T] [Algebra (Rprime I a) T] [Algebra R T]
    [IsScalarTower R (Rprime I a) T]
    [IsLocalization.Away (algebraMap R (Rprime I a) a) T] :
    IsLocalization.Away a T := by
  have htower : (algebraMap R T)
      = (algebraMap (Rprime I a) T).comp (algebraMap R (Rprime I a)) :=
    IsScalarTower.algebraMap_eq R (Rprime I a) T
  have hmap (r : R) : algebraMap R T r
      = algebraMap (Rprime I a) T (algebraMap R (Rprime I a) r) := by
    rw [htower]; rfl
  refine ⟨⟨?_, ?_, ?_⟩⟩
  · rintro ⟨y, k, rfl⟩
    have hunit : IsUnit (algebraMap (Rprime I a) T (algebraMap R (Rprime I a) a)) :=
      IsLocalization.map_units T (⟨_, Submonoid.mem_powers _⟩ :
        Submonoid.powers (algebraMap R (Rprime I a) a))
    simp only []
    rw [map_pow, hmap]
    exact hunit.pow k
  · intro z
    obtain ⟨⟨w, s, k, rfl⟩, hws⟩ := IsLocalization.surj
      (Submonoid.powers (algebraMap R (Rprime I a) a)) z
    obtain ⟨n, x, hx⟩ := exists_pow_mul_eq_algebraMap I a w
    refine ⟨⟨x, ⟨a ^ (k + n), ⟨k + n, rfl⟩⟩⟩, ?_⟩
    simp only [] at hws ⊢
    have key : z * algebraMap (Rprime I a) T ((algebraMap R (Rprime I a) a) ^ k)
        = algebraMap (Rprime I a) T w := hws
    have e1 : algebraMap R T (a ^ (k + n))
        = algebraMap (Rprime I a) T ((algebraMap R (Rprime I a) a) ^ (k + n)) := by
      rw [map_pow, hmap, map_pow]
    rw [map_pow] at key
    rw [e1, hmap x, ← hx, map_mul, map_pow, map_pow, pow_add]
    linear_combination (algebraMap (Rprime I a) T) ((algebraMap R (Rprime I a)) a) ^ n * key
  · intro x y hxy
    have hxy' : algebraMap (Rprime I a) T (algebraMap R (Rprime I a) x)
        = algebraMap (Rprime I a) T (algebraMap R (Rprime I a) y) := by
      rwa [← RingHom.comp_apply, ← RingHom.comp_apply, ← htower]
    obtain ⟨⟨c, m, hcm⟩, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers
      (algebraMap R (Rprime I a) a)) hxy'
    subst hcm
    have hRa : algebraMap R (Ra a) (a ^ m * x) = algebraMap R (Ra a) (a ^ m * y) := by
      simpa [algebraMap_blowup_coe] using congrArg (fun t : Rprime I a => (t : Ra a)) hc
    obtain ⟨⟨d, j, hdj⟩, hd⟩ := IsLocalization.exists_of_eq
      (M := Submonoid.powers a) hRa
    refine ⟨⟨a ^ (j + m), ⟨j + m, rfl⟩⟩, ?_⟩
    subst hdj
    simp only [] at hd ⊢
    have : a ^ j * (a ^ m * x) = a ^ j * (a ^ m * y) := hd
    linear_combination this

/-- From `V(f) = V(I)` we get equality of radicals. -/
@[ega "I 1.1.9" "partial"]
theorem radical_eq_of_zeroLocus_eq (f : R)
    (hf : PrimeSpectrum.zeroLocus ({f} : Set R) = PrimeSpectrum.zeroLocus (I : Set R)) :
    (Ideal.span ({f} : Set R)).radical = I.radical := by
  have h1 : PrimeSpectrum.zeroLocus ({f} : Set R)
      = PrimeSpectrum.zeroLocus (Ideal.span ({f} : Set R) : Set R) := by
    rw [PrimeSpectrum.zeroLocus_span]
  rw [h1] at hf
  have := congrArg PrimeSpectrum.vanishingIdeal hf
  rwa [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
    PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical] at this

/-- From `V(f) = V(I)` and `a ∈ I`: a power of `a` is a multiple of `f`. -/
theorem exists_pow_eq_f_mul (ha : a ∈ I) (f : R)
    (hf : PrimeSpectrum.zeroLocus ({f} : Set R) = PrimeSpectrum.zeroLocus (I : Set R)) :
    ∃ (k : ℕ) (g : R), a ^ k = f * g := by
  have hrad := radical_eq_of_zeroLocus_eq I f hf
  have ha' : a ∈ (Ideal.span ({f} : Set R)).radical := by
    rw [hrad]; exact Ideal.le_radical ha
  obtain ⟨k, hk⟩ := ha'
  rw [Ideal.mem_span_singleton] at hk
  obtain ⟨g, hg⟩ := hk
  exact ⟨k, g, hg⟩

/-- From `V(f) = V(I)`: a power of `f` lies in `I`. -/
@[ega "I 10.8.2" "special case"]
theorem exists_pow_f_mem (f : R)
    (hf : PrimeSpectrum.zeroLocus ({f} : Set R) = PrimeSpectrum.zeroLocus (I : Set R)) :
    ∃ m : ℕ, f ^ m ∈ I := by
  have hrad := radical_eq_of_zeroLocus_eq I f hf
  have hf' : f ∈ I.radical := by
    rw [← hrad]
    exact Ideal.le_radical (Ideal.mem_span_singleton_self f)
  obtain ⟨m, hm⟩ := hf'
  exact ⟨m, hm⟩

/-- The image of `f` in `R'`. -/
noncomputable def fImage (f : R) : Rprime I a := algebraMap R (Rprime I a) f

/-- If `a ∈ I` and `V(f) = V(I)`, the image of `f` in `R_a` is a unit. -/
theorem isUnit_algebraMap_f (ha : a ∈ I) (f : R)
    (hf : PrimeSpectrum.zeroLocus ({f} : Set R) = PrimeSpectrum.zeroLocus (I : Set R)) :
    IsUnit (algebraMap R (Ra a) f) := by
  obtain ⟨k, g, hkg⟩ := exists_pow_eq_f_mul I a ha f hf
  have hunit : IsUnit ((algebraMap R (Ra a) a) ^ k) :=
    (IsLocalization.Away.algebraMap_isUnit a).pow k
  have hdvd : algebraMap R (Ra a) f ∣ (algebraMap R (Ra a) a) ^ k := by
    rw [← map_pow, hkg, map_mul]
    exact Dvd.intro _ rfl
  exact isUnit_of_dvd_unit hdvd hunit

/-- If `a ∈ I` and `V(f) = V(I)`, then the image of `f` in `R' = R[I/a]` is a nonzerodivisor. -/
@[stacks 080U "f nonzerodivisor in R'"]
theorem fImage_mem_nonZeroDivisors (ha : a ∈ I) (f : R)
    (hf : PrimeSpectrum.zeroLocus ({f} : Set R) = PrimeSpectrum.zeroLocus (I : Set R)) :
    fImage I a f ∈ nonZeroDivisors (Rprime I a) := by
  have hunit := isUnit_algebraMap_f I a ha f hf
  obtain ⟨u, hu⟩ := hunit
  have main : ∀ w : Rprime I a, w * fImage I a f = 0 → w = 0 := by
    intro w hw
    have hcoe : (w : Ra a) * algebraMap R (Ra a) f = 0 := by
      have := congrArg (fun t : Rprime I a => (t : Ra a)) hw
      simpa [Subalgebra.coe_mul, fImage, algebraMap_blowup_coe] using this
    have hwzero : (w : Ra a) = 0 := by
      have : (w : Ra a) * algebraMap R (Ra a) f * (↑u⁻¹) = 0 := by rw [hcoe, zero_mul]
      rwa [mul_assoc, ← hu, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one] at this
    exact Subtype.coe_injective hwzero
  rw [mem_nonZeroDivisors_iff]
  exact ⟨fun w hw => main w (by rw [mul_comm] at hw; exact hw), main⟩

/-- If `α ^ k = φ * t` and `α ∣ φ ^ m`, then a localization away from `φ` is also a
localization away from `α`. -/
theorem isLocalizationAway_of_dvd_pow {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]
    {φ α : A} [IsLocalization.Away φ S] (hA : ∃ k t, α ^ k = φ * t) (hB : ∃ m, α ∣ φ ^ m) :
    IsLocalization.Away α S := by
  obtain ⟨k, t, hkt⟩ := hA
  obtain ⟨m, hm⟩ := hB
  have huα : IsUnit (algebraMap A S α) :=
    isUnit_of_dvd_unit (map_pow (algebraMap A S) φ m ▸ map_dvd _ hm)
      (IsLocalization.Away.algebraMap_pow_isUnit (S := S) φ m)
  have hαkp (p : ℕ) : α ^ (k * p) = φ ^ p * t ^ p := by rw [pow_mul, hkt, mul_pow]
  refine ⟨⟨?_, fun z => ?_, fun {x y} hxy => ?_⟩⟩
  · rintro ⟨y, n, rfl⟩
    simpa using huα.pow n
  · obtain ⟨p, w, hw⟩ := IsLocalization.Away.surj (S := S) φ z
    refine ⟨⟨w * t ^ p, ⟨α ^ (k * p), ⟨k * p, rfl⟩⟩⟩, ?_⟩
    dsimp only
    rw [hαkp, map_mul, map_mul, map_pow]
    linear_combination algebraMap A S (t ^ p) * hw
  · obtain ⟨p, hp⟩ := IsLocalization.Away.exists_of_eq (S := S) φ hxy
    refine ⟨⟨α ^ (k * p), ⟨k * p, rfl⟩⟩, ?_⟩
    dsimp only
    rw [hαkp]
    linear_combination t ^ p * hp

/-- Assume `a ∈ I` and `V(f) = V(I)`. Let `R'f` be a localization of `R' = R[I/a]` away from
the image of `f`, and `R'a` a localization of `R'` away from the image of `a`. Then `R'f` is also
a localization of `R'` away from the image of `a`, and `R'f ≃ₐ[R] R'a`. -/
@[stacks 080U "R'_f = R'_a"]
theorem blowup_localization_f_iso_a (ha : a ∈ I) (f : R)
    (hf : PrimeSpectrum.zeroLocus ({f} : Set R) = PrimeSpectrum.zeroLocus (I : Set R))
    (R'f R'a : Type*) [CommRing R'f] [CommRing R'a]
    [Algebra (Rprime I a) R'f] [Algebra (Rprime I a) R'a]
    [Algebra R R'f] [Algebra R R'a]
    [IsScalarTower R (Rprime I a) R'f] [IsScalarTower R (Rprime I a) R'a]
    [IsLocalization.Away (fImage I a f) R'f]
    [IsLocalization.Away (algebraMap R (Rprime I a) a) R'a] :
    IsLocalization.Away (algebraMap R (Rprime I a) a) R'f ∧
      Nonempty (R'f ≃ₐ[R] R'a) := by
  set R' := Rprime I a
  set φ : R' := fImage I a f with hφ
  set α : R' := algebraMap R R' a with hα
  have hA : ∃ (k : ℕ) (t : R'), α ^ k = φ * t := by
    obtain ⟨k, g, hkg⟩ := exists_pow_eq_f_mul I a ha f hf
    refine ⟨k, algebraMap R R' g, ?_⟩
    rw [hα, hφ, fImage, ← map_pow, hkg, map_mul]
  have hB : ∃ (m : ℕ), α ∣ φ ^ m := by
    obtain ⟨m, hm⟩ := exists_pow_f_mem I f hf
    obtain ⟨hmem, hmul⟩ := mul_divByA_mem I a (f ^ m) hm
    refine ⟨m, ⟨⟨divByA a (f ^ m), hmem⟩, ?_⟩⟩
    apply Subtype.coe_injective
    change ((φ ^ m : R') : Ra a) = ((α * ⟨divByA a (f ^ m), hmem⟩ : R') : Ra a)
    rw [Subalgebra.coe_pow, Subalgebra.coe_mul]
    change (algebraMap R (Ra a) f) ^ m = (algebraMap R (Ra a) a) * divByA a (f ^ m)
    rw [← map_pow, ← hmul]
  have hConj1 : IsLocalization.Away α R'f := isLocalizationAway_of_dvd_pow hA hB
  exact ⟨hConj1, ⟨(IsLocalization.algEquiv (Submonoid.powers α) R'f R'a).restrictScalars R⟩⟩

/-- Let `R'a` be a localization of `R' = R[I/a]` away from the image of `a`, and `Ra'` a
localization of `R` away from `a`. Then the canonical map `R_a → R'_a` induced by `R → R'` is
bijective. -/
@[stacks 080U "R'_a = R_a"]
theorem ringLocalization_a_iso_blowup_localization_a
    (R'a Ra' : Type*) [CommRing R'a] [CommRing Ra']
    [Algebra (Rprime I a) R'a] [Algebra R Ra'] [Algebra R R'a]
    [IsScalarTower R (Rprime I a) R'a]
    [IsLocalization.Away (algebraMap R (Rprime I a) a) R'a]
    [IsLocalization.Away a Ra'] :
    Function.Bijective
      (IsLocalization.Away.map Ra' R'a (algebraMap R (Rprime I a)) a) := by
  have : IsLocalization.Away a R'a := isLocalizationAway_of_blowupAway I a R'a
  have hcomm : (IsLocalization.Away.map Ra' R'a (algebraMap R (Rprime I a)) a).comp
      (algebraMap R Ra') = algebraMap R R'a := by
    ext r
    simp only [RingHom.comp_apply]
    rw [IsLocalization.Away.map, IsLocalization.map_eq, ← RingHom.comp_apply,
      ← IsScalarTower.algebraMap_eq]
  exact IsLocalization.bijective (M := Submonoid.powers a) (S := Ra') (Q := R'a) _ hcomm

end AffineBlowup

end

/-!
### Base change of an affine blowup algebra, up to `b`-power torsion

Here `R[I/a]` is `affineBlowup0BIP I a ha`, the `R`-subalgebra of `Localization.Away a` of the
fractions `x/aⁿ` with `x ∈ Iⁿ`. For a ring `A` and `b : A`, `torsionIdeal A b` is the `b`-power
torsion ideal `A[b^∞] = {z | ∃ m, bᵐ z = 0}`.

Let `φ : R → S` be a ring map, `J = I S = I.map φ` and `b = φ a ∈ J`, and let
`T = S ⊗[R] R[I/a]`. There is a surjective `S`-algebra homomorphism `Φ : T → S[J/b]` with
`Φ (s ⊗ x/aⁿ) = (φ x · s)/bⁿ`, whose kernel is the `b`-power torsion ideal `T[b^∞]`, where `b`
denotes the image of `a` in `T`. Consequently `T / T[b^∞] ≅ S[J/b]` as `S`-algebras.
-/

@[expose] public section

variable {R : Type*} [CommRing R] (I : Ideal R) (a : R)

/-- The fraction `x / a^n` inside `Localization.Away a`. -/
noncomputable def frac (x : R) (n : ℕ) : Localization.Away a :=
  IsLocalization.mk' (Localization.Away a) x
    ⟨a ^ n, Submonoid.pow_mem _ (Submonoid.mem_powers a) n⟩

/-- The fraction `r/a⁰` is the image of `r` in `Localization.Away a`. -/
@[simp] lemma frac_algebraMap (r : R) : frac a r 0 = algebraMap R (Localization.Away a) r := by
  rw [← IsLocalization.mk'_one (M := Submonoid.powers a)]
  unfold frac
  apply IsLocalization.mk'_eq_iff_eq.mpr
  simp

/-- Multiplying fractions: `(x/aⁿ)(y/aᵐ) = (x y)/a^(n+m)`. -/
@[ega "0 1.2.2" "partial"]
lemma frac_mul (x y : R) (n m : ℕ) : frac a x n * frac a y m = frac a (x * y) (n + m) := by
  unfold frac
  rw [← IsLocalization.mk'_mul]
  congr 1
  ext
  simp [pow_add]

/-- Adding fractions: `x/aⁿ + y/aᵐ = (aᵐ x + aⁿ y)/a^(n+m)`. -/
@[ega "0 1.2.2" "partial"]
lemma frac_add (x y : R) (n m : ℕ) :
    frac a x n + frac a y m = frac a (a ^ m * x + a ^ n * y) (n + m) := by
  unfold frac
  rw [← IsLocalization.mk'_add]
  apply IsLocalization.mk'_eq_iff_eq.mpr
  push_cast
  ring

/-- The fraction `0/aⁿ` is zero. -/
@[simp] lemma frac_zero (n : ℕ) : frac a (0 : R) n = 0 := by unfold frac; simp

/-- Two fractions are equal, `x/aⁿ = y/aᵐ`, if and only if `aᵏ (aᵐ x - aⁿ y) = 0` for some
`k`. -/
lemma frac_eq_iff (x y : R) (n m : ℕ) :
    frac a x n = frac a y m ↔ ∃ k : ℕ, a ^ k * (a ^ m * x - a ^ n * y) = 0 := by
  unfold frac
  rw [IsLocalization.mk'_eq_iff_eq, ← sub_eq_zero, ← map_sub]
  exact algebraMap_away_eq_zero_iff a _

/-- The affine blowup algebra `R[I/a]`, realized as the `R`-subalgebra of
`Localization.Away a` of elements `x / a^n` with `x ∈ I^n`. Requires `a ∈ I`. -/
noncomputable def affineBlowup0BIP (ha : a ∈ I) : Subalgebra R (Localization.Away a) where
  carrier := { z | ∃ (n : ℕ) (x : R), x ∈ I ^ n ∧ z = frac a x n }
  mul_mem' := by
    rintro p q ⟨n, x, hx, rfl⟩ ⟨m, y, hy, rfl⟩
    exact ⟨n + m, x * y, by rw [pow_add]; exact Ideal.mul_mem_mul hx hy, frac_mul a x y n m⟩
  one_mem' := ⟨0, 1, by simp, ((frac_algebraMap a 1).trans (map_one _)).symm⟩
  add_mem' := by
    rintro p q ⟨n, x, hx, rfl⟩ ⟨m, y, hy, rfl⟩
    refine ⟨n + m, a ^ m * x + a ^ n * y, ?_, frac_add a x y n m⟩
    rw [pow_add]
    exact Ideal.add_mem _
      (by rw [mul_comm (I ^ n) (I ^ m)]; exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha m) hx)
      (Ideal.mul_mem_mul (Ideal.pow_mem_pow ha n) hy)
  zero_mem' := ⟨0, 0, by simp, (frac_zero a 0).symm⟩
  algebraMap_mem' := fun r => ⟨0, r, by simp, (frac_algebraMap a r).symm⟩

/-- Membership in the affine blowup algebra: an element is `x/a^n` for some `x ∈ I^n`. -/
lemma mem_affineBlowup_iff0BIP (ha : a ∈ I) (z : Localization.Away a) :
    z ∈ affineBlowup0BIP I a ha ↔ ∃ (n : ℕ) (x : R), x ∈ I ^ n ∧ z = frac a x n := Iff.rfl

/-- The `b`-power torsion ideal `A[b^∞] = { z | ∃ m, b^m z = 0 }` of a ring `A`. -/
def torsionIdeal (A : Type*) [CommRing A] (b : A) : Ideal A where
  carrier := { z | ∃ m : ℕ, b ^ m * z = 0 }
  add_mem' := by
    rintro x y ⟨m, hm⟩ ⟨k, hk⟩
    refine ⟨max m k, ?_⟩
    rw [mul_add]
    have e1 : b ^ max m k * x = 0 := by
      rw [show max m k = (max m k - m) + m by omega, pow_add, mul_assoc, hm, mul_zero]
    have e2 : b ^ max m k * y = 0 := by
      rw [show max m k = (max m k - k) + k by omega, pow_add, mul_assoc, hk, mul_zero]
    rw [e1, e2, add_zero]
  zero_mem' := ⟨0, by simp⟩
  smul_mem' := by
    rintro c x ⟨m, hm⟩
    refine ⟨m, ?_⟩
    simp only [smul_eq_mul]
    rw [← mul_assoc, mul_comm (b ^ m) c, mul_assoc, hm, mul_zero]

/-- Membership in the `b`-power torsion ideal. -/
lemma mem_torsionIdeal_iff (A : Type*) [CommRing A] (b z : A) :
    z ∈ torsionIdeal A b ↔ ∃ m : ℕ, b ^ m * z = 0 := Iff.rfl

/-- `φ x ∈ J^n` whenever `x ∈ I^n`, where `J = I.map φ` and `φ = algebraMap R S`. -/
lemma map_pow_mem {S : Type*} [CommRing S] [Algebra R S] (n : ℕ) (x : R) (hx : x ∈ I ^ n) :
    algebraMap R S x ∈ (I.map (algebraMap R S)) ^ n := by
  rw [← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ hx

noncomputable section

variable {S : Type*} [CommRing S] [Algebra R S] (ha : a ∈ I)

/-- Let `φ = algebraMap R S`, `J = I.map φ` and `b = φ a`. There is an `S`-algebra map
`Φ : S ⊗[R] R[I/a] → S[J/b]` with `Φ (s ⊗ x/aⁿ) = φ(x)·s / bⁿ`. -/
theorem affineBlowupBaseChange_hom :
    ∃ Φ : (TensorProduct R S (affineBlowup0BIP I a ha)) →ₐ[S]
            (affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
              (Ideal.mem_map_of_mem _ ha)),
      (∀ (s : S) (n : ℕ) (x : R) (hx : x ∈ I ^ n),
          Φ (TensorProduct.tmul R s ⟨frac a x n, ⟨n, x, hx, rfl⟩⟩)
            = (algebraMap S _ s) *
                ⟨frac (algebraMap R S a) (algebraMap R S x) n,
                  ⟨n, algebraMap R S x, map_pow_mem I n x hx, rfl⟩⟩) := by
  set φ : R →+* S := algebraMap R S with hφ
  set b : S := algebraMap R S a with hb
  set B := affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a) (Ideal.mem_map_of_mem _ ha)
      with hB
  have hle : Submonoid.powers a ≤ Submonoid.comap φ (Submonoid.powers b) := by
    rintro y ⟨n, rfl⟩
    exact ⟨n, by rw [hb, ← hφ, map_pow]⟩
  set localAway : Localization.Away a →+* Localization.Away b :=
    IsLocalization.map (Localization.Away b) φ hle with hlocal
  have hfrac : ∀ (x : R) (n : ℕ), localAway (frac a x n) = frac b (φ x) n := by
    intro x n
    rw [hlocal]
    unfold frac
    rw [IsLocalization.map_mk']
    congr 1
    · simp [hb, hφ, map_pow]
  let localAwayAlg : Localization.Away a →ₐ[R] Localization.Away b :=
    { localAway with
      commutes' := by
        intro r
        change localAway (algebraMap R (Localization.Away a) r) = algebraMap R (Localization.Away
            b) r
        rw [hlocal, IsLocalization.map_eq]
        rw [IsScalarTower.algebraMap_apply R S (Localization.Away b)] }
  have hmem : ∀ z : (affineBlowup0BIP I a ha), localAwayAlg (z : Localization.Away a) ∈ B := by
    rintro ⟨z, n, x, hx, rfl⟩
    rw [hB, mem_affineBlowup_iff0BIP]
    refine ⟨n, φ x, ?_, ?_⟩
    · exact map_pow_mem I n x hx
    · change localAway (frac a x n) = _
      rw [hfrac]
  let g : (affineBlowup0BIP I a ha) →ₐ[R] B :=
    (localAwayAlg.comp (affineBlowup0BIP I a ha).val).codRestrict (B.restrictScalars R) (by
      intro z; exact hmem z)
  have hg : ∀ (n : ℕ) (x : R) (hx : x ∈ I ^ n),
      g ⟨frac a x n, ⟨n, x, hx, rfl⟩⟩ =
        ⟨frac b (φ x) n, ⟨n, φ x, map_pow_mem I n x hx, rfl⟩⟩ := by
    intro n x hx
    apply Subtype.ext
    change localAway (frac a x n) = _
    rw [hfrac]
  refine ⟨Algebra.TensorProduct.lift (Algebra.ofId S B) g (fun _ _ => Commute.all _ _), ?_⟩
  intro s n x hx
  rw [Algebra.TensorProduct.lift_tmul]
  rw [hg n x hx]
  congr 1

/-- An `S`-algebra map `Φ : S ⊗[R] R[I/a] → S[J/b]` with `Φ (s ⊗ x/aⁿ) = φ(x)·s / bⁿ` is
surjective. -/
theorem affineBlowupBaseChange_surjective
    (Φ : (TensorProduct R S (affineBlowup0BIP I a ha)) →ₐ[S]
            (affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
              (Ideal.mem_map_of_mem _ ha)))
    (hΦ : ∀ (s : S) (n : ℕ) (x : R) (hx : x ∈ I ^ n),
          Φ (TensorProduct.tmul R s ⟨frac a x n, ⟨n, x, hx, rfl⟩⟩)
            = (algebraMap S _ s) *
                ⟨frac (algebraMap R S a) (algebraMap R S x) n,
                  ⟨n, algebraMap R S x, map_pow_mem I n x hx, rfl⟩⟩) :
    Function.Surjective Φ := by
  set b : S := algebraMap R S a with hb
  have frac_add_same : ∀ (y1 y2 : S) (n : ℕ),
      frac b y1 n + frac b y2 n = frac b (y1 + y2) n := by
    intro y1 y2 n
    unfold frac
    rw [← IsLocalization.mk'_add]
    apply IsLocalization.mk'_eq_iff_eq.mpr
    push_cast
    ring
  have frac_smul : ∀ (s : S) (y : S) (n : ℕ),
      (algebraMap S (Localization.Away b) s) * frac b y n = frac b (s * y) n := by
    intro s y n
    rw [← frac_algebraMap, frac_mul, zero_add]
  have main : ∀ (n : ℕ) (y : S),
      y ∈ Submodule.span S ((algebraMap R S) '' (↑(I ^ n) : Set R)) →
      ∃ t, (Φ t : Localization.Away b) = frac b y n := by
    intro n y hy
    induction hy using Submodule.span_induction with
    | mem m hm =>
        obtain ⟨x, hx, rfl⟩ := hm
        refine ⟨TensorProduct.tmul R 1 ⟨frac a x n, ⟨n, x, hx, rfl⟩⟩, ?_⟩
        rw [hΦ 1 n x hx, map_one, one_mul]
    | zero => exact ⟨0, by rw [map_zero]; exact (frac_zero b n).symm ▸ rfl⟩
    | add y1 y2 _ _ ih1 ih2 =>
        obtain ⟨t1, ht1⟩ := ih1
        obtain ⟨t2, ht2⟩ := ih2
        refine ⟨t1 + t2, ?_⟩
        rw [map_add]
        change (Φ t1 : Localization.Away b) + (Φ t2 : Localization.Away b) = _
        rw [ht1, ht2, frac_add_same]
    | smul s y _ ih =>
        obtain ⟨t, ht⟩ := ih
        refine ⟨s • t, ?_⟩
        rw [map_smul]
        change s • (Φ t : Localization.Away b) = _
        rw [ht, Algebra.smul_def, frac_smul, smul_eq_mul]
  intro w
  obtain ⟨v, n, y, hy, hv⟩ := w
  rw [← Ideal.map_pow] at hy
  have hyspan : y ∈ Submodule.span S ((algebraMap R S) '' (↑(I ^ n) : Set R)) := hy
  obtain ⟨t, ht⟩ := main n y hyspan
  refine ⟨t, ?_⟩
  exact Subtype.ext (ht.trans hv.symm)

/-- Every `b`-power torsion element of `S ⊗[R] R[I/a]` lies in the kernel of an `S`-algebra map
`Φ : S ⊗[R] R[I/a] → S[J/b]`. -/
theorem affineBlowupBaseChange_torsion_le_ker
    (Φ : (TensorProduct R S (affineBlowup0BIP I a ha)) →ₐ[S]
            (affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
              (Ideal.mem_map_of_mem _ ha)))
    :
    torsionIdeal (TensorProduct R S (affineBlowup0BIP I a ha))
        (algebraMap S _ (algebraMap R S a)) ≤ RingHom.ker Φ.toRingHom := by
  set b : S := algebraMap R S a with hb
  let B := affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
      (Ideal.mem_map_of_mem _ ha)
  have hunit : IsUnit (algebraMap S (Localization.Away b) b) :=
    IsLocalization.map_units (Localization.Away b) (⟨b, Submonoid.mem_powers b⟩ : Submonoid.powers
        b)
  intro z hz
  obtain ⟨m, hm⟩ := (mem_torsionIdeal_iff _ _ _).mp hz
  rw [RingHom.mem_ker]
  have hΦ0 : Φ ((algebraMap S _ b) ^ m * z) = 0 := by rw [hm]; exact map_zero _
  rw [map_mul, map_pow, AlgHom.commutes] at hΦ0
  have hval : (B.val) ((algebraMap S B b) ^ m * Φ z) = 0 := by
    rw [hΦ0]; exact map_zero _
  rw [map_mul, map_pow, B.val.commutes] at hval
  have hΦz : (B.val) (Φ z) = 0 := by
    rcases hunit.pow m with ⟨u, hu⟩
    rw [← hu] at hval
    exact (Units.mul_right_eq_zero u).mp hval
  have hinj : Function.Injective (B.val) := Subtype.val_injective
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  exact hinj (by rw [hΦz, map_zero])

/-- Every element of the kernel of an `S`-algebra map `Φ : S ⊗[R] R[I/a] → S[J/b]` is `b`-power
torsion. -/
theorem affineBlowupBaseChange_ker_le_torsion
    (Φ : (TensorProduct R S (affineBlowup0BIP I a ha)) →ₐ[S]
            (affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
              (Ideal.mem_map_of_mem _ ha)))
    :
    RingHom.ker Φ.toRingHom ≤
      torsionIdeal (TensorProduct R S (affineBlowup0BIP I a ha))
        (algebraMap S _ (algebraMap R S a)) := by
  set T := TensorProduct R S (affineBlowup0BIP I a ha) with hT
  set b : S := algebraMap R S a with hb
  let B := affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
    (Ideal.mem_map_of_mem _ ha)
  have key : ∀ (s : S) (n : ℕ) (x : R) (hx : x ∈ I ^ n),
      (algebraMap S T b) ^ n *
          (TensorProduct.tmul R s (⟨frac a x n, ⟨n, x, hx, rfl⟩⟩ : affineBlowup0BIP I a ha))
        = algebraMap S T (s * algebraMap R S x) := by
    intro s n x hx
    have hy : (a ^ n) • (⟨frac a x n, ⟨n, x, hx, rfl⟩⟩ : affineBlowup0BIP I a ha)
        = ⟨algebraMap R (Localization.Away a) x, (affineBlowup0BIP I a ha).algebraMap_mem' x⟩ := by
      apply Subtype.ext
      change (a ^ n) • frac a x n = algebraMap R (Localization.Away a) x
      rw [Algebra.smul_def, ← frac_algebraMap a (a ^ n), frac_mul, ← frac_algebraMap a x,
        frac_eq_iff]
      exact ⟨0, by ring⟩
    rw [← map_pow]
    have hbn : b ^ n = algebraMap R S (a ^ n) := by rw [hb, map_pow]
    rw [hbn, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
      one_mul]
    simp only [Algebra.algebraMap_self_apply]
    rw [show algebraMap R S (a ^ n) * s = (a ^ n : R) • s from (Algebra.smul_def _ _).symm,
      TensorProduct.smul_tmul, hy]
    have hx1 : (⟨algebraMap R (Localization.Away a) x, (affineBlowup0BIP I a ha).algebraMap_mem' x⟩
        : affineBlowup0BIP I a ha) = x • (1 : affineBlowup0BIP I a ha) := by
      apply Subtype.ext
      change algebraMap R (Localization.Away a) x = x • (1 : Localization.Away a)
      rw [Algebra.smul_def, mul_one]
    rw [hx1, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
      Algebra.TensorProduct.algebraMap_apply]
    simp only [Algebra.algebraMap_self_apply]
    congr 1
    rw [Algebra.smul_def, mul_comm]
  have shift : ∀ (n : ℕ) (z : T) (t : S), (algebraMap S T b) ^ n * z = algebraMap S T t →
      ∀ N, n ≤ N →
        (algebraMap S T b) ^ N * z = algebraMap S T (b ^ (N - n)) * algebraMap S T t := by
    intro n z t h N hN
    rw [map_pow, ← h, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hN]
  have hclear : ∀ z : T, ∃ (n : ℕ) (t : S),
      (algebraMap S T b) ^ n * z = algebraMap S T t := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul s y =>
        obtain ⟨m, x, hx, hyeq⟩ := y.property
        refine ⟨m, s * algebraMap R S x, ?_⟩
        have : y = (⟨frac a x m, ⟨m, x, hx, rfl⟩⟩ : affineBlowup0BIP I a ha) := Subtype.ext hyeq
        rw [this]
        exact key s m x hx
    | add z1 z2 h1 h2 =>
        obtain ⟨n1, t1, ht1⟩ := h1
        obtain ⟨n2, t2, ht2⟩ := h2
        refine ⟨max n1 n2, b ^ (max n1 n2 - n1) * t1 + b ^ (max n1 n2 - n2) * t2, ?_⟩
        rw [mul_add, shift _ _ _ ht1 _ (le_max_left _ _), shift _ _ _ ht2 _ (le_max_right _ _),
          map_add, map_mul, map_mul]
  intro z hz
  rw [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hz
  obtain ⟨n, t, hnt⟩ := hclear z
  have hΦt : algebraMap S B t = 0 := by
    have h1 : Φ ((algebraMap S T b) ^ n * z) = Φ (algebraMap S T t) := by rw [hnt]
    rw [map_mul, map_pow, AlgHom.commutes, AlgHom.commutes, hz, mul_zero] at h1
    exact h1.symm
  have hval : algebraMap S (Localization.Away b) t = 0 := by
    have h2 := congrArg B.val hΦt
    rwa [B.val.commutes, map_zero] at h2
  obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers b) _ _).mp hval
  obtain ⟨k, hk⟩ := c.property
  rw [mem_torsionIdeal_iff]
  refine ⟨k + n, ?_⟩
  rw [pow_add, mul_assoc, hnt, ← map_pow, ← map_mul]
  have hbkt : b ^ k * t = 0 := by
    have hct : (c : S) * t = 0 := hc
    rw [show (c : S) = b ^ k from hk.symm] at hct
    exact hct
  rw [hbkt, map_zero]

/-- There is a canonical surjective `S`-algebra homomorphism
`Φ : S ⊗[R] R[I/a] → S[J/b]` (with `J = I·S = I.map (algebraMap R S)`, `b = algebraMap R S a`)
determined on generators by `Φ (s ⊗ (x/a^n)) = (φ x · s)/b^n`, whose kernel is exactly the
`b`-power torsion ideal of the source `S ⊗[R] R[I/a]` (where `b` denotes the image of `a`,
equivalently of `b`, in the tensor product). -/
theorem affineBlowup_baseChange :
    ∃ Φ : (TensorProduct R S (affineBlowup0BIP I a ha)) →ₐ[S]
            (affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
              (Ideal.mem_map_of_mem _ ha)),
      (∀ (s : S) (n : ℕ) (x : R) (hx : x ∈ I ^ n),
          Φ (TensorProduct.tmul R s ⟨frac a x n, ⟨n, x, hx, rfl⟩⟩)
            = (algebraMap S _ s) *
                ⟨frac (algebraMap R S a) (algebraMap R S x) n,
                  ⟨n, algebraMap R S x, map_pow_mem I n x hx, rfl⟩⟩)
      ∧ Function.Surjective Φ
      ∧ RingHom.ker Φ.toRingHom
          = torsionIdeal (TensorProduct R S (affineBlowup0BIP I a ha))
              (algebraMap S _ (algebraMap R S a)) := by
  obtain ⟨Φ, hΦ⟩ := affineBlowupBaseChange_hom (S := S) I a ha
  refine ⟨Φ, hΦ, affineBlowupBaseChange_surjective I a ha Φ hΦ, ?_⟩
  exact le_antisymm
    (affineBlowupBaseChange_ker_le_torsion I a ha Φ)
    (affineBlowupBaseChange_torsion_le_ker I a ha Φ)

/-- The map `Φ` of `affineBlowup_baseChange` induces an isomorphism of `S`-algebras
`(S ⊗[R] R[I/a]) / (S ⊗[R] R[I/a])[b^∞] ≅ S[J/b]`. -/
@[stacks 0BIP]
theorem affineBlowup_baseChange_iso :
    Nonempty <|
      (TensorProduct R S (affineBlowup0BIP I a ha) ⧸
        torsionIdeal (TensorProduct R S (affineBlowup0BIP I a ha))
          (algebraMap S _ (algebraMap R S a)))
      ≃ₐ[S]
      (affineBlowup0BIP (I.map (algebraMap R S)) (algebraMap R S a)
        (Ideal.mem_map_of_mem _ ha)) := by
  obtain ⟨Φ, _, hsurj, hker⟩ := affineBlowup_baseChange (S := S) I a ha
  exact ⟨(Ideal.quotientEquivAlgOfEq S hker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hsurj)⟩

end

