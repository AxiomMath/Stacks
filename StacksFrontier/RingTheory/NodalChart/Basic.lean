module

public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Adjoin.Basic

/-!
# The standard nodal chart ring `R[x, y]/(xy - h)`

For a commutative ring `R` and an element `h : R` the *nodal chart ring* is the quotient
`R[x, y]/(xy - h)`. For `R` a discrete valuation ring with uniformizer `π` and `h = πⁿ` this is
the coordinate ring of the standard model of a nodal curve singularity over `R`; `h = 0` gives
the two coordinate axes and `h` a unit gives a smooth affine curve.

An `R`-algebra map out of `R[x, y]/(xy - h)` is the same thing as a pair of elements of the
target whose product is the image of `h`, and this file provides that correspondence together
with the facts about the ring needed to compute with it: it is generated over `R` by the images
of the two coordinates, and for `h ≠ 0` over a unique factorization domain it is a domain,
because `xy - h` is then a prime element of `R[x, y]`.

## Main definitions

* `Stacks.nodalEquation` — the polynomial `xy - h`.
* `Stacks.nodalChartRing` — the ring `R[x, y]/(xy - h)`.
* `Stacks.nodalGen` — the images of the two coordinates.
* `Stacks.nodalLift` — the `R`-algebra map determined by a pair of elements with product `h`.
* `Stacks.nodalChartAwayMap` — the map to the localization of `R[X]` away from `X`.

## Main results

* `Stacks.nodalGen_zero_mul_nodalGen_one` — the defining relation.
* `Stacks.nodalChartRing_algHom_ext` — an `R`-algebra map is determined by the images of the two
  coordinates.
* `Stacks.adjoin_nodalGen_eq_top` — the two coordinates generate.
* `Stacks.range_nodalLift` — the range of a lift is the subalgebra generated by the chosen pair.
* `Stacks.prime_nodalEquation` — `xy - h` is a prime element of `R[x, y]` for `h ≠ 0`.
* `Stacks.isDomain_nodalChartRing` — the nodal chart ring is a domain for `h ≠ 0`.
* `Stacks.injective_algebraMap_nodalChartRing`, `Stacks.nodalGen_zero_ne_zero`,
  `Stacks.nodalGen_one_ne_zero` — nondegeneracy of the structure map and of the coordinates.

## Implementation notes

The ring is an abbreviation for the quotient of `MvPolynomial (Fin 2) R`, so all of Mathlib's
quotient API applies to it unchanged, and `nodalGen` is the image of `MvPolynomial.X` rather
than a new opaque constant.

Primality of `xy - h` is proved by transporting along `MvPolynomial.finSuccEquiv`, which
presents `R[x, y]` as `(R[y])[x]` with `x ↦ X` and `y ↦ C y`: there `xy - h` is the degree one
polynomial `C y · X + C (-h)`, whose coefficients `y` and `-h` are relatively prime because `y`
is a prime of `R[y]` not dividing the nonzero constant `-h`. Irreducibility then comes from
`Polynomial.irreducible_C_mul_X_add_C` and primality from unique factorization. This is where
the hypothesis `UniqueFactorizationMonoid R` is used; a discrete valuation ring satisfies it.

Nondegeneracy of the coordinates is read off from the `R`-algebra map `nodalChartAwayMap` to the
localization of `R[X]` away from `X`, which sends `x` to `X` and `y` to `h/X`.
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks

variable {R : Type u} [CommRing R]

/-- The *nodal equation* `xy - h` in the polynomial ring `R[x, y]`. -/
public def nodalEquation (R : Type u) [CommRing R] (h : R) : MvPolynomial (Fin 2) R :=
  X 0 * X 1 - C h

public theorem nodalEquation_def (h : R) :
    nodalEquation R h = X 0 * X 1 - C h := rfl

/-- The nodal equation is compatible with a change of coefficients: pushing `xy - h` forward
along a ring map gives the nodal equation of the image of the parameter. -/
public theorem map_nodalEquation {R' : Type*} [CommRing R'] (φ : R →+* R') (h : R) :
    MvPolynomial.map φ (nodalEquation R h) = nodalEquation R' (φ h) := by
  simp [nodalEquation_def]

/-- The standard nodal chart ring `R[x, y]/(xy - h)`. -/
public abbrev nodalChartRing (R : Type u) [CommRing R] (h : R) : Type u :=
  MvPolynomial (Fin 2) R ⧸ Ideal.span ({nodalEquation R h} : Set (MvPolynomial (Fin 2) R))

/-- The images of the two coordinates `x` and `y` in `R[x, y]/(xy - h)`. -/
public def nodalGen (R : Type u) [CommRing R] (h : R) (i : Fin 2) : nodalChartRing R h :=
  algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h) (X i)

public theorem nodalGen_eq (h : R) (i : Fin 2) :
    nodalGen R h i =
      algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h) (X i) := rfl

public theorem algebraMap_nodalChartRing_eq (h : R) (r : R) :
    algebraMap R (nodalChartRing R h) r =
      algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h) (C r) := rfl

/-- **The map of nodal charts induced by a change of the base ring**: the ring map
`R[x, y]/(xy - h) → R'[x, y]/(xy - φ h)` which is `φ` on the coefficients and sends each
coordinate to the coordinate of the same name. -/
public def nodalChartMap {R' : Type*} [CommRing R'] (φ : R →+* R') (h : R) :
    nodalChartRing R h →+* nodalChartRing R' (φ h) :=
  Ideal.quotientMap _ (MvPolynomial.map φ) <| by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
      map_nodalEquation]
    exact Ideal.subset_span rfl

public theorem nodalChartMap_comp_quotientMk {R' : Type*} [CommRing R'] (φ : R →+* R')
    (h : R) :
    (nodalChartMap φ h).comp
        (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) =
      (algebraMap (MvPolynomial (Fin 2) R') (nodalChartRing R' (φ h))).comp
        (MvPolynomial.map φ) := by
  rw [nodalChartMap, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.algebraMap_eq]
  exact Ideal.quotientMap_comp_mk _

@[simp] public theorem nodalChartMap_algebraMap {R' : Type*} [CommRing R'] (φ : R →+* R')
    (h : R) (r : R) :
    nodalChartMap φ h (algebraMap R (nodalChartRing R h) r) =
      algebraMap R' (nodalChartRing R' (φ h)) (φ r) := by
  rw [algebraMap_nodalChartRing_eq, algebraMap_nodalChartRing_eq, ← MvPolynomial.map_C φ]
  exact RingHom.congr_fun (nodalChartMap_comp_quotientMk φ h) (C r)

public theorem nodalChartMap_comp_algebraMap {R' : Type*} [CommRing R'] (φ : R →+* R')
    (h : R) :
    (nodalChartMap φ h).comp (algebraMap R (nodalChartRing R h)) =
      (algebraMap R' (nodalChartRing R' (φ h))).comp φ :=
  RingHom.ext fun r => nodalChartMap_algebraMap φ h r

@[simp] public theorem nodalChartMap_nodalGen {R' : Type*} [CommRing R'] (φ : R →+* R')
    (h : R) (i : Fin 2) :
    nodalChartMap φ h (nodalGen R h i) = nodalGen R' (φ h) i := by
  rw [nodalGen_eq, nodalGen_eq, ← MvPolynomial.map_X φ i]
  exact RingHom.congr_fun (nodalChartMap_comp_quotientMk φ h) (X i)

/-- The defining relation `xy = h` of the nodal chart ring. -/
public theorem nodalGen_zero_mul_nodalGen_one (h : R) :
    nodalGen R h 0 * nodalGen R h 1 = algebraMap R (nodalChartRing R h) h := by
  have hz : algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)
      (X 0 * X 1 - C h) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl)
  rw [map_sub, map_mul, sub_eq_zero] at hz
  rw [nodalGen, nodalGen, algebraMap_nodalChartRing_eq]
  exact hz

/-- Evaluating `R[x, y]` at the two coordinates of the nodal chart ring is the quotient map. -/
public theorem aeval_nodalGen (h : R) :
    (MvPolynomial.aeval (nodalGen R h) :
      MvPolynomial (Fin 2) R →ₐ[R] nodalChartRing R h) =
      Ideal.Quotient.mkₐ R (Ideal.span ({nodalEquation R h} :
        Set (MvPolynomial (Fin 2) R))) :=
  MvPolynomial.algHom_ext fun i ↦ by simp [nodalGen]

/-- The nodal chart ring is generated over `R` by the images of the two coordinates. -/
public theorem adjoin_nodalGen_eq_top (h : R) :
    Algebra.adjoin R (Set.range (nodalGen R h)) = ⊤ := by
  rw [Algebra.adjoin_range_eq_range_aeval, aeval_nodalGen, AlgHom.range_eq_top]
  exact Ideal.Quotient.mk_surjective

/-- An `R`-algebra map out of the nodal chart ring is determined by the images of the two
coordinates. -/
public theorem nodalChartRing_algHom_ext {h : R} {B : Type*} [CommRing B] [Algebra R B]
    {f g : nodalChartRing R h →ₐ[R] B}
    (hfg : ∀ i, f (nodalGen R h i) = g (nodalGen R h i)) : f = g := by
  refine AlgHom.ext fun z ↦ ?_
  have hz : z ∈ Algebra.adjoin R (Set.range (nodalGen R h)) := by
    rw [adjoin_nodalGen_eq_top]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hfg i
  | algebraMap r => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | mul x y _ _ hx hy => simp [hx, hy]

/-- A ring map out of the nodal chart ring is determined by its restriction to `R` together with
the images of the two coordinates. -/
public theorem nodalChartRing_ringHom_ext {h : R} {B : Type*} [CommRing B]
    {f g : nodalChartRing R h →+* B}
    (hR : ∀ r : R, f (algebraMap R (nodalChartRing R h) r) =
      g (algebraMap R (nodalChartRing R h) r))
    (hfg : ∀ i, f (nodalGen R h i) = g (nodalGen R h i)) : f = g := by
  refine RingHom.ext fun z ↦ ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective
    (I := Ideal.span ({nodalEquation R h} : Set (MvPolynomial (Fin 2) R))) z
  have hcomp : f.comp (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) =
      g.comp (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) :=
    MvPolynomial.ringHom_ext (fun r ↦ hR r) (fun i ↦ hfg i)
  exact RingHom.congr_fun hcomp p

/-- The `R`-algebra map `R[x, y]/(xy - h) → B` sending the coordinates to a pair of elements of
`B` whose product is the image of `h`. -/
public def nodalLift {h : R} {B : Type*} [CommRing B] [Algebra R B] (u : Fin 2 → B)
    (hu : u 0 * u 1 = algebraMap R B h) : nodalChartRing R h →ₐ[R] B :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval u) <| by
    intro p hp
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hp
    simp [nodalEquation_def, hu]

@[simp] public theorem nodalLift_nodalGen {h : R} {B : Type*} [CommRing B] [Algebra R B]
    (u : Fin 2 → B) (hu : u 0 * u 1 = algebraMap R B h) (i : Fin 2) :
    nodalLift u hu (nodalGen R h i) = u i := by
  rw [nodalLift, nodalGen, Ideal.Quotient.liftₐ_apply]
  exact (Ideal.Quotient.lift_mk _ _ _).trans (MvPolynomial.aeval_X u i)

/-- The range of `Stacks.nodalLift` is the subalgebra generated by the two chosen elements. -/
public theorem range_nodalLift {h : R} {B : Type*} [CommRing B] [Algebra R B] (u : Fin 2 → B)
    (hu : u 0 * u 1 = algebraMap R B h) :
    (nodalLift u hu).range = Algebra.adjoin R (Set.range u) := by
  rw [← Algebra.map_top (nodalLift u hu), ← adjoin_nodalGen_eq_top (R := R) h,
    ← Algebra.adjoin_image]
  congr 1
  rw [← Set.range_comp]
  exact congrArg Set.range (funext fun i ↦ nodalLift_nodalGen u hu i)

section Model

variable (R) in
/-- The `R`-algebra map from the nodal chart ring to the localization of `R[X]` away from `X`,
sending `x` to `X` and `y` to `h/X`. -/
public def nodalChartAwayMap (h : R) :
    nodalChartRing R h →ₐ[R] Localization.Away (Polynomial.X : Polynomial R) :=
  nodalLift
    ![algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R)) Polynomial.X,
      IsLocalization.mk' (Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.C h)
        ⟨Polynomial.X, Submonoid.mem_powers _⟩] <| by
    have hspec := IsLocalization.mk'_spec
      (Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.C h)
      (⟨Polynomial.X, Submonoid.mem_powers _⟩ :
        Submonoid.powers (Polynomial.X : Polynomial R))
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    rw [mul_comm, hspec, IsScalarTower.algebraMap_apply R (Polynomial R)
      (Localization.Away (Polynomial.X : Polynomial R))]
    simp

@[simp] public theorem nodalChartAwayMap_nodalGen_zero (h : R) :
    nodalChartAwayMap R h (nodalGen R h 0) =
      algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))
        Polynomial.X := by
  simp [nodalChartAwayMap]

@[simp] public theorem nodalChartAwayMap_nodalGen_one (h : R) :
    nodalChartAwayMap R h (nodalGen R h 1) =
      IsLocalization.mk' (Localization.Away (Polynomial.X : Polynomial R)) (Polynomial.C h)
        ⟨Polynomial.X, Submonoid.mem_powers _⟩ := by
  simp [nodalChartAwayMap]

end Model

section Domain

variable [IsDomain R] [UniqueFactorizationMonoid R]

/-- **The nodal equation is prime.** For `h ≠ 0` the polynomial `xy - h` is a prime element of
`R[x, y]`, `R` a unique factorization domain. -/
public theorem prime_nodalEquation {h : R} (hh : h ≠ 0) : Prime (nodalEquation R h) := by
  have hX0 : (X 0 : MvPolynomial (Fin 1) R) ≠ 0 := by simp
  have hndvd : ¬ (X 0 : MvPolynomial (Fin 1) R) ∣ (- C h) := by
    intro ⟨g, hg⟩
    apply hh
    have hev := congrArg (MvPolynomial.eval (fun _ ↦ (0 : R))) hg
    simp only [map_neg, eval_C, map_mul, eval_X, zero_mul, neg_eq_zero] at hev
    exact hev
  have hrel : IsRelPrime (X 0 : MvPolynomial (Fin 1) R) (- C h) :=
    (MvPolynomial.X_prime (σ := Fin 1) (R := R)
      (i := 0)).irreducible.isRelPrime_iff_not_dvd.2 hndvd
  have hirr : Prime
      (Polynomial.C (X 0 : MvPolynomial (Fin 1) R) * Polynomial.X + Polynomial.C (- C h)) :=
    (UniqueFactorizationMonoid.irreducible_iff_prime
      (α := Polynomial (MvPolynomial (Fin 1) R))).1
      (Polynomial.irreducible_C_mul_X_add_C hX0 hrel)
  have h1 : (MvPolynomial.finSuccEquiv R 1) (X 1 : MvPolynomial (Fin 2) R)
      = Polynomial.C (X 0) := by
    rw [show (1 : Fin 2) = Fin.succ 0 from rfl, MvPolynomial.finSuccEquiv_X_succ]
  have hC : (MvPolynomial.finSuccEquiv R 1) (C h : MvPolynomial (Fin 2) R)
      = Polynomial.C (C h) := by
    simpa using (MvPolynomial.finSuccEquiv R 1).commutes h
  have key : (MvPolynomial.finSuccEquiv R 1) (nodalEquation R h) =
      Polynomial.C (X 0 : MvPolynomial (Fin 1) R) * Polynomial.X + Polynomial.C (- C h) := by
    rw [nodalEquation_def, map_sub, map_mul, MvPolynomial.finSuccEquiv_X_zero, h1, hC, map_neg]
    ring
  rw [← MulEquiv.prime_iff (MvPolynomial.finSuccEquiv R 1).toMulEquiv,
    show ((MvPolynomial.finSuccEquiv R 1).toMulEquiv (nodalEquation R h)) = _ from key]
  exact hirr

/-- For `h ≠ 0` the nodal chart ring `R[x, y]/(xy - h)` over a unique factorization domain is a
domain. -/
public theorem isDomain_nodalChartRing {h : R} (hh : h ≠ 0) : IsDomain (nodalChartRing R h) :=
  have : (Ideal.span ({nodalEquation R h} : Set (MvPolynomial (Fin 2) R))).IsPrime :=
    (Ideal.span_singleton_prime (prime_nodalEquation hh).ne_zero).2 (prime_nodalEquation hh)
  Ideal.Quotient.isDomain _

end Domain

section Nondegenerate

variable [IsDomain R]

private theorem injective_algebraMap_away_polynomial_aux :
    Function.Injective
      (algebraMap (Polynomial R) (Localization.Away (Polynomial.X : Polynomial R))) :=
  IsLocalization.injective _
    (powers_le_nonZeroDivisors_of_noZeroDivisors (Polynomial.X_ne_zero (R := R)))

private theorem injective_algebraMap_away_polynomial :
    Function.Injective (algebraMap R (Localization.Away (Polynomial.X : Polynomial R))) := by
  rw [IsScalarTower.algebraMap_eq R (Polynomial R)]
  exact injective_algebraMap_away_polynomial_aux.comp Polynomial.C_injective

/-- The structure map `R → R[x, y]/(xy - h)` is injective. -/
public theorem injective_algebraMap_nodalChartRing (h : R) :
    Function.Injective (algebraMap R (nodalChartRing R h)) := by
  intro a b hab
  apply injective_algebraMap_away_polynomial (R := R)
  have := congrArg (nodalChartAwayMap R h) hab
  simpa using this

/-- The structure map `R → R[x, y]/(xy - h)` carries nonzero elements to nonzero elements. -/
public theorem algebraMap_nodalChartRing_ne_zero (h : R) {r : R} (hr : r ≠ 0) :
    algebraMap R (nodalChartRing R h) r ≠ 0 := fun hzero ↦ hr <| by
  refine injective_algebraMap_nodalChartRing h ?_
  simpa using hzero

/-- The first coordinate of the nodal chart ring is nonzero. -/
public theorem nodalGen_zero_ne_zero (h : R) : nodalGen R h 0 ≠ 0 := by
  intro hz
  have hX := congrArg (nodalChartAwayMap R h) hz
  rw [nodalChartAwayMap_nodalGen_zero, map_zero] at hX
  refine Polynomial.X_ne_zero (R := R) (injective_algebraMap_away_polynomial_aux ?_)
  rw [hX, map_zero]

/-- The second coordinate of the nodal chart ring is nonzero when `h` is. -/
public theorem nodalGen_one_ne_zero {h : R} (hh : h ≠ 0) : nodalGen R h 1 ≠ 0 := by
  intro hz
  have h0 : nodalGen R h 0 * nodalGen R h 1 = algebraMap R (nodalChartRing R h) h :=
    nodalGen_zero_mul_nodalGen_one h
  rw [hz, mul_zero] at h0
  exact algebraMap_nodalChartRing_ne_zero h hh h0.symm

end Nondegenerate

end Stacks

end
