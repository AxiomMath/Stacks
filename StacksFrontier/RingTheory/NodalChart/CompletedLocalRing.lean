module

public import StacksFrontier.RingTheory.AdicCompletion.MaximalIdealLocalization
public import StacksFrontier.RingTheory.MvPowerSeries.MixedCompletion
public import StacksFrontier.RingTheory.NodalChart.Basic

/-!
# The completed local ring of a nodal chart at its origin

Let `R` be a Noetherian local ring with maximal ideal `𝔪`, let `h` be an element of `R` and let
`C = R[x, y]/(xy - h)` be the nodal chart ring. The ideal

`𝔮 = 𝔪 · C + (x, y)`

is the ideal of the origin of the chart over the closed point of `Spec R`, and this file computes
the `𝔮`-adic completion of `C`:

`Stacks.NodalChart.chartAdicCompletionAlgEquiv :`
`  AdicCompletion 𝔮 C ≃ₐ[R] A⟦x, y⟧ ⧸ (xy - h)`,

where `A` is the completion of `R` and `h` is read in `A` through the completion map. This is the
local model side of the étale local structure of a nodal family: Tag 0CBX presents the completed
local ring of an at-worst-nodal family at a split node as `A⟦x, y⟧/(xy - h)` for some
`h ∈ 𝔪_A`, and the identification proved here says that a nodal chart with parameter `h` has
exactly that completed local ring at its origin — so the two can be compared.

## Main definitions

* `Stacks.NodalChart.chartOrigin` — the ideal `I · C + (x, y)` of the origin of the chart over a
  point `I` of `Spec R`; for `I = 𝔪` this is the origin over the closed point.
* `Stacks.NodalChart.nodalSeriesIdeal` — the ideal `(xy - h)` of `A⟦x, y⟧`.

## Main results

* `Stacks.NodalChart.chartOrigin_eq` — the origin ideal is `I · C + (x, y)`, written through
  `Stacks.nodalGen`.
* `Stacks.NodalChart.chartOrigin_isPrime`, `Stacks.NodalChart.chartOrigin_isMaximal` — the origin
  over a prime, resp. a maximal, ideal of the base containing the parameter is prime, resp.
  maximal.
* `Stacks.NodalChart.toSeries_nodalEquation` — the comparison map of
  `StacksFrontier.RingTheory.MvPowerSeries.MixedCompletion` carries the nodal equation `xy - h` of
  `R[x, y]` to the nodal equation `xy - h` of `A⟦x, y⟧`.
* `Stacks.NodalChart.chartAdicCompletionAlgEquiv` — **the completed local ring of the nodal chart
  at its origin is `A⟦x, y⟧/(xy - h)`.**

## Implementation notes

The proof has two steps and no computation of its own. Completion commutes with a quotient over a
Noetherian ring (`adicCompletionQuotientAlgEquiv`), so the completion of `C = R[x, y]/(xy - h)` at
the image of the mixed maximal ideal `𝔫` of `R[x, y]` is the completion of `R[x, y]` at `𝔫`
modulo the ideal generated by `xy - h`; and that completion is `A⟦x, y⟧`
(`Stacks.MixedCompletion.polynomialAdicCompletionAlgEquiv`), under which `xy - h` goes to
`xy - h`.

The first step is an isomorphism of algebras over `R[x, y]`, and is restricted to `R` to be
composed with the second; this is why the statement is over `R` rather than over `A`. The
`A`-algebra structure of the right-hand side is the one of
`StacksFrontier/AlgebraicGeometry/Curves/NodalFamilyCompletedLocalRing.lean`, and the two agree on
`R` because both are induced by the completion map.
-/

@[expose] public noncomputable section

open IsLocalRing Stacks.MixedCompletion

universe u

namespace Stacks.NodalChart

section Origin

variable {R : Type u} [CommRing R]

/-- The ideal of the origin of the nodal chart `R[x, y]/(xy - h)` over the point `I` of `Spec R`:
the image of the mixed ideal `I · R[x, y] + (x, y)` of the polynomial ring. For `I` the maximal
ideal of a local ring this is the origin of the chart over the closed point. -/
public def chartOrigin (I : Ideal R) (h : R) : Ideal (nodalChartRing R h) :=
  Ideal.map (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) (polyMixed I 2)

/-- **The ideal of the origin, in terms of the chart's own generators**: it is generated by the
ideal of the point of the base together with the two coordinates. -/
public theorem chartOrigin_eq (I : Ideal R) (h : R) :
    chartOrigin I h =
      I.map (algebraMap R (nodalChartRing R h)) ⊔
        Ideal.span (Set.range (nodalGen R h)) := by
  rw [chartOrigin, polyMixed, Ideal.map_sup, Ideal.map_map, Ideal.map_span]
  have hC : (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)).comp
      (MvPolynomial.C : R →+* MvPolynomial (Fin 2) R) =
      algebraMap R (nodalChartRing R h) :=
    RingHom.ext fun r => (algebraMap_nodalChartRing_eq h r).symm
  have hX : (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) ''
      Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) R) =
      Set.range (nodalGen R h) := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i => (nodalGen_eq h i).symm)
  rw [hC, hX]

/-- The kernel `(xy - h)` of the chart's presentation lies in the mixed ideal of any ideal of the
base containing the parameter. -/
public theorem span_nodalEquation_le_polyMixed {I : Ideal R} {h : R} (hh : h ∈ I) :
    Ideal.span ({nodalEquation R h} : Set (MvPolynomial (Fin 2) R)) ≤ polyMixed I 2 := by
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, nodalEquation_def]
  exact Ideal.sub_mem _
    (span_X_le_polyMixed I 2 (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨0, rfl⟩)))
    (map_C_le_polyMixed I 2 (Ideal.mem_map_of_mem _ hh))

/-- The kernel of the chart's presentation lies in the mixed ideal of any ideal containing the
parameter. -/
private theorem ker_algebraMap_nodalChartRing_le {I : Ideal R} {h : R} (hh : h ∈ I) :
    RingHom.ker (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) ≤ polyMixed I 2 := by
  rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker]
  exact span_nodalEquation_le_polyMixed hh

/-- **The ideal of the origin pulls back to the mixed ideal.** The quotient map of the chart is
surjective and its kernel `(xy - h)` is contained in the mixed ideal as soon as the parameter
lies in the ideal of the point, so the two ideals correspond. -/
public theorem comap_chartOrigin {I : Ideal R} {h : R} (hh : h ∈ I) :
    (chartOrigin I h).comap
        (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h)) = polyMixed I 2 := by
  rw [chartOrigin, Ideal.Quotient.algebraMap_eq,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker,
    sup_eq_left.2 (span_nodalEquation_le_polyMixed hh)]

/-- **The origin of a nodal chart over a prime of the base is a prime ideal**: the quotient is
the residue ring of the base at that prime. -/
public theorem chartOrigin_isPrime {I : Ideal R} [I.IsPrime] {h : R} (hh : h ∈ I) :
    (chartOrigin I h).IsPrime := by
  have : (polyMixed I 2).IsPrime := polyMixed_isPrime I 2
  rw [chartOrigin]
  exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (ker_algebraMap_nodalChartRing_le hh)

/-- **The origin of a nodal chart over a closed point of the base, with parameter in the ideal of
that point, is a closed point**: the ideal `I · C + (x, y)` is maximal, with residue field the
residue field of the base at `I`. -/
public theorem chartOrigin_isMaximal {I : Ideal R} [I.IsMaximal] {h : R} (hh : h ∈ I) :
    (chartOrigin I h).IsMaximal := by
  have hmax : (polyMixed I 2).IsMaximal := polyMixed_isMaximal I 2
  rw [chartOrigin]
  exact Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective
    (ker_algebraMap_nodalChartRing_le hh)

end Origin

variable (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (h : R)

/-- The ideal `(xy - h)` of the power series ring over the completion of `R`. -/
public def nodalSeriesIdeal :
    Ideal (MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal R) R)) :=
  Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
    MvPowerSeries.C (algebraMap R (AdicCompletion (maximalIdeal R) R) h)}

omit [IsNoetherianRing R] in
/-- The comparison map of `Stacks.MixedCompletion` carries the nodal equation of `R[x, y]` to the
nodal equation of `A⟦x, y⟧`. -/
public theorem toSeries_nodalEquation :
    toSeries R 2 (nodalEquation R h) =
      MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C (algebraMap R (AdicCompletion (maximalIdeal R) R) h) := by
  have hC : toSeries R 2 (MvPolynomial.C h) =
      MvPowerSeries.C (algebraMap R (AdicCompletion (maximalIdeal R) R) h) := by
    rw [toSeries_apply, MvPolynomial.map_C, MvPolynomial.coe_C]
  rw [nodalEquation_def, map_sub, map_mul, toSeries_X, toSeries_X, hC]

/-- The ideal `(xy - h)` of `A⟦x, y⟧` is the image of the ideal `(xy - h)` of `R[x, y]` under the
completion isomorphism of the polynomial ring. -/
public theorem nodalSeriesIdeal_eq_map :
    nodalSeriesIdeal R h =
      Ideal.map (polynomialAdicCompletionAlgEquiv R 2 :
          AdicCompletion (polyMixed (maximalIdeal R) 2) (MvPolynomial (Fin 2) R) →+*
            MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal R) R))
        (Ideal.map (algebraMap (MvPolynomial (Fin 2) R)
            (AdicCompletion (polyMixed (maximalIdeal R) 2) (MvPolynomial (Fin 2) R)))
          (Ideal.span {nodalEquation R h})) := by
  have hg : polynomialAdicCompletionAlgEquiv R 2
        (algebraMap (MvPolynomial (Fin 2) R)
          (AdicCompletion (polyMixed (maximalIdeal R) 2) (MvPolynomial (Fin 2) R))
          (nodalEquation R h)) =
      MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C (algebraMap R (AdicCompletion (maximalIdeal R) R) h) := by
    rw [polynomialAdicCompletionAlgEquiv_of, toSeries_nodalEquation]
  rw [Ideal.map_map, Ideal.map_span, Set.image_singleton, nodalSeriesIdeal]
  simp only [RingHom.coe_comp, Function.comp_apply]
  exact congrArg (fun z => Ideal.span {z}) hg.symm

/-- **The completed local ring of a nodal chart at its origin.** For a Noetherian local ring `R`
with completion `A` and a parameter `h ∈ R`, the completion of `R[x, y]/(xy - h)` at the ideal
`𝔪 · C + (x, y)` of the origin is `A⟦x, y⟧/(xy - h)`. -/
public def chartAdicCompletionAlgEquiv :
    AdicCompletion (chartOrigin (maximalIdeal R) h) (nodalChartRing R h) ≃ₐ[R]
      (MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal R) R) ⧸ nodalSeriesIdeal R h) :=
  (AlgEquiv.restrictScalars R
      (adicCompletionQuotientAlgEquiv (polyMixed (maximalIdeal R) 2)
        (Ideal.span {nodalEquation R h})).symm).trans
    (Ideal.quotientEquivAlg _ _ (polynomialAdicCompletionAlgEquiv R 2)
      (nodalSeriesIdeal_eq_map R h))

/-! ### The completed local ring at the origin -/

/-- **The completed local ring of a nodal chart at its origin is `A⟦x, y⟧/(xy - h)`.** This is
the previous identification read on the local ring of the chart at the origin rather than on the
chart itself, through the comparison of a completion at a maximal ideal with the completion of
the local ring there.

The isomorphism is compatible with the two maps from `R`: the one that makes the completed local
ring of the chart an `R`-algebra, and the one that makes `A⟦x, y⟧/(xy - h)` one. -/
public theorem exists_ringEquiv_adicCompletion_localization_chartOrigin
    (hh : h ∈ maximalIdeal R) :
    letI := chartOrigin_isMaximal (I := maximalIdeal R) hh
    ∃ E : AdicCompletion (maximalIdeal (Localization.AtPrime (chartOrigin (maximalIdeal R) h)))
          (Localization.AtPrime (chartOrigin (maximalIdeal R) h)) ≃+*
        (MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal R) R) ⧸ nodalSeriesIdeal R h),
      ∀ r : R, E (algebraMap (Localization.AtPrime (chartOrigin (maximalIdeal R) h)) _
          (algebraMap (nodalChartRing R h) (Localization.AtPrime (chartOrigin (maximalIdeal R) h))
            (algebraMap R (nodalChartRing R h) r))) =
        algebraMap R
          (MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal R) R) ⧸ nodalSeriesIdeal R h) r := by
  let := chartOrigin_isMaximal (I := maximalIdeal R) hh
  obtain ⟨E₀, hE₀⟩ :=
    Stacks.MaximalLocalization.exists_adicCompletionAlgEquiv_localizationAtPrime
      (chartOrigin (maximalIdeal R) h)
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  refine ⟨E₀.symm.toRingEquiv.trans (chartAdicCompletionAlgEquiv R h).toRingEquiv, fun r => ?_⟩
  change chartAdicCompletionAlgEquiv R h
      (E₀.symm (algebraMap (Localization.AtPrime (chartOrigin (maximalIdeal R) h)) _
        (algebraMap (nodalChartRing R h) (Localization.AtPrime (chartOrigin (maximalIdeal R) h))
          (algebraMap R (nodalChartRing R h) r)))) = _
  rw [← hE₀ (algebraMap R (nodalChartRing R h) r), E₀.symm_apply_apply,
    ← IsScalarTower.algebraMap_apply R (nodalChartRing R h)
      (AdicCompletion (chartOrigin (maximalIdeal R) h) (nodalChartRing R h)) r]
  exact (chartAdicCompletionAlgEquiv R h).commutes r

end Stacks.NodalChart

end
