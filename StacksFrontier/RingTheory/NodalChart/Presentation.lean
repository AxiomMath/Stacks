module

public import StacksFrontier.RingTheory.NodalChart.Basic
public import StacksFrontier.RingTheory.KrullDimension.FiniteTypeOverField
public import StacksFrontier.RingTheory.Syntomic.RelativeGlobalCompleteIntersection
public import Mathlib.RingTheory.KrullDimension.Polynomial

/-!
# The nodal chart ring is a relative global complete intersection

The nodal chart ring `R[x, y]/(xy - h)` comes with an evident presentation over `R`: two
variables and the single relation `xy - h`. This file records that presentation, computes the
fibres of the resulting family, and concludes that `R → R[x, y]/(xy - h)` is a relative global
complete intersection, hence syntomic, for *every* commutative ring `R` and every `h : R`.

The fibre over a prime `p ⊆ R` is the base change of `R[x, y]/(xy - h)` along `R → κ(p)`, which
is again a nodal chart ring, namely `κ(p)[x, y]/(xy - h)` for the image of `h` in `κ(p)`. Over a
field `k` the ring `k[x, y]/(xy - c)` has dimension one: `k[x, y]` has dimension two, the nodal
equation is a nonzerodivisor, and it lies in a maximal ideal of maximal height, so cutting it
down drops the dimension by exactly one. Thus every fibre has dimension `2 - 1 = 1`, which is
the dimension condition of Definition 00SP for this presentation.

## Main definitions

* `Stacks.nodalPresentation` — the presentation of `R[x, y]/(xy - h)` over `R` with variables
  `Fin 2` and the single relation `xy - h`.
* `Stacks.nodalChartRingBaseChangeEquiv` — the base change `B ⊗[R] R[x, y]/(xy - h)` is the nodal
  chart ring `B[x, y]/(xy - h_B)` of the image of `h` in `B`.

## Main results

* `Stacks.ringKrullDim_nodalChartRing_add_one` — over a field, `dim k[x, y]/(xy - c) + 1 = 2`.
* `Stacks.nodalPresentation_isRelativeGlobalCompleteIntersection` — the presentation is a
  relative global complete intersection.
* `Stacks.isRelativeGlobalCompleteIntersection_nodalChartRing`,
  `Stacks.syntomic_nodalChartRing` — the ring map `R → R[x, y]/(xy - h)` is a relative global
  complete intersection, and therefore syntomic.

## Implementation notes

The presentation is built from `Algebra.Generators.naive`, which presents a quotient
`R[x_i]/I` by the variables themselves; since `Stacks.nodalChartRing` is *by definition* such a
quotient, no transport along an isomorphism is needed, and `Algebra.Generators.ker_naive`
identifies the kernel with the ideal. The relation map is the constant family on `Fin 1`, so
`Set.range_const` turns the span of its range into the span of the singleton.

The base change isomorphism is not built by hand from tensor products: it is
`Algebra.Presentation.baseChange` of the nodal presentation, whose relation is the image of the
nodal equation under `MvPolynomial.map`, hence again a nodal equation. Its
`Algebra.Presentation.quotientEquiv` identifies `B ⊗[R] R[x, y]/(xy - h)` with the quotient of
`B[x, y]` by the kernel, and `Ideal.quotEquivOfEq` rewrites that kernel as the ideal generated by
the new nodal equation. Only the underlying ring isomorphism is needed downstream, so it is
stated as a `RingEquiv`.

The dimension count over a field uses `MvPolynomial.ringKrullDim_of_isNoetherianRing` for
`dim k[x, y] = 2`, `Module.ringKrullDim_quotient_add_one_of_mem_nonZeroDivisors` to cut down by
the nodal equation, and tag 00OS
(`Algebra.FiniteType.ringKrullDim_eq_height_of_isMaximal_and_length_eq_ringKrullDim`) to see that
the chosen maximal ideal — the kernel of the evaluation at `(1, c)`, which contains `xy - c` —
has height `dim k[x, y]`.

## References

* [Stacks 00SP](https://stacks.math.columbia.edu/tag/00SP), Definition 10.136.5
* [Stacks 00SW](https://stacks.math.columbia.edu/tag/00SW), Lemma 10.136.13
* [Stacks 00OS](https://stacks.math.columbia.edu/tag/00OS), Lemma 10.116.1
-/

@[expose] public noncomputable section

open MvPolynomial

open scoped TensorProduct

universe u

namespace Stacks

variable {R : Type u} [CommRing R]

/-- The presentation of the nodal chart ring `R[x, y]/(xy - h)` over `R`: two variables, indexed
by `Fin 2`, and the single relation `xy - h`, indexed by `Fin 1`. -/
public noncomputable def nodalPresentation (R : Type u) [CommRing R] (h : R) :
    Algebra.Presentation R (nodalChartRing R h) (Fin 2) (Fin 1) where
  __ := Algebra.Generators.naive
    (I := Ideal.span ({nodalEquation R h} : Set (MvPolynomial (Fin 2) R)))
  relation _ := nodalEquation R h
  span_range_relation_eq_ker := by
    rw [Set.range_const]
    exact (Algebra.Generators.ker_naive _ _).symm

/-- The single relation of `Stacks.nodalPresentation` is the nodal equation. -/
@[simp] public theorem nodalPresentation_relation (h : R) (j : Fin 1) :
    (nodalPresentation R h).relation j = nodalEquation R h := rfl

/-- The two generators of `Stacks.nodalPresentation` are the two coordinates of the nodal chart
ring. -/
@[simp] public theorem nodalPresentation_val (h : R) (i : Fin 2) :
    (nodalPresentation R h).val i = nodalGen R h i := rfl

section BaseChange

variable (R) in
/-- The kernel of the base changed nodal presentation is generated by the base changed nodal
equation. -/
public theorem ker_baseChange_nodalPresentation (B : Type u) [CommRing B] [Algebra R B] (h : R) :
    ((nodalPresentation R h).baseChange B).ker =
      Ideal.span ({nodalEquation B (algebraMap R B h)} : Set (MvPolynomial (Fin 2) B)) := by
  rw [← ((nodalPresentation R h).baseChange B).span_range_relation_eq_ker]
  congr 1
  rw [show ((nodalPresentation R h).baseChange B).relation =
    fun _ : Fin 1 ↦ nodalEquation B (algebraMap R B h) from
      funext fun j ↦ by
        rw [Algebra.Presentation.baseChange_relation, nodalPresentation_relation,
          map_nodalEquation], Set.range_const]

/-- **The nodal chart ring is stable under base change.** For an `R`-algebra `B` the base change
`B ⊗[R] R[x, y]/(xy - h)` is the nodal chart ring `B[x, y]/(xy - h_B)` of the image `h_B` of `h`
in `B`. -/
public noncomputable def nodalChartRingBaseChangeEquiv (R : Type u) [CommRing R] (B : Type u)
    [CommRing B] [Algebra R B] (h : R) :
    B ⊗[R] nodalChartRing R h ≃+* nodalChartRing B (algebraMap R B h) :=
  ((nodalPresentation R h).baseChange B).quotientEquiv.symm.toRingEquiv.trans
    (Ideal.quotEquivOfEq (ker_baseChange_nodalPresentation R B h))

end BaseChange

section Field

/-- The nodal equation over a nontrivial commutative ring is nonzero: evaluating both variables
at `X` turns it into `X ^ 2 - C c`, which has degree two. -/
public theorem nodalEquation_ne_zero (k : Type u) [CommRing k] [Nontrivial k] (c : k) :
    nodalEquation k c ≠ 0 := by
  intro hz
  have hev := congrArg
    (MvPolynomial.aeval (fun _ : Fin 2 ↦ (Polynomial.X : Polynomial k))) hz
  rw [nodalEquation_def, map_zero] at hev
  simp only [map_sub, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
    Polynomial.algebraMap_eq] at hev
  rw [← pow_two] at hev
  exact Polynomial.X_pow_sub_C_ne_zero (by norm_num) c hev

/-- **The nodal chart ring over a field has dimension one**, written additively as
`dim k[x, y]/(xy - c) + 1 = 2`, the form in which the complete intersection condition of
Definition 00SP uses it. -/
public theorem ringKrullDim_nodalChartRing_add_one (k : Type u) [Field k] (c : k) :
    ringKrullDim (nodalChartRing k c) + ((1 : ℕ) : WithBot ℕ∞) = ((2 : ℕ) : WithBot ℕ∞) := by
  have hdim : ringKrullDim (MvPolynomial (Fin 2) k) = ((2 : ℕ) : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
    simp
  set f : MvPolynomial (Fin 2) k →ₐ[k] k :=
    MvPolynomial.aeval (fun i : Fin 2 ↦ if i = 0 then (1 : k) else c) with hf
  have hsurj : Function.Surjective f.toRingHom := fun x ↦ ⟨MvPolynomial.C x, by simp [hf]⟩
  have hmax : (RingHom.ker f.toRingHom).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective f.toRingHom hsurj
  have : (RingHom.ker f.toRingHom).IsPrime := hmax.isPrime
  have hmem : nodalEquation k c ∈ RingHom.ker f.toRingHom := by
    simp [RingHom.mem_ker, hf, nodalEquation_def]
  have hheight : (RingHom.ker f.toRingHom).height = ringKrullDim (MvPolynomial (Fin 2) k) :=
    ((Algebra.FiniteType.ringKrullDim_eq_height_of_isMaximal_and_length_eq_ringKrullDim k
      (MvPolynomial (Fin 2) k)).1 _).symm
  have key := Module.ringKrullDim_quotient_add_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero (nodalEquation_ne_zero k c)) hheight hmem
  rw [hdim] at key
  simpa using key

end Field

/-- **The nodal presentation is a relative global complete intersection.** Every nonempty fibre
of `Spec R[x, y]/(xy - h) → Spec R` is a nodal chart ring over the residue field, of dimension
`2 - 1 = 1`. -/
public theorem nodalPresentation_isRelativeGlobalCompleteIntersection (h : R) :
    (nodalPresentation R h).IsRelativeGlobalCompleteIntersection where
  ringKrullDim_fiber_add_card_eq_card p _ _ := by
    have hdim := ringKrullDim_nodalChartRing_add_one p.ResidueField (algebraMap R p.ResidueField h)
    rw [← ringKrullDim_eq_of_ringEquiv (nodalChartRingBaseChangeEquiv R p.ResidueField h)] at hdim
    simpa using hdim

/-- **`R → R[x, y]/(xy - h)` is a relative global complete intersection** for every commutative
ring `R` and every `h : R`. -/
public theorem isRelativeGlobalCompleteIntersection_nodalChartRing (h : R) :
    Algebra.IsRelativeGlobalCompleteIntersection R (nodalChartRing R h) :=
  have := nodalPresentation_isRelativeGlobalCompleteIntersection h
  Algebra.IsRelativeGlobalCompleteIntersection.of_presentation (nodalPresentation R h)

/-- **`R → R[x, y]/(xy - h)` is syntomic** for every commutative ring `R` and every `h : R`: it
is flat, of finite presentation, and its fibres are local complete intersections. -/
public theorem syntomic_nodalChartRing (h : R) : Algebra.Syntomic R (nodalChartRing R h) :=
  have := isRelativeGlobalCompleteIntersection_nodalChartRing h
  Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection R (nodalChartRing R h)

end Stacks

end
