module

public import StacksFrontier.AlgebraicGeometry.Curves.FittingIdealJacobianMinors
public import StacksFrontier.AlgebraicGeometry.Curves.JacobianCriterionPlane
public import StacksFrontier.RingTheory.NodalChart.Presentation

/-!
# Differentials of the standard nodal chart ring

The nodal chart ring `R[x, y]/(xy - h)` is presented over `R` by two generators and the single
relation `xy - h`, whose Jacobian matrix is the `2 × 1` matrix with entries `y` and `x`. The
first Fitting ideal of the module of relative differentials is therefore the ideal generated by
the two coordinates, and that ideal cuts out the singular locus of the nodal family: killing both
coordinates leaves `R/(h)`, the locus where the parameter vanishes.

Both statements are made for an arbitrary `R`-algebra presented by the nodal chart ring, that is,
for an `R`-algebra `A` together with an isomorphism `R[x, y]/(xy - h) ≃ₐ[R] A`, the two
coordinates being read in `A` through that isomorphism. Taking the identity recovers the chart
ring itself; the extra generality is what lets the statements be applied to the ring of global
sections of `Spec R[x, y]/(xy - h)`, which is isomorphic to the chart ring but not equal to it.

## Main results

* `Stacks.fittingIdeal_kaehlerDifferential_nodalChartRing` — the first Fitting ideal of
  `Ω_{A ⁄ R}` is the ideal `(x, y)`.
* `Stacks.surjective_quotient_span_nodalGen` — killing the two coordinates leaves a quotient of
  the base: `R → A/(x, y)` is surjective.

## Implementation notes

The presentation of the ring used for the computation is `Stacks.nodalPresentation` transported
along the given isomorphism by `Algebra.Presentation.ofAlgEquiv`, whose generators are the images
of the two coordinates and whose single relation is still the nodal equation.

The Fitting ideal computation is
`Stacks.Curves.fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian` at `r = 1`, where the
relevant minors are the `1 × 1` ones, i.e. the entries of the Jacobian matrix
(`Stacks.Curves.minorIdeal_one`). The finite presentation that makes the Fitting ideal of the
module of differentials meaningful is carried in the statement, as it is in that lemma; it is
read off the transported presentation.

Surjectivity onto the quotient by the two coordinates is proved by induction on a polynomial
representative: a monomial involving either variable dies, so only the constant term survives.

## References

* [Stacks Project, Tag 0C59](https://stacks.math.columbia.edu/tag/0C59)
* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks

variable {R : Type u} [CommRing R] {A : Type u} [CommRing A] [Algebra R A]

/-- The image of either coordinate lies in the ideal the two of them generate. -/
private theorem nodalGen_mem_span (h : R) (e : nodalChartRing R h ≃ₐ[R] A) (i : Fin 2) :
    e (nodalGen R h i) ∈ Ideal.span {e (nodalGen R h 0), e (nodalGen R h 1)} := by
  fin_cases i <;> exact Ideal.subset_span (by simp)

/-- **The first Fitting ideal of the differentials of the nodal chart ring is `(x, y)`.** The
Jacobian matrix of the single relation `xy - h` has entries `y` and `x`, and its `1 × 1` minors
generate the ideal of the two coordinates. -/
public theorem fittingIdeal_kaehlerDifferential_nodalChartRing (h : R)
    (e : nodalChartRing R h ≃ₐ[R] A) :
    haveI : Algebra.FinitePresentation R A :=
      ((nodalPresentation R h).ofAlgEquiv e).finitePresentation_of_isFinite
    fittingIdeal (R := A) (M := Ω[A⁄R]) (1 : ℤ) =
      Ideal.span {e (nodalGen R h 0), e (nodalGen R h 1)} := by
  have : Algebra.FinitePresentation R A :=
    ((nodalPresentation R h).ofAlgEquiv e).finitePresentation_of_isFinite
  have hfit := Stacks.Curves.fittingIdeal_kaehlerDifferential_eq_minorIdeal_jacobian
    ((nodalPresentation R h).ofAlgEquiv e) 1
  simp only [Nat.cast_one] at hfit
  rw [hfit]
  have hval : ∀ i : Fin 2, ((nodalPresentation R h).ofAlgEquiv e).val i = e (nodalGen R h i) :=
    fun _ => rfl
  have hrel : ∀ j : Fin 1, ((nodalPresentation R h).ofAlgEquiv e).relation j =
      nodalEquation R h := fun _ => rfl
  have hd : ∀ i : Fin 2, aeval ((nodalPresentation R h).ofAlgEquiv e).val
      (pderiv i (((nodalPresentation R h).ofAlgEquiv e).relation 0)) =
        e (nodalGen R h i.rev) := by
    intro i
    rw [hrel]
    fin_cases i <;> simp [nodalEquation_def]
  rw [show (2 : ℕ) - 1 = 1 from rfl, Stacks.Curves.minorIdeal_one]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x ⟨i, j, rfl⟩
    obtain rfl : j = 0 := Subsingleton.elim _ _
    rw [Matrix.of_apply, hd]
    exact nodalGen_mem_span h e _
  · rw [Ideal.span_le]
    rintro x (rfl | rfl)
    · exact Ideal.subset_span ⟨1, 0, (hd 1).symm⟩
    · exact Ideal.subset_span ⟨0, 0, (hd 0).symm⟩

/-- **Killing the two coordinates of the nodal chart ring leaves a quotient of the base.** The
composite `R → A → A/(x, y)` is surjective; the target is `R/(h)`. -/
public theorem surjective_quotient_span_nodalGen (h : R) (e : nodalChartRing R h ≃ₐ[R] A) :
    Function.Surjective
      ((Ideal.Quotient.mk (Ideal.span {e (nodalGen R h 0), e (nodalGen R h 1)})).comp
        (algebraMap R A)) := by
  set q := Ideal.Quotient.mk (Ideal.span {e (nodalGen R h 0), e (nodalGen R h 1)})
  have key : ∀ p : MvPolynomial (Fin 2) R, ∃ a : R,
      q (algebraMap R A a) =
        q (e (algebraMap (MvPolynomial (Fin 2) R) (nodalChartRing R h) p)) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => exact ⟨a, by rw [← algebraMap_nodalChartRing_eq, AlgEquiv.commutes]⟩
    | add p p' hp hp' =>
      obtain ⟨a, ha⟩ := hp
      obtain ⟨a', ha'⟩ := hp'
      exact ⟨a + a', by rw [map_add, map_add, map_add, map_add, map_add, ha, ha']⟩
    | mul_X p i hp =>
      refine ⟨0, ?_⟩
      rw [map_zero, map_zero, map_mul, ← nodalGen_eq, map_mul, map_mul,
        Ideal.Quotient.eq_zero_iff_mem.2 (nodalGen_mem_span h e i), mul_zero]
  intro z
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨v, rfl⟩ := e.surjective w
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective v
  obtain ⟨a, ha⟩ := key p
  exact ⟨a, ha⟩

end Stacks

end
