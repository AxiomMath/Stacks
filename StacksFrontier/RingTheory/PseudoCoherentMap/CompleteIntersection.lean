@[expose] public section

/-!
# Local complete intersection ring maps are perfect

A local complete intersection homomorphism of commutative rings is a perfect ring map.

## Main results

* `RingHom.IsLocalCompleteIntersection.isPerfectRingMap` (Stacks 07EN).

## Implementation notes

The algebra structures on both sides are the ones the ring map itself induces, and the derived
tensor product, its comparison to termwise tensoring and the universal property are passed through
in the shape `RingHom.IsPerfectRingMap` takes them, so no particular derived tensor product is
constructed.

By Stacks 068Y it suffices to exhibit one finite polynomial presentation
`A[x_1, …, x_n] → B` for which `B` is a perfect module over the polynomial algebra. A local
complete intersection supplies a presentation whose kernel `I` is a Koszul-regular ideal, and
`B ≅ A[x_1, …, x_n]/I`, so what has to be shown is that the quotient by a Koszul-regular ideal is
a perfect module.

That is local on the base. Koszul-regularity of `I` gives, at every prime containing `I`, a
principal localization on which `I` becomes the ideal generated by a Koszul-regular sequence
`f_1, …, f_r`; at a prime not containing `I` the localization can be taken to kill `I`, so the
quotient is zero and trivially perfect. The resulting elements cover the spectrum, hence generate
the unit ideal, and Stacks 066Y descends perfectness from the localizations.

Over a localization where `I = (f_1, …, f_r)` with the sequence Koszul-regular, the Koszul complex
of the sequence *is* a finite resolution of the quotient: its augmentation to the quotient is the
degree-zero exterior power followed by the quotient map, it is a quasi-isomorphism exactly because
the higher Koszul homology vanishes, and its terms `⋀^i (R^r)` are finite free and vanish for
`i > r`. Stacks 066Q turns that resolution into perfectness of the module.

## References

* [The Stacks Project, Lemma 15.83.7 (07EN)](https://stacks.math.columbia.edu/tag/07EN)
-/

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

namespace RingHom

universe u v

attribute [local instance] HasDerivedCategory.standard

/-! ### The Koszul complex resolves the quotient by a Koszul-regular sequence -/

/-- The augmentation of the Koszul complex of `f_1, …, f_r` onto `R/(f_1, …, f_r)`: the
identification of the degree-zero exterior power with `R`, followed by the quotient map. -/
private noncomputable def koszulAugmentation {R : Type u} [CommRing R]
    {r : ℕ} (f : Fin r → R) :
    (Koszul.seqComplex f).X 0 ⟶
      ModuleCat.of R (R ⧸ Ideal.span (Set.range f)) :=
  ModuleCat.ofHom <| (Ideal.Quotient.mkₐ R (Ideal.span (Set.range f))).toLinearMap.comp
    (exteriorPower.zeroEquiv R (Fin r → R)).toLinearMap

/-- The augmentation kills the image of the first Koszul differential, since that image is
exactly the span of `f_1, …, f_r`. -/
private theorem koszulAugmentation_d {R : Type u} [CommRing R]
    {r : ℕ} (f : Fin r → R) :
    (Koszul.seqComplex f).d 1 0 ≫ koszulAugmentation f = 0 := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change ⋀[R]^1 (Fin r → R) at x
  change Ideal.Quotient.mk _
    (exteriorPower.zeroEquiv R (Fin r → R) (Koszul.d (Koszul.seqDual f) 0 x)) = 0
  rw [Koszul.zeroEquiv_d_zero]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  change Koszul.seqDual f _ ∈ Submodule.span R (Set.range f)
  rw [← Fintype.range_linearCombination]
  exact LinearMap.mem_range_self _ _

/-- For a Koszul-regular sequence the Koszul complex, with the augmentation above, is a
resolution of `R/(f_1, …, f_r)`. -/
@[sga "6 III 1.1.2" "(f), special case", sga "6 VIII 1.4" "(f), special case"]
private noncomputable def koszulResolution {R : Type u} [CommRing R]
    {r : ℕ} (f : Fin r → R) (hf : Koszul.IsKoszulRegular f) :
    ModuleResolution R (R ⧸ Ideal.span (Set.range f)) where
  complex := Koszul.seqComplex f
  hasHomology := fun _ => inferInstance
  π := ((Koszul.seqComplex f).toSingle₀Equiv _).symm
    ⟨koszulAugmentation f, koszulAugmentation_d f⟩
  quasiIso := by
    constructor
    intro n
    cases n with
    | zero =>
      rw [ChainComplex.quasiIsoAt₀_iff,
        ShortComplex.quasiIso_iff_of_zeros' _ (by simp) (by simp; rfl) (by simp; rfl)]
      constructor
      · rw [ShortComplex.moduleCat_exact_iff]
        intro x hx
        change Ideal.Quotient.mk _
          (exteriorPower.zeroEquiv R (Fin r → R) x) = 0 at hx
        have hx' : exteriorPower.zeroEquiv R (Fin r → R) x ∈
            Ideal.span (Set.range f) := Ideal.Quotient.eq_zero_iff_mem.mp hx
        change exteriorPower.zeroEquiv R (Fin r → R) x ∈
          Submodule.span R (Set.range f) at hx'
        rw [← Fintype.range_linearCombination] at hx'
        obtain ⟨y, hy⟩ := hx'
        change ∃ y : ↥(⋀[R]^1 (Fin r → R)), Koszul.d (Koszul.seqDual f) 0 y = x
        refine ⟨(exteriorPower.oneEquiv R (Fin r → R)).symm y, ?_⟩
        apply (exteriorPower.zeroEquiv R (Fin r → R)).injective
        rwa [Koszul.zeroEquiv_d_zero, LinearEquiv.apply_symm_apply]
      · rw [ModuleCat.epi_iff_surjective]
        intro x
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact ⟨(exteriorPower.zeroEquiv R (Fin r → R)).symm a, by
          change Ideal.Quotient.mk _
            ((exteriorPower.zeroEquiv R (Fin r → R))
              ((exteriorPower.zeroEquiv R (Fin r → R)).symm a)) = _
          rw [LinearEquiv.apply_symm_apply]⟩
    | succ n =>
      exact (quasiIsoAt_iff_exactAt' _ (n + 1)
        (ChainComplex.exactAt_succ_single_obj _ n)).mpr
          ((HomologicalComplex.exactAt_iff_isZero_homology _ _).mpr (hf _ (by omega)))

/-- The quotient by the ideal generated by a Koszul-regular sequence is a perfect module: the
Koszul complex is a finite resolution by finite free modules. -/
@[sga "6 III 1.1.2" "special case"]
private theorem quotient_isPerfect_of_isKoszulRegular
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (hf : Koszul.IsKoszulRegular f) :
    StacksDraft.Perfect.IsPerfectModule (R := R) (R ⧸ Ideal.span (Set.range f)) := by
  refine (StacksDraft.Perfect.isPerfectModule_iff_exists_finite_projective_resolution _).mpr
    ⟨r, koszulResolution f hf, ?_, ?_⟩
  · intro i
    change Module.Finite R (⋀[R]^i (Fin r → R)) ∧
      Module.Projective R (⋀[R]^i (Fin r → R))
    exact ⟨inferInstance, inferInstance⟩
  · intro i hi
    apply ModuleCat.isZero_iff_subsingleton.mpr
    change Subsingleton (⋀[R]^i (Fin r → R))
    exact exteriorPower.subsingleton_of_span_eq_top_of_card_lt
      (Pi.basisFun R (Fin r)) (Pi.basisFun R (Fin r)).span_eq i
      (by simpa using hi)

/-! ### Perfectness is local on the base -/

/-- A zero object of the derived category is perfect. -/
private theorem isPerfect_of_isZero {R : Type u} [Ring R]
    {K : DerivedCategory (ModuleCat.{v} R)} (hK : IsZero K) :
    StacksDraft.Perfect.IsPerfect K := by
  let P : CochainComplex (ModuleCat.{v} R) ℤ := HomologicalComplex.zero
  have hP : IsZero P := HomologicalComplex.isZero_zero
  have hPX (i : ℤ) : IsZero (P.X i) :=
    (HomologicalComplex.eval _ _ i).map_isZero hP
  refine ⟨P, 0, 0, ?_, ?_, fun i => ?_, fun i => ?_, ⟨hK.iso (DerivedCategory.Q.map_isZero hP)⟩⟩
  · rw [CochainComplex.isStrictlyGE_iff]
    exact fun i _ => hPX i
  · rw [CochainComplex.isStrictlyLE_iff]
    exact fun i _ => hPX i
  all_goals
    have := ModuleCat.isZero_iff_subsingleton.mp (hPX i)
    infer_instance

/-- Derived localization away from `g` takes `(R/I)[0]` to `(R_g / I R_g)[0]`. -/
private noncomputable def localizationAwayQuotientIso
    {R : Type u} [CommRing R] (I : Ideal R) (g : R) :
    (StacksDraft.PseudoCoherence.localizationAwayFunctorAux.{u, u} g).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj (ModuleCat.of R (R ⧸ I))) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} (Localization.Away g)) 0).obj
        (ModuleCat.of (Localization.Away g)
          (Localization.Away g ⧸ I.map (algebraMap R (Localization.Away g)))) := by
  let F := ModuleCat.extendScalars.{u, u, u} (algebraMap R (Localization.Away g))
  let : F.Additive := extendScalars_additive.{u, u} _
  let : PreservesFiniteLimits F :=
    extendScalars_preservesFiniteLimits_of_flat'.{u, u} _
      (RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat (Localization.Away g) (Submonoid.powers g)))
  let : PreservesColimitsOfSize.{0, 0} F :=
    (ModuleCat.extendRestrictScalarsAdj.{u, u, u}
      (algebraMap R (Localization.Away g))).leftAdjoint_preservesColimits
  let : PreservesFiniteColimits F :=
    PreservesColimitsOfSize.preservesFiniteColimits F
  let e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot (Localization.Away g) I
  exact (F.mapDerivedCategorySingleFunctor 0).app (ModuleCat.of R (R ⧸ I)) ≪≫
    (DerivedCategory.singleFunctor (ModuleCat.{u} (Localization.Away g)) 0).mapIso
      (StacksDraft.PseudoCoherence.extendScalarsTensorIso (ModuleCat.of R (R ⧸ I)) ≪≫
        e.symm.toLinearEquiv.toModuleIso)

/-- A property holding at some element outside each prime holds at finitely many elements
generating the unit ideal. -/
private theorem exists_finite_span_eq_top_of_forall_prime
    {R : Type u} [CommRing R] (P : R → Prop)
    (hP : ∀ p : PrimeSpectrum R, ∃ g : R, g ∉ p.asIdeal ∧ P g) :
    ∃ s : Finset R, Ideal.span (s : Set R) = ⊤ ∧ ∀ g ∈ s, P g := by
  classical
  have hspan : Ideal.span {g | P g} = ⊤ := by
    by_contra h
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ h
    obtain ⟨g, hg, hPg⟩ := hP ⟨m, hm.isPrime⟩
    exact hg (hle (Ideal.subset_span hPg))
  obtain ⟨s, hs, htop⟩ := (Ideal.span_eq_top_iff_finite _).mp hspan
  exact ⟨s, htop, fun g hg => hs hg⟩

/-- The quotient by a Koszul-regular ideal is a perfect module. -/
private theorem quotient_isPerfect_of_isKoszulRegularIdeal
    {R : Type u} [CommRing R] (I : Ideal R) (hI : Ideal.IsKoszulRegular I) :
    StacksDraft.Perfect.IsPerfectModule (R := R) (R ⧸ I) := by
  classical
  let P := fun g : R => StacksDraft.Perfect.IsPerfectModule (R := Localization.Away g)
    (Localization.Away g ⧸ I.map (algebraMap R (Localization.Away g)))
  have hlocal : ∀ p : PrimeSpectrum R, ∃ g : R, g ∉ p.asIdeal ∧ P g := by
    intro p
    by_cases hp : I ≤ p.asIdeal
    · obtain ⟨g, hg, r, f, hf, hspan⟩ := hI p hp
      refine ⟨g, hg, ?_⟩
      dsimp only [P]
      rw [hspan]
      exact quotient_isPerfect_of_isKoszulRegular f hf
    · obtain ⟨g, hgI, hgp⟩ := IsConcreteLE.not_le_iff_exists.mp hp
      refine ⟨g, hgp, ?_⟩
      have htop : I.map (algebraMap R (Localization.Away g)) = ⊤ :=
        Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hgI)
          (IsLocalization.Away.algebraMap_isUnit g)
      dsimp only [P]
      rw [htop]
      apply isPerfect_of_isZero
      apply (DerivedCategory.singleFunctor (ModuleCat.{u} (Localization.Away g)) 0).map_isZero
      exact ModuleCat.isZero_iff_subsingleton.mpr inferInstance
  obtain ⟨s, hs, hsP⟩ := exists_finite_span_eq_top_of_forall_prime P hlocal
  apply StacksDraft.Perfect.isPerfect_of_localizationSpan.{u, u} (fun g : s => (g : R))
    (by simpa using hs)
  intro g
  exact StacksDraft.Perfect.isPerfect_of_iso (localizationAwayQuotientIso I g) (hsP g g.property)

/-! ### From a local complete intersection presentation to perfectness -/

/-- Perfectness of a module is invariant under linear equivalence. -/
private theorem isPerfectModule_of_linearEquiv
    {R : Type u} [Ring R] {M N : Type v}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) (hM : StacksDraft.Perfect.IsPerfectModule (R := R) M) :
    StacksDraft.Perfect.IsPerfectModule (R := R) N :=
  StacksDraft.Perfect.isPerfect_of_iso
    ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).mapIso e.toModuleIso).symm hM

/-- A local complete intersection has a finite polynomial presentation whose quotient by the
kernel is a perfect module over the polynomial algebra. -/
private theorem exists_perfect_quotient_presentation
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] (f : A →+* B)
    (h : IsLocalCompleteIntersection f) :
    let := f.toAlgebra
    ∃ (n : ℕ) (p : MvPolynomial (Fin n) A →ₐ[A] B), Function.Surjective p ∧
      StacksDraft.Perfect.IsPerfectModule (R := MvPolynomial (Fin n) A)
        (MvPolynomial (Fin n) A ⧸ RingHom.ker p.toRingHom) := by
  let := f.toAlgebra
  obtain ⟨n, p, hp, hker⟩ := h.2
  exact ⟨n, p, hp, quotient_isPerfect_of_isKoszulRegularIdeal _ hker⟩

/-! ### The theorem -/

/-- **Stacks 07EN.** A local complete intersection homomorphism is perfect. -/
@[stacks 07EN, sga "6 III 4.1.1" "second part, affine", sga "6 VIII 1.7" "affine case"]
public theorem IsLocalCompleteIntersection.isPerfectRingMap
    {A : Type u} {B : Type u} [CommRing A] [CommRing B] (f : A →+* B)
    (h : IsLocalCompleteIntersection f)
    (derivedTensor :
      DerivedCategory (ModuleCat.{u} A) ⥤
        DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory (ModuleCat.{u} A))
    (comparison : ∀ N : ModuleCat.{u} A,
      DerivedCategory.Q ⋙
          derivedTensor.flip.obj
            ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj N) ⟶
        (StacksDraft.TorAmplitude.tensorModuleRight N).mapHomologicalComplex
            (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    (isLeftDerived : ∀ N : ModuleCat.{u} A,
      (derivedTensor.flip.obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj N)).IsLeftDerivedFunctor
        (comparison N)
        (HomologicalComplex.quasiIso (ModuleCat.{u} A) (ComplexShape.up ℤ))) :
    letI := f.toAlgebra
    IsPerfectRingMap A B derivedTensor comparison isLeftDerived := by
  let := f.toAlgebra
  obtain ⟨n, p, hp, hquot⟩ := exists_perfect_quotient_presentation f h
  refine (isPerfectRingMap_iff_exists_finite_projective_resolution
    A B derivedTensor comparison isLeftDerived).mpr ⟨n, p, hp, ?_⟩
  let : Module (MvPolynomial (Fin n) A) B := Module.compHom B p.toRingHom
  apply (StacksDraft.Perfect.isPerfectModule_iff_exists_finite_projective_resolution B).mp
  let : Algebra (MvPolynomial (Fin n) A) B := p.toRingHom.toAlgebra
  let q : MvPolynomial (Fin n) A →ₐ[MvPolynomial (Fin n) A] B :=
    IsScalarTower.toAlgHom (MvPolynomial (Fin n) A) (MvPolynomial (Fin n) A) B
  have hq : Function.Surjective q := hp
  exact isPerfectModule_of_linearEquiv
    (Ideal.quotientKerAlgEquivOfSurjective hq).toLinearEquiv
    hquot

end RingHom
