/-!
# Nagata's criterion for factoriality

Let `A` be an integral domain and let `S ⊆ A` be a multiplicative subset — a submonoid of the
multiplicative monoid of `A` — that is *generated by prime elements*: there is a set `P ⊆ A`
of prime elements of `A` with `S = ⟨P⟩`, the submonoid generated by `P`. Write `S⁻¹A` for the
localization of `A` at `S`, with canonical map `φ : A → S⁻¹A`.

## Main results

For an irreducible `x ∈ A`:

1. *Localized irreducibility.* The image `φ x` in `S⁻¹A` is irreducible or a unit.
2. *Primality criterion.* `x` is prime in `A` if and only if `φ x` is a prime element of `S⁻¹A`
   or a unit in `S⁻¹A`.
3. *Nagata's criterion.* `A` is a unique factorization domain if and only if every nonzero
   nonunit of `A` admits a factorization into a finite nonempty product of irreducibles of `A`
   and `S⁻¹A` is a unique factorization domain.

This is Stacks Lemma 10.120.7, tag 0AFU.

## Conventions

* A *unit* `u ∈ A` is an element with a multiplicative inverse (`IsUnit u`).
* An element `x` is *irreducible* (`Irreducible x`) if it is not a unit and whenever
  `x = a * b` then `a` or `b` is a unit. In a nontrivial domain `0` is not irreducible.
* An element `x` is *prime* (`Prime x`) if `x ≠ 0`, `x` is not a unit, and `x ∣ a * b` implies
  `x ∣ a` or `x ∣ b`.
* `S` is *generated by prime elements* if `S = Submonoid.closure P` for a set `P` of prime
  elements of `A`. This is strictly stronger than the elementwise condition "every `s ∈ S` is
  a finite product of primes of `A`", which does not force the individual prime factors to lie
  in `S`; the generated-submonoid form `GenByPrimes` is the operative hypothesis. In particular
  `0 ∉ S`, so the localization map is injective and `S⁻¹A` is a domain.
* A unique factorization domain is `UniqueFactorizationMonoid A` together with `IsDomain A`.

The substantive content is the reverse direction of (3), which combines (1) and (2) with
Stacks Lemma 10.120.5, tag 034T, available as
`UniqueFactorizationMonoid.iff_exists_prime_factors`.
-/

@[expose] public section

variable {A : Type*} [CommRing A] [IsDomain A]
/-- The submonoid `S` of `A` is *generated by prime elements* if there is a set
`P` of prime elements of `A` with `S = ⟨P⟩` (the submonoid generated by `P`). -/
def GenByPrimes (S : Submonoid A) : Prop :=
  ∃ P : Set A, (∀ p ∈ P, Prime p) ∧ S = Submonoid.closure P

/-- Every nonzero nonunit element of `A` admits a factorization into a finite
nonempty product of irreducible elements of `A`. A nonempty multiset is forced
automatically: the product over the empty multiset is `1`, a unit, contradicting
the nonunit hypothesis. -/
def HasIrreducibleFactorizations (A : Type*) [CommRing A] : Prop :=
  ∀ a : A, a ≠ 0 → ¬ IsUnit a →
    ∃ l : Multiset A, (∀ p ∈ l, Irreducible p) ∧ l.prod = a

namespace NagataAux

/-- `0 ∉ S` when `S = closure P` with all of `P` prime. -/
lemma zero_notMem (S : Submonoid A) (P : Set A) (hP : ∀ p ∈ P, Prime p)
    (hSP : S = Submonoid.closure P) : (0 : A) ∉ S := by
  have key : ∀ x ∈ Submonoid.closure P, x ≠ 0 := by
    intro x hx
    refine Submonoid.closure_induction ?_ ?_ ?_ hx
    · intro y hy; exact (hP y hy).ne_zero
    · exact one_ne_zero
    · intro a b _ _ ha hb; exact mul_ne_zero ha hb
  rw [hSP]; intro h; exact key 0 h rfl

/-- A submonoid not containing `0` consists of nonzerodivisors of a domain. -/
lemma S_le_nzd (S : Submonoid A) (h0 : (0 : A) ∉ S) : S ≤ nonZeroDivisors A := by
  intro x hx
  exact mem_nonZeroDivisors_of_ne_zero (fun hh => h0 (hh ▸ hx))

/-- Localizing a domain at a submonoid not containing `0` gives an injective structure map. -/
@[ega "0 1.2.7"]
lemma injective_algebraMap (S : Submonoid A) (h0 : (0 : A) ∉ S) :
    Function.Injective (algebraMap A (Localization S)) :=
  IsLocalization.injective (Localization S) (S_le_nzd S h0)

omit [IsDomain A] in
/-- An element of `S = closure P`, with all of `P` prime, is the product of a list of primes
lying in `S`. -/
lemma exists_list_prime_of_mem (S : Submonoid A) (P : Set A) (hP : ∀ p ∈ P, Prime p)
    (hSP : S = Submonoid.closure P) {s : A} (hs : s ∈ S) :
    ∃ L : List A, (∀ p ∈ L, Prime p ∧ p ∈ S) ∧ L.prod = s := by
  subst hSP
  obtain ⟨L, hLmem, hLprod⟩ := Submonoid.exists_list_of_mem_closure hs
  exact ⟨L, fun p hp => ⟨hP p (hLmem p hp), Submonoid.subset_closure (hLmem p hp)⟩, hLprod⟩

omit [IsDomain A] in
/-- `mk' a s` is a unit iff `φ a` is a unit. -/
lemma isUnit_mk'_iff (S : Submonoid A) (a : A) (s : S) :
    IsUnit (IsLocalization.mk' (Localization S) a s) ↔
      IsUnit (algebraMap A (Localization S) a) := by
  have hs : IsUnit (algebraMap A (Localization S) (s : A)) := IsLocalization.map_units _ s
  have key : algebraMap A (Localization S) a
      = IsLocalization.mk' (Localization S) a s * algebraMap A (Localization S) (s : A) :=
    (IsLocalization.mk'_spec (Localization S) a s).symm
  rw [key]
  exact ⟨fun h => h.mul hs, isUnit_of_mul_isUnit_left⟩

/-- The unit characterization: `φ a` is a unit iff `a` divides some element of `S`. -/
lemma isUnit_algebraMap_iff (S : Submonoid A) (h0 : (0 : A) ∉ S) (a : A) :
    IsUnit (algebraMap A (Localization S) a) ↔ ∃ s ∈ S, a ∣ s := by
  constructor
  · intro h
    rw [isUnit_iff_exists] at h
    obtain ⟨inv, hinv, _⟩ := h
    obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.mk'_surjective S inv
    simp only at hbt
    subst hbt
    have ht : (t : A) ≠ 0 := fun hh => h0 (hh ▸ t.property)
    have heq : algebraMap A (Localization S) a * IsLocalization.mk' (Localization S) b t
        = IsLocalization.mk' (Localization S) (a * b) (1 * t) := by
      rw [IsLocalization.mk'_mul, IsLocalization.mk'_one]
    rw [heq] at hinv
    rw [show (1 : Localization S) = IsLocalization.mk' (Localization S) (t : A) t from
      (IsLocalization.mk'_self _ _).symm, IsLocalization.mk'_eq_iff_eq] at hinv
    have e := injective_algebraMap S h0 hinv
    have eab : a * b = (t : A) := by
      apply mul_left_cancel₀ ht
      simpa [mul_comm] using e
    exact ⟨a * b, eab ▸ t.property, b, rfl⟩
  · rintro ⟨s, hs, c, rfl⟩
    have : IsUnit (algebraMap A (Localization S) (a * c)) :=
      IsLocalization.map_units (Localization S) (⟨a * c, hs⟩ : S)
    rw [map_mul] at this
    exact isUnit_of_mul_isUnit_left this

/-- Core factorization step: if `x` is irreducible and `a * b = x * L.prod` where
`L` is a list of primes all lying in `S`, then `φ a` or `φ b` is a unit. -/
lemma core (S : Submonoid A) (x : A) (hx : Irreducible x)
    (L : List A) (hL : ∀ p ∈ L, Prime p ∧ p ∈ S) :
    ∀ a b : A, a * b = x * L.prod →
      IsUnit (algebraMap A (Localization S) a) ∨
        IsUnit (algebraMap A (Localization S) b) := by
  induction L with
  | nil =>
    intro a b hab
    simp only [List.prod_nil, mul_one] at hab
    rcases hx.isUnit_or_isUnit hab.symm with ha | hb
    · exact Or.inl (ha.map (algebraMap A (Localization S)))
    · exact Or.inr (hb.map (algebraMap A (Localization S)))
  | cons p L' ih =>
    intro a b hab
    have hp : Prime p ∧ p ∈ S := hL p (List.mem_cons_self)
    have hL' : ∀ q ∈ L', Prime q ∧ q ∈ S := fun q hq => hL q (List.mem_cons_of_mem _ hq)
    simp only [List.prod_cons] at hab
    have hpdvd : p ∣ a * b := ⟨x * L'.prod, by rw [hab]; ring⟩
    have hpunit : IsUnit (algebraMap A (Localization S) p) :=
      IsLocalization.map_units (Localization S) (⟨p, hp.right⟩ : S)
    have hp0 : p ≠ 0 := hp.left.ne_zero
    rcases hp.left.dvd_or_dvd hpdvd with hpa | hpb
    · obtain ⟨a', rfl⟩ := hpa
      have hcancel : a' * b = x * L'.prod := by
        apply mul_left_cancel₀ hp0; linear_combination hab
      rcases ih hL' a' b hcancel with ha' | hb
      · left; rw [map_mul]; exact hpunit.mul ha'
      · right; exact hb
    · obtain ⟨b', rfl⟩ := hpb
      have hcancel : a * b' = x * L'.prod := by
        apply mul_left_cancel₀ hp0; linear_combination hab
      rcases ih hL' a b' hcancel with ha | hb'
      · left; exact ha
      · right; rw [map_mul]; exact hpunit.mul hb'

end NagataAux

open NagataAux

open UniqueFactorizationMonoid

/-- **(Localized irreducibility.)** If `x` is irreducible in `A`, then its image
in the localization `S⁻¹A` is irreducible or a unit. -/
@[stacks 0AFU "(1)"]
theorem localized_irreducible (S : Submonoid A) (hS : GenByPrimes S)
    (x : A) (hx : Irreducible x) :
    Irreducible (algebraMap A (Localization S) x) ∨
      IsUnit (algebraMap A (Localization S) x) := by
  obtain ⟨P, hP, hSP⟩ := hS
  have h0 : (0 : A) ∉ S := zero_notMem S P hP hSP
  by_cases hdvd : ∃ s ∈ S, x ∣ s
  · exact Or.inr ((isUnit_algebraMap_iff S h0 x).mpr hdvd)
  refine Or.inl ⟨fun hu => hdvd ((isUnit_algebraMap_iff S h0 x).mp hu), ?_⟩
  intro α β hαβ
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.mk'_surjective S α
  obtain ⟨⟨b, t⟩, ht⟩ := IsLocalization.mk'_surjective S β
  simp only at hs ht
  have hxe : algebraMap A (Localization S) x
      = IsLocalization.mk' (Localization S) (a * b) (s * t) := by
    rw [hαβ, ← hs, ← ht, IsLocalization.mk'_mul]
  rw [IsLocalization.eq_mk'_iff_mul_eq] at hxe
  simp only [← map_mul] at hxe
  have e := injective_algebraMap S h0 hxe
  obtain ⟨L, hL, hLprod⟩ := exists_list_prime_of_mem S P hP hSP (mul_mem s.property t.property)
  have hab : a * b = x * L.prod := by
    rw [hLprod]
    push_cast at e ⊢
    linear_combination -e
  rcases core S x hx L hL a b hab with ha | hb
  · left
    rw [← hs]
    exact (isUnit_mk'_iff S a s).mpr ha
  · right
    rw [← ht]
    exact (isUnit_mk'_iff S b t).mpr hb

namespace NagataAux2

/-
Helper sub-lemmas for theorem (2). We work with `S = closure P`, all of `P`
prime, `φ = algebraMap A (Localization S)`, which is injective (`0 ∉ S`).

The unit characterization `isUnit_algebraMap_iff` says `IsUnit (φ a) ↔ ∃ s ∈ S, a ∣ s`.
-/

/-- **Sub-lemma (2a).** An irreducible `x` whose image in `S⁻¹A` is a unit is prime
in `A`.

INFORMAL ARGUMENT.  `IsUnit (φ x)` gives, by `isUnit_algebraMap_iff`, some `s ∈ S`
with `x ∣ s`.  Since `S = closure P`, `s` is a finite product of primes from `P`
(use `Submonoid.exists_list_of_mem_closure`): `s = p₁ * ⋯ * pₙ` with each
`pᵢ ∈ P` prime (hence `pᵢ ∈ S`).  Now `x` is irreducible and `x ∣ p₁ * ⋯ * pₙ`.
Because each `pᵢ` is prime, `x` divides one of the factors `pⱼ` (induct on the
list: `x ∣ (p · rest)` with `p` prime; if `p ∣ x` then `x` is associate of the
prime `p`, hence prime and done; otherwise descend — more directly: a prime that
divides `x · k` … ; cleanest is: an irreducible element dividing a product of
primes is associate to one of them).  Then `x ∣ pⱼ` with `pⱼ` prime and `x`
irreducible forces `x` to be an associate of `pⱼ` (the cofactor is a unit since
`pⱼ` is irreducible and `x` is not a unit), so `x` is prime by
`Associated.prime`.

This is exactly the building block verified during sketching:
  `obtain ⟨c, rfl⟩ := (x ∣ pⱼ); rcases (hpⱼ.irreducible).isUnit_or_isUnit rfl with hu|hu`
  -- first case contradicts `hx.not_unit` (i.e. `hx.1`); second gives
  -- `Associated x (x*c)` via `associated_mul_unit_right`, then `.symm.prime hpⱼ`.

The "irreducible dividing a product of primes divides one factor" step should be
its own tiny induction (`List`/`Multiset`), or use existing Mathlib API
(`Prime.dvd_of_dvd_prod`-style after noting `x` prime would be circular — instead
do the list induction picking off prime factors as in `core`). -/
lemma image_unit_imp_prime (S : Submonoid A) (hS : GenByPrimes S)
    (x : A) (hx : Irreducible x)
    (hu : IsUnit (algebraMap A (Localization S) x)) : Prime x := by
  obtain ⟨P, hP, hSP⟩ := hS
  have h0 : (0 : A) ∉ S := zero_notMem S P hP hSP
  obtain ⟨s, hsS, hxs⟩ := (isUnit_algebraMap_iff S h0 x).mp hu
  have hsmem : s ∈ Submonoid.closure P := hSP ▸ hsS
  obtain ⟨L, hLmem, hLprod⟩ := Submonoid.exists_list_of_mem_closure hsmem
  have hLprime : ∀ p ∈ L, Prime p := fun p hp => hP p (hLmem p hp)
  -- It suffices: for any list of primes L, x ∣ L.prod → Prime x.
  rw [← hLprod] at hxs
  clear hu hsmem hsS hSP h0 hP P hLprod hLmem s
  -- Now x ∣ L.prod with all members of L prime. Show Prime x by induction on L.
  induction L with
  | nil =>
    simp only [List.prod_nil] at hxs
    exact absurd (isUnit_of_dvd_one hxs) hx.not_isUnit
  | cons p L' ih =>
    simp only [List.prod_cons] at hxs
    have hp : Prime p := hLprime p (List.mem_cons_self)
    have hL' : ∀ q ∈ L', Prime q := fun q hq => hLprime q (List.mem_cons_of_mem _ hq)
    obtain ⟨k, hk⟩ := hxs
    -- p * L'.prod = x * k, and p prime divides x * k
    have hpdvd : p ∣ x * k := ⟨L'.prod, by rw [hk]⟩
    rcases hp.dvd_or_dvd hpdvd with hpx | hpk
    · -- p ∣ x, x irreducible ⇒ Associated p x ⇒ Prime x
      exact (hp.irreducible.associated_of_dvd hx hpx).prime hp
    · -- p ∣ k, cancel p: x ∣ L'.prod, apply IH
      obtain ⟨k', hk'⟩ := hpk
      have hcancel : x ∣ L'.prod := by
        refine ⟨k', ?_⟩
        apply mul_left_cancel₀ hp.ne_zero
        rw [hk, hk']; ring
      exact ih hcancel hL'

/-- **Sub-lemma (2b).** If `x` is prime in `A` and `φ x` is not a unit, then `φ x`
is prime in `S⁻¹A`.

INFORMAL ARGUMENT.  `φ x` is nonzero (`x ≠ 0`, `φ` injective) and not a unit (by
hypothesis); we must show `φ x ∣ α · β ⇒ φ x ∣ α ∨ φ x ∣ β`.  Write
`α = mk' a s`, `β = mk' b t` (`IsLocalization.mk'_surjective`).  Then
`φ x ∣ α β = mk' (a b) (s t)`.  Multiplying by the unit `φ(s t)`, this is
equivalent to `φ x ∣ φ(a b)` in `S⁻¹A`, i.e. `φ(a b) = φ x · γ` for some
`γ = mk' c u`.  Clearing denominators with injectivity of `φ` gives, in `A`,
`a b · u = x · c` for some `u ∈ S`, so `x ∣ a b · u`.  Now `x` prime in `A` gives
`x ∣ a b` or `x ∣ u`; the latter would make `φ x` a unit (`x ∣ u ∈ S`,
`isUnit_algebraMap_iff`), contradiction, so `x ∣ a b`.  Again by primality of `x`,
`x ∣ a` or `x ∣ b`, whence `φ x ∣ φ a` and `φ a ∣ α` (since
`α = mk' a s = φ a · (φ s)⁻¹`), giving `φ x ∣ α`; symmetrically `φ x ∣ β`.

(Equivalently and more slickly: primality of `x` in `A` together with the unit
characterization shows the prime ideal `(x)` of `A` is disjoint from `S`, so its
extension stays prime in the localization — Mathlib's
`IsLocalization.isPrime_iff_isPrime_disjoint` / prime-ideal-correspondence API may
shorten this.  But the elementwise descent above is self-contained.) -/
lemma prime_image_of_prime_not_unit (S : Submonoid A) (hS : GenByPrimes S)
    (x : A) (hxp : Prime x)
    (hnu : ¬ IsUnit (algebraMap A (Localization S) x)) :
    Prime (algebraMap A (Localization S) x) := by
  obtain ⟨P, hP, hSP⟩ := hS
  have h0 : (0 : A) ∉ S := zero_notMem S P hP hSP
  have hinj := injective_algebraMap S h0
  refine ⟨fun h => hxp.ne_zero (hinj (h.trans (map_zero _).symm)), hnu, ?_⟩
  rintro α β ⟨γ, hγ⟩
  obtain ⟨⟨a, s⟩, hspecα⟩ := IsLocalization.surj S α
  obtain ⟨⟨b, t⟩, hspecβ⟩ := IsLocalization.surj S β
  obtain ⟨⟨c, u⟩, hspecγ⟩ := IsLocalization.surj S γ
  simp only at hspecα hspecβ hspecγ
  set φ := algebraMap A (Localization S)
  have key : φ (a * b * (u : A)) = φ (x * c * ((s : A) * (t : A))) := by
    simp only [map_mul, ← hspecα, ← hspecβ, ← hspecγ]
    linear_combination (φ (s : A) * φ (t : A) * φ (u : A)) * hγ
  have hxdvd : x ∣ a * b * (u : A) := ⟨c * ((s : A) * (t : A)), by rw [hinj key]; ring⟩
  rcases hxp.dvd_or_dvd hxdvd with hxab | hxu
  · rcases hxp.dvd_or_dvd hxab with hxa | hxb
    · left
      exact (IsUnit.dvd_mul_right (IsLocalization.map_units (Localization S) s)).mp
        (by rw [hspecα]; exact map_dvd φ hxa)
    · right
      exact (IsUnit.dvd_mul_right (IsLocalization.map_units (Localization S) t)).mp
        (by rw [hspecβ]; exact map_dvd φ hxb)
  · exact absurd ((isUnit_algebraMap_iff S h0 x).mpr ⟨(u : A), u.property, hxu⟩) hnu

/-- If `x` is irreducible and divides no element of `S`, and `a * L.prod = x * c` for a list `L`
of primes lying in `S`, then `x ∣ a`. -/
lemma dvd_of_mul_list_prod_eq (S : Submonoid A) (x : A) (hx : Irreducible x)
    (hxS : ∀ s ∈ S, ¬ x ∣ s) (L : List A) (hL : ∀ q ∈ L, Prime q ∧ q ∈ S) :
    ∀ a c : A, a * L.prod = x * c → x ∣ a := by
  induction L with
  | nil =>
    intro a c hac
    simp only [List.prod_nil, mul_one] at hac
    exact ⟨c, hac⟩
  | cons q L' ih =>
    intro a c hac
    have hq : Prime q ∧ q ∈ S := hL q List.mem_cons_self
    simp only [List.prod_cons] at hac
    rcases hq.1.dvd_or_dvd ⟨a * L'.prod, by rw [← hac]; ring⟩ with hqx | ⟨c', rfl⟩
    · exact absurd (hq.1.irreducible.associated_of_dvd hx hqx).symm.dvd (hxS q hq.2)
    · exact ih (fun r hr => hL r (List.mem_cons_of_mem _ hr)) a c'
        (mul_left_cancel₀ hq.1.ne_zero (by linear_combination hac))

/-- If `x` is irreducible and divides no element of `S`, then `φ x ∣ φ a` implies `x ∣ a`. -/
lemma dvd_of_algebraMap_dvd (S : Submonoid A) (P : Set A) (hP : ∀ p ∈ P, Prime p)
    (hSP : S = Submonoid.closure P) (x : A) (hx : Irreducible x) (hxS : ∀ s ∈ S, ¬ x ∣ s)
    {a : A} (h : algebraMap A (Localization S) x ∣ algebraMap A (Localization S) a) :
    x ∣ a := by
  obtain ⟨γ, hγ⟩ := h
  obtain ⟨⟨c, u⟩, hcu⟩ := IsLocalization.mk'_surjective S γ
  simp only at hcu
  subst hcu
  have key : algebraMap A (Localization S) (a * (u : A))
      = algebraMap A (Localization S) (x * c) := by
    rw [map_mul, map_mul, hγ, mul_assoc, IsLocalization.mk'_spec]
  have eqA := injective_algebraMap S (zero_notMem S P hP hSP) key
  obtain ⟨L, hL, hLprod⟩ := exists_list_prime_of_mem S P hP hSP u.property
  refine dvd_of_mul_list_prod_eq S x hx hxS L hL a c ?_
  rw [hLprod]
  exact eqA

/-- **Sub-lemma (2c).** If `x` is irreducible in `A` and `φ x` is prime in `S⁻¹A`,
then `x` is prime in `A`.

INFORMAL ARGUMENT.  `x` irreducible ⇒ `x ≠ 0` and `¬IsUnit x`.  For divisibility:
suppose `x ∣ a b` in `A`.  Then `φ x ∣ φ a · φ b`, and `φ x` prime gives
`φ x ∣ φ a` or `φ x ∣ φ b`; say `φ x ∣ φ a`.  Unfold: `φ a = φ x · mk' c u` for
some `c ∈ A`, `u ∈ S`.  Clearing the denominator and applying injectivity of `φ`
gives `a · u = x · c` in `A`, so `x ∣ a · u` with `u ∈ S`.
  Claim: `x ∣ a`.  Note `φ x` prime ⇒ `φ x` not a unit ⇒ (`isUnit_algebraMap_iff`)
  `x` divides no element of `S`.  Write `u = q₁ ⋯ qₘ` as a product of primes from
  `P` (all in `S`).  Induct on this list:
    • base `u` a unit: `x ∣ a · (unit)` ⇒ `x ∣ a`.
    • step `u = q · u'`, `q` prime in `S`: from `x ∣ a · q · u'` we have
      `q ∣ x · (cofactor)`. Better: cancel primes from the *other* side. Concretely
      `a u = x c`, i.e. `a q u' = x c`; since `q` prime and `q ∣ x c`, get `q ∣ x`
      or `q ∣ c`. `q ∣ x` with `x` irreducible and `q` not a unit ⇒ `x` associate
      of `q ∈ S` ⇒ `φ x` a unit, contradicting `φ x` prime. So `q ∣ c`, write
      `c = q c'`, cancel `q` (domain): `a u' = x c'`, i.e. `x ∣ a u'`; apply IH.
  Hence `x ∣ a`.  Symmetrically the `φ x ∣ φ b` case gives `x ∣ b`.  This proves
  the divisibility condition, so `x` is prime.

This descent is the mirror of `core`/`localized_irreducible`; the inductive
"cancel a prime of `S` against the cofactor" step is the crux. -/
lemma prime_of_prime_image (S : Submonoid A) (hS : GenByPrimes S)
    (x : A) (hx : Irreducible x)
    (hp : Prime (algebraMap A (Localization S) x)) : Prime x := by
  obtain ⟨P, hP, hSP⟩ := hS
  have h0 : (0 : A) ∉ S := zero_notMem S P hP hSP
  have hxS : ∀ s ∈ S, ¬ x ∣ s := fun s hs hdvd =>
    hp.not_isUnit ((isUnit_algebraMap_iff S h0 x).mpr ⟨s, hs, hdvd⟩)
  refine ⟨hx.ne_zero, hx.not_isUnit, fun a b hxab => ?_⟩
  have hφ : algebraMap A (Localization S) x ∣
      algebraMap A (Localization S) a * algebraMap A (Localization S) b := by
    rw [← map_mul]
    exact map_dvd _ hxab
  exact (hp.dvd_or_dvd hφ).imp (dvd_of_algebraMap_dvd S P hP hSP x hx hxS)
    (dvd_of_algebraMap_dvd S P hP hSP x hx hxS)

end NagataAux2

open NagataAux2

/-- **(Primality criterion.)** If `x` is irreducible in `A`, then `x` is prime
in `A` if and only if its image in `S⁻¹A` is prime or a unit.

PROOF (assembled; sub-lemmas above carry the content):
`(→)` Given `Prime x`. Decide `IsUnit (φ x)`: if so, right disjunct; else by
sub-lemma (2b) `Prime (φ x)`, left disjunct.
`(←)` Given `Prime (φ x) ∨ IsUnit (φ x)`: the prime case is sub-lemma (2c), the
unit case is sub-lemma (2a). -/
@[stacks 0AFU "(2)"]
theorem prime_iff_localized_prime_or_unit (S : Submonoid A) (hS : GenByPrimes S)
    (x : A) (hx : Irreducible x) :
    Prime x ↔
      (Prime (algebraMap A (Localization S) x) ∨
        IsUnit (algebraMap A (Localization S) x)) :=
  ⟨fun hxp => or_iff_not_imp_right.mpr (prime_image_of_prime_not_unit S hS x hxp),
    fun h => h.elim (prime_of_prime_image S hS x hx) (image_unit_imp_prime S hS x hx)⟩

namespace NagataAux3

/-- **Sub-lemma (3a).** Every irreducible element of `A` is prime, given that the
localization `S⁻¹A` is a UFD.

PROOF (assembled, no further open goals): combine theorem (1) and theorem (2).
By `localized_irreducible`, `φ x` is irreducible or a unit. If irreducible, then
`S⁻¹A` being a UFD makes it prime (`UniqueFactorizationMonoid.irreducible_iff_prime`),
so `φ x` is prime-or-unit; if already a unit, likewise. Then theorem (2)
`prime_iff_localized_prime_or_unit` yields `Prime x`. -/
lemma irreducible_imp_prime_of_ufm (S : Submonoid A) (hS : GenByPrimes S)
    [UniqueFactorizationMonoid (Localization S)] (x : A) (hx : Irreducible x) :
    Prime x := by
  rw [prime_iff_localized_prime_or_unit S hS x hx]
  rcases localized_irreducible S hS x hx with hirr | hu
  · exact Or.inl (UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr)
  · exact Or.inr hu

omit [IsDomain A] in
/-- **Sub-lemma (3b).** A UFD `A` has irreducible factorizations of nonzero nonunits
(with *exact* equality, as required by `HasIrreducibleFactorizations`).

INFORMAL ARGUMENT.  Let `a ≠ 0`, `¬IsUnit a`.  Since `A` is a UFD,
`UniqueFactorizationMonoid.exists_prime_factors a` (or `factors a`) yields a
multiset `f` of primes (hence irreducibles) with `Associated f.prod a`, i.e.
`f.prod = u * a` for a unit `u` — equivalently `a = u' * f.prod` with `u'` a unit.
The `HasIrreducibleFactorizations` def requires *equality* `l.prod = a`, not just
`Associated`.  Since `a` is not a unit, `f` is nonempty (an empty/all-unit product
is a unit), so pick one factor `p₀ ∈ f` and replace it by its associate
`u' * p₀` (still irreducible, as an associate of an irreducible — multiplying an
irreducible by a unit keeps it irreducible via `Irreducible.isUnit_mul`/
`associated`), absorbing the unit.  The resulting multiset `l` has all-irreducible
members and `l.prod = a` exactly.

Alternatively use `UniqueFactorizationMonoid.factors a`: `factors a` is a multiset
of irreducibles with `(factors a).prod ~ᵤ a` (`prod_factors`/`factors_prod`), and
`a ≠ 0`; then absorb the unit into one factor as above. -/
lemma hasIrreducibleFactorizations_of_ufm [UniqueFactorizationMonoid A] :
    HasIrreducibleFactorizations A := by
  classical
  intro a ha hau
  obtain ⟨u, hu⟩ := (UniqueFactorizationMonoid.factors_prod ha)
  set f := UniqueFactorizationMonoid.factors a
  have hfne : f ≠ 0 := by
    intro h0
    apply hau
    rw [← hu, h0, Multiset.prod_zero, one_mul]
    exact u.isUnit
  obtain ⟨p₀, hp₀⟩ := Multiset.exists_mem_of_ne_zero hfne
  set f' := f.erase p₀
  have hcons : p₀ ::ₘ f' = f := Multiset.cons_erase hp₀
  refine ⟨(↑u * p₀) ::ₘ f', ?_, ?_⟩
  · intro p hp
    rw [Multiset.mem_cons] at hp
    rcases hp with rfl | hp
    · have hirr : Irreducible p₀ :=
        UniqueFactorizationMonoid.irreducible_of_factor p₀ hp₀
      exact (associated_unit_mul_left p₀ (↑u) u.isUnit).symm.irreducible hirr
    · exact UniqueFactorizationMonoid.irreducible_of_factor p (Multiset.mem_of_mem_erase hp)
  · rw [Multiset.prod_cons]
    have hfp : f.prod = p₀ * f'.prod := by rw [← hcons, Multiset.prod_cons]
    rw [← hu, hfp]
    ring

/-- **Sub-lemma (3c).** The localization of a UFD `A` at a submonoid `S` generated
by primes (so `S ≤ nonZeroDivisors A`) is again a UFD.

NOTE: there is **no** off-the-shelf Mathlib lemma `Localization of UFD is UFD`
(confirmed by search).  This must be proved.

INFORMAL ARGUMENT.  `S⁻¹A` is a domain (`IsLocalization.isDomain_localization`,
using `S ≤ nonZeroDivisors A` from `S_le_nzd`/`zero_notMem`).  To show it is a UFD,
use `UniqueFactorizationMonoid.of_exists_prime_factors`: every nonzero `ξ ∈ S⁻¹A`
has a prime factorization.  Write `ξ = mk' a s` with `a ≠ 0` (as `ξ ≠ 0`).  Since
`φ s` is a unit, `ξ` is associate to `φ a`, so it suffices to factor `φ a`.
Factor `a` in the UFD `A`: `a = p₁ ⋯ pₙ · (unit)` with `pᵢ` prime in `A`.  Map to
`S⁻¹A`: `φ a = φ(p₁) ⋯ φ(pₙ) · (unit)`.  By theorem (1) each `φ(pᵢ)` is irreducible
or a unit in `S⁻¹A`; drop the unit ones.  For the irreducible ones, they are in
fact prime in `S⁻¹A`: a prime `p` of `A` maps to a prime or unit of `S⁻¹A`
(this is theorem (2) applied with `x = p`, noting prime⇒irreducible; the image is
prime-or-unit, and we keep the non-unit ⇒ prime ones).  Hence `φ a` (up to a unit)
is a product of primes of `S⁻¹A`, giving a prime factorization of `ξ`.
-/
lemma localize_prime_factors (S : Submonoid A) (hS : GenByPrimes S) (f : Multiset A)
    (hf : ∀ p ∈ f, Prime p) :
    ∃ g : Multiset (Localization S), (∀ b ∈ g, Prime b) ∧
      Associated g.prod (algebraMap A (Localization S) f.prod) := by
  classical
  induction f using Multiset.induction with
  | empty =>
    exact ⟨0, by simp, by simp⟩
  | cons p f' ih =>
    have hp : Prime p := hf p (Multiset.mem_cons_self p f')
    have hf' : ∀ q ∈ f', Prime q := fun q hq => hf q (Multiset.mem_cons_of_mem hq)
    obtain ⟨g', hg'prime, hg'assoc⟩ := ih hf'
    have hpou := (prime_iff_localized_prime_or_unit S hS p hp.irreducible).mp hp
    rcases hpou with hpprime | hpunit
    · refine ⟨(algebraMap A (Localization S) p) ::ₘ g', ?_, ?_⟩
      · intro b hb
        rw [Multiset.mem_cons] at hb
        rcases hb with rfl | hb
        · exact hpprime
        · exact hg'prime b hb
      · rw [Multiset.prod_cons, Multiset.prod_cons, map_mul]
        exact (hg'assoc.mul_left _)
    · refine ⟨g', hg'prime, ?_⟩
      rw [Multiset.prod_cons, map_mul]
      exact hg'assoc.trans (associated_unit_mul_left _ _ hpunit).symm

/-- The localization of a unique factorization domain at a submonoid generated by prime
elements is again a unique factorization domain. -/
lemma ufm_localization (S : Submonoid A) (hS : GenByPrimes S)
    [UniqueFactorizationMonoid A] :
    UniqueFactorizationMonoid (Localization S) := by
  classical
  obtain ⟨P, hP, hSP⟩ := hS
  have h0 : (0 : A) ∉ S := zero_notMem S P hP hSP
  have : IsDomain (Localization S) :=
    IsLocalization.isDomain_localization (S_le_nzd S h0)
  apply UniqueFactorizationMonoid.of_exists_prime_factors
  intro ξ hξ
  obtain ⟨⟨a, s⟩, hξe⟩ := IsLocalization.mk'_surjective S ξ
  simp only at hξe
  have ha : a ≠ 0 := by
    intro h
    apply hξ
    rw [← hξe, h, IsLocalization.mk'_zero]
  obtain ⟨f, hfprime, hfassoc⟩ := UniqueFactorizationMonoid.exists_prime_factors a ha
  obtain ⟨g, hgprime, hgassoc⟩ := localize_prime_factors S ⟨P, hP, hSP⟩ f hfprime
  refine ⟨g, hgprime, ?_⟩
  have hξassoc : Associated (algebraMap A (Localization S) a) ξ := by
    rw [← hξe, ← IsLocalization.mk'_spec (Localization S) a s]
    exact associated_mul_unit_left _ _ (IsLocalization.map_units _ s)
  have hfa : Associated (algebraMap A (Localization S) f.prod) (algebraMap A (Localization S) a) :=
    (hfassoc.map (algebraMap A (Localization S)))
  exact hgassoc.trans (hfa.trans hξassoc)

end NagataAux3

open NagataAux3

/-- **(Nagata's criterion for factoriality.)** `A` is a UFD if and only if every
nonzero nonunit of `A` factors into irreducibles and `S⁻¹A` is a UFD.

PROOF (assembled; the content is in the sub-lemmas above and theorems (1),(2)):
`(→)` `UFD A` ⇒ irreducible factorizations exist (3b) and `S⁻¹A` is a UFD (3c).
`(←)` Given irreducible factorizations and `UFD (S⁻¹A)`: build `UFD A` via
`UniqueFactorizationMonoid.of_exists_prime_factors` (Stacks 034T).  For `a ≠ 0`:
units factor as the empty product; for a nonunit, take its irreducible
factorization and observe each irreducible factor is prime by (3a) (which itself
uses theorems (1),(2) and `UFD (S⁻¹A)`); the product equals `a` exactly, hence is
`Associated` to `a`. -/
@[stacks 0AFU "Moreover"]
theorem nagata_criterion (S : Submonoid A) (hS : GenByPrimes S) :
    UniqueFactorizationMonoid A ↔
      (HasIrreducibleFactorizations A ∧
        UniqueFactorizationMonoid (Localization S)) := by
  refine ⟨fun _ => ⟨hasIrreducibleFactorizations_of_ufm, ufm_localization S hS⟩, ?_⟩
  · rintro ⟨hfact, hloc⟩
    have : UniqueFactorizationMonoid (Localization S) := hloc
    apply UniqueFactorizationMonoid.of_exists_prime_factors
    intro a ha
    by_cases hu : IsUnit a
    · refine ⟨0, by simp, ?_⟩
      simpa using (associated_one_iff_isUnit.mpr hu).symm
    · obtain ⟨l, hlirr, hlprod⟩ := hfact a ha hu
      refine ⟨l, fun b hb => irreducible_imp_prime_of_ufm S hS b (hlirr b hb), ?_⟩
      rw [hlprod]
      exact Associated.refl a
