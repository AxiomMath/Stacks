module

public import Mathlib.RingTheory.Extension.Cotangent.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The conormal row of a surjection of presentations

Let `R → S → T` be ring maps, let `P₀ : Algebra.Extension R S` present `S` over `R`, let
`P : Algebra.Extension R T` present `T` over `R`, and let `P' : Algebra.Extension S T`
present `T` over `S`.  Suppose given morphisms of extensions `h₁ : P₀.Hom P` and
`h : P.Hom P'` and write `𝒫₀ ⊇ I`, `𝒫 ⊇ K`, `𝒫' ⊇ K'` for the three presenting rings and
their kernels.  If the ring map `π : 𝒫 → 𝒫'` underlying `h` is **surjective** and its kernel
is the ideal `I · 𝒫` generated by the image of `I`, then the conormal sequence

```
T ⊗_S I/I² ⟶ K/K² ⟶ K'/(K')² ⟶ 0
```

is exact.  This is the degree-`1` row of the transitivity diagram: the completed analogue,
for Stacks 0ALM, of what Mathlib proves for polynomial presentations in
`Algebra.Generators.Cotangent.exact`, but stated for an arbitrary pair of extensions, so
that it applies to the presentations `B = A⟨x⟩/J`, `C = B⟨y⟩/J'`, `C = A⟨x, y⟩/K` by
completed polynomial algebras.

The proof is elementary.  Because the two extensions `P` and `P'` have the *same* target
`T`, the compatibility `algebraMap 𝒫' T ∘ π = algebraMap 𝒫 T` built into `h` says exactly
that `K` is the preimage of `K'`; surjectivity of `π` then gives `π(K) = K'` and
`π(K²) = (K')²`, whence both the surjectivity of `K/K² → K'/(K')²` and the identification
of its kernel with the image of `ker π`.  Right exactness of the degree-`1` row is all that
the snake lemma needs, and exactness at `T ⊗_S I/I²` is in general false.

## Main results

* `Algebra.Extension.ker_eq_comap_toRingHom`: `K` is the preimage of `K'`.
* `Algebra.Extension.Cotangent.surjective_map_of_surjective_toRingHom`: `K/K² → K'/(K')²`
  is surjective.
* `Algebra.Extension.Cotangent.map_eq_zero_iff_exists_mem_ker_toRingHom`: a class in `K/K²`
  dies in `K'/(K')²` if and only if it is the class of an element of `ker π`.
* `Algebra.Extension.Cotangent.exact_liftBaseChange_map_of_ker_eq`: **the degree-`1` row
  `T ⊗_S I/I² → K/K² → K'/(K')²` is exact**, when `ker π = I · 𝒫`.

## References

* [Stacks Project, Tag 0ALM](https://stacks.math.columbia.edu/tag/0ALM)
* [Stacks Project, Tag 00S2](https://stacks.math.columbia.edu/tag/00S2)
-/

@[expose] public section

namespace Algebra.Extension

variable {R : Type*} [CommRing R] {S : Type*} [CommRing S] [Algebra R S]
variable {T : Type*} [CommRing T] [Algebra R T] [Algebra S T] [IsScalarTower R S T]
variable {P : Algebra.Extension R T} {P' : Algebra.Extension S T}

omit [IsScalarTower R S T] in
/-- Two extensions of the *same* algebra `T`, one over `R` and one over `S`, related by a
morphism `h`: the kernel of the first is the preimage along `h` of the kernel of the second.
This is the compatibility `algebraMap P'.Ring T ∘ h = algebraMap P.Ring T` read as an
equality of ideals. -/
public theorem ker_eq_comap_toRingHom (h : P.Hom P') : P.ker = P'.ker.comap h.toRingHom := by
  ext x
  simp only [Algebra.Extension.ker, Ideal.mem_comap, RingHom.mem_ker]
  simp [h.algebraMap_toRingHom x]

omit [IsScalarTower R S T] in
/-- A morphism of extensions of the same algebra whose underlying ring map is surjective
carries the one kernel onto the other. -/
public theorem map_ker_eq_ker_of_surjective (h : P.Hom P')
    (hs : Function.Surjective h.toRingHom) : P.ker.map h.toRingHom = P'.ker := by
  rw [ker_eq_comap_toRingHom h, Ideal.map_comap_of_surjective _ hs]

/-- The conormal module is right exact along a surjection: if the ring map underlying
`h : P.Hom P'` is surjective, then `K/K² → K'/(K')²` is surjective. -/
public theorem Cotangent.surjective_map_of_surjective_toRingHom (h : P.Hom P')
    (hs : Function.Surjective h.toRingHom) : Function.Surjective (Cotangent.map h) := by
  intro y
  obtain ⟨⟨y₀, hy₀⟩, rfl⟩ := Cotangent.mk_surjective (P := P') y
  obtain ⟨x, hx⟩ := hs y₀
  have hxk : x ∈ P.ker := by
    rw [ker_eq_comap_toRingHom h, Ideal.mem_comap, hx]
    exact hy₀
  refine ⟨Cotangent.mk ⟨x, hxk⟩, ?_⟩
  rw [Cotangent.map_mk]
  congr 1
  exact Subtype.ext hx

/-- A class in `K/K²` dies in `K'/(K')²` exactly when it is the class of an element of
`ker π`, `π` being the ring map underlying `h`.  This is the kernel computation behind the
exactness of the conormal row: `π(K²) = (K')²` because `π(K) = K'`, so an element of `K`
whose image lies in `(K')²` differs from an element of `K²` by an element of `ker π`. -/
public theorem Cotangent.map_eq_zero_iff_exists_mem_ker_toRingHom (h : P.Hom P')
    (hs : Function.Surjective h.toRingHom) (x : P.Cotangent) :
    Cotangent.map h x = 0 ↔
      ∃ y : P.ker, (y : P.Ring) ∈ RingHom.ker h.toRingHom ∧ Cotangent.mk y = x := by
  constructor
  · intro hx
    obtain ⟨⟨x₀, hx₀⟩, rfl⟩ := Cotangent.mk_surjective (P := P) x
    rw [Cotangent.map_mk] at hx
    replace hx := (Ideal.toCotangent_eq_zero _ _).mp hx
    have hsq : (P.ker ^ 2).map h.toRingHom = P'.ker ^ 2 := by
      rw [Ideal.map_pow, map_ker_eq_ker_of_surjective h hs]
    rw [← hsq, Ideal.mem_map_iff_of_surjective _ hs] at hx
    obtain ⟨z, hz, hzeq⟩ := hx
    have hzk : z ∈ P.ker := (Ideal.pow_le_self (by norm_num)) hz
    refine ⟨⟨x₀ - z, Ideal.sub_mem _ hx₀ hzk⟩, ?_, ?_⟩
    · simp only [RingHom.mem_ker, map_sub]
      rw [hzeq]
      simp
    · have hz0 : Cotangent.mk (P := P) ⟨z, hzk⟩ = 0 := (Ideal.toCotangent_eq_zero _ _).mpr hz
      have hsub : (⟨x₀ - z, Ideal.sub_mem _ hx₀ hzk⟩ : P.ker) =
          (⟨x₀, hx₀⟩ : P.ker) - ⟨z, hzk⟩ := rfl
      rw [hsub, map_sub, hz0, sub_zero]
  · rintro ⟨y, hy, rfl⟩
    rw [Cotangent.map_mk]
    have hy0 : h.toAlgHom (y : P.Ring) = 0 := by
      simpa [RingHom.mem_ker] using hy
    rw [show (⟨h.toAlgHom (y : P.Ring), by rw [hy0]; exact Submodule.zero_mem _⟩ : P'.ker) =
      0 from Subtype.ext hy0]
    simp

variable {P₀ : Algebra.Extension R S}

omit [IsScalarTower R S T] in
/-- A morphism of extensions carries the kernel of the source into the kernel of the
target. -/
public theorem map_ker_le_ker_of_hom (h₁ : P₀.Hom P) : P₀.ker.map h₁.toRingHom ≤ P.ker := by
  rw [Ideal.map_le_iff_le_comap]
  intro j hj
  simp only [Ideal.mem_comap, Algebra.Extension.ker, RingHom.mem_ker]
  rw [h₁.algebraMap_toRingHom j]
  simp only [Algebra.Extension.ker, RingHom.mem_ker] at hj
  rw [hj, map_zero]

/-- **The degree-`1` row of the transitivity diagram.** Let `P₀` present `S` over `R`, let
`P` present `T` over `R` and let `P'` present `T` over `S`, with morphisms of extensions
`h₁ : P₀.Hom P` and `h : P.Hom P'`.  If the ring map `π` underlying `h` is surjective with
kernel the ideal generated by the image of the kernel `I` of `P₀`, then

```
T ⊗_S I/I² ⟶ K/K² ⟶ K'/(K')²
```

is exact, the first map being the base change along `S → T` of the map induced by `h₁`.

Together with `Cotangent.surjective_map_of_surjective_toRingHom` this is the right-exact
degree-`1` row that the snake lemma of `NaiveCotangent.exists_sixTerm_exact` consumes. -/
public theorem Cotangent.exact_liftBaseChange_map_of_ker_eq (h₁ : P₀.Hom P) (h : P.Hom P')
    (hs : Function.Surjective h.toRingHom)
    (hker : RingHom.ker h.toRingHom = P₀.ker.map h₁.toRingHom) :
    Function.Exact ((Cotangent.map h₁).liftBaseChange T) (Cotangent.map h) := by
  intro x
  constructor
  · intro hx
    obtain ⟨y, hy, rfl⟩ := (Cotangent.map_eq_zero_iff_exists_mem_ker_toRingHom h hs x).mp hx
    rw [hker] at hy
    set M : Submodule T P.Cotangent := LinearMap.range ((Cotangent.map h₁).liftBaseChange T)
      with hM
    have hrange : M = Submodule.span T (LinearMap.range (Cotangent.map h₁) : Set P.Cotangent) :=
      LinearMap.range_liftBaseChange T _
    have key : ∀ z ∈ P₀.ker.map h₁.toRingHom, ∀ hzk : z ∈ P.ker,
        Cotangent.mk (P := P) ⟨z, hzk⟩ ∈ M := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem w hw =>
        intro hzk
        obtain ⟨j, hj, rfl⟩ := hw
        refine hrange ▸ Submodule.subset_span ⟨Cotangent.mk ⟨j, hj⟩, ?_⟩
        rw [Cotangent.map_mk]
        rfl
      | zero =>
        intro hzk
        rw [show (⟨0, hzk⟩ : P.ker) = 0 from Subtype.ext rfl, map_zero]
        exact Submodule.zero_mem _
      | add a b ha hb iha ihb =>
        intro hzk
        have hak := map_ker_le_ker_of_hom h₁ ha
        have hbk := map_ker_le_ker_of_hom h₁ hb
        rw [show (⟨a + b, hzk⟩ : P.ker) = ⟨a, hak⟩ + ⟨b, hbk⟩ from rfl, map_add]
        exact Submodule.add_mem _ (iha hak) (ihb hbk)
      | smul c a ha iha =>
        intro hzk
        have hak := map_ker_le_ker_of_hom h₁ ha
        rw [show (⟨c • a, hzk⟩ : P.ker) = c • ⟨a, hak⟩ from rfl, map_smul,
          show c • Cotangent.mk (P := P) ⟨a, hak⟩ =
            (algebraMap P.Ring T c) • Cotangent.mk (P := P) ⟨a, hak⟩ from
            (algebraMap_smul T c _).symm]
        exact Submodule.smul_mem _ _ (iha hak)
    exact key _ hy y.2
  · rintro ⟨w, rfl⟩
    induction w using TensorProduct.inductionOn with
    | tmul c a =>
      obtain ⟨j, rfl⟩ := Cotangent.mk_surjective (P := P₀) a
      rw [LinearMap.liftBaseChange_tmul, map_smul, Cotangent.map_mk]
      rw [(Cotangent.map_eq_zero_iff_exists_mem_ker_toRingHom h hs _).mpr ?_, smul_zero]
      refine ⟨⟨h₁.toAlgHom (j : P₀.Ring), map_ker_le_ker_of_hom h₁ (Ideal.mem_map_of_mem _ j.2)⟩,
        ?_, rfl⟩
      rw [hker]
      exact Ideal.mem_map_of_mem _ j.2
    | add a b ha hb => rw [map_add, map_add, ha, hb, add_zero]

end Algebra.Extension

end
