module

public import Mathlib.RingTheory.Extension.Cotangent.Basic
public import StacksFrontier.RingTheory.NaiveCotangent.PresentationHomology

/-!
# The naive cotangent complex does not see an isomorphism of the base

Let `R₀ → T` and `R₁ → T'` be ring maps and suppose given ring isomorphisms `β : R₀ ≃ R₁` and
`e : T ≃ T'` forming a commutative square. Then the homology modules of the naive cotangent
complexes `NL_{T/R₀}` and `NL_{T'/R₁}` correspond, so an element `r` of `R₀` annihilates the
homology of `NL_{T/R₀}` as soon as `β r` annihilates that of `NL_{T'/R₁}`.

This is used to move annihilation statements about `NL_{(B/IⁿB)/(A/Iⁿ)}` — condition (4) of
Stacks 0AJU — between a Noetherian ring `A` and its `I`-adic completion, whose quotients by the
powers of `I` are the same rings.

## Main results

* `NaiveCotangent.smul_h1Cotangent_eq_zero_of_ringEquiv`: the statement for `H₁`.
* `NaiveCotangent.smul_kaehlerDifferential_eq_zero_of_ringEquiv`: the statement for `H₀ = Ω`.
* `NaiveCotangent.mem_annihilator_homology_of_ringEquiv`: both, for the homology of
  `Algebra.naiveCotangentComplex`.

## Implementation notes

The maps are the functorial maps of `H₁` and of Kähler differentials along a commutative square
of rings, once for the square and once for its inverse. Their composite is induced by the
identity square, so it is the identity: for `H₁` because the map induced by a morphism of
extensions does not depend on the morphism (`Algebra.Extension.H1Cotangent.map_eq`), for `Ω`
because Kähler differentials are generated by the exact differentials.
-/

@[expose] public section

universe u₀ u₁ v₀ v₁

namespace NaiveCotangent

variable {R₀ : Type u₀} {R₁ : Type u₁} {T : Type v₀} {T' : Type v₁}
  [CommRing R₀] [CommRing R₁] [CommRing T] [CommRing T']
  [Algebra R₀ T] [Algebra R₁ T']

/-- **`H₁` of the naive cotangent complex along an isomorphism of squares.** If `β : R₀ ≃ R₁`
and `e : T ≃ T'` form a commutative square with the structure maps, then an element `r` of
`R₀` annihilates `H₁(L_{T/R₀})` as soon as `β r` annihilates `H₁(L_{T'/R₁})`. -/
theorem smul_h1Cotangent_eq_zero_of_ringEquiv (β : R₀ ≃+* R₁) (e : T ≃+* T')
    (he : ∀ r, e (algebraMap R₀ T r) = algebraMap R₁ T' (β r)) (r : R₀)
    (hr : ∀ x : Algebra.H1Cotangent R₁ T', algebraMap R₁ T' (β r) • x = 0)
    (x : Algebra.H1Cotangent R₀ T) : algebraMap R₀ T r • x = 0 := by
  let : Algebra R₀ R₁ := β.toRingHom.toAlgebra
  let : Algebra T T' := e.toRingHom.toAlgebra
  let : Algebra R₀ T' := (e.toRingHom.comp (algebraMap R₀ T)).toAlgebra
  have : IsScalarTower R₀ T T' := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower R₀ R₁ T' := .of_algebraMap_eq fun r ↦ he r
  let : Algebra R₁ R₀ := β.symm.toRingHom.toAlgebra
  let : Algebra T' T := e.symm.toRingHom.toAlgebra
  let : Algebra R₁ T := (e.symm.toRingHom.comp (algebraMap R₁ T')).toAlgebra
  have : IsScalarTower R₁ T' T := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower R₁ R₀ T := .of_algebraMap_eq fun r ↦ by
    change e.symm (algebraMap R₁ T' r) = algebraMap R₀ T (β.symm r)
    rw [e.symm_apply_eq, he, RingEquiv.apply_symm_apply]
  have : IsScalarTower R₀ R₁ R₀ := .of_algebraMap_eq fun r ↦ (β.symm_apply_apply r).symm
  have : IsScalarTower T T' T := .of_algebraMap_eq fun t ↦ (e.symm_apply_apply t).symm
  let m₁ := Algebra.H1Cotangent.map R₀ R₁ T T'
  let m₂ := Algebra.H1Cotangent.map R₁ R₀ T' T
  have hinv : ∀ y : Algebra.H1Cotangent R₀ T, m₂ (m₁ y) = y := fun y ↦ by
    change ((m₂.restrictScalars T) ∘ₗ m₁) y = y
    rw [show m₁ = Algebra.Extension.H1Cotangent.map _ from rfl,
      show m₂ = Algebra.Extension.H1Cotangent.map _ from rfl,
      ← Algebra.Extension.H1Cotangent.map_comp, Algebra.Extension.H1Cotangent.map_eq _
        (Algebra.Extension.Hom.id _), Algebra.Extension.H1Cotangent.map_id, LinearMap.id_apply]
  have hm : m₁ (algebraMap R₀ T r • x) = algebraMap R₁ T' (β r) • m₁ x := by
    rw [m₁.map_smul, ← he]
    rfl
  rw [← hinv (algebraMap R₀ T r • x), hm, hr, map_zero]

/-- **Kähler differentials along an isomorphism of squares.** If `β : R₀ ≃ R₁` and
`e : T ≃ T'` form a commutative square with the structure maps, then an element `r` of `R₀`
annihilates `Ω[T⁄R₀]` as soon as `β r` annihilates `Ω[T'⁄R₁]`. -/
theorem smul_kaehlerDifferential_eq_zero_of_ringEquiv (β : R₀ ≃+* R₁) (e : T ≃+* T')
    (he : ∀ r, e (algebraMap R₀ T r) = algebraMap R₁ T' (β r)) (r : R₀)
    (hr : ∀ x : Ω[T'⁄R₁], algebraMap R₁ T' (β r) • x = 0)
    (x : Ω[T⁄R₀]) : algebraMap R₀ T r • x = 0 := by
  let : Algebra R₀ R₁ := β.toRingHom.toAlgebra
  let : Algebra T T' := e.toRingHom.toAlgebra
  let : Algebra R₀ T' := (e.toRingHom.comp (algebraMap R₀ T)).toAlgebra
  have : IsScalarTower R₀ T T' := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower R₀ R₁ T' := .of_algebraMap_eq fun r ↦ he r
  let : Algebra R₁ R₀ := β.symm.toRingHom.toAlgebra
  let : Algebra T' T := e.symm.toRingHom.toAlgebra
  let : Algebra R₁ T := (e.symm.toRingHom.comp (algebraMap R₁ T')).toAlgebra
  have : IsScalarTower R₁ T' T := .of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower R₁ R₀ T := .of_algebraMap_eq fun r ↦ by
    change e.symm (algebraMap R₁ T' r) = algebraMap R₀ T (β.symm r)
    rw [e.symm_apply_eq, he, RingEquiv.apply_symm_apply]
  have : IsScalarTower T T' T := .of_algebraMap_eq fun t ↦ (e.symm_apply_apply t).symm
  let m₁ := KaehlerDifferential.map R₀ R₁ T T'
  let m₂ := KaehlerDifferential.map R₁ R₀ T' T
  have hinv : (m₂.restrictScalars T) ∘ₗ m₁ = LinearMap.id := by
    ext t
    change m₂ (m₁ (KaehlerDifferential.D R₀ T t)) = KaehlerDifferential.D R₀ T t
    rw [KaehlerDifferential.map_D, KaehlerDifferential.map_D]
    exact congrArg (KaehlerDifferential.D R₀ T) (e.symm_apply_apply t)
  have hm : m₁ (algebraMap R₀ T r • x) = algebraMap R₁ T' (β r) • m₁ x := by
    rw [m₁.map_smul, ← he]
    rfl
  have h : m₂ (m₁ (algebraMap R₀ T r • x)) = algebraMap R₀ T r • x :=
    LinearMap.congr_fun hinv _
  rw [← h, hm, hr, map_zero]

/-- **The homology of the naive cotangent complex along an isomorphism of squares.** If
`β : R₀ ≃ R₁` and `e : T ≃ T'` form a commutative square with the structure maps, then for
`k = 0, 1` the image of `r : R₀` annihilates `H_k(NL_{T/R₀})` as soon as the image of `β r`
annihilates `H_k(NL_{T'/R₁})`: these modules are `Ω` and `H₁` of the cotangent complex. -/
theorem mem_annihilator_homology_of_ringEquiv (β : R₀ ≃+* R₁) (e : T ≃+* T')
    (he : ∀ r, e (algebraMap R₀ T r) = algebraMap R₁ T' (β r)) (r : R₀) {k : ℕ} (hk : k ≤ 1)
    (hr : algebraMap R₁ T' (β r) ∈ Module.annihilator T'
      ((Algebra.naiveCotangentComplex R₁ T').homology k)) :
    algebraMap R₀ T r ∈ Module.annihilator T
      ((Algebra.naiveCotangentComplex R₀ T).homology k) := by
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hk with rfl | rfl
  · rw [annihilator_homology_zero_eq (Algebra.Generators.self R₁ T'),
      ((Algebra.Generators.self R₁ T').toExtension.quotRangeCotangentComplexEquivKaehler
        ).annihilator_eq] at hr
    rw [annihilator_homology_zero_eq (Algebra.Generators.self R₀ T),
      ((Algebra.Generators.self R₀ T).toExtension.quotRangeCotangentComplexEquivKaehler
        ).annihilator_eq]
    exact Module.mem_annihilator.mpr
      (smul_kaehlerDifferential_eq_zero_of_ringEquiv β e he r (Module.mem_annihilator.mp hr))
  · rw [annihilator_homology_one_eq (Algebra.Generators.self R₁ T'),
      ← ((Algebra.Generators.self R₁ T').toExtension.h1CotangentEquivKer).annihilator_eq] at hr
    rw [annihilator_homology_one_eq (Algebra.Generators.self R₀ T),
      ← ((Algebra.Generators.self R₀ T).toExtension.h1CotangentEquivKer).annihilator_eq]
    exact Module.mem_annihilator.mpr
      (smul_h1Cotangent_eq_zero_of_ringEquiv β e he r (Module.mem_annihilator.mp hr))

end NaiveCotangent
