module

public import StacksFrontier.AlgebraicGeometry.Different.NoetherDifferent.JacobianDualizingModule
public import StacksFrontier.AlgebraicGeometry.Different.QuasiFiniteSyntomic.UniversalFamilyProperties
public import StacksFrontier.RingTheory.Noetherian.ULift
public import StacksFrontier.RingTheory.TateMap.Nice
public import StacksFrontier.RingTheory.TateMap.UniversalFamily

/-!
# The quasi-finite basic charts of the universal family are nice

For a positive degree bound `d`, every quasi-finite basic chart
`univBase[x_1, …, x_n, 1/k]/(f_1, …, f_n)` of the universal family `Y_{n, d} → X_{n, d}` is
nice, in an arbitrary universe: its trace element has vanishing annihilator. The universal
quotient ring `univBase[x_1, …, x_n]/(f_1, …, f_n)` is identified with
`AlgebraicGeometry.universalQuotientRing n d`; it is a domain, unramified over `univBase n d` at
its generic point.

## Main definitions

* `Stacks.TateMap.univQuot n d`: the universal quotient ring over `univBase n d`.
* `Stacks.TateMap.univQuotEquiv n d`: its identification with
  `AlgebraicGeometry.universalQuotientRing n d`.

## Main results

* `Stacks.TateMap.isUnramifiedAt_bot_univQuot`: the universal quotient ring is unramified over
  `univBase n d` at its generic point.
* `Stacks.TateMap.isNiceChart_localizedCompleteIntersection`: a quasi-finite localized complete
  intersection over a Noetherian ring whose quotient ring is a domain unramified at its generic
  point is nice.
* `Stacks.TateMap.isNiceChart_univChart`: every quasi-finite basic chart of the universal family
  is nice.

## References

* [Stacks Project, Tag 0FKD](https://stacks.math.columbia.edu/tag/0FKD)
* [Stacks Project, Tag 0FK9](https://stacks.math.columbia.edu/tag/0FK9)
-/

@[expose] public noncomputable section

universe u

namespace Stacks.TateMap

open _root_.AlgebraicGeometry Stacks.Discriminant

variable (n d : ℕ)

/-! ### Instances on the basic charts -/

/-- A basic chart is of finite presentation over `univBase n d`. -/
instance (k : MvPolynomial (Fin n) (univBase.{u} n d)) :
    Algebra.FinitePresentation (univBase.{u} n d) (univChart n d k) :=
  finitePresentation_localizedCompleteIntersection _ n k _

/-- A basic chart is a Noetherian ring. -/
instance (k : MvPolynomial (Fin n) (univBase.{u} n d)) : IsNoetherianRing (univChart n d k) :=
  Algebra.FiniteType.isNoetherianRing (univBase.{u} n d) _

/-- A quasi-finite basic chart is flat over `univBase n d`. -/
instance (k : MvPolynomial (Fin n) (univBase.{u} n d))
    [Algebra.QuasiFinite (univBase.{u} n d) (univChart n d k)] :
    Module.Flat (univBase.{u} n d) (univChart n d k) :=
  flat_localizedCompleteIntersection _ n k _

/-! ### The universal quotient ring -/

/-- The universal quotient ring `univBase[x_1, …, x_n]/(f_1, …, f_n)`. -/
abbrev univQuot : Type u :=
  MvPolynomial (Fin n) (univBase.{u} n d) ⧸ Ideal.span (Set.range (univPoly n d))

/-- The coefficient ring `univBase n d` in universe `u` is isomorphic to
`AlgebraicGeometry.universalCoefficientRing n d`. -/
def univBaseEquiv : univBase.{u} n d ≃+* universalCoefficientRing n d :=
  MvPolynomial.mapEquiv _ ULift.ringEquiv

/-- `Stacks.TateMap.univBaseEquiv` is a left inverse of `Stacks.TateMap.univBaseMap`. -/
theorem univBaseEquiv_comp_univBaseMap :
    (univBaseEquiv.{u} n d).toRingHom.comp (univBaseMap.{u} n d) = RingHom.id _ := by
  apply MvPolynomial.ringHom_ext <;> simp [univBaseEquiv, univBaseMap]

/-- The polynomial ring over `univBase n d` is isomorphic to the polynomial ring over
`AlgebraicGeometry.universalCoefficientRing n d`. -/
def univPolyRingEquiv :
    MvPolynomial (Fin n) (univBase.{u} n d) ≃+*
      MvPolynomial (Fin n) (universalCoefficientRing n d) :=
  MvPolynomial.mapEquiv _ (univBaseEquiv.{u} n d)

/-- `Stacks.TateMap.univPolyRingEquiv` sends the universal polynomial `univPoly n d i` to
`AlgebraicGeometry.universalPolynomial n d i`. -/
theorem univPolyRingEquiv_univPoly (i : Fin n) :
    univPolyRingEquiv.{u} n d (univPoly n d i) = universalPolynomial n d i := by
  rw [univPolyRingEquiv, MvPolynomial.mapEquiv_apply, univPoly, MvPolynomial.map_map]
  change MvPolynomial.map ((univBaseEquiv.{u} n d).toRingHom.comp (univBaseMap.{u} n d)) _ = _
  rw [univBaseEquiv_comp_univBaseMap, MvPolynomial.map_id]

/-- `Stacks.TateMap.univPolyRingEquiv` maps the ideal generated by the universal polynomials onto
`AlgebraicGeometry.universalRelationIdeal n d`. -/
theorem map_univPolyRingEquiv_span :
    Ideal.map (univPolyRingEquiv.{u} n d) (Ideal.span (Set.range (univPoly n d))) =
      universalRelationIdeal n d := by
  rw [Ideal.map_span, ← Set.range_comp]
  exact congrArg (fun s ↦ Ideal.span (Set.range s)) (funext (univPolyRingEquiv_univPoly n d))

/-- The universal quotient ring `univQuot n d` is isomorphic to
`AlgebraicGeometry.universalQuotientRing n d`. -/
def univQuotEquiv : univQuot.{u} n d ≃+* universalQuotientRing n d :=
  Ideal.quotientEquiv _ _ (univPolyRingEquiv.{u} n d) (map_univPolyRingEquiv_span n d).symm

/-- The universal quotient ring is a domain. -/
instance : IsDomain (univQuot.{u} n d) := by
  obtain ⟨e⟩ := universalQuotientRing_polynomial n d
  exact ((univQuotEquiv.{u} n d).trans e).isDomain_iff.mpr inferInstance

/-- The Jacobian determinant commutes with a change of coefficients. -/
theorem map_jacobianDet {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) {m : ℕ}
    (v : Fin m → MvPolynomial (Fin m) R) :
    MvPolynomial.map φ (FullRankJacobianSituation.jacobianDet v) =
      FullRankJacobianSituation.jacobianDet (fun i ↦ MvPolynomial.map φ (v i)) := by
  rw [FullRankJacobianSituation.jacobianDet, RingHom.map_det]
  congr 1
  ext i j
  simp [MvPolynomial.pderiv_map]

/-- The Jacobian determinant of the universal polynomials is nonzero in the universal quotient
ring, for a positive degree bound. -/
theorem jacobianDet_univPoly_ne_zero [NeZero d] :
    Ideal.Quotient.mk (Ideal.span (Set.range (univPoly.{u} n d)))
      (FullRankJacobianSituation.jacobianDet (univPoly.{u} n d)) ≠ 0 := by
  by_cases hn : n = 0
  · subst hn
    rw [FullRankJacobianSituation.jacobianDet, Matrix.det_isEmpty, map_one]
    exact one_ne_zero
  have : NeZero n := ⟨hn⟩
  intro h
  rw [Ideal.Quotient.eq_zero_iff_mem] at h
  have heq : univPolyRingEquiv.{u} n d (FullRankJacobianSituation.jacobianDet (univPoly n d)) =
      FullRankJacobianSituation.jacobianDet (universalPolynomial n d) := by
    rw [univPolyRingEquiv, MvPolynomial.mapEquiv_apply, map_jacobianDet]
    congr 1
    exact funext (univPolyRingEquiv_univPoly n d)
  have hmem := Ideal.mem_map_of_mem (univPolyRingEquiv.{u} n d) h
  rw [map_univPolyRingEquiv_span, heq] at hmem
  exact universalJacobian_ne_zero n d (Ideal.Quotient.eq_zero_iff_mem.mpr hmem)

/-- The universal quotient ring is unramified over the coefficient ring at its generic point. -/
theorem isUnramifiedAt_bot_univQuot [NeZero d] :
    Algebra.IsUnramifiedAt (univBase.{u} n d) (⊥ : Ideal (univQuot.{u} n d)) := by
  set J := Ideal.Quotient.mk (Ideal.span (Set.range (univPoly.{u} n d)))
    (FullRankJacobianSituation.jacobianDet (univPoly.{u} n d))
  have h := FullRankJacobianSituation.etale_away_jacobianDet (univPoly.{u} n d)
    (I := Ideal.span (Set.range (univPoly.{u} n d))) rfl (Localization.Away J)
  rw [← IsScalarTower.algebraMap_eq, RingHom.etale_algebraMap] at h
  exact isUnramifiedAt_bot_of_formallyUnramified_away J (jacobianDet_univPoly_ne_zero n d)

/-! ### Localized complete intersections over a generically unramified quotient -/

/-- Let `A` be Noetherian, and let `B = A[x_1, …, x_n, 1/h]/(f_1, …, f_n)` be quasi-finite
over `A`. If `A[x_1, …, x_n]/(f_1, …, f_n)` is a domain unramified over `A` at its generic point,
then `A → B` is nice. -/
theorem isNiceChart_localizedCompleteIntersection {A : Type u} [CommRing A] [IsNoetherianRing A]
    {m : ℕ} (h : MvPolynomial (Fin m) A) (f : Fin m → MvPolynomial (Fin m) A)
    [Algebra.QuasiFinite A (localizedCompleteIntersection A m h f)]
    [IsNoetherianRing (localizedCompleteIntersection A m h f)]
    [Module.Flat A (localizedCompleteIntersection A m h f)]
    [IsDomain (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f))]
    [Algebra.IsUnramifiedAt A (⊥ : Ideal (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f)))] :
    IsNiceChart A (localizedCompleteIntersection A m h f) := by
  have e := localizedQuotientEquiv A m h f
  have hloc := isLocalization_away_localizedQuotient A m h f
  have : IsScalarTower A (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f))
      (localizedQuotient A m h f) := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : Algebra.FinitePresentation A (localizedCompleteIntersection A m h f) :=
    finitePresentation_localizedCompleteIntersection A m h f
  have : Algebra.QuasiFinite A (localizedQuotient A m h f) :=
    (Algebra.QuasiFinite.iff_of_algEquiv e).mpr inferInstance
  have : Algebra.FiniteType A (localizedQuotient A m h f) :=
    Algebra.FiniteType.equiv inferInstance e.symm
  have : IsNoetherianRing (localizedQuotient A m h f) :=
    Algebra.FiniteType.isNoetherianRing A _
  have : Module.Flat A (localizedQuotient A m h f) :=
    Module.Flat.of_linearEquiv e.toLinearEquiv
  have : Algebra.IsRelativeGlobalCompleteIntersection A (localizedQuotient A m h f) :=
    Algebra.IsRelativeGlobalCompleteIntersection.of_algEquiv e.symm
  refine IsNiceChart.of_algEquiv ?_ e
  set kb := algebraMap (MvPolynomial (Fin m) A)
    (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f)) h
  by_cases hk : kb = 0
  · have : Subsingleton (localizedQuotient A m h f) := by
      have hu := IsLocalization.Away.algebraMap_isUnit (S := localizedQuotient A m h f) kb
      rw [hk, map_zero] at hu
      exact subsingleton_of_zero_eq_one (isUnit_zero_iff.mp hu)
    exact fun _ _ _ ↦ Subsingleton.elim _ _
  have hle : Submonoid.powers kb ≤
      nonZeroDivisors (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f)) :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hk
  have : IsDomain (localizedQuotient A m h f) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ hle
  obtain ⟨c, hc0, hc⟩ := exists_smul_eq_zero_of_isUnramifiedAt_bot
    (A := A) (B := MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f))
  have : Algebra.IsUnramifiedAt A (⊥ : Ideal (localizedQuotient A m h f)) := by
    refine isUnramifiedAt_bot_of_smul_eq_zero (algebraMap _ (localizedQuotient A m h f) c) ?_
      (smul_kaehler_localization_eq_zero (Submonoid.powers kb) c hc)
    rw [← map_zero (algebraMap (MvPolynomial (Fin m) A ⧸ Ideal.span (Set.range f))
      (localizedQuotient A m h f))]
    exact fun h ↦ hc0 (IsLocalization.injective _ hle h)
  exact isNiceChart_of_isUnramifiedAt ⊥

/-! ### The basic charts -/

/-- For a positive degree bound `d` and a polynomial `k` with
`univBase[x_1, …, x_n, 1/k]/(f_1, …, f_n)` quasi-finite over `univBase`, the trace element of that
chart has vanishing annihilator. -/
theorem isNiceChart_univChart [NeZero d] (k : MvPolynomial (Fin n) (univBase.{u} n d))
    [Algebra.QuasiFinite (univBase.{u} n d) (univChart n d k)] :
    IsNiceChart (univBase.{u} n d) (univChart n d k) :=
  have := isUnramifiedAt_bot_univQuot.{u} n d
  isNiceChart_localizedCompleteIntersection k (univPoly n d)

end Stacks.TateMap
