module

public import StacksCore.Tactic.StacksAttribute
public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Order.CompletePartialOrder
public import Mathlib.RingTheory.LocalRing.Length
public import Mathlib.RingTheory.RingHom.Flat

/-!
# Length under a flat local homomorphism

Let `A → B` be a flat local homomorphism of commutative local rings, with `𝔪_A` the maximal
ideal of `A` and `𝔪_A B` the ideal of `B` generated by its image. For every `A`-module `M` the
identity

`length_A(M) * length_B(B / 𝔪_A B) = length_B(B ⊗[A] M)`

holds in `ℕ∞`, the product being taken with the conventions `⊤ * 0 = 0 * ⊤ = 0` and
`⊤ * n = n * ⊤ = ⊤` for `n ≠ 0`. Since `𝔪_A B ⊆ 𝔪_B ⊊ B`, the quotient `B / 𝔪_A B` is nonzero
and its length is at least `1`; consequently, when that length is finite, `M` has finite length
over `A` if and only if `B ⊗[A] M` has finite length over `B`.

## Main definitions

* `extendedMaximalIdeal`: the ideal `𝔪_A B` of `B`.

## Main results

* `length_baseChange_eq_length_mul_length_quotient`: the length identity.
* `finite_length_iff_finite_length_baseChange`: the finiteness corollary.
* `length_baseChange_quotient_eq`: `C ⊗[B] (B ⧸ I)` and `C ⧸ Ideal.map g I` have the same
  length over `C`.
* `length_quotient_maximalIdeal_map_mul_eq`: in a tower `A → B → C` of flat local
  homomorphisms, `length_B (B / m_A B) * length_C (C / m_B C) = length_C (C / m_A C)`.
-/

@[expose] public section

open scoped TensorProduct

/-- The extension `𝔪_A B` of the maximal ideal of `A` along `algebraMap A B`, that is, the
ideal of `B` generated by the image of the maximal ideal of `A`. -/
@[ega "0 10.3.1.1", ega "0 10.3.1.3", sga "1 III 1.7"]
abbrev extendedMaximalIdeal (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [IsLocalRing A] : Ideal B :=
  Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)

/-- For a flat local homomorphism `A → B` of local rings and
every `A`-module `M`, the length of `M` over `A` times the length of `B / m_A B` over `B`
equals the length of the base change `B ⊗[A] M` over `B`, as an identity in `ℕ∞`. -/
@[stacks 02M1,
  ega "IV 2.5.5.3",
  ega "IV 2.5.5.2" "case N = B",
  ega "IV 2.5.5.1" "F = structure sheaf",
  ega "IV 4.7.1" "more general",
  ega "IV 4.7.2" "more general"]
theorem length_baseChange_eq_length_mul_length_quotient
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)] [Module.Flat A B]
    (M : Type*) [AddCommGroup M] [Module A M] :
    Module.length A M *
      Module.length B (B ⧸ extendedMaximalIdeal A B) =
      Module.length B (B ⊗[A] M) := by
  rw [IsLocalRing.length_baseChange A B M]

/-- For a flat local homomorphism `A → B` of local rings such that `B / m_A B` has finite length
over `B`, an `A`-module `M` has finite length over `A` if and only if its base change `B ⊗[A] M`
has finite length over `B`. -/
@[stacks 02M1, ega "IV 2.5.5.3" "in particular", ega "IV 4.7.1"]
theorem finite_length_iff_finite_length_baseChange
    (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)] [Module.Flat A B]
    (hfin : Module.length B (B ⧸ extendedMaximalIdeal A B) < ⊤)
    (M : Type*) [AddCommGroup M] [Module A M] :
    Module.length A M < ⊤ ↔ Module.length B (B ⊗[A] M) < ⊤ := by
  set c := Module.length B (B ⧸ extendedMaximalIdeal A B) with hc
  have hcne : c ≠ 0 := by
    rw [hc, ne_eq, Module.length_eq_zero_iff, not_subsingleton_iff_nontrivial]
    exact Ideal.Quotient.nontrivial_iff.mpr
      (IsLocalRing.map_maximalIdeal_lt_top (algebraMap A B)).ne
  rw [← length_baseChange_eq_length_mul_length_quotient A B M, ← hc]
  refine ⟨fun h => WithTop.mul_lt_top h hfin, fun h => lt_top_iff_ne_top.mpr fun hM => ?_⟩
  simp [hM, ENat.top_mul hcne] at h

/-!
### Multiplicativity of length in a tower of flat local homomorphisms

Let `A`, `B`, `C` be commutative local rings with maximal ideals `m_A`, `m_B`, `m_C`, and let
`f : A → B` and `g : B → C` be flat local homomorphisms, so that the composite `A → C` is again
a flat local homomorphism. Then, as an equality in `ℕ∞ = ℕ ∪ {∞}`,

  length_B (B / m_A B) · length_C (C / m_B C) = length_C (C / m_A C),

where `m_A B`, `m_B C`, `m_A C` are the extensions of the maximal ideals along the respective
ring homomorphisms (`Ideal.map`), with `A → C` the composite `g.comp f`. Extension of ideals is
transitive along composites, `(m_A B) C = m_A C`. No finiteness hypothesis is assumed: the
product on the left is taken in `ℕ∞`, with `0 · ∞ = 0` and `x · ∞ = ∞` for `x ≠ 0`. Here
`B / m_A B` is a `B`-module, while `C / m_B C` and `C / m_A C` are `C`-modules.
-/

@[expose] public section

open Module IsLocalRing TensorProduct

variable {A B C : Type*}
variable [CommRing A] [CommRing B] [CommRing C]
variable [IsLocalRing A] [IsLocalRing B] [IsLocalRing C]
variable (f : A →+* B) (g : B →+* C)

omit [IsLocalRing B] [IsLocalRing C] in
/-- Base change of a quotient ring along `g : B → C` identifies `C ⊗[B] (B ⧸ I)` with
`C ⧸ Ideal.map g I` as `C`-modules, so for any ideal `I ⊆ B` the two have equal `C`-length. -/
theorem length_baseChange_quotient_eq (I : Ideal B) :
    letI : Algebra B C := g.toAlgebra
    Module.length C (C ⊗[B] (B ⧸ I))
      = Module.length C (C ⧸ Ideal.map g I) := by
  let : Algebra B C := g.toAlgebra
  let e1 := Algebra.TensorProduct.tensorQuotientEquiv (R := B) C B C I
  let r := Algebra.TensorProduct.rid B C C
  let J : Ideal (C ⊗[B] B) := Ideal.map (Algebra.TensorProduct.includeRight) I
  have hJ : Ideal.map g I = Ideal.map (r : (C ⊗[B] B) →+* C) J := by
    change Ideal.map g I = Ideal.map (r : (C ⊗[B] B) →+* C)
      (Ideal.map (Algebra.TensorProduct.includeRight : B →ₐ[B] C ⊗[B] B).toRingHom I)
    rw [Ideal.map_map]
    congr 1
    ext b
    change g b = r (Algebra.TensorProduct.includeRight b)
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.rid_tmul,
      Algebra.smul_def, mul_one]
    rfl
  let e2 := Ideal.quotientEquivAlg (R₁ := C) J (Ideal.map g I) r hJ
  let e : (C ⊗[B] (B ⧸ I)) ≃ₐ[C] (C ⧸ Ideal.map g I) := e1.trans e2
  rw [e.toLinearEquiv.length_eq]

/-- For flat local homomorphisms of local rings `f : A → B` and
`g : B → C`, the length of `B / m_A B` over `B` times the length of `C / m_B C`
over `C` equals the length of `C / m_A C` over `C`, where `m_A C` is the extension
of `m_A` along the composite `A → C`. The equality holds in `ℕ∞`. -/
@[stacks 02M2,
  ega "IV 2.5.5.1" "special case",
  ega "IV 2.5.5.2" "special case",
  ega "IV 2.5.5.3" "special case"]
theorem length_quotient_maximalIdeal_map_mul_eq
    (_hf_local : IsLocalHom f) (hg_local : IsLocalHom g)
    (_hf_flat : f.Flat) (hg_flat : g.Flat) :
    Module.length B (B ⧸ Ideal.map f (maximalIdeal A)) *
        Module.length C (C ⧸ Ideal.map g (maximalIdeal B))
      = Module.length C (C ⧸ Ideal.map (g.comp f) (maximalIdeal A)) := by
  let : Algebra B C := g.toAlgebra
  have halg : algebraMap B C = g := rfl
  have : IsLocalHom (algebraMap B C) := halg ▸ hg_local
  have : Module.Flat B C := hg_flat
  have key := length_baseChange B C (B ⧸ Ideal.map f (maximalIdeal A))
  rw [halg, length_baseChange_quotient_eq g, Ideal.map_map] at key
  exact key.symm
