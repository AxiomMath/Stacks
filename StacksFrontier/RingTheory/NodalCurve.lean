module

public import Mathlib.RingTheory.Adjoin.Tower
public import Mathlib.RingTheory.Localization.Away.AdjoinRoot
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import StacksFrontier.RingTheory.NodeRing

/-!
# The nodal affine curve and its punctured normalisation

Let `k` be a field, let `k[s]` be the polynomial ring and let

`A = {f ∈ k[s] ∣ f(0) = f(1)}`

be the *node ring* — the affine curve obtained from the affine line by gluing the two points
`s = 0` and `s = 1`. Let `B = k[s, 1/s]` be the affine line with the point `s = 0` removed. This
file establishes the commutative algebra of the pair `A ⊆ k[s] ⊇ B`:

* `k[s]` is a finite `A`-module, generated by `1` and `s`;
* `A` is of finite type over `k` and noetherian;
* `B` is of finite type over `A`, but is **not** a finite `A`-module;
* `Spec B → Spec A` is a homeomorphism onto a closed subset of `Spec A`, even though `A → B` is
  very far from surjective.

Together the last two items say that a morphism of affine schemes may be of finite type and a
closed embedding on topological spaces without being a closed immersion, and without the
pushforward of the structure sheaf being of finite type.

## Main results

* `Stacks.NodalCurve.spanNodeRing_eq_top`: `k[s] = A · 1 + A · s`.
* `Stacks.NodalCurve.finiteTypeNodeRing`: `A` is of finite type over `k`.
* `Stacks.NodalCurve.not_moduleFinite_localizationAway`: `B` is not a finite `A`-module.
* `Stacks.NodalCurve.isClosedEmbedding_comap_localizationAway`: `Spec B → Spec A` is a closed
  embedding.

## Implementation notes

The ring `A` is `nodeRing k` from `StacksFrontier.RingTheory.NodeRing`.

The punctured line `B` is `Localization.Away (Polynomial.X : Polynomial k)`. Its `A`-algebra
structure is the one Mathlib builds from `Algebra ↥(nodeRing k) (Polynomial k)`, so the tower
`A → k[s] → B` is available by instance search.

## References

* [The Stacks Project, Lemma 36.61.9 (09VG)](https://stacks.math.columbia.edu/tag/09VG)
* [The Stacks Project, Lemma 10.33.2 (00IS)](https://stacks.math.columbia.edu/tag/00IS)
-/

@[expose] public noncomputable section

open Polynomial PrimeSpectrum

namespace Stacks.NodalCurve

variable (k : Type*) [Field k]

/-! ### The node ring as a `k`-algebra -/

/-- The ring map `k → A` sending a scalar to the corresponding constant polynomial. -/
public def constToNodeRing : k →+* nodeRing k :=
  (Polynomial.C : k →+* Polynomial k).codRestrict (nodeRing k) fun _ => by
    simp [mem_nodeRing_iff]

/-- The node ring is a `k`-algebra through the constant polynomials. -/
public instance algebraNodeRing : Algebra k (nodeRing k) := (constToNodeRing k).toAlgebra

/-- The tower `k → A → k[s]`: a scalar becomes the same constant polynomial whether it is viewed
in `k[s]` directly or through the node ring. -/
public instance isScalarTowerNodeRing : IsScalarTower k (nodeRing k) (Polynomial k) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

/-! ### `k[s]` is a finite module over the node ring -/

/-- **`k[s] = A · 1 + A · s`.** The `A`-submodule of `k[s]` spanned by `1` and `s` is all of
`k[s]`. -/
public theorem spanNodeRing_eq_top :
    Submodule.span (nodeRing k) {1, (X : Polynomial k)} = ⊤ := by
  have hu : (X : Polynomial k) * (X - 1) ∈ nodeRing k := X_mul_X_sub_one_mem_nodeRing k
  set u : nodeRing k := ⟨X * (X - 1), hu⟩ with hudef
  have hucoe : (u : Polynomial k) = X * (X - 1) := rfl
  set M := Submodule.span (nodeRing k) {1, (X : Polynomial k)} with hM
  have hpow : ∀ n : ℕ, (X : Polynomial k) ^ n ∈ M := by
    intro n
    induction n with
    | zero => exact Submodule.mem_span_pair.2 ⟨1, 0, by simp⟩
    | succ n ih =>
      obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.1 ih
      have hab' : (a : Polynomial k) * 1 + (b : Polynomial k) * X = X ^ n := hab
      refine Submodule.mem_span_pair.2 ⟨b * u, a + b, ?_⟩
      show ((b * u : nodeRing k) : Polynomial k) * 1
        + ((a + b : nodeRing k) : Polynomial k) * X = X ^ (n + 1)
      have hsucc : (X : Polynomial k) ^ (n + 1)
          = X * ((a : Polynomial k) * 1 + (b : Polynomial k) * X) := by
        rw [hab']; ring
      rw [hsucc, Subring.coe_mul, Subring.coe_add, hucoe]
      ring
  have hall : ∀ f : Polynomial k, f ∈ M := by
    intro f
    induction f using Polynomial.induction_on' with
    | add p q hp hq => exact Submodule.add_mem _ hp hq
    | monomial n c =>
        have hc : (C c : Polynomial k) ∈ nodeRing k := by simp [mem_nodeRing_iff]
        have h : ((⟨C c, hc⟩ : nodeRing k) : Polynomial k) * X ^ n ∈ M :=
          Submodule.smul_mem M (⟨C c, hc⟩ : nodeRing k) (hpow n)
        simpa [C_mul_X_pow_eq_monomial] using h
  exact top_unique fun f _ => hall f

/-- `k[s]` is a finite module over the node ring, on the two generators `1` and `s`. -/
public instance moduleFinitePolynomial : Module.Finite (nodeRing k) (Polynomial k) :=
  Module.finite_def.2 (Submodule.fg_def.2 ⟨{1, X}, Set.toFinite _, spanNodeRing_eq_top k⟩)

/-- `k[s]` is of finite type over the node ring. -/
public instance finiteTypePolynomial : Algebra.FiniteType (nodeRing k) (Polynomial k) :=
  Module.Finite.finiteType _

/-- **The node ring is of finite type over `k`.** -/
public instance finiteTypeNodeRing : Algebra.FiniteType k (nodeRing k) :=
  ⟨fg_of_fg_of_fg k (nodeRing k) (Polynomial k)
    (Algebra.FiniteType.out (R := k) (A := Polynomial k))
    (Module.Finite.fg_top (R := nodeRing k) (M := Polynomial k))
    fun _ _ h => Subtype.ext h⟩

/-- The node ring is noetherian. -/
public instance isNoetherianRingNodeRing : IsNoetherianRing (nodeRing k) :=
  Algebra.FiniteType.isNoetherianRing k (nodeRing k)

/-- `B = k[s, 1/s]` is of finite type over the node ring. -/
public instance finiteTypeLocalizationAway :
    Algebra.FiniteType (nodeRing k) (Localization.Away (X : Polynomial k)) :=
  inferInstance

/-! ### `B` is not a finite module over the node ring -/

/-- **A localization away from a prime element is never a finite module over the base.** -/
public theorem not_moduleFinite_localizationAway_of_prime {R : Type*} [CommRing R] [IsDomain R]
    {x : R} (hx : Prime x) : ¬ Module.Finite R (Localization.Away x) := by
  intro _
  have : Algebra.IsIntegral R (Localization.Away x) := Algebra.IsIntegral.of_finite R _
  have hinj : Function.Injective (algebraMap R (Localization.Away x)) :=
    IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hx.ne_zero)
  have hp : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).2 hx
  obtain ⟨Q, hQ⟩ := RingHom.IsIntegral.comap_surjective
    (fun y => Algebra.IsIntegral.isIntegral y) hinj ⟨Ideal.span {x}, hp⟩
  have hxQ : algebraMap R (Localization.Away x) x ∈ Q.asIdeal := by
    rw [← Ideal.mem_comap, ← PrimeSpectrum.comap_asIdeal, hQ]
    exact Ideal.mem_span_singleton_self x
  exact Q.isPrime.ne_top
    (Ideal.eq_top_of_isUnit_mem _ hxQ (IsLocalization.Away.algebraMap_isUnit x))

/-- **`B = k[s, 1/s]` is not a finite module over the node ring `A`.** -/
public theorem not_moduleFinite_localizationAway :
    ¬ Module.Finite (nodeRing k) (Localization.Away (X : Polynomial k)) := fun _ =>
  not_moduleFinite_localizationAway_of_prime (R := Polynomial k) (x := X) prime_X
    (Module.Finite.of_restrictScalars_finite (nodeRing k) (Polynomial k) _)

/-! ### The two points of `𝔸¹` that the node glues -/

/-- The ideal generated by `s − a` is maximal. -/
public theorem isMaximal_span_X_sub_C (a : k) :
    (Ideal.span {(X - C a : Polynomial k)}).IsMaximal := by
  rw [← Polynomial.ker_evalRingHom]
  exact RingHom.ker_isMaximal_of_surjective _ fun c => ⟨C c, by simp⟩

/-- The ideal generated by `s` is maximal. -/
public theorem isMaximal_span_X : (Ideal.span {(X : Polynomial k)}).IsMaximal := by
  have h : (X - C (0 : k)) = (X : Polynomial k) := by simp
  simpa [h] using isMaximal_span_X_sub_C k (0 : k)

/-- The ideal generated by `s − 1` is maximal. -/
public theorem isMaximal_span_X_sub_one : (Ideal.span {(X - 1 : Polynomial k)}).IsMaximal := by
  have h : (X - C (1 : k)) = (X - 1 : Polynomial k) := by simp
  simpa [h] using isMaximal_span_X_sub_C k (1 : k)

/-- Membership in `(s)` is vanishing at `0`. -/
public theorem mem_span_X_iff (f : Polynomial k) :
    f ∈ Ideal.span {(X : Polynomial k)} ↔ f.eval 0 = 0 := by
  rw [Ideal.mem_span_singleton, X_dvd_iff, coeff_zero_eq_eval_zero]

/-- Membership in `(s − 1)` is vanishing at `1`. -/
public theorem mem_span_X_sub_one_iff (f : Polynomial k) :
    f ∈ Ideal.span {(X - 1 : Polynomial k)} ↔ f.eval 1 = 0 := by
  rw [show (X - 1 : Polynomial k) = X - C 1 from by simp, Ideal.mem_span_singleton,
    dvd_iff_isRoot]
  rfl

/-- **The conductor.** Every multiple of `s(s − 1)` lies in the node ring. -/
public theorem mul_mem_nodeRing (f : Polynomial k) :
    (X : Polynomial k) * (X - 1) * f ∈ nodeRing k := by
  simp [mem_nodeRing_iff]

/-- A prime ideal containing the generator of a maximal principal ideal equals that ideal. -/
private theorem span_singleton_eq_of_mem {R : Type*} [CommRing R] {x : R}
    (hx : (Ideal.span {x}).IsMaximal) {P : Ideal R} (hP : P.IsPrime) (h : x ∈ P) :
    Ideal.span {x} = P :=
  hx.eq_of_le hP.ne_top (Ideal.span_le.2 (Set.singleton_subset_iff.2 h))

/-! ### The spectrum of the node ring -/

/-- The inclusion of the node ring into `k[s]` is integral. -/
public theorem isIntegral_nodeRingSubtype :
    (algebraMap (nodeRing k) (Polynomial k)).IsIntegral := by
  have : Algebra.IsIntegral (nodeRing k) (Polynomial k) := Algebra.IsIntegral.of_finite _ _
  exact fun x => Algebra.IsIntegral.isIntegral x

/-- The inclusion of the node ring into `k[s]` is injective. -/
public theorem injective_nodeRingSubtype :
    Function.Injective (algebraMap (nodeRing k) (Polynomial k)) :=
  fun _ _ h => Subtype.ext h

/-- **`Spec k[s] → Spec A` is surjective.** -/
public theorem comap_nodeRingSubtype_surjective :
    Function.Surjective (comap (algebraMap (nodeRing k) (Polynomial k))) := by
  exact (isIntegral_nodeRingSubtype k).comap_surjective (injective_nodeRingSubtype k)

/-- **The node glues `(s)` and `(s − 1)`.** The two maximal ideals `(s)` and `(s − 1)` of `k[s]`
contract to the same prime of the node ring. -/
public theorem comap_span_X_eq_comap_span_X_sub_one :
    Ideal.comap (algebraMap (nodeRing k) (Polynomial k)) (Ideal.span {(X : Polynomial k)})
      = Ideal.comap (algebraMap (nodeRing k) (Polynomial k))
          (Ideal.span {(X - 1 : Polynomial k)}) := by
  ext a
  have ha := (mem_nodeRing_iff (a : Polynomial k)).1 a.2
  simp only [Ideal.mem_comap]
  rw [show algebraMap (nodeRing k) (Polynomial k) a = (a : Polynomial k) from rfl,
    mem_span_X_iff, mem_span_X_sub_one_iff, ha]

/-- **`Spec k[s] → Spec A` is injective away from `(s)`.** Two primes of `k[s]` not containing
`s` with the same contraction to the node ring are equal. -/
public theorem comap_nodeRingSubtype_injOn :
    Set.InjOn (comap (algebraMap (nodeRing k) (Polynomial k)))
      {P : PrimeSpectrum (Polynomial k) | (X : Polynomial k) ∉ P.asIdeal} := by
  intro P hP Q hQ h
  have hcomap : Ideal.comap (algebraMap (nodeRing k) (Polynomial k)) P.asIdeal
      = Ideal.comap (algebraMap (nodeRing k) (Polynomial k)) Q.asIdeal :=
    congrArg PrimeSpectrum.asIdeal h
  have key : ∀ (f : Polynomial k) (I : Ideal (Polynomial k)),
      ((X : Polynomial k) * (X - 1) * f ∈ I) ↔
        (⟨(X : Polynomial k) * (X - 1) * f, mul_mem_nodeRing k f⟩ : nodeRing k)
          ∈ Ideal.comap (algebraMap (nodeRing k) (Polynomial k)) I := fun _ _ => Iff.rfl
  have hone : ∀ I : Ideal (Polynomial k),
      ((X : Polynomial k) * (X - 1) ∈ I) ↔ ((X : Polynomial k) * (X - 1) * 1 ∈ I) := by simp
  have huPQ : (X : Polynomial k) * (X - 1) ∈ P.asIdeal ↔
      (X : Polynomial k) * (X - 1) ∈ Q.asIdeal := by
    rw [hone, hone, key 1 P.asIdeal, key 1 Q.asIdeal, hcomap]
  have hmem : ∀ R : PrimeSpectrum (Polynomial k), (X : Polynomial k) * (X - 1) ∈ R.asIdeal →
      (X : Polynomial k) ∉ R.asIdeal → R.asIdeal = Ideal.span {(X - 1 : Polynomial k)} :=
    fun R hu hX => (span_singleton_eq_of_mem (isMaximal_span_X_sub_one k) R.isPrime
      ((R.isPrime.mem_or_mem hu).resolve_left hX)).symm
  have hiff : ∀ R : PrimeSpectrum (Polynomial k), (X : Polynomial k) * (X - 1) ∉ R.asIdeal →
      ∀ f, f ∈ R.asIdeal ↔ (X : Polynomial k) * (X - 1) * f ∈ R.asIdeal := fun R hu f =>
    ⟨fun hf => Ideal.mul_mem_left _ _ hf, fun hf => (R.isPrime.mem_or_mem hf).resolve_left hu⟩
  refine PrimeSpectrum.ext ?_
  by_cases hPu : (X : Polynomial k) * (X - 1) ∈ P.asIdeal
  · rw [hmem P hPu hP, hmem Q (huPQ.1 hPu) hQ]
  · ext f
    rw [hiff P hPu f, hiff Q (fun hc => hPu (huPQ.2 hc)) f, key f P.asIdeal, key f Q.asIdeal,
      hcomap]

/-- **`Spec k[s] ∖ {(s)} → Spec A` is still surjective.** -/
public theorem comap_nodeRingSubtype_image_eq_univ :
    comap (algebraMap (nodeRing k) (Polynomial k)) ''
      {P : PrimeSpectrum (Polynomial k) | (X : Polynomial k) ∉ P.asIdeal} = Set.univ := by
  refine Set.eq_univ_of_forall fun p => ?_
  obtain ⟨P, hP⟩ := comap_nodeRingSubtype_surjective k p
  by_cases hX : (X : Polynomial k) ∈ P.asIdeal
  · have eP := span_singleton_eq_of_mem (isMaximal_span_X k) P.isPrime hX
    refine ⟨⟨Ideal.span {(X - 1 : Polynomial k)}, (isMaximal_span_X_sub_one k).isPrime⟩, ?_, ?_⟩
    · intro hc
      rw [mem_span_X_sub_one_iff] at hc
      simp at hc
    · rw [← hP]
      refine PrimeSpectrum.ext ?_
      show Ideal.comap _ (Ideal.span {(X - 1 : Polynomial k)}) = Ideal.comap _ P.asIdeal
      rw [← eP, comap_span_X_eq_comap_span_X_sub_one]
  · exact ⟨P, hX, hP⟩

/-- **The image in `Spec A` of a closed subset of `Spec k[s] ∖ {(s)}` is closed.** For a closed
subset `Z` of `Spec k[s]`, the image in `Spec A` of the primes of `Z` not containing `s` is
closed. -/
public theorem isClosed_comap_nodeRingSubtype_image_inter
    (Z : Set (PrimeSpectrum (Polynomial k))) (hZ : IsClosed Z) :
    IsClosed (comap (algebraMap (nodeRing k) (Polynomial k)) ''
      (Z ∩ {P : PrimeSpectrum (Polynomial k) | (X : Polynomial k) ∉ P.asIdeal})) := by
  obtain ⟨J, rfl⟩ := (isClosed_iff_zeroLocus_ideal Z).1 hZ
  obtain ⟨h, hJ⟩ : ∃ h, J = Ideal.span {h} :=
    ⟨Submodule.IsPrincipal.generator J, (Submodule.IsPrincipal.span_singleton_generator J).symm⟩
  by_cases hh : h = 0
  · have hu : zeroLocus (J : Set (Polynomial k)) = Set.univ := by
      subst hJ; subst hh; simp
    rw [hu, Set.univ_inter, comap_nodeRingSubtype_image_eq_univ]
    exact isClosed_univ
  · obtain ⟨h', hfac, hndvd⟩ := exists_eq_pow_rootMultiplicity_mul_and_not_dvd h hh (0 : k)
    rw [show (X - C (0 : k)) = (X : Polynomial k) from by simp] at hfac hndvd
    have hset : zeroLocus (J : Set (Polynomial k))
        ∩ {P : PrimeSpectrum (Polynomial k) | (X : Polynomial k) ∉ P.asIdeal}
        = zeroLocus {h'} := by
      ext P
      simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, mem_zeroLocus, Set.singleton_subset_iff]
      constructor
      · rintro ⟨hPJ, hPX⟩
        have hhP : h ∈ P.asIdeal := hPJ (by rw [hJ]; exact Ideal.mem_span_singleton_self h)
        rw [hfac] at hhP
        rcases P.isPrime.mem_or_mem hhP with hc | hc
        · exact absurd (P.isPrime.mem_of_pow_mem _ hc) hPX
        · exact hc
      · intro hh'
        have hhP : h ∈ P.asIdeal := by rw [hfac]; exact Ideal.mul_mem_left _ _ hh'
        refine ⟨?_, ?_⟩
        · rw [hJ]
          exact Ideal.span_le.2 (Set.singleton_subset_iff.2 hhP)
        · intro hX
          have eP := span_singleton_eq_of_mem (isMaximal_span_X k) P.isPrime hX
          rw [← eP, SetLike.mem_coe, mem_span_X_iff] at hh'
          exact hndvd (by rwa [X_dvd_iff, coeff_zero_eq_eval_zero])
    rw [hset]
    exact isClosedMap_comap_of_isIntegral _ (isIntegral_nodeRingSubtype k) _
      (isClosed_zeroLocus _)

/-- **`Spec B → Spec A` is a closed embedding**, where `B = k[s, 1/s]`.

The map is in fact a homeomorphism onto all of `Spec A`, by
`Stacks.NodalCurve.comap_nodeRingSubtype_image_eq_univ`; no closed subset is left over. -/
public theorem isClosedEmbedding_comap_localizationAway :
    Topology.IsClosedEmbedding
      (comap (algebraMap (nodeRing k) (Localization.Away (X : Polynomial k)))) := by
  have hcomp : algebraMap (nodeRing k) (Localization.Away (X : Polynomial k))
      = (algebraMap (Polynomial k) (Localization.Away (X : Polynomial k))).comp
          (algebraMap (nodeRing k) (Polynomial k)) :=
    IsScalarTower.algebraMap_eq _ _ _
  have hrange : Set.range
      (comap (algebraMap (Polynomial k) (Localization.Away (X : Polynomial k))))
      = {P : PrimeSpectrum (Polynomial k) | (X : Polynomial k) ∉ P.asIdeal} := by
    rw [localization_away_comap_range (Localization.Away (X : Polynomial k)) (X : Polynomial k)]
    ext P
    simp
  have hemb : Topology.IsOpenEmbedding
      (comap (algebraMap (Polynomial k) (Localization.Away (X : Polynomial k)))) :=
    localization_away_isOpenEmbedding (Localization.Away (X : Polynomial k)) (X : Polynomial k)
  rw [hcomp, comap_comp]
  refine Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap
    ((continuous_comap _).comp (continuous_comap _)) ?_ ?_
  · intro a b hab
    exact hemb.injective (comap_nodeRingSubtype_injOn k (hrange ▸ Set.mem_range_self a)
      (hrange ▸ Set.mem_range_self b) hab)
  · intro C hC
    obtain ⟨Z, hZ, hZpre⟩ := hemb.isInducing.isClosed_iff.1 hC
    rw [Set.image_comp, ← hZpre, Set.image_preimage_eq_inter_range, hrange]
    exact isClosed_comap_nodeRingSubtype_image_inter k Z hZ

end Stacks.NodalCurve

end
