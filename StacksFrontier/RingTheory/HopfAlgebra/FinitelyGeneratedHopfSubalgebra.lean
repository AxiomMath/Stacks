module

public import Mathlib.RingTheory.Bialgebra.TensorProduct
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.HopfAlgebra.Convolution
