/-!
# Commutative Hopf algebras over a field are unions of finitely generated Hopf subalgebras

Let `k` be a field and `A` a commutative Hopf algebra over `k`.  Every element of `A` lies in a
finitely generated subalgebra `B` which is stable under the comultiplication and the antipode,
and such a `B` is itself a Hopf algebra with `B → A` a map of bialgebras.  So `A` is the
directed union of its finitely generated Hopf subalgebras; geometrically, an affine group scheme
over a field is the cofiltered limit of affine algebraic groups.

## Main results

* `HopfAlgebra.antipode_antipode_of_comm`: in a commutative Hopf algebra `S ∘ S = id`.
* `HopfAlgebra.comul_antipode_of_comm`: in a commutative Hopf algebra
  `Δ (S a) = (S ⊗ S) (τ (Δ a))`, `τ` the flip.
* `Subalgebra.hopfAlgebraOfComulMem`: a subalgebra of a Hopf algebra over a field stable under
  the comultiplication and the antipode is a Hopf algebra.
* `HopfAlgebra.exists_fg_hopfSubalgebra_mem`: every element of a commutative Hopf algebra over a
  field lies in a finitely generated subalgebra stable under comultiplication and antipode.
* `HopfAlgebra.exists_finiteType_hopfAlgebra_mem_range`: the same with the Hopf structure:
  every element lies in the image of an injective bialgebra map from a finitely generated
  Hopf algebra.

## Implementation notes

The two identities for the antipode come from the convolution group of algebra maps
`A → C` into a commutative algebra `C`, where the inverse of `f` is `f ∘ S`
(`AlgHom.convGroup`).  For `S ∘ S` this is `(id⁻¹)⁻¹ = id`.  For `Δ ∘ S`, the comultiplication
is the convolution product of the two inclusions `ι₁ ι₂ : A → A ⊗ A`, so
`Δ ∘ S = Δ⁻¹ = ι₂⁻¹ * ι₁⁻¹`, which is `a ↦ ∑ S a₂ ⊗ S a₁`.

The Hopf subalgebra containing `x` is generated by a finite spanning set `s` of a
finite-dimensional subcoalgebra `D ∋ x` (`Coalgebra.exists_finiteDimensional_subcoalgebra_mem`)
together with its image under the antipode.  The comultiplication of `B` is that of `A`
transported along the inclusion `B ⊗ B → A ⊗ A`, which is injective because every module over
a field is flat; all the axioms are checked after this injection.

## References

* W. C. Waterhouse, *Introduction to affine group schemes*, Theorem 3.3.
-/

@[expose] public section

open TensorProduct Coalgebra WithConv

universe u

namespace HopfAlgebra

section Comm

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [HopfAlgebra R A]

private lemma convInv_apply {C : Type*} [CommSemiring C] [Bialgebra R C]
    (f : WithConv (A →ₐ[R] C)) (a : A) : (f⁻¹).ofConv a = f.ofConv (antipode R a) := rfl

/-- In a commutative Hopf algebra the antipode is an involution. -/
theorem antipode_antipode_of_comm (a : A) : antipode R (antipode R a) = a :=
  congrArg (fun f => f.ofConv a) (inv_inv (toConv (AlgHom.id R A)))

/-- In a commutative Hopf algebra the antipode is an anti-coalgebra map:
`Δ (S a) = (S ⊗ S) (τ (Δ a))`. -/
theorem comul_antipode_of_comm (a : A) :
    comul (R := R) (antipode R a) =
      TensorProduct.map (antipode R) (antipode R)
        (TensorProduct.comm R A A (comul (R := R) a)) := by
  have hΔ : toConv (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := A)) *
      toConv (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A)) =
      toConv (Bialgebra.comulAlgHom R A) := by
    apply WithConv.ofConv_injective
    ext a
    rw [AlgHom.convMul_apply, Algebra.TensorProduct.lift_includeLeft_includeRight]
    rfl
  have h : (toConv (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A)))⁻¹ *
      (toConv (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := A) (B := A)))⁻¹ =
      (toConv (Bialgebra.comulAlgHom R A))⁻¹ := by
    rw [← mul_inv_rev, hΔ]
  have h2 := congrArg (fun f => f.ofConv a) h
  simp only [convInv_apply] at h2
  change _ = comul (R := R) (antipode R a) at h2
  rw [← h2, AlgHom.convMul_apply]
  generalize comul (R := R) a = t
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul x y => simp [convInv_apply]
  | add s t hs ht => simp only [map_add, hs, ht]

end Comm

end HopfAlgebra

namespace Subalgebra

variable {k A : Type*} [Field k] [Ring A] [HopfAlgebra k A] (B : Subalgebra k A)
  (hΔ : ∀ b ∈ B, comul (R := k) b ∈ (Algebra.TensorProduct.map B.val B.val).range)
  (hS : ∀ b ∈ B, HopfAlgebra.antipode k b ∈ B)

/-- The inclusion `B ⊗ B → A ⊗ A` of a subalgebra over a field is injective. -/
theorem injective_tensorProductMap_val :
    Function.Injective (Algebra.TensorProduct.map B.val B.val) :=
  TensorProduct.map_injective_of_flat_flat B.val.toLinearMap B.val.toLinearMap
    Subtype.val_injective Subtype.val_injective

/-- The comultiplication of a subalgebra stable under the comultiplication. -/
noncomputable def comulOfMem : B →ₗ[k] B ⊗[k] B :=
  (LinearEquiv.ofInjective (Algebra.TensorProduct.map B.val B.val).toLinearMap
      B.injective_tensorProductMap_val).symm.toLinearMap ∘ₗ
    (comul (R := k) ∘ₗ B.val.toLinearMap).codRestrict _ fun b => by
      obtain ⟨y, hy⟩ := hΔ b b.2
      exact ⟨y, hy⟩

/-- The comultiplication of `B` is that of `A` along the inclusion `B ⊗ B → A ⊗ A`. -/
theorem map_comulOfMem (b : B) :
    Algebra.TensorProduct.map B.val B.val (B.comulOfMem hΔ b) = comul (R := k) (b : A) :=
  congrArg Subtype.val <| LinearEquiv.apply_symm_apply (LinearEquiv.ofInjective _
    B.injective_tensorProductMap_val) _

private lemma map_assoc_rTensor (t : B ⊗[k] B) :
    TensorProduct.map B.val.toLinearMap
        (TensorProduct.map B.val.toLinearMap B.val.toLinearMap)
        (TensorProduct.assoc k B B B ((B.comulOfMem hΔ).rTensor B t)) =
      TensorProduct.assoc k A A A ((comul (R := k)).rTensor A
        (Algebra.TensorProduct.map B.val B.val t)) := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul x y =>
    simp only [LinearMap.rTensor_tmul, Algebra.TensorProduct.map_tmul, Subalgebra.coe_val]
    rw [← B.map_comulOfMem hΔ x]
    generalize B.comulOfMem hΔ x = s
    induction s using TensorProduct.induction_on with
    | zero => simp
    | tmul p q => simp
    | add s s' hs hs' => simp only [add_tmul, map_add, hs, hs']
  | add s t hs ht => simp only [map_add, hs, ht]

private lemma map_lTensor (t : B ⊗[k] B) :
    TensorProduct.map B.val.toLinearMap
        (TensorProduct.map B.val.toLinearMap B.val.toLinearMap)
        ((B.comulOfMem hΔ).lTensor B t) =
      (comul (R := k)).lTensor A (Algebra.TensorProduct.map B.val B.val t) := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul x y =>
    simp only [LinearMap.lTensor_tmul, Algebra.TensorProduct.map_tmul, TensorProduct.map_tmul,
      Subalgebra.coe_val]
    rw [← B.map_comulOfMem hΔ y]
    rfl
  | add s t hs ht => simp only [map_add, hs, ht]

/-- A subalgebra of a Hopf algebra over a field stable under the comultiplication is a
coalgebra, with the comultiplication and counit of the ambient algebra. -/
@[instance_reducible,
  sga "3 VIB 11.13" "partial"]
noncomputable def coalgebraOfComulMem : Coalgebra k B where
  comul := B.comulOfMem hΔ
  counit := counit (R := k) ∘ₗ B.val.toLinearMap
  coassoc := by
    ext b
    apply TensorProduct.map_injective_of_flat_flat B.val.toLinearMap
      (TensorProduct.map B.val.toLinearMap B.val.toLinearMap) Subtype.val_injective
      B.injective_tensorProductMap_val
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply]
    rw [map_assoc_rTensor, map_lTensor, map_comulOfMem]
    exact coassoc_apply _
  rTensor_counit_comp_comul := by
    ext b
    apply Module.Flat.lTensor_preserves_injective_linearMap (M := k) B.val.toLinearMap
      Subtype.val_injective
    simp only [LinearMap.coe_comp, Function.comp_apply, TensorProduct.mk_apply,
      LinearMap.lTensor_tmul]
    change _ = (1 : k) ⊗ₜ[k] (b : A)
    rw [← rTensor_counit_comul (R := k) (b : A), ← B.map_comulOfMem hΔ b]
    generalize B.comulOfMem hΔ b = t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul p q => simp
    | add s t hs ht => simp only [map_add, hs, ht]
  lTensor_counit_comp_comul := by
    ext b
    apply Module.Flat.rTensor_preserves_injective_linearMap (M := k) B.val.toLinearMap
      Subtype.val_injective
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.flip_apply,
      TensorProduct.mk_apply, LinearMap.rTensor_tmul]
    change _ = (b : A) ⊗ₜ[k] (1 : k)
    rw [← lTensor_counit_comul (R := k) (b : A), ← B.map_comulOfMem hΔ b]
    generalize B.comulOfMem hΔ b = t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul p q => simp
    | add s t hs ht => simp only [map_add, hs, ht]

/-- A subalgebra of a Hopf algebra over a field stable under the comultiplication and the
antipode is a Hopf algebra, with the structure maps of the ambient Hopf algebra. -/
@[instance_reducible,
  sga "3 VIB 11.13"]
noncomputable def hopfAlgebraOfComulMem : HopfAlgebra k B :=
  letI := B.coalgebraOfComulMem hΔ
  letI : Bialgebra k B := Bialgebra.mk' k B
    (by
      change counit (R := k) ((1 : B) : A) = 1
      simp)
    (fun {a b} => by
      change counit (R := k) ((a * b : B) : A) = counit (R := k) (a : A) * counit (R := k) (b : A)
      simp)
    (by
      change B.comulOfMem hΔ 1 = 1
      apply B.injective_tensorProductMap_val
      rw [map_comulOfMem, map_one]
      simp)
    (fun {a b} => by
      change B.comulOfMem hΔ (a * b) = B.comulOfMem hΔ a * B.comulOfMem hΔ b
      apply B.injective_tensorProductMap_val
      rw [map_comulOfMem, map_mul, map_comulOfMem, map_comulOfMem]
      simp)
  { antipode :=
      { toFun := fun b => ⟨HopfAlgebra.antipode k (b : A), hS b b.2⟩
        map_add' := fun a b => Subtype.ext (map_add _ _ _)
        map_smul' := fun r a => Subtype.ext (map_smul _ _ _) }
    mul_antipode_rTensor_comul := by
      ext b
      change ((LinearMap.mul' k B) (LinearMap.rTensor B _ (B.comulOfMem hΔ b)) : A) =
        algebraMap k A (counit (R := k) (b : A))
      rw [← HopfAlgebra.mul_antipode_rTensor_comul_apply (R := k) (b : A),
        ← B.map_comulOfMem hΔ b]
      generalize B.comulOfMem hΔ b = t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul p q => simp
      | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
    mul_antipode_lTensor_comul := by
      ext b
      change ((LinearMap.mul' k B) (LinearMap.lTensor B _ (B.comulOfMem hΔ b)) : A) =
        algebraMap k A (counit (R := k) (b : A))
      rw [← HopfAlgebra.mul_antipode_lTensor_comul_apply (R := k) (b : A),
        ← B.map_comulOfMem hΔ b]
      generalize B.comulOfMem hΔ b = t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul p q => simp
      | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht] }

end Subalgebra

/-- The inclusion of a subalgebra stable under comultiplication and antipode, as a map of
bialgebras for the structure `Subalgebra.hopfAlgebraOfComulMem`. -/
noncomputable def Subalgebra.valBialgHom {k A : Type*} [Field k] [Ring A] [HopfAlgebra k A]
    (B : Subalgebra k A)
    (hΔ : ∀ b ∈ B, comul (R := k) b ∈ (Algebra.TensorProduct.map B.val B.val).range)
    (hS : ∀ b ∈ B, HopfAlgebra.antipode k b ∈ B) :
    letI := B.hopfAlgebraOfComulMem hΔ hS
    B →ₐc[k] A :=
  letI := B.hopfAlgebraOfComulMem hΔ hS
  BialgHom.ofAlgHom B.val (AlgHom.ext fun _ => rfl)
    (AlgHom.ext fun b => B.map_comulOfMem hΔ b)

namespace HopfAlgebra

variable {k A : Type*} [Field k] [CommRing A] [HopfAlgebra k A]

/-- If a subspace `D` of a commutative Hopf algebra is a subcoalgebra and `D` and its image under
the antipode lie in a subalgebra `B`, then `Δ d` and `Δ (S d)` lie in `B ⊗ B` for `d ∈ D`. -/
theorem comul_mem_range_of_subcoalgebra {B : Subalgebra k A} {D : Submodule k A}
    (hD : ∀ d ∈ D, comul (R := k) d ∈ LinearMap.range (TensorProduct.map D.subtype D.subtype))
    (hDB : ∀ d ∈ D, d ∈ B ∧ antipode k d ∈ B) {d : A} (hd : d ∈ D) :
    comul (R := k) d ∈ (Algebra.TensorProduct.map B.val B.val).range ∧
      comul (R := k) (antipode k d) ∈ (Algebra.TensorProduct.map B.val B.val).range := by
  let ι : D →ₗ[k] B :=
    { toFun := fun d => ⟨d, (hDB d d.2).1⟩, map_add' := fun _ _ => rfl,
      map_smul' := fun _ _ => rfl }
  let ιS : D →ₗ[k] B :=
    { toFun := fun d => ⟨antipode k (d : A), (hDB d d.2).2⟩
      map_add' := fun _ _ => Subtype.ext (map_add _ _ _)
      map_smul' := fun _ _ => Subtype.ext (map_smul _ _ _) }
  let J := Algebra.TensorProduct.map B.val B.val
  have hι : TensorProduct.map D.subtype D.subtype = J.toLinearMap ∘ₗ TensorProduct.map ι ι := by
    ext; rfl
  have hιS : TensorProduct.map (antipode k) (antipode k) ∘ₗ TensorProduct.comm k A A ∘ₗ
      TensorProduct.map D.subtype D.subtype =
      J.toLinearMap ∘ₗ TensorProduct.map ιS ιS ∘ₗ TensorProduct.comm k D D := by
    ext; rfl
  obtain ⟨u, hu⟩ := hD d hd
  refine ⟨⟨TensorProduct.map ι ι u, ?_⟩,
    ⟨TensorProduct.map ιS ιS (TensorProduct.comm k D D u), ?_⟩⟩
  · rw [← hu]
    exact (LinearMap.congr_fun hι u).symm
  · rw [comul_antipode_of_comm, ← hu]
    exact (LinearMap.congr_fun hιS u).symm

/-- **Waterhouse 3.3.**  Every element of a commutative Hopf algebra over a field lies in a
finitely generated subalgebra stable under the comultiplication and the antipode. -/
@[sga "3 VIB 11.12", sga "3 VIB 11.13" "partial"]
theorem exists_fg_hopfSubalgebra_mem (x : A) :
    ∃ B : Subalgebra k A, B.FG ∧ x ∈ B ∧
      (∀ b ∈ B, comul (R := k) b ∈ (Algebra.TensorProduct.map B.val B.val).range) ∧
      ∀ b ∈ B, antipode k b ∈ B := by
  classical
  obtain ⟨D, hDfin, hxD, hD⟩ := Coalgebra.exists_finiteDimensional_subcoalgebra_mem (k := k) x
  obtain ⟨s, hs⟩ := (Submodule.fg_iff_finiteDimensional D).mpr hDfin
  let t : Finset A := s ∪ s.image (antipode k)
  let B := Algebra.adjoin k (t : Set A)
  have hsB : ∀ a ∈ s, a ∈ B := fun a ha => Algebra.subset_adjoin (Finset.mem_union_left _ ha)
  have hSsB : ∀ a ∈ s, antipode k a ∈ B := fun a ha =>
    Algebra.subset_adjoin (Finset.mem_union_right _ (Finset.mem_image_of_mem _ ha))
  have hDB : ∀ d ∈ D, d ∈ B ∧ antipode k d ∈ B := by
    intro d hd
    rw [← hs] at hd
    induction hd using Submodule.span_induction with
    | mem a ha => exact ⟨hsB a ha, hSsB a ha⟩
    | zero => simp
    | add a b _ _ ha hb =>
      exact ⟨add_mem ha.1 hb.1, by simpa only [map_add] using add_mem ha.2 hb.2⟩
    | smul r a _ ha => exact ⟨B.smul_mem ha.1 r, by simpa only [map_smul] using B.smul_mem ha.2 r⟩
  refine ⟨B, ⟨t, rfl⟩, (hDB x hxD).1, ?_, ?_⟩
  · suffices h : B ≤ (Algebra.TensorProduct.map B.val B.val).range.comap
        (Bialgebra.comulAlgHom k A) from fun b hb => h hb
    refine Algebra.adjoin_le fun a ha => ?_
    simp only [t, Finset.coe_union, Finset.coe_image, Set.mem_union, Finset.mem_coe,
      Set.mem_image] at ha
    change comul (R := k) a ∈ (Algebra.TensorProduct.map B.val B.val).range
    rcases ha with ha | ⟨d, hd, rfl⟩
    · exact (comul_mem_range_of_subcoalgebra hD hDB (d := a) (hs ▸ Submodule.subset_span ha)).1
    · exact (comul_mem_range_of_subcoalgebra hD hDB (d := d) (hs ▸ Submodule.subset_span hd)).2
  · suffices h : B ≤ B.comap (antipodeAlgHom k A) from fun b hb => h hb
    refine Algebra.adjoin_le fun a ha => ?_
    simp only [t, Finset.coe_union, Finset.coe_image, Set.mem_union, Finset.mem_coe,
      Set.mem_image] at ha
    change antipode k a ∈ B
    rcases ha with ha | ⟨d, hd, rfl⟩
    · exact hSsB a ha
    · rw [antipode_antipode_of_comm]
      exact hsB d hd

/-- **Waterhouse 3.3**, with the Hopf structure.  Every element of a commutative Hopf algebra
`A` over a field `k` lies in the image of an injective map of bialgebras `B → A` from a finitely
generated commutative Hopf algebra `B` over `k`. -/
@[sga "3 VIB 11.12", sga "3 VIB 13.2" "(ii)"]
theorem exists_finiteType_hopfAlgebra_mem_range {A : Type u} [CommRing A] [HopfAlgebra k A]
    (x : A) :
    ∃ (B : Type u) (_ : CommRing B) (_ : HopfAlgebra k B) (φ : B →ₐc[k] A),
      Function.Injective φ ∧ Algebra.FiniteType k B ∧ x ∈ (φ : B →ₐ[k] A).range := by
  obtain ⟨B, hfg, hx, hΔ, hS⟩ := exists_fg_hopfSubalgebra_mem (k := k) x
  let := B.hopfAlgebraOfComulMem hΔ hS
  exact ⟨B, inferInstance, inferInstance, B.valBialgHom hΔ hS, Subtype.val_injective,
    B.fg_iff_finiteType.mp hfg, ⟨⟨x, hx⟩, rfl⟩⟩

end HopfAlgebra
