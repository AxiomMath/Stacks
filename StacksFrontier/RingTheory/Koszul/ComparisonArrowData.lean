module

public import StacksFrontier.Algebra.DifferentialGraded.TensorProductGradedCommutative
public import StacksFrontier.Algebra.DifferentialGraded.TensorProductHomPair
public import StacksFrontier.RingTheory.Koszul.AppendTransition
public import StacksFrontier.RingTheory.Koszul.ComparisonTower

/-!
# The comparison data of Tag 0GZ7, and its behaviour under concatenation

Let `f₁, …, f_r` be elements of a commutative ring `R` and let `N ≥ n ≥ t ≥ 1`. The proof of Tag
0GZ7 produces, for the sequence `f`, a differential graded algebra `B` together with

* a homomorphism `ε : B → K_t` carrying a homotopy retraction, so a quasi-isomorphism;
* a homomorphism `κ : K_N → B` with `ε ∘ κ = τ_{N,t}`, which makes `B` a differential graded
  `K_N`-algebra and `ε` a homomorphism of differential graded `K_N`-modules;
* a homomorphism `ξ : K_t → B` with `ε ∘ ξ = id`, the "`x_i ↦ x_i`" map, which is *not*
  `K_N`-linear;
* a homomorphism `β : B → K_n ⊗_R K_t` with `μ_n ∘ β = ε`,
  `β ∘ κ = ι_1 ∘ τ_{N,n}` and `β ∘ ξ = ι_2`.

The images of `κ` and `ξ` lie in a graded-commutative subalgebra — the "odd part" `R⟨x_i, z_i⟩`
of `B` — so the universal property of the tensor product applies to them and produces
$$\gamma : K_N \otimes_R K_t \longrightarrow B, \qquad
  \varepsilon \circ \gamma = \mu_N, \qquad \beta \circ \gamma = \tau_{N,n} \otimes
  \mathrm{id}.$$
That is the shortcut which makes the second of the two composites of Tag 0GZ7 cost two
generator checks rather than a second resolution: `γ` is recorded here as the derived datum
`Koszul.KoszulArrowData.gamma`, and the two identities above as
`Koszul.KoszulArrowData.eps_gamma` and `Koszul.KoszulArrowData.beta_gamma`.

The data is closed under concatenation of sequences: given data for `g` and for `h`, the tensor
product of the two carriers, with the Koszul algebra of the concatenation identified with the
tensor product of the two Koszul algebras by Tag 0664, carries data for `Fin.append g h`. The
one genuinely new ingredient is that the append isomorphism commutes with the transition
homomorphisms, which is
`Koszul.powAppendFromTensor_powTensorTransition`.

## Main definitions

* `Koszul.KoszulArrowData`: the data above, for a sequence and exponents `N ≥ n ≥ t ≥ 1`.
* `Koszul.KoszulArrowData.kappa`, `Koszul.KoszulArrowData.xi`,
  `Koszul.KoszulArrowData.gamma`: the three derived homomorphisms.
* `Koszul.KoszulArrowData.append`: the data of a concatenated sequence.
* `Koszul.koszulArrowDataEmpty`: the data of the empty sequence.

## Main results

* `Koszul.KoszulArrowData.eps_gamma` and `Koszul.KoszulArrowData.beta_gamma`: the two identities
  satisfied by `γ`.

## References

* [Stacks Project, Tag 0GZ7](https://stacks.math.columbia.edu/tag/0GZ7)
* [Stacks Project, Tag 0664](https://stacks.math.columbia.edu/tag/0664)
-/

@[expose] public noncomputable section

namespace Koszul

universe u

open scoped ExteriorAlgebra TensorProduct

open DifferentialGradedAlgebra DividedPowers.TateResolution

variable {R : Type u} [CommRing R]

section GradedCommutative

variable {r : ℕ}

/-- **The Koszul algebra of a functional is graded commutative.** It is an exterior algebra,
read in the cohomological grading, which does not change the Koszul sign. -/
theorem isGradedCommutative_cohomological (E : Type u) [AddCommGroup E] [Module R E]
    (φ : Module.Dual R E) :
    DifferentialGraded.IsGradedCommutative
      (cohomologicalDifferentialGradedAlgebra R E φ).grading := by
  rw [DifferentialGraded.isGradedCommutative_int_iff]
  intro i j x y hx hy
  refine (cohomological_mul_comm R E hx hy).trans ?_
  rw [Units.smul_def, ← Int.negOnePow_def, mul_comm j i]
  rfl

/-- The Koszul algebra `K_m` of a sequence is graded commutative. -/
theorem isGradedCommutative_powAlgebra (f : Fin r → R) (m : ℕ) :
    DifferentialGraded.IsGradedCommutative (powAlgebra f m).grading :=
  isGradedCommutative_cohomological (Fin r → R) (seqDual fun i => f i ^ m)

/-- The tensor product `K_n ⊗_R K_t` of two Koszul algebras of a sequence is graded
commutative. -/
theorem isGradedCommutative_powTensor (f : Fin r → R) (n t : ℕ) :
    DifferentialGraded.IsGradedCommutative
      (tensorProduct (powAlgebra f n) (powAlgebra f t)).grading :=
  isGradedCommutative_tensorProduct _ _ (isGradedCommutative_powAlgebra f n)
    (isGradedCommutative_powAlgebra f t)

/-- Any two algebra homomorphisms out of the Koszul algebra of the empty sequence agree: that
algebra is generated by the zero module. -/
theorem algHom_ext_of_isEmpty {f : Fin 0 → R} {m : ℕ} {E : Type u} [Semiring E] [Algebra R E]
    (u v : (powAlgebra f m).A →ₐ[R] E) : u = v := by
  have key : (ExteriorAlgebra.ι R : (Fin 0 → R) →ₗ[R] ExteriorAlgebra R (Fin 0 → R)) = 0 := by
    refine LinearMap.ext fun w => ?_
    rw [Subsingleton.elim w (0 : Fin 0 → R), map_zero, LinearMap.zero_apply]
  refine ExteriorAlgebra.hom_ext ?_
  rw [key, LinearMap.comp_zero, LinearMap.comp_zero]

end GradedCommutative

section Data

variable {r : ℕ}

/-- **The comparison data of Tag 0GZ7** for a sequence `f₁, …, f_r` and exponents
`N ≥ n ≥ t ≥ 1`: a differential graded algebra `B` with a homotopy retraction onto `K_t`, a
graded-commutative "odd part" carrying the two structure maps out of `K_N` and `K_t`, and the
arrow `β : B → K_n ⊗_R K_t`. -/
structure KoszulArrowData (f : Fin r → R) (n t N : ℕ) (ht : 1 ≤ t) (htn : t ≤ n)
    (hnN : n ≤ N) where
  /-- The comparison algebra `B`. -/
  carrier : DifferentialGradedAlgebra.{u, u} R
  /-- The quasi-isomorphism `ε : B → K_t`. -/
  eps : carrier.Hom (powAlgebra f t)
  /-- A homotopy retraction of `ε`. -/
  retract : HomotopyRetract eps
  /-- The graded-commutative odd part of `B`. -/
  odd : DifferentialGradedAlgebra.{u, u} R
  /-- The odd part is graded commutative. -/
  oddComm : DifferentialGraded.IsGradedCommutative odd.grading
  /-- The inclusion of the odd part into `B`. -/
  oddHom : odd.Hom carrier
  /-- The structure map `K_N → B`, factored through the odd part. -/
  kappaOdd : (powAlgebra f N).Hom odd
  /-- The section `K_t → B` on generators, factored through the odd part. -/
  xiOdd : (powAlgebra f t).Hom odd
  /-- The arrow `β : B → K_n ⊗_R K_t`. -/
  beta : carrier.Hom (tensorProduct (powAlgebra f n) (powAlgebra f t))
  /-- `ε ∘ κ` is the transition homomorphism `τ_{N,t}`. -/
  eps_kappa : (eps.comp (oddHom.comp kappaOdd)).toAlgebraHom =
    (powTransition f ht (htn.trans hnN)).toAlgebraHom
  /-- `ε ∘ ξ` is the identity of `K_t`. -/
  eps_xi : (eps.comp (oddHom.comp xiOdd)).toAlgebraHom = AlgHom.id R (powAlgebra f t).A
  /-- `μ_n ∘ β` is `ε`. -/
  mul_beta : ((powMul f ht htn).comp beta).toAlgebraHom = eps.toAlgebraHom
  /-- `β ∘ κ` is the first inclusion after the transition homomorphism `τ_{N,n}`. -/
  beta_kappa : (beta.comp (oddHom.comp kappaOdd)).toAlgebraHom =
    (GradedTensorProduct.includeLeft (powAlgebra f n).grading (powAlgebra f t).grading).comp
      (powTransition f (ht.trans htn) hnN).toAlgebraHom
  /-- `β ∘ ξ` is the second inclusion. -/
  beta_xi : (beta.comp (oddHom.comp xiOdd)).toAlgebraHom =
    GradedTensorProduct.includeRight (powAlgebra f n).grading (powAlgebra f t).grading

namespace KoszulArrowData

variable {f : Fin r → R} {n t N : ℕ} {ht : 1 ≤ t} {htn : t ≤ n} {hnN : n ≤ N}
  (D : KoszulArrowData f n t N ht htn hnN)

/-- The structure map `κ : K_N → B`. -/
def kappa : (powAlgebra f N).Hom D.carrier := D.oddHom.comp D.kappaOdd

/-- The section `ξ : K_t → B` on generators. -/
def xi : (powAlgebra f t).Hom D.carrier := D.oddHom.comp D.xiOdd

/-- **The arrow `γ : K_N ⊗_R K_t → B`**, obtained from `κ` and `ξ` by the universal property of
the tensor product: their images lie in the graded-commutative odd part of `B`, so they
Koszul-anticommute. -/
def gamma : (tensorProduct (powAlgebra f N) (powAlgebra f t)).Hom D.carrier :=
  D.oddHom.comp
    (tensorLift (anticommutesAlong_of_isGradedCommutative D.oddComm D.kappaOdd D.xiOdd))

/-- `γ` restricts to `κ` on the first factor. -/
theorem gamma_includeLeft (a : (powAlgebra f N).A) :
    D.gamma.toAlgebraHom
        (GradedTensorProduct.includeLeft (powAlgebra f N).grading (powAlgebra f t).grading a) =
      D.kappa.toAlgebraHom a := by
  change D.oddHom.toAlgebraHom (tensorLiftAlgebraHom
    (anticommutesAlong_of_isGradedCommutative D.oddComm D.kappaOdd D.xiOdd)
    (a ᵍ⊗ₜ[R] (1 : (powAlgebra f t).A) :
      (powAlgebra f N).grading ᵍ⊗[R] (powAlgebra f t).grading)) = _
  rw [tensorLiftAlgebraHom_tmul, map_one, mul_one]
  rfl

/-- `γ` restricts to `ξ` on the second factor. -/
theorem gamma_includeRight (b : (powAlgebra f t).A) :
    D.gamma.toAlgebraHom
        (GradedTensorProduct.includeRight (powAlgebra f N).grading (powAlgebra f t).grading b) =
      D.xi.toAlgebraHom b := by
  change D.oddHom.toAlgebraHom (tensorLiftAlgebraHom
    (anticommutesAlong_of_isGradedCommutative D.oddComm D.kappaOdd D.xiOdd)
    ((1 : (powAlgebra f N).A) ᵍ⊗ₜ[R] b :
      (powAlgebra f N).grading ᵍ⊗[R] (powAlgebra f t).grading)) = _
  rw [tensorLiftAlgebraHom_tmul, map_one, one_mul]
  rfl

/-- A homomorphism `Φ : K_N ⊗_R K_t → X` equals `θ ∘ γ` once the two agree on both factors. -/
private theorem comp_gamma_eq {X : DifferentialGradedAlgebra.{u, u} R} (θ : D.carrier.Hom X)
    (Φ : (tensorProduct (powAlgebra f N) (powAlgebra f t)).Hom X)
    (hκ : ∀ a, θ.toAlgebraHom (D.kappa.toAlgebraHom a) = Φ.toAlgebraHom
      (GradedTensorProduct.includeLeft (powAlgebra f N).grading (powAlgebra f t).grading a))
    (hξ : ∀ b, θ.toAlgebraHom (D.xi.toAlgebraHom b) = Φ.toAlgebraHom
      (GradedTensorProduct.includeRight (powAlgebra f N).grading (powAlgebra f t).grading b)) :
    (θ.comp D.gamma).toAlgebraHom = Φ.toAlgebraHom := by
  refine GradedTensorProduct.algHom_ext (powAlgebra f N).grading (powAlgebra f t).grading
    (AlgHom.ext fun a => ?_) (AlgHom.ext fun b => ?_)
  · exact (congrArg θ.toAlgebraHom (D.gamma_includeLeft a)).trans (hκ a)
  · exact (congrArg θ.toAlgebraHom (D.gamma_includeRight b)).trans (hξ b)

/-- **`ε ∘ γ` is the multiplication map `μ_N : K_N ⊗_R K_t → K_t`.** -/
theorem eps_gamma :
    (D.eps.comp D.gamma).toAlgebraHom = (powMul f ht (htn.trans hnN)).toAlgebraHom := by
  refine D.comp_gamma_eq _ _ (fun a => ?_) (fun b => ?_)
  · rw [← AlgHom.comp_apply (powMul f ht (htn.trans hnN)).toAlgebraHom,
      powMul_comp_includeLeft]
    exact congrArg (fun φ => φ a) D.eps_kappa
  · rw [← AlgHom.comp_apply (powMul f ht (htn.trans hnN)).toAlgebraHom,
      powMul_comp_includeRight]
    exact congrArg (fun φ => φ b) D.eps_xi

/-- **`β ∘ γ` is `τ_{N,n} ⊗ id`.** -/
theorem beta_gamma :
    (D.beta.comp D.gamma).toAlgebraHom =
      (tensorHomLeft (powTransition f (ht.trans htn) hnN) (powAlgebra f t)).toAlgebraHom := by
  refine D.comp_gamma_eq _ _ (fun a => ?_) (fun b => ?_)
  · refine Eq.trans ?_ (tensorHomLeft_tmul _ _ a 1).symm
    exact congrArg (fun φ => φ a) D.beta_kappa
  · refine Eq.trans ?_ ((tensorHomLeft_tmul _ _ 1 b).trans (by rw [map_one])).symm
    exact congrArg (fun φ => φ b) D.beta_xi

end KoszulArrowData

end Data

section Empty

variable {n t N : ℕ} {ht : 1 ≤ t} {htn : t ≤ n} {hnN : n ≤ N}

/-- **The comparison data of the empty sequence**: the Koszul algebra of the empty sequence is
`R` itself, so every map in sight is forced and every identity is automatic. -/
def koszulArrowDataEmpty (f : Fin 0 → R) :
    KoszulArrowData f n t N ht htn hnN where
  carrier := powAlgebra f t
  eps := idHom (powAlgebra f t)
  retract := HomotopyRetract.ofInverse (idHom (powAlgebra f t)) (idHom (powAlgebra f t))
    (fun _ => rfl) (fun _ => rfl)
  odd := powAlgebra f t
  oddComm := isGradedCommutative_powAlgebra f t
  oddHom := idHom (powAlgebra f t)
  kappaOdd := powTransition f ht (htn.trans hnN)
  xiOdd := idHom (powAlgebra f t)
  beta := tensorInclRight (powAlgebra f n) (powAlgebra f t)
  eps_kappa := algHom_ext_of_isEmpty _ _
  eps_xi := algHom_ext_of_isEmpty _ _
  mul_beta := algHom_ext_of_isEmpty _ _
  beta_kappa := algHom_ext_of_isEmpty _ _
  beta_xi := algHom_ext_of_isEmpty _ _

end Empty

end Koszul
