module

public import StacksFrontier.RingTheory.Koszul.Concatenation.QuasiRegularAppend
import all StacksFrontier.RingTheory.Koszul.Concatenation.QuasiRegularAppend

@[expose] public section

-- The comparison maps below are assembled from `ModuleCat` quotients, `total` complexes and
-- `extend`/`restriction` wrappers, and the `rw`/`erw`/`change` steps that identify their
-- components unfold those wrappers through reducible-transparency defeq.
set_option backward.isDefEq.respectTransparency false

/-! # Independence of the generators

This part of `StacksFrontier.RingTheory.Koszul.Concatenation` contains the proof of Stacks Tag 066A
(`Koszul.regularity_of_generators_of_eq_span_range`), using the coefficient calculus of
`StacksFrontier.RingTheory.Koszul.Concatenation.QuasiRegularAppend`.
-/

namespace Koszul

universe u

open CategoryTheory CategoryTheory.Limits

/-! ## Independence of the generators (Tag 066A)

If an ideal `I` generated by `f₁, …, f_r` admits a quasi-regular (resp. H₁-regular, resp.
Koszul-regular) generating sequence `g₁, …, g_r` of the same length `r`, then `f₁, …, f_r`
itself is quasi-regular (resp. H₁-regular, resp. Koszul-regular).

The quasi-regular case compares the two canonical maps of Tag 061N: they have the same image in
each total degree, the degree-`n` part of the source is a finite module, and Orzech's property
upgrades injectivity of one to injectivity of the other. The two Koszul cases go instead through
a change-of-generators matrix `A` with `⟨g, A ·⟩ = ⟨f, ·⟩`: its determinant becomes invertible
modulo `I`, and multiplication by a power of the determinant is null-homotopic on positive Koszul
homology, so the two Koszul complexes have the same vanishing.

The coefficient calculus of the canonical map is the one set up for Tag 0667 above.
-/

section GeneratorIndependence

noncomputable section

open RingTheory.Sequence
open scoped TensorProduct

/-! ### Comparing the canonical maps of two generating sequences -/

section Graded

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {c : ℕ}

private theorem injective_of_range_eq_of_injective
    {A B : Type*} [AddCommMonoid A] [Module R A] [Module.Finite R A]
    [AddCommMonoid B] [Module R B] (a b : A →ₗ[R] B)
    (h : LinearMap.range a = LinearMap.range b) (hb : Function.Injective b) :
    Function.Injective a := by
  let e := LinearEquiv.ofInjective b hb
  let t : A →ₗ[R] A := e.symm.toLinearMap.comp
    (a.codRestrict (LinearMap.range b) (fun x => h ▸ LinearMap.mem_range_self a x))
  have ht : Function.Surjective t := by
    intro x
    obtain ⟨y, hy⟩ := (show b x ∈ LinearMap.range a from h.symm ▸ LinearMap.mem_range_self b x)
    refine ⟨y, ?_⟩
    show e.symm ⟨a y, _⟩ = x
    apply e.injective
    rw [e.apply_symm_apply]
    exact Subtype.ext hy
  have hi := OrzechProperty.injective_of_surjective_endomorphism t ht
  intro x y hxy
  apply hi
  show e.symm ⟨a x, _⟩ = e.symm ⟨a y, _⟩
  congr 1
  exact Subtype.ext hxy

private noncomputable def homogeneousSource (f : Fin c → R) (n : ℕ) :
    Submodule R (Source R f) :=
  Submodule.span R ((fun e => srcMono f e (1 : R)) '' {e | qrMdeg e = n})

private theorem srcMono_mem_homogeneousSource (f : Fin c → R)
    (e : Fin c →₀ ℕ) (m : R) : srcMono f e m ∈ homogeneousSource f (qrMdeg e) := by
  have h : srcMono f e m = m • srcMono f e (1 : R) := by
    unfold srcMono
    rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul]
    congr 1
    show Submodule.Quotient.mk m = Submodule.Quotient.mk (m • (1 : R))
    simp
  rw [h]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨e, rfl, rfl⟩)

private theorem homogeneousSource_fg (f : Fin c → R) (n : ℕ) :
    (homogeneousSource f n).FG := by
  apply Submodule.fg_span
  apply Set.Finite.image
  have h : {e : Fin c →₀ ℕ | qrMdeg e = n} = {e | e.degree = n} := by
    ext e
    show (∑ i, e i) = n ↔ e.sum (fun _ k => k) = n
    rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
  rw [h]
  exact Finsupp.finite_of_degree_eq n

private theorem map_homogeneousSource (f : Fin c → R) (n : ℕ) :
    (homogeneousSource f n).map ((quasiRegularCanonicalMap (M := R) f).restrictScalars R) =
      tgtDeg (M := R) f n := by
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap, homogeneousSource, Submodule.span_le]
    rintro _ ⟨e, he, rfl⟩
    show quasiRegularCanonicalMap f (srcMono f e (1 : R)) ∈ tgtDeg f n
    rw [canonicalMap_srcMono, imgTargetLin_eq_degLift f e 1 n he
      (he ▸ fpow_smul_mem f e 1)]
    exact LinearMap.mem_range_self _ _
  · rintro _ ⟨x, rfl⟩
    induction x using Submodule.Quotient.induction_on with
    | H x =>
      obtain ⟨x, hx⟩ := x
      have hxs := hx
      rw [JpowM_eq_span] at hxs
      suffices h : ∀ hx : x ∈ JpowM R f n,
          degLift (M := R) f n ⟨x, hx⟩ ∈
            (homogeneousSource f n).map ((quasiRegularCanonicalMap (M := R) f).restrictScalars R)
        from h hx
      clear hx
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hxs
      · rintro x ⟨e, m, he, rfl⟩ h
        refine ⟨srcMono f e m, ?_, ?_⟩
        · exact he ▸ srcMono_mem_homogeneousSource f e m
        · exact (canonicalMap_srcMono f e m).trans (imgTargetLin_eq_degLift f e m n he h)
      · intro h
        show degLift (M := R) f n 0 ∈ _
        rw [map_zero]
        exact Submodule.zero_mem _
      · intro a b ha hb iha ihb h
        have ham : a ∈ JpowM R f n := by rwa [JpowM_eq_span]
        have hbm : b ∈ JpowM R f n := by rwa [JpowM_eq_span]
        show degLift f n (⟨a, ham⟩ + ⟨b, hbm⟩) ∈ _
        rw [map_add]
        exact Submodule.add_mem _ (iha ham) (ihb hbm)
      · intro r a ha iha h
        have ham : a ∈ JpowM R f n := by rwa [JpowM_eq_span]
        show degLift f n (r • ⟨a, ham⟩) ∈ _
        rw [map_smul]
        exact Submodule.smul_mem _ r (iha ham)

private abbrev sourceOverIdeal (I : Ideal R) (c : ℕ) :=
  TensorProduct (R ⧸ I) (MvPolynomial (Fin c) (R ⧸ I))
    (R ⧸ (I • (⊤ : Submodule R R)))

private abbrev powerSubmodule (I : Ideal R) (n : ℕ) : Submodule R R :=
  I ^ n • (⊤ : Submodule R R)

private abbrev targetOverIdeal (I : Ideal R) :=
  DirectSum ℕ (fun n => (powerSubmodule I n) ⧸
    Submodule.comap (powerSubmodule I n).subtype (powerSubmodule I (n + 1)))

private abbrev homogeneousSourceOverIdeal (I : Ideal R) (c n : ℕ) :
    Submodule R (sourceOverIdeal I c) :=
  Submodule.span R ((fun e => (MvPolynomial.monomial e (1 : R ⧸ I)) ⊗ₜ[R ⧸ I]
    (Submodule.Quotient.mk (1 : R) : R ⧸ (I • (⊤ : Submodule R R)))) ''
      {e : Fin c →₀ ℕ | qrMdeg e = n})

private abbrev homogeneousTargetOverIdeal (I : Ideal R) (n : ℕ) :
    Submodule R (targetOverIdeal I) :=
  LinearMap.range (DirectSum.lof R ℕ _ n)

private noncomputable def canonicalMapOverIdeal (I : Ideal R) (f : Fin c → R)
    (h : Jid f = I) : sourceOverIdeal I c →ₗ[R] targetOverIdeal I := by
  subst I
  exact (quasiRegularCanonicalMap (M := R) f).restrictScalars R

private theorem canonicalMapOverIdeal_range (I : Ideal R) (f : Fin c → R)
    (h : Jid f = I) (n : ℕ) :
    (homogeneousSourceOverIdeal I c n).map (canonicalMapOverIdeal I f h) =
      homogeneousTargetOverIdeal I n := by
  subst I
  exact map_homogeneousSource f n

private theorem homogeneousSource_injective_of_eq_span (f g : Fin c → R)
    (h : Jid f = Jid g)
    (hg : Function.Injective (quasiRegularCanonicalMap (M := R) g)) (n : ℕ) :
    Function.Injective (((quasiRegularCanonicalMap (M := R) f).restrictScalars R).comp
      (homogeneousSource f n).subtype) := by
  let I := Jid f
  let S := homogeneousSourceOverIdeal I c n
  let a := (canonicalMapOverIdeal I f rfl).comp S.subtype
  let b := (canonicalMapOverIdeal I g h.symm).comp S.subtype
  have hb : Function.Injective b := by
    have haux : ∀ (J : Ideal R) (hJ : Jid g = J),
        Function.Injective (canonicalMapOverIdeal J g hJ) := by
      intro J hJ
      subst J
      exact hg
    exact (haux I h.symm).comp Subtype.val_injective
  have hr : LinearMap.range a = LinearMap.range b := by
    show LinearMap.range (_ ∘ₗ S.subtype) = LinearMap.range (_ ∘ₗ S.subtype)
    simp only [LinearMap.range_comp, Submodule.range_subtype]
    exact (canonicalMapOverIdeal_range I f rfl n).trans
      (canonicalMapOverIdeal_range I g h.symm n).symm
  have : Module.Finite R S := Module.Finite.of_fg (homogeneousSource_fg f n)
  show Function.Injective a
  exact injective_of_range_eq_of_injective (R := R) (A := S) (B := targetOverIdeal I) a b hr hb

private theorem canonicalMap_injective_of_eq_span (f g : Fin c → R)
    (h : Jid f = Jid g)
    (hg : Function.Injective (quasiRegularCanonicalMap (M := R) g)) :
    Function.Injective (quasiRegularCanonicalMap (M := R) f) := by
  classical
  apply injective_of_mem_of_sum_fpow_smul_mem
  intro n S s hdeg hrel e he
  have hsum : (∑ e ∈ S, fpow f e • s e) ∈ JpowM R f n := JpowM_succ_le f n hrel
  have hzero : quasiRegularCanonicalMap (M := R) f (∑ e ∈ S, srcMono f e (s e)) = 0 := by
    rw [map_sum, Finset.sum_congr rfl (fun e _ => canonicalMap_srcMono f e (s e)),
      sum_imgTargetLin_eq_degLift' S s n hdeg hsum, degLift_eq_zero_iff]
    exact hrel
  have hmem : (∑ e ∈ S, srcMono f e (s e)) ∈ homogeneousSource f n := by
    apply Submodule.sum_mem
    intro e he
    exact hdeg e he ▸ srcMono_mem_homogeneousSource f e (s e)
  have hi := homogeneousSource_injective_of_eq_span f g h hg n
  have hz := hi (a₁ := ⟨∑ e ∈ S, srcMono f e (s e), hmem⟩) (a₂ := 0)
    (hzero.trans (map_zero _).symm)
  have hz' : (∑ e ∈ S, srcMono f e (s e)) = 0 := congrArg Subtype.val hz
  have hfs := congrArg (srcFinsuppEquiv R f) hz'
  have hmap : ∀ T : Finset (Fin c →₀ ℕ), srcFinsuppEquiv R f (∑ e ∈ T, srcMono f e (s e)) =
      ∑ e ∈ T, Finsupp.single e (Submodule.Quotient.mk (s e) : qrMbar R f) := by
    intro T
    induction T using Finset.induction_on with
    | empty => exact (srcFinsuppEquiv R f).map_zero
    | @insert j S hj ih =>
      simp only [Finset.sum_insert hj, (srcFinsuppEquiv R f).map_add,
        srcFinsuppEquiv_srcMono, ih]
  rw [hmap S, (srcFinsuppEquiv R f).map_zero] at hfs
  have hev := congrArg (fun t : (Fin c →₀ ℕ) →₀ qrMbar R f => t e) hfs
  simp only [Finsupp.finsetSum_apply, Finsupp.single_apply, Finsupp.coe_zero, Pi.zero_apply] at hev
  simp only [Finset.sum_ite_eq' S e, ite_eq_left he] at hev
  exact (Submodule.Quotient.mk_eq_zero _).mp hev

private theorem isQuasiRegular_of_eq_span (f g : Fin c → R)
    (h : Jid f = Jid g) (hg : IsQuasiRegular R (List.ofFn g)) :
    IsQuasiRegular R (List.ofFn f) :=
  (isQuasiRegular_ofFn_iff f).2
    ⟨canonicalMap_injective_of_eq_span f g h ((isQuasiRegular_ofFn_iff g).1 hg).1,
      quasiRegularCanonicalMap_surjective f⟩

private theorem coefficients_mem_of_relation (g a : Fin c → R)
    (hg : Function.Injective (quasiRegularCanonicalMap (M := R) g))
    (ha : Koszul.seqDual g a = 0) (i : Fin c) : a i ∈ Jid g := by
  classical
  have hrel : (∑ j, fpow g (Finsupp.single j 1) • a j) ∈ JpowM R g 2 := by
    have hz : (∑ j, fpow g (Finsupp.single j 1) • a j) = 0 := by
      simpa [fpow, Finsupp.single_apply, Koszul.seqDual_apply, mul_comm] using ha
    rw [hz]
    exact Submodule.zero_mem _
  have hm := mem_of_sum_fpow_smul_mem_of_unique hg 1 Finset.univ
    (fun j : Fin c => Finsupp.single j 1) a (by simp [qrMdeg]) hrel i
    (Finset.mem_univ i) (by
      intro j _ hj
      by_contra hji
      have hv := congrArg (fun e : Fin c →₀ ℕ => e i) hj
      simp [hji] at hv)
  simpa only [smul_eq_mul, Ideal.mul_top] using hm

private theorem exists_change_matrix (f g : Fin c → R) (h : Jid f ≤ Jid g) :
    ∃ A : Matrix (Fin c) (Fin c) R,
      (Koszul.seqDual g).comp (Matrix.toLin' A) = Koszul.seqDual f := by
  classical
  have hmem : ∀ j, f j ∈ Submodule.span R (Set.range g) :=
    fun j => h (Ideal.subset_span (Set.mem_range_self j))
  choose a ha using fun j => (Submodule.mem_span_range_iff_exists_fun R).1 (hmem j)
  refine ⟨fun i j => a j i, ?_⟩
  apply (Pi.basisFun R (Fin c)).ext
  intro j
  simpa [Koszul.seqDual_apply, Matrix.toLin'_apply, Matrix.mulVec, dotProduct,
    Pi.basisFun_apply, Pi.single_apply, mul_ite, mul_comm] using ha j

/-- `1 - t * s ∈ I` says exactly that `t * s` is `1` modulo `I`. -/
private theorem one_sub_mul_mem_iff {R : Type*} [CommRing R] {I : Ideal R} {s t : R} :
    1 - t * s ∈ I ↔ Ideal.Quotient.mk I (t * s) = 1 := by
  rw [← Ideal.Quotient.eq, map_one, eq_comm]

private theorem exists_change_matrix_det (f g : Fin c → R) (h : Jid f = Jid g)
    (hg : Function.Injective (quasiRegularCanonicalMap (M := R) g)) :
    ∃ (A : Matrix (Fin c) (Fin c) R) (t : R),
      (Koszul.seqDual g).comp (Matrix.toLin' A) = Koszul.seqDual f ∧
        1 - t * A.det ∈ Jid f := by
  classical
  obtain ⟨A, hA⟩ := exists_change_matrix f g h.le
  obtain ⟨B, hB⟩ := exists_change_matrix g f h.ge
  have hab : (Koszul.seqDual g).comp (Matrix.toLin' (A * B - 1)) = 0 := by
    rw [map_sub, Matrix.toLin'_mul, Matrix.toLin'_one, LinearMap.comp_sub,
      ← LinearMap.comp_assoc, hA, hB, LinearMap.comp_id, sub_self]
  have hcoeff : ∀ i j, (A * B - 1) i j ∈ Jid g := by
    intro i j
    have hc := coefficients_mem_of_relation g
      (Matrix.toLin' (A * B - 1) (Pi.single j 1)) hg
      (LinearMap.congr_fun hab (Pi.single j 1)) i
    simpa [Matrix.toLin'_apply, Matrix.mulVec, dotProduct, Matrix.mul_apply,
      Matrix.one_apply, Pi.single_apply, eq_comm] using hc
  let q := Ideal.Quotient.mk (Jid g)
  have hq : q.mapMatrix (A * B) = 1 := by
    apply sub_eq_zero.mp
    rw [← map_one q.mapMatrix, ← map_sub]
    ext i j
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hcoeff i j)
  have hd : q (A.det * B.det) = 1 := by
    simpa only [← RingHom.map_det, Matrix.det_mul, Matrix.det_one] using congrArg Matrix.det hq
  refine ⟨A, B.det, hA, ?_⟩
  rw [h, one_sub_mul_mem_iff, mul_comm]
  exact hd

end Graded

/-! ### Change of generators on the Koszul complex -/

section ChangeMatrix

variable {R : Type*} [CommRing R] {c : ℕ}
variable {E F : Type*} [AddCommGroup E] [Module R E] [AddCommGroup F] [Module R F]

private theorem exteriorPower_map_smul (s : R) (a : E →ₗ[R] F) (n : ℕ) :
    exteriorPower.map n (s • a) = s ^ n • exteriorPower.map n a := by
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro v
  simp only [LinearMap.compAlternatingMap_apply, exteriorPower.map_apply_ιMulti,
    LinearMap.smul_apply, Function.comp_def]
  simpa using (exteriorPower.ιMulti R n).map_smul_univ (fun _ => s) (fun i => a (v i))

private theorem koszul_d_map (φ : Module.Dual R E) (ψ : Module.Dual R F)
    (a : E →ₗ[R] F) (h : ψ.comp a = φ) (n : ℕ) (x : ⋀[R]^(n + 1) E) :
    Koszul.d ψ n (exteriorPower.map (n + 1) a x) =
      exteriorPower.map n a (Koszul.d φ n x) := by
  apply Subtype.ext
  simpa only [Koszul.d_apply_coe, exteriorPower.coe_map] using
    (koszul_map_comm φ ψ a h x).symm

private theorem koszul_d_smul (s : R) (φ : Module.Dual R E) (n : ℕ)
    (x : ⋀[R]^(n + 1) E) : Koszul.d (s • φ) n x = s • Koszul.d φ n x := by
  apply Subtype.ext
  show (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm R E)) (s • φ))
    (x : ExteriorAlgebra R E) = s • (CliffordAlgebra.contractLeft φ) (x : ExteriorAlgebra R E)
  rw [map_smul, LinearMap.smul_apply]

private theorem isZero_homology_iff (f : Fin c → R) (n : ℕ) :
    Limits.IsZero ((Koszul.seqComplex f).homology (n + 1)) ↔
      ∀ z : ⋀[R]^(n + 1) (Fin c → R), Koszul.d (Koszul.seqDual f) n z = 0 →
        ∃ w : ⋀[R]^(n + 2) (Fin c → R), Koszul.d (Koszul.seqDual f) (n + 1) w = z := by
  rw [← HomologicalComplex.exactAt_iff_isZero_homology,
    HomologicalComplex.exactAt_iff' _ (n + 2) (n + 1) n (by simp) (by simp),
    ShortComplex.moduleCat_exact_iff_ker_sub_range]
  show LinearMap.ker ((Koszul.seqComplex f).d (n + 1) n).hom ≤
    LinearMap.range ((Koszul.seqComplex f).d (n + 2) (n + 1)).hom ↔ _
  simp only [Koszul.seqComplex_d, ModuleCat.hom_ofHom]
  rfl

private theorem smul_cycle_mem_range (f : Fin c → R) (a : R) (ha : a ∈ Jid f)
    (n : ℕ) (z : ⋀[R]^(n + 1) (Fin c → R)) (hz : Koszul.d (Koszul.seqDual f) n z = 0) :
    ∃ w : ⋀[R]^(n + 2) (Fin c → R), Koszul.d (Koszul.seqDual f) (n + 1) w = a • z := by
  classical
  obtain ⟨v, hv⟩ := (Submodule.mem_span_range_iff_exists_fun R).1 ha
  have hv' : Koszul.seqDual f v = a := by simpa [Koszul.seqDual_apply, smul_eq_mul] using hv
  have hm : ExteriorAlgebra.ι R v * (z : ExteriorAlgebra R (Fin c → R)) ∈
      ⋀[R]^(n + 2) (Fin c → R) := by
    simpa only [Nat.add_comm 1 (n + 1)] using
      (SetLike.mul_mem_graded (Koszul.ι_mem_one v) z.property :
        ExteriorAlgebra.ι R v * (z : ExteriorAlgebra R (Fin c → R)) ∈
          ⋀[R]^(1 + (n + 1)) (Fin c → R))
  refine ⟨⟨_, hm⟩, ?_⟩
  apply Subtype.ext
  have hz' : Koszul.contraction (Koszul.seqDual f) (z : ExteriorAlgebra R (Fin c → R)) = 0 :=
    congrArg Subtype.val hz
  show Koszul.contraction (Koszul.seqDual f)
      (ExteriorAlgebra.ι R v * (z : ExteriorAlgebra R (Fin c → R))) =
    a • (z : ExteriorAlgebra R (Fin c → R))
  rw [CliffordAlgebra.contractLeft_ι_mul, hz', mul_zero, sub_zero, hv']

private theorem one_sub_mul_pow_mem {I : Ideal R} {s t : R} (h : 1 - t * s ∈ I) (n : ℕ) :
    1 - t ^ n * s ^ n ∈ I := by
  rw [one_sub_mul_mem_iff] at h ⊢
  rw [← mul_pow, map_pow, h, one_pow]

private theorem homology_isZero_of_change_matrix
    (f g : Fin c → R) (A : Matrix (Fin c) (Fin c) R) (t : R)
    (hA : (Koszul.seqDual g).comp (Matrix.toLin' A) = Koszul.seqDual f)
    (ht : 1 - t * A.det ∈ Jid f) (n : ℕ)
    (hg : Limits.IsZero ((Koszul.seqComplex g).homology (n + 1))) :
    Limits.IsZero ((Koszul.seqComplex f).homology (n + 1)) := by
  classical
  let a := Matrix.toLin' A
  let b := Matrix.toLin' A.adjugate
  let s := A.det
  have hab : a.comp b = s • LinearMap.id := by
    dsimp [a, b, s]
    rw [← Matrix.toLin'_mul, Matrix.mul_adjugate, map_smul, Matrix.toLin'_one]
  have hba : b.comp a = s • LinearMap.id := by
    dsimp [a, b, s]
    rw [← Matrix.toLin'_mul, Matrix.adjugate_mul, map_smul, Matrix.toLin'_one]
  have hB : (Koszul.seqDual f).comp b = s • Koszul.seqDual g := by
    rw [← hA, LinearMap.comp_assoc]
    show (Koszul.seqDual g).comp (a.comp b) = _
    rw [hab, LinearMap.comp_smul, LinearMap.comp_id]
  apply (isZero_homology_iff f n).2
  intro z hz
  have hgz : Koszul.d (Koszul.seqDual g) n (exteriorPower.map (n + 1) a z) = 0 := by
    rw [koszul_d_map (Koszul.seqDual f) (Koszul.seqDual g) a hA, hz, map_zero]
  obtain ⟨w, hw⟩ := (isZero_homology_iff g n).1 hg _ hgz
  have hw' : Koszul.d (Koszul.seqDual f) (n + 1) (exteriorPower.map (n + 2) b w) =
      s ^ (n + 2) • z := by
    rw [koszul_d_map (s • Koszul.seqDual g) (Koszul.seqDual f) b hB,
      koszul_d_smul, map_smul, hw]
    rw [← LinearMap.comp_apply, ← exteriorPower.map_comp, hba,
      exteriorPower_map_smul, exteriorPower.map_id]
    simp only [LinearMap.smul_apply, LinearMap.id_apply, smul_smul]
    simp only [pow_succ']
  obtain ⟨u, hu⟩ := smul_cycle_mem_range f (1 - t ^ (n + 2) * s ^ (n + 2))
    (one_sub_mul_pow_mem ht (n + 2)) n z hz
  refine ⟨u + t ^ (n + 2) • exteriorPower.map (n + 2) b w, ?_⟩
  rw [map_add, map_smul, hu, hw', ← mul_smul, ← add_smul, sub_add_cancel, one_smul]

private theorem homology_isZero_of_eq_span (f g : Fin c → R) (h : Jid f = Jid g)
    (hq : IsQuasiRegular R (List.ofFn g)) (n : ℕ)
    (hg : Limits.IsZero ((Koszul.seqComplex g).homology (n + 1))) :
    Limits.IsZero ((Koszul.seqComplex f).homology (n + 1)) := by
  obtain ⟨A, t, hA, ht⟩ := exists_change_matrix_det f g h ((isQuasiRegular_ofFn_iff g).1 hq).1
  exact homology_isZero_of_change_matrix f g A t hA ht n hg

end ChangeMatrix

/-- **Stacks 066A.** If an ideal generated by `r` elements admits a quasi-regular,
`H₁`-regular, or Koszul-regular generating sequence of length `r`, then every generating
sequence of length `r` has the corresponding property. -/
@[stacks 066A]
public theorem regularity_of_generators_of_eq_span_range
    {R : Type*} [CommRing R] {r : ℕ} (I : Ideal R) (f : Fin r → R)
    (hf : Ideal.span (Set.range f) = I) :
    ((∃ g : Fin r → R, Ideal.span (Set.range g) = I ∧
        RingTheory.Sequence.IsQuasiRegular R (List.ofFn g)) →
      RingTheory.Sequence.IsQuasiRegular R (List.ofFn f)) ∧
    ((∃ g : Fin r → R, Ideal.span (Set.range g) = I ∧ Koszul.IsH1Regular g) →
      Koszul.IsH1Regular f) ∧
    ((∃ g : Fin r → R, Ideal.span (Set.range g) = I ∧ Koszul.IsKoszulRegular g) →
      Koszul.IsKoszulRegular f) := by
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨g, hg, hq⟩
    exact isQuasiRegular_of_eq_span f g (hf.trans hg.symm) hq
  · rintro ⟨g, hg, hreg⟩
    have hq := Koszul.isQuasiRegular_of_isH1RegularOn
      ((Koszul.isH1RegularOn_self_iff g).2 hreg)
    exact homology_isZero_of_eq_span f g (hf.trans hg.symm) hq 0 hreg
  · rintro ⟨g, hg, hreg⟩
    have hq := Koszul.isQuasiRegular_of_isH1RegularOn
      ((Koszul.isH1RegularOn_self_iff g).2 (hreg 1 (by omega)))
    intro i hi
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hi
    exact homology_isZero_of_eq_span f g (hf.trans hg.symm) hq n (hreg _ (by omega))

end

end GeneratorIndependence

