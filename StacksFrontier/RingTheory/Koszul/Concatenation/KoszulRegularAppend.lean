@[expose] public section

-- The comparison maps below are assembled from `ModuleCat` quotients, `total` complexes and
-- `extend`/`restriction` wrappers, and the `rw`/`erw`/`change` steps that identify their
-- components unfold those wrappers through reducible-transparency defeq.
set_option backward.isDefEq.respectTransparency false

/-!
# Concatenating Koszul-regular sequences

Let `A` be a commutative ring, let `f₁, …, f_n ∈ A`, and write `I = (f₁, …, f_n)` for the
ideal they generate. This file relates Koszul-regularity of a concatenated sequence
`f₁, …, f_n, g₁, …, g_m` in `A` to Koszul-regularity of the images `ḡ₁, …, ḡ_m` in `A/I`.

## Main results

* `Koszul.koszul_regular_append` (Stacks Tag 0669, Lemma 15.30.7): if `f₁, …, f_n` is
  Koszul-regular in `A` and `ḡ₁, …, ḡ_m` is Koszul-regular in `A/I`, then the concatenation
  `f₁, …, f_n, g₁, …, g_m` is Koszul-regular in `A`.
* `Koszul.koszulRegular_quotient_of_koszulRegular_append` (Stacks Tag 068M,
  Lemma 15.30.15): conversely, if both `f₁, …, f_n` and `f₁, …, f_n, g₁, …, g_m` are
  Koszul-regular in `A`, then `ḡ₁, …, ḡ_m` is Koszul-regular in `A/I`.
* `Koszul.isQuasiRegular_append_of_isH1Regular_quotient` (Stacks Tag 0667): if `f₁, …, f_n` is
  quasi-regular in `A` and `ḡ₁, …, ḡ_m` is H₁-regular in `A/I`, then the concatenation
  `f₁, …, f_n, g₁, …, g_m` is quasi-regular in `A`.
* `Koszul.regularity_of_generators_of_eq_span_range` (Stacks Tag 066A): if the ideal generated
  by `f₁, …, f_r` also admits a quasi-regular (resp. H₁-regular, resp. Koszul-regular)
  generating sequence of length `r`, then `f₁, …, f_r` is itself quasi-regular (resp.
  H₁-regular, resp. Koszul-regular).

## Implementation notes

Finite sequences are represented by functions from `Fin`, concatenation by `Fin.append`, and
the ideal generated by the first sequence by `Ideal.span (Set.range f)`. Thus the ideal called
`I` in the source is determined by `f` and does not occur as redundant additional data.

Both directions run through the same three pieces of infrastructure, which are therefore
shared between the two proofs and collected first:

* the *Koszul augmentation* `Koszul.seqComplex f ⟶ (A/I)[0]`, which is a quasi-isomorphism
  exactly when `f` is Koszul-regular (Tag 0664 identifies `H_0` of the Koszul complex with
  `A/I`);
* the identification of the Koszul complex of `Fin.append f g` with the total complex of the
  tensor product `Koszul.seqComplex f ⊗ Koszul.seqComplex g`
  (`Koszul.seqComplex_append_iso_totTensor`, Tag 0664);
* the comparison of total homology along a columnwise quasi-isomorphism of bounded chain
  bicomplexes (Tag 0133). Since `StacksDraft.TotalComplexQuasiIso.quasiIso_total_map` is
  stated for integer *cochain* bicomplexes, the bounded chain bicomplexes occurring here are
  reindexed by reversing both gradings and translating the second one; the comparison
  preserves the total differential, including its signs.

## References

* [Stacks Project, Tag 0669](https://stacks.math.columbia.edu/tag/0669)
* [Stacks Project, Tag 068M](https://stacks.math.columbia.edu/tag/068M)
* [Stacks Project, Tag 0667](https://stacks.math.columbia.edu/tag/0667)
* [Stacks Project, Tag 066A](https://stacks.math.columbia.edu/tag/066A)
* [Stacks Project, Tag 0664](https://stacks.math.columbia.edu/tag/0664)
* [Stacks Project, Tag 0133](https://stacks.math.columbia.edu/tag/0133)
-/

namespace Koszul

universe u

open CategoryTheory CategoryTheory.Limits

/-! ## Shared infrastructure

The declarations in this section are used by both Tag 0669 and Tag 068M.
-/

/-! ### Vanishing of the Koszul complex above its length -/

/-- The Koszul complex on a sequence of length `r` vanishes in degrees above `r`. -/
private theorem koszul_isZero_X_of_lt {A : Type*} [CommRing A] {r : ℕ} (f : Fin r → A)
    (i : ℕ) (hi : r < i) :
    IsZero ((Koszul.seqComplex f).X i) := by
  have : Subsingleton (⋀[A]^i (Fin r → A)) :=
    exteriorPower.subsingleton_of_span_eq_top_of_card_lt
      (Pi.basisFun A (Fin r)) (Pi.basisFun A (Fin r)).span_eq i (by simpa using hi)
  show IsZero (ModuleCat.of A (⋀[A]^i (Fin r → A)))
  exact ModuleCat.isZero_iff_subsingleton.mpr inferInstance

/-! ### Reversing a bounded chain bicomplex

`StacksDraft.TotalComplexQuasiIso.quasiIso_total_map` (Stacks Tag 0133) is stated for
bicomplexes of integer cochain complexes. The bicomplexes arising below are bounded
bicomplexes of `ℕ`-indexed chain complexes, so both gradings are reversed (and the second
translated) to land in the cochain setting.
-/

section Reindex

open HomologicalComplex

variable {C : Type*} [Category* C] [Abelian C] [HasCountableCoproducts C]

private noncomputable abbrev reverseColumns
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)) (b : ℤ) :=
  (((ComplexShape.embeddingUpIntLE b).extendFunctor C).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj Z

private noncomputable abbrev reverseDouble
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)) (b : ℤ) :
    HomologicalComplex₂ C (ComplexShape.up ℤ) (ComplexShape.up ℤ) :=
  (reverseColumns Z b).extend ComplexShape.embeddingDownNat

private noncomputable def reverseDoubleXIso
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p q : ℕ) {p' q' : ℤ} (hp : -(p : ℤ) = p') (hq : b - q = q') :
    ((reverseDouble Z b).X p').X q' ≅ (Z.X p).X q :=
  (HomologicalComplex.eval C (ComplexShape.up ℤ) q').mapIso
    ((reverseColumns Z b).extendXIso ComplexShape.embeddingDownNat hp) ≪≫
      (Z.X p).extendXIso (ComplexShape.embeddingUpIntLE b) hq

private noncomputable def reverseTotalMap
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (n : ℕ) :
    (Z.total (ComplexShape.down ℕ)).X n ⟶
      ((reverseDouble Z b).total (ComplexShape.up ℤ)).X (b - n) :=
  Z.totalDesc fun p q h => (reverseDoubleXIso Z b p q rfl rfl).inv ≫
    (reverseDouble Z b).ιTotal (ComplexShape.up ℤ) (-(p : ℤ)) (b - q) (b - n)
      (by change -(p : ℤ) + (b - q) = b - n; change p + q = n at h; omega)

private theorem ι_reverseTotalMap
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p q n : ℕ) (h : p + q = n) :
    Z.ιTotal (ComplexShape.down ℕ) p q n h ≫ reverseTotalMap Z b n =
      (reverseDoubleXIso Z b p q rfl rfl).inv ≫
        (reverseDouble Z b).ιTotal (ComplexShape.up ℤ) (-(p : ℤ)) (b - q) (b - n)
          (by change -(p : ℤ) + (b - q) = b - n; omega) := by
  apply HomologicalComplex₂.ι_totalDesc

omit [HasCountableCoproducts C] in
private theorem reverseDouble_isZero_X_of_pos
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b p : ℤ) (hp : 0 < p) : IsZero ((reverseDouble Z b).X p) :=
  (reverseColumns Z b).isZero_extend_X ComplexShape.embeddingDownNat p
    (fun i => by change -(i : ℤ) ≠ p; omega)

/-- The reversed double complex vanishes in every entry over a positive first degree. -/
private theorem reverseDouble_isZero_XX_of_pos {D : Type*} [Category* D] [Abelian D]
    (Z : HomologicalComplex₂ D (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b p q : ℤ) (hp : 0 < p) : IsZero (((reverseDouble Z b).X p).X q) :=
  Functor.map_isZero (HomologicalComplex.eval D (ComplexShape.up ℤ) q)
    (reverseDouble_isZero_X_of_pos Z b p hp)

/-- Reindexing a nonpositive `p : ℤ` through `ComplexShape.embeddingDownNat` is the identity. -/
private theorem embeddingDownNat_f_toNat_neg (p : ℤ) (hp : p ≤ 0) :
    ComplexShape.embeddingDownNat.f (-p).toNat = p := by
  change -((-p).toNat : ℤ) = p
  omega

omit [HasCountableCoproducts C] in
private theorem reverseDouble_isZero_XX_of_lt
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b p q : ℤ) (hq : b < q) : IsZero (((reverseDouble Z b).X p).X q) := by
  by_cases hp : p ≤ 0
  · exact ((Z.X (-p).toNat).isZero_extend_X (ComplexShape.embeddingUpIntLE b) q
      (fun j => by change b - (j : ℤ) ≠ q; omega)).of_iso
        ((HomologicalComplex.eval C (ComplexShape.up ℤ) q).mapIso
          ((reverseColumns Z b).extendXIso ComplexShape.embeddingDownNat
            (embeddingDownNat_f_toNat_neg p hp)))
  · exact reverseDouble_isZero_XX_of_pos Z b p q (by omega)

private noncomputable def reverseTotalInv
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (n : ℕ) :
    ((reverseDouble Z b).total (ComplexShape.up ℤ)).X (b - n) ⟶
      (Z.total (ComplexShape.down ℕ)).X n :=
  (reverseDouble Z b).totalDesc fun p q h =>
    if hp : p ≤ 0 then
      if hq : q ≤ b then
        (reverseDoubleXIso Z b (-p).toNat (b - q).toNat
          (by omega) (by omega)).hom ≫
            Z.ιTotal (ComplexShape.down ℕ) (-p).toNat (b - q).toNat n
              (by change p + q = b - n at h; change _ + _ = n; omega)
      else (reverseDouble_isZero_XX_of_lt Z b p q (by omega)).to_ _
    else (reverseDouble_isZero_XX_of_pos Z b p q (by omega)).to_ _

private theorem ι_reverseTotalInv
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p q n : ℕ) (h : p + q = n) :
    (reverseDouble Z b).ιTotal (ComplexShape.up ℤ) (-(p : ℤ)) (b - q) (b - n)
        (by change -(p : ℤ) + (b - q) = b - n; omega) ≫ reverseTotalInv Z b n =
      (reverseDoubleXIso Z b p q rfl rfl).hom ≫
        Z.ιTotal (ComplexShape.down ℕ) p q n h := by
  rw [reverseTotalInv, HomologicalComplex₂.ι_totalDesc]
  simp only [neg_nonpos.mpr (Int.natCast_nonneg p), sub_le_self _ (Int.natCast_nonneg q),
    ↓reduceDIte]
  congr! <;> simp

private noncomputable def reverseTotalXIso
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (n : ℕ) :
    (Z.total (ComplexShape.down ℕ)).X n ≅
      ((reverseDouble Z b).total (ComplexShape.up ℤ)).X (b - n) where
  hom := reverseTotalMap Z b n
  inv := reverseTotalInv Z b n
  hom_inv_id := by
    apply HomologicalComplex₂.total.hom_ext (ComplexShape.down ℕ)
    intro p q h
    change p + q = n at h
    rw [← Category.assoc, ι_reverseTotalMap Z b p q n h, Category.assoc,
      ι_reverseTotalInv Z b p q n h]
    simp
  inv_hom_id := by
    apply HomologicalComplex₂.total.hom_ext (ComplexShape.up ℤ)
    intro p q h
    by_cases hp : p ≤ 0
    · by_cases hq : q ≤ b
      · obtain ⟨i, hi⟩ : ∃ i : ℕ, -(i : ℤ) = p := ⟨(-p).toNat, by omega⟩
        obtain ⟨j, hj⟩ : ∃ j : ℕ, b - j = q := ⟨(b - q).toNat, by omega⟩
        subst p q
        have hij : i + j = n := by change -(i : ℤ) + (b - j) = b - n at h; omega
        rw [← Category.assoc, ι_reverseTotalInv Z b i j n hij, Category.assoc,
          ι_reverseTotalMap]
        simp
      · exact (reverseDouble_isZero_XX_of_lt Z b p q (by omega)).eq_of_src _ _
    · exact (reverseDouble_isZero_XX_of_pos Z b p q (by omega)).eq_of_src _ _

omit [HasCountableCoproducts C] in
private theorem reverseDoubleXIso_inv_d₁
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p p' q : ℕ) :
    (reverseDoubleXIso Z b p q rfl rfl).inv ≫
        ((reverseDouble Z b).d (-(p : ℤ)) (-(p' : ℤ))).f (b - q) =
      (Z.d p p').f q ≫ (reverseDoubleXIso Z b p' q rfl rfl).inv := by
  simp only [reverseDoubleXIso, Iso.trans_inv, Functor.mapIso_inv, eval_map, Category.assoc]
  erw [extend_d_eq (reverseColumns Z b) ComplexShape.embeddingDownNat (i := p) (j := p') rfl rfl]
  simp only [comp_f]
  have hout := congrArg (fun k : (reverseColumns Z b).X p ⟶ (reverseColumns Z b).X p =>
    k.f (b - q)) ((reverseColumns Z b).extendXIso ComplexShape.embeddingDownNat
      (i := p) rfl).inv_hom_id
  simp only [comp_f, id_f] at hout
  erw [← Category.assoc _ _ (((reverseColumns Z b).d p p').f (b - q) ≫ _), hout,
    Category.id_comp]
  show ((Z.X p).extendXIso (ComplexShape.embeddingUpIntLE b) rfl).inv ≫
      (extendMap (Z.d p p') (ComplexShape.embeddingUpIntLE b)).f (b - q) ≫ _ = _
  erw [extendMap_f (Z.d p p') (ComplexShape.embeddingUpIntLE b) (i := q) rfl]
  simp

omit [HasCountableCoproducts C] in
private theorem reverseDoubleXIso_inv_d₂
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p q q' : ℕ) :
    (reverseDoubleXIso Z b p q rfl rfl).inv ≫
        ((reverseDouble Z b).X (-(p : ℤ))).d (b - q) (b - q') =
      (Z.X p).d q q' ≫ (reverseDoubleXIso Z b p q' rfl rfl).inv := by
  simp only [reverseDoubleXIso, Iso.trans_inv, Functor.mapIso_inv, eval_map, Category.assoc]
  show _ ≫ ((reverseColumns Z b).extendXIso ComplexShape.embeddingDownNat rfl).inv.f _ ≫
      ((reverseDouble Z b).X (-(p : ℤ))).d _ _ = _
  erw [HomologicalComplex.Hom.comm]
  show _ ≫ ((Z.X p).extend (ComplexShape.embeddingUpIntLE b)).d _ _ ≫ _ = _
  erw [extend_d_eq (Z.X p) (ComplexShape.embeddingUpIntLE b) (i := q) (j := q') rfl rfl]
  simp

private theorem reverseTotalMap_d₁
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p q n : ℕ) (h : p + q = n + 1) :
    (reverseDoubleXIso Z b p q rfl rfl).inv ≫
        (reverseDouble Z b).d₁ (ComplexShape.up ℤ) (-(p : ℤ)) (b - q) (b - n) =
      Z.d₁ (ComplexShape.down ℕ) p q n ≫ reverseTotalMap Z b n := by
  cases p with
  | zero =>
    rw [HomologicalComplex₂.d₁_eq_zero Z _ 0 q n (by simp)]
    have hd : ((reverseDouble Z b).d 0 1).f (b - q) = 0 :=
      (reverseDouble_isZero_XX_of_pos Z b 1 (b - q) (by omega)).eq_of_tgt _ _
    erw [HomologicalComplex₂.d₁_eq' _ _ (show (ComplexShape.up ℤ).Rel 0 1 from rfl), hd]
    simp
  | succ p =>
    have hp : (ComplexShape.up ℤ).Rel (-((p + 1 : ℕ) : ℤ)) (-(p : ℤ)) := by
      show -((p + 1 : ℕ) : ℤ) + 1 = -(p : ℤ)
      omega
    rw [HomologicalComplex₂.d₁_eq _ _ hp _ _ (by change _ + _ = _; omega),
      HomologicalComplex₂.d₁_eq Z _ (show (ComplexShape.down ℕ).Rel (p + 1) p from rfl)
        q n (by change p + q = n; omega)]
    show _ ≫ ((1 : ℤˣ) • _) = ((1 : ℤˣ) • _) ≫ _
    simp only [one_smul]
    rw [← Category.assoc, reverseDoubleXIso_inv_d₁, Category.assoc, Category.assoc,
      ι_reverseTotalMap Z b p q n (by omega)]

private theorem reverseTotalMap_d₂
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (p q n : ℕ) (h : p + q = n + 1) :
    (reverseDoubleXIso Z b p q rfl rfl).inv ≫
        (reverseDouble Z b).d₂ (ComplexShape.up ℤ) (-(p : ℤ)) (b - q) (b - n) =
      Z.d₂ (ComplexShape.down ℕ) p q n ≫ reverseTotalMap Z b n := by
  cases q with
  | zero =>
    rw [HomologicalComplex₂.d₂_eq_zero Z _ p 0 n (by simp)]
    have hd : ((reverseDouble Z b).X (-(p : ℤ))).d (b - (0 : ℕ)) (b - (0 : ℕ) + 1) = 0 :=
      (reverseDouble_isZero_XX_of_lt Z b (-(p : ℤ)) (b - (0 : ℕ) + 1) (by omega)).eq_of_tgt _ _
    rw [HomologicalComplex₂.d₂_eq' _ _ _
      (show (ComplexShape.up ℤ).Rel (b - (0 : ℕ)) (b - (0 : ℕ) + 1) from rfl), hd]
    simp
  | succ q =>
    have hq : (ComplexShape.up ℤ).Rel (b - ((q + 1 : ℕ) : ℤ)) (b - q) := by
      show b - ((q + 1 : ℕ) : ℤ) + 1 = b - q
      omega
    rw [HomologicalComplex₂.d₂_eq _ _ _ hq _ (by change _ + _ = _; omega),
      HomologicalComplex₂.d₂_eq Z _ p
        (show (ComplexShape.down ℕ).Rel (q + 1) q from rfl) n (by change p + q = n; omega)]
    have hs : ComplexShape.ε₂ (ComplexShape.up ℤ) (ComplexShape.up ℤ)
        (ComplexShape.up ℤ) (-(p : ℤ), b - ((q + 1 : ℕ) : ℤ)) =
        ComplexShape.ε₂ (ComplexShape.down ℕ) (ComplexShape.down ℕ)
          (ComplexShape.down ℕ) (p, q + 1) := by
      show (-(p : ℤ)).negOnePow = (-1 : ℤˣ) ^ p
      rw [Int.negOnePow_neg]
      exact Units.ext (Int.coe_negOnePow_natCast p)
    rw [hs, Linear.comp_units_smul, Linear.units_smul_comp]
    congr 1
    rw [← Category.assoc, reverseDoubleXIso_inv_d₂, Category.assoc, Category.assoc,
      ι_reverseTotalMap Z b p q n (by omega)]

private noncomputable def reverseTotalIso
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)) (b : ℤ) :
    Z.total (ComplexShape.down ℕ) ≅
      ((reverseDouble Z b).total (ComplexShape.up ℤ)).restriction
        (ComplexShape.embeddingUpIntLE b) :=
  HomologicalComplex.Hom.isoOfComponents (fun n => reverseTotalXIso Z b n) (by
    intro i j hij
    obtain rfl : j + 1 = i := hij
    apply HomologicalComplex₂.total.hom_ext (ComplexShape.down ℕ)
    intro p q h
    change p + q = j + 1 at h
    change _ ≫ reverseTotalMap Z b (j + 1) ≫ _ = _ ≫ _ ≫ reverseTotalMap Z b j
    rw [← Category.assoc, ι_reverseTotalMap Z b p q (j + 1) h]
    rw [HomologicalComplex.restriction_d]
    rw [HomologicalComplex₂.total_d, HomologicalComplex₂.total_d]
    simp only [Preadditive.comp_add, Preadditive.add_comp, Category.assoc,
      HomologicalComplex₂.ι_D₁_assoc, HomologicalComplex₂.ι_D₂_assoc]
    erw [HomologicalComplex₂.ι_D₁, HomologicalComplex₂.ι_D₂]
    erw [reverseTotalMap_d₁ Z b p q j h, reverseTotalMap_d₂ Z b p q j h])

private noncomputable def reverseTotalHomologyIso
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ))
    (b : ℤ) (i : ℕ) (hi : i ≠ 0) :
    (Z.total (ComplexShape.down ℕ)).homology i ≅
      ((reverseDouble Z b).total (ComplexShape.up ℤ)).homology (b - i) :=
  (HomologicalComplex.homologyFunctor C (ComplexShape.down ℕ) i).mapIso
    (reverseTotalIso Z b) ≪≫
      ((reverseDouble Z b).total (ComplexShape.up ℤ)).restrictionHomologyIso
        (ComplexShape.embeddingUpIntLE b) (i + 1) i (i - 1)
        (by apply ComplexShape.prev_eq'; rfl)
        (by apply ComplexShape.next_eq'; change i - 1 + 1 = i; omega)
        rfl rfl rfl
        (by apply ComplexShape.prev_eq'; change b - ((i + 1 : ℕ) : ℤ) + 1 = b - i; omega)
        (by apply ComplexShape.next_eq'; change b - i + 1 = b - ((i - 1 : ℕ) : ℤ); omega)

private noncomputable abbrev reverseDoubleMap
    {Z Z' : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)}
    (f : Z ⟶ Z') (b : ℤ) : reverseDouble Z b ⟶ reverseDouble Z' b :=
  extendMap ((((ComplexShape.embeddingUpIntLE b).extendFunctor C).mapHomologicalComplex
    (ComplexShape.down ℕ)).map f) ComplexShape.embeddingDownNat

omit [HasCountableCoproducts C] in
private theorem reverseDoubleMap_quasiIso
    {Z Z' : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)}
    (f : Z ⟶ Z') (b p : ℤ) (hf : ∀ i, QuasiIso (f.f i)) :
    QuasiIso ((reverseDoubleMap f b).f p) := by
  by_cases hp : p ≤ 0
  · rw [reverseDoubleMap, extendMap_f _ _ (embeddingDownNat_f_toNat_neg p hp)]
    have h : QuasiIso (extendMap (f.f (-p).toNat) (ComplexShape.embeddingUpIntLE b)) :=
      (quasiIso_extendMap_iff _ _).mpr (hf _)
    exact quasiIso_comp _ _ (hφ' := quasiIso_comp _ _ (hφ := h))
  · have hZ := reverseDouble_isZero_X_of_pos Z b p (by omega)
    have hZ' := reverseDouble_isZero_X_of_pos Z' b p (by omega)
    have : IsIso ((reverseDoubleMap f b).f p) := hZ.isIso hZ' _
    infer_instance

omit [HasCountableCoproducts C] in
private theorem reverseDouble_isZero_XX_of_neg
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)) (b : ℕ)
    (hZ : ∀ p q : ℕ, b < q → IsZero ((Z.X p).X q))
    (p q : ℤ) (hq : q < 0) : IsZero (((reverseDouble Z b).X p).X q) := by
  by_cases hp : p ≤ 0
  · exact (hZ (-p).toNat ((b : ℤ) - q).toNat (by omega)).of_iso
      (reverseDoubleXIso Z b (-p).toNat ((b : ℤ) - q).toNat (by omega) (by omega))
  · exact reverseDouble_isZero_XX_of_pos Z b p q (by omega)

omit [HasCountableCoproducts C] in
private theorem reverseDouble_isZero_X_of_lt
    (Z : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)) (a b : ℕ)
    (hZ : ∀ p : ℕ, a < p → IsZero (Z.X p))
    (p : ℤ) (hp : p < -(a : ℤ)) : IsZero ((reverseDouble Z b).X p) := by
  exact (Functor.map_isZero ((ComplexShape.embeddingUpIntLE b).extendFunctor C)
    (hZ (-p).toNat (by omega))).of_iso
      ((reverseColumns Z b).extendXIso ComplexShape.embeddingDownNat
        (embeddingDownNat_f_toNat_neg p (by omega)))

/-- **Stacks Tag 0133 for bounded chain bicomplexes.** A columnwise quasi-isomorphism of
bounded chain bicomplexes induces an isomorphism on total homology in positive degrees. -/
private noncomputable def totalHomologyIsoOfColumnQuasiIso
    {Z Z' : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)}
    (f : Z ⟶ Z') (a b : ℕ)
    (hp : ∀ p : ℕ, a < p → IsZero (Z.X p))
    (hq : ∀ p q : ℕ, b < q → IsZero ((Z.X p).X q))
    (hp' : ∀ p : ℕ, a < p → IsZero (Z'.X p))
    (hq' : ∀ p q : ℕ, b < q → IsZero ((Z'.X p).X q))
    (hf : ∀ p, QuasiIso (f.f p)) (i : ℕ) (hi : i ≠ 0) :
    (Z.total (ComplexShape.down ℕ)).homology i ≅
      (Z'.total (ComplexShape.down ℕ)).homology i := by
  have : QuasiIso (HomologicalComplex₂.total.map (reverseDoubleMap f b) (ComplexShape.up ℤ)) :=
    StacksDraft.TotalComplexQuasiIso.quasiIso_total_map (reverseDoubleMap f b) (-(a : ℤ))
      (reverseDouble_isZero_XX_of_neg Z b hq) (reverseDouble_isZero_X_of_lt Z a b hp)
      (reverseDouble_isZero_XX_of_neg Z' b hq') (reverseDouble_isZero_X_of_lt Z' a b hp')
      (fun p => reverseDoubleMap_quasiIso f b p hf)
  exact reverseTotalHomologyIso Z b i hi ≪≫
    asIso (homologyMap (HomologicalComplex₂.total.map (reverseDoubleMap f b)
      (ComplexShape.up ℤ)) ((b : ℤ) - i)) ≪≫
    (reverseTotalHomologyIso Z' b i hi).symm

/-- A columnwise quasi-isomorphism of bounded chain bicomplexes preserves vanishing
of positive total homology. -/
private theorem isZero_total_homology_of_column_quasiIso
    {Z Z' : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)}
    (f : Z ⟶ Z') (a b : ℕ)
    (hp : ∀ p : ℕ, a < p → IsZero (Z.X p))
    (hq : ∀ p q : ℕ, b < q → IsZero ((Z.X p).X q))
    (hp' : ∀ p : ℕ, a < p → IsZero (Z'.X p))
    (hq' : ∀ p q : ℕ, b < q → IsZero ((Z'.X p).X q))
    (hf : ∀ p, QuasiIso (f.f p)) (i : ℕ) (hi : i ≠ 0)
    (h : IsZero ((Z.total (ComplexShape.down ℕ)).homology i)) :
    IsZero ((Z'.total (ComplexShape.down ℕ)).homology i) :=
  h.of_iso (totalHomologyIsoOfColumnQuasiIso f a b hp hq hp' hq' hf i hi).symm


/-- A columnwise quasi-isomorphism of bounded chain bicomplexes reflects vanishing of positive
total homology from the target to the source. -/
private theorem isZero_total_homology_of_column_quasiIso'
    {Z Z' : HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)}
    (f : Z ⟶ Z') (a b : ℕ)
    (hp : ∀ p : ℕ, a < p → IsZero (Z.X p))
    (hq : ∀ p q : ℕ, b < q → IsZero ((Z.X p).X q))
    (hp' : ∀ p : ℕ, a < p → IsZero (Z'.X p))
    (hq' : ∀ p q : ℕ, b < q → IsZero ((Z'.X p).X q))
    (hf : ∀ p, QuasiIso (f.f p)) (i : ℕ) (hi : i ≠ 0)
    (h : IsZero ((Z'.total (ComplexShape.down ℕ)).homology i)) :
    IsZero ((Z.total (ComplexShape.down ℕ)).homology i) :=
  h.of_iso (totalHomologyIsoOfColumnQuasiIso f a b hp hq hp' hq' hf i hi)

end Reindex

/-! ### The graded symmetry of `ComplexShape.down ℕ`

Both proofs need the Koszul sign rule `σ p q = (-1)^{pq}` exhibiting `ComplexShape.down ℕ`
as symmetric for the total complex construction.
-/

@[instance_reducible] private def chainTotalSymmetry :
    TotalComplexShapeSymmetry (ComplexShape.down ℕ) (ComplexShape.down ℕ)
      (ComplexShape.down ℕ) where
  symm p q := Nat.add_comm q p
  σ p q := (-1 : ℤˣ) ^ (p * q)
  σ_ε₁ := by
    rintro p p' h q
    change p' + 1 = p at h
    subst p
    change (-1 : ℤˣ) ^ ((p' + 1) * q) * 1 = (-1 : ℤˣ) ^ q * (-1 : ℤˣ) ^ (p' * q)
    rw [add_mul, one_mul, pow_add, mul_one, mul_comm]
  σ_ε₂ := by
    rintro p q q' h
    change q' + 1 = q at h
    subst q
    change (-1 : ℤˣ) ^ (p * (q' + 1)) * (-1 : ℤˣ) ^ p = 1 * (-1 : ℤˣ) ^ (p * q')
    rw [mul_add, mul_one, pow_add, mul_assoc, Int.units_mul_self, mul_one, one_mul]

/-! ## Joining Koszul-regular sequences (Tag 0669)

If `f₁, …, f_n` is Koszul-regular in `A` and the images `ḡ₁, …, ḡ_m` form a Koszul-regular
sequence in `A / (f₁, …, f_n)`, then `f₁, …, f_n, g₁, …, g_m` is Koszul-regular in `A`.
-/

section Append

open scoped TensorProduct

private theorem koszul_exactAt_of_regular {A : Type*} [CommRing A] {n : ℕ}
    {f : Fin n → A} (hf : Koszul.IsKoszulRegular f) (i : ℕ) (hi : i ≠ 0) :
    (Koszul.seqComplex f).ExactAt i := by
  rw [HomologicalComplex.exactAt_iff_isZero_homology]
  exact hf i hi

private theorem koszul_regularOn_of_baseChange_regular {A S : Type*}
    [CommRing A] [CommRing S] [Algebra A S] {n : ℕ} (f : Fin n → A)
    (hf : Koszul.IsKoszulRegular (fun j => algebraMap A S (f j))) :
    Koszul.IsKoszulRegularOn f S := by
  choose β hβ using fun k =>
    KoszulC.extPow_baseChange_natEquiv (R := A) (S := S) (r := n) k
  let e (k : ℕ) : ((⋀[A]^k (Fin n → A)) ⊗[A] S) ≃ₗ[A]
      (⋀[S]^k (Fin n → S)) :=
    (TensorProduct.comm A _ _).trans ((β k).restrictScalars A)
  have he (k : ℕ) (x : (⋀[A]^k (Fin n → A))) (s : S) :
      e k (x ⊗ₜ[A] s) = s • β k (1 ⊗ₜ[A] x) := by
    show β k (s ⊗ₜ[A] x) = _
    rw [← map_smul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have comm (k : ℕ) (x : ((⋀[A]^(k + 1) (Fin n → A)) ⊗[A] S)) :
      e k (LinearMap.rTensor S (Koszul.d (Koszul.seqDual f) k) x) =
        Koszul.d (Koszul.seqDual (fun j => algebraMap A S (f j))) k (e (k + 1) x) := by
    induction x using TensorProduct.induction_on with
    | zero =>
      rw [map_zero (LinearMap.rTensor S (Koszul.d (Koszul.seqDual f) k)),
        show e k 0 = 0 from (e k).map_zero, show e (k + 1) 0 = 0 from (e (k + 1)).map_zero,
        map_zero (Koszul.d (Koszul.seqDual (fun j => algebraMap A S (f j))) k)]
    | tmul x s =>
      rw [LinearMap.rTensor_tmul, he, he, map_smul,
        KoszulC.d_baseChange_comm f β hβ k x]
    | add x y hx hy => simp only [map_add, hx, hy]
  intro i hi
  rw [← HomologicalComplex.exactAt_iff_isZero_homology]
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  rw [HomologicalComplex.exactAt_iff' _ (k + 1 + 1) (k + 1) k
    (by simp) (by simp),
    CategoryTheory.ShortComplex.moduleCat_exact_iff_range_eq_ker]
  have hex := koszul_exactAt_of_regular hf (k + 1) (by omega)
  rw [HomologicalComplex.exactAt_iff' _ (k + 1 + 1) (k + 1) k
    (by simp) (by simp),
    CategoryTheory.ShortComplex.moduleCat_exact_iff_range_eq_ker] at hex
  dsimp only [HomologicalComplex.sc', HomologicalComplex.shortComplexFunctor'] at hex ⊢
  simp only [Koszul.seqComplex_d, ModuleCat.hom_ofHom] at hex
  simp only [Koszul.seqComplexTensor_d, ModuleCat.hom_ofHom]
  change LinearMap.range
      (Koszul.d (Koszul.seqDual (fun j => algebraMap A S (f j))) (k + 1)) =
    LinearMap.ker (Koszul.d (Koszul.seqDual (fun j => algebraMap A S (f j))) k) at hex
  show LinearMap.range (LinearMap.rTensor S (Koszul.d (Koszul.seqDual f) (k + 1))) =
    LinearMap.ker (LinearMap.rTensor S (Koszul.d (Koszul.seqDual f) k))
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    rw [LinearMap.mem_ker]
    apply (e k).injective
    rw [comm, comm, show e k 0 = 0 from (e k).map_zero]
    exact LinearMap.congr_fun (Koszul.d_comp_d _ k) (e (k + 1 + 1) x)
  · intro x hx
    have hx' : e (k + 1) x ∈ LinearMap.ker
        (Koszul.d (Koszul.seqDual (fun j => algebraMap A S (f j))) k) := by
      rw [LinearMap.mem_ker, ← comm, LinearMap.mem_ker.mp hx,
        show e k 0 = 0 from (e k).map_zero]
    obtain ⟨y, hy⟩ := hex.symm ▸ hx'
    refine ⟨(e (k + 1 + 1)).symm y, ?_⟩
    apply (e (k + 1)).injective
    rw [comm, LinearEquiv.apply_symm_apply, hy]

open MonoidalCategory in
private noncomputable def tensorSingleXIso {A : Type*} [CommRing A]
    (K : ChainComplex (ModuleCat A) ℕ) (M : ModuleCat A) (n : ℕ) :
    (HomologicalComplex.tensorObj K
      ((HomologicalComplex.single (ModuleCat A) (.down ℕ) 0).obj M)).X n ≅
        K.X n ⊗ M := by
  let S := (HomologicalComplex.single (ModuleCat A) (.down ℕ) 0).obj M
  let π : ∀ p q : ℕ, p + q = n →
      (MonoidalCategory.tensorObj (K.X p) (S.X q) ⟶
        MonoidalCategory.tensorObj (K.X n) M) :=
    fun p q h => if hq : q = 0 then by
      subst q
      obtain rfl : p = n := by omega
      exact 𝟙 _
    else 0
  refine
    { hom := HomologicalComplex.mapBifunctorDesc π
      inv := HomologicalComplex.ιTensorObj K S n 0 n (Nat.add_zero n)
      hom_inv_id := ?_
      inv_hom_id := ?_ }
  · apply HomologicalComplex.mapBifunctor.hom_ext
    intro p q h
    rw [← Category.assoc, HomologicalComplex.ι_mapBifunctorDesc]
    by_cases hq : q = 0
    · subst q
      obtain rfl : p = n := by omega
      simp only [π, dite_eq_left, Category.comp_id]
      erw [Category.id_comp]
    · have hz := (tensorLeft (K.X p)).map_isZero
        (HomologicalComplex.isZero_single_obj_X (.down ℕ) 0 M q hq)
      exact hz.eq_of_src _ _
  · change HomologicalComplex.ιMapBifunctor K S (curriedTensor (ModuleCat A))
      (.down ℕ) n 0 n (Nat.add_zero n) ≫ HomologicalComplex.mapBifunctorDesc π = _
    rw [HomologicalComplex.ι_mapBifunctorDesc]
    simp only [π, dite_eq_left]
    rfl

open MonoidalCategory in
private noncomputable def tensorSingleIso {A : Type*} [CommRing A]
    (K : ChainComplex (ModuleCat A) ℕ) (M : ModuleCat A) :
    ((tensorRight M).mapHomologicalComplex (.down ℕ)).obj K ≅
      HomologicalComplex.tensorObj K
        ((HomologicalComplex.single (ModuleCat A) (.down ℕ) 0).obj M) := by
  let S := (HomologicalComplex.single (ModuleCat A) (.down ℕ) 0).obj M
  refine HomologicalComplex.Hom.isoOfComponents
    (fun n => (tensorSingleXIso K M n).symm) ?_
  intro i j hij
  change HomologicalComplex.ιTensorObj K S i 0 i (Nat.add_zero i) ≫
    (HomologicalComplex.tensorObj K S).d i j =
      (tensorRight M).map (K.d i j) ≫
        HomologicalComplex.ιTensorObj K S j 0 j (Nat.add_zero j)
  rw [HomologicalComplex.mapBifunctor.d_eq, Preadditive.comp_add,
    HomologicalComplex.mapBifunctor.ι_D₁, HomologicalComplex.mapBifunctor.ι_D₂,
    HomologicalComplex.mapBifunctor.d₂_eq_zero _ _ _ _ i 0 j (by simp), add_zero,
    HomologicalComplex.mapBifunctor.d₁_eq _ _ _ _ hij 0 j (Nat.add_zero j)]
  rw [show ComplexShape.ε₁ (.down ℕ) (.down ℕ) (.down ℕ) (i, 0) = 1 from rfl,
    one_smul]
  rfl

open MonoidalCategory in
private noncomputable def koszulTensorFunctorIso {A : Type*} [CommRing A]
    {n : ℕ} (f : Fin n → A) (M : ModuleCat A) :
    Koszul.seqComplexTensor f M ≅
      ((tensorRight M).mapHomologicalComplex (.down ℕ)).obj (Koszul.seqComplex f) := by
  refine HomologicalComplex.Hom.isoOfComponents (fun _ => Iso.refl _) ?_
  intro i j hij
  obtain rfl : i = j + 1 := hij.symm
  simp only [Iso.refl_hom,
    Functor.mapHomologicalComplex_obj_d, Koszul.seqComplexTensor_d, Koszul.seqComplex_d]
  rfl

open MonoidalCategory in
private theorem koszul_tensor_single_regular {A S : Type u}
    [CommRing A] [CommRing S] [Algebra A S] {n : ℕ} (f : Fin n → A)
    (hf : Koszul.IsKoszulRegular (fun j => algebraMap A S (f j))) (i : ℕ) (hi : i ≠ 0) :
    IsZero ((HomologicalComplex.tensorObj (Koszul.seqComplex f)
      ((HomologicalComplex.single (ModuleCat A) (.down ℕ) 0).obj
        (ModuleCat.of A S))).homology i) := by
  let e := koszulTensorFunctorIso f (ModuleCat.of A S) ≪≫
    tensorSingleIso (Koszul.seqComplex f) (ModuleCat.of A S)
  exact (koszul_regularOn_of_baseChange_regular f hf i hi).of_iso
    ((HomologicalComplex.homologyFunctor _ _ i).mapIso e).symm

open MonoidalCategory in
private noncomputable def tensorCommIso {A : Type u} [CommRing A]
    (K L : ChainComplex (ModuleCat A) ℕ) :
    HomologicalComplex.tensorObj K L ≅ HomologicalComplex.tensorObj L K := by
  letI := chainTotalSymmetry
  let F := curriedTensor (ModuleCat A)
  let B := F.mapBifunctorHomologicalComplex (.down ℕ) (.down ℕ)
  let B' := F.flip.mapBifunctorHomologicalComplex (.down ℕ) (.down ℕ)
  let e : (B.obj K).obj L ≅ (B'.obj K).obj L :=
    HomologicalComplex.Hom.isoOfComponents
      (fun p => (NatIso.mapHomologicalComplex
        (BraidedCategory.tensorLeftIsoTensorRight (K.X p)) (.down ℕ)).app L)
      (by
        intro p p' h
        apply HomologicalComplex.Hom.ext
        funext q
        exact (BraidedCategory.braiding_naturality_left (K.d p p') (L.X q)).symm)
  exact HomologicalComplex₂.total.mapIso e (.down ℕ) ≪≫
    HomologicalComplex.mapBifunctorFlipIso L K F (.down ℕ)

open MonoidalCategory in
private theorem koszul_tensor_exactAt {A : Type u} [CommRing A] {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (hf : Koszul.IsKoszulRegular f)
    (hg : Koszul.IsKoszulRegular
      (fun j => Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j))) (k : ℕ) :
    (HomologicalComplex.tensorObj (Koszul.seqComplex g) (Koszul.seqComplex f)).ExactAt
      (k + 1) := by
  let Q := ModuleCat.of A (A ⧸ Ideal.span (Set.range f))
  let S := (ChainComplex.single₀ (ModuleCat.{u} A)).obj Q
  let B := ((curriedTensor (ModuleCat A)).mapBifunctorHomologicalComplex
    (.down ℕ) (.down ℕ)).obj (Koszul.seqComplex g)
  have hp (L : ChainComplex (ModuleCat A) ℕ) (p : ℕ) (hp : m < p) :
      IsZero ((B.obj L).X p) := by
    apply (IsZero.iff_id_eq_zero _).mpr
    apply HomologicalComplex.Hom.ext
    funext q
    exact ((tensorRight (L.X q)).map_isZero (koszul_isZero_X_of_lt g p hp)).eq_of_src _ _
  have hq (p q : ℕ) (hq : n < q) :
      IsZero (((B.obj (Koszul.seqComplex f)).X p).X q) :=
    (tensorLeft ((Koszul.seqComplex g).X p)).map_isZero (koszul_isZero_X_of_lt f q hq)
  have hq' (p q : ℕ) (hq : n < q) : IsZero (((B.obj S).X p).X q) :=
    (tensorLeft ((Koszul.seqComplex g).X p)).map_isZero
      (HomologicalComplex.isZero_single_obj_X (.down ℕ) 0 Q q (by omega))
  have hφ (p : ℕ) : QuasiIso ((B.map (Koszul.koszulAugmentation f)).f p) := by
    have : Module.Free A ((Koszul.seqComplex g).X p) :=
      Module.Free.of_basis ((Pi.basisFun A (Fin m)).exteriorPower p)
    have : Module.Flat A ((Koszul.seqComplex g).X p) := inferInstance
    have := koszulAugmentation_quasiIso f hf
    have : (tensorLeft ((Koszul.seqComplex g).X p)).PreservesHomology := inferInstance
    show QuasiIso (((tensorLeft ((Koszul.seqComplex g).X p)).mapHomologicalComplex
      (.down ℕ)).map (Koszul.koszulAugmentation f))
    infer_instance
  rw [HomologicalComplex.exactAt_iff_isZero_homology]
  refine isZero_total_homology_of_column_quasiIso' (B.map (Koszul.koszulAugmentation f)) m n
    (hp _) hq (hp S) hq' hφ (k + 1) (by omega) ?_
  exact koszul_tensor_single_regular g hg (k + 1) (by omega)

/-- If `f` is Koszul-regular and the image of `g` modulo the ideal generated by `f` is
Koszul-regular, then the concatenation of `f` and `g` is Koszul-regular. -/
@[stacks 0669]
public theorem koszul_regular_append {A : Type*} [CommRing A] {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A)
    (hf : Koszul.IsKoszulRegular f)
    (hg : Koszul.IsKoszulRegular
      (fun j => Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j))) :
    Koszul.IsKoszulRegular (Fin.append f g) := by
  classical
  intro i hi
  obtain ⟨e⟩ := seqComplex_append_iso_totTensor f g
  apply IsZero.of_iso _ ((HomologicalComplex.homologyFunctor _ _ i).mapIso e)
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  have h := (koszul_tensor_exactAt f g hf hg k).isZero_homology
  exact h.of_iso ((HomologicalComplex.homologyFunctor _ _ (k + 1)).mapIso
    (tensorCommIso (Koszul.seqComplex f) (Koszul.seqComplex g)))

end Append

end Koszul

