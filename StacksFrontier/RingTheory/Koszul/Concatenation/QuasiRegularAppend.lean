@[expose] public section

/-! # Adjoining an H₁-regular sequence to a quasi-regular one

This part of `StacksFrontier.RingTheory.Koszul.Concatenation` contains the coefficient calculus of
the quasi-regular canonical map and the proof of Stacks Tag 0667
(`Koszul.isQuasiRegular_append_of_isH1Regular_quotient`).
-/

namespace Koszul

universe u

open CategoryTheory CategoryTheory.Limits

/-! ## Adjoining an H₁-regular sequence to a quasi-regular one (Tag 0667)

If `f₁, …, f_n` is quasi-regular in `A` and the images `ḡ₁, …, ḡ_m` form an H₁-regular sequence
in `A / (f₁, …, f_n)`, then `f₁, …, f_n, g₁, …, g_m` is quasi-regular in `A`.

Quasi-regularity is the bijectivity of the canonical map of Tag 061N from
`(A/I)[X₁, …, X_c] ⊗ M/IM` to `⨁_n I^n M / I^{n+1} M`, and the coefficient calculus for that map
assembled in the first subsection below is shared with Tag 066A.
-/

section QuasiRegularAppend

open RingTheory.Sequence

/-! ### The coefficient calculus of the quasi-regular canonical map

Reading an element of the source as a finite family of monomials `X^e ⊗ m̄_e` turns injectivity
of the canonical map into a degreewise statement: a relation `∑_{|e| = n} f^e · m_e ∈ J^{n+1}M`
among monomials of one total degree forces every coefficient `m_e` into `JM`. Both Tag 0667 and
Tag 066A below argue through this reformulation.
-/

/-! ### Monomials of a fixed total degree

For an ideal generated by `f₁, …, f_c` the power `J^n` is generated by the monomials `f^e` with
`|e| = n`, so a membership in `J^n` can be written as a sum over `degreeMonomials c n`.
-/

section IdealCoefficients

variable {R : Type*} [CommRing R] {c : ℕ}

private theorem bijective_quasiRegularCanonicalMap_congr {c c' : ℕ} (h : c' = c)
    (f : Fin c → R) (f' : Fin c' → R) (hf : ∀ i : Fin c', f' i = f (Fin.cast h i)) :
    Function.Bijective (quasiRegularCanonicalMap (M := R) f') ↔
      Function.Bijective (quasiRegularCanonicalMap (M := R) f) := by
  subst h
  rw [show f' = f from funext hf]

private theorem isQuasiRegular_ofFn_iff (f : Fin c → R) :
    IsQuasiRegular R (List.ofFn f) ↔
      Function.Bijective (quasiRegularCanonicalMap (M := R) f) :=
  bijective_quasiRegularCanonicalMap_congr (List.length_ofFn (f := f)) f
    (fun i : Fin (List.ofFn f).length => (List.ofFn f)[i]) fun i => List.get_ofFn f i

private noncomputable abbrev degreeMonomials (c n : ℕ) : Finset (Fin c →₀ ℕ) :=
  (Finset.Nat.antidiagonalTuple c n).map Finsupp.equivFunOnFinite.symm.toEmbedding

private theorem mem_degreeMonomials (n : ℕ) (e : Fin c →₀ ℕ) :
    e ∈ degreeMonomials c n ↔ qrMdeg e = n := by
  classical
  simp [degreeMonomials, Finset.Nat.mem_antidiagonalTuple, qrMdeg,
    Finsupp.equivFunOnFinite]

/-- A monomial `f^e` with `e` of total degree `n` lies in `J^n`. -/
private theorem fpow_mem_pow_of_mem_degreeMonomials (f : Fin c → R) {n : ℕ} {e : Fin c →₀ ℕ}
    (he : e ∈ degreeMonomials c n) : fpow f e ∈ Jid f ^ n :=
  (mem_degreeMonomials n e).mp he ▸ fpow_mem f e

private theorem pow_eq_span_degreeMonomials (f : Fin c → R) (n : ℕ) :
    Jid f ^ n = Ideal.span (Set.range fun e : {e // e ∈ degreeMonomials c n} =>
      fpow f e.val) := by
  rw [Jid_pow_eq_span]
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_range, Subtype.exists, mem_degreeMonomials]
  aesop

private theorem exists_sum_fpow_mul_of_mem_mul (f : Fin c → R) (n : ℕ)
    (L : Ideal R) {x : R} (hx : x ∈ Jid f ^ n * L) :
    ∃ a : (Fin c →₀ ℕ) → R, (∀ e, a e ∈ L) ∧
      x = ∑ e ∈ degreeMonomials c n, fpow f e * a e := by
  classical
  rw [mul_comm, pow_eq_span_degreeMonomials] at hx
  obtain ⟨a, ha, hsum⟩ :=
    (Submodule.mem_ideal_smul_span_iff_exists_sum L
      (fun e : {e // e ∈ degreeMonomials c n} => fpow f e.val) x).mp hx
  refine ⟨fun e => if h : e ∈ degreeMonomials c n then a ⟨e, h⟩ else 0, ?_, ?_⟩
  · intro e
    dsimp only
    split_ifs with h
    · exact ha _
    · exact L.zero_mem
  · rw [← hsum, Finsupp.sum_fintype]
    · rw [Finset.sum_subtype (degreeMonomials c n) (fun _ => Iff.rfl)]
      exact Finset.sum_congr rfl fun e _ => by
        dsimp only
        rw [dite_eq_left e.property, smul_eq_mul, mul_comm]
    · intro e
      simp

private theorem exists_sum_fpow_mul_of_mem_pow (f : Fin c → R) (n : ℕ)
    {x : R} (hx : x ∈ Jid f ^ n) :
    ∃ a : (Fin c →₀ ℕ) → R,
      x = ∑ e ∈ degreeMonomials c n, fpow f e * a e := by
  obtain ⟨a, _, ha⟩ := exists_sum_fpow_mul_of_mem_mul f n ⊤ (by simpa using hx)
  exact ⟨a, ha⟩

private theorem coeff_mem_of_sum_mem_pow_succ {f : Fin c → R}
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (n : ℕ) (a : (Fin c →₀ ℕ) → R)
    (ha : (∑ e ∈ degreeMonomials c n, fpow f e * a e) ∈ Jid f ^ (n + 1))
    (e : Fin c →₀ ℕ) (he : qrMdeg e = n) : a e ∈ Jid f := by
  simpa using mem_of_sum_fpow_smul_mem hf n (degreeMonomials c n) a
    (fun e he => (mem_degreeMonomials n e).mp he)
    (by simpa [JpowM, smul_eq_mul] using ha) e ((mem_degreeMonomials n e).mpr he)

private theorem coeff_mem_of_sum_mem_mul {f : Fin c → R}
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (n : ℕ) (L : Ideal R) (hL : Jid f ≤ L) (a : (Fin c →₀ ℕ) → R)
    (ha : (∑ e ∈ degreeMonomials c n, fpow f e * a e) ∈ Jid f ^ n * L)
    (e : Fin c →₀ ℕ) (he : qrMdeg e = n) : a e ∈ L := by
  obtain ⟨b, hb, hab⟩ := exists_sum_fpow_mul_of_mem_mul f n L ha
  have hzero : (∑ e ∈ degreeMonomials c n, fpow f e * (a e - b e)) = 0 := by
    simp only [mul_sub, Finset.sum_sub_distrib]
    exact sub_eq_zero.mpr hab
  have hmem := coeff_mem_of_sum_mem_pow_succ hf n (fun e => a e - b e)
    (hzero ▸ (Jid f ^ (n + 1)).zero_mem) e he
  exact (L.sub_mem_iff_left (hb e)).mp (hL hmem)

end IdealCoefficients

/-! ### Lifting Koszul relations along the quotient map

`Koszul.exists_lift_relSpan` (Tag 0665) lifts a Koszul relation for the reduced sequence; the
lemmas here iterate that lift along the filtration by powers of `J`.
-/

section Relations

variable {R : Type*} [CommRing R] {n m : ℕ}

private theorem map_mem_relSpan (I : Ideal R) (g : Fin m → R)
    {a : Fin m → R} (ha : a ∈ Koszul.relSpan g) :
    (fun j => Ideal.Quotient.mk I (a j)) ∈
      Koszul.relSpan (fun j => Ideal.Quotient.mk I (g j)) := by
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨⟨i, j⟩, rfl⟩ := ha
    simpa only [Koszul.mk_trivRel] using
      Koszul.trivRel_mem_relSpan (fun j => Ideal.Quotient.mk I (g j)) i j
  | zero =>
    convert (Koszul.relSpan (fun j => Ideal.Quotient.mk I (g j))).zero_mem using 1
    ext j
    simp
  | add a b _ _ ha hb =>
    convert Submodule.add_mem _ ha hb using 1
    ext j
    simp only [Pi.add_apply, map_add]
  | smul c a _ ha =>
    convert Submodule.smul_mem _ (Ideal.Quotient.mk I c) ha using 1
    ext j
    simp only [Pi.smul_apply, smul_eq_mul, map_mul]

private theorem exists_relSpan_sub_mem (I : Ideal R) (g : Fin m → R)
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk I (g j)))
    (a : Fin m → R) (ha : (∑ j, a j * g j) ∈ I) :
    ∃ b ∈ Koszul.relSpan g, ∀ j, a j - b j ∈ I := by
  have hrel : (∑ j, Ideal.Quotient.mk I (a j) * Ideal.Quotient.mk I (g j)) = 0 := by
    simpa only [map_sum, map_mul] using (Ideal.Quotient.eq_zero_iff_mem.mpr ha)
  obtain ⟨b, hb, hab⟩ := Koszul.exists_lift_relSpan I g
    ((Koszul.isH1Regular_iff_forall _).mp hg _ hrel)
  refine ⟨b, hb, fun j => ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, congrFun hab j, sub_self]

private theorem exists_relSpan_sub_mem_pow_succ (f : Fin n → R) (g : Fin m → R)
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f) (g j)))
    (k : ℕ) (a : Fin m → R) (ha : ∀ j, a j ∈ Jid f ^ k)
    (hrel : (∑ j, a j * g j) ∈ Jid f ^ (k + 1)) :
    ∃ b ∈ Koszul.relSpan g, ∀ j, a j - b j ∈ Jid f ^ (k + 1) := by
  classical
  choose c hc using fun j => exists_sum_fpow_mul_of_mem_pow f k (ha j)
  have hsum : (∑ e ∈ degreeMonomials n k, fpow f e * (∑ j, c j e * g j)) =
      ∑ j, a j * g j := by
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    rw [hc j, Finset.sum_mul]
    exact Finset.sum_congr rfl fun e _ => (mul_assoc _ _ _).symm
  have hcoeff (e : {e // e ∈ degreeMonomials n k}) : (∑ j, c j e * g j) ∈ Jid f :=
    coeff_mem_of_sum_mem_pow_succ hf k (fun e => ∑ j, c j e * g j)
      (hsum ▸ hrel) e ((mem_degreeMonomials k e.val).mp e.property)
  choose b hb hab using fun e : {e // e ∈ degreeMonomials n k} =>
    exists_relSpan_sub_mem (Jid f) g hg (fun j => c j e) (hcoeff e)
  refine ⟨∑ e, fpow f e.val • b e, Submodule.sum_mem _ (fun e _ =>
    Submodule.smul_mem _ _ (hb e)), fun j => ?_⟩
  have hdiff : a j - (∑ e, fpow f e.val • b e) j =
      ∑ e : {e // e ∈ degreeMonomials n k}, fpow f e.val * (c j e.val - b e j) := by
    rw [hc j, ← Finset.sum_attach]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_sub,
      Finset.sum_sub_distrib]
    rfl
  rw [hdiff, pow_succ]
  exact Submodule.sum_mem _ fun e _ => Ideal.mul_mem_mul
    (fpow_mem_pow_of_mem_degreeMonomials f e.property)
    (hab e j)

private theorem exists_relSpan_sub_mem_pow (f : Fin n → R) (g : Fin m → R)
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f) (g j)))
    (k : ℕ) (a : Fin m → R) (hrel : (∑ j, a j * g j) ∈ Jid f ^ k) :
    ∃ b ∈ Koszul.relSpan g, ∀ j, a j - b j ∈ Jid f ^ k := by
  induction k with
  | zero => exact ⟨0, Submodule.zero_mem _, by simp⟩
  | succ k ih =>
    obtain ⟨b, hb, hab⟩ := ih (Ideal.pow_le_pow_right (Nat.le_succ k) hrel)
    have hbrel : (∑ j, b j * g j) = 0 := Koszul.relSpan_le_ker g hb
    have hdiff : (∑ j, (a j - b j) * g j) = ∑ j, a j * g j := by
      simp only [sub_mul, Finset.sum_sub_distrib, hbrel, sub_zero]
    obtain ⟨b', hb', hab'⟩ := exists_relSpan_sub_mem_pow_succ f g hf hg k
      (fun j => a j - b j) hab (hdiff ▸ hrel)
    refine ⟨b + b', Submodule.add_mem _ hb hb', fun j => ?_⟩
    simpa only [Pi.add_apply, sub_sub] using hab' j

private theorem isH1Regular_quotient_pow (f : Fin n → R) (g : Fin m → R)
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f) (g j))) (k : ℕ) :
    Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f ^ k) (g j)) := by
  rw [Koszul.isH1Regular_iff_forall]
  intro a ha
  choose a' haa using fun j => Ideal.Quotient.mk_surjective (a j)
  have hrel : (∑ j, a' j * g j) ∈ Jid f ^ k := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sum]
    simpa only [map_mul, haa] using ha
  obtain ⟨b, hb, hab⟩ := exists_relSpan_sub_mem_pow f g hf hg k a' hrel
  have heq : (fun j => Ideal.Quotient.mk (Jid f ^ k) (b j)) = a := by
    funext j
    have h := (Ideal.Quotient.eq_zero_iff_mem).mpr (hab j)
    rw [map_sub, sub_eq_zero, haa] at h
    exact h.symm
  rw [← heq]
  exact map_mem_relSpan _ g hb

end Relations

/-! ### Coefficients modulo the second ideal -/

section QuotientCoefficients

variable {R : Type*} [CommRing R] {n m : ℕ}

private theorem Jid_map (g : Fin m → R) {S : Type*} [CommRing S] (q : R →+* S) :
    Jid (fun j => q (g j)) = Ideal.map q (Jid g) := by
  simp only [Jid, Ideal.map_span, ← Set.range_comp, Function.comp_def]

private theorem fpow_map (g : Fin m → R) {S : Type*} [CommRing S]
    (q : R →+* S) (e : Fin m →₀ ℕ) :
    fpow (fun j => q (g j)) e = q (fpow g e) := by
  simp only [fpow, map_prod, map_pow]

private theorem mem_sup_iff_mk_mem_map (I L : Ideal R) (x : R) :
    x ∈ L ⊔ I ↔ Ideal.Quotient.mk I x ∈ Ideal.map (Ideal.Quotient.mk I) L := by
  rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
  show x ∈ L ⊔ I ↔ x ∈ L ⊔ RingHom.ker (Ideal.Quotient.mk I)
  rw [Ideal.mk_ker]

private theorem coeff_mem_sup_of_sum_mem_sup (g : Fin m → R) (I : Ideal R)
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk I (g j)))
    (k : ℕ) (a : (Fin m →₀ ℕ) → R)
    (ha : (∑ e ∈ degreeMonomials m k, fpow g e * a e) ∈ Jid g ^ (k + 1) ⊔ I)
    (e : Fin m →₀ ℕ) (he : qrMdeg e = k) : a e ∈ Jid g ⊔ I := by
  let q := Ideal.Quotient.mk I
  have hqr := Koszul.isQuasiRegular_of_isH1RegularOn
    ((Koszul.isH1RegularOn_self_iff _).mpr hg)
  have hinj := ((isQuasiRegular_ofFn_iff _).mp hqr).1
  apply (mem_sup_iff_mk_mem_map I (Jid g) _).mpr
  rw [← Jid_map]
  apply coeff_mem_of_sum_mem_pow_succ hinj k (fun e => q (a e)) _ e he
  have h := (mem_sup_iff_mk_mem_map I (Jid g ^ (k + 1)) _).mp ha
  simpa only [Ideal.map_pow, ← Jid_map, map_sum, map_mul, ← fpow_map] using h

private theorem mem_pow_mul_sup_of_mem_sup (f : Fin n → R) (g : Fin m → R)
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f) (g j)))
    (k : ℕ) {x : R} (hx : x ∈ Jid f ^ k)
    (hx' : x ∈ Jid g ⊔ Jid f ^ (k + 1)) :
    x ∈ Jid f ^ k * (Jid f ⊔ Jid g) := by
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx'
  have hz' : z ∈ Jid f ^ k := Ideal.pow_le_pow_right (Nat.le_succ k) hz
  have hy' : y ∈ Jid f ^ k := (Submodule.add_mem_iff_left _ hz').mp hx
  have hint := Koszul.inf_span_eq_smul_span (Jid f ^ k) g
    (isH1Regular_quotient_pow f g hf hg k)
  have hymul : y ∈ Jid f ^ k * Jid g := by
    show y ∈ Jid f ^ k * Ideal.span (Set.range g)
    rw [← hint]
    exact ⟨hy', hy⟩
  exact Submodule.add_mem _
    ((Ideal.mul_mono_right le_sup_right) hymul)
    ((Ideal.mul_mono_right le_sup_left) (by simpa only [← pow_succ] using hz))

end QuotientCoefficients

/-! ### Splitting the exponents of a concatenated sequence -/

section Exponents

variable {n m : ℕ}

private noncomputable abbrev leftExponent (e : Fin (n + m) →₀ ℕ) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun i => e (Fin.castAdd m i))

private noncomputable abbrev rightExponent (e : Fin (n + m) →₀ ℕ) : Fin m →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun j => e (Fin.natAdd n j))

private noncomputable abbrev appendExponent (u : Fin n →₀ ℕ) (v : Fin m →₀ ℕ) :
    Fin (n + m) →₀ ℕ := Finsupp.equivFunOnFinite.symm (Fin.append u v)

private theorem leftExponent_append (u : Fin n →₀ ℕ) (v : Fin m →₀ ℕ) :
    leftExponent (appendExponent u v) = u := by
  ext i
  simp [leftExponent, appendExponent]

private theorem rightExponent_append (u : Fin n →₀ ℕ) (v : Fin m →₀ ℕ) :
    rightExponent (appendExponent u v) = v := by
  ext j
  simp [rightExponent, appendExponent]

private theorem appendExponent_left_right (e : Fin (n + m) →₀ ℕ) :
    appendExponent (leftExponent e) (rightExponent e) = e := by
  ext i
  refine Fin.addCases (fun i => ?_) (fun j => ?_) i <;>
    simp [appendExponent, leftExponent, rightExponent]

private theorem qrMdeg_left_add_right (e : Fin (n + m) →₀ ℕ) :
    qrMdeg (leftExponent e) + qrMdeg (rightExponent e) = qrMdeg e := by
  simp only [qrMdeg, leftExponent, rightExponent, Finsupp.equivFunOnFinite_symm_apply_apply]
  exact (Fin.sum_univ_add _).symm

private theorem qrMdeg_append (u : Fin n →₀ ℕ) (v : Fin m →₀ ℕ) :
    qrMdeg (appendExponent u v) = qrMdeg u + qrMdeg v := by
  rw [← qrMdeg_left_add_right, leftExponent_append, rightExponent_append]

private theorem fpow_append {R : Type*} [CommRing R] (f : Fin n → R) (g : Fin m → R)
    (u : Fin n →₀ ℕ) (v : Fin m →₀ ℕ) :
    fpow (Fin.append f g) (appendExponent u v) = fpow f u * fpow g v := by
  simp [fpow, appendExponent, Fin.prod_univ_add]

private theorem fpow_left_mul_right {R : Type*} [CommRing R] (f : Fin n → R)
    (g : Fin m → R) (e : Fin (n + m) →₀ ℕ) :
    fpow (Fin.append f g) e = fpow f (leftExponent e) * fpow g (rightExponent e) := by
  rw [← fpow_append, appendExponent_left_right]

private theorem sum_filter_right_degree {B : Type*} [AddCommMonoid B]
    (d k : ℕ) (hk : k ≤ d) (h : (Fin (n + m) →₀ ℕ) → B) :
    (∑ e ∈ degreeMonomials (n + m) d with qrMdeg (rightExponent e) = k, h e) =
      ∑ v ∈ degreeMonomials m k, ∑ u ∈ degreeMonomials n (d - k),
        h (appendExponent u v) := by
  classical
  trans ∑ p ∈ (degreeMonomials m k).product (degreeMonomials n (d - k)),
    h (appendExponent p.2 p.1)
  · apply Finset.sum_bij (fun e _ => (rightExponent e, leftExponent e))
    · intro e he
      obtain ⟨he, hr⟩ := Finset.mem_filter.mp he
      rw [mem_degreeMonomials] at he
      refine Finset.mem_product.mpr ⟨(mem_degreeMonomials k _).mpr hr,
        (mem_degreeMonomials (d - k) (leftExponent e)).mpr ?_⟩
      have hdeg := qrMdeg_left_add_right e
      omega
    · intro e he e' he' hee
      have hl := congrArg Prod.snd hee
      have hr := congrArg Prod.fst hee
      dsimp only at hl hr
      rw [← appendExponent_left_right e, ← appendExponent_left_right e', hl, hr]
    · intro p hp
      obtain ⟨hv, hu⟩ := Finset.mem_product.mp hp
      rw [mem_degreeMonomials] at hu hv
      refine ⟨appendExponent p.2 p.1, ?_, ?_⟩
      · rw [Finset.mem_filter, mem_degreeMonomials, qrMdeg_append,
          rightExponent_append, hu, hv]
        exact ⟨by omega, rfl⟩
      · simp only [leftExponent_append, rightExponent_append]
    · intro e he
      rw [appendExponent_left_right]
  · exact Finset.sum_product _ _ _

end Exponents

/-! ### The concatenated sequence -/

section Concatenation

variable {R : Type*} [CommRing R] {n m : ℕ}

private theorem Jid_append (f : Fin n → R) (g : Fin m → R) :
    Jid (Fin.append f g) = Jid f ⊔ Jid g := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    refine Fin.addCases (fun i => ?_) (fun j => ?_) i
    · rw [Fin.append_left]
      exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)
    · rw [Fin.append_right]
      exact Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)
  · apply sup_le
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact Ideal.subset_span ⟨Fin.castAdd m i, Fin.append_left _ _ _⟩
    · apply Ideal.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact Ideal.subset_span ⟨Fin.natAdd n j, Fin.append_right _ _ _⟩

/-- A monomial of `f ++ g` with a large enough `g`-part or `f`-part lies in the ideal
`J(g)^(k+1) ⊔ J(f)^(d-k+1)`. -/
private theorem fpow_append_mem_sup (f : Fin n → R) (g : Fin m → R) (d k : ℕ)
    (e : Fin (n + m) →₀ ℕ)
    (h : k + 1 ≤ qrMdeg (rightExponent e) ∨ d - k + 1 ≤ qrMdeg (leftExponent e)) :
    fpow (Fin.append f g) e ∈ Jid g ^ (k + 1) ⊔ Jid f ^ (d - k + 1) := by
  rw [fpow_left_mul_right]
  rcases h with hr | hl
  · exact Ideal.mem_sup_left ((Jid g ^ (k + 1)).mul_mem_left _
      (Ideal.pow_le_pow_right hr (fpow_mem g (rightExponent e))))
  · exact Ideal.mem_sup_right ((Jid f ^ (d - k + 1)).mul_mem_right _
      (Ideal.pow_le_pow_right hl (fpow_mem f (leftExponent e))))

private theorem pow_append_le_sup (f : Fin n → R) (g : Fin m → R)
    (d k : ℕ) (hk : k ≤ d) :
    Jid (Fin.append f g) ^ (d + 1) ≤
      Jid g ^ (k + 1) ⊔ Jid f ^ (d - k + 1) := by
  rw [Jid_pow_eq_span]
  apply Ideal.span_le.mpr
  rintro _ ⟨e, he, rfl⟩
  have hdeg := qrMdeg_left_add_right e
  exact fpow_append_mem_sup f g d k e (by omega)

private theorem sum_filter_right_degree_ne_mem (f : Fin n → R) (g : Fin m → R)
    (d k : ℕ) (hk : k ≤ d) (a : (Fin (n + m) →₀ ℕ) → R)
    (ih : ∀ k' < k, k' ≤ d → ∀ e ∈ degreeMonomials (n + m) d,
      qrMdeg (rightExponent e) = k' → a e ∈ Jid (Fin.append f g)) :
    (∑ e ∈ degreeMonomials (n + m) d with ¬ qrMdeg (rightExponent e) = k,
      fpow (Fin.append f g) e * a e) ∈ Jid g ^ (k + 1) ⊔ Jid f ^ (d - k + 1) := by
  refine Submodule.sum_mem _ fun e he => ?_
  obtain ⟨he, hne⟩ := Finset.mem_filter.mp he
  have hdeg := (mem_degreeMonomials d e).mp he
  by_cases hlt : qrMdeg (rightExponent e) < k
  · apply pow_append_le_sup f g d k hk
    rw [pow_succ]
    exact Ideal.mul_mem_mul (fpow_mem_pow_of_mem_degreeMonomials _ he)
      (ih _ hlt (by omega) e he rfl)
  · have hge : k + 1 ≤ qrMdeg (rightExponent e) := by omega
    exact Ideal.mul_mem_right _ _ (fpow_append_mem_sup f g d k e (Or.inl hge))

private theorem inner_sum_mem_pow_mul_sup (f : Fin n → R) (g : Fin m → R)
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f) (g j)))
    (d k : ℕ) (a : (Fin (n + m) →₀ ℕ) → R)
    (hgroup : (∑ v ∈ degreeMonomials m k, fpow g v *
      ∑ u ∈ degreeMonomials n (d - k), fpow f u * a (appendExponent u v)) ∈
        Jid g ^ (k + 1) ⊔ Jid f ^ (d - k + 1))
    (v : Fin m →₀ ℕ) (hv : qrMdeg v = k) :
    (∑ u ∈ degreeMonomials n (d - k), fpow f u * a (appendExponent u v)) ∈
      Jid f ^ (d - k) * (Jid f ⊔ Jid g) := by
  apply mem_pow_mul_sup_of_mem_sup f g hf hg (d - k)
  · exact Submodule.sum_mem _ fun u hu => (Jid f ^ (d - k)).mul_mem_right _
      (fpow_mem_pow_of_mem_degreeMonomials f hu)
  · exact coeff_mem_sup_of_sum_mem_sup g (Jid f ^ (d - k + 1))
      (isH1Regular_quotient_pow f g hf hg _) k
      (fun v => ∑ u ∈ degreeMonomials n (d - k), fpow f u * a (appendExponent u v)) hgroup v hv

private theorem coeff_mem_append (f : Fin n → R) (g : Fin m → R)
    (hf : Function.Injective (quasiRegularCanonicalMap (M := R) f))
    (hg : Koszul.IsH1Regular (fun j => Ideal.Quotient.mk (Jid f) (g j)))
    (d : ℕ) (a : (Fin (n + m) →₀ ℕ) → R)
    (ha : (∑ e ∈ degreeMonomials (n + m) d, fpow (Fin.append f g) e * a e) ∈
      Jid (Fin.append f g) ^ (d + 1)) :
    ∀ e ∈ degreeMonomials (n + m) d, a e ∈ Jid (Fin.append f g) := by
  classical
  have H : ∀ k, k ≤ d → ∀ e ∈ degreeMonomials (n + m) d,
      qrMdeg (rightExponent e) = k → a e ∈ Jid (Fin.append f g) := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro hk
      let L := Jid g ^ (k + 1) ⊔ Jid f ^ (d - k + 1)
      have hother := sum_filter_right_degree_ne_mem f g d k hk a ih
      have hpart : (∑ e ∈ degreeMonomials (n + m) d with
          qrMdeg (rightExponent e) = k, fpow (Fin.append f g) e * a e) ∈ L := by
        apply (Submodule.add_mem_iff_left _ hother).mp
        rw [Finset.sum_filter_add_sum_filter_not]
        exact pow_append_le_sup f g d k hk ha
      let b : (Fin m →₀ ℕ) → R := fun v =>
        ∑ u ∈ degreeMonomials n (d - k), fpow f u * a (appendExponent u v)
      have hgroup : (∑ v ∈ degreeMonomials m k, fpow g v * b v) ∈ L := by
        rw [sum_filter_right_degree d k hk] at hpart
        convert hpart using 1
        apply Finset.sum_congr rfl
        intro v hv
        dsimp only [b]
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro u hu
        rw [fpow_append]
        ring
      intro e he hre
      have hle : qrMdeg (leftExponent e) = d - k := by
        have hdeg := qrMdeg_left_add_right e
        have he' := (mem_degreeMonomials d e).mp he
        omega
      have hc := coeff_mem_of_sum_mem_mul hf (d - k) (Jid f ⊔ Jid g) le_sup_left
        (fun u => a (appendExponent u (rightExponent e)))
        (inner_sum_mem_pow_mul_sup f g hf hg d k a hgroup (rightExponent e) hre)
        (leftExponent e) hle
      simpa only [appendExponent_left_right, Jid_append] using hc
  intro e he
  have hdeg := qrMdeg_left_add_right e
  have he' := (mem_degreeMonomials d e).mp he
  exact H (qrMdeg (rightExponent e)) (by omega) e he rfl

private theorem injective_of_degree_coeff {c : ℕ} (f : Fin c → R)
    (H : ∀ (d : ℕ) (a : (Fin c →₀ ℕ) → R),
      (∑ e ∈ degreeMonomials c d, fpow f e * a e) ∈ Jid f ^ (d + 1) →
      ∀ e ∈ degreeMonomials c d, a e ∈ Jid f) :
    Function.Injective (quasiRegularCanonicalMap (M := R) f) := by
  classical
  apply injective_of_mem_of_sum_fpow_smul_mem
  intro d S a hdeg hrel e he
  let b := fun e => if e ∈ S then a e else 0
  have hsum : (∑ e ∈ degreeMonomials c d, fpow f e * b e) =
      ∑ e ∈ S, fpow f e * a e := by
    rw [← Finset.sum_subset (s₁ := S) (s₂ := degreeMonomials c d)]
    · exact Finset.sum_congr rfl fun e he => by simp only [b, ite_eq_left he]
    · intro e he
      exact (mem_degreeMonomials d e).mpr (hdeg e he)
    · intro e he heS
      simp only [b, ite_eq_right heS, mul_zero]
  have hc := H d b (by simpa only [hsum, JpowM, smul_eq_mul, Ideal.mul_top] using hrel)
    e ((mem_degreeMonomials d e).mpr (hdeg e he))
  simpa only [b, ite_eq_left he, Ideal.smul_eq_mul, Ideal.mul_top] using hc

/-- **Stacks 0667.** If `f` is quasi-regular and the image of `g` modulo the ideal generated
by `f` is H₁-regular, then the concatenation of `f` and `g` is quasi-regular. -/
@[stacks 0667]
public theorem isQuasiRegular_append_of_isH1Regular_quotient
    {A : Type*} [CommRing A] {n m : ℕ} (f : Fin n → A) (g : Fin m → A)
    (hf : RingTheory.Sequence.IsQuasiRegular A (List.ofFn f))
    (hg : Koszul.IsH1Regular
      (fun j => Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j))) :
    RingTheory.Sequence.IsQuasiRegular A (List.ofFn (Fin.append f g)) := by
  apply (isQuasiRegular_ofFn_iff _).mpr
  refine ⟨injective_of_degree_coeff _ ?_, quasiRegularCanonicalMap_surjective _⟩
  exact coeff_mem_append f g ((isQuasiRegular_ofFn_iff _).mp hf).1 hg

