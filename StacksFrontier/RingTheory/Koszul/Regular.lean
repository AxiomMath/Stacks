/-!
# `H_1`-regular sequences and concatenation

For a commutative ring `A` and sequences `f : Fin n → A`, `g : Fin m → A`, this file relates
`H_1`-regularity of the concatenated sequence `Fin.append f g` to `H_1`-regularity of `f` and
of the images of `g` in `A ⧸ (f_1, …, f_n)`. It also shows that Koszul-regular sequences are
`H_1`-regular, and computes `I ⊓ (g_1, …, g_m)` when the images of the `g_j` in `A ⧸ I` are
`H_1`-regular.

## Main definitions

* `Koszul.appendLeftL`: the linear embedding `A^n → A^{n+m}`, `a ↦ Fin.append a 0`.
* `Koszul.appendRightL`: the linear embedding `A^m → A^{n+m}`, `b ↦ Fin.append 0 b`.
* `Koszul.quotNatAddL`: the linear map `A^{n+m} → (A ⧸ I)^m` keeping the last `m` coordinates
  and reducing them modulo `I`.

## Main results

* `Koszul.isH1Regular_append`: if `f` is `H_1`-regular and the images of `g` in `A ⧸ (f)` are
  `H_1`-regular, then `Fin.append f g` is `H_1`-regular.
* `Koszul.IsKoszulRegularOn.isH1RegularOn`: an `M`-Koszul-regular sequence is
  `M`-`H_1`-regular.
* `Koszul.IsKoszulRegular.isH1Regular`: a Koszul-regular sequence is `H_1`-regular.
* `Koszul.inf_span_eq_smul_span`: if the images of `g` in `A ⧸ I` are `H_1`-regular, then
  `I ⊓ (g_1, …, g_m) = I (g_1, …, g_m)`.
* `Koszul.isH1Regular_quotient_of_isH1Regular_append`: if `Fin.append f g` is `H_1`-regular,
  then the images of `g` in `A ⧸ (f)` are `H_1`-regular.
* `Koszul.inf_sq_eq_mul_of_quotient_generated_by_isH1Regular`: if `I ≤ J` and the image of `J`
  in `A ⧸ I` is generated by an `H_1`-regular sequence, then `I ⊓ J ^ 2 = I * J`.
* `Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular`: a sequence each of whose terms acts
  injectively on the quotient of `M` by its predecessors is `M`-Koszul-regular; in particular an
  `M`-regular sequence is `M`-Koszul-regular and a regular sequence is Koszul-regular.
* `Koszul.isH1RegularOn_and_isKoszulRegularOn_snoc_mul`: if adjoining `f` and adjoining `g` to a
  finite sequence both give `M`-`H_1`-regular sequences, then so does adjoining `f * g`; the same
  holds for `M`-Koszul-regularity.

## Implementation notes

Sequences are functions `Fin r → A` and `A^r` is `Fin r → A`, with basis vectors
`Pi.single i 1`. Proofs use `Koszul.isH1Regular_iff_forall`: a sequence `f` is `H_1`-regular
exactly when every relation `∑ i, a i * f i = 0` lies in `Koszul.relSpan f`, the span of the
trivial relations `Koszul.trivRel f i j`.

## References

* [Stacks Project, Tags 0668, 0CEM, 0665, 068L](https://stacks.math.columbia.edu)
* [Stacks Project, Tag 0666](https://stacks.math.columbia.edu/tag/0666)
* [Stacks Project, Tag 062F](https://stacks.math.columbia.edu/tag/062F)
* [Stacks Project, Tag 062G](https://stacks.math.columbia.edu/tag/062G)
-/

@[expose] public section

namespace Koszul

variable {A : Type*} [CommRing A] {n m : ℕ}

/-- The empty sequence (`r = 0`) is vacuously `H_1`-regular. -/
theorem isH1Regular_fin_zero (f : Fin 0 → A) : IsH1Regular f := by
  rw [isH1Regular_iff_forall]
  intro a _
  rw [Subsingleton.elim a 0]
  exact Submodule.zero_mem _

section AppendHelpers

/-- Left embedding `A^n → A^{n+m}`, `a ↦ Fin.append a 0`, as a linear map. -/
def appendLeftL : (Fin n → A) →ₗ[A] (Fin (n + m) → A) where
  toFun a := Fin.append a (0 : Fin m → A)
  map_add' a b := by
    funext k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · simp [Fin.append_left]
    · simp [Fin.append_right]
  map_smul' c a := by
    funext k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · simp [Fin.append_left]
    · simp [Fin.append_right]

/-- `appendLeftL a` is `Fin.append a 0`. -/
@[simp]
theorem appendLeftL_apply (a : Fin n → A) :
    (appendLeftL a : Fin (n + m) → A) = Fin.append a (0 : Fin m → A) :=
  rfl

/-- Right embedding `A^m → A^{n+m}`, `b ↦ Fin.append 0 b`, as a linear map. -/
def appendRightL : (Fin m → A) →ₗ[A] (Fin (n + m) → A) where
  toFun b := Fin.append (0 : Fin n → A) b
  map_add' b b' := by
    funext k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · simp [Fin.append_left]
    · simp [Fin.append_right]
  map_smul' c b := by
    funext k
    refine Fin.addCases (fun i => ?_) (fun j => ?_) k
    · simp [Fin.append_left]
    · simp [Fin.append_right]

/-- `appendRightL b` is `Fin.append 0 b`. -/
@[simp]
theorem appendRightL_apply (b : Fin m → A) :
    (appendRightL b : Fin (n + m) → A) = Fin.append (0 : Fin n → A) b :=
  rfl

/-- `appendLeftL` sends `e_i` to `e_{castAdd i}`. -/
theorem appendLeftL_single (i : Fin n) :
    (appendLeftL (Pi.single i 1 : Fin n → A) : Fin (n + m) → A)
      = Pi.single (Fin.castAdd m i) 1 := by
  funext k
  refine Fin.addCases (fun a => ?_) (fun b => ?_) k
  · simp only [appendLeftL_apply, Fin.append_left]
    rcases eq_or_ne a i with h | h
    · subst h; simp
    · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne]
      exact fun hc => h (Fin.castAdd_injective _ _ hc)
  · simp only [appendLeftL_apply, Fin.append_right, Pi.zero_apply]
    rw [Pi.single_eq_of_ne]
    intro hc
    have := congrArg Fin.val hc
    simp at this
    omega

/-- `appendRightL` sends `e_j` to `e_{natAdd j}`. -/
theorem appendRightL_single (j : Fin m) :
    (appendRightL (Pi.single j 1 : Fin m → A) : Fin (n + m) → A)
      = Pi.single (Fin.natAdd n j) 1 := by
  funext k
  refine Fin.addCases (fun a => ?_) (fun b => ?_) k
  · simp only [appendRightL_apply, Fin.append_left, Pi.zero_apply]
    rw [Pi.single_eq_of_ne]
    intro hc
    have := congrArg Fin.val hc
    simp [Fin.val_natAdd] at this
    omega
  · simp only [appendRightL_apply, Fin.append_right]
    rcases eq_or_ne b j with h | h
    · subst h; simp
    · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne]
      exact fun hc => h (Fin.natAdd_injective _ _ hc)

/-- `appendLeftL` sends a trivial relation of `f` to a trivial relation of the
appended sequence (using left indices). -/
theorem appendLeftL_trivRel (f : Fin n → A) (g : Fin m → A) (i i' : Fin n) :
    (appendLeftL (trivRel f i i') : Fin (n + m) → A)
      = trivRel (Fin.append f g) (Fin.castAdd m i) (Fin.castAdd m i') := by
  simp only [trivRel_eq_smul_single]
  rw [map_sub, map_smul, map_smul, appendLeftL_single, appendLeftL_single,
    Fin.append_left, Fin.append_left]

/-- `appendRightL` sends a trivial relation of `g` to a trivial relation of the
appended sequence (using right indices). -/
theorem appendRightL_trivRel (f : Fin n → A) (g : Fin m → A) (j j' : Fin m) :
    (appendRightL (trivRel g j j') : Fin (n + m) → A)
      = trivRel (Fin.append f g) (Fin.natAdd n j) (Fin.natAdd n j') := by
  simp only [trivRel_eq_smul_single]
  rw [map_sub, map_smul, map_smul, appendRightL_single, appendRightL_single,
    Fin.append_right, Fin.append_right]

/-- A linear map sending the trivial relations of `g` into `relSpan f` sends `relSpan g` into
`relSpan f`. -/
private theorem map_mem_relSpan_of_trivRel {k l : ℕ} (φ : (Fin k → A) →ₗ[A] (Fin l → A))
    (f : Fin l → A) (g : Fin k → A) (h : ∀ i j, φ (trivRel g i j) ∈ relSpan f) {x : Fin k → A}
    (hx : x ∈ relSpan g) : φ x ∈ relSpan f :=
  (Submodule.span_le (p := (relSpan f).comap φ)).2 (by rintro _ ⟨⟨i, j⟩, rfl⟩; exact h i j) hx

/-- The left embedding maps Koszul relations of `f` into Koszul relations of the
appended sequence. -/
theorem appendLeftL_mem_relSpan (f : Fin n → A) (g : Fin m → A) {a : Fin n → A}
    (ha : a ∈ relSpan f) :
    (appendLeftL a : Fin (n + m) → A) ∈ relSpan (Fin.append f g) :=
  map_mem_relSpan_of_trivRel appendLeftL _ f
    (fun i i' => by rw [appendLeftL_trivRel f g]; exact trivRel_mem_relSpan _ _ _) ha

/-- The right embedding maps Koszul relations of `g` into Koszul relations of the
appended sequence. -/
theorem appendRightL_mem_relSpan (f : Fin n → A) (g : Fin m → A) {b : Fin m → A}
    (hb : b ∈ relSpan g) :
    (appendRightL b : Fin (n + m) → A) ∈ relSpan (Fin.append f g) :=
  map_mem_relSpan_of_trivRel appendRightL _ g
    (fun j j' => by rw [appendRightL_trivRel f g]; exact trivRel_mem_relSpan _ _ _) hb

/-- The trivial relation of `Fin.append f g` pairing `castAdd i` with `natAdd j`, evaluated at a
left index. -/
theorem trivRel_append_castAdd_natAdd_apply_castAdd (f : Fin n → A) (g : Fin m → A) (i i₀ : Fin n)
    (j : Fin m) :
    trivRel (Fin.append f g) (Fin.castAdd m i) (Fin.natAdd n j) (Fin.castAdd m i₀) =
      -(Pi.single i (g j) : Fin n → A) i₀ := by
  have : Fin.castAdd m i₀ ≠ Fin.natAdd n j := by simp [Fin.ext_iff]; omega
  simp [trivRel, Pi.single_apply, this]

/-- The trivial relation of `Fin.append f g` pairing `castAdd i` with `natAdd j`, evaluated at a
right index. -/
theorem trivRel_append_castAdd_natAdd_apply_natAdd (f : Fin n → A) (g : Fin m → A) (i : Fin n)
    (j j₀ : Fin m) :
    trivRel (Fin.append f g) (Fin.castAdd m i) (Fin.natAdd n j) (Fin.natAdd n j₀) =
      (Pi.single j (f i) : Fin m → A) j₀ := by
  have : Fin.natAdd n j₀ ≠ Fin.castAdd m i := by simp [Fin.ext_iff]; omega
  simp [trivRel, Pi.single_apply, this]

/-- If `b - b' = ∑ i, d i * f i` componentwise, `b'` lies in `Koszul.relSpan g`, and
`a + ∑ j, d j * g j` lies in `Koszul.relSpan f`, then `Fin.append a b` lies in
`Koszul.relSpan (Fin.append f g)`. -/
theorem append_mem_relSpan_of_sub_eq (f : Fin n → A) (g : Fin m → A) {a : Fin n → A}
    {b b' : Fin m → A} {d : Fin m → Fin n → A} (hd : ∀ j, b j - b' j = ∑ i, d j i * f i)
    (hb' : b' ∈ relSpan g)
    (ha' : (fun i => a i + ∑ j, d j i * g j) ∈ relSpan f) :
    Fin.append a b ∈ relSpan (Fin.append f g) := by
  have hdecomp : Fin.append a b = appendRightL b' + appendLeftL (fun i => a i + ∑ j, d j i * g j)
      + ∑ i, ∑ j, d j i • trivRel (Fin.append f g) (Fin.castAdd m i) (Fin.natAdd n j) := by
    funext k
    refine Fin.addCases (fun i₀ => ?_) (fun j₀ => ?_) k
    · simp [appendLeftL_apply, appendRightL_apply, Finset.sum_apply,
        trivRel_append_castAdd_natAdd_apply_castAdd, Pi.single_apply]
    · simp [← hd j₀, appendLeftL_apply, appendRightL_apply, Finset.sum_apply,
        trivRel_append_castAdd_natAdd_apply_natAdd, Pi.single_apply]
  rw [hdecomp]
  refine add_mem (add_mem (appendRightL_mem_relSpan f g hb') (appendLeftL_mem_relSpan f g ha'))
    (Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ ?_)
  exact Submodule.subset_span ⟨(Fin.castAdd m i, Fin.natAdd n j), rfl⟩

end AppendHelpers

section QuotientLift

/-- The quotient map applied to a trivial Koszul relation for `g` gives the trivial Koszul
relation for the images of `g`. -/
theorem mk_trivRel (I : Ideal A) (g : Fin m → A) (i j k : Fin m) :
    Ideal.Quotient.mk I (trivRel g i j k)
      = trivRel (fun l => Ideal.Quotient.mk I (g l)) i j k := by
  rw [trivRel_apply, trivRel_apply, map_sub]
  split_ifs <;> simp

/-- If the componentwise reduction `k ↦ π (b k)` lies in the
Koszul relations of the reduced sequence `π ∘ g`, then there is a lift
`b' : Fin m → A` lying in `Koszul.relSpan g` over `A` and reducing to the same
element, i.e. `π (b' k) = π (b k)` for all `k`. -/
theorem exists_lift_relSpan (I : Ideal A) (g : Fin m → A) {y : Fin m → A ⧸ I}
    (hy : y ∈ relSpan (fun k => (Ideal.Quotient.mk I) (g k))) :
    ∃ b' : Fin m → A, b' ∈ relSpan g ∧ (fun k => (Ideal.Quotient.mk I) (b' k)) = y := by
  rw [relSpan] at hy
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
  · rintro x ⟨⟨i, j⟩, rfl⟩
    exact ⟨trivRel g i j, Submodule.subset_span ⟨(i, j), rfl⟩, funext (mk_trivRel I g i j)⟩
  · exact ⟨0, Submodule.zero_mem _, by funext k; simp⟩
  · rintro x z _ _ ⟨bx, hbx, hbx2⟩ ⟨bz, hbz, hbz2⟩
    refine ⟨bx + bz, Submodule.add_mem _ hbx hbz, ?_⟩
    funext k
    simp only [Pi.add_apply, map_add]
    rw [← hbx2, ← hbz2]
  · rintro c x _ ⟨bx, hbx, hbx2⟩
    obtain ⟨ĉ, rfl⟩ := Ideal.Quotient.mk_surjective c
    refine ⟨ĉ • bx, Submodule.smul_mem _ _ hbx, ?_⟩
    funext k
    simp only [Pi.smul_apply, smul_eq_mul, map_mul]
    rw [← hbx2]

/-- Every element of `relSpan g` is a relation: `∑ j, b j * g j = 0`. -/
private theorem sum_mul_eq_zero_of_mem_relSpan (g : Fin m → A) {b : Fin m → A}
    (hb : b ∈ relSpan g) : ∑ j, b j * g j = 0 := by
  simpa [seqDual_apply] using relSpan_le_ker g hb

end QuotientLift

/-- Let `A` be a commutative ring, let `f : Fin n → A` be an `H_1`-regular sequence, let
`I = (f_0, ..., f_{n-1})` be the ideal it generates, and let `g : Fin m → A` be such that the
images `(Ideal.Quotient.mk I) ∘ g` form an `H_1`-regular sequence in `A/I`. Then the concatenated
sequence `Fin.append f g : Fin (n + m) → A` is `H_1`-regular in `A`. -/
@[stacks 0668]
theorem isH1Regular_append {A : Type*} [CommRing A] {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A)
    (hf : Koszul.IsH1Regular f)
    (hg : Koszul.IsH1Regular
      (fun j => (Ideal.Quotient.mk (Ideal.span (Set.range f))) (g j))) :
    Koszul.IsH1Regular (Fin.append f g) := by
  set I : Ideal A := Ideal.span (Set.range f)
  set π : A →+* A ⧸ I := Ideal.Quotient.mk I
  have hfI : ∀ i, π (f i) = 0 := fun i =>
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨i, rfl⟩)
  rw [isH1Regular_iff_forall] at hf hg ⊢
  intro c hc
  set a : Fin n → A := fun i => c (Fin.castAdd m i)
  set b : Fin m → A := fun j => c (Fin.natAdd n j)
  have hcab : c = Fin.append a b := Fin.append_castAdd_natAdd.symm
  have hrel : ∑ i, a i * f i + ∑ j, b j * g j = 0 := by
    simpa [Fin.sum_univ_add] using hc
  have hbrel : (fun j => π (b j)) ∈ relSpan (fun j => π (g j)) := by
    refine hg _ ?_
    simpa [hfI] using congrArg π (eq_neg_of_add_eq_zero_right hrel)
  obtain ⟨b', hb'mem, hb'eq⟩ := exists_lift_relSpan I g hbrel
  have hexd : ∀ j, ∃ d : Fin n → A, b j - b' j = ∑ i, d i * f i := fun j => by
    obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.1
      (Ideal.Quotient.eq.1 (congrFun hb'eq j).symm)
    exact ⟨d, hd.symm⟩
  choose d hd using hexd
  set a' : Fin n → A := fun i => a i + ∑ j, d j i * g j with ha'
  have hb'rel := sum_mul_eq_zero_of_mem_relSpan g hb'mem
  have ha'rel : ∑ i, a' i * f i = 0 := by
    have hcross : ∑ i, (∑ j, d j i * g j) * f i = ∑ j, (b j - b' j) * g j := by
      simp only [hd, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by ring
    simp only [ha', add_mul, Finset.sum_add_distrib, hcross, sub_mul, Finset.sum_sub_distrib,
      hb'rel, sub_zero]
    linear_combination hrel
  rw [hcab]
  exact append_mem_relSpan_of_sub_eq f g hd hb'mem (hf a' ha'rel)

section KoszulRegular

universe v

variable {R : Type*} [CommRing R] {r : ℕ}

/-- If the sequence `f_1, ..., f_r` is `M`-Koszul-regular, then it is `M`-H_1-regular. -/
@[stacks 0CEM "(1)"]
theorem IsKoszulRegularOn.isH1RegularOn {f : Fin r → R} {M : Type v} [AddCommGroup M]
    [Module R M] (h : IsKoszulRegularOn f M) : IsH1RegularOn f M :=
  h 1 one_ne_zero

/-- If the sequence `f_1, ..., f_r` is Koszul-regular, then it is H_1-regular. -/
@[stacks 0CEM "(2)"]
theorem IsKoszulRegular.isH1Regular {f : Fin r → R} (h : IsKoszulRegular f) : IsH1Regular f :=
  h 1 one_ne_zero

end KoszulRegular

/-- Let `A` be a commutative ring, `I` an ideal of `A`, and `g_1, ..., g_m` elements of `A`. If the
images of `g_1, ..., g_m` in `A/I` form an `H_1`-regular sequence, then
`I ⊓ (g_1, ..., g_m) = I (g_1, ..., g_m)` as ideals of `A`. -/
@[stacks 0665]
theorem inf_span_eq_smul_span (I : Ideal A) (g : Fin m → A)
    (hreg : Koszul.IsH1Regular (fun i => Ideal.Quotient.mk I (g i))) :
    I ⊓ Ideal.span (Set.range g) = I * Ideal.span (Set.range g) := by
  rw [isH1Regular_iff_forall] at hreg
  refine le_antisymm ?_ (le_inf Ideal.mul_le_left Ideal.mul_le_right)
  rintro x ⟨hxI, hxg⟩
  obtain ⟨af, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.1 hxg
  have hrel : ∑ i, Ideal.Quotient.mk I (af i) * Ideal.Quotient.mk I (g i) = 0 := by
    simpa using Ideal.Quotient.eq_zero_iff_mem.2 hxI
  obtain ⟨b, hbmem, hbeq⟩ := exists_lift_relSpan I g (hreg _ hrel)
  have hbd := sum_mul_eq_zero_of_mem_relSpan g hbmem
  have hx2 : ∑ i, af i * g i = ∑ i, (af i - b i) * g i := by
    simp only [sub_mul, Finset.sum_sub_distrib, hbd, sub_zero]
  rw [hx2]
  refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul ?_ (Ideal.subset_span ⟨i, rfl⟩)
  exact Ideal.Quotient.eq.1 (congrFun hbeq i).symm

section QuotNatAdd

/-- The `A`-linear map `A^{n+m} → (A ⧸ I)^m` keeping the last `m` coordinates and reducing them
modulo the ideal `I`. -/
def quotNatAddL (I : Ideal A) (n m : ℕ) : (Fin (n + m) → A) →ₗ[A] (Fin m → A ⧸ I) :=
  (I.mkQ.compLeft (Fin m)).comp (LinearMap.funLeft A A (Fin.natAdd n))

/-- `quotNatAddL I n m c` is `j ↦ c (natAdd n j)` modulo `I`. -/
@[simp]
theorem quotNatAddL_apply (I : Ideal A) (c : Fin (n + m) → A) (j : Fin m) :
    quotNatAddL I n m c j = Ideal.Quotient.mk I (c (Fin.natAdd n j)) :=
  rfl

/-- `quotNatAddL I n m` sends `Pi.single (Fin.natAdd n j₀) v` to
`Pi.single j₀ (Ideal.Quotient.mk I v)`. -/
theorem quotNatAddL_single_natAdd (I : Ideal A) (j₀ : Fin m) (v : A) :
    quotNatAddL I n m (Pi.single (Fin.natAdd n j₀) v) = Pi.single j₀ (Ideal.Quotient.mk I v) := by
  funext j
  by_cases hj : j = j₀ <;> simp [quotNatAddL_apply, hj]

/-- `quotNatAddL I n m` sends `Pi.single (Fin.castAdd m i₀) v` to `0`. -/
theorem quotNatAddL_single_castAdd (I : Ideal A) (i₀ : Fin n) (v : A) :
    quotNatAddL I n m (Pi.single (Fin.castAdd m i₀) v) = 0 := by
  funext j
  have : Fin.natAdd n j ≠ Fin.castAdd m i₀ := by simp [Fin.ext_iff]; omega
  simp [quotNatAddL_apply, this]

/-- `quotNatAddL (f_1, ..., f_n) n m` maps Koszul relations of `Fin.append f g` into Koszul
relations of the images of `g` in `A ⧸ (f_1, ..., f_n)`. -/
theorem quotNatAddL_mem_relSpan (f : Fin n → A) (g : Fin m → A) {c : Fin (n + m) → A}
    (hc : c ∈ relSpan (Fin.append f g)) :
    quotNatAddL (Ideal.span (Set.range f)) n m c ∈
      relSpan (fun j => Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j)) := by
  have hf : ∀ i, Ideal.Quotient.mk (Ideal.span (Set.range f)) (f i) = 0 := fun i =>
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span ⟨i, rfl⟩)
  rw [relSpan] at hc
  refine Submodule.span_induction ?_ (by simp) (fun x y _ _ hx hy => by
    rw [map_add]; exact add_mem hx hy) (fun s x _ hx => by
    rw [map_smul]; exact Submodule.smul_of_tower_mem _ s hx) hc
  rintro x ⟨⟨p₁, p₂⟩, rfl⟩
  simp only [trivRel, map_sub]
  refine Fin.addCases (fun i₁ => ?_) (fun j₁ => ?_) p₁ <;>
    refine Fin.addCases (fun i₂ => ?_) (fun j₂ => ?_) p₂ <;>
    simp only [Fin.append_left, Fin.append_right, quotNatAddL_single_castAdd,
      quotNatAddL_single_natAdd, hf, Pi.single_zero, sub_zero, zero_mem]
  exact Submodule.subset_span ⟨(j₁, j₂), rfl⟩

end QuotNatAdd

/-- If `f_1, ..., f_n, g_1, ..., g_m` is an `H₁`-regular sequence in `A`, then the images
`ḡ_1, ..., ḡ_m` of the `g_j` in the quotient `A / (f_1, ..., f_n)` form an `H₁`-regular sequence.
-/
@[stacks 068L]
theorem isH1Regular_quotient_of_isH1Regular_append {A : Type*} [CommRing A] {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A)
    (h : Koszul.IsH1Regular (Fin.append f g)) :
    Koszul.IsH1Regular
      (fun j : Fin m => Ideal.Quotient.mk (Ideal.span (Set.range f)) (g j)) := by
  rw [isH1Regular_iff_forall] at h ⊢
  intro abar habar
  obtain ⟨a, rfl⟩ : ∃ a : Fin m → A,
      (fun j => Ideal.Quotient.mk (Ideal.span (Set.range f)) (a j)) = abar :=
    ⟨fun j => (abar j).out, funext fun j => Quotient.out_eq _⟩
  have hsum : ∑ j, a j * g j ∈ Ideal.span (Set.range f) := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simpa using habar
  obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hsum
  have hc : ∑ i, Fin.append (-b) a i * Fin.append f g i = 0 := by
    simp [Fin.sum_univ_add, ← hb]
  convert quotNatAddL_mem_relSpan f g (h _ hc) using 1
  funext j
  simp [quotNatAddL_apply]

/-! ## Conormal intersection for an `H_1`-regular quotient ideal

If the quotient of an ideal `J` by a subideal `I` is generated by an `H_1`-regular sequence in
`A ⧸ I`, then the intersection of `I` with the square of `J` is the product of `I` and `J`.
The quotient ideal `J / I` is represented by the image of `J` under the quotient map
`A → A ⧸ I`, and its finite `H_1`-regular generating sequence is given explicitly.
-/

/-- If `I ⊆ J` and `J / I` is generated by an H₁-regular sequence, then `I ∩ J² = I J`. -/
@[stacks 0666]
theorem inf_sq_eq_mul_of_quotient_generated_by_isH1Regular
    {A : Type*} [CommRing A] (I J : Ideal A) (hIJ : I ≤ J)
    {m : ℕ} (g : Fin m → A ⧸ I)
    (hspan : Ideal.span (Set.range g) = Ideal.map (Ideal.Quotient.mk I) J)
    (hreg : Koszul.IsH1Regular g) :
    I ⊓ J ^ 2 = I * J := by
  let q := Ideal.Quotient.mk I
  have hq : Function.Surjective q := Ideal.Quotient.mk_surjective
  have hgmap (i : Fin m) : g i ∈ Ideal.map q J := by
    rw [← hspan]
    exact Ideal.subset_span (Set.mem_range_self i)
  choose f hfJ hfg using fun i => (Ideal.mem_map_iff_of_surjective q hq).mp (hgmap i)
  let K := Ideal.span (Set.range f)
  have hKJ : K ≤ J := Ideal.span_le.2 (Set.range_subset_iff.2 hfJ)
  have hmapK : Ideal.map q K = Ideal.span (Set.range g) := by
    rw [Ideal.map_span, ← Set.range_comp, show q ∘ f = g from funext hfg]
  have hJK : J = I ⊔ K := by
    apply le_antisymm
    · intro x hx
      have hxmap : q x ∈ Ideal.map q K := by
        rw [hmapK, hspan]
        exact Ideal.mem_map_of_mem q hx
      obtain ⟨y, hyK, hy⟩ := (Ideal.mem_map_iff_of_surjective q hq).mp hxmap
      have hxyI : x - y ∈ I := (Ideal.Quotient.eq_zero_iff_mem).mp (by
        change q (x - y) = 0
        rw [map_sub, hy, sub_self])
      rw [show x = (x - y) + y by abel]
      exact add_mem (Ideal.mem_sup_left hxyI) (Ideal.mem_sup_right hyK)
    · exact sup_le hIJ hKJ
  have hreg' : Koszul.IsH1Regular (fun i => q (f i)) := by
    simpa only [hfg] using hreg
  have hIK : I ⊓ K = I * K := inf_span_eq_smul_span I f hreg'
  rw [hJK, pow_two, Ideal.sup_mul, Ideal.mul_sup I I K, Ideal.mul_sup K I K,
    mul_comm K I]
  simp only [sup_assoc, sup_left_idem]
  apply le_antisymm
  · rintro x ⟨hxI, hx⟩
    change x ∈ I * I ⊔ (I * K ⊔ K * K) at hx
    rw [Submodule.mem_sup] at hx
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    change b ∈ I * K ⊔ K * K at hb
    rw [Submodule.mem_sup] at hb
    obtain ⟨c, hc, d, hd, rfl⟩ := hb
    have hdI : d ∈ I := by
      rw [← show a + (c + d) - (a + c) = d by abel]
      exact sub_mem hxI (add_mem (Ideal.mul_le_left ha) (Ideal.mul_le_left hc))
    exact add_mem (Ideal.mem_sup_left ha)
      (Ideal.mem_sup_right (add_mem hc (hIK ▸ ⟨hdI, Ideal.mul_le_left hd⟩)))
  · apply sup_le
    · exact le_inf Ideal.mul_le_left (le_sup_of_le_left le_rfl)
    · exact le_inf Ideal.mul_le_left (le_sup_of_le_right (le_sup_of_le_left le_rfl))

/-! ## Regular sequences are Koszul-regular

A finite sequence whose successive terms act injectively after quotienting a module by the
preceding terms is Koszul-regular on that module. Consequently, module-regular sequences are
module-Koszul-regular, and regular sequences in a ring are Koszul-regular.

Finite sequences used by the Koszul complex are functions from `Fin r`; the regular-sequence
API uses lists, so the same sequence is represented there by `List.ofFn f`.
-/

section KoszulRegularOfRegular

set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct ExteriorAlgebra

universe u v w

/-- Tensoring with a fixed coefficient module `M`, as a functor on `R`-modules. -/
private noncomputable def coefficientTensorFunctor
    {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M] :
    ModuleCat.{u} R ⥤ ModuleCat.{max u v} R where
  obj X := ModuleCat.of R (X ⊗[R] M)
  map g := ModuleCat.ofHom (g.hom.rTensor M)
  map_id X := by ext; simp
  map_comp f g := by
    apply ModuleCat.hom_ext
    exact LinearMap.rTensor_comp M g.hom f.hom

/-- Tensoring with `M` preserves zero morphisms, so it acts on chain complexes. -/
private instance coefficientTensorFunctor_preservesZeroMorphisms
    {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M] :
    (coefficientTensorFunctor (R := R) M).PreservesZeroMorphisms where
  map_zero X Y := by apply ModuleCat.hom_ext; exact LinearMap.rTensor_zero M

/-- The complex obtained from `C` by tensoring every term with `M`. -/
private noncomputable abbrev tensorComplex {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{u} R) ℕ) (M : Type v)
    [AddCommGroup M] [Module R M] :=
  ((coefficientTensorFunctor (R := R) M).mapHomologicalComplex (ComplexShape.down ℕ)).obj C

private lemma tensorComplex_seq {R : Type u} [CommRing R] {r : ℕ}
    (f : Fin r → R) (M : Type v) [AddCommGroup M] [Module R M] :
    tensorComplex (Koszul.seqComplex f) M = Koszul.seqComplexTensor f M := by
  unfold tensorComplex Koszul.seqComplex Koszul.complex
  rw [ChainComplex.map_chain_complex_of]
  rfl

/-- Terms of the cone of multiplication by `a` on `C`. -/
private noncomputable def coneX {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) : ℕ → ModuleCat.{w} R
  | 0 => C.X 0
  | n + 1 => ModuleCat.of R (C.X (n + 1) × C.X n)

/-- The differential of the cone of multiplication by `a` on `C`. -/
private noncomputable def coneD {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (a : R) :
    (n : ℕ) → coneX C (n + 1) ⟶ coneX C n
  | 0 => ModuleCat.ofHom
      ((C.d 1 0).hom.comp (LinearMap.fst R _ _) + a • LinearMap.snd R _ _)
  | n + 1 => ModuleCat.ofHom (LinearMap.prod
      ((C.d (n + 2) (n + 1)).hom.comp (LinearMap.fst R _ _) +
        a • LinearMap.snd R _ _)
      (-((C.d (n + 1) n).hom.comp (LinearMap.snd R _ _))))

private lemma d_d {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (i j k : ℕ) (x : C.X i) :
    C.d j k (C.d i j x) = 0 := by
  rw [← ModuleCat.comp_apply, C.d_comp_d]; rfl

private lemma coneD_comp {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (a : R) (n : ℕ) :
    coneD C a (n + 1) ≫ coneD C a n = 0 := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change coneD C a n (coneD C a (n + 1) x) = 0
  cases n with
  | zero =>
    change C.d 1 0 (C.d 2 1 x.1 + a • x.2) + a • (-(C.d 1 0 x.2)) = 0
    simp [d_d]
  | succ n =>
    change (C.d (n + 2) (n + 1) (C.d (n + 3) (n + 2) x.1 + a • x.2) +
      a • (-(C.d (n + 2) (n + 1) x.2)), -(C.d (n + 1) n (-(C.d (n + 2) (n + 1) x.2)))) = 0
    simp [d_d]

/-- The cone of multiplication by `a` on `C`, as a chain complex. -/
private noncomputable def coefficientCone {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (a : R) :
    ChainComplex (ModuleCat.{w} R) ℕ :=
  ChainComplex.of (coneX C) (coneD C a) (coneD_comp C a)

private lemma coefficientCone_d {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (a : R) (n : ℕ) :
    (coefficientCone C a).d (n + 1) n = coneD C a n :=
  ChainComplex.of_d _ _ n

/-- Tensoring the cone of multiplication by `a` with `M` gives the cone of multiplication by `a`
on the tensored complex. -/
private noncomputable def coneTensorIso {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{u} R) ℕ) (a : R)
    (M : Type v) [AddCommGroup M] [Module R M] :
    tensorComplex (Stacks.MappingCone.NatIndexed.coneComplex C C
      (Stacks.MappingCone.NatIndexed.mulByF C a)) M ≅
      coefficientCone (tensorComplex C M) a :=
  HomologicalComplex.Hom.isoOfComponents
    (fun n => match n with
      | 0 => Iso.refl _
      | n + 1 => (TensorProduct.prodLeft R R (C.X (n + 1)) (C.X n) M).toModuleIso)
    (by
      intro i j hij
      obtain rfl : j + 1 = i := hij
      rw [coefficientCone_d]
      apply ModuleCat.hom_ext
      apply TensorProduct.ext'
      intro x m
      simp only [ModuleCat.hom_comp, LinearMap.comp_apply]
      cases j with
      | zero =>
        rcases x with ⟨b, c⟩
        change ((C.d 1 0).hom.rTensor M)
          ((TensorProduct.prodLeft R R (C.X 1) (C.X 0) M) ((b, c) ⊗ₜ[R] m)).1 +
          a • ((TensorProduct.prodLeft R R (C.X 1) (C.X 0) M) ((b, c) ⊗ₜ[R] m)).2 =
          ((Stacks.MappingCone.NatIndexed.coneComplex C C (Stacks.MappingCone.NatIndexed.mulByF C
            a)).d 1 0).hom.rTensor M
            ((b, c) ⊗ₜ[R] m)
        rw [show (Stacks.MappingCone.NatIndexed.coneComplex C C
          (Stacks.MappingCone.NatIndexed.mulByF C a)).d 1 0 =
          Stacks.MappingCone.NatIndexed.coneD C C (Stacks.MappingCone.NatIndexed.mulByF C a) 0 from
            ChainComplex.of_d (Stacks.MappingCone.NatIndexed.coneX C C)
              (Stacks.MappingCone.NatIndexed.coneD C C (Stacks.MappingCone.NatIndexed.mulByF C a))
                0]
        simp only [TensorProduct.prodLeft_tmul, LinearMap.rTensor_tmul]
        change C.d 1 0 b ⊗ₜ[R] m + a • (c ⊗ₜ[R] m) =
          (C.d 1 0 b + a • c) ⊗ₜ[R] m
        simp [TensorProduct.add_tmul, TensorProduct.smul_tmul']
      | succ n =>
        rcases x with ⟨b, c⟩
        change
          (((C.d (n + 2) (n + 1)).hom.rTensor M)
            ((TensorProduct.prodLeft R R (C.X (n + 2)) (C.X (n + 1)) M) ((b, c) ⊗ₜ[R] m)).1 +
            a • ((TensorProduct.prodLeft R R (C.X (n + 2)) (C.X (n + 1)) M) ((b, c) ⊗ₜ[R] m)).2,
          -((C.d (n + 1) n).hom.rTensor M)
            ((TensorProduct.prodLeft R R (C.X (n + 2)) (C.X (n + 1)) M) ((b, c) ⊗ₜ[R] m)).2) =
          (TensorProduct.prodLeft R R (C.X (n + 1)) (C.X n) M)
            (((Stacks.MappingCone.NatIndexed.coneComplex C C (Stacks.MappingCone.NatIndexed.mulByF C
              a)).d
              (n + 2) (n + 1)).hom.rTensor M
              ((b, c) ⊗ₜ[R] m))
        rw [show (Stacks.MappingCone.NatIndexed.coneComplex C C
          (Stacks.MappingCone.NatIndexed.mulByF C a)).d (n + 2) (n + 1) =
          Stacks.MappingCone.NatIndexed.coneD C C (Stacks.MappingCone.NatIndexed.mulByF C a) (n + 1)
            from
            ChainComplex.of_d _ _ (n + 1)]
        simp only [TensorProduct.prodLeft_tmul, LinearMap.rTensor_tmul]
        change (C.d (n + 2) (n + 1) b ⊗ₜ[R] m + a • (c ⊗ₜ[R] m), -(C.d (n + 1) n c ⊗ₜ[R] m)) =
          (TensorProduct.prodLeft R R (C.X (n + 1)) (C.X n) M)
            ((C.d (n + 2) (n + 1) b + a • c, -(C.d (n + 1) n c)) ⊗ₜ[R] m)
        simp [TensorProduct.add_tmul, TensorProduct.smul_tmul', TensorProduct.neg_tmul])

/-- The Koszul complex of `Fin.snoc f a` tensored with `M` is the cone of multiplication by `a`
on the Koszul complex of `f` tensored with `M`. -/
private noncomputable def coefficientSnocIso {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R) (a : R) :
    Koszul.seqComplexTensor (Fin.snoc f a) M ≅
      coefficientCone (Koszul.seqComplexTensor f M) a := by
  let e := (Koszul.seqComplex_snoc_iso_cone f a).some
  have e' := ((coefficientTensorFunctor M).mapHomologicalComplex
    (ComplexShape.down ℕ)).mapIso e ≪≫ coneTensorIso (Koszul.seqComplex f) a M
  simpa only [tensorComplex_seq] using e'

/-- The Koszul differential `⋀¹ E → ⋀⁰ E` attached to `φ : Module.Dual R E` is `φ`, under the
identifications `⋀¹ E ≃ E` and `⋀⁰ E ≃ R`. -/
public lemma koszul_d_one {R : Type u} [CommRing R]
    {E : Type w} [AddCommGroup E] [Module R E] (φ : Module.Dual R E) (x : E) :
    Koszul.d φ 0 ((exteriorPower.oneEquiv R E).symm x) =
      (exteriorPower.zeroEquiv R E).symm (φ x) := by
  apply Subtype.ext
  simp [Koszul.d_apply_coe, exteriorPower.oneEquiv_symm_apply,
    exteriorPower.zeroEquiv_symm_apply, exteriorPower.ιMulti_apply_coe,
    ExteriorAlgebra.ιMulti, Koszul.contraction, CliffordAlgebra.contractLeft_ι,
    Algebra.algebraMap_eq_smul_one]

/-- Degree zero of the tensored Koszul complex is `M`. -/
private noncomputable def degreeZeroEquiv {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] (r : ℕ) :
    ((⋀[R]^0 (Fin r → R)) ⊗[R] M) ≃ₗ[R] M :=
  (LinearEquiv.rTensor M (exteriorPower.zeroEquiv R (Fin r → R))).trans
    (TensorProduct.lid R M)

private lemma degreeZeroEquiv_d_tmul {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R)
    (x : Fin r → R) (m : M) :
    degreeZeroEquiv M r ((Koszul.d (Koszul.seqDual f) 0).rTensor M
      ((exteriorPower.oneEquiv R (Fin r → R)).symm x ⊗ₜ[R] m)) =
      Koszul.seqDual f x • m := by
  change (TensorProduct.lid R M)
    (LinearEquiv.rTensor M (exteriorPower.zeroEquiv R (Fin r → R))
      ((Koszul.d (Koszul.seqDual f) 0 ((exteriorPower.oneEquiv R (Fin r → R)).symm x)) ⊗ₜ[R] m)) = _
  rw [koszul_d_one]
  simp

private lemma degreeZeroEquiv_range {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R) :
    LinearMap.range ((degreeZeroEquiv M r).toLinearMap.comp
      ((Koszul.seqComplexTensor f M).d 1 0).hom) =
      Ideal.ofList (List.ofFn f) • (⊤ : Submodule R M) := by
  classical
  change LinearMap.range ((degreeZeroEquiv M r).toLinearMap.comp
    ((Koszul.d (Koszul.seqDual f) 0).rTensor M)) = _
  have hI : Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
    change Ideal.span {x | x ∈ List.ofFn f} = Ideal.span (Set.range f)
    congr 1
    ext x
    exact List.mem_ofFn
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    change degreeZeroEquiv M r ((Koszul.d (Koszul.seqDual f) 0).rTensor M x) ∈ _
    induction x using TensorProduct.inductionOn with
    | tmul x m =>
      obtain ⟨v, rfl⟩ := (exteriorPower.oneEquiv R (Fin r → R)).symm.surjective x
      rw [degreeZeroEquiv_d_tmul]
      apply Submodule.smul_mem_smul _ (Submodule.mem_top)
      rw [hI, Koszul.seqDual_apply]
      apply Submodule.sum_mem
      intro i _
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    | add x y hx hy => simpa only [map_add] using Submodule.add_mem _ hx hy
  · rw [hI, ← Submodule.span_univ (R := R) (M := M), Submodule.span_smul_span]
    apply Submodule.span_le.mpr
    rintro _ ⟨c, ⟨i, rfl⟩, m, _, rfl⟩
    refine ⟨(exteriorPower.oneEquiv R (Fin r → R)).symm (Pi.single i 1) ⊗ₜ[R] m, ?_⟩
    dsimp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [degreeZeroEquiv_d_tmul, Koszul.seqDual_single]

private lemma mem_range_d_one_iff {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R)
    (x : (Koszul.seqComplexTensor f M).X 0) :
    x ∈ LinearMap.range ((Koszul.seqComplexTensor f M).d 1 0).hom ↔
      degreeZeroEquiv M r x ∈ Ideal.ofList (List.ofFn f) • (⊤ : Submodule R M) := by
  rw [← degreeZeroEquiv_range M f]
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨y, rfl⟩
  · rintro ⟨y, hy⟩
    exact ⟨y, (degreeZeroEquiv M r).injective hy⟩

private lemma exactAt_succ_iff {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (n : ℕ) :
    C.ExactAt (n + 1) ↔ ∀ x : C.X (n + 1), C.d (n + 1) n x = 0 →
      ∃ y : C.X (n + 2), C.d (n + 2) (n + 1) y = x := by
  rw [C.exactAt_iff' (n + 2) (n + 1) n (by simp) (by simp), ShortComplex.moduleCat_exact_iff]
  rfl

private lemma coefficientCone_exactAt_succ {R : Type u} [CommRing R]
    (C : ChainComplex (ModuleCat.{w} R) ℕ) (a : R)
    (hC : ∀ n, C.ExactAt (n + 1))
    (ha : ∀ x : C.X 0, a • x ∈ LinearMap.range (C.d 1 0).hom →
      x ∈ LinearMap.range (C.d 1 0).hom) (n : ℕ) :
    (coefficientCone C a).ExactAt (n + 1) := by
  rw [exactAt_succ_iff]
  rintro ⟨b, c⟩ hbc
  have hfst : C.d (n + 1) n b + a • c = 0 := by
    cases n with
    | zero =>
      rw [coefficientCone_d] at hbc
      exact hbc
    | succ n =>
      rw [coefficientCone_d] at hbc
      exact congrArg Prod.fst hbc
  obtain ⟨t, ht⟩ : ∃ t : C.X (n + 1), C.d (n + 1) n t = c := by
    cases n with
    | zero =>
      apply ha c
      refine ⟨-b, ?_⟩
      simpa using (neg_eq_of_add_eq_zero_right hfst)
    | succ n =>
      apply (exactAt_succ_iff C n).mp (hC n) c
      rw [coefficientCone_d] at hbc
      have h := congrArg Prod.snd hbc
      change -(C.d (n + 1) n c) = 0 at h
      exact neg_eq_zero.mp h
  have hbt : C.d (n + 1) n (b + a • t) = 0 := by
    simpa only [map_add, map_smul, ht] using hfst
  obtain ⟨s, hs⟩ := (exactAt_succ_iff C n).mp (hC n) (b + a • t) hbt
  refine ⟨(s, -t), ?_⟩
  rw [coefficientCone_d]
  change (C.d (n + 2) (n + 1) s + a • (-t), -(C.d (n + 1) n (-t))) = (b, c)
  simp [hs, ht]

/-- Appending an element acting injectively on the quotient preserves Koszul regularity. -/
private lemma regular_snoc {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R) (a : R)
    (hf : Koszul.IsKoszulRegularOn f M)
    (ha : IsSMulRegular (M ⧸ (Ideal.ofList (List.ofFn f) • (⊤ : Submodule R M))) a) :
    Koszul.IsKoszulRegularOn (Fin.snoc f a) M := by
  intro i hi
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hi
  apply HomologicalComplex.ExactAt.isZero_homology
  apply HomologicalComplex.ExactAt.of_iso _ (coefficientSnocIso M f a).symm
  apply coefficientCone_exactAt_succ
  · intro n
    exact (HomologicalComplex.exactAt_iff_isZero_homology _ _).mpr (hf _ (Nat.succ_ne_zero n))
  · intro x hx
    apply (mem_range_d_one_iff M f x).mpr
    have hx' := (mem_range_d_one_iff M f (a • x)).mp hx
    rw [map_smul] at hx'
    apply (Submodule.Quotient.mk_eq_zero _).mp
    apply ha.right_eq_zero_of_smul
    exact (Submodule.Quotient.mk_eq_zero _).mpr hx'

/-- A weakly `M`-regular sequence is `M`-Koszul-regular. -/
private lemma weaklyRegular_implies_koszul {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R)
    (hf : RingTheory.Sequence.IsWeaklyRegular M (List.ofFn f)) :
    Koszul.IsKoszulRegularOn f M := by
  induction r with
  | zero =>
    intro i hi
    have : Subsingleton (⋀[R]^i (Fin 0 → R)) :=
      exteriorPower.subsingleton_of_span_eq_top_of_card_lt
        (Pi.basisFun R (Fin 0)) (Pi.basisFun R (Fin 0)).span_eq i
        (by simpa using Nat.pos_of_ne_zero hi)
    apply HomologicalComplex.ExactAt.isZero_homology
    apply HomologicalComplex.ExactAt.of_isZero
    exact ModuleCat.isZero_of_subsingleton (ModuleCat.of R ((⋀[R]^i (Fin 0 → R)) ⊗[R] M))
  | succ r ih =>
    have hlist : List.ofFn f = List.ofFn (fun i : Fin r => f i.castSucc) ++ [f (Fin.last r)] := by
      simpa only [List.concat_eq_append] using List.ofFn_succ' f
    rw [hlist, RingTheory.Sequence.isWeaklyRegular_append_iff,
      RingTheory.Sequence.isWeaklyRegular_singleton_iff] at hf
    have h := regular_snoc M (fun i : Fin r => f i.castSucc) (f (Fin.last r)) (ih _ hf.1) hf.2
    have hs : Fin.snoc (fun i : Fin r => f i.castSucc) (f (Fin.last r)) = f := by
      ext i
      refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
    simpa only [hs] using h

/-- If every term of a finite sequence acts injectively on the quotient of `M` by its predecessors,
then the sequence is `M`-Koszul-regular. In particular, an `M`-regular sequence is
`M`-Koszul-regular, and a regular sequence in `R` is Koszul-regular. -/
@[stacks 062F]
theorem isKoszulRegularOn_and_isKoszulRegular_of_regular
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {r : ℕ} {f : Fin r → R} :
    (RingTheory.Sequence.IsWeaklyRegular M (List.ofFn f) →
        Koszul.IsKoszulRegularOn f M) ∧
      (RingTheory.Sequence.IsRegular M (List.ofFn f) →
        Koszul.IsKoszulRegularOn f M) ∧
      (RingTheory.Sequence.IsRegular R (List.ofFn f) →
        Koszul.IsKoszulRegular f) :=
  ⟨weaklyRegular_implies_koszul M f,
    fun h => weaklyRegular_implies_koszul M f h.toIsWeaklyRegular,
    fun h => (Koszul.isKoszulRegularOn_self_iff f).mp
      (weaklyRegular_implies_koszul R f h.toIsWeaklyRegular)⟩

end KoszulRegularOfRegular

/-! ## Multiplying the last term of a sequence

Let `s` be a finite sequence of elements of a commutative ring, let `f g : R`, and let `M` be an
`R`-module. If adjoining either `f` or `g` to `s` gives an `M`-`H_1`-regular sequence, then
adjoining `f * g` does too, and the analogous assertion holds for `M`-Koszul-regularity.

Adjoining the final term is represented by `Fin.snoc`.
-/

section SnocMul

set_option backward.isDefEq.respectTransparency false

open CategoryTheory

universe u v

attribute [local instance] HasDerivedCategory.standard

private instance coefficientTensorFunctor_additive {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] :
    (coefficientTensorFunctor (R := R) M).Additive where
  map_add := by
    intro X Y f g
    apply ModuleCat.hom_ext
    exact LinearMap.rTensor_add M f.hom g.hom

/-- Tensoring the Koszul complex of a sequence with `M` gives the tensored Koszul complex. -/
private noncomputable def tensorSeqIso {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {n : ℕ} (s : Fin n → R) :
    ((coefficientTensorFunctor (R := R) M).mapHomologicalComplex (ComplexShape.down ℕ)).obj
        (Koszul.seqComplex s) ≅ Koszul.seqComplexTensor s M :=
  eqToIso (tensorComplex_seq s M)

private lemma isZero_mappingCone_homology {C : Type*} [Category C] [Abelian C]
    [HasDerivedCategory C] {X Y : CochainComplex C ℤ} (f : X ⟶ Y) (i : ℤ)
    (hY : Limits.IsZero (Y.homology i))
    (hX : Limits.IsZero (X.homology (i + 1))) :
    Limits.IsZero ((CochainComplex.mappingCone f).homology i) := by
  have h := CochainComplex.homologyMap_exact₃_of_distTriang
    (CochainComplex.mappingCone.triangle f)
    (DerivedCategory.mappingCone_triangle_distinguished f) i (i + 1) (by omega)
  exact h.isZero_X₂ (hY.eq_of_src _ _) (hX.eq_of_tgt _ _)

/-- Tensoring with `M` commutes with extension by zero from `ℕ`-indexed chain complexes to
`ℤ`-indexed cochain complexes. -/
private noncomputable def tensorExtendIso {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M]
    (K : ChainComplex (ModuleCat.{u} R) ℕ) :
    ((coefficientTensorFunctor (R := R) M).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} R)).obj K) ≅
      (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{max u v} R)).obj
        (((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj K) :=
  HomologicalComplex.Hom.isoOfComponents
    (C₁ := ((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj
        ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} R)).obj K))
    (C₂ := (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{max u v} R)).obj
      (((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj K)) (fun i => by
    classical
    change (coefficientTensorFunctor (R := R) M).obj
        (((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} R)).obj K).X i) ≅
      (((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{max u v} R)).obj
        (((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj K)).X i)
    by_cases h : ∃ j, ComplexShape.embeddingDownNat.f j = i
    · let j := h.choose
      let hj : ComplexShape.embeddingDownNat.f j = i := h.choose_spec
      refine Iso.trans ((coefficientTensorFunctor (R := R) M).mapIso
        (K.extendXIso ComplexShape.embeddingDownNat hj)) ?_
      exact (((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj K).extendXIso
          ComplexShape.embeddingDownNat hj |>.symm
    · have hz₁ := (coefficientTensorFunctor (R := R) M).map_isZero
          (K.isZero_extend_X ComplexShape.embeddingDownNat i
            (fun j hj => h ⟨j, hj⟩))
      have hz₂ := (((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj K).isZero_extend_X
            ComplexShape.embeddingDownNat i (fun j hj => h ⟨j, hj⟩)
      exact hz₁.iso hz₂) (by
    intro i j hij
    classical
    by_cases hi : ∃ k, ComplexShape.embeddingDownNat.f k = i
    · by_cases hj : ∃ k, ComplexShape.embeddingDownNat.f k = j
      · let k := hi.choose
        let l := hj.choose
        have hk : ComplexShape.embeddingDownNat.f k = i := hi.choose_spec
        have hl : ComplexShape.embeddingDownNat.f l = j := hj.choose_spec
        simp only [dite_eq_left hi, dite_eq_left hj]
        let F := coefficientTensorFunctor (R := R) M
        let K' := (F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K
        let e₁ := F.mapIso (K.extendXIso ComplexShape.embeddingDownNat hk) ≪≫
          (K'.extendXIso ComplexShape.embeddingDownNat hk).symm
        let e₂ := F.mapIso (K.extendXIso ComplexShape.embeddingDownNat hl) ≪≫
          (K'.extendXIso ComplexShape.embeddingDownNat hl).symm
        change e₁.hom ≫ (K'.extend ComplexShape.embeddingDownNat).d i j =
          F.map ((K.extend ComplexShape.embeddingDownNat).d i j) ≫ e₂.hom
        rw [HomologicalComplex.extend_d_eq _ _ hk hl,
          HomologicalComplex.extend_d_eq _ _ hk hl]
        dsimp [e₁, e₂, K']
        simp
      · have hz := (((coefficientTensorFunctor (R := R) M).mapHomologicalComplex
            (ComplexShape.down ℕ)).obj K).isZero_extend_X
              ComplexShape.embeddingDownNat j (fun k h => hj ⟨k, h⟩)
        exact hz.eq_of_tgt _ _
    · have hz := (coefficientTensorFunctor (R := R) M).map_isZero
          (K.isZero_extend_X ComplexShape.embeddingDownNat i
            (fun k h => hi ⟨k, h⟩))
      exact hz.eq_of_src _ _)

/-- Tensoring the extended Koszul cochain complex of a sequence with `M` gives the extension of
the tensored Koszul complex. -/
private noncomputable def tensorKoszulCochainIso {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {n : ℕ} (s : Fin n → R) :
    ((coefficientTensorFunctor (R := R) M).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} R)).obj
          (Koszul.seqComplex s)) ≅
      (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{max u v} R)).obj
        (Koszul.seqComplexTensor s M) :=
  tensorExtendIso M (Koszul.seqComplex s) ≪≫
    (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{max u v} R)).mapIso
      (tensorSeqIso M s)

private lemma isZero_extended {R : Type u} [CommRing R]
    (K : ChainComplex (ModuleCat.{v} R) ℕ) (i : ℕ)
    (h : Limits.IsZero (K.homology i)) :
    Limits.IsZero ((K.extend ComplexShape.embeddingDownNat).homology (-(i : ℤ))) := by
  exact h.of_iso (K.extendHomologyIso ComplexShape.embeddingDownNat (by simp))

private lemma isZero_mapped_koszul {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {n : ℕ} (s : Fin n → R) (i : ℕ)
    (h : Limits.IsZero ((Koszul.seqComplexTensor s M).homology i)) :
    Limits.IsZero
      (((((coefficientTensorFunctor (R := R) M).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((Koszul.seqComplex s).extend ComplexShape.embeddingDownNat))).homology (-(i : ℤ))) := by
  have hz := isZero_extended (Koszul.seqComplexTensor s M) i h
  exact hz.of_iso ((HomologicalComplex.homologyFunctor _ _ (-(i : ℤ))).mapIso
    (tensorKoszulCochainIso M s))

set_option backward.isDefEq.respectTransparency true in
private lemma isZero_mapped_shifted_koszul {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {n : ℕ} (s : Fin n → R) (i : ℕ)
    (h : Limits.IsZero ((Koszul.seqComplexTensor s M).homology i)) :
    Limits.IsZero
      (((((coefficientTensorFunctor (R := R) M).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (((Koszul.seqComplex s).extend ComplexShape.embeddingDownNat)⟦(-1 : ℤ)⟧))).homology
          (-(i : ℤ) + 1)) := by
  let F := coefficientTensorFunctor (R := R) M
  let K := (Koszul.seqComplex s).extend ComplexShape.embeddingDownNat
  have hz := isZero_mapped_koszul M s i h
  let e₁ : ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj (K⟦(-1 : ℤ)⟧)).homology
        (-(i : ℤ) + 1) ≅
      (((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)⟦(-1 : ℤ)⟧).homology
        (-(i : ℤ) + 1) :=
    (HomologicalComplex.homologyFunctor _ _ (-(i : ℤ) + 1)).mapIso
      ((F.mapCochainComplexShiftIso (-1)).app K)
  let e₂ : (((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)⟦(-1 : ℤ)⟧).homology
        (-(i : ℤ) + 1) ≅
      ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology (-(i : ℤ)) :=
    by
      let e := ((HomologicalComplex.homologyFunctor (ModuleCat.{max u v} R)
          (ComplexShape.up ℤ) (0 : ℤ)).shiftIso
            (-1) (-(i : ℤ) + 1) (-(i : ℤ)) (by omega)).app
              ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)
      change (((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)⟦(-1 : ℤ)⟧).homology
          (-(i : ℤ) + 1) ≅
        ((F.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology (-(i : ℤ)) at e
      exact e
  exact hz.of_iso (e₁ ≪≫ e₂)

/-- If the tensored Koszul complexes of `Fin.snoc s f` and of `Fin.snoc s g` have vanishing
homology in degree `i`, then so does that of `Fin.snoc s (f * g)`. -/
private lemma product_homology_isZero {R : Type u} [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M] {n : ℕ} (s : Fin n → R)
    (f g : R) (i : ℕ)
    (hf : Limits.IsZero ((Koszul.seqComplexTensor (Fin.snoc s f) M).homology i))
    (hg : Limits.IsZero ((Koszul.seqComplexTensor (Fin.snoc s g) M).homology i)) :
    Limits.IsZero ((Koszul.seqComplexTensor (Fin.snoc s (f * g)) M).homology i) := by
  let K (a : R) : CochainComplex (ModuleCat.{u} R) ℤ :=
    (Koszul.seqComplex (Fin.snoc s a)).extend ComplexShape.embeddingDownNat
  obtain ⟨ψ, ⟨e⟩⟩ :=
    Koszul.exists_homotopyEquiv_koszulComplex_snoc_mul_mappingCone s f g
  let F := coefficientTensorFunctor (R := R) M
  let FC := F.mapHomologicalComplex (ComplexShape.up ℤ)
  let e' : HomotopyEquiv
      ((Koszul.seqComplexTensor (Fin.snoc s (f * g)) M).extend
        ComplexShape.embeddingDownNat)
      (CochainComplex.mappingCone (FC.map ψ)) :=
    (HomotopyEquiv.ofIso (tensorKoszulCochainIso M (Fin.snoc s (f * g))).symm).trans
      ((F.mapHomotopyEquiv e).trans
        (HomotopyEquiv.ofIso (CochainComplex.mappingCone.mapHomologicalComplexIso ψ F)))
  have hY : Limits.IsZero ((FC.obj (K g)).homology (-(i : ℤ))) :=
    isZero_mapped_koszul M (Fin.snoc s g) i hg
  have hX : Limits.IsZero ((FC.obj ((K f)⟦(-1 : ℤ)⟧)).homology (-(i : ℤ) + 1)) :=
    isZero_mapped_shifted_koszul M (Fin.snoc s f) i hf
  have hc : Limits.IsZero
      ((CochainComplex.mappingCone (FC.map ψ)).homology (-(i : ℤ))) :=
    isZero_mappingCone_homology (FC.map ψ) (-(i : ℤ)) hY hX
  have hext : Limits.IsZero
      (((Koszul.seqComplexTensor (Fin.snoc s (f * g)) M).extend
        ComplexShape.embeddingDownNat).homology (-(i : ℤ))) :=
    hc.of_iso (e'.toHomologyIso (-(i : ℤ)))
  exact hext.of_iso
    ((Koszul.seqComplexTensor (Fin.snoc s (f * g)) M).extendHomologyIso
      ComplexShape.embeddingDownNat (by simp)).symm

/-- Adjoining a product to a finite sequence preserves both `M`-`H₁`-regularity and
`M`-Koszul-regularity when adjoining each factor separately has the corresponding property. -/
@[stacks 062G]
theorem isH1RegularOn_and_isKoszulRegularOn_snoc_mul
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {n : ℕ} (s : Fin n → R) (f g : R) :
    ((Koszul.IsH1RegularOn (Fin.snoc s f) M ∧
        Koszul.IsH1RegularOn (Fin.snoc s g) M) →
      Koszul.IsH1RegularOn (Fin.snoc s (f * g)) M) ∧
    ((Koszul.IsKoszulRegularOn (Fin.snoc s f) M ∧
        Koszul.IsKoszulRegularOn (Fin.snoc s g) M) →
      Koszul.IsKoszulRegularOn (Fin.snoc s (f * g)) M) := by
  constructor
  · rintro ⟨hf, hg⟩
    exact product_homology_isZero M s f g 1 hf hg
  · rintro ⟨hf, hg⟩ i hi
    exact product_homology_isZero M s f g i (hf i hi) (hg i hi)

end SnocMul

end Koszul
