@[expose] public section

/-!
# Affine blowup along an H₁-regular sequence

Let `f₀, f₁, …, fₙ` be an `H₁`-regular sequence in a commutative ring `R`, and let
`I` be the ideal that it generates. The affine blowup algebra `R[I/f₀]` is isomorphic to
the polynomial algebra in `n` variables modulo the relations `f₀ Xᵢ - fᵢ₊₁`.

## Main results

* `Koszul.exists_affineBlowup_algEquiv_mvPolynomial_quotient_of_isH1Regular` gives the
  presentation of the affine blowup algebra associated to an `H₁`-regular sequence.

## Implementation notes

The distinguished first element and the remaining sequence are represented by
`f : Fin (n + 1) → R` and the variables are indexed by `Fin n`. The affine blowup algebra is
the subalgebra `affineBlowupAlgebraAway` of `Localization.Away (f 0)`, defined in
`StacksFrontier.RingTheory.Blowup.Basic`. The conclusion is propositionally truncated, since the
source asserts an isomorphism without specifying one as additional structure.

The presentation is obtained from `Ideal.range_eq_affineBlowup_and_ker_eq_saturation`
(Stacks 0G8S), which identifies the range of `Xᵢ ↦ fᵢ₊₁ / f₀` with `R[I/f₀]` and its kernel
with the `f₀`-power saturation of the relation ideal `J = (f₀ Xᵢ - fᵢ₊₁)`. `H₁`-regularity
enters only to remove that saturation: the sequence
`f₀, f₀ X₁ - f₁, …, f₀ Xₙ - fₙ` over `R[X₁, …, Xₙ]` is again `H₁`-regular — it differs from
the base change of `f` by an elementary change of coordinates, recorded as
`Koszul.elementaryChange` — and the first member of an `H₁`-regular sequence acts as a
nonzerodivisor on the quotient by the remaining members, so `J` is already `f₀`-saturated.

## References

* [The Stacks Project, Tag 0BIQ](https://stacks.math.columbia.edu/tag/0BIQ)
-/

namespace Koszul

universe u

open CategoryTheory

/-- An automorphism of `Fin r → A` carrying `φ'` back to `φ` induces an isomorphism of Koszul
complexes `complex φ ≅ complex φ'`. -/
private noncomputable def complexIsoOfEquiv {A : Type u} [CommRing A] {r : ℕ}
    (φ φ' : Module.Dual A (Fin r → A)) (e : (Fin r → A) ≃ₗ[A] (Fin r → A))
    (h : φ'.comp e.toLinearMap = φ) : complex φ ≅ complex φ' :=
  HomologicalComplex.Hom.isoOfComponents
    (fun n => (exteriorPowerCongr n e).toModuleIso)
    (fun i j hij => by
      obtain rfl : j + 1 = i := hij
      rw [complex_d, complex_d]
      refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
      change (⋀[A]^(j + 1) (Fin r → A)) at x
      change d φ' j (exteriorPowerCongr (j + 1) e x) = exteriorPowerCongr j e (d φ j x)
      apply Subtype.ext
      rw [d_apply_coe, exteriorPowerCongr_coe, exteriorPowerCongr_coe, d_apply_coe]
      exact (koszul_map_comm φ φ' e.toLinearMap h x).symm)

/-- `H₁`-regularity is preserved by an elementary change of coordinates identifying the two
dual forms. -/
private theorem isH1Regular_equiv {A : Type u} [CommRing A] {r : ℕ}
    (f g : Fin r → A) (e : (Fin r → A) ≃ₗ[A] (Fin r → A))
    (h : (seqDual g).comp e.toLinearMap = seqDual f) (hf : IsH1Regular f) :
    IsH1Regular g :=
  hf.of_iso ((HomologicalComplex.homologyFunctor _ _ 1).mapIso
    (complexIsoOfEquiv (seqDual f) (seqDual g) e h)).symm

/-- An `H₁`-regular sequence stays `H₁`-regular after the flat base change
`R → R[X₁, …, Xₙ]`. -/
private theorem isH1Regular_algebraMap_mvPolynomial {R : Type u} [CommRing R] {r n : ℕ}
    (f : Fin r → R) (hf : IsH1Regular f) :
    IsH1Regular (fun i => algebraMap R (MvPolynomial (Fin n) R) (f i)) :=
  (isH1RegularOn_self_iff _).1 <| isH1RegularOn_of_linearEquiv _
    (TensorProduct.AlgebraTensorModule.rid R (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) R))
    (KoszulC.isH1Regular_baseChange f R ((isH1RegularOn_self_iff f).2 hf))

/-- The first member of an `H₁`-regular sequence is a nonzerodivisor on the quotient by the
ideal generated by the remaining members. -/
private theorem head_isSMulRegular_quotient_tail {A : Type u} [CommRing A] {n : ℕ}
    (g : Fin (n + 1) → A) (hg : Koszul.IsH1Regular g) :
    IsSMulRegular (A ⧸ Ideal.span (Set.range fun i : Fin n => g i.succ)) (g 0) := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro x hx
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx
  let z : Fin (n + 1) → A := Fin.cases x (fun i => -c i)
  have hz : ∑ i, z i * g i = 0 := by
    rw [Fin.sum_univ_succ]
    simp only [z, Fin.cases_zero, Fin.cases_succ]
    rw [smul_eq_mul] at hc
    simp_rw [neg_mul]
    rw [Finset.sum_neg_distrib, hc]
    ring
  have hzrel : z ∈ Koszul.relSpan g :=
    (Koszul.isH1Regular_iff_forall g).1 hg z hz
  have hcoord : ∀ w ∈ Koszul.relSpan g,
      w 0 ∈ Ideal.span (Set.range fun i : Fin n => g i.succ) := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨ij, rfl⟩ := hw
      change Koszul.trivRel g ij.1 ij.2 0 ∈ _
      rcases Fin.eq_zero_or_eq_succ ij.1 with hi | ⟨i, hi⟩ <;>
        rcases Fin.eq_zero_or_eq_succ ij.2 with hj | ⟨j, hj⟩
      all_goals rw [hi, hj]
      · simp [Koszul.trivRel]
      · simpa [Koszul.trivRel] using
          neg_mem (Ideal.subset_span (s := Set.range fun i : Fin n => g i.succ) ⟨j, rfl⟩)
      · simpa [Koszul.trivRel] using Ideal.subset_span (s := Set.range fun i : Fin n => g i.succ)
          ⟨i, rfl⟩
      · simp [Koszul.trivRel]
    | zero => simp
    | add a b _ _ ha hb => exact Ideal.add_mem _ ha hb
    | smul a w _ hw => simpa [smul_eq_mul] using Ideal.mul_mem_left _ a hw
  simpa [z] using hcoord z hzrel

/-- The elementary change of coordinates on `Fin (n + 1) → A` sending
`(c₀, c₁, …, cₙ)` to `(c₀ + ∑ᵢ cᵢ₊₁ xᵢ, -c₁, …, -cₙ)`. -/
private noncomputable def elementaryChange {A : Type u} [CommRing A] {n : ℕ}
    (x : Fin n → A) : (Fin (n + 1) → A) ≃ₗ[A] (Fin (n + 1) → A) where
  toFun c := Fin.cases (c 0 + ∑ i, c i.succ * x i) (fun i => -c i.succ)
  invFun c := Fin.cases (c 0 + ∑ i, c i.succ * x i) (fun i => -c i.succ)
  map_add' a b := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp only [Pi.add_apply, Fin.cases_zero]
      simp_rw [add_mul]
      rw [Finset.sum_add_distrib]
      ring
    · simp [add_comm]
  map_smul' a b := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp only [Pi.smul_apply, smul_eq_mul, Fin.cases_zero]
      simp only [RingHom.id_apply]
      rw [mul_add, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro j hj
      ring
    · simp
  left_inv c := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i <;> simp
  right_inv c := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i <;> simp

/-- If `f₀, …, fₙ` is `H₁`-regular in `R`, then `f₀, f₀ X₁ - f₁, …, f₀ Xₙ - fₙ` is `H₁`-regular
in `R[X₁, …, Xₙ]`. -/
private theorem relationSequence_isH1Regular {R : Type u} [CommRing R] {n : ℕ}
    (f : Fin (n + 1) → R) (hf : Koszul.IsH1Regular f) :
    Koszul.IsH1Regular (Fin.cases (MvPolynomial.C (f 0))
      (fun i => MvPolynomial.C (f 0) * MvPolynomial.X i - MvPolynomial.C (f i.succ))) := by
  let S := MvPolynomial (Fin n) R
  let h : Fin (n + 1) → S := fun i => algebraMap R S (f i)
  let g : Fin (n + 1) → S := Fin.cases (MvPolynomial.C (f 0))
    (fun i => MvPolynomial.C (f 0) * MvPolynomial.X i - MvPolynomial.C (f i.succ))
  have hh : Koszul.IsH1Regular h := isH1Regular_algebraMap_mvPolynomial f hf
  let e := elementaryChange (fun i : Fin n => MvPolynomial.X i : Fin n → S)
  have he : (Koszul.seqDual g).comp e.toLinearMap = Koszul.seqDual h := by
    apply LinearMap.ext
    intro c
    simp only [LinearMap.comp_apply, Koszul.seqDual_apply]
    simp only [Fin.sum_univ_succ, e, elementaryChange, g, h,
      Fin.cases_zero, Fin.cases_succ]
    change (c 0 + ∑ x, c x.succ * MvPolynomial.X x) * MvPolynomial.C (f 0) +
      ∑ x, -c x.succ * (MvPolynomial.C (f 0) * MvPolynomial.X x -
        MvPolynomial.C (f x.succ)) =
      c 0 * MvPolynomial.C (f 0) + ∑ i : Fin n, c i.succ * MvPolynomial.C (f i.succ)
    rw [add_mul, Finset.sum_mul]
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib]
    simp_rw [neg_mul]
    rw [Finset.sum_neg_distrib, Finset.sum_neg_distrib]
    ring_nf
  exact isH1Regular_equiv h g e he hh

/-- If `f₀, …, fₙ` is `H₁`-regular in `R`, then `f₀, f₀ X₁ - f₁, …, f₀ Xₙ - fₙ` is `H₁`-regular
in `R[X₁, …, Xₙ]`. -/
alias isH1Regular_relationSequence := relationSequence_isH1Regular

/-- **Stacks Project, Tag 0BIQ.** The affine blowup algebra associated to an `H₁`-regular
sequence is the polynomial algebra on the ratios of the remaining terms by the first term,
modulo the evident linear relations. -/
@[stacks 0BIQ]
public theorem exists_affineBlowup_algEquiv_mvPolynomial_quotient_of_isH1Regular
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin (n + 1) → R)
    (hf : Koszul.IsH1Regular f) :
    Nonempty
      (affineBlowupAlgebraAway (Ideal.span (Set.range f)) (f 0) ≃ₐ[R]
        MvPolynomial (Fin n) R ⧸
          Ideal.span
            (Set.range fun i : Fin n ↦
              MvPolynomial.C (f 0) * MvPolynomial.X i - MvPolynomial.C (f i.succ))) := by
  classical
  let S := MvPolynomial (Fin n) R
  let g : Fin (n + 1) → S := Fin.cases (MvPolynomial.C (f 0))
    (fun i => MvPolynomial.C (f 0) * MvPolynomial.X i - MvPolynomial.C (f i.succ))
  let J : Ideal S := Ideal.span (Set.range fun i : Fin n ↦ g i.succ)
  let φ : S →ₐ[R] Localization.Away (f 0) :=
    MvPolynomial.aeval fun i => IsLocalization.Away.invSelf (f 0) *
      algebraMap R (Localization.Away (f 0)) (f i.succ)
  have hinv1 : IsLocalization.Away.invSelf (f 0) * algebraMap R (Localization.Away (f 0)) (f 0) =
      1 := by
    rw [mul_comm, IsLocalization.Away.mul_invSelf]
  have hφ : ∀ i, φ (MvPolynomial.X i) * algebraMap R (Localization.Away (f 0)) (f 0) =
      algebraMap R (Localization.Away (f 0)) (f i.succ) := fun i => by
    rw [show φ (MvPolynomial.X i) = _ from MvPolynomial.aeval_X _ i, mul_right_comm, hinv1,
      one_mul]
  have hI : Ideal.span (Set.range f) =
      Ideal.span (insert (f 0) (Set.range fun i : Fin n => f i.succ)) :=
    congrArg Ideal.span (Fin.range_fin_succ f)
  obtain ⟨hrange, hker⟩ :=
    Ideal.range_eq_affineBlowup_and_ker_eq_saturation hI φ hφ
  have hg : Koszul.IsH1Regular g := by
    simpa [g] using relationSequence_isH1Regular f hf
  have hreg : IsSMulRegular (S ⧸ J) (MvPolynomial.C (f 0) : S) := by
    simpa [J, g] using head_isSMulRegular_quotient_tail g hg
  have hkerJ : RingHom.ker (φ : S →+* Localization.Away (f 0)) = J := by
    refine le_antisymm (fun p hp => ?_) fun p hp => (hker p).2 ⟨0, by simpa [J, g] using hp⟩
    obtain ⟨k, hk⟩ := (hker p).1 hp
    exact mem_of_isSMulRegular_quotient_of_smul_mem (hreg.pow k)
      (by simpa [J, g, MvPolynomial.smul_eq_C_mul, map_pow, smul_eq_mul] using hk)
  have hrange' : φ.range = affineBlowupAlgebraAway (Ideal.span (Set.range f)) (f 0) := by
    ext y
    change y ∈ Set.range φ ↔ _
    have ha : f 0 ∈ Ideal.span (Set.range f) :=
      Ideal.subset_span (Set.mem_range_self 0)
    rw [hrange, Set.mem_ofPred_eq, mem_affineBlowup_iff _ _ ha (z := y)]
    have hinv (k : ℕ) : IsLocalization.Away.invSelf (f 0) ^ k *
        algebraMap R (Localization.Away (f 0)) (f 0) ^ k = 1 := by
      rw [← mul_pow, hinv1, one_pow]
    refine exists_congr fun k => exists_congr fun x => and_congr_right fun _ => ⟨fun hy => ?_, ?_⟩
    · rw [← hy, mul_left_comm, hinv, mul_one]
    · rintro rfl
      rw [mul_right_comm, hinv, one_mul]
  refine ⟨(Subalgebra.equivOfEq _ _ hrange').symm.trans ?_⟩
  exact (Ideal.quotientKerEquivRange φ).symm.trans (Ideal.quotientEquivAlgOfEq R hkerJ)

end Koszul
