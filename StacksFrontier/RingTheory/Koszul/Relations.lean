module

public import StacksFrontier.RingTheory.Koszul.Defs
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Relations among a sequence and the first Koszul homology

For a sequence `f : Fin r → A` of elements of a commutative ring `A`, the bottom of the
Koszul complex is

`⋀²(Aʳ) --d₂--> Aʳ --d₁--> A`,

with `d₁ (a) = ∑ i, a i * f i` and `d₂ (eᵢ ∧ eⱼ) = fᵢ eⱼ - fⱼ eᵢ`.  Consequently the first
Koszul homology of `f` vanishes exactly when every *relation* `∑ i, a i * f i = 0` is an
`A`-linear combination of the *trivial relations* `fᵢ eⱼ - fⱼ eᵢ`.

The degree-one differential `d₁` is the functional `Koszul.seqDual f`, with which the Koszul
differential `Koszul.d` contracts in every degree.

## Main definitions

* `Koszul.trivRel`, `Koszul.relSpan`: the trivial relations and the submodule they span.
* `Koszul.h1ConcreteIso`: the first Koszul homology is the module of relations modulo the
  trivial relations.
* `Koszul.koszulAugmentation`: the augmentation `K_•(f) ⟶ (A / (f₁, …, f_r))[0]`.

## Main results

* `Koszul.map_range_d_one`: the image of `⋀²(Aʳ) → ⋀¹(Aʳ)` is `Koszul.relSpan`.
* `Koszul.isH1Regular_iff_ker_le_relSpan`: vanishing of the first Koszul homology is
  equivalent to `LinearMap.ker (seqDual f) ≤ relSpan f`.
* `Koszul.range_d_zero`: the image of `⋀¹(Aʳ) → ⋀⁰(Aʳ) ≃ A` is the ideal generated by `f`.
-/

@[expose] public section

namespace Koszul

universe u

open CategoryTheory

variable {A : Type*} [CommRing A] {r : ℕ}

/-! ### Trivial relations -/

/-- The trivial Koszul relation `fᵢ • eⱼ - fⱼ • eᵢ` in `Aʳ`, where `eₖ = Pi.single k 1` is the
`k`-th standard basis vector. -/
noncomputable def trivRel (f : Fin r → A) (i j : Fin r) : Fin r → A :=
  Pi.single j (f i) - Pi.single i (f j)

/-- The submodule of `Aʳ` spanned by the trivial Koszul relations of `f`. -/
noncomputable def relSpan (f : Fin r → A) : Submodule A (Fin r → A) :=
  Submodule.span A (Set.range fun p : Fin r × Fin r => trivRel f p.1 p.2)

/-- Each trivial relation lies in `relSpan f`. -/
theorem trivRel_mem_relSpan (f : Fin r → A) (i j : Fin r) : trivRel f i j ∈ relSpan f :=
  Submodule.subset_span ⟨(i, j), rfl⟩

/-- The trivial relations are relations: `seqDual f` vanishes on them. -/
theorem seqDual_trivRel (f : Fin r → A) (i j : Fin r) : seqDual f (trivRel f i j) = 0 := by
  rw [trivRel, map_sub, seqDual_apply_single, seqDual_apply_single]
  ring

/-- Every element of `relSpan f` is a relation among `f`. -/
theorem relSpan_le_ker (f : Fin r → A) : relSpan f ≤ LinearMap.ker (seqDual f) := by
  rw [relSpan, Submodule.span_le]
  rintro x ⟨p, rfl⟩
  exact seqDual_trivRel f p.1 p.2

/-- The value of the degree-two Koszul differential on a bivector `a ∧ b`, written out in
`Aʳ`.  It is antisymmetric and bilinear in `a` and `b`. -/
noncomputable def pairRel (f a b : Fin r → A) : Fin r → A := seqDual f a • b - seqDual f b • a

/-- On standard basis vectors, `pairRel f` is the trivial relation `trivRel f i j`. -/
theorem pairRel_single_single (f : Fin r → A) (i j : Fin r) :
    pairRel f (Pi.single i 1) (Pi.single j 1) = trivRel f i j := by
  funext k
  simp [pairRel, trivRel, Pi.single_apply, mul_ite]

/-- The standard basis vectors span `Aʳ`. -/
theorem span_range_single (A : Type*) [CommRing A] (r : ℕ) :
    Submodule.span A (Set.range fun i : Fin r => (Pi.single i 1 : Fin r → A)) = ⊤ := by
  have h : (fun i : Fin r => (Pi.single i 1 : Fin r → A)) = ⇑(Pi.basisFun A (Fin r)) := by
    funext i
    simp [Pi.basisFun_apply]
  rw [h]
  exact (Pi.basisFun A (Fin r)).span_eq

/-- `pairRel f` is linear in its first argument with respect to scalars. -/
theorem pairRel_smul_left (f : Fin r → A) (t : A) (a b : Fin r → A) :
    pairRel f (t • a) b = t • pairRel f a b := by
  funext k
  simp only [pairRel, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, map_smul]
  ring

/-- `pairRel f` is linear in its second argument with respect to scalars. -/
theorem pairRel_smul_right (f : Fin r → A) (t : A) (a b : Fin r → A) :
    pairRel f a (t • b) = t • pairRel f a b := by
  funext k
  simp only [pairRel, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, map_smul]
  ring

/-- A predicate on `Aʳ` that holds at `0` and the standard basis vectors and is closed under
addition and scalar multiplication holds everywhere. -/
private theorem forall_of_single {p : (Fin r → A) → Prop} (x : Fin r → A) (h0 : p 0)
    (hadd : ∀ x y, p x → p y → p (x + y)) (hsmul : ∀ (t : A) x, p x → p (t • x))
    (hsingle : ∀ i, p (Pi.single i 1)) : p x := by
  have hmem : x ∈ (⊤ : Submodule A (Fin r → A)) := Submodule.mem_top
  rw [← span_range_single A r] at hmem
  induction hmem using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact hsingle i
  | zero => exact h0
  | add x y _ _ hx hy => exact hadd x y hx hy
  | smul t x _ hx => exact hsmul t x hx

/-- Every `pairRel f a b` lies in `relSpan f`. -/
theorem pairRel_mem_relSpan (f a b : Fin r → A) : pairRel f a b ∈ relSpan f := by
  refine forall_of_single (p := fun a => pairRel f a b ∈ relSpan f) a (by simp [pairRel])
    (fun x y hx hy => ?_) (fun t x hx => ?_) fun i => ?_
  · simpa [pairRel, add_smul, smul_add, sub_add_sub_comm] using Submodule.add_mem _ hx hy
  · simpa [pairRel_smul_left] using Submodule.smul_mem _ t hx
  · refine forall_of_single (p := fun b => pairRel f (Pi.single i 1) b ∈ relSpan f) b
      (by simp [pairRel]) (fun x y hx hy => ?_) (fun t x hx => ?_) fun j => ?_
    · simpa [pairRel, add_smul, smul_add, sub_add_sub_comm] using Submodule.add_mem _ hx hy
    · simpa [pairRel_smul_right] using Submodule.smul_mem _ t hx
    · rw [pairRel_single_single]
      exact trivRel_mem_relSpan f i j

/-- `relSpan f` is spanned by the elements `pairRel f a b`. -/
theorem relSpan_eq_span_range_pairRel (f : Fin r → A) :
    relSpan f = Submodule.span A (Set.range fun p : (Fin r → A) × (Fin r → A) =>
      pairRel f p.1 p.2) := by
  refine le_antisymm (Submodule.span_le.2 ?_) (Submodule.span_le.2 ?_)
  · rintro x ⟨p, rfl⟩
    exact Submodule.subset_span ⟨(Pi.single p.1 1, Pi.single p.2 1), pairRel_single_single f _ _⟩
  · rintro x ⟨p, rfl⟩
    exact pairRel_mem_relSpan f p.1 p.2

variable {M : Type*} [AddCommGroup M] [Module A M]

/-! ### The bottom of the Koszul complex in concrete terms -/

/-- An element `a` of `M`, viewed in `⋀¹ M` and then in the exterior algebra, is `ι a`. -/
theorem coe_oneEquiv_symm (a : M) :
    ((exteriorPower.oneEquiv A M).symm a : ExteriorAlgebra A M) = ExteriorAlgebra.ι A a := by
  rw [exteriorPower.oneEquiv_symm_apply, exteriorPower.ιMulti_apply_coe]
  simp [ExteriorAlgebra.ιMulti]

/-- An element `x` of `⋀¹ M`, viewed in the exterior algebra, is `ι` of its image in `M`. -/
theorem coe_oneEquiv (x : ⋀[A]^1 M) :
    (x : ExteriorAlgebra A M) = ExteriorAlgebra.ι A (exteriorPower.oneEquiv A M x) := by
  conv_lhs => rw [← (exteriorPower.oneEquiv A M).symm_apply_apply x]
  exact coe_oneEquiv_symm _

/-- If `x ∈ ⋀¹ M` is `ι a` in the exterior algebra, then its image in `M` is `a`. -/
theorem oneEquiv_eq_of_coe {x : ⋀[A]^1 M} {a : M}
    (hx : (x : ExteriorAlgebra A M) = ExteriorAlgebra.ι A a) :
    exteriorPower.oneEquiv A M x = a := by
  refine (ExteriorAlgebra.ι_leftInverse (R := A) (M := M)).injective ?_
  rw [← coe_oneEquiv, hx]

/-- The exterior product of two vectors is the product of their images under `ι`. -/
theorem ιMulti_two_apply (v : Fin 2 → M) :
    ExteriorAlgebra.ιMulti A 2 v = ExteriorAlgebra.ι A (v 0) * ExteriorAlgebra.ι A (v 1) := by
  rw [ιMulti_succ_apply, ιMulti_succ_apply]
  have h0 : ExteriorAlgebra.ιMulti A 0 (Fin.tail (Fin.tail v)) = 1 := by
    simp [ExteriorAlgebra.ιMulti]
  rw [h0, mul_one]
  simp [Fin.tail]

/-- The degree-one Koszul differential is, under the identifications `⋀¹(Aʳ) ≃ Aʳ` and
`⋀⁰(Aʳ) ≃ A`, the linear form `seqDual f`. -/
theorem coe_d_zero (f : Fin r → A) (x : ⋀[A]^1 (Fin r → A)) :
    (d (seqDual f) 0 x : ExteriorAlgebra A (Fin r → A))
      = algebraMap A (ExteriorAlgebra A (Fin r → A))
          (seqDual f (exteriorPower.oneEquiv A (Fin r → A) x)) := by
  rw [d_apply_coe, coe_oneEquiv, CliffordAlgebra.contractLeft_ι]

/-- An element of `⋀¹(Aʳ)` is in the kernel of the degree-one Koszul differential exactly
when its image in `Aʳ` is a relation among `f`. -/
theorem mem_ker_d_zero_iff (f : Fin r → A) (x : ⋀[A]^1 (Fin r → A)) :
    x ∈ LinearMap.ker (d (seqDual f) 0)
      ↔ exteriorPower.oneEquiv A (Fin r → A) x ∈ LinearMap.ker (seqDual f) := by
  rw [LinearMap.mem_ker, LinearMap.mem_ker, ← Submodule.coe_eq_zero, coe_d_zero,
    ExteriorAlgebra.algebraMap_eq_zero_iff]

/-- Under `⋀¹(Aʳ) ≃ Aʳ`, the kernel of the degree-one Koszul differential is the module of
relations `LinearMap.ker (seqDual f)`. -/
theorem map_ker_d_zero (f : Fin r → A) :
    Submodule.map (exteriorPower.oneEquiv A (Fin r → A) : (⋀[A]^1 (Fin r → A)) →ₗ[A] (Fin r → A))
        (LinearMap.ker (d (seqDual f) 0)) = LinearMap.ker (seqDual f) := by
  ext v
  rw [Submodule.mem_map_equiv, mem_ker_d_zero_iff, LinearEquiv.apply_symm_apply]

/-- The degree-two Koszul differential sends the bivector `v 0 ∧ v 1` to
`pairRel f (v 0) (v 1) = seqDual f (v 0) • v 1 - seqDual f (v 1) • v 0`. -/
theorem oneEquiv_d_one_ιMulti (f : Fin r → A) (v : Fin 2 → (Fin r → A)) :
    exteriorPower.oneEquiv A (Fin r → A) (d (seqDual f) 1 (exteriorPower.ιMulti A 2 v))
      = pairRel f (v 0) (v 1) := by
  refine oneEquiv_eq_of_coe ?_
  rw [d_apply_coe, exteriorPower.ιMulti_apply_coe, ιMulti_two_apply,
    CliffordAlgebra.contractLeft_ι_mul, CliffordAlgebra.contractLeft_ι, pairRel, map_sub,
    map_smul, map_smul]
  congr 1
  rw [Algebra.smul_def, Algebra.commutes]

/-- **The image of the degree-two Koszul differential.**  Under the canonical identification
`⋀¹(Aʳ) ≃ Aʳ`, the image of `d₂ : ⋀²(Aʳ) → ⋀¹(Aʳ)` is the submodule spanned by the trivial
relations. -/
theorem map_range_d_one (f : Fin r → A) :
    Submodule.map (exteriorPower.oneEquiv A (Fin r → A) : (⋀[A]^1 (Fin r → A)) →ₗ[A] (Fin r → A))
        (LinearMap.range (d (seqDual f) 1)) = relSpan f := by
  set e := (exteriorPower.oneEquiv A (Fin r → A) :
    (⋀[A]^1 (Fin r → A)) →ₗ[A] (Fin r → A)) with he
  have htop : (⊤ : Submodule A (⋀[A]^(1 + 1) (Fin r → A)))
      = Submodule.span A (Set.range (exteriorPower.ιMulti A 2)) :=
    (exteriorPower.ιMulti_span A 2 (Fin r → A)).symm
  rw [← LinearMap.range_comp, LinearMap.range_eq_map, htop, Submodule.map_span, ← Set.range_comp]
  have hfun : (e.comp (d (seqDual f) 1) : (⋀[A]^(1 + 1) (Fin r → A)) → (Fin r → A))
      ∘ (exteriorPower.ιMulti A 2 : (Fin 2 → (Fin r → A)) → ⋀[A]^2 (Fin r → A))
      = fun v => pairRel f (v 0) (v 1) := by
    funext v
    exact oneEquiv_d_one_ιMulti f v
  rw [hfun]
  have hrange : (Set.range fun v : Fin 2 → (Fin r → A) => pairRel f (v 0) (v 1))
      = Set.range fun p : (Fin r → A) × (Fin r → A) => pairRel f p.1 p.2 := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      exact ⟨(v 0, v 1), rfl⟩
    · rintro ⟨p, rfl⟩
      exact ⟨![p.1, p.2], by simp⟩
  rw [hrange, ← relSpan_eq_span_range_pairRel]

/-! ### Vanishing of the first Koszul homology -/

/-- **The first Koszul homology in concrete terms.**  A sequence `f` is `H₁`-regular, i.e.
`H₁(K_•(f)) = 0`, exactly when every relation `∑ i, a i * f i = 0` is an `A`-linear
combination of the trivial relations `fᵢ eⱼ - fⱼ eᵢ`. -/
theorem isH1Regular_iff_ker_le_relSpan (f : Fin r → A) :
    IsH1Regular f ↔ LinearMap.ker (seqDual f) ≤ relSpan f := by
  rw [IsH1Regular, ← HomologicalComplex.exactAt_iff_isZero_homology,
    HomologicalComplex.exactAt_iff' _ 2 1 0 (by simp) (by simp),
    ShortComplex.moduleCat_exact_iff_ker_sub_range]
  change LinearMap.ker (d (seqDual f) 0) ≤ LinearMap.range (d (seqDual f) 1)
    ↔ LinearMap.ker (seqDual f) ≤ relSpan f
  rw [← map_ker_d_zero, ← map_range_d_one]
  exact (Submodule.map_le_map_iff_of_injective
    (f := (exteriorPower.oneEquiv A (Fin r → A) : (⋀[A]^1 (Fin r → A)) →ₗ[A] (Fin r → A)))
    (exteriorPower.oneEquiv A (Fin r → A)).injective _ _).symm

/-! ### Compatibility with other spellings of the trivial relations -/

/-- `trivRel f i j = fᵢ • eⱼ - fⱼ • eᵢ`, with `eₖ = Pi.single k 1`. -/
theorem trivRel_eq_smul_single (f : Fin r → A) (i j : Fin r) :
    trivRel f i j = f i • (Pi.single j 1 : Fin r → A) - f j • (Pi.single i 1 : Fin r → A) := by
  funext k
  simp [trivRel, Pi.single_apply, mul_ite]

/-- The coordinates of `trivRel f i j`, written with `if`. -/
theorem trivRel_apply (f : Fin r → A) (i j k : Fin r) :
    trivRel f i j k = (if k = j then f i else 0) - (if k = i then f j else 0) := by
  simp [trivRel, Pi.single_apply, eq_comm]

/-- The coordinates of `trivRel f i j`, written as multiples of `if k = j then 1 else 0`. -/
theorem trivRel_apply' (f : Fin r → A) (i j k : Fin r) :
    trivRel f i j k = f i * (if k = j then 1 else 0) - f j * (if k = i then 1 else 0) := by
  simp [trivRel_apply, mul_ite]

/-- Any family of relations that agrees with `trivRel f` spans `relSpan f`. -/
theorem span_range_eq_relSpan {g : Fin r → Fin r → (Fin r → A)} (f : Fin r → A)
    (h : ∀ i j, g i j = trivRel f i j) :
    Submodule.span A (Set.range fun p : Fin r × Fin r => g p.1 p.2) = relSpan f := by
  simp only [h, relSpan]

/-- `H₁`-regularity spelled out with an explicit relation. -/
theorem isH1Regular_iff_forall (f : Fin r → A) :
    IsH1Regular f ↔ ∀ a : Fin r → A, (∑ i, a i * f i = 0) → a ∈ relSpan f := by
  rw [isH1Regular_iff_ker_le_relSpan]
  simp only [IsConcreteLE.le_iff, LinearMap.mem_ker, seqDual_apply]

/-! ### The degree-one differential -/

/-- An element `a` of `A`, viewed in `⋀⁰ M` and then in the exterior algebra, is
`algebraMap A _ a`. -/
theorem coe_zeroEquiv_symm (a : A) :
    ((exteriorPower.zeroEquiv A M).symm a : ExteriorAlgebra A M)
      = algebraMap A (ExteriorAlgebra A M) a := by
  simp [exteriorPower.zeroEquiv_symm_apply, exteriorPower.ιMulti_apply_coe,
    ExteriorAlgebra.ιMulti, Algebra.algebraMap_eq_smul_one]

/-- If `y ∈ ⋀⁰ M` is `algebraMap A _ a` in the exterior algebra, then its image in `A` is `a`. -/
theorem zeroEquiv_eq_of_coe {y : ⋀[A]^0 M} {a : A}
    (hy : (y : ExteriorAlgebra A M) = algebraMap A (ExteriorAlgebra A M) a) :
    exteriorPower.zeroEquiv A M y = a := by
  have h : y = (exteriorPower.zeroEquiv A M).symm a :=
    Subtype.ext (by rw [hy, coe_zeroEquiv_symm])
  rw [h, LinearEquiv.apply_symm_apply]

/-- Under the identifications `⋀¹(Aʳ) ≃ Aʳ` and `⋀⁰(Aʳ) ≃ A`, the differential
`d₁ : ⋀¹(Aʳ) → ⋀⁰(Aʳ)` of the Koszul complex is the linear form `seqDual f`. -/
@[sga "6 VII 1.1" "special case"]
theorem zeroEquiv_d_zero (f : Fin r → A) (x : ⋀[A]^1 (Fin r → A)) :
    exteriorPower.zeroEquiv A (Fin r → A) (d (seqDual f) 0 x)
      = seqDual f (exteriorPower.oneEquiv A (Fin r → A) x) :=
  zeroEquiv_eq_of_coe (coe_d_zero f x)

/-- Under `⋀⁰(Aʳ) ≃ A`, the image of the degree-zero Koszul differential is the ideal
generated by `f`. -/
theorem range_d_zero {A : Type*} [CommRing A] {r : ℕ} (f : Fin r → A) :
    Submodule.map (exteriorPower.zeroEquiv A (Fin r → A) : (⋀[A]^0 (Fin r → A)) →ₗ[A] A)
        (LinearMap.range (Koszul.d (Koszul.seqDual f) 0)) =
      Ideal.span (Set.range f) := by
  change Submodule.map _ _ = Submodule.span A (Set.range f)
  rw [← Fintype.range_linearCombination A f]
  ext a
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨exteriorPower.oneEquiv A (Fin r → A) x, (Koszul.zeroEquiv_d_zero f x).symm⟩
  · rintro ⟨v, rfl⟩
    refine ⟨(exteriorPower.zeroEquiv A (Fin r → A)).symm (Koszul.seqDual f v),
      ⟨(exteriorPower.oneEquiv A (Fin r → A)).symm v, ?_⟩, ?_⟩
    · apply (exteriorPower.zeroEquiv A (Fin r → A)).injective
      rw [zeroEquiv_d_zero, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
    · exact (LinearEquiv.apply_symm_apply (exteriorPower.zeroEquiv A (Fin r → A)) _).trans rfl

/-! ### The first Koszul homology as an explicit quotient -/

/-- The degree-two Koszul differential followed by the identification `⋀¹(Aʳ) ≃ Aʳ`. -/
noncomputable def d2 (f : Fin r → A) : (⋀[A]^2 (Fin r → A)) →ₗ[A] (Fin r → A) :=
  (exteriorPower.oneEquiv A (Fin r → A) :
    (⋀[A]^1 (Fin r → A)) →ₗ[A] (Fin r → A)).comp (d (seqDual f) 1)

/-- The range of `d2 f` is `relSpan f`. -/
theorem range_d2 (f : Fin r → A) : LinearMap.range (d2 f) = relSpan f := by
  rw [d2, LinearMap.range_comp, map_range_d_one]

/-- `seqDual f ∘ d2 f = 0`: `concreteSc f` is a complex. -/
theorem seqDual_comp_d2 (f : Fin r → A) : (seqDual f).comp (d2 f) = 0 := by
  refine LinearMap.ext fun z => ?_
  have hz : d2 f z ∈ relSpan f := by
    rw [← range_d2]
    exact LinearMap.mem_range_self _ z
  exact relSpan_le_ker f hz

/-- The bottom `⋀²(Aʳ) → Aʳ → A` of the Koszul complex, with `⋀¹(Aʳ)` and `⋀⁰(Aʳ)` replaced
by `Aʳ` and `A`. -/
noncomputable def concreteSc (f : Fin r → A) : ShortComplex (ModuleCat A) :=
  ShortComplex.moduleCatMk (d2 f) (seqDual f) (seqDual_comp_d2 f)

/-- The bottom of the Koszul complex is isomorphic, as a short complex, to `concreteSc`. -/
noncomputable def scIso (f : Fin r → A) : (seqComplex f).sc' 2 1 0 ≅ concreteSc f :=
  ShortComplex.isoMk (Iso.refl _)
    (exteriorPower.oneEquiv A (Fin r → A)).toModuleIso
    (exteriorPower.zeroEquiv A (Fin r → A)).toModuleIso
    (by
      refine ModuleCat.hom_ext (LinearMap.ext fun z => ?_)
      change d2 f z = exteriorPower.oneEquiv A (Fin r → A) (d (seqDual f) 1 z)
      rfl)
    (by
      refine ModuleCat.hom_ext (LinearMap.ext fun z => ?_)
      change seqDual f (exteriorPower.oneEquiv A (Fin r → A) z)
        = exteriorPower.zeroEquiv A (Fin r → A) (d (seqDual f) 0 z)
      exact (zeroEquiv_d_zero f z).symm)

/-- Inside the module of relations, `relSpan f` is the image of `⋀²(Aʳ)`, i.e. the boundaries
of `concreteSc f`. -/
theorem comap_relSpan_eq_range_toCycles (f : Fin r → A) :
    Submodule.comap (LinearMap.ker (seqDual f)).subtype (relSpan f)
      = LinearMap.range (concreteSc f).moduleCatToCycles := by
  ext z
  simp only [Submodule.mem_comap]
  constructor
  · intro hz
    rw [← range_d2] at hz
    obtain ⟨w, hw⟩ := hz
    exact ⟨w, Subtype.ext hw⟩
  · rintro ⟨w, rfl⟩
    rw [← range_d2]
    exact ⟨w, rfl⟩

/-- **The first Koszul homology as an explicit quotient.**  `H₁(K_•(f))` is the module of
relations among `f` modulo the trivial relations. -/
noncomputable def h1ConcreteIso (f : Fin r → A) :
    ((LinearMap.ker (seqDual f)) ⧸ Submodule.comap (LinearMap.ker (seqDual f)).subtype (relSpan f))
      ≃ₗ[A] (seqComplex f).homology 1 :=
  (Submodule.quotEquivOfEq
      (Submodule.comap (LinearMap.ker (seqDual f)).subtype (relSpan f))
      (LinearMap.range (concreteSc f).moduleCatToCycles)
      (comap_relSpan_eq_range_toCycles f)).trans
    ((concreteSc f).moduleCatHomologyIso.toLinearEquiv.symm.trans
      (ShortComplex.homologyMapIso
        (((seqComplex f).isoSc' 2 1 0 (by simp) (by simp)).trans
          (scIso f))).toLinearEquiv.symm)

/-- The augmentation `K_•(f₁, …, f_r) ⟶ (A / (f₁, …, f_r))[0]`, given in degree `0` by the
quotient map `⋀⁰(Aʳ) ≃ A ↠ A / (f₁, …, f_r)`. -/
noncomputable def koszulAugmentation
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    Koszul.seqComplex f ⟶
      (ChainComplex.single₀ (ModuleCat.{u} A)).obj
        (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))) :=
  (ChainComplex.toSingle₀Equiv _ _).symm
    ⟨ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
      (exteriorPower.zeroEquiv A (Fin r → A)).toLinearMap), by
      apply ModuleCat.hom_ext
      ext x
      change (⋀[A]^1 (Fin r → A)) at x
      change (Ideal.span (Set.range f)).mkQ
        (exteriorPower.zeroEquiv A (Fin r → A) (Koszul.d (Koszul.seqDual f) 0 x)) = 0
      rw [Koszul.zeroEquiv_d_zero, Koszul.seqDual_apply]
      exact (Ideal.Quotient.eq_zero_iff_mem).2
        (Submodule.sum_mem _ fun i _ ↦
          Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))⟩

end Koszul

end
