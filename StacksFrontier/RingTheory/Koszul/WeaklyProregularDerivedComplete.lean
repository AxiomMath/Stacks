module

public import StacksFrontier.RingTheory.Koszul.KoszulQCDerivedComplete
public import StacksFrontier.RingTheory.Koszul.WeaklyProregularQuasiCoherentChain

/-!
# Quasi-coherent towers and derived complete objects for a weakly proregular ideal

Let `R` be a ring and let `I ⊆ R` be an ideal generated by a weakly proregular sequence
`f₁, …, f_r` (Stacks 0H1E): for every `n` there is `m > n` such that the transition map
`K_m → K_n` of Koszul complexes on the powers `f₁ ^ n, …, f_r ^ n` is zero on cohomology outside
degree `0`. Remark 0H1E observes that the proof of Proposition 0GZK goes through: the category
`QC({R / I ^ n})` of quasi-coherent objects of the derived category of the sheaf of algebras
`(R / I ^ n)` on `ℕ` with the chaotic topology is equivalent, as an `R`-linear triangulated
category, to the category `D_comp(R, I)` of derived complete objects of `D(R)`.

The equivalence is the composite of `Koszul.idealPowKoszulQCEquivalence`,
`QC(R / I ^ n) ≃ QC(K_n)` (steps (1)–(3) of the proof of 0GZK, where weak proregularity replaces
the Noetherian hypothesis through Tags 0GZ4 and 0GZ5), with the inverse of
`Koszul.derivedCompleteQCLinearTriangulatedEquivalence`, `D_comp(R, I) ≃ QC(K_n)` (the remainder
of the proof, valid for any finite sequence). Proposition 0GZK is the case of a Noetherian ring,
where every finite sequence is weakly proregular (`Koszul.isWeaklyProregular_of_isNoetherianRing`).

The site `ℕ` is taken as `Stacks.LiftedNat.{u}`, the natural numbers in the universe of `R`.

## Main definitions

* `Koszul.qcIdealPowDerivedCompleteEquivalence`: the equivalence for a given weakly proregular
  sequence of generators.

## Main results

* `Koszul.nonempty_qcIdealPow_qcKoszul_derivedComplete_equivalences`: **Remark 0H1E**, the three
  categories `QC(𝒜)`, `QC(ℬ)` and `D_comp(R, I)` are equivalent as `R`-linear triangulated
  categories.
* `Koszul.nonempty_qcIdealPow_linearTriangulatedEquivalence_derivedComplete`: in particular
  `QC({R / I ^ n}) ≃ D_comp(R, I)`.

## References

* [Stacks Project, Remark 24.35.5 (Tag 0H1E)](https://stacks.math.columbia.edu/tag/0H1E)
* [Stacks Project, Proposition 24.35.4 (Tag 0GZK)](https://stacks.math.columbia.edu/tag/0GZK)
-/

@[expose] public noncomputable section

open CategoryTheory SheafOfModules.DifferentialGradedModule

universe u

attribute [local instance 2000] HasDerivedCategory.standard

namespace Koszul

variable {R : Type u} [CommRing R]

/-- The derived complete objects of `D(R)` form a triangulated subcategory (Tag 091U). -/
instance isDerivedComplete_isTriangulated' (I : Ideal R) :
    ObjectProperty.IsTriangulated
      (fun K : DerivedCategory (ModuleCat.{u} R) => IsDerivedComplete I K) :=
  CompletionAdjunction.isDerivedComplete_isTriangulated R I

/-- **`QC({R / I ^ n}) ≃ D_comp(R, I)` as `R`-linear triangulated categories, for `I` generated by
a weakly proregular sequence `f`.** -/
def qcIdealPowDerivedCompleteEquivalence {r : ℕ} (f : Fin r → R)
    (proregular : IsWeaklyProregular f) :
    LinearTriangulatedEquivalence R
      (Chaotic.QC (liftedIdealPowSheafAlgebra.{u} (Ideal.span (Set.range f)))).FullSubcategory
      (derivedComplete f).FullSubcategory :=
  (idealPowKoszulQCEquivalence f proregular).trans
    (derivedCompleteQCLinearTriangulatedEquivalence f).symm

/-- **Stacks 0H1E.** Let `R` be a ring and let `f₁, …, f_r` be a weakly proregular sequence
generating the ideal `I`. Then the arguments of the proof of Proposition 0GZK continue to work:
the three categories `QC({R / I ^ n})` (the sheaf of algebras `𝒜 = (R / I ^ n)` on `ℕ` with the
chaotic topology), `QC(ℬ)` (the sheaf `ℬ` of Koszul algebras on `f₁ ^ n, …, f_r ^ n`) and the
category `D_comp(R, I)` of derived complete objects of `D(R)` are equivalent, as `R`-linear
triangulated categories: `QC(𝒜) ≃ QC(ℬ)` and `QC(ℬ) ≃ D_comp(R, I)`, and hence
`QC(𝒜) ≃ D_comp(R, I)`. -/
@[stacks 0H1E]
theorem nonempty_qcIdealPow_qcKoszul_derivedComplete_equivalences (I : Ideal R) {r : ℕ}
    (f : Fin r → R) (proregular : IsWeaklyProregular f)
    (generators : Ideal.span (Set.range f) = I) :
    Nonempty (LinearTriangulatedEquivalence R
        (Chaotic.QC (liftedIdealPowSheafAlgebra.{u} I)).FullSubcategory
        (Chaotic.QC (liftedPowSheafAlgebra.{u} f)).FullSubcategory) ∧
      Nonempty (LinearTriangulatedEquivalence R
        (Chaotic.QC (liftedPowSheafAlgebra.{u} f)).FullSubcategory
        (ObjectProperty.FullSubcategory
          (fun K : DerivedCategory (ModuleCat.{u} R) => IsDerivedComplete I K))) ∧
      Nonempty (LinearTriangulatedEquivalence R
        (Chaotic.QC (liftedIdealPowSheafAlgebra.{u} I)).FullSubcategory
        (ObjectProperty.FullSubcategory
          (fun K : DerivedCategory (ModuleCat.{u} R) => IsDerivedComplete I K))) := by
  subst generators
  exact ⟨⟨idealPowKoszulQCEquivalence f proregular⟩,
    ⟨(derivedCompleteQCLinearTriangulatedEquivalence f).symm⟩,
    ⟨qcIdealPowDerivedCompleteEquivalence f proregular⟩⟩

/-- `QC({R / I ^ n}) ≃ D_comp(R, I)` as `R`-linear triangulated categories, for an ideal `I` which
can be generated by a weakly proregular sequence. -/
theorem nonempty_qcIdealPow_linearTriangulatedEquivalence_derivedComplete (I : Ideal R)
    (generated : ∃ (r : ℕ) (f : Fin r → R), IsWeaklyProregular f ∧
      Ideal.span (Set.range f) = I) :
    Nonempty (LinearTriangulatedEquivalence R
      (Chaotic.QC (liftedIdealPowSheafAlgebra.{u} I)).FullSubcategory
      (ObjectProperty.FullSubcategory
        (fun K : DerivedCategory (ModuleCat.{u} R) => IsDerivedComplete I K))) := by
  obtain ⟨r, f, proregular, generators⟩ := generated
  exact (nonempty_qcIdealPow_qcKoszul_derivedComplete_equivalences I f proregular generators).2.2

end Koszul
