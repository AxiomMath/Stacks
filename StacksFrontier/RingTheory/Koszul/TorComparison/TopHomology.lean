module

public import StacksFrontier.RingTheory.Koszul.TorComparison.Determinant
public import StacksFrontier.RingTheory.Koszul.Defs
public import Mathlib.RingTheory.Ideal.Operations

/-!
# The top of the Koszul complex of a sequence of its own length

Let `R` be a commutative ring and let `f₁, …, f_n ∈ R`. The Koszul complex `K_•(f₁, …, f_n)`
lives in degrees `0, …, n`, and its top term `⋀ⁿ(Rⁿ)` is free of rank one, generated by
`e₁ ∧ ⋯ ∧ eₙ`. The differential out of the top degree kills `c · (e₁ ∧ ⋯ ∧ eₙ)` exactly when
`c` annihilates every `fᵢ`, so

`ker(d : Kₙ(f) → K_{n-1}(f)) ≅ Ann(f₁, …, f_n)`.

Since `K_{n+1}(f) = ⋀ⁿ⁺¹(Rⁿ) = 0`, that kernel is the top Koszul homology. This is the
computation that closes the proof of Tate's lemma ([Stacks, Tag 0BWC]): there the top homology
of the Koszul complex of a sequence generating `Ker(B ⊗_A B → B)` is identified with the
annihilator of that kernel.

The two algebraic facts behind it are of independent interest and are stated for an arbitrary
module `E` and functional `φ`:

* if `c` kills `φ(v i)` for every `i`, then `c` kills the contraction of `v₁ ∧ ⋯ ∧ v_k`
  (`Koszul.smul_contraction_ιMulti_eq_zero`, by induction on `k` through the antiderivation
  identity);
* on the *top* exterior power, contraction is adjoint to multiplication in the sharpest
  possible sense: `y ∧ (φ ⌟ x) = φ(y) · x` (`Koszul.ι_mul_contraction_of_mem_top`), because
  `y ∧ x` lies in a vanishing exterior power.

## Main definitions

* `Koszul.topEquiv`: the rank-one identification `⋀ⁿ(Rⁿ) ≃ₗ[R] R` sending `e₁ ∧ ⋯ ∧ eₙ` to `1`.

## Main results

* `Koszul.smul_contraction_ιMulti_eq_zero`, `Koszul.ι_mul_contraction_of_mem_top`: the two
  contraction identities.
* `Koszul.d_top_eq_zero_iff`: `d x = 0` for `x` in the top degree iff `Koszul.topEquiv x`
  annihilates the ideal `(f₁, …, f_n)`.
* `Koszul.kerDTopEquivAnnihilator`: the resulting identification of the kernel of the top
  differential with the annihilator of `(f₁, …, f_n)`.

## References

* [Stacks Project, Tag 0623](https://stacks.math.columbia.edu/tag/0623)
* [Stacks Project, Tag 0BWC](https://stacks.math.columbia.edu/tag/0BWC)
-/

@[expose] public noncomputable section

open scoped ExteriorAlgebra

universe u v

namespace Koszul

/-! ### Two contraction identities -/

section Contraction

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]

/-- If the scalar `c` annihilates `φ (v i)` for every `i`, then it annihilates the contraction
of the wedge `v₁ ∧ ⋯ ∧ v_k`. -/
theorem smul_contraction_ιMulti_eq_zero (φ : Module.Dual R E) (c : R) :
    ∀ (k : ℕ) (v : Fin k → E), (∀ i, c * φ (v i) = 0) →
      c • Koszul.contraction φ (ExteriorAlgebra.ιMulti R k v) = 0 := by
  intro k
  induction k with
  | zero =>
    intro v _
    rw [show ExteriorAlgebra.ιMulti R 0 v = 1 by simp [ExteriorAlgebra.ιMulti],
      Koszul.contraction, CliffordAlgebra.contractLeft_one, smul_zero]
  | succ m ih =>
    intro v hv
    have := ih (Fin.tail v) fun i => hv i.succ
    rw [Koszul.contraction] at this
    rw [Koszul.ιMulti_succ_apply, Koszul.contraction, CliffordAlgebra.contractLeft_ι_mul,
      smul_sub, smul_smul, hv 0, zero_smul, ← mul_smul_comm, this, mul_zero, sub_zero]

/-- **Contraction on the top exterior power is adjoint to multiplication.** If
`x ∈ ⋀ⁿ(Rⁿ)` — the top exterior power, so that `⋀ⁿ⁺¹(Rⁿ) = 0` — then for every `y` we have
`y ∧ (φ ⌟ x) = φ(y) · x`. -/
theorem ι_mul_contraction_of_mem_top {R : Type u} [CommRing R] {n : ℕ}
    (φ : Module.Dual R (Fin n → R)) (y : Fin n → R)
    {x : ExteriorAlgebra R (Fin n → R)} (hx : x ∈ ⋀[R]^n (Fin n → R)) :
    ExteriorAlgebra.ι R y * Koszul.contraction φ x = φ y • x := by
  have hzero : ExteriorAlgebra.ι R y * x = 0 := by
    have hsub : Subsingleton (⋀[R]^(n + 1) (Fin n → R)) :=
      exteriorPower.subsingleton_of_span_eq_top_of_card_lt
        (Pi.basisFun R (Fin n)) (Pi.basisFun R (Fin n)).span_eq (n + 1) (by simp)
    have := ExteriorAlgebra.gradedAlgebra R (Fin n → R)
    have hmem : ExteriorAlgebra.ι R y * x ∈ ⋀[R]^(1 + n) (Fin n → R) :=
      SetLike.mul_mem_graded (Koszul.ι_mem_one y) hx
    rw [Nat.add_comm 1 n] at hmem
    have : (⟨ExteriorAlgebra.ι R y * x, hmem⟩ : ⋀[R]^(n + 1) (Fin n → R)) = 0 :=
      Subsingleton.elim _ _
    exact congrArg Subtype.val this
  have hc := CliffordAlgebra.contractLeft_ι_mul φ y x
  rw [hzero, map_zero] at hc
  rw [eq_comm, ← sub_eq_zero, ← hc]

end Contraction

/-! ### The top exterior power of `Rⁿ` and the annihilator -/

section Top

variable {R : Type u} [CommRing R] {n : ℕ}

/-- The standard generator `e₁ ∧ ⋯ ∧ eₙ` of the top exterior power `⋀ⁿ(Rⁿ)`. -/
def topGen (R : Type u) [CommRing R] (n : ℕ) : ⋀[R]^n (Fin n → R) :=
  exteriorPower.ιMulti R n (Pi.basisFun R (Fin n))

/-- The chosen element of the one-element index type of the basis of `⋀ⁿ(Rⁿ)`. -/
def topIndex (n : ℕ) : Set.powersetCard (Fin n) n := ⟨Finset.univ, by simp⟩

/-- The coordinate of `e₁ ∧ ⋯ ∧ eₙ` in the basis of `⋀ⁿ(Rⁿ)` induced by the standard basis
of `Rⁿ` is `1`. -/
theorem ιMultiDual_topGen :
    exteriorPower.ιMultiDual R n (Pi.basisFun R (Fin n)) (topIndex n) (topGen R n) = 1 := by
  rw [topGen, exteriorPower.ιMultiDual_top_ιMulti, Module.Basis.det_self]

/-- **The top exterior power of `Rⁿ` is free of rank one.** The identification
`⋀ⁿ(Rⁿ) ≃ₗ[R] R` sends `e₁ ∧ ⋯ ∧ eₙ` to `1`; it is the single coordinate of the basis
`Module.Basis.exteriorPower`. -/
def topEquiv (R : Type u) [CommRing R] (n : ℕ) : (⋀[R]^n (Fin n → R)) ≃ₗ[R] R :=
  LinearEquiv.ofBijective
    (exteriorPower.ιMultiDual R n (Pi.basisFun R (Fin n)) (topIndex n))
    ⟨exteriorPower.ιMultiDual_top_injective (Pi.basisFun R (Fin n)) (topIndex n),
      fun c => ⟨c • topGen R n, by rw [map_smul, ιMultiDual_topGen, smul_eq_mul, mul_one]⟩⟩

/-- `Koszul.topEquiv` sends `e₁ ∧ ⋯ ∧ eₙ` to `1`. -/
@[simp] theorem topEquiv_topGen : topEquiv R n (topGen R n) = 1 :=
  ιMultiDual_topGen

/-- Every element `x` of `⋀ⁿ(Rⁿ)` equals `topEquiv R n x • (e₁ ∧ ⋯ ∧ eₙ)`. -/
theorem eq_smul_topGen (x : ⋀[R]^n (Fin n → R)) : x = topEquiv R n x • topGen R n := by
  apply (topEquiv R n).injective
  rw [map_smul, topEquiv_topGen, smul_eq_mul, mul_one]

/-- An element annihilates the ideal generated by `f₁, …, f_n` exactly when it annihilates each
generator. -/
theorem mem_annihilator_span_range_iff (f : Fin n → R) (c : R) :
    c ∈ (Ideal.span (Set.range f)).annihilator ↔ ∀ i, c * f i = 0 := by
  rw [Submodule.mem_annihilator]
  refine ⟨fun h i => by simpa using h (f i) (Ideal.subset_span ⟨i, rfl⟩), fun h y hy => ?_⟩
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨i, rfl⟩ := hz
    simpa [smul_eq_mul] using h i
  | zero => simp
  | add a b _ _ ha hb => rw [smul_add, ha, hb, add_zero]
  | smul t a _ ha => rw [smul_comm, ha, smul_zero]

end Top

/-! ### The kernel of the top differential -/

section KerTop

variable {R : Type u} [CommRing R] {m : ℕ}

/-- **The top Koszul differential kills exactly the annihilator.** For a sequence of length
`m + 1`, an element `x` of the top term `⋀^(m+1)(R^(m+1))` of the Koszul complex is a cycle
exactly when the scalar `Koszul.topEquiv x` annihilates the ideal `(f₁, …, f_{m+1})`. -/
theorem d_top_eq_zero_iff (f : Fin (m + 1) → R) (x : ⋀[R]^(m + 1) (Fin (m + 1) → R)) :
    Koszul.d (Koszul.seqDual f) m x = 0 ↔
      topEquiv R (m + 1) x ∈ (Ideal.span (Set.range f)).annihilator := by
  rw [mem_annihilator_span_range_iff]
  constructor
  · intro hd i
    have hcoe : Koszul.contraction (Koszul.seqDual f) (x : ExteriorAlgebra R (Fin (m + 1) → R))
        = 0 := by
      rw [← Koszul.d_apply_coe (Koszul.seqDual f) m x, hd, Submodule.coe_zero]
    have hid := ι_mul_contraction_of_mem_top (Koszul.seqDual f) (Pi.single i (1 : R)) x.2
    rw [hcoe, mul_zero, Koszul.seqDual_single] at hid
    have hx : f i • x = 0 := Subtype.ext (by rw [Submodule.coe_smul, ← hid, Submodule.coe_zero])
    have := congrArg (topEquiv R (m + 1)) hx
    rwa [map_smul, map_zero, smul_eq_mul, mul_comm] at this
  · intro h
    apply Subtype.ext
    rw [Koszul.d_apply_coe, Submodule.coe_zero]
    have hxc : (x : ExteriorAlgebra R (Fin (m + 1) → R))
        = topEquiv R (m + 1) x • (topGen R (m + 1) : ExteriorAlgebra R (Fin (m + 1) → R)) := by
      rw [← Submodule.coe_smul, ← eq_smul_topGen]
    rw [hxc, map_smul]
    refine smul_contraction_ιMulti_eq_zero (Koszul.seqDual f) _ (m + 1)
      (Pi.basisFun R (Fin (m + 1))) fun i => ?_
    rw [Pi.basisFun_apply, Koszul.seqDual_single]
    exact h i

/-- **The kernel of the top Koszul differential is the annihilator of the ideal.** For a
sequence `f₁, …, f_{m+1}` of length `m + 1` in `R`, the identification `⋀^(m+1)(R^(m+1)) ≃ R`
carries the kernel of the differential out of the top degree of `K_•(f)` onto
`Ann(f₁, …, f_{m+1})`. -/
def kerDTopEquivAnnihilator (f : Fin (m + 1) → R) :
    (LinearMap.ker (Koszul.d (Koszul.seqDual f) m)) ≃ₗ[R]
      (Ideal.span (Set.range f)).annihilator :=
  (topEquiv R (m + 1)).submoduleMap (LinearMap.ker (Koszul.d (Koszul.seqDual f) m)) ≪≫ₗ
    LinearEquiv.ofEq _ _ (by
      ext c
      simp only [Submodule.mem_map, LinearMap.mem_ker]
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact (d_top_eq_zero_iff f x).1 hx
      · intro hc
        exact ⟨(topEquiv R (m + 1)).symm c,
          (d_top_eq_zero_iff f _).2 (by rwa [(topEquiv R (m + 1)).apply_symm_apply]),
          (topEquiv R (m + 1)).apply_symm_apply c⟩)

/-! ### The top Koszul homology -/

/-- The Koszul complex of a sequence of length `m + 1` vanishes in degree `m + 2`. -/
theorem isZero_seqComplex_X_succ (f : Fin (m + 1) → R) :
    CategoryTheory.Limits.IsZero ((Koszul.seqComplex f).X (m + 2)) := by
  change CategoryTheory.Limits.IsZero (ModuleCat.of R (⋀[R]^(m + 2) (Fin (m + 1) → R)))
  exact ModuleCat.isZero_iff_subsingleton.mpr
    (exteriorPower.subsingleton_of_span_eq_top_of_card_lt
      (Pi.basisFun R (Fin (m + 1))) (Pi.basisFun R (Fin (m + 1))).span_eq (m + 2) (by simp))

/-- The differential of the Koszul complex of a sequence of length `m + 1` from degree `m + 2`
to degree `m + 1` is zero. -/
theorem seqComplex_d_succ_eq_zero (f : Fin (m + 1) → R) :
    (Koszul.seqComplex f).d (m + 2) (m + 1) = 0 :=
  (isZero_seqComplex_X_succ f).eq_of_src _ _

/-- The outgoing map of the short complex computing `H_{m+1}` is the top Koszul
differential. -/
theorem sc'_g_hom (f : Fin (m + 1) → R) :
    (((Koszul.seqComplex f).sc' (m + 2) (m + 1) m).g).hom =
      Koszul.d (Koszul.seqDual f) m :=
  congrArg
    (fun t : (Koszul.seqComplex f).X (m + 1) ⟶ (Koszul.seqComplex f).X m => t.hom)
    (Koszul.seqComplex_d f m)

/-- The kernel of the outgoing map of that short complex is the kernel of the top Koszul
differential. -/
def kerSc'EquivKerD (f : Fin (m + 1) → R) :
    (LinearMap.ker (((Koszul.seqComplex f).sc' (m + 2) (m + 1) m).g).hom) ≃ₗ[R]
      (LinearMap.ker (Koszul.d (Koszul.seqDual f) m)) :=
  LinearEquiv.ofEq _ _ (by rw [sc'_g_hom]; rfl)

/-- **The top Koszul homology of a sequence of its own length is the annihilator of the ideal
it generates.** For `f₁, …, f_{m+1} ∈ R`,

`H_{m+1}(K_•(f₁, …, f_{m+1})) ≅ Ann(f₁, …, f_{m+1})`. -/
def homologyTopIsoAnnihilator (f : Fin (m + 1) → R) :
    (Koszul.seqComplex f).homology (m + 1) ≅
      ModuleCat.of R ((Ideal.span (Set.range f)).annihilator) :=
  ((Koszul.seqComplex f).isoHomologyπ (m + 2) (m + 1)
      (ChainComplex.prev ℕ (m + 1)) (seqComplex_d_succ_eq_zero f)).symm ≪≫
    (Koszul.seqComplex f).cyclesIsoSc' (m + 2) (m + 1) m
      (ChainComplex.prev ℕ (m + 1)) (ChainComplex.next_nat_succ m) ≪≫
    ((Koszul.seqComplex f).sc' (m + 2) (m + 1) m).moduleCatCyclesIso ≪≫
    ((kerSc'EquivKerD f).trans (kerDTopEquivAnnihilator f)).toModuleIso

end KerTop

end Koszul

end
