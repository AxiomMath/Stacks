module

public import StacksFrontier.RingTheory.Koszul.TorComparison.QuotientTor
public import StacksFrontier.RingTheory.RegularLocalRing.KoszulResidueFieldModel
public import Mathlib.CategoryTheory.Abelian.Projective.Ext
public import Mathlib.LinearAlgebra.ExteriorPower.Basis

/-!
# The self-`Ext` of a Koszul-regular quotient is generated in degree one

Let `R` be a commutative ring and `f₁, …, f_r` a Koszul-regular sequence in `R`, generating the
ideal `J`. Then for every `n` the Yoneda composition

`Ext¹_R(R/J, R/J) × Extⁿ_R(R/J, R/J) ⟶ Ext^{n+1}_R(R/J, R/J)`

has image generating `Ext^{n+1}_R(R/J, R/J)` as an abelian group. In particular, for a regular
local ring `R` with residue field `κ`, the algebra `Ext^*_R(κ, κ)` is generated by `Ext¹_R(κ, κ)`.
This is the local content of [Stacks, Tag 0BQY].

## Main results

* `CategoryTheory.ProjectiveResolution.extEquivCohomologyClass_symm_comp`: Yoneda composition of
  classes computed by a projective resolution is composition of cocycles.
* `Koszul.closure_range_ext_comp_eq_top`: the generation statement for a Koszul-regular sequence.
* `IsRegularLocalRing.closure_range_ext_comp_residueField_eq_top`: the regular local case.

## References

* [Stacks Project, Tag 0BQY](https://stacks.math.columbia.edu/tag/0BQY)
* [Stacks Project, Tag 0G26](https://stacks.math.columbia.edu/tag/0G26)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CochainComplex HomComplex
open scoped ExteriorAlgebra

universe u v

/-! ### Composition of cocycles and Yoneda composition -/

namespace CochainComplex.HomComplex.Cocycle

variable {C : Type*} [Category* C] [Preadditive C]

/-- The composition of two cocycles of the Hom complexes, a cocycle of the composite degree. -/
def compCocycle {K L M : CochainComplex C ℤ} {a b c : ℤ} (x : Cocycle K L a) (y : Cocycle L M b)
    (h : a + b = c) : Cocycle K M c :=
  Cocycle.mk (x.1.comp y.1 h) (c + 1) rfl (by
    rw [δ_comp x.1 y.1 h (a + 1) (b + 1) (c + 1) rfl rfl rfl]
    simp)

/-- The underlying cochain of `compCocycle x y h` is the composite of the underlying cochains. -/
@[simp]
theorem compCocycle_coe {K L M : CochainComplex C ℤ} {a b c : ℤ} (x : Cocycle K L a)
    (y : Cocycle L M b) (h : a + b = c) : (compCocycle x y h : Cochain K M c) = x.1.comp y.1 h :=
  rfl

/-- Under `Cocycle.equivHomShift`, composition of cocycles is composition of shifted
morphisms. -/
theorem equivHomShift_symm_compCocycle {K L M : CochainComplex C ℤ} {a b c : ℤ}
    (x : Cocycle K L a) (y : Cocycle L M b) (h : a + b = c) :
    equivHomShift.symm (compCocycle x y h) =
      ShiftedHom.comp (equivHomShift.symm x) (equivHomShift.symm y) (by omega : b + a = c) := by
  subst c
  ext p
  simp [equivHomShift_symm_apply, Cocycle.homOf, Cocycle.rightShift, Cochain.rightShift,
    Cochain.comp, ShiftedHom.comp, compCocycle, CochainComplex.shiftFunctorAdd'_inv_app_f',
    Cochain.v_comp_XIsoOfEq_hom]

end CochainComplex.HomComplex.Cocycle

namespace CategoryTheory.ProjectiveResolution

variable {C : Type*} [Category* C] [Abelian C] [HasExt C]

/-- **Yoneda composition of classes computed by a projective resolution is composition of
cocycles**: for a projective resolution `P` of `M`, a degree-`a` cocycle `x` of the endomorphism
complex of `P` and a degree-`b` cocycle `y` from `P` to `N`, the composite of the class of
`x` followed by the augmentation with the class of `y` is the class of `x ∘ y`. -/
theorem extEquivCohomologyClass_symm_comp {M N : C} (P : ProjectiveResolution M) (a b : ℕ) {c : ℕ}
    (hab : a + b = c) (x : Cocycle P.cochainComplex P.cochainComplex (a : ℤ))
    (y : Cocycle P.cochainComplex ((singleFunctor C 0).obj N) (b : ℤ)) :
    (P.extEquivCohomologyClass.symm (.mk (x.postcomp P.π'))).comp
      (P.extEquivCohomologyClass.symm (.mk y)) hab =
    P.extEquivCohomologyClass.symm (.mk (Cocycle.compCocycle x y
      (by omega : (a : ℤ) + b = (c : ℤ)))) := by
  subst c
  let := HasDerivedCategory.standard C
  apply Abelian.Ext.homEquiv.injective
  simp only [Abelian.Ext.comp_hom, ProjectiveResolution.extEquivCohomologyClass_symm_mk_hom,
    Cocycle.equivHomShift_symm_compCocycle, Cocycle.equivHomShift_symm_postcomp]
  simp only [DerivedCategory.singleFunctorIsoCompQ, Iso.refl_hom, Iso.refl_inv,
    NatTrans.id_app, Category.id_comp]
  rw [ShiftedHom.comp_mk₀_id (C := DerivedCategory C)
    (Y := (DerivedCategory.singleFunctor C 0).obj M) (a := (a : ℤ)) _ (0 : ℤ) rfl]
  rw [ShiftedHom.comp_mk₀_id (C := DerivedCategory C)
    (Y := (DerivedCategory.singleFunctor C 0).obj N) (a := (b : ℤ)) _ (0 : ℤ) rfl]
  rw [ShiftedHom.comp_mk₀_id (C := DerivedCategory C)
    (Y := (DerivedCategory.singleFunctor C 0).obj N) (a := ((a + b : ℕ) : ℤ)) _ (0 : ℤ) rfl]
  rw [← ShiftedHom.comp_mk₀ (C := CochainComplex C ℤ)
    (Cocycle.equivHomShift.symm x) (0 : ℤ) rfl P.π',
    ShiftedHom.map_comp, ShiftedHom.map_mk₀, ShiftedHom.map_comp]
  let q := DerivedCategory.Q.map P.π'
  let dx : ShiftedHom (DerivedCategory.Q.obj P.cochainComplex)
      (DerivedCategory.Q.obj P.cochainComplex) (a : ℤ) :=
    ShiftedHom.map (Cocycle.equivHomShift.symm x) DerivedCategory.Q
  let dy : ShiftedHom (DerivedCategory.Q.obj P.cochainComplex)
      (DerivedCategory.Q.obj ((singleFunctor C 0).obj N)) (b : ℤ) :=
    ShiftedHom.map (Cocycle.equivHomShift.symm y) DerivedCategory.Q
  change ((ShiftedHom.mk₀ (0 : ℤ) rfl (inv q)).comp
      (dx.comp (ShiftedHom.mk₀ 0 rfl q) (zero_add _)) (add_zero _)).comp
      ((ShiftedHom.mk₀ 0 rfl (inv q)).comp dy (add_zero _)) (by omega) =
    (ShiftedHom.mk₀ 0 rfl (inv q)).comp
      (dx.comp dy (show (b : ℤ) + a = ((a + b : ℕ) : ℤ) by omega)) (add_zero _)
  rw [ShiftedHom.comp_assoc _ _ _ (add_zero _)
      (show (b : ℤ) + a = ((a + b : ℕ) : ℤ) by omega) (by omega),
    ShiftedHom.comp_assoc dx _ _ (zero_add _) (add_zero _) (by omega),
    ShiftedHom.mk₀_comp_mk₀_assoc]
  simp only [IsIso.hom_inv_id, ShiftedHom.mk₀_id_comp]

/-- The degree-one cochain of the endomorphism complex of a projective resolution given by a
family of degree-lowering maps `c n : P_{n+1} ⟶ P_n`. -/
def degreeOneCochain {M : C} (P : ProjectiveResolution M)
    (c : ∀ n, P.complex.X (n + 1) ⟶ P.complex.X n) :
    Cochain P.cochainComplex P.cochainComplex 1 :=
  Cochain.mk fun p q hpq => if hq : q ≤ 0 then
    (P.cochainComplexXIso p ((-q).toNat + 1) (by omega)).hom ≫ c (-q).toNat ≫
      (P.cochainComplexXIso q (-q).toNat (by omega)).inv else 0

omit [HasExt C] in
/-- The component `P_{n+1} ⟶ P_n` of `degreeOneCochain c` in degree `-(n+1)` is `c n`, up to the
identifications of the terms of `P.cochainComplex` with those of `P.complex`. -/
theorem degreeOneCochain_v {M : C} (P : ProjectiveResolution M)
    (c : ∀ n, P.complex.X (n + 1) ⟶ P.complex.X n)
    (p q : ℤ) (hpq : p + 1 = q) (n : ℕ) (hq : -(n : ℤ) = q) :
    (P.degreeOneCochain c).v p q hpq =
      (P.cochainComplexXIso p (n + 1) (by omega)).hom ≫ c n ≫
        (P.cochainComplexXIso q n hq).inv := by
  have hq0 : q ≤ 0 := by omega
  have hn : (-q).toNat = n := by omega
  subst n
  dsimp only [degreeOneCochain, Cochain.mk, Cochain.v]
  rw [dite_eq_left hq0]

/-- A family of degree-lowering maps `c n : P_{n+1} ⟶ P_n` anticommuting with the differential
is a degree-one cocycle of the endomorphism complex of the projective resolution `P`. -/
def degreeOneCocycle {M : C} (P : ProjectiveResolution M)
    (c : ∀ n, P.complex.X (n + 1) ⟶ P.complex.X n)
    (hc : ∀ n, c (n + 1) ≫ P.complex.d (n + 1) n + P.complex.d (n + 2) (n + 1) ≫ c n = 0) :
    Cocycle P.cochainComplex P.cochainComplex 1 :=
  Cocycle.mk (P.degreeOneCochain c) 2 rfl (by
    ext p q hpq
    by_cases hq : q ≤ 0
    · obtain ⟨n, rfl⟩ := Int.exists_eq_neg_ofNat hq
      have hp : p = -((n + 2 : ℕ) : ℤ) := by omega
      subst p
      rw [δ_v 1 2 rfl _ _ _ hpq (-(n + 1)) (-(n + 1)) (by omega) (by omega)]
      rw [P.degreeOneCochain_v c _ _ _ (n + 1) (by omega),
        P.degreeOneCochain_v c _ _ _ n rfl,
        P.cochainComplex_d (-(n + 1)) (-n) (n + 1) n (by omega) rfl,
        P.cochainComplex_d (-((n + 2 : ℕ) : ℤ)) (-(n + 1)) (n + 2) (n + 1) rfl (by omega)]
      simp only [Category.assoc, Iso.inv_hom_id_assoc, Cochain.zero_v]
      simp only [show (2 : ℤ).negOnePow = 1 by decide, one_smul]
      rw [← Preadditive.comp_add, ← Category.assoc, ← Category.assoc,
        ← Preadditive.add_comp, hc, zero_comp, comp_zero]
    · exact (P.cochainComplex.isZero_of_isStrictlyLE 0 q (by omega)).eq_of_tgt _ _)

/-- **Composing with a degree-one class given by degree-lowering maps.** If `c` is a family of
maps `P_{m+1} ⟶ P_m` anticommuting with the differential of the projective resolution `P`, the
composite of its class with the class `extMk g` of a cocycle `g : P_n ⟶ N` is the class of
`c n ≫ g`. -/
theorem degreeOneCocycle_comp_extMk {M N : C} (P : ProjectiveResolution M)
    (c : ∀ n, P.complex.X (n + 1) ⟶ P.complex.X n)
    (hc : ∀ n, c (n + 1) ≫ P.complex.d (n + 1) n + P.complex.d (n + 2) (n + 1) ≫ c n = 0)
    (n : ℕ) (g : P.complex.X n ⟶ N) (hg : P.complex.d (n + 1) n ≫ g = 0)
    (hg' : P.complex.d (n + 2) (n + 1) ≫ c n ≫ g = 0) :
    (P.extEquivCohomologyClass.symm (.mk ((P.degreeOneCocycle c hc).postcomp P.π'))).comp
      (P.extMk g (n + 1) rfl hg) (by omega : 1 + n = n + 1) =
    P.extMk (c n ≫ g) (n + 2) rfl hg' := by
  unfold ProjectiveResolution.extMk
  rw [P.extEquivCohomologyClass_symm_comp 1 n (by omega)]
  congr 2
  apply Cocycle.ext
  apply (Cochain.toSingleEquiv (show -((n + 1 : ℕ) : ℤ) + ((n + 1 : ℕ) : ℤ) = 0 by omega)).injective
  simp only [Cocycle.toSingleMk_coe, Cochain.toSingleEquiv_toSingleMk]
  change ((P.degreeOneCochain c).comp
    (Cochain.toSingleMk ((P.cochainComplexXIso (-n) n rfl).hom ≫ g)
      (show -(n : ℤ) + n = 0 by omega))
      (show (1 : ℤ) + n = ((n + 1 : ℕ) : ℤ) by omega)).v
      (-((n + 1 : ℕ) : ℤ)) 0 (by omega) ≫
      (HomologicalComplex.singleObjXSelf (.up ℤ) 0 N).hom =
    (P.cochainComplexXIso (-((n + 1 : ℕ) : ℤ)) (n + 1) rfl).hom ≫ c n ≫ g
  rw [Cochain.comp_v _ _ _ _ (-n) _ (by omega) (by omega)]
  rw [P.degreeOneCochain_v c _ _ _ n rfl]
  simp [Cochain.toSingleMk_v, Category.assoc]

end CategoryTheory.ProjectiveResolution

/-! ### Linear algebra of the Koszul differential -/

namespace Koszul

section LinearAlgebra

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]

/-- **On a wedge of linear forms, the duality pairing is the pairing of the tail precomposed with
the Koszul differential of the head**:
`pairing(φ₀ ∧ ⋯ ∧ φₙ) = pairing(φ₁ ∧ ⋯ ∧ φₙ) ∘ (φ₀ ⌟ -)`. -/
theorem pairingDual_comp_d (n : ℕ) (f : Fin (n + 1) → Module.Dual R E) :
    (exteriorPower.pairingDual R E n (exteriorPower.ιMulti R n (Fin.tail f))).comp
      (d (f 0) n) =
    exteriorPower.pairingDual R E (n + 1) (exteriorPower.ιMulti R (n + 1) f) := by
  apply LinearMap.ext_on (exteriorPower.ιMulti_span R (n + 1) E)
  rintro _ ⟨v, rfl⟩
  have hd : d (f 0) n (exteriorPower.ιMulti R (n + 1) v) =
      ∑ i : Fin (n + 1), ((-1 : R) ^ (i : ℕ) * f 0 (v i)) •
        exteriorPower.ιMulti R n (v ∘ i.succAbove) := by
    apply Subtype.ext
    simpa only [d_apply_coe, exteriorPower.ιMulti_apply_coe,
      Submodule.coe_sum, Submodule.coe_smul_of_tower] using contraction_ιMulti (f 0) n v
  simp only [LinearMap.comp_apply, hd, map_sum, map_smul,
    exteriorPower.pairingDual_ιMulti_ιMulti, smul_eq_mul]
  rw [Matrix.det_succ_column_zero]
  apply Finset.sum_congr rfl
  intro i _
  simp only [Matrix.submatrix, Matrix.of, Fin.tail, Function.comp_apply]
  rfl

/-- **Every linear map `⋀^{n+1} E → R/J` is a sum of maps `g ∘ (φ ⌟ -)`** with `φ` a linear form
on `E` and `g : ⋀ⁿ E → R/J`, for `E` finite free. -/
theorem closure_range_comp_d [Module.Free R E] [Module.Finite R E] (J : Ideal R) (n : ℕ) :
    AddSubgroup.closure (Set.range (fun p : Module.Dual R E × ((⋀[R]^n E) →ₗ[R] R ⧸ J) =>
      p.2.comp (d p.1 n))) = ⊤ := by
  classical
  let S := AddSubgroup.closure (Set.range (fun p :
    Module.Dual R E × ((⋀[R]^n E) →ₗ[R] R ⧸ J) => p.2.comp (d p.1 n)))
  apply top_unique
  intro g _
  obtain ⟨g', hg'⟩ := Module.projective_lifting_property J.mkQ g J.mkQ_surjective
  obtain ⟨w, hw⟩ := (exteriorPower.bijective_pairingDual R E (n + 1)).2 g'
  have hwspan : w ∈ Submodule.span R (Set.range (exteriorPower.ιMulti R (n + 1))) := by
    rw [exteriorPower.ιMulti_span]; trivial
  have hmain : ∀ l : R →ₗ[R] R ⧸ J,
      l.comp (exteriorPower.pairingDual R E (n + 1) w) ∈ S := by
    clear hw hg'
    induction hwspan using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨f, rfl⟩ := hw
      intro l
      rw [← pairingDual_comp_d]
      exact AddSubgroup.subset_closure ⟨⟨f 0,
        l.comp (exteriorPower.pairingDual R E n (exteriorPower.ιMulti R n (Fin.tail f)))⟩, rfl⟩
    | zero => intro l; simp
    | add x y _ _ hx hy =>
      intro l
      simpa only [map_add, LinearMap.comp_add] using S.add_mem (hx l) (hy l)
    | smul a x _ hx =>
      intro l
      convert hx (l.comp (a • LinearMap.id)) using 1
      ext z
      simp
  simpa only [hw, hg'] using hmain J.mkQ

/-- Contractions by two linear forms anticommute, as maps of exterior powers. -/
theorem d_comp_d_add_d_comp_d (φ ψ : Module.Dual R E) (n : ℕ) :
    (d ψ n).comp (d φ (n + 1)) + (d φ n).comp (d ψ (n + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change contraction ψ (contraction φ (x : ExteriorAlgebra R E)) +
    contraction φ (contraction ψ (x : ExteriorAlgebra R E)) = 0
  rw [CliffordAlgebra.contractLeft_comm, neg_add_cancel]

/-- Contractions by two linear forms anticommute, as morphisms of `ModuleCat R`. -/
theorem ofHom_d_comp_ofHom_d_add {E : Type u} [AddCommGroup E] [Module R E]
    (φ ψ : Module.Dual R E) (n : ℕ) :
    ModuleCat.ofHom (d φ (n + 1)) ≫ ModuleCat.ofHom (d ψ n) +
      ModuleCat.ofHom (d ψ (n + 1)) ≫ ModuleCat.ofHom (d φ n) = 0 :=
  ModuleCat.hom_ext (d_comp_d_add_d_comp_d φ ψ n)

end LinearAlgebra

variable {R : Type u} [CommRing R] {r : ℕ}

/-- **Every linear map out of a Koszul term into `R/J` is a cocycle**, for a sequence in `J`. -/
theorem comp_d_seqDual_eq_zero (f : Fin r → R) (J : Ideal R) (hf : ∀ i, f i ∈ J) (n : ℕ)
    (g : (⋀[R]^n (Fin r → R)) →ₗ[R] R ⧸ J) :
    g.comp (d (seqDual f) n) = 0 := by
  apply LinearMap.ext
  intro x
  simp only [LinearMap.comp_apply, d_seqDual_eq_sum_smul, LinearMap.sum_apply,
    LinearMap.smul_apply, map_sum, map_smul, LinearMap.zero_apply]
  apply Finset.sum_eq_zero
  intro i _
  change (Ideal.Quotient.mk J (f i)) * _ = 0
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr (hf i), zero_mul]

/-- The Koszul differential into degree `n` followed by any map to `R/J` is zero. -/
private theorem seqComplex_d_comp_ofHom_eq_zero (f : Fin r → R) (J : Ideal R)
    (hf : ∀ i, f i ∈ J) (n : ℕ) (g : (⋀[R]^n (Fin r → R)) →ₗ[R] R ⧸ J) :
    (seqComplex f).d (n + 1) n ≫ ModuleCat.ofHom g = 0 := by
  rw [seqComplex_d]
  exact ModuleCat.hom_ext (comp_d_seqDual_eq_zero f J hf n g)

/-! ### Generation in degree one -/

variable [HasExt (ModuleCat.{u} R)]

/-- The class in `Extⁿ_R(R/J, R/J)` of a linear map `⋀ⁿ(Rʳ) → R/J`, computed by the Koszul
resolution. -/
def koszulExtMk (f : Fin r → R) (hf : IsKoszulRegular f) (n : ℕ) :
    ((⋀[R]^n (Fin r → R)) →ₗ[R] R ⧸ Ideal.span (Set.range f)) →+
      Abelian.Ext (ModuleCat.of R (R ⧸ Ideal.span (Set.range f)))
        (ModuleCat.of R (R ⧸ Ideal.span (Set.range f))) n where
  toFun g := (seqProjectiveResolution f hf).extMk (ModuleCat.ofHom g) (n + 1) rfl (by
    change (seqComplex f).d (n + 1) n ≫ _ = 0
    rw [seqComplex_d]
    exact ModuleCat.hom_ext (comp_d_seqDual_eq_zero f _
      (fun i => Ideal.subset_span (Set.mem_range_self i)) n g))
  map_zero' := ProjectiveResolution.extMk_zero _ _ _
  map_add' g g' := by
    symm
    apply ProjectiveResolution.add_extMk

/-- **The self-`Ext` of the quotient by a Koszul-regular sequence is generated in degree one**:
`Ext^{n+1}_R(R/J, R/J)` is generated as an abelian group by the composites of classes in
`Ext¹_R(R/J, R/J)` and in `Extⁿ_R(R/J, R/J)`. -/
theorem closure_range_ext_comp_eq_top (f : Fin r → R) (hf : IsKoszulRegular f) (n : ℕ) {m : ℕ}
    (hnm : 1 + n = m) :
    AddSubgroup.closure (Set.range (fun p :
      Abelian.Ext (ModuleCat.of R (R ⧸ Ideal.span (Set.range f)))
        (ModuleCat.of R (R ⧸ Ideal.span (Set.range f))) 1 ×
      Abelian.Ext (ModuleCat.of R (R ⧸ Ideal.span (Set.range f)))
        (ModuleCat.of R (R ⧸ Ideal.span (Set.range f))) n =>
        p.1.comp p.2 hnm)) = ⊤ := by
  obtain rfl : m = n + 1 := by omega
  set J := Ideal.span (Set.range f)
  have hfJ : ∀ i, f i ∈ J := fun i => Ideal.subset_span ⟨i, rfl⟩
  let P := seqProjectiveResolution f hf
  let L := koszulExtMk f hf
  let S := AddSubgroup.closure (Set.range (fun p :
      Abelian.Ext (ModuleCat.of R (R ⧸ J)) (ModuleCat.of R (R ⧸ J)) 1 ×
      Abelian.Ext (ModuleCat.of R (R ⧸ J)) (ModuleCat.of R (R ⧸ J)) n =>
        p.1.comp p.2 (show 1 + n = n + 1 by omega)))
  have hL : Function.Surjective (L (n + 1)) := by
    intro z
    obtain ⟨g, hg, rfl⟩ := P.extMk_surjective z (n + 2) rfl
    exact ⟨g.hom, rfl⟩
  apply top_unique
  intro z hz
  clear hz
  obtain ⟨g, rfl⟩ := hL z
  have hg : g ∈ AddSubgroup.closure (Set.range (fun p :
      Module.Dual R (Fin r → R) × ((⋀[R]^n (Fin r → R)) →ₗ[R] R ⧸ J) =>
        p.2.comp (d p.1 n))) := by
    rw [closure_range_comp_d]; trivial
  change L (n + 1) g ∈ S
  induction hg using AddSubgroup.closure_induction with
  | mem g hg =>
    obtain ⟨⟨φ, g⟩, rfl⟩ := hg
    let c : ∀ m, P.complex.X (m + 1) ⟶ P.complex.X m :=
      fun m => ModuleCat.ofHom (d φ m)
    have hc : ∀ m, c (m + 1) ≫ P.complex.d (m + 1) m +
        P.complex.d (m + 2) (m + 1) ≫ c m = 0 := by
      intro m
      simp only [c, P, seqProjectiveResolution_complex, seqComplex_d]
      exact ofHom_d_comp_ofHom_d_add φ (seqDual f) m
    let β := P.extEquivCohomologyClass.symm
      (.mk ((P.degreeOneCocycle c hc).postcomp P.π'))
    refine AddSubgroup.subset_closure ⟨⟨β, L n g⟩, ?_⟩
    apply P.degreeOneCocycle_comp_extMk c hc n (ModuleCat.ofHom g)
    · exact seqComplex_d_comp_ofHom_eq_zero f J hfJ n g
    · exact seqComplex_d_comp_ofHom_eq_zero f J hfJ (n + 1) (g.comp (d φ n))
  | zero => simp
  | add x y _ _ hx hy => simpa only [map_add] using S.add_mem hx hy
  | neg x _ hx => simpa only [map_neg] using S.neg_mem hx

end Koszul

/-- **Over a regular local ring, `Ext^*(κ, κ)` is generated in degree one**:
`Ext^{n+1}_R(κ, κ)` is generated as an abelian group by the composites of classes in
`Ext¹_R(κ, κ)` and `Extⁿ_R(κ, κ)`. -/
theorem IsRegularLocalRing.closure_range_ext_comp_residueField_eq_top (R : Type u) [CommRing R]
    [IsRegularLocalRing R] [HasExt (ModuleCat.{u} R)] (n : ℕ) :
    AddSubgroup.closure (Set.range (fun p :
      Abelian.Ext (ModuleCat.of R (R ⧸ IsLocalRing.maximalIdeal R))
        (ModuleCat.of R (R ⧸ IsLocalRing.maximalIdeal R)) 1 ×
      Abelian.Ext (ModuleCat.of R (R ⧸ IsLocalRing.maximalIdeal R))
        (ModuleCat.of R (R ⧸ IsLocalRing.maximalIdeal R)) n =>
        p.1.comp p.2 rfl)) = ⊤ := by
  obtain ⟨r, f, hf, hreg⟩ := IsRegularLocalRing.exists_isKoszulRegular_span_eq_maximalIdeal R
  rw [← hf]
  exact Koszul.closure_range_ext_comp_eq_top f hreg n rfl

end
