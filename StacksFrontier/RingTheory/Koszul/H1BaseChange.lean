module

public import Mathlib.LinearAlgebra.TensorProduct.Pi
public import StacksFrontier.RingTheory.Koszul.Relations
public import Mathlib.RingTheory.Flat.Equalizer
public import Mathlib.RingTheory.Ideal.BigOperators
import StacksCore.Tactic.EgaSgaAttribute

@[expose] public section

set_option backward.isDefEq.respectTransparency false

/-
# Problem Description

Fix a commutative ring `A`, a commutative `A`-algebra `B` (a ring map `A → B`),
and a finite sequence of elements `f_1, …, f_r ∈ B`.

We study the tail of the Koszul complex `K_•(B, f_1, …, f_r)` in low degrees

  ⋀²(B^r) --d_2--> B^r --d_1--> B

where `d_1(e_i) = f_i` (equivalently `d_1(b_1, …, b_r) = ∑_i b_i f_i`) and
`d_2(e_i ∧ e_j) = f_i · e_j − f_j · e_i`.  Its first homology is the `B`-module
`H_1(K_•) = ker(d_1) / im(d_2)`.

For a base ring map `A → A'`, set `B' = B ⊗_A A'` and let `f'_i ∈ B'` be the
image of `f_i`.  The Koszul complex is functorial for base change, inducing a
canonical comparison map

  Φ : H_1(K_•(B, f_1, …, f_r)) ⊗_A A' ⟶ H_1(K_•(B', f'_1, …, f'_r)),

characterized by `Φ([z] ⊗ a') = [z ⊗ a']`.

# Main Statement (Stacks Project, Tag 063Q)

If `A → B` is a ring map, `f_1, …, f_r` a sequence in `B` such that
`B/(f_1, …, f_r)` is flat as an `A`-module, and `A → A'` is any ring map, then
the canonical comparison map `Φ` is *surjective*.

# Notes and Interpretation

* The statement asserts only surjectivity of `Φ` (the previous claim of an
  isomorphism in Tag 063Q was withdrawn; only surjectivity holds in general).
* The only hypothesis is that `B/(f_1, …, f_r)` is `A`-flat (flatness over the
  base ring `A`, via the composite `A → B → B/(f_1, …, f_r)`).
* Stacks Tag 00HL is available in Mathlib as `Module.Flat.lTensor_exact`.
* For the truncated complex only `im(d_2)` matters; it is `relSpan f` of
  `StacksFrontier.RingTheory.Koszul.Relations`, the `B`-submodule of `B^r` generated by the
  trivial Koszul relations `trivRel f i j = f_i · e_j − f_j · e_i`.  That this
  really is the image of `d_2` is `Koszul.map_range_d_one`, and that `H_1 f` below is the
  first homology of the Koszul complex `Koszul.seqComplex f` is
  `Koszul.h1ConcreteIso`.  The differential `d_1` is the functional `seqDual f`.
-/

namespace KoszulH1

open Koszul

open scoped TensorProduct

variable {B : Type*} [CommRing B] {r : ℕ}

/-! ## Main Definition 1 : the Koszul differential `d_1` and the relations `im(d_2)`.

`d_1 : B^r → B` sends the standard basis vector `e_i` to `f_i`; on a general element
`d_1 (b_1, …, b_r) = ∑_i b_i f_i`.  It is `seqDual f`, and `im(d_2)` is
`relSpan f`, the `B`-submodule generated by the trivial Koszul relations
`trivRel f i j = f_i · e_j − f_j · e_i`.  Here `B^r` is modelled as `Fin r → B`.
`relSpan_le_ker` is `d_1 ∘ d_2 = 0`. -/

/-- `im(d_2)` viewed as a submodule of `ker(d_1)`. -/
noncomputable def relInKer (f : Fin r → B) : Submodule B (LinearMap.ker (seqDual f)) :=
  Submodule.comap (LinearMap.ker (seqDual f)).subtype (relSpan f)

/-- A cycle lies in `im(d_2)` inside `ker(d_1)` exactly when it lies in `relSpan f`. -/
@[simp] lemma mem_relInKer_iff {f : Fin r → B} {z : LinearMap.ker (seqDual f)} :
    z ∈ relInKer f ↔ (z : Fin r → B) ∈ relSpan f := Iff.rfl

/-! ## Main Definition 2 : first Koszul homology `H_1 = ker(d_1) / im(d_2)`. -/

/-- First Koszul homology `H_1(K_•(B, f)) = ker(d_1) / im(d_2)`, as a `B`-module
(hence also, by restriction of scalars, an `A`-module for any base `A`). -/
@[ega "III 1.1.3" "(f)"]
noncomputable abbrev H1 (f : Fin r → B) : Type _ :=
  (LinearMap.ker (seqDual f)) ⧸ (relInKer f)

/-- The class map `ker(d_1) → H_1`, `z ↦ [z]`. -/
noncomputable def toH1 (f : Fin r → B) : (LinearMap.ker (seqDual f)) →ₗ[B] H1 f :=
  (relInKer f).mkQ

/-- The class map to `H_1` is surjective. -/
theorem toH1_surjective (f : Fin r → B) : Function.Surjective (toH1 f) :=
  (relInKer f).mkQ_surjective

section BaseChange

/-! ## Main Definition 3 : base change along `A → A'`. -/

variable {A A' : Type*} [CommRing A] [Algebra A B] [CommRing A'] [Algebra A A']

/-- The canonical algebra inclusion `B → B' = B ⊗_A A'`, `b ↦ b ⊗ 1`. -/
noncomputable abbrev inclLeft : B →ₐ[A] (B ⊗[A] A') :=
  Algebra.TensorProduct.includeLeft (R := A) (S := A) (A := B) (B := A')

/-- The componentwise base-change `A`-linear map `B^r → (B')^r`, `z ↦ z ⊗ 1`. -/
noncomputable def bc0 : (Fin r → B) →ₗ[A] (Fin r → (B ⊗[A] A')) :=
  LinearMap.compLeft (inclLeft (A := A) (A' := A')).toLinearMap (Fin r)

/-- The `i`-th component of `bc0 b` is `b i ⊗ 1`. -/
@[simp] lemma bc0_apply (b : Fin r → B) (i : Fin r) :
    bc0 (A := A) (A' := A') b i = inclLeft (A := A) (A' := A') (b i) := rfl

/-- The base-changed sequence `f' : Fin r → B'`, `f'_i = f_i ⊗ 1`. -/
noncomputable def fp (f : Fin r → B) : Fin r → (B ⊗[A] A') :=
  fun i => inclLeft (A := A) (A' := A') (f i)

/-- The `i`-th term of the base-changed sequence is `f i ⊗ 1`. -/
@[simp] lemma fp_apply (f : Fin r → B) (i : Fin r) :
    fp (A := A) (A' := A') f i = inclLeft (A := A) (A' := A') (f i) := rfl

/-- `d_1` is compatible with base change: `d_1' (z ⊗ 1) = (d_1 z) ⊗ 1`. -/
lemma seqDual_fp_bc0 (f b : Fin r → B) :
    seqDual (fp (A := A) (A' := A') f) (bc0 (A := A) (A' := A') b)
      = inclLeft (A := A) (A' := A') (seqDual f b) := by
  simp only [seqDual_apply, bc0_apply, fp_apply, map_sum, map_mul]

/-- The base change of a Koszul relation is the corresponding Koszul relation for `f'`. -/
lemma bc0_trivRel (f : Fin r → B) (i j : Fin r) :
    bc0 (A := A) (A' := A') (trivRel f i j)
      = trivRel (fp (A := A) (A' := A') f) i j := by
  funext k
  simp only [bc0_apply, trivRel_apply, fp_apply, map_sub, apply_ite inclLeft, map_zero]

/-- Base change sends `ker(d_1)` into `ker(d_1')`. -/
lemma bc0_mem_ker (f : Fin r → B) {b : Fin r → B} (hb : b ∈ LinearMap.ker (seqDual f)) :
    bc0 (A := A) (A' := A') b ∈ LinearMap.ker (seqDual (fp (A := A) (A' := A') f)) := by
  rw [LinearMap.mem_ker] at hb ⊢
  rw [seqDual_fp_bc0, hb, map_zero]

/-- Base change is `inclLeft`-semilinear: `bc0 (c • x) = (c ⊗ 1) • bc0 x`. -/
lemma bc0_smul (c : B) (x : Fin r → B) :
    bc0 (A := A) (A' := A') (c • x)
      = inclLeft (A := A) (A' := A') c • bc0 (A := A) (A' := A') x := by
  funext k
  simp [bc0_apply, Pi.smul_apply, smul_eq_mul, map_mul, Algebra.smul_def]

/-- Base change sends `im(d_2)` into `im(d_2')`. -/
lemma bc0_mem_relSpan (f : Fin r → B) {b : Fin r → B} (hb : b ∈ relSpan f) :
    bc0 (A := A) (A' := A') b ∈ relSpan (fp (A := A) (A' := A') f) := by
  induction hb using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨p, rfl⟩ := hx
      rw [bc0_trivRel]
      exact Submodule.subset_span ⟨p, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [bc0_smul]; exact Submodule.smul_mem _ _ hx

/-- Base change restricted to kernels, as an `A`-linear map
`ker(d_1) → ker(d_1')`. -/
noncomputable def bcKer (f : Fin r → B) :
    (LinearMap.ker (seqDual f)).restrictScalars A →ₗ[A]
      (LinearMap.ker (seqDual (fp (A := A) (A' := A') f))).restrictScalars A :=
  LinearMap.restrict (bc0 (A := A) (A' := A')) (fun _ hb => bc0_mem_ker f hb)

/-- As an element of `(B')^r`, `bcKer f x` is the base change `bc0 x`. -/
@[simp] lemma bcKer_coe (f : Fin r → B) (x : (LinearMap.ker (seqDual f)).restrictScalars A) :
    (bcKer (A := A) (A' := A') f x : Fin r → (B ⊗[A] A'))
      = bc0 (A := A) (A' := A') (x : Fin r → B) := rfl

/-- `bcKer` sends `im(d_2)` (inside `ker(d_1)`) into `im(d_2')` (inside `ker(d_1')`). -/
lemma relInKer_le_comap_bcKer (f : Fin r → B) :
    (relInKer f).restrictScalars A
      ≤ Submodule.comap (bcKer (A := A) (A' := A') f)
          ((relInKer (fp (A := A) (A' := A') f)).restrictScalars A) := by
  intro x hx
  exact bc0_mem_relSpan f hx

/-! ## Main Definition 4 : the canonical comparison map.

We build the comparison map in two steps.  First, base change induces an
`A`-linear map on homology `H_1(B, f) → H_1(B', f')`, `[z] ↦ [z ⊗ 1]`.  Then,
`A'`-linearizing via the tensor product, we obtain
`Φ : H_1(B, f) ⊗_A A' → H_1(B', f')`. -/

/-- The `A`-linear map on first homology induced by base change,
`cmpBase [z] = [z ⊗ 1]`. -/
noncomputable def cmpBase (f : Fin r → B) :
    H1 f →ₗ[A] H1 (fp (A := A) (A' := A') f) :=
  Submodule.mapQ ((relInKer f).restrictScalars A)
    ((relInKer (fp (A := A) (A' := A') f)).restrictScalars A)
    (bcKer (A := A) (A' := A') f) (relInKer_le_comap_bcKer f)

/-- On the class of a cycle `z`, `cmpBase [z] = [bcKer f z]`. -/
@[simp] lemma cmpBase_toH1 (f : Fin r → B) (z : LinearMap.ker (seqDual f)) :
    cmpBase (A := A) (A' := A') f (toH1 f z)
      = toH1 (fp (A := A) (A' := A') f) (bcKer (A := A) (A' := A') f z) := by
  rfl

/-- The canonical algebra map `A' → B' = B ⊗_A A'`, `a' ↦ 1 ⊗ a'`.  This realizes
the `A'`-action on the `B'`-module `H_1(B', f')` (and `z ⊗ a' = (1 ⊗ a') · (z ⊗ 1)`). -/
noncomputable abbrev inclRight : A' →ₐ[A] (B ⊗[A] A') := Algebra.TensorProduct.includeRight

/-- The bilinear map `H_1(B, f) × A' → H_1(B', f')`, `(h, a') ↦ (1 ⊗ a') • cmpBase h`,
underlying the canonical comparison map.  On a class `[z]`, `(h, a') ↦ [z ⊗ a']`. -/
noncomputable def cmpBilin (f : Fin r → B) :
    H1 f →ₗ[A] A' →ₗ[A] H1 (fp (A := A) (A' := A') f) :=
  LinearMap.mk₂ A
    (fun h a' => inclRight (A := A) (B := B) (A' := A') a' • cmpBase (A := A) (A' := A') f h)
    (fun _ _ _ => by rw [map_add, smul_add])
    (fun _ _ _ => by rw [map_smul, smul_comm])
    (fun _ _ _ => by rw [map_add, add_smul])
    (fun _ _ _ => by rw [map_smul, smul_assoc])

/-- **Definition 4 (the canonical comparison map).**  The `A`-linear comparison map
`Φ : H_1(K_•(B, f)) ⊗_A A' ⟶ H_1(K_•(B', f'))`, characterized by
`Φ([z] ⊗ a') = [z ⊗ a']`. -/
noncomputable def cmp (f : Fin r → B) :
    (H1 f) ⊗[A] A' →ₗ[A] H1 (fp (A := A) (A' := A') f) :=
  TensorProduct.lift (cmpBilin (A := A) (A' := A') f)

/-- The characterization of `Φ` on simple tensors `[z] ⊗ a'`: `Φ([z] ⊗ a') = [z ⊗ a']`,
where `z ⊗ a' = (1 ⊗ a') · (z ⊗ 1)` is the image of `z` scaled by `a'` in `ker(d_1')`. -/
@[simp] lemma cmp_tmul (f : Fin r → B) (z : LinearMap.ker (seqDual f)) (a' : A') :
    cmp (A := A) (A' := A') f (toH1 f z ⊗ₜ[A] a')
      = (inclRight (A := A) (B := B) (A' := A') a')
          • toH1 (fp (A := A) (A' := A') f) (bcKer (A := A) (A' := A') f z) := by
  simp only [cmp, TensorProduct.lift.tmul, cmpBilin, LinearMap.mk₂_apply, cmpBase_toH1]

end BaseChange

/-! ## Main Statement (Stacks Project, Tag 063Q). -/

section MainProof

variable {A A' : Type*} [CommRing A] [Algebra A B] [CommRing A'] [Algebra A A']

/-- The image of `d_1 = seqDual f` is the ideal `(f_1, …, f_r)`. -/
theorem range_seqDual (f : Fin r → B) :
    LinearMap.range (seqDual f) = Ideal.span (Set.range f) :=
  Fintype.range_linearCombination B f

/-- The image of `d_1 = seqDual f`, as an `A`-submodule of `B`, is the ideal `(f_1, …, f_r)`. -/
theorem range_seqDual_restrictScalars (f : Fin r → B) :
    LinearMap.range ((seqDual f).restrictScalars A)
      = (Ideal.span (Set.range f)).restrictScalars A :=
  SetLike.coe_injective <| by rw [← range_seqDual f]; rfl

/-- If `B ⧸ J` is `A`-flat, then `J ⊗_A A' → B ⊗_A A'` is injective. -/
theorem rTensor_subtype_injective_of_flat_quotient (J : Submodule A B)
    [Module.Flat A (B ⧸ J)] : Function.Injective (J.subtype.rTensor A') := by
  have key : J.subtype.rTensor A' = (TensorProduct.comm A A' B).toLinearMap ∘ₗ
      J.subtype.lTensor A' ∘ₗ (TensorProduct.comm A J A').toLinearMap := by
    ext x a
    simp
  rw [key]
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe]
  exact (TensorProduct.comm A A' B).injective.comp
    ((LinearMap.lTensor_injective_of_exact_of_flat J.mkQ J.mkQ_surjective J.subtype
      J.subtype_injective (LinearMap.exact_subtype_mkQ J) A').comp
      (TensorProduct.comm A J A').injective)

/-- Under `(B^r) ⊗_A A' ≃ (B')^r`, the differential `d_1'` is the base change of `d_1`. -/
theorem seqDual_fp_comp_piLeft (f : Fin r → B) :
    (seqDual (fp (A := A) (A' := A') f)).restrictScalars A ∘ₗ
        (TensorProduct.piLeft A A' fun _ : Fin r => B).toLinearMap
      = ((seqDual f).restrictScalars A).rTensor A' := by
  refine TensorProduct.ext' fun b a' => ?_
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    LinearMap.rTensor_tmul, LinearMap.coe_restrictScalars, seqDual_apply, TensorProduct.sum_tmul]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp [TensorProduct.piLeft, Algebra.TensorProduct.tmul_mul_tmul]

/-- If `B ⧸ (f_1, …, f_r)` is `A`-flat, the kernel of `d_1 ⊗ A'` is the image of
`ker(d_1) ⊗_A A'`. -/
theorem ker_rTensor_seqDual_eq_range (f : Fin r → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))] :
    LinearMap.ker (((seqDual f).restrictScalars A).rTensor A')
      = LinearMap.range
          (((LinearMap.ker (seqDual f)).restrictScalars A).subtype.rTensor A') := by
  set D := (seqDual f).restrictScalars A
  have : Module.Flat A (B ⧸ LinearMap.range D) := by
    rw [range_seqDual_restrictScalars]
    exact Module.Flat.of_linearEquiv (Submodule.Quotient.restrictScalarsEquiv A _)
  have hexact : Function.Exact ((LinearMap.ker (seqDual f)).restrictScalars A).subtype
      D.rangeRestrict := by
    rw [LinearMap.exact_iff, Submodule.range_subtype, LinearMap.ker_rangeRestrict]
    rfl
  rw [← LinearMap.exact_iff.mp (rTensor_exact A' hexact D.surjective_rangeRestrict)]
  conv_lhs => rw [← LinearMap.subtype_comp_codRestrict D _ (LinearMap.mem_range_self D),
    LinearMap.rTensor_comp]
  exact LinearMap.ker_comp_of_ker_eq_bot _
    (LinearMap.ker_eq_bot_of_injective (rTensor_subtype_injective_of_flat_quotient _))

/-- The image of `ker(d_1) ⊗_A A'` in `(B')^r` lies in `ker(d_1')`. -/
theorem piLeft_rTensor_mem_ker (f : Fin r → B)
    (u : ((LinearMap.ker (seqDual f)).restrictScalars A) ⊗[A] A') :
    TensorProduct.piLeft A A' (fun _ : Fin r => B)
        (((LinearMap.ker (seqDual f)).restrictScalars A).subtype.rTensor A' u)
      ∈ (LinearMap.ker (seqDual (fp (A := A) (A' := A') f))).restrictScalars A := by
  have h := LinearMap.congr_fun (seqDual_fp_comp_piLeft (A' := A') f)
    (((LinearMap.ker (seqDual f)).restrictScalars A).subtype.rTensor A' u)
  have hzero : (seqDual f).restrictScalars A ∘ₗ
      ((LinearMap.ker (seqDual f)).restrictScalars A).subtype = 0 := by
    ext x
    simp
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    LinearMap.coe_restrictScalars] at h
  rw [Submodule.restrictScalars_mem, LinearMap.mem_ker, h, ← LinearMap.comp_apply,
    ← LinearMap.rTensor_comp, hzero, LinearMap.rTensor_zero, LinearMap.zero_apply]

/-- The `A'`-linearization `ker(d_1) ⊗_A A' → ker(d_1')` of base change, `z ⊗ a' ↦ z ⊗ a'`. -/
noncomputable def bcKerTensor (f : Fin r → B) :
    ((LinearMap.ker (seqDual f)).restrictScalars A) ⊗[A] A' →ₗ[A]
      (LinearMap.ker (seqDual (fp (A := A) (A' := A') f))).restrictScalars A :=
  ((TensorProduct.piLeft A A' fun _ : Fin r => B).toLinearMap ∘ₗ
    ((LinearMap.ker (seqDual f)).restrictScalars A).subtype.rTensor A').codRestrict _
    (piLeft_rTensor_mem_ker f)

/-- As an element of `(B')^r`, `bcKerTensor f u` is the image of `u` under
`ker(d_1) ⊗_A A' → B^r ⊗_A A' ≃ (B')^r`. -/
@[simp] lemma bcKerTensor_coe (f : Fin r → B)
    (u : ((LinearMap.ker (seqDual f)).restrictScalars A) ⊗[A] A') :
    (bcKerTensor f u : Fin r → B ⊗[A] A')
      = TensorProduct.piLeft A A' (fun _ : Fin r => B)
          (((LinearMap.ker (seqDual f)).restrictScalars A).subtype.rTensor A' u) := rfl

/-- On a simple tensor, `bcKerTensor f (z ⊗ a') = (1 ⊗ a') • bcKer f z`. -/
@[simp] lemma bcKerTensor_tmul (f : Fin r → B)
    (z : (LinearMap.ker (seqDual f)).restrictScalars A) (a' : A') :
    bcKerTensor f (z ⊗ₜ[A] a')
      = (inclRight (A := A) (B := B) (A' := A') a') • bcKer (A := A) (A' := A') f z := by
  apply Subtype.ext
  funext i
  change _ = ((inclRight (A := A) (B := B) (A' := A') a') •
    (bcKer (A := A) (A' := A') f z : Fin r → B ⊗[A] A')) i
  simp [TensorProduct.piLeft, Algebra.TensorProduct.tmul_mul_tmul]

/-- The comparison map `Φ` is compatible with `bcKerTensor` through homology. -/
theorem cmp_rTensor_toH1 (f : Fin r → B)
    (u : ((LinearMap.ker (seqDual f)).restrictScalars A) ⊗[A] A') :
    cmp (A := A) (A' := A') f (((toH1 f).restrictScalars A).rTensor A' u)
      = toH1 (fp (A := A) (A' := A') f) (bcKerTensor f u) := by
  induction u using TensorProduct.inductionOn with
  | tmul z a' => exact (cmp_tmul f z a').trans (by rw [bcKerTensor_tmul, map_smul])
  | add x y hx hy => simp only [map_add, hx, hy]

/-- If `B ⧸ (f_1, …, f_r)` is `A`-flat, then every class `toH1 (fp f) w` in
`H_1(K_•(B', f'))` lies in the range of the comparison map `Φ = cmp f`
(Stacks Tag 063Q; the flatness input is Tag 00HL, via `Module.Flat.rTensor_exact`).

Flatness is essential: for `A = ℤ`, `B = ℤ`, `f = ![p]` and `A' = ℤ/p` the conclusion
fails, and there `B ⧸ (f)` is not `ℤ`-flat. -/
lemma exists_cmp_eq_toH1 (f : Fin r → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (w : LinearMap.ker (seqDual (fp (A := A) (A' := A') f))) :
    ∃ t : (H1 f) ⊗[A] A', cmp (A := A) (A' := A') f t = toH1 (fp (A := A) (A' := A') f) w := by
  obtain ⟨u, hu⟩ : (TensorProduct.piLeft A A' fun _ : Fin r => B).symm w
      ∈ LinearMap.range
          (((LinearMap.ker (seqDual f)).restrictScalars A).subtype.rTensor A') := by
    rw [← ker_rTensor_seqDual_eq_range f, LinearMap.mem_ker, ← seqDual_fp_comp_piLeft,
      LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
    exact w.property
  refine ⟨((toH1 f).restrictScalars A).rTensor A' u, ?_⟩
  rw [cmp_rTensor_toH1]
  congr 1
  exact Subtype.ext (by rw [bcKerTensor_coe, hu, LinearEquiv.apply_symm_apply])

/-- **Stacks Project, Tag 063Q.**  Let `A → B` be a ring map and `f_1, …, f_r` a
sequence in `B` such that `B/(f_1, …, f_r)` is flat as an `A`-module.  Let
`A → A'` be a ring map and set `B' = B ⊗_A A'`, `f'_i = f_i ⊗ 1`.  Then the
canonical comparison map

  Φ : H_1(K_•(B, f_1, …, f_r)) ⊗_A A' ⟶ H_1(K_•(B', f'_1, …, f'_r))

is surjective.

Here the flatness hypothesis is stated as `Module.Flat A (B ⧸ Ideal.span (Set.range f))`,
the quotient being viewed as an `A`-module by restriction of scalars along `A → B`. -/
@[stacks 063Q]
theorem cmp_surjective
    {A B A' : Type*} [CommRing A] [CommRing B] [Algebra A B] [CommRing A'] [Algebra A A']
    {r : ℕ} (f : Fin r → B)
    (hflat : Module.Flat A (B ⧸ Ideal.span (Set.range f))) :
    Function.Surjective (cmp (A := A) (A' := A') f) := by
  intro y
  obtain ⟨w, rfl⟩ := toH1_surjective (fp (A := A) (A' := A') f) y
  exact exists_cmp_eq_toH1 f w

end MainProof

end KoszulH1
