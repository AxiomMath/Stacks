module

public import StacksFrontier.RingTheory.Koszul.Defs
public import StacksCore.Tactic.StacksAttribute

/-!
# The Koszul differential graded algebra

For a module `E` over a commutative ring `R`, an `R`-linear functional
`φ : E →ₗ[R] R` determines the Koszul complex. Its graded algebra is the exterior
algebra of `E`; its differential lowers exterior degree by one, squares to zero, and
is the unique graded derivation whose value on a generator `e` is `φ e`.

## Main definitions

* `Koszul.HomologicalDifferentialGradedExteriorAlgebra`: a differential graded
  exterior algebra, expressed by its action on scalars and on products with generators.
* `Koszul.differentialGradedAlgebra`: the Koszul differential graded algebra
  associated to a linear functional.

## Main results

* `Koszul.HomologicalDifferentialGradedExteriorAlgebra.differential_unique`: the
  differential is uniquely determined by its value on the generators.
* `Koszul.HomologicalDifferentialGradedExteriorAlgebra.differential_mul_of_mem`:
  the full signed Leibniz rule on homogeneous elements.
* `Koszul.differentialGradedAlgebra_toChainComplex`: the homogeneous-piece
  chain complex of the Koszul differential graded algebra is `Koszul.complex`.

## Implementation notes

The underlying graded algebra is Mathlib's exterior algebra, graded by its exterior
powers. The graded Leibniz rule is recorded on a product whose left factor is a
degree-one generator; the induction principle for the exterior algebra makes this
equivalent to specifying the derivation on the whole algebra, as stated by
`HomologicalDifferentialGradedExteriorAlgebra.differential_mul_of_mem`. Restricting
the differential to the homogeneous pieces gives its associated chain complex.

`Koszul.complex` is a chain complex of `R`-modules and carries no multiplication. It is
recovered from `Koszul.differentialGradedAlgebra` by restricting the differential to the
exterior powers, and `differentialGradedAlgebra_toChainComplex` identifies the two by
definition.

## References

* [The Stacks Project, Tag 0622](https://stacks.math.columbia.edu/tag/0622)
-/

@[expose] public section


namespace Koszul

universe u v

open scoped ExteriorAlgebra

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]

/-- A homological differential graded algebra whose underlying graded algebra is the
exterior algebra `⋀[R] E`.

The displayed rule is the degree-one case of the graded Leibniz rule. Since the
exterior algebra is generated by `E`, it determines the differential on every element. -/
structure HomologicalDifferentialGradedExteriorAlgebra (φ : E →ₗ[R] R) where
  /-- The differential on the exterior algebra. -/
  differential : ExteriorAlgebra R E →ₗ[R] ExteriorAlgebra R E
  /-- The differential lowers exterior degree by one. -/
  differential_mem : ∀ (n : ℕ) {x : ExteriorAlgebra R E}, x ∈ ⋀[R]^(n + 1) E →
    differential x ∈ ⋀[R]^n E
  /-- The differential vanishes on scalars. -/
  differential_algebraMap : ∀ r : R,
    differential (algebraMap R (ExteriorAlgebra R E) r) = 0
  /-- The graded Leibniz rule on the degree-one generators. -/
  differential_ι_mul : ∀ (e : E) (x : ExteriorAlgebra R E),
    differential (ExteriorAlgebra.ι R e * x) =
      φ e • x - ExteriorAlgebra.ι R e * differential x
  /-- The differential squares to zero. -/
  differential_sq_zero : ∀ x, differential (differential x) = 0

namespace HomologicalDifferentialGradedExteriorAlgebra

/-- The full homological graded Leibniz rule. If `a` has exterior degree `n`, then
`d (a * b) = d a * b + (-1) ^ n • (a * d b)` for every `b`. -/
theorem differential_mul_of_mem {φ : E →ₗ[R] R}
    (A : HomologicalDifferentialGradedExteriorAlgebra φ) (n : ℕ)
    {a : ExteriorAlgebra R E} (ha : a ∈ ⋀[R]^n E) (b : ExteriorAlgebra R E) :
    A.differential (a * b) =
      A.differential a * b + ((-1 : R) ^ n) • (a * A.differential b) := by
  induction ha using Submodule.pow_induction_on_left' with
  | algebraMap r =>
    rw [A.differential_algebraMap]
    simp [Algebra.algebraMap_eq_smul_one]
  | add x y n hx hy ihx ihy =>
    simp only [add_mul, map_add, ihx, ihy, smul_add]
    abel
  | mem_mul x hx n y hy ih =>
    obtain ⟨e, rfl⟩ := hx
    rw [mul_assoc, A.differential_ι_mul, A.differential_ι_mul, ih]
    simp only [pow_succ, mul_neg, mul_one, neg_smul, mul_add, sub_mul,
      smul_mul_assoc, mul_smul_comm, mul_assoc]
    abel

/-- Two differentials on the exterior algebra which extend the same functional are equal. -/
theorem differential_unique {φ : E →ₗ[R] R}
    (A B : HomologicalDifferentialGradedExteriorAlgebra φ) :
    A.differential = B.differential := by
  refine LinearMap.ext fun x => ?_
  induction x using CliffordAlgebra.left_induction with
  | algebraMap r => rw [A.differential_algebraMap, B.differential_algebraMap]
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | ι_mul e x hx => rw [A.differential_ι_mul, B.differential_ι_mul, hx]

/-- The differential restricted from exterior degree `n + 1` to exterior degree `n`. -/
noncomputable def differentialOnExteriorPower {φ : E →ₗ[R] R}
    (A : HomologicalDifferentialGradedExteriorAlgebra φ) (n : ℕ) :
    (⋀[R]^(n + 1) E) →ₗ[R] (⋀[R]^n E) :=
  LinearMap.codRestrict _ (A.differential.comp (⋀[R]^(n + 1) E).subtype)
    (fun x => A.differential_mem n x.2)

/-- The chain complex obtained by restricting the differential to the homogeneous
exterior powers. -/
@[sga "3 III 4.6.1" "more general"]
noncomputable def toChainComplex {φ : E →ₗ[R] R}
    (A : HomologicalDifferentialGradedExteriorAlgebra φ) :
    ChainComplex (ModuleCat.{max u v} R) ℕ :=
  ChainComplex.of (fun n => ModuleCat.of R (⋀[R]^n E))
    (fun n => ModuleCat.ofHom (A.differentialOnExteriorPower n))
    (fun _ => ModuleCat.hom_ext <| LinearMap.ext fun x => Subtype.ext <| A.differential_sq_zero x)

end HomologicalDifferentialGradedExteriorAlgebra

/-- The Koszul differential graded algebra `K•(φ)`: its underlying graded algebra is
the exterior algebra `⋀[R] E`, and its differential is contraction by `φ`.

The chain complex obtained from its homogeneous pieces is `Koszul.complex φ`. -/
@[stacks 0622, sga "3 III 4.6.1" "definition", ega "III 1.1.1", sga "6 VII 1.1" "more general"]
noncomputable def differentialGradedAlgebra (φ : E →ₗ[R] R) :
    HomologicalDifferentialGradedExteriorAlgebra φ where
  differential := Koszul.contraction φ
  differential_mem := Koszul.contraction_mem φ
  differential_algebraMap := CliffordAlgebra.contractLeft_algebraMap (0 : QuadraticForm R E) φ
  differential_ι_mul := CliffordAlgebra.contractLeft_ι_mul φ
  differential_sq_zero := CliffordAlgebra.contractLeft_contractLeft φ

/-- The differential of the Koszul differential graded algebra is contraction by `φ`. -/
@[simp]
theorem differentialGradedAlgebra_differential (φ : E →ₗ[R] R) :
    (differentialGradedAlgebra φ).differential = Koszul.contraction φ := rfl

/-- The Koszul differential sends `ι e` to the scalar `φ e`. -/
@[simp]
theorem differentialGradedAlgebra_differential_ι (φ : E →ₗ[R] R) (e : E) :
    (differentialGradedAlgebra φ).differential (ExteriorAlgebra.ι R e) =
      algebraMap R (ExteriorAlgebra R E) (φ e) :=
  CliffordAlgebra.contractLeft_ι (0 : QuadraticForm R E) φ e

/-- The chain complex on the homogeneous pieces of the Koszul differential graded
algebra is the usual Koszul complex. -/
theorem differentialGradedAlgebra_toChainComplex (φ : E →ₗ[R] R) :
    (differentialGradedAlgebra φ).toChainComplex = Koszul.complex φ := rfl

end Koszul
