module

public import StacksFrontier.RingTheory.Koszul.Homotopy

@[expose] public section

/-!
# Koszul complexes of a sequence generating the unit ideal

Let `R` be a commutative ring and let `f₁, …, f_r ∈ R`. Multiplication by `f i` is
null-homotopic on the Koszul complex `K_•(f₁, …, f_r)`, so the ideal `(f₁, …, f_r)` annihilates
every Koszul homology module (Stacks 0663). When that ideal is the whole ring — in particular
when one entry of the sequence is a unit — the annihilator is therefore everything, and the
Koszul complex is acyclic: exact in *every* degree, including degree `0`, where the homology of
a Koszul complex is `R/(f₁, …, f_r)`.

This is the algebraic half of the statement that the sheafified Koszul complex of a sequence
is acyclic on the union `⋃ᵢ D(f_i)` of the principal opens of `Spec R`: on `D(f_i)` the entry
`f_i` becomes invertible, so the Koszul complex of the localized sequence is acyclic by
`Koszul.acyclic_seqComplex_of_isUnit`. (The passage from that to vanishing of the sheafified
complex is a separate, geometric step and is not carried out here.)

## Main results

* `Koszul.isZero_homology_seqComplex_of_span_eq_top` — every homology module of the Koszul
  complex of a sequence generating the unit ideal vanishes.
* `Koszul.acyclic_seqComplex_of_span_eq_top` — the same statement as acyclicity.
* `Koszul.acyclic_seqComplex_of_isUnit` — acyclicity when a single entry of the sequence is a
  unit.

## Implementation notes

The hypothesis is phrased as `Ideal.span (Set.range f) = ⊤` rather than `IsUnit (f i)` because
that is the form the annihilation statement of Stacks 0663 produces, and because it is strictly
more general: a sequence can generate the unit ideal without any single entry being invertible.
The unit-entry version is derived from it.

Nothing here is new mathematics beyond Stacks 0663; the point is that the consequence was
missing and is needed wherever a Koszul complex is restricted to a locus on which one of its
entries is invertible.

## References

* [Stacks Project, Tag 0663](https://stacks.math.columbia.edu/tag/0663)
* [Stacks Project, Tag 0623](https://stacks.math.columbia.edu/tag/0623)
-/

open CategoryTheory

namespace Koszul

variable {R : Type*} [CommRing R] {r : ℕ}

/-- **The Koszul complex of a sequence generating the unit ideal has no homology.** The ideal
generated by the sequence annihilates every homology module of its Koszul complex
(Stacks 0663); if that ideal is `⊤` then `1` annihilates the module, so the module is zero. -/
public theorem isZero_homology_seqComplex_of_span_eq_top (f : Fin r → R)
    (hf : Ideal.span (Set.range f) = ⊤) (n : ℕ) :
    Limits.IsZero ((Koszul.seqComplex f).homology n) := by
  rw [ModuleCat.isZero_iff_subsingleton]
  have hann : Ideal.span (Set.range f) ≤
      Module.annihilator R ((Koszul.seqComplex f).homology n) :=
    (koszulSeq_smul_nullHomotopic_and_span_le_annihilator f).2 n
  have hone : (1 : R) ∈ Module.annihilator R ((Koszul.seqComplex f).homology n) :=
    hann (hf ▸ Submodule.mem_top)
  have hzero : ∀ x : ((Koszul.seqComplex f).homology n), x = 0 := fun x => by
    simpa using Module.mem_annihilator.mp hone x
  exact ⟨fun x y => by rw [hzero x, hzero y]⟩

/-- **The Koszul complex of a sequence generating the unit ideal is acyclic.** -/
public theorem acyclic_seqComplex_of_span_eq_top (f : Fin r → R)
    (hf : Ideal.span (Set.range f) = ⊤) :
    (Koszul.seqComplex f).Acyclic := fun n => by
  rw [HomologicalComplex.exactAt_iff_isZero_homology]
  exact isZero_homology_seqComplex_of_span_eq_top f hf n

/-- **The Koszul complex of a sequence one of whose entries is a unit is acyclic.** This is the
algebraic reason the sheafified Koszul complex of `f₁, …, f_r` vanishes on each principal open
`D(f_i)`: there the entry `f_i` is invertible. -/
public theorem acyclic_seqComplex_of_isUnit (f : Fin r → R) {i : Fin r} (hi : IsUnit (f i)) :
    (Koszul.seqComplex f).Acyclic :=
  acyclic_seqComplex_of_span_eq_top f
    (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨i, rfl⟩) hi)

end Koszul

end
