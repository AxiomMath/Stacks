module

public import StacksFrontier.RingTheory.Koszul.KoszulQCDerivedComplete
public import StacksFrontier.RingTheory.Koszul.WeaklyProregularQuasiCoherentChain
public import StacksFrontier.RingTheory.Koszul.WeaklyProregularCycles
public import StacksCore.Tactic.StacksAttribute

/-!
# Derived complete complexes and quasi-coherent modules over the quotient and Koszul towers

Let `R` be a Noetherian ring and `I ⊆ R` an ideal, generated by `f₁, …, f_r`. Let `𝒜` be the sheaf
of `R`-algebras `n ↦ R / I^{n+1}` and `ℬ` the sheaf of differential graded `R`-algebras
`n ↦ K_{n+1}` of Koszul algebras on `f₁^{n+1}, …, f_r^{n+1}`, on the chaotic site of the natural
numbers. Then `QC(𝒜)`, `QC(ℬ)` and the full subcategory `D_comp(R, I)` of derived complete
objects of `D(R)` are canonically equivalent (Proposition 0GZK).

## Main definitions

* `Koszul.derivedCompleteObjects I`: the derived complete objects of `D(R)`.
* `Koszul.idealPowKoszulDerivedCompleteEquivalences`: **Stacks 0GZK**, the equivalences
  `QC(𝒜) ≌ QC(ℬ)` and `QC(ℬ) ≌ D_comp(R, I)`.

## References

* [Stacks Project, Proposition 24.35.4 (Tag 0GZK)](https://stacks.math.columbia.edu/tag/0GZK)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Stacks.PresheafOfModules Stacks.ChaoticSite

universe u

namespace Koszul

open _root_.SheafOfModules _root_.SheafOfModules.DifferentialGradedModule

attribute [local instance 2000] HasDerivedCategory.standard
attribute [local instance] Stacks.SheafOfModules.botWEqualsLocallyBijective

variable {R : Type u} [CommRing R]

/-- **The full subcategory `D_comp(R, I)` of `D(R)`**: the derived complete objects. -/
abbrev derivedCompleteObjects (I : Ideal R) : ObjectProperty (DerivedCategory (ModuleCat.{u} R)) :=
  fun X => IsDerivedComplete I X

/-- **Stacks 0GZK.** Let `R` be a Noetherian ring and `I ⊆ R` an ideal, with generators
`f₁, …, f_r`. Let `𝒜` be the sheaf of `R`-algebras on the chaotic site of the natural numbers of
the inverse system `R / I ^ n`, and `ℬ` the sheaf of differential graded `R`-algebras of the
inverse system of Koszul algebras on `f₁ ^ n, …, f_r ^ n` (both indexed so that the stage `n`
carries the exponent `n + 1`). Then the three categories `QC(𝒜)`, `QC(ℬ)` and the full
subcategory `D_comp(R, I)` of derived complete objects of `D(R)` are canonically equivalent:
`QC(𝒜) ≌ QC(ℬ)` along the pro-isomorphisms of the quotient and Koszul–Tate systems and the
quasi-isomorphism of the Tate resolution (Tags 0GZH, 0GZF, 0GZ5), and `QC(ℬ) ≌ D_comp(R, I)` by the
derived global sections, with quasi-inverse `K ↦ K ⊗^𝐋_R ℬ`. -/
@[stacks 0GZK]
def idealPowKoszulDerivedCompleteEquivalences [IsNoetherianRing R] (I : Ideal R) {r : ℕ}
    (f : Fin r → R) (generators : Ideal.span (Set.range f) = I) :
    ((Chaotic.QC (liftedIdealPowSheafAlgebra.{u} I)).FullSubcategory ≌
      (Chaotic.QC (liftedPowSheafAlgebra.{u} f)).FullSubcategory) ×
    ((Chaotic.QC (liftedPowSheafAlgebra.{u} f)).FullSubcategory ≌
      (derivedCompleteObjects I).FullSubcategory) := by
  subst generators
  exact ⟨(idealPowKoszulQCEquivalence f (isWeaklyProregular_of_isNoetherianRing f)).equivalence,
    (derivedCompleteQCEquivalence f).symm⟩

/-- The equivalence `QC(ℬ) ≌ D_comp(R, I)` of Stacks 0GZK is the derived global sections. -/
theorem idealPowKoszulDerivedCompleteEquivalences_snd_functor_obj [IsNoetherianRing R] {r : ℕ}
    (f : Fin r → R) (M : (Chaotic.QC (liftedPowSheafAlgebra.{u} f)).FullSubcategory) :
    (((idealPowKoszulDerivedCompleteEquivalences _ f rfl).2.functor.obj M).obj) =
      (derivedGlobalSections R (liftedPowSheafAlgebra f)).obj M.obj :=
  rfl

/-- The quasi-inverse of the equivalence `QC(ℬ) ≌ D_comp(R, I)` of Stacks 0GZK is the derived
extension of scalars `K ↦ K ⊗^𝐋_R ℬ`. -/
theorem idealPowKoszulDerivedCompleteEquivalences_snd_inverse_obj [IsNoetherianRing R] {r : ℕ}
    (f : Fin r → R) (X : (derivedCompleteObjects (Ideal.span (Set.range f))).FullSubcategory) :
    (((idealPowKoszulDerivedCompleteEquivalences _ f rfl).2.inverse.obj X).obj) =
      (derivedExtend (extendInvertsQuasiIso f)).obj X.obj :=
  rfl

end Koszul

end
