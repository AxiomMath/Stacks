module

public import Mathlib.Algebra.Category.Grp.Zero
public import Mathlib.Algebra.Homology.QuasiIso
public import Mathlib.Algebra.Homology.ShortComplex.Ab
public import Mathlib.LinearAlgebra.ExteriorPower.Basis
public import StacksFrontier.Algebra.Homology.Koszul.ContragredientComplex
public import StacksFrontier.RingTheory.Koszul.DualExactness

/-!
# Self-duality of the Koszul complex of a sequence

Let `f₁, …, f_r` be elements of a commutative ring `R` and `K_•` their Koszul complex, with
`⋀ⁿ Rʳ` in degree `n`. Through the perfect wedge pairing of
`StacksFrontier.RingTheory.Koszul.DualExactness`, `Hⁿ(Hom_R(K_•, R)) = 0` for `n < r` when the
sequence is Koszul-regular, and in top degree `H^r(Hom_R(K_•, R)) ⟶ H^r(Hom_R(K_•, M))` is an
isomorphism for `M = R/(f₁, …, f_r)`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Module Set Set.powersetCard
open scoped ExteriorAlgebra

namespace Koszul

universe u

variable {R : Type u} [CommRing R]

/-- The standard basis of `⋀ᵃ Rᴺ`, indexed by the `a`-element subsets of `Fin N`. -/
abbrev stdBasis (N a : ℕ) : Basis (powersetCard (Fin N) a) R (⋀[R]^a (Fin N → R)) :=
  (Pi.basisFun R (Fin N)).exteriorPower a

section Exactness

variable {N : ℕ} (f : Fin N → R)

/-- The differential of the dual Koszul complex, as precomposition. -/
theorem koszulHomComplex_seqComplex_d_apply (M : ModuleCat.{u} R) (n : ℕ)
    (ψ : (seqComplex f).X n →ₗ[R] M) :
    ((koszulHomComplex (seqComplex f) M).d n (n + 1)).hom ψ = ψ ∘ₗ d (seqDual f) n := by
  rw [koszulHomComplex_d]
  show ψ.comp ((seqComplex f).d (n + 1) n).hom = _
  rw [seqComplex_d]
  rfl
/-- **The dual Koszul complex is exact in degree zero**: for a Koszul-regular sequence of positive
length a functional on `⋀⁰` killing the boundaries vanishes. -/
theorem eq_zero_of_comp_d_eq_zero (hf : IsKoszulRegular f) (hN : 0 < N)
    (ψ : ⋀[R]^0 (Fin N → R) →ₗ[R] R) (hψ : ψ ∘ₗ d (seqDual f) 0 = 0) : ψ = 0 :=
  dual_d_zero_eq_zero f hf hN ψ hψ

/-- **The dual Koszul complex is exact in positive degrees below `N`**: for a Koszul-regular
sequence of length `N` and `m + 1 < N`, a functional on `⋀^{m+1}` killing the boundaries is the
transpose of the differential applied to a functional on `⋀ᵐ`. -/
theorem exists_comp_d_eq (hf : IsKoszulRegular f) {m : ℕ} (hm : m + 1 < N)
    (ψ : ⋀[R]^(m + 1) (Fin N → R) →ₗ[R] R) (hψ : ψ ∘ₗ d (seqDual f) (m + 1) = 0) :
    ∃ χ : ⋀[R]^m (Fin N → R) →ₗ[R] R, χ ∘ₗ d (seqDual f) m = ψ :=
  exists_dual_d_eq_of_comp_eq_zero f hf hm ψ hψ

/-- **The dual of the Koszul complex of a Koszul-regular sequence of length `N` is exact below
degree `N`**: `Hⁿ(Hom_R(K_•(f), R)) = 0` for `n < N`. -/
theorem exactAt_koszulHomComplex_self (hf : IsKoszulRegular f) {n : ℕ} (hn : n < N) :
    (koszulHomComplex (seqComplex f) (ModuleCat.of R R)).ExactAt n := by
  cases n with
  | zero =>
    rw [HomologicalComplex.exactAt_iff' _ 0 0 1 (by simp) (by simp),
      ShortComplex.ab_exact_iff]
    intro ψ hψ
    have h0 := dual_d_zero_eq_zero f hf hn ψ
      ((koszulHomComplex_seqComplex_d_apply ..).symm.trans hψ)
    exact ⟨0, by rw [map_zero]; exact h0.symm⟩
  | succ m =>
    rw [HomologicalComplex.exactAt_iff' _ m (m + 1) (m + 1 + 1) (by simp) (by simp),
      ShortComplex.ab_exact_iff]
    intro ψ hψ
    obtain ⟨χ, hχ⟩ := exists_dual_d_eq_of_comp_eq_zero f hf hn ψ
      ((koszulHomComplex_seqComplex_d_apply ..).symm.trans hψ)
    exact ⟨χ, (koszulHomComplex_seqComplex_d_apply ..).trans hχ⟩
end Exactness

/-! ### The top degree -/

section Top

variable {M : Type*} [AddCommGroup M] [Module R M] {b : ℕ}

/-- **The dual Koszul complex in top degree, against a quotient.** Let `π : R ⟶ M` be a linear
map whose kernel is the ideal generated by the sequence `g`. A functional on the top exterior
power `⋀^{b+1}` whose image under `π` vanishes is the transpose of the differential applied to
a functional on `⋀ᵇ`. -/
theorem exists_comp_d_eq_of_comp_eq_zero (g : Fin (b + 1) → R) (π : R →ₗ[R] M)
    (hπ : LinearMap.ker π = Ideal.span (Set.range g))
    (ψ : ⋀[R]^(b + 1) (Fin (b + 1) → R) →ₗ[R] R) (hψ : π ∘ₗ ψ = 0) :
    ∃ χ : ⋀[R]^b (Fin (b + 1) → R) →ₗ[R] R, χ ∘ₗ d (seqDual g) b = ψ :=
  (mem_span_iff_exists_dual_d_eq g ψ).1 fun x => by
    rw [← hπ, LinearMap.mem_ker]
    exact LinearMap.congr_fun hψ x

/-- The transpose of the Koszul differential vanishes against a module killed by the sequence. -/
theorem comp_d_eq_zero_of_smul (g : Fin (b + 1) → R) {k : ℕ}
    (ψ : ⋀[R]^k (Fin (b + 1) → R) →ₗ[R] M)
    (hM : ∀ (i : Fin (b + 1)) (m : M), g i • m = 0) : ψ ∘ₗ d (seqDual g) k = 0 := by
  refine LinearMap.ext_on_range (exteriorPower.ιMulti_span R (k + 1) (M := Fin (b + 1) → R))
    fun v => ?_
  have hd : d (seqDual g) k (exteriorPower.ιMulti R (k + 1) v) =
      ∑ j : Fin (k + 1), ((-1 : R) ^ j.val * seqDual g (v j)) •
        exteriorPower.ιMulti R k (v ∘ j.succAbove) := by
    refine Subtype.ext ?_
    rw [d_apply_coe, exteriorPower.ιMulti_apply_coe, contraction_ιMulti]
    simp
  rw [LinearMap.comp_apply, LinearMap.zero_apply, hd, map_sum]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [map_smul, seqDual_apply, mul_comm, mul_smul, Finset.sum_smul,
    Finset.sum_eq_zero (fun i _ => by rw [mul_smul, hM, smul_zero])]

/-- The terms of the dual Koszul complex above the length vanish. -/
theorem isZero_koszulHomComplex_X_of_lt (g : Fin b → R) (M : ModuleCat.{u} R) {k : ℕ}
    (hk : b < k) : IsZero ((koszulHomComplex (seqComplex g) M).X k) := by
  have : Subsingleton (⋀[R]^k (Fin b → R)) :=
    exteriorPower.subsingleton_of_span_eq_top_of_card_lt
      (Pi.basisFun R (Fin b)) (Pi.basisFun R _).span_eq _ (by simpa using hk)
  have : Subsingleton (⋀[R]^k (Fin b → R) →ₗ[R] M) :=
    ⟨fun ψ₁ ψ₂ => LinearMap.ext fun x => by rw [Subsingleton.elim x 0, map_zero, map_zero]⟩
  exact AddCommGrpCat.isZero_of_subsingleton (AddCommGrpCat.of (⋀[R]^k (Fin b → R) →ₗ[R] M))

/-- **The dual Koszul complex against a quotient, in top degree.** For `π : R ⟶ M` surjective
with kernel the ideal generated by the sequence, the induced map
`H^{b+1}(Hom_R(K_•, R)) ⟶ H^{b+1}(Hom_R(K_•, M))` is an isomorphism. -/
theorem quasiIsoAt_koszulHomComplexMap_top (g : Fin (b + 1) → R) {M : ModuleCat.{u} R}
    (π : ModuleCat.of R R ⟶ M) (hsurj : Function.Surjective π.hom)
    (hker : LinearMap.ker π.hom = Ideal.span (Set.range g)) :
    QuasiIsoAt (koszulHomComplexMap (seqComplex g) π) (b + 1) := by
  have hM : ∀ (i : Fin (b + 1)) (m : M), g i • m = 0 := by
    intro i m
    obtain ⟨s, rfl⟩ := hsurj m
    rw [← map_smul, smul_eq_mul, ← LinearMap.mem_ker, hker]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  rw [quasiIsoAt_iff' _ b (b + 1) (b + 1 + 1) (by simp) (by simp)]
  refine (ShortComplex.quasiIso_iff_of_zeros' _ ?_ ?_ ?_).mpr ⟨?_, ?_⟩
  · exact (isZero_koszulHomComplex_X_of_lt g _ (by omega)).eq_of_tgt _ _
  · refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun ψ => ?_)
    exact (koszulHomComplex_seqComplex_d_apply ..).trans (comp_d_eq_zero_of_smul g ψ hM)
  · exact (isZero_koszulHomComplex_X_of_lt g _ (by omega)).eq_of_tgt _ _
  · rw [ShortComplex.ab_exact_iff]
    intro ψ hψ
    obtain ⟨χ, hχ⟩ := exists_comp_d_eq_of_comp_eq_zero g π.hom hker ψ hψ
    exact ⟨χ, (koszulHomComplex_seqComplex_d_apply ..).trans hχ⟩
  · rw [AddCommGrpCat.epi_iff_surjective]
    intro ψ'
    let ψ'' : ⋀[R]^(b + 1) (Fin (b + 1) → R) →ₗ[R] M := ψ'
    refine ⟨(stdBasis (b + 1) (b + 1)).constr R
      (fun s => (hsurj (ψ'' (stdBasis (b + 1) (b + 1) s))).choose), ?_⟩
    show π.hom ∘ₗ _ = ψ''
    refine (stdBasis (b + 1) (b + 1)).ext fun s => ?_
    rw [LinearMap.comp_apply, Basis.constr_basis]
    exact (hsurj _).choose_spec
end Top

end Koszul
