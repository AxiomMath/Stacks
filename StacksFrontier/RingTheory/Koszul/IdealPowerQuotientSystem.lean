module

public import StacksFrontier.Algebra.DifferentialGraded.AlgebraSystemProIso
public import StacksFrontier.RingTheory.Koszul.PowSheafAlgebra
public import Mathlib.RingTheory.Finiteness.Ideal

/-!
# The quotients by the powers of an ideal and by the ideals of powers of its generators

Let `I` be the ideal of a commutative ring `R` generated by `f₁, …, f_r`. The two inverse systems
of quotients `(R / I ^ n)` and `(R / (f₁ ^ n, …, f_r ^ n))` are pro-isomorphic:
`(f₁ ^ n, …, f_r ^ n)` is contained in `I ^ n`, and since `I` is finitely generated and contained
in the radical of `(f₁ ^ n, …, f_r ^ n)`, some power of `I` is contained in `(f₁ ^ n, …, f_r ^ n)`.
This holds for any finitely generated ideal, with no Noetherian hypothesis.

Here both systems are read as inverse systems of differential graded `R`-algebras concentrated in
degree zero, indexed by `ℕᵒᵖ` with the stage `n` carrying the exponent `n + 1`.

## Main definitions

* `Koszul.idealPowQuotientAlgebraDiagram`: the system `(R / I ^ (n + 1))`.
* `Koszul.powQuotientToIdealPow`: the canonical morphism `(R / (f₁ ^ (n+1), …)) → (R / I ^ (n+1))`.
* `Koszul.idealPowReindex`: a monotone reindexing `m` with `I ^ (m n + 1) ⊆ (f₁ ^ (n+1), …)`.
* `Koszul.powQuotientIdealPowProIso`: **the pro-isomorphism of the two systems.**

## Main results

* `Koszul.powIdeal_le_pow`: `(f₁ ^ n, …, f_r ^ n) ⊆ I ^ n`.
* `Koszul.exists_pow_le_powIdeal`: some power of `I` lies in `(f₁ ^ n, …, f_r ^ n)`.

## References

* [Stacks Project, Proposition 24.35.4 (Tag 0GZK)](https://stacks.math.columbia.edu/tag/0GZK)
* [Stacks Project, Remark 24.35.5 (Tag 0H1E)](https://stacks.math.columbia.edu/tag/0H1E)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe u

namespace Koszul

variable {R : Type u} [CommRing R] {r : ℕ}

/-- The ideal of `n`-th powers of the generators of `I` lies in `I ^ n`. -/
theorem powIdeal_le_pow (f : Fin r → R) (n : ℕ) :
    powIdeal f n ≤ Ideal.span (Set.range f) ^ n := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  exact Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) n

/-- **Some power of `I` lies in the ideal of `n`-th powers of its generators.** The ideal `I` is
finitely generated and contained in the radical of `(f₁ ^ n, …, f_r ^ n)`. -/
theorem exists_pow_le_powIdeal (f : Fin r → R) (n : ℕ) :
    ∃ m : ℕ, Ideal.span (Set.range f) ^ m ≤ powIdeal f n := by
  refine Ideal.exists_pow_le_of_le_radical_of_fg ?_ (Submodule.fg_span (Set.finite_range f))
  refine Ideal.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  exact ⟨n, Ideal.subset_span ⟨i, rfl⟩⟩

/-- The quotients `R / I ^ (n + 1)` in degree zero, as an inverse system of differential graded
algebras indexed by `ℕᵒᵖ` with the stage `n` carrying the exponent `n + 1`. -/
def idealPowQuotientAlgebraDiagram (I : Ideal R) : ℕᵒᵖ ⥤ DifferentialGradedAlgebra.{u, u} R where
  obj n := DifferentialGradedAlgebra.degreeZero R (R ⧸ I ^ (n.unop + 1))
  map {_ _} g := DifferentialGradedAlgebra.degreeZeroHom
    (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right (Nat.succ_le_succ (leOfHom g.unop))))
  map_id _ := DifferentialGradedAlgebra.hom_eq_of_toAlgebraHom_eq (by
    refine AlgHom.ext fun x => ?_
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rfl)
  map_comp {_ _ _} _ _ := DifferentialGradedAlgebra.hom_eq_of_toAlgebraHom_eq (by
    refine AlgHom.ext fun x => ?_
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    rfl)

/-- Two homomorphisms of degree-zero differential graded algebras out of a quotient of `R` agree
as soon as they are both `R`-algebra homomorphisms: a quotient of `R` has a unique `R`-algebra
homomorphism to any `R`-algebra. -/
theorem degreeZero_quotient_hom_ext {J : Ideal R} {S : Type u} [Ring S] [Algebra R S]
    (φ ψ : DifferentialGradedAlgebra.degreeZero R (R ⧸ J) ⟶
      DifferentialGradedAlgebra.degreeZero R S) :
    φ = ψ :=
  DifferentialGradedAlgebra.hom_eq_of_toAlgebraHom_eq (Ideal.Quotient.algHom_ext R
    (AlgHom.ext fun x => by
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
        ← Ideal.Quotient.algebraMap_eq, AlgHom.commutes, AlgHom.commutes]))

/-- The canonical morphism from the quotients by the ideals of powers of the generators to the
quotients by the powers of the ideal they generate. -/
def powQuotientToIdealPow (f : Fin r → R) :
    powQuotientAlgebraDiagram f ⟶ idealPowQuotientAlgebraDiagram (Ideal.span (Set.range f)) where
  app n := DifferentialGradedAlgebra.degreeZeroHom
    (Ideal.Quotient.factorₐ R (powIdeal_le_pow f (n.unop + 1)))
  naturality _ _ _ := degreeZero_quotient_hom_ext _ _

/-- A monotone choice of exponents `m n ≥ n` with `I ^ (m n + 1)` contained in the ideal of
`(n + 1)`-st powers of the generators. -/
def idealPowReindex (f : Fin r → R) : ℕ → ℕ
  | 0 => (exists_pow_le_powIdeal f 1).choose
  | n + 1 => max (n + 1) (max (idealPowReindex f n) (exists_pow_le_powIdeal f (n + 2)).choose)

/-- The power `I ^ (idealPowReindex f n + 1)` is contained in the ideal of `(n + 1)`-st powers of
the generators of `I`. -/
theorem idealPowReindex_spec (f : Fin r → R) (n : ℕ) :
    Ideal.span (Set.range f) ^ (idealPowReindex f n + 1) ≤ powIdeal f (n + 1) := by
  cases n with
  | zero =>
    exact (Ideal.pow_le_pow_right (Nat.le_succ _)).trans (exists_pow_le_powIdeal f 1).choose_spec
  | succ n =>
    refine (Ideal.pow_le_pow_right ?_).trans (exists_pow_le_powIdeal f (n + 2)).choose_spec
    simp only [idealPowReindex]
    omega

/-- The sequence `idealPowReindex f` does not decrease from `n` to `n + 1`. -/
theorem idealPowReindex_le_succ (f : Fin r → R) (n : ℕ) :
    idealPowReindex f n ≤ idealPowReindex f (n + 1) := by
  simp only [idealPowReindex]
  omega

/-- The exponent `idealPowReindex f n` is at least `n`. -/
theorem le_idealPowReindex (f : Fin r → R) (n : ℕ) : n ≤ idealPowReindex f n := by
  cases n with
  | zero => exact Nat.zero_le _
  | succ n => simp only [idealPowReindex]; omega

/-- The sequence `idealPowReindex f` is monotone. -/
theorem monotone_idealPowReindex (f : Fin r → R) : Monotone (idealPowReindex f) :=
  monotone_nat_of_le_succ (idealPowReindex_le_succ f)

/-- The reindexing `idealPowReindex`, as a functor. -/
def idealPowReindexFunctor (f : Fin r → R) : ℕ ⥤ ℕ := (monotone_idealPowReindex f).functor

/-- **The quotients by the powers of `I` and by the ideals of powers of its generators are
pro-isomorphic.** The representative `(R / (f₁ ^ (n+1), …)) → (R / I ^ (n+1))` is the canonical
morphism, the representative `R / I ^ (m n + 1) → R / (f₁ ^ (n+1), …)` the one given by
`I ^ (m n + 1) ⊆ (f₁ ^ (n+1), …)`, and both composites are transition maps since all maps are
`R`-algebra homomorphisms out of quotients of `R`. -/
def powQuotientIdealPowProIso (f : Fin r → R) :
    DifferentialGradedAlgebra.SystemProIso (powQuotientAlgebraDiagram f)
      (idealPowQuotientAlgebraDiagram (Ideal.span (Set.range f))) where
  F₁ := 𝟭 ℕ
  F₂ := idealPowReindexFunctor f
  hom := powQuotientToIdealPow f
  inv :=
    { app := fun n => DifferentialGradedAlgebra.degreeZeroHom
        (Ideal.Quotient.factorₐ R (idealPowReindex_spec f n.unop))
      naturality := fun _ _ _ => degreeZero_quotient_hom_ext _ _ }
  le₁ := le_idealPowReindex f
  le₂ := le_idealPowReindex f
  hom_inv := fun _ => degreeZero_quotient_hom_ext _ _
  inv_hom := fun _ => degreeZero_quotient_hom_ext _ _

end Koszul
