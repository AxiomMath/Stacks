module

public import Mathlib.Algebra.Category.ModuleCat.Abelian
public import Mathlib.Algebra.Category.ModuleCat.Projective
public import Mathlib.CategoryTheory.Abelian.Projective.Resolution
public import StacksFrontier.RingTheory.Koszul.Relations
public import StacksFrontier.RingTheory.Koszul.Regular

/-!
# The Koszul augmentation is a quasi-isomorphism for a Koszul-regular sequence

The Koszul complex of a sequence `f₁, …, f_r` in a commutative ring augments to the quotient
`A / (f₁, …, f_r)` placed in degree `0`: in degree `0` the augmentation is the quotient map
under the identification of the degree-zero exterior power with the ring, and the image of the
first Koszul differential is exactly the ideal generated by the sequence. That augmentation is
a quasi-isomorphism precisely when the sequence is Koszul-regular, so for such a sequence the
Koszul complex is a projective resolution of the quotient.

## Main definitions

* `Koszul.homologyZeroIso`: the identification of `H₀` of the Koszul complex with the quotient.

## Main results

* `Koszul.koszulAugmentation_homologyMap_zero_isIso`: the degree-zero homology map of the
  augmentation is an isomorphism.
* `Koszul.koszulAugmentation_quasiIso`: the augmentation of a Koszul-regular sequence is a
  quasi-isomorphism.

## References

* [Stacks Project, Tag 0664](https://stacks.math.columbia.edu/tag/0664)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace Koszul

universe u

/-- The degree-zero component of the augmentation is the quotient map. -/
theorem koszulAugmentation_f_zero
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    (Koszul.koszulAugmentation f).f 0 =
      ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
        (exteriorPower.zeroEquiv A (Fin r → A)).toLinearMap) :=
  ChainComplex.toSingle₀Equiv_symm_apply_f_zero _ _

/-- `H₀` of the Koszul complex of `f` is `A / (f₁, …, f_r)`. -/
noncomputable def homologyZeroIso {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    (Koszul.seqComplex f).homology 0 ≅ ModuleCat.of A (A ⧸ Ideal.span (Set.range f)) :=
  (Koszul.seqComplex f).isoHomologyι₀ ≪≫
    (Koszul.seqComplex f).opcyclesIsoSc' 1 0 0
      (ChainComplex.prev ℕ 0) ChainComplex.next_nat_zero ≪≫
    ((Koszul.seqComplex f).sc' 1 0 0).moduleCatOpcyclesIso ≪≫
    (by
      have hd : ((Koszul.seqComplex f).sc' 1 0 0).f =
          ModuleCat.ofHom (Koszul.d (Koszul.seqDual f) 0) := by
        change (Koszul.seqComplex f).d (0 + 1) 0 = _
        exact Koszul.seqComplex_d f 0
      rw [hd]
      change ModuleCat.of A
        ((⋀[A]^0 (Fin r → A)) ⧸ LinearMap.range (Koszul.d (Koszul.seqDual f) 0)) ≅
        ModuleCat.of A (A ⧸ Ideal.span (Set.range f))
      exact (Submodule.Quotient.equiv
        (LinearMap.range (Koszul.d (Koszul.seqDual f) 0))
        (Ideal.span (Set.range f))
        (exteriorPower.zeroEquiv A (Fin r → A)) (Koszul.range_d_zero f)).toModuleIso)

/-- The quotient equivalence underlying `Koszul.homologyZeroIso` sends a class to the class of
its image, by definition. -/
private theorem quotientEquiv_mk {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (x : ⋀[A]^0 (Fin r → A)) :
    Submodule.Quotient.equiv (LinearMap.range (Koszul.d (Koszul.seqDual f) 0))
        (Ideal.span (Set.range f)) (exteriorPower.zeroEquiv A (Fin r → A))
        (Koszul.range_d_zero f) ((LinearMap.range (Koszul.d (Koszul.seqDual f) 0)).mkQ x) =
      (Ideal.span (Set.range f)).mkQ ((exteriorPower.zeroEquiv A (Fin r → A)) x) :=
  rfl

/-- `Koszul.homologyZeroIso`, precomposed with the projection to the opcycles and the inverse
of the degree-zero homology identification, is the quotient map. -/
theorem homologyZeroIso_fac {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    let K := Koszul.seqComplex f
    K.pOpcycles 0 ≫ K.isoHomologyι₀.inv ≫ (homologyZeroIso f).hom =
      ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
        (exteriorPower.zeroEquiv A (Fin r → A)).toLinearMap) := by
  dsimp only
  unfold homologyZeroIso
  simp only [Iso.trans_hom, Iso.inv_hom_id_assoc]
  refine ((Category.assoc _ _ _).symm.trans
    ((HomologicalComplex.pOpcycles_opcyclesIsoSc'_hom (K := Koszul.seqComplex f)
          (i := 1) (j := 0) (k := 0) (ChainComplex.prev ℕ 0)
          ChainComplex.next_nat_zero =≫ _).trans
      ((Category.assoc _ _ _).symm.trans
        (ShortComplex.pOpcycles_comp_moduleCatOpcyclesIso_hom
            ((Koszul.seqComplex f).sc' 1 0 0) =≫ _)))).trans ?_
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  dsimp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply]
  exact quotientEquiv_mk f x

/-- For a complex concentrated in degree `0`, the identification of its homology with its
single term factors through the opcycles. -/
theorem singleZeroHomology_fac {A : Type u} [CommRing A] (Q : ModuleCat.{u} A) :
    let S := (ChainComplex.single₀ (ModuleCat.{u} A)).obj Q
    (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0 Q).hom ≫
      (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℕ) 0 Q).inv =
      S.pOpcycles 0 ≫ S.isoHomologyι₀.inv := by
  dsimp only
  rw [← cancel_mono ((ChainComplex.single₀ (ModuleCat.{u} A)).obj Q).isoHomologyι₀.hom]
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  change (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0 Q).hom ≫
      (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℕ) 0 Q).inv ≫
        ((ChainComplex.single₀ (ModuleCat.{u} A)).obj Q).homologyι 0 =
    ((ChainComplex.single₀ (ModuleCat.{u} A)).obj Q).pOpcycles 0
  rw [HomologicalComplex.singleObjHomologySelfIso_inv_homologyι,
    HomologicalComplex.singleObjOpcyclesSelfIso_hom]
  simp only [Iso.hom_inv_id_assoc]

/-- The degree-zero homology map of the Koszul augmentation is an isomorphism. -/
theorem koszulAugmentation_homologyMap_zero_isIso
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    IsIso (HomologicalComplex.homologyMap (Koszul.koszulAugmentation f) 0) := by
  let K := Koszul.seqComplex f
  let Q := ModuleCat.of A (A ⧸ Ideal.span (Set.range f))
  let L := (ChainComplex.single₀ (ModuleCat.{u} A)).obj Q
  let α := Koszul.koszulAugmentation f
  let V := HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℕ) 0 Q
  have hmap : HomologicalComplex.homologyMap α 0 ≫ V.hom = (homologyZeroIso f).hom := by
    rw [← cancel_epi K.isoHomologyι₀.inv, ← cancel_epi (K.pOpcycles 0),
      ChainComplex.isoHomologyι₀_inv_naturality_assoc, HomologicalComplex.p_opcyclesMap_assoc,
      ← Category.assoc (L.pOpcycles 0) L.isoHomologyι₀.inv V.hom, ← singleZeroHomology_fac Q,
      koszulAugmentation_f_zero]
    simp only [V, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have hself : (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0 Q).hom = 𝟙 Q := rfl
    rw [hself]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change ⋀[A]^0 (Fin r → A) at x
    have hf := congrArg (fun (h : (Koszul.seqComplex f).X 0 ⟶ Q) => h.hom x)
      (homologyZeroIso_fac f)
    change (Ideal.span (Set.range f)).mkQ ((exteriorPower.zeroEquiv A (Fin r → A)) x) =
      (homologyZeroIso f).hom.hom
        ((Koszul.seqComplex f).isoHomologyι₀.inv.hom
          (((Koszul.seqComplex f).pOpcycles 0).hom x))
    dsimp only [Q] at hf
    exact hf.symm
  have hi : IsIso (HomologicalComplex.homologyMap α 0 ≫ V.hom) := by
    rw [hmap]
    infer_instance
  exact IsIso.of_isIso_comp_right _ V.hom

/-- The Koszul augmentation of a Koszul-regular sequence is a quasi-isomorphism. -/
theorem koszulAugmentation_quasiIso
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hf : Koszul.IsKoszulRegular f) : QuasiIso (Koszul.koszulAugmentation f) := by
  refine (quasiIso_iff _).2 fun i ↦ ?_
  rw [quasiIsoAt_iff_isIso_homologyMap]
  by_cases hi : i = 0
  · subst i
    exact koszulAugmentation_homologyMap_zero_isIso f
  · let L := (ChainComplex.single₀ (ModuleCat.{u} A)).obj
      (ModuleCat.of A (A ⧸ Ideal.span (Set.range f)))
    have hX : IsZero (L.X i) := HomologicalComplex.isZero_single_obj_X _ 0 _ i hi
    exact (hf i hi).isIso ((L.sc i).isZero_homology_of_isZero_X₂ hX) _

end Koszul
