module

public import StacksFrontier.RingTheory.Koszul.Concatenation
public import StacksFrontier.RingTheory.Koszul.Quasiregular
public import Mathlib.Algebra.Module.SpanRankOperations
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Module.IdealSmulTop

@[expose] public section

/-!
# Minimal generators of an ideal generated by a regular sequence

Let `A` be a Noetherian local ring and let `J ⊆ A` be an ideal generated by a regular sequence.
This file shows that the regular sequence is a minimal system of generators of `J`, that
conversely every minimal system of generators of `J` is a regular sequence, and that a pair of
nested ideals `I ⊆ J` for which the induced map `I / 𝔪I → J / 𝔪J` of cotangent spaces is
injective can be presented by a single regular sequence generating `J` an initial segment of
which generates `I`.

## Main results

* `Koszul.isRegular_of_ofList_eq_of_length_eq`: two generating lists of the same length of an
  ideal generated by a regular sequence are both regular.
* `Koszul.length_eq_and_isRegular_of_ofList_eq_of_length_le`: a generating list of such an ideal
  is never shorter than the regular sequence, and when its length agrees it is itself regular.
* `Koszul.spanFinrank_eq_length_of_isRegular`: the minimal number of generators of an ideal
  generated by a regular sequence is the length of that sequence.
* `Koszul.exists_isRegular_ofList_eq_of_injective_mapQ_maximalIdeal`: for nested proper ideals
  `I ⊆ J` with `J` generated by a regular sequence and with injective induced map of cotangent
  spaces, both `I` and the image of `J` in `A ⧸ I` are generated by regular sequences.

## Implementation notes

The minimality statements are reductions to Tag 066A, which transfers quasi-regularity between
two generating sequences *of the same length*, and to Tag 09CC, which over a Noetherian local
ring identifies quasi-regularity with regularity. To compare lengths, a short generating list is
padded with zeros up to the length of the regular sequence; the padded list is then regular by
066A and 09CC, which is impossible unless no padding took place, because a weakly regular
sequence cannot contain `0` while the ideal it generates stays proper.

The cotangent space of an ideal `I` is the quotient `I ⧸ 𝔪 • ⊤`, a vector space over
`A ⧸ 𝔪` whose dimension is the minimal number of generators of `I`
(`IsLocalRing.spanFinrank_eq_finrank_quotient`). Injectivity of `I / 𝔪I → J / 𝔪J` makes the
dimensions add up over a complement of the image, so lifting a basis of the image together with
a basis of a complement produces a generating list of `J` of minimal length whose initial
segment generates `I`. Minimal length is exactly what lets the two 066A-based statements apply.

Injectivity on cotangent spaces is the conclusion of Tag 09PV; combining the two gives Tag 09PW.

## References

* [Stacks Project, Tag 066A](https://stacks.math.columbia.edu/tag/066A)
* [Stacks Project, Tag 09CC](https://stacks.math.columbia.edu/tag/09CC)
* [Stacks Project, Tag 09PW](https://stacks.math.columbia.edu/tag/09PW)
-/

namespace Koszul

open RingTheory.Sequence IsLocalRing Submodule

universe u

variable {A : Type u} [CommRing A]

/-- A list generating a proper ideal cannot be continued by `0` to a weakly regular sequence. -/
private lemma not_isWeaklyRegular_append_zero (gs ts : List A) (h : Ideal.ofList gs ≠ ⊤) :
    ¬ IsWeaklyRegular A (gs ++ 0 :: ts) := by
  intro hw
  obtain ⟨-, h2⟩ := (isWeaklyRegular_append_iff A gs (0 :: ts)).mp hw
  obtain ⟨hz, -⟩ := (isWeaklyRegular_cons_iff _ 0 ts).mp h2
  have hsub : Subsingleton (A ⧸ (Ideal.ofList gs • ⊤ : Submodule A A)) :=
    ⟨fun x y => hz (by simp)⟩
  refine h ?_
  have htop := Submodule.Quotient.subsingleton_iff.mp hsub
  rw [Ideal.smul_top_eq_map] at htop
  simpa using htop

omit [CommRing A] in
/-- Reading a list off its indexing function recovers the list. -/
private lemma ofFn_getElem_cast (l : List A) {n : ℕ} (hl : l.length = n) :
    List.ofFn (fun i : Fin n => l[(i.cast hl.symm)]) = l := by
  subst hl
  simp

/-- The span of the entries of a list, read as the span of the range of its indexing function. -/
private lemma span_range_getElem (l : List A) {n : ℕ} (hl : l.length = n) :
    Ideal.span (Set.range (fun i : Fin n => l[(i.cast hl.symm)])) = Ideal.ofList l := by
  unfold Ideal.ofList
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨i, rfl⟩
    exact List.getElem_mem _
  · intro hx
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
    exact ⟨(⟨i, by omega⟩ : Fin n), by simp⟩

/-- The ideal generated by a regular sequence is proper. -/
private lemma ofList_ne_top_of_isRegular {rs : List A} (hreg : IsRegular A rs) :
    Ideal.ofList rs ≠ ⊤ := fun h => hreg.top_ne_smul (by rw [h, Submodule.top_smul])

/-- Over a Noetherian local ring, a list in the maximal ideal is regular iff the family of its
entries is quasi-regular. -/
private lemma isRegular_iff_isQuasiRegular_ofFn_getElem [IsNoetherianRing A] [IsLocalRing A]
    (l : List A) {n : ℕ} (hl : l.length = n) (hle : Ideal.ofList l ≤ maximalIdeal A) :
    IsRegular A l ↔ IsQuasiRegular A (List.ofFn fun i : Fin n => l[(i.cast hl.symm)]) := by
  have := (regular_koszulRegular_h1Regular_quasiRegular_tfae (M := A)
    (fun i : Fin n => l[(i.cast hl.symm)])
    fun i => hle (Ideal.subset_span (List.getElem_mem _))).2.out 1 4
  convert this using 2
  exact (ofFn_getElem_cast l hl).symm

/-- Over a Noetherian local ring, if an ideal is generated by a regular sequence then every
generating list of the same length as that sequence is itself a regular sequence. -/
@[sga "4½ Cycle 2.2.1"]
theorem isRegular_of_ofList_eq_of_length_eq [IsNoetherianRing A] [IsLocalRing A]
    (gs rs : List A) (hlen : gs.length = rs.length)
    (hspan : Ideal.ofList gs = Ideal.ofList rs) (hreg : IsRegular A rs) :
    IsRegular A gs := by
  have hle := IsLocalRing.le_maximalIdeal (ofList_ne_top_of_isRegular hreg)
  have hgq := (isRegular_iff_isQuasiRegular_ofFn_getElem rs rfl hle).mp hreg
  have hfq := (regularity_of_generators_of_eq_span_range (Ideal.ofList gs)
    (fun i : Fin rs.length => gs[(i.cast hlen.symm)]) (span_range_getElem gs hlen)).1
    ⟨fun i : Fin rs.length => rs[(i.cast rfl)], by rw [span_range_getElem rs rfl, hspan], hgq⟩
  exact (isRegular_iff_isQuasiRegular_ofFn_getElem gs hlen (hspan ▸ hle)).mpr hfq

/-- Over a Noetherian local ring, a generating list of an ideal generated by a regular sequence
is no shorter than that regular sequence, and if it has the same length it is itself regular. -/
@[sga "4½ Cycle 2.2.1"]
theorem length_eq_and_isRegular_of_ofList_eq_of_length_le [IsNoetherianRing A] [IsLocalRing A]
    (gs rs : List A) (hlen : gs.length ≤ rs.length)
    (hspan : Ideal.ofList gs = Ideal.ofList rs) (hreg : IsRegular A rs) :
    gs.length = rs.length ∧ IsRegular A gs := by
  set m := rs.length - gs.length with hm
  set fs := gs ++ List.replicate m (0 : A) with hfs
  have hzspan : Ideal.ofList (List.replicate m (0 : A)) = ⊥ := by
    unfold Ideal.ofList
    rw [Ideal.span_eq_bot]
    intro x hx
    simpa using List.eq_of_mem_replicate hx
  have hfsspan : Ideal.ofList fs = Ideal.ofList rs := by
    rw [hfs, Ideal.ofList_append, hzspan, hspan, sup_bot_eq]
  have hfslen : fs.length = rs.length := by
    simp [hfs, hm]
    omega
  have hfsreg : IsRegular A fs :=
    isRegular_of_ofList_eq_of_length_eq fs rs hfslen hfsspan hreg
  have hm0 : m = 0 := by
    by_contra hm0
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hm0
    refine not_isWeaklyRegular_append_zero gs (List.replicate k (0 : A))
      (by rw [hspan]; exact ofList_ne_top_of_isRegular hreg) ?_
    rw [hfs, hk, List.replicate_succ] at hfsreg
    exact hfsreg.1
  refine ⟨by omega, ?_⟩
  rwa [hfs, hm0, List.replicate_zero, List.append_nil] at hfsreg

/-- The minimal number of generators of an ideal generated by a regular sequence over a
Noetherian local ring is the length of that sequence. -/
@[sga "4½ Cycle 2.2.1" "partial"]
theorem spanFinrank_eq_length_of_isRegular [IsNoetherianRing A] [IsLocalRing A]
    (rs : List A) (hreg : IsRegular A rs) :
    (Ideal.ofList rs).spanFinrank = rs.length := by
  classical
  have hfg : (Ideal.ofList rs).FG := IsNoetherian.noetherian _
  obtain ⟨s, hscard, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  have hle : (Ideal.ofList rs).spanFinrank ≤ rs.length := by
    have hset : {r | r ∈ rs} = (rs.toFinset : Set A) := by
      ext x
      simp
    have := Submodule.spanFinrank_span_le_ncard_of_finite
      (R := A) (s := {r | r ∈ rs}) rs.finite_toSet
    refine this.trans ?_
    rw [hset, Set.ncard_coe_finset]
    exact rs.toFinset_card_le
  have hgsspan : Ideal.ofList s.toList = Ideal.ofList rs := by
    rw [← hsspan]
    unfold Ideal.ofList
    congr 1
    ext x
    simp
  have hgslen : s.toList.length ≤ rs.length := by rwa [Finset.length_toList, hscard]
  have := (length_eq_and_isRegular_of_ofList_eq_of_length_le s.toList rs hgslen hgsspan hreg).1
  rwa [Finset.length_toList, hscard] at this

/-- Over a local ring, a set in a finite module whose image spans the quotient `M ⧸ 𝔪M` over
the residue field spans the module. -/
private theorem span_eq_top_of_span_image_mkQ_eq_top [IsLocalRing A] {M : Type*} [AddCommGroup M]
    [Module A M] [Module.Finite A M] (S : Set M)
    (h : Submodule.span (A ⧸ maximalIdeal A)
      ((maximalIdeal A • (⊤ : Submodule A M)).mkQ '' S) = ⊤) :
    Submodule.span A S = ⊤ := by
  rw [← IsLocalRing.map_mkQ_eq_top, Submodule.map_span,
    ← Submodule.restrictScalars_span A (A ⧸ maximalIdeal A)
      (Ideal.Quotient.mk_surjective : Function.Surjective (algebraMap A (A ⧸ maximalIdeal A))),
    h, Submodule.restrictScalars_top]

/-- A set of elements of an ideal spanning it as a module generates it as an ideal. -/
private theorem span_image_subtype_eq_of_span_eq_top (I : Ideal A) (S : Set I)
    (h : Submodule.span A S = ⊤) : Ideal.span (I.subtype '' S) = I := by
  have h2 := congrArg (Submodule.map I.subtype) h
  rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h2
  exact h2

/-- Over a Noetherian local ring, a list whose entries are a set of elements of an ideal `I`
spanning the cotangent space `I ⧸ 𝔪I` over the residue field generates `I`. -/
private theorem ofList_eq_of_span_image_mkQ_eq_top [IsNoetherianRing A] [IsLocalRing A]
    (I : Ideal A) (l : List A) (S : Set I) (hl : {r | r ∈ l} = I.subtype '' S)
    (h : Submodule.span (A ⧸ maximalIdeal A)
      ((maximalIdeal A • (⊤ : Submodule A I)).mkQ '' S) = ⊤) :
    Ideal.ofList l = I := by
  unfold Ideal.ofList
  rw [hl]
  exact span_image_subtype_eq_of_span_eq_top I S (span_eq_top_of_span_image_mkQ_eq_top S h)

/-- Nested ideals `I ⊆ J` in a Noetherian local ring whose induced map of cotangent spaces
`I / 𝔪I → J / 𝔪J` is injective admit a generating list of `J` of minimal length whose initial
segment generates `I`. -/
private lemma exists_adapted_generators [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hIJ : I ≤ J)
    (hinj : Function.Injective
      ((maximalIdeal A • (⊤ : Submodule A I)).mapQ
        (maximalIdeal A • (⊤ : Submodule A J)) (Submodule.inclusion hIJ)
        (Submodule.smul_top_le_comap_smul_top _ _))) :
    ∃ xs ys : List A, Ideal.ofList xs = I ∧ Ideal.ofList (xs ++ ys) = J ∧
      (xs ++ ys).length ≤ J.spanFinrank := by
  have : (maximalIdeal A).IsMaximal := maximalIdeal.isMaximal A
  let _ : Field (A ⧸ maximalIdeal A) := Ideal.Quotient.field _
  have hfinI : Module.Finite (A ⧸ maximalIdeal A)
      (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) :=
    Module.Finite.of_restrictScalars_finite A _ _
  have hfinJ : Module.Finite (A ⧸ maximalIdeal A)
      (↥J ⧸ (maximalIdeal A • ⊤ : Submodule A ↥J)) :=
    Module.Finite.of_restrictScalars_finite A _ _
  set φ := (maximalIdeal A • (⊤ : Submodule A I)).mapQ
        (maximalIdeal A • (⊤ : Submodule A J)) (Submodule.inclusion hIJ)
        (Submodule.smul_top_le_comap_smul_top _ _)
  set φk := φ.extendScalarsOfSurjective (Ideal.Quotient.mk_surjective (I := maximalIdeal A))
  obtain ⟨q, hc⟩ := Submodule.exists_isCompl (LinearMap.range φk)
  set s := Module.finrank (A ⧸ maximalIdeal A) (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) with hs
  set t := Module.finrank (A ⧸ maximalIdeal A) q with ht
  have hpVI : Module.finrank (A ⧸ maximalIdeal A) (LinearMap.range φk) = s :=
    (LinearEquiv.ofInjective φk hinj).finrank_eq.symm
  let bI := Module.finBasisOfFinrankEq (A ⧸ maximalIdeal A)
      (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) hs.symm
  let bq := Module.finBasisOfFinrankEq (A ⧸ maximalIdeal A) q ht.symm
  choose uI huI using fun i : Fin s =>
    Submodule.mkQ_surjective (maximalIdeal A • (⊤ : Submodule A ↥I)) (bI i)
  choose uJ huJ using fun j : Fin t =>
    Submodule.mkQ_surjective (maximalIdeal A • (⊤ : Submodule A ↥J)) (q.subtype (bq j))
  refine ⟨List.ofFn (fun i : Fin s => ((uI i : A))),
    List.ofFn (fun j : Fin t => ((uJ j : A))), ?_, ?_, ?_⟩
  · refine ofList_eq_of_span_image_mkQ_eq_top I _ (Set.range uI) ?_ ?_
    · ext x
      simp
    · rw [← Set.range_comp,
        show (Submodule.mkQ (maximalIdeal A • (⊤ : Submodule A ↥I))) ∘ uI = bI from
          funext huI,
        bI.span_eq]
  · set vI : Fin s → ↥J := fun i => Submodule.inclusion hIJ (uI i) with hvI
    have e1 : (Submodule.mkQ (maximalIdeal A • (⊤ : Submodule A ↥J))) ∘ vI = φk ∘ bI :=
      funext fun i => congrArg φ (huI i)
    have e2 : (Submodule.mkQ (maximalIdeal A • (⊤ : Submodule A ↥J))) ∘ uJ = q.subtype ∘ bq :=
      funext huJ
    refine ofList_eq_of_span_image_mkQ_eq_top J _ (Set.range vI ∪ Set.range uJ) ?_ ?_
    · rw [Set.image_union, ← Set.range_comp, ← Set.range_comp]
      ext x
      simp [hvI]
    · rw [Set.image_union, ← Set.range_comp, ← Set.range_comp, e1, e2, Set.range_comp,
        Set.range_comp, Submodule.span_union, ← Submodule.map_span, ← Submodule.map_span,
        bI.span_eq, bq.span_eq, Submodule.map_top, Submodule.map_top, Submodule.range_subtype]
      exact hc.sup_eq_top
  · rw [List.length_append, List.length_ofFn, List.length_ofFn,
      IsLocalRing.spanFinrank_eq_finrank_quotient J (IsNoetherian.noetherian _), ← hpVI]
    exact (Submodule.finrank_add_eq_of_isCompl hc).le

/-- Let `I ⊆ J` be proper ideals of a Noetherian local ring `A` such that the induced map
`I / 𝔪I → J / 𝔪J` of cotangent spaces is injective and `J` is generated by a regular sequence.
Then `I` is generated by a regular sequence, and the image of `J` in `A ⧸ I` is generated by a
regular sequence of `A ⧸ I`. -/
theorem exists_isRegular_ofList_eq_of_injective_mapQ_maximalIdeal
    [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hI : I ≠ ⊤) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hinj : Function.Injective
      ((maximalIdeal A • (⊤ : Submodule A I)).mapQ
        (maximalIdeal A • (⊤ : Submodule A J)) (Submodule.inclusion hIJ)
        (Submodule.smul_top_le_comap_smul_top _ _)))
    (hreg : ∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = J) :
    (∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = I) ∧
      (∃ qs : List (A ⧸ I), IsRegular (A ⧸ I) qs ∧
        Ideal.ofList qs = J.map (Ideal.Quotient.mk I)) := by
  obtain ⟨rs, hrs, hrsJ⟩ := hreg
  obtain ⟨xs, ys, hxsI, hxysJ, hlen⟩ := exists_adapted_generators I J hIJ hinj
  rw [← hrsJ, spanFinrank_eq_length_of_isRegular rs hrs] at hlen
  obtain ⟨-, hregfs⟩ := length_eq_and_isRegular_of_ofList_eq_of_length_le (xs ++ ys) rs
    hlen (hxysJ.trans hrsJ.symm) hrs
  obtain ⟨hw1, hw2⟩ := (isWeaklyRegular_append_iff A xs ys).mp hregfs.1
  have hmapJ : Ideal.ofList (ys.map (Ideal.Quotient.mk I)) = J.map (Ideal.Quotient.mk I) := by
    rw [← Ideal.map_ofList, ← hxysJ, Ideal.ofList_append, Ideal.map_sup, hxsI,
      Ideal.map_quotient_self, bot_sup_eq]
  have hJne : J.map (Ideal.Quotient.mk I) ≠ ⊤ := by
    intro htop
    refine hJ ?_
    have h := congrArg (Ideal.comap (Ideal.Quotient.mk I)) htop
    rwa [Ideal.comap_map_mk hIJ, Ideal.comap_top] at h
  refine ⟨⟨xs, (isRegular_iff A xs).mpr ⟨hw1, ?_⟩, hxsI⟩,
    ys.map (Ideal.Quotient.mk I), (isRegular_iff (A ⧸ I) _).mpr ⟨?_, ?_⟩, hmapJ⟩
  · rw [Ideal.smul_top_eq_self, hxsI]
    exact hI.symm
  · refine (isWeaklyRegular_map_algebraMap_iff (A ⧸ I) (A ⧸ I) ys).mpr ?_
    rw [← hxsI]
    exact ((Submodule.quotEquivOfEq (Ideal.ofList xs • (⊤ : Submodule A A))
      (Ideal.ofList xs) (Ideal.smul_top_eq_self _)).isWeaklyRegular_congr ys).mp hw2
  · rw [Ideal.smul_top_eq_self, hmapJ]
    exact hJne.symm

end Koszul

end
