open IsLocalRing

/-- Let `Λ` be a Cohen ring whose residue field has characteristic `p`, so that `p` is a
uniformizer of `Λ`. For every `n` the ring map `ℤ/pⁿℤ → Λ/pⁿΛ` is formally smooth
(Stacks 0329). -/
@[stacks 0329 "The source's `p > 0` prime and `p` a uniformizer are consequences of \
  `CharP (ResidueField Λ) p` for a Cohen ring, so only the latter is assumed, and `n ≥ 1` is \
  dropped because `n = 0` gives the zero ring on both sides. The `ZMod (p ^ n)`-algebra \
  structure is assumed rather than synthesized; it is unique where it exists, so this pins the \
  source's map `ℤ/pⁿℤ → Λ/pⁿΛ`. See the module docstring."]
public theorem IsCohenRing.formallySmooth_quotient_span_pow (p n : ℕ) (Λ : Type*) [CommRing Λ]
    [IsDomain Λ] [IsCohenRing Λ] [CharP (ResidueField Λ) p]
    [Algebra (ZMod (p ^ n)) (Λ ⧸ Ideal.span {(p : Λ) ^ n})] :
    Algebra.FormallySmooth (ZMod (p ^ n)) (Λ ⧸ Ideal.span {(p : Λ) ^ n}) :=
      by apply Stacks.RingTheory.CohenFormalSmoothness.solution

end
