namespace Stacks.RingTheory.CohenFormalSmoothness

open IsLocalRing

/-! ### Extensions of perfect fields -/


/-! ### Characteristic zero and flatness over `𝐙` -/

/-- A domain in which the prime number `p` is neither zero nor a unit has characteristic zero:
a positive characteristic is a prime `q`, and `q = p` makes `p` zero while `q ≠ p` makes it a unit,
`p` and `q` being coprime. -/
private theorem charZero_of_prime {R : Type*} [CommRing R] [IsDomain R] {p : ℕ} (hp : p.Prime)
    (h0 : (p : R) ≠ 0) (hu : ¬ IsUnit (p : R)) : CharZero R :=
  (CharP.exists' R).resolve_right <| by
    rintro ⟨q, ⟨hq⟩, _⟩
    rcases eq_or_ne p q with rfl | hne
    · exact h0 (CharP.cast_eq_zero R p)
    · exact hu (isCoprime_zero_right.mp
        (CharP.cast_eq_zero R q ▸ ((Nat.coprime_primes hp hq).mpr hne).cast))

/-- A discrete valuation ring whose maximal ideal is generated by a prime number has
characteristic zero: a generator of the maximal ideal is a nonzero non-unit. -/
private theorem charZero_of_maximalIdeal_eq_span {p : ℕ} {Λ : Type*} [CommRing Λ] [IsDomain Λ]
    [IsDiscreteValuationRing Λ] (hp : p.Prime) (hm : maximalIdeal Λ = Ideal.span {(p : Λ)}) :
    CharZero Λ :=
  charZero_of_prime hp
    (fun h => IsDiscreteValuationRing.not_a_field Λ (by rw [hm, h, Ideal.span_singleton_eq_bot]))
    (fun h => notMem_maximalIdeal.mpr h (hm ▸ Ideal.mem_span_singleton_self _))

/-- Let `Λ` be a flat `𝐙`-module. Every ring map `𝐙/k𝐙 → Λ/kΛ` is flat, its target being the base
change `Λ ⊗_𝐙 𝐙/k𝐙` of the flat module `Λ`. -/
private theorem flat_zmod_of_flat_int {Λ : Type*} [CommRing Λ] [Module.Flat ℤ Λ] {k : ℕ}
    {J : Ideal Λ} (hJ : J = Ideal.span {(k : Λ)}) : ∀ φ : ZMod k →+* Λ ⧸ J, φ.Flat := by
  have h : J = Ideal.map (algebraMap ℤ Λ) (Ideal.span {(k : ℤ)}) := by
    rw [hJ, Ideal.map_span, Set.image_singleton]
    norm_num
  subst h
  set I₀ := Ideal.span {(k : ℤ)}
  intro φ
  let := φ.toAlgebra
  rw [← φ.algebraMap_toAlgebra, RingHom.flat_algebraMap_iff]
  have : Module.Flat (ℤ ⧸ I₀) (Λ ⧸ Ideal.map (algebraMap ℤ Λ) I₀) :=
    Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor Λ I₀).toLinearEquiv
  let e : ZMod k ≃+* (ℤ ⧸ I₀) := (Int.quotientSpanNatEquivZMod k).symm
  let : Algebra (ZMod k) (ℤ ⧸ I₀) := (e : ZMod k →+* (ℤ ⧸ I₀)).toAlgebra
  have hbij : Function.Bijective (algebraMap (ZMod k) (ℤ ⧸ I₀)) := by
    rw [RingHom.algebraMap_toAlgebra]
    exact e.bijective
  have : Module.Flat (ZMod k) (ℤ ⧸ I₀) := Module.Flat.of_linearEquiv
    (LinearEquiv.ofBijective (Algebra.linearMap (ZMod k) (ℤ ⧸ I₀)) hbij).symm
  have : IsScalarTower (ZMod k) (ℤ ⧸ I₀) (Λ ⧸ Ideal.map (algebraMap ℤ Λ) I₀) :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext_zmod _ _)
  exact Module.Flat.trans (ZMod k) (ℤ ⧸ I₀) _

/-! ### The induction -/

/-- The kernel of the reduction `ℤ/bℤ → ℤ/aℤ` is generated by `a`. -/
private theorem ker_castHom {a b : ℕ} [NeZero b] (h : a ∣ b) :
    RingHom.ker (ZMod.castHom h (ZMod a)) = Ideal.span {(a : ZMod b)} := by
  have : NeZero a := ⟨fun ha => (NeZero.ne b) (by simpa [ha] using h)⟩
  refine le_antisymm (fun x hx => ?_) ?_
  · rw [RingHom.mem_ker] at hx
    have hx' : ((x.val : ℕ) : ZMod a) = 0 := by
      rwa [ZMod.natCast_val, ← ZMod.castHom_apply (h := h)]
    obtain ⟨c, hc⟩ := (ZMod.natCast_eq_zero_iff _ _).mp hx'
    rw [Ideal.mem_span_singleton', ← ZMod.natCast_rightInverse x, hc]
    exact ⟨(c : ZMod b), by push_cast; ring⟩
  · simp [Ideal.span_le, Set.singleton_subset_iff, RingHom.mem_ker]

/-- Every ring map to the zero ring is formally smooth. -/
private theorem formallySmooth_of_subsingleton {R S : Type*} [CommRing R] [CommRing S]
    [Subsingleton S] (φ : R →+* S) : φ.FormallySmooth := by
  let := φ.toAlgebra
  exact Algebra.Smooth.formallySmooth

section Induction

variable {p : ℕ} {Λ : Type*} [CommRing Λ]

/-- The case `n = 1`: for a local ring whose maximal ideal is generated by the prime `p`, the ring
`Λ/pΛ` is a field extension of the perfect field `𝐅_p`. -/
@[sga "1 III 1.2" "base F_p, special case"]
private theorem formallySmooth_one [IsLocalRing Λ] (hp : p.Prime)
    (hm : maximalIdeal Λ = Ideal.span {(p : Λ)})
    (φ : ZMod p →+* Λ ⧸ Ideal.span {(p : Λ)}) : φ.FormallySmooth := by
  have : (Ideal.span {(p : Λ)}).IsMaximal := hm ▸ maximalIdeal.isMaximal Λ
  have : Fact p.Prime := ⟨hp⟩
  let : Field (Λ ⧸ Ideal.span {(p : Λ)}) := Ideal.Quotient.field _
  let := φ.toAlgebra
  exact Algebra.formallySmooth_of_perfectField (ZMod p) _

/-- Square-zero descent along the tower of the `ℤ/kℤ`, by Stacks 031L: if `a ∣ b` and `b ∣ a²`
then formal smoothness of `ℤ/aℤ → Λ/aΛ` descends to `ℤ/bℤ → Λ/bΛ`. The kernel of `ℤ/bℤ → ℤ/aℤ`
is the ideal `(a)`, whose square is `(a²) = 0` precisely because `b ∣ a²`, and the kernel of
`Λ/bΛ → Λ/aΛ` is the ideal it generates. Flatness of `Λ` over `𝐙` is all that is asked of `Λ`;
neither locality nor a prime plays any part. -/
private theorem formallySmooth_of_dvd_sq [Module.Flat ℤ Λ] {a b : ℕ} [NeZero b] (hab : a ∣ b)
    (hb : b ∣ a ^ 2) (ih : ∀ ψ : ZMod a →+* Λ ⧸ Ideal.span {(a : Λ)}, ψ.FormallySmooth)
    (φ : ZMod b →+* Λ ⧸ Ideal.span {(b : Λ)}) : φ.FormallySmooth := by
  have hle : Ideal.span {(b : Λ)} ≤ Ideal.span {(a : Λ)} :=
    Ideal.span_singleton_le_span_singleton.mpr (Nat.cast_dvd_cast hab)
  have hzero : ((a : ℕ) : Λ ⧸ Ideal.span {(a : Λ)}) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk (Ideal.span {(a : Λ)})) a,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _
  refine RingHom.FormallySmooth.of_flat_of_ker_eq_map_of_square_zero φ
    (flat_zmod_of_flat_int rfl φ) (ZMod.castHom hab (ZMod a))
    (Ideal.Quotient.factor hle) (ZMod.castHom (ringChar.dvd hzero) _)
    (ZMod.castHom_surjective _) (Ideal.Quotient.factor_surjective hle) (RingHom.ext_zmod _ _)
    ?_ ?_ (ih _)
  · rw [ker_castHom, Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot, ← Nat.cast_pow,
      ZMod.natCast_eq_zero_iff]
    exact hb
  · rw [Ideal.Quotient.factor_ker, ker_castHom, Ideal.map_span, Ideal.map_span,
      Set.image_singleton, Set.image_singleton, map_natCast φ,
      ← map_natCast (Ideal.Quotient.mk (Ideal.span {(b : Λ)})) a]

/-- For a discrete valuation ring `Λ` whose maximal ideal is generated by the prime `p` — a Cohen
ring with its completeness forgotten — every ring map `ℤ/pⁿℤ → Λ/pⁿΛ` is formally smooth. -/
@[sga "1 III 1.2" "special case"]
private theorem formallySmooth_of_ringHom [IsDomain Λ] [IsDiscreteValuationRing Λ] (hp : p.Prime)
    (hm : maximalIdeal Λ = Ideal.span {(p : Λ)}) (n : ℕ) :
    ∀ φ : ZMod (p ^ n) →+* Λ ⧸ Ideal.span {(p : Λ) ^ n}, φ.FormallySmooth := by
  have : NeZero p := ⟨hp.ne_zero⟩
  have : CharZero Λ := charZero_of_maximalIdeal_eq_span hp hm
  rw [show ((p : Λ) ^ n) = ((p ^ n : ℕ) : Λ) by push_cast; rfl]
  induction n with
  | zero =>
    have : Subsingleton (Λ ⧸ Ideal.span {((p ^ 0 : ℕ) : Λ)}) := by simp
    exact formallySmooth_of_subsingleton
  | succ n ih =>
    obtain rfl | hn := Nat.eq_zero_or_pos n
    · rw [zero_add, pow_one]
      exact formallySmooth_one hp hm
    · exact formallySmooth_of_dvd_sq (pow_dvd_pow p n.le_succ)
        (by rw [← pow_mul]; exact pow_dvd_pow p (by omega)) ih

end Induction

/-! ### The residue characteristic of a Cohen ring -/

/-- For a Cohen ring the prime of the residue characteristic is a uniformizer. -/
private theorem prime_and_maximalIdeal_eq_span {p : ℕ} {Λ : Type*} [CommRing Λ] [IsDomain Λ]
    [IsCohenRing Λ] [CharP (ResidueField Λ) p] :
    p.Prime ∧ maximalIdeal Λ = Ideal.span {(p : Λ)} := by
  obtain ⟨q, hq, hqm⟩ := IsCohenRing.exists_prime_maximalIdeal_eq_span (R := Λ)
  have hdvd : p ∣ q := (CharP.cast_eq_zero_iff (ResidueField Λ) p q).mp <| by
    rw [← map_natCast (residue Λ) q, residue_eq_zero_iff, hqm]
    exact Ideal.mem_span_singleton_self _
  obtain rfl := (hq.eq_one_or_self_of_dvd p hdvd).resolve_left
    (CharP.char_ne_one (ResidueField Λ) p)
  exact ⟨hq, hqm⟩

/-- For a Cohen ring `Λ` whose residue field has characteristic `p`, the quotient `Λ/pⁿΛ` is
formally smooth over `ℤ/pⁿℤ` for the given `ZMod (p ^ n)`-algebra structure. -/
public theorem solution (p n : ℕ) (Λ : Type*) [CommRing Λ]
    [IsDomain Λ] [IsCohenRing Λ] [CharP (ResidueField Λ) p]
    [Algebra (ZMod (p ^ n)) (Λ ⧸ Ideal.span {(p : Λ) ^ n})] :
    Algebra.FormallySmooth (ZMod (p ^ n)) (Λ ⧸ Ideal.span {(p : Λ) ^ n}) := by
  obtain ⟨hp, hm⟩ := prime_and_maximalIdeal_eq_span (p := p) (Λ := Λ)
  rw [← RingHom.formallySmooth_algebraMap]
  exact formallySmooth_of_ringHom hp hm n (algebraMap _ _)

end Stacks.RingTheory.CohenFormalSmoothness

/-!
# Formal smoothness of `Λ/pⁿΛ` over `ℤ/pⁿℤ`

Let `Λ` be a Cohen ring (Stacks 0327), that is, a complete discrete valuation ring whose
uniformizer is a prime number, and let `p` be the characteristic of its residue field, so that
`p` is that uniformizer and `pⁿΛ = 𝔪ⁿ` is the `n`-th power of the maximal ideal. Then for every
`n` the ring map `ℤ/pⁿℤ → Λ/pⁿΛ` is formally smooth.

For `n = 1` the map is `𝐅_p → Λ/pΛ`, an extension of the perfect field `𝐅_p`, hence separable,
hence formally smooth (Stacks 0322). The step from `n` to `n + 1`, for `n ≥ 1`, is Stacks 031L
applied to `ℤ/pⁿ⁺¹ℤ → Λ/pⁿ⁺¹Λ` and the ideal `I = (pⁿ) ⊂ ℤ/pⁿ⁺¹ℤ`: there `I² = 0`, the map
`R/I → S/IS` is the map for `n` and so formally smooth by induction, and `ℤ/pⁿ⁺¹ℤ → Λ/pⁿ⁺¹Λ` is
flat because `Λ`, a domain of characteristic zero, is a torsion-free and hence flat `ℤ_p`-module.

Formal smoothness is all that is available and all that is needed: `ℤ/pⁿℤ → Λ/pⁿΛ` is not
smooth once the residue field fails to be of finite type as an `𝐅_p`-algebra, as `𝐅_p(t)` does.
It is this lemma that produces the compatible lifts `Λ/pⁿΛ → R/𝔪ⁿ` out of which a coefficient
ring of a complete local ring of residue characteristic `p` is assembled (Stacks 032A).

## Main results

* `IsCohenRing.formallySmooth_quotient_span_pow`: for a Cohen ring `Λ` whose residue field has
  characteristic `p`, the ring `Λ/pⁿΛ` is formally smooth over `ℤ/pⁿℤ`.

## Implementation notes

`ℤ/pⁿℤ` is `ZMod (p ^ n)` and `pⁿΛ` is `Ideal.span {(p : Λ) ^ n}`, the ideal generated by the image
of the natural number `p`; under the hypotheses this ideal is `IsLocalRing.maximalIdeal Λ ^ n` by
`Ideal.span_singleton_pow`.

The `ZMod (p ^ n)`-algebra structure on `Λ/pⁿΛ` is an instance argument rather than a synthesized
instance. Mathlib's `ZMod.algebra` is deliberately not an instance (it would create a diamond with
`Algebra.id`), and it needs `CharP (Λ/pⁿΛ) (pⁿ)`, which is a theorem about `Λ` and not available
to instance search. Assuming the structure does not weaken the statement, because it is unique
where it exists: `ZMod.instSubsingletonAlgebra` says a ring carries at most one
`ZMod k`-algebra structure, and any `algebraMap (ZMod k) R` is *the* ring homomorphism out of
`ZMod k`, that ring being generated by `1`. So the hypothesis names the source's map instead of
choosing among candidates, and it is satisfiable: `Λ/pⁿΛ` has characteristic `pⁿ`.

The source's hypotheses `p > 0` prime and `p` a uniformizer of `Λ` are consequences here, not
assumptions: `IsCohenRing Λ` provides a prime `q` with `𝔪 = qΛ`, hence `CharP (ResidueField Λ) q`,
and `CharP.eq` forces `p = q`. The single hypothesis `CharP (ResidueField Λ) p` is therefore the
source's "Cohen ring with residue field of characteristic `p`" in full.

The source's restriction `n ≥ 1` is dropped. For `n = 0` both rings are the zero ring — `ZMod 1`
and `Λ/Λ` — and formal smoothness holds vacuously, so the restriction is inert and the statement
below contains the source's.

Faithfulness. (1) No hypothesis is idle: `CharP (ResidueField Λ) p` is the only link between `p`
and `Λ`, and it is what makes `pⁿΛ` the `n`-th power of the maximal ideal; drop it and `p` may be
a unit of `Λ`, collapsing `Λ/pⁿΛ` to the zero ring and the conclusion to a statement about no
Cohen ring at all. (2) The base is the source's: the scalars are `ℤ/pⁿℤ` for the same `n` that
appears in `pⁿΛ`, neither `ℤ_p` nor the residue field `ℤ/pℤ`, and the algebra structure is the
canonical one. (3) The map the source names is pinned, not merely asserted to exist: it is
`algebraMap (ZMod (p ^ n)) (Λ/pⁿΛ)`, unique as noted above. (4) The instantiation is not
degenerate: `Λ = ℤ_[p]` satisfies every hypothesis (`PadicInt.maximalIdeal_eq_span_p` for
`IsCohenRing`, `PadicInt.residueField` for the residue characteristic, and
`ℤ_[p]/pⁿ ≃+* ZMod (pⁿ)` through `PadicInt.ker_toZModPow` for the algebra structure), where the
map is an isomorphism; the substantive instances come from Stacks 0328, e.g. a Cohen ring for
`𝐅_p(t)`, for which `Λ/pⁿΛ` is a formally smooth `ℤ/pⁿℤ`-algebra that is not of finite type.

