/-!
# Syntomic morphisms

A ring map `R → S` is a *relative global complete intersection* if
`S = R[x_1, …, x_n]/(f_1, …, f_c)` with every nonempty fibre of `Spec(S) → Spec(R)` of dimension
`n - c` (Definition 00SP), and it is *syntomic* if it is flat, of finite presentation, with local
complete intersection fibres (Definition 00SL); a syntomic map is, locally on `Spec(S)`, a relative
global complete intersection (Lemma 00SY). This file proves four further results of Section 10.136.

A relative global complete intersection is defined over a finite type `ℤ`-subalgebra of `R`
containing the coefficients of its relations (Lemma 00SU). Both classes of ring maps are stable
under composition (Lemma 00SZ): for relative global complete intersections the composite
presentation `R[x, y]/(f, h')` works, the nonempty fibres having dimension at most
`(n - c) + (m - d)` by Lemma 00OM and at least that by Krull's height theorem, and the syntomic
case follows by working locally. A syntomic algebra over `R/I` is covered by principal opens each
of which is the reduction modulo `I` of a relative global complete intersection over `R`
(Lemma 00T0). Finally, for a presentation `S = R[x_1, …, x_n]/I` and `g ∈ S` with `S_g` syntomic,
the localized conormal module `(I/I²)_g` is finite projective (Lemma 07BT).

## Main results

* `Algebra.Presentation.exists_fg_isRelativeGlobalCompleteIntersection_naive`: Lemma 00SU.
* `Algebra.IsRelativeGlobalCompleteIntersection.comp`, `Algebra.Syntomic.comp`: Lemma 00SZ.
* `Algebra.Presentation.isRelativeGlobalCompleteIntersection_comp`: the composite of two relative
  global complete intersection presentations is one.
* `Algebra.Syntomic.exists_span_eq_top_algEquiv_quotient`: Lemma 00T0.
* `Algebra.Generators.finite_and_projective_tensor_cotangent_of_syntomic`: Lemma 07BT.
* `ringKrullDim_le_add_of_ringKrullDim_fiber_le`: `dim B ≤ dim A + sup dim(κ(𝔮) ⊗_A B)` for a
  ring map `A → B` of Noetherian rings.

## Implementation notes

*Lemma 00SZ (2).* The source reduces to a field base by base change. Here the fibre
`κ(𝔭) ⊗_R S'` is written as `A ⊗_S S'` with `A = κ(𝔭) ⊗_R S`, a Noetherian ring of dimension
`n - c`, and `dim(A ⊗_S S') ≤ (n - c) + (m - d)` follows from Lemma 00OM at every prime,
`ringKrullDim_le_add_of_ringKrullDim_fiber_le`. The fibres of `A → A ⊗_S S'` are bounded through
the invariance of relative dimension under base change (Lemma 00QI) instead of being identified
with base changes of fibres of `S → S'` along residue field extensions.

*Lemma 00SU.* The finitely many `g_1, …, g_m` covering the image of `Spec(S)` are replaced by the
open locus `U = {𝔮 : dim_𝔮(S₁/R₁) ≤ n - c}` of Lemma 00QH over the subring `R₁` generated by the
coefficients of the relations: the ideal `J` of its closed complement generates the unit ideal of
`S`, and "after increasing `R₀`" is the subring generated in addition by the coefficients of the
polynomials in one equation `∑ A_t X_t - 1 = ∑ B_j f_j` witnessing this.

*Lemma 00T0.* The isomorphisms `S̄_{ḡ_i} ≅ S_i/IS_i` are isomorphisms of `R`-algebras, and each
`S_i` is a principal localization of `R[x_1, …, x_n]/(f_1, …, f_c)` for lifts `f_k` of the
relations of `S̄_{ḡ_i}`, as in the source.

*Lemma 07BT.* The localization `(I/I²)_g` is the base change `S_g ⊗_S I/I²`, the form in which
Lemma 00S6 compares conormal modules. The source's hypothesis that `I` is finitely generated is
not used: Lemma 00S6 does not need it.

## References

* [Stacks 00SU](https://stacks.math.columbia.edu/tag/00SU)
* [Stacks 00SZ](https://stacks.math.columbia.edu/tag/00SZ)
* [Stacks 00T0](https://stacks.math.columbia.edu/tag/00T0)
* [Stacks 07BT](https://stacks.math.columbia.edu/tag/07BT)
* [Stacks 00OM](https://stacks.math.columbia.edu/tag/00OM)
* [Stacks 00QH](https://stacks.math.columbia.edu/tag/00QH)
* [Stacks 00QI](https://stacks.math.columbia.edu/tag/00QI)
-/

@[expose] public section

universe u v

open TensorProduct

/-! ### Dimension of fibres -/

/-- The preimage of the image of an ideal under a surjection is the ideal, if it contains the
kernel. -/
private theorem comap_map_eq_of_ker_le {R S : Type*} [CommRing R] [CommRing S] {f : R →+* S}
    (hf : Function.Surjective f) {I : Ideal R} (hker : RingHom.ker f ≤ I) :
    (I.map f).comap f = I := by
  rw [Ideal.comap_map_of_surjective _ hf, sup_eq_left, ← RingHom.ker_eq_comap_bot]
  exact hker

/-- **A prime of `B/𝔮B` has height at most the dimension of the fibre over `𝔮`.** Let
`A → B` be a ring map, `M` a prime of `B` and `𝔮 = M ∩ A`. The primes of `B/𝔮B` below `M/𝔮B`
all lie over `𝔮`, so the height of `M/𝔮B` in `B/𝔮B` is bounded by the dimension of the fibre
ring `κ(𝔮) ⊗_A B`, whose primes are the primes of `B` over `𝔮`. -/
theorem Ideal.height_map_quotient_le_ringKrullDim_fiber {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] (M : Ideal B) [M.IsPrime] :
    ((M.map (Ideal.Quotient.mk ((M.under A).map (algebraMap A B)))).height : WithBot ℕ∞) ≤
      ringKrullDim ((M.under A).Fiber B) := by
  set 𝔮 := M.under A
  set J := 𝔮.map (algebraMap A B)
  have hJM : J ≤ M := Ideal.map_le_iff_le_comap.mpr le_rfl
  have hker : RingHom.ker (Ideal.Quotient.mk J) ≤ M := by rwa [Ideal.mk_ker]
  have hP : (M.map (Ideal.Quotient.mk J)).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
  have hcomap := comap_map_eq_of_ker_le Ideal.Quotient.mk_surjective hker
  set x : PrimeSpectrum (B ⧸ J) := ⟨_, hP⟩
  let f : Set.Iic x → PrimeSpectrum (𝔮.Fiber B) := fun P =>
    PrimeSpectrum.primesOverOrderIsoFiber A B 𝔮
      ⟨P.1.asIdeal.comap (Ideal.Quotient.mk J), Ideal.comap_isPrime _ _, ⟨le_antisymm
        (fun a ha => by
          show algebraMap A B a ∈ P.1.asIdeal.comap (Ideal.Quotient.mk J)
          rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)]
          exact P.1.asIdeal.zero_mem)
        (fun a ha => by
          have : P.1.asIdeal.comap (Ideal.Quotient.mk J) ≤ M :=
            hcomap ▸ Ideal.comap_mono P.2
          exact this ha)⟩⟩
  have hf : StrictMono f := by
    intro P P' hlt
    refine (PrimeSpectrum.primesOverOrderIsoFiber A B 𝔮).strictMono ?_
    show P.1.asIdeal.comap (Ideal.Quotient.mk J) < P'.1.asIdeal.comap (Ideal.Quotient.mk J)
    refine lt_of_le_of_ne (Ideal.comap_mono (show P.1.asIdeal ≤ P'.1.asIdeal from hlt.le))
      fun h => hlt.ne (Subtype.ext (PrimeSpectrum.ext ?_))
    have := congrArg (Ideal.map (Ideal.Quotient.mk J)) h
    rwa [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective,
      Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective] at this
  calc ((M.map (Ideal.Quotient.mk J)).height : WithBot ℕ∞)
      = (Order.height x : WithBot ℕ∞) := by rw [← PrimeSpectrum.height_eq_orderHeight]
    _ = Order.krullDim (Set.Iic x) := by rw [Order.height_eq_krullDim_Iic]
    _ ≤ Order.krullDim (PrimeSpectrum (𝔮.Fiber B)) := Order.krullDim_le_of_strictMono f hf
    _ = ringKrullDim (𝔮.Fiber B) := rfl

/-- **Dimension of the source plus dimension of the fibres bounds the dimension of the
target.** Let `A → B` be a ring map of Noetherian rings with `dim A ≤ a` and all of whose fibre
rings `κ(𝔮) ⊗_A B` have dimension at most `b`. Then `dim B ≤ a + b`: this is
`dim B_M ≤ dim A_𝔮 + dim B_M/𝔮B_M` (Lemma 00OM) at every prime `M` of `B`. -/
theorem ringKrullDim_le_add_of_ringKrullDim_fiber_le {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [IsNoetherianRing A] [IsNoetherianRing B] {a b : ℕ∞} (hA : ringKrullDim A ≤ a)
    (hB : ∀ (𝔮 : Ideal A) [𝔮.IsPrime], ringKrullDim (𝔮.Fiber B) ≤ b) :
    ringKrullDim B ≤ ((a + b : ℕ∞) : WithBot ℕ∞) := by
  rw [ringKrullDim_le_iff_height_le]
  intro M hM
  have : M.LiesOver (M.under A) := ⟨rfl⟩
  have h1 := Ideal.height_le_height_add_of_liesOver (M.under A) M
  have h2 : ((M.under A).height : WithBot ℕ∞) ≤ a :=
    Ideal.height_le_ringKrullDim_of_isPrime.trans hA
  have h3 := (Ideal.height_map_quotient_le_ringKrullDim_fiber (A := A) M).trans (hB (M.under A))
  have h2' : (M.under A).height ≤ a := by exact_mod_cast h2
  have h3' : (M.map (Ideal.Quotient.mk ((M.under A).map (algebraMap A B)))).height ≤ b := by
    exact_mod_cast h3
  exact_mod_cast h1.trans (add_le_add h2' h3')

/-- The relative dimension `dim_𝔮(S/R)` is at most the dimension of the fibre ring through
`𝔮`. -/
public theorem Algebra.relativeDimensionAt_le_ringKrullDim_fiber {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (q : Ideal S) [q.IsPrime] :
    Algebra.relativeDimensionAt R q ≤ ringKrullDim ((q.under R).Fiber S) :=
  Stacks.RegularSequence.FibrewiseLocus.relativeDimensionAt_le_ringKrullDim_fiber R q
/-- A prime of the fibre ring `κ(𝔭) ⊗_R S` pulls back to a prime of `S` lying over `𝔭`. -/
private theorem under_comap_includeRight {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (p : Ideal R) [p.IsPrime] (x : PrimeSpectrum (p.Fiber S)) :
    (x.asIdeal.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] p.Fiber S)).under R = p := by
  refine Eq.trans ?_ (Ideal.over_def x.asIdeal p).symm
  ext r
  rw [Ideal.under, Ideal.under, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, AlgHom.commutes]

/-- The dimension of the fibre ring over `𝔭` is the supremum of the relative dimensions at the
primes over `𝔭`; in particular a bound on the latter bounds the former. -/
public theorem Algebra.ringKrullDim_fiber_le_of_relativeDimensionAt_le {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (p : Ideal R) [p.IsPrime] {N : WithBot ℕ∞}
    (hN : ∀ (q : Ideal S) [q.IsPrime], q.under R = p → Algebra.relativeDimensionAt R q ≤ N) :
    ringKrullDim (p.Fiber S) ≤ N := by
  rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
  refine iSup_le fun x ↦ ?_
  rw [← Algebra.relativeDimensionAt_eq_localKrullDim _ p (under_comap_includeRight p x)
    x.asIdeal rfl]
  exact hN _ (under_comap_includeRight p x)

/-- The fibre of `Spec S → Spec R` through a prime `𝔮` of `S` is nonempty. -/
private theorem nontrivial_fiber_under {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (q : Ideal S) [q.IsPrime] : Nontrivial ((q.under R).Fiber S) := by
  obtain ⟨Q, hQ, -⟩ := Ideal.Fiber.exists_comap_includeRight_eq q (q.under R) rfl
  exact ⟨0, 1, fun h => hQ.ne_top ((Ideal.eq_top_iff_one _).mpr (h ▸ Q.zero_mem))⟩

/-- A nonempty fibre of a relative global complete intersection presentation has dimension
`n - c`, with `c ≤ n`. -/
private theorem le_and_ringKrullDim_fiber_eq {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {n c : ℕ} (P : Algebra.Presentation R S (Fin n) (Fin c))
    [hP : P.IsRelativeGlobalCompleteIntersection] (p : Ideal R) [p.IsPrime]
    [Nontrivial (p.Fiber S)] :
    c ≤ n ∧ ringKrullDim (p.Fiber S) = ((n - c : ℕ) : WithBot ℕ∞) :=
  WithBot.le_and_eq_tsub_of_add_natCast_eq
    (by simpa using hP.ringKrullDim_fiber_add_card_eq_card p ‹_›)

/-- In `WithBot ℕ∞`, `x + c ≤ n` for natural numbers `c`, `n` gives `x ≤ n - c`. -/
public theorem WithBot.le_natCast_sub_of_add_le {x : WithBot ℕ∞} {c n : ℕ} (h : x + c ≤ n) :
    x ≤ ((n - c : ℕ) : WithBot ℕ∞) := by
  induction x using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe y =>
    induction y using ENat.recTopCoe with
    | top => norm_cast at h
    | coe k =>
      have : k + c ≤ n := by exact_mod_cast h
      have : k ≤ n - c := by omega
      rw [← WithBot.coe_natCast]
      exact WithBot.coe_le_coe.mpr (by exact_mod_cast this)

/-- For `R → S` of finite type the locus of primes `𝔮` with `dim_𝔮(S/R) + c ≤ n` is open
(Lemma 00QH). -/
public theorem Algebra.isOpen_setOf_relativeDimensionAt_add_le {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [Algebra.FiniteType R S] (c n : ℕ) :
    IsOpen {q : PrimeSpectrum S | Algebra.relativeDimensionAt R q.asIdeal + c ≤ n} :=
  Stacks.RegularSequence.FibrewiseLocus.isOpen_setOf_relativeDimensionAt_add_le R n c
/-- A presentation
`S = R[x_1, …, x_n]/(f_1, …, f_c)` is a relative global complete intersection as soon as
`dim_𝔮(S/R) + c ≤ n` at every prime `𝔮` of `S`: every nonempty fibre then has dimension at most
`n - c`, and at least `n - c` by Krull's height theorem. -/
private theorem isRelativeGlobalCompleteIntersection_of_relativeDimensionAt_add_le'
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {ι σ : Type*} [Finite ι] [Finite σ]
    (P : Algebra.Presentation R S ι σ)
    (h : ∀ (q : Ideal S) [q.IsPrime], Algebra.relativeDimensionAt R q + Nat.card σ ≤ Nat.card ι) :
    P.IsRelativeGlobalCompleteIntersection := by
  refine ⟨fun p _ hnt => le_antisymm ?_
    (P.baseChange p.ResidueField).natCard_le_ringKrullDim_add_natCard⟩
  obtain ⟨x⟩ : Nonempty (PrimeSpectrum (p.Fiber S)) := inferInstance
  set q := x.asIdeal.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] p.Fiber S)
  have hcn : Nat.card σ ≤ Nat.card ι := by
    have := (add_le_add_left (Algebra.zero_le_relativeDimensionAt R q)
      (Nat.card σ : WithBot ℕ∞)).trans (h q)
    rw [zero_add] at this
    exact_mod_cast this
  have hle := Algebra.ringKrullDim_fiber_le_of_relativeDimensionAt_le (S := S) p
    (N := ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞)) fun q _ _ =>
      WithBot.le_natCast_sub_of_add_le (h q)
  calc ringKrullDim (p.Fiber S) + (Nat.card σ : WithBot ℕ∞)
      ≤ ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) + Nat.card σ := by gcongr
    _ = Nat.card ι := by norm_cast; omega

/-! ### Descending a presentation along a ring map -/

/-- Two presentations with the same variables and the same relations present isomorphic
algebras: an algebra map carrying the generators of one to the generators of the other is
bijective. -/
public theorem Algebra.Presentation.bijective_of_relation_eq {R S S' ι σ : Type*} [CommRing R]
    [CommRing S] [CommRing S'] [Algebra R S] [Algebra R S'] (P : Algebra.Presentation R S ι σ)
    (Q : Algebra.Presentation R S' ι σ) (hrel : Q.relation = P.relation) (Φ : S' →ₐ[R] S)
    (hΦ : ∀ i, Φ (Q.val i) = P.val i) : Function.Bijective Φ := by
  have hcomp (p : MvPolynomial ι R) : Φ (MvPolynomial.aeval Q.val p) =
      MvPolynomial.aeval P.val p := by
    rw [← AlgHom.comp_apply]
    congr 1
    exact MvPolynomial.algHom_ext fun i => by simp [hΦ]
  have hker : Q.ker = P.ker := by
    rw [← Q.span_range_relation_eq_ker, ← P.span_range_relation_eq_ker, hrel]
  refine ⟨fun x y hxy => ?_, fun s => ?_⟩
  · obtain ⟨p, rfl⟩ := Q.algebraMap_surjective x
    obtain ⟨p', rfl⟩ := Q.algebraMap_surjective y
    rw [Algebra.Generators.algebraMap_apply, Algebra.Generators.algebraMap_apply, hcomp,
      hcomp] at hxy
    have hmem : p - p' ∈ Q.ker := by
      rw [hker, Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker, map_sub, hxy, sub_self]
    rw [Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker, map_sub, sub_eq_zero] at hmem
    rw [Algebra.Generators.algebraMap_apply, Algebra.Generators.algebraMap_apply]
    exact hmem
  · obtain ⟨p, rfl⟩ := P.algebraMap_surjective s
    exact ⟨MvPolynomial.aeval Q.val p, by rw [hcomp, Algebra.Generators.algebraMap_apply]⟩

/-- **Descending a presentation.** If `S = R[x]/(f_1, …, f_c)` and each `f_k` is the image of
`f⁰_k` along `R₀ → R`, then `S = R ⊗_{R₀} R₀[x]/(f⁰_1, …, f⁰_c)`, through the map sending `x_i` to
the `i`-th generator of `S`. -/
public theorem Algebra.Presentation.isPushout_quotient_of_map_eq {R₀ R S ι σ : Type*} [CommRing R₀]
    [CommRing R] [CommRing S] [Algebra R₀ R] [Algebra R S] (P : Algebra.Presentation R S ι σ)
    (f : σ → MvPolynomial ι R₀)
    (hf : ∀ k, MvPolynomial.map (algebraMap R₀ R) (f k) = P.relation k) [Algebra R₀ S]
    [IsScalarTower R₀ R S] [Algebra (MvPolynomial ι R₀ ⧸ Ideal.span (Set.range f)) S]
    [IsScalarTower R₀ (MvPolynomial ι R₀ ⧸ Ideal.span (Set.range f)) S]
    (hT : ∀ i, algebraMap (MvPolynomial ι R₀ ⧸ Ideal.span (Set.range f)) S
      (Ideal.Quotient.mk _ (MvPolynomial.X i)) = P.val i) :
    Algebra.IsPushout R₀ R (MvPolynomial ι R₀ ⧸ Ideal.span (Set.range f)) S := by
  set T := MvPolynomial ι R₀ ⧸ Ideal.span (Set.range f)
  let Φ : R ⊗[R₀] T →ₐ[R] S := Algebra.TensorProduct.lift (Algebra.ofId R S)
    (IsScalarTower.toAlgHom R₀ T S) fun _ _ => Commute.all _ _
  let Q := (Algebra.Presentation.naive (v := f)).baseChange R
  have hb : Function.Bijective Φ := by
    refine Algebra.Presentation.bijective_of_relation_eq P Q (funext fun k => ?_) Φ fun i => ?_
    · simp [Q, hf]
    · show Φ (1 ⊗ₜ[R₀] (Ideal.Quotient.mk _ (MvPolynomial.X i))) = _
      simp only [Φ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      exact hT i
  refine ⟨IsBaseChange.of_equiv (AlgEquiv.ofBijective Φ hb).toLinearEquiv fun t => ?_⟩
  simp only [AlgEquiv.toLinearEquiv_apply, AlgEquiv.ofBijective_apply]
  simp [Φ]
  rfl

/-! ### Coverings by relative global complete intersections -/

/-- Being a global complete intersection over a field is invariant under isomorphism. -/
theorem IsGlobalCompleteIntersection.of_algEquiv {k A B : Type*} [Field k] [CommRing A]
    [CommRing B] [Algebra k A] [Algebra k B] (e : A ≃ₐ[k] B)
    (h : IsGlobalCompleteIntersection k A) : IsGlobalCompleteIntersection k B := by
  rcases h with hsub | ⟨m, c, F, eA, hcm, hdim⟩
  · exact Or.inl e.toEquiv.symm.subsingleton
  · refine Or.inr ⟨m, c, F, e.symm.trans eA, hcm, ?_⟩
    rw [← ringKrullDim_eq_of_ringEquiv (e : A ≃+* B)]
    exact hdim

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The fibre ring of a principal localization `S_g` is the principal localization of the fibre
ring of `S` at `1 ⊗ g`. -/
noncomputable def Ideal.Fiber.awayAlgEquiv {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (p : Ideal R) [p.IsPrime] (g : S) :
    p.Fiber (Localization.Away g) ≃ₐ[p.ResidueField]
      Localization.Away (Algebra.TensorProduct.includeRight (R := R) (A := p.ResidueField) g) := by
  let K := p.ResidueField
  let Sg := Localization.Away g
  let : Algebra S (K ⊗[R] Sg) := ((algebraMap Sg (K ⊗[R] Sg)).comp (algebraMap S Sg)).toAlgebra
  let : Algebra (K ⊗[R] S) (K ⊗[R] Sg) :=
    (Algebra.TensorProduct.map (AlgHom.id R K) (IsScalarTower.toAlgHom R S Sg)).toRingHom.toAlgebra
  have : IsScalarTower S Sg (K ⊗[R] Sg) := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower S (K ⊗[R] S) (K ⊗[R] Sg) := .of_algebraMap_eq fun s => by
    simp [RingHom.algebraMap_toAlgebra]
  have : IsScalarTower R (K ⊗[R] S) (K ⊗[R] Sg) := .of_algebraMap_eq fun r => by
    simp [RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
    rfl
  have : IsScalarTower K (K ⊗[R] S) (K ⊗[R] Sg) := .of_algebraMap_eq fun r => by
    simp [RingHom.algebraMap_toAlgebra, Algebra.TensorProduct.algebraMap_apply]
    rfl
  have h1 : Algebra.IsPushout S Sg (K ⊗[R] S) (K ⊗[R] Sg) :=
    (Algebra.IsPushout.comp_iff R S K (T := Sg) (S' := K ⊗[R] S) (T' := K ⊗[R] Sg)).mp
      inferInstance
  have : IsLocalization (Algebra.algebraMapSubmonoid (K ⊗[R] S) (Submonoid.powers g))
      (K ⊗[R] Sg) := (Algebra.isLocalization_iff_isPushout (Submonoid.powers g) Sg).mpr h1.symm
  have hpow : Algebra.algebraMapSubmonoid (K ⊗[R] S) (Submonoid.powers g) =
      Submonoid.powers (Algebra.TensorProduct.includeRight (R := R) (A := K) g) := by
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
    rfl
  rw [hpow] at this
  exact (IsLocalization.algEquiv (Submonoid.powers
    (Algebra.TensorProduct.includeRight (R := R) (A := K) g)) (K ⊗[R] Sg) _).restrictScalars K

/-- **Syntomic from a covering by relative global complete intersections.** If `g ∈ s`
generate the unit ideal of `S` and each `S_g` is a relative global complete intersection over
`R`, then `R → S` is syntomic. Flatness and finite presentation are local on `S`, and the fibre
ring `κ(𝔭) ⊗_R S` is covered by the `κ(𝔭) ⊗_R S_g`, which are global complete intersections. -/
theorem Algebra.Syntomic.of_span_eq_top_of_isRelativeGlobalCompleteIntersection {R S : Type*}
    [CommRing R] [CommRing S] [Algebra R S]
    (s : Set S) (hs : Ideal.span s = ⊤)
    (h : ∀ g ∈ s, Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away g)) :
    Algebra.Syntomic R S := by
  have hsyn (g : S) (hg : g ∈ s) : Algebra.Syntomic R (Localization.Away g) :=
    have := h g hg
    Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection R _
  have : Module.Flat R S := Module.flat_of_isLocalized_span S S s hs
    (fun r => Localization.Away r.1) (fun r => Algebra.linearMap S _)
    fun r => (hsyn r.1 r.2).flat
  have : Algebra.FinitePresentation R S :=
    Algebra.FinitePresentation.of_span_eq_top_target s hs fun g hg => (hsyn g hg).finitePresentation
  refine ⟨inferInstance, inferInstance, fun p _ => ?_⟩
  refine ⟨Algebra.TensorProduct.includeRight '' s, ?_, ?_⟩
  · rw [← Ideal.map_span, hs, Ideal.map_top]
  · rintro _ ⟨g, hg, rfl⟩
    have := h g hg
    obtain ⟨n, c, P, hP⟩ :=
      ‹Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away g)›.out
    exact (hP.isGlobalCompleteIntersection_fiber p).of_algEquiv (Ideal.Fiber.awayAlgEquiv p g)


/-- **A syntomic algebra is a relative global complete intersection near every prime.** If
`R → S` is syntomic and `𝔮` is a prime of `S`, then `S_g` is a relative global complete
intersection over `R` for some `g ∉ 𝔮`: this is (1) ⟹ (2) of Lemma 00SY at `g = 1`. -/
theorem Algebra.Syntomic.exists_notMem_isRelativeGlobalCompleteIntersection {R S : Type*}
    [CommRing R] [CommRing S] [Algebra R S] [Algebra.Syntomic R S] (q : Ideal S) [q.IsPrime] :
    ∃ g ∉ q, Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away g) :=
  have := (Algebra.Syntomic.flat_localization_and_isCompleteIntersection_fiber (R := R) q).1
  Algebra.exists_notMem_isRelativeGlobalCompleteIntersection_of_flat q
    (Algebra.Syntomic.flat_localization_and_isCompleteIntersection_fiber (R := R) q).2

/-- **A syntomic algebra is covered by relative global complete intersections.** If `R → S` is
syntomic, the elements `g ∈ S` such that `S_g` is a relative global complete intersection over
`R` generate the unit ideal of `S`. -/
theorem Algebra.Syntomic.span_setOf_isRelativeGlobalCompleteIntersection_eq_top {R S : Type*}
    [CommRing R] [CommRing S] [Algebra R S] [Algebra.Syntomic R S] :
    Ideal.span {g : S | Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away g)} =
      ⊤ := by
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
  obtain ⟨g, hg, hrgci⟩ := Algebra.Syntomic.exists_notMem_isRelativeGlobalCompleteIntersection
    (R := R) m
  exact hg (hle (Ideal.subset_span hrgci))

/-! ### Composition (Lemma 00SZ) -/

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The fibres of the base change `A → A ⊗_S S'` of a relative global complete intersection
`S' = S[y_1, …, y_m]/(h_1, …, h_d)` have dimension at most `m - d`: relative dimension is
invariant under base change (Lemma 00QI). -/
private theorem ringKrullDim_fiber_tensorProduct_le {S S' A : Type*} [CommRing S] [CommRing S']
    [CommRing A] [Algebra S S'] [Algebra S A] {m d : ℕ}
    (Q : Algebra.Presentation S S' (Fin m) (Fin d)) [Q.IsRelativeGlobalCompleteIntersection]
    (𝔮 : Ideal A) [𝔮.IsPrime] :
    ringKrullDim (𝔮.Fiber (A ⊗[S] S')) ≤ ((m - d : ℕ) : WithBot ℕ∞) := by
  have := Q.finitePresentation_of_isFinite
  refine Algebra.ringKrullDim_fiber_le_of_relativeDimensionAt_le 𝔮 fun M _ _ => ?_
  have h := Algebra.IsPushout.relativeDimensionAt_comap_eq S S' A (A ⊗[S] S') ⟨M, ‹_›⟩
  rw [← h]
  set q' := (PrimeSpectrum.comap (algebraMap S' (A ⊗[S] S')) ⟨M, ‹_›⟩).asIdeal
  refine (Algebra.relativeDimensionAt_le_ringKrullDim_fiber q').trans ?_
  have := nontrivial_fiber_under (R := S) q'
  exact (le_and_ringKrullDim_fiber_eq Q (q'.under S)).2.le

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The fibres of a composite of two relative global complete intersections
`S = R[x_1, …, x_n]/(f_1, …, f_c)` and `S' = S[y_1, …, y_m]/(h_1, …, h_d)` have dimension at most
`(n - c) + (m - d)`. The fibre `κ(𝔭) ⊗_R S'` is `A ⊗_S S'` for `A = κ(𝔭) ⊗_R S`, a Noetherian
ring of dimension `n - c` whose fibres in `A ⊗_S S'` have dimension at most `m - d`. -/
private theorem ringKrullDim_fiber_le_of_presentation {R S S' : Type*} [CommRing R] [CommRing S]
    [CommRing S'] [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    {n c m d : ℕ} (P : Algebra.Presentation R S (Fin n) (Fin c))
    [P.IsRelativeGlobalCompleteIntersection] (Q : Algebra.Presentation S S' (Fin m) (Fin d))
    [Q.IsRelativeGlobalCompleteIntersection] (p : Ideal R) [p.IsPrime]
    [Nontrivial (p.Fiber S')] :
    c ≤ n ∧ ringKrullDim (p.Fiber S') ≤ ((n - c + (m - d) : ℕ) : WithBot ℕ∞) := by
  have := P.finitePresentation_of_isFinite
  have := Q.finitePresentation_of_isFinite
  let e : p.Fiber S ⊗[S] S' ≃ₐ[p.ResidueField] p.Fiber S' :=
    Algebra.IsPushout.cancelBaseChangeAlg R p.ResidueField S (p.Fiber S) S'
  have : Nontrivial (p.Fiber S ⊗[S] S') := e.toEquiv.nontrivial
  have : Nontrivial (p.Fiber S) := (algebraMap (p.Fiber S) (p.Fiber S ⊗[S] S')).domain_nontrivial
  obtain ⟨hcn, hA⟩ := le_and_ringKrullDim_fiber_eq P p
  have : IsNoetherianRing (p.Fiber S) := Algebra.FiniteType.isNoetherianRing p.ResidueField _
  have : Algebra.FiniteType p.ResidueField (p.Fiber S ⊗[S] S') :=
    .trans (S := p.Fiber S) inferInstance inferInstance
  have : IsNoetherianRing (p.Fiber S ⊗[S] S') :=
    Algebra.FiniteType.isNoetherianRing p.ResidueField (p.Fiber S ⊗[S] S')
  refine ⟨hcn, ?_⟩
  rw [← ringKrullDim_eq_of_ringEquiv (R := p.Fiber S ⊗[S] S') e.toRingEquiv]
  have := ringKrullDim_le_add_of_ringKrullDim_fiber_le (A := p.Fiber S)
    (B := p.Fiber S ⊗[S] S') (a := ((n - c : ℕ) : ℕ∞)) (b := ((m - d : ℕ) : ℕ∞))
    (by rw [hA]; rfl) fun 𝔮 _ => ringKrullDim_fiber_tensorProduct_le Q 𝔮
  exact_mod_cast this

/-- **The composite of two relative global complete intersections is one, with the composite
presentation.** If `S = R[x_1, …, x_n]/(f_1, …, f_c)` and `S' = S[y_1, …, y_m]/(h_1, …, h_d)` are
relative global complete intersections, then so is
`S' = R[x_1, …, x_n, y_1, …, y_m]/(f_1, …, f_c, h'_1, …, h'_d)`, the presentation
`Algebra.Presentation.comp`, for lifts `h'_j` of the `h_j`. -/
theorem Algebra.Presentation.isRelativeGlobalCompleteIntersection_comp {R S S' : Type*}
    [CommRing R] [CommRing S]
    [CommRing S'] [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    {n c m d : ℕ} (P : Algebra.Presentation R S (Fin n) (Fin c))
    [P.IsRelativeGlobalCompleteIntersection] (Q : Algebra.Presentation S S' (Fin m) (Fin d))
    [Q.IsRelativeGlobalCompleteIntersection] :
    (Q.comp P).IsRelativeGlobalCompleteIntersection := by
  refine ⟨fun p _ hnt => le_antisymm ?_ ?_⟩
  · obtain ⟨hcn, hle⟩ := ringKrullDim_fiber_le_of_presentation P Q p
    have hdm : d ≤ m := by
      obtain ⟨M, hM⟩ := Ideal.exists_maximal (p.Fiber S')
      set q' := M.comap (Algebra.TensorProduct.includeRight : S' →ₐ[R] p.Fiber S')
      have := nontrivial_fiber_under (R := S) q'
      exact (le_and_ringKrullDim_fiber_eq Q (q'.under S)).1
    simp only [Nat.card_eq_fintype_card, Fintype.card_sum, Fintype.card_fin]
    calc ringKrullDim (p.Fiber S') + ((d + c : ℕ) : WithBot ℕ∞)
        ≤ ((n - c + (m - d) : ℕ) : WithBot ℕ∞) + ((d + c : ℕ) : WithBot ℕ∞) := by gcongr
      _ = ((m + n : ℕ) : WithBot ℕ∞) := by norm_cast; omega
  · exact ((Q.comp P).baseChange p.ResidueField).natCard_le_ringKrullDim_add_natCard

/-- **Stacks 00SZ (2).** If `R → S` and `S → S'` are relative global complete intersections,
then so is `R → S'`. -/
@[stacks 00SZ "(2). Stated for the class `Algebra.IsRelativeGlobalCompleteIntersection`
along a scalar tower `R → S → S'`; the composite presentation is
`Algebra.Presentation.isRelativeGlobalCompleteIntersection_comp`."]
theorem Algebra.IsRelativeGlobalCompleteIntersection.comp (R S S' : Type*) [CommRing R]
    [CommRing S] [CommRing S'] [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    [Algebra.IsRelativeGlobalCompleteIntersection R S]
    [Algebra.IsRelativeGlobalCompleteIntersection S S'] :
    Algebra.IsRelativeGlobalCompleteIntersection R S' := by
  obtain ⟨n, c, P, hP⟩ := ‹Algebra.IsRelativeGlobalCompleteIntersection R S›.out
  obtain ⟨m, d, Q, hQ⟩ := ‹Algebra.IsRelativeGlobalCompleteIntersection S S'›.out
  have := Algebra.Presentation.isRelativeGlobalCompleteIntersection_comp P Q
  exact .of_presentation (Q.comp P)

/-- **Stacks 00SZ (1).** If `R → S` and `S → S'` are syntomic, then so is `R → S'`. -/
@[stacks 00SZ "(1). Stated for the class `Algebra.Syntomic` along a scalar tower
`R → S → S'`."]
theorem Algebra.Syntomic.comp (R S S' : Type*) [CommRing R] [CommRing S] [CommRing S']
    [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S'] [Algebra.Syntomic R S]
    [Algebra.Syntomic S S'] : Algebra.Syntomic R S' := by
  refine Algebra.Syntomic.of_span_eq_top_of_isRelativeGlobalCompleteIntersection
    {h : S' | Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away h)} ?_
    fun _ hh => hh
  by_contra hne
  obtain ⟨q', hq', hle⟩ := Ideal.exists_le_maximal _ hne
  obtain ⟨g', hg', _⟩ :=
    Algebra.Syntomic.exists_notMem_isRelativeGlobalCompleteIntersection (R := S) q'
  obtain ⟨g, hg, _⟩ :=
    Algebra.Syntomic.exists_notMem_isRelativeGlobalCompleteIntersection (R := R) (q'.under S)
  set T := Localization.Away g'
  set f := algebraMap S T g
  have hf : f ∉ q'.map (algebraMap S' T) := fun hmem => hg (by
    have hdisj : Disjoint (Submonoid.powers g' : Set S') q' :=
      (Ideal.disjoint_powers_iff_notMem_of_isPrime g').mpr hg'
    rw [show f = algebraMap S' T (algebraMap S S' g) from
      IsScalarTower.algebraMap_apply S S' T g] at hmem
    rw [← Ideal.mem_comap] at hmem
    have h := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g') T
      hq'.isPrime hdisj
    rw [Ideal.under] at h
    rw [h] at hmem
    exact hmem)
  set X := Localization.Away f
  let : Algebra (Localization.Away g) X :=
    (IsLocalization.Away.map (Localization.Away g) X (algebraMap S T) g).toAlgebra
  have : IsScalarTower S (Localization.Away g) X := .of_algebraMap_eq fun x => by
    rw [RingHom.algebraMap_toAlgebra, IsLocalization.Away.map, IsLocalization.map_eq,
      IsScalarTower.algebraMap_apply S T X]
  have : IsLocalization (Algebra.algebraMapSubmonoid T (Submonoid.powers g)) X := by
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
    exact Localization.isLocalization
  have : Algebra.IsPushout S T (Localization.Away g) X :=
    (Algebra.isLocalization_iff_isPushout (Submonoid.powers g) (Localization.Away g)).mp this
  have : Algebra.IsRelativeGlobalCompleteIntersection (Localization.Away g) X :=
    Algebra.IsRelativeGlobalCompleteIntersection.baseChange S T (Localization.Away g) X
  have : IsScalarTower R (Localization.Away g) X := .of_algebraMap_eq fun r => by
    rw [IsScalarTower.algebraMap_apply R S (Localization.Away g),
      ← IsScalarTower.algebraMap_apply S (Localization.Away g) X,
      IsScalarTower.algebraMap_apply R S' X, IsScalarTower.algebraMap_apply S S' X,
      IsScalarTower.algebraMap_apply R S S']
  have : Algebra.IsRelativeGlobalCompleteIntersection R X :=
    Algebra.IsRelativeGlobalCompleteIntersection.comp R (Localization.Away g) X
  obtain ⟨g'', hg'', hrgci⟩ :=
    Algebra.IsRelativeGlobalCompleteIntersection.exists_notMem_of_localizationAway (R := R) q'
      hg' hf
  exact hg'' (hle (Ideal.subset_span hrgci))

/-! ### Spreading out (Lemma 00SU) -/

/-- **The descended presentation is a relative global complete intersection.** Let `R₁ → R₀`
be a ring map, `T₁ = R₁[x]/(f_1, …, f_c)`, and let `X_t ∈ R₁[x]` vanish at every prime of `T₁`
where `dim(T₁/R₁) + c > n`. If the `X_t` generate the unit ideal of `T₀ = R₀[x]/(f_1, …, f_c)`,
witnessed by `∑ A_t X_t - 1 = ∑ B_j f_j` in `R₀[x]`, then `T₀` is a relative global complete
intersection over `R₀`: `T₀ = R₀ ⊗_{R₁} T₁`, and relative dimension is invariant under base
change (Lemma 00QI). -/
private theorem isRelativeGlobalCompleteIntersection_naive_map_of_forall {R₁ R₀ ι σ : Type*}
    [CommRing R₁] [CommRing R₀] [Algebra R₁ R₀] [Finite ι] [Fintype σ]
    (f₁ : σ → MvPolynomial ι R₁) {k : ℕ} (A₀ : Fin k → MvPolynomial ι R₀)
    (X : Fin k → MvPolynomial ι R₁) (B₀ : σ → MvPolynomial ι R₀)
    (hE : ∑ t, A₀ t * MvPolynomial.map (algebraMap R₁ R₀) (X t) - 1 =
      ∑ j, B₀ j * MvPolynomial.map (algebraMap R₁ R₀) (f₁ j))
    (hX : ∀ t (q : Ideal (MvPolynomial ι R₁ ⧸ Ideal.span (Set.range f₁))) [q.IsPrime],
      ¬ Algebra.relativeDimensionAt R₁ q + Nat.card σ ≤ Nat.card ι →
        Ideal.Quotient.mk _ (X t) ∈ q) :
    Algebra.Presentation.IsRelativeGlobalCompleteIntersection
      (Algebra.Presentation.naive (v := fun j => MvPolynomial.map (algebraMap R₁ R₀) (f₁ j))) := by
  classical
  set f₀ : σ → MvPolynomial ι R₀ := fun j => MvPolynomial.map (algebraMap R₁ R₀) (f₁ j)
  set T₁ := MvPolynomial ι R₁ ⧸ Ideal.span (Set.range f₁)
  set T₀ := MvPolynomial ι R₀ ⧸ Ideal.span (Set.range f₀)
  have hle : Ideal.span (Set.range f₁) ≤
      (Ideal.span (Set.range f₀)).comap (MvPolynomial.map (algebraMap R₁ R₀)) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.subset_span ⟨j, rfl⟩
  let φ : T₁ →+* T₀ := Ideal.quotientMap _ (MvPolynomial.map (algebraMap R₁ R₀)) hle
  have hφ (F) : φ (Ideal.Quotient.mk _ F) =
      Ideal.Quotient.mk _ (MvPolynomial.map (algebraMap R₁ R₀) F) := Ideal.quotientMap_mk
  let : Algebra T₁ T₀ := φ.toAlgebra
  have : IsScalarTower R₁ T₁ T₀ := .of_algebraMap_eq fun r => by
    show _ = φ (Ideal.Quotient.mk _ (MvPolynomial.C r))
    rw [hφ, MvPolynomial.map_C]
    rfl
  have : Algebra.IsPushout R₁ R₀ T₁ T₀ :=
    Algebra.Presentation.isPushout_quotient_of_map_eq (Algebra.Presentation.naive (v := f₀)) f₁
      (fun _ => rfl)
      fun i => by
        show φ _ = _
        rw [hφ, MvPolynomial.map_X]
        rfl
  have : Algebra.IsPushout R₁ T₁ R₀ T₀ := Algebra.IsPushout.symm inferInstance
  have : Algebra.FinitePresentation R₁ T₁ :=
    (Algebra.Presentation.naive (v := f₁)).finitePresentation_of_isFinite
  refine isRelativeGlobalCompleteIntersection_of_relativeDimensionAt_add_le' _ fun q _ => ?_
  rw [← Algebra.IsPushout.relativeDimensionAt_comap_eq R₁ T₁ R₀ T₀ ⟨q, ‹_›⟩]
  by_contra hq
  have hmem (t) : Ideal.Quotient.mk (Ideal.span (Set.range f₀))
      (MvPolynomial.map (algebraMap R₁ R₀) (X t)) ∈ q := by
    rw [← hφ]
    exact hX t _ hq
  apply ‹q.IsPrime›.ne_top
  rw [Ideal.eq_top_iff_one]
  have h1 : (Ideal.Quotient.mk (Ideal.span (Set.range f₀))) (∑ t, A₀ t *
      MvPolynomial.map (algebraMap R₁ R₀) (X t)) = 1 := by
    rw [← sub_eq_zero, ← map_one (Ideal.Quotient.mk _), ← map_sub, hE,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)
  rw [← h1, map_sum]
  exact Ideal.sum_mem _ fun t _ => by rw [map_mul]; exact Ideal.mul_mem_left _ _ (hmem t)

/-- **The witnesses for a descended presentation.** Let `S = R[x]/(f_1, …, f_c)` be a relative
global complete intersection and let the `f_j` come from `R₁[x]`, `T₁ = R₁[x]/(f_1, …, f_c)`. The
locus `U ⊆ Spec(T₁)` where `dim(T₁/R₁) + c ≤ n` is open (Lemma 00QH) and contains the image of
`Spec(S)` (Lemma 00QI), so its closed complement `V(J)` misses that image, i.e. `J S = S`. Lifting
an equation `1 = ∑ a_t x_t`, `x_t ∈ J`, to `R[x]` gives `∑ A_t X_t - 1 = ∑ B_j f_j`. -/
private theorem exists_forall_of_isRelativeGlobalCompleteIntersection {R₁ R S ι σ : Type*}
    [CommRing R₁] [CommRing R] [CommRing S] [Algebra R₁ R] [Algebra R S] [Finite ι] [Fintype σ]
    (P : Algebra.Presentation R S ι σ) [P.IsRelativeGlobalCompleteIntersection]
    (f₁ : σ → MvPolynomial ι R₁)
    (hf₁ : ∀ j, MvPolynomial.map (algebraMap R₁ R) (f₁ j) = P.relation j) :
    ∃ (k : ℕ) (A : Fin k → MvPolynomial ι R) (X : Fin k → MvPolynomial ι R₁)
      (B : σ → MvPolynomial ι R),
      ∑ t, A t * MvPolynomial.map (algebraMap R₁ R) (X t) - 1 = ∑ j, B j * P.relation j ∧
      ∀ t (q : Ideal (MvPolynomial ι R₁ ⧸ Ideal.span (Set.range f₁))) [q.IsPrime],
        ¬ Algebra.relativeDimensionAt R₁ q + Nat.card σ ≤ Nat.card ι →
          Ideal.Quotient.mk _ (X t) ∈ q := by
  classical
  have := P.finitePresentation_of_isFinite
  let : Algebra R₁ S := ((algebraMap R S).comp (algebraMap R₁ R)).toAlgebra
  have : IsScalarTower R₁ R S := .of_algebraMap_eq fun _ => rfl
  -- the fibres of `R → S` have dimension `n - c`
  have hcol (q : Ideal S) [q.IsPrime] :
      Algebra.relativeDimensionAt R q + Nat.card σ ≤ Nat.card ι := by
    calc _ ≤ ringKrullDim ((q.under R).Fiber S) + Nat.card σ := by
          gcongr; exact Algebra.relativeDimensionAt_le_ringKrullDim_fiber q
      _ = Nat.card ι := ‹P.IsRelativeGlobalCompleteIntersection›.ringKrullDim_fiber_add_card_eq_card
          (q.under R) (nontrivial_fiber_under q)
  set T₁ := MvPolynomial ι R₁ ⧸ Ideal.span (Set.range f₁)
  let φ₁ : T₁ →+* S := Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom (algebraMap R₁ S) P.val) (by
      intro F hF
      refine (Ideal.span_le.mpr ?_ : Ideal.span (Set.range f₁) ≤ RingHom.ker _) hF
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.coe_eval₂Hom,
        IsScalarTower.algebraMap_eq R₁ R S, ← MvPolynomial.eval₂_map, hf₁ j]
      exact P.aeval_val_relation j)
  have hφ₁ (F) : φ₁ (Ideal.Quotient.mk _ F) =
      MvPolynomial.aeval P.val (MvPolynomial.map (algebraMap R₁ R) F) := by
    show MvPolynomial.eval₂ _ _ F = _
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map, ← IsScalarTower.algebraMap_eq]
  let : Algebra T₁ S := φ₁.toAlgebra
  have : @IsScalarTower R₁ T₁ S Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    .of_algebraMap_eq fun x => (MvPolynomial.eval₂_C _ _ _).symm
  have hpush₁ : Algebra.IsPushout R₁ R T₁ S :=
    Algebra.Presentation.isPushout_quotient_of_map_eq P f₁ hf₁ fun i => MvPolynomial.eval₂_X _ _ _
  have : Algebra.IsPushout R₁ T₁ R S := hpush₁.symm
  have : Algebra.FinitePresentation R₁ T₁ :=
    (Algebra.Presentation.naive (v := f₁)).finitePresentation_of_isFinite
  -- the open locus of `Spec T₁` where the fibres have dimension at most `n - c`
  set U := {x : PrimeSpectrum T₁ |
    Algebra.relativeDimensionAt (S := T₁) R₁ x.asIdeal + Nat.card σ ≤ Nat.card ι}
  have hU : IsOpen U := Algebra.isOpen_setOf_relativeDimensionAt_add_le _ _
  set J := PrimeSpectrum.vanishingIdeal Uᶜ
  have hZ : PrimeSpectrum.zeroLocus J = Uᶜ := by
    rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hU.isClosed_compl.closure_eq]
  -- it contains the image of `Spec S`
  have hJ : J.map (algebraMap T₁ S) = ⊤ := by
    by_contra hne
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
    have h1 : PrimeSpectrum.comap (algebraMap T₁ S) ⟨m, hm.isPrime⟩ ∈
        PrimeSpectrum.zeroLocus J := Ideal.map_le_iff_le_comap.mp hle
    rw [hZ] at h1
    apply h1
    show Algebra.relativeDimensionAt (S := T₁) R₁
      (PrimeSpectrum.comap (algebraMap T₁ S) ⟨m, hm.isPrime⟩).asIdeal +
        (Nat.card σ : WithBot ℕ∞) ≤ Nat.card ι
    rw [Algebra.IsPushout.relativeDimensionAt_comap_eq R₁ T₁ R S ⟨m, hm.isPrime⟩]
    exact hcol m
  obtain ⟨k, a, x, hx⟩ := Submodule.mem_span_set'.mp (hJ ▸ Submodule.mem_top (x := (1 : S)))
  choose x' hx'J hx' using fun t => (x t).2
  choose A hA using fun t => P.algebraMap_surjective (a t)
  choose X hX using fun t => Ideal.Quotient.mk_surjective (x' t)
  have hE : ∑ t, A t * MvPolynomial.map (algebraMap R₁ R) (X t) - 1 ∈
      Ideal.span (Set.range P.relation) := by
    rw [P.span_range_relation_eq_ker, Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker,
      map_sub, map_one, sub_eq_zero, ← hx, map_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [map_mul, ← hφ₁, hX, ← Algebra.Generators.algebraMap_apply, hA, smul_eq_mul, ← hx' t]
    rfl
  obtain ⟨B, hB⟩ := Ideal.mem_span_range_iff_exists_fun.mp hE
  refine ⟨k, A, X, B, hB.symm, fun t q _ hq => ?_⟩
  rw [hX]
  exact (PrimeSpectrum.mem_vanishingIdeal _ _).mp (hx'J t) ⟨q, ‹_›⟩ hq

/-- A polynomial whose coefficients lie in a subalgebra `R₀` comes from `R₀`. -/
private theorem exists_map_eq_of_coeffs_subset {R ι : Type*} [CommRing R] (R₀ : Subalgebra ℤ R)
    (F : MvPolynomial ι R) (h : (F.coeffs : Set R) ⊆ R₀) :
    ∃ F₀ : MvPolynomial ι R₀, MvPolynomial.map (algebraMap R₀ R) F₀ = F :=
  MvPolynomial.mem_range_map_iff_coeffs_subset.mpr (h.trans (by simp))

/-- **Stacks 00SU.** Let `S = R[x_1, …, x_n]/(f_1, …, f_c)` be a relative global complete
intersection. There is a finite type `ℤ`-subalgebra `R₀ ⊆ R` with `f_k ∈ R₀[x_1, …, x_n]` such
that `S₀ = R₀[x_1, …, x_n]/(f_1, …, f_c)` is a relative global complete intersection. -/
@[stacks 00SU "The subalgebra is a finitely generated `Subalgebra ℤ R`, the relations over it
are `f₀` with `MvPolynomial.map (algebraMap R₀ R) (f₀ k) = f_k`, and `S₀` is presented by
`Algebra.Presentation.naive`. Stated for arbitrary finite index types."]
theorem Algebra.Presentation.exists_fg_isRelativeGlobalCompleteIntersection_naive
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {ι σ : Type*} [Finite ι] [Finite σ]
    (P : Algebra.Presentation R S ι σ) [P.IsRelativeGlobalCompleteIntersection] :
    ∃ (R₀ : Subalgebra ℤ R) (_ : R₀.FG) (f₀ : σ → MvPolynomial ι R₀),
      (∀ j, MvPolynomial.map (algebraMap R₀ R) (f₀ j) = P.relation j) ∧
        (Algebra.Presentation.naive (v := f₀)).IsRelativeGlobalCompleteIntersection := by
  classical
  have := Fintype.ofFinite σ
  -- the subring generated by the coefficients of the relations
  set K₁ : Finset R := Finset.univ.biUnion fun j => (P.relation j).coeffs
  set R₁ := Algebra.adjoin ℤ (K₁ : Set R)
  choose f₁ hf₁ using fun j => exists_map_eq_of_coeffs_subset R₁ (P.relation j)
    fun x hx => Algebra.subset_adjoin (Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ _, hx⟩)
  obtain ⟨k, A, X, B, hE, hX⟩ := exists_forall_of_isRelativeGlobalCompleteIntersection P f₁ hf₁
  -- the subring generated by the coefficients of the relations and of the witnesses
  set K : Finset R := K₁ ∪ Finset.univ.biUnion (fun t => (A t).coeffs) ∪
    Finset.univ.biUnion (fun j => (B j).coeffs)
  set R₀ := Algebra.adjoin ℤ (K : Set R)
  have hR₁₀ : R₁ ≤ R₀ := Algebra.adjoin_mono fun y hy => by simp [K, hy]
  let : Algebra R₁ R₀ := (Subalgebra.inclusion hR₁₀).toRingHom.toAlgebra
  have : IsScalarTower R₁ R₀ R := .of_algebraMap_eq fun _ => rfl
  choose A₀ hA₀ using fun t => exists_map_eq_of_coeffs_subset R₀ (A t)
    fun y hy => Algebra.subset_adjoin (by
      simp only [K, Finset.coe_union, Set.mem_union, Finset.mem_coe, Finset.mem_biUnion]
      exact Or.inl (Or.inr ⟨t, Finset.mem_univ _, hy⟩))
  choose B₀ hB₀ using fun j => exists_map_eq_of_coeffs_subset R₀ (B j)
    fun y hy => Algebra.subset_adjoin (by
      simp only [K, Finset.coe_union, Set.mem_union, Finset.mem_coe, Finset.mem_biUnion]
      exact Or.inr ⟨j, Finset.mem_univ _, hy⟩)
  have hE₀ : ∑ t, A₀ t * MvPolynomial.map (algebraMap R₁ R₀) (X t) - 1 =
      ∑ j, B₀ j * MvPolynomial.map (algebraMap R₁ R₀) (f₁ j) := by
    apply MvPolynomial.map_injective (algebraMap R₀ R) Subtype.val_injective
    simp only [map_sub, map_sum, map_mul, map_one, hA₀, hB₀, MvPolynomial.map_map,
      ← IsScalarTower.algebraMap_eq, hf₁, hE]
  refine ⟨R₀, ⟨K, rfl⟩, fun j => MvPolynomial.map (algebraMap R₁ R₀) (f₁ j), fun j => ?_,
    isRelativeGlobalCompleteIntersection_naive_map_of_forall f₁ A₀ X B₀ hE₀ hX⟩
  rw [MvPolynomial.map_map, ← IsScalarTower.algebraMap_eq, hf₁]

/-! ### Lifting along a quotient of the base (Lemma 00T0) -/

/-- If `S = (R/I)[x]/(f̄_1, …, f̄_c)` and the `f_k ∈ R[x]` lift the `f̄_k`, then the kernel of
`R[x]/(f_1, …, f_c) → S` is generated by `I`. -/
private theorem ker_eq_map_of_presentation_quotient {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) [Algebra (R ⧸ I) S] {ι σ : Type*} (P : Algebra.Presentation (R ⧸ I) S ι σ)
    (f : σ → MvPolynomial ι R)
    (hf : ∀ k, MvPolynomial.map (Ideal.Quotient.mk I) (f k) = P.relation k)
    (φ : MvPolynomial ι R ⧸ Ideal.span (Set.range f) →+* S)
    (hφ : ∀ F, φ (Ideal.Quotient.mk _ F) =
      MvPolynomial.aeval P.val (MvPolynomial.map (Ideal.Quotient.mk I) F)) :
    RingHom.ker φ = I.map (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range f))) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [RingHom.mem_ker, hφ] at hx
    have h1 : MvPolynomial.map (Ideal.Quotient.mk I) F ∈
        Ideal.map (MvPolynomial.map (Ideal.Quotient.mk I)) (Ideal.span (Set.range f)) := by
      rw [Ideal.map_span, ← Set.range_comp,
        show (MvPolynomial.map (Ideal.Quotient.mk I)) ∘ f = P.relation from funext hf,
        P.span_range_relation_eq_ker, Algebra.Generators.ker_eq_ker_aeval_val]
      exact hx
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective
      (MvPolynomial.map (σ := ι) (Ideal.Quotient.mk I))
      (MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective), ← RingHom.ker_eq_comap_bot,
      MvPolynomial.ker_map, Ideal.mk_ker] at h1
    obtain ⟨j, hj, i, hi, rfl⟩ := Submodule.mem_sup.mp h1
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hj, zero_add]
    have : Ideal.map (Ideal.Quotient.mk _) (I.map MvPolynomial.C) =
        I.map (algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range f))) := by
      rw [Ideal.map_map]
      rfl
    rw [← this]
    exact Ideal.mem_map_of_mem _ hi
  · rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker,
      show algebraMap R (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) r =
        Ideal.Quotient.mk _ (MvPolynomial.C r) from rfl, hφ, MvPolynomial.map_C,
      MvPolynomial.aeval_C, Ideal.Quotient.eq_zero_iff_mem.mpr hr, map_zero]

/-- If `φ : A →ₐ[R] S` is surjective with kernel `I A` and `φ a = 1`, then
`A_a / I A_a ≃ₐ[R] S`. -/
private theorem Localization.Away.nonempty_algEquiv_quotient_of_ker_eq_map {R A S : Type*}
    [CommRing R] [CommRing A] [CommRing S] [Algebra R A] [Algebra R S] {I : Ideal R} (φ : A →ₐ[R] S)
    (hsurj : Function.Surjective φ) (hker : RingHom.ker φ = I.map (algebraMap R A)) {a : A}
    (ha : φ a = 1) :
    Nonempty ((Localization.Away a ⧸ I.map (algebraMap R (Localization.Away a))) ≃ₐ[R] S) := by
  set T := Localization.Away a
  have hu : IsUnit (φ.toRingHom a) := show IsUnit (φ a) from ha ▸ isUnit_one
  let ψ : T →ₐ[R] S := IsLocalization.Away.liftAlgHom (f := φ) a hu
  have hψ (x : A) : ψ (algebraMap A T x) = φ x := IsLocalization.Away.lift_eq a hu x
  have hψsurj : Function.Surjective ψ := fun s => by
    obtain ⟨x, rfl⟩ := hsurj s
    exact ⟨_, hψ x⟩
  have hkerψ : RingHom.ker ψ = I.map (algebraMap R T) := by
    apply le_antisymm
    · intro x hx
      obtain ⟨k, y, hy⟩ := IsLocalization.Away.surj a x
      rw [← Ideal.mul_unit_mem_iff_mem _ ((IsLocalization.Away.algebraMap_isUnit a).pow k), hy]
      have hy' : y ∈ I.map (algebraMap R A) := hker ▸ RingHom.mem_ker.mpr (by
        rw [← hψ, ← hy, map_mul, RingHom.mem_ker.mp hx, zero_mul])
      have := Ideal.mem_map_of_mem (algebraMap A T) hy'
      rwa [Ideal.map_map, ← IsScalarTower.algebraMap_eq] at this
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, ← φ.commutes, ← RingHom.mem_ker, hker]
      exact Ideal.mem_map_of_mem _ hr
  exact ⟨(Ideal.quotientEquivAlgOfEq R hkerψ.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hψsurj)⟩

/-- Let `S = A ⊗_R R/I` with `A → S` surjective of kernel `I A`. If `S` has a relative global
complete intersection presentation over `R/I` with `n` variables and `c` relations, then every
nonempty fibre of `R → A` over a prime containing `I` has dimension at most `n - c`. -/
private theorem Algebra.ringKrullDim_fiber_add_le_of_isPushout_quotient {R A S : Type*}
    [CommRing R] [CommRing A] [CommRing S] [Algebra R A] [Algebra R S] [Algebra A S] (I : Ideal R)
    [Algebra (R ⧸ I) S] [IsScalarTower R A S] [IsScalarTower R (R ⧸ I) S]
    [Algebra.IsPushout R A (R ⧸ I) S] [Algebra.FiniteType R A] {n c : ℕ}
    (P : Algebra.Presentation (R ⧸ I) S (Fin n) (Fin c))
    [hP : P.IsRelativeGlobalCompleteIntersection] (hsurj : Function.Surjective (algebraMap A S))
    (hker : RingHom.ker (algebraMap A S) = I.map (algebraMap R A)) (p : Ideal R) [p.IsPrime]
    (hIp : I ≤ p) [Nontrivial (p.Fiber A)] :
    ringKrullDim (p.Fiber A) + (c : WithBot ℕ∞) ≤ n := by
  -- the fibres of `R → A` over `V(I)`
  have key (q : Ideal A) [q.IsPrime] (hIq : I ≤ q.under R) :
      c ≤ n ∧ Algebra.relativeDimensionAt R q ≤ ((n - c : ℕ) : WithBot ℕ∞) := by
    have hkq : RingHom.ker (algebraMap A S) ≤ q := by
      rw [hker, Ideal.map_le_iff_le_comap]
      exact hIq
    have hq : (q.map (algebraMap A S)).IsPrime := Ideal.map_isPrime_of_surjective hsurj hkq
    have hcq : PrimeSpectrum.comap (algebraMap A S) ⟨q.map (algebraMap A S), hq⟩ = ⟨q, ‹_›⟩ :=
      PrimeSpectrum.ext (comap_map_eq_of_ker_le hsurj hkq)
    have hdim := Algebra.IsPushout.relativeDimensionAt_comap_eq R A (R ⧸ I) S
      ⟨q.map (algebraMap A S), hq⟩
    rw [hcq] at hdim
    change Algebra.relativeDimensionAt R q = _ at hdim
    have := nontrivial_fiber_under (R := R ⧸ I) (q.map (algebraMap A S))
    obtain ⟨hcn, hd⟩ := le_and_ringKrullDim_fiber_eq P ((q.map (algebraMap A S)).under (R ⧸ I))
    exact ⟨hcn, hdim ▸
      (Algebra.relativeDimensionAt_le_ringKrullDim_fiber (q.map (algebraMap A S))).trans hd.le⟩
  obtain ⟨x⟩ : Nonempty (PrimeSpectrum (p.Fiber A)) := inferInstance
  set q := x.asIdeal.comap (Algebra.TensorProduct.includeRight : A →ₐ[R] p.Fiber A)
  have hunder : q.under R = p := under_comap_includeRight p x
  have hcn := (key q (hunder ▸ hIp)).1
  have hle := Algebra.ringKrullDim_fiber_le_of_relativeDimensionAt_le (S := A) p
    (N := ((n - c : ℕ) : WithBot ℕ∞)) fun q _ hq => (key q (hq ▸ hIp)).2
  calc ringKrullDim (p.Fiber A) + (c : WithBot ℕ∞)
      ≤ ((n - c : ℕ) : WithBot ℕ∞) + c := by gcongr
    _ = n := by norm_cast; omega

/-- **Stacks 00T0.** Let `I ⊆ R` be an ideal and let `R/I → S̄` be syntomic. There are
elements `ḡ_i ∈ S̄` generating the unit ideal such that every `S̄_{ḡ_i}` is isomorphic to
`S_i/IS_i` for a relative global complete intersection `S_i` over `R`. -/
@[stacks 00T0 "The syntomic `R/I`-algebra `S̄` is an `R`-algebra through `R → R/I`, the
elements `ḡ_i` are a set `s` with `Ideal.span s = ⊤`, and `S̄_{ḡ_i} ≅ S_i/IS_i` is an isomorphism
of `R`-algebras."]
theorem Algebra.Syntomic.exists_span_eq_top_algEquiv_quotient {R : Type u} [CommRing R]
    (I : Ideal R) {S : Type v} [CommRing S] [Algebra R S] [Algebra (R ⧸ I) S]
    [IsScalarTower R (R ⧸ I) S] [Algebra.Syntomic (R ⧸ I) S] :
    ∃ s : Set S, Ideal.span s = ⊤ ∧ ∀ g ∈ s, ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T),
      Algebra.IsRelativeGlobalCompleteIntersection R T ∧
        Nonempty ((T ⧸ I.map (algebraMap R T)) ≃ₐ[R] Localization.Away g) := by
  refine ⟨_, Algebra.Syntomic.span_setOf_isRelativeGlobalCompleteIntersection_eq_top
    (R := R ⧸ I), fun g hg => ?_⟩
  obtain ⟨n, c, P, hP⟩ := (show Algebra.IsRelativeGlobalCompleteIntersection (R ⧸ I)
    (Localization.Away g) from hg).out
  set Sg := Localization.Away g
  have : IsScalarTower R (R ⧸ I) Sg := .of_algebraMap_eq fun r => by
    rw [IsScalarTower.algebraMap_apply R S Sg, IsScalarTower.algebraMap_apply R (R ⧸ I) S,
      ← IsScalarTower.algebraMap_apply (R ⧸ I) S Sg]
  choose f hf using fun k => MvPolynomial.map_surjective (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective (P.relation k)
  set A := MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range f)
  let φ : A →+* Sg := Ideal.Quotient.lift _
    ((MvPolynomial.aeval P.val).toRingHom.comp (MvPolynomial.map (Ideal.Quotient.mk I))) (by
      intro F hF
      refine (Ideal.span_le.mpr ?_ : Ideal.span (Set.range f) ≤ RingHom.ker _) hF
      rintro _ ⟨k, rfl⟩
      simp [hf k, P.aeval_val_relation])
  have hφ (F) : φ (Ideal.Quotient.mk _ F) =
      MvPolynomial.aeval P.val (MvPolynomial.map (Ideal.Quotient.mk I) F) := rfl
  have hsurj : Function.Surjective φ := fun s => by
    obtain ⟨F', rfl⟩ := P.algebraMap_surjective s
    obtain ⟨F, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective F'
    exact ⟨Ideal.Quotient.mk _ F, by rw [hφ, Algebra.Generators.algebraMap_apply]⟩
  let : Algebra A Sg := φ.toAlgebra
  have : IsScalarTower R A Sg := .of_algebraMap_eq fun r => by
    show _ = φ (Ideal.Quotient.mk _ (MvPolynomial.C r))
    rw [hφ, MvPolynomial.map_C, MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply R (R ⧸ I) Sg]
    rfl
  have : Algebra.IsPushout R A (R ⧸ I) Sg :=
    (Algebra.Presentation.isPushout_quotient_of_map_eq P f hf fun i => by
      show φ _ = _
      rw [hφ]
      simp).symm
  have hker := ker_eq_map_of_presentation_quotient I P f hf φ hφ
  have := P.finitePresentation_of_isFinite
  set Pn := Algebra.Presentation.naive (v := f)
  have := Pn.finitePresentation_of_isFinite
  have hI : ∀ (p : Ideal R) [p.IsPrime], I ≤ p → Nontrivial (p.Fiber A) →
      ringKrullDim (p.Fiber A) + ((Nat.card (Fin c) : ℕ) : WithBot ℕ∞) =
        ((Nat.card (Fin n) : ℕ) : WithBot ℕ∞) := by
    intro p _ hIp hnt
    refine le_antisymm ?_ (Pn.baseChange p.ResidueField).natCard_le_ringKrullDim_add_natCard
    simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using
      Algebra.ringKrullDim_fiber_add_le_of_isPushout_quotient I P hsurj hker p hIp
  obtain ⟨h, hh1, hRG⟩ := Pn.exists_sub_one_mem_map_isRelativeGlobalCompleteIntersection I hI
  set a := algebraMap Pn.Ring A h
  set T := Localization.Away a
  have hφa : φ a = 1 := by simpa [sub_eq_zero] using hker.ge hh1
  exact ⟨T, inferInstance, inferInstance, .of_presentation (Pn.localizationAwayComp h T),
    Localization.Away.nonempty_algEquiv_quotient_of_ker_eq_map
      (IsScalarTower.toAlgHom R A Sg) hsurj hker hφa⟩

/-! ### The conormal module (Lemma 07BT) -/

/-- **Stacks 07BT.** Let `S = R[x_1, …, x_n]/I` and let `g ∈ S` be such that `S_g` is syntomic
over `R`. Then `(I/I²)_g` is a finite projective `S_g`-module. -/
@[stacks 07BT "The presentation `R[x_1, …, x_n] → S` is `Algebra.Generators R S (Fin n)`,
`I/I²` is its cotangent module `P.toExtension.Cotangent`, and `(I/I²)_g` is the base change
`T ⊗_S I/I²` to a localization `T` of `S` away from `g`. The source's hypothesis that `I` is
finitely generated is not needed."]
theorem Algebra.Generators.finite_and_projective_tensor_cotangent_of_syntomic {R S T : Type*}
    [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T] [Algebra S T]
    [IsScalarTower R S T] (g : S) [IsLocalization.Away g T] [Algebra.Syntomic R T] {n : ℕ}
    (P : Algebra.Generators R S (Fin n)) :
    Module.Finite T (T ⊗[S] P.toExtension.Cotangent) ∧
      Module.Projective T (T ⊗[S] P.toExtension.Cotangent) := by
  set M := T ⊗[S] P.toExtension.Cotangent
  set s := {f : T | Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away f)}
  have hs : Ideal.span s = ⊤ :=
    Algebra.Syntomic.span_setOf_isRelativeGlobalCompleteIntersection_eq_top
  have hloc (f : T) (hf : f ∈ s) :
      Module.Finite (Localization.Away f) (LocalizedModule.Away f M) ∧
        Module.Projective (Localization.Away f) (LocalizedModule.Away f M) := by
    have : Algebra.IsRelativeGlobalCompleteIntersection R (Localization.Away f) := hf
    set Tf := Localization.Away f
    have : IsScalarTower R S Tf := .of_algebraMap_eq fun r => by
      rw [IsScalarTower.algebraMap_apply R T Tf, IsScalarTower.algebraMap_apply R S T,
        ← IsScalarTower.algebraMap_apply S T Tf]
    have := IsLocalization.Away.mul_of_associated (S := T) (T := Tf) g
      (IsLocalization.Away.sec g f).1 f (IsLocalization.Away.associated_sec_fst g f)
    obtain ⟨m, c, Q, hQ⟩ := ‹Algebra.IsRelativeGlobalCompleteIntersection R Tf›.out
    obtain ⟨e⟩ :=
      Algebra.Generators.nonempty_cotangent_baseChange_prod_linearEquiv_of_isLocalizationAway
      (T := Tf) (g * (IsLocalization.Away.sec g f).1) P Q.toGenerators
    obtain ⟨b, -⟩ := Q.exists_basis_cotangent_relation
    have : Module.Free Tf Q.toGenerators.toExtension.Cotangent := .of_basis b
    have : Module.Finite Tf Q.toGenerators.toExtension.Cotangent := .of_basis b
    have hproj : Module.Projective Tf (Tf ⊗[S] P.toExtension.Cotangent) :=
      Module.Projective.of_split (e.toLinearMap ∘ₗ LinearMap.inl Tf _ (Fin m → Tf))
        (LinearMap.fst Tf _ (Fin m → Tf) ∘ₗ e.symm.toLinearMap) (by ext x; simp)
    have hfin : Module.Finite Tf (Tf ⊗[S] P.toExtension.Cotangent) :=
      Module.Finite.of_surjective (LinearMap.fst Tf _ (Fin m → Tf) ∘ₗ e.symm.toLinearMap)
        (fun x => ⟨e (x, 0), by simp⟩)
    let e' : LocalizedModule.Away f M ≃ₗ[Tf] Tf ⊗[S] P.toExtension.Cotangent :=
      (IsLocalizedModule.isBaseChange (Submonoid.powers f) Tf
        (LocalizedModule.mkLinearMap (Submonoid.powers f) M)).equiv.symm ≪≫ₗ
        TensorProduct.AlgebraTensorModule.cancelBaseChange S T Tf Tf P.toExtension.Cotangent
    exact ⟨Module.Finite.equiv e'.symm, Module.Projective.of_equiv e'.symm⟩
  have : Module.FinitePresentation T M :=
    Module.FinitePresentation.of_localizationSpan s hs fun f =>
      have := (hloc f f.2).1
      have := (hloc f f.2).2
      Module.finitePresentation_of_projective _ _
  have : Module.Flat T M :=
    Module.flat_of_localized_span T M s hs fun r =>
      have := (hloc r r.2).2
      Module.Flat.trans T (Localization.Away r.1) _
  exact ⟨inferInstance, Module.Flat.projective_of_finitePresentation⟩

end
