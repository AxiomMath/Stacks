section

section

universe u

/-- A regular local ring is J-0. -/
private theorem isJ0_of_isRegularLocalRing (A : Type*) [CommRing A]
    [IsRegularLocalRing A] : IsJ0 A := by
  have : IsRegularRing A := (IsLocalRing.isRegularRing_tfae (R := A)).out 1 3 |>.mp
    (inferInstance : IsRegularLocalRing A)
  exact isJ0_of_isRegularRing A

/-- A finite extension of a J-0 domain with separable fraction fields is J-0. -/
private theorem isJ0_of_finite_of_isSeparable_fractionRing
    (A B : Type*) [CommRing A] [IsNoetherianRing A] [IsDomain A]
    [CommRing B] [IsDomain B] [Algebra A B] [Module.Finite A B]
    [FaithfulSMul A B] (hA : IsJ0 A)
    (hsep : letI := FractionRing.liftAlgebra A (FractionRing B)
      Algebra.IsSeparable (FractionRing A) (FractionRing B)) : IsJ0 B := by
  apply isJ0_of_finiteType_injective_of_isSeparable_fractionRing A B hA
    (FaithfulSMul.algebraMap_injective A B)
  let := FractionRing.liftAlgebra A (FractionRing B)
  let := hsep
  have : Algebra.FormallyEtale (FractionRing A) (FractionRing B) :=
    Algebra.FormallyEtale.of_isSeparable _ _
  exact (Algebra.FormallySmooth.iff_isSeparableExtension _ _).mp inferInstance

/-- In characteristic zero the finite regular subring has separable fraction field extension. -/
private theorem isJ0_of_isPrecomplete_maximalIdeal_of_charZero
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] [IsDomain R]
    [IsPrecomplete (IsLocalRing.maximalIdeal R) R] [CharZero R] : IsJ0 R := by
  have : IsAdicComplete (IsLocalRing.maximalIdeal R) R := ⟨⟩
  obtain ⟨d, Λ, _, _, _, hreg, _, f, hinj, hfin, _⟩ :=
    IsLocalRing.exists_injective_finite_mvPowerSeries R
  let A := MvPowerSeries (Fin d) Λ
  have : IsDomain A := Function.Injective.isDomain f hinj
  let : Algebra A R := f.toAlgebra
  have : Module.Finite A R := hfin
  have : FaithfulSMul A R := (faithfulSMul_iff_algebraMap_injective A R).mpr hinj
  have : IsRegularLocalRing A := hreg
  have : CharZero A := f.charZero
  apply isJ0_of_finite_of_isSeparable_fractionRing A R (isJ0_of_isRegularLocalRing A)
  let := FractionRing.liftAlgebra A (FractionRing R)
  have : IsScalarTower A (FractionRing A) (FractionRing R) :=
    FractionRing.isScalarTower_liftAlgebra A (FractionRing R)
  have : Algebra.IsAlgebraic (FractionRing A) (FractionRing R) :=
    isAlgebraic_of_isFractionRing A R (FractionRing A) (FractionRing R)
  infer_instance

/-- A derivation which does not vanish on a hypersurface equation modulo that equation
exhibits a nonempty regular open subset of the hypersurface. -/
private theorem isJ0_quotient_span_singleton_of_derivation
    {R : Type*} [CommRing R] [IsRegularRing R] (f : R)
    [IsDomain (R ⧸ Ideal.span {f})] (D : Derivation ℤ R R)
    (hD : Ideal.Quotient.mk (Ideal.span {f}) (D f) ≠ 0) :
    IsJ0 (R ⧸ Ideal.span {f}) := by
  let I : Ideal R := Ideal.span {f}
  let B := R ⧸ I
  let π : R →+* B := Ideal.Quotient.mk I
  refine ⟨PrimeSpectrum.basicOpen (π (D f)), (PrimeSpectrum.basicOpen _).isOpen, ?_, ?_⟩
  · exact ⟨⟨⊥, inferInstance⟩, hD⟩
  intro q hq
  let p : Ideal R := q.asIdeal.comap π
  let A := Localization.AtPrime p
  let x : A := algebraMap R A f
  let DA := Stacks.DerivationExtension.locDeriv D p.primeCompl A
  have hunit : IsUnit (DA x) := by
    rw [Stacks.DerivationExtension.locDeriv_algebraMap]
    exact IsLocalization.map_units A (⟨D f, hq⟩ : p.primeCompl)
  have : IsRegularRing A :=
    (IsLocalRing.isRegularRing_tfae (R := A)).out 1 3 |>.mp
      (inferInstance : IsRegularLocalRing A)
  let J : Ideal A := I.map (algebraMap R A)
  have hJ : J = Ideal.span {x} := by simp [J, I, x, Ideal.map_span]
  have hreg : IsRegularRing (A ⧸ J) := by
    rw [hJ]
    exact isRegularRing_quotient_span_singleton_of_isUnit_derivation x DA
      (hunit.map (Ideal.Quotient.mk _))
  obtain ⟨e⟩ := nonempty_ringEquiv_localization_quotient I q.asIdeal
  have : IsLocalRing (A ⧸ J) := e.symm.isLocalRing
  have : IsRegularLocalRing (A ⧸ J) := IsRegularLocalRing.of_isRegularRing_of_isLocalRing _
  exact IsRegularLocalRing.of_ringEquiv e

private theorem coeff_mapCoeffsDerivation {R : Type*} [CommRing R]
    (D : Derivation ℤ R R) (f : Polynomial R) (n : ℕ) :
    (mapCoeffsDerivation D f).coeff n = D (f.coeff n) := rfl

/-- Applying a derivation to the coefficients of a monic polynomial lowers its degree. -/
private theorem degree_mapCoeffsDerivation_lt {R : Type*} [CommRing R] [Nontrivial R]
    (D : Derivation ℤ R R) {f : Polynomial R} (hf : f.Monic) :
    (mapCoeffsDerivation D f).degree < f.degree := by
  rw [Polynomial.degree_eq_natDegree hf.ne_zero, Polynomial.degree_lt_iff_coeff_zero]
  intro n hn
  rw [coeff_mapCoeffsDerivation]
  rcases eq_or_lt_of_le hn with rfl | hn
  · rw [Polynomial.coeff_natDegree, hf.leadingCoeff, D.map_one_eq_zero]
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hn, map_zero]

/-- An irreducible inseparable polynomial has a coefficient which is not a p-th power. -/
private theorem exists_coeff_not_pow_of_irreducible_derivative_eq_zero
    {K : Type*} [Field K] {p : ℕ} [Fact p.Prime] [CharP K p]
    {f : Polynomial K} (hf : Irreducible f) (hd : f.derivative = 0) :
    ∃ n : ℕ, ¬ ∃ a : K, f.coeff n = a ^ p := by
  classical
  by_contra h
  push Not at h
  have hp := (Fact.out : p.Prime)
  have hmem : f.contract p ∈ (Polynomial.mapRingHom (frobenius K p)).range := by
    refine (Polynomial.mem_map_range _).mpr fun n => ?_
    obtain ⟨a, ha⟩ := h (n * p)
    exact ⟨a, by simpa [Polynomial.coeff_contract hp.ne_zero, frobenius_def] using ha.symm⟩
  obtain ⟨g, hg⟩ := hmem
  have heq : f = g ^ p := by
    rw [← Polynomial.map_frobenius_expand, Polynomial.map_expand,
      show g.map (frobenius K p) = f.contract p from hg]
    exact (Polynomial.expand_contract p hd hp.ne_zero).symm
  rw [heq] at hf
  exact not_irreducible_pow hp.ne_one hf

/-- A nonzero polynomial of degree below a monic equation stays nonzero in its quotient. -/
private theorem quotient_mk_ne_zero_of_degree_lt {B : Type*} [CommRing B] [IsDomain B]
    {f g : Polynomial B} (hg : g ≠ 0) (hdeg : g.degree < f.degree) :
    Ideal.Quotient.mk (Ideal.span {f}) g ≠ 0 := by
  intro h
  have hdvd : f ∣ g := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h)
  exact (not_le_of_gt hdeg) (Polynomial.degree_le_of_dvd hdvd hg)

/-- Ring isomorphisms preserve the existence of a regular open subset. -/
private theorem isJ0_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (hR : IsJ0 R) : IsJ0 S := by
  obtain ⟨U, hU, hne, hreg⟩ := hR
  let h := PrimeSpectrum.homeomorphOfRingEquiv e
  refine ⟨h.symm ⁻¹' U, hU.preimage h.symm.continuous, ?_, ?_⟩
  · obtain ⟨p, hp⟩ := hne
    exact ⟨h p, by simpa using hp⟩
  · intro p hp
    have : IsRegularLocalRing (Localization.AtPrime (h.symm p).asIdeal) := hreg hp
    exact IsRegularLocalRing.of_ringEquiv
      (Localization.localRingEquiv (h.symm p).asIdeal p.asIdeal e rfl)

/-- A monogenic integral domain over a regular algebra over a complete local ring is J-0
in prime characteristic. -/
private theorem isJ0_of_isRegularRing_adjoin_eq_top
    {T B S : Type*} [CommRing T] [IsNoetherianRing T] [IsLocalRing T]
    [IsAdicComplete (IsLocalRing.maximalIdeal T) T]
    [CommRing B] [IsDomain B] [IsRegularRing B]
    [Algebra T B] [Algebra.FiniteType T B]
    {p : ℕ} [Fact p.Prime] [CharP B p]
    [CommRing S] [IsDomain S] [Algebra B S] [FaithfulSMul B S]
    (x : S) (hx : IsIntegral B x) (hgen : Algebra.adjoin B {x} = ⊤) :
    IsJ0 S := by
  have : IsIntegrallyClosed B := IsRegularRing.isIntegrallyClosed B
  let f := minpoly B x
  let H := IsAdjoinRootMonic.mkOfAdjoinEqTop hx hgen
  let e : (Polynomial B ⧸ Ideal.span {f}) ≃ₐ[B] S := H.toIsAdjoinRoot.adjoinRootAlgEquiv
  have : IsDomain (Polynomial B ⧸ Ideal.span {f}) :=
    Function.Injective.isDomain e.toRingHom e.injective
  apply isJ0_of_ringEquiv e.toRingEquiv
  by_cases hd : f.derivative = 0
  · let := FractionRing.liftAlgebra B (FractionRing S)
    have : IsScalarTower B (FractionRing B) (FractionRing S) :=
      FractionRing.isScalarTower_liftAlgebra B (FractionRing S)
    have hxf : IsIntegral (FractionRing B) (algebraMap S (FractionRing S) x) :=
      (hx.map (IsScalarTower.toAlgHom B S (FractionRing S))).tower_top
    have hfm : Irreducible (f.map (algebraMap B (FractionRing B))) := by
      rw [← minpoly.isIntegrallyClosed_eq_field_fractions (FractionRing B) (FractionRing S) hx]
      exact minpoly.irreducible hxf
    have hfd : (f.map (algebraMap B (FractionRing B))).derivative = 0 := by
      rw [Polynomial.derivative_map, hd, Polynomial.map_zero]
    obtain ⟨n, hn⟩ := exists_coeff_not_pow_of_irreducible_derivative_eq_zero hfm hfd
    obtain ⟨D, hD⟩ :=
      exists_derivation_apply_ne_zero_of_not_pow_fractionRing
        (R := T) (K := FractionRing B) (f.coeff n) (by simpa using hn)
    apply isJ0_quotient_span_singleton_of_derivation f (mapCoeffsDerivation D)
    refine quotient_mk_ne_zero_of_degree_lt (fun h => hD ?_)
      (degree_mapCoeffsDerivation_lt D (minpoly.monic hx))
    exact (congrArg (·.coeff n) h).trans (Polynomial.coeff_zero n)
  · exact isJ0_quotient_span_singleton_of_derivation f (Polynomial.derivative'.restrictScalars ℤ)
      (quotient_mk_ne_zero_of_degree_lt hd (Polynomial.degree_derivative_lt (minpoly.ne_zero hx)))

/-- Localizing the base of a monogenic algebra preserves its generator. -/
private theorem adjoin_eq_top_of_isLocalizationAway
    {B S Bf Sf : Type*} [CommRing B] [CommRing S] [CommRing Bf] [CommRing Sf]
    [Algebra B S] [Algebra B Bf] [Algebra S Sf] [Algebra B Sf] [Algebra Bf Sf]
    [IsScalarTower B S Sf] [IsScalarTower B Bf Sf]
    (f : B) [IsLocalization.Away f Bf]
    [IsLocalization.Away (algebraMap B S f) Sf]
    (x : S) (hgen : Algebra.adjoin B {x} = ⊤) :
    Algebra.adjoin Bf {algebraMap S Sf x} = ⊤ := by
  let C := Algebra.adjoin Bf {algebraMap S Sf x}
  have hnum : ∀ s : S, algebraMap S Sf s ∈ C := by
    have hle : Algebra.adjoin B {x} ≤
        (C.restrictScalars B).comap (IsScalarTower.toAlgHom B S Sf) := by
      apply Algebra.adjoin_le
      rintro _ rfl
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    exact fun s => hle (hgen ▸ Algebra.mem_top)
  refine top_unique fun y _ => ?_
  obtain ⟨n, s, hs⟩ := IsLocalization.Away.surj (algebraMap B S f) y
  let z : Bf := IsLocalization.Away.invSelf f
  have hz : algebraMap S Sf (algebraMap B S f) * algebraMap Bf Sf z = 1 := by
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply B Bf Sf,
      ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
  have hy : y = algebraMap S Sf s * algebraMap Bf Sf z ^ n := by
    rw [← hs, mul_assoc, ← mul_pow, hz, one_pow, mul_one]
  rw [hy]
  exact C.mul_mem (hnum s) (C.pow_mem (C.algebraMap_mem z) n)

/-- The J-0 property ascends through a monogenic integral extension of algebras over a
complete local ring in prime characteristic. -/
private theorem isJ0_of_adjoin_eq_top
    {T B S : Type*} [CommRing T] [IsNoetherianRing T] [IsLocalRing T]
    [IsAdicComplete (IsLocalRing.maximalIdeal T) T]
    [CommRing B] [IsDomain B] [IsNoetherianRing B]
    [Algebra T B] [Algebra.FiniteType T B]
    {p : ℕ} [Fact p.Prime] [CharP B p]
    [CommRing S] [IsDomain S] [Algebra B S] [FaithfulSMul B S]
    (hB : IsJ0 B)
    (x : S) (hx : IsIntegral B x) (hgen : Algebra.adjoin B {x} = ⊤) :
    IsJ0 S := by
  obtain ⟨f, hf, hreg⟩ := exists_regular_localizationAway B hB
  let Bf := Localization.Away f
  let g : S := algebraMap B S f
  let Sf := Localization.Away g
  have hg : g ≠ 0 := by
    simpa [g] using (FaithfulSMul.algebraMap_injective B S).ne hf
  have : IsDomain Bf := IsLocalization.Away.isDomain Bf hf
  have : IsDomain Sf := IsLocalization.Away.isDomain Sf hg
  have : IsRegularRing Bf := hreg
  let : Algebra Bf Sf :=
    (IsLocalization.Away.map Bf Sf (algebraMap B S) f).toAlgebra
  have : IsScalarTower B Bf Sf := IsScalarTower.of_algebraMap_eq' (by
    change (algebraMap S Sf).comp (algebraMap B S) =
      (IsLocalization.Away.map Bf Sf (algebraMap B S) f).comp (algebraMap B Bf)
    exact (IsLocalization.map_comp _).symm)
  have : FaithfulSMul B Sf :=
    (faithfulSMul_iff_algebraMap_injective B Sf).mpr
      ((IsLocalization.injective Sf (powers_le_nonZeroDivisors_of_noZeroDivisors hg)).comp
        (FaithfulSMul.algebraMap_injective B S))
  have : FaithfulSMul Bf Sf :=
    (faithfulSMul_iff_algebraMap_injective Bf Sf).mpr
      ((IsLocalization.Away.map_injective_iff Sf (algebraMap B S) f).mpr
        (fun a ha => ⟨0, by
          simpa using (FaithfulSMul.algebraMap_injective B S)
            (ha.trans (map_zero _).symm)⟩))
  have : Algebra.FiniteType T Bf := Algebra.FiniteType.trans
    (inferInstance : Algebra.FiniteType T B)
    (IsLocalization.finiteType_of_monoid_fg (Submonoid.powers f) Bf)
  have : CharP Bf p := charP_of_injective_algebraMap
    (IsLocalization.injective Bf (powers_le_nonZeroDivisors_of_noZeroDivisors hf)) p
  have hxf : IsIntegral Bf (algebraMap S Sf x) :=
    (hx.map (IsScalarTower.toAlgHom B S Sf)).tower_top
  exact isJ0_of_isLocalizationAway S Sf g
    (isJ0_of_isRegularRing_adjoin_eq_top (T := T) (p := p)
      (algebraMap S Sf x) hxf (adjoin_eq_top_of_isLocalizationAway f x hgen))

/-- Finite domain extensions of a J-0 complete local domain are J-0 in prime characteristic. -/
private theorem isJ0_of_finite_of_charP
    {B S : Type*} [CommRing B] [IsNoetherianRing B] [IsLocalRing B]
    [IsAdicComplete (IsLocalRing.maximalIdeal B) B]
    [CommRing S] [IsDomain S] [Algebra B S] [Module.Finite B S]
    [FaithfulSMul B S] {p : ℕ} [Fact p.Prime] [CharP S p]
    (hB : IsJ0 B) : IsJ0 S := by
  have hsub : ∀ C : Subalgebra B S, IsJ0 C := by
    apply Subalgebra.induction_on_adjoin
    · exact isJ0_of_ringEquiv (Algebra.botEquivOfInjective
        (FaithfulSMul.algebraMap_injective B S)).symm.toRingEquiv hB
    · intro C x hC
      have : Module.Finite B C := Module.Finite.of_injective C.val.toLinearMap
        Subtype.val_injective
      have : IsNoetherianRing C := IsNoetherianRing.of_finite B C
      have : CharP C p := C.val.toRingHom.charP Subtype.val_injective p
      let E := Algebra.adjoin B (insert x (C : Set S))
      have hCE : C ≤ E :=
        fun z hz => Algebra.subset_adjoin (Set.mem_insert_of_mem x hz)
      let : Algebra C E := (Subalgebra.inclusion hCE).toAlgebra
      have : IsScalarTower B C E := IsScalarTower.of_algebraMap_eq' rfl
      have : FaithfulSMul C E := (faithfulSMul_iff_algebraMap_injective C E).mpr
        (Subalgebra.inclusion_injective hCE)
      have : Module.Finite B E := Module.Finite.of_injective E.val.toLinearMap
        Subtype.val_injective
      let y : E := ⟨x, Algebra.subset_adjoin (Set.mem_insert x _)⟩
      have hy : IsIntegral C y := (Algebra.IsIntegral.isIntegral (R := B) y).tower_top
      have hgen : Algebra.adjoin C {y} = ⊤ := by
        let D := (Algebra.adjoin C {y}).restrictScalars B
        have hle : E ≤ D.map E.val := by
          apply Algebra.adjoin_le
          rintro z (rfl | hz)
          · exact ⟨y, Algebra.subset_adjoin (Set.mem_singleton _), rfl⟩
          · exact ⟨algebraMap C E ⟨z, hz⟩, (Algebra.adjoin C {y}).algebraMap_mem _, rfl⟩
        refine top_unique fun z _ => ?_
        obtain ⟨a, ha, he⟩ := hle z.property
        obtain rfl : a = z := Subtype.ext he
        exact ha
      exact isJ0_of_adjoin_eq_top (T := B) (p := p) hC y hy hgen
  exact isJ0_of_ringEquiv (Subalgebra.topEquiv : (⊤ : Subalgebra B S) ≃ₐ[B] S).toRingEquiv
    (hsub ⊤)

/-- **Stacks 07PI.** A Noetherian local domain complete for its maximal-ideal-adic topology is
J-0. -/
@[stacks 07PI]
public theorem isJ0_of_isPrecomplete_maximalIdeal
    (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] [IsDomain R]
    [IsPrecomplete (IsLocalRing.maximalIdeal R) R] : IsJ0 R := by
  have : IsAdicComplete (IsLocalRing.maximalIdeal R) R := ⟨⟩
  obtain ⟨p, _⟩ := CharP.exists R
  rcases CharP.char_is_prime_or_zero R p with hp | rfl
  · have : Fact p.Prime := ⟨hp⟩
    obtain ⟨d, Λ, _, _, _, hreg, hcomplete, f, hinj, hfin, _⟩ :=
      IsLocalRing.exists_injective_finite_mvPowerSeries R
    let B := MvPowerSeries (Fin d) Λ
    let : Algebra B R := f.toAlgebra
    have : Module.Finite B R := hfin
    have : FaithfulSMul B R := (faithfulSMul_iff_algebraMap_injective B R).mpr hinj
    have : IsRegularLocalRing B := hreg
    have : IsAdicComplete (IsLocalRing.maximalIdeal B) B := hcomplete
    exact isJ0_of_finite_of_charP (p := p) (isJ0_of_isRegularLocalRing B)
  · have : CharZero R := CharP.charP_to_charZero R
    exact isJ0_of_isPrecomplete_maximalIdeal_of_charZero R

end

end

