open IsLocalRing

private theorem derivation_mem_of_mem_sq {A : Type*} [CommRing A] [IsLocalRing A]
    (D : Derivation ℤ A A) {x : A} (hx : x ∈ maximalIdeal A ^ 2) :
    D x ∈ maximalIdeal A := by
  rw [pow_two] at hx
  induction hx using Submodule.mul_induction_on' with
  | mem_mul_mem a ha b hb =>
      rw [D.leibniz]
      exact add_mem (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
  | add x y hx hy ihx ihy => simpa using add_mem ihx ihy

private theorem nontrivial_quotient_span_singleton {A : Type*} [CommRing A] [IsLocalRing A]
    {x : A} (hx : x ∈ maximalIdeal A) : Nontrivial (A ⧸ Ideal.span {x}) :=
  Submodule.Quotient.nontrivial_iff.mpr fun h =>
    (mem_maximalIdeal x).mp hx (Ideal.span_singleton_eq_top.mp h)


/-- Localizing `R ⧸ I` at a prime `q` is the quotient of the localization of `R` at the preimage
of `q` by the extension of `I`. -/
private theorem nonempty_ringEquiv_localization_quotient {R : Type*} [CommRing R] (I : Ideal R)
    (q : Ideal (R ⧸ I)) [q.IsPrime] :
    Nonempty ((Localization.AtPrime (q.comap (Ideal.Quotient.mk I)) ⧸
      I.map (algebraMap R (Localization.AtPrime (q.comap (Ideal.Quotient.mk I))))) ≃+*
      Localization.AtPrime q) := by
  let π : R →+* R ⧸ I := Ideal.Quotient.mk I
  let p : Ideal R := q.comap π
  let A := Localization.AtPrime p
  let J : Ideal A := I.map (algebraMap R A)
  have hloc : IsLocalization (Algebra.algebraMapSubmonoid (R ⧸ I) p.primeCompl) (A ⧸ J) :=
    IsLocalization.of_surjective p.primeCompl A π Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective rfl (fun a ha => by
        change a ∈ (RingHom.ker π).map (algebraMap R A)
        rw [show RingHom.ker π = I from Ideal.mk_ker]
        exact Ideal.Quotient.eq_zero_iff_mem.mp ha)
  have hsub : Algebra.algebraMapSubmonoid (R ⧸ I) p.primeCompl = q.primeCompl := by
    ext y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
    constructor
    · rintro ⟨s, hs, heq⟩ hqr
      exact hs (show π s ∈ q by rwa [show π s = π r from heq])
    · exact fun hr => ⟨r, hr, rfl⟩
  rw [hsub] at hloc
  exact ⟨(IsLocalization.algEquiv q.primeCompl (A ⧸ J) (Localization.AtPrime q)).toRingEquiv⟩


/-- The Jacobian criterion for hypersurfaces: if some derivation sends `f` to a
unit modulo `(f)`, then the quotient of a regular ring by `(f)` is regular. -/
@[stacks 07PF]
public theorem isRegularRing_quotient_span_singleton_of_isUnit_derivation
    {R : Type*} [CommRing R] [IsRegularRing R] (f : R) (D : Derivation ℤ R R)
    (hD : IsUnit (Ideal.Quotient.mk (Ideal.span {f}) (D f))) :
    IsRegularRing (R ⧸ Ideal.span {f}) := by
  rw [isRegularRing_iff]
  intro q hq
  let I : Ideal R := Ideal.span {f}
  let π : R →+* R ⧸ I := Ideal.Quotient.mk I
  let p : Ideal R := q.comap π
  let A := Localization.AtPrime p
  have : p.IsPrime := Ideal.IsPrime.comap π
  let x : A := algebraMap R A f
  have hf : f ∈ p := by
    change π f ∈ q
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)]
    exact q.zero_mem
  have hx : x ∈ maximalIdeal A := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p]
    exact Ideal.mem_map_of_mem (algebraMap R A) hf
  let DA := Stacks.DerivationExtension.locDeriv D p.primeCompl A
  have hDf : D f ∉ p := fun hmem =>
    hq.ne_top (q.eq_top_of_isUnit_mem (show Ideal.Quotient.mk I (D f) ∈ q from hmem) hD)
  have hunit : IsUnit (algebraMap R A (D f)) :=
    IsLocalization.map_units A (⟨D f, hDf⟩ : p.primeCompl)
  have hx2 : x ∉ maximalIdeal A ^ 2 := fun hxsq =>
    (mem_maximalIdeal _).mp ((Stacks.DerivationExtension.locDeriv_algebraMap D p.primeCompl A f) ▸
      derivation_mem_of_mem_sq DA hxsq) hunit
  let J : Ideal A := I.map (algebraMap R A)
  have hJ : J = Ideal.span {x} := by
    simp [J, I, x, Ideal.map_span]
  have hreg : IsRegularLocalRing (A ⧸ J) := by
    rw [hJ]
    exact Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton hx hx2
  obtain ⟨e⟩ := nonempty_ringEquiv_localization_quotient I q
  exact IsRegularLocalRing.of_ringEquiv e

end

end

