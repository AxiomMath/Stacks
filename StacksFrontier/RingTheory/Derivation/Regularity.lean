private noncomputable def mapCoeffsDerivation {R : Type*} [CommRing R]
    (D : Derivation ℤ R R) : Derivation ℤ (Polynomial R) (Polynomial R) :=
  let E := PolynomialModule.equivPolynomialSelf.compDer D.mapCoeffs
  Derivation.mk' E.toLinearMap E.leibniz

/-- If a derivation of a regular ring sends `f` to a unit, then the quotient of
the polynomial ring by `p(X) - f` is regular for every integer polynomial `p`.
In particular, this applies to `p = X ^ n` for every positive integer `n`. -/
@[stacks 07PG]
public theorem isRegularRing_quotient_polynomial_sub_C_of_isUnit_derivation
    {R : Type*} [CommRing R] [IsRegularRing R] (f : R) (D : Derivation ℤ R R)
    (hD : IsUnit (D f)) (p : Polynomial ℤ) :
    IsRegularRing
      (Polynomial R ⧸ Ideal.span
        {p.map (algebraMap ℤ R) - Polynomial.C f}) := by
  apply isRegularRing_quotient_span_singleton_of_isUnit_derivation
    (p.map (algebraMap ℤ R) - Polynomial.C f) (mapCoeffsDerivation D)
  have hp : mapCoeffsDerivation D (p.map (algebraMap ℤ R)) = 0 := by
    ext n
    change D ((p.map (algebraMap ℤ R)).coeff n) = 0
    simp
  have hf : mapCoeffsDerivation D (Polynomial.C f) = Polynomial.C (D f) := by
    ext n
    simp [mapCoeffsDerivation]
  have hg : mapCoeffsDerivation D
      (p.map (algebraMap ℤ R) - Polynomial.C f) = -Polynomial.C (D f) := by
    rw [(mapCoeffsDerivation D).map_sub, hp, hf, zero_sub]
  exact hg ▸ (hD.map Polynomial.C).neg.map
    (Ideal.Quotient.mk (Ideal.span {p.map (algebraMap ℤ R) - Polynomial.C f}))

end

end

