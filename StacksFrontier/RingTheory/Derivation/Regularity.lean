open IsLocalRing Module Submodule
open Stacks.RegularLocalRing.SpanFinrank

private noncomputable def derivationCotangent
    {R : Type*} [CommRing R] [IsLocalRing R] (D : Derivation ℤ R R) :
    CotangentSpace R →ₗ[R ⧸ maximalIdeal R] R ⧸ maximalIdeal R := by
  let g : maximalIdeal R →ₗ[R] R ⧸ maximalIdeal R :=
    { toFun := fun x => Ideal.Quotient.mk (maximalIdeal R) (D x)
      map_add' := fun x y => by
        change Ideal.Quotient.mk _ (D ((x : R) + y)) = _
        rw [D.map_add, map_add]
      map_smul' := fun a x => by
        change Ideal.Quotient.mk _ (D (a * (x : R))) =
          Ideal.Quotient.mk _ a * Ideal.Quotient.mk _ (D x)
        rw [D.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
          Ideal.Quotient.eq_zero_iff_mem.mpr x.2, zero_mul, add_zero] }
  let g' : CotangentSpace R →ₗ[R] R ⧸ maximalIdeal R := Ideal.Cotangent.lift g fun x y => by
    change Ideal.Quotient.mk _ (D ((x : R) * y)) = 0
    rw [D.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul,
      Ideal.Quotient.eq_zero_iff_mem.mpr x.2,
      Ideal.Quotient.eq_zero_iff_mem.mpr y.2]
    simp
  exact g'.extendScalarsOfSurjective Ideal.Quotient.mk_surjective

@[simp] private lemma derivationCotangent_toCotangent
    {R : Type*} [CommRing R] [IsLocalRing R] (D : Derivation ℤ R R) (x : maximalIdeal R) :
    derivationCotangent D ((maximalIdeal R).toCotangent x) =
      Ideal.Quotient.mk (maximalIdeal R) (D x) := rfl

/-- A finite family in the maximal ideal of a regular local ring is a regular sequence and has
regular local quotient if its values under a family of derivations form a matrix with unit
determinant. -/
@[stacks 0GEE]
public theorem isRegularLocalRing_quotient_span_range_and_isRegular_of_isUnit_det_derivation
    {R : Type*} [CommRing R] [IsRegularLocalRing R] {m : ℕ} (f : Fin m → R)
    (hf : ∀ i, f i ∈ IsLocalRing.maximalIdeal R) (D : Fin m → Derivation ℤ R R)
    (hD : IsUnit (Matrix.det fun i j => D i (f j))) :
    IsRegularLocalRing (R ⧸ Ideal.span (Set.range f)) ∧
      RingTheory.Sequence.IsRegular R (List.ofFn f) := by
  classical
  let fm : Fin m → maximalIdeal R := fun i => ⟨f i, hf i⟩
  let A : Matrix (Fin m) (Fin m) (ResidueField R) :=
    fun i j => Ideal.Quotient.mk (maximalIdeal R) (D i (f j))
  have hA : IsUnit A.det := by
    have hu := hD.map (Ideal.Quotient.mk (maximalIdeal R))
    rwa [RingHom.map_det (Ideal.Quotient.mk (maximalIdeal R))
      (fun i j => D i (f j) : Matrix (Fin m) (Fin m) R)] at hu
  have hli : LinearIndependent (ResidueField R)
      (fun i => (maximalIdeal R).toCotangent (fm i)) := by
    let δ : Fin m → CotangentSpace R →ₗ[ResidueField R] ResidueField R :=
      fun i => derivationCotangent (D i)
    refine LinearIndependent.of_comp (LinearMap.pi δ) ?_
    rw [show ((LinearMap.pi δ) ∘
        fun j => (maximalIdeal R).toCotangent (fm j)) = A.col from rfl]
    exact Matrix.mulVec_injective_iff.mp
      (Matrix.toLinearEquiv' A (Matrix.invertibleOfIsUnitDet A hA)).injective
  obtain ⟨b, hb⟩ :=
    Stacks.RegularLocalRing.RegularQuotient.exists_span_range_union_range_eq_top hli
  choose y hy using fun j => (maximalIdeal R).toCotangent_surjective (b j)
  let xs := List.ofFn f ++ List.ofFn (fun j => ((y j : maximalIdeal R) : R))
  have hxs : Ideal.ofList xs = maximalIdeal R := by
    have hS : span R (Set.range fm ∪ Set.range y) = (⊤ : Submodule R (maximalIdeal R)) := by
      refine CotangentSpace.span_image_eq_top_iff.mp ?_
      rw [Set.image_union]
      have h₁ : (maximalIdeal R).toCotangent '' Set.range fm =
          Set.range (fun i => (maximalIdeal R).toCotangent (fm i)) := by
        ext z
        simp
      have h₂ : (maximalIdeal R).toCotangent '' Set.range y = Set.range b := by
        rw [show b = fun j => (maximalIdeal R).toCotangent (y j) from funext fun j => (hy j).symm]
        ext z
        simp
      rw [h₁, h₂]
      exact hb
    have h3 := congrArg (Submodule.map (maximalIdeal R).subtype) hS
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, Set.image_union,
      ← Set.range_comp, ← Set.range_comp, Ideal.submodule_span_eq] at h3
    change Ideal.span {r : R | r ∈ xs} = maximalIdeal R
    rw [show {r : R | r ∈ xs} = Set.range ((maximalIdeal R).subtype ∘ fm) ∪
        Set.range ((maximalIdeal R).subtype ∘ y) by
      ext r
      simp [xs, fm, Function.comp_def]]
    exact h3
  have hlen : xs.length = (maximalIdeal R).spanFinrank := by
    simp only [xs, List.length_append, List.length_ofFn]
    rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    exact Nat.add_sub_of_le (by simpa using hli.fintype_card_le_finrank)
  obtain ⟨hreg, hquot⟩ :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      R).1 xs hxs hlen
  have htake : xs.take m = List.ofFn f := by simp [xs]
  rw [← Ideal.ofList_ofFn]
  exact ⟨htake ▸ (hquot m (by simp [xs])).1, htake ▸ isRegular_take xs hreg m⟩

end

end

