section

section

universe u v

private lemma isJ0_of_isRegularRing_07pj (R : Type*) [CommRing R] [IsRegularRing R]
    [Nontrivial R] : IsJ0 R :=
  ⟨Set.univ, isOpen_univ, Set.univ_nonempty, fun p _ =>
    IsRegularRing.isRegularLocalRing_localization p.asIdeal⟩

private lemma isJ2_of_field (K : Type u) [Field K] : IsJ2 K := by
  apply ((isJ2_tfae K).out 3 1).mp
  intro S _ _ _
  have : IsArtinianRing S := IsArtinianRing.of_finite K S
  exact isOpen_discrete _

private lemma isJ0_of_finite_primeSpectrum (R : Type*) [CommRing R] [IsDomain R]
    [Finite (PrimeSpectrum R)] : IsJ0 R := by
  let p : PrimeSpectrum R := ⟨⊥, inferInstance⟩
  have hp : IsOpen ({p} : Set (PrimeSpectrum R)) := by
    rw [isOpen_iff_forall_specializes]
    rintro x y hxy rfl
    have hxp := (PrimeSpectrum.le_iff_specializes x p).mpr hxy
    exact Set.mem_singleton_iff.mpr (PrimeSpectrum.ext (le_bot_iff.mp hxp))
  refine ⟨{p}, hp, Set.singleton_nonempty p, ?_⟩
  rintro _ rfl
  change IsRegularLocalRing (Localization.AtPrime (⊥ : Ideal R))
  have : IsFractionRing R (Localization.AtPrime (⊥ : Ideal R)) := by
    simpa [Ideal.primeCompl_bot] using
      (inferInstance : IsLocalization (⊥ : Ideal R).primeCompl
        (Localization.AtPrime (⊥ : Ideal R)))
  let : Field (Localization.AtPrime (⊥ : Ideal R)) := IsFractionRing.toField R
  infer_instance

private lemma isJ2_of_finite_primeSpectrum (R : Type u) [CommRing R] [IsNoetherianRing R]
    [Finite (PrimeSpectrum R)] : IsJ2 R := by
  apply ((isJ2_tfae R).out 3 1).mp
  intro S _ _ _
  have : IsNoetherianRing S := IsNoetherianRing.of_finite R S
  have : Finite (PrimeSpectrum S) := Algebra.QuasiFinite.finite_primeSpectrum R S
  apply isJ1_of_forall_quotient_isJ0
  intro p
  have : Finite (PrimeSpectrum (S ⧸ p.asIdeal)) :=
    Finite.of_injective _ (PrimeSpectrum.comap_injective_of_surjective
      (Ideal.Quotient.mk p.asIdeal) Ideal.Quotient.mk_surjective)
  exact isJ0_of_finite_primeSpectrum _

private lemma isJ2_of_isLocalRing_of_krullDimLE_one (R : Type u) [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] [Ring.KrullDimLE 1 R] : IsJ2 R := by
  have hfinite : (Set.univ : Set (PrimeSpectrum R)).Finite := by
    apply Set.Finite.subset
      ((PrimeSpectrum.finite_setOfPred_isMin R).union
        (Set.finite_singleton (⟨IsLocalRing.maximalIdeal R, inferInstance⟩ : PrimeSpectrum R)))
    intro p _
    rcases Ring.krullDimLE_one_iff.mp ‹Ring.KrullDimLE 1 R› p.asIdeal p.isPrime with hp | hp
    · exact Or.inl (PrimeSpectrum.isMin_iff.mpr hp)
    · exact Or.inr (PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hp))
  have : Finite (PrimeSpectrum R) := Set.finite_univ_iff.mp hfinite
  exact isJ2_of_finite_primeSpectrum R

/-- **Stacks 07PJ.** A Nagata ring of Krull dimension at most one is J-2.

This is the Nagata case of `isJ2_of_standard_classes_and_finiteType`, stated with
`Ring.KrullDimLE 1` instead of `ringKrullDim R = 1`.  That is what the proof gives, and it is
the form a scheme of dimension one needs: the section ring of an affine open of a
one-dimensional scheme has Krull dimension *at most* one, and may well have dimension zero. -/
public lemma isJ2_of_isNagataRing_of_krullDimLE_one (R : Type u) [CommRing R]
    (hR : IsNagataRing R) [Ring.KrullDimLE 1 R] : IsJ2 R := by
  have : IsNoetherianRing R := hR.1
  apply ((isJ2_tfae R).out 4 1).mp
  intro p L _ _ _ _
  let : Algebra R L := ((algebraMap p.asIdeal.ResidueField L).comp
    (algebraMap R p.asIdeal.ResidueField)).toAlgebra
  let A := R ⧸ p.asIdeal
  let K := p.asIdeal.ResidueField
  let : Algebra A L := ((algebraMap K L).comp (algebraMap A K)).toAlgebra
  have : IsScalarTower A K L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R A L := by
    apply IsScalarTower.of_algebraMap_eq
    intro r
    change (algebraMap K L) ((algebraMap R K) r) =
      (algebraMap K L) ((algebraMap A K) ((algebraMap R A) r))
    rw [IsScalarTower.algebraMap_apply R A K]
  let B := integralClosure A L
  have : Module.Finite A B :=
    module_finite_integralClosure_of_isJapaneseRing (hR.2 p.asIdeal) K L
  have : IsNoetherianRing B := IsNoetherianRing.of_finite A B
  have : Ring.KrullDimLE 1 A := Ring.krullDimLE_iff.mpr
    ((ringKrullDim_quotient_le p.asIdeal).trans (Ring.krullDimLE_iff.mp ‹Ring.KrullDimLE 1 R›))
  have : Ring.DimensionLEOne A :=
    ⟨fun {I} hI hp => hp.isMaximal_of_ne_bot hI⟩
  have : IsIntegrallyClosed B := integralClosure.isIntegrallyClosedOfFiniteExtension K
  have : IsDedekindDomain B := {}
  let C : Subalgebra R L := B.restrictScalars R
  refine ⟨C, ?_, ?_, ?_⟩
  · change Module.Finite R B
    exact Module.Finite.trans A B
  · change IsJ0 B
    exact isJ0_of_isRegularRing_07pj B
  · change IsFractionRing B L
    exact integralClosure.isFractionRing_of_finite_extension K L

@[ega "IV 6.12.6" "clause (i), affine case",
  ega "IV 7.8.4" "partial",
  sga "5 I 3.1.1" "special case"]
private lemma isJ2_of_isDedekindDomain_of_charZero (R : Type u) [CommRing R]
    [IsDedekindDomain R] [CharZero R] : IsJ2 R := by
  classical
  apply ((isJ2_tfae R).out 4 1).mp
  intro p L _ _ _ _
  let K := p.asIdeal.ResidueField
  let : Algebra R L := ((algebraMap K L).comp (algebraMap R K)).toAlgebra
  have : IsScalarTower R K L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  by_cases hp : p.asIdeal = ⊥
  · have : IsFractionRing R K := by
      rcases p with ⟨p, hpprime⟩
      change p = ⊥ at hp
      subst p
      infer_instance
    have : CharZero K := IsFractionRing.charZero_of_isFractionRing R
    let e : K ≃ₐ[R] L := AlgEquiv.ofBijective (IsScalarTower.toAlgHom R K L)
      (IsPurelyInseparable.bijective_algebraMap_of_isSeparable K L)
    have : IsFractionRing R L := IsFractionRing.of_algEquiv e
    let C : Subalgebra R L := ⊥
    let f : C ≃ₐ[R] R := Algebra.botEquivOfInjective (IsFractionRing.injective R L)
    have : Module.Finite R C := Module.Finite.equiv f.symm.toLinearEquiv
    have : IsRegularRing C := IsRegularRing.of_ringEquiv f.symm.toRingEquiv
    refine ⟨C, inferInstance, isJ0_of_isRegularRing_07pj C, ?_⟩
    apply IsFractionRing.of_ringEquiv_left f.toRingEquiv
    intro x
    obtain ⟨r, rfl⟩ := f.symm.surjective x
    change (algebraMap C L) (f.symm r) = (algebraMap R L) (f (f.symm r))
    rw [f.apply_symm_apply]
    rfl
  · have : p.asIdeal.IsMaximal := p.isPrime.isMaximal hp
    have : Module.Finite R K := Module.Finite.of_surjective
      (Algebra.linearMap R K) (Ideal.algebraMap_residueField_surjective p.asIdeal)
    have : Module.Finite R L := Module.Finite.trans K L
    let C : Subalgebra R L := ⊤
    let e : C ≃ₐ[R] L := Subalgebra.topEquiv
    have : Module.Finite R C := Module.Finite.equiv e.symm.toLinearEquiv
    have : IsRegularRing C := IsRegularRing.of_ringEquiv e.symm.toRingEquiv
    refine ⟨C, inferInstance, isJ0_of_isRegularRing_07pj C, ?_⟩
    exact IsFractionRing.of_ringEquiv_left e.toRingEquiv fun _ => rfl

private lemma exists_ringEquiv_factor_of_isDomain {R : Type*} [CommRing R] [IsDomain R]
    {ι : Type*} (S : ι → Type*) [∀ i, CommRing (S i)] [∀ i, Nontrivial (S i)]
    (e : R ≃+* ∀ i, S i) : ∃ i, Nonempty (R ≃+* S i) := by
  classical
  have : IsDomain (∀ i, S i) := e.symm.toMulEquiv.isDomain
  have : Nonempty ι := by
    by_contra h
    have : IsEmpty ι := not_nonempty_iff.mp h
    exact zero_ne_one (Subsingleton.elim (0 : ∀ i, S i) 1)
  obtain ⟨i⟩ := ‹Nonempty ι›
  have hi : ∀ j, j = i := by
    intro j
    by_contra hji
    have hmul : (Pi.single i 1 : ∀ i, S i) * Pi.single j 1 = 0 := by
      ext k
      by_cases hki : k = i
      · subst k
        simp [Ne.symm hji]
      · simp [Pi.single_eq_of_ne hki]
    rcases mul_eq_zero.mp hmul with h | h
    · simpa using congrFun h i
    · simpa using congrFun h j
  let : Unique ι := ⟨⟨i⟩, hi⟩
  exact ⟨i, ⟨e.trans (RingEquiv.piUnique S)⟩⟩

private lemma isJ2_of_isPrecomplete_maximalIdeal (R : Type u) [CommRing R]
    [IsNoetherianRing R] [IsLocalRing R] [IsPrecomplete (IsLocalRing.maximalIdeal R) R] :
    IsJ2 R := by
  apply ((isJ2_tfae R).out 3 1).mp
  intro S _ _ _
  have : IsNoetherianRing S := IsNoetherianRing.of_finite R S
  apply isJ1_of_forall_quotient_isJ0
  intro p
  let A := S ⧸ p.asIdeal
  have : Module.Finite R A := Module.Finite.trans S A
  have hR : IsNoetherianCompleteLocalRing R :=
    ⟨inferInstance, inferInstance, IsAdicComplete.mk⟩
  obtain ⟨n, T, hT, hcomplete, ⟨e⟩⟩ :=
    finite_isProduct_isNoetherianCompleteLocalRing (S := A) hR
  let := hT
  have (i : Fin n) : IsLocalRing (T i) := (hcomplete i).isLocal
  obtain ⟨i, ⟨f⟩⟩ := exists_ringEquiv_factor_of_isDomain T e
  have : IsLocalRing A := RingEquiv.isLocalRing f.symm
  have : IsPrecomplete (IsLocalRing.maximalIdeal (T i)) (T i) :=
    (hcomplete i).isComplete.toIsPrecomplete
  have : IsPrecomplete (IsLocalRing.maximalIdeal A) A := by
    apply (IsPrecomplete.congr_ringEquiv _ f).mp
    rw [IsLocalRing.map_ringEquiv_maximalIdeal]
    infer_instance
  exact isJ0_of_isPrecomplete_maximalIdeal A

/-- Being J-1 is invariant under ring isomorphisms. -/
public lemma isJ1_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (h : IsJ1 R) : IsJ1 S := by
  have hopen := h.preimage (PrimeSpectrum.continuous_comap e.toRingHom)
  change IsOpen {p : PrimeSpectrum S | IsRegularLocalRing (Localization.AtPrime p.asIdeal)}
  convert hopen using 1
  ext p
  let f := IsLocalization.ringEquivOfRingEquiv
    (Localization.AtPrime (p.asIdeal.comap e)) (Localization.AtPrime p.asIdeal)
    e (e.map_primeCompl_comap_eq p.asIdeal)
  change IsRegularLocalRing (Localization.AtPrime p.asIdeal) ↔
    IsRegularLocalRing (Localization.AtPrime (p.asIdeal.comap e))
  exact ⟨fun _ => IsRegularLocalRing.of_ringEquiv f.symm,
    fun _ => IsRegularLocalRing.of_ringEquiv f⟩

private lemma isJ2_of_finiteType (R : Type u) (S : Type v) [CommRing R] [CommRing S]
    [Algebra R S] [Algebra.FiniteType R S] (h : IsJ2 R) : IsJ2 S := by
  intro T _ _ _
  let : Algebra R T := ((algebraMap S T).comp (algebraMap R S)).toAlgebra
  have : IsScalarTower R S T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Algebra.FiniteType R T := Algebra.FiniteType.trans
    (inferInstance : Algebra.FiniteType R S) (inferInstance : Algebra.FiniteType S T)
  have : Small.{u} T := Algebra.FiniteType.small (R := R)
  have : Algebra.FiniteType R (Shrink.{u} T) :=
    Algebra.FiniteType.equiv inferInstance (Shrink.algEquiv R T).symm
  exact isJ1_of_ringEquiv (Shrink.algEquiv R T).toRingEquiv (h (Shrink.{u} T))

/-- **Stacks 07PJ.** Fields, Noetherian complete local rings, the integers, one-dimensional
Noetherian local rings, one-dimensional Nagata rings, and characteristic-zero Dedekind domains
are J-2; moreover, every finite type algebra over a J-2 ring is J-2. -/
@[stacks 07PJ, ega "0 22.7.6", ega "IV 6.12.6" "(i)", sga "5 I 3.1.1" "affine case"]
public theorem isJ2_of_standard_classes_and_finiteType :
    (∀ (K : Type u) [Field K], IsJ2 K) ∧
    (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
      [IsPrecomplete (IsLocalRing.maximalIdeal R) R], IsJ2 R) ∧
    IsJ2 ℤ ∧
    (∀ (R : Type u) [CommRing R] [IsNoetherianRing R] [IsLocalRing R],
      ringKrullDim R = 1 → IsJ2 R) ∧
    (∀ (R : Type u) [CommRing R],
      IsNagataRing R → ringKrullDim R = 1 → IsJ2 R) ∧
    (∀ (R : Type u) [CommRing R] [IsDedekindDomain R] [CharZero R],
      IsJ2 R) ∧
    (∀ (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
      [Algebra.FiniteType R S], IsJ2 R → IsJ2 S) := by
  refine ⟨isJ2_of_field, isJ2_of_isPrecomplete_maximalIdeal,
    isJ2_of_isDedekindDomain_of_charZero ℤ, ?_, ?_,
    isJ2_of_isDedekindDomain_of_charZero, isJ2_of_finiteType⟩
  · intro R _ _ _ hdim
    have : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr (by simp [hdim])
    exact isJ2_of_isLocalRing_of_krullDimLE_one R
  · intro R _ hR hdim
    have : Ring.KrullDimLE 1 R := Ring.krullDimLE_iff.mpr (by simp [hdim])
    exact isJ2_of_isNagataRing_of_krullDimLE_one R hR

end

