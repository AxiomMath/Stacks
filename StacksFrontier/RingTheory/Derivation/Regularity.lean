@[expose] public section

universe u

private theorem exists_smul_range_of_finite
    {B K M : Type*} [CommRing B] [IsDomain B] [Field K]
    [Algebra B K] [IsFractionRing B K]
    [AddCommGroup M] [Module B M] [Module.Finite B M] (l : M →ₗ[B] K) :
    ∃ g : B, g ≠ 0 ∧ ∀ x, g • l x ∈ Set.range (algebraMap B K) := by
  classical
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := B) (M := M)
  obtain ⟨g, hg⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors B) s l
  refine ⟨g, nonZeroDivisors.ne_zero g.property, fun x => ?_⟩
  have hx : x ∈ Submodule.span B (s : Set M) := hs ▸ Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy => exact hg y hy
  | zero => exact ⟨0, by simp⟩
  | add y z _ _ hy hz =>
    obtain ⟨a, ha⟩ := hy
    obtain ⟨b, hb⟩ := hz
    exact ⟨a + b, by simp [ha, hb, smul_add]⟩
  | smul a y _ hy =>
    obtain ⟨b, hb⟩ := hy
    refine ⟨a * b, ?_⟩
    simpa only [map_mul, hb, map_smul, Algebra.smul_def] using
      mul_left_comm (algebraMap B K a) (algebraMap B K g) (l y)

private theorem exists_derivation_of_range
    {B K : Type*} [CommRing B] [IsDomain B] [Field K]
    [Algebra B K] [IsFractionRing B K] (D : Derivation ℤ B K)
    (hD : ∀ b, D b ∈ Set.range (algebraMap B K)) :
    ∃ d : Derivation ℤ B B, ∀ b, algebraMap B K (d b) = D b := by
  classical
  choose d hd using hD
  have hi := IsFractionRing.injective B K
  refine ⟨{
    toFun := d
    map_add' := fun x y => hi (by simp only [map_add, hd])
    map_smul' := fun n x => hi (by simp only [map_zsmul, hd, RingHom.id_apply, D.map_smul])
    map_one_eq_zero' := hi (by
      change algebraMap B K (d 1) = algebraMap B K 0
      rw [hd, D.map_one_eq_zero, map_zero])
    leibniz' := fun x y => hi (by
      change algebraMap B K (d (x * y)) = algebraMap B K (x * d y + y * d x)
      simp only [map_add, map_mul, hd, D.leibniz, Algebra.smul_def])
    }, hd⟩

private theorem exists_derivation_apply_ne_zero_of_finiteType
    {A B K : Type*} [CommRing A] [CommRing B] [IsDomain B]
    [Field K] [Algebra A B] [Algebra B K] [IsFractionRing B K]
    [Algebra A K] [IsScalarTower A B K] [Algebra.FiniteType A B]
    (D : Derivation A B K) (f : B) (hf : D f ≠ 0) :
    ∃ d : Derivation ℤ B B, d f ≠ 0 := by
  obtain ⟨g, hg, h⟩ := exists_smul_range_of_finite D.liftKaehlerDifferential
  have h' : ∀ b : B, (g • D.restrictScalars ℤ) b ∈ Set.range (algebraMap B K) := by
    intro b
    simpa using h (KaehlerDifferential.D A B b)
  obtain ⟨d, hd⟩ := exists_derivation_of_range (g • D.restrictScalars ℤ) h'
  refine ⟨d, fun hz => ?_⟩
  have hgf := hd f
  simp only [hz, map_zero, Derivation.smul_apply, Derivation.restrictScalars_apply,
    Algebra.smul_def] at hgf
  exact (mul_ne_zero
    ((map_ne_zero_iff (algebraMap B K) (IsFractionRing.injective B K)).2 hg) hf) hgf.symm

private theorem exists_derivation_apply_ne_zero_of_vanishes
    {A B L : Type*} [CommRing A] [CommRing B] [IsDomain B]
    [Field L] [Algebra A B] [Algebra B L] [IsFractionRing B L]
    [Algebra A L] [IsScalarTower A B L] [Algebra.FiniteType A B]
    (D : Derivation ℤ L L) (hD : ∀ a : A, D (algebraMap A L a) = 0)
    (f : B) (hf : D (algebraMap B L f) ≠ 0) :
    ∃ d : Derivation ℤ B B, d f ≠ 0 := by
  let E : Derivation A B L := {
    toFun := fun b => D (algebraMap B L b)
    map_add' := by intros; simp
    map_smul' := by
      intro a b
      simp only [Algebra.smul_def, map_mul, D.leibniz,
        ← IsScalarTower.algebraMap_apply A B L, hD, mul_zero, add_zero,
        RingHom.id_apply, Algebra.algebraMap_self]
    map_one_eq_zero' := by simp
    leibniz' := by
      intros
      simp only [LinearMap.coe_mk, AddHom.coe_mk, map_mul, D.leibniz,
        Algebra.smul_def, Algebra.algebraMap_self, RingHom.id_apply] }
  exact exists_derivation_apply_ne_zero_of_finiteType E f hf

private theorem exists_derivation_apply_ne_zero_of_iInf
    {p : ℕ} [Fact p.Prime] {L : Type*} [Field L] [CharP L p]
    [Algebra (ZMod p) L] {I : Type*} (F : I → IntermediateField (ZMod p) L)
    (hpow : ∀ i, (frobenius L p).fieldRange ≤ (F i).toSubfield)
    (hiInf : (frobenius L p).fieldRange = ⨅ i, (F i).toSubfield)
    (hdir : ∀ i j, ∃ k, F k ≤ F i ⊓ F j)
    (f : L) (hf : ¬ ∃ x : L, f = x ^ p) :
    ∃ i, ∃ D : Derivation (F i) L L, D f ≠ 0 := by
  classical
  have hdf : KaehlerDifferential.D (ZMod p) L f ≠ 0 := fun h =>
    hf (((KaehlerDifferential.D_eq_zero_iff_exists_pow_eq p f).mp h).imp fun _ => Eq.symm)
  have hker :=
    (iInf_ker_kaehlerDifferentialMap_eq_bot_and_frobeniusFieldRange_eq_iInf.{_, _, 0}
      F hpow hiInf hdir).1
  have hex : ∃ i, KaehlerDifferential.D (F i) L f ≠ 0 := by
    by_contra! h
    apply hdf
    have hm : KaehlerDifferential.D (ZMod p) L f ∈
        ⨅ i, LinearMap.ker (KaehlerDifferential.map (ZMod p) (F i) L L) := by
      simp only [Submodule.mem_iInf, LinearMap.mem_ker, KaehlerDifferential.map_D,
        Algebra.algebraMap_self, RingHom.id_apply]
      exact h
    simpa only [hker, Submodule.mem_bot] using hm
  obtain ⟨i, hi⟩ := hex
  obtain ⟨l, hl⟩ := Module.Projective.exists_dual_ne_zero L hi
  exact ⟨i, l.compDer (KaehlerDifferential.D (F i) L), hl⟩

private theorem exists_derivation_apply_ne_zero_of_finite_extension
    {p : ℕ} [Fact p.Prime] {K L : Type*} [Field K] [Field L]
    [CharP K p] [CharP L p] [Algebra (ZMod p) K] [Algebra (ZMod p) L]
    [Algebra K L] [FiniteDimensional K L] [IsScalarTower (ZMod p) K L]
    {I : Type*} (F : I → IntermediateField (ZMod p) K)
    (hpow : ∀ i, (frobenius K p).fieldRange ≤ (F i).toSubfield)
    (hiInf : (frobenius K p).fieldRange = ⨅ i, (F i).toSubfield)
    (hdir : ∀ i j, ∃ k, F k ≤ F i ⊓ F j)
    (f : L) (hf : ¬ ∃ x : L, f = x ^ p) :
    ∃ i, ∃ D : Derivation ℤ L L, D f ≠ 0 ∧
      ∀ x : K, x ∈ F i → D (algebraMap K L x) = 0 := by
  let S : I → Subfield L := fun i =>
    (frobenius L p).fieldRange ⊔ (F i).toSubfield.map (algebraMap K L)
  have hz : ∀ i z, algebraMap (ZMod p) L z ∈ S i := by
    intro i z
    obtain ⟨n, rfl⟩ := ZMod.intCast_surjective z
    simpa only [map_intCast] using (S i).intCast_mem n
  let G : I → IntermediateField (ZMod p) L := fun i => (S i).toIntermediateField (hz i)
  have hGpow : ∀ i, (frobenius L p).fieldRange ≤ (G i).toSubfield :=
    fun _ => le_sup_left
  have hGinf : (frobenius L p).fieldRange = ⨅ i, (G i).toSubfield :=
    (iInf_ker_kaehlerDifferentialMap_eq_bot_and_frobeniusFieldRange_eq_iInf
      F hpow hiInf hdir).2 L
  have hGdir : ∀ i j, ∃ k, G k ≤ G i ⊓ G j := by
    intro i j
    obtain ⟨k, hk⟩ := hdir i j
    refine ⟨k, le_inf ?_ ?_⟩
    · change S k ≤ S i
      refine sup_le le_sup_left ?_
      rintro _ ⟨x, hx, rfl⟩
      exact (show (F i).toSubfield.map (algebraMap K L) ≤ S i from le_sup_right)
        ⟨x, (hk hx).1, rfl⟩
    · change S k ≤ S j
      refine sup_le le_sup_left ?_
      rintro _ ⟨x, hx, rfl⟩
      exact (show (F j).toSubfield.map (algebraMap K L) ≤ S j from le_sup_right)
        ⟨x, (hk hx).2, rfl⟩
  obtain ⟨i, D, hD⟩ := exists_derivation_apply_ne_zero_of_iInf G hGpow hGinf hGdir f hf
  refine ⟨i, D.restrictScalars ℤ, hD, fun x hx => ?_⟩
  have hm : algebraMap K L x ∈ G i :=
    (le_sup_right : (F i).toSubfield.map (algebraMap K L) ≤ S i) ⟨x, hx, rfl⟩
  exact D.map_algebraMap ⟨algebraMap K L x, hm⟩

private theorem exists_derivation_apply_ne_zero_of_subring_family
    {p : ℕ} [Fact p.Prime] {A B K L : Type*}
    [CommRing A] [CommRing B] [IsDomain B] [Field K] [Field L]
    [CharP K p] [CharP L p] [Algebra (ZMod p) K] [Algebra (ZMod p) L]
    [Algebra A B] [Algebra A K] [Algebra A L] [Algebra B L] [Algebra K L]
    [IsScalarTower A B L] [IsScalarTower A K L] [IsScalarTower (ZMod p) K L]
    [IsFractionRing B L] [FiniteDimensional K L] [Algebra.FiniteType A B]
    {I : Type*} (S : I → Subring A) (F : I → IntermediateField (ZMod p) K)
    (hfin : ∀ i, Module.Finite (S i) A)
    (hmem : ∀ i a, a ∈ S i → algebraMap A K a ∈ F i)
    (hpow : ∀ i, (frobenius K p).fieldRange ≤ (F i).toSubfield)
    (hiInf : (frobenius K p).fieldRange = ⨅ i, (F i).toSubfield)
    (hdir : ∀ i j, ∃ k, F k ≤ F i ⊓ F j)
    (f : B) (hf : ¬ ∃ x : L, algebraMap B L f = x ^ p) :
    ∃ d : Derivation ℤ B B, d f ≠ 0 := by
  obtain ⟨i, D, hDf, hD⟩ :=
    exists_derivation_apply_ne_zero_of_finite_extension F hpow hiInf hdir
      (algebraMap B L f) hf
  let : Algebra (S i) B := ((algebraMap A B).comp (S i).subtype).toAlgebra
  let : Algebra (S i) L := ((algebraMap B L).comp (algebraMap (S i) B)).toAlgebra
  have : IsScalarTower (S i) A B := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower (S i) B L := .of_algebraMap_eq fun _ => rfl
  have : Module.Finite (S i) A := hfin i
  have : Algebra.FiniteType (S i) B :=
    .trans (inferInstance : Algebra.FiniteType (S i) A) inferInstance
  refine exists_derivation_apply_ne_zero_of_vanishes (A := S i) D ?_ f hDf
  intro a
  change D (algebraMap B L (algebraMap A B (a : A))) = 0
  rw [← IsScalarTower.algebraMap_apply A B L, IsScalarTower.algebraMap_apply A K L]
  exact hD _ (hmem i a a.property)

private theorem isFractionRing_of_pow_smul_mem
    {R B L : Type*} [CommRing R] [CommRing B] [IsDomain B] [Field L]
    [Algebra R B] [Algebra B L] [IsFractionRing B L]
    (S : Subalgebra R B) (g : R) (hg : algebraMap R B g ≠ 0)
    (hS : ∀ b : B, ∃ n : ℕ, g ^ n • b ∈ S) : IsFractionRing S L := by
  have hinj : Function.Injective (algebraMap S L) := by
    rw [IsScalarTower.algebraMap_eq S B L]
    exact (IsFractionRing.injective B L).comp Subtype.val_injective
  have : FaithfulSMul S L := (faithfulSMul_iff_algebraMap_injective S L).2 hinj
  refine IsFractionRing.of_field S L fun z => ?_
  obtain ⟨b, c, hc, rfl⟩ := IsFractionRing.div_surjective B z
  obtain ⟨n, hn⟩ := hS b
  obtain ⟨m, hm⟩ := hS c
  have hb' : g ^ (n + m) • b ∈ S := by
    rw [pow_add, mul_comm, mul_smul]
    exact S.smul_mem hn _
  have hc' : g ^ (n + m) • c ∈ S := by
    rw [pow_add, mul_smul]
    exact S.smul_mem hm _
  refine ⟨⟨_, hb'⟩, ⟨_, hc'⟩, ?_⟩
  have hgl : algebraMap B L (algebraMap R B g) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective B L)).2 hg
  simp only [IsScalarTower.algebraMap_apply S B L, Subalgebra.algebraMap_apply,
    Algebra.smul_def, map_mul, map_pow]
  rw [mul_div_mul_left _ _ (pow_ne_zero _ hgl)]

private theorem finiteDimensional_of_finite_fractionRing
    {A B K L : Type*} [CommRing A] [CommRing B] [Field K] [Field L]
    [Algebra A B] [Module.Finite A B] [Algebra A K] [Algebra B L]
    [IsFractionRing B L] [Algebra A L] [Algebra K L]
    [IsScalarTower A B L] [IsScalarTower A K L] : FiniteDimensional K L := by
  have : Algebra.IsAlgebraic K L := isAlgebraic_of_isFractionRing A B K L
  have : Algebra.EssFiniteType B L := .of_isLocalization (M := nonZeroDivisors B) ..
  have : Algebra.EssFiniteType A L := .comp A B L
  have : Algebra.EssFiniteType K L := .of_comp A K L
  exact Algebra.finite_of_essFiniteType_of_isAlgebraic

section PowerSeries

variable {p : ℕ} [Fact p.Prime] (k : Type*) [Field k] [CharP k p] (n m : ℕ)

local notation "A" => MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)

private theorem exists_derivation_apply_ne_zero_of_powerSeries_polynomial
    {B L : Type*} [CommRing B] [IsDomain B] [Field L]
    [Algebra A B] [Algebra B L] [IsFractionRing B L] [Algebra.FiniteType A B]
    [Algebra A L] [IsScalarTower A B L]
    [Algebra (FractionRing A) L] [FiniteDimensional (FractionRing A) L]
    [IsScalarTower A (FractionRing A) L]
    [Algebra (ZMod p) k] (T : Set k)
    (hT : _root_.PBasis (ZMod p) (Subtype.val : T → k) p)
    (f : B) (hf : ¬ ∃ x : L, algebraMap B L f = x ^ p) :
    ∃ d : Derivation ℤ B B, d f ≠ 0 := by
  have : IsDomain A := NoZeroDivisors.to_isDomain A
  have : CharP A p := charP_of_injective_algebraMap (algebraMap k A).injective p
  have : CharP (FractionRing A) p :=
    charP_of_injective_algebraMap (IsFractionRing.injective A (FractionRing A)) p
  have : CharP L p := charP_of_injective_algebraMap (algebraMap (FractionRing A) L).injective p
  let : Algebra (ZMod p) L := ZMod.algebra L p
  let kJ : Finset T → Subfield k := fun J =>
    (frobenius k p).fieldRange ⊔ Subfield.closure (Subtype.val '' {i | i ∉ J})
  let toA : (J : Finset T) → MvPolynomial (Fin m) (MvPowerSeries (Fin n) (kJ J)) →+* A :=
    fun J => MvPolynomial.eval₂Hom
      ((MvPolynomial.C : MvPowerSeries (Fin n) k →+* A).comp
        ((MvPowerSeries.expand p (Nat.Prime.ne_zero Fact.out)).toRingHom.comp
          (MvPowerSeries.map (kJ J).subtype))) (fun i => MvPolynomial.X i ^ p)
  let AJ : Finset T → Subring A := fun J => (toA J).range
  let KJ : Finset T → IntermediateField (ZMod p) (FractionRing A) := fun J =>
    IntermediateField.adjoin (ZMod p) (algebraMap A (FractionRing A) '' (AJ J : Set A))
  have h := fractionFields_powerSeries_polynomial_subrings
    (p := p) (Subtype.val : T → k) hT n m
  change (∀ J, (frobenius (FractionRing A) p).fieldRange ≤ (KJ J).toSubfield) ∧
    (frobenius (FractionRing A) p).fieldRange = ⨅ J, (KJ J).toSubfield ∧
    (∀ J J', ∃ J'', KJ J'' ≤ KJ J ⊓ KJ J') ∧ ∀ J, Module.Finite (AJ J) A at h
  exact exists_derivation_apply_ne_zero_of_subring_family AJ KJ h.2.2.2
    (fun J a ha => IntermediateField.subset_adjoin (ZMod p) _ ⟨a, ha, rfl⟩)
    h.1 h.2.1 h.2.2.1 f hf

end PowerSeries

section PowerSeriesReduction

variable {p : ℕ} [Fact p.Prime] (k : Type*) [Field k] [CharP k p] (n : ℕ)

private theorem exists_derivation_apply_ne_zero_of_finiteType_powerSeries
    {B L : Type*} [CommRing B] [IsDomain B] [Field L]
    [Algebra (MvPowerSeries (Fin n) k) B]
    [FaithfulSMul (MvPowerSeries (Fin n) k) B]
    [Algebra.FiniteType (MvPowerSeries (Fin n) k) B]
    [Algebra B L] [IsFractionRing B L]
    [Algebra (ZMod p) k] (T : Set k)
    (hT : _root_.PBasis (ZMod p) (Subtype.val : T → k) p)
    (f : B) (hf : ¬ ∃ x : L, algebraMap B L f = x ^ p) :
    ∃ d : Derivation ℤ B B, d f ≠ 0 := by
  let R := MvPowerSeries (Fin n) k
  have : IsDomain R := NoZeroDivisors.to_isDomain R
  obtain ⟨m, S, y, g, hg, hy, hfin, hS⟩ :=
    exists_subalgebra_finite_inj_aeval_pow_smul_mem R B
  let A := MvPolynomial (Fin m) R
  let e : A →+* B := S.val.toRingHom.comp (MvPolynomial.aeval y).toRingHom
  let : Algebra A S := (MvPolynomial.aeval y).toRingHom.toAlgebra
  let : Algebra A B := e.toAlgebra
  let : Algebra A L := ((algebraMap B L).comp e).toAlgebra
  have : IsScalarTower A S B := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A B L := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A S L := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R A B := .of_algebraMap_eq fun r => by
    change algebraMap R B r = S.val (MvPolynomial.aeval y (MvPolynomial.C r))
    simp
  have : Algebra.FiniteType A B := .of_restrictScalars_finiteType R A B
  have : Module.Finite A S := hfin
  have : IsFractionRing S L := isFractionRing_of_pow_smul_mem S g
    ((map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective R B)).2 hg) hS
  have hi : Function.Injective (algebraMap A L) :=
    (IsFractionRing.injective B L).comp (Subtype.val_injective.comp hy)
  have : FaithfulSMul A L := (faithfulSMul_iff_algebraMap_injective A L).2 hi
  let : Algebra (FractionRing A) L := FractionRing.liftAlgebra A L
  have : FiniteDimensional (FractionRing A) L :=
    finiteDimensional_of_finite_fractionRing (A := A) (B := S)
  exact exists_derivation_apply_ne_zero_of_powerSeries_polynomial k n m T hT f hf

end PowerSeriesReduction

private theorem exists_injective_finite_mvPowerSeries_field
    {p : ℕ} [Fact p.Prime] {R : Type u} [CommRing R] [IsDomain R]
    [CharP R p] [IsNoetherianRing R] [IsLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R] :
    ∃ (k : Type u) (_ : Field k) (_ : CharP k p) (n : ℕ)
      (e : MvPowerSeries (Fin n) k →+* R), Function.Injective e ∧ e.Finite := by
  obtain ⟨n, k, _, _, hk, _, _, e, he, hfin, _⟩ :=
    IsLocalRing.exists_injective_finite_mvPowerSeries R
  have : CharP k p := ⟨fun a => by
    rw [← CharP.cast_eq_zero_iff R p a,
      ← map_natCast (e.comp MvPowerSeries.C),
      map_eq_zero_iff (e.comp MvPowerSeries.C) (he.comp MvPowerSeries.C_injective)]⟩
  have hk' : IsField k := hk.resolve_right fun hcohen => by
    have : IsCohenRing k := hcohen
    obtain ⟨q, hq, hmax⟩ := IsCohenRing.uniformizer_prime hcohen
    have hqu : ¬ IsUnit (q : k) := fun h =>
      IsLocalRing.notMem_maximalIdeal.mpr h (hmax ▸ Ideal.mem_span_singleton_self _)
    have hpq : p ∣ q := not_not.mp ((CharP.isUnit_natCast_iff (R := k) Fact.out).not.mp hqu)
    have heq : p = q := (Nat.prime_dvd_prime_iff_eq Fact.out hq).mp hpq
    apply IsDiscreteValuationRing.not_isField k
    apply IsLocalRing.isField_iff_maximalIdeal_eq.mpr
    rw [hmax, ← heq, CharP.cast_eq_zero, Ideal.span_singleton_eq_bot]
  let : Field k := hk'.toField
  exact ⟨k, inferInstance, inferInstance, n, e, he, hfin⟩

private theorem isAdicComplete_quotient_local
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [IsPrecomplete (IsLocalRing.maximalIdeal R) R]
    (I : Ideal R) [IsLocalRing (R ⧸ I)] :
    IsAdicComplete (IsLocalRing.maximalIdeal (R ⧸ I)) (R ⧸ I) := by
  let m := IsLocalRing.maximalIdeal R
  have hpre : IsPrecomplete m (R ⧸ I) := by
    apply AdicCompletion.of_surjective_iff.mp
    intro z
    obtain ⟨y, hy⟩ := AdicCompletion.map_surjective m
      (f := I.mkQ) I.mkQ_surjective z
    obtain ⟨x, hx⟩ := AdicCompletion.of_surjective m R y
    refine ⟨I.mkQ x, ?_⟩
    rw [← AdicCompletion.map_of, hx, hy]
  have : IsPrecomplete (IsLocalRing.maximalIdeal (R ⧸ I)) (R ⧸ I) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective]
    exact IsPrecomplete.map_algebraMap_iff.mpr hpre
  exact ⟨⟩

private theorem exists_derivation_apply_ne_zero_of_finiteType_complete_domain
    {p : ℕ} [Fact p.Prime] {R : Type u} {B K : Type*}
    [CommRing R] [IsDomain R] [CharP R p] [IsNoetherianRing R] [IsLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    [CommRing B] [IsDomain B] [Algebra R B] [FaithfulSMul R B]
    [Algebra.FiniteType R B] [Field K] [Algebra B K] [IsFractionRing B K]
    (f : B) (hf : ¬ ∃ x : K, algebraMap B K f = x ^ p) :
    ∃ D : Derivation ℤ B B, D f ≠ 0 := by
  obtain ⟨k, _, _, n, e, he, hfin⟩ :=
    exists_injective_finite_mvPowerSeries_field (p := p) (R := R)
  let A := MvPowerSeries (Fin n) k
  let : Algebra A R := e.toAlgebra
  let : Algebra A B := ((algebraMap R B).comp e).toAlgebra
  have : IsScalarTower A R B := .of_algebraMap_eq fun _ => rfl
  have : Module.Finite A R := hfin
  have : Algebra.FiniteType A B :=
    .trans (inferInstance : Algebra.FiniteType A R) inferInstance
  have : FaithfulSMul A B := (faithfulSMul_iff_algebraMap_injective A B).2
    ((FaithfulSMul.algebraMap_injective R B).comp he)
  let : Algebra (ZMod p) k := ZMod.algebra k p
  obtain ⟨T, hT⟩ := exists_pBasis (k := ZMod p) (K := k) p
  exact exists_derivation_apply_ne_zero_of_finiteType_powerSeries k n T hT f hf

/-- If a domain `B` of prime characteristic is of finite type over a Noetherian complete local
ring, then every element of `B` that is not a p-th power in its fraction field is detected by an
ordinary derivation of `B`. -/
@[stacks 07PH]
public theorem exists_derivation_apply_ne_zero_of_not_pow_fractionRing
    {p : ℕ} [Fact p.Prime] {R B K : Type*}
    [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    [CommRing B] [IsDomain B] [CharP B p] [Algebra R B] [Algebra.FiniteType R B]
    [Field K] [Algebra B K] [IsFractionRing B K]
    (f : B) (hf : ¬ ∃ x : K, algebraMap B K f = x ^ p) :
    ∃ D : Derivation ℤ B B, D f ≠ 0 := by
  let I := RingHom.ker (algebraMap R B)
  let Q := R ⧸ I
  let e : Q →+* B := Ideal.Quotient.lift I (algebraMap R B) (fun _ h => h)
  let : Algebra Q B := e.toAlgebra
  have he : Function.Injective e := RingHom.lift_injective_of_ker_le_ideal I _ le_rfl
  have : I.IsPrime := RingHom.ker_isPrime (algebraMap R B)
  have : IsLocalRing Q :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have : IsScalarTower R Q B := .of_algebraMap_eq fun _ => rfl
  have : FaithfulSMul Q B := (faithfulSMul_iff_algebraMap_injective Q B).2 he
  have : CharP Q p := e.charP he p
  have : Algebra.FiniteType Q B := .of_restrictScalars_finiteType R Q B
  have : IsAdicComplete (IsLocalRing.maximalIdeal Q) Q :=
    isAdicComplete_quotient_local I
  exact exists_derivation_apply_ne_zero_of_finiteType_complete_domain (R := Q) f hf

end

end

