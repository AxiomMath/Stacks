module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.TensorProduct.Maps
public import StacksCore.Tactic.StacksAttribute

/-! # The diagonal of a polynomial algebra, and the partial derivatives

Let `A` be a commutative ring, let `σ` be a finite index type and write `P = A[σ]` for the
polynomial algebra. For every `f : P` the element `f ⊗ 1 - 1 ⊗ f` of `P ⊗[A] P` lies in the ideal
generated by the `|σ|` diagonal elements `X i ⊗ 1 - 1 ⊗ X i`, and it can be written

`f ⊗ 1 - 1 ⊗ f = ∑ i, g i * (X i ⊗ 1 - 1 ⊗ X i)`

with coefficients `g i` whose images under the multiplication map `P ⊗[A] P → P` are exactly the
partial derivatives `∂f/∂X i`.

This is the step the Stacks Project leaves unproved in Tag 0FCW -- "this is a general fact about
elements of `A[x_1, …, x_n]` whose proof we omit", together with the following sentence "another
computation shows that `a_ij` is the image of `∂f_i/∂x_j`". Both halves are proved here, by the
same induction, so that the coefficients are not merely produced but identified: it is their
identification with the Jacobian matrix that lets Tag 0FCW convert the injectivity supplied by
Rodicio's theorem (Tag 09PV) into a rank statement about the matrix of partial derivatives.

The induction is over the three generators of a polynomial algebra. For a constant both sides
vanish, since `C a ⊗ 1 = 1 ⊗ C a`. Addition is immediate. For `p * X n`, writing
`d i = X i ⊗ 1 - 1 ⊗ X i` and inserting `p ⊗ X n`,

`(p * X n) ⊗ 1 - 1 ⊗ (p * X n) = (p ⊗ 1) * d n + (1 ⊗ X n) * (p ⊗ 1 - 1 ⊗ p)`,

so the coefficients of `p * X n` are those of `p` multiplied by `1 ⊗ X n`, corrected at the index
`n` by `p ⊗ 1`. Under the multiplication map that is `(∂p/∂X i) * X n + δ_{i n} * p`, which is the
Leibniz rule for `p * X n`.

## Main definitions

* `StacksDraft.Diagonal.diagonalGen`: the diagonal element `X i ⊗ 1 - 1 ⊗ X i`.

## Main results

* `StacksDraft.Diagonal.exists_eq_sum_diagonalGen`: the representation above, with the
  coefficients identified with the partial derivatives.
* `StacksDraft.Diagonal.tmul_one_sub_one_tmul_mem_span_diagonalGen`: the consequence that
  `f ⊗ 1 - 1 ⊗ f` lies in the ideal generated by the diagonal elements.

## Implementation notes

The index type is required to be finite only so that the representation can be written as a
`Finset.sum` over all of `σ`, which is the form Tag 0FCW uses; the statement for a general index
type would have to carry a finitely supported family instead.

## References

* [Stacks Project, Tag 0FCW](https://stacks.math.columbia.edu/tag/0FCW)
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace StacksDraft.Diagonal

universe u

variable (A : Type u) [CommRing A] {σ : Type*}

/-- The `i`-th diagonal element `X i ⊗ 1 - 1 ⊗ X i` of `A[σ] ⊗[A] A[σ]`. These generate the kernel
of the multiplication map, which is the ideal cutting out the diagonal. -/
def diagonalGen (i : σ) : MvPolynomial σ A ⊗[A] MvPolynomial σ A :=
  MvPolynomial.X i ⊗ₜ[A] 1 - 1 ⊗ₜ[A] MvPolynomial.X i

variable [Fintype σ]

/-- **The diagonal expansion of a polynomial, with the partial derivatives as its coefficients.**
For every `f` in a polynomial algebra `A[σ]` over a finite index type there are coefficients
`g i` in `A[σ] ⊗[A] A[σ]` with

`f ⊗ 1 - 1 ⊗ f = ∑ i, g i * (X i ⊗ 1 - 1 ⊗ X i)`,

each of which multiplies down to the partial derivative `∂f/∂X i`.

This is the fact Stacks Tag 0FCW states without proof, together with the identification of the
coefficients it needs immediately afterwards. -/
theorem exists_eq_sum_diagonalGen (f : MvPolynomial σ A) :
    ∃ g : σ → MvPolynomial σ A ⊗[A] MvPolynomial σ A,
      f ⊗ₜ[A] (1 : MvPolynomial σ A) - (1 : MvPolynomial σ A) ⊗ₜ[A] f =
          ∑ i, g i * diagonalGen A i ∧
        ∀ i, Algebra.TensorProduct.lmul' A (g i) = MvPolynomial.pderiv i f := by
  classical
  induction f using MvPolynomial.induction_on with
  | C a =>
    refine ⟨0, ?_, ?_⟩
    · have hsmul : MvPolynomial.C a = a • (1 : MvPolynomial σ A) := by
        simp [Algebra.smul_def, MvPolynomial.algebraMap_eq]
      have h : MvPolynomial.C a ⊗ₜ[A] (1 : MvPolynomial σ A) =
          (1 : MvPolynomial σ A) ⊗ₜ[A] MvPolynomial.C a := by
        rw [hsmul, TensorProduct.smul_tmul]
      rw [h, sub_self]
      simp
    · intro i
      simp
  | add p q hp hq =>
    obtain ⟨gp, hgp, hgp'⟩ := hp
    obtain ⟨gq, hgq, hgq'⟩ := hq
    refine ⟨gp + gq, ?_, ?_⟩
    · rw [TensorProduct.add_tmul, TensorProduct.tmul_add]
      rw [show (p ⊗ₜ[A] (1 : MvPolynomial σ A) + q ⊗ₜ[A] (1 : MvPolynomial σ A)) -
          ((1 : MvPolynomial σ A) ⊗ₜ[A] p + (1 : MvPolynomial σ A) ⊗ₜ[A] q) =
          (p ⊗ₜ[A] (1 : MvPolynomial σ A) - (1 : MvPolynomial σ A) ⊗ₜ[A] p) +
            (q ⊗ₜ[A] (1 : MvPolynomial σ A) - (1 : MvPolynomial σ A) ⊗ₜ[A] q) by ring]
      rw [hgp, hgq, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => by simp [add_mul]
    · intro i
      simp [hgp' i, hgq' i]
  | mul_X p n hp =>
    obtain ⟨g, hg, hg'⟩ := hp
    refine ⟨fun i => g i * ((1 : MvPolynomial σ A) ⊗ₜ[A] MvPolynomial.X n) +
      (if i = n then p ⊗ₜ[A] (1 : MvPolynomial σ A) else 0), ?_, ?_⟩
    · have hsplit : ∀ i, (g i * ((1 : MvPolynomial σ A) ⊗ₜ[A] MvPolynomial.X n) +
            (if i = n then p ⊗ₜ[A] (1 : MvPolynomial σ A) else 0)) * diagonalGen A i =
          ((1 : MvPolynomial σ A) ⊗ₜ[A] MvPolynomial.X n) * (g i * diagonalGen A i) +
            (if i = n then (p ⊗ₜ[A] (1 : MvPolynomial σ A)) * diagonalGen A n else 0) := by
        intro i
        by_cases h : i = n
        · subst h
          simp only [ite_true]
          ring
        · simp only [h, ite_false, add_zero]
          ring
      rw [Finset.sum_congr rfl fun i _ => hsplit i, Finset.sum_add_distrib,
        ← Finset.mul_sum, ← hg, Finset.sum_ite_eq' Finset.univ n
          (fun _ => (p ⊗ₜ[A] (1 : MvPolynomial σ A)) * diagonalGen A n)]
      simp only [Finset.mem_univ, ite_true, diagonalGen, Algebra.TensorProduct.tmul_mul_tmul,
        mul_one, one_mul, mul_sub]
      rw [mul_comm (MvPolynomial.X n) p]
      abel
    · intro i
      rw [MvPolynomial.pderiv_mul]
      by_cases h : i = n
      · subst h
        simp [hg' i, mul_comm]
      · simp [h, hg' i, MvPolynomial.pderiv_X_of_ne (Ne.symm h)]

omit [Fintype σ] in
/-- The element `f ⊗ 1 - 1 ⊗ f` lies in the ideal generated by the diagonal elements. -/
theorem tmul_one_sub_one_tmul_mem_span_diagonalGen [Finite σ] (f : MvPolynomial σ A) :
    f ⊗ₜ[A] (1 : MvPolynomial σ A) - (1 : MvPolynomial σ A) ⊗ₜ[A] f ∈
      Ideal.span (Set.range (diagonalGen A (σ := σ))) := by
  let _ := Fintype.ofFinite σ
  obtain ⟨g, hg, -⟩ := exists_eq_sum_diagonalGen A f
  rw [hg]
  exact Submodule.sum_mem _ fun i _ =>
    Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

end StacksDraft.Diagonal

end
