module

public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.LinearAlgebra.Finsupp.VectorSpace
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import StacksFrontier.LinearAlgebra.SymmetricPower.MonomialBasis

/-!
# The augmentation ideal of a polynomial ring and its associated graded module

Let `B` be a commutative ring, `σ` a type, `T = MvPolynomial σ B` and `g : σ → B`. Write
`ε = MvPolynomial.aeval g : T →ₐ[B] B` for evaluation at `g` and
`K = RingHom.ker ε` for its kernel, the *augmentation ideal* of `T` at `g`.

This file identifies `K` with the ideal generated by the elements `X s - C (g s)` and computes
the graded pieces of the `K`-adic filtration: for every `n` there is a `B`-linear isomorphism

`Symⁿ_B(σ →₀ B) ≃ₗ[B] K ^ n / K ^ (n + 1)`

carrying the symmetric product of `Finsupp.single s₁ 1, …, Finsupp.single sₙ 1` to the class of
`∏ i, (X (s i) - C (g (s i)))`. For `n = 1` this is the conormal module `K / K ^ 2`, which is
therefore free on `σ`.

## Main results

* `MvPolynomial.span_range_X_sub_C_eq_augmentationIdeal`: the augmentation ideal is generated
  by the elements `X s - C (g s)`.
* `MvPolynomial.mem_span_range_X_pow_iff`: a polynomial lies in the `n`-th power of the ideal of
  the variables exactly when every monomial occurring in it has total degree at least `n`.
* `MvPolynomial.augmentationGraded`: the graded piece `K ^ n / K ^ (n + 1)`, as a `B`-module.
* `MvPolynomial.symmetricPowerEquivAugmentationGraded`: **the main result**, the `B`-linear
  isomorphism `Symⁿ_B(σ →₀ B) ≃ₗ[B] K ^ n / K ^ (n + 1)`.
* `MvPolynomial.symmetricPowerEquivAugmentationGraded_prod_ι`: **the characterising equation**,
  the value of that isomorphism on a product of `n` degree-one generators.
* `MvPolynomial.prod_ι_mem_symmetricPower`: a product of `n` degree-one generators lies in the
  `n`-th symmetric power.
* `MvPolynomial.augmentationGradedOneEquiv` and
  `MvPolynomial.augmentationGradedOneEquiv_mk`: the conormal module `K / K ^ 2` is the free
  `B`-module on `σ`, the class of `X s - C (g s)` corresponding to `Finsupp.single s 1`.
* `MvPolynomial.free_augmentationIdeal_pow`: every `K ^ n` is a free `B`-module.

## Implementation notes

The proof is by translation of the variables. The `B`-algebra automorphism
`MvPolynomial.translateEquiv g` sending `X s` to `X s - C (g s)` carries the ideal of the
variables onto `K`, so everything reduces to the case `g = 0`. There the `n`-th power of the
ideal of the variables is `MvPolynomial.degreeGE σ B n`, the span of the monomials of total
degree at least `n` (`MvPolynomial.mem_span_range_X_pow_iff`), and the quotient by the next step
of the filtration is computed by `MvPolynomial.homogeneousComponent n`, which is a `B`-linear
splitting of the inclusion of the degree-`n` homogeneous part.

The graded piece is spelled as a quotient of `↥(K ^ n)` — viewed as a `B`-module via
`Submodule.restrictScalars` — by the comap of `K ^ (n + 1)` along the inclusion, which is the
same pattern Mathlib uses for `Ideal.Cotangent`.
-/

@[expose] public noncomputable section

namespace MvPolynomial

variable {σ : Type*} {B : Type*} [CommRing B]

/-! ### Polynomials whose monomials all have large degree -/

variable (σ B) in
/-- The `B`-submodule of `MvPolynomial σ B` consisting of the polynomials all of whose
monomials have total degree at least `n`. -/
def degreeGE (n : ℕ) : Submodule B (MvPolynomial σ B) where
  carrier := {p | ∀ d ∈ p.support, n ≤ d.degree}
  add_mem' := by
    classical
    intro p q hp hq d hd
    rcases Finset.mem_union.1 (support_add hd) with h | h
    · exact hp d h
    · exact hq d h
  zero_mem' := by simp
  smul_mem' := by
    intro c p hp d hd
    exact hp d (support_smul hd)

/-- A polynomial lies in `degreeGE σ B n` iff each of its monomials has degree at least `n`. -/
theorem mem_degreeGE {n : ℕ} {p : MvPolynomial σ B} :
    p ∈ degreeGE σ B n ↔ ∀ d ∈ p.support, n ≤ d.degree :=
  Iff.rfl

/-- Every polynomial has all its monomials of degree at least `0`. -/
theorem mem_degreeGE_zero (p : MvPolynomial σ B) : p ∈ degreeGE σ B 0 :=
  fun _ _ => Nat.zero_le _

/-- A monomial of degree at least `n` lies in `degreeGE σ B n`. -/
theorem monomial_mem_degreeGE {n : ℕ} {d : σ →₀ ℕ} (hd : n ≤ d.degree) (c : B) :
    monomial d c ∈ degreeGE σ B n := by
  intro e he
  rw [Finset.mem_singleton.1 (support_monomial_subset he)]
  exact hd

/-- A variable has all its monomials of degree at least `1`. -/
theorem X_mem_degreeGE (s : σ) : (X s : MvPolynomial σ B) ∈ degreeGE σ B 1 :=
  monomial_mem_degreeGE (by simp) 1

/-- The degrees of the monomials of a product add up. -/
theorem mul_mem_degreeGE {m n : ℕ} {p q : MvPolynomial σ B} (hp : p ∈ degreeGE σ B m)
    (hq : q ∈ degreeGE σ B n) : p * q ∈ degreeGE σ B (m + n) := by
  classical
  intro d hd
  obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_add.1 (support_mul p q hd)
  rw [map_add]
  exact Nat.add_le_add (hp a ha) (hq b hb)

/-- A homogeneous polynomial of degree `n` has all its monomials of degree at least `n`. -/
theorem mem_degreeGE_of_isHomogeneous {n : ℕ} {p : MvPolynomial σ B} (hp : p.IsHomogeneous n) :
    p ∈ degreeGE σ B n := by
  intro d hd
  refine le_of_eq (Eq.symm ?_)
  by_contra h
  exact (mem_support_iff.1 hd) (hp.coeff_eq_zero h)

/-- Subtracting off the degree-`n` homogeneous component raises the lower bound on the degrees
by one. -/
theorem homogeneousComponent_sub_mem_degreeGE {n : ℕ} {p : MvPolynomial σ B}
    (hp : p ∈ degreeGE σ B n) : homogeneousComponent n p - p ∈ degreeGE σ B (n + 1) := by
  intro d hd
  rw [mem_support_iff, coeff_sub, coeff_homogeneousComponent] at hd
  rcases eq_or_ne d.degree n with h | h
  · simp [h] at hd
  · have hc : p.coeff d ≠ 0 := by simpa [h] using hd
    have := hp d (mem_support_iff.2 hc)
    omega

/-! ### The powers of the ideal of the variables -/

/-- Every element of the ideal generated by the variables has all its monomials of degree at
least `1`. -/
theorem mem_degreeGE_one_of_mem_span_range_X {p : MvPolynomial σ B}
    (hp : p ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ B))) : p ∈ degreeGE σ B 1 := by
  induction hp using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨s, rfl⟩ := hx
    exact X_mem_degreeGE s
  | zero => exact zero_mem _
  | add x y _ _ hx hy => exact add_mem hx hy
  | smul a x _ hx => simpa using mul_mem_degreeGE (mem_degreeGE_zero a) hx

/-- Every element of the `n`-th power of the ideal generated by the variables has all its
monomials of degree at least `n`. -/
theorem mem_degreeGE_of_mem_span_range_X_pow {n : ℕ} {p : MvPolynomial σ B}
    (hp : p ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n) : p ∈ degreeGE σ B n := by
  induction n generalizing p with
  | zero => exact mem_degreeGE_zero p
  | succ n ih =>
    rw [pow_succ] at hp
    refine Submodule.mul_induction_on hp (fun a ha b hb => ?_) fun x y hx hy => add_mem hx hy
    exact mul_mem_degreeGE (ih ha) (mem_degreeGE_one_of_mem_span_range_X hb)

/-- A monomial of degree at least `n` lies in the `n`-th power of the ideal of the variables. -/
theorem monomial_mem_span_range_X_pow {n : ℕ} {d : σ →₀ ℕ} (hd : n ≤ d.degree) (c : B) :
    monomial d c ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n := by
  apply Ideal.pow_le_pow_right hd
  rw [monomial_eq]
  refine Ideal.mul_mem_left _ _ ?_
  simp only [Finsupp.prod, Finsupp.degree_apply]
  rw [← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun i _ =>
    Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) (d i)

/-- A polynomial all of whose monomials have degree at least `n` lies in the `n`-th power of the
ideal of the variables. -/
theorem mem_span_range_X_pow_of_mem_degreeGE {n : ℕ} {p : MvPolynomial σ B}
    (hp : p ∈ degreeGE σ B n) :
    p ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n := by
  rw [← support_sum_monomial_coeff p]
  exact Submodule.sum_mem _ fun d hd => monomial_mem_span_range_X_pow (hp d hd) _

/-- **The `n`-th power of the ideal of the variables is the span of the monomials of degree at
least `n`.** -/
theorem mem_span_range_X_pow_iff {n : ℕ} {p : MvPolynomial σ B} :
    p ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n ↔ ∀ d ∈ p.support, n ≤ d.degree :=
  ⟨mem_degreeGE_of_mem_span_range_X_pow, mem_span_range_X_pow_of_mem_degreeGE⟩

variable (σ B) in
/-- The `n`-th power of the ideal of the variables, read as a `B`-submodule, is
`degreeGE σ B n`. -/
theorem restrictScalars_span_range_X_pow (n : ℕ) :
    (Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n).restrictScalars B
      = degreeGE σ B n :=
  le_antisymm (fun _ hp => mem_degreeGE_of_mem_span_range_X_pow hp)
    fun _ hp => mem_span_range_X_pow_of_mem_degreeGE hp

/-! ### `degreeGE` is free on the monomials of large degree -/

variable (σ B) in
/-- The monomials of degree at least `n` span `degreeGE σ B n`. -/
theorem span_range_monomial_eq_degreeGE (n : ℕ) :
    Submodule.span B (Set.range fun d : {d : σ →₀ ℕ // n ≤ d.degree} =>
        (monomial (d : σ →₀ ℕ) 1 : MvPolynomial σ B)) = degreeGE σ B n := by
  refine le_antisymm (Submodule.span_le.2 ?_) fun p hp => ?_
  · rintro _ ⟨d, rfl⟩
    exact monomial_mem_degreeGE d.2 1
  · rw [← support_sum_monomial_coeff p]
    refine Submodule.sum_mem _ fun d hd => ?_
    have hsm : (monomial d (p.coeff d) : MvPolynomial σ B)
        = p.coeff d • monomial d (1 : B) := by
      rw [smul_monomial, smul_eq_mul, mul_one]
    rw [hsm]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨d, hp d hd⟩, rfl⟩)

variable (σ B) in
/-- The monomials of degree at least `n` are linearly independent, being a subfamily of the
monomial basis of `MvPolynomial σ B`. -/
theorem linearIndependent_monomial_degreeGE (n : ℕ) :
    LinearIndependent B fun d : {d : σ →₀ ℕ // n ≤ d.degree} =>
      (monomial (d : σ →₀ ℕ) 1 : MvPolynomial σ B) := by
  have h := (basisMonomials σ B).linearIndependent.comp
    (fun d : {d : σ →₀ ℕ // n ≤ d.degree} => (d : σ →₀ ℕ)) Subtype.val_injective
  simpa [Function.comp_def, coe_basisMonomials] using h

variable (σ B) in
/-- The monomial basis of `degreeGE σ B n`, indexed by the multidegrees of total degree at
least `n`. -/
def basisDegreeGE (n : ℕ) :
    Module.Basis {d : σ →₀ ℕ // n ≤ d.degree} B (degreeGE σ B n) :=
  (Module.Basis.span (linearIndependent_monomial_degreeGE σ B n)).map
    (LinearEquiv.ofEq _ _ (span_range_monomial_eq_degreeGE σ B n))

/-- The submodule `degreeGE σ B n` is a free `B`-module. -/
instance instFreeDegreeGE (n : ℕ) : Module.Free B (degreeGE σ B n) :=
  Module.Free.of_basis (basisDegreeGE σ B n)

/-! ### Translation of the variables -/

variable (g : σ → B)

/-- **Translation of the variables.** The `B`-algebra automorphism of `MvPolynomial σ B`
sending `X s` to `X s - C (g s)`; its inverse sends `X s` to `X s + C (g s)`. -/
def translateEquiv : MvPolynomial σ B ≃ₐ[B] MvPolynomial σ B :=
  AlgEquiv.ofAlgHom (aeval fun s => X s - C (g s)) (aeval fun s => X s + C (g s))
    (by ext s; simp) (by ext s; simp)

/-- `translateEquiv g` sends `X s` to `X s - C (g s)`. -/
@[simp]
theorem translateEquiv_X (s : σ) : translateEquiv g (X s) = X s - C (g s) := by
  simp [translateEquiv]

/-- The inverse of `translateEquiv g` sends `X s` to `X s + C (g s)`. -/
@[simp]
theorem translateEquiv_symm_X (s : σ) : (translateEquiv g).symm (X s) = X s + C (g s) := by
  simp [translateEquiv]

/-! ### The augmentation ideal -/

/-- **The augmentation ideal** of `MvPolynomial σ B` at `g : σ → B`: the kernel of the
evaluation `B`-algebra map `ε = aeval g : MvPolynomial σ B →ₐ[B] B`. -/
def augmentationIdeal : Ideal (MvPolynomial σ B) :=
  RingHom.ker ((aeval g : MvPolynomial σ B →ₐ[B] B) : MvPolynomial σ B →+* B)

/-- A polynomial lies in `augmentationIdeal g` iff it evaluates to `0` at `g`. -/
theorem mem_augmentationIdeal {p : MvPolynomial σ B} :
    p ∈ augmentationIdeal g ↔ aeval g p = 0 :=
  Iff.rfl

/-- **The augmentation ideal is generated by the elements `X s - C (g s)`.** -/
theorem span_range_X_sub_C_eq_augmentationIdeal :
    Ideal.span (Set.range fun s => (X s - C (g s) : MvPolynomial σ B)) = augmentationIdeal g := by
  refine le_antisymm (Ideal.span_le.2 ?_) fun p hp => ?_
  · rintro _ ⟨s, rfl⟩
    simp [SetLike.mem_coe, mem_augmentationIdeal]
  · have key : ∀ q : MvPolynomial σ B, q - C (aeval g q) ∈
        Ideal.span (Set.range fun s => (X s - C (g s) : MvPolynomial σ B)) := by
      intro q
      induction q using MvPolynomial.induction_on with
      | C a => simp
      | add u v hu hv =>
        have hadd : u + v - C (aeval g (u + v))
            = (u - C (aeval g u)) + (v - C (aeval g v)) := by
          rw [map_add, map_add]
          ring
        rw [hadd]
        exact Ideal.add_mem _ hu hv
      | mul_X u s hu =>
        have hmul : u * X s - C (aeval g (u * X s))
            = u * (X s - C (g s)) + (u - C (aeval g u)) * C (g s) := by
          simp only [map_mul, aeval_X]
          ring
        rw [hmul]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨s, rfl⟩))
          (Ideal.mul_mem_right _ _ hu)
    have hp' := key p
    rwa [(mem_augmentationIdeal g).1 hp, map_zero, sub_zero] at hp'

/-- Translation carries the ideal of the variables onto the augmentation ideal. -/
theorem map_translateEquiv_span_range_X :
    Ideal.map (translateEquiv g) (Ideal.span (Set.range (X : σ → MvPolynomial σ B)))
      = augmentationIdeal g := by
  rw [Ideal.map_span, ← Set.range_comp, ← span_range_X_sub_C_eq_augmentationIdeal g]
  simp [Function.comp_def]

/-- Translation carries the `n`-th power of the ideal of the variables onto `K ^ n`. -/
theorem map_translateEquiv_span_range_X_pow (n : ℕ) :
    Ideal.map (translateEquiv g) (Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n)
      = augmentationIdeal g ^ n := by
  rw [Ideal.map_pow, map_translateEquiv_span_range_X]

/-- **Membership in `K ^ n` after untranslating.** A polynomial lies in `K ^ n` exactly when
its translate back has all its monomials of total degree at least `n`. -/
theorem mem_augmentationIdeal_pow_iff {n : ℕ} {p : MvPolynomial σ B} :
    p ∈ augmentationIdeal g ^ n ↔ (translateEquiv g).symm p ∈ degreeGE σ B n := by
  rw [← map_translateEquiv_span_range_X_pow g n, Ideal.mem_map_of_equiv]
  refine ⟨?_, fun h => ⟨(translateEquiv g).symm p,
    mem_span_range_X_pow_of_mem_degreeGE h, by simp⟩⟩
  rintro ⟨q, hq, rfl⟩
  rw [AlgEquiv.symm_apply_apply]
  exact mem_degreeGE_of_mem_span_range_X_pow hq

/-- The translate of a polynomial all of whose monomials have degree at least `n` lies in
`K ^ n`. -/
theorem translateEquiv_mem_augmentationIdeal_pow {n : ℕ} {q : MvPolynomial σ B}
    (hq : q ∈ degreeGE σ B n) : translateEquiv g q ∈ augmentationIdeal g ^ n := by
  rw [mem_augmentationIdeal_pow_iff, AlgEquiv.symm_apply_apply]
  exact hq

/-! ### The graded pieces of the augmentation filtration -/

/-- The step `K ^ (n + 1)` of the augmentation filtration, as a `B`-submodule of `K ^ n`. -/
abbrev augmentationFiltrationStep (n : ℕ) :
    Submodule B ((augmentationIdeal g ^ n).restrictScalars B) :=
  Submodule.comap ((augmentationIdeal g ^ n).restrictScalars B).subtype
    ((augmentationIdeal g ^ (n + 1)).restrictScalars B)

/-- **The `n`-th graded piece `K ^ n / K ^ (n + 1)` of the augmentation filtration**, as a
`B`-module. -/
abbrev augmentationGraded (n : ℕ) : Type _ :=
  ((augmentationIdeal g ^ n).restrictScalars B) ⧸ augmentationFiltrationStep g n

/-- The translate of a degree-`n` homogeneous polynomial lies in `K ^ n`. -/
theorem translateEquiv_mem_of_mem_homogeneousSubmodule {n : ℕ} {q : MvPolynomial σ B}
    (hq : q ∈ homogeneousSubmodule σ B n) : translateEquiv g q ∈ augmentationIdeal g ^ n :=
  translateEquiv_mem_augmentationIdeal_pow g
    (mem_degreeGE_of_isHomogeneous ((mem_homogeneousSubmodule n q).1 hq))

/-- Translation, as a `B`-linear map from the degree-`n` homogeneous part into `K ^ n`. -/
def homogeneousToPow (n : ℕ) :
    homogeneousSubmodule σ B n →ₗ[B] (augmentationIdeal g ^ n).restrictScalars B :=
  LinearMap.codRestrict _
    ((translateEquiv g).toLinearMap ∘ₗ (homogeneousSubmodule σ B n).subtype)
    fun q => translateEquiv_mem_of_mem_homogeneousSubmodule g q.2

/-- The composite of `MvPolynomial.homogeneousToPow` with the quotient map. -/
def homogeneousToGraded (n : ℕ) :
    homogeneousSubmodule σ B n →ₗ[B] augmentationGraded g n :=
  (augmentationFiltrationStep g n).mkQ ∘ₗ homogeneousToPow g n

/-- The degree-`n` homogeneous component of the untranslate, as a `B`-linear map from `K ^ n`
to the degree-`n` homogeneous part. -/
def powToHomogeneous (n : ℕ) :
    ((augmentationIdeal g ^ n).restrictScalars B) →ₗ[B] homogeneousSubmodule σ B n :=
  LinearMap.codRestrict _
    (homogeneousComponent n ∘ₗ (translateEquiv g).symm.toLinearMap ∘ₗ
      ((augmentationIdeal g ^ n).restrictScalars B).subtype)
    fun _ => homogeneousComponent_mem n _

/-- The underlying polynomial of `powToHomogeneous g n x` is the degree-`n` homogeneous
component of `(translateEquiv g).symm x`. -/
theorem coe_powToHomogeneous (n : ℕ) (x : (augmentationIdeal g ^ n).restrictScalars B) :
    (powToHomogeneous g n x : MvPolynomial σ B)
      = homogeneousComponent n ((translateEquiv g).symm (x : MvPolynomial σ B)) :=
  rfl

/-- `MvPolynomial.powToHomogeneous` kills `K ^ (n + 1)`: the untranslate of an element of
`K ^ (n + 1)` has no monomials of degree `n`. -/
theorem powToHomogeneous_eq_zero_of_mem {n : ℕ}
    (x : (augmentationIdeal g ^ n).restrictScalars B)
    (hx : (x : MvPolynomial σ B) ∈ augmentationIdeal g ^ (n + 1)) :
    powToHomogeneous g n x = 0 := by
  have hq : (translateEquiv g).symm (x : MvPolynomial σ B) ∈ degreeGE σ B (n + 1) :=
    (mem_augmentationIdeal_pow_iff g).1 hx
  refine Subtype.ext ?_
  rw [coe_powToHomogeneous]
  refine homogeneousComponent_eq_zero' n _ fun d hd => ?_
  have := hq d hd
  omega

/-- The map `K ^ n / K ^ (n + 1) → Hⁿ` induced by `MvPolynomial.powToHomogeneous`. -/
def gradedToHomogeneous (n : ℕ) :
    augmentationGraded g n →ₗ[B] homogeneousSubmodule σ B n :=
  Submodule.liftQ _ (powToHomogeneous g n) fun x hx => powToHomogeneous_eq_zero_of_mem g x hx

/-- **The degree-`n` homogeneous part computes the `n`-th graded piece.** The `B`-linear
isomorphism between the degree-`n` homogeneous polynomials and `K ^ n / K ^ (n + 1)`, given by
translating the variables. -/
def homogeneousEquivGraded (n : ℕ) :
    homogeneousSubmodule σ B n ≃ₗ[B] augmentationGraded g n :=
  LinearEquiv.ofLinearMap (homogeneousToGraded g n) (gradedToHomogeneous g n)
    (by
      refine LinearMap.ext fun z => ?_
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      refine (Submodule.Quotient.eq _).2 (Submodule.mem_comap.2 ?_)
      change translateEquiv g (homogeneousComponent n
            ((translateEquiv g).symm (x : MvPolynomial σ B))) - (x : MvPolynomial σ B)
          ∈ (augmentationIdeal g ^ (n + 1)).restrictScalars B
      have hx : (translateEquiv g).symm (x : MvPolynomial σ B) ∈ degreeGE σ B n :=
        (mem_augmentationIdeal_pow_iff g).1 x.2
      have hmem := translateEquiv_mem_augmentationIdeal_pow g
        (homogeneousComponent_sub_mem_degreeGE hx)
      rwa [map_sub, AlgEquiv.apply_symm_apply] at hmem)
    (by
      refine LinearMap.ext fun q => ?_
      refine Subtype.ext ?_
      change homogeneousComponent n ((translateEquiv g).symm (translateEquiv g (q : _)))
        = (q : MvPolynomial σ B)
      rw [AlgEquiv.symm_apply_apply]
      exact homogeneousComponent_eq_self ((mem_homogeneousSubmodule n _).1 q.2))

/-- `homogeneousEquivGraded g n` sends `q` to the class of its translate. -/
private theorem homogeneousEquivGraded_apply_mk (n : ℕ) (q : homogeneousSubmodule σ B n)
    (y : (augmentationIdeal g ^ n).restrictScalars B) (h : translateEquiv g q = y) :
    homogeneousEquivGraded g n q = Submodule.Quotient.mk y :=
  congrArg (Submodule.Quotient.mk (p := augmentationFiltrationStep g n)) (Subtype.ext h)

/-! ### The graded pieces are symmetric powers -/

/-- A product of `n` degree-one generators lies in the `n`-th symmetric power. -/
theorem prod_ι_mem_symmetricPower {M : Type*} [AddCommGroup M] [Module B M] (n : ℕ)
    (v : Fin n → M) :
    ∏ i, SymmetricAlgebra.ι B M (v i) ∈ SymPow.symmetricPower n B M := by
  induction n with
  | zero =>
    show (1 : SymmetricAlgebra B M) ∈ LinearMap.range (SymmetricAlgebra.ι B M) ^ 0
    rw [pow_zero]
    exact Submodule.one_le.1 le_rfl
  | succ n ih =>
    rw [Fin.prod_univ_castSucc]
    show _ ∈ LinearMap.range (SymmetricAlgebra.ι B M) ^ (n + 1)
    rw [pow_succ]
    exact Submodule.mul_mem_mul (ih _) (LinearMap.mem_range_self _ _)

/-- **The graded pieces of the augmentation filtration are the symmetric powers of the free
`B`-module on `σ`.** For every `n`, the `B`-linear isomorphism

`Symⁿ_B(σ →₀ B) ≃ₗ[B] K ^ n / K ^ (n + 1)`.

It is the canonical one: by `MvPolynomial.symmetricPowerEquivAugmentationGraded_prod_ι` it
carries the symmetric product of `Finsupp.single (s i) 1` to the class of the product of the
generators `X (s i) - C (g (s i))` of `K`. -/
def symmetricPowerEquivAugmentationGraded (n : ℕ) :
    SymPow.symmetricPower n B (σ →₀ B) ≃ₗ[B] augmentationGraded g n :=
  (SymPow.symmetricPowerEquivHomogeneousSubmodule
      (Finsupp.basisSingleOne : Module.Basis σ B (σ →₀ B)) n).trans
    (homogeneousEquivGraded g n)

/-- A product of `n` variables is homogeneous of degree `n`. -/
theorem prod_X_mem_homogeneousSubmodule (n : ℕ) (s : Fin n → σ) :
    (∏ i, (X (s i) : MvPolynomial σ B)) ∈ homogeneousSubmodule σ B n := by
  have h := MvPolynomial.IsHomogeneous.prod Finset.univ
    (fun i => (X (s i) : MvPolynomial σ B)) (fun _ => 1) fun i _ => isHomogeneous_X B (s i)
  simpa using h

/-- **The characterising equation of
`MvPolynomial.symmetricPowerEquivAugmentationGraded`.** The symmetric product of the basis
vectors `Finsupp.single (s i) 1` of `σ →₀ B` is carried to the class of
`∏ i, (X (s i) - C (g (s i)))` in `K ^ n / K ^ (n + 1)`. -/
theorem symmetricPowerEquivAugmentationGraded_prod_ι (n : ℕ) (s : Fin n → σ)
    (hs : ∏ i, SymmetricAlgebra.ι B (σ →₀ B) (Finsupp.single (s i) 1) ∈
      SymPow.symmetricPower n B (σ →₀ B))
    (ht : ∏ i, (X (s i) - C (g (s i)) : MvPolynomial σ B) ∈ augmentationIdeal g ^ n) :
    symmetricPowerEquivAugmentationGraded g n
        ⟨∏ i, SymmetricAlgebra.ι B (σ →₀ B) (Finsupp.single (s i) 1), hs⟩ =
      Submodule.Quotient.mk ⟨∏ i, (X (s i) - C (g (s i)) : MvPolynomial σ B), ht⟩ := by
  have hX := prod_X_mem_homogeneousSubmodule (B := B) n s
  have hcomp : SymPow.symmetricPowerEquivHomogeneousSubmodule
      (Finsupp.basisSingleOne : Module.Basis σ B (σ →₀ B)) n
      ⟨∏ i, SymmetricAlgebra.ι B (σ →₀ B) (Finsupp.single (s i) 1), hs⟩
      = ⟨∏ i, (X (s i) : MvPolynomial σ B), hX⟩ := by
    refine Subtype.ext ?_
    rw [SymPow.coe_symmetricPowerEquivHomogeneousSubmodule_apply]
    show SymmetricAlgebra.equivMvPolynomial (Finsupp.basisSingleOne : Module.Basis σ B (σ →₀ B))
        (∏ i, SymmetricAlgebra.ι B (σ →₀ B) (Finsupp.single (s i) 1))
      = ∏ i, (X (s i) : MvPolynomial σ B)
    rw [map_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [show (Finsupp.single (s i) 1 : σ →₀ B)
          = (Finsupp.basisSingleOne : Module.Basis σ B (σ →₀ B)) (s i) from
        (congrFun Finsupp.coe_basisSingleOne (s i)).symm,
      SymmetricAlgebra.equivMvPolynomial_ι_apply]
  have hprod : translateEquiv g (∏ i, (X (s i) : MvPolynomial σ B))
      = ∏ i, (X (s i) - C (g (s i)) : MvPolynomial σ B) := by
    rw [map_prod]
    exact Finset.prod_congr rfl fun i _ => translateEquiv_X g (s i)
  rw [symmetricPowerEquivAugmentationGraded, LinearEquiv.trans_apply, hcomp]
  exact homogeneousEquivGraded_apply_mk g n _ _ hprod

/-! ### The conormal module -/

variable (σ B) in
/-- The degree-one homogeneous part of `MvPolynomial σ B` is the free `B`-module on `σ`. -/
def homogeneousSubmoduleOneEquiv : homogeneousSubmodule σ B 1 ≃ₗ[B] (σ →₀ B) :=
  (LinearEquiv.ofEq _ _ homogeneousSubmodule_one_eq_span_X).trans
    (Module.Basis.span (linearIndependent_X σ B)).repr

/-- `homogeneousSubmoduleOneEquiv σ B` sends `X s` to `Finsupp.single s 1`. -/
theorem homogeneousSubmoduleOneEquiv_X (s : σ)
    (h : (X s : MvPolynomial σ B) ∈ homogeneousSubmodule σ B 1) :
    homogeneousSubmoduleOneEquiv σ B ⟨X s, h⟩ = Finsupp.single s 1 :=
  Module.Basis.span_repr_eq_single (linearIndependent_X σ B) s _

/-- **The conormal module `K / K ^ 2` is the free `B`-module on `σ`.** -/
def augmentationGradedOneEquiv : augmentationGraded g 1 ≃ₗ[B] (σ →₀ B) :=
  (homogeneousEquivGraded g 1).symm.trans (homogeneousSubmoduleOneEquiv σ B)

/-- **The characterising equation of `MvPolynomial.augmentationGradedOneEquiv`**: the class of
the generator `X s - C (g s)` of `K` in `K / K ^ 2` corresponds to `Finsupp.single s 1`. -/
theorem augmentationGradedOneEquiv_mk (s : σ)
    (h : (X s - C (g s) : MvPolynomial σ B) ∈ augmentationIdeal g ^ 1) :
    augmentationGradedOneEquiv g (Submodule.Quotient.mk ⟨X s - C (g s), h⟩)
      = Finsupp.single s 1 := by
  have hX : (X s : MvPolynomial σ B) ∈ homogeneousSubmodule σ B 1 := isHomogeneous_X B s
  have hgr := homogeneousEquivGraded_apply_mk g 1 ⟨X s, hX⟩ ⟨X s - C (g s), h⟩
    (translateEquiv_X g s)
  rw [augmentationGradedOneEquiv, LinearEquiv.trans_apply, ← hgr,
    LinearEquiv.symm_apply_apply, homogeneousSubmoduleOneEquiv_X]

/-! ### Freeness of the powers of the augmentation ideal -/

/-- Translation, as a `B`-linear isomorphism from the monomials of degree at least `n` onto
`K ^ n`. -/
def degreeGEEquivAugmentationIdealPow (n : ℕ) :
    degreeGE σ B n ≃ₗ[B] (augmentationIdeal g ^ n).restrictScalars B :=
  LinearEquiv.ofLinearMap
    (LinearMap.codRestrict _
      ((translateEquiv g).toLinearMap ∘ₗ (degreeGE σ B n).subtype)
      fun q => translateEquiv_mem_augmentationIdeal_pow g q.2)
    (LinearMap.codRestrict _
      ((translateEquiv g).symm.toLinearMap ∘ₗ
        ((augmentationIdeal g ^ n).restrictScalars B).subtype)
      fun x => (mem_augmentationIdeal_pow_iff g).1 x.2)
    (by
      refine LinearMap.ext fun x => Subtype.ext ?_
      exact AlgEquiv.apply_symm_apply (translateEquiv g) (x : MvPolynomial σ B))
    (by
      refine LinearMap.ext fun q => Subtype.ext ?_
      exact AlgEquiv.symm_apply_apply (translateEquiv g) (q : MvPolynomial σ B))

/-- The monomial basis of `K ^ n`, indexed by the multidegrees of total degree at least `n`:
the basis element at `d` is the translate of the monomial `X ^ d`, that is,
`∏ s, (X s - C (g s)) ^ d s`. -/
def basisAugmentationIdealPow (n : ℕ) :
    Module.Basis {d : σ →₀ ℕ // n ≤ d.degree} B ↥(augmentationIdeal g ^ n) :=
  (basisDegreeGE σ B n).map (degreeGEEquivAugmentationIdealPow g n)

/-- **Every power of the augmentation ideal is a free `B`-module.** -/
theorem free_augmentationIdeal_pow (n : ℕ) : Module.Free B ↥(augmentationIdeal g ^ n) :=
  Module.Free.of_basis (basisAugmentationIdealPow g n)

end MvPolynomial

