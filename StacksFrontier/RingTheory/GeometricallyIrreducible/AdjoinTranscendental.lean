/-- An extension of fields `K/k` is geometrically irreducible if and only if the induced extension
`K(X)/k(X)` of purely transcendental extensions in one variable is geometrically irreducible. -/
@[stacks 0G31]
public theorem AlgebraicGeometry.GeometricallyIrreducible.iff_ratFunc (k K : Type u) [Field k]
    [Field K] [Algebra k K] :
    GeometricallyIrreducible (Spec.map (ofHom (algebraMap k K))) ↔
      GeometricallyIrreducible (Spec.map (ofHom (algebraMap k⟮X⟯ K⟮X⟯))) :=
  Stacks.Irreducibility.RationalFunctions.solution k K

namespace Stacks.Irreducibility.AdjoinTranscendental

open AlgebraicGeometry CategoryTheory CommRingCat IntermediateField

open scoped Polynomial RatFunc

attribute [local instance] Polynomial.algebra

noncomputable section

/-! ### Ring isomorphisms of intermediate fields and of rational function fields -/

/-- A morphism property of schemes that respects isomorphisms transports along a commuting square
of ring isomorphisms: if `f' ∘ α = β ∘ f` for isomorphisms `α : A ≃+* A'` and `β : B ≃+* B'`, then
`Spec f` and `Spec f'` are isomorphic arrows. -/
private theorem prop_specMap_ofHom_of_ringEquiv {A B A' B' : Type u} [CommRing A] [CommRing B]
    [CommRing A'] [CommRing B'] (P : MorphismProperty Scheme.{u}) [P.RespectsIso] {f : A →+* B}
    {f' : A' →+* B'} (α : A ≃+* A') (β : B ≃+* B') (hcomm : ∀ a, f' (α a) = β (f a))
    (h : P (Spec.map (ofHom f))) : P (Spec.map (ofHom f')) := by
  have hβ : IsIso (ofHom (β.symm : B' →+* B)) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr β.symm.bijective
  have hα : IsIso (ofHom (α.symm : A' →+* A)) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr α.symm.bijective
  have key : ofHom (α.symm : A' →+* A) ≫ ofHom f = ofHom f' ≫ ofHom (β.symm : B' →+* B) := by
    ext a
    have h₂ := hcomm (α.symm a)
    rw [α.apply_symm_apply] at h₂
    simp [h₂]
  have e : Arrow.mk (Spec.map (ofHom f)) ≅ Arrow.mk (Spec.map (ofHom f')) :=
    Arrow.isoMk (asIso (Spec.map (ofHom (β.symm : B' →+* B))))
      (asIso (Spec.map (ofHom (α.symm : A' →+* A))))
      (by simpa only [Arrow.mk_hom, asIso_hom, ← Spec.map_comp]
        using congrArg Spec.map key.symm)
  exact (P.arrow_mk_iso_iff e).mp h

/-- Two ring homomorphisms out of the field `k(X)` of rational functions agree as soon as they
agree on the constants and on the variable. -/
private theorem RatFunc.ringHom_ext {k P : Type*} [Field k] [CommRing P]
    {φ ψ : RatFunc k →+* P} (hC : ∀ a : k, φ (RatFunc.C a) = ψ (RatFunc.C a))
    (hX : φ RatFunc.X = ψ RatFunc.X) : φ = ψ :=
  IsLocalization.ringHom_ext (nonZeroDivisors k[X])
    (Polynomial.ringHom_ext (by simpa using hC) (by simpa using hX))

/-- The isomorphism `k(X) ≅ k⟮y⟯` attached to a transcendental `y` is the identity on
constants. -/
private theorem RatFunc.coe_algEquivOfTranscendental_C {k E : Type*} [Field k] [Field E]
    [Algebra k E] {y : E} (hy : Transcendental k y) (a : k) :
    ((RatFunc.algEquivOfTranscendental y hy (RatFunc.C a) : ↥k⟮y⟯) : E) = algebraMap k E a := by
  rw [← RatFunc.algebraMap_eq_C, AlgEquiv.commutes]
  simp

/-- Two intermediate fields of `E` with the same elements have isomorphic underlying fields, even
when their base fields differ. -/
private def IntermediateField.ringEquivOfMemIff {F F' E : Type*} [Field F] [Field F'] [Field E]
    [Algebra F E] [Algebra F' E] (S : IntermediateField F E) (T : IntermediateField F' E)
    (h : ∀ y : E, y ∈ S ↔ y ∈ T) : ↥S ≃+* ↥T where
  toFun z := ⟨z.1, (h z.1).1 z.2⟩
  invFun z := ⟨z.1, (h z.1).2 z.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

/-- The isomorphism `IntermediateField.ringEquivOfMemIff` is the identity on elements of `E`. -/
private theorem IntermediateField.coe_ringEquivOfMemIff {F F' E : Type*} [Field F] [Field F']
    [Field E] [Algebra F E] [Algebra F' E] (S : IntermediateField F E)
    (T : IntermediateField F' E) (h : ∀ y : E, y ∈ S ↔ y ∈ T) (z : ↥S) :
    ((IntermediateField.ringEquivOfMemIff S T h z : ↥T) : E) = (z : E) :=
  rfl

attribute [local simp] IntermediateField.coe_ringEquivOfMemIff

/-! ### The map on rational function fields -/

section RatFuncMap

variable {M L : Type u} [Field M] [Field L] [Algebra M L]

/-- The map `M(X) → L(X)` induced by `M → L` is compatible with the map `M[X] → L[X]`. -/
private theorem algebraMap_ratFunc_algebraMap (p : M[X]) :
    algebraMap (RatFunc M) (RatFunc L) (algebraMap M[X] (RatFunc M) p)
      = algebraMap L[X] (RatFunc L) (p.map (algebraMap M L)) := by
  rw [← IsScalarTower.algebraMap_apply M[X] (RatFunc M) (RatFunc L),
    IsScalarTower.algebraMap_apply M[X] L[X] (RatFunc L)]
  simp [RingHom.algebraMap_toAlgebra]

/-- The map `M(X) → L(X)` induced by `M → L` restricts to `M → L` on the constants. -/
private theorem algebraMap_ratFunc_C (a : M) :
    algebraMap (RatFunc M) (RatFunc L) (RatFunc.C a) = RatFunc.C (algebraMap M L a) := by
  rw [← RatFunc.algebraMap_C, algebraMap_ratFunc_algebraMap]
  simp

/-- The map `M(X) → L(X)` induced by `M → L` fixes the variable. -/
private theorem algebraMap_ratFunc_X :
    algebraMap (RatFunc M) (RatFunc L) RatFunc.X = RatFunc.X := by
  rw [← RatFunc.algebraMap_X, algebraMap_ratFunc_algebraMap]
  simp

end RatFuncMap

/-! ### The extension `L(x)/M(x)` inside `K` -/

section Tower

variable {M L K : Type u} [Field M] [Field L] [Field K] [Algebra M L] [Algebra M K] [Algebra L K]
  [IsScalarTower M L K] {x : K}

/-- Inside `K`, the `M⟮x⟯`-subfield generated by the image of `L` has the same elements as `L⟮x⟯`:
both are the subfield generated over `M` by `x` together with the image of `L`. -/
private theorem mem_adjoin_range_algebraMap_iff (y : K) :
    y ∈ (L⟮x⟯ : IntermediateField L K) ↔ y ∈ adjoin ↥M⟮x⟯ (Set.range (algebraMap L K)) := by
  have h1 : (adjoin ↥M⟮x⟯ (Set.range (algebraMap L K))).restrictScalars M
      = adjoin M ({x} ∪ Set.range (algebraMap L K)) := by
    rw [← adjoin_adjoin_left]
  have h2 : (L⟮x⟯ : IntermediateField L K).restrictScalars M
      = adjoin M ({x} ∪ Set.range (algebraMap L K)) := by
    have hi : algebraMap L K
        = (algebraMap ↥(IsScalarTower.toAlgHom M L K).fieldRange K)
          ∘ (AlgHom.equivFieldRange (IsScalarTower.toAlgHom M L K)) := rfl
    rw [restrictScalars_adjoin_of_algEquiv (AlgHom.equivFieldRange
      (IsScalarTower.toAlgHom M L K)) hi, restrictScalars_adjoin, AlgHom.coe_fieldRange,
      Set.union_comm]
    rfl
  rw [← mem_restrictScalars (K := M) (E := (L⟮x⟯ : IntermediateField L K)),
    ← mem_restrictScalars (K := M) (E := adjoin ↥M⟮x⟯ (Set.range (algebraMap L K))), h1, h2]

/-- The square of `M(X) ≅ M⟮x⟯`, `L(X) ≅ L(x)`, the map `M(X) → L(X)` induced by `M → L` and the
inclusion `M⟮x⟯ → L(x)` commutes. -/
private theorem algebraMap_algEquivOfTranscendental_comm (hxM : Transcendental M x)
    (hx : Transcendental L x) (u : RatFunc M) :
    algebraMap ↥M⟮x⟯ ↥(adjoin ↥M⟮x⟯ (Set.range (algebraMap L K)))
        (RatFunc.algEquivOfTranscendental x hxM u)
      = (RatFunc.algEquivOfTranscendental x hx).toRingEquiv.trans
          (IntermediateField.ringEquivOfMemIff (L⟮x⟯ : IntermediateField L K) _
            mem_adjoin_range_algebraMap_iff)
          (algebraMap (RatFunc M) (RatFunc L) u) := by
  refine FaithfulSMul.algebraMap_injective _ K (RingHom.congr_fun (RatFunc.ringHom_ext
    (φ := (algebraMap ↥(adjoin ↥M⟮x⟯ (Set.range (algebraMap L K))) K).comp
      ((algebraMap ↥M⟮x⟯ ↥(adjoin ↥M⟮x⟯ (Set.range (algebraMap L K)))).comp
        (RatFunc.algEquivOfTranscendental x hxM).toRingEquiv.toRingHom))
    (ψ := (algebraMap ↥(adjoin ↥M⟮x⟯ (Set.range (algebraMap L K))) K).comp
      (((RatFunc.algEquivOfTranscendental x hx).toRingEquiv.trans
        (IntermediateField.ringEquivOfMemIff (L⟮x⟯ : IntermediateField L K) _
          mem_adjoin_range_algebraMap_iff)).toRingHom.comp
        (algebraMap (RatFunc M) (RatFunc L)))) (fun a ↦ ?_) ?_) u)
  · simp [algebraMap_ratFunc_C, RatFunc.coe_algEquivOfTranscendental_C,
      IsScalarTower.algebraMap_apply M L K]
  · simp [algebraMap_ratFunc_X]

end Tower

/-! ### Adjoining a transcendental element -/

/-- Let `K/L/M` be a tower of fields with `L/M` geometrically irreducible and let
`x : K` be transcendental over `L`. Then `L(x)/M(x)` is geometrically irreducible. -/
public theorem solution
    {M L K : Type u} [Field M] [Field L] [Field K] [Algebra M L] [Algebra M K] [Algebra L K]
    [IsScalarTower M L K]
    [GeometricallyIrreducible (Spec.map (CommRingCat.ofHom (algebraMap M L)))]
    {x : K} (hx : Transcendental L x) :
    GeometricallyIrreducible (Spec.map (CommRingCat.ofHom
      (algebraMap ↥M⟮x⟯ ↥(adjoin ↥M⟮x⟯ (Set.range (algebraMap L K)))))) := by
  have hxM : Transcendental M x := hx.of_tower_top M
  have : MorphismProperty.RespectsIso @GeometricallyIrreducible :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  exact prop_specMap_ofHom_of_ringEquiv _ (RatFunc.algEquivOfTranscendental x hxM).toRingEquiv
    ((RatFunc.algEquivOfTranscendental x hx).toRingEquiv.trans
      (IntermediateField.ringEquivOfMemIff (L⟮x⟯ : IntermediateField L K) _
        mem_adjoin_range_algebraMap_iff))
    (algebraMap_algEquivOfTranscendental_comm hxM hx)
    ((AlgebraicGeometry.GeometricallyIrreducible.iff_ratFunc M L).mp ‹_›)

end

end Stacks.Irreducibility.AdjoinTranscendental

@[expose] public section

open AlgebraicGeometry IntermediateField

/-- Let `K/L/M` be a tower of fields with `L` geometrically irreducible over `M`, and let
`x : K` be transcendental over `L`. Then `L(x)` is geometrically irreducible over `M(x)`,
where `M(x) = M⟮x⟯` and `L(x)` is the `M⟮x⟯`-subfield of `K` generated by the image
of `L`. -/
@[stacks 0G32]
public theorem AlgebraicGeometry.geometricallyIrreducible_specMap_adjoin_of_transcendental
    {M L K : Type u} [Field M] [Field L] [Field K] [Algebra M L] [Algebra M K] [Algebra L K]
    [IsScalarTower M L K]
    [GeometricallyIrreducible (Spec.map (CommRingCat.ofHom (algebraMap M L)))]
    {x : K} (hx : Transcendental L x) :
    GeometricallyIrreducible (Spec.map (CommRingCat.ofHom
      (algebraMap ↥M⟮x⟯ ↥(adjoin ↥M⟮x⟯ (Set.range (algebraMap L K)))))) :=
  Stacks.Irreducibility.AdjoinTranscendental.solution hx
