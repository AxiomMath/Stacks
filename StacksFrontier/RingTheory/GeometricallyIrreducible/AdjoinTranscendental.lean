section Nilradical

variable {A B F : Type*} [CommRing A] [CommRing B] [FunLike F A B] [RingHomClass F A B]

/-- Isomorphic rings have prime nilradical together. -/
private theorem isPrime_nilradical_congr (e : A ≃+* B) :
    (nilradical A).IsPrime ↔ (nilradical B).IsPrime :=
  ⟨SeparableCriteria.isPrime_nilradical_of_injective e.symm e.symm.injective,
    SeparableCriteria.isPrime_nilradical_of_injective e e.injective⟩

/-- A prime nilradical contains no non-zero-divisor. -/
private theorem disjoint_nonZeroDivisors_nilradical (h : (nilradical A).IsPrime) :
    Disjoint (nonZeroDivisors A : Set A) (nilradical A) := by
  refine Set.disjoint_left.mpr fun {a} ha hnil ↦ h.ne_top ((Ideal.eq_top_iff_one _).mpr ?_)
  obtain ⟨n, hn⟩ := mem_nilradical.mp hnil
  have h1 : (1 : A) = 0 := (mem_nonZeroDivisors_iff.mp (hn ▸ pow_mem ha n)).2 1 (mul_zero 1)
  exact mem_nilradical.mpr ⟨1, by rw [pow_one, h1]⟩

/-- A ring and its localization at a submonoid of non-zero-divisors have the same generic point:
the nilradical of one is prime exactly when the nilradical of the other is. -/
private theorem isPrime_nilradical_iff_of_isLocalization [Algebra A B] (M : Submonoid A)
    [IsLocalization M B] (hM : M ≤ nonZeroDivisors A) :
    (nilradical A).IsPrime ↔ (nilradical B).IsPrime := by
  rw [IsLocalization.isPrime_iff_isPrime_disjoint M B, Ideal.under_def,
    ← SeparableCriteria.nilradical_eq_comap_of_injective (algebraMap A B)
      (IsLocalization.injective B hM)]
  exact (and_iff_left_of_imp fun h ↦
    (disjoint_nonZeroDivisors_nilradical h).mono_left fun _ hx ↦ hM hx).symm

end Nilradical

section Flat

/-- A flat algebra map preserves non-zero-divisors. -/
@[ega "0 6.3.4" "M = S", ega "IV 20.6.9" "partial"]
private theorem algebraMapSubmonoid_nonZeroDivisors_le {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] :
    Algebra.algebraMapSubmonoid S (nonZeroDivisors R) ≤ nonZeroDivisors S := by
  rintro _ ⟨p, hp, rfl⟩
  refine mem_nonZeroDivisors_iff.mpr ⟨fun x hx ↦ ?_, fun x hx ↦ ?_⟩ <;>
    exact (Module.Flat.isSMulRegular_of_nonZeroDivisors (M := S) hp).right_eq_zero_of_smul
      (by rw [Algebra.smul_def]; simpa [mul_comm] using hx)

end Flat

section RatFunc

/-- The ring isomorphism `K[X] ⊗[k[X]] Ω ≃+* K ⊗[k] Ω`. -/
private noncomputable def tensorProductPolynomialRingEquiv (k K Ω : Type u) [Field k] [Field K]
    [Algebra k K] [CommRing Ω] [Algebra k Ω] [Algebra k[X] Ω] [IsScalarTower k k[X] Ω] :
    K[X] ⊗[k[X]] Ω ≃+* K ⊗[k] Ω :=
  (((Algebra.TensorProduct.comm k[X] K[X] Ω).trans
      ((Algebra.TensorProduct.congr AlgEquiv.refl
        (Algebra.IsPushout.equiv k k[X] K K[X]).symm).trans
          (Algebra.TensorProduct.cancelBaseChange k k[X] k[X] Ω K))).toRingEquiv).trans
    (Algebra.TensorProduct.comm k Ω K).toRingEquiv

/-- For a field extension `Ω/k(X)`, the nilradical of `K ⊗[k] Ω` is prime if and only if the
nilradical of `K(X) ⊗[k(X)] Ω` is. -/
private theorem isPrime_nilradical_tensorProduct_ratFunc_iff (k K Ω : Type u) [Field k] [Field K]
    [Algebra k K] [Field Ω] [Algebra k Ω] [Algebra k⟮X⟯ Ω] [IsScalarTower k k⟮X⟯ Ω] :
    (nilradical (K ⊗[k] Ω)).IsPrime ↔ (nilradical (K⟮X⟯ ⊗[k⟮X⟯] Ω)).IsPrime := by
  let _ : Algebra k[X] Ω := ((algebraMap k⟮X⟯ Ω).comp (algebraMap k[X] k⟮X⟯)).toAlgebra
  have _ : IsScalarTower k[X] k⟮X⟯ Ω := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have _ : IsScalarTower k k[X] Ω := IsScalarTower.of_algebraMap_eq fun x ↦ by
    rw [RingHom.algebraMap_toAlgebra]
    simp [IsScalarTower.algebraMap_apply k k⟮X⟯ Ω]
  have _ : Module.Flat k[X] Ω := Module.Flat.trans k[X] k⟮X⟯ Ω
  calc (nilradical (K ⊗[k] Ω)).IsPrime
      ↔ (nilradical (K[X] ⊗[k[X]] Ω)).IsPrime :=
        (isPrime_nilradical_congr (tensorProductPolynomialRingEquiv k K Ω)).symm
    _ ↔ (nilradical ((K[X] ⊗[k[X]] Ω) ⊗[K[X]] K⟮X⟯)).IsPrime :=
        isPrime_nilradical_iff_of_isLocalization
          (Algebra.algebraMapSubmonoid (K[X] ⊗[k[X]] Ω) (nonZeroDivisors K[X]))
          algebraMapSubmonoid_nonZeroDivisors_le
    _ ↔ (nilradical (K⟮X⟯ ⊗[k[X]] Ω)).IsPrime :=
        isPrime_nilradical_congr
          ((Algebra.TensorProduct.comm K[X] (K[X] ⊗[k[X]] Ω) K⟮X⟯).toRingEquiv.trans
            (Algebra.TensorProduct.cancelBaseChange k[X] K[X] K⟮X⟯ K⟮X⟯ Ω).toRingEquiv)
    _ ↔ (nilradical (K⟮X⟯ ⊗[k⟮X⟯] Ω)).IsPrime :=
        (isPrime_nilradical_congr
          (IsLocalization.algebraTensorEquiv (nonZeroDivisors k[X]) k⟮X⟯ K⟮X⟯ Ω).toRingEquiv).symm

end RatFunc

/-- If `K ⊗[k] Ω` has prime nilradical for some algebraically closed field `Ω` over `k`, then
`K/k` is geometrically irreducible. -/
private theorem geometricallyIrreducible_of_isPrime_nilradical (k K Ω : Type u) [Field k]
    [Field K] [Algebra k K] [Field Ω] [Algebra k Ω] [IsAlgClosed Ω]
    (h : (nilradical (K ⊗[k] Ω)).IsPrime) :
    GeometricallyIrreducible (Spec.map (ofHom (algebraMap k K))) := by
  refine ((AlgebraicGeometry.geometricallyIrreducible_tfae k K (SeparableClosure k)
    (AlgebraicClosure k)).out 4 5).mp ?_
  have g : AlgebraicClosure k →ₐ[k] Ω := IsAlgClosed.lift
  rw [PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical]
  exact SeparableCriteria.isPrime_nilradical_of_injective
    (Algebra.TensorProduct.map (AlgHom.id k K) g)
    (SeparableCriteria.injective_tensorProduct_map_id g g.toRingHom.injective) h

/-- An extension of fields `K/k` is geometrically irreducible if and only if the induced extension
`K(X)/k(X)` of purely transcendental extensions in one variable is geometrically irreducible. -/
public theorem solution (k K : Type u) [Field k] [Field K] [Algebra k K] :
    GeometricallyIrreducible (Spec.map (ofHom (algebraMap k K))) ↔
      GeometricallyIrreducible (Spec.map (ofHom (algebraMap k⟮X⟯ K⟮X⟯))) := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · refine (Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_tensorProduct
      k⟮X⟯ K⟮X⟯).mpr fun Ω _ _ ↦ ?_
    let _ : Algebra k Ω := ((algebraMap k⟮X⟯ Ω).comp (algebraMap k k⟮X⟯)).toAlgebra
    have _ : IsScalarTower k k⟮X⟯ Ω := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
    rw [PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical,
      ← isPrime_nilradical_tensorProduct_ratFunc_iff k K Ω,
      ← PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical]
    exact (Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_tensorProduct
      k K).mp h Ω
  · exact geometricallyIrreducible_of_isPrime_nilradical k K (AlgebraicClosure k⟮X⟯)
      ((isPrime_nilradical_tensorProduct_ratFunc_iff k K (AlgebraicClosure k⟮X⟯)).mpr
        (PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical.mp
          ((Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_tensorProduct
            k⟮X⟯ K⟮X⟯).mp h (AlgebraicClosure k⟮X⟯))))

end Stacks.Irreducibility.RationalFunctions

