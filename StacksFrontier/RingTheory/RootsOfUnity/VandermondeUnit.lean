/-!
# A Vandermonde-type product of roots of unity is a unit

Fix a prime `p`. The base ring is `R = ℤ[1/p]`, the localization of `ℤ` at the
powers of `p`, equivalently the subring of `ℚ` generated by `1/p`; in `R` the
element `p` is a unit. Let `Φ(x) = x^{p-1} + ⋯ + x + 1 = ∑_{i<p} xⁱ ∈ R[x]`, so
that `(x - 1) Φ(x) = xᵖ - 1`, and let `R' = R[x]/(Φ(x))`. Since `Φ` is monic of
degree `p - 1`, `R'` is free of rank `p - 1` over `R` on the images of
`1, x, …, x^{p-2}`. Write `ξ ∈ R'` for the class of `x` and `αᵢ = ξⁱ`.

The main result is that for every `d < p` the element

`Δ_d = ∏_{0 ≤ i < j < d} (αᵢ - αⱼ) ∈ R'`

is a unit. The product ranges over the ordered pairs `(i, j)` with
`0 ≤ i < j < d`; for `d ≤ 1` the index set is empty and `Δ_d = 1`, so the content
is the range `2 ≤ d ≤ p - 1`.

The argument rests on the factorization `Tᵖ - 1 = ∏_{i<p} (T - αᵢ)` over `R'[T]`.
Differentiating and evaluating at `T = αᵢ` gives
`p αᵢ^{p-1} = ∏_{k ≠ i} (αᵢ - α_k)`. Since `p` is a unit of `R` and `ξ` is a unit
because `ξᵖ = 1`, each left-hand side is a unit, hence so is each product
`∏_{k ≠ i} (αᵢ - α_k)`, hence each individual difference `αᵢ - αⱼ` with `i ≠ j`,
and therefore any product of such differences, in particular `Δ_d`.
-/

@[expose] public section

open Polynomial

variable (p : ℕ) [hp : Fact p.Prime]

/-- The base ring `R = Z[1/p]`, realized as the localization of `ℤ` away from `p`
(inverting the powers of `p`). -/
abbrev ZinvP := Localization.Away (p : ℤ)

/-- The polynomial `Phi(x) = ∑_{i=0}^{p-1} x^i = x^{p-1} + ... + x + 1 ∈ R[x]`. -/
noncomputable def cyclotomicPhi : (ZinvP p)[X] := ∑ i ∈ Finset.range p, X ^ i

/-- The extension ring `R' = R[x] / (Phi(x))`, obtained by adjoining a root of `Phi`. -/
noncomputable abbrev R' := AdjoinRoot (cyclotomicPhi p)

/-- `ξ ∈ R'`, the class of `x` in `R' = R[x]/(Phi)`. -/
noncomputable def xi : R' p := AdjoinRoot.root (cyclotomicPhi p)

/-- `α_i = ξ^i ∈ R'`, the class of the monomial `x^i`. -/
noncomputable def xiPow (i : ℕ) : R' p := (xi p) ^ i

/-- `Δ_d = ∏_{0 ≤ i < j < d} (α_i - α_j) ∈ R'`. The outer product ranges over
`j ∈ {0, ..., d-1}` and the inner product over `i ∈ {0, ..., j-1}`, so together the
pairs `(i, j)` with `0 ≤ i < j < d`. -/
noncomputable def vandermondeProd (d : ℕ) : R' p :=
  ∏ j ∈ Finset.range d, ∏ i ∈ Finset.range j, (xiPow p i - xiPow p j)

omit hp in
/-- `ξ` is a root of `Φ`, by construction of `AdjoinRoot`. -/
theorem Phi_root_eq_zero : aeval (xi p) (cyclotomicPhi p) = 0 := by
  unfold xi
  rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]

omit hp in
/-- `ξ ^ p = 1`, since `Φ (X - 1) = Xᵖ - 1` and `ξ` is a root of `Φ`. -/
theorem xi_pow_p_eq_one : (xi p) ^ p = 1 := by
  have hgeom : (cyclotomicPhi p) * (X - 1) = X ^ p - 1 := by
    unfold cyclotomicPhi
    exact geom_sum_mul X p
  have h0 := Phi_root_eq_zero p
  have hr : aeval (xi p) (X ^ p - 1 : (ZinvP p)[X]) = (xi p) ^ p - 1 := by
    simp
  have := congrArg (aeval (xi p)) hgeom
  rw [map_mul, h0, zero_mul, hr] at this
  -- this : 0 = (xi p)^p - 1
  rw [eq_comm, sub_eq_zero] at this
  exact this

/-- `ξ` is a unit of `R'`, with inverse `ξ ^ (p - 1)`, because `ξ ^ p = 1`. -/
theorem xi_isUnit : IsUnit (xi p) := by
  have hp1 : 1 ≤ p := hp.out.one_lt.le
  have hmul : (xi p) * (xi p) ^ (p - 1) = 1 := by
    rw [← pow_succ']
    have heq : p - 1 + 1 = p := by omega
    rw [heq]
    exact xi_pow_p_eq_one p
  exact ⟨⟨xi p, (xi p) ^ (p - 1), hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩

omit hp in
/-- `p` is a unit in `R = ℤ[1/p]`.

By construction `R` is the localization of `ℤ` at the submonoid of powers of `p`,
and every element of that submonoid maps to a unit under the structure map
`algebraMap ℤ R`. Since `p` itself lies in the submonoid its image is a unit, and
the cast of `p` into `R` agrees with that image. -/
theorem p_isUnit_R : IsUnit ((p : ℤ) : ZinvP p) := by
  simpa [algebraMap_int_eq] using
    (IsLocalization.Away.algebraMap_isUnit (R := ℤ) (S := ZinvP p) (p : ℤ))

omit hp in
/-- `p` is a unit in `R'`.

`R'` is an `R`-algebra, and a ring homomorphism sends units to units, so the image
of the unit `p` of `R` is a unit of `R'`. That image is the cast of the natural
number `p` into `R'` along the tower `ℤ → R → R'`. -/
theorem p_isUnit_R' : IsUnit ((p : ℕ) : R' p) := by
  have h := (p_isUnit_R p).map (algebraMap (ZinvP p) (R' p))
  simpa using h

omit hp in
/-- `ξ - 1` is a unit in `R'`. This is the mathematical crux.

Work in `R[X]`. For any polynomial `f` and any `a` one has
`(X - C a) ∣ (f - C (f.eval a))`; apply this with `a = 1` and `f = Φ`. Since
`Φ.eval 1 = ∑_{i<p} 1 = p`, this gives `(X - 1) ∣ (Φ - C p)`. Applying the ring
homomorphism `aeval ξ`, which preserves divisibility, yields
`(ξ - 1) ∣ (aeval ξ Φ - p)`, and `aeval ξ Φ = 0`, so `(ξ - 1) ∣ (-p)`. As `p` is a
unit of `R'`, so is `-p`, and a divisor of a unit is a unit. -/
theorem xi_sub_one_isUnit : IsUnit ((xi p) - 1) := by
  have heval : (cyclotomicPhi p).eval (1 : ZinvP p) = (p : ZinvP p) := by
    simp [cyclotomicPhi]
  have hdvd : (X - C (1 : ZinvP p)) ∣ (cyclotomicPhi p - C ((cyclotomicPhi p).eval (1 : ZinvP p)))
      :=
    X_sub_C_dvd_sub_C_eval
  rw [heval] at hdvd
  have hmap := map_dvd (aeval (xi p)) hdvd
  have hlhs : (aeval (xi p)) (X - C (1 : ZinvP p)) = xi p - 1 := by
    simp
  have hrhs : (aeval (xi p)) (cyclotomicPhi p - C ((p : ZinvP p))) = -(p : R' p) := by
    simp [Phi_root_eq_zero]
  rw [hlhs, hrhs] at hmap
  exact isUnit_of_dvd_unit hmap (p_isUnit_R' p).neg

omit hp in
/-- `1 - ξ` is a unit of `R'`, being the negation of the unit `ξ - 1`. -/
theorem one_sub_xi_isUnit : IsUnit (1 - (xi p)) := by
  have := xi_sub_one_isUnit p
  rw [show (1 : R' p) - xi p = -(xi p - 1) by ring]
  exact this.neg

/-- For `0 < k < p`, the element `1 - ξ ^ k` is a unit of `R'`.

Choose `a` with `k a ≡ 1 mod p`, so that `ξ ^ (k a) = ξ`. Then
`(1 - ξ ^ k) ∑_{i<a} (ξ ^ k) ^ i = 1 - ξ ^ (k a) = 1 - ξ`, which is a unit, and a
divisor of a unit is a unit. -/
theorem one_sub_xi_pow_isUnit (k : ℕ) (hk0 : 0 < k) (hk : k < p) :
    IsUnit (1 - (xi p) ^ k) := by
  -- Find a with (ξ^k)^a = ξ, so that 1 - ξ = (1 - ξ^k) * w.
  have hpp := hp.out
  have : Fact p.Prime := hp
  -- k is invertible mod p
  have hkne : ((k : ZMod p)) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff (ZMod p) p]
    intro hdvd
    have := Nat.le_of_dvd hk0 hdvd
    omega
  set a := ((k : ZMod p)⁻¹).val with ha
  have hka : (k * a : ZMod p) = 1 := by
    rw [ha]
    rw [ZMod.natCast_val, ZMod.cast_id]
    field_simp
  -- so ξ^(k*a) = ξ
  have hxiexp : (xi p) ^ (k * a) = xi p := by
    -- k * a ≡ 1 [MOD p]
    have hmod : (k * a) % p = 1 % p := by
      have : ((k * a : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by push_cast; rw [hka]
      rwa [ZMod.natCast_eq_natCast_iff'] at this
    -- write k*a = p*q + 1
    obtain ⟨q, hq⟩ : ∃ q, k * a = p * q + 1 := by
      refine ⟨(k * a) / p, ?_⟩
      have h1p : 1 % p = 1 := Nat.mod_eq_of_lt hpp.one_lt
      have := Nat.div_add_mod (k * a) p
      omega
    rw [hq, pow_add, pow_mul, xi_pow_p_eq_one, one_pow, pow_one, one_mul]
  -- 1 - ξ = (1 - ξ^k) * (∑ i in range a, (ξ^k)^i)
  have hdiv : (1 - (xi p) ^ k) * (∑ i ∈ Finset.range a, ((xi p) ^ k) ^ i) = 1 - xi p := by
    have hg := geom_sum_mul ((xi p) ^ k) a
    -- hg : (∑ i in range a, (ξ^k)^i) * (ξ^k - 1) = (ξ^k)^a - 1
    rw [← pow_mul] at hg
    rw [hxiexp] at hg
    -- hg : (∑ ...) * (ξ^k - 1) = ξ - 1
    have : (1 - (xi p) ^ k) * (∑ i ∈ Finset.range a, ((xi p) ^ k) ^ i)
         = -((∑ i ∈ Finset.range a, ((xi p) ^ k) ^ i) * ((xi p) ^ k - 1)) := by ring
    rw [this, hg]
    ring
  -- 1 - ξ is a unit and equals (1 - ξ^k) * w, so 1 - ξ^k is a unit
  have hu := one_sub_xi_isUnit p
  rw [← hdiv] at hu
  exact (isUnit_of_mul_isUnit_left hu)

/-- For `i < j < p` the difference `αᵢ - αⱼ` is a unit of `R'`: it factors as
`ξ ^ i (1 - ξ ^ (j - i))`, a product of the units `ξ ^ i` and `1 - ξ ^ (j - i)`. -/
theorem alpha_sub_isUnit (i j : ℕ) (hij : i < j) (hj : j < p) :
    IsUnit (xiPow p i - xiPow p j) := by
  have hfac : xiPow p i - xiPow p j = (xi p) ^ i * (1 - (xi p) ^ (j - i)) := by
    unfold xiPow
    rw [mul_sub, mul_one, ← pow_add]
    congr 2
    omega
  rw [hfac]
  apply IsUnit.mul
  · exact (xi_isUnit p).pow i
  · exact one_sub_xi_pow_isUnit p (j - i) (by omega) (by omega)

/-- **Stacks 03GF.** For every `d < p`, the element `Δ_d = ∏_{0 ≤ i < j < d}
(α_i - α_j)` is a unit in `R' = Z[1/p][x]/(Phi(x))`.

Δ_d is a double product of the differences `αᵢ - αⱼ`; each such difference (for
`i < j < d ≤ p-1`) is a unit by `alpha_sub_isUnit`, and a product of units is a
unit (`Finset.prod_induction` with `IsUnit.mul`, `isUnit_one`). -/
@[stacks 03GF]
theorem vandermondeProd_isUnit (d : ℕ) (hd : d < p) : IsUnit (vandermondeProd p d) := by
  unfold vandermondeProd
  simp only [IsUnit.prod_iff, Finset.mem_range]
  exact fun j hj i hi => alpha_sub_isUnit p i j hi (hj.trans hd)

end
