/-!
# Quasi-finite maps from affine space adapted to a prime

Let `R → S` be a ring map of finite type and let `𝔮 ⊂ S` be a prime lying over `𝔭 ⊂ R`, with
`dim_𝔮(S/R) = n` and `trdeg_{κ(𝔭)} κ(𝔮) = r`. This file proves Stacks 0520: there are
`f ∈ R`, `f ∉ 𝔭`, `g ∈ S`, `g ∉ 𝔮` and a quasi-finite ring map
`φ : R_f[x_1, …, x_n] → S_g` such that `φ⁻¹(𝔮S_g) = (𝔭, x_{r+1}, …, x_n)`.

The proof is the source's. After a principal localization of `S` there is a quasi-finite map
`ψ : R[t_1, …, t_n] → S_{g₀}` (Stacks 00QE). The prime `𝔮' = ψ⁻¹(𝔮S_{g₀})` lies over `𝔭`; it
corresponds to a prime `𝔮̄'` of `κ(𝔭)[t_1, …, t_n]`, whose residue field has transcendence
degree `r` over `κ(𝔭)`, since `κ(𝔮)` is finite over `κ(𝔮')`. Noether normalization adapted to
`𝔮̄'` (Stacks 051P) gives a finite map `κ(𝔭)[x_1, …, x_n] → κ(𝔭)[t_1, …, t_n]` pulling `𝔮̄'`
back to `(x_{r+1}, …, x_n)`. Lifting the images of the `x_i` to `R_f[t_1, …, t_n]` gives a
map `R_f[x_1, …, x_n] → R_f[t_1, …, t_n]` whose fibre over the prime below `𝔮'R_f[t]` is
finite, hence which is quasi-finite at `𝔮'R_f[t]`, hence quasi-finite after inverting some
`G ∉ 𝔮'R_f[t]` (Stacks 00QA). Composing with `ψ` and inverting the corresponding element of
`S` gives `φ`.

## Main results

* `MvPolynomial.comap_map_span_X_image`: for a ring map `ρ : A → B`, the preimage under
  `MvPolynomial.map ρ` of the ideal generated by a set of variables is generated by that set
  of variables together with the kernel of `ρ`.
* `Algebra.exists_quasiFinite_mvPolynomial_away_comap_map_eq`: Stacks 0520.

## Implementation notes

The source's `R_f[x_1, …, x_n]` is `MvPolynomial (Fin n) (Localization.Away f)`, with `x_{i+1}`
the variable indexed by `i : Fin n`, so that `(x_{r+1}, …, x_n)` is generated by the variables
indexed by `{i | r ≤ i}`. Quasi-finiteness of a ring map is `RingHom.QuasiFinite` together with
`RingHom.FiniteType`, which is the source's notion. The map `φ` is an `R`-algebra map, which
the statement records. The algebra `κ(𝔭) → κ(𝔮)` is any one compatible with `R`; there is
only one.

The source's claim that `R_f[t]` is quasi-finite over `R_f[x]` at `𝔮'R_f[t]` is proved by
showing directly that the fibre over the prime `P` below it is a finite `κ(P)`-module: a
finite set of polynomials over `R_f` whose images span `κ(𝔭)[t]` over `κ(𝔭)[x]` spans the
fibre, because every element of `κ(𝔭)` becomes the image of an element of `R_f` after
multiplication by an element of `R_f` that is a unit in `κ(P)`.

## References

* [StacksProject 0520](https://stacks.math.columbia.edu/tag/0520)
* [StacksProject 00QE](https://stacks.math.columbia.edu/tag/00QE)
* [StacksProject 051P](https://stacks.math.columbia.edu/tag/051P)
* [StacksProject 00QA](https://stacks.math.columbia.edu/tag/00QA)
-/

@[expose] public section

universe u v w x

open MvPolynomial

/-- For a ring map `ρ : A → B` and a set `s` of variables, the preimage under
`MvPolynomial.map ρ` of the ideal generated by the variables in `s` is generated by the kernel
of `ρ` and the variables in `s`. -/
theorem MvPolynomial.comap_map_span_X_image {σ A B : Type*} [CommRing A] [CommRing B]
    (ρ : A →+* B) (s : Set σ) :
    (Ideal.span (X '' s : Set (MvPolynomial σ B))).comap (map ρ) =
      Ideal.map C (RingHom.ker ρ) ⊔ Ideal.span (X '' s) := by
  classical
  apply le_antisymm
  · intro x hx
    rw [Ideal.mem_comap, mem_ideal_span_X_image] at hx
    let y : MvPolynomial σ A :=
      ∑ m ∈ x.support.filter (fun m => ∀ i ∈ s, m i = 0), monomial m (x.coeff m)
    have hy : ∀ m, y.coeff m = if (∀ i ∈ s, m i = 0) then x.coeff m else 0 := by
      intro m
      simp only [y, coeff_sum, coeff_monomial]
      rw [Finset.sum_ite_eq']
      by_cases hm : m ∈ x.support
      · simp [Finset.mem_filter, hm]
      · rw [mem_support_iff, not_not] at hm
        simp [hm]
    rw [← add_sub_cancel y x]
    refine Submodule.add_mem_sup ?_ ?_
    · rw [mem_map_C_iff]
      intro m
      rw [hy]
      split_ifs with h
      · rw [RingHom.mem_ker]
        by_contra hne
        obtain ⟨i, hi, hmi⟩ := hx m (by rwa [mem_support_iff, coeff_map])
        exact hmi (h i hi)
      · exact zero_mem _
    · rw [mem_ideal_span_X_image]
      intro m hm
      rw [mem_support_iff, coeff_sub, hy] at hm
      by_contra h
      push Not at h
      rw [ite_eq_left_of_eq_true _ _ (eq_true h), sub_self] at hm
      exact hm rfl
  · rw [sup_le_iff, Ideal.map_le_iff_le_comap]
    refine ⟨fun a ha => ?_, Ideal.span_le.mpr ?_⟩
    · simp [RingHom.mem_ker.mp ha]
    · rintro _ ⟨i, hi, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, map_X]
      exact Ideal.subset_span ⟨i, hi, rfl⟩

/-- If every element of the field `K` becomes an image under `ρ : A → K` after multiplication by
the image of some `b` with `ρ b ≠ 0`, then one `b` serves for any finite set of elements. -/
private lemma exists_mul_mem_range_finset {A K : Type*} [CommRing A] [Field K] (ρ : A →+* K)
    (hρ : ∀ c : K, ∃ b, ρ b ≠ 0 ∧ ρ b * c ∈ ρ.range) (s : Finset K) :
    ∃ b, ρ b ≠ 0 ∧ ∀ c ∈ s, ρ b * c ∈ ρ.range := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by simp, by simp⟩
  | insert c s _ ih =>
    obtain ⟨b, hb, h⟩ := ih
    obtain ⟨b', hb', ⟨a, ha⟩⟩ := hρ c
    refine ⟨b * b', by simp [hb, hb'], fun d hd => ?_⟩
    rcases Finset.mem_insert.mp hd with rfl | hd
    · exact ⟨b * a, by rw [map_mul, map_mul, ha]; ring⟩
    · obtain ⟨a', ha'⟩ := h d hd
      exact ⟨a' * b', by rw [map_mul, map_mul, ha']; ring⟩

/-- If `u` times each coefficient of a polynomial over `B` lies in the range of `ρ : A → B`, then
`C u * P` is the image of a polynomial over `A`. -/
private lemma exists_map_eq_C_mul {A B σ : Type*} [CommRing A] [CommRing B] (ρ : A →+* B) (u : B)
    (P : MvPolynomial σ B) (h : ∀ m, P.coeff m ≠ 0 → u * P.coeff m ∈ ρ.range) :
    ∃ Q : MvPolynomial σ A, map ρ Q = C u * P := by
  classical
  change C u * P ∈ Set.range (map ρ : MvPolynomial σ A →+* _)
  rw [mem_range_map_iff_coeffs_subset]
  intro c hc
  obtain ⟨m, -, rfl⟩ := mem_coeffs_iff.mp hc
  rw [coeff_C_mul]
  by_cases h0 : P.coeff m = 0
  · exact ⟨0, by simp [h0]⟩
  · exact h m h0

/-- Clearing denominators in polynomials: under the hypothesis of
`exists_mul_mem_range_finset`, finitely many polynomials over `K` all become images of
polynomials over `A` after multiplication by one constant `ρ b ≠ 0`. -/
private lemma exists_C_mul_mem_range_map {A K σ : Type*} [CommRing A] [Field K] (ρ : A →+* K)
    (hρ : ∀ c : K, ∃ b, ρ b ≠ 0 ∧ ρ b * c ∈ ρ.range) (s : Finset (MvPolynomial σ K)) :
    ∃ b, ρ b ≠ 0 ∧ ∀ P ∈ s, ∃ Q : MvPolynomial σ A, map ρ Q = C (ρ b) * P := by
  classical
  obtain ⟨b, hb, h⟩ := exists_mul_mem_range_finset ρ hρ (s.biUnion MvPolynomial.coeffs)
  exact ⟨b, hb, fun P hP => exists_map_eq_C_mul ρ _ P fun m hm =>
    h _ (Finset.mem_biUnion.mpr ⟨P, hP, coeff_mem_coeffs m hm⟩)⟩

open TensorProduct in
/-- Let `ρ : A → K` be a map to a field such that every element of `K` becomes an image after
multiplication by a nonzero image, let `A[σ] → A[τ]` be an `A`-algebra map lifting a finite
`K`-algebra map `φ : K[σ] → K[τ]`, and let `P` be a prime of `A[σ]` whose constants are exactly
`ker ρ`. Then the fibre `κ(P) ⊗_{A[σ]} A[τ]` is a finite `κ(P)`-module. -/
private lemma module_finite_fiber {A K σ τ : Type*} [CommRing A] [Field K] (ρ : A →+* K)
    (hρ : ∀ c : K, ∃ b, ρ b ≠ 0 ∧ ρ b * c ∈ ρ.range)
    [Algebra (MvPolynomial σ A) (MvPolynomial τ A)]
    [IsScalarTower A (MvPolynomial σ A) (MvPolynomial τ A)]
    (φ : MvPolynomial σ K →ₐ[K] MvPolynomial τ K) (hφ : φ.toRingHom.Finite)
    (hcomm : (map ρ).comp (algebraMap (MvPolynomial σ A) (MvPolynomial τ A)) =
      φ.toRingHom.comp (map ρ))
    (P : Ideal (MvPolynomial σ A)) [P.IsPrime] (hP : P.comap C = RingHom.ker ρ) :
    Module.Finite P.ResidueField (P.Fiber (MvPolynomial τ A)) := by
  classical
  obtain ⟨M, hM⟩ : ∃ M : Finset (MvPolynomial τ K),
      ∀ y, ∃ c : MvPolynomial τ K → MvPolynomial σ K, ∑ m ∈ M, φ (c m) * m = y := by
    let := φ.toRingHom.toAlgebra
    obtain ⟨M, hM⟩ := Module.finite_def.mp hφ
    refine ⟨M, fun y => ?_⟩
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp (hM ▸ Submodule.mem_top (x := y))
    exact ⟨c, hc⟩
  obtain ⟨b₀, hb₀, hℓ⟩ := exists_C_mul_mem_range_map ρ hρ M
  choose! ℓ hℓ using hℓ
  set κ := P.ResidueField
  set F := P.Fiber (MvPolynomial τ A)
  let ι : MvPolynomial τ A →ₐ[MvPolynomial σ A] F := Algebra.TensorProduct.includeRight
  have hres : ∀ u : A, algebraMap (MvPolynomial σ A) κ (C u) = 0 ↔ ρ u = 0 := by
    intro u
    rw [Ideal.algebraMap_residueField_eq_zero, ← RingHom.mem_ker, ← hP, Ideal.mem_comap]
  have hιC : ∀ u : A, ι (C u) = algebraMap κ F (algebraMap (MvPolynomial σ A) κ (C u)) := by
    intro u
    rw [← IsScalarTower.algebraMap_apply, ← AlgHom.commutes ι]
    exact congrArg ι (IsScalarTower.algebraMap_apply A (MvPolynomial σ A) (MvPolynomial τ A) u)
  have hker : ∀ z, map ρ z = 0 → ι z = 0 := by
    intro z hz
    have : Ideal.map C (RingHom.ker ρ) ≤ RingHom.ker ι.toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro u hu
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hιC,
        (hres u).mpr hu, map_zero]
    exact this (by rwa [← ker_map])
  set N : Submodule κ F := Submodule.span κ ((M.image (fun m => ι (ℓ m)) : Finset F) : Set F)
  have key : ∀ a, ι a ∈ N := by
    intro a
    obtain ⟨c, hc⟩ := hM (map ρ a)
    obtain ⟨b₁, hb₁, hd⟩ := exists_C_mul_mem_range_map ρ hρ (M.image c)
    choose! d hd using hd
    set z := C (b₀ * b₁) * a -
      ∑ m ∈ M, algebraMap (MvPolynomial σ A) (MvPolynomial τ A) (d (c m)) * ℓ m
    have hz : map ρ z = 0 := by
      have h1 : ∀ m ∈ M, map ρ (algebraMap (MvPolynomial σ A) (MvPolynomial τ A) (d (c m)) * ℓ m)
          = C (ρ b₀ * ρ b₁) * (φ (c m) * m) := by
        intro m hm
        rw [map_mul, ← RingHom.comp_apply, hcomm, RingHom.comp_apply,
          hd _ (Finset.mem_image_of_mem c hm), hℓ m hm]
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul]
        rw [show φ (C (ρ b₁)) = C (ρ b₁) from φ.commutes (ρ b₁)]
        ring
      rw [map_sub, map_sum, Finset.sum_congr rfl h1, ← Finset.mul_sum, hc, map_mul, map_C,
        map_mul, C_mul, sub_self]
    set u := algebraMap (MvPolynomial σ A) κ (C (b₀ * b₁))
    have hu : u ≠ 0 := by
      rw [Ne, hres, map_mul]
      exact mul_ne_zero hb₀ hb₁
    have h2 : u • ι a = ∑ m ∈ M, algebraMap (MvPolynomial σ A) κ (d (c m)) • ι (ℓ m) := by
      have hsplit : C (b₀ * b₁) * a = z +
          ∑ m ∈ M, algebraMap (MvPolynomial σ A) (MvPolynomial τ A) (d (c m)) * ℓ m := by
        simp only [z, sub_add_cancel]
      calc u • ι a = algebraMap κ F u * ι a := Algebra.smul_def u (ι a)
        _ = ι (C (b₀ * b₁) * a) := by rw [map_mul, hιC]
        _ = _ := by
          rw [hsplit, map_add, hker z hz, zero_add, map_sum]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [map_mul, AlgHom.commutes, IsScalarTower.algebraMap_apply (MvPolynomial σ A) κ F]
          exact (Algebra.smul_def _ _).symm
    rw [← inv_smul_smul₀ hu (ι a), h2]
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun m hm => Submodule.smul_mem _ _ ?_)
    exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hm))
  refine ⟨⟨M.image (fun m => ι (ℓ m)), eq_top_iff.mpr fun x _ => ?_⟩⟩
  induction x using TensorProduct.induction_on with
  | zero => exact zero_mem _
  | tmul c a =>
    rw [show c ⊗ₜ[MvPolynomial σ A] a = c • ι a by
      rw [show ι a = 1 ⊗ₜ a from rfl, TensorProduct.smul_tmul', smul_eq_mul, mul_one]]
    exact Submodule.smul_mem _ _ (key a)
  | add x y hx hy => exact add_mem (hx trivial) (hy trivial)

/-- If the fibre of `B → C` through a prime `q` of `C` is finite over the residue field of the
prime below `q`, then `C` is weakly quasi-finite over `B` at `q`. -/
private lemma weaklyQuasiFiniteAt_of_finite_fiber {B C : Type*} [CommRing B] [CommRing C]
    [Algebra B C] (q : Ideal C) [q.IsPrime]
    [Module.Finite (q.under B).ResidueField ((q.under B).Fiber C)] :
    Algebra.WeaklyQuasiFiniteAt B q := by
  set p := q.under B
  have : q.LiesOver p := ⟨rfl⟩
  let h : p.Fiber C →ₐ[B] q.ResidueField :=
    Algebra.TensorProduct.lift (Ideal.ResidueField.mapₐ p q (Algebra.ofId B C) rfl)
      (IsScalarTower.toAlgHom B C _) fun _ _ => .all _ _
  have : (RingHom.ker h.toRingHom).IsPrime := RingHom.ker_isPrime _
  have hQ : (RingHom.ker h.toRingHom).comap
      (Algebra.TensorProduct.includeRight (R := B) (A := p.ResidueField) (B := C)).toRingHom =
        q := by
    rw [RingHom.comap_ker]
    convert Ideal.ker_algebraMap_residueField q
    ext x
    simp [h]
  exact .of_quasiFiniteAt_residueField p q (RingHom.ker h.toRingHom) hQ

/-- Stacks 00QA in the form used here: a finite type algebra which is weakly quasi-finite at a
prime `q` becomes quasi-finite after inverting some element outside `q`. -/
private lemma exists_quasiFinite_localization_of_weaklyQuasiFiniteAt {B C : Type*} [CommRing B]
    [CommRing C] [Algebra B C] [Algebra.FiniteType B C] (q : Ideal C) [q.IsPrime]
    [Algebra.WeaklyQuasiFiniteAt B q] :
    ∃ r ∉ q, Algebra.QuasiFinite B (Localization.Away r) := by
  obtain ⟨S', hfg, r, hr, hbij⟩ :=
    Algebra.QuasiFiniteAt.exists_fg_and_exists_notMem_and_awayMap_bijective (R := B) q
  refine ⟨(r : C), hr, ?_⟩
  have : Module.Finite B S' := Module.Finite.iff_fg.mpr hfg
  exact (Algebra.QuasiFinite.iff_of_algEquiv
    (AlgEquiv.ofBijective (Localization.awayMapₐ S'.val r) hbij)).mp inferInstance

/-- The quasi-finiteness step of Stacks 0520: with the hypotheses of `module_finite_fiber` on
`Φ : A[σ] → A[τ]` at the prime below a prime `Q` of `A[τ]`, some `G ∉ Q` makes
`A[σ] → A[τ]_G` quasi-finite. -/
private lemma exists_notMem_quasiFinite_away {A K σ τ : Type*} [CommRing A] [Field K] [Finite τ]
    (ρ : A →+* K) (hρ : ∀ c : K, ∃ b, ρ b ≠ 0 ∧ ρ b * c ∈ ρ.range)
    (Φ : MvPolynomial σ A →ₐ[A] MvPolynomial τ A)
    (φ : MvPolynomial σ K →ₐ[K] MvPolynomial τ K) (hφ : φ.toRingHom.Finite)
    (hcomm : (map ρ).comp Φ.toRingHom = φ.toRingHom.comp (map ρ))
    (Q : Ideal (MvPolynomial τ A)) [Q.IsPrime]
    (hQ : (Q.comap Φ.toRingHom).comap C = RingHom.ker ρ) :
    ∃ G ∉ Q,
      ((algebraMap (MvPolynomial τ A) (Localization.Away G)).comp Φ.toRingHom).QuasiFinite := by
  let := Φ.toRingHom.toAlgebra
  have : IsScalarTower A (MvPolynomial σ A) (MvPolynomial τ A) :=
    IsScalarTower.of_algebraMap_eq fun a => (Φ.commutes a).symm
  have : Algebra.FiniteType (MvPolynomial σ A) (MvPolynomial τ A) :=
    Algebra.FiniteType.of_restrictScalars_finiteType A _ _
  have : Module.Finite (Q.under (MvPolynomial σ A)).ResidueField
      ((Q.under (MvPolynomial σ A)).Fiber (MvPolynomial τ A)) :=
    module_finite_fiber ρ hρ φ hφ hcomm _ hQ
  have := weaklyQuasiFiniteAt_of_finite_fiber (B := MvPolynomial σ A) Q
  obtain ⟨G, hG, hqf⟩ := exists_quasiFinite_localization_of_weaklyQuasiFiniteAt
    (B := MvPolynomial σ A) Q
  refine ⟨G, hG, ?_⟩
  rwa [← RingHom.quasiFinite_algebraMap,
    IsScalarTower.algebraMap_eq (MvPolynomial σ A) (MvPolynomial τ A) (Localization.Away G)] at hqf

/-- The relative dimension `dim_𝔮(S/R)` read at the point of `Spec (S ⊗_R κ(𝔭))` corresponding
to `𝔮`. -/
public theorem relativeDimensionAt_eq_of_fiber {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (𝔮 : Ideal S) [h𝔮 : 𝔮.IsPrime] :
    Algebra.relativeDimensionAt R 𝔮
      = _root_.relativeDimensionAt R S
          (PrimeSpectrum.comap (algebraMap R S) (⟨𝔮, h𝔮⟩ : PrimeSpectrum S)).asIdeal
          (PrimeSpectrum.preimageHomeomorphFiber R S _ ⟨⟨𝔮, h𝔮⟩, rfl⟩) := by
  rw [_root_.relativeDimensionAt, krullDimAt_eq_topologicalKrullDimAt,
    ← topologicalKrullDimAt_eq_of_homeomorph, Algebra.relativeDimensionAt]

/-- The point of `Spec (S ⊗_R κ(𝔭))` attached to a prime `𝔮` of `S` contracts to `𝔮`. -/
public theorem comap_fiberMap_preimageHomeomorphFiber {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (𝔮 : Ideal S) [h𝔮 : 𝔮.IsPrime] :
    PrimeSpectrum.comap
        (fiberMap R S (PrimeSpectrum.comap (algebraMap R S) (⟨𝔮, h𝔮⟩ : PrimeSpectrum S)).asIdeal)
        (PrimeSpectrum.preimageHomeomorphFiber R S _ ⟨⟨𝔮, h𝔮⟩, rfl⟩) = ⟨𝔮, h𝔮⟩ := by
  set 𝔭 : PrimeSpectrum R := PrimeSpectrum.comap (algebraMap R S) (⟨𝔮, h𝔮⟩ : PrimeSpectrum S)
  set e := PrimeSpectrum.preimageHomeomorphFiber R S 𝔭
  set x : ↥(PrimeSpectrum.comap (algebraMap R S) ⁻¹' {𝔭}) := ⟨⟨𝔮, h𝔮⟩, rfl⟩
  exact congrArg Subtype.val (e.symm_apply_apply x)

/-- Stacks 00QE at a prime `𝔮` of `S`: if `dim_𝔮(S/R) = n`, some principal localization `S_g`,
`g ∉ 𝔮`, is quasi-finite over `R[t_1, …, t_n]`. -/
public theorem exists_quasiFinite_mvPolynomial_away {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Algebra.FiniteType R S] (𝔮 : Ideal S) [𝔮.IsPrime] {n : ℕ}
    (hn : Algebra.relativeDimensionAt R 𝔮 = (n : WithBot ℕ∞)) :
    ∃ g ∉ 𝔮, ∃ ψ : MvPolynomial (Fin n) R →ₐ[R] Localization.Away g,
      ψ.toRingHom.QuasiFinite := by
  have hdim : _root_.relativeDimensionAt R S
      (PrimeSpectrum.comap (algebraMap R S) (⟨𝔮, ‹_›⟩ : PrimeSpectrum S)).asIdeal
      (PrimeSpectrum.preimageHomeomorphFiber R S _ ⟨⟨𝔮, ‹_›⟩, rfl⟩)
      = ((n : ℕ∞) : WithBot ℕ∞) := by
    rw [← relativeDimensionAt_eq_of_fiber, hn]
    norm_cast
  obtain ⟨g, hg, φ, hcomm, _, hqf⟩ :=
    quasiFinite_over_polynomial_of_relativeDimension R S ⟨𝔮, ‹_›⟩ _ _
      (comap_fiberMap_preimageHomeomorphFiber 𝔮) n hdim
  exact ⟨g, hg, AlgHom.mk φ (DFunLike.congr_fun hcomm), hqf⟩

/-- A nonzero constant does not lie in the ideal generated by a set of variables. -/
private lemma eq_zero_of_C_mem_span_X_image {σ K : Type*} [CommRing K] {s : Set σ} {c : K}
    (h : C c ∈ Ideal.span (X '' s : Set (MvPolynomial σ K))) : c = 0 := by
  classical
  by_contra hc
  rw [mem_ideal_span_X_image] at h
  obtain ⟨i, -, hi⟩ := h 0 (by simpa [mem_support_iff] using hc)
  exact hi rfl

/-- Every element of `κ(𝔭)` becomes the image of an element of `R` after multiplication by the
image of an element of `R` outside `𝔭`. -/
private lemma exists_algebraMap_mul_mem_range {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime]
    (c : p.ResidueField) :
    ∃ b, algebraMap R p.ResidueField b ≠ 0 ∧
      algebraMap R p.ResidueField b * c ∈ (algebraMap R p.ResidueField).range := by
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (R ⧸ p)) c
  obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨b', hb'⟩ := Ideal.Quotient.mk_surjective (b : R ⧸ p)
  have hb : algebraMap R p.ResidueField b' = algebraMap (R ⧸ p) p.ResidueField b := by
    rw [IsScalarTower.algebraMap_apply R (R ⧸ p) p.ResidueField, Ideal.Quotient.algebraMap_eq,
      hb']
  refine ⟨b', ?_, a', ?_⟩
  · rw [hb]
    exact IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
  · rw [hb, mul_comm, hab, IsScalarTower.algebraMap_apply R (R ⧸ p) p.ResidueField,
      Ideal.Quotient.algebraMap_eq]

/-- Let `T` be quasi-finite over `B`, let `Q` be a prime of `T`, and let
`θ : k[σ] → κ(Q)` be a `k`-algebra map from a polynomial ring over a field whose composite with a
ring map `B → k[σ]` is the canonical map `B → κ(Q)`. Then the residue field of the prime
`ker θ` has the same transcendence degree over `k` as `κ(Q)`: indeed `κ(Q)` is finite over
`κ(ker θ)`, because it is quasi-finite over `B`. -/
private lemma lift_trdeg_residueField_ker_eq {k : Type u} {B : Type w} {T : Type v}
    {σ : Type x} [Field k] [CommRing B] [CommRing T] [Algebra B T] [Algebra.QuasiFinite B T]
    (Q : Ideal T) [Q.IsPrime] [Algebra k Q.ResidueField]
    (θ : MvPolynomial σ k →ₐ[k] Q.ResidueField) (π : B →+* MvPolynomial σ k)
    (hθπ : θ.toRingHom.comp π = algebraMap B Q.ResidueField)
    (qbar : Ideal (MvPolynomial σ k)) [qbar.IsPrime] (hqbar : RingHom.ker θ.toRingHom = qbar) :
    Cardinal.lift.{v} (Algebra.trdeg k qbar.ResidueField) =
      Cardinal.lift.{max u x} (Algebra.trdeg k Q.ResidueField) := by
  set L := Q.ResidueField
  have hunit : qbar.primeCompl ≤ (IsUnit.submonoid L).comap θ.toRingHom := fun x hx =>
    isUnit_iff_ne_zero.mpr fun h => hx (hqbar ▸ RingHom.mem_ker.mpr h)
  let ι : qbar.ResidueField →+* L := Ideal.ResidueField.lift qbar θ.toRingHom hqbar.ge hunit
  let : Algebra qbar.ResidueField L := ι.toAlgebra
  have : IsScalarTower k qbar.ResidueField L := IsScalarTower.of_algebraMap_eq fun c => by
    change algebraMap k L c = ι (algebraMap k qbar.ResidueField c)
    rw [IsScalarTower.algebraMap_apply k (MvPolynomial σ k) qbar.ResidueField,
      Ideal.ResidueField.lift_algebraMap]
    exact (θ.commutes c).symm
  let : Algebra B qbar.ResidueField :=
    ((algebraMap (MvPolynomial σ k) qbar.ResidueField).comp π).toAlgebra
  have : IsScalarTower B qbar.ResidueField L := IsScalarTower.of_algebraMap_eq fun x => by
    change algebraMap B L x = ι (algebraMap (MvPolynomial σ k) qbar.ResidueField (π x))
    rw [Ideal.ResidueField.lift_algebraMap]
    exact (DFunLike.congr_fun hθπ x).symm
  have : Algebra.QuasiFinite qbar.ResidueField L := .of_restrictScalars B _ _
  have : Module.Finite qbar.ResidueField L := .of_quasiFinite
  have : FaithfulSMul k qbar.ResidueField :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (algebraMap k _).injective
  have : FaithfulSMul qbar.ResidueField L :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr ι.injective
  have hadd := lift_trdeg_add_eq k qbar.ResidueField L
  rwa [trdeg_eq_zero (R := qbar.ResidueField) (A := L), Cardinal.lift_zero, add_zero] at hadd

/-- **Stacks 0520.** Let `R → S` be a ring map of finite type and let `𝔮 ⊂ S` be a prime lying
over `𝔭 ⊂ R` with `dim_𝔮(S/R) = n` and `trdeg_{κ(𝔭)} κ(𝔮) = r`. Then there are `f ∈ R`,
`f ∉ 𝔭`, `g ∈ S`, `g ∉ 𝔮` and a quasi-finite `R`-algebra map `φ : R_f[x_1, …, x_n] → S_g`
with `φ⁻¹(𝔮S_g) = (𝔭, x_{r+1}, …, x_n)`. -/
@[stacks 0520 "`R_f[x_1, …, x_n]` is `MvPolynomial (Fin n) (Localization.Away f)`, with
`x_{i+1}` indexed by `i : Fin n`; the ideal `(𝔭, x_{r+1}, …, x_n)` is the sum of the extension of
`𝔭` along the constants and the ideal generated by the variables indexed by `{i | r ≤ i}`.
Quasi-finite is `RingHom.QuasiFinite` together with `RingHom.FiniteType`, and `φ` is recorded to
be an `R`-algebra map. The algebra `κ(𝔭) → κ(𝔮)` is any one compatible with `R`."]
theorem Algebra.exists_quasiFinite_mvPolynomial_away_comap_map_eq
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S]
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] [q.LiesOver p]
    [Algebra p.ResidueField q.ResidueField] [IsScalarTower R p.ResidueField q.ResidueField]
    {n r : ℕ} (hn : Algebra.relativeDimensionAt R q = n)
    (hr : Algebra.trdeg p.ResidueField q.ResidueField = r) :
    ∃ f ∉ p, ∃ g ∉ q, ∃ φ : MvPolynomial (Fin n) (Localization.Away f) →+* Localization.Away g,
      φ.comp (C.comp (algebraMap R (Localization.Away f))) =
        algebraMap R (Localization.Away g) ∧
      φ.FiniteType ∧ φ.QuasiFinite ∧
      (q.map (algebraMap S (Localization.Away g))).comap φ =
        Ideal.map C (p.map (algebraMap R (Localization.Away f))) ⊔
          Ideal.span (X '' {i : Fin n | r ≤ (i : ℕ)}) := by
  classical
  -- Step 1: a quasi-finite map `ψ : R[t] → S_{g₀}` (Stacks 00QE).
  obtain ⟨g₀, hg₀, ψ, hψ⟩ := exists_quasiFinite_mvPolynomial_away q hn
  set T := Localization.Away g₀
  have hpow : ∀ j, g₀ ^ j ∉ q := fun j h => hg₀ (Ideal.IsPrime.mem_of_pow_mem ‹_› j h)
  have hdisj : Disjoint (Submonoid.powers g₀ : Set S) q :=
    Set.disjoint_left.mpr fun _ ⟨j, hj⟩ => hj ▸ hpow j
  set Q₀ := q.map (algebraMap S T)
  have hQ₀ : Q₀.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g₀) T q ‹_› hdisj
  have hQ₀q : Q₀.comap (algebraMap S T) = q :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g₀) T ‹_› hdisj
  set k := p.ResidueField
  set L := Q₀.ResidueField
  set resT := algebraMap T L
  have hresT : ∀ x, resT x = 0 ↔ x ∈ Q₀ := fun x => Ideal.algebraMap_residueField_eq_zero
  set eSL : q.ResidueField →+* L := Ideal.ResidueField.map q Q₀ (algebraMap S T) hQ₀q.symm
  let : Algebra k L := (eSL.comp (algebraMap k q.ResidueField)).toAlgebra
  have hkL : ∀ a : R, algebraMap k L (algebraMap R k a) =
      resT (algebraMap S T (algebraMap R S a)) := by
    intro a
    change eSL (algebraMap k q.ResidueField (algebraMap R k a)) = _
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R S q.ResidueField,
      Ideal.ResidueField.map_algebraMap]
  have htrL : Algebra.trdeg k L = r := by
    let e : q.ResidueField ≃ₐ[k] L := AlgEquiv.ofBijective
      { eSL with commutes' := fun _ => rfl }
      (RingHom.SurjectiveOnStalks.residueFieldMap_bijective
        (RingHom.surjectiveOnStalks_of_isLocalization (Submonoid.powers g₀) T) q Q₀ hQ₀q.symm)
    rw [← e.trdeg_eq, hr]
  -- Step 2: the prime `𝔮̄'` of `κ(𝔭)[t]` corresponding to `𝔮' = ψ⁻¹(𝔮S_{g₀})`.
  let θ : MvPolynomial (Fin n) k →ₐ[k] L := aeval fun i => resT (ψ (X i))
  have hθπ : θ.toRingHom.comp (map (algebraMap R k)) = resT.comp ψ.toRingHom := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp only [θ, RingHom.comp_apply, map_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        aeval_C, hkL]
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, IsScalarTower.algebraMap_apply R S T]
    · simp [θ]
  set qbar := RingHom.ker θ.toRingHom
  have : qbar.IsPrime := RingHom.ker_isPrime _
  have hq' : Q₀.comap ψ.toRingHom = qbar.comap (map (algebraMap R k)) := by
    rw [RingHom.comap_ker, hθπ, ← RingHom.comap_ker, Ideal.ker_algebraMap_residueField]
  have htr : Algebra.trdeg k qbar.ResidueField = r := by
    let : Algebra (MvPolynomial (Fin n) R) T := ψ.toRingHom.toAlgebra
    have : Algebra.QuasiFinite (MvPolynomial (Fin n) R) T := hψ
    have hadd := lift_trdeg_residueField_ker_eq Q₀ θ (map (algebraMap R k))
      (hθπ.trans (IsScalarTower.algebraMap_eq _ T L).symm) qbar rfl
    rw [htrL, Cardinal.lift_natCast] at hadd
    exact Cardinal.lift_eq_nat_iff.mp hadd
  -- Step 3: Noether normalization adapted to `𝔮̄'` (Stacks 051P).
  obtain ⟨φb, hφb, hφbq⟩ := MvPolynomial.exists_finite_comap_eq_span_X_image_of_trdeg_eq qbar htr
  -- Step 4: lift the images of the variables to `R_f[t]`.
  obtain ⟨f, hf0, hH⟩ := exists_C_mul_mem_range_map (algebraMap R k)
    (exists_algebraMap_mul_mem_range p) (Finset.univ.image fun i => φb (X i))
  choose! H hH using hH
  have hfp : f ∉ p := fun h => hf0 (Ideal.algebraMap_residueField_eq_zero.mpr h)
  set A := Localization.Away f
  have hfu : IsUnit (algebraMap R k f) := isUnit_iff_ne_zero.mpr hf0
  let ρ : A →+* k := IsLocalization.Away.lift f hfu
  have hρR : ρ.comp (algebraMap R A) = algebraMap R k := IsLocalization.Away.lift_comp f hfu
  have hρR' : ∀ a, ρ (algebraMap R A a) = algebraMap R k a := IsLocalization.Away.lift_eq f hfu
  have hρ : ∀ c : k, ∃ b, ρ b ≠ 0 ∧ ρ b * c ∈ ρ.range := by
    intro c
    obtain ⟨b, hb, a, ha⟩ := exists_algebraMap_mul_mem_range p c
    exact ⟨algebraMap R A b, by rwa [hρR'], algebraMap R A a, by rw [hρR', hρR', ha]⟩
  let h : Fin n → MvPolynomial (Fin n) A := fun i =>
    C (IsLocalization.Away.invSelf f) * map (algebraMap R A) (H (φb (X i)))
  have hh : ∀ i, map ρ (h i) = φb (X i) := by
    intro i
    have hinv : ρ (IsLocalization.Away.invSelf f) * algebraMap R k f = 1 := by
      rw [← hρR', ← map_mul, mul_comm, IsLocalization.Away.mul_invSelf, map_one]
    simp only [h, map_mul, map_C, map_map, hρR]
    rw [hH _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)), ← mul_assoc, ← C_mul, hinv, C_1,
      one_mul]
  let Φ : MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin n) A := aeval h
  have hcomm : (map ρ).comp Φ.toRingHom = φb.toRingHom.comp (map ρ) := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_C]
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_eq, map_C,
        ← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_eq]
    · simp [Φ, hh]
  -- Step 5: the prime `𝔮'R_f[t]` and the prime below it.
  set 𝔔 := qbar.comap (map ρ : MvPolynomial (Fin n) A →+* _)
  have h𝔔 : 𝔔.IsPrime := Ideal.comap_isPrime _ _
  have h𝔔x : 𝔔.comap Φ.toRingHom =
      (Ideal.span (X '' {i : Fin n | r ≤ (i : ℕ)})).comap (map ρ) := by
    rw [Ideal.comap_comap, hcomm, ← Ideal.comap_comap]
    exact congrArg (Ideal.comap _) hφbq
  have hkerρ : RingHom.ker ρ = p.map (algebraMap R A) := by
    have : (RingHom.ker ρ).comap (algebraMap R A) = p := by
      rw [RingHom.comap_ker, hρR, Ideal.ker_algebraMap_residueField]
    exact (IsLocalization.map_under (Submonoid.powers f) A _).symm.trans (congrArg _ this)
  have hC : (𝔔.comap Φ.toRingHom).comap C = RingHom.ker ρ := by
    ext a
    rw [h𝔔x, Ideal.mem_comap, Ideal.mem_comap, map_C, RingHom.mem_ker]
    exact ⟨eq_zero_of_C_mem_span_X_image, fun h0 => by simp [h0]⟩
  -- Step 6: quasi-finiteness of `R_f[x] → R_f[t]_G` (Stacks 00QA).
  obtain ⟨G, hG, hGqf⟩ := exists_notMem_quasiFinite_away ρ hρ Φ φb hφb hcomm 𝔔 hC
  -- Step 7: clear the denominators of `G`, and find the element of `S` to invert.
  obtain ⟨⟨b, hb⟩, hbG⟩ := IsLocalization.exist_integer_multiples_of_finset (Submonoid.powers f)
    G.coeffs
  obtain ⟨G₀, hG₀⟩ := exists_map_eq_C_mul (algebraMap R A) (algebraMap R A b) G fun m hm => by
    obtain ⟨x, hx⟩ := hbG _ (coeff_mem_coeffs m hm)
    exact ⟨x, by rw [hx, Algebra.smul_def]⟩
  obtain ⟨⟨s, _, j, rfl⟩, hs⟩ := IsLocalization.surj (Submonoid.powers g₀) (ψ G₀)
  simp only at hs
  have hbk : algebraMap R k b ≠ 0 := by
    obtain ⟨m, rfl⟩ := hb
    rw [map_pow]
    exact pow_ne_zero _ hf0
  have hsq : s ∉ q := by
    intro hsq
    have h1 : ψ G₀ * algebraMap S T (g₀ ^ j) ∈ Q₀ := hs ▸ Ideal.mem_map_of_mem _ hsq
    have h2 : algebraMap S T (g₀ ^ j) ∉ Q₀ := by
      rw [← Ideal.mem_comap, hQ₀q]
      exact hpow j
    have h3 : G₀ ∈ Q₀.comap ψ.toRingHom := (hQ₀.mem_or_mem h1).resolve_right h2
    rw [hq', Ideal.mem_comap, ← hρR, ← map_map, hG₀] at h3
    change C (algebraMap R A b) * G ∈ 𝔔 at h3
    rcases h𝔔.mem_or_mem h3 with h4 | h4
    · rw [Ideal.mem_comap, map_C, RingHom.mem_ker, hρR'] at h4
      change θ (C _) = 0 at h4
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes] at h4
      exact hbk ((algebraMap k L).injective (h4.trans (map_zero _).symm))
    · exact hG h4
  set g := g₀ * (algebraMap R S f * s)
  have hgq : g ∉ q := by
    have hfq : algebraMap R S f ∉ q := by
      rwa [← Ideal.mem_comap, ← Ideal.under_def, ← q.over_def p]
    exact Ideal.IsPrime.mul_notMem ‹_› hg₀ (Ideal.IsPrime.mul_notMem ‹_› hfq hsq)
  set Sg := Localization.Away g
  have hgu : IsUnit (algebraMap S Sg g) := IsLocalization.Away.algebraMap_isUnit g
  rw [map_mul, map_mul, IsUnit.mul_iff, IsUnit.mul_iff] at hgu
  obtain ⟨hg₀u, hfS, hsu⟩ := hgu
  have hfu' : IsUnit (algebraMap R Sg f) := by rwa [IsScalarTower.algebraMap_apply R S Sg]
  -- Step 8: the map `φ`.
  let τ : T →+* Sg := IsLocalization.Away.lift g₀ hg₀u
  have hτ : τ.comp (algebraMap S T) = algebraMap S Sg := IsLocalization.Away.lift_comp g₀ hg₀u
  let α : A →+* Sg := IsLocalization.Away.lift f hfu'
  have hα : ∀ a, α (algebraMap R A a) = algebraMap R Sg a := IsLocalization.Away.lift_eq f hfu'
  let γ : MvPolynomial (Fin n) A →+* Sg := eval₂Hom α fun i => τ (ψ (X i))
  have hγψ : γ.comp (map (algebraMap R A)) = τ.comp ψ.toRingHom := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp only [γ, RingHom.comp_apply, map_C, eval₂Hom_C, hα, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe]
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, IsScalarTower.algebraMap_apply R S T,
        ← RingHom.comp_apply τ, hτ, ← IsScalarTower.algebraMap_apply]
    · simp [γ]
  have hRalg : (γ.comp Φ.toRingHom).comp (C.comp (algebraMap R A)) = algebraMap R Sg := by
    refine RingHom.ext fun a => ?_
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_eq]
    simp only [γ, eval₂Hom_C]
    exact hα a
  refine ⟨f, hfp, g, hgq, γ.comp Φ.toRingHom, hRalg, ?_, ?_, ?_⟩
  · -- finite type
    refine RingHom.FiniteType.of_comp_finiteType (f := C.comp (algebraMap R A)) ?_
    rw [hRalg, IsScalarTower.algebraMap_eq R S Sg]
    exact (RingHom.finiteType_holdsForLocalizationAway Sg g).comp
      (RingHom.finiteType_algebraMap.mpr ‹_›)
  · -- quasi-finite
    have hγG : IsUnit (γ G) := by
      have h1 : γ (map (algebraMap R A) G₀) = τ (ψ G₀) := DFunLike.congr_fun hγψ G₀
      have h2 : IsUnit (τ (ψ G₀)) := by
        have : τ (ψ G₀) * τ (algebraMap S T (g₀ ^ j)) = algebraMap S Sg s := by
          rw [← map_mul, hs, ← RingHom.comp_apply, hτ]
        exact isUnit_of_mul_isUnit_left (this ▸ hsu)
      rw [← h1, hG₀, map_mul] at h2
      exact isUnit_of_mul_isUnit_right h2
    let δ : Localization.Away G →+* Sg := IsLocalization.Away.lift G hγG
    have hδ : δ.comp (algebraMap (MvPolynomial (Fin n) A) (Localization.Away G)) = γ :=
      IsLocalization.Away.lift_comp G hγG
    have hτqf : τ.QuasiFinite := by
      refine RingHom.QuasiFinite.of_comp (g := algebraMap S T) ?_
      rw [hτ]
      exact RingHom.QuasiFinite.holdsForLocalizationAway Sg g
    have hδqf : δ.QuasiFinite := by
      refine RingHom.QuasiFinite.of_comp
        (g := (algebraMap (MvPolynomial (Fin n) A) (Localization.Away G)).comp
          (map (algebraMap R A))) ?_
      rw [← RingHom.comp_assoc, hδ, hγψ]
      exact hτqf.comp hψ
    rw [← hδ, RingHom.comp_assoc]
    exact hδqf.comp hGqf
  · -- the preimage of `𝔮S_g`
    have hχu : IsUnit (resT (algebraMap S T g)) := by
      rwa [isUnit_iff_ne_zero, Ne, hresT, ← Ideal.mem_comap, hQ₀q]
    let χ : Sg →+* L := IsLocalization.Away.lift (g := resT.comp (algebraMap S T)) g hχu
    have hχS : χ.comp (algebraMap S Sg) = resT.comp (algebraMap S T) :=
      IsLocalization.Away.lift_comp g hχu
    have hkerχ : RingHom.ker χ = q.map (algebraMap S Sg) := by
      have : (RingHom.ker χ).comap (algebraMap S Sg) = q := by
        rw [RingHom.comap_ker, hχS, ← RingHom.comap_ker, Ideal.ker_algebraMap_residueField, hQ₀q]
      exact (IsLocalization.map_under (Submonoid.powers g) Sg _).symm.trans (congrArg _ this)
    have hχτ : χ.comp τ = resT := IsLocalization.ringHom_ext (Submonoid.powers g₀)
      (by rw [RingHom.comp_assoc, hτ, hχS])
    have hχα : χ.comp α = (algebraMap k L).comp ρ := by
      refine IsLocalization.ringHom_ext (Submonoid.powers f) (RingHom.ext fun a => ?_)
      simp only [RingHom.comp_apply, hα, hρR']
      rw [hkL, IsScalarTower.algebraMap_apply R S Sg, ← RingHom.comp_apply χ, hχS,
        RingHom.comp_apply]
    have hχγ : χ.comp γ = θ.toRingHom.comp (map ρ) := by
      refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
      · simp only [RingHom.comp_apply, γ, eval₂Hom_C, map_C, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe]
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
        exact DFunLike.congr_fun hχα a
      · simp only [RingHom.comp_apply, γ, eval₂Hom_X', map_X, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, θ, aeval_X]
        exact DFunLike.congr_fun hχτ _
    rw [← hkerχ, RingHom.comap_ker, ← RingHom.comp_assoc, hχγ, RingHom.comp_assoc, hcomm,
      ← RingHom.comp_assoc, ← RingHom.comap_ker, ← RingHom.comap_ker]
    change (qbar.comap φb.toRingHom).comap (map ρ) = _
