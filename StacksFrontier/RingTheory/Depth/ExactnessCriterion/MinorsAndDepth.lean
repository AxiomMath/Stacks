/-!
# The Buchsbaum–Eisenbud exactness criterion: rank, minors and depth

Preliminaries for the Buchsbaum–Eisenbud exactness criterion
(`LinearMap.injective_and_exact_iff_forall_rank_eq_and_le_depth_minors`).

For a map `ψ : R^m → R^n` of finite free modules, the rank of `ψ` is the largest `r` such that
`⋀^r ψ ≠ 0`, and `I(ψ) ⊆ R` is the ideal generated by the `r × r` minors of the matrix of `ψ`.
This file identifies these with `Stacks.DeterminantalRank.exteriorRank` and
`Stacks.DeterminantalRank.detIdeal`, and with `StacksComplex.rank` and `StacksComplex.minorIdeal`,
and records how they behave under base change, in particular under localization at a prime. It
also collects the facts on depth used in the criterion: elements vanishing at every associated
prime, depth `≥ 1` along an ideal, and the passage from depth along `I` to depth along `I`
modulo a nonzerodivisor.

## References

* [StacksProject 00N1](https://stacks.math.columbia.edu/tag/00N1)
* D. A. Buchsbaum and D. Eisenbud, *What makes a complex exact?*, Corollary 1

## Tags

exact complex, finite free module, rank, minor, depth, regular sequence
-/

@[expose] public section

namespace Stacks.Depth.BuchsbaumEisenbud

open RingTheory.Sequence Stacks.DeterminantalRank

/-! ## Rank and `I(φ)` via exterior powers and minors -/

section Bridge

variable {R : Type*} [CommRing R] {m n : ℕ}

/-- A size `r` admits a nonzero `r × r` minor of `A` exactly when the `r`-th exterior power of
`A.mulVecLin` is nonzero. -/
private lemma mem_rankSet_iff_exteriorPower_map_ne_zero
    (A : Matrix (Fin n) (Fin m) R) (r : ℕ) :
    r ∈ StacksComplex.rankSet A ↔ exteriorPower.map r A.mulVecLin ≠ 0 := by
  rw [exteriorPower_map_ne_zero_iff_exists_minor]
  constructor
  · rintro ⟨rows, cols, h⟩
    exact ⟨_, ⟨rows, cols, rfl⟩, h⟩
  · rintro ⟨x, ⟨rows, cols, rfl⟩, h⟩
    exact ⟨rows, cols, h⟩

open Classical in
/-- `Stacks.DeterminantalRank.exteriorRank A` is the greatest `j` with `⋀^j (A.mulVecLin) ≠ 0`.
-/
private lemma isGreatest_exteriorPower_map_ne_zero [Nontrivial R]
    (A : Matrix (Fin n) (Fin m) R) :
    IsGreatest {j : ℕ | exteriorPower.map j A.mulVecLin ≠ 0} (exteriorRank A) := by
  refine ⟨Nat.findGreatest_spec (P := fun r => exteriorPower.map r A.mulVecLin ≠ 0)
      (m := 0) (Nat.zero_le _)
      ((mem_rankSet_iff_exteriorPower_map_ne_zero A 0).mp (StacksComplex.zero_mem_rankSet A)),
    fun r hr => ?_⟩
  have hr' : r ∈ StacksComplex.rankSet A :=
    (mem_rankSet_iff_exteriorPower_map_ne_zero A r).mpr hr
  exact Nat.le_findGreatest
    (le_min (StacksComplex.rankSet_le_m A hr') (StacksComplex.rankSet_le_n A hr')) hr

/-- The rank computed by exterior powers agrees with `StacksComplex.rank`, the supremum of the
sizes admitting a nonzero minor. -/
lemma exteriorRank_eq_rank [Nontrivial R] (A : Matrix (Fin n) (Fin m) R) :
    exteriorRank A = StacksComplex.rank A :=
  (isGreatest_exteriorPower_map_ne_zero A).unique
    ⟨(mem_rankSet_iff_exteriorPower_map_ne_zero A _).mp (StacksComplex.rank_mem_rankSet A),
      fun r hr => StacksComplex.le_rank A
        ((mem_rankSet_iff_exteriorPower_map_ne_zero A r).mpr hr)⟩

/-- `Stacks.DeterminantalRank.detIdeal A` is the span of the `exteriorRank A`-minors
`det (A.submatrix ρ γ)` over all `ρ` and `γ`. -/
private lemma detIdeal_eq_span_det_submatrix (A : Matrix (Fin n) (Fin m) R) :
    detIdeal A = Ideal.span {x : R | ∃ (ρ : Fin (exteriorRank A) → Fin n)
      (γ : Fin (exteriorRank A) → Fin m), (A.submatrix ρ γ).det = x} := by
  rw [detIdeal]
  congr 1
  ext x
  exact ⟨fun ⟨ρ, γ, h⟩ => ⟨ρ, γ, h.symm⟩, fun ⟨ρ, γ, h⟩ => ⟨ρ, γ, h.symm⟩⟩

/-- `Stacks.DeterminantalRank.detIdeal A` agrees with `StacksComplex.minorIdeal A`. -/
lemma detIdeal_eq_minorIdeal [Nontrivial R] (A : Matrix (Fin n) (Fin m) R) :
    detIdeal A = StacksComplex.minorIdeal A := by
  rw [detIdeal, StacksComplex.minorIdeal, exteriorRank_eq_rank]
  rfl

/-- The numerical conditions at one map, with an existentially quantified rank and an explicitly
spanned ideal of minors, say that the rank is `exteriorRank` and the ideal is `detIdeal`. -/
lemma exists_rank_iff [Nontrivial R]
    (f : (Fin m → R) →ₗ[R] (Fin n → R)) (s : ℤ) (c : ℕ∞) :
    (∃ r : ℕ, (r : ℤ) = s ∧ IsGreatest {j : ℕ | exteriorPower.map j f ≠ 0} r ∧
        c ≤ Module.depth R (Ideal.span {x : R | ∃ (ρ : Fin r → Fin n) (γ : Fin r → Fin m),
          ((LinearMap.toMatrix' f).submatrix ρ γ).det = x}) R) ↔
      ((exteriorRank (LinearMap.toMatrix' f) : ℤ) = s ∧
        c ≤ Module.depth R (detIdeal (LinearMap.toMatrix' f)) R) := by
  have hmv : (LinearMap.toMatrix' f).mulVecLin = f := Matrix.toLin'_toMatrix' f
  have hG := isGreatest_exteriorPower_map_ne_zero (LinearMap.toMatrix' f)
  rw [hmv] at hG
  constructor
  · rintro ⟨r, hs, hr, hd⟩
    obtain rfl : r = exteriorRank (LinearMap.toMatrix' f) := hr.unique hG
    exact ⟨hs, by rwa [detIdeal_eq_span_det_submatrix]⟩
  · rintro ⟨hs, hd⟩
    exact ⟨_, hs, hG, by rwa [← detIdeal_eq_span_det_submatrix]⟩

end Bridge

/-! ## Base change of the rank and of `I(φ)` -/

section BaseChange

variable {R S : Type*} [CommRing R] [Nontrivial R] [CommRing S] [Nontrivial S] {m n : ℕ}

omit [Nontrivial R] [Nontrivial S] in
/-- A minor of a base change is the base change of the minor: a ring map `f` carries
`det (A.submatrix ρ γ)` to `det ((A.map f).submatrix ρ γ)`. -/
lemma det_submatrix_map (f : R →+* S) (A : Matrix (Fin n) (Fin m) R) {r : ℕ}
    (ρ : Fin r → Fin n) (γ : Fin r → Fin m) :
    f (A.submatrix ρ γ).det = ((A.map f).submatrix ρ γ).det := by
  rw [Matrix.submatrix_map, RingHom.map_det, RingHom.mapMatrix_apply]

omit [Nontrivial R] in
/-- **The rank can only drop under base change.** A nonzero `r × r` minor of `A.map f` is the
image of an `r × r` minor of `A`, which is therefore nonzero as well. -/
lemma rank_map_le (f : R →+* S) (A : Matrix (Fin n) (Fin m) R) :
    StacksComplex.rank (A.map f) ≤ StacksComplex.rank A := by
  refine StacksComplex.rank_le _ fun r hr => StacksComplex.le_rank A ?_
  obtain ⟨ρ, γ, hne⟩ := hr
  exact ⟨ρ, γ, fun h => hne (by rw [← det_submatrix_map f A ρ γ, h, map_zero])⟩

omit [Nontrivial R] in
/-- **The rank drops under base change exactly when `I(φ)` dies.** The rank of `A.map f` is the
rank of `A` if and only if the ideal of minors of `A` does not map to zero. Both directions are
the same computation: `rank A ∈ rankSet (A.map f)` says that some minor of `A` of the top size
survives `f`, and those minors are exactly the generators of `I(φ)`. -/
private lemma rank_map_eq_iff_map_minorIdeal_ne_bot (f : R →+* S)
    (A : Matrix (Fin n) (Fin m) R) :
    StacksComplex.rank (A.map f) = StacksComplex.rank A ↔
      (StacksComplex.minorIdeal A).map f ≠ ⊥ := by
  constructor
  · intro h hbot
    obtain ⟨ρ, γ, hne⟩ := h ▸ StacksComplex.rank_mem_rankSet (A.map f)
    rw [StacksComplex.minorIdeal, Ideal.map_span, Ideal.span_eq_bot] at hbot
    exact hne (((det_submatrix_map f A ρ γ)).symm.trans (hbot _ ⟨_, ⟨ρ, γ, rfl⟩, rfl⟩))
  · intro h
    refine le_antisymm (rank_map_le f A) (StacksComplex.le_rank _ ?_)
    by_contra hc
    refine h ?_
    rw [StacksComplex.minorIdeal, Ideal.map_span, Ideal.span_eq_bot]
    rintro y ⟨z, ⟨ρ, γ, rfl⟩, rfl⟩
    by_contra hne
    exact hc ⟨ρ, γ, fun hz => hne (by rw [det_submatrix_map f A ρ γ, hz])⟩

omit [Nontrivial R] [Nontrivial S] in
/-- **`I(φ)` commutes with base change once the rank does not drop.** If `A` and `A.map f` have
the same rank then the minors generating `I(A.map f)` are the images of those generating `I(A)`,
so `I(A.map f)` is the image ideal `f(I(A))`. -/
lemma minorIdeal_map_of_rank_map_eq (f : R →+* S) (A : Matrix (Fin n) (Fin m) R)
    (h : StacksComplex.rank (A.map f) = StacksComplex.rank A) :
    StacksComplex.minorIdeal (A.map f) = (StacksComplex.minorIdeal A).map f := by
  rw [StacksComplex.minorIdeal, StacksComplex.minorIdeal, Ideal.map_span, h]
  congr 1
  ext x
  constructor
  · rintro ⟨ρ, γ, rfl⟩
    exact ⟨_, ⟨ρ, γ, rfl⟩, det_submatrix_map f A ρ γ⟩
  · rintro ⟨y, ⟨ρ, γ, rfl⟩, rfl⟩
    exact ⟨ρ, γ, det_submatrix_map f A ρ γ⟩

omit [Nontrivial R] in
/-- A nonzerodivisor stays nonzero in a localization at a prime: a relation `s · x = 0` with `x`
a nonzerodivisor forces `s = 0`, and `0` lies in every prime. -/
private lemma algebraMap_atPrime_ne_zero_of_mem_nonZeroDivisors (p : Ideal R) [p.IsPrime] {x : R}
    (hx : x ∈ nonZeroDivisors R) : algebraMap R (Localization.AtPrime p) x ≠ 0 := by
  intro h
  rw [IsLocalization.map_eq_zero_iff p.primeCompl] at h
  obtain ⟨s, hs⟩ := h
  exact s.2 (((mem_nonZeroDivisors_iff.mp hx).2 _ hs) ▸ p.zero_mem)

omit [Nontrivial R] in
/-- **Condition (2)(a) is inherited by localizations.** If `I(A)` contains a nonzerodivisor then
the rank of `A` over a localization `R_𝔭` is the rank of `A` over `R`: the nonzerodivisor
survives in `R_𝔭`, so `I(A)` does not map to zero there. -/
lemma rank_map_algebraMap_atPrime_eq (p : Ideal R) [p.IsPrime]
    (A : Matrix (Fin n) (Fin m) R) {x : R} (hx : x ∈ nonZeroDivisors R)
    (hxI : x ∈ StacksComplex.minorIdeal A) :
    StacksComplex.rank (A.map (algebraMap R (Localization.AtPrime p)))
      = StacksComplex.rank A := by
  refine (rank_map_eq_iff_map_minorIdeal_ne_bot _ A).mpr fun hbot => ?_
  refine algebraMap_atPrime_ne_zero_of_mem_nonZeroDivisors p hx ?_
  exact (Submodule.eq_bot_iff _).mp hbot _ (Ideal.mem_map_of_mem _ hxI)

omit [Nontrivial R] in
/-- **Condition (2)(b) is inherited by localizations**, at the level of the ideal: when `I(A)`
contains a nonzerodivisor, `I(A_𝔭) = I(A)_𝔭`. -/
lemma minorIdeal_map_algebraMap_atPrime (p : Ideal R) [p.IsPrime]
    (A : Matrix (Fin n) (Fin m) R) {x : R} (hx : x ∈ nonZeroDivisors R)
    (hxI : x ∈ StacksComplex.minorIdeal A) :
    StacksComplex.minorIdeal (A.map (algebraMap R (Localization.AtPrime p)))
      = (StacksComplex.minorIdeal A).map (algebraMap R (Localization.AtPrime p)) :=
  minorIdeal_map_of_rank_map_eq _ A (rank_map_algebraMap_atPrime_eq p A hx hxI)

end BaseChange

/-! ## Elements vanishing at every associated prime -/

section Ass

variable {R : Type*} [CommRing R] [IsNoetherianRing R]

/-- Over a Noetherian ring, an element killed by something outside each associated prime is
zero: this is the injectivity of `R → ⨁_{𝔮 ∈ Ass(R)} R_𝔮` (`zero_at_ass_zero`). -/
private lemma eq_zero_of_forall_associatedPrimes_exists_mul_eq_zero {x : R}
    (h : ∀ q ∈ associatedPrimes R R, ∃ s ∉ q, s * x = 0) : x = 0 := by
  refine zero_at_ass_zero R R (a₁ := x) (a₂ := 0) ?_
  rw [map_zero]
  funext p
  have := p.2.isPrime
  obtain ⟨s, hs, hsx⟩ := h p.1 p.2
  simp only [assMap, LinearMap.pi_apply, LocalizedModule.mkLinearMap_apply, Pi.zero_apply]
  rw [show (0 : LocalizedModule p.val.primeCompl R) = LocalizedModule.mk 0 1 from
    (LocalizedModule.zero_mk 1).symm, LocalizedModule.mk_eq]
  exact ⟨⟨s, hs⟩, by simpa [Submonoid.smul_def, smul_eq_mul] using hsx⟩

/-- Over a Noetherian ring, an element that dies in every localization at an associated prime is
zero. -/
lemma eq_zero_of_forall_algebraMap_atPrime_eq_zero {x : R}
    (h : ∀ q : Ideal R, ∀ hq : q ∈ associatedPrimes R R,
      haveI := hq.isPrime; algebraMap R (Localization.AtPrime q) x = 0) : x = 0 := by
  refine eq_zero_of_forall_associatedPrimes_exists_mul_eq_zero fun q hq => ?_
  have := hq.isPrime
  obtain ⟨s, hs⟩ :=
    (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q) x).mp (h q hq)
  exact ⟨s, s.2, hs⟩

end Ass


/-- **A localization at an associated prime has depth zero.** If `𝔮 ∈ Ass(R)` then the maximal
ideal of `R_𝔮` is an associated prime of `R_𝔮`. -/
lemma maximalIdeal_mem_associatedPrimes_atPrime {R : Type*} [CommRing R]
    {q : Ideal R} (hq : q ∈ associatedPrimes R R) :
    haveI := hq.isPrime
    IsLocalRing.maximalIdeal (Localization.AtPrime q)
      ∈ associatedPrimes (Localization.AtPrime q) (Localization.AtPrime q) := by
  have := hq.isPrime
  exact Module.associatedPrimes.mem_associatedPrimes_atPrime_of_mem_associatedPrimes hq

/-! ## Depth one along an ideal -/

section Depth

variable {R : Type*} [CommRing R]

/-- An element of a ring is a nonzerodivisor exactly when it acts regularly on the ring. -/
private lemma isSMulRegular_self_iff (f : R) :
    IsSMulRegular R f ↔ f ∈ nonZeroDivisors R := by
  rw [← isRegular_iff_mem_nonZeroDivisors]
  exact ⟨fun h => ⟨h, fun x y hxy => h (by simpa [mul_comm] using hxy)⟩,
    fun h x y hxy => h.left (by simpa using hxy)⟩

/-- A one-term sequence `[f]` is `R`-regular exactly when `f` is a nonzerodivisor generating a
proper ideal, the latter being the requirement `R/fR ≠ 0`. -/
private lemma isRegular_singleton_iff (f : R) :
    IsRegular R [f] ↔ (f ∈ nonZeroDivisors R ∧ Ideal.span {f} ≠ (⊤ : Ideal R)) := by
  rw [isRegular_iff, isWeaklyRegular_cons_iff, isSMulRegular_self_iff,
    show Ideal.ofList [f] = Ideal.span {f} from by simp [Ideal.ofList],
    Ideal.smul_top_eq_self, ne_comm]
  simp only [and_true, IsWeaklyRegular.nil R (QuotSMulTop f R)]

/-- The `I`-depth of `R` is at least `1` exactly when `I` is the unit ideal or contains a
nonzerodivisor. -/
lemma one_le_depth_self_iff (I : Ideal R) :
    1 ≤ Module.depth R I R ↔ (I = ⊤ ∨ ∃ f ∈ nonZeroDivisors R, f ∈ I) := by
  classical
  rw [Module.depth, Ideal.smul_top_eq_self]
  split_ifs with h
  · simp [h]
  · refine ⟨fun hd => Or.inr ?_, ?_⟩
    · by_contra hc
      push Not at hc
      have hzero : (⨆ rs ∈ {rs : List R | (∀ r ∈ rs, r ∈ I) ∧ IsRegular R rs},
          ((rs.length : ℕ) : ℕ∞)) ≤ 0 := by
        refine iSup₂_le ?_
        rintro (_ | ⟨f, t⟩) ⟨hmem, hreg⟩
        · simp
        · exact absurd (hmem f (by simp)) (hc f
            ((isSMulRegular_self_iff f).mp
              ((isWeaklyRegular_cons_iff R f t).mp ((isRegular_iff R _).mp hreg).1).1))
      exact absurd (hd.trans hzero) (by simp)
    · rintro (rfl | ⟨f, hf, hfI⟩)
      · exact absurd rfl h
      · have hreg : IsRegular R [f] := (isRegular_singleton_iff f).mpr
          ⟨hf, fun hc => h (top_le_iff.mp (hc ▸ Ideal.span_le.mpr (by simpa using hfI)))⟩
        calc (1 : ℕ∞) = ((([f] : List R).length : ℕ) : ℕ∞) := by simp
        _ ≤ _ := le_biSup (fun rs : List R => ((rs.length : ℕ) : ℕ∞))
              (show [f] ∈ {rs : List R | (∀ r ∈ rs, r ∈ I) ∧ IsRegular R rs} from
                ⟨by simpa using hfI, hreg⟩)

/-- Depth along the unit ideal is `∞`: the unit ideal already generates the whole module, so no
regular sequence is asked for. -/
lemma depth_top (M : Type*) [AddCommGroup M] [Module R M] :
    Module.depth R (⊤ : Ideal R) M = ⊤ := by
  rw [Module.depth, ite_eq_left_of_eq_true _ _ (eq_true (Submodule.top_smul _))]

/-- Depth is monotone in the ideal: a regular sequence in `I` is one in any larger ideal. -/
lemma depth_mono_ideal {I J : Ideal R} (hIJ : I ≤ J)
    (M : Type*) [AddCommGroup M] [Module R M] :
    Module.depth R I M ≤ Module.depth R J M := by
  classical
  rw [Module.depth, Module.depth]
  split_ifs with hI hJ hJ
  · exact le_rfl
  · exact absurd (top_le_iff.mp (hI.ge.trans (Submodule.smul_mono_left hIJ))) hJ
  · exact le_top
  · refine iSup₂_le fun rs hrs => ?_
    exact le_biSup (fun rs : List R => ((rs.length : ℕ) : ℕ∞))
      (show rs ∈ {rs : List R | (∀ r ∈ rs, r ∈ J) ∧ IsRegular M rs} from
        ⟨fun r hr => hIJ (hrs.1 r hr), hrs.2⟩)

/-- A module whose whole submodule is not produced by acting with `I` is nonzero. -/
private lemma nontrivial_of_smul_top_ne_top {I : Ideal R} {M : Type*} [AddCommGroup M]
    [Module R M] (hI : I • (⊤ : Submodule R M) ≠ ⊤) : Nontrivial M := by
  rcases subsingleton_or_nontrivial M with h | h
  · refine absurd ?_ hI
    have h1 : (⊤ : Submodule R M) = ⊥ :=
      Submodule.eq_bot_iff _ |>.mpr fun x _ => Subsingleton.elim x 0
    rw [h1, Submodule.smul_bot]
  · exact h

/-- The depth bound `c ≤ depth_I(M)` is witnessed: some `M`-regular sequence with all its terms
in `I` has length at least `c`. The supremum in `Module.depth` is over lengths of regular
sequences, so a finite lower bound for it is attained (if every such length were `< c`, the
supremum would be at most `c - 1`). -/
lemma exists_length_ge_of_le_depth {I : Ideal R} {M : Type*} [AddCommGroup M]
    [Module R M] (hI : I • (⊤ : Submodule R M) ≠ ⊤) {c : ℕ}
    (hc : (c : ℕ∞) ≤ Module.depth R I M) :
    ∃ rs : List R, (∀ r ∈ rs, r ∈ I) ∧ IsRegular M rs ∧ c ≤ rs.length := by
  classical
  have := nontrivial_of_smul_top_ne_top hI
  rw [Module.depth, ite_eq_right_of_eq_false _ _ (eq_false hI)] at hc
  by_contra hn
  push Not at hn
  have hc1 : 1 ≤ c := by
    rcases Nat.eq_zero_or_pos c with h | h
    · exact absurd (hn [] (by simp) (IsRegular.nil R M)) (by simp [h])
    · exact h
  have hle : (⨆ rs ∈ {rs : List R | (∀ r ∈ rs, r ∈ I) ∧ IsRegular M rs},
      ((rs.length : ℕ) : ℕ∞)) ≤ ((c - 1 : ℕ) : ℕ∞) := by
    refine iSup₂_le fun rs hrs => ?_
    exact Nat.cast_le.mpr (by have := hn rs hrs.1 hrs.2; omega)
  exact absurd (hc.trans hle) (not_le.mpr (Nat.cast_lt.mpr (show c - 1 < c by omega)))

/-- **Rees, easy half, along an ideal.** A nonzerodivisor `x ∈ I` prepended to an `R/xR`-regular
sequence with terms in `I` gives an `R`-regular sequence one longer with terms in `I`, so a
length-`c` regular sequence over `R/xR` produces the bound `c + 1 ≤ depth_I(R)`. -/
private lemma succ_le_depth_of_isRegular_quotSMulTop {I : Ideal R} {x : R} (hxI : x ∈ I)
    (hx : x ∈ nonZeroDivisors R) {rs : List R} (hrsI : ∀ r ∈ rs, r ∈ I)
    (hrs : IsRegular (QuotSMulTop x R) rs) :
    ((rs.length + 1 : ℕ) : ℕ∞) ≤ Module.depth R I R := by
  have hcons : IsRegular R (x :: rs) :=
    (isRegular_cons_iff R x rs).mpr ⟨(isSMulRegular_self_iff x).mpr hx, hrs⟩
  simpa [Nat.add_comm] using Module.le_depth_of_isRegular (I := I) (M := R)
    (List.forall_mem_cons.mpr ⟨hxI, hrsI⟩) hcons

/-- **Prime avoidance over the associated primes.** Over a Noetherian ring the associated primes
are finite in number and their union is the set of zerodivisors, so an ideal contained in none of
them contains a nonzerodivisor. -/
lemma exists_mem_nonZeroDivisors_of_forall_not_le [IsNoetherianRing R] {I : Ideal R}
    (h : ∀ q ∈ associatedPrimes R R, ¬ I ≤ q) : ∃ x ∈ I, x ∈ nonZeroDivisors R := by
  classical
  have hfin : (associatedPrimes R R).Finite := associatedPrimes.finite R R
  by_contra hc
  push Not at hc
  have hsub : (I : Set R) ⊆ ⋃ p ∈ (hfin.toFinset : Finset (Ideal R)), (p : Set R) := by
    have hbu : (I : Set R) ⊆ ⋃ p ∈ associatedPrimes R R, (p : Set R) := by
      rw [biUnion_associatedPrimes_eq_compl_nonZeroDivisors]
      exact fun x hx => hc x hx
    simpa using hbu
  obtain ⟨p, hp, hle⟩ := (Ideal.subset_union_prime (s := hfin.toFinset) (f := id)
      (a := ⊥) (b := ⊥)
      (fun i hi _ _ => (hfin.mem_toFinset.mp hi).isPrime)).mp (by simpa using hsub)
  exact h p (hfin.mem_toFinset.mp hp) hle

/-- Condition (2)(b) at `i = 1` from the geometric statement that `I` lies in no associated prime
of `R`. -/
lemma one_le_depth_of_forall_not_le_associatedPrimes [IsNoetherianRing R] {I : Ideal R}
    (h : ∀ q ∈ associatedPrimes R R, ¬ I ≤ q) : 1 ≤ Module.depth R I R := by
  obtain ⟨x, hxI, hx⟩ := exists_mem_nonZeroDivisors_of_forall_not_le h
  exact (one_le_depth_self_iff I).mpr (Or.inr ⟨x, hx, hxI⟩)

/-- Finitely many ideals, none of them contained in a prime `q`, have an intersection that is not
contained in `q` either: a product of elements chosen outside `q`, one from each ideal, lies in the
intersection, and `q` being prime it lies outside `q`. -/
@[ega "0 1.7.4" "partial"]
lemma iInf_not_le_of_forall_not_le {N : ℕ} (I : Fin N → Ideal R) (q : Ideal R)
    [q.IsPrime] (h : ∀ k, ¬ I k ≤ q) : ¬ (⨅ k, I k) ≤ q := by
  choose a ha hna using fun k => SetLike.not_le_iff_exists.mp (h k)
  intro hle
  have hmem : ∏ k, a k ∈ ⨅ k, I k := by
    refine (Submodule.mem_iInf _).mpr fun k => ?_
    obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem a (Finset.mem_univ k)
    rw [hc]
    exact Ideal.mul_mem_right _ _ (ha k)
  obtain ⟨k, -, hk⟩ := (Ideal.IsPrime.prod_mem_iff (p := q)).mp (hle hmem)
  exact hna k hk

open scoped Pointwise in
/-- The submodule `x • ⊤` of `R` is the ideal `xR`; so `QuotSMulTop x R` is `R ⧸ xR`. -/
private lemma smul_top_eq_span_singleton (x : R) :
    (x • (⊤ : Submodule R R) : Submodule R R) = Ideal.span {x} := by
  ext y
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Ideal.mem_span_singleton', smul_eq_mul]
  exact ⟨fun ⟨a, ha⟩ => ⟨a, by rw [← ha, mul_comm]⟩, fun ⟨a, ha⟩ => ⟨a, by rw [← ha, mul_comm]⟩⟩

/-- Weak regularity of a sequence transfers along a linear equivalence. -/
private lemma isWeaklyRegular_of_linearEquiv {M M' : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup M'] [Module R M'] (e : M ≃ₗ[R] M') (rs : List R)
    (h : IsWeaklyRegular M rs) : IsWeaklyRegular M' rs :=
  (AddEquiv.isWeaklyRegular_congr (e := e.toAddEquiv)
    (List.forall₂_same.mpr fun r _ y => e.map_smul r y)).mp h

/-- An ideal containing `x` and not the whole ring stays proper modulo `x`. -/
lemma map_mk_ne_top {I : Ideal R} {x : R} (hxI : x ∈ I) (hI : I ≠ ⊤) :
    I.map (Ideal.Quotient.mk (Ideal.span {x})) ≠ ⊤ := by
  intro htop
  obtain ⟨y, hyI, hy⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp
    (show (1 : R ⧸ Ideal.span {x}) ∈ I.map (Ideal.Quotient.mk (Ideal.span {x})) from
      htop ▸ Submodule.mem_top)
  have h1 : y - 1 ∈ Ideal.span {x} := Ideal.Quotient.eq.mp (by rw [hy, map_one])
  have h2 : y - 1 ∈ I := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxI) h1
  exact hI ((Ideal.eq_top_iff_one I).mpr (by simpa using I.sub_mem hyI h2))

/-- **Rees, easy half, along an ideal, from the quotient by a nonzerodivisor.** If `x ∈ I` is a
nonzerodivisor and `I` is a proper ideal, an `R/xR`-regular sequence of length `c` with all terms
in the image of `I` lifts to an `R`-regular sequence of length `c + 1` with all terms in `I`,
whence `c + 1 ≤ depth_I(R)`. -/
lemma succ_le_depth_of_isRegular_quotient [IsNoetherianRing R] [IsLocalRing R]
    {I : Ideal R} {x : R} (hxI : x ∈ I) (hx : x ∈ nonZeroDivisors R) (hI : I ≠ ⊤)
    {rs : List (R ⧸ Ideal.span {x})}
    (hrsI : ∀ r ∈ rs, r ∈ I.map (Ideal.Quotient.mk (Ideal.span {x})))
    (hrs : IsRegular (R ⧸ Ideal.span {x}) rs) :
    ((rs.length + 1 : ℕ) : ℕ∞) ≤ Module.depth R I R := by
  classical
  have hIm : I ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal hI
  have key : ∀ r : R ⧸ Ideal.span {x}, ∃ y : R,
      r ∈ I.map (Ideal.Quotient.mk (Ideal.span {x})) →
        y ∈ I ∧ Ideal.Quotient.mk (Ideal.span {x}) y = r := by
    intro r
    by_cases hr : r ∈ I.map (Ideal.Quotient.mk (Ideal.span {x}))
    · obtain ⟨y, hyI, hy⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hr
      exact ⟨y, fun _ => ⟨hyI, hy⟩⟩
    · exact ⟨0, fun h => absurd h hr⟩
  choose g hg using key
  have hgmap : (rs.map g).map (Ideal.Quotient.mk (Ideal.span {x})) = rs := by
    rw [List.map_map]
    exact (List.map_congr_left fun r hr => (hg r (hrsI r hr)).2).trans (List.map_id rs)
  have hmem : ∀ r ∈ (x :: rs.map g), r ∈ I :=
    List.forall_mem_cons.mpr ⟨hxI, List.forall_mem_map.mpr fun r hr => (hg r (hrsI r hr)).1⟩
  have hw : IsWeaklyRegular R (x :: rs.map g) := by
    refine (isWeaklyRegular_cons_iff R x (rs.map g)).mpr
      ⟨(isSMulRegular_self_iff x).mpr hx, ?_⟩
    refine isWeaklyRegular_of_linearEquiv
      (Submodule.quotEquivOfEq _ _ (smul_top_eq_span_singleton x).symm) _ ?_
    refine (isWeaklyRegular_map_algebraMap_iff (S := R ⧸ Ideal.span {x})
      (M := R ⧸ Ideal.span {x}) (rs := rs.map g)).mp ?_
    rw [show (algebraMap R (R ⧸ Ideal.span {x}) : R → R ⧸ Ideal.span {x})
      = Ideal.Quotient.mk (Ideal.span {x}) from rfl, hgmap]
    exact hrs.toIsWeaklyRegular
  have hreg : IsRegular R (x :: rs.map g) :=
    IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal
      (mem := fun r hr => hIm (hmem r hr)) (reg := hw)
  simpa using Module.le_depth_of_isRegular (I := I) (M := R) hmem hreg

