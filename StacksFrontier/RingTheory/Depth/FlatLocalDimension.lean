module

public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.KrullDimension.Module
public import StacksFrontier.RingTheory.CohenMacaulay.Defs
public import StacksFrontier.RingTheory.Depth.Dimension
public import StacksFrontier.RingTheory.Depth.FlatLocalHom
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Dimension along a flat local homomorphism, and descent of Cohen--Macaulayness

Let `R → S` be a flat local homomorphism of Noetherian local rings and let
`F = S/𝔪_R S` be its closed fibre. Then

* `dim(S) = dim(R) + dim(F)`, the dimension formula for a flat local map; and
* if `𝔪_R S = 𝔪_S`, so that the closed fibre is the residue field, `dim(R) = dim(S)`.

Combining the first with the additivity of depth along a flat local homomorphism gives that
Cohen--Macaulayness descends: if `S` is Cohen--Macaulay, then so is `R`.

## Main results

* `ringKrullDim_eq_add_ringKrullDim_closedFibre_of_flat`: the dimension formula.
* `ringKrullDim_eq_of_flat_of_map_maximalIdeal_eq`: the dimension is unchanged when the closed
  fibre is the residue field.
* `isMaximalCohenMacaulay_self_of_flat_local`: Cohen--Macaulayness descends along a flat local
  homomorphism.

## Implementation notes

The dimension formula is the height formula
`Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown` (Stacks 00ON) at the maximal ideal,
going down being available because the map is flat; the only work is identifying the height of
the image of `𝔪_S` in the fibre with the dimension of the fibre, for which the fibre has to be
recognised as a local ring. Depth additivity is
`Module.depth_self_eq_depth_self_add_depth_quotient_map_maximalIdeal` (Stacks 0337). Both sides of
the descent argument are compared in `ℕ∞` rather than in `WithBot ℕ∞`, through the height of the
maximal ideal, so that no `⊥` can appear and the cancellation is an inequality of natural numbers.

## References

* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON)
* [Stacks Project, Tag 0337](https://stacks.math.columbia.edu/tag/0337)
-/

@[expose] public section

open IsLocalRing

namespace Stacks.FlatLocalDimension

variable (R S : Type*) [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [Algebra R S]
  [IsLocalHom (algebraMap R S)]

/-- The ideal of `S` generated by the maximal ideal of `R`. -/
abbrev closedFibreIdeal : Ideal S := (maximalIdeal R).map (algebraMap R S)

variable {R S}

/-- The maximal ideal of the source generates an ideal inside the maximal ideal of the target. -/
lemma closedFibreIdeal_le_maximalIdeal : closedFibreIdeal R S ≤ maximalIdeal S := by
  rw [Ideal.map_le_iff_le_comap, maximalIdeal_comap (algebraMap R S)]

/-- The closed fibre of a local homomorphism of local rings is a nontrivial ring. -/
instance : Nontrivial (S ⧸ closedFibreIdeal R S) :=
  Ideal.Quotient.nontrivial_iff.mpr fun h =>
    (maximalIdeal.isMaximal S).ne_top
      (top_le_iff.mp (h ▸ closedFibreIdeal_le_maximalIdeal (R := R) (S := S)))

/-- The closed fibre of a local homomorphism of local rings is a local ring. -/
instance : IsLocalRing (S ⧸ closedFibreIdeal R S) :=
  IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective

/-- The closed fibre is a local ring, with maximal ideal the image of the maximal ideal of the
target. -/
lemma maximalIdeal_quotient_closedFibreIdeal :
    (maximalIdeal S).map (Ideal.Quotient.mk (closedFibreIdeal R S)) =
      maximalIdeal (S ⧸ closedFibreIdeal R S) :=
  IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective

/-- **The height formula at the maximal ideal of a flat local homomorphism.** -/
@[ega "IV 6.1.2"]
lemma height_maximalIdeal_eq_add [IsNoetherianRing R] [IsNoetherianRing S] [Module.Flat R S] :
    (maximalIdeal S).height =
      (maximalIdeal R).height + (maximalIdeal (S ⧸ closedFibreIdeal R S)).height := by
  have : Algebra.HasGoingDown R S := Algebra.HasGoingDown.of_flat
  have : (maximalIdeal S).LiesOver (maximalIdeal R) :=
    ⟨(maximalIdeal_comap (algebraMap R S)).symm⟩
  rw [Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal R) (maximalIdeal S),
    maximalIdeal_quotient_closedFibreIdeal]

/-- **The dimension formula for a flat local homomorphism.** The dimension of the target is the
dimension of the source plus the dimension of the closed fibre. -/
@[ega "IV 6.1.2"]
theorem ringKrullDim_eq_add_ringKrullDim_closedFibre_of_flat [IsNoetherianRing R]
    [IsNoetherianRing S] [Module.Flat R S] :
    ringKrullDim S = ringKrullDim R + ringKrullDim (S ⧸ closedFibreIdeal R S) := by
  have h := height_maximalIdeal_eq_add (R := R) (S := S)
  rw [← maximalIdeal_height_eq_ringKrullDim (R := R),
    ← maximalIdeal_height_eq_ringKrullDim (R := S),
    ← maximalIdeal_height_eq_ringKrullDim (R := S ⧸ closedFibreIdeal R S)]
  exact_mod_cast h

/-- A flat local homomorphism whose closed fibre is the residue field of the target does not
change the Krull dimension. -/
@[ega "IV 5.5.1" "special case"]
theorem ringKrullDim_eq_of_flat_of_map_maximalIdeal_eq [IsNoetherianRing R] [IsNoetherianRing S]
    [Module.Flat R S] (hm : closedFibreIdeal R S = maximalIdeal S) :
    ringKrullDim R = ringKrullDim S := by
  have h := height_maximalIdeal_eq_add (R := R) (S := S)
  have hzero : (maximalIdeal (S ⧸ closedFibreIdeal R S)).height = 0 := by
    have hbot : maximalIdeal (S ⧸ closedFibreIdeal R S) = ⊥ := by
      rw [← maximalIdeal_quotient_closedFibreIdeal (R := R) (S := S), hm]
      exact (Ideal.map_eq_bot_iff_le_ker _).mpr (by simp)
    rw [hbot]
    simp
  rw [hzero, add_zero] at h
  rw [← maximalIdeal_height_eq_ringKrullDim (R := R),
    ← maximalIdeal_height_eq_ringKrullDim (R := S)]
  exact_mod_cast h.symm

/-- The maximal ideal of the target does not annihilate the closed fibre. -/
lemma smul_top_closedFibre_ne_top :
    maximalIdeal S • (⊤ : Submodule S (S ⧸ closedFibreIdeal R S)) ≠ ⊤ := by
  intro heq
  have hmaxmap : (maximalIdeal S).map (Ideal.Quotient.mk (closedFibreIdeal R S)) ≠ ⊤ := by
    rw [maximalIdeal_quotient_closedFibreIdeal]
    exact (maximalIdeal.isMaximal _).ne_top
  apply hmaxmap
  have hmaptop : Submodule.restrictScalars S
      ((maximalIdeal S).map (Ideal.Quotient.mk (closedFibreIdeal R S))) = ⊤ := by
    simpa [Ideal.smul_top_eq_map] using heq
  simpa using hmaptop

/-- A Noetherian local ring has finite Krull dimension, so its maximal ideal has finite height. -/
lemma height_maximalIdeal_ne_top (T : Type*) [CommRing T] [IsNoetherianRing T] [IsLocalRing T] :
    (maximalIdeal T).height ≠ ⊤ := by
  intro h
  have := ringKrullDim_lt_top (R := T)
  rw [← maximalIdeal_height_eq_ringKrullDim, h] at this
  simp at this

/-- For a Noetherian local ring, a natural number `d` is the dimension iff it is the height of
the maximal ideal. -/
private theorem coe_eq_ringKrullDim_iff {T : Type*} [CommRing T] [IsLocalRing T] {d : ℕ∞} :
    (d : WithBot ℕ∞) = ringKrullDim T ↔ d = (maximalIdeal T).height := by
  rw [← maximalIdeal_height_eq_ringKrullDim]
  exact WithBot.coe_inj

/-- For a local ring, `d ≤ dim` iff `d` is at most the height of the maximal ideal. -/
private theorem coe_le_ringKrullDim_iff {T : Type*} [CommRing T] [IsLocalRing T] {d : ℕ∞} :
    (d : WithBot ℕ∞) ≤ ringKrullDim T ↔ d ≤ (maximalIdeal T).height := by
  rw [← maximalIdeal_height_eq_ringKrullDim]
  exact WithBot.coe_le_coe

/-- **Cohen--Macaulayness descends along a flat local homomorphism.** If `R → S` is a flat local
homomorphism of Noetherian local rings and `S` is Cohen--Macaulay, then so is `R`.

Depth and dimension are both additive in the closed fibre, depth is at most dimension for `R` and
for the fibre, and the two sums agree because `S` is Cohen--Macaulay; so both inequalities are
equalities. -/
theorem isMaximalCohenMacaulay_self_of_flat_local [IsNoetherianRing R] [IsNoetherianRing S]
    [Module.Flat R S] (hS : Module.IsMaximalCohenMacaulay S S) :
    Module.IsMaximalCohenMacaulay R R := by
  have hh := height_maximalIdeal_eq_add (R := R) (S := S)
  have h0337 := Module.depth_self_eq_depth_self_add_depth_quotient_map_maximalIdeal R S
  have hSdepth : Module.depth S (maximalIdeal S) S = (maximalIdeal S).height :=
    coe_eq_ringKrullDim_iff.mp hS
  have hdR : Module.depth R (maximalIdeal R) R ≤ (maximalIdeal R).height := by
    have h := Module.depth_le_supportDim R (maximalIdeal R) R
      (by simpa using (maximalIdeal.isMaximal R).ne_top)
    rw [Module.supportDim_self_eq_ringKrullDim] at h
    exact coe_le_ringKrullDim_iff.mp h
  have hdF : Module.depth S (maximalIdeal S) (S ⧸ closedFibreIdeal R S) ≤
      (maximalIdeal (S ⧸ closedFibreIdeal R S)).height := by
    have h := Module.depth_le_supportDim S (maximalIdeal S) (S ⧸ closedFibreIdeal R S)
      smul_top_closedFibre_ne_top
    rw [Module.supportDim_quotient_eq_ringKrullDim] at h
    exact coe_le_ringKrullDim_iff.mp h
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp (height_maximalIdeal_ne_top R)
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp
    (height_maximalIdeal_ne_top (S ⧸ closedFibreIdeal R S))
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp
    (ne_top_of_le_ne_top (ha ▸ ENat.natCast_ne_top a) hdR)
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp
    (ne_top_of_le_ne_top (hb ▸ ENat.natCast_ne_top b) hdF)
  rw [hSdepth, hh, ← ha, ← hb, ← hm, ← hn] at h0337
  have hsum : a + b = m + n := by exact_mod_cast h0337
  have hma : m ≤ a := by rw [← ha, ← hm] at hdR; exact_mod_cast hdR
  have hnb : n ≤ b := by rw [← hb, ← hn] at hdF; exact_mod_cast hdF
  have hfinal : Module.depth R (maximalIdeal R) R = (maximalIdeal R).height := by
    rw [← ha, ← hm]
    exact congrArg _ (by omega)
  exact coe_eq_ringKrullDim_iff.mpr hfinal

end Stacks.FlatLocalDimension

end
