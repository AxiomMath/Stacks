module

public import StacksFrontier.RingTheory.Flat.LocalCriteria
public import StacksFrontier.RingTheory.Flat.FibreCriterionNilpotent
public import StacksFrontier.AlgebraicGeometry.Flatness.FinitelyPresented.FreeMapSpreadingOut
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem

@[expose] public section

/-!
# Flatness from regular sequences, locally

Let `R` be a local ring whose maximal ideal is generated by an `R`-regular sequence `x₁, …, x_d`
and let `M` be an `R`-module on which `x₁, …, x_d` is a weakly regular sequence. If `M_Q` is flat
for every prime `Q ≠ 𝔪`, then `M` is flat. This is an induction on `d` using Stacks 0H7N for the
element `x₁`: the localization `M_{x₁}` is flat because flatness is local and every prime not
containing `x₁` differs from `𝔪`, and `M/x₁M` is flat over `R/x₁R` by induction, the hypotheses
passing to the quotient because `(M/x₁M)_Q` is the reduction of the flat module `M_Q`.

Globally: if `A` is a Noetherian ring and `M` an `A`-module such that at every prime `Q` the
maximal ideal of `A_Q` is generated by an `A_Q`-regular sequence which is weakly regular on `M_Q`,
then `M` is flat, by induction on the height of `Q`. Over a regular ring the regular systems of
parameters are such sequences, so this says that a module on which a regular system of parameters
of every local ring is a regular sequence is flat.

## Main results

* `Module.flat_localizedModule_powers_of_flat_localizedModule`: if `M_Q` is flat for every prime
  `Q` not containing `x`, then `M_x` is flat over `R_x`.
* `Module.flat_localizedModule_quotSMulTop`: flatness of `M_Q` passes to `(M/xM)_{Q/x}`.
* `Module.flat_of_isWeaklyRegular_of_flat_localizedModule`: the local criterion.
* `Module.flat_of_forall_isWeaklyRegular_localization`: the global criterion.
-/

open IsLocalRing RingTheory.Sequence

open scoped Pointwise

universe u v

namespace Module

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-- If the localization `M_Q` is flat over `R` for every prime `Q` not containing `x`, then the
localization `M_x` is flat over `R_x`. -/
theorem flat_localizedModule_powers_of_flat_localizedModule (x : R)
    (hloc : ∀ (Q : Ideal R) [Q.IsPrime], x ∉ Q → Module.Flat R (LocalizedModule Q.primeCompl M)) :
    Module.Flat (Localization.Away x) (LocalizedModule (Submonoid.powers x) M) := by
  set S := Localization.Away x
  set Mx := LocalizedModule (Submonoid.powers x) M
  rw [Module.flat_iff_of_isLocalization S (Submonoid.powers x) Mx]
  refine Module.flat_of_isLocalized_maximal S Mx (fun P _ => LocalizedModule P.primeCompl Mx)
    (fun P _ => LocalizedModule.mkLinearMap P.primeCompl Mx) fun P _ => ?_
  set Q := P.comap (algebraMap R S)
  have hxQ : x ∉ Q := fun h => (Ideal.IsMaximal.ne_top ‹_›)
    (P.eq_top_of_isUnit_mem h (IsLocalization.Away.algebraMap_isUnit x))
  have := IsLocalizedModule.comp_atPrime_of_isLocalization (Submonoid.powers x) S P
    (LocalizedModule.mkLinearMap (Submonoid.powers x) M)
    (LocalizedModule.mkLinearMap P.primeCompl Mx)
  have := hloc Q hxQ
  exact Module.Flat.of_linearEquiv (IsLocalizedModule.linearEquiv Q.primeCompl
    (((LocalizedModule.mkLinearMap P.primeCompl Mx).restrictScalars R) ∘ₗ
      LocalizedModule.mkLinearMap (Submonoid.powers x) M)
    (LocalizedModule.mkLinearMap Q.primeCompl M))

/-- The image of the complement of the contraction of a prime `Q'` of `R ⧸ I` is the complement
of `Q'`. -/
theorem _root_.Ideal.algebraMapSubmonoid_primeCompl_comap {I : Ideal R} (Q' : Ideal (R ⧸ I))
    [Q'.IsPrime] :
    Algebra.algebraMapSubmonoid (R ⧸ I) (Q'.comap (Ideal.Quotient.mk I)).primeCompl =
      Q'.primeCompl := by
  ext y
  constructor
  · rintro ⟨r, hr, rfl⟩
    exact hr
  · intro hy
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨r, hy, rfl⟩

/-- **Flatness of the localizations passes to the reduction modulo `x`.** If `M_Q` is flat over
`R`, where `Q` is the contraction of a prime `Q'` of `R/xR`, then `(M/xM)_{Q'}` is flat over
`R/xR`: it is the reduction of `M_Q` modulo `x`. -/
theorem flat_localizedModule_quotSMulTop (x : R) (Q' : Ideal (R ⧸ Ideal.span {x})) [Q'.IsPrime]
    (h : Module.Flat R
      (LocalizedModule (Q'.comap (Ideal.Quotient.mk (Ideal.span {x}))).primeCompl M)) :
    Module.Flat (R ⧸ Ideal.span {x}) (LocalizedModule Q'.primeCompl (QuotSMulTop x M)) := by
  set Q := Q'.comap (Ideal.Quotient.mk (Ideal.span {x}))
  have : Q.IsPrime := Ideal.comap_isPrime _ _
  set Rq := Localization.AtPrime Q
  set N := LocalizedModule Q.primeCompl M
  have : Module.Flat R N := h
  set f := LocalizedModule.mkLinearMap Q.primeCompl M
  have hflat : Module.Flat (R ⧸ Ideal.span {x}) (N ⧸ (Ideal.span {x} • ⊤ : Submodule R N)) :=
    Module.Flat.quotient_smul_top _
  set M₀ : Submodule R M := x • ⊤
  set L := M₀.localized' Rq Q.primeCompl f
  have hL : L.restrictScalars R = (Ideal.span {x} • ⊤ : Submodule R N) := by
    simp only [L, M₀, ← Submodule.ideal_span_singleton_smul, Submodule.localized'_smul,
      Submodule.localized'_top, Submodule.restrictScalars_localized'_smul,
      Submodule.restrictScalars_top]
  let g₁ : QuotSMulTop x M →ₗ[R] N ⧸ L := M₀.toLocalizedQuotient' Rq Q.primeCompl f
  let e₁ : (N ⧸ L) ≃ₗ[R] N ⧸ (Ideal.span {x} • ⊤ : Submodule R N) :=
    (Submodule.Quotient.restrictScalarsEquiv R L).symm ≪≫ₗ Submodule.quotEquivOfEq _ _ hL
  let g₂ : QuotSMulTop x M →ₗ[R] N ⧸ (Ideal.span {x} • ⊤ : Submodule R N) := e₁.toLinearMap ∘ₗ g₁
  have : IsLocalizedModule Q.primeCompl g₂ := inferInstance
  let g₃ : QuotSMulTop x M →ₗ[R ⧸ Ideal.span {x}] N ⧸ (Ideal.span {x} • ⊤ : Submodule R N) :=
    g₂.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
  have : IsLocalizedModule Q.primeCompl (g₃.restrictScalars R) := this
  have h3 : IsLocalizedModule (Algebra.algebraMapSubmonoid (R ⧸ Ideal.span {x}) Q.primeCompl) g₃ :=
    IsLocalizedModule.of_restrictScalars Q.primeCompl g₃
  rw [Ideal.algebraMapSubmonoid_primeCompl_comap] at h3
  exact Module.Flat.of_linearEquiv (IsLocalizedModule.iso Q'.primeCompl g₃)

/-- Every module over a local ring whose maximal ideal is zero is flat: the ring is a field. -/
theorem flat_of_maximalIdeal_eq_bot {R : Type u} [CommRing R] [IsLocalRing R]
    (h : maximalIdeal R = ⊥) (M : Type v) [AddCommGroup M] [Module R M] : Module.Flat R M := by
  let := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h).toField
  exact Module.Flat.of_free

/-- **The local flatness criterion.** Let `R` be a local ring whose maximal ideal is generated by
an `R`-regular sequence `xs`, and let `M` be an `R`-module on which `xs` is weakly regular. If the
localization `M_Q` is flat for every prime `Q` other than the maximal ideal, then `M` is flat. -/
theorem flat_of_isWeaklyRegular_of_flat_localizedModule (d : ℕ) :
    ∀ (R : Type u) [CommRing R] [IsLocalRing R] (xs : List R), xs.length = d →
      Ideal.ofList xs = maximalIdeal R → IsRegular R xs →
      ∀ (M : Type v) [AddCommGroup M] [Module R M], IsWeaklyRegular M xs →
        (∀ (Q : Ideal R) [Q.IsPrime], Q ≠ maximalIdeal R →
          Module.Flat R (LocalizedModule Q.primeCompl M)) → Module.Flat R M := by
  induction d with
  | zero =>
    intro R _ _ xs hlen hxs _ M _ _ _ _
    rw [List.length_eq_zero_iff.mp hlen, Ideal.ofList_nil] at hxs
    exact flat_of_maximalIdeal_eq_bot hxs.symm M
  | succ d ih =>
    intro R _ _ xs hlen hxs hreg M _ _ hM hloc
    obtain ⟨x, xs', rfl⟩ := List.exists_cons_of_length_eq_add_one hlen
    have hxm : x ∈ maximalIdeal R := hxs ▸ Ideal.subset_span (by simp)
    obtain ⟨hxR, hregq⟩ := (isRegular_cons_iff' R x xs').mp hreg
    obtain ⟨hxM, hMq⟩ := (isWeaklyRegular_cons_iff' M x xs').mp hM
    -- the localization at `x`
    have h1 : Module.Flat (Localization.Away x) (LocalizedModule (Submonoid.powers x) M) :=
      flat_localizedModule_powers_of_flat_localizedModule x fun Q _ hxQ =>
        hloc Q fun hQm => hxQ (hQm ▸ hxm)
    -- the quotient by `x`
    set R' := R ⧸ Ideal.span {x}
    have hxne : Ideal.span {x} ≠ ⊤ := by
      rw [Ne, Ideal.span_singleton_eq_top]
      exact fun hu => (maximalIdeal.isMaximal R).ne_top (Ideal.eq_top_of_isUnit_mem _ hxm hu)
    have : Nontrivial R' := Ideal.Quotient.nontrivial_iff.mpr hxne
    have : IsLocalRing R' := IsLocalRing.of_surjective' (Ideal.Quotient.mk _)
      Ideal.Quotient.mk_surjective
    have hmax : maximalIdeal R' = (maximalIdeal R).map (Ideal.Quotient.mk (Ideal.span {x})) :=
      (map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective).symm
    have hxs' : Ideal.ofList (xs'.map (Ideal.Quotient.mk (Ideal.span {x}))) = maximalIdeal R' := by
      rw [hmax, ← hxs, ← Ideal.map_ofList, Ideal.ofList_cons, Ideal.map_sup,
        Ideal.map_quotient_self, bot_sup_eq]
    have hsm : x • (⊤ : Submodule R R) = (Ideal.span {x} : Submodule R R) := by
      rw [← Submodule.ideal_span_singleton_smul, smul_eq_mul, Ideal.mul_top]
    have e : QuotSMulTop x R ≃ₗ[R'] R' :=
      (Submodule.quotEquivOfEq _ _ hsm).extendScalarsOfSurjective Ideal.Quotient.mk_surjective
    have hreg' : IsRegular R' (xs'.map (Ideal.Quotient.mk (Ideal.span {x}))) :=
      (LinearEquiv.isRegular_congr e _).mp hregq
    have h2 : Module.Flat R' (QuotSMulTop x M) := by
      refine ih R' (xs'.map (Ideal.Quotient.mk (Ideal.span {x}))) (by simpa using hlen) hxs'
        hreg' (QuotSMulTop x M) hMq fun Q' _ hQ' => flat_localizedModule_quotSMulTop x Q' ?_
      have : (Q'.comap (Ideal.Quotient.mk (Ideal.span {x}))).IsPrime := Ideal.comap_isPrime _ _
      refine hloc _ fun hQm => hQ' ?_
      rw [hmax, ← hQm, Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective]
    exact (flat_and_faithfullyFlat_of_flat_away_of_flat_quotSMulTop x (Localization.Away x)
      (LocalizedModule (Submonoid.powers x) M) (LocalizedModule.mkLinearMap _ M) hxR hxM).1 h1 h2

/-- **The global flatness criterion.** Let `A` be a Noetherian ring and `M` an `A`-module. Suppose
that at every prime `Q` the maximal ideal of `A_Q` is generated by an `A_Q`-regular sequence which
is weakly regular on `M_Q`. Then `M` is flat over `A`. -/
theorem flat_of_forall_isWeaklyRegular_localization (A : Type u) [CommRing A] [IsNoetherianRing A]
    (M : Type v) [AddCommGroup M] [Module A M]
    (h : ∀ (Q : Ideal A) [Q.IsPrime], ∃ xs : List (Localization.AtPrime Q),
      Ideal.ofList xs = maximalIdeal (Localization.AtPrime Q) ∧
        IsRegular (Localization.AtPrime Q) xs ∧
        IsWeaklyRegular (LocalizedModule Q.primeCompl M) xs) :
    Module.Flat A M := by
  have key : ∀ (n : ℕ) (Q : Ideal A) [Q.IsPrime], Q.height ≤ n →
      Module.Flat A (LocalizedModule Q.primeCompl M) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro Q _ hQn
    set R := Localization.AtPrime Q
    set MQ := LocalizedModule Q.primeCompl M
    rw [← Module.flat_iff_of_isLocalization R Q.primeCompl MQ]
    obtain ⟨xs, hxs, hreg, hM⟩ := h Q
    refine flat_of_isWeaklyRegular_of_flat_localizedModule xs.length R xs rfl hxs hreg MQ hM
      fun Q' _ hQ' => ?_
    set Q'' := Q'.comap (algebraMap A R)
    have hle : Q'' ≤ Q := by
      rw [← IsLocalization.AtPrime.under_maximalIdeal R Q]
      exact Ideal.comap_mono (le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›))
    have hne : Q'' ≠ Q := fun heq => hQ' <| by
      have h1 := IsLocalization.map_under Q.primeCompl R Q'
      rw [show Ideal.under A Q' = Q from heq, Localization.AtPrime.map_eq_maximalIdeal] at h1
      exact h1.symm
    have hlt : Q''.height < Q.height := Ideal.height_strict_mono_of_isPrime (lt_of_le_of_ne hle hne)
    obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := Q''))
    have hmn : m < n := by exact_mod_cast (hm ▸ hlt.trans_le hQn : (m : ℕ∞) < n)
    have hflat := ih m hmn Q'' hm.symm.le
    have := IsLocalizedModule.comp_atPrime_of_isLocalization Q.primeCompl R Q'
      (LocalizedModule.mkLinearMap Q.primeCompl M)
      (LocalizedModule.mkLinearMap Q'.primeCompl MQ)
    have hA : Module.Flat A (LocalizedModule Q'.primeCompl MQ) :=
      Module.Flat.of_linearEquiv (IsLocalizedModule.linearEquiv Q''.primeCompl
        (((LocalizedModule.mkLinearMap Q'.primeCompl MQ).restrictScalars A) ∘ₗ
          LocalizedModule.mkLinearMap Q.primeCompl M)
        (LocalizedModule.mkLinearMap Q''.primeCompl M))
    exact (Module.flat_iff_of_isLocalization R Q.primeCompl _).mpr hA
  refine Module.flat_of_localized_maximal M fun P _ => ?_
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime (I := P))
  exact key m P hm.symm.le

end Module
