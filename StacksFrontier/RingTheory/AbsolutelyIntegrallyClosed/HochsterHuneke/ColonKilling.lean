@[expose] public section

/-!
# Colon killing in the absolute integral closure of a regular local ring of dimension three

Let `R` be a regular local ring of characteristic `p` and dimension at most three whose integral
closure in every finite extension of its fraction field is finite, and let `B` be an absolute
integral closure of `R`. Then every regular system of parameters of `R` is a regular sequence on
`B`. This is the case `dim R ≤ 3` of the theorem of Hochster and Huneke that `B` is a big
Cohen–Macaulay algebra.

The proof works inside the finite normal subalgebras `T ⊆ B`. The first two parameters `x, y`
form a regular sequence on `T` because `T` is normal (`NormalDepth`). At a prime `Q ≠ 𝔪` the
localization `T_Q` is a normal domain finite over the regular local ring `R_Q` of dimension at
most two, hence free over it (Stacks 00NT), so the colon modules
`((x^t, y^t)T : z^t) / (x^t, y^t)T` are killed by a power of `x` and of `y` independently of `t`
(`UniformAnnihilation`). The Frobenius argument of `Equational` then kills every relation
`s z ∈ (x, y)T` in `B`.

## Main results

* `IsRegularLocalRing.free_of_ringKrullDim_le_two`: a normal domain finite over a regular local
  ring of dimension at most two is free.
* `IsRegularLocalRing.mem_span_pow_pair_of_mul_mem`: `z^t` is a nonzerodivisor modulo
  `(x^t, y^t)` for a regular system of parameters `x, y, z`.
* `IsRegularLocalRing.exists_forall_mul_mem_span_pow_pair`: the uniform annihilation of the
  parameter colons of a normal domain finite over a regular local ring of dimension three.
* `mem_span_pair_of_mul_eq_of_isIntegrallyClosed`: such a colon relation in a finite normal
  subalgebra `T` of an absolutely integrally closed domain `B` becomes trivial in `B`.
-/

open IsLocalRing RingTheory.Sequence

/-- A regular local ring has a regular system of parameters: a list generating the maximal ideal
whose length is the minimal number of generators. -/
@[sga "2 IV 5.3" "partial"]
theorem IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq (R : Type*) [CommRing R]
    [IsRegularLocalRing R] :
    ∃ xs : List R, Ideal.ofList xs = maximalIdeal R ∧ xs.length = (maximalIdeal R).spanFinrank := by
  obtain ⟨xs, hxs, hlen⟩ := IsRegularLocalRing.exists_ofList_eq_maximalIdeal R
  refine ⟨xs, hxs, ?_⟩
  have h := (IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)).trans hlen.symm
  exact_mod_cast h.symm

/-- **A normal domain finite over a regular local ring of dimension at most two is free.** It is
maximal Cohen–Macaulay: a regular system of parameters of `R` has length at most two, so it is a
regular sequence on `T` by `isWeaklyRegular_take_two_of_isIntegrallyClosed`; then Stacks 00NT
applies. -/
theorem IsRegularLocalRing.free_of_ringKrullDim_le_two {R T : Type*} [CommRing R]
    [IsRegularLocalRing R] (hdim : ringKrullDim R ≤ 2) [CommRing T] [IsDomain T]
    [IsNoetherianRing T] [IsIntegrallyClosed T] [Algebra R T] [FaithfulSMul R T]
    [Algebra.IsIntegral R T] [Module.Finite R T] : Module.Free R T := by
  obtain ⟨xs, hxs, hlen⟩ := IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq R
  have hlen2 : xs.length ≤ 2 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hlen] at h
    have : (xs.length : WithBot ℕ∞) ≤ 2 := h ▸ hdim
    exact_mod_cast this
  have hweak : IsWeaklyRegular T xs := by
    have := isWeaklyRegular_take_two_of_isIntegrallyClosed (T := T) hxs hlen
    rwa [List.take_of_length_le hlen2] at this
  have hsub : ∀ r ∈ xs, r ∈ maximalIdeal R := fun r hr => hxs ▸ Ideal.subset_span hr
  have hreg : IsRegular T xs :=
    (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal hsub).mpr hweak
  refine regular_mcm_free R T ⟨xs, hsub, hreg, ?_⟩
  rw [hlen]
  exact IsRegularLocalRing.spanFinrank_maximalIdeal

/-- The ideal generated by a two-element list is the span of the pair. -/
theorem Ideal.ofList_pair {R : Type*} [CommSemiring R] (x y : R) :
    Ideal.ofList [x, y] = Ideal.span {x, y} :=
  congrArg Ideal.span (Set.ext fun r => by simp)

/-- If `x, y, z` is a weakly regular sequence on `R`, then `z` is a nonzerodivisor modulo
`(x, y)`. -/
theorem mem_span_pair_of_isWeaklyRegular {R : Type*} [CommRing R] {x y z : R}
    (h : IsWeaklyRegular R [x, y, z]) {r : R} (hr : z * r ∈ Ideal.span {x, y}) :
    r ∈ Ideal.span {x, y} := by
  have h2 := h.regular_mod_prev 2 (by simp)
  simp only [List.take_succ_cons, List.take_zero, List.getElem_cons_succ,
    List.getElem_cons_zero] at h2
  have hI : (Ideal.ofList [x, y] • ⊤ : Submodule R R) = Ideal.span {x, y} := by
    rw [Ideal.ofList_pair, smul_eq_mul, Ideal.mul_top]
  have key := (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp h2 r (by rw [hI]; exact hr)
  rwa [hI] at key

/-- In a regular local ring with regular system of parameters `x, y, z`, every power `z^t` is a
nonzerodivisor modulo `(x^t, y^t)`. -/
theorem IsRegularLocalRing.mem_span_pow_pair_of_mul_mem {R : Type*} [CommRing R]
    [IsRegularLocalRing R] {x y z : R} (hxs : Ideal.ofList [x, y, z] = maximalIdeal R)
    (hlen : [x, y, z].length = (maximalIdeal R).spanFinrank) (t : ℕ) {r : R}
    (hr : z ^ t * r ∈ Ideal.span {x ^ t, y ^ t}) : r ∈ Ideal.span {x ^ t, y ^ t} := by
  rcases Nat.eq_zero_or_pos t with rfl | ht
  · exact Ideal.mem_span_pair.mpr ⟨r, 0, by simp⟩
  obtain ⟨hreg, -⟩ :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay R).1
      _ hxs hlen
  have hpow := (RingTheory.Sequence.isRegular_zipWith_pow_iff R (rs := [x, y, z]) (es := [t, t, t])
    rfl (by simp [ht])).mpr hreg
  simp only [List.zipWith_cons_cons, List.zipWith_nil_right] at hpow
  exact mem_span_pair_of_isWeaklyRegular hpow.toIsWeaklyRegular hr

/-- **Uniform annihilation of parameter colons in a normal domain over a regular local ring of
dimension three.** Let `R` be a regular local ring with regular system of parameters `x, y, z` and
`T` a Noetherian normal domain finite over `R`. There is `N` such that `x^N` and `y^N` kill every
class `u` with `z^q u ∈ (x^q, y^q)T` modulo `(x^q, y^q)T`, for every `q`. -/
theorem IsRegularLocalRing.exists_forall_mul_mem_span_pow_pair {R T : Type*} [CommRing R]
    [IsRegularLocalRing R] [CommRing T] [IsDomain T] [IsNoetherianRing T] [IsIntegrallyClosed T]
    [Algebra R T] [FaithfulSMul R T] [Algebra.IsIntegral R T] [Module.Finite R T] {x y z : R}
    (hxs : Ideal.ofList [x, y, z] = maximalIdeal R)
    (hlen : [x, y, z].length = (maximalIdeal R).spanFinrank) :
    ∃ N : ℕ, ∀ (q : ℕ) (u : T),
      algebraMap R T z ^ q * u ∈ Ideal.span {algebraMap R T x ^ q, algebraMap R T y ^ q} →
        algebraMap R T x ^ N * u ∈ Ideal.span {algebraMap R T x ^ q, algebraMap R T y ^ q} ∧
        algebraMap R T y ^ N * u ∈ Ideal.span {algebraMap R T x ^ q, algebraMap R T y ^ q} := by
  have := IsRegularLocalRing.isDomain R
  have : IsRegularRing R :=
    ((IsLocalRing.isRegularRing_tfae (R := R)).out 1 3).mp ‹IsRegularLocalRing R›
  set J : ℕ → Ideal T := fun t => Ideal.span {algebraMap R T x ^ t, algebraMap R T y ^ t}
  -- the ideal of `c ∈ R` killing all the colon modules
  let 𝔞 : Ideal R :=
    { carrier := {c | ∀ (t : ℕ) (u : T), algebraMap R T z ^ t * u ∈ J t →
        algebraMap R T c * u ∈ J t}
      add_mem' := fun ha hb t u hu => by
        rw [map_add, add_mul]; exact (J t).add_mem (ha t u hu) (hb t u hu)
      zero_mem' := fun t u _ => by rw [map_zero, zero_mul]; exact (J t).zero_mem
      smul_mem' := fun c d hd t u hu => by
        rw [smul_eq_mul, map_mul, mul_assoc]; exact (J t).mul_mem_left _ (hd t u hu) }
  have hdim : ringKrullDim R = 3 := by
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, ← hlen]; rfl
  -- at every prime `Q ≠ 𝔪` some element of `𝔞` lies outside `Q`
  have hprime : ∀ Q : Ideal R, Q.IsPrime → Q ≠ maximalIdeal R → ∃ c ∈ 𝔞, c ∉ Q := by
    intro Q hQ hQm
    let TQ := Localization (Algebra.algebraMapSubmonoid T Q.primeCompl)
    have hle : Algebra.algebraMapSubmonoid T Q.primeCompl ≤ nonZeroDivisors T :=
      algebraMapSubmonoid_le_nonZeroDivisors_of_faithfulSMul _ Q.primeCompl_le_nonZeroDivisors
    have : IsDomain TQ := IsLocalization.isDomain_of_le_nonZeroDivisors TQ hle
    have : IsNoetherianRing TQ :=
      IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid T Q.primeCompl) TQ inferInstance
    have : IsIntegrallyClosed TQ := isIntegrallyClosed_of_isLocalization (R := T) (S := TQ) _ hle
    have : FaithfulSMul (Localization.AtPrime Q) TQ :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (localizationAlgebra_injective _ _
        (FaithfulSMul.algebraMap_injective R T))
    have : Module.Finite (Localization.AtPrime Q) TQ :=
      Module.Finite.of_isLocalization R T Q.primeCompl
    have hdimQ : ringKrullDim (Localization.AtPrime Q) ≤ 2 := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height Q]
      have hlt : Q < maximalIdeal R := lt_of_le_of_ne (le_maximalIdeal hQ.ne_top) hQm
      have h1 := Ideal.height_strict_mono_of_isPrime hlt
      have h5 : ((maximalIdeal R).height : WithBot ℕ∞) = ((3 : ℕ∞) : WithBot ℕ∞) := by
        rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hdim]; rfl
      have h6 : (maximalIdeal R).height = 3 := by exact_mod_cast h5
      rw [h6] at h1
      have h2 : Q.height ≤ 2 := Order.le_of_lt_add_one h1
      have h7 : ((Q.height : ℕ∞) : WithBot ℕ∞) ≤ ((2 : ℕ∞) : WithBot ℕ∞) :=
        WithBot.coe_le_coe.mpr h2
      exact h7
    have hfree : Module.Free (Localization.AtPrime Q) TQ :=
      IsRegularLocalRing.free_of_ringKrullDim_le_two hdimQ
    have hloc : IsLocalizedModule Q.primeCompl
        ((Algebra.linearMap T TQ).restrictScalars R) :=
      IsLocalizedModule.restrictScalars Q.primeCompl (Algebra.linearMap T TQ)
    obtain ⟨c, hcQ, hc⟩ := exists_notMem_forall_mul_mem_span_pow_pair Q TQ
      ((Algebra.linearMap T TQ).restrictScalars R)
      (fun t r hr => IsRegularLocalRing.mem_span_pow_pair_of_mul_mem hxs hlen t hr)
    exact ⟨c, hc, hcQ⟩
  have hrad : ∀ w ∈ maximalIdeal R, w ∈ 𝔞.radical := by
    intro w hw
    rw [Ideal.radical_eq_sInf]
    refine Submodule.mem_sInf.mpr ?_
    rintro J' ⟨hJ', hJ'p⟩
    by_cases hJm : J' = maximalIdeal R
    · exact hJm ▸ hw
    obtain ⟨c, hc, hcJ⟩ := hprime J' hJ'p hJm
    exact absurd (hJ' hc) hcJ
  have hxm : x ∈ maximalIdeal R := hxs ▸ Ideal.subset_span (by simp)
  have hym : y ∈ maximalIdeal R := hxs ▸ Ideal.subset_span (by simp)
  obtain ⟨N₁, hN₁⟩ := hrad x hxm
  obtain ⟨N₂, hN₂⟩ := hrad y hym
  have hx' : x ^ (N₁ + N₂) ∈ 𝔞 := by rw [pow_add, mul_comm]; exact 𝔞.mul_mem_left _ hN₁
  have hy' : y ^ (N₁ + N₂) ∈ 𝔞 := by rw [pow_add]; exact 𝔞.mul_mem_left _ hN₂
  refine ⟨N₁ + N₂, fun q u hu => ⟨?_, ?_⟩⟩
  · have := hx' q u hu
    rwa [map_pow] at this
  · have := hy' q u hu
    rwa [map_pow] at this

/-- **Colon killing through a normal subalgebra.** Let `R` be a regular local ring of
characteristic `p` with regular system of parameters `x, y, z`, let `B` be an absolutely
integrally closed domain containing `R`, and let `ι : T → B` be an `R`-algebra map from a
Noetherian normal domain `T` finite over `R`. If `s z = a x + b y` in `T`, then `ι s ∈ (x, y)B`. -/
theorem mem_span_pair_of_mul_eq_of_isIntegrallyClosed {p : ℕ} [Fact p.Prime] {R T B : Type*}
    [CommRing R] [IsRegularLocalRing R] [CharP R p] [CommRing T] [IsDomain T] [IsNoetherianRing T]
    [IsIntegrallyClosed T] [Algebra R T] [FaithfulSMul R T] [Algebra.IsIntegral R T]
    [Module.Finite R T] [CommRing B] [IsDomain B] [Algebra R B] [FaithfulSMul R B]
    (hB : IsAbsolutelyIntegrallyClosed B) (ι : T →ₐ[R] B) {x y z : R}
    (hxs : Ideal.ofList [x, y, z] = maximalIdeal R)
    (hlen : [x, y, z].length = (maximalIdeal R).spanFinrank) {s a b : T}
    (hs : s * algebraMap R T z = a * algebraMap R T x + b * algebraMap R T y) :
    ι s ∈ Ideal.span {algebraMap R B x, algebraMap R B y} := by
  have := IsRegularLocalRing.isDomain R
  have := isIntegrallyClosed_of_isRegularLocalRing R
  have : CharP T p := charP_of_injective_algebraMap (FaithfulSMul.algebraMap_injective R T) p
  have : CharP B p := charP_of_injective_algebraMap (FaithfulSMul.algebraMap_injective R B) p
  have hx0 : x ≠ 0 := IsRegularLocalRing.ne_zero_of_ofList_eq hxs hlen
  have hy0 : y ≠ 0 := IsRegularLocalRing.ne_zero_of_ofList_eq_cons hxs hlen
  obtain ⟨N, hN⟩ := IsRegularLocalRing.exists_forall_mul_mem_span_pow_pair (T := T) hxs hlen
  have hxT : algebraMap R T x ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective R T)).mpr hx0
  have hx : IsSMulRegular T (algebraMap R T x) := fun a b h => mul_left_cancel₀ hxT h
  have hy : ∀ c : T, algebraMap R T y * c ∈ Ideal.span {algebraMap R T x} →
      c ∈ Ideal.span {algebraMap R T x} := fun c hc =>
    mem_span_singleton_of_two_le_height hx0
      (fun q hq hxq hyq => IsRegularLocalRing.two_le_height_of_mem hxs hlen hxq hyq) hc
  have hφ : ∀ w : R, w ≠ 0 → ι.toRingHom (algebraMap R T w) ≠ 0 := fun w hw => by
    simpa using (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective R B)).mpr hw
  have := hB.mem_span_pair_of_mul_eq (p := p) ι.toRingHom hx hy hs N
    (fun q u hu => by simpa only [map_pow] using hN q u (by simpa only [map_pow] using hu))
    (hφ x hx0) (hφ y hy0)
  simpa using this
