module

public import StacksFrontier.RingTheory.AbsolutelyIntegrallyClosed.HochsterHuneke.ColonKilling
public import StacksFrontier.RingTheory.AbsolutelyIntegrallyClosed.HochsterHuneke.FiniteNormal
public import StacksFrontier.RingTheory.Nagata.Japanese

@[expose] public section

/-!
# The absolute integral closure of a regular local ring of dimension at most three

Let `R` be a regular local ring of characteristic `p`, of dimension at most three, which is a
Nagata ring, and let `B` be an absolute integral closure of `R`. Then every regular system of
parameters of `R` is a weakly regular sequence on `B`. This is the theorem of Hochster and Huneke
that `B` is a big Cohen–Macaulay algebra, in dimension at most three.

Each condition of weak regularity is a statement about finitely many elements of `B`, so it is
checked inside a normal domain `T` finite over `R` containing them
(`IsAbsoluteIntegralClosure.exists_finite_isIntegrallyClosed`). For the first two parameters the
normality of `T` suffices; for the third one the colon is killed in `B` by the Frobenius argument
(`mem_span_pair_of_mul_eq_of_isIntegrallyClosed`).

## Main results

* `RingTheory.Sequence.isWeaklyRegular_iff_forall_mem_ofList`: weak regularity of a sequence of
  elements of `R` on an `R`-algebra `S`, as colon conditions on ideals of `S`.
* `IsAbsoluteIntegralClosure.isWeaklyRegular_of_ringKrullDim_le_three`: a regular system of
  parameters of `R` is a weakly regular sequence on `B`.

## References

* M. Hochster and C. Huneke, *Infinite integral extensions and big Cohen–Macaulay algebras*,
  Ann. of Math. 135 (1992), 53–89.
-/

open IsLocalRing RingTheory.Sequence

universe u

/-- Weak regularity of a list of elements of `R` on an `R`-algebra `S`, as colon conditions: the
image of each member is a nonzerodivisor modulo the ideal of `S` generated by the images of the
preceding members. -/
theorem RingTheory.Sequence.isWeaklyRegular_iff_forall_mem_ofList {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (xs : List R) :
    IsWeaklyRegular S xs ↔ ∀ (i : ℕ) (h : i < xs.length) (m : S),
      algebraMap R S xs[i] * m ∈ Ideal.ofList ((xs.take i).map (algebraMap R S)) →
        m ∈ Ideal.ofList ((xs.take i).map (algebraMap R S)) := by
  have key : ∀ (i : ℕ) (m : S), m ∈ (Ideal.ofList (xs.take i) • ⊤ : Submodule R S) ↔
      m ∈ Ideal.ofList ((xs.take i).map (algebraMap R S)) := by
    intro i m
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_ofList]
  constructor
  · intro h i hi m hm
    have := (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp (h.regular_mod_prev i hi) m
    rw [key, key, Algebra.smul_def] at this
    exact this hm
  · intro h
    refine ⟨fun i hi => (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mpr fun m hm => ?_⟩
    rw [key, Algebra.smul_def] at hm
    rw [key]
    exact h i hi m hm

namespace IsAbsoluteIntegralClosure

variable {R : Type u} [CommRing R] [IsDomain R] [IsRegularLocalRing R] [IsNagataRing R]
  {B : Type u} [CommRing B] [IsDomain B] [Algebra R B]

/-- A Nagata domain is Japanese. -/
theorem isJapaneseRing_of_isNagataRing (R : Type u) [CommRing R] [IsDomain R] [IsNagataRing R] :
    IsJapaneseRing R :=
  have : (⊥ : Ideal R).IsPrime := Ideal.isPrime_bot
  IsJapaneseRing.of_ringEquiv (RingEquiv.quotientBot R) (IsNagataRing.isJapaneseRing_quotient ⊥)

include R in
/-- In an absolute integral closure of a regular local Nagata ring, the second member of a regular
system of parameters is a nonzerodivisor modulo the first. -/
theorem mem_span_singleton_of_mul_mem (hB : IsAbsoluteIntegralClosure R B) {x y : R}
    {rest : List R} (hxs : Ideal.ofList (x :: y :: rest) = maximalIdeal R)
    (hlen : (x :: y :: rest).length = (maximalIdeal R).spanFinrank) {m : B}
    (hm : algebraMap R B y * m ∈ Ideal.span {algebraMap R B x}) :
    m ∈ Ideal.span {algebraMap R B x} := by
  classical
  have := isIntegrallyClosed_of_isRegularLocalRing R
  have := isJapaneseRing_of_isNagataRing R
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hm
  obtain ⟨T, _, _, _, _, _, _, _, ι, hι, hS⟩ := hB.exists_finite_isIntegrallyClosed {m, c}
  have : IsNoetherianRing T := IsNoetherianRing.of_finite R T
  obtain ⟨tm, rfl⟩ := hS m (by simp)
  obtain ⟨tc, rfl⟩ := hS c (by simp)
  have hrel : algebraMap R T y * tm ∈ Ideal.span {algebraMap R T x} := by
    refine Ideal.mem_span_singleton'.mpr ⟨tc, hι ?_⟩
    rw [map_mul, map_mul, AlgHom.commutes, AlgHom.commutes, hc]
  obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp (mem_span_singleton_of_two_le_height
    (IsRegularLocalRing.ne_zero_of_ofList_eq hxs hlen)
    (fun q hq hxq hyq => IsRegularLocalRing.two_le_height_of_mem hxs hlen hxq hyq) hrel)
  exact Ideal.mem_span_singleton'.mpr ⟨ι s, by rw [map_mul, AlgHom.commutes]⟩

include R in
/-- **Colon killing.** In an absolute integral closure `B` of a regular local Nagata ring of
characteristic `p` with regular system of parameters `x, y, z`, the parameter `z` is a
nonzerodivisor modulo `(x, y)B`. -/
theorem mem_span_pair_of_mul_mem (p : ℕ) [Fact p.Prime] [CharP R p]
    (hB : IsAbsoluteIntegralClosure R B) {x y z : R}
    (hxs : Ideal.ofList [x, y, z] = maximalIdeal R)
    (hlen : [x, y, z].length = (maximalIdeal R).spanFinrank) {m : B}
    (hm : algebraMap R B z * m ∈ Ideal.span {algebraMap R B x, algebraMap R B y}) :
    m ∈ Ideal.span {algebraMap R B x, algebraMap R B y} := by
  classical
  have := isJapaneseRing_of_isNagataRing R
  have : FaithfulSMul R B := (faithfulSMul_iff_algebraMap_injective R B).mpr hB.injective
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hm
  obtain ⟨T, _, _, _, _, _, _, _, ι, hι, hS⟩ := hB.exists_finite_isIntegrallyClosed {m, a, b}
  have : IsNoetherianRing T := IsNoetherianRing.of_finite R T
  obtain ⟨tm, rfl⟩ := hS m (by simp)
  obtain ⟨ta, rfl⟩ := hS a (by simp)
  obtain ⟨tb, rfl⟩ := hS b (by simp)
  have hrel : tm * algebraMap R T z = ta * algebraMap R T x + tb * algebraMap R T y := by
    apply hι
    simp only [map_mul, map_add, AlgHom.commutes]
    rw [hab]
    ring
  exact mem_span_pair_of_mul_eq_of_isIntegrallyClosed (p := p) hB.isAbsolutelyIntegrallyClosed ι
    hxs hlen hrel

include R in
/-- **Hochster–Huneke in dimension at most three.** Let `R` be a regular local Nagata ring of
characteristic `p` and dimension at most three, and let `B` be an absolute integral closure of
`R`. Then every regular system of parameters of `R` is a weakly regular sequence on `B`. -/
theorem isWeaklyRegular_of_ringKrullDim_le_three (p : ℕ) [Fact p.Prime] [CharP R p]
    (hdim : ringKrullDim R ≤ 3)
    (hB : IsAbsoluteIntegralClosure R B) {xs : List R} (hxs : Ideal.ofList xs = maximalIdeal R)
    (hlen : xs.length = (maximalIdeal R).spanFinrank) : IsWeaklyRegular B xs := by
  have hlen3 : xs.length ≤ 3 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [← hlen] at h
    have : (xs.length : WithBot ℕ∞) ≤ 3 := h ▸ hdim
    exact_mod_cast this
  -- the first parameter
  have h0 : ∀ {x : R} {rest : List R}, Ideal.ofList (x :: rest) = maximalIdeal R →
      (x :: rest).length = (maximalIdeal R).spanFinrank → ∀ m : B,
        algebraMap R B x * m ∈ Ideal.ofList (([] : List R).map (algebraMap R B)) →
          m ∈ Ideal.ofList (([] : List R).map (algebraMap R B)) := by
    intro x rest hxs hlen m hm
    have hx := (map_ne_zero_iff _ hB.injective).mpr
      (IsRegularLocalRing.ne_zero_of_ofList_eq hxs hlen)
    simpa [hx] using hm
  rw [isWeaklyRegular_iff_forall_mem_ofList]
  match xs, hxs, hlen, hlen3 with
  | [], _, _, _ =>
    intro i hi
    simp at hi
  | [x], hxs, hlen, _ =>
    intro i hi m hm
    obtain rfl : i = 0 := by simpa using hi
    exact h0 hxs hlen m hm
  | x :: y :: rest, hxs, hlen, h =>
    intro i hi m hm
    match i, rest, hxs, hlen, hi, h with
    | 0, _, hxs, hlen, _, _ => exact h0 hxs hlen m hm
    | 1, _, hxs, hlen, _, _ =>
      simp only [List.take_succ_cons, List.take_zero, List.map_cons, List.map_nil,
        Ideal.ofList_singleton, List.getElem_cons_succ, List.getElem_cons_zero] at hm ⊢
      exact mem_span_singleton_of_mul_mem hB hxs hlen hm
    | 2, [z], hxs, hlen, _, _ =>
      simp only [List.take_succ_cons, List.take_zero, List.map_cons, List.map_nil,
        Ideal.ofList_pair, List.getElem_cons_succ, List.getElem_cons_zero] at hm ⊢
      exact mem_span_pair_of_mul_mem p hB hxs hlen hm
    | 2, [], _, _, hi, _ => simp at hi
    | 2, _ :: _ :: _, _, _, _, h => simp at h; omega
    | _ + 3, _, _, _, hi, h => simp at hi h; omega

end IsAbsoluteIntegralClosure
