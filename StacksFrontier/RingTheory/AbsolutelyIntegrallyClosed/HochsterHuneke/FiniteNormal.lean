module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import StacksFrontier.RingTheory.AbsolutelyIntegrallyClosed.Absolute
public import StacksFrontier.RingTheory.Nagata.Defs

@[expose] public section

/-!
# Finite normal subextensions of an absolute integral closure

Let `R` be a Japanese domain (its integral closure in every finite extension of its fraction field
is finite) and let `B` be an absolute integral closure of `R`. Every finite subset of `B` lies in
the image of a normal domain `T` which is finite over `R`: take for `T` the integral closure of
`R` in the subfield of `Frac(B)` generated over `Frac(R)` by the subset. This is how statements
about the non-Noetherian ring `B` are reduced to statements about Noetherian normal domains.

## Main results

* `IsAbsoluteIntegralClosure.exists_finite_isIntegrallyClosed`: a finite subset of `B` lies in the
  image of an injective `R`-algebra map `T → B` from a normal domain `T` finite over `R`.
-/

open IntermediateField

attribute [local instance] FractionRing.liftAlgebra

namespace IsAbsoluteIntegralClosure

universe u

/-- **Finite normal subextensions.** Let `R` be a Japanese domain and `B` an absolute integral
closure of `R`. Every finite subset `S ⊆ B` lies in the image of an injective `R`-algebra map
`T → B` from a domain `T` which is integrally closed, finite and integral over `R`, with `R → T`
injective. -/
theorem exists_finite_isIntegrallyClosed {R : Type u} [CommRing R] [IsDomain R]
    [IsJapaneseRing R] {B : Type u} [CommRing B] [IsDomain B] [Algebra R B]
    (hB : IsAbsoluteIntegralClosure R B) (S : Finset B) :
    ∃ (T : Type u) (_ : CommRing T) (_ : IsDomain T) (_ : Algebra R T)
      (_ : IsIntegrallyClosed T) (_ : Module.Finite R T) (_ : FaithfulSMul R T)
      (_ : Algebra.IsIntegral R T) (ι : T →ₐ[R] B),
      Function.Injective ι ∧ ∀ s ∈ S, ∃ t : T, ι t = s := by
  classical
  let K := FractionRing R
  let L := FractionRing B
  have hRL : Function.Injective (algebraMap R L) := by
    rw [IsScalarTower.algebraMap_eq R B L]
    exact (IsFractionRing.injective B L).comp hB.injective
  have : FaithfulSMul R L := (faithfulSMul_iff_algebraMap_injective R L).mpr hRL
  have : Algebra.IsIntegral R B := hB.isIntegral
  have : IsIntegralClosure B R L := hB.isIntegralClosure L
  have hintL : ∀ b : B, IsIntegral R (algebraMap B L b) := fun b =>
    (Algebra.IsIntegral.isIntegral (R := R) b).map (IsScalarTower.toAlgHom R B L)
  -- the subfield generated by `S`
  set S' : Set L := (S.image (algebraMap B L) : Set L)
  let F : IntermediateField K L := adjoin K S'
  have hS'int : ∀ x ∈ S', IsIntegral K x := by
    intro x hx
    simp only [S', Finset.coe_image, Set.mem_image, Finset.mem_coe] at hx
    obtain ⟨b, -, rfl⟩ := hx
    exact (hintL b).tower_top
  have : Finite S' := Finset.finite_toSet _
  have : FiniteDimensional K F := finiteDimensional_adjoin hS'int
  -- the integral closure of `R` in `F`
  let T := integralClosure R F
  have : IsIntegrallyClosed T := integralClosure.isIntegrallyClosedOfFiniteExtension K
  have : Module.Finite R T := IsJapaneseRing.finite F
  have hcoe : ∀ r : R, (((algebraMap R T r : T) : F) : L) = algebraMap R L r := fun _ => rfl
  have : IsScalarTower R F L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hRT : Function.Injective (algebraMap R T) := fun a b h =>
    hRL (by rw [← hcoe, ← hcoe, h])
  have : FaithfulSMul R T := (faithfulSMul_iff_algebraMap_injective R T).mpr hRT
  -- the map `T → L` and its lift to `B`
  let jT : T →+* L := algebraMap T L
  have hjTapp : ∀ t : T, jT t = ((t : F) : L) := fun _ => rfl
  have : IsScalarTower R T L := IsScalarTower.of_algebraMap_eq fun r => (hcoe r).symm
  let ι : T →ₐ[R] B := IsIntegralClosure.lift R B L
  have hι : ∀ t, algebraMap B L (ι t) = jT t := fun t => IsIntegralClosure.algebraMap_lift R B L t
  have hjT : Function.Injective jT := fun a b h =>
    Subtype.ext (Subtype.ext (by simpa [hjTapp] using h))
  refine ⟨T, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, ι, fun a b h => hjT (by rw [← hι, ← hι, h]), fun s hs => ?_⟩
  have hsF : algebraMap B L s ∈ F := subset_adjoin K S' (by simp [S', hs])
  have hsint : IsIntegral R (⟨algebraMap B L s, hsF⟩ : F) :=
    (isIntegral_algHom_iff (IsScalarTower.toAlgHom R F L)
      (FaithfulSMul.algebraMap_injective F L)).mp (hintL s)
  refine ⟨⟨⟨algebraMap B L s, hsF⟩, hsint⟩, IsFractionRing.injective B L ?_⟩
  rw [hι]
  rfl

end IsAbsoluteIntegralClosure
