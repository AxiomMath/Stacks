/-!
# The Isom scheme of graded multiplication data

A *graded multiplication datum* `M` over a commutative ring `R` is a family of `R`-modules
`M n` (`n : ℕ`) with bilinear maps `M i → M j → M (i + j)` and an element `1 ∈ M 0`; no axioms
are imposed. Given two such data `M`, `N` whose pieces are finite projective `R`-modules, we
show that the functor `C ↦ Iso (M_C, N_C)` of isomorphisms of base changes, on `R`-algebras
`C`, is corepresented by an `R`-algebra `H` (so `Spec H` is the affine `Isom` scheme over
`Spec R`) of cardinality at most `max #R ℵ₀`.

## Main definitions

* `GradedMulDatum`, `GradedMulDatum.Hom`, `GradedMulDatum.Iso`: graded multiplication data,
  their homomorphisms and isomorphisms; `Hom.id`, `Hom.comp`, `Iso.ofBijective`.
* `GradedMulDatum.baseChange`: base change `C ⊗[R] M` along an `R`-algebra `C`.
* `tensorEquivDualHom`: for `Q` finite projective, `C ⊗[R] Q ≃ Hom_R(Q^∨, C)`.
* `dualCoordIdeal`: the ideal generated by all coordinates `ξ (z i)` of elements
  `z i ∈ A ⊗[R] Q`.
* `isomAlgebra M N`: the corepresenting algebra, the quotient of the symmetric algebra
  `isomFreeAlgebra M N` on `⨁ n, (M n ⊗ (N n)^∨) × (N n ⊗ (M n)^∨)` by `isomIdeal M N`.
* `isomEquiv M N C : (isomAlgebra M N →ₐ[R] C) ≃ Iso (M_C, N_C)`.

## Main results

* `dualCoordIdeal_le_ker_iff`: an algebra map `φ : A → C` kills `dualCoordIdeal z` iff every
  `z i` vanishes in `C ⊗[R] Q`.
* `cardinalMk_isomAlgebra_le`: `#(isomAlgebra M N) ≤ max #R ℵ₀`.
* `exists_corepresenting`: the functor of isomorphisms of base changes is corepresentable,
  naturally in `C`, by an algebra of cardinality at most `max #R ℵ₀`.

## Implementation notes

For `P` arbitrary and `Q` finite projective, `R`-linear maps `P → C ⊗ Q` correspond to
`R`-linear maps `P ⊗ Q^∨ → C` (`homTensorDualEquiv`), hence to algebra maps out of a symmetric
algebra. A pair of families `f n : M n → C ⊗ N n`, `g n : N n → C ⊗ M n` defines an isomorphism
of base changes iff finitely many explicit *defects* (`mulDefect`, `oneDefect`, `compDefect`)
vanish; each defect is natural in `C`, so these conditions are imposed on the universal families
`univHom`, `univInv` over `isomFreeAlgebra` by quotienting out the coordinates of the universal
defects (`isomIdeal`). The equivalence `isomEquiv` sends `φ` to the push-forward of the universal
families along `φ`, which makes naturality in `C` hold by construction.

A `C`-linear map out of `C ⊗[R] P` is determined by its values on the `1 ⊗ₜ p`: this is
`TensorProduct.AlgebraTensorModule.curry_injective` combined with `LinearMap.ext_ring` (what the
`ext` tactic does), or the injectivity of `(LinearMap.liftBaseChangeEquiv C).symm`; for
homomorphisms of base changes we record it as `GradedMulDatum.Hom.baseChange_ext`.

## References

* [Stacks Project, Tag 0D42](https://stacks.math.columbia.edu/tag/0D42)
-/

@[expose] public noncomputable section

universe u

open TensorProduct Module

namespace Stacks.GradedIsomScheme

/-! ### Coordinates of elements of `C ⊗[R] Q` for `Q` finite projective -/

section Coordinates

variable {R : Type*} [CommRing R]

variable (C Q : Type*) [AddCommGroup C] [Module R C] [AddCommGroup Q] [Module R Q]
  [Module.Finite R Q] [Module.Projective R Q]

/-- For a finite projective `R`-module `Q`, the natural isomorphism
`C ⊗[R] Q ≃ Hom_R(Q^∨, C)`, `c ⊗ q ↦ (ξ ↦ ξ q • c)`. -/
def tensorEquivDualHom : C ⊗[R] Q ≃ₗ[R] (Dual R Q →ₗ[R] C) :=
  TensorProduct.comm R C Q ≪≫ₗ (evalEquiv R Q).rTensor C ≪≫ₗ dualTensorHomEquiv R (Dual R Q) C

/-- `tensorEquivDualHom` on pure tensors. -/
@[simp]
theorem tensorEquivDualHom_tmul (c : C) (q : Q) (ξ : Dual R Q) :
    tensorEquivDualHom C Q (c ⊗ₜ q) ξ = ξ q • c := by
  simp [tensorEquivDualHom]

variable {C} in
/-- `tensorEquivDualHom` is natural in `C`. -/
theorem tensorEquivDualHom_rTensor {C' : Type*} [AddCommGroup C'] [Module R C']
    (g : C →ₗ[R] C') (w : C ⊗[R] Q) (ξ : Dual R Q) :
    tensorEquivDualHom C' Q (g.rTensor Q w) ξ = g (tensorEquivDualHom C Q w ξ) := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul c q => simp
  | add x y hx hy => simp [hx, hy]

variable (P : Type*) [AddCommGroup P] [Module R P]

/-- For `Q` finite projective, `Hom_R(P ⊗ Q^∨, C) ≃ Hom_R(P, C ⊗ Q)`. -/
def homTensorDualEquiv : (P ⊗[R] Dual R Q →ₗ[R] C) ≃ₗ[R] (P →ₗ[R] C ⊗[R] Q) :=
  (TensorProduct.lift.equiv (RingHom.id R) P (Dual R Q) C).symm ≪≫ₗ
    LinearEquiv.congrRight (tensorEquivDualHom C Q).symm

variable {C Q P}

/-- The characterizing property of `homTensorDualEquiv`: the `ξ`-coordinate of the image of `p`
is `ψ (p ⊗ ξ)`. -/
@[simp]
theorem tensorEquivDualHom_homTensorDualEquiv (ψ : P ⊗[R] Dual R Q →ₗ[R] C) (p : P)
    (ξ : Dual R Q) : tensorEquivDualHom C Q (homTensorDualEquiv C Q P ψ p) ξ = ψ (p ⊗ₜ ξ) := by
  show tensorEquivDualHom C Q ((tensorEquivDualHom C Q).symm
    ((lift.equiv (RingHom.id R) P (Dual R Q) C).symm ψ p)) ξ = _
  rw [LinearEquiv.apply_symm_apply]
  rfl

/-- `homTensorDualEquiv` is natural in `C`. -/
theorem homTensorDualEquiv_comp {C' : Type*} [AddCommGroup C'] [Module R C'] (g : C →ₗ[R] C')
    (ψ : P ⊗[R] Dual R Q →ₗ[R] C) :
    homTensorDualEquiv C' Q P (g ∘ₗ ψ) = g.rTensor Q ∘ₗ homTensorDualEquiv C Q P ψ := by
  ext p
  apply (tensorEquivDualHom C' Q).injective
  ext ξ
  simp [tensorEquivDualHom_rTensor]

end Coordinates

/-! ### The ideal of coordinates of a family of elements of `A ⊗[R] Q` -/

section CoordIdeal

variable {R : Type*} [CommRing R] {A : Type*} [CommRing A] [Algebra R A]
  {Q : Type*} [AddCommGroup Q] [Module R Q] [Module.Finite R Q] [Module.Projective R Q]

/-- The ideal of `A` generated by all coordinates `ξ (z i)`, `ξ ∈ Q^∨`, of a family `z` of
elements of `A ⊗[R] Q`. -/
def dualCoordIdeal {ι : Type*} (z : ι → A ⊗[R] Q) : Ideal A :=
  Ideal.span (Set.range fun p : ι × Dual R Q => tensorEquivDualHom A Q (z p.1) p.2)

/-- An algebra map `φ : A → C` kills `dualCoordIdeal z` iff it kills every `z i` after base
change. -/
theorem dualCoordIdeal_le_ker_iff {ι : Type*} (z : ι → A ⊗[R] Q) {C : Type*} [CommRing C]
    [Algebra R C] (φ : A →ₐ[R] C) :
    dualCoordIdeal z ≤ RingHom.ker φ ↔ ∀ i, φ.toLinearMap.rTensor Q (z i) = 0 := by
  rw [dualCoordIdeal, Ideal.span_le]
  simp only [Set.range_subset_iff, Prod.forall, SetLike.mem_coe, RingHom.mem_ker]
  refine forall_congr' fun i => ?_
  rw [← (tensorEquivDualHom C Q).map_eq_zero_iff, LinearMap.ext_iff]
  simp [tensorEquivDualHom_rTensor]

end CoordIdeal

/-- A graded multiplication datum over `R`: modules `piece n`, bilinear multiplications and a unit;
no axioms are imposed. -/
structure GradedMulDatum (R : Type u) [CommRing R] where
  /-- The degree `n` piece. -/
  piece : ℕ → Type u
  /-- The additive group structure on each piece. -/
  [addCommGroup : ∀ n, AddCommGroup (piece n)]
  /-- The `R`-module structure on each piece. -/
  [module : ∀ n, Module R (piece n)]
  /-- The multiplication `piece i × piece j → piece (i + j)`. -/
  mul : ∀ i j, piece i →ₗ[R] piece j →ₗ[R] piece (i + j)
  /-- The unit, in degree `0`. -/
  one : piece 0

attribute [instance] GradedMulDatum.addCommGroup GradedMulDatum.module

namespace GradedMulDatum

variable {R : Type u} [CommRing R]

/-- Homomorphisms of graded multiplication data. -/
@[ext]
structure Hom (M N : GradedMulDatum R) where
  /-- The degree `n` component. -/
  app : ∀ n, M.piece n →ₗ[R] N.piece n
  /-- Compatibility with the multiplications. -/
  app_mul : ∀ i j (a : M.piece i) (b : M.piece j),
    app (i + j) (M.mul i j a b) = N.mul i j (app i a) (app j b)
  /-- Compatibility with the units. -/
  app_one : app 0 M.one = N.one

/-- Isomorphisms: a pair of mutually inverse homomorphisms. -/
structure Iso (M N : GradedMulDatum R) where
  /-- The forward homomorphism. -/
  hom : Hom M N
  /-- The inverse homomorphism. -/
  inv : Hom N M
  /-- `inv` is left inverse to `hom`. -/
  hom_inv : ∀ n x, inv.app n (hom.app n x) = x
  /-- `inv` is right inverse to `hom`. -/
  inv_hom : ∀ n y, hom.app n (inv.app n y) = y

namespace Hom

variable {M N P : GradedMulDatum R}

/-- The identity homomorphism. -/
def id (M : GradedMulDatum R) : Hom M M where
  app _ := LinearMap.id
  app_mul _ _ _ _ := rfl
  app_one := rfl

/-- The components of the identity. -/
@[simp]
theorem id_app (M : GradedMulDatum R) (n : ℕ) (x : M.piece n) : (Hom.id M).app n x = x := rfl

/-- Composition of homomorphisms (`g` after `f`). -/
def comp (g : Hom N P) (f : Hom M N) : Hom M P where
  app n := g.app n ∘ₗ f.app n
  app_mul i j a b := by simp [f.app_mul, g.app_mul]
  app_one := by simp [f.app_one, g.app_one]

/-- The components of a composition. -/
@[simp]
theorem comp_app (g : Hom N P) (f : Hom M N) (n : ℕ) (x : M.piece n) :
    (g.comp f).app n x = g.app n (f.app n x) := rfl

end Hom

namespace Iso

variable {M N : GradedMulDatum R}

/-- An isomorphism is determined by its forward homomorphism. -/
theorem ext {e e' : Iso M N} (h : e.hom = e'.hom) : e = e' := by
  obtain ⟨f, g, h1, h2⟩ := e
  obtain ⟨f', g', h1', h2'⟩ := e'
  obtain rfl : f = f' := h
  obtain rfl : g = g' := by
    ext n y
    exact (congrArg (g.app n) (h2' n y)).symm.trans (h1 n _)
  rfl

/-- A homomorphism which is bijective in every degree is an isomorphism. -/
def ofBijective (f : Hom M N) (hf : ∀ n, Function.Bijective (f.app n)) : Iso M N where
  hom := f
  inv :=
    { app n := (LinearEquiv.ofBijective (f.app n) (hf n)).symm.toLinearMap
      app_mul i j a b := by
        apply (hf (i + j)).1
        simp only [LinearEquiv.coe_coe, f.app_mul]
        simp
      app_one := by
        apply (hf 0).1
        simp [f.app_one] }
  hom_inv n x := by simp
  inv_hom n y := by simp

/-- The forward homomorphism of `Iso.ofBijective f hf` is `f`. -/
@[simp]
theorem ofBijective_hom (f : Hom M N) (hf : ∀ n, Function.Bijective (f.app n)) :
    (ofBijective f hf).hom = f := rfl

end Iso

section BaseChange

variable {C P P' X : Type*} [CommRing C] [Algebra R C] [AddCommGroup P] [Module R P]
  [AddCommGroup P'] [Module R P'] [AddCommGroup X] [Module R X]

variable (C) in
/-- The base change `C ⊗ P → C ⊗ P' → C ⊗ X` of an `R`-bilinear map `P → P' → X`. -/
def bilinBaseChange (m : P →ₗ[R] P' →ₗ[R] X) :
    C ⊗[R] P →ₗ[C] C ⊗[R] P' →ₗ[C] C ⊗[R] X :=
  LinearMap.liftBaseChange C (LinearMap.baseChangeHom R C P' X) ∘ₗ m.baseChange C

/-- `bilinBaseChange` on pure tensors. -/
@[simp]
theorem bilinBaseChange_tmul (m : P →ₗ[R] P' →ₗ[R] X) (c c' : C) (a : P) (b : P') :
    bilinBaseChange C m (c ⊗ₜ a) (c' ⊗ₜ b) = (c * c') ⊗ₜ m a b := by
  simp [bilinBaseChange, smul_tmul']

end BaseChange

variable (M : GradedMulDatum R)

/-- Base change along an `R`-algebra `C`.

It is `implicit_reducible`, so that elements such as `1 ⊗ₜ m` are accepted as elements of
`(M.baseChange C).piece n` by `simp` and `rw`, while `(M.baseChange C).piece n` is kept in
discrimination-tree keys (so general lemmas about `Hom` apply to base changes). -/
@[implicit_reducible]
def baseChange (C : Type u) [CommRing C] [Algebra R C] : GradedMulDatum C where
  piece n := C ⊗[R] M.piece n
  mul i j := bilinBaseChange C (M.mul i j)
  one := 1 ⊗ₜ M.one

/-- The multiplication of `M.baseChange C` on pure tensors. -/
@[simp]
theorem baseChange_mul_tmul (C : Type u) [CommRing C] [Algebra R C] (i j : ℕ) (c c' : C)
    (a : M.piece i) (b : M.piece j) :
    (M.baseChange C).mul i j (c ⊗ₜ a) (c' ⊗ₜ b) = (c * c') ⊗ₜ M.mul i j a b :=
  bilinBaseChange_tmul (M.mul i j) c c' a b

section Data

variable {M N : GradedMulDatum R} {A C : Type u} [CommRing A] [Algebra R A] [CommRing C]
  [Algebra R C]

/-- Two homomorphisms between base changes agreeing on all `1 ⊗ₜ m` are equal. -/
theorem Hom.baseChange_ext {F G : Hom (M.baseChange C) (N.baseChange C)}
    (h : ∀ n (m : M.piece n), F.app n (1 ⊗ₜ m) = G.app n (1 ⊗ₜ m)) : F = G := by
  apply Hom.ext
  funext n
  exact (LinearMap.liftBaseChangeEquiv (M := M.piece n) (N := C ⊗[R] N.piece n) C).symm.injective
    (LinearMap.ext (h n))

/-- The defect of multiplicativity of a family `f n : M n → C ⊗ N n`: the element
`f (a * b) - f a * f b` of `C ⊗ N (i + j)`. -/
def mulDefect (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n) (i j : ℕ) (a : M.piece i)
    (b : M.piece j) : C ⊗[R] N.piece (i + j) :=
  f (i + j) (M.mul i j a b) - bilinBaseChange C (N.mul i j) (f i a) (f j b)

/-- The defect of unitality of a family `f n : M n → C ⊗ N n`: the element `f 1 - 1`. -/
def oneDefect (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n) : C ⊗[R] N.piece 0 :=
  f 0 M.one - 1 ⊗ₜ N.one

/-- The defect of `g` being left inverse to `f`: the element `(1 ⊗ g)(f x) - 1 ⊗ x`. -/
def compDefect (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) (n : ℕ) (x : M.piece n) : C ⊗[R] M.piece n :=
  (g n).liftBaseChange C (f n x) - 1 ⊗ₜ x

/-- The conditions on a pair of families `f n : M n → C ⊗ N n`, `g n : N n → C ⊗ M n` for their
`C`-linear extensions to be mutually inverse isomorphisms of graded multiplication data. -/
def IsIsoData (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) : Prop :=
  (∀ i j a b, mulDefect f i j a b = 0) ∧ oneDefect f = 0 ∧
    (∀ i j a b, mulDefect g i j a b = 0) ∧ oneDefect g = 0 ∧
    (∀ n x, compDefect f g n x = 0) ∧ ∀ n y, compDefect g f n y = 0

/-- The homomorphism `M_C → N_C` obtained by `C`-linear extension of a family satisfying the
multiplicativity and unitality conditions. -/
def homOfData (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (hmul : ∀ i j a b, mulDefect f i j a b = 0) (hone : oneDefect f = 0) :
    Hom (M.baseChange C) (N.baseChange C) where
  app n := ((f n).liftBaseChange C : C ⊗[R] M.piece n →ₗ[C] C ⊗[R] N.piece n)
  app_mul i j := by
    have key : (bilinBaseChange C (M.mul i j)).compr₂ ((f (i + j)).liftBaseChange C) =
        (bilinBaseChange C (N.mul i j)).compl₁₂ ((f i).liftBaseChange C)
          ((f j).liftBaseChange C) := by
      ext a b
      simpa [sub_eq_zero, mulDefect] using hmul i j a b
    exact fun a b => LinearMap.congr_fun₂ key a b
  app_one := (LinearMap.liftBaseChange_one_tmul C (f 0) M.one).trans (sub_eq_zero.1 hone)

/-- The isomorphism `M_C ≅ N_C` defined by a pair of families satisfying `IsIsoData`. -/
def isoOfData (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) (h : IsIsoData f g) :
    Iso (M.baseChange C) (N.baseChange C) where
  hom := homOfData f h.1 h.2.1
  inv := homOfData g h.2.2.1 h.2.2.2.1
  hom_inv n := by
    have key : (g n).liftBaseChange C ∘ₗ (f n).liftBaseChange C = LinearMap.id := by
      ext x
      simpa [sub_eq_zero, compDefect] using h.2.2.2.2.1 n x
    exact fun x => LinearMap.congr_fun key x
  inv_hom n := by
    have key : (f n).liftBaseChange C ∘ₗ (g n).liftBaseChange C = LinearMap.id := by
      ext y
      simpa [sub_eq_zero, compDefect] using h.2.2.2.2.2 n y
    exact fun y => LinearMap.congr_fun key y

/-- The forward map of `isoOfData f g h` on `1 ⊗ₜ m` is `f n m`. -/
@[simp]
theorem isoOfData_hom_app_one_tmul (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) (h : IsIsoData f g) (n : ℕ) (m : M.piece n) :
    (isoOfData f g h).hom.app n (1 ⊗ₜ m) = f n m :=
  LinearMap.liftBaseChange_one_tmul C (f n) m

/-- The inverse map of `isoOfData f g h` on `1 ⊗ₜ m` is `g n m`. -/
@[simp]
theorem isoOfData_inv_app_one_tmul (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) (h : IsIsoData f g) (n : ℕ) (m : N.piece n) :
    (isoOfData f g h).inv.app n (1 ⊗ₜ m) = g n m :=
  LinearMap.liftBaseChange_one_tmul C (g n) m

/-- The family `m ↦ F (1 ⊗ m)` of `R`-linear maps underlying a homomorphism of base changes. -/
def homData (F : Hom (M.baseChange C) (N.baseChange C)) (n : ℕ) :
    M.piece n →ₗ[R] C ⊗[R] N.piece n :=
  let F' : C ⊗[R] M.piece n →ₗ[C] C ⊗[R] N.piece n := F.app n
  (LinearMap.liftBaseChangeEquiv C).symm F'

/-- `homData F n m` is `F (1 ⊗ₜ m)`. -/
theorem homData_apply (F : Hom (M.baseChange C) (N.baseChange C)) (n : ℕ) (m : M.piece n) :
    homData F n m = F.app n (1 ⊗ₜ m) := rfl

/-- `F` is recovered from `homData F` by `C`-linear extension. -/
theorem liftBaseChange_homData (F : Hom (M.baseChange C) (N.baseChange C)) (n : ℕ) :
    (homData F n).liftBaseChange C = F.app n :=
  (LinearMap.liftBaseChangeEquiv C).apply_symm_apply _

/-- The families underlying a homomorphism of base changes are multiplicative and unital. -/
private theorem mulDefect_oneDefect_homData (F : Hom (M.baseChange C) (N.baseChange C)) :
    (∀ i j a b, mulDefect (homData F) i j a b = 0) ∧ oneDefect (homData F) = 0 := by
  refine ⟨fun i j a b => ?_, sub_eq_zero.2 F.app_one⟩
  have := F.app_mul i j (1 ⊗ₜ a) (1 ⊗ₜ b)
  rw [baseChange_mul_tmul, mul_one] at this
  exact sub_eq_zero.2 this

/-- The families underlying an isomorphism of base changes satisfy `IsIsoData`. -/
theorem isIsoData_homData (I : Iso (M.baseChange C) (N.baseChange C)) :
    IsIsoData (homData I.hom) (homData I.inv) := by
  refine ⟨(mulDefect_oneDefect_homData I.hom).1, (mulDefect_oneDefect_homData I.hom).2,
    (mulDefect_oneDefect_homData I.inv).1, (mulDefect_oneDefect_homData I.inv).2,
    fun n x => ?_, fun n y => ?_⟩
  · rw [compDefect, liftBaseChange_homData, sub_eq_zero]
    exact I.hom_inv n _
  · rw [compDefect, liftBaseChange_homData, sub_eq_zero]
    exact I.inv_hom n _

/-- Pushing a family `f n : M n → A ⊗ N n` forward along an algebra map `A → C`. -/
def pushData (φ : A →ₐ[R] C) (f : ∀ n, M.piece n →ₗ[R] A ⊗[R] N.piece n) (n : ℕ) :
    M.piece n →ₗ[R] C ⊗[R] N.piece n :=
  φ.toLinearMap.rTensor (N.piece n) ∘ₗ f n

/-- `pushData` evaluated at an element. -/
theorem pushData_apply (φ : A →ₐ[R] C) (f : ∀ n, M.piece n →ₗ[R] A ⊗[R] N.piece n) (n : ℕ)
    (m : M.piece n) : pushData φ f n m = φ.toLinearMap.rTensor (N.piece n) (f n m) := rfl

/-- Pushing forward along a composite is pushing forward twice. -/
theorem pushData_comp {C' : Type u} [CommRing C'] [Algebra R C'] (ψ : C →ₐ[R] C')
    (φ : A →ₐ[R] C) (f : ∀ n, M.piece n →ₗ[R] A ⊗[R] N.piece n) :
    pushData (ψ.comp φ) f = pushData ψ (pushData φ f) := by
  funext n
  simp [pushData, AlgHom.comp_toLinearMap, LinearMap.rTensor_comp, LinearMap.comp_assoc]

section Naturality

variable {Q P P' X : Type*} [AddCommGroup Q] [Module R Q] [AddCommGroup P] [Module R P]
  [AddCommGroup P'] [Module R P'] [AddCommGroup X] [Module R X]

/-- Base change of `A ⊗ Q` along an algebra map `φ : A → C` is `φ`-semilinear. -/
theorem rTensor_algHom_smul (φ : A →ₐ[R] C) (a : A) (x : A ⊗[R] Q) :
    φ.toLinearMap.rTensor Q (a • x) = φ a • φ.toLinearMap.rTensor Q x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a' q => simp [smul_tmul']
  | add x y hx hy => simp [smul_add, hx, hy]

/-- `bilinBaseChange` commutes with base change along an algebra map. -/
theorem rTensor_bilinBaseChange (φ : A →ₐ[R] C) (m : P →ₗ[R] P' →ₗ[R] X) (x : A ⊗[R] P)
    (y : A ⊗[R] P') : φ.toLinearMap.rTensor X (bilinBaseChange A m x y) =
      bilinBaseChange C m (φ.toLinearMap.rTensor P x) (φ.toLinearMap.rTensor P' y) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x x' hx hx' => simp [hx, hx']
  | tmul a p =>
    induction y using TensorProduct.induction_on with
    | zero => simp
    | add y y' hy hy' => simp [hy, hy']
    | tmul a' p' => simp

/-- `LinearMap.liftBaseChange` commutes with base change along an algebra map. -/
theorem rTensor_liftBaseChange (φ : A →ₐ[R] C) (h : P →ₗ[R] A ⊗[R] Q) (w : A ⊗[R] P) :
    φ.toLinearMap.rTensor Q (h.liftBaseChange A w) =
      (φ.toLinearMap.rTensor Q ∘ₗ h).liftBaseChange C (φ.toLinearMap.rTensor P w) := by
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul a p => simp [rTensor_algHom_smul]
  | add x y hx hy => simp [hx, hy]

end Naturality

/-- `mulDefect` is natural in the algebra. -/
theorem rTensor_mulDefect (φ : A →ₐ[R] C) (f : ∀ n, M.piece n →ₗ[R] A ⊗[R] N.piece n)
    (i j : ℕ) (a : M.piece i) (b : M.piece j) :
    φ.toLinearMap.rTensor _ (mulDefect f i j a b) = mulDefect (pushData φ f) i j a b := by
  simp [mulDefect, pushData_apply, rTensor_bilinBaseChange]

/-- `oneDefect` is natural in the algebra. -/
theorem rTensor_oneDefect (φ : A →ₐ[R] C) (f : ∀ n, M.piece n →ₗ[R] A ⊗[R] N.piece n) :
    φ.toLinearMap.rTensor _ (oneDefect f) = oneDefect (pushData φ f) := by
  simp [oneDefect, pushData_apply]

/-- `compDefect` is natural in the algebra. -/
theorem rTensor_compDefect (φ : A →ₐ[R] C) (f : ∀ n, M.piece n →ₗ[R] A ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] A ⊗[R] M.piece n) (n : ℕ) (x : M.piece n) :
    φ.toLinearMap.rTensor _ (compDefect f g n x) =
      compDefect (pushData φ f) (pushData φ g) n x := by
  simp [compDefect, rTensor_liftBaseChange, pushData]

end Data

end GradedMulDatum

open GradedMulDatum

section Construction

variable {R : Type u} [CommRing R] (M N : GradedMulDatum R)
  [∀ n, Module.Finite R (M.piece n)] [∀ n, Module.Projective R (M.piece n)]
  [∀ n, Module.Finite R (N.piece n)] [∀ n, Module.Projective R (N.piece n)]

/-- The degree `n` part `(M n ⊗ (N n)^∨) × (N n ⊗ (M n)^∨)` of the module of generators of the
Isom algebra. -/
abbrev isomGeneratorsPiece (n : ℕ) : Type u :=
  (M.piece n ⊗[R] Dual R (N.piece n)) × (N.piece n ⊗[R] Dual R (M.piece n))

/-- The module of generators `⨁ n, (M n ⊗ (N n)^∨) × (N n ⊗ (M n)^∨)` of the Isom algebra. -/
abbrev isomGenerators : Type u :=
  DirectSum ℕ (isomGeneratorsPiece M N)

/-- The free algebra `Sym (⨁ n, (M n ⊗ (N n)^∨) × (N n ⊗ (M n)^∨))`, corepresenting pairs of
families of linear maps `M n → C ⊗ N n`, `N n → C ⊗ M n`. -/
abbrev isomFreeAlgebra : Type u :=
  SymmetricAlgebra R (isomGenerators M N)

/-- The universal family `M n → isomFreeAlgebra ⊗ N n`. -/
def univHom (n : ℕ) : M.piece n →ₗ[R] isomFreeAlgebra M N ⊗[R] N.piece n :=
  homTensorDualEquiv _ _ _ (SymmetricAlgebra.ι R (isomGenerators M N) ∘ₗ
    DirectSum.lof R ℕ (isomGeneratorsPiece M N) n ∘ₗ LinearMap.inl R _ _)

/-- The universal family `N n → isomFreeAlgebra ⊗ M n`. -/
def univInv (n : ℕ) : N.piece n →ₗ[R] isomFreeAlgebra M N ⊗[R] M.piece n :=
  homTensorDualEquiv _ _ _ (SymmetricAlgebra.ι R (isomGenerators M N) ∘ₗ
    DirectSum.lof R ℕ (isomGeneratorsPiece M N) n ∘ₗ LinearMap.inr R _ _)

variable {M N} {C : Type u} [CommRing C] [Algebra R C]

/-- The algebra map out of `isomFreeAlgebra` classifying a pair of families. -/
def freeLift (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) : isomFreeAlgebra M N →ₐ[R] C :=
  SymmetricAlgebra.lift <| DirectSum.toModule R ℕ C fun n =>
    ((homTensorDualEquiv C _ _).symm (f n)).coprod ((homTensorDualEquiv C _ _).symm (g n))

/-- `freeLift f g` pushes the universal family `univHom` forward to `f`. -/
theorem pushData_freeLift_univHom (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) :
    pushData (freeLift f g) (univHom M N) = f := by
  funext n
  rw [pushData, univHom, ← homTensorDualEquiv_comp, ← LinearEquiv.eq_symm_apply]
  exact LinearMap.ext fun x => by simp [freeLift]

/-- `freeLift f g` pushes the universal family `univInv` forward to `g`. -/
theorem pushData_freeLift_univInv (f : ∀ n, M.piece n →ₗ[R] C ⊗[R] N.piece n)
    (g : ∀ n, N.piece n →ₗ[R] C ⊗[R] M.piece n) :
    pushData (freeLift f g) (univInv M N) = g := by
  funext n
  rw [pushData, univInv, ← homTensorDualEquiv_comp, ← LinearEquiv.eq_symm_apply]
  exact LinearMap.ext fun x => by simp [freeLift]

/-- Algebra maps agreeing on the coordinates `homTensorDualEquiv A Q P u` agree on `u`. -/
private theorem comp_eq_of_rTensor_comp_eq {A Q P : Type*} [CommRing A] [Algebra R A]
    [AddCommGroup Q] [Module R Q] [Module.Finite R Q] [Module.Projective R Q]
    [AddCommGroup P] [Module R P] (φ φ' : A →ₐ[R] C) (u : P ⊗[R] Dual R Q →ₗ[R] A)
    (h : φ.toLinearMap.rTensor Q ∘ₗ homTensorDualEquiv A Q P u =
      φ'.toLinearMap.rTensor Q ∘ₗ homTensorDualEquiv A Q P u) :
    φ.toLinearMap ∘ₗ u = φ'.toLinearMap ∘ₗ u := by
  rw [← homTensorDualEquiv_comp, ← homTensorDualEquiv_comp] at h
  exact (homTensorDualEquiv _ _ _).injective h

/-- An algebra map out of `isomFreeAlgebra` is determined by its push-forwards of the universal
families. -/
theorem freeAlgHom_ext {φ φ' : isomFreeAlgebra M N →ₐ[R] C}
    (h₁ : pushData φ (univHom M N) = pushData φ' (univHom M N))
    (h₂ : pushData φ (univInv M N) = pushData φ' (univInv M N)) : φ = φ' := by
  apply SymmetricAlgebra.algHom_ext
  apply DirectSum.linearMap_ext R
  intro n
  apply LinearMap.prod_ext
  · exact comp_eq_of_rTensor_comp_eq φ φ' _ (congrFun h₁ n)
  · exact comp_eq_of_rTensor_comp_eq φ φ' _ (congrFun h₂ n)

variable (M N) in
/-- The ideal of `isomFreeAlgebra` generated by the coordinates of all defects of the universal
families: its quotient corepresents isomorphisms of base changes. -/
def isomIdeal : Ideal (isomFreeAlgebra M N) :=
  (⨆ i, ⨆ j, dualCoordIdeal fun ab : M.piece i × M.piece j =>
      mulDefect (univHom M N) i j ab.1 ab.2) ⊔
    dualCoordIdeal (fun _ : Unit => oneDefect (univHom M N)) ⊔
    (⨆ i, ⨆ j, dualCoordIdeal fun ab : N.piece i × N.piece j =>
      mulDefect (univInv M N) i j ab.1 ab.2) ⊔
    dualCoordIdeal (fun _ : Unit => oneDefect (univInv M N)) ⊔
    (⨆ n, dualCoordIdeal (compDefect (univHom M N) (univInv M N) n)) ⊔
    (⨆ n, dualCoordIdeal (compDefect (univInv M N) (univHom M N) n))

/-- An algebra map out of `isomFreeAlgebra` kills `isomIdeal` iff its push-forwards of the
universal families satisfy `IsIsoData`. -/
theorem isomIdeal_le_ker_iff (φ : isomFreeAlgebra M N →ₐ[R] C) :
    isomIdeal M N ≤ RingHom.ker φ ↔
      IsIsoData (pushData φ (univHom M N)) (pushData φ (univInv M N)) := by
  simp only [isomIdeal, sup_le_iff, iSup_le_iff, dualCoordIdeal_le_ker_iff, rTensor_mulDefect,
    rTensor_oneDefect, rTensor_compDefect, Prod.forall, forall_const, IsIsoData, and_assoc]

variable (M N) in
/-- The Isom algebra: the quotient of `isomFreeAlgebra` by `isomIdeal`. -/
abbrev isomAlgebra : Type u :=
  isomFreeAlgebra M N ⧸ isomIdeal M N

/-- The families classified by an algebra map out of the Isom algebra satisfy `IsIsoData`. -/
theorem isIsoData_pushData_comp_mkₐ (φ : isomAlgebra M N →ₐ[R] C) :
    IsIsoData (pushData (φ.comp (Ideal.Quotient.mkₐ R (isomIdeal M N))) (univHom M N))
      (pushData (φ.comp (Ideal.Quotient.mkₐ R (isomIdeal M N))) (univInv M N)) := by
  rw [← isomIdeal_le_ker_iff]
  intro x hx
  simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem.2 hx]

/-- The isomorphism of base changes classified by an algebra map out of the Isom algebra. -/
def isoOfAlgHom (φ : isomAlgebra M N →ₐ[R] C) : Iso (M.baseChange C) (N.baseChange C) :=
  isoOfData _ _ (isIsoData_pushData_comp_mkₐ φ)

/-- The forward map of `isoOfAlgHom φ` on `1 ⊗ₜ m`. -/
@[simp]
theorem isoOfAlgHom_hom_app_one_tmul (φ : isomAlgebra M N →ₐ[R] C) (n : ℕ) (m : M.piece n) :
    (isoOfAlgHom φ).hom.app n (1 ⊗ₜ m) =
      pushData (φ.comp (Ideal.Quotient.mkₐ R (isomIdeal M N))) (univHom M N) n m :=
  isoOfData_hom_app_one_tmul ..

/-- The inverse map of `isoOfAlgHom φ` on `1 ⊗ₜ m`. -/
@[simp]
theorem isoOfAlgHom_inv_app_one_tmul (φ : isomAlgebra M N →ₐ[R] C) (n : ℕ) (m : N.piece n) :
    (isoOfAlgHom φ).inv.app n (1 ⊗ₜ m) =
      pushData (φ.comp (Ideal.Quotient.mkₐ R (isomIdeal M N))) (univInv M N) n m :=
  isoOfData_inv_app_one_tmul ..

/-- Algebra maps out of the Isom algebra correspond bijectively to isomorphisms of base
changes. -/
theorem isoOfAlgHom_bijective :
    Function.Bijective (isoOfAlgHom : (isomAlgebra M N →ₐ[R] C) → _) := by
  constructor
  · intro φ φ' h
    apply Ideal.Quotient.algHom_ext R
    apply freeAlgHom_ext
    · exact funext fun n => LinearMap.ext fun m => by
        simpa using congrArg (fun I : Iso _ _ => I.hom.app n (1 ⊗ₜ m)) h
    · exact funext fun n => LinearMap.ext fun m => by
        simpa using congrArg (fun I : Iso _ _ => I.inv.app n (1 ⊗ₜ m)) h
  · intro I
    have hker : isomIdeal M N ≤ RingHom.ker (freeLift (homData I.hom) (homData I.inv)) := by
      rw [isomIdeal_le_ker_iff, pushData_freeLift_univHom, pushData_freeLift_univInv]
      exact isIsoData_homData I
    refine ⟨Ideal.Quotient.liftₐ (isomIdeal M N) _ fun a ha => RingHom.mem_ker.1 (hker ha), ?_⟩
    apply Iso.ext
    apply Hom.baseChange_ext
    intro n m
    refine (isoOfAlgHom_hom_app_one_tmul _ n m).trans ?_
    rw [Ideal.Quotient.liftₐ_comp, pushData_freeLift_univHom]
    rfl

variable (M N C) in
/-- The bijection between algebra maps out of the Isom algebra and isomorphisms of base
changes. -/
def isomEquiv : (isomAlgebra M N →ₐ[R] C) ≃ Iso (M.baseChange C) (N.baseChange C) :=
  Equiv.ofBijective _ isoOfAlgHom_bijective

variable (M N) in
/-- The Isom algebra has cardinality at most `max #R ℵ₀`. -/
theorem cardinalMk_isomAlgebra_le :
    Cardinal.mk (isomAlgebra M N) ≤ max (Cardinal.mk R) Cardinal.aleph0 := by
  have hfin : ∀ n, ∃ s : Set (isomGeneratorsPiece M N n), s.Finite ∧ Submodule.span R s = ⊤ :=
    fun n => by
      obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := R) (M := isomGeneratorsPiece M N n)
      exact ⟨s, s.finite_toSet, hs⟩
  choose s hs hspan using hfin
  let G : Set (isomGenerators M N) := ⋃ n, DirectSum.lof R ℕ _ n '' s n
  have hG : G.Countable := Set.countable_iUnion fun n => ((hs n).image _).countable
  have hspanG : Submodule.span R G = ⊤ := by
    rw [eq_top_iff]
    rintro v -
    induction v using DirectSum.induction_on with
    | zero => exact zero_mem _
    | of n x =>
      have hx : x ∈ Submodule.span R (s n) := hspan n ▸ Submodule.mem_top
      have := Submodule.mem_map_of_mem (f := DirectSum.lof R ℕ (isomGeneratorsPiece M N) n) hx
      rw [Submodule.map_span] at this
      rw [← DirectSum.lof_eq_of R]
      exact Submodule.span_mono
        (Set.subset_iUnion (fun n => DirectSum.lof R ℕ (isomGeneratorsPiece M N) n '' s n) n) this
    | add x y hx hy => exact add_mem hx hy
  have hadj : Algebra.adjoin R (SymmetricAlgebra.ι R _ '' G) = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    induction x using SymmetricAlgebra.induction with
    | algebraMap r => exact Subalgebra.algebraMap_mem _ r
    | ι v =>
      have hv : v ∈ Submodule.span R G := hspanG ▸ Submodule.mem_top
      induction hv using Submodule.span_induction with
      | mem x hx => exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
      | zero => simp [zero_mem]
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | smul r x _ hx => rw [map_smul]; exact Subalgebra.smul_mem _ hx r
    | mul a b ha hb => exact mul_mem ha hb
    | add a b ha hb => exact add_mem ha hb
  have hcount : Cardinal.mk (SymmetricAlgebra.ι R (isomGenerators M N) '' G) ≤
      Cardinal.aleph0 :=
    Cardinal.mk_le_aleph0_iff.2 (hG.image _).to_subtype
  have hfree : Cardinal.mk (isomFreeAlgebra M N) =
      Cardinal.mk (Algebra.adjoin R (SymmetricAlgebra.ι R _ '' G)) := by
    rw [hadj]
    exact (Cardinal.mk_congr Subalgebra.topEquiv.toEquiv).symm
  calc Cardinal.mk (isomAlgebra M N) ≤ Cardinal.mk (isomFreeAlgebra M N) :=
        Cardinal.mk_le_of_surjective Ideal.Quotient.mk_surjective
    _ ≤ _ := hfree.le.trans (Algebra.cardinalMk_adjoin_le R _)
    _ ≤ max (Cardinal.mk R) Cardinal.aleph0 :=
        max_le (max_le (le_max_left _ _) (hcount.trans (le_max_right _ _))) (le_max_right _ _)

end Construction

variable {R : Type u} [CommRing R] in
/-- **The Isom scheme of graded multiplication data.** For graded multiplication data `M`, `N`
over `R` with finite projective pieces, the functor `C ↦ Iso (M_C, N_C)` on `R`-algebras is
corepresented by an `R`-algebra `H` of cardinality at most `max #R ℵ₀`, naturally in `C`. -/
theorem exists_corepresenting (M N : GradedMulDatum R) [∀ n, Module.Finite R (M.piece n)]
    [∀ n, Module.Projective R (M.piece n)] [∀ n, Module.Finite R (N.piece n)]
    [∀ n, Module.Projective R (N.piece n)] :
    ∃ (H : Type u) (_ : CommRing H) (_ : Algebra R H)
      (e : ∀ (C : Type u) [CommRing C] [Algebra R C],
        (H →ₐ[R] C) ≃ Iso (M.baseChange C) (N.baseChange C)),
      Cardinal.mk H ≤ max (Cardinal.mk R) Cardinal.aleph0 ∧
      ∀ (C C' : Type u) [CommRing C] [Algebra R C] [CommRing C'] [Algebra R C'] (f : C →ₐ[R] C')
        (φ : H →ₐ[R] C) (n : ℕ),
        (∀ m : M.piece n, (e C' (f.comp φ)).hom.app n (1 ⊗ₜ m) =
          f.toLinearMap.rTensor (N.piece n) ((e C φ).hom.app n (1 ⊗ₜ m))) ∧
        (∀ m : N.piece n, (e C' (f.comp φ)).inv.app n (1 ⊗ₜ m) =
          f.toLinearMap.rTensor (M.piece n) ((e C φ).inv.app n (1 ⊗ₜ m))) := by
  refine ⟨isomAlgebra M N, inferInstance, inferInstance, fun C _ _ => isomEquiv M N C,
    cardinalMk_isomAlgebra_le M N, fun C C' _ _ _ _ f φ n => ⟨fun m => ?_, fun m => ?_⟩⟩
  all_goals simp [isomEquiv, AlgHom.comp_assoc, pushData_comp, pushData_apply]

end Stacks.GradedIsomScheme
