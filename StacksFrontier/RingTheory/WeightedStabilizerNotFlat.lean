module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Flat.TorsionFree
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Two stabilizer algebras over `k[s]` which are not flat

Let `k` be a nontrivial commutative ring (for instance a field) and write `k[s]` for the polynomial
ring `Polynomial k`, with `s = Polynomial.X`. For natural numbers `m` and `N` this file studies the
`k[s]`-algebras

```text
A    = k[s][t, t⁻¹] / (t^N - 1, s·(t^m - 1))
A_∞  = k[s][t, t⁻¹] / (s·(t^m - 1))
```

(`AlgebraicGeometry.PPowerWeighted.StabilizerAlgebra` and
`AlgebraicGeometry.PPowerWeighted.StabilizerAlgebraInfty`), where the Laurent polynomial ring is
Mathlib's `LaurentPolynomial k[s]` with `t = LaurentPolynomial.T 1`. With `m = p^a` and `N = p^b`
these are the stabilizer group schemes over the affine line of the `p`-power weighted examples:
the first corepresents, on `k[s]`-algebras `R`, the units `γ` of `R` with `γ^{p^b} = 1` and
`s·γ^{p^a} = s`, and the second the units with `s·γ^{p^a} = s`.

## Main definitions

* `AlgebraicGeometry.PPowerWeighted.laurentAlgHomEquivUnits`: algebra maps out of `A[t, t⁻¹]` are
  units, through the image of `t`.
* `AlgebraicGeometry.PPowerWeighted.quotientSpanAlgHomEquiv`: algebra maps out of the quotient by
  the ideal generated by a set are the algebra maps killing that set.
* `AlgebraicGeometry.PPowerWeighted.stabilizerAlgebraHomEquiv` and
  `AlgebraicGeometry.PPowerWeighted.stabilizerAlgebraInftyHomEquiv`: the functors of points of
  `A` and `A_∞`.

## Main results

* `AlgebraicGeometry.PPowerWeighted.not_flat_stabilizerAlgebra`: `A` is not flat over `k[s]` when
  `0 < m < N`, and `AlgebraicGeometry.PPowerWeighted.not_flat_stabilizerAlgebra_pow` for
  `m = p^a`, `N = p^b`, `1 < p`, `a < b`.
* `AlgebraicGeometry.PPowerWeighted.not_flat_stabilizerAlgebraInfty`: `A_∞` is not flat over
  `k[s]` when `0 < m`, and `AlgebraicGeometry.PPowerWeighted.not_flat_stabilizerAlgebraInfty_pow`
  for `m = p^a`, `1 < p`.

## Implementation notes

A flat module has no torsion by a nonzerodivisor (`Module.Flat.isSMulRegular_of_nonZeroDivisors`),
and `s` is a nonzerodivisor of `k[s]`. The class of `t^m - 1` is killed by `s`, so it suffices that
it is nonzero. That is checked after setting `s = 0`: for `A` in `k[t]/(t^N - 1)`
(`AdjoinRoot`), where `t^N - 1` is monic of degree `N` and so does not divide the nonzero
polynomial `t^m - 1` of smaller degree; for `A_∞` in `k[t, t⁻¹]` itself, where `t^m ≠ 1` because
`m ≠ 0`. The statements only need `k` nontrivial, which is weaker than the field the application
has.
-/

@[expose] public section

open Polynomial LaurentPolynomial

namespace AlgebraicGeometry.PPowerWeighted

/-! ### Algebra homomorphisms out of a ring of Laurent polynomials -/

section Laurent

variable (A : Type*) [CommRing A] (R : Type*) [CommRing R] [Algebra A R]

/-- **Algebra maps out of a ring of Laurent polynomials are units.** An `A`-algebra map
`A[t, t⁻¹] ⟶ R` is determined by the image of `t`, which is a unit, and every unit arises. This is
the universal property of the group algebra of `ℤ` (`AddMonoidAlgebra.lift`) followed by the
identification of monoid maps out of `Multiplicative ℤ` with their value at the generator. -/
@[ega "II 8.3.9" "Bijection Hom_Y(Z", sga "3 I 4.3.2" "partial", sga "3 I 4.4.1" "special case"]
noncomputable def laurentAlgHomEquivUnits : (A[T;T⁻¹] →ₐ[A] R) ≃ Rˣ :=
  (AddMonoidAlgebra.lift A R ℤ).symm.trans
    (MonoidHom.toHomUnitsMulEquiv.toEquiv.trans (zpowersHom Rˣ).symm)

/-- The unit attached to an algebra map out of `A[t, t⁻¹]` is the image of `t`. -/
theorem laurentAlgHomEquivUnits_apply_val (φ : A[T;T⁻¹] →ₐ[A] R) :
    (laurentAlgHomEquivUnits A R φ : R) = φ (T 1) :=
  rfl

/-- The algebra map attached to a unit `γ` sends `t^n` to `γ^n`. -/
theorem laurentAlgHomEquivUnits_symm_apply_T (γ : Rˣ) (n : ℤ) :
    (laurentAlgHomEquivUnits A R).symm γ (T n) = ((γ ^ n : Rˣ) : R) := by
  rw [T, laurentAlgHomEquivUnits, Equiv.symm_trans_apply, Equiv.symm_symm,
    AddMonoidAlgebra.lift_single, one_smul]
  rfl

end Laurent

/-! ### Algebra homomorphisms out of a quotient by the ideal generated by a set -/

section Quotient

variable {A : Type*} [CommRing A] {L : Type*} [CommRing L] [Algebra A L]
  (R : Type*) [CommRing R] [Algebra A R]

/-- **Algebra maps out of `L / (s)` are the algebra maps out of `L` killing `s`**, for a set `s`
of an `A`-algebra `L`: precomposition with the quotient map, inverted by
`Ideal.Quotient.liftₐ`. -/
noncomputable def quotientSpanAlgHomEquiv (s : Set L) :
    (L ⧸ Ideal.span s →ₐ[A] R) ≃ {φ : L →ₐ[A] R // ∀ x ∈ s, φ x = 0} where
  toFun f := ⟨f.comp (Ideal.Quotient.mkₐ A _), fun x hx => by
    rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
      Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span hx), map_zero]⟩
  invFun φ := Ideal.Quotient.liftₐ _ φ.1 fun a ha =>
    RingHom.mem_ker.1 ((Ideal.span_le (I := RingHom.ker (φ.1 : L →+* R))).2
      (fun x hx => RingHom.mem_ker.2 (φ.2 x hx)) ha)
  left_inv f := Ideal.Quotient.algHom_ext A (Ideal.Quotient.liftₐ_comp _ _ _)
  right_inv φ := Subtype.ext (Ideal.Quotient.liftₐ_comp _ _ _)

end Quotient

/-! ### The stabilizer algebras -/

variable (k : Type*) [CommRing k]

/-- The ideal `(t^N - 1, s·(t^m - 1))` of `k[s][t, t⁻¹]`. -/
noncomputable def stabilizerIdeal (m N : ℕ) : Ideal (LaurentPolynomial k[X]) :=
  Ideal.span {T (N : ℤ) - 1, LaurentPolynomial.C (Polynomial.X : k[X]) * (T (m : ℤ) - 1)}

/-- **The stabilizer algebra** `k[s][t, t⁻¹] / (t^N - 1, s·(t^m - 1))`, a `k[s]`-algebra. With
`m = p^a`, `N = p^b` it corepresents the units `γ` with `γ^{p^b} = 1` and `s·γ^{p^a} = s`
(`AlgebraicGeometry.PPowerWeighted.stabilizerAlgebraHomEquiv`). -/
abbrev StabilizerAlgebra (m N : ℕ) : Type _ :=
  LaurentPolynomial k[X] ⧸ stabilizerIdeal k m N

/-- The ideal `(s·(t^m - 1))` of `k[s][t, t⁻¹]`. -/
noncomputable def stabilizerIdealInfty (m : ℕ) : Ideal (LaurentPolynomial k[X]) :=
  Ideal.span {LaurentPolynomial.C (Polynomial.X : k[X]) * (T (m : ℤ) - 1)}

/-- **The stabilizer algebra** `k[s][t, t⁻¹] / (s·(t^m - 1))`, a `k[s]`-algebra. It corepresents
the units `γ` with `s·γ^m = s`
(`AlgebraicGeometry.PPowerWeighted.stabilizerAlgebraInftyHomEquiv`). -/
abbrev StabilizerAlgebraInfty (m : ℕ) : Type _ :=
  LaurentPolynomial k[X] ⧸ stabilizerIdealInfty k m

section Corepresent

variable {k} (R : Type*) [CommRing R] [Algebra k[X] R]

/-- An algebra map out of `k[s][t, t⁻¹]` sends `t^n` to the `n`-th power of its unit. -/
theorem laurentAlgHom_T_natCast (φ : LaurentPolynomial k[X] →ₐ[k[X]] R) (n : ℕ) :
    φ (T (n : ℤ)) = ((laurentAlgHomEquivUnits k[X] R φ ^ n : Rˣ) : R) := by
  rw [Units.val_pow_eq_pow_val, laurentAlgHomEquivUnits_apply_val, ← map_pow, T_pow, mul_one]

/-- An algebra map out of `k[s][t, t⁻¹]` over `k[s]` sends the constant `s` to the image of `s`. -/
theorem laurentAlgHom_C_X (φ : LaurentPolynomial k[X] →ₐ[k[X]] R) :
    φ (LaurentPolynomial.C (Polynomial.X : k[X])) = algebraMap k[X] R Polynomial.X := by
  rw [LaurentPolynomial.C_eq_algebraMap]
  exact φ.commutes _

/-- An algebra map out of `k[s][t, t⁻¹]` kills `s·(t^m - 1)` exactly when its unit `γ` has
`s·γ^m = s`. -/
theorem laurentAlgHom_relation_iff (φ : LaurentPolynomial k[X] →ₐ[k[X]] R) (m : ℕ) :
    φ (LaurentPolynomial.C (Polynomial.X : k[X]) * (T (m : ℤ) - 1)) = 0 ↔
      algebraMap k[X] R Polynomial.X * ((laurentAlgHomEquivUnits k[X] R φ ^ m : Rˣ) : R) =
        algebraMap k[X] R Polynomial.X := by
  rw [map_mul, map_sub, map_one, laurentAlgHom_C_X, laurentAlgHom_T_natCast, mul_sub, mul_one,
    sub_eq_zero]

/-- An algebra map out of `k[s][t, t⁻¹]` kills `t^N - 1` exactly when its unit `γ` has
`γ^N = 1`. -/
theorem laurentAlgHom_root_iff (φ : LaurentPolynomial k[X] →ₐ[k[X]] R) (N : ℕ) :
    φ (T (N : ℤ) - 1) = 0 ↔ laurentAlgHomEquivUnits k[X] R φ ^ N = 1 := by
  rw [map_sub, map_one, laurentAlgHom_T_natCast, sub_eq_zero, Units.val_eq_one]

/-- **The functor of points of the stabilizer algebra.** For a `k[s]`-algebra `R`, the
`k[s]`-algebra maps `k[s][t, t⁻¹] / (t^N - 1, s·(t^m - 1)) ⟶ R` are the units `γ` of `R` with
`γ^N = 1` and `s·γ^m = s`, through the image of `t`. -/
noncomputable def stabilizerAlgebraHomEquiv (m N : ℕ) :
    (StabilizerAlgebra k m N →ₐ[k[X]] R) ≃
      {γ : Rˣ // γ ^ N = 1 ∧
        algebraMap k[X] R Polynomial.X * ((γ ^ m : Rˣ) : R) = algebraMap k[X] R Polynomial.X} :=
  (quotientSpanAlgHomEquiv R _).trans <|
    Equiv.subtypeEquiv (laurentAlgHomEquivUnits k[X] R) fun φ => by
      rw [Set.forall_mem_insert, Set.forall_mem_singleton, laurentAlgHom_root_iff,
        laurentAlgHom_relation_iff]

/-- **The functor of points of the stabilizer algebra without the root of unity.** For a
`k[s]`-algebra `R`, the `k[s]`-algebra maps `k[s][t, t⁻¹] / (s·(t^m - 1)) ⟶ R` are the units `γ`
of `R` with `s·γ^m = s`, through the image of `t`. -/
noncomputable def stabilizerAlgebraInftyHomEquiv (m : ℕ) :
    (StabilizerAlgebraInfty k m →ₐ[k[X]] R) ≃
      {γ : Rˣ //
        algebraMap k[X] R Polynomial.X * ((γ ^ m : Rˣ) : R) = algebraMap k[X] R Polynomial.X} :=
  (quotientSpanAlgHomEquiv R _).trans <|
    Equiv.subtypeEquiv (laurentAlgHomEquivUnits k[X] R) fun φ => by
      rw [Set.forall_mem_singleton, laurentAlgHom_relation_iff]

end Corepresent

/-! ### Non-flatness -/

/-- A module carrying a nonzero element killed by a nonzerodivisor of the ring is not flat: flat
modules have no such torsion (`Module.Flat.isSMulRegular_of_nonZeroDivisors`). -/
@[ega "0 6.3.4", sga "1 IV 1.3"]
theorem not_flat_of_smul_eq_zero {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {r : R} (hr : r ∈ nonZeroDivisors R) {m : M} (hm : m ≠ 0) (h : r • m = 0) :
    ¬ Module.Flat R M := fun _ =>
  hm (Module.Flat.isSMulRegular_of_nonZeroDivisors hr (h.trans (smul_zero r).symm))

section NotFlat

variable {k}

/-- In a quotient of `k[s][t, t⁻¹]` by an ideal containing `s·(t^m - 1)`, the class of
`t^m - 1` is killed by `s`. -/
theorem smul_mk_relation_eq_zero {I : Ideal (LaurentPolynomial k[X])} (m : ℕ)
    (hI : LaurentPolynomial.C (Polynomial.X : k[X]) * (T (m : ℤ) - 1) ∈ I) :
    (Polynomial.X : k[X]) • Ideal.Quotient.mk I (T (m : ℤ) - 1) = 0 := by
  rw [Algebra.smul_def, IsScalarTower.algebraMap_apply k[X] (LaurentPolynomial k[X]),
    Ideal.Quotient.algebraMap_eq, ← LaurentPolynomial.C_eq_algebraMap, ← map_mul]
  exact Ideal.Quotient.eq_zero_iff_mem.2 hI

/-- In `k[t]/(t^N - 1)` the class of `t` is an `N`-th root of unity. -/
theorem root_pow_eq_one (N : ℕ) :
    AdjoinRoot.root ((Polynomial.X : k[X]) ^ N - 1) ^ N = 1 := by
  have h := AdjoinRoot.mk_self (f := (Polynomial.X : k[X]) ^ N - 1)
  rw [map_sub, map_pow, map_one, AdjoinRoot.mk_X, sub_eq_zero] at h
  exact h

/-- An element of `k[s][t, t⁻¹]` is nonzero modulo an ideal generated by a set `s` if it has a
nonzero image under a ring map `eval₂ g u` killing `s`. -/
private theorem mk_span_ne_zero_of_eval₂_ne_zero {S : Type*} [CommRing S] (g : k[X] →+* S) (u : Sˣ)
    {s : Set (LaurentPolynomial k[X])} (hs : ∀ x ∈ s, LaurentPolynomial.eval₂ g u x = 0)
    {x : LaurentPolynomial k[X]} (hx : LaurentPolynomial.eval₂ g u x ≠ 0) :
    Ideal.Quotient.mk (Ideal.span s) x ≠ 0 := fun h0 =>
  hx (RingHom.mem_ker.1 ((Ideal.span_le (I := RingHom.ker (LaurentPolynomial.eval₂ g u))).2 hs
    (Ideal.Quotient.eq_zero_iff_mem.1 h0)))

variable [Nontrivial k]

/-- **The class of `t^m - 1` in `k[s][t, t⁻¹] / (t^N - 1, s·(t^m - 1))` is nonzero** for
`0 < m < N`. Setting `s = 0` and `t ↦ t` maps the algebra to `k[t]/(t^N - 1)`, where the image of
`t^m - 1` is nonzero because `t^N - 1` is monic of degree `N > m` and cannot divide the nonzero
polynomial `t^m - 1`. -/
theorem mk_T_sub_one_ne_zero {m N : ℕ} (hm : 0 < m) (hmN : m < N) :
    Ideal.Quotient.mk (stabilizerIdeal k m N) (T (m : ℤ) - 1) ≠ 0 := by
  have hN : N ≠ 0 := by omega
  let u : (AdjoinRoot ((Polynomial.X : k[X]) ^ N - 1))ˣ :=
    (IsUnit.of_pow_eq_one (root_pow_eq_one N) hN).unit
  let g : k[X] →+* AdjoinRoot ((Polynomial.X : k[X]) ^ N - 1) :=
    (AdjoinRoot.of _).comp (Polynomial.evalRingHom 0)
  have hTu : ∀ n : ℕ, LaurentPolynomial.eval₂ g u (T (n : ℤ)) =
      AdjoinRoot.root ((Polynomial.X : k[X]) ^ N - 1) ^ n := fun n => by
    rw [LaurentPolynomial.eval₂_T, zpow_natCast, Units.val_pow_eq_pow_val, IsUnit.unit_spec]
  have hg : g Polynomial.X = 0 := by simp [g]
  refine mk_span_ne_zero_of_eval₂_ne_zero g u ?_ ?_
  · rintro x (rfl | rfl)
    · rw [map_sub, map_one, hTu, root_pow_eq_one, sub_self]
    · rw [map_mul, LaurentPolynomial.eval₂_C, hg, zero_mul]
  rw [map_sub, map_one, hTu, ← AdjoinRoot.mk_X, ← map_pow, ← map_one (AdjoinRoot.mk _), ← map_sub,
    Ne, AdjoinRoot.mk_eq_zero]
  intro h1
  have hmon : ((Polynomial.X : k[X]) ^ N - 1).Monic := by
    simpa using Polynomial.monic_X_pow_sub_C (1 : k) hN
  have hne : (Polynomial.X : k[X]) ^ m - 1 ≠ 0 := by
    simpa using Polynomial.X_pow_sub_C_ne_zero hm (1 : k)
  have hdeg := Polynomial.Monic.natDegree_le_of_dvd hmon hne h1
  rw [← map_one Polynomial.C, Polynomial.natDegree_X_pow_sub_C,
    Polynomial.natDegree_X_pow_sub_C] at hdeg
  omega

/-- **The class of `t^m - 1` in `k[s][t, t⁻¹] / (s·(t^m - 1))` is nonzero** for `0 < m`: setting
`s = 0` maps the algebra to `k[t, t⁻¹]`, where `t^m ≠ 1`. -/
theorem mk_T_sub_one_ne_zero_infty {m : ℕ} (hm : 0 < m) :
    Ideal.Quotient.mk (stabilizerIdealInfty k m) (T (m : ℤ) - 1) ≠ 0 := by
  let u : (LaurentPolynomial k)ˣ := (isUnit_T 1).unit
  let g : k[X] →+* LaurentPolynomial k := LaurentPolynomial.C.comp (Polynomial.evalRingHom 0)
  have hTu : ∀ n : ℕ, LaurentPolynomial.eval₂ g u (T (n : ℤ)) = T (n : ℤ) := fun n => by
    rw [LaurentPolynomial.eval₂_T, zpow_natCast, Units.val_pow_eq_pow_val, IsUnit.unit_spec,
      T_pow, mul_one]
  have hg : g Polynomial.X = 0 := by simp [g]
  refine mk_span_ne_zero_of_eval₂_ne_zero g u ?_ ?_
  · rintro x rfl
    rw [map_mul, LaurentPolynomial.eval₂_C, hg, zero_mul]
  rw [map_sub, map_one, hTu, sub_ne_zero, Ne, ← T_zero]
  intro h1
  have h2 := (AddMonoidAlgebra.single_left_inj (one_ne_zero (α := k))).1 h1
  omega

/-- **`k[s][t, t⁻¹] / (t^N - 1, s·(t^m - 1))` is not flat over `k[s]`** when `0 < m < N`: the
class of `t^m - 1` is a nonzero element killed by the nonzerodivisor `s`. -/
theorem not_flat_stabilizerAlgebra {m N : ℕ} (hm : 0 < m) (hmN : m < N) :
    ¬ Module.Flat k[X] (StabilizerAlgebra k m N) :=
  not_flat_of_smul_eq_zero Polynomial.X_mem_nonZeroDivisors (mk_T_sub_one_ne_zero hm hmN)
    (smul_mk_relation_eq_zero m (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))

/-- **`k[s][t, t⁻¹] / (s·(t^m - 1))` is not flat over `k[s]`** when `0 < m`: the class of
`t^m - 1` is a nonzero element killed by the nonzerodivisor `s`. -/
theorem not_flat_stabilizerAlgebraInfty {m : ℕ} (hm : 0 < m) :
    ¬ Module.Flat k[X] (StabilizerAlgebraInfty k m) :=
  not_flat_of_smul_eq_zero Polynomial.X_mem_nonZeroDivisors (mk_T_sub_one_ne_zero_infty hm)
    (smul_mk_relation_eq_zero m (Ideal.subset_span rfl))

/-- **The stabilizer algebra `k[s][t, t⁻¹] / (t^{p^b} - 1, s·(t^{p^a} - 1))` is not flat over
`k[s]`** for `1 < p` and `a < b`. -/
theorem not_flat_stabilizerAlgebra_pow {p a b : ℕ} (hp : 1 < p) (hab : a < b) :
    ¬ Module.Flat k[X] (StabilizerAlgebra k (p ^ a) (p ^ b)) :=
  not_flat_stabilizerAlgebra (Nat.pow_pos (by omega)) (Nat.pow_lt_pow_right hp hab)

/-- **The stabilizer algebra `k[s][t, t⁻¹] / (s·(t^{p^a} - 1))` is not flat over `k[s]`** for
`1 < p`. -/
theorem not_flat_stabilizerAlgebraInfty_pow {p : ℕ} (a : ℕ) (hp : 1 < p) :
    ¬ Module.Flat k[X] (StabilizerAlgebraInfty k (p ^ a)) :=
  not_flat_stabilizerAlgebraInfty (Nat.pow_pos (by omega))

end NotFlat

end AlgebraicGeometry.PPowerWeighted

end
