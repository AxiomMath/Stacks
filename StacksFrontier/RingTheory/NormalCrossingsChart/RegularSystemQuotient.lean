module

public import StacksFrontier.RingTheory.RegularLocalRing.RegularParameterFactorization
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The quotient by one member of a regular system of parameters

In a regular local ring `(R, 𝔪)`, the quotient by the ideal generated by any single entry of a
regular system of parameters is again a regular local ring.

## Main results

* `IsRegularLocalRing.isRegularLocalRing_quotient_span_singleton_of_mem_ofList`: the quotient by
  one entry of a regular system of parameters is regular.
* `IsRegularLocalRing.isRegularLocalRing_quotient_span_singleton_of_mem_isSystemOfParameters`:
  the same with the length hypothesis replaced by `IsLocalRing.IsSystemOfParameters`.

## References

* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
-/

@[expose] public section

open IsLocalRing

namespace IsRegularLocalRing

variable {R : Type*} [CommRing R] [IsRegularLocalRing R]

/-- **The quotient by one entry of a regular system of parameters is regular.** -/
@[ega "0 17.1.7" "r=1: a⇒(A/J regular)"]
public theorem isRegularLocalRing_quotient_span_singleton_of_mem_ofList {xs : List R}
    (hgen : Ideal.ofList xs = maximalIdeal R)
    (hlen : xs.length = (maximalIdeal R).spanFinrank) {x : R} (hx : x ∈ xs) :
    IsRegularLocalRing (R ⧸ Ideal.span {x}) := by
  obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem hx
  have hperm : (l₁ ++ x :: l₂).Perm (x :: (l₁ ++ l₂)) := List.perm_middle
  have hgen' : Ideal.ofList (x :: (l₁ ++ l₂)) = maximalIdeal R := by
    rwa [← Ideal.ofList_eq_of_perm hperm]
  have hlen' : (x :: (l₁ ++ l₂)).length = (maximalIdeal R).spanFinrank := by
    rwa [← hperm.length_eq]
  obtain ⟨hmain, -⟩ :=
    IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay R
  obtain ⟨-, hquot⟩ := hmain _ hgen' hlen'
  have h1 := (hquot 1 (by simp)).1
  rwa [List.take_succ_cons, List.take_zero, Ideal.ofList_singleton] at h1

/-- **The quotient by one entry of a regular system of parameters is regular**, with the system of
parameters given as such. -/
@[ega "0 17.1.7" "r=1: a⇒(A/J regular)", ega "0 17.1.9" "(b) ⇒ (a), one generator"]
public theorem isRegularLocalRing_quotient_span_singleton_of_mem_isSystemOfParameters
    {xs : List R} (hsop : IsSystemOfParameters xs) (hgen : Ideal.ofList xs = maximalIdeal R)
    {x : R} (hx : x ∈ xs) : IsRegularLocalRing (R ⧸ Ideal.span {x}) := by
  refine isRegularLocalRing_quotient_span_singleton_of_mem_ofList hgen ?_ hx
  have hdim := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  rw [hsop.2] at hdim
  exact_mod_cast hdim.symm

end IsRegularLocalRing

end
