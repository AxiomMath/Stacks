module

public import Mathlib.RingTheory.Flat.Stability
public import Mathlib.RingTheory.TensorProduct.Quotient
public import StacksFrontier.RingTheory.RegularLocalRing.FlatLocalHom
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Descent of regularity for a principal quotient along a flat local homomorphism

Let `A → S` be a flat local homomorphism of Noetherian local rings and let `x` be an element of
the maximal ideal of `A`. This file shows that if `S ⧸ (x S)` is a regular local ring, then so is
`A ⧸ (x)`. This is the quotient version of Stacks 00OF, obtained by applying 00OF to the induced
homomorphism `A ⧸ (x) → S ⧸ (x S)`, which is again flat and local.

## Main results

* `flat_quotient_map_of_flat`: for a flat `A`-algebra `S` and an ideal `J` of `A`, the ring
  `S ⧸ J S` is flat over `A ⧸ J`.
* `isLocalHom_quotient_map_of_isLocalHom`: the induced map `A ⧸ J → S ⧸ J S` is a local
  homomorphism whenever `A → S` is one and `J S` is proper.
* `isRegularLocalRing_quotient_of_flat_of_isLocalHom`: regularity of `A ⧸ (x)` descends from
  regularity of `S ⧸ (x S)`.

## Implementation notes

Flatness of the quotient is the base-change isomorphism
`Algebra.TensorProduct.quotIdealMapEquivQuotTensor`, which identifies `S ⧸ J S` with
`(A ⧸ J) ⊗[A] S`; the latter is flat over `A ⧸ J` by `Module.Flat.baseChange`.

Locality of the induced map is checked elementwise. Since `Ideal.Quotient.mk (J S)` is a
surjection from a local ring onto a nontrivial ring it is itself local, and the induced map
composed with `Ideal.Quotient.mk J` is by definition `Ideal.Quotient.mk (J S)` composed with
`algebraMap A S`; reflecting units through those two factors gives the claim.

The two nontriviality side conditions are both instances of `Ideal.span_singleton_eq_top`
combined with `IsLocalRing.notMem_maximalIdeal`: a principal ideal generated by a nonunit is
proper. On the `S` side one first moves `x` into the maximal ideal of `S` using that
`algebraMap A S` is local.

## References

* [Stacks Project, Tag 00OF](https://stacks.math.columbia.edu/tag/00OF)
* [Stacks Project, Tag 07BJ](https://stacks.math.columbia.edu/tag/07BJ)
-/

@[expose] public section

universe u v

open IsLocalRing

/-- **Flatness passes to quotients**: if `S` is a flat `A`-algebra and `J` is an ideal of `A`,
then `S ⧸ J S` is flat over `A ⧸ J`. -/
public theorem flat_quotient_map_of_flat {A : Type u} (S : Type v) [CommRing A] [CommRing S]
    [Algebra A S] (J : Ideal A) [Module.Flat A S] :
    Module.Flat (A ⧸ J) (S ⧸ J.map (algebraMap A S)) :=
  Module.Flat.of_linearEquiv
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S J).toLinearEquiv

/-- **The induced map on quotients is local**: if `algebraMap A S` is a local homomorphism into a
local ring `S` and the extended ideal `J S` is proper, then `A ⧸ J → S ⧸ J S` reflects units. -/
public theorem isLocalHom_quotient_map_of_isLocalHom {A : Type u} (S : Type v) [CommRing A]
    [CommRing S] [IsLocalRing S] [Algebra A S] [IsLocalHom (algebraMap A S)] (J : Ideal A)
    (hJ : J.map (algebraMap A S) ≠ ⊤) :
    IsLocalHom (algebraMap (A ⧸ J) (S ⧸ J.map (algebraMap A S))) := by
  have : Nontrivial (S ⧸ J.map (algebraMap A S)) := Ideal.Quotient.nontrivial_iff.mpr hJ
  have hmk : IsLocalHom (Ideal.Quotient.mk (J.map (algebraMap A S))) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  refine ⟨fun a ha => ?_⟩
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [Ideal.Quotient.algebraMap_quotient_map_quotient] at ha
  exact (Ideal.Quotient.mk J).isUnit_map
    (isUnit_of_map_unit (algebraMap A S) w (isUnit_of_map_unit _ _ ha))

/-- **Regularity of a principal quotient descends along a flat local homomorphism.** If `A → S`
is a flat local homomorphism of local rings with `A` Noetherian, `x` lies in the maximal ideal of
`A`, and `S ⧸ (x S)` is a regular local ring, then `A ⧸ (x)` is a regular local ring. This is the
quotient form of Stacks 00OF. -/
@[ega "0 17.3.3" "more general", ega "IV 6.5.1" "more general"]
public theorem isRegularLocalRing_quotient_of_flat_of_isLocalHom
    {A : Type u} (S : Type v) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [CommRing S] [IsLocalRing S] [Algebra A S] [Module.Flat A S]
    [IsLocalHom (algebraMap A S)] {x : A} (hx : x ∈ IsLocalRing.maximalIdeal A)
    (h : IsRegularLocalRing (S ⧸ Ideal.span {algebraMap A S x})) :
    IsRegularLocalRing (A ⧸ Ideal.span {x}) := by
  have hmap : (Ideal.span {x}).map (algebraMap A S) = Ideal.span {algebraMap A S x} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hxS : algebraMap A S x ∈ maximalIdeal S := _root_.map_nonunit _ x hx
  have hAtop : Ideal.span {x} ≠ ⊤ := Ideal.span_singleton_ne_top hx
  have hStop : (Ideal.span {x}).map (algebraMap A S) ≠ ⊤ :=
    hmap ▸ Ideal.span_singleton_ne_top hxS
  have : Nontrivial (A ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hAtop
  have : IsLocalRing (A ⧸ Ideal.span {x}) :=
    IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have : Module.Flat (A ⧸ Ideal.span {x}) (S ⧸ (Ideal.span {x}).map (algebraMap A S)) :=
    flat_quotient_map_of_flat S _
  have : IsLocalHom
      (algebraMap (A ⧸ Ideal.span {x}) (S ⧸ (Ideal.span {x}).map (algebraMap A S))) :=
    isLocalHom_quotient_map_of_isLocalHom S _ hStop
  have : IsRegularLocalRing (S ⧸ (Ideal.span {x}).map (algebraMap A S)) := by
    rw [hmap]; exact h
  exact IsRegularLocalRing.of_flat_of_isLocalHom
    (S ⧸ (Ideal.span {x}).map (algebraMap A S))

end
