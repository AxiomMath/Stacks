module

public import StacksFrontier.RingTheory.Descent.CechNerveQuotient
public import StacksFrontier.RingTheory.Etale.DirectedColimitPresentation

/-!
# A Čech nerve modulo a nil ideal with an étale model of the reduction is a nerve

Let `p₁, p₂ : B → C`, `δ`, `e₁₂, e₁₃, e₂₃ : C → D` be the first terms of the Čech nerve of a
surjective étale chart `U → P` of an algebraic space, and suppose the diagram is a nerve modulo an
invariant nil ideal `K` of `B`: the closed subspace cut out by `K` is `Spec A₁`, with chart
`Spec B₁ → Spec A₁`. Let `A ⊆ B` be the ring of invariant functions, with its map `A → A₁`.

`Module.Descent.isNerveReduction_bot_of_model` says: if `B₁` is the base change of a faithfully
flat étale `A`-algebra `S`, i.e. `A₁ ⊗[A] S ≅ B₁`, then the diagram is a nerve modulo `0`, so `P`
is `Spec A`. The proof is the one of `Module.Descent.isNerveReduction_bot_of_span_singleton`: lift
`S → B₁` to `β : S → B`, show the two comparison maps `S ⊗[A] B → C` and `S ⊗[A] C → D` are
bijective because they are maps of étale algebras which are bijective modulo nil ideals
(`Module.Descent.bijective_algebraMap_tensor_of_model`), and descend along `A → S`.

The surjectivity of `A → A₁` used in the square-zero case is replaced by the model `S`; this is
what a limit argument produces (`StacksFrontier.RingTheory.Descent.CechNerveStage`).

We also record `Algebra.Etale.exists_square_presentation`: an étale algebra is
`A[x_k] ⧸ (g_k)` for a square family `g` whose Jacobian determinant is invertible in the quotient
(**Stacks 00U9**, in the form consumed by
`StacksFrontier.RingTheory.Etale.DirectedColimitPresentation`).
-/

@[expose] public section

universe u

open TensorProduct

/-- **A square standard-étale presentation of an étale algebra.** An étale `A`-algebra `B` is
`A[x_k : k ∈ κ] ⧸ (g_k : k ∈ κ)` for a finite `κ` and a family `g` whose Jacobian determinant
`det (∂g_b/∂x_a)` is invertible in the quotient. This is the relative-dimension-zero case of
`Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero` (Stacks 00U9). -/
theorem Algebra.Etale.exists_square_presentation (A B : Type*) [CommRing A] [CommRing B]
    [Algebra A B] [Algebra.Etale A B] :
    ∃ (κ : Type) (_ : Fintype κ) (_ : DecidableEq κ) (g : κ → MvPolynomial κ A),
      IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.detJacobian g)) ∧
      Nonempty ((MvPolynomial κ A ⧸ Ideal.span (Set.range g)) ≃ₐ[A] B) := by
  classical
  have hss : Algebra.IsStandardSmoothOfRelativeDimension 0 A B :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
  obtain ⟨ι, σ, _, _, P, hP⟩ := hss.out
  have hcard : Nat.card ι ≤ Nat.card σ := by
    have := hP
    simp only [Algebra.Presentation.dimension] at this
    omega
  have hbij : Function.Bijective P.map :=
    P.map_inj.bijective_of_nat_card_le hcard
  have : Fintype σ := Fintype.ofFinite σ
  let eqv : σ ≃ ι := Equiv.ofBijective P.map hbij
  let Q := P.reindex eqv (Equiv.refl σ)
  have hQmap : ∀ i, Q.map i = i := fun i => by
    simp [Q, Algebra.SubmersivePresentation.reindex,
      Algebra.PreSubmersivePresentation.reindex, eqv]
  let g : σ → MvPolynomial σ A := Q.relation
  have hspan : Ideal.span (Set.range g) = Q.ker := Q.span_range_relation_eq_ker
  let E : (MvPolynomial σ A ⧸ Ideal.span (Set.range g)) ≃ₐ[A] B :=
    (Ideal.quotientEquivAlgOfEq A hspan).trans (Q.quotientEquiv.restrictScalars A)
  have hE : ∀ p, E (Ideal.Quotient.mk _ p) = algebraMap Q.Ring B p := fun p => by
    simp [E, Algebra.Presentation.quotientEquiv_mk]
  have hdet : Q.jacobiMatrix.det = MvPolynomial.detJacobian g := by
    unfold MvPolynomial.detJacobian
    congr 1
    ext a b
    rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply, hQmap]
    rfl
  refine ⟨σ, inferInstance, inferInstance, g, ?_, ⟨E⟩⟩
  have hu : IsUnit (E (Ideal.Quotient.mk _ (MvPolynomial.detJacobian g))) := by
    rw [hE, ← hdet, ← Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
    exact Q.jacobian_isUnit
  simpa using hu.map E.symm

namespace Module.Descent

section Tensor

variable {A A₁ S B₁ M M₁ : Type*} [CommRing A] [CommRing A₁] [CommRing S] [CommRing B₁]
  [CommRing M] [CommRing M₁] [Algebra A A₁] [Algebra A₁ B₁] [Algebra A₁ M₁] [Algebra A M₁]
  [IsScalarTower A A₁ M₁] [Algebra A S] [Algebra A M]

/-- **The tensor criterion with a model.** Let `e : A₁ ⊗[A] S ≅ B₁` exhibit the `A₁`-algebra `B₁`
as the base change of an `A`-algebra `S`, let `πM : M → M₁` be a surjection with nil kernel from
an `A`-algebra onto an `A₁`-algebra, and let `N` be étale over `S ⊗[A] M` with a map
`πN : N → B₁ ⊗[A₁] M₁` extending `s ⊗ m ↦ e (1 ⊗ s) ⊗ πM m` whose kernel is generated by
`1 ⊗ ker πM`. Then `S ⊗[A] M → N` is bijective. -/
theorem bijective_algebraMap_tensor_of_model (e : A₁ ⊗[A] S ≃ₐ[A₁] B₁)
    (πM : M →ₐ[A] M₁) (hπM : Function.Surjective πM) (hπMn : RingHom.ker πM ≤ nilradical M)
    {N : Type*} [CommRing N] [Algebra (S ⊗[A] M) N] [Algebra.Etale (S ⊗[A] M) N]
    (πN : N →+* B₁ ⊗[A₁] M₁)
    (hcomm : ∀ s m, πN (algebraMap (S ⊗[A] M) N (s ⊗ₜ m)) = e (1 ⊗ₜ s) ⊗ₜ πM m)
    (hker : RingHom.ker πN ≤ ((RingHom.ker πM).map
      (Algebra.TensorProduct.includeRight : M →ₐ[A] S ⊗[A] M)).map
        (algebraMap (S ⊗[A] M) N)) :
    Function.Bijective (algebraMap (S ⊗[A] M) N) := by
  let Φ : S ⊗[A] M₁ ≃+* B₁ ⊗[A₁] M₁ :=
    (Algebra.TensorProduct.comm A S M₁).toRingEquiv.trans
      ((Algebra.TensorProduct.cancelBaseChange (R := A) (S := A₁) (T := A₁) (A := M₁)
        (B := S)).symm.toRingEquiv.trans
        ((Algebra.TensorProduct.congr (AlgEquiv.refl : M₁ ≃ₐ[A₁] M₁) e).toRingEquiv.trans
          (Algebra.TensorProduct.comm A₁ M₁ B₁).toRingEquiv))
  have hΦ : ∀ s m, Φ (s ⊗ₜ m) = e (1 ⊗ₜ s) ⊗ₜ m := fun s m => by
    simp [Φ]
  let θ₀ : S ⊗[A] M →ₐ[A] S ⊗[A] M₁ := Algebra.TensorProduct.map (AlgHom.id A S) πM
  let θ : S ⊗[A] M →+* B₁ ⊗[A₁] M₁ := (Φ : S ⊗[A] M₁ →+* B₁ ⊗[A₁] M₁).comp θ₀.toRingHom
  have hθ : ∀ s m, θ (s ⊗ₜ m) = e (1 ⊗ₜ s) ⊗ₜ πM m := fun s m => by
    change Φ (θ₀ (s ⊗ₜ m)) = _
    simp [θ₀, hΦ]
  have hθ₀surj : Function.Surjective θ₀ := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul s m =>
      obtain ⟨m', rfl⟩ := hπM m
      exact ⟨s ⊗ₜ m', by simp [θ₀]⟩
    | add x y hx hy =>
      obtain ⟨x', rfl⟩ := hx
      obtain ⟨y', rfl⟩ := hy
      exact ⟨x' + y', map_add _ _ _⟩
  have hθsurj : Function.Surjective θ := Φ.surjective.comp hθ₀surj
  have hkerθ : RingHom.ker θ = RingHom.ker θ₀ := by
    ext x
    simp only [RingHom.mem_ker, θ, RingHom.coe_comp, Function.comp_apply]
    exact ⟨fun h => Φ.injective (h.trans (map_zero Φ).symm), fun h => by
      change Φ (θ₀ x) = 0
      rw [h, map_zero]⟩
  have hidn : RingHom.ker (AlgHom.id A S) ≤ nilradical S := by
    intro x hx
    have : x = 0 := hx
    rw [this]; exact Ideal.zero_mem _
  have hkerθn : RingHom.ker θ ≤ nilradical (S ⊗[A] M) := by
    rw [hkerθ, Algebra.TensorProduct.map_ker _ _ Function.surjective_id hπM]
    exact sup_le
      (Ideal.map_le_nilradical_of_le_nilradical
        (Algebra.TensorProduct.includeLeft : S →ₐ[A] S ⊗[A] M).toRingHom hidn)
      (Ideal.map_le_nilradical_of_le_nilradical
        (Algebra.TensorProduct.includeRight : M →ₐ[A] S ⊗[A] M).toRingHom hπMn)
  refine bijective_algebraMap_of_comp_eq θ hθsurj hkerθn πN ?_ ?_
  · refine RingHom.ext fun x => ?_
    induction x using TensorProduct.inductionOn with
    | tmul s m => rw [RingHom.comp_apply, hcomm, hθ]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  · refine hker.trans (Ideal.map_mono ?_)
    rw [Ideal.map_le_iff_le_comap]
    intro m hm
    rw [Ideal.mem_comap, RingHom.mem_ker]
    change θ (1 ⊗ₜ m) = 0
    rw [hθ, RingHom.mem_ker.1 hm, TensorProduct.tmul_zero]

/-- **The first comparison map of a model is bijective.** In the situation of
`Module.Descent.isNerveReduction_bot_of_model`, with everything linear over the ring `A` of
invariant functions, `S ⊗[A] B → C`, `s ⊗ b ↦ p₁ (β s) * p₂ b`, is bijective. -/
theorem bijective_chartMap_of_model {B C : Type*} [CommRing B] [CommRing C] [Algebra A B]
    [Algebra A C] [Algebra A B₁] [IsScalarTower A A₁ B₁]
    (p₁ p₂ : B →ₐ[A] C) (hp₂ : (p₂ : B →+* C).Etale) (β : S →ₐ[A] B)
    (e : A₁ ⊗[A] S ≃ₐ[A₁] B₁) (πB : B →ₐ[A] B₁) (hsB : Function.Surjective πB)
    (K : Ideal B) (hkB : RingHom.ker πB = K) (hKn : K ≤ nilradical B)
    (hK : K.map (p₁ : B →+* C) = K.map (p₂ : B →+* C))
    (πC : C →+* B₁ ⊗[A₁] B₁) (hkC : RingHom.ker πC = K.map (p₁ : B →+* C))
    (hC₁ : ∀ b, πC (p₁ b) = πB b ⊗ₜ 1) (hC₂ : ∀ b, πC (p₂ b) = 1 ⊗ₜ πB b)
    (hβ : ∀ s, πB (β s) = e (1 ⊗ₜ s)) [Algebra.Etale A S] :
    Function.Bijective (chartMap p₁ p₂ β) := by
  let : Algebra B C := (p₂ : B →+* C).toAlgebra
  let : Algebra (S ⊗[A] B) C := (chartMap p₁ p₂ β).toRingHom.toAlgebra
  let : Algebra B (S ⊗[A] B) := Algebra.TensorProduct.rightAlgebra
  have : Algebra.Etale B C := RingHom.etale_algebraMap.1 hp₂
  have : Algebra.Etale B (S ⊗[A] B) := etale_rightAlgebra
  have h1 : ∀ b, chartMap p₁ p₂ β (1 ⊗ₜ b) = p₂ b := fun b => by
    rw [chartMap_tmul, map_one, map_one, one_mul]
  have : IsScalarTower B (S ⊗[A] B) C := IsScalarTower.of_algebraMap_eq fun b => (h1 b).symm
  have : Algebra.Etale (S ⊗[A] B) C := Algebra.Etale.of_restrictScalars B _ _
  refine bijective_algebraMap_tensor_of_model (M₁ := B₁) e πB hsB (hkB ▸ hKn) πC
    (fun s b => ?_) ?_
  · change πC (chartMap p₁ p₂ β (s ⊗ₜ b)) = _
    rw [chartMap_tmul, map_mul, hC₁, hC₂, hβ, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
      one_mul]
  · rw [hkC, hK, hkB, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap]
    change p₂ x ∈ _
    rw [← h1]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hx)

/-- **The second comparison map of a model is bijective.** In the situation of
`Module.Descent.isNerveReduction_bot_of_model`, `S ⊗[A] C → D`,
`s ⊗ c ↦ e₁₂ (p₁ (β s)) * e₂₃ c`, is bijective. -/
theorem bijective_tripleMap_of_model {B C D : Type*} [CommRing B] [CommRing C] [CommRing D]
    [Algebra A B] [Algebra A C] [Algebra A D] [Algebra A B₁] [IsScalarTower A A₁ B₁]
    (p₁ : B →ₐ[A] C) (e₁₂ e₂₃ : C →ₐ[A] D) (he₂₃ : (e₂₃ : C →+* D).Etale) (β : S →ₐ[A] B)
    (e : A₁ ⊗[A] S ≃ₐ[A₁] B₁) (πB : B →+* B₁) (πC : C →ₐ[A] B₁ ⊗[A₁] B₁)
    (hsC : Function.Surjective πC) (L : Ideal C) (hkC : RingHom.ker πC = L)
    (hLn : L ≤ nilradical C) (πD : D →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))
    (hkD : RingHom.ker πD ≤ L.map (e₂₃ : C →+* D))
    (hC₁ : ∀ b, πC (p₁ b) = πB b ⊗ₜ 1)
    (hD₁₂ : ∀ c, πD (e₁₂ c) = Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (πC c))
    (hD₂₃ : ∀ c, πD (e₂₃ c) = (1 : B₁) ⊗ₜ πC c)
    (hβ : ∀ s, πB (β s) = e (1 ⊗ₜ s)) [Algebra.Etale A S] :
    Function.Bijective (tripleMap p₁ e₁₂ e₂₃ β) := by
  let : Algebra C D := (e₂₃ : C →+* D).toAlgebra
  let : Algebra (S ⊗[A] C) D := (tripleMap p₁ e₁₂ e₂₃ β).toRingHom.toAlgebra
  let : Algebra C (S ⊗[A] C) := Algebra.TensorProduct.rightAlgebra
  have : Algebra.Etale C D := RingHom.etale_algebraMap.1 he₂₃
  have : Algebra.Etale C (S ⊗[A] C) := etale_rightAlgebra
  have h1 : ∀ c, tripleMap p₁ e₁₂ e₂₃ β (1 ⊗ₜ c) = e₂₃ c := fun c => by
    rw [tripleMap_tmul, map_one, map_one, map_one, one_mul]
  have : IsScalarTower C (S ⊗[A] C) D := IsScalarTower.of_algebraMap_eq fun c => (h1 c).symm
  have : Algebra.Etale (S ⊗[A] C) D := Algebra.Etale.of_restrictScalars C _ _
  refine bijective_algebraMap_tensor_of_model e πC hsC (hkC ▸ hLn) πD (fun s c => ?_) ?_
  · change πD (tripleMap p₁ e₁₂ e₂₃ β (s ⊗ₜ c)) = _
    rw [tripleMap_tmul, map_mul, hD₁₂, hD₂₃, hC₁, hβ, Algebra.TensorProduct.map_tmul,
      AlgHom.id_apply, Algebra.TensorProduct.includeLeft_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← Algebra.TensorProduct.one_def, one_mul]
  · refine hkD.trans ?_
    rw [hkC, Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap]
    change e₂₃ x ∈ _
    rw [← h1]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hx)

end Tensor

/-- **Assembling a nerve from a faithfully flat étale chart.** If `A` maps isomorphically onto
the equalizer of `p₁, p₂`, `S` is a faithfully flat étale `A`-algebra and `β : S → B` makes both
comparison maps bijective, the diagram is a Čech nerve modulo `0`. -/
theorem isNerveReduction_bot_of_bijective_chartMap {R : Type u} [CommRing R] {B C D : Type u}
    [CommRing B] [CommRing C] [CommRing D] [Algebra R B] [Algebra R C] [Algebra R D]
    {A : Type u} [CommRing A] [Algebra A B] [Algebra A C] [Algebra A D]
    (p₁ p₂ : B →ₐ[R] C) (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D) (p₁' p₂' : B →ₐ[A] C) (δ' : C →ₐ[A] B)
    (e₁₂' e₁₃' e₂₃' : C →ₐ[A] D) (hp₁ : ∀ b, p₁' b = p₁ b) (hp₂ : ∀ b, p₂' b = p₂ b)
    (he₁₂ : ∀ c, e₁₂' c = e₁₂ c) (he₁₃ : ∀ c, e₁₃' c = e₁₃ c) (he₂₃ : ∀ c, e₂₃' c = e₂₃ c)
    (hδ₁ : δ'.comp p₁' = AlgHom.id A B) (hδ₂ : δ'.comp p₂' = AlgHom.id A B)
    (h₁₂₁₃ : e₁₂'.comp p₁' = e₁₃'.comp p₁') (h₁₂₂₃ : e₁₂'.comp p₂' = e₂₃'.comp p₁')
    (h₁₃₂₃ : e₁₃'.comp p₂' = e₂₃'.comp p₂')
    (hA : ∀ b : B, p₁' b = p₂' b → b ∈ Set.range (algebraMap A B))
    (hAinj : Function.Injective (algebraMap A B))
    {S : Type u} [CommRing S] [Algebra A S] [Algebra.Etale A S] [Module.FaithfullyFlat A S]
    (β : S →ₐ[A] B) (hφ : Function.Bijective (chartMap p₁' p₂' β))
    (hν : Function.Bijective (tripleMap p₁' e₁₂' e₂₃' β)) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ ⊥ := by
  have hβbij : Function.Bijective β :=
    bijective_of_bijective_chartMap p₁' p₂' δ' e₁₂' e₁₃' e₂₃' hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hA hAinj
      β hφ hν.injective
  let βe : S ≃ₐ[A] B := AlgEquiv.ofBijective β hβbij
  have hβe : ∀ b, β (βe.symm b) = b := fun b => βe.apply_symm_apply b
  have : Algebra.Etale A B := Algebra.Etale.of_equiv βe
  have : Module.FaithfullyFlat A B :=
    Module.FaithfullyFlat.of_linearEquiv A S βe.symm.toLinearEquiv
  have hφid : Function.Bijective (chartMap p₁' p₂' (AlgHom.id A B)) := by
    have : ⇑(chartMap p₁' p₂' (AlgHom.id A B)) =
        chartMap p₁' p₂' β ∘ Algebra.TensorProduct.congr βe.symm AlgEquiv.refl := by
      funext x
      induction x using TensorProduct.inductionOn with
      | tmul b b' =>
        change _ = chartMap p₁' p₂' β (βe.symm b ⊗ₜ b')
        rw [chartMap_tmul, chartMap_tmul, hβe]; rfl
      | add x y hx hy => simp only [Function.comp_apply, map_add] at hx hy ⊢; rw [hx, hy]
    rw [this]
    exact hφ.comp (Algebra.TensorProduct.congr βe.symm AlgEquiv.refl).bijective
  have hνid : Function.Bijective (tripleMap p₁' e₁₂' e₂₃' (AlgHom.id A B)) := by
    have : ⇑(tripleMap p₁' e₁₂' e₂₃' (AlgHom.id A B)) =
        tripleMap p₁' e₁₂' e₂₃' β ∘ Algebra.TensorProduct.congr βe.symm AlgEquiv.refl := by
      funext x
      induction x using TensorProduct.inductionOn with
      | tmul b c =>
        change _ = tripleMap p₁' e₁₂' e₂₃' β (βe.symm b ⊗ₜ c)
        rw [tripleMap_tmul, tripleMap_tmul, hβe]; rfl
      | add x y hx hy => simp only [Function.comp_apply, map_add] at hx hy ⊢; rw [hx, hy]
    rw [this]
    exact hν.comp (Algebra.TensorProduct.congr βe.symm AlgEquiv.refl).bijective
  exact isNerveReduction_bot_of_bijective p₁ p₂ e₁₂ e₁₃ e₂₃ p₁' p₂' e₁₂' e₁₃' e₂₃'
    hp₁ hp₂ he₁₂ he₁₃ he₂₃ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hφid hνid

section Nerve

variable {R : Type u} [CommRing R] {B C D : Type u} [CommRing B] [CommRing C] [CommRing D]
  [Algebra R B] [Algebra R C] [Algebra R D]

/-- **A Čech nerve modulo an invariant nil ideal, with an étale model of the reduction, is a
Čech nerve.** Let the diagram be a nerve modulo an invariant nil ideal `K` of `B`, witnessed by
`πB : B → B₁`, `πC`, `πD` over `A₁`, and let `A ⊆ B` be the equalizer of `p₁, p₂`, with a map
`A → A₁` compatible with `πB`. If `B₁ ≅ A₁ ⊗[A] S` for a faithfully flat étale `A`-algebra `S`,
the diagram is a nerve modulo `0`. -/
theorem isNerveReduction_bot_of_model (p₁ p₂ : B →ₐ[R] C) (δ : C →ₐ[R] B)
    (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D)
    (hδ₁ : δ.comp p₁ = AlgHom.id R B) (hδ₂ : δ.comp p₂ = AlgHom.id R B)
    (h₁₂₁₃ : e₁₂.comp p₁ = e₁₃.comp p₁) (h₁₂₂₃ : e₁₂.comp p₂ = e₂₃.comp p₁)
    (h₁₃₂₃ : e₁₃.comp p₂ = e₂₃.comp p₂)
    (hp₂ : (p₂ : B →+* C).Etale) (he₂₃ : (e₂₃ : C →+* D).Etale)
    (K : Ideal B) (hK : K.map (p₁ : B →+* C) = K.map (p₂ : B →+* C)) (hKn : K ≤ nilradical B)
    {A₁ B₁ : Type*} [CommRing A₁] [CommRing B₁] [Algebra A₁ B₁]
    (πB : B →+* B₁) (πC : C →+* B₁ ⊗[A₁] B₁) (πD : D →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))
    (hsB : Function.Surjective πB) (hsC : Function.Surjective πC)
    (hkB : RingHom.ker πB = K) (hkC : RingHom.ker πC = K.map (p₁ : B →+* C))
    (hkD : RingHom.ker πD ≤ K.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C)))
    (hC₁ : πC.comp (p₁ : B →+* C) =
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom.comp πB)
    (hC₂ : πC.comp (p₂ : B →+* C) =
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom.comp πB)
    (hD₁₂ : πD.comp (e₁₂ : C →+* D) = (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom.comp πC)
    (hD₂₃ : πD.comp (e₂₃ : C →+* D) = (Algebra.TensorProduct.includeRight :
        B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)).toRingHom.comp πC)
    (A : Subalgebra R B) (hA : ∀ b, b ∈ A ↔ p₁ b = p₂ b) [Algebra A A₁]
    (hρ : ∀ a : A, algebraMap A₁ B₁ (algebraMap A A₁ a) = πB a)
    (S : Type u) [CommRing S] [Algebra A S] [Algebra.Etale A S] [Module.FaithfullyFlat A S]
    (e : A₁ ⊗[A] S ≃ₐ[A₁] B₁) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ ⊥ := by
  classical
  have hAeq : ∀ a : A, p₁ a = p₂ a := fun a => (hA a).1 a.2
  let : Algebra A B₁ := ((algebraMap A₁ B₁).comp (algebraMap A A₁)).toAlgebra
  have : IsScalarTower A A₁ B₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : Algebra A C := ((p₁ : B →+* C).comp (algebraMap A B)).toAlgebra
  let : Algebra A D := ((e₁₂ : C →+* D).comp (algebraMap A C)).toAlgebra
  let p₁' : B →ₐ[A] C := { (p₁ : B →+* C) with commutes' := fun _ => rfl }
  let p₂' : B →ₐ[A] C := { (p₂ : B →+* C) with commutes' := fun a => (hAeq a).symm }
  let e₁₂' : C →ₐ[A] D := { (e₁₂ : C →+* D) with commutes' := fun _ => rfl }
  let e₁₃' : C →ₐ[A] D := { (e₁₃ : C →+* D) with
    commutes' := fun a => (AlgHom.congr_fun h₁₂₁₃ a).symm }
  let e₂₃' : C →ₐ[A] D := { (e₂₃ : C →+* D) with
    commutes' := fun a => by
      change e₂₃ (p₁ a) = e₁₂ (p₁ a)
      rw [← AlgHom.comp_apply, ← h₁₂₂₃, AlgHom.comp_apply, hAeq] }
  let δ' : C →ₐ[A] B := { (δ : C →+* B) with
    commutes' := fun a => by
      change δ (p₁ a) = a
      rw [← AlgHom.comp_apply, hδ₁, AlgHom.id_apply] }
  have hρ' : ∀ a : A, πB (algebraMap A B a) = algebraMap A B₁ a := fun a => (hρ a).symm
  let πBA : B →ₐ[A] B₁ := { πB with commutes' := hρ' }
  -- the reduction `S → B₁` and its lift `β : S → B`
  let ψ : S →ₐ[A] B₁ := (e.toAlgHom.restrictScalars A).comp Algebra.TensorProduct.includeRight
  have hψ : ∀ s, ψ s = e (1 ⊗ₜ s) := fun _ => rfl
  have hkBA : RingHom.ker πBA = K := hkB
  let eB : (B ⧸ RingHom.ker πBA) ≃ₐ[A] B₁ := Ideal.quotientKerAlgEquivOfSurjective hsB
  obtain ⟨β, hβ⟩ := Algebra.FormallySmooth.exists_lift_of_le_nilradical (R := A) (A := S)
    (RingHom.ker πBA) (hkBA ▸ hKn) (eB.symm.toAlgHom.comp ψ)
  have hβψ : ∀ s, πB (β s) = e (1 ⊗ₜ s) := by
    intro s
    have := congrArg eB (AlgHom.congr_fun hβ s)
    have h' : πBA (β s) = ψ s := by simpa [eB] using this
    exact h'
  -- the two comparison maps are bijective
  have hC₁' : ∀ b, πC (p₁ b) = πB b ⊗ₜ 1 := fun b => RingHom.congr_fun hC₁ b
  have hC₂' : ∀ b, πC (p₂ b) = 1 ⊗ₜ πB b := fun b => RingHom.congr_fun hC₂ b
  have hhφ : Function.Bijective (chartMap p₁' p₂' β) :=
    bijective_chartMap_of_model p₁' p₂' hp₂ β e πBA hsB K hkBA hKn hK πC hkC hC₁' hC₂' hβψ
  have hπCA : ∀ a : A, πC (algebraMap A C a) = algebraMap A (B₁ ⊗[A₁] B₁) a := by
    intro a
    change πC (p₁ a) = _
    rw [hC₁', Algebra.TensorProduct.algebraMap_apply, ← hρ]
    rfl
  let πCA : C →ₐ[A] B₁ ⊗[A₁] B₁ := { πC with commutes' := hπCA }
  have hhν : Function.Bijective (tripleMap p₁' e₁₂' e₂₃' β) := by
    refine bijective_tripleMap_of_model p₁' e₁₂' e₂₃' he₂₃ β e πB πCA hsC _ hkC
      (Ideal.map_le_nilradical_of_le_nilradical _ hKn) πD
      (hkD.trans_eq (map_e₂₃_eq h₁₂₂₃ hK).symm) hC₁' (fun c => RingHom.congr_fun hD₁₂ c)
      (fun c => RingHom.congr_fun hD₂₃ c) hβψ
  exact isNerveReduction_bot_of_bijective_chartMap p₁ p₂ e₁₂ e₁₃ e₂₃ p₁' p₂' δ' e₁₂' e₁₃' e₂₃'
    (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) (fun _ => rfl)
    (AlgHom.ext fun x => AlgHom.congr_fun hδ₁ x) (AlgHom.ext fun x => AlgHom.congr_fun hδ₂ x)
    (AlgHom.ext fun x => AlgHom.congr_fun h₁₂₁₃ x)
    (AlgHom.ext fun x => AlgHom.congr_fun h₁₂₂₃ x)
    (AlgHom.ext fun x => AlgHom.congr_fun h₁₃₂₃ x)
    (fun b hb => ⟨⟨b, (hA b).2 hb⟩, rfl⟩) Subtype.val_injective β hhφ hhν

end Nerve

end Module.Descent
