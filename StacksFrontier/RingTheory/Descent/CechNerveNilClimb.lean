module

public import StacksFrontier.RingTheory.Descent.CechNerveStage
public import StacksFrontier.RingTheory.Descent.CechSquareZeroGenerators

/-!
# A Čech nerve modulo a finitely generated nil invariant ideal is a nerve

Let `p₁, p₂ : B → C`, `δ`, `e₁₂, e₁₃, e₂₃ : C → D` be the first terms of the Čech nerve of a
surjective étale chart `U → P` of an algebraic space, and let `K` be a finitely generated nil ideal
of `B` whose two extensions to `C` agree. If the closed subspace cut out by `K` is affine, that is
the diagram is a nerve modulo `K`, then `P` is affine: the diagram is a nerve modulo `0`
(`Module.Descent.isNerveReduction_bot_of_fg_of_invariant`).

The proof walks down `K ⊇ K² ⊇ K⁴ ⊇ ⋯ ⊇ 0`. At each step, `K ⧸ K²` is a square-zero invariant ideal
of the nerve reduced modulo `K²`, hence generated by finitely many invariant elements
(`Module.Descent.exists_invariant_span_eq_of_mul_self_eq_bot`); lifting them to `μ_i ∈ K`, one has
`K = K² + (μ_1, …, μ_r)` with `μ_i` invariant modulo `K²`, and the generators are removed one at a
time by `Module.Descent.isNerveReduction_of_sup_span_singleton`.
-/

@[expose] public section

universe u

open TensorProduct

namespace Module.Descent

section Nerve

variable {R : Type u} [CommRing R] {B C D : Type u} [CommRing B] [CommRing C] [CommRing D]
  [Algebra R B] [Algebra R C] [Algebra R D]

/-- An invariant ideal enlarged by elements invariant modulo its extension is invariant. -/
theorem map_sup_span_invariant (p₁ p₂ : B →ₐ[R] C) (Q : Ideal B)
    (hQ : Q.map (p₁ : B →+* C) = Q.map (p₂ : B →+* C)) (S : Set B)
    (hS : ∀ μ ∈ S, p₁ μ - p₂ μ ∈ Q.map (p₁ : B →+* C)) :
    (Q ⊔ Ideal.span S).map (p₁ : B →+* C) = (Q ⊔ Ideal.span S).map (p₂ : B →+* C) := by
  rw [Ideal.map_sup, Ideal.map_sup, Ideal.map_span, Ideal.map_span, ← hQ]
  have e : ∀ f : B →+* C, Q.map (p₁ : B →+* C) ⊔ Ideal.span (f '' S) =
      ((Ideal.span (f '' S)).map (Ideal.Quotient.mk (Q.map (p₁ : B →+* C)))).comap
        (Ideal.Quotient.mk (Q.map (p₁ : B →+* C))) := fun f => by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, sup_comm]
  rw [e, e, Ideal.map_span, Ideal.map_span, Set.image_image, Set.image_image]
  congr 2
  exact Set.image_congr fun μ hμ => Ideal.Quotient.eq.2 (hS μ hμ)

variable (p₁ p₂ : B →ₐ[R] C) (δ : C →ₐ[R] B) (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D)
  (hδ₁ : δ.comp p₁ = AlgHom.id R B) (hδ₂ : δ.comp p₂ = AlgHom.id R B)
  (h₁₂₁₃ : e₁₂.comp p₁ = e₁₃.comp p₁) (h₁₂₂₃ : e₁₂.comp p₂ = e₂₃.comp p₁)
  (h₁₃₂₃ : e₁₃.comp p₂ = e₂₃.comp p₂)
  (hp₁ : (p₁ : B →+* C).Etale) (hp₂ : (p₂ : B →+* C).Etale)
  (he₁₂ : (e₁₂ : C →+* D).Etale) (he₂₃ : (e₂₃ : C →+* D).Etale)

include hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hp₁ hp₂ he₁₂ he₂₃

/-- **Removing finitely many generators invariant modulo an invariant ideal.** -/
theorem isNerveReduction_of_sup_span_image (Q : Ideal B)
    (hQ : Q.map (p₁ : B →+* C) = Q.map (p₂ : B →+* C)) {r : ℕ} (μ : Fin r → B)
    (hμ : ∀ i, μ i * μ i ∈ Q) (hμp : ∀ i, p₁ (μ i) - p₂ (μ i) ∈ Q.map (p₁ : B →+* C))
    (s : Finset (Fin r))
    (h : IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ (Q ⊔ Ideal.span (μ '' (s : Set (Fin r))))) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ Q := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using h
  | insert a s ha ih =>
    refine ih ?_
    have hS : ∀ x ∈ μ '' (s : Set (Fin r)), p₁ x - p₂ x ∈ Q.map (p₁ : B →+* C) := by
      rintro _ ⟨i, -, rfl⟩
      exact hμp i
    refine isNerveReduction_of_sup_span_singleton p₁ p₂ δ e₁₂ e₁₃ e₂₃ hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃
      hp₁ hp₂ he₁₂ he₂₃ _ (map_sup_span_invariant p₁ p₂ Q hQ _ hS) (μ a)
      (Ideal.mem_sup_left (hμ a)) (Ideal.map_mono le_sup_left (hμp a)) ?_
    have e : Q ⊔ Ideal.span (μ '' ((insert a s : Finset (Fin r)) : Set (Fin r))) =
        (Q ⊔ Ideal.span (μ '' (s : Set (Fin r)))) ⊔ Ideal.span {μ a} := by
      rw [Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert, sup_assoc,
        sup_comm (Ideal.span {μ a})]
    rwa [e] at h

/-- **One squaring step.** For a finitely generated invariant ideal `K`, a nerve modulo `K` is a
nerve modulo `K * K`. -/
theorem isNerveReduction_mul_self (K : Ideal B)
    (hK : K.map (p₁ : B →+* C) = K.map (p₂ : B →+* C)) (hKfg : K.FG)
    (h : IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ K) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ (K * K) := by
  classical
  set Q := K * K with hQdef
  have hQ : Q.map (p₁ : B →+* C) = Q.map (p₂ : B →+* C) := by
    rw [hQdef, Ideal.map_mul, Ideal.map_mul, hK]
  obtain ⟨hq₁, hq₂, hq₃, hq₄, hq₅, -, hqp₂, -, hqe₂₃⟩ :=
    nerveQuot_identities hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hp₁ hp₂ he₁₂ he₂₃ hQ
  have h' := isNerveReduction_quot_of_le h₁₂₁₃ h₁₂₂₃ hQ Ideal.mul_le_left h
  -- the image of `K` modulo `K * K`
  set N := K.map (Ideal.Quotient.mk Q) with hNdef
  have hNN : N * N = ⊥ := by
    rw [hNdef, ← Ideal.map_mul, ← hQdef, Ideal.map_quotient_self]
  have hmapC : ∀ (f : B →ₐ[R] C) (g : B ⧸ Q →+* C ⧸ Q.map (p₁ : B →+* C)),
      (∀ b, g (Ideal.Quotient.mk Q b) = Ideal.Quotient.mk _ (f b)) →
      N.map g = (K.map (f : B →+* C)).map (Ideal.Quotient.mk (Q.map (p₁ : B →+* C))) := by
    intro f g hg
    rw [hNdef, Ideal.map_map, Ideal.map_map]
    congr 1
    exact RingHom.ext hg
  have hNinv : N.map (nerveQuotP₁ p₁ Q : B ⧸ Q →+* C ⧸ Q.map (p₁ : B →+* C)) =
      N.map (nerveQuotP₂ p₁ p₂ Q hQ : B ⧸ Q →+* C ⧸ Q.map (p₁ : B →+* C)) := by
    rw [hmapC p₁ _ (fun _ => rfl), hmapC p₂ _ (fun _ => rfl), hK]
  obtain ⟨r, μ', hμ'N, hμ'inv, hμ'span⟩ := exists_invariant_span_eq_of_mul_self_eq_bot _ _
    (nerveQuotδ p₁ Q δ hδ₁) _ _ _ hq₁ hq₂ hq₃ hq₄ hq₅ hqp₂.flat'
    (RingHom.Flat.comp hqp₂.flat' hqe₂₃.flat') N hNN (hKfg.map _) hNinv h'
  -- lift the invariant generators to `K`
  have hlift : ∀ i, ∃ x, x ∈ K ∧ Ideal.Quotient.mk Q x = μ' i := fun i =>
    (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).1 (hμ'N i)
  choose μ hμK hμ using hlift
  have hμp : ∀ i, p₁ (μ i) - p₂ (μ i) ∈ Q.map (p₁ : B →+* C) := fun i => by
    have := hμ'inv i
    rw [← hμ i, nerveQuotP₁_mk, nerveQuotP₂_mk, Ideal.Quotient.eq] at this
    exact this
  -- `K = K * K + (μ_1, …, μ_r)`
  set S := μ '' ((Finset.univ : Finset (Fin r)) : Set (Fin r)) with hSdef
  have hKeq : K = Q ⊔ Ideal.span S := by
    refine le_antisymm (fun x hx => ?_) (sup_le Ideal.mul_le_left (Ideal.span_le.2 ?_))
    · have hrange : Set.range μ' = Ideal.Quotient.mk Q '' S := by
        rw [hSdef, Finset.coe_univ, Set.image_univ, ← Set.range_comp]
        exact congrArg Set.range (funext fun i => (hμ i).symm)
      have hx' : Ideal.Quotient.mk Q x ∈ (Ideal.span S).map (Ideal.Quotient.mk Q) := by
        rw [Ideal.map_span, ← hrange, ← hμ'span]
        exact Ideal.mem_map_of_mem _ hx
      obtain ⟨y, hy, hxy⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).1 hx'
      have hd : x - y ∈ Q := Ideal.Quotient.eq.1 hxy.symm
      have e : x = (x - y) + y := by ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mem_sup_left hd) (Ideal.mem_sup_right hy)
    · rintro _ ⟨i, -, rfl⟩
      exact hμK i
  refine isNerveReduction_of_sup_span_image p₁ p₂ δ e₁₂ e₁₃ e₂₃ hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hp₁
    hp₂ he₁₂ he₂₃ Q hQ μ (fun i => Ideal.mul_mem_mul (hμK i) (hμK i)) hμp Finset.univ ?_
  rwa [← hSdef, ← hKeq]

/-- **A Čech nerve modulo a finitely generated nil invariant ideal is a Čech nerve.** If the
closed subspace of `P` cut out by a finitely generated nil ideal `K` of `B` with
`p₁ K C = p₂ K C` is affine, so is `P`: a nerve modulo `K` is a nerve modulo `0`. -/
theorem isNerveReduction_bot_of_fg_of_invariant (K : Ideal B)
    (hK : K.map (p₁ : B →+* C) = K.map (p₂ : B →+* C)) (hKfg : K.FG) (hKn : K ≤ nilradical B)
    (h : IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ K) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ ⊥ := by
  have hpow : ∀ k : ℕ, (K ^ (2 ^ k)).FG ∧
      (K ^ (2 ^ k)).map (p₁ : B →+* C) = (K ^ (2 ^ k)).map (p₂ : B →+* C) ∧
      IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ (K ^ (2 ^ k)) := by
    intro k
    induction k with
    | zero => simpa using ⟨hKfg, hK, h⟩
    | succ k ih =>
      obtain ⟨h1, h2, h3⟩ := ih
      have e : K ^ (2 ^ (k + 1)) = K ^ (2 ^ k) * K ^ (2 ^ k) := by
        rw [pow_succ, pow_mul, pow_two]
      rw [e]
      exact ⟨Ideal.FG.mul h1 h1, by rw [Ideal.map_mul, Ideal.map_mul, h2],
        isNerveReduction_mul_self p₁ p₂ δ e₁₂ e₁₃ e₂₃ hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hp₁ hp₂ he₁₂
          he₂₃ _ h2 h1 h3⟩
  obtain ⟨n, hn⟩ := Ideal.FG.isNilpotent_of_le_nilradical hKfg hKn
  have hle : K ^ (2 ^ n) = ⊥ := by
    rw [← le_bot_iff, ← Ideal.zero_eq_bot, ← hn]
    exact Ideal.pow_le_pow_right (Nat.lt_two_pow_self).le
  simpa [hle] using (hpow n).2.2

/-- **A Čech nerve modulo a nil invariant ideal which is a directed union of finitely generated
invariant ideals is a Čech nerve.** If the closed subspace of `P` cut out by `I` is affine, `I`
is nil, and `I` is the directed union of finitely generated invariant ideals `K i`, then `P` is
affine. -/
theorem isNerveReduction_bot_of_iSup_fg {ι : Type*} [Preorder ι] [IsDirected ι (· ≤ ·)]
    [Nonempty ι] (K : ι → Ideal B) (hKm : Monotone K)
    (hKinv : ∀ i, (K i).map (p₁ : B →+* C) = (K i).map (p₂ : B →+* C)) (hKfg : ∀ i, (K i).FG)
    (I : Ideal B) (hIn : I ≤ nilradical B) (hKI : ⨆ i, K i = I)
    (h : IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ I) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ ⊥ := by
  obtain ⟨i, hi⟩ := exists_isNerveReduction_of_iSup δ e₁₃ e₂₃ hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃ hp₁ hp₂
    he₁₂ he₂₃ K hKm hKinv I hIn hKI h
  exact isNerveReduction_bot_of_fg_of_invariant p₁ p₂ δ e₁₂ e₁₃ e₂₃ hδ₁ hδ₂ h₁₂₁₃ h₁₂₂₃ h₁₃₂₃
    hp₁ hp₂ he₁₂ he₂₃ (K i) (hKinv i) (hKfg i) ((hKI ▸ le_iSup K i).trans hIn) hi

end Nerve

end Module.Descent
