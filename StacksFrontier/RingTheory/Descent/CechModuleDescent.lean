module

public import StacksFrontier.RingTheory.Descent.EqualizerDescent

/-!
# A module with Čech comparison maps is generated by its invariant elements

Let `A₀ → B₀` be a flat ring map and write `B₀ ⊗ B₀` and `B₀ ⊗ (B₀ ⊗ B₀)` for the rings of the
double and triple overlaps of the corresponding covering. Let `N` be a `B₀`-module, `N₂` a module
over the double overlap and `N₃` one over the triple overlap, and suppose given the restriction
maps a quasi-coherent module on the base would have: two maps `φ₁, φ₂ : N → N₂` along the two
projections, a map `θ : N₂ → N` along the diagonal, and three maps `N₂ → N₃` along the three
partial projections, satisfying the identities of a Čech nerve, with `N₂` the base change of `N`
along the second projection and `N₃` receiving the base change of `N` along the third
projection injectively.

Then `N` is generated over `B₀` by its *invariant* elements, those `n` with `φ₁ n = φ₂ n`:
`Module.Descent.span_invariant_eq_top`. These are the elements that descend to the base.

The proof builds a descent datum (`Module.Descent.Datum`) on `N` out of the comparison maps — its
counit axiom from the diagonal, `Module.Descent.counit_coaction_of_retraction`, and its
cocycle axiom from the triple overlap, `Module.Descent.coassoc_of_comparison` — whose descended
module is exactly the set of invariant elements, and applies effectivity of flat descent,
`Module.Descent.Datum.span_descended_eq_top`.

## Main results

* `Module.Descent.span_invariant_eq_top`: the invariant elements span `N`.
* `Module.Descent.exists_fin_invariant_span_eq_top`: for a finite `N` and a faithfully flat
  `A₀ → B₀`, finitely many invariant elements span `N`.

## References

* [Stacks Project, Tag 023M](https://stacks.math.columbia.edu/tag/023M)
* [Stacks Project, Tag 03DW](https://stacks.math.columbia.edu/tag/03DW)
-/

@[expose] public section

open TensorProduct

namespace Module.Descent

variable {A₀ B₀ : Type*} [CommRing A₀] [CommRing B₀] [Algebra A₀ B₀]
variable {N : Type*} [AddCommGroup N] [Module A₀ N] [Module B₀ N] [IsScalarTower A₀ B₀ N]
variable {N₂ : Type*} [AddCommGroup N₂] [Module A₀ N₂] [Module (B₀ ⊗[A₀] B₀) N₂]
  [IsScalarTower A₀ (B₀ ⊗[A₀] B₀) N₂]
variable {N₃ : Type*} [AddCommGroup N₃] [Module A₀ N₃] [Module (B₀ ⊗[A₀] (B₀ ⊗[A₀] B₀)) N₃]
  [IsScalarTower A₀ (B₀ ⊗[A₀] (B₀ ⊗[A₀] B₀)) N₃]

/-- The comparison `B₀ ⊗ N → N₂`, `b ⊗ n ↦ (b ⊗ 1) • φ₂ n`, of the base change of `N` along the
second projection with `N₂`. -/
noncomputable def cechComparison (φ₂ : N →ₗ[A₀] N₂) : B₀ ⊗[A₀] N →ₗ[A₀] N₂ :=
  TensorProduct.lift (LinearMap.mk₂ A₀ (fun (b : B₀) (n : N) => (b ⊗ₜ[A₀] (1 : B₀)) • φ₂ n)
    (fun b b' n => by rw [TensorProduct.add_tmul, add_smul])
    (fun a b n => by rw [← TensorProduct.smul_tmul', smul_assoc])
    (fun b n n' => by rw [map_add, smul_add])
    (fun a b n => by rw [map_smul, smul_comm]))

omit [Module B₀ N] [IsScalarTower A₀ B₀ N] in
/-- The comparison `cechComparison φ₂` sends `b ⊗ n` to `(b ⊗ 1) • φ₂ n`. -/
@[simp]
lemma cechComparison_tmul (φ₂ : N →ₗ[A₀] N₂) (b : B₀) (n : N) :
    cechComparison φ₂ (b ⊗ₜ[A₀] n) = (b ⊗ₜ[A₀] (1 : B₀)) • φ₂ n := by
  simp [cechComparison]

/-- The comparison `B₀ ⊗ N → N₃`, `b' ⊗ n ↦ (1 ⊗ (b' ⊗ 1)) • χ₂₃ (φ₂ n)`. -/
noncomputable def cechComparison₃Inner (φ₂ : N →ₗ[A₀] N₂) (χ₂₃ : N₂ →ₗ[A₀] N₃) :
    B₀ ⊗[A₀] N →ₗ[A₀] N₃ :=
  TensorProduct.lift (LinearMap.mk₂ A₀
    (fun (b : B₀) (n : N) => ((1 : B₀) ⊗ₜ[A₀] (b ⊗ₜ[A₀] (1 : B₀))) • χ₂₃ (φ₂ n))
    (fun b b' n => by rw [TensorProduct.add_tmul, TensorProduct.tmul_add, add_smul])
    (fun a b n => by
      rw [← TensorProduct.smul_tmul', TensorProduct.tmul_smul, smul_assoc])
    (fun b n n' => by rw [map_add, map_add, smul_add])
    (fun a b n => by rw [map_smul, map_smul, smul_comm]))

/-- The comparison `B₀ ⊗ (B₀ ⊗ N) → N₃`, `b ⊗ (b' ⊗ n) ↦ (b ⊗ (b' ⊗ 1)) • χ₂₃ (φ₂ n)`, of the
base change of `N` along the third projection with `N₃`. -/
noncomputable def cechComparison₃ (φ₂ : N →ₗ[A₀] N₂) (χ₂₃ : N₂ →ₗ[A₀] N₃) :
    B₀ ⊗[A₀] (B₀ ⊗[A₀] N) →ₗ[A₀] N₃ :=
  TensorProduct.lift (LinearMap.mk₂ A₀
    (fun (b : B₀) (x : B₀ ⊗[A₀] N) =>
      (b ⊗ₜ[A₀] ((1 : B₀) ⊗ₜ[A₀] (1 : B₀))) • cechComparison₃Inner φ₂ χ₂₃ x)
    (fun b b' x => by rw [TensorProduct.add_tmul, add_smul])
    (fun a b x => by rw [← TensorProduct.smul_tmul', smul_assoc])
    (fun b x x' => by rw [map_add, smul_add])
    (fun a b x => by rw [map_smul, smul_comm]))

omit [Module B₀ N] [IsScalarTower A₀ B₀ N] [Module (B₀ ⊗[A₀] B₀) N₂]
  [IsScalarTower A₀ (B₀ ⊗[A₀] B₀) N₂] in
/-- The comparison `cechComparison₃ φ₂ χ₂₃` sends `b ⊗ (b' ⊗ n)` to
`(b ⊗ (b' ⊗ 1)) • χ₂₃ (φ₂ n)`. -/
@[simp]
lemma cechComparison₃_tmul (φ₂ : N →ₗ[A₀] N₂) (χ₂₃ : N₂ →ₗ[A₀] N₃) (b b' : B₀) (n : N) :
    cechComparison₃ φ₂ χ₂₃ (b ⊗ₜ[A₀] (b' ⊗ₜ[A₀] n)) =
      (b ⊗ₜ[A₀] (b' ⊗ₜ[A₀] (1 : B₀))) • χ₂₃ (φ₂ n) := by
  simp only [cechComparison₃, cechComparison₃Inner, TensorProduct.lift.tmul,
    LinearMap.mk₂_apply, smul_smul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

variable (φ₁ φ₂ : N →ₗ[A₀] N₂) (θ : N₂ →ₗ[A₀] N) (χ₁₂ χ₁₃ χ₂₃ : N₂ →ₗ[A₀] N₃)

/-- The data of Čech comparison maps on `N`, `N₂`, `N₃` along the projections, the diagonal and
the partial projections of a flat covering `A₀ → B₀`, with the identities a module of sections of a
quasi-coherent module satisfies. -/
structure IsCechModule : Prop where
  /-- The first projection is linear along `b ↦ b ⊗ 1`. -/
  φ₁_smul (b : B₀) (n : N) : φ₁ (b • n) = (b ⊗ₜ[A₀] (1 : B₀)) • φ₁ n
  /-- The second projection is linear along `b ↦ 1 ⊗ b`. -/
  φ₂_smul (b : B₀) (n : N) : φ₂ (b • n) = ((1 : B₀) ⊗ₜ[A₀] b) • φ₂ n
  /-- The diagonal is linear along multiplication, read at the elements `b ⊗ 1`. -/
  θ_smul (b : B₀) (y : N₂) : θ ((b ⊗ₜ[A₀] (1 : B₀)) • y) = b • θ y
  /-- The diagonal is a section of the first projection. -/
  θ_φ₁ (n : N) : θ (φ₁ n) = n
  /-- The diagonal is a section of the second projection. -/
  θ_φ₂ (n : N) : θ (φ₂ n) = n
  /-- The projection `(1,2)` of the triple overlap, read at the elements `b ⊗ 1`. -/
  χ₁₂_smul (b : B₀) (y : N₂) :
    χ₁₂ ((b ⊗ₜ[A₀] (1 : B₀)) • y) = (b ⊗ₜ[A₀] ((1 : B₀) ⊗ₜ[A₀] (1 : B₀))) • χ₁₂ y
  /-- The projection `(1,3)` of the triple overlap, read at the elements `b ⊗ 1`. -/
  χ₁₃_smul (b : B₀) (y : N₂) :
    χ₁₃ ((b ⊗ₜ[A₀] (1 : B₀)) • y) = (b ⊗ₜ[A₀] ((1 : B₀) ⊗ₜ[A₀] (1 : B₀))) • χ₁₃ y
  /-- The projection `(2,3)` of the triple overlap, read at the elements `b ⊗ 1`. -/
  χ₂₃_smul (b : B₀) (y : N₂) :
    χ₂₃ ((b ⊗ₜ[A₀] (1 : B₀)) • y) = ((1 : B₀) ⊗ₜ[A₀] (b ⊗ₜ[A₀] (1 : B₀))) • χ₂₃ y
  /-- The first cosimplicial identity: `(1,2) ∘ 1 = (1,3) ∘ 1`. -/
  χ₁₂_φ₁ (n : N) : χ₁₂ (φ₁ n) = χ₁₃ (φ₁ n)
  /-- The second cosimplicial identity: `(1,2) ∘ 2 = (2,3) ∘ 1`. -/
  χ₁₂_φ₂ (n : N) : χ₁₂ (φ₂ n) = χ₂₃ (φ₁ n)
  /-- The third cosimplicial identity: `(1,3) ∘ 2 = (2,3) ∘ 2`. -/
  χ₁₃_φ₂ (n : N) : χ₁₃ (φ₂ n) = χ₂₃ (φ₂ n)
  /-- `N₂` is the base change of `N` along the second projection. -/
  bijective_comparison : Function.Bijective (cechComparison (B₀ := B₀) φ₂)
  /-- `N₃` receives the base change of `N` along the third projection injectively. -/
  injective_comparison₃ : Function.Injective (cechComparison₃ (B₀ := B₀) φ₂ χ₂₃)

variable {φ₁ φ₂ θ χ₁₂ χ₁₃ χ₂₃}

namespace IsCechModule

variable (H : IsCechModule (B₀ := B₀) φ₁ φ₂ θ χ₁₂ χ₁₃ χ₂₃)
include H

/-- The comparison `B₀ ⊗ N ≃ N₂` as an `A₀`-linear equivalence. -/
noncomputable def comparisonEquiv : B₀ ⊗[A₀] N ≃ₗ[A₀] N₂ :=
  LinearEquiv.ofBijective (cechComparison φ₂) H.bijective_comparison

omit [Module B₀ N] [IsScalarTower A₀ B₀ N] [AddCommGroup N₃] [Module A₀ N₃]
  [Module (B₀ ⊗[A₀] (B₀ ⊗[A₀] B₀)) N₃] [IsScalarTower A₀ (B₀ ⊗[A₀] (B₀ ⊗[A₀] B₀)) N₃] H in
/-- The comparison `cechComparison φ₂` is linear along `b ↦ b ⊗ 1`. -/
lemma comparison_smul (b : B₀) (x : B₀ ⊗[A₀] N) :
    cechComparison φ₂ (b • x) = (b ⊗ₜ[A₀] (1 : B₀)) • cechComparison φ₂ x := by
  induction x with
  | tmul b' n =>
    rw [TensorProduct.smul_tmul', cechComparison_tmul, cechComparison_tmul, smul_eq_mul,
      ← smul_assoc, smul_eq_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
  | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]

/-- The coaction of the descent datum: `φ₁` read through the comparison. -/
noncomputable def coaction : N →ₗ[B₀] B₀ ⊗[A₀] N where
  toFun n := H.comparisonEquiv.symm (φ₁ n)
  map_add' n n' := by rw [map_add, map_add]
  map_smul' b n := by
    apply H.comparisonEquiv.injective
    rw [LinearEquiv.apply_symm_apply, RingHom.id_apply]
    change φ₁ (b • n) = cechComparison φ₂ (b • H.comparisonEquiv.symm (φ₁ n))
    rw [comparison_smul, H.φ₁_smul]
    change _ = _ • H.comparisonEquiv (H.comparisonEquiv.symm (φ₁ n))
    rw [LinearEquiv.apply_symm_apply]

omit [IsScalarTower A₀ B₀ N] in
/-- The comparison `cechComparison φ₂` sends the coaction of `n` to `φ₁ n`. -/
lemma comparison_coaction (n : N) : cechComparison φ₂ (H.coaction n) = φ₁ n :=
  H.comparisonEquiv.apply_symm_apply (φ₁ n)

omit [IsScalarTower A₀ B₀ N] in
/-- The comparison `cechComparison₃ φ₂ χ₂₃` on `b ⊗ x` is
`(b ⊗ (1 ⊗ 1)) • χ₂₃ (cechComparison φ₂ x)`. -/
lemma comparison₃_tmul (b : B₀) (x : B₀ ⊗[A₀] N) :
    cechComparison₃ φ₂ χ₂₃ (b ⊗ₜ[A₀] x) =
      (b ⊗ₜ[A₀] ((1 : B₀) ⊗ₜ[A₀] (1 : B₀))) • χ₂₃ (cechComparison φ₂ x) := by
  induction x with
  | tmul b' n =>
    rw [cechComparison₃_tmul, cechComparison_tmul, H.χ₂₃_smul, smul_smul,
      Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
      one_mul, mul_one]
  | add x y hx hy => rw [TensorProduct.tmul_add, map_add, hx, hy, map_add, map_add, smul_add]

/-- The descent datum on `N` given by the Čech comparison maps. -/
noncomputable def datum : Datum A₀ B₀ N where
  coaction := H.coaction
  counit_coaction n := by
    refine counit_coaction_of_retraction H.coaction (cechComparison φ₂) φ₁
      (fun n => (H.comparison_coaction n).symm) θ H.θ_φ₁ (fun x => ?_) n
    induction x with
    | tmul b n => rw [cechComparison_tmul, H.θ_smul, H.θ_φ₂, counit_tmul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  coassoc n := by
    refine coassoc_of_comparison H.coaction (cechComparison φ₂) φ₁
      (fun n => (H.comparison_coaction n).symm) (cechComparison₃ φ₂ χ₂₃)
      H.injective_comparison₃ χ₁₂ χ₁₃ (fun x => ?_) (fun x => ?_) H.χ₁₂_φ₁ n
    · induction x with
      | tmul b m =>
        rw [TensorProduct.AlgebraTensorModule.lTensor_tmul, cechComparison_tmul, H.χ₁₂_smul,
          H.χ₁₂_φ₂, ← H.comparison_coaction m, LinearMap.restrictScalars_apply,
          H.comparison₃_tmul]
      | add x y hx hy => simp only [map_add, hx, hy]
    · induction x with
      | tmul b m =>
        rw [TensorProduct.AlgebraTensorModule.lTensor_tmul, cechComparison_tmul, H.χ₁₃_smul,
          TensorProduct.mk_apply, cechComparison₃_tmul, H.χ₁₃_φ₂]
      | add x y hx hy => simp only [map_add, hx, hy]

/-- An element of `N` lies in the module descended by `H.datum` if and only if it is invariant,
`φ₁ n = φ₂ n`. -/
lemma mem_descended_datum_iff (n : N) : n ∈ H.datum.descended ↔ φ₁ n = φ₂ n := by
  rw [Datum.mem_descended_iff]
  change H.comparisonEquiv.symm (φ₁ n) = (1 : B₀) ⊗ₜ[A₀] n ↔ _
  rw [LinearEquiv.symm_apply_eq]
  have h : H.comparisonEquiv ((1 : B₀) ⊗ₜ[A₀] n) = φ₂ n := by
    change cechComparison φ₂ ((1 : B₀) ⊗ₜ[A₀] n) = φ₂ n
    rw [cechComparison_tmul]
    exact one_smul _ _
  rw [h]

end IsCechModule

/-- **A module with Čech comparison maps along a flat covering is generated by its invariant
elements.** -/
theorem span_invariant_eq_top [Module.Flat A₀ B₀]
    (H : IsCechModule (B₀ := B₀) φ₁ φ₂ θ χ₁₂ χ₁₃ χ₂₃) :
    Submodule.span B₀ {n : N | φ₁ n = φ₂ n} = ⊤ := by
  have h : (H.datum.descended : Set N) = {n : N | φ₁ n = φ₂ n} :=
    Set.ext fun n => H.mem_descended_datum_iff n
  rw [← h]
  exact H.datum.span_descended_eq_top

/-- **A finite module with Čech comparison maps along a faithfully flat covering is generated by
finitely many invariant elements.** -/
theorem exists_fin_invariant_span_eq_top [Module.FaithfullyFlat A₀ B₀] [Module.Finite B₀ N]
    (H : IsCechModule (B₀ := B₀) φ₁ φ₂ θ χ₁₂ χ₁₃ χ₂₃) :
    ∃ (r : ℕ) (g : Fin r → N), (∀ i, φ₁ (g i) = φ₂ (g i)) ∧
      Submodule.span B₀ (Set.range g) = ⊤ := by
  obtain ⟨r, g, hg, hspan⟩ := H.datum.exists_fin_descended_span_eq_top
  exact ⟨r, g, fun i => (H.mem_descended_datum_iff (g i)).1 (hg i), hspan⟩

end Module.Descent

end
