module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Flat.Equalizer
public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.RingTheory.Descent.AmitsurComplex

/-!
# Lifting invariant functions across a principal square-zero ideal

Let `U → P` be a surjective étale chart of an algebraic space with affine `U`, let
`V = U ×_P U` and `W = U ×_P U ×_P U`, and write `B`, `C`, `D` for their rings of functions, with
`p₁, p₂ : B → C` the two projections and `e₁₂, e₁₃, e₂₃ : C → D` the three partial projections.
The global functions of `P` are the equalizer of `p₁` and `p₂`. Let `μ` be a function on the base
with `μ² = 0`, and suppose that the closed subspace `P₁ ⊂ P` cut out by `μ` is affine, so
`P₁ = Spec A₁` with `B ⧸ μ B = B₁` faithfully flat over `A₁` and
`C ⧸ μ C = B₁ ⊗[A₁] B₁`, `D ⧸ μ D` mapping to `B₁ ⊗[A₁] B₁ ⊗[A₁] B₁` compatibly with the
projections.

This file proves that every function on `P₁` lifts to a function on `P`:
`Module.Descent.exists_lift_of_cech_of_mul_self_eq_zero`. This is the surjectivity
`Γ(P, 𝒪_P) → Γ(P₁, 𝒪_{P₁})` that the square-zero step of the affineness of a thickening needs,
reduced to commutative algebra.

## The argument

Lift `a ∈ A₁` to `b₀ ∈ B`; then `p₁ b₀ - p₂ b₀ = μ c` for some `c ∈ C`, and `μ · d c = 0` in `D`
for the Čech differential `d = e₁₂ - e₁₃ + e₂₃`. Because `μ² = 0`, the obstruction is the class
of `c` modulo the annihilator of `μ`, i.e. a Čech `1`-cocycle of the structure sheaf of the closed
subspace `T ⊂ P₁` cut out by `Ann(μ)` (the multiplication by `μ` identifies `μ 𝒪_P` with
`𝒪_T`). The pieces:

* `RingHom.Flat.mem_map_annihilator_of_mul_eq_zero`: annihilators commute with flat base change,
  so the ideal of `T` on `V` and on `W` is generated by its ideal on `U`.
* `Ideal.eq_map_comap_of_map_includeLeft_eq`: an ideal of `B₁` whose two extensions to
  `B₁ ⊗[A₁] B₁` agree is extended from `A₁`, for `B₁` flat over `A₁` — the descent of the
  quasi-coherent ideal of `T` to the affine `P₁`.
* `Module.Descent.exists_sub_mem_map_of_cocycle`: exactness in degree one of the Amitsur complex
  of `A₁ ⧸ 𝔞` along the faithfully flat `A₁ → B₁` (`Module.Descent.exists_amitsurDiff₀_eq`), read
  as a statement about `B₁ ⊗[A₁] B₁` modulo `𝔞`: the vanishing of the first Čech cohomology of
  `𝒪_T` on the affine `T`.

The coboundary found for the class of `c` is multiplied back by `μ` to correct `b₀`.

## References

* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
* [Stacks Project, Tag 023M](https://stacks.math.columbia.edu/tag/023M)
-/

@[expose] public section

open TensorProduct

/-! ### Annihilators and flat base change -/

namespace Ideal

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- The image in `B` of `B ⊗[A] I` is contained in the extension of the ideal `I` of `A`. -/
theorem rid_lTensor_subtype_mem_map (I : Ideal A) (z : B ⊗[A] I) :
    TensorProduct.rid A B (AlgebraTensorModule.lTensor B B I.subtype z) ∈
      I.map (algebraMap A B) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul s k =>
    rw [AlgebraTensorModule.lTensor_tmul, TensorProduct.rid_tmul, Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ k.2)
  | add x y hx hy =>
    rw [map_add, map_add]
    exact Ideal.add_mem _ hx hy

/-- Over a flat `A`-algebra `B`, if `y ⊗ 1` is killed by `f : A → N` tensored with `B`, then `y`
lies in the extension of `ker f`. -/
private theorem mem_map_ker_of_tmul_one_mem_ker [Module.Flat A B] {N : Type*} [AddCommGroup N]
    [Module A N] (f : A →ₗ[A] N) {y : B}
    (hy : y ⊗ₜ[A] (1 : A) ∈ LinearMap.ker (AlgebraTensorModule.lTensor B B f)) :
    y ∈ Ideal.map (algebraMap A B) (LinearMap.ker f) := by
  rw [Module.Flat.ker_lTensor_eq (R := A) B B f] at hy
  obtain ⟨z, hz⟩ := hy
  rw [show y = TensorProduct.rid A B (y ⊗ₜ[A] (1 : A)) by simp, ← hz]
  exact rid_lTensor_subtype_mem_map _ z

/-- **Ideals descend along a flat algebra.** For `B` flat over `A`, an ideal `𝔟` of `B` whose two
extensions to `B ⊗[A] B` agree is the extension of its contraction to `A`. -/
theorem eq_map_comap_of_map_includeLeft_eq [Module.Flat A B] (𝔟 : Ideal B)
    (h : 𝔟.map (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) =
      𝔟.map (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B)) :
    𝔟 = (𝔟.comap (algebraMap A B)).map (algebraMap A B) := by
  refine le_antisymm (fun b hb => ?_) Ideal.map_comap_le
  let f : A →ₗ[A] B ⧸ 𝔟 := (Ideal.Quotient.mkₐ A 𝔟).toLinearMap ∘ₗ Algebra.linearMap A B
  have hmem : b ⊗ₜ[A] (1 : A) ∈ LinearMap.ker (AlgebraTensorModule.lTensor B B f) := by
    have h1 : (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B) b ∈
        RingHom.ker (Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A 𝔟)) := by
      have hk : RingHom.ker (Ideal.Quotient.mkₐ A 𝔟) = 𝔟 := by
        ext x
        simp [Ideal.Quotient.eq_zero_iff_mem]
      rw [Algebra.TensorProduct.lTensor_ker _ (Ideal.Quotient.mkₐ_surjective A 𝔟), hk, ← h]
      exact Ideal.mem_map_of_mem _ hb
    rw [RingHom.mem_ker] at h1
    rw [LinearMap.mem_ker, AlgebraTensorModule.lTensor_tmul]
    simpa [f] using h1
  refine Ideal.map_mono (fun r hr => ?_) (mem_map_ker_of_tmul_one_mem_ker f hmem)
  rw [LinearMap.mem_ker] at hr
  simp only [f, LinearMap.coe_comp, Function.comp_apply, Algebra.linearMap_apply,
    AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at hr
  exact hr

end Ideal

namespace RingHom

variable {R S : Type*} [CommRing R] [CommRing S]

private theorem mem_annihilator_span_singleton_iff {x r : R} :
    r ∈ (Ideal.span {x}).annihilator ↔ x * r = 0 := by
  rw [Ideal.span, Submodule.mem_annihilator_span_singleton, smul_eq_mul, mul_comm]

/-- The image of the annihilator of `x` annihilates the image of `x`. -/
theorem mul_eq_zero_of_mem_map_annihilator (f : R →+* S) {x : R} {y : S}
    (hy : y ∈ (Ideal.span {x}).annihilator.map f) : f x * y = 0 := by
  have hle : (Ideal.span {x}).annihilator.map f ≤ (Ideal.span {f x}).annihilator := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, mem_annihilator_span_singleton_iff, ← map_mul,
      mem_annihilator_span_singleton_iff.1 hr, map_zero]
  exact mem_annihilator_span_singleton_iff.1 (hle hy)

/-- **Annihilators commute with flat base change.** For a flat ring map `f : R → S`, an element
of `S` killed by `f x` lies in the extension of the annihilator of `x`. -/
theorem Flat.mem_map_annihilator_of_mul_eq_zero {f : R →+* S} (hf : f.Flat) {x : R} {y : S}
    (hy : f x * y = 0) : y ∈ (Ideal.span {x}).annihilator.map f := by
  let := f.toAlgebra
  have : Module.Flat R S := hf
  let g : R →ₗ[R] R := LinearMap.mulLeft R x
  have hmem : y ⊗ₜ[R] (1 : R) ∈ LinearMap.ker (AlgebraTensorModule.lTensor S S g) := by
    rw [LinearMap.mem_ker, AlgebraTensorModule.lTensor_tmul]
    have hx : g 1 = x • (1 : R) := by simp [g]
    rw [hx, ← TensorProduct.smul_tmul, Algebra.smul_def, RingHom.algebraMap_toAlgebra, hy,
      TensorProduct.zero_tmul]
  have hle : (LinearMap.ker g : Ideal R) ≤ (Ideal.span {x}).annihilator := by
    intro r hr
    rw [LinearMap.mem_ker] at hr
    rw [mem_annihilator_span_singleton_iff]
    simpa [g] using hr
  have := Ideal.map_mono hle (Ideal.mem_map_ker_of_tmul_one_mem_ker (B := S) g hmem)
  rwa [RingHom.algebraMap_toAlgebra] at this

end RingHom

/-! ### The Amitsur complex modulo an ideal of the base -/

namespace Module.Descent

variable {A₁ : Type*} [CommRing A₁]

/-- The map `x ↦ x ⊗ₜ 1` from an `A₁`-module to its reduction modulo an ideal `𝔞` of `A₁`. -/
noncomputable def tensorQuotOne (𝔞 : Ideal A₁) (X : Type*) [AddCommGroup X] [Module A₁ X] :
    X →ₗ[A₁] X ⊗[A₁] (A₁ ⧸ 𝔞) :=
  (TensorProduct.mk A₁ X (A₁ ⧸ 𝔞)).flip (Ideal.Quotient.mk 𝔞 1)

/-- The map `tensorQuotOne 𝔞 X` sends `x` to `x ⊗ₜ 1`. -/
@[simp]
lemma tensorQuotOne_apply (𝔞 : Ideal A₁) {X : Type*} [AddCommGroup X] [Module A₁ X] (x : X) :
    tensorQuotOne 𝔞 X x = x ⊗ₜ[A₁] Ideal.Quotient.mk 𝔞 1 := rfl

/-- Under the isomorphism `X ⊗[A₁] (A₁ ⧸ 𝔞) ≃ X ⧸ 𝔞 X`, the element `x ⊗ₜ 1` corresponds to the
class of `x`. -/
lemma tensorQuotEquivQuotSMul_tensorQuotOne (𝔞 : Ideal A₁) {X : Type*} [AddCommGroup X]
    [Module A₁ X] (x : X) :
    tensorQuotEquivQuotSMul X 𝔞 (tensorQuotOne 𝔞 X x) = Submodule.Quotient.mk x := by
  rw [tensorQuotOne_apply, tensorQuotEquivQuotSMul_tmul_mk, one_smul]

/-- The kernel of `x ↦ x ⊗ₜ 1` is `𝔞 X`. -/
lemma tensorQuotOne_eq_zero_iff (𝔞 : Ideal A₁) {X : Type*} [AddCommGroup X] [Module A₁ X]
    (x : X) : tensorQuotOne 𝔞 X x = 0 ↔ x ∈ 𝔞 • (⊤ : Submodule A₁ X) := by
  rw [← (tensorQuotEquivQuotSMul X 𝔞).map_eq_zero_iff, tensorQuotEquivQuotSMul_tensorQuotOne,
    Submodule.Quotient.mk_eq_zero]

/-- The map `x ↦ x ⊗ₜ 1` from `X` to `X ⊗[A₁] (A₁ ⧸ 𝔞)` is surjective. -/
lemma tensorQuotOne_surjective (𝔞 : Ideal A₁) (X : Type*) [AddCommGroup X] [Module A₁ X] :
    Function.Surjective (tensorQuotOne 𝔞 X) := by
  intro y
  obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (tensorQuotEquivQuotSMul X 𝔞 y)
  exact ⟨x, (tensorQuotEquivQuotSMul X 𝔞).injective
    (by rw [tensorQuotEquivQuotSMul_tensorQuotOne, hx])⟩

/-- For an `A₁`-algebra `X`, the kernel of `x ↦ x ⊗ₜ 1` is the extension of `𝔞` to `X`. -/
private lemma tensorQuotOne_eq_zero_iff_mem_map (𝔞 : Ideal A₁) {X : Type*} [CommRing X]
    [Algebra A₁ X] (x : X) : tensorQuotOne 𝔞 X x = 0 ↔ x ∈ 𝔞.map (algebraMap A₁ X) := by
  rw [tensorQuotOne_eq_zero_iff, Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]

variable {B₁ : Type*} [CommRing B₁] [Algebra A₁ B₁]

/-- **A Čech `1`-cocycle modulo an ideal of the base is a coboundary modulo that ideal.** For
`B₁` faithfully flat over `A₁` and an ideal `𝔞` of `A₁`, an element `γ` of `B₁ ⊗[A₁] B₁` whose
Čech differential `γ₁₂ - γ₁₃ + γ₂₃` lies in `𝔞 (B₁ ⊗[A₁] B₁ ⊗[A₁] B₁)` differs from a coboundary
`β ⊗ 1 - 1 ⊗ β` by an element of `𝔞 (B₁ ⊗[A₁] B₁)`.

This is exactness in degree one of the Amitsur complex of the `A₁`-module `A₁ ⧸ 𝔞`,
`Module.Descent.exists_amitsurDiff₀_eq`, read through `X ⊗[A₁] (A₁ ⧸ 𝔞) ≅ X ⧸ 𝔞 X`. -/
theorem exists_sub_mem_map_of_cocycle [Module.FaithfullyFlat A₁ B₁] (𝔞 : Ideal A₁)
    (γ : B₁ ⊗[A₁] B₁)
    (hγ : Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
          (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) γ -
        Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
          (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) γ +
        (Algebra.TensorProduct.includeRight :
          B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) γ ∈
      𝔞.map (algebraMap A₁ (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)))) :
    ∃ β : B₁, γ - ((Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) β -
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) β) ∈
      𝔞.map (algebraMap A₁ (B₁ ⊗[A₁] B₁)) := by
  let M := A₁ ⧸ 𝔞
  let ΦC : B₁ ⊗[A₁] B₁ →ₗ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] M) :=
    (TensorProduct.assoc A₁ B₁ B₁ M).toLinearMap ∘ₗ tensorQuotOne 𝔞 (B₁ ⊗[A₁] B₁)
  let ΦD : B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁) →ₗ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] (B₁ ⊗[A₁] M)) :=
    (LinearMap.lTensor B₁ (TensorProduct.assoc A₁ B₁ B₁ M).toLinearMap) ∘ₗ
      (TensorProduct.assoc A₁ B₁ (B₁ ⊗[A₁] B₁) M).toLinearMap ∘ₗ
        tensorQuotOne 𝔞 (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))
  have h0 : ∀ β : B₁, amitsurDiff₀ A₁ B₁ M (tensorQuotOne 𝔞 B₁ β) =
      ΦC ((Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) β -
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) β) := by
    intro β
    simp [ΦC, M, TensorProduct.sub_tmul]
  have h1 : ∀ γ : B₁ ⊗[A₁] B₁, amitsurDiff₁ A₁ B₁ M (ΦC γ) =
      ΦD (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
          (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) γ -
        Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
          (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) γ +
        (Algebra.TensorProduct.includeRight :
          B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) γ) := by
    intro γ
    induction γ using TensorProduct.induction_on with
    | zero => simp
    | tmul s t =>
      simp only [ΦC, ΦD, M, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
        tensorQuotOne_apply, TensorProduct.assoc_tmul, amitsurDiff₁_tmul,
        Algebra.TensorProduct.map_tmul, AlgHom.coe_id, id_eq,
        Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply,
        map_add, map_sub, LinearMap.lTensor_tmul]
      abel
    | add x y hx hy =>
      simp only [map_add, map_sub] at hx hy ⊢
      rw [hx, hy]
      abel
  have hD : amitsurDiff₁ A₁ B₁ M (ΦC γ) = 0 := by
    rw [h1]
    simp only [ΦD, LinearMap.coe_comp, Function.comp_apply,
      (tensorQuotOne_eq_zero_iff_mem_map 𝔞 _).2 hγ, map_zero]
  obtain ⟨y, hy⟩ := exists_amitsurDiff₀_eq A₁ B₁ M (x := ΦC γ) hD
  obtain ⟨β, rfl⟩ := tensorQuotOne_surjective 𝔞 B₁ y
  refine ⟨β, (tensorQuotOne_eq_zero_iff_mem_map 𝔞 _).1 ?_⟩
  rw [map_sub, sub_eq_zero]
  exact (TensorProduct.assoc A₁ B₁ B₁ M).injective (hy.symm.trans (h0 β))

/-! ### The lift -/

/-- **Invariant functions lift across a principal square-zero ideal of the base.** Let
`p₁, p₂ : B → C` and `e₁₂, e₁₃, e₂₃ : C → D` be ring maps satisfying the simplicial identities
of the first three terms of a Čech nerve, with `p₁`, `p₂` and `e₁₂ ∘ p₁` flat, and let `μ ∈ B`
satisfy `μ² = 0` and `p₁ μ = p₂ μ`. Suppose the reduction modulo `μ` is the Čech nerve of a
faithfully flat `A₁ → B₁`: `πB : B → B₁` is surjective and kills `μ`, `πC : C → B₁ ⊗[A₁] B₁` is
surjective with kernel inside `(p₁ μ)`, `πD : D → B₁ ⊗[A₁] B₁ ⊗[A₁] B₁`, and these intertwine
`p₁, p₂` with the two inclusions and `e₁₂, e₁₃, e₂₃` with the three partial inclusions. Then every
`a ∈ A₁` lifts to an element `b` of the equalizer of `p₁` and `p₂`: `p₁ b = p₂ b` and
`πB b = a`.

Geometrically: for a surjective étale chart `U → P` with `U` affine, and a closed subspace
`P₁ ⊂ P` cut out by a square-zero function from the base, if `P₁` is affine then
`Γ(P, 𝒪_P) → Γ(P₁, 𝒪_{P₁})` is surjective. -/
theorem exists_lift_of_cech_of_mul_self_eq_zero
    {B C D : Type*} [CommRing B] [CommRing C] [CommRing D]
    (p₁ p₂ : B →+* C) (e₁₂ e₁₃ e₂₃ : C →+* D)
    (h₁₂₁₃ : e₁₂.comp p₁ = e₁₃.comp p₁) (h₁₂₂₃ : e₁₂.comp p₂ = e₂₃.comp p₁)
    (h₁₃₂₃ : e₁₃.comp p₂ = e₂₃.comp p₂)
    (hp₁ : p₁.Flat) (hp₂ : p₂.Flat) (hr : (e₁₂.comp p₁).Flat)
    (μ : B) (hμ : μ * μ = 0) (hμp : p₁ μ = p₂ μ)
    [Module.FaithfullyFlat A₁ B₁]
    (πB : B →+* B₁) (hπB : Function.Surjective πB) (hμB : πB μ = 0)
    (πC : C →+* B₁ ⊗[A₁] B₁) (hπC : Function.Surjective πC)
    (hkerC : RingHom.ker πC ≤ Ideal.span {p₁ μ})
    (πD : D →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))
    (hC₁ : πC.comp p₁ =
      (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom.comp πB)
    (hC₂ : πC.comp p₂ =
      (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom.comp πB)
    (hD₁₂ : πD.comp e₁₂ = (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom.comp πC)
    (hD₁₃ : πD.comp e₁₃ = (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom.comp πC)
    (hD₂₃ : πD.comp e₂₃ = (Algebra.TensorProduct.includeRight :
      B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)).toRingHom.comp πC)
    (a : A₁) : ∃ b : B, p₁ b = p₂ b ∧ πB b = algebraMap A₁ B₁ a := by
  classical
  set 𝔞B : Ideal B := (Ideal.span {μ}).annihilator with h𝔞B
  set inl : B₁ →+* B₁ ⊗[A₁] B₁ :=
    (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom with hinl
  set inr : B₁ →+* B₁ ⊗[A₁] B₁ :=
    (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom with hinr
  -- the first lift and its defect `μ c`
  obtain ⟨b₀, hb₀⟩ := hπB (algebraMap A₁ B₁ a)
  have hδ : p₁ b₀ - p₂ b₀ ∈ Ideal.span {p₁ μ} := by
    apply hkerC
    rw [RingHom.mem_ker, map_sub, ← RingHom.comp_apply, ← RingHom.comp_apply, hC₁, hC₂]
    simp only [RingHom.comp_apply, hb₀]
    simp [inl, inr, Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.tmul_one_eq_one_tmul]
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hδ
  -- `μ` kills the Čech differential of `c`
  have e13 : e₁₃ (p₁ μ) = e₁₂ (p₁ μ) := (RingHom.congr_fun h₁₂₁₃ μ).symm
  have e23 : e₂₃ (p₁ μ) = e₁₂ (p₁ μ) := by
    rw [← RingHom.comp_apply, ← h₁₂₂₃, RingHom.comp_apply, hμp]
  have hδ0 : e₁₂ (p₁ b₀ - p₂ b₀) - e₁₃ (p₁ b₀ - p₂ b₀) + e₂₃ (p₁ b₀ - p₂ b₀) = 0 := by
    have f1 := RingHom.congr_fun h₁₂₁₃ b₀
    have f2 := RingHom.congr_fun h₁₂₂₃ b₀
    have f3 := RingHom.congr_fun h₁₃₂₃ b₀
    simp only [RingHom.comp_apply] at f1 f2 f3
    simp only [map_sub]
    rw [f1, f2, f3]
    ring
  rw [← hc] at hδ0
  simp only [map_mul] at hδ0
  have hcoc : (e₁₂.comp p₁) μ * (e₁₂ c - e₁₃ c + e₂₃ c) = 0 := by
    rw [RingHom.comp_apply]
    linear_combination hδ0 + e₁₃ c * e13 - e₂₃ c * e23
  have hdc := hr.mem_map_annihilator_of_mul_eq_zero hcoc
  -- the ideal of `T` on `V` is generated from `U` along either projection
  have hmapeq : 𝔞B.map p₁ = 𝔞B.map p₂ := by
    have key : ∀ q q' : B →+* C, q'.Flat → q μ = q' μ → 𝔞B.map q ≤ 𝔞B.map q' := by
      intro q q' hq' hqq y hy
      have := RingHom.mul_eq_zero_of_mem_map_annihilator q hy
      rw [hqq] at this
      exact hq'.mem_map_annihilator_of_mul_eq_zero this
    exact le_antisymm (key p₁ p₂ hp₂ hμp) (key p₂ p₁ hp₁ hμp.symm)
  -- its reduction descends to `A₁`
  set 𝔟 : Ideal B₁ := 𝔞B.map πB with h𝔟
  have hmapπ : ∀ (q : B →+* C) (j : B₁ →+* B₁ ⊗[A₁] B₁), πC.comp q = j.comp πB →
      𝔟.map j = (𝔞B.map q).map πC := by
    intro q j h
    rw [h𝔟, Ideal.map_map, Ideal.map_map, h]
  have hinl𝔟 := hmapπ p₁ inl hC₁
  have hinr𝔟 := hmapπ p₂ inr hC₂
  have hdesc := Ideal.eq_map_comap_of_map_includeLeft_eq (A := A₁) 𝔟
    (by change 𝔟.map inl = 𝔟.map inr; rw [hinl𝔟, hinr𝔟, hmapeq])
  set 𝔞A : Ideal A₁ := 𝔟.comap (algebraMap A₁ B₁) with h𝔞A
  -- the reduced cocycle condition
  have hγ : Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (πC c) -
      Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (πC c) +
      (Algebra.TensorProduct.includeRight :
        B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) (πC c) ∈
      𝔞A.map (algebraMap A₁ (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))) := by
    have h1 := Ideal.mem_map_of_mem πD hdc
    rw [Ideal.map_map, ← RingHom.comp_assoc, hD₁₂, RingHom.comp_assoc, hC₁,
      ← RingHom.comp_assoc, ← Ideal.map_map, ← h𝔟, hdesc, Ideal.map_map] at h1
    convert h1 using 2
    · ext x
      simp [inl, Algebra.TensorProduct.one_def]
    · rw [map_add, map_sub, ← RingHom.comp_apply πD e₁₂, ← RingHom.comp_apply πD e₁₃,
        ← RingHom.comp_apply πD e₂₃, hD₁₂, hD₁₃, hD₂₃]
      rfl
  -- the coboundary, and the correction
  obtain ⟨β, hβ⟩ := exists_sub_mem_map_of_cocycle 𝔞A (πC c) hγ
  obtain ⟨b', rfl⟩ := hπB β
  have hβ' : πC c - (inl (πB b') - inr (πB b')) ∈ (𝔞B.map p₁).map πC := by
    rw [← hinl𝔟]
    nth_rewrite 1 [hdesc]
    rw [Ideal.map_map]
    convert hβ using 2
    · ext x
      simp [inl]
    · rfl
  obtain ⟨c₀, hc₀, hc₀'⟩ := (Ideal.mem_map_iff_of_surjective πC hπC).1 hβ'
  have hc₀μ : p₁ μ * c₀ = 0 := RingHom.mul_eq_zero_of_mem_map_annihilator p₁ hc₀
  have hker : c - (p₁ b' - p₂ b') - c₀ ∈ Ideal.span {p₁ μ} := by
    apply hkerC
    rw [RingHom.mem_ker, map_sub, map_sub, map_sub, hc₀', ← RingHom.comp_apply,
      ← RingHom.comp_apply πC p₂, hC₁, hC₂]
    simp only [RingHom.comp_apply]
    abel
  obtain ⟨k, hk⟩ := Ideal.mem_span_singleton'.1 hker
  have hsq : p₁ μ * p₁ μ = 0 := by rw [← map_mul, hμ, map_zero]
  refine ⟨b₀ - μ * b', ?_, ?_⟩
  · simp only [map_sub, map_mul]
    rw [← hμp]
    linear_combination -hc - p₁ μ * hk + hc₀μ + k * hsq
  · rw [map_sub, map_mul, hμB, zero_mul, sub_zero, hb₀]

end Module.Descent
