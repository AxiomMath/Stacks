module

public import StacksFrontier.RingTheory.Descent.CechModuleDescent
public import StacksFrontier.RingTheory.Descent.CechNerveQuotient

/-!
# A square-zero invariant ideal of an affine nerve is generated by invariant elements

Let `B ⇉ C ⇉ D` be a Čech nerve as in `Module.Descent.IsNerveReduction`, and let `N` be an ideal
of `B` with `N * N = 0` whose two extensions to `C` agree. If the nerve is affine modulo `N`, that
is `IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ N`, then `N` is generated by finitely many *invariant*
elements, `μ` with `p₁ μ = p₂ μ`, as soon as it is finitely generated:
`Module.Descent.exists_invariant_span_eq_of_mul_self_eq_bot`.

Geometrically: on a first-order thickening `V(N) ⊂ W` of an affine `V(N)`, the ideal sheaf is a
quasi-coherent module on `V(N)` and is therefore generated by global sections, which are global
functions on `W`. The proof is `Module.Descent.exists_fin_invariant_span_eq_top` applied to the
three modules of sections `N`, `N C`, `N D` of that ideal sheaf on the nerve, read as modules over
the nerve of `V(N)`; the two base-change comparisons it needs come from flatness of the
projections of the nerve.

## Main results

* `Module.Descent.moduleOfSurjective`: a module killed by the kernel of a surjection, as a module
  over the target.
* `Module.Descent.injective_mulMap` and `Module.Descent.tmul_eq_of_sub_mem`: the base-change
  comparison `E ⊗_B N → E` of an ideal along a flat map, and its independence of the first factor
  modulo `N E` when `N * N = 0`.

The main statement, `Module.Descent.exists_invariant_span_eq_of_mul_self_eq_bot`, is assembled
from these and `Module.Descent.exists_fin_invariant_span_eq_top`.

## References

* [Stacks Project, Tag 023M](https://stacks.math.columbia.edu/tag/023M)
* [Stacks Project, Tag 03DX](https://stacks.math.columbia.edu/tag/03DX)
-/

@[expose] public section

open TensorProduct

namespace Module.Descent

/-! ### Modules over a quotient by a surjection -/

section QuotModule

variable {B B₁ M : Type*} [CommRing B] [CommRing B₁] [AddCommGroup M] [Module B M]

/-- A module over `B` killed by the kernel of a surjection `π : B → B₁`, as a module over `B₁`. -/
noncomputable abbrev moduleOfSurjective (π : B →+* B₁) (hπ : Function.Surjective π)
    (hM : Module.IsTorsionBySet B M (RingHom.ker π)) : Module B₁ M :=
  letI := hM.module
  Module.compHom M (RingHom.quotientKerEquivOfSurjective hπ).symm.toRingHom

/-- In `moduleOfSurjective π hπ hM`, the element `π β` acts on `M` as `β` does. -/
lemma moduleOfSurjective_smul (π : B →+* B₁) (hπ : Function.Surjective π)
    (hM : Module.IsTorsionBySet B M (RingHom.ker π)) (β : B) (m : M) :
    (moduleOfSurjective π hπ hM).toSMul.smul (π β) m = β • m := by
  let := hM.module
  change ((RingHom.quotientKerEquivOfSurjective hπ).symm (π β)) • m = β • m
  have : (RingHom.quotientKerEquivOfSurjective hπ).symm (π β) = Ideal.Quotient.mk _ β := by
    rw [RingEquiv.symm_apply_eq]; rfl
  rw [this]
  exact hM.mk_smul β m

end QuotModule

/-! ### The base-change comparison of a square-zero ideal along a flat map -/

section Flat

variable {B E : Type*} [CommRing B] [CommRing E] (g : B →+* E) (N : Ideal B)

/-- The multiplication map `E ⊗_B N → N E` of a flat extension, `e ⊗ n ↦ e · g n`. -/
noncomputable def mulMap :
    letI := g.toAlgebra
    E ⊗[B] N →ₗ[B] E :=
  letI := g.toAlgebra
  (TensorProduct.rid B E).toLinearMap ∘ₗ LinearMap.lTensor E N.subtype

/-- `mulMap g N` sends `e ⊗ n` to `e * g n`. -/
lemma mulMap_tmul (e : E) (n : N) :
    letI := g.toAlgebra
    mulMap g N (e ⊗ₜ[B] n) = e * g n := by
  let := g.toAlgebra
  simp [mulMap, Algebra.smul_def, mul_comm]
  rfl

/-- For a flat ring map `g`, the multiplication map `E ⊗_B N → E` is injective. -/
lemma injective_mulMap (hg : g.Flat) :
    letI := g.toAlgebra
    Function.Injective (mulMap g N) := by
  let := g.toAlgebra
  have : Module.Flat B E := hg
  exact (TensorProduct.rid B E).injective.comp
    (Module.Flat.lTensor_preserves_injective_linearMap N.subtype Subtype.val_injective)

/-- A square-zero ideal `N` kills itself: `a • n = 0` for `a ∈ N` and `n : N`. -/
private lemma smul_eq_zero_of_mul_self_eq_bot {B : Type*} [CommRing B] {N : Ideal B}
    (hN : N * N = ⊥) {a : B} (ha : a ∈ N) (n : N) : a • n = 0 := by
  apply Subtype.ext
  have hmem : a * (n : B) ∈ N * N := Ideal.mul_mem_mul ha n.2
  rw [hN] at hmem
  simpa using hmem

/-- In `E ⊗_B N`, with `N * N = 0`, the class of `e ⊗ n` depends on `e` only modulo `N E`. -/
lemma tmul_eq_of_sub_mem (hN : N * N = ⊥) {e e' : E} (h : e - e' ∈ N.map g) (n : N) :
    letI := g.toAlgebra
    e ⊗ₜ[B] n = e' ⊗ₜ[B] n := by
  let := g.toAlgebra
  rw [← sub_eq_zero, ← TensorProduct.sub_tmul]
  generalize e - e' = d at h
  refine Submodule.span_induction (p := fun d _ => d ⊗ₜ[B] n = 0) ?_ ?_ ?_ ?_ h
  · rintro _ ⟨k, hk, rfl⟩
    rw [show g k = k • (1 : E) from Algebra.algebraMap_eq_smul_one k, TensorProduct.smul_tmul,
      smul_eq_zero_of_mul_self_eq_bot hN hk, TensorProduct.tmul_zero]
  · simp
  · intro x y _ _ hx hy; rw [TensorProduct.add_tmul, hx, hy, add_zero]
  · intro a x _ hx
    rw [smul_eq_mul, ← smul_eq_mul, ← TensorProduct.smul_tmul', hx, smul_zero]

/-- **Maps out of the extension of an ideal along a flat map.** An additive pairing
`ρ : E × N → X`, balanced along `g`, induces an additive map on `N E` sending `e · g n` to
`ρ e n`: the extension is the base change `E ⊗_B N`, by flatness. -/
theorem exists_addHom_map_of_flat (hg : g.Flat) {X : Type*} [AddCommGroup X] (ρ : E →+ N →+ X)
    (hρ : ∀ (β : B) (e : E) (n : N), ρ (g β * e) n = ρ e (β • n)) :
    ∃ Φ : ↥(N.map g) →+ X, ∀ (e : E) (n : N),
      Φ ⟨e * g n, Ideal.mul_mem_left _ e (Ideal.mem_map_of_mem g n.2)⟩ = ρ e n := by
  classical
  let := g.toAlgebra
  have hinj := injective_mulMap g N hg
  have hrange : ∀ y : E, y ∈ N.map g ↔ y ∈ LinearMap.range (mulMap g N) := by
    intro y
    constructor
    · intro hy
      refine Submodule.span_induction (p := fun y _ => y ∈ LinearMap.range (mulMap g N)) ?_ ?_
        ?_ ?_ hy
      · rintro _ ⟨n, hn, rfl⟩
        exact ⟨1 ⊗ₜ[B] ⟨n, hn⟩, by rw [mulMap_tmul, one_mul]⟩
      · exact zero_mem _
      · intro x y _ _ hx hy; exact add_mem hx hy
      · rintro a x _ ⟨t, rfl⟩
        have key : ∀ t' : E ⊗[B] N, mulMap g N (a • t') = a • mulMap g N t' := by
          intro t'
          induction t' with
          | tmul e n =>
            rw [TensorProduct.smul_tmul', mulMap_tmul, mulMap_tmul, smul_eq_mul, smul_eq_mul,
              mul_assoc]
          | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]
        exact ⟨a • t, key t⟩
    · rintro ⟨t, rfl⟩
      induction t with
      | tmul e n => rw [mulMap_tmul]; exact Ideal.mul_mem_left _ e (Ideal.mem_map_of_mem g n.2)
      | add x y hx hy => rw [map_add]; exact add_mem hx hy
  let Ψ : E ⊗[B] N →+ ↥(N.map g) :=
    { toFun := fun t => ⟨mulMap g N t, (hrange _).2 ⟨t, rfl⟩⟩
      map_zero' := by ext; simp
      map_add' := fun x y => by ext; simp }
  have hΨ : Function.Bijective Ψ := by
    refine ⟨fun x y h => hinj (congrArg Subtype.val h), fun y => ?_⟩
    obtain ⟨t, ht⟩ := (hrange y).1 y.2
    exact ⟨t, Subtype.ext ht⟩
  let e := AddEquiv.ofBijective Ψ hΨ
  let T : E ⊗[B] N →+ X := TensorProduct.liftAddHom ρ fun β e n => by
    rw [Algebra.smul_def]; exact hρ β e n
  refine ⟨T.comp e.symm.toAddMonoidHom, fun e' n => ?_⟩
  have : e.symm ⟨e' * g n, Ideal.mul_mem_left _ e' (Ideal.mem_map_of_mem g n.2)⟩ =
      e' ⊗ₜ[B] n := by
    rw [AddEquiv.symm_apply_eq]
    exact Subtype.ext (mulMap_tmul g N e' n).symm
  simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom, this, T,
    TensorProduct.liftAddHom_tmul]

end Flat

/-! ### Semilinear maps between modules over surjective images -/

section Semilinear

/-- An additive map, semilinear along `σ` for the actions of the sources of two surjections, is
semilinear along `τ` for the actions of their targets when `π₂ ∘ σ = τ ∘ π₁`. -/
lemma map_smul_of_lift {X₁ X₂ Y₁ Y₂ M₁ M₂ : Type*} [CommRing X₁] [CommRing X₂] [CommRing Y₁]
    [CommRing Y₂] [AddCommGroup M₁] [AddCommGroup M₂] [Module X₁ M₁] [Module Y₁ M₁]
    [Module X₂ M₂] [Module Y₂ M₂] (π₁ : X₁ →+* Y₁) (π₂ : X₂ →+* Y₂)
    (hs : Function.Surjective π₁) (s₁ : ∀ (x : X₁) (m : M₁), π₁ x • m = x • m)
    (s₂ : ∀ (x : X₂) (m : M₂), π₂ x • m = x • m) (σ : X₁ →+* X₂) (τ : Y₁ →+* Y₂)
    (hστ : ∀ x, π₂ (σ x) = τ (π₁ x)) (f : M₁ →+ M₂) (hf : ∀ x m, f (x • m) = σ x • f m)
    (y : Y₁) (m : M₁) : f (y • m) = τ y • f m := by
  obtain ⟨x, rfl⟩ := hs y
  rw [s₁, hf, ← hστ, s₂]

variable {A Y₁ Y₂ M₁ M₂ : Type*} [CommRing A] [CommRing Y₁] [CommRing Y₂] [Algebra A Y₁]
  [Algebra A Y₂] [AddCommGroup M₁] [AddCommGroup M₂] [Module A M₁] [Module Y₁ M₁]
  [IsScalarTower A Y₁ M₁] [Module A M₂] [Module Y₂ M₂] [IsScalarTower A Y₂ M₂]

/-- An additive map semilinear along an `A`-algebra map is `A`-linear. -/
noncomputable def linearOfSemilinear (τ : Y₁ →ₐ[A] Y₂) (f : M₁ →+ M₂)
    (hf : ∀ y m, f (y • m) = τ y • f m) : M₁ →ₗ[A] M₂ where
  toFun := f
  map_add' := f.map_add
  map_smul' a m := by
    rw [← algebraMap_smul Y₁ a m, hf, AlgHom.commutes, algebraMap_smul]
    rfl

/-- `linearOfSemilinear τ f hf` agrees with `f` pointwise. -/
@[simp]
lemma linearOfSemilinear_apply (τ : Y₁ →ₐ[A] Y₂) (f : M₁ →+ M₂)
    (hf : ∀ y m, f (y • m) = τ y • f m) (m : M₁) : linearOfSemilinear τ f hf m = f m := rfl

/-- An additive map `f` with `f (τ y • m) = y • f m` for an `A`-algebra map `τ` is `A`-linear. -/
noncomputable def linearOfSemilinear' (τ : Y₂ →ₐ[A] Y₁) (f : M₁ →+ M₂)
    (hf : ∀ y m, f (τ y • m) = y • f m) : M₁ →ₗ[A] M₂ where
  toFun := f
  map_add' := f.map_add
  map_smul' a m := by
    rw [← algebraMap_smul Y₁ a m, ← AlgHom.commutes τ, hf, algebraMap_smul]
    rfl

/-- `linearOfSemilinear' τ f hf` agrees with `f` pointwise. -/
@[simp]
lemma linearOfSemilinear'_apply (τ : Y₂ →ₐ[A] Y₁) (f : M₁ →+ M₂)
    (hf : ∀ y m, f (τ y • m) = y • f m) (m : M₁) : linearOfSemilinear' τ f hf m = f m := rfl

end Semilinear

/-! ### Maps of ideals -/

section IdealMap

variable {X Y : Type*} [CommRing X] [CommRing Y]

/-- If `J` is the extension of `N` along `p` and `f ∘ p` maps `N` into `K`, then `f` maps `J`
into `K`. -/
private lemma mem_of_map_eq {X Y Z : Type*} [CommRing X] [CommRing Y] [CommRing Z] (p : X →+* Y)
    (f : Y →+* Z) {N : Ideal X} {J : Ideal Y} {K : Ideal Z} (hJ : J = N.map p)
    (h : ∀ x ∈ N, f (p x) ∈ K) : ∀ y ∈ J, f y ∈ K := by
  subst hJ
  exact fun _ hy => (Ideal.map_le_iff_le_comap (K := K.comap f)).2 h hy

/-- The restriction of a ring map to an ideal landing in an ideal. -/
def idealMap (f : X →+* Y) (I : Ideal X) (J : Ideal Y) (h : ∀ x ∈ I, f x ∈ J) : I →+ J where
  toFun x := ⟨f x.1, h x.1 x.2⟩
  map_zero' := Subtype.ext (map_zero f)
  map_add' x y := Subtype.ext (map_add f x.1 y.1)

/-- `idealMap f I J h` sends `x` to `f x`. -/
@[simp]
lemma coe_idealMap (f : X →+* Y) (I : Ideal X) (J : Ideal Y) (h : ∀ x ∈ I, f x ∈ J) (x : I) :
    (idealMap f I J h x : Y) = f (x : X) := rfl

/-- `idealMap f I J h` is semilinear along `f`: it sends `a • x` to `f a • idealMap f I J h x`. -/
lemma idealMap_smul (f : X →+* Y) (I : Ideal X) (J : Ideal Y) (h : ∀ x ∈ I, f x ∈ J) (a : X)
    (x : I) : idealMap f I J h (a • x) = f a • idealMap f I J h x :=
  Subtype.ext (by simp [smul_eq_mul, map_mul])

end IdealMap

/-! ### The base-change comparisons of a square-zero ideal of a nerve -/

section Comparison

variable {A₁ B₁ : Type*} [CommRing A₁] [CommRing B₁] [Algebra A₁ B₁]
  {N : Type*} [AddCommGroup N] [Module A₁ N] [Module B₁ N] [IsScalarTower A₁ B₁ N]

/-- `b ⊗ b' ↦ b ⊗ (b' • n)`, the action of the second factor on a fixed `n`. -/
noncomputable def actRight (n : N) : B₁ ⊗[A₁] B₁ →ₗ[A₁] B₁ ⊗[A₁] N :=
  LinearMap.lTensor B₁ ((Algebra.lsmul A₁ A₁ N).toLinearMap.flip n)

/-- `actRight n` sends `b ⊗ b'` to `b ⊗ (b' • n)`. -/
@[simp]
lemma actRight_tmul (n : N) (b b' : B₁) : actRight n (b ⊗ₜ[A₁] b') = b ⊗ₜ[A₁] (b' • n) := rfl

/-- `actRight n` is additive in `n`. -/
lemma actRight_add (n n' : N) (x : B₁ ⊗[A₁] B₁) :
    actRight (n + n') x = actRight n x + actRight n' x := by
  induction x with
  | tmul b b' => simp [smul_add, TensorProduct.tmul_add]
  | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]; abel

/-- Multiplying by `1 ⊗ b` before `actRight n` is `actRight (b • n)`. -/
lemma actRight_mul (n : N) (b : B₁) (x : B₁ ⊗[A₁] B₁) :
    actRight n (((1 : B₁) ⊗ₜ[A₁] b) * x) = actRight (b • n) x := by
  induction x with
  | tmul c c' => simp [Algebra.TensorProduct.tmul_mul_tmul, mul_smul, mul_comm b]
  | add x y hx hy => rw [mul_add, map_add, map_add, hx, hy]

/-- `b ⊗ (b' ⊗ b'') ↦ b ⊗ (b' ⊗ (b'' • n))`. -/
noncomputable def actRight₃ (n : N) : B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁) →ₗ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] N) :=
  LinearMap.lTensor B₁ (actRight n)

/-- `actRight₃ n` sends `b ⊗ (b' ⊗ b'')` to `b ⊗ (b' ⊗ (b'' • n))`. -/
@[simp]
lemma actRight₃_tmul (n : N) (b b' b'' : B₁) :
    actRight₃ n (b ⊗ₜ[A₁] (b' ⊗ₜ[A₁] b'')) = b ⊗ₜ[A₁] (b' ⊗ₜ[A₁] (b'' • n)) := rfl

/-- `actRight₃ n` is additive in `n`. -/
lemma actRight₃_add (n n' : N) (x : B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) :
    actRight₃ (n + n') x = actRight₃ n x + actRight₃ n' x := by
  induction x with
  | tmul b y => simp [actRight₃, actRight_add, TensorProduct.tmul_add]
  | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]; abel

/-- Multiplying by `1 ⊗ (1 ⊗ b)` before `actRight₃ n` is `actRight₃ (b • n)`. -/
lemma actRight₃_mul (n : N) (b : B₁) (x : B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) :
    actRight₃ n (((1 : B₁) ⊗ₜ[A₁] ((1 : B₁) ⊗ₜ[A₁] b)) * x) = actRight₃ (b • n) x := by
  induction x with
  | tmul c y =>
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
    simp only [actRight₃, LinearMap.lTensor_tmul, actRight_mul]
  | add x y hx hy => rw [mul_add, map_add, map_add, hx, hy]

end Comparison

/-! ### The comparisons for a square-zero ideal of a nerve -/

section NerveIdeal

variable {B C D A₁ B₁ : Type*} [CommRing B] [CommRing C] [CommRing D] [CommRing A₁]
  [CommRing B₁] [Algebra A₁ B₁]
  {πB : B →+* B₁} {πC : C →+* B₁ ⊗[A₁] B₁} {πD : D →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)}
  {N : Ideal B} [Module B₁ N] [Module A₁ N] [IsScalarTower A₁ B₁ N]
  {J : Ideal C} [Module (B₁ ⊗[A₁] B₁) J] [Module A₁ J] [IsScalarTower A₁ (B₁ ⊗[A₁] B₁) J]
  {L : Ideal D} [Module (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) L] [Module A₁ L]
  [IsScalarTower A₁ (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) L]

/-- **The extension of a square-zero ideal along the second projection is its base change.** -/
theorem bijective_cechComparison_ideal {p₁ p₂ : B →+* C} (hp₂ : p₂.Flat) (hJ : J = N.map p₂)
    (hsB : Function.Surjective πB)
    (sB : ∀ (β : B) (n : N), πB β • n = β • n) (sC : ∀ (γ : C) (y : J), πC γ • y = γ • y)
    (hC₁ : ∀ β, πC (p₁ β) = πB β ⊗ₜ[A₁] (1 : B₁))
    (hC₂ : ∀ β, πC (p₂ β) = (1 : B₁) ⊗ₜ[A₁] πB β)
    (φ₂ : N →ₗ[A₁] J) (hφ₂ : ∀ n, (φ₂ n : C) = p₂ n) :
    Function.Bijective (cechComparison (B₀ := B₁) φ₂) := by
  classical
  subst hJ
  have hφs : ∀ (b : B₁) (n : N), φ₂ (b • n) = ((1 : B₁) ⊗ₜ[A₁] b) • φ₂ n := by
    intro b n
    obtain ⟨β, rfl⟩ := hsB b
    rw [sB, ← hC₂, sC]
    apply Subtype.ext
    rw [hφ₂, Submodule.coe_smul, Submodule.coe_smul, hφ₂, smul_eq_mul, smul_eq_mul, map_mul]
  let ρ : C →+ N →+ B₁ ⊗[A₁] N :=
    AddMonoidHom.mk' (fun c => AddMonoidHom.mk' (fun n => actRight n (πC c))
      (fun n n' => actRight_add n n' _)) (fun c c' => by ext n; simp)
  have hρ : ∀ c n, ρ c n = actRight n (πC c) := fun _ _ => rfl
  obtain ⟨Ψ, hΨ⟩ := exists_addHom_map_of_flat p₂ N hp₂ ρ (fun β c n => by
    rw [hρ, hρ, map_mul, hC₂, actRight_mul, sB])
  have hleft : ∀ x, Ψ (cechComparison φ₂ x) = x := by
    intro x
    induction x with
    | tmul b n =>
      obtain ⟨β, rfl⟩ := hsB b
      have e : cechComparison φ₂ (πB β ⊗ₜ[A₁] n) =
          ⟨p₁ β * p₂ n, Ideal.mul_mem_left _ (p₁ β) (Ideal.mem_map_of_mem p₂ n.2)⟩ := by
        rw [cechComparison_tmul, ← hC₁, sC]
        exact Subtype.ext (by rw [Submodule.coe_smul, hφ₂, smul_eq_mul])
      rw [e, hΨ, hρ, hC₁, actRight_tmul, one_smul]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hright : ∀ (n : N) (x : B₁ ⊗[A₁] B₁), cechComparison φ₂ (actRight n x) = x • φ₂ n := by
    intro n x
    induction x with
    | tmul b b' =>
      rw [actRight_tmul, cechComparison_tmul, hφs, smul_smul,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, add_smul]
  have key : ∀ (y : N.map p₂) (c : C), cechComparison φ₂ (Ψ (c • y)) = c • y := by
    rintro ⟨y, hy⟩
    refine Submodule.span_induction (p := fun y hy => ∀ c : C,
      cechComparison φ₂ (Ψ (c • (⟨y, hy⟩ : N.map p₂))) = c • (⟨y, hy⟩ : N.map p₂))
      ?_ ?_ ?_ ?_ hy
    · rintro x ⟨n, hn, rfl⟩ c
      have e : c • (⟨p₂ n, Ideal.subset_span ⟨n, hn, rfl⟩⟩ : N.map p₂) =
          ⟨c * p₂ (⟨n, hn⟩ : N), Ideal.mul_mem_left _ c (Ideal.mem_map_of_mem p₂ hn)⟩ := rfl
      rw [e, hΨ, hρ, hright, sC, ← e]
      congr 1
      exact Subtype.ext (hφ₂ _)
    · intro c
      change cechComparison φ₂ (Ψ (c • (0 : N.map p₂))) = c • (0 : N.map p₂)
      simp
    · intro x y hx hy ihx ihy c
      have e : (⟨x + y, Submodule.add_mem _ hx hy⟩ : N.map p₂) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
      rw [e, smul_add, map_add, map_add, ihx, ihy]
    · intro a x hx ih c
      have e : (⟨a • x, Submodule.smul_mem _ a hx⟩ : N.map p₂) = a • ⟨x, hx⟩ := rfl
      rw [e, smul_smul, ih]
  refine ⟨Function.LeftInverse.injective hleft, fun y => ⟨Ψ y, ?_⟩⟩
  simpa using key y 1

omit [Module (B₁ ⊗[A₁] B₁) J] [IsScalarTower A₁ (B₁ ⊗[A₁] B₁) J] in
/-- **The extension of a square-zero ideal along the third projection receives its base change
injectively.** -/
theorem injective_cechComparison₃_ideal {p₁ p₂ : B →+* C} {e₁₂ e₂₃ : C →+* D}
    (hg : (e₂₃.comp p₂).Flat) (hL : L = N.map (e₂₃.comp p₂))
    (hsB : Function.Surjective πB)
    (sB : ∀ (β : B) (n : N), πB β • n = β • n) (sD : ∀ (d : D) (z : L), πD d • z = d • z)
    (hπ₁₂ : ∀ β, πD (e₁₂ (p₁ β)) = πB β ⊗ₜ[A₁] ((1 : B₁) ⊗ₜ[A₁] (1 : B₁)))
    (hπ₂₃ : ∀ β, πD (e₂₃ (p₁ β)) = (1 : B₁) ⊗ₜ[A₁] (πB β ⊗ₜ[A₁] (1 : B₁)))
    (hπ₂₃' : ∀ β, πD (e₂₃ (p₂ β)) = (1 : B₁) ⊗ₜ[A₁] ((1 : B₁) ⊗ₜ[A₁] πB β))
    (φ₂ : N →ₗ[A₁] J) (hφ₂ : ∀ n, (φ₂ n : C) = p₂ n)
    (χ₂₃ : J →ₗ[A₁] L) (hχ : ∀ y, (χ₂₃ y : D) = e₂₃ y) :
    Function.Injective (cechComparison₃ (B₀ := B₁) φ₂ χ₂₃) := by
  classical
  subst hL
  let ρ : D →+ N →+ B₁ ⊗[A₁] (B₁ ⊗[A₁] N) :=
    AddMonoidHom.mk' (fun d => AddMonoidHom.mk' (fun n => actRight₃ n (πD d))
      (fun n n' => actRight₃_add n n' _)) (fun d d' => by ext n; simp)
  have hρ : ∀ d n, ρ d n = actRight₃ n (πD d) := fun _ _ => rfl
  obtain ⟨Ψ, hΨ⟩ := exists_addHom_map_of_flat (e₂₃.comp p₂) N hg ρ (fun β d n => by
    rw [hρ, hρ, map_mul, RingHom.comp_apply, hπ₂₃', actRight₃_mul, sB])
  refine Function.LeftInverse.injective (g := Ψ) fun x => ?_
  induction x with
  | tmul b y =>
    induction y with
    | tmul b' n =>
      obtain ⟨β, rfl⟩ := hsB b
      obtain ⟨β', rfl⟩ := hsB b'
      have e1 : πB β ⊗ₜ[A₁] (πB β' ⊗ₜ[A₁] (1 : B₁)) = πD (e₁₂ (p₁ β) * e₂₃ (p₁ β')) := by
        rw [map_mul, hπ₁₂, hπ₂₃, Algebra.TensorProduct.tmul_mul_tmul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, one_mul]
      have e : cechComparison₃ φ₂ χ₂₃ (πB β ⊗ₜ[A₁] (πB β' ⊗ₜ[A₁] n)) =
          ⟨(e₁₂ (p₁ β) * e₂₃ (p₁ β')) * (e₂₃.comp p₂) n,
            Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem (e₂₃.comp p₂) n.2)⟩ := by
        rw [cechComparison₃_tmul, e1, sD]
        exact Subtype.ext (by rw [Submodule.coe_smul, hχ, hφ₂, smul_eq_mul]; rfl)
      rw [e, hΨ, hρ, ← e1, actRight₃_tmul, one_smul]
    | add y y' hy hy' => rw [TensorProduct.tmul_add, map_add, map_add, hy, hy']
  | add x y hx hy => rw [map_add, map_add, hx, hy]

end NerveIdeal

/-! ### Invariant generators of a square-zero ideal of a nerve -/

section Assembly

variable {B C D A₁ B₁ : Type*} [CommRing B] [CommRing C] [CommRing D] [CommRing A₁]
  [CommRing B₁] [Algebra A₁ B₁]
  {πB : B →+* B₁} {πC : C →+* B₁ ⊗[A₁] B₁} {πD : D →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)}
  {N : Ideal B} [Module B₁ N] [Module A₁ N] [IsScalarTower A₁ B₁ N]
  {J : Ideal C} [Module (B₁ ⊗[A₁] B₁) J] [Module A₁ J] [IsScalarTower A₁ (B₁ ⊗[A₁] B₁) J]
  {L : Ideal D} [Module (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) L] [Module A₁ L]
  [IsScalarTower A₁ (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) L]

/-- **The modules of sections of a square-zero ideal on a nerve are generated by invariant
elements.** The ideal `N` of `B`, read as a module over `B₁ = B ⧸ N`, with its extensions `J`,
`L` to `C`, `D` read over `B₁ ⊗ B₁` and `B₁ ⊗ B₁ ⊗ B₁`, is finitely generated by elements `n`
with `p₁ n = p₂ n` as soon as it is finite over `B₁`. -/
theorem exists_fin_invariant_span_ideal [Module.FaithfullyFlat A₁ B₁] [Module.Finite B₁ N]
    {p₁ p₂ : B →+* C} {δ : C →+* B} {e₁₂ e₁₃ e₂₃ : C →+* D}
    (hδ₁ : ∀ β, δ (p₁ β) = β) (hδ₂ : ∀ β, δ (p₂ β) = β)
    (h₁₂₁₃ : ∀ β, e₁₂ (p₁ β) = e₁₃ (p₁ β)) (h₁₂₂₃ : ∀ β, e₁₂ (p₂ β) = e₂₃ (p₁ β))
    (h₁₃₂₃ : ∀ β, e₁₃ (p₂ β) = e₂₃ (p₂ β))
    (hp₂ : p₂.Flat) (hg : (e₂₃.comp p₂).Flat)
    (hJ₁ : J = N.map p₁) (hJ₂ : J = N.map p₂) (hL₁ : L = N.map (e₁₂.comp p₁))
    (hL₃ : L = N.map (e₂₃.comp p₂))
    (hsB : Function.Surjective πB) (hsC : Function.Surjective πC)
    (sB : ∀ (β : B) (n : N), πB β • n = β • n) (sC : ∀ (γ : C) (y : J), πC γ • y = γ • y)
    (sD : ∀ (d : D) (z : L), πD d • z = d • z)
    (hC₁ : ∀ β, πC (p₁ β) = πB β ⊗ₜ[A₁] (1 : B₁))
    (hC₂ : ∀ β, πC (p₂ β) = (1 : B₁) ⊗ₜ[A₁] πB β)
    (hD₁₂ : ∀ γ, πD (e₁₂ γ) = Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (πC γ))
    (hD₁₃ : ∀ γ, πD (e₁₃ γ) = Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (πC γ))
    (hD₂₃ : ∀ γ, πD (e₂₃ γ) = (Algebra.TensorProduct.includeRight :
      B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) (πC γ)) :
    ∃ (r : ℕ) (g : Fin r → N), (∀ i, p₁ (g i) = p₂ (g i)) ∧
      Submodule.span B₁ (Set.range g) = ⊤ := by
  classical
  have mJ₁ : ∀ x ∈ N, p₁ x ∈ J := fun x hx => hJ₁ ▸ Ideal.mem_map_of_mem p₁ hx
  have mJ₂ : ∀ x ∈ N, p₂ x ∈ J := fun x hx => hJ₂ ▸ Ideal.mem_map_of_mem p₂ hx
  have mN : ∀ y ∈ J, δ y ∈ N := mem_of_map_eq p₁ δ hJ₁ fun x hx => by rw [hδ₁]; exact hx
  have mL₁₂ : ∀ y ∈ J, e₁₂ y ∈ L := mem_of_map_eq p₁ e₁₂ hJ₁ fun x hx => by
    rw [hL₁]; exact Ideal.mem_map_of_mem (e₁₂.comp p₁) hx
  have mL₁₃ : ∀ y ∈ J, e₁₃ y ∈ L := mem_of_map_eq p₁ e₁₃ hJ₁ fun x hx => by
    rw [← h₁₂₁₃, hL₁]; exact Ideal.mem_map_of_mem (e₁₂.comp p₁) hx
  have mL₂₃ : ∀ y ∈ J, e₂₃ y ∈ L := mem_of_map_eq p₂ e₂₃ hJ₂ fun x hx => by
    rw [hL₃]; exact Ideal.mem_map_of_mem (e₂₃.comp p₂) hx
  let τ₁ : B₁ →+* B₁ ⊗[A₁] B₁ :=
    (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom
  let τ₂ : B₁ →+* B₁ ⊗[A₁] B₁ :=
    (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom
  let τ₁₂ : B₁ ⊗[A₁] B₁ →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁) := (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom
  let τ₁₃ : B₁ ⊗[A₁] B₁ →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁) := (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom
  let τ₂₃ : B₁ ⊗[A₁] B₁ →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁) := (Algebra.TensorProduct.includeRight :
      B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)).toRingHom
  have sφ₁ := map_smul_of_lift πB πC hsB sB sC p₁ τ₁ hC₁ _ (idealMap_smul p₁ N J mJ₁)
  have sφ₂ := map_smul_of_lift πB πC hsB sB sC p₂ τ₂ hC₂ _ (idealMap_smul p₂ N J mJ₂)
  have sχ₁₂ := map_smul_of_lift πC πD hsC sC sD e₁₂ τ₁₂ hD₁₂ _ (idealMap_smul e₁₂ J L mL₁₂)
  have sχ₁₃ := map_smul_of_lift πC πD hsC sC sD e₁₃ τ₁₃ hD₁₃ _ (idealMap_smul e₁₃ J L mL₁₃)
  have sχ₂₃ := map_smul_of_lift πC πD hsC sC sD e₂₃ τ₂₃ hD₂₃ _ (idealMap_smul e₂₃ J L mL₂₃)
  let φ₁ : N →ₗ[A₁] J := linearOfSemilinear
    (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (idealMap p₁ N J mJ₁)
    sφ₁
  let φ₂ : N →ₗ[A₁] J := linearOfSemilinear
    (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (idealMap p₂ N J mJ₂)
    sφ₂
  have hθ : ∀ (b : B₁) (y : J), idealMap δ J N mN
      ((Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) b • y) =
        b • idealMap δ J N mN y := by
    intro b y
    obtain ⟨β, rfl⟩ := hsB b
    rw [Algebra.TensorProduct.includeLeft_apply, ← hC₁, sC, idealMap_smul, hδ₁, sB]
  let θ : J →ₗ[A₁] N := linearOfSemilinear'
    (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (idealMap δ J N mN) hθ
  let χ₁₂ : J →ₗ[A₁] L := linearOfSemilinear
    (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)) (idealMap e₁₂ J L mL₁₂)
    sχ₁₂
  let χ₁₃ : J →ₗ[A₁] L := linearOfSemilinear
    (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
      (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)) (idealMap e₁₃ J L mL₁₃)
    sχ₁₃
  let χ₂₃ : J →ₗ[A₁] L := linearOfSemilinear
    (Algebra.TensorProduct.includeRight : B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))
    (idealMap e₂₃ J L mL₂₃)
    sχ₂₃
  have hπ₁₂ : ∀ β, πD (e₁₂ (p₁ β)) = πB β ⊗ₜ[A₁] ((1 : B₁) ⊗ₜ[A₁] (1 : B₁)) := fun β => by
    rw [hD₁₂, hC₁, Algebra.TensorProduct.map_tmul, map_one]; rfl
  have hπ₂₃ : ∀ β, πD (e₂₃ (p₁ β)) = (1 : B₁) ⊗ₜ[A₁] (πB β ⊗ₜ[A₁] (1 : B₁)) := fun β => by
    rw [hD₂₃, hC₁]; rfl
  have hπ₂₃' : ∀ β, πD (e₂₃ (p₂ β)) = (1 : B₁) ⊗ₜ[A₁] ((1 : B₁) ⊗ₜ[A₁] πB β) := fun β => by
    rw [hD₂₃, hC₂]; rfl
  have hτ : ∀ (i : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁) (b : B₁), Algebra.TensorProduct.map (AlgHom.id A₁ B₁) i
      (b ⊗ₜ[A₁] (1 : B₁)) = b ⊗ₜ[A₁] ((1 : B₁) ⊗ₜ[A₁] (1 : B₁)) := fun i b =>
    (Algebra.TensorProduct.map_tmul _ _ _ _).trans (by rw [map_one]; rfl)
  have H : IsCechModule (B₀ := B₁) φ₁ φ₂ θ χ₁₂ χ₁₃ χ₂₃ :=
    { φ₁_smul := fun b n => sφ₁ b n
      φ₂_smul := fun b n => sφ₂ b n
      θ_smul := hθ
      θ_φ₁ := fun n => Subtype.ext (hδ₁ n)
      θ_φ₂ := fun n => Subtype.ext (hδ₂ n)
      χ₁₂_smul := fun b y => by
        have := sχ₁₂ (b ⊗ₜ[A₁] (1 : B₁)) y
        rwa [show τ₁₂ (b ⊗ₜ[A₁] (1 : B₁)) = _ from hτ _ b] at this
      χ₁₃_smul := fun b y => by
        have := sχ₁₃ (b ⊗ₜ[A₁] (1 : B₁)) y
        rwa [show τ₁₃ (b ⊗ₜ[A₁] (1 : B₁)) = _ from hτ _ b] at this
      χ₂₃_smul := fun b y => sχ₂₃ (b ⊗ₜ[A₁] (1 : B₁)) y
      χ₁₂_φ₁ := fun n => Subtype.ext (h₁₂₁₃ n)
      χ₁₂_φ₂ := fun n => Subtype.ext (h₁₂₂₃ n)
      χ₁₃_φ₂ := fun n => Subtype.ext (h₁₃₂₃ n)
      bijective_comparison := bijective_cechComparison_ideal hp₂ hJ₂ hsB sB sC hC₁ hC₂ φ₂
        (fun _ => rfl)
      injective_comparison₃ := injective_cechComparison₃_ideal hg hL₃ hsB sB sD hπ₁₂ hπ₂₃
        hπ₂₃' φ₂ (fun _ => rfl) χ₂₃ (fun _ => rfl) }
  obtain ⟨r, g, hg, hspan⟩ := exists_fin_invariant_span_eq_top H
  exact ⟨r, g, fun i => congrArg Subtype.val (hg i), hspan⟩

end Assembly

/-! ### The main statement -/

section Main

universe u

variable {R : Type u} [CommRing R] {B C D : Type u} [CommRing B] [CommRing C] [CommRing D]
  [Algebra R B] [Algebra R C] [Algebra R D]

/-- A square-zero ideal `I`, as an `E`-module, is killed by `I`. -/
lemma isTorsionBySet_self {E : Type*} [CommRing E] (I : Ideal E) (hI : I * I = ⊥) :
    Module.IsTorsionBySet E I I := fun x ⟨_, ha⟩ => smul_eq_zero_of_mul_self_eq_bot hI ha x

/-- The extension of a square-zero ideal along a ring map is square-zero. -/
lemma map_mul_self_eq_bot {E F : Type*} [CommRing E] [CommRing F] (f : E →+* F) (I : Ideal E)
    (hI : I * I = ⊥) : I.map f * I.map f = ⊥ := by
  rw [← Ideal.map_mul, hI, Ideal.map_bot]

/-- **A finitely generated square-zero invariant ideal of a nerve which is affine modulo it is
generated by finitely many invariant elements.** -/
theorem exists_invariant_span_eq_of_mul_self_eq_bot (p₁ p₂ : B →ₐ[R] C) (δ : C →ₐ[R] B)
    (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D)
    (hδ₁ : δ.comp p₁ = AlgHom.id R B) (hδ₂ : δ.comp p₂ = AlgHom.id R B)
    (h₁₂₁₃ : e₁₂.comp p₁ = e₁₃.comp p₁) (h₁₂₂₃ : e₁₂.comp p₂ = e₂₃.comp p₁)
    (h₁₃₂₃ : e₁₃.comp p₂ = e₂₃.comp p₂)
    (hp₂ : (p₂ : B →+* C).Flat) (he₂₃ : ((e₂₃ : C →+* D).comp (p₂ : B →+* C)).Flat)
    (N : Ideal B) (hN : N * N = ⊥) (hNfg : N.FG)
    (hinv : N.map (p₁ : B →+* C) = N.map (p₂ : B →+* C))
    (h : IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ N) :
    ∃ (r : ℕ) (μ : Fin r → B), (∀ i, μ i ∈ N) ∧ (∀ i, p₁ (μ i) = p₂ (μ i)) ∧
      N = Ideal.span (Set.range μ) := by
  classical
  obtain ⟨A₁, B₁, _, _, _, -, hFF, πB, πC, πD, hsB, hsC, hsD, hkB, hkC, hkD,
    hC₁, hC₂, hD₁₂, hD₁₃, hD₂₃⟩ := h
  have := hFF
  have h1 : (e₁₂ : C →+* D).comp (p₂ : B →+* C) = (e₂₃ : C →+* D).comp (p₁ : B →+* C) :=
    RingHom.ext fun b => AlgHom.congr_fun h₁₂₂₃ b
  have hL₃ : N.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C)) =
      N.map ((e₂₃ : C →+* D).comp (p₂ : B →+* C)) := by
    rw [← Ideal.map_map, hinv, Ideal.map_map, h1, ← Ideal.map_map, hinv, Ideal.map_map]
  have hJJ := map_mul_self_eq_bot (p₁ : B →+* C) N hN
  have hLL := map_mul_self_eq_bot ((e₁₂ : C →+* D).comp (p₁ : B →+* C)) N hN
  let : Module B₁ N := moduleOfSurjective πB hsB (hkB ▸ isTorsionBySet_self N hN)
  let : Module A₁ N := Module.compHom N (algebraMap A₁ B₁)
  have : IsScalarTower A₁ B₁ N := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : Module (B₁ ⊗[A₁] B₁) (N.map (p₁ : B →+* C)) :=
    moduleOfSurjective πC hsC (by rw [hkC]; exact isTorsionBySet_self _ hJJ)
  let : Module A₁ (N.map (p₁ : B →+* C)) :=
    Module.compHom _ (algebraMap A₁ (B₁ ⊗[A₁] B₁))
  have : IsScalarTower A₁ (B₁ ⊗[A₁] B₁) (N.map (p₁ : B →+* C)) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let : Module (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)) (N.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C))) :=
    moduleOfSurjective πD hsD (by rw [hkD]; exact isTorsionBySet_self _ hLL)
  let : Module A₁ (N.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C))) :=
    Module.compHom _ (algebraMap A₁ (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)))
  have : IsScalarTower A₁ (B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁))
      (N.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C))) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have sB : ∀ (β : B) (n : N), πB β • n = β • n := fun β n =>
    moduleOfSurjective_smul πB hsB _ β n
  have : Module.Finite B₁ N := by
    let : Algebra B B₁ := πB.toAlgebra
    have : IsScalarTower B B₁ N := IsScalarTower.of_algebraMap_smul fun β n => sB β n
    have : Module.Finite B N := Module.Finite.iff_fg.2 hNfg
    exact Module.Finite.of_restrictScalars_finite B B₁ N
  obtain ⟨r, g, hg, hspan⟩ := exists_fin_invariant_span_ideal (A₁ := A₁) (B₁ := B₁)
    (N := N) (J := N.map (p₁ : B →+* C)) (L := N.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C)))
    (p₁ := (p₁ : B →+* C)) (p₂ := (p₂ : B →+* C)) (δ := (δ : C →+* B))
    (e₁₂ := (e₁₂ : C →+* D)) (e₁₃ := (e₁₃ : C →+* D)) (e₂₃ := (e₂₃ : C →+* D))
    (fun β => AlgHom.congr_fun hδ₁ β) (fun β => AlgHom.congr_fun hδ₂ β)
    (fun β => AlgHom.congr_fun h₁₂₁₃ β) (fun β => AlgHom.congr_fun h₁₂₂₃ β)
    (fun β => AlgHom.congr_fun h₁₃₂₃ β) hp₂ he₂₃ rfl hinv rfl hL₃ hsB hsC sB
    (fun γ y => moduleOfSurjective_smul πC hsC _ γ y)
    (fun d z => moduleOfSurjective_smul πD hsD _ d z)
    (fun β => RingHom.congr_fun hC₁ β) (fun β => RingHom.congr_fun hC₂ β)
    (fun γ => RingHom.congr_fun hD₁₂ γ) (fun γ => RingHom.congr_fun hD₁₃ γ)
    (fun γ => RingHom.congr_fun hD₂₃ γ)
  refine ⟨r, fun i => g i, fun i => (g i).2, hg, le_antisymm ?_ ?_⟩
  · intro n hn
    have hmem : (⟨n, hn⟩ : N) ∈ Submodule.span B₁ (Set.range g) := hspan ▸ Submodule.mem_top
    refine Submodule.span_induction (p := fun (x : N) _ => (x : B) ∈ Ideal.span
      (Set.range fun i => (g i : B))) ?_ ?_ ?_ ?_ hmem
    · rintro x ⟨i, rfl⟩
      exact Ideal.subset_span ⟨i, rfl⟩
    · exact Submodule.zero_mem _
    · intro x y _ _ hx hy
      exact Submodule.add_mem _ hx hy
    · intro b x _ hx
      obtain ⟨β, rfl⟩ := hsB b
      rw [sB, Submodule.coe_smul, smul_eq_mul]
      exact Ideal.mul_mem_left _ β hx
  · rw [Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact (g i).2


end Main

