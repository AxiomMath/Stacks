module

public import StacksFrontier.RingTheory.Descent.CechChartDescent
public import StacksFrontier.RingTheory.Descent.CechSquareZeroLift
public import StacksFrontier.RingTheory.Etale.BijectiveModNil
public import StacksFrontier.RingTheory.Etale.Lifting
public import Mathlib.RingTheory.RingHom.Etale

/-!
# A Čech nerve which is a nerve modulo a square-zero element is a nerve

Let `B`, `C`, `D` be the rings of functions of `U`, `U ×_P U` and `U ×_P U ×_P U` for a
surjective étale chart `U → P` of an algebraic space over an affine scheme `Spec R`, with the two
projections `p₁, p₂`, the diagonal `δ` and the three partial projections `e₁₂, e₁₃, e₂₃`. Say that
this diagram is *a nerve modulo an ideal `K` of `B`*
(`Module.Descent.IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ K`) when its reduction modulo `K` is the Čech
nerve `B₁, B₁ ⊗[A₁] B₁, B₁ ⊗[A₁] B₁ ⊗[A₁] B₁` of a faithfully flat étale `A₁ → B₁`: geometrically,
the closed subspace of `P` cut out by `K` (for instance `K = I B` for an ideal `I` of `R`) is the
affine scheme `Spec A₁`.

The main result, `Module.Descent.isNerveReduction_bot_of_span_singleton`, says that a nerve
modulo the ideal generated by a square-zero element `μ` is a nerve modulo `0`: a closed subspace
of `P` cut out by a square-zero function from the base being affine, `P` is affine.

## The argument

* Every function on the closed subspace lifts to an invariant function on `U`:
  `Module.Descent.exists_lift_of_cech_of_mul_self_eq_zero`. So the ring `A` of invariant
  functions surjects onto `A₁`, with square-zero kernel.
* The étale `A₁`-algebra `B₁` lifts to an étale `A`-algebra `S` (**Stacks 04D1**,
  `etale_lift_along_surjection`), and the reduction `S → B₁` lifts to `β : S → B` because `S` is
  formally smooth and `μ` is nilpotent.
* The two comparison maps `S ⊗[A] B → C` and `S ⊗[A] C → D` are maps of étale algebras which
  are bijective modulo a nil ideal, hence bijective
  (`Module.Descent.bijective_algebraMap_tensor_of_reduction`).
* `S` is faithfully flat over `A` because it is so modulo a nil ideal, and descent along
  `A → S` (`Module.Descent.bijective_of_bijective_chartMap`) makes `β` bijective.

## References

* [Stacks Project, Tag 04D1](https://stacks.math.columbia.edu/tag/04D1)
* [Stacks Project, Tag 07VP](https://stacks.math.columbia.edu/tag/07VP)
-/

@[expose] public section

open TensorProduct

universe u

namespace Module.Descent

/-! ### Two bijectivity criteria for étale algebras -/

/-- The extension of a nil ideal along a ring map is nil. -/
theorem _root_.Ideal.map_le_nilradical_of_le_nilradical {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) {I : Ideal R} (hI : I ≤ nilradical R) : I.map f ≤ nilradical S :=
  Ideal.map_le_iff_le_comap.2 fun _ hx => mem_nilradical.2 ((mem_nilradical.1 (hI hx)).map f)

/-- The ideal generated by a square-zero element is nil. -/
private theorem _root_.Ideal.span_singleton_le_nilradical_of_mul_self_eq_zero {R : Type*}
    [CommRing R] {x : R} (hx : x * x = 0) : Ideal.span {x} ≤ nilradical R :=
  Ideal.span_le.2 (Set.singleton_subset_iff.2 (mem_nilradical.2 ⟨2, by rw [pow_two, hx]⟩))

/-- A ring map into `Z` with values in the image of an injective ring map `j : Y → Z` factors
through `j`. -/
private theorem _root_.RingHom.exists_comp_eq_of_forall_mem_range {X Y Z : Type*} [CommRing X]
    [CommRing Y] [CommRing Z] (j : Y →+* Z) (hj : Function.Injective j) (f : X →+* Z)
    (hf : ∀ x, f x ∈ Set.range j) : ∃ g : X →+* Y, ∀ x, j (g x) = f x := by
  choose g hg using hf
  refine ⟨
    { toFun := g
      map_one' := hj (by rw [hg, map_one, map_one])
      map_mul' := fun x y => hj (by rw [map_mul, hg, hg, hg, map_mul])
      map_zero' := hj (by rw [hg, map_zero, map_zero])
      map_add' := fun x y => hj (by rw [map_add, hg, hg, hg, map_add]) }, hg⟩

/-- **An étale algebra which is bijective onto a common quotient is bijective.** If `F` is étale
over `E`, `qE : E → T` is surjective with nil kernel, `qF : F → T` extends `qE`, and the kernel of
`qF` is generated by that of `qE`, then `E → F` is bijective. -/
theorem bijective_algebraMap_of_comp_eq {E F T : Type*} [CommRing E] [CommRing F] [CommRing T]
    [Algebra E F] [Algebra.Etale E F] (qE : E →+* T) (hqE : Function.Surjective qE)
    (hkerE : RingHom.ker qE ≤ nilradical E) (qF : F →+* T)
    (hcomm : qF.comp (algebraMap E F) = qE)
    (hkerF : RingHom.ker qF ≤ (RingHom.ker qE).map (algebraMap E F)) :
    Function.Bijective (algebraMap E F) := by
  have hle : (RingHom.ker qE).map (algebraMap E F) ≤ RingHom.ker qF := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, hcomm]
    exact hx
  refine Algebra.Etale.bijective_algebraMap_of_bijective_quotientMap _ hkerE ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
    rw [Ideal.Quotient.eq_zero_iff_mem, RingHom.mem_ker, ← hcomm, RingHom.comp_apply]
    exact hle hx
  · intro y
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨x, hx⟩ := hqE (qF y)
    refine ⟨Ideal.Quotient.mk _ x, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq]
    apply hkerF
    rw [RingHom.mem_ker, map_sub, ← RingHom.comp_apply, hcomm, hx, sub_self]

section Tensor

variable {A A₁ S B₁ M M₁ : Type*} [CommRing A] [CommRing A₁] [CommRing S] [CommRing B₁]
  [CommRing M] [CommRing M₁] [Algebra A A₁] [Algebra A₁ B₁] [Algebra A B₁]
  [IsScalarTower A A₁ B₁] [Algebra A₁ M₁] [Algebra A M₁] [IsScalarTower A A₁ M₁]
  [Algebra A S] [Algebra A M]

/-- For `A → A₁` surjective, tensor products over `A` and over `A₁` of `A₁`-algebras agree: the
canonical map `B₁ ⊗[A] M₁ → B₁ ⊗[A₁] M₁` is injective. -/
theorem injective_tensorOfSurjective (hρ : Function.Surjective (algebraMap A A₁)) :
    Function.Injective (Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] M₁).restrictScalars A)
      ((Algebra.TensorProduct.includeRight : M₁ →ₐ[A₁] B₁ ⊗[A₁] M₁).restrictScalars A)
      (fun _ _ => Commute.all _ _) : B₁ ⊗[A] M₁ →ₐ[A] B₁ ⊗[A₁] M₁) := by
  let g : B₁ →ₗ[A₁] M₁ →ₗ[A₁] B₁ ⊗[A] M₁ :=
    { toFun := fun b =>
        { toFun := fun m => b ⊗ₜ m
          map_add' := fun _ _ => TensorProduct.tmul_add _ _ _
          map_smul' := fun r m => by
            obtain ⟨a, rfl⟩ := hρ r
            rw [RingHom.id_apply, algebraMap_smul, TensorProduct.tmul_smul, ← algebraMap_smul A₁,
              TensorProduct.smul_tmul'] }
      map_add' := fun _ _ => by ext; simp [TensorProduct.add_tmul]
      map_smul' := fun r b => by
        obtain ⟨a, rfl⟩ := hρ r
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply, LinearMap.smul_apply]
        rw [algebraMap_smul, TensorProduct.smul_tmul', ← algebraMap_smul A₁ a b] }
  let inv := TensorProduct.lift g
  have hinv : ∀ x : B₁ ⊗[A] M₁, inv (Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] M₁).restrictScalars A)
      ((Algebra.TensorProduct.includeRight : M₁ →ₐ[A₁] B₁ ⊗[A₁] M₁).restrictScalars A)
      (fun _ _ => Commute.all _ _) x) = x := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul b m => simp [inv, g]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  exact Function.LeftInverse.injective hinv

/-- **The tensor criterion.** Let `A → A₁` be surjective, `ψ : S → B₁` and `πM : M → M₁` be
surjections with nil kernels, from `A`-algebras onto `A₁`-algebras, and let `N` be étale over
`S ⊗[A] M` with a map `πN : N → B₁ ⊗[A₁] M₁` extending `ψ ⊗ πM` whose kernel is generated by
`1 ⊗ ker πM`. Then `S ⊗[A] M → N` is bijective. -/
theorem bijective_algebraMap_tensor_of_reduction (hρ : Function.Surjective (algebraMap A A₁))
    (ψ : S →ₐ[A] B₁) (hψ : Function.Surjective ψ) (hψn : RingHom.ker ψ ≤ nilradical S)
    (πM : M →ₐ[A] M₁) (hπM : Function.Surjective πM) (hπMn : RingHom.ker πM ≤ nilradical M)
    {N : Type*} [CommRing N] [Algebra (S ⊗[A] M) N] [Algebra.Etale (S ⊗[A] M) N]
    (πN : N →+* B₁ ⊗[A₁] M₁)
    (hcomm : ∀ s m, πN (algebraMap (S ⊗[A] M) N (s ⊗ₜ m)) = ψ s ⊗ₜ πM m)
    (hker : RingHom.ker πN ≤ ((RingHom.ker πM).map
      (Algebra.TensorProduct.includeRight : M →ₐ[A] S ⊗[A] M)).map
        (algebraMap (S ⊗[A] M) N)) :
    Function.Bijective (algebraMap (S ⊗[A] M) N) := by
  let can : B₁ ⊗[A] M₁ →ₐ[A] B₁ ⊗[A₁] M₁ := Algebra.TensorProduct.lift
      ((Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] M₁).restrictScalars A)
      ((Algebra.TensorProduct.includeRight : M₁ →ₐ[A₁] B₁ ⊗[A₁] M₁).restrictScalars A)
      (fun _ _ => Commute.all _ _)
  have hcan : Function.Injective can := injective_tensorOfSurjective hρ
  let θ₀ := Algebra.TensorProduct.map ψ πM
  let θ : S ⊗[A] M →+* B₁ ⊗[A₁] M₁ := (can.comp θ₀ : S ⊗[A] M →ₐ[A] B₁ ⊗[A₁] M₁)
  have hθ : ∀ s m, θ (s ⊗ₜ m) = ψ s ⊗ₜ πM m := fun s m => by simp [θ, θ₀, can]
  have hθsurj : Function.Surjective θ := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul b m =>
      obtain ⟨s, rfl⟩ := hψ b
      obtain ⟨m', rfl⟩ := hπM m
      exact ⟨s ⊗ₜ m', hθ _ _⟩
    | add x y hx hy =>
      obtain ⟨x', rfl⟩ := hx
      obtain ⟨y', rfl⟩ := hy
      exact ⟨x' + y', map_add _ _ _⟩
  have hkerθ : RingHom.ker θ = RingHom.ker θ₀ := by
    ext x
    simp only [RingHom.mem_ker, θ, AlgHom.coe_toRingHom, AlgHom.comp_apply]
    exact ⟨fun h => hcan (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
  have hkerθn : RingHom.ker θ ≤ nilradical (S ⊗[A] M) := by
    rw [hkerθ, Algebra.TensorProduct.map_ker _ _ hψ hπM]
    exact sup_le
      (Ideal.map_le_nilradical_of_le_nilradical
        (Algebra.TensorProduct.includeLeft : S →ₐ[A] S ⊗[A] M).toRingHom hψn)
      (Ideal.map_le_nilradical_of_le_nilradical
        (Algebra.TensorProduct.includeRight : M →ₐ[A] S ⊗[A] M).toRingHom hπMn)
  refine bijective_algebraMap_of_comp_eq θ hθsurj hkerθn πN ?_ ?_
  · refine RingHom.ext fun x => ?_
    induction x using TensorProduct.inductionOn with
    | tmul s m => rw [RingHom.comp_apply, hcomm, hθ]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  · refine hker.trans (Ideal.map_mono ?_)
    rw [Ideal.map_le_iff_le_comap]
    intro m hm
    rw [Ideal.mem_comap, RingHom.mem_ker]
    change θ (1 ⊗ₜ m) = 0
    rw [hθ, RingHom.mem_ker.1 hm, TensorProduct.tmul_zero]

/-- The base change `S ⊗[A] M` of an étale `A`-algebra `S`, as an algebra over the right
factor `M`, is étale. -/
theorem etale_rightAlgebra [Algebra.Etale A S] :
    letI : Algebra M (S ⊗[A] M) := Algebra.TensorProduct.rightAlgebra
    Algebra.Etale M (S ⊗[A] M) := by
  let : Algebra M (S ⊗[A] M) := Algebra.TensorProduct.rightAlgebra
  have : Algebra.Etale M (M ⊗[A] S) := Algebra.Etale.baseChange A S M
  exact Algebra.Etale.of_equiv (AlgEquiv.ofRingEquiv (f := (Algebra.TensorProduct.comm A M S :
    M ⊗[A] S ≃ₐ[A] S ⊗[A] M).toRingEquiv) fun m => by
      simp [Algebra.TensorProduct.algebraMap_apply, RingHom.algebraMap_toAlgebra])

/-- **The tensor criterion for a map out of `S ⊗[A] M`.** Let `S` be étale over `A` and let
`f : S ⊗[A] M → N` be a map of `A`-algebras whose restriction `g` to `M` is étale. If `f` reduces,
along `ψ ⊗ πM`, to a surjection `N → B₁ ⊗[A₁] M₁` whose kernel is generated by `1 ⊗ ker πM`, then
`f` is bijective. -/
private theorem bijective_of_etale_of_reduction [Algebra.Etale A S] {N : Type*} [CommRing N]
    [Algebra A N] (hρ : Function.Surjective (algebraMap A A₁))
    (ψ : S →ₐ[A] B₁) (hψ : Function.Surjective ψ) (hψn : RingHom.ker ψ ≤ nilradical S)
    (πM : M →ₐ[A] M₁) (hπM : Function.Surjective πM) (hπMn : RingHom.ker πM ≤ nilradical M)
    (f : S ⊗[A] M →ₐ[A] N) (g : M →+* N) (hg : g.Etale) (hfg : ∀ m, f (1 ⊗ₜ m) = g m)
    (πN : N →+* B₁ ⊗[A₁] M₁) (hcomm : ∀ s m, πN (f (s ⊗ₜ m)) = ψ s ⊗ₜ πM m)
    (hker : RingHom.ker πN ≤ ((RingHom.ker πM).map
      (Algebra.TensorProduct.includeRight : M →ₐ[A] S ⊗[A] M)).map f) :
    Function.Bijective f := by
  let : Algebra M N := g.toAlgebra
  let : Algebra (S ⊗[A] M) N := f.toRingHom.toAlgebra
  let : Algebra M (S ⊗[A] M) := Algebra.TensorProduct.rightAlgebra
  have : Algebra.Etale M N := RingHom.etale_algebraMap.1 hg
  have : Algebra.Etale M (S ⊗[A] M) := etale_rightAlgebra
  have : IsScalarTower M (S ⊗[A] M) N := .of_algebraMap_eq fun m => (hfg m).symm
  have : Algebra.Etale (S ⊗[A] M) N := Algebra.Etale.of_restrictScalars M _ _
  exact bijective_algebraMap_tensor_of_reduction hρ ψ hψ hψn πM hπM hπMn πN hcomm hker

/-- Transporting a bijective map `S ⊗[A] M → N` along an algebra equivalence `S ≃ B` gives a
bijective map `B ⊗[A] M → N`. -/
private theorem bijective_of_comp_congr_symm {A S B M N : Type*} [CommRing A] [CommRing S]
    [CommRing B] [CommRing M] [CommRing N] [Algebra A S] [Algebra A B] [Algebra A M] [Algebra A N]
    (e : S ≃ₐ[A] B) (g : B ⊗[A] M →ₐ[A] N) {f : S ⊗[A] M →ₐ[A] N} (hf : Function.Bijective f)
    (h : ∀ b m, g (b ⊗ₜ m) = f (e.symm b ⊗ₜ m)) : Function.Bijective g := by
  have : g = f.comp (Algebra.TensorProduct.congr e.symm AlgEquiv.refl).toAlgHom :=
    Algebra.TensorProduct.ext' fun b m => by simpa using h b m
  rw [this]
  exact hf.comp (Algebra.TensorProduct.congr e.symm AlgEquiv.refl).bijective

end Tensor

/-! ### Nerves modulo an ideal -/

section Nerve

variable {R : Type u} [CommRing R] {B C D : Type u} [CommRing B] [CommRing C] [CommRing D]
  [Algebra R B] [Algebra R C] [Algebra R D]

/-- The diagram `p₁, p₂ : B → C`, `e₁₂, e₁₃, e₂₃ : C → D` of `R`-algebras is *a Čech nerve modulo
the ideal `K` of `B`*: there are a faithfully flat étale `A₁ → B₁` and surjections
`B → B₁`, `C → B₁ ⊗[A₁] B₁`, `D → B₁ ⊗[A₁] B₁ ⊗[A₁] B₁` with kernels `K`, `p₁ K` and `e₁₂ p₁ K`
(for an invariant ideal, e.g. one extended from the base, these are the ideals `K` generates),
carrying
the two projections and the three partial projections to the coface maps of the Čech nerve of
`A₁ → B₁`. -/
def IsNerveReduction (p₁ p₂ : B →ₐ[R] C) (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D) (K : Ideal B) : Prop :=
  ∃ (A₁ B₁ : Type u) (_ : CommRing A₁) (_ : CommRing B₁) (_ : Algebra A₁ B₁),
    Algebra.Etale A₁ B₁ ∧ Module.FaithfullyFlat A₁ B₁ ∧
    ∃ (πB : B →+* B₁) (πC : C →+* B₁ ⊗[A₁] B₁) (πD : D →+* B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)),
      Function.Surjective πB ∧ Function.Surjective πC ∧ Function.Surjective πD ∧
      RingHom.ker πB = K ∧ RingHom.ker πC = K.map (p₁ : B →+* C) ∧
      RingHom.ker πD = K.map ((e₁₂ : C →+* D).comp (p₁ : B →+* C)) ∧
      πC.comp (p₁ : B →+* C) =
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom.comp πB ∧
      πC.comp (p₂ : B →+* C) =
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁).toRingHom.comp πB ∧
      πD.comp (e₁₂ : C →+* D) = (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
        (Algebra.TensorProduct.includeLeft : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom.comp πC ∧
      πD.comp (e₁₃ : C →+* D) = (Algebra.TensorProduct.map (AlgHom.id A₁ B₁)
        (Algebra.TensorProduct.includeRight : B₁ →ₐ[A₁] B₁ ⊗[A₁] B₁)).toRingHom.comp πC ∧
      πD.comp (e₂₃ : C →+* D) = (Algebra.TensorProduct.includeRight :
        B₁ ⊗[A₁] B₁ →ₐ[A₁] B₁ ⊗[A₁] (B₁ ⊗[A₁] B₁)).toRingHom.comp πC

/-- An étale ring map is flat. -/
theorem _root_.RingHom.Etale.flat' {X Y : Type*} [CommRing X] [CommRing Y] {f : X →+* Y}
    (hf : f.Etale) : f.Flat :=
  (RingHom.Etale.iff_flat_and_formallyUnramified.mp hf).1

/-- **Assembling a nerve.** If `A → B` is faithfully flat and étale and the comparison maps
`B ⊗[A] B → C` and `B ⊗[A] C → D` of the identity chart are bijective, the diagram is a Čech
nerve modulo `0`. -/
theorem isNerveReduction_bot_of_bijective {A : Type u} [CommRing A] [Algebra A B] [Algebra A C]
    [Algebra A D] [Algebra.Etale A B] [Module.FaithfullyFlat A B]
    (p₁ p₂ : B →ₐ[R] C) (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D) (p₁' p₂' : B →ₐ[A] C)
    (e₁₂' e₁₃' e₂₃' : C →ₐ[A] D) (hp₁ : ∀ b, p₁' b = p₁ b) (hp₂ : ∀ b, p₂' b = p₂ b)
    (he₁₂ : ∀ c, e₁₂' c = e₁₂ c) (he₁₃ : ∀ c, e₁₃' c = e₁₃ c) (he₂₃ : ∀ c, e₂₃' c = e₂₃ c)
    (h₁₂₁₃ : e₁₂'.comp p₁' = e₁₃'.comp p₁') (h₁₂₂₃ : e₁₂'.comp p₂' = e₂₃'.comp p₁')
    (h₁₃₂₃ : e₁₃'.comp p₂' = e₂₃'.comp p₂')
    (hφ : Function.Bijective (chartMap p₁' p₂' (AlgHom.id A B)))
    (hν : Function.Bijective (tripleMap p₁' e₁₂' e₂₃' (AlgHom.id A B))) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ ⊥ := by
  let eC : B ⊗[A] B ≃ₐ[A] C := AlgEquiv.ofBijective _ hφ
  let ΦD : B ⊗[A] (B ⊗[A] B) →ₐ[A] D :=
    (tripleMap p₁' e₁₂' e₂₃' (AlgHom.id A B)).comp
      (Algebra.TensorProduct.congr AlgEquiv.refl eC).toAlgHom
  have hΦD : Function.Bijective ΦD :=
    hν.comp (Algebra.TensorProduct.congr AlgEquiv.refl eC).bijective
  let eD : B ⊗[A] (B ⊗[A] B) ≃ₐ[A] D := AlgEquiv.ofBijective _ hΦD
  have heC : ∀ b b', eC (b ⊗ₜ b') = p₁' b * p₂' b' := fun b b' => chartMap_tmul _ _ _ _ _
  have hΦt : ∀ b x, ΦD (b ⊗ₜ x) = e₁₂' (p₁' b) * e₂₃' (eC x) := fun b x => by
    simp [ΦD]
  have hΦ₁₂ : ΦD.comp (Algebra.TensorProduct.map (AlgHom.id A B)
      Algebra.TensorProduct.includeLeft) = e₁₂'.comp eC.toAlgHom := by
    refine Algebra.TensorProduct.ext' fun b b' => ?_
    simp only [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      Algebra.TensorProduct.includeLeft_apply, hΦt, heC, map_one, mul_one]
    rw [← AlgHom.comp_apply e₂₃' p₁', ← h₁₂₂₃, AlgHom.comp_apply,
      show (eC : B ⊗[A] B →ₐ[A] C) (b ⊗ₜ b') = p₁' b * p₂' b' from heC b b', map_mul]
  have hΦ₁₃ : ΦD.comp (Algebra.TensorProduct.map (AlgHom.id A B)
      Algebra.TensorProduct.includeRight) = e₁₃'.comp eC.toAlgHom := by
    refine Algebra.TensorProduct.ext' fun b b' => ?_
    simp only [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      Algebra.TensorProduct.includeRight_apply, hΦt, heC, map_one, one_mul]
    rw [← AlgHom.comp_apply e₁₂' p₁', h₁₂₁₃, ← AlgHom.comp_apply e₂₃' p₂', ← h₁₃₂₃,
      show (eC : B ⊗[A] B →ₐ[A] C) (b ⊗ₜ b') = p₁' b * p₂' b' from heC b b', map_mul]
    rfl
  have hΦ₂₃ : ∀ x, ΦD (Algebra.TensorProduct.includeRight x) = e₂₃' (eC x) := fun x => by
    rw [Algebra.TensorProduct.includeRight_apply, hΦt, map_one, map_one, one_mul]
  refine ⟨A, B, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    RingHom.id B, eC.symm.toRingEquiv.toRingHom, eD.symm.toRingEquiv.toRingHom,
    Function.surjective_id, eC.symm.surjective, eD.symm.surjective, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (RingHom.injective_iff_ker_eq_bot _).1 Function.injective_id
  · rw [Ideal.map_bot]
    exact (RingHom.injective_iff_ker_eq_bot _).1 eC.symm.injective
  · rw [Ideal.map_bot]
    exact (RingHom.injective_iff_ker_eq_bot _).1 eD.symm.injective
  · refine RingHom.ext fun b => ?_
    change eC.symm (p₁ b) = b ⊗ₜ 1
    rw [AlgEquiv.symm_apply_eq, heC, map_one, mul_one, hp₁]
  · refine RingHom.ext fun b => ?_
    change eC.symm (p₂ b) = 1 ⊗ₜ b
    rw [AlgEquiv.symm_apply_eq, heC, map_one, one_mul, hp₂]
  · refine RingHom.ext fun c => ?_
    change eD.symm (e₁₂ c) = Algebra.TensorProduct.map (AlgHom.id A B)
      Algebra.TensorProduct.includeLeft (eC.symm c)
    rw [AlgEquiv.symm_apply_eq]
    change e₁₂ c = ΦD _
    rw [← AlgHom.comp_apply, hΦ₁₂]
    simp [he₁₂]
  · refine RingHom.ext fun c => ?_
    change eD.symm (e₁₃ c) = Algebra.TensorProduct.map (AlgHom.id A B)
      Algebra.TensorProduct.includeRight (eC.symm c)
    rw [AlgEquiv.symm_apply_eq]
    change e₁₃ c = ΦD _
    rw [← AlgHom.comp_apply, hΦ₁₃]
    simp [he₁₃]
  · refine RingHom.ext fun c => ?_
    change eD.symm (e₂₃ c) = Algebra.TensorProduct.includeRight (eC.symm c)
    rw [AlgEquiv.symm_apply_eq]
    change e₂₃ c = ΦD (Algebra.TensorProduct.includeRight (eC.symm c))
    rw [hΦ₂₃, AlgEquiv.apply_symm_apply, he₂₃]

/-- **A Čech nerve modulo a square-zero element of the base is a Čech nerve.** Let
`p₁, p₂ : B → C`, `δ : C → B` and `e₁₂, e₁₃, e₂₃ : C → D` be the first three terms of a Čech
nerve of `R`-algebras with étale coface maps, and let `μ ∈ B` be an invariant square-zero element.
If the diagram is a nerve modulo `μ`, it is a nerve modulo `0`. The element `μ` is invariant
(`p₁ μ = p₂ μ`), e.g. the image of a square-zero function on the base. -/
theorem isNerveReduction_bot_of_span_singleton (p₁ p₂ : B →ₐ[R] C) (δ : C →ₐ[R] B)
    (e₁₂ e₁₃ e₂₃ : C →ₐ[R] D)
    (hδ₁ : δ.comp p₁ = AlgHom.id R B) (hδ₂ : δ.comp p₂ = AlgHom.id R B)
    (h₁₂₁₃ : e₁₂.comp p₁ = e₁₃.comp p₁) (h₁₂₂₃ : e₁₂.comp p₂ = e₂₃.comp p₁)
    (h₁₃₂₃ : e₁₃.comp p₂ = e₂₃.comp p₂)
    (hp₁ : (p₁ : B →+* C).Etale) (hp₂ : (p₂ : B →+* C).Etale)
    (he₁₂ : (e₁₂ : C →+* D).Etale) (he₂₃ : (e₂₃ : C →+* D).Etale)
    (μ : B) (hμ : μ * μ = 0) (hμp : p₁ μ = p₂ μ)
    (h : IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ (Ideal.span {μ})) :
    IsNerveReduction p₁ p₂ e₁₂ e₁₃ e₂₃ ⊥ := by
  classical
  obtain ⟨A₁, B₁, _, _, _, hEt, hFF, πB, πC, πD, hsB, hsC, hsD, hkB, hkC, hkD,
    hC₁, hC₂, hD₁₂, hD₁₃, hD₂₃⟩ := h
  have hkC' : RingHom.ker πC = Ideal.span {p₁ μ} := by
    rw [hkC, Ideal.map_span]
    simp
  have hkD' : RingHom.ker πD = Ideal.span {e₁₂ (p₁ μ)} := by
    rw [hkD, Ideal.map_span]
    simp
  have hμB : μ ∈ RingHom.ker πB := hkB ▸ Ideal.mem_span_singleton_self μ
  have hμC : p₁ μ ∈ RingHom.ker πC := hkC' ▸ Ideal.mem_span_singleton_self _
  have hnilB : RingHom.ker πB ≤ nilradical B :=
    hkB ▸ Ideal.span_singleton_le_nilradical_of_mul_self_eq_zero hμ
  have hC₁' : ∀ b, πC (p₁ b) = πB b ⊗ₜ 1 := fun b => by
    simpa only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Algebra.TensorProduct.includeLeft_apply] using RingHom.congr_fun hC₁ b
  have hC₂' : ∀ b, πC (p₂ b) = 1 ⊗ₜ πB b := fun b => by
    simpa only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Algebra.TensorProduct.includeRight_apply] using RingHom.congr_fun hC₂ b
  -- the lift of functions on the closed subspace
  have hlift := fun a₁ => exists_lift_of_cech_of_mul_self_eq_zero (A₁ := A₁) (B₁ := B₁)
    (p₁ : B →+* C) p₂ (e₁₂ : C →+* D) e₁₃ e₂₃ (congrArg AlgHom.toRingHom h₁₂₁₃)
    (congrArg AlgHom.toRingHom h₁₂₂₃) (congrArg AlgHom.toRingHom h₁₃₂₃) hp₁.flat' hp₂.flat'
    (RingHom.Etale.stableUnderComposition _ _ hp₁ he₁₂).flat' μ hμ hμp πB hsB
    (RingHom.mem_ker.1 hμB) πC hsC hkC'.le πD hC₁ hC₂ hD₁₂ hD₁₃ hD₂₃ a₁
  -- the ring of invariant functions and its map to `A₁`
  let A : Subalgebra R B := AlgHom.equalizer p₁ p₂
  have hAeq : ∀ a : A, p₁ a = p₂ a := fun a => a.2
  have hinj₁ : Function.Injective (algebraMap A₁ B₁) := FaithfulSMul.algebraMap_injective A₁ B₁
  have hrange : ∀ a : A, πB a ∈ Set.range (algebraMap A₁ B₁) := fun a => by
    refine (Algebra.IsEffective.of_faithfullyFlat A₁ B₁ (πB a)).1 ?_
    rw [Algebra.TensorProduct.includeLeftSubRight_apply, sub_eq_zero, ← hC₁', ← hC₂', hAeq]
  obtain ⟨ρ, hρ⟩ := RingHom.exists_comp_eq_of_forall_mem_range (algebraMap A₁ B₁) hinj₁
    (πB.comp (algebraMap A B)) hrange
  replace hρ : ∀ a : A, algebraMap A₁ B₁ (ρ a) = πB a := hρ
  have hρsurj : Function.Surjective ρ := fun a₁ => by
    obtain ⟨b, hb, hb'⟩ := hlift a₁
    exact ⟨⟨b, hb⟩, hinj₁ (by rwa [hρ])⟩
  have hkerρ : RingHom.ker ρ ≤ nilradical A := fun a ha => by
    have : (a : B) ∈ RingHom.ker πB := by
      rw [RingHom.mem_ker, ← hρ, RingHom.mem_ker.1 ha, map_zero]
    obtain ⟨n, hn⟩ := mem_nilradical.1 (hnilB this)
    exact mem_nilradical.2 ⟨n, Subtype.ext (by simpa using hn)⟩
  let : Algebra A A₁ := ρ.toAlgebra
  let : Algebra A B₁ := ((algebraMap A₁ B₁).comp ρ).toAlgebra
  have : IsScalarTower A A₁ B₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : Algebra A C := ((p₁ : B →+* C).comp (algebraMap A B)).toAlgebra
  let : Algebra A D := ((e₁₂ : C →+* D).comp (algebraMap A C)).toAlgebra
  let p₁' : B →ₐ[A] C := { (p₁ : B →+* C) with commutes' := fun _ => rfl }
  let p₂' : B →ₐ[A] C := { (p₂ : B →+* C) with commutes' := fun a => (hAeq a).symm }
  let e₁₂' : C →ₐ[A] D := { (e₁₂ : C →+* D) with commutes' := fun _ => rfl }
  let e₁₃' : C →ₐ[A] D := { (e₁₃ : C →+* D) with
    commutes' := fun a => (AlgHom.congr_fun h₁₂₁₃ a).symm }
  let e₂₃' : C →ₐ[A] D := { (e₂₃ : C →+* D) with
    commutes' := fun a => by
      change e₂₃ (p₁ a) = e₁₂ (p₁ a)
      rw [← AlgHom.comp_apply, ← h₁₂₂₃, AlgHom.comp_apply, hAeq] }
  let δ' : C →ₐ[A] B := { (δ : C →+* B) with
    commutes' := fun a => by
      change δ (p₁ a) = a
      rw [← AlgHom.comp_apply, hδ₁, AlgHom.id_apply] }
  let πBA : B →ₐ[A] B₁ := { πB with commutes' := fun a => (hρ a).symm }
  -- the étale lift of `B₁` and the lift of its reduction
  obtain ⟨S, _, _, hSet, ψ, hψ, hkerψ⟩ := etale_lift_along_surjection A A₁ B₁ hρsurj
  have hψn : RingHom.ker ψ ≤ nilradical S := fun x hx => by
    have hx' : x ∈ RingHom.ker (ψ : S →+* B₁) := hx
    rw [hkerψ] at hx'
    exact Ideal.map_le_nilradical_of_le_nilradical _ hkerρ hx'
  let eB : (B ⧸ RingHom.ker πBA) ≃ₐ[A] B₁ := Ideal.quotientKerAlgEquivOfSurjective hsB
  obtain ⟨β, hβ⟩ := Algebra.FormallySmooth.exists_lift_of_le_nilradical (R := A) (A := S)
    (RingHom.ker πBA) hnilB (eB.symm.toAlgHom.comp ψ)
  have hβψ : ∀ s, πB (β s) = ψ s := fun s =>
    (by simpa [eB] using congrArg eB (AlgHom.congr_fun hβ s) : πBA (β s) = ψ s)
  -- the two comparison maps are bijective
  have hhφ : Function.Bijective (chartMap p₁' p₂' β) := by
    refine bijective_of_etale_of_reduction (M₁ := B₁) hρsurj ψ hψ hψn πBA hsB hnilB _ _ hp₂
      (fun b => ?_) πC (fun s b => ?_) ?_
    · rw [chartMap_tmul, map_one, map_one, one_mul]
      rfl
    · change πC (p₁ (β s) * p₂ b) = _
      rw [map_mul, hC₁', hC₂', hβψ, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rfl
    · rw [hkC', Ideal.span_le]
      rintro _ rfl
      have : p₁ μ = chartMap p₁' p₂' β (Algebra.TensorProduct.includeRight μ) := by
        rw [Algebra.TensorProduct.includeRight_apply, chartMap_tmul, map_one, map_one, one_mul]
        exact hμp
      rw [SetLike.mem_coe, this]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hμB)
  have hπCA : ∀ a : A, πC (algebraMap A C a) = algebraMap A (B₁ ⊗[A₁] B₁) a := fun a => by
    change πC (p₁ a) = _
    rw [hC₁', Algebra.TensorProduct.algebraMap_apply, ← hρ]
    rfl
  let πCA : C →ₐ[A] B₁ ⊗[A₁] B₁ := { πC with commutes' := hπCA }
  have hnilC : RingHom.ker πCA ≤ nilradical C := by
    change RingHom.ker πC ≤ _
    rw [hkC']
    exact Ideal.span_singleton_le_nilradical_of_mul_self_eq_zero (by rw [← map_mul, hμ, map_zero])
  have hhν : Function.Bijective (tripleMap p₁' e₁₂' e₂₃' β) := by
    refine bijective_of_etale_of_reduction hρsurj ψ hψ hψn πCA hsC hnilC _ _ he₂₃
      (fun c => ?_) πD (fun s c => ?_) ?_
    · rw [tripleMap_tmul, map_one, map_one, map_one, one_mul]
      rfl
    · change πD (e₁₂ (p₁ (β s)) * e₂₃ c) = _
      have e2 := RingHom.congr_fun hD₁₂ (p₁ (β s))
      have e3 := RingHom.congr_fun hD₂₃ c
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Algebra.TensorProduct.includeRight_apply] at e2 e3
      rw [map_mul, e2, e3, hC₁', hβψ, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        ← Algebra.TensorProduct.one_def, one_mul]
      rfl
    · rw [hkD', Ideal.span_le]
      rintro _ rfl
      have : e₁₂ (p₁ μ) =
          tripleMap p₁' e₁₂' e₂₃' β (Algebra.TensorProduct.includeRight (p₁ μ)) := by
        rw [Algebra.TensorProduct.includeRight_apply, tripleMap_tmul, map_one, map_one, map_one,
          one_mul]
        change e₁₂ (p₁ μ) = e₂₃ (p₁ μ)
        rw [← AlgHom.comp_apply e₂₃ p₁, ← h₁₂₂₃, AlgHom.comp_apply, hμp]
      rw [SetLike.mem_coe, this]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hμC)
  -- `S` is faithfully flat over `A`
  have : Module.FaithfullyFlat A S := by
    refine Module.FaithfullyFlat.of_comap_surjective fun p => ?_
    have hle : RingHom.ker ρ ≤ p.asIdeal := hkerρ.trans (nilradical_le_prime p.asIdeal)
    have hP₁ : (p.asIdeal.map ρ).IsPrime := Ideal.map_isPrime_of_surjective hρsurj hle
    obtain ⟨q₁, hq₁⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := A₁) (B := B₁)
      ⟨p.asIdeal.map ρ, hP₁⟩
    refine ⟨PrimeSpectrum.comap (ψ : S →+* B₁) q₁, PrimeSpectrum.ext ?_⟩
    have hq := congrArg PrimeSpectrum.asIdeal hq₁
    simp only [PrimeSpectrum.comap_asIdeal] at hq ⊢
    rw [Ideal.comap_comap, show (ψ : S →+* B₁).comp (algebraMap A S) =
        (algebraMap A₁ B₁).comp ρ from RingHom.ext fun a => ψ.commutes a, ← Ideal.comap_comap,
      hq, Ideal.comap_map_of_surjective _ hρsurj, ← RingHom.ker_eq_comap_bot, sup_eq_left.2 hle]
  -- descent makes `β` bijective
  have hβbij : Function.Bijective β :=
    bijective_of_bijective_chartMap p₁' p₂' δ' e₁₂' e₁₃' e₂₃'
      (AlgHom.ext fun x => AlgHom.congr_fun hδ₁ x) (AlgHom.ext fun x => AlgHom.congr_fun hδ₂ x)
      (AlgHom.ext fun x => AlgHom.congr_fun h₁₂₁₃ x)
      (AlgHom.ext fun x => AlgHom.congr_fun h₁₂₂₃ x)
      (AlgHom.ext fun x => AlgHom.congr_fun h₁₃₂₃ x)
      (fun b hb => ⟨⟨b, hb⟩, rfl⟩) Subtype.val_injective β hhφ hhν.injective
  -- the nerve of `A → B`
  let βe : S ≃ₐ[A] B := AlgEquiv.ofBijective β hβbij
  have hβe : ∀ b, β (βe.symm b) = b := fun b => βe.apply_symm_apply b
  have : Algebra.Etale A B := Algebra.Etale.of_equiv βe
  have : Module.FaithfullyFlat A B :=
    Module.FaithfullyFlat.of_linearEquiv A S βe.symm.toLinearEquiv
  have hφid : Function.Bijective (chartMap p₁' p₂' (AlgHom.id A B)) :=
    bijective_of_comp_congr_symm βe _ hhφ fun b b' => by simp [hβe]
  have hνid : Function.Bijective (tripleMap p₁' e₁₂' e₂₃' (AlgHom.id A B)) :=
    bijective_of_comp_congr_symm βe _ hhν fun b c => by simp [hβe]
  exact isNerveReduction_bot_of_bijective p₁ p₂ e₁₂ e₁₃ e₂₃ p₁' p₂' e₁₂' e₁₃' e₂₃'
    (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) (fun _ => rfl)
    (AlgHom.ext fun x => AlgHom.congr_fun h₁₂₁₃ x)
    (AlgHom.ext fun x => AlgHom.congr_fun h₁₂₂₃ x)
    (AlgHom.ext fun x => AlgHom.congr_fun h₁₃₂₃ x) hφid hνid

end Nerve

end Module.Descent
