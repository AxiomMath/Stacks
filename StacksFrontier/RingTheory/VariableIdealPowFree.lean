module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The powers of the ideal of variables are free modules over the coefficient ring
-/

@[expose] public section

universe u v

namespace MvPolynomial

/-- The `n`-th power of the ideal generated by the variables of `MvPolynomial E A` is a free
`A`-module: it is the span of the monomials of total degree at least `n`. -/
theorem free_variableIdeal_pow (A : Type u) [CommRing A] (E : Type v) (n : ℕ) :
    Module.Free A
      ((Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n :
        Ideal (MvPolynomial E A)) :
        Submodule (MvPolynomial E A) (MvPolynomial E A)) := by
  obtain ⟨s, hs, key⟩ : ∃ (s : Set (E →₀ ℕ)) (hs : IsUpperSet s),
      (Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n) =
        restrictSupportIdeal (R := A) s hs :=
    ⟨_, _, pow_idealOfVars n⟩
  have e : Submodule.restrictScalars A
      (Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n) =
      restrictSupport A s := by
    rw [key]
    exact restrictScalars_restrictSupportIdeal (R := A) s hs
  exact Module.Free.of_basis ((basisRestrictSupport A s).map (LinearEquiv.ofEq _ _ e).symm)

end MvPolynomial

end
