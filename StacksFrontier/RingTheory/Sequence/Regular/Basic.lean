/-! ### A regular sequence that is not regular after permutation -/

@[expose] public section

open MvPolynomial
open scoped Pointwise

/-- The polynomial ring `k[x, y, z]` over a field `k`, with `x = X 0`, `y = X 1`, `z = X 2`. -/
abbrev mvPolyRingFin3 (k : Type) [Field k] := MvPolynomial (Fin 3) k

/-- In `k[x, y, z]`, the element `y` does not lie in the principal ideal generated by `y(1-x)`. -/
lemma X1_notMem_span_X1_mul_one_sub_X0 (k : Type) [Field k] :
    (X 1 : mvPolyRingFin3 k) ∉ Ideal.span {X 1 * (1 - X 0)} := by
  rw [Ideal.mem_span_singleton]
  rintro ⟨c, hc⟩
  have hX1 : (X 1 : mvPolyRingFin3 k) ≠ 0 := MvPolynomial.X_ne_zero 1
  have key : (1 - X 0 : mvPolyRingFin3 k) * c = 1 := by
    apply mul_left_cancel₀ hX1
    rw [mul_one]
    linear_combination -hc
  have hunit : IsUnit (1 - X 0 : mvPolyRingFin3 k) := IsUnit.of_mul_eq_one c key
  rw [MvPolynomial.isUnit_iff] at hunit
  obtain ⟨_, hnil⟩ := hunit
  have hsne : (Finsupp.single 0 1 : Fin 3 →₀ ℕ) ≠ 0 :=
    Finsupp.single_ne_zero.mpr one_ne_zero
  have hn := hnil (Finsupp.single 0 1) hsne
  have hc1 : MvPolynomial.coeff (Finsupp.single 0 1) (1 - X 0 : mvPolyRingFin3 k) = (-1 : k) := by
    rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_one, MvPolynomial.coeff_X,
      ite_eq_right fun h => hsne h.symm]
    simp
  rw [hc1] at hn
  have hz : (-1 : k) = 0 := isNilpotent_iff_eq_zero.mp hn
  simp at hz

/-- The iterated quotient `QuotSMulTop t (QuotSMulTop s M)` is linearly isomorphic to
`M ⧸ (s • ⊤ ⊔ t • ⊤)`. -/
def quotSMulTopQuotSMulTopEquiv {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (s t : R) :
    QuotSMulTop t (QuotSMulTop s M) ≃ₗ[R]
      M ⧸ ((s • ⊤ : Submodule R M) ⊔ (t • ⊤ : Submodule R M)) := by
  unfold QuotSMulTop
  have hmap : (t • ⊤ : Submodule R (M ⧸ (s • ⊤ : Submodule R M)))
      = (t • ⊤ : Submodule R M).map (s • ⊤ : Submodule R M).mkQ := by
    rw [Submodule.map_pointwise_smul, Submodule.map_top, Submodule.range_mkQ]
  rw [hmap]
  exact Submodule.quotientQuotientEquivQuotientSup _ _

/-- In a commutative ring `R`, `r • ⊤ = span {r}` as submodules of `R`. -/
lemma Ideal.smul_top_eq_span_singleton {R : Type*} [CommRing R] (r : R) :
    (r • ⊤ : Submodule R R) = Ideal.span {r} := by
  rw [← Submodule.ideal_span_singleton_smul, Ideal.smul_top_eq_map]; simp

/-- The element `u` is a nonzerodivisor on the double quotient `R / (s, t)` provided
`u * a ∈ (s, t)` implies `a ∈ (s, t)` for all `a`. -/
lemma isSMulRegular_quotSMulTop_quotSMulTop_of_mul_mem {R : Type*} [CommRing R] (s t u : R)
    (h : ∀ a : R, u * a ∈ Ideal.span {s, t} → a ∈ Ideal.span {s, t}) :
    IsSMulRegular (QuotSMulTop t (QuotSMulTop s R)) u := by
  have hsup : ((s • ⊤ : Submodule R R) ⊔ (t • ⊤ : Submodule R R)) = Ideal.span {s, t} := by
    rw [Ideal.span_insert, Ideal.smul_top_eq_span_singleton, Ideal.smul_top_eq_span_singleton]
  refine ((quotSMulTopQuotSMulTopEquiv (M := R) s t).isSMulRegular_congr u).mpr ?_
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro a ha
  rw [hsup] at ha ⊢
  rw [smul_eq_mul] at ha
  exact h a ha

/-- The ideal `(x, y)` lies in the kernel of `k[x, y, z] → k[z]`, `x, y ↦ 0`, `z ↦ z`. -/
lemma span_X0_X1_le_ker_aeval (k : Type) [Field k] :
    Ideal.span {(X 0 : mvPolyRingFin3 k), X 1} ≤
      RingHom.ker (MvPolynomial.aeval ![0, 0, Polynomial.X] :
        mvPolyRingFin3 k →ₐ[k] Polynomial k).toRingHom := by
  rw [Ideal.span_le]
  rintro x (rfl | rfl) <;> simp [RingHom.mem_ker]

/-- The ideal `(x, y)` is prime in `k[x, y, z]`. -/
lemma isPrime_span_X0_X1 (k : Type) [Field k] :
    (Ideal.span {(X 0 : mvPolyRingFin3 k), X 1}).IsPrime := by
  set I : Ideal (mvPolyRingFin3 k) := Ideal.span {(X 0 : mvPolyRingFin3 k), X 1} with hI
  let φ : mvPolyRingFin3 k →ₐ[k] Polynomial k := MvPolynomial.aeval ![0, 0, Polynomial.X]
  have hX0mem : (X 0 : mvPolyRingFin3 k) ∈ I := by rw [hI]; exact Ideal.subset_span (by simp)
  have hX1mem : (X 1 : mvPolyRingFin3 k) ∈ I := by rw [hI]; exact Ideal.subset_span (by simp)
  have hspan_le : I ≤ RingHom.ker φ.toRingHom := span_X0_X1_le_ker_aeval k
  have hker_le : RingHom.ker φ.toRingHom ≤ I := by
    intro p hp
    rw [RingHom.mem_ker] at hp
    let g : Polynomial k →ₐ[k] mvPolyRingFin3 k := Polynomial.aeval (X 2)
    have hcomp : (Ideal.Quotient.mkₐ k I).comp (g.comp φ) = Ideal.Quotient.mkₐ k I := by
      apply MvPolynomial.algHom_ext; intro i
      have hmk0 : (Ideal.Quotient.mk I) (X 0 : mvPolyRingFin3 k) = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr hX0mem
      have hmk1 : (Ideal.Quotient.mk I) (X 1 : mvPolyRingFin3 k) = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr hX1mem
      fin_cases i <;> simp [φ, g, hmk0, hmk1]
    have hz : (Ideal.Quotient.mkₐ k I) p = 0 := by
      have h2 := AlgHom.congr_fun hcomp p
      simp only [AlgHom.comp_apply] at h2
      have hp' : φ p = 0 := hp
      rw [← h2, hp', map_zero, map_zero]
    rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at hz
  rw [le_antisymm hspan_le hker_le]
  exact RingHom.ker_isPrime _

/-- `(x, y(1-x)) = (x, y)` as ideals of `k[x, y, z]`. -/
lemma span_X0_X1_mul_one_sub_X0_eq_span_X0_X1 (k : Type) [Field k] :
    Ideal.span {(X 0 : mvPolyRingFin3 k), X 1 * (1 - X 0)} =
      Ideal.span {(X 0 : mvPolyRingFin3 k), X 1} := by
  apply le_antisymm <;> rw [Ideal.span_le] <;> intro x hx <;>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  · rcases hx with rfl | rfl
    · exact Ideal.subset_span (by simp)
    · rw [SetLike.mem_coe, Ideal.mem_span_pair]; exact ⟨0, 1 - X 0, by ring⟩
  · rcases hx with rfl | rfl
    · exact Ideal.subset_span (by simp)
    · rw [SetLike.mem_coe, Ideal.mem_span_pair]; exact ⟨X 1, 1, by ring⟩

/-- `z(1-x) ∉ (x, y)` in `k[x, y, z]`. -/
lemma X2_mul_one_sub_X0_notMem_span_X0_X1 (k : Type) [Field k] :
    (X 2 * (1 - X 0) : mvPolyRingFin3 k) ∉ Ideal.span {(X 0 : mvPolyRingFin3 k), X 1} := by
  intro hmem
  simpa [RingHom.mem_ker] using span_X0_X1_le_ker_aeval k hmem

/-- `y(1-x)` is a nonzerodivisor on `k[x, y, z] / (x)`. -/
lemma isSMulRegular_quotSMulTop_X0_X1_mul_one_sub_X0 (k : Type) [Field k] :
    IsSMulRegular (QuotSMulTop (X 0 : mvPolyRingFin3 k) (mvPolyRingFin3 k))
      (X 1 * (1 - X 0) : mvPolyRingFin3 k) := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro x hx
  simp only [smul_eq_mul] at hx
  rw [Submodule.mem_smul_pointwise_iff_exists] at hx ⊢
  obtain ⟨b, -, hb⟩ := hx
  simp only [smul_eq_mul] at hb
  have hprime : Prime (X 0 : mvPolyRingFin3 k) := MvPolynomial.X_prime
  obtain ⟨c, rfl⟩ : (X 0 : mvPolyRingFin3 k) ∣ x := by
    rcases hprime.dvd_mul.mp ⟨b, hb.symm⟩ with h | h
    · rcases hprime.dvd_mul.mp h with ⟨c, hc⟩ | h'
      · have heval :=
          congrArg (MvPolynomial.eval (fun i : Fin 3 => if i = 0 then (0 : k) else 1)) hc
        simp only [MvPolynomial.eval_X, MvPolynomial.eval_mul] at heval
        norm_num at heval
      · exact absurd (dvd_sub_self_right.mp h') hprime.not_dvd_one
    · exact h
  exact ⟨c, Submodule.mem_top, rfl⟩

/-- The quotient `k[x, y, z] / (x, y(1-x), z(1-x))` is nontrivial. -/
lemma nontrivial_quotSMulTop_xyz_one_sub_x (k : Type) [Field k] :
    Nontrivial (QuotSMulTop (X 2 * (1 - X 0) : mvPolyRingFin3 k)
      (QuotSMulTop (X 1 * (1 - X 0) : mvPolyRingFin3 k)
        (QuotSMulTop (X 0 : mvPolyRingFin3 k) (mvPolyRingFin3 k)))) := by
  have gen : ∀ {M : Type} [AddCommGroup M] [Module (mvPolyRingFin3 k) M],
      (⊥ : Submodule (mvPolyRingFin3 k) M) =
        Ideal.ofList ([] : List (mvPolyRingFin3 k)) • ⊤ := by
    intro M _ _
    simp [Ideal.ofList]
  rw [← Submodule.topEquiv (R := mvPolyRingFin3 k).nontrivial_congr,
    Submodule.nontrivial_iff_ne_bot]
  intro htop
  have h1 := (Submodule.top_eq_ofList_cons_smul_iff (X 2 * (1 - X 0) : mvPolyRingFin3 k)
    ([] : List (mvPolyRingFin3 k))).mpr (htop.trans gen)
  have h2 := (Submodule.top_eq_ofList_cons_smul_iff (X 1 * (1 - X 0) : mvPolyRingFin3 k)
    [X 2 * (1 - X 0)]).mpr h1
  have h3 := (Submodule.top_eq_ofList_cons_smul_iff (X 0 : mvPolyRingFin3 k)
    [X 1 * (1 - X 0), X 2 * (1 - X 0)]).mpr h2
  have hideal : (Ideal.ofList [X 0, X 1 * (1 - X 0), X 2 * (1 - X 0)] :
      Ideal (mvPolyRingFin3 k)) = ⊤ := by
    simpa [Ideal.smul_top_eq_map] using h3.symm
  rw [Ideal.eq_top_iff_one, Ideal.ofList, Ideal.mem_span] at hideal
  have hval := hideal (RingHom.ker (MvPolynomial.aeval fun _ : Fin 3 => (0 : k)).toRingHom) ?_
  · rw [RingHom.mem_ker] at hval
    simp at hval
  · intro x hx
    simp only [Set.mem_ofPred_eq, List.mem_cons, List.not_mem_nil, or_false] at hx
    rw [SetLike.mem_coe, RingHom.mem_ker]
    rcases hx with rfl | rfl | rfl <;> simp

/-- The sequence `x, y(1-x), z(1-x)` is a regular sequence on `k[x, y, z]`. -/
@[stacks 00LG "(1)"]
theorem regularSequence_xyz_one_sub_x (k : Type) [Field k] :
    RingTheory.Sequence.IsRegular (mvPolyRingFin3 k)
      ([X 0, X 1 * (1 - X 0), X 2 * (1 - X 0)] : List (mvPolyRingFin3 k)) := by
  refine .cons (fun a b h => mul_left_cancel₀ (X_ne_zero 0) h) <|
    .cons (isSMulRegular_quotSMulTop_X0_X1_mul_one_sub_X0 k) <| .cons ?_ <|
      @RingTheory.Sequence.IsRegular.nil (mvPolyRingFin3 k) _ _ _ _
        (nontrivial_quotSMulTop_xyz_one_sub_x k)
  refine isSMulRegular_quotSMulTop_quotSMulTop_of_mul_mem _ _ _ ?_
  intro a ha
  rw [span_X0_X1_mul_one_sub_X0_eq_span_X0_X1] at ha ⊢
  exact ((isPrime_span_X0_X1 k).mul_mem_left_iff (X2_mul_one_sub_X0_notMem_span_X0_X1 k)).mp ha

/-- The sequence `y(1-x), z(1-x), x` is not a regular sequence on `k[x, y, z]`. -/
@[stacks 00LG "(2)"]
theorem not_regularSequence_permuted_xyz_one_sub_x (k : Type) [Field k] :
    ¬ RingTheory.Sequence.IsRegular (mvPolyRingFin3 k)
      ([X 1 * (1 - X 0), X 2 * (1 - X 0), X 0] : List (mvPolyRingFin3 k)) := by
  intro h
  have hw := h.toIsWeaklyRegular
  rw [RingTheory.Sequence.isWeaklyRegular_cons_iff] at hw
  obtain ⟨_, hw2⟩ := hw
  rw [RingTheory.Sequence.isWeaklyRegular_cons_iff] at hw2
  obtain ⟨h2, _⟩ := hw2
  have hzero : (X 2 * (1 - X 0) : mvPolyRingFin3 k) •
      (Submodule.Quotient.mk (X 1 : mvPolyRingFin3 k) :
        QuotSMulTop (X 1 * (1 - X 0) : mvPolyRingFin3 k) (mvPolyRingFin3 k))
      = (X 2 * (1 - X 0) : mvPolyRingFin3 k) •
          (0 : QuotSMulTop (X 1 * (1 - X 0) : mvPolyRingFin3 k) (mvPolyRingFin3 k)) := by
    rw [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      Ideal.smul_top_eq_span_singleton, Ideal.mem_span_singleton]
    exact ⟨X 2, by rw [smul_eq_mul]; ring⟩
  have hne : (Submodule.Quotient.mk (X 1 : mvPolyRingFin3 k) :
      QuotSMulTop (X 1 * (1 - X 0) : mvPolyRingFin3 k) (mvPolyRingFin3 k)) ≠ 0 := by
    rw [ne_eq, Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_span_singleton]
    exact X1_notMem_span_X1_mul_one_sub_X0 k
  exact hne (h2 hzero)


/-! ### Spreading out a regular sequence from a prime to a basic open

For `Nᵢ = M ⧸ (Ideal.ofList (xs.take i) • ⊤)` let `Kᵢ` be the kernel of multiplication by `xs[i]`
on `Nᵢ`. Weak regularity of `xs` on `M_p` says that every `(Kᵢ)_p` vanishes; when `R` is
Noetherian and `M` is finite each `Kᵢ` is finite, so it already vanishes on a basic open
neighbourhood of `p`.
-/

@[expose] public section

open RingTheory.Sequence

/-- With `R` Noetherian and `M` finite, the kernel of multiplication by `c` on the quotient
`M ⧸ (Ideal.ofList l • ⊤)` is a finite `R`-module. -/
lemma L_kernel_finite
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (l : List R) (c : R) :
    Module.Finite R
      (LinearMap.ker (LinearMap.lsmul R (M ⧸ (Ideal.ofList l • ⊤ : Submodule R M)) c)) := by
  have : IsNoetherian R (M ⧸ (Ideal.ofList l • ⊤ : Submodule R M)) :=
    isNoetherian_of_isNoetherianRing_of_finite R _
  exact Module.Finite.of_injective
    (LinearMap.ker (LinearMap.lsmul R (M ⧸ (Ideal.ofList l • ⊤ : Submodule R M)) c)).subtype
    (Submodule.subtype_injective _)

/-- Localizing `I • ⊤` and restricting scalars back to `R` gives `I • ⊤` in `M_S`. -/
lemma restrictScalars_localized_smul_top
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (S : Submonoid R) (I : Ideal R) :
    (Submodule.localized S (I • (⊤ : Submodule R M))).restrictScalars R
      = I • (⊤ : Submodule R (LocalizedModule S M)) := by
  have h : Submodule.localized S (I • (⊤ : Submodule R M))
      = Submodule.localized S I • (⊤ : Submodule (Localization S) (LocalizedModule S M)) := by
    have h := Submodule.localized'_smul (Localization S) S
      (LocalizedModule.mkLinearMap S M) (⊤ : Submodule R M) I
    rwa [Submodule.localized'_top] at h
  rw [h]
  apply le_antisymm
  · intro x hx
    rw [Submodule.restrictScalars_mem] at hx
    refine Submodule.smul_induction_on hx ?_ fun x y hx hy => Submodule.add_mem _ hx hy
    intro a ha y _
    rw [Submodule.mem_localized'] at ha
    obtain ⟨m, hm, s, rfl⟩ := ha
    have key : (IsLocalizedModule.mk' (LocalizedModule.mkLinearMap S R) m s) • y
        = m • ((IsLocalizedModule.mk' (LocalizedModule.mkLinearMap S R) (1:R) s) • y) := by
      rw [← smul_assoc]
      congr 1
      rw [← IsLocalizedModule.mk'_smul (LocalizedModule.mkLinearMap S R) m (1:R) s]
      simp
    rw [key]
    exact Submodule.smul_mem_smul hm Submodule.mem_top
  · refine Submodule.smul_le.2 fun r hr x _ => ?_
    rw [Submodule.restrictScalars_mem, algebra_compatible_smul (Localization S) r x]
    refine Submodule.smul_mem_smul ?_ Submodule.mem_top
    rw [Submodule.mem_localized']
    exact ⟨r, hr, 1, by rw [IsLocalizedModule.mk'_one]; rfl⟩

/-- The quotient of `M_S` by `I • ⊤` is `R`-linearly equivalent to its quotient by the
localization of `I • ⊤`. -/
private noncomputable def quotSMulTopEquivQuotLocalized {R : Type*} [CommRing R] {M : Type*}
    [AddCommGroup M] [Module R M] (S : Submonoid R) (I : Ideal R) :
    (LocalizedModule S M ⧸ (I • ⊤ : Submodule R (LocalizedModule S M))) ≃ₗ[R]
      LocalizedModule S M ⧸ Submodule.localized S (I • (⊤ : Submodule R M)) :=
  (Submodule.quotEquivOfEq _ _ (restrictScalars_localized_smul_top S I).symm).trans
    (Submodule.Quotient.restrictScalarsEquiv R _)

/-- If `xs` is weakly `M_p`-regular (over `R`), then for each valid index `i` the kernel of
multiplication by `xs[i]` on `M ⧸ (Ideal.ofList (xs.take i) • ⊤)` becomes zero after localizing at
`p`. -/
lemma L_kernel_localizes_to_zero
    {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M]
    (p : Ideal R) [p.IsPrime] (xs : List R)
    (hreg : IsWeaklyRegular (LocalizedModule p.primeCompl M) xs)
    (i : ℕ) (hi : i < xs.length) :
    Subsingleton (LocalizedModule p.primeCompl
      (LinearMap.ker (LinearMap.lsmul R
        (M ⧸ (Ideal.ofList (xs.take i) • ⊤ : Submodule R M)) xs[i]))) := by
  set I : Ideal R := Ideal.ofList (xs.take i) with hI
  have hsmul : IsSMulRegular (LocalizedModule p.primeCompl M ⧸ (I • ⊤ : Submodule R _)) xs[i] :=
    hreg.regular_mod_prev i hi
  have hsmul' : IsSMulRegular (LocalizedModule p.primeCompl M ⧸ (Submodule.localized p.primeCompl
      (I • (⊤ : Submodule R M)))) xs[i] :=
    (LinearEquiv.isSMulRegular_congr (quotSMulTopEquivQuotLocalized p.primeCompl I) xs[i]).mp hsmul
  set φ := Submodule.toLocalizedQuotient p.primeCompl (I • (⊤ : Submodule R M)) with hφ
  rw [LocalizedModule.subsingleton_iff]
  intro m
  have hmval : xs[i] • (m : M ⧸ (I • ⊤ : Submodule R M)) = 0 := m.property
  have hφ0 : φ (m : M ⧸ (I • ⊤ : Submodule R M)) = 0 := by
    apply hsmul'
    show xs[i] • φ (m : M ⧸ (I • ⊤ : Submodule R M)) = xs[i] • (0 : _)
    rw [smul_zero, ← map_smul, hmval, map_zero]
  rw [IsLocalizedModule.eq_zero_iff p.primeCompl φ] at hφ0
  obtain ⟨s', hs'⟩ := hφ0
  refine ⟨s'.val, s'.property, ?_⟩
  ext
  exact hs'

/-- The image of `xs` in `S⁻¹R`, acting on `M_S`, generates `Ideal.ofList xs • ⊤` over `R`. -/
lemma restrictScalars_ofList_map_smul_top
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (xs : List R) (S : Submonoid R) :
    (Ideal.ofList (xs.map (algebraMap R (Localization S))) • (⊤ : Submodule
      (Localization S) (LocalizedModule S M))).restrictScalars R
      = Ideal.ofList xs • (⊤ : Submodule R (LocalizedModule S M)) := by
  have hmap : Ideal.ofList (xs.map (algebraMap R (Localization S))) =
      Ideal.map (algebraMap R (Localization S)) (Ideal.ofList xs) := by
    simp only [Ideal.ofList, Ideal.map_span]
    congr 1
    ext y
    simp [List.mem_map]
  rw [hmap]
  apply le_antisymm
  · intro x hx
    rw [Submodule.restrictScalars_mem] at hx
    refine Submodule.smul_induction_on hx ?_ (fun a b ha hb => Submodule.add_mem _ ha hb)
    intro a ha y _
    rw [Ideal.map, Submodule.mem_span_set'] at ha
    obtain ⟨n, c, gg, rfl⟩ := ha
    rw [Finset.sum_smul]
    refine Submodule.sum_mem _ fun idx _ => ?_
    obtain ⟨w, hw1, hw2⟩ := (gg idx).property
    rw [smul_assoc, ← hw2, ← algebra_compatible_smul (Localization S) w y, smul_comm]
    exact Submodule.smul_mem_smul hw1 Submodule.mem_top
  · refine Submodule.smul_le.2 fun r hr x _ => ?_
    rw [Submodule.restrictScalars_mem, algebra_compatible_smul (Localization S) r x]
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top

/-- Localizing the quotient `M ⧸ (Ideal.ofList xs • ⊤)` at `S` gives, up to `R`-linear
equivalence, the quotient of `M_S` by the image of `xs`. -/
lemma nonempty_localizedModule_quotient_ofList_equiv
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
    (xs : List R) (S : Submonoid R) :
    Nonempty (LocalizedModule S (M ⧸ (Ideal.ofList xs • ⊤ : Submodule R M)) ≃ₗ[R]
      (LocalizedModule S M ⧸ (Ideal.ofList (xs.map (algebraMap R (Localization S))) •
        (⊤ : Submodule (Localization S) (LocalizedModule S M))))) := by
  set I : Ideal R := Ideal.ofList xs with hI
  exact ⟨((IsLocalizedModule.iso S (Submodule.toLocalizedQuotient S (I • (⊤ : Submodule R M)))
    ).trans (quotSMulTopEquivQuotLocalized S I).symm).trans <|
    (Submodule.quotEquivOfEq _ _ (restrictScalars_ofList_map_smul_top xs S).symm).trans
      (Submodule.Quotient.restrictScalarsEquiv R _)⟩

/-- If `xs` is weakly `M_p`-regular, then for each index `i` the kernel of `xs[i]` on
`M ⧸ (Ideal.ofList (xs.take i) • ⊤)` vanishes on a basic open `D(f)` containing `p`. -/
lemma exists_away_subsingleton_ker
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (p : Ideal R) [p.IsPrime] (xs : List R)
    (hwr : IsWeaklyRegular (LocalizedModule p.primeCompl M) xs) (i : ℕ) :
    ∃ f ∈ p.primeCompl, ∀ hi : i < xs.length,
      Subsingleton (LocalizedModule (Submonoid.powers f)
        (LinearMap.ker (LinearMap.lsmul R
          (M ⧸ (Ideal.ofList (xs.take i) • ⊤ : Submodule R M)) xs[i]))) := by
  by_cases hi : i < xs.length
  · have hfin := L_kernel_finite (R := R) (M := M) (xs.take i) xs[i]
    have hsub := L_kernel_localizes_to_zero p xs hwr i hi
    obtain ⟨f, hf, hfsub⟩ := LocalizedModule.exists_subsingleton_away
      (M := (LinearMap.ker (LinearMap.lsmul R (M ⧸ (Ideal.ofList (xs.take i) • ⊤ : Submodule R
          M)) xs[i]))) p
    exact ⟨f, hf, fun _ => hfsub⟩
  · exact ⟨1, p.primeCompl.one_mem, fun h => absurd h hi⟩

/-- There is `g ∈ p.primeCompl` such that for every valid index `i` the kernel of `xs[i]` on
`M ⧸ (Ideal.ofList (xs.take i) • ⊤)` vanishes after localizing away from `g`, **and** the top
quotient `M_g ⧸ (Ideal.ofList (xs.map (algebraMap R (Localization.Away g))) • ⊤)` is nonzero. -/
lemma L_choose_g
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (p : Ideal R) [p.IsPrime] (xs : List R)
    (hreg : IsRegular (LocalizedModule p.primeCompl M)
      (xs.map (algebraMap R (Localization.AtPrime p)))) :
    ∃ g ∈ p.primeCompl,
      (∀ i (hi : i < xs.length),
        Subsingleton (LocalizedModule (Submonoid.powers g)
          (LinearMap.ker (LinearMap.lsmul R
            (M ⧸ (Ideal.ofList (xs.take i) • ⊤ : Submodule R M)) xs[i])))) ∧
      ((⊤ : Submodule (Localization.Away g) (LocalizedModule (Submonoid.powers g) M)) ≠
        Ideal.ofList (xs.map (algebraMap R (Localization.Away g))) • ⊤) := by
  have hwr : IsWeaklyRegular (LocalizedModule p.primeCompl M) xs :=
    (isWeaklyRegular_map_algebraMap_iff (Localization.AtPrime p) (LocalizedModule p.primeCompl M)
        xs).mp
      hreg.toIsWeaklyRegular
  choose F hFmem hFsub using exists_away_subsingleton_ker p xs hwr
  refine ⟨∏ i ∈ Finset.range xs.length, F i, ?_, ?_, ?_⟩
  · exact Submonoid.prod_mem _ (fun i _ => hFmem i)
  · intro i hi
    have hdvd : F i ∣ ∏ j ∈ Finset.range xs.length, F j :=
      Finset.dvd_prod_of_mem F (Finset.mem_range.mpr hi)
    have hsub := hFsub i hi
    rw [LocalizedModule.subsingleton_iff] at hsub ⊢
    intro m
    obtain ⟨r, ⟨k, rfl⟩, hr⟩ := hsub m
    obtain ⟨t, ht⟩ := hdvd
    refine ⟨(∏ j ∈ Finset.range xs.length, F j)^k, ⟨k, rfl⟩, ?_⟩
    rw [ht, mul_pow]
    simp only at hr
    rw [mul_comm, mul_smul, hr, smul_zero]
  · set g := ∏ i ∈ Finset.range xs.length, F i with hg
    have hgmem : g ∈ p.primeCompl := Submonoid.prod_mem _ (fun i _ => hFmem i)
    rw [ne_comm, ne_eq, ← Submodule.Quotient.subsingleton_iff]
    intro hsubg
    have hQg : Subsingleton
        (LocalizedModule (Submonoid.powers g) (M ⧸ (Ideal.ofList xs • ⊤ : Submodule R M))) := by
      obtain ⟨e⟩ := nonempty_localizedModule_quotient_ofList_equiv (M := M) xs (Submonoid.powers g)
      exact (Equiv.subsingleton_congr e.toEquiv).mpr hsubg
    have hQp : Subsingleton (LocalizedModule p.primeCompl (M ⧸ (Ideal.ofList xs • ⊤ : Submodule R
        M))) := by
      rw [LocalizedModule.subsingleton_iff] at hQg ⊢
      intro m
      obtain ⟨r, hrmem, hr⟩ := hQg m
      exact ⟨r, (Submonoid.powers_le.mpr hgmem) hrmem, hr⟩
    obtain ⟨e⟩ := nonempty_localizedModule_quotient_ofList_equiv (M := M) xs p.primeCompl
    have hsubp := (Equiv.subsingleton_congr e.toEquiv).mp hQp
    have htop := hreg.top_ne_smul
    rw [ne_comm, ne_eq, ← Submodule.Quotient.subsingleton_iff] at htop
    exact htop hsubp

/-- If, for each valid index `i`, the kernel of `xs[i]` on `M ⧸ (Ideal.ofList (xs.take i) • ⊤)`
vanishes after localizing away from `g`, then `xs` is weakly regular on
`M_g = LocalizedModule (powers g) M` (over `R`). -/
lemma L_weaklyRegular_of_kernels_away
    {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M] (g : R) (xs : List R)
    (hker : ∀ i (hi : i < xs.length),
      Subsingleton (LocalizedModule (Submonoid.powers g)
        (LinearMap.ker (LinearMap.lsmul R
          (M ⧸ (Ideal.ofList (xs.take i) • ⊤ : Submodule R M)) xs[i])))) :
    IsWeaklyRegular (LocalizedModule (Submonoid.powers g) M) xs := by
  set S : Submonoid R := Submonoid.powers g with hS
  apply IsWeaklyRegular.mk
  intro i hi
  set I : Ideal R := Ideal.ofList (xs.take i) with hI
  rw [LinearEquiv.isSMulRegular_congr (quotSMulTopEquivQuotLocalized S I) xs[i]]
  set φ := Submodule.toLocalizedQuotient S (I • (⊤ : Submodule R M)) with hφ
  have hloc : IsLocalizedModule S φ := by rw [hφ]; infer_instance
  refine isSMulRegular_iff_right_eq_zero_of_smul.mpr fun y hy => ?_
  obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective S φ y
  simp only [Function.uncurry] at *
  rw [← IsLocalizedModule.mk'_smul, IsLocalizedModule.mk'_eq_zero, hφ,
    IsLocalizedModule.eq_zero_iff S (Submodule.toLocalizedQuotient S (I • (⊤ : Submodule R M)))]
      at hy
  obtain ⟨t, ht⟩ := hy
  have hmem :
      t.val • m ∈ LinearMap.ker (LinearMap.lsmul R (M ⧸ (I • ⊤ : Submodule R M)) xs[i]) := by
    rw [LinearMap.mem_ker]
    simp only [LinearMap.lsmul_apply]
    rw [smul_comm] at ht
    exact ht
  obtain ⟨r, hrmem, hr⟩ := (LocalizedModule.subsingleton_iff.mp (hker i hi)) ⟨t.val • m, hmem⟩
  have hr' : r • (t.val • m) = 0 := by simpa using congrArg Subtype.val hr
  rw [IsLocalizedModule.mk'_eq_zero, hφ,
    IsLocalizedModule.eq_zero_iff S (Submodule.toLocalizedQuotient S (I • (⊤ : Submodule R M)))]
  refine ⟨⟨r, hrmem⟩ * t, ?_⟩
  simp only [mul_smul]
  exact hr'

/-- Regularity of a sequence over the localization at a prime spreads out to a localization away
from some element not in the prime. -/
@[stacks 061L, ega "0 15.2.4" "special case"]
theorem regular_sequence_localize_away_of_atPrime
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    {M : Type*} [AddCommGroup M] [Module R M] [Module.Finite R M]
    (p : Ideal R) [p.IsPrime] (xs : List R)
    (hp : IsRegular (LocalizedModule p.primeCompl M)
      (xs.map (algebraMap R (Localization.AtPrime p)))) :
    ∃ g ∈ p.primeCompl,
      IsRegular (LocalizedModule (Submonoid.powers g) M)
        (xs.map (algebraMap R (Localization.Away g))) := by
  obtain ⟨g, hg, hker, htop⟩ := L_choose_g p xs hp
  exact ⟨g, hg, (isWeaklyRegular_map_algebraMap_iff (Localization.Away g) _ xs).mpr
    (L_weaklyRegular_of_kernels_away g xs hker), htop⟩


/-! ### Regular sequences and short exact sequences -/

@[expose] public section

open scoped Pointwise

/-- An element of `M` lies in the pointwise scalar multiple `r • ⊤` exactly when it is
of the form `r • m`. -/
theorem mem_smul_top_iff {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (r : R) (x : M) : x ∈ r • (⊤ : Submodule R M) ↔ ∃ m, r • m = x := by
  rw [Submodule.mem_smul_pointwise_iff_exists]
  simp

/-- Let `M →[α] N →[β] P` be exact with `α` injective. If `r` is a nonzerodivisor on
`P`, then the induced map `M ⧸ r • ⊤ → N ⧸ r • ⊤` is injective. -/
theorem QuotSMulTop.map_injective {R M N P : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup P] [Module R P]
    (r : R) (α : M →ₗ[R] N) (β : N →ₗ[R] P)
    (hα : Function.Injective α)
    (hexact : LinearMap.range α = LinearMap.ker β)
    (hP : IsSMulRegular P r) :
    Function.Injective (QuotSMulTop.map r α) := by
  rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
  intro xq hxq
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ xq
  rw [LinearMap.mem_ker, QuotSMulTop.map_apply_mk] at hxq
  rw [Submodule.Quotient.mk_eq_zero, _root_.mem_smul_top_iff] at hxq
  obtain ⟨n, hn⟩ := hxq
  have hβαx : β (α x) = 0 := by
    have : α x ∈ LinearMap.range α := ⟨x, rfl⟩
    rw [hexact, LinearMap.mem_ker] at this
    exact this
  have hrβn : r • β n = 0 := by
    rw [← map_smul, hn, hβαx]
  have hβn : β n = 0 := hP (show r • β n = r • 0 by rw [hrβn, smul_zero])
  rw [← LinearMap.mem_ker, ← hexact] at hβn
  obtain ⟨m, hm⟩ := hβn
  have : α x = α (r • m) := by rw [map_smul, hm, hn]
  have hxrm : x = r • m := hα this
  rw [Submodule.Quotient.mk_eq_zero, _root_.mem_smul_top_iff]
  exact ⟨m, hxrm.symm⟩

/-- Regularity in the middle of a short exact sequence `0 → M₁ →[α] M₂ →[β] M₃ → 0`:
if `r` is a nonzerodivisor on `M₁` and on `M₃`, then it is one on `M₂`. -/
theorem isSMulRegular_of_shortExact {R : Type*} [CommRing R]
    {M₁ M₂ M₃ : Type*} [AddCommGroup M₁] [Module R M₁]
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup M₃] [Module R M₃]
    (α : M₁ →ₗ[R] M₂) (β : M₂ →ₗ[R] M₃)
    (hα : Function.Injective α)
    (hexact : LinearMap.range α = LinearMap.ker β)
    (r : R) (h1 : IsSMulRegular M₁ r) (h3 : IsSMulRegular M₃ r) :
    IsSMulRegular M₂ r := by
  intro x y hxy
  have hxy' : r • x = r • y := hxy
  have hβeq : β x = β y := by
    apply h3
    show r • β x = r • β y
    rw [← map_smul, ← map_smul, hxy']
  have hker : x - y ∈ LinearMap.ker β := by
    rw [LinearMap.mem_ker, map_sub, hβeq, sub_self]
  rw [← hexact] at hker
  obtain ⟨z, hz⟩ := hker
  have : r • (x - y) = 0 := by
    rw [smul_sub, hxy', sub_self]
  rw [← hz] at this
  rw [← map_smul] at this
  have hrz : r • z = 0 := hα (by rw [this, map_zero])
  have hz0 : z = 0 := h1 (show r • z = r • 0 by rw [hrz, smul_zero])
  rw [hz0, map_zero] at hz
  exact sub_eq_zero.mp hz.symm

open RingTheory.Sequence in
/-- Given a short exact sequence `0 → M₁ →[α] M₂ →[β] M₃ → 0` of `R`-modules, if a sequence `rs` of
elements of `R` is both `M₁`-regular and `M₃`-regular, then it is `M₂`-regular. -/
@[stacks 0F1T]
theorem isRegular_of_shortExact {R : Type*} [CommRing R]
    {M₁ M₂ M₃ : Type*} [AddCommGroup M₁] [Module R M₁]
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup M₃] [Module R M₃]
    (α : M₁ →ₗ[R] M₂) (β : M₂ →ₗ[R] M₃)
    (hα : Function.Injective α) (hβ : Function.Surjective β)
    (hexact : LinearMap.range α = LinearMap.ker β)
    (rs : List R)
    (h1 : IsRegular M₁ rs) (h3 : IsRegular M₃ rs) :
    IsRegular M₂ rs := by
  match rs with
  | [] =>
    refine ⟨IsWeaklyRegular.nil R M₂, ?_⟩
    have hM1 := h1.top_ne_smul
    intro hcontra
    apply hM1
    have hbot2 : (Ideal.ofList ([] : List R) • (⊤ : Submodule R M₂)) = ⊥ := by
      simp [Ideal.ofList]
    have hbot1 : (Ideal.ofList ([] : List R) • (⊤ : Submodule R M₁)) = ⊥ := by
      simp [Ideal.ofList]
    rw [hbot2] at hcontra
    rw [hbot1]
    rw [Submodule.eq_bot_iff] at hcontra ⊢
    intro x _
    apply hα
    rw [map_zero]
    exact hcontra (α x) trivial
  | r :: rs' =>
    rw [isRegular_cons_iff] at h1 h3 ⊢
    obtain ⟨h1r, h1rs⟩ := h1
    obtain ⟨h3r, h3rs⟩ := h3
    refine ⟨isSMulRegular_of_shortExact α β hα hexact r h1r h3r, ?_⟩
    exact isRegular_of_shortExact (QuotSMulTop.map r α) (QuotSMulTop.map r β)
      (QuotSMulTop.map_injective r α β hα hexact h3r)
      (QuotSMulTop.map_surjective r hβ)
      (LinearMap.exact_iff.mp
        (QuotSMulTop.map_exact r (LinearMap.exact_iff.mpr hexact.symm) hβ)).symm
      rs' h1rs h3rs

/-! ### Regular sequences in a ring -/

/-- The ideal generated by the list `List.ofFn f` is the span of the range of `f`. -/
theorem Ideal.ofList_ofFn {A : Type*} [Semiring A] {c : ℕ} (f : Fin c → A) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) :=
  congrArg Ideal.span (Set.ext fun x ↦ List.mem_ofFn' f x)

/-- The ideal generated by the first `i` terms of `List.ofFn f` is spanned by the `f j` with
`j < i`. -/
theorem Ideal.ofList_take_ofFn {A : Type*} [CommRing A] {c : ℕ} (f : Fin c → A) (i : ℕ) :
    Ideal.ofList ((List.ofFn f).take i) =
      Ideal.span (f '' ↑(Finset.univ.filter fun j : Fin c ↦ (j : ℕ) < i)) := by
  refine congrArg Ideal.span (Set.ext fun x ↦ ?_)
  simp only [Set.mem_ofPred_eq, List.mem_take_iff_getElem, List.getElem_ofFn, List.length_ofFn,
    Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_image]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, by omega⟩, by simp only; omega, rfl⟩
  · rintro ⟨j, hj, rfl⟩
    exact ⟨j, by omega, rfl⟩

/-- In a ring, a list is weakly regular exactly when each of its terms is a nonzerodivisor modulo
the ideal generated by the preceding ones, read as a membership implication. -/
theorem RingTheory.Sequence.isWeaklyRegular_iff_forall_mul_mem {A : Type*} [CommRing A]
    (rs : List A) :
    RingTheory.Sequence.IsWeaklyRegular A rs ↔ ∀ i (h : i < rs.length) (y : A),
      rs[i] * y ∈ Ideal.ofList (rs.take i) → y ∈ Ideal.ofList (rs.take i) := by
  rw [RingTheory.Sequence.isWeaklyRegular_iff]
  refine forall₂_congr fun i h ↦ ?_
  rw [isSMulRegular_iff_right_eq_zero_of_smul]
  have key : ∀ y : A,
      (Submodule.Quotient.mk y : A ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule A A)) = 0 ↔
      y ∈ Ideal.ofList (rs.take i) := fun y ↦ by
    rw [Submodule.Quotient.mk_eq_zero, smul_eq_mul, Ideal.mul_top]
  constructor
  · intro H y hy
    rw [← key]
    exact H _ (by rw [← Submodule.Quotient.mk_smul, key, smul_eq_mul]; exact hy)
  · intro H x hx
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rw [← Submodule.Quotient.mk_smul, key, smul_eq_mul] at hx
    rw [key]
    exact H y hx

/-- Multiplying every term of a list by a common unit does not change the ideal it generates. -/
theorem Ideal.ofList_map_mul_unit {A : Type*} [CommRing A] {u : A} (hu : IsUnit u) (rs : List A) :
    Ideal.ofList (rs.map (u * ·)) = Ideal.ofList rs := by
  refine le_antisymm (Ideal.span_le.2 fun x hx ↦ ?_) (Ideal.span_le.2 fun x hx ↦ ?_)
  · obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span hy)
  · rw [SetLike.mem_coe, ← Ideal.unit_mul_mem_iff_mem _ hu]
    exact Ideal.subset_span (List.mem_map_of_mem hx)

/-- Multiplying every term of a regular sequence in a ring by a common unit keeps it regular. -/
theorem RingTheory.Sequence.IsRegular.map_mul_unit {A : Type*} [CommRing A] {rs : List A}
    (h : RingTheory.Sequence.IsRegular A rs) {u : A} (hu : IsUnit u) :
    RingTheory.Sequence.IsRegular A (rs.map (u * ·)) := by
  refine ⟨(RingTheory.Sequence.isWeaklyRegular_iff_forall_mul_mem _).2 fun i hi y hy ↦ ?_, ?_⟩
  · rw [List.length_map] at hi
    rw [← List.map_take, Ideal.ofList_map_mul_unit hu, List.getElem_map, mul_assoc,
      Ideal.unit_mul_mem_iff_mem _ hu] at hy
    rw [← List.map_take, Ideal.ofList_map_mul_unit hu]
    exact (RingTheory.Sequence.isWeaklyRegular_iff_forall_mul_mem _).1 h.toIsWeaklyRegular i hi y hy
  · rw [Ideal.ofList_map_mul_unit hu]
    exact h.top_ne_smul
