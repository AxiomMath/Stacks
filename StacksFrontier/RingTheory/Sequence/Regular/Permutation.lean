/-!
# Permutations and subsequences of regular sequences

Stacks 00LJ — over a local Noetherian ring, any permutation of an `M`-regular sequence for a
finite module `M` is again `M`-regular — is Mathlib's `IsLocalRing.isRegular_of_perm`, which
asks only that `M` be a Noetherian module rather than a finite module over a Noetherian ring.
-/

@[expose] public section

add_to_stacks 00LJ "for a Noetherian module over a local ring" IsLocalRing.isRegular_of_perm

end

/-!
# Permutations, subsequences and polynomial-ring regular sequences

Throughout, `R` is a commutative ring (with unit).

## Definitions

- **Nonzerodivisor.** For an `R`-module `M` and `f : R`, `f` is a nonzerodivisor on `M`
  if the map `m ↦ f • m` is injective. This is Mathlib's `IsSMulRegular M f`.

- **Regular sequence.** (Stacks Tag 00LF, specialized to `M = R`.) A finite sequence
  `f_1, …, f_r ∈ R` is a regular sequence if for each `i` the image of `f_i` in
  `R/(f_1, …, f_{i-1})` is a nonzerodivisor on `R/(f_1, …, f_{i-1})`, and additionally
  `R/(f_1, …, f_r) ≠ 0`. This is Mathlib's `RingTheory.Sequence.IsRegular R fs`
  (specialized to the `R`-module `R`).

- **Permutation of a sequence.** A reordering of `f_1, …, f_r`; modeled here as a list
  `l'` with `l'.Perm fs` (`l'` is a permutation of `fs`).

- **Subsequence in the given order.** For indices `1 ≤ i_1 < ⋯ < i_k ≤ r`, the sequence
  `f_{i_1}, …, f_{i_k}`. Modeled here as a sublist `l' <+ fs` (`List.Sublist`), which
  preserves order and omits some elements.

- **Polynomial ring regular sequence.** In `R[x_1, …, x_r] = MvPolynomial (Fin r) R`, the
  elements `f_i x_i` (i.e. `C (f_i) * X i`) form a regular sequence.

## The statement

Let `R` be a ring and `f_1, …, f_r ∈ R` with `(f_1, …, f_r) ≠ R`. Then the following are
equivalent:

1. Every permutation of `f_1, …, f_r` is a regular sequence in `R`.
2. Every subsequence (in the given order) of `f_1, …, f_r` is a regular sequence in `R`.
3. The sequence `f_1 x_1, …, f_r x_r` is a regular sequence in `R[x_1, …, x_r]`.

## Notes

- The standing hypothesis `(f_1, …, f_r) ≠ R` is the ideal generated by the entries of
  `fs` being a proper ideal. We encode the ideal `(f_1, …, f_r)` as
  `Ideal.span {x | x ∈ fs}`, the span of the (underlying set of the) list `fs`. This is a
  standard Mathlib expression and equals the ideal generated by `f_1, …, f_r`.
-/

@[expose] public section

open RingTheory.Sequence List

variable {R : Type*} [CommRing R]

/-- The polynomial-ring sequence `f_1 x_1, …, f_r x_r` associated to a list `fs : List R`,
as a list of elements of `MvPolynomial (Fin fs.length) R`. The `i`-th entry is
`C (fs[i]) * X i`. -/
noncomputable def polySeq (fs : List R) : List (MvPolynomial (Fin fs.length) R) :=
  List.ofFn (fun i : Fin fs.length => MvPolynomial.C (fs.get i) * MvPolynomial.X i)

/-- `IsRegular` for the module `R` unfolds to weak regularity plus properness of the
generated ideal. -/
private lemma isRegular_iff' (rs : List R) :
    IsRegular R rs ↔ IsWeaklyRegular R rs ∧ Ideal.ofList rs ≠ ⊤ := by
  rw [isRegular_iff]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨h1, fun hc => h2 (by rw [hc, ideal_smul_top])⟩
  · rintro ⟨h1, h2⟩
    exact ⟨h1, by rw [ideal_smul_top]; exact fun hc => h2 hc.symm⟩

private lemma ofList_mono {l' fs : List R} (h : l' <+ fs) :
    Ideal.ofList l' ≤ Ideal.ofList fs := by
  unfold Ideal.ofList
  exact Ideal.span_mono (fun x hx => h.mem hx)

/-- A sublist of a list generating a proper ideal generates a proper ideal. -/
private lemma ofList_ne_top_of_sublist {l' fs : List R} (hfs : Ideal.span {x | x ∈ fs} ≠ ⊤)
    (h : l' <+ fs) : Ideal.ofList l' ≠ ⊤ :=
  fun hc => hfs (top_le_iff.mp (hc ▸ ofList_mono h))

private lemma ofList_perm {l' fs : List R} (h : l'.Perm fs) :
    Ideal.ofList l' = Ideal.ofList fs := by
  unfold Ideal.ofList
  congr 1
  ext x
  exact h.mem_iff

/-! ### The monomial-graded ideal-membership characterization -/

/-- Coefficient-side ideal: `(f_j : j ∈ s, α_j ≠ 0)` in `R`. -/
private noncomputable def kIdeal {n : ℕ} (f : Fin n → R) (s : Finset (Fin n)) (α : Fin n →₀ ℕ) :
    Ideal R :=
  Ideal.span (f '' {j | j ∈ s ∧ α j ≠ 0})

/-- Polynomial-side ideal generated by `C (f_j) * X j` for `j ∈ s`. -/
private noncomputable def jIdeal {n : ℕ} (f : Fin n → R) (s : Finset (Fin n)) :
    Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span ((fun j => MvPolynomial.C (f j) * MvPolynomial.X j) '' s)

open MvPolynomial in
private lemma coeff_gen_mul {n : ℕ} (j : Fin n) (fj : R) (q : MvPolynomial (Fin n) R)
    (α : Fin n →₀ ℕ) :
    (C fj * X j * q).coeff α = if α j ≠ 0 then fj * q.coeff (α - Finsupp.single j 1) else 0 := by
  rw [show C fj * X j * q = (C fj * q) * X j by ring, coeff_mul_X']
  simp [Finsupp.mem_support_iff, coeff_C_mul]

private lemma kIdeal_mono {n : ℕ} (f : Fin n → R) (s : Finset (Fin n)) {γ α : Fin n →₀ ℕ}
    (h : γ ≤ α) : kIdeal f s γ ≤ kIdeal f s α := by
  refine Ideal.span_mono (Set.image_mono fun j hj => ⟨hj.1, fun h0 => hj.2 ?_⟩)
  have := h j
  omega

open MvPolynomial in
/-- Forward direction of the characterization: if `p ∈ jIdeal f s` then every coefficient of `p`
lies in the corresponding `kIdeal`. -/
private lemma jIdeal_coeff_mem {n : ℕ} (f : Fin n → R) (s : Finset (Fin n))
    (p : MvPolynomial (Fin n) R) (hp : p ∈ jIdeal f s) :
    ∀ α, p.coeff α ∈ kIdeal f s α := by
  induction hp using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      intro α
      simp only
      rw [show (C (f j) * X j : MvPolynomial (Fin n) R) = C (f j) * X j * 1 by ring, coeff_gen_mul]
      split
      · rename_i hαj
        exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, ⟨hj, hαj⟩, rfl⟩)
      · exact Ideal.zero_mem _
  | zero => intro α; simp
  | add x y hx hy ihx ihy =>
      intro α
      rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply]
      exact Ideal.add_mem _ (ihx α) (ihy α)
  | smul a x hx ih =>
      intro α
      rw [smul_eq_mul, coeff_mul]
      apply Ideal.sum_mem
      rintro ⟨β, γ⟩ hbg
      rw [Finset.mem_antidiagonal] at hbg
      exact kIdeal_mono f s (hbg ▸ le_add_self) (Ideal.mul_mem_left _ _ (ih γ))

open MvPolynomial in
private lemma monomial_one_split {n : ℕ} (j : Fin n) (α : Fin n →₀ ℕ) (h : α j ≠ 0) :
    (monomial α (1:R)) = X j * monomial (α - Finsupp.single j 1) 1 := by
  have hexp : α = Finsupp.single j 1 + (α - Finsupp.single j 1) := by
    ext k
    simp only [Finsupp.add_apply, Finsupp.single_apply, Finsupp.tsub_apply]
    by_cases hk : j = k
    · subst hk; simp only [ite_eq_left]; omega
    · simp [hk]
  rw [X, monomial_mul_monomial, one_mul, ← hexp]

open MvPolynomial in
private lemma monomial_mem_jIdeal {n : ℕ} (f : Fin n → R) (s : Finset (Fin n)) (α : Fin n →₀ ℕ)
    (c : R) (hc : c ∈ kIdeal f s α) : monomial α c ∈ jIdeal f s := by
  unfold kIdeal at hc
  induction hc using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      rw [show (monomial α (f j) : MvPolynomial (Fin n) R) = C (f j) * monomial α 1 by
            rw [C_mul_monomial, mul_one], monomial_one_split j α hj.right,
        show C (f j) * (X j * monomial (α - Finsupp.single j 1) 1)
          = (C (f j) * X j) * monomial (α - Finsupp.single j 1) 1 by ring]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨j, hj.left, rfl⟩)
  | zero => simp
  | add x y hx hy ihx ihy =>
      rw [LinearMap.map_add]
      exact Ideal.add_mem _ ihx ihy
  | smul a x hx ih =>
      rw [smul_eq_mul, ← C_mul_monomial]
      exact Ideal.mul_mem_left _ _ ih

open MvPolynomial in
/-- The monomial-graded characterization of membership in `jIdeal`. -/
private lemma mem_jIdeal_iff {n : ℕ} (f : Fin n → R) (s : Finset (Fin n))
    (p : MvPolynomial (Fin n) R) :
    p ∈ jIdeal f s ↔ ∀ α, p.coeff α ∈ kIdeal f s α := by
  refine ⟨jIdeal_coeff_mem f s p, fun hco => ?_⟩
  nth_rewrite 1 [as_sum p]
  exact Ideal.sum_mem _ fun α _ => monomial_mem_jIdeal f s α _ (hco α)

/-- `kIdeal` is unchanged by adding `e_{i'}` to the exponent vector when `i' ∉ s`. -/
private lemma kIdeal_shift {n : ℕ} (f : Fin n → R) (s : Finset (Fin n)) (α : Fin n →₀ ℕ)
    (i' : Fin n) (hi' : i' ∉ s) : kIdeal f s (α + Finsupp.single i' 1) = kIdeal f s α := by
  have hkey : ∀ j ∈ s, ((α + Finsupp.single i' 1 : Fin n →₀ ℕ)) j = α j := by
    intro j hjs
    have hji : i' ≠ j := fun h => hi' (h ▸ hjs)
    rw [Finsupp.add_apply, Finsupp.single_apply, ite_eq_right hji, add_zero]
  unfold kIdeal
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨j, ⟨hjs, hj0⟩, rfl⟩
    exact ⟨j, ⟨hjs, by rwa [hkey j hjs] at hj0⟩, rfl⟩
  · rintro ⟨j, ⟨hjs, hj0⟩, rfl⟩
    exact ⟨j, ⟨hjs, by rwa [hkey j hjs]⟩, rfl⟩

private lemma polySeq_length (fs : List R) : (polySeq fs).length = fs.length := by
  simp [polySeq]

/-- `take m` of `finRange` equals the filter `(· < m)`. -/
private lemma take_finRange_eq_filter (r : ℕ) (m : ℕ) :
    (List.finRange r).take m = (List.finRange r).filter (fun j => decide (j.val < m)) := by
  have hpw : (List.finRange r).Pairwise (·<·) :=
    (List.sortedLT_iff_pairwise).mp (List.sortedLT_finRange r)
  apply List.Subset.antisymm_of_sortedLT
  · intro x hx
    rw [List.mem_filter]
    refine ⟨List.mem_of_mem_take hx, ?_⟩
    obtain ⟨k, hk, rfl⟩ := List.mem_take_iff_getElem.mp hx
    simp only [List.getElem_finRange] at *
    simp only [decide_eq_true_eq, Fin.cast]
    omega
  · intro x hx
    rw [List.mem_filter] at hx
    obtain ⟨hmem, hlt⟩ := hx
    simp only [decide_eq_true_eq] at hlt
    rw [List.mem_take_iff_getElem]
    exact ⟨x.val, by simp [hlt, x.isLt], by simp [List.getElem_finRange]⟩
  · rw [List.sortedLT_iff_pairwise]; exact List.Pairwise.sublist (List.take_sublist m _) hpw
  · rw [List.sortedLT_iff_pairwise]; exact List.Pairwise.sublist List.filter_sublist hpw

omit [CommRing R] in
/-- The prefix selected from `fs` by a predicate `P` (with all selected indices `< i`),
followed by `fs.get i`, is a sublist of `fs`. -/
private lemma prefix_append_sublist (fs : List R) (i : Fin fs.length) (P : Fin fs.length → Bool)
    (hP : ∀ j, P j → (j : ℕ) < i.val) :
    (((List.finRange fs.length).filter P).map fs.get) ++ [fs.get i] <+ fs := by
  have key : (((List.finRange fs.length).filter P) ++ [i]) <+ List.finRange fs.length := by
    have h1 : (List.finRange fs.length).filter P <+ (List.finRange fs.length).take i.val := by
      rw [take_finRange_eq_filter]
      exact List.monotone_filter_right _
        (fun j hj => by simp only [decide_eq_true_eq]; exact hP j hj)
    have h2 : (List.finRange fs.length).take i.val ++ [i]
        = (List.finRange fs.length).take (i.val+1) := by
      rw [List.take_add_one]
      congr 1
      simp []
    calc (List.finRange fs.length).filter P ++ [i]
        <+ (List.finRange fs.length).take i.val ++ [i] :=
          List.Sublist.append h1 (List.Sublist.refl _)
      _ = (List.finRange fs.length).take (i.val+1) := h2
      _ <+ List.finRange fs.length := List.take_sublist _ _
  have := key.map fs.get
  rwa [List.map_append, List.map_cons, List.map_nil, List.map_get_finRange] at this

open MvPolynomial in
/-- `ofList (prefix)` equals the `kIdeal` for the relevant index set. -/
private lemma ofList_prefix_eq (fs : List R) (i : Fin fs.length) (α : Fin fs.length →₀ ℕ) :
    Ideal.ofList (((List.finRange fs.length).filter
        (fun j => decide (j.val < i.val) && decide (α j ≠ 0))).map fs.get)
      = kIdeal fs.get (Finset.univ.filter (fun j => j.val < i.val)) α := by
  unfold Ideal.ofList kIdeal
  congr 1
  ext x
  simp only [List.mem_map, List.mem_filter, List.mem_finRange, true_and, Bool.and_eq_true,
    decide_eq_true_eq, Set.mem_image, Set.mem_ofPred_eq, Finset.mem_filter, Finset.mem_univ]

/-- Descent step: from regularity of all ordered subsequences, `fs.get i` is a nonzerodivisor on
`R ⧸ kIdeal`. -/
private lemma isSMulRegular_quot_kIdeal (fs : List R)
    (h2 : ∀ l' : List R, l' <+ fs → IsRegular R l')
    (i : Fin fs.length) (α : Fin fs.length →₀ ℕ) :
    IsSMulRegular (R ⧸ kIdeal fs.get (Finset.univ.filter (fun j => j.val < i.val)) α)
      (fs.get i) := by
  set P : Fin fs.length → Bool := fun j => decide (j.val < i.val) && decide (α j ≠ 0) with hPdef
  have hP : ∀ j, P j → (j:ℕ) < i.val := by
    intro j hj; rw [hPdef] at hj
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hj; exact hj.left
  set pre := ((List.finRange fs.length).filter P).map fs.get with hpre
  have hsub : pre ++ [fs.get i] <+ fs := prefix_append_sublist fs i P hP
  have hreg : IsRegular R (pre ++ [fs.get i]) := h2 _ hsub
  have hwr : IsWeaklyRegular R (pre ++ [fs.get i]) := hreg.toIsWeaklyRegular
  rw [isWeaklyRegular_append_iff] at hwr
  obtain ⟨_, hwr2⟩ := hwr
  rw [isWeaklyRegular_cons_iff] at hwr2
  obtain ⟨hsmul, _⟩ := hwr2
  rw [ideal_smul_top, ofList_prefix_eq fs i α] at hsmul
  exact hsmul

open MvPolynomial in
/-- Central nonzerodivisor step: `C (fs.get i') * X i'` is a nonzerodivisor on `S ⧸ jIdeal`. -/
private lemma smulReg_gen (fs : List R) (h2 : ∀ l' : List R, l' <+ fs → IsRegular R l')
    (i' : Fin fs.length) :
    IsSMulRegular
      (MvPolynomial (Fin fs.length) R ⧸
        jIdeal fs.get (Finset.univ.filter (fun j => j.val < i'.val)))
      (C (fs.get i') * X i') := by
  set s := Finset.univ.filter (fun j : Fin fs.length => j.val < i'.val) with hs
  have hi's : i' ∉ s := by rw [hs]; simp
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  rw [smul_eq_mul] at hp
  rw [mem_jIdeal_iff]
  intro α
  rw [mem_jIdeal_iff] at hp
  have hβ := hp (α + Finsupp.single i' 1)
  rw [coeff_gen_mul] at hβ
  have hβi' : ((α + Finsupp.single i' 1 : Fin fs.length →₀ ℕ)) i' ≠ 0 := by
    rw [Finsupp.add_apply, Finsupp.single_apply, ite_eq_left rfl]; omega
  rw [ite_eq_left hβi'] at hβ
  rw [add_tsub_cancel_right] at hβ
  rw [kIdeal_shift fs.get s α i' hi's] at hβ
  have hdesc := isSMulRegular_quot_kIdeal fs h2 i' α
  exact mem_of_isSMulRegular_quotient_of_smul_mem hdesc (by rwa [smul_eq_mul])

open MvPolynomial in
/-- `ofList (take i (polySeq fs))` equals the `jIdeal` for the relevant index set. -/
private lemma ofList_take_polySeq (fs : List R) (i : Fin (polySeq fs).length) :
    Ideal.ofList ((polySeq fs).take i.val)
      = jIdeal fs.get (Finset.univ.filter (fun j : Fin fs.length => j.val < i.val)) := by
  unfold Ideal.ofList jIdeal polySeq
  congr 1
  ext x
  simp only [List.mem_take_iff_getElem, List.getElem_ofFn, Set.mem_image, Finset.coe_filter,
    Finset.mem_univ, true_and, Set.mem_ofPred_eq, List.length_ofFn]
  constructor
  · rintro ⟨j, hj, rfl⟩
    rw [lt_min_iff] at hj
    exact ⟨⟨j, hj.right⟩, hj.left, rfl⟩
  · rintro ⟨k, hk, rfl⟩
    exact ⟨k.val, lt_min hk k.isLt, by congr⟩

open MvPolynomial in
/-- Weak regularity of `polySeq fs`. -/
private lemma weaklyReg_polySeq (fs : List R)
    (h2 : ∀ l' : List R, l' <+ fs → IsRegular R l') :
    IsWeaklyRegular (MvPolynomial (Fin fs.length) R) (polySeq fs) := by
  rw [isWeaklyRegular_iff_Fin]
  intro i
  rw [ideal_smul_top, ofList_take_polySeq fs i]
  have hreg := smulReg_gen fs h2 (Fin.cast (polySeq_length fs) i)
  have hidx : (polySeq fs)[i] = (polySeq fs)[i.val] := rfl
  rw [hidx]
  simp only [polySeq, List.getElem_ofFn]
  exact hreg

open MvPolynomial in
/-- Properness of `polySeq fs`: the generated ideal is not the unit ideal. -/
private lemma proper_polySeq (fs : List R) (hfs : Ideal.span {x | x ∈ fs} ≠ ⊤) :
    Ideal.ofList (polySeq fs) ≠ ⊤ := by
  have hnt : Nontrivial R := by
    rcases subsingleton_or_nontrivial R with h | h
    · exact absurd (Subsingleton.elim _ _) hfs
    · exact h
  intro htop
  rw [Ideal.eq_top_iff_one] at htop
  have hgen : ∀ x ∈ {x | x ∈ polySeq fs}, (eval (fun _ => (0:R))) x = 0 := by
    intro x hx
    simp only [Set.mem_ofPred_eq] at hx
    unfold polySeq at hx
    rw [List.mem_ofFn] at hx
    obtain ⟨j, rfl⟩ := hx
    simp
  have key : ∀ y ∈ Ideal.ofList (polySeq fs), (eval (fun _ => (0:R))) y = 0 := by
    intro y hy
    unfold Ideal.ofList at hy
    induction hy using Submodule.span_induction with
    | mem x hx => exact hgen x hx
    | zero => simp
    | add x y hx hy ihx ihy => rw [map_add, ihx, ihy, add_zero]
    | smul a x hx ih => rw [smul_eq_mul, map_mul, ih, mul_zero]
  have h10 : (1:R) = 0 := by simpa using key 1 htop
  exact one_ne_zero h10

/-- **SG-A (`2 → 3`), the analytic heart (cf. Stacks Tag 07DV).**

From "every ordered subsequence of `fs` is a regular sequence in `R`" we must derive that
the polynomial-ring sequence `polySeq fs = [C f₀ * X 0, …, C f_{r-1} * X (r-1)]` is a regular
sequence in `S := MvPolynomial (Fin r) R` (`r = fs.length`).

The argument, by monomial grading and a quotient tower:
* `S` is the free `R`-module on the monomials `x^α`, `α : Fin r →₀ ℕ`.
* For `0 ≤ i ≤ r`, let `J_i = (C f₀ X 0, …, C f_{i-1} X (i-1))` be the ideal generated by the
  first `i` generators of `polySeq fs`. The key structural fact is that the quotient `S / J_i`
  decomposes, as an `R`-module, into a direct sum over monomials `x^α` of the *first `r`* (or
  more precisely the first `i`) variables: on the monomial component `x^α`, multiplication by
  the relation `C f_j X j` (for `j < i`) identifies `f_j · x^α` (placed in degree `α + e_j`)
  with `0`. Concretely `S / J_i ≅ ⨁_{α} (R / (f_j : j < i, α_j ≥ 1)) · x^α` as an `R`-module:
  the coefficient ring at monomial `x^α` is `R` modulo the ideal generated by those `f_j`
  (`j < i`) for which the `j`-th exponent `α_j` is positive (only then does the relation
  `C f_j X j` reach `x^α`).
* The image of the next generator `C f_i X i` acts on the `x^α` component by sending it to the
  `x^{α + e_i}` component, multiplying the `R`-coefficient by `f_i`. Whether `f_i` is a
  nonzerodivisor on the target coefficient ring `R / (f_j : j < i, (α+e_i)_j ≥ 1)` is exactly
  the regularity (nonzerodivisor) condition for the *ordered subsequence* `(f_j : j ∈ J)` of
  `fs`, where `J = {j < i : α_j ≥ 1} ∪ {i}`. By hypothesis (2) every such ordered subsequence
  of `fs` is a regular sequence, so `f_i` is a nonzerodivisor modulo `(f_j : j < i in J)`,
  hence `C f_i X i` is a nonzerodivisor on `S / J_i`. This gives weak regularity of `polySeq fs`.
* Properness of `polySeq fs`: `S / (polySeq fs) ≠ 0`. Note `(polySeq fs) ∩ R = (f₀,…,f_{r-1})`
  via the constant-term / "set `x_i = 0`" `R`-algebra map `S → R`, whose composite with the
  quotient is surjective onto `R / (f₀,…,f_{r-1})`; the latter is nonzero by `hfs`. So
  `S / (polySeq fs)` surjects onto a nonzero ring, hence is nonzero.

The reduction: `IsRegular S (polySeq fs)` becomes, via `isRegular_iff`,
`IsWeaklyRegular S (polySeq fs) ∧ (Ideal.ofList (polySeq fs)) • ⊤ ≠ ⊤`. The properness half
goes through the evaluation map `MvPolynomial.eval (fun _ => 0)` (or `aeval 0`) pushing `hfs`.
The weak-regularity half is the monomial-grading induction; the cleanest Mathlib route is to
identify `S / J_i` with a graded/`Finsupp`-indexed sum and reduce nonzerodivisor-ness on each
graded piece to hypothesis (2). -/
private lemma sg_two_to_three (fs : List R) (hfs : Ideal.span {x | x ∈ fs} ≠ ⊤)
    (h2 : ∀ l' : List R, l' <+ fs → IsRegular R l') :
    IsRegular (MvPolynomial (Fin fs.length) R) (polySeq fs) := by
  rw [isRegular_iff']
  exact ⟨weaklyReg_polySeq fs h2, proper_polySeq fs hfs⟩

/-! ### Descent `S → R` and permutation invariance of the polynomial-side weak regularity -/

open MvPolynomial in
/-- **Reverse descent (S → R), arbitrary subset.** If `C (g k) * X k` is a nonzerodivisor on the
quotient `S ⧸ jIdeal g s` (where `k ∉ s`), then `g k` is a nonzerodivisor on the coefficient-side
quotient `R ⧸ kIdeal g s α` for *every* exponent vector `α`. This is the converse of the central
step `smulReg_gen`/`isSMulRegular_quot_kIdeal`; it lets us extract `R`-regularity from polynomial
regularity by
restricting to the monomial component `x^α`. Proof: lift `c ∈ R` with `g k · c ∈ kIdeal g s α` to
the monomial `monomial α c`; show `(C (g k) * X k) • monomial α c ∈ jIdeal g s` coefficient-wise
(only the `α + e_k` coefficient is nonzero, equal to `g k · c`, and `kIdeal_shift` removes
the `e_k`
since `k ∉ s`); then regularity (`isSMulRegular_quotient_iff_mem_of_smul_mem` +
`mem_of_isSMulRegular_quotient_of_smul_mem`) forces `monomial α c ∈ jIdeal g s`, whose
`α`-coefficient
`c` lands in `kIdeal g s α`. (This proof was produced complete by the closer.) -/
private lemma isSMulRegular_quot_kIdeal_of_jIdeal {n : ℕ} (g : Fin n → R) (s : Finset (Fin n))
    (k : Fin n) (hk : k ∉ s) (α : Fin n →₀ ℕ)
    (hS : IsSMulRegular (MvPolynomial (Fin n) R ⧸ jIdeal g s) (C (g k) * X k)) :
    IsSMulRegular (R ⧸ kIdeal g s α) (g k) := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro c hc
  rw [smul_eq_mul] at hc
  have hmem : (C (g k) * X k) • (monomial α c : MvPolynomial (Fin n) R) ∈ jIdeal g s := by
    rw [smul_eq_mul, mem_jIdeal_iff]
    intro β
    rw [coeff_gen_mul]
    split
    · rename_i hβk
      by_cases hβ : β = α + Finsupp.single k 1
      · subst hβ
        rwa [add_tsub_cancel_right, coeff_monomial, ite_eq_left rfl, kIdeal_shift g s α k hk]
      · rw [coeff_monomial, ite_eq_right (by
          intro hcontra; apply hβ
          have hle : Finsupp.single k 1 ≤ β := by
            intro m; simp only [Finsupp.single_apply]; split
            · rename_i hkm; subst hkm; omega
            · omega
          rw [hcontra, tsub_add_cancel_of_le hle]), mul_zero]
        exact Ideal.zero_mem _
    · exact Ideal.zero_mem _
  have hmono := mem_of_isSMulRegular_quotient_of_smul_mem hS hmem
  rw [mem_jIdeal_iff] at hmono
  have := hmono α
  rwa [coeff_monomial, ite_eq_left rfl] at this

open MvPolynomial in
/-- If `polySeq fs` is a regular sequence, then `fs.get i'` is a nonzerodivisor on
`R ⧸ kIdeal fs.get {j < i'} α` for every exponent vector `α`. -/
private lemma smulReg_kIdeal_of_polySeq (fs : List R)
    (h3 : IsRegular (MvPolynomial (Fin fs.length) R) (polySeq fs))
    (i' : Fin fs.length) (α : Fin fs.length →₀ ℕ) :
    IsSMulRegular (R ⧸ kIdeal fs.get (Finset.univ.filter (fun j => j.val < i'.val)) α)
      (fs.get i') := by
  have hw := h3.toIsWeaklyRegular
  rw [isWeaklyRegular_iff_Fin] at hw
  set k : Fin (polySeq fs).length := Fin.cast (polySeq_length fs).symm i'
  have hgk := hw k
  rw [ideal_smul_top, ofList_take_polySeq fs k] at hgk
  have hidx : (polySeq fs)[k] = C (fs.get i') * X i' := by
    show (polySeq fs)[k.val] = _
    simp only [polySeq, List.getElem_ofFn]
    congr 1
  rw [hidx] at hgk
  exact isSMulRegular_quot_kIdeal_of_jIdeal fs.get _ i' (by simp) α hgk

/-- If `φ` realizes `l'` as a sublist of `fs`, then the ideal generated by the first `t` entries
of `l'` is the `kIdeal` at `φ t` for the indicator of `φ '' {s < t}`. -/
private lemma ofList_take_eq_kIdeal (fs l' : List R) (φ : Fin l'.length ↪o Fin fs.length)
    (hφ : ∀ i, l'.get i = fs.get (φ i)) (t : Fin l'.length) :
    Ideal.ofList (l'.take t.val)
      = kIdeal fs.get (Finset.univ.filter (fun j => j.val < (φ t).val))
          (Finsupp.indicator ((Finset.univ.filter (fun s : Fin l'.length => s.val < t.val)).image φ)
            (fun _ _ => 1)) := by
  set E := (Finset.univ.filter (fun s : Fin l'.length => s.val < t.val)).image φ with hE
  have hαne : ∀ j, Finsupp.indicator E (fun _ _ => (1 : ℕ)) j ≠ 0 ↔ j ∈ E := fun j => by
    simp [Finsupp.indicator_apply]
  unfold Ideal.ofList kIdeal
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
    List.mem_take_iff_getElem, Nat.lt_min]
  constructor
  · rintro ⟨s, ⟨hst, hslt⟩, rfl⟩
    refine ⟨φ ⟨s, hslt⟩, ⟨φ.lt_iff_lt.mpr (Fin.lt_def.mpr hst), ?_⟩,
      by simpa using (hφ ⟨s, hslt⟩).symm⟩
    rw [hαne, hE]
    exact Finset.mem_image_of_mem φ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hst⟩)
  · rintro ⟨j, ⟨hjlt, hjne⟩, rfl⟩
    rw [hαne, hE] at hjne
    obtain ⟨s', hs', rfl⟩ := Finset.mem_image.mp hjne
    exact ⟨s'.val, ⟨by simpa using hs', s'.isLt⟩, by simpa using hφ s'⟩

open MvPolynomial in
/-- **(3) → (2): polynomial-sequence regularity implies subsequence regularity.** From
`IsRegular S (polySeq fs)` (equivalently, by `isRegular_iff'`, weak regularity of `polySeq fs`
together with properness), every ordered subsequence `l' <+ fs` is a regular sequence in `R`.

This is the converse half of `sg_two_to_three`'s monomial-grading argument (Stacks 07DW, the
"(3) implies (2)" paragraph): writing `R[x]/(f_{i_1}x_{i_1}, …)` as the `R`-module direct sum
`⨁_E R/I_E · x^E`, regularity of `C(f_k)*X k` forces `f_k` to be a nonzerodivisor on `R/I_E` for
*every* multi-index `E`; choosing `E` supported exactly on a given subsequence's earlier indices
recovers the `R`-level nonzerodivisor condition for that subsequence. Formally this descends
through the prefix facts of `hw` and `isSMulRegular_quot_kIdeal_of_jIdeal`. Properness of every
subsequence follows from `hfs` (`ofList_mono`). -/
private lemma three_to_two (fs : List R) (hfs : Ideal.span {x | x ∈ fs} ≠ ⊤)
    (h3 : IsRegular (MvPolynomial (Fin fs.length) R) (polySeq fs)) :
    ∀ l' : List R, l' <+ fs → IsRegular R l' := by
  intro l' hsub
  rw [isRegular_iff']
  -- order-embedding from the sublist
  obtain ⟨φ, hφ⟩ := List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub
  -- properness
  refine ⟨?_, ofList_ne_top_of_sublist hfs hsub⟩
  -- weak regularity
  rw [isWeaklyRegular_iff_Fin]
  intro t
  rw [ideal_smul_top, ofList_take_eq_kIdeal fs l' φ hφ t,
    show l'[t] = fs.get (φ t) by simpa using hφ t]
  exact smulReg_kIdeal_of_polySeq fs h3 (φ t) _

/-- "Every ordered sublist is a regular sequence", stated for a general module `M`. This is the
hypothesis side of Stacks 07DW (2), generalized to modules so that the `(2) → (1)` induction can
descend through quotient modules `M ⧸ (c)M`. -/
private def SubReg (M : Type*) [AddCommGroup M] [Module R M] (l : List R) : Prop :=
  ∀ s : List R, s <+ l → IsRegular M s

/-- `SubReg` passes to sublists. -/
private lemma SubReg.mono {M : Type*} [AddCommGroup M] [Module R M] {l l' : List R}
    (h : SubReg M l) (hsub : l' <+ l) : SubReg M l' :=
  fun s hs => h s (hs.trans hsub)

/-- A member of `l` is a nonzerodivisor on `M` when every sublist of `l` is `M`-regular. -/
private lemma SubReg.isSMulRegular {M : Type*} [AddCommGroup M] [Module R M] {l : List R}
    (h : SubReg M l) {c : R} (hc : c ∈ l) : IsSMulRegular M c :=
  ((isRegular_cons_iff M c []).mp (h [c] (List.singleton_sublist.mpr hc))).left

/-- `SubReg` passes to the quotient by the head of the list. -/
private lemma SubReg.quot_cons {M : Type*} [AddCommGroup M] [Module R M] {a : R} {rest : List R}
    (h : SubReg M (a :: rest)) : SubReg (QuotSMulTop a M) rest :=
  fun t ht => ((isRegular_cons_iff M a t).mp (h _ (ht.cons_cons a))).right

/-- **Module-level length-two swap (Stacks 07DW, the `r = 2` case, for a general module `M`).**
If `[a, b]` is a regular sequence on `M` and `b` is a nonzerodivisor on `M`, then `[b, a]` is a
regular sequence on `M`. The kernel-isomorphism argument works with `IsSMulRegular`, `QuotSMulTop`,
and `Submodule.mem_smul_pointwise_iff_exists`, with properness via `Ideal.ofList` permutation. -/
private lemma reg_swap2_M (M : Type*) [AddCommGroup M] [Module R M] (a b : R)
    (hab : IsRegular M [a, b]) (hb : IsSMulRegular M b) : IsRegular M [b, a] := by
  rw [isRegular_iff] at hab ⊢
  obtain ⟨hwab, hpab⟩ := hab
  refine ⟨?_, ?_⟩
  · -- weak regularity of [b,a]
    rw [isWeaklyRegular_cons_iff] at hwab
    obtain ⟨hA, hwb⟩ := hwab
    rw [isWeaklyRegular_cons_iff] at hwb
    obtain ⟨hbqa, _⟩ := hwb
    rw [isWeaklyRegular_cons_iff]
    refine ⟨hb, ?_⟩
    rw [isWeaklyRegular_cons_iff]
    refine ⟨?_, IsWeaklyRegular.nil _ _⟩
    unfold QuotSMulTop at hbqa ⊢
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem] at hbqa ⊢
    intro x hx
    rw [Submodule.mem_smul_pointwise_iff_exists] at hx ⊢
    obtain ⟨y, -, hy⟩ := hx
    have hymem := hbqa y ?_
    · rw [Submodule.mem_smul_pointwise_iff_exists] at hymem
      obtain ⟨z, -, hz⟩ := hymem
      exact ⟨z, trivial, hA (show a • (b • z) = a • x by rw [smul_comm, hz, hy])⟩
    · rw [Submodule.mem_smul_pointwise_iff_exists]
      exact ⟨x, trivial, hy.symm⟩
  · rwa [ofList_perm (List.Perm.swap a b [])]

/-- **Tower-swap linear equivalence.** For `a b : R` and a module `M`, the two iterated quotients
`QuotSMulTop b (QuotSMulTop a M)` and `QuotSMulTop a (QuotSMulTop b M)` are `R`-linearly
isomorphic, both being isomorphic to `M ⧸ ((a) + (b)) M`, the join being symmetric.  Built by
composing the
"outer cons" equivalences `Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter` with the
permutation-invariance of `Ideal.ofList [a,b] = Ideal.ofList [b,a]`. -/
private def towerSwap (M : Type*) [AddCommGroup M] [Module R M] (a b : R) :
    QuotSMulTop b (QuotSMulTop a M) ≃ₗ[R] QuotSMulTop a (QuotSMulTop b M) := by
  have e : ∀ c : R, QuotSMulTop c M ≃ₗ[R] (M ⧸ (Ideal.ofList [c] • (⊤ : Submodule R M))) :=
    fun c => Submodule.quotEquivOfEq _ _ (by
      unfold Ideal.ofList
      have hset : {r | r ∈ ([c] : List R)} = ({c} : Set R) := by ext x; simp
      rw [hset, Submodule.ideal_span_singleton_smul])
  have e1 := (Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter M b [a])
  have e2 := (Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter M a [b])
  have emid : (M ⧸ (Ideal.ofList ([b,a]:List R) • (⊤ : Submodule R M)))
      ≃ₗ[R] (M ⧸ (Ideal.ofList ([a,b]:List R) • (⊤ : Submodule R M))) :=
    Submodule.quotEquivOfEq _ _ (by rw [ofList_perm (List.Perm.swap a b [])])
  exact (QuotSMulTop.congr b (e a)).trans
    (e1.symm.trans (emid.trans (e2.trans (QuotSMulTop.congr a (e b)).symm)))

private lemma subReg_quot (M : Type*) [AddCommGroup M] [Module R M] (l : List R)
    (hl : SubReg M l) (i : Fin l.length) :
    SubReg (QuotSMulTop l[i] M) (l.eraseIdx i.val) := by
  induction l generalizing M with
  | nil => exact i.elim0
  | cons a rest ih =>
    rcases i with ⟨iv, hiv⟩
    match iv, hiv with
    | 0, hiv =>
      -- `l[0] = a`, `l.eraseIdx 0 = rest`. Peel `a` off the front via `isRegular_cons_iff`.
      show SubReg (QuotSMulTop a M) rest
      exact hl.quot_cons
    | (j + 1), hiv =>
      have hjr : j < rest.length := by simpa using hiv
      have hidx : (a :: rest)[(⟨j + 1, hiv⟩ : Fin (a :: rest).length)]
          = rest[(⟨j, hjr⟩ : Fin rest.length)] := rfl
      rw [hidx]
      set c := rest[(⟨j, hjr⟩ : Fin rest.length)] with hc
      show SubReg (QuotSMulTop c M) (a :: rest.eraseIdx j)
      -- `[c] <+ rest`, so `c` is a singleton-sublist element.
      have hcmem : [c] <+ rest := List.singleton_sublist.mpr (List.getElem_mem hjr)
      -- Sublist-regularity of `M` over `rest` and over `QuotSMulTop a M` over `rest`.
      have hl_rest : SubReg M rest := hl.mono (List.sublist_cons_self a rest)
      -- Two instances of the induction hypothesis at index `j`.
      have hIHM : SubReg (QuotSMulTop c M) (rest.eraseIdx j) := ih M hl_rest ⟨j, hjr⟩
      have hIHQ : SubReg (QuotSMulTop c (QuotSMulTop a M)) (rest.eraseIdx j) :=
        ih (QuotSMulTop a M) hl.quot_cons ⟨j, hjr⟩
      -- `c` is a nonzerodivisor on `M`.
      have hcreg : IsSMulRegular M c :=
        hl.isSMulRegular (List.mem_cons_of_mem a (List.getElem_mem hjr))
      -- `[a, c]` is regular on `M`; swap to `[c, a]` to extract that `a` is NZD on `M ⧸ (c)`.
      have hac : IsRegular M [a, c] := hl _ (hcmem.cons_cons a)
      have h1 : IsSMulRegular (QuotSMulTop c M) a := by
        have hca := reg_swap2_M M a c hac hcreg
        rw [isRegular_cons_iff] at hca
        obtain ⟨_, haq⟩ := hca
        rw [isRegular_cons_iff] at haq
        exact haq.left
      -- Now dispatch a general sublist `s <+ a :: rest.eraseIdx j`.
      intro s hs
      rcases List.sublist_cons_iff.mp hs with hA | ⟨s', rfl, hs'⟩
      · exact hIHM s hA
      · rw [isRegular_cons_iff]
        exact ⟨h1, (LinearEquiv.isRegular_congr (towerSwap M a c) s').mp (hIHQ s' hs')⟩

/-- **Permutation invariance of regularity given sublist-regularity (Stacks 07DW `(2) → (1)`),
module form.** From `SubReg M l` (every ordered sublist of `l` is `M`-regular), every permutation
`l'` of `l` is `M`-regular. Proved by strong induction on `l.length`: peel the head `c` of `l'`,
locate it at index `i` of `l` (so `c` is `M`-regular as the singleton `[c]` is a sublist of `l`),
descend to `M ⧸ (c)M` via `subReg_quot` (where the shorter list `l.eraseIdx i` is permutation-
equivalent to the tail of `l'`), apply the induction hypothesis, and reassemble with
`isRegular_cons_iff`. -/
private lemma subReg_perm_M (M : Type*) [AddCommGroup M] [Module R M] (l : List R)
    (hl : SubReg M l) (l' : List R) (hperm : l'.Perm l) : IsRegular M l' := by
  induction hn : l.length using Nat.strong_induction_on generalizing M l' l with
  | _ n ih =>
    match l', hperm with
    | [], hperm => exact hl [] (List.nil_sublist l)
    | (c :: t), hperm =>
      have hcl : c ∈ l := hperm.subset (List.mem_cons_self ..)
      obtain ⟨i, hi, hget⟩ := List.mem_iff_getElem.mp hcl
      have hperm_t : t ~ l.eraseIdx i := by
        have h0 : (c :: t)[0]? = l[i]? := by
          simp [hget, List.getElem?_eq_getElem hi]
        simpa using List.Perm.eraseIdx_of_getElem?_eq h0 hperm
      have hcreg : IsSMulRegular M c := hl.isSMulRegular hcl
      have hsub : SubReg (QuotSMulTop l[i] M) (l.eraseIdx i) := subReg_quot M l hl ⟨i, hi⟩
      have hlen : (l.eraseIdx i).length = n - 1 := by
        rw [List.length_eraseIdx_of_lt hi]
        omega
      have hlt : n - 1 < n := by
        have : 0 < n := by rw [← hn]; exact List.length_pos_of_mem hcl
        omega
      have htreg : IsRegular (QuotSMulTop l[i] M) t :=
        ih (n-1) hlt (QuotSMulTop l[i] M) (l.eraseIdx i) hsub t hperm_t hlen
      rw [isRegular_cons_iff]
      refine ⟨hcreg, ?_⟩
      rw [← hget]
      exact htreg

/-- **SG-B (`3 → 1`).** From "`polySeq fs` is a regular sequence in `S := MvPolynomial (Fin r) R`"
we derive that every permutation `l'` of `fs` is a regular sequence in `R`.

Following the Stacks 07DW proof, this factors as `(3) → (2) → (1)`: `three_to_two` produces
subsequence regularity from polynomial regularity (the monomial-grading direct-sum argument), and
`subReg_perm_M` upgrades subsequence regularity to permutation regularity by induction on the
length, using the elementary `r = 2` swap `reg_swap2_M`. (This replaces the earlier — flawed —
direct `3 → 1` route through arbitrary-subset polynomial regularity, whose key step `swap2` is
false over a general ring: the two pairwise-regularity facts do not survive insertion when the
scalars share a divisibility relation, e.g. `R = ℚ[u,v]`, `[uv, v]`. The Stacks induction is
Noetherian-free.) -/
private lemma sg_three_to_one (fs : List R) (hfs : Ideal.span {x | x ∈ fs} ≠ ⊤)
    (h3 : IsRegular (MvPolynomial (Fin fs.length) R) (polySeq fs)) :
    ∀ l' : List R, l'.Perm fs → IsRegular R l' :=
  subReg_perm_M R fs (three_to_two fs hfs h3)

/-- **Stacks Tag 07DW (Lemma 10.68.10).** For `fs = [f_1, …, f_r] : List R` whose entries
do not generate the unit ideal (`Ideal.span {x | x ∈ fs} ≠ ⊤`, i.e. `(f_1, …, f_r) ≠ R`),
the three conditions are equivalent. The proof is the 3-cycle `1 → 2 → 3 → 1`:
`1 → 2` extends a sublist to a permutation; `2 → 3` is `sg_two_to_three` (Stacks 07DV);
`3 → 1` is `sg_three_to_one` (variable-permutation automorphism + descent). -/
@[stacks 07DW]
theorem tfae_isRegular_perm_sublist_polySeq (fs : List R) (hfs : Ideal.span {x | x ∈ fs} ≠ ⊤) :
    List.TFAE
      [ ∀ l' : List R, l'.Perm fs → IsRegular R l',
        ∀ l' : List R, l' <+ fs → IsRegular R l',
        IsRegular (MvPolynomial (Fin fs.length) R) (polySeq fs) ] := by
  tfae_have 1 → 2 := by
    intro h l' hsub
    -- extend `l'` to a permutation of `fs`
    obtain ⟨rest, hperm⟩ := hsub.exists_perm_append
    -- `(l' ++ rest)` is a permutation of `fs`, hence regular by (1)
    have hreg : IsRegular R (l' ++ rest) := h _ hperm.symm
    rw [isRegular_iff'] at hreg ⊢
    obtain ⟨hwr, _⟩ := hreg
    rw [isWeaklyRegular_append_iff] at hwr
    exact ⟨hwr.left, ofList_ne_top_of_sublist hfs hsub⟩
  tfae_have 2 → 3 := sg_two_to_three fs hfs
  tfae_have 3 → 1 := sg_three_to_one fs hfs
  tfae_finish

end
