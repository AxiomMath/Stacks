/-!
# The canonical map to the associated graded module of a sequence

Throughout, `R` is a commutative ring, `f : Fin c → R` a finite sequence of elements,
`J = (f_0, ..., f_{c-1})` the ideal they generate, and `M` an `R`-module, with the convention
`J^0 M = M`. For a multi-index `e : Fin c →₀ ℕ` write `|e| = e_0 + ... + e_{c-1}` (`qrMdeg e`),
`f^e = f_0^{e_0} ... f_{c-1}^{e_{c-1}}` (`fpow f e`), and `X^e` for the corresponding monomial.

The *source* is `S = (R/J)[X_0, ..., X_{c-1}] ⊗_{R/J} (M/JM)`, a graded `(R/J)[X]`-module whose
degree-`n` part is the free `(M/JM)`-module on monomials of degree `n`. The *target* is
`T = ⨁_{n ≥ 0} J^n M / J^{n+1} M`, the associated graded module of `M` for the `J`-adic
filtration, an `(R/J)[X]`-module in which `X_i` acts by multiplication by the class of `f_i` in
`J/J^2`.

## Main definitions

* `Source`, `Target`: the modules `S` and `T`.
* `Target_MvPoly_Module`: the `(R/J)[X]`-module structure on `T`.
* `quasiRegularCanonicalMap`: the `(R/J)`-linear map `S → T` sending `X^e ⊗ m̄` to the class of
  `f^e m` in `J^{|e|} M / J^{|e|+1} M`.

## Main results

* `canonicalMap_srcMono`: the value of the canonical map on a monomial generator.
* `canonicalMap_graded`: the canonical map is graded.
* `canonicalMap_MvPolynomial_linear`: the canonical map is `(R/J)[X]`-linear.
* `quasiRegularCanonicalMap_surjective`: the canonical map is surjective.
-/

open scoped Finset

@[expose] public section

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- The ideal `J = (f_0, ..., f_{c-1})` generated by the sequence `f`. -/
@[ega "III 1.1.3"]
noncomputable def Jid {c : ℕ} (f : Fin c → R) : Ideal R := Ideal.span (Set.range f)

/-- The submodule `J^n M` of `M` (with the convention `J^0 M = M`). -/
noncomputable def JpowM (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R)
    (n : ℕ) : Submodule R M := (Jid f ^ n) • (⊤ : Submodule R M)

/-- The submodule `J^{n+1} M` viewed inside `J^n M` (used to form the quotient
`J^n M / J^{n+1} M`). -/
noncomputable def Tsub (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R)
    (n : ℕ) : Submodule R (JpowM M f n) :=
  Submodule.comap (JpowM M f n).subtype (JpowM M f (n + 1))

/-- The degree-`n` component of the target: `T_n = J^n M / J^{n+1} M`. -/
@[ega "0 19.5.6.2" "gr_J^n(B) = J^n/J^(n+1)"]
abbrev Tcomp (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R) (n : ℕ) : Type _ :=
  (JpowM M f n) ⧸ (Tsub M f n)

/-- The **target module** `T = ⨁_{n ≥ 0} J^n M / J^{n+1} M`. -/
abbrev Target (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R) : Type _ :=
  DirectSum ℕ (fun n => Tcomp M f n)

/-- The graded ring scalars in degree `0`: `R̄ = R / J`. -/
@[ega "0 19.5.6.2" "E_0 = C = B/J"]
abbrev qrRbar {c : ℕ} (f : Fin c → R) : Type _ := R ⧸ Jid f

/-- `M̄ = M / JM`, an `R̄`-module. -/
@[ega "III 1.1.4"]
abbrev qrMbar (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R) : Type _ :=
  M ⧸ (Jid f • (⊤ : Submodule R M))

/-- `f^e = ∏_i f_i ^ {e_i} ∈ R`. -/
@[ega "IV 16.11.1" "16.11.1.4, special case"]
noncomputable def fpow {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) : R := ∏ i, (f i) ^ (e i)

/-- `|e| = ∑_i e_i`, the total degree of the multi-index `e`. -/
@[ega "IV 16.11.1" "16.11.1.2, special case"]
def qrMdeg {c : ℕ} (e : Fin c →₀ ℕ) : ℕ := ∑ i, e i

/-- `f^e = ∏_i f_i^{e_i}` lies in the ideal power `J^{|e|}`. -/
theorem fpow_mem {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) : fpow f e ∈ Jid f ^ (qrMdeg e) := by
  unfold fpow qrMdeg
  have hfi : ∀ i, f i ∈ Jid f := fun i => Ideal.subset_span (Set.mem_range_self i)
  have hstep : ∀ i : Fin c, (f i) ^ (e i) ∈ Jid f ^ (e i) :=
    fun i => Ideal.pow_mem_pow (hfi i) (e i)
  have hprod : (∏ i, (f i) ^ (e i)) ∈ (∏ i, Jid f ^ (e i)) :=
    Ideal.prod_mem_prod (fun i _ => hstep i)
  have heq : (∏ i, Jid f ^ (e i)) = Jid f ^ (∑ i, e i) := by rw [← Finset.prod_pow_eq_pow_sum]
  rwa [heq] at hprod

/-- For every multi-index `e` and `m ∈ M`, the element `f^e · m` lies in `J^{|e|} M`. -/
theorem fpow_smul_mem {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) :
    (fpow f e) • m ∈ JpowM M f (qrMdeg e) := by
  unfold JpowM; exact Submodule.smul_mem_smul (fpow_mem f e) Submodule.mem_top

/-- Multiplying an element of `J^n M` by an element of `J` lands in `J^{n+1} M`. -/
private theorem smul_mem_JpowM_succ {c : ℕ} {f : Fin c → R} {r : R} (hr : r ∈ Jid f) {n : ℕ}
    {x : M} (hx : x ∈ JpowM M f n) : r • x ∈ JpowM M f (n + 1) := by
  unfold JpowM at *
  rw [pow_succ', mul_smul]
  exact Submodule.smul_mem_smul hr hx

/-- `J` annihilates the degree-`n` component `T_n = J^n M / J^{n+1} M`: multiplication by an
element of `J` raises the filtration degree, hence acts as `0` on the quotient. -/
theorem Tcomp_isTorsion {c : ℕ} (f : Fin c → R) (n : ℕ) :
    Module.IsTorsionBySet R (Tcomp M f n) (Jid f : Set R) := by
  rw [Module.isTorsionBySet_quotient_iff]
  intro x r hr
  simp only [Tsub, Submodule.mem_comap, Submodule.coe_subtype]
  exact smul_mem_JpowM_succ hr x.property

/-- The degree-`n` target component `T_n` is an `R̄ = R/J`-module. -/
noncomputable instance Tcomp_RbarModule {c : ℕ} (f : Fin c → R) (n : ℕ) :
    Module (R ⧸ Jid f) (Tcomp M f n) := (Tcomp_isTorsion f n).module

/-- The scalar tower `R → R/J → T_n` on the degree-`n` target component. -/
instance Tcomp_tower {c : ℕ} (f : Fin c → R) (n : ℕ) :
    IsScalarTower R (R ⧸ Jid f) (Tcomp M f n) := (Tcomp_isTorsion f n).isScalarTower

/-- The linear map `M → J^{|e|}M` given by `m ↦ f^e • m`. -/
noncomputable def fpowSmulRestrict {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) :
    M →ₗ[R] JpowM M f (qrMdeg e) :=
  LinearMap.codRestrict (JpowM M f (qrMdeg e)) (fpow f e • LinearMap.id)
    (fun m => fpow_smul_mem f e m)

/-- The linear map `M → T_{|e|}`, `m ↦ class of f^e • m`. -/
noncomputable def imgClassLin {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) :
    M →ₗ[R] Tcomp M f (qrMdeg e) := (Tsub M f (qrMdeg e)).mkQ ∘ₗ fpowSmulRestrict f e

/-- The linear map `M → T`, `m ↦ (f^e · m mod J^{|e|+1}M)`, landing in degree `|e|`. -/
noncomputable def imgTargetLin {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) : M →ₗ[R] Target M f :=
  (DirectSum.lof R ℕ (fun n => Tcomp M f n) (qrMdeg e)) ∘ₗ imgClassLin f e

/-- The map `m ↦ (f^e · m mod J^{|e|+1}M)` vanishes on `JM`, hence factors through `M/JM`:
if `m ∈ JM` then `f^e · m ∈ J^{|e|+1}M`. -/
theorem imgTargetLin_vanish {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) :
    (Jid f • (⊤ : Submodule R M)) ≤ LinearMap.ker (imgTargetLin f e) := by
  rw [Submodule.smul_le]
  intro r hr m _
  rw [LinearMap.mem_ker]
  unfold imgTargetLin imgClassLin fpowSmulRestrict
  simp only [LinearMap.coe_comp, Function.comp_apply]
  have hmem : (LinearMap.codRestrict (JpowM M f (qrMdeg e)) (fpow f e • LinearMap.id)
      (fun m => fpow_smul_mem f e m) (r • m)) ∈ Tsub M f (qrMdeg e) := by
    simp only [Tsub, Submodule.mem_comap, LinearMap.codRestrict_apply, Submodule.coe_subtype,
      LinearMap.smul_apply, LinearMap.id_coe, id_eq]
    show fpow f e • (r • m) ∈ JpowM M f (qrMdeg e + 1)
    rw [smul_comm]
    exact smul_mem_JpowM_succ hr (fpow_smul_mem f e m)
  rw [(Tsub M f (qrMdeg e)).mkQ_apply, (Submodule.Quotient.mk_eq_zero _).mpr hmem, map_zero]

/-- The `R`-linear map `M̄ → T`, `m̄ ↦ (f^e · m mod J^{|e|+1}M)`. -/
noncomputable def phiMonoR {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) : qrMbar M f →ₗ[R] Target M f :=
  Submodule.liftQ (Jid f • (⊤ : Submodule R M)) (imgTargetLin f e) (imgTargetLin_vanish f e)

/-- The map `M̄ → T`, `m̄ ↦ (f^e · m mod J^{|e|+1}M)`, as an `R̄`-linear map. -/
@[ega "0 15.1.5" "partial"]
noncomputable def phiMono {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) :
    qrMbar M f →ₗ[qrRbar f] Target M f :=
  (phiMonoR f e).extendScalarsOfSurjective Ideal.Quotient.mk_surjective

/-- The **source module** `S = (R/J)[X_0, ..., X_{c-1}] ⊗_{R/J} (M/JM)`, with its
`(R/J)[X]`-module structure by base change of `M̄` along `R/J → (R/J)[X]`. -/
abbrev Source (M : Type*) [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R) : Type _ :=
  TensorProduct (qrRbar f) (MvPolynomial (Fin c) (qrRbar f)) (qrMbar M f)

/-- The `R̄`-bilinear map `R̄[X] → (M̄ → T)` determined on the monomial basis by
`X^e ↦ phiMono e`. -/
@[ega "0 15.1.5" "partial"]
noncomputable def canonicalBilin {c : ℕ} (f : Fin c → R) :
    MvPolynomial (Fin c) (qrRbar f) →ₗ[qrRbar f] (qrMbar M f →ₗ[qrRbar f] Target M f) :=
  (MvPolynomial.basisMonomials (Fin c) (qrRbar f)).constr (qrRbar f) (fun e => phiMono f e)

/-- **The canonical map** `φ : S → T`, the `(R/J)`-linear map induced by `canonicalBilin`. On a
monomial generator it sends `X^e ⊗ m̄ ↦ (f^e · m mod J^{|e|+1}M)`. -/
@[stacks 061N,
  ega "0 15.1.1",
  ega "0 15.1.4",
  ega "0 15.1.5" "special case",
  ega "0 15.2.1" "special case",
  ega "0 17.1.1" "more general",
  ega "IV 19.5.1",
  ega "IV 19.5.4" "more general",
  ega "IV 19.6.2" "special case",
  ega "IV 19.7.1" "special case"]
noncomputable def quasiRegularCanonicalMap {c : ℕ} (f : Fin c → R) :
    Source M f →ₗ[qrRbar f] Target M f :=
  TensorProduct.lift (canonicalBilin f)

/-! ### The target as a graded `(R/J)[X]`-module -/

/-- `f_i · x ∈ J^{n+1}M` when `x ∈ J^n M`. -/
theorem smul_mem_succ {c : ℕ} (f : Fin c → R) (i : Fin c) (n : ℕ) (x : M)
    (hx : x ∈ JpowM M f n) : (f i) • x ∈ JpowM M f (n + 1) := by
  exact smul_mem_JpowM_succ (Ideal.subset_span (Set.mem_range_self i)) hx

/-- Degree-`n` piece of the `X_i`-action on the target: the class of `x ∈ J^n M` maps to the class
of `f_i · x ∈ J^{n+1} M`, raising the degree by `1`. -/
noncomputable def tgtMulComp {c : ℕ} (f : Fin c → R) (i : Fin c) (n : ℕ) :
    Tcomp M f n →ₗ[R] Tcomp M f (n + 1) := by
  refine Submodule.mapQ (Tsub M f n) (Tsub M f (n + 1))
    (LinearMap.codRestrict (JpowM M f (n + 1)) ((f i) • (JpowM M f n).subtype)
      (fun x => smul_mem_succ f i n (x : M) x.property)) ?_
  intro x hx
  simp only [Tsub, Submodule.mem_comap, Submodule.coe_subtype] at hx ⊢
  change (f i) • (x : M) ∈ JpowM M f (n + 1 + 1)
  exact smul_mem_succ f i (n + 1) (x : M) hx

/-- The degree-`n` `X_i`-action promoted to be `R̄`-linear. -/
noncomputable def tgtMulCompBar {c : ℕ} (f : Fin c → R) (i : Fin c) (n : ℕ) :
    Tcomp M f n →ₗ[qrRbar f] Tcomp M f (n + 1) :=
  (tgtMulComp f i n).extendScalarsOfSurjective (Ideal.Quotient.mk_surjective)

/-- `tgtMulCompBar` agrees with `tgtMulComp` pointwise. -/
theorem tgtMulCompBar_coe {c : ℕ} (f : Fin c → R) (i : Fin c) (n : ℕ) (x : Tcomp M f n) :
    tgtMulCompBar f i n x = tgtMulComp f i n x := rfl

/-- The value of `tgtMulComp f i n` on the class of `x ∈ J^n M`. -/
theorem tgtMulComp_mk {c : ℕ} (f : Fin c → R) (i : Fin c) (n : ℕ) (x : JpowM M f n) :
    tgtMulComp f i n (Submodule.Quotient.mk x)
      = Submodule.Quotient.mk
          (⟨(f i) • (x : M), smul_mem_succ f i n (x : M) x.property⟩ :
            JpowM M f (n + 1)) := rfl

/-- The variable actions commute on each component (since `R` is commutative). -/
theorem tgtMulComp_comm {c : ℕ} (f : Fin c → R) (i j : Fin c) (n : ℕ) (x : Tcomp M f n) :
    tgtMulComp f i (n + 1) (tgtMulComp f j n x) = tgtMulComp f j (n + 1) (tgtMulComp f i n x) := by
  induction x using Submodule.Quotient.induction_on with
  | H x =>
    rw [tgtMulComp_mk, tgtMulComp_mk, tgtMulComp_mk, tgtMulComp_mk, Submodule.Quotient.eq,
      Tsub, Submodule.mem_comap]
    simp only [Submodule.coe_subtype, AddSubgroupClass.coe_sub]
    show (f i) • (f j) • (x : M) - (f j) • (f i) • (x : M) ∈ JpowM M f (n + 1 + 1 + 1)
    rw [smul_smul, smul_smul, mul_comm, sub_self]
    exact Submodule.zero_mem _

/-- The action of the variable `X_i` on the target `T`, i.e. multiplication by the class
`f̄_i ∈ J / J^2 ⊆ ⨁_n J^n/J^{n+1}`, which raises the grading by `1`.  Realised as an `R̄`-linear
endomorphism of `T`. -/
noncomputable def tgtMul {c : ℕ} (f : Fin c → R) (i : Fin c) :
    Module.End (qrRbar f) (Target M f) :=
  DirectSum.toModule (qrRbar f) ℕ (Target M f)
    (fun n =>
      (DirectSum.lof (qrRbar f) ℕ (fun k => Tcomp M f k) (n + 1)).comp (tgtMulCompBar f i n))

/-- `tgtMul f i` carries the degree-`n` summand of `T` into the degree-`n+1` summand, acting
there by `tgtMulCompBar f i n`. -/
theorem tgtMul_lof {c : ℕ} (f : Fin c → R) (i : Fin c) (n : ℕ) (x : Tcomp M f n) :
    tgtMul f i (DirectSum.lof (qrRbar f) ℕ (fun k => Tcomp M f k) n x)
      = DirectSum.lof (qrRbar f) ℕ (fun k => Tcomp M f k) (n + 1) (tgtMulCompBar f i n x) := by
  unfold tgtMul; rw [DirectSum.toModule_lof]; rfl

/-- The variable actions on the target commute. -/
theorem tgtMul_comm {c : ℕ} (f : Fin c → R) (i j : Fin c) :
    (tgtMul f i : Module.End (qrRbar f) (Target M f)) * tgtMul f j = tgtMul f j * tgtMul f i := by
  apply DirectSum.linearMap_ext; intro n; apply LinearMap.ext; intro x
  simp only [LinearMap.coe_comp, Function.comp_apply, Module.End.mul_apply, tgtMul_lof,
    tgtMulCompBar_coe, tgtMulComp_comm]

/-- Any two of the variable actions on the target commute. -/
theorem tgtMul_pairwise_comm {c : ℕ} (f : Fin c → R) :
    ∀ a ∈ Set.range (tgtMul (M := M) f), ∀ b ∈ Set.range (tgtMul (M := M) f), a * b = b * a := by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩; exact tgtMul_comm f i j

/-- The `R̄`-subalgebra of `End_{R̄} T` generated by the variable actions is commutative. -/
noncomputable instance tgtAlgComm {c : ℕ} (f : Fin c → R) :
    CommRing (Algebra.adjoin (qrRbar f) (Set.range (tgtMul (M := M) f))) :=
  letI := Algebra.isMulCommutative_adjoin (qrRbar f) (tgtMul_pairwise_comm (M := M) f)
  { mul_comm := fun a b => IsMulCommutative.is_comm.comm a b }

/-- The variable action `tgtMul f i` as an element of the commutative subalgebra. -/
noncomputable def tgtGen {c : ℕ} (f : Fin c → R) (i : Fin c) :
    Algebra.adjoin (qrRbar f) (Set.range (tgtMul (M := M) f)) :=
  ⟨tgtMul f i, Algebra.subset_adjoin (Set.mem_range_self i)⟩

/-- The `R̄`-algebra homomorphism `(R/J)[X] → adjoin{tgtMul}` evaluating `X_i` at `tgtMul f i`. -/
noncomputable def tgtAeval {c : ℕ} (f : Fin c → R) :
    MvPolynomial (Fin c) (qrRbar f) →ₐ[qrRbar f]
      Algebra.adjoin (qrRbar f) (Set.range (tgtMul (M := M) f)) :=
  MvPolynomial.aeval (tgtGen (M := M) f)

/-- The ring homomorphism `(R/J)[X] → End_{R̄} T` giving the polynomial action on the target,
sending `X_i` to multiplication by `f̄_i`. -/
noncomputable def tgtActionRingHom {c : ℕ} (f : Fin c → R) :
    MvPolynomial (Fin c) (qrRbar f) →+* Module.End (qrRbar f) (Target M f) :=
  ((Algebra.adjoin (qrRbar f) (Set.range (tgtMul (M := M) f))).val.toRingHom).comp
    (tgtAeval (M := M) f).toRingHom

/-- **The `(R/J)[X]`-module structure on the target** `T = ⨁_n J^n M / J^{n+1} M`, in which the
variable `X_i` acts by multiplication by the class `f̄_i ∈ J/J^2`. -/
noncomputable instance Target_MvPoly_Module {c : ℕ} (f : Fin c → R) :
    Module (MvPolynomial (Fin c) (qrRbar f)) (Target M f) :=
  Module.compHom (Target M f) (tgtActionRingHom (M := M) f)

/-- The source monomial element `X^e ⊗ m̄ ∈ S`. -/
noncomputable def srcMono {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) : Source M f :=
  (MvPolynomial.monomial e (1 : qrRbar f)) ⊗ₜ[qrRbar f] (Submodule.Quotient.mk m : qrMbar M f)

/-- Degree-`n` part of the source: the `R̄`-submodule spanned by the monomials `X^e ⊗ m̄` with
`|e| = n`. -/
noncomputable def srcDeg {c : ℕ} (f : Fin c → R) (n : ℕ) : Submodule (qrRbar f) (Source M f) :=
  Submodule.span (qrRbar f) {s | ∃ (e : Fin c →₀ ℕ) (m : M), qrMdeg e = n ∧ s = srcMono f e m}

/-- Degree-`n` part of the target: the image of `T_n = J^n M / J^{n+1} M` in the direct sum `T`. -/
@[sga "7 X 2.14" "special case"]
noncomputable def tgtDeg {c : ℕ} (f : Fin c → R) (n : ℕ) : Submodule R (Target M f) :=
  LinearMap.range (DirectSum.lof R ℕ (fun k => Tcomp M f k) n)

/-- The canonical map sends the monomial generator `X^e ⊗ m̄` to the class of `f^e · m` in
`J^{|e|} M / J^{|e|+1} M`, i.e. `imgTargetLin f e m`. -/
@[ega "0 15.1.1" "partial", ega "0 15.1.5" "partial"]
theorem canonicalMap_srcMono {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) :
    quasiRegularCanonicalMap f (srcMono f e m) = imgTargetLin f e m := by
  simp only [quasiRegularCanonicalMap, srcMono, TensorProduct.lift.tmul, canonicalBilin]
  rw [show (MvPolynomial.monomial e) (1 : qrRbar f)
      = (MvPolynomial.basisMonomials (Fin c) (qrRbar f)) e from rfl,
    Module.Basis.constr_basis]
  rfl

/-- The `R`-linear and `R̄`-linear inclusions of `T_k` into `T` agree. -/
private theorem lof_R_eq_lof_qrRbar {c : ℕ} (f : Fin c → R) (k : ℕ) (x : Tcomp M f k) :
    DirectSum.lof R ℕ (fun k => Tcomp M f k) k x
      = DirectSum.lof (qrRbar f) ℕ (fun k => Tcomp M f k) k x := rfl

/-- The canonical map is graded: it sends the degree-`n` part `S_n` of the source into the
degree-`n` part `T_n = J^n M / J^{n+1} M` of the target. -/
@[ega "0 15.1.1" "partial",
  ega "0 15.1.5" "ψ is graded of degree 0",
  ega "0 17.1.1" "partial",
  ega "IV 19.6.2" "special case"]
theorem canonicalMap_graded {c : ℕ} (f : Fin c → R) (n : ℕ) (s : Source M f)
    (hs : s ∈ srcDeg f n) : quasiRegularCanonicalMap f s ∈ tgtDeg f n := by
  rw [srcDeg] at hs
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hs
  · rintro x ⟨e, m, he, rfl⟩
    rw [canonicalMap_srcMono]
    unfold imgTargetLin imgClassLin
    simp only [LinearMap.coe_comp, Function.comp_apply]
    rw [tgtDeg, ← he]
    exact LinearMap.mem_range_self _ _
  · rw [map_zero]; exact Submodule.zero_mem _
  · intro x y _ _ hx hy
    rw [map_add]; exact Submodule.add_mem _ hx hy
  · intro r x _ hx
    rw [map_smul]
    obtain ⟨y, hy⟩ := hx
    rw [tgtDeg]
    refine ⟨r • y, ?_⟩
    rw [← hy, lof_R_eq_lof_qrRbar, lof_R_eq_lof_qrRbar, map_smul]

/-- The variable `X_i` of `(R/J)[X]` acts on the target `T` as the degree-raising operator
`tgtMul f i`, multiplication by the class `f̄_i ∈ J/J^2`. -/
theorem tgtMul_eq_X_smul {c : ℕ} (f : Fin c → R) (i : Fin c) (t : Target M f) :
    (MvPolynomial.X i : MvPolynomial (Fin c) (qrRbar f)) • t = tgtMul f i t := by
  show tgtActionRingHom f (MvPolynomial.X i) t = tgtMul f i t
  simp only [tgtActionRingHom, tgtAeval, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, MvPolynomial.aeval_X, tgtGen, Subalgebra.coe_val]

/-- `f ^ (e + δ_i) = f i * f ^ e`, where `δ_i = Finsupp.single i 1`. -/
private theorem fpow_add_single_aux {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) (i : Fin c) :
    fpow f (e + Finsupp.single i 1) = f i * fpow f e := by
  unfold fpow
  have key : ∀ j : Fin c, f j ^ ((e + Finsupp.single i 1 : Fin c →₀ ℕ) j) =
      (if j = i then f i else 1) * f j ^ (e j) := by
    intro j
    rw [Finsupp.add_apply, Finsupp.single_apply]
    by_cases h : i = j
    · subst h; rw [ite_eq_left rfl, ite_eq_left rfl, pow_succ]; ring
    · rw [ite_eq_right h, ite_eq_right (fun hh => h hh.symm), add_zero, one_mul]
  rw [Finset.prod_congr rfl (fun j _ => key j), Finset.prod_mul_distrib]
  congr 1
  rw [Finset.prod_ite_eq' Finset.univ i (fun _ => f i)]
  simp

/-- `|e + δ_i| = |e| + 1`, where `δ_i = Finsupp.single i 1`. -/
private theorem qrMdeg_add_single_aux {c : ℕ} (e : Fin c →₀ ℕ) (i : Fin c) :
    qrMdeg (e + Finsupp.single i 1) = qrMdeg e + 1 := by
  unfold qrMdeg
  simp [Finsupp.add_apply, Finset.sum_add_distrib]

/-- For every variable `X_i` and every element `s` of the source `S`,
`φ(X_i · s) = f̄_i · φ(s)`, where `X_i` acts on `T` by `tgtMul f i`. -/
theorem canonicalMap_X_smul {c : ℕ} (f : Fin c → R) (i : Fin c) (s : Source M f) :
    quasiRegularCanonicalMap f ((MvPolynomial.X i : MvPolynomial (Fin c) (qrRbar f)) • s)
      = tgtMul f i (quasiRegularCanonicalMap f s) := by
  have key : ∀ (e : Fin c →₀ ℕ) (m : M),
      quasiRegularCanonicalMap f ((MvPolynomial.X i : MvPolynomial (Fin c) (qrRbar f)) • srcMono f
          e m)
        = tgtMul f i (quasiRegularCanonicalMap f (srcMono f e m)) := by
    intro e m
    have hsmul : (MvPolynomial.X i : MvPolynomial (Fin c) (qrRbar f)) • srcMono f e m
        = srcMono f (e + Finsupp.single i 1) m := by
      unfold srcMono
      rw [TensorProduct.smul_tmul']
      congr 1
      rw [smul_eq_mul, MvPolynomial.X, MvPolynomial.monomial_mul_monomial, one_mul, add_comm]
    rw [hsmul, canonicalMap_srcMono, canonicalMap_srcMono]
    unfold imgTargetLin imgClassLin
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply,
      lof_R_eq_lof_qrRbar]
    rw [tgtMul_lof, tgtMulCompBar_coe, tgtMulComp_mk]
    have transport : ∀ (n₁ n₂ : ℕ) (h : n₁ = n₂)
        (a : JpowM M f n₁) (b : JpowM M f n₂), (a : M) = (b : M) →
        DirectSum.lof (qrRbar f) ℕ (fun k => Tcomp M f k) n₁ (Submodule.Quotient.mk a)
          = DirectSum.lof (qrRbar f) ℕ (fun k => Tcomp M f k) n₂ (Submodule.Quotient.mk b) := by
      intro n₁ n₂ h a b hab
      subst h
      congr 1
      exact congrArg Submodule.Quotient.mk (Subtype.ext hab)
    apply transport _ _ (qrMdeg_add_single_aux e i)
    show fpow f (e + Finsupp.single i 1) • m = (f i) • (fpow f e • m)
    rw [fpow_add_single_aux, mul_smul]
  rw [TensorProduct.AlgebraTensorModule.smul_eq_lsmul_rTensor]
  induction s using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
  | tmul p mbar =>
    induction mbar using Submodule.Quotient.induction_on with
    | H m =>
      rw [LinearMap.rTensor_tmul]
      induction p using MvPolynomial.induction_on' with
      | monomial e a =>
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
        have hcoe : (MvPolynomial.monomial e (Ideal.Quotient.mk (Jid f) r))
              ⊗ₜ[qrRbar f] (Submodule.Quotient.mk m : qrMbar M f)
            = srcMono f e (r • m) := by
          unfold srcMono
          rw [show (MvPolynomial.monomial e) (Ideal.Quotient.mk (Jid f) r)
              = (Ideal.Quotient.mk (Jid f) r) • (MvPolynomial.monomial e (1 : qrRbar f)) by
                rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]]
          rw [TensorProduct.smul_tmul]
          rfl
        rw [Algebra.lsmul_coe, ← TensorProduct.smul_tmul', hcoe, key e (r • m)]
      | add p q hp hq =>
        simp only [map_add, TensorProduct.add_tmul, hp, hq]

/-- The canonical map `φ : S → T` is `(R/J)[X]`-linear: `φ(p · s) = p · φ(s)` for every polynomial
`p ∈ (R/J)[X]` and every `s ∈ S`. -/
theorem canonicalMap_MvPolynomial_linear {c : ℕ} (f : Fin c → R)
    (p : MvPolynomial (Fin c) (qrRbar f)) (s : Source M f) :
    quasiRegularCanonicalMap f (p • s) = p • quasiRegularCanonicalMap f s := by
  have aux : ∀ (q : MvPolynomial (Fin c) (qrRbar f)) (s : Source M f),
      quasiRegularCanonicalMap f
          (LinearMap.rTensor (qrMbar M f)
            (Algebra.lsmul (qrRbar f) (qrRbar f) (MvPolynomial (Fin c) (qrRbar f)) q) s)
        = tgtActionRingHom f q (quasiRegularCanonicalMap f s) := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a =>
      intro s
      have hC : (algebraMap (qrRbar f) (MvPolynomial (Fin c) (qrRbar f)) a)
          = (MvPolynomial.C a : MvPolynomial (Fin c) (qrRbar f)) :=
        DFunLike.congr_fun (MvPolynomial.algebraMap_eq (qrRbar f) (Fin c)) a
      have htgt : tgtActionRingHom f (MvPolynomial.C a) (quasiRegularCanonicalMap f s)
          = a • quasiRegularCanonicalMap f s := by
        rw [← hC,
          show tgtActionRingHom f (algebraMap (qrRbar f) (MvPolynomial (Fin c) (qrRbar f)) a)
            = algebraMap (qrRbar f) (Module.End (qrRbar f) (Target M f)) a from ?_]
        · simp only [Module.algebraMap_end_apply]
        · unfold tgtActionRingHom tgtAeval
          rw [RingHom.comp_apply]
          simp only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, AlgHom.commutes]
      rw [htgt, ← TensorProduct.AlgebraTensorModule.smul_eq_lsmul_rTensor (MvPolynomial.C a), ← hC,
        IsScalarTower.algebraMap_smul, map_smul]
    | add p q hp hq =>
      intro s
      rw [map_add, LinearMap.rTensor_add, LinearMap.add_apply, map_add, map_add,
        LinearMap.add_apply, hp, hq]
    | mul_X p i hp =>
      intro s
      rw [map_mul, LinearMap.rTensor_mul, Module.End.mul_apply, hp, map_mul,
        Module.End.mul_apply]
      congr 1
      rw [← TensorProduct.AlgebraTensorModule.smul_eq_lsmul_rTensor (MvPolynomial.X i),
        canonicalMap_X_smul]
      exact (tgtMul_eq_X_smul f i (quasiRegularCanonicalMap f s)).symm
  rw [TensorProduct.AlgebraTensorModule.smul_eq_lsmul_rTensor p s, aux]
  rfl

/-- `f ^ (e + δ_i) = f i * f ^ e`, where `δ_i = Finsupp.single i 1`. -/
theorem fpow_add_single {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) (i : Fin c) :
    fpow f (e + Finsupp.single i 1) = f i * fpow f e := fpow_add_single_aux f e i

/-- `|e + δ_i| = |e| + 1`, where `δ_i = Finsupp.single i 1`. -/
theorem qrMdeg_addSingle {c : ℕ} (e : Fin c →₀ ℕ) (i : Fin c) :
    qrMdeg (e + Finsupp.single i 1) = qrMdeg e + 1 := qrMdeg_add_single_aux e i

/-- The ideal power `J^n` is the span of the monomials `f^e` with `|e| = n`. -/
theorem Jid_pow_eq_span {c : ℕ} (f : Fin c → R) (n : ℕ) :
    Jid f ^ n = Ideal.span {r : R | ∃ e : Fin c →₀ ℕ, qrMdeg e = n ∧ r = fpow f e} := by
  induction n with
  | zero =>
    rw [pow_zero]
    have hset : {r : R | ∃ e : Fin c →₀ ℕ, qrMdeg e = 0 ∧ r = fpow f e} = {(1:R)} := by
      ext r
      simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff]
      constructor
      · rintro ⟨e, he, rfl⟩
        have : e = 0 := by
          ext i
          unfold qrMdeg at he
          have := Finset.sum_eq_zero_iff_of_nonneg (fun j _ => Nat.zero_le (e j))
            |>.mp he i (Finset.mem_univ i)
          simpa using this
        rw [this]; unfold fpow; simp
      · rintro rfl
        exact ⟨0, by unfold qrMdeg; simp, by unfold fpow; simp⟩
    rw [hset, Ideal.span_singleton_one, Ideal.one_eq_top]
  | succ n ih =>
    rw [pow_succ', ih, Jid, Ideal.span_mul_span]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro r ⟨a, ha, b, hb, rfl⟩
      obtain ⟨i, rfl⟩ := ha
      obtain ⟨e, he, rfl⟩ := hb
      apply Ideal.subset_span
      refine ⟨e + Finsupp.single i 1, ?_, ?_⟩
      · rw [qrMdeg_addSingle, he]
      · rw [fpow_add_single]
    · rw [Ideal.span_le]
      rintro r ⟨e, he, rfl⟩
      have : ∃ i, e i ≠ 0 := by
        by_contra h
        push Not at h
        have : qrMdeg e = 0 := by unfold qrMdeg; apply Finset.sum_eq_zero; intro j _; exact h j
        omega
      obtain ⟨i, hi⟩ := this
      have he' : e = (e - Finsupp.single i 1) + Finsupp.single i 1 := by
        ext j
        rw [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
        by_cases h : i = j
        · subst h; rw [ite_eq_left rfl]; omega
        · rw [ite_eq_right h]; simp
      apply Ideal.subset_span
      refine ⟨f i, ⟨i, rfl⟩, fpow f (e - Finsupp.single i 1), ⟨e - Finsupp.single i 1, ?_, rfl⟩, ?_⟩
      · have := qrMdeg_addSingle (e - Finsupp.single i 1) i
        rw [← he'] at this
        omega
      · show f i * fpow f (e - Finsupp.single i 1) = fpow f e
        rw [← fpow_add_single, ← he']

/-- For each `n`, the submodule `J^n M` is spanned, as an `R`-module, by the elements `f^e · m`
with `|e| = n`. -/
theorem JpowM_eq_span {c : ℕ} (f : Fin c → R) (n : ℕ) :
    JpowM M f n =
      Submodule.span R {x : M | ∃ (e : Fin c →₀ ℕ) (m : M), qrMdeg e = n ∧ x = fpow f e • m} := by
  apply le_antisymm
  · unfold JpowM
    rw [Jid_pow_eq_span f n, ← Submodule.span_univ (R := R) (M := M), Submodule.span_smul_span]
    apply Submodule.span_mono
    rintro x ⟨a, ⟨e, he, rfl⟩, m, -, rfl⟩
    exact ⟨e, m, he, rfl⟩
  · rw [Submodule.span_le]
    rintro x ⟨e, m, rfl, rfl⟩
    exact fpow_smul_mem f e m

/-- The canonical map `φ : S → T` is surjective. -/
@[ega "0 15.1.1", ega "0 17.1.1" "more general", ega "IV 19.6.2" "special case"]
theorem quasiRegularCanonicalMap_surjective {c : ℕ} (f : Fin c → R) :
    Function.Surjective (quasiRegularCanonicalMap f : Source M f →ₗ[qrRbar f] Target M f) := by
  rw [← LinearMap.range_eq_top, Submodule.eq_top_iff']
  have hgen : ∀ (n : ℕ) (x : M) (hx : x ∈ JpowM M f n),
      DirectSum.lof R ℕ (fun k => Tcomp M f k) n (Submodule.Quotient.mk ⟨x, hx⟩)
        ∈ LinearMap.range (quasiRegularCanonicalMap f) := by
    intro n x hx
    have hxs : x ∈ Submodule.span R
        {x : M | ∃ (e : Fin c →₀ ℕ) (m : M), qrMdeg e = n ∧ x = fpow f e • m} := by
      rwa [← JpowM_eq_span]
    suffices h : ∀ (h : x ∈ JpowM M f n),
        DirectSum.lof R ℕ (fun k => Tcomp M f k) n (Submodule.Quotient.mk ⟨x, h⟩)
          ∈ LinearMap.range (quasiRegularCanonicalMap f) from h hx
    clear hx
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hxs
    · rintro x ⟨e, m, he, rfl⟩ h
      refine ⟨srcMono f e m, ?_⟩
      rw [canonicalMap_srcMono]
      unfold imgTargetLin imgClassLin fpowSmulRestrict
      simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply]
      subst he
      rfl
    · intro h
      have : (⟨(0 : M), h⟩ : JpowM M f n) = 0 := rfl
      rw [this]
      simp only [Submodule.Quotient.mk_zero, map_zero]
      exact Submodule.zero_mem _
    · intro a b ha hb iha ihb h
      have ham : a ∈ JpowM M f n := by rwa [JpowM_eq_span]
      have hbm : b ∈ JpowM M f n := by rwa [JpowM_eq_span]
      have hsplit : (⟨a + b, h⟩ : JpowM M f n) = ⟨a, ham⟩ + ⟨b, hbm⟩ := rfl
      rw [hsplit, Submodule.Quotient.mk_add, map_add]
      exact Submodule.add_mem _ (iha ham) (ihb hbm)
    · intro r a ha iha h
      have ham : a ∈ JpowM M f n := by rwa [JpowM_eq_span]
      have hsmul : (⟨r • a, h⟩ : JpowM M f n) = r • ⟨a, ham⟩ := rfl
      rw [hsmul, Submodule.Quotient.mk_smul,
        (DirectSum.lof R ℕ (fun k => Tcomp M f k) n).map_smul r]
      exact Submodule.smul_of_tower_mem _ r (iha ham)
  intro y
  induction y using DirectSum.induction_on with
  | zero => exact Submodule.zero_mem _
  | of n yn =>
    induction yn using Submodule.Quotient.induction_on with
    | H xh =>
      obtain ⟨x, hx⟩ := xh
      have := hgen n x hx
      rwa [DirectSum.lof_eq_of] at this
  | add a b ha hb => exact Submodule.add_mem _ ha hb

/-! ### The graded pieces of the target, and the filtration -/

section Graded

variable {c : ℕ}

/-- The source `(R/J)[X] ⊗ M/JM` as finitely many copies of `M/JM`, one per multi-index: the
monomial basis of the polynomial ring identifies `X^e ⊗ m̄` with `Finsupp.single e m̄`. -/
noncomputable def srcFinsuppEquiv (M : Type*) [AddCommGroup M] [Module R M]
    (f : Fin c → R) : Source M f ≃ₗ[qrRbar f] ((Fin c →₀ ℕ) →₀ qrMbar M f) :=
  ((MvPolynomial.basisMonomials (Fin c) (qrRbar f)).repr.rTensor (qrMbar M f)).trans
    (TensorProduct.finsuppScalarLeft _ _ _)

/-- `srcFinsuppEquiv` sends the monomial generator `X^e ⊗ m̄` to `Finsupp.single e m̄`. -/
theorem srcFinsuppEquiv_srcMono (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) :
    srcFinsuppEquiv M f (srcMono f e m) = Finsupp.single e (Submodule.Quotient.mk m) := by
  classical
  refine Finsupp.ext fun i => ?_
  simp only [srcFinsuppEquiv, srcMono, MvPolynomial.basisMonomials, LinearEquiv.trans_apply,
    LinearEquiv.rTensor_tmul, TensorProduct.finsuppScalarLeft_apply_tmul_apply,
    Finsupp.single_apply]
  have hc :
    ((AddMonoidAlgebra.coeffLinearEquiv (qrRbar f)) ((MvPolynomial.monomial e) 1)) i =
      MvPolynomial.coeff i (MvPolynomial.monomial e (1 : qrRbar f)) :=
    rfl
  rw [hc, MvPolynomial.coeff_monomial]
  by_cases h : e = i <;> simp [h]

/-- The degree-`n` part of `M` into the graded target: reduce mod `J^{n+1}M` and place the class
in the degree-`n` summand. -/
noncomputable def degLift (f : Fin c → R) (n : ℕ) : JpowM M f n →ₗ[R] Target M f :=
  (DirectSum.lof R ℕ (fun k => Tcomp M f k) n) ∘ₗ (Tsub M f n).mkQ

/-- The monomial image `f^e · m mod J^{|e|+1}M` is `degLift` of `f^e · m` in degree `|e|`. -/
theorem imgTargetLin_eq_degLift (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) (n : ℕ)
    (h : qrMdeg e = n) (hm : fpow f e • m ∈ JpowM M f n) :
    imgTargetLin f e m = degLift f n ⟨fpow f e • m, hm⟩ := by
  subst h; rfl

/-- The class of `x ∈ J^n M` in `J^n M / J^{n+1} M` vanishes exactly when `x ∈ J^{n+1}M`. -/
theorem mkQ_Tsub_eq_zero_iff (f : Fin c → R) (n : ℕ) (x : JpowM M f n) :
    (Tsub M f n).mkQ x = 0 ↔ (x : M) ∈ JpowM M f (n + 1) := by
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  simp [Tsub]

/-- `degLift` in degree `n` kills exactly the elements of `J^{n+1}M`. -/
theorem degLift_eq_zero_iff (f : Fin c → R) (n : ℕ) (x : JpowM M f n) :
    degLift f n x = 0 ↔ (x : M) ∈ JpowM M f (n + 1) := by
  classical
  rw [← mkQ_Tsub_eq_zero_iff]
  refine ⟨fun h => ?_, fun h => by simp [degLift, h]⟩
  have := congrArg (DirectSum.component R ℕ (fun k => Tcomp M f k) n) h
  rwa [degLift, LinearMap.coe_comp, Function.comp_apply, DirectSum.component.lof_self,
    map_zero] at this

/-- The `n`-th component of the target sees nothing of a monomial image of degree `≠ n`. -/
theorem component_imgTargetLin_of_ne (f : Fin c → R) (e : Fin c →₀ ℕ) (m : M) {n : ℕ}
    (h : qrMdeg e ≠ n) :
    DirectSum.component R ℕ (fun k => Tcomp M f k) n (imgTargetLin f e m) = 0 := by
  classical
  rw [imgTargetLin_eq_degLift f e m (qrMdeg e) rfl (fpow_smul_mem f e m), degLift,
    LinearMap.coe_comp, Function.comp_apply, DirectSum.component.of,
    dite_eq_right_iff.mpr (fun h' => absurd h' h)]

/-- A finite sum of monomial images `f^{d k} · m k`, all of the same total degree `n`, is the class
of `∑_k f^{d k} · m k ∈ J^n M` in the degree-`n` summand of the target. -/
theorem sum_imgTargetLin_eq_degLift {f : Fin c → R} {ι : Type*} (S : Finset ι)
    (d : ι → (Fin c →₀ ℕ)) (m : ι → M) (n : ℕ) (hdeg : ∀ k ∈ S, qrMdeg (d k) = n)
    (hsum : (∑ k ∈ S, fpow f (d k) • m k) ∈ JpowM M f n) :
    ∑ k ∈ S, imgTargetLin f (d k) (m k) = degLift f n ⟨∑ k ∈ S, fpow f (d k) • m k, hsum⟩ := by
  classical
  have hmem : ∀ k : { x // x ∈ S }, fpow f (d k.1) • m k.1 ∈ JpowM M f n := fun k =>
    hdeg k.1 k.2 ▸ fpow_smul_mem f (d k.1) (m k.1)
  rw [← Finset.sum_attach S (fun k => imgTargetLin f (d k) (m k)),
    Finset.sum_congr rfl
      (fun k _ => imgTargetLin_eq_degLift f (d k.1) (m k.1) n (hdeg k.1 k.2) (hmem k)),
    ← map_sum]
  refine congrArg _ (Subtype.ext ?_)
  rw [AddSubmonoidClass.coe_finsetSum]
  simpa using Finset.sum_attach S (fun k => fpow f (d k) • m k)

/-- `sum_imgTargetLin_eq_degLift` for a family indexed by the multi-indices themselves. -/
theorem sum_imgTargetLin_eq_degLift' {f : Fin c → R} (S : Finset (Fin c →₀ ℕ))
    (s : (Fin c →₀ ℕ) → M) (n : ℕ) (hdeg : ∀ e ∈ S, qrMdeg e = n)
    (hsum : (∑ e ∈ S, fpow f e • s e) ∈ JpowM M f n) :
    ∑ e ∈ S, imgTargetLin f e (s e) = degLift f n ⟨∑ e ∈ S, fpow f e • s e, hsum⟩ :=
  sum_imgTargetLin_eq_degLift S id s n hdeg hsum

/-- The filtration is decreasing: `J^{n+1}M ⊆ J^n M`. -/
theorem JpowM_succ_le (f : Fin c → R) (n : ℕ) : JpowM M f (n + 1) ≤ JpowM M f n :=
  Submodule.smul_mono (Ideal.pow_le_pow_right (Nat.le_succ n)) le_rfl

/-- The first step of the filtration is `JM`. -/
theorem JpowM_one (f : Fin c → R) : JpowM M f 1 = Jid f • (⊤ : Submodule R M) := by
  rw [JpowM, pow_one]

/-! ### The filtration and a base change -/

section Filtration

variable {c : ℕ} (f : Fin c → R)

/-- Membership in `Tsub` is membership in the next step of the filtration. -/
theorem mem_Tsub_iff (n : ℕ) (x : JpowM M f n) :
    x ∈ Tsub M f n ↔ (x : M) ∈ JpowM M f (n + 1) :=
  Iff.rfl

end Filtration

section BaseChange

variable (S : Type*) [CommRing S] [Algebra R S] {N : Type*} [AddCommGroup N] [Module R N]
  [Module S N] [IsScalarTower R S N] {c : ℕ} (f : Fin c → R) (bc : M →ₗ[R] N)

/-- `Finsupp.mapRange.linearMap` sends `Finsupp.single e m` to `Finsupp.single e (g m)`. -/
theorem mapRange_linearMap_single {ι : Type*} {A B : Type*} [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] (g : A →ₗ[R] B) (i : ι) (x : A) :
    (Finsupp.mapRange.linearMap g : (ι →₀ A) →ₗ[R] ι →₀ B) (Finsupp.single i x) =
      Finsupp.single i (g x) :=
  Finsupp.mapRange_single (hf := map_zero g)

/-- The structural map carries the monomial `f^e` to the monomial of the image sequence. -/
theorem fpow_algebraMap (e : Fin c →₀ ℕ) :
    algebraMap R S (fpow f e) = fpow (fun i => algebraMap R S (f i)) e := by simp [fpow, map_prod]

/-- A base change sends `f^e m` to `(f')^e (bc m)`. -/
theorem map_fpow_smul (e : Fin c →₀ ℕ) (m : M) :
    bc (fpow f e • m) = fpow (fun i => algebraMap R S (f i)) e • bc m := by
  rw [map_smul, ← algebraMap_smul S (fpow f e) (bc m), fpow_algebraMap]

/-- A base change carries `JⁿM` into `(J')ⁿN`. -/
theorem map_mem_JpowM (n : ℕ) (x : M) (hx : x ∈ JpowM M f n) :
    bc x ∈ JpowM N (fun i => algebraMap R S (f i)) n := by
  rw [JpowM_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨e, m, he, rfl⟩ := hy
    subst he
    rw [map_fpow_smul S]
    exact fpow_smul_mem _ e _
  | zero => simp
  | add a b _ _ ha hb =>
    rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha =>
    rw [map_smul, ← algebraMap_smul S r (bc a)]
    exact Submodule.smul_mem _ _ ha

/-- A base change carries `JM` into `J'N`. -/
theorem map_mem_Jid_smul_top (x : M) (hx : x ∈ Jid f • (⊤ : Submodule R M)) :
    bc x ∈ Jid (fun i => algebraMap R S (f i)) • (⊤ : Submodule S N) := by
  rw [← JpowM_one (M := N) fun i => algebraMap R S (f i)]
  exact map_mem_JpowM S f bc 1 x (by rwa [JpowM_one])

/-- The comparison map on `M/JM`, `m̄ ↦ (bc m)‾`. -/
noncomputable def barMap : qrMbar M f →ₗ[R] qrMbar N (fun i => algebraMap R S (f i)) :=
  Submodule.liftQ _
    ((Submodule.mkQ (Jid (fun i => algebraMap R S (f i)) • (⊤ : Submodule S N))).restrictScalars
        R ∘ₗ
      bc)
    (fun x hx => (Submodule.Quotient.mk_eq_zero _).2 (map_mem_Jid_smul_top S f bc x hx))

/-- `Stacks.QuasiregularSequence.FlatBaseChange.barMap` sends the class of `m` to the class of
`bc m`. -/
theorem barMap_mk (m : M) :
    barMap S f bc (Submodule.Quotient.mk m) = Submodule.Quotient.mk (bc m) :=
  rfl

/-- The comparison map on the sources: under `srcFinsuppEquiv` it is `Finsupp.mapRange` of
`barMap`. -/
noncomputable def srcMap : Source M f →ₗ[R] Source N (fun i => algebraMap R S (f i)) :=
  (((srcFinsuppEquiv N (fun i => algebraMap R S (f i))).restrictScalars R).symm).toLinearMap ∘ₗ
    Finsupp.mapRange.linearMap (barMap S f bc) ∘ₗ
    ((srcFinsuppEquiv M f).restrictScalars R).toLinearMap

/-- `Stacks.QuasiregularSequence.FlatBaseChange.srcMap` on a monomial generator: `X^e ⊗ m̄ ↦ X^e ⊗
(bc m)‾`. -/
theorem srcMap_srcMono (e : Fin c →₀ ℕ) (m : M) :
    srcMap S f bc (srcMono f e m) = srcMono (fun i => algebraMap R S (f i)) e (bc m) := by
  have h2 := srcFinsuppEquiv_srcMono (fun i => algebraMap R S (f i)) e (bc m)
  simp only [srcMap, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.restrictScalars_symm_apply, LinearEquiv.restrictScalars_apply,
    srcFinsuppEquiv_srcMono, mapRange_linearMap_single, barMap_mk]
  rw [← h2, LinearEquiv.symm_apply_apply]

/-- The comparison map restricted to `JⁿM → (J')ⁿN`. -/
noncomputable def JpowMRestrict (n : ℕ) :
    JpowM M f n →ₗ[R] JpowM N (fun i => algebraMap R S (f i)) n where
  toFun x := ⟨bc x.1, map_mem_JpowM S f bc n x.1 x.2⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' r x := Subtype.ext (by simp)

/-- The comparison map on the degree-`n` component of the target,
`JⁿM/J^{n+1}M → (J')ⁿN/(J')^{n+1}N`. -/
noncomputable def tgtMapComp (n : ℕ) :
    Tcomp M f n →ₗ[R] Tcomp N (fun i => algebraMap R S (f i)) n :=
  Submodule.liftQ (Tsub M f n)
    ((Submodule.mkQ (Tsub N (fun i => algebraMap R S (f i)) n)).restrictScalars R ∘ₗ
      JpowMRestrict S f bc n)
    (fun x hx =>
      (Submodule.Quotient.mk_eq_zero _).2
        ((mem_Tsub_iff _ n _).2 (map_mem_JpowM S f bc (n + 1) x ((mem_Tsub_iff f n x).1 hx))))

/-- `Stacks.QuasiregularSequence.FlatBaseChange.tgtMapComp` sends the class of `x ∈ JⁿM` to the
class of `bc x ∈ (J')ⁿN`. -/
theorem tgtMapComp_mk (n : ℕ) (x : JpowM M f n) :
    tgtMapComp S f bc n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk ⟨bc x.1, map_mem_JpowM S f bc n x.1 x.2⟩ :=
  rfl

/-- The comparison map on the targets, componentwise `tgtMapComp`. -/
noncomputable def tgtMap : Target M f →ₗ[R] Target N (fun i => algebraMap R S (f i)) :=
  DirectSum.lmap fun n => tgtMapComp S f bc n

/-- `Stacks.QuasiregularSequence.FlatBaseChange.tgtMap` on the image of a monomial: the class of
`f^e m` goes to the class of `(f')^e (bc m)`. -/
theorem tgtMap_imgTargetLin (e : Fin c →₀ ℕ) (m : M) :
    tgtMap S f bc (imgTargetLin f e m) =
      imgTargetLin (fun i => algebraMap R S (f i)) e (bc m) := by
  simp only [imgTargetLin, imgClassLin, LinearMap.coe_comp, Function.comp_apply,
    Submodule.mkQ_apply, tgtMap, DirectSum.lmap_lof, tgtMapComp_mk]
  exact congrArg _ (congrArg _ (Subtype.ext (map_fpow_smul S f bc e m)))

/-- The canonical map commutes with base change: the square formed by `srcMap`, `tgtMap` and the
two canonical maps commutes. -/
theorem quasiRegularCanonicalMap_srcMap (x : Source M f) :
    quasiRegularCanonicalMap (M := N) (fun i => algebraMap R S (f i)) (srcMap S f bc x) =
      tgtMap S f bc (quasiRegularCanonicalMap (M := M) f x) := by
  obtain ⟨y, rfl⟩ := (srcFinsuppEquiv M f).symm.surjective x
  induction y using Finsupp.induction_linear with
  | zero => simp
  | single e mb =>
    induction mb using Submodule.Quotient.induction_on with
    | H
      m =>
      have hs :
        (srcFinsuppEquiv M f).symm (Finsupp.single e (Submodule.Quotient.mk m)) =
          srcMono f e m := by
        rw [← srcFinsuppEquiv_srcMono f e m, LinearEquiv.symm_apply_apply]
      rw [hs, srcMap_srcMono, canonicalMap_srcMono, canonicalMap_srcMono, tgtMap_imgTargetLin]
  | add a b ha hb => simp only [map_add, ha, hb]

end BaseChange

/-! ### Injectivity of the canonical map, degreewise -/

/-- Every element of the source is a finite sum of monomials `X^e ⊗ (s e)`. -/
theorem eq_sum_srcMono (f : Fin c → R) (x : Source M f) (s : (Fin c →₀ ℕ) → M)
    (hs : ∀ e, (Submodule.Quotient.mk (s e) : qrMbar M f) = srcFinsuppEquiv M f x e) :
    x = ∑ e ∈ (srcFinsuppEquiv M f x).support, srcMono f e (s e) := by
  classical
  apply (srcFinsuppEquiv M f).injective
  rw [map_sum, Finset.sum_congr rfl (fun e _ => srcFinsuppEquiv_srcMono f e (s e))]
  refine Finsupp.ext fun i => ?_
  simp only [Finsupp.finsetSum_apply, Finsupp.single_apply, hs]
  rw [Finset.sum_ite_eq' (srcFinsuppEquiv M f x).support i (fun e => srcFinsuppEquiv M f x e)]
  by_cases hi : i ∈ (srcFinsuppEquiv M f x).support
  · simp [hi]
  · simp [hi, Finsupp.notMem_support_iff.mp hi]

/-- Suppose the canonical map is injective. For a finite family `(m_k)_{k ∈ S}` of elements of `M`
tagged by multi-indices `d k` of one and the same total degree `n`, a relation
`∑_{k ∈ S} f^{d k} · m_k ∈ J^{n+1}M` forces every partial sum over a fibre of `d` into `JM`. -/
theorem sum_filter_mem_of_injective {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := M) f)) (n : ℕ) {κ : Type*}
    (S : Finset κ) (d : κ → (Fin c →₀ ℕ)) (m : κ → M) (hdeg : ∀ k ∈ S, qrMdeg (d k) = n)
    (hrel : (∑ k ∈ S, fpow f (d k) • m k) ∈ JpowM M f (n + 1)) (e : Fin c →₀ ℕ) :
    (∑ k ∈ S with d k = e, m k) ∈ Jid f • (⊤ : Submodule R M) := by
  classical
  have hsum : (∑ k ∈ S, fpow f (d k) • m k) ∈ JpowM M f n := JpowM_succ_le f n hrel
  have hzero : quasiRegularCanonicalMap (M := M) f (∑ k ∈ S, srcMono f (d k) (m k)) = 0 := by
    rw [map_sum, Finset.sum_congr rfl (fun k _ => canonicalMap_srcMono f (d k) (m k)),
      sum_imgTargetLin_eq_degLift S d m n hdeg hsum, degLift_eq_zero_iff]
    exact hrel
  have hx0 : (∑ k ∈ S, srcMono f (d k) (m k)) = 0 := hinj (hzero.trans (map_zero _).symm)
  have hfs : (∑ k ∈ S, Finsupp.single (d k) (Submodule.Quotient.mk (m k) : qrMbar M f)) = 0 := by
    have := congrArg (srcFinsuppEquiv M f) hx0
    rwa [map_sum, Finset.sum_congr rfl (fun k _ => srcFinsuppEquiv_srcMono f (d k) (m k)),
      map_zero] at this
  have hev := congrArg (fun t : (Fin c →₀ ℕ) →₀ qrMbar M f => t e) hfs
  simp only [Finsupp.finsetSum_apply, Finsupp.single_apply, Finsupp.coe_zero, Pi.zero_apply] at hev
  rw [← Finset.sum_filter] at hev
  refine (Submodule.Quotient.mk_eq_zero _).mp ?_
  rw [← Submodule.mkQ_apply, map_sum]
  simpa only [Submodule.mkQ_apply] using hev

/-- Suppose the canonical map is injective. If the tag `d k₀` occurs only at `k₀`, then a relation
`∑_{k ∈ S} f^{d k} · m_k ∈ J^{n+1}M` forces `m k₀` into `JM`. -/
theorem mem_of_sum_fpow_smul_mem_of_unique {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := M) f)) (n : ℕ) {κ : Type*}
    (S : Finset κ) (d : κ → (Fin c →₀ ℕ)) (m : κ → M) (hdeg : ∀ k ∈ S, qrMdeg (d k) = n)
    (hrel : (∑ k ∈ S, fpow f (d k) • m k) ∈ JpowM M f (n + 1)) (k₀ : κ) (hk₀ : k₀ ∈ S)
    (huniq : ∀ k ∈ S, d k = d k₀ → k = k₀) : m k₀ ∈ Jid f • (⊤ : Submodule R M) := by
  classical
  have h := sum_filter_mem_of_injective hinj n S d m hdeg hrel (d k₀)
  have hfil : S.filter (fun k => d k = d k₀) = {k₀} :=
    Finset.eq_singleton_iff_unique_mem.mpr
      ⟨Finset.mem_filter.mpr ⟨hk₀, rfl⟩, fun k hk =>
        huniq k (Finset.mem_filter.mp hk).1 (Finset.mem_filter.mp hk).2⟩
  rwa [hfil, Finset.sum_singleton] at h

/-- Suppose the canonical map is injective. A relation `∑_{|e| = n} f^e · m_e ∈ J^{n+1}M` forces
every coefficient into `JM`. -/
theorem mem_of_sum_fpow_smul_mem {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := M) f)) (n : ℕ)
    (S : Finset (Fin c →₀ ℕ)) (s : (Fin c →₀ ℕ) → M) (hdeg : ∀ e ∈ S, qrMdeg e = n)
    (hrel : (∑ e ∈ S, fpow f e • s e) ∈ JpowM M f (n + 1)) :
    ∀ e ∈ S, s e ∈ Jid f • (⊤ : Submodule R M) := fun e he =>
  mem_of_sum_fpow_smul_mem_of_unique hinj n S id s hdeg hrel e he (fun _ _ h => h)

/-- If the canonical map kills a finite sum of monomials `∑_{e ∈ S} X^e ⊗ m̄_e`, then for every `n`
the degree-`n` part of that sum is a relation: `∑_{e ∈ S, |e| = n} f^e · m_e ∈ J^{n+1}M`. -/
theorem sum_filter_mem_JpowM_succ {f : Fin c → R} (S : Finset (Fin c →₀ ℕ))
    (s : (Fin c →₀ ℕ) → M)
    (hx : quasiRegularCanonicalMap (M := M) f (∑ e ∈ S, srcMono f e (s e)) = 0) (n : ℕ) :
    (∑ e ∈ S with qrMdeg e = n, fpow f e • s e) ∈ JpowM M f (n + 1) := by
  classical
  have hdeg : ∀ e ∈ S.filter (fun e => qrMdeg e = n), qrMdeg e = n := fun e he =>
    (Finset.mem_filter.mp he).2
  have hsum : (∑ e ∈ S with qrMdeg e = n, fpow f e • s e) ∈ JpowM M f n := by
    refine Submodule.sum_mem _ fun e he => ?_
    have := fpow_smul_mem f e (s e)
    rwa [hdeg e he] at this
  have hcomp :
    DirectSum.component R ℕ (fun k => Tcomp M f k) n (∑ e ∈ S, imgTargetLin f e (s e)) = 0 := by
    rw [map_sum, Finset.sum_congr rfl (fun e _ => canonicalMap_srcMono f e (s e))] at hx
    rw [hx, map_zero]
  have hother :
    DirectSum.component R ℕ (fun k => Tcomp M f k) n
        (∑ e ∈ S with ¬qrMdeg e = n, imgTargetLin f e (s e)) =
      0 := by
    rw [map_sum]
    exact
      Finset.sum_eq_zero fun e he =>
        component_imgTargetLin_of_ne f e (s e) (Finset.mem_filter.mp he).2
  rw [←
    Finset.sum_filter_add_sum_filter_not S (fun e => qrMdeg e = n)
      (fun e => imgTargetLin f e (s e)),
    map_add, hother, add_zero, sum_imgTargetLin_eq_degLift' _ s n hdeg hsum, degLift,
    LinearMap.coe_comp, Function.comp_apply, DirectSum.component.lof_self,
    mkQ_Tsub_eq_zero_iff] at hcomp
  exact hcomp

/-- If, for every `n`, a relation `∑_{e ∈ S} f^e · m_e ∈ J^{n+1} M` among monomials of total degree
`n` forces every coefficient `m_e` into `JM`, then the canonical map is injective. -/
theorem injective_of_mem_of_sum_fpow_smul_mem {f : Fin c → R}
    (H :
      ∀ (n : ℕ) (S : Finset (Fin c →₀ ℕ)) (s : (Fin c →₀ ℕ) → M),
        (∀ e ∈ S, qrMdeg e = n) →
          (∑ e ∈ S, fpow f e • s e) ∈ JpowM M f (n + 1) →
          ∀ e ∈ S, s e ∈ Jid f • (⊤ : Submodule R M)) :
    Function.Injective (quasiRegularCanonicalMap (M := M) f) := by
  classical
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro x hx
  set t : (Fin c →₀ ℕ) →₀ qrMbar M f := srcFinsuppEquiv M f x with ht
  choose s hs using fun e : Fin c →₀ ℕ =>
    Submodule.Quotient.mk_surjective (Jid f • (⊤ : Submodule R M)) (t e)
  have hxeq : x = ∑ e ∈ t.support, srcMono f e (s e) := eq_sum_srcMono f x s (ht ▸ hs)
  suffices h : t = 0 by
    rw [ht] at h
    simpa using (srcFinsuppEquiv M f).map_eq_zero_iff.mp h
  refine Finsupp.ext fun e => ?_
  by_cases he : e ∈ t.support
  · have hrel :=
      sum_filter_mem_JpowM_succ t.support s
        (by
          rw [← hxeq]; exact hx)
        (qrMdeg e)
    have hmem :=
      H (qrMdeg e) _ s (fun e' he' => (Finset.mem_filter.mp he').2) hrel e
        (Finset.mem_filter.mpr ⟨he, rfl⟩)
    rw [← hs e, Finsupp.coe_zero, Pi.zero_apply, Submodule.Quotient.mk_eq_zero]
    exact hmem
  · simpa using Finsupp.notMem_support_iff.mp he

end Graded

/-- Bijectivity of the canonical map is transported along an equality of the lengths of the
indexing sequence. -/
theorem bijective_quasiRegularCanonicalMap_congr {c c' : ℕ} (h : c' = c) (f : Fin c → R)
    (f' : Fin c' → R) (hf : ∀ i : Fin c', f' i = f (Fin.cast h i)) :
    Function.Bijective (quasiRegularCanonicalMap (M := M) f') ↔
      Function.Bijective (quasiRegularCanonicalMap (M := M) f) := by
  subst h
  rw [show f' = f from funext hf]
