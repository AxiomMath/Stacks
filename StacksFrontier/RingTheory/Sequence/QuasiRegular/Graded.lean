module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.Module.Torsion.Basic
public import StacksFrontier.RingTheory.Sequence.QuasiRegular.Defs
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Quasi-regularity and the quotient by the intersection of the powers of `J`

Throughout, `R` is a commutative unital ring, `M` is an `R`-module, and `f_1, …, f_c ∈ R` is
a finite sequence with `J = (f_1, …, f_c)` the ideal generated by the `f_i`. We use the
convention `J^0 = R`, so `J^0 M = M`.

## The canonical map `ψ`

There is a canonical homomorphism of graded `(R/J)[X_1, …, X_c]`-modules
  `ψ : (M/JM) ⊗_{R/J} (R/J)[X_1, …, X_c] → ⨁_{n ≥ 0} J^n M / J^{n+1} M`,
determined by the rule
  `m̄ ⊗ X_1^{e_1} ⋯ X_c^{e_c} ↦ f_1^{e_1} ⋯ f_c^{e_c} · m  mod  J^{e_1 + ⋯ + e_c + 1} M`.
The source is graded by total degree, with `M/JM` in degree 0, and a monomial of total
degree `n` lands in the degree-`n` summand `J^n M / J^{n+1} M`. This map is always well
defined and surjective; see `psi`, `psi_single` and `psi_surjective`.

## `M`-quasi-regular sequences

The sequence `f_1, …, f_c` is `M`-quasi-regular (`IsMQuasiregular`) if `ψ` is an
isomorphism; equivalently, since `ψ` is always surjective, if `ψ` is injective.

## Notation for the quotient setup

With `J = (f_1, …, f_r)`, set
  `I_R = ⋂_{n ≥ 0} J^n ⊆ R`,   `I_M = ⋂_{n ≥ 0} J^n M ⊆ M`,
and `R̄ = R / I_R`, `M̄ = M / I_M`. Then `M̄` is naturally an `R̄`-module, since
`I_R · M ⊆ I_M`. Let `f̄_i ∈ R̄` be the image of `f_i`, and `J̄ = (f̄_1, …, f̄_r)`.

## Main statement

`isMQuasiregular_iff_isMQuasiregular_quotient` (Stacks Tag 065N, Lemma 10.69.9): the
sequence `f_1, …, f_r` is `M`-quasi-regular if and only if the sequence `f̄_1, …, f̄_r` is
`M̄`-quasi-regular, over `R̄` and with respect to `M̄`.

## Modelling choices

* A *finite sequence* `f_1, …, f_c ∈ R` is a function `f : Fin c → R`, and
  `J = (f_1, …, f_c)` is `Ideal.span (Set.range f)`. This matches the
  `RingTheory.Sequence` conventions in Mathlib.
* The `n`-th graded piece `J^n M / J^{n+1} M` is `GPiece J n`, the quotient of the
  submodule `J^n • ⊤ : Submodule R M` (which is exactly `J^n M`) by the submodule
  `J^{n+1} • ⊤` (sitting inside `J^n • ⊤` since `J^{n+1} M ⊆ J^n M`).
* The associated graded module `⨁_{n} J^n M / J^{n+1} M` is `DirectSum ℕ (GPiece J)`.
* The source `(M/JM) ⊗_{R/J} (R/J)[X_1, …, X_c]` is the *free `M/JM`-module on the
  monomials* `X_1^{e_1} ⋯ X_c^{e_c}`, i.e. `(Fin c →₀ ℕ) →₀ (M ⧸ J • ⊤)`: a monomial is an
  exponent vector `e : Fin c →₀ ℕ` and a general element is a finite formal sum of
  `(monomial) ⊗ (class of m)`. This is canonically isomorphic, as a graded module, to
  `(M/JM) ⊗_{R/J} (R/J)[X]`, the total degree of a monomial `e` being `qrMdeg e = ∑ i, e i`.
  This free-module presentation makes the canonical map and the grading transparent while
  remaining faithful to the mathematics.
-/

@[expose] public section

open Submodule Pointwise

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- The `n`-th associated graded piece `J^n M / J^{n+1} M`, modelled as the quotient
of the submodule `J^n • ⊤` (which is `J^n M`) by its sub-submodule `J^{n+1} • ⊤`. -/
@[ega "0 10.1.1" "partial",
  ega "0 16.2.1",
  ega "III 4.3.13" "partial",
  ega "IV 11.4.1.1" "partial",
  ega "IV 16.1.2" "special case",
  ega "IV 16.3.1" "special case",
  ega "IV 16.3.7",
  ega "IV 19.6.1" "special case",
  ega "IV 6.10.1" "special case",
  sga "1 II 4.14" "partial",
  sga "1 III 6.9" "more general",
  sga "6 VII 1.2"]
abbrev GPiece (J : Ideal R) (n : ℕ) : Type _ :=
  ↥((J ^ n) • (⊤ : Submodule R M)) ⧸
    (((J ^ (n + 1)) • (⊤ : Submodule R M)).submoduleOf ((J ^ n) • (⊤ : Submodule R M)))

/-- For `g ∈ J^n`, the linear map `M → J^n M`, `m ↦ g • m`. -/
noncomputable def toSub (J : Ideal R) (g : R) (n : ℕ) (hg : g ∈ J ^ n) :
    M →ₗ[R] ↥((J ^ n) • (⊤ : Submodule R M)) :=
  LinearMap.codRestrict _ (g • LinearMap.id) (fun m => by
    simp only [LinearMap.smul_apply, LinearMap.id_apply]
    exact Submodule.smul_mem_smul hg trivial)

/-- The underlying element of `toSub J g n hg m` in `M` is `g • m`. -/
@[simp] lemma toSub_coe (J : Ideal R) (g : R) (n : ℕ) (hg : g ∈ J ^ n) (m : M) :
    ((toSub J g n hg m : ↥((J ^ n) • (⊤ : Submodule R M))) : M) = g • m := rfl

/-- For `g ∈ J^n`, the linear map `M → J^n M / J^{n+1} M`, `m ↦ g • m mod J^{n+1} M`. -/
noncomputable def toGP (J : Ideal R) (g : R) (n : ℕ) (hg : g ∈ J ^ n) :
    M →ₗ[R] GPiece (M := M) J n :=
  (((J ^ (n + 1)) • (⊤ : Submodule R M)).submoduleOf ((J ^ n) • (⊤ : Submodule R M))).mkQ ∘ₗ
    (toSub J g n hg)

/-- For `g ∈ J^n`, the map `m ↦ g • m mod J^{n+1} M` factors through `M / JM`, giving
the linear map `M/JM → J^n M / J^{n+1} M` on which the canonical map is built. -/
noncomputable def liftedGP (J : Ideal R) (g : R) (n : ℕ) (hg : g ∈ J ^ n) :
    (M ⧸ (J • (⊤ : Submodule R M))) →ₗ[R] GPiece (M := M) J n :=
  (J • (⊤ : Submodule R M)).liftQ (toGP J g n hg) (by
    intro m hm
    rw [LinearMap.mem_ker]
    change ((((J ^ (n + 1)) • (⊤ : Submodule R M)).submoduleOf ((J ^ n) • (⊤ : Submodule R M))).mkQ
      (toSub J g n hg m)) = 0
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    change (toSub J g n hg m : M) ∈ (J ^ (n + 1)) • (⊤ : Submodule R M)
    rw [toSub_coe]
    have : g • m ∈ (J ^ n) • (J • (⊤ : Submodule R M)) := Submodule.smul_mem_smul hg hm
    rwa [smul_smul, ← pow_succ] at this)

/-- The set of degree-`n` monomial values `fpow f e`. -/
def monSet {c : ℕ} (f : Fin c → R) (n : ℕ) : Set R :=
  { x | ∃ e : Fin c →₀ ℕ, qrMdeg e = n ∧ x = fpow f e }

/-- `J^n` is contained in the span of the degree-`n` monomials. -/
lemma pow_le_span_monSet {c : ℕ} (f : Fin c → R) (n : ℕ) :
    (Ideal.span (Set.range f)) ^ n ≤ Ideal.span (monSet f n) := by
  induction n with
  | zero =>
    rw [pow_zero, Ideal.one_eq_top, top_le_iff, Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨0, by simp [qrMdeg], by simp [fpow]⟩
  | succ n ih =>
    rw [pow_succ]
    calc (Ideal.span (Set.range f)) ^ n * Ideal.span (Set.range f)
        ≤ Ideal.span (monSet f n) * Ideal.span (Set.range f) := Ideal.mul_mono ih le_rfl
      _ = Ideal.span ((monSet f n) * (Set.range f)) := Ideal.span_mul_span _ _
      _ ≤ Ideal.span (monSet f (n + 1)) := by
          apply Ideal.span_mono
          rintro x ⟨a, ha, b, hb, rfl⟩
          obtain ⟨e, he, rfl⟩ := ha
          obtain ⟨i, rfl⟩ := hb
          refine ⟨e + Finsupp.single i (1:ℕ), by rw [qrMdeg_addSingle, he], ?_⟩
          change fpow f e * f i = _
          exact (mul_comm (fpow f e) (f i)).trans (fpow_add_single f e i).symm

/-- **Definition 1: the canonical map `ψ`.**

The canonical graded `R`-linear map from the source
`(M/JM) ⊗_{R/J} (R/J)[X] ≅ (Fin c →₀ ℕ) →₀ (M ⧸ J • ⊤)`
to the associated graded module `⨁_{n} J^n M / J^{n+1} M`, sending the basis element
`m̄ ⊗ X^e` (= `Finsupp.single e m̄`) to `(∏ f_i^{e_i}) • m  mod  J^{(qrMdeg e)+1} M`,
placed in the degree-`(qrMdeg e)` summand. -/
@[ega "0 15.1.1",
  ega "0 15.1.5" "special case",
  ega "0 15.2.1" "special case",
  ega "IV 19.5.4" "more general",
  ega "IV 19.6.2" "special case",
  ega "IV 19.7.1" "special case"]
noncomputable def psi {c : ℕ} (f : Fin c → R) :
    ((Fin c →₀ ℕ) →₀ (M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M)))) →ₗ[R]
      (DirectSum ℕ (fun n => GPiece (M := M) (Ideal.span (Set.range f)) n)) :=
  Finsupp.lsum R (fun e =>
    (DirectSum.lof R ℕ (fun n => GPiece (M := M) (Ideal.span (Set.range f)) n) (qrMdeg e)) ∘ₗ
      liftedGP (Ideal.span (Set.range f)) (fpow f e) (qrMdeg e) (fpow_mem f e))

/-- **Correctness of Definition 1 (value on a monomial).**
`ψ` sends the basis element `X^e ⊗ m̄` to the class of `(∏ f_i^{e_i}) • m` in
the degree-`(qrMdeg e)` graded piece. This pins down `ψ` by the rule in Definition 1. -/
@[ega "0 15.1.1" "partial"]
theorem psi_single {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ)
    (mbar : M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))) :
    psi f (Finsupp.single e mbar) =
      DirectSum.lof R ℕ (fun n => GPiece (M := M) (Ideal.span (Set.range f)) n) (qrMdeg e)
        (liftedGP (Ideal.span (Set.range f)) (fpow f e) (qrMdeg e) (fpow_mem f e) mbar) := by
  simp [psi, Finsupp.lsum_single]

/-- Value of `liftedGP` on the class of `m`: it is the class of `⟨g • m, _⟩`. -/
lemma liftedGP_mk (J : Ideal R) (g : R) (n : ℕ) (hg : g ∈ J ^ n) (m : M)
    (h : g • m ∈ (J ^ n) • (⊤ : Submodule R M)) :
    liftedGP (M := M) J g n hg (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk ⟨g • m, h⟩ := by
  rfl

/-- **Correctness of Definition 1 (surjectivity).**
The canonical map `ψ` is always surjective. -/
@[ega "0 15.1.1",
  ega "0 15.1.5" "special case",
  ega "IV 19.5.4" "more general",
  ega "IV 19.6.2" "special case"]
theorem psi_surjective {c : ℕ} (f : Fin c → R) : Function.Surjective (psi (M := M) f) := by
  set J := Ideal.span (Set.range f)
  rw [← LinearMap.range_eq_top]
  -- It suffices to show each generator `lof n (mk z)` is in the range.
  -- Monomials of degree `n` lie in `J^n`.
  have hmon_le : ∀ n : ℕ, Ideal.span (monSet f n) ≤ J ^ n := by
    intro n
    rw [Ideal.span_le]
    rintro x ⟨e, rfl, rfl⟩
    exact fpow_mem f e
  -- Membership: if `a ∈ span (monSet f n)` then `a • m ∈ J^n • ⊤`.
  have hsmem : ∀ (n : ℕ) (a : R), a ∈ Ideal.span (monSet f n) → ∀ m : M,
      a • m ∈ (J ^ n) • (⊤ : Submodule R M) :=
    fun n a ha m => Submodule.smul_mem_smul (hmon_le n ha) trivial
  -- Key per-element lemma: classes of `a • m` for `a ∈ J^n` are reachable.
  have key : ∀ (n : ℕ) (a : R), a ∈ J ^ n → ∀ (m : M)
      (h : a • m ∈ (J ^ n) • (⊤ : Submodule R M)),
      DirectSum.lof R ℕ (fun k => GPiece (M := M) J k) n
        (Submodule.Quotient.mk ⟨a • m, h⟩) ∈ LinearMap.range (psi (M := M) f) := by
    intro n a ha m
    -- induct over the span structure
    refine Submodule.span_induction
      (p := fun a _ => ∀ (h : a • m ∈ (J ^ n) • (⊤ : Submodule R M)),
        DirectSum.lof R ℕ (fun k => GPiece (M := M) J k) n
          (Submodule.Quotient.mk ⟨a • m, h⟩) ∈ LinearMap.range (psi (M := M) f))
      ?_ ?_ ?_ ?_ (pow_le_span_monSet f n ha)
    · -- monomial generator: `a = fpow f e` with `qrMdeg e = n`
      rintro x ⟨e, he, rfl⟩ h
      refine ⟨Finsupp.single e (Submodule.Quotient.mk m), ?_⟩
      rw [psi_single]
      subst he
      rw [liftedGP_mk (M := M) J (fpow f e) (qrMdeg e) (fpow_mem f e) m h]
    · -- zero
      intro h
      have hz : (⟨(0:R) • m, h⟩ : ↥((J^n) • (⊤ : Submodule R M))) = 0 := by
        ext
        simp
      rw [hz]
      simp
    · -- addition
      intro x y hx hy phx phy h
      have hsum : (⟨(x + y) • m, h⟩ : ↥((J^n) • (⊤ : Submodule R M)))
          = ⟨x • m, hsmem n x hx m⟩ + ⟨y • m, hsmem n y hy m⟩ := by
        ext
        simp [add_smul]
      rw [hsum, Submodule.Quotient.mk_add, map_add]
      exact Submodule.add_mem _ (phx _) (phy _)
    · -- scalar multiplication
      intro b x hx phx h
      have hsc : (⟨(b • x) • m, h⟩ : ↥((J^n) • (⊤ : Submodule R M)))
          = b • ⟨x • m, hsmem n x hx m⟩ := by
        ext
        change (b • x) • m = b • (x • m)
        rw [smul_eq_mul, mul_smul]
      rw [hsc, Submodule.Quotient.mk_smul, map_smul]
      exact Submodule.smul_mem _ b (phx _)
  -- Now conclude by induction on the direct sum.
  rw [eq_top_iff]
  intro y _
  induction y using DirectSum.induction_on with
  | zero => exact Submodule.zero_mem _
  | of n x =>
    -- `x : GPiece n`: write it as `mk` of a subtype element
    obtain ⟨⟨zv, hz⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    refine Submodule.smul_induction_on' (p := fun w hw =>
        DirectSum.lof R ℕ (fun k => GPiece (M := M) J k) n
          (Submodule.Quotient.mk ⟨w, hw⟩) ∈ LinearMap.range (psi (M := M) f)) hz ?_ ?_
    · intro r hr nn _
      exact key n r hr nn (Submodule.smul_mem_smul hr trivial)
    · intro w hw w' hw' pw pw'
      have hsum : (⟨w + w', Submodule.add_mem _ hw hw'⟩ : ↥((J^n) • (⊤ : Submodule R M)))
          = ⟨w, hw⟩ + ⟨w', hw'⟩ := rfl
      rw [hsum, Submodule.Quotient.mk_add, map_add]
      exact Submodule.add_mem _ pw pw'
  | add a b ha hb => exact Submodule.add_mem _ (ha trivial) (hb trivial)

/-- **Definition 2: `M`-quasi-regular sequence.**
The sequence `f` is `M`-quasi-regular if the canonical map `ψ` is bijective (an
isomorphism). Since `ψ` is always surjective, this is equivalent to injectivity. -/
@[ega "0 15.1.4" "more general",
  ega "0 15.1.7",
  ega "0 15.2.2" "special case",
  ega "IV 19.5.1",
  ega "IV 19.5.5.2" "more general"]
def IsMQuasiregular {c : ℕ} (f : Fin c → R) : Prop := Function.Bijective (psi (M := M) f)

/-- Equivalent reformulation of Definition 2: `M`-quasi-regularity is equivalent to
injectivity of `ψ`, using that `ψ` is always surjective. -/
theorem isMQuasiregular_iff_injective {c : ℕ} (f : Fin c → R) :
    IsMQuasiregular (M := M) f ↔ Function.Injective (psi (M := M) f) :=
  ⟨fun h => h.left, fun h => ⟨h, psi_surjective f⟩⟩

-- Notation for the quotient setup.

/-- `I_R = ⋂_{n ≥ 0} J^n`, the intersection of all powers of `J = (f_i)`. -/
abbrev IR {c : ℕ} (f : Fin c → R) : Ideal R := ⨅ n : ℕ, (Ideal.span (Set.range f)) ^ n

/-- `I_M = ⋂_{n ≥ 0} J^n M`, the intersection of all `J^n M = J^n • ⊤`. -/
abbrev IMsub {c : ℕ} (f : Fin c → R) : Submodule R M :=
  ⨅ n : ℕ, (Ideal.span (Set.range f)) ^ n • (⊤ : Submodule R M)

/-- `I_R · M ⊆ I_M`, the inclusion making `M̄ = M / I_M` an `R̄ = R / I_R`-module. -/
lemma IR_smul_le {c : ℕ} (f : Fin c → R) : (IR f) • (⊤ : Submodule R M) ≤ IMsub (M := M) f :=
  le_iInf fun n => Submodule.smul_mono_left (iInf_le _ n)

/-- `R̄ = R / I_R`. -/
abbrev Rbar {c : ℕ} (f : Fin c → R) : Type _ := R ⧸ IR f

/-- `M̄ = M / I_M`. -/
abbrev Mbar {c : ℕ} (f : Fin c → R) : Type _ := M ⧸ IMsub (M := M) f

/-- The natural `R̄`-module structure on `M̄`, coming from `I_R · M ⊆ I_M`. -/
@[reducible] noncomputable def mbarModule {c : ℕ} (f : Fin c → R) :
    Module (Rbar f) (Mbar (M := M) f) :=
  ((Module.isTorsionBySet_quotient_iff (IMsub (M := M) f) (IR f : Set R)).mpr
    (fun _ _r hr => IR_smul_le f (Submodule.smul_mem_smul hr ⟨⟩))).module

/-- `f̄_i ∈ R̄` is the image of `f_i` under `R → R̄ = R / I_R`. -/
abbrev fbar {c : ℕ} (f : Fin c → R) : Fin c → Rbar f := fun i => Ideal.Quotient.mk (IR f) (f i)

/-!
## Proof of the main theorem

The canonical map `ψ` for `(R, M, f)` and the canonical map `ψ̄ = psi (fbar f)` for
`(R̄, M̄, f̄)` are identified through isomorphisms on *both* source and target; hence one is
bijective if and only if the other is, which is exactly the biconditional.

* **Target.** The quotient map `q : M → M̄ = M/I_M` induces, for every `n`, an isomorphism
  of associated graded pieces `J^n M / J^{n+1} M ≅ J̄^n M̄ / J̄^{n+1} M̄` (`gpiece_equiv`).
  Assembling these degreewise gives the graded isomorphism of targets
  `⨁_n J^n M/J^{n+1}M ≅ ⨁_n J̄^n M̄/J̄^{n+1}M̄` (`tgt_equiv`).
* **Source.** Likewise `q` induces `M/JM ≅ M̄/J̄M̄` (`source0_equiv`), and applying it
  coefficientwise over the shared monomial index set `Fin c →₀ ℕ` gives the isomorphism of
  sources `(… →₀ M/JM) ≅ (… →₀ M̄/J̄M̄)` (`src_equiv`).
* **Compatibility.** `ψ` is intertwined with these: `tgt_equiv ∘ ψ = ψ̄ ∘ src_equiv`
  (`psi_compat`). This is a check on basis elements: `ψ (single e m̄)` lands in degree
  `qrMdeg e` as `[(∏ fᵢ^{eᵢ})·m]`, whose image under `gpiece_equiv` is the class of
  `(∏ f̄ᵢ^{eᵢ})·q(m)`, which is precisely `ψ̄ (single e (image of m̄))`.
* **Assembly.** Bijectivity transports across the commuting square, whose vertical maps
  `src_equiv` and `tgt_equiv` are bijective.

`src_equiv` and `tgt_equiv` are phrased as additive equivalences (`≃+`): the two sides live
over the different base rings `R` and `R̄`, but `IsMQuasiregular` only asks for
`Function.Bijective ψ`, so additive bijections intertwining `ψ` and `ψ̄` suffice.
-/

/-- A third-isomorphism-style helper: for a linear map `q : M → M'` and
submodules `N`, `P` of `M` with `ker q ≤ P`, the quotient `↥N ⧸ P.submoduleOf N`
is linearly isomorphic to `↥(q N) ⧸ (q P).submoduleOf (q N)`. (No surjectivity of `q`
needed; the map `↥N → ↥(qN) → (↥(qN) ⧸ ...)` is surjective and has kernel
`P.submoduleOf N` precisely because `ker q ≤ P`.) -/
noncomputable def gpiece_coreEquiv {M' : Type*} [AddCommGroup M'] [Module R M']
    (q : M →ₗ[R] M') (N P : Submodule R M) (hkerP : LinearMap.ker q ≤ P) :
    (↥N ⧸ P.submoduleOf N) ≃ₗ[R]
      (↥(N.map q) ⧸ (P.map q).submoduleOf (N.map q)) := by
  set q' : ↥N →ₗ[R] ↥(N.map q) :=
    LinearMap.codRestrict _ (q.comp N.subtype) fun x => Submodule.mem_map_of_mem x.property
  set tgtP := (P.map q).submoduleOf (N.map q)
  set g : ↥N →ₗ[R] (↥(N.map q) ⧸ tgtP) := tgtP.mkQ.comp q' with hg
  have hgsurj : Function.Surjective g := by
    intro y
    obtain ⟨z, rfl⟩ := tgtP.mkQ_surjective y
    obtain ⟨zv, hz⟩ := z
    obtain ⟨w, hwN, rfl⟩ := hz
    exact ⟨⟨w, hwN⟩, rfl⟩
  have hker : LinearMap.ker g = P.submoduleOf N := by
    ext x
    simp only [LinearMap.mem_ker, hg, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    refine ⟨fun hx => ?_, fun hx => Submodule.mem_map_of_mem hx⟩
    change (x : M) ∈ P
    obtain ⟨p, hp, hpq⟩ := Submodule.mem_map.mp (show q (x : M) ∈ P.map q from hx)
    have hxp : (x : M) - p ∈ P := hkerP (by rw [LinearMap.mem_ker, map_sub, hpq, sub_self])
    simpa using P.add_mem hxp hp
  exact (Submodule.quotEquivOfEq _ _ hker.symm).trans (LinearMap.quotKerEquivOfSurjective g hgsurj)

/-- Value of `gpiece_coreEquiv` on the class of `⟨x, hx⟩`: it is the class of `⟨q x, _⟩`. -/
lemma gpiece_coreEquiv_mk {M' : Type*} [AddCommGroup M'] [Module R M']
    (q : M →ₗ[R] M') (N P : Submodule R M) (hkerP : LinearMap.ker q ≤ P)
    (x : M) (hx : x ∈ N) :
    gpiece_coreEquiv q N P hkerP (Submodule.Quotient.mk ⟨x, hx⟩) =
      Submodule.Quotient.mk ⟨q x, Submodule.mem_map_of_mem hx⟩ := by
  rw [gpiece_coreEquiv]
  rfl

/-- `J̄^n = (R → R̄)(J^n)`: the `n`-th power of `J̄ = span(range f̄)` is the image of
`J^n` under the quotient ring map `R → R̄`. -/
lemma gpiece_Jbar_pow {c : ℕ} (f : Fin c → R) (n : ℕ) :
    (Ideal.span (Set.range (fbar f)))^n
      = Ideal.map (algebraMap R (Rbar f)) ((Ideal.span (Set.range f))^n) := by
  rw [Ideal.map_pow]
  congr 1
  rw [show (algebraMap R (Rbar f)) = Ideal.Quotient.mk (IR f) from rfl, Ideal.map_span]
  congr 1
  rw [← Set.range_comp]
  rfl

/-- The quotient map `M → M̄` is surjective. -/
private lemma map_mkQ_top {c : ℕ} (f : Fin c → R) :
    Submodule.map (IMsub (M := M) f).mkQ (⊤ : Submodule R M) = ⊤ := by
  rw [Submodule.map_top, Submodule.range_mkQ]

/-- The image of `J^n M = J^n • ⊤` under `q : M → M̄ = M/I_M` is `J̄^n M̄ = J̄^n • ⊤`
(viewed as an `R`-submodule via `restrictScalars`). -/
lemma gpiece_map_pow_smul {c : ℕ} (f : Fin c → R) (n : ℕ) :
    letI := mbarModule (M := M) f
    Submodule.map (IMsub (M := M) f).mkQ ((Ideal.span (Set.range f))^n • (⊤ : Submodule R M))
      = ((Ideal.span (Set.range (fbar f)))^n
          • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R := by
  let := mbarModule (M := M) f
  rw [Submodule.map_smul'']
  rw [map_mkQ_top, gpiece_Jbar_pow, Ideal.smul_restrictScalars]
  congr 1

/-- Relabel a `GPiece`-style quotient `↥N ⧸ P.submoduleOf N` along equalities of the
ambient submodules `N` and `P`. Its action on a class `mk ⟨x, hx⟩` keeps the same
representative `x` (see `gpiece_relabel_mk`), so it is computation-friendly — unlike the
`rw`-transport casts. -/
noncomputable def gpiece_relabel {X : Type*} [AddCommGroup X] [Module R X]
    (N N' P P' : Submodule R X) (hN : N = N') (hP : P = P') :
    (↥N ⧸ P.submoduleOf N) ≃ₗ[R] (↥N' ⧸ P'.submoduleOf N') :=
  Submodule.Quotient.equiv _ _ (LinearEquiv.ofEq N N' hN) (by subst hN hP; simp)

/-- `gpiece_relabel` sends the class of `⟨x, hx⟩` to the class of `⟨x, _⟩` with the same
representative `x`. -/
@[simp] lemma gpiece_relabel_mk {X : Type*} [AddCommGroup X] [Module R X]
    (N N' P P' : Submodule R X) (hN : N = N') (hP : P = P') (x : X) (hx : x ∈ N) :
    gpiece_relabel N N' P P' hN hP (Submodule.Quotient.mk ⟨x, hx⟩)
      = Submodule.Quotient.mk ⟨x, hN ▸ hx⟩ := by
  subst hN hP
  rfl

/-- **Per-degree isomorphism of associated graded pieces.**
For every `n`, the quotient map `M → M̄ = M/I_M` induces an additive isomorphism
`J^n M / J^{n+1} M  ≅  J̄^n M̄ / J̄^{n+1} M̄`.

Proof. Write `J = span (range f)` and `J̄ = span (range f̄) = (J + I_R)/I_R`. The map
`q : M → M̄` sends `J^n M` onto `J̄^n M̄`, because `J̄^n M̄ = (J^n M + I_M)/I_M` is the image
of `J^n M` under `q`; here `q(J^n M) = J̄^n M̄` uses that `J̄^n` is the image of `J^n` and
that `q(J^n • ⊤) = J̄^n • ⊤_{M̄}`. Composing with `q` and the quotient by `J̄^{n+1} M̄`, the
induced surjection `J^n M ↠ J̄^n M̄ / J̄^{n+1} M̄` has kernel
`{x ∈ J^n M : q x ∈ J̄^{n+1} M̄} = J^n M ∩ (J^{n+1} M + I_M)`. The absorption identity
      `J^n M ∩ (J^{n+1} M + I_M) = J^{n+1} M`
holds because `I_M = ⋂_k J^k M ⊆ J^{n+1} M`, so that `J^{n+1} M + I_M = J^{n+1} M`. Hence
the kernel is exactly `J^{n+1} M`, and the induced map on the quotient
`J^n M / J^{n+1} M → J̄^n M̄ / J̄^{n+1} M̄` is an isomorphism. -/
noncomputable def gpiece_equiv {c : ℕ} (f : Fin c → R) (n : ℕ) :
    letI := mbarModule (M := M) f
    GPiece (M := M) (Ideal.span (Set.range f)) n ≃+
      GPiece (M := Mbar (M := M) f) (Ideal.span (Set.range (fbar f))) n := by
  letI := mbarModule (M := M) f
  set q : M →ₗ[R] Mbar (M := M) f := (IMsub (M := M) f).mkQ with hq
  have hkerP : LinearMap.ker q ≤ (Ideal.span (Set.range f))^(n+1) • (⊤ : Submodule R M) := by
    rw [hq, Submodule.ker_mkQ]
    exact iInf_le _ (n+1)
  have hce := gpiece_coreEquiv q ((Ideal.span (Set.range f))^n • (⊤ : Submodule R M))
    ((Ideal.span (Set.range f))^(n+1) • (⊤ : Submodule R M)) hkerP
  exact (hce.trans (gpiece_relabel _ _ _ _
    (gpiece_map_pow_smul f n) (gpiece_map_pow_smul f (n+1)))).toAddEquiv

/-- The kernel of `M → M̄` lies in every `J^n M`. -/
private lemma ker_mkQ_le_pow_smul {c : ℕ} (f : Fin c → R) (n : ℕ) :
    LinearMap.ker (IMsub (M := M) f).mkQ
      ≤ (Ideal.span (Set.range f)) ^ n • (⊤ : Submodule R M) := by
  rw [Submodule.ker_mkQ]
  exact iInf_le _ n

/-- `topEquiv` carries `N.submoduleOf ⊤` onto `N`. -/
private lemma map_topEquiv_submoduleOf_top {X : Type*} [AddCommGroup X] [Module R X]
    (N : Submodule R X) :
    Submodule.map (Submodule.topEquiv (R := R) (M := X) : _ →ₗ[R] _) (N.submoduleOf ⊤) = N := by
  ext x
  simp [Submodule.submoduleOf]

/-- Value of `gpiece_equiv` on the class of `⟨x, hx⟩`: it is the class of `⟨q x, _⟩`
where `q = (IMsub f).mkQ`. -/
lemma gpiece_equiv_mk {c : ℕ} (f : Fin c → R) (n : ℕ)
    (x : M) (hx : x ∈ (Ideal.span (Set.range f)) ^ n • (⊤ : Submodule R M)) :
    letI := mbarModule (M := M) f
    ∀ (hqx : (IMsub (M := M) f).mkQ x ∈
      (((Ideal.span (Set.range (fbar f)))^n
        • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R)),
    gpiece_equiv (M := M) f n (Submodule.Quotient.mk ⟨x, hx⟩) =
      Submodule.Quotient.mk ⟨(IMsub (M := M) f).mkQ x, hqx⟩ := by
  let := mbarModule (M := M) f
  intro hqx
  rw [gpiece_equiv]
  change gpiece_relabel _ _ _ _ (gpiece_map_pow_smul (M := M) f n)
      (gpiece_map_pow_smul (M := M) f (n+1))
      (gpiece_coreEquiv (IMsub (M := M) f).mkQ
        ((Ideal.span (Set.range f))^n • (⊤ : Submodule R M))
        ((Ideal.span (Set.range f))^(n+1) • (⊤ : Submodule R M))
        (ker_mkQ_le_pow_smul f (n+1))
        (Submodule.Quotient.mk ⟨x, hx⟩)) = _
  rw [gpiece_coreEquiv_mk, gpiece_relabel_mk]
  rfl

/-- **Degree-0 source isomorphism.**
The quotient map `M → M̄` induces an additive isomorphism of degree-0 source pieces
`M/JM  ≅  M̄/J̄M̄`.

Proof. This is the `n = 0` instance of the kernel computation in `gpiece_equiv`, using
`J^0 M = M` and `J^1 M = JM`: the map `q : M → M̄` sends `JM` onto `J̄M̄ = (JM + I_M)/I_M`,
and the kernel of `M ↠ M̄/J̄M̄` is `M ∩ (JM + I_M) = JM + I_M = JM`, the last equality
because `I_M = ⋂_k J^k M ⊆ J^1 M = JM`. Hence `M/JM ≅ M̄/J̄M̄`. -/
noncomputable def source0_equiv {c : ℕ} (f : Fin c → R) :
    letI := mbarModule (M := M) f
    (M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))) ≃+
      (Mbar (M := M) f ⧸
        ((Ideal.span (Set.range (fbar f))) • (⊤ : Submodule (Rbar f) (Mbar (M := M) f)))) := by
  -- (special case n = 0 of B1; could be derived from `gpiece_equiv … 0` after
  -- identifying `GPiece … 0` with `M/JM`, but kept separate for clarity.)
  letI := mbarModule (M := M) f
  set q : M →ₗ[R] Mbar (M := M) f := (IMsub (M := M) f).mkQ with hq
  have hkerP : LinearMap.ker q ≤ (Ideal.span (Set.range f)) • (⊤ : Submodule R M) := by
    rw [hq, Submodule.ker_mkQ]
    have := iInf_le (fun n : ℕ => (Ideal.span (Set.range f)) ^ n • (⊤ : Submodule R M)) 1
    rwa [pow_one] at this
  have hce := gpiece_coreEquiv q (⊤ : Submodule R M)
    ((Ideal.span (Set.range f)) • (⊤ : Submodule R M)) hkerP
  -- Identify the domain `↥⊤ ⧸ (J•⊤).submoduleOf ⊤` with `M ⧸ J•⊤`.
  have edom : (↥(⊤ : Submodule R M) ⧸
      ((Ideal.span (Set.range f)) • (⊤ : Submodule R M)).submoduleOf ⊤)
        ≃ₗ[R] (M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))) :=
    Submodule.Quotient.equiv _ _ Submodule.topEquiv (by
      ext x
      simp [Submodule.submoduleOf])
  -- Rewrite `map q ⊤ = ⊤` and `map q (J•⊤) = map q (J^1•⊤) = (J̄•⊤).restrictScalars R`.
  have hmapT : Submodule.map q (⊤ : Submodule R M) = ⊤ := by
    rw [hq, Submodule.map_top, Submodule.range_mkQ]
  have hmap1 : Submodule.map q ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))
      = ((Ideal.span (Set.range (fbar f)))
          • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R := by
    rw [hq, show (Ideal.span (Set.range f)) • (⊤ : Submodule R M)
        = (Ideal.span (Set.range f))^1 • (⊤ : Submodule R M) from by rw [pow_one],
      gpiece_map_pow_smul f 1, pow_one]
  -- Identify the codomain with `Mbar f ⧸ (J̄•⊤).restrictScalars R`.
  have ecod : (↥(⊤ : Submodule R (Mbar (M := M) f)) ⧸
      (((Ideal.span (Set.range (fbar f)))
        • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R).submoduleOf ⊤)
        ≃ₗ[R] (Mbar (M := M) f ⧸
          (((Ideal.span (Set.range (fbar f)))
            • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R)) :=
    Submodule.Quotient.equiv _ _ Submodule.topEquiv (by
      ext x
      simp [Submodule.submoduleOf])
  exact (edom.symm.trans (hce.trans ((gpiece_relabel _ _ _ _ hmapT hmap1).trans ecod))).toAddEquiv

/-- Value of `source0_equiv` on the class of `m`: it is the class of `q m`
where `q = (IMsub f).mkQ`. -/
lemma source0_equiv_mk {c : ℕ} (f : Fin c → R) (m : M) :
    letI := mbarModule (M := M) f
    source0_equiv (M := M) f (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk ((IMsub (M := M) f).mkQ m) := by
  let := mbarModule (M := M) f
  rw [source0_equiv]
  -- the three side-conditions occurring in `source0_equiv`, named explicitly
  have hkerP : LinearMap.ker (IMsub (M := M) f).mkQ
      ≤ (Ideal.span (Set.range f)) • (⊤ : Submodule R M) := by
    simpa using ker_mkQ_le_pow_smul (M := M) f 1
  have hedeq := map_topEquiv_submoduleOf_top (R := R)
    ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))
  have hmapT := map_mkQ_top (M := M) f
  have hmap1 : Submodule.map (IMsub (M := M) f).mkQ
      ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))
      = ((Ideal.span (Set.range (fbar f)))
          • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R := by
    simpa using gpiece_map_pow_smul (M := M) f 1
  have heceq := map_topEquiv_submoduleOf_top (R := R) (X := Mbar (M := M) f)
    (((Ideal.span (Set.range (fbar f)))
      • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))).restrictScalars R)
  change (Submodule.Quotient.equiv _ _ Submodule.topEquiv heceq)
      ((gpiece_relabel _ _ _ _ hmapT hmap1)
        ((gpiece_coreEquiv (IMsub (M := M) f).mkQ (⊤ : Submodule R M)
          ((Ideal.span (Set.range f)) • (⊤ : Submodule R M)) hkerP)
          ((Submodule.Quotient.equiv _ _ Submodule.topEquiv hedeq).symm
            (Submodule.Quotient.mk m)))) = _
  rw [show ((Submodule.Quotient.equiv _ _ Submodule.topEquiv hedeq).symm
        (Submodule.Quotient.mk m)) = Submodule.Quotient.mk ⟨m, Submodule.mem_top⟩ from by
      rw [LinearEquiv.symm_apply_eq, Submodule.Quotient.equiv_apply, Submodule.mapQ_apply]; rfl]
  rw [gpiece_coreEquiv_mk, gpiece_relabel_mk, Submodule.Quotient.equiv_apply,
    Submodule.mapQ_apply]
  rfl

/-- **Source isomorphism** `(…→₀ M/JM) ≅ (…→₀ M̄/J̄M̄)`, obtained by applying the
degree-0 iso `source0_equiv` coefficientwise over the shared monomial index set.

The source for `f` is `(Fin c →₀ ℕ) →₀ (M/JM)` and the source for `f̄` is
`(Fin c →₀ ℕ) →₀ (M̄/J̄M̄)`, with the *same* index type `Fin c →₀ ℕ` since `c` is the same.
So `Finsupp.mapRange.addEquiv source0_equiv` is the required additive equivalence; it sends
`single e m̄` to `single e (source0_equiv m̄)`. -/
noncomputable def src_equiv {c : ℕ} (f : Fin c → R) :
    letI := mbarModule (M := M) f
    ((Fin c →₀ ℕ) →₀ (M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M)))) ≃+
      ((Fin c →₀ ℕ) →₀ (Mbar (M := M) f ⧸
        ((Ideal.span (Set.range (fbar f))) • (⊤ : Submodule (Rbar f) (Mbar (M := M) f))))) :=
  letI := mbarModule (M := M) f
  Finsupp.mapRange.addEquiv (source0_equiv (M := M) f)

/-- **Target isomorphism** `⨁_n J^n M/J^{n+1}M ≅ ⨁_n J̄^n M̄/J̄^{n+1}M̄`, the degreewise
assembly of `gpiece_equiv`.

An additive equivalence of direct sums assembled from the family of additive equivalences
`gpiece_equiv f n` of the summands, via `DirectSum.congrAddEquiv`. -/
noncomputable def tgt_equiv {c : ℕ} (f : Fin c → R) :
    letI := mbarModule (M := M) f
    (DirectSum ℕ (fun n => GPiece (M := M) (Ideal.span (Set.range f)) n)) ≃+
      (DirectSum ℕ (fun n => GPiece (M := Mbar (M := M) f)
        (Ideal.span (Set.range (fbar f))) n)) :=
  letI := mbarModule (M := M) f
  DirectSum.congrAddEquiv (fun n => gpiece_equiv (M := M) f n)

/-- Value of `tgt_equiv` on a generator `lof n y`: it is `lof n (gpiece_equiv f n y)`. -/
lemma tgt_equiv_lof {c : ℕ} (f : Fin c → R) (n : ℕ)
    (y : GPiece (M := M) (Ideal.span (Set.range f)) n) :
    letI := mbarModule (M := M) f
    tgt_equiv (M := M) f
        (DirectSum.lof R ℕ (fun k => GPiece (M := M) (Ideal.span (Set.range f)) k) n y)
      = DirectSum.lof R ℕ
          (fun k => GPiece (M := Mbar (M := M) f) (Ideal.span (Set.range (fbar f))) k) n
          (gpiece_equiv (M := M) f n y) := by
  let := mbarModule (M := M) f
  rw [tgt_equiv, DirectSum.lof_eq_of, DirectSum.lof_eq_of]
  simp [DirectSum.congrAddEquiv]

/-- Value of `src_equiv` on a basis element `single e m̄`: applies `source0_equiv`
coefficientwise. -/
lemma src_equiv_single {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ)
    (mbar : M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))) :
    letI := mbarModule (M := M) f
    src_equiv (M := M) f (Finsupp.single e mbar)
      = Finsupp.single e (source0_equiv (M := M) f mbar) := by
  let := mbarModule (M := M) f
  rw [src_equiv, Finsupp.mapRange.addEquiv_apply, Finsupp.mapRange_single]

/-- `(R → R̄)(∏ fᵢ^{eᵢ}) = ∏ f̄ᵢ^{eᵢ}`: the quotient ring map commutes with `fpow`. -/
lemma mprod_fbar {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ) :
    Ideal.Quotient.mk (IR f) (fpow f e) = fpow (fbar f) e := by
  unfold fpow
  rw [map_prod]
  exact Finset.prod_congr rfl (fun i _ => by rw [map_pow])

/-- The `R̄`-scalar `(R → R̄)(a)` acts on `M̄` as the `R`-scalar `a`. -/
lemma mkQ_smul_eq {c : ℕ} (f : Fin c → R) (a : R)
    (z : Mbar (M := M) f) :
    letI := mbarModule (M := M) f
    (Ideal.Quotient.mk (IR f) a) • z = a • z := by
  let := mbarModule (M := M) f
  induction z using Submodule.Quotient.induction_on with
  | _ m =>
    rw [← Submodule.Quotient.mk_smul]
    rfl

/-- **Compatibility of the canonical maps on a basis element.**
`tgt_equiv ∘ ψ` and `ψ̄ ∘ src_equiv` agree on the basis element `single e m̄`.

Proof. On the one hand
  `ψ (single e m̄) = lof (qrMdeg e) [(∏ fᵢ^{eᵢ})·m]`   (`psi_single`),
and `tgt_equiv` sends this, via `gpiece_equiv (qrMdeg e)`, to
  `lof (qrMdeg e) (class of q((∏ fᵢ^{eᵢ})·m)) = lof (qrMdeg e) [(∏ f̄ᵢ^{eᵢ})·q(m)]`,
because `gpiece_equiv` is induced by `q` and `q((∏ fᵢ^{eᵢ})·m) = (∏ f̄ᵢ^{eᵢ})·q(m)`, the
`f̄ᵢ` being the `q`-images of the `fᵢ`. On the other hand
  `src_equiv (single e m̄) = single e (source0_equiv m̄)`, with
  `source0_equiv m̄ = q(m) mod J̄M̄`,
so `psi_single` for `f̄` gives `ψ̄ (src_equiv (single e m̄)) = lof (qrMdeg e) [(∏ f̄ᵢ^{eᵢ})·q(m)]`.
The two agree. -/
lemma psi_compat_single {c : ℕ} (f : Fin c → R) (e : Fin c →₀ ℕ)
    (mbar : M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M))) :
    letI := mbarModule (M := M) f
    tgt_equiv (M := M) f (psi (M := M) f (Finsupp.single e mbar)) =
      psi (M := Mbar (M := M) f) (fbar f)
        (src_equiv (M := M) f (Finsupp.single e mbar)) := by
  let := mbarModule (M := M) f
  -- reduce `mbar` to a representative `mk m`
  obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective _ mbar
  have hmem := Submodule.smul_mem_smul (fpow_mem f e) (Submodule.mem_top (x := m))
  -- LHS
  rw [psi_single, liftedGP_mk (M := M) (Ideal.span (Set.range f)) (fpow f e) (qrMdeg e)
        (fpow_mem f e) m hmem,
    tgt_equiv_lof, gpiece_equiv_mk (M := M) f (qrMdeg e) (fpow f e • m) hmem
        (by
          rw [← gpiece_map_pow_smul (M := M) f (qrMdeg e)]
          exact Submodule.mem_map_of_mem hmem)]
  -- RHS
  rw [src_equiv_single, source0_equiv_mk, psi_single,
    liftedGP_mk (M := Mbar (M := M) f) (Ideal.span (Set.range (fbar f)))
      (fpow (fbar f) e) (qrMdeg e) (fpow_mem (fbar f) e) ((IMsub (M := M) f).mkQ m)
      (Submodule.smul_mem_smul (fpow_mem (fbar f) e) trivial)]
  -- both sides are `lof (qrMdeg e) (mk ⟨_, _⟩)`; normalise `lof` to `of` (the LHS is
  -- over `R`, the RHS over `Rbar f`) and compare the representatives
  rw [DirectSum.lof_eq_of, DirectSum.lof_eq_of]
  congr 1
  apply congrArg (Submodule.Quotient.mk (p := _))
  apply Subtype.ext
  change (IMsub (M := M) f).mkQ (fpow f e • m)
      = fpow (fbar f) e • (IMsub (M := M) f).mkQ m
  rw [map_smul, ← mprod_fbar, mkQ_smul_eq]

/-- **Compatibility of the canonical maps.** `ψ` is intertwined with the source and target
isomorphisms: `tgt_equiv ∘ ψ = ψ̄ ∘ src_equiv`. Both sides are additive maps out of the source
`(Fin c →₀ ℕ) →₀ M/JM`, which is generated by the basis elements `single e m̄`, so this
follows from `psi_compat_single` by additivity. -/
lemma psi_compat {c : ℕ} (f : Fin c → R)
    (x : (Fin c →₀ ℕ) →₀ (M ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule R M)))) :
    letI := mbarModule (M := M) f
    tgt_equiv (M := M) f (psi (M := M) f x) =
      psi (M := Mbar (M := M) f) (fbar f) (src_equiv (M := M) f x) := by
  let := mbarModule (M := M) f
  induction x using Finsupp.induction with
  | zero => simp
  | single_add e mbar y _ _ ih =>
    rw [map_add, map_add, map_add, map_add, psi_compat_single, ih]

/-- **Theorem (Stacks Tag 065N, Lemma 10.69.9).**
The sequence `f_1, ..., f_r` is `M`-quasi-regular (over `R`, with respect to `M`)
if and only if the image sequence `f̄_1, ..., f̄_r` is `M̄`-quasi-regular (over
`R̄ = R / I_R`, with respect to `M̄ = M / I_M`). -/
@[stacks 065N]
theorem isMQuasiregular_iff_isMQuasiregular_quotient {c : ℕ} (f : Fin c → R) :
    letI := mbarModule (M := M) f
    IsMQuasiregular (M := M) f ↔
      IsMQuasiregular (R := Rbar f) (M := Mbar (M := M) f) (fbar f) := by
  -- Transport bijectivity across the commuting square
  --   tgt_equiv ∘ (psi f) = (psi f̄) ∘ src_equiv
  -- whose vertical maps `src_equiv`, `tgt_equiv` are (additive, hence function-)
  -- bijections. This is pure algebra; the mathematical content sits entirely in the
  -- sub-lemmas `gpiece_equiv`/`source0_equiv`/`psi_compat`.
  let := mbarModule (M := M) f
  have hsq : ⇑(tgt_equiv (M := M) f) ∘ psi (M := M) f =
      psi (M := Mbar (M := M) f) (fbar f) ∘ src_equiv (M := M) f :=
    funext (psi_compat (M := M) f)
  change Function.Bijective (psi (M := M) f) ↔
    Function.Bijective (psi (M := Mbar (M := M) f) (fbar f))
  rw [← EquivLike.comp_bijective (psi (M := M) f) (tgt_equiv (M := M) f), hsq,
    EquivLike.bijective_comp]
