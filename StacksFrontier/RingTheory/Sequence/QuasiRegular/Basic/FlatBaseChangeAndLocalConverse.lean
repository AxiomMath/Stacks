/-! ### Generic base-change tools -/

section Tools

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {M N : Type*} [AddCommGroup M]
  [Module R M] [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]

/-- `Submodule.baseChange`, in the spelling in which
`TensorProduct.AlgebraTensorModule.tensorQuotientEquiv` states its target. -/
theorem baseChange_eq_range_lTensor (P : Submodule R M) :
    P.baseChange S =
      LinearMap.range (AlgebraTensorModule.lTensor S S (P.subtype.restrictScalars R)) :=
  rfl

/-- **A submodule base-changes to the `S`-span of its image.** The identification
`hbc.equiv : S ⊗[R] M ≃ₗ[S] N` carries the base change `Submodule.baseChange S P` of a submodule
`P ⊆ M` onto the `S`-span of `bc '' P`. -/
theorem map_equiv_baseChange {bc : M →ₗ[R] N} (hbc : IsBaseChange S bc)
    (P : Submodule R M) :
    Submodule.map (hbc.equiv : S ⊗[R] M →ₗ[S] N) (P.baseChange S) =
      Submodule.span S (bc '' P) := by
  rw [Submodule.baseChange_eq_span, Submodule.map_span, Submodule.map_coe, ← Set.image_comp]
  refine congrArg _ (Set.image_congr' fun x => ?_)
  simp

/-- **A submodule of `M` base-changes to the `S`-span of its image in `N`.** If `bc : M →ₗ[R] N`
exhibits `N` as the base change of `M` along a flat ring map `R → S` and `P ⊆ M` is a submodule,
then the restriction of `bc` exhibits the `S`-span `P'` of `bc '' P` as the base change of `P`.
This is exactness of `0 → P → M`; flatness of `S` is what preserves it. -/
private theorem isBaseChange_of_submodule [Module.Flat R S] {bc : M →ₗ[R] N}
    (hbc : IsBaseChange S bc) (P : Submodule R M) (P' : Submodule S N)
    (hP' : P' = Submodule.span S (bc '' P)) (g : P →ₗ[R] P')
    (hg : ∀ x : P, ((g x : N)) = bc (x : M)) : IsBaseChange S g := by
  refine
    IsBaseChange.of_equiv
      ((Submodule.toBaseChange.toLinearEquiv S P).trans
        ((Submodule.equivMapOfInjective _ hbc.equiv.injective _).trans
          (LinearEquiv.ofEq _ _ ((map_equiv_baseChange hbc P).trans hP'.symm))))
      fun x => ?_
  exact Subtype.ext (by simpa using (hg x).symm)

/-- **A quotient base-changes to the quotient by the `S`-span of the image.** If `bc : M →ₗ[R] N`
exhibits `N` as the base change of `M` along `R → S` and `Q ⊆ M` is a submodule, then the induced
map exhibits `N/Q'` as the base change of `M/Q`, where `Q'` is the `S`-span of `bc '' Q`. This is
right exactness of the tensor product; no flatness is needed. -/
@[ega "0 15.1.17" "more general",
  ega "0 7.3.1" "more general",
  ega "0 7.7.2" "special case",
  ega "III 2.1.11" "special case"]
theorem isBaseChange_of_quotient {bc : M →ₗ[R] N} (hbc : IsBaseChange S bc)
    (Q : Submodule R M) (Q' : Submodule S N) (hQ' : Q' = Submodule.span S (bc '' Q))
    (g : (M ⧸ Q) →ₗ[R] (N ⧸ Q'))
    (hg : ∀ x : M, g (Submodule.Quotient.mk x) = Submodule.Quotient.mk (bc x)) :
    IsBaseChange S g := by
  refine
    IsBaseChange.of_equiv
      ((AlgebraTensorModule.tensorQuotientEquiv S R S Q).trans
        (Submodule.Quotient.equiv _ Q' hbc.equiv
          (by
            rw [← baseChange_eq_range_lTensor];
            exact (map_equiv_baseChange hbc Q).trans hQ'.symm)))
      fun x => ?_
  induction x using Submodule.Quotient.induction_on with
  | H m =>
    rw [LinearEquiv.trans_apply, AlgebraTensorModule.tensorQuotientEquiv_apply_tmul, hg]
    change Submodule.Quotient.mk ((hbc.equiv : S ⊗[R] M →ₗ[S] N) (1 ⊗ₜ[R] m)) = _
    simp

/-- **Injectivity descends through a base-changed square.** If the two vertical maps of a commuting
square are base changes along a flat ring map `R → S` and the top map is injective, so is the
bottom map: the bottom map is the top map tensored with `S`. -/
private theorem injective_of_isBaseChange_square [Module.Flat R S] {A A' B B' : Type*}
    [AddCommGroup A] [Module R A] [AddCommGroup A'] [Module R A'] [Module S A']
    [IsScalarTower R S A'] [AddCommGroup B] [Module R B] [AddCommGroup B'] [Module R B']
    [Module S B'] [IsScalarTower R S B'] {sm : A →ₗ[R] A'} (hsm : IsBaseChange S sm)
    {tm : B →ₗ[R] B'} (htm : IsBaseChange S tm) {φ : A →ₗ[R] B} (hφ : Function.Injective φ)
    (φ' : A' →ₗ[S] B') (hcomm : ∀ a, φ' (sm a) = tm (φ a)) : Function.Injective φ' := by
  have key :
    φ' ∘ₗ hsm.equiv.toLinearMap = htm.equiv.toLinearMap ∘ₗ AlgebraTensorModule.lTensor S S φ :=
    (TensorProduct.isBaseChange (R := R) (M := A) (S := S)).algHom_ext _ _ fun a => by simp [hcomm]
  refine
    Function.Injective.of_comp_right (f := φ') (g := (hsm.equiv : S ⊗[R] A → A')) ?_
      hsm.equiv.surjective
  rw [show φ' ∘ (hsm.equiv : S ⊗[R] A → A') = ⇑(φ' ∘ₗ hsm.equiv.toLinearMap) from rfl, key]
  exact htm.equiv.injective.comp (Module.Flat.lTensor_preserves_injective_linearMap (M := S) φ hφ)

end Tools

