/-! ### The `J`-adic filtration -/

section Filtration

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {c : ℕ} (f : Fin c → R)

/-- **`J` annihilates `JⁿM/J^{n+1}M`, and `J^{n+1}M = J · JⁿM`.** The submodule `J^{n+1}M` of
`JⁿM` is `J • ⊤`, which is what lets the quotient base-change lemma apply to the graded pieces. -/
private theorem Tsub_eq_smul_top (n : ℕ) :
    Tsub M f n = Jid f • (⊤ : Submodule R (JpowM M f n)) := by
  have hmul : Jid f • (JpowM M f n) = JpowM M f (n + 1) := by
    simp only [JpowM]
    rw [pow_succ', ← Ideal.smul_eq_mul, Submodule.smul_assoc]
  refine Submodule.map_injective_of_injective (JpowM M f n).injective_subtype ?_
  rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_subtype, hmul, Tsub,
    Submodule.map_comap_eq_self]
  simpa only [Submodule.range_subtype, JpowM] using
    Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ n) (I := Jid f))

end Filtration

/-! ### Comparison of the canonical maps along a base change -/

section Comparison

variable {R : Type*} (S : Type*) [CommRing R] [CommRing S] [Algebra R S] {M N : Type*}
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
  {c : ℕ} (f : Fin c → R) (bc : M →ₗ[R] N)

/-- **`JⁿM` base-changes to `(J')ⁿN`.** Both sides are spanned by the elements `f^e y` with
`|e| = n`, over `R` and `S` respectively, and `N` is spanned over `S` by the image of `M`. -/
private theorem span_image_JpowM (hbc : IsBaseChange S bc) (n : ℕ) :
    Submodule.span S (bc '' (JpowM M f n)) = JpowM N (fun i => algebraMap R S (f i)) n := by
  refine le_antisymm ?_ ?_
  · rw [Submodule.span_le]
    rintro y ⟨x, hx, rfl⟩
    exact map_mem_JpowM S f bc n x hx
  · rw [JpowM_eq_span, Submodule.span_le]
    rintro y ⟨e, y', he, rfl⟩
    subst he
    have hy' : y' ∈ Submodule.span S (Set.range bc) := by
      rw [IsBaseChange.span_range_eq_top hbc]; trivial
    induction hy' using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨m, rfl⟩ := hz
      exact Submodule.subset_span ⟨fpow f e • m, fpow_smul_mem f e m, map_fpow_smul S f bc e m⟩
    | zero => simp
    | add a b _ _ ha hb =>
      rw [smul_add]; exact Submodule.add_mem _ ha hb
    | smul s a _ ha =>
      rw [smul_comm]; exact Submodule.smul_mem _ _ ha

/-- The `n = 1` case of `Stacks.QuasiregularSequence.FlatBaseChange.span_image_JpowM`, in the shape
in which `M/JM` occurs. -/
private theorem Jid_smul_top_eq_span (hbc : IsBaseChange S bc) :
    Jid (fun i => algebraMap R S (f i)) • (⊤ : Submodule S N) =
      Submodule.span S (bc '' (↑(Jid f • (⊤ : Submodule R M)) : Set M)) := by
  rw [← JpowM_one (M := N) fun i => algebraMap R S (f i), ← JpowM_one f]
  exact (span_image_JpowM S f bc hbc 1).symm

private theorem isBaseChange_barMap (hbc : IsBaseChange S bc) : IsBaseChange S (barMap S f bc) :=
  isBaseChange_of_quotient hbc _ _ (Jid_smul_top_eq_span S f bc hbc) (barMap S f bc) (fun _ => rfl)

private theorem isBaseChange_srcMap (hbc : IsBaseChange S bc) :
    IsBaseChange S (srcMap S f bc) := by
  refine
    (IsBaseChange.iff_of_equiv_comm ((srcFinsuppEquiv M f).restrictScalars R).symm
          ((srcFinsuppEquiv N (fun i => algebraMap R S (f i))).restrictScalars S).symm ?_).1
      (IsBaseChange.finsuppPow _ (isBaseChange_barMap S f bc hbc))
  refine LinearMap.ext fun y => ?_
  simp only [srcMap, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.restrictScalars_symm_apply, LinearEquiv.restrictScalars_apply,
    LinearEquiv.apply_symm_apply]

private theorem isBaseChange_JpowMRestrict [Module.Flat R S] (hbc : IsBaseChange S bc) (n : ℕ) :
    IsBaseChange S (JpowMRestrict S f bc n) :=
  isBaseChange_of_submodule hbc _ _ (span_image_JpowM S f bc hbc n).symm (JpowMRestrict S f bc n)
    (fun _ => rfl)

private theorem isBaseChange_tgtMapComp [Module.Flat R S] (hbc : IsBaseChange S bc) (n : ℕ) :
    IsBaseChange S (tgtMapComp S f bc n) := by
  refine
    isBaseChange_of_quotient (isBaseChange_JpowMRestrict S f bc hbc n) (Tsub M f n)
      (Tsub N (fun i => algebraMap R S (f i)) n) ?_ (tgtMapComp S f bc n) (fun _ => rfl)
  simp only [Tsub_eq_smul_top]
  exact Jid_smul_top_eq_span S f (JpowMRestrict S f bc n) (isBaseChange_JpowMRestrict S f bc hbc n)

private theorem isBaseChange_tgtMap [Module.Flat R S] (hbc : IsBaseChange S bc) :
    IsBaseChange S (tgtMap S f bc) :=
  IsBaseChange.directSum fun n => isBaseChange_tgtMapComp S f bc hbc n

/-- **Quasi-regularity passes to a flat base change.** If the canonical map of `f` on `M` is
bijective then so is the canonical map of the image sequence on the base change `N`. -/
private theorem bijective_of_isBaseChange [Module.Flat R S] (hbc : IsBaseChange S bc)
    (h : Function.Bijective (quasiRegularCanonicalMap (M := M) f)) :
    Function.Bijective (quasiRegularCanonicalMap (M := N) (fun i => algebraMap R S (f i))) :=
  ⟨injective_of_isBaseChange_square (isBaseChange_srcMap S f bc hbc)
      (isBaseChange_tgtMap S f bc hbc) (φ :=
      (quasiRegularCanonicalMap (M := M) f).restrictScalars R) h.1
      ((quasiRegularCanonicalMap (M := N) (fun i => algebraMap R S (f i))).restrictScalars S)
      (quasiRegularCanonicalMap_srcMap S f bc),
    quasiRegularCanonicalMap_surjective _⟩

end Comparison

/-- **Stacks 065L.** Let `R → S` be a flat ring map, `M` an `R`-module and `rs = f_1, …, f_r` an
`M`-quasi-regular sequence in `R`. If `f : M →ₗ[R] N` exhibits the `S`-module `N` as the base
change of `M`, then the images of `f_1, …, f_r` in `S` form an `N`-quasi-regular sequence. -/
public theorem solution {R S M N : Type*} [CommRing R] [CommRing S] [Algebra R S] [AddCommGroup M]
    [Module R M] [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N] [Module.Flat R S]
    {f : M →ₗ[R] N} (hf : IsBaseChange S f) {rs : List R} (reg : IsQuasiRegular M rs) :
    IsQuasiRegular N (rs.map (algebraMap R S)) :=
  (isQuasiRegular_map_iff rs S N).2
    (bijective_of_isBaseChange S (fun i : Fin rs.length => rs[i]) f hf reg)

end Stacks.QuasiregularSequence.FlatBaseChange

end

/-!
# Quasi-regular sequences are stable under flat base change

Let `R → R'` be a flat ring map, let `M` be an `R`-module and let `f_1, …, f_r ∈ R` be an
`M`-quasi-regular sequence, i.e. one for which the canonical map of graded
`(R/J)[X_1, …, X_r]`-modules
`Φ_M : (R/J)[X_1, …, X_r] ⊗_{R/J} (M/JM) → ⨁_{n ≥ 0} JⁿM/J^{n+1}M`, `J = (f_1, …, f_r)`, is an
isomorphism. Then the images of `f_1, …, f_r` in `R'` form an `M ⊗_R R'`-quasi-regular sequence.

The reason is that flatness makes the whole construction commute with `- ⊗_R R'`: the sequences
`0 → JⁿM → M` and `0 → J^{n+1}M → JⁿM → JⁿM/J^{n+1}M → 0` stay exact after tensoring with `R'`,
which gives first `JⁿM ⊗_R R' = (J')ⁿM'` and then `(J')ⁿM'/(J')^{n+1}M' = (JⁿM/J^{n+1}M) ⊗_R R'`,
for `J' = JR'` and `M' = M ⊗_R R'`. So the canonical map for the image sequence is `Φ_M ⊗ id_{R'}`,
an isomorphism because `Φ_M` is one.

## Main results

* `RingTheory.Sequence.IsQuasiRegular.of_flat_of_isBaseChange`: an `M`-quasi-regular sequence in
  `R` stays quasi-regular for the base change of `M` along a flat ring map `R → S`.

## Implementation notes

The base change is taken abstractly, through `IsBaseChange S f` for an `R`-linear `f : M →ₗ[R] N`
into an `S`-module `N`, exactly as in the regular-sequence siblings
`RingTheory.Sequence.IsWeaklyRegular.of_flat_of_isBaseChange` and
`RingTheory.Sequence.IsRegular.of_faithfullyFlat_of_isBaseChange`, whose name this one mutates.
This is the source's statement, not a generalization of it: the source's `M ⊗_R R'` is the instance
`N = S ⊗[R] M` with `f = TensorProduct.mk R S M 1` (`TensorProduct.isBaseChange`), and any other
`N` satisfying `IsBaseChange S f` is `S`-linearly isomorphic to that one. Phrasing it this way is
what spares a user of the localization `S = R_g`, or of a completion, the transport along that
isomorphism. Note that the literal `M ⊗[R] S` is not available here: Mathlib puts the `S`-module
structure on the *left* tensor factor, so `M ⊗[R] S` carries no `Module S` instance at all.

Faithfulness. (1) Every hypothesis is used: `Module.Flat R S` is what makes the filtration
`JⁿM` and its quotients commute with the base change (dropped, the conclusion fails already for
a surjection `R → R/I`), `hf` is what makes `N` the base change rather than an arbitrary
`S`-module, `IsScalarTower R S N` is what makes the `S`-action on `N` the one extending the
`R`-action, and `reg` is the source's hypothesis. (2) The scalars are the source's on both sides:
the hypothesis is quasi-regularity of `rs : List R` on the `R`-module `M`, the conclusion that of
the image sequence `rs.map (algebraMap R S) : List S` on the `S`-module `N` — the target
statement is about `S`-modules, not about `R`-modules. (3) The canonical map is pinned, not merely
asserted to exist: `IsQuasiRegular` is bijectivity of the named `quasiRegularCanonicalMap` of tag
061N, and the base change is pinned by `IsBaseChange S f` for the named `f`. (4) The
instantiation is not degenerate: for `R = k[x_1, …, x_r]`, `M = R`, `rs = [x_1, …, x_r]` and the
free, hence flat, extension `S = R[y]`, the hypothesis holds and the conclusion says that
`x_1, …, x_r` is a quasi-regular sequence in `k[x_1, …, x_r, y]`.

The sequence is a `List R`, as in `RingTheory.Sequence.IsQuasiRegular`, and the source's "images of
`f_1, …, f_r` in `R'`" is `rs.map (algebraMap R S)`, the image sequence in the same order.

## References

* [StacksProject 065L](https://stacks.math.columbia.edu/tag/065L), Lemma 10.69.5.
-/

@[expose] public section

namespace RingTheory.Sequence

/-- **Stacks 065L.** Let `R → S` be a flat ring map, `M` an `R`-module and `rs = f_1, …, f_r` an
`M`-quasi-regular sequence in `R`. Then the images of `f_1, …, f_r` in `S` form a
`M ⊗_R S`-quasi-regular sequence, where the base change is taken abstractly: `N` is any
`S`-module receiving an `R`-linear `f : M →ₗ[R] N` that exhibits it as the base change of `M`. -/
@[stacks 065L]
public theorem IsQuasiRegular.of_flat_of_isBaseChange {R S M N : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
    [IsScalarTower R S N] [Module.Flat R S] {f : M →ₗ[R] N} (hf : IsBaseChange S f) {rs : List R}
    (reg : IsQuasiRegular M rs) : IsQuasiRegular N (rs.map (algebraMap R S)) :=
  Stacks.QuasiregularSequence.FlatBaseChange.solution (f := f) (M := M) hf reg

end RingTheory.Sequence

end

/-!
# A quasi-regular sequence in the maximal ideal of a local Noetherian ring is regular

Let `(R, 𝔪)` be a local Noetherian ring, `M` a nonzero finite `R`-module and `f_0, …, f_{c-1} ∈ 𝔪`
an `M`-quasi-regular sequence, with `J = (f_0, …, f_{c-1})`. This file proves Stacks 061S: the
sequence is `M`-regular.

Over a local ring a sequence of elements of `𝔪` is regular as soon as it is weakly regular
(`IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal`, the nonvanishing clause of
regularity being Nakayama), and weak regularity is the statement that `f_i` is a nonzerodivisor on
`M/(f_0, …, f_{i-1})M` for every `i`. Quasi-regularity descends to `R/(f_0, …, f_{i-1})` and
`M/(f_0, …, f_{i-1})M` by Lemma 061R, so the whole lemma follows from the single assertion that
**a member of a quasi-regular sequence is a nonzerodivisor as soon as the `J`-adic filtration of
`M` is separated**: if `x ≠ 0`, Krull's intersection theorem gives an `r` with `x ∈ J^rM` and
`x ∉ J^{r+1}M`, while `f_jx = 0 ∈ J^{r+2}M` puts `x` back into `J^{r+1}M`.

That last implication, `mem_JpowM_succ_of_smul_mem`, is the analytic content of the lemma:
multiplication by a member of a quasi-regular sequence does not raise the `J`-adic order. It holds
because `⨁_n J^nM/J^{n+1}M` is the polynomial module `(M/JM)[X_0, …, X_{c-1}]`: writing
`x = ∑_{|e| = r} f^e m_e`, the relation `f_jx ∈ J^{r+2}M` reads as a relation of degree `r + 1`
among the monomials `f^{e + δ_j}`, which are pairwise distinct for distinct `e`, so every `m_e`
lies in `JM` and therefore `x ∈ J^{r+1}M`. Krull's intersection theorem is where Noetherianity of
`R` and finiteness of `M` are used, and it applies over `R/(f_0, …, f_{i-1})` because that ring is
again local Noetherian and `M/(f_0, …, f_{i-1})M` is again finite over it.

## Main results

* `Stacks.QuasiregularSequence.LocalRegularity.solution`: the statement of
  `RingTheory.Sequence.IsRegular.of_isQuasiRegular_of_mem_maximalIdeal`, Lemma 061S.

## Implementation notes

The source proves that `f_0` is a nonzerodivisor on `M` and then inducts on `c` using Lemma
061R at `i = 1`. Since 061R is available for an arbitrary `i`, the induction is replaced here by
one application of 061R for each `i`, which is the same argument with the recursion unrolled: no
transport of quasi-regularity along the iterated quotient isomorphisms
`(R/(f_0))/(f̄_1, …, f̄_{i-1}) ≅ R/(f_0, …, f_{i-1})` is then needed. The nonzerodivisor statement
is proved for an arbitrary member `f_j` of the sequence rather than for `f_0` only: the proof is
the same, since the multi-indices `e + δ_j` are distinct for distinct `e`, and it makes visible
that quasi-regularity is order-independent while regularity in the given order is what is
concluded.

The graded objects are never formed as such: membership in the submodules `JpowM M f n` of `M`
replaces the computation with `⨁_n J^nM/J^{n+1}M`, and `degLift` names the map
`J^nM → ⨁_k J^kM/J^{k+1}M` that reads a single degree into the target. The passage from
injectivity of the canonical map of tag 061N to the degreewise relation condition
("`∑_{|e| = n} f^e m_e ∈ J^{n+1}M` forces `m_e ∈ JM`") is `sum_filter_mem_of_injective`, proved by
identifying the source `R̄[X_0, …, X_{c-1}] ⊗_{R̄} M̄` with the free `M̄`-module on multi-indices
(`srcFinsuppEquiv`). Its converse `sum_fpow_smul_mem_JpowM_succ` needs no injectivity: it only
groups a monomial expansion by fibres and cancels `J^n · J = J^{n+1}`.

## References

* [StacksProject 061S](https://stacks.math.columbia.edu/tag/061S), Lemma 10.69.6.
-/

@[expose] public section

namespace Stacks.QuasiregularSequence.LocalRegularity

open RingTheory.Sequence

section Bridge

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {c : ℕ}

end Bridge

section Order

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {c : ℕ}

/-- `J^0M = M`. -/
private theorem JpowM_zero (f : Fin c → R) : JpowM M f 0 = ⊤ := by simp [JpowM]

/-- **Monomial expansion of an element of `J^nM`.** Every `x ∈ J^nM` is a finite sum
`∑_t f^{d t} · m_t` of monomial multiples with all `|d t| = n`. -/
private theorem exists_sum_fpow_smul_eq_of_mem_JpowM {f : Fin c → R} {n : ℕ} {x : M}
    (hx : x ∈ JpowM M f n) :
    ∃ (k : ℕ) (d : Fin k → (Fin c →₀ ℕ)) (m : Fin k → M),
      (∀ t, qrMdeg (d t) = n) ∧ x = ∑ t, fpow f (d t) • m t := by
  classical
  rw [JpowM_eq_span] at hx
  obtain ⟨k, a, g, hgsum⟩ := Submodule.mem_span_set'.mp hx
  choose d mm hd hgd using fun t : Fin k => (g t).2
  refine ⟨k, d, fun t => a t • mm t, hd, ?_⟩
  rw [← hgsum]
  exact Finset.sum_congr rfl fun t _ => by rw [hgd t, smul_comm]

/-- **The converse of the degreewise relation condition, which needs no quasi-regularity.**
A degree-`n` monomial expansion all of whose fibre sums lie in `JM` lies in `J^{n+1}M`: group the
expansion by the fibres of `d` and cancel `J^n · J = J^{n+1}`. -/
private theorem sum_fpow_smul_mem_JpowM_succ {f : Fin c → R} {ι : Type*} (S : Finset ι)
    (d : ι → (Fin c →₀ ℕ)) (m : ι → M) (n : ℕ) (hdeg : ∀ t ∈ S, qrMdeg (d t) = n)
    (hfib : ∀ e, (∑ t ∈ S with d t = e, m t) ∈ Jid f • (⊤ : Submodule R M)) :
    (∑ t ∈ S, fpow f (d t) • m t) ∈ JpowM M f (n + 1) := by
  classical
  have heq : (Jid f ^ n) • (Jid f • (⊤ : Submodule R M)) = JpowM M f (n + 1) := by
    rw [JpowM, ← Submodule.smul_assoc, Ideal.smul_eq_mul, pow_succ]
  rw [←
    Finset.sum_fiberwise_of_maps_to (fun t ht => Finset.mem_image_of_mem d ht)
      (fun t => fpow f (d t) • m t),
    ← heq]
  refine Submodule.sum_mem _ fun e he => ?_
  obtain ⟨t₀, ht₀S, ht₀⟩ := Finset.mem_image.mp he
  have hqe : qrMdeg e = n := by
    rw [← ht₀]; exact hdeg t₀ ht₀S
  have hinner :
    (∑ t ∈ S with d t = e, fpow f (d t) • m t) = fpow f e • ∑ t ∈ S with d t = e, m t := by
    rw [Finset.smul_sum]
    exact Finset.sum_congr rfl fun t ht => by rw [(Finset.mem_filter.mp ht).2]
  rw [hinner]
  exact Submodule.smul_mem_smul (hqe ▸ fpow_mem f e) (hfib e)

/-- **Multiplication by a member of a quasi-regular sequence does not raise the `J`-adic order.**
If the canonical map of tag 061N is injective — that is, if `f_0, …, f_{c-1}` is `M`-quasi-regular
— then `f_jx ∈ J^{n+2}M` and `x ∈ J^nM` together force `x ∈ J^{n+1}M`.

This is the analytic heart of Lemma 061S. Expand `x = ∑_t f^{d t} · m_t` in degree `n`; then
`f_jx = ∑_t f^{d t + δ_j} · m_t` is an expansion in degree `n + 1` lying in `J^{n+2}M`, so the
degreewise relation condition puts each fibre sum of the `m_t` into `JM` — the fibres of
`t ↦ d t + δ_j` being those of `t ↦ d t`, translation by `δ_j` being injective — and that is
exactly what puts `x` into `J^{n+1}M`. -/
private theorem mem_JpowM_succ_of_smul_mem {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := M) f)) (j : Fin c) {n : ℕ} {x : M}
    (hx : x ∈ JpowM M f n) (hfx : f j • x ∈ JpowM M f (n + 2)) : x ∈ JpowM M f (n + 1) := by
  classical
  obtain ⟨k, d, m, hd, hxsum⟩ := exists_sum_fpow_smul_eq_of_mem_JpowM hx
  set d' : Fin k → (Fin c →₀ ℕ) := fun t => d t + Finsupp.single j 1 with hd'
  have hshift : (∑ t, fpow f (d' t) • m t) = f j • x := by
    rw [hxsum, Finset.smul_sum]
    exact Finset.sum_congr rfl fun t _ => by rw [hd', fpow_add_single, mul_smul]
  have hrel : (∑ t, fpow f (d' t) • m t) ∈ JpowM M f (n + 1 + 1) := by
    rw [hshift]; exact hfx
  rw [hxsum]
  refine sum_fpow_smul_mem_JpowM_succ _ d m n (fun t _ => hd t) fun e => ?_
  have h :=
    sum_filter_mem_of_injective hinj (n + 1) Finset.univ d' m
      (fun t _ => by rw [hd', qrMdeg_addSingle, hd t]) hrel (e + Finsupp.single j 1)
  have hfilt :
    (Finset.univ.filter fun t => d' t = e + Finsupp.single j 1) =
      Finset.univ.filter fun t => d t = e :=
    Finset.filter_congr fun t _ => by simp [hd']
  rwa [hfilt] at h

/-- If the `J`-adic filtration of `M` is separated, every nonzero `x ∈ M` has a well-defined
order: an `r` with `x ∈ J^rM` and `x ∉ J^{r+1}M`. -/
private theorem exists_mem_notMem_of_iInf_eq_bot {f : Fin c → R}
    (hbot : (⨅ n : ℕ, JpowM M f n) = ⊥) {x : M} (hx : x ≠ 0) :
    ∃ r : ℕ, x ∈ JpowM M f r ∧ x ∉ JpowM M f (r + 1) := by
  by_contra hall
  simp only [not_exists, not_and, not_not] at hall
  have hmem : ∀ n : ℕ, x ∈ JpowM M f n := by
    intro n
    induction n with
    | zero =>
      rw [JpowM_zero]; exact Submodule.mem_top
    | succ n ih => exact hall n ih
  exact hx (by simpa [hbot] using Submodule.mem_iInf (fun n => JpowM M f n) |>.mpr hmem)

/-- **A member of a quasi-regular sequence with separated filtration is a nonzerodivisor.**
A nonzero `x` killed by `f_j` has an order `r`, and `f_jx = 0 ∈ J^{r+2}M` puts `x` back into
`J^{r+1}M` by `mem_JpowM_succ_of_smul_mem`, contradicting the choice of `r`. -/
private theorem isSMulRegular_of_injective_of_iInf_eq_bot {f : Fin c → R}
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := M) f))
    (hbot : (⨅ n : ℕ, JpowM M f n) = ⊥) (j : Fin c) : IsSMulRegular M (f j) :=
  isSMulRegular_iff_right_eq_zero_of_smul.mpr fun x hfx => by
    by_contra hx
    obtain ⟨r, hr, hr'⟩ := exists_mem_notMem_of_iInf_eq_bot hbot hx
    exact
      hr'
        (mem_JpowM_succ_of_smul_mem hinj j hr
          (by
            rw [hfx]; exact Submodule.zero_mem _))

end Order

section Main

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- A sequence of nonunits of a local ring generates a proper ideal. -/
private theorem Jid_ne_top [IsLocalRing R] {c : ℕ} {f : Fin c → R}
    (hf : ∀ j, f j ∈ IsLocalRing.maximalIdeal R) : Jid f ≠ ⊤ := fun htop =>
  (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    (top_le_iff.mp (htop.ge.trans (Ideal.span_le.mpr (Set.range_subset_iff.mpr hf))))

/-- **A member of a quasi-regular sequence of nonunits of a local Noetherian ring is a
nonzerodivisor.** Over a local Noetherian ring `S` and for a finite `S`-module `N`, Krull's
intersection theorem separates the `J`-adic filtration of `N` as soon as `J ≠ S`, so
`isSMulRegular_of_injective_of_iInf_eq_bot` applies. -/
@[ega "0 15.1.2" "converse"]
private theorem isSMulRegular_of_isQuasiRegular_of_ne_top {S : Type*} [CommRing S] [IsLocalRing S]
    [IsNoetherianRing S] {N : Type*} [AddCommGroup N] [Module S N] [Module.Finite S N] {c : ℕ}
    (f : Fin c → S) (hinj : Function.Injective (quasiRegularCanonicalMap (M := N) f))
    (hne : Jid f ≠ ⊤) (j : Fin c) : IsSMulRegular N (f j) :=
  isSMulRegular_of_injective_of_iInf_eq_bot hinj
    (Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (Jid f) hne) j

/-- **The inductive step of Lemma 061S.** Let `(R, 𝔪)` be a local Noetherian ring, `M` a finite
`R`-module, `K ⊆ 𝔪` an ideal and `l` a list of elements of `𝔪` whose image in `R/K` is an
`M/KM`-quasi-regular sequence. Then every member of `l` is a nonzerodivisor on `M/KM`.

The point is that `R/K` is again local Noetherian and `M/KM` is again finite over it, so the
previous lemma applies to the image of the sequence, which consists of nonunits because
`K ⊆ 𝔪` makes `R → R/K` a local homomorphism. -/
private theorem isSMulRegular_quotient_of_isQuasiRegular [IsLocalRing R] [IsNoetherianRing R]
    [Module.Finite R M] (K : Ideal R) (hK : K ≤ IsLocalRing.maximalIdeal R) {l : List R}
    (hl : ∀ r ∈ l, r ∈ IsLocalRing.maximalIdeal R)
    (reg : IsQuasiRegular (M ⧸ (K • ⊤ : Submodule R M)) (l.map (Ideal.Quotient.mk K))) (i : ℕ)
    (hi : i < l.length) : IsSMulRegular (M ⧸ (K • ⊤ : Submodule R M)) l[i] := by
  have hKne : K ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h.ge.trans hK))
  have : Nontrivial (R ⧸ K) := Submodule.Quotient.nontrivial_iff.mpr hKne
  have : IsLocalRing (R ⧸ K) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have : IsLocalHom (Ideal.Quotient.mk K) :=
    isLocalHom_of_le_jacobson_bot K
      (hK.trans (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge)
  have : Module.Finite (R ⧸ K) (M ⧸ (K • ⊤ : Submodule R M)) :=
    Module.Finite.of_restrictScalars_finite R (R ⧸ K) _
  have hreg :=
    isSMulRegular_of_isQuasiRegular_of_ne_top
      (fun j : Fin (l.map (Ideal.Quotient.mk K)).length => (l.map (Ideal.Quotient.mk K))[(j : ℕ)])
      reg.injective
      (Jid_ne_top fun j => by
        rw [List.getElem_map]
        exact map_nonunit _ _ (hl _ (List.getElem_mem _)))
      ⟨i, by simpa using hi⟩
  rw [List.getElem_map] at hreg
  exact (isSMulRegular_algebraMap_iff (R ⧸ K)).mp hreg

end Main

/-- **Stacks 061S.** Let `(R, 𝔪)` be a local Noetherian ring and let `M` be a nonzero finite
`R`-module. An `M`-quasi-regular sequence `f_1, …, f_c` of elements of `𝔪` is an `M`-regular
sequence. -/
@[ega "0 15.1.10" "sufficiency",
  ega "0 15.1.11" "Direction",
  ega "0 15.1.3" "partial",
  ega "0 15.1.9" "converse, special case",
  ega "0 15.2.2" "special case",
  ega "IV 19.5.1" "special case"]
public theorem solution {R M : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Nontrivial M] [Module.Finite R M] {rs : List R}
    (mem : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R) (reg : IsQuasiRegular M rs) :
    IsRegular M rs := by
  rw [IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal mem,
    isWeaklyRegular_iff_Fin]
  intro i
  simpa using
    isSMulRegular_quotient_of_isQuasiRegular (Ideal.ofList (rs.take (i : ℕ)))
      (Ideal.span_le.mpr fun x hx => mem x (List.mem_of_mem_take hx))
      (fun r hr => mem r (List.mem_of_mem_drop hr)) (reg.quasiRegular_drop_mod_prev (i : ℕ)) 0
      (by simp [i.isLt])

end Stacks.QuasiregularSequence.LocalRegularity

end

/-!
# A quasi-regular sequence in the maximal ideal of a local Noetherian ring is regular

Let `(R, 𝔪)` be a local Noetherian ring, let `M` be a nonzero finite `R`-module and let
`f_1, …, f_c ∈ 𝔪` be an `M`-quasi-regular sequence, i.e. one for which the canonical map of
graded `(R/J)[X_1, …, X_c]`-modules
`Φ_M : (R/J)[X_1, …, X_c] ⊗_{R/J} (M/JM) → ⨁_{n ≥ 0} JⁿM/J^{n+1}M`, `J = (f_1, …, f_c)`, is an
isomorphism. Then `f_1, …, f_c` is an `M`-regular sequence: each `f_i` is a nonzerodivisor on
`M/(f_1, …, f_{i-1})M`, and `M/JM ≠ 0`.

The two hypotheses that go beyond quasi-regularity are both essential, and both enter through
`f_1`. That `f_1` is a nonzerodivisor on `M` is seen as follows: a nonzero `x ∈ M` lies in `JʳM`
but not in `J^{r+1}M` for some `r`, by Krull's intersection theorem — which is where Noetherianity
and finiteness of `M` are used — and then the class of `f_1x` in `J^{r+1}M/J^{r+2}M` is nonzero
because `⨁ JⁿM/J^{n+1}M` is the polynomial module `(M/JM)[X_1, …, X_c]`, so `f_1x ≠ 0`. Induction
on `c`, using that quasi-regularity descends to `R/(f_1)` and `M/f_1M`, gives the remaining
elements. Nonvanishing of `M/JM` is Nakayama, the sequence lying in `𝔪`. Without Noetherianity
the implication fails: there are non-Noetherian local rings in which a sequence generating the
maximal ideal is quasi-regular but not regular.

## Main results

* `RingTheory.Sequence.IsRegular.of_isQuasiRegular_of_mem_maximalIdeal`: over a local Noetherian
  ring, an `M`-quasi-regular sequence contained in the maximal ideal is `M`-regular, for `M` a
  nonzero finite module.

## Implementation notes

Faithfulness. (1) No dead hypothesis: quasi-regularity `reg` and the membership `mem` are both
needed for the conclusion — `mem` and `[Nontrivial M]`, `[Module.Finite R M]` for the clause
`M/JM ≠ 0` of `IsRegular`, and `reg` together with `[IsNoetherianRing R]` and the same finiteness
for the nonzerodivisor clauses; the source's `(R, 𝔪)` local Noetherian is `[IsLocalRing R]` and
`[IsNoetherianRing R]`, and its "nonzero finite `R`-module" is `[Nontrivial M]` and
`[Module.Finite R M]`. (2) The scalars and base are the source's: both regularity notions are for
the sequence `rs : List R` acting on the `R`-module `M`, over the local ring `R` itself, with no
localization or base change; the ideal `J = (f_1, …, f_c)` is the ideal of `R` generated by the
list. (3) The canonical map is pinned: `IsQuasiRegular` is bijectivity of the *named* map
`quasiRegularCanonicalMap` of tag 061N, not the existence of some isomorphism between the two
graded modules, and the conclusion `IsRegular M rs` is Mathlib's spelling of Definition 10.68.1 —
weak regularity of the sequence in the given order together with `⊤ ≠ (rs) • ⊤` — so it carries
the source's nonvanishing clause rather than dropping it. (4) The instantiation is not degenerate:
for `R = k[X_1, …, X_c]` localized at `(X_1, …, X_c)`, `M = R` and `rs = [X_1, …, X_c]` all the
hypotheses hold, and the conclusion is that `X_1, …, X_c` is a regular sequence there.

The name mutates Mathlib's `RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal`,
which concludes `IsRegular M rs` from the same membership hypothesis and *weak* regularity; here
weak regularity is replaced by quasi-regularity, at the price of the two extra hypotheses on `R`
and `M`. Composing the two directions, this statement upgrades
`IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal` from an equivalence between
regular and weakly regular sequences to an implication from the a priori weaker quasi-regularity.

The order of the elements matters for `IsRegular`, whereas quasi-regularity of `f_1, …, f_c`
depends only on the ideal `J` and the multiset of the `f_i`, permuting the sequence permuting the
variables `X_i`. So this statement, combined with that order-independence, gives that every
reordering of a quasi-regular sequence in `𝔪` is again `M`-regular; the order-independence
itself is a property of `IsQuasiRegular` and is not stated here.

## References

* [StacksProject 061S](https://stacks.math.columbia.edu/tag/061S), Lemma 10.69.6.
* [StacksProject 061T](https://stacks.math.columbia.edu/tag/061T), Remark 10.69.7, for the
  non-Noetherian local examples of Kabele showing that the Noetherian hypothesis cannot be
  dropped.
-/

@[expose] public section

namespace RingTheory.Sequence

/-- **Stacks 061S.** Let `(R, 𝔪)` be a local Noetherian ring and let `M` be a nonzero finite
`R`-module. An `M`-quasi-regular sequence `f_1, …, f_c` of elements of `𝔪` is an `M`-regular
sequence. -/
@[stacks 061S,
  ega "0 15.1.9" "converse, local",
  ega "0 15.1.11" "converse, local case",
  ega "0 15.2.2" "converse: q-reg ⇒ reg",
  ega "IV 16.9.11" "local Noetherian ring",
  ega "0 15.1.10" "sufficiency",
  ega "0 15.1.3" "partial",
  ega "IV 16.9.12" "parenthetical",
  ega "IV 19.5.1" "special case"]
public theorem IsRegular.of_isQuasiRegular_of_mem_maximalIdeal {R M : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] [AddCommGroup M] [Module R M] [Nontrivial M]
    [Module.Finite R M] {rs : List R} (mem : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R)
    (reg : IsQuasiRegular M rs) : IsRegular M rs :=
  Stacks.QuasiregularSequence.LocalRegularity.solution (R := R) mem reg

end RingTheory.Sequence

end
