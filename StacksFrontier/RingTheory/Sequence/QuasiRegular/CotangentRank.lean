module

public import StacksFrontier.RingTheory.Sequence.QuasiRegular.GradedBasis

/-!
# The rank of the conormal module of a quasi-regular ideal

Let `φ : R ⟶ S` be a surjection of commutative rings onto a nonzero ring whose kernel `I` is
generated by a quasi-regular sequence of length `c`. Then the conormal module `I/I²`, an `S`-module
through `S ≅ R/I`, is free of rank `c`; in particular `c` is the rank of any basis of `I/I²` over
`S`.

## Main results

* `Stacks.RingTheory.QuasiRegular.kerGradedPresentation`: `I/I²` presented as the degree-one
  piece of the associated graded ring of `I`.
* `Stacks.RingTheory.QuasiRegular.eq_of_basis_cotangent_ker`: the length of a quasi-regular
  generating sequence of `I` is the rank of `I/I²` over `S`.
-/

@[expose] public section

namespace Stacks.RingTheory.QuasiRegular

variable {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (hφ : Function.Surjective φ)

/-- The conormal module of the kernel of a surjection onto `S`, as an `S`-module through the
identification of `S` with the quotient by the kernel. -/
noncomputable abbrev cotangentKerModule : Module S (RingHom.ker φ).Cotangent :=
  Module.compHom (RingHom.ker φ).Cotangent
    (RingHom.quotientKerEquivOfSurjective hφ).symm.toRingHom

/-- An element of the first power of the kernel lies in the kernel. -/
theorem mem_ker_of_mem_pow_one (x : ↥(RingHom.ker φ ^ 1)) : (x : R) ∈ RingHom.ker φ := by
  simpa using x.2

/-- The class in the conormal module of a section of the first power of the kernel. -/
noncomputable def kerCotangentHom : ↥(RingHom.ker φ ^ 1) →ₗ[R] (RingHom.ker φ).Cotangent :=
  (RingHom.ker φ).toCotangent ∘ₗ Submodule.inclusion (le_of_eq (pow_one (RingHom.ker φ)))

/-- The map `kerCotangentHom` is semilinear along `φ`: it carries `r • x` to `φ r` times the image
of `x`. -/
theorem kerCotangentHom_smul (r : R) (x : ↥(RingHom.ker φ ^ 1)) :
    letI := cotangentKerModule φ hφ
    kerCotangentHom φ (r • x) = φ r • kerCotangentHom φ x := by
  let := cotangentKerModule φ hφ
  have h : (RingHom.quotientKerEquivOfSurjective hφ).symm (φ r) =
      algebraMap R (R ⧸ RingHom.ker φ) r := by
    rw [RingEquiv.symm_apply_eq]
    rfl
  rw [LinearMap.map_smul]
  show _ = (RingHom.quotientKerEquivOfSurjective hφ).symm (φ r) •
    (kerCotangentHom φ x : (RingHom.ker φ).Cotangent)
  rw [h, algebraMap_smul]

/-- The map `kerCotangentHom` is surjective. -/
theorem kerCotangentHom_surjective : Function.Surjective (kerCotangentHom φ) := fun y =>
  let ⟨x, hx⟩ := (RingHom.ker φ).toCotangent_surjective y
  ⟨⟨x, (pow_one (RingHom.ker φ)).symm ▸ x.2⟩, hx⟩

/-- An element of the first power of the kernel has zero class in the conormal module if and only
if it lies in the square of the kernel. -/
theorem kerCotangentHom_eq_zero_iff (x : ↥(RingHom.ker φ ^ 1)) :
    kerCotangentHom φ x = 0 ↔ (x : R) ∈ RingHom.ker φ ^ (1 + 1) := by
  rw [one_add_one_eq_two]
  exact Ideal.toCotangent_eq_zero (RingHom.ker φ) _

/-- **The conormal module of the kernel, presented as the degree-one piece of the associated
graded ring of the kernel.** -/
noncomputable def kerGradedPresentation {c : ℕ} (f : Fin c → R)
    (hspan : RingHom.ker φ = Ideal.span (Set.range f)) :
    letI := cotangentKerModule φ hφ
    GradedPresentation R S c 1 (RingHom.ker φ).Cotangent :=
  letI := cotangentKerModule φ hφ
  { f := f
    ψ := φ
    surjective_ψ := hφ
    J := RingHom.ker φ
    span_J := hspan
    ker_ψ := rfl
    g := (kerCotangentHom φ).toAddMonoidHom
    smul_g := kerCotangentHom_smul φ hφ
    surjective_g := kerCotangentHom_surjective φ
    ker_g := kerCotangentHom_eq_zero_iff φ }

/-- **The length of a quasi-regular generating sequence of the kernel of a surjection onto a
nonzero ring is the rank of the conormal module of the kernel.** -/
theorem eq_of_basis_cotangent_ker [Nontrivial S] {c m : ℕ} (f : Fin c → R)
    (hspan : RingHom.ker φ = Ideal.span (Set.range f))
    (hqr : _root_.RingTheory.Sequence.IsQuasiRegular R (List.ofFn f))
    (b : letI := cotangentKerModule φ hφ; Module.Basis (Fin m) S (RingHom.ker φ).Cotangent) :
    c = m := by
  let := cotangentKerModule φ hφ
  have h := (Module.finrank_eq_card_basis
    ((kerGradedPresentation φ hφ f hspan).basisOne (by exact hqr))).symm.trans
    (Module.finrank_eq_card_basis b)
  simpa using h

end Stacks.RingTheory.QuasiRegular
