/-!
# Regularity of a sequence is unchanged by raising its members to positive powers

Let `R` be a commutative ring and let `M` be an `R`-module. For elements `f₁, …, f_r` of `R`
and integers `e₁, …, e_r > 0`, the sequence `f₁, …, f_r` is `M`-regular if and only if
`f₁ ^ e₁, …, f_r ^ e_r` is `M`-regular. The exponents may differ from one member to the next,
and the order of the members is preserved, which matters because regularity depends on it.

## Main results

* `RingTheory.Sequence.isRegular_zipWith_pow_iff`: the memberwise positive powers of a sequence
  in `R` form an `M`-regular sequence if and only if the sequence itself does.
* `Stacks.RegularSequence.PositivePowers.solution`: the same statement, proved by induction
  along the sequence.

## Implementation notes

A sequence is a `List R`, and being `M`-regular — each member a nonzerodivisor on `M` modulo the
submodule generated by the previous ones, together with `M` modulo the whole sequence being
nonzero — is `RingTheory.Sequence.IsRegular`. The sequence `f₁ ^ e₁, …, f_r ^ e_r` is
`rs.zipWith (· ^ ·) es` for a list `es` of exponents of the same length as `rs`, so the powers
are taken memberwise and in order.

The same statement with `RingTheory.Sequence.IsWeaklyRegular` in place of
`RingTheory.Sequence.IsRegular` is also true, but it is a different statement rather than a
generalization of this one: neither implies the other, since the nonzero-quotient condition
has to be transported separately.

The exponents are changed one at a time: induction along the sequence reduces everything to the
assertion that for `r` a nonzerodivisor on `M` and `e > 0` a sequence is `M ⧸ rM`-regular if and
only if it is `M ⧸ rᵉM`-regular
(`Stacks.RegularSequence.PositivePowers.isRegular_quotSMulTop_pow_iff`). Its two halves are proved
separately. Weak regularity is read off the short exact sequence
`0 → M ⧸ rM → M ⧸ rᵏ⁺¹M → M ⧸ rᵏM → 0`, whose first map is multiplication by `rᵏ`, in two ways:
the implication towards `M ⧸ rᵉM` is regularity of the middle term of a short exact sequence
(Tag 0F1T), and the implication back is regularity of the *left* term, which holds as soon as the
sequence is regular on the middle term and every sequence regular on the left term is regular on
the right term. Nonvanishing of the quotient needs only the one-element case
`rM = M ↔ rᵏM = M` (`Stacks.RegularSequence.PositivePowers.pow_smul_top_eq_top_iff`), transported
to the quotient by the remaining members of the sequence.

Both structural steps are proved here for `RingTheory.Sequence.IsWeaklyRegular` rather than for
`RingTheory.Sequence.IsRegular`, since the nonvanishing condition is transported separately and
is not available at the intermediate stages (the right-hand term of the short exact sequence
above is the zero module when `k = 0`):

* `isWeaklyRegular_of_exact` is Tag 0F1T for `IsWeaklyRegular`. The `IsRegular` form does not
  imply it, and the `IsRegular` form follows from it by right exactness.
* `isWeaklyRegular_of_exact_of_forall` transports weak regularity from the middle term of a
  short exact sequence to the left term. Its extra hypothesis — that every sequence weakly
  regular on the left term is weakly regular on the right term — is what makes the induction
  along the sequence go through: it is preserved when all three terms are replaced by their
  quotients by the leading member, because the leading member is a nonzerodivisor on the left
  term. The Stacks proof instead alternates between the two directions member by member.

The short exact sequence is used at `k = 0` as well, where its right-hand term `M ⧸ r⁰M` is the
zero module; this is what makes the induction on `k` start at `k = 0` and avoids a separate
treatment of `M ⧸ r¹M`.

## References

* [Stacks Project, Tag 07DV](https://stacks.math.columbia.edu/tag/07DV)

## Tags

regular sequence, nonzerodivisor
-/

@[expose] public section

namespace Stacks.RegularSequence.PositivePowers

open scoped Pointwise
open RingTheory.Sequence

section Helpers

variable {R : Type*} [CommRing R]
variable {M : Type*} [AddCommGroup M] [Module R M]

/-! ### Submodules of the form `rᵏM` -/

private theorem range_lsmul (a : R) :
    LinearMap.range (LinearMap.lsmul R M a) = a • (⊤ : Submodule R M) := by
  rw [LinearMap.range_eq_map, Submodule.pointwise_smul_def,
    LinearMap.lsmul_eq_distribSMulToLinearMap]

private theorem map_lsmul_pow_smul_top (r : R) (k : ℕ) :
    (r • ⊤ : Submodule R M).map (LinearMap.lsmul R M (r ^ k)) = r ^ (k + 1) • ⊤ := by
  rw [Submodule.map_pointwise_smul, ← LinearMap.range_eq_map, range_lsmul, smul_smul, ← pow_succ']

private theorem pow_smul_top_le (r : R) {m n : ℕ} (h : m ≤ n) :
    (r ^ n • ⊤ : Submodule R M) ≤ r ^ m • ⊤ := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [pow_add, mul_smul]
  exact smul_mono_right _ le_top

private theorem isWeaklyRegular_of_subsingleton [Subsingleton M] (ts : List R) :
    IsWeaklyRegular M ts :=
  ⟨fun i _ =>
    have : Subsingleton (M ⧸ (Ideal.ofList (ts.take i) • ⊤ : Submodule R M)) :=
      Submodule.Quotient.subsingleton_iff.mpr (Subsingleton.elim _ _)
    fun _ _ _ => Subsingleton.elim _ _⟩

/-! ### The short exact sequence `0 → M ⧸ rM → M ⧸ rᵏ⁺¹M → M ⧸ rᵏM → 0` -/

/-- Multiplication by `r ^ k`, viewed as a map `M ⧸ rM → M ⧸ rᵏ⁺¹M`. -/
private def lsmulPowMapQ (r : R) (k : ℕ) :
    QuotSMulTop r M →ₗ[R] QuotSMulTop (r ^ (k + 1)) M :=
  Submodule.mapQ _ _ (LinearMap.lsmul R M (r ^ k))
    (Submodule.map_le_iff_le_comap.mp (map_lsmul_pow_smul_top r k).le)

private theorem lsmulPowMapQ_injective {r : R} (hr : IsSMulRegular M r) (k : ℕ) :
    Function.Injective (lsmulPowMapQ (M := M) r k) := by
  rw [← LinearMap.ker_eq_bot, lsmulPowMapQ, Submodule.ker_mapQ, ← map_lsmul_pow_smul_top,
    Submodule.comap_map_eq, (isSMulRegular_iff_ker_lsmul_eq_bot M _).mp (hr.pow k), sup_bot_eq,
    Submodule.mkQ_map_self]

private theorem lsmulPowMapQ_exact (r : R) (k : ℕ) :
    Function.Exact (lsmulPowMapQ (M := M) r k)
      (Submodule.factor (pow_smul_top_le (M := M) r k.le_succ)) := by
  rw [LinearMap.exact_iff, Submodule.factor, Submodule.ker_mapQ, Submodule.comap_id,
    lsmulPowMapQ, Submodule.range_mapQ, range_lsmul]

/-! ### Weak regularity along a short exact sequence -/

variable {A B C : Type*} [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
  [AddCommGroup C] [Module R C]

/-- If `0 → A → B → C` is exact and `x` is a nonzerodivisor on `C`, then `A ⧸ xA → B ⧸ xB` is
injective. -/
private theorem quotSMulTop_map_injective {α : A →ₗ[R] B} {β : B →ₗ[R] C}
    (hα : Function.Injective α) (hexact : Function.Exact α β) {x : R}
    (hC : IsSMulRegular C x) : Function.Injective (QuotSMulTop.map x α) := by
  have h := QuotSMulTop.map_first_exact_on_four_term_exact_of_isSMulRegular_last
    ((LinearMap.exact_zero_iff_injective A α).mpr hα) hexact hC
  rw [map_zero] at h
  exact (LinearMap.exact_zero_iff_injective _ _).mp h

/-- **Stacks Tag 0F1T** for `RingTheory.Sequence.IsWeaklyRegular`: a sequence weakly regular on
both ends of a short exact sequence is weakly regular in the middle. -/
private theorem isWeaklyRegular_of_exact {α : A →ₗ[R] B} {β : B →ₗ[R] C}
    (hα : Function.Injective α) (hβ : Function.Surjective β) (hexact : Function.Exact α β)
    (rs : List R) (hA : IsWeaklyRegular A rs) (hC : IsWeaklyRegular C rs) :
    IsWeaklyRegular B rs := by
  induction rs generalizing A B C with
  | nil => exact IsWeaklyRegular.nil R B
  | cons x rs' ih =>
    rw [isWeaklyRegular_cons_iff] at hA hC ⊢
    exact ⟨isSMulRegular_of_range_eq_ker hα hexact.linearMap_ker_eq.symm hA.1 hC.1,
      ih (quotSMulTop_map_injective hα hexact hC.1) (QuotSMulTop.map_surjective (r := x) hβ)
        (QuotSMulTop.map_exact x hexact hβ) hA.2 hC.2⟩

/-- Weak regularity descends from the middle of a short exact sequence to its left end, provided
every sequence weakly regular on the left end is weakly regular on the right end. -/
private theorem isWeaklyRegular_of_exact_of_forall {α : A →ₗ[R] B} {β : B →ₗ[R] C}
    (hα : Function.Injective α) (hβ : Function.Surjective β) (hexact : Function.Exact α β)
    (H : ∀ ys : List R, IsWeaklyRegular A ys → IsWeaklyRegular C ys)
    (rs : List R) (hB : IsWeaklyRegular B rs) : IsWeaklyRegular A rs := by
  induction rs generalizing A B C with
  | nil => exact IsWeaklyRegular.nil R A
  | cons x rs' ih =>
    rw [isWeaklyRegular_cons_iff] at hB ⊢
    have hAx : IsSMulRegular A x := hB.1.of_injective α hα
    have hCx : IsSMulRegular C x :=
      (isWeaklyRegular_singleton_iff C x).mp (H [x] ((isWeaklyRegular_singleton_iff A x).mpr hAx))
    refine ⟨hAx, ih (quotSMulTop_map_injective hα hexact hCx)
      (QuotSMulTop.map_surjective (r := x) hβ) (QuotSMulTop.map_exact x hexact hβ)
      (fun ys hys => ?_) hB.2⟩
    exact ((isWeaklyRegular_cons_iff C x ys).mp
      (H (x :: ys) ((isWeaklyRegular_cons_iff A x ys).mpr ⟨hAx, hys⟩))).2

/-! ### Changing one exponent -/

private theorem isWeaklyRegular_quotSMulTop_pow {r : R} (hr : IsSMulRegular M r) {ts : List R}
    (h : IsWeaklyRegular (QuotSMulTop r M) ts) (k : ℕ) :
    IsWeaklyRegular (QuotSMulTop (r ^ k) M) ts := by
  induction k with
  | zero =>
    have : Subsingleton (QuotSMulTop (r ^ 0) M) :=
      Submodule.Quotient.subsingleton_iff.mpr (by simp)
    exact isWeaklyRegular_of_subsingleton ts
  | succ k ih =>
    exact isWeaklyRegular_of_exact (lsmulPowMapQ_injective hr k)
      (Submodule.factor_surjective _) (lsmulPowMapQ_exact r k) ts h ih

private theorem isWeaklyRegular_quotSMulTop_pow_iff {r : R} (hr : IsSMulRegular M r) {e : ℕ}
    (he : 0 < e) (ts : List R) :
    IsWeaklyRegular (QuotSMulTop (r ^ e) M) ts ↔ IsWeaklyRegular (QuotSMulTop r M) ts := by
  obtain ⟨k, rfl⟩ : ∃ k, e = k + 1 := ⟨e - 1, by omega⟩
  exact ⟨fun hB => isWeaklyRegular_of_exact_of_forall (lsmulPowMapQ_injective hr k)
      (Submodule.factor_surjective _) (lsmulPowMapQ_exact r k)
      (fun _ hys => isWeaklyRegular_quotSMulTop_pow hr hys k) ts hB,
    (isWeaklyRegular_quotSMulTop_pow hr · (k + 1))⟩

private theorem pow_smul_top_eq_top {r : R} (h : r • (⊤ : Submodule R M) = ⊤) (k : ℕ) :
    r ^ k • (⊤ : Submodule R M) = ⊤ := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ, mul_smul, h, ih]

private theorem pow_smul_top_eq_top_iff (r : R) {e : ℕ} (he : 0 < e) :
    r ^ e • (⊤ : Submodule R M) = ⊤ ↔ r • (⊤ : Submodule R M) = ⊤ :=
  ⟨fun h => top_le_iff.mp (h.ge.trans (by simpa using pow_smul_top_le (M := M) r he)),
    (pow_smul_top_eq_top · e)⟩

/-- The outer companion of `Submodule.top_eq_ofList_cons_smul_iff`: the quotient by the ideal
generated by `r :: ts` vanishes iff `r • ⊤` is everything in the quotient by `ts`. -/
private theorem top_eq_ofList_cons_smul_iff' (r : R) (ts : List R) :
    (⊤ : Submodule R M) = Ideal.ofList (r :: ts) • ⊤ ↔
      r • (⊤ : Submodule R (M ⧸ (Ideal.ofList ts • ⊤ : Submodule R M))) = ⊤ := by
  rw [eq_comm, ← Submodule.Quotient.subsingleton_iff,
    (Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter M r ts).toEquiv.subsingleton_congr,
    Submodule.Quotient.subsingleton_iff]

private theorem top_eq_ofList_smul_top_pow_iff (r : R) {e : ℕ} (he : 0 < e) (ts : List R) :
    (⊤ : Submodule R (QuotSMulTop (r ^ e) M)) = Ideal.ofList ts • ⊤ ↔
      (⊤ : Submodule R (QuotSMulTop r M)) = Ideal.ofList ts • ⊤ := by
  rw [← Submodule.top_eq_ofList_cons_smul_iff, ← Submodule.top_eq_ofList_cons_smul_iff,
    top_eq_ofList_cons_smul_iff', top_eq_ofList_cons_smul_iff', pow_smul_top_eq_top_iff r he]

/-- Changing one exponent: for `r` a nonzerodivisor on `M` and `e > 0`, a sequence is
`M ⧸ rᵉM`-regular if and only if it is `M ⧸ rM`-regular. -/
private theorem isRegular_quotSMulTop_pow_iff {r : R} (hr : IsSMulRegular M r) {e : ℕ}
    (he : 0 < e) (ts : List R) :
    IsRegular (QuotSMulTop (r ^ e) M) ts ↔ IsRegular (QuotSMulTop r M) ts := by
  rw [isRegular_iff, isRegular_iff]
  exact and_congr (isWeaklyRegular_quotSMulTop_pow_iff hr he ts)
    (not_congr (top_eq_ofList_smul_top_pow_iff r he ts))

end Helpers

/-- The memberwise positive powers of a sequence form an `M`-regular sequence if and only if the
sequence itself does: the exponents are changed one at a time along the sequence. -/
public theorem solution {R : Type*} [CommRing R]
    (M : Type*) [AddCommGroup M] [Module R M] {rs : List R} {es : List ℕ}
    (hlen : rs.length = es.length) (hes : ∀ e ∈ es, 0 < e) :
    IsRegular M (rs.zipWith (· ^ ·) es) ↔ IsRegular M rs := by
  induction rs generalizing M es with
  | nil => simp
  | cons r rs' ih =>
    match es with
    | [] => simp at hlen
    | e :: es' =>
      have he : 0 < e := hes e (by simp)
      rw [List.zipWith_cons_cons, isRegular_cons_iff, isRegular_cons_iff,
        IsSMulRegular.pow_iff he]
      refine and_congr_right fun hr => ?_
      exact (ih (QuotSMulTop (r ^ e) M) (by simpa using hlen)
          fun f hf => hes f (by simp [hf])).trans (isRegular_quotSMulTop_pow_iff hr he rs')

end Stacks.RegularSequence.PositivePowers

@[expose] public section

open RingTheory.Sequence

/-- **Stacks 07DV.** Let `R` be a commutative ring, let `M` be an `R`-module, let
`rs = [f₁, …, f_r]` be a list of elements of `R` and let `es = [e₁, …, e_r]` be a list of
positive integers of the same length. Then `f₁ ^ e₁, …, f_r ^ e_r` is an `M`-regular sequence
if and only if `f₁, …, f_r` is an `M`-regular sequence. -/
@[stacks 07DV, ega "0 15.1.20" "first assertion"]
public theorem RingTheory.Sequence.isRegular_zipWith_pow_iff {R : Type*} [CommRing R]
    (M : Type*) [AddCommGroup M] [Module R M] {rs : List R} {es : List ℕ}
    (hlen : rs.length = es.length) (hes : ∀ e ∈ es, 0 < e) :
    IsRegular M (rs.zipWith (· ^ ·) es) ↔ IsRegular M rs :=
  Stacks.RegularSequence.PositivePowers.solution (R := R) M hlen hes

end
