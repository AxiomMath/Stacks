module

public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.Data.List.FinRange
public import Mathlib.GroupTheory.Perm.Fin
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# Dividing a regular ideal by one of its minimal generators

Let `(S, 𝔪)` be a Noetherian local ring and let `J ⊆ S` be generated by an `S`-regular sequence
`f_0, …, f_n`. Suppose `g ∈ J` and that `J` is generated by `g` together with `n` further
elements. Then the image of `J` in `S/(g)` is generated by an `S/(g)`-regular sequence of length
`n`.

The argument is the one implicit in the proof of [Stacks, Tag 0FA9]. The relations among a
regular sequence have their coefficients in the ideal it generates (the vanishing of the first
Koszul homology; `RingTheory.Sequence.mem_ofList_of_sum_mul_eq_zero`). Hence `f_0, …, f_n` stay
linearly independent modulo `𝔪`, and `J` cannot be generated by `n` elements together with an
element of `𝔪 J`. So writing `g = ∑ w_i f_i`, some `w_l` is a unit
(`RingTheory.Sequence.exists_isUnit_coeff_of_ofList_eq_span_insert`). Then `g` together with the
`f_i`, `i ≠ l`, is a regular sequence generating `J` — permutations of regular sequences in a
Noetherian local ring are regular ([Stacks, Tag 00LJ]) — and the images of the `f_i`, `i ≠ l`, in
`S/(g)` form the required sequence.

## Main results

* `RingTheory.Sequence.mem_ofList_of_sum_mul_eq_zero` — the coefficients of a relation among the
  members of a weakly regular sequence lie in the ideal they generate.
* `RingTheory.Sequence.exists_isUnit_coeff_of_ofList_eq_span_insert` — an element `g` of `J` that
  generates `J` together with `n` further elements has a unit coefficient in every expression
  `g = ∑ w_i f_i`.
* `RingTheory.Sequence.exists_isRegular_ofList_eq_map_of_ker_eq_span_singleton` — the image of
  `J` under a surjection with kernel `(g)` is generated by a regular sequence of length `n`.

## References

* [Stacks Project, Tag 0FA9](https://stacks.math.columbia.edu/tag/0FA9)
* [Stacks Project, Tag 00LJ](https://stacks.math.columbia.edu/tag/00LJ)
-/

@[expose] public section

open Ideal IsLocalRing
open scoped Pointwise

namespace RingTheory.Sequence

variable {R : Type*} [CommRing R]

/-- The ideal generated by the list of values of a finite sequence is the span of its range. -/
theorem ofList_ofFn {m : ℕ} (f : Fin m → R) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) :=
  congrArg Ideal.span (Set.ext fun _ => List.mem_ofFn)

/-- An ideal, acting on the ring, spans itself. -/
theorem ideal_smul_top_eq (I : Ideal R) : I • (⊤ : Submodule R R) = I := by
  rw [Ideal.smul_eq_mul, Ideal.mul_top]

/-- If `x` is a nonzerodivisor on `R ⧸ I` and `x * c ∈ I`, then `c ∈ I`. -/
private theorem mem_of_mul_mem_of_isSMulRegular {I : Ideal R} {x c : R}
    (hx : IsSMulRegular (R ⧸ (I • (⊤ : Submodule R R))) x) (h : x * c ∈ I) : c ∈ I := by
  have hq : x • (Submodule.Quotient.mk c : R ⧸ (I • (⊤ : Submodule R R))) = x • 0 := by
    rwa [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      ideal_smul_top_eq, smul_eq_mul]
  simpa only [Submodule.Quotient.mk_eq_zero, ideal_smul_top_eq] using hx hq

/-- A linear combination of the members of a finite sequence lies in the ideal they span. -/
private theorem sum_mul_mem_span_range {m : ℕ} (c f : Fin m → R) :
    ∑ j, c j * f j ∈ Ideal.span (Set.range f) :=
  Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩)

/-- **The coefficients of a relation among a weakly regular sequence lie in the ideal it
generates.** If `f_0, …, f_{m-1}` is weakly regular on `R` and `∑ c_i f_i = 0`, then every `c_i`
lies in `(f_0, …, f_{m-1})`. This is the vanishing of the first Koszul homology of a regular
sequence, in the only degree needed here. -/
theorem mem_ofList_of_sum_mul_eq_zero : ∀ {m : ℕ} (f : Fin m → R),
    IsWeaklyRegular R (List.ofFn f) → ∀ (c : Fin m → R), ∑ i, c i * f i = 0 →
      ∀ i, c i ∈ Ideal.ofList (List.ofFn f)
  | 0, _, _, _, _, i => i.elim0
  | m + 1, f, hf, c, hc, i => by
    set f' : Fin m → R := fun i => f (Fin.castSucc i)
    set x : R := f (Fin.last m)
    have hlist : List.ofFn f = List.ofFn f' ++ [x] := by
      rw [List.ofFn_succ', List.concat_eq_append]
    rw [hlist] at hf ⊢
    rw [isWeaklyRegular_append_iff, isWeaklyRegular_singleton_iff] at hf
    obtain ⟨hf₁, hx₁⟩ := hf
    set I : Ideal R := Ideal.ofList (List.ofFn f') with hI
    have hsplit : ∑ j : Fin m, c (Fin.castSucc j) * f' j + c (Fin.last m) * x = 0 := by
      rw [← hc, Fin.sum_univ_castSucc]
    -- the last coefficient lies in `I`
    have hlast : c (Fin.last m) ∈ I := by
      refine mem_of_mul_mem_of_isSMulRegular (I := I) hx₁ ?_
      rw [hI, ofList_ofFn, mul_comm, eq_neg_of_add_eq_zero_right hsplit]
      exact neg_mem (sum_mul_mem_span_range _ _)
    have hle : I ≤ Ideal.ofList (List.ofFn f' ++ [x]) := by
      rw [Ideal.ofList_append]
      exact le_sup_left
    refine Fin.lastCases ?_ (fun j => ?_) i
    · exact hle hlast
    · -- rewrite the last coefficient in terms of the others and use the induction hypothesis
      rw [hI, ofList_ofFn] at hlast
      obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hlast
      have hrel : ∑ k : Fin m, (c (Fin.castSucc k) + b k * x) * f' k = 0 := by
        have : ∑ k : Fin m, (c (Fin.castSucc k) + b k * x) * f' k =
            ∑ k : Fin m, c (Fin.castSucc k) * f' k + x * ∑ k : Fin m, b k • f' k := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [smul_eq_mul]
          ring
        rw [this, hb, mul_comm]
        exact hsplit
      have hxmem : x ∈ Ideal.ofList (List.ofFn f' ++ [x]) := by
        rw [Ideal.ofList_append]
        exact Ideal.mem_sup_right (Ideal.subset_span (List.mem_singleton_self x))
      rw [show c (Fin.castSucc j) = (c (Fin.castSucc j) + b j * x) - b j * x by ring]
      exact Ideal.sub_mem _ (hle (mem_ofList_of_sum_mul_eq_zero f' hf₁
        (fun k => c (Fin.castSucc k) + b k * x) hrel j)) (Ideal.mul_mem_left _ _ hxmem)

/-- The ideal generated by a regular sequence is proper. -/
theorem ofList_ne_top_of_isRegular {rs : List R} (h : IsRegular R rs) :
    Ideal.ofList rs ≠ ⊤ := by
  intro htop
  apply h.top_ne_smul
  rw [ideal_smul_top_eq, htop]

/-- Over a local ring, the identity matrix of size `n + 1` is not congruent modulo the maximal
ideal to a product of an `(n + 1) × n` matrix and an `n × (n + 1)` matrix. -/
private theorem not_forall_sum_mul_sub_ite_mem_maximalIdeal [IsLocalRing R] {n : ℕ}
    (b : Fin (n + 1) → Fin n → R) (d : Fin n → Fin (n + 1) → R) :
    ¬ ∀ k i, ∑ j, b k j * d j i - (if i = k then 1 else 0) ∈ maximalIdeal R := by
  intro hbd
  set B : Matrix (Fin (n + 1)) (Fin n) (ResidueField R) := fun k j => residue R (b k j)
  set D : Matrix (Fin n) (Fin (n + 1)) (ResidueField R) := fun j i => residue R (d j i)
  have hBD : B * D = 1 := by
    ext k i
    have hk := hbd k i
    rw [← residue_eq_zero_iff] at hk
    rw [Matrix.mul_apply, Matrix.one_apply]
    simp only [B, D]
    by_cases hik : i = k
    · subst hik
      simp only [ite_true, map_sub, map_mul, map_sum, map_one, sub_eq_zero] at hk
      simpa only [ite_true] using hk
    · simp only [hik, ite_false, map_mul, map_sum, sub_zero] at hk
      rwa [ite_eq_right (Ne.symm hik)]
  have hrank := Matrix.rank_mul_le_left B D
  rw [hBD, Matrix.rank_one] at hrank
  have hw' := Matrix.rank_le_width B
  simp only [Fintype.card_fin] at hrank
  omega

/-- **An element generating a regular ideal together with too few other elements has a unit
coefficient.** Let `R` be local and `f_0, …, f_n` an `R`-regular sequence generating `J`. If
`J` is generated by `g` together with `n` elements, then in every expression `g = ∑ w_i f_i` some
coefficient `w_l` is a unit: otherwise `g ∈ 𝔪 J`, and reducing the expressions of the `f_i` in the
new generators modulo `𝔪` would write the identity matrix of size `n + 1` over the residue field
as a product through a space of dimension `n`. -/
theorem exists_isUnit_coeff_of_ofList_eq_span_insert [IsLocalRing R] {n : ℕ}
    (f : Fin (n + 1) → R) (hf : IsRegular R (List.ofFn f)) (g : R) (h : Fin n → R)
    (hJ : Ideal.ofList (List.ofFn f) = Ideal.span (insert g (Set.range h)))
    (w : Fin (n + 1) → R) (hw : ∑ i, w i * f i = g) : ∃ l, IsUnit (w l) := by
  classical
  by_contra H
  push Not at H
  have hJm : Ideal.ofList (List.ofFn f) ≤ maximalIdeal R :=
    le_maximalIdeal (ofList_ne_top_of_isRegular hf)
  rw [ofList_ofFn] at hJ hJm
  -- the new generators in terms of the old ones
  have hd : ∀ j, ∃ d : Fin (n + 1) → R, ∑ i, d i • f i = h j := fun j =>
    (Submodule.mem_span_range_iff_exists_fun R).mp
      (show h j ∈ Ideal.span (Set.range f) by
        rw [hJ]
        exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨j, rfl⟩))
  choose d hd using hd
  -- the old generators in terms of the new ones
  have hab : ∀ k, ∃ a : R, ∃ b : Fin n → R, f k = a * g + ∑ j, b j • h j := by
    intro k
    obtain ⟨a, z, hz, hk⟩ := Ideal.mem_span_insert.mp
      (hJ ▸ (Ideal.subset_span ⟨k, rfl⟩ : f k ∈ Ideal.span (Set.range f)))
    obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hz
    exact ⟨a, b, hb ▸ hk⟩
  choose a b hab using hab
  -- the coefficients of the resulting relations lie in `J`, hence in `𝔪`
  have hrel : ∀ k i, a k * w i + ∑ j, b k j * d j i - (if i = k then 1 else 0) ∈
      maximalIdeal R := by
    intro k i
    refine hJm ?_
    rw [← ofList_ofFn]
    refine mem_ofList_of_sum_mul_eq_zero f hf.toIsWeaklyRegular
      (fun i => a k * w i + ∑ j, b k j * d j i - (if i = k then 1 else 0)) ?_ i
    have e2 : ∑ i, (∑ j, b k j * d j i) * f i = ∑ j, b k j • h j := by
      simp_rw [← hd, Finset.smul_sum, smul_eq_mul, Finset.sum_mul, mul_assoc]
      exact Finset.sum_comm
    have e3 : ∑ i : Fin (n + 1), (if i = k then (1 : R) else 0) * f i = f k := by
      simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    calc ∑ i, (a k * w i + ∑ j, b k j * d j i - (if i = k then 1 else 0)) * f i
        = ∑ i, (a k * (w i * f i) + (∑ j, b k j * d j i) * f i -
            (if i = k then (1 : R) else 0) * f i) :=
          Finset.sum_congr rfl fun i _ => by ring
      _ = a k * ∑ i, w i * f i + ∑ i, (∑ j, b k j * d j i) * f i -
            ∑ i, (if i = k then (1 : R) else 0) * f i := by
          rw [Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.mul_sum]
      _ = 0 := by
          rw [hw, e2, e3, hab k]
          ring
  -- reduce modulo `𝔪`
  refine not_forall_sum_mul_sub_ite_mem_maximalIdeal b d fun k i => ?_
  have hk := hrel k i
  rw [add_sub_assoc] at hk
  exact (add_mem_cancel_left (Ideal.mul_mem_left _ _ ((mem_maximalIdeal _).mpr (H i)))).mp hk

/-- Regularity of a sequence on a module over an algebra can be read on the images of its
members in the algebra: for `φ : R → T` and the `R`-module structure of `T` through `φ`, a list
of `R` is `T`-regular exactly when its image in `T` is. -/
theorem isRegular_map_algebraMap_iff_self {T : Type*} [CommRing T] [Algebra R T] (rs : List R) :
    IsRegular T (rs.map (algebraMap R T)) ↔ IsRegular T rs := by
  rw [isRegular_iff, isRegular_iff, isWeaklyRegular_map_algebraMap_iff, ← Ideal.map_ofList]
  refine and_congr_right' (not_congr ?_)
  rw [← Submodule.restrictScalars_inj R T, Submodule.restrictScalars_top,
    Ideal.smul_restrictScalars, Submodule.restrictScalars_top]

/-- Moving the `l`-th entry of a finite sequence to the front permutes its list of values. -/
private theorem ofFn_perm_cons_succAbove {α : Type*} {n : ℕ} (f : Fin (n + 1) → α)
    (l : Fin (n + 1)) : List.Perm (List.ofFn f) (f l :: List.ofFn fun i => f (l.succAbove i)) := by
  have hσ : f ∘ l.cycleRange.symm = Fin.cons (f l) fun i => f (l.succAbove i) := by
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [Fin.cycleRange_symm_zero]
    · simp [Fin.cycleRange_symm_succ]
  have h := Equiv.Perm.ofFn_comp_perm l.cycleRange.symm f
  rw [hσ, List.ofFn_succ] at h
  simpa using h.symm

/-- Replacing the last member `x` of a weakly regular sequence by an element `g` congruent to a
unit multiple of `x` modulo the earlier members keeps the sequence weakly regular. -/
private theorem isWeaklyRegular_append_singleton_of_sub_mul_mem {l : List R} {x g u : R}
    (hu : IsUnit u) (h : IsWeaklyRegular R (l ++ [x])) (hg : g - u * x ∈ Ideal.ofList l) :
    IsWeaklyRegular R (l ++ [g]) := by
  rw [isWeaklyRegular_append_iff, isWeaklyRegular_singleton_iff] at h ⊢
  refine ⟨h.1, ?_⟩
  have hsmul : ∀ q : R ⧸ (Ideal.ofList l • ⊤ : Submodule R R), g • q = u • x • q := by
    intro q
    induction q using Submodule.Quotient.induction_on with
    | H y =>
      rw [← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul,
        ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq, ideal_smul_top_eq]
      simp only [smul_eq_mul]
      rw [← mul_assoc, ← sub_mul]
      exact Ideal.mul_mem_right _ _ hg
  intro a b hab
  simp only [hsmul] at hab
  exact h.2 (hu.isSMulRegular _ hab)

/-- Replacing the last member `x` of a sequence by an element `g` congruent to a unit multiple of
`x` modulo the earlier members does not change the ideal it generates. -/
private theorem ofList_append_singleton_eq_of_sub_mul_mem {l : List R} {x g u : R}
    (hu : IsUnit u) (hg : g - u * x ∈ Ideal.ofList l) :
    Ideal.ofList (l ++ [g]) = Ideal.ofList (l ++ [x]) := by
  obtain ⟨u, rfl⟩ := hu
  rw [Ideal.ofList_append, Ideal.ofList_append, Ideal.ofList_singleton, Ideal.ofList_singleton]
  refine le_antisymm (sup_le le_sup_left ?_) (sup_le le_sup_left ?_) <;>
    rw [Ideal.span_singleton_le_iff_mem]
  · have := Ideal.add_mem _ (Ideal.mem_sup_left hg)
      (Ideal.mem_sup_right (Ideal.mul_mem_left _ (u : R) (Ideal.mem_span_singleton_self x)))
    rwa [sub_add_cancel] at this
  · rw [show x = (↑u⁻¹ : R) * g - (↑u⁻¹ : R) * (g - u * x) by
      rw [mul_sub, sub_sub_cancel, Units.inv_mul_cancel_left]]
    exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (Ideal.mem_sup_right
      (Ideal.mem_span_singleton_self g))) (Ideal.mul_mem_left _ _ (Ideal.mem_sup_left hg))

/-- If the kernel of `algebraMap R T` is `(g)`, then `g • R` is the kernel of the linear map
`R → T`. -/
private theorem smul_top_eq_ker_linearMap {T : Type*} [CommRing T] [Algebra R T] {g : R}
    (hker : RingHom.ker (algebraMap R T) = Ideal.span {g}) :
    g • (⊤ : Submodule R R) = LinearMap.ker (Algebra.linearMap R T) := by
  ext x
  rw [Submodule.mem_smul_pointwise_iff_exists, LinearMap.mem_ker, Algebra.linearMap_apply,
    ← RingHom.mem_ker, hker, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨y, -, rfl⟩
    exact ⟨y, by rw [smul_eq_mul, mul_comm]⟩
  · rintro ⟨a, rfl⟩
    exact ⟨a, Submodule.mem_top, by rw [smul_eq_mul, mul_comm]⟩

/-- **The image of a regular ideal modulo one of its minimal generators is regular.** Let `R`
be a Noetherian local ring and `f_0, …, f_n` an `R`-regular sequence generating `J`. If `J` is
generated by `g` together with `n` further elements, then for every surjection `φ : R → T` with
kernel `(g)`, the ideal `φ(J)` of `T` is generated by a `T`-regular sequence of length `n`. -/
theorem exists_isRegular_ofList_eq_map_of_ker_eq_span_singleton [IsLocalRing R]
    [IsNoetherianRing R] {T : Type*} [CommRing T] {n : ℕ} (f : Fin (n + 1) → R)
    (hf : IsRegular R (List.ofFn f)) (g : R) (h : Fin n → R)
    (hJ : Ideal.ofList (List.ofFn f) = Ideal.span (insert g (Set.range h)))
    (φ : R →+* T) (hφ : Function.Surjective φ) (hker : RingHom.ker φ = Ideal.span {g}) :
    ∃ rs : List T, rs.length = n ∧ IsRegular T rs ∧
      Ideal.ofList rs = (Ideal.ofList (List.ofFn f)).map φ := by
  classical
  have hg : g ∈ Ideal.span (Set.range f) := by
    rw [← ofList_ofFn, hJ]
    exact Ideal.subset_span (Set.mem_insert _ _)
  obtain ⟨w, hw⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hg
  simp only [smul_eq_mul] at hw
  obtain ⟨l, hl⟩ := exists_isUnit_coeff_of_ofList_eq_span_insert f hf g h hJ w hw
  set f₁ : Fin n → R := fun j => f (l.succAbove j)
  -- `g` is `w l • f l` modulo the other members of the sequence
  have hgsub : g - w l * f l ∈ Ideal.ofList (List.ofFn f₁) := by
    rw [← hw, Fin.sum_univ_succAbove _ l, add_sub_cancel_left, ofList_ofFn]
    exact sum_mul_mem_span_range _ _
  -- the sequence with `f l` moved to the end is regular
  have hperm : List.Perm (List.ofFn f) (List.ofFn f₁ ++ [f l]) :=
    (ofFn_perm_cons_succAbove f l).trans (List.perm_append_comm (l₁ := [f l]))
  -- replacing `f l` by `g` keeps the sequence regular and generating `J`
  have hspan : Ideal.ofList (List.ofFn f₁ ++ [g]) = Ideal.ofList (List.ofFn f) := by
    rw [ofList_append_singleton_eq_of_sub_mul_mem hl hgsub]
    exact congrArg Ideal.span (Set.ext fun _ => hperm.symm.mem_iff)
  have hreg₂ : IsRegular R (List.ofFn f₁ ++ [g]) :=
    ⟨isWeaklyRegular_append_singleton_of_sub_mul_mem hl
      (IsLocalRing.isRegular_of_perm hf hperm).toIsWeaklyRegular hgsub, by
        rw [hspan]
        exact hf.top_ne_smul⟩
  have hreg₃ : IsRegular R (g :: List.ofFn f₁) :=
    IsLocalRing.isRegular_of_perm hreg₂ (List.perm_append_comm (l₂ := [g]))
  rw [isRegular_cons_iff] at hreg₃
  -- transport to `T`, viewed as an `R`-module through `φ`
  let : Algebra R T := φ.toAlgebra
  let e : QuotSMulTop g R ≃ₗ[R] T :=
    (Submodule.quotEquivOfEq _ _ (smul_top_eq_ker_linearMap hker)).trans
      ((Algebra.linearMap R T).quotKerEquivOfSurjective hφ)
  refine ⟨(List.ofFn f₁).map φ, by simp,
    (isRegular_map_algebraMap_iff_self (T := T) _).mpr ((e.isRegular_congr _).mp hreg₃.2), ?_⟩
  rw [← hspan, Ideal.ofList_append, Ideal.ofList_singleton, Ideal.map_sup, Ideal.map_ofList,
    Ideal.map_span, Set.image_singleton]
  have hg0 : φ g = 0 := RingHom.mem_ker.mp (hker ▸ Ideal.mem_span_singleton_self g)
  rw [hg0, Ideal.span_singleton_eq_bot.mpr rfl, sup_bot_eq]

/-- If `φ` is surjective with kernel `(g)` and the kernel of `ψ` is spanned by the `c i`, then
the kernel of `ψ ∘ φ` is spanned by `g` together with any lifts `h i` of the `c i`. -/
private theorem ker_comp_eq_span_insert_of_surjective {T U : Type*} [CommRing T] [CommRing U]
    (φ : R →+* T) (ψ : T →+* U) {g : R} (hkerφ : RingHom.ker φ = Ideal.span {g}) {r : ℕ}
    {c : Fin r → T} (hkerψ : RingHom.ker ψ = Ideal.span (Set.range c)) (h : Fin r → R)
    (hh : ∀ i, φ (h i) = c i) (hφ : Function.Surjective φ) :
    RingHom.ker (ψ.comp φ) = Ideal.span (insert g (Set.range h)) := by
  refine le_antisymm (fun a ha => ?_) (Ideal.span_le.mpr ?_)
  · rw [RingHom.mem_ker, RingHom.comp_apply, ← RingHom.mem_ker, hkerψ] at ha
    obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp ha
    choose d' hd' using fun i => hφ (d i)
    have hdiff : a - ∑ i, d' i * h i ∈ RingHom.ker φ := by
      rw [RingHom.mem_ker, map_sub, map_sum, sub_eq_zero, ← hd]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, hd' i, hh i, smul_eq_mul]
    rw [hkerφ, Ideal.mem_span_singleton'] at hdiff
    obtain ⟨b, hb⟩ := hdiff
    rw [sub_eq_iff_eq_add.mp hb.symm]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
      (Ideal.span_mono (Set.subset_insert _ _) (sum_mul_mem_span_range _ _))
  · rintro x (hx | ⟨i, rfl⟩)
    · subst hx
      have hg0 : φ x = 0 := RingHom.mem_ker.mp (hkerφ ▸ Ideal.mem_span_singleton_self x)
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hg0, map_zero]
    · rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hh]
      exact RingHom.mem_ker.mp (hkerψ ▸ Ideal.subset_span ⟨i, rfl⟩)

/-- **The regular sequence on the quotient, read through a composite of surjections.** Let
`φ : R → T` be a surjection with kernel `(g)` and `ψ : T → U` a ring homomorphism whose kernel is
generated by `r` elements. If the kernel of `ψ ∘ φ` is generated by an `R`-regular sequence of
length `r + 1` in the Noetherian local ring `R`, then the kernel of `ψ` is generated by a
`T`-regular sequence of length `r`. -/
theorem exists_isRegular_ofList_eq_ker_of_comp [IsLocalRing R] [IsNoetherianRing R]
    {T U : Type*} [CommRing T] [CommRing U] (φ : R →+* T) (ψ : T →+* U)
    (hφ : Function.Surjective φ) (g : R) (hkerφ : RingHom.ker φ = Ideal.span {g}) {r : ℕ}
    (c : Fin r → T) (hkerψ : RingHom.ker ψ = Ideal.span (Set.range c)) (rs : List R)
    (hlen : rs.length = r + 1) (hreg : IsRegular R rs)
    (hspan : Ideal.ofList rs = RingHom.ker (ψ.comp φ)) :
    ∃ rs' : List T, rs'.length = r ∧ IsRegular T rs' ∧ Ideal.ofList rs' = RingHom.ker ψ := by
  classical
  choose h hh using fun i => hφ (c i)
  have hf : List.ofFn (fun i : Fin (r + 1) => rs.get (Fin.cast hlen.symm i)) = rs :=
    (List.ofFn_congr hlen rs.get).symm.trans (List.ofFn_get rs)
  have hrsf : IsRegular R (List.ofFn (fun i : Fin (r + 1) => rs.get (Fin.cast hlen.symm i))) := by
    rwa [hf]
  have hJf : Ideal.ofList (List.ofFn (fun i : Fin (r + 1) => rs.get (Fin.cast hlen.symm i))) =
      Ideal.span (insert g (Set.range h)) := by
    rw [hf, hspan, ker_comp_eq_span_insert_of_surjective φ ψ hkerφ hkerψ h hh hφ]
  obtain ⟨rs', hlen', hreg', hspan'⟩ :=
    exists_isRegular_ofList_eq_map_of_ker_eq_span_singleton _ hrsf g h hJf φ hφ hkerφ
  refine ⟨rs', hlen', hreg', ?_⟩
  rw [hspan', hf, hspan, ← RingHom.comap_ker, Ideal.map_comap_of_surjective φ hφ]

end RingTheory.Sequence
