module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.RingTheory.Coprime.Lemmas
public import Mathlib.RingTheory.Ideal.Operations

/-!
# A module is cyclic as soon as it is cyclic modulo finitely many comaximal ideals

Let `A` be a commutative ring and `M` an `A`-module annihilated by a product `I₁ ⋯ Iₙ` of
pairwise comaximal ideals. Then `M` is the direct sum of the pieces `Iᵢ`-torsion, and the
`i`-th piece is `M / Iᵢ M`; so if each `M / Iᵢ M` is generated by one element, so is `M`.

This is the local-to-global step for a module supported at finitely many closed points: for
each point one has a generator of the stalk, and the Chinese remainder theorem assembles them
into a single global generator. It is **not** an instance of "locally cyclic implies cyclic",
which is false — an invertible sheaf on a curve is locally free of rank one and need not be
trivial. What makes it work is that the support is a finite set of *comaximal* closed points,
so that `M` really is the direct sum of its localizations there and no gluing datum survives.

## Main results

* `Stacks.CyclicComaximal.exists_span_singleton_eq_top` — a module annihilated by a product of
  pairwise comaximal ideals, and cyclic modulo each of them, is cyclic.
* `Stacks.CyclicComaximal.exists_sup_span_singleton_eq_top` — the same statement relative to a
  submodule `R`: if `M / R` is annihilated by the product and is cyclic modulo each `Iᵢ`, then
  `M` is generated by `R` together with a single element.

## Implementation notes

The induction is on the finite index set and must change the module at each step, since the
inductive hypothesis is applied to the submodule `Iⱼ • N`; the statement is therefore proved
for an arbitrary submodule `N` of a fixed ambient module, with `N` quantified inside the
induction.

The relative form is obtained from the absolute one by pushing everything into `M ⧸ R`, which is
why `Mathlib.LinearAlgebra.Quotient.Basic` is imported: `Submodule.map_mkQ_eq_top` converts
`R ⊔ P = ⊤` into a statement about the quotient, and `Submodule.map_smul''` carries `Iᵢ • ⊤`
across.

## References

* [Stacks Project, Tag 00DT](https://stacks.math.columbia.edu/tag/00DT)
-/

@[expose] public noncomputable section

universe u v

namespace Stacks.CyclicComaximal

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- The two complementary idempotent actions attached to a comaximal pair: `x + y = 1` with
`x ∈ I` and `y ∈ J`. -/
private theorem exists_add_eq_one_of_sup_eq_top {I J : Ideal A} (h : I ⊔ J = ⊤) :
    ∃ x ∈ I, ∃ y ∈ J, x + y = 1 := by
  have h1 : (1 : A) ∈ I ⊔ J := by rw [h]; exact Submodule.mem_top
  obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp h1
  exact ⟨x, hx, y, hy, hxy⟩

/-- An element of `I` kills every element of a submodule `P` with `I • P = ⊥`. -/
private theorem smul_eq_zero_of_smul_eq_bot {I : Ideal A} {P : Submodule A M} (h : I • P = ⊥)
    {a : A} (ha : a ∈ I) {m : M} (hm : m ∈ P) : a • m = 0 := by
  have := Submodule.smul_mem_smul ha hm
  rwa [h, Submodule.mem_bot] at this

/-- If `a + b = 1` and `b` kills `m`, then `a` fixes `m`. -/
private theorem smul_eq_self_of_add_eq_one {a b : A} (hab : a + b = 1) {m : M} (h : b • m = 0) :
    a • m = m := by
  have : (a + b) • m = m := by rw [hab, one_smul]
  rwa [add_smul, h, add_zero] at this

/-- **The inductive core.** For an arbitrary submodule `N` of `M` annihilated by a product of
pairwise comaximal ideals and cyclic modulo each of them, `N` is cyclic. The submodule is
quantified inside the induction because the inductive step applies the statement to `Iⱼ • N`. -/
private theorem exists_span_singleton_eq_aux {ι : Type*} (I : ι → Ideal A) (s : Finset ι) :
    ∀ N : Submodule A M,
      (∀ i ∈ s, ∀ j ∈ s, i ≠ j → I i ⊔ I j = ⊤) →
      (∏ i ∈ s, I i) • N = ⊥ →
      (∀ i ∈ s, ∃ t ∈ N, Submodule.span A {t} ⊔ I i • N = N) →
      ∃ t ∈ N, Submodule.span A {t} = N := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro N _ hann _
    rw [Finset.prod_empty, Ideal.one_eq_top, Submodule.top_smul] at hann
    exact ⟨0, N.zero_mem, by rw [Submodule.span_zero_singleton, hann]⟩
  | @insert j s hj ih =>
    intro N hcom hann hcyc
    set J : Ideal A := ∏ i ∈ s, I i with hJdef
    have hjne : ∀ i ∈ s, j ≠ i := fun i hi h => hj (h ▸ hi)
    -- `I j` is comaximal with the product of the others
    have hPJ : I j ⊔ J = ⊤ := by
      rw [hJdef, ← Ideal.isCoprime_iff_sup_eq]
      refine IsCoprime.prod_right fun i hi => ?_
      rw [Ideal.isCoprime_iff_sup_eq]
      exact hcom j (Finset.mem_insert_self j s) i (Finset.mem_insert_of_mem hi) (hjne i hi)
    rw [Finset.prod_insert hj] at hann
    obtain ⟨x, hx, y, hy, hxy⟩ := exists_add_eq_one_of_sup_eq_top hPJ
    -- the two complementary pieces
    have hPN₁ : I j • (J • N) = ⊥ := by rw [← Submodule.mul_smul]; exact hann
    have hJN₂ : J • (I j • N) = ⊥ := by rw [← Submodule.mul_smul, mul_comm]; exact hann
    have hsum : J • N ⊔ I j • N = N := by
      rw [← Submodule.sup_smul, sup_comm, hPJ, Submodule.top_smul]
    have hy_id : ∀ m ∈ J • N, y • m = m := fun m hm =>
      smul_eq_self_of_add_eq_one ((add_comm y x).trans hxy) (smul_eq_zero_of_smul_eq_bot hPN₁ hx hm)
    have hx_id : ∀ m ∈ I j • N, x • m = m := fun m hm =>
      smul_eq_self_of_add_eq_one hxy (smul_eq_zero_of_smul_eq_bot hJN₂ hy hm)
    -- the `I j`-piece is cyclic, generated by the projection of the given generator
    obtain ⟨tj, htjN, htj⟩ := hcyc j (Finset.mem_insert_self j s)
    have hytj : y • tj ∈ J • N := Submodule.smul_mem_smul hy htjN
    have hN₁ : J • N = Submodule.span A {y • tj} := by
      refine le_antisymm (fun m hm => ?_) ?_
      · have hmN : m ∈ N := Submodule.smul_le_right hm
        rw [← htj] at hmN
        obtain ⟨p, hp, q, hq, hpq⟩ := Submodule.mem_sup.mp hmN
        obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hp
        have hm' : y • m = a • (y • tj) := by
          rw [← hpq, smul_add, smul_eq_zero_of_smul_eq_bot hJN₂ hy hq, add_zero, ← ha, smul_comm]
        rw [(hy_id m hm).symm.trans hm']
        exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
      · exact Submodule.span_singleton_le_iff_mem _ _ |>.mpr hytj
    -- the complementary piece satisfies the inductive hypothesis
    have hcyc₂ : ∀ i ∈ s, ∃ t ∈ I j • N,
        Submodule.span A {t} ⊔ I i • (I j • N) = I j • N := by
      intro i hi
      obtain ⟨ti, htiN, hti⟩ := hcyc i (Finset.mem_insert_of_mem hi)
      refine ⟨x • ti, Submodule.smul_mem_smul hx htiN, le_antisymm ?_ fun m hm => ?_⟩
      · refine sup_le ?_ Submodule.smul_le_right
        exact (Submodule.span_singleton_le_iff_mem _ _).mpr (Submodule.smul_mem_smul hx htiN)
      · have hmN : m ∈ N := Submodule.smul_le_right hm
        rw [← hti] at hmN
        obtain ⟨p, hp, q, hq, hpq⟩ := Submodule.mem_sup.mp hmN
        obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hp
        have hxq : x • q ∈ I i • (I j • N) := by
          refine Submodule.smul_induction_on hq (fun r hr n hn => ?_) (fun m₁ m₂ h₁ h₂ => ?_)
          · rw [smul_comm x r n]
            exact Submodule.smul_mem_smul hr (Submodule.smul_mem_smul hx hn)
          · rw [smul_add]
            exact Submodule.add_mem _ h₁ h₂
        have hm' : x • m = a • (x • ti) + x • q := by
          rw [← hpq, smul_add, ← ha, smul_comm]
        rw [(hx_id m hm).symm.trans hm']
        exact Submodule.add_mem _
          (Submodule.mem_sup_left
            (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)))
          (Submodule.mem_sup_right hxq)
    obtain ⟨t₂, ht₂N, ht₂⟩ := ih (I j • N)
      (fun i hi i' hi' h => hcom i (Finset.mem_insert_of_mem hi) i'
        (Finset.mem_insert_of_mem hi') h) hJN₂ hcyc₂
    -- the sum of the two generators generates
    have htN : y • tj + t₂ ∈ N :=
      N.add_mem (Submodule.smul_le_right hytj) (Submodule.smul_le_right ht₂N)
    have hmemw : ∀ a : A, a • (y • tj + t₂) ∈ Submodule.span A {y • tj + t₂} := fun a =>
      Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    refine ⟨y • tj + t₂, htN, le_antisymm ((Submodule.span_singleton_le_iff_mem _ _).mpr htN) ?_⟩
    rw [← hsum]
    refine sup_le ?_ ?_
    · rw [hN₁, Submodule.span_singleton_le_iff_mem]
      have hval : y • (y • tj + t₂) = y • tj := by
        rw [smul_add, smul_eq_zero_of_smul_eq_bot hJN₂ hy ht₂N, add_zero, hy_id _ hytj]
      simpa only [hval] using hmemw y
    · rw [← ht₂, Submodule.span_singleton_le_iff_mem]
      have hval : x • (y • tj + t₂) = t₂ := by
        rw [smul_add, smul_eq_zero_of_smul_eq_bot hPN₁ hx hytj, zero_add, hx_id _ ht₂N]
      simpa only [hval] using hmemw x

/-- **A module cyclic modulo finitely many comaximal ideals is cyclic.** If `M` is annihilated
by the product of a finite family of pairwise comaximal ideals `Iᵢ` and each quotient `M / Iᵢ M`
is generated by one element, then `M` itself is generated by one element.

The hypotheses are exactly what a module supported at finitely many closed points provides:
the product of the maximal ideals of the support annihilates it, and at each of those points the
local structure gives a generator. -/
public theorem exists_span_singleton_eq_top {ι : Type*} (I : ι → Ideal A) (s : Finset ι)
    (hcom : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → I i ⊔ I j = ⊤)
    (hann : (∏ i ∈ s, I i) • (⊤ : Submodule A M) = ⊥)
    (hcyc : ∀ i ∈ s, ∃ t : M,
      Submodule.span A {t} ⊔ I i • (⊤ : Submodule A M) = ⊤) :
    ∃ t : M, Submodule.span A {t} = ⊤ := by
  obtain ⟨t, -, ht⟩ := exists_span_singleton_eq_aux I s ⊤ hcom hann
    fun i hi => by
      obtain ⟨t, ht⟩ := hcyc i hi
      exact ⟨t, Submodule.mem_top, ht⟩
  exact ⟨t, ht⟩

section Relative

variable (R : Submodule A M)

/-- `Iᵢ • ⊤` in the quotient by `R` is the image of `Iᵢ • ⊤`. -/
private theorem map_mkQ_smul_top (I : Ideal A) :
    Submodule.map R.mkQ (I • (⊤ : Submodule A M)) = I • (⊤ : Submodule A (M ⧸ R)) := by
  rw [Submodule.map_smul'', Submodule.map_top, R.range_mkQ]

/-- **A module generated by a submodule and one element, from the same datum modulo comaximal
ideals.** If the quotient `M / R` is annihilated by the product of a finite family of pairwise
comaximal ideals `Iᵢ`, and for each `i` the module `M` is generated by `R`, one element and
`Iᵢ M`, then `M` is generated by `R` together with a single element.

This is the form in which the statement is used: `M` is a ring extension `A'` of `A`, `R` is the
image of `A`, and the conclusion is that `A'` is `A` plus a single generator. -/
public theorem exists_sup_span_singleton_eq_top {ι : Type*} (I : ι → Ideal A) (s : Finset ι)
    (hcom : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → I i ⊔ I j = ⊤)
    (hann : (∏ i ∈ s, I i) • (⊤ : Submodule A M) ≤ R)
    (hcyc : ∀ i ∈ s, ∃ t : M,
      R ⊔ (Submodule.span A {t} ⊔ I i • (⊤ : Submodule A M)) = ⊤) :
    ∃ t : M, R ⊔ Submodule.span A {t} = ⊤ := by
  have hannQ : (∏ i ∈ s, I i) • (⊤ : Submodule A (M ⧸ R)) = ⊥ := by
    rw [← map_mkQ_smul_top R]
    refine le_bot_iff.mp ?_
    rw [Submodule.map_le_iff_le_comap, Submodule.comap_bot, R.ker_mkQ]
    exact hann
  have hcycQ : ∀ i ∈ s, ∃ t : M ⧸ R,
      Submodule.span A {t} ⊔ I i • (⊤ : Submodule A (M ⧸ R)) = ⊤ := by
    intro i hi
    obtain ⟨t, ht⟩ := hcyc i hi
    refine ⟨R.mkQ t, ?_⟩
    rw [← map_mkQ_smul_top R, ← Set.image_singleton, ← Submodule.map_span,
      ← Submodule.map_sup, Submodule.map_mkQ_eq_top]
    exact ht
  obtain ⟨t, ht⟩ := exists_span_singleton_eq_top I s hcom hannQ hcycQ
  obtain ⟨t₀, rfl⟩ := R.mkQ_surjective t
  refine ⟨t₀, ?_⟩
  rw [← Submodule.map_mkQ_eq_top, Submodule.map_span, Set.image_singleton]
  exact ht

/-- **A coatom together with one element is everything.** Any element outside a coatom `N`
generates the rest of the module over `N`, because `N` has nothing strictly between it and the
top. This is the shape in which a simple quotient supplies a generator. -/
public theorem exists_sup_span_singleton_eq_top_of_isCoatom (h : IsCoatom R) :
    ∃ t : M, R ⊔ Submodule.span A {t} = ⊤ := by
  obtain ⟨t, ht⟩ : ∃ t : M, t ∉ R := by
    by_contra hcon
    exact h.1 (eq_top_iff.mpr fun m _ => not_not.mp fun hm => hcon ⟨m, hm⟩)
  refine ⟨t, h.2 _ (lt_of_le_of_ne le_sup_left fun heq => ht ?_)⟩
  rw [heq]
  exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self t)

/-- **The local-to-global statement with the per-point hypothesis in coatom form.** If the
product of the pairwise comaximal ideals `Iᵢ` carries `M` into `R`, and for each `i` the
submodule `R + Iᵢ M` is a coatom — equivalently, the quotient `M / (R + Iᵢ M)` is a simple
module — then `M` is generated by `R` together with one element.

This is the form the geometry supplies: at a node the quotient `A' / (A + 𝔪 A')` is a
one-dimensional vector space over the residue field, which is exactly the simplicity asked for
here, and it is a statement about the global `A'` with no localization in it. -/
public theorem exists_sup_span_singleton_eq_top_of_isCoatom_sup {ι : Type*} (I : ι → Ideal A)
    (s : Finset ι)
    (hcom : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → I i ⊔ I j = ⊤)
    (hann : (∏ i ∈ s, I i) • (⊤ : Submodule A M) ≤ R)
    (hco : ∀ i ∈ s, IsCoatom (R ⊔ I i • (⊤ : Submodule A M))) :
    ∃ t : M, R ⊔ Submodule.span A {t} = ⊤ := by
  refine exists_sup_span_singleton_eq_top R I s hcom hann fun i hi => ?_
  obtain ⟨t, ht⟩ := exists_sup_span_singleton_eq_top_of_isCoatom _ (hco i hi)
  refine ⟨t, ?_⟩
  have heq : R ⊔ (Submodule.span A {t} ⊔ I i • (⊤ : Submodule A M))
      = R ⊔ I i • (⊤ : Submodule A M) ⊔ Submodule.span A {t} := by
    ac_rfl
  rw [heq]
  exact ht

end Relative

end Stacks.CyclicComaximal

end
