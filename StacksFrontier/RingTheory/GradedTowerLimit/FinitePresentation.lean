module

public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.RingTheory.Nakayama
public import StacksFrontier.RingTheory.GradedTowerLimit.BaseChange
public import StacksFrontier.RingTheory.Henselian.Pair.Nilpotent

/-!
# The graded inverse limit is finitely presented

For an admissible tower of graded algebras (`Stacks.GradedTowerLimit.GradedTower.IsAdmissible`),
the graded inverse limit `B = ⨁_d lim (Aₙ)_d` is a finitely presented algebra over `R = lim Rₙ`.
This is the claim proved at the end of the proof of Stacks Tag 0D4T.

## The route

The kernel `I` of `R → R₀` lies in the Jacobson radical of `R` (Stacks Tag 0CT7), and for every
degree `d` the projection `B_d → (A₀)_d` is surjective with kernel `I · B_d` (base change of the
finite projective module `B_d`). Choose homogeneous generators `g₁, …, gₛ` of positive degrees
`w₁, …, wₛ` of `A₀` over `R₀` and lift them to `bᵢ ∈ B_{wᵢ}`; let
`Ψ : R[X₁, …, Xₛ] → B` send `Xᵢ` to `bᵢ`, a graded map for the weights `wᵢ`.

* `Ψ` is surjective: in each degree `d`, the image of the degree-`d` polynomials and `I · B_d`
  together give `B_d`, and Nakayama's lemma applies to the finite module `B_d`.
* The kernel of `Ψ` is finitely generated: lift homogeneous generators `F₁, …, Fₜ` of the kernel of
  `R₀[X₁, …, Xₛ] → A₀` to homogeneous `G₁, …, Gₜ` in the kernel of `Ψ`. In each degree `d` the
  kernel of `Ψ` is a direct summand of the finite free module of degree-`d` polynomials (`B_d`
  being projective), so it is finite and meets `I` times the polynomials in `I` times itself; the
  ideal generated by the `Gⱼ` and `I` times the degree-`d` kernel give the degree-`d` kernel, and
  Nakayama's lemma applies again.

## Main results

* `Stacks.GradedTowerLimit.GradedTower.finitePresentation_lim`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite MvPolynomial
open scoped TensorProduct DirectSum

universe u

namespace Stacks.GradedTowerLimit

/-! ### Weighted polynomials into graded algebras -/

section Polynomial

variable {σ S C : Type*} [CommRing S] [CommRing C] [Algebra S C]

/-- Evaluation at homogeneous elements of the given weights carries weighted homogeneous
polynomials of degree `d` into degree `d`. -/
theorem aeval_mem_of_isWeightedHomogeneous (𝒞 : ℕ → Submodule S C) [SetLike.GradedMonoid 𝒞]
    (w : σ → ℕ) (g : σ → C) (hg : ∀ j, g j ∈ 𝒞 (w j)) {φ : MvPolynomial σ S} {d : ℕ}
    (hφ : φ.IsWeightedHomogeneous w d) : aeval g φ ∈ 𝒞 d := by
  classical
  rw [φ.as_sum, map_sum]
  refine Submodule.sum_mem _ fun m hm => ?_
  rw [aeval_monomial, ← Algebra.smul_def]
  refine Submodule.smul_mem _ _ ?_
  have hw : Finsupp.weight w m = d := hφ (mem_support_iff.mp hm)
  rw [← hw, Finsupp.weight_apply, Finsupp.prod]
  exact SetLike.prod_pow_mem_graded 𝒞 _ _ _ fun j _ => hg j

/-- A ring homomorphism between graded algebras preserving degrees commutes with taking
homogeneous components. -/
theorem coe_decompose_map {S' D : Type*} [CommRing S'] [CommRing D] [Algebra S' D]
    (𝒞 : ℕ → Submodule S C) (𝒟 : ℕ → Submodule S' D) [GradedAlgebra 𝒞] [GradedAlgebra 𝒟]
    (f : C →+* D) (hf : ∀ (i : ℕ) (x : C), x ∈ 𝒞 i → f x ∈ 𝒟 i) (x : C) (i : ℕ) :
    (DirectSum.decompose 𝒟 (f x) i : D) = f (DirectSum.decompose 𝒞 x i) := by
  classical
  conv_lhs => rw [← DirectSum.sum_support_decompose 𝒞 x]
  rw [map_sum, ← GradedRing.proj_apply, map_sum, Finset.sum_eq_single i]
  · rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒟 (hf _ _ (SetLike.coe_mem _))]
  · intro j _ hji
    rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒟 (hf _ _ (SetLike.coe_mem _)) hji]
  · intro hi
    rw [DFinsupp.notMem_support_iff.mp hi, ZeroMemClass.coe_zero, map_zero, map_zero]



attribute [local instance] MvPolynomial.weightedGradedAlgebra

/-- Evaluation at homogeneous elements of the given weights commutes with taking homogeneous
components. -/
theorem coe_decompose_aeval (𝒞 : ℕ → Submodule S C) [GradedAlgebra 𝒞] (w : σ → ℕ) (g : σ → C)
    (hg : ∀ j, g j ∈ 𝒞 (w j)) (φ : MvPolynomial σ S) (d : ℕ) :
    (DirectSum.decompose 𝒞 (aeval g φ) d : C) = aeval g (weightedHomogeneousComponent w d φ) := by
  rw [← weightedDecomposition.decompose'_apply]
  exact coe_decompose_map (weightedHomogeneousSubmodule S w) 𝒞 (aeval g).toRingHom
    (fun i x hx => aeval_mem_of_isWeightedHomogeneous 𝒞 w g hg hx) φ d

end Polynomial

section Coefficients

variable {σ S S₀ : Type*} [CommRing S] [CommRing S₀] (f : S →+* S₀)

/-- Mapping the coefficients along a ring homomorphism keeps a weighted homogeneous polynomial
weighted homogeneous of the same degree. -/
theorem isWeightedHomogeneous_map {w : σ → ℕ} {φ : MvPolynomial σ S} {d : ℕ}
    (hφ : φ.IsWeightedHomogeneous w d) : (map f φ).IsWeightedHomogeneous w d := by
  intro m hm
  rw [coeff_map] at hm
  exact hφ fun h => hm (by rw [h, map_zero])

/-- A weighted homogeneous polynomial over `S₀` lifts to a weighted homogeneous polynomial of the
same degree along a surjection `S → S₀`. -/
theorem exists_isWeightedHomogeneous_map_eq (hf : Function.Surjective f) (w : σ → ℕ)
    {φ : MvPolynomial σ S₀} {d : ℕ} (hφ : φ.IsWeightedHomogeneous w d) :
    ∃ ψ : MvPolynomial σ S, ψ.IsWeightedHomogeneous w d ∧ map f ψ = φ := by
  classical
  obtain ⟨ψ, rfl⟩ := map_surjective f hf φ
  refine ⟨weightedHomogeneousComponent w d ψ,
    weightedHomogeneousComponent_isWeightedHomogeneous _ _, ?_⟩
  ext m
  rw [coeff_map, coeff_weightedHomogeneousComponent]
  split_ifs with h
  · rw [coeff_map]
  · rw [map_zero]
    by_contra hne
    exact h (hφ (Ne.symm hne))

/-- The elements of `I` times a module of polynomials have coefficients in `I`. -/
theorem map_eq_zero_of_mem_smul {I : Ideal S} (hI : I ≤ RingHom.ker f)
    {Q : Submodule S (MvPolynomial σ S)} {x : MvPolynomial σ S} (hx : x ∈ I • Q) :
    map f x = 0 := by
  refine Submodule.smul_induction_on hx (fun a ha q _ => ?_) fun x y hx hy => ?_
  · rw [smul_eq_C_mul, map_mul, map_C, RingHom.mem_ker.mp (hI ha), map_zero, zero_mul]
  · rw [map_add, hx, hy, add_zero]

/-- A weighted homogeneous polynomial with coefficients in `I` is `I` times weighted homogeneous
polynomials. -/
theorem mem_smul_weightedHomogeneousSubmodule {I : Ideal S} (hI : RingHom.ker f ≤ I)
    {w : σ → ℕ} {x : MvPolynomial σ S} {d : ℕ} (hx : x.IsWeightedHomogeneous w d)
    (h0 : map f x = 0) : x ∈ I • weightedHomogeneousSubmodule S w d := by
  classical
  rw [x.as_sum]
  refine Submodule.sum_mem _ fun m hm => ?_
  have hc : coeff m x ∈ I := hI (by
    rw [RingHom.mem_ker, ← coeff_map, h0, coeff_zero])
  rw [← mul_one (coeff m x), ← smul_eq_mul, ← smul_monomial]
  refine Submodule.smul_mem_smul hc ?_
  intro m' hm'
  rw [coeff_monomial] at hm'
  split_ifs at hm' with h
  · rw [← h]
    exact hx (mem_support_iff.mp hm)
  · exact absurd rfl hm'

end Coefficients

/-! ### Homogeneous generators -/

/-- A finitely generated graded algebra whose degree-zero part is the image of the base ring is
generated by finitely many homogeneous elements of positive degree. -/
theorem exists_homogeneous_generators {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] [Algebra.FiniteType R A]
    (h0 : ∀ x ∈ 𝒜 0, ∃ r : R, algebraMap R A r = x) :
    ∃ (k : ℕ) (w : Fin k → ℕ) (g : Fin k → A), (∀ j, g j ∈ 𝒜 (w j)) ∧ (∀ j, w j ≠ 0) ∧
      Algebra.adjoin R (Set.range g) = ⊤ := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
  let t : Finset (ℕ × A) := s.biUnion fun a =>
    ((DirectSum.decompose 𝒜 a).support.filter (· ≠ 0)).image
      fun i => (i, (DirectSum.decompose 𝒜 a i : A))
  have ht : ∀ p ∈ t, p.2 ∈ 𝒜 p.1 ∧ p.1 ≠ 0 := by
    intro p hp
    simp only [t, Finset.mem_biUnion, Finset.mem_image, Finset.mem_filter] at hp
    obtain ⟨a, -, i, ⟨-, hi⟩, rfl⟩ := hp
    exact ⟨SetLike.coe_mem _, hi⟩
  let e := t.equivFin
  refine ⟨t.card, fun j => (e.symm j).1.1, fun j => (e.symm j).1.2,
    fun j => (ht _ (e.symm j).2).1, fun j => (ht _ (e.symm j).2).2, ?_⟩
  refine eq_top_iff.mpr (hs ▸ Algebra.adjoin_le fun a ha => ?_)
  rw [← DirectSum.sum_support_decompose 𝒜 a]
  refine Subalgebra.sum_mem _ fun i hi => ?_
  by_cases hi0 : i = 0
  · subst hi0
    obtain ⟨r, hr⟩ := h0 _ (SetLike.coe_mem (DirectSum.decompose 𝒜 a 0))
    rw [← hr]
    exact Subalgebra.algebraMap_mem _ r
  · have hmem : (i, (DirectSum.decompose 𝒜 a i : A)) ∈ t := by
      simp only [t, Finset.mem_biUnion, Finset.mem_image, Finset.mem_filter]
      exact ⟨a, ha, i, ⟨hi, hi0⟩, rfl⟩
    refine Algebra.subset_adjoin ⟨e ⟨_, hmem⟩, ?_⟩
    simp

namespace GradedTower

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {Rg : ℕᵒᵖ ⥤ CommRingCat.{u}} {T : GradedTower Rg}

/-- The limit projection to the bottom ring of a surjective tower is surjective. -/
theorem surjective_limit_π_zero (hT : T.IsAdmissible) :
    Function.Surjective (limit.π Rg (op 0)).hom :=
  Concrete.surjective_π_app_zero_of_surjective_map (limit.isLimit Rg) hT.surjective

/-- **Stacks 0CT7.** The kernel of the limit projection to the bottom ring lies in the Jacobson
radical of the limit ring. -/
theorem ker_limit_π_zero_le_jacobson (hT : T.IsAdmissible) :
    RingHom.ker (limit.π Rg (op 0)).hom ≤ Ideal.jacobson ⊥ :=
  (henselianRing_ker_limit_π_of_surjective_of_ker_le_nilradical Rg (limit.cone Rg)
    (limit.isLimit Rg) (fun n => ⟨hT.surjective n, hT.ker_le_nilradical n⟩) 0).jac

/-- **Every maximal ideal of the limit ring comes from `R₀`**: it lies in the image of
`Spec R₀ → Spec (lim Rₙ)`, the kernel of `lim Rₙ → R₀` being in the Jacobson radical. -/
theorem mem_range_comap_limit_π_zero (hT : T.IsAdmissible)
    (p : PrimeSpectrum (limit Rg : CommRingCat.{u})) (hp : p.asIdeal.IsMaximal) :
    p ∈ Set.range (PrimeSpectrum.comap (limit.π Rg (op 0)).hom) := by
  rw [range_comap_of_surjective (f := (limit.π Rg (op 0)).hom)
    (hf := surjective_limit_π_zero hT), PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe]
  exact (ker_limit_π_zero_le_jacobson hT).trans fun x hx => Ideal.mem_sInf.mp hx ⟨bot_le, hp⟩

/-- The projection of the degree-`d` part of the limit to `(A₀)_d` is surjective. -/
theorem exists_proj_eq (hT : T.IsAdmissible) {d : ℕ} {y : T.A 0} (hy : y ∈ T.𝒜 0 d) :
    ∃ z ∈ T.limGrading d, T.proj 0 z = y := by
  obtain ⟨e, he⟩ := (finite_projective_baseChange_piece hT d).2.2 0
  have key : ∀ t, ∃ z : T.piece d, e t = T.pieceProj d 0 z := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul a w =>
      obtain ⟨b, rfl⟩ := surjective_limit_π_zero hT a
      refine ⟨b • w, ?_⟩
      rw [he, map_smul, ← algebraMap_smul (Rg.obj (op 0)) b]
      rfl
    | add t t' ht ht' =>
      obtain ⟨z, hz⟩ := ht
      obtain ⟨z', hz'⟩ := ht'
      exact ⟨z + z', by rw [map_add, hz, hz', map_add]⟩
  obtain ⟨z, hz⟩ := key (e.symm ⟨y, hy⟩)
  refine ⟨DirectSum.of (fun d => T.piece d) d z, T.lof_mem_limGrading z, ?_⟩
  rw [proj_of, ← coe_pieceProj, ← hz, LinearEquiv.apply_symm_apply]

/-- The kernel of the projection of the degree-`d` part of the limit to `(A₀)_d` is `I` times it,
for `I` the kernel of the limit projection to `R₀`. -/
theorem mem_smul_of_proj_eq_zero (hT : T.IsAdmissible) {d : ℕ} {z : T.Lim}
    (hz : z ∈ T.limGrading d) (h0 : T.proj 0 z = 0) :
    z ∈ RingHom.ker (limit.π Rg (op 0)).hom • T.limGrading d := by
  obtain ⟨e, he⟩ := (finite_projective_baseChange_piece hT d).2.2 0
  obtain ⟨w, rfl⟩ := hz
  have hw : T.pieceProj d 0 w = 0 := Subtype.ext (by
    rw [coe_pieceProj, ← proj_of]
    exact h0)
  have h1 : (1 : Rg.obj (op 0)) ⊗ₜ[(limit Rg : CommRingCat.{u})] w = 0 :=
    e.injective (by rw [he, hw, smul_zero, map_zero])
  let I := RingHom.ker (limit.π Rg (op 0)).hom
  let q := RingHom.quotientKerEquivOfSurjective (surjective_limit_π_zero hT)
  have hq : ∀ b, q.symm ((limit.π Rg (op 0)).hom b) = Ideal.Quotient.mk I b := fun b => by
    rw [RingEquiv.symm_apply_eq]
    rfl
  let g : Rg.obj (op 0) →ₗ[(limit Rg : CommRingCat.{u})] (limit Rg : CommRingCat.{u}) ⧸ I :=
    { toFun := q.symm
      map_add' := map_add _
      map_smul' := fun b x => by
        show q.symm ((limit.π Rg (op 0)).hom b * x) = Ideal.Quotient.mk I b * q.symm x
        rw [map_mul, hq] }
  let Θ : Rg.obj (op 0) ⊗[(limit Rg : CommRingCat.{u})] T.piece d →ₗ[(limit Rg : CommRingCat.{u})]
      T.piece d ⧸ (I • ⊤ : Submodule (limit Rg : CommRingCat.{u}) (T.piece d)) :=
    (TensorProduct.quotTensorEquivQuotSMul (T.piece d) I).toLinearMap ∘ₗ
      TensorProduct.map g LinearMap.id
  have h2 : Θ (1 ⊗ₜ w) = Submodule.Quotient.mk w := by
    rw [LinearMap.comp_apply, TensorProduct.map_tmul, LinearMap.id_apply]
    have hg1 : g 1 = Ideal.Quotient.mk I 1 := by
      show q.symm 1 = _
      rw [map_one, map_one]
    rw [hg1, LinearEquiv.coe_coe, TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul]
  rw [h1, map_zero, eq_comm, Submodule.Quotient.mk_eq_zero] at h2
  have h5 := Submodule.mem_map_of_mem
    (f := DirectSum.lof (limit Rg : CommRingCat.{u}) ℕ (fun d => T.piece d) d) h2
  rw [Submodule.map_smul''] at h5
  refine Submodule.smul_mono le_rfl ?_ h5
  rintro _ ⟨x, -, rfl⟩
  exact ⟨x, rfl⟩

/-! ### A presentation of the graded inverse limit -/

section Presentation

variable (hT : T.IsAdmissible) {k : ℕ} (w : Fin k → ℕ) (b : Fin k → T.Lim)
  (hb : ∀ j, b j ∈ T.limGrading (w j)) (g : Fin k → T.A 0)
  (hbg : ∀ j, T.proj 0 (b j) = g j) (hg : ∀ j, g j ∈ T.𝒜 0 (w j))
  (hgen : Function.Surjective (aeval (R := Rg.obj (op 0)) g))

include hbg in
/-- Evaluating at the lifts and projecting is reducing the coefficients and evaluating at the
generators. -/
theorem proj_aeval (φ : MvPolynomial (Fin k) (limit Rg : CommRingCat.{u})) :
    T.proj 0 (aeval b φ) = aeval g (map (limit.π Rg (op 0)).hom φ) := by
  have : (T.proj 0).comp (aeval b).toRingHom =
      (aeval g).toRingHom.comp (map (limit.π Rg (op 0)).hom) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) fun j => ?_
    · simp [proj_algebraMap]
    · simp [hbg]
  exact congrArg (fun f => f φ) this

include hT hb hbg hg hgen in
/-- In each degree, the lifts generate the graded inverse limit, by Nakayama's lemma. -/
theorem limGrading_le_map_aeval (d : ℕ) :
    T.limGrading d ≤
      (weightedHomogeneousSubmodule (limit Rg : CommRingCat.{u}) w d).map
        (aeval b).toLinearMap := by
  classical
  have hfg : (T.limGrading d).FG := Module.Finite.iff_fg.mp (finite_limGrading hT d)
  refine Submodule.le_of_le_smul_of_le_jacobson_bot hfg (ker_limit_π_zero_le_jacobson hT) ?_
  intro z hz
  obtain ⟨φ₀, hφ₀⟩ := hgen (T.proj 0 z)
  have h1 : T.proj 0 z = aeval g (weightedHomogeneousComponent w d φ₀) := by
    rw [← coe_decompose_aeval (T.𝒜 0) w g hg φ₀ d, hφ₀,
      DirectSum.decompose_of_mem_same _ (T.proj_mem 0 hz)]
  obtain ⟨φ, hφ, hmap⟩ := exists_isWeightedHomogeneous_map_eq (limit.π Rg (op 0)).hom
    (surjective_limit_π_zero hT) w (weightedHomogeneousComponent_isWeightedHomogeneous d φ₀)
  have hΨφ : aeval b φ ∈ T.limGrading d := aeval_mem_of_isWeightedHomogeneous _ w b hb hφ
  have h2 : T.proj 0 (z - aeval b φ) = 0 := by
    rw [map_sub, proj_aeval b g hbg, hmap, ← h1, sub_self]
  have h3 := mem_smul_of_proj_eq_zero hT (sub_mem hz hΨφ) h2
  exact Submodule.mem_sup.mpr ⟨_, ⟨φ, hφ, rfl⟩, _, h3, add_sub_cancel _ _⟩

include hT hb hbg hg hgen in
/-- The lifts generate the graded inverse limit. -/
theorem surjective_aeval : Function.Surjective (aeval (R := (limit Rg : CommRingCat.{u})) b) := by
  classical
  intro x
  have : x ∈ (aeval (R := (limit Rg : CommRingCat.{u})) b).range := by
    rw [← DirectSum.sum_support_decompose T.limGrading x]
    refine Subalgebra.sum_mem _ fun d _ => ?_
    obtain ⟨φ, -, hφ⟩ := limGrading_le_map_aeval hT w b hb g hbg hg hgen d
      (SetLike.coe_mem (DirectSum.decompose T.limGrading x d))
    exact ⟨φ, hφ⟩
  exact (AlgHom.mem_range _).mp this

include hT hb hbg in
/-- A homogeneous relation among the generators of `A₀` lifts to a homogeneous relation among the
lifts. -/
theorem exists_lift_relation {φ : MvPolynomial (Fin k) (Rg.obj (op 0))} {e : ℕ}
    (hφ : φ.IsWeightedHomogeneous w e) (h0 : aeval g φ = 0)
    (hle : T.limGrading e ≤
      (weightedHomogeneousSubmodule (limit Rg : CommRingCat.{u}) w e).map
        (aeval b).toLinearMap) :
    ∃ G : MvPolynomial (Fin k) (limit Rg : CommRingCat.{u}),
      G.IsWeightedHomogeneous w e ∧ aeval b G = 0 ∧ map (limit.π Rg (op 0)).hom G = φ := by
  obtain ⟨H, hH, hHmap⟩ := exists_isWeightedHomogeneous_map_eq (limit.π Rg (op 0)).hom
    (surjective_limit_π_zero hT) w hφ
  have hΨH : aeval b H ∈ T.limGrading e := aeval_mem_of_isWeightedHomogeneous _ w b hb hH
  have hpH : T.proj 0 (aeval b H) = 0 := by rw [proj_aeval b g hbg, hHmap, h0]
  have h1 := mem_smul_of_proj_eq_zero hT hΨH hpH
  have h2 := Submodule.smul_mono (le_refl (RingHom.ker (limit.π Rg (op 0)).hom)) hle h1
  rw [← Submodule.map_smul''] at h2
  obtain ⟨H', hH', hH'eq⟩ := h2
  refine ⟨H - H', hH.sub (Submodule.smul_le_right hH'), ?_, ?_⟩
  · rw [map_sub, show aeval b H' = aeval b H from hH'eq, sub_self]
  · rw [map_sub, hHmap, map_eq_zero_of_mem_smul _ le_rfl hH', sub_zero]

variable {w} in
include hT hb in
/-- In each degree, the kernel of the presentation is generated by finitely many homogeneous
relations, up to `I` times itself. This is where projectivity of the homogeneous parts of the
limit enters: the degree-`d` kernel is a direct summand. -/
theorem mem_span_of_isWeightedHomogeneous (hw : ∀ j, w j ≠ 0) (d : ℕ)
    (hsurj : T.limGrading d ≤
      (weightedHomogeneousSubmodule (limit Rg : CommRingCat.{u}) w d).map
        (aeval b).toLinearMap)
    {ι : Type*} [Finite ι] (e : ι → ℕ) (F : ι → MvPolynomial (Fin k) (Rg.obj (op 0)))
    (hF : ∀ i, (F i).IsWeightedHomogeneous w (e i))
    (G : ι → MvPolynomial (Fin k) (limit Rg : CommRingCat.{u}))
    (hG : ∀ i, (G i).IsWeightedHomogeneous w (e i)) (hG0 : ∀ i, aeval b (G i) = 0)
    (hGF : ∀ i, map (limit.π Rg (op 0)).hom (G i) = F i)
    (hspan : ∀ ψ : MvPolynomial (Fin k) (limit Rg : CommRingCat.{u}), aeval b ψ = 0 →
      map (limit.π Rg (op 0)).hom ψ ∈ Ideal.span (Set.range F))
    {ψ : MvPolynomial (Fin k) (limit Rg : CommRingCat.{u})} (hψ : ψ.IsWeightedHomogeneous w d)
    (hψ0 : aeval b ψ = 0) : ψ ∈ Ideal.span (Set.range G) := by
  classical
  have := Fintype.ofFinite ι
  let L := (limit Rg : CommRingCat.{u})
  let π := (limit.π Rg (op 0)).hom
  let I := RingHom.ker π
  let Pd := weightedHomogeneousSubmodule L w d
  let K' := Ideal.span (Set.range G)
  let Ψd : Pd →ₗ[L] T.limGrading d := (aeval b).toLinearMap.restrict
    fun x hx => aeval_mem_of_isWeightedHomogeneous _ w b hb hx
  have hΨd : Function.Surjective Ψd := by
    rintro ⟨y, hy⟩
    obtain ⟨φ, hφ, rfl⟩ := hsurj hy
    exact ⟨⟨φ, hφ⟩, rfl⟩
  have := projective_limGrading hT d
  obtain ⟨σ, hσ⟩ := Module.projective_lifting_property Ψd LinearMap.id hΨd
  let r : Pd →ₗ[L] Pd := LinearMap.id - σ ∘ₗ Ψd
  have hr1 : ∀ x, Ψd (r x) = 0 := fun x => by
    simp only [r, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.comp_apply, map_sub]
    rw [← LinearMap.comp_apply Ψd σ, hσ, LinearMap.id_apply, sub_self]
  have hr2 : ∀ x, Ψd x = 0 → r x = x := fun x hx => by
    simp [r, hx]
  let Nd : Submodule L (MvPolynomial (Fin k) L) := (LinearMap.range r).map Pd.subtype
  have hPd : Module.Finite L Pd :=
    Module.Finite.iff_fg.mpr (weightedHomogeneousSubmodule_fg L w hw d)
  have hNfg : Nd.FG := by
    refine Submodule.FG.map _ ?_
    rw [LinearMap.range_eq_map]
    exact (Module.Finite.fg_top).map r
  have hΨd0 : ∀ x : Pd, aeval b (x : MvPolynomial (Fin k) L) = 0 → Ψd x = 0 :=
    fun x hx => Subtype.ext hx
  have hsmul : ∀ x : MvPolynomial (Fin k) L, x ∈ I • Pd → aeval b x = 0 → x ∈ I • Nd := by
    intro x hx hx0
    rw [← Submodule.map_subtype_top Pd, ← Submodule.map_smul''] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    have hy' : y ∈ (I • ⊤ : Submodule L Pd).map r := ⟨y, hy, hr2 y (hΨd0 y hx0)⟩
    rw [Submodule.map_smul'', ← LinearMap.range_eq_map] at hy'
    have := Submodule.mem_map_of_mem (f := Pd.subtype) hy'
    rwa [Submodule.map_smul''] at this
  have hNd : Nd ≤ K'.restrictScalars L := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot hNfg (ker_limit_π_zero_le_jacobson hT) ?_
    rintro _ ⟨y, ⟨z, rfl⟩, rfl⟩
    set φ : MvPolynomial (Fin k) L := ((r z : Pd) : MvPolynomial (Fin k) L) with hφdef
    have hφd : φ.IsWeightedHomogeneous w d := (r z).2
    have hφ0 : aeval b φ = 0 := congrArg Subtype.val (hr1 z)
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hspan φ hφ0)
    have hcomp : ∀ i, weightedHomogeneousComponent w d (c i * F i) =
        if e i ≤ d then weightedHomogeneousComponent w (d - e i) (c i) * F i else 0 := by
      intro i
      rw [← weightedDecomposition.decompose'_apply, ← weightedDecomposition.decompose'_apply]
      split_ifs with h
      · exact DirectSum.coe_decompose_mul_of_right_mem_of_le _ (hF i) h
      · exact DirectSum.coe_decompose_mul_of_right_mem_of_not_le _ (hF i) h
    choose C hC hCmap using fun i => exists_isWeightedHomogeneous_map_eq π
      (surjective_limit_π_zero hT) w (weightedHomogeneousComponent_isWeightedHomogeneous
        (d - e i) (c i))
    let T' : MvPolynomial (Fin k) L := ∑ i, if e i ≤ d then C i * G i else 0
    have hT'K : T' ∈ K' := Ideal.sum_mem _ fun i _ => by
      split_ifs
      · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
      · exact zero_mem _
    have hT'd : T'.IsWeightedHomogeneous w d := by
      refine (weightedHomogeneousSubmodule L w d).sum_mem fun i _ => ?_
      split_ifs with h
      · have := (hC i).mul (hG i)
        rwa [Nat.sub_add_cancel h] at this
      · exact zero_mem _
    have hT'0 : aeval b T' = 0 := by
      simp only [T', map_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      split_ifs
      · rw [map_mul, hG0, mul_zero]
      · exact map_zero _
    have hT'map : map π T' = map π φ := by
      have hd' : map π φ = weightedHomogeneousComponent w d (map π φ) :=
        ((isWeightedHomogeneous_map π hφd).weightedHomogeneousComponent_same).symm
      rw [hd', ← hc, map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hcomp]
      split_ifs
      · rw [map_mul, hCmap, hGF]
      · exact map_zero _
    have hψ₁ : φ - T' ∈ I • Pd :=
      mem_smul_weightedHomogeneousSubmodule π le_rfl (hφd.sub hT'd)
        (by rw [map_sub, hT'map, sub_self])
    have hψ₁' := hsmul _ hψ₁ (by rw [map_sub, hφ0, hT'0, sub_self])
    exact Submodule.mem_sup.mpr ⟨T', hT'K, _, hψ₁', add_sub_cancel _ _⟩
  refine hNd ⟨⟨ψ, hψ⟩, ⟨⟨ψ, hψ⟩, hr2 _ (hΨd0 _ hψ0)⟩, rfl⟩

end Presentation

/-- **The graded inverse limit of an admissible tower is a finitely presented algebra** over the
limit ring. This is the claim at the end of the proof of Stacks Tag 0D4T. -/
theorem finitePresentation_lim (hT : T.IsAdmissible) :
    Algebra.FinitePresentation (limit Rg : CommRingCat.{u}) T.Lim := by
  classical
  have := hT.finitePresentation
  let L := (limit Rg : CommRingCat.{u})
  let π := (limit.π Rg (op 0)).hom
  obtain ⟨k, w, g, hg, hw, hadj⟩ := exists_homogeneous_generators (T.𝒜 0) fun x hx =>
    ⟨_, congrArg Subtype.val ((hT.zero_bijective 0).2 ⟨x, hx⟩).choose_spec⟩
  choose b hb hbg using fun j => exists_proj_eq hT (hg j)
  have hgen : Function.Surjective (aeval (R := Rg.obj (op 0)) g) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hadj]
  have hsurj := limGrading_le_map_aeval hT w b hb g hbg hg hgen
  -- homogeneous generators of the kernel of `aeval g`
  obtain ⟨S₀, hS₀⟩ := Algebra.FinitePresentation.ker_fG_of_surjective
    (aeval (R := Rg.obj (op 0)) g) hgen
  let Fs : Finset (ℕ × MvPolynomial (Fin k) (Rg.obj (op 0))) := S₀.biUnion fun f =>
    (DirectSum.decompose (weightedHomogeneousSubmodule (Rg.obj (op 0)) w) f).support.image
      fun i => (i, weightedHomogeneousComponent w i f)
  have hFs : ∀ p ∈ Fs, p.2.IsWeightedHomogeneous w p.1 ∧ aeval g p.2 = 0 := by
    intro p hp
    simp only [Fs, Finset.mem_biUnion, Finset.mem_image] at hp
    obtain ⟨f, hf, i, -, rfl⟩ := hp
    refine ⟨weightedHomogeneousComponent_isWeightedHomogeneous _ _, ?_⟩
    have hf0 : aeval g f = 0 :=
      (hS₀ ▸ Ideal.subset_span hf : f ∈ RingHom.ker (aeval (R := Rg.obj (op 0)) g).toRingHom)
    rw [← coe_decompose_aeval (T.𝒜 0) w g hg f i, hf0, DirectSum.decompose_zero,
      DirectSum.zero_apply, ZeroMemClass.coe_zero]
  let e : Fs → ℕ := fun p => p.1.1
  let F : Fs → MvPolynomial (Fin k) (Rg.obj (op 0)) := fun p => p.1.2
  have hspan : RingHom.ker (aeval (R := Rg.obj (op 0)) g).toRingHom ≤ Ideal.span (Set.range F) := by
    rw [← hS₀, Ideal.span_le]
    intro f hf
    rw [← DirectSum.sum_support_decompose (weightedHomogeneousSubmodule (Rg.obj (op 0)) w) f]
    refine Ideal.sum_mem _ fun i hi => Ideal.subset_span ⟨⟨(i, weightedHomogeneousComponent w i f),
      ?_⟩, ?_⟩
    · simp only [Fs, Finset.mem_biUnion, Finset.mem_image]
      exact ⟨f, hf, i, hi, rfl⟩
    · exact (weightedDecomposition.decompose'_apply _ w f i).symm
  choose G hG hG0 hGF using fun p : Fs => exists_lift_relation hT w b hb g hbg
    (hFs p.1 p.2).1 (hFs p.1 p.2).2 (hsurj p.1.1)
  have hker : RingHom.ker (aeval (R := L) b).toRingHom = Ideal.span (Set.range G) := by
    refine le_antisymm (fun φ hφ => ?_) (Ideal.span_le.mpr ?_)
    · have hφ0 : aeval b φ = 0 := hφ
      rw [← DirectSum.sum_support_decompose (weightedHomogeneousSubmodule L w) φ]
      refine Ideal.sum_mem _ fun d _ => ?_
      rw [← DirectSum.Decomposition.decompose'_eq, weightedDecomposition.decompose'_apply]
      refine mem_span_of_isWeightedHomogeneous hT b hb hw d (hsurj d) e F
        (fun p => (hFs p.1 p.2).1) G hG hG0 hGF (fun ψ hψ => hspan (by
          show aeval g (map π ψ) = 0
          rw [← proj_aeval b g hbg, hψ, map_zero]))
        (weightedHomogeneousComponent_isWeightedHomogeneous d φ) ?_
      rw [← coe_decompose_aeval T.limGrading w b hb, hφ0, DirectSum.decompose_zero,
        DirectSum.zero_apply, ZeroMemClass.coe_zero]
    · rintro _ ⟨p, rfl⟩
      exact hG0 p
  exact Algebra.FinitePresentation.of_surjective
    (surjective_aeval hT w b hb g hbg hg hgen)
    (hker ▸ Submodule.fg_span (Set.finite_range G))

end GradedTower

end Stacks.GradedTowerLimit
