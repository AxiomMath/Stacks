/-!
# Nagata's Noetherian ring of infinite dimension

Let `k` be a field and `R = k[x_v : v]` the polynomial ring in countably many variables, the
variables being partitioned into finite blocks `B_0, B_1, …` with `|B_i| = 2^i`. Let `𝔭_i ⊆ R` be
the prime ideal generated by the variables of the block `B_i`, let `S = ⋂_i (R ∖ 𝔭_i)` and let
`N = S⁻¹ R`. This is the ring of Nagata's example (Stacks, Examples, Section 02JC).

## Main definitions

* `NagataRing.Var`: the variables, `Σ i : ℕ, Fin (2 ^ i)`, the block `B_i` being the fibre over
  `i`.
* `NagataRing.prime k i`: the ideal `𝔭_i` generated by the variables of the block `B_i`.
* `NagataRing.submonoid k`: the multiplicative set `S = ⋂_i (R ∖ 𝔭_i)`.
* `NagataRing k`: the ring `N = S⁻¹ R`.

## Main results

* `NagataRing.exists_le_prime_of_forall_mem`: an ideal of `R` contained in `⋃_i 𝔭_i` is
  contained in one of the `𝔭_i`.
* `NagataRing.exists_field_essFiniteType`: every localization of `N` at a prime ideal is
  essentially of finite type over a field. Explicitly, if `P` lies over a prime inside `𝔭_i`,
  then `N_P` is a localization of a polynomial ring over the fraction field of the polynomial
  ring in the variables outside `B_i`, in the `2^i` variables of `B_i`.
* `NagataRing.isNoetherianRing`: `N` is Noetherian (Nagata's criterion).
* `NagataRing.isDomain`: `N` is a domain.
* `NagataRing.ringKrullDim_eq_top`: `N` has infinite Krull dimension.
* `NagataRing.isUniversallyCatenary`: `N` is universally catenary.

## Implementation notes

The source indexes the variables by the positive integers, the `i`-th block being
`x_{2^{i-1}}, …, x_{2^i - 1}`; here the `i`-th block is indexed by `Fin (2 ^ i)` for `i ≥ 0`, so
the source's `𝔭_{i+1}` is `NagataRing.prime k i`.

## References

* M. Nagata, *Local rings*, Appendix, Example 1.
* [Stacks Project, Tag 02JC](https://stacks.math.columbia.edu/tag/02JC)
-/

@[expose] public noncomputable section

universe u

open MvPolynomial

namespace NagataRing

/-- The variables of Nagata's ring: the block `B_i` consists of the `2 ^ i` variables over `i`. -/
abbrev Var : Type := Σ i : ℕ, Fin (2 ^ i)

/-- The `i`-th block of variables. -/
def block (i : ℕ) : Set Var := {v | v.1 = i}

/-- A variable lies in the `i`-th block if and only if its first component is `i`. -/
@[simp]
theorem mem_block {i : ℕ} {v : Var} : v ∈ block i ↔ v.1 = i :=
  Iff.rfl

/-- Each block of variables is finite. -/
theorem finite_block (i : ℕ) : (block i).Finite := by
  refine (Set.finite_range (fun a : Fin (2 ^ i) => (⟨i, a⟩ : Var))).subset ?_
  rintro ⟨j, a⟩ hj
  simp only [mem_block] at hj
  subst hj
  exact ⟨a, rfl⟩

variable (k : Type u) [Field k]

/-- The prime ideal `𝔭_i` generated by the variables of the `i`-th block. -/
def prime (i : ℕ) : Ideal (MvPolynomial Var k) :=
  Ideal.span (X '' block i)

/-- The ideal `𝔭_i` is prime. -/
instance (i : ℕ) : (prime k i).IsPrime :=
  isPrime_span_X_image (R := k) _

/-- The multiplicative set `S = ⋂_i (R ∖ 𝔭_i)`. -/
def submonoid : Submonoid (MvPolynomial Var k) :=
  ⨅ i, (prime k i).primeCompl

variable {k}

/-- A polynomial lies in `S` if and only if it lies in none of the `𝔭_i`. -/
theorem mem_submonoid {f : MvPolynomial Var k} : f ∈ submonoid k ↔ ∀ i, f ∉ prime k i := by
  simp [submonoid, Submonoid.mem_iInf, Ideal.primeCompl]

/-- The multiplicative set `S` is disjoint from each `𝔭_i`. -/
theorem disjoint_submonoid_prime (i : ℕ) :
    Disjoint (submonoid k : Set (MvPolynomial Var k)) (prime k i) :=
  Set.disjoint_left.mpr fun _ hf => mem_submonoid.mp hf i

/-- A polynomial lies in `𝔭_i` if and only if killing the variables of the `i`-th block
sends it to zero. -/
private theorem mem_prime_iff_killSet {f : MvPolynomial Var k} {i : ℕ} :
    f ∈ prime k i ↔ killSet k (block i) f = 0 :=
  mem_span_X_image_iff_killSet

/-- A nonzero polynomial lies in `𝔭_i` only if it involves a variable of the `i`-th block. -/
theorem mem_image_vars_of_mem_prime {f : MvPolynomial Var k} (hf : f ≠ 0) {i : ℕ}
    (hi : f ∈ prime k i) : i ∈ f.vars.image Sigma.fst := by
  by_contra h
  apply hf
  rw [mem_prime_iff_killSet] at hi
  rw [← hi, killSet_eq_self]
  intro v hv hvi
  exact h (Finset.mem_image.mpr ⟨v, hv, hvi⟩)

/-- **Avoidance for the primes `𝔭_i`.** An ideal of `R` each of whose elements lies in one of the
`𝔭_i` is contained in one of the `𝔭_i`. -/
theorem exists_le_prime_of_forall_mem (I : Ideal (MvPolynomial Var k))
    (hI : ∀ f ∈ I, ∃ i, f ∈ prime k i) : ∃ i, I ≤ prime k i := by
  classical
  by_cases hI0 : I = ⊥
  · exact ⟨0, hI0 ▸ bot_le⟩
  obtain ⟨f, hfI, hf⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI0
  let F : Finset ℕ := f.vars.image Sigma.fst
  suffices h : (I : Set (MvPolynomial Var k)) ⊆ ⋃ i ∈ (F : Set ℕ), (prime k i : Set _) by
    obtain ⟨i, -, hi⟩ := (Ideal.subset_union_prime_finite F.finite_toSet 0 0
      (fun i _ _ _ => inferInstance)).mp h
    exact ⟨i, hi⟩
  intro g hgI
  obtain ⟨j, hj⟩ := Infinite.exists_notMem_finset (F ∪ g.vars.image Sigma.fst)
  rw [Finset.mem_union, not_or] at hj
  let t : Var := ⟨j, ⟨0, Nat.two_pow_pos j⟩⟩
  have hft : ∀ v ∈ f.vars, v ∉ block j := fun v hv hvj =>
    hj.1 (Finset.mem_image.mpr ⟨v, hv, hvj⟩)
  obtain ⟨l, hl⟩ := hI _ (I.add_mem hfI (I.mul_mem_left (X t) hgI))
  rw [mem_prime_iff_killSet, map_add, map_mul] at hl
  by_cases hlj : l = j
  · subst hlj
    rw [killSet_eq_self hft, killSet_X_of_mem (show t ∈ block l from rfl), zero_mul,
      add_zero] at hl
    exact absurd hl hf
  · have htl : t ∉ block l := fun h => hlj h.symm
    rw [killSet_X_of_notMem htl] at hl
    have hfl : killSet k (block l) f = 0 := by
      have := congrArg (killSet k (block j)) hl
      rwa [map_add, map_mul, killSet_X_of_mem (show t ∈ block j from rfl), zero_mul, add_zero,
        killSet_killSet, killSet_eq_self hft, map_zero] at this
    rw [hfl, zero_add, mul_eq_zero] at hl
    exact Set.mem_biUnion (mem_image_vars_of_mem_prime hf (mem_prime_iff_killSet.mpr hfl))
      (mem_prime_iff_killSet.mpr (hl.resolve_left (X_ne_zero t)))

end NagataRing

variable (k : Type u) [Field k]

/-- **Nagata's ring** `N = S⁻¹ k[x_v : v]`, where `S` is the complement of the union of the primes
`𝔭_i` generated by the blocks of variables. -/
abbrev NagataRing : Type u :=
  Localization (NagataRing.submonoid k)

namespace NagataRing

variable {k}

/-- The contraction to `R` of a prime ideal of `N` is contained in some `𝔭_i`. -/
theorem exists_comap_le_prime (P : Ideal (NagataRing k)) [P.IsPrime] :
    ∃ i, P.comap (algebraMap (MvPolynomial Var k) (NagataRing k)) ≤ prime k i := by
  refine exists_le_prime_of_forall_mem _ fun f hf => ?_
  by_contra h
  simp only [not_exists] at h
  exact ‹P.IsPrime›.ne_top (Ideal.eq_top_of_isUnit_mem P (Ideal.mem_comap.mp hf)
    (IsLocalization.map_units (NagataRing k) ⟨f, mem_submonoid.mpr h⟩))

/-- The polynomial ring in the variables outside the `i`-th block. -/
abbrev Outside (k : Type u) [Field k] (i : ℕ) : Type u :=
  MvPolynomial {v : Var // v.1 ≠ i} k

/-- A nonzero polynomial in the variables outside the `i`-th block does not lie in `𝔭_i`. -/
theorem rename_notMem_prime {i : ℕ} {a : Outside k i} (ha : a ≠ 0) :
    rename Subtype.val a ∉ prime k i := by
  rw [mem_prime_iff_killSet, killSet_eq_self]
  · exact (map_ne_zero_iff _ (rename_injective _ Subtype.val_injective)).mpr ha
  · intro v hv hvi
    obtain ⟨w, -, rfl⟩ := mem_vars_rename _ _ hv
    exact w.2 hvi

/-- The polynomial ring in all the variables, as an algebra over the polynomial ring in the
variables outside the `i`-th block. -/
@[instance_reducible]
def outsideAlgebra (i : ℕ) : Algebra (Outside k i) (MvPolynomial Var k) :=
  (rename (R := k) (Subtype.val : {v : Var // v.1 ≠ i} → Var)).toRingHom.toAlgebra

attribute [local instance] outsideAlgebra

/-- The algebra map from the polynomial ring in the variables outside the `i`-th block is
renaming of variables. -/
theorem algebraMap_outside_apply {i : ℕ} (a : Outside k i) :
    algebraMap (Outside k i) (MvPolynomial Var k) a = rename Subtype.val a :=
  rfl

/-- The polynomial ring in all the variables is of finite type over the polynomial ring in the
variables outside the `i`-th block. -/
theorem finiteType_outside (i : ℕ) : Algebra.FiniteType (Outside k i) (MvPolynomial Var k) := by
  classical
  refine ⟨⟨((finite_block i).image (X : Var → MvPolynomial Var k)).toFinset, ?_⟩⟩
  rw [eq_top_iff]
  rintro f -
  induction f using MvPolynomial.induction_on with
  | C a =>
    have : (C a : MvPolynomial Var k) = algebraMap (Outside k i) (MvPolynomial Var k) (C a) := by
      rw [algebraMap_outside_apply, rename_C]
    rw [this]
    exact Subalgebra.algebraMap_mem _ _
  | add p q hp hq => exact add_mem hp hq
  | mul_X p v hp =>
    refine mul_mem hp ?_
    by_cases hv : v.1 = i
    · exact Algebra.subset_adjoin (by simpa using hv)
    · have : (X v : MvPolynomial Var k) =
          algebraMap (Outside k i) (MvPolynomial Var k) (X ⟨v, hv⟩) := by
        rw [algebraMap_outside_apply, rename_X]
      rw [this]
      exact Subalgebra.algebraMap_mem _ _

/-- **The local rings of Nagata's ring are essentially of finite type over a field.** For every
prime `P` of `N` there is a field `K` such that `N_P` is a `K`-algebra essentially of finite
type. -/
theorem exists_field_essFiniteType (P : Ideal (NagataRing k)) [P.IsPrime] :
    ∃ (K : Type u) (_ : Field K) (_ : Algebra K (Localization.AtPrime P)),
      Algebra.EssFiniteType K (Localization.AtPrime P) := by
  obtain ⟨i, hi⟩ := exists_comap_le_prime P
  have := finiteType_outside (k := k) i
  have : Algebra.EssFiniteType (MvPolynomial Var k) (NagataRing k) :=
    .of_isLocalization _ (submonoid k)
  have : Algebra.EssFiniteType (Outside k i) (NagataRing k) :=
    .comp _ (MvPolynomial Var k) _
  have : Algebra.EssFiniteType (NagataRing k) (Localization.AtPrime P) :=
    .of_isLocalization _ P.primeCompl
  have : Algebra.EssFiniteType (Outside k i) (Localization.AtPrime P) :=
    .comp _ (NagataRing k) _
  have hunit : ∀ a : nonZeroDivisors (Outside k i),
      IsUnit (algebraMap (Outside k i) (Localization.AtPrime P) a) := by
    intro a
    rw [IsScalarTower.algebraMap_apply (Outside k i) (NagataRing k) (Localization.AtPrime P),
      IsScalarTower.algebraMap_apply (Outside k i) (MvPolynomial Var k) (NagataRing k),
      IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P) P]
    exact fun hmem => rename_notMem_prime (nonZeroDivisors.ne_zero a.2) (hi hmem)
  let : Algebra (FractionRing (Outside k i)) (Localization.AtPrime P) :=
    (IsLocalization.lift (M := nonZeroDivisors (Outside k i)) (S := FractionRing (Outside k i))
      hunit).toAlgebra
  have : IsScalarTower (Outside k i) (FractionRing (Outside k i)) (Localization.AtPrime P) :=
    IsScalarTower.of_algebraMap_eq fun a => (IsLocalization.lift_eq hunit a).symm
  exact ⟨FractionRing (Outside k i), inferInstance, inferInstance,
    .of_comp (Outside k i) (FractionRing (Outside k i)) _⟩

/-- Nagata's ring is a domain. -/
instance isDomain : IsDomain (NagataRing k) :=
  IsLocalization.isDomain_localization fun _ hf => mem_nonZeroDivisors_of_ne_zero fun h0 =>
    mem_submonoid.mp hf 0 (h0 ▸ zero_mem _)

/-- **Nagata's ring is Noetherian.** -/
instance isNoetherianRing : IsNoetherianRing (NagataRing k) := by
  refine isNoetherianRing_of_localization_maximal_of_finite (fun m _ => ?_) (fun a ha => ?_)
  · obtain ⟨K, _, _, _⟩ := exists_field_essFiniteType m
    exact Algebra.EssFiniteType.isNoetherianRing K _
  · obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective (submonoid k) a
    have hr : r ≠ 0 := by
      rintro rfl
      exact ha (IsLocalization.mk'_zero _)
    refine ((r.vars.image Sigma.fst).finite_toSet.image
      fun i => (prime k i).map (algebraMap _ (NagataRing k))).subset ?_
    rintro m ⟨hm, ham⟩
    have : m.IsPrime := hm.isPrime
    obtain ⟨i, hi⟩ := exists_comap_le_prime m
    have hprime : ((prime k i).map (algebraMap _ (NagataRing k))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (submonoid k) _ _ inferInstance
        (disjoint_submonoid_prime i)
    have hle : m ≤ (prime k i).map (algebraMap _ (NagataRing k)) := by
      calc m = (m.comap (algebraMap _ (NagataRing k))).map (algebraMap _ (NagataRing k)) :=
            (IsLocalization.map_under (submonoid k) _ m).symm
        _ ≤ _ := Ideal.map_mono hi
    have heq := hm.eq_of_le hprime.ne_top hle
    have hrm : algebraMap _ (NagataRing k) r ∈ m := by
      rw [← IsLocalization.mk'_spec (NagataRing k) r s]
      exact m.mul_mem_right _ ham
    exact ⟨i, mem_image_vars_of_mem_prime hr (hi hrm), heq.symm⟩

/-- **Nagata's ring has infinite Krull dimension.** -/
theorem ringKrullDim_eq_top : ringKrullDim (NagataRing k) = ⊤ := by
  rw [ringKrullDim, ENat.WithBot.eq_top_iff_forall_ge]
  intro n
  let s : Fin (n + 1) → Set Var := fun j => {v | v.1 = n ∧ v.2.val < j.val}
  have hdisj : ∀ j, Disjoint (submonoid k : Set (MvPolynomial Var k))
      (Ideal.span (X '' s j) : Ideal (MvPolynomial Var k)) := fun j =>
    (disjoint_submonoid_prime n).mono_right
      (Ideal.span_mono (Set.image_mono fun v hv => hv.1))
  let q : Fin (n + 1) → {p : PrimeSpectrum (MvPolynomial Var k) //
      Disjoint (submonoid k : Set (MvPolynomial Var k)) p.asIdeal} := fun j =>
    ⟨⟨Ideal.span (X '' s j), inferInstance⟩, hdisj j⟩
  have hq : StrictMono q := by
    intro j j' hjj'
    rw [Subtype.mk_lt_mk, ← PrimeSpectrum.asIdeal_lt_asIdeal, IsConcreteLE.lt_iff_le_and_exists]
    have hj : j.val < 2 ^ n := (Nat.lt_succ_iff.mp j.2).trans_lt n.lt_two_pow_self
    refine ⟨Ideal.span_mono (Set.image_mono fun v hv => ⟨hv.1, hv.2.trans hjj'⟩),
      X ⟨n, ⟨j.val, hj⟩⟩, ?_, ?_⟩
    · exact X_mem_span_X_image_iff.mpr ⟨rfl, hjj'⟩
    · exact fun h => (lt_irrefl j.val) (X_mem_span_X_image_iff.mp h).2
  let Q := fun j => (IsLocalization.primeSpectrumOrderIso (submonoid k) (NagataRing k)).symm (q j)
  have hQ : StrictMono Q := (OrderIso.strictMono _).comp hq
  exact Order.le_krullDim_iff.mpr ⟨⟨n, Q, fun _ => hQ Fin.castSucc_lt_succ⟩, rfl⟩

/-- **Nagata's ring is universally catenary.** -/
theorem isUniversallyCatenary : Ring.IsUniversallyCatenary (NagataRing k) :=
  Ring.IsUniversallyCatenary.of_forall_essFiniteType_field fun P _ => exists_field_essFiniteType P

end NagataRing
