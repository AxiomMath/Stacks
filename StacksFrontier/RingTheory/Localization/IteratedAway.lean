module

public import Mathlib.Algebra.Module.LocalizedModule.Away
public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import StacksCore.Algebra.Module.LocalizedModule.Basic

/-!
# Iterated localization of a module away from two elements

Let `R` be a commutative ring, let `a, b ∈ R` and let `M` be an `R`-module. Inverting `b` and then
`a` inverts exactly the same elements as inverting the single product `a * b`, so the iterated
localization `(M_b)_a` is canonically the localization `M_{ab}`:

`LocalizedModule (powers a) (LocalizedModule (powers b) M) ≃ₗ[R] LocalizedModule (powers (a*b)) M`.

The content is that the composite `M → M_b → (M_b)_a` of the two canonical maps is itself a
localization of `M` at the powers of `a * b`. Both `a` and `b` act invertibly on the iterated
localization, every element of it is `(ab)^n`-divisible by the image of an element of `M`, and an
element of `M` killed by the composite is killed by a power of `a * b`: a power of `a` kills its
image in `M_b`, and a power of `b` then kills the resulting element of `M`.

The exponent bookkeeping is uniform: all three statements are settled by writing
`(a*b)^{n+k} = (a^k b^n)(b^k a^n)`, which separates the power of `a` that the outer localization
supplies from the power of `b` that the inner one supplies.

## Main definitions

* `LocalizedModule.iteratedAwayMk` — the composite `M → M_b → (M_b)_a`.
* `LocalizedModule.iteratedAwayEquiv` — the identification `(M_b)_a ≃ₗ[R] M_{ab}`.

## Main results

* `LocalizedModule.isLocalizedModule_iteratedAwayMk` — **the composite is a localization at the
  powers of `a * b`**.
* `LocalizedModule.iteratedAwayEquiv_mk_mk` — the identification sends the generator
  `(m/1)/1` of `(M_b)_a` to the generator `m/1` of `M_{ab}`.

## Implementation notes

The invertible-scalar step is imported from the reviewed library rather than restated.

The localizing submonoid is `Submonoid.powers (a * b)` rather than the submonoid generated by `a`
and `b`. The two differ, but they have the same localization; working with the product keys into
the `IsLocalizedModule.Away` API, and in particular into
`IsLocalizedModule.Away.mk_of_addCommGroup`, which is what reduces the instance to the three
statements above.
-/

@[expose] public noncomputable section

universe u v

namespace LocalizedModule

variable {R : Type u} [CommRing R]

/-! ### Invertible scalars survive localization

The statement that an element acting invertibly on a module acts invertibly on every
localization of it is `LocalizedModule.isUnit_algebraMap_end_of_isUnit`, already proved in
the reviewed library at `StacksCore/Algebra/Module/LocalizedModule/Basic.lean` and imported
here. It is stated there for `[AddCommMonoid N]`, which is more general than this file
needs. -/

variable (M : Type v) [AddCommGroup M] [Module R M]

/-! ### The iterated localization -/

/-- The exponent bookkeeping shared by the divisibility and kernel statements below:
`(a*b)^{n+k} = (a^k b^n)(b^k a^n)`. -/
private theorem mul_pow_add_smul {N : Type*} [AddCommMonoid N] [Module R N] (a b : R)
    (n k : ℕ) (x : N) : (a * b) ^ (n + k) • x = (a ^ k * b ^ n) • b ^ k • a ^ n • x := by
  rw [smul_smul, smul_smul]
  congr 1
  ring

/-- The composite `M → M_b → (M_b)_a` of the two canonical localization maps. -/
abbrev iteratedAwayMk (a b : R) :
    M →ₗ[R] LocalizedModule (Submonoid.powers a)
      (LocalizedModule (Submonoid.powers b) M) :=
  (LocalizedModule.mkLinearMap (Submonoid.powers a)
      (LocalizedModule (Submonoid.powers b) M)).comp
    (LocalizedModule.mkLinearMap (Submonoid.powers b) M)

/-- Both `a` and `b` act invertibly on the iterated localization `(M_b)_a`, hence so does their
product. -/
theorem isUnit_algebraMap_end_iterated (a b : R) :
    IsUnit (algebraMap R (Module.End R (LocalizedModule (Submonoid.powers a)
      (LocalizedModule (Submonoid.powers b) M))) (a * b)) := by
  rw [map_mul]
  exact (IsLocalizedModule.map_units
      (LocalizedModule.mkLinearMap (Submonoid.powers a)
        (LocalizedModule (Submonoid.powers b) M)) ⟨a, Submonoid.mem_powers a⟩).mul
    (isUnit_algebraMap_end_of_isUnit _
      (IsLocalizedModule.map_units (LocalizedModule.mkLinearMap (Submonoid.powers b) M)
        ⟨b, Submonoid.mem_powers b⟩))

/-- Every element of the iterated localization `(M_b)_a` becomes the image of an element of `M`
after multiplication by a power of `a * b`: the outer localization supplies a power of `a` and the
inner one a power of `b`. -/
theorem exists_pow_smul_eq_iteratedAwayMk (a b : R)
    (x : LocalizedModule (Submonoid.powers a) (LocalizedModule (Submonoid.powers b) M)) :
    ∃ (n : ℕ) (y : M), (a * b) ^ n • x = iteratedAwayMk M a b y := by
  obtain ⟨n, z, hz⟩ := IsLocalizedModule.Away.surj
    (LocalizedModule.mkLinearMap (Submonoid.powers a)
      (LocalizedModule (Submonoid.powers b) M)) a x
  obtain ⟨k, y, hy⟩ := IsLocalizedModule.Away.surj
    (LocalizedModule.mkLinearMap (Submonoid.powers b) M) b z
  have h : b ^ k • a ^ n • x = iteratedAwayMk M a b y := by
    rw [hz, ← map_smul, hy]
    rfl
  exact ⟨n + k, a ^ k • b ^ n • y, by rw [mul_pow_add_smul, h, ← map_smul, mul_smul]⟩

/-- An element of `M` killed by the composite `M → M_b → (M_b)_a` is killed by a power of
`a * b`: a power of `a` kills its image in `M_b`, and a power of `b` then kills the resulting
element of `M`. -/
theorem exists_pow_smul_eq_zero_of_iteratedAwayMk_eq_zero (a b : R) {x : M}
    (hx : iteratedAwayMk M a b x = 0) : ∃ n : ℕ, (a * b) ^ n • x = 0 := by
  obtain ⟨s, hsS, hs⟩ := LocalizedModule.mem_ker_mkLinearMap_iff.1
    (show LocalizedModule.mkLinearMap (Submonoid.powers b) M x ∈
      LinearMap.ker (LocalizedModule.mkLinearMap (Submonoid.powers a)
        (LocalizedModule (Submonoid.powers b) M)) from hx)
  obtain ⟨n, rfl⟩ := hsS
  rw [← map_smul] at hs
  obtain ⟨t, htS, ht⟩ := LocalizedModule.mem_ker_mkLinearMap_iff.1
    (LinearMap.mem_ker.2 hs)
  obtain ⟨k, rfl⟩ := htS
  exact ⟨n + k, by rw [mul_pow_add_smul, ht, smul_zero]⟩

/-- **Inverting `b` and then `a` is inverting `a * b`.** The composite `M → M_b → (M_b)_a` of the
two canonical maps exhibits the iterated localization as the localization of `M` at the powers of
the product `a * b`. -/
instance isLocalizedModule_iteratedAwayMk (a b : R) :
    IsLocalizedModule (Submonoid.powers (a * b)) (iteratedAwayMk M a b) :=
  IsLocalizedModule.Away.mk_of_addCommGroup (isUnit_algebraMap_end_iterated M a b)
    (exists_pow_smul_eq_iteratedAwayMk M a b)
    fun _ hx => exists_pow_smul_eq_zero_of_iteratedAwayMk_eq_zero M a b hx

/-- **The iterated localization**: localizing `M` away from `b` and then away from `a` gives the
localization of `M` away from the product `a * b`. -/
def iteratedAwayEquiv (a b : R) :
    LocalizedModule (Submonoid.powers a) (LocalizedModule (Submonoid.powers b) M) ≃ₗ[R]
      LocalizedModule (Submonoid.powers (a * b)) M :=
  IsLocalizedModule.linearEquiv (Submonoid.powers (a * b)) (iteratedAwayMk M a b)
    (LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) M)

/-- The identification carries the generator `(m/1)/1` of `(M_b)_a` to the generator `m/1` of
`M_{ab}`. -/
theorem iteratedAwayEquiv_iteratedAwayMk (a b : R) (m : M) :
    iteratedAwayEquiv M a b (iteratedAwayMk M a b m)
      = LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) M m :=
  IsLocalizedModule.linearEquiv_apply _ _ _ m

/-- The identification, written out on the canonical generators. -/
theorem iteratedAwayEquiv_mk_mk (a b : R) (m : M) :
    iteratedAwayEquiv M a b (LocalizedModule.mk (LocalizedModule.mk m 1) 1)
      = LocalizedModule.mk m 1 :=
  iteratedAwayEquiv_iteratedAwayMk M a b m

end LocalizedModule

end
