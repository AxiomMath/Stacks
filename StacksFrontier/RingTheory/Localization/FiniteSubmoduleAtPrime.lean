module

public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Localization.Integer

/-!
# A finite module over a localization comes from a finite module downstairs

Let `q` be a prime of a ring `P`, let `B` be the localization of `P` at `q`, and let `N` be a
finite `B`-module.  Then the `P`-submodule of `N` generated by a finite `B`-generating set is a
finitely generated `P`-module whose localization at `q` is `N` itself.

This is the spreading-out step at the start of the proof of Stacks 05U7: the finite module `N`
over the essentially-of-finite-type local algebra `B` has to be realised as a finite module over
a finite-type algebra, so that it becomes the module of sections of a finite-type quasi-coherent
sheaf on a finite-type scheme over the base.

## Main results

* `isUnit_algebraMap_end_of_mem_primeCompl`: an element outside `q` acts invertibly on any
  module over the localization of `P` at `q`.
* `Submodule.isLocalizedModule_subtype_span_of_span_eq_top`: the `P`-span of a `B`-generating
  set of `N` is a `q`-localization of `N`.
* `exists_fg_submodule_isLocalizedModule_atPrime`: the resulting existence statement.

## Implementation notes

The three fields of `IsLocalizedModule q.primeCompl N₀.subtype` are checked directly.  The
`map_units` field is a statement about the *target* `N`, not about `N₀` — which is essential,
since `N₀` is only a `P`-submodule and the inverse of an element of `q.primeCompl` does not
preserve it.  Surjectivity up to a denominator is
`IsLocalization.exist_integer_multiples_of_finite` applied to the finitely many `B`-coefficients
of an element, and the third field is trivial because the map is an inclusion.

## References

* [Stacks Project, Tag 05U7](https://stacks.math.columbia.edu/tag/05U7)
-/

@[expose] public section

universe u v w

/-- An element of `q.primeCompl` acts invertibly on any module over the localization of `P`
at `q`. -/
theorem isUnit_algebraMap_end_of_mem_primeCompl {P : Type u} [CommRing P] (q : Ideal P)
    [q.IsPrime] (B : Type v) [CommRing B] [Algebra P B] [IsLocalization.AtPrime B q]
    {N : Type w} [AddCommGroup N] [Module B N] [Module P N] [IsScalarTower P B N]
    (s : q.primeCompl) :
    IsUnit (algebraMap P (Module.End P N) (s : P)) := by
  obtain ⟨u, hu⟩ := IsLocalization.map_units (M := q.primeCompl) B s
  have hinv : ∀ x : N, (↑u⁻¹ : B) • ((s : P) • x) = x := by
    intro x
    rw [← IsScalarTower.algebraMap_smul B (s : P) x, ← hu, smul_smul, u.inv_mul, one_smul]
  have hinv' : ∀ x : N, (s : P) • ((↑u⁻¹ : B) • x) = x := by
    intro x
    rw [← IsScalarTower.algebraMap_smul B (s : P), smul_smul, ← hu, u.mul_inv, one_smul]
  refine ⟨⟨algebraMap P (Module.End P N) (s : P),
    { toFun := fun x ↦ (↑u⁻¹ : B) • x
      map_add' := fun x y ↦ smul_add _ x y
      map_smul' := fun a x ↦ by
        simp only [RingHom.id_apply]
        rw [← IsScalarTower.algebraMap_smul B a x,
          ← IsScalarTower.algebraMap_smul B a ((↑u⁻¹ : B) • x), smul_comm] },
    ?_, ?_⟩, rfl⟩
  · ext x
    simp only [Module.End.mul_apply, Module.End.one_apply, Module.algebraMap_end_apply,
      LinearMap.coe_mk, AddHom.coe_mk]
    exact hinv' x
  · ext x
    simp only [Module.End.mul_apply, Module.End.one_apply, Module.algebraMap_end_apply,
      LinearMap.coe_mk, AddHom.coe_mk]
    exact hinv x

/-- **The `P`-span of a `B`-generating set is a `q`-localization of `N`.** -/
theorem Submodule.isLocalizedModule_subtype_span_of_span_eq_top {P : Type u} [CommRing P]
    (q : Ideal P) [q.IsPrime] (B : Type v) [CommRing B] [Algebra P B]
    [IsLocalization.AtPrime B q] {N : Type w} [AddCommGroup N] [Module B N] [Module P N]
    [IsScalarTower P B N] {ι : Type*} [Fintype ι] (v : ι → N)
    (hv : Submodule.span B (Set.range v) = ⊤) :
    IsLocalizedModule q.primeCompl (Submodule.span P (Set.range v)).subtype := by
  classical
  refine ⟨fun s ↦ isUnit_algebraMap_end_of_mem_primeCompl q B s, fun y ↦ ?_,
    fun {x y} h ↦ ⟨1, by rw [Subtype.ext h]⟩⟩
  have hy : y ∈ Submodule.span B (Set.range v) := hv ▸ Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun B).1 hy
  obtain ⟨b, hb⟩ :=
    IsLocalization.exist_integer_multiples_of_finite (M := q.primeCompl) (S := B) c
  choose p hp using fun i : ι ↦ hb i
  refine ⟨⟨⟨∑ i, p i • v i, Submodule.sum_mem _ fun i _ ↦
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)⟩, b⟩, ?_⟩
  show (b : P) • y = ∑ i, p i • v i
  rw [← hc, Finset.smul_sum]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← IsScalarTower.algebraMap_smul B (b : P) (c i • v i), smul_smul,
    ← Algebra.smul_def, ← hp i, ← IsScalarTower.algebraMap_smul B (p i) (v i)]

/-- **A finite module over the localization at a prime is the localization of a finitely
generated module downstairs.** -/
theorem exists_fg_submodule_isLocalizedModule_atPrime {P : Type u} [CommRing P] (q : Ideal P)
    [q.IsPrime] (B : Type v) [CommRing B] [Algebra P B] [IsLocalization.AtPrime B q]
    (N : Type w) [AddCommGroup N] [Module B N] [Module P N] [IsScalarTower P B N]
    [Module.Finite B N] :
    ∃ N₀ : Submodule P N, N₀.FG ∧ IsLocalizedModule q.primeCompl N₀.subtype := by
  obtain ⟨n, v, hv⟩ := Module.Finite.exists_fin (R := B) (M := N)
  exact ⟨Submodule.span P (Set.range v), Submodule.fg_span (Set.finite_range v),
    Submodule.isLocalizedModule_subtype_span_of_span_eq_top q B v hv⟩

end
