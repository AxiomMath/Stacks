module

public import StacksFrontier.Algebra.Module.IPowerTorsion
public import StacksFrontier.RingTheory.Localization.Glueing.RingHomGluing
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Torsion away from finitely many maximal ideals

Let `A` be a commutative ring and let `m i`, for `i` in a finite index type, be pairwise distinct
maximal ideals with intersection `I = ⨅ j, m j`.  The closed subset cut out by `I` is exactly the
finite set of the `m j`, so a module all of whose elements are annihilated by a power of `I` is
detected by its localizations at the `m j` alone.

This file proves that detection statement together with the two torsion computations used to glue
ring maps along the family `m`: given ring maps `f i : A_{m i} → B i` whose kernels and cokernels
are killed by a power of the maximal ideal, the kernel and the cokernel of the resulting map from
`A' = ∏ i, A_{m i}` to a model of `∏ i, B i` are `I A'`-power torsion.

## Main definitions

* `Stacks.RingHomGluing.KernelIsKilledByIdealPower` says that a power of an ideal annihilates the
  kernel of a ring map.
* `Stacks.RingHomGluing.CokernelIsKilledByIdealPower` gives the analogous condition for its
  additive cokernel.

## Main results

* `Stacks.RingHomGluing.exists_le_of_iInf_le` — a prime containing `⨅ j, m j` contains some
  `m i`.
* `Stacks.RingHomGluing.eq_zero_of_isIPowerTorsion` — an element of an `I`-power torsion module
  which is killed by an element outside each `m j` is zero.
* `Stacks.RingHomGluing.apply_mem_map` — the components of the ideal generated by `J` in the
  product of the localizations lie in the ideal generated by `J` in each factor.
* `Stacks.RingHomGluing.isIPowerTorsion_ker` and
  `Stacks.RingHomGluing.isIPowerTorsion_cokernel` — the kernel and the cokernel of the glued
  structure map are `I A'`-power torsion.

## References

* [Stacks Project, Tag 0EAE](https://stacks.math.columbia.edu/tag/0EAE)
-/

@[expose] public section

universe u v w

namespace Stacks.RingHomGluing

/-! ### The two torsion conditions on a ring map -/

section Conditions

variable {R S : Type*} [CommRing R] [CommRing S]

/-- A power of `I` annihilates the kernel of `f`. -/
def KernelIsKilledByIdealPower (f : R →+* S) (I : Ideal R) : Prop :=
  ∃ n : ℕ, ∀ a ∈ I ^ n, ∀ x : R, f x = 0 → a * x = 0

/-- A power of `I` annihilates the additive cokernel of `f`. -/
def CokernelIsKilledByIdealPower (f : R →+* S) (I : Ideal R) : Prop :=
  ∃ n : ℕ, ∀ a ∈ I ^ n, ∀ y : S, ∃ x : R, f x = f a * y

end Conditions

variable {A : Type u} [CommRing A] {ι : Type w} [Finite ι] (m : ι → Ideal A)

/-! ### Primes containing the intersection -/

section Prime

variable [∀ i, (m i).IsPrime]

omit [∀ i, (m i).IsPrime] in
/-- A prime ideal containing the intersection of a finite family of ideals contains one of the
members of the family. -/
@[ega "0 1.7.4" "partial"]
theorem exists_le_of_iInf_le {p : Ideal A} (hp : p.IsPrime)
    (h : ⨅ j, m j ≤ p) : ∃ i, m i ≤ p := by
  have : Fintype ι := Fintype.ofFinite ι
  have h' : (Finset.univ : Finset ι).inf m ≤ p := by
    refine le_trans (le_of_eq ?_) h
    simp [Finset.inf_eq_iInf]
  obtain ⟨i, -, hi⟩ := (hp.inf_le').1 h'
  exact ⟨i, hi⟩

variable [∀ i, (m i).IsMaximal]

/-- An `(⨅ j, m j)`-power torsion module is detected by its localizations at the `m j`: an
element killed by some element outside each `m j` is zero. -/
theorem eq_zero_of_isIPowerTorsion {M : Type*} [AddCommGroup M] [Module A M]
    (htor : IsIPowerTorsion A M (⨅ j, m j)) {z : M}
    (hz : ∀ j, ∃ s ∈ (m j).primeCompl, s • z = 0) : z = 0 := by
  have : Fintype ι := Fintype.ofFinite ι
  by_contra hne
  obtain ⟨n, -, hn⟩ := htor z
  set J : Ideal A := LinearMap.ker (LinearMap.toSpanSingleton A M z) with hJ
  have hmem : ∀ {a : A}, a ∈ J ↔ a • z = 0 := by
    intro a
    rw [hJ, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
  have hJne : J ≠ ⊤ := fun htop ↦ hne (by simpa using hmem.1 ((Ideal.eq_top_iff_one J).1 htop))
  obtain ⟨p, hpmax, hple⟩ := Ideal.exists_le_maximal J hJne
  have hI : ⨅ j, m j ≤ p := fun a ha ↦
    hpmax.isPrime.mem_of_pow_mem n (hple (hmem.2 (hn _ (Ideal.pow_mem_pow ha n))))
  obtain ⟨i, hi⟩ := exists_le_of_iInf_le m hpmax.isPrime hI
  obtain ⟨s, hs, hsz⟩ := hz i
  have hpi : m i = p := (inferInstance : (m i).IsMaximal).eq_of_le hpmax.ne_top hi
  exact hs (hpi ▸ hple (hmem.2 hsz))

end Prime

/-! ### Components of an extended ideal -/

section Components

variable [∀ i, (m i).IsPrime]

omit [Finite ι] in
/-- The `i`-th component of an element of the ideal generated by `J` in the product of the
localizations lies in the ideal generated by `J` in the `i`-th factor. -/
theorem apply_mem_map (J : Ideal A) {a : ∀ i, Localization.AtPrime (m i)}
    (ha : a ∈ J.map (algebraMap A (∀ i, Localization.AtPrime (m i)))) (i : ι) :
    a i ∈ J.map (algebraMap A (Localization.AtPrime (m i))) := by
  have h := Ideal.mem_map_of_mem
    (Pi.evalRingHom (fun i ↦ Localization.AtPrime (m i)) i) ha
  rwa [Ideal.map_map, show (Pi.evalRingHom (fun i ↦ Localization.AtPrime (m i)) i).comp
    (algebraMap A (∀ i, Localization.AtPrime (m i))) =
      algebraMap A (Localization.AtPrime (m i)) from rfl] at h

end Components

/-! ### The glued structure map and its torsion -/

section Glued

variable [∀ i, (m i).IsMaximal] {B : ι → Type v} [∀ i, CommRing (B i)]
  {f : ∀ i, Localization.AtPrime (m i) →+* B i}
  {T : Type*} [CommRing T] [Algebra (∀ i, Localization.AtPrime (m i)) T]
  (ev : ∀ i, T →+* B i)

/-- The structure map of the glued target, as a linear map over the product of the
localizations. -/
noncomputable abbrev gluedLinearMap (T : Type*) [CommRing T]
    [Algebra (∀ i, Localization.AtPrime (m i)) T] :
    (∀ i, Localization.AtPrime (m i)) →ₗ[∀ i, Localization.AtPrime (m i)] T :=
  Algebra.linearMap (∀ i, Localization.AtPrime (m i)) T

/-- Membership in the `n`-th power of the extended intersection is inherited componentwise by
the maximal ideal of each localization. -/
theorem apply_mem_maximalIdeal_pow (hm : Pairwise fun i j ↦ m i ≠ m j) (n : ℕ)
    {a : ∀ i, Localization.AtPrime (m i)}
    (ha : a ∈ ((⨅ j, m j).map (algebraMap A (∀ i, Localization.AtPrime (m i)))) ^ n) (i : ι) :
    a i ∈ ((m i).map (algebraMap A (Localization.AtPrime (m i)))) ^ n := by
  rw [← Ideal.map_pow] at ha
  have h := apply_mem_map m ((⨅ j, m j) ^ n) ha i
  rw [Ideal.map_pow, map_iInf_eq_maximalIdeal m hm i] at h
  rwa [Localization.AtPrime.map_eq_maximalIdeal]

/-- Componentwise version of `apply_mem_maximalIdeal_pow` for the exponent `sup n + 1`. -/
private theorem apply_mem_maximalIdeal_pow_of_sup [Fintype ι]
    (hm : Pairwise fun i j ↦ m i ≠ m j) (n : ι → ℕ) {a : ∀ i, Localization.AtPrime (m i)}
    (ha : a ∈ ((⨅ j, m j).map (algebraMap A (∀ i, Localization.AtPrime (m i)))) ^
      (Finset.univ.sup n + 1)) (i : ι) :
    a i ∈ ((m i).map (algebraMap A (Localization.AtPrime (m i)))) ^ n i :=
  Ideal.pow_le_pow_right (le_trans (Finset.le_sup (Finset.mem_univ i)) (Nat.le_succ _))
    (apply_mem_maximalIdeal_pow m hm _ ha i)

/-- The kernel of the glued structure map is `I A'`-power torsion, where `I = ⨅ j, m j`. -/
theorem isIPowerTorsion_ker (hm : Pairwise fun i j ↦ m i ≠ m j)
    (hev : ∀ (a : ∀ i, Localization.AtPrime (m i)) (i : ι),
      ev i (algebraMap (∀ i, Localization.AtPrime (m i)) T a) = f i (a i))
    (hker : ∀ i, KernelIsKilledByIdealPower (f i)
      ((m i).map (algebraMap A (Localization.AtPrime (m i))))) :
    IsIPowerTorsion (∀ i, Localization.AtPrime (m i))
      (LinearMap.ker (gluedLinearMap m T))
      ((⨅ j, m j).map (algebraMap A (∀ i, Localization.AtPrime (m i)))) := by
  have : Fintype ι := Fintype.ofFinite ι
  intro z
  choose n hn using hker
  refine ⟨Finset.univ.sup n + 1, Nat.succ_pos _, fun a ha ↦ ?_⟩
  have hz : ∀ i, f i ((z : ∀ i, Localization.AtPrime (m i)) i) = 0 := by
    intro i
    have h0 : algebraMap (∀ i, Localization.AtPrime (m i)) T
        (z : ∀ i, Localization.AtPrime (m i)) = 0 := z.2
    rw [← hev, h0, map_zero]
  refine Subtype.ext (funext fun i ↦ ?_)
  exact hn i (a i) (apply_mem_maximalIdeal_pow_of_sup m hm n ha i) _ (hz i)

/-- The cokernel of the glued structure map is `I A'`-power torsion, where `I = ⨅ j, m j`. -/
theorem isIPowerTorsion_cokernel (hm : Pairwise fun i j ↦ m i ≠ m j)
    (hev : ∀ (a : ∀ i, Localization.AtPrime (m i)) (i : ι),
      ev i (algebraMap (∀ i, Localization.AtPrime (m i)) T a) = f i (a i))
    (hinj : ∀ t t' : T, (∀ i, ev i t = ev i t') → t = t')
    (hcoker : ∀ i, CokernelIsKilledByIdealPower (f i)
      ((m i).map (algebraMap A (Localization.AtPrime (m i))))) :
    IsIPowerTorsion (∀ i, Localization.AtPrime (m i))
      (T ⧸ LinearMap.range (gluedLinearMap m T))
      ((⨅ j, m j).map (algebraMap A (∀ i, Localization.AtPrime (m i)))) := by
  have : Fintype ι := Fintype.ofFinite ι
  intro q
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  choose n hn using hcoker
  refine ⟨Finset.univ.sup n + 1, Nat.succ_pos _, fun a ha ↦ ?_⟩
  have hmem : a • y ∈ LinearMap.range (gluedLinearMap m T) := by
    choose ξ hξ using fun i ↦ hn i (a i) (apply_mem_maximalIdeal_pow_of_sup m hm n ha i) (ev i y)
    refine ⟨ξ, hinj _ _ fun i ↦ ?_⟩
    rw [show gluedLinearMap m T ξ = algebraMap (∀ i, Localization.AtPrime (m i)) T ξ from rfl,
      hev, hξ i, Algebra.smul_def, map_mul, hev]
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
  exact hmem

end Glued

end Stacks.RingHomGluing

end
