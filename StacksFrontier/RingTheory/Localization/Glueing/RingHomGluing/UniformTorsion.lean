module

public import StacksFrontier.RingTheory.Localization.Glueing.RingHomGluing.Away

/-!
# Uniform annihilation of the kernel of a ring map

The glueing statement of Stacks 0EAE asks for the kernel and the cokernel of the glued ring map
to be annihilated by *one* power of the intersection of the given maximal ideals, not merely for
each of their elements to be annihilated by some power.  The two conditions differ: the
localization criteria available for the glued map are pointwise, since an element of an
ideal-power torsion module carries its own exponent.  For a *kernel* over a Noetherian ring the
gap closes, because an ideal is finitely generated and a bound which works on a finite generating
set works everywhere.

This file records that uniformization together with the two elementary annihilator facts it is
used with.  First, an element annihilated by a power of each member of a finite family is
annihilated by a power of the ideal the family spans: the family generates an ideal contained in
the radical of the ideal generated by the chosen powers, and a finitely generated ideal inside a
radical has a power inside the ideal.  Second, an element annihilated by a power of the
intersection of finitely many maximal ideals and, at each of them, by some element outside it,
is zero: its annihilator is contained in no maximal ideal at all.

## Main results

* `Stacks.RingHomGluing.exists_pow_span_mul_eq_zero` — annihilation by a power of each generator
  gives annihilation by a power of the span.
* `Stacks.RingHomGluing.exists_forall_mem_pow_mul_eq_zero_of_fg` — a finitely generated ideal
  whose elements are pointwise annihilated by powers of `J` is annihilated by one power of `J`.
* `Stacks.RingHomGluing.kernelIsKilledByIdealPower_of_pointwise` — the Noetherian uniformization
  for the kernel of a ring map.
* `Stacks.RingHomGluing.eq_zero_of_pow_iInf_mul_eq_zero` — detection of zero by the localizations
  at the members of the family.
* `Stacks.RingHomGluing.kernelIsKilledByIdealPower_of_forall_pow` and
  `Stacks.RingHomGluing.injective_of_forall_pow_of_forall_notMem` — the kernel and injectivity
  clauses of Stacks 0EAE for any ring map whose kernel dies after inverting each generator of the
  intersection.

## References

* [Stacks Project, Tag 0EAE](https://stacks.math.columbia.edu/tag/0EAE)
-/

@[expose] public section

universe u w

namespace Stacks.RingHomGluing

variable {A : Type u} [CommRing A]

/-! ### Annihilation by a power of a span -/

/-- An element killing all generators of an ideal kills the whole ideal. -/
private theorem mul_eq_zero_of_mem_span {S : Set A} {a : A} (h : ∀ s ∈ S, s * a = 0) :
    ∀ c ∈ Ideal.span S, c * a = 0 := fun c hc ↦ by
  have hle : Ideal.span S ≤ LinearMap.ker (LinearMap.toSpanSingleton A A a) :=
    Ideal.span_le.2 fun s hs ↦ by simpa using h s hs
  simpa using hle hc

/-- An element annihilated by a power of each member of a finite family is annihilated by a power
of the ideal that family spans. -/
theorem exists_pow_span_mul_eq_zero {r : ℕ} (x : Fin r → A) {a : A}
    (h : ∀ j, ∃ k : ℕ, x j ^ k * a = 0) :
    ∃ N : ℕ, ∀ c ∈ Ideal.span (Set.range x) ^ N, c * a = 0 := by
  classical
  choose k hk using h
  have hJann := mul_eq_zero_of_mem_span (S := Set.range fun j ↦ x j ^ k j) (a := a)
    (by rintro _ ⟨j, rfl⟩; exact hk j)
  have hle : Ideal.span (Set.range x) ≤ (Ideal.span (Set.range fun j ↦ x j ^ k j)).radical := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact ⟨k j, Ideal.subset_span ⟨j, rfl⟩⟩
  obtain ⟨N, hN⟩ :=
    Ideal.exists_pow_le_of_le_radical_of_fg hle (Submodule.fg_span (Set.finite_range x))
  exact ⟨N, fun c hc ↦ hJann c (hN hc)⟩

/-! ### Uniformization over a Noetherian ring -/

/-- A finitely generated ideal each of whose elements is annihilated by some power of `J` is
annihilated by a single power of `J`. -/
theorem exists_forall_mem_pow_mul_eq_zero_of_fg {K J : Ideal A} (hK : K.FG)
    (h : ∀ a ∈ K, ∃ N : ℕ, ∀ c ∈ J ^ N, c * a = 0) :
    ∃ N : ℕ, ∀ c ∈ J ^ N, ∀ a ∈ K, c * a = 0 := by
  classical
  obtain ⟨s, hs⟩ := hK
  have hsub : ∀ a ∈ s, a ∈ K := fun a ha ↦ hs ▸ Ideal.subset_span ha
  choose N hN using fun (a : A) (ha : a ∈ s) ↦ h a (hsub a ha)
  refine ⟨s.attach.sup fun a ↦ N a.1 a.2, fun c hc a ha ↦ ?_⟩
  rw [← hs] at ha
  rw [mul_comm]
  refine mul_eq_zero_of_mem_span (fun b hb ↦ ?_) a ha
  rw [mul_comm]
  refine hN b hb c (Ideal.pow_le_pow_right ?_ hc)
  exact Finset.le_sup (f := fun z : {z // z ∈ s} ↦ N z.1 z.2) (Finset.mem_attach s ⟨b, hb⟩)

/-- Over a Noetherian ring, a ring map whose kernel is annihilated element by element by powers
of `J` has its whole kernel annihilated by a single power of `J`. -/
theorem kernelIsKilledByIdealPower_of_pointwise [IsNoetherianRing A] {C : Type*} [CommRing C]
    (g : A →+* C) (J : Ideal A)
    (h : ∀ a : A, g a = 0 → ∃ N : ℕ, ∀ c ∈ J ^ N, c * a = 0) :
    KernelIsKilledByIdealPower g J := by
  obtain ⟨N, hN⟩ := exists_forall_mem_pow_mul_eq_zero_of_fg (K := RingHom.ker g) (J := J)
    (IsNoetherian.noetherian _) fun a ha ↦ h a (RingHom.mem_ker.mp ha)
  exact ⟨N, fun c hc a hag ↦ hN c hc a (RingHom.mem_ker.mpr hag)⟩

/-! ### Detection of zero at the members of the family -/

/-- An element annihilated by a power of the intersection of finitely many maximal ideals, and at
each of them by an element outside it, is zero: no maximal ideal contains its annihilator. -/
theorem eq_zero_of_pow_iInf_mul_eq_zero {ι : Type w} [Finite ι] (m : ι → Ideal A)
    [∀ i, (m i).IsMaximal] {a : A} {N : ℕ}
    (hN : ∀ c ∈ (⨅ j, m j) ^ N, c * a = 0)
    (hout : ∀ i, ∃ s ∈ (m i).primeCompl, s * a = 0) : a = 0 := by
  by_contra hne
  have hmem : ∀ {c : A}, c ∈ LinearMap.ker (LinearMap.toSpanSingleton A A a) ↔ c * a = 0 := by
    intro c
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, smul_eq_mul]
  have hKne : LinearMap.ker (LinearMap.toSpanSingleton A A a) ≠ ⊤ := fun htop ↦
    hne (by simpa using hmem.1 ((Ideal.eq_top_iff_one _).1 htop))
  obtain ⟨p, hpmax, hple⟩ := Ideal.exists_le_maximal _ hKne
  have hI : ⨅ j, m j ≤ p := fun c hc ↦
    hpmax.isPrime.mem_of_pow_mem N (hple (hmem.2 (hN _ (Ideal.pow_mem_pow hc N))))
  obtain ⟨i, hi⟩ := exists_le_of_iInf_le m hpmax.isPrime hI
  obtain ⟨s, hs, hsa⟩ := hout i
  have hpi : m i = p := (inferInstance : (m i).IsMaximal).eq_of_le hpmax.ne_top hi
  exact hs (hpi ▸ hple (hmem.2 hsa))

/-! ### The two clauses of Stacks 0EAE that the generic part alone decides -/

/-- The kernel clause of Stacks 0EAE for any ring map whose kernel dies after inverting each
generator of the intersection of the maximal ideals. -/
theorem kernelIsKilledByIdealPower_of_forall_pow [IsNoetherianRing A] {ι : Type w} [Finite ι]
    (m : ι → Ideal A) [∀ i, (m i).IsMaximal] {r : ℕ} (x : Fin r → A)
    (hx : Ideal.span (Set.range x) = ⨅ j, m j) {C : Type*} [CommRing C] (g : A →+* C)
    (h : ∀ (j : Fin r) (a : A), g a = 0 → ∃ k : ℕ, x j ^ k * a = 0) :
    KernelIsKilledByIdealPower g (⨅ j, m j) := by
  refine kernelIsKilledByIdealPower_of_pointwise g _ fun a ha ↦ ?_
  obtain ⟨N, hN⟩ := exists_pow_span_mul_eq_zero x fun j ↦ h j a ha
  exact ⟨N, by rwa [← hx]⟩

/-- The injectivity clause of Stacks 0EAE: a ring map whose kernel dies both after inverting each
generator of the intersection and at each of the maximal ideals is injective. -/
theorem injective_of_forall_pow_of_forall_notMem {ι : Type w} [Finite ι] (m : ι → Ideal A)
    [∀ i, (m i).IsMaximal] {r : ℕ} (x : Fin r → A)
    (hx : Ideal.span (Set.range x) = ⨅ j, m j) {C : Type*} [CommRing C] (g : A →+* C)
    (hpow : ∀ (j : Fin r) (a : A), g a = 0 → ∃ k : ℕ, x j ^ k * a = 0)
    (hout : ∀ (i : ι) (a : A), g a = 0 → ∃ s ∈ (m i).primeCompl, s * a = 0) :
    Function.Injective g :=
  (injective_iff_map_eq_zero g).mpr fun a ha ↦ by
    obtain ⟨N, hN⟩ := exists_pow_span_mul_eq_zero x fun j ↦ hpow j a ha
    rw [hx] at hN
    exact eq_zero_of_pow_iInf_mul_eq_zero m hN fun i ↦ hout i a ha

end Stacks.RingHomGluing

end
