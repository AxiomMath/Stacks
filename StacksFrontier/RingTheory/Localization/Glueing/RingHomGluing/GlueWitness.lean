module

public import Mathlib.RingTheory.PrincipalIdealDomain
public import StacksFrontier.RingTheory.Localization.Glueing.RingHomGluing.GlueKernel

/-!
# A witness for the glueing datum of Stacks 0EAE

The glued ring of Stacks 0EAE is built from a datum — a finite family of pairwise distinct
maximal ideals, a generating family for their intersection, a model of the product of the
prescribed targets and the structure maps into it — and every statement about the glued ring is
conditional on such a datum. This file exhibits one.

The witness is the integers with the two maximal ideals `(2)` and `(3)`, whose intersection is
`(6)`, and the identity maps on the two localizations.  It is not degenerate in the ways that
matter here: the two maximal ideals are distinct and non-zero, the base ring has dimension one,
and the generator of the intersection is not a unit and not zero.  The glueing locus is still
principal, which the general lemma does not assume; no instance with a non-principal locus (so
with more than one Čech index) is exhibited here.

## Main results

* `Stacks.RingHomGluing.Witness.bijective_transport` — the bijectivity hypothesis of the glued
  datum holds at the witness, so the glued ring and its structure map exist there.
* `Stacks.RingHomGluing.Witness.kernelIsKilledByIdealPower_glue` — the kernel clause of
  Stacks 0EAE at the witness.
* `Stacks.RingHomGluing.Witness.injective_glue` — the injectivity clause at the witness; in
  particular the glued ring contains a copy of the integers and is not the zero ring.
* `Stacks.RingHomGluing.Witness.glueToComponent_comp_glue` — the commuting square of the
  localization clause at the witness.

## References

* [Stacks Project, Tag 0EAE](https://stacks.math.columbia.edu/tag/0EAE)
-/

@[expose] public noncomputable section

namespace Stacks.RingHomGluing.Witness

open CategoryTheory Cech TensorProduct FormalGlueing

attribute [local instance] localPieceRing

/-- The index set of the witness: two maximal ideals. -/
abbrev index : Type := Fin 2

/-- The two maximal ideals of the witness, `(2)` and `(3)`. -/
abbrev maximalIdeals : index → Ideal ℤ :=
  fun i ↦ if i = 0 then Ideal.span {(2 : ℤ)} else Ideal.span {(3 : ℤ)}

/-- The ideals `(2)` and `(3)` of `ℤ` are maximal. -/
instance isMaximal_maximalIdeals : ∀ i, (maximalIdeals i).IsMaximal := by
  intro i
  fin_cases i
  · exact PrincipalIdealRing.isMaximal_of_irreducible
      (Int.prime_iff_natAbs_prime.2 (by norm_num)).irreducible
  · exact PrincipalIdealRing.isMaximal_of_irreducible
      (Int.prime_iff_natAbs_prime.2 (by norm_num)).irreducible

/-- The generating family of the intersection: the single element `6`. -/
abbrev gens : Fin 1 → ℤ := fun _ ↦ 6

/-- The prescribed targets: the two localizations themselves. -/
abbrev targets : index → Type := fun i ↦ Localization.AtPrime (maximalIdeals i)

/-- The model of the product of the prescribed targets. -/
abbrev glueTargetModel : Type := ∀ i, Localization.AtPrime (maximalIdeals i)

/-- The prescribed maps: the identities. -/
abbrev prescribed : ∀ i, Localization.AtPrime (maximalIdeals i) →+* targets i :=
  fun _ ↦ RingHom.id _

/-- The evaluation maps of the model. -/
abbrev evalHom : ∀ i, glueTargetModel →+* targets i := fun i ↦ Pi.evalRingHom _ i

/-- The intersection of the two maximal ideals is generated by `6`. -/
theorem iInf_maximalIdeals : (⨅ j, maximalIdeals j) = Ideal.span {(6 : ℤ)} := by
  have hpair : (⨅ j, maximalIdeals j) = maximalIdeals 0 ⊓ maximalIdeals 1 :=
    le_antisymm (le_inf (iInf_le _ 0) (iInf_le _ 1))
      (le_iInf fun j ↦ by fin_cases j; exacts [inf_le_left, inf_le_right])
  rw [hpair]
  show Ideal.span {(2 : ℤ)} ⊓ Ideal.span {(3 : ℤ)} = Ideal.span {(6 : ℤ)}
  ext n
  simp only [Ideal.mem_span_singleton, Submodule.mem_inf]
  omega

/-- The generating family spans the intersection. -/
theorem span_gens : Ideal.span (Set.range gens) = ⨅ j, maximalIdeals j := by
  rw [iInf_maximalIdeals]
  congr 1
  ext n
  simp

/-- The two maximal ideals are distinct. -/
theorem span_two_ne_span_three : Ideal.span {(2 : ℤ)} ≠ Ideal.span {(3 : ℤ)} := fun h ↦ by
  have h2 : (2 : ℤ) ∈ Ideal.span {(3 : ℤ)} := h ▸ Ideal.mem_span_singleton_self (2 : ℤ)
  rw [Ideal.mem_span_singleton] at h2
  omega

/-- The family of maximal ideals is pairwise distinct. -/
theorem pairwise_ne : Pairwise fun i j ↦ maximalIdeals i ≠ maximalIdeals j := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · exact absurd rfl hij
  · exact span_two_ne_span_three
  · exact span_two_ne_span_three.symm
  · exact absurd rfl hij

/-- The evaluation maps compute the prescribed maps on the image of the product. -/
theorem evalHom_algebraMap (a : ∀ i, Localization.AtPrime (maximalIdeals i)) (i : index) :
    evalHom i (algebraMap (∀ i, Localization.AtPrime (maximalIdeals i)) glueTargetModel a) =
      prescribed i (a i) := rfl

/-- The evaluation maps are jointly injective. -/
theorem evalHom_injective (s s' : glueTargetModel) (h : ∀ i, evalHom i s = evalHom i s') :
    s = s' := funext h

/-- The kernels of the prescribed maps are killed by a power of the maximal ideal. -/
theorem kernelIsKilledByIdealPower_prescribed (i : index) :
    KernelIsKilledByIdealPower (prescribed i)
      ((maximalIdeals i).map (algebraMap ℤ (Localization.AtPrime (maximalIdeals i)))) :=
  ⟨0, fun a _ y hy ↦ by rw [show y = 0 from hy, mul_zero]⟩

/-- The cokernels of the prescribed maps are killed by a power of the maximal ideal. -/
theorem cokernelIsKilledByIdealPower_prescribed (i : index) :
    CokernelIsKilledByIdealPower (prescribed i)
      ((maximalIdeals i).map (algebraMap ℤ (Localization.AtPrime (maximalIdeals i)))) :=
  ⟨0, fun a _ y ↦ ⟨a * y, rfl⟩⟩

/-- **The bijectivity hypothesis of the glued datum holds at the witness.** -/
theorem bijective_transport (j : Fin 1) :
    Function.Bijective (transportMap (∀ i, Localization.AtPrime (maximalIdeals i)) gens
      (baseDatum.{0, 0, 0} maximalIdeals gens)
      (glueTarget.{0, 0, 0} maximalIdeals (T := glueTargetModel))
      (gluePsi.{0, 0, 0} maximalIdeals gens) j) :=
  bijective_transportMap.{0, 0, 0} maximalIdeals gens evalHom span_gens pairwise_ne
    evalHom_algebraMap evalHom_injective kernelIsKilledByIdealPower_prescribed
    cokernelIsKilledByIdealPower_prescribed j

/-- **The kernel clause of Stacks 0EAE at the witness.** -/
theorem kernelIsKilledByIdealPower_glue :
    KernelIsKilledByIdealPower
        (glueRingHom.{0, 0, 0} maximalIdeals gens bijective_transport)
      (⨅ j, maximalIdeals j) :=
  kernelIsKilledByIdealPower_glueRingHom maximalIdeals gens bijective_transport span_gens

/-- **The injectivity clause of Stacks 0EAE at the witness**: the glued ring contains a copy of
the integers, so it is not the zero ring. -/
theorem injective_glue :
    Function.Injective (glueRingHom.{0, 0, 0} maximalIdeals gens bijective_transport) :=
  injective_glueRingHom maximalIdeals gens bijective_transport evalHom span_gens
    evalHom_algebraMap fun _ ↦ Function.injective_id

/-- **The commuting square of the localization clause of Stacks 0EAE at the witness.** -/
theorem glueToComponent_comp_glue (i : index) :
    (glueToComponent.{0, 0, 0} maximalIdeals gens bijective_transport evalHom i).comp
        (glueRingHom.{0, 0, 0} maximalIdeals gens bijective_transport) =
      (prescribed i).comp (algebraMap ℤ (Localization.AtPrime (maximalIdeals i))) :=
  glueToComponent_comp_glueRingHom maximalIdeals gens bijective_transport evalHom
    evalHom_algebraMap i

end Stacks.RingHomGluing.Witness

end
