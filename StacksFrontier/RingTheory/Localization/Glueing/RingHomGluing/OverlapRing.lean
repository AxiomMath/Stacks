module

public import StacksFrontier.RingTheory.Localization.Glueing.RingHomGluing.LocalPieceRing

/-!
# The overlap condition of the glued datum, as an equation in a ring

Let `x : Fin r → A` and `i j : Fin r`. The overlap ring `overlapRing x i j` is the lifted base
ring with both `x i` and `x j` inverted. The `j`-th localization of the `i`-th local piece of the
canonical datum of Stacks 05ER and the `i`-th localization of the `j`-th local piece are both
identified with it, and under these identifications the overlap isomorphism of the canonical datum
becomes an equation between two maps of the local pieces into the overlap ring. Both maps are
multiplicative and unital.

## Main definitions

* `Stacks.RingHomGluing.overlapRing` — the lifted base ring with both generators inverted.
* `Stacks.RingHomGluing.overlapMkLeft` and `Stacks.RingHomGluing.overlapMkRight` — the two
  comparisons of a local piece with the overlap ring.

## Main results

* `Stacks.RingHomGluing.overlapMkLeft_mul`, `Stacks.RingHomGluing.overlapMkRight_mul`,
  `Stacks.RingHomGluing.overlapMkLeft_one` and `Stacks.RingHomGluing.overlapMkRight_one` — the two
  comparisons are ring maps.
* `Stacks.RingHomGluing.canonicalAlphaIJ_mk_eq_iff` — the overlap condition of the canonical
  datum is the equation between the two comparisons.

## References

* [Stacks Project, Tag 05ER](https://stacks.math.columbia.edu/tag/05ER)
* [Stacks Project, Tag 0EAE](https://stacks.math.columbia.edu/tag/0EAE)
-/

@[expose] public noncomputable section

universe u t

namespace Stacks.RingHomGluing

open CategoryTheory Cech TensorProduct FormalGlueing

section Overlap

variable {A : Type u} [CommRing A] {r : ℕ} (x : Fin r → A)

attribute [local instance] localPieceRing

/-- The overlap ring of two indices: the lifted base ring with both generators inverted. -/
abbrev overlapRing (i j : Fin r) : Type max u t :=
  LocalizedModule (cechSub x ({i} ∪ {j})) (ULift.{t} A)

/-- The submonoid of the base ring generated by the two generators. -/
abbrev overlapSub (i j : Fin r) : Submonoid A :=
  Submonoid.closure (x '' (↑(({i} : Finset (Fin r)) ∪ {j}) : Set (Fin r)))

/-- The denominator-one map of the `i`-th local piece into the `j`-th slot of the overlap,
read as a localization at the submonoid generated by both generators. -/
theorem isLocalizedModule_overlap_left (i j : Fin r) :
    IsLocalizedModule (overlapSub x i j)
      ((LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _).comp
        (canonicalLocalMk x (liftedBase.{u, t} A) i)) :=
  canonicalOverlap_isLocalized x (liftedBase.{u, t} A) i {j}

/-- The denominator-one map of the `j`-th local piece into the `i`-th slot of the overlap,
read as a localization at the submonoid generated by both generators. -/
theorem isLocalizedModule_overlap_right (i j : Fin r) :
    IsLocalizedModule (overlapSub x i j)
      ((LocalizedModule.mkLinearMap (cechSub x ({i} : Finset (Fin r))) _).comp
        (canonicalLocalMk x (liftedBase.{u, t} A) j)) := by
  simpa only [Finset.union_comm] using
    canonicalOverlap_isLocalized x (liftedBase.{u, t} A) j {i}

/-- The identification of the `j`-th localization of the `i`-th local piece with the overlap
ring. -/
def overlapEquivLeft (i j : Fin r) :
    cechMod x (restrictFromAway (R := A) x i (canonicalLocalPiece x (liftedBase.{u, t} A) i))
        {j} ≃ₗ[A] overlapRing.{u, t} x i j :=
  have := isLocalizedModule_overlap_left x i j
  IsLocalizedModule.linearEquiv (overlapSub x i j)
    ((LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _).comp
      (canonicalLocalMk x (liftedBase.{u, t} A) i))
    (LocalizedModule.mkLinearMap (cechSub x ({i} ∪ {j})) (ULift.{t} A))

/-- The identification of the `i`-th localization of the `j`-th local piece with the overlap
ring. -/
def overlapEquivRight (i j : Fin r) :
    cechMod x (restrictFromAway (R := A) x j (canonicalLocalPiece x (liftedBase.{u, t} A) j))
        {i} ≃ₗ[A] overlapRing.{u, t} x i j :=
  have := isLocalizedModule_overlap_right x i j
  IsLocalizedModule.linearEquiv (overlapSub x i j)
    ((LocalizedModule.mkLinearMap (cechSub x ({i} : Finset (Fin r))) _).comp
      (canonicalLocalMk x (liftedBase.{u, t} A) j))
    (LocalizedModule.mkLinearMap (cechSub x ({i} ∪ {j})) (ULift.{t} A))

/-- The comparison of the `i`-th local piece with the overlap ring. -/
def overlapMkLeft (i j : Fin r) :
    restrictFromAway (R := A) x i (canonicalLocalPiece x (liftedBase.{u, t} A) i) →ₗ[A]
      overlapRing.{u, t} x i j :=
  (overlapEquivLeft x i j).toLinearMap.comp
    (LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _)

/-- The comparison of the `j`-th local piece with the overlap ring. -/
def overlapMkRight (i j : Fin r) :
    restrictFromAway (R := A) x j (canonicalLocalPiece x (liftedBase.{u, t} A) j) →ₗ[A]
      overlapRing.{u, t} x i j :=
  (overlapEquivRight x i j).toLinearMap.comp
    (LocalizedModule.mkLinearMap (cechSub x ({i} : Finset (Fin r))) _)

/-- The value of the left comparison on the image of the base ring. -/
theorem overlapMkLeft_apply_mk (i j : Fin r) (a : ULift.{t} A) :
    overlapMkLeft x i j (canonicalLocalMk x (liftedBase.{u, t} A) i a) =
      LocalizedModule.mk a 1 :=
  have := isLocalizedModule_overlap_left x i j
  IsLocalizedModule.linearEquiv_apply (overlapSub x i j)
    ((LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _).comp
      (canonicalLocalMk x (liftedBase.{u, t} A) i))
    (LocalizedModule.mkLinearMap (cechSub x ({i} ∪ {j})) (ULift.{t} A)) a

/-- The value of the right comparison on the image of the base ring. -/
theorem overlapMkRight_apply_mk (i j : Fin r) (a : ULift.{t} A) :
    overlapMkRight x i j (canonicalLocalMk x (liftedBase.{u, t} A) j a) =
      LocalizedModule.mk a 1 :=
  have := isLocalizedModule_overlap_right x i j
  IsLocalizedModule.linearEquiv_apply (overlapSub x i j)
    ((LocalizedModule.mkLinearMap (cechSub x ({i} : Finset (Fin r))) _).comp
      (canonicalLocalMk x (liftedBase.{u, t} A) j))
    (LocalizedModule.mkLinearMap (cechSub x ({i} ∪ {j})) (ULift.{t} A)) a

/-- A power of either generator acts injectively on the overlap ring. -/
theorem injective_pow_smul_overlapRing (i j : Fin r) (l : Fin r)
    (hl : l ∈ ({i} ∪ {j} : Finset (Fin r))) (k : ℕ) :
    Function.Injective fun q : overlapRing.{u, t} x i j ↦ (x l ^ k : A) • q :=
  injective_smul_of_isUnit _ (IsLocalizedModule.map_units (S := overlapSub x i j)
    (LocalizedModule.mkLinearMap (cechSub x ({i} ∪ {j})) (ULift.{t} A))
    ⟨x l ^ k, pow_mem (Submonoid.subset_closure (Set.mem_image_of_mem x (by exact_mod_cast hl))) k⟩)

/-- A linear map from the `k`-th local piece to the overlap ring, for `k` one of the two
generators, which is the denominator-one map on the image of the base ring, is multiplicative. -/
private theorem map_mul_overlapRing (i j k : Fin r) (hk : k ∈ ({i} ∪ {j} : Finset (Fin r)))
    (f : restrictFromAway (R := A) x k (canonicalLocalPiece x (liftedBase.{u, t} A) k) →ₗ[A]
      overlapRing.{u, t} x i j)
    (hf : ∀ a : ULift.{t} A, f (canonicalLocalMk x (liftedBase.{u, t} A) k a) =
      LocalizedModule.mk a 1)
    (p p' : restrictFromAway (R := A) x k (canonicalLocalPiece x (liftedBase.{u, t} A) k)) :
    f (p * p') = f p * f p' := by
  have hloc := canonicalLocalMk_isLocalized x (liftedBase.{u, t} A) k
  refine map_mul_of_isLocalizedModule (Submonoid.powers (x k))
    (canonicalLocalMk x (liftedBase.{u, t} A) k) (localPiece_smul_mul x k)
    (smul_mul_localizedModule (cechSub x ({i} ∪ {j}))) ?_ f
    (canonicalLocalMk_mul x k) ?_ p p'
  · rintro c ⟨n, rfl⟩
    exact injective_pow_smul_overlapRing x i j k hk n
  · intro a b
    rw [hf, hf, hf, localizedModule_mk_one_mul]

/-- The left comparison is multiplicative. -/
theorem overlapMkLeft_mul (i j : Fin r)
    (p p' : restrictFromAway (R := A) x i (canonicalLocalPiece x (liftedBase.{u, t} A) i)) :
    overlapMkLeft x i j (p * p') = overlapMkLeft x i j p * overlapMkLeft x i j p' :=
  map_mul_overlapRing x i j i (by simp) _ (overlapMkLeft_apply_mk x i j) p p'

/-- The right comparison is multiplicative. -/
theorem overlapMkRight_mul (i j : Fin r)
    (q q' : restrictFromAway (R := A) x j (canonicalLocalPiece x (liftedBase.{u, t} A) j)) :
    overlapMkRight x i j (q * q') = overlapMkRight x i j q * overlapMkRight x i j q' :=
  map_mul_overlapRing x i j j (by simp) _ (overlapMkRight_apply_mk x i j) q q'

/-- The left comparison is unital. -/
theorem overlapMkLeft_one (i j : Fin r) :
    overlapMkLeft x i j 1 = 1 := by
  rw [← canonicalLocalMk_one x i, overlapMkLeft_apply_mk, localizedModule_mk_one_one]

/-- The right comparison is unital. -/
theorem overlapMkRight_one (i j : Fin r) :
    overlapMkRight x i j 1 = 1 := by
  rw [← canonicalLocalMk_one x j, overlapMkRight_apply_mk, localizedModule_mk_one_one]

/-- The overlap isomorphism of the canonical datum is the comparison of the two identifications
with the overlap ring. -/
theorem overlapEquivRight_canonicalAlphaIJ (i j : Fin r)
    (z : cechMod x
      (restrictFromAway (R := A) x i (canonicalLocalPiece x (liftedBase.{u, t} A) i)) {j}) :
    overlapEquivRight x i j (canonicalAlphaIJ x (liftedBase.{u, t} A) i j z) =
      overlapEquivLeft x i j z := by
  have hf := isLocalizedModule_overlap_left x i j
  have key : (overlapEquivRight x i j).toLinearMap.comp
        (canonicalAlphaIJ x (liftedBase.{u, t} A) i j).toLinearMap =
      (overlapEquivLeft x i j).toLinearMap := by
    refine IsLocalizedModule.ext (overlapSub x i j)
      ((LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _).comp
        (canonicalLocalMk x (liftedBase.{u, t} A) i))
      (IsLocalizedModule.map_units
        (LocalizedModule.mkLinearMap (cechSub x ({i} ∪ {j})) (ULift.{t} A))) ?_
    ext a
    change overlapEquivRight x i j (canonicalAlphaIJ x (liftedBase.{u, t} A) i j
      (LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _
        (canonicalLocalMk x (liftedBase.{u, t} A) i a))) = _
    rw [canonicalAlphaIJ_mk]
    exact (overlapMkRight_apply_mk x i j a).trans (overlapMkLeft_apply_mk x i j a).symm
  exact LinearMap.congr_fun key z

/-- The overlap isomorphism of the canonical datum sends the image of `p` to the image of `q` if
and only if `overlapMkLeft x i j p = overlapMkRight x i j q`. -/
theorem canonicalAlphaIJ_mk_eq_iff (i j : Fin r)
    (p : restrictFromAway (R := A) x i (canonicalLocalPiece x (liftedBase.{u, t} A) i))
    (q : restrictFromAway (R := A) x j (canonicalLocalPiece x (liftedBase.{u, t} A) j)) :
    canonicalAlphaIJ x (liftedBase.{u, t} A) i j
        (LocalizedModule.mkLinearMap (cechSub x ({j} : Finset (Fin r))) _ p) =
      LocalizedModule.mkLinearMap (cechSub x ({i} : Finset (Fin r))) _ q ↔
      overlapMkLeft x i j p = overlapMkRight x i j q := by
  rw [← (overlapEquivRight x i j).injective.eq_iff, overlapEquivRight_canonicalAlphaIJ]
  exact Iff.rfl

end Overlap

end Stacks.RingHomGluing

end
