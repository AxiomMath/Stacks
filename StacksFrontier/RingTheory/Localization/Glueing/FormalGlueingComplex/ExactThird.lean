/-!
# Exactness of the glueing complex at its third term

The third map `FormalGlueing.glueingGamma` of the glueing complex, exactness of the complex at
its third term under flat base change which is an isomorphism modulo the ideal generated by the
localization parameters, and the formal glueing statements read on localization models.

## Main results

* `FormalGlueing.glueingComplex_exact_third`: exactness of the glueing complex at its third term.
* `FormalGlueing.glueing_exact_middle_of_models`, `FormalGlueing.glueing_injective_of_models`,
  `FormalGlueing.glueing_exact_third_of_models`: formal glueing for modules, read on models.
-/

/-! ### Exactness of the glueing complex at its third term -/

section

namespace FormalGlueing

open TensorProduct Cech

universe u v w

open _root_.IPowerTorsion (unitMap)

/-- The identification of the base change of a glueing term with the glueing term of the base
change carries the unit to the localized unit, in every degree. -/
theorem glueingTermTensorEquiv_unit_deg
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (S : Type v) [CommRing S] [Algebra R S] (p : ℕ) (x : GlueingTerm f M p) :
    glueingTermTensorEquiv f M S p (x ⊗ₜ[R] (1 : S)) = localizationTensorMap S f M p x := by
  funext s
  simp [glueingTermTensorEquiv, localizationTensorMap, localizationTensorEquiv_unit,
    IPowerTorsion.unitMap]

/-- The localization of `m ⊗ n` commutes with restriction between localizations. -/
private theorem localizationTensorEquiv_cechι
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] {s t : Finset (Fin r)} (h : s ⊆ t)
    (y : cechMod f M s ⊗[R] N) :
    localizationTensorEquiv (cechSub f t) M N ((cechι f M h).rTensor N y) =
      cechι f (M ⊗[R] N) h (localizationTensorEquiv (cechSub f s) M N y) := by
  have key : (localizationTensorEquiv (cechSub f t) M N).toLinearMap ∘ₗ
      (cechι f M h).rTensor N =
      cechι f (M ⊗[R] N) h ∘ₗ (localizationTensorEquiv (cechSub f s) M N).toLinearMap := by
    apply IsLocalizedModule.ext (cechSub f s)
      (TensorProduct.AlgebraTensorModule.rTensor R N (LocalizedModule.mkLinearMap (cechSub f s) M))
      (isUnit_algebraMap f (M ⊗[R] N) h (LocalizedModule.mkLinearMap (cechSub f t) (M ⊗[R] N)))
    apply TensorProduct.ext'
    intro m n
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
      TensorProduct.AlgebraTensorModule.rTensor_tmul, LinearMap.rTensor_tmul]
    rw [cechι_mk, localizationTensorEquiv_mk_tmul, localizationTensorEquiv_mk_tmul, cechι_mk]
  exact LinearMap.congr_fun key y

/-- The components of the Čech differential. -/
theorem glueingDifferential_apply
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (N : Type v) [AddCommGroup N] [Module R N] (p : ℕ) (x : GlueingTerm f N p)
    (T : {s : Finset (Fin r) // s.card = p + 1}) :
    glueingDifferential f N p x T =
      ∑ k ∈ T.1.attach, cechSign T.1 k •
        cechι f N (Finset.erase_subset _ _) (x (eraseIndex p T k)) := by
  simp only [glueingDifferential, LinearMap.pi_apply, LinearMap.sum_apply]
  rfl

private theorem glueingTermTensorEquiv_tmul_apply
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] (p : ℕ) (x : GlueingTerm f M p) (n : N)
    (s : {s : Finset (Fin r) // s.card = p}) :
    glueingTermTensorEquiv f M N p (x ⊗ₜ[R] n) s =
      localizationTensorEquiv (cechSub f s.val) M N (x s ⊗ₜ[R] n) := by
  simp [glueingTermTensorEquiv]

/-- The identification of the base change of the glueing complex with the glueing complex of
the base change commutes with the Čech differential. -/
private theorem glueingTermTensorEquiv_differential
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] (p : ℕ) (y : GlueingTerm f M p ⊗[R] N) :
    glueingTermTensorEquiv f M N (p + 1) ((glueingDifferential f M p).rTensor N y) =
      glueingDifferential f (M ⊗[R] N) p (glueingTermTensorEquiv f M N p y) := by
  induction y using TensorProduct.inductionOn with
  | tmul x n =>
    funext T
    rw [LinearMap.rTensor_tmul, glueingTermTensorEquiv_tmul_apply, glueingDifferential_apply,
      glueingDifferential_apply, TensorProduct.sum_tmul, map_sum]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    have h1 : ∀ (c : ℤ) (u : cechMod f M (T.1.erase k)),
        localizationTensorEquiv (cechSub f T.1) M N
            ((c • cechι f M (Finset.erase_subset k.1 T.1) u) ⊗ₜ[R] n) =
          c • cechι f (M ⊗[R] N) (Finset.erase_subset k.1 T.1)
            (localizationTensorEquiv (cechSub f (T.1.erase k)) M N (u ⊗ₜ[R] n)) := by
      intro c u
      have hz : (c • cechι f M (Finset.erase_subset k.1 T.1) u) ⊗ₜ[R] n =
          c • (cechι f M (Finset.erase_subset k.1 T.1) u ⊗ₜ[R] n) :=
        map_zsmul ((TensorProduct.mk R (cechMod f M T.1) N).flip n) c _
      rw [hz, map_zsmul, ← LinearMap.rTensor_tmul, localizationTensorEquiv_cechι]
    rw [glueingTermTensorEquiv_tmul_apply]
    exact h1 _ _
  | add x y hx hy => simp only [map_add, hx, hy]

/-- A three-element subset of `Fin r` is `{a, b, c}` for some `a < b < c`. -/
theorem exists_lt_lt_eq_of_card_eq_three {r : ℕ} {T : Finset (Fin r)} (hT : T.card = 3) :
    ∃ a b c : Fin r, a < b ∧ b < c ∧ T = {a, b, c} := by
  obtain ⟨x, y, z, hxy, hxz, hyz, rfl⟩ := Finset.card_eq_three.mp hT
  have e1 : ({x, y, z} : Finset (Fin r)) = {x, z, y} := by ext; simp; tauto
  have e2 : ({x, y, z} : Finset (Fin r)) = {y, x, z} := by ext; simp; tauto
  have e3 : ({x, y, z} : Finset (Fin r)) = {y, z, x} := by ext; simp; tauto
  have e4 : ({x, y, z} : Finset (Fin r)) = {z, x, y} := by ext; simp; tauto
  have e5 : ({x, y, z} : Finset (Fin r)) = {z, y, x} := by ext; simp; tauto
  rcases lt_or_gt_of_ne hxy with h1 | h1 <;> rcases lt_or_gt_of_ne hxz with h2 | h2 <;>
    rcases lt_or_gt_of_ne hyz with h3 | h3
  · exact ⟨x, y, z, h1, h3, rfl⟩
  · exact ⟨x, z, y, h2, h3, e1⟩
  · exact absurd (h1.trans h3) (not_lt.mpr h2.le)
  · exact ⟨z, x, y, h2, h1, e4⟩
  · exact ⟨y, x, z, h1, h2, e2⟩
  · exact absurd (h2.trans h3) (lt_asymm h1)
  · exact ⟨y, z, x, h3, h2, e3⟩
  · exact ⟨z, y, x, h3, h1, e5⟩

/-- The Čech differentials of the glueing complex compose to zero in degrees one and two. -/
theorem glueingDifferential_two_comp_one
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M] :
    glueingDifferential f M 2 ∘ₗ glueingDifferential f M 1 = 0 := by
  refine LinearMap.ext fun x ↦ funext fun ⟨T, hT⟩ ↦ ?_
  obtain ⟨a, b, c, hab, hbc, rfl⟩ := exists_lt_lt_eq_of_card_eq_three hT
  rw [LinearMap.comp_apply, LinearMap.zero_apply, Pi.zero_apply,
    glueingDifferential_apply_triple f _ hab hbc,
    glueingDifferential_apply_pair f x hbc, glueingDifferential_apply_pair f x (hab.trans hbc),
    glueingDifferential_apply_pair f x hab]
  simp only [map_sub, cechι_cechι]
  abel

/-- The third map of the glueing complex,
`(∏ i, (M ⊗[R] S)_{f i}) × (∏ i < j, M_{f i f j}) →
(∏ i < j, (M ⊗[R] S)_{f i f j}) × ∏ M_{f i f j f k}`:
its first component is `(y, x) ↦ d y - x ⊗ 1` and its second component is `(y, x) ↦ d x`. -/
public noncomputable def glueingGamma {R : Type u} [CommRing R] (S : Type v) [CommRing S]
    [Algebra R S] {r : ℕ} (f : Fin r → R) (M : Type w) [AddCommGroup M] [Module R M] :
    GlueingTerm f (TensorProduct R M S) 1 × GlueingTerm f M 2 →ₗ[R]
      GlueingTerm f (TensorProduct R M S) 2 × GlueingTerm f M 3 :=
  LinearMap.prod
    ((glueingDifferential f (TensorProduct R M S) 1).comp
        (LinearMap.fst R (GlueingTerm f (TensorProduct R M S) 1) (GlueingTerm f M 2)) -
      (localizationTensorMap S f M 2).comp
        (LinearMap.snd R (GlueingTerm f (TensorProduct R M S) 1) (GlueingTerm f M 2)))
    ((glueingDifferential f M 2).comp
      (LinearMap.snd R (GlueingTerm f (TensorProduct R M S) 1) (GlueingTerm f M 2)))

private theorem localizationTensorMap_differential
    {R : Type u} [CommRing R] (S : Type v) [CommRing S] [Algebra R S] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M] (p : ℕ) (x : GlueingTerm f M p) :
    localizationTensorMap S f M (p + 1) (glueingDifferential f M p x) =
      glueingDifferential f (M ⊗[R] S) p (localizationTensorMap S f M p x) := by
  rw [← glueingTermTensorEquiv_unit_deg, ← glueingTermTensorEquiv_unit_deg,
    ← LinearMap.rTensor_tmul, glueingTermTensorEquiv_differential]

/-- **Exactness of the glueing complex at its third term.** If `R → S` is flat and induces an
isomorphism modulo the ideal generated by `f`, then every element killed by the third map of the
glueing complex of `M` is in the image of its second map. -/
public theorem glueingComplex_exact_third
    (R : Type u) (S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type u) [AddCommGroup M] [Module R M]
    (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap
        ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (y : GlueingTerm f (TensorProduct R M S) 1) (x : GlueingTerm f M 2)
    (h : glueingGamma S f M (y, x) = 0) :
    ∃ z : TensorProduct R M S × GlueingTerm f M 1, glueingBeta S f M z = (y, x) := by
  set I := Ideal.span (Set.range f)
  have h₁ : glueingDifferential f (M ⊗[R] S) 1 y = localizationTensorMap S f M 2 x :=
    sub_eq_zero.mp (congrArg Prod.fst h)
  have h₂ : glueingDifferential f M 2 x = 0 := congrArg Prod.snd h
  -- the torsion of the two cohomology modules involved
  have htors₂ : IsIPowerTorsion R
      (cohomologyModule (glueingDifferential f M 1) (glueingDifferential f M 2)) I := by
    intro c
    obtain ⟨⟨z, hz⟩, rfl⟩ := Submodule.mkQ_surjective _ c
    apply exists_pow_annihilator_of_generators
    intro i
    obtain ⟨n, w, hw⟩ := exists_pow_smul_eq_glueingDifferential_of_cocycle f z hz i
    refine ⟨n, ?_⟩
    rw [← map_smul]
    exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨w, hw.symm⟩
  have htors₁ : IsIPowerTorsion R
      (cohomologyModule (localizationDiagonal f M) (glueingDifferential f M 1)) I := by
    intro c
    obtain ⟨⟨z, hz⟩, rfl⟩ := Submodule.mkQ_surjective _ c
    obtain ⟨n, hn, hann⟩ := cocycle_class_torsion f z hz
    refine ⟨n, hn, fun a ha ↦ ?_⟩
    have := hann a ha
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
    rw [← map_smul]
    exact (Submodule.Quotient.mk_eq_zero _).mpr this
  -- step 1: `x` is a coboundary
  let e₁ := glueingTermTensorEquiv f M S 1
  let e₂ := glueingTermTensorEquiv f M S 2
  have hx : x ⊗ₜ[R] (1 : S) ∈ LinearMap.range ((glueingDifferential f M 1).rTensor S) := by
    refine ⟨e₁.symm y, e₂.injective ?_⟩
    rw [glueingTermTensorEquiv_differential, LinearEquiv.apply_symm_apply, h₁,
      glueingTermTensorEquiv_unit_deg]
  obtain ⟨w, hw⟩ := mem_range_of_tmul_one_mem_range_rTensor I hflat hq
    (glueingDifferential_two_comp_one f M) htors₂ h₂ hx
  -- step 2: `y - w ⊗ 1` is a cocycle, hence a base change up to a coboundary
  have hy' : (glueingDifferential f M 1).rTensor S
      (e₁.symm (y - localizationTensorMap S f M 1 w)) = 0 := by
    apply e₂.injective
    rw [glueingTermTensorEquiv_differential, LinearEquiv.apply_symm_apply, map_sub,
      ← localizationTensorMap_differential, hw, h₁, sub_self, map_zero]
  have hdd : glueingDifferential f M 1 ∘ₗ localizationDiagonal f M = 0 := by
    refine LinearMap.ext fun m ↦ ?_
    have := congrArg (fun φ ↦ (φ m).2) (glueingBeta_comp_glueingAlpha S f M)
    simpa [glueingBeta, glueingAlpha] using this
  obtain ⟨v, hv, t, ht⟩ := exists_eq_tmul_one_add_of_rTensor_eq_zero I hflat hq hdd htors₁ hy'
  have ht' : localizationDiagonal f (M ⊗[R] S) t =
      y - localizationTensorMap S f M 1 w - localizationTensorMap S f M 1 v := by
    rw [← glueingTermTensorEquiv_diagonal, ht, map_sub, LinearEquiv.apply_symm_apply,
      glueingTermTensorEquiv_unit_deg]
  refine ⟨(t, -w - v), Prod.ext ?_ ?_⟩
  · change localizationDiagonal f (M ⊗[R] S) t - localizationTensorMap S f M 1 (-w - v) = y
    rw [ht', map_sub, map_neg]
    abel
  · change -(glueingDifferential f M 1 (-w - v)) = x
    rw [map_sub, map_neg, hv, sub_zero, neg_neg, hw]

public theorem singleton_subset_pair_left' {r : ℕ} (a b : Fin r) :
    ({a} : Finset (Fin r)) ⊆ {a, b} := by
  simp

public theorem singleton_subset_pair_right' {r : ℕ} (a b : Fin r) :
    ({b} : Finset (Fin r)) ⊆ {a, b} := by
  simp

/-- The index of a one-element index set. -/
noncomputable def oneIndex {r : ℕ} (s : {s : Finset (Fin r) // s.card = 1}) : Fin r :=
  (Finset.card_eq_one.mp s.2).choose

theorem oneIndex_spec {r : ℕ} (s : {s : Finset (Fin r) // s.card = 1}) :
    s.1 = {oneIndex s} :=
  (Finset.card_eq_one.mp s.2).choose_spec

theorem oneIndex_singletonIndex {r : ℕ} (i : Fin r) : oneIndex (singletonIndex i) = i :=
  Finset.singleton_inj.mp (oneIndex_spec (singletonIndex i)).symm

theorem cechSub_eq_powers_of_eq_singleton {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {s : Finset (Fin r)} {i : Fin r} (h : s = {i}) : cechSub f s = Submonoid.powers (f i) := by
  subst h
  simp [cechSub]

theorem cechSub_eq_powers_of_eq_pair {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {s : Finset (Fin r)} {i j : Fin r} (hij : i ≠ j) (h : s = {i, j}) :
    cechSub f s = Submonoid.powers (f i * f j) := by
  subst h
  simp [cechSub, Finset.prod_pair hij]

/-- A two-element index set is `{a, b}` for some `a < b`. -/
private theorem exists_lt_eq_of_card_eq_two_aux {r : ℕ} {T : Finset (Fin r)} (hT : T.card = 2) :
    ∃ a b : Fin r, a < b ∧ T = {a, b} := by
  obtain ⟨a, b, hne, rfl⟩ := Finset.card_eq_two.mp hT
  rcases lt_or_gt_of_ne hne with h | h
  · exact ⟨a, b, h, rfl⟩
  · exact ⟨b, a, h, Finset.pair_comm a b⟩

/-- A localization model of `M` at `cechSub f s`, compared with the canonical localization: the
linear equivalence and its value on the image of `M`. -/
private theorem exists_cechMod_equiv_aux
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) {M : Type u} [AddCommGroup M] [Module R M]
    {L : Type u} [AddCommGroup L] [Module R L] (l : M →ₗ[R] L) (s : Finset (Fin r))
    [IsLocalizedModule (cechSub f s) l] :
    ∃ Φ : cechMod f M s ≃ₗ[R] L, ∀ m, Φ (LocalizedModule.mkLinearMap _ M m) = l m :=
  ⟨IsLocalizedModule.linearEquiv (cechSub f s) (LocalizedModule.mkLinearMap (cechSub f s) M) l,
    fun m ↦ IsLocalizedModule.linearEquiv_apply _ _ _ m⟩

/-- Naturality of the comparison with a model: if `g : L_t → L_s` is compatible with the
localization maps, it corresponds to the canonical restriction `cechι`. -/
private theorem cechι_comparison_aux
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) {M : Type u} [AddCommGroup M] [Module R M]
    {t s : Finset (Fin r)} (h : t ⊆ s)
    {Lt Ls : Type u} [AddCommGroup Lt] [Module R Lt] [AddCommGroup Ls] [Module R Ls]
    (lt : M →ₗ[R] Lt) (ls : M →ₗ[R] Ls) [IsLocalizedModule (cechSub f s) ls]
    (Φt : cechMod f M t ≃ₗ[R] Lt) (hΦt : ∀ m, Φt (LocalizedModule.mkLinearMap _ M m) = lt m)
    (Φs : cechMod f M s ≃ₗ[R] Ls) (hΦs : ∀ m, Φs (LocalizedModule.mkLinearMap _ M m) = ls m)
    (g : Lt →ₗ[R] Ls) (hg : g ∘ₗ lt = ls) (z : cechMod f M t) :
    Φs (cechι f M h z) = g (Φt z) := by
  have hunits : ∀ y : cechSub f t, IsUnit (algebraMap R (Module.End R Ls) y) := by
    rintro ⟨_, n, rfl⟩
    obtain ⟨c, hc⟩ := Finset.prod_dvd_prod_of_subset t s f h
    have hu := IsLocalizedModule.map_units ls
      (⟨(∏ i ∈ s, f i) ^ n, n, rfl⟩ : cechSub f s)
    change IsUnit (algebraMap R (Module.End R Ls) ((∏ i ∈ s, f i) ^ n)) at hu
    rw [hc, mul_pow, map_mul] at hu
    have hcomm : Commute (algebraMap R (Module.End R Ls) ((∏ i ∈ t, f i) ^ n))
        (algebraMap R (Module.End R Ls) (c ^ n)) :=
      Algebra.commutes ((∏ i ∈ t, f i) ^ n) (algebraMap R (Module.End R Ls) (c ^ n))
    exact ((Commute.isUnit_mul_iff hcomm).mp hu).1
  have hext : Φs.toLinearMap ∘ₗ cechι f M h = g ∘ₗ Φt.toLinearMap := by
    apply IsLocalizedModule.ext (cechSub f t) (LocalizedModule.mkLinearMap (cechSub f t) M) hunits
    refine LinearMap.ext fun m ↦ ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe, cechι_mk, hΦs, hΦt]
    exact (LinearMap.congr_fun hg m).symm
  exact LinearMap.congr_fun hext z

/-- The comparison with models commutes with the tensor map `m ↦ m ⊗ 1`. -/
private theorem localizedModule_map_tensor_one_comparison
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) {M : Type u} [AddCommGroup M] [Module R M]
    (S : Type u) [CommRing S] [Algebra R S] (s : Finset (Fin r))
    {L LS : Type u} [AddCommGroup L] [Module R L] [AddCommGroup LS] [Module R LS]
    (l : M →ₗ[R] L) (lS : M ⊗[R] S →ₗ[R] LS) [IsLocalizedModule (cechSub f s) lS]
    (Φ : cechMod f M s ≃ₗ[R] L) (hΦ : ∀ m, Φ (LocalizedModule.mkLinearMap _ M m) = l m)
    (Ψ : cechMod f (M ⊗[R] S) s ≃ₗ[R] LS)
    (hΨ : ∀ z, Ψ (LocalizedModule.mkLinearMap _ (M ⊗[R] S) z) = lS z)
    (κ : L →ₗ[R] LS) (hκ : ∀ m, κ (l m) = lS (m ⊗ₜ[R] (1 : S))) (z : cechMod f M s) :
    Ψ (LocalizedModule.map (cechSub f s) ((TensorProduct.mk R M S).flip 1) z) = κ (Φ z) := by
  have hext : Ψ.toLinearMap ∘ₗ
      (LocalizedModule.map (cechSub f s) ((TensorProduct.mk R M S).flip 1)).restrictScalars R =
      κ ∘ₗ Φ.toLinearMap := by
    apply IsLocalizedModule.ext (cechSub f s) (LocalizedModule.mkLinearMap (cechSub f s) M)
      (IsLocalizedModule.map_units lS)
    refine LinearMap.ext fun m ↦ ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
      LinearMap.coe_restrictScalars, hΦ]
    rw [show LocalizedModule.map (cechSub f s) ((TensorProduct.mk R M S).flip 1)
        (LocalizedModule.mkLinearMap (cechSub f s) M m) =
        LocalizedModule.mkLinearMap _ (M ⊗[R] S) (m ⊗ₜ (1 : S)) by
      simp [LocalizedModule.map_mk], hΨ]
    exact (hκ m).symm
  exact LinearMap.congr_fun hext z

/-- **Formal glueing for modules, read on models.** Let `R → S` be flat and an isomorphism
modulo the ideal generated by `f`, let `M` be an `R`-module, `μ : M → N` a base change of `M` to
`S`, `λ i : M → L i` localizations away from `f i`, `λ₂ i j : M → L₂ i j` localizations away from
`f i * f j` (for `i ≠ j`) and `lS i : N → LS i` localizations away from `f i`, with restriction
maps compatible with these. Then an element of `N` together with a family of elements of the
`L i` which agree on the overlaps and with the element of `N` comes from a unique element of `M`.
This is the exactness of the glueing complex at its second term (Stacks 05EK), transported from
the canonical localizations to arbitrary models. -/
public theorem glueing_exact_middle_of_models
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type u) [AddCommGroup M] [Module R M]
    (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    {N : Type u} [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    (μ : M →ₗ[R] N) (hμ : IsBaseChange S μ)
    {L : Fin r → Type u} [∀ i, AddCommGroup (L i)] [∀ i, Module R (L i)]
    (l₁ : ∀ i, M →ₗ[R] L i) [∀ i, IsLocalizedModule (Submonoid.powers (f i)) (l₁ i)]
    {L₂ : Fin r → Fin r → Type u} [∀ i j, AddCommGroup (L₂ i j)] [∀ i j, Module R (L₂ i j)]
    (l₂ : ∀ i j, M →ₗ[R] L₂ i j)
    (hl₂ : ∀ i j, i ≠ j → IsLocalizedModule (Submonoid.powers (f i * f j)) (l₂ i j))
    {LS : Fin r → Type u} [∀ i, AddCommGroup (LS i)] [∀ i, Module R (LS i)]
    (lS : ∀ i, N →ₗ[R] LS i) [∀ i, IsLocalizedModule (Submonoid.powers (f i)) (lS i)]
    (ρ : ∀ i j, L i →ₗ[R] L₂ i j) (hρ : ∀ i j, ρ i j ∘ₗ l₁ i = l₂ i j)
    (ρ' : ∀ i j, L j →ₗ[R] L₂ i j) (hρ' : ∀ i j, ρ' i j ∘ₗ l₁ j = l₂ i j)
    (κ : ∀ i, L i →ₗ[R] LS i) (hκ : ∀ i, κ i ∘ₗ l₁ i = lS i ∘ₗ μ)
    (y : N) (x : ∀ i, L i) (h₁ : ∀ i, lS i y = κ i (x i))
    (h₂ : ∀ i j, i ≠ j → ρ i j (x i) = ρ' i j (x j)) :
    ∃ m : M, μ m = y ∧ ∀ i, l₁ i m = x i := by
  classical
  -- the base change, as `M ⊗[R] S`
  let θ : M ⊗[R] S ≃ₗ[R] N := (TensorProduct.comm R M S).trans (hμ.equiv.restrictScalars R)
  have hθ : ∀ m, θ (m ⊗ₜ (1 : S)) = μ m := fun m ↦ by
    simp [θ, IsBaseChange.equiv_tmul]
  -- the canonical localizations at one-element sets are the models
  have hloc : ∀ i, IsLocalizedModule (cechSub f {i}) (l₁ i) := fun i ↦ by
    rw [cechSub_eq_powers_of_eq_singleton f rfl]; infer_instance
  have hlocS : ∀ i, IsLocalizedModule (cechSub f {i}) (lS i ∘ₗ θ.toLinearMap) := fun i ↦ by
    rw [cechSub_eq_powers_of_eq_singleton f rfl]; infer_instance
  choose Φ hΦ using fun i : Fin r ↦ (haveI := hloc i; exists_cechMod_equiv_aux f (l₁ i) {i})
  choose Ψ hΨ using fun i : Fin r ↦
    (haveI := hlocS i; exists_cechMod_equiv_aux f (lS i ∘ₗ θ.toLinearMap) {i})
  -- the data, moved to the canonical localizations
  let y' : M ⊗[R] S := θ.symm y
  let x' : GlueingTerm f M 1 := fun s ↦
    LinearEquiv.cast (R := R) (M := fun q : Finset (Fin r) ↦ cechMod f M q) (oneIndex_spec s).symm
      ((Φ (oneIndex s)).symm (x (oneIndex s)))
  have hx' : ∀ i, x' (singletonIndex i) = (Φ i).symm (x i) := by
    intro i
    have key : ∀ (k : Fin r) (hk : k = i) (h : ({k} : Finset (Fin r)) = {i}),
        LinearEquiv.cast (R := R) (M := fun q : Finset (Fin r) ↦ cechMod f M q) h
            ((Φ k).symm (x k)) =
          (Φ i).symm (x i) := by
      rintro k rfl h
      rfl
    exact key _ (oneIndex_singletonIndex i) _
  -- every one-element index set is a `singletonIndex`
  have hsing : ∀ s : {s : Finset (Fin r) // s.card = 1}, s = singletonIndex (oneIndex s) :=
    fun s ↦ Subtype.ext (oneIndex_spec s)
  -- the comparison of the tensor maps
  have hΨκ : ∀ i (z : cechMod f M {i}),
      Ψ i (LocalizedModule.map (cechSub f {i}) ((TensorProduct.mk R M S).flip 1) z) =
        κ i (Φ i z) := fun i z ↦ by
    have := hlocS i
    exact localizedModule_map_tensor_one_comparison f S {i} (l₁ i) (lS i ∘ₗ θ.toLinearMap) (Φ i)
      (hΦ i) (Ψ i) (hΨ i) (κ i) (fun m ↦ by simpa [hθ] using (LinearMap.congr_fun (hκ i) m)) z
  -- the comparison of the restriction maps
  have hpair : ∀ (a b : Fin r) (hab : a ≠ b), cechι f M (singleton_subset_pair_left' a b)
      (x' (singletonIndex a)) = cechι f M (singleton_subset_pair_right' a b)
      (x' (singletonIndex b)) := by
    intro a b hab
    have := hl₂ a b hab
    have hloc₂ : IsLocalizedModule (cechSub f {a, b}) (l₂ a b) := by
      rw [cechSub_eq_powers_of_eq_pair f hab rfl]; infer_instance
    obtain ⟨Φ₂, hΦ₂⟩ := exists_cechMod_equiv_aux f (l₂ a b) {a, b}
    apply Φ₂.injective
    rw [cechι_comparison_aux f _ (l₁ a) (l₂ a b) (Φ a) (hΦ a) Φ₂ hΦ₂ (ρ a b) (hρ a b),
      cechι_comparison_aux f _ (l₁ b) (l₂ a b) (Φ b) (hΦ b) Φ₂ hΦ₂ (ρ' a b) (hρ' a b), hx', hx',
      LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply, h₂ a b hab]
  have hβ : glueingBeta S f M (y', x') = 0 := by
    refine Prod.ext ?_ ?_
    · funext s
      rw [hsing s]
      set i := oneIndex s
      apply (Ψ i).injective
      change Ψ i (LocalizedModule.mkLinearMap _ (M ⊗[R] S) y' -
        LocalizedModule.map (cechSub f {i}) ((TensorProduct.mk R M S).flip 1)
          (x' (singletonIndex i))) = Ψ i 0
      rw [map_sub, hΨ, hΨκ, hx', LinearMap.comp_apply, LinearEquiv.coe_coe,
        LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply, h₁, sub_self, map_zero]
    · funext ⟨T, hT⟩
      obtain ⟨a, b, hab, rfl⟩ := exists_lt_eq_of_card_eq_two_aux hT
      change -(glueingDifferential f M 1 x' (pairIndex hab.ne)) = 0
      rw [glueingDifferential_apply_pair f x' hab, hpair a b hab.ne, sub_self, neg_zero]
  obtain ⟨m, hm⟩ := ((glueingComplex_exact R S f M hflat hq).2 (y', x')).mp hβ
  refine ⟨m, ?_, fun i ↦ ?_⟩
  · have := congrArg Prod.fst hm
    change m ⊗ₜ (1 : S) = y' at this
    rw [← hθ, this, LinearEquiv.apply_symm_apply]
  · have := congrFun (congrArg Prod.snd hm) (singletonIndex i)
    change LocalizedModule.mkLinearMap _ M m = x' (singletonIndex i) at this
    rw [← hΦ, this, hx', LinearEquiv.apply_symm_apply]

/-- **Formal glueing for modules, read on models: injectivity.** In the situation of
`FormalGlueing.glueing_exact_middle_of_models`, an element of `M` vanishing in the base change and
in every localization `L i` is zero (Stacks 05EK, first term). -/
public theorem glueing_injective_of_models
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type u) [AddCommGroup M] [Module R M]
    (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    {N : Type u} [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    (μ : M →ₗ[R] N) (hμ : IsBaseChange S μ)
    {L : Fin r → Type u} [∀ i, AddCommGroup (L i)] [∀ i, Module R (L i)]
    (l₁ : ∀ i, M →ₗ[R] L i) [∀ i, IsLocalizedModule (Submonoid.powers (f i)) (l₁ i)]
    (m : M) (h₀ : μ m = 0) (h₁ : ∀ i, l₁ i m = 0) : m = 0 := by
  classical
  let θ : M ⊗[R] S ≃ₗ[R] N := (TensorProduct.comm R M S).trans (hμ.equiv.restrictScalars R)
  have hθ : θ (m ⊗ₜ (1 : S)) = μ m := by simp [θ, IsBaseChange.equiv_tmul]
  apply (glueingComplex_exact R S f M hflat hq).1
  rw [map_zero]
  refine Prod.ext ?_ ?_
  · change m ⊗ₜ (1 : S) = 0
    apply θ.injective
    rw [hθ, h₀, map_zero]
  · funext s
    change LocalizedModule.mkLinearMap (cechSub f s.1) M m = 0
    have hloc : IsLocalizedModule (cechSub f s.1) (l₁ (oneIndex s)) := by
      rw [cechSub_eq_powers_of_eq_singleton f (oneIndex_spec s)]; infer_instance
    obtain ⟨Φ, hΦ⟩ := exists_cechMod_equiv_aux f (l₁ (oneIndex s)) s.1
    apply Φ.injective
    rw [hΦ, h₁, map_zero]

/-- A two-element index set is `{a, b}` for some `a < b`. -/
theorem exists_lt_eq_of_card_eq_two {r : ℕ} {T : Finset (Fin r)} (hT : T.card = 2) :
    ∃ a b : Fin r, a < b ∧ T = {a, b} :=
  exists_lt_eq_of_card_eq_two_aux hT

/-- A localization model of `M` at `cechSub f s`, compared with the canonical localization: the
linear equivalence and its value on the image of `M`. -/
theorem exists_cechMod_equiv_of_isLocalizedModule
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) {M : Type u} [AddCommGroup M] [Module R M]
    {L : Type u} [AddCommGroup L] [Module R L] (l : M →ₗ[R] L) (s : Finset (Fin r))
    [IsLocalizedModule (cechSub f s) l] :
    ∃ Φ : cechMod f M s ≃ₗ[R] L, ∀ m, Φ (LocalizedModule.mkLinearMap _ M m) = l m :=
  exists_cechMod_equiv_aux f l s

/-- **Naturality of the comparison with a model.** If `Φ_t : M_t ≃ L_t` and `Φ_s : M_s ≃ L_s`
compare the canonical localizations with models, and `g : L_t → L_s` is compatible with the
localization maps, then `g` corresponds to the canonical restriction `cechι`. -/
theorem cechι_comparison
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) {M : Type u} [AddCommGroup M] [Module R M]
    {t s : Finset (Fin r)} (h : t ⊆ s)
    {Lt Ls : Type u} [AddCommGroup Lt] [Module R Lt] [AddCommGroup Ls] [Module R Ls]
    (lt : M →ₗ[R] Lt) (ls : M →ₗ[R] Ls) [IsLocalizedModule (cechSub f s) ls]
    (Φt : cechMod f M t ≃ₗ[R] Lt) (hΦt : ∀ m, Φt (LocalizedModule.mkLinearMap _ M m) = lt m)
    (Φs : cechMod f M s ≃ₗ[R] Ls) (hΦs : ∀ m, Φs (LocalizedModule.mkLinearMap _ M m) = ls m)
    (g : Lt →ₗ[R] Ls) (hg : g ∘ₗ lt = ls) (z : cechMod f M t) :
    Φs (cechι f M h z) = g (Φt z) :=
  cechι_comparison_aux f h lt ls Φt hΦt Φs hΦs g hg z

/-- The sorted representation of a two-element set is unique. -/
public theorem eq_of_pair_eq_pair_of_lt {r : ℕ} {a b a' b' : Fin r} (hab : a < b) (hab' : a' < b')
    (h : ({a', b'} : Finset (Fin r)) = {a, b}) : a' = a ∧ b' = b := by
  have ha' : a' ∈ ({a, b} : Finset (Fin r)) := h ▸ by simp
  have hb' : b' ∈ ({a, b} : Finset (Fin r)) := h ▸ by simp
  have ha : a ∈ ({a', b'} : Finset (Fin r)) := h.symm ▸ by simp
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha' hb' ha
  omega

/-- The smaller element of a two-element index set. -/
public noncomputable def pairFst {r : ℕ} (s : {s : Finset (Fin r) // s.card = 2}) : Fin r :=
  (exists_lt_eq_of_card_eq_two s.2).choose

/-- The larger element of a two-element index set. -/
public noncomputable def pairSnd {r : ℕ} (s : {s : Finset (Fin r) // s.card = 2}) : Fin r :=
  (exists_lt_eq_of_card_eq_two s.2).choose_spec.choose

public theorem pairFst_lt_pairSnd {r : ℕ} (s : {s : Finset (Fin r) // s.card = 2}) :
    pairFst s < pairSnd s :=
  (exists_lt_eq_of_card_eq_two s.2).choose_spec.choose_spec.1

public theorem pair_spec {r : ℕ} (s : {s : Finset (Fin r) // s.card = 2}) :
    s.1 = {pairFst s, pairSnd s} :=
  (exists_lt_eq_of_card_eq_two s.2).choose_spec.choose_spec.2

public theorem pairFst_pairSnd_pairIndex {r : ℕ} {a b : Fin r} (hab : a < b) :
    pairFst (pairIndex hab.ne) = a ∧ pairSnd (pairIndex hab.ne) = b :=
  eq_of_pair_eq_pair_of_lt hab (pairFst_lt_pairSnd _) (pair_spec (pairIndex hab.ne)).symm

/-- **Formal glueing at the third term, read on models.** Let `R → S` be flat and an isomorphism
modulo the ideal generated by `f`, and let `M` be an `R`-module with localization models
`l s : M → L s` and `lS s : M ⊗[R] S → LS s` at the products over nonempty index sets `s`, with
compatible restriction maps. A family `y i ∈ LS {i}` and a family `x_{ab} ∈ L {a, b}` (`a < b`)
which satisfy the cocycle relations of the glueing complex — `y_b - y_a = κ x_{ab}` and
`x_{bc} - x_{ac} + x_{ab} = 0` — come from some `n ∈ M ⊗[R] S` and `z i ∈ L {i}`:
`y_i = n - κ z_i` and `x_{ab} = z_a - z_b`. -/
public theorem glueing_exact_third_of_models
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type u) [AddCommGroup M] [Module R M]
    (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    {L : Finset (Fin r) → Type u} [∀ s, AddCommGroup (L s)] [∀ s, Module R (L s)]
    (l : ∀ s, M →ₗ[R] L s) (hl : ∀ s : Finset (Fin r), s.Nonempty →
      IsLocalizedModule (cechSub f s) (l s))
    {LS : Finset (Fin r) → Type u} [∀ s, AddCommGroup (LS s)] [∀ s, Module R (LS s)]
    (lS : ∀ s, M ⊗[R] S →ₗ[R] LS s) (hlS : ∀ s : Finset (Fin r), s.Nonempty →
      IsLocalizedModule (cechSub f s) (lS s))
    (res : ∀ {t s : Finset (Fin r)}, t ⊆ s → L t →ₗ[R] L s)
    (hres : ∀ {t s : Finset (Fin r)} (h : t ⊆ s), res h ∘ₗ l t = l s)
    (resS : ∀ {t s : Finset (Fin r)}, t ⊆ s → LS t →ₗ[R] LS s)
    (hresS : ∀ {t s : Finset (Fin r)} (h : t ⊆ s), resS h ∘ₗ lS t = lS s)
    (κ : ∀ s, L s →ₗ[R] LS s)
    (hκ : ∀ s, κ s ∘ₗ l s = lS s ∘ₗ (TensorProduct.mk R M S).flip 1)
    (y : ∀ i, LS {i}) (x : ∀ a b, a < b → L {a, b})
    (hy : ∀ a b (hab : a < b),
      resS (singleton_subset_pair_right' a b) (y b) - resS (singleton_subset_pair_left' a b) (y a) =
        κ {a, b} (x a b hab))
    (hx : ∀ a b c (hab : a < b) (hbc : b < c),
      res (show ({b, c} : Finset (Fin r)) ⊆ {a, b, c} by
          intro t; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto) (x b c hbc) -
        res (show ({a, c} : Finset (Fin r)) ⊆ {a, b, c} by
          intro t; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)
          (x a c (hab.trans hbc)) +
        res (show ({a, b} : Finset (Fin r)) ⊆ {a, b, c} by
          intro t; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto) (x a b hab) = 0) :
    ∃ (n : M ⊗[R] S) (z : ∀ i, L {i}),
      (∀ i, lS {i} n - κ {i} (z i) = y i) ∧
        ∀ a b (hab : a < b), res (singleton_subset_pair_left' a b) (z a) -
          res (singleton_subset_pair_right' a b) (z b) = x a b hab := by
  classical
  -- comparison of the canonical localizations with the models
  choose Φ hΦ using fun (s : Finset (Fin r)) (hs : s.Nonempty) ↦
    (haveI := hl s hs; exists_cechMod_equiv_aux f (l s) s)
  choose ΦS hΦS using fun (s : Finset (Fin r)) (hs : s.Nonempty) ↦
    (haveI := hlS s hs; exists_cechMod_equiv_aux f (lS s) s)
  have hne1 : ∀ i : Fin r, ({i} : Finset (Fin r)).Nonempty := fun i ↦ Finset.singleton_nonempty i
  have hne2 : ∀ a b : Fin r, ({a, b} : Finset (Fin r)).Nonempty := fun a b ↦
    Finset.insert_nonempty a {b}
  -- the data on the canonical localizations
  let y' : GlueingTerm f (M ⊗[R] S) 1 := fun s ↦
    (ΦS s.1 (by rw [oneIndex_spec s]; exact hne1 _)).symm
      (LinearEquiv.cast (R := R) (M := LS) (oneIndex_spec s).symm (y (oneIndex s)))
  let x' : GlueingTerm f M 2 := fun s ↦
    (Φ s.1 (by rw [pair_spec s]; exact hne2 _ _)).symm
      (LinearEquiv.cast (R := R) (M := L) (pair_spec s).symm
        (x (pairFst s) (pairSnd s) (pairFst_lt_pairSnd s)))
  have hy' : ∀ i, y' (singletonIndex i) = (ΦS {i} (hne1 i)).symm (y i) := by
    intro i
    have key : ∀ (k : Fin r) (hk : k = i) (h : ({k} : Finset (Fin r)) = {i}),
        LinearEquiv.cast (R := R) (M := LS) h (y k) = y i := by
      rintro k rfl h; rfl
    exact congrArg (ΦS {i} (hne1 i)).symm (key _ (oneIndex_singletonIndex i) _)
  have hx' : ∀ a b (hab : a < b),
      x' (pairIndex hab.ne) = (Φ {a, b} (hne2 a b)).symm (x a b hab) := by
    intro a b hab
    have key : ∀ (a' b' : Fin r) (ha : a' = a) (hb : b' = b) (h' : a' < b')
        (h : ({a', b'} : Finset (Fin r)) = {a, b}),
        LinearEquiv.cast (R := R) (M := L) h (x a' b' h') = x a b hab := by
      rintro a' b' rfl rfl h' h; rfl
    exact congrArg (Φ {a, b} (hne2 a b)).symm
      (key _ _ (pairFst_pairSnd_pairIndex hab).1 (pairFst_pairSnd_pairIndex hab).2 _ _)
  -- the comparisons commute with restriction and with the tensor maps
  have hres' : ∀ {t s : Finset (Fin r)} (h : t ⊆ s) (ht : t.Nonempty) (hs : s.Nonempty)
      (z : cechMod f M t), Φ s hs (cechι f M h z) = res h (Φ t ht z) := by
    intro t s h ht hs z
    have := hl s hs
    exact cechι_comparison f h (l t) (l s) (Φ t ht) (hΦ t ht) (Φ s hs) (hΦ s hs) (res h) (hres h) z
  have hresS' : ∀ {t s : Finset (Fin r)} (h : t ⊆ s) (ht : t.Nonempty) (hs : s.Nonempty)
      (z : cechMod f (M ⊗[R] S) t), ΦS s hs (cechι f (M ⊗[R] S) h z) = resS h (ΦS t ht z) := by
    intro t s h ht hs z
    have := hlS s hs
    exact cechι_comparison f h (lS t) (lS s) (ΦS t ht) (hΦS t ht) (ΦS s hs) (hΦS s hs) (resS h)
      (hresS h) z
  have hten : ∀ s (hs : s.Nonempty) (z : cechMod f M s),
      ΦS s hs (LocalizedModule.map (cechSub f s) ((TensorProduct.mk R M S).flip 1) z) =
        κ s (Φ s hs z) := fun s hs z ↦ by
    have := hlS s hs
    exact localizedModule_map_tensor_one_comparison f S s (l s) (lS s) (Φ s hs) (hΦ s hs)
      (ΦS s hs) (hΦS s hs) (κ s) (fun m ↦ LinearMap.congr_fun (hκ s) m) z
  -- the canonical data is a cocycle
  have hγ : glueingGamma S f M (y', x') = 0 := by
    refine Prod.ext ?_ ?_
    · funext ⟨T, hT⟩
      obtain ⟨a, b, hab, rfl⟩ := exists_lt_eq_of_card_eq_two hT
      change glueingDifferential f (M ⊗[R] S) 1 y' (pairIndex hab.ne) -
        LocalizedModule.map (cechSub f {a, b}) ((TensorProduct.mk R M S).flip 1)
          (x' (pairIndex hab.ne)) = 0
      rw [glueingDifferential_apply_pair f y' hab, hy', hy', hx' a b hab]
      apply (ΦS {a, b} (hne2 a b)).injective
      rw [map_sub, map_sub, map_zero, hresS' _ (hne1 b) (hne2 a b), hresS' _ (hne1 a) (hne2 a b),
        hten _ (hne2 a b),
        LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply,
        hy a b hab, sub_self]
    · funext ⟨T, hT⟩
      obtain ⟨a, b, c, hab, hbc, rfl⟩ := exists_lt_lt_eq_of_card_eq_three hT
      change glueingDifferential f M 2 x' ⟨{a, b, c}, hT⟩ = 0
      rw [glueingDifferential_apply_triple f x' hab hbc, hx' b c hbc, hx' a c (hab.trans hbc),
        hx' a b hab]
      apply (Φ {a, b, c} (Finset.insert_nonempty a _)).injective
      rw [map_add, map_sub, map_zero, hres' _ (hne2 b c) (Finset.insert_nonempty a _),
        hres' _ (hne2 a c) (Finset.insert_nonempty a _),
        hres' _ (hne2 a b) (Finset.insert_nonempty a _),
        LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
      exact hx a b c hab hbc
  obtain ⟨⟨n, z'⟩, hnz⟩ := glueingComplex_exact_third R S f M hflat hq y' x' hγ
  refine ⟨n, fun i ↦ Φ {i} (hne1 i) (z' (singletonIndex i)), fun i ↦ ?_, fun a b hab ↦ ?_⟩
  · have h1 := congrFun (congrArg Prod.fst hnz) (singletonIndex i)
    change LocalizedModule.mkLinearMap _ (M ⊗[R] S) n -
      LocalizedModule.map (cechSub f {i}) ((TensorProduct.mk R M S).flip 1)
        (z' (singletonIndex i)) = y' (singletonIndex i) at h1
    rw [hy'] at h1
    have h1' := congrArg (ΦS {i} (hne1 i)) h1
    rwa [map_sub, hΦS _ (hne1 i), hten _ (hne1 i), LinearEquiv.apply_symm_apply] at h1'
  · have h2 := congrFun (congrArg Prod.snd hnz) (pairIndex hab.ne)
    change -(glueingDifferential f M 1 z' (pairIndex hab.ne)) = x' (pairIndex hab.ne) at h2
    rw [glueingDifferential_apply_pair f z' hab, hx' a b hab] at h2
    have h2' := congrArg (Φ {a, b} (hne2 a b)) h2
    rwa [map_neg, map_sub, hres' _ (hne1 b) (hne2 a b), hres' _ (hne1 a) (hne2 a b),
      LinearEquiv.apply_symm_apply, neg_sub] at h2'

end FormalGlueing

