/-!
# Exactness of the glueing complex of a module

For a ring map `R → S`, a finite family `f = (f₁, …, f_t)` in `R` and an `R`-module `M`, this
file proves that the glueing complex of `FormalGlueingComplex.Basic` is exact — including at its
initial term — as soon as `R → S` is flat and induces an isomorphism `R / I ≅ S / IS` for
`I = (f₁, …, f_t)`.

## Main results

* `FormalGlueing.glueingComplex_exact`: the first map is injective and the complex is exact at
  its middle term under flat base change which is an isomorphism modulo the ideal generated by
  the localization parameters.

## References

* [Stacks Project, Tag 05EK](https://stacks.math.columbia.edu/tag/05EK)
-/

/-! ### Exactness of the module glueing complex -/

section

namespace FormalGlueing

open TensorProduct FormalGlueing Cech

universe u v w w'

open _root_.IPowerTorsion (unitMap)

private lemma unitMap_bijective_of_torsion
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap (I.map (algebraMap R S)) (algebraMap R S) Ideal.le_comap_map))
    (M : Type w) [AddCommGroup M] [Module R M]
    (hM : IsIPowerTorsion R M I) :
    Function.Bijective (unitMap R S M) := by
  let e : ULift.{max u v} M ≃ₗ[R] M := ULift.moduleEquiv
  have hT : IsIPowerTorsion R (ULift.{max u v} M) I := by
    intro m
    obtain ⟨n, hn, hm⟩ := hM (e m)
    exact ⟨n, hn, fun a ha ↦ e.injective (by simpa using hm a ha)⟩
  have h := (IPowerTorsion.baseChange_bijective_iff_quotientMap_bijective
    R S I hflat).2 hq (ULift.{max u v} M) hT
  constructor
  · intro x y hxy
    apply e.symm.injective
    apply h.1
    apply (e.rTensor S).injective
    simpa [unitMap] using hxy
  · intro z
    obtain ⟨x, hx⟩ := h.2 ((e.rTensor S).symm z)
    refine ⟨e x, ?_⟩
    show (e.rTensor S) (unitMap R S (ULift.{max u v} M) x) = z
    rw [hx, LinearEquiv.apply_symm_apply]

private lemma exists_pow_annihilator_of_generators
    {R : Type u} [CommRing R] {ι : Type*} [Finite ι] (f : ι → R)
    {M : Type w} [AddCommGroup M] [Module R M] (m : M)
    (hm : ∀ i, ∃ n : ℕ, f i ^ n • m = 0) :
    ∃ n : ℕ, 0 < n ∧ ∀ a ∈ (Ideal.span (Set.range f)) ^ n, a • m = 0 := by
  let J : Ideal R := LinearMap.ker (LinearMap.toSpanSingleton R M m)
  have hle : Ideal.span (Set.range f) ≤ J.radical := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    obtain ⟨n, hn⟩ := hm i
    exact Ideal.mem_radical_iff.mpr ⟨n, hn⟩
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hle
    (Submodule.fg_span (Set.finite_range f))
  exact ⟨n + 1, by omega, fun a ha ↦ hn (Ideal.pow_le_pow_right (by omega : n ≤ n + 1) ha)⟩

private lemma unitMap_eq_zero_of_torsion
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap (I.map (algebraMap R S)) (algebraMap R S) Ideal.le_comap_map))
    {M : Type w} [AddCommGroup M] [Module R M] (m : M)
    (hm : ∃ n : ℕ, 0 < n ∧ ∀ a ∈ I ^ n, a • m = 0)
    (hz : unitMap R S M m = 0) : m = 0 := by
  let := hflat
  let N : Submodule R M := R ∙ m
  have hN : IsIPowerTorsion R N I := by
    intro x
    obtain ⟨n, hn, hm⟩ := hm
    refine ⟨n, hn, fun a ha ↦ ?_⟩
    obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp x.property
    apply Subtype.ext
    show a • x.val = 0
    rw [← hb, smul_comm, hm a ha, smul_zero]
  have hinj := (unitMap_bijective_of_torsion I hflat hq N hN).1
  have hx : unitMap R S N ⟨m, Submodule.mem_span_singleton_self m⟩ = 0 := by
    apply Module.Flat.rTensor_preserves_injective_linearMap N.subtype N.injective_subtype
    simpa [unitMap] using hz
  exact congrArg Subtype.val (hinj (hx.trans (map_zero _).symm))

private lemma exists_lift_of_torsion_class
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap (I.map (algebraMap R S)) (algebraMap R S) Ideal.le_comap_map))
    {M : Type w} {N : Type w'} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (φ : M →ₗ[R] N)
    (hker : IsIPowerTorsion R (LinearMap.ker φ) I)
    (x : N) (hx : ∃ n : ℕ, 0 < n ∧ ∀ a ∈ I ^ n,
      a • (LinearMap.range φ).mkQ x = 0)
    (y : M ⊗[R] S) (hy : φ.rTensor S y = unitMap R S N x) :
    ∃ m : M, φ m = x ∧ unitMap R S M m = y := by
  let := hflat
  let q := (LinearMap.range φ).mkQ
  have hqφ : q.comp φ = 0 := by
    ext m
    exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨m, rfl⟩
  have hqx : unitMap R S (N ⧸ LinearMap.range φ) (q x) = 0 := by
    calc
      _ = q.rTensor S (unitMap R S N x) := by simp [unitMap]
      _ = q.rTensor S (φ.rTensor S y) := by rw [hy]
      _ = 0 := by
        rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp, hqφ]
        simp
  have hx0 := unitMap_eq_zero_of_torsion I hflat hq (q x) hx hqx
  obtain ⟨m, hm⟩ := (Submodule.Quotient.mk_eq_zero _).mp hx0
  have hd : φ.rTensor S (y - unitMap R S M m) = 0 := by
    rw [map_sub, hy]
    simp [unitMap, hm]
  obtain ⟨z, hz⟩ := (Module.Flat.rTensor_exact S φ.exact_subtype_ker_map)
    (y - unitMap R S M m) |>.mp hd
  obtain ⟨k, hk⟩ := (unitMap_bijective_of_torsion I hflat hq
    (LinearMap.ker φ) hker).2 z
  refine ⟨m + k.val, ?_, ?_⟩
  · rw [map_add, hm, k.property, add_zero]
  · have hzk : unitMap R S M k.val = y - unitMap R S M m := by
      simpa [← hk, unitMap] using hz
    rw [map_add, hzk]
    abel

private noncomputable def localizationTensorEquiv
    {R : Type u} [CommRing R] (T : Submonoid R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] :
    (LocalizedModule T M) ⊗[R] N ≃ₗ[R] LocalizedModule T (M ⊗[R] N) :=
  IsLocalizedModule.linearEquiv T
    (TensorProduct.AlgebraTensorModule.rTensor R N (LocalizedModule.mkLinearMap T M))
    (LocalizedModule.mkLinearMap T (M ⊗[R] N))

private lemma localizationTensorEquiv_mk_tmul
    {R : Type u} [CommRing R] (T : Submonoid R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] (m : M) (n : N) :
    localizationTensorEquiv T M N ((LocalizedModule.mkLinearMap T M m) ⊗ₜ n) =
      LocalizedModule.mkLinearMap T (M ⊗[R] N) (m ⊗ₜ n) :=
  IsLocalizedModule.linearEquiv_apply T _ _ (m ⊗ₜ n)

private lemma localizationTensorEquiv_unit
    {R : Type u} [CommRing R] (T : Submonoid R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (S : Type v) [CommRing S] [Algebra R S] (x : LocalizedModule T M) :
    localizationTensorEquiv T M S (x ⊗ₜ (1 : S)) =
      LocalizedModule.map T (unitMap R S M) x := by
  have h : (localizationTensorEquiv T M S).toLinearMap.comp
      (unitMap R S (LocalizedModule T M)) =
      (LocalizedModule.map T (unitMap R S M)).restrictScalars R := by
    apply IsLocalizedModule.linearMap_ext T (LocalizedModule.mkLinearMap T M)
      (LocalizedModule.mkLinearMap T (M ⊗[R] S))
    ext m
    simpa [unitMap] using localizationTensorEquiv_mk_tmul T M S m 1
  exact LinearMap.congr_fun h x

private noncomputable def glueingTermTensorEquiv
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] (p : ℕ) :
    GlueingTerm f M p ⊗[R] N ≃ₗ[R] GlueingTerm f (M ⊗[R] N) p :=
  (TensorProduct.piLeft R N (fun s : {s : Finset (Fin r) // s.card = p} ↦
      cechMod f M s.val)).trans
    (LinearEquiv.piCongrRight fun s ↦ localizationTensorEquiv (cechSub f s.val) M N)

private lemma glueingTermTensorEquiv_diagonal
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (N : Type v) [AddCommGroup N] [Module R N] (z : M ⊗[R] N) :
    glueingTermTensorEquiv f M N 1 ((localizationDiagonal f M).rTensor N z) =
      localizationDiagonal f (M ⊗[R] N) z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul m n =>
    funext s
    simpa [glueingTermTensorEquiv, localizationDiagonal] using
      localizationTensorEquiv_mk_tmul (cechSub f s.val) M N m n
  | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy

private lemma glueingTermTensorEquiv_unit
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M]
    (S : Type v) [CommRing S] [Algebra R S] (x : GlueingTerm f M 1) :
    glueingTermTensorEquiv f M S 1 (unitMap R S _ x) = localizationTensorMap S f M 1 x := by
  funext s
  simp [glueingTermTensorEquiv, unitMap, localizationTensorMap,
    localizationTensorEquiv_unit]

public abbrev singletonIndex {r : ℕ} (i : Fin r) :
    {s : Finset (Fin r) // s.card = 1} := ⟨{i}, Finset.card_singleton i⟩

public lemma restricted_component_congr
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M] {p : ℕ}
    (x : GlueingTerm f M p) {s t : {s : Finset (Fin r) // s.card = p}}
    (hst : s = t) {T : Finset (Fin r)} (hs : s.val ⊆ T) (ht : t.val ⊆ T) :
    cechι f M hs (x s) = cechι f M ht (x t) := by
  subst t
  rfl

/-- On the two-element index set `{i, j}` with `i < j`, the Čech differential of a degree-one
term is the difference of the restrictions of its `j`-th and `i`-th components. -/
public theorem glueingDifferential_apply_pair
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M] (x : GlueingTerm f M 1)
    {i j : Fin r} (hij : i < j) :
    glueingDifferential f M 1 x ⟨{i, j}, by simp [ne_of_lt hij]⟩ =
      cechι f M (show ({j} : Finset (Fin r)) ⊆ {i, j} by simp) (x (singletonIndex j)) -
        cechι f M (show ({i} : Finset (Fin r)) ⊆ {i, j} by simp) (x (singletonIndex i)) := by
  let T : {s : Finset (Fin r) // s.card = 2} := ⟨{i, j}, by simp [ne_of_lt hij]⟩
  let a : T.val := ⟨i, by simp [T]⟩
  let b : T.val := ⟨j, by simp [T]⟩
  have hab : a ≠ b := by intro h; exact (ne_of_lt hij) (congrArg Subtype.val h)
  have hT : T.val.attach = {a, b} := by
    ext k
    simp only [Finset.mem_attach, Finset.mem_insert, Finset.mem_singleton, true_iff]
    rcases k with ⟨k, hk⟩
    rcases (show k = i ∨ k = j by simpa [T] using hk) with h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Subtype.ext h)
  have hi : {k ∈ T.val | k < i} = ∅ := by
    ext k
    simp [T]
    omega
  have hj : {k ∈ T.val | k < j} = {i} := by
    ext k
    simp [T]
    omega
  show glueingDifferential f M 1 x T = _
  simp only [glueingDifferential, LinearMap.pi_apply, LinearMap.sum_apply]
  rw [hT, Finset.sum_pair hab]
  have hea : eraseIndex 1 T a = singletonIndex j := by
    apply Subtype.ext
    simp [eraseIndex, T, a, ne_of_lt hij]
  have heb : eraseIndex 1 T b = singletonIndex i := by
    apply Subtype.ext
    simp [eraseIndex, T, b, Finset.pair_comm i j, (ne_of_lt hij).symm]
  have hsa : cechSign T.val a.val = 1 := by simp [cechSign, a, hi]
  have hsb : cechSign T.val b.val = -1 := by simp [cechSign, b, hj]
  simp only [hsa, hsb, one_smul, neg_smul, LinearMap.neg_apply]
  have hc : ∀ (k : T.val) (l : Fin r) (hk : eraseIndex 1 T k = singletonIndex l)
      (hl : ({l} : Finset (Fin r)) ⊆ T.val),
      (cechι f M (Finset.erase_subset k.val T.val)).comp
        (LinearMap.proj (eraseIndex 1 T k)) x = cechι f M hl (x (singletonIndex l)) :=
    fun k l hk hl ↦ restricted_component_congr f x hk (Finset.erase_subset _ _) hl
  rw [hc a j hea (by dsimp [T]; simp), hc b i heb (by dsimp [T]; simp)]
  exact (sub_eq_add_neg _ _).symm

/-- A degree-one term of the glueing complex is a cocycle exactly when any two of its components
agree after restriction to the overlap. -/
public theorem glueingDifferential_eq_zero_iff
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M] (x : GlueingTerm f M 1) :
    glueingDifferential f M 1 x = 0 ↔
      ∀ i j : Fin r,
        cechι f M (show ({i} : Finset (Fin r)) ⊆ {i, j} by simp) (x (singletonIndex i)) =
          cechι f M (show ({j} : Finset (Fin r)) ⊆ {i, j} by simp) (x (singletonIndex j)) := by
  constructor
  · intro hx i j
    have key : ∀ a b : Fin r, a < b →
        cechι f M (show ({a} : Finset (Fin r)) ⊆ {a, b} by simp) (x (singletonIndex a)) =
          cechι f M (show ({b} : Finset (Fin r)) ⊆ {a, b} by simp) (x (singletonIndex b)) := by
      intro a b hab
      have h := congrFun hx ⟨{a, b}, by simp [ne_of_lt hab]⟩
      rw [glueingDifferential_apply_pair f x hab] at h
      exact (sub_eq_zero.mp h).symm
    rcases lt_trichotomy i j with h | rfl | h
    · exact key i j h
    · rfl
    · have h' : ∀ (hi : ({i} : Finset (Fin r)) ⊆ {j, i})
          (hj : ({j} : Finset (Fin r)) ⊆ {j, i}),
          cechι f M hi (x (singletonIndex i)) = cechι f M hj (x (singletonIndex j)) :=
        fun _ _ ↦ (key j i h).symm
      rw [Finset.pair_comm j i] at h'
      exact h' _ _
  · intro hx
    funext T
    obtain ⟨T, hT⟩ := T
    obtain ⟨i, j, hij, heq⟩ := Finset.card_eq_two.mp hT
    rcases lt_or_gt_of_ne hij with hij | hij
    · subst T
      rw [glueingDifferential_apply_pair f x hij]
      exact sub_eq_zero.mpr (hx i j).symm
    · rw [Finset.pair_comm i j] at heq
      subst T
      rw [glueingDifferential_apply_pair f x hij]
      exact sub_eq_zero.mpr (hx j i).symm

private lemma cocycle_pair
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M]
    (x : GlueingTerm f M 1) (hx : glueingDifferential f M 1 x = 0) (i j : Fin r) :
    cechι f M (by simp : ({i} : Finset (Fin r)) ⊆ {i, j}) (x (singletonIndex i)) =
      cechι f M (by simp : ({j} : Finset (Fin r)) ⊆ {i, j}) (x (singletonIndex j)) :=
  (glueingDifferential_eq_zero_iff f x).mp hx i j

private lemma exists_pow_smul_eq_zero_of_localization_map
    {R : Type u} [CommRing R] {M : Type w} [AddCommGroup M] [Module R M]
    {N P : Type*} [AddCommGroup N] [Module R N] [AddCommGroup P] [Module R P]
    (a b : R) (g : M →ₗ[R] N) [IsLocalizedModule.Away b g]
    (ρ : N →ₗ[R] P) [IsLocalizedModule.Away (a * b) (ρ.comp g)]
    (z : N) (hz : ρ z = 0) : ∃ n : ℕ, a ^ n • z = 0 := by
  obtain ⟨e, m, hm⟩ := IsLocalizedModule.Away.surj g b z
  have hm0 : (ρ.comp g) m = (ρ.comp g) 0 := by
    simp only [LinearMap.comp_apply, ← hm, map_smul, hz, smul_zero, map_zero]
  obtain ⟨n, hn⟩ := IsLocalizedModule.Away.exists_of_eq (a * b) hm0
  refine ⟨n, ?_⟩
  apply IsLocalizedModule.smul_injective (S := Submonoid.powers b) g
    ⟨b ^ (n + e), n + e, rfl⟩
  show b ^ (n + e) • (a ^ n • z) = b ^ (n + e) • (0 : N)
  rw [smul_zero, smul_smul,
    show b ^ (n + e) * a ^ n = (a * b) ^ n * b ^ e by ring,
    ← smul_smul, hm, ← map_smul, hn, smul_zero, map_zero]

private lemma exists_pow_smul_eq_zero_of_cechι
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M] (i j : Fin r)
    (z : cechMod f M {j})
    (hz : cechι f M (by simp : ({j} : Finset (Fin r)) ⊆ {i, j}) z = 0) :
    ∃ n : ℕ, f i ^ n • z = 0 := by
  by_cases hij : i = j
  · subst i
    have hz' : z = 0 := by
      have h' : ∀ h : ({j} : Finset (Fin r)) ⊆ {j, j}, cechι f M h z = 0 := fun _ ↦ hz
      rw [Finset.insert_eq_of_mem (Finset.mem_singleton_self j)] at h'
      simpa only [cechι_rfl, LinearMap.id_apply] using h' (le_refl _)
    exact ⟨0, by simp [hz']⟩
  let g := LocalizedModule.mkLinearMap (cechSub f {j}) M
  let ρ := cechι f M (by simp : ({j} : Finset (Fin r)) ⊆ {i, j})
  have : IsLocalizedModule.Away (f j) g := by
    dsimp [g, IsLocalizedModule.Away, cechSub]
    simpa only [cechSub, Finset.prod_singleton] using
      (inferInstance : IsLocalizedModule (cechSub f {j})
        (LocalizedModule.mkLinearMap (cechSub f {j}) M))
  have : IsLocalizedModule.Away (f i * f j) (ρ.comp g) := by
    dsimp [ρ, g]
    rw [cechι_comp_mk]
    simpa only [cechSub, Finset.prod_pair hij] using
      (inferInstance : IsLocalizedModule (cechSub f {i, j})
        (LocalizedModule.mkLinearMap (cechSub f {i, j}) M))
  exact exists_pow_smul_eq_zero_of_localization_map (f i) (f j) g ρ z hz

private lemma ker_localizationDiagonal_torsion
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (M : Type w) [AddCommGroup M] [Module R M] :
    IsIPowerTorsion R (LinearMap.ker (localizationDiagonal f M))
      (Ideal.span (Set.range f)) := by
  intro m
  obtain ⟨n, hn, hm⟩ := exists_pow_annihilator_of_generators f m.val (fun i ↦ by
    have h := congrFun m.property (singletonIndex i)
    change LocalizedModule.mkLinearMap (cechSub f {i}) M m.val = 0 at h
    have hh := IsLocalizedModule.Away.exists_of_eq
      (∏ k ∈ ({i} : Finset (Fin r)), f k) (h.trans (map_zero _).symm)
    simpa only [Finset.prod_singleton, smul_zero] using hh)
  exact ⟨n, hn, fun a ha ↦ Subtype.ext (hm a ha)⟩

private lemma exists_pow_smul_sub_diagonal_eq_zero
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M]
    (x : GlueingTerm f M 1) (hx : glueingDifferential f M 1 x = 0) (i : Fin r) :
    ∃ n : ℕ, ∃ m : M, f i ^ n • x = localizationDiagonal f M m := by
  obtain ⟨e, m, hm⟩ := IsLocalizedModule.Away.surj
    (LocalizedModule.mkLinearMap (cechSub f {i}) M)
    (∏ k ∈ ({i} : Finset (Fin r)), f k) (x (singletonIndex i))
  simp only [Finset.prod_singleton] at hm
  let z := f i ^ e • x - localizationDiagonal f M m
  have hz (j : Fin r) : ∃ n : ℕ, f i ^ n • z (singletonIndex j) = 0 := by
    apply exists_pow_smul_eq_zero_of_cechι f i j
    dsimp [z, localizationDiagonal]
    rw [map_sub, map_smul, cechι_mk, ← cocycle_pair f x hx i j, ← map_smul, hm,
      cechι_mk, sub_self]
  have hmono (j : Fin r) (n : ℕ) (hn : f i ^ n • z (singletonIndex j) = 0) :
      f i ^ (n + 1) • z (singletonIndex j) = 0 := by
    rw [pow_succ', mul_smul, hn, smul_zero]
  have hevent : ∀ j, ∀ᶠ n in Filter.atTop, f i ^ n • z (singletonIndex j) = 0 := by
    intro j
    obtain ⟨n, hn⟩ := hz j
    exact Filter.eventually_atTop.mpr
      ⟨n, fun k hk ↦ Nat.le_induction hn (fun l _ hl ↦ hmono j l hl) k hk⟩
  obtain ⟨n, hn⟩ := Filter.eventually_atTop.mp (Filter.eventually_all.mpr hevent)
  have hz0 : f i ^ n • z = 0 := by
    funext s
    obtain ⟨j, hj⟩ := Finset.card_eq_one.mp s.property
    have hs : s = singletonIndex j := Subtype.ext hj
    subst s
    exact hn n le_rfl j
  refine ⟨n + e, f i ^ n • m, ?_⟩
  apply sub_eq_zero.mp
  simpa [z, smul_sub, smul_smul, ← pow_add] using hz0

private lemma cocycle_class_torsion
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    {M : Type w} [AddCommGroup M] [Module R M]
    (x : GlueingTerm f M 1) (hx : glueingDifferential f M 1 x = 0) :
    ∃ n : ℕ, 0 < n ∧ ∀ a ∈ (Ideal.span (Set.range f)) ^ n,
      a • (LinearMap.range (localizationDiagonal f M)).mkQ x = 0 := by
  apply exists_pow_annihilator_of_generators
  intro i
  obtain ⟨n, m, hm⟩ := exists_pow_smul_sub_diagonal_eq_zero f x hx i
  refine ⟨n, ?_⟩
  rw [← map_smul]
  exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨m, hm.symm⟩

/-- If `R → S` is flat and induces an isomorphism modulo the ideal generated by `f`, then the
glueing complex of every `R`-module is exact, including at its initial term. -/
@[stacks 05EK]
public theorem glueingComplex_exact
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (M : Type w) [AddCommGroup M] [Module R M]
    (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap
        ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map)) :
    Function.Injective (glueingAlpha S f M) ∧
      Function.Exact (glueingAlpha S f M) (glueingBeta S f M) := by
  let I := Ideal.span (Set.range f)
  have hker := ker_localizationDiagonal_torsion f M
  constructor
  · refine (injective_iff_map_eq_zero _).mpr fun m hm ↦ ?_
    obtain ⟨n, hn, hnm⟩ := hker ⟨m, congrArg Prod.snd hm⟩
    exact unitMap_eq_zero_of_torsion I hflat hq m
      ⟨n, hn, fun a ha ↦ congrArg Subtype.val (hnm a ha)⟩ (congrArg Prod.fst hm)
  · apply LinearMap.exact_of_comp_of_mem_range
      (glueingBeta_comp_glueingAlpha S f M)
    rintro ⟨y, x⟩ hxy
    have hcompat : localizationDiagonal f (M ⊗[R] S) y =
        localizationTensorMap S f M 1 x := sub_eq_zero.mp (congrArg Prod.fst hxy)
    have hcycle : glueingDifferential f M 1 x = 0 := neg_eq_zero.mp (congrArg Prod.snd hxy)
    have ht : (localizationDiagonal f M).rTensor S y = unitMap R S _ x := by
      apply (glueingTermTensorEquiv f M S 1).injective
      rw [glueingTermTensorEquiv_diagonal, glueingTermTensorEquiv_unit, hcompat]
    obtain ⟨m, hm, hmy⟩ := exists_lift_of_torsion_class I hflat hq
      (localizationDiagonal f M) hker x (cocycle_class_torsion f x hcycle) y ht
    exact ⟨m, Prod.ext hmy hm⟩

end FormalGlueing


