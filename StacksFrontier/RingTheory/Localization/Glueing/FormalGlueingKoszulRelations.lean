module

public import Mathlib.Algebra.Category.ModuleCat.Ext.HasExt
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExactSequences
public import Mathlib.Algebra.Homology.DerivedCategory.Ext.Linear
public import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.LinearAlgebra.LeftExact
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Ideal.RelationsOfSequence

/-!
# Ext and the first relations of generators of an ideal

Let `R` be a commutative ring, let `f = (f₁, …, f_n)` be a finite family in `R`, let
`I = (f₁, …, f_n)` be the ideal it generates, and let `K` be the kernel occurring in the
presentation `0 → K → M → I → 0` of `I` by the first Koszul relations (see
`StacksFrontier.RingTheory.Ideal.RelationsOfSequence`). For an `R`-module `N`, the *first relation
homology* of `f` with coefficients in `N` is the quotient of the module of tuples `(xᵢ)` with
`fᵢxⱼ = fⱼxᵢ` by the tuples of the form `(fᵢx)`. This file constructs it, places it in a
canonical exact sequence starting at `Ext¹_R(R/I, N)` and ending in `Hom_R(K, N)`, and shows
that it is annihilated by `I`.

## Main definitions

* `FormalGlueing.firstRelationCycles`: tuples satisfying the pairwise first-relation equations.
* `FormalGlueing.firstRelationBoundaries`: the map sending `x` to the tuple `(fᵢx)ᵢ`.
* `FormalGlueing.firstRelationHomology`: the quotient of first-relation cycles by these
  boundaries.
* `FormalGlueing.firstRelationHomologyToKernelHom`: the canonical map to `Hom_R(K, N)`.
* `FormalGlueing.idealHomToExtOne`: the connecting map from maps out of the generated ideal.

## Main results

* `FormalGlueing.extOne_exact_firstRelationHomology_to_kernelHom`: the canonical exact sequence
  `0 → Ext¹_R(R/(f), N) → H₁(N, f) → Hom_R(K, N)`.
* `FormalGlueing.idealI_le_annihilator_firstRelationHomology`: the ideal generated by `f`
  annihilates the first relation homology of `f`.

## Implementation notes

The module `H₁(N, f)` is represented by the literal tuple quotient in the source. A cycle defines
a map from the module presented by the first Koszul relations, and restriction to its kernel
descends through the boundary quotient. Exactness of the displayed sequence means that its first
map is injective and that its range is the kernel of the second map; no surjectivity onto
`Hom_R(K, N)` is asserted by the source. The first map is uniquely characterized by compatibility
with the connecting map for `0 → (f) → R → R/(f) → 0`. The three terms of this short exact
sequence are `R`-modules and all its arrows are `R`-linear. The quotient `R/(f)` and `N` used to
compute `Ext¹` are lifted into a common universe, allowing the coefficient module and ring to live
in arbitrary, possibly different, universes. Annihilation is expressed as containment in
`Module.annihilator`.

## References

* [Stacks Project, Tag 05ED](https://stacks.math.columbia.edu/tag/05ED)
* [Stacks Project, Tag 05EE](https://stacks.math.columbia.edu/tag/05EE)
* [Stacks Project, Tag 05EF](https://stacks.math.columbia.edu/tag/05EF)
-/

/-! ### Ext and the first relations of generators of an ideal -/

section

@[expose] public section

namespace FormalGlueing

universe u v

variable {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R)

/-- The tuples `(xᵢ)ᵢ` satisfying `fᵢxⱼ = fⱼxᵢ` for every pair of indices. -/
public def firstRelationCycles (N : Type v) [AddCommGroup N] [Module R N] :
    Submodule R (Fin n → N) where
  carrier := {x | ∀ i j, f i • x j = f j • x i}
  zero_mem' := by simp
  add_mem' hx hy i j := by
    simpa [smul_add] using congrArg₂ (· + ·) (hx i j) (hy i j)
  smul_mem' r x hx i j := by
    simpa [smul_smul, mul_comm r] using congrArg (r • ·) (hx i j)

/-- Membership in `firstRelationCycles` is the family of pairwise relation equations. -/
@[simp]
public theorem mem_firstRelationCycles {N : Type v} [AddCommGroup N] [Module R N]
    (x : Fin n → N) :
    x ∈ firstRelationCycles f N ↔ ∀ i j, f i • x j = f j • x i :=
  Iff.rfl

/-- The boundary map `x ↦ (fᵢx)ᵢ` into the module of first-relation cycles. -/
public noncomputable def firstRelationBoundaries
    (N : Type v) [AddCommGroup N] [Module R N] :
    N →ₗ[R] firstRelationCycles f N where
  toFun x := ⟨fun i ↦ f i • x, by intro i j; simp [smul_smul, mul_comm]⟩
  map_add' x y := by ext i; simp [smul_add]
  map_smul' r x := by ext i; simp [smul_smul, mul_comm]

/-- The first relation homology
`{(xᵢ) | fᵢxⱼ = fⱼxᵢ} / {(fᵢx) | x ∈ N}`. -/
public abbrev firstRelationHomology
    (N : Type v) [AddCommGroup N] [Module R N] :=
  firstRelationCycles f N ⧸ LinearMap.range (firstRelationBoundaries f N)

/-- A map from the ideal generated by `f` gives the cycle obtained by evaluating it on the
generators. -/
public noncomputable def idealHomToFirstRelationCycles
    (N : Type v) [AddCommGroup N] [Module R N] :
    (Stacks.RelationsOfSequence.idealI f →ₗ[R] N) →ₗ[R] firstRelationCycles f N where
  toFun g := ⟨fun i ↦ g ⟨f i, Submodule.subset_span ⟨i, rfl⟩⟩, by
    intro i j
    rw [← map_smul, ← map_smul]
    congr 1
    ext
    exact mul_comm _ _⟩
  map_add' g h := by ext i; simp
  map_smul' r g := by ext i; simp

/-- The canonical map from maps out of `(f)` to first-relation homology. -/
public noncomputable def idealHomToFirstRelationHomology
    (N : Type v) [AddCommGroup N] [Module R N] :
    (Stacks.RelationsOfSequence.idealI f →ₗ[R] N) →ₗ[R] firstRelationHomology f N :=
  (LinearMap.range (firstRelationBoundaries f N)).mkQ.comp
    (idealHomToFirstRelationCycles f N)

/-- Transport along the universe-lifting equivalences identifies maps from the generated ideal
with morphisms between common-universe models of the ideal and coefficient module. -/
public noncomputable def idealHomToLiftedIdealHom
    (N : Type v) [AddCommGroup N] [Module R N] :
    (Stacks.RelationsOfSequence.idealI f →ₗ[R] N) →ₗ[R]
      (ModuleCat.of R (ULift.{max u v} (Stacks.RelationsOfSequence.idealI f)) ⟶
        ModuleCat.of R (ULift.{max u v} N)) :=
  (ModuleCat.homLinearEquiv (R := R) (S := R)).symm.toLinearMap.comp
    ((LinearEquiv.congrLeft N R
      (ULift.moduleEquiv (R := R) (M := Stacks.RelationsOfSequence.idealI f))).symm.trans
      (LinearEquiv.congrRight (ULift.moduleEquiv (R := R) (M := N)).symm)).toLinearMap

/-- The canonical connecting map
`Hom_R((f), N) → Ext¹_R(R/(f), N)` from the quotient short exact sequence. -/
public noncomputable def idealHomToExtOne
    (N : Type v) [AddCommGroup N] [Module R N] :
    (Stacks.RelationsOfSequence.idealI f →ₗ[R] N) →ₗ[R]
      CategoryTheory.Abelian.Ext
        (ModuleCat.of R (ULift.{max u v} (R ⧸ Stacks.RelationsOfSequence.idealI f)))
        (ModuleCat.of R (ULift.{max u v} N)) 1 :=
  let exact := LinearMap.exact_subtype_mkQ (Stacks.RelationsOfSequence.idealI f)
  let hS := ModuleCat.shortComplexOfConj_shortExact
    (ULift.moduleEquiv (R := R) (M := Stacks.RelationsOfSequence.idealI f))
    (ULift.moduleEquiv (R := R) (M := R))
    (ULift.moduleEquiv (R := R) (M := R ⧸ Stacks.RelationsOfSequence.idealI f)) _ _ exact
    (Stacks.RelationsOfSequence.idealI f).subtype_injective (Stacks.RelationsOfSequence.idealI
      f).mkQ_surjective
  (hS.extClass.precompOfLinear R (ModuleCat.of R (ULift.{max u v} N)) rfl).comp
    (CategoryTheory.Abelian.Ext.linearEquiv₀.symm.toLinearMap.comp
      (idealHomToLiftedIdealHom f N))

/-- A first-relation cycle defines a linear map from the module presented by the corresponding
first Koszul relations. -/
public noncomputable def cycleToPresentedModuleHom
    (N : Type v) [AddCommGroup N] [Module R N] :
    firstRelationCycles f N →ₗ[R] (Stacks.RelationsOfSequence.relQuotient f →ₗ[R] N) where
  toFun x := (Stacks.RelationsOfSequence.relSubmodule f).liftQ
    (Fintype.linearCombination R (x : Fin n → N)) (by
      rw [Stacks.RelationsOfSequence.relSubmodule, Submodule.span_le]
      rintro y ⟨i, j, rfl⟩
      change Fintype.linearCombination R (x : Fin n → N)
        (f i • Stacks.RelationsOfSequence.e j - f j • Stacks.RelationsOfSequence.e i) = 0
      rw [map_sub, map_smul, map_smul]
      change f i • Fintype.linearCombination R (x : Fin n → N) (Pi.single j 1) -
        f j • Fintype.linearCombination R (x : Fin n → N) (Pi.single i 1) = 0
      rw [Fintype.linearCombination_apply_single, Fintype.linearCombination_apply_single,
        one_smul, one_smul, sub_eq_zero]
      exact x.property i j)
  map_add' x y := by
    apply LinearMap.ext
    intro q
    obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective (Stacks.RelationsOfSequence.relSubmodule f) q
    simp [Submodule.liftQ_apply, Fintype.linearCombination_apply, smul_add,
      Finset.sum_add_distrib]
  map_smul' r x := by
    apply LinearMap.ext
    intro q
    obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective (Stacks.RelationsOfSequence.relSubmodule f) q
    simp [Submodule.liftQ_apply, Fintype.linearCombination_apply, smul_smul,
      Finset.smul_sum, mul_comm]

/-- Restriction of the map associated to a cycle to the kernel `K` from Stacks 05ED. -/
public noncomputable def firstRelationCyclesToKernelHom
    (N : Type v) [AddCommGroup N] [Module R N] :
    firstRelationCycles f N →ₗ[R] (Stacks.RelationsOfSequence.K f →ₗ[R] N) where
  toFun x := (cycleToPresentedModuleHom f N x).comp (Stacks.RelationsOfSequence.K f).subtype
  map_add' x y := by ext k; simp
  map_smul' r x := by ext k; simp

/-- Boundaries restrict to zero on `K`: the range of `firstRelationBoundaries f N` lies in the
kernel of `firstRelationCyclesToKernelHom f N`. -/
public theorem range_firstRelationBoundaries_le_ker_cyclesToKernelHom
    (N : Type v) [AddCommGroup N] [Module R N] :
    LinearMap.range (firstRelationBoundaries f N) ≤
      LinearMap.ker (firstRelationCyclesToKernelHom f N) := by
  rintro g ⟨x, rfl⟩
  ext k
  have h : cycleToPresentedModuleHom f N (firstRelationBoundaries f N x) k.1 =
      Stacks.RelationsOfSequence.phi f k.1 • x := by
    obtain ⟨a, ha⟩ := Submodule.mkQ_surjective (Stacks.RelationsOfSequence.relSubmodule f) k.1
    rw [← ha]
    simp [cycleToPresentedModuleHom, firstRelationBoundaries, Stacks.RelationsOfSequence.phi,
      Stacks.RelationsOfSequence.baseMap, Submodule.liftQ_apply, Fintype.linearCombination_apply,
      Finset.sum_smul, smul_smul]
  change cycleToPresentedModuleHom f N (firstRelationBoundaries f N x) k.1 = 0
  rw [h, k.property, zero_smul]

/-- The canonical map `H₁(N, f) → Hom_R(K, N)` obtained by restricting a cycle to `K`. -/
public noncomputable def firstRelationHomologyToKernelHom
    (N : Type v) [AddCommGroup N] [Module R N] :
    firstRelationHomology f N →ₗ[R] (Stacks.RelationsOfSequence.K f →ₗ[R] N) :=
  (LinearMap.range (firstRelationBoundaries f N)).liftQ
    (firstRelationCyclesToKernelHom f N)
    (range_firstRelationBoundaries_le_ker_cyclesToKernelHom f N)

end FormalGlueing
end

end

section

@[expose] public section

namespace FormalGlueing

open CategoryTheory

universe u v

variable {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R)

private noncomputable abbrev idealProjection : Stacks.RelationsOfSequence.relQuotient f →ₗ[R]
  Stacks.RelationsOfSequence.idealI f :=
  (Stacks.RelationsOfSequence.phi f).codRestrict ((Stacks.RelationsOfSequence.idealI
    f).restrictScalars R) (by
    intro x
    rw [← Stacks.RelationsOfSequence.range_phi f]
    exact LinearMap.mem_range_self _ x)

private lemma idealProjection_apply (x : Stacks.RelationsOfSequence.relQuotient f) :
    (idealProjection f x : R) = Stacks.RelationsOfSequence.phi f x := rfl

private lemma idealProjection_surjective : Function.Surjective (idealProjection f) := by
  intro x
  have hx : (x : R) ∈ LinearMap.range (Stacks.RelationsOfSequence.phi f) := by
    rw [Stacks.RelationsOfSequence.range_phi f]
    exact x.property
  obtain ⟨y, hy⟩ := hx
  exact ⟨y, Subtype.ext hy⟩

private lemma idealProjection_ker :
    LinearMap.ker (idealProjection f) = Stacks.RelationsOfSequence.K f := by
  ext x
  change idealProjection f x = 0 ↔ Stacks.RelationsOfSequence.phi f x = 0
  exact ⟨congrArg Subtype.val, fun h ↦ Subtype.ext h⟩

private lemma cycleToPresentedModuleHom_injective {N : Type v}
    [AddCommGroup N] [Module R N] :
    Function.Injective (cycleToPresentedModuleHom f N) := by
  intro x y h
  apply Subtype.ext
  funext i
  have hi := LinearMap.congr_fun h (Submodule.Quotient.mk (Stacks.RelationsOfSequence.e i))
  simpa [cycleToPresentedModuleHom, Stacks.RelationsOfSequence.e] using hi

private lemma cycleToPresentedModuleHom_idealHom {N : Type v}
    [AddCommGroup N] [Module R N] (g : Stacks.RelationsOfSequence.idealI f →ₗ[R] N) :
    cycleToPresentedModuleHom f N (idealHomToFirstRelationCycles f N g) =
      g.comp (idealProjection f) := by
  apply LinearMap.ext
  intro q
  obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective (Stacks.RelationsOfSequence.relSubmodule f) q
  change Fintype.linearCombination R
      (fun i ↦ g ⟨f i, Submodule.subset_span ⟨i, rfl⟩⟩) a =
    g (idealProjection f (Submodule.Quotient.mk a))
  rw [Fintype.linearCombination_apply]
  have ha : idealProjection f (Submodule.Quotient.mk a) =
      ∑ i, a i • (⟨f i, Submodule.subset_span ⟨i, rfl⟩⟩ : Stacks.RelationsOfSequence.idealI f) := by
    apply Subtype.ext
    rw [idealProjection_apply]
    simp [Stacks.RelationsOfSequence.phi, Stacks.RelationsOfSequence.baseMap,
      Fintype.linearCombination_apply]
  rw [ha, map_sum]
  simp

private lemma firstRelationCyclesToKernelHom_exact {N : Type v}
    [AddCommGroup N] [Module R N] :
    Function.Exact (idealHomToFirstRelationCycles f N)
      (firstRelationCyclesToKernelHom f N) := by
  let p := idealProjection f
  have hp : Function.Surjective p := idealProjection_surjective f
  have he : Function.Exact (Stacks.RelationsOfSequence.K f).subtype p := by
    rw [← idealProjection_ker f]
    exact LinearMap.exact_subtype_ker_map p
  have hh := LinearMap.exact_lcomp_of_exact_of_surjective N he hp
  rw [LinearMap.exact_iff] at hh ⊢
  ext x
  constructor
  · intro hx
    have hmap : (cycleToPresentedModuleHom f N x) ∈
        LinearMap.ker (LinearMap.lcomp R N (Stacks.RelationsOfSequence.K f).subtype) :=
      hx
    rw [hh] at hmap
    obtain ⟨g, hg⟩ := hmap
    refine ⟨g, (cycleToPresentedModuleHom_injective f) ?_⟩
    calc
      cycleToPresentedModuleHom f N (idealHomToFirstRelationCycles f N g) =
          g.comp (idealProjection f) := cycleToPresentedModuleHom_idealHom f g
      _ = cycleToPresentedModuleHom f N x := hg
  · rintro ⟨g, rfl⟩
    change firstRelationCyclesToKernelHom f N (idealHomToFirstRelationCycles f N g) = 0
    apply LinearMap.ext
    intro k
    change cycleToPresentedModuleHom f N (idealHomToFirstRelationCycles f N g) k.1 = 0
    rw [cycleToPresentedModuleHom_idealHom]
    have hk : idealProjection f k.1 = 0 := Subtype.ext k.property
    simp [hk]

private lemma idealHomToLiftedIdealHom_surjective {N : Type v}
    [AddCommGroup N] [Module R N] :
    Function.Surjective (idealHomToLiftedIdealHom f N) := by
  intro g
  refine ⟨(ULift.moduleEquiv (R := R) (M := N)).toLinearMap.comp
    (g.hom.comp (ULift.moduleEquiv (R := R) (M := Stacks.RelationsOfSequence.idealI
      f)).symm.toLinearMap), ?_⟩
  apply ModuleCat.hom_ext
  ext x
  rfl

/-- The short exact sequence `0 → (f) → R → R/(f) → 0`, transported to a common universe. -/
private theorem liftedIdealShortExact :
    (ModuleCat.shortComplexOfConj
      (ULift.moduleEquiv : ULift.{max u v} (Stacks.RelationsOfSequence.idealI f) ≃ₗ[R]
        Stacks.RelationsOfSequence.idealI f)
      (ULift.moduleEquiv : ULift.{v} R ≃ₗ[R] R)
      (ULift.moduleEquiv : ULift.{max u v} (R ⧸ Stacks.RelationsOfSequence.idealI f) ≃ₗ[R]
        R ⧸ Stacks.RelationsOfSequence.idealI f) _ _
      (LinearMap.exact_subtype_mkQ (Stacks.RelationsOfSequence.idealI f)).linearMap_comp_eq_zero
      ).ShortExact :=
  ModuleCat.shortComplexOfConj_shortExact _ _ _ _ _
    (LinearMap.exact_subtype_mkQ (Stacks.RelationsOfSequence.idealI f))
    (Stacks.RelationsOfSequence.idealI f).subtype_injective (Stacks.RelationsOfSequence.idealI
      f).mkQ_surjective

private lemma idealHomToExtOne_surjective {N : Type v}
    [AddCommGroup N] [Module R N] :
    Function.Surjective (idealHomToExtOne f N) := by
  let hS := liftedIdealShortExact.{u, v} f
  intro x
  obtain ⟨a, ha⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS
    (ModuleCat.of R (ULift.{max u v} N)) x
    (CategoryTheory.Abelian.Ext.eq_zero_of_projective _) (rfl : 1 + 0 = 1)
  obtain ⟨a, rfl⟩ := (CategoryTheory.Abelian.Ext.linearEquiv₀ (R := R)).symm.surjective a
  obtain ⟨g, rfl⟩ := idealHomToLiftedIdealHom_surjective f a
  exact ⟨g, ha⟩

private lemma idealHomToExtOne_eq_zero_iff {N : Type v}
    [AddCommGroup N] [Module R N] (g : Stacks.RelationsOfSequence.idealI f →ₗ[R] N) :
    idealHomToExtOne f N g = 0 ↔
      ∃ h : R →ₗ[R] N, h.comp (Stacks.RelationsOfSequence.idealI f).subtype = g := by
  let hS := liftedIdealShortExact.{u, v} f
  change hS.extClass.comp
    (CategoryTheory.Abelian.Ext.mk₀ (idealHomToLiftedIdealHom f N g)) rfl = 0 ↔ _
  constructor
  · intro hg
    obtain ⟨a, ha⟩ := CategoryTheory.Abelian.Ext.contravariant_sequence_exact₁ hS
      (ModuleCat.of R (ULift.{max u v} N)) _ rfl hg
    obtain ⟨a, rfl⟩ := (CategoryTheory.Abelian.Ext.linearEquiv₀ (R := R)).symm.surjective a
    simp only [CategoryTheory.Abelian.Ext.linearEquiv₀_symm_apply,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀] at ha
    have ha := (CategoryTheory.Abelian.Ext.linearEquiv₀ (R := R)).symm.injective ha
    refine ⟨(ULift.moduleEquiv (R := R) (M := N)).toLinearMap.comp
      (a.hom.comp (ULift.moduleEquiv (R := R) (M := R)).symm.toLinearMap), ?_⟩
    ext x
    exact congrArg ULift.down (congrArg (fun k ↦ k.hom (ULift.up x)) ha)
  · rintro ⟨h, rfl⟩
    let a : ModuleCat.of R (ULift.{v} R) ⟶ ModuleCat.of R (ULift.{max u v} N) :=
      ModuleCat.ofHom ((ULift.moduleEquiv (R := R) (M := N)).symm.toLinearMap.comp
        (h.comp (ULift.moduleEquiv (R := R) (M := R)).toLinearMap))
    have ha : idealHomToLiftedIdealHom f N (h.comp (Stacks.RelationsOfSequence.idealI f).subtype) =
        (ModuleCat.shortComplexOfConj
          (ULift.moduleEquiv (R := R) (M := Stacks.RelationsOfSequence.idealI f))
          (ULift.moduleEquiv (R := R) (M := R))
          (ULift.moduleEquiv (R := R) (M := R ⧸ Stacks.RelationsOfSequence.idealI f)) _ _
          (LinearMap.exact_subtype_mkQ (Stacks.RelationsOfSequence.idealI
            f)).linearMap_comp_eq_zero).f ≫ a := by
      apply ModuleCat.hom_ext
      ext x
      rfl
    rw [ha, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    exact hS.extClass_comp_assoc _

private lemma idealHomToFirstRelationCycles_injective {N : Type v}
    [AddCommGroup N] [Module R N] :
    Function.Injective (idealHomToFirstRelationCycles f N) := by
  intro g h hgh
  have he : g.comp (idealProjection f) = h.comp (idealProjection f) := by
    rw [← cycleToPresentedModuleHom_idealHom, ← cycleToPresentedModuleHom_idealHom, hgh]
  ext x
  obtain ⟨y, rfl⟩ := idealProjection_surjective f x
  exact LinearMap.congr_fun he y

private lemma idealHomToFirstRelationHomology_eq_zero_iff {N : Type v}
    [AddCommGroup N] [Module R N] (g : Stacks.RelationsOfSequence.idealI f →ₗ[R] N) :
    idealHomToFirstRelationHomology f N g = 0 ↔
      ∃ h : R →ₗ[R] N, h.comp (Stacks.RelationsOfSequence.idealI f).subtype = g := by
  change Submodule.Quotient.mk (idealHomToFirstRelationCycles f N g) = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  constructor
  · rintro ⟨x, hx⟩
    refine ⟨LinearMap.toSpanSingleton R N x, idealHomToFirstRelationCycles_injective f ?_⟩
    exact (show idealHomToFirstRelationCycles f N
      ((LinearMap.toSpanSingleton R N x).comp (Stacks.RelationsOfSequence.idealI f).subtype) =
      firstRelationBoundaries f N x from rfl).trans hx
  · rintro ⟨h, rfl⟩
    refine ⟨h 1, ?_⟩
    apply Subtype.ext
    funext i
    change f i • h 1 = h (f i)
    rw [← map_smul, smul_eq_mul, mul_one]

private lemma firstRelationHomologyToKernelHom_exact {N : Type v}
    [AddCommGroup N] [Module R N] :
    Function.Exact (idealHomToFirstRelationHomology f N)
      (firstRelationHomologyToKernelHom f N) := by
  rw [LinearMap.exact_iff, firstRelationHomologyToKernelHom, Submodule.ker_liftQ,
    (LinearMap.exact_iff.mp (firstRelationCyclesToKernelHom_exact f))]
  exact (LinearMap.range_comp _ _).symm

/-- There is a canonical exact sequence
`0 → Ext¹_R(R / (f), N) → H₁(N, f) → Hom_R(K, N)`, where `K` is the kernel from
Stacks 05ED. -/
@[stacks 05EE]
public theorem extOne_exact_firstRelationHomology_to_kernelHom
    (N : Type v) [AddCommGroup N] [Module R N] :
    ∃ i : CategoryTheory.Abelian.Ext
        (ModuleCat.of R (ULift.{max u v} (R ⧸ Stacks.RelationsOfSequence.idealI f)))
        (ModuleCat.of R (ULift.{max u v} N)) 1 →ₗ[R] firstRelationHomology f N,
      (∀ g : Stacks.RelationsOfSequence.idealI f →ₗ[R] N,
          i (idealHomToExtOne f N g) = idealHomToFirstRelationHomology f N g) ∧
        Function.Injective i ∧ Function.Exact i (firstRelationHomologyToKernelHom f N) ∧
        ∀ j : CategoryTheory.Abelian.Ext
            (ModuleCat.of R (ULift.{max u v} (R ⧸ Stacks.RelationsOfSequence.idealI f)))
            (ModuleCat.of R (ULift.{max u v} N)) 1 →ₗ[R] firstRelationHomology f N,
          (∀ g : Stacks.RelationsOfSequence.idealI f →ₗ[R] N,
            j (idealHomToExtOne f N g) = idealHomToFirstRelationHomology f N g) → j = i := by
  let p := idealHomToExtOne f N
  let q := idealHomToFirstRelationHomology f N
  have hp : Function.Surjective p := idealHomToExtOne_surjective f
  have hk : LinearMap.ker p = LinearMap.ker q := by
    ext g
    exact (idealHomToExtOne_eq_zero_iff f g).trans
      (idealHomToFirstRelationHomology_eq_zero_iff f g).symm
  let e := p.quotKerEquivOfSurjective hp
  let l := (LinearMap.ker p).liftQ q hk.le
  let i := l.comp e.symm.toLinearMap
  have hi (g : Stacks.RelationsOfSequence.idealI f →ₗ[R] N) : i (p g) = q g := by
    simp [i, l, e]
  refine ⟨i, hi, ?_, ?_, ?_⟩
  · exact (LinearMap.ker_eq_bot.mp
      (Submodule.ker_liftQ_eq_bot (LinearMap.ker p) q hk.le hk.ge)).comp e.symm.injective
  · intro x
    rw [firstRelationHomologyToKernelHom_exact f x]
    constructor
    · rintro ⟨g, rfl⟩
      exact ⟨p g, hi g⟩
    · rintro ⟨y, hy⟩
      obtain ⟨g, rfl⟩ := hp y
      exact ⟨g, (hi g).symm.trans hy⟩
  · intro j hj
    ext x
    obtain ⟨g, rfl⟩ := hp x
    exact (hj g).trans (hi g).symm

end FormalGlueing

end

end

/-! ### Annihilation of first relation homology -/

section

@[expose] public section

namespace FormalGlueing

universe u v

/-- The ideal generated by a finite family annihilates its first relation
homology with coefficients in any module. -/
@[stacks 05EF]
public theorem idealI_le_annihilator_firstRelationHomology
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R)
    (N : Type v) [AddCommGroup N] [Module R N] :
    Stacks.RelationsOfSequence.idealI f ≤ Module.annihilator R (FormalGlueing.firstRelationHomology
      f N) := by
  intro a ha
  rw [Stacks.RelationsOfSequence.idealI, Ideal.span] at ha
  refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
  · rintro a ⟨i, rfl⟩
    rw [Module.mem_annihilator]
    intro q
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective
      (LinearMap.range (FormalGlueing.firstRelationBoundaries f N)) q
    rw [← map_smul]
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    refine ⟨(x : Fin n → N) i, ?_⟩
    ext j
    exact (x.property i j).symm
  · rw [Module.mem_annihilator]
    simp
  · intro a b _ _ ha hb
    rw [Module.mem_annihilator] at ha hb ⊢
    intro q
    rw [add_smul, ha q, hb q, add_zero]
  · intro a b _ hb
    rw [Module.mem_annihilator] at hb ⊢
    intro q
    rw [smul_eq_mul, mul_smul, hb q, smul_zero]

end FormalGlueing

end

