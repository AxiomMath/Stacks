module

public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.RingTheory.Ideal.Basic
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.Tactic.LinearCombination

/-!
# The exact sequence of localizations attached to a sum of two elements

Let `R` be a commutative ring and let `f, g, h ∈ R` with `f + g = h`. In `R_h` the elements `f`
and `g` generate the unit ideal, because their sum becomes invertible there; consequently
`Spec R_h` is covered by the two basic opens of `f` and of `g`, and the Zariski sheaf condition
for that two-element cover is the exact sequence

  `0 → R_h → R_{hf} × R_{hg} → R_{hfg} → 0`

of `R`-modules. This file proves the three statements that sequence consists of, for *arbitrary*
localizations: the four rings are only required to be `R`-algebras localizing `R` away from `h`,
`hf`, `hg` and `hfg` respectively, and the four comparison maps are only required to be
`R`-algebra homomorphisms — which pins them down, a localization having at most one `R`-algebra
map to a given `R`-algebra.

## Main results

* `AwaySum.exists_mul_pow_add_mul_pow`: the single piece of divisibility that drives everything,
  namely that `h ^ (2 * m + 1)` lies in the ideal generated by `f ^ m` and `g ^ m`. This is the
  form in which "`f` and `g` generate the unit ideal in `R_h`" is used; no localization is needed
  to state it.
* `AwaySum.eq_zero_of_eq_zero`: **exactness on the left**, that is, injectivity of
  `R_h → R_{hf} × R_{hg}`.
* `AwaySum.exists_eq_of_eq`: **exactness in the middle**, that is, a pair of sections agreeing
  over `R_{hfg}` comes from a section over `R_h`.
* `AwaySum.exists_sub_eq`: **exactness on the right**, that is, surjectivity of the difference
  map `R_{hf} × R_{hg} → R_{hfg}`. This is the "easy fact that the last arrow is surjective"
  which [Stacks, Tag 0998] adds to Algebra, Lemma [Stacks, Tag 00EJ] to obtain its short exact
  sequence.

## Implementation notes

The statements take the comparison maps as `AlgHom`s rather than constructing them, so that a
consumer which already has maps — for instance the sectionwise maps of a presheaf of localizations
of the structure sheaf of a ringed site — can use them directly, with no identification to prove.

Nothing here is a localization of a localization: all four rings are localizations of `R`, so the
double-localization identification `R_{hf} = (R_h)_f` is never needed. What replaces it is
`AwaySum.exists_mul_pow_add_mul_pow`, whose exponent `2 * m + 1` on `h` is exactly the price of
not passing to `R_h` first. The sum is carried as a hypothesis `f + g = h` on a third element
rather than by writing `f + g` everywhere, because a consumer's `h` is typically not syntactically
a sum, and because `h` is then an atom for `ring`.

[Stacks, Tag 00EJ] itself, for an arbitrary finite family generating the unit ideal, is
`alphaLin_injective` and `ker_betaLin_eq_range_alphaLin` of `Functions.lean`; it is stated there
for the concrete `Localization.Away` of each member of the family and says nothing at the
right-hand end of the sequence, so it does not subsume the three statements here.

## References

* [Stacks Project, Tag 0998](https://stacks.math.columbia.edu/tag/0998)
* [Stacks Project, Tag 00EJ](https://stacks.math.columbia.edu/tag/00EJ)
-/

@[expose] public section

namespace AwaySum

variable {R : Type*} [CommRing R]

/-- **A power of `h = f + g` lies in the ideal generated by `f ^ m` and `g ^ m`.** Expanding
`(f + g) ^ (2 * m + 1)` by the binomial theorem, every monomial `f ^ i * g ^ (2 * m + 1 - i)` has
`i ≥ m` or `2 * m + 1 - i ≥ m`, so is divisible by `f ^ m` or by `g ^ m`.

This is the elementary content of "`f` and `g` generate the unit ideal in `R_h`", stated without
any localization: the exponent on `h` is harmless because `h` is inverted in all four rings of
the sequence below. -/
theorem exists_mul_pow_add_mul_pow {f g h : R} (hsum : f + g = h) (m : ℕ) :
    ∃ a b : R, a * f ^ m + b * g ^ m = h ^ (2 * m + 1) := by
  subst hsum
  refine Ideal.mem_span_pair.1 ?_
  have hle : Ideal.span ((fun i => (![f, g] : Fin 2 → R) i ^ (m + 1)) ''
      ↑(Finset.univ : Finset (Fin 2))) ≤ Ideal.span ({f ^ m, g ^ m} : Set R) := by
    rw [Ideal.span_le]
    rintro x ⟨i, -, rfl⟩
    fin_cases i
    · exact Ideal.mem_span_pair.2 ⟨f, 0, show f * f ^ m + 0 * g ^ m = f ^ (m + 1) by ring⟩
    · exact Ideal.mem_span_pair.2 ⟨0, g, show 0 * f ^ m + g * g ^ m = g ^ (m + 1) by ring⟩
  refine hle ?_
  have hsum : ∑ i : Fin 2, (![f, g] : Fin 2 → R) i = f + g := by simp
  have hcard : (Finset.univ : Finset (Fin 2)).card * m + 1 = 2 * m + 1 := by simp
  have hmem := Ideal.sum_pow_mem_span_pow (Finset.univ : Finset (Fin 2)) (![f, g] : Fin 2 → R) m
  rwa [hsum, hcard] at hmem

section Cancel

variable {S : Type*} [CommRing S] [Algebra R S]

/-- Division by the image of an element of `R` that becomes a unit: for every `r : R` there is an
element of the algebra whose product with the image of `c` is the image of `r`. -/
theorem exists_mul_algebraMap_eq {c : R} (hc : IsUnit (algebraMap R S c)) (r : R) :
    ∃ x : S, x * algebraMap R S c = algebraMap R S r := by
  obtain ⟨w, hw⟩ := hc.exists_right_inv
  exact ⟨algebraMap R S r * w, by rw [mul_assoc, mul_comm w, hw, mul_one]⟩

/-- Enlarging the denominator: if `x` is `r` divided by `c`, then it is `r * d` divided by
`c * d`. -/
theorem mul_algebraMap_mul_eq {x : S} {c r : R}
    (hx : x * algebraMap R S c = algebraMap R S r) (d : R) :
    x * algebraMap R S (c * d) = algebraMap R S (r * d) := by
  rw [map_mul, ← mul_assoc, hx, ← map_mul]

end Cancel

/-- An `R`-algebra map carries "`x` is `r` divided by `c`" to the same statement in the target. -/
theorem mul_algebraMap_eq_of_algHom {A B : Type*} [CommRing A] [CommRing B] [Algebra R A]
    [Algebra R B] (φ : A →ₐ[R] B) {x : A} {c r : R}
    (hx : x * algebraMap R A c = algebraMap R A r) :
    φ x * algebraMap R B c = algebraMap R B r := by
  have e := congrArg φ hx
  rwa [map_mul, AlgHom.commutes, AlgHom.commutes] at e

variable {Rh Rf Rg Rfg : Type*}
  [CommRing Rh] [CommRing Rf] [CommRing Rg] [CommRing Rfg]
  [Algebra R Rh] [Algebra R Rf] [Algebra R Rg] [Algebra R Rfg]

section Units

/-- In `R_{hf}` the image of `h ^ p * f ^ q` is a unit when `q ≤ p`, that element dividing
`(h * f) ^ p`. -/
theorem isUnit_algebraMap_left (h f : R) [IsLocalization.Away (h * f) Rf] (p q : ℕ)
    (hq : q ≤ p) : IsUnit (algebraMap R Rf (h ^ p * f ^ q)) := by
  rw [IsLocalization.Away.algebraMap_isUnit_iff (h * f)]
  refine ⟨p, f ^ (p - q), ?_⟩
  rw [mul_pow, mul_assoc, ← pow_add, Nat.add_sub_cancel' hq]

/-- In `R_{hg}` the image of `h ^ p * g ^ q` is a unit when `q ≤ p`. -/
theorem isUnit_algebraMap_right (h g : R) [IsLocalization.Away (h * g) Rg] (p q : ℕ)
    (hq : q ≤ p) : IsUnit (algebraMap R Rg (h ^ p * g ^ q)) := by
  exact isUnit_algebraMap_left (Rf := Rg) h g p q hq

/-- In `R_h` the image of `h ^ p` is a unit. -/
theorem isUnit_algebraMap_pow (h : R) [IsLocalization.Away h Rh] (p : ℕ) :
    IsUnit (algebraMap R Rh (h ^ p)) := by
  rw [map_pow]
  exact IsLocalization.Away.algebraMap_pow_isUnit _ _

/-- In `R_{hfg}` the image of `h ^ p * f ^ q * g ^ s` is a unit when `q ≤ p` and `s ≤ p`. -/
theorem isUnit_algebraMap_both (h f g : R) [IsLocalization.Away (h * f * g) Rfg] (p q s : ℕ)
    (hq : q ≤ p) (hs : s ≤ p) : IsUnit (algebraMap R Rfg (h ^ p * f ^ q * g ^ s)) := by
  rw [IsLocalization.Away.algebraMap_isUnit_iff (h * f * g)]
  refine ⟨p, f ^ (p - q) * g ^ (p - s), ?_⟩
  calc (h * f * g) ^ p = h ^ p * f ^ (q + (p - q)) * g ^ (s + (p - s)) := by
        rw [Nat.add_sub_cancel' hq, Nat.add_sub_cancel' hs, mul_pow, mul_pow]
    _ = h ^ p * f ^ q * g ^ s * (f ^ (p - q) * g ^ (p - s)) := by
        rw [pow_add, pow_add]
        ring

end Units

variable {f g h : R}

/-- **Exactness on the left of the sequence `0 → R_h → R_{hf} × R_{hg} → R_{hfg} → 0`.** An
element of `R_h` killed by both comparison maps is zero.

Write the element as `r / h ^ n`. Its vanishing in `R_{hf}` and in `R_{hg}` makes `r` killed by a
power of `h * f` and by a power of `h * g`, hence — by
`AwaySum.exists_mul_pow_add_mul_pow` — by a power of `h` alone, which is invertible in `R_h`. -/
theorem eq_zero_of_eq_zero [IsLocalization.Away h Rh] [IsLocalization.Away (h * f) Rf]
    [IsLocalization.Away (h * g) Rg] (hsum : f + g = h)
    (p : Rh →ₐ[R] Rf) (q : Rh →ₐ[R] Rg) {x : Rh} (hp : p x = 0) (hq : q x = 0) : x = 0 := by
  obtain ⟨n, r, hr⟩ := IsLocalization.Away.surj h x
  rw [← map_pow] at hr
  have hf0 : algebraMap R Rf r = algebraMap R Rf 0 := by
    simpa [hp] using (mul_algebraMap_eq_of_algHom p hr).symm
  have hg0 : algebraMap R Rg r = algebraMap R Rg 0 := by
    simpa [hq] using (mul_algebraMap_eq_of_algHom q hr).symm
  obtain ⟨k, hk⟩ := IsLocalization.Away.exists_of_eq (h * f) hf0
  obtain ⟨l, hl⟩ := IsLocalization.Away.exists_of_eq (h * g) hg0
  rw [mul_zero, mul_pow] at hk hl
  obtain ⟨a, b, hab⟩ := exists_mul_pow_add_mul_pow hsum (k + l)
  -- Hence `r` is killed by a power of `h`, at a common exponent reached by multiplying rather than
  -- by subtracting.
  have hpow : h ^ (3 * (k + l) + 1) * r = 0 := by
    linear_combination (-(h ^ (k + l) * r)) * hab + (a * h ^ l * f ^ l) * hk +
      (b * h ^ k * g ^ k) * hl
  have hr0 : algebraMap R Rh r = 0 := by
    refine (isUnit_algebraMap_pow (Rh := Rh) h (3 * (k + l) + 1)).mul_left_cancel ?_
    rw [mul_zero, ← map_mul, hpow, map_zero]
  refine (isUnit_algebraMap_pow (Rh := Rh) h n).mul_right_cancel ?_
  rw [zero_mul, hr, hr0]

/-- **Exactness on the right of the sequence `0 → R_h → R_{hf} × R_{hg} → R_{hfg} → 0`.** Every
element of `R_{hfg}` is a difference of an element coming from `R_{hf}` and one coming from
`R_{hg}`.

This is the "easy fact that the last arrow is surjective" of [Stacks, Tag 0998]. Write the element
as `r / (hfg) ^ n` and `h ^ (2n+1) = a f ^ n + b g ^ n`; then `r b / (h ^ (3n+1) f ^ n)` lies in
`R_{hf}`, the element `- r a / (h ^ (3n+1) g ^ n)` lies in `R_{hg}`, and the difference of their
images is the given element. -/
theorem exists_sub_eq [IsLocalization.Away (h * f) Rf] [IsLocalization.Away (h * g) Rg]
    [IsLocalization.Away (h * f * g) Rfg] (hsum : f + g = h)
    (u : Rf →ₐ[R] Rfg) (v : Rg →ₐ[R] Rfg) (z : Rfg) :
    ∃ (x : Rf) (y : Rg), u x - v y = z := by
  obtain ⟨n, r, hr⟩ := IsLocalization.Away.surj (h * f * g) z
  rw [← map_pow] at hr
  obtain ⟨a, b, hab⟩ := exists_mul_pow_add_mul_pow hsum n
  have hnle : n ≤ 3 * n + 1 := by omega
  obtain ⟨x, hx⟩ := exists_mul_algebraMap_eq
    (isUnit_algebraMap_left (Rf := Rf) h f (3 * n + 1) n hnle) (r * b)
  obtain ⟨y, hy⟩ := exists_mul_algebraMap_eq
    (isUnit_algebraMap_right (Rg := Rg) h g (3 * n + 1) n hnle) (r * a)
  refine ⟨x, -y, ?_⟩
  rw [map_neg, sub_neg_eq_add]
  refine (isUnit_algebraMap_both (Rfg := Rfg) h f g (3 * n + 1) n n hnle hnle).mul_right_cancel ?_
  have hux := mul_algebraMap_eq_of_algHom u hx
  have hvy := mul_algebraMap_eq_of_algHom v hy
  have habM := congrArg (algebraMap R Rfg) hab
  simp only [map_add, map_mul, map_pow] at hux hvy habM hr ⊢
  linear_combination (algebraMap R Rfg g ^ n) * hux + (algebraMap R Rfg f ^ n) * hvy +
    (algebraMap R Rfg r) * habM - (algebraMap R Rfg h ^ (2 * n + 1)) * hr

/-- If `t` is `W` divided by `h ^ N` and `x` is `P` divided by `(h * d) ^ n`, where `W` and `P`
agree after multiplying by `h ^ (n + k) * d ^ k`, then the image of `t` in `R_{hd}` is `x`. -/
private theorem eq_of_mul_eq {S : Type*} [CommRing S] [Algebra R S] {d : R}
    [IsLocalization.Away (h * d) S] (φ : Rh →ₐ[R] S) {t : Rh} {x : S} {n k : ℕ} {P W : R}
    (ht : t * algebraMap R Rh (h ^ (2 * (n + k) + 1 + n)) = algebraMap R Rh W)
    (hP : x * algebraMap R S ((h * d) ^ n) = algebraMap R S P)
    (hdag : W * d ^ n * (h ^ (n + k) * d ^ k) = P * h ^ (2 * (n + k) + 1) * (h ^ (n + k) * d ^ k)) :
    φ t = x := by
  refine (isUnit_algebraMap_left (Rf := S) h d (2 * (n + k) + 1 + n) n
    (by omega)).mul_right_cancel ?_
  refine (isUnit_algebraMap_left (Rf := S) h d (n + k) k (by omega)).mul_right_cancel ?_
  have hpt := mul_algebraMap_eq_of_algHom φ ht
  have hdagM := congrArg (algebraMap R S) hdag
  simp only [map_mul, map_pow] at hpt hP hdagM ⊢
  linear_combination (algebraMap R S d ^ n * (algebraMap R S h ^ (n + k) *
      algebraMap R S d ^ k)) * hpt -
    (algebraMap R S h ^ (2 * (n + k) + 1) * (algebraMap R S h ^ (n + k) *
      algebraMap R S d ^ k)) * hP + hdagM

/-- **Exactness in the middle of the sequence `0 → R_h → R_{hf} × R_{hg} → R_{hfg} → 0`.** A pair
of elements of `R_{hf}` and `R_{hg}` with the same image in `R_{hfg}` comes from an element of
`R_h`.

This is Algebra, Lemma [Stacks, Tag 00EJ] for the two-element family `f, g` of `R_h`. Write the
two elements as `P / (hf) ^ n` and `Q / (hg) ^ n`; their agreement gives
`(hfg) ^ k * (P (hg) ^ n) = (hfg) ^ k * (Q (hf) ^ n)` in `R`, and with
`h ^ (2m+1) = a f ^ m + b g ^ m` for `m = n + k` the element
`(a f ^ k P + b g ^ k Q) / h ^ (2m+1+n)` of `R_h` restricts to the given pair. -/
theorem exists_eq_of_eq [IsLocalization.Away h Rh] [IsLocalization.Away (h * f) Rf]
    [IsLocalization.Away (h * g) Rg] [IsLocalization.Away (h * f * g) Rfg] (hsum : f + g = h)
    (p : Rh →ₐ[R] Rf) (q : Rh →ₐ[R] Rg) (u : Rf →ₐ[R] Rfg) (v : Rg →ₐ[R] Rfg)
    {x : Rf} {y : Rg} (hxy : u x = v y) : ∃ t : Rh, p t = x ∧ q t = y := by
  obtain ⟨n₁, P₁, hP₁⟩ := IsLocalization.Away.surj (h * f) x
  obtain ⟨n₂, Q₁, hQ₁⟩ := IsLocalization.Away.surj (h * g) y
  rw [← map_pow] at hP₁ hQ₁
  -- Put the two denominators at a common exponent `n`.
  have hP₂ := mul_algebraMap_mul_eq hP₁ ((h * f) ^ n₂)
  have hQ₂ := mul_algebraMap_mul_eq hQ₁ ((h * g) ^ n₁)
  rw [← pow_add] at hP₂ hQ₂
  rw [add_comm n₂ n₁] at hQ₂
  generalize n₁ + n₂ = n at hP₂ hQ₂
  obtain ⟨P, hP⟩ : ∃ P : R, x * algebraMap R Rf ((h * f) ^ n) = algebraMap R Rf P := ⟨_, hP₂⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : R, y * algebraMap R Rg ((h * g) ^ n) = algebraMap R Rg Q := ⟨_, hQ₂⟩
  -- Transport the agreement of `x` and `y` down to `R`.
  have hPf := mul_algebraMap_eq_of_algHom u hP
  have hQg := mul_algebraMap_eq_of_algHom v hQ
  have hagree : algebraMap R Rfg (P * (h * g) ^ n) = algebraMap R Rfg (Q * (h * f) ^ n) := by
    rw [map_mul, map_mul, ← hPf, ← hQg, hxy]
    ring
  obtain ⟨k, hk⟩ := IsLocalization.Away.exists_of_eq (h * f * g) hagree
  obtain ⟨a, b, hab⟩ := exists_mul_pow_add_mul_pow hsum (n + k)
  have hkey : h ^ (n + k) * f ^ k * g ^ k * (g ^ n * P - f ^ n * Q) = 0 := by
    linear_combination hk
  obtain ⟨t, ht⟩ := exists_mul_algebraMap_eq
    (isUnit_algebraMap_pow (Rh := Rh) h (2 * (n + k) + 1 + n)) (a * f ^ k * P + b * g ^ k * Q)
  refine ⟨t, ?_, ?_⟩
  · exact eq_of_mul_eq p ht hP (by linear_combination (h ^ (n + k) * f ^ k * P) * hab - b * hkey)
  · exact eq_of_mul_eq q ht hQ (by linear_combination (h ^ (n + k) * g ^ k * Q) * hab + a * hkey)

end AwaySum

end
