module

public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.Algebra.GroupWithZero.Associated
public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Units of the localization of a domain away from a prime element

Let `R` be a domain, `p ∈ R` a prime element and `S = R[1/p]`. Every unit of `S` is a unit of
`R` times an integer power of `p` (`exists_units_eq_mul_zpow`). If moreover every unit of `R` is
an `n`-th power, the group `S^× / (S^×)^n` is cyclic of order `n`, generated by the class of `p`
(`natCard_quotient_range_nsmul_units_away`).

For `R = k[t]` over an algebraically closed field `k` and `p = t` this says that
`k[t, t⁻¹]^× / n = ℤ/n`, generated by the coordinate: through the Kummer sequence it is the
computation `H¹(𝐆_{m,k}, μ_n) ≅ ℤ/n` of the first étale cohomology of the punctured affine line.

## Main results

* `Stacks.LocalizationAway.exists_units_eq_mul_zpow`.
* `Stacks.LocalizationAway.quotientRangeNsmulUnitsAwayEquiv` and
  `Stacks.LocalizationAway.natCard_quotient_range_nsmul_units_away`.
-/

@[expose] public noncomputable section

namespace Stacks.LocalizationAway

variable {R : Type*} [CommRing R] [IsDomain R] {p : R} (hp : Prime p)
  (S : Type*) [CommRing S] [Algebra R S] [IsLocalization.Away p S]

/-- The image of `p` as a unit of `S = R[1/p]`. -/
def awayUnit : Sˣ := (IsLocalization.Away.algebraMap_isUnit (S := S) p).unit

omit [IsDomain R] in
/-- The unit `awayUnit S` of `S` has underlying element the image of `p` in `S`. -/
@[simp]
theorem coe_awayUnit : (awayUnit (p := p) S : S) = algebraMap R S p := rfl

omit [IsDomain R] in
/-- A decomposition `y = a * p ^ m` of a unit of `R[1/p]`, read in the additive group of units. -/
theorem eq_ofMul_add_zsmul_awayUnit {y : Additive Sˣ} {a : Rˣ} {m : ℤ}
    (h : Additive.toMul y = Units.map (algebraMap R S : R →* S) a * awayUnit (p := p) S ^ m) :
    y = Additive.ofMul (Units.map (algebraMap R S : R →* S) a) +
      m • Additive.ofMul (awayUnit (p := p) S) := by
  apply Additive.toMul.injective
  rw [h, toMul_add, toMul_zsmul, toMul_ofMul, toMul_ofMul]

include hp in
/-- **Every unit of `R[1/p]` is a unit of `R` times an integer power of `p`.** -/
theorem exists_units_eq_mul_zpow (u : Sˣ) :
    ∃ (a : Rˣ) (m : ℤ), u = Units.map (algebraMap R S : R →* S) a * awayUnit (p := p) S ^ m := by
  obtain ⟨⟨f, ⟨_, a, rfl⟩⟩, hf⟩ := IsLocalization.mk'_surjective (Submonoid.powers p) (u : S)
  have hfu : algebraMap R S f = (u : S) * algebraMap R S p ^ a := by
    rw [← hf, ← map_pow, IsLocalization.mk'_spec]
  have hpa : IsUnit (algebraMap R S p ^ a) := (IsLocalization.Away.algebraMap_isUnit p).pow a
  have hunit : IsUnit (algebraMap R S f) := hfu ▸ u.isUnit.mul hpa
  obtain ⟨N, hN⟩ := (IsLocalization.Away.algebraMap_isUnit_iff (x := p)).1 hunit
  obtain ⟨c, -, hc⟩ := (dvd_prime_pow hp N).1 hN
  obtain ⟨w, hw⟩ := hc.symm
  refine ⟨w, (c : ℤ) - a, Units.ext ?_⟩
  have hτ : ((awayUnit (p := p) S ^ ((c : ℤ) - a) : Sˣ) : S) * algebraMap R S p ^ a =
      algebraMap R S p ^ c := by
    rw [← coe_awayUnit (p := p) S, ← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val,
      ← Units.val_mul, ← zpow_natCast, ← zpow_natCast, ← zpow_add, sub_add_cancel]
  apply hpa.mul_left_injective
  change (u : S) * algebraMap R S p ^ a =
    (algebraMap R S (w : R) * ((awayUnit (p := p) S ^ ((c : ℤ) - a) : Sˣ) : S)) *
      algebraMap R S p ^ a
  rw [mul_assoc, hτ, ← hfu, ← hw, map_mul, map_pow, mul_comm]

include hp in
/-- An integer power of `p` is the image of a unit of `R` only for the exponent zero. -/
theorem zpow_eq_zero_of_awayUnit_zpow_eq (a : Rˣ) (m : ℤ)
    (h : awayUnit (p := p) S ^ m = Units.map (algebraMap R S : R →* S) a) : m = 0 := by
  have hinj : Function.Injective (algebraMap R S) :=
    IsLocalization.injective S (powers_le_nonZeroDivisors_of_noZeroDivisors hp.ne_zero)
  have key : ∀ k : ℕ, IsUnit (p ^ k) → k = 0 := fun k hk => by
    by_contra h0
    exact hp.not_isUnit ((isUnit_pow_iff h0).1 hk)
  rcases lt_trichotomy m 0 with hm | hm | hm
  · obtain ⟨k, hk⟩ := Int.exists_eq_neg_ofNat hm.le
    have h' : (1 : Sˣ) = Units.map (algebraMap R S : R →* S) a * awayUnit (p := p) S ^ k := by
      rw [← h, hk, zpow_neg, zpow_natCast, inv_mul_cancel]
    have h'' : algebraMap R S 1 = algebraMap R S ((a : R) * p ^ k) := by
      simpa using congrArg Units.val h'
    have := key k (IsUnit.mul_iff.1 ((hinj h'') ▸ isUnit_one)).2
    omega
  · exact hm
  · obtain ⟨k, hk⟩ := Int.eq_ofNat_of_zero_le hm.le
    have h' : algebraMap R S (p ^ k) = algebraMap R S (a : R) := by
      simpa [hk] using congrArg Units.val h
    have := key k (hinj h' ▸ a.isUnit)
    omega

include hp in
/-- If `n • y = m • p` in the additive group of units of `R[1/p]`, then `n` divides `m`. -/
theorem natCast_dvd_of_nsmul_eq_zsmul_awayUnit {n : ℕ} {m : ℤ} {y : Additive Sˣ}
    (hy : n • y = m • Additive.ofMul (awayUnit (p := p) S)) : (n : ℤ) ∣ m := by
  obtain ⟨a, k, hk⟩ := exists_units_eq_mul_zpow hp S (Additive.toMul y)
  rw [eq_ofMul_add_zsmul_awayUnit S hk] at hy
  have h0 : Additive.ofMul (awayUnit (p := p) S ^ (m - n * k)) =
      Additive.ofMul (Units.map (algebraMap R S : R →* S) (a ^ n)) := by
    rw [ofMul_zpow, sub_smul, ← hy, map_pow, ofMul_pow, smul_add, mul_smul, natCast_zsmul]
    abel
  have := zpow_eq_zero_of_awayUnit_zpow_eq hp S _ _ (Additive.ofMul.injective h0)
  exact ⟨k, by lia⟩

include hp in
/-- **`R[1/p]^× / n ≅ ℤ/n`**, the class of `p` going to `1`, when every unit of `R` is an `n`-th
power. -/
def quotientRangeNsmulUnitsAwayEquiv (n : ℕ) (hroot : ∀ a : Rˣ, ∃ b : Rˣ, b ^ n = a) :
    (Additive Sˣ ⧸ (nsmulAddMonoidHom n : Additive Sˣ →+ Additive Sˣ).range) ≃+ ZMod n := by
  let G := Additive Sˣ
  let H := (nsmulAddMonoidHom n : G →+ G).range
  let φ : ℤ →+ G ⧸ H :=
    (QuotientAddGroup.mk' H).comp (zmultiplesHom G (Additive.ofMul (awayUnit (p := p) S)))
  have hsurj : Function.Surjective φ := by
    intro x
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective H x
    obtain ⟨a, m, hm⟩ := exists_units_eq_mul_zpow hp S (Additive.toMul y)
    obtain ⟨b, rfl⟩ := hroot a
    refine ⟨m, QuotientAddGroup.eq_iff_sub_mem.2
      ⟨-Additive.ofMul (Units.map (algebraMap R S : R →* S) b), ?_⟩⟩
    change n • (-Additive.ofMul (Units.map (algebraMap R S : R →* S) b)) =
      m • Additive.ofMul (awayUnit (p := p) S) - y
    rw [eq_ofMul_add_zsmul_awayUnit S hm, map_pow, ofMul_pow]
    abel
  have hker : φ.ker = AddSubgroup.zmultiples (n : ℤ) := by
    ext m
    simp only [AddMonoidHom.mem_ker, φ, AddMonoidHom.comp_apply, QuotientAddGroup.mk'_apply,
      QuotientAddGroup.eq_zero_iff, zmultiplesHom_apply, AddSubgroup.mem_zmultiples_iff]
    constructor
    · rintro ⟨y, hy⟩
      obtain ⟨k, rfl⟩ := natCast_dvd_of_nsmul_eq_zsmul_awayUnit hp S (n := n) hy
      exact ⟨k, by rw [smul_eq_mul, mul_comm]⟩
    · rintro ⟨k, rfl⟩
      refine ⟨k • Additive.ofMul (awayUnit (p := p) S), ?_⟩
      change n • (k • Additive.ofMul (awayUnit (p := p) S)) = (k • (n : ℤ)) • _
      rw [← natCast_zsmul, smul_smul, smul_eq_mul, mul_comm]
  exact ((QuotientAddGroup.quotientKerEquivOfSurjective φ hsurj).symm.trans
      (QuotientAddGroup.quotientAddEquivOfEq hker)).trans
      (Int.quotientZMultiplesNatEquivZMod n)

include hp in
/-- **`R[1/p]^× / n` is cyclic of order `n`, generated by `p`**, when every unit of `R` is an
`n`-th power. -/
theorem natCard_quotient_range_nsmul_units_away {n : ℕ} (hn : 0 < n)
    (hroot : ∀ a : Rˣ, ∃ b : Rˣ, b ^ n = a) :
    Nat.card (Additive Sˣ ⧸ (nsmulAddMonoidHom n : Additive Sˣ →+ Additive Sˣ).range) = n := by
  have : NeZero n := ⟨hn.ne'⟩
  rw [Nat.card_congr (quotientRangeNsmulUnitsAwayEquiv hp S n hroot).toEquiv, Nat.card_zmod]

end Stacks.LocalizationAway

end
