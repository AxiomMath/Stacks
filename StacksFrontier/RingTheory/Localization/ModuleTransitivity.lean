module

public import Mathlib.Algebra.Module.LocalizedModule.Basic

/-!
# Transitivity of localization of modules

Let `R` be a commutative ring, let `S` and `T` be multiplicative subsets of `R` and let
`f : M → M'` and `g : M' → M''` be `R`-linear maps exhibiting `M'` as the localization of `M`
at `S` and `M''` as the localization of `M'` at `T`. Then `g ∘ f` exhibits `M''` as the
localization of `M` at the submonoid `S ⊔ T` generated by `S` and `T`.

Mathlib has the corresponding statement for rings
(`IsLocalization.localization_localization_isLocalization`) but not for modules; the module
statement is what identifies a localization of a localization of `M` with a single localization
of `M`, which is the step a local-global flatness argument needs.

## Main results

* `IsLocalizedModule.isUnit_algebraMap_end_of_isLocalizedModule`: a scalar acting invertibly on
  a module acts invertibly on every localization of that module.
* `IsLocalizedModule.comp`: transitivity of `IsLocalizedModule`.
* `LocalizedModule.supEquiv`: the `R`-linear equivalence
  `LocalizedModule T (LocalizedModule S M) ≃ₗ[R] LocalizedModule (S ⊔ T) M`.

## Implementation notes

Of the three fields of `IsLocalizedModule` only `map_units` needs an argument: an element of
`S ⊔ T` is a product `s * t` with `s ∈ S` and `t ∈ T` (`Submonoid.mem_sup`), the factor `t` acts
invertibly on `M''` by assumption, and the factor `s` acts invertibly on `M''` because it acts
invertibly on `M'` and `M''` is a localization of `M'`. That last implication is
`IsLocalizedModule.isUnit_algebraMap_end_of_isLocalizedModule`, proved by writing an arbitrary
element of `M''` as a fraction `m'/t` and clearing the denominator; the surjectivity half divides
by `t` only through `Function.Bijective.surjective` and `Function.Bijective.injective` for the
action of `t`, so no inverse endomorphism has to be manipulated.

The other two fields are the evident computations with a common denominator `s * t`.
-/

@[expose] public section

namespace IsLocalizedModule

variable {R : Type*} [CommSemiring R] {M M' M'' : Type*}
  [AddCommGroup M] [AddCommGroup M'] [AddCommGroup M'']
  [Module R M] [Module R M'] [Module R M'']

/-- If `r : R` acts injectively on `M'` and `g : M' → M''` is a localization of `M'` at `T`,
then `r` kills no nonzero element of `M''`. -/
theorem eq_zero_of_smul_eq_zero_of_injective_smul (T : Submonoid R) (g : M' →ₗ[R] M'')
    [IsLocalizedModule T g] {r : R} (hr : Function.Injective fun m : M' => r • m)
    {y : M''} (hy : r • y = 0) : y = 0 := by
  have ht (t : T) : Function.Bijective fun y : M'' => (t : R) • y :=
    (Module.End.isUnit_iff _).mp (IsLocalizedModule.map_units g t)
  obtain ⟨⟨m', t⟩, e⟩ := IsLocalizedModule.surj T g y
  rw [Submonoid.smul_def] at e
  have h1 : g (r • m') = 0 := by rw [map_smul, ← e, smul_comm, hy, smul_zero]
  obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := T) (f := g) (h1.trans (map_zero g).symm)
  rw [Submonoid.smul_def, Submonoid.smul_def, smul_zero, smul_comm] at hc
  have h2 : (c : R) • m' = 0 := by
    simpa using hr (a₁ := (c : R) • m') (a₂ := 0) (by simpa using hc)
  have h3 : (c : R) • ((t : R) • y) = 0 := by rw [e, ← map_smul, h2, map_zero]
  have h4 : (t : R) • y = 0 := by
    simpa using (ht c).injective (a₁ := (t : R) • y) (a₂ := 0) (by simpa using h3)
  simpa using (ht t).injective (a₁ := y) (a₂ := 0) (by simpa using h4)

/-- If `r : R` acts surjectively on `M'` and `g : M' → M''` is a localization of `M'` at `T`,
then `r` acts surjectively on `M''`. -/
theorem surjective_smul_of_surjective_smul (T : Submonoid R) (g : M' →ₗ[R] M'')
    [IsLocalizedModule T g] {r : R} (hr : Function.Surjective fun m : M' => r • m) :
    Function.Surjective fun y : M'' => r • y := by
  have ht (t : T) : Function.Bijective fun y : M'' => (t : R) • y :=
    (Module.End.isUnit_iff _).mp (IsLocalizedModule.map_units g t)
  intro y
  obtain ⟨⟨m', t⟩, e⟩ := IsLocalizedModule.surj T g y
  rw [Submonoid.smul_def] at e
  obtain ⟨n, hn⟩ := hr m'
  replace hn : r • n = m' := hn
  obtain ⟨w, hw⟩ := (ht t).surjective (g n)
  replace hw : (t : R) • w = g n := hw
  refine ⟨w, (ht t).injective ?_⟩
  change (t : R) • (r • w) = (t : R) • y
  rw [smul_comm, hw, ← map_smul, hn, e]

/-- A scalar acting invertibly on a module acts invertibly on every localization of that
module: if `r : R` acts bijectively on `M'` and `g : M' → M''` is a localization of `M'` at a
multiplicative subset `T`, then `r` acts bijectively on `M''`. -/
theorem isUnit_algebraMap_end_of_isLocalizedModule (T : Submonoid R) (g : M' →ₗ[R] M'')
    [IsLocalizedModule T g] {r : R} (hr : IsUnit (algebraMap R (Module.End R M') r)) :
    IsUnit (algebraMap R (Module.End R M'') r) := by
  have hbij : Function.Bijective fun m : M' => r • m := (Module.End.isUnit_iff _).mp hr
  refine (Module.End.isUnit_iff _).mpr
    ⟨fun y₁ y₂ hy => ?_, surjective_smul_of_surjective_smul T g hbij.surjective⟩
  simp only [Module.algebraMap_end_apply] at hy
  exact sub_eq_zero.mp
    (eq_zero_of_smul_eq_zero_of_injective_smul T g hbij.injective (by rw [smul_sub, hy, sub_self]))

/-- **Transitivity of localization of modules.** If `f : M → M'` is the localization of `M` at
`S` and `g : M' → M''` is the localization of `M'` at `T`, then `g ∘ f` is the localization of
`M` at the submonoid `S ⊔ T` generated by `S` and `T`. -/
theorem comp (S T : Submonoid R) (f : M →ₗ[R] M') (g : M' →ₗ[R] M'')
    [IsLocalizedModule S f] [IsLocalizedModule T g] :
    IsLocalizedModule (S ⊔ T) (g ∘ₗ f) where
  map_units x := by
    obtain ⟨s, hs, t, ht, hst⟩ := Submonoid.mem_sup.mp x.2
    rw [← hst, map_mul]
    exact (isUnit_algebraMap_end_of_isLocalizedModule T g
      (IsLocalizedModule.map_units f ⟨s, hs⟩)).mul (IsLocalizedModule.map_units g ⟨t, ht⟩)
  surj y := by
    obtain ⟨⟨m', t⟩, e⟩ := IsLocalizedModule.surj T g y
    obtain ⟨⟨m, s⟩, e'⟩ := IsLocalizedModule.surj S f m'
    rw [Submonoid.smul_def] at e e'
    refine ⟨⟨m, ⟨(s : R) * (t : R), Submonoid.mul_mem _ (Submonoid.mem_sup_left s.2)
      (Submonoid.mem_sup_right t.2)⟩⟩, ?_⟩
    rw [Submonoid.smul_def]
    change ((s : R) * (t : R)) • y = g (f m)
    rw [mul_smul, e, ← map_smul, e']
  exists_of_eq {x₁ x₂} h := by
    obtain ⟨t, ht⟩ := IsLocalizedModule.exists_of_eq (S := T) (f := g) h
    rw [Submonoid.smul_def, Submonoid.smul_def, ← map_smul, ← map_smul] at ht
    obtain ⟨s, hs⟩ := IsLocalizedModule.exists_of_eq (S := S) (f := f) ht
    rw [Submonoid.smul_def, Submonoid.smul_def, smul_comm, smul_comm (s : R)] at hs
    refine ⟨⟨(t : R) * (s : R), Submonoid.mul_mem _ (Submonoid.mem_sup_right t.2)
      (Submonoid.mem_sup_left s.2)⟩, ?_⟩
    rw [Submonoid.smul_def]
    change ((t : R) * (s : R)) • x₁ = ((t : R) * (s : R)) • x₂
    rw [mul_smul, mul_smul, hs]

end IsLocalizedModule

namespace LocalizedModule

variable {R : Type*} [CommSemiring R] {M : Type*} [AddCommGroup M] [Module R M]

/-- A localization of a localization of `M` is a localization of `M`: localizing at `S` and then
at `T` is localizing at the submonoid generated by `S` and `T`. -/
noncomputable def supEquiv (S T : Submonoid R) :
    LocalizedModule T (LocalizedModule S M) ≃ₗ[R] LocalizedModule (S ⊔ T) M :=
  haveI := IsLocalizedModule.comp S T (mkLinearMap S M) (mkLinearMap T (LocalizedModule S M))
  IsLocalizedModule.linearEquiv (S ⊔ T)
    ((mkLinearMap T (LocalizedModule S M)) ∘ₗ (mkLinearMap S M))
    (mkLinearMap (S ⊔ T) M)

end LocalizedModule

end
