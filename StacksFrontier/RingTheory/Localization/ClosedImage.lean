/-!
# Localizations with closed image in the spectrum

Let `R` be a ring and `S ⊆ R` a multiplicative subset, and write `Z ⊆ Spec R` for the image of
`Spec(S⁻¹R) → Spec R`, i.e. the set of primes disjoint from `S`. If `Z` is closed and open, then
`Z = D(e)` for an idempotent `e`, and `S⁻¹R ≅ R_e ≅ R/(1 - e)` is a direct factor of `R`.

The set `Z` is always an intersection `⋂_{s ∈ S} D(s)`. If it is closed and its complement is
quasi-compact — as it is whenever `Spec R` is a Noetherian topological space — then that
complement is cut out by finitely many elements `f₁, …, fₙ`; these vanish on `Z`, so each has a
power killed by an element of `S`, and the product `g ∈ S` of these elements satisfies
`Z = D(g)`. If `S` is generated as a monoid by `g₁, …, gₘ`, then directly `Z = D(g₁ ⋯ gₘ)`. In
either case `Z` is open, so if it is closed then `S⁻¹R` is a direct factor of `R`.

## Main results

* `localization_isClosed_range_comap_isClosed`: if the image is closed, the localization is
  isomorphic to a quotient of `R` (Stacks 02JH).
* `IsLocalization.exists_mem_away_of_fg`: a localization at a finitely generated submonoid
  is a localization away from one element.
* `IsLocalization.exists_range_comap_eq_basicOpen_of_fg`: if `S` is a finitely generated monoid,
  the image is `D(g)` for some `g ∈ S`.
* `IsLocalization.exists_range_comap_eq_basicOpen_of_isClosed_of_isCompact_compl`: a closed
  image with quasi-compact complement is `D(g)` for some `g ∈ S`.
* `IsLocalization.exists_range_comap_eq_basicOpen_of_isClosed`: if `Spec R` is Noetherian and the
  image is closed, it is `D(g)` for some `g ∈ S`.
* `IsLocalization.exists_ringEquiv_prod_of_isClopen_range`: if the image of
  `Spec(S⁻¹R) → Spec R` is closed and open, then `R ≅ S⁻¹R × R'` for some ring `R'`.
* `IsLocalization.exists_ringEquiv_prod_of_isClosed_range`: Stacks 02JI.

## Implementation notes

The localization is any `R`-algebra `A` with `IsLocalization S A`, rather than the particular
model `Localization S`. The proof does not pass through the quotient description `S⁻¹R ≅ R/I`
of the source: once the image is `D(e)` with `e` idempotent, both `A` and `R/(1 - e)` are
localizations of `R` at the submonoid generated by `S` and `e`, hence isomorphic.

## References

* [Stacks Project, Tag 02JH](https://stacks.math.columbia.edu/tag/02JH)
* [Stacks Project, Tag 02JI](https://stacks.math.columbia.edu/tag/02JI)
-/

@[expose] public section

/-- Let `S` be a multiplicative subset of a ring `R`. If the image of
`Spec(S⁻¹R) → Spec(R)` is closed, then `S⁻¹R` is isomorphic to a quotient `R ⧸ I`
for some ideal `I ⊆ R`. -/
@[stacks 02JH]
theorem localization_isClosed_range_comap_isClosed
    (R : Type*) [CommRing R] (S : Submonoid R)
    (hclosed :
      IsClosed (Set.range (PrimeSpectrum.comap (algebraMap R (Localization S))))) :
    ∃ I : Ideal R, Nonempty (Localization S ≃+* (R ⧸ I)) := by
  set ℓ : R →+* Localization S := algebraMap R (Localization S)
  have hrange :
      Set.range (PrimeSpectrum.comap ℓ) = PrimeSpectrum.zeroLocus (RingHom.ker ℓ) := by
    rw [← PrimeSpectrum.closure_range_comap ℓ, hclosed.closure_eq]
  have key : ∀ s ∈ S, ∃ t : R, ℓ s * ℓ t = 1 := by
    intro s hs
    have htop : Ideal.span {s} ⊔ RingHom.ker ℓ = ⊤ := by
      by_contra h
      obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ h
      have hpmem : (⟨M, hM.isPrime⟩ : PrimeSpectrum R) ∈
          PrimeSpectrum.zeroLocus (RingHom.ker ℓ) := fun x hx ↦ hle (Ideal.mem_sup_right hx)
      rw [← hrange, PrimeSpectrum.localization_comap_range (Localization S) S] at hpmem
      exact Set.disjoint_left.mp hpmem hs (hle (Ideal.mem_sup_left (Ideal.subset_span (by simp))))
    rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at htop
    obtain ⟨y, hy, z, hz, hyz⟩ := htop
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hy
    refine ⟨r, ?_⟩
    have : ℓ y + ℓ z = 1 := by rw [← map_add, hyz, map_one]
    rwa [RingHom.mem_ker.mp hz, add_zero, ← hr, map_mul, mul_comm] at this
  have hsurj : Function.Surjective ℓ := by
    intro z
    obtain ⟨⟨a, ⟨s, hs⟩⟩, hzs⟩ := IsLocalization.surj S z
    simp only at hzs
    obtain ⟨t, ht⟩ := key s hs
    refine ⟨a * t, ?_⟩
    have : z * ℓ s = ℓ a := hzs
    rw [map_mul, ← this, mul_assoc, ht, mul_one]
  exact ⟨RingHom.ker ℓ, ⟨(RingHom.quotientKerEquivOfSurjective hsurj).symm⟩⟩

open PrimeSpectrum TopologicalSpace

universe u

/-- A ring splits as the product of its quotients by `1 - e` and by `e`, for `e` idempotent. -/
theorem IsIdempotentElem.nonempty_ringEquiv_quotient_prod {R : Type*} [CommRing R] {e : R}
    (he : IsIdempotentElem e) :
    Nonempty (R ≃+* (R ⧸ Ideal.span {1 - e}) × (R ⧸ Ideal.span {e})) := by
  have hcop : IsCoprime (Ideal.span {1 - e}) (Ideal.span {e}) := by
    rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
    have := Submodule.add_mem_sup (Ideal.subset_span (Set.mem_singleton (1 - e)))
      (Ideal.subset_span (Set.mem_singleton e))
    rwa [sub_add_cancel] at this
  have hinf : Ideal.span {1 - e} ⊓ Ideal.span {e} = (⊥ : Ideal R) := by
    rw [eq_bot_iff]
    rintro x ⟨hx₁, hx₂⟩
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx₁
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hx₂
    have h1 : a * (1 - e) * e = 0 := by
      rw [mul_assoc, sub_mul, one_mul, he.eq, sub_self, mul_zero]
    have h2 : a * (1 - e) * e = a * (1 - e) := by rw [← hb, mul_assoc, he.eq]
    rw [Ideal.mem_bot, ← h2, h1]
  exact ⟨(RingEquiv.quotientBot R).symm.trans <|
    (Ideal.quotEquivOfEq hinf.symm).trans (Ideal.quotientInfEquivQuotientProd _ _ hcop)⟩

/-- If `x` maps to a nonunit in `B`, some prime of `B` pulls back to a prime containing `x`. -/
private theorem exists_prime_comap_mem_of_not_isUnit {R B : Type*} [CommRing R] [CommRing B]
    [Algebra R B] {x : R} (hx : ¬IsUnit (algebraMap R B x)) :
    ∃ q : PrimeSpectrum B, x ∈ (PrimeSpectrum.comap (algebraMap R B) q).asIdeal := by
  obtain ⟨J, hJ, hmem⟩ := exists_max_ideal_of_mem_nonunits hx
  exact ⟨⟨J, hJ.isPrime⟩, hmem⟩

/-- If `S` and `e` map to units in `B`, so does every element of `S ⊔ powers e`. -/
private theorem isUnit_algebraMap_of_mem_sup_powers {R B : Type*} [CommSemiring R]
    [CommSemiring B] [Algebra R B] {S : Submonoid R} {e : R}
    (hS : ∀ s ∈ S, IsUnit (algebraMap R B s)) (he : IsUnit (algebraMap R B e)) :
    ∀ r ∈ S ⊔ Submonoid.powers e, IsUnit (algebraMap R B r) := by
  intro r hr
  obtain ⟨y, hy, z, ⟨n, rfl⟩, rfl⟩ := Submonoid.mem_sup.mp hr
  rw [map_mul, map_pow]
  exact (hS y hy).mul (he.pow n)

namespace IsLocalization

section

variable {R : Type u} [CommSemiring R] (S : Submonoid R) (A : Type*) [CommSemiring A]
  [Algebra R A] [IsLocalization S A]

include S

/-- A localization at a finitely generated submonoid is a localization away from one of
its elements, namely the product of a finite set of generators. -/
theorem exists_mem_away_of_fg (hS : S.FG) : ∃ g ∈ S, IsLocalization.Away g A := by
  classical
  obtain ⟨G, rfl⟩ := Submonoid.isMulFG_iff.mp hS
  refine ⟨∏ x ∈ G, x, Submonoid.prod_mem _ fun x hx ↦ Submonoid.mem_closure_of_mem hx, ?_⟩
  have hdvd : ∀ s ∈ Submonoid.closure (G : Set R),
      ∃ m ∈ Submonoid.powers (∏ x ∈ G, x), s ∣ m := by
    intro s hs
    induction hs using Submonoid.closure_induction with
    | mem x hx => exact ⟨_, Submonoid.mem_powers _, Finset.dvd_prod_of_mem _ hx⟩
    | one => exact ⟨1, Submonoid.one_mem _, one_dvd _⟩
    | mul x y _ _ hx hy =>
      obtain ⟨m, hm, hxm⟩ := hx
      obtain ⟨n, hn, hyn⟩ := hy
      exact ⟨m * n, Submonoid.mul_mem _ hm hn, mul_dvd_mul hxm hyn⟩
  have hle : Submonoid.powers (∏ x ∈ G, x) ≤ Submonoid.closure (G : Set R) :=
    Submonoid.powers_le.mpr (Submonoid.prod_mem _ fun x hx ↦ Submonoid.mem_closure_of_mem hx)
  have : IsLocalization (Submonoid.closure (G : Set R)) (Localization.Away (∏ x ∈ G, x)) :=
    IsLocalization.of_le_of_exists_dvd _ _ hle hdvd
  exact IsLocalization.isLocalization_of_algEquiv _
    (IsLocalization.algEquiv (Submonoid.closure (G : Set R)) (Localization.Away (∏ x ∈ G, x)) A)

/-- If `S` is finitely generated as a monoid, then the image of `Spec(S⁻¹R) → Spec R` is
`D(g)` for some `g ∈ S`, namely the product of a finite set of generators. -/
theorem exists_range_comap_eq_basicOpen_of_fg (hS : S.FG) :
    ∃ g ∈ S, Set.range (comap (algebraMap R A)) = (basicOpen g : Set (PrimeSpectrum R)) := by
  obtain ⟨g, hg, _⟩ := exists_mem_away_of_fg S A hS
  exact ⟨g, hg, localization_away_comap_range A g⟩

/-- If the image of `Spec(S⁻¹R) → Spec R` is closed and its complement is quasi-compact,
then it is `D(g)` for some `g ∈ S`. -/
theorem exists_range_comap_eq_basicOpen_of_isClosed_of_isCompact_compl
    (hclosed : IsClosed (Set.range (comap (algebraMap R A))))
    (hcpt : IsCompact (Set.range (comap (algebraMap R A)))ᶜ) :
    ∃ g ∈ S, Set.range (comap (algebraMap R A)) = (basicOpen g : Set (PrimeSpectrum R)) := by
  obtain ⟨t, ht⟩ := isCompact_isOpen_iff.mp ⟨hcpt, hclosed.isOpen_compl⟩
  rw [compl_inj_iff] at ht
  have key : ∀ f ∈ t, ∃ s, s ∈ S ∧ ∃ n : ℕ, s * f ^ n = 0 := by
    intro f hf
    have hnil : IsNilpotent (algebraMap R A f) := by
      rw [nilpotent_iff_mem_prime]
      intro J hJ
      have : comap (algebraMap R A) ⟨J, hJ⟩ ∈ zeroLocus (t : Set R) := ht ▸ ⟨_, rfl⟩
      exact this hf
    obtain ⟨n, hn⟩ := hnil
    rw [← map_pow, map_eq_zero_iff S] at hn
    obtain ⟨⟨s, hs⟩, hs'⟩ := hn
    exact ⟨s, hs, n, hs'⟩
  choose! s hs n hn using key
  have hmem : ∏ f ∈ t, s f ∈ S := Submonoid.prod_mem _ fun f hf ↦ hs f hf
  refine ⟨∏ f ∈ t, s f, hmem, subset_antisymm ?_ ?_⟩
  · rw [localization_comap_range A S]
    exact fun p hp hg ↦ Set.disjoint_left.mp hp hmem hg
  · rw [← ht]
    intro p hp f hf
    have hsf : s f ∉ p.asIdeal := fun h ↦ hp (p.asIdeal.mem_of_dvd (Finset.dvd_prod_of_mem _ hf) h)
    have h0 : s f * f ^ n f ∈ p.asIdeal := by simp [hn f hf]
    exact p.isPrime.mem_of_pow_mem _ ((p.isPrime.mem_or_mem h0).resolve_left hsf)

/-- If `Spec R` is a Noetherian topological space and the image of `Spec(S⁻¹R) → Spec R` is
closed, then it is `D(g)` for some `g ∈ S`. -/
theorem exists_range_comap_eq_basicOpen_of_isClosed [NoetherianSpace (PrimeSpectrum R)]
    (hclosed : IsClosed (Set.range (comap (algebraMap R A)))) :
    ∃ g ∈ S, Set.range (comap (algebraMap R A)) = (basicOpen g : Set (PrimeSpectrum R)) :=
  exists_range_comap_eq_basicOpen_of_isClosed_of_isCompact_compl S A hclosed
    (NoetherianSpace.isCompact _)

end

variable {R : Type u} [CommRing R] (S : Submonoid R) (A : Type*) [CommRing A] [Algebra R A]
  [IsLocalization S A]

include S

/-- If the image of `Spec(S⁻¹R) → Spec R` is closed and open, then `S⁻¹R` is a direct factor
of `R`. -/
theorem exists_ringEquiv_prod_of_isClopen_range
    (h : IsClopen (Set.range (comap (algebraMap R A)))) :
    ∃ (R' : Type u) (_ : CommRing R'), Nonempty (R ≃+* A × R') := by
  obtain ⟨e, he, hZ⟩ := PrimeSpectrum.isClopen_iff.mp h
  let T := R ⧸ Ideal.span {1 - e}
  have : IsLocalization.Away e T := IsLocalization.Away.quotient_of_isIdempotentElem he
  let N := S ⊔ Submonoid.powers e
  have hA : ∀ r ∈ N, IsUnit (algebraMap R A r) := by
    refine isUnit_algebraMap_of_mem_sup_powers (fun s hs ↦ map_units A ⟨s, hs⟩) ?_
    by_contra hu
    obtain ⟨q, hq⟩ := exists_prime_comap_mem_of_not_isUnit hu
    have : comap (algebraMap R A) q ∈ (basicOpen e : Set (PrimeSpectrum R)) :=
      hZ ▸ ⟨q, rfl⟩
    exact this hq
  have hT : ∀ r ∈ N, IsUnit (algebraMap R T r) := by
    refine isUnit_algebraMap_of_mem_sup_powers ?_ (IsLocalization.Away.algebraMap_isUnit e)
    intro y hy
    by_contra hu
    obtain ⟨q, hq⟩ := exists_prime_comap_mem_of_not_isUnit hu
    have h1 : comap (algebraMap R T) q ∈ (basicOpen e : Set (PrimeSpectrum R)) := fun hq ↦
      q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hq
        (IsLocalization.Away.algebraMap_isUnit e))
    rw [← hZ, localization_comap_range A S] at h1
    exact Set.disjoint_left.mp h1 hy hq
  have : IsLocalization N A := IsLocalization.of_le S N le_sup_left hA
  have : IsLocalization N T := IsLocalization.of_le (Submonoid.powers e) N le_sup_right hT
  obtain ⟨ψ⟩ := he.nonempty_ringEquiv_quotient_prod
  exact ⟨R ⧸ Ideal.span {e}, inferInstance,
    ⟨ψ.trans (RingEquiv.prodCongr (IsLocalization.algEquiv N A T).symm.toRingEquiv
      (RingEquiv.refl _))⟩⟩

/-- Let `S ⊆ R` be a multiplicative subset such that the image of `Spec(S⁻¹R) → Spec R` is
closed. If `R` is Noetherian, or `Spec R` is a Noetherian topological space, or `S` is finitely
generated as a monoid, then `R ≅ S⁻¹R × R'` for some ring `R'`. -/
@[stacks 02JI]
theorem exists_ringEquiv_prod_of_isClosed_range
    (hclosed : IsClosed (Set.range (comap (algebraMap R A))))
    (h : IsNoetherianRing R ∨ NoetherianSpace (PrimeSpectrum R) ∨ S.FG) :
    ∃ (R' : Type u) (_ : CommRing R'), Nonempty (R ≃+* A × R') := by
  obtain ⟨g, -, hg⟩ : ∃ g ∈ S,
      Set.range (comap (algebraMap R A)) = (basicOpen g : Set (PrimeSpectrum R)) := by
    rcases h with h | h | h
    · exact exists_range_comap_eq_basicOpen_of_isClosed S A hclosed
    · exact exists_range_comap_eq_basicOpen_of_isClosed S A hclosed
    · exact exists_range_comap_eq_basicOpen_of_fg S A h
  exact exists_ringEquiv_prod_of_isClopen_range S A ⟨hclosed, hg ▸ (basicOpen g).isOpen⟩

end IsLocalization
