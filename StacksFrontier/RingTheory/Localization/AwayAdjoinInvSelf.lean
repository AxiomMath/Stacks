module

public import Mathlib.RingTheory.Extension.Generators
public import StacksCore.Tactic.StacksAttribute

/-!
# A localization away from one element is generated by its inverse

Let `S` be a localization of a commutative ring `R` away from an element `r`. As an
`R`-algebra, `S` is generated by the single element `IsLocalization.Away.invSelf r`,
the inverse of the image of `r`.

## Main results

* `IsLocalization.Away.adjoin_invSelf_eq_top`: the `R`-subalgebra of `S` generated by
  `IsLocalization.Away.invSelf r` is the whole of `S`.

## Implementation notes

The proof reads off generation from `Algebra.Generators.localizationAway`, Mathlib's
one-element presentation of a localization away from an element, whose single generator is
exactly `IsLocalization.Away.invSelf r`.

For a graded polynomial ring `S = k[x, y, z]` and a variable `z` this is the identity
`S_z = k[x, y, z, 1/z]` used in the construction of the standard affine charts of `Proj`.

## References

* [Stacks Project, Tag 01ML](https://stacks.math.columbia.edu/tag/01ML)
-/

@[expose] public noncomputable section

universe u v

namespace IsLocalization.Away

/-- A localization away from one element is generated, as an algebra over the base ring, by
the inverse of that element. -/
public theorem adjoin_invSelf_eq_top (R : Type u) [CommRing R]
    (S : Type v) [CommRing S] [Algebra R S] (r : R)
    [IsLocalization.Away r S] :
    Algebra.adjoin R ({(IsLocalization.Away.invSelf r : S)} : Set S) = ⊤ := by
  have h : Algebra.adjoin R (Set.range (Algebra.Generators.localizationAway S r).val) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval, AlgHom.range_eq_top]
    exact (Algebra.Generators.localizationAway S r).aeval_val_surjective
  simpa only [Set.range_unique, Algebra.Generators.localizationAway_val] using h

end IsLocalization.Away

end
