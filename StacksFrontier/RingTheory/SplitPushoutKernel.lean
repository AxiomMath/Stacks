module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.RingTheory.TensorProduct.Basic

/-!
# The kernel of a retraction of a split base change

Let `π : R₀ ⟶ R'` be a homomorphism of commutative rings with a retraction `β : R' ⟶ R₀`,
`β ∘ π = id`, and let `A' = A ⊗_{R₀} R'` be the base change of an `R₀`-algebra `A`, given as a
pushout square of commutative rings. A ring homomorphism `g : A' ⟶ A` which is a retraction of
`A ⟶ A'` and restricts to `β` followed by `R₀ ⟶ A` on `R'` has kernel generated by the image of
the kernel of `β`.

This is the computation of the ideal of the special fibre `U ⊂ U ×_{Spec k} Spec k[M]` of a
trivial square-zero thickening of an affine scheme, used in Stacks 08W8.

## Main results

* `CommRingCat.exists_sum_of_isPushout`: every element of the pushout of commutative rings is a
  finite sum of products of images of the two legs.
* `RingHom.ker_eq_span_of_isPushout_of_retraction`: the kernel computation.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace CommRingCat

/-- **Every element of a pushout of commutative rings is a finite sum of products of images of
the two legs.** -/
theorem exists_sum_of_isPushout {R₀ A R' A' : CommRingCat.{u}} {f : R₀ ⟶ A} {g : R₀ ⟶ R'}
    {inl : A ⟶ A'} {inr : R' ⟶ A'} (h : IsPushout f g inl inr) (x : A') :
    ∃ (n : ℕ) (a : Fin n → A) (t : Fin n → R'), x = ∑ i, inl.hom (a i) * inr.hom (t i) := by
  let := f.hom.toAlgebra
  let := g.hom.toAlgebra
  let P := CommRingCat.isPushout_tensorProduct R₀ A R'
  let e := P.isoIsPushout _ _ h
  obtain ⟨y, rfl⟩ : ∃ y, e.hom y = x := ⟨e.inv x, by
    show (e.inv ≫ e.hom) x = x
    rw [Iso.inv_hom_id]; rfl⟩
  have hl : ∀ a : A, e.hom (a ⊗ₜ[R₀] (1 : R')) = inl a := fun a =>
    congrArg (fun φ : A ⟶ A' => φ a) (P.inl_isoIsPushout_hom _ _ h)
  have hr : ∀ t : R', e.hom ((1 : A) ⊗ₜ[R₀] t) = inr t := fun t =>
    congrArg (fun φ : R' ⟶ A' => φ t) (P.inr_isoIsPushout_hom _ _ h)
  induction y using TensorProduct.induction_on with
  | zero => exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
  | tmul a t =>
    refine ⟨1, fun _ => a, fun _ => t, ?_⟩
    have : a ⊗ₜ[R₀] t = (a ⊗ₜ[R₀] (1 : R')) * ((1 : A) ⊗ₜ[R₀] t) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [this, map_mul, hl, hr]
    simp
  | add x y hx hy =>
    obtain ⟨n, a, t, hx⟩ := hx
    obtain ⟨m, b, s, hy⟩ := hy
    refine ⟨n + m, Fin.append a b, Fin.append t s, ?_⟩
    rw [map_add, hx, hy, Fin.sum_univ_add]
    simp

end CommRingCat

namespace RingHom

/-- **The kernel of a retraction of a split base change is generated by the kernel of the
retraction of the base.** -/
theorem ker_eq_span_of_isPushout_of_retraction {R₀ A R' A' : CommRingCat.{u}} {f : R₀ ⟶ A}
    {π : R₀ ⟶ R'} {inl : A ⟶ A'} {inr : R' ⟶ A'} (h : IsPushout f π inl inr)
    (β : R' ⟶ R₀) (hβπ : π ≫ β = 𝟙 R₀) (g : A' ⟶ A) (hgl : inl ≫ g = 𝟙 A)
    (hgr : inr ≫ g = β ≫ f) (K : Set R') (hK : RingHom.ker β.hom = Ideal.span K) :
    RingHom.ker g.hom = Ideal.span (inr.hom '' K) := by
  have hgl' : ∀ a, g (inl a) = a := fun a => congrArg (fun φ : A ⟶ A => φ a) hgl
  have hgr' : ∀ t, g (inr t) = f (β t) := fun t => congrArg (fun φ : R' ⟶ A => φ t) hgr
  have hβπ' : ∀ r, β (π r) = r := fun r => congrArg (fun φ : R₀ ⟶ R₀ => φ r) hβπ
  have hw : ∀ r, inl (f r) = inr (π r) := fun r =>
    congrArg (fun φ : R₀ ⟶ A' => φ r) h.w
  have hker : ∀ t, β t = 0 → g (inr t) = 0 := fun t ht => by rw [hgr', ht, map_zero]
  have hsub : ∀ t, β (t - π (β t)) = 0 := fun t => by rw [map_sub, hβπ', sub_self]
  have hmapK : Ideal.map inr.hom (RingHom.ker β.hom) ≤ Ideal.span (inr.hom '' K) := by
    rw [hK, Ideal.map_span]
  apply le_antisymm
  · intro x hx
    obtain ⟨n, a, t, rfl⟩ := CommRingCat.exists_sum_of_isPushout h x
    have hgx : ∑ i, a i * f (β (t i)) = 0 := by
      simpa [hgl', hgr'] using hx
    have key : ∑ i, inl.hom (a i) * inr.hom (t i) =
        inl (∑ i, a i * f (β (t i))) +
          ∑ i, inl.hom (a i) * inr.hom (t i - π.hom (β.hom (t i))) := by
      simp only [map_sum, map_mul, map_sub, mul_sub, Finset.sum_sub_distrib]
      simp only [hw]
      ring
    rw [key, hgx, map_zero, zero_add]
    exact Submodule.sum_mem _ fun i _ =>
      Ideal.mul_mem_left _ _ (hmapK (Ideal.mem_map_of_mem _ (hsub _)))
  · rw [Ideal.span_le]
    rintro _ ⟨t, ht, rfl⟩
    show g (inr t) = 0
    refine hker t ?_
    have : t ∈ RingHom.ker β.hom := by rw [hK]; exact Ideal.subset_span ht
    exact this

end RingHom

end
