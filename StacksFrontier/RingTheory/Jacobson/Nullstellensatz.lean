/-!
# The Nullstellensatz and its cardinality variants

A field of finite type over a subring `R` is finite over a localization `R_f` which is a field.
A linear operator on a nonzero vector space whose dimension is smaller than the cardinality of
the base field has a non-invertible monic polynomial expression of positive degree. A
`K`-algebra whose `K`-rank is smaller than `#K` has residue fields algebraic over `K` and is a
Jacobson ring; this applies to a base change `K ⊗[k] S` with `#S < #K` and to an algebra over a
field `k` generated by fewer than `#k` elements.

## Main results

* `exists_isField_localizationAway_and_finite_of_finiteType`: a field `K` of finite type over a
  subring `R` is finite over some localization `R_f` which is a field.
* `exists_monic_aeval_not_bijective_of_rank_lt_card`: if `dim_k V < #k`, then for every operator
  `T` on `V` some monic polynomial `P` of positive degree makes `P(T)` not bijective.
* `Ideal.jacobson_bot_eq_bot_of_rank_lt_card`: a `K`-algebra domain of `K`-rank `< #K` has zero
  Jacobson radical.
* `Algebra.isAlgebraic_tensorProduct_quotient_of_card_lt` and
  `isJacobsonRing_tensorProduct_of_card_lt`: if `#S < #K`, the residue fields of `K ⊗[k] S` are
  algebraic over `K` and `K ⊗[k] S` is a Jacobson ring.
* `Algebra.isAlgebraic_quotient_of_adjoin_eq_top_of_card_lt` and
  `isJacobsonRing_of_adjoin_eq_top_of_card_lt`: the residue fields of a `k`-algebra generated by
  fewer than `#k` elements are algebraic over `k`, and the algebra is a Jacobson ring.
-/

@[expose] public section

/-- Powers of a nonzero element of a domain lie in the non-zero-divisors. -/
private lemma powers_le_nonZeroDivisors {R : Type*} [CommRing R] [IsDomain R]
    {r : R} (hr : r ≠ 0) :
    (Submonoid.powers r : Submonoid R) ≤ nonZeroDivisors R :=
  powers_le_nonZeroDivisors_of_noZeroDivisors hr

/-- A field of finite type over a commutative ring is algebraic over that ring. -/
theorem Algebra.IsAlgebraic.of_finiteType {R K : Type*} [CommRing R] [Field K]
    [Algebra R K] [Algebra.FiniteType R K] : Algebra.IsAlgebraic R K := by
  by_cases hRK : Function.Injective (algebraMap R K)
  · have : IsDomain R := hRK.isDomain _
    let : Algebra (FractionRing R) K := (IsFractionRing.lift hRK).toAlgebra
    have : IsScalarTower R (FractionRing R) K :=
      .of_algebraMap_eq fun a ↦ (IsFractionRing.lift_algebraMap hRK a).symm
    have : Algebra.FiniteType (FractionRing R) K := .of_restrictScalars_finiteType R _ K
    have : Module.Finite (FractionRing R) K := finite_of_finite_type_of_isJacobsonRing _ K
    exact (IsFractionRing.comap_isAlgebraic_iff (K := FractionRing R)).mpr (.of_finite _ K)
  · exact Algebra.isAlgebraic_of_not_injective hRK

/-- If `m • x` is integral over `R` for `m ∈ M`, then `x` is integral over `M⁻¹R`. -/
theorem IsIntegral.of_smul_isLocalization {R S Rₘ : Type*} [CommRing R] [Ring S] [Algebra R S]
    (M : Submonoid R) [CommRing Rₘ] [Algebra R Rₘ] [IsLocalization M Rₘ] [Algebra Rₘ S]
    [IsScalarTower R Rₘ S] {x : S} {m : R} (hm : m ∈ M) (h : IsIntegral R (m • x)) :
    IsIntegral Rₘ x := by
  have hu : IsUnit (algebraMap R Rₘ m) := IsLocalization.map_units Rₘ ⟨m, hm⟩
  refine IsIntegral.of_mul_unit (y := algebraMap R S m) (r := ↑hu.unit⁻¹) ?_ ?_
  · rw [IsScalarTower.algebraMap_apply R Rₘ S, ← map_mul, hu.val_inv_mul, map_one]
  · rw [← Algebra.commutes, ← Algebra.smul_def]
    exact h.tower_top

/-- Let `R ⊂ K` with `K` a field and `K` of finite type over `R` as an `R`-algebra. Then there
exists `f ∈ R` such that the localization `R_f` is a field, and `K` is a finite extension of
`R_f`. -/
@[stacks 00FY]
theorem exists_isField_localizationAway_and_finite_of_finiteType (R K : Type*)
    [CommRing R] [Field K]
    [Algebra R K] (hRK : Function.Injective (algebraMap R K))
    [Algebra.FiniteType R K] :
    ∃ f : R, IsField (Localization.Away f) ∧
      ∃ (_ : Algebra (Localization.Away f) K)
        (_ : IsScalarTower R (Localization.Away f) K),
        Module.Finite (Localization.Away f) K := by
  have := hRK.isDomain _
  have : Algebra.IsAlgebraic R K := .of_finiteType
  obtain ⟨s, hs⟩ := (‹Algebra.FiniteType R K›).out
  obtain ⟨r, hr_ne, hr_int⟩ : ∃ y ≠ (0 : R), ∀ z ∈ s, IsIntegral R (y • z) :=
    Algebra.IsAlgebraic.exists_integral_multiples R s
  set Rr := Localization.Away r
  have hUnitK : IsUnit (algebraMap R K r) :=
    IsUnit.mk0 _ fun h ↦ hr_ne (hRK (h.trans (map_zero _).symm))
  let algRrK : Algebra Rr K := (IsLocalization.Away.lift (S := Rr) r hUnitK).toAlgebra
  have htower : IsScalarTower R Rr K :=
    .of_algebraMap_eq fun x ↦ (IsLocalization.Away.lift_eq r hUnitK x).symm
  have : Algebra.IsIntegral Rr K := ⟨fun x ↦
    (hs ▸ Algebra.adjoin_le fun y hy ↦
      (hr_int y hy).of_smul_isLocalization (Submonoid.powers r) (Submonoid.mem_powers r) :
      (⊤ : Subalgebra R K) ≤ (integralClosure Rr K).restrictScalars R) Algebra.mem_top⟩
  have : Algebra.FiniteType Rr K := .of_restrictScalars_finiteType R Rr K
  have hRrK_inj : Function.Injective (algebraMap Rr K) := by
    apply IsLocalization.injective_of_map_algebraMap_zero (M := Submonoid.powers r) (S := Rr)
    intro y hy
    rw [← IsScalarTower.algebraMap_apply] at hy
    simp [hRK (hy.trans (map_zero _).symm)]
  have : IsDomain Rr :=
    IsLocalization.isDomain_localization (M := Submonoid.powers r)
      (powers_le_nonZeroDivisors hr_ne)
  exact ⟨r, (Algebra.IsIntegral.isField_iff_isField hRrK_inj).mpr (Field.toIsField K), algRrK,
    htower, Algebra.IsIntegral.finite⟩

end

@[expose] public section

open Polynomial

universe u v

/-- Let `k` be a field and `V` a nonzero `k`-vector space with `dim_k V < |k|` (as cardinals).
Then for every `k`-linear operator `T : V → V` there is a monic polynomial `P` of degree `≥ 1`
such that `P(T)` is not bijective (i.e. not invertible). -/
@[stacks 00FT]
theorem exists_monic_aeval_not_bijective_of_rank_lt_card
    {k : Type u} [Field k] {V : Type v} [AddCommGroup V] [Module k V]
    [Nontrivial V]
    (h : Cardinal.lift.{u} (Module.rank k V) < Cardinal.lift.{v} (Cardinal.mk k))
    (T : V →ₗ[k] V) :
    ∃ P : k[X], P.Monic ∧ 1 ≤ P.natDegree ∧ ¬ Function.Bijective (aeval T P) := by
  classical
  by_contra hcon
  push Not at hcon
  have hunit_monic : ∀ P : k[X], P.Monic → 1 ≤ P.natDegree → IsUnit (aeval T P) :=
    fun P hPm hPd ↦ (Module.End.isUnit_iff _).mpr (hcon P hPm hPd)
  have hunit : ∀ Q : k[X], Q ≠ 0 → IsUnit (aeval T Q) := by
    intro Q hQ
    set c := Q.leadingCoeff
    have hc0 : c ≠ 0 := leadingCoeff_ne_zero.mpr hQ
    set M := Q * C c⁻¹ with hM
    have hMm : M.Monic := monic_mul_leadingCoeff_inv hQ
    have hMdeg : M.natDegree = Q.natDegree := natDegree_mul_leadingCoeff_inv Q hQ
    have hQfac : Q = M * C c := by
      rw [hM, mul_assoc, ← C_mul, inv_mul_cancel₀ hc0, C_1, mul_one]
    have hMunit : IsUnit (aeval T M) := by
      rcases Nat.eq_zero_or_pos M.natDegree with h0 | hpos
      · rw [eq_one_of_monic_natDegree_zero hMm h0, map_one]
        exact isUnit_one
      · exact hunit_monic M hMm hpos
    have hCunit : IsUnit (aeval T (C c)) := by
      rw [aeval_C]
      exact (Ne.isUnit hc0).map (algebraMap k (Module.End k V))
    rw [hQfac, map_mul]
    exact hMunit.mul hCunit
  have hinj : ∀ Q : k[X], Q ≠ 0 → Function.Injective (aeval T Q) :=
    fun Q hQ ↦ ((Module.End.isUnit_iff _).mp (hunit Q hQ)).injective
  obtain ⟨v, hv⟩ := exists_ne (0 : V)
  set S : k → Module.End k V := fun a ↦ aeval T (Polynomial.X - C a) with hS
  have hSunit : ∀ a : k, IsUnit (S a) :=
    fun a ↦ hunit_monic _ (monic_X_sub_C a) (natDegree_X_sub_C a).ge
  have hSsurj : ∀ a : k, ∃ x : V, (S a) x = v := fun a ↦
    ((Module.End.isUnit_iff (S a)).mp (hSunit a)).surjective v
  choose w hSw using hSsurj
  set q : k → k[X] := fun b ↦ Polynomial.X - C b with hq
  have happly : ∀ (s : Finset k) (a : k), a ∈ s →
      (aeval T (∏ b ∈ s, q b)) (w a) = (aeval T (∏ b ∈ s.erase a, q b)) v := by
    intro s a ha
    have hfac : (∏ b ∈ s, q b) = (∏ b ∈ s.erase a, q b) * q a :=
      (Finset.prod_erase_mul s q ha).symm
    have : aeval T (q a) = S a := by rw [hq, hS]
    rw [hfac, map_mul, Module.End.mul_apply, this, hSw a]
  have hLI : LinearIndependent k w := by
    rw [linearIndependent_iff']
    intro s g hsum m hm
    have hsum' : (aeval T (∑ a ∈ s, C (g a) * ∏ b ∈ s.erase a, q b)) v = 0 := by
      have hstart := congrArg (aeval T (∏ b ∈ s, q b)) hsum
      rw [map_zero, map_sum] at hstart
      simp only [map_smul] at hstart
      have key : ∀ a ∈ s, g a • (aeval T (∏ b ∈ s, q b)) (w a)
          = (aeval T (C (g a) * ∏ b ∈ s.erase a, q b)) v := by
        intro a ha
        rw [happly s a ha, map_mul, Module.End.mul_apply, aeval_C,
          Module.algebraMap_end_apply]
      rw [Finset.sum_congr rfl key] at hstart
      rwa [map_sum, LinearMap.sum_apply]
    set R : k[X] := ∑ a ∈ s, C (g a) * ∏ b ∈ s.erase a, q b with hR
    have hR0 : R = 0 := by
      by_contra hRne
      exact hv (hinj R hRne (by rw [hsum', map_zero]))
    have heval : R.eval m = g m * ∏ b ∈ s.erase m, (m - b) := by
      rw [hR, eval_finsetSum, Finset.sum_eq_single m]
      · simp [hq, eval_prod]
      · intro a ha hane
        have hmem : m ∈ s.erase a := Finset.mem_erase.mpr ⟨fun h ↦ hane h.symm, hm⟩
        rw [eval_mul, eval_prod]
        have : (∏ b ∈ s.erase a, (q b).eval m) = 0 := by
          apply Finset.prod_eq_zero hmem
          simp [hq]
        rw [this, mul_zero]
      · exact fun hmns ↦ absurd hm hmns
    have hprod_ne : (∏ b ∈ s.erase m, (m - b)) ≠ 0 := Finset.prod_ne_zero_iff.mpr fun b hb ↦
      sub_ne_zero.mpr fun h ↦ (Finset.mem_erase.mp hb).left h.symm
    have : g m * ∏ b ∈ s.erase m, (m - b) = 0 := by rw [← heval, hR0, eval_zero]
    exact (mul_eq_zero.mp this).resolve_right hprod_ne
  exact absurd hLI.cardinal_lift_le_rank (not_le.mpr h)

end

/-!
# Base change of a Jacobson ring along a large field extension

Let `k` be a commutative semiring, `S` a commutative `k`-algebra and `K` a field that is a
`k`-algebra, and write `S_K = K ⊗[k] S`, with the `K`-algebra structure induced by the left
tensor factor. If `Cardinal.lift #S < Cardinal.lift #K`, then every residue field of `S_K` at a
maximal ideal is algebraic over `K`, and `S_K` is a Jacobson ring. Both follow from the
cardinality Nullstellensatz: a `K`-algebra domain of `K`-rank `< #K` has zero Jacobson radical.
-/

@[expose] public section

open scoped TensorProduct

open Cardinal

universe u v w t

/-- A transcendental element of a field extension gives a family of linearly independent
elements indexed by the base field. -/
lemma Transcendental.cardinal_lift_le_rank {K : Type u} {L : Type v} [Field K] [Field L]
    [Algebra K L] {x : L} (hx : Transcendental K x) :
    lift.{v} #K ≤ lift.{u} (Module.rank K L) :=
  hx.linearIndependent_sub_inv.cardinal_lift_le_rank

/-- A field `L` over `K` whose `K`-rank is strictly smaller than `#K` is algebraic
over `K`. -/
lemma Algebra.IsAlgebraic.of_rank_lt_card {K : Type u} {L : Type v} [Field K] [Field L]
    [Algebra K L] (h : lift.{u} (Module.rank K L) < lift.{v} #K) :
    Algebra.IsAlgebraic K L := by
  by_contra hna
  obtain ⟨x, hx⟩ :=
    Algebra.transcendental_def.mp (Algebra.transcendental_iff_not_isAlgebraic.mpr hna)
  exact (Transcendental.cardinal_lift_le_rank hx).not_gt h

/-- The rank of a quotient algebra does not exceed the rank of the algebra. -/
theorem Ideal.rank_quotient_le (K : Type u) {A : Type v} [Field K] [CommRing A] [Algebra K A]
    (I : Ideal A) : Module.rank K (A ⧸ I) ≤ Module.rank K A :=
  LinearMap.rank_le_of_surjective (Ideal.Quotient.mkₐ K I).toLinearMap
    (by rw [AlgHom.coe_toLinearMap]; exact Ideal.Quotient.mkₐ_surjective K I)

/-- The base change `K ⊗[k] S` has `K`-rank at most `#S`. -/
theorem rank_baseChange_le_lift_cardinalMk (k : Type*) [CommSemiring k] {S : Type v}
    {K : Type w} [AddCommMonoid S] [Module k S] [Field K] [Algebra k K] :
    Module.rank K (K ⊗[k] S) ≤ Cardinal.lift.{w} (Cardinal.mk S) := by
  have hspan : Submodule.span K (Set.range ⇑(TensorProduct.mk k K S 1)) = ⊤ := by
    rw [← LinearMap.coe_range, ← Submodule.map_top, ← Submodule.baseChange_eq_span,
      Submodule.baseChange_top]
  calc Module.rank K (K ⊗[k] S) = Module.rank K (⊤ : Submodule K (K ⊗[k] S)) :=
        (rank_top K _).symm
    _ = Module.rank K (Submodule.span K (Set.range ⇑(TensorProduct.mk k K S 1))) := by
        rw [hspan]
    _ ≤ Cardinal.mk (Set.range ⇑(TensorProduct.mk k K S 1)) := rank_span_le _
    _ ≤ Cardinal.lift.{w} (Cardinal.mk S) := by
        have h := Cardinal.mk_range_le_lift (f := ⇑(TensorProduct.mk k K S 1))
        rwa [Cardinal.lift_id'.{v, w}, Cardinal.lift_umax.{v, w}] at h

/-- The base change `K ⊗[k] S` has rank smaller than `#K` when `#S < #K`. -/
theorem lift_rank_baseChange_lt (k : Type t) [CommSemiring k] {S : Type v} {K : Type w}
    [CommRing S] [Algebra k S] [Field K] [Algebra k K]
    (hcard : lift.{w} #S < lift.{v} #K) :
    lift.{w} (Module.rank K (K ⊗[k] S)) < lift.{max v w} #K := by
  calc lift.{w} (Module.rank K (K ⊗[k] S)) ≤ lift.{w} (lift.{w} #S) :=
        lift_le.mpr (rank_baseChange_le_lift_cardinalMk k)
    _ = lift.{max v w} (lift.{w} #S) := by simp
    _ < lift.{max v w} (lift.{v} #K) := lift_lt.mpr hcard
    _ = lift.{max v w} #K := by rw [lift_lift]

/-- A domain that is algebraic over a field `K` contained in it is itself a field. -/
lemma Algebra.IsAlgebraic.isField {K A : Type*} [Field K] [CommRing A] [IsDomain A]
    [Algebra K A] (halg : Algebra.IsAlgebraic K A) : IsField A := by
  have : Algebra.IsIntegral K A := Algebra.isAlgebraic_iff_isIntegral.mp halg
  exact (Algebra.IsIntegral.isField_iff_isField (algebraMap K A).injective).mp (Field.toIsField K)

section RankLoc
variable {K : Type u} {A : Type v} [Field K] [CommRing A] [Algebra K A] (f : A)

/-- The family `n ↦ 1/fⁿ` in `Localization.Away f`. -/
noncomputable def Localization.Away.invPow : ℕ → Localization.Away f :=
  fun n => IsLocalization.mk' (Localization.Away f) 1
    ⟨f ^ n, pow_mem (Submonoid.mem_powers f) n⟩

/-- The family `Localization.Away.invPow f` spans `Localization.Away f` over `A`: every element of
`A[1/f]` is an `A`-linear combination of the powers `1/fⁿ`. -/
theorem Localization.Away.linearCombination_invPow_surjective :
    Function.Surjective (Finsupp.linearCombination A (Localization.Away.invPow f)) := by
  rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination, eq_top_iff]
  rintro x -
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (Submonoid.powers f) x
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp s.property
  have hs : IsLocalization.mk' (Localization.Away f) a s =
      a • Localization.Away.invPow f n := by
    rw [Localization.Away.invPow, IsLocalization.smul_mk', mul_one]
    congr 1
    exact Subtype.ext hn.symm
  rw [hs]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_of_mem (Set.mem_range_self n))

/-- The `K`-rank of the localization `A[1/f]` is at most `ℵ₀ * Module.rank K A`. -/
theorem rank_localizationAway_le :
    Module.rank K (Localization.Away f) ≤ Cardinal.aleph0 * Module.rank K A := by
  refine (LinearMap.rank_le_of_surjective
    ((Finsupp.linearCombination A (Localization.Away.invPow f)).restrictScalars K)
    (Localization.Away.linearCombination_invPow_surjective f)).trans_eq ?_
  rw [rank_finsupp]
  simp
end RankLoc

/-- If `ℵ₀ * Module.rank K A < #K` for a `K`-algebra domain `A`, then every nonzero `f : A`
lies outside some maximal ideal. -/
lemma exists_isMaximal_notMem_of_aleph0_mul_rank_lt {K : Type u} {A : Type v} [Field K]
    [CommRing A] [IsDomain A] [Algebra K A]
    (h : lift.{u} (ℵ₀ * Module.rank K A) < lift.{v} #K)
    {f : A} (hf : f ≠ 0) : ∃ M : Ideal A, M.IsMaximal ∧ f ∉ M := by
  have : Nontrivial (Localization.Away f) :=
    OreLocalization.nontrivial_iff.mpr fun ⟨n, hn⟩ ↦ pow_ne_zero n hf hn
  obtain ⟨n, hn⟩ := Ideal.exists_maximal (Localization.Away f)
  let := Ideal.Quotient.field n
  have hrank : lift.{u} (Module.rank K (Localization.Away f ⧸ n)) < lift.{v} #K :=
    (lift_le.mpr ((n.rank_quotient_le K).trans (rank_localizationAway_le f))).trans_lt h
  let φ : A →ₐ[K] Localization.Away f := IsScalarTower.toAlgHom K A _
  refine ⟨_, Ideal.Quotient.maximal_of_isField _ (Algebra.IsAlgebraic.isField
    ((Algebra.IsAlgebraic.of_rank_lt_card hrank).of_injective (Ideal.quotientMapₐ n φ le_rfl)
      (Ideal.quotientMap_injective' (H := le_rfl) le_rfl))), fun hmem ↦ ?_⟩
  exact hn.ne_top (Ideal.eq_top_of_isUnit_mem n hmem (IsLocalization.Away.algebraMap_isUnit f))

/-- **Cardinality Nullstellensatz.** A `K`-algebra domain `A` whose `K`-rank is
strictly smaller than `#K` has trivial Jacobson radical: the intersection of all
its maximal ideals is `0`. -/
lemma Ideal.jacobson_bot_eq_bot_of_rank_lt_card {K : Type u} {A : Type v} [Field K]
    [CommRing A] [IsDomain A] [Algebra K A]
    (hrank : lift.{u} (Module.rank K A) < lift.{v} #K) :
    (⊥ : Ideal A).jacobson = ⊥ := by
  suffices h : ∀ x : A, x ≠ 0 → ∃ M : Ideal A, M.IsMaximal ∧ x ∉ M by
    rw [Ideal.jacobson, eq_bot_iff]
    intro x hx
    simp only [Ideal.mem_bot]
    by_contra hne
    obtain ⟨M, hM, hxM⟩ := h x hne
    exact hxM (Ideal.mem_sInf.mp hx ⟨bot_le, hM⟩)
  rcases lt_or_ge (Module.rank K A) Cardinal.aleph0 with hfin | hinf
  · have : Module.Finite K A := Module.rank_lt_aleph0_iff.mp hfin
    let := (IsField.of_isDomain_of_finite K A).toField
    exact fun x hx ↦ ⟨⊥, Ideal.bot_isMaximal, by simpa using hx⟩
  · exact fun _ ↦ exists_isMaximal_notMem_of_aleph0_mul_rank_lt
      (by rwa [Cardinal.aleph0_mul_eq hinf])

/-- A `K`-algebra of rank smaller than `#K` is a Jacobson ring. -/
theorem isJacobsonRing_of_rank_lt_card {K : Type u} {A : Type v} [Field K] [CommRing A]
    [Algebra K A] (h : lift.{u} (Module.rank K A) < lift.{v} #K) : IsJacobsonRing A := by
  refine isJacobsonRing_iff_prime_eq.mpr fun P hP ↦ ?_
  rw [Ideal.jacobson_eq_iff_jacobson_quotient_eq_bot]
  exact Ideal.jacobson_bot_eq_bot_of_rank_lt_card
    ((lift_le.mpr (P.rank_quotient_le K)).trans_lt h)

/-- The residue field at a maximal ideal of a `K`-algebra of rank smaller than `#K` is
algebraic over `K`. -/
theorem Algebra.isAlgebraic_quotient_of_rank_lt_card {K : Type u} {A : Type v} [Field K]
    [CommRing A] [Algebra K A] (h : lift.{u} (Module.rank K A) < lift.{v} #K)
    (m : Ideal A) [m.IsMaximal] : Algebra.IsAlgebraic K (A ⧸ m) :=
  let := Ideal.Quotient.field m
  Algebra.IsAlgebraic.of_rank_lt_card ((lift_le.mpr (m.rank_quotient_le K)).trans_lt h)

/-- Every residue field of `K ⊗[k] S` is algebraic over `K` when `#S < #K`. -/
@[stacks 046V "(1)"]
theorem Algebra.isAlgebraic_tensorProduct_quotient_of_card_lt (k : Type t) [CommSemiring k]
    (S : Type v) [CommRing S] [Algebra k S] (K : Type w) [Field K] [Algebra k K]
    (hcard : lift.{w} #S < lift.{v} #K) (m : Ideal (K ⊗[k] S)) [m.IsMaximal] :
    Algebra.IsAlgebraic K ((K ⊗[k] S) ⧸ m) :=
  Algebra.isAlgebraic_quotient_of_rank_lt_card (lift_rank_baseChange_lt k hcard) m

/-- The base change `K ⊗[k] S` is Jacobson when `#S < #K`. -/
@[stacks 046V "(2)"]
theorem isJacobsonRing_tensorProduct_of_card_lt (k : Type t) [CommSemiring k]
    (S : Type v) [CommRing S] [Algebra k S] (K : Type w) [Field K] [Algebra k K]
    (hcard : lift.{w} #S < lift.{v} #K) : IsJacobsonRing (K ⊗[k] S) :=
  isJacobsonRing_of_rank_lt_card (lift_rank_baseChange_lt k hcard)

end

/-!
# Uncountable Nullstellensatz

Let `k` be a field and let `S` be generated as a `k`-algebra by `x : I → S`, with
`#I < #k` (compared through `Cardinal.lift`, so `k`, `S` and `I` may lie in different
universes). Every residue field of `S` is algebraic over `k`, and `S` is Jacobson.
-/

@[expose] public section

open Cardinal

universe u v w

/-- An algebra generated by an infinite family `x : I → S` has rank at most `#I`. -/
theorem lift_rank_le_of_adjoin_range_eq_top {k : Type u} {S : Type v} {I : Type w} [Field k]
    [CommRing S] [Algebra k S] [Infinite I] (x : I → S)
    (hgen : Algebra.adjoin k (Set.range x) = ⊤) :
    lift.{w} (Module.rank k S) ≤ lift.{v} #I := by
  have hsurj : Function.Surjective (MvPolynomial.aeval (R := k) x) :=
    (AlgHom.range_eq_top _).mp ((Algebra.adjoin_range_eq_range_aeval k x).symm.trans hgen)
  have h := LinearMap.lift_rank_le_of_surjective (MvPolynomial.aeval (R := k) x).toLinearMap
    (by rw [AlgHom.coe_toLinearMap]; exact hsurj)
  rw [MvPolynomial.rank_eq_lift, Cardinal.mk_finsupp_nat,
    max_eq_left (Cardinal.aleph0_le_mk I), lift_lift] at h
  rwa [← lift_le.{u}, lift_lift, lift_lift]

/-- An algebra generated by an infinite family `x : I → S` with `#I < #k` has rank
smaller than `#k`. -/
theorem lift_rank_lt_of_adjoin_range_eq_top {k : Type u} {S : Type v} {I : Type w} [Field k]
    [CommRing S] [Algebra k S] [Infinite I] (x : I → S)
    (hgen : Algebra.adjoin k (Set.range x) = ⊤) (hI : lift.{u} #I < lift.{w} #k) :
    lift.{u} (Module.rank k S) < lift.{v} #k := by
  have h1 : lift.{u} (lift.{w} (Module.rank k S)) ≤ lift.{u} (lift.{v} #I) :=
    lift_le.mpr (lift_rank_le_of_adjoin_range_eq_top x hgen)
  have h2 : lift.{v} (lift.{u} #I) < lift.{v} (lift.{w} #k) := lift_lt.mpr hI
  suffices h : lift.{w} (lift.{u} (Module.rank k S)) < lift.{w} (lift.{v} #k) from lift_lt.mp h
  rw [lift_lift, lift_lift] at h1 h2 ⊢
  exact h1.trans_lt h2

/-- An algebra generated by fewer than `#k` elements is of finite type or has rank below `#k`. -/
private theorem finiteType_or_lift_rank_lt_of_adjoin_eq_top {k : Type u} {S : Type v}
    {I : Type w} [Field k] [CommRing S] [Algebra k S] (x : I → S)
    (hgen : Algebra.adjoin k (Set.range x) = ⊤) (hI : lift.{u} #I < lift.{w} #k) :
    Algebra.FiniteType k S ∨ lift.{u} (Module.rank k S) < lift.{v} #k := by
  rcases finite_or_infinite I with hfin | hinf
  · exact .inl ⟨Subalgebra.fg_def.mpr ⟨Set.range x, Set.finite_range x, hgen⟩⟩
  · exact .inr (lift_rank_lt_of_adjoin_range_eq_top x hgen hI)

/-- The residue fields of an algebra generated by fewer than `#k` elements are algebraic over
the field `k`. -/
@[stacks 00FU "(1)"]
theorem Algebra.isAlgebraic_quotient_of_adjoin_eq_top_of_card_lt {k : Type u} {S : Type v}
    {I : Type w} [Field k] [CommRing S] [Algebra k S] (x : I → S)
    (hgen : Algebra.adjoin k (Set.range x) = ⊤) (hI : lift.{u} #I < lift.{w} #k)
    (m : Ideal S) [m.IsMaximal] : Algebra.IsAlgebraic k (S ⧸ m) := by
  rcases finiteType_or_lift_rank_lt_of_adjoin_eq_top x hgen hI with _ | h
  · let : Field (S ⧸ m) := Ideal.Quotient.field m
    have : Module.Finite k (S ⧸ m) := finite_of_finite_type_of_isJacobsonRing k (S ⧸ m)
    exact Algebra.IsAlgebraic.of_finite k (S ⧸ m)
  · exact Algebra.isAlgebraic_quotient_of_rank_lt_card h m

/-- An algebra generated by fewer than `#k` elements over a field `k` is a Jacobson ring. -/
@[stacks 00FU "(2)"]
theorem isJacobsonRing_of_adjoin_eq_top_of_card_lt {k : Type u} {S : Type v} {I : Type w}
    [Field k] [CommRing S] [Algebra k S] (x : I → S)
    (hgen : Algebra.adjoin k (Set.range x) = ⊤) (hI : lift.{u} #I < lift.{w} #k) :
    IsJacobsonRing S := by
  rcases finiteType_or_lift_rank_lt_of_adjoin_eq_top x hgen hI with _ | h
  · exact isJacobsonRing_of_finiteType (A := k)
  · exact isJacobsonRing_of_rank_lt_card h

end
