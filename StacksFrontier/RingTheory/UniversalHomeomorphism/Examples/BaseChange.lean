module

public import StacksFrontier.RingTheory.UniversalHomeomorphism.Examples.PowerConditions
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Universal homeomorphisms: base change

Base change of surjective ring maps, the power condition on residue field extensions, and the
criteria for an integral ring map to be a closed embedding, resp. a homeomorphism, on spectra
universally, from `StacksFrontier.RingTheory.UniversalHomeomorphism.Examples`.

## Main results

* `Algebra.IsPushout.surjective_and_ker_eq_map_of_surjective`: the base change of a surjective
  ring map is surjective, with kernel the image ideal of the original kernel.
* `Ideal.ResidueField.exists_pow_mem_range_map`: the power condition passes to the residue
  field extensions induced by a ring map having it.
* `Algebra.IsPushout.injective_comap_and_residueFieldMap_isPurelyInseparable`: injectivity on
  spectra together with pure inseparability of the residue field extensions is stable under
  base change.
* `PrimeSpectrum.isClosedEmbedding_comap_of_isIntegral`,
  `PrimeSpectrum.isClosedEmbedding_comap_and_baseChange_of_injective_comap_of_isPurelyInseparable`,
  `PrimeSpectrum.isHomeomorph_comap_and_baseChange_of_bijective_comap_of_isPurelyInseparable`:
  an integral ring map injective, resp. bijective, on spectra is a closed embedding, resp. a
  homeomorphism, on spectra, universally so when the residue field extensions are purely
  inseparable.

## References

* [Stacks Project, Tag 0BR6](https://stacks.math.columbia.edu/tag/0BR6)
* [Stacks Project, Tag 0BR8](https://stacks.math.columbia.edu/tag/0BR8)
* [Stacks Project, Tag 0BRB](https://stacks.math.columbia.edu/tag/0BRB)
* [Stacks Project, Tag 0BRC](https://stacks.math.columbia.edu/tag/0BRC)
* [Stacks Project, Tag 0BRD](https://stacks.math.columbia.edu/tag/0BRD)
-/

@[expose] public section

universe u v u' v' w

section

section Pushout

variable {R S R' S' : Type*} [CommRing R] [CommRing S] [CommRing R'] [CommRing S'] [Algebra R S]
  [Algebra R R'] [Algebra R S'] [Algebra S S'] [Algebra R' S'] [IsScalarTower R S S']
  [IsScalarTower R R' S']

/-- The square `R → R' → S'`, `R → S → S'` commutes: both composites are `algebraMap R S'`. -/
private theorem algebraMap_algebraMap (r : R) :
    algebraMap R' S' (algebraMap R R' r) = algebraMap S S' (algebraMap R S r) :=
  (IsScalarTower.algebraMap_apply R R' S' r).symm.trans (IsScalarTower.algebraMap_apply R S S' r)

/-- The ideal of `R'` generated by the image of `ker (R → S)` dies in `S'`, for any commuting
square: `R → R' → S'` factors through `S`. Neither the pushout property nor surjectivity of
`R → S` is needed. -/
private theorem map_ker_le_ker :
    (RingHom.ker (algebraMap R S)).map (algebraMap R R') ≤ RingHom.ker (algebraMap R' S') :=
  Ideal.map_le_iff_le_comap.mpr fun r hr ↦ by
    simp [RingHom.mem_ker, algebraMap_algebraMap (S := S), RingHom.mem_ker.mp hr]

variable [H : Algebra.IsPushout R S R' S']

/-- The base change of a surjective ring map along an arbitrary ring map is surjective: the image
of `R'` in `S'` contains the image of `S` and is stable under multiplication by it, and `S'` is
spanned over `R'` by the image of `S`. -/
private theorem surjective_algebraMap_of_surjective
    (hsurj : Function.Surjective (algebraMap R S)) :
    Function.Surjective (algebraMap R' S') := by
  intro y
  induction y using H.out.inductionOn with
  | zero => exact ⟨0, map_zero _⟩
  | tmul x => exact ⟨x, rfl⟩
  | smul s n hn =>
      obtain ⟨x, rfl⟩ := hn
      obtain ⟨r, rfl⟩ := hsurj s
      exact ⟨algebraMap R R' r * x,
        by rw [map_mul, Algebra.smul_def, algebraMap_algebraMap (S := S)]⟩
  | add a b ha hb =>
      obtain ⟨x, rfl⟩ := ha
      obtain ⟨y, rfl⟩ := hb
      exact ⟨x + y, map_add _ _ _⟩

/-- The hard half of the kernel identity: the kernel of the base change is contained in the ideal
`I` generated by the image of `ker (R → S)`. The composite `R → R' ⧸ I` kills `ker (R → S)`, so it
descends along the surjection `R → S`, and the universal property of the square extends
`R' → R' ⧸ I` to `S' → R' ⧸ I`. -/
private theorem ker_le_map_of_surjective (hsurj : Function.Surjective (algebraMap R S)) :
    RingHom.ker (algebraMap R' S') ≤ (RingHom.ker (algebraMap R S)).map (algebraMap R R') := by
  set I := (RingHom.ker (algebraMap R S)).map (algebraMap R R')
  have hle : RingHom.ker (algebraMap R S) ≤ RingHom.ker (algebraMap R (R' ⧸ I)) := fun a ha ↦ by
    rw [RingHom.mem_ker, IsScalarTower.algebraMap_apply R R' (R' ⧸ I),
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ ha
  intro x hx
  have hF : Algebra.pushoutDesc S'
      (AlgHom.liftOfSurjective (Algebra.ofId R S) hsurj (Algebra.ofId R (R' ⧸ I)) hle)
      ((Ideal.Quotient.mkₐ R' I).restrictScalars R) (fun _ _ ↦ mul_comm _ _)
      (algebraMap R' S' x) = Ideal.Quotient.mk I x :=
    Algebra.pushoutDesc_right _ _ _ _ x
  rw [RingHom.mem_ker.mp hx, map_zero] at hF
  exact Ideal.Quotient.eq_zero_iff_mem.mp hF.symm

end Pushout

namespace Algebra.IsPushout

/-- Let `R → S` be a surjective ring map and let `S'` be the base change of `S` along an arbitrary
ring map `R → R'`, i.e. `R'`, `S'` complete `R`, `S` to a pushout square of `R`-algebras. Then
`R' → S'` is surjective and its kernel is the ideal of `R'` generated by the image of the kernel of
`R → S`. -/
@[stacks 0BR6 "The base change assertion."]
public theorem surjective_and_ker_eq_map_of_surjective
    {R S R' S' : Type*} [CommRing R] [CommRing S] [CommRing R'] [CommRing S'] [Algebra R S]
    [Algebra R R'] [Algebra R S'] [Algebra S S'] [Algebra R' S'] [IsScalarTower R S S']
    [IsScalarTower R R' S'] [IsPushout R S R' S']
    (hsurj : Function.Surjective (algebraMap R S)) :
    Function.Surjective (algebraMap R' S') ∧
      RingHom.ker (algebraMap R' S') = (RingHom.ker (algebraMap R S)).map (algebraMap R R') :=
  ⟨surjective_algebraMap_of_surjective hsurj,
    le_antisymm (ker_le_map_of_surjective hsurj) map_ker_le_ker⟩

end Algebra.IsPushout

end

/-- Every element of the residue field `κ(q)` of a prime `q` of `S` is a ratio of two elements of
the image of `S`, the denominator coming from an element outside `q`. -/
public theorem Ideal.exists_div_algebraMap_residueField_eq {S : Type*} [CommRing S]
    (q : Ideal S) [q.IsPrime] (x : q.ResidueField) :
    ∃ y z : S, z ∉ q ∧ algebraMap S q.ResidueField y / algebraMap S q.ResidueField z = x := by
  obtain ⟨u, rfl⟩ := IsLocalRing.residue_surjective (R := Localization.AtPrime q) x
  obtain ⟨y, ⟨z, hz⟩, rfl⟩ := IsLocalization.exists_mk'_eq q.primeCompl u
  refine ⟨y, z, hz, ?_⟩
  have hz0 : algebraMap S q.ResidueField z ≠ 0 := by simpa using hz
  rw [div_eq_iff hz0]
  simp only [IsScalarTower.algebraMap_apply S (Localization.AtPrime q) q.ResidueField,
    IsLocalRing.ResidueField.algebraMap_eq, ← map_mul]
  exact congrArg _ (IsLocalization.mk'_spec (Localization.AtPrime q) y ⟨z, hz⟩).symm

/-- In a field, the elements having a positive power in a given subfield are stable under
division. -/
private theorem Subfield.exists_pow_mem_div {K : Type*} [Field K] {T : Subfield K} {a b : K}
    (ha : ∃ n > 0, a ^ n ∈ T) (hb : ∃ n > 0, b ^ n ∈ T) : ∃ n > 0, (a / b) ^ n ∈ T := by
  obtain ⟨n, hn, hna⟩ := ha
  obtain ⟨m, hm, hmb⟩ := hb
  refine ⟨n * m, by positivity, ?_⟩
  rw [div_pow, pow_mul, pow_mul']
  exact T.div_mem (T.pow_mem hna m) (T.pow_mem hmb n)

/-- If every element of `S` has a positive power in the image of `f : R →+* S`, then the image in
`κ(q)` of an element of `S` has a positive power in the subfield spanned by `κ(p)`. -/
private theorem Ideal.ResidueField.exists_pow_algebraMap_mem_fieldRange_map {R S : Type*}
    [CommRing R] [CommRing S] {f : R →+* S} (H : ∀ x : S, ∃ n > 0, x ^ n ∈ f.range)
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime] (hpq : p = q.comap f) (y : S) :
    ∃ n > 0, algebraMap S q.ResidueField y ^ n ∈
      (Ideal.ResidueField.map p q f hpq).fieldRange := by
  obtain ⟨n, hn, c, hc⟩ := H y
  refine ⟨n, hn, algebraMap R p.ResidueField c, ?_⟩
  rw [Ideal.ResidueField.map_algebraMap, hc, map_pow]

/-- Let `f : R →+* S` be a ring map such that every element of `S` has a positive power in the
image of `f`, let `q` be a prime of `S` and let `p = f⁻¹(q)`. Then every element of the residue
field `κ(q)` has a positive power in the image of the canonical embedding `κ(p) → κ(q)`; that is,
the induced residue field extensions satisfy the equivalent conditions of
`forall_exists_pow_mem_iff_isPurelyInseparable_or_isAlgebraic_bot`. -/
@[stacks 0BR8 "The residue field extensions."]
public theorem Ideal.ResidueField.exists_pow_mem_range_map {R S : Type*} [CommRing R] [CommRing S]
    {f : R →+* S} (H : ∀ x : S, ∃ n > 0, x ^ n ∈ f.range) (p : Ideal R) [p.IsPrime] (q : Ideal S)
    [q.IsPrime] (hpq : p = q.comap f) (x : q.ResidueField) :
    ∃ n > 0, x ^ n ∈ (Ideal.ResidueField.map p q f hpq).range := by
  obtain ⟨y, z, -, rfl⟩ := Ideal.exists_div_algebraMap_residueField_eq q x
  have h := Ideal.ResidueField.exists_pow_algebraMap_mem_fieldRange_map H p q hpq
  obtain ⟨n, hn, hmem⟩ := Subfield.exists_pow_mem_div (h y) (h z)
  exact ⟨n, hn, RingHom.mem_range.mpr (RingHom.mem_fieldRange.mp hmem)⟩

section

open TensorProduct

/-- Two ring maps out of a field `F` to nonzero rings `A`, `B` can be completed to a commutative
square of rings by a field: there are a field `L` and ring maps `i₁ : A →+* L`, `i₂ : B →+* L` with
`i₁ ∘ φ₁ = i₂ ∘ φ₂`. Take for `L` the residue field of a maximal ideal of `A ⊗_F B`, which is
nonzero because `A` is flat over the field `F`. -/
private theorem exists_ringHom_comp_eq {F : Type*} {A B : Type v} [Field F] [CommRing A]
    [CommRing B] [Nontrivial A] [Nontrivial B] (φ₁ : F →+* A) (φ₂ : F →+* B) :
    ∃ (L : Type v) (_ : Field L) (i₁ : A →+* L) (i₂ : B →+* L), i₁.comp φ₁ = i₂.comp φ₂ := by
  algebraize [φ₁, φ₂]
  have : Nontrivial (A ⊗[F] B) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_left F A B φ₂.injective
  obtain ⟨n, hn⟩ := Ideal.exists_maximal (A ⊗[F] B)
  have := hn.isPrime
  refine ⟨n.ResidueField, inferInstance,
    (algebraMap (A ⊗[F] B) n.ResidueField).comp
      (Algebra.TensorProduct.includeLeftRingHom (R := F) (B := B)),
    (algebraMap (A ⊗[F] B) n.ResidueField).comp
      (Algebra.TensorProduct.includeRight (R := F) (A := A)).toRingHom, RingHom.ext fun x ↦ ?_⟩
  simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
    ← RingHom.algebraMap_toAlgebra φ₁, ← RingHom.algebraMap_toAlgebra φ₂,
    Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.includeRight_apply,
    Algebra.TensorProduct.tmul_one_eq_one_tmul]

/-- The field-valued point of `S` given by a prime `q` and an embedding of its residue field into a
nonzero ring has kernel `q`, a ring map out of the field `κ(q)` being injective. -/
private lemma ker_comp_algebraMap_residueField {S L : Type*} [CommRing S] [CommRing L]
    [Nontrivial L] (q : Ideal S) [q.IsPrime] (i : q.ResidueField →+* L) :
    RingHom.ker (i.comp (algebraMap S q.ResidueField)) = q := by
  rw [← RingHom.comap_ker, (RingHom.injective_iff_ker_eq_bot i).mp i.injective,
    ← RingHom.ker_eq_comap_bot, Ideal.ker_algebraMap_residueField]

/-- Conversely a ring map `g : S →+* K` to a field factors through the residue field of any prime
equal to its kernel, `κ(q)` being the fraction field of `S ⧸ q`. -/
private lemma exists_comp_eq_of_ker_eq {S K : Type*} [CommRing S] [Field K] (g : S →+* K)
    (q : Ideal S) [q.IsPrime] (hq : RingHom.ker g = q) :
    ∃ σ : q.ResidueField →+* K, σ.comp (algebraMap S q.ResidueField) = g := by
  have hu : q.primeCompl ≤ (IsUnit.submonoid K).comap g := fun x hx ↦
    isUnit_iff_ne_zero.mpr fun h ↦ hx (hq ▸ RingHom.mem_ker.mpr h)
  exact ⟨Ideal.ResidueField.lift q g hq.ge hu, RingHom.ext fun x ↦ by simp⟩

/-- If `R → S` induces purely inseparable residue field extensions, a ring map from `S` to a field
is determined by its kernel together with its restriction to `R`: two such maps factor through the
residue field of their common kernel `𝔮`, the two factorisations agree on `κ(𝔭)`, and `κ(𝔭) → κ(𝔮)`
is purely inseparable. -/
private theorem eq_of_ker_eq {R S K : Type*} [CommRing R] [CommRing S] [Algebra R S] [Field K]
    (hins : ∀ (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
      (hpq : p = q.comap (algebraMap R S)),
      (Ideal.ResidueField.map p q (algebraMap R S) hpq).IsPurelyInseparable)
    {g₁ g₂ : S →+* K} (hker : RingHom.ker g₁ = RingHom.ker g₂)
    (hg : g₁.comp (algebraMap R S) = g₂.comp (algebraMap R S)) : g₁ = g₂ := by
  have : (RingHom.ker g₁).IsPrime := RingHom.ker_isPrime g₁
  set q := RingHom.ker g₁
  set p := q.comap (algebraMap R S)
  obtain ⟨σ₁, hσ₁⟩ := exists_comp_eq_of_ker_eq g₁ q rfl
  obtain ⟨σ₂, hσ₂⟩ := exists_comp_eq_of_ker_eq g₂ q hker.symm
  algebraize [Ideal.ResidueField.map p q (algebraMap R S) rfl]
  have : IsPurelyInseparable p.ResidueField q.ResidueField := hins p q rfl
  have key : σ₁.comp (Ideal.ResidueField.map p q (algebraMap R S) rfl)
      = σ₂.comp (Ideal.ResidueField.map p q (algebraMap R S) rfl) := by
    ext r
    simp only [RingHom.comp_apply, Ideal.ResidueField.map_algebraMap]
    exact (RingHom.congr_fun hσ₁ _).trans
      ((RingHom.congr_fun hg r).trans (RingHom.congr_fun hσ₂ _).symm)
  rw [← hσ₁, ← hσ₂, IsPurelyInseparable.injective_comp_algebraMap p.ResidueField q.ResidueField K
    key]

/-- If `R → S` induces an injective map of spectra and purely inseparable residue field extensions,
then for every field `K` precomposition with `R → S` is injective on ring maps to `K`: injectivity
on spectra makes the kernels of two such maps agree, since their contractions to `R` do. -/
@[ega "I 3.5.8" "Affine case, sufficiency"]
private theorem injective_comp_algebraMap_of_injective_comap
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (hinj : Function.Injective (PrimeSpectrum.comap (algebraMap R S)))
    (hins : ∀ (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
      (hpq : p = q.comap (algebraMap R S)),
      (Ideal.ResidueField.map p q (algebraMap R S) hpq).IsPurelyInseparable)
    (K : Type*) [Field K] :
    Function.Injective fun g : S →+* K ↦ g.comp (algebraMap R S) := by
  intro g₁ g₂ hg
  replace hg : g₁.comp (algebraMap R S) = g₂.comp (algebraMap R S) := hg
  refine eq_of_ker_eq hins (congrArg PrimeSpectrum.asIdeal
    (hinj (a₁ := ⟨_, RingHom.ker_isPrime g₁⟩) (a₂ := ⟨_, RingHom.ker_isPrime g₂⟩)
      (PrimeSpectrum.ext ?_))) hg
  change Ideal.comap (algebraMap R S) (RingHom.ker g₁)
    = Ideal.comap (algebraMap R S) (RingHom.ker g₂)
  rw [RingHom.comap_ker, RingHom.comap_ker, hg]

/-- The criterion by field-valued points is stable under base change: it is the universal property
of the pushout square `R → S`, `R' → S'`. -/
private theorem injective_comp_algebraMap_of_isPushout {R S R' S' : Type*} [CommRing R]
    [CommRing S] [CommRing R'] [CommRing S'] [Algebra R S] [Algebra R R'] [Algebra R S']
    [Algebra S S'] [Algebra R' S'] [IsScalarTower R S S'] [IsScalarTower R R' S']
    [Algebra.IsPushout R S R' S'] {K : Type*} [CommRing K]
    (h : Function.Injective fun g : S →+* K ↦ g.comp (algebraMap R S)) :
    Function.Injective fun g : S' →+* K ↦ g.comp (algebraMap R' S') := by
  intro g₁ g₂ hg
  replace hg : g₁.comp (algebraMap R' S') = g₂.comp (algebraMap R' S') := hg
  have hR : g₁.comp (algebraMap R S') = g₂.comp (algebraMap R S') := by
    rw [IsScalarTower.algebraMap_eq R R' S', ← RingHom.comp_assoc, ← RingHom.comp_assoc, hg]
  have hS : g₁.comp (algebraMap S S') = g₂.comp (algebraMap S S') :=
    h (a₁ := g₁.comp (algebraMap S S')) (a₂ := g₂.comp (algebraMap S S'))
      (by simp only [RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq R S S', hR])
  let _ : Algebra R K := (g₁.comp (algebraMap R S')).toAlgebra
  let G₁ : S' →ₐ[R] K := { toRingHom := g₁, commutes' := fun _ ↦ rfl }
  let G₂ : S' →ₐ[R] K := { toRingHom := g₂, commutes' := fun r ↦ (RingHom.congr_fun hR r).symm }
  exact congrArg AlgHom.toRingHom (Algebra.IsPushout.algHom_ext (R := R) (S := S) (R' := R') S'
    (f := G₁) (g := G₂) (AlgHom.ext fun r ↦ RingHom.congr_fun hg r)
    (AlgHom.ext fun s ↦ RingHom.congr_fun hS s))

/-- If precomposition with `R → S` is injective on ring maps to any field, then `R → S` induces an
injective map of spectra: two primes with the same contraction to `R` give two field-valued points
of `S` agreeing on `R`, with those primes as their kernels. -/
private theorem injective_comap_of_injective_comp_algebraMap
    {R : Type*} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (h : ∀ (K : Type v) [Field K], Function.Injective fun g : S →+* K ↦ g.comp (algebraMap R S)) :
    Function.Injective (PrimeSpectrum.comap (algebraMap R S)) := by
  intro q₁ q₂ hq
  have hp : q₁.asIdeal.comap (algebraMap R S) = q₂.asIdeal.comap (algebraMap R S) :=
    congrArg PrimeSpectrum.asIdeal hq
  obtain ⟨L, _, i₁, i₂, hi⟩ := exists_ringHom_comp_eq
    (Ideal.ResidueField.map _ q₁.asIdeal (algebraMap R S) hp.symm)
    (Ideal.ResidueField.map _ q₂.asIdeal (algebraMap R S) rfl)
  have key : i₁.comp (algebraMap S q₁.asIdeal.ResidueField)
      = i₂.comp (algebraMap S q₂.asIdeal.ResidueField) := by
    refine h L (RingHom.ext fun r ↦ ?_)
    simpa only [RingHom.comp_apply, Ideal.ResidueField.map_algebraMap] using
      RingHom.congr_fun hi (algebraMap R (q₂.asIdeal.comap (algebraMap R S)).ResidueField r)
  refine PrimeSpectrum.ext ?_
  rw [← ker_comp_algebraMap_residueField _ i₁, ← ker_comp_algebraMap_residueField _ i₂, key]

/-- If precomposition with `R → S` is injective on ring maps to any field, then `R → S` induces
purely inseparable residue field extensions: a pair of embeddings of `κ(𝔮)` into an algebraic
closure over `κ(𝔭)` is a pair of field-valued points of `S` agreeing on `R`. -/
@[ega "I 3.5.8" "Affine case"]
private theorem isPurelyInseparable_residueFieldMap_of_injective_comp_algebraMap
    {R : Type*} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    (h : ∀ (K : Type v) [Field K], Function.Injective fun g : S →+* K ↦ g.comp (algebraMap R S))
    (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
    (hpq : p = q.comap (algebraMap R S)) :
    (Ideal.ResidueField.map p q (algebraMap R S) hpq).IsPurelyInseparable := by
  algebraize [Ideal.ResidueField.map p q (algebraMap R S) hpq]
  have : Nonempty (q.ResidueField →+* AlgebraicClosure q.ResidueField) := ⟨algebraMap _ _⟩
  refine IsPurelyInseparable.of_injective_comp_algebraMap p.ResidueField q.ResidueField
    (AlgebraicClosure q.ResidueField) fun f₁ f₂ hf ↦ Ideal.ResidueField.ringHom_ext
      (h _ (RingHom.ext fun x ↦ ?_))
  simp only [RingHom.comp_apply, ← Ideal.ResidueField.map_algebraMap p q (algebraMap R S) hpq x]
  exact RingHom.congr_fun hf _

/-- Let `R → S` be a ring map which induces an injective map of spectra and purely inseparable
residue field extensions, and let `S'` be the base change of `S` along an arbitrary ring map
`R → R'`, i.e. `R'`, `S'` complete `R`, `S` to a pushout square of `R`-algebras. Then `R' → S'`
also induces an injective map of spectra and purely inseparable residue field extensions. -/
@[stacks 0BRB]
public theorem Algebra.IsPushout.injective_comap_and_residueFieldMap_isPurelyInseparable
    {R S R' S' : Type*} [CommRing R] [CommRing S] [CommRing R'] [CommRing S'] [Algebra R S]
    [Algebra R R'] [Algebra R S'] [Algebra S S'] [Algebra R' S'] [IsScalarTower R S S']
    [IsScalarTower R R' S'] [IsPushout R S R' S']
    (hinj : Function.Injective (PrimeSpectrum.comap (algebraMap R S)))
    (hins : ∀ (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
      (hpq : p = q.comap (algebraMap R S)),
      (Ideal.ResidueField.map p q (algebraMap R S) hpq).IsPurelyInseparable) :
    Function.Injective (PrimeSpectrum.comap (algebraMap R' S')) ∧
      ∀ (p' : Ideal R') [p'.IsPrime] (q' : Ideal S') [q'.IsPrime]
        (hpq : p' = q'.comap (algebraMap R' S')),
        (Ideal.ResidueField.map p' q' (algebraMap R' S') hpq).IsPurelyInseparable := by
  refine ⟨injective_comap_of_injective_comp_algebraMap fun K _ ↦ ?_,
    fun p' _ q' _ hpq ↦
      isPurelyInseparable_residueFieldMap_of_injective_comp_algebraMap (fun K _ ↦ ?_) p' q' hpq⟩ <;>
    exact injective_comp_algebraMap_of_isPushout
      (injective_comp_algebraMap_of_injective_comap hinj hins K)

end

namespace PrimeSpectrum

/-- An integral ring map `f : R → S` whose induced map of spectra is injective induces a
homeomorphism from `Spec(S)` onto a closed subset of `Spec(R)`. -/
@[stacks 0BRC]
public theorem isClosedEmbedding_comap_of_isIntegral {R : Type u} {S : Type v} [CommRing R]
    [CommRing S] (f : R →+* S) (hf : f.IsIntegral) (hinj : Function.Injective (comap f)) :
    Topology.IsClosedEmbedding (comap f) :=
  .of_continuous_injective_isClosedMap (continuous_comap f) hinj
    (isClosedMap_comap_of_isIntegral f hf)

/-- Let `R → S` be an integral ring map which induces an injective map of spectra and purely
inseparable residue field extensions. Then `Spec(S) → Spec(R)` is a homeomorphism onto a closed
subset of `Spec(R)`, and for every base change `R' → S'` of `R → S` along an arbitrary ring map
`R → R'`, i.e. for every pushout square of `R`-algebras completing `R`, `S` by `R'`, `S'`, the
map `R' → S'` is again integral and again induces an injective map of spectra and purely
inseparable residue field extensions. -/
@[stacks 0BRC]
public theorem isClosedEmbedding_comap_and_baseChange_of_injective_comap_of_isPurelyInseparable
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S]
    (hinj : Function.Injective (comap (algebraMap R S)))
    (hins : ∀ (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
      (hpq : p = q.comap (algebraMap R S)),
      (Ideal.ResidueField.map p q (algebraMap R S) hpq).IsPurelyInseparable) :
    Topology.IsClosedEmbedding (comap (algebraMap R S)) ∧
      ∀ (R' : Type u') (S' : Type v') [CommRing R'] [CommRing S'] [Algebra R R'] [Algebra S S']
        [Algebra R' S'] [Algebra R S'] [IsScalarTower R R' S'] [IsScalarTower R S S']
        [Algebra.IsPushout R S R' S'],
        Algebra.IsIntegral R' S' ∧ Function.Injective (comap (algebraMap R' S')) ∧
          ∀ (p' : Ideal R') [p'.IsPrime] (q' : Ideal S') [q'.IsPrime]
            (hpq : p' = q'.comap (algebraMap R' S')),
            (Ideal.ResidueField.map p' q' (algebraMap R' S') hpq).IsPurelyInseparable :=
  ⟨isClosedEmbedding_comap_of_isIntegral _ (algebraMap_isIntegral_iff.mpr ‹_›) hinj,
    fun R' S' _ _ _ _ _ _ _ _ _ =>
      ⟨Algebra.IsPushout.isIntegral R R' S S',
        Algebra.IsPushout.injective_comap_and_residueFieldMap_isPurelyInseparable hinj hins⟩⟩

end PrimeSpectrum

section

open TensorProduct

/-- Extending the base field of a nonzero fibre ring keeps it nonzero: if `K ⊗[R] S` is nonzero
for a field `K`, then so is `L ⊗[R] S` for every nonzero `K`-algebra `L`. -/
private theorem nontrivial_tensorProduct_of_isScalarTower {R S K L : Type*} [CommRing R]
    [CommRing S] [Field K] [CommRing L] [Algebra R S] [Algebra R K] [Algebra R L] [Algebra K L]
    [IsScalarTower R K L] [Nontrivial L] (h : Nontrivial (K ⊗[R] S)) : Nontrivial (L ⊗[R] S) := by
  have : Nontrivial (L ⊗[K] (K ⊗[R] S)) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_left
      (R := K) (A := L) (B := K ⊗[R] S) (algebraMap K _).injective
  exact (Algebra.TensorProduct.cancelBaseChange R K K L S).injective.nontrivial

/-- The fibre ring of a base change is the base change of the fibre ring: for a pushout square
`R → S`, `R' → S'` and an `R'`-algebra `T`, the ring `T ⊗[R'] S'` is nonzero as soon as `T ⊗[R] S`
is. -/
private theorem nontrivial_tensorProduct_of_isPushout {R S R' S' : Type*} [CommRing R] [CommRing S]
    [CommRing R'] [CommRing S'] [Algebra R S] [Algebra R R'] [Algebra S S'] [Algebra R' S']
    [Algebra R S'] [IsScalarTower R R' S'] [IsScalarTower R S S'] [Algebra.IsPushout R S R' S']
    {T : Type*} [CommRing T] [Algebra R T] [Algebra R' T] [IsScalarTower R R' T]
    (h : Nontrivial (T ⊗[R] S)) : Nontrivial (T ⊗[R'] S') := by
  have : Nontrivial (S ⊗[R] T) := (Algebra.TensorProduct.comm R T S).injective.nontrivial
  have : Nontrivial (S' ⊗[R'] T) :=
    (Algebra.IsPushout.cancelBaseChangeAlg R S R' S' T).symm.injective.nontrivial
  exact (Algebra.TensorProduct.comm R' S' T).injective.nontrivial

/-- Surjectivity of the map of spectra is stable under base change: this is the second half of
Stacks Tag 00FI, for an arbitrary pushout square `R → S`, `R' → S'` of algebras. -/
private theorem surjective_comap_of_isPushout {R S R' S' : Type*}
    [CommRing R] [CommRing S] [CommRing R'] [CommRing S'] [Algebra R S] [Algebra R R']
    [Algebra S S'] [Algebra R' S'] [Algebra R S'] [IsScalarTower R R' S'] [IsScalarTower R S S']
    [Algebra.IsPushout R S R' S']
    (h : Function.Surjective (PrimeSpectrum.comap (algebraMap R S))) :
    Function.Surjective (PrimeSpectrum.comap (algebraMap R' S')) := by
  intro p'
  rw [← Set.mem_range, ← PrimeSpectrum.nontrivial_iff_mem_rangeComap]
  set p : Ideal R := p'.asIdeal.comap (algebraMap R R')
  let _ : Algebra p.ResidueField p'.asIdeal.ResidueField :=
    (Ideal.ResidueField.map p p'.asIdeal (algebraMap R R') rfl).toAlgebra
  have : IsScalarTower R p.ResidueField p'.asIdeal.ResidueField :=
    .of_algebraMap_eq fun x => by
      rw [RingHom.algebraMap_toAlgebra, Ideal.ResidueField.map_algebraMap,
        ← IsScalarTower.algebraMap_apply]
  have hp : Nontrivial (p.ResidueField ⊗[R] S) :=
    (PrimeSpectrum.nontrivial_iff_mem_rangeComap (⟨p, inferInstance⟩ : PrimeSpectrum R)).mpr (h _)
  exact nontrivial_tensorProduct_of_isPushout (nontrivial_tensorProduct_of_isScalarTower hp)

end

namespace PrimeSpectrum

/-- Let `R → S` be an integral ring map which induces a bijective map of spectra and purely
inseparable residue field extensions. Then `Spec(S) → Spec(R)` is a homeomorphism, and for every
base change `R' → S'` of `R → S` along an arbitrary ring map `R → R'`, i.e. for every pushout
square of `R`-algebras completing `R`, `S` by `R'`, `S'`, the map `R' → S'` is again integral and
again induces a bijective map of spectra and purely inseparable residue field extensions. -/
@[stacks 0BRD, ega "IV 2.4.5" "(i), affine case", ega "0 23.2.2" "more general"]
public theorem isHomeomorph_comap_and_baseChange_of_bijective_comap_of_isPurelyInseparable
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S]
    (hbij : Function.Bijective (comap (algebraMap R S)))
    (hins : ∀ (p : Ideal R) [p.IsPrime] (q : Ideal S) [q.IsPrime]
      (hpq : p = q.comap (algebraMap R S)),
      (Ideal.ResidueField.map p q (algebraMap R S) hpq).IsPurelyInseparable) :
    IsHomeomorph (comap (algebraMap R S)) ∧
      ∀ (R' : Type u') (S' : Type v') [CommRing R'] [CommRing S'] [Algebra R R'] [Algebra S S']
        [Algebra R' S'] [Algebra R S'] [IsScalarTower R R' S'] [IsScalarTower R S S']
        [Algebra.IsPushout R S R' S'],
        Algebra.IsIntegral R' S' ∧ Function.Bijective (comap (algebraMap R' S')) ∧
          ∀ (p' : Ideal R') [p'.IsPrime] (q' : Ideal S') [q'.IsPrime]
            (hpq : p' = q'.comap (algebraMap R' S')),
            (Ideal.ResidueField.map p' q' (algebraMap R' S') hpq).IsPurelyInseparable := by
  obtain ⟨hce, hbc⟩ :=
    PrimeSpectrum.isClosedEmbedding_comap_and_baseChange_of_injective_comap_of_isPurelyInseparable
      (R := R) (S := S) hbij.injective hins
  refine ⟨isHomeomorph_iff_isEmbedding_surjective.mpr ⟨hce.isEmbedding, hbij.surjective⟩,
    fun R' S' _ _ _ _ _ _ _ _ _ => ?_⟩
  obtain ⟨hint, hinj, hpi⟩ := hbc R' S'
  exact ⟨hint, ⟨hinj, surjective_comap_of_isPushout hbij.surjective⟩, hpi⟩

end PrimeSpectrum
