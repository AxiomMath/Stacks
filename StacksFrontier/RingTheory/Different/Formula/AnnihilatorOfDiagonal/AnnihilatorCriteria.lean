module

public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal.KoszulResolution
public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal.ScalarExtensionComparison

/-!
# Algebraic criteria for the annihilator of the diagonal ideal

Let `B = P/(f_1, …, f_n)` and let `g_1, …, g_n` generate the kernel of `P ⊗_A B → B`, with
`f_i ⊗ 1 = ∑_j g_{ij} g_j`. This file proves the algebraic steps identifying the annihilator of
`I = Ker(B ⊗_A B → B)`: the image of `det(g_{ij})` lies in the annihilator, the annihilator is
computed by a colon ideal upstairs, a principal annihilator is free on its generator when
multiplication by it is injective, the case of one equation, and the reduction of the general case
to injectivity and surjectivity of the top-degree comparison map of Koszul complexes after
tensoring with `B`.

These are part of the proof in
`StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal`.

## References

* [Mazur--Roberts, Appendix]
* [Stacks Project, Tag 0BWC](https://stacks.math.columbia.edu/tag/0BWC)
-/

@[expose] public section

open scoped TensorProduct
open scoped Matrix

universe u v w

namespace Stacks.Discriminant

open CategoryTheory

/-- The adjugate identity puts each product of a generator with the determinant
in the ideal of the original relations. -/
private theorem det_mul_mem_span {R : Type*} [CommRing R] {n : ℕ}
    (f g : Fin n → R) (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, f i = ∑ j, M i j * g j) (j : Fin n) :
    M.det * g j ∈ Ideal.span (Set.range f) := by
  have hf : M *ᵥ g = f := funext fun i => (h i).symm
  have hj := congrFun (congrArg (fun v => M.adjugate *ᵥ v) hf) j
  rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec,
    Pi.smul_apply, smul_eq_mul] at hj
  rw [hj]
  show (∑ i, M.adjugate j i * f i) ∈ Ideal.span (Set.range f)
  exact Submodule.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The determinant annihilates the image of every diagonal generator after
the original relations are killed. -/
private theorem map_det_mul_map_g_eq_zero
    {R S : Type*} [CommRing R] [CommRing S] {n : ℕ}
    (f g : Fin n → R) (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, f i = ∑ j, M i j * g j)
    (φ : R →+* S) (hf : ∀ i, φ (f i) = 0) (j : Fin n) :
    φ M.det * φ (g j) = 0 := by
  rw [← map_mul, ← RingHom.mem_ker]
  refine Ideal.span_le.2 ?_ (det_mul_mem_span f g M h j)
  rintro _ ⟨i, rfl⟩
  exact hf i

/-- If `φ` is surjective and kills every `f i`, and the kernel of `ψ ∘ φ` is generated by the
`g j`, then `φ (det M)` generates an ideal contained in the annihilator of the kernel of `ψ`. -/
private theorem span_map_det_le_annihilator_ker
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] {n : ℕ}
    (f g : Fin n → R) (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, f i = ∑ j, M i j * g j)
    (φ : R →+* S) (ψ : S →+* T)
    (hφ : Function.Surjective φ) (hf : ∀ i, φ (f i) = 0)
    (hker : RingHom.ker (ψ.comp φ) = Ideal.span (Set.range g)) :
    Ideal.span {φ M.det} ≤ (RingHom.ker ψ).annihilator := by
  rw [Ideal.span_le]
  rintro x (rfl : x = φ M.det)
  have hker' : RingHom.ker ψ = (Ideal.span (Set.range g)).map φ := by
    rw [← hker, ← RingHom.comap_ker, Ideal.map_comap_of_surjective φ hφ]
  rw [hker', Ideal.map_span]
  refine (Submodule.mem_annihilator_span _ _).mpr ?_
  rintro ⟨y, ⟨_, ⟨j, rfl⟩, rfl⟩⟩
  exact map_det_mul_map_g_eq_zero f g M h φ hf j

/-- Pulling the annihilator of a quotient kernel back along a surjection gives
the colon of the two kernels. -/
private theorem annihilator_ker_eq_map_colon
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    (φ : R →+* S) (ψ : S →+* T) (hφ : Function.Surjective φ) :
    (RingHom.ker ψ).annihilator =
      ((RingHom.ker φ).colon (RingHom.ker (ψ.comp φ) : Set R)).map φ := by
  have hcomap : ((RingHom.ker ψ).annihilator).comap φ =
      (RingHom.ker φ).colon (RingHom.ker (ψ.comp φ) : Set R) := by
    ext x
    show φ x ∈ (RingHom.ker ψ).annihilator ↔
      x ∈ (RingHom.ker φ).colon (RingHom.ker (ψ.comp φ) : Set R)
    constructor
    · refine fun hx => Submodule.mem_colon.mpr fun z hz => RingHom.mem_ker.mpr ?_
      simpa only [map_mul, smul_eq_mul] using
        (Submodule.mem_annihilator.mp hx) (φ z) hz
    · refine fun hx => Submodule.mem_annihilator.mpr fun y hy => ?_
      obtain ⟨z, rfl⟩ := hφ y
      simpa only [map_mul, smul_eq_mul] using RingHom.mem_ker.mp
        (Submodule.mem_colon.mp hx z hy)
  rw [← hcomap, Ideal.map_comap_of_surjective φ hφ]

/-- A principal annihilator is free on its generator when multiplication by that
generator is injective on the quotient ring. -/
theorem linearEquiv_annihilator_of_principal
    {C S : Type*} [CommRing C] [CommRing S] [Algebra C S]
    (ψ : S →+* C) (hψ : ∀ c : C, ψ (algebraMap C S c) = c)
    (z : S) (hz : z ∈ (RingHom.ker ψ).annihilator)
    (hspan : (RingHom.ker ψ).annihilator = Ideal.span {z})
    (hreg : ∀ c : C, c • z = 0 → c = 0) :
    ∃ e : C ≃ₗ[C] (RingHom.ker ψ).annihilator,
      ∀ c, (e c : S) = c • z := by
  let m : C →ₗ[C] (RingHom.ker ψ).annihilator :=
    { toFun := fun c => ⟨c • z, by
          simpa [Algebra.smul_def] using
            (RingHom.ker ψ).annihilator.smul_mem (algebraMap C S c) hz⟩
      map_add' x y := Subtype.ext (add_smul x y z)
      map_smul' x y := Subtype.ext (smul_smul x y z).symm }
  have hm : Function.Bijective m := by
    constructor
    · refine fun x y hxy => eq_of_sub_eq_zero (hreg _ ?_)
      rw [sub_smul]
      exact sub_eq_zero.mpr (congrArg Subtype.val hxy)
    · intro x
      have hx : (x : S) ∈ Ideal.span {z} := hspan ▸ x.property
      obtain ⟨s, hs⟩ := Ideal.mem_span_singleton.mp hx
      have hdiff : s - algebraMap C S (ψ s) ∈ RingHom.ker ψ :=
        RingHom.mem_ker.mpr (by simp [hψ])
      have hzero := (Submodule.mem_annihilator.mp hz) _ hdiff
      have h : z * s = z * algebraMap C S (ψ s) :=
        sub_eq_zero.mp (by simpa only [smul_eq_mul, mul_sub] using hzero)
      refine ⟨ψ s, Subtype.ext ?_⟩
      show ψ s • z = (x : S)
      rw [hs, Algebra.smul_def, mul_comm, ← h]
  exact ⟨LinearEquiv.ofBijective m hm, fun c => rfl⟩

/-- Tate's determinant comparison for one equation, stated for two successive
surjective quotient maps. -/
theorem linearEquiv_annihilator_rank_one
    {R S C : Type*} [CommRing R] [CommRing S] [CommRing C] [Algebra C S]
    (f g a : R) (hfg : f = a * g)
    (hf : IsSMulRegular R f) (hg : IsSMulRegular R g)
    (φ : R →+* S) (ψ : S →+* C) (hφ : Function.Surjective φ)
    (hψ : ∀ c : C, ψ (algebraMap C S c) = c)
    (hkerφ : RingHom.ker φ = Ideal.span {f})
    (hkercomp : RingHom.ker (ψ.comp φ) = Ideal.span {g}) :
    ∃ e : C ≃ₗ[C] (RingHom.ker ψ).annihilator,
      ∀ c, (e c : S) = c • φ a := by
  have ha : IsSMulRegular R a := by
    rw [isSMulRegular_iff_right_eq_zero_of_smul]
    intro x hx
    apply (isSMulRegular_iff_right_eq_zero_of_smul.mp hf) x
    simpa [hfg, smul_eq_mul, mul_assoc, mul_comm, mul_left_comm] using
      congrArg (fun t => t * g) hx
  have hcol : (Ideal.span {f}).colon (Ideal.span {g} : Set R) =
      Ideal.span {a} := by
    rw [Ideal.colon_span, hfg]
    exact principal_colon_of_regular a g hg
  have hz : φ a ∈ (RingHom.ker ψ).annihilator := by
    have hspan : Ideal.span {φ a} ≤ (RingHom.ker ψ).annihilator := by
      have hh := span_map_det_le_annihilator_ker
        (fun _ : Fin 1 => f) (fun _ => g) (fun _ _ => a)
        (by intro i; fin_cases i; simp [hfg]) φ ψ hφ
        (by intro i; fin_cases i; rw [← RingHom.mem_ker, hkerφ];
            exact Ideal.subset_span (Set.mem_singleton f))
        (by simpa [Set.range_const] using hkercomp)
      have hdet : Matrix.det ((fun _ _ : Fin 1 => a) : Matrix (Fin 1) (Fin 1) R) = a :=
        Matrix.det_fin_one _
      simpa only [hdet] using hh
    simpa using hspan (Ideal.subset_span (Set.mem_singleton (φ a)))
  have hspan : (RingHom.ker ψ).annihilator = Ideal.span {φ a} := by
    rw [annihilator_ker_eq_map_colon φ ψ hφ, hkerφ, hkercomp, hcol,
      Ideal.map_span]
    simp
  have hreg : ∀ c : C, c • φ a = 0 → c = 0 := by
    intro c hc
    obtain ⟨x, hx⟩ := hφ (algebraMap C S c)
    have hxa : x * a ∈ Ideal.span {f} := by
      rw [← hkerφ, RingHom.mem_ker, map_mul, hx]
      simpa only [Algebra.smul_def] using hc
    have hxg : x ∈ Ideal.span {g} := by
      have hcol2 : (Ideal.span {f}).colon ({a} : Set R) = Ideal.span {g} := by
        rw [hfg, mul_comm a g]
        exact principal_colon_of_regular g a ha
      rw [← hcol2]
      exact (Submodule.mem_colon_singleton).2
        (by simpa only [smul_eq_mul, mul_comm] using hxa)
    have hxc : ψ (φ x) = 0 :=
      RingHom.mem_ker.mp (show x ∈ RingHom.ker (ψ.comp φ) from hkercomp ▸ hxg)
    rwa [hx, hψ] at hxc
  exact linearEquiv_annihilator_of_principal ψ hψ (φ a) hz hspan hreg

/-- Every top exterior vector of a finite free module is a scalar multiple of
the wedge of the standard basis. -/
private theorem exteriorPower_top_eq_smul {R : Type*} [CommRing R]
    (r : ℕ) (x : ⋀[R]^r (Fin r → R)) :
    ∃ a : R, x = a • exteriorPower.ιMulti R r (Pi.basisFun R (Fin r)) := by
  let b := Pi.basisFun R (Fin r)
  have hv (v : Fin r → (Fin r → R)) :
      exteriorPower.ιMulti R r v =
        b.det v • exteriorPower.ιMulti R r b := by
    simpa only [AlternatingMap.smulRight_apply] using congrArg
      (fun F : (Fin r → R) [⋀^Fin r]→ₗ[R] (⋀[R]^r (Fin r → R)) => F v)
      (alternatingMap_eq_basis_det_smulRight b (exteriorPower.ιMulti R r))
  have hspan : R ∙ exteriorPower.ιMulti R r b = ⊤ := by
    apply top_unique
    rw [← exteriorPower.ιMulti_span R r (Fin r → R)]
    apply Submodule.span_le.mpr
    rintro y ⟨v, rfl⟩
    rw [hv v]
    exact Submodule.smul_mem (R ∙ exteriorPower.ιMulti R r b)
      (b.det v) (Submodule.mem_span_singleton_self _)
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hspan.symm ▸
    (Submodule.mem_top : x ∈ (⊤ : Submodule R _)))
  exact ⟨a, ha.symm⟩

/-- The coefficient of the standard top wedge. -/
private noncomputable abbrev topExteriorCoefficient (R : Type*) [CommRing R] (n : ℕ) :
    (⋀[R]^n (Fin n → R)) →ₗ[R] R :=
  exteriorPower.alternatingMapLinearEquiv (Pi.basisFun R (Fin n)).det

private theorem topExteriorCoefficient_basis (R : Type*) [CommRing R] (n : ℕ) :
    topExteriorCoefficient R n (exteriorPower.ιMulti R n (Pi.basisFun R (Fin n))) = 1 := by
  rw [exteriorPower.alternatingMapLinearEquiv_apply_ιMulti, Module.Basis.det_self]

/-- The Koszul differential is linear in the entries of the sequence. -/
private theorem koszul_d_eq_sum {R : Type*} [CommRing R] {r : ℕ}
    (f : Fin r → R) (k : ℕ) (x : ⋀[R]^(k + 1) (Fin r → R)) :
    Koszul.d (Koszul.seqDual f) k x =
      ∑ i, f i • Koszul.d (LinearMap.proj i) k x := by
  apply Subtype.ext
  simp only [Koszul.d_apply_coe, Submodule.coe_sum, Submodule.coe_smul_of_tower]
  rw [Koszul.seqDual_eq_sum_smul_proj]
  simp [Koszul.contraction, map_sum, map_smul, LinearMap.sum_apply]

/-- A tensor with coefficients killed by a sequence kills its extended ideal. -/
private theorem tensor_smul_eq_zero_of_mem_span
    {P R N : Type*} [CommRing P] [CommRing R] [Algebra P R]
    [AddCommGroup N] [Module P N]
    {E : Type*} [AddCommGroup E] [Module R E] [Module P E] [IsScalarTower P R E]
    {ι : Type*} (f : ι → P) (b : N) (hb : ∀ i, f i • b = 0)
    {r : R} (hr : r ∈ Ideal.span (Set.range (fun i => algebraMap P R (f i))))
    (x : E) : b ⊗ₜ[P] (r • x) = 0 := by
  induction hr using Submodule.span_induction generalizing x with
  | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      rw [IsScalarTower.algebraMap_smul, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
        hb, TensorProduct.zero_tmul]
  | zero => simp
  | add a c ha hc ih₁ ih₂ => simp [add_smul, TensorProduct.tmul_add, ih₁, ih₂]
  | smul a c hc ih =>
      show b ⊗ₜ[P] ((a * c) • x) = 0
      rw [mul_comm a c, mul_smul]
      exact ih _

/-- The Koszul differential of a sequence `f` vanishes after tensoring with an algebra in which
every `f i` becomes zero. -/
theorem lTensor_koszul_d_eq_zero {P B : Type*} [CommRing P] [CommRing B] [Algebra P B]
    {r : ℕ} (f : Fin r → P) (hf : ∀ i, algebraMap P B (f i) = 0) (k : ℕ)
    (y : B ⊗[P] (⋀[P]^(k + 1) (Fin r → P))) :
    LinearMap.lTensor B (Koszul.d (Koszul.seqDual f) k) y = 0 := by
  induction y with
  | tmul b z =>
      rw [LinearMap.lTensor_tmul, koszul_d_eq_sum, TensorProduct.tmul_sum]
      refine Finset.sum_eq_zero fun i _ => tensor_smul_eq_zero_of_mem_span (R := P) f b
        (fun i => by rw [Algebra.smul_def, hf i, zero_mul]) (Ideal.subset_span ⟨i, rfl⟩) _
  | add x y hx hy => rw [map_add, hx, hy, add_zero]

/-- Every tensor in the top term of the first resolution has one coefficient. -/
private theorem tensor_top_eq_tmul
    {P N : Type*} [CommRing P] [AddCommGroup N] [Module P N]
    (n : ℕ) (x : N ⊗[P] (⋀[P]^n (Fin n → P))) :
    ∃ b : N, x = b ⊗ₜ[P] exteriorPower.ιMulti P n (Pi.basisFun P (Fin n)) := by
  induction x with
  | tmul b y =>
      obtain ⟨a, rfl⟩ := exteriorPower_top_eq_smul n y
      exact ⟨a • b, TensorProduct.tmul_smul _ _ _⟩
  | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, (TensorProduct.add_tmul _ _ _).symm⟩

/-- The algebraic interpretation of an injective top comparison which is
surjective onto cycles. -/
theorem annihilator_equiv_of_tensor_comparison
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Algebra P B] [IsScalarTower A P B]
    {n : ℕ} (f : Fin (n + 1) → P) (g : Fin (n + 1) → P ⊗[A] B)
    (gij : Matrix (Fin (n + 1)) (Fin (n + 1)) (P ⊗[A] B))
    (q : P →ₐ[A] B) (hPB : ∀ p, algebraMap P B p = q p)
    (hq : Function.Surjective q)
    (hkerq : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (hkerg : RingHom.ker
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom =
        Ideal.span (Set.range g))
    (hcoeff : ∀ i, f i ⊗ₜ[A] (1 : B) = ∑ j, gij i j * g j)
    (hinj : Function.Injective
      (LinearMap.lTensor B (coefficientBaseChangeLinearMap (P := P) gij (n + 1))))
    (hsurj : ∀ y : B ⊗[P] (⋀[P ⊗[A] B]^(n + 1) (Fin (n + 1) → P ⊗[A] B)),
      (LinearMap.lTensor B ((Koszul.d (Koszul.seqDual g) n).restrictScalars P)) y = 0 →
        ∃ x, (LinearMap.lTensor B (coefficientBaseChangeLinearMap (P := P) gij (n + 1))) x = y) :
    ∃ e : B ≃ₗ[B] (RingHom.ker
      (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B).toRingHom).annihilator,
      ∀ b, (e b : B ⊗[A] B) =
        b • Algebra.TensorProduct.map q (AlgHom.id A B) (Matrix.det gij) := by
  let φ : (P ⊗[A] B) →+* (B ⊗[A] B) := (Algebra.TensorProduct.map q (AlgHom.id A B)).toRingHom
  let ψ : (B ⊗[A] B) →+* B := (Algebra.TensorProduct.lmul' A).toRingHom
  let ωP := exteriorPower.ιMulti P (n + 1) (Pi.basisFun P (Fin (n + 1)))
  let ωR := exteriorPower.ιMulti (P ⊗[A] B) (n + 1) (Pi.basisFun (P ⊗[A] B) (Fin (n + 1)))
  let C := LinearMap.lTensor B (coefficientBaseChangeLinearMap (P := P) gij (n + 1))
  have hfq (i) : q (f i) = 0 := RingHom.mem_ker.mp
    (hkerq ▸ Ideal.subset_span (Set.mem_range_self i))
  have hφsurj : Function.Surjective φ :=
    Algebra.TensorProduct.map_surjective q (AlgHom.id A B) hq (fun b => ⟨b, rfl⟩)
  have hkerφ : RingHom.ker φ =
      Ideal.span (Set.range (fun i => algebraMap P (P ⊗[A] B) (f i))) := by
    show RingHom.ker (Algebra.TensorProduct.map q (AlgHom.id A B)) = _
    rw [Algebra.TensorProduct.rTensor_ker q hq]
    show Ideal.map Algebra.TensorProduct.includeLeft (RingHom.ker q.toRingHom) = _
    rw [hkerq, Ideal.map_span]
    congr 1
    ext x
    simp [Set.mem_image, Set.mem_range]
  have hcomp : ψ.comp φ =
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom := by
    refine RingHom.ext fun x => ?_
    induction x with
    | tmul p b => simp [φ, ψ, Algebra.TensorProduct.productLeftAlgHom,
        Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lift_tmul]
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  have hψ (b : B) : ψ (algebraMap B (B ⊗[A] B) b) = b := by
    simp [ψ, Algebra.TensorProduct.lmul'_apply_tmul]
  have hφf (i) : φ (f i ⊗ₜ[A] (1 : B)) = 0 := by
    simp [φ, hfq]
  have hz : φ gij.det ∈ (RingHom.ker ψ).annihilator :=
    span_map_det_le_annihilator_ker (fun i => f i ⊗ₜ[A] (1 : B)) g gij hcoeff
      φ ψ hφsurj hφf (hcomp ▸ hkerg) (Ideal.subset_span (Set.mem_singleton _))
  have hkill {r : (P ⊗[A] B)} (hr : φ r = 0) (b : B) {k : ℕ}
      (y : ⋀[(P ⊗[A] B)]^k (Fin (n + 1) → (P ⊗[A] B))) : b ⊗ₜ[P] (r • y) = 0 := by
    refine tensor_smul_eq_zero_of_mem_span f b (fun i => ?_) (hkerφ ▸ RingHom.mem_ker.mpr hr) y
    rw [Algebra.smul_def, hPB, hfq, zero_mul]
  let eBase := TensorProduct.AlgebraTensorModule.cancelBaseChange A P B B B
  have heBase (b : B) (r : (P ⊗[A] B)) : eBase (b ⊗ₜ[P] r) = b • φ r := by
    induction r with
    | tmul p c =>
        simp only [eBase, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
        simp [φ, Algebra.smul_def, hPB, Algebra.TensorProduct.tmul_mul_tmul, mul_comm]
    | add r s hr hs => simp [TensorProduct.tmul_add, hr, hs, smul_add]
  let ev : (B ⊗[P] (⋀[(P ⊗[A] B)]^(n + 1) (Fin (n + 1) → (P ⊗[A] B)))) →ₗ[P] (B ⊗[A] B) :=
    (eBase.toLinearMap.restrictScalars P).comp
      (LinearMap.lTensor B ((topExteriorCoefficient (P ⊗[A] B) (n + 1)).restrictScalars P))
  have hev (b : B) (r : (P ⊗[A] B)) : ev (b ⊗ₜ[P] (r • ωR)) = b • φ r := by
    simp only [ev, LinearMap.comp_apply, LinearMap.lTensor_tmul,
      LinearMap.restrictScalars_apply, map_smul, topExteriorCoefficient_basis,
      smul_eq_mul, mul_one, LinearEquiv.coe_coe, ωR]
    exact heBase b r
  have hC (b : B) : C (b ⊗ₜ[P] ωP) = b ⊗ₜ[P] (gij.det • ωR) := by
    rw [LinearMap.lTensor_tmul, coefficientBaseChangeLinearMap_top]
  have hspan : (RingHom.ker ψ).annihilator = Ideal.span {φ gij.det} := by
    apply le_antisymm
    · intro z hz'
      obtain ⟨r, rfl⟩ := hφsurj z
      have hrg (i) : φ (r * g i) = 0 := by
        rw [map_mul]
        exact Submodule.mem_annihilator.mp hz' (φ (g i))
          (RingHom.mem_ker.mpr (RingHom.mem_ker.mp
            (show g i ∈ RingHom.ker (ψ.comp φ) from
              (hcomp ▸ hkerg).symm ▸ Ideal.subset_span (Set.mem_range_self i))))
      have hcycle : (LinearMap.lTensor B
          ((Koszul.d (Koszul.seqDual g) n).restrictScalars P))
            ((1 : B) ⊗ₜ[P] (r • ωR)) = 0 := by
        simp only [LinearMap.lTensor_tmul, LinearMap.restrictScalars_apply, map_smul]
        rw [koszul_d_eq_sum, Finset.smul_sum, TensorProduct.tmul_sum]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [smul_smul]
        exact hkill (hrg i) 1 _
      obtain ⟨x, hx⟩ := hsurj _ hcycle
      obtain ⟨b, rfl⟩ := tensor_top_eq_tmul (n + 1) x
      have hval := congrArg ev hx
      change ev (C _) = _ at hval
      rw [hC, hev, hev, one_smul] at hval
      rw [← hval, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
    · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hz)
  have hreg (b : B) (hb : b • φ gij.det = 0) : b = 0 := by
    obtain ⟨p, rfl⟩ := hq b
    have hp : φ (algebraMap P (P ⊗[A] B) p * gij.det) = 0 := by
      simpa [φ, Algebra.smul_def] using hb
    have ht : C (q p ⊗ₜ[P] ωP) = 0 := by
      rw [hC, ← hPB p]
      have hpone : algebraMap P B p = p • (1 : B) := by simp [Algebra.smul_def]
      rw [hpone, ← TensorProduct.smul_tmul', ← TensorProduct.tmul_smul,
        ← IsScalarTower.algebraMap_smul (P ⊗[A] B) p, smul_smul]
      exact hkill hp 1 _
    have ht' := hinj (ht.trans (map_zero C).symm)
    let evP := (TensorProduct.rid P B).toLinearMap.comp
      (LinearMap.lTensor B (topExteriorCoefficient P (n + 1)))
    have hv := congrArg evP ht'
    simpa only [evP, LinearMap.comp_apply, LinearMap.lTensor_tmul, ωP,
      topExteriorCoefficient_basis, LinearEquiv.coe_coe, TensorProduct.rid_tmul,
      one_smul, map_zero] using hv
  exact linearEquiv_annihilator_of_principal ψ hψ (φ gij.det) hz hspan hreg

end Stacks.Discriminant
