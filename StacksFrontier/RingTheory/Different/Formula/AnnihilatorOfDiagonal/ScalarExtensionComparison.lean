module

public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal.KoszulResolution

/-!
# The comparison of Koszul complexes after scalar extension

Let `f_1, …, f_n ∈ P` and `g_1, …, g_n ∈ R` for a `P`-algebra `R`, with
`f_i = ∑_j g_{ij} g_j` in `R`. This file constructs the comparison map from the Koszul complex of
`f` to that of `g`, regarded over `P`, given by `(g_{ij})` in degree one and by `det(g_{ij})` in
top degree, also after lifting both complexes into one module universe. It also proves the
homological facts used to show that this comparison is a quasi-isomorphism: flatness and
vanishing of positive homology of universe-lifted Koszul complexes, the degree-zero description
of homology and its compatibility with exact additive functors, and preservation of Koszul
regularity under flat extension of scalars.

These are part of the proof in
`StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal` that the annihilator of the
diagonal ideal of a flat complete intersection is generated by the image of `det(g_{ij})`.

## References

* [Mazur--Roberts, Appendix]
* [Stacks Project, Tag 0BWC](https://stacks.math.columbia.edu/tag/0BWC)
-/

@[expose] public section

open scoped TensorProduct
open scoped Matrix

universe u v w

namespace Stacks.Discriminant

open CategoryTheory

/-- The degreewise scalar extension equivalence for the free Koszul modules. -/
noncomputable def exteriorBaseChangeEquiv
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (k : ℕ) :
    (R ⊗[P] (⋀[P]^k (Fin n → P))) ≃ₗ[R]
      (⋀[R]^k (Fin n → R)) :=
  (KoszulC.extPow_baseChange_natEquiv (R := P) (S := R) (r := n) k).choose

/-- The scalar extension map from a free Koszul term to its base change. -/
noncomputable def exteriorBaseChangeUnit
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (k : ℕ) :
    (⋀[P]^k (Fin n → P)) →ₗ[P] (⋀[R]^k (Fin n → R)) where
  toFun x := exteriorBaseChangeEquiv (P := P) (R := R) k (1 ⊗ₜ[P] x)
  map_add' x y := by
    change exteriorBaseChangeEquiv (P := P) (R := R) k (1 ⊗ₜ[P] (x + y)) =
      exteriorBaseChangeEquiv (P := P) (R := R) k (1 ⊗ₜ[P] x) +
      exteriorBaseChangeEquiv (P := P) (R := R) k (1 ⊗ₜ[P] y)
    rw [TensorProduct.tmul_add, map_add]
  map_smul' a x := by
    change exteriorBaseChangeEquiv (P := P) (R := R) k
      (1 ⊗ₜ[P] (a • x)) = a • exteriorBaseChangeEquiv (P := P) (R := R) k
      (1 ⊗ₜ[P] x)
    rw [TensorProduct.tmul_smul, ← IsScalarTower.algebraMap_smul R a (1 ⊗ₜ[P] x),
      ← IsScalarTower.algebraMap_smul R a
        (exteriorBaseChangeEquiv (P := P) (R := R) k (1 ⊗ₜ[P] x)), map_smul]

/-- Scalar extension carries the standard top exterior generator to the
standard top exterior generator. -/
private theorem exteriorBaseChangeUnit_top
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} :
    exteriorBaseChangeUnit (P := P) (R := R) n
        (exteriorPower.ιMulti P n (Pi.basisFun P (Fin n))) =
      exteriorPower.ιMulti R n (Pi.basisFun R (Fin n)) := by
  change (KoszulC.extPow_baseChange_natEquiv
    (R := P) (S := R) (r := n) n).choose
      (1 ⊗ₜ[P] exteriorPower.ιMulti P n (Pi.basisFun P (Fin n))) = _
  rw [(KoszulC.extPow_baseChange_natEquiv
    (R := P) (S := R) (r := n) n).choose_spec]
  congr 1
  funext i j
  simp [Pi.basisFun_apply, Pi.single_apply]

/-- The scalar extension maps intertwine the Koszul differentials. -/
private theorem exteriorBaseChangeUnit_d
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (f : Fin n → P) (k : ℕ)
    (x : ⋀[P]^(k + 1) (Fin n → P)) :
    exteriorBaseChangeUnit (P := P) (R := R) k
      (Koszul.d (Koszul.seqDual f) k x) =
      Koszul.d (Koszul.seqDual (fun i => algebraMap P R (f i))) k
        (exteriorBaseChangeUnit (P := P) (R := R) (k + 1) x) := by
  let β : ∀ j, (R ⊗[P] (⋀[P]^j (Fin n → P))) ≃ₗ[R]
      (⋀[R]^j (Fin n → R)) := fun j => exteriorBaseChangeEquiv j
  have hβ : ∀ j, ∀ v : Fin j → (Fin n → P),
      β j (1 ⊗ₜ[P] (exteriorPower.ιMulti P j v)) =
        exteriorPower.ιMulti R j
          (fun i => fun t => algebraMap P R (v i t)) := fun j v =>
    (KoszulC.extPow_baseChange_natEquiv (R := P) (S := R) (r := n) j).choose_spec v
  exact KoszulC.d_baseChange_comm f β hβ k x

/-- The coefficient comparison from the Koszul terms over `P` to those over `R`, as a `P`-linear
map. -/
noncomputable def coefficientBaseChangeLinearMap
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (M : Matrix (Fin n) (Fin n) R) (k : ℕ) :
    (⋀[P]^k (Fin n → P)) →ₗ[P] (⋀[R]^k (Fin n → R)) :=
  (exteriorPower.map k (coefficientLinearMap M)).restrictScalars P |>.comp
    (exteriorBaseChangeUnit k)

/-- The comparison intertwines the differentials over the base ring. -/
theorem coefficientBaseChangeLinearMap_d
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (f : Fin n → P) (g : Fin n → R)
    (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, algebraMap P R (f i) = ∑ j, M i j * g j)
    (k : ℕ) (x : ⋀[P]^(k + 1) (Fin n → P)) :
    coefficientBaseChangeLinearMap M k
      (Koszul.d (Koszul.seqDual f) k x) =
      Koszul.d (Koszul.seqDual g) k
        (coefficientBaseChangeLinearMap M (k + 1) x) := by
  change exteriorPower.map k (coefficientLinearMap M)
    (exteriorBaseChangeUnit k (Koszul.d (Koszul.seqDual f) k x)) =
      Koszul.d (Koszul.seqDual g) k
        (exteriorPower.map (k + 1) (coefficientLinearMap M)
          (exteriorBaseChangeUnit (k + 1) x))
  rw [exteriorBaseChangeUnit_d f k x]
  exact coefficientExteriorMap_comm (fun i => algebraMap P R (f i)) g M h k _

/-- In degree zero the comparison is extension of scalars on coefficients. -/
theorem coefficientBaseChangeLinearMap_zero
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (M : Matrix (Fin n) (Fin n) R)
    (x : ⋀[P]^0 (Fin n → P)) :
    exteriorPower.zeroEquiv R (Fin n → R)
        (coefficientBaseChangeLinearMap M 0 x) =
      algebraMap P R (exteriorPower.zeroEquiv P (Fin n → P) x) := by
  let bP : ⋀[P]^0 (Fin n → P) := exteriorPower.ιMulti P 0 (Fin.elim0)
  let bR : ⋀[R]^0 (Fin n → R) := exteriorPower.ιMulti R 0 (Fin.elim0)
  have hb : coefficientBaseChangeLinearMap M 0 bP = bR := by
    change exteriorPower.map 0 (coefficientLinearMap M)
      ((KoszulC.extPow_baseChange_natEquiv
        (R := P) (S := R) (r := n) 0).choose (1 ⊗ₜ[P] bP)) = bR
    rw [(KoszulC.extPow_baseChange_natEquiv
      (R := P) (S := R) (r := n) 0).choose_spec, exteriorPower.map_apply_ιMulti]
    congr 1
    funext i
    exact i.elim0
  have hx : x = (exteriorPower.zeroEquiv P (Fin n → P) x) • bP := by
    apply (exteriorPower.zeroEquiv P (Fin n → P)).injective
    simp [bP]
  rw [hx, map_smul, hb]
  change exteriorPower.zeroEquiv R (Fin n → R)
      ((exteriorPower.zeroEquiv P (Fin n → P) x) • bR) =
    algebraMap P R (exteriorPower.zeroEquiv P (Fin n → P)
      ((exteriorPower.zeroEquiv P (Fin n → P) x) • bP))
  rw [← IsScalarTower.algebraMap_smul R
    (exteriorPower.zeroEquiv P (Fin n → P) x) bR, map_smul, map_smul]
  simp [bR, bP]

/-- The scalar-extended comparison map is multiplication by the coefficient
determinant in top degree. -/
theorem coefficientBaseChangeLinearMap_top
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (M : Matrix (Fin n) (Fin n) R) :
    coefficientBaseChangeLinearMap (P := P) M n
        (exteriorPower.ιMulti P n (Pi.basisFun P (Fin n))) =
      M.det • exteriorPower.ιMulti R n (Pi.basisFun R (Fin n)) := by
  change exteriorPower.map n (coefficientLinearMap M)
    (exteriorBaseChangeUnit (P := P) (R := R) n
      (exteriorPower.ιMulti P n (Pi.basisFun P (Fin n)))) = _
  rw [exteriorBaseChangeUnit_top, coefficientExteriorMap_top]

/-- The coefficient matrix gives a chain map from the first Koszul resolution to
the second, regarded as a complex over the smaller ring. -/
private noncomputable def coefficientBaseChangeKoszulChainMap
    {P R : Type u} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (f : Fin n → P) (g : Fin n → R)
    (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, algebraMap P R (f i) = ∑ j, M i j * g j) :
    Koszul.seqComplex f ⟶
      ((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex g) :=
  HomologicalComplex.Hom.mk
    (fun k => CategoryTheory.ConcreteCategory.ofHom (C := ModuleCat P)
      (coefficientBaseChangeLinearMap M k)) (by
      intro i j hij
      obtain rfl : j + 1 = i := hij
      refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
      simp only [CategoryTheory.Functor.mapHomologicalComplex_obj_d,
        Koszul.seqComplex_d, ModuleCat.hom_comp]
      exact (coefficientBaseChangeLinearMap_d f g M h j x).symm)

section UniverseLiftComparison

open scoped ModuleCat

/-- The coefficient comparison after lifting both complexes into one module
universe. -/
noncomputable def coefficientBaseChangeKoszulChainMapULift
    {P : Type u} {R : Type v} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (f : Fin n → P) (g : Fin n → R)
    (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, algebraMap P R (f i) = ∑ j, M i j * g j) :
    (((ModuleCat.uliftFunctor.{v, u} P).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)) ⟶
      (((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj
          (((ModuleCat.uliftFunctor.{u, v} R).mapHomologicalComplex
            (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))) := by
  let (k : ℕ) : Module P
      ((((ModuleCat.uliftFunctor.{u, v} R).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex g)).X k) :=
    Module.compHom _ (algebraMap P R)
  exact HomologicalComplex.Hom.mk
    (fun k => ModuleCat.ofHom
      ({ toFun := fun x => ULift.up (coefficientBaseChangeLinearMap M k x.down)
         map_add' x y := ULift.ext (map_add (coefficientBaseChangeLinearMap M k) x.down y.down)
         map_smul' a x := ULift.ext (map_smul (coefficientBaseChangeLinearMap M k) a x.down) } :
        ULift.{v} (⋀[P]^k (Fin n → P)) →ₗ[P]
          ULift.{u} (⋀[R]^k (Fin n → R)))) (by
      intro i j hij
      obtain rfl : j + 1 = i := hij
      refine ModuleCat.hom_ext (LinearMap.ext fun x => ULift.ext ?_)
      simp only [CategoryTheory.Functor.mapHomologicalComplex_obj_d,
        Koszul.seqComplex_d]
      change (Koszul.d (Koszul.seqDual g) j)
          (coefficientBaseChangeLinearMap M (j + 1) x.down) =
        coefficientBaseChangeLinearMap M j
          (Koszul.d (Koszul.seqDual f) j x.down)
      exact (coefficientBaseChangeLinearMap_d f g M h j x.down).symm)

/-- In top degree the universe-lifted comparison is multiplication by the
coefficient determinant. -/
private theorem coefficientBaseChangeKoszulChainMapULift_top
    {P : Type u} {R : Type v} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (f : Fin n → P) (g : Fin n → R)
    (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, algebraMap P R (f i) = ∑ j, M i j * g j) :
    ((coefficientBaseChangeKoszulChainMapULift f g M h).f n).hom
        (ULift.up (exteriorPower.ιMulti P n (Pi.basisFun P (Fin n)))) =
      ULift.up (M.det • exteriorPower.ιMulti R n (Pi.basisFun R (Fin n))) := by
  change ULift.up (coefficientBaseChangeLinearMap M n
    (exteriorPower.ιMulti P n (Pi.basisFun P (Fin n)))) = _
  rw [coefficientBaseChangeLinearMap_top]

end UniverseLiftComparison

/-- Each term of a universe-lifted Koszul complex over a flat algebra is
flat after restriction to the base ring. -/
private theorem flat_ulift_koszulTerm_restrict
    {P : Type u} {R : Type v} [CommRing P] [CommRing R] [Algebra P R]
    [Module.Flat P R] {n : ℕ} (g : Fin n → R) (k : ℕ) :
    let D := ((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
        (((ModuleCat.uliftFunctor.{u, v} R).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))
    Module.Flat P (D.X k) := by
  dsimp only
  let : Module.Flat P (⋀[R]^k (Fin n → R)) := flat_exteriorPower_restrict k
  change Module.Flat P (ULift.{u} (⋀[R]^k (Fin n → R)))
  exact Module.Flat.of_linearEquiv
    (ULift.moduleEquiv : ULift.{u} (⋀[R]^k (Fin n → R)) ≃ₗ[P]
      (⋀[R]^k (Fin n → R)))

/-- A nonnegatively graded chain complex of modules with flat terms is `K`-flat after extension
to `ℤ`-grading. -/
private theorem kFlat_extend_of_flat_terms
    {P : Type u} [CommRing P] (D : ChainComplex (ModuleCat.{max u w} P) ℕ)
    (hD : ∀ j, Module.Flat P (D.X j)) :
    CochainComplex.KFlat (D.extend ComplexShape.embeddingDownNat) := by
  let (j : ℤ) : Module.Flat P ((D.extend ComplexShape.embeddingDownNat).X j) := by
    by_cases hj : ∃ m, ComplexShape.embeddingDownNat.f m = j
    · obtain ⟨m, hm⟩ := hj
      exact Module.Flat.of_linearEquiv
        (D.extendXIso ComplexShape.embeddingDownNat hm).toLinearEquiv
    · have := ModuleCat.subsingleton_of_isZero
        (D.isZero_extend_X ComplexShape.embeddingDownNat j (by simpa using hj))
      infer_instance
  exact CochainComplex.KFlat.kFlat_of_flat (D.extend ComplexShape.embeddingDownNat) 0

theorem koszulSeq_ulift_restrict_kFlat
    {P : Type u} {R : Type v} [CommRing P] [CommRing R] [Algebra P R]
    [Module.Flat P R] {n : ℕ} (g : Fin n → R) :
    let D := ((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
        (((ModuleCat.uliftFunctor.{u, v} R).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))
    CochainComplex.KFlat (D.extend ComplexShape.embeddingDownNat) :=
  kFlat_extend_of_flat_terms _ (flat_ulift_koszulTerm_restrict g)

theorem koszulSeq_ulift_kFlat
    {P : Type u} [CommRing P] {n : ℕ} (f : Fin n → P) :
    let D := ((ModuleCat.uliftFunctor.{v, u} P).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)
    CochainComplex.KFlat (D.extend ComplexShape.embeddingDownNat) := by
  refine kFlat_extend_of_flat_terms _ fun j => ?_
  change Module.Flat P (ULift.{v} (⋀[P]^j (Fin n → P)))
  let : Module.Free P (⋀[P]^j (Fin n → P)) :=
    Module.Free.of_basis ((Pi.basisFun P (Fin n)).exteriorPower j)
  exact Module.Flat.of_linearEquiv
    (ULift.moduleEquiv : ULift.{v} (⋀[P]^j (Fin n → P)) ≃ₗ[P]
      (⋀[P]^j (Fin n → P)))

/-- An additive functor preserving homology carries a complex with vanishing homology in degree `i`
to one with vanishing homology in degree `i`. -/
private theorem isZero_homology_map_of_isZero
    {C D : Type*} [Category* C] [Category* D] [Abelian C] [Abelian D]
    (F : C ⥤ D) [F.Additive] [F.PreservesHomology]
    (K : ChainComplex C ℕ) (i : ℕ) (hK : Limits.IsZero (K.homology i)) :
    Limits.IsZero (((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K).homology i) :=
  (F.map_isZero hK).of_iso (ShortComplex.mapHomologyIso (K.sc i) F)

/-- Positive Koszul homology remains zero after universe lifting and
restriction of scalars. -/
theorem isZero_homology_ulift_restrict
    {P : Type u} {R : Type v} [CommRing P] [CommRing R] [Algebra P R]
    {n : ℕ} (g : Fin n → R) (i : ℕ)
    (hg : CategoryTheory.Limits.IsZero ((Koszul.seqComplex g).homology i)) :
    let D := ((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
        (((ModuleCat.uliftFunctor.{u, v} R).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))
    CategoryTheory.Limits.IsZero (D.homology i) :=
  isZero_homology_map_of_isZero _ _ i
    (isZero_homology_map_of_isZero (ModuleCat.uliftFunctor.{u, v} R) _ i hg)

theorem isZero_homology_ulift
    {P : Type u} [CommRing P] {n : ℕ} (f : Fin n → P) (i : ℕ)
    (hf : CategoryTheory.Limits.IsZero ((Koszul.seqComplex f).homology i)) :
    let D := ((ModuleCat.uliftFunctor.{v, u} P).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)
    CategoryTheory.Limits.IsZero (D.homology i) :=
  isZero_homology_map_of_isZero _ _ i hf

/-- A map between complexes whose positive homology vanishes is a
quasi-isomorphism as soon as it is an isomorphism on zeroth homology. -/
theorem quasiIso_of_isZero_positive_homology
    {R : Type u} [CommRing R]
    {K L : ChainComplex (ModuleCat.{v} R) ℕ} (α : K ⟶ L)
    (hK : ∀ i ≠ 0, CategoryTheory.Limits.IsZero (K.homology i))
    (hL : ∀ i ≠ 0, CategoryTheory.Limits.IsZero (L.homology i))
    (hzero : CategoryTheory.IsIso (HomologicalComplex.homologyMap α 0)) :
    QuasiIso α := by
  rw [quasiIso_iff]
  intro i
  rw [quasiIsoAt_iff_isIso_homologyMap]
  obtain rfl | hi := eq_or_ne i 0
  · exact hzero
  · exact (hK i hi).isIso (hL i hi) _

/-- In degree zero, passage from cocycles to homology agrees with passage
from the whole degree-zero term to the quotient by boundaries. -/
private theorem chain_zero_homology_fac
    {C : Type*} [Category* C] [Abelian C]
    (K : ChainComplex C ℕ) :
    K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv =
      (ChainComplex.cycles₀Iso K).inv ≫ K.homologyπ 0 := by
  rw [← cancel_epi (ChainComplex.cycles₀Iso K).hom]
  simp only [Iso.hom_inv_id_assoc]
  change K.iCycles 0 ≫ K.pOpcycles 0 ≫
    (ChainComplex.isoHomologyι₀ K).inv = K.homologyπ 0
  rw [← K.homology_π_ι_assoc]
  simp only [HomologicalComplex.isoHomologyι_hom_inv_id, Category.comp_id]

/-- The degree-zero projection to homology is natural in a map of chain
complexes. -/
theorem chain_zero_homology_naturality
    {C : Type*} [Category* C] [Abelian C]
    {K L : ChainComplex C ℕ} (α : K ⟶ L) :
    K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv ≫
      HomologicalComplex.homologyMap α 0 =
        α.f 0 ≫ L.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ L).inv := by
  rw [ChainComplex.isoHomologyι₀_inv_naturality, HomologicalComplex.p_opcyclesMap_assoc]

/-- The homology quotient projection commutes with the canonical homology
isomorphism of an exact additive functor. -/
private theorem homologyπ_mapHomologyIso_hom
    {C D : Type*} [Category* C] [Category* D] [Abelian C] [Abelian D]
    (S : ShortComplex C) (F : C ⥤ D) [F.Additive]
    [F.PreservesLeftHomologyOf S] :
    (S.map F).homologyπ ≫ (S.mapHomologyIso F).hom =
      (S.mapCyclesIso F).hom ≫ F.map S.homologyπ := by
  have hMH : (S.mapHomologyIso F).hom =
      (S.homologyData.left.map F).homologyIso.hom ≫
        F.map S.homologyData.left.homologyIso.inv :=
    congrArg Iso.hom (S.homologyData.left.mapHomologyIso_eq F)
  have hMC : (S.mapCyclesIso F).hom =
      (S.homologyData.left.map F).cyclesIso.hom ≫
        F.map S.homologyData.left.cyclesIso.inv :=
    congrArg Iso.hom (S.homologyData.left.mapCyclesIso_eq F)
  have hπ : (S.map F).homologyπ ≫ (S.homologyData.left.map F).homologyIso.hom =
      (S.homologyData.left.map F).cyclesIso.hom ≫ F.map S.homologyData.left.π :=
    ShortComplex.LeftHomologyData.homologyπ_comp_homologyIso_hom
      (S.map F) (S.homologyData.left.map F)
  exact ((congrArg (fun m => (S.map F).homologyπ ≫ m) hMH).trans
      (Category.assoc _ _ _).symm).trans
    (((congrArg (fun m => m ≫ F.map S.homologyData.left.homologyIso.inv) hπ).trans
      ((Category.assoc _ _ _).trans
        (congrArg (fun m => (S.homologyData.left.map F).cyclesIso.hom ≫ m)
          (F.map_comp _ _).symm))).trans
      ((congrArg (fun m => (S.homologyData.left.map F).cyclesIso.hom ≫ F.map m)
          (ShortComplex.LeftHomologyData.π_comp_homologyIso_inv S S.homologyData.left)).trans
        (((congrArg (fun m => (S.homologyData.left.map F).cyclesIso.hom ≫ m)
            (F.map_comp _ _)).trans (Category.assoc _ _ _).symm).trans
          (congrArg (fun m => m ≫ F.map S.homologyπ) hMC.symm))))

/-- The degree-zero quotient description of homology commutes with an exact
additive functor on chain complexes. -/
private theorem chain_zero_homology_map_fac
    {C D : Type*} [Category* C] [Category* D] [Abelian C] [Abelian D]
    (K : ChainComplex C ℕ) (F : C ⥤ D) [F.Additive]
    [F.PreservesLeftHomologyOf (K.sc 0)] :
    ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K).pOpcycles 0 ≫
        (ChainComplex.isoHomologyι₀
          ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv ≫
          ((K.sc 0).mapHomologyIso F).hom =
      F.map (K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv) := by
  have hiC : ((K.sc 0).mapCyclesIso F).hom ≫ F.map (ChainComplex.cycles₀Iso K).hom =
      (ChainComplex.cycles₀Iso
        ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).hom :=
    ShortComplex.mapCyclesIso_hom_iCycles (K.sc 0) F
  have hmap : F.map (ChainComplex.cycles₀Iso K).inv ≫
      F.map (ChainComplex.cycles₀Iso K).hom = 𝟙 _ :=
    (F.map_comp _ _).symm.trans
      ((congrArg F.map (ChainComplex.cycles₀Iso K).inv_hom_id).trans (F.map_id _))
  have hc : (ChainComplex.cycles₀Iso
          ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv ≫
        ((K.sc 0).mapCyclesIso F).hom =
      F.map (ChainComplex.cycles₀Iso K).inv :=
    (cancel_mono (F.map (ChainComplex.cycles₀Iso K).hom)).mp
      ((Category.assoc _ _ _).trans
        ((congrArg (fun m => (ChainComplex.cycles₀Iso
            ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv ≫ m) hiC).trans
          ((ChainComplex.cycles₀Iso
            ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv_hom_id.trans
              hmap.symm)))
  have hπ : ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K).homologyπ 0 ≫
        ((K.sc 0).mapHomologyIso F).hom =
      ((K.sc 0).mapCyclesIso F).hom ≫ F.map (K.homologyπ 0) :=
    homologyπ_mapHomologyIso_hom (K.sc 0) F
  exact ((Category.assoc _ _ _).symm.trans
      (congrArg (fun m => m ≫ ((K.sc 0).mapHomologyIso F).hom)
        (chain_zero_homology_fac
          ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)))).trans
    (((Category.assoc _ _ _).trans
      ((congrArg (fun m => (ChainComplex.cycles₀Iso
          ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv ≫ m) hπ).trans
        (Category.assoc _ _ _).symm)).trans
      ((congrArg (fun m => m ≫ F.map (K.homologyπ 0)) hc).trans
        ((F.map_comp _ _).symm.trans
          (congrArg F.map (chain_zero_homology_fac K).symm))))

/-- An identification of the zeroth homology of a chain complex with an object, described as a
map out of the degree-zero term, is carried by an exact additive functor to the analogous
identification for the image complex. -/
theorem chain_zero_homology_map_fac_iso
    {C D : Type*} [Category* C] [Category* D] [Abelian C] [Abelian D]
    (K : ChainComplex C ℕ) (F : C ⥤ D) [F.Additive]
    [F.PreservesLeftHomologyOf (K.sc 0)] {Z : C} (e : K.homology 0 ≅ Z) {m : K.X 0 ⟶ Z}
    (hm : K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv ≫ e.hom = m) :
    ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K).pOpcycles 0 ≫
        (ChainComplex.isoHomologyι₀
          ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv ≫
          ((K.sc 0).mapHomologyIso F ≪≫ F.mapIso e).hom = F.map m := by
  have hfac := chain_zero_homology_map_fac K F
  have hsplit : ((K.sc 0).mapHomologyIso F ≪≫ F.mapIso e).hom =
      ((K.sc 0).mapHomologyIso F).hom ≫ F.map e.hom := rfl
  exact ((congrArg (fun x => ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K).pOpcycles 0 ≫
        (ChainComplex.isoHomologyι₀
          ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K)).inv ≫ x) hsplit).trans
      ((congrArg (fun x => ((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj K).pOpcycles 0 ≫ x)
          (Category.assoc _ _ _).symm).trans
        (Category.assoc _ _ _).symm)).trans
    ((congrArg (fun x => x ≫ F.map e.hom) hfac).trans
      ((F.map_comp _ _).symm.trans
        (congrArg F.map ((Category.assoc _ _ _).trans hm))))

private theorem koszulRegularOn_of_linearEquiv
    {R : Type*} [CommRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {n : ℕ} (s : Fin n → R) (e : M ≃ₗ[R] N)
    (hs : Koszul.IsKoszulRegularOn s M) : Koszul.IsKoszulRegularOn s N := by
  intro i hi
  obtain ⟨eH⟩ := KoszulC.homologyTransport_of_degreewiseEquiv
    (C := Koszul.seqComplexTensor s M) (D := Koszul.seqComplexTensor s N)
    (fun k => e.lTensor (⋀[R]^k (Fin n → R))) (by
      intro k l x
      by_cases hkl : l + 1 = k
      · subst k
        rw [Koszul.seqComplexTensor_d, Koszul.seqComplexTensor_d]
        have he : (e.lTensor (⋀[R]^l (Fin n → R))).toLinearMap ∘ₗ
            (Koszul.d (Koszul.seqDual s) l).rTensor M =
              (Koszul.d (Koszul.seqDual s) l).rTensor N ∘ₗ
                (e.lTensor (⋀[R]^(l + 1) (Fin n → R))).toLinearMap := by
          apply TensorProduct.ext
          ext a b
          rfl
        exact LinearMap.congr_fun he x
      · rw [(Koszul.seqComplexTensor s M).shape k l hkl,
          (Koszul.seqComplexTensor s N).shape k l hkl]
        exact (e.lTensor (⋀[R]^l (Fin n → R))).toLinearMap.map_zero) i
  have : Subsingleton ((Koszul.seqComplexTensor s M).homology i) :=
    ModuleCat.isZero_iff_subsingleton.mp (hs i hi)
  exact ModuleCat.isZero_iff_subsingleton.mpr eH.symm.toEquiv.subsingleton

/-- Flat extension of scalars preserves Koszul regularity for the whole ring. -/
theorem koszulRegular_algebraMap
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Flat R S] {n : ℕ} {s : Fin n → R}
    (hs : Koszul.IsKoszulRegular s) :
    Koszul.IsKoszulRegular (fun i => algebraMap R S (s i)) := by
  have hb := KoszulC.isKoszulRegular_baseChange s R
    ((Koszul.isKoszulRegularOn_self_iff s).mpr hs) (S := S)
  exact (Koszul.isKoszulRegularOn_self_iff _).mp
    (koszulRegularOn_of_linearEquiv _ (TensorProduct.AlgebraTensorModule.rid R S S) hb)

end Stacks.Discriminant
