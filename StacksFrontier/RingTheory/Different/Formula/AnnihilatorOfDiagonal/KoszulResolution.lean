/-!
# Koszul resolutions for the annihilator of the diagonal ideal

This file collects the facts about a single Koszul complex used in
`StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal`, the proof that the annihilator
of `I = Ker(B ⊗_A B → B)` for a flat complete intersection `B = P/(f_1, …, f_n)` is generated by
the image of `det(g_{ij})`.

A coefficient matrix induces a map between Koszul complexes, acting by its determinant in top
exterior degree. For a single non-zero-divisor the determinant-colon formula is checked directly.
Koszul complexes over a flat algebra are K-flat over the base, their zeroth homology is the
quotient by the ideal generated by the sequence, and for a Koszul-regular sequence the
augmentation to this quotient is a quasi-isomorphism, so the Koszul complex resolves it.

## References

* [Mazur--Roberts, Appendix]
* [Stacks Project, Tag 0BWC](https://stacks.math.columbia.edu/tag/0BWC)
-/

@[expose] public section

open scoped TensorProduct
open scoped Matrix

universe u v w

namespace Stacks.Discriminant

open CategoryTheory

/-- An alternating map out of a finite free module is determined by its value
on a basis and the determinant of the coordinate matrix. -/
theorem alternatingMap_eq_basis_det_smulRight
    {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N]
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (e : Module.Basis ι R M) (F : M [⋀^ι]→ₗ[R] N) :
    F = e.det.smulRight (F e) := by
  refine e.ext_alternating fun i hi => ?_
  let σ : Equiv.Perm ι := Equiv.ofBijective i (Finite.injective_iff_bijective.1 hi)
  show F (e ∘ σ) = (e.det.smulRight (F e)) (e ∘ σ)
  simp [AlternatingMap.map_perm, Module.Basis.det_self]

/-- The linear map on the free modules specified by a coefficient matrix. -/
def coefficientLinearMap {R : Type*} [CommRing R] {n : ℕ}
    (M : Matrix (Fin n) (Fin n) R) : (Fin n → R) →ₗ[R] (Fin n → R) where
  toFun v j := ∑ i, v i * M i j
  map_add' x y := by
    funext j
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' a x := by
    funext j
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_assoc, Finset.mul_sum]

private theorem coefficientLinearMap_seqDual {R : Type*} [CommRing R] {n : ℕ}
    (f g : Fin n → R) (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, f i = ∑ j, M i j * g j) :
    (Koszul.seqDual g).comp (coefficientLinearMap M) = Koszul.seqDual f := by
  refine LinearMap.ext fun v => ?_
  simp only [LinearMap.comp_apply, Koszul.seqDual_apply]
  show (∑ j, (∑ i, v i * M i j) * g j) = ∑ i, v i * f i
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [h i, Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by ring

/-- In top exterior degree, the coefficient map acts by its determinant. -/
theorem coefficientExteriorMap_top {R : Type*} [CommRing R] {n : ℕ}
    (M : Matrix (Fin n) (Fin n) R) :
    exteriorPower.map n (coefficientLinearMap M)
        (exteriorPower.ιMulti R n (Pi.basisFun R (Fin n))) =
      M.det • exteriorPower.ιMulti R n (Pi.basisFun R (Fin n)) := by
  let b := Pi.basisFun R (Fin n)
  let F : (Fin n → R) [⋀^Fin n]→ₗ[R] (⋀[R]^n (Fin n → R)) :=
    exteriorPower.ιMulti R n
  have hh := congrArg
    (fun T : (Fin n → R) [⋀^Fin n]→ₗ[R] (⋀[R]^n (Fin n → R)) =>
      T (fun i => coefficientLinearMap M (b i)))
    (alternatingMap_eq_basis_det_smulRight b F)
  have hmatrix : b.toMatrix (fun i => coefficientLinearMap M (b i)) = M.transpose := by
    ext j i
    simp [Module.Basis.toMatrix_apply, coefficientLinearMap, b,
      Pi.basisFun_apply, Pi.single_apply, Finset.sum_ite_eq', Matrix.transpose_apply]
  have hdet : b.det (fun i => coefficientLinearMap M (b i)) = M.det := by
    rw [Module.Basis.det_apply, hmatrix, Matrix.det_transpose]
  rw [exteriorPower.map_apply_ιMulti]
  simpa only [F, b, AlternatingMap.smulRight_apply, hdet,
    Function.comp_def] using hh

/-- The exterior-power map for a coefficient matrix commutes with the Koszul
differentials. -/
theorem coefficientExteriorMap_comm {R : Type*} [CommRing R] {n : ℕ}
    (f g : Fin n → R) (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, f i = ∑ j, M i j * g j) (k : ℕ)
    (x : ⋀[R]^(k + 1) (Fin n → R)) :
    exteriorPower.map k (coefficientLinearMap M) (Koszul.d (Koszul.seqDual f) k x) =
      Koszul.d (Koszul.seqDual g) k
        (exteriorPower.map (k + 1) (coefficientLinearMap M) x) := by
  apply Subtype.ext
  simp only [Koszul.d_apply_coe, exteriorPower.coe_map]
  exact koszul_map_comm (Koszul.seqDual f) (Koszul.seqDual g)
    (coefficientLinearMap M) (coefficientLinearMap_seqDual f g M h) x.1

/-- The coefficient matrix induces a map between the Koszul complexes. -/
private noncomputable def coefficientKoszulChainMap {R : Type*} [CommRing R] {n : ℕ}
    (f g : Fin n → R) (M : Matrix (Fin n) (Fin n) R)
    (h : ∀ i, f i = ∑ j, M i j * g j) :
    Koszul.seqComplex f ⟶ Koszul.seqComplex g :=
  HomologicalComplex.Hom.mk
    (fun k => ModuleCat.ofHom (exteriorPower.map k (coefficientLinearMap M))) (by
      intro i j hij
      obtain rfl : j + 1 = i := hij
      rw [Koszul.seqComplex_d, Koszul.seqComplex_d]
      exact ModuleCat.hom_ext <| LinearMap.ext fun x =>
        (coefficientExteriorMap_comm f g M h j x).symm)

/-- For a non-zero-divisor `g`, the colon ideal `(a g) : g` is `(a)`. -/
theorem principal_colon_of_regular {R : Type*} [CommRing R]
    (a g : R) (hg : IsSMulRegular R g) :
    (Ideal.span {a * g}).colon ({g} : Set R) = Ideal.span {a} := by
  ext x
  simp only [Submodule.mem_colon_singleton, smul_eq_mul, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, sub_eq_zero.mp (hg.right_eq_zero_of_smul ?_)⟩
    rw [smul_eq_mul]
    linear_combination hc
  · rintro ⟨c, rfl⟩
    exact ⟨c, by ring⟩

private theorem koszul_d_one {R : Type*} [CommRing R]
    {E : Type*} [AddCommGroup E] [Module R E]
    (φ : Module.Dual R E) (x : E) :
    Koszul.d φ 0 ((exteriorPower.oneEquiv R E).symm x) =
      (exteriorPower.zeroEquiv R E).symm (φ x) := by
  apply Subtype.ext
  simp [Koszul.d_apply_coe, exteriorPower.oneEquiv_symm_apply,
    exteriorPower.zeroEquiv_symm_apply, exteriorPower.ιMulti_apply_coe,
    ExteriorAlgebra.ιMulti, Koszul.contraction, CliffordAlgebra.contractLeft_ι,
    Algebra.algebraMap_eq_smul_one]

/-- A one-term Koszul-regular sequence consists of a non-zero-divisor. -/
theorem isSMulRegular_of_koszulRegular_singleton
    {R : Type*} [CommRing R] (g : Fin 1 → R)
    (hg : Koszul.IsKoszulRegular g) : IsSMulRegular R (g 0) := by
  rw [isSMulRegular_iff_right_eq_zero_of_smul]
  intro x hx
  have he := (HomologicalComplex.exactAt_iff_isZero_homology _ _).mpr
    (hg 1 (by omega))
  rw [HomologicalComplex.exactAt_iff' _ 2 1 0 (by simp) (by simp),
    CategoryTheory.ShortComplex.moduleCat_exact_iff_ker_sub_range] at he
  simp only [HomologicalComplex.sc', HomologicalComplex.shortComplexFunctor'_obj_g,
    HomologicalComplex.shortComplexFunctor'_obj_f, Koszul.seqComplex_d] at he
  let b := Pi.basisFun R (Fin 1)
  have htwo : Subsingleton (⋀[R]^2 (Fin 1 → R)) :=
    exteriorPower.subsingleton_of_span_eq_top_of_card_lt b b.span_eq _ (by simp)
  have hr : LinearMap.range (Koszul.d (Koszul.seqDual g) 1) = ⊥ := by
    rw [Subsingleton.elim (Koszul.d (Koszul.seqDual g) 1) 0, LinearMap.range_zero]
  change LinearMap.ker (Koszul.d (Koszul.seqDual g) 0) ≤
    LinearMap.range (Koszul.d (Koszul.seqDual g) 1) at he
  rw [hr] at he
  let z : ⋀[R]^1 (Fin 1 → R) :=
    (exteriorPower.oneEquiv R (Fin 1 → R)).symm (Pi.single 0 1)
  have hdz : Koszul.d (Koszul.seqDual g) 0 (x • z) = 0 := by
    apply (exteriorPower.zeroEquiv R (Fin 1 → R)).injective
    rw [map_zero, map_smul, koszul_d_one, map_smul, LinearEquiv.apply_symm_apply,
      Koszul.seqDual_single]
    simpa only [smul_eq_mul, mul_comm] using hx
  simpa [z] using congrArg (fun w ↦ (exteriorPower.oneEquiv R (Fin 1 → R)) w 0) (he hdz)

/-- The determinant-colon formula for one generator. -/
private theorem colon_one
    {R : Type*} [CommRing R]
    (f g : Fin 1 → R) (M : Matrix (Fin 1) (Fin 1) R)
    (h : ∀ i, f i = ∑ j, M i j * g j)
    (hg : Koszul.IsKoszulRegular g) :
    (Ideal.span (Set.range f)).colon
      (Ideal.span (Set.range g) : Set R) = Ideal.span {M.det} := by
  have hf : f 0 = M 0 0 * g 0 := by simpa using h 0
  rw [Set.range_unique, Set.range_unique, Fin.default_eq_zero, hf, Ideal.colon_span,
    principal_colon_of_regular]
  · rw [Matrix.det_fin_one]
  · exact isSMulRegular_of_koszulRegular_singleton g hg

/-- Each term of a Koszul complex over a flat extension is flat over the base. -/
theorem flat_exteriorPower_restrict
    {P R : Type*} [CommRing P] [CommRing R] [Algebra P R]
    [Module.Flat P R] {n : ℕ} (k : ℕ) :
    Module.Flat P (⋀[R]^k (Fin n → R)) := by
  let : Module.Free R (⋀[R]^k (Fin n → R)) :=
    Module.Free.of_basis ((Pi.basisFun R (Fin n)).exteriorPower k)
  exact Module.Flat.trans P R _

/-- The finite free Koszul complex is K-flat after reversing chain degree. -/
private theorem koszulSeq_kFlat
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R) :
    CochainComplex.KFlat
      ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) := by
  let (j : ℕ) : CategoryTheory.Projective ((Koszul.seqComplex f).X j) := by
    show CategoryTheory.Projective (ModuleCat.of R (⋀[R]^j (Fin n → R)))
    exact ModuleCat.projective_of_free ((Pi.basisFun R (Fin n)).exteriorPower j)
  let (j : ℤ) : Module.Flat R
      (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).X j) := by
    infer_instance
  exact CochainComplex.KFlat.kFlat_of_flat
    ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) 0

/-- A Koszul complex over a flat algebra is K-flat when regarded over the
smaller ring. -/
private theorem koszulSeq_restrict_kFlat
    {P R : Type u} [CommRing P] [CommRing R] [Algebra P R]
    [Module.Flat P R] {n : ℕ} (g : Fin n → R) :
    CochainComplex.KFlat
      (((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex g) |>.extend
          ComplexShape.embeddingDownNat) := by
  let D := ((ModuleCat.restrictScalars (algebraMap P R)).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj (Koszul.seqComplex g)
  let (j : ℕ) : Module.Flat P (D.X j) := by
    show Module.Flat P (⋀[R]^j (Fin n → R))
    exact flat_exteriorPower_restrict j
  let (j : ℤ) : Module.Flat P ((D.extend ComplexShape.embeddingDownNat).X j) := by
    by_cases hj : ∃ m, ComplexShape.embeddingDownNat.f m = j
    · obtain ⟨m, hm⟩ := hj
      exact Module.Flat.of_linearEquiv
        (D.extendXIso ComplexShape.embeddingDownNat hm).toLinearEquiv
    · have := ModuleCat.subsingleton_of_isZero
        (D.isZero_extend_X ComplexShape.embeddingDownNat j (by simpa using hj))
      infer_instance
  exact CochainComplex.KFlat.kFlat_of_flat
    (D.extend ComplexShape.embeddingDownNat) 0

/-- Tensoring a quasi-isomorphism between K-flat complexes with a module
preserves its homology isomorphisms. -/
theorem quasiIso_tensorModule_map
    {R : Type u} [CommRing R] (N : ModuleCat.{max u v} R)
    {C D : CochainComplex (ModuleCat.{max u v} R) ℤ} (f : C ⟶ D)
    [QuasiIso f] (hC : CochainComplex.KFlat.{u, v} C)
    (hD : CochainComplex.KFlat.{u, v} D) :
    QuasiIso (((CategoryTheory.MonoidalCategory.tensorLeft N).mapHomologicalComplex
      (ComplexShape.up ℤ)).map f) := by
  open CategoryTheory TotalTensorComplex.SingleTensor in
  have ht := CochainComplex.DerivedTensor.quasiIso_tleftCochain_map f hC hD
    ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj N)
  open CategoryTheory TotalTensorComplex.SingleTensor in
  have hcomp : QuasiIso ((singleTensorIso N C).inv ≫
      (TleftCochain ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj N)).map f) :=
    inferInstance
  open CategoryTheory TotalTensorComplex.SingleTensor in
  rw [singleTensorIso_naturality] at hcomp
  exact (quasiIso_iff_comp_right _
    (TotalTensorComplex.SingleTensor.singleTensorIso N D).inv).mp hcomp

/-- Under the zeroth exterior-power equivalence, the first Koszul differential
has image the ideal generated by the sequence. -/
private theorem koszulRange_d_zero {R : Type u} [CommRing R] {n : ℕ}
    (f : Fin n → R) :
    Submodule.map
        (exteriorPower.zeroEquiv R (Fin n → R) : (⋀[R]^0 (Fin n → R)) →ₗ[R] R)
        (LinearMap.range (Koszul.d (Koszul.seqDual f) 0)) =
      Ideal.span (Set.range f) := by
  show Submodule.map _ _ = Submodule.span R (Set.range f)
  rw [← Fintype.range_linearCombination R f]
  ext a
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨exteriorPower.oneEquiv R (Fin n → R) x,
      (Koszul.zeroEquiv_d_zero f x).symm⟩
  · rintro ⟨v, rfl⟩
    refine ⟨(exteriorPower.zeroEquiv R (Fin n → R)).symm (Koszul.seqDual f v),
      ?_, ?_⟩
    · refine ⟨(exteriorPower.oneEquiv R (Fin n → R)).symm v, ?_⟩
      apply (exteriorPower.zeroEquiv R (Fin n → R)).injective
      calc
        _ = Koszul.seqDual f
            (exteriorPower.oneEquiv R (Fin n → R)
              ((exteriorPower.oneEquiv R (Fin n → R)).symm v)) :=
          Koszul.zeroEquiv_d_zero f _
        _ = Koszul.seqDual f v := congrArg _
          (LinearEquiv.apply_symm_apply (exteriorPower.oneEquiv R (Fin n → R)) v)
        _ = _ := (LinearEquiv.apply_symm_apply
          (exteriorPower.zeroEquiv R (Fin n → R)) _).symm
    · exact (LinearEquiv.apply_symm_apply
        (exteriorPower.zeroEquiv R (Fin n → R)) _).trans rfl

/-- In the degree-zero short complex of the Koszul complex, the incoming map is the first
Koszul differential. -/
private theorem koszulSc'_f {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R) :
    ((Koszul.seqComplex f).sc' 1 0 0).f =
      ModuleCat.ofHom (Koszul.d (Koszul.seqDual f) 0) := by
  show (Koszul.seqComplex f).d (0 + 1) 0 = _
  exact Koszul.seqComplex_d f 0

/-- The image of the incoming map of the degree-zero short complex is, under the zeroth
exterior-power equivalence, the ideal generated by the sequence. -/
theorem koszulRange_sc'_f {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R) :
    Submodule.map
        (exteriorPower.zeroEquiv R (Fin n → R) : (⋀[R]^0 (Fin n → R)) →ₗ[R] R)
        (LinearMap.range ((((Koszul.seqComplex f).sc' 1 0 0).f).hom)) =
      Ideal.span (Set.range f) := by
  rw [koszulSc'_f]
  exact koszulRange_d_zero f

/-- The quotient of the degree-zero term of the Koszul complex by the image of the first
differential is `R/(f_1, …, f_n)`, in the spelling produced by
`CategoryTheory.ShortComplex.moduleCatOpcyclesIso`. -/
noncomputable def koszulOpcyclesQuotientIso {R : Type u} [CommRing R] {n : ℕ}
    (f : Fin n → R) :
    ModuleCat.of R
        ((((Koszul.seqComplex f).sc' 1 0 0).X₂) ⧸
          LinearMap.range ((((Koszul.seqComplex f).sc' 1 0 0).f).hom)) ≅
      ModuleCat.of R (R ⧸ Ideal.span (Set.range f)) :=
  (Submodule.Quotient.equiv
    (LinearMap.range ((((Koszul.seqComplex f).sc' 1 0 0).f).hom))
    (Ideal.span (Set.range f))
    (exteriorPower.zeroEquiv R (Fin n → R)) (koszulRange_sc'_f f)).toModuleIso

/-- The zeroth homology of the Koszul complex is the quotient by the
ideal generated by the sequence. -/
noncomputable def koszulHomologyZeroIso {R : Type u} [CommRing R] {n : ℕ}
    (f : Fin n → R) :
    (Koszul.seqComplex f).homology 0 ≅
      ModuleCat.of R (R ⧸ Ideal.span (Set.range f)) :=
  (Koszul.seqComplex f).isoHomologyι₀ ≪≫
    (Koszul.seqComplex f).opcyclesIsoSc' 1 0 0
      (ChainComplex.prev ℕ 0) ChainComplex.next_nat_zero ≪≫
    ((Koszul.seqComplex f).sc' 1 0 0).moduleCatOpcyclesIso ≪≫
    koszulOpcyclesQuotientIso f

section KoszulH0

open CategoryTheory

/-- The zeroth-homology isomorphism sends a degree-zero element to its
class in the quotient by the Koszul relations. -/
theorem koszulHomologyZeroIso_fac {R : Type u} [CommRing R] {n : ℕ}
    (f : Fin n → R) :
    (Koszul.seqComplex f).pOpcycles 0 ≫
        (Koszul.seqComplex f).isoHomologyι₀.inv ≫ (koszulHomologyZeroIso f).hom =
      ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
        (exteriorPower.zeroEquiv R (Fin n → R)).toLinearMap) := by
  rw [koszulHomologyZeroIso, Iso.trans_hom, Iso.trans_hom, Iso.trans_hom,
    Iso.inv_hom_id_assoc, ← Category.assoc,
    HomologicalComplex.pOpcycles_opcyclesIsoSc'_hom]
  exact (ShortComplex.pOpcycles_comp_moduleCatOpcyclesIso_hom_assoc _ _).trans
    (ModuleCat.hom_ext (LinearMap.ext fun _ => rfl))

end KoszulH0

/-- The Koszul complex augments to the quotient by the ideal generated by
the sequence. -/
@[sga "3 III 4.6.1"]
private noncomputable def koszulAugmentation
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R) :
    Koszul.seqComplex f ⟶
      (ChainComplex.single₀ (ModuleCat.{u} R)).obj
        (ModuleCat.of R (R ⧸ Ideal.span (Set.range f))) :=
  (ChainComplex.toSingle₀Equiv _ _).symm
    ⟨ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
      (exteriorPower.zeroEquiv R (Fin n → R)).toLinearMap), by
      apply ModuleCat.hom_ext
      ext x
      change (⋀[R]^1 (Fin n → R)) at x
      change (Ideal.span (Set.range f)).mkQ
        (exteriorPower.zeroEquiv R (Fin n → R)
          (Koszul.d (Koszul.seqDual f) 0 x)) = 0
      rw [Koszul.zeroEquiv_d_zero, Koszul.seqDual_apply]
      exact (Ideal.Quotient.eq_zero_iff_mem).2
        (Submodule.sum_mem _ fun i _ =>
          Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))⟩

private theorem koszulAugmentation_f_zero
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R) :
    (koszulAugmentation f).f 0 =
      ModuleCat.ofHom ((Ideal.span (Set.range f)).mkQ.comp
        (exteriorPower.zeroEquiv R (Fin n → R)).toLinearMap) := by
  rfl

section KoszulAugmentation

open CategoryTheory

private theorem koszulAugmentation_homologyMap_zero_isIso
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R) :
    IsIso (HomologicalComplex.homologyMap (koszulAugmentation f) 0) := by
  let K := Koszul.seqComplex f
  let Q := ModuleCat.of R (R ⧸ Ideal.span (Set.range f))
  let L := (ChainComplex.single₀ (ModuleCat.{u} R)).obj Q
  let α := koszulAugmentation f
  let V := HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℕ) 0 Q
  have hmap : HomologicalComplex.homologyMap α 0 ≫ V.hom =
      (koszulHomologyZeroIso f).hom := by
    rw [← cancel_epi (K.isoHomologyι₀.inv), ← cancel_epi (K.pOpcycles 0),
      ChainComplex.isoHomologyι₀_inv_naturality_assoc, HomologicalComplex.p_opcyclesMap_assoc,
      ← Category.assoc (L.pOpcycles 0) (L.isoHomologyι₀.inv) V.hom,
      ← Koszul.singleZeroHomology_fac Q, koszulAugmentation_f_zero]
    simp only [V, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have hself : (HomologicalComplex.singleObjXSelf
        (ComplexShape.down ℕ) 0 Q).hom = 𝟙 Q := rfl
    rw [hself]
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    change ⋀[R]^0 (Fin n → R) at x
    have hf := congrArg (fun (h : (Koszul.seqComplex f).X 0 ⟶ Q) => h.hom x)
      (koszulHomologyZeroIso_fac f)
    show (Ideal.span (Set.range f)).mkQ
        ((exteriorPower.zeroEquiv R (Fin n → R)) x) =
      (koszulHomologyZeroIso f).hom.hom
        ((Koszul.seqComplex f).isoHomologyι₀.inv.hom
          (((Koszul.seqComplex f).pOpcycles 0).hom x))
    dsimp only [Q] at hf
    exact hf.symm
  have hi : IsIso (HomologicalComplex.homologyMap α 0 ≫ V.hom) := by
    rw [hmap]
    infer_instance
  exact IsIso.of_isIso_comp_right _ V.hom

/-- A Koszul-regular sequence gives a free resolution of its quotient. -/
private theorem koszulAugmentation_quasiIso
    {R : Type u} [CommRing R] {n : ℕ} (f : Fin n → R)
    (hf : Koszul.IsKoszulRegular f) :
    QuasiIso (koszulAugmentation f) := by
  rw [quasiIso_iff]
  intro i
  rw [quasiIsoAt_iff_isIso_homologyMap]
  obtain rfl | hi := eq_or_ne i 0
  · exact koszulAugmentation_homologyMap_zero_isIso f
  · exact (hf i hi).isIso (((ChainComplex.single₀ (ModuleCat.{u} R)).obj
      (ModuleCat.of R (R ⧸ Ideal.span (Set.range f)))).sc i
        |>.isZero_homology_of_isZero_X₂
          (HomologicalComplex.isZero_single_obj_X (ComplexShape.down ℕ) 0 _ i hi)) _

end KoszulAugmentation

end Stacks.Discriminant
