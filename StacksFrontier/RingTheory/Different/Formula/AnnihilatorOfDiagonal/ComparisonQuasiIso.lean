module

public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal.KoszulResolution
public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal.ScalarExtensionComparison
public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal.AnnihilatorCriteria

/-!
# The annihilator of the diagonal ideal of a flat complete intersection

Let `A → P` be a ring map, let `f_1, …, f_n ∈ P` be a Koszul-regular sequence and assume that
`B = P/(f_1, …, f_n)` is flat over `A`. Let `g_1, …, g_n ∈ P ⊗_A B` be a Koszul-regular sequence
generating the kernel of the multiplication map `P ⊗_A B → B` and write
`f_i ⊗ 1 = ∑_j g_{ij} g_j`. The annihilator of `I = Ker(B ⊗_A B → B)` is then the principal
ideal generated by the image of `det(g_{ij})`, and is in fact free of rank one over `B` on that
generator.

This file shows that the comparison of the Koszul complexes of `f` and of `g`, which resolve `B`
over `P` and over `P ⊗_A B`, is a quasi-isomorphism, that after tensoring with `B` it is an
isomorphism in top degree, and reads off the annihilator from the top homology.

## Main results

* `Stacks.Discriminant.annihilator_ker_lmul_eq_span_det`: the annihilator of the kernel of the
  multiplication map `B ⊗_A B → B` is generated by the image of `det(g_{ij})`.
* `Stacks.Discriminant.exists_linearEquiv_annihilator_ker_lmul`: multiplication by that image is
  a `B`-linear isomorphism from `B` onto the annihilator.

## References

* [Mazur--Roberts, Appendix]
* [Stacks Project, Tag 0BWC](https://stacks.math.columbia.edu/tag/0BWC)
-/

@[expose] public section

open scoped TensorProduct
open scoped Matrix

universe u v w

namespace Stacks.Discriminant

open CategoryTheory

private theorem range_fin_one {R : Type*} (h : Fin 1 → R) :
    Set.range h = {h 0} := by
  rw [Set.range_unique, Fin.default_eq_zero]

/-- The Koszul complex vanishes in degrees above the length of its sequence. -/
private theorem koszul_isZero_X_of_lt {R : Type*} [CommRing R]
    {r : ℕ} (f : Fin r → R) (i : ℕ) (hi : r < i) :
    CategoryTheory.Limits.IsZero ((Koszul.seqComplex f).X i) := by
  let : Subsingleton (⋀[R]^i (Fin r → R)) :=
    exteriorPower.subsingleton_of_span_eq_top_of_card_lt
      (Pi.basisFun R (Fin r)) (Pi.basisFun R (Fin r)).span_eq i (by simpa using hi)
  show CategoryTheory.Limits.IsZero (ModuleCat.of R (⋀[R]^i (Fin r → R)))
  exact ModuleCat.isZero_iff_subsingleton.mpr inferInstance

/-- An isomorphism on cycles, when the source differential vanishes, is
injective on the whole term and surjective onto the target kernel. -/
private theorem injective_and_surjective_cycles
    {R : Type u} [CommRing R] {ι : Type*} {c : ComplexShape ι}
    {K L : HomologicalComplex (ModuleCat.{v} R) c} (α : K ⟶ L)
    (i j : ι) (hj : c.next i = j) (hd : K.d i j = 0)
    [IsIso (HomologicalComplex.cyclesMap α i)] :
    Function.Injective (α.f i).hom ∧
      ∀ y : L.X i, (L.d i j).hom y = 0 → ∃ x, (α.f i).hom x = y := by
  have : IsIso (K.iCycles i) := K.isIso_iCycles i j hj hd
  have hfac : α.f i = inv (K.iCycles i) ≫
      HomologicalComplex.cyclesMap α i ≫ L.iCycles i := by
    rw [HomologicalComplex.cyclesMap_i, IsIso.inv_hom_id_assoc]
  constructor
  · rw [hfac]
    exact (ModuleCat.mono_iff_injective _).mp inferInstance
  · intro y hy
    let z := L.cyclesMk y j hj hy
    let x := (K.iCycles i).hom ((inv (HomologicalComplex.cyclesMap α i)).hom z)
    refine ⟨x, ?_⟩
    show ((K.iCycles i ≫ α.f i).hom) _ = y
    rw [← HomologicalComplex.cyclesMap_i]
    have h := ConcreteCategory.congr_hom
      (IsIso.inv_hom_id_assoc (HomologicalComplex.cyclesMap α i) (L.iCycles i)) z
    exact h.trans (L.i_cyclesMk y j hj hy)

/-- The termwise identification for tensoring an extended chain complex. -/
private noncomputable def tensorExtendXIso
    {R : Type u} [CommRing R] (N : ModuleCat.{max u v} R)
    (K : ChainComplex (ModuleCat.{max u v} R) ℕ) (r : ℕ) :
    (((MonoidalCategory.tensorLeft N).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (K.extend ComplexShape.embeddingDownNat)).X (-(r : ℤ)) ≅
        (MonoidalCategory.tensorLeft N).obj (K.X r) :=
  (MonoidalCategory.tensorLeft N).mapIso
    (K.extendXIso ComplexShape.embeddingDownNat (i := r) (i' := -(r : ℤ)) (by rfl))

private theorem tensorExtendXIso_d
    {R : Type u} [CommRing R] (N : ModuleCat.{max u v} R)
    (K : ChainComplex (ModuleCat.{max u v} R) ℕ) (r : ℕ) :
    (tensorExtendXIso N K (r + 1)).inv ≫
      (((MonoidalCategory.tensorLeft N).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (K.extend ComplexShape.embeddingDownNat)).d (-((r + 1 : ℕ) : ℤ)) (-(r : ℤ)) ≫
      (tensorExtendXIso N K r).hom =
        (MonoidalCategory.tensorLeft N).map (K.d (r + 1) r) := by
  let T := MonoidalCategory.tensorLeft N
  show T.map _ ≫ T.map _ ≫ T.map _ = _
  rw [← T.map_comp, ← T.map_comp,
    K.extend_d_eq ComplexShape.embeddingDownNat (i := r + 1) (j := r)
      (i' := -((r + 1 : ℕ) : ℤ)) (j' := -(r : ℤ)) (by rfl) (by rfl)]
  simp [T]

private theorem tensorExtendXIso_map
    {R : Type u} [CommRing R] (N : ModuleCat.{max u v} R)
    {K L : ChainComplex (ModuleCat.{max u v} R) ℕ} (α : K ⟶ L) (r : ℕ) :
    (tensorExtendXIso N K r).inv ≫
      (((MonoidalCategory.tensorLeft N).mapHomologicalComplex (ComplexShape.up ℤ)).map
        (HomologicalComplex.extendMap α ComplexShape.embeddingDownNat)).f (-(r : ℤ)) ≫
      (tensorExtendXIso N L r).hom =
        (MonoidalCategory.tensorLeft N).map (α.f r) := by
  let T := MonoidalCategory.tensorLeft N
  show T.map _ ≫ T.map _ ≫ T.map _ = _
  rw [← T.map_comp, ← T.map_comp,
    HomologicalComplex.extendMap_f α ComplexShape.embeddingDownNat (i := r)
      (i' := -(r : ℤ)) (by rfl)]
  simp [T]

/-- The comparison of the two Koszul resolutions of `B`, over `P` and over `P ⊗_A B`, given by
the coefficient matrix is a quasi-isomorphism: both resolve `B`, and in degree zero the
comparison induces the isomorphism `P/(f_1, …, f_n) ≅ (P ⊗_A B)/(g_1, …, g_n)`. -/
private theorem quasiIso_coefficientBaseChangeKoszulChainMapULift
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B]
    {n : ℕ} (f : Fin (n + 2) → P) (g : Fin (n + 2) → P ⊗[A] B)
    (gij : Matrix (Fin (n + 2)) (Fin (n + 2)) (P ⊗[A] B)) (q : P →ₐ[A] B)
    (hcoeff' : ∀ i, algebraMap P (P ⊗[A] B) (f i) = ∑ j, gij i j * g j)
    (hf : Koszul.IsKoszulRegular f) (hg : Koszul.IsKoszulRegular g)
    (hq : Function.Surjective q)
    (hkerq : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (hkerg : RingHom.ker
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom =
        Ideal.span (Set.range g)) :
    QuasiIso (coefficientBaseChangeKoszulChainMapULift f g gij hcoeff') := by
  set α := coefficientBaseChangeKoszulChainMapULift f g gij hcoeff'
  let ρ : (P ⊗[A] B) →+* B :=
    (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom
  have hρ : Function.Surjective ρ := fun b => ⟨(1 : P) ⊗ₜ[A] b, by
    simp [ρ, Algebra.TensorProduct.productLeftAlgHom, Algebra.TensorProduct.lift_tmul]⟩
  have hρq : ρ.comp (algebraMap P (P ⊗[A] B)) = q.toRingHom := RingHom.ext fun p => by
    simp [ρ, Algebra.TensorProduct.productLeftAlgHom, Algebra.TensorProduct.lift_tmul]
  let eP := RingHom.quotientKerEquivOfSurjective hq
  let eR := RingHom.quotientKerEquivOfSurjective hρ
  let eQ := eP.trans eR.symm
  have heQ (p : P) :
      eQ (Ideal.Quotient.mk (RingHom.ker q.toRingHom) p) =
        Ideal.Quotient.mk (RingHom.ker ρ)
          (algebraMap P (P ⊗[A] B) p) := by
    apply eR.injective
    show eR (eR.symm
      (eP (Ideal.Quotient.mk (RingHom.ker q.toRingHom) p))) = _
    rw [eR.apply_symm_apply]
    show q p = ρ (algebraMap P (P ⊗[A] B) p)
    exact (congrArg (fun h : P →+* B => h p) hρq).symm
  let eAlgQ :
      (P ⧸ RingHom.ker q.toRingHom) ≃ₐ[P]
        ((P ⊗[A] B) ⧸ RingHom.ker ρ) :=
    AlgEquiv.ofRingEquiv heQ
  let K := ((ModuleCat.uliftFunctor.{max v w, v} P).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)
  let L := ((ModuleCat.restrictScalars (algebraMap P (P ⊗[A] B))).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj
      (((ModuleCat.uliftFunctor.{v, max v w} (P ⊗[A] B)).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))
  have hαzero (x : K.X 0) :
      exteriorPower.zeroEquiv (P ⊗[A] B) (Fin (n + 2) → P ⊗[A] B)
          (((α.f 0).hom x).down) =
        algebraMap P (P ⊗[A] B)
          (exteriorPower.zeroEquiv P (Fin (n + 2) → P) x.down) :=
    coefficientBaseChangeLinearMap_zero gij x.down
  let FK := ModuleCat.uliftFunctor.{max v w, v} P
  let FUR := ModuleCat.uliftFunctor.{v, max v w} (P ⊗[A] B)
  let FR := ModuleCat.restrictScalars (algebraMap P (P ⊗[A] B))
  let U := (FUR.mapHomologicalComplex (ComplexShape.down ℕ)).obj
    (Koszul.seqComplex g)
  let hK0 : K.homology 0 ≅
      FK.obj (ModuleCat.of P (P ⧸ Ideal.span (Set.range f))) :=
    (CategoryTheory.ShortComplex.mapHomologyIso
      ((Koszul.seqComplex f).sc 0) FK) ≪≫
        FK.mapIso (koszulHomologyZeroIso f)
  let hL0 : L.homology 0 ≅
      FR.obj (FUR.obj
        (ModuleCat.of (P ⊗[A] B)
          ((P ⊗[A] B) ⧸ Ideal.span (Set.range g)))) :=
    (CategoryTheory.ShortComplex.mapHomologyIso (U.sc 0) FR) ≪≫
      FR.mapIso ((CategoryTheory.ShortComplex.mapHomologyIso
        ((Koszul.seqComplex g).sc 0) FUR) ≪≫
          FUR.mapIso (koszulHomologyZeroIso g))
  have hkerρ : RingHom.ker ρ = Ideal.span (Set.range g) := hkerg
  have hKcat :
      K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv ≫ hK0.hom =
        FK.map (ModuleCat.ofHom
          ((Ideal.span (Set.range f)).mkQ.comp
            (exteriorPower.zeroEquiv P (Fin (n + 2) → P)).toLinearMap)) :=
    chain_zero_homology_map_fac_iso (Koszul.seqComplex f) FK
      (koszulHomologyZeroIso f) (koszulHomologyZeroIso_fac f)
  have hKfac (z : K.X 0) :
      ((K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv ≫
        hK0.hom).hom z).down =
        Ideal.Quotient.mk (Ideal.span (Set.range f))
          (exteriorPower.zeroEquiv P (Fin (n + 2) → P) z.down) :=
    congrArg ULift.down (ConcreteCategory.congr_hom hKcat z)
  let hU0 : U.homology 0 ≅
      FUR.obj (ModuleCat.of (P ⊗[A] B)
        ((P ⊗[A] B) ⧸ Ideal.span (Set.range g))) :=
    ((Koszul.seqComplex g).sc 0).mapHomologyIso FUR ≪≫
      FUR.mapIso (koszulHomologyZeroIso g)
  have hUcat :
      U.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ U).inv ≫ hU0.hom =
        FUR.map (ModuleCat.ofHom
          ((Ideal.span (Set.range g)).mkQ.comp
            (exteriorPower.zeroEquiv (P ⊗[A] B)
              (Fin (n + 2) → P ⊗[A] B)).toLinearMap)) :=
    chain_zero_homology_map_fac_iso (Koszul.seqComplex g) FUR
      (koszulHomologyZeroIso g) (koszulHomologyZeroIso_fac g)
  have hLcat :
      L.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ L).inv ≫ hL0.hom =
        FR.map (FUR.map (ModuleCat.ofHom
          ((Ideal.span (Set.range g)).mkQ.comp
            (exteriorPower.zeroEquiv (P ⊗[A] B)
              (Fin (n + 2) → P ⊗[A] B)).toLinearMap))) :=
    chain_zero_homology_map_fac_iso U FR hU0 hUcat
  have hLfac (z : L.X 0) :
      ((L.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ L).inv ≫
        hL0.hom).hom z).down =
        Ideal.Quotient.mk (Ideal.span (Set.range g))
          (exteriorPower.zeroEquiv (P ⊗[A] B)
            (Fin (n + 2) → P ⊗[A] B) z.down) :=
    congrArg ULift.down (ConcreteCategory.congr_hom hLcat z)
  let eKS := Ideal.quotientEquivAlgOfEq P hkerq.symm
  let eRS := Ideal.quotientEquivAlgOfEq P hkerρ.symm
  let eSpan :
      (P ⧸ Ideal.span (Set.range f)) ≃ₐ[P]
        ((P ⊗[A] B) ⧸ Ideal.span (Set.range g)) :=
    (eKS.trans eAlgQ).trans eRS.symm
  have heSpan (p : P) :
      eSpan (Ideal.Quotient.mk (Ideal.span (Set.range f)) p) =
        Ideal.Quotient.mk (Ideal.span (Set.range g))
          (algebraMap P (P ⊗[A] B) p) := by
    simp only [eSpan, AlgEquiv.trans_apply, eKS, eRS,
      Ideal.quotientEquivAlgOfEq_mk]
    have heAlg : eAlgQ (Ideal.Quotient.mk (RingHom.ker q.toRingHom) p) =
        Ideal.Quotient.mk (RingHom.ker ρ)
          (algebraMap P (P ⊗[A] B) p) := heQ p
    rw [heAlg, Ideal.quotientEquivAlgOfEq_symm]
    exact Ideal.quotientEquivAlgOfEq_mk P hkerρ _
  let : Module P (FUR.obj (ModuleCat.of (P ⊗[A] B)
      ((P ⊗[A] B) ⧸ Ideal.span (Set.range g)))) :=
    Module.compHom _ (algebraMap P (P ⊗[A] B))
  let tSpan : FK.obj (ModuleCat.of P (P ⧸ Ideal.span (Set.range f))) ⟶
      FR.obj (FUR.obj (ModuleCat.of (P ⊗[A] B)
        ((P ⊗[A] B) ⧸ Ideal.span (Set.range g)))) :=
    ModuleCat.ofHom
      { toFun := fun x => ULift.up (eSpan x.down)
        map_add' x y := ULift.ext _ _ (eSpan.toLinearEquiv.map_add x.down y.down)
        map_smul' := by
          intro a x
          apply ULift.ext
          have hs : (a • x).down = a • x.down := rfl
          rw [hs]
          show eSpan (a • x.down) =
            (algebraMap P (P ⊗[A] B) a) • eSpan x.down
          rw [IsScalarTower.algebraMap_smul]
          exact eSpan.toLinearEquiv.map_smul a x.down }
  have htSpan : Function.Bijective tSpan.hom :=
    ⟨fun x y hxy => ULift.ext _ _ (eSpan.injective (congrArg ULift.down hxy)),
      fun y => ⟨ULift.up (eSpan.symm y.down), ULift.ext _ _ (eSpan.apply_symm_apply y.down)⟩⟩
  let eULSpan := (LinearEquiv.ofBijective tSpan.hom htSpan).toModuleIso
  let eHSpan : K.homology 0 ≅ L.homology 0 :=
    hK0 ≪≫ eULSpan ≪≫ hL0.symm
  have heHSpan : eHSpan.hom ≫ hL0.hom = hK0.hom ≫ eULSpan.hom := by
    dsimp only [eHSpan, Iso.trans_hom, Iso.symm_hom]
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hQcat :
      α.f 0 ≫ L.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ L).inv ≫ hL0.hom =
        K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv ≫
          hK0.hom ≫ eULSpan.hom := by
    refine ModuleCat.hom_ext (LinearMap.ext fun z => ULift.ext _ _ ?_)
    show ((L.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ L).inv ≫
        hL0.hom).hom ((α.f 0).hom z)).down =
      (eULSpan.hom.hom ((K.pOpcycles 0 ≫
        (ChainComplex.isoHomologyι₀ K).inv ≫ hK0.hom).hom z)).down
    rw [hLfac]
    show Ideal.Quotient.mk (Ideal.span (Set.range g))
        (exteriorPower.zeroEquiv (P ⊗[A] B)
          (Fin (n + 2) → P ⊗[A] B) (((α.f 0).hom z).down)) =
      eSpan (((K.pOpcycles 0 ≫
        (ChainComplex.isoHomologyι₀ K).inv ≫ hK0.hom).hom z).down)
    rw [hKfac z, hαzero z, heSpan]
  have hKpos (i : ℕ) (hi : i ≠ 0) :
      CategoryTheory.Limits.IsZero (K.homology i) :=
    isZero_homology_ulift f i (hf i hi)
  have hLpos (i : ℕ) (hi : i ≠ 0) :
      CategoryTheory.Limits.IsZero (L.homology i) :=
    isZero_homology_ulift_restrict g i (hg i hi)
  have hαH0 : HomologicalComplex.homologyMap α 0 = eHSpan.hom := by
    apply (cancel_epi (K.pOpcycles 0 ≫
      (ChainComplex.isoHomologyι₀ K).inv)).mp
    apply (cancel_mono hL0.hom).mp
    calc
      (K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv) ≫
          HomologicalComplex.homologyMap α 0 ≫ hL0.hom =
        α.f 0 ≫ L.pOpcycles 0 ≫
          (ChainComplex.isoHomologyι₀ L).inv ≫ hL0.hom := by
            simpa only [Category.assoc] using
              congrArg (fun m => m ≫ hL0.hom)
                (chain_zero_homology_naturality α)
      _ = K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv ≫
            hK0.hom ≫ eULSpan.hom := hQcat
      _ = (K.pOpcycles 0 ≫ (ChainComplex.isoHomologyι₀ K).inv) ≫
            eHSpan.hom ≫ hL0.hom := by
            rw [heHSpan]
            simp only [Category.assoc]
  have hαiso : CategoryTheory.IsIso (HomologicalComplex.homologyMap α 0) := by
    rw [hαH0]
    infer_instance
  exact quasiIso_of_isZero_positive_homology α hKpos hLpos hαiso

/-- The coefficient comparison of the universe-lifted Koszul complexes of `f` and of `g`,
extended to cochain complexes and tensored over `P` with `B`. -/
private noncomputable abbrev tensoredExtendedComparison
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Algebra P B]
    {n : ℕ} (f : Fin n → P) (g : Fin n → P ⊗[A] B)
    (gij : Matrix (Fin n) (Fin n) (P ⊗[A] B))
    (h : ∀ i, algebraMap P (P ⊗[A] B) (f i) = ∑ j, gij i j * g j) :=
  ((CategoryTheory.MonoidalCategory.tensorLeft
      (ModuleCat.of P (ULift.{max v w} B))).mapHomologicalComplex (ComplexShape.up ℤ)).map
    (HomologicalComplex.extendMap (coefficientBaseChangeKoszulChainMapULift f g gij h)
      ComplexShape.embeddingDownNat)

/-- In top degree the tensored comparison of the two Koszul resolutions is an isomorphism on
cycles: both complexes vanish one degree further up, so there cycles agree with homology. -/
private theorem isIso_cyclesMap_tensoredExtendedComparison
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Module.Flat A B] [Algebra P B]
    {n : ℕ} (f : Fin (n + 2) → P) (g : Fin (n + 2) → P ⊗[A] B)
    (gij : Matrix (Fin (n + 2)) (Fin (n + 2)) (P ⊗[A] B))
    (hcoeff' : ∀ i, algebraMap P (P ⊗[A] B) (f i) = ∑ j, gij i j * g j)
    (hqi : QuasiIso (coefficientBaseChangeKoszulChainMapULift f g gij hcoeff')) :
    CategoryTheory.IsIso (HomologicalComplex.cyclesMap
      (tensoredExtendedComparison f g gij hcoeff') (-((n + 2 : ℕ) : ℤ))) := by
  let α := coefficientBaseChangeKoszulChainMapULift f g gij hcoeff'
  let : Module.Flat P (P ⊗[A] B) := Module.Flat.baseChange A P B
  have hK := koszulSeq_ulift_kFlat.{v, max v w} f
  have hL := koszulSeq_ulift_restrict_kFlat
    (P := P) (R := P ⊗[A] B) g
  let K := ((ModuleCat.uliftFunctor.{max v w, v} P).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)
  let L := ((ModuleCat.restrictScalars (algebraMap P (P ⊗[A] B))).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj
      (((ModuleCat.uliftFunctor.{v, max v w} (P ⊗[A] B)).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))
  let FK := ModuleCat.uliftFunctor.{max v w, v} P
  let FUR := ModuleCat.uliftFunctor.{v, max v w} (P ⊗[A] B)
  let FR := ModuleCat.restrictScalars (algebraMap P (P ⊗[A] B))
  have : QuasiIso α := hqi
  let α' := HomologicalComplex.extendMap α ComplexShape.embeddingDownNat
  have : QuasiIso α' := inferInstance
  let N : ModuleCat.{max v w} P := ModuleCat.of P (ULift.{max v w} B)
  have hαTensor : QuasiIso
      (((CategoryTheory.MonoidalCategory.tensorLeft N).mapHomologicalComplex
        (ComplexShape.up ℤ)).map α') :=
    quasiIso_tensorModule_map N α' hK hL
  let T := CategoryTheory.MonoidalCategory.tensorLeft N
  let CT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).obj
    (K.extend ComplexShape.embeddingDownNat)
  let DT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).obj
    (L.extend ComplexShape.embeddingDownNat)
  let β : CT ⟶ DT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).map α'
  have hKabove : CategoryTheory.Limits.IsZero (K.X (n + 3)) :=
    FK.map_isZero (koszul_isZero_X_of_lt f (n + 3) (by omega))
  have hLabove : CategoryTheory.Limits.IsZero (L.X (n + 3)) :=
    FR.map_isZero (FUR.map_isZero
      (koszul_isZero_X_of_lt g (n + 3) (by omega)))
  have hCTabove : CategoryTheory.Limits.IsZero
      (CT.X (-((n + 3 : ℕ) : ℤ))) :=
    T.map_isZero (hKabove.of_iso (K.extendXIso ComplexShape.embeddingDownNat (i := n + 3) rfl))
  have hDTabove : CategoryTheory.Limits.IsZero
      (DT.X (-((n + 3 : ℕ) : ℤ))) :=
    T.map_isZero (hLabove.of_iso (L.extendXIso ComplexShape.embeddingDownNat (i := n + 3) rfl))
  have hprev : (ComplexShape.up ℤ).prev (-((n + 2 : ℕ) : ℤ)) =
      -((n + 3 : ℕ) : ℤ) := by
    apply (ComplexShape.up ℤ).prev_eq'
    show (-((n + 3 : ℕ) : ℤ)) + 1 = -((n + 2 : ℕ) : ℤ)
    omega
  have hCTd : CT.d (-((n + 3 : ℕ) : ℤ)) (-((n + 2 : ℕ) : ℤ)) = 0 :=
    hCTabove.eq_of_src _ _
  have hDTd : DT.d (-((n + 3 : ℕ) : ℤ)) (-((n + 2 : ℕ) : ℤ)) = 0 :=
    hDTabove.eq_of_src _ _
  have : CategoryTheory.IsIso (CT.homologyπ (-((n + 2 : ℕ) : ℤ))) :=
    CT.isIso_homologyπ (-((n + 3 : ℕ) : ℤ)) _ hprev hCTd
  have : CategoryTheory.IsIso (DT.homologyπ (-((n + 2 : ℕ) : ℤ))) :=
    DT.isIso_homologyπ (-((n + 3 : ℕ) : ℤ)) _ hprev hDTd
  have : CategoryTheory.IsIso
      (HomologicalComplex.homologyMap β (-((n + 2 : ℕ) : ℤ))) :=
    (quasiIsoAt_iff_isIso_homologyMap β _).mp
      ((quasiIso_iff β).mp hαTensor _)
  exact CategoryTheory.IsIso.of_isIso_fac_right
    (HomologicalComplex.homologyπ_naturality β (-((n + 2 : ℕ) : ℤ))).symm

/-- The universe-lifted Koszul complex of `f`, extended to a cochain complex and tensored over
`P` with `B`. -/
private noncomputable abbrev tensoredExtendedKoszul
    {P : Type v} {B : Type w} [CommRing P] [CommRing B] [Algebra P B]
    {m : ℕ} (f : Fin m → P) :=
  ((CategoryTheory.MonoidalCategory.tensorLeft
      (ModuleCat.of P (ULift.{max v w} B))).mapHomologicalComplex (ComplexShape.up ℤ)).obj
    ((((ModuleCat.uliftFunctor.{max v w, v} P).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)).extend
      ComplexShape.embeddingDownNat)

/-- Over an algebra in which every `f i` becomes zero, the tensored Koszul differential of `f`
vanishes in every degree. -/
private theorem tensoredExtendedKoszul_d_eq_zero
    {P : Type v} {B : Type w} [CommRing P] [CommRing B] [Algebra P B]
    {m : ℕ} (f : Fin m → P) (hfzero : ∀ i, algebraMap P B (f i) = 0) (r : ℕ) :
    (tensoredExtendedKoszul (B := B) f).d (-((r + 1 : ℕ) : ℤ)) (-(r : ℤ)) = 0 := by
  let K := ((ModuleCat.uliftFunctor.{max v w, v} P).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)
  let N : ModuleCat.{max v w} P := ModuleCat.of P (ULift.{max v w} B)
  let T := CategoryTheory.MonoidalCategory.tensorLeft N
  let CT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).obj
    (K.extend ComplexShape.embeddingDownNat)
  let uK (s : ℕ) : T.obj (K.X s) ≃ₗ[P] (B ⊗[P] (⋀[P]^s (Fin m → P))) :=
    by
      show (ULift.{max v w} B ⊗[P] ULift.{max v w} (⋀[P]^s (Fin m → P))) ≃ₗ[P] _
      exact TensorProduct.congr ULift.moduleEquiv ULift.moduleEquiv
  let eK (s : ℕ) : CT.X (-(s : ℤ)) ≃ₗ[P] (B ⊗[P] (⋀[P]^s (Fin m → P))) :=
    (tensorExtendXIso N K s).toLinearEquiv.trans (uK s)
  have hKd (s : ℕ) (x : B ⊗[P] (⋀[P]^(s + 1) (Fin m → P))) :
      eK s ((CT.d (-((s + 1 : ℕ) : ℤ)) (-(s : ℤ))).hom ((eK (s + 1)).symm x)) =
        (LinearMap.lTensor B (Koszul.d (Koszul.seqDual f) s)) x := by
    have h := congrArg (uK s)
      (ConcreteCategory.congr_hom (tensorExtendXIso_d N K s) ((uK (s + 1)).symm x))
    change eK s ((CT.d (-((s + 1 : ℕ) : ℤ)) (-(s : ℤ))).hom
      ((eK (s + 1)).symm x)) = _ at h
    refine h.trans ?_
    clear h
    induction x with
    | zero => simp
    | tmul b z =>
        show b ⊗ₜ[P] ((K.d (s + 1) s).hom (ULift.up z)).down =
          b ⊗ₜ[P] Koszul.d (Koszul.seqDual f) s z
        simp only [K, Functor.mapHomologicalComplex_obj_d, Koszul.seqComplex_d]
        rfl
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  refine ModuleCat.hom_ext (LinearMap.ext fun x => (eK r).injective ?_)
  have h := hKd r (eK (r + 1) x)
  simp only [LinearEquiv.symm_apply_apply] at h
  show eK r ((CT.d _ _).hom x) = eK r 0
  rw [h, map_zero]
  exact lTensor_koszul_d_eq_zero f hfzero r (eK (r + 1) x)

/-- In top degree the tensored coefficient comparison of the two Koszul resolutions is injective,
and every cycle of the second tensored Koszul resolution lies in its image. -/
private theorem lTensor_comparison_injective_and_surjective
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Algebra P B]
    {n : ℕ} (f : Fin (n + 2) → P) (g : Fin (n + 2) → P ⊗[A] B)
    (gij : Matrix (Fin (n + 2)) (Fin (n + 2)) (P ⊗[A] B))
    (hcoeff' : ∀ i, algebraMap P (P ⊗[A] B) (f i) = ∑ j, gij i j * g j)
    (hfzero : ∀ i, algebraMap P B (f i) = 0)
    (hβiso : CategoryTheory.IsIso (HomologicalComplex.cyclesMap
      (tensoredExtendedComparison f g gij hcoeff') (-((n + 2 : ℕ) : ℤ)))) :
    Function.Injective (LinearMap.lTensor B
      (coefficientBaseChangeLinearMap (P := P) gij (n + 2))) ∧
    ∀ y : B ⊗[P] (⋀[P ⊗[A] B]^(n + 2) (Fin (n + 2) → P ⊗[A] B)),
      (LinearMap.lTensor B
        ((Koszul.d (Koszul.seqDual g) (n + 1)).restrictScalars P)) y = 0 →
        ∃ x, (LinearMap.lTensor B
          (coefficientBaseChangeLinearMap (P := P) gij (n + 2))) x = y := by
  let α := coefficientBaseChangeKoszulChainMapULift f g gij hcoeff'
  let α' := HomologicalComplex.extendMap α ComplexShape.embeddingDownNat
  let K := ((ModuleCat.uliftFunctor.{max v w, v} P).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj (Koszul.seqComplex f)
  let L := ((ModuleCat.restrictScalars (algebraMap P (P ⊗[A] B))).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj
      (((ModuleCat.uliftFunctor.{v, max v w} (P ⊗[A] B)).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj (Koszul.seqComplex g))
  let N : ModuleCat.{max v w} P := ModuleCat.of P (ULift.{max v w} B)
  let T := CategoryTheory.MonoidalCategory.tensorLeft N
  let CT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).obj
    (K.extend ComplexShape.embeddingDownNat)
  let DT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).obj
    (L.extend ComplexShape.embeddingDownNat)
  let β : CT ⟶ DT := (T.mapHomologicalComplex (ComplexShape.up ℤ)).map α'
  have : CategoryTheory.IsIso
      (HomologicalComplex.cyclesMap β (-((n + 2 : ℕ) : ℤ))) := hβiso
  let uK (r : ℕ) : T.obj (K.X r) ≃ₗ[P]
      (B ⊗[P] (⋀[P]^r (Fin (n + 2) → P))) :=
    by
      show (ULift.{max v w} B ⊗[P]
        ULift.{max v w} (⋀[P]^r (Fin (n + 2) → P))) ≃ₗ[P] _
      exact TensorProduct.congr ULift.moduleEquiv ULift.moduleEquiv
  let uL (r : ℕ) : T.obj (L.X r) ≃ₗ[P]
      (B ⊗[P] (⋀[P ⊗[A] B]^r (Fin (n + 2) → P ⊗[A] B))) :=
    by
      show (ULift.{max v w} B ⊗[P]
        ULift.{v} (⋀[P ⊗[A] B]^r (Fin (n + 2) → P ⊗[A] B))) ≃ₗ[P] _
      exact TensorProduct.congr ULift.moduleEquiv ULift.moduleEquiv
  let eK (r : ℕ) : CT.X (-(r : ℤ)) ≃ₗ[P]
      (B ⊗[P] (⋀[P]^r (Fin (n + 2) → P))) :=
    (tensorExtendXIso N K r).toLinearEquiv.trans (uK r)
  let eL (r : ℕ) : DT.X (-(r : ℤ)) ≃ₗ[P]
      (B ⊗[P] (⋀[P ⊗[A] B]^r (Fin (n + 2) → P ⊗[A] B))) :=
    (tensorExtendXIso N L r).toLinearEquiv.trans (uL r)
  have hβ (r : ℕ) (x : B ⊗[P] (⋀[P]^r (Fin (n + 2) → P))) :
      eL r ((β.f (-(r : ℤ))).hom ((eK r).symm x)) =
        (LinearMap.lTensor B (coefficientBaseChangeLinearMap (P := P) gij r)) x := by
    have h := congrArg (uL r)
      (ConcreteCategory.congr_hom (tensorExtendXIso_map N α r) ((uK r).symm x))
    change eL r ((β.f (-(r : ℤ))).hom ((eK r).symm x)) = _ at h
    refine h.trans ?_
    clear h
    induction x with
    | zero => simp
    | tmul b z => rfl
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  have hLd (r : ℕ)
      (x : B ⊗[P] (⋀[P ⊗[A] B]^(r + 1) (Fin (n + 2) → P ⊗[A] B))) :
      eL r ((DT.d (-((r + 1 : ℕ) : ℤ)) (-(r : ℤ))).hom ((eL (r + 1)).symm x)) =
        (LinearMap.lTensor B ((Koszul.d (Koszul.seqDual g) r).restrictScalars P)) x := by
    have h := congrArg (uL r)
      (ConcreteCategory.congr_hom (tensorExtendXIso_d N L r) ((uL (r + 1)).symm x))
    change eL r ((DT.d (-((r + 1 : ℕ) : ℤ)) (-(r : ℤ))).hom
      ((eL (r + 1)).symm x)) = _ at h
    refine h.trans ?_
    clear h
    induction x with
    | zero => simp
    | tmul b z =>
        let (j : ℕ) : Module P ((Koszul.seqComplex g).X j) :=
          inferInstanceAs (Module P
            (⋀[P ⊗[A] B]^j (Fin (n + 2) → P ⊗[A] B)))
        show b ⊗ₜ[P] (((L.d (r + 1) r).hom (ULift.up z)).down :
            ⋀[P ⊗[A] B]^r (Fin (n + 2) → P ⊗[A] B)) =
          b ⊗ₜ[P] Koszul.d (Koszul.seqDual g) r z
        simp only [L, Functor.mapHomologicalComplex_obj_d, Koszul.seqComplex_d]
        rfl
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  have hnext : (ComplexShape.up ℤ).next (-((n + 2 : ℕ) : ℤ)) = -((n + 1 : ℕ) : ℤ) := by
    apply (ComplexShape.up ℤ).next_eq'
    show -((n + 2 : ℕ) : ℤ) + 1 = -((n + 1 : ℕ) : ℤ)
    omega
  have hKdzero : CT.d (-((n + 2 : ℕ) : ℤ)) (-((n + 1 : ℕ) : ℤ)) = 0 :=
    tensoredExtendedKoszul_d_eq_zero f hfzero (n + 1)
  obtain ⟨hinj, hsurj⟩ := injective_and_surjective_cycles β
    (-((n + 2 : ℕ) : ℤ)) (-((n + 1 : ℕ) : ℤ)) hnext hKdzero
  refine ⟨fun x y hxy => (eK (n + 2)).symm.injective <| hinj <| (eL (n + 2)).injective <|
    (hβ (n + 2) x).trans (hxy.trans (hβ (n + 2) y).symm), fun y hy => ?_⟩
  have hcycle : (DT.d (-((n + 2 : ℕ) : ℤ)) (-((n + 1 : ℕ) : ℤ))).hom
      ((eL (n + 2)).symm y) = 0 :=
    (eL (n + 1)).injective (((hLd (n + 1) y).trans hy).trans (map_zero _).symm)
  obtain ⟨x, hx⟩ := hsurj _ hcycle
  refine ⟨eK (n + 2) x, ?_⟩
  have h := hβ (n + 2) (eK (n + 2) x)
  simp only [LinearEquiv.symm_apply_apply] at h
  rw [hx, LinearEquiv.apply_symm_apply] at h
  exact h.symm

/-- The case `n ≥ 2` of `Stacks.Discriminant.exists_linearEquiv_annihilator_ker_lmul`, where the
comparison of the two Koszul resolutions is a genuine quasi-isomorphism of complexes of length
at least two and the annihilator is read off from the top homology. -/
private theorem exists_linearEquiv_annihilator_ker_lmul_of_two_le
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Module.Flat A B]
    {n : ℕ} (f : Fin (n + 2) → P) (g : Fin (n + 2) → P ⊗[A] B)
    (gij : Matrix (Fin (n + 2)) (Fin (n + 2)) (P ⊗[A] B)) (q : P →ₐ[A] B)
    (hf : Koszul.IsKoszulRegular f)
    (hq : Function.Surjective q)
    (hkerq : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (hg : Koszul.IsKoszulRegular g)
    (hkerg : RingHom.ker
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom =
        Ideal.span (Set.range g))
    (hcoeff : ∀ i, f i ⊗ₜ[A] (1 : B) = ∑ j, gij i j * g j) :
    ∃ e : B ≃ₗ[B] (RingHom.ker
      (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B).toRingHom).annihilator,
      ∀ b, (e b : B ⊗[A] B) =
        b • Algebra.TensorProduct.map q (AlgHom.id A B) (Matrix.det gij) := by
  have hcoeff' : ∀ i, algebraMap P (P ⊗[A] B) (f i) = ∑ j, gij i j * g j := fun i => by
    simpa using hcoeff i
  let : Algebra P B := q.toRingHom.toAlgebra
  have : IsScalarTower A P B := IsScalarTower.of_algebraMap_eq
    (fun a => (q.commutes a).symm)
  have hfzero : ∀ i, algebraMap P B (f i) = 0 := fun i =>
    RingHom.mem_ker.mp (hkerq ▸ Ideal.subset_span (Set.mem_range_self i))
  have hqi : QuasiIso (coefficientBaseChangeKoszulChainMapULift f g gij hcoeff') :=
    quasiIso_coefficientBaseChangeKoszulChainMapULift f g gij q hcoeff' hf hg hq hkerq hkerg
  have hβiso := isIso_cyclesMap_tensoredExtendedComparison f g gij hcoeff' hqi
  have h := lTensor_comparison_injective_and_surjective f g gij hcoeff' hfzero hβiso
  exact annihilator_equiv_of_tensor_comparison f g gij q (fun _ => rfl) hq hkerq hkerg hcoeff
    h.1 h.2

/-- For a flat quotient `B = P/(f_1, …, f_n)` by a Koszul-regular sequence, if a Koszul-regular
sequence `g` generates the kernel of the multiplication map `P ⊗_A B → B` and
`f_i ⊗ 1 = ∑_j g_{ij} g_j`, then multiplication by the image of `det(g_{ij})` is a `B`-linear
isomorphism from `B` onto the annihilator of `Ker(B ⊗_A B → B)`. -/
theorem exists_linearEquiv_annihilator_ker_lmul
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Module.Flat A B]
    {n : ℕ} (f : Fin n → P) (g : Fin n → P ⊗[A] B)
    (gij : Matrix (Fin n) (Fin n) (P ⊗[A] B)) (q : P →ₐ[A] B)
    (hf : Koszul.IsKoszulRegular f)
    (hq : Function.Surjective q)
    (hkerq : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (hg : Koszul.IsKoszulRegular g)
    (hkerg : RingHom.ker
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom =
        Ideal.span (Set.range g))
    (hcoeff : ∀ i, f i ⊗ₜ[A] (1 : B) = ∑ j, gij i j * g j) :
    ∃ e : B ≃ₗ[B] (RingHom.ker
      (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B).toRingHom).annihilator,
      ∀ b, (e b : B ⊗[A] B) =
        b • Algebra.TensorProduct.map q (AlgHom.id A B) (Matrix.det gij) := by
  let φ : (P ⊗[A] B) →+* (B ⊗[A] B) :=
    (Algebra.TensorProduct.map q (AlgHom.id A B)).toRingHom
  let ψ : (B ⊗[A] B) →+* B := (Algebra.TensorProduct.lmul' A).toRingHom
  have hφ : Function.Surjective φ :=
    Algebra.TensorProduct.map_surjective q (AlgHom.id A B) hq (fun b => ⟨b, rfl⟩)
  have hψ (b : B) : ψ (algebraMap B (B ⊗[A] B) b) = b := by
    simp [ψ, Algebra.TensorProduct.lmul'_apply_tmul]
  have hkerφ : RingHom.ker φ =
      Ideal.span (Set.range (fun i : Fin n => f i ⊗ₜ[A] (1 : B))) := by
    show RingHom.ker (Algebra.TensorProduct.map q (AlgHom.id A B)) = _
    rw [Algebra.TensorProduct.rTensor_ker q hq]
    show Ideal.map Algebra.TensorProduct.includeLeft (RingHom.ker q.toRingHom) = _
    rw [hkerq, Ideal.map_span]
    congr 1
    ext x
    simp [Set.mem_image, Set.mem_range]
  have hcomp : ψ.comp φ =
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom := by
    refine RingHom.ext fun x => ?_
    induction x with
    | zero => simp
    | tmul a b => simp [φ, ψ, Algebra.TensorProduct.productLeftAlgHom,
        Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lift_tmul]
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
  have hkercomp : RingHom.ker (ψ.comp φ) = Ideal.span (Set.range g) := by
    rwa [hcomp]
  cases n with
  | zero =>
      have hkercomp0 : RingHom.ker (ψ.comp φ) = ⊥ := by
        simpa [Set.range_eq_empty] using hkercomp
      have hkerψ : RingHom.ker ψ = ⊥ := by
        apply le_antisymm _ bot_le
        intro x hx
        obtain ⟨y, rfl⟩ := hφ x
        have hy : y ∈ RingHom.ker (ψ.comp φ) := RingHom.mem_ker.mpr (RingHom.mem_ker.mp hx)
        have hy0 : y = 0 := (Submodule.mem_bot _).mp (hkercomp0 ▸ hy)
        subst y
        simp
      have hz : (1 : B ⊗[A] B) ∈ (RingHom.ker ψ).annihilator := by
        rw [hkerψ, Submodule.annihilator_bot]
        exact Submodule.mem_top
      have hspan : (RingHom.ker ψ).annihilator =
          Ideal.span {(1 : B ⊗[A] B)} := by
        rw [hkerψ, Submodule.annihilator_bot, Ideal.span_singleton_one]
      have hreg : ∀ b : B, b • (1 : B ⊗[A] B) = 0 → b = 0 := fun b hb =>
        (hψ b).symm.trans (by simpa [Algebra.smul_def] using congrArg ψ hb)
      obtain ⟨e, he⟩ := linearEquiv_annihilator_of_principal ψ hψ 1 hz hspan hreg
      refine ⟨e, fun b => ?_⟩
      convert he b using 1
      simp [Matrix.det_fin_zero]
  | succ n =>
      cases n with
      | zero =>
          let F : P ⊗[A] B := f 0 ⊗ₜ[A] (1 : B)
          let G : P ⊗[A] B := g 0
          let a : P ⊗[A] B := gij 0 0
          have hfg : F = a * G := by simpa [F, G, a] using hcoeff 0
          have hreg : Koszul.IsKoszulRegular
              (fun i : Fin 1 => f i ⊗ₜ[A] (1 : B)) := by
            let : Module.Flat P (P ⊗[A] B) := Module.Flat.baseChange A P B
            simpa using koszulRegular_algebraMap (R := P) (S := P ⊗[A] B) hf
          have hF : IsSMulRegular (P ⊗[A] B) F :=
            isSMulRegular_of_koszulRegular_singleton _ hreg
          have hG : IsSMulRegular (P ⊗[A] B) G :=
            isSMulRegular_of_koszulRegular_singleton g hg
          have hkerφ' : RingHom.ker φ = Ideal.span {F} := by
            rwa [range_fin_one] at hkerφ
          have hkercomp' : RingHom.ker (ψ.comp φ) = Ideal.span {G} := by
            rwa [range_fin_one] at hkercomp
          obtain ⟨e, he⟩ := linearEquiv_annihilator_rank_one
            F G a hfg hF hG φ ψ hφ hψ hkerφ' hkercomp'
          refine ⟨e, fun b => ?_⟩
          convert he b using 1
          simp [a, φ]
      | succ n =>
          exact exists_linearEquiv_annihilator_ker_lmul_of_two_le f g gij q hf hq hkerq hg
            hkerg hcoeff

/-- **Stacks Project, Tag 0BWC.** Let `f_1, …, f_n` be a Koszul-regular sequence in a ring `P`
over `A` with `B = P/(f_1, …, f_n)` flat over `A`, let `g_1, …, g_n` be a Koszul-regular sequence
generating the kernel of `P ⊗_A B → B`, and write `f_i ⊗ 1 = ∑_j g_{ij} g_j`. The annihilator of
`Ker(B ⊗_A B → B)` is the principal ideal generated by the image of `det(g_{ij})`. -/
@[stacks 0BWC]
theorem annihilator_ker_lmul_eq_span_det
    {A : Type u} {P : Type v} {B : Type w}
    [CommRing A] [CommRing P] [CommRing B]
    [Algebra A P] [Algebra A B] [Module.Flat A B]
    {n : ℕ} (f : Fin n → P) (g : Fin n → P ⊗[A] B)
    (gij : Matrix (Fin n) (Fin n) (P ⊗[A] B)) (q : P →ₐ[A] B)
    (hf : Koszul.IsKoszulRegular f)
    (hq : Function.Surjective q)
    (hkerq : RingHom.ker q.toRingHom = Ideal.span (Set.range f))
    (hg : Koszul.IsKoszulRegular g)
    (hkerg : RingHom.ker
      (Algebra.TensorProduct.productLeftAlgHom q (AlgHom.id A B)).toRingHom =
        Ideal.span (Set.range g))
    (hcoeff : ∀ i, f i ⊗ₜ[A] (1 : B) = ∑ j, gij i j * g j) :
    (RingHom.ker
      (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B).toRingHom).annihilator =
      Ideal.span {Algebra.TensorProduct.map q (AlgHom.id A B) (Matrix.det gij)} := by
  obtain ⟨e, he⟩ := exists_linearEquiv_annihilator_ker_lmul
    f g gij q hf hq hkerq hg hkerg hcoeff
  apply le_antisymm
  · intro x hx
    obtain ⟨b, hb⟩ := e.surjective ⟨x, hx⟩
    have hxb : x = b • Algebra.TensorProduct.map q (AlgHom.id A B) (Matrix.det gij) := by
      rw [← he b, hb]
    rw [hxb, Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
  · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
    have hmem := (e 1).property
    rwa [he, one_smul] at hmem

end Stacks.Discriminant
