module

public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.QuasiFinite.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.CompleteIntersection.Relative
public import StacksFrontier.RingTheory.CompleteIntersection.RingMap.Criteria
public import StacksFrontier.RingTheory.Different.Formula.SquarePresentation
public import StacksFrontier.RingTheory.Syntomic.RelativeGlobalCompleteIntersection

/-!
# Localized complete intersections with as many equations as variables

Let `A` be a ring and let `h, f_1, …, f_n` be polynomials in `n` variables over `A`, and set

`B = A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`.

If `B` is quasi-finite over `A`, then `B` is a relative global complete intersection over `A`:
it is presented by the `n + 1` variables `x, x_1, …, x_n` and the `n + 1` relations
`x h - 1, f_1, …, f_n`, and that presentation is square. Consequently `B` is flat over `A` and
`A → B` is a relative local complete intersection, which is part (1) of Tag 0BWD.

## Main definitions

* `Stacks.Discriminant.localizedRelations` is the family of images of `f_1, …, f_n` in
  `A[x_1, …, x_n, 1/h]`.
* `Stacks.Discriminant.localizedCompleteIntersection` is the algebra `B`.

## Main results

* `Stacks.Discriminant.isRelativeGlobalCompleteIntersection_localizedCompleteIntersection`: `B`
  is a relative global complete intersection over `A`.
* `Stacks.Discriminant.flat_localizedCompleteIntersection`: `B` is flat over `A`.
* `Stacks.Discriminant.isLocalCompleteIntersection_localizedCompleteIntersection`: `A → B` is a
  relative local complete intersection.

## Implementation notes

The polynomial ring is `MvPolynomial (Fin n) A`, its localization away from `h` is
`Localization.Away h`, and the ideal `(f_1, …, f_n)` of the localization is the span of the
images of the `f_i`. The source assumes `n ≥ 1`; the argument and both conclusions also hold for
`n = 0`, when `B` is the localization itself, so no positivity hypothesis is imposed.

The presentation with `n + 1` variables and `n + 1` relations is
`Algebra.Presentation.localizationAwayComp` applied to the naive presentation
`A[x_1, …, x_n]/(f_1, …, f_n)` of the unlocalized quotient; squareness is read off by
`Algebra.Presentation.isRelativeGlobalCompleteIntersection_of_card_eq`. Flatness and the local
complete intersection property are then the two halves of the characterization of syntomic ring
maps, Tag 07D3.

## References

* [Stacks Project, Tag 0BWD](https://stacks.math.columbia.edu/tag/0BWD)
-/

@[expose] public section

universe u

namespace Stacks.Discriminant

variable (A : Type u) [CommRing A] (n : ℕ) (h : MvPolynomial (Fin n) A)
    (f : Fin n → MvPolynomial (Fin n) A)

/-- The images in `A[x_1, …, x_n, 1/h]` of a family `f_1, …, f_n` of polynomial equations. -/
noncomputable abbrev localizedRelations : Fin n → Localization.Away h :=
  fun i ↦ algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (f i)

/-- The algebra `A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`. -/
noncomputable abbrev localizedCompleteIntersection : Type u :=
  Localization.Away h ⧸ Ideal.span (Set.range (localizedRelations A n h f))

/-- The ideal `(f_1, …, f_n)` of `A[x_1, …, x_n, 1/h]` is the extension of the ideal
`(f_1, …, f_n)` of `A[x_1, …, x_n]`. -/
theorem span_range_localizedRelations :
    Ideal.span (Set.range (localizedRelations A n h f)) =
      (Ideal.span (Set.range f)).map
        (algebraMap (MvPolynomial (Fin n) A) (Localization.Away h)) := by
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- The quotient of `A[x_1, …, x_n, 1/h]` by the extension of the ideal `(f_1, …, f_n)` of
`A[x_1, …, x_n]`. It is the same algebra as `Stacks.Discriminant.localizedCompleteIntersection`
(`Stacks.Discriminant.localizedQuotientEquiv`), written in the form that exhibits it as the
localization `(A[x_1, …, x_n]/(f_1, …, f_n))_h`: in this form the quotient map
`A[x_1, …, x_n]/(f_1, …, f_n) → B` is the canonical one, which is what makes the standard
presentation of a principal localization available. -/
noncomputable abbrev localizedQuotient : Type u :=
  Localization.Away h ⧸ (Ideal.span (Set.range f)).map
    (algebraMap (MvPolynomial (Fin n) A) (Localization.Away h))

/-- The two descriptions of `A[x_1, …, x_n, 1/h]/(f_1, …, f_n)` agree: the ideal generated by the
images of the `f_i` is the extension of the ideal they generate. -/
noncomputable def localizedQuotientEquiv :
    localizedQuotient A n h f ≃ₐ[A] localizedCompleteIntersection A n h f :=
  Ideal.quotientEquivAlgOfEq A (span_range_localizedRelations A n h f).symm

/-- `A[x_1, …, x_n, 1/h]/(f_1, …, f_n)` is the localization away from `h` of the quotient
`A[x_1, …, x_n]/(f_1, …, f_n)`. -/
theorem isLocalization_away_localizedQuotient :
    IsLocalization.Away
      (algebraMap (MvPolynomial (Fin n) A)
        (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f)) h)
      (localizedQuotient A n h f) := by
  change IsLocalization (Submonoid.powers _) _
  rw [← Submonoid.map_powers, ← Algebra.algebraMapSubmonoid]
  infer_instance

/-- **Stacks Project, Tag 0BWD.** A quasi-finite quotient of `A[x_1, …, x_n, 1/h]` by `n`
equations is a relative global complete intersection over `A`: it is presented by the `n + 1`
variables `x, x_1, …, x_n` and the `n + 1` relations `x h - 1, f_1, …, f_n`. -/
instance isRelativeGlobalCompleteIntersection_localizedCompleteIntersection
    [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] :
    Algebra.IsRelativeGlobalCompleteIntersection A (localizedCompleteIntersection A n h f) := by
  have e := localizedQuotientEquiv A n h f
  have : Algebra.QuasiFinite A (localizedQuotient A n h f) :=
    (Algebra.QuasiFinite.iff_of_algEquiv e).mpr inferInstance
  have : IsScalarTower A (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f))
      (localizedQuotient A n h f) := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hloc := isLocalization_away_localizedQuotient A n h f
  let P : Algebra.Presentation A (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f))
      (Fin n) (Fin n) := Algebra.Presentation.naive (v := f)
  have : IsLocalization.Away
      (algebraMap P.Ring (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f)) h)
      (localizedQuotient A n h f) := hloc
  have : Algebra.IsRelativeGlobalCompleteIntersection A (localizedQuotient A n h f) :=
    .of_card_eq (P.localizationAwayComp h (localizedQuotient A n h f)) (by simp)
  exact Algebra.IsRelativeGlobalCompleteIntersection.of_algEquiv e

/-- **Stacks Project, Tag 0BWD (1).** A quotient of `A[x_1, …, x_n, 1/h]` by `n` equations is
flat over `A` as soon as it is quasi-finite over `A`. The statement also holds for `n = 0`, when
the quotient is simply the localization. -/
@[stacks 0BWD "flatness"]
theorem flat_localizedCompleteIntersection
    [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] :
    Module.Flat A (localizedCompleteIntersection A n h f) :=
  (Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection A
    (localizedCompleteIntersection A n h f)).flat

/-- **Stacks Project, Tag 0BWD (1).** A quasi-finite quotient of `A[x_1, …, x_n, 1/h]` by `n`
equations is a relative local complete intersection over `A`. The statement also holds for
`n = 0`. -/
@[stacks 0BWD "local_ci"]
theorem isLocalCompleteIntersection_localizedCompleteIntersection
    [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] :
    RingHom.IsLocalCompleteIntersection
      (algebraMap A (localizedCompleteIntersection A n h f)) := by
  refine ((RingHom.syntomic_iff_flat_and_isLocalCompleteIntersection
    (algebraMap A (localizedCompleteIntersection A n h f))).mp ?_).2
  rw [toAlgebra_algebraMap]
  exact Algebra.Syntomic.of_isRelativeGlobalCompleteIntersection A _

end Stacks.Discriminant

end
