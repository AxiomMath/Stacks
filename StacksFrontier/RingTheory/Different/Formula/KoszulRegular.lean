module

public import Mathlib.RingTheory.MvPolynomial.Localization
public import Mathlib.RingTheory.TensorProduct.Maps
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.FlatBaseChange
public import StacksFrontier.RingTheory.Different.Formula.LocalizedCompleteIntersection
public import StacksFrontier.RingTheory.Koszul.Concatenation
import StacksFrontier.RingTheory.Flat.FibrewiseCriterionEssFP

/-!
# Koszul-regular sequences attached to a localized complete intersection

Let `A` be a ring, let `h, f_1, …, f_n` be polynomials in `n` variables over `A`, write
`P = A[x_1, …, x_n, 1/h]` and `B = P/(f_1, …, f_n)`, and assume `B` is quasi-finite over `A`.
Three facts about Koszul regularity in this situation are proved here, in the order in which the
source uses them.

* The images of `f_1, …, f_n` in `P` form a Koszul-regular sequence. The presentation of `B` by
  the `n + 1` variables `x, x_1, …, x_n` and the `n + 1` relations `x h - 1, f_1, …, f_n` is a
  relative global complete intersection, so those `n + 1` relations are Koszul-regular in
  `A[x, x_1, …, x_n]`; `x h - 1` is Koszul-regular on its own, so dividing by it leaves
  `f_1, …, f_n` Koszul-regular in `A[x, x_1, …, x_n]/(x h - 1) = P`.
* In `P ⊗_A B` the differences `g_i = x_i ⊗ 1 - 1 ⊗ x_i` form a Koszul-regular sequence. They
  are the image of the Koszul-regular sequence `x_i - b_i` of `B[x_1, …, x_n]` under a flat map
  followed by isomorphisms.
* Those differences generate the kernel of the multiplication map `P ⊗_A B → B`.

## Main definitions

* `Stacks.Discriminant.diagonalSequence` is the sequence `g_1, …, g_n`.
* `Stacks.Discriminant.multiplicationMap` is the map `P ⊗_A B → B`.

## Main results

* `Stacks.Discriminant.localizedRelations_isKoszulRegular`
* `Stacks.Discriminant.diagonalSequence_isKoszulRegular`
* `Stacks.Discriminant.span_range_diagonalSequence_eq_ker_multiplicationMap`

## Implementation notes

The source assumes `n ≥ 1`; the arguments and all three conclusions also hold for the empty
sequence, so no positivity hypothesis is imposed.

## References

* [Stacks Project, Tag 0BWD](https://stacks.math.columbia.edu/tag/0BWD)
* [Stacks Project, Tag 07D2](https://stacks.math.columbia.edu/tag/07D2)
* [Stacks Project, Tag 068M](https://stacks.math.columbia.edu/tag/068M)
* [Stacks Project, Tag 062H](https://stacks.math.columbia.edu/tag/062H)
-/

@[expose] public section

open scoped TensorProduct

universe u v

namespace Stacks.Discriminant

/-! ### General transport lemmas for Koszul regularity -/

/-- A ring isomorphism carries a Koszul-regular sequence to a Koszul-regular sequence: it is a
flat ring map, so this is a special case of flat base change (Tag 062H). -/
private theorem isKoszulRegular_ringEquiv {R : Type*} {S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) {m : ℕ} {f : Fin m → R} (hf : Koszul.IsKoszulRegular f) :
    Koszul.IsKoszulRegular fun i ↦ e (f i) :=
  let : Algebra R S := e.toRingHom.toAlgebra
  have : Module.Flat R S := RingHom.Flat.of_bijective e.bijective
  Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegular_algebraMap_of_flat f hf

/-- The relations of a presentation with as many relations as variables of a quasi-finite algebra
are Koszul-regular (Tag 07D2); the relations may be given up to equality. -/
private theorem isKoszulRegular_of_presentation_relation_eq {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [Algebra.QuasiFinite R S] {ι : Type*} [Finite ι] {c : ℕ}
    (P : Algebra.Presentation R S ι (Fin c)) (hcard : c = Nat.card ι)
    {g : Fin c → MvPolynomial ι R} (hg : P.relation = g) : Koszul.IsKoszulRegular g :=
  hg ▸ RingHom.isKoszulRegular_relation_of_isRelativeGlobalCompleteIntersection P
    (P.isRelativeGlobalCompleteIntersection_of_card_eq (by simp [hcard]))

/-- The relation `r T - 1` presenting the localization `R_r` is a Koszul-regular element of the
polynomial ring `R[T]`: the localization is quasi-finite over `R` and its standard presentation
has one variable and one relation, so Tag 07D2 applies. -/
private theorem isKoszulRegular_localizationAwayRelation {R : Type u} [CommRing R] (r : R) :
    Koszul.IsKoszulRegular fun _ : Fin 1 ↦
      MvPolynomial.C r * MvPolynomial.X () - (1 : MvPolynomial Unit R) := by
  let P := (Algebra.Presentation.localizationAway (Localization.Away r) r).reindex
    (Equiv.refl Unit) finOneEquiv
  refine isKoszulRegular_of_presentation_relation_eq P (by simp) ?_
  funext i
  show MvPolynomial.rename (Equiv.refl Unit)
    ((Algebra.Presentation.localizationAway (Localization.Away r) r).relation
      (finOneEquiv i)) = _
  rw [Algebra.Presentation.localizationAway_relation]
  simp

/-- The kernel of evaluation at a point `b` of `R^n` is generated by `x_1 - b_1, …, x_n - b_n`. -/
private theorem ker_aeval_eq_span_X_sub_C {R : Type*} [CommRing R] {n : ℕ} (b : Fin n → R) :
    RingHom.ker (MvPolynomial.aeval b : MvPolynomial (Fin n) R →ₐ[R] R).toRingHom =
      Ideal.span (Set.range fun i : Fin n ↦ MvPolynomial.X i - MvPolynomial.C (b i)) := by
  set J : Ideal (MvPolynomial (Fin n) R) :=
    Ideal.span (Set.range fun i : Fin n ↦ MvPolynomial.X i - MvPolynomial.C (b i)) with hJ
  have hX (i : Fin n) : MvPolynomial.X i - MvPolynomial.C (b i) ∈ J :=
    Ideal.subset_span ⟨i, rfl⟩
  have key (p : MvPolynomial (Fin n) R) : p - MvPolynomial.C (MvPolynomial.aeval b p) ∈ J := by
    induction p using MvPolynomial.induction_on with
    | C a => simp [hJ]
    | add p q hp hq =>
        simpa only [map_add, map_sub, MvPolynomial.C_add, sub_add_sub_comm] using J.add_mem hp hq
    | mul_X p i hp =>
        have e : p * MvPolynomial.X i - MvPolynomial.C (MvPolynomial.aeval b p * b i) =
            (p - MvPolynomial.C (MvPolynomial.aeval b p)) * MvPolynomial.X i +
              MvPolynomial.C (MvPolynomial.aeval b p) *
                (MvPolynomial.X i - MvPolynomial.C (b i)) := by
          rw [mul_sub, sub_mul, ← map_mul]
          ring
        rw [map_mul, MvPolynomial.aeval_X, e]
        exact J.add_mem (J.mul_mem_right _ hp) (J.mul_mem_left _ (hX i))
  refine le_antisymm (fun p hp ↦ ?_) ?_
  · have hp' : MvPolynomial.aeval b p = 0 := hp
    simpa only [hp', map_zero, sub_zero] using key p
  · rw [hJ, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker]

/-- The sequence `x_1 - b_1, …, x_n - b_n` is Koszul-regular in `R[x_1, …, x_n]`: it is the
sequence of relations of a presentation of `R` over itself with as many relations as
variables. -/
private theorem isKoszulRegular_X_sub_C {R : Type*} [CommRing R] {n : ℕ} (b : Fin n → R) :
    Koszul.IsKoszulRegular fun i : Fin n ↦
      (MvPolynomial.X i - MvPolynomial.C (b i) : MvPolynomial (Fin n) R) :=
  let P : Algebra.Presentation R R (Fin n) (Fin n) :=
    { val := b
      σ' := MvPolynomial.C
      aeval_val_σ' := by simp
      relation := fun i ↦ MvPolynomial.X i - MvPolynomial.C (b i)
      span_range_relation_eq_ker := (ker_aeval_eq_span_X_sub_C b).symm }
  isKoszulRegular_of_presentation_relation_eq P (by simp) rfl

/-! ### The relations of a localized complete intersection -/

variable (A : Type u) [CommRing A] (n : ℕ) (h : MvPolynomial (Fin n) A)
    (f : Fin n → MvPolynomial (Fin n) A)

/-- The relations of the presentation `B = A[x, x_1, …, x_n]/(x h - 1, f_1, …, f_n)`, listed as
`x h - 1` followed by `f_1, …, f_n` after renaming the variables. -/
private noncomputable def appendedRelations :
    Fin (1 + n) → MvPolynomial (Unit ⊕ Fin n) A :=
  Fin.append
    (fun _ : Fin 1 ↦ MvPolynomial.rename Sum.inr h * MvPolynomial.X (Sum.inl ()) - 1)
    fun i ↦ MvPolynomial.rename Sum.inr (f i)

variable [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)]

/-- The `n + 1` relations `x h - 1, f_1, …, f_n` presenting a quasi-finite
`A[x_1, …, x_n, 1/h]/(f_1, …, f_n)` form a Koszul-regular sequence in `A[x, x_1, …, x_n]`. -/
private theorem appendedRelations_isKoszulRegular :
    Koszul.IsKoszulRegular (appendedRelations A n h f) := by
  have e := localizedQuotientEquiv A n h f
  have : Algebra.QuasiFinite A (localizedQuotient A n h f) :=
    (Algebra.QuasiFinite.iff_of_algEquiv e).mpr inferInstance
  have : IsScalarTower A (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f))
      (localizedQuotient A n h f) := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hloc := isLocalization_away_localizedQuotient A n h f
  let P : Algebra.Presentation A (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f))
      (Fin n) (Fin n) := Algebra.Presentation.naive (v := f)
  have : IsLocalization.Away
      (algebraMap P.Ring (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f)) h)
      (localizedQuotient A n h f) := hloc
  let Q := (P.localizationAwayComp h (localizedQuotient A n h f)).reindex (Equiv.refl _)
    (finSumFinEquiv.symm.trans (Equiv.sumCongr finOneEquiv (Equiv.refl (Fin n))))
  refine isKoszulRegular_of_presentation_relation_eq Q (by simp) ?_
  funext k
  induction k using Fin.addCases with
  | left i =>
      simp [Q, P, appendedRelations, Fin.append_left, Algebra.Presentation.reindex,
        Algebra.Presentation.localizationAwayComp]
  | right i =>
      simp [Q, P, appendedRelations, Fin.append_right, Algebra.Presentation.reindex,
        Algebra.Presentation.localizationAwayComp]

/-- The images of `f_1, …, f_n` in `A[x_1, …, x_n, 1/h]` form a Koszul-regular sequence, when the
quotient by them is quasi-finite over `A`. -/
theorem localizedRelations_isKoszulRegular :
    Koszul.IsKoszulRegular (localizedRelations A n h f) := by
  classical
  let E : MvPolynomial (Unit ⊕ Fin n) A ≃ₐ[A] MvPolynomial Unit (MvPolynomial (Fin n) A) :=
    MvPolynomial.sumAlgEquiv A Unit (Fin n)
  have hreg := isKoszulRegular_ringEquiv E.toRingEquiv (appendedRelations_isKoszulRegular A n h f)
  have hcomp (p : MvPolynomial (Fin n) A) :
      E (MvPolynomial.rename Sum.inr p) = MvPolynomial.C p := by
    show (E.toAlgHom.comp (MvPolynomial.rename Sum.inr)) p = _
    rw [MvPolynomial.sumAlgEquiv_comp_rename_inr]
    rfl
  let t : MvPolynomial Unit (MvPolynomial (Fin n) A) :=
    MvPolynomial.C h * MvPolynomial.X () - 1
  have hmap : (fun k ↦ E.toRingEquiv (appendedRelations A n h f k)) =
      Fin.append (fun _ : Fin 1 ↦ t) fun i : Fin n ↦ MvPolynomial.C (f i) := by
    funext k
    induction k using Fin.addCases with
    | left i =>
        simp only [appendedRelations, Fin.append_left]
        show E _ = t
        rw [map_sub, map_mul, hcomp, MvPolynomial.sumAlgEquiv_X_inl, map_one]
    | right i =>
        simp only [appendedRelations, Fin.append_right]
        exact hcomp (f i)
  rw [hmap] at hreg
  have hspan : Ideal.span (Set.range fun _ : Fin 1 ↦ t) = Ideal.span {t} := by
    simp [Set.range_const]
  have htail := Koszul.koszulRegular_quotient_of_koszulRegular_append
    (fun _ : Fin 1 ↦ t) (fun i : Fin n ↦ MvPolynomial.C (f i))
    (isKoszulRegular_localizationAwayRelation h) hreg
  rw [hspan] at htail
  have hP := isKoszulRegular_ringEquiv
    (IsLocalization.Away.mvPolynomialQuotientEquiv (Localization.Away h) h).toRingEquiv htail
  convert hP using 1
  funext i
  exact ((IsLocalization.Away.mvPolynomialQuotientEquiv
    (Localization.Away h) h).commutes (f i)).symm

/-! ### The diagonal sequence in `P ⊗_A B` -/

/-- The image of `x_1 - b_1, …, x_n - b_n` under the isomorphism
`B[x_1, …, x_n] ≃ B ⊗_A A[x_1, …, x_n]` is Koszul-regular. -/
private theorem isKoszulRegular_tensor_X_sub_C {B : Type v} [CommRing B] [Algebra A B]
    (b : Fin n → B) :
    Koszul.IsKoszulRegular fun i ↦
      (MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A B).symm
        (MvPolynomial.X i - MvPolynomial.C (b i)) :=
  isKoszulRegular_ringEquiv
    (MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A B).symm.toRingEquiv
    (isKoszulRegular_X_sub_C b)

/-- Pushing `x_1 - b_1, …, x_n - b_n` into `A[x_1, …, x_n, 1/h] ⊗_A B` keeps it Koszul-regular:
the map `B ⊗_A A[x_1, …, x_n] → B ⊗_A A[x_1, …, x_n, 1/h]` is a localization, hence flat. -/
private theorem isKoszulRegular_tensor_away_X_sub_C {B : Type v} [CommRing B] [Algebra A B]
    (b : Fin n → B) :
    Koszul.IsKoszulRegular fun i ↦
      (Algebra.TensorProduct.comm A B (Localization.Away h))
        (Algebra.TensorProduct.map (AlgHom.id A B)
            (IsScalarTower.toAlgHom A (MvPolynomial (Fin n) A) (Localization.Away h))
          ((MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A B).symm
            (MvPolynomial.X i - MvPolynomial.C (b i)))) := by
  let Q := MvPolynomial (Fin n) A
  let P := Localization.Away h
  let φ : B ⊗[A] Q →ₐ[A] B ⊗[A] P :=
    Algebra.TensorProduct.map (AlgHom.id A B) (IsScalarTower.toAlgHom A Q P)
  let : Algebra (B ⊗[A] Q) (B ⊗[A] P) := φ.toAlgebra
  have : IsScalarTower B (B ⊗[A] Q) (B ⊗[A] P) :=
    IsScalarTower.of_algebraMap_eq (R := B) (S := B ⊗[A] Q) (A := B ⊗[A] P) (by
      intro x
      show x ⊗ₜ[A] (1 : P) = φ (x ⊗ₜ[A] (1 : Q))
      simp [φ])
  have : IsLocalization ((Submonoid.powers h).map
      (Algebra.TensorProduct.includeRight (R := A) (A := B))) (B ⊗[A] P) :=
    IsLocalization.tensorProduct_tensorProduct_right A B (Submonoid.powers h) P
      (by ext x <;> simp [φ, RingHom.algebraMap_toAlgebra] <;> rfl)
  have : Module.Flat (B ⊗[A] Q) (B ⊗[A] P) :=
    IsLocalization.flat (B ⊗[A] P)
      ((Submonoid.powers h).map (Algebra.TensorProduct.includeRight (R := A) (A := B)))
  exact isKoszulRegular_ringEquiv (Algebra.TensorProduct.comm A B P).toRingEquiv
    (Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegular_algebraMap_of_flat _
      (isKoszulRegular_tensor_X_sub_C A n b))

/-- The sequence `g_i = x_i ⊗ 1 - 1 ⊗ x_i` in `A[x_1, …, x_n, 1/h] ⊗_A B`, where
`B = A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`. Its span is the kernel of the multiplication map, so it
cuts out the diagonal. -/
noncomputable def diagonalSequence : Fin n →
    Localization.Away h ⊗[A] localizedCompleteIntersection A n h f :=
  fun i ↦
    algebraMap (MvPolynomial (Fin n) A) (Localization.Away h) (MvPolynomial.X i) ⊗ₜ[A] 1 -
      1 ⊗ₜ[A] algebraMap (MvPolynomial (Fin n) A) (localizedCompleteIntersection A n h f)
        (MvPolynomial.X i)

/-- The multiplication map `A[x_1, …, x_n, 1/h] ⊗_A B → B`, induced by the quotient map on the
left factor and the identity on the right. -/
noncomputable def multiplicationMap :
    Localization.Away h ⊗[A] localizedCompleteIntersection A n h f →ₐ[A]
      localizedCompleteIntersection A n h f :=
  Algebra.TensorProduct.productMap
    (Ideal.Quotient.mkₐ A (Ideal.span (Set.range (localizedRelations A n h f))))
    (AlgHom.id A _)

omit [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] in
/-- The differences `g_i = x_i ⊗ 1 - 1 ⊗ x_i` form a Koszul-regular sequence in
`A[x_1, …, x_n, 1/h] ⊗_A B`. This holds for every choice of `h` and of the `f_i`, with no
quasi-finiteness hypothesis: the sequence is the image of `x_1 - b_1, …, x_n - b_n`. -/
theorem diagonalSequence_isKoszulRegular :
    Koszul.IsKoszulRegular (diagonalSequence A n h f) := by
  have key := isKoszulRegular_tensor_away_X_sub_C A n h
    (B := localizedCompleteIntersection A n h f)
    fun i ↦ algebraMap (MvPolynomial (Fin n) A) (localizedCompleteIntersection A n h f)
      (MvPolynomial.X i)
  convert key using 2 with i
  have hC : (MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A
        (localizedCompleteIntersection A n h f)).symm
      (MvPolynomial.C (algebraMap (MvPolynomial (Fin n) A)
        (localizedCompleteIntersection A n h f) (MvPolynomial.X i))) =
      algebraMap (MvPolynomial (Fin n) A) (localizedCompleteIntersection A n h f)
        (MvPolynomial.X i) ⊗ₜ[A] (1 : MvPolynomial (Fin n) A) :=
    (MvPolynomial.algebraTensorAlgEquiv (σ := Fin n) A
      (localizedCompleteIntersection A n h f)).symm.commutes _
  rw [map_sub, MvPolynomial.algebraTensorAlgEquiv_symm_X, hC, map_sub, map_sub]
  simp [diagonalSequence, Algebra.TensorProduct.comm_tmul]

/-- The kernel of the canonical map `A ⊗_R C → C` is generated by the elements
`a ⊗ 1 - 1 ⊗ a`. -/
private theorem ker_productMap_toAlgHom_id {R A' C : Type*} [CommRing R] [CommRing A']
    [CommRing C] [Algebra R A'] [Algebra R C] [Algebra A' C] [IsScalarTower R A' C] :
    RingHom.ker (Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A' C)
        (AlgHom.id R C)) =
      Ideal.span (Set.range fun a : A' ↦ a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A' C a) := by
  set π := Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A' C) (AlgHom.id R C)
    with hπ
  set J := Ideal.span (Set.range fun a : A' ↦ a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A' C a) with hJ
  have hgen (a : A') : a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A' C a ∈ J :=
    Ideal.subset_span ⟨a, rfl⟩
  have key (y : A' ⊗[R] C) : y - 1 ⊗ₜ π y ∈ J := by
    induction y with
    | zero => simp
    | tmul a c =>
        have hval : π (a ⊗ₜ c) = algebraMap A' C a * c := by simp [hπ]
        have hfac : a ⊗ₜ[R] c - 1 ⊗ₜ (algebraMap A' C a * c) =
            (a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A' C a) * (1 ⊗ₜ c) := by
          simp [Algebra.TensorProduct.tmul_mul_tmul, sub_mul]
        rw [hval, hfac]
        exact Ideal.mul_mem_right _ _ (hgen a)
    | add y z hy hz =>
        have e : y + z - 1 ⊗ₜ π (y + z) = (y - 1 ⊗ₜ π y) + (z - 1 ⊗ₜ π z) := by
          rw [map_add, TensorProduct.tmul_add]
          ring
        rw [e]
        exact add_mem hy hz
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · have hk := key x
    rwa [RingHom.mem_ker.mp hx, TensorProduct.tmul_zero, sub_zero] at hk
  · rw [hJ, Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    simp [RingHom.mem_ker, hπ]

omit [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] in
/-- The differences `g_i = x_i ⊗ 1 - 1 ⊗ x_i` generate the kernel of the multiplication map
`A[x_1, …, x_n, 1/h] ⊗_A B → B`. This holds for every choice of `h` and of the `f_i`, with no
quasi-finiteness hypothesis. -/
theorem span_range_diagonalSequence_eq_ker_multiplicationMap :
    Ideal.span (Set.range (diagonalSequence A n h f)) =
      RingHom.ker (multiplicationMap A n h f).toRingHom := by
  have hπ : multiplicationMap A n h f = Algebra.TensorProduct.productMap
      (IsScalarTower.toAlgHom A (Localization.Away h) (localizedCompleteIntersection A n h f))
      (AlgHom.id A _) := rfl
  have hker : RingHom.ker (multiplicationMap A n h f).toRingHom =
      Ideal.span (Set.range fun x : Localization.Away h ↦
        x ⊗ₜ[A] (1 : localizedCompleteIntersection A n h f) -
          1 ⊗ₜ algebraMap (Localization.Away h)
            (localizedCompleteIntersection A n h f) x) := by
    rw [hπ]
    exact ker_productMap_toAlgHom_id
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp [RingHom.mem_ker, multiplicationMap, diagonalSequence]
  · rw [hker, Ideal.span_le]
    rintro _ ⟨x, rfl⟩
    refine Stacks.Flatness.EssFPFibrewiseCriterion.tmul_one_sub_one_tmul_mem_of_isLocalization
      (T := Submonoid.powers h)
      (G := Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) A))
      MvPolynomial.adjoin_range_X _ ?_ x
    rintro _ ⟨i, rfl⟩
    rw [← IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) A) (Localization.Away h)
      (localizedCompleteIntersection A n h f)]
    exact Ideal.subset_span ⟨i, rfl⟩

end Stacks.Discriminant

end
