module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import StacksFrontier.AlgebraicGeometry.Different.NoetherDifferent.Basic
public import StacksFrontier.RingTheory.Different.Formula.AnnihilatorOfDiagonal
public import StacksFrontier.RingTheory.Different.Formula.KoszulRegular

/-!
# The annihilator of the diagonal and the Noether different of a localized complete intersection

Let `A` be a ring, let `h, f_1, …, f_n` be polynomials in `n` variables over `A`, and set
`B = A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`, assumed quasi-finite over `A`. This finishes Tag 0BWD:
the annihilator of the kernel of the multiplication map `B ⊗_A B → B` is free of rank `1` over
`B`, and the Noether different of `B/A` is generated by the Jacobian determinant
`det(∂f_i/∂x_j)`.

## Main results

* `Stacks.Discriminant.exists_linearEquiv_diagonalAnnihilator_lmul'_eq_det`: the annihilator of
  `Ker(B ⊗_A B → B)` is free of rank `1` over `B` on a generator whose image under
  multiplication is the Jacobian determinant.
* `Stacks.Discriminant.free_rank_eq_one_diagonalAnnihilator_localizedCompleteIntersection`: the
  annihilator of `Ker(B ⊗_A B → B)` is free of rank `1` over `B`.
* `Stacks.Discriminant.noetherDifferent_localizedCompleteIntersection`: the Noether different of
  `B/A` is the ideal generated by the Jacobian determinant.

## Implementation notes

The link between the abstract coefficient matrix of Tag 0BWC and the Jacobian matrix is
Hadamard's divided-difference lemma: for two algebra homomorphisms out of a polynomial ring that
agree after composing with a further map `d`, their difference on a polynomial `p` is a
combination of their differences on the variables, with coefficients whose image under `d` is `d`
of the partial derivatives of `p`. The two homomorphisms here are the two inclusions of
`A[x_1, …, x_n]` into `P ⊗_A B`, where `P = A[x_1, …, x_n, 1/h]`, and `d` is the multiplication
map; the resulting coefficients at `p = f_i` are exactly the matrix needed to invoke Tag 0BWC, and
their image under `d` is the Jacobian matrix.

The source assumes `n ≥ 1`; the argument and both conclusions also hold for `n = 0`, when `B` is
the localization of `A` and the Jacobian matrix is the empty matrix with determinant `1`, so no
positivity hypothesis is imposed.

## References

* [Stacks Project, Tag 0BWD](https://stacks.math.columbia.edu/tag/0BWD)
-/

@[expose] public section

open scoped TensorProduct

universe u

namespace Stacks.Discriminant

/-- Hadamard's divided-difference lemma. If two `A`-algebra homomorphisms `F, G` out of a
polynomial ring agree after composing with a further `A`-algebra homomorphism `d`, then for any
polynomial `p` the difference `F p - G p` is a combination of the differences `F Xᵢ - G Xᵢ` on
the variables, with coefficients whose image under `d` is `d` of the partial derivatives of `p`
evaluated through `F`. -/
private theorem exists_dividedDifference
    {A : Type u} [CommRing A] {n : ℕ}
    {R : Type*} [CommRing R] [Algebra A R] {S : Type*} [CommRing S] [Algebra A S]
    (F G : MvPolynomial (Fin n) A →ₐ[A] R) (d : R →ₐ[A] S)
    (hFG : d.comp F = d.comp G) (p : MvPolynomial (Fin n) A) :
    ∃ q : Fin n → R,
      F p - G p = ∑ i, q i * (F (MvPolynomial.X i) - G (MvPolynomial.X i)) ∧
      ∀ i, d (q i) = d (F (MvPolynomial.pderiv i p)) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a => exact ⟨0, by simp, by intro i; simp⟩
  | add p r hp hr =>
      obtain ⟨q, hq, hqd⟩ := hp
      obtain ⟨t, ht, htd⟩ := hr
      refine ⟨q + t, ?_, ?_⟩
      · calc
          F (p + r) - G (p + r) = (F p - G p) + (F r - G r) := by simp; ring
          _ = ∑ i, (q i + t i) * (F (MvPolynomial.X i) - G (MvPolynomial.X i)) := by
            rw [hq, ht]; simp [add_mul, Finset.sum_add_distrib]
      · intro i
        rw [Pi.add_apply, map_add, map_add, hqd, htd]
        simp [MvPolynomial.pderiv]
  | mul_X p j hp =>
      obtain ⟨q, hq, hqd⟩ := hp
      refine ⟨fun i => q i * F (MvPolynomial.X j) + if i = j then G p else 0, ?_, ?_⟩
      · calc
          F (p * MvPolynomial.X j) - G (p * MvPolynomial.X j) =
              (F p - G p) * F (MvPolynomial.X j) +
                G p * (F (MvPolynomial.X j) - G (MvPolynomial.X j)) := by
            simp only [map_mul]; ring
          _ = ∑ i, (q i * F (MvPolynomial.X j) + if i = j then G p else 0) *
                (F (MvPolynomial.X i) - G (MvPolynomial.X i)) := by
            rw [hq]
            have hsingle :
                (∑ i : Fin n, (if i = j then G p else 0) *
                  (F (MvPolynomial.X i) - G (MvPolynomial.X i))) =
                  G p * (F (MvPolynomial.X j) - G (MvPolynomial.X j)) := by
              rw [Finset.sum_eq_single j]
              · simp
              · intro i hi hij; simp [hij]
              · simp
            have hsum :
                (∑ i, (q i * F (MvPolynomial.X j)) *
                  (F (MvPolynomial.X i) - G (MvPolynomial.X i))) =
                  (∑ i, q i * (F (MvPolynomial.X i) - G (MvPolynomial.X i))) *
                    F (MvPolynomial.X j) := by
              rw [Finset.sum_mul]
              exact Finset.sum_congr rfl fun i hi => by ring
            calc
              _ = (∑ i, (q i * F (MvPolynomial.X j)) *
                    (F (MvPolynomial.X i) - G (MvPolynomial.X i))) +
                    ∑ i, (if i = j then G p else 0) *
                      (F (MvPolynomial.X i) - G (MvPolynomial.X i)) := by
                rw [hsum, hsingle]
              _ = ∑ i, ((q i * F (MvPolynomial.X j)) *
                    (F (MvPolynomial.X i) - G (MvPolynomial.X i)) +
                    (if i = j then G p else 0) *
                      (F (MvPolynomial.X i) - G (MvPolynomial.X i))) := by
                rw [← Finset.sum_add_distrib]
              _ = _ := Finset.sum_congr rfl fun i hi => by ring
      · intro i
        rw [map_add, map_mul, hqd i]
        have hGp : d (G p) = d (F p) :=
          (congrArg (fun H : MvPolynomial (Fin n) A →ₐ[A] S => H p) hFG).symm
        by_cases hij : i = j
        · subst i; simp [MvPolynomial.pderiv_X, hGp]; ring
        · simp [hij, MvPolynomial.pderiv_X]; ring

variable (A : Type u) [CommRing A] (n : ℕ) (h : MvPolynomial (Fin n) A)
    (f : Fin n → MvPolynomial (Fin n) A)
    [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)]

omit [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] in
/-- A coefficient matrix expressing the localized relations `f_1, …, f_n` against the diagonal
sequence `g_1, …, g_n`, whose image under the multiplication map `P ⊗_A B → B` is the Jacobian
matrix `∂f_i/∂x_j`. This is the matrix needed to invoke Tag 0BWC for the presentation of
`B = A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`. -/
theorem exists_coefficientMatrix :
    ∃ gij : Matrix (Fin n) (Fin n)
        (Localization.Away h ⊗[A] localizedCompleteIntersection A n h f),
      (∀ i, localizedRelations A n h f i ⊗ₜ[A] (1 : localizedCompleteIntersection A n h f) =
        ∑ j, gij i j * diagonalSequence A n h f j) ∧
      ∀ i j, multiplicationMap A n h f (gij i j) =
        algebraMap (MvPolynomial (Fin n) A) (localizedCompleteIntersection A n h f)
          (MvPolynomial.pderiv j (f i)) := by
  classical
  set P := Localization.Away h
  set B := localizedCompleteIntersection A n h f
  set rel := localizedRelations A n h f
  set g := diagonalSequence A n h f
  set d := multiplicationMap A n h f
  let q : P →ₐ[A] B := Ideal.Quotient.mkₐ A (Ideal.span (Set.range rel))
  let eP : MvPolynomial (Fin n) A →ₐ[A] P := IsScalarTower.toAlgHom A (MvPolynomial (Fin n) A) P
  let eB : MvPolynomial (Fin n) A →ₐ[A] B := IsScalarTower.toAlgHom A (MvPolynomial (Fin n) A) B
  let F : MvPolynomial (Fin n) A →ₐ[A] P ⊗[A] B :=
    (Algebra.TensorProduct.includeLeft (R := A) (A := P) (B := B)).comp eP
  let G : MvPolynomial (Fin n) A →ₐ[A] P ⊗[A] B :=
    (Algebra.TensorProduct.includeRight (R := A) (A := P) (B := B)).comp eB
  have hqeP : ∀ p, q (eP p) = eB p := fun p => rfl
  have hleft : d.comp (Algebra.TensorProduct.includeLeft (R := A) (A := P) (B := B)) = q :=
    Algebra.TensorProduct.productMap_left q (AlgHom.id A B)
  have hright : d.comp (Algebra.TensorProduct.includeRight (R := A) (A := P) (B := B)) =
      AlgHom.id A B :=
    Algebra.TensorProduct.productMap_right q (AlgHom.id A B)
  have hFG : d.comp F = d.comp G := AlgHom.ext fun p =>
    (AlgHom.congr_fun hleft (eP p)).trans ((hqeP p).trans (AlgHom.congr_fun hright (eB p)).symm)
  have hqrel (i : Fin n) : q (rel i) = 0 := by
    change Ideal.Quotient.mk (Ideal.span (Set.range rel)) (rel i) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i))
  have hFf (i : Fin n) : F (f i) = rel i ⊗ₜ[A] (1 : B) := rfl
  have hGf (i : Fin n) : G (f i) = 0 := by
    change (1 : P) ⊗ₜ[A] eB (f i) = 0
    rw [show eB (f i) = q (eP (f i)) from (hqeP (f i)).symm,
      show eP (f i) = rel i from rfl, hqrel i]
    exact TensorProduct.tmul_zero (R := A) (M := P) (N := B) (1 : P)
  have hvar (j : Fin n) : F (MvPolynomial.X j) - G (MvPolynomial.X j) = g j := rfl
  choose c hc hcd using fun i => exists_dividedDifference F G d hFG (f i)
  refine ⟨c, fun i => ?_, fun i j => ?_⟩
  · calc
      rel i ⊗ₜ[A] (1 : B) = F (f i) - G (f i) := by
        rw [hFf i, hGf i]
        simp
      _ = ∑ j, c i j * (F (MvPolynomial.X j) - G (MvPolynomial.X j)) := hc i
      _ = ∑ j, c i j * g j := by simp_rw [hvar]
  · calc
      d (c i j) = d (F (MvPolynomial.pderiv j (f i))) := hcd i j
      _ = (d.comp (Algebra.TensorProduct.includeLeft (R := A) (A := P) (B := B)))
            (eP (MvPolynomial.pderiv j (f i))) := rfl
      _ = q (eP (MvPolynomial.pderiv j (f i))) := by rw [hleft]
      _ = eB (MvPolynomial.pderiv j (f i)) := hqeP _
      _ = algebraMap (MvPolynomial (Fin n) A) B (MvPolynomial.pderiv j (f i)) := rfl

omit [Algebra.QuasiFinite A (localizedCompleteIntersection A n h f)] in
/-- Multiplication `P ⊗_A B → B` carries the determinant of a coefficient matrix for the
localized relations to the Jacobian determinant `det(∂f_i/∂x_j)`. -/
private theorem lmul'_map_det_eq_det_pderiv
    (gij : Matrix (Fin n) (Fin n)
      (Localization.Away h ⊗[A] localizedCompleteIntersection A n h f))
    (hdiag : ∀ i j, multiplicationMap A n h f (gij i j) =
      algebraMap (MvPolynomial (Fin n) A) (localizedCompleteIntersection A n h f)
        (MvPolynomial.pderiv j (f i))) :
    Algebra.TensorProduct.lmul' A
        (Algebra.TensorProduct.map
          (Ideal.Quotient.mkₐ A (Ideal.span (Set.range (localizedRelations A n h f))))
          (AlgHom.id A (localizedCompleteIntersection A n h f)) (Matrix.det gij)) =
      Matrix.det fun i j : Fin n ↦ algebraMap (MvPolynomial (Fin n) A)
        (localizedCompleteIntersection A n h f) (MvPolynomial.pderiv j (f i)) := by
  have hprod : (Algebra.TensorProduct.lmul' (R := A)
      (S := localizedCompleteIntersection A n h f)).comp
      (Algebra.TensorProduct.map
        (Ideal.Quotient.mkₐ A (Ideal.span (Set.range (localizedRelations A n h f))))
        (AlgHom.id A (localizedCompleteIntersection A n h f))) =
      multiplicationMap A n h f :=
    (Algebra.TensorProduct.productMap_eq_comp_map
      (f := Ideal.Quotient.mkₐ A (Ideal.span (Set.range (localizedRelations A n h f))))
      (g := AlgHom.id A (localizedCompleteIntersection A n h f))).symm
  calc
    _ = (multiplicationMap A n h f) (Matrix.det gij) := by rw [← hprod]; rfl
    _ = Matrix.det (fun i j => multiplicationMap A n h f (gij i j)) :=
      (multiplicationMap A n h f).map_det gij
    _ = _ := by
      congr 1
      ext i j
      exact hdiag i j

/-- **Stacks Project, Tag 0BWD (2).** For a quasi-finite quotient
`B = A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`, the annihilator `J` of `Ker(B ⊗_A B → B)` is free of
rank `1` over `B` on a generator whose image under the multiplication map `B ⊗_A B → B` is the
Jacobian determinant `det(∂f_i/∂x_j)`. -/
theorem exists_linearEquiv_diagonalAnnihilator_lmul'_eq_det :
    ∃ e : localizedCompleteIntersection A n h f ≃ₗ[localizedCompleteIntersection A n h f]
        diagonalAnnihilator A (localizedCompleteIntersection A n h f),
      Algebra.TensorProduct.lmul' A
          (e 1 : localizedCompleteIntersection A n h f ⊗[A]
            localizedCompleteIntersection A n h f) =
        Matrix.det fun i j : Fin n ↦ algebraMap (MvPolynomial (Fin n) A)
          (localizedCompleteIntersection A n h f) (MvPolynomial.pderiv j (f i)) := by
  obtain ⟨gij, hcoeff, hdiag⟩ := exists_coefficientMatrix A n h f
  have : Module.Flat A (localizedCompleteIntersection A n h f) :=
    flat_localizedCompleteIntersection A n h f
  obtain ⟨e, he⟩ := exists_linearEquiv_annihilator_ker_lmul (localizedRelations A n h f)
    (diagonalSequence A n h f) gij
    (Ideal.Quotient.mkₐ A (Ideal.span (Set.range (localizedRelations A n h f))))
    (localizedRelations_isKoszulRegular A n h f)
    Ideal.Quotient.mk_surjective Ideal.mk_ker (diagonalSequence_isKoszulRegular A n h f)
    (span_range_diagonalSequence_eq_ker_multiplicationMap A n h f).symm
    hcoeff
  have hgen := (he 1).trans (one_smul _ _)
  exact ⟨e, (congrArg (fun z => Algebra.TensorProduct.lmul' (R := A) z) hgen).trans
    (lmul'_map_det_eq_det_pderiv A n h f gij hdiag)⟩

/-- The `B`-linear equivalence between `B` and the annihilator `J` of `Ker(B ⊗_A B → B)`,
witnessing that `J` is free of rank `1` over `B`. -/
noncomputable def diagonalAnnihilatorEquiv :
    localizedCompleteIntersection A n h f ≃ₗ[localizedCompleteIntersection A n h f]
      diagonalAnnihilator A (localizedCompleteIntersection A n h f) :=
  (exists_linearEquiv_diagonalAnnihilator_lmul'_eq_det A n h f).choose

/-- **Stacks Project, Tag 0BWD (2).** For a quasi-finite quotient `B = A[x_1, …, x_n, 1/h]/(f_1,
…, f_n)`, the annihilator `J` of `Ker(B ⊗_A B → B)` is free of rank `1` over `B`. -/
@[stacks 0BWD "annihilator"]
theorem free_rank_eq_one_diagonalAnnihilator_localizedCompleteIntersection :
    Module.Free (localizedCompleteIntersection A n h f)
        (diagonalAnnihilator A (localizedCompleteIntersection A n h f)) ∧
      Module.rank (localizedCompleteIntersection A n h f)
        (diagonalAnnihilator A (localizedCompleteIntersection A n h f)) = 1 :=
  ⟨Module.Free.of_equiv (diagonalAnnihilatorEquiv A n h f),
    (diagonalAnnihilatorEquiv A n h f).rank_eq.symm.trans (CommSemiring.rank_self _)⟩

/-- **Stacks Project, Tag 0BWD (3).** For a quasi-finite quotient `B = A[x_1, …, x_n, 1/h]/(f_1,
…, f_n)`, the Noether different of `B/A` is generated by the Jacobian determinant
`det(∂f_i/∂x_j)`. -/
@[stacks 0BWD "noether_different"]
theorem noetherDifferent_localizedCompleteIntersection :
    noetherDifferent A (localizedCompleteIntersection A n h f) =
      Ideal.span ({
        Matrix.det fun i j : Fin n ↦
          algebraMap (MvPolynomial (Fin n) A) (localizedCompleteIntersection A n h f)
            (MvPolynomial.pderiv j (f i))} : Set _) := by
  obtain ⟨gij, hcoeff, hdiag⟩ := exists_coefficientMatrix A n h f
  have : Module.Flat A (localizedCompleteIntersection A n h f) :=
    flat_localizedCompleteIntersection A n h f
  have hann := annihilator_ker_lmul_eq_span_det (localizedRelations A n h f)
    (diagonalSequence A n h f) gij
    (Ideal.Quotient.mkₐ A (Ideal.span (Set.range (localizedRelations A n h f))))
    (localizedRelations_isKoszulRegular A n h f)
    Ideal.Quotient.mk_surjective Ideal.mk_ker (diagonalSequence_isKoszulRegular A n h f)
    (span_range_diagonalSequence_eq_ker_multiplicationMap A n h f).symm hcoeff
  change Ideal.map (Algebra.TensorProduct.lmul' A).toRingHom
      (diagonalAnnihilator A (localizedCompleteIntersection A n h f)) = _
  change Ideal.map (Algebra.TensorProduct.lmul' A).toRingHom
      (RingHom.ker (Algebra.TensorProduct.lmul' A :
        localizedCompleteIntersection A n h f ⊗[A] localizedCompleteIntersection A n h f →ₐ[A]
          localizedCompleteIntersection A n h f).toRingHom).annihilator = _
  rw [hann, Ideal.map_span]
  rw [Set.image_singleton]
  exact congrArg (fun z => Ideal.span {z}) (lmul'_map_det_eq_det_pderiv A n h f gij hdiag)

end Stacks.Discriminant

end
