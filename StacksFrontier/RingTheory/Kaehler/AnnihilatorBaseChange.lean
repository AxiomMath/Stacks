module

public import Mathlib.LinearAlgebra.TensorProduct.Pi
public import Mathlib.RingTheory.Flat.Equalizer
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.Flat.Localization
public import Mathlib.RingTheory.Kaehler.TensorProduct

/-!
# Flat base change of an annihilator, and of the Kähler different

Let `M` be a finitely generated `A`-module and let `B` be a flat `A`-algebra. Then the annihilator
of `B ⊗_A M` is generated by the annihilator of `M`: `Module.annihilator_baseChange`.

Applied to the Kähler differentials this says that the *Kähler different* — the annihilator of
`Ω[A⁄R]` — is compatible with any flat base change of the base ring:
`KaehlerDifferential.annihilator_eq_map_of_isPushout`.

## Main results

* `Module.annihilator_baseChange`: `Module.annihilator B (B ⊗[A] M)` is the ideal generated by
  `Module.annihilator A M`, for `M` finitely generated over `A` and `B` flat over `A`.
* `KaehlerDifferential.annihilator_eq_map_of_isPushout`: for a pushout square `R → S`, `R → A`,
  `B = S ⊗_R A` with `B` flat over `A` and `Ω[A⁄R]` finite over `A`, the annihilator of `Ω[B⁄S]`
  is the ideal generated by the annihilator of `Ω[A⁄R]`.
* `KaehlerDifferential.annihilator_eq_map_of_isLocalization`: the same for a localisation of the
  base, where flatness is automatic.
* `KaehlerDifferential.eq_annihilator_of_map_eq_of_isPushout`: over a faithfully flat base change
  an ideal that becomes the Kähler different was the Kähler different.

-/

@[expose] public section

open TensorProduct

/-- **Flat base change of the annihilator of a finitely generated module.** If `M` is a finitely
generated `A`-module and `B` is a flat `A`-algebra, then the annihilator of `B ⊗[A] M` is the
ideal of `B` generated by the annihilator of `M`. -/
theorem Module.annihilator_baseChange (A B M : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup M] [Module A M] [Module.Finite A M] [Module.Flat A B] :
    Module.annihilator B (B ⊗[A] M) = (Module.annihilator A M).map (algebraMap A B) := by
  classical
  obtain ⟨n, x, hx⟩ := Module.Finite.exists_fin (R := A) (M := M)
  set φ : A →ₗ[A] (Fin n → M) := LinearMap.pi fun j ↦ LinearMap.toSpanSingleton A M (x j) with hφd
  have hφ1 : φ 1 = x := by
    funext j; simp [hφd, LinearMap.toSpanSingleton_apply]
  have hker : LinearMap.ker φ = Module.annihilator A M := by
    rw [← Submodule.annihilator_top, ← hx]
    ext a
    rw [LinearMap.mem_ker, Submodule.mem_annihilator_span]
    simp [hφd, funext_iff, LinearMap.toSpanSingleton_apply, Subtype.forall]
  have hsm : ∀ (b : B) (m : M), b • ((1 : B) ⊗ₜ[A] m) = b ⊗ₜ[A] m := fun b m ↦ by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have hgen : Submodule.span B (Set.range fun j ↦ (1 : B) ⊗ₜ[A] x j) = ⊤ := by
    rw [show (Set.range fun j ↦ (1 : B) ⊗ₜ[A] x j) = TensorProduct.mk A B M 1 '' Set.range x from
      Set.range_comp (TensorProduct.mk A B M 1) x, ← Submodule.baseChange_span, hx,
      Submodule.baseChange_top]
  have hann : ∀ b : B, b ∈ Module.annihilator B (B ⊗[A] M) ↔ ∀ j, b ⊗ₜ[A] x j = 0 := by
    intro b
    rw [← Submodule.annihilator_top, ← hgen, Submodule.mem_annihilator_span]
    constructor
    · intro h j
      have h' := h ⟨(1 : B) ⊗ₜ[A] x j, ⟨j, rfl⟩⟩
      rwa [hsm] at h'
    · intro h z
      obtain ⟨j, hj⟩ := z.2
      rw [show ((z : B ⊗[A] M)) = (1 : B) ⊗ₜ[A] x j from hj.symm, hsm]
      exact h j
  have hpi : ∀ b : B, (b ⊗ₜ[A] x = 0) ↔ ∀ j, b ⊗ₜ[A] x j = 0 := by
    intro b
    rw [← (TensorProduct.piRight A B B fun _ : Fin n ↦ M).map_eq_zero_iff]
    simp [funext_iff]
  have hrange : Submodule.map (TensorProduct.AlgebraTensorModule.rid A B B).toLinearMap
      (LinearMap.range
        (TensorProduct.AlgebraTensorModule.lTensor B B (LinearMap.ker φ).subtype)) =
      (Module.annihilator A M).map (algebraMap A B) := by
    refine le_antisymm ?_ ?_
    · rw [Submodule.map_le_iff_le_comap]
      rintro z ⟨w, rfl⟩
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul b a =>
          rw [Submodule.mem_comap, LinearEquiv.coe_coe,
            TensorProduct.AlgebraTensorModule.lTensor_tmul,
            TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
          exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hker ▸ a.2))
      | add w₁ w₂ h₁ h₂ =>
          rw [map_add, Submodule.mem_comap, map_add]
          exact Submodule.add_mem _ h₁ h₂
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      have hmem : (1 : B) ⊗ₜ[A] a ∈ LinearMap.range
          (TensorProduct.AlgebraTensorModule.lTensor B B (LinearMap.ker φ).subtype) :=
        ⟨(1 : B) ⊗ₜ[A] (⟨a, hker ▸ ha⟩ : LinearMap.ker φ), rfl⟩
      have heq : algebraMap A B a =
          TensorProduct.AlgebraTensorModule.rid A B B ((1 : B) ⊗ₜ[A] a) := by
        rw [TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_one]
      rw [Ideal.mem_comap, heq]
      exact Submodule.mem_map_of_mem hmem
  have hlt : ∀ b : B, TensorProduct.AlgebraTensorModule.lTensor B B φ (b ⊗ₜ[A] (1 : A)) =
      b ⊗ₜ[A] x := fun b ↦ by
    rw [TensorProduct.AlgebraTensorModule.lTensor_tmul, hφ1]
  ext b
  rw [hann b, ← hpi b, ← hrange, Submodule.mem_map_equiv,
    ← Module.Flat.ker_lTensor_eq B B φ, LinearMap.mem_ker,
    TensorProduct.AlgebraTensorModule.rid_symm_apply, hlt b]

namespace KaehlerDifferential

/-- **Flat base change of the Kähler different.** Let `B = S ⊗[R] A` be a pushout of `R`-algebras
with `B` flat over `A`, and let `Ω[A⁄R]` be a finite `A`-module. Then the annihilator of
`Ω[B⁄S]` is the ideal of `B` generated by the annihilator of `Ω[A⁄R]`. -/
theorem annihilator_eq_map_of_isPushout (R S A B : Type*) [CommRing R] [CommRing S] [CommRing A]
    [CommRing B] [Algebra R S] [Algebra R A] [Algebra R B] [Algebra A B] [Algebra S B]
    [IsScalarTower R A B] [IsScalarTower R S B] [Algebra.IsPushout R S A B] [Module.Flat A B]
    [Module.Finite A Ω[A⁄R]] :
    Module.annihilator B Ω[B⁄S] = (Module.annihilator A Ω[A⁄R]).map (algebraMap A B) := by
  rw [← (KaehlerDifferential.tensorKaehlerEquiv R S A B).annihilator_eq,
    Module.annihilator_baseChange]

/-- **A faithfully flat base change detects the Kähler different.** In a pushout square `R → S`,
`R → A`, `B = S ⊗_R A` with `B` faithfully flat over `A`, an ideal of `A` whose extension to `B`
is the annihilator of `Ω[B⁄S]` is the annihilator of `Ω[A⁄R]`. -/
theorem eq_annihilator_of_map_eq_of_isPushout (R S A B : Type*) [CommRing R] [CommRing S]
    [CommRing A] [CommRing B] [Algebra R S] [Algebra R A] [Algebra R B] [Algebra A B]
    [Algebra S B] [IsScalarTower R A B] [IsScalarTower R S B] [Algebra.IsPushout R S A B]
    [Module.FaithfullyFlat A B] [Module.Finite A Ω[A⁄R]] {I : Ideal A}
    (h : I.map (algebraMap A B) = Module.annihilator B Ω[B⁄S]) :
    I = Module.annihilator A Ω[A⁄R] :=
  Ideal.map_injective_of_faithfullyFlat (h.trans (annihilator_eq_map_of_isPushout R S A B))

/-- **The Kähler different localises.** If `S` is the localisation of `R` at a submonoid `p` and
`B` is the localisation of `A` at the image of `p`, then the annihilator of `Ω[B⁄S]` is the ideal
of `B` generated by the annihilator of `Ω[A⁄R]`. -/
theorem annihilator_eq_map_of_isLocalization (R S A B : Type*) [CommRing R] [CommRing S]
    [CommRing A] [CommRing B] [Algebra R S] [Algebra R A] [Algebra R B] [Algebra A B]
    [Algebra S B] [IsScalarTower R A B] [IsScalarTower R S B] (p : Submonoid R)
    [IsLocalization p S] [IsLocalization (Algebra.algebraMapSubmonoid A p) B]
    [Module.Finite A Ω[A⁄R]] :
    Module.annihilator B Ω[B⁄S] = (Module.annihilator A Ω[A⁄R]).map (algebraMap A B) := by
  have := (Algebra.isPushout_of_isLocalization p S A B).symm
  have : Module.Flat A B := IsLocalization.flat B (Algebra.algebraMapSubmonoid A p)
  exact annihilator_eq_map_of_isPushout R S A B

end KaehlerDifferential

end
