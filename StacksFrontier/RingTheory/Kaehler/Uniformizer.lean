module

public import Mathlib.RingTheory.KrullDimension.Field
public import Mathlib.RingTheory.LocalRing.Module
public import StacksFrontier.RingTheory.Smooth.Conormal
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Kähler differentials of a one-dimensional local ring at a uniformizer

Let `R` be a local ring of Krull dimension one whose maximal ideal is generated by a single
element `s`, a *uniformizer*. The class of `s` in the cotangent space `𝔪/𝔪²` is then nonzero.
If moreover `R` is an algebra over a ring `K` whose residue field is formally étale over `K`, and
`Ω[R⁄K]` is finite and flat over `R`, then `Ω[R⁄K]` is free of rank one on `d s`.

## Main results

* `uniformizer_cotangent_class_ne_zero_of_dimension_one`: the cotangent class of a uniformizer of
  a one-dimensional local ring is nonzero.
* `differential_uniformizer_linearEquiv`: `Ω[R⁄K]` is free of rank one on the differential of a
  uniformizer.

## References

* [Stacks Project, Tag 0C1E](https://stacks.math.columbia.edu/tag/0C1E)
-/

@[expose] public section

open IsLocalRing

/-- If the maximal ideal of a local ring of Krull dimension one is generated by `s`, then the class
of `s` in the cotangent space `𝔪/𝔪²` is nonzero. -/
theorem uniformizer_cotangent_class_ne_zero_of_dimension_one
    {R : Type*} [CommRing R] [IsLocalRing R] (s : R)
    (hmax : maximalIdeal R = Ideal.span {s}) (hdim : ringKrullDim R = 1) :
    (Ideal.toCotangent (maximalIdeal R)
      ⟨s, by rw [hmax]; exact Ideal.subset_span (by simp)⟩) ≠ 0 := by
  intro hs0
  have hle : maximalIdeal R ≤ maximalIdeal R ^ 2 := by
    rw [hmax, Ideal.span_singleton_le_iff_mem]
    simpa [hmax] using (Ideal.toCotangent_eq_zero (maximalIdeal R) _).mp hs0
  have hbot : maximalIdeal R = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ (hmax ▸ Submodule.fg_span_singleton s)
      (by simpa only [smul_eq_mul, pow_two] using hle) (maximalIdeal_le_jacobson ⊥)
  simp [ringKrullDim_eq_zero_of_isField (isField_iff_maximalIdeal_eq.2 hbot)] at hdim

/-- Let `R` be a one-dimensional local `K`-algebra whose residue field is formally étale over `K`
and whose module of differentials is finite and flat, and let `s` generate the maximal ideal. Then
`Ω[R⁄K]` is free of rank one with basis the single element `d s`. -/
@[ega "IV 16.10.6" "Affine local case"]
theorem differential_uniformizer_linearEquiv
    (K R : Type*) [CommRing K] [CommRing R] [IsLocalRing R] [Algebra K R]
    [Algebra K (ResidueField R)] [IsScalarTower K R (ResidueField R)]
    [Algebra.FormallyEtale K (ResidueField R)]
    [Module.Finite R Ω[R⁄K]] [Module.Flat R Ω[R⁄K]]
    (s : R) (hs : maximalIdeal R = Ideal.span {s}) (hdim : ringKrullDim R = 1) :
    ∃ e : R ≃ₗ[R] Ω[R⁄K], e 1 = KaehlerDifferential.D K R s := by
  classical
  let κ := ResidueField R
  let v := KaehlerDifferential.D K R s
  have hker : RingHom.ker (algebraMap R κ) = maximalIdeal R := Ideal.mk_ker
  have hsI : s ∈ RingHom.ker (algebraMap R κ) := hker ▸ hs ▸ Ideal.mem_span_singleton_self s
  let c : (RingHom.ker (algebraMap R κ)).Cotangent :=
    Ideal.toCotangent _ ⟨s, hsI⟩
  have hc : c ≠ 0 := by
    change Ideal.toCotangent _ _ ≠ 0
    intro hz
    apply uniformizer_cotangent_class_ne_zero_of_dimension_one s hs hdim
    simpa only [Ideal.toCotangent_eq_zero, hker] using hz
  let t := KaehlerDifferential.kerCotangentToTensor K R κ
  have ht : Function.Injective t :=
    (KaehlerDifferential.split_exact_kerCotangentToTensor_mapBaseChange K R κ
      Ideal.Quotient.mk_surjective).1
  have htc : t c = (1 : κ) ⊗ₜ[R] v := rfl
  have hv : (1 : κ) ⊗ₜ[R] v ≠ 0 := fun h ↦ hc (ht ((htc.trans h).trans (map_zero t).symm))
  have hsurj : Function.Surjective t := fun z =>
    (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange K R κ
      Ideal.Quotient.mk_surjective z).mp (Subsingleton.elim _ _)
  have hspan : Submodule.span R {v} = ⊤ := by
    apply IsLocalRing.map_tensorProduct_mk_eq_top.mp
    apply top_unique
    intro z _
    obtain ⟨w, rfl⟩ := hsurj z
    obtain ⟨w, rfl⟩ := Ideal.toCotangent_surjective _ w
    have hwmem : w.val ∈ Ideal.span {s} := by
      rw [← hs, ← hker]
      exact w.property
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hwmem
    have hw : w = r • (⟨s, hsI⟩ : RingHom.ker (algebraMap R κ)) := by
      apply Subtype.ext
      simpa [smul_eq_mul, mul_comm] using hr
    rw [hw, map_smul, map_smul, htc]
    exact Submodule.smul_mem _ r (Submodule.mem_map_of_mem
      (Submodule.subset_span (by simp)))
  have hli : LinearIndependent R (fun _ : Unit => v) :=
    Module.IsLocalRing.linearIndependent_of_flat _ (linearIndependent_unique_iff.mpr hv)
  let b : Module.Basis Unit R Ω[R⁄K] := Module.Basis.mk hli (by simpa using hspan.ge)
  refine ⟨(b.repr.trans (Finsupp.uniqueLinearEquiv R R ())).symm, ?_⟩
  simp [b, v]

end
