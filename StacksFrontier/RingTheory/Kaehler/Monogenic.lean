module

public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.RingTheory.Kaehler.Polynomial
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Differentials of a monogenic algebra

Let `R` be an integrally closed domain and let `B` be an `R`-algebra which is a domain, generated
by a single integral element `x`, so that `B = R[x]`. Then `Ω[B⁄R]` is the cyclic `B`-module
generated by `dx`, and its annihilator is the ideal generated by `f'(x)`, where `f` is the minimal
polynomial of `x` over `R`. This ideal is the *Kähler different* of a monogenic extension.

## Main results

* `KaehlerDifferential.span_singleton_D_eq_top_of_adjoin_eq_top`: if `Algebra.adjoin R {x} = ⊤`
  then `Ω[B⁄R]` is generated over `B` by `dx`.
* `KaehlerDifferential.annihilator_eq_span_aeval_derivative_minpoly`: the annihilator of `Ω[B⁄R]`
  is `(f'(x))`.

## Implementation notes

The hard inclusion is that an element killing `dx` is divisible by `f'(x)`. It comes from the
conormal exact sequence of the presentation `R[X] ↠ B`, `X ↦ x`: giving `B` the `R[X]`-algebra
structure defined by `x`, Mathlib's `KaehlerDifferential.range_kerCotangentToTensor` identifies
the kernel of `B ⊗_{R[X]} Ω[R[X]⁄R] → Ω[B⁄R]` with the set of `1 ⊗ dg` for `g` in the kernel
ideal of `R[X] → B`. Since `Ω[R[X]⁄R]` is free on `dX`, the tensor product is `B` itself, and the
element of `B` corresponding to `1 ⊗ dg` is `g'(x)`; the kernel ideal is generated by `f`, because
`R` is integrally closed, so `g'(x)` is a multiple of `f'(x)`.

## References

* [Stacks Project, Tag 024Z](https://stacks.math.columbia.edu/tag/024Z), where the identification
  of the different of an extension of rings of integers with the annihilator of the module of
  differentials is asserted, and for which this is the monogenic case.
-/

@[expose] public section

open Polynomial TensorProduct

namespace KaehlerDifferential

section Span

variable {R B : Type*} [CommRing R] [CommRing B] [Algebra R B]

/-- If `B` is generated as an `R`-algebra by a single element `x`, then `Ω[B⁄R]` is generated as a
`B`-module by `dx`: the quotient of `Ω[B⁄R]` by `B · dx` receives a derivation that kills `x`,
hence kills `Algebra.adjoin R {x} = B`. -/
@[ega "0 20.4.7" "Single algebra generator"]
theorem span_singleton_D_eq_top_of_adjoin_eq_top {x : B} (hx : Algebra.adjoin R {x} = ⊤) :
    Submodule.span B {D R B x} = ⊤ := by
  have h0 : Set.EqOn ((Submodule.span B {D R B x}).mkQ.compDer (D R B)) 0 {x} := by
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    simp only [hy]
    simp [Submodule.Quotient.mk_eq_zero]
  have h := Derivation.eqOn_adjoin
    (D1 := (Submodule.span B {D R B x}).mkQ.compDer (D R B)) (D2 := 0) h0
  rw [eq_top_iff, ← span_range_derivation R B, Submodule.span_le]
  rintro z ⟨y, rfl⟩
  simpa [Submodule.Quotient.mk_eq_zero] using h (hx ▸ Algebra.mem_top (R := R) (x := y))

/-- For a cyclic module of differentials the annihilator of `Ω[B⁄R]` is the annihilator of the
single generator `dx`. -/
theorem mem_annihilator_iff_smul_D_eq_zero {x : B} (hx : Algebra.adjoin R {x} = ⊤) (b : B) :
    b ∈ Module.annihilator B Ω[B⁄R] ↔ b • D R B x = 0 := by
  refine ⟨fun hb ↦ Module.mem_annihilator.mp hb _, fun hb ↦ Module.mem_annihilator.mpr ?_⟩
  intro ω
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp
    (span_singleton_D_eq_top_of_adjoin_eq_top hx ▸ Submodule.mem_top (x := ω))
  rw [smul_comm, hb, smul_zero]

end Span

variable {R B : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing B] [IsDomain B]
  [Algebra R B] [Module.IsTorsionFree R B]

/-- **The Kähler different of a monogenic extension.** If `B = R[x]` with `x` integral over the
integrally closed domain `R`, then the annihilator of `Ω[B⁄R]` is the ideal generated by
`f'(x)`, where `f` is the minimal polynomial of `x` over `R`. -/
@[ega "IV 18.4.1" "special case"]
theorem annihilator_eq_span_aeval_derivative_minpoly {x : B} (hx : IsIntegral R x)
    (hgen : Algebra.adjoin R {x} = ⊤) :
    Module.annihilator B Ω[B⁄R] = Ideal.span {aeval x (derivative (minpoly R x))} := by
  -- Present `B` as a quotient of `R[X]` by sending `X` to `x`.
  let : Algebra R[X] B := RingHom.toAlgebra (aeval x : R[X] →ₐ[R] B).toRingHom
  have halg : ∀ p : R[X], algebraMap R[X] B p = aeval x p := fun _ ↦ rfl
  have : IsScalarTower R R[X] B := IsScalarTower.of_algebraMap_eq fun r ↦ by
    rw [halg, Polynomial.algebraMap_eq, aeval_C]
  have hsurj : Function.Surjective (algebraMap R[X] B) := fun b ↦ by
    obtain ⟨p, hp⟩ : ∃ p : R[X], aeval x p = b := by
      have hmem : b ∈ Algebra.adjoin R ({x} : Set B) := by rw [hgen]; exact Algebra.mem_top
      rwa [Algebra.adjoin_singleton_eq_range_aeval R x, AlgHom.mem_range] at hmem
    exact ⟨p, by rw [halg]; exact hp⟩
  -- `Ω[R[X]⁄R]` is free on `dX`, so `B ⊗_{R[X]} Ω[R[X]⁄R]` is `B`.
  let e : B ⊗[R[X]] Ω[R[X]⁄R] ≃ₗ[B] B :=
    (TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl B B)
      (KaehlerDifferential.polynomialEquiv R)).trans
        (TensorProduct.AlgebraTensorModule.rid R[X] B B)
  have he : ∀ (c : B) (p : R[X]), e (c ⊗ₜ[R[X]] D R R[X] p) = aeval x (derivative p) * c := by
    intro c p
    simp only [e, LinearEquiv.trans_apply, TensorProduct.AlgebraTensorModule.congr_tmul,
      LinearEquiv.refl_apply, KaehlerDifferential.polynomialEquiv_D,
      TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, halg]
  refine le_antisymm (fun b hb ↦ ?_) ?_
  · -- An element killing `dx` comes from a `g` in the kernel of `R[X] → B`, as `g'(x)`.
    rw [mem_annihilator_iff_smul_D_eq_zero hgen] at hb
    have hker : (b ⊗ₜ[R[X]] D R R[X] X) ∈
        LinearMap.range (KaehlerDifferential.kerCotangentToTensor R R[X] B) := by
      rw [KaehlerDifferential.range_kerCotangentToTensor R R[X] B hsurj]
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker,
        KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D, halg, aeval_X]
      exact hb
    obtain ⟨c, hc⟩ := hker
    obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective _ c
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hc
    have hy : aeval x (y : R[X]) = 0 := by
      have hy' := y.2
      rwa [RingHom.mem_ker, halg] at hy'
    have key := congrArg e hc
    rw [he 1 (y : R[X]), he b X, mul_one, derivative_X, map_one, one_mul] at key
    obtain ⟨q, hq⟩ := minpoly.isIntegrallyClosed_dvd hx hy
    rw [← key, hq, derivative_mul, map_add, map_mul, map_mul, minpoly.aeval, zero_mul, add_zero]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  · -- `f'(x)` kills `dx`, because `f(x) = 0`.
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      mem_annihilator_iff_smul_D_eq_zero hgen]
    have h := (D R B).map_aeval (minpoly R x) x
    rw [minpoly.aeval, map_zero] at h
    exact h.symm

end KaehlerDifferential

end
