module

public import StacksFrontier.RingTheory.Kaehler.KatzOdaDifferential
public import StacksFrontier.AlgebraicGeometry.DeRham.Complex.AffineOpenDeRhamRestriction
public import StacksFrontier.AlgebraicGeometry.AffineDifferentialsIso.DeRhamComplexComparison
public import Mathlib.RingTheory.RingHom.Smooth
public import StacksFrontier.RingTheory.DeRham.MapExteriorPowerNaturality

/-!
# The filtration of de Rham forms by forms from the base, for maps of commutative rings

Let `R ⟶ A ⟶ B` be maps of commutative rings. The forms `⋀^n Ω[B⁄R]` are filtered by the
submodules `F^k` generated by the products `ω ∧ η` with `ω` a `j`-form pulled back from `A`,
`j ≥ k` (`exteriorPower.wedgeStep`). This file restates the facts about this filtration proved for
towers of algebras in `StacksFrontier.RingTheory.Kaehler.KatzOdaGraded`,
`StacksFrontier.RingTheory.Kaehler.KatzOdaFunctorial` and
`StacksFrontier.RingTheory.Kaehler.KatzOdaDifferential` for maps in `CommRingCat`, with the Kähler
differentials of `CommRingCat.KaehlerDifferential`. These are the spellings in which the forms on
an affine open of a scheme are identified with Kähler forms
(`Stacks.AlgebraicGeometry.AffineOpenDeRham.formsSectionsIso`), so the statements here apply to
them with no change of algebra structures.

The composite `R ⟶ B` is a separate map `ψ` together with a proof `gR ≫ φ = ψ`, because the
structure maps of a scheme over a base are composites only up to equality.

## Main definitions

* `Stacks.KatzOda.step`: the filtration `F^k ⋀^n Ω[B⁄R]`.
* `Stacks.KatzOda.dForms`: the de Rham differential of `Ω^•[B⁄R]`.
-/

@[expose] public noncomputable section

open CategoryTheory
open scoped TensorProduct

universe u

namespace Stacks.KatzOda

open _root_.KaehlerDifferential

variable {R A B : CommRingCat.{u}} (gR : R ⟶ A) (φ : A ⟶ B) (ψ : R ⟶ B) (h : gR ≫ φ = ψ)

include h in
/-- The algebra structures of a triangle of ring maps form a tower. -/
theorem isScalarTower :
    letI := gR.hom.toAlgebra
    letI := φ.hom.toAlgebra
    letI := ψ.hom.toAlgebra
    IsScalarTower R A B := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  refine IsScalarTower.of_algebraMap_eq fun r => ?_
  change ψ r = φ (gR r)
  rw [← h]
  rfl

/-- **The filtration by forms from the base**: `F^k ⋀^n Ω[B⁄R]`, generated by the products of
`j`-forms pulled back from `A`, `j ≥ k`, with `(n - j)`-forms. -/
def step (k n : ℕ) : Submodule B (⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)) :=
  letI := gR.hom.toAlgebra
  letI := φ.hom.toAlgebra
  letI := ψ.hom.toAlgebra
  haveI := isScalarTower gR φ ψ h
  exteriorPower.wedgeStep (mapBaseChange R A B) k n

/-- The zeroth step of the filtration is the whole module: `F^0 ⋀^n Ω[B⁄R] = ⋀^n Ω[B⁄R]`. -/
theorem step_zero (n : ℕ) : step gR φ ψ h 0 n = ⊤ := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  exact _root_.KaehlerDifferential.wedgeStep_zero R A B n

/-- The filtration is decreasing: `F^{k+1} ⋀^n Ω[B⁄R] ≤ F^k ⋀^n Ω[B⁄R]`. -/
theorem step_succ_le (k n : ℕ) : step gR φ ψ h (k + 1) n ≤ step gR φ ψ h k n := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  exact exteriorPower.wedgeStep_mono _ (Nat.le_succ k) n

/-- The filtration vanishes beyond the degree: `F^k ⋀^n Ω[B⁄R] = 0` for `n < k`. -/
theorem step_eq_bot {k n : ℕ} (hn : n < k) : step gR φ ψ h k n = ⊥ := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  refine eq_bot_iff.2 ((exteriorPower.wedgeStep_le_iff _ k n ⊥).2 ?_)
  intro j m hjm hk
  omega

/-- The de Rham differential `⋀^n Ω[B⁄R] ⟶ ⋀^{n+1} Ω[B⁄R]`, the differential of the algebraic de
Rham complex of `ψ`. -/
def dForms (n : ℕ) (x : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)) :
    ⋀[B]^(n + 1) ↑(CommRingCat.KaehlerDifferential ψ) :=
  ((Stacks.AlgebraicGeometry.AffineDifferentialsIso.ringDeRhamComplex ψ).d n (n + 1)).hom x

/-- `dForms ψ` is the de Rham differential `KaehlerDifferential.deRhamDifferential` of the
`R`-algebra `B`. -/
theorem dForms_eq (n : ℕ) (x : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)) :
    letI := ψ.hom.toAlgebra
    dForms ψ n x = _root_.KaehlerDifferential.deRhamDifferential (A := R) (B := B) n x := by
  let := ψ.hom.toAlgebra
  change ((KaehlerDifferential.deRhamComplex R B).d n (n + 1)).hom x = _
  rw [KaehlerDifferential.deRhamComplex_d]
  rfl

include h in
/-- **The differential preserves the filtration.** -/
theorem dForms_mem {k n : ℕ} {x : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)}
    (hx : x ∈ step gR φ ψ h k n) : dForms ψ n x ∈ step gR φ ψ h k (n + 1) := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  rw [dForms_eq]
  exact _root_.KaehlerDifferential.deRhamDifferential_mem_wedgeStep R A B hx

section Map

variable {B' : CommRingCat.{u}} (φ' : A ⟶ B') (ψ' : R ⟶ B') (h' : gR ≫ φ' = ψ') (ρ : B ⟶ B')
  (hφ : φ ≫ ρ = φ') (hψ : ψ ≫ ρ = ψ')

include h h' hφ in
/-- **Restriction of forms along a map of `A`-algebras preserves the filtration.** -/
theorem formsMap_mem {k n : ℕ} {x : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)}
    (hx : x ∈ step gR φ ψ h k n) :
    Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ n x ∈ step gR φ' ψ' h' k n := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  let := φ'.hom.toAlgebra
  let := ψ'.hom.toAlgebra
  let := ρ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  have := isScalarTower gR φ' ψ' h'
  have := Stacks.AlgebraicGeometry.AffineOpenDeRham.isScalarTower_of_comp_eq ψ ψ' ρ hψ
  have := isScalarTower φ ρ φ' hφ
  exact _root_.KaehlerDifferential.mapExteriorPower_mem_wedgeStep R A B B' hx

end Map

/-! ### Graded pieces -/

/-- The graded piece `F^k ⋀^n Ω[B⁄R] / F^{k+1} ⋀^n Ω[B⁄R]`. -/
abbrev gradedQuot (k n : ℕ) : Type u :=
  ↥(step gR φ ψ h k n) ⧸ (step gR φ ψ h (k + 1) n).comap (step gR φ ψ h k n).subtype

/-- The projection `⋀^n Ω[B⁄R] ⟶ ⋀^n Ω[B⁄A]`. -/
def formsProj (n : ℕ) (x : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)) :
    ⋀[B]^n ↑(CommRingCat.KaehlerDifferential φ) :=
  letI := gR.hom.toAlgebra
  letI := φ.hom.toAlgebra
  letI := ψ.hom.toAlgebra
  haveI := isScalarTower gR φ ψ h
  exteriorPower.map n (map R A B B) x

/-- The projection `⋀^n Ω[B⁄R] ⟶ ⋀^n Ω[B⁄A]` is surjective. -/
theorem formsProj_surjective (n : ℕ) : Function.Surjective (formsProj gR φ ψ h n) := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  exact exteriorPower.map_surjective (map_surjective R A B)

/-- Left multiplication by the base change of a form from `A` is the wedge product with its
restriction to `B`. -/
theorem wedgeLeftMul_tensorBaseChange_one_tmul (R A B : Type u) [CommRing R] [CommRing A]
    [CommRing B] [Algebra R A] [Algebra A B] [Algebra R B] [IsScalarTower R A B] {k b : ℕ}
    (ν : ⋀[A]^k Ω[A⁄R]) (y : ⋀[B]^b Ω[B⁄R]) :
    exteriorPower.wedgeLeftMul (mapBaseChange R A B) (rfl : k + b = k + b)
        (exteriorPower.tensorBaseChange A B (Ω[A⁄R]) k (1 ⊗ₜ ν)) y =
      exteriorPower.wedgeMul k b (mapExteriorPower R A B k ν) y :=
  Subtype.ext (by
    rw [exteriorPower.coe_wedgeLeftMul, coe_map_tensorBaseChange_one_tmul,
      exteriorPower.wedgeMul_apply_coe])

include h in
/-- The product `ν ∧ y` of a `k`-form `ν` pulled back from `A` with a `b`-form `y` lies in
`F^k ⋀^{k+b} Ω[B⁄R]`. -/
theorem wedgeMul_formsMap_mem (k b : ℕ) (ν : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR))
    (y : ⋀[B]^b ↑(CommRingCat.KaehlerDifferential ψ)) :
    exteriorPower.wedgeMul k b (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ φ h k ν) y ∈
      step gR φ ψ h k (k + b) := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  revert ν y
  intro (ν : ⋀[A]^k Ω[A⁄R]) (y : ⋀[B]^b Ω[B⁄R])
  change exteriorPower.wedgeMul k b (mapExteriorPower R A B k ν) y ∈
    exteriorPower.wedgeStep (mapBaseChange R A B) k (k + b)
  have hw := exteriorPower.wedgeLeftMul_mem_wedgeStep (mapBaseChange R A B)
    (rfl : k + b = k + b) le_rfl (exteriorPower.tensorBaseChange A B (Ω[A⁄R]) k (1 ⊗ₜ ν)) y
  rw [← wedgeLeftMul_tensorBaseChange_one_tmul]
  exact hw

/-- Scalar multiplication by `(-1)^n` in a ring `S` agrees with that by the integer `(-1)^n`. -/
theorem neg_one_pow_smul_eq_zsmul {M : Type*} [AddCommGroup M] {S : Type*} [Ring S] [Module S M]
    (n : ℕ) (x : M) : ((-1 : S) ^ n) • x = ((-1 : ℤ) ^ n) • x := by
  rw [show ((-1 : S) ^ n) = (((-1 : ℤ) ^ n : ℤ) : S) by push_cast; rfl, Int.cast_smul_eq_zsmul]

section Tensor

variable {M : Type u} [AddCommGroup M] [Module A M] {b : ℕ}
  (eM : M ≃+ ⋀[B]^b ↑(CommRingCat.KaehlerDifferential φ))
  (heM : ∀ (a : A) (m : M), eM (a • m) = φ a • eM m)
  (hsm : φ.hom.FormallySmooth)

/-- **The graded pieces as tensor products over `A`**:
`⋀^k Ω[A⁄R] ⊗_A M ≅ F^k ⋀^{k+b} Ω[B⁄R] / F^{k+1}`, `ν ⊗ m ↦ (-1)^{kb} [ν ∧ m̂]` for any lift
`m̂ ∈ ⋀^b Ω[B⁄R]` of the image of `m` in `⋀^b Ω[B⁄A]`, where `M` is identified with
`⋀^b Ω[B⁄A]` along `eM`, for `A ⟶ B` formally smooth. -/
def gradedTensor (k : ℕ) :
    ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR) ⊗[A] M ≃+ gradedQuot gR φ ψ h k (k + b) :=
  letI := gR.hom.toAlgebra
  letI := φ.hom.toAlgebra
  letI := ψ.hom.toAlgebra
  haveI := isScalarTower gR φ ψ h
  haveI : Algebra.FormallySmooth A B := hsm
  let eA : M ≃ₗ[A] ⋀[B]^b Ω[B⁄A] :=
    { eM with
      map_smul' := fun a m => (heM a m).trans
        (algebraMap_smul B a (show ⋀[B]^b Ω[B⁄A] from eM m)) }
  let e0 : M ≃ₗ[A] exteriorPower.wedgeZeroGraded (mapBaseChange R A B) b :=
    eA.trans ((wedgeZeroGradedEquiv R A B b).restrictScalars A).symm
  ((LinearEquiv.lTensor _ e0).trans (LinearEquiv.ofBijective
    (gradedMulSigned R A B (k := k) (m := b) rfl) (gradedMulSigned_bijective R A B rfl))).toAddEquiv

set_option maxRecDepth 8000 in
/-- `gradedTensor` sends `ν ⊗ m` to `(-1)^{kb} [ν ∧ y]` for any `y ∈ ⋀^b Ω[B⁄R]` whose
projection to `⋀^b Ω[B⁄A]` is the image of `m`. -/
theorem gradedTensor_tmul (k : ℕ) (ν : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR)) (m : M)
    (y : ⋀[B]^b ↑(CommRingCat.KaehlerDifferential ψ)) (hy : formsProj gR φ ψ h b y = eM m) :
    gradedTensor gR φ ψ h eM heM hsm k (ν ⊗ₜ m) =
      ((-1 : ℤ) ^ (k * b)) • Submodule.Quotient.mk
        ⟨exteriorPower.wedgeMul k b
          (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ φ h k ν) y,
          wedgeMul_formsMap_mem gR φ ψ h k b ν y⟩ := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  have : Algebra.FormallySmooth A B := hsm
  revert hy y m ν
  intro (ν : ⋀[A]^k Ω[A⁄R]) m (y : ⋀[B]^b Ω[B⁄R]) hy
  have h0 : ((wedgeZeroGradedEquiv R A B b).restrictScalars A).symm (eM m) =
      Submodule.Quotient.mk y :=
    (LinearEquiv.symm_apply_eq _).2 hy.symm
  change gradedMulSigned R A B (k := k) (m := b) rfl
      (ν ⊗ₜ ((wedgeZeroGradedEquiv R A B b).restrictScalars A).symm (eM m)) =
    ((-1 : ℤ) ^ (k * b)) • (Submodule.Quotient.mk
      ⟨exteriorPower.wedgeMul k b (mapExteriorPower R A B k ν) y,
        wedgeMul_formsMap_mem gR φ ψ h k b ν y⟩ :
          exteriorPower.wedgeGraded (mapBaseChange R A B) k (k + b))
  rw [h0, gradedMulSigned, LinearMap.smul_apply, gradedMul_tmul,
    exteriorPower.gradedLeftMul_tmul_mk, neg_one_pow_smul_eq_zsmul]
  congr 2
  exact Subtype.ext (wedgeLeftMul_tensorBaseChange_one_tmul R A B ν y)

end Tensor

section RingLevel

variable (R A B B' : Type u) [CommRing R] [CommRing A] [CommRing B] [CommRing B'] [Algebra R A]
  [Algebra A B] [Algebra R B] [IsScalarTower R A B] [Algebra A B'] [Algebra R B']
  [IsScalarTower R A B'] [Algebra B B'] [IsScalarTower R B B'] [IsScalarTower A B B']

/-- Restriction of differentials commutes with the projection `Ω[-⁄R] ⟶ Ω[-⁄A]`. -/
theorem map_map_restrict (ω : Ω[B⁄R]) :
    map R A B' B' (map R R B B' ω) = map A A B B' (map R A B B ω) := by
  have key : (map R A B' B').restrictScalars B ∘ₗ map R R B B' =
      (map A A B B').restrictScalars B ∘ₗ map R A B B := by
    refine LinearMap.ext_on (span_range_derivation R B) ?_
    rintro _ ⟨b, rfl⟩
    simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Function.comp_apply, map_D]
    rfl
  exact LinearMap.congr_fun key ω

/-- Restriction of forms commutes with the projection `⋀ Ω[-⁄R] ⟶ ⋀ Ω[-⁄A]`. -/
theorem map_mapExteriorPower_restrict (n : ℕ) (y : ⋀[B]^n Ω[B⁄R]) :
    exteriorPower.map n (map R A B' B') (mapExteriorPower R B B' n y) =
      mapExteriorPower A B B' n (exteriorPower.map n (map R A B B) y) := by
  have hy : y ∈ Submodule.span B (Set.range (exteriorPower.ιMulti B n)) := by
    rw [exteriorPower.ιMulti_span]; trivial
  induction hy using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨v, rfl⟩ := hx
    rw [mapExteriorPower_ιMulti, exteriorPower.map_apply_ιMulti, exteriorPower.map_apply_ιMulti,
      mapExteriorPower_ιMulti]
    congr 1
    funext i
    exact map_map_restrict R A B B' (v i)
  | zero => simp only [map_zero]
  | add x y _ _ hx hy => simp only [map_add, hx, hy]
  | smul c x _ hx =>
    rw [map_smul, ← algebraMap_smul B' c, map_smul, hx, map_smul, map_smul, algebraMap_smul]

end RingLevel

section Map

variable {B' : CommRingCat.{u}} (φ' : A ⟶ B') (ψ' : R ⟶ B') (h' : gR ≫ φ' = ψ') (ρ : B ⟶ B')
  (hφ : φ ≫ ρ = φ') (hψ : ψ ≫ ρ = ψ')

include h h' hφ in
/-- Restriction of forms commutes with the projection to the forms relative to `A`. -/
theorem formsProj_formsMap (n : ℕ) (y : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)) :
    formsProj gR φ' ψ' h' n (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ n y) =
      Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap φ φ' ρ hφ n (formsProj gR φ ψ h n y) := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  let := φ'.hom.toAlgebra
  let := ψ'.hom.toAlgebra
  let := ρ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  have := isScalarTower gR φ' ψ' h'
  have := Stacks.AlgebraicGeometry.AffineOpenDeRham.isScalarTower_of_comp_eq ψ ψ' ρ hψ
  have := isScalarTower φ ρ φ' hφ
  revert y
  intro (y : ⋀[B]^n Ω[B⁄R])
  exact map_mapExteriorPower_restrict R A B B' n y

include h h' hφ in
/-- Restriction of forms is multiplicative. -/
theorem formsMap_wedgeMul (p q : ℕ) (x : ⋀[B]^p ↑(CommRingCat.KaehlerDifferential ψ))
    (y : ⋀[B]^q ↑(CommRingCat.KaehlerDifferential ψ)) :
    Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ (p + q)
        (exteriorPower.wedgeMul p q x y) =
      exteriorPower.wedgeMul p q (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ p x)
        (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ q y) := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  let := φ'.hom.toAlgebra
  let := ψ'.hom.toAlgebra
  let := ρ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  have := isScalarTower gR φ' ψ' h'
  have := Stacks.AlgebraicGeometry.AffineOpenDeRham.isScalarTower_of_comp_eq ψ ψ' ρ hψ
  have := isScalarTower φ ρ φ' hφ
  revert x y
  intro (x : ⋀[B]^p Ω[B⁄R]) (y : ⋀[B]^q Ω[B⁄R])
  exact mapExteriorPower_wedgeMul R B B' p q x y

include h h' hφ in
/-- Restricting a form pulled back from `A` along `B ⟶ B'` is pulling it back to `B'`. -/
theorem formsMap_formsMap (k : ℕ) (ν : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR)) :
    Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ k
        (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ φ h k ν) =
      Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ' φ' h' k ν := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  let := φ'.hom.toAlgebra
  let := ψ'.hom.toAlgebra
  let := ρ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  have := isScalarTower gR φ' ψ' h'
  have := Stacks.AlgebraicGeometry.AffineOpenDeRham.isScalarTower_of_comp_eq ψ ψ' ρ hψ
  have := isScalarTower φ ρ φ' hφ
  revert ν
  intro (ν : ⋀[A]^k Ω[A⁄R])
  exact LinearMap.congr_fun (mapExteriorPower_comp R A B B' k) ν

end Map

section GradedMaps

/-- The differential on the graded pieces. -/
def gradedQuotD (k n : ℕ) (q : gradedQuot gR φ ψ h k n) : gradedQuot gR φ ψ h k (n + 1) :=
  letI := gR.hom.toAlgebra
  letI := φ.hom.toAlgebra
  letI := ψ.hom.toAlgebra
  haveI := isScalarTower gR φ ψ h
  gradedD R A B k n q

/-- The differential of the graded pieces sends the class of `x` to the class of `dForms ψ n x`. -/
theorem gradedQuotD_mk (k n : ℕ) (x : step gR φ ψ h k n) :
    gradedQuotD gR φ ψ h k n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk ⟨dForms ψ n x, dForms_mem gR φ ψ h x.2⟩ := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  rcases x with ⟨x, hx⟩
  revert x
  intro (x : ⋀[B]^n Ω[B⁄R]) hx
  change Submodule.Quotient.mk (stepD R A B k n ⟨x, hx⟩) = _
  congr 1
  exact Subtype.ext (dForms_eq ψ n x).symm

/-- The differential of the graded pieces commutes with multiplication by integers. -/
theorem gradedQuotD_zsmul (k n : ℕ) (e : ℤ) (q : gradedQuot gR φ ψ h k n) :
    gradedQuotD gR φ ψ h k n (e • q) = e • gradedQuotD gR φ ψ h k n q := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  exact map_zsmul (gradedD R A B k n) e q

variable {B' : CommRingCat.{u}} (φ' : A ⟶ B') (ψ' : R ⟶ B') (h' : gR ≫ φ' = ψ') (ρ : B ⟶ B')
  (hφ : φ ≫ ρ = φ') (hψ : ψ ≫ ρ = ψ')

/-- Restriction of forms on the steps of the filtration. -/
def stepMap (k n : ℕ) : step gR φ ψ h k n →ₛₗ[ρ.hom] step gR φ' ψ' h' k n where
  toFun x := ⟨Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ n x,
    formsMap_mem gR φ ψ h φ' ψ' h' ρ hφ hψ x.2⟩
  map_add' x y := Subtype.ext
    (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap_add ψ ψ' ρ hψ n x y)
  map_smul' b x := Subtype.ext
    (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap_smul ψ ψ' ρ hψ n b x)

/-- Restriction of forms on the graded pieces. -/
def gradedQuotMap (k n : ℕ) :
    gradedQuot gR φ ψ h k n →ₛₗ[ρ.hom] gradedQuot gR φ' ψ' h' k n :=
  Submodule.mapQ _ _ (stepMap gR φ ψ h φ' ψ' h' ρ hφ hψ k n)
    fun _ hx => Submodule.mem_comap.2 (Submodule.mem_comap.2
      (formsMap_mem gR φ ψ h φ' ψ' h' ρ hφ hψ (Submodule.mem_comap.1 hx)))

/-- Restriction of forms on the graded pieces sends the class of `x` to the class of its
restriction. -/
theorem gradedQuotMap_mk (k n : ℕ) (x : step gR φ ψ h k n) :
    gradedQuotMap gR φ ψ h φ' ψ' h' ρ hφ hψ k n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk ⟨Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ n x,
        formsMap_mem gR φ ψ h φ' ψ' h' ρ hφ hψ x.2⟩ :=
  rfl

end GradedMaps

/-- The projection to the forms relative to `A` commutes with the differentials. -/
theorem formsProj_dForms (n : ℕ) (y : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)) :
    formsProj gR φ ψ h (n + 1) (dForms ψ n y) = dForms φ n (formsProj gR φ ψ h n y) := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  revert y
  intro (y : ⋀[B]^n Ω[B⁄R])
  refine (congrArg (exteriorPower.map (n + 1) (map R A B B)) (dForms_eq ψ n y)).trans ?_
  refine (map_exteriorPower_deRhamDifferential R A B n y).trans ?_
  exact (dForms_eq φ n _).symm

/-- **The differential of `gr^k` on a product with a form from `A`**:
`d [ν ∧ y] = (-1)^k [ν ∧ d y]`. -/
theorem gradedQuotD_mk_wedgeMul (k b : ℕ) (ν : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR))
    (y : ⋀[B]^b ↑(CommRingCat.KaehlerDifferential ψ)) :
    gradedQuotD gR φ ψ h k (k + b) (Submodule.Quotient.mk ⟨exteriorPower.wedgeMul k b
        (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ φ h k ν) y,
          wedgeMul_formsMap_mem gR φ ψ h k b ν y⟩) =
      ((-1 : ℤ) ^ k) • Submodule.Quotient.mk ⟨exteriorPower.wedgeMul k (b + 1)
        (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ φ h k ν) (dForms ψ b y),
          wedgeMul_formsMap_mem gR φ ψ h k (b + 1) ν (dForms ψ b y)⟩ := by
  let := gR.hom.toAlgebra
  let := φ.hom.toAlgebra
  let := ψ.hom.toAlgebra
  have := isScalarTower gR φ ψ h
  have hd := dForms_eq ψ b y
  revert ν y
  intro (ν : ⋀[A]^k Ω[A⁄R]) (y : ⋀[B]^b Ω[B⁄R]) hd
  refine (gradedD_mk_wedgeMul R A B ν y (wedgeMul_formsMap_mem gR φ ψ h k b ν y)
    (hd ▸ wedgeMul_formsMap_mem gR φ ψ h k (b + 1) ν (dForms ψ b y))).trans ?_
  rw [neg_one_pow_smul_eq_zsmul]
  congr 2
  exact Subtype.ext (congrArg (exteriorPower.wedgeMul k (b + 1) (mapExteriorPower R A B k ν))
    hd.symm)


section TensorMaps

variable {M : Type u} [AddCommGroup M] [Module A M] {b : ℕ}
  (eM : M ≃+ ⋀[B]^b ↑(CommRingCat.KaehlerDifferential φ))
  (heM : ∀ (a : A) (m : M), eM (a • m) = φ a • eM m)
  (hsm : φ.hom.FormallySmooth)

section Restrict

variable {B' : CommRingCat.{u}} (φ' : A ⟶ B') (ψ' : R ⟶ B') (h' : gR ≫ φ' = ψ') (ρ : B ⟶ B')
  (hφ : φ ≫ ρ = φ') (hψ : ψ ≫ ρ = ψ')
  {M' : Type u} [AddCommGroup M'] [Module A M']
  (eM' : M' ≃+ ⋀[B']^b ↑(CommRingCat.KaehlerDifferential φ'))
  (heM' : ∀ (a : A) (m : M'), eM' (a • m) = φ' a • eM' m)
  (hsm' : φ'.hom.FormallySmooth) (res : M →ₗ[A] M')
  (hres : ∀ m, eM' (res m) = Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap φ φ' ρ hφ b (eM m))

include hres in
/-- **The identification of the graded pieces commutes with restriction along `B ⟶ B'`.** -/
theorem gradedTensor_map (k : ℕ) (z : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR) ⊗[A] M) :
    gradedTensor gR φ' ψ' h' eM' heM' hsm' k (TensorProduct.map LinearMap.id res z) =
      gradedQuotMap gR φ ψ h φ' ψ' h' ρ hφ hψ k (k + b) (gradedTensor gR φ ψ h eM heM hsm k z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | add z z' hz hz' => simp only [map_add, hz, hz']
  | tmul ν m =>
    obtain ⟨y, hy⟩ := formsProj_surjective gR φ ψ h b (eM m)
    have hy' : formsProj gR φ' ψ' h' b
        (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ b y) = eM' (res m) := by
      rw [formsProj_formsMap gR φ ψ h φ' ψ' h' ρ hφ hψ, hy, hres]
    rw [TensorProduct.map_tmul, LinearMap.id_apply,
      gradedTensor_tmul gR φ' ψ' h' eM' heM' hsm' k ν (res m) _ hy',
      gradedTensor_tmul gR φ ψ h eM heM hsm k ν m y hy, map_zsmul, gradedQuotMap_mk]
    congr 2
    refine Subtype.ext ?_
    change _ = Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap ψ ψ' ρ hψ (k + b)
      (exteriorPower.wedgeMul k b
        (Stacks.AlgebraicGeometry.AffineOpenDeRham.formsMap gR ψ φ h k ν) y)
    rw [formsMap_wedgeMul gR φ ψ h φ' ψ' h' ρ hφ hψ,
      formsMap_formsMap gR φ ψ h φ' ψ' h' ρ hφ hψ]

end Restrict

section Differential

variable {M'' : Type u} [AddCommGroup M''] [Module A M'']
  (eM'' : M'' ≃+ ⋀[B]^(b + 1) ↑(CommRingCat.KaehlerDifferential φ))
  (heM'' : ∀ (a : A) (m : M''), eM'' (a • m) = φ a • eM'' m)
  (dM : M →ₗ[A] M'') (hdM : ∀ m, eM'' (dM m) = dForms φ b (eM m))

include hdM in
/-- **The identification of the graded pieces commutes with the differentials.** -/
theorem gradedTensor_d (k : ℕ) (z : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR) ⊗[A] M) :
    gradedTensor gR φ ψ h eM'' heM'' hsm k (TensorProduct.map LinearMap.id dM z) =
      gradedQuotD gR φ ψ h k (k + b) (gradedTensor gR φ ψ h eM heM hsm k z) := by
  induction z using TensorProduct.induction_on with
  | zero =>
    have e1 : TensorProduct.map LinearMap.id dM
        (0 : ⋀[A]^k ↑(CommRingCat.KaehlerDifferential gR) ⊗[A] M) = 0 := map_zero _
    rw [e1, map_zero, map_zero]
    exact (zero_smul ℤ _).symm.trans ((gradedQuotD_zsmul gR φ ψ h k (k + b) 0 0).symm.trans
      (by rw [zero_smul]))
  | add z z' hz hz' =>
    rw [map_add, map_add, hz, hz', map_add]
    let := gR.hom.toAlgebra
    let := φ.hom.toAlgebra
    let := ψ.hom.toAlgebra
    have := isScalarTower gR φ ψ h
    exact (map_add (gradedD R A B k (k + b)) _ _).symm
  | tmul ν m =>
    obtain ⟨y, hy⟩ := formsProj_surjective gR φ ψ h b (eM m)
    have hy' : formsProj gR φ ψ h (b + 1) (dForms ψ b y) = eM'' (dM m) := by
      rw [formsProj_dForms, hy, hdM]
    rw [TensorProduct.map_tmul, LinearMap.id_apply,
      gradedTensor_tmul gR φ ψ h eM'' heM'' hsm k ν (dM m) _ hy',
      gradedTensor_tmul gR φ ψ h eM heM hsm k ν m y hy, gradedQuotD_zsmul,
      gradedQuotD_mk_wedgeMul, smul_smul, ← pow_add]
    congr 1

end Differential

end TensorMaps

/-! ### Transport along an identification with Kähler forms -/

section Comap

variable {L : Type u} [AddCommGroup L] {R' : Type*} [Ring R'] [Module R' L] (σ : R' →+* B) {n : ℕ}
  (eL : L ≃+ ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ))
  (heL : ∀ (r : R') (l : L), eL (r • l) = σ r • eL l)

/-- The filtration transported along `eL`. -/
def comapStep (k : ℕ) : Submodule R' L where
  carrier := {l | eL l ∈ step gR φ ψ h k n}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, map_add] at hx hy ⊢
    exact add_mem hx hy
  zero_mem' := by simp
  smul_mem' r l hl := by
    simp only [Set.mem_ofPred_eq] at hl ⊢
    rw [heL]
    exact Submodule.smul_mem _ _ hl

/-- An element `l` lies in the transported filtration step if and only if `eL l` lies in the
corresponding step of the filtration. -/
theorem mem_comapStep {k : ℕ} {l : L} :
    l ∈ comapStep gR φ ψ h σ eL heL k ↔ eL l ∈ step gR φ ψ h k n :=
  Iff.rfl

/-- The steps of the transported filtration are identified with those of the filtration. -/
def comapStepEquiv (k : ℕ) : comapStep gR φ ψ h σ eL heL k ≃+ step gR φ ψ h k n where
  toFun x := ⟨eL (x : L), x.2⟩
  invFun y := ⟨eL.symm y, by
    rw [mem_comapStep, AddEquiv.apply_symm_apply]
    exact y.2⟩
  left_inv x := Subtype.ext (eL.symm_apply_apply (x : L))
  right_inv y := Subtype.ext (eL.apply_symm_apply (y : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ)))
  map_add' x y := Subtype.ext (map_add eL (x : L) (y : L))

/-- `comapStepEquiv` identifies the step `k + 1` of the transported filtration with the step
`k + 1` of the filtration, as subgroups of the respective steps `k`. -/
theorem comapStepEquiv_map (k : ℕ) :
    ((Submodule.comap (comapStep gR φ ψ h σ eL heL k).subtype
        (comapStep gR φ ψ h σ eL heL (k + 1))).toAddSubgroup).map
        (comapStepEquiv gR φ ψ h σ eL heL k).toAddMonoidHom =
      (Submodule.comap (step gR φ ψ h k n).subtype (step gR φ ψ h (k + 1) n)).toAddSubgroup := by
  ext y
  refine ⟨fun ⟨x, hx, hxy⟩ ↦ hxy ▸ hx, fun hy ↦ ?_⟩
  refine ⟨(comapStepEquiv gR φ ψ h σ eL heL k).symm y, ?_,
    (comapStepEquiv gR φ ψ h σ eL heL k).apply_symm_apply y⟩
  change eL (eL.symm (y : ⋀[B]^n ↑(CommRingCat.KaehlerDifferential ψ))) ∈ step gR φ ψ h (k + 1) n
  rwa [AddEquiv.apply_symm_apply]

/-- **The graded pieces of the transported filtration are those of the filtration.** -/
def comapGradedEquiv (k : ℕ) :
    (comapStep gR φ ψ h σ eL heL k ⧸ (comapStep gR φ ψ h σ eL heL (k + 1)).comap
      (comapStep gR φ ψ h σ eL heL k).subtype) ≃+ gradedQuot gR φ ψ h k n :=
  QuotientAddGroup.congr _ _ (comapStepEquiv gR φ ψ h σ eL heL k)
    (comapStepEquiv_map gR φ ψ h σ eL heL k)

/-- `comapGradedEquiv` sends the class of `x` to the class of `eL x`. -/
theorem comapGradedEquiv_mk (k : ℕ) (x : comapStep gR φ ψ h σ eL heL k) :
    comapGradedEquiv gR φ ψ h σ eL heL k (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk ⟨eL (x : L), x.2⟩ :=
  rfl

/-- The inverse of `comapGradedEquiv` sends the class of `y` to the class of its preimage under
`comapStepEquiv`. -/
theorem comapGradedEquiv_symm_mk (k : ℕ) (y : step gR φ ψ h k n) :
    (comapGradedEquiv gR φ ψ h σ eL heL k).symm (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk ((comapStepEquiv gR φ ψ h σ eL heL k).symm y) :=
  rfl

end Comap

end Stacks.KatzOda

end
