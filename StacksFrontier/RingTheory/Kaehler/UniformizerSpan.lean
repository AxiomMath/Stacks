module

public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.Unramified.Basic

/-!
# The differential of a uniformizer spans the Kähler differentials

Let `R` be a local `k`-algebra whose maximal ideal is generated by a single element `s` and whose
residue field is formally unramified over `k`. If `Ω[R⁄k]` is a finite `R`-module, then it is
spanned by `d s`. The proof is Nakayama's lemma applied to the conormal sequence
`𝔪/𝔪² → κ ⊗ Ω[R⁄k] → Ω[κ⁄k] = 0`, whose first map sends the class of `s`, which generates
`𝔪/𝔪²`, to `1 ⊗ d s`.

The span statement is then pushed along a ring map `f : R → K` compatible with the `k`-algebra
structures, which is how it is used for the local rings of a curve inside its function field, and
a fraction-field criterion records when a submodule of `Ω[K⁄k]` is everything.

## Main results

* `KaehlerDifferential.span_D_eq_top_of_maximalIdeal_eq_span`: `d s` spans `Ω[R⁄k]`.
* `KaehlerDifferential.exists_D_eq_smul_D_of_maximalIdeal_eq_span`: the image of `d u` in
  `Ω[K⁄k]` is an `R`-multiple of the image of `d s`.
* `KaehlerDifferential.eq_top_of_forall_D_mem`: a `K`-submodule of `Ω[K⁄k]` containing the
  differentials of the image of `R` is everything, when `K` is a field of fractions of the image.

## References

* [Stacks Project, Tag 0C1E](https://stacks.math.columbia.edu/tag/0C1E)
-/

@[expose] public section

open IsLocalRing

open scoped TensorProduct

namespace KaehlerDifferential

/-- Let `R` be a local `k`-algebra whose residue field is formally unramified over `k` and whose
module of differentials is finite. If `s` generates the maximal ideal, then `d s` spans
`Ω[R⁄k]`. -/
theorem span_D_eq_top_of_maximalIdeal_eq_span
    (k R : Type*) [CommRing k] [CommRing R] [IsLocalRing R] [Algebra k R]
    [Algebra k (ResidueField R)] [IsScalarTower k R (ResidueField R)]
    [Algebra.FormallyUnramified k (ResidueField R)] [Module.Finite R Ω[R⁄k]]
    (s : R) (hs : maximalIdeal R = Ideal.span {s}) :
    Submodule.span R {D k R s} = ⊤ := by
  let κ := ResidueField R
  have hker : RingHom.ker (algebraMap R κ) = maximalIdeal R := Ideal.mk_ker
  have hsI : s ∈ RingHom.ker (algebraMap R κ) := hker ▸ hs ▸ Ideal.mem_span_singleton_self s
  let t := kerCotangentToTensor k R κ
  have htc : t (Ideal.toCotangent _ ⟨s, hsI⟩) = (1 : κ) ⊗ₜ[R] D k R s := rfl
  have hsurj : Function.Surjective t := fun z =>
    (exact_kerCotangentToTensor_mapBaseChange k R κ Ideal.Quotient.mk_surjective z).mp
      (Subsingleton.elim _ _)
  apply IsLocalRing.map_tensorProduct_mk_eq_top.mp
  apply top_unique
  intro z _
  obtain ⟨w, rfl⟩ := hsurj z
  obtain ⟨w, rfl⟩ := Ideal.toCotangent_surjective _ w
  have hwmem : w.val ∈ Ideal.span {s} := by
    rw [← hs, ← hker]
    exact w.property
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hwmem
  have hw : w = r • (⟨s, hsI⟩ : RingHom.ker (algebraMap R κ)) := by
    apply Subtype.ext
    simpa [smul_eq_mul, mul_comm] using hr
  rw [hw, map_smul, map_smul, htc]
  exact Submodule.smul_mem _ r (Submodule.mem_map_of_mem (Submodule.subset_span (by simp)))

/-- Let `R` be a local `k`-algebra whose residue field is formally unramified over `k` and whose
module of differentials is finite, let `s` generate the maximal ideal, and let `f : R → K` be a
ring map into a `k`-algebra compatible with the two `k`-algebra structures. Then for every
`u ∈ R` the differential of `f u` in `Ω[K⁄k]` is `f h` times the differential of `f s`, for some
`h ∈ R`. -/
theorem exists_D_eq_smul_D_of_maximalIdeal_eq_span
    (k R K : Type*) [CommRing k] [CommRing R] [IsLocalRing R] [Algebra k R] [CommRing K]
    [Algebra k K] [Algebra k (ResidueField R)] [IsScalarTower k R (ResidueField R)]
    [Algebra.FormallyUnramified k (ResidueField R)] [Module.Finite R Ω[R⁄k]]
    (f : R →+* K) (hf : ∀ a : k, f (algebraMap k R a) = algebraMap k K a)
    (s : R) (hs : maximalIdeal R = Ideal.span {s}) (u : R) :
    ∃ h : R, D k K (f u) = f h • D k K (f s) := by
  let := f.toAlgebra
  have : IsScalarTower k R K := IsScalarTower.of_algebraMap_eq fun a => (hf a).symm
  have hu : D k R u ∈ Submodule.span R {D k R s} := by
    rw [span_D_eq_top_of_maximalIdeal_eq_span k R s hs]
    trivial
  obtain ⟨h, hh⟩ := Submodule.mem_span_singleton.mp hu
  refine ⟨h, ?_⟩
  have := congrArg (map k k R K) hh
  rw [LinearMap.map_smul, map_D, map_D] at this
  calc D k K (f u) = D k K (algebraMap R K u) := rfl
    _ = h • D k K (algebraMap R K s) := this.symm
    _ = f h • D k K (f s) := (algebraMap_smul K h _).symm

/-- Let `f : R → K` be a ring map into a field such that every element of `K` is a quotient of
elements of the image of `f`. A `K`-submodule of `Ω[K⁄k]` containing the differential of every
element of the image of `f` is all of `Ω[K⁄k]`. -/
theorem eq_top_of_forall_D_mem {k R K : Type*} [CommRing k] [CommRing R] [Field K] [Algebra k K]
    (f : R →+* K) (hfrac : ∀ y : K, ∃ a b : R, f b ≠ 0 ∧ y * f b = f a)
    (W : Submodule K Ω[K⁄k]) (hW : ∀ b : R, D k K (f b) ∈ W) : W = ⊤ := by
  rw [eq_top_iff, ← span_range_derivation, Submodule.span_le]
  rintro _ ⟨y, rfl⟩
  obtain ⟨a, b, hb, hy⟩ := hfrac y
  have h1 : D k K (f a) = y • D k K (f b) + f b • D k K y := by
    rw [← hy, Derivation.leibniz]
  have h2 : D k K y = (f b)⁻¹ • (D k K (f a) - y • D k K (f b)) := by
    rw [h1, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hb, one_smul]
  rw [h2]
  exact W.smul_mem _ (W.sub_mem (hW a) (W.smul_mem _ (hW b)))

end KaehlerDifferential

end
