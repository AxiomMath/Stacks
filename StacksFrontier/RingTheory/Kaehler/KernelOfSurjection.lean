module

public import Mathlib.RingTheory.Kaehler.Basic
import StacksCore.Tactic.StacksAttribute

/-!
# The kernel of `Ω[S⁄R] → Ω[S'⁄R']` along a surjection

Consider a commutative square of rings
```
S --φ--> S'
↑        ↑
α        β
|        |
R --ψ--> R'
```
encoded by the algebra structures `R → S`, `R' → S'`, `S → S'`, `R → R'`, `R → S'` and the scalar
tower conditions `IsScalarTower R S S'` and `IsScalarTower R R' S'`. If `φ : S → S'` is surjective,
the functoriality map `KaehlerDifferential.map R R' S S' : Ω[S⁄R] → Ω[S'⁄R']` is surjective, and
its kernel is the `S`-submodule generated by the `da` with `a ∈ S` such that `φ(a) ∈ β(R')`. This
includes in particular the `di` with `i` in the kernel of `φ`.

## Main results

* `KaehlerDifferential.map_surjective_and_ker_eq_span_of_surjective`: if `φ : S → S'` is
  surjective, then `Ω[S⁄R] → Ω[S'⁄R']` is surjective with kernel generated by the `da` with
  `φ(a) ∈ β(R')`.

## References

* [Stacks Project, Tag 00RR](https://stacks.math.columbia.edu/tag/00RR)
-/

@[expose] public section

open Finsupp

namespace KaehlerDifferential

variable (R R' S S' : Type*) [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
variable [Algebra R S] [Algebra R' S'] [Algebra S S']

/-- The `S`-submodule of `Ω[S⁄R]` generated by the `da` with `a ∈ S` such that the image of `a`
in `S'` comes from `R'`. -/
private noncomputable abbrev kerSpan : Submodule S Ω[S⁄R] :=
  Submodule.span S (⇑(D R S) '' {a | algebraMap S S' a ∈ Set.range (algebraMap R' S')})

/-- If `s` is killed by `S → S'`, then `s • da` lies in `kerSpan` for every `a`. -/
private lemma smul_D_mem_kerSpan {s : S} (hs : algebraMap S S' s = 0) (a : S) :
    s • D R S a ∈ kerSpan R R' S S' := by
  have h₁ : D R S (s * a) ∈ kerSpan R R' S S' :=
    Submodule.subset_span ⟨s * a, ⟨0, by simp [hs]⟩, rfl⟩
  have h₂ : D R S s ∈ kerSpan R R' S S' :=
    Submodule.subset_span ⟨s, ⟨0, by simp [hs]⟩, rfl⟩
  have : s • D R S a = D R S (s * a) - a • D R S s := by
    rw [Derivation.leibniz]; abel
  rw [this]
  exact sub_mem h₁ (Submodule.smul_mem _ _ h₂)

variable [Algebra R R'] [Algebra R S'] [IsScalarTower R S S'] [IsScalarTower R R' S']
  [SMulCommClass R' S S']

/-- In a commutative square of rings
```
S --φ--> S'
↑        ↑
|        |
R -----> R'
```
with `φ : S → S'` surjective, the map `Ω[S⁄R] → Ω[S'⁄R']` is surjective and its kernel is the
`S`-submodule generated by the `da` with `a ∈ S` such that `φ(a)` lies in the image of `R'`
(among them the `di` with `i ∈ ker φ`). -/
@[stacks 00RR]
theorem map_surjective_and_ker_eq_span_of_surjective
    (h : Function.Surjective (algebraMap S S')) :
    Function.Surjective (map R R' S S') ∧
      LinearMap.ker (map R R' S S') =
        Submodule.span S (⇑(D R S) '' {a | algebraMap S S' a ∈ Set.range (algebraMap R' S')}) := by
  refine ⟨map_surjective_of_surjective R R' S S' h, le_antisymm ?_ ?_⟩
  · let f : (S →₀ S) →ₗ[S] (S' →₀ S') :=
      (Finsupp.mapRange.linearMap (Algebra.linearMap S S')).comp
        (Finsupp.lmapDomain S S (algebraMap S S'))
    let L : Submodule S (S →₀ S) :=
      (kerSpan R R' S S').comap (Finsupp.linearCombination S (D R S))
    obtain ⟨σ, hσ⟩ := h.hasRightInverse
    have hmove (x : S →₀ S) : Finsupp.linearCombination S (D R S) x -
        Finsupp.linearCombination S (D R S) (x.mapDomain (σ ∘ algebraMap S S')) ∈
          kerSpan R R' S S' := by
      induction x using Finsupp.induction_linear with
      | zero => simp
      | add x y hx hy =>
        rw [Finsupp.mapDomain_add, map_add, map_add, add_sub_add_comm]
        exact add_mem hx hy
      | single a s =>
        rw [Finsupp.mapDomain_single, Finsupp.linearCombination_single,
          Finsupp.linearCombination_single, ← smul_sub, ← map_sub]
        refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, ⟨0, ?_⟩, rfl⟩)
        simp [hσ (algebraMap S S' a)]
    have hL : LinearMap.ker f ≤ L := by
      intro x hx
      have hy : (x.mapDomain (algebraMap S S')).mapRange (algebraMap S S') (map_zero _) = 0 :=
        hx
      have hcoef (b : S') : algebraMap S S' (x.mapDomain (algebraMap S S') b) = 0 := by
        simpa using congrArg (· b) hy
      change Finsupp.linearCombination S (D R S) x ∈ kerSpan R R' S S'
      rw [← sub_add_cancel (Finsupp.linearCombination S (D R S) x)
        (Finsupp.linearCombination S (D R S) (x.mapDomain (σ ∘ algebraMap S S')))]
      refine add_mem (hmove x) ?_
      rw [Finsupp.mapDomain_comp, Finsupp.linearCombination_mapDomain,
        Finsupp.linearCombination_apply]
      exact Submodule.sum_mem _ fun b _ => smul_D_mem_kerSpan R R' S S' (hcoef b) _
    have hmap : (kerTotal R' S').restrictScalars S ≤ L.map f := by
      rw [← kerTotal_map R R' S S' h, sup_le_iff]
      refine ⟨Submodule.map_mono ?_, ?_⟩
      · intro x hx
        rw [← kerTotal_eq] at hx
        simp [L, LinearMap.mem_ker.mp hx]
      · rw [Submodule.span_le]
        rintro _ ⟨r, rfl⟩
        obtain ⟨a, ha⟩ := h (algebraMap R' S' r)
        refine ⟨Finsupp.single a 1, ?_, ?_⟩
        · change Finsupp.linearCombination S (D R S) (Finsupp.single a 1) ∈ kerSpan R R' S S'
          rw [Finsupp.linearCombination_single, one_smul]
          exact Submodule.subset_span ⟨a, ⟨r, ha.symm⟩, rfl⟩
        · simp [f, ha]
    rw [ker_map]
    refine Submodule.map_le_iff_le_comap.mpr ?_
    calc ((kerTotal R' S').restrictScalars S).comap f ≤ (L.map f).comap f :=
          Submodule.comap_mono hmap
      _ = L := by rw [Submodule.comap_map_eq, sup_eq_left.mpr hL]
  · rw [Submodule.span_le]
    rintro _ ⟨a, ⟨r, hr⟩, rfl⟩
    simp [← hr]

end KaehlerDifferential
