/-! ## The conormal sequence of a surjection -/

namespace ConormalSeq

/-- The `B`-module structure on `I.Cotangent`, for `I = RingHom.ker (algebraMap A B)` and `A → B`
surjective, obtained by transporting the `A ⧸ I`-module structure along `A ⧸ I ≃ B`. -/
@[reducible,
  ega "0 18.3.8" "special case",
  ega "0 18.5.4" "partial",
  ega "0 20.5.12",
  ega "0 20.6.26",
  sga "3 III 4.5.0" "special case",
  sga "3 VIIA 5.5.3",
  sga "3 VIIA 7.4",
  sga "3 VIIB 2.1" "special case",
  sga "3 VIIB 2.6" "partial",
  sga "5 III 6.8",
  sga "6 0 2.1" "special case",
  sga "6 VII 1.6",
  sga "7 VI 4.7" "special case",
  sga "7 XVII 3.1" "partial"]
def cotangentModule {A : Type*} [CommRing A] {B : Type*} [CommRing B] [Algebra A B]
    (hsurj : Function.Surjective (algebraMap A B)) :
    Module B ((RingHom.ker (algebraMap A B)).Cotangent) :=
  Module.compHom _ (RingHom.quotientKerEquivOfSurjective hsurj).symm.toRingHom

/-- The conormal map `I/I² →ₗ[B] B ⊗[A] Ω[A⁄R]`, for `I = RingHom.ker (algebraMap A B)` and
`A → B` surjective: `KaehlerDifferential.kerCotangentToTensor` read `B`-linearly. -/
@[ega "0 20.5.11",
  ega "0 20.5.12",
  ega "0 20.6.26" "more general",
  ega "0 20.7.20" "special case",
  ega "0 22.2.9",
  ega "0 22.6.1" "special case",
  ega "0 22.6.4" "partial",
  ega "IV 16.4.21",
  sga "3 III 4.8" "(iii), special case",
  sga "5 III 6.8" "partial",
  sga "6 0 4.3" "special case",
  sga "6 VIII 2.1" "partial"]
def conormalMap (R : Type*) [CommRing R] {A : Type*} [CommRing A] [Algebra R A]
    {B : Type*} [CommRing B] [Algebra A B] (hsurj : Function.Surjective (algebraMap A B)) :
    letI := cotangentModule hsurj
    (RingHom.ker (algebraMap A B)).Cotangent →ₗ[B] B ⊗[A] Ω[A⁄R] :=
  letI := cotangentModule hsurj
  { toFun := KaehlerDifferential.kerCotangentToTensor R A B
    map_add' := map_add _
    map_smul' := fun b x ↦ by
      obtain ⟨a, ha⟩ := hsurj b
      have hb : (RingHom.quotientKerEquivOfSurjective hsurj).symm b = Ideal.Quotient.mk _ a :=
        (RingEquiv.symm_apply_eq _).2 (by simp [← ha])
      rw [show b • x = (a : A) • x from congrArg (· • x) hb, ← ha, RingHom.id_apply,
        algebraMap_smul, map_smul] }

/-- The conormal map sends the class of `a ∈ I` to `1 ⊗ d a`. -/
theorem conormalMap_toCotangent (R : Type*) [CommRing R] {A : Type*} [CommRing A] [Algebra R A]
    {B : Type*} [CommRing B] [Algebra A B] (hsurj : Function.Surjective (algebraMap A B))
    (a : RingHom.ker (algebraMap A B)) :
    letI := cotangentModule hsurj
    conormalMap R hsurj ((RingHom.ker (algebraMap A B)).toCotangent a) =
      (1 : B) ⊗ₜ[A] KaehlerDifferential.D R A (a : A) :=
  KaehlerDifferential.kerCotangentToTensor_toCotangent R A B a

section

variable (R : Type*) [CommRing R] (A : Type*) [CommRing A] [Algebra R A]
  (B : Type*) [CommRing B] [Algebra R B] [Algebra A B] [IsScalarTower R A B]
  (hsurj : Function.Surjective (algebraMap A B))

/-- The image of the conormal map `I/I² → B ⊗[A] Ω[A⁄R]` is the kernel of
`B ⊗[A] Ω[A⁄R] → Ω[B⁄R]`, as `B`-submodules. -/
theorem conormalMap_range_eq_ker_mapBaseChange :
    letI := cotangentModule hsurj
    LinearMap.range (conormalMap R hsurj) =
      (LinearMap.ker (KaehlerDifferential.mapBaseChange R A B)).restrictScalars B := by
  let := cotangentModule hsurj
  ext x
  simpa only [LinearMap.mem_range, Submodule.restrictScalars_mem, LinearMap.mem_ker,
    Set.mem_range, conormalMap, LinearMap.coe_mk, AddHom.coe_mk]
    using (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A B hsurj x).symm

/-- The conormal sequence `I/I² → B ⊗[A] Ω[A⁄R] → Ω[B⁄R] → 0` of a surjection `A → B` with kernel
`I` is exact. -/
theorem conormal_exact_sequence :
    letI := cotangentModule hsurj
    (LinearMap.range (conormalMap R hsurj) =
        (LinearMap.ker (KaehlerDifferential.mapBaseChange R A B)).restrictScalars B) ∧
      Function.Surjective (KaehlerDifferential.mapBaseChange R A B) :=
  ⟨conormalMap_range_eq_ker_mapBaseChange R A B hsurj,
    KaehlerDifferential.mapBaseChange_surjective R A B hsurj⟩

end

end ConormalSeq

/-! ## Split exactness in the presence of a section -/

/-- An `R`-algebra map `f : A →ₐ[R] B` is surjective if and only if its lift
`A ⧸ (ker f)² → B` is. -/
private theorem AlgHom.kerSquareLift_surjective {R A B : Type*} [CommRing R] [CommRing A]
    [CommRing B] [Algebra R A] [Algebra R B] (f : A →ₐ[R] B) :
    Function.Surjective f.kerSquareLift ↔ Function.Surjective f :=
  ⟨fun h ↦ h.comp Ideal.Quotient.mk_surjective, fun h ↦ h.of_comp (g := Ideal.Quotient.mk _)⟩

namespace KaehlerDifferential

/-- Relative differentials compose along a tower `B → C → D` of `R`-algebras: the map induced by
`B → D` is the map induced by `B → C` followed by the map induced by `C → D`. -/
theorem map_comp_map (R B C E : Type*) [CommRing R] [CommRing B] [CommRing C] [CommRing E]
    [Algebra R B] [Algebra R C] [Algebra R E] [Algebra B C] [Algebra B E] [Algebra C E]
    [IsScalarTower R B C] [IsScalarTower R B E] [IsScalarTower B C E] [IsScalarTower R C E] :
    (map R R C E).restrictScalars B ∘ₗ map R R B C = map R R B E := by
  refine LinearMap.ext_on_range (span_range_derivation R B) fun x => ?_
  show map R R C E (map R R B C (D R B x)) = _
  rw [map_D R R B C, map_D R R C E, ← IsScalarTower.algebraMap_apply B C E x, map_D R R B E]

/-- **The base of a map of relative differentials can be enlarged after the fact.**  For a tower
`R → S → T` of bases and a map `B → C` of algebras, the map `Ω[B⁄R] → Ω[C⁄S]` induced by the
square `R → S`, `B → C`, followed by the enlargement `Ω[C⁄S] → Ω[C⁄T]` of the base, is the map
`Ω[B⁄R] → Ω[C⁄T]` induced by the square `R → T`, `B → C`.

This is `KaehlerDifferential.map_comp_map` with the base moving rather than the algebra: both
sides send `d b` to the `T`-differential of the image of `b`.  It is what identifies the two
readings of the base of `Ω_{Y/S}` at a point — the stalk of `S` below the point of `Y` and the
stalk below its image in `X` — once the comparison between them has been interposed. -/
@[ega "0 20.5.3" "more general"]
theorem map_base_comp_map (R S T B C : Type*) [CommRing R] [CommRing S] [CommRing T]
    [CommRing B] [CommRing C] [Algebra R S] [Algebra S T] [Algebra R T] [Algebra R B]
    [Algebra S C] [Algebra T C] [Algebra R C] [Algebra B C] [IsScalarTower R S T]
    [IsScalarTower S T C] [IsScalarTower R S C] [IsScalarTower R T C] [IsScalarTower R B C]
    [SMulCommClass S B C] [SMulCommClass T B C] :
    (map S T C C).restrictScalars B ∘ₗ map R S B C = map R T B C := by
  refine LinearMap.ext_on_range (span_range_derivation R B) fun x => ?_
  show map S T C C (map R S B C (D R B x)) = _
  rw [map_D R S B C, map_D S T C C, Algebra.algebraMap_self_apply, map_D R T B C]

/-- **Generators of a module of differentials survive an enlargement of the base.** If the
differentials `d v x` of a family `v` of elements of `B` generate `Ω[B⁄R]`, they generate
`Ω[B⁄R']` for any base `R'` interposed between `R` and `B`: the comparison map
`Ω[B⁄R] → Ω[B⁄R']` is surjective and carries `d b` to `d b`. -/
theorem span_range_D_of_base (R R' B : Type*) [CommRing R] [CommRing R'] [CommRing B]
    [Algebra R R'] [Algebra R B] [Algebra R' B] [IsScalarTower R R' B] {ι : Type*} (v : ι → B)
    (hv : Submodule.span B (Set.range fun x => D R B (v x)) = ⊤) :
    Submodule.span B (Set.range fun x => D R' B (v x)) = ⊤ := by
  have himg : map R R' B B '' (Set.range fun x => D R B (v x)) =
      Set.range fun x => D R' B (v x) := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun x => by
      rw [Function.comp_apply, map_D R R' B B, Algebra.algebraMap_self_apply])
  rw [← himg, ← Submodule.map_span, hv, Submodule.map_top, LinearMap.range_eq_top]
  exact map_surjective R R' B

/-- **`Ω[B⁄Λ]` is generated over `B` by the differentials pulled back from `A` together with
`d x`, whenever `B` is generated as an `A`-algebra by the single element `x`.**

The hypothesis is `Algebra.adjoin A {x} = ⊤` alone: no presentation of `B` as an adjoin-root
algebra is needed, and in particular the generating family is not asked to be a basis.  Every
element of `B` is `Polynomial.aeval x P` for some `P : A[X]`, and the Leibniz rule expands
`d (algebraMap A B c * xⁿ)` into `algebraMap A B c • d (xⁿ) + xⁿ • d (algebraMap A B c)`, whose
first summand is a multiple of `d x` and whose second is the image of `d c`. -/
theorem span_union_range_map_D_of_adjoin_singleton_eq_top (Λ A B : Type*) [CommRing Λ]
    [CommRing A] [CommRing B] [Algebra Λ A] [Algebra Λ B] [Algebra A B] [IsScalarTower Λ A B]
    {x : B} (hgen : Algebra.adjoin A ({x} : Set B) = ⊤) :
    Submodule.span B (Set.range (map Λ Λ A B) ∪ {D Λ B x}) = ⊤ := by
  set M := Submodule.span B (Set.range (map Λ Λ A B) ∪ {D Λ B x})
  have hxM : D Λ B x ∈ M := Submodule.subset_span (Or.inr rfl)
  have hbaseM (c : A) : D Λ B (algebraMap A B c) ∈ M := by
    rw [← map_D Λ Λ A B c]
    exact Submodule.subset_span (Or.inl ⟨D Λ A c, rfl⟩)
  have hpowM (n : ℕ) : D Λ B (x ^ n) ∈ M := by
    rw [Derivation.leibniz_pow]
    exact nsmul_mem (M.smul_mem _ hxM) n
  have hpolyM (P : Polynomial A) : D Λ B (Polynomial.aeval x P) ∈ M := by
    induction P using Polynomial.induction_on' with
    | add P Q hP hQ => simpa using M.add_mem hP hQ
    | monomial n c =>
      rw [Polynomial.aeval_monomial, Derivation.leibniz]
      exact M.add_mem (M.smul_mem _ (hpowM n)) (M.smul_mem _ (hbaseM c))
  refine top_unique ?_
  rw [← span_range_derivation Λ B, Submodule.span_le]
  rintro - ⟨b, rfl⟩
  obtain ⟨P, rfl⟩ : b ∈ (Polynomial.aeval (R := A) x).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval A x, hgen]
    exact Algebra.mem_top
  exact hpolyM P

/-- Let `R → P → S` be commutative rings, let `I = ker(P → S)`, and suppose there is an
`R`-algebra map `g : S → P ⧸ I²` that is a right inverse to `P ⧸ I² → S`. Then the exact sequence
`0 → I/I² → S ⊗[P] Ω[P⁄R] → Ω[S⁄R] → 0` is split short exact: it is isomorphic to the trivial
sequence, by an isomorphism `S ⊗[P] Ω[P⁄R] ≃ I/I² × Ω[S⁄R]` carrying
`KaehlerDifferential.kerCotangentToTensor R P S` to `LinearMap.inl` and
`KaehlerDifferential.mapBaseChange R P S` to `LinearMap.snd`. Nothing is required of `P`. -/
@[stacks 02HP "Recorded in full, as the decomposition of the middle term of the sequence of 00RU
carrying its two maps to `LinearMap.inl` and `LinearMap.snd`. The hypothesis is a section of
`P ⧸ I² → S` rather than of `P → S`, and surjectivity of `P → S` is derived from it rather than
assumed.", ega "0 20.6.22" "Case Λ = A"]
theorem split_exact_kerCotangentToTensor_mapBaseChange_of_section {R P S : Type*}
    [CommRing R] [CommRing P] [CommRing S] [Algebra R P] [Algebra P S] [Algebra R S]
    [IsScalarTower R P S] (g : S →ₐ[R] P ⧸ RingHom.ker (algebraMap P S) ^ 2)
    (hg : (IsScalarTower.toAlgHom R P S).kerSquareLift.comp g = AlgHom.id R S) :
    ∃ e : S ⊗[P] Ω[P⁄R] ≃ₗ[P] (RingHom.ker (algebraMap P S)).Cotangent × Ω[S⁄R],
      kerCotangentToTensor R P S =
          e.symm ∘ₗ LinearMap.inl P (RingHom.ker (algebraMap P S)).Cotangent Ω[S⁄R] ∧
        (mapBaseChange R P S).restrictScalars P =
          LinearMap.snd P (RingHom.ker (algebraMap P S)).Cotangent Ω[S⁄R] ∘ₗ e.toLinearMap :=
  have hf : Function.Surjective (algebraMap P S) :=
    (IsScalarTower.toAlgHom R P S).kerSquareLift_surjective.mp
      (Function.HasRightInverse.surjective ⟨g, AlgHom.congr_fun hg⟩)
  ⟨_, (Function.Exact.splitInjectiveEquiv (exact_kerCotangentToTensor_mapBaseChange R P S hf)
    (mapBaseChange_surjective R P S hf)
    ((retractionKerCotangentToTensorEquivSection hf).symm ⟨g, hg⟩)).2⟩

end KaehlerDifferential

