module

public import Mathlib.RingTheory.DedekindDomain.Basic
public import Mathlib.RingTheory.DedekindDomain.Ideal.Basic
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.RingTheory.LocalProperties.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Nakayama
public import StacksFrontier.RingTheory.Fitting.Annihilator

/-!
# The Kähler different of a Dedekind domain is the annihilator of the differentials

Let `A` be a Dedekind domain which is an algebra over a ring `R`, and suppose the residue field
of `A` at every maximal ideal is formally unramified over `R`. Then `Ω[A⁄R]` is cyclic at every
maximal ideal of `A`, hence its zeroth Fitting ideal — the Kähler different — coincides with its
annihilator.

## Main results

* `IsDedekindDomain.exists_mem_le_span_singleton_sup_sq`: a prime of a Dedekind domain is
  generated by one element modulo its square.
* `annihilator_eq_fittingIdeal_zero_kaehlerDifferential`: for a Dedekind domain with formally
  unramified residue fields the annihilator of `Ω[A⁄R]` equals its zeroth Fitting ideal.

## Implementation notes

The local cyclicity is proved globally first: the conormal sequence of `A → A ⧸ P` identifies
`Ω[A⁄R] ⧸ P • Ω[A⁄R]` with a quotient of `P ⧸ P²` as soon as `Ω[(A ⧸ P)⁄R]` vanishes, so
`Ω[A⁄R] = A · dπ + P · Ω[A⁄R]` for any `π` generating `P` modulo `P²`. Tensoring with the
localization at `P` and applying Nakayama makes the localized module cyclic, and for a cyclic
module the zeroth Fitting ideal is the annihilator. Only the inclusion of the annihilator in the
Fitting ideal needs this; the reverse inclusion holds for every finite module.

## References

* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA)
-/

universe u

@[expose] public section

open scoped TensorProduct

/-- **A prime of a Dedekind domain is principal modulo its square.** There is an element `π` of
`P` with `P ≤ (π) + P²`; for a nonzero prime the ideals between `P²` and `P` are only `P` and
`P²`, so any `π ∈ P \ P²` works. -/
theorem IsDedekindDomain.exists_mem_le_span_singleton_sup_sq {A : Type u} [CommRing A]
    [IsDedekindDomain A] (P : Ideal A) [hP : P.IsPrime] :
    ∃ π ∈ P, P ≤ Ideal.span {π} ⊔ P ^ 2 := by
  rcases eq_or_ne P ⊥ with rfl | hPbot
  · exact ⟨0, Submodule.zero_mem _, bot_le⟩
  have hPprime : Prime P := Ideal.prime_of_isPrime hPbot hP
  have hsq : P ^ 2 ≠ P := by
    intro h
    have hmul : P * P = P * 1 := by rw [← sq, h, mul_one]
    exact hPprime.not_isUnit ((mul_left_cancel₀ hPbot hmul) ▸ isUnit_one)
  obtain ⟨π, hπP, hπ2⟩ : ∃ π ∈ P, π ∉ P ^ 2 := by
    by_contra hcon
    push Not at hcon
    exact hsq (le_antisymm (Ideal.pow_le_self two_ne_zero) hcon)
  refine ⟨π, hπP, ?_⟩
  have hJP : Ideal.span {π} ⊔ P ^ 2 ≤ P :=
    sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπP))
      (Ideal.pow_le_self two_ne_zero)
  obtain ⟨i, hi, hassoc⟩ :=
    (dvd_prime_pow hPprime 2).mp (Ideal.dvd_iff_le.mpr (le_sup_right (a := Ideal.span {π})))
  rw [associated_iff_eq] at hassoc
  interval_cases i
  · rw [pow_zero, Ideal.one_eq_top] at hassoc
    exact absurd (top_le_iff.mp (hassoc ▸ hJP)) hP.ne_top
  · rw [pow_one] at hassoc
    exact hassoc.ge
  · exact absurd (hassoc ▸ Ideal.mem_sup_left (Ideal.mem_span_singleton_self π)) hπ2

section Kaehler

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A]

/-- If the residue ring at `P` has no differentials over `R`, then `Ω[A⁄R]` is generated modulo
`P` by the differentials of the elements of `P`: this is the conormal exact sequence of
`A → A ⧸ P`. -/
theorem top_le_span_image_D_sup_smul (P : Ideal A) [Subsingleton Ω[(A ⧸ P)⁄R]] :
    (⊤ : Submodule A Ω[A⁄R]) ≤
      Submodule.span A (KaehlerDifferential.D R A '' (P : Set A)) ⊔
        P • (⊤ : Submodule A Ω[A⁄R]) := by
  intro m _
  have hsurj : Function.Surjective (KaehlerDifferential.kerCotangentToTensor R A (A ⧸ P)) :=
    fun z ↦ (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A (A ⧸ P)
      Ideal.Quotient.mk_surjective z).mp (Subsingleton.elim _ _)
  obtain ⟨c, hc⟩ := hsurj ((1 : A ⧸ P) ⊗ₜ[A] m)
  obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective _ c
  rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hc
  rw [Ideal.Quotient.algebraMap_eq, Ideal.mk_ker] at hx
  have hquot := congrArg (TensorProduct.quotTensorEquivQuotSMul Ω[A⁄R] P) hc
  rw [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul,
    TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul] at hquot
  have hmem : KaehlerDifferential.D R A x - m ∈ P • (⊤ : Submodule A Ω[A⁄R]) :=
    (Submodule.Quotient.eq _).mp hquot
  rw [← sub_sub_cancel (KaehlerDifferential.D R A x) m]
  exact Submodule.sub_mem _ (Submodule.mem_sup_left (Submodule.subset_span ⟨x, hx, rfl⟩))
    (Submodule.mem_sup_right hmem)

/-- The differentials of the elements of `P` are generated modulo `P · Ω[A⁄R]` by the
differential of any element generating `P` modulo `P²`. -/
theorem span_image_D_le_span_singleton_sup_smul (P : Ideal A) (π : A) (hπ : π ∈ P)
    (hP : P ≤ Ideal.span {π} ⊔ P ^ 2) :
    Submodule.span A (KaehlerDifferential.D R A '' (P : Set A)) ≤
      Submodule.span A {KaehlerDifferential.D R A π} ⊔ P • (⊤ : Submodule A Ω[A⁄R]) := by
  rw [Submodule.span_le]
  rintro _ ⟨x, hx, rfl⟩
  obtain ⟨u, hu, y, hy, rfl⟩ := Submodule.mem_sup.mp (hP hx)
  rw [map_add]
  refine Submodule.add_mem _ ?_ ?_
  · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hu
    rw [(KaehlerDifferential.D R A).leibniz]
    exact Submodule.add_mem _
      (Submodule.mem_sup_left (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)))
      (Submodule.mem_sup_right (Submodule.smul_mem_smul hπ Submodule.mem_top))
  · refine Submodule.mem_sup_right ?_
    rw [sq] at hy
    refine Submodule.mul_induction_on hy (fun p hp q hq ↦ ?_) (fun a b ha hb ↦ ?_)
    · rw [(KaehlerDifferential.D R A).leibniz]
      exact Submodule.add_mem _ (Submodule.smul_mem_smul hp Submodule.mem_top)
        (Submodule.smul_mem_smul hq Submodule.mem_top)
    · rw [map_add]
      exact Submodule.add_mem _ ha hb

/-- If `Ω[A⁄R]` is generated by one element modulo `P`, its localization at `P` is cyclic: this
is Nakayama's lemma over the local ring `A_P`. -/
theorem span_singleton_one_tmul_eq_top (P : Ideal A) [P.IsPrime] [Module.Finite A Ω[A⁄R]]
    (ω : Ω[A⁄R])
    (h : (⊤ : Submodule A Ω[A⁄R]) ≤
      Submodule.span A {ω} ⊔ P • (⊤ : Submodule A Ω[A⁄R])) :
    Submodule.span (Localization.AtPrime P)
        {(1 : Localization.AtPrime P) ⊗ₜ[A] ω} = ⊤ := by
  set S := Localization.AtPrime P with hS
  have hloc : IsLocalRing S := IsLocalization.AtPrime.isLocalRing S P
  rw [eq_top_iff]
  refine Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
    (IsLocalRing.maximalIdeal_le_jacobson _) ?_
  rintro z -
  induction z using TensorProduct.induction_on with
  | zero => exact Submodule.zero_mem _
  | add a b ha hb => exact Submodule.add_mem _ ha hb
  | tmul s m =>
    have hsm : (s ⊗ₜ[A] m : S ⊗[A] Ω[A⁄R]) = s • (1 ⊗ₜ[A] m) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [hsm]
    refine Submodule.smul_mem _ _ ?_
    obtain ⟨u, hu, y, hy, rfl⟩ := Submodule.mem_sup.mp (h (Submodule.mem_top (x := m)))
    rw [TensorProduct.tmul_add]
    refine Submodule.add_mem _ ?_ ?_
    · obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hu
      refine Submodule.mem_sup_left (Submodule.mem_span_singleton.mpr ⟨algebraMap A S a, ?_⟩)
      rw [algebraMap_smul, ← TensorProduct.tmul_smul]
    · refine Submodule.mem_sup_right ?_
      refine Submodule.smul_induction_on hy (fun p hp n _ ↦ ?_) (fun a b ha hb ↦ ?_)
      · rw [TensorProduct.tmul_smul, ← algebraMap_smul S p]
        exact Submodule.smul_mem_smul
          ((IsLocalization.AtPrime.to_map_mem_maximal_iff S P p).mpr hp) Submodule.mem_top
      · rw [TensorProduct.tmul_add]
        exact Submodule.add_mem _ ha hb

/-- **The Kähler different of a Dedekind domain is the annihilator of its differentials.** If
the residue ring of `A` at every maximal ideal has no differentials over `R`, the annihilator of
`Ω[A⁄R]` is its zeroth Fitting ideal. -/
theorem annihilator_eq_fittingIdeal_zero_kaehlerDifferential [IsDedekindDomain A]
    [Module.Finite A Ω[A⁄R]]
    (hres : ∀ P : Ideal A, P.IsMaximal → Subsingleton Ω[(A ⧸ P)⁄R]) :
    Module.annihilator A Ω[A⁄R] = fittingIdeal (R := A) (M := Ω[A⁄R]) 0 := by
  refine le_antisymm ?_
    (fittingIdeal_basic_properties.{u, u, u, u} (R := A) (M := Ω[A⁄R])).2.2.2.2.2.1
  refine Ideal.le_of_localization_maximal fun P hP ↦ ?_
  have : P.IsPrime := hP.isPrime
  have : Subsingleton Ω[(A ⧸ P)⁄R] := hres P hP
  have hbc := (fittingIdeal_basic_properties.{u, u, u, u} (R := A) (M := Ω[A⁄R])).2.2.1
    (Localization.AtPrime P) 0
  rw [Nat.cast_zero] at hbc
  rw [← hbc]
  obtain ⟨π, hπ, hPπ⟩ := IsDedekindDomain.exists_mem_le_span_singleton_sup_sq P
  have htop : (⊤ : Submodule A Ω[A⁄R]) ≤
      Submodule.span A {KaehlerDifferential.D R A π} ⊔ P • (⊤ : Submodule A Ω[A⁄R]) :=
    (top_le_span_image_D_sup_smul P).trans
      (sup_le (span_image_D_le_span_singleton_sup_smul P π hπ hPπ) le_sup_right)
  rw [fittingIdeal_zero_eq_annihilator_of_span_singleton_eq_top
    (span_singleton_one_tmul_eq_top P (KaehlerDifferential.D R A π) htop),
    Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, Module.mem_annihilator]
  intro z
  induction z using TensorProduct.induction_on with
  | zero => rw [smul_zero]
  | add x y hx hy => rw [smul_add, hx, hy, add_zero]
  | tmul s m =>
    rw [algebraMap_smul, ← TensorProduct.tmul_smul, Module.mem_annihilator.mp ha m,
      TensorProduct.tmul_zero]

end Kaehler

end
