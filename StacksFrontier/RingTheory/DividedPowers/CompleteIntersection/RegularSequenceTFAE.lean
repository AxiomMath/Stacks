/-- A local homomorphism of local rings induces a local homomorphism between quotients by proper
ideals that correspond under it. -/
private theorem isLocalHom_quotientMap {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] (f : A →+* B) [IsLocalHom f]
    {I : Ideal A} (J : Ideal B) (hI : I ≠ ⊤) (hJ : J ≠ ⊤)
    (h : I ≤ J.comap f) : IsLocalHom (Ideal.quotientMap J f h) := by
  have : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  have : Nontrivial (B ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  have hB : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  refine ⟨fun a ha => ?_⟩
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
  have h1 : IsUnit ((Ideal.Quotient.mk J) (f x)) := ha
  exact IsUnit.map (Ideal.Quotient.mk I)
    (IsLocalHom.map_nonunit (f := f) x
      (IsLocalHom.map_nonunit (f := Ideal.Quotient.mk J) (f x) h1))

/-- A ring isomorphism carries a regular sequence to a regular sequence. -/
private theorem isRegular_map_ringEquiv {A B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B)
    (rs : List A) (hr : IsRegular A rs) : IsRegular B (rs.map e) :=
  (e.toAddEquiv.isRegular_congr (List.forall₂_map_right_iff.mpr
    (List.forall₂_same.mpr fun r _ x => by simp))).mp hr

/-- An ideal spanned by a regular sequence is Koszul-regular: the localization away from `1` is
the ring itself, and a regular sequence is Koszul-regular by [Stacks, Tag 062F]. -/
private theorem isKoszulRegular_of_regularSequence {R : Type*} [CommRing R]
    (I : Ideal R) (rs : List R) (hr : IsRegular R rs)
    (hI : Ideal.ofList rs = I) : Ideal.IsKoszulRegular I := by
  intro p hp
  let e : R ≃ₐ[R] Localization.Away (1 : R) :=
    IsLocalization.atOne R (Localization.Away (1 : R))
  have hreg : IsRegular (Localization.Away (1 : R))
      (rs.map (algebraMap R (Localization.Away (1 : R)))) := by
    have he : ⇑e.toRingEquiv = algebraMap R (Localization.Away (1 : R)) := by
      ext x
      simpa using e.commutes x
    simpa [he] using isRegular_map_ringEquiv e.toRingEquiv rs hr
  refine ⟨1, ?_, rs.length,
    (fun i => algebraMap R (Localization.Away (1 : R)) (rs.get i)), ?_, ?_⟩
  · exact fun h => p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h isUnit_one)
  · have heq : List.ofFn (fun i : Fin rs.length =>
        algebraMap R (Localization.Away (1 : R)) (rs.get i)) =
        rs.map (algebraMap R (Localization.Away (1 : R))) := by
      simp
    exact (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular
      (M := Localization.Away (1 : R)) (f := fun i =>
        algebraMap R (Localization.Away (1 : R)) (rs.get i))).2.2 (heq ▸ hreg)
  · rw [← hI, Ideal.map_ofList]
    unfold Ideal.ofList
    apply congrArg Ideal.span
    ext x
    simp only [Set.mem_ofPred_eq, List.mem_iff_get, Set.mem_range]
    constructor <;> rintro ⟨w, rfl⟩ <;> exact ⟨Fin.cast (by simp) w, by simp⟩

/-- Conversely, a proper Koszul-regular ideal of a Noetherian local ring is spanned by a regular
sequence: its local generators at the closed point live over a localization away from a unit, which
is the ring itself, and a Koszul-regular sequence of elements of the maximal ideal is regular by
[Stacks, Tag 061L]. -/
private theorem exists_regularSequence_of_isKoszulRegular
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (I : Ideal R) (hI : I ≠ ⊤) (hK : Ideal.IsKoszulRegular I) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = I := by
  have hIm : I ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal hI
  obtain ⟨g, hg, n, f, hf, hspan⟩ := hK (IsLocalRing.closedPoint R) hIm
  have hgu : IsUnit g := IsLocalRing.notMem_maximalIdeal.mp hg
  let e : R ≃ₐ[R] Localization.Away g :=
    IsLocalization.atUnit R (Localization.Away g) g hgu
  have : Nontrivial (Localization.Away g) := e.symm.toEquiv.nontrivial
  have : IsLocalRing (Localization.Away g) :=
    IsLocalRing.of_surjective' e.toRingHom e.surjective
  have : IsNoetherianRing (Localization.Away g) :=
    isNoetherianRing_of_ringEquiv R e.toRingEquiv
  have he : e.toRingHom = algebraMap R (Localization.Away g) := by
    ext x
    simpa using e.commutes x
  have : IsLocalHom (algebraMap R (Localization.Away g)) := by
    rw [← he]
    exact IsLocalHom.of_surjective _ e.surjective
  have hmapI : I.map (algebraMap R (Localization.Away g)) ≤
      IsLocalRing.maximalIdeal (Localization.Away g) :=
    (Ideal.map_mono hIm).trans
      (IsLocalRing.map_maximalIdeal_le (algebraMap R (Localization.Away g)))
  have hmem : ∀ i, f i ∈ IsLocalRing.maximalIdeal (Localization.Away g) := fun i =>
    hmapI (hspan ▸ Ideal.subset_span ⟨i, rfl⟩)
  have hreg : IsRegular (Localization.Away g) (List.ofFn f) :=
    ((Koszul.regular_koszulRegular_h1Regular_quasiRegular_tfae
      (M := Localization.Away g) f hmem).2.out 2 1).mp hf
  let rs : List R := (List.ofFn f).map e.symm
  have hregR : IsRegular R rs := by
    exact isRegular_map_ringEquiv e.symm.toRingEquiv _ hreg
  refine ⟨rs, hregR, ?_⟩
  have hspan' : I.map e.toRingHom = Ideal.ofList (List.ofFn f) := by
    rw [he]
    convert hspan using 1
    unfold Ideal.ofList
    congr 1
    ext x
    simp
  have hback := congrArg (Ideal.map e.symm.toRingHom) hspan'
  have hcomp : Ideal.map e.symm.toRingHom (Ideal.map e.toRingHom I) = I :=
    Ideal.map_of_equiv e.toRingEquiv
  rw [hcomp, Ideal.map_ofList] at hback
  simpa [rs] using hback.symm

/-- If `I S` is generated by a regular sequence of `S` for a flat local homomorphism `R → S` of
local rings with `R` Noetherian, then `I` is generated by a regular sequence of `R`: a flat local
homomorphism is faithfully flat, and Koszul-regular ideals descend along a faithfully flat map by
[Stacks, Tag 068N]. -/
public theorem exists_regularSequence_of_map_of_flat_local
    {R S : Type*} [CommRing R] [CommRing S]
    [IsNoetherianRing R] [IsLocalRing R] [IsLocalRing S]
    [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (I : Ideal R) (hI : I ≠ ⊤)
    (hreg : ∃ rs : List S, IsRegular S rs ∧
      Ideal.ofList rs = I.map (algebraMap R S)) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = I := by
  have : Module.FaithfullyFlat R S := Module.FaithfullyFlat.of_flat_of_isLocalHom
  obtain ⟨rs, hrs, hspan⟩ := hreg
  exact exists_regularSequence_of_isKoszulRegular I hI
    ((Koszul.regular_ideals_of_faithfullyFlat (algebraMap R S)
      (RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance) I).1
      (isKoszulRegular_of_regularSequence _ rs hrs hspan))

/-- A finite module over a Noetherian ring, placed in degree `0`, is pseudo-coherent. -/
private theorem isPseudoCoherent_singleFunctor_of_finite {B : Type u} [CommRing B]
    [IsNoetherianRing B] (M : Type u) [AddCommGroup M] [Module B M] [Module.Finite B M] :
    StacksDraft.PseudoCoherence.IsPseudoCoherent
      ((DerivedCategory.singleFunctor (ModuleCat.{u} B) 0).obj (ModuleCat.of B M)) := by
  refine (StacksDraft.PseudoCoherence.pseudoCoherent_iff_boundedAbove_finite_homology
    _ 0 M).2.1.mpr ⟨⟨0, fun i hi => DerivedCategory.isZero_of_isLE _ 0 i hi⟩, fun i => ?_⟩
  by_cases hi : i = 0
  · subst i
    exact (Module.Finite.equiv_iff ((DerivedCategory.singleFunctorCompHomologyFunctorIso
      (ModuleCat.{u} B) 0).app (ModuleCat.of B M)).toLinearEquiv).mpr ‹Module.Finite B M›
  · have hz : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} B) i).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} B) 0).obj (ModuleCat.of B M))) := by
      rcases lt_or_gt_of_ne hi with hi' | hi'
      · exact DerivedCategory.isZero_of_isGE _ 0 i hi'
      · exact DerivedCategory.isZero_of_isLE _ 0 i hi'
    have := ModuleCat.isZero_iff_subsingleton.mp hz
    exact Module.Finite.of_finite

/-- A finite perfect module over a Noetherian ring has finite projective dimension. -/
private theorem exists_hasProjectiveDimensionLE_of_isPerfectModule {B : Type u} [CommRing B]
    [IsNoetherianRing B] (M : Type u) [AddCommGroup M] [Module B M] [Module.Finite B M]
    (hM : StacksDraft.Perfect.IsPerfectModule (R := B) M) :
    ∃ e : ℕ, HasProjectiveDimensionLE (ModuleCat.of B M) e := by
  obtain ⟨e, F, hFP, hzero⟩ :=
    (StacksDraft.Perfect.isPerfectModule_iff_exists_finite_projective_resolution M).mp hM
  let Fleft : ObjectProperty.LeftResolution
      (fun X : ModuleCat.{u} B => Projective X ∧ Module.Finite B X) (ModuleCat.of B M) :=
    let : QuasiIso F.π := F.quasiIso
    { complex := F.complex
      property := fun i => by
        have : Module.Projective B (↑(F.complex.X i)) := (hFP i).2
        exact ⟨ModuleCat.projective_of_categoryTheory_projective (F.complex.X i), (hFP i).1⟩
      hasHomology := F.hasHomology
      π := F.π }
  exact ⟨e, (ModuleCat.hasProjectiveDimensionLE_iff_exists_leftResolution_projective_finite
    _ e).2 ⟨Fleft, hzero⟩⟩

/-- If the closed fibre of `R → S` is a regular local ring, so is the closed fibre of
`R ⧸ I → S ⧸ I S` for every ideal `I ⊆ 𝔪_R`. -/
private theorem isRegularLocalRing_closedFibre_quotient {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [Algebra R S] (I : Ideal R) (hI : I ≤ IsLocalRing.maximalIdeal R)
    [IsLocalRing (R ⧸ I)]
    (hfiber : IsRegularLocalRing (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S))) :
    IsRegularLocalRing ((S ⧸ I.map (algebraMap R S)) ⧸ (IsLocalRing.maximalIdeal (R ⧸ I)).map
      (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S)))) := by
  have hmaxA : (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal (R ⧸ I) :=
    IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
  have hfiberIdeal : (IsLocalRing.maximalIdeal (R ⧸ I)).map
      (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S))) =
        ((IsLocalRing.maximalIdeal R).map (algebraMap R S)).map
          (Ideal.Quotient.mk (I.map (algebraMap R S))) := by
    rw [← hmaxA, Ideal.map_map, Ideal.map_map]
    congr 1
  let eFiber : ((S ⧸ I.map (algebraMap R S)) ⧸ (IsLocalRing.maximalIdeal (R ⧸ I)).map
      (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S)))) ≃+*
        (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S)) :=
    (Ideal.quotEquivOfEq hfiberIdeal).trans
      (DoubleQuot.quotQuotEquivQuotOfLE (Ideal.map_mono hI))
  exact IsRegularLocalRing.of_ringEquiv eFiber.symm

/-- For an ideal `I ⊆ 𝔪_R` of a local ring, the residue field `R ⧸ 𝔪_R`, as an `R ⧸ I`-module,
is the residue field of `R ⧸ I`. -/
private noncomputable def quotientModuleResidueFieldIso {R : Type u} [CommRing R] [IsLocalRing R]
    (I : Ideal R) (hI : I ≤ IsLocalRing.maximalIdeal R) [IsLocalRing (R ⧸ I)] :
    quotientModule (Ideal.quotientMap (IsLocalRing.maximalIdeal R) (RingHom.id R)
      (by simpa using hI) : R ⧸ I →+* R ⧸ IsLocalRing.maximalIdeal R) ≅
      ModuleCat.of (R ⧸ I) (IsLocalRing.maximalIdeal (R ⧸ I)).ResidueField := by
  have hmaxA : (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal (R ⧸ I) :=
    IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective
  let fResidue : R ⧸ I →+* (R ⧸ IsLocalRing.maximalIdeal R) :=
    Ideal.quotientMap (IsLocalRing.maximalIdeal R) (RingHom.id R) (by simpa using hI)
  let _ : Algebra (R ⧸ I) (R ⧸ IsLocalRing.maximalIdeal R) := fResidue.toAlgebra
  let eQuot : ((R ⧸ I) ⧸ IsLocalRing.maximalIdeal (R ⧸ I)) ≃+*
      (R ⧸ IsLocalRing.maximalIdeal R) :=
    (Ideal.quotEquivOfEq hmaxA.symm).trans (DoubleQuot.quotQuotEquivQuotOfLE hI)
  let _ : Algebra (R ⧸ I) ((R ⧸ I) ⧸ IsLocalRing.maximalIdeal (R ⧸ I)) :=
    (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (R ⧸ I))).toAlgebra
  let eRes : ((R ⧸ I) ⧸ IsLocalRing.maximalIdeal (R ⧸ I)) ≃+*
      (IsLocalRing.maximalIdeal (R ⧸ I)).ResidueField :=
    RingEquiv.ofBijective _
      (IsLocalRing.maximalIdeal (R ⧸ I)).bijective_algebraMap_quotient_residueField
  have heQuotComm : ∀ a : R ⧸ I,
      eQuot (algebraMap (R ⧸ I) ((R ⧸ I) ⧸ IsLocalRing.maximalIdeal (R ⧸ I)) a) =
        fResidue a := by
    intro a
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
    change (DoubleQuot.quotQuotEquivQuotOfLE hI)
        (Ideal.quotEquivOfEq hmaxA.symm
          (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (R ⧸ I))
            (Ideal.Quotient.mk I x))) = _
    rw [Ideal.quotEquivOfEq_mk]
    change (DoubleQuot.quotQuotEquivQuotOfLE hI)
        (DoubleQuot.quotQuotMk I (IsLocalRing.maximalIdeal R) x) = _
    rw [DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk]
    rfl
  let eResAlg : ((R ⧸ I) ⧸ IsLocalRing.maximalIdeal (R ⧸ I)) ≃ₐ[R ⧸ I]
      (IsLocalRing.maximalIdeal (R ⧸ I)).ResidueField :=
    AlgEquiv.ofRingEquiv (f := eRes) fun a =>
      Ideal.algebraMap_quotient_residueField_mk (I := IsLocalRing.maximalIdeal (R ⧸ I)) a
  exact LinearEquiv.toModuleIso
    ((AlgEquiv.ofRingEquiv (f := eQuot) heQuotComm).symm.trans eResAlg).toLinearEquiv

/-- Let `A → B` be a flat local homomorphism of local rings with `B` Noetherian and regular closed
fibre. A finite `B`-module whose `Tor` against the residue field of `A` vanishes in all large
degrees has finite projective dimension over `B`. -/
private theorem exists_hasProjectiveDimensionLE_of_eventualTor {A B : Type u} [CommRing A]
    [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] [Module.Flat A B]
    [IsRegularLocalRing (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B))]
    (M : Type u) [AddCommGroup M] [Module B M] [Module.Finite B M] (n : ℕ)
    (hTor : ∀ p : ℕ, n < p → IsZero (((Tor (ModuleCat.{u} A) p).obj
      ((ModuleCat.restrictScalars (algebraMap A B)).obj (ModuleCat.of B M))).obj
        (ModuleCat.of A (IsLocalRing.maximalIdeal A).ResidueField))) :
    ∃ e : ℕ, HasProjectiveDimensionLE (ModuleCat.of B M) e := by
  obtain ⟨d, hdim⟩ :=
    Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim
      (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B))
  let Ffun := ModuleCat.restrictScalars (algebraMap A B)
  let P := (CochainComplex.singleFunctor (ModuleCat.{u} B) 0).obj (ModuleCat.of B M)
  have hK : StacksDraft.PseudoCoherence.IsPseudoCoherent (DerivedCategory.Q.obj P) :=
    isPseudoCoherent_singleFunctor_of_finite M
  refine exists_hasProjectiveDimensionLE_of_isPerfectModule M
    (StacksDraft.Perfect.isPerfect_and_torAmplitude_of_flat_local_of_regular_closedFibre
      (A := A) (B := B) (-(n : ℤ)) 0 d hdim _ hK fun F hFbd hFflat ⟨e⟩ i hi => ?_).1
  have eF : DerivedCategory.Q.obj F ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj (Ffun.obj (ModuleCat.of B M)) :=
    e.symm ≪≫ Ffun.mapDerivedCategoryFactors.app P ≪≫ DerivedCategory.Q.mapIso
      ((HomologicalComplex.singleMapHomologicalComplex Ffun (ComplexShape.up ℤ) 0).app
        (ModuleCat.of B M))
  exact isZero_tensorComplex_of_eventualTor _ _ n hTor F hFbd hFflat eF i (by simpa using hi)

/-- The descent step of [Stacks, Tag 09PX]: for a flat local homomorphism `R → S` with `S`
Noetherian and regular closed fibre, `I ⊆ 𝔪_R` and `I S ⊆ J`, eventual vanishing of `Tor` of
`S / J` against the residue field of `R` over `R / I` forces `S / J` to have finite projective
dimension over `S / I S`. -/
private theorem exists_hasProjectiveDimensionLE_quotient_of_eventualTor
    {R S : Type u} [CommRing R] [CommRing S] [IsNoetherianRing S] [IsLocalRing R]
    [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (I : Ideal R) (J : Ideal S) (hI : I ≤ IsLocalRing.maximalIdeal R)
    (hIJ : I.map (algebraMap R S) ≤ J)
    (hfiber : IsRegularLocalRing (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S)))
    (n : ℕ) (hTor : ∀ p : ℕ, n < p → IsZero
      (((Tor (ModuleCat.{u} (R ⧸ I)) p).obj (quotientModule
        (Ideal.quotientMap J (algebraMap R S) ((Ideal.map_le_iff_le_comap).mp hIJ)))).obj
        (quotientModule (Ideal.quotientMap (IsLocalRing.maximalIdeal R) (RingHom.id R)
          (by simpa using hI))))) :
    ∃ e : ℕ, letI : Algebra (S ⧸ I.map (algebraMap R S)) (S ⧸ J) :=
      (Ideal.Quotient.factor hIJ).toAlgebra
      HasProjectiveDimensionLE (ModuleCat.of (S ⧸ I.map (algebraMap R S)) (S ⧸ J)) e := by
  have hIne : I ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top hI
  have hqIne : I.map (algebraMap R S) ≠ ⊤ :=
    ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal S).ne_top
      ((Ideal.map_mono hI).trans (IsLocalRing.map_maximalIdeal_le (algebraMap R S)))
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hIne
  have : IsLocalRing (R ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have : Nontrivial (S ⧸ I.map (algebraMap R S)) := Ideal.Quotient.nontrivial_iff.mpr hqIne
  have : IsLocalRing (S ⧸ I.map (algebraMap R S)) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have : IsLocalHom (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S))) :=
    isLocalHom_quotientMap (algebraMap R S) _ hIne hqIne Ideal.le_comap_map
  have : Module.Flat (R ⧸ I) (S ⧸ I.map (algebraMap R S)) := flat_quotient_map_of_flat I
  have := isRegularLocalRing_closedFibre_quotient I hI hfiber
  let : Algebra (S ⧸ I.map (algebraMap R S)) (S ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
  have : Module.Finite (S ⧸ I.map (algebraMap R S)) (S ⧸ J) :=
    Module.Finite.of_surjective (Algebra.linearMap _ _) fun x => by
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact ⟨Ideal.Quotient.mk _ s, rfl⟩
  let fAC : R ⧸ I →+* S ⧸ J :=
    Ideal.quotientMap J (algebraMap R S) ((Ideal.map_le_iff_le_comap).mp hIJ)
  have hcomp : (Ideal.Quotient.factor hIJ).comp
      (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S))) = fAC := by
    ext
    rfl
  let M0 : ModuleCat.{u} (R ⧸ I) := quotientModule fAC
  let M_A : ModuleCat.{u} (R ⧸ I) :=
    (ModuleCat.restrictScalars (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S)))).obj
      (ModuleCat.of _ (S ⧸ J))
  let eMlin : (↑M_A) ≃ₗ[R ⧸ I] (↑M0) :=
    { toFun := id
      invFun := id
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := fun a x => by
        change (Ideal.Quotient.factor hIJ)
            (algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S)) a) * (show S ⧸ J from x) =
          fAC a * (show S ⧸ J from x)
        exact congrArg (fun y : S ⧸ J => y * (show S ⧸ J from x))
          (DFunLike.congr_fun hcomp a) }
  exact exists_hasProjectiveDimensionLE_of_eventualTor (S ⧸ J) n fun p hp =>
    ((hTor p hp).of_iso (((Tor (ModuleCat.{u} (R ⧸ I)) p).obj M0).mapIso
      (quotientModuleResidueFieldIso I hI)).symm).of_iso
        (((Tor (ModuleCat.{u} (R ⧸ I)) p).mapIso (LinearEquiv.toModuleIso eMlin)).app _)

/-- **Stacks 09PX.** Let `R → S` be a flat local homomorphism of Noetherian local rings whose
closed fibre is a regular local ring, let `I ⊆ 𝔪_R` and let `J` be an ideal of `S` containing
`I S`. The following are equivalent:

1. `J` is generated by a regular sequence and `S / J` has finite Tor dimension over `R / I`;
2. `J` is generated by a regular sequence and the `Tor` groups of `S / J` against the residue
   field of `R` vanish in all large degrees;
3. `I` is generated by a regular sequence of `R` and `J / IS` is generated by a regular sequence
   of `S / IS`.

The quotient ideal `J / IS` is represented by the image of `J` under `S → S / IS`, and the residue
field of `R` is represented as the `R / I`-module `R / 𝔪_R`. -/
@[stacks 09PX]
public theorem regularSequence_quotient_tfae_of_flat
    {R S : Type u} [CommRing R] [CommRing S]
    [IsNoetherianRing R] [IsNoetherianRing S] [IsLocalRing R] [IsLocalRing S]
    [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (I : Ideal R) (J : Ideal S) (hI : I ≤ IsLocalRing.maximalIdeal R)
    (hIJ : I.map (algebraMap R S) ≤ J)
    (hfiber : IsRegularLocalRing
      (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S))) :
    List.TFAE [
      (Ideal.IsGeneratedByRegularSequence J ∧
        FiniteTorDimension (quotientModule
          (Ideal.quotientMap J (algebraMap R S) ((Ideal.map_le_iff_le_comap).mp hIJ)))),
      (Ideal.IsGeneratedByRegularSequence J ∧
        ∃ n : ℕ, ∀ p : ℕ, n < p → IsZero
          (((Tor (ModuleCat.{u} (R ⧸ I)) p).obj
            (quotientModule
              (Ideal.quotientMap J (algebraMap R S) ((Ideal.map_le_iff_le_comap).mp hIJ)))).obj
            (quotientModule
              (Ideal.quotientMap (IsLocalRing.maximalIdeal R) (RingHom.id R)
                (by simpa using hI))))),
      (Ideal.IsGeneratedByRegularSequence I ∧
        Ideal.IsGeneratedByRegularSequence
          (J.map (Ideal.Quotient.mk (I.map (algebraMap R S)))))] := by
  tfae_have 1 → 2 := fun ⟨hJ, n, hn⟩ => ⟨hJ, n, fun p hp => hn _ p hp⟩
  tfae_have 2 → 3 := by
    rintro ⟨⟨rsJ, hrsJ, hspanJ⟩, n, hTor⟩
    have hJne : J ≠ ⊤ := fun htop =>
      ((RingTheory.Sequence.isRegular_iff S rsJ).mp hrsJ).2 (by rw [hspanJ, htop]; simp)
    obtain ⟨hthird, hthird'⟩ := exists_isRegular_of_finite_projectiveDimension _ J
      (ne_top_of_le_ne_top hJne hIJ) hJne hIJ
      (exists_hasProjectiveDimensionLE_quotient_of_eventualTor I J hI hIJ hfiber n hTor)
      ⟨rsJ, hrsJ, hspanJ⟩
    exact ⟨exists_regularSequence_of_map_of_flat_local I
      (ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top hI) hthird,
      by simpa [Ideal.IsGeneratedByRegularSequence] using hthird'⟩
  tfae_have 3 → 1 := fun ⟨hregI, hregQ⟩ =>
    isGeneratedByRegularSequence_and_finiteTorDimension I J hI hIJ hregI hregQ
  tfae_finish

end Stacks.CompleteIntersection

end
