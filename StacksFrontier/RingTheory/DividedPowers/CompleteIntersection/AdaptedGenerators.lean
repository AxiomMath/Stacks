module

public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.RingTheory.LocalRing.Module
public import Mathlib.RingTheory.LocalRing.Quotient
public import Mathlib.RingTheory.Regular.RegularSequence
public import StacksFrontier.RingTheory.DividedPowers.CompleteIntersection.MinimalGenerators
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Regular sequences in nested ideals, modulo the injectivity of [Stacks, Tag 09PV]

Let `A` be a Noetherian local ring and `I ⊆ J` ideals with `J` proper and generated by a regular
sequence. [Stacks, Tag 09PW] asserts that if `A/J` has finite Tor dimension over `A/I`, then `I`
is generated by a regular sequence and so is the image of `J` in `A ⧸ I`.

The Tor hypothesis enters the source argument only through [Stacks, Tag 09PV], which says the
canonical map `I/𝔪I → J/𝔪J` is injective. This file proves the rest of Tag 09PW: everything that
follows from that injectivity. Tag 09PV itself is not proved here. So
`exists_regularSequence_of_injective_resid` takes the injectivity as a hypothesis, and carries no
Stacks attribute: a statement with an extra hypothesis is weaker than the source, so tagging it
would overstate what is proved.

The argument is the source's: injectivity lets one pick a basis of `J/𝔪J` whose first vectors
come from `I/𝔪I`; lifting it and applying Nakayama gives a generating system of `J` whose initial
segment generates `I`, and whose length is the minimal one. Being minimal, it is a regular
sequence, by `isRegular_of_ofList_eq_of_length_le`; its initial segment is then a regular
sequence generating `I`, and the rest reduces to a regular sequence of `A ⧸ I` generating the
image of `J`.

## Main definitions

None.

## Main results

* `Stacks.CompleteIntersection.exists_regularSequence_of_injective_resid`: the two conclusions of
  [Stacks, Tag 09PW], from the injectivity statement of [Stacks, Tag 09PV].

## Implementation notes

`I/𝔪I` and `J/𝔪J` carry both an `A`-module and a residue-field structure. The reduction of the
inclusion is introduced twice, as `residMapA` over `A` — the shape in which the hypothesis of
Tag 09PV is stated — and as `residMap` over the residue field, where the complement of its image
is taken. The two are related by `residMap_apply` rather than by definitional unfolding:
`LinearMap.extendScalarsOfSurjective` is reducible, and letting the elaborator see through it
costs more than the default heartbeat budget.

## References

* [Stacks Project, Tag 09PW](https://stacks.math.columbia.edu/tag/09PW)
* [Stacks Project, Tag 09PV](https://stacks.math.columbia.edu/tag/09PV)
-/

namespace Stacks.CompleteIntersection

open Module RingTheory.Sequence Submodule Pointwise

attribute [local instance] Ideal.Quotient.field

universe u

variable {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

/-- `P ⧸ 𝔪 P`, a vector space over the residue field. -/
private abbrev Resid (P : Ideal A) : Type u :=
  P ⧸ (IsLocalRing.maximalIdeal A • ⊤ : Submodule A P)

omit [IsNoetherianRing A] in
private lemma algebraMap_residue_surjective :
    Function.Surjective (algebraMap A (A ⧸ IsLocalRing.maximalIdeal A)) := by
  rw [Ideal.Quotient.algebraMap_eq]
  exact Ideal.Quotient.mk_surjective

omit [IsNoetherianRing A] [IsLocalRing A] in
private lemma ofList_ofFn {n : ℕ} (f : Fin n → A) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) :=
  congrArg Ideal.span (Set.ext fun x => by simp [List.mem_ofFn, eq_comm])

omit [IsNoetherianRing A] [IsLocalRing A] in
private lemma ofList_append (l₁ l₂ : List A) :
    Ideal.ofList (l₁ ++ l₂) = Ideal.ofList l₁ ⊔ Ideal.ofList l₂ := by
  rw [← Ideal.span_union]
  exact congrArg Ideal.span (Set.ext fun x => by simp)

omit [IsNoetherianRing A] in
/-- Over the residue field a set spans iff it spans over `A`. -/
private lemma residue_span_eq_top_iff {M : Type u} [AddCommGroup M] [Module A M]
    (X : Set (M ⧸ (IsLocalRing.maximalIdeal A • ⊤ : Submodule A M))) :
    Submodule.span (A ⧸ IsLocalRing.maximalIdeal A) X = ⊤ ↔ Submodule.span A X = ⊤ := by
  rw [← Submodule.restrictScalars_eq_top_iff A (A ⧸ IsLocalRing.maximalIdeal A),
    Submodule.restrictScalars_span A _ algebraMap_residue_surjective]

omit [IsNoetherianRing A] in
/-- Nakayama: a family spans a finite module iff its reduction spans over the residue field. -/
@[ega "0 1.7.5" "Nakayama step"]
private lemma span_eq_top_iff_residue {M : Type u} [AddCommGroup M] [Module A M]
    [Module.Finite A M] {ι : Type*} (v : ι → M) :
    Submodule.span (A ⧸ IsLocalRing.maximalIdeal A)
        (Set.range fun i => (IsLocalRing.maximalIdeal A • (⊤ : Submodule A M)).mkQ (v i)) = ⊤ ↔
      Submodule.span A (Set.range v) = ⊤ := by
  rw [residue_span_eq_top_iff, Set.range_comp', ← Submodule.map_span,
    IsLocalRing.map_mkQ_eq_top]

omit [IsNoetherianRing A] [IsLocalRing A] in
private lemma span_top_iff_ideal_span {P : Ideal A} {ι : Type*} (v : ι → P) :
    Submodule.span A (Set.range v) = ⊤ ↔ Ideal.span (Set.range fun i => (v i : A)) = P := by
  constructor
  · intro h
    have h2 := congrArg (Submodule.map P.subtype) h
    rwa [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp'] at h2
  · intro h
    refine Submodule.map_injective_of_injective (Submodule.injective_subtype P) ?_
    rwa [Submodule.map_span, Submodule.map_subtype_top, ← Set.range_comp']

omit [IsLocalRing A] in
private lemma finite_of_ideal (P : Ideal A) : Module.Finite A P :=
  ⟨(Submodule.fg_top P).2 (IsNoetherian.noetherian P)⟩

private lemma finite_resid (P : Ideal A) :
    Module.Finite (A ⧸ IsLocalRing.maximalIdeal A) (Resid P) :=
  have := finite_of_ideal P
  Module.Finite.of_restrictScalars_finite A _ _

/-- A family of an ideal spans its residue space iff its elements generate the ideal. -/
private lemma span_resid_eq_top_iff {P : Ideal A} {ι : Type*} (v : ι → P) :
    Submodule.span (A ⧸ IsLocalRing.maximalIdeal A)
        (Set.range fun i => (IsLocalRing.maximalIdeal A • (⊤ : Submodule A P)).mkQ (v i)) = ⊤ ↔
      Ideal.span (Set.range fun i => (v i : A)) = P :=
  have := finite_of_ideal P
  (span_eq_top_iff_residue v).trans (span_top_iff_ideal_span v)

/-- The residue dimension of an ideal is at most the length of any generating list. -/
private lemma finrank_resid_le {P : Ideal A} {l : List A} (hl : Ideal.ofList l = P) :
    finrank (A ⧸ IsLocalRing.maximalIdeal A) (Resid P) ≤ l.length := by
  have := finite_resid P
  have hmem : ∀ i : Fin l.length, l[i] ∈ P := by
    intro i
    rw [← hl]
    exact Ideal.subset_span (List.getElem_mem i.isLt)
  have hspan : Submodule.span (A ⧸ IsLocalRing.maximalIdeal A) (Set.range fun i : Fin l.length =>
      (IsLocalRing.maximalIdeal A • (⊤ : Submodule A P)).mkQ ⟨l[i], hmem i⟩) = ⊤ := by
    rw [span_resid_eq_top_iff]
    have hset : (Set.range fun i : Fin l.length => ((⟨l[i], hmem i⟩ : P) : A)) = {x | x ∈ l} := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        exact List.getElem_mem i.isLt
      · intro hx
        obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
        exact ⟨⟨i, hi⟩, rfl⟩
    rw [hset]
    exact hl
  simpa using finrank_le_of_span_eq_top hspan

/-- The `A`-linear reduction `I/𝔪I → J/𝔪J` of an inclusion of ideals. -/
private noncomputable def residMapA {I J : Ideal A} (hIJ : I ≤ J) : Resid I →ₗ[A] Resid J :=
  (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).mapQ
    (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)) (Submodule.inclusion hIJ)
    (Submodule.smul_top_le_comap_smul_top _ (Submodule.inclusion hIJ))

/-- The same map, read over the residue field. -/
private noncomputable def residMap {I J : Ideal A} (hIJ : I ≤ J) :
    Resid I →ₗ[A ⧸ IsLocalRing.maximalIdeal A] Resid J :=
  LinearMap.extendScalarsOfSurjective algebraMap_residue_surjective (residMapA hIJ)

omit [IsNoetherianRing A] in
private lemma residMap_apply {I J : Ideal A} (hIJ : I ≤ J) (x : Resid I) :
    residMap hIJ x = residMapA hIJ x :=
  LinearMap.extendScalarsOfSurjective_apply _ _ x

omit [IsNoetherianRing A] in
private lemma residMap_mk {I J : Ideal A} (hIJ : I ≤ J) (x : I) :
    residMap hIJ ((IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).mkQ x) =
      (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)).mkQ (Submodule.inclusion hIJ x) := by
  rw [residMap_apply]
  exact Submodule.mapQ_apply _ _ _ x

omit [IsNoetherianRing A] in
private lemma residMap_injective {I J : Ideal A} (hIJ : I ≤ J)
    (h : Function.Injective (residMapA hIJ)) : Function.Injective (residMap hIJ) := by
  intro x y hxy
  refine h ?_
  rwa [← residMap_apply, ← residMap_apply]

/-- The combinatorial heart of [Stacks, Tag 09PW]: injectivity of `I/𝔪I → J/𝔪J` produces a
generating system of `J`, no longer than any regular sequence generating `J`, whose initial
segment generates `I`. -/
private lemma exists_adapted_generators {I J : Ideal A} (_hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hinj : Function.Injective (residMapA hIJ)) {fs : List A} (hfsJ : Ideal.ofList fs = J) :
    ∃ as cs : List A, Ideal.ofList as = I ∧ Ideal.ofList (as ++ cs) = J ∧
      (as ++ cs).length ≤ fs.length := by
  classical
  have hkI := finite_resid I
  have hkJ := finite_resid J
  -- a basis of `J/𝔪J` adapted to the image of `I/𝔪I`
  obtain ⟨Q, hQ⟩ := (LinearMap.range (residMap hIJ)).exists_isCompl
  let bI := Module.finBasis (A ⧸ IsLocalRing.maximalIdeal A) (Resid I)
  let bQ := Module.finBasis (A ⧸ IsLocalRing.maximalIdeal A) Q
  choose a ha using fun i => Submodule.mkQ_surjective
    (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)) (bI i)
  choose c hc using fun j => Submodule.mkQ_surjective
    (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)) ((bQ j : Resid J))
  have hrange : (Set.range fun x =>
        ((Sum.elim (fun i => Submodule.inclusion hIJ (a i)) c x : J) : A))
      = (Set.range fun i => ((a i : A))) ∪ Set.range fun j => ((c j : A)) := by
    rw [show (fun x => ((Sum.elim (fun i => Submodule.inclusion hIJ (a i)) c x : J) : A))
        = Sum.elim (fun i => ((a i : A))) (fun j => ((c j : A))) from
      funext fun x => by cases x <;> rfl]
    exact Set.Sum.elim_range _ _
  have hsplit : (Set.range fun x =>
        (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)).mkQ
          (Sum.elim (fun i => Submodule.inclusion hIJ (a i)) c x))
      = Set.range (fun i => residMap hIJ (bI i)) ∪ Set.range fun j => ((bQ j : Resid J)) := by
    rw [show (fun x => (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)).mkQ
          (Sum.elim (fun i => Submodule.inclusion hIJ (a i)) c x))
        = Sum.elim (fun i => residMap hIJ (bI i)) (fun j => ((bQ j : Resid J))) from
      funext fun x => by
        cases x with
        | inl i =>
            simp only [Sum.elim_inl]
            rw [← ha i]
            exact (residMap_mk hIJ (a i)).symm
        | inr j =>
            simp only [Sum.elim_inr]
            exact hc j]
    exact Set.Sum.elim_range _ _
  have hspanJ : Submodule.span (A ⧸ IsLocalRing.maximalIdeal A)
      (Set.range fun x => (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)).mkQ
        (Sum.elim (fun i => Submodule.inclusion hIJ (a i)) c x)) = ⊤ := by
    rw [hsplit, Submodule.span_union,
      show (Set.range fun i => residMap hIJ (bI i)) = residMap hIJ '' Set.range bI from
        Set.range_comp' (residMap hIJ) bI,
      show (Set.range fun j => ((bQ j : Resid J))) = Q.subtype '' Set.range bQ from
        Set.range_comp' Q.subtype bQ,
      ← Submodule.map_span, ← Submodule.map_span, bI.span_eq, bQ.span_eq,
      ← LinearMap.range_eq_map, Submodule.map_subtype_top]
    exact hQ.codisjoint.eq_top
  have hspanI : Submodule.span (A ⧸ IsLocalRing.maximalIdeal A)
      (Set.range fun i => (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).mkQ (a i)) = ⊤ := by
    simpa only [ha] using bI.span_eq
  refine ⟨List.ofFn fun i => ((a i : A)), List.ofFn fun j => ((c j : A)), ?_, ?_, ?_⟩
  · rw [ofList_ofFn]
    exact (span_resid_eq_top_iff a).1 hspanI
  · rw [ofList_append, ofList_ofFn, ofList_ofFn, ← Ideal.span_union, ← hrange]
    exact (span_resid_eq_top_iff _).1 hspanJ
  · have h1 : finrank (A ⧸ IsLocalRing.maximalIdeal A) (LinearMap.range (residMap hIJ))
        + finrank (A ⧸ IsLocalRing.maximalIdeal A) Q
        = finrank (A ⧸ IsLocalRing.maximalIdeal A) (Resid J) := finrank_add_eq_of_isCompl hQ
    rw [LinearMap.finrank_range_of_inj (residMap_injective hIJ hinj)] at h1
    rw [List.length_append, List.length_ofFn, List.length_ofFn, h1]
    exact finrank_resid_le hfsJ

/-- **Stacks 09PW, given Stacks 09PV.** Let `I ⊆ J` be ideals of a Noetherian local ring with `J`
proper and generated by a regular sequence, and assume the canonical map `I/𝔪I → J/𝔪J` is
injective. Then `I` is generated by a regular sequence of `A`, and the image of `J` in `A ⧸ I` is
generated by a regular sequence of `A ⧸ I`. -/
public theorem exists_regularSequence_of_injective_resid
    (I J : Ideal A) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hinj : Function.Injective
      ((IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).mapQ
        (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)) (Submodule.inclusion hIJ)
        (Submodule.smul_top_le_comap_smul_top _ (Submodule.inclusion hIJ))))
    (hreg : ∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = J) :
    (∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = I) ∧
      ∃ rs : List (A ⧸ I), IsRegular (A ⧸ I) rs ∧
        Ideal.ofList rs = J.map (Ideal.Quotient.mk I) := by
  obtain ⟨fs, hfsreg, hfsJ⟩ := hreg
  obtain ⟨as, cs, hasI, hacJ, hle⟩ := exists_adapted_generators hJ hIJ hinj hfsJ
  have hI : I ≠ ⊤ := ne_top_of_le_ne_top hJ hIJ
  have hIm : I ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal hI
  have hJm : J ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal hJ
  obtain ⟨-, hacreg⟩ := isRegular_of_ofList_eq_of_length_le hfsreg hle (by rw [hacJ, hfsJ])
  obtain ⟨hw1, hw2⟩ := (isWeaklyRegular_append_iff A as cs).1 hacreg.toIsWeaklyRegular
  have hnt : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  have hlq : IsLocalRing (A ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hcsJ : Ideal.ofList cs ⊔ I = J := by
    rwa [sup_comm, ← hasI, ← ofList_append]
  refine ⟨⟨as, (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal
    (fun x hx => hIm (hasI ▸ Ideal.subset_span hx))).2 hw1, hasI⟩, ?_⟩
  have heqsub : Ideal.ofList as • (⊤ : Submodule A A) = (I : Submodule A A) := by
    rw [hasI]
    simp
  have hmapped : IsWeaklyRegular (A ⧸ I) (cs.map (algebraMap A (A ⧸ I))) :=
    (isWeaklyRegular_map_algebraMap_iff (A ⧸ I) (A ⧸ I) cs).2
      (((Submodule.quotEquivOfEq _ _ heqsub).isWeaklyRegular_congr cs).1 hw2)
  refine ⟨cs.map (algebraMap A (A ⧸ I)), ?_, ?_⟩
  · refine (IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal ?_).2 hmapped
    intro r hr
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hr
    rw [← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective, Ideal.Quotient.algebraMap_eq]
    exact Ideal.mem_map_of_mem _
      (hJm (hcsJ ▸ Submodule.mem_sup_left (Ideal.subset_span hx)))
  · rw [Ideal.Quotient.algebraMap_eq, ← Ideal.map_ofList, ← hcsJ, Ideal.map_sup,
      Ideal.map_quotient_self, sup_bot_eq]

end Stacks.CompleteIntersection
