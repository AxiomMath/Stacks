module

public import Mathlib.Algebra.Category.ModuleCat.ProjectiveDimension
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.DividedPowers.Rodicio.GulliksenObstruction
public import StacksFrontier.RingTheory.Koszul.MinimalGenerators

/-!
# Regular sequences in a nested pair of ideals

Let `I ⊆ J` be proper ideals of a Noetherian local ring `A`, let `J` be generated by a regular
sequence and let `A / J` have finite Tor dimension over `A / I`. This file shows that then `I` is
generated by a regular sequence and so is the image of `J` in `A / I`.

The two inputs are already available: Rodicio's theorem makes the map `I / 𝔪I → J / 𝔪J` of
cotangent spaces injective, and injectivity of that map turns a minimal system of generators of
`I` into an initial segment of a minimal system of generators of `J`, which is a regular sequence
because `J` is generated by one.

## Main results

* `Stacks.CompleteIntersection.exists_isRegular_of_finite_torDimension`: both `I` and the image
  of `J` in `A / I` are generated by regular sequences.
* `Stacks.CompleteIntersection.exists_isRegular_of_finite_projectiveDimension`: the same under
  the formally stronger hypothesis of finite projective dimension.

## Implementation notes

Finite Tor dimension of `A / J` over `A / I` is spelled as in Stacks Tag 0652: a degree beyond
which `Tor_i^{A/I}(A / J, N)` vanishes for every `A/I`-module `N`. Finite projective dimension is
expressed as the existence of a natural number bounding it, and the ideal `J / I` is represented
canonically as the image of `J` under `A → A / I`.

## References

* [Stacks Project, Tag 0652](https://stacks.math.columbia.edu/tag/0652)
* [Stacks Project, Tag 09PV](https://stacks.math.columbia.edu/tag/09PV)
* [Stacks Project, Tag 09PW](https://stacks.math.columbia.edu/tag/09PW)
-/

@[expose] public section

namespace Stacks.CompleteIntersection

open CategoryTheory RingTheory.Sequence

universe u

/-- Let `I ⊆ J` be proper ideals of a Noetherian local ring `A`. If `A / J` has finite Tor
dimension over `A / I` and `J` is generated by a regular sequence, then `I` is generated by a
regular sequence and the image of `J` in `A / I` is generated by a regular sequence of `A / I`. -/
@[stacks 09PW, ega "IV 19.1.6" "more general"]
theorem exists_isRegular_of_finite_torDimension
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hI : I ≠ ⊤) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hTor : ∃ b : ℕ,
      letI : Algebra (A ⧸ I) (A ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
      ∀ (N : ModuleCat.{u} (A ⧸ I)) (i : ℕ), b < i →
        Limits.IsZero (((Tor (ModuleCat.{u} (A ⧸ I)) i).obj
          (ModuleCat.of (A ⧸ I) (A ⧸ J))).obj N))
    (hJreg : ∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = J) :
    (∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = I) ∧
      ∃ qs : List (A ⧸ I), IsRegular (A ⧸ I) qs ∧
        Ideal.ofList qs = J.map (Ideal.Quotient.mk I) :=
  Koszul.exists_isRegular_ofList_eq_of_injective_mapQ_maximalIdeal I J hI hJ hIJ
    (StacksDraft.Rodicio.injective_mapQ_maximalIdeal_of_finite_torDimension
      I J hI hJ hIJ hTor) hJreg

/-- Let `I ⊆ J` be proper ideals of a Noetherian local ring `A`. If `A / J` has finite projective
dimension over `A / I` and `J` is generated by a regular sequence, then `I` is generated by a
regular sequence and the image of `J` in `A / I` is generated by a regular sequence of `A / I`.

This is `Stacks.CompleteIntersection.exists_isRegular_of_finite_torDimension` under a formally
stronger hypothesis. -/
@[ega "IV 19.1.6" "more general"]
theorem exists_isRegular_of_finite_projectiveDimension
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hI : I ≠ ⊤) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hpd : ∃ n : ℕ,
      letI : Algebra (A ⧸ I) (A ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
      HasProjectiveDimensionLE (ModuleCat.of (A ⧸ I) (A ⧸ J)) n)
    (hJreg : ∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = J) :
    (∃ rs : List A, IsRegular A rs ∧ Ideal.ofList rs = I) ∧
      ∃ qs : List (A ⧸ I), IsRegular (A ⧸ I) qs ∧
        Ideal.ofList qs = J.map (Ideal.Quotient.mk I) := by
  obtain ⟨n, hn⟩ := hpd
  exact Koszul.exists_isRegular_ofList_eq_of_injective_mapQ_maximalIdeal I J hI hJ hIJ
    (StacksDraft.Rodicio.injective_mapQ_maximalIdeal_of_finite_projectiveDimension
      I J hI hJ hIJ ⟨n + 1, hn⟩) hJreg

end Stacks.CompleteIntersection

end
