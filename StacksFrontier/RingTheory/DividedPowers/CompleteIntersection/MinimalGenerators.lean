module

public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import Mathlib.RingTheory.Nakayama
public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.RingTheory.Regular.RegularSequence
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Generating systems of an ideal generated by a regular sequence

Let `A` be a Noetherian local ring and let `fs` be a regular sequence generating an ideal `I`.
This file proves that every list of at most `fs.length` elements generating `I` has length
exactly `fs.length` and is itself a regular sequence. In particular `fs.length` is the minimal
number of generators of `I`, and every minimal generating system of `I` is a regular sequence.

This is the input the proof of [Stacks, Tag 09PW] needs after [Stacks, Tag 09PV]: in the source
it is quoted as "any minimal system of generators of `J` is a regular sequence", referring to
[Stacks, Tag 066A] and [Stacks, Tag 09CC], which transfer Koszul-regularity along a change of
generating system. The proof below avoids Koszul complexes, which Mathlib does not have. It is a
direct induction: Nakayama produces an entry `g` of the new system outside `𝔪 * I`, hence an
entry `f₀` of the regular sequence with `g - c * f₀` in the ideal generated by the rest and `c`
a unit; so `g` may be exchanged for `f₀` inside the regular sequence, and the induction continues
in `A ⧸ (g)`.

Note that no Cohen-Macaulay hypothesis is needed, in contrast to
`Module.IsMaximalCohenMacaulay.isRegular_of_sup_mul_eq`, which derives the same conclusion from
a dimension count rather than from a given regular sequence.

## Main definitions

None.

## Main results

* `Stacks.CompleteIntersection.isRegular_of_ofList_eq_of_length_le`: a list of at most
  `fs.length` elements generating `Ideal.ofList fs`, for `fs` a regular sequence in a Noetherian
  local ring, has length `fs.length` and is a regular sequence.

## Implementation notes

The induction is carried out over an auxiliary ideal `K`, with the regular sequence taken on the
module `A ⧸ K` rather than on `A`; this keeps the base ring fixed while the quotient grows, so
only `A`-linear identifications are needed. The private `quotSmulTopEquiv` and
`quotSMulTopEquivQuot` supply them.

## References

* [Stacks Project, Tag 09PW](https://stacks.math.columbia.edu/tag/09PW)
-/

namespace Stacks.CompleteIntersection

open Pointwise RingTheory.Sequence

universe u

variable {A : Type u} [CommRing A]

private lemma ofList_perm {l l' : List A} (h : l.Perm l') :
    Ideal.ofList l = Ideal.ofList l' :=
  congrArg Ideal.span (Set.ext fun _ => h.mem_iff)

/-- Entries of `l` lie in `Ideal.ofList l ⊔ K`. -/
private lemma mem_ofList_sup {l : List A} {x : A} (K : Ideal A) (hx : x ∈ l) :
    x ∈ Ideal.ofList l ⊔ K :=
  Submodule.mem_sup_left (Ideal.subset_span hx)

/-- Dropping the head of a list shrinks the ideal it generates. -/
private lemma ofList_le_ofList_cons (f : A) (l : List A) : Ideal.ofList l ≤ Ideal.ofList (f :: l) :=
  by rw [Ideal.ofList_cons]; exact le_sup_right

/-- The ideal `L` acts on `A ⧸ K` through its image. -/
private lemma smul_top_quotient (K L : Ideal A) :
    L • (⊤ : Submodule A (A ⧸ K)) = Submodule.map K.mkQ L := by
  calc L • (⊤ : Submodule A (A ⧸ K)) = L • Submodule.map K.mkQ ⊤ := by
        rw [Submodule.map_top, Submodule.range_mkQ]
    _ = Submodule.map K.mkQ (L • ⊤) := (Submodule.map_smul'' L ⊤ K.mkQ).symm
    _ = Submodule.map K.mkQ L := by rw [show L • (⊤ : Submodule A A) = L by simp]

private lemma map_mkQ_sup_self (K L : Ideal A) :
    Submodule.map K.mkQ L = Submodule.map K.mkQ (L ⊔ K) := by
  rw [Submodule.map_sup, Submodule.mkQ_map_self, sup_bot_eq]

/-- On `A ⧸ K` only the class of `L` modulo `K` matters. -/
private lemma smul_top_quotient_congr {K L L' : Ideal A} (h : L ⊔ K = L' ⊔ K) :
    L • (⊤ : Submodule A (A ⧸ K)) = L' • (⊤ : Submodule A (A ⧸ K)) := by
  rw [smul_top_quotient, smul_top_quotient, map_mkQ_sup_self K L, map_mkQ_sup_self K L', h]

/-- Everything in `L ⊔ K` annihilates `(A ⧸ K) ⧸ L • ⊤`. -/
private lemma smul_eq_zero_of_mem (K L : Ideal A) {a : A} (ha : a ∈ L ⊔ K)
    (x : (A ⧸ K) ⧸ L • (⊤ : Submodule A (A ⧸ K))) : a • x = 0 := by
  obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective (L • (⊤ : Submodule A (A ⧸ K))) x
  obtain ⟨b, rfl⟩ := Submodule.mkQ_surjective K y
  rw [← map_smul, ← map_smul]
  refine (Submodule.Quotient.mk_eq_zero _).2 ?_
  rw [smul_top_quotient, smul_eq_mul, map_mkQ_sup_self]
  exact Submodule.mem_map_of_mem (Ideal.mul_mem_right b _ ha)

/-- `(A ⧸ K) ⧸ L • ⊤` is `A ⧸ (K ⊔ L)`. -/
private noncomputable def quotSmulTopEquiv (K L : Ideal A) :
    ((A ⧸ K) ⧸ L • (⊤ : Submodule A (A ⧸ K))) ≃ₗ[A] A ⧸ (K ⊔ L) :=
  (Submodule.quotEquivOfEq _ _ (by
      rw [smul_top_quotient_congr (L' := K ⊔ L) (by rw [sup_comm K L, sup_assoc, sup_idem]),
        smul_top_quotient])).trans
    (Submodule.quotientQuotientEquivQuotient K (K ⊔ L) le_sup_left)

/-- Dividing `A ⧸ K` by one more element. -/
private noncomputable def quotSMulTopEquivQuot (K : Ideal A) (g : A) :
    QuotSMulTop g (A ⧸ K) ≃ₗ[A] A ⧸ (K ⊔ Ideal.span {g}) :=
  (Submodule.quotEquivOfEq _ _ (Submodule.ideal_span_singleton_smul g ⊤).symm).trans
    (quotSmulTopEquiv K (Ideal.span {g}))

/-- An element of `K` acts as zero on `A ⧸ K`. -/
private lemma smul_quotient_eq_zero {K : Ideal A} {a : A} (ha : a ∈ K) (x : A ⧸ K) :
    a • x = 0 := by
  obtain ⟨b, rfl⟩ := Submodule.mkQ_surjective K x
  rw [← map_smul, smul_eq_mul]
  exact (Submodule.Quotient.mk_eq_zero _).2 (Ideal.mul_mem_right b _ ha)

/-- If `g` lies in `Ideal.ofList fs ⊔ K` but not in `𝔪 * Ideal.ofList fs ⊔ K`, then some entry
of `fs` can be moved to the front and recovered from `g` up to a unit, modulo the remaining
entries and `K`. -/
private lemma exists_unit_coeff [IsLocalRing A] (K : Ideal A) :
    ∀ (fs : List A) (g : A), g ∈ Ideal.ofList fs ⊔ K →
      g ∉ IsLocalRing.maximalIdeal A * Ideal.ofList fs ⊔ K →
      ∃ (f₀ c : A) (others : List A), fs.Perm (f₀ :: others) ∧ IsUnit c ∧
        g - c * f₀ ∈ Ideal.ofList others ⊔ K := by
  intro fs
  induction fs with
  | nil =>
      intro g hmem hnot
      rw [Ideal.ofList_nil, bot_sup_eq] at hmem
      exact absurd (Submodule.mem_sup_right hmem) hnot
  | cons f t ih =>
      intro g hmem hnot
      rw [Ideal.ofList_cons, sup_assoc] at hmem
      obtain ⟨u, hu, z, hz, huz⟩ := Submodule.mem_sup.1 hmem
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hu
      have hgz : g - a * f = z := by
        rw [← huz]
        ring
      by_cases hau : IsUnit a
      · exact ⟨f, a, t, List.Perm.refl _, hau, hgz ▸ hz⟩
      · have ham : a ∈ IsLocalRing.maximalIdeal A :=
          (IsLocalRing.mem_maximalIdeal a).2 hau
        have hznot : z ∉ IsLocalRing.maximalIdeal A * Ideal.ofList t ⊔ K := by
          intro hzmem
          refine hnot ?_
          have h1 : a * f ∈ IsLocalRing.maximalIdeal A * Ideal.ofList (f :: t) :=
            Ideal.mul_mem_mul ham (Ideal.subset_span List.mem_cons_self)
          have h2 : z ∈ IsLocalRing.maximalIdeal A * Ideal.ofList (f :: t) ⊔ K :=
            sup_le_sup_right (Ideal.mul_mono le_rfl (ofList_le_ofList_cons f t)) K hzmem
          rw [← huz]
          exact Submodule.add_mem _ (Submodule.mem_sup_left h1) h2
        obtain ⟨f₀, c, others, hperm, hc, hmem'⟩ := ih z hz hznot
        refine ⟨f₀, c, f :: others, (hperm.cons f).trans (List.Perm.swap _ _ _), hc, ?_⟩
        have hsplit : g - c * f₀ = a * f + (z - c * f₀) := by
          rw [← hgz]
          ring
        rw [hsplit, Ideal.ofList_cons, sup_assoc]
        exact Submodule.add_mem _
          (Submodule.mem_sup_left (Ideal.mem_span_singleton'.2 ⟨a, rfl⟩))
          (Submodule.mem_sup_right hmem')

/-- Nakayama: if `gs` generates `Ideal.ofList fs` modulo `K` and `fs` is a nonempty regular
sequence on `A ⧸ K`, then some entry of `gs` avoids `𝔪 * Ideal.ofList fs ⊔ K`. -/
private lemma exists_notMem_maximal_mul [IsNoetherianRing A] [IsLocalRing A]
    {K : Ideal A} {fs gs : List A} (hreg : IsRegular (A ⧸ K) fs) (hfs : fs ≠ [])
    (heq : Ideal.ofList gs ⊔ K = Ideal.ofList fs ⊔ K) :
    ∃ g ∈ gs, g ∉ IsLocalRing.maximalIdeal A * Ideal.ofList fs ⊔ K := by
  by_contra hcon
  simp only [not_exists, not_and, not_not] at hcon
  have hgsle : Ideal.ofList gs ≤ IsLocalRing.maximalIdeal A * Ideal.ofList fs ⊔ K :=
    Ideal.span_le.2 fun x hx => hcon x hx
  have hfsle : Ideal.ofList fs ≤ IsLocalRing.maximalIdeal A * Ideal.ofList fs ⊔ K := by
    refine (le_sup_left : Ideal.ofList fs ≤ Ideal.ofList fs ⊔ K).trans ?_
    rw [← heq]
    exact sup_le hgsle le_sup_right
  have hNfg : (Submodule.map K.mkQ (Ideal.ofList fs)).FG :=
    Submodule.FG.map _ (IsNoetherian.noetherian _)
  have hNle : Submodule.map K.mkQ (Ideal.ofList fs) ≤
      IsLocalRing.maximalIdeal A • Submodule.map K.mkQ (Ideal.ofList fs) := by
    have h1 := Submodule.map_mono (f := K.mkQ) hfsle
    rw [← map_mkQ_sup_self K (IsLocalRing.maximalIdeal A * Ideal.ofList fs)] at h1
    refine h1.trans (le_of_eq ?_)
    rw [← Ideal.smul_eq_mul]
    exact Submodule.map_smul'' _ _ _
  have hNbot : Submodule.map K.mkQ (Ideal.ofList fs) = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ hNfg hNle
      (IsLocalRing.maximalIdeal_le_jacobson ⊥)
  have hsub : Ideal.ofList fs ≤ K := by
    intro x hx
    have hx' := Submodule.mem_map_of_mem (f := K.mkQ) hx
    rw [hNbot, Submodule.mem_bot] at hx'
    rwa [← Submodule.ker_mkQ K, LinearMap.mem_ker]
  obtain ⟨f, t, rfl⟩ := List.exists_cons_of_ne_nil hfs
  have hfK : f ∈ K := hsub (Ideal.subset_span List.mem_cons_self)
  have := hreg.nontrivial
  exact one_ne_zero (((isRegular_cons_iff _ f t).1 hreg).1
    (by simp [smul_quotient_eq_zero hfK] : f • (1 : A ⧸ K) = f • (0 : A ⧸ K)))

/-- Exchanging an entry `f₀` of `fs` for `g`, where `g - c * f₀` lies in the ideal generated by
the remaining entries modulo `K` and `c` is a unit, does not change the ideal modulo `K`. -/
private lemma ofList_cons_sup_eq_of_isUnit {K : Ideal A} {fs others : List A} {f₀ c g : A}
    (hperm : fs.Perm (f₀ :: others)) (hc : IsUnit c) (hgJ : g ∈ Ideal.ofList fs ⊔ K)
    (hcmem : g - c * f₀ ∈ Ideal.ofList others ⊔ K) :
    Ideal.ofList (g :: others) ⊔ K = Ideal.ofList fs ⊔ K := by
  obtain ⟨v, hv⟩ := hc
  refine le_antisymm (sup_le (Ideal.span_le.2 ?_) le_sup_right)
    (sup_le (Ideal.span_le.2 ?_) le_sup_right)
  · intro x hx
    rcases List.mem_cons.1 hx with rfl | hx
    · exact hgJ
    · exact mem_ofList_sup K (hperm.mem_iff.2 (List.mem_cons_of_mem _ hx))
  · intro x hx
    rcases List.mem_cons.1 (hperm.mem_iff.1 hx) with rfl | hx
    · have hd : g - c * x ∈ Ideal.ofList (g :: others) ⊔ K :=
        sup_le_sup_right (ofList_le_ofList_cons g others) K hcmem
      have h1 : c * x ∈ Ideal.ofList (g :: others) ⊔ K := by
        simpa using Submodule.sub_mem _ (mem_ofList_sup K List.mem_cons_self) hd
      have hx' : (↑v⁻¹ : A) * (c * x) = x := by
        rw [← hv, ← mul_assoc, Units.inv_mul, one_mul]
      rw [← hx']
      exact Ideal.mul_mem_left _ _ h1
    · exact mem_ofList_sup K (List.mem_cons_of_mem _ hx)

/-- Under the exchange of `ofList_cons_sup_eq_of_isUnit`, `g :: others` is again a regular
sequence on `A ⧸ K`. -/
private lemma isRegular_cons_of_sub_mul_mem [IsNoetherianRing A] [IsLocalRing A]
    {K : Ideal A} {fs others : List A} {f₀ c g : A} (hreg : IsRegular (A ⧸ K) fs)
    (hperm : fs.Perm (f₀ :: others)) (hc : IsUnit c)
    (hcmem : g - c * f₀ ∈ Ideal.ofList others ⊔ K)
    (hgo : Ideal.ofList (g :: others) ⊔ K = Ideal.ofList fs ⊔ K) :
    IsRegular (A ⧸ K) (g :: others) := by
  have hregfo : IsRegular (A ⧸ K) (others ++ [f₀]) :=
    IsLocalRing.isRegular_of_perm hreg
      (hperm.trans (List.perm_append_singleton f₀ others).symm)
  obtain ⟨hw1, hw2⟩ :=
    (isWeaklyRegular_append_iff (A ⧸ K) others [f₀]).1 hregfo.toIsWeaklyRegular
  have hf₀reg :
      IsSMulRegular ((A ⧸ K) ⧸ Ideal.ofList others • (⊤ : Submodule A (A ⧸ K))) f₀ :=
    (isWeaklyRegular_singleton_iff _ f₀).1 hw2
  have hgreg :
      IsSMulRegular ((A ⧸ K) ⧸ Ideal.ofList others • (⊤ : Submodule A (A ⧸ K))) g := by
    have hcf : IsSMulRegular
        ((A ⧸ K) ⧸ Ideal.ofList others • (⊤ : Submodule A (A ⧸ K))) (c * f₀) :=
      (IsUnit.isSMulRegular _ hc).mul hf₀reg
    have hsm : ∀ w : (A ⧸ K) ⧸ Ideal.ofList others • (⊤ : Submodule A (A ⧸ K)),
        g • w = (c * f₀) • w := by
      intro w
      have h := smul_eq_zero_of_mem K (Ideal.ofList others) hcmem w
      rw [sub_smul] at h
      exact sub_eq_zero.1 h
    intro x y hxy
    refine hcf ?_
    show (c * f₀) • x = (c * f₀) • y
    rw [← hsm, ← hsm]
    exact hxy
  have hwg : IsWeaklyRegular (A ⧸ K) (others ++ [g]) :=
    (isWeaklyRegular_append_iff (A ⧸ K) others [g]).2
      ⟨hw1, (isWeaklyRegular_singleton_iff _ g).2 hgreg⟩
  have hregg : IsRegular (A ⧸ K) (others ++ [g]) := by
    refine ⟨hwg, ?_⟩
    have hsm : Ideal.ofList (others ++ [g]) • (⊤ : Submodule A (A ⧸ K))
        = Ideal.ofList fs • (⊤ : Submodule A (A ⧸ K)) := by
      refine smul_top_quotient_congr ?_
      rw [ofList_perm (List.perm_append_singleton g others)]
      exact hgo
    rw [hsm]
    exact hreg.top_ne_smul
  exact IsLocalRing.isRegular_of_perm hregg (List.perm_append_singleton g others)

private lemma ofList_sup_sup_span_singleton (K : Ideal A) (g : A) (l : List A) :
    Ideal.ofList l ⊔ (K ⊔ Ideal.span {g}) = Ideal.ofList (g :: l) ⊔ K := by
  rw [Ideal.ofList_cons, sup_comm K (Ideal.span {g}), ← sup_assoc,
    sup_comm (Ideal.ofList l) (Ideal.span {g})]

private theorem isRegular_of_ofList_sup_eq_aux [IsNoetherianRing A] [IsLocalRing A] :
    ∀ (n : ℕ) (K : Ideal A) (fs gs : List A), fs.length = n → gs.length ≤ n →
      IsRegular (A ⧸ K) fs → Ideal.ofList gs ⊔ K = Ideal.ofList fs ⊔ K →
      gs.length = n ∧ IsRegular (A ⧸ K) gs := by
  intro n
  induction n with
  | zero =>
      intro K fs gs hfl hgl hreg _
      obtain rfl : gs = [] := List.eq_nil_of_length_eq_zero (Nat.le_zero.1 hgl)
      obtain rfl : fs = [] := List.eq_nil_of_length_eq_zero hfl
      exact ⟨rfl, hreg⟩
  | succ n ih =>
      intro K fs gs hfl hgl hreg heq
      have hfs : fs ≠ [] := fun h => by simp [h] at hfl
      obtain ⟨g, hgmem, hgnot⟩ := exists_notMem_maximal_mul hreg hfs heq
      have hgJ : g ∈ Ideal.ofList fs ⊔ K := by
        rw [← heq]
        exact mem_ofList_sup K hgmem
      obtain ⟨f₀, c, others, hperm, hc, hcmem⟩ := exists_unit_coeff K fs g hgJ hgnot
      obtain ⟨s, t, rfl⟩ := List.mem_iff_append.1 hgmem
      have hgperm : (s ++ g :: t).Perm (g :: (s ++ t)) := List.perm_middle
      have hothers : others.length = n := by
        have h := hperm.length_eq
        simp only [List.length_cons] at h
        omega
      have hrestle : (s ++ t).length ≤ n := by
        have h := hgperm.length_eq
        simp only [List.length_cons] at h
        omega
      have hgo := ofList_cons_sup_eq_of_isUnit hperm hc hgJ hcmem
      obtain ⟨hgsmul, hregq⟩ := (isRegular_cons_iff (A ⧸ K) g others).1
        (isRegular_cons_of_sub_mul_mem hreg hperm hc hcmem hgo)
      have hideal : Ideal.ofList (s ++ t) ⊔ (K ⊔ Ideal.span {g})
          = Ideal.ofList others ⊔ (K ⊔ Ideal.span {g}) := by
        rw [ofList_sup_sup_span_singleton K g, ofList_sup_sup_span_singleton K g, hgo,
          ← ofList_perm hgperm, heq]
      obtain ⟨hlen, hregrest⟩ :=
        ih (K ⊔ Ideal.span {g}) others (s ++ t) hothers hrestle
          ((LinearEquiv.isRegular_congr (quotSMulTopEquivQuot K g) others).1 hregq) hideal
      refine ⟨?_, ?_⟩
      · simp only [List.length_append, List.length_cons] at hlen ⊢
        omega
      · refine IsLocalRing.isRegular_of_perm
          ((isRegular_cons_iff (A ⧸ K) g (s ++ t)).2 ⟨hgsmul, ?_⟩) hgperm.symm
        exact (LinearEquiv.isRegular_congr (quotSMulTopEquivQuot K g) (s ++ t)).2 hregrest

/-- In a Noetherian local ring, a list of at most `fs.length` elements generating the ideal
generated by a regular sequence `fs` has length exactly `fs.length` and is itself a regular
sequence. -/
@[sga "1 II 4.14" "Noetherian local case", sga "4½ Cycle 2.2.1"]
public theorem isRegular_of_ofList_eq_of_length_le [IsNoetherianRing A] [IsLocalRing A]
    {fs gs : List A} (hreg : IsRegular A fs) (hlen : gs.length ≤ fs.length)
    (heq : Ideal.ofList gs = Ideal.ofList fs) :
    gs.length = fs.length ∧ IsRegular A gs := by
  have e : (A ⧸ (⊥ : Ideal A)) ≃ₗ[A] A := Submodule.quotEquivOfEqBot ⊥ rfl
  obtain ⟨h1, h2⟩ :=
    isRegular_of_ofList_sup_eq_aux fs.length ⊥ fs gs rfl hlen
      ((e.isRegular_congr fs).2 hreg) (by rw [heq])
  exact ⟨h1, (e.isRegular_congr gs).1 h2⟩

end Stacks.CompleteIntersection
