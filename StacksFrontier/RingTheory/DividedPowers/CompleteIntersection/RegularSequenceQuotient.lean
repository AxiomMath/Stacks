open CategoryTheory.MonoidalCategory HomologicalComplex
open TotalTensorComplex.SingleTensor
open RingTheory.Sequence

/-- An ideal is generated by a regular sequence if it is the ideal spanned by the entries of
some regular list. -/
@[ega "IV 19.3.1"]
public def _root_.Ideal.IsGeneratedByRegularSequence {A : Type u} [CommRing A]
    (I : Ideal A) : Prop :=
  ∃ f : List A, RingTheory.Sequence.IsRegular A f ∧ Ideal.ofList f = I

/-- A module has finite Tor dimension if all its Tor groups against every module vanish above one
uniform degree. -/
public def FiniteTorDimension {A : Type u} [CommRing A] (M : ModuleCat.{u} A) : Prop :=
  ∃ n : ℕ, ∀ (N : ModuleCat.{u} A) (p : ℕ), n < p →
    Limits.IsZero (((Tor (ModuleCat.{u} A) p).obj M).obj N)

/-- The target of a ring homomorphism, regarded as a module over its source. -/
public noncomputable def quotientModule {A B : Type u} [CommRing A] [CommRing B]
    (f : A →+* B) : ModuleCat.{u} A :=
  (ModuleCat.restrictScalars f).obj (ModuleCat.of B B)

private noncomputable def bridgeTensorResolutionHomologyIso
    {R : Type u} [CommRing R]
    (K : CochainComplex (ModuleCat.{u} R) ℤ) (hK : K.KFlat)
    (Z : ModuleCat.{u} R) {P : CochainComplex (ModuleCat.{u} R) ℤ}
    (ε : P ⟶ (single _ (ComplexShape.up ℤ) 0).obj Z) [QuasiIso ε] (n : ℤ) :
    (HomologicalComplex.mapBifunctor K P (moduleTensorBifunctor R)
      (ComplexShape.up ℤ)).homology n ≅
      (((tensorLeft Z).mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology n := by
  have hε := CochainComplex.DerivedTensor.quasiIso_tright_map K hK ε
  haveI : QuasiIsoAt ((TrightCochain K).map ε) n := hε.quasiIsoAt n
  exact homologyMapIso (CochainComplex.DerivedTensor.tensorFlipIso K P) n ≪≫
    isoOfQuasiIsoAt ((TrightCochain K).map ε) n ≪≫
      homologyMapIso (singleTensorIso Z K) n

private theorem bridgeIsZeroTorInDegreeOfNeg {R : Type u} [CommRing R] {n : ℤ}
    (hn : n < 0) (X Y : ModuleCat.{u} R) :
    IsZero (CochainComplex.Tor.TorInDegree R n X Y) := by
  rw [ModuleCat.isZero_iff_subsingleton]
  unfold CochainComplex.Tor.TorInDegree
  simp only [dite_eq_right (show ¬ 0 ≤ n by omega)]
  infer_instance

/-- Tensoring a complex with a module on the left preserves vanishing of homology where the
complex vanishes. -/
private theorem isZero_homology_tensorLeft_of_isZero_X {R : Type u} [CommRing R]
    (N : ModuleCat.{u} R) (K : CochainComplex (ModuleCat.{u} R) ℤ) {i : ℤ} (h : IsZero (K.X i)) :
    IsZero ((((tensorLeft N).mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology i) :=
  ShortComplex.isZero_homology_of_isZero_X₂ _ ((tensorLeft N).map_isZero h)

private noncomputable def bridgeTorIsoOfKFlatRepresentative {R : Type u} [CommRing R]
    {M : ModuleCat.{u} R} {P : CochainComplex (ModuleCat.{u} R) ℤ}
    (ε : P ⟶ (single _ (ComplexShape.up ℤ) 0).obj M) [QuasiIso ε]
    (hP : P.KFlat) (X : ModuleCat.{u} R) (n : ℤ) :
    (((tensorLeft X).mapHomologicalComplex (ComplexShape.up ℤ)).obj P).homology (-n) ≅
      CochainComplex.Tor.TorInDegree R n M X := by
  let Q := ProjectiveResolution.of X
  have hQ : Q.cochainComplex.KFlat :=
    _root_.CochainComplex.KFlat.kFlat_projectiveResolution Q
  have h : (((tensorLeft X).mapHomologicalComplex (ComplexShape.up ℤ)).obj P).homology (-n) ≅
      (((tensorLeft M).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        Q.cochainComplex).homology (-n) :=
    (bridgeTensorResolutionHomologyIso P hP X Q.π' (-n)).symm ≪≫
      homologyMapIso (CochainComplex.DerivedTensor.tensorFlipIso P Q.cochainComplex) (-n) ≪≫
      bridgeTensorResolutionHomologyIso Q.cochainComplex hQ M ε (-n)
  by_cases hn : 0 ≤ n
  · let F := (CochainComplex.Tor.moduleTensorBifunctor R).obj M
    let C := (F.mapHomologicalComplex (ComplexShape.down ℕ)).obj Q.complex
    have he : ComplexShape.embeddingDownNat.f n.toNat = -n := by
      change -(n.toNat : ℤ) = -n
      rw [Int.toNat_of_nonneg hn]
    have eT : (C.extend ComplexShape.embeddingDownNat).homology (-n) ≅
        C.homology n.toNat :=
      HomologicalComplex.extendHomologyIso C ComplexShape.embeddingDownNat he
    have eP : (F.leftDerived n.toNat).obj X ≅ C.homology n.toNat :=
      Q.isoLeftDerivedObj F n.toNat
    have e₀ : (((tensorLeft M).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        Q.cochainComplex).homology (-n) ≅
        (C.extend ComplexShape.embeddingDownNat).homology (-n) :=
      homologyMapIso (HomologicalComplex.mapHomologicalComplexExtendIso (tensorLeft M)
        Q.complex ComplexShape.embeddingDownNat).symm (-n)
    have e := h ≪≫ e₀ ≪≫ eT ≪≫ eP.symm
    simpa only [CochainComplex.Tor.TorInDegree, dite_eq_left hn] using e
  · have hQx : IsZero (Q.cochainComplex.X (-n)) :=
      CochainComplex.isZero_of_isStrictlyLE Q.cochainComplex 0 (-n) (by omega)
    have hhom := isZero_homology_tensorLeft_of_isZero_X M _ hQx
    exact (hhom.of_iso h).iso (bridgeIsZeroTorInDegreeOfNeg (by omega) M X)

private theorem bridgeFlatQuotientMap {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] (I : Ideal R) :
    letI : Algebra (R ⧸ I) (S ⧸ I.map (algebraMap R S)) :=
      Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
    Module.Flat (R ⧸ I) (S ⧸ I.map (algebraMap R S)) := by
  let : Algebra (R ⧸ I) (S ⧸ I.map (algebraMap R S)) :=
    Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
  exact Module.Flat.of_linearEquiv
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S I).toLinearEquiv

private theorem bridgeKFlat_of_boundedAbove_flats {R : Type u} [CommRing R]
    (F : CochainComplex (ModuleCat.{u} R) ℤ)
    (hFbd : StacksDraft.TorAmplitude.BoundedAbove F)
    (hFflat : StacksDraft.TorAmplitude.IsComplexOfFlats F) : F.KFlat := by
  obtain ⟨b, hb⟩ := hFbd
  have : F.IsStrictlyLE b := by
    rw [CochainComplex.isStrictlyLE_iff]
    exact hb
  have : ∀ i : ℤ, Module.Flat R (F.X i) := hFflat
  exact CochainComplex.KFlat.kFlat_of_flat F b

@[ega "IV 19.1.6" "more general"]
private theorem regularSequence_join_ideals
    {S : Type*} [CommRing S] (I J : Ideal S) (hIJ : I ≤ J)
    (hI : ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = I)
    (hQ : ∃ qs : List (S ⧸ I), IsRegular (S ⧸ I) qs ∧
      Ideal.ofList qs = J.map (Ideal.Quotient.mk I)) :
    ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = J := by
  obtain ⟨f, hf, hfI⟩ := hI
  subst I
  obtain ⟨q, hq, hqJ⟩ := hQ
  obtain ⟨g, hg⟩ := Ideal.Quotient.mk_surjective.list_map q
  have hsmul : Ideal.ofList f • (⊤ : Submodule S S) = Ideal.ofList f := by
    simp
  have hweak : IsWeaklyRegular S (f ++ g) := by
    refine (isWeaklyRegular_append_iff S f g).2 ⟨hf.1, ?_⟩
    have hqS : IsWeaklyRegular (S ⧸ Ideal.ofList f) g := by
      apply (isWeaklyRegular_map_algebraMap_iff
        (S ⧸ Ideal.ofList f) (S ⧸ Ideal.ofList f) g).mp
      simpa [Ideal.Quotient.algebraMap_eq, hg] using hq.1
    exact ((Submodule.quotEquivOfEq _ _ hsmul).isWeaklyRegular_congr g).mpr hqS
  have hIle : Ideal.ofList f ≤ Ideal.ofList (f ++ g) := by
    rw [Ideal.ofList_append]
    exact le_sup_left
  have hmap : (Ideal.ofList (f ++ g)).map (Ideal.Quotient.mk (Ideal.ofList f)) =
      J.map (Ideal.Quotient.mk (Ideal.ofList f)) := by
    rw [Ideal.ofList_append, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
      Ideal.map_ofList, hg]
    exact hqJ
  have hspan : Ideal.ofList (f ++ g) = J := by
    have hh := congrArg (Ideal.comap (Ideal.Quotient.mk (Ideal.ofList f))) hmap
    rwa [Ideal.comap_map_mk hIle, Ideal.comap_map_mk hIJ] at hh
  have hQne : Ideal.ofList q ≠ ⊤ := by
    intro h
    apply hq.2
    simp [h]
  have hJne : J ≠ ⊤ := by
    intro h
    apply hQne
    rw [hqJ, h, Ideal.map_top]
  refine ⟨f ++ g, ⟨hweak, ?_⟩, hspan⟩
  rw [hspan]
  simpa using hJne.symm

private theorem isComplexOfFlats_restrictScalars_extend_of_projective
    {A B M : Type u} [CommRing A] [CommRing B] [AddCommGroup M]
    [Algebra A B] [Module.Flat A B] [Module B M]
    (F : ModuleResolution B M) (hproj : ∀ i, Module.Projective B (F.complex.X i)) :
    StacksDraft.TorAmplitude.IsComplexOfFlats
      (((ModuleCat.restrictScalars (algebraMap A B)).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj (F.complex.extend ComplexShape.embeddingDownNat)) := by
  let P : CochainComplex (ModuleCat.{u} B) ℤ :=
    F.complex.extend ComplexShape.embeddingDownNat
  intro i
  let : Module A (P.X i) := Module.compHom (P.X i) (algebraMap A B)
  let : IsScalarTower A B (P.X i) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  change Module.Flat A (P.X i)
  have : Module.Flat B (P.X i) := by
    change Module.Flat B ↑(HomologicalComplex.extend.X F.complex
      (ComplexShape.embeddingDownNat.r i))
    cases ComplexShape.embeddingDownNat.r i with
    | some n =>
      change Module.Flat B (F.complex.X n)
      have := hproj n
      infer_instance
    | none =>
      have hz : IsZero (HomologicalComplex.extend.X F.complex none) := isZero_zero _
      have := ModuleCat.isZero_iff_subsingleton.mp hz
      let : Module.Projective B ↑(HomologicalComplex.extend.X F.complex none) :=
        Module.Projective.of_free
      infer_instance
  exact Module.Flat.trans A B (P.X i)

private theorem isStrictlyGE_extend_of_isZero {B M : Type u} [CommRing B] [AddCommGroup M]
    [Module B M] (F : ModuleResolution B M) (d : ℕ)
    (hzero : ∀ i, d < i → IsZero (F.complex.X i)) :
    CochainComplex.IsStrictlyGE (F.complex.extend ComplexShape.embeddingDownNat) (-(d : ℤ)) := by
  rw [CochainComplex.isStrictlyGE_iff]
  intro i hi
  change IsZero (HomologicalComplex.extend.X F.complex
    (ComplexShape.embeddingDownNat.r i))
  cases hn : ComplexShape.embeddingDownNat.r i with
  | some n =>
    apply hzero n
    have hf := ComplexShape.Embedding.f_eq_of_r_eq_some _ hn
    change -(n : ℤ) = i at hf
    omega
  | none => exact isZero_zero _

private theorem finiteTorDimension_of_flat_projective_resolution
    {A B M : Type u} [CommRing A] [CommRing B] [AddCommGroup M]
    [Algebra A B] [Module.Flat A B] [Module B M]
    (F : ModuleResolution B M) (d : ℕ)
    (hproj : ∀ i, Module.Projective B (F.complex.X i))
    (hzero : ∀ i, d < i → IsZero (F.complex.X i)) :
    ∃ n : ℕ, ∀ (N : ModuleCat.{u} A) (p : ℕ), n < p →
      IsZero (((Tor (ModuleCat.{u} A) p).obj
        ((ModuleCat.restrictScalars (algebraMap A B)).obj (ModuleCat.of B M))).obj N) := by
  let P : CochainComplex (ModuleCat.{u} B) ℤ :=
    F.complex.extend ComplexShape.embeddingDownNat
  let G := ModuleCat.restrictScalars (algebraMap A B)
  let Q : CochainComplex (ModuleCat.{u} A) ℤ :=
    (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj P
  let X : ModuleCat.{u} A := G.obj (ModuleCat.of B M)
  let π : P ⟶ (CochainComplex.singleFunctor (ModuleCat.{u} B) 0).obj (ModuleCat.of B M) :=
    HomologicalComplex.extendMap F.π ComplexShape.embeddingDownNat ≫
      (HomologicalComplex.extendSingleIso ComplexShape.embeddingDownNat
        (ModuleCat.of B M) 0 0 rfl).hom
  have : QuasiIso F.π := F.quasiIso
  have : QuasiIso π := by
    dsimp [π]
    infer_instance
  let ε : Q ⟶ (CochainComplex.singleFunctor (ModuleCat.{u} A) 0).obj X :=
    (G.mapHomologicalComplex (ComplexShape.up ℤ)).map π ≫
      ((HomologicalComplex.singleMapHomologicalComplex G (ComplexShape.up ℤ) 0).app
        (ModuleCat.of B M)).hom
  have : QuasiIso ε := by
    dsimp [ε]
    infer_instance
  have : Q.IsStrictlyLE 0 :=
    (CochainComplex.isStrictlyLE_mapHomologicalComplex_obj_iff (K := P) G 0).2
      (by infer_instance)
  have : Q.IsStrictlyGE (-(d : ℤ)) :=
    (CochainComplex.isStrictlyGE_mapHomologicalComplex_obj_iff (K := P) G _).2
      (isStrictlyGE_extend_of_isZero F d hzero)
  have hQflat : StacksDraft.TorAmplitude.IsComplexOfFlats Q :=
    isComplexOfFlats_restrictScalars_extend_of_projective F hproj
  have hQK : Q.KFlat := bridgeKFlat_of_boundedAbove_flats Q
    ⟨0, fun i hi => Q.isZero_of_isStrictlyLE 0 i hi⟩ hQflat
  refine ⟨d, fun N p hp => ?_⟩
  have hh := isZero_homology_tensorLeft_of_isZero_X N Q
    (Q.isZero_of_isStrictlyGE (-(d : ℤ)) (-(p : ℤ)) (by omega))
  exact hh.of_iso (bridgeTorIsoOfKFlatRepresentative ε hQK N p).symm

/-- Let `B` be a Noetherian local ring flat over `A`. The quotient of `B` by an ideal generated by
a regular sequence, viewed as an `A`-module, has vanishing `Tor` groups over `A` in all large
enough degrees. -/
theorem exists_isZero_tor_quotient_of_isRegular
    {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [Algebra A B] [Module.Flat A B] (qs : List B) (hqs : IsRegular B qs) (K : Ideal B)
    (hK : Ideal.ofList qs = K) :
    ∃ n : ℕ, ∀ (N : ModuleCat.{u} A) (p : ℕ), n < p →
      IsZero (((Tor (ModuleCat.{u} A) p).obj
        ((ModuleCat.restrictScalars (algebraMap A B)).obj (ModuleCat.of B (B ⧸ K)))).obj N) := by
  subst hK
  have hpdShrink : CategoryTheory.projectiveDimension
      (ModuleCat.of B (Shrink.{u} (B ⧸ Ideal.ofList qs))) = qs.length :=
    ModuleCat.projectiveDimension_quotient_eq_length qs hqs
  have hpd : CategoryTheory.projectiveDimension
      (ModuleCat.of B (B ⧸ Ideal.ofList qs)) = qs.length :=
    (ModuleCat.projectiveDimension_eq_of_linearEquiv
      (Shrink.linearEquiv B (B ⧸ Ideal.ofList qs))).symm.trans hpdShrink
  have : Module.Finite B (B ⧸ Ideal.ofList qs) := Module.Finite.of_surjective
    (Algebra.linearMap B (B ⧸ Ideal.ofList qs)) (by
      intro x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact ⟨y, rfl⟩)
  have hdim : HasProjectiveDimensionLE (ModuleCat.of B (B ⧸ Ideal.ofList qs)) qs.length :=
    (CategoryTheory.projectiveDimension_le_iff _ _).mp (by rw [hpd])
  obtain ⟨F, hzero⟩ :=
    (ModuleCat.hasProjectiveDimensionLE_iff_exists_leftResolution_projective_finite
      (ModuleCat.of B (B ⧸ Ideal.ofList qs)) qs.length).mp hdim
  let G : ModuleResolution B (B ⧸ Ideal.ofList qs) :=
    { complex := F.complex
      hasHomology := F.hasHomology
      π := F.π
      quasiIso := F.quasiIso }
  exact finiteTorDimension_of_flat_projective_resolution G qs.length
    (fun i => by
      let : Projective (F.complex.X i) := (F.property i).1
      exact ModuleCat.projective_of_module_projective (F.complex.X i))
    hzero

/-- Let `R → S` be a flat local homomorphism of local rings with `S` Noetherian, let `I ⊆ R` be
contained in the maximal ideal and `J ⊆ S` contain `IS`. If `J / IS` is generated by a regular
sequence of `S / IS`, then `S / J` has finite Tor dimension over `R / I`. -/
theorem finiteTorDimension_quotientModule_of_flat
    {R S : Type u} [CommRing R] [CommRing S] [IsNoetherianRing S] [IsLocalRing R]
    [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (I : Ideal R) (J : Ideal S) (hI : I ≤ IsLocalRing.maximalIdeal R)
    (hIJ : I.map (algebraMap R S) ≤ J)
    (hregQ : Ideal.IsGeneratedByRegularSequence
      (J.map (Ideal.Quotient.mk (I.map (algebraMap R S))))) :
    FiniteTorDimension (quotientModule
      (Ideal.quotientMap J (algebraMap R S) ((Ideal.map_le_iff_le_comap).mp hIJ))) := by
  let qI : Ideal S := I.map (algebraMap R S)
  let A := R ⧸ I
  let B := S ⧸ qI
  let C := S ⧸ J
  let K : Ideal B := J.map (Ideal.Quotient.mk qI)
  obtain ⟨qs, hqs, hspanQ⟩ := hregQ
  have hqIne : qI ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal S).ne_top
    ((Ideal.map_mono hI).trans (IsLocalRing.map_maximalIdeal_le (algebraMap R S)))
  have : Nontrivial B := Ideal.Quotient.nontrivial_iff.mpr hqIne
  have : IsLocalRing B := IsLocalRing.of_surjective'
    (Ideal.Quotient.mk qI) Ideal.Quotient.mk_surjective
  have : IsNoetherianRing B := Ideal.Quotient.isNoetherianRing qI
  let : Algebra A B := Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map
  have : Module.Flat A B := bridgeFlatQuotientMap I
  let fAB : A →+* B := Ideal.quotientMap qI (algebraMap R S) Ideal.le_comap_map
  have hfAB : fAB = algebraMap A B := by
    ext x
    simp [fAB, A, B, qI]
  let fBC : B →+* C := Ideal.Quotient.factor hIJ
  let : Algebra B C := fBC.toAlgebra
  let fAC : A →+* C := Ideal.quotientMap J (algebraMap R S)
    ((Ideal.map_le_iff_le_comap).mp hIJ)
  let : Algebra A C := fAC.toAlgebra
  have hfcomp : fAC = fBC.comp fAB := by
    ext x
    rfl
  let : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq fun x => by
    rw [← hfAB]
    exact (DFunLike.congr_fun hfcomp x)
  obtain ⟨d, hd⟩ := exists_isZero_tor_quotient_of_isRegular (A := A) (B := B) qs hqs K hspanQ
  let eQ : (B ⧸ K) ≃+* C := DoubleQuot.quotQuotEquivQuotOfLE hIJ
  let eQAlg : (B ⧸ K) ≃ₐ[B] C :=
    AlgEquiv.ofRingEquiv (f := eQ) (by
      intro b
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective b
      rfl)
  let eA :
      (↑((ModuleCat.restrictScalars (algebraMap A B)).obj
        (ModuleCat.of B (B ⧸ K))) : Type u) ≃ₗ[A]
        (↑(quotientModule fAC) : Type u) := by
    let e := eQAlg.toLinearEquiv.restrictScalars A
    refine { e with map_smul' := ?_ }
    intro a x
    change eQAlg (algebraMap B (B ⧸ K) (algebraMap A B a) *
      (show B ⧸ K from x)) = fAC a * eQAlg (show B ⧸ K from x)
    rw [map_mul, eQAlg.commutes]
    congr 1
    exact (DFunLike.congr_fun hfcomp a).symm
  exact ⟨d, fun N p hp => (hd N p hp).of_iso
    (((Tor (ModuleCat.{u} A) p).mapIso eA.toModuleIso).app N).symm⟩

/-- If `I` is generated by a regular sequence of `R` and `J / IS` is generated by a regular
sequence of `S / IS`, then `J` is generated by a regular sequence of `S` and `S / J` has finite
Tor dimension over `R / I`. This is the implication (3) ⇒ (1) of [Stacks, Tag 09PX]. -/
theorem isGeneratedByRegularSequence_and_finiteTorDimension
    {R S : Type u} [CommRing R] [CommRing S]
    [IsNoetherianRing R] [IsNoetherianRing S] [IsLocalRing R] [IsLocalRing S]
    [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (I : Ideal R) (J : Ideal S) (hI : I ≤ IsLocalRing.maximalIdeal R)
    (hIJ : I.map (algebraMap R S) ≤ J)
    (hregI : Ideal.IsGeneratedByRegularSequence I)
    (hregQ : Ideal.IsGeneratedByRegularSequence
      (J.map (Ideal.Quotient.mk (I.map (algebraMap R S))))) :
    Ideal.IsGeneratedByRegularSequence J ∧
      FiniteTorDimension (quotientModule
        (Ideal.quotientMap J (algebraMap R S) ((Ideal.map_le_iff_le_comap).mp hIJ))) := by
  refine ⟨regularSequence_join_ideals (I.map (algebraMap R S)) J hIJ ?_ hregQ,
    finiteTorDimension_quotientModule_of_flat I J hI hIJ hregQ⟩
  obtain ⟨rsI, hrsI, hspanI⟩ := hregI
  have : Module.FaithfullyFlat R S := Module.FaithfullyFlat.of_flat_of_isLocalHom
  refine ⟨rsI.map (algebraMap R S), hrsI.of_faithfullyFlat, ?_⟩
  rw [← Ideal.map_ofList, hspanI]

/-! ### From eventual vanishing of `Tor` to vanishing of a termwise tensor complex

The fibre hypothesis of the descent criterion
`StacksDraft.Perfect.isPerfect_and_torAmplitude_of_flat_local_of_regular_closedFibre` asks for
the vanishing of `H^i(F ⊗ N)` for *every* bounded above flat representative `F`, whereas the
hypothesis available from the source is the vanishing of the categorical `Tor` groups. The two
are matched by resolving `N[0]` and comparing both sides with the derived tensor product.
-/

private theorem bridgeIsZeroDerivedTensorHomology_iff {R : Type u} [CommRing R]
    (E : CochainComplex (ModuleCat.{u} R) ℤ) (hE : E.KFlat)
    (M : ModuleCat.{u} R) (i : ℤ) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).obj
      (((CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R).tensor.obj
        (DerivedCategory.Q.obj E)).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M))) ↔
      IsZero ((StacksDraft.TorAmplitude.tensorComplex E M).homology i) := by
  let T := CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R
  obtain ⟨P, m, π, hPLE, hPproj, hπ⟩ :=
    StacksDraft.TorAmplitude.exists_projective_resolution
      ((CochainComplex.singleFunctor (ModuleCat.{u} R) 0).obj M) 0
  have hPKF : P.KFlat := StacksDraft.TorAmplitude.kFlat_of_isStrictlyLE_projective
    P m hPproj
  have hq : QuasiIso ((tensorLeft E).map π) :=
    StacksDraft.TorAmplitude.quasiIso_tensorLeft_map E hE π
  have : QuasiIsoAt ((tensorLeft E).map π) i := hq.quasiIsoAt i
  let eM : (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M ≅
      DerivedCategory.Q.obj ((CochainComplex.singleFunctor (ModuleCat.{u} R) 0).obj M) :=
    (DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{u} R) 0).app M
  let eP : DerivedCategory.Q.obj P ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M :=
    asIso (DerivedCategory.Q.map π) ≪≫ eM.symm
  let iso := (DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).mapIso
      (((T.tensor.obj (DerivedCategory.Q.obj E)).mapIso eP).symm ≪≫
        T.comparison E P hE hPKF) ≪≫
    (DerivedCategory.homologyFunctorFactors (ModuleCat.{u} R) i).app ((tensorLeft E).obj P) ≪≫
    isoOfQuasiIsoAt ((tensorLeft E).map π) i ≪≫
    ((HomologicalComplex.homologyFunctor (ModuleCat.{u} R) (ComplexShape.up ℤ) i).mapIso
      ((StacksDraft.TorAmplitude.termwiseTensorSingleIso M).app E)).symm
  exact ⟨fun h => h.of_iso iso.symm, fun h => h.of_iso iso⟩

private noncomputable def bridgeTensorRightMixedNatIso {R : Type u} [CommRing R]
    (N : ModuleCat.{u} R) :
    tensorRight N ≅ StacksDraft.TorAmplitude.tensorRightMixed N :=
  NatIso.ofComponents (fun X => Iso.refl ((tensorRight N).obj X)) (by
    intro X Y f
    apply ModuleCat.hom_ext
    ext x
    rfl)

private noncomputable def bridgeTensorLeftMixedIso {R : Type u} [CommRing R]
    (N : ModuleCat.{u} R) (E : CochainComplex (ModuleCat.{u} R) ℤ) :
    ((tensorLeft N).mapHomologicalComplex (ComplexShape.up ℤ)).obj E ≅
      StacksDraft.TorAmplitude.tensorComplex E N :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (BraidedCategory.tensorLeftIsoTensorRight N ≪≫
      bridgeTensorRightMixedNatIso N).app (E.X i))
    (fun i j _ =>
      ((BraidedCategory.tensorLeftIsoTensorRight N ≪≫
        bridgeTensorRightMixedNatIso N).hom.naturality (E.d i j)).symm)

/-- Let `M` be a module whose `Tor` groups against `N` vanish above degree `n`, and let `F` be a
bounded above complex of flat modules representing `M` in degree `0`. Then the termwise tensor
complex `F ⊗ N` has no cohomology below `-n` and none above `0`.

This is the form in which the hypothesis of
`StacksDraft.Perfect.isPerfect_and_torAmplitude_of_flat_local_of_regular_closedFibre` is needed:
that criterion tests every bounded above flat representative, while the source hypothesis of
[Stacks, Tag 09PX] is the eventual vanishing of `Tor`. -/
public theorem isZero_tensorComplex_of_eventualTor {R : Type u} [CommRing R]
    (M N : ModuleCat.{u} R) (n : ℕ)
    (hTor : ∀ p : ℕ, n < p → IsZero (((Tor (ModuleCat.{u} R) p).obj M).obj N))
    (F : CochainComplex (ModuleCat.{u} R) ℤ)
    (hFbd : StacksDraft.TorAmplitude.BoundedAbove F)
    (hFflat : StacksDraft.TorAmplitude.IsComplexOfFlats F)
    (eF : DerivedCategory.Q.obj F ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M)
    (i : ℤ) (hi : i < -(n : ℤ) ∨ 0 < i) :
    IsZero ((StacksDraft.TorAmplitude.tensorComplex F N).homology i) := by
  have hF : F.KFlat := bridgeKFlat_of_boundedAbove_flats F hFbd hFflat
  obtain ⟨P, m, π, hPLE, hPproj, hπ⟩ :=
    StacksDraft.TorAmplitude.exists_projective_resolution
      ((CochainComplex.singleFunctor (ModuleCat.{u} R) 0).obj M) 0
  have hPKF : P.KFlat :=
    StacksDraft.TorAmplitude.kFlat_of_isStrictlyLE_projective P m hPproj
  have : QuasiIso π := hπ
  let eP : DerivedCategory.Q.obj P ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M :=
    asIso (DerivedCategory.Q.map π) ≪≫
      ((DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{u} R) 0).app M).symm
  have hTorInDegree : IsZero (CochainComplex.Tor.TorInDegree R (-i) M N) := by
    rcases hi with hi | hi
    · let p : ℕ := (-i).toNat
      have hpi : (p : ℤ) = -i := Int.toNat_of_nonneg (by omega)
      have hz' : IsZero (CochainComplex.Tor.TorInDegree R (p : ℤ) M N) := by
        unfold CochainComplex.Tor.TorInDegree
        rw [dite_eq_left (show 0 ≤ (p : ℤ) by omega)]
        exact hTor p (by omega)
      simpa only [hpi] using hz'
    · exact bridgeIsZeroTorInDegreeOfNeg (by omega) M N
  have hLeft : IsZero
      ((((tensorLeft N).mapHomologicalComplex (ComplexShape.up ℤ)).obj P).homology i) := by
    simpa using hTorInDegree.of_iso (bridgeTorIsoOfKFlatRepresentative π hPKF N (-i))
  have hDerivedP : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).obj
      (((CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R).tensor.obj
        (DerivedCategory.Q.obj P)).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj N))) :=
    (bridgeIsZeroDerivedTensorHomology_iff P hPKF N i).2 <|
      hLeft.of_iso ((HomologicalComplex.homologyFunctor
        (ModuleCat.{u} R) (ComplexShape.up ℤ) i).mapIso
        (bridgeTensorLeftMixedIso N P)).symm
  let eFP : DerivedCategory.Q.obj F ≅ DerivedCategory.Q.obj P := eF ≪≫ eP.symm
  have hDerivedF : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).obj
      (((CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R).tensor.obj
        (DerivedCategory.Q.obj F)).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj N))) :=
    hDerivedP.of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).mapIso
        (((CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R).tensor.mapIso eFP).app
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj N)))
  exact (bridgeIsZeroDerivedTensorHomology_iff F hF N i).mp hDerivedF

/-- Base change of a flat algebra along a quotient of the base stays flat: if `S` is a flat
`R`-algebra and `I` is an ideal of `R`, then `S / IS` is a flat `R / I`-algebra. -/
public alias flat_quotient_map_of_flat := bridgeFlatQuotientMap

end Stacks.CompleteIntersection

