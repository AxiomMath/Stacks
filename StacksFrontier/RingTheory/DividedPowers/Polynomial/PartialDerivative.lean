module

public import Mathlib.Data.Finsupp.Order
public import Mathlib.LinearAlgebra.Basis.Basic
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.Basic

/-!
# Divided power partial derivative operators

The divided power polynomial algebra `A⟨xᵢ : i ∈ ι⟩`, realized as
`DividedPowerAlgebra A (ι →₀ A)`, is free over `A` on the divided power monomials
`x^[K] = ∏ i, xᵢ^[K i]` indexed by exponent vectors `K : ι →₀ ℕ`. For an exponent vector
`J : ι →₀ ℕ` the iterated divided power partial derivative `∂_J` is the `A`-linear operator
determined on this basis by

`∂_J (x^[K]) = x^[K - J]` if `J ≤ K`, and `∂_J (x^[K]) = 0` otherwise,

where `≤` and `-` on `ι →₀ ℕ` are the pointwise order and pointwise truncated subtraction. For
`J = Finsupp.single i n` this is the `n`-th divided power partial derivative in the variable
`xᵢ`, and a general `J` is the composite of these over the variables in the support of `J`.

## Main definitions

* `DividedPowers.dividedPowerPolynomialPartial` — the operator `∂_J`.

## Main results

* `DividedPowers.dividedPowerPolynomialPartial_monomial` — the defining formula on a divided
  power monomial, together with its two case-split forms
  `DividedPowers.dividedPowerPolynomialPartial_monomial_of_le` and
  `DividedPowers.dividedPowerPolynomialPartial_monomial_of_not_le`.
* `DividedPowers.dividedPowerPolynomialPartial_zero` — `∂_0` is the identity.
* `DividedPowers.dividedPowerPolynomialPartial_add` — the composition law
  `∂_(J + K) = ∂_J ∘ ∂_K`.
* `DividedPowers.dividedPowerPolynomialPartial_apply_zero` and
  `DividedPowers.dividedPowerPolynomialPartial_succ` — the composition law in the recursive
  shape `∂_0 = id`, `∂_(k + single i 1) = ∂_(single i 1) ∘ ∂_k`, which exhibits the family
  `J ↦ ∂_J` as generated by the first order operators `∂_(single i 1)`.
* `DividedPowers.dividedPowerPolynomialPartial_apply_eq_sum` — the value of `∂_J` on an
  arbitrary element, expressed through its coordinates in the monomial basis.

## Implementation notes

The operator is built with `Module.Basis.constr` on
`DividedPowers.dividedPowerPolynomialMonomialBasis`, so no finiteness assumption on the index
type `ι` is needed: an element of the algebra has finitely many nonzero coordinates even when
there are infinitely many variables. The pointwise order on `ι →₀ ℕ` is decidable without
any decidability assumption on `ι`.
-/

@[expose] public section

noncomputable section

namespace DividedPowers

universe u w

/-- In a finitely supported family of natural numbers, `J + K ≤ L` holds exactly when `K ≤ L`
and `J` is below the truncated difference `L - K`. -/
private theorem natFinsupp_add_le_iff_le_tsub {ι : Type w} (J K L : ι →₀ ℕ) :
    J + K ≤ L ↔ K ≤ L ∧ J ≤ L - K := by
  simp only [Finsupp.le_def, Finsupp.add_apply, Finsupp.tsub_apply, ← forall_and]
  exact forall_congr' fun _ ↦ by lia

variable (A : Type u) [CommRing A] (ι : Type w)

/-- The iterated divided power partial derivative `∂_J` on the divided power polynomial algebra
`A⟨xᵢ : i ∈ ι⟩`, the `A`-linear operator sending the divided power monomial `x^[K]` to
`x^[K - J]` when `J ≤ K` and to `0` otherwise. -/
public def dividedPowerPolynomialPartial (J : ι →₀ ℕ) :
    DividedPowerAlgebra A (ι →₀ A) →ₗ[A] DividedPowerAlgebra A (ι →₀ A) :=
  (dividedPowerPolynomialMonomialBasis A ι).constr A
    fun K ↦ if J ≤ K then dividedPowerPolynomialMonomial A (K - J) else 0

/-- The defining formula: `∂_J` sends the divided power monomial `x^[K]` to `x^[K - J]` when
`J ≤ K` and to `0` otherwise. -/
public theorem dividedPowerPolynomialPartial_monomial (J K : ι →₀ ℕ) :
    dividedPowerPolynomialPartial A ι J (dividedPowerPolynomialMonomial A K) =
      if J ≤ K then dividedPowerPolynomialMonomial A (K - J) else 0 := by
  rw [← dividedPowerPolynomialMonomialBasis_apply, dividedPowerPolynomialPartial,
    Module.Basis.constr_basis]

/-- When `J ≤ K`, the operator `∂_J` sends the divided power monomial `x^[K]` to the divided
power monomial `x^[K - J]`. -/
public theorem dividedPowerPolynomialPartial_monomial_of_le {J K : ι →₀ ℕ} (h : J ≤ K) :
    dividedPowerPolynomialPartial A ι J (dividedPowerPolynomialMonomial A K) =
      dividedPowerPolynomialMonomial A (K - J) := by
  rw [dividedPowerPolynomialPartial_monomial, ite_eq_left h]

/-- When `J ≤ K` fails, the operator `∂_J` annihilates the divided power monomial `x^[K]`. -/
public theorem dividedPowerPolynomialPartial_monomial_of_not_le {J K : ι →₀ ℕ} (h : ¬J ≤ K) :
    dividedPowerPolynomialPartial A ι J (dividedPowerPolynomialMonomial A K) = 0 := by
  rw [dividedPowerPolynomialPartial_monomial, ite_eq_right h]

/-- The partial derivative attached to the zero exponent vector is the identity. -/
@[simp]
public theorem dividedPowerPolynomialPartial_zero :
    dividedPowerPolynomialPartial A ι 0 = LinearMap.id := by
  refine (dividedPowerPolynomialMonomialBasis A ι).ext fun K ↦ ?_
  rw [dividedPowerPolynomialMonomialBasis_apply, dividedPowerPolynomialPartial_monomial,
    ite_eq_left (zero_le : (0 : ι →₀ ℕ) ≤ K), tsub_zero, LinearMap.id_apply]

/-- The composition law for the divided power partial derivatives: `∂_(J + K) = ∂_J ∘ ∂_K`. -/
public theorem dividedPowerPolynomialPartial_add (J K : ι →₀ ℕ) :
    dividedPowerPolynomialPartial A ι (J + K) =
      (dividedPowerPolynomialPartial A ι J).comp (dividedPowerPolynomialPartial A ι K) := by
  refine (dividedPowerPolynomialMonomialBasis A ι).ext fun L ↦ ?_
  rw [dividedPowerPolynomialMonomialBasis_apply, LinearMap.comp_apply,
    dividedPowerPolynomialPartial_monomial, dividedPowerPolynomialPartial_monomial]
  have hiff := natFinsupp_add_le_iff_le_tsub J K L
  by_cases hK : K ≤ L
  · rw [ite_eq_left hK, dividedPowerPolynomialPartial_monomial, tsub_tsub]
    by_cases hJ : J ≤ L - K
    · rw [ite_eq_left hJ, ite_eq_left (hiff.2 ⟨hK, hJ⟩), add_comm K J]
    · rw [ite_eq_right hJ, ite_eq_right fun h ↦ hJ (hiff.1 h).2]
  · rw [ite_eq_right hK, map_zero, ite_eq_right fun h ↦ hK (hiff.1 h).1]

/-- The partial derivative attached to the zero exponent vector is the identity function. -/
public theorem dividedPowerPolynomialPartial_apply_zero :
    ⇑(dividedPowerPolynomialPartial A ι 0) = id := by
  rw [dividedPowerPolynomialPartial_zero, LinearMap.id_coe]

/-- Adjoining one unit to the exponent vector in the variable `xᵢ` composes with the first order
partial derivative in `xᵢ`: `∂_(k + single i 1) = ∂_(single i 1) ∘ ∂_k`. -/
public theorem dividedPowerPolynomialPartial_succ (i : ι) (k : ι →₀ ℕ) :
    ⇑(dividedPowerPolynomialPartial A ι (k + Finsupp.single i 1)) =
      ⇑(dividedPowerPolynomialPartial A ι (Finsupp.single i 1)) ∘
        ⇑(dividedPowerPolynomialPartial A ι k) := by
  rw [add_comm, dividedPowerPolynomialPartial_add, LinearMap.coe_comp]

/-- The value of `∂_J` on an arbitrary element of the divided power polynomial algebra, read off
from its coordinates in the basis of divided power monomials. -/
public theorem dividedPowerPolynomialPartial_apply_eq_sum (J : ι →₀ ℕ)
    (a : DividedPowerAlgebra A (ι →₀ A)) :
    dividedPowerPolynomialPartial A ι J a =
      ∑ K ∈ ((dividedPowerPolynomialMonomialBasis A ι).repr a).support,
        ((dividedPowerPolynomialMonomialBasis A ι).repr a K) •
          (if J ≤ K then dividedPowerPolynomialMonomial A (K - J) else 0) := by
  rw [dividedPowerPolynomialPartial, Module.Basis.constr_apply]
  rfl

end DividedPowers

end

end
