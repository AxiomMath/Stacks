private theorem map_inf_ker_eq_mul_of_leftInverse
    {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (g : S →+* R) (h : Function.LeftInverse g f)
    (I : Ideal R) : I.map f ⊓ RingHom.ker g = I.map f * RingHom.ker g := by
  let K := I.map f
  let P := RingHom.ker g
  have hstep (x : S) (hx : x ∈ K) :
      g x ∈ I ∧ x - f (g x) ∈ K * P := by
    change x ∈ Ideal.span (f '' (I : Set R)) at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact ⟨by rwa [h a], by rw [h a, sub_self]; exact (K * P).zero_mem⟩
    | zero => simp
    | add x y _ _ hx hy =>
      refine ⟨by simpa only [map_add] using I.add_mem hx.1 hy.1, ?_⟩
      simpa only [map_add, sub_add_sub_comm] using (K * P).add_mem hx.2 hy.2
    | smul a x _ hx =>
      simp only [smul_eq_mul]
      constructor
      · rw [map_mul]
        exact I.mul_mem_left (g a) hx.1
      · have haP : a - f (g a) ∈ P := by
          show g (a - f (g a)) = 0
          rw [map_sub, h (g a), sub_self]
        have hfxK : f (g x) ∈ K := Ideal.mem_map_of_mem f hx.1
        have hprod : f (g x) * (a - f (g a)) ∈ K * P :=
          Ideal.mul_mem_mul hfxK haP
        have hmul : a * (x - f (g x)) ∈ K * P :=
          (K * P).mul_mem_left a hx.2
        have heq : a * x - f (g (a * x)) =
            a * (x - f (g x)) + f (g x) * (a - f (g a)) := by
          rw [map_mul, map_mul]
          ring
        rw [heq]
        exact (K * P).add_mem hmul hprod
  apply le_antisymm
  · intro x hx
    have hh := hstep x hx.1
    have hg : g x = 0 := hx.2
    simpa [hg] using hh.2
  · exact Ideal.mul_le_inf

