attribute [local instance 2000] Algebra.toModule in
private def integralTensorIncludeLeft
    (R : Type*) [CommRing R] [Algebra ℤ R] (ι : Type w) :
    @RingHom (integralPositiveDividedPowerRing ι)
      (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R)
