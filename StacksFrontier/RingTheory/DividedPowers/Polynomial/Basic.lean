    (inferInstance : CommRing
      (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R)).toCommSemiring.toNonAssocSemiring
  exact { toFun := g
          map_one' := by exact map_one g
          map_mul' := by intro x y; exact map_mul g x y
          map_zero' := by exact map_zero g
          map_add' := by intro x y; exact map_add g x y }

attribute [local instance 2000] Algebra.toModule in
private theorem integralTensorIncludeLeft_flat
    (R : Type*) [CommRing R] [Algebra ℤ R] [Module.Flat ℤ R]
    (ι : Type w) : (integralTensorIncludeLeft R ι).Flat := by
  let : Algebra (integralPositiveDividedPowerRing ι)
      (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R) :=
    (integralTensorIncludeLeft R ι).toAlgebra
  show Module.Flat (integralPositiveDividedPowerRing ι)
    (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R)
  let e : @RingHom (integralPositiveDividedPowerRing ι)
      (DividedPowerAlgebra ℤ (ι →₀ ℤ))
      CommRing.toCommSemiring.toNonAssocSemiring
      CommRing.toCommSemiring.toNonAssocSemiring :=
    { toFun := id
      map_one' := rfl
      map_mul' := by intros; rfl
      map_zero' := rfl
      map_add' := by intros; rfl }
  let : Algebra (integralPositiveDividedPowerRing ι)
      (DividedPowerAlgebra ℤ (ι →₀ ℤ)) := e.toAlgebra
  have hmod : (TensorProduct.leftModule : Module (integralPositiveDividedPowerRing ι)
      (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R)) =
      (Algebra.toModule : Module (integralPositiveDividedPowerRing ι)
        (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R)) := by
    apply Module.ext'
    intro a x
    induction x using TensorProduct.induction_on with
    | zero =>
        show (0 : TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R) =
          (integralTensorIncludeLeft R ι a) * 0
        simp
    | tmul x y =>
        show (e a * x) ⊗ₜ[ℤ] y =
          ((e a) ⊗ₜ[ℤ] (1 : R)) * (x ⊗ₜ[ℤ] y)
        simp
    | add x y hx hy =>
        change a • x = (integralTensorIncludeLeft R ι a) * x at hx
        change a • y = (integralTensorIncludeLeft R ι a) * y at hy
        show a • (x + y) = (integralTensorIncludeLeft R ι a) * (x + y)
        simpa [smul_add, mul_add] using congrArg₂ (· + ·) hx hy
  rw [← hmod]
  exact Module.Flat.baseChange ℤ (integralPositiveDividedPowerRing ι) R

