      CommRing.toCommSemiring.toNonAssocSemiring := by
  let g := (Algebra.TensorProduct.includeLeft :
    DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
      TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) R).toRingHom
