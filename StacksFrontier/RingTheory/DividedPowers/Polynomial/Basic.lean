attribute [local instance 2000] Algebra.toModule in
private theorem coefficientTensorPositiveDividedPowers_dpow_variable
    (A : Type u) [CommRing A] (ι : Type w) (i : ι) (n : ℕ) :
    (coefficientTensorPositiveDividedPowers A ι).dpow n
      ((Algebra.TensorProduct.includeLeft :
        DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
          TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
        (dividedPowerPolynomialVariable ℤ i)) =
    (Algebra.TensorProduct.includeLeft :
      DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
        TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
      (dividedPowerPolynomialVariableMonomial ℤ i n) := by
  let : Module.Flat ℤ (MvPolynomial A ℤ) :=
    RingHom.flat_algebraMap_iff.mp (coefficientPresentationRing_flat A)
  let f := Algebra.TensorProduct.map
    (AlgHom.id ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)))
    (MvPolynomial.aeval (fun a : A ↦ a) : MvPolynomial A ℤ →ₐ[ℤ] A)
  let v := (Algebra.TensorProduct.includeLeft :
    DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
      TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) (MvPolynomial A ℤ))
  have hv : v (dividedPowerPolynomialVariable ℤ i) ∈
      (dividedPowerPolynomialPositiveIdeal ℤ ι).map v :=
    Ideal.mem_map_of_mem v (variable_mem_positiveIdeal ℤ i)
  have hm : _root_.DividedPowers.IsDPMorphism
      (integralPositiveDividedPowersTensor (MvPolynomial A ℤ) ι)
      (coefficientTensorPositiveDividedPowers A ι) f := by
    unfold coefficientTensorPositiveDividedPowers
    exact _root_.DividedPowers.Quotient.OfSurjective.isDPMorphism
      (integralPositiveDividedPowersTensor (MvPolynomial A ℤ) ι)
      (integralTensorCoefficientPresentation_surjective A ι)
      rfl (integralTensorCoefficientKernel_isSubDPIdeal A ι)
  have hd := hm.dpow_comp (v (dividedPowerPolynomialVariable ℤ i)) hv (n := n)
  rw [integralPositiveDividedPowersTensor_dpow_variable] at hd
  simpa [f, v, Algebra.TensorProduct.map_tmul] using hd

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorDividedPowerAlgebraLift_variableMonomial_eq
    (A : Type u) [CommRing A] (ι : Type w) (i : ι) (n : ℕ) :
    coefficientTensorDividedPowerAlgebraLift A ι
      (dividedPowerPolynomialVariableMonomial A i n) =
    (Algebra.TensorProduct.includeLeft :
      DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
        TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
      (dividedPowerPolynomialVariableMonomial ℤ i n) := by
  rw [coefficientTensorDividedPowerAlgebraLift_variableMonomial,
    coefficientTensorPositiveDividedPowers_dpow_variable]

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorDividedPowerAlgebraLift_monomial
    (A : Type u) [CommRing A] (ι : Type w) (n : ι →₀ ℕ) :
    coefficientTensorDividedPowerAlgebraLift A ι
      (dividedPowerPolynomialMonomial A n) =
    (Algebra.TensorProduct.includeLeft :
      DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
        TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
      (dividedPowerPolynomialMonomial ℤ n) := by
  classical
  simp only [dividedPowerPolynomialMonomial, map_finsuppProd]
  exact Finsupp.prod_congr fun i _ ↦
    coefficientTensorDividedPowerAlgebraLift_variableMonomial_eq A ι i (n i)

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private noncomputable def coefficientTensorToDividedPowerAlgebra
    (A : Type u) [CommRing A] (ι : Type w) :
    TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A →ₐ[A]
      DividedPowerAlgebra A (ι →₀ A) :=
  (scalarExtensionToCoefficientDividedPowerAlgebra A ι).comp
    (Algebra.TensorProduct.commRight ℤ A
      (DividedPowerAlgebra ℤ (ι →₀ ℤ))).symm.toAlgHom

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorToDividedPowerAlgebra_monomial
    (A : Type u) [CommRing A] (ι : Type w) (n : ι →₀ ℕ) :
    coefficientTensorToDividedPowerAlgebra A ι
      ((Algebra.TensorProduct.includeLeft :
        DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
          TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
        (dividedPowerPolynomialMonomial ℤ n)) =
      dividedPowerPolynomialMonomial A n := by
  simp [coefficientTensorToDividedPowerAlgebra,
    scalarExtensionToCoefficientDividedPowerAlgebra_tmul,
    integralToCoefficientDividedPowerAlgebra_monomial]

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private noncomputable def coefficientTensorBasis (A : Type u) [CommRing A]
    (ι : Type w) : Module.Basis (ι →₀ ℕ) A
      (TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A) :=
  ((integralMonomialBasis ι).baseChange A).map
    (Algebra.TensorProduct.commRight ℤ A
      (DividedPowerAlgebra ℤ (ι →₀ ℤ))).toLinearEquiv

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorBasis_apply (A : Type u) [CommRing A]
    (ι : Type w) (n : ι →₀ ℕ) :
    coefficientTensorBasis A ι n =
      (Algebra.TensorProduct.includeLeft :
        DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
          TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
        (dividedPowerPolynomialMonomial ℤ n) := by
  simp [coefficientTensorBasis, Module.Basis.baseChange_apply,
    integralMonomialBasis_apply]

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorToDividedPowerAlgebra_comp_lift
    (A : Type u) [CommRing A] (ι : Type w)
    (x : DividedPowerAlgebra A (ι →₀ A)) :
    coefficientTensorToDividedPowerAlgebra A ι
      (coefficientTensorDividedPowerAlgebraLift A ι x) = x := by
  let F := (coefficientTensorToDividedPowerAlgebra A ι).comp
    (coefficientTensorDividedPowerAlgebraLift A ι)
  have h : F.toLinearMap = LinearMap.id := by
    refine LinearMap.ext_on_range (monomial_span_eq_top A ι) fun n ↦ ?_
    show F (dividedPowerPolynomialMonomial A n) = dividedPowerPolynomialMonomial A n
    dsimp [F]
    rw [coefficientTensorDividedPowerAlgebraLift_monomial]
    exact coefficientTensorToDividedPowerAlgebra_monomial A ι n
  exact LinearMap.congr_fun h x

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorDividedPowerAlgebraLift_comp
    (A : Type u) [CommRing A] (ι : Type w)
    (y : TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A) :
    coefficientTensorDividedPowerAlgebraLift A ι
      (coefficientTensorToDividedPowerAlgebra A ι y) = y := by
  let F := (coefficientTensorDividedPowerAlgebraLift A ι).comp
    (coefficientTensorToDividedPowerAlgebra A ι)
  have h : F.toLinearMap = LinearMap.id := by
    refine LinearMap.ext_on_range (coefficientTensorBasis A ι).span_eq fun n ↦ ?_
    show F (coefficientTensorBasis A ι n) = coefficientTensorBasis A ι n
    dsimp [F]
    rw [coefficientTensorBasis_apply,
      coefficientTensorToDividedPowerAlgebra_monomial,
      coefficientTensorDividedPowerAlgebraLift_monomial]
  exact LinearMap.congr_fun h y

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private noncomputable def coefficientTensorDividedPowerAlgebraEquiv
    (A : Type u) [CommRing A] (ι : Type w) :
    TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A ≃ₐ[A]
      DividedPowerAlgebra A (ι →₀ A) :=
  AlgEquiv.ofAlgHom
    (coefficientTensorToDividedPowerAlgebra A ι)
    (coefficientTensorDividedPowerAlgebraLift A ι)
    (by apply DFunLike.ext; intro x
        exact coefficientTensorToDividedPowerAlgebra_comp_lift A ι x)
    (by apply DFunLike.ext; intro x
        exact coefficientTensorDividedPowerAlgebraLift_comp A ι x)

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The divided power monomials are linearly independent over the coefficient ring. -/
public theorem monomial_linearIndependent (A : Type u) [CommRing A]
    (ι : Type w) :
    LinearIndependent A (dividedPowerPolynomialMonomial A (ι := ι)) := by
  have h : LinearIndependent A (fun n : ι →₀ ℕ ↦
      coefficientTensorDividedPowerAlgebraLift A ι
        (dividedPowerPolynomialMonomial A n)) := by
    simpa only [coefficientTensorDividedPowerAlgebraLift_monomial,
      ← coefficientTensorBasis_apply] using
      (coefficientTensorBasis A ι).linearIndependent
  exact LinearIndependent.of_comp
    (coefficientTensorDividedPowerAlgebraLift A ι).toLinearMap h

/-- The divided power monomials form the basis used in the direct-sum definition of the divided
power polynomial algebra. -/
public noncomputable def dividedPowerPolynomialMonomialBasis (A : Type u) [CommRing A]
    (ι : Type w) : Module.Basis (ι →₀ ℕ) A (DividedPowerAlgebra A (ι →₀ A)) :=
  Module.Basis.mk (v := dividedPowerPolynomialMonomial A (ι := ι))
    (by exact monomial_linearIndependent A ι) (by rw [monomial_span_eq_top])

/-- The basis vector indexed by an exponent vector is the corresponding divided power
monomial. -/
public theorem dividedPowerPolynomialMonomialBasis_apply (A : Type u) [CommRing A]
    {ι : Type w} (n : ι →₀ ℕ) :
    dividedPowerPolynomialMonomialBasis A ι n = dividedPowerPolynomialMonomial A n := by
  unfold dividedPowerPolynomialMonomialBasis
  exact Module.Basis.mk_apply _ _ n

private theorem coefficientIdeal_inf_positiveIdeal_eq_mul (A : DividedPowerRing.{u})
    (ι : Type w) :
    Ideal.map (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) A.ideal ⊓
        dividedPowerPolynomialPositiveIdeal A ι =
      Ideal.map (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) A.ideal *
        dividedPowerPolynomialPositiveIdeal A ι := by
  apply map_inf_ker_eq_mul_of_leftInverse
  intro a
  simp [dividedPowerPolynomialAugmentation]

/-- The coefficient map `A → A⟨xᵢ : i ∈ ι⟩` is flat, the algebra being free on the divided power
monomials. -/
public theorem coefficient_flat (A : Type u) [CommRing A] (ι : Type w) :
    (algebraMap A (DividedPowerAlgebra A (ι →₀ A))).Flat := by
  let : Module.Free A (DividedPowerAlgebra A (ι →₀ A)) :=
    Module.Free.of_basis (dividedPowerPolynomialMonomialBasis A ι)
  exact RingHom.flat_algebraMap_iff.mpr inferInstance

private noncomputable def coefficientDividedPowers (A : DividedPowerRing.{u})
    (ι : Type w) :
    _root_.DividedPowers (Ideal.map (algebraMap A
      (DividedPowerAlgebra A (ι →₀ A))) A.ideal) :=
  DividedPowerRing.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat
    A (algebraMap A (DividedPowerAlgebra A (ι →₀ A)))
    (Or.inr (Or.inr (coefficient_flat A ι)))

private theorem coefficientDividedPowers_isDPMorphism (A : DividedPowerRing.{u})
    (ι : Type w) :
    _root_.DividedPowers.IsDPMorphism A.dividedPowers (coefficientDividedPowers A ι)
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) :=
  DividedPowerRing.isDPMorphism_extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat
    A (algebraMap A (DividedPowerAlgebra A (ι →₀ A)))
    (Or.inr (Or.inr (coefficient_flat A ι)))

private theorem polynomialDividedPowers_of_positive (A : DividedPowerRing.{u})
    (ι : Type w) (δplus : _root_.DividedPowers (dividedPowerPolynomialPositiveIdeal A ι))
    (hplus : ∀ (i : ι) (n : ℕ),
      δplus.dpow n (dividedPowerPolynomialVariable A i) =
        dividedPowerPolynomialVariableMonomial A i n) :
    ∃ δ : _root_.DividedPowers (dividedPowerPolynomialIdeal A.ideal ι),
      (∀ (i : ι) (n : ℕ), δ.dpow n (dividedPowerPolynomialVariable A i) =
        dividedPowerPolynomialVariableMonomial A i n) ∧
      _root_.DividedPowers.IsDPMorphism A.dividedPowers δ
        (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) := by
  let γcoeff := coefficientDividedPowers A ι
  have hmatch (n : ℕ) {x : DividedPowerAlgebra A (ι →₀ A)}
      (hx : x ∈ Ideal.map (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) A.ideal ⊓
        dividedPowerPolynomialPositiveIdeal A ι) :
      γcoeff.dpow n x = δplus.dpow n x := by
    rw [coefficientIdeal_inf_positiveIdeal_eq_mul] at hx
    exact _root_.DividedPowers.coincide_on_smul γcoeff δplus hx
  obtain ⟨δ, hδ, _⟩ :=
    existsUnique_on_ideal_add γcoeff δplus hmatch
  refine ⟨δ, ?_, ?_⟩
  · intro i n
    rw [hδ.2 n (variable_mem_positiveIdeal A i), hplus i n]
  · have hc := coefficientDividedPowers_isDPMorphism A ι
    refine ⟨hc.ideal_comp.trans le_sup_left, fun {n} a ha ↦ ?_⟩
    rw [hδ.1 n (Ideal.mem_map_of_mem _ ha)]
    exact hc.dpow_comp a ha

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorToDividedPowerAlgebra_variableMonomial
    (A : Type u) [CommRing A] (ι : Type w) (i : ι) (n : ℕ) :
    coefficientTensorDividedPowerAlgebraEquiv A ι
      ((Algebra.TensorProduct.includeLeft :
        DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
          TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
        (dividedPowerPolynomialVariableMonomial ℤ i n)) =
      dividedPowerPolynomialVariableMonomial A i n := by
  rw [← coefficientTensorDividedPowerAlgebraLift_variableMonomial_eq]
  exact coefficientTensorToDividedPowerAlgebra_comp_lift A ι _

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientTensorPositiveIdeal_equiv
    (A : Type u) [CommRing A] (ι : Type w) :
    Ideal.map (coefficientTensorDividedPowerAlgebraEquiv A ι).toRingEquiv
      (((dividedPowerPolynomialPositiveIdeal ℤ ι).map
        (Algebra.TensorProduct.includeLeft :
          DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
            TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) (MvPolynomial A ℤ))).map
        (Algebra.TensorProduct.map
          (AlgHom.id ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)))
          (MvPolynomial.aeval (fun a : A ↦ a) : MvPolynomial A ℤ →ₐ[ℤ] A))) =
      dividedPowerPolynomialPositiveIdeal A ι := by
  classical
  rw [positiveIdeal_eq_span_variableMonomials ℤ ι,
    Ideal.map_span, Ideal.map_span, Ideal.map_span,
    positiveIdeal_eq_span_variableMonomials A ι]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨z, ⟨t, ⟨i, n, hn, rfl⟩, rfl⟩, rfl⟩, rfl⟩
    refine ⟨i, n, hn, ?_⟩
    simpa [Algebra.TensorProduct.map_tmul] using
      (coefficientTensorToDividedPowerAlgebra_variableMonomial A ι i n)
  · rintro ⟨i, n, hn, rfl⟩
    refine ⟨_, ⟨_, ⟨dividedPowerPolynomialVariableMonomial ℤ i n,
      ⟨i, n, hn, rfl⟩, rfl⟩, rfl⟩, ?_⟩
    simpa [Algebra.TensorProduct.map_tmul] using
      (coefficientTensorToDividedPowerAlgebra_variableMonomial A ι i n)

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private noncomputable def coefficientPositiveDividedPowers
    (A : Type u) [CommRing A] (ι : Type w) :
    _root_.DividedPowers (dividedPowerPolynomialPositiveIdeal A ι) :=
  _root_.DividedPowers.ofRingEquiv (coefficientTensorPositiveIdeal_equiv A ι)
    (coefficientTensorPositiveDividedPowers A ι)

attribute [local instance 2000] Algebra.toModule in
attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem coefficientPositiveDividedPowers_dpow_variable
    (A : Type u) [CommRing A] (ι : Type w) (i : ι) (n : ℕ) :
    (coefficientPositiveDividedPowers A ι).dpow n
      (dividedPowerPolynomialVariable A i) =
      dividedPowerPolynomialVariableMonomial A i n := by
  have hvar := coefficientTensorToDividedPowerAlgebra_variableMonomial A ι i 1
  have hdp := coefficientTensorPositiveDividedPowers_dpow_variable A ι i n
  rw [show dividedPowerPolynomialVariable A i =
      dividedPowerPolynomialVariableMonomial A i 1 from rfl]
  rw [← hvar, show dividedPowerPolynomialVariableMonomial ℤ i 1 =
    dividedPowerPolynomialVariable ℤ i from rfl]
  unfold coefficientPositiveDividedPowers
  rw [_root_.DividedPowers.ofRingEquiv_dpow]
  show (coefficientTensorDividedPowerAlgebraEquiv A ι)
    ((coefficientTensorPositiveDividedPowers A ι).dpow n
      ((coefficientTensorDividedPowerAlgebraEquiv A ι).symm
        ((coefficientTensorDividedPowerAlgebraEquiv A ι)
          ((Algebra.TensorProduct.includeLeft :
            DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
              TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
            (dividedPowerPolynomialVariable ℤ i))))) = _
  rw [AlgEquiv.symm_apply_apply, hdp]
  exact coefficientTensorToDividedPowerAlgebra_variableMonomial A ι i n

/-- Existence of a divided power structure on the divided power ideal of a finite-variable
divided power polynomial algebra which sends `xᵢ` to `xᵢ^[n]` and makes the coefficient map a
divided power morphism. -/
public theorem dividedPowerPolynomialDividedPowers_exists
    (A : DividedPowerRing.{u}) (ι : Type w) [Finite ι] :
    ∃ δ : _root_.DividedPowers (dividedPowerPolynomialIdeal A.ideal ι),
      (∀ (i : ι) (n : ℕ), δ.dpow n (dividedPowerPolynomialVariable A i) =
        dividedPowerPolynomialVariableMonomial A i n) ∧
      _root_.DividedPowers.IsDPMorphism A.dividedPowers δ
        (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) :=
  polynomialDividedPowers_of_positive A ι
    (coefficientPositiveDividedPowers A ι)
    (coefficientPositiveDividedPowers_dpow_variable A ι)

/-- The canonical divided power structure on the divided power ideal of a finite-variable
divided power polynomial algebra. -/
@[stacks 07H5 "divided power structure"]
public noncomputable def dividedPowerPolynomialDividedPowers (A : DividedPowerRing.{u})
    (ι : Type w) [Finite ι] : _root_.DividedPowers (dividedPowerPolynomialIdeal A.ideal ι) :=
  by exact (dividedPowerPolynomialDividedPowers_exists A ι).choose

/-- The divided power ring obtained by adjoining the finite family of divided power variables
indexed by `ι`. -/
public noncomputable def dividedPowerPolynomialDividedPowerRing (A : DividedPowerRing.{u})
    (ι : Type w) [Finite ι] : DividedPowerRing.{max u w} :=
  .of (DividedPowerAlgebra A (ι →₀ A)) (dividedPowerPolynomialIdeal A.ideal ι)
    (dividedPowerPolynomialDividedPowers A ι)

/-- The canonical divided powers send `xᵢ` to the distinguished monomial `xᵢ^[n]`. -/
@[stacks 07H5 "value on variables"]
public theorem dividedPowerPolynomialDividedPowers_dpow_variable
    (A : DividedPowerRing.{u}) (ι : Type w) [Finite ι] (i : ι) (n : ℕ) :
    (dividedPowerPolynomialDividedPowers A ι).dpow n
        (dividedPowerPolynomialVariable A i) =
      dividedPowerPolynomialVariableMonomial A i n :=
  by exact (dividedPowerPolynomialDividedPowers_exists A ι).choose_spec.1 i n

/-- The coefficient map into the divided power polynomial algebra is a morphism of divided
power rings. -/
@[stacks 07H5 "coefficient morphism"]
public theorem dividedPowerPolynomialCoefficient_isDPMorphism
    (A : DividedPowerRing.{u}) (ι : Type w) [Finite ι] :
    _root_.DividedPowers.IsDPMorphism A.dividedPowers
      (dividedPowerPolynomialDividedPowers A ι)
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) :=
  by exact (dividedPowerPolynomialDividedPowers_exists A ι).choose_spec.2

/-- The coefficient morphism into the divided power polynomial algebra. -/
public def dividedPowerPolynomialCoefficientDPMorphism (A : DividedPowerRing.{u})
    (ι : Type w) [Finite ι] :
    _root_.DividedPowers.DPMorphism A.dividedPowers
      (dividedPowerPolynomialDividedPowers A ι) :=
  _root_.DividedPowers.DPMorphism.mk' (dividedPowerPolynomialCoefficient_isDPMorphism A ι)

/-- The canonical structure is the unique divided power structure which has the prescribed
values on variables and makes the coefficient map a divided power morphism. -/
@[stacks 07H5 "uniqueness"]
public theorem dividedPowerPolynomialDividedPowers_unique
    (A : DividedPowerRing.{u}) (ι : Type w) [Finite ι]
    (δ : _root_.DividedPowers (dividedPowerPolynomialIdeal A.ideal ι))
    (hvar : ∀ (i : ι) (n : ℕ),
      δ.dpow n (dividedPowerPolynomialVariable A i) =
        dividedPowerPolynomialVariableMonomial A i n)
    (hcoeff : _root_.DividedPowers.IsDPMorphism A.dividedPowers δ
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A)))) :
    δ = dividedPowerPolynomialDividedPowers A ι := by
  let ε := dividedPowerPolynomialDividedPowers A ι
  let E := _root_.DividedPowers.dpEqualizer ε δ
  have hv (i : ι) : dividedPowerPolynomialVariable A i ∈ E := by
    rw [_root_.DividedPowers.mem_dpEqualizer_iff]
    refine ⟨variable_mem_polynomialIdeal A i, fun n ↦ ?_⟩
    exact (dividedPowerPolynomialDividedPowers_dpow_variable A ι i n).trans
      (hvar i n).symm
  have hc {a : A} (ha : a ∈ A.ideal) :
      algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a ∈ E := by
    rw [_root_.DividedPowers.mem_dpEqualizer_iff]
    refine ⟨coefficient_mem_polynomialIdeal A ha, fun n ↦ ?_⟩
    rw [dividedPowerPolynomialCoefficient_isDPMorphism A ι |>.dpow_comp a ha,
      hcoeff.dpow_comp a ha]
  have hE : dividedPowerPolynomialIdeal A.ideal ι ≤ E :=
    polynomialIdeal_le_of_mem A ι E (fun _ ha ↦ hc ha) fun i m hm ↦ by
      have h := (_root_.DividedPowers.dpEqualizer_is_dp_ideal_left ε δ).dpow_mem
        m hm (hv i)
      simpa [ε, dividedPowerPolynomialDividedPowers_dpow_variable] using h
  exact _root_.DividedPowers.ext δ ε fun n x hx ↦
    (((_root_.DividedPowers.mem_dpEqualizer_iff ε δ).mp (hE hx)).2 n).symm

private theorem ideal_from_ringHom_isSubDPIdeal
    {R S : Type*} [CommRing R] [CommRing S] {I : Ideal R} {J : Ideal S}
    (γ : _root_.DividedPowers I) (ε : _root_.DividedPowers J) (f : R →+* S)
    (hf : I.map f ≤ J) :
    _root_.DividedPowers.IsSubDPIdeal γ (_root_.DividedPowers.ideal_from_ringHom γ ε hf) := by
  refine ⟨fun _ hx ↦ hx.1, fun n hn x hx ↦ ?_⟩
  refine ⟨γ.dpow_mem hn hx.1, fun m ↦ ?_⟩
  rw [γ.dpow_comp hn hx.1, map_mul, map_natCast, hx.2 (m * n),
    hx.2 n, ε.dpow_comp hn (hf (Ideal.mem_map_of_mem f hx.1))]

private noncomputable def polynomialLift (A : DividedPowerRing.{u})
    {ι : Type w} (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) : DividedPowerAlgebra A (ι →₀ A) →+* C := by
  let : Algebra A C := f.toRingHom.toAlgebra
  let g : (ι →₀ A) →ₗ[A] C := Finsupp.linearCombination A (fun i ↦ (k i : C))
  have hg (m : ι →₀ A) : g m ∈ C.ideal := by
    classical
    change m.sum (fun i a ↦ a • (k i : C)) ∈ C.ideal
    exact Submodule.sum_mem _ fun i _ ↦ Submodule.smul_of_tower_mem C.ideal _ (k i).property
  exact (DividedPowerAlgebra.lift C.dividedPowers g hg).toRingHom

private theorem polynomialLift_coeff (A : DividedPowerRing.{u})
    {ι : Type w} (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) (a : A) :
    polynomialLift A C f k (algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a) = f a := by
  simp [polynomialLift, RingHom.algebraMap_toAlgebra]

private theorem polynomialLift_variableMonomial (A : DividedPowerRing.{u})
    {ι : Type w} (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) (i : ι) (n : ℕ) :
    polynomialLift A C f k (dividedPowerPolynomialVariableMonomial A i n) =
      C.dividedPowers.dpow n (k i) := by
  classical
  let : Algebra A C := f.toRingHom.toAlgebra
  simp [polynomialLift, dividedPowerPolynomialVariableMonomial,
    Finsupp.linearCombination_apply]

private theorem polynomialLift_ideal_comp (A : DividedPowerRing.{u})
    {ι : Type w} (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) :
    (dividedPowerPolynomialIdeal A.ideal ι).map (polynomialLift A C f k) ≤ C.ideal := by
  classical
  rw [Ideal.map_le_iff_le_comap]
  refine polynomialIdeal_le_of_mem A ι _ (fun a ha ↦ ?_) fun i m hm ↦ ?_
  · show polynomialLift A C f k
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a) ∈ C.ideal
    rw [polynomialLift_coeff]
    exact f.ideal_comp (Ideal.mem_map_of_mem f.toRingHom ha)
  · show polynomialLift A C f k
      (dividedPowerPolynomialVariableMonomial A i m) ∈ C.ideal
    rw [polynomialLift_variableMonomial]
    exact C.dividedPowers.dpow_mem hm (k i).property

private theorem polynomialLift_variable (A : DividedPowerRing.{u})
    {ι : Type w} (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) (i : ι) :
    polynomialLift A C f k (dividedPowerPolynomialVariable A i) = k i := by
  simpa only [dividedPowerPolynomialVariable, dividedPowerPolynomialVariableMonomial,
    C.dividedPowers.dpow_one (k i).property] using
      polynomialLift_variableMonomial A C f k i 1

private theorem polynomialLift_isDPMorphism (A : DividedPowerRing.{u})
    {ι : Type w} [Finite ι] (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) :
    _root_.DividedPowers.IsDPMorphism (dividedPowerPolynomialDividedPowers A ι)
      C.dividedPowers (polynomialLift A C f k) := by
  classical
  let γ := dividedPowerPolynomialDividedPowers A ι
  let L := polynomialLift A C f k
  have hK : (dividedPowerPolynomialIdeal A.ideal ι).map L ≤ C.ideal :=
    polynomialLift_ideal_comp A C f k
  let F := _root_.DividedPowers.ideal_from_ringHom γ C.dividedPowers hK
  have hv (i : ι) : dividedPowerPolynomialVariable A i ∈ F := by
    refine ⟨variable_mem_polynomialIdeal A i, fun n ↦ ?_⟩
    rw [dividedPowerPolynomialDividedPowers_dpow_variable,
      polynomialLift_variableMonomial, polynomialLift_variable]
  have hc {a : A} (ha : a ∈ A.ideal) :
      algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a ∈ F := by
    refine ⟨coefficient_mem_polynomialIdeal A ha, fun n ↦ ?_⟩
    rw [dividedPowerPolynomialCoefficient_isDPMorphism A ι |>.dpow_comp a ha,
      polynomialLift_coeff, polynomialLift_coeff]
    exact (f.dpow_comp a ha).symm
  have hF : dividedPowerPolynomialIdeal A.ideal ι ≤ F :=
    polynomialIdeal_le_of_mem A ι F (fun _ ha ↦ hc ha) fun i m hm ↦ by
      have h := (ideal_from_ringHom_isSubDPIdeal γ C.dividedPowers L hK).dpow_mem
        m hm (hv i)
      simpa [γ, dividedPowerPolynomialDividedPowers_dpow_variable] using h
  exact ⟨hK, fun {n} x hx ↦ ((hF hx).2 n).symm⟩

/-- A divided power morphism on coefficients and one element of the target divided power ideal
for each variable extend uniquely to the divided power polynomial algebra. -/
@[stacks 07H5 "universal property"]
public theorem existsUnique_dPMorphism_from_dividedPowerPolynomial
    (A : DividedPowerRing.{u}) (ι : Type w) [Finite ι]
    (C : DividedPowerRing.{v})
    (f : _root_.DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (k : ι → C.ideal) :
    ∃! φ : _root_.DividedPowers.DPMorphism (dividedPowerPolynomialDividedPowers A ι)
        C.dividedPowers,
      (φ.comp (dividedPowerPolynomialCoefficientDPMorphism A ι) = f ∧
        ∀ i : ι, φ (dividedPowerPolynomialVariable A i) = (k i : C)) := by
  classical
  let φ : _root_.DividedPowers.DPMorphism (dividedPowerPolynomialDividedPowers A ι)
      C.dividedPowers := _root_.DividedPowers.DPMorphism.mk'
        (polynomialLift_isDPMorphism A C f k)
  have hφcoeff (a : A) :
      φ (algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a) = f a :=
    polynomialLift_coeff A C f k a
  refine ⟨φ, ⟨?_, ?_⟩, ?_⟩
  · ext a
    exact hφcoeff a
  · intro i
    exact polynomialLift_variable A C f k i
  · intro ψ hψ
    have hψcoeff (a : A) :
        ψ (algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a) = f a := by
      have h := congrArg (fun g : _root_.DividedPowers.DPMorphism A.dividedPowers
          C.dividedPowers ↦ g a) hψ.1
      change ψ (algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a) = f a at h
      exact h
    have hmonomial (n : ι →₀ ℕ) :
        ψ (dividedPowerPolynomialMonomial A n) =
          φ (dividedPowerPolynomialMonomial A n) := by
      show ψ.toRingHom
          (n.prod fun i m ↦ DividedPowerAlgebra.dp A m (Finsupp.single i 1)) =
        φ.toRingHom (n.prod fun i m ↦ DividedPowerAlgebra.dp A m (Finsupp.single i 1))
      rw [map_finsuppProd, map_finsuppProd]
      apply Finsupp.prod_congr
      intro i hi
      have hvarmem := variable_mem_polynomialIdeal A i
      have hdp := dividedPowerPolynomialDividedPowers_dpow_variable A ι i (n i)
      show ψ.toRingHom (dividedPowerPolynomialVariableMonomial A i (n i)) =
        φ.toRingHom (dividedPowerPolynomialVariableMonomial A i (n i))
      rw [← hdp, ← ψ.dpow_comp _ hvarmem, ← φ.dpow_comp _ hvarmem]
      show C.dividedPowers.dpow (n i) (ψ (dividedPowerPolynomialVariable A i)) =
        C.dividedPowers.dpow (n i) (φ (dividedPowerPolynomialVariable A i))
      rw [hψ.2 i]
      show C.dividedPowers.dpow (n i) (k i) =
        C.dividedPowers.dpow (n i)
          (polynomialLift A C f k (dividedPowerPolynomialVariable A i))
      rw [polynomialLift_variable]
    apply _root_.DividedPowers.DPMorphism.ext
    funext x
    show ψ x = φ x
    have hx : x ∈ Submodule.span A
        (Set.range (dividedPowerPolynomialMonomial A (ι := ι))) := by
      rw [monomial_span_eq_top]
      trivial
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨n, rfl⟩ := hx
      exact hmonomial n
    | zero => exact (ψ.toRingHom.map_zero).trans (φ.toRingHom.map_zero).symm
    | add x y _ _ hx hy =>
      calc
        ψ (x + y) = ψ x + ψ y := ψ.toRingHom.map_add x y
        _ = φ x + φ y := by rw [hx, hy]
        _ = φ (x + y) := (φ.toRingHom.map_add x y).symm
    | smul a x _ hx =>
      calc
        ψ (a • x) = ψ (algebraMap A _ a) * ψ x := by
          rw [Algebra.smul_def]
          exact ψ.toRingHom.map_mul _ _
        _ = f a * ψ x := by rw [hψcoeff]
        _ = f a * φ x := by rw [hx]
        _ = φ (a • x) := by
          rw [Algebra.smul_def, ← hφcoeff]
          exact (φ.toRingHom.map_mul _ _).symm

end DividedPowers

end
