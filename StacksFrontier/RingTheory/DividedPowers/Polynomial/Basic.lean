attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private noncomputable def coefficientTensorDividedPowerAlgebraLift
    (A : Type u) [CommRing A] (ι : Type w) :
    DividedPowerAlgebra A (ι →₀ A) →ₐ[A]
      TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A := by
  let v : ι → TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A :=
    fun i ↦ (Algebra.TensorProduct.includeLeft :
      DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
        TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A)
      (dividedPowerPolynomialVariable ℤ i)
  let g : (ι →₀ A) →ₗ[A]
      TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)) A :=
    Finsupp.linearCombination A v
  have hg (m : ι →₀ A) :
      g m ∈ ((dividedPowerPolynomialPositiveIdeal ℤ ι).map
        (Algebra.TensorProduct.includeLeft :
          DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
            TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ))
              (MvPolynomial A ℤ))).map
        (Algebra.TensorProduct.map
          (AlgHom.id ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)))
          (MvPolynomial.aeval (fun a : A ↦ a) : MvPolynomial A ℤ →ₐ[ℤ] A)) := by
    classical
    change m.sum (fun i a ↦ a • v i) ∈ _
    apply Submodule.sum_mem
    intro i hi
    apply Submodule.smul_of_tower_mem
    have h := Ideal.mem_map_of_mem
      (Algebra.TensorProduct.map
        (AlgHom.id ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ)))
        (MvPolynomial.aeval (fun a : A ↦ a) : MvPolynomial A ℤ →ₐ[ℤ] A))
      (Ideal.mem_map_of_mem
      (Algebra.TensorProduct.includeLeft :
        DividedPowerAlgebra ℤ (ι →₀ ℤ) →ₐ[ℤ]
          TensorProduct ℤ (DividedPowerAlgebra ℤ (ι →₀ ℤ))
            (MvPolynomial A ℤ)) (variable_mem_positiveIdeal ℤ i))
    simpa [v, Algebra.TensorProduct.map_tmul] using h
  exact DividedPowerAlgebra.lift (coefficientTensorPositiveDividedPowers A ι) g hg

