module

public import Mathlib.RingTheory.DividedPowers.SubDPIdeal
public import StacksFrontier.RingTheory.DividedPowers.FreeModuleBasis
public import StacksFrontier.RingTheory.DividedPowers.Criteria

/-!
# Divided powers on the augmentation ideal, and freeness of the divided power algebra

Let `R` be a commutative ring and `M` an `R`-module. The *augmentation* of the divided power
algebra `Γ_R(M)` is the `R`-algebra map `Γ_R(M) →ₐ[R] R` obtained from the universal property
applied to the zero ideal of `R`; it kills every divided power `dp R n m` with `n ≠ 0`. Its
kernel, the *augmentation ideal* `Γ_R(M)₊`, is generated by those divided powers.

The first half of this file shows that `Γ_R(M)₊` admits divided powers as soon as `Γ_R(M)` is
torsion-free as an additive group, which happens whenever `M` is free over a torsion-free `R`
(by `DividedPowerAlgebra.basisDPMonomial`). The verification uses the generator criterion
`DividedPowers.nonempty_dividedPowers_iff_exists_generators_pow_mem_factorial_mul`: the `k`-th
power of `dp R n m` is `((kn)! / (n !)ᵏ) · dp R (kn) m` by `DividedPowerAlgebra.pow_dp`, and the
arithmetic lemma `Nat.factorial_dvd_multinomial_const` says that `k !` divides that multinomial
coefficient whenever `n ≠ 0`. Over such a ring the structure is moreover unique, by
`DividedPowers.instSubsingletonDividedPowers`, and any divided power structure on `Γ_R(M)₊`
necessarily takes `dp R 1 m` to `dp R n m`.

The second half removes the torsion-free hypothesis from the *freeness* statement: the divided
power monomials `∏ i, xᵢ^[kᵢ]` are linearly independent in `Γ_A(ι →₀ A)` over an arbitrary
commutative ring `A`, and so — with Mathlib's spanning statement `submodule_span_prod_dp_eq_top`
— form a basis, which is assembled as `DividedPowers.dividedPowerPolynomialMonomialBasis` in
`StacksFrontier/RingTheory/DividedPowers/Polynomial/Basic.lean`. The independence is obtained by
descent from `R := MvPolynomial A ℤ`, which is a free `ℤ`-module, hence torsion-free, and
surjects onto `A`. Writing `π : R ↠ A` and `𝔞 := ker π`, the ideal `𝔞Γ_R ⊓ Γ_R₊` is the product
`Γ_R₊ · 𝔞Γ_R` (`map_inf_augIdeal`), hence a sub-divided-power ideal of `Γ_R₊`, so the divided
powers descend to the quotient `Q := Γ_R / 𝔞Γ_R`, which is an `A`-algebra. The universal property
of `Γ_A(ι →₀ A)` then produces an `A`-algebra map to `Q` carrying the divided power monomials of
`Γ_A` to the images of a basis of `Γ_R`, and those images are `A`-linearly independent because a
coordinate of an element of `𝔞Γ_R` lies in `𝔞`.

## Main definitions

* `Nat.choose_succ_mul_succ` — the cancelled form of `Nat.add_one_mul_choose_eq`.
* `Nat.factorial_dvd_multinomial_const` — `n !` divides `(nm)! / (m !)ⁿ` for `m ≠ 0`.
* `Module.Basis.isAddTorsionFree` — a module with a basis over an additively torsion-free ring
  is additively torsion-free.
* `DividedPowerAlgebra.augmentation` — the augmentation `Γ_R(M) →ₐ[R] R`.
* `DividedPowerAlgebra.augIdeal` — the augmentation ideal `Γ_R(M)₊`.
* `DividedPowerAlgebra.augIdealDividedPowers` — the divided powers on `Γ_R(M)₊`.

## Main results

* `DividedPowerAlgebra.span_dpGenerators_eq_augIdeal` — the augmentation ideal is generated by
  the divided powers of positive order.
* `DividedPowerAlgebra.nonempty_dividedPowers_augIdeal` — the augmentation ideal of an
  additively torsion-free divided power algebra carries divided powers.
* `DividedPowerAlgebra.dpow_dp_one` — any divided power structure on the augmentation ideal of an
  additively torsion-free divided power algebra satisfies `(dp R 1 m)^[n] = dp R n m`.
* `DividedPowerAlgebra.map_inf_augIdeal` — the extension of an ideal `𝔞` of `R` meets the
  augmentation ideal in the product of the two ideals.
* `DividedPowerAlgebra.isSubDPIdeal_map_inf_augIdeal` — that intersection is a
  sub-divided-power ideal.
* `DividedPowerAlgebra.map_surjective` — base change along a surjection is surjective.
* `DividedPowerAlgebra.linearIndependent_dpMonomial_of_dividedPowers` — a criterion for linear
  independence of divided power monomials.
* `DividedPowerAlgebra.linearIndependent_dpMonomialFinsupp` — the divided power monomials of
  `Γ_A(ι →₀ A)` are linearly independent over an arbitrary commutative ring `A`.

## References

* [Stacks Project, Tag 07H5](https://stacks.math.columbia.edu/tag/07H5)
-/

@[expose] public section

/-! ### An arithmetic divisibility -/

namespace Nat

/-- The binomial coefficient `C((n+1)(m+1), m+1)` equals `(n+1) · C(n(m+1)+m, m)`. This is
`Nat.add_one_mul_choose_eq` with the common factor `m+1` cancelled. -/
public theorem choose_succ_mul_succ (n m : ℕ) :
    ((n + 1) * (m + 1)).choose (m + 1) = (n + 1) * (n * (m + 1) + m).choose m := by
  have key : (n + 1) * (m + 1) = n * (m + 1) + m + 1 := by ring
  have h := Nat.add_one_mul_choose_eq (n * (m + 1) + m) m
  rw [← key] at h
  have hpos : 0 < m + 1 := Nat.succ_pos m
  refine Nat.eq_of_mul_eq_mul_right hpos ?_
  rw [← h]
  exact mul_right_comm _ _ _

/-- For `m ≠ 0`, the factorial `n !` divides the multinomial coefficient `(nm)! / (m !)ⁿ` of `n`
copies of `m`. -/
public theorem factorial_dvd_multinomial_const (n : ℕ) {m : ℕ} (hm : m ≠ 0) :
    n ! ∣ Nat.multinomial (Finset.range n) (fun _ ↦ m) := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_one.mpr (Nat.pos_of_ne_zero hm)
  induction n with
  | zero => simp
  | succ n ih =>
    have hsum : ∑ _i ∈ Finset.range n, (j + 1) = n * (j + 1) := by simp
    rw [Finset.range_add_one, Nat.multinomial_insert Finset.notMem_range_self, hsum,
      show (j + 1) + n * (j + 1) = (n + 1) * (j + 1) from by ring, Nat.choose_succ_mul_succ,
      Nat.factorial_succ, mul_assoc]
    exact mul_dvd_mul dvd_rfl (ih.mul_left _)

end Nat

/-! ### Torsion-freeness of a free module -/

/-- In a commutative additive monoid, additive torsion-freeness gives unique divisibility. -/
private theorem hasUniqueDiv_of_isAddTorsionFree {M : Type*} [AddCommMonoid M]
    [IsAddTorsionFree M] : HasUniqueDiv M :=
  ⟨fun _ hn a b h ↦ eq_of_nsmul_eq_nsmul_of_addCommute hn (AddCommute.all a b) h⟩

/-- A module admitting a basis over a commutative ring which is torsion-free as an additive group
is itself torsion-free as an additive group. -/
public theorem Module.Basis.isAddTorsionFree {R : Type*} [CommRing R] [IsAddTorsionFree R]
    {M : Type*} [AddCommGroup M] [Module R M] {ι : Type*} (b : Module.Basis ι R M) :
    IsAddTorsionFree M := by
  have : HasUniqueDiv R := hasUniqueDiv_of_isAddTorsionFree
  have h1 : Module.IsTorsionFree R M := b.isTorsionFree
  have h2 : Module.IsTorsionFree ℤ M := Module.IsTorsionFree.trans R
  have : HasUniqueDiv M := Module.isTorsionFree_int_iff_hasUniqueDiv.mp h2
  infer_instance

/-! ### Extension of an ideal to an algebra, in coordinates -/

/-- In an `R`-algebra `S`, every element of the extension of an ideal `𝔞` of `R` is an
`𝔞`-multiple of elements of `S`. -/
public theorem Ideal.mem_smul_top_of_mem_map_algebraMap {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (𝔞 : Ideal R) {x : S} (hx : x ∈ Ideal.map (algebraMap R S) 𝔞) :
    x ∈ 𝔞 • (⊤ : Submodule R S) := by
  have hmul : ∀ (s : S) {y : S}, y ∈ 𝔞 • (⊤ : Submodule R S) →
      s * y ∈ 𝔞 • (⊤ : Submodule R S) := by
    intro s y hy
    induction hy using Submodule.smul_induction_on' with
    | smul a ha b _ =>
        rw [Algebra.mul_smul_comm]
        exact Submodule.smul_mem_smul ha Submodule.mem_top
    | add y _ z _ hy' hz' => rw [mul_add]; exact Submodule.add_mem _ hy' hz'
  rw [Ideal.map] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨a, ha, rfl⟩ := hy
      rw [show algebraMap R S a = a • (1 : S) from by rw [Algebra.smul_def, mul_one]]
      exact Submodule.smul_mem_smul ha Submodule.mem_top
  | zero => exact Submodule.zero_mem _
  | add y z _ _ hy hz => exact Submodule.add_mem _ hy hz
  | smul s y _ hy => exact hmul s hy

/-- For an `R`-algebra `S` with an `R`-basis `B`, every coordinate of an element of the extension
of an ideal `𝔞` of `R` lies in `𝔞`. -/
public theorem Module.Basis.repr_mem_of_mem_map_algebraMap {R S ι : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (B : Module.Basis ι R S) {𝔞 : Ideal R} {x : S}
    (hx : x ∈ Ideal.map (algebraMap R S) 𝔞) (i : ι) : B.repr x i ∈ 𝔞 := by
  have h1 := Ideal.mem_smul_top_of_mem_map_algebraMap 𝔞 hx
  rw [← B.span_eq, Submodule.mem_ideal_smul_span_iff_exists_sum] at h1
  obtain ⟨a, ha, rfl⟩ := h1
  rw [show (a.sum fun j c ↦ c • B j) = Finsupp.linearCombination R B a from
    (Finsupp.linearCombination_apply R a).symm, B.repr_linearCombination]
  exact ha i

namespace DividedPowerAlgebra

universe u v w

variable {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]

/-! ### The augmentation ideal -/

variable (R M) in
/-- The augmentation of the divided power algebra: the `R`-algebra map `Γ_R(M) →ₐ[R] R` obtained
from the universal property applied to the zero ideal of `R`. -/
public noncomputable def augmentation : DividedPowerAlgebra R M →ₐ[R] R :=
  lift (dividedPowersBot R) 0 (fun _ ↦ by simp)

/-- The augmentation sends `dp R n m` to `1` if `n = 0` and to `0` otherwise. -/
public theorem augmentation_dp (n : ℕ) (m : M) :
    augmentation R M (dp R n m) = if n = 0 then 1 else 0 := by
  classical
  rw [augmentation, lift_apply_dp]
  simp [dividedPowersBot_dpow_eq]

variable (R M) in
/-- The augmentation ideal `Γ_R(M)₊` of the divided power algebra: the kernel of the
augmentation. -/
public noncomputable def augIdeal : Ideal (DividedPowerAlgebra R M) :=
  RingHom.ker (augmentation R M).toRingHom

/-- An element lies in the augmentation ideal exactly when its augmentation vanishes. -/
public theorem mem_augIdeal_iff {x : DividedPowerAlgebra R M} :
    x ∈ augIdeal R M ↔ augmentation R M x = 0 :=
  Iff.rfl

/-- A divided power of positive order lies in the augmentation ideal. -/
public theorem dp_mem_augIdeal {n : ℕ} (hn : n ≠ 0) (m : M) : dp R n m ∈ augIdeal R M := by
  rw [mem_augIdeal_iff, augmentation_dp, ite_eq_right hn]

/-- The "augmentation defect" `x - algebraMap (augmentation x)` is additive. -/
private theorem sub_algebraMap_augmentation_add (f g : DividedPowerAlgebra R M) :
    f + g - algebraMap R _ (augmentation R M (f + g)) =
      (f - algebraMap R _ (augmentation R M f)) + (g - algebraMap R _ (augmentation R M g)) := by
  rw [map_add, map_add]; ring

variable (R M) in
/-- The set of divided powers of positive order, which generates the augmentation ideal. -/
public def dpGenerators : Set (DividedPowerAlgebra R M) :=
  {x | ∃ (n : ℕ) (m : M), n ≠ 0 ∧ x = dp R n m}

/-- The augmentation ideal is generated by the divided powers of positive order. -/
public theorem span_dpGenerators_eq_augIdeal :
    Ideal.span (dpGenerators R M) = augIdeal R M := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro x ⟨n, m, hn, rfl⟩
    exact dp_mem_augIdeal hn m
  · intro x hx
    have key : ∀ y : DividedPowerAlgebra R M,
        y - algebraMap R _ (augmentation R M y) ∈ Ideal.span (dpGenerators R M) := by
      intro y
      induction y using DividedPowerAlgebra.induction_on with
      | C a => simp
      | add f g hf hg =>
          rw [sub_algebraMap_augmentation_add]
          exact Ideal.add_mem _ hf hg
      | dp f n m hf =>
          rcases eq_or_ne n 0 with rfl | hn
          · simpa [dp_zero] using hf
          · have hz : augmentation R M (f * dp R n m) = 0 := by
              rw [map_mul, augmentation_dp, ite_eq_right hn, mul_zero]
            rw [hz, map_zero, sub_zero]
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨n, m, hn, rfl⟩)
    have hx' := key x
    rwa [mem_augIdeal_iff.mp hx, map_zero, sub_zero] at hx'

/-- The divided power monomial indexed by the zero exponent vector is `1`. -/
@[simp]
public theorem dpMonomial_zero {ι : Type w} (v : ι → M) : dpMonomial R v 0 = 1 := by
  rw [dpMonomial, Finsupp.prod_zero_index]

/-- The augmentation sends the divided power monomial indexed by the zero exponent vector
to `1`. -/
public theorem augmentation_dpMonomial_zero {ι : Type w} (v : ι → M) :
    augmentation R M (dpMonomial R v (0 : ι →₀ ℕ)) = 1 := by
  rw [dpMonomial_zero, map_one]

/-- The augmentation kills every divided power monomial with nonzero exponent vector. -/
public theorem augmentation_dpMonomial_of_ne_zero {ι : Type w} (v : ι → M) {k : ι →₀ ℕ}
    (hk : k ≠ 0) : augmentation R M (dpMonomial R v k) = 0 := by
  rw [dpMonomial, Finsupp.prod, map_prod]
  obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hk
  refine Finset.prod_eq_zero hi ?_
  rw [augmentation_dp, ite_eq_right (Finsupp.mem_support_iff.mp hi)]

/-- A divided power monomial with nonzero exponent vector lies in the augmentation ideal. -/
public theorem dpMonomial_mem_augIdeal {ι : Type w} (v : ι → M) {k : ι →₀ ℕ} (hk : k ≠ 0) :
    dpMonomial R v k ∈ augIdeal R M :=
  mem_augIdeal_iff.mpr (augmentation_dpMonomial_of_ne_zero v hk)

/-! ### Divided powers on the augmentation ideal -/

/-- If the divided power algebra `Γ_R(M)` is torsion-free as an additive group, then its
augmentation ideal admits divided powers. -/
public theorem nonempty_dividedPowers_augIdeal [IsAddTorsionFree (DividedPowerAlgebra R M)] :
    Nonempty (DividedPowers (augIdeal R M)) := by
  have : HasUniqueDiv (DividedPowerAlgebra R M) := hasUniqueDiv_of_isAddTorsionFree
  rw [DividedPowers.nonempty_dividedPowers_iff_exists_generators_pow_mem_factorial_mul]
  refine ⟨dpGenerators R M, span_dpGenerators_eq_augIdeal, ?_⟩
  rintro x ⟨n, m, hn, rfl⟩ k hk
  obtain ⟨c, hc⟩ := Nat.factorial_dvd_multinomial_const k hn
  rw [Ideal.mem_span_singleton_mul]
  refine ⟨(c : DividedPowerAlgebra R M) * dp R (k * n) m, ?_, ?_⟩
  · exact Ideal.mul_mem_left _ _ (dp_mem_augIdeal (Nat.mul_ne_zero (by omega) hn) m)
  · rw [pow_dp, Multiset.multinomial_nsmul_singleton, hc]
    push_cast
    ring

/-- The divided power structure on the augmentation ideal of an additively torsion-free divided
power algebra. It is the unique one, by `DividedPowers.instSubsingletonDividedPowers`. -/
public noncomputable def augIdealDividedPowers [IsAddTorsionFree (DividedPowerAlgebra R M)] :
    DividedPowers (augIdeal R M) :=
  nonempty_dividedPowers_augIdeal.some

/-- Any divided power structure on the augmentation ideal of an additively torsion-free divided
power algebra sends `dp R 1 m` to `dp R n m`. -/
public theorem dpow_dp_one [IsAddTorsionFree (DividedPowerAlgebra R M)]
    (γ : DividedPowers (augIdeal R M)) (n : ℕ) (m : M) :
    γ.dpow n (dp R 1 m) = dp R n m := by
  have : HasUniqueDiv (DividedPowerAlgebra R M) := hasUniqueDiv_of_isAddTorsionFree
  refine nsmul_right_injective (M := DividedPowerAlgebra R M)
    (Nat.factorial_ne_zero n) ?_
  change (Nat.factorial n) • γ.dpow n (dp R 1 m) = (Nat.factorial n) • dp R n m
  rw [nsmul_eq_mul, nsmul_eq_mul, γ.factorial_mul_dpow_eq_pow (dp_mem_augIdeal one_ne_zero m),
    natFactorial_mul_dp_eq]

/-! ### Extending an ideal of the base ring -/

/-- The augmentation of `algebraMap R Γ_R(M) r` is `r`. -/
@[simp]
public theorem augmentation_algebraMap (r : R) :
    augmentation R M (algebraMap R (DividedPowerAlgebra R M) r) = r := by
  simp

/-- Every element of the divided power algebra differs from (the image of) its augmentation by an
element of the augmentation ideal. -/
public theorem sub_algebraMap_augmentation_mem (x : DividedPowerAlgebra R M) :
    x - algebraMap R (DividedPowerAlgebra R M) (augmentation R M x) ∈ augIdeal R M := by
  rw [mem_augIdeal_iff, map_sub, augmentation_algebraMap, sub_self]

/-- The extension to `Γ_R(M)` of an ideal `𝔞` of `R` meets the augmentation ideal exactly in the
product of the two ideals. -/
public theorem map_inf_augIdeal (𝔞 : Ideal R) :
    Ideal.map (algebraMap R (DividedPowerAlgebra R M)) 𝔞 ⊓ augIdeal R M =
      augIdeal R M • Ideal.map (algebraMap R (DividedPowerAlgebra R M)) 𝔞 := by
  refine le_antisymm ?_ (le_inf Ideal.mul_le_right Ideal.mul_le_left)
  have key : ∀ x ∈ Ideal.map (algebraMap R (DividedPowerAlgebra R M)) 𝔞,
      x - algebraMap R (DividedPowerAlgebra R M) (augmentation R M x) ∈
        augIdeal R M • Ideal.map (algebraMap R (DividedPowerAlgebra R M)) 𝔞 := by
    intro x hx
    rw [Ideal.map] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨a, _, rfl⟩ := hy
        rw [augmentation_algebraMap, sub_self]
        exact Submodule.zero_mem _
    | zero => rw [map_zero, map_zero, sub_self]; exact Submodule.zero_mem _
    | add y z _ _ hy hz =>
        rw [sub_algebraMap_augmentation_add]
        exact Submodule.add_mem _ hy hz
    | smul s y hy hy' =>
        have h : s * y - algebraMap R (DividedPowerAlgebra R M) (augmentation R M (s * y)) =
            (s - algebraMap R (DividedPowerAlgebra R M) (augmentation R M s)) * y +
              algebraMap R (DividedPowerAlgebra R M) (augmentation R M s) *
                (y - algebraMap R (DividedPowerAlgebra R M) (augmentation R M y)) := by
          rw [map_mul, map_mul]; ring
        rw [show s • y = s * y from rfl, h]
        exact Submodule.add_mem _
          (Submodule.mul_mem_mul (sub_algebraMap_augmentation_mem s) hy)
          (Ideal.mul_mem_left _ _ hy')
  intro x hx
  have h1 := key x hx.1
  rwa [mem_augIdeal_iff.mp hx.2, map_zero, sub_zero] at h1

/-- For any ideal `𝔞` of `R`, the intersection of the extension of `𝔞` to `Γ_R(M)` with the
augmentation ideal is a sub-divided-power ideal of the augmentation ideal. -/
public theorem isSubDPIdeal_map_inf_augIdeal (γ : DividedPowers (augIdeal R M)) (𝔞 : Ideal R) :
    γ.IsSubDPIdeal (Ideal.map (algebraMap R (DividedPowerAlgebra R M)) 𝔞 ⊓ augIdeal R M) := by
  rw [map_inf_augIdeal]
  exact (DividedPowers.SubDPIdeal.prod (hI := γ)
    (Ideal.map (algebraMap R (DividedPowerAlgebra R M)) 𝔞)).toIsSubDPIdeal

/-! ### A criterion for linear independence of divided power monomials -/

/-- If some ideal of an `A`-algebra `C` carries divided powers and contains a family `c` whose
divided power monomials are linearly independent over `A`, then the divided power monomials of
`DividedPowerAlgebra A (ι →₀ A)` are linearly independent over `A`. The map used is the one
provided by the universal property of the divided power algebra. -/
public theorem linearIndependent_dpMonomial_of_dividedPowers {A : Type u} [CommRing A]
    {ι : Type w} {C : Type*} [CommRing C] [Algebra A C] {I : Ideal C} (δ : DividedPowers I)
    (c : ι → C) (hc : ∀ i, c i ∈ I)
    (hli : LinearIndependent A fun k : ι →₀ ℕ ↦ k.prod fun i n ↦ δ.dpow n (c i)) :
    LinearIndependent A (dpMonomial A (fun i : ι ↦ (Finsupp.single i (1 : A)))) := by
  classical
  set g : (ι →₀ A) →ₗ[A] C := Finsupp.basisSingleOne.constr A c with hg
  have hgmem : ∀ m : ι →₀ A, g m ∈ I := by
    intro m
    rw [hg, Module.Basis.constr_apply]
    refine Submodule.sum_mem _ fun i _ ↦ ?_
    dsimp only
    exact Submodule.smul_of_tower_mem I _ (hc i)
  have hgsingle : ∀ i : ι, g (Finsupp.single i (1 : A)) = c i := by
    intro i
    have h : (Finsupp.single i (1 : A)) =
        (Finsupp.basisSingleOne : Module.Basis ι A (ι →₀ A)) i := by
      rw [Finsupp.coe_basisSingleOne]
    rw [h, hg, Module.Basis.constr_basis]
  refine LinearIndependent.of_comp (lift δ g hgmem).toLinearMap ?_
  have hcomp :
      ((lift δ g hgmem).toLinearMap ∘ dpMonomial A (fun i : ι ↦ (Finsupp.single i (1 : A))))
        = fun k : ι →₀ ℕ ↦ k.prod fun i n ↦ δ.dpow n (c i) := by
    funext k
    simp only [Function.comp_apply, AlgHom.toLinearMap_apply, dpMonomial, Finsupp.prod,
      map_prod, lift_apply_dp, hgsingle]
  exact hcomp ▸ hli

/-! ### Surjectivity of base change -/

/-- Base change of the divided power algebra along a surjective linear map, over a surjective map
of base rings, is surjective. Mathlib's `DividedPowerAlgebra.lift_surjective` is the special case
of a fixed base ring. -/
public theorem map_surjective {S : Type*} [CommRing S] [Algebra R S] {N : Type*}
    [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N] {f : M →ₗ[R] N}
    (hS : Function.Surjective (algebraMap R S)) (hf : Function.Surjective f) :
    Function.Surjective (map S f) := by
  intro z
  induction z using DividedPowerAlgebra.induction_on with
  | C a =>
      obtain ⟨r, rfl⟩ := hS a
      refine ⟨algebraMap R (DividedPowerAlgebra R M) r, ?_⟩
      rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  | add x y hx hy =>
      obtain ⟨u, rfl⟩ := hx
      obtain ⟨v, rfl⟩ := hy
      exact ⟨u + v, map_add _ _ _⟩
  | dp x n m hx =>
      obtain ⟨u, rfl⟩ := hx
      obtain ⟨y, rfl⟩ := hf m
      exact ⟨u * dp R n y, by rw [map_mul, map_apply_dp]⟩

/-! ### Descent of linear independence along a surjection of base rings -/

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- Linear independence of the divided power monomials of `ι →₀ A` follows from a presentation of
`A` as a quotient of a ring `R` together with divided powers on an ideal of an `A`-algebra `Q`
receiving `Γ_R(ι →₀ R)` with kernel the extension of `ker π`, and a basis of divided power
monomials for `Γ_R(ι →₀ R)`. -/
public theorem linearIndependent_dpMonomial_of_quotient
    {R : Type u} [CommRing R] {A : Type v} [CommRing A] {ι : Type w}
    {Q : Type*} [CommRing Q] [Algebra A Q]
    (π : R →+* A) (hπ : Function.Surjective π)
    (f : DividedPowerAlgebra R (ι →₀ R) →+* Q)
    (hfker : RingHom.ker f
      = Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π))
    (hfalg : ∀ r : R, f (algebraMap R (DividedPowerAlgebra R (ι →₀ R)) r) = algebraMap A Q (π r))
    (J : Ideal Q) (δ : DividedPowers J)
    (hcJ : ∀ i : ι, f (dp R 1 (Finsupp.single i (1 : R))) ∈ J)
    (hδ : ∀ (n : ℕ) (i : ι), δ.dpow n (f (dp R 1 (Finsupp.single i (1 : R))))
      = f (dp R n (Finsupp.single i (1 : R))))
    (B : Module.Basis (ι →₀ ℕ) R (DividedPowerAlgebra R (ι →₀ R)))
    (hB : ∀ k, B k = dpMonomial R (fun i : ι ↦ (Finsupp.single i (1 : R))) k) :
    LinearIndependent A (dpMonomial A (fun i : ι ↦ (Finsupp.single i (1 : A)))) := by
  classical
  have hsmul : ∀ (r : R) (x : DividedPowerAlgebra R (ι →₀ R)),
      f (r • x) = algebraMap A Q (π r) * f x := by
    intro r x
    rw [Algebra.smul_def, map_mul, hfalg]
  refine linearIndependent_dpMonomial_of_dividedPowers δ
    (fun i ↦ f (dp R 1 (Finsupp.single i (1 : R))))
    hcJ ?_
  have hq : (fun k : ι →₀ ℕ ↦
        (k.prod fun i n ↦ δ.dpow n (f (dp R 1 (Finsupp.single i (1 : R))))))
      = fun k ↦ f (B k) := by
    funext k
    rw [hB k, dpMonomial, Finsupp.prod, Finsupp.prod, map_prod]
    exact Finset.prod_congr rfl fun i _ ↦ hδ _ i
  rw [hq, linearIndependent_iff]
  intro l hl
  obtain ⟨sec, hsec⟩ := hπ.hasRightInverse
  set sec0 : A → R := fun a ↦ if a = 0 then 0 else sec a with hsec0def
  have hsec0 : ∀ a, π (sec0 a) = a := by
    intro a
    by_cases h : a = 0
    · simp [hsec0def, h]
    · simp only [hsec0def, ite_eq_right h]; exact hsec a
  have hsec0zero : sec0 0 = 0 := by simp [hsec0def]
  set l' : (ι →₀ ℕ) →₀ R := Finsupp.mapRange sec0 hsec0zero l with hl'def
  have hl'app : ∀ k, l' k = sec0 (l k) := fun k ↦ by rw [hl'def, Finsupp.mapRange_apply]
  have hsub : l'.support ⊆ l.support := by rw [hl'def]; exact Finsupp.support_mapRange
  have hcomb : f (Finsupp.linearCombination R B l')
      = Finsupp.linearCombination A (fun k ↦ f (B k)) l := by
    rw [Finsupp.linearCombination_apply, Finsupp.linearCombination_apply,
      Finsupp.sum_of_support_subset _ hsub _ (by simp), Finsupp.sum, map_sum]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [hsmul, hl'app, hsec0, Algebra.smul_def]
  have hmem : Finsupp.linearCombination R B l' ∈ RingHom.ker f := by
    rw [RingHom.mem_ker, hcomb, hl]
  rw [hfker] at hmem
  have hcoord : ∀ k, l' k ∈ RingHom.ker π := by
    intro k
    have h := B.repr_mem_of_mem_map_algebraMap hmem k
    rwa [B.repr_linearCombination] at h
  ext k
  rw [Finsupp.coe_zero, Pi.zero_apply, ← hsec0 (l k), ← hl'app k]
  exact hcoord k


/-- Linear independence of the divided power monomials of `ι →₀ A` descends along a surjective
ring map `π : R →+* A`, given divided powers on the augmentation ideal of `Γ_R(ι →₀ R)` taking
`dp R 1` to `dp R n`, and a basis of divided power monomials for `Γ_R(ι →₀ R)`. -/
public theorem linearIndependent_dpMonomial_of_surjective
    {R : Type u} [CommRing R] {A : Type v} [CommRing A] {ι : Type w}
    (π : R →+* A) (hπ : Function.Surjective π)
    (γ : DividedPowers (augIdeal R (ι →₀ R)))
    (hγ : ∀ (n : ℕ) (i : ι), γ.dpow n (dp R 1 (Finsupp.single i (1 : R)))
      = dp R n (Finsupp.single i (1 : R)))
    (B : Module.Basis (ι →₀ ℕ) R (DividedPowerAlgebra R (ι →₀ R)))
    (hB : ∀ k, B k = dpMonomial R (fun i : ι ↦ (Finsupp.single i (1 : R))) k) :
    LinearIndependent A (dpMonomial A (fun i : ι ↦ (Finsupp.single i (1 : A)))) := by
  classical
  let algA : Algebra A (DividedPowerAlgebra R (ι →₀ R) ⧸
      Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π)) :=
    Algebra.compHom _ (RingHom.quotientKerEquivOfSurjective hπ).symm.toRingHom
  have h1 : RingHom.ker (Ideal.Quotient.mk
      (Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π)))
      = Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π) :=
    Ideal.mk_ker
  have h2 : ∀ r : R, (Ideal.Quotient.mk
        (Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π)))
        (algebraMap R (DividedPowerAlgebra R (ι →₀ R)) r)
      = @algebraMap A _ _ _ algA (π r) := by
    intro r
    have he : (RingHom.quotientKerEquivOfSurjective hπ).symm (π r)
        = Ideal.Quotient.mk (RingHom.ker π) r := by
      rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
    rw [Algebra.compHom_algebraMap_apply]
    simp only [RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, he]
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
  have h3 : ∀ (n : ℕ) (i : ι),
      (DividedPowers.Quotient.dividedPowers γ
          (isSubDPIdeal_map_inf_augIdeal γ (RingHom.ker π))).dpow n
          ((Ideal.Quotient.mk (Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R)))
            (RingHom.ker π))) (dp R 1 (Finsupp.single i (1 : R))))
        = (Ideal.Quotient.mk (Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R)))
            (RingHom.ker π))) (dp R n (Finsupp.single i (1 : R))) := by
    intro n i
    rw [DividedPowers.Quotient.dpow_apply γ _ (dp_mem_augIdeal one_ne_zero _), hγ]
  exact @linearIndependent_dpMonomial_of_quotient R _ A _ ι
    (DividedPowerAlgebra R (ι →₀ R) ⧸
      Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π))
    (Ideal.Quotient.commRing _) algA
    π hπ (Ideal.Quotient.mk
      (Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π))) h1 h2
    (Ideal.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π)))
      (augIdeal R (ι →₀ R)))
    (DividedPowers.Quotient.dividedPowers γ (isSubDPIdeal_map_inf_augIdeal γ (RingHom.ker π)))
    (fun i ↦ Ideal.mem_map_of_mem _ (dp_mem_augIdeal one_ne_zero _)) h3 B hB

/-- The divided power monomials of the free module `ι →₀ A` are linearly independent over any
commutative ring `A`. -/
public theorem linearIndependent_dpMonomialFinsupp (A : Type u) [CommRing A] (ι : Type w) :
    LinearIndependent A (dpMonomial A (fun i : ι ↦ (Finsupp.single i (1 : A)))) := by
  classical
  have htfR : IsAddTorsionFree (MvPolynomial A ℤ) :=
    (MvPolynomial.basisMonomials A ℤ).isAddTorsionFree
  have hinj : Function.Injective (algebraMap (MvPolynomial A ℤ) (MvPolynomial A ℚ)) :=
    MvPolynomial.map_injective _ Int.cast_injective
  have hsurj : Function.Surjective
      ((MvPolynomial.aeval (id : A → A)).toRingHom : MvPolynomial A ℤ →+* A) :=
    fun a ↦ ⟨MvPolynomial.X a, by simp⟩
  have htf :
      IsAddTorsionFree (DividedPowerAlgebra (MvPolynomial A ℤ) (ι →₀ MvPolynomial A ℤ)) :=
    (basisDPMonomialFinsupp (ι := ι) (MvPolynomial A ℤ) (MvPolynomial A ℚ) hinj).isAddTorsionFree
  exact linearIndependent_dpMonomial_of_surjective _ hsurj augIdealDividedPowers
    (fun n i ↦ dpow_dp_one _ n _)
    (basisDPMonomialFinsupp (ι := ι) (MvPolynomial A ℤ) (MvPolynomial A ℚ) hinj)
    (fun k ↦ basisDPMonomialFinsupp_apply _ _ hinj k)

end DividedPowerAlgebra

