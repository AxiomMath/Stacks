/-!
# Divided powers on `p A` for a `ℤ_(p)`-algebra `A`

If `A` is an algebra over `ℤ_(p)` then the ideal `pA` carries the divided power structure with
`γₙ(p a) = (pⁿ / n!) aⁿ`, obtained by extending the standard structure on `p ℤ_(p)` along the
(flat, indeed principal) structure map.

## Main definitions

* `DividedPowers.IntegersAtPrime` — the localization `ℤ_(p)` of the integers at `p`.

## Main results

* `DividedPowers.exists_dividedPowers_span_natCast` — the standard divided power structure on
  the ideal generated by `p` in a `ℤ_(p)`-algebra, with its coefficients `pⁿ / n!`.

## Implementation notes

Division by `n!` in the `ℤ_(p)` statement is expressed integrally: the coefficients `q n`
satisfy `n! * q n = pⁿ` and lie in `p ℤ_(p)` for `n > 0`.

## References

* [Stacks Project, Tag 07GN](https://stacks.math.columbia.edu/tag/07GN)
-/

@[expose] public section

namespace DividedPowers

section AtPrime

/-- The localization of the integers at the prime ideal generated by `p`. -/
@[ega "0 19.8.3"]
public noncomputable abbrev IntegersAtPrime (p : ℕ) [hp : Fact p.Prime] : Type :=
  letI : (Ideal.span ({(p : ℤ)} : Set ℤ)).IsPrime :=
    (Ideal.span_singleton_prime (Int.ofNat_ne_zero.mpr hp.out.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp.out)
  Localization.AtPrime (Ideal.span ({(p : ℤ)} : Set ℤ))

/-- The ideal of `ℤ` generated by a prime `p` is prime. -/
private theorem isPrime_span_natCast (p : ℕ) [Fact p.Prime] :
    (Ideal.span ({(p : ℤ)} : Set ℤ)).IsPrime :=
  (Ideal.span_singleton_prime (Int.ofNat_ne_zero.mpr (Fact.out : p.Prime).ne_zero)).mpr
    (Nat.prime_iff_prime_int.mp (Fact.out : p.Prime))

private lemma isUnit_factorial_divMaxPow (p n : ℕ) [Fact p.Prime] :
    IsUnit ((n.factorial.divMaxPow p : IntegersAtPrime p)) := by
  let _ := isPrime_span_natCast p
  have h : (n.factorial.divMaxPow p : ℤ) ∈
      (Ideal.span ({(p : ℤ)} : Set ℤ)).primeCompl := by
    change (n.factorial.divMaxPow p : ℤ) ∉ Ideal.span ({(p : ℤ)} : Set ℤ)
    simpa only [Ideal.mem_span_singleton, Int.natCast_dvd_natCast] using
      Nat.not_dvd_divMaxPow (Fact.out : p.Prime).one_lt n.factorial_ne_zero
  simpa only [map_natCast, Int.cast_natCast] using
    (IsLocalization.AtPrime.isUnit_to_map_iff (IntegersAtPrime p)
      (Ideal.span ({(p : ℤ)} : Set ℤ)) (n.factorial.divMaxPow p : ℤ)).2 h

private lemma factorial_mul_primeCoefficient (p n : ℕ) [Fact p.Prime] :
    (n.factorial : IntegersAtPrime p) *
        ((p : IntegersAtPrime p) ^ (n - padicValNat p n.factorial) *
          (↑((isUnit_factorial_divMaxPow p n).unit⁻¹) : IntegersAtPrime p)) =
      (p : IntegersAtPrime p) ^ n := by
  conv_lhs => lhs; rw [← Nat.pow_padicValNat_mul_divMaxPow p n.factorial]
  push_cast
  calc
    _ = (p : IntegersAtPrime p) ^ padicValNat p n.factorial *
        (p : IntegersAtPrime p) ^ (n - padicValNat p n.factorial) *
          ((n.factorial.divMaxPow p : IntegersAtPrime p) *
            (↑((isUnit_factorial_divMaxPow p n).unit⁻¹) : IntegersAtPrime p)) := by ring
    _ = _ := by
      rw [(isUnit_factorial_divMaxPow p n).mul_val_inv, mul_one, ← pow_add,
        Nat.add_sub_of_le (padicValNat_factorial_le p n)]

private noncomputable abbrev primeCoefficient (p n : ℕ) [Fact p.Prime] :
    IntegersAtPrime p :=
  (p : IntegersAtPrime p) ^ (n - padicValNat p n.factorial) *
    (↑((isUnit_factorial_divMaxPow p n).unit⁻¹) : IntegersAtPrime p)

private lemma primeCoefficient_mem (p n : ℕ) [Fact p.Prime] (hn : n ≠ 0) :
    primeCoefficient p n ∈ Ideal.span {(p : IntegersAtPrime p)} := by
  rw [Ideal.mem_span_singleton]
  unfold primeCoefficient
  obtain ⟨k, hk'⟩ := Nat.exists_eq_succ_of_ne_zero
    (Nat.sub_ne_zero_of_lt (padicValNat_factorial_lt_of_ne_zero p hn))
  rw [hk', pow_succ]
  refine ⟨(p : IntegersAtPrime p) ^ k *
    (↑((isUnit_factorial_divMaxPow p n).unit⁻¹) : IntegersAtPrime p), ?_⟩
  ring

private noncomputable def baseOperation (p : ℕ) [Fact p.Prime] (n : ℕ)
    (x : Ideal.span {(p : IntegersAtPrime p)}) :
    Ideal.span {(p : IntegersAtPrime p)} := by
  classical
  by_cases hn : n = 0
  · exact 0
  · let a := Classical.choose (Ideal.mem_span_singleton.mp x.property)
    exact ⟨primeCoefficient p n * a ^ n,
      Ideal.mul_mem_right _ _ (primeCoefficient_mem p n hn)⟩

private lemma factorial_mul_baseOperation (p : ℕ) [Fact p.Prime] (n : ℕ)
    (x : Ideal.span {(p : IntegersAtPrime p)}) (hn : 0 < n) :
    (n.factorial : IntegersAtPrime p) * (baseOperation p n x : IntegersAtPrime p) =
      (x : IntegersAtPrime p) ^ n := by
  classical
  let a := Classical.choose (Ideal.mem_span_singleton.mp x.property)
  have ha : (x : IntegersAtPrime p) = (p : IntegersAtPrime p) * a :=
    Classical.choose_spec (Ideal.mem_span_singleton.mp x.property)
  simp only [baseOperation, dite_eq_right (Nat.ne_of_gt hn), Subtype.coe_mk]
  change (n.factorial : IntegersAtPrime p) * (primeCoefficient p n * a ^ n) = _
  rw [ha, mul_pow]
  rw [← mul_assoc, factorial_mul_primeCoefficient]

private lemma charZero_integersAtPrime (p : ℕ) [Fact p.Prime] :
    CharZero (IntegersAtPrime p) := by
  let _ := isPrime_span_natCast p
  exact charZero_of_injective_algebraMap
    (IsLocalization.injective (IntegersAtPrime p)
      (Ideal.primeCompl_le_nonZeroDivisors (Ideal.span ({(p : ℤ)} : Set ℤ))))

private noncomputable def baseDividedPowers (p : ℕ) [Fact p.Prime] :
    DividedPowers (Ideal.span {(p : IntegersAtPrime p)}) := by
  let _ : CharZero (IntegersAtPrime p) := charZero_integersAtPrime p
  exact Classical.choose
    ((exists_dividedPowers_iff_factorial_mul_eq_pow
      (Ideal.span {(p : IntegersAtPrime p)}) (baseOperation p)).2
        (factorial_mul_baseOperation p))

private lemma baseDividedPowers_apply (p n : ℕ) [Fact p.Prime]
    (a : IntegersAtPrime p) :
    (baseDividedPowers p).dpow n ((p : IntegersAtPrime p) * a) =
      primeCoefficient p n * a ^ n := by
  let _ : CharZero (IntegersAtPrime p) := charZero_integersAtPrime p
  have hpa : (p : IntegersAtPrime p) * a ∈
      Ideal.span {(p : IntegersAtPrime p)} :=
    Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have hfac : (n.factorial : IntegersAtPrime p) ≠ 0 := by
    exact_mod_cast n.factorial_ne_zero
  apply (mul_left_cancel₀ hfac)
  rw [(baseDividedPowers p).factorial_mul_dpow_eq_pow hpa, mul_pow]
  rw [← factorial_mul_primeCoefficient p n, mul_assoc]


/-- If `A` is a `ℤ_(p)`-algebra, the ideal generated by `p` has the divided power structure
given by
`γₙ(p * a) = (p ^ n / n!) * a ^ n`.

The function `q` in the conclusion consists of the coefficients `p ^ n / n!` in `ℤ_(p)`;
the first two properties say that these quotients exist and lie in `pℤ_(p)` in positive
degrees. -/
@[stacks 07GN]
public theorem exists_dividedPowers_span_natCast
    {A : Type*} [CommRing A] (p : ℕ) [Fact p.Prime] [Algebra (IntegersAtPrime p) A] :
    ∃ (q : ℕ → IntegersAtPrime p) (γ : DividedPowers (Ideal.span {(p : A)})),
      (∀ n : ℕ, (n.factorial : IntegersAtPrime p) * q n = (p : IntegersAtPrime p) ^ n) ∧
        (∀ n : ℕ, n ≠ 0 → q n ∈ Ideal.span {(p : IntegersAtPrime p)}) ∧
          ∀ (n : ℕ) (a : A),
            γ.dpow n ((p : A) * a) = algebraMap (IntegersAtPrime p) A (q n) * a ^ n := by
  let R := IntegersAtPrime p
  let D : DividedPowerRing :=
    .of R (Ideal.span {(p : R)}) (baseDividedPowers p)
  let f : D →+* A := algebraMap R A
  obtain ⟨γ₀, hγ₀⟩ :=
    DividedPowerRing.dividedPowers_extends_of_map_eq_bot_or_isPrincipal_or_flat
      D f (Or.inr (Or.inl (by change (Ideal.span {(p : R)}).IsPrincipal; infer_instance)))
  have hmap : D.ideal.map f = Ideal.span {(p : A)} := by
    change (Ideal.span {(p : R)}).map (algebraMap R A) = Ideal.span {(p : A)}
    rw [Ideal.map_span]
    simp
  obtain ⟨γ, hγ⟩ : ∃ γ : DividedPowers (Ideal.span {(p : A)}),
      DividedPowers.IsDPMorphism (baseDividedPowers p) γ (algebraMap R A) := by
    rw [← hmap]
    exact ⟨γ₀, hγ₀⟩
  refine ⟨fun n => primeCoefficient p n, γ, fun n => factorial_mul_primeCoefficient p n,
    fun n hn => primeCoefficient_mem p n hn, fun n a => ?_⟩
  have hp : (p : R) ∈ D.ideal := Ideal.mem_span_singleton_self _
  have hcompat := hγ.map_dpow (n := n) hp
  simp only [map_natCast] at hcompat
  rw [mul_comm (p : A) a, γ.dpow_mul (Ideal.mem_span_singleton_self _), ← hcompat,
    show (baseDividedPowers p).dpow n (p : R) = primeCoefficient p n by
      simpa using baseDividedPowers_apply p n (1 : R)]
  ring

end AtPrime

end DividedPowers
