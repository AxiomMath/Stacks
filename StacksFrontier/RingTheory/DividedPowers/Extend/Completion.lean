/-!
# Divided powers and the `p`-adic completion: the completed ideal and continuity

If `p` is nilpotent modulo a divided power ideal `I`, the divided powers extend to the `p`-adic
completion of `A`. This file contains the first steps: the completion surjects onto `A / I`,
the kernel of that surjection is the completion of `I`, and each divided power operation is
continuous for the `p`-adic filtration.

## Main definitions

* `DividedPowers.completionToQuotient` — the canonical map from the `p`-adic completion of `A`
  to `A / I`, and `DividedPowers.completionIdeal` its kernel.

## Main results

* `DividedPowers.completionToQuotient_surjective` and `DividedPowers.completionIdealEquiv` —
  the completion surjects onto `A / I` with kernel the completion of `I`.
* `DividedPowers.dpow_pAdic_continuous` — continuity of the divided powers.

## Implementation notes

The `p`-adic completion is Mathlib's `AdicCompletion` of the principal ideal generated by `p`,
and continuity is stated in the directly usable congruence form.

## References

* [Stacks Project, Tag 07KD](https://stacks.math.columbia.edu/tag/07KD)
-/

@[expose] public section

namespace DividedPowers

section Completion

open scoped nonZeroDivisors

universe u v

variable {A : Type u} [CommRing A] (I : Ideal A) (γ : _root_.DividedPowers I) (p : ℕ)

/-- The ideal defining the `p`-adic topology. -/
public abbrev pAdicIdeal : Ideal A := Ideal.span {(p : A)}

/-- An exponent witnessing that `p` vanishes to a power modulo `I`. -/
noncomputable def nilpotencyExponent
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) : ℕ :=
  Classical.choose hp

public theorem pAdicIdeal_pow_nilpotencyExponent_le
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) :
    pAdicIdeal (A := A) p ^ nilpotencyExponent I p hp ≤ I := by
  rw [pAdicIdeal, Ideal.span_singleton_pow, Ideal.span_le, Set.singleton_subset_iff]
  exact Ideal.Quotient.eq_zero_iff_mem.mp (Classical.choose_spec hp)

/-- A higher power of the ideal `(p)` than the nilpotency exponent is contained in `I`. -/
private theorem pAdicIdeal_pow_le_of_nilpotencyExponent_le
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) {e : ℕ}
    (he : nilpotencyExponent I p hp ≤ e) : pAdicIdeal (A := A) p ^ e ≤ I :=
  (Ideal.pow_le_pow_right he).trans (pAdicIdeal_pow_nilpotencyExponent_le I p hp)

/-- A higher power of `(p)` than the nilpotency exponent, times `⊤`, is contained in `I`. -/
private theorem pAdicIdeal_pow_smul_top_le_of_nilpotencyExponent_le
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) {e : ℕ}
    (he : nilpotencyExponent I p hp ≤ e) :
    pAdicIdeal (A := A) p ^ e • (⊤ : Submodule A A) ≤ I := by
  simpa [Ideal.smul_eq_mul, Ideal.mul_top] using
    pAdicIdeal_pow_le_of_nilpotencyExponent_le I p hp he

/-- `p ^ k` lies in the `k`-th power of the ideal `(p)`. -/
private theorem natCast_pow_mem_pAdicIdeal_pow (k : ℕ) :
    (p : A) ^ k ∈ pAdicIdeal (A := A) p ^ k :=
  Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) k

public theorem pAdicPow_smul_top_cofinal
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) (n : ℕ) :
    pAdicIdeal (A := A) p ^ (n + nilpotencyExponent I p hp) •
        (⊤ : Submodule A A) ≤
      pAdicIdeal (A := A) p ^ n • (I : Submodule A A) := by
  rw [pow_add, Submodule.mul_smul]
  exact smul_mono_right _ (pAdicIdeal_pow_smul_top_le_of_nilpotencyExponent_le I p hp le_rfl)

public theorem pAdicPow_isSubDPIdeal [Fact p.Prime]
    [Algebra (IntegersAtPrime p) A]
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) {e : ℕ}
    (ht : nilpotencyExponent I p hp < e) (he : 2 ≤ e) :
    γ.IsSubDPIdeal (pAdicIdeal (A := A) p ^ e) := by
  have hcontained : pAdicIdeal (A := A) p ^ e ≤ I :=
    pAdicIdeal_pow_le_of_nilpotencyExponent_le I p hp ht.le
  rw [pAdicIdeal, Ideal.span_singleton_pow]
  have hS : ({(p : A) ^ e} : Set A) ⊆ I := by
    intro a ha
    rcases Set.mem_singleton_iff.mp ha with rfl
    exact hcontained (natCast_pow_mem_pAdicIdeal_pow p e)
  apply (DividedPowers.span_isSubDPIdeal_iff hS).2
  intro n hn s hs
  obtain rfl := Set.mem_singleton_iff.mp hs
  obtain ⟨q, _, hfac, hqmem, _⟩ :=
    exists_dividedPowers_span_natCast (A := A) p
  let qA := algebraMap (IntegersAtPrime p) A (q n)
  have hq : qA ∈ pAdicIdeal (A := A) p := by
    simpa [qA, pAdicIdeal, Ideal.map_span] using
      Ideal.mem_map_of_mem
        (algebraMap (IntegersAtPrime p) A) (hqmem n hn)
  have hfaca : (n.factorial : A) * qA = (p : A) ^ n := by
    simpa [qA] using congrArg (algebraMap (IntegersAtPrime p) A) (hfac n)
  have hz : (p : A) ^ (e - 1) ∈ I :=
    pAdicIdeal_pow_le_of_nilpotencyExponent_le I p hp (by omega)
      (natCast_pow_mem_pAdicIdeal_pow p (e - 1))
  have hpe : (p : A) ^ e = (p : A) * (p : A) ^ (e - 1) := by
    rw [← pow_succ', Nat.sub_add_cancel (by omega)]
  have hfactor : γ.dpow n ((p : A) ^ e) = qA * ((p : A) ^ (e - 1)) ^ n := by
    rw [hpe, γ.dpow_mul (n := n) (a := (p : A)) hz, ← hfaca,
      ← γ.factorial_mul_dpow_eq_pow (n := n) hz]
    ring
  have hpowmem : ((p : A) ^ (e - 1)) ^ n ∈
      pAdicIdeal (A := A) p ^ ((e - 1) * n) := by
    rw [← pow_mul]
    exact natCast_pow_mem_pAdicIdeal_pow p _
  have hprod : γ.dpow n ((p : A) ^ e) ∈
      pAdicIdeal (A := A) p ^ (((e - 1) * n) + 1) := by
    rw [hfactor, pow_add]
    exact Ideal.mul_mem_mul_rev hpowmem (by simpa using hq)
  have hle : e ≤ (e - 1) * n + 1 := by
    have hmul : (e - 1) * 1 ≤ (e - 1) * n :=
      Nat.mul_le_mul_left (e - 1) (Nat.one_le_iff_ne_zero.mpr hn)
    rw [mul_one] at hmul
    omega
  simpa [pAdicIdeal, Ideal.span_singleton_pow] using Ideal.pow_le_pow_right hle hprod

public theorem exists_eventual_pAdicDPIdeal [Fact p.Prime]
    [Algebra (IntegersAtPrime p) A]
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) :
    ∃ N, ∀ e, N ≤ e →
      (pAdicIdeal (A := A) p ^ e ≤ I) ∧
        γ.IsSubDPIdeal (pAdicIdeal (A := A) p ^ e) := by
  let t := nilpotencyExponent I p hp
  refine ⟨max (t + 1) 2, ?_⟩
  intro e he
  have ht : t < e := by
    have hle : t + 1 ≤ e := (le_max_left _ _).trans he
    omega
  have he2 : 2 ≤ e := (le_max_right _ _).trans he
  exact ⟨pAdicIdeal_pow_le_of_nilpotencyExponent_le I p hp ht.le,
    pAdicPow_isSubDPIdeal I γ p hp ht he2⟩

/-- The canonical map from the `p`-adic completion of `A` to `A/I`.

Choosing another nilpotence exponent gives the same map, since the projections
of an adic completion are compatible. -/
public noncomputable def completionToQuotient
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) :
    AdicCompletion (pAdicIdeal (A := A) p) A →+* A ⧸ I :=
  (Ideal.Quotient.factor (pAdicIdeal_pow_nilpotencyExponent_le I p hp)).comp
    (AdicCompletion.evalₐ (pAdicIdeal (A := A) p)
      (nilpotencyExponent I p hp)).toRingHom

/-- Part (1): the `p`-adic completion maps onto the quotient by the divided
power ideal. -/
@[stacks 07KD "part (1)"]
public theorem completionToQuotient_surjective
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) :
    Function.Surjective (completionToQuotient I p hp) := by
  intro y
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
  let n := nilpotencyExponent I p hp
  obtain ⟨x, hx⟩ := AdicCompletion.surjective_evalₐ
    (pAdicIdeal (A := A) p) n (Ideal.Quotient.mk _ a)
  refine ⟨x, ?_⟩
  show (Ideal.Quotient.factor (pAdicIdeal_pow_nilpotencyExponent_le I p hp))
      (AdicCompletion.evalₐ (pAdicIdeal (A := A) p) n x) = _
  rw [hx]
  exact Ideal.Quotient.factor_mk _ a

/-- The kernel in the completed ring, which is the completed divided power
ideal. -/
public noncomputable abbrev completionIdeal
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) :
    Ideal (AdicCompletion (pAdicIdeal (A := A) p) A) :=
  RingHom.ker (completionToQuotient I p hp)

public theorem completion_map_subtype_mem
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A)))
    (x : AdicCompletion (pAdicIdeal (A := A) p) I) :
    AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x ∈
      completionIdeal I p hp := by
  show completionToQuotient I p hp
      (AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x) = 0
  classical
  apply AdicCompletion.induction_on (pAdicIdeal (A := A) p) I x
  intro c
  simpa [completionToQuotient, AdicCompletion.map_mk, AdicCompletion.evalₐ_mk] using
    (Ideal.Quotient.eq_zero_iff_mem.mpr
      (c (nilpotencyExponent I p hp)).property)

public theorem mem_ideal_smul_iff_subtype_mem_smul
    {J I : Ideal A} {x : A} (hx : x ∈ I) :
    x ∈ J • (I : Submodule A A) ↔
      (⟨x, hx⟩ : I) ∈ J • (⊤ : Submodule A I) := by
  have hmap : Submodule.map I.subtype (J • (⊤ : Submodule A I)) =
      J • (I : Submodule A A) := by
    rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_subtype]
  rw [← hmap]
  refine ⟨fun h ↦ ?_, fun h ↦ Submodule.mem_map.mpr ⟨⟨x, hx⟩, h, rfl⟩⟩
  obtain ⟨y, hy, hxy⟩ := Submodule.mem_map.mp h
  obtain rfl : y = ⟨x, hx⟩ := Subtype.ext hxy
  exact hy

public theorem completion_map_subtype_surjective
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A)))
    (z : completionIdeal I p hp) :
    ∃ x : AdicCompletion (pAdicIdeal (A := A) p) I,
      AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x = z := by
  classical
  let t := nilpotencyExponent I p hp
  obtain ⟨c, hc⟩ := AdicCompletion.mk_surjective (pAdicIdeal (A := A) p) A z
  have hct : c t ∈ I := by
    have hz : completionToQuotient I p hp (AdicCompletion.mk _ _ c) = 0 := by
      rw [hc]
      exact z.property
    exact Ideal.Quotient.eq_zero_iff_mem.mp <|
      (show (Ideal.Quotient.mk I (c t)) = 0 by
        simpa [completionToQuotient, AdicCompletion.evalₐ_mk, t] using hz)
  let s : ℕ → I := fun n => ⟨c (n + t), by
    have hd : c (n + t) - c t ∈
        pAdicIdeal (A := A) p ^ t • (⊤ : Submodule A A) := by
      rw [← SModEq.sub_mem]
      exact SModEq.symm (c.property (show t ≤ n + t by omega))
    have ht : pAdicIdeal (A := A) p ^ t • (⊤ : Submodule A A) ≤ I :=
      pAdicIdeal_pow_smul_top_le_of_nilpotencyExponent_le I p hp le_rfl
    have hdiff : c (n + t) - c t ∈ I := ht (by simpa using hd)
    convert I.add_mem hct hdiff using 1; abel⟩
  let hs : AdicCompletion.AdicCauchySequence (pAdicIdeal (A := A) p) I := by
    refine ⟨s, fun {m n} hmn ↦ ?_⟩
    rw [SModEq.sub_mem]
    have hcauchy : c (m + t) - c (n + t) ∈
        pAdicIdeal (A := A) p ^ (m + t) • (⊤ : Submodule A A) := by
      rw [← SModEq.sub_mem]
      exact c.property (show m + t ≤ n + t by omega)
    have hmem := pAdicPow_smul_top_cofinal I p hp m hcauchy
    have hdI : c (m + t) - c (n + t) ∈ I :=
      I.sub_mem (s m).property (s n).property
    exact (mem_ideal_smul_iff_subtype_mem_smul (I := I)
      (J := pAdicIdeal (A := A) p ^ m) hdI).mp hmem
  refine ⟨AdicCompletion.mk (pAdicIdeal (A := A) p) I hs, AdicCompletion.ext fun n ↦ ?_⟩
  calc
    (AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype
      (AdicCompletion.mk (pAdicIdeal (A := A) p) I hs)).val n =
        Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ n • ⊤ : Submodule A A))
          (c (n + t)) := by
            rw [AdicCompletion.map_val_apply, AdicCompletion.mk_apply_coe]
            simp only [Submodule.mkQ_apply, LinearMap.reduceModIdeal_apply]
            rfl
    _ = Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ n • ⊤ : Submodule A A))
        (c n) := AdicCompletion.AdicCauchySequence.mk_eq_mk (show n ≤ n + t by omega) c
    _ = (AdicCompletion.mk (pAdicIdeal (A := A) p) A c).val n := rfl
    _ = ((z : AdicCompletion (pAdicIdeal (A := A) p) A).val n) :=
      congrArg (fun w : AdicCompletion (pAdicIdeal (A := A) p) A => w.val n) hc

public theorem completion_map_subtype_injective
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A)))
    (x y : AdicCompletion (pAdicIdeal (A := A) p) I)
    (hxy : AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x =
      AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype y) :
  x = y := by
  classical
  let t := nilpotencyExponent I p hp
  obtain ⟨c, hc⟩ := AdicCompletion.mk_surjective (pAdicIdeal (A := A) p) I x
  obtain ⟨d, hd⟩ := AdicCompletion.mk_surjective (pAdicIdeal (A := A) p) I y
  rw [← hc, ← hd]
  apply AdicCompletion.ext
  intro n
  have hcoord :
      Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ (n + t) • ⊤ :
        Submodule A A)) (c (n + t) : A) =
      Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ (n + t) • ⊤ :
        Submodule A A)) (d (n + t) : A) := by
    have hmap : AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype
        (AdicCompletion.mk (pAdicIdeal (A := A) p) I c) =
        AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype
          (AdicCompletion.mk (pAdicIdeal (A := A) p) I d) := by
      simpa [hc, hd] using hxy
    have heq := congrArg
      (fun w : AdicCompletion (pAdicIdeal (A := A) p) A => w.val (n + t)) hmap
    simpa [AdicCompletion.map_val_apply, AdicCompletion.mk_apply_coe,
      LinearMap.reduceModIdeal_apply] using heq
  have hdiff : ((c (n + t) : I) : A) - (d (n + t) : A) ∈
      pAdicIdeal (A := A) p ^ (n + t) • (⊤ : Submodule A A) :=
    (Submodule.Quotient.eq (p := pAdicIdeal (A := A) p ^ (n + t) • ⊤)).mp hcoord
  have hdiff' : ((c (n + t) : I) : A) - (d (n + t) : A) ∈
      pAdicIdeal (A := A) p ^ n • (I : Submodule A A) :=
    pAdicPow_smul_top_cofinal I p hp n hdiff
  calc
    (AdicCompletion.mk (pAdicIdeal (A := A) p) I c).val n =
        Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ n • ⊤ :
          Submodule A I)) (c n) := AdicCompletion.mk_apply_coe _ _ _ _
    _ = Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ n • ⊤ :
          Submodule A I)) (c (n + t)) :=
        (AdicCompletion.AdicCauchySequence.mk_eq_mk (show n ≤ n + t by omega) c).symm
    _ = Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ n • ⊤ :
          Submodule A I)) (d (n + t)) :=
        (Submodule.Quotient.eq
          (p := pAdicIdeal (A := A) p ^ n • (⊤ : Submodule A I))).mpr <|
        (mem_ideal_smul_iff_subtype_mem_smul
          (I := I) (J := pAdicIdeal (A := A) p ^ n)
          (I.sub_mem (c (n + t)).property (d (n + t)).property)).mp hdiff'
    _ = Submodule.Quotient.mk (p := (pAdicIdeal (A := A) p ^ n • ⊤ :
          Submodule A I)) (d n) :=
        AdicCompletion.AdicCauchySequence.mk_eq_mk (show n ≤ n + t by omega) d
    _ = (AdicCompletion.mk (pAdicIdeal (A := A) p) I d).val n :=
        (AdicCompletion.mk_apply_coe _ _ _ _).symm

/-- Part (2): the completion of `I`, mapped into the completion of `A`, is
canonically the kernel of the map to `A/I`. -/
@[stacks 07KD "part (2)"]
public noncomputable def completionIdealEquiv
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) :
    { e : AdicCompletion (pAdicIdeal (A := A) p) I ≃ₗ[
          AdicCompletion (pAdicIdeal (A := A) p) A] completionIdeal I p hp //
      ∀ x, ((e x : completionIdeal I p hp) :
        AdicCompletion (pAdicIdeal (A := A) p) A) =
          AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x } := by
  classical
  let f : AdicCompletion (pAdicIdeal (A := A) p) I →ₗ[
      AdicCompletion (pAdicIdeal (A := A) p) A] completionIdeal I p hp :=
    LinearMap.codRestrict (completionIdeal I p hp)
      (AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype)
      (completion_map_subtype_mem I p hp)
  have hf : Function.Bijective f := by
    constructor
    · intro x y hxy
      have hm : (f x : AdicCompletion (pAdicIdeal (A := A) p) A) = f y :=
        congrArg Subtype.val hxy
      change AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x =
        AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype y at hm
      apply completion_map_subtype_injective I p hp x y
      exact hm
    · intro z
      obtain ⟨x, hx⟩ := completion_map_subtype_surjective I p hp z
      refine ⟨x, ?_⟩
      apply Subtype.ext
      change AdicCompletion.map (pAdicIdeal (A := A) p) I.subtype x = z
      exact hx
  refine ⟨LinearEquiv.ofBijective f hf, ?_⟩
  intro x
  rfl

/-- Part (3), continuity: changing an element of `I` by an element of
`p^e I` changes every divided power by an element of `p^e I`. -/
@[stacks 07KD "part (3), continuity"]
public theorem dpow_pAdic_continuous (n e : ℕ) {x y : A}
    (hx : x ∈ I) (hy : y ∈ I) :
    γ.dpow n (x + (p : A) ^ e * y) - γ.dpow n x ∈
      pAdicIdeal (A := A) p ^ e • (I : Submodule A A) := by
  rw [γ.dpow_add hx (Ideal.mul_mem_left _ _ hy)]
  have hbase : γ.dpow n x =
      (Finset.antidiagonal n).sum fun ij =>
        γ.dpow ij.1 x * γ.dpow ij.2 (0 : A) := by
    rw [← γ.dpow_add hx I.zero_mem, add_zero]
  rw [hbase]
  rw [← Finset.sum_sub_distrib]
  apply Submodule.sum_mem
  intro ij hij
  by_cases hj : ij.2 = 0
  · simp [hj, γ.dpow_zero (Ideal.mul_mem_left _ _ hy), γ.dpow_zero I.zero_mem]
  · have hmem : γ.dpow ij.2 y ∈ I := γ.dpow_mem (by omega) hy
    have hele : e ≤ e * ij.2 := by
      calc
        e = e * 1 := by simp
        _ ≤ e * ij.2 := Nat.mul_le_mul_left e (Nat.one_le_iff_ne_zero.mpr hj)
    have hpj : (p : A) ^ (e * ij.2) ∈ pAdicIdeal (A := A) p ^ e :=
      Ideal.pow_le_pow_right hele (natCast_pow_mem_pAdicIdeal_pow p _)
    have hscaled : γ.dpow ij.2 ((p : A) ^ e * y) =
        (p : A) ^ (e * ij.2) * γ.dpow ij.2 y := by
      rw [γ.dpow_mul hy, ← pow_mul]
    rw [hscaled]
    rw [γ.dpow_eval_zero hj]
    have hterm : (p : A) ^ (e * ij.2) * γ.dpow ij.2 y ∈
        pAdicIdeal (A := A) p ^ e • (I : Submodule A A) :=
      Submodule.smul_mem_smul hpj hmem
    simpa [smul_eq_mul, mul_assoc] using
      Submodule.smul_mem (pAdicIdeal (A := A) p ^ e • (I : Submodule A A))
        (γ.dpow ij.1 x) hterm

public theorem dpow_congr_pAdic (n e : ℕ) {x y : A} (hx : x ∈ I) (_hy : y ∈ I)
    (hxy : y - x ∈ pAdicIdeal (A := A) p ^ e • (I : Submodule A A)) :
    γ.dpow n y - γ.dpow n x ∈ pAdicIdeal (A := A) p ^ e • (I : Submodule A A) := by
  have hmul : ∃ z ∈ I, y - x = (p : A) ^ e * z := by
    have hs := hxy
    rw [pAdicIdeal, Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul] at hs
    obtain ⟨z, hz, hEq⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hs
    exact ⟨z, hz, by simpa [smul_eq_mul] using hEq.symm⟩
  obtain ⟨z, hz, hEq⟩ := hmul
  have hrew : y = x + (p : A) ^ e * z := by rw [← hEq]; ring
  rw [hrew]
  exact dpow_pAdic_continuous I γ p n e hx hz

end Completion

end DividedPowers
