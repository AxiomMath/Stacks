module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.AdicCompletion.RingHom
public import StacksFrontier.RingTheory.AdicCompletion.EvalFactorPow
public import StacksFrontier.RingTheory.AdicCompletion.MapOfPowLe
public import StacksFrontier.RingTheory.DividedPowers.Extend

/-!
# The universal property of the `p`-adic completion of a divided power ring

Let `(R, I, γ)` be a divided power ring in which `p` is nilpotent modulo `I`, so that
[Stacks, Tag 07KD] equips the `p`-adic completion `R^∧` with the completed divided power ideal
`DividedPowers.completionIdeal` and the extended divided powers
`DividedPowers.completedDividedPowers`.  This file says what divided power morphisms *out of*
`R^∧` are: if the target `(S, J, δ)` is `p`-adically complete, then restriction along the
structure map `R → R^∧` is a bijection

`DPMorphism (R^∧, Î, γ̂) (S, J, δ)  ≃  DPMorphism (R, I, γ) (S, J, δ)`.

Existence is the passage to the limit: a divided power morphism `f : R → S` induces maps
`R^∧ → S ⧸ (p)^e` compatible with the transition maps, hence a ring map `R^∧ → S` because `S`
is `p`-adically complete, and that ring map is a divided power morphism because it is one at
every sufficiently large level of the `p`-adic tower, where the divided powers are the quotient
ones of [Stacks, Tag 07KD].  Uniqueness is the density of `R` in `R^∧`: any ring map out of
`R^∧` carries `(p)^n R^∧` into `(p)^n S`, every element of `R^∧` is congruent to an element of
`R` modulo `(p)^n R^∧`, and `S` is `p`-adically Hausdorff.

## Main results

* `DividedPowers.pAdicIdeal_map` — `(p)` is carried onto `(p)` by every ring map, and
  `DividedPowers.pAdicIdeal_fg` — `(p)` is finitely generated.
* `DividedPowers.isAdicComplete_pAdicIdeal_adicCompletion` — the `p`-adic completion of a ring
  is `p`-adically complete, so it is a legitimate target for this universal property too.
* `DividedPowers.completionDPMorphism` — the structure map `R → R^∧` as a divided power
  morphism.
* `DividedPowers.exists_dPMorphism_from_completion` — every divided power morphism out of `R`
  extends to one out of `R^∧`, for a `p`-adically complete target.
* `DividedPowers.dPMorphism_from_completion_ext` — two divided power morphisms out of `R^∧`
  which agree on `R` are equal, for a `p`-adically Hausdorff target.
* `DividedPowers.existsUnique_dPMorphism_from_completion` — the two together: **the universal
  property of the `p`-adic completion**.

## Implementation notes

The instance hypotheses `[Fact p.Prime]` and `[Algebra (IntegersAtPrime p) _]` are those of
`DividedPowers.eventually_isDividedPowerCompletionLimit`, which is what produces the level
beyond which the powers of `(p)` are sub divided power ideals; they are needed only for
existence.  Uniqueness needs nothing but `IsHausdorff (p) S`.

## References

* [Stacks Project, Tag 07KD](https://stacks.math.columbia.edu/tag/07KD)
-/

@[expose] public noncomputable section

namespace DividedPowers

universe u v

/-! ### The ideal `(p)` under ring maps and completion -/

section PAdicIdeal

variable {R : Type u} [CommRing R] {S : Type v} [CommRing S]

/-- The ideal generated by `p` is carried onto the ideal generated by `p` by any ring map. -/
public theorem pAdicIdeal_map (f : R →+* S) (p : ℕ) :
    (pAdicIdeal (A := R) p).map f = pAdicIdeal (A := S) p := by
  simp [pAdicIdeal, Ideal.map_span, Set.image_singleton]

/-- The ideal generated by `p` is finitely generated, being principal. -/
public theorem pAdicIdeal_fg (p : ℕ) : (pAdicIdeal (A := R) p).FG :=
  ⟨{(p : R)}, by simp [pAdicIdeal]⟩

/-- **The `p`-adic completion of a ring is `p`-adically complete.**  This is Mathlib's
`AdicCompletion.isAdicComplete_self` for the principal ideal `(p)`, whose image in the
completion is again `(p)`. -/
public instance isAdicComplete_pAdicIdeal_adicCompletion (p : ℕ) :
    IsAdicComplete (pAdicIdeal (A := AdicCompletion (pAdicIdeal (A := R) p) R) p)
      (AdicCompletion (pAdicIdeal (A := R) p) R) := by
  have h := AdicCompletion.isAdicComplete_self (pAdicIdeal (A := R) p) (pAdicIdeal_fg p)
  rwa [pAdicIdeal_map (algebraMap R (AdicCompletion (pAdicIdeal (A := R) p) R)) p] at h

end PAdicIdeal

/-! ### The structure map of the completion -/

section StructureMap

variable {R : Type u} [CommRing R] (I : Ideal R) (γ : DividedPowers I) (p : ℕ)
  (hp : IsNilpotent (Ideal.Quotient.mk I (p : R)))

/-- The composite of the structure map `R → R^∧` with the reduction `R^∧ → R ⧸ I` is the
reduction `R → R ⧸ I`. -/
public theorem completionToQuotient_algebraMap (x : R) :
    completionToQuotient I p hp (algebraMap R (AdicCompletion (pAdicIdeal p) R) x) =
      Ideal.Quotient.mk I x := by
  change (Ideal.Quotient.factor (pAdicIdeal_pow_nilpotencyExponent_le I p hp))
    (AdicCompletion.evalₐ (pAdicIdeal p) (nilpotencyExponent I p hp)
      (AdicCompletion.of _ R x)) = _
  simp

/-- The structure map `R → R^∧` carries `I` into the completed divided power ideal. -/
public theorem algebraMap_mem_completionIdeal {x : R} (hx : x ∈ I) :
    algebraMap R (AdicCompletion (pAdicIdeal p) R) x ∈ completionIdeal I p hp := by
  change completionToQuotient I p hp (algebraMap R _ x) = 0
  rw [completionToQuotient_algebraMap]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx

/-- **The structure map `R → R^∧` as a divided power morphism** onto the completed divided
power ideal of [Stacks, Tag 07KD]. -/
public def completionDPMorphism :
    DPMorphism γ (completedDividedPowers I γ p hp).1 where
  toRingHom := algebraMap R (AdicCompletion (pAdicIdeal p) R)
  ideal_comp := Ideal.map_le_iff_le_comap.mpr fun _ hx => algebraMap_mem_completionIdeal I p hp hx
  dpow_comp {n} x hx := (completedDividedPowers I γ p hp).2 n x hx
    ⟨algebraMap R _ x, algebraMap_mem_completionIdeal I p hp hx⟩ rfl

/-- `p` is nilpotent modulo the completed divided power ideal of `R^∧` as soon as it is
nilpotent modulo `I`: a power of `p` lying in `I` has its image in the completed ideal. -/
public theorem isNilpotent_mk_completionIdeal :
    IsNilpotent (Ideal.Quotient.mk (completionIdeal I p hp)
      (p : AdicCompletion (pAdicIdeal (A := R) p) R)) := by
  obtain ⟨n, hn⟩ := id hp
  refine ⟨n, ?_⟩
  have hmem : (p : R) ^ n ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp (by rwa [map_pow])
  have himg := algebraMap_mem_completionIdeal I p hp hmem
  rw [map_pow, map_natCast] at himg
  rw [← map_pow]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr himg

/-- The underlying ring map of `completionDPMorphism` is the structure map `R → R^∧`. -/
@[simp]
public theorem completionDPMorphism_toRingHom :
    (completionDPMorphism I γ p hp).toRingHom =
      algebraMap R (AdicCompletion (pAdicIdeal p) R) := rfl

end StructureMap

/-! ### The universal property -/

section UniversalProperty

variable {R : Type u} [CommRing R] {S : Type v} [CommRing S]

/-- The map `R ⧸ (p)^n → S ⧸ (p)^n` induced by a ring map `R → S`. -/
private def pAdicQuotientMap (f : R →+* S) (p n : ℕ) :
    (R ⧸ pAdicIdeal (A := R) p ^ n) →+* (S ⧸ pAdicIdeal (A := S) p ^ n) :=
  Ideal.quotientMap _ f (Ideal.map_le_iff_le_comap.mp
    (le_of_eq (by simp [Ideal.map_pow, pAdicIdeal_map f p])))

/-- A divided power morphism induces one on the quotients by `(p)^n`, for the quotient divided
powers of [Stacks, Tag 07KD] on both sides. -/
private theorem pAdicQuotientMap_isDPMorphism {I : Ideal R} {J : Ideal S}
    {γ : DividedPowers I} {δ : DividedPowers J} (f : DPMorphism γ δ) (p n : ℕ)
    (hI : pAdicIdeal p ^ n ≤ I) (hγ : γ.IsSubDPIdeal (pAdicIdeal p ^ n))
    (hJ : pAdicIdeal p ^ n ≤ J) (hδ : δ.IsSubDPIdeal (pAdicIdeal p ^ n)) :
    (quotientDividedPowers I γ p n hI hγ).IsDPMorphism
      (quotientDividedPowers J δ p n hJ hδ) (pAdicQuotientMap f.toRingHom p n) := by
  apply IsDPMorphism.of_comp γ _ _ (Ideal.Quotient.mk _) _ rfl
  · exact Quotient.isDPMorphism γ _
  · have hq : δ.IsDPMorphism (quotientDividedPowers J δ p n hJ hδ)
        (Ideal.Quotient.mk (pAdicIdeal p ^ n)) := Quotient.isDPMorphism δ _
    convert hq.comp _ f.isDPMorphism using 1
    ext z
    rfl

private def completionQuotientMap (f : R →+* S) (p n : ℕ) :
    AdicCompletion (pAdicIdeal (A := R) p) R →+* S ⧸ pAdicIdeal (A := S) p ^ n :=
  (pAdicQuotientMap f p n).comp (AdicCompletion.evalₐ (pAdicIdeal (A := R) p) n).toRingHom

private theorem factorPow_comp_completionQuotientMap (f : R →+* S) (p : ℕ) {m n : ℕ}
    (h : m ≤ n) :
    (Ideal.Quotient.factorPow (pAdicIdeal (A := S) p) h).comp (completionQuotientMap f p n) =
      completionQuotientMap f p m := by
  ext z
  have hh : (Ideal.Quotient.factorPow (pAdicIdeal (A := S) p) h).comp (pAdicQuotientMap f p n) =
      (pAdicQuotientMap f p m).comp (Ideal.Quotient.factorPow (pAdicIdeal (A := R) p) h) := by
    ext z
    rfl
  change (Ideal.Quotient.factorPow (pAdicIdeal (A := S) p) h)
    (pAdicQuotientMap f p n (AdicCompletion.evalₐ (pAdicIdeal (A := R) p) n z)) = _
  rw [← RingHom.comp_apply, hh, RingHom.comp_apply]
  exact congrArg (pAdicQuotientMap f p m) (AdicCompletion.factorPow_evalₐ _ h z)

private def completionLift (f : R →+* S) (p : ℕ) [IsAdicComplete (pAdicIdeal (A := S) p) S] :
    AdicCompletion (pAdicIdeal (A := R) p) R →+* S :=
  IsAdicComplete.liftRingHom (pAdicIdeal (A := S) p) (completionQuotientMap f p)
    (fun h => factorPow_comp_completionQuotientMap f p h)

/-- Two elements of a `p`-adically Hausdorff ring with the same image modulo every `(p)^n` are
equal. -/
private theorem eq_of_forall_mk_eq (p : ℕ) [IsHausdorff (pAdicIdeal (A := S) p) S] {a b : S}
    (h : ∀ n, Ideal.Quotient.mk (pAdicIdeal (A := S) p ^ n) a =
      Ideal.Quotient.mk (pAdicIdeal (A := S) p ^ n) b) : a = b :=
  congrFun (IsHausdorff.funext' (R := Unit) (pAdicIdeal (A := S) p)
    (f := fun _ => a) (g := fun _ => b) fun n _ => h n) ()

private theorem mk_completionLift (f : R →+* S) (p : ℕ)
    [IsAdicComplete (pAdicIdeal (A := S) p) S] (n : ℕ)
    (z : AdicCompletion (pAdicIdeal (A := R) p) R) :
    Ideal.Quotient.mk (pAdicIdeal (A := S) p ^ n) (completionLift f p z) =
      completionQuotientMap f p n z :=
  IsAdicComplete.mk_liftRingHom _ _ _ n z

private theorem completionLift_comp_algebraMap (f : R →+* S) (p : ℕ)
    [IsAdicComplete (pAdicIdeal (A := S) p) S] :
    (completionLift f p).comp (algebraMap R (AdicCompletion (pAdicIdeal p) R)) = f := by
  ext z
  refine eq_of_forall_mk_eq p fun n => ?_
  rw [RingHom.comp_apply, mk_completionLift]
  change pAdicQuotientMap f p n (AdicCompletion.evalₐ (pAdicIdeal (A := R) p) n
    (AdicCompletion.of (pAdicIdeal (A := R) p) R z)) = _
  rw [AdicCompletion.evalₐ_of]
  rfl

variable (I : Ideal R) (γ : DividedPowers I) (J : Ideal S) (δ : DividedPowers J) (p : ℕ)

private theorem completionLift_isDPMorphism [Fact p.Prime]
    [Algebra (IntegersAtPrime p) R] [Algebra (IntegersAtPrime p) S]
    (hpR : IsNilpotent (Ideal.Quotient.mk I (p : R)))
    (hpS : IsNilpotent (Ideal.Quotient.mk J (p : S)))
    [IsAdicComplete (pAdicIdeal (A := S) p) S] (f : DPMorphism γ δ) :
    (completedDividedPowers I γ p hpR).1.IsDPMorphism δ (completionLift f.toRingHom p) := by
  classical
  have hg := mk_completionLift f.toRingHom p
  obtain ⟨N, hN, hlim⟩ := eventually_isDividedPowerCompletionLimit.{u, 0} I γ p hpR
  obtain ⟨M, hM, -⟩ := eventually_isDividedPowerCompletionLimit.{v, 0} J δ p hpS
  have hF (n : ℕ) (hn : N ≤ n) (hm : M ≤ n) :
      (completedDividedPowers I γ p hpR).1.IsDPMorphism
        (quotientDividedPowers J δ p n (hM n hm).1 (hM n hm).2)
        (completionQuotientMap f.toRingHom p n) :=
    (pAdicQuotientMap_isDPMorphism f p n (hN n hn).1 (hN n hn).2
      (hM n hm).1 (hM n hm).2).comp _ (hlim.1 n hn)
  have hgi : (completionIdeal I p hpR).map (completionLift f.toRingHom p) ≤ J := by
    refine Ideal.map_le_iff_le_comap.mpr fun z hz => ?_
    have hmem := (hF (max N M) (le_max_left _ _) (le_max_right _ _)).ideal_comp
      (Ideal.mem_map_of_mem (completionQuotientMap f.toRingHom p (max N M)) hz)
    rw [← hg] at hmem
    have hmem' : completionLift f.toRingHom p z ∈
        Ideal.comap (Ideal.Quotient.mk (pAdicIdeal (A := S) p ^ max N M))
          (J.map (Ideal.Quotient.mk (pAdicIdeal (A := S) p ^ max N M))) := hmem
    rwa [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr (hM _ (le_max_right _ _)).1] at hmem'
  refine ⟨hgi, fun {k} z hz => ?_⟩
  refine eq_of_forall_mk_eq p fun n => ?_
  obtain ⟨e, hne, hNe, hMe⟩ : ∃ e, n ≤ e ∧ N ≤ e ∧ M ≤ e :=
    ⟨n + N + M, by omega, by omega, by omega⟩
  have hh := (hF e hNe hMe).dpow_comp (n := k) z hz
  have hq : δ.IsDPMorphism (quotientDividedPowers J δ p e (hM e hMe).1 (hM e hMe).2)
      (Ideal.Quotient.mk (pAdicIdeal (A := S) p ^ e)) := Quotient.isDPMorphism δ _
  rw [← hg e z, hq.dpow_comp (completionLift f.toRingHom p z)
    (hgi (Ideal.mem_map_of_mem _ hz)), ← hg] at hh
  have hh' := congrArg (Ideal.Quotient.factor (Ideal.pow_le_pow_right hne)) hh
  simpa only [Ideal.Quotient.factor_mk] using hh'

/-- **Existence in the universal property of the `p`-adic completion.**  A divided power
morphism `f : (R, I, γ) → (S, J, δ)` into a `p`-adically complete divided power ring extends
along `R → R^∧` to a divided power morphism out of the completed divided power ring of
[Stacks, Tag 07KD].

The underlying ring map is assembled from the compatible family of maps `R^∧ → S ⧸ (p)^e`, and
it is a divided power morphism because at every level `e` beyond which the powers of `(p)` are
sub divided power ideals of both `I` and `J` it agrees with the divided power morphism induced
by `f` on the quotients. -/
public theorem exists_dPMorphism_from_completion [Fact p.Prime]
    [Algebra (IntegersAtPrime p) R] [Algebra (IntegersAtPrime p) S]
    (hpR : IsNilpotent (Ideal.Quotient.mk I (p : R)))
    (hpS : IsNilpotent (Ideal.Quotient.mk J (p : S)))
    [IsAdicComplete (pAdicIdeal (A := S) p) S]
    (f : DPMorphism γ δ) :
    ∃ g : DPMorphism (completedDividedPowers I γ p hpR).1 δ,
      g.toRingHom.comp (algebraMap R (AdicCompletion (pAdicIdeal p) R)) = f.toRingHom :=
  ⟨DPMorphism.mk' (completionLift_isDPMorphism I γ J δ p hpR hpS f),
    completionLift_comp_algebraMap f.toRingHom p⟩

/-- **Uniqueness in the universal property of the `p`-adic completion.**  Two divided power
morphisms out of the completed divided power ring of [Stacks, Tag 07KD] which agree on `R` are
equal, as soon as the target is `p`-adically Hausdorff.

No continuity hypothesis is needed: a ring map carries `(p)^n R^∧` into `(p)^n S` because `(p)`
is generated by `p`, and every element of `R^∧` is congruent to an element of `R` modulo
`(p)^n R^∧`. -/
public theorem dPMorphism_from_completion_ext
    (hpR : IsNilpotent (Ideal.Quotient.mk I (p : R)))
    [IsHausdorff (pAdicIdeal (A := S) p) S]
    (g₁ g₂ : DPMorphism (completedDividedPowers I γ p hpR).1 δ)
    (h : g₁.toRingHom.comp (algebraMap R (AdicCompletion (pAdicIdeal p) R)) =
      g₂.toRingHom.comp (algebraMap R (AdicCompletion (pAdicIdeal p) R))) :
    g₁ = g₂ := by
  have key : ∀ (φ : AdicCompletion (pAdicIdeal (A := R) p) R →+* S) (n : ℕ)
      (z : AdicCompletion (pAdicIdeal (A := R) p) R),
      z ∈ (pAdicIdeal (A := R) p ^ n).map
          (algebraMap R (AdicCompletion (pAdicIdeal (A := R) p) R)) →
        φ z ∈ pAdicIdeal (A := S) p ^ n := by
    intro φ n z hz
    have h1 : φ z ∈ Ideal.map φ ((pAdicIdeal (A := R) p ^ n).map
        (algebraMap R (AdicCompletion (pAdicIdeal (A := R) p) R))) :=
      Ideal.mem_map_of_mem _ hz
    rwa [Ideal.map_map, Ideal.map_pow,
      pAdicIdeal_map (φ.comp (algebraMap R
        (AdicCompletion (pAdicIdeal (A := R) p) R))) p] at h1
  apply DPMorphism.ext
  funext z
  refine eq_of_forall_mk_eq p fun n => ?_
  obtain ⟨a, ha⟩ := AdicCompletion.exists_sub_mem_map_pow
    (pAdicIdeal (A := R) p) (pAdicIdeal_fg p) n z
  have ha' : g₁.toRingHom (algebraMap R _ a) = g₂.toRingHom (algebraMap R _ a) :=
    congrArg (fun q : R →+* S => q a) h
  have hsub := Submodule.sub_mem (pAdicIdeal (A := S) p ^ n : Ideal S)
    (key g₁.toRingHom n _ ha) (key g₂.toRingHom n _ ha)
  rw [map_sub, map_sub, ha', sub_sub_sub_cancel_right] at hsub
  exact Ideal.Quotient.eq.mpr hsub

/-- **The universal property of the `p`-adic completion of a divided power ring.**

Let `(R, I, γ)` be a divided power ring with `p` nilpotent modulo `I` and let `(S, J, δ)` be a
`p`-adically complete divided power ring with `p` nilpotent modulo `J`.  Then every divided
power morphism `R → S` extends along the structure map `R → R^∧` to a *unique* divided power
morphism out of the completed divided power ring of [Stacks, Tag 07KD]. -/
public theorem existsUnique_dPMorphism_from_completion [Fact p.Prime]
    [Algebra (IntegersAtPrime p) R] [Algebra (IntegersAtPrime p) S]
    (hpR : IsNilpotent (Ideal.Quotient.mk I (p : R)))
    (hpS : IsNilpotent (Ideal.Quotient.mk J (p : S)))
    [IsAdicComplete (pAdicIdeal (A := S) p) S]
    (f : DPMorphism γ δ) :
    ∃! g : DPMorphism (completedDividedPowers I γ p hpR).1 δ,
      g.toRingHom.comp (algebraMap R (AdicCompletion (pAdicIdeal p) R)) = f.toRingHom := by
  obtain ⟨g, hgf⟩ := exists_dPMorphism_from_completion I γ J δ p hpR hpS f
  exact ⟨g, hgf, fun g' hg' => dPMorphism_from_completion_ext I γ J δ p hpR g' g
    (hg'.trans hgf.symm)⟩

/-- `DividedPowers.existsUnique_dPMorphism_from_completion` with the extension condition read as
an equality of divided power morphisms rather than of ring homomorphisms. -/
public theorem existsUnique_dPMorphism_comp_completionDPMorphism [Fact p.Prime]
    [Algebra (IntegersAtPrime p) R] [Algebra (IntegersAtPrime p) S]
    (hpR : IsNilpotent (Ideal.Quotient.mk I (p : R)))
    (hpS : IsNilpotent (Ideal.Quotient.mk J (p : S)))
    [IsAdicComplete (pAdicIdeal (A := S) p) S]
    (f : DPMorphism γ δ) :
    ∃! g : DPMorphism (completedDividedPowers I γ p hpR).1 δ,
      g.comp (completionDPMorphism I γ p hpR) = f := by
  obtain ⟨g, hgf⟩ := exists_dPMorphism_from_completion I γ J δ p hpR hpS f
  exact ⟨g, DPMorphism.ext (funext fun x => congrArg (fun q : R →+* S => q x) hgf),
    fun g' hg' => dPMorphism_from_completion_ext I γ J δ p hpR g' g
      ((congrArg DPMorphism.toRingHom hg').trans hgf.symm)⟩

end UniversalProperty

end DividedPowers

end
