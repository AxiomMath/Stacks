/-!
# Divided power rings: colimits

The category `DividedPowerRing` has all colimits.  Products and equalizers are built
concretely, which gives all small limits, and the constant-diagram functor satisfies the
solution set condition: every cocone factors through a small divided power ring generated by
formal divided power terms in the images of the diagram.  The adjoint functor theorem then makes
the constant-diagram functor a right adjoint.

## Main results

* `DividedPowerRing.instHasColimits` — the category of divided power rings has all colimits.

## References

* [Stacks Project, Tag 07GX](https://stacks.math.columbia.edu/tag/07GX)
-/

@[expose] public section

universe u

namespace DividedPowerRing

section SmallColimits

open CategoryTheory Limits

/-- Divided powers restricted from an ideal `I` of `R` to a subring `S` closed under the divided
power operations, as divided powers on `I.comap S.subtype`. -/
public noncomputable def restrictDividedPowers {R : Type u} [CommRing R]
    (I : Ideal R) (dp : _root_.DividedPowers I) (S : Subring R)
    (hS : ∀ n x, x ∈ S → x ∈ I → dp.dpow n x ∈ S) :
    _root_.DividedPowers (I.comap S.subtype) where
  dpow n x := open scoped Classical in if hx : x ∈ I.comap S.subtype then
    ⟨dp.dpow n x.val, hS n x.val x.property hx⟩ else 0
  dpow_null hx := dite_eq_right hx
  dpow_zero hx := by
    rw [dite_eq_left hx]
    apply Subtype.ext
    exact dp.dpow_zero hx
  dpow_one hx := by
    rw [dite_eq_left hx]
    apply Subtype.ext
    exact dp.dpow_one hx
  dpow_mem hn hx := by
    rw [dite_eq_left hx]
    exact dp.dpow_mem hn hx
  dpow_add {n} {x y} hx hy := by
    have hxy : x + y ∈ I.comap S.subtype := (I.comap S.subtype).add_mem hx hy
    rw [dite_eq_left hxy]
    apply Subtype.ext
    simpa [map_sum, map_mul, dite_eq_left hx, dite_eq_left hy] using
      dp.dpow_add hx hy
  dpow_mul {n} {a x} hx := by
    have hax : a * x ∈ I.comap S.subtype := (I.comap S.subtype).mul_mem_left a hx
    rw [dite_eq_left hax, dite_eq_left hx]
    apply Subtype.ext
    exact dp.dpow_mul hx
  mul_dpow {m n x} hx := by
    rw [dite_eq_left hx, dite_eq_left hx, dite_eq_left hx]
    apply Subtype.ext
    exact dp.mul_dpow hx
  dpow_comp m {n x} hn hx := by
    have hmem : (⟨dp.dpow n x.val, hS n x.val x.property hx⟩ : S) ∈
        I.comap S.subtype := dp.dpow_mem hn hx
    rw [dite_eq_left hx, dite_eq_left hmem, dite_eq_left hx]
    apply Subtype.ext
    exact dp.dpow_comp hn hx

private noncomputable def piDividedPowers {ι : Type u}
    (A : ι → DividedPowerRing.{u}) :
    _root_.DividedPowers (Ideal.pi (fun i ↦ (A i).ideal)) where
  dpow n x := open scoped Classical in if hx : x ∈ Ideal.pi (fun i ↦ (A i).ideal) then
    fun i ↦ (A i).dividedPowers.dpow n (x i) else 0
  dpow_null hx := dite_eq_right hx
  dpow_zero hx := by
    rw [dite_eq_left hx]
    funext i
    exact (A i).dividedPowers.dpow_zero (hx i)
  dpow_one hx := by
    rw [dite_eq_left hx]
    funext i
    exact (A i).dividedPowers.dpow_one (hx i)
  dpow_mem hn hx := by
    rw [dite_eq_left hx]
    intro i
    exact (A i).dividedPowers.dpow_mem hn (hx i)
  dpow_add {n} {x y} hx hy := by
    have hxy : x + y ∈ Ideal.pi (fun i ↦ (A i).ideal) :=
      (Ideal.pi (fun i ↦ (A i).ideal)).add_mem hx hy
    rw [dite_eq_left hxy]
    funext i
    simp only [Pi.add_apply, Finset.sum_apply, dite_eq_left hx, dite_eq_left hy, Pi.mul_apply]
    exact (A i).dividedPowers.dpow_add (hx i) (hy i)
  dpow_mul {n} {a x} hx := by
    have hax : a * x ∈ Ideal.pi (fun i ↦ (A i).ideal) :=
      (Ideal.pi (fun i ↦ (A i).ideal)).mul_mem_left a hx
    rw [dite_eq_left hax, dite_eq_left hx]
    funext i
    exact (A i).dividedPowers.dpow_mul (hx i)
  mul_dpow {m n x} hx := by
    rw [dite_eq_left hx, dite_eq_left hx, dite_eq_left hx]
    funext i
    exact (A i).dividedPowers.mul_dpow (hx i)
  dpow_comp m {n x} hn hx := by
    have hnmem : (fun i ↦ (A i).dividedPowers.dpow n (x i)) ∈
        Ideal.pi (fun i ↦ (A i).ideal) := by
      intro i
      exact (A i).dividedPowers.dpow_mem hn (hx i)
    rw [dite_eq_left hx, dite_eq_left hnmem, dite_eq_left hx]
    funext i
    exact (A i).dividedPowers.dpow_comp hn (hx i)

private theorem piDividedPowers_apply {ι : Type u}
    (A : ι → DividedPowerRing.{u}) (n : ℕ)
    (x : ∀ i, A i) (hx : x ∈ Ideal.pi (fun i ↦ (A i).ideal)) (i : ι) :
    (piDividedPowers A).dpow n x i = (A i).dividedPowers.dpow n (x i) := by
  simp [piDividedPowers, hx]

private noncomputable def product {ι : Type u}
    (A : ι → DividedPowerRing.{u}) : DividedPowerRing.{u} where
  carrier := ∀ i, A i
  ideal := Ideal.pi (fun i ↦ (A i).ideal)
  dividedPowers := piDividedPowers A

private noncomputable def projection {ι : Type u}
    (A : ι → DividedPowerRing.{u}) (i : ι) : product A ⟶ A i := by
  let f : (∀ j, A j) →+* A i := Pi.evalRingHom (fun j ↦ A j) i
  refine DividedPowers.DPMorphism.mk' (f := f) ?_
  refine ⟨?_, ?_⟩
  · apply Ideal.map_le_of_le_comap
    intro x hx
    exact hx i
  · intro n x hx
    change x ∈ Ideal.pi (fun j ↦ (A j).ideal) at hx
    change (A i).dividedPowers.dpow n (x i) = (piDividedPowers A).dpow n x i
    exact (piDividedPowers_apply A n x hx i).symm

private noncomputable def productLift {ι : Type u}
    (A : ι → DividedPowerRing.{u})
    (B : DividedPowerRing.{u}) (f : ∀ i, B ⟶ A i) : B ⟶ product A := by
  let g : B →+* (∀ i, A i) := RingHom.pi (fun i ↦ (f i).toRingHom)
  refine DividedPowers.DPMorphism.mk' (f := g) ?_
  refine ⟨?_, ?_⟩
  · apply Ideal.map_le_of_le_comap
    intro x hx i
    exact (f i).ideal_comp (Ideal.mem_map_of_mem (f i).toRingHom hx)
  · intro n x hx
    have hg : g x ∈ Ideal.pi (fun i ↦ (A i).ideal) := by
      intro i
      exact (f i).ideal_comp (Ideal.mem_map_of_mem (f i).toRingHom hx)
    change (piDividedPowers A).dpow n (g x) = g (B.dividedPowers.dpow n x)
    funext i
    rw [piDividedPowers_apply A n (g x) hg i]
    exact (f i).dpow_comp x hx

private noncomputable def productFan {ι : Type u}
    (A : ι → DividedPowerRing.{u}) : Fan A :=
  Fan.mk (product A) (projection A)

private noncomputable def productFanIsLimit {ι : Type u}
    (A : ι → DividedPowerRing.{u}) : IsLimit (productFan A) where
  lift s := productLift A s.pt (fun i ↦ s.π.app ⟨i⟩)
  fac s i := by
    apply DividedPowers.DPMorphism.ext
    funext x
    rfl
  uniq s m h := by
    apply DividedPowers.DPMorphism.ext
    funext x
    funext i
    have hi := ConcreteCategory.congr_hom (h ⟨i⟩) x
    exact hi

private instance : HasProducts.{u} (DividedPowerRing.{u}) :=
  hasProducts_of_limit_fans productFan productFanIsLimit

private theorem equalizerStable {A B : DividedPowerRing.{u}}
    (f g : A ⟶ B) (n : ℕ) (x : A)
    (hx : x ∈ f.toRingHom.eqLocus g.toRingHom) (hI : x ∈ A.ideal) :
    A.dividedPowers.dpow n x ∈ f.toRingHom.eqLocus g.toRingHom := by
  show f.toRingHom (A.dividedPowers.dpow n x) =
    g.toRingHom (A.dividedPowers.dpow n x)
  rw [← f.dpow_comp x hI, ← g.dpow_comp x hI]
  exact congrArg (B.dividedPowers.dpow n) hx

private noncomputable def equalizer {A B : DividedPowerRing.{u}}
    (f g : A ⟶ B) : DividedPowerRing.{u} where
  carrier := f.toRingHom.eqLocus g.toRingHom
  ideal := A.ideal.comap (f.toRingHom.eqLocus g.toRingHom).subtype
  dividedPowers := restrictDividedPowers A.ideal A.dividedPowers _
    (equalizerStable f g)


/-- A subring of a divided power ring closed under the divided power operations, as a divided
power ring. -/
private noncomputable def subDividedPowerRing {A : DividedPowerRing.{u}} (S : Subring A)
    (hS : ∀ n x, x ∈ S → x ∈ A.ideal → A.dividedPowers.dpow n x ∈ S) :
    DividedPowerRing.{u} where
  carrier := S
  ideal := A.ideal.comap S.subtype
  dividedPowers := restrictDividedPowers A.ideal A.dividedPowers S hS

/-- The inclusion of a divided power subring. -/
private noncomputable def subDividedPowerRingInclusion {A : DividedPowerRing.{u}} (S : Subring A)
    (hS : ∀ n x, x ∈ S → x ∈ A.ideal → A.dividedPowers.dpow n x ∈ S) :
    subDividedPowerRing S hS ⟶ A := by
  refine DividedPowers.DPMorphism.mk' (f := S.subtype) ⟨?_, ?_⟩
  · exact Ideal.map_le_of_le_comap le_rfl
  · intro n (x : S) hx
    change x ∈ A.ideal.comap S.subtype at hx
    change A.dividedPowers.dpow n x.val =
      ((restrictDividedPowers A.ideal A.dividedPowers S hS).dpow n x).val
    dsimp only [restrictDividedPowers]
    rw [dite_eq_left hx]

/-- A divided power morphism with image in a divided power subring lifts to it. -/
private noncomputable def subDividedPowerRingLift {A C : DividedPowerRing.{u}} (S : Subring A)
    (hS : ∀ n x, x ∈ S → x ∈ A.ideal → A.dividedPowers.dpow n x ∈ S) (h : C ⟶ A)
    (hh : ∀ x, h.toRingHom x ∈ S) : C ⟶ subDividedPowerRing S hS := by
  let q : C →+* S := h.toRingHom.codRestrict S hh
  refine DividedPowers.DPMorphism.mk' (f := q) ⟨?_, ?_⟩
  · apply Ideal.map_le_of_le_comap
    intro x hx
    exact h.ideal_comp (Ideal.mem_map_of_mem h.toRingHom hx)
  · intro n x hx
    apply Subtype.ext
    have hqx : q x ∈ A.ideal.comap S.subtype :=
      h.ideal_comp (Ideal.mem_map_of_mem h.toRingHom hx)
    change ((restrictDividedPowers A.ideal A.dividedPowers S hS).dpow n (q x)).val =
      h.toRingHom (C.dividedPowers.dpow n x)
    simp [restrictDividedPowers, hqx, ← h.dpow_comp x hx, q]

private noncomputable def equalizerFork {A B : DividedPowerRing.{u}}
    (f g : A ⟶ B) : Fork f g :=
  Fork.ofι (subDividedPowerRingInclusion (f.toRingHom.eqLocus g.toRingHom)
    (equalizerStable f g)) (by
    apply DividedPowers.DPMorphism.ext
    funext x
    exact x.property)

private noncomputable def equalizerForkIsLimit {A B : DividedPowerRing.{u}}
    (f g : A ⟶ B) : IsLimit (equalizerFork f g) := by
  fapply Fork.IsLimit.mk'
  intro s
  use subDividedPowerRingLift (f.toRingHom.eqLocus g.toRingHom) (equalizerStable f g) s.ι
    (fun x ↦ ConcreteCategory.congr_hom s.condition x)
  constructor
  · apply DividedPowers.DPMorphism.ext
    funext x
    rfl
  · intro m hm
    apply DividedPowers.DPMorphism.ext
    funext x
    apply Subtype.ext
    exact ConcreteCategory.congr_hom hm x

private instance {A B : DividedPowerRing.{u}} (f g : A ⟶ B) :
    HasLimit (parallelPair f g) :=
  HasLimit.mk ⟨equalizerFork f g, equalizerForkIsLimit f g⟩

private instance : HasEqualizers (DividedPowerRing.{u}) :=
  hasEqualizers_of_hasLimit_parallelPair _

private instance : HasLimitsOfSize.{u, u} (DividedPowerRing.{u}) :=
  has_limits_of_hasEqualizers_and_products

/-- Formal divided power terms in a set of generators `G`: the expressions built from the
generators by the ring operations and the divided power operations. -/
public inductive DPTerm (G : Type u) : Type u where
  | gen : G → DPTerm G
  | zero : DPTerm G
  | one : DPTerm G
  | add : DPTerm G → DPTerm G → DPTerm G
  | neg : DPTerm G → DPTerm G
  | mul : DPTerm G → DPTerm G → DPTerm G
  | dpow : ℕ → DPTerm G → DPTerm G

private def evalTerm {G : Type u} (B : DividedPowerRing.{u})
    (v : G → B) : DPTerm G → B
  | .gen g => v g
  | .zero => 0
  | .one => 1
  | .add x y => evalTerm B v x + evalTerm B v y
  | .neg x => -(evalTerm B v x)
  | .mul x y => evalTerm B v x * evalTerm B v y
  | .dpow n x => B.dividedPowers.dpow n (evalTerm B v x)

private def termSubring {G : Type u} (B : DividedPowerRing.{u})
    (v : G → B) : Subring B where
  carrier := Set.range (evalTerm B v)
  zero_mem' := ⟨.zero, rfl⟩
  one_mem' := ⟨.one, rfl⟩
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨.add x y, rfl⟩
  neg_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨.neg x, rfl⟩
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨.mul x y, rfl⟩

private theorem termSubring_dpow {G : Type u} (B : DividedPowerRing.{u})
    (v : G → B) (n : ℕ) (x : B) (hx : x ∈ termSubring B v) :
    B.dividedPowers.dpow n x ∈ termSubring B v := by
  rcases hx with ⟨t, rfl⟩
  exact ⟨.dpow n t, rfl⟩

private noncomputable def termRingHom {G : Type u} (B : DividedPowerRing.{u})
    (v : G → B) : MvPolynomial (DPTerm G) ℤ →+* B :=
  MvPolynomial.eval₂Hom (Int.castRingHom B) (evalTerm B v)

private theorem termRingHom_rangeS {G : Type u} (B : DividedPowerRing.{u})
    (v : G → B) : (termRingHom B v).range = termSubring B v := by
  apply le_antisymm
  · intro x hx
    rcases hx with ⟨p, rfl⟩
    induction p using MvPolynomial.induction_on with
    | C a =>
        simp [termRingHom]
    | add p q hp hq =>
        simpa only [map_add] using (termSubring B v).add_mem hp hq
    | mul_X p t hp =>
        have ht : evalTerm B v t ∈ termSubring B v := ⟨t, rfl⟩
        simpa [termRingHom] using (termSubring B v).mul_mem hp ht
  · intro x hx
    rcases hx with ⟨t, rfl⟩
    exact ⟨MvPolynomial.X t, by simp [termRingHom]⟩

private theorem termRingHom_range_dpow_mem {G : Type u} (B : DividedPowerRing.{u})
    (v : G → B) (n : ℕ) (x : B) (hx : x ∈ (termRingHom B v).range) (_ : x ∈ B.ideal) :
    B.dividedPowers.dpow n x ∈ (termRingHom B v).range := by
  rw [termRingHom_rangeS] at hx ⊢
  exact termSubring_dpow B v n x hx

private noncomputable def rangeDividedPowers {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) :
    _root_.DividedPowers (B.ideal.comap (termRingHom B v).range.subtype) :=
  restrictDividedPowers B.ideal B.dividedPowers (termRingHom B v).range
    (termRingHom_range_dpow_mem B v)

private structure SmallDP (T : Type u) where
  kernel : Ideal (MvPolynomial T ℤ)
  ideal : Ideal (MvPolynomial T ℤ ⧸ kernel)
  dividedPowers : _root_.DividedPowers ideal

private noncomputable def SmallDP.toRing {T : Type u} (S : SmallDP T) :
    DividedPowerRing.{u} where
  carrier := MvPolynomial T ℤ ⧸ S.kernel
  ideal := S.ideal
  dividedPowers := S.dividedPowers

private noncomputable def smallDPOfTermRange {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) : SmallDP (DPTerm G) := by
  let p := termRingHom B v
  let e := RingHom.quotientKerEquivRange p
  let I : Ideal p.range := B.ideal.comap p.range.subtype
  let J : Ideal (MvPolynomial (DPTerm G) ℤ ⧸ RingHom.ker p) :=
    I.comap e.toRingHom
  refine ⟨RingHom.ker p, J, ?_⟩
  exact DividedPowers.ofRingEquiv (e := e.symm)
    (I := I) (J := J) (Ideal.map_comap_of_equiv e.symm) (rangeDividedPowers B v)

private noncomputable def termRange {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) :
    DividedPowerRing.{u} :=
  subDividedPowerRing (termRingHom B v).range (termRingHom_range_dpow_mem B v)

private noncomputable def termRangeInclusion {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) : termRange B v ⟶ B :=
  subDividedPowerRingInclusion _ _

private noncomputable def termRangeLift {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B)
    (A : DividedPowerRing.{u}) (f : A ⟶ B)
    (hf : ∀ x : A, f.toRingHom x ∈ termSubring B v) : A ⟶ termRange B v :=
  subDividedPowerRingLift _ _ f (fun x ↦ by rw [termRingHom_rangeS]; exact hf x)

private noncomputable def termRangeToSmall {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) :
    termRange B v ⟶ (smallDPOfTermRange B v).toRing := by
  let e := RingHom.quotientKerEquivRange (termRingHom B v)
  refine DividedPowers.DPMorphism.mk' (f := e.symm.toRingHom) ?_
  refine ⟨?_, ?_⟩
  · apply Ideal.map_le_of_le_comap
    intro x hx
    change e (e.symm x) ∈ B.ideal.comap (termRingHom B v).range.subtype
    change x ∈ B.ideal.comap (termRingHom B v).range.subtype at hx
    have he : e (e.symm x) = x := e.apply_symm_apply x
    rw [he]
    exact hx
  · intro n x hx
    change (DividedPowers.ofRingEquiv
      (Ideal.map_comap_of_equiv e.symm) (rangeDividedPowers B v)).dpow
      n (e.symm x) = e.symm ((rangeDividedPowers B v).dpow n x)
    exact DividedPowers.ofRingEquiv_dpow_apply
      (Ideal.map_comap_of_equiv e.symm) (rangeDividedPowers B v)

private noncomputable def smallToTermRange {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) :
    (smallDPOfTermRange B v).toRing ⟶ termRange B v := by
  let e := RingHom.quotientKerEquivRange (termRingHom B v)
  refine DividedPowers.DPMorphism.mk' (f := e.toRingHom) ?_
  refine ⟨?_, ?_⟩
  · apply Ideal.map_le_of_le_comap
    intro x hx
    exact hx
  · intro n x hx
    let x' : MvPolynomial (DPTerm G) ℤ ⧸ RingHom.ker (termRingHom B v) := x
    change (rangeDividedPowers B v).dpow n (e x') =
      e ((DividedPowers.ofRingEquiv
        (Ideal.map_comap_of_equiv e.symm) (rangeDividedPowers B v)).dpow n x')
    simp [DividedPowers.ofRingEquiv]

private theorem termRange_retraction {G : Type u}
    (B : DividedPowerRing.{u}) (v : G → B) :
    termRangeToSmall B v ≫ smallToTermRange B v = 𝟙 (termRange B v) := by
  apply DividedPowers.DPMorphism.ext
  funext x
  exact (RingHom.quotientKerEquivRange (termRingHom B v)).apply_symm_apply x

private def coconeGenerators {J : Type u} [Category.{u} J]
    (D : J ⥤ DividedPowerRing.{u})
    (B : DividedPowerRing.{u})
    (h : D ⟶ (Functor.const J).obj B) :
    (Σ j : J, D.obj j) → B :=
  fun ⟨j, x⟩ ↦ (h.app j).toRingHom x

private noncomputable def termRangeCocone {J : Type u} [Category.{u} J]
    (D : J ⥤ DividedPowerRing.{u})
    (B : DividedPowerRing.{u})
    (h : D ⟶ (Functor.const J).obj B) :
    D ⟶ (Functor.const J).obj (termRange B (coconeGenerators D B h)) where
  app j := termRangeLift B (coconeGenerators D B h) (D.obj j) (h.app j) (by
    intro x
    exact ⟨.gen ⟨j, x⟩, rfl⟩)
  naturality := by
    intro i j f
    apply DividedPowers.DPMorphism.ext
    funext x
    apply Subtype.ext
    change (h.app j).toRingHom ((D.map f).toRingHom x) =
      (h.app i).toRingHom x
    have hh := ConcreteCategory.congr_hom (h.naturality f) x
    change (h.app j).toRingHom ((D.map f).toRingHom x) =
      (h.app i).toRingHom x at hh
    exact hh

private theorem termRangeCocone_fac {J : Type u} [Category.{u} J]
    (D : J ⥤ DividedPowerRing.{u})
    (B : DividedPowerRing.{u})
    (h : D ⟶ (Functor.const J).obj B) :
    termRangeCocone D B h ≫
      (Functor.const J).map (termRangeInclusion B (coconeGenerators D B h)) = h := by
  ext j
  rfl

private theorem constSolutionSet {J : Type u} [Category.{u} J] :
    SolutionSetCondition.{u}
      (Functor.const J : DividedPowerRing.{u} ⥤
        (J ⥤ DividedPowerRing.{u})) := by
  intro D
  let G : Type u := Σ j : J, D.obj j
  let ι : Type u := Σ S : SmallDP (DPTerm G),
    D ⟶ (Functor.const J).obj S.toRing
  refine ⟨ι, (fun i ↦ i.1.toRing), (fun i ↦ i.2), ?_⟩
  intro B h
  let v := coconeGenerators D B h
  let S := smallDPOfTermRange B v
  let t := termRangeCocone D B h
  let k : D ⟶ (Functor.const J).obj S.toRing :=
    t ≫ (Functor.const J).map (termRangeToSmall B v)
  let g : S.toRing ⟶ B :=
    smallToTermRange B v ≫ termRangeInclusion B v
  refine ⟨⟨S, k⟩, g, ?_⟩
  show k ≫ (Functor.const J).map g = h
  calc
    k ≫ (Functor.const J).map g =
        t ≫ (Functor.const J).map (termRangeToSmall B v ≫ g) := by
          simp [k, Functor.map_comp, Category.assoc]
    _ = t ≫ (Functor.const J).map (termRangeInclusion B v) := by
          congr 1
          congr 1
          show termRangeToSmall B v ≫ smallToTermRange B v ≫
            termRangeInclusion B v = termRangeInclusion B v
          rw [← Category.assoc, termRange_retraction, Category.id_comp]
    _ = h := termRangeCocone_fac D B h

/-- The category of divided power rings has all colimits. -/
@[stacks 07GX]
public instance instHasColimits : HasColimits (DividedPowerRing.{u}) := by
  refine ⟨fun J _ ↦ ?_⟩
  apply hasColimitsOfShape_iff_isRightAdjoint_const.mpr
  exact isRightAdjoint_of_preservesLimits_of_solutionSetCondition _ (constSolutionSet (J := J))

end SmallColimits

end DividedPowerRing
