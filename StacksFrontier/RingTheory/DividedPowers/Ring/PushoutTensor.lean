/-!
# Divided power rings: images and the tensor product of a pushout

Two divided power morphisms with a common target factor through the divided power subring
generated by their images.  Given a pushout square of divided power rings with legs
`g : B ⟶ B''` and `g' : B' ⟶ B''`, the canonical map `B ⊗_A B' → B''` is surjective, and it
carries the sum of the two extended divided power ideals onto the distinguished ideal of `B''`.

## Main definitions

* `DividedPowerRing.image` — the divided power subring of a common target generated by the
  images of two divided power morphisms, with `DividedPowerRing.imageSubring`,
  `DividedPowerRing.imageIdeal` and `DividedPowerRing.imageDividedPowers` its three pieces.
* `DividedPowerRing.tensorProductToPushout` and
  `DividedPowerRing.canonicalTensorProductHom` — the canonical ring map from the tensor product
  of the underlying rings to the vertex of a commuting square of divided power rings.

## Main results

* `DividedPowerRing.imageLeftMorphism_comp_imageInclusion` and
  `DividedPowerRing.imageRightMorphism_comp_imageInclusion` — two divided power morphisms with a
  common target factor through the divided power subring generated by their images.
* `DividedPowerRing.tensorProductToPushout_surjective` — for a pushout, the canonical map from
  the tensor product of the underlying rings is surjective.
* `DividedPowerRing.dividedPowerIdeal_surjective_of_isPushout` — it carries the sum of the two
  extended divided power ideals onto the distinguished ideal of the pushout.

## References

* [Stacks Project, Tag 0H86](https://stacks.math.columbia.edu/tag/0H86)
-/

@[expose] public section

universe u

namespace DividedPowerRing

section ImageSubring

open CategoryTheory

variable {B B' C : DividedPowerRing.{u}}

/-- The subring generated by the images of two divided power morphisms with common target. -/
public def imageSubring (f : B ⟶ C) (g : B' ⟶ C) : Subring C :=
  f.toRingHom.range ⊔ g.toRingHom.range

/-- The factorization of the first map through the subring generated by both images. -/
public def imageLeftHom (f : B ⟶ C) (g : B' ⟶ C) : B →+* imageSubring f g :=
  f.toRingHom.codRestrict (imageSubring f g) fun x ↦
    (show f x ∈ f.toRingHom.range ⊔ g.toRingHom.range from
      (le_sup_left : f.toRingHom.range ≤ f.toRingHom.range ⊔ g.toRingHom.range)
        (f.toRingHom.mem_range_self x))

/-- The factorization of the second map through the subring generated by both images. -/
public def imageRightHom (f : B ⟶ C) (g : B' ⟶ C) : B' →+* imageSubring f g :=
  g.toRingHom.codRestrict (imageSubring f g) fun x ↦
    (show g x ∈ f.toRingHom.range ⊔ g.toRingHom.range from
      (le_sup_right : g.toRingHom.range ≤ f.toRingHom.range ⊔ g.toRingHom.range)
        (g.toRingHom.mem_range_self x))

/-- The ideal in the image subring generated by the images of the two distinguished ideals. -/
public def imageIdeal (f : B ⟶ C) (g : B' ⟶ C) : Ideal (imageSubring f g) :=
  B.ideal.map (imageLeftHom f g) ⊔ B'.ideal.map (imageRightHom f g)

/-- Composing the left factorization with the subring inclusion recovers the original ring
homomorphism. -/
public lemma imageInclusion_comp_left (f : B ⟶ C) (g : B' ⟶ C) :
    (SubringClass.subtype (imageSubring f g)).comp (imageLeftHom f g) = f.toRingHom := by
  ext
  rfl

/-- Composing the right factorization with the subring inclusion recovers the original ring
homomorphism. -/
public lemma imageInclusion_comp_right (f : B ⟶ C) (g : B' ⟶ C) :
    (SubringClass.subtype (imageSubring f g)).comp (imageRightHom f g) = g.toRingHom := by
  ext
  rfl

/-- The image ideal maps to the supremum of the two distinguished image ideals. -/
public lemma map_imageIdeal (f : B ⟶ C) (g : B' ⟶ C) :
    (imageIdeal f g).map (SubringClass.subtype (imageSubring f g)) =
      B.ideal.map f.toRingHom ⊔ B'.ideal.map g.toRingHom := by
  simp only [imageIdeal, Ideal.map_sup, Ideal.map_map, imageInclusion_comp_left,
    imageInclusion_comp_right]

/-- The image ideal maps into the distinguished ideal of the common target. -/
public lemma imageIdeal_le_ambient (f : B ⟶ C) (g : B' ⟶ C) :
    (imageIdeal f g).map (SubringClass.subtype (imageSubring f g)) ≤ C.ideal := by
  rw [map_imageIdeal]
  exact sup_le f.ideal_comp g.ideal_comp

/-- An element of the image ideal lies in the distinguished ideal of the common target. -/
private lemma coe_mem_ideal_of_mem_imageIdeal (f : B ⟶ C) (g : B' ⟶ C) {x : imageSubring f g}
    (hx : x ∈ imageIdeal f g) : (x : C) ∈ C.ideal :=
  imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx)

/-- The left factorization maps the distinguished ideal into the image ideal. -/
private lemma imageLeftHom_mem_imageIdeal (f : B ⟶ C) (g : B' ⟶ C) {a : B} (ha : a ∈ B.ideal) :
    imageLeftHom f g a ∈ imageIdeal f g :=
  (le_sup_left : B.ideal.map (imageLeftHom f g) ≤ imageIdeal f g) (Ideal.mem_map_of_mem _ ha)

/-- The right factorization maps the distinguished ideal into the image ideal. -/
private lemma imageRightHom_mem_imageIdeal (f : B ⟶ C) (g : B' ⟶ C) {a : B'} (ha : a ∈ B'.ideal) :
    imageRightHom f g a ∈ imageIdeal f g :=
  (le_sup_right : B'.ideal.map (imageRightHom f g) ≤ imageIdeal f g) (Ideal.mem_map_of_mem _ ha)

/-- The divided powers on the common target preserve the ideal generated by the two image
ideals, regarded as an ideal in the subring generated by the two ring images. -/
public lemma dpow_mem_imageIdeal (f : B ⟶ C) (g : B' ⟶ C) (n : ℕ) (hn : n ≠ 0)
    (x : imageSubring f g) (hx : x ∈ imageIdeal f g) :
    C.dividedPowers.dpow n (x : C) ∈
      Subtype.val '' (imageIdeal f g : Set (imageSubring f g)) := by
  classical
  let S : Set (imageSubring f g) :=
    (imageLeftHom f g) '' (B.ideal : Set B) ∪
      (imageRightHom f g) '' (B'.ideal : Set B')
  have hspan : imageIdeal f g = Ideal.span S := by
    simp only [imageIdeal, S, Ideal.map, Ideal.span_union]
  have hsub : Ideal.span S ≤ imageIdeal f g := hspan ▸ le_rfl
  have hmain : ∀ (z : imageSubring f g), z ∈ Ideal.span S →
      ∀ m : ℕ, m ≠ 0 →
        C.dividedPowers.dpow m (z : C) ∈
          Subtype.val '' (imageIdeal f g : Set (imageSubring f g)) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
        intro m hm
        rcases hz with ⟨a, ha, rfl⟩ | ⟨a, ha, rfl⟩
        · exact ⟨imageLeftHom f g (B.dividedPowers.dpow m a),
            imageLeftHom_mem_imageIdeal f g (B.dividedPowers.dpow_mem hm ha),
            (f.dpow_comp a ha).symm⟩
        · exact ⟨imageRightHom f g (B'.dividedPowers.dpow m a),
            imageRightHom_mem_imageIdeal f g (B'.dividedPowers.dpow_mem hm ha),
            (g.dpow_comp a ha).symm⟩
    | zero =>
        intro m hm
        refine ⟨0, (imageIdeal f g).zero_mem, ?_⟩
        simp [C.dividedPowers.dpow_eval_zero hm]
    | add a b ha hb iha ihb =>
        intro m hm
        have haC := coe_mem_ideal_of_mem_imageIdeal f g (hsub ha)
        have hbC := coe_mem_ideal_of_mem_imageIdeal f g (hsub hb)
        change C.dividedPowers.dpow m ((a : C) + (b : C)) ∈ _
        rw [C.dividedPowers.dpow_add' haC hbC]
        have hpow (c : imageSubring f g) (hcC : (c : C) ∈ C.ideal)
            (ih : ∀ m : ℕ, m ≠ 0 → C.dividedPowers.dpow m (c : C) ∈
              Subtype.val '' (imageIdeal f g : Set (imageSubring f g))) (j : ℕ) :
            ∃ y : imageSubring f g, (j ≠ 0 → y ∈ imageIdeal f g) ∧
              (y : C) = C.dividedPowers.dpow j (c : C) := by
          by_cases hj : j = 0
          · exact ⟨1, fun h ↦ (h hj).elim, by simp [hj, C.dividedPowers.dpow_zero hcC]⟩
          · obtain ⟨y, hy, heq⟩ := ih j hj
            exact ⟨y, fun _ ↦ hy, heq⟩
        have hterm (k : ℕ) : ∃ y : imageSubring f g, y ∈ imageIdeal f g ∧
            (y : C) = C.dividedPowers.dpow k (a : C) * C.dividedPowers.dpow (m - k) (b : C) := by
          obtain ⟨ya, hya, hyav⟩ := hpow a haC iha k
          obtain ⟨yb, hyb, hybv⟩ := hpow b hbC ihb (m - k)
          refine ⟨ya * yb, ?_, by simp [hyav, hybv]⟩
          by_cases hk0 : k = 0
          · exact (imageIdeal f g).mul_mem_left _ (hyb (by omega))
          · exact (imageIdeal f g).mul_mem_right _ (hya hk0)
        choose y hy hyv using hterm
        refine ⟨∑ k ∈ Finset.range (m + 1), y k, Submodule.sum_mem _ fun k _ ↦ hy k, ?_⟩
        rw [AddSubmonoidClass.coe_finsetSum]
        exact Finset.sum_congr rfl fun k _ ↦ hyv k
    | smul c a ha iha =>
        intro m hm
        have haC := coe_mem_ideal_of_mem_imageIdeal f g (hsub ha)
        change C.dividedPowers.dpow m ((c : C) * (a : C)) ∈ _
        rw [C.dividedPowers.dpow_mul haC]
        rcases iha m hm with ⟨y, hy, heq⟩
        refine ⟨c ^ m * y, (imageIdeal f g).mul_mem_left _ hy, ?_⟩
        simp [heq]
  exact hmain x (hspan ▸ hx) n hn

/-- The divided power structure on the ideal in the image subring, obtained by restricting the
divided powers on the common target. -/
public noncomputable def imageDividedPowers (f : B ⟶ C) (g : B' ⟶ C) :
    DividedPowers (imageIdeal f g) := by
  classical
  let lift (n : ℕ) (x : imageSubring f g) (hx : x ∈ imageIdeal f g) :=
    if hn : n = 0 then 1 else
      Classical.choose (dpow_mem_imageIdeal f g n hn x hx)
  have lift_mem (n : ℕ) (x : imageSubring f g) (hx : x ∈ imageIdeal f g) (hn : n ≠ 0) :
      lift n x hx ∈ imageIdeal f g := by
    simp only [lift, dite_eq_right hn]
    exact (Classical.choose_spec (dpow_mem_imageIdeal f g n hn x hx)).1
  have lift_val (n : ℕ) (x : imageSubring f g) (hx : x ∈ imageIdeal f g) :
      ((lift n x hx : imageSubring f g) : C) = C.dividedPowers.dpow n (x : C) := by
    by_cases hn : n = 0
    · simp only [lift, dite_eq_left hn]
      simpa [hn] using (C.dividedPowers.dpow_zero
        (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx))).symm
    · simp only [lift, dite_eq_right hn]
      exact (Classical.choose_spec (dpow_mem_imageIdeal f g n hn x hx)).2
  refine
    { dpow := fun n x ↦ if hx : x ∈ imageIdeal f g then lift n x hx else 0
      dpow_null := fun hx ↦ by simp [dite_eq_right hx]
      dpow_zero := fun {x} hx ↦ by
        apply Subtype.ext
        simp only [dite_eq_left hx, lift_val]
        exact C.dividedPowers.dpow_zero
          (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx))
      dpow_one := fun {x} hx ↦ by
        apply Subtype.ext
        simp only [dite_eq_left hx, lift_val]
        exact C.dividedPowers.dpow_one
          (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx))
      dpow_mem := fun {n x} hn hx ↦ by simpa only [dite_eq_left hx] using lift_mem n x hx hn
      dpow_add := fun {n x y} hx hy ↦ by
        have hxy := (imageIdeal f g).add_mem hx hy
        simp only [dite_eq_left hx, dite_eq_left hy]
        split
        next h =>
          apply Subtype.ext
          rw [lift_val n (x + y) h]
          change C.dividedPowers.dpow n ((x : C) + (y : C)) =
            (SubringClass.subtype (imageSubring f g)) _
          rw [map_sum]
          apply (C.dividedPowers.dpow_add
            (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx))
            (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hy))).trans
          apply Finset.sum_congr rfl
          intro k hk
          rw [map_mul]
          exact congrArg₂ (fun a b : C ↦ a * b) (lift_val k.1 x hx).symm
            (lift_val k.2 y hy).symm
        next h => exact (h hxy).elim
      dpow_mul := fun {n a x} hx ↦ by
        have hax := (imageIdeal f g).mul_mem_left a hx
        simp only [dite_eq_left hx]
        split
        next h =>
          apply Subtype.ext
          rw [lift_val n (a * x) h]
          change C.dividedPowers.dpow n ((a : C) * (x : C)) =
            (SubringClass.subtype (imageSubring f g)) (a ^ n * lift n x hx)
          rw [map_mul, map_pow]
          exact (C.dividedPowers.dpow_mul (a := (a : C))
            (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx))).trans
              (congrArg ((SubringClass.subtype (imageSubring f g)) a ^ n * ·)
                (lift_val n x hx).symm)
        next h => exact (h hax).elim
      mul_dpow := fun {m n x} hx ↦ by
        simp only [dite_eq_left hx]
        apply Subtype.ext
        change (lift m x hx : C) * (lift n x hx : C) =
          ((Nat.choose (m + n) m : imageSubring f g) : C) * (lift (m + n) x hx : C)
        simp only [lift_val]
        exact C.dividedPowers.mul_dpow
          (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx))
      dpow_comp := fun {n m x} hm hx ↦ by
        simp only [dite_eq_left hx, dite_eq_left (lift_mem m x hx hm)]
        apply Subtype.ext
        change (lift n (lift m x hx) (lift_mem m x hx hm) : C) =
          ((Nat.uniformBell n m : imageSubring f g) : C) * (lift (n * m) x hx : C)
        simp only [lift_val]
        exact C.dividedPowers.dpow_comp hm
          (imageIdeal_le_ambient f g (Ideal.mem_map_of_mem _ hx)) }

/-- Divided powers in the image subring are the restrictions of those on the common target. -/
public lemma imageDividedPowers_dpow (f : B ⟶ C) (g : B' ⟶ C) (n : ℕ)
    (x : imageSubring f g) (hx : x ∈ imageIdeal f g) :
    (((imageDividedPowers f g).dpow n x : imageSubring f g) : C) =
      C.dividedPowers.dpow n (x : C) := by
  classical
  by_cases hn : n = 0
  · simp only [imageDividedPowers, hx, dite_true, hn]
    exact (C.dividedPowers.dpow_zero
      (coe_mem_ideal_of_mem_imageIdeal f g hx)).symm
  · simp only [imageDividedPowers, hx, dite_true, hn, dite_false]
    exact (Classical.choose_spec (dpow_mem_imageIdeal f g n hn x hx)).2

/-- The first map into the common target is a divided power morphism into the image. -/
public lemma isDPMorphism_imageLeftHom (f : B ⟶ C) (g : B' ⟶ C) :
    DividedPowers.IsDPMorphism B.dividedPowers (imageDividedPowers f g)
      (imageLeftHom f g) := by
  refine ⟨le_sup_left, fun {n} a ha ↦ ?_⟩
  apply Subtype.ext
  rw [imageDividedPowers_dpow f g n _ (imageLeftHom_mem_imageIdeal f g ha)]
  exact f.dpow_comp a ha

/-- The second map into the common target is a divided power morphism into the image. -/
public lemma isDPMorphism_imageRightHom (f : B ⟶ C) (g : B' ⟶ C) :
    DividedPowers.IsDPMorphism B'.dividedPowers (imageDividedPowers f g)
      (imageRightHom f g) := by
  refine ⟨le_sup_right, fun {n} a ha ↦ ?_⟩
  apply Subtype.ext
  rw [imageDividedPowers_dpow f g n _ (imageRightHom_mem_imageIdeal f g ha)]
  exact g.dpow_comp a ha

/-- The divided power ring inside the common target generated by the two images. -/
public noncomputable def image (f : B ⟶ C) (g : B' ⟶ C) : DividedPowerRing :=
  .of (imageSubring f g) (imageIdeal f g) (imageDividedPowers f g)

/-- The first original divided power ring maps canonically to the image divided power ring. -/
public noncomputable def imageLeftMorphism (f : B ⟶ C) (g : B' ⟶ C) : B ⟶ image f g :=
  DividedPowers.DPMorphism.mk' (isDPMorphism_imageLeftHom f g)

/-- The second original divided power ring maps canonically to the image divided power ring. -/
public noncomputable def imageRightMorphism (f : B ⟶ C) (g : B' ⟶ C) : B' ⟶ image f g :=
  DividedPowers.DPMorphism.mk' (isDPMorphism_imageRightHom f g)

/-- The inclusion of the generated image subring in the common target. -/
public def imageInclusionRingHom (f : B ⟶ C) (g : B' ⟶ C) : imageSubring f g →+* C :=
  SubringClass.subtype (imageSubring f g)

/-- Inclusion of the image in the common target respects the divided power structures. -/
public lemma isDPMorphism_imageInclusion (f : B ⟶ C) (g : B' ⟶ C) :
    DividedPowers.IsDPMorphism (imageDividedPowers f g) C.dividedPowers
      (imageInclusionRingHom f g) := by
  refine ⟨imageIdeal_le_ambient f g, ?_⟩
  intro n x hx
  exact (imageDividedPowers_dpow f g n x hx).symm

/-- The image divided power ring includes canonically into the common target. -/
public noncomputable def imageInclusion (f : B ⟶ C) (g : B' ⟶ C) : image f g ⟶ C :=
  DividedPowers.DPMorphism.mk' (isDPMorphism_imageInclusion f g)

/-- The first original map factors through the image divided power ring. -/
public lemma imageLeftMorphism_comp_imageInclusion (f : B ⟶ C) (g : B' ⟶ C) :
    imageLeftMorphism f g ≫ imageInclusion f g = f := by
  ext
  rfl

/-- The second original map factors through the image divided power ring. -/
public lemma imageRightMorphism_comp_imageInclusion (f : B ⟶ C) (g : B' ⟶ C) :
    imageRightMorphism f g ≫ imageInclusion f g = g := by
  ext
  rfl

end ImageSubring

section PushoutTensor

open CategoryTheory
open scoped TensorProduct

/-- The canonical map from the tensor product of the underlying rings to the vertex of a
commuting cocone of divided power rings. -/
public noncomputable def tensorProductToPushout
    {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (f' : A ⟶ B')
    (g : B ⟶ B'') (g' : B' ⟶ B'') (w : f ≫ g = f' ≫ g') :
    letI : Algebra A B := f.toRingHom.toAlgebra;
    letI : Algebra A B' := f'.toRingHom.toAlgebra;
    (B ⊗[A] B') →+* B'' := by
  let : Algebra A B := f.toRingHom.toAlgebra
  let : Algebra A B' := f'.toRingHom.toAlgebra
  exact ((CommRingCat.isPushout_tensorProduct A B B').desc
    (DividedPowerRing.forget.map g) (DividedPowerRing.forget.map g') (by
      change (DividedPowerRing.forget.map f) ≫ (DividedPowerRing.forget.map g) =
        (DividedPowerRing.forget.map f') ≫ (DividedPowerRing.forget.map g')
      simpa only [Functor.map_comp] using
        congrArg (fun k ↦ DividedPowerRing.forget.map k) w)).hom

/-- The canonical map sends a pure tensor to the product of the images of its factors. -/
@[simp]
public theorem tensorProductToPushout_tmul
    {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (f' : A ⟶ B')
    (g : B ⟶ B'') (g' : B' ⟶ B'') (w : f ≫ g = f' ≫ g') (b : B) (b' : B') :
    letI : Algebra A B := f.toRingHom.toAlgebra;
    letI : Algebra A B' := f'.toRingHom.toAlgebra;
    tensorProductToPushout f f' g g' w (b ⊗ₜ[A] b') = g b * g' b' := by
  let : Algebra A B := f.toRingHom.toAlgebra
  let : Algebra A B' := f'.toRingHom.toAlgebra
  change ((CommRingCat.isPushout_tensorProduct A B B').desc
    (DividedPowerRing.forget.map g) (DividedPowerRing.forget.map g') _) (b ⊗ₜ[A] b') = _
  rw [← mul_one b, ← one_mul b', ← Algebra.TensorProduct.tmul_mul_tmul, map_mul]
  simp only [mul_one, one_mul]
  change (((CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫
      (CommRingCat.isPushout_tensorProduct A B B').desc
        (DividedPowerRing.forget.map g) (DividedPowerRing.forget.map g') _) :
      CommRingCat.of B ⟶ CommRingCat.of B'') b) *
    (((CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫
      (CommRingCat.isPushout_tensorProduct A B B').desc
        (DividedPowerRing.forget.map g) (DividedPowerRing.forget.map g') _) :
      CommRingCat.of B' ⟶ CommRingCat.of B'') b') = g b * g' b'
  simp only [AlgHom.toRingHom_eq_coe, IsPushout.inl_desc, IsPushout.inr_desc]
  change g b * g' b' = g b * g' b'
  rfl

/-- In a pushout of divided power rings, the image of the two legs is everything: the inclusion
of the generated image has a section. -/
private theorem exists_comp_imageInclusion_eq_id
    {A B B' B'' : DividedPowerRing.{u}} {f : A ⟶ B} {g : A ⟶ B'} {h : B ⟶ B''} {h' : B' ⟶ B''}
    (H : IsPushout f g h h') :
    ∃ d : B'' ⟶ image h h', d ≫ imageInclusion h h' = 𝟙 B'' := by
  have : Mono (imageInclusion h h') :=
    ConcreteCategory.mono_of_injective _ (fun _ _ e ↦ Subtype.val_injective e)
  have w : f ≫ imageLeftMorphism h h' = g ≫ imageRightMorphism h h' := by
    apply (cancel_mono (imageInclusion h h')).mp
    rw [Category.assoc, Category.assoc, imageLeftMorphism_comp_imageInclusion,
      imageRightMorphism_comp_imageInclusion]
    exact H.w
  refine ⟨H.desc _ _ w, H.hom_ext ?_ ?_⟩
  · rw [← Category.assoc, H.inl_desc, imageLeftMorphism_comp_imageInclusion, Category.comp_id]
  · rw [← Category.assoc, H.inr_desc, imageRightMorphism_comp_imageInclusion, Category.comp_id]

/-- In a pushout of divided power rings, a ring map into the pushout whose range contains the
ranges of both legs is surjective. -/
private theorem surjective_of_range_le
    {A B B' B'' : DividedPowerRing.{u}} {f : A ⟶ B} {g : A ⟶ B'} {h : B ⟶ B''} {h' : B' ⟶ B''}
    (H : IsPushout f g h h') {T : Type*} [CommRing T] (t : T →+* B'')
    (hl : h.toRingHom.range ≤ t.range) (hr : h'.toRingHom.range ≤ t.range) :
    Function.Surjective t := by
  obtain ⟨d, hd⟩ := exists_comp_imageInclusion_eq_id H
  intro x
  have hx : (d x).1 = x := congrArg (fun q : B'' ⟶ B'' ↦ q x) hd
  rw [← hx]
  exact (sup_le hl hr) (d x).property

/-- In a pushout of divided power rings, the canonical map from the tensor product of the
underlying rings to the underlying ring of the pushout is surjective. -/
@[stacks 0H86 "tensor_map_surjective"]
public theorem tensorProductToPushout_surjective
    {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (f' : A ⟶ B')
    (g : B ⟶ B'') (g' : B' ⟶ B'') (h : IsPushout f f' g g') :
    Function.Surjective (tensorProductToPushout f f' g g' h.w) := by
  let : Algebra A B := f.toRingHom.toAlgebra
  let : Algebra A B' := f'.toRingHom.toAlgebra
  let t : (B ⊗[A] B') →+* B'' := tensorProductToPushout f f' g g' h.w
  refine surjective_of_range_le h t ?_ ?_
  · rintro x ⟨b, rfl⟩
    refine ⟨b ⊗ₜ[A] 1, ?_⟩
    have ht := tensorProductToPushout_tmul f f' g g' h.w b 1
    change t (b ⊗ₜ[A] 1) = g.toRingHom b * g'.toRingHom 1 at ht
    simpa only [RingHom.map_one, mul_one] using ht
  · rintro x ⟨b', rfl⟩
    refine ⟨1 ⊗ₜ[A] b', ?_⟩
    have ht := tensorProductToPushout_tmul f f' g g' h.w 1 b'
    change t (1 ⊗ₜ[A] b') = g.toRingHom 1 * g'.toRingHom b' at ht
    simpa only [RingHom.map_one, one_mul] using ht

end PushoutTensor

section PushoutIdeal

open CategoryTheory
open scoped TensorProduct

/-- The canonical map from the tensor product of the underlying rings of a commuting span of
divided power rings to its cocone point. -/
public def canonicalTensorProductHom
    {A B B' B'' : DividedPowerRing.{u}}
    (f : A ⟶ B) (g : A ⟶ B') (h : B ⟶ B'') (h' : B' ⟶ B'')
    (sq : f ≫ h = g ≫ h') :
    letI : Algebra A B := f.toRingHom.toAlgebra
    letI : Algebra A B' := g.toRingHom.toAlgebra
    B ⊗[A] B' →+* B'' := by
  letI : Algebra A B := f.toRingHom.toAlgebra
  letI : Algebra A B' := g.toRingHom.toAlgebra
  letI : Algebra A B'' := (h.toRingHom.comp f.toRingHom).toAlgebra
  let fh : B →ₐ[A] B'' :=
    { toRingHom := h.toRingHom
      commutes' := fun _ ↦ rfl }
  let gh : B' →ₐ[A] B'' :=
    { toRingHom := h'.toRingHom
      commutes' := by
        intro a
        change h'.toRingHom (g.toRingHom a) = h.toRingHom (f.toRingHom a)
        have q := DFunLike.congr_fun
          (congrArg DividedPowers.DPMorphism.toRingHom sq) a
        exact q.symm }
  exact (Algebra.TensorProduct.lift fh gh (fun _ _ ↦ Commute.all _ _)).toRingHom

/-- In a pushout of divided power rings, the canonical map from the sum of the two extended
divided power ideals onto the distinguished ideal of the pushout is surjective. -/
@[stacks 0H86 "ideal_map_surjective"]
public theorem dividedPowerIdeal_surjective_of_isPushout
    {A B B' B'' : DividedPowerRing.{u}}
    (f : A ⟶ B) (g : A ⟶ B') (h : B ⟶ B'') (h' : B' ⟶ B'')
    (H : IsPushout f g h h') :
    letI : Algebra A B := f.toRingHom.toAlgebra
    letI : Algebra A B' := g.toRingHom.toAlgebra
    ∀ y : B''.ideal,
      ∃ x : (Ideal.map Algebra.TensorProduct.includeLeftRingHom B.ideal +
          Ideal.map Algebra.TensorProduct.includeRight.toRingHom B'.ideal :
            Ideal (B ⊗[A] B')),
        canonicalTensorProductHom f g h h' H.w x.1 = y.1 := by
  let : Algebra A B := f.toRingHom.toAlgebra
  let : Algebra A B' := g.toRingHom.toAlgebra
  let φ := canonicalTensorProductHom f g h h' H.w
  obtain ⟨d, hd⟩ := exists_comp_imageInclusion_eq_id H
  have hleft : φ.comp Algebra.TensorProduct.includeLeftRingHom = h.toRingHom := by
    apply RingHom.ext; intro b
    change h.toRingHom b * h'.toRingHom 1 = h.toRingHom b
    rw [map_one, mul_one]
  have hright : φ.comp Algebra.TensorProduct.includeRight.toRingHom = h'.toRingHom := by
    apply RingHom.ext; intro b
    change h.toRingHom 1 * h'.toRingHom b = h'.toRingHom b
    rw [map_one, one_mul]
  have hφsurj : Function.Surjective φ := by
    refine surjective_of_range_le H φ ?_ ?_
    · rintro z ⟨b, rfl⟩; exact ⟨Algebra.TensorProduct.includeLeftRingHom b, by rw [← hleft]; rfl⟩
    · rintro z ⟨b, rfl⟩
      exact ⟨Algebra.TensorProduct.includeRight.toRingHom b, by rw [← hright]; rfl⟩
  intro y
  have hy : y.1 ∈ B.ideal.map h.toRingHom ⊔ B'.ideal.map h'.toRingHom := by
    rw [← map_imageIdeal h h']
    have hdy : d.toRingHom y.1 ∈ imageIdeal h h' :=
      d.ideal_comp (Ideal.mem_map_of_mem d.toRingHom y.2)
    have hm := Ideal.mem_map_of_mem (imageInclusionRingHom h h') hdy
    have q := DFunLike.congr_fun (congrArg DividedPowers.DPMorphism.toRingHom hd) y.1
    change (imageInclusionRingHom h h')
      (d.toRingHom y.1) = y.1 at q
    rw [← q]
    exact hm
  have hideal : y.1 ∈ (Ideal.map Algebra.TensorProduct.includeLeftRingHom B.ideal +
      Ideal.map Algebra.TensorProduct.includeRight.toRingHom B'.ideal).map φ := by
    rw [add_eq_sup, Ideal.map_sup, Ideal.map_map, Ideal.map_map]
    change y.1 ∈ B.ideal.map (φ.comp Algebra.TensorProduct.includeLeftRingHom) ⊔
      B'.ideal.map (φ.comp Algebra.TensorProduct.includeRight.toRingHom)
    rwa [hleft, hright]
  obtain ⟨x, hx, hφx⟩ := (Ideal.mem_map_iff_of_surjective φ hφsurj).mp hideal
  exact ⟨⟨x, hx⟩, hφx⟩

end PushoutIdeal

end DividedPowerRing
