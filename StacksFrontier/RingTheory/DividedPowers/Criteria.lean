/-!
# Criteria for the existence of divided powers (Stacks chapter divided power algebra)

A divided power structure on an ideal `I` of a commutative ring `A` is a family of operations
`γₙ` on `I` behaving like `x ↦ xⁿ / n!`. This file collects the criteria which let one produce
or recognise such a structure without verifying every axiom by hand.

Over a ring which is torsion-free as an abelian group, the operations are forced: multiplying
`γₙ(x)` by `n!` must give `xⁿ`, so a divided power structure is unique if it exists, and
conversely any family of operations satisfying the factorial identity *is* a divided power
structure. The factorial identity in turn only has to be checked on a set of generators of the
ideal, which is the practical criterion. Independently, the two axioms involving a single
element — the product rule `γₘ(x) γₙ(x) = binom(m+n, m) γ_{m+n}(x)` and the composition rule
`γₘ(γₙ(x)) = uniformBell m n · γ_{mn}(x)` — only have to be checked on generators, provided the
remaining axioms hold throughout the ideal. Finally, two divided power structures on ideals `I`
and `J` of the same ring always agree on `I · J`, and if they agree on `I ⊓ J` they glue to a
unique divided power structure on `I + J`.

## Main results

* `DividedPowers.instSubsingletonDividedPowers` — a divided power structure on an ideal of a
  torsion-free ring is unique if it exists.
* `DividedPowers.exists_dividedPowers_iff_factorial_mul_eq_pow` — the factorial criterion:
  over a torsion-free ring, operations on an ideal are divided power operations exactly when
  `n! · γₙ(x) = xⁿ`.
* `DividedPowers.nonempty_dividedPowers_iff_exists_generators_pow_mem_factorial_mul` — the
  generator criterion: an ideal of a torsion-free ring carries divided powers exactly when it
  has generators `x` with `xⁿ ∈ (n!) I` for all `n ≥ 1`.
* `DividedPowers.exists_dividedPowers_of_axioms_on_generators` — the product and composition
  axioms need only be checked on a set of generators of the ideal.
* `DividedPowers.existsUnique_on_ideal_add` — compatible divided powers on `I` and `J` glue
  uniquely to the sum `I + J`.

## Implementation notes

Mathlib totalizes a divided power operation to the whole ambient ring, extending it by zero
outside the ideal. Saying that a given family of operations on an ideal "is" a family of divided
power operations therefore means that it agrees on the ideal with the operations of some
`DividedPowers` structure, which is how the criteria below are phrased. Mathlib's
`DividedPowers.factorial_mul_dpow_eq_pow` already records the factorial identity, for commutative
semirings and all `n` including `n = 0`; this is stronger than the source, which assumes a ring
and `n ≥ 1`.

The ideal written `(n!)I` in the source is the product of the principal ideal generated by
`n.factorial` with `I`. Restriction of a divided power structure to a smaller ideal is expressed
by equality of divided power operations on the elements of the smaller ideal, and the scalar
multiplication `I • J` of two ideals is their product.

## References

* [Stacks Project, Tag 07GM](https://stacks.math.columbia.edu/tag/07GM)
* [Stacks Project, Tag 07GP](https://stacks.math.columbia.edu/tag/07GP)
* [Stacks Project, Tag 07GQ](https://stacks.math.columbia.edu/tag/07GQ)
-/

@[expose] public section

namespace DividedPowers

add_to_stacks 07GM "factorial_identity" DividedPowers.factorial_mul_dpow_eq_pow

/-- A divided power structure on an ideal in a ring torsion-free as a `ℤ`-module is unique. -/
@[stacks 07GM "uniqueness"]
public instance instSubsingletonDividedPowers {A : Type*} [CommRing A]
    [Module.IsTorsionFree ℤ A] (I : Ideal A) : Subsingleton (_root_.DividedPowers I) := by
  refine ⟨fun γ δ ↦ _root_.DividedPowers.ext γ δ (fun n x hx ↦ ?_)⟩
  apply smul_right_injective A (r := (n.factorial : ℤ)) (by positivity)
  simp [γ.factorial_mul_dpow_eq_pow hx, δ.factorial_mul_dpow_eq_pow hx]

section FactorialCriterion

open scoped TensorProduct

/-- The candidate divided power operation attached to a family of maps `γ` on an ideal: it is
`γ n` on the ideal, `1` in degree zero, and `0` outside the ideal. -/
private noncomputable def proposedDpow {A : Type*} [CommRing A] (I : Ideal A)
    (γ : ℕ → I → I) (n : ℕ) (x : A) : A :=
  open scoped Classical in if hx : x ∈ I then if n = 0 then 1 else γ n ⟨x, hx⟩ else 0

/-- Over a torsion-free commutative ring, maps on an ideal are divided power operations if and
only if their products with the corresponding factorials are the corresponding powers. -/
@[stacks 07GM "factorial_criterion"]
public theorem exists_dividedPowers_iff_factorial_mul_eq_pow
    {A : Type*} [CommRing A] [Module.IsTorsionFree ℤ A] (I : Ideal A)
    (γ : ℕ → I → I) :
    (∃ dp : _root_.DividedPowers I,
        ∀ (n : ℕ) (x : I), 0 < n → dp.dpow n (x : A) = (γ n x : A)) ↔
      ∀ (n : ℕ) (x : I), 0 < n →
        (n.factorial : A) * (γ n x : A) = (x : A) ^ n := by
  constructor
  · rintro ⟨dp, hdp⟩ n x hn
    simpa [← hdp n x hn] using dp.factorial_mul_dpow_eq_pow x.property
  · intro hγ
    classical
    let B := ℚ ⊗[ℤ] A
    let f : A →+* B := (Algebra.TensorProduct.includeRight : A →ₐ[ℤ] B).toRingHom
    have hf : Function.Injective f :=
      Algebra.TensorProduct.includeRight_injective Rat.intCast_injective
    let J : Ideal B := I.map f
    let dpQ : _root_.DividedPowers J := RatAlgebra.dividedPowers J
    have hmap (n : ℕ) (x : A) (hx : x ∈ I) :
        f (proposedDpow I γ n x) = dpQ.dpow n (f x) := by
      by_cases hn : n = 0
      · subst n
        rw [show proposedDpow I γ 0 x = 1 by simp [proposedDpow, hx], map_one,
          dpQ.dpow_zero (Ideal.mem_map_of_mem f hx)]
      · apply (IsUnit.natCast_factorial_of_algebra ℚ n).mul_left_cancel
        rw [dpQ.factorial_mul_dpow_eq_pow (Ideal.mem_map_of_mem f hx)]
        simpa [proposedDpow, hx, hn, map_mul] using
          congrArg f (hγ n ⟨x, hx⟩ (Nat.pos_of_ne_zero hn))
    have hmemP {n : ℕ} {x : A} (hn : n ≠ 0) (hx : x ∈ I) : proposedDpow I γ n x ∈ I := by
      simpa only [proposedDpow, hx, ↓reduceDIte, hn, ↓reduceIte] using (γ n ⟨x, hx⟩).property
    let dp : _root_.DividedPowers I :=
      { dpow := proposedDpow I γ
        dpow_null := by intro n x hx; simp [proposedDpow, hx]
        dpow_zero := by intro x hx; simp [proposedDpow, hx]
        dpow_one := by
          intro x hx; apply hf
          rw [hmap 1 x hx, dpQ.dpow_one]
          exact Ideal.mem_map_of_mem f hx
        dpow_mem := fun hn hx ↦ hmemP hn hx
        dpow_add := by
          intro n x y hx hy; apply hf
          rw [map_sum, hmap n (x + y) (I.add_mem hx hy), map_add, dpQ.dpow_add
            (Ideal.mem_map_of_mem f hx) (Ideal.mem_map_of_mem f hy)]
          apply Finset.sum_congr rfl
          intro k hk; rw [map_mul, hmap k.1 x hx, hmap k.2 y hy]
        dpow_mul := by
          intro n a x hx; apply hf
          rw [hmap n (a * x) (I.mul_mem_left a hx), map_mul f a x, map_mul, map_pow,
            hmap n x hx, dpQ.dpow_mul (Ideal.mem_map_of_mem f hx)]
        mul_dpow := by
          intro m n x hx; apply hf
          rw [map_mul, map_mul, hmap m x hx, hmap n x hx, hmap (m + n) x hx,
            map_natCast, dpQ.mul_dpow (Ideal.mem_map_of_mem f hx)]
        dpow_comp := by
          intro m n x hn hx; apply hf
          simp only [map_mul, map_natCast]
          rw [hmap m (proposedDpow I γ n x)]
          · rw [hmap n x hx, hmap (m * n) x hx,
              dpQ.dpow_comp hn (Ideal.mem_map_of_mem f hx)]
          · exact hmemP hn hx }
    exact ⟨dp, fun n x hn ↦ by simp [dp, proposedDpow, x.property, Nat.ne_of_gt hn]⟩

end FactorialCriterion

section GeneratorCriterion

/-- If the positive powers of `x` and of `y` lie in `(n!) I`, so do those of `x + y`. -/
private lemma factorial_pow_mem_add {A : Type*} [CommRing A] (I : Ideal A)
    {x y : A}
    (hx : ∀ n : ℕ, 0 < n → x ^ n ∈ Ideal.span {(n.factorial : A)} * I)
    (hy : ∀ n : ℕ, 0 < n → y ^ n ∈ Ideal.span {(n.factorial : A)} * I) :
    ∀ n : ℕ, 0 < n → (x + y) ^ n ∈ Ideal.span {(n.factorial : A)} * I := by
  intro n hn
  rw [add_pow]
  refine Ideal.sum_mem _ fun k hk ↦ ?_
  have hkn : k ≤ n := Nat.le_of_lt_succ (Finset.mem_range.mp hk)
  by_cases hk0 : k = 0
  · subst k
    simpa using hy n hn
  by_cases hke : k = n
  · subst k
    simpa using hx n hn
  obtain ⟨u, hu, hu_eq⟩ := Ideal.mem_span_singleton_mul.mp (hx k (Nat.pos_of_ne_zero hk0))
  obtain ⟨v, hv, hv_eq⟩ := Ideal.mem_span_singleton_mul.mp (hy (n-k) (by omega))
  have hf : (n.choose k : A) * (k.factorial : A) * ((n-k).factorial : A) =
      (n.factorial : A) := by
    simpa only [Nat.cast_mul] using congrArg (fun t : ℕ => (t : A))
      (Nat.choose_mul_factorial_mul_factorial hkn)
  apply Ideal.mem_span_singleton_mul.mpr
  refine ⟨u * v, I.mul_mem_right v hu, ?_⟩
  calc
    (n.factorial : A) * (u * v) =
        ((k.factorial : A) * u) * (((n-k).factorial : A) * v) * (n.choose k : A) := by
          rw [← hf]; ring
    _ = x ^ k * y ^ (n-k) * (n.choose k : A) := by rw [hu_eq, hv_eq]

/-- Let `I` be an ideal in a torsion-free commutative ring. Then `I` admits a divided power
structure if and only if it has a set of ideal generators `s` such that, for every `x ∈ s` and
every positive `n`, the power `x ^ n` belongs to `(n!) I`. -/
@[stacks 07GM "generator_criterion"]
public lemma nonempty_dividedPowers_iff_exists_generators_pow_mem_factorial_mul
    {A : Type*} [CommRing A] [IsAddTorsionFree A] (I : Ideal A) :
    Nonempty (_root_.DividedPowers I) ↔
      ∃ s : Set A, (Ideal.span s = I ∧
        ∀ x ∈ s, ∀ n : ℕ, (1 ≤ n →
          x ^ n ∈ Ideal.span {(n.factorial : A)} * I)) := by
  classical
  constructor
  · rintro ⟨dp⟩
    refine ⟨(I : Set A), Ideal.span_eq I, ?_⟩
    exact fun x hx n hn ↦ Ideal.mem_span_singleton_mul.mpr
      ⟨dp.dpow n x, dp.dpow_mem (by omega) hx, dp.factorial_mul_dpow_eq_pow hx⟩
  · rintro ⟨s, hs, hgen⟩
    have hQ : ∀ x : A, x ∈ Ideal.span s → ∀ n : ℕ, 0 < n →
        x ^ n ∈ Ideal.span {(n.factorial : A)} * I := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx => exact hgen x hx
      | zero =>
          intro n hn
          simp [zero_pow (by omega : n ≠ 0)]
      | add x y hx hy ihx ihy => exact factorial_pow_mem_add I ihx ihy
      | smul a x hx ihx =>
          intro n hn
          rw [smul_eq_mul, mul_pow]
          exact Ideal.mul_mem_left _ _ (ihx n hn)
    let γ : ℕ → I → I := fun n x =>
      if hn : 0 < n then
        ⟨Classical.choose (Ideal.mem_span_singleton_mul.mp (hQ x (hs.symm ▸ x.property) n hn)),
          (Classical.choose_spec (Ideal.mem_span_singleton_mul.mp
            (hQ x (hs.symm ▸ x.property) n hn))).1⟩
      else 0
    have hγ : ∀ (n : ℕ) (x : I), 0 < n →
        (n.factorial : A) * (γ n x : A) = (x : A) ^ n := by
      intro n x hn
      dsimp [γ]
      rw [dite_eq_left hn]
      exact (Classical.choose_spec (Ideal.mem_span_singleton_mul.mp
        (hQ x (hs.symm ▸ x.property) n hn))).2
    obtain ⟨dp, _⟩ := (exists_dividedPowers_iff_factorial_mul_eq_pow I γ).mpr hγ
    exact ⟨dp⟩

end GeneratorCriterion

section AxiomsOnGenerators

open Finset Nat Ideal Polynomial

/-- The numerical coefficient occurring in the expansion of `γₘ(γₙ(a + b))`: the multiplicity
attached to the `i`th factor of a multiset `k` of indices below `n`. -/
private def compCoeff (n i : ℕ) (k : Multiset ℕ) : ℕ :=
  if i = 0 then (k.count i).uniformBell n
  else if i = n then (k.count i).uniformBell n
  else (k.count i).factorial * (k.count i).uniformBell i * (k.count i).uniformBell (n - i)

/-- The product rule for a family of operations satisfying the divided power product axiom at a
single element, in the form of a finite product. -/
private theorem localProdDpow {A : Type*} [CommRing A] (f : ℕ → A → A)
    (x : A) (hzero : f 0 x = 1)
    (hmul : ∀ m n, f m x * f n x = (choose (m + n) m : A) * f (m + n) x)
    {ι : Type*} (s : Finset ι) (n : ι → ℕ) :
    (∏ i ∈ s, f (n i) x) = (multinomial s n : A) * f (s.sum n) x := by
  classical
  induction s using Finset.induction with
  | empty => simp [hzero]
  | @insert a s ha ih =>
      rw [Finset.prod_insert ha, ih, ← mul_assoc, mul_comm (f (n a) x), mul_assoc, hmul,
        ← Finset.sum_insert ha, ← mul_assoc]
      apply congr_arg₂ _ _ rfl
      rw [multinomial_insert ha, mul_comm, Nat.cast_mul, Finset.sum_insert ha]

/-- The `k`th power of `f j x` for a family of operations satisfying the divided power product
axiom at a single element. -/
private theorem localDpowPow {A : Type*} [CommRing A] (f : ℕ → A → A)
    (x : A) (hzero : f 0 x = 1)
    (hmul : ∀ m n, f m x * f n x = (choose (m + n) m : A) * f (m + n) x)
    {j k : ℕ} (hj : j ≠ 0) :
    (f j x) ^ k = ((k.factorial * uniformBell k j : ℕ) : A) * f (k * j) x := by
  induction k with
  | zero => simp [hzero, Nat.uniformBell_zero_left]
  | succ k ih =>
      have hcoef : k.factorial * uniformBell k j * choose (k * j + j) (k * j) =
          (k + 1).factorial * uniformBell (k + 1) j := by
        apply Nat.eq_of_mul_eq_mul_right (pow_pos (Nat.factorial_pos j) (k + 1))
        calc
          (k.factorial * uniformBell k j * choose (k * j + j) (k * j)) *
                j.factorial ^ (k + 1) =
              (uniformBell k j * j.factorial ^ k * k.factorial) *
                (choose (k * j + j) (k * j) * j.factorial) := by
            rw [pow_succ]
            ring
          _ = choose (k * j + j) (k * j) * (k * j)! * j.factorial := by
            rw [Nat.uniformBell_mul_eq k hj]
            ring
          _ = ((k + 1) * j)! := by
            have hchoose := Nat.choose_mul_factorial_mul_factorial
              (show k * j ≤ k * j + j by omega)
            simpa [Nat.succ_mul] using hchoose
          _ = uniformBell (k + 1) j * j.factorial ^ (k + 1) * (k + 1).factorial := by
            symm
            exact Nat.uniformBell_mul_eq (k + 1) hj
          _ = ((k + 1).factorial * uniformBell (k + 1) j) * j.factorial ^ (k + 1) := by
            ring
      rw [pow_succ, ih, mul_assoc, hmul (k * j) j]
      rw [← mul_assoc, ← Nat.cast_mul, hcoef]
      congr 1
      rw [Nat.succ_mul]

/-- The divided power product axiom propagates from two elements to their sum. -/
private theorem localMulDpowAdd {A : Type*} [CommRing A] (I : Ideal A)
    (f : ℕ → A → A) (x y : A) (hx : x ∈ I) (hy : y ∈ I)
    (hadd : ∀ {n x y}, x ∈ I → y ∈ I →
      f n (x + y) = (antidiagonal n).sum (fun k ↦ f k.1 x * f k.2 y))
    (hmulx : ∀ m n, f m x * f n x = (choose (m + n) m : A) * f (m + n) x)
    (hmuly : ∀ m n, f m y * f n y = (choose (m + n) m : A) * f (m + n) y)
    {m n : ℕ} :
    f m (x + y) * f n (x + y) = (choose (m + n) m : A) * f (m + n) (x + y) := by
  simp only [hadd hx hy, Finset.sum_mul_sum, ← Finset.sum_product']
  have hf : ∀ z : (ℕ × ℕ) × ℕ × ℕ,
      f z.1.1 x * f z.1.2 y * (f z.2.1 x * f z.2.2 y) =
        (z.1.1 + z.2.1).choose z.1.1 * (z.1.2 + z.2.2).choose z.1.2 *
          f (z.1.1 + z.2.1) x * f (z.1.2 + z.2.2) y := by
    rintro ⟨⟨i, j⟩, ⟨k, l⟩⟩
    rw [mul_assoc, ← mul_assoc (f j y), mul_comm (f j y), mul_assoc, hmuly,
      ← mul_assoc, hmulx]
    ring
  rw [Finset.sum_congr rfl (fun z _ ↦ hf z)]
  set s : (ℕ × ℕ) × ℕ × ℕ → ℕ × ℕ := fun z ↦ ⟨z.1.1 + z.2.1, z.1.2 + z.2.2⟩ with hs_def
  have hs : ∀ z ∈ antidiagonal m ×ˢ antidiagonal n, s z ∈ antidiagonal (m + n) := by
    rintro ⟨⟨i, j⟩, ⟨k, l⟩⟩ h
    simp only [Finset.mem_antidiagonal, Finset.mem_product] at h ⊢
    rw [add_assoc, ← add_assoc k j l, add_comm k _, add_assoc, h.2, ← add_assoc, h.1]
  rw [← Finset.sum_fiberwise_of_maps_to hs]
  have hs' : ∑ z ∈ antidiagonal (m + n),
      ∑ w ∈ ((antidiagonal m ×ˢ antidiagonal n).filter (fun w ↦ s w = z)),
        ((w.1.1 + w.2.1).choose w.1.1) * ((w.1.2 + w.2.2).choose w.1.2) *
          f (w.1.1 + w.2.1) x * f (w.1.2 + w.2.2) y =
      ∑ z ∈ antidiagonal (m + n),
        (∑ w ∈ ((antidiagonal m ×ˢ antidiagonal n).filter (fun w ↦ s w = z)),
          z.1.choose w.1.1 * z.2.choose w.1.2) * f z.1 x * f z.2 y := by
    apply Finset.sum_congr rfl
    rintro ⟨u, v⟩ _
    simp only [Nat.cast_sum, Nat.cast_mul, Finset.sum_mul]
    apply Finset.sum_congr rfl
    rintro ⟨⟨i, j⟩, ⟨k, l⟩⟩ hw
    simp only [hs_def, Finset.mem_product, Finset.mem_antidiagonal, Finset.mem_filter,
      Prod.mk.injEq] at hw
    rw [hw.2.1, hw.2.2]
  rw [hs', Finset.mul_sum]
  apply Finset.sum_congr rfl
  rintro ⟨u, v⟩ h
  simp only [Finset.mem_antidiagonal] at h
  rw [← mul_assoc]
  simp only [hs_def, Prod.mk.injEq]
  rw [Finset.sum_filter, Finset.sum_product, ← h, Nat.add_choose_eq]
  simp only [Nat.cast_sum, Nat.cast_mul]
  apply congrArg (fun q : A ↦ q * f u x * f v y)
  apply Finset.sum_congr rfl
  intro z hz
  rw [Finset.sum_eq_single (u - z.1, v - z.2)]
  · by_cases h₁ : z.1 ≤ u <;> by_cases h₂ : z.2 ≤ v
    · simp [Nat.add_sub_of_le h₁, Nat.add_sub_of_le h₂]
    · simp [Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge h₂)]
    · simp [Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge h₁)]
    · simp [Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge h₁)]
  · intro w hw hwne
    by_cases hcond : z.1 + w.1 = u ∧ z.2 + w.2 = v
    · have hz' : z.1 + z.2 = m := Finset.mem_antidiagonal.mp hz
      have hw' : w.1 + w.2 = n := by
        simpa only [Finset.mem_product, Finset.mem_antidiagonal] using hw
      have hpair : w = (u - z.1, v - z.2) := by ext <;> omega
      exact (hwne hpair).elim
    · simp [hcond]
  · intro hnot
    by_cases h₁ : z.1 ≤ u <;> by_cases h₂ : z.2 ≤ v
    · have hsum : (u - z.1) + (v - z.2) = n := by
        have hz' : z.1 + z.2 = m := Finset.mem_antidiagonal.mp hz
        omega
      exact (hnot (Finset.mem_antidiagonal.mpr hsum)).elim
    · simp [Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge h₂)]
    · simp [Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge h₁)]
    · simp [Nat.choose_eq_zero_of_lt (Nat.lt_of_not_ge h₁)]

/-- A multiset of `m` indices below `n + 1` has weighted size at most `m * n`. -/
private theorem rangeSymWeightedSumLe {m n : ℕ} {k : Sym ℕ m}
    (hk : k ∈ (Finset.range (n + 1)).sym m) :
    (Finset.range (n + 1)).sum (fun i ↦ Multiset.count i k * i) ≤ m * n := by
  suffices h : ∀ i ∈ Finset.range (n + 1), Multiset.count i k * i ≤ Multiset.count i k * n by
    exact le_trans (Finset.sum_le_sum h) (by rw [← Finset.sum_mul, Finset.sum_count_of_mem_sym hk])
  exact fun i hi ↦ Nat.mul_le_mul_left _ (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))

/-- The complementary weighted size of a multiset of `m` indices below `n + 1`. -/
private theorem sumRangeSymMulCompl {m n : ℕ} {k : Sym ℕ m}
    (hk : k ∈ (Finset.range (n + 1)).sym m) :
    (Finset.range (n + 1)).sum (fun i ↦ Multiset.count i k * (n - i)) =
      m * n - (Finset.range (n + 1)).sum (fun i ↦ Multiset.count i k * i) := by
  suffices h : ((Finset.range (n + 1)).sum (fun i ↦ Multiset.count i k * (n - i)) +
      (Finset.range (n + 1)).sum (fun i ↦ Multiset.count i k * i)) = m * n by
    rw [← h, Nat.add_sub_cancel]
  simp_rw [← Finset.sum_add_distrib, ← mul_add]
  have hn : ∀ i ∈ Finset.range (n + 1), Multiset.count i k * (n - i + i) =
      Multiset.count i k * n := fun i hi ↦ by
    rw [Nat.sub_add_cancel (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))]
  rw [Finset.sum_congr rfl hn, ← Finset.sum_mul, Finset.sum_count_of_mem_sym hk]

/-- The expansion of `f m (f n (a + b))` for a family of operations satisfying the divided power
axioms at `a` and at `b` separately. -/
private theorem localDpowCompAddAux {A : Type*} [CommRing A] (I : Ideal A)
    (f : ℕ → A → A)
    (hzero : ∀ {x}, x ∈ I → f 0 x = 1)
    (hmem : ∀ {n x}, n ≠ 0 → x ∈ I → f n x ∈ I)
    (hadd : ∀ {n x y}, x ∈ I → y ∈ I →
      f n (x + y) = (antidiagonal n).sum (fun k ↦ f k.1 x * f k.2 y))
    (hmul : ∀ {n a x}, x ∈ I → f n (a * x) = a ^ n * f n x)
    {m n : ℕ} (hn : n ≠ 0) {a b : A} (ha : a ∈ I) (hb : b ∈ I)
    (ha_mul : ∀ m n,
      f m a * f n a = (choose (m + n) m : A) * f (m + n) a)
    (ha_comp : ∀ {m n}, n ≠ 0 →
      f m (f n a) = (uniformBell m n : A) * f (m * n) a)
    (hb_mul : ∀ m n,
      f m b * f n b = (choose (m + n) m : A) * f (m + n) b)
    (hb_comp : ∀ {m n}, n ≠ 0 →
      f m (f n b) = (uniformBell m n : A) * f (m * n) b) :
    f m (f n (a + b)) =
      ∑ p ∈ Finset.range (m * n + 1),
        (∑ k ∈ ((Finset.range (n + 1)).sym m).filter
          (fun l : Sym ℕ m ↦
            (Finset.range (n + 1)).sum (fun i ↦ Multiset.count i l * i) = p),
          ((∏ i ∈ Finset.range (n + 1), compCoeff n i ↑k) *
            multinomial (Finset.range (n + 1)) (fun i ↦ Multiset.count i ↑k * i)) *
            multinomial (Finset.range (n + 1)) (fun i ↦ Multiset.count i ↑k * (n - i))) *
          f p a * f (m * n - p) b := by
  rw [hadd ha hb, Nat.sum_antidiagonal_eq_sum_range_succ
    (f := fun i j ↦ f i a * f j b)]
  have L1 (k : Sym ℕ m) (i : ℕ) (hi : i ∈ Finset.range (n + 1)) :
      f (Multiset.count i ↑k) (f i a * f (n - i) b) =
        compCoeff n i ↑k * f (Multiset.count i ↑k * i) a *
          f (Multiset.count i ↑k * (n - i)) b := by
    simp only [compCoeff]
    by_cases hi2 : i = n
    · rw [hi2, Nat.sub_self, ite_eq_right hn, ite_eq_left rfl, hzero hb, mul_one,
        ha_comp hn]
      simp [hzero hb]
    · have hni : n - i ≠ 0 := by
        intro hzero'
        apply hi2
        rw [Finset.mem_range, Nat.lt_succ_iff] at hi
        rw [← Nat.sub_add_cancel hi, hzero', zero_add]
      by_cases hi1 : i = 0
      · rw [hi1, hzero ha, one_mul, Nat.sub_zero, hb_comp hn]
        simp [hzero ha]
      · rw [ite_eq_right hi1, ite_eq_right hi2, hmul (hmem hni hb),
          localDpowPow f a (hzero ha) ha_mul hi1, hb_comp hni]
        simp only [Nat.cast_mul]
        ring
  rw [_root_.DividedPowers.dpow_sum' (I := I.toAddSubmonoid) (dpow := f)
    (dpow_zero := hzero) (dpow_add := hadd)
    (dpow_eval_zero := fun {q} hq ↦ by
      rw [← MulZeroClass.mul_zero (0 : A), hmul I.zero_mem, zero_pow hq, zero_mul]
      ring)
    (hx := by
      intro i hi
      by_cases hi0 : i = 0
      · rw [hi0, hzero ha, Nat.sub_zero, one_mul]
        exact hmem hn hb
      · exact I.mul_mem_right _ (hmem hi0 ha))]
  let wt := fun (k : Sym ℕ m) ↦
      (Finset.range (n + 1)).sum (fun i ↦ Multiset.count i ↑k * i)
  have hwt : ∀ k ∈ (Finset.range (n + 1)).sym m, wt k ∈ Finset.range (m * n + 1) := by
    intro k hk
    simp only [wt, Finset.mem_range, Nat.lt_succ_iff]
    exact rangeSymWeightedSumLe hk
  rw [← Finset.sum_fiberwise_of_maps_to hwt]
  have hL4 : ∀ p (_ : p ∈ Finset.range (m * n + 1)),
        (∑ k ∈ ((Finset.range (n + 1)).sym m).filter (fun k ↦ wt k = p),
          ∏ i ∈ Finset.range (n + 1),
            f (Multiset.count i ↑k) (f i a * f (n - i) b)) =
        ∑ k ∈ ((Finset.range (n + 1)).sym m).filter (fun k ↦ wt k = p),
          (∏ i ∈ Finset.range (n + 1), compCoeff n i ↑k) *
            (multinomial (Finset.range (n + 1)) (fun i ↦ Multiset.count i ↑k * i) : A) *
            (multinomial (Finset.range (n + 1)) (fun i ↦ Multiset.count i ↑k * (n - i)) : A) *
            f p a * f (m * n - p) b := by
    intro p hp
    apply Finset.sum_congr rfl
    intro k hk
    rw [Finset.mem_filter] at hk
    rw [Finset.prod_congr rfl (L1 k), Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      localProdDpow f a (hzero ha) ha_mul,
      localProdDpow f b (hzero hb) hb_mul]
    simp only [mul_assoc]
    rw [sumRangeSymMulCompl hk.1]
    simp only [wt] at hk
    rw [hk.2]
    simp only [Nat.cast_prod]
    ring
  apply Finset.sum_congr rfl
  intro p hp
  rw [hL4 p hp]
  simp only [Nat.cast_sum, Nat.cast_mul, Nat.cast_prod]
  rw [Finset.sum_mul, Finset.sum_mul]

/-- The combinatorial identity behind the composition axiom: the coefficients produced by the
expansion of `γₘ(γₙ(a + b))` sum to `uniformBell m n` in each total degree. It is proved by
specialising to the universal case of the rational polynomial ring. -/
private theorem localDpowCompCoeffs {m n p : ℕ} (hn : n ≠ 0) (hp : p ≤ m * n) :
    uniformBell m n = ∑ k ∈ ((Finset.range (n + 1)).sym m).filter
      (fun l : Sym ℕ m ↦ (Finset.range (n + 1)).sum
        (fun i ↦ Multiset.count i ↑l * i) = p),
        (∏ i ∈ Finset.range (n + 1), compCoeff n i ↑k) *
          (multinomial (Finset.range (n + 1)) (fun i ↦ Multiset.count i ↑k * i) *
            multinomial (Finset.range (n + 1)) (fun i ↦ Multiset.count i ↑k * (n - i))) := by
  classical
  rw [← mul_left_inj' (pos_iff_ne_zero.mp (choose_pos hp))]
  apply @cast_injective ℚ
  simp only [
    Nat.cast_sum, Nat.cast_mul, Nat.cast_prod]
  conv_lhs => rw [← Polynomial.coeff_X_add_one_pow ℚ (m * n) p]
  let A := ℚ[X]
  let I : Ideal A := ⊤
  let hI : _root_.DividedPowers I := RatAlgebra.dividedPowers ⊤
  have h1 : (1 : A) ∈ I := Submodule.mem_top
  have hX : Polynomial.X ∈ I := Submodule.mem_top
  have hAux := localDpowCompAddAux I hI.dpow
    (fun {x} hx ↦ hI.dpow_zero hx)
    (fun {q x} hq hx ↦ hI.dpow_mem hq hx)
    (fun {q x y} hx hy ↦ hI.dpow_add hx hy)
    (fun {q c x} hx ↦ hI.dpow_mul hx)
    (m := m) (n := n) hn hX h1
    (fun q r ↦ hI.mul_dpow hX) (fun {q r} hq ↦ hI.dpow_comp hq hX)
    (fun q r ↦ hI.mul_dpow h1) (fun {q r} hq ↦ hI.dpow_comp hq h1)
  rw [← hI.factorial_mul_dpow_eq_pow Submodule.mem_top, ← Polynomial.coeff_C_mul,
    ← mul_assoc, mul_comm (Polynomial.C (uniformBell m n : ℚ)), mul_assoc,
    Polynomial.C_eq_natCast, ← hI.dpow_comp hn Submodule.mem_top, hAux,
    ← Polynomial.C_eq_natCast, Finset.mul_sum, Polynomial.finsetSum_coeff]
  simp only [hI, RatAlgebra.dpow_eq_inv_fact_smul _ _ Submodule.mem_top, map_natCast,
    Ring.inverse_eq_inv',
    Algebra.mul_smul_comm, one_pow, mul_one, Polynomial.coeff_smul,
    Polynomial.coeff_natCast_mul, smul_eq_mul]
  simp only [← Nat.cast_prod, ← Nat.cast_mul, ← Nat.cast_sum]
  rw [Finset.sum_eq_single p]
  · conv_lhs =>
      rw [Polynomial.coeff_natCast_mul, Polynomial.coeff_X_pow, ite_eq_left, mul_one,
        ← mul_assoc, mul_comm]
      simp only [mul_assoc]
      rw [mul_comm]
    simp only [Nat.cast_sum, Nat.cast_mul, Nat.cast_prod, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro k _
    simp only [mul_assoc]
    congr
    ring_nf
    simp only [mul_assoc]
    rw [inv_mul_eq_iff_eq_mul₀, inv_mul_eq_iff_eq_mul₀,
      ← Nat.choose_mul_factorial_mul_factorial hp]
    · simp only [Nat.cast_mul]
      ring
    all_goals
      simp only [ne_eq, Nat.cast_eq_zero]
      exact Nat.factorial_ne_zero _
  · intro q _ hq
    rw [Polynomial.coeff_natCast_mul, Polynomial.coeff_X_pow, ite_eq_right hq.symm]
    simp only [mul_zero]
  · intro hp'
    simp only [Finset.mem_range, Nat.lt_succ_iff] at hp'
    omega

/-- The product and iteration axioms for divided powers need only be checked on a set of
generators of the ideal, provided the other divided power axioms hold everywhere. -/
@[stacks 07GP]
public theorem exists_dividedPowers_of_axioms_on_generators
    {A : Type*} [CommRing A] (I : Ideal A) (dpow : ℕ → A → A) (S : Set A)
    (hS : I = Ideal.span S)
    (dpow_zero : ∀ {x : A}, x ∈ I → dpow 0 x = 1)
    (dpow_one : ∀ {x : A}, x ∈ I → dpow 1 x = x)
    (dpow_mem : ∀ {n : ℕ} {x : A}, n ≠ 0 → x ∈ I → dpow n x ∈ I)
    (dpow_add : ∀ {n : ℕ} {x y : A}, x ∈ I → y ∈ I →
      dpow n (x + y) = (antidiagonal n).sum fun k ↦ dpow k.1 x * dpow k.2 y)
    (dpow_mul : ∀ {n : ℕ} {a x : A}, x ∈ I →
      dpow n (a * x) = a ^ n * dpow n x)
    (mul_dpow_on_generators : ∀ {m n : ℕ} {x : A}, x ∈ S →
      dpow m x * dpow n x = (choose (m + n) m : A) * dpow (m + n) x)
    (dpow_comp_on_generators : ∀ {m n : ℕ} {x : A}, n ≠ 0 → x ∈ S →
      dpow m (dpow n x) = (uniformBell m n : A) * dpow (m * n) x) :
    ∃ hI : _root_.DividedPowers I, ∀ (n : ℕ) {x : A}, x ∈ I → hI.dpow n x = dpow n x := by
  classical
  have hzero_eval : ∀ n : ℕ, dpow n 0 = if n = 0 then 1 else 0 := by
    intro n
    by_cases hn : n = 0
    · simp [hn, dpow_zero I.zero_mem]
    · simpa [hn] using dpow_mul (n := n) (a := 0) (x := 0) I.zero_mem
  have hmul_span : ∀ x ∈ Ideal.span S, ∀ m n,
      dpow m x * dpow n x = (choose (m + n) m : A) * dpow (m + n) x := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hxS => exact fun m n ↦ mul_dpow_on_generators hxS
    | zero =>
        intro m n
        by_cases hm : m = 0 <;> by_cases hn : n = 0 <;>
          simp [hzero_eval, hm, hn]
    | add x y hx hy ihx ihy =>
        intro m n
        exact localMulDpowAdd I dpow x y (hS.symm ▸ hx) (hS.symm ▸ hy)
          (fun {q a b} ha hb ↦ dpow_add ha hb) ihx ihy
    | smul a x hx ih =>
        intro m n
        have hxI : x ∈ I := hS.symm ▸ hx
        show dpow m (a * x) * dpow n (a * x) =
          (choose (m + n) m : A) * dpow (m + n) (a * x)
        calc
          dpow m (a * x) * dpow n (a * x) =
              a ^ m * a ^ n * (dpow m x * dpow n x) := by
                rw [dpow_mul hxI, dpow_mul hxI]
                ring
          _ = a ^ m * a ^ n *
                ((choose (m + n) m : A) * dpow (m + n) x) := by rw [ih m n]
          _ = (choose (m + n) m : A) * dpow (m + n) (a * x) := by
                rw [dpow_mul hxI]
                ring
  have hmul_all : ∀ {x}, x ∈ I → ∀ m n,
      dpow m x * dpow n x = (choose (m + n) m : A) * dpow (m + n) x :=
    fun {x} hx ↦ hmul_span x (hS ▸ hx)
  have hcomp_span : ∀ x ∈ Ideal.span S, ∀ m n, n ≠ 0 →
      dpow m (dpow n x) = (uniformBell m n : A) * dpow (m * n) x := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hxS => exact fun m n hn ↦ dpow_comp_on_generators hn hxS
    | zero =>
        intro m n hn
        by_cases hm : m = 0
        · subst m
          simp [hzero_eval, hn, Nat.uniformBell_zero_left]
        · have hmn : m * n ≠ 0 := Nat.mul_ne_zero hm hn
          simp [hzero_eval, hn, hm, hmn]
    | add x y hx hy ihx ihy =>
        intro m n hn
        have hxI : x ∈ I := hS.symm ▸ hx
        have hyI : y ∈ I := hS.symm ▸ hy
        rw [localDpowCompAddAux I dpow dpow_zero dpow_mem dpow_add dpow_mul
          (m := m) (n := n) hn hxI hyI
          (fun q r ↦ hmul_all hxI q r) (fun {q r} hq ↦ ihx q r hq)
          (fun q r ↦ hmul_all hyI q r) (fun {q r} hq ↦ ihy q r hq)]
        calc
          _ = ∑ p ∈ Finset.range (m * n + 1),
                (uniformBell m n : A) * dpow p x * dpow (m * n - p) y := by
              refine Finset.sum_congr rfl fun p hp ↦ ?_
              have hc := congrArg (fun z : ℕ => (z : A))
                (localDpowCompCoeffs hn (Nat.le_of_lt_succ (Finset.mem_range.mp hp)))
              simpa [Nat.cast_sum, Nat.cast_mul, mul_assoc] using
                congrArg (fun c : A => c * dpow p x * dpow (m * n - p) y) hc.symm
          _ = (uniformBell m n : A) *
                ∑ p ∈ Finset.range (m * n + 1), dpow p x * dpow (m * n - p) y := by
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun p _ ↦ by ring
          _ = (uniformBell m n : A) * dpow (m * n) (x + y) := by
              rw [dpow_add hxI hyI,
                Nat.sum_antidiagonal_eq_sum_range_succ
                  (f := fun i j ↦ dpow i x * dpow j y)]
    | smul a x hx ih =>
        intro m n hn
        have hxI : x ∈ I := hS.symm ▸ hx
        show dpow m (dpow n (a * x)) =
          (uniformBell m n : A) * dpow (m * n) (a * x)
        calc
          dpow m (dpow n (a * x)) = dpow m (a ^ n * dpow n x) := by
            rw [dpow_mul hxI]
          _ = (a ^ n) ^ m * dpow m (dpow n x) := by
            rw [dpow_mul (dpow_mem hn hxI)]
          _ = (a ^ n) ^ m * ((uniformBell m n : A) * dpow (m * n) x) := by
            rw [ih m n hn]
          _ = (uniformBell m n : A) * dpow (m * n) (a * x) := by
            rw [dpow_mul hxI, ← pow_mul, Nat.mul_comm n m]
            ring
  have hcomp_all : ∀ {x}, x ∈ I → ∀ m n, n ≠ 0 →
      dpow m (dpow n x) = (uniformBell m n : A) * dpow (m * n) x :=
    fun {x} hx ↦ hcomp_span x (hS ▸ hx)
  let γ : ℕ → A → A := fun n x => if x ∈ I then dpow n x else 0
  let hγ : _root_.DividedPowers I := {
    dpow := γ
    dpow_null := by
      intro n x hx
      simp [γ, hx]
    dpow_zero := by
      intro x hx
      simp [γ, hx, dpow_zero hx]
    dpow_one := by
      intro x hx
      simp [γ, hx, dpow_one hx]
    dpow_mem := by
      intro n x hn hx
      simp [γ, hx, dpow_mem hn hx]
    dpow_add := by
      intro n x y hx hy
      simpa [γ, I.add_mem hx hy, hx, hy] using dpow_add hx hy
    dpow_mul := by
      intro n a x hx
      simpa [γ, hx, I.mul_mem_left a hx] using dpow_mul hx
    mul_dpow := by
      intro m n x hx
      simpa [γ, hx] using hmul_all hx m n
    dpow_comp := by
      intro m n x hn hx
      have hmem : dpow n x ∈ I := dpow_mem hn hx
      simpa [γ, hx, hmem] using hcomp_all hx m n hn
  }
  exact ⟨hγ, fun n _ hx ↦ by simp [hγ, γ, hx]⟩

end AxiomsOnGenerators

section TwoIdeals

add_to_stacks 07GQ "part (1)" DividedPowers.coincide_on_smul

/-- An element of `I + J` is a sum of an element of `I` and an element of `J`. -/
private lemma exists_add_eq_of_mem_add {A : Type*} [CommRing A] {I J : Ideal A} {z : A}
    (hz : z ∈ I + J) : ∃ x ∈ I, ∃ y ∈ J, x + y = z :=
  Submodule.mem_sup.mp hz

/-- The coefficients of a product of exponentials are the convolutions of the operations. -/
private lemma coeff_exp_mul_exp {A : Type*} [CommRing A] {I J : Ideal A}
    (γ : _root_.DividedPowers I) (δ : _root_.DividedPowers J) (x y : A) (n : ℕ) :
    PowerSeries.coeff n (γ.exp x * δ.exp y) =
      (Finset.antidiagonal n).sum (fun k ↦ γ.dpow k.1 x * δ.dpow k.2 y) := by
  simp [PowerSeries.coeff_mul, PowerSeries.coeff_mk, _root_.DividedPowers.exp]

/-- Two divided power structures agreeing on the intersection of their ideals give the same
convolution on any two decompositions of a common element. -/
private lemma convolution_eq_of_eq_add {A : Type*} [CommRing A] {I J : Ideal A}
    (γ : _root_.DividedPowers I) (δ : _root_.DividedPowers J)
    (h : ∀ (n : ℕ) {x : A}, x ∈ I ⊓ J → γ.dpow n x = δ.dpow n x)
    {x x' : A} {y y' : A} (hx : x ∈ I) (hx' : x' ∈ I)
    (hy : y ∈ J) (hy' : y' ∈ J) (he : x + y = x' + y') (n : ℕ) :
    (Finset.antidiagonal n).sum (fun k ↦ γ.dpow k.1 x * δ.dpow k.2 y) =
      (Finset.antidiagonal n).sum (fun k ↦ γ.dpow k.1 x' * δ.dpow k.2 y') := by
  let w := x - x'
  have hwI : w ∈ I := I.sub_mem hx hx'
  have he' : x - x' = y' - y := by
    calc
      x - x' = (x + y) - x' - y := by ring
      _ = y' - y := by rw [he]; ring
  have hwJ : w ∈ J := by simpa only [w, he'] using J.sub_mem hy' hy
  have hxy : x = x' + w := by simp [w]
  have hyy : y' = y + w := by dsimp [w]; rw [he']; ring
  have hw : γ.exp w = δ.exp w := by
    ext m
    simpa [_root_.DividedPowers.exp] using h m ⟨hwI, hwJ⟩
  have heq : γ.exp x * δ.exp y = γ.exp x' * δ.exp y' := by
    rw [hxy, hyy, γ.exp_add hx' hwI, δ.exp_add hy hwJ, hw]
    ac_rfl
  simpa only [coeff_exp_mul_exp] using congrArg (PowerSeries.coeff n) heq

/-- A chosen decomposition of an element of `I + J` as a sum of an element of `I` and an element
of `J`. -/
private noncomputable def decomp {A : Type*} [CommRing A] {I J : Ideal A}
    (z : A) (hz : z ∈ I + J) : {p : A × A // p.1 ∈ I ∧ p.2 ∈ J ∧ p.1 + p.2 = z} :=
  let he : ∃ p : A × A, p.1 ∈ I ∧ p.2 ∈ J ∧ p.1 + p.2 = z := by
    obtain ⟨x, hx, y, hy, hxy⟩ := exists_add_eq_of_mem_add hz
    exact ⟨(x, y), hx, hy, hxy⟩
  ⟨Classical.choose he, Classical.choose_spec he⟩

/-- The candidate divided power operation on `I + J` glued from those on `I` and on `J`. -/
private noncomputable def gluedDpow {A : Type*} [CommRing A] {I J : Ideal A}
    (γ : _root_.DividedPowers I) (δ : _root_.DividedPowers J) (n : ℕ) (z : A) : A :=
  by
    classical
    by_cases hz : z ∈ I + J
    · let p := decomp z hz
      exact (Finset.antidiagonal n).sum (fun k ↦ γ.dpow k.1 p.1.1 * δ.dpow k.2 p.1.2)
    · exact 0

/-- Divided power structures which agree on the intersection of their ideals extend uniquely
to the sum of the ideals. -/
@[stacks 07GQ "part (2)"]
public lemma existsUnique_on_ideal_add {A : Type*} [CommRing A] {I J : Ideal A}
    (γ : _root_.DividedPowers I)
    (δ : _root_.DividedPowers J)
    (h : ∀ (n : ℕ) {x : A}, x ∈ I ⊓ J → γ.dpow n x = δ.dpow n x) :
    ∃! ε : _root_.DividedPowers (I + J),
      (∀ (n : ℕ) {x : A}, x ∈ I → ε.dpow n x = γ.dpow n x) ∧
        (∀ (n : ℕ) {x : A}, x ∈ J → ε.dpow n x = δ.dpow n x) := by
  classical
  let f := gluedDpow γ δ
  have hf {n : ℕ} {z x y : A} (hx : x ∈ I) (hy : y ∈ J) (hez : x + y = z) :
      f n z = (Finset.antidiagonal n).sum
        (fun k ↦ γ.dpow k.1 x * δ.dpow k.2 y) := by
    have hz : z ∈ I + J := hez ▸ Submodule.add_mem_sup hx hy
    have hp := (decomp z hz).property
    dsimp [f, gluedDpow]
    rw [dite_eq_left (show z ∈ I ⊔ J from hz)]
    exact convolution_eq_of_eq_add γ δ h hp.1 hx hp.2.1 hy (hp.2.2.trans hez.symm) n
  have hS : I + J = Ideal.span ((I : Set A) ∪ (J : Set A)) := by
    rw [Ideal.span_union, Ideal.span_eq, Ideal.span_eq, Ideal.add_eq_sup]
  have inclI {x : A} (hx : x ∈ I) : x ∈ I + J := Submodule.mem_sup_left hx
  have inclJ {x : A} (hx : x ∈ J) : x ∈ I + J := Submodule.mem_sup_right hx
  have hfI {n : ℕ} {x : A} (hx : x ∈ I) : f n x = γ.dpow n x := by
    rw [show x = x + 0 by simp, hf hx J.zero_mem (by simp), γ.dpow_add hx I.zero_mem]
    apply Finset.sum_congr rfl
    intro k hk
    by_cases hk2 : k.2 = 0
    · have hsum := Finset.mem_antidiagonal.mp hk
      have hk1 : k.1 = n := by omega
      rw [hk1, hk2, δ.dpow_zero J.zero_mem, γ.dpow_zero I.zero_mem]
    · rw [δ.dpow_eval_zero hk2, γ.dpow_eval_zero hk2]
  have hfJ {n : ℕ} {x : A} (hx : x ∈ J) : f n x = δ.dpow n x := by
    rw [show x = 0 + x by simp, hf I.zero_mem hx (by simp), δ.dpow_add J.zero_mem hx]
    apply Finset.sum_congr rfl
    intro k hk
    by_cases hk1 : k.1 = 0
    · have hsum := Finset.mem_antidiagonal.mp hk
      have hk2 : k.2 = n := by omega
      rw [hk1, hk2, γ.dpow_zero I.zero_mem, δ.dpow_zero J.zero_mem]
    · rw [γ.dpow_eval_zero hk1, δ.dpow_eval_zero hk1]
  have hzero : ∀ {x : A}, x ∈ I + J → f 0 x = 1 := by
    intro x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := exists_add_eq_of_mem_add hx
    rw [hf ha hb rfl]
    simp [γ.dpow_zero ha, δ.dpow_zero hb]
  have hone : ∀ {x : A}, x ∈ I + J → f 1 x = x := by
    intro x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := exists_add_eq_of_mem_add hx
    rw [hf ha hb rfl]
    rw [show Finset.antidiagonal 1 = {(0, 1), (1, 0)} by
      ext ⟨k₁, k₂⟩; simp [Finset.mem_antidiagonal]; omega]
    simp [γ.dpow_zero ha, γ.dpow_one ha, δ.dpow_zero hb, δ.dpow_one hb, add_comm]
  have hmem : ∀ {n : ℕ} {x : A}, n ≠ 0 → x ∈ I + J → f n x ∈ I + J := by
    intro n x hn hx
    obtain ⟨a, ha, b, hb, rfl⟩ := exists_add_eq_of_mem_add hx
    rw [hf ha hb rfl]
    apply (I + J).sum_mem
    intro k hk
    by_cases hk0 : k.1 = 0
    · rw [hk0]
      have hk2 : k.2 ≠ 0 := by
        intro hk2
        have hh := Finset.mem_antidiagonal.mp hk
        omega
      exact (I + J).mul_mem_left _ (inclJ (δ.dpow_mem hk2 hb))
    · exact (I + J).mul_mem_right (δ.dpow k.2 b) (inclI (γ.dpow_mem hk0 ha))
  have hadd : ∀ {n : ℕ} {x y : A}, x ∈ I + J → y ∈ I + J →
      f n (x + y) = (Finset.antidiagonal n).sum (fun k ↦ f k.1 x * f k.2 y) := by
    intro n x y hx hy
    obtain ⟨a, ha, b, hb, rfl⟩ := exists_add_eq_of_mem_add hx
    obtain ⟨c, hc, d, hd, rfl⟩ := exists_add_eq_of_mem_add hy
    rw [show a + b + (c + d) = (a + c) + (b + d) by ring,
      hf (I.add_mem ha hc) (J.add_mem hb hd) rfl]
    simp_rw [hf ha hb rfl, hf hc hd rfl]
    have heq : γ.exp (a + c) * δ.exp (b + d) =
        (γ.exp a * δ.exp b) * (γ.exp c * δ.exp d) := by
      rw [γ.exp_add ha hc, δ.exp_add hb hd]
      ac_rfl
    rw [← coeff_exp_mul_exp, heq, PowerSeries.coeff_mul]
    simp only [coeff_exp_mul_exp]
  have hmul : ∀ {n : ℕ} {a x : A}, x ∈ I + J → f n (a * x) = a ^ n * f n x := by
    intro n a x hx
    obtain ⟨u, hu, v, hv, rfl⟩ := exists_add_eq_of_mem_add hx
    rw [show a * (u + v) = a * u + a * v by ring,
      hf (I.mul_mem_left a hu) (J.mul_mem_left a hv) rfl, hf hu hv rfl]
    simp_rw [γ.dpow_mul hu, δ.dpow_mul hv, Finset.mul_sum]
    refine Finset.sum_congr rfl fun k hk ↦ ?_
    rw [← Finset.mem_antidiagonal.mp hk]
    ring
  obtain ⟨ε, hε⟩ := exists_dividedPowers_of_axioms_on_generators
    (I + J) f ((I : Set A) ∪ (J : Set A)) hS hzero hone hmem hadd hmul (by
      rintro m n x (hx | hx)
      · rw [hfI hx, hfI hx, hfI hx]
        simpa using γ.mul_dpow hx
      · rw [hfJ hx, hfJ hx, hfJ hx]
        simpa using δ.mul_dpow hx) (by
      rintro m n x hn (hx | hx)
      · rw [hfI hx, hfI (γ.dpow_mem hn hx), hfI hx]
        simpa using γ.dpow_comp hn hx
      · rw [hfJ hx, hfJ (δ.dpow_mem hn hx), hfJ hx]
        simpa using δ.dpow_comp hn hx)
  refine ⟨ε, ?_, ?_⟩
  · constructor <;> intro n x hx
    · rw [hε n (inclI hx), hfI hx]
    · rw [hε n (inclJ hx), hfJ hx]
  · intro ε' hε'
    apply _root_.DividedPowers.ext ε' ε
    intro n x hx
    obtain ⟨a, ha, b, hb, rfl⟩ := exists_add_eq_of_mem_add hx
    have he' := ε'.dpow_add (n := n) (inclI ha) (inclJ hb)
    have he := ε.dpow_add (n := n) (inclI ha) (inclJ hb)
    rw [he', he]
    simp_rw [hε'.1 _ ha, hε'.2 _ hb, hε _ (inclI ha), hε _ (inclJ hb), hfI ha, hfJ hb]

end TwoIdeals

end DividedPowers
