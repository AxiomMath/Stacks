module

public import Mathlib.Algebra.CharP.Algebra
public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.FieldTheory.Finite.Basic
public import Mathlib.NumberTheory.Padics.RingHoms
public import Mathlib.RingTheory.DividedPowers.DPMorphism
public import Mathlib.RingTheory.DividedPowers.Padic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import StacksFrontier.RingTheory.DividedPowers.PrimeOperation

/-!
# An explicit divided power thickening in characteristic `p`

Fix a prime `p`. This file builds the finite dimensional `ZMod p`-algebra

`B = (ZMod p)[X₀, X₁, X₂, X₃] / (X₀X₁, X₀³, X₁³, X₀X₂, X₁X₂, X₀X₃, X₁X₃, X₂², X₃²)`,

writes `x, y, u, v` for the images of the four variables, and equips the ideal
`K = (x², y², u, v)` with a divided power structure, for every prime `p`.  For odd `p` its
`p`-th operation is `δ(k) = ξ(k)·u + η(k)·v`, where `ξ` and `η` read off the coefficients of
`x²` and of `y²`; at `p = 2` the same formula acquires the quadratic correction
`θ(k)·ι(k)·uv`, with `θ` and `ι` the coefficients of `u` and of `v`.  The correction is needed
because at `p = 2` the cross term `k·k'` of the addition law no longer vanishes; it equals
`(θ(k)ι(k') + θ(k')ι(k))·uv`, the polarisation of `θ·ι·uv`.  At every prime one has
`δ(x²) = u`, `δ(y²) = v` and `u·v ≠ 0`; together these exhibit a divided power thickening in
which a specific element of a completed divided power envelope does not vanish, which is the
computation of [Stacks Project, Tag 07LJ].

Unlike [Stacks Project, Tag 07LJ], which kills `x²y` and `xy²` but not `xy`, the ring here
kills `xy` itself; all nine relations are monomials.

## Main definitions

* `DividedPowers.TorsionWitness.Witness` — the ring `B` above.
* `DividedPowers.TorsionWitness.x`, `y`, `u`, `v` — the images of the four variables.
* `DividedPowers.TorsionWitness.K` — the ideal `(x², y², u, v)` of `B`.
* `DividedPowers.TorsionWitness.xi`, `eta`, `theta`, `iota` — the functionals on `B` reading
  off the coefficients of `x²`, `y²`, `u` and `v`.
* `DividedPowers.TorsionWitness.dpowCandidate` — the `p`-th divided power operation
  `k ↦ ξ(k)·u + η(k)·v` on `K`, which satisfies the hypotheses of [Stacks Project, Tag 07GS]
  for odd `p`, and `DividedPowers.TorsionWitness.dpowCandidateTwo` — its correction
  `k ↦ ξ(k)·u + η(k)·v + θ(k)·ι(k)·uv`, which satisfies them at `p = 2`.
* `DividedPowers.TorsionWitness.dividedPowersOfNeTwo` and
  `DividedPowers.TorsionWitness.dividedPowersOfTwo` — the divided power structures the two
  operations generate, and `DividedPowers.TorsionWitness.dividedPowers` — the divided power
  structure on `K` for an arbitrary prime, assembled from them.
* `DividedPowers.TorsionWitness.toWitness` — the ring map `ℤ_[p] → B` through `ZMod p`.
* `DividedPowers.TorsionWitness.mvPolynomialHom` — the ring map `ℤ_[p][T₀, T₁] → B` sending
  `T₀ ↦ x` and `T₁ ↦ y`.

## Main results

* `DividedPowers.TorsionWitness.u_mul_v_ne_zero` — the product `u·v` is nonzero in `B`.
* `DividedPowers.TorsionWitness.dividedPowers_dpow_x_sq` and
  `DividedPowers.TorsionWitness.dividedPowers_dpow_y_sq` — the divided power structure sends
  `x²` to `u` and `y²` to `v`, at every prime.
* `DividedPowers.TorsionWitness.mul_eq_of_mem` — the multiplication of `K` in the coordinates
  `θ`, `ι`: for `k`, `k'` in `K` one has `k·k' = (θ(k)ι(k') + θ(k')ι(k))·uv`.
* `DividedPowers.TorsionWitness.isDPMorphism_toWitness` — the map `ℤ_[p] → B` is a divided
  power morphism from the canonical divided powers on `(p) ⊆ ℤ_[p]`.

## References

* [Stacks Project, Tag 07LJ](https://stacks.math.columbia.edu/tag/07LJ)
* [Stacks Project, Tag 07GS](https://stacks.math.columbia.edu/tag/07GS)
-/

@[expose] public section

open MvPolynomial

namespace DividedPowers.TorsionWitness

/-- The exponents of the nine monomial relations cutting out the witness ring: in order,
`xy`, `x³`, `y³`, `xu`, `yu`, `xv`, `yv`, `u²` and `v²`. -/
public noncomputable def relExp : Fin 9 → (Fin 4 →₀ ℕ)
  | 0 => Finsupp.single 0 1 + Finsupp.single 1 1
  | 1 => Finsupp.single 0 3
  | 2 => Finsupp.single 1 3
  | 3 => Finsupp.single 0 1 + Finsupp.single 2 1
  | 4 => Finsupp.single 1 1 + Finsupp.single 2 1
  | 5 => Finsupp.single 0 1 + Finsupp.single 3 1
  | 6 => Finsupp.single 1 1 + Finsupp.single 3 1
  | 7 => Finsupp.single 2 2
  | 8 => Finsupp.single 3 2

variable (p : ℕ)

/-- The ideal of relations of the witness ring, generated by the nine monomials whose
exponents are listed in `DividedPowers.TorsionWitness.relExp`. -/
public noncomputable def rel : Ideal (MvPolynomial (Fin 4) (ZMod p)) :=
  Ideal.span (Set.range fun i => monomial (relExp i) (1 : ZMod p))

/-- The witness ring
`B = (ZMod p)[X₀, X₁, X₂, X₃] / (X₀X₁, X₀³, X₁³, X₀X₂, X₁X₂, X₀X₃, X₁X₃, X₂², X₃²)`. -/
public abbrev Witness : Type := MvPolynomial (Fin 4) (ZMod p) ⧸ rel p

/-- The image of the first variable in the witness ring. -/
public noncomputable def x : Witness p := Ideal.Quotient.mk (rel p) (X 0)

/-- The image of the second variable in the witness ring. -/
public noncomputable def y : Witness p := Ideal.Quotient.mk (rel p) (X 1)

/-- The image of the third variable in the witness ring. -/
public noncomputable def u : Witness p := Ideal.Quotient.mk (rel p) (X 2)

/-- The image of the fourth variable in the witness ring. -/
public noncomputable def v : Witness p := Ideal.Quotient.mk (rel p) (X 3)

private lemma x_eq : x p = Ideal.Quotient.mk (rel p) (X 0) := rfl
private lemma y_eq : y p = Ideal.Quotient.mk (rel p) (X 1) := rfl
private lemma u_eq : u p = Ideal.Quotient.mk (rel p) (X 2) := rfl
private lemma v_eq : v p = Ideal.Quotient.mk (rel p) (X 3) := rfl

private lemma mk_eq_zero (i : Fin 9) (G : MvPolynomial (Fin 4) (ZMod p))
    {F : MvPolynomial (Fin 4) (ZMod p)} (h : F = G * monomial (relExp i) 1) :
    Ideal.Quotient.mk (rel p) F = 0 := by
  rw [h, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The product `xy` vanishes in the witness ring. -/
public lemma x_mul_y_eq_zero : x p * y p = 0 := by
  rw [x_eq, y_eq, ← map_mul]
  exact mk_eq_zero p 0 1 (by simp [relExp, monomial_add_single, ← X_pow_eq_monomial])

private lemma x_pow_three_eq_zero : x p ^ 3 = 0 := by
  rw [x_eq, ← map_pow]
  exact mk_eq_zero p 1 1 (by simp [relExp, X_pow_eq_monomial])

private lemma y_pow_three_eq_zero : y p ^ 3 = 0 := by
  rw [y_eq, ← map_pow]
  exact mk_eq_zero p 2 1 (by simp [relExp, X_pow_eq_monomial])

private lemma x_mul_u_eq_zero : x p * u p = 0 := by
  rw [x_eq, u_eq, ← map_mul]
  exact mk_eq_zero p 3 1 (by simp [relExp, monomial_add_single, ← X_pow_eq_monomial])

private lemma y_mul_u_eq_zero : y p * u p = 0 := by
  rw [y_eq, u_eq, ← map_mul]
  exact mk_eq_zero p 4 1 (by simp [relExp, monomial_add_single, ← X_pow_eq_monomial])

private lemma x_mul_v_eq_zero : x p * v p = 0 := by
  rw [x_eq, v_eq, ← map_mul]
  exact mk_eq_zero p 5 1 (by simp [relExp, monomial_add_single, ← X_pow_eq_monomial])

private lemma y_mul_v_eq_zero : y p * v p = 0 := by
  rw [y_eq, v_eq, ← map_mul]
  exact mk_eq_zero p 6 1 (by simp [relExp, monomial_add_single, ← X_pow_eq_monomial])

private lemma u_sq_eq_zero : u p ^ 2 = 0 := by
  rw [u_eq, ← map_pow]
  exact mk_eq_zero p 7 1 (by simp [relExp, X_pow_eq_monomial])

private lemma v_sq_eq_zero : v p ^ 2 = 0 := by
  rw [v_eq, ← map_pow]
  exact mk_eq_zero p 8 1 (by simp [relExp, X_pow_eq_monomial])

private lemma u_pow_three_eq_zero : u p ^ 3 = 0 := by
  rw [pow_succ, u_sq_eq_zero, zero_mul]

private lemma v_pow_three_eq_zero : v p ^ 3 = 0 := by
  rw [pow_succ, v_sq_eq_zero, zero_mul]

private lemma mk_X_pow_three (n : Fin 4) : Ideal.Quotient.mk (rel p) (X n) ^ 3 = 0 := by
  fin_cases n
  · exact x_pow_three_eq_zero p
  · exact y_pow_three_eq_zero p
  · exact u_pow_three_eq_zero p
  · exact v_pow_three_eq_zero p

/-! ### Coefficient functionals -/

/-- No relation exponent is below an exponent whose coordinates are small and in which none of
the pairs `X₀X₁`, `X₀X₂`, `X₁X₂`, `X₀X₃`, `X₁X₃` occurs. -/
private lemma not_relExp_le {s : Fin 4 →₀ ℕ}
    (h : s 0 ≤ 2 ∧ s 1 ≤ 2 ∧ s 2 ≤ 1 ∧ s 3 ≤ 1 ∧ (s 0 = 0 ∨ s 1 = 0) ∧ (s 0 = 0 ∨ s 2 = 0) ∧
      (s 1 = 0 ∨ s 2 = 0) ∧ (s 0 = 0 ∨ s 3 = 0) ∧ (s 1 = 0 ∨ s 3 = 0)) :
    ∀ i, ¬ relExp i ≤ s := by
  intro i hle
  have h0 := hle 0
  have h1 := hle 1
  have h2 := hle 2
  have h3 := hle 3
  fin_cases i <;> simp [relExp] at h0 h1 h2 h3 <;> omega

/-- No relation exponent is below the exponent of `x²`. -/
public lemma good_xx : ∀ i, ¬ relExp i ≤ Finsupp.single (0 : Fin 4) 2 :=
  not_relExp_le (by simp)

/-- No relation exponent is below the exponent of `y²`. -/
public lemma good_yy : ∀ i, ¬ relExp i ≤ Finsupp.single (1 : Fin 4) 2 :=
  not_relExp_le (by simp)

/-- No relation exponent is below the exponent of `uv`. -/
public lemma good_uv :
    ∀ i, ¬ relExp i ≤ Finsupp.single (2 : Fin 4) 1 + Finsupp.single (3 : Fin 4) 1 :=
  not_relExp_le (by simp)

/-- No relation exponent is below the zero exponent. -/
public lemma good_zero : ∀ i, ¬ relExp i ≤ (0 : Fin 4 →₀ ℕ) :=
  not_relExp_le (by simp)

/-- A coefficient functional vanishes on the relation ideal as soon as no relation exponent
lies below the exponent it reads off. -/
public lemma coeff_eq_zero_of_mem_rel {F : MvPolynomial (Fin 4) (ZMod p)} (hF : F ∈ rel p)
    {s : Fin 4 →₀ ℕ} (hs : ∀ i, ¬ relExp i ≤ s) : coeff s F = 0 := by
  classical
  obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hF
  rw [coeff_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [coeff_mul_monomial']
  simp [hs i]

/-- The `ZMod p`-linear functional on the witness ring reading off the coefficient of the
monomial with exponent `s`, available whenever no relation exponent lies below `s`. -/
public noncomputable def coeffFun (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s) :
    Witness p → ZMod p :=
  Quotient.lift (fun F => coeff s F) fun a b hab => by
    have h2 := coeff_eq_zero_of_mem_rel p ((Submodule.quotientRel_def _).mp hab) hs
    rwa [coeff_sub, sub_eq_zero] at h2

private lemma coeffFun_mk (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s)
    (F : MvPolynomial (Fin 4) (ZMod p)) :
    coeffFun p s hs (Ideal.Quotient.mk (rel p) F) = coeff s F := rfl

private lemma coeffFun_zero (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s) :
    coeffFun p s hs 0 = 0 := by
  rw [show (0 : Witness p) = Ideal.Quotient.mk (rel p) 0 from (map_zero _).symm, coeffFun_mk,
    coeff_zero]

private lemma coeffFun_add (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s) (a b : Witness p) :
    coeffFun p s hs (a + b) = coeffFun p s hs a + coeffFun p s hs b := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [← map_add, coeffFun_mk, coeffFun_mk, coeffFun_mk, coeff_add]

/-- The coefficient of `x²`, as a functional on the witness ring. -/
public noncomputable def xi : Witness p → ZMod p :=
  coeffFun p (Finsupp.single 0 2) good_xx

/-- The coefficient of `y²`, as a functional on the witness ring. -/
public noncomputable def eta : Witness p → ZMod p :=
  coeffFun p (Finsupp.single 1 2) good_yy

/-- The coefficient of `uv`, as a functional on the witness ring. -/
public noncomputable def zeta : Witness p → ZMod p :=
  coeffFun p (Finsupp.single 2 1 + Finsupp.single 3 1) good_uv

/-- The augmentation of the witness ring, reading off the constant coefficient. -/
public noncomputable def eps : Witness p →+* ZMod p :=
  Ideal.Quotient.lift (rel p) constantCoeff fun F hF => by
    rw [constantCoeff_eq]
    exact coeff_eq_zero_of_mem_rel p hF good_zero

private lemma eps_mk (F : MvPolynomial (Fin 4) (ZMod p)) :
    eps p (Ideal.Quotient.mk (rel p) F) = constantCoeff F := rfl

private lemma mk_C (r : ZMod p) :
    Ideal.Quotient.mk (rel p) (C r) = algebraMap (ZMod p) (Witness p) r := by
  rw [← MvPolynomial.algebraMap_eq]
  exact Ideal.Quotient.mk_algebraMap _ _ _

private lemma eps_algebraMap (r : ZMod p) : eps p (algebraMap (ZMod p) (Witness p) r) = r := by
  rw [← mk_C, eps_mk, constantCoeff_C]

private lemma algebraMap_injective : Function.Injective (algebraMap (ZMod p) (Witness p)) :=
  Function.LeftInverse.injective (eps_algebraMap p)

/-- The witness ring has characteristic `p`. -/
public instance instCharP : CharP (Witness p) p :=
  charP_of_injective_algebraMap (algebraMap_injective p) p

/-- The prime `p` vanishes in the witness ring. -/
public lemma natCast_eq_zero : (p : Witness p) = 0 := CharP.cast_eq_zero (Witness p) p

/-! ### The ideal `K` and its vanishing cube -/

/-- The ideal `K = (x², y², u, v)` of the witness ring. -/
public noncomputable def K : Ideal (Witness p) := Ideal.span {x p ^ 2, y p ^ 2, u p, v p}

/-- The square of `x` lies in `K`. -/
public lemma x_sq_mem : x p ^ 2 ∈ K p := Ideal.subset_span (by simp)

/-- The square of `y` lies in `K`. -/
public lemma y_sq_mem : y p ^ 2 ∈ K p := Ideal.subset_span (by simp)

/-- The element `u` lies in `K`. -/
public lemma u_mem : u p ∈ K p := Ideal.subset_span (by simp)

/-- The element `v` lies in `K`. -/
public lemma v_mem : v p ∈ K p := Ideal.subset_span (by simp)

private lemma mem_span_of_eq_zero {z w : Witness p} (h : z = 0) :
    z ∈ Ideal.span ({w} : Set (Witness p)) := by rw [h]; exact Submodule.zero_mem _

/-- A product of two spans lies in an ideal as soon as the products of generators do. -/
private lemma span_mul_span_le {S T : Set (Witness p)} {I : Ideal (Witness p)}
    (h : ∀ a ∈ S, ∀ b ∈ T, a * b ∈ I) : Ideal.span S * Ideal.span T ≤ I := by
  rw [Ideal.span_mul_span, Ideal.span_le]
  rintro _ ⟨a, ha, b, hb, rfl⟩
  exact h a ha b hb

/-- A product of two spans vanishes as soon as the products of generators do. -/
private lemma span_mul_span_le_bot {S T : Set (Witness p)}
    (h : ∀ a ∈ S, ∀ b ∈ T, a * b = 0) : Ideal.span S * Ideal.span T ≤ ⊥ :=
  span_mul_span_le p fun a ha b hb => (Submodule.mem_bot _).mpr (h a ha b hb)

private lemma K_mul_K_le : K p * K p ≤ Ideal.span {u p * v p} := by
  refine span_mul_span_le p fun a ha b hb => ?_
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl
  · exact mem_span_of_eq_zero p (by linear_combination x p * x_pow_three_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination (x p * y p) * x_mul_y_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination x p * x_mul_u_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination x p * x_mul_v_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination (x p * y p) * x_mul_y_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination y p * y_pow_three_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination y p * y_mul_u_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination y p * y_mul_v_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination x p * x_mul_u_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination y p * y_mul_u_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination u_sq_eq_zero p)
  · exact Ideal.subset_span rfl
  · exact mem_span_of_eq_zero p (by linear_combination x p * x_mul_v_eq_zero p)
  · exact mem_span_of_eq_zero p (by linear_combination y p * y_mul_v_eq_zero p)
  · exact Ideal.mem_span_singleton'.mpr ⟨1, by ring⟩
  · exact mem_span_of_eq_zero p (by linear_combination v_sq_eq_zero p)

private lemma span_uv_mul_K_le : Ideal.span {u p * v p} * K p ≤ ⊥ := by
  refine span_mul_span_le_bot p fun a ha b hb => ?_
  simp only [Set.mem_singleton_iff] at ha
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
  subst ha
  rcases hb with rfl | rfl | rfl | rfl
  · linear_combination (x p * v p) * x_mul_u_eq_zero p
  · linear_combination (y p * v p) * y_mul_u_eq_zero p
  · linear_combination v p * u_sq_eq_zero p
  · linear_combination u p * v_sq_eq_zero p

private lemma K_pow_three_eq_bot : K p ^ 3 = ⊥ := by
  rw [pow_succ, pow_succ, pow_one]
  exact le_bot_iff.mp ((Ideal.mul_mono (K_mul_K_le p) le_rfl).trans (span_uv_mul_K_le p))

private lemma pow_mul_pow_eq_zero {a b : Witness p} (ha : a ∈ K p) (hb : b ∈ K p) {i j : ℕ}
    (hij : 3 ≤ i + j) : a ^ i * b ^ j = 0 := by
  have hmem : a ^ i * b ^ j ∈ K p ^ i * K p ^ j :=
    Ideal.mul_mem_mul (Ideal.pow_mem_pow ha i) (Ideal.pow_mem_pow hb j)
  rw [← pow_add] at hmem
  have hle : K p ^ (i + j) ≤ K p ^ 3 := Ideal.pow_le_pow_right hij
  rw [K_pow_three_eq_bot p] at hle
  exact (Submodule.mem_bot _).mp (hle hmem)

/-! ### The functionals on the generators of `K` -/

private lemma x_sq_eq : x p ^ 2 = Ideal.Quotient.mk (rel p) (monomial (Finsupp.single 0 2) 1) := by
  rw [x_eq, ← map_pow, X_pow_eq_monomial]

private lemma y_sq_eq : y p ^ 2 = Ideal.Quotient.mk (rel p) (monomial (Finsupp.single 1 2) 1) := by
  rw [y_eq, ← map_pow, X_pow_eq_monomial]

/-- Every element of `K` is a combination of the four generators `x²`, `y²`, `u`, `v`. -/
private lemma exists_decomposition {k : Witness p} (hk : k ∈ K p) :
    ∃ a b c d : Witness p, k = a * x p ^ 2 + b * y p ^ 2 + c * u p + d * v p := by
  rw [K, show ({x p ^ 2, y p ^ 2, u p, v p} : Set (Witness p)) =
      insert (x p ^ 2) (insert (y p ^ 2) (insert (u p) {v p})) from rfl] at hk
  obtain ⟨a, z₁, hz₁, rfl⟩ := Ideal.mem_span_insert.mp hk
  obtain ⟨b, z₂, hz₂, rfl⟩ := Ideal.mem_span_insert.mp hz₁
  obtain ⟨c, z₃, hz₃, rfl⟩ := Ideal.mem_span_insert.mp hz₂
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hz₃
  exact ⟨a, b, c, d, by rw [← hd]; ring⟩

/-- A coefficient functional is `eps`-linear on multiples of a monomial `t` that it either
reads off exactly or does not see at all. -/
private lemma coeffFun_mul_of_monomial (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s)
    {z : Witness p} {t : Fin 4 →₀ ℕ} (hz : z = Ideal.Quotient.mk (rel p) (monomial t 1))
    (ht : t = s ∨ ¬ t ≤ s) (a : Witness p) :
    coeffFun p s hs (a * z) = eps p a * coeffFun p s hs z := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [hz, ← map_mul, coeffFun_mk, coeffFun_mk, eps_mk]
  rcases ht with rfl | ht
  · simp [coeff_mul_monomial', coeff_monomial, constantCoeff_eq]
  · simp [coeff_mul_monomial', coeff_monomial, ht, ne_of_not_le ht]

/-- The value of a coefficient functional on a combination `A·x² + B·y² + C·u + D·v`, when
each generator is either read off exactly or not seen at all. -/
private lemma coeffFun_decomposition (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s)
    (h : (Finsupp.single 0 2 = s ∨ ¬ Finsupp.single 0 2 ≤ s) ∧
      (Finsupp.single 1 2 = s ∨ ¬ Finsupp.single 1 2 ≤ s) ∧
      (Finsupp.single 2 1 = s ∨ ¬ Finsupp.single 2 1 ≤ s) ∧
      (Finsupp.single 3 1 = s ∨ ¬ Finsupp.single 3 1 ≤ s)) (A B C D : Witness p) :
    coeffFun p s hs (A * x p ^ 2 + B * y p ^ 2 + C * u p + D * v p) =
      eps p A * coeffFun p s hs (x p ^ 2) + eps p B * coeffFun p s hs (y p ^ 2) +
        eps p C * coeffFun p s hs (u p) + eps p D * coeffFun p s hs (v p) := by
  rw [coeffFun_add, coeffFun_add, coeffFun_add, coeffFun_mul_of_monomial p s hs (x_sq_eq p) h.1,
    coeffFun_mul_of_monomial p s hs (y_sq_eq p) h.2.1, coeffFun_mul_of_monomial p s hs (u_eq p)
      h.2.2.1, coeffFun_mul_of_monomial p s hs (v_eq p) h.2.2.2]

/-- Under the hypothesis of `coeffFun_decomposition`, a coefficient functional is `eps`-linear
on `K`. -/
private lemma coeffFun_mul_of_mem (s : Fin 4 →₀ ℕ) (hs : ∀ i, ¬ relExp i ≤ s)
    (h : (Finsupp.single 0 2 = s ∨ ¬ Finsupp.single 0 2 ≤ s) ∧
      (Finsupp.single 1 2 = s ∨ ¬ Finsupp.single 1 2 ≤ s) ∧
      (Finsupp.single 2 1 = s ∨ ¬ Finsupp.single 2 1 ≤ s) ∧
      (Finsupp.single 3 1 = s ∨ ¬ Finsupp.single 3 1 ≤ s)) {k : Witness p} (hk : k ∈ K p)
    (a : Witness p) : coeffFun p s hs (a * k) = eps p a * coeffFun p s hs k := by
  obtain ⟨A, B, C, D, rfl⟩ := exists_decomposition p hk
  rw [show a * (A * x p ^ 2 + B * y p ^ 2 + C * u p + D * v p) = (a * A) * x p ^ 2 +
    (a * B) * y p ^ 2 + (a * C) * u p + (a * D) * v p by ring, coeffFun_decomposition p s hs h,
    coeffFun_decomposition p s hs h]
  simp only [map_mul]
  ring

private lemma xi_mul_of_mem {k : Witness p} (hk : k ∈ K p) (a : Witness p) :
    xi p (a * k) = eps p a * xi p k :=
  coeffFun_mul_of_mem p _ good_xx (by simp) hk a

private lemma eta_mul_of_mem {k : Witness p} (hk : k ∈ K p) (a : Witness p) :
    eta p (a * k) = eps p a * eta p k :=
  coeffFun_mul_of_mem p _ good_yy (by simp) hk a

/-! ### Nonvanishing of `uv` -/

/-- The product `uv` is nonzero in the witness ring. -/
public lemma u_mul_v_ne_zero [Fact p.Prime] : u p * v p ≠ 0 := by
  have hval : zeta p (u p * v p) = 1 := by
    rw [u_eq, v_eq, ← map_mul]
    show coeff (Finsupp.single 2 1 + Finsupp.single 3 1) (X 2 * X 3) = 1
    rw [coeff_X_mul]
    simp
  intro hzero
  rw [hzero, zeta, coeffFun_zero] at hval
  exact zero_ne_one hval

/-! ### The `p`-th power map -/

private lemma three_le [hp : Fact p.Prime] (hp2 : p ≠ 2) : 3 ≤ p := by
  have h2 := hp.out.two_le
  omega

private lemma mk_X_pow_card [Fact p.Prime] (hp2 : p ≠ 2) (n : Fin 4) :
    Ideal.Quotient.mk (rel p) (X n) ^ p = 0 := by
  have hsplit : Ideal.Quotient.mk (rel p) (X n) ^ p
      = Ideal.Quotient.mk (rel p) (X n) ^ 3 * Ideal.Quotient.mk (rel p) (X n) ^ (p - 3) := by
    rw [← pow_add]
    congr 1
    have := three_le p hp2
    omega
  rw [hsplit, mk_X_pow_three, zero_mul]

private lemma pow_card [Fact p.Prime] (hp2 : p ≠ 2) (a : Witness p) :
    a ^ p = algebraMap (ZMod p) (Witness p) (eps p a) := by
  have : ExpChar (Witness p) p := .prime Fact.out
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
  induction F using MvPolynomial.induction_on with
  | C r =>
      rw [mk_C, eps_algebraMap, ← map_pow, ZMod.pow_card]
  | add F G hF hG =>
      rw [map_add, add_pow_char, hF, hG, map_add, map_add]
  | mul_X F n hF =>
      rw [map_mul, mul_pow, mk_X_pow_card p hp2, mul_zero, map_mul]
      simp [eps_mk, constantCoeff_X]

/-! ### The divided power structure -/

/-- Every natural number prime to `p` is invertible in the witness ring. -/
public lemma isUnit_natCast [Fact p.Prime] (n : ℕ) (hn : ¬ p ∣ n) : IsUnit (n : Witness p) := by
  have hne : (n : ZMod p) ≠ 0 := fun h => hn ((CharP.cast_eq_zero_iff (ZMod p) p n).mp h)
  have hu : IsUnit (n : ZMod p) := isUnit_iff_ne_zero.mpr hne
  simpa using hu.map (algebraMap (ZMod p) (Witness p))

/-- The proposed `p`-th divided power operation on `K`, sending `k` to
`ξ(k)·u + η(k)·v`. -/
public noncomputable def dpowCandidate : K p → K p := fun k =>
  ⟨algebraMap (ZMod p) (Witness p) (xi p k) * u p
      + algebraMap (ZMod p) (Witness p) (eta p k) * v p,
    Ideal.add_mem _ (Ideal.mul_mem_left _ _ (u_mem p)) (Ideal.mul_mem_left _ _ (v_mem p))⟩

private lemma coe_dpowCandidate (k : K p) : (dpowCandidate p k : Witness p)
    = algebraMap (ZMod p) (Witness p) (xi p k) * u p
      + algebraMap (ZMod p) (Witness p) (eta p k) * v p := rfl

/-- The factorial `p!` vanishes in the witness ring. -/
private lemma factorial_cast_eq_zero [hp : Fact p.Prime] : (p.factorial : Witness p) = 0 :=
  (CharP.cast_eq_zero_iff (Witness p) p _).mpr (Nat.dvd_factorial hp.out.pos le_rfl)

/-- The factorial identity for the proposed `p`-th operation, for odd `p`. -/
public lemma dpowCandidate_factorial [hp : Fact p.Prime] (hp2 : p ≠ 2) (k : K p) :
    (p.factorial : Witness p) * (dpowCandidate p k : Witness p) = (k : Witness p) ^ p := by
  have hk : (k : Witness p) ^ p * (k : Witness p) ^ 0 = 0 :=
    pow_mul_pow_eq_zero p k.2 k.2 (by have := three_le p hp2; omega)
  rw [factorial_cast_eq_zero, zero_mul]
  simpa using hk.symm

/-- Homogeneity of the proposed `p`-th operation, for odd `p`. -/
public lemma dpowCandidate_smul [Fact p.Prime] (hp2 : p ≠ 2) (a : Witness p) (k : K p) :
    dpowCandidate p (a • k) = a ^ p • dpowCandidate p k := by
  apply Subtype.ext
  rw [Submodule.coe_smul, coe_dpowCandidate, coe_dpowCandidate, Submodule.coe_smul, smul_eq_mul,
    smul_eq_mul, pow_card p hp2 a, xi_mul_of_mem p k.2 a, eta_mul_of_mem p k.2 a, map_mul,
    map_mul]
  ring

/-- The addition law for the proposed `p`-th operation, for odd `p`. -/
public lemma dpowCandidate_add [hp : Fact p.Prime] (hp2 : p ≠ 2) (k k' : K p) :
    (dpowCandidate p (k + k') : Witness p) = (dpowCandidate p k : Witness p) +
      ∑ ij ∈ (Finset.antidiagonal p).filter (fun ij ↦ ij.1 ≠ 0 ∧ ij.2 ≠ 0),
        _root_.DividedPowers.factorialInverse p hp.out (isUnit_natCast p) ij.1 *
          _root_.DividedPowers.factorialInverse p hp.out (isUnit_natCast p) ij.2 *
          (k : Witness p) ^ ij.1 * (k' : Witness p) ^ ij.2 +
      (dpowCandidate p k' : Witness p) := by
  have h3 := three_le p hp2
  rw [Finset.sum_eq_zero (fun ij hij => ?_), add_zero]
  · rw [coe_dpowCandidate, coe_dpowCandidate, coe_dpowCandidate, Submodule.coe_add, xi,
      eta, coeffFun_add, coeffFun_add, map_add, map_add]
    ring
  · simp only [Finset.mem_filter, Finset.mem_antidiagonal] at hij
    obtain ⟨hsum, hi, hj⟩ := hij
    rw [mul_assoc, pow_mul_pow_eq_zero p k.2 k'.2 (by omega), mul_zero]

/-- The divided power structure on `K` for odd `p`, whose `p`-th operation is
`DividedPowers.TorsionWitness.dpowCandidate`. -/
public noncomputable def dividedPowersOfNeTwo [hp : Fact p.Prime] (hp2 : p ≠ 2) :
    _root_.DividedPowers (K p) :=
  (_root_.DividedPowers.existsUnique_of_prime_operation (K p) p hp.out (isUnit_natCast p)
    (dpowCandidate p) (dpowCandidate_factorial p hp2) (dpowCandidate_smul p hp2)
    (dpowCandidate_add p hp2)).choose

/-- The `p`-th operation of `DividedPowers.TorsionWitness.dividedPowersOfNeTwo` is
`DividedPowers.TorsionWitness.dpowCandidate`. -/
public lemma dividedPowersOfNeTwo_dpow [hp : Fact p.Prime] (hp2 : p ≠ 2) (k : K p) :
    (dividedPowersOfNeTwo p hp2).dpow p k = dpowCandidate p k :=
  (_root_.DividedPowers.existsUnique_of_prime_operation (K p) p hp.out (isUnit_natCast p)
    (dpowCandidate p) (dpowCandidate_factorial p hp2) (dpowCandidate_smul p hp2)
    (dpowCandidate_add p hp2)).choose_spec.1 k

/-- For odd `p`, the `p`-th divided power of `x²` is `u`. -/
public lemma dividedPowersOfNeTwo_dpow_x_sq [Fact p.Prime] (hp2 : p ≠ 2) :
    (dividedPowersOfNeTwo p hp2).dpow p (x p ^ 2) = u p := by
  have h := dividedPowersOfNeTwo_dpow p hp2 ⟨x p ^ 2, x_sq_mem p⟩
  rw [coe_dpowCandidate] at h
  simpa [xi, eta, x_sq_eq, coeffFun_mk, coeff_monomial, Finsupp.single_eq_single_iff] using h

/-- For odd `p`, the `p`-th divided power of `y²` is `v`. -/
public lemma dividedPowersOfNeTwo_dpow_y_sq [Fact p.Prime] (hp2 : p ≠ 2) :
    (dividedPowersOfNeTwo p hp2).dpow p (y p ^ 2) = v p := by
  have h := dividedPowersOfNeTwo_dpow p hp2 ⟨y p ^ 2, y_sq_mem p⟩
  rw [coe_dpowCandidate] at h
  simpa [xi, eta, y_sq_eq, coeffFun_mk, coeff_monomial, Finsupp.single_eq_single_iff] using h

/-! ### The coefficients of `u` and of `v` -/

/-- No relation exponent is below the exponent of `u`. -/
public lemma good_u : ∀ i, ¬ relExp i ≤ Finsupp.single (2 : Fin 4) 1 :=
  not_relExp_le (by simp)

/-- No relation exponent is below the exponent of `v`. -/
public lemma good_v : ∀ i, ¬ relExp i ≤ Finsupp.single (3 : Fin 4) 1 :=
  not_relExp_le (by simp)

/-- The coefficient of `u`, as a functional on the witness ring. -/
public noncomputable def theta : Witness p → ZMod p :=
  coeffFun p (Finsupp.single 2 1) good_u

/-- The coefficient of `v`, as a functional on the witness ring. -/
public noncomputable def iota : Witness p → ZMod p :=
  coeffFun p (Finsupp.single 3 1) good_v

/-- The coefficient of `u` of a combination `A·x² + B·y² + C·u + D·v` is the constant
coefficient of `C`. -/
private lemma theta_of_decomposition (A B C D : Witness p) :
    theta p (A * x p ^ 2 + B * y p ^ 2 + C * u p + D * v p) = eps p C := by
  rw [theta, coeffFun_decomposition p _ good_u (by simp)]
  simp [x_sq_eq, y_sq_eq, u_eq, v_eq, coeffFun_mk, coeff_monomial, coeff_X,
    Finsupp.single_eq_single_iff]

/-- The coefficient of `v` of a combination `A·x² + B·y² + C·u + D·v` is the constant
coefficient of `D`. -/
private lemma iota_of_decomposition (A B C D : Witness p) :
    iota p (A * x p ^ 2 + B * y p ^ 2 + C * u p + D * v p) = eps p D := by
  rw [iota, coeffFun_decomposition p _ good_v (by simp)]
  simp [x_sq_eq, y_sq_eq, u_eq, v_eq, coeffFun_mk, coeff_monomial, coeff_X,
    Finsupp.single_eq_single_iff]

/-! ### The shape of the ideal `K`, and absorption into `uv` -/

/-- The augmentation ideal `(x, y, u, v)` of the witness ring. -/
private noncomputable def aug : Ideal (Witness p) := Ideal.span {x p, y p, u p, v p}

private lemma sub_eps_mem_aug (a : Witness p) :
    a - algebraMap (ZMod p) (Witness p) (eps p a) ∈ aug p := by
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
  induction F using MvPolynomial.induction_on with
  | C r =>
      rw [mk_C, eps_algebraMap, sub_self]
      exact (aug p).zero_mem
  | add F G hF hG =>
      rw [map_add, map_add, map_add, add_sub_add_comm]
      exact (aug p).add_mem hF hG
  | mul_X F n hF =>
      have hz : eps p (Ideal.Quotient.mk (rel p) (F * X n)) = 0 := by
        rw [eps_mk, map_mul, constantCoeff_X, mul_zero]
      rw [hz, map_zero, sub_zero, map_mul]
      refine Ideal.mul_mem_left _ _ (Ideal.subset_span ?_)
      fin_cases n
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
      · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
      · exact Set.mem_insert_of_mem _
          (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))

private lemma aug_mul_uv_eq_zero {z : Witness p} (hz : z ∈ aug p) :
    z * (u p * v p) = 0 := by
  have hle : aug p * Ideal.span {u p * v p} ≤ ⊥ := by
    refine span_mul_span_le_bot p fun a ha b hb => ?_
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    subst hb
    rcases ha with rfl | rfl | rfl | rfl
    · linear_combination v p * x_mul_u_eq_zero p
    · linear_combination v p * y_mul_u_eq_zero p
    · linear_combination v p * u_sq_eq_zero p
    · linear_combination u p * v_sq_eq_zero p
  exact (Submodule.mem_bot _).mp (hle (Ideal.mul_mem_mul hz (Ideal.subset_span rfl)))

/-- Multiplication by `uv` sees only the constant coefficient. -/
private lemma mul_uv (z : Witness p) :
    z * (u p * v p) = algebraMap (ZMod p) (Witness p) (eps p z) * (u p * v p) := by
  linear_combination aug_mul_uv_eq_zero p (sub_eps_mem_aug p z)

/-- **The multiplication of `K` in terms of the coefficients of `u` and `v`:** for `k`, `k'`
in `K` one has `k·k' = (θ(k)ι(k') + θ(k')ι(k))·uv`. -/
public lemma mul_eq_of_mem {k k' : Witness p} (hk : k ∈ K p) (hk' : k' ∈ K p) :
    k * k' = algebraMap (ZMod p) (Witness p)
      (theta p k * iota p k' + theta p k' * iota p k) * (u p * v p) := by
  obtain ⟨a, b, c, d, rfl⟩ := exists_decomposition p hk
  obtain ⟨a', b', c', d', rfl⟩ := exists_decomposition p hk'
  have hprod : (a * x p ^ 2 + b * y p ^ 2 + c * u p + d * v p) *
      (a' * x p ^ 2 + b' * y p ^ 2 + c' * u p + d' * v p) =
      c * d' * (u p * v p) + d * c' * (u p * v p) := by
    linear_combination (a * a' * x p) * x_pow_three_eq_zero p +
      (a * b' * x p * y p + b * a' * x p * y p) * x_mul_y_eq_zero p +
      (b * b' * y p) * y_pow_three_eq_zero p +
      (a * c' * x p + c * a' * x p) * x_mul_u_eq_zero p +
      (a * d' * x p + d * a' * x p) * x_mul_v_eq_zero p +
      (b * c' * y p + c * b' * y p) * y_mul_u_eq_zero p +
      (b * d' * y p + d * b' * y p) * y_mul_v_eq_zero p +
      (c * c') * u_sq_eq_zero p + (d * d') * v_sq_eq_zero p
  rw [theta_of_decomposition, iota_of_decomposition, theta_of_decomposition,
    iota_of_decomposition, hprod, mul_uv p (c * d'), mul_uv p (d * c')]
  simp only [map_add, map_mul]
  ring

/-! ### The divided power structure at `p = 2` -/

private lemma span_sq_mul_K_le : Ideal.span {x p ^ 2, y p ^ 2} * K p ≤ ⊥ := by
  refine span_mul_span_le_bot p fun a ha b hb => ?_
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl
  · linear_combination (x p) * x_pow_three_eq_zero p
  · linear_combination (x p * y p) * x_mul_y_eq_zero p
  · linear_combination (x p) * x_mul_u_eq_zero p
  · linear_combination (x p) * x_mul_v_eq_zero p
  · linear_combination (x p * y p) * x_mul_y_eq_zero p
  · linear_combination (y p) * y_pow_three_eq_zero p
  · linear_combination (y p) * y_mul_u_eq_zero p
  · linear_combination (y p) * y_mul_v_eq_zero p

/-- At `p = 2` the square of every element of `K` vanishes. -/
private lemma sq_eq_zero_of_mem [Fact p.Prime] (hp2 : p = 2) {k : Witness p} (hk : k ∈ K p) :
    k ^ 2 = 0 := by
  subst hp2
  have : ExpChar (Witness 2) 2 := .prime (by norm_num)
  have hle : K 2 ≤ RingHom.ker (frobenius (Witness 2) 2) := by
    rw [K, Ideal.span_le]
    rintro w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    simp only [SetLike.mem_coe, RingHom.mem_ker, frobenius_def]
    rcases hw with rfl | rfl | rfl | rfl
    · linear_combination (x 2) * x_pow_three_eq_zero 2
    · linear_combination (y 2) * y_pow_three_eq_zero 2
    · linear_combination u_sq_eq_zero 2
    · linear_combination v_sq_eq_zero 2
  have h := hle hk
  rwa [RingHom.mem_ker, frobenius_def] at h

/-- At `p = 2` the square of an element of the augmentation ideal annihilates `K`. -/
private lemma aug_sq_mul_eq_zero [Fact p.Prime] (hp2 : p = 2) {m : Witness p}
    (hm : m ∈ aug p) {k : Witness p} (hk : k ∈ K p) : m ^ 2 * k = 0 := by
  subst hp2
  have : ExpChar (Witness 2) 2 := .prime (by norm_num)
  have hle : aug 2 ≤ Ideal.comap (frobenius (Witness 2) 2)
      (Ideal.span {x 2 ^ 2, y 2 ^ 2}) := by
    rw [aug, Ideal.span_le]
    rintro w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    simp only [SetLike.mem_coe, Ideal.mem_comap, frobenius_def]
    rcases hw with rfl | rfl | rfl | rfl
    · exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    · exact (u_sq_eq_zero 2) ▸ Submodule.zero_mem _
    · exact (v_sq_eq_zero 2) ▸ Submodule.zero_mem _
  have hmem : m ^ 2 ∈ Ideal.span {x 2 ^ 2, y 2 ^ 2} := by
    have hcm := hle hm
    rwa [Ideal.mem_comap, frobenius_def] at hcm
  exact (Submodule.mem_bot _).mp (span_sq_mul_K_le 2 (Ideal.mul_mem_mul hmem hk))

/-- At `p = 2` the `p`-th power of a ring element acts on `K` through its constant
coefficient. -/
private lemma pow_two_mul_mem [Fact p.Prime] (hp2 : p = 2) (a : Witness p) {k : Witness p}
    (hk : k ∈ K p) :
    a ^ 2 * k = algebraMap (ZMod p) (Witness p) (eps p a ^ 2) * k := by
  subst hp2
  have htwo : (2 : Witness 2) = 0 := natCast_eq_zero 2
  have hchar : a ^ 2 = algebraMap (ZMod 2) (Witness 2) (eps 2 a) ^ 2 +
      (a - algebraMap (ZMod 2) (Witness 2) (eps 2 a)) ^ 2 := by
    linear_combination (algebraMap (ZMod 2) (Witness 2) (eps 2 a) *
      (a - algebraMap (ZMod 2) (Witness 2) (eps 2 a))) * htwo
  rw [hchar, add_mul, aug_sq_mul_eq_zero 2 rfl (sub_eps_mem_aug 2 a) hk, add_zero, ← map_pow]

/-- The corrected `p`-th operation at `p = 2`, sending `k` to
`ξ(k)·u + η(k)·v + θ(k)·ι(k)·uv`. -/
public noncomputable def dpowCandidateTwo : K p → K p := fun k =>
  ⟨algebraMap (ZMod p) (Witness p) (xi p k) * u p
      + algebraMap (ZMod p) (Witness p) (eta p k) * v p
      + algebraMap (ZMod p) (Witness p) (theta p k * iota p k) * (u p * v p),
    Ideal.add_mem _
      (Ideal.add_mem _ (Ideal.mul_mem_left _ _ (u_mem p)) (Ideal.mul_mem_left _ _ (v_mem p)))
      (Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (u_mem p)))⟩

private lemma coe_dpowCandidateTwo (k : K p) : (dpowCandidateTwo p k : Witness p)
    = algebraMap (ZMod p) (Witness p) (xi p k) * u p
      + algebraMap (ZMod p) (Witness p) (eta p k) * v p
      + algebraMap (ZMod p) (Witness p) (theta p k * iota p k) * (u p * v p) := rfl

/-- The factorial identity for the corrected operation at `p = 2`. -/
public lemma dpowCandidateTwo_factorial [hp : Fact p.Prime] (hp2 : p = 2) (k : K p) :
    (p.factorial : Witness p) * (dpowCandidateTwo p k : Witness p) = (k : Witness p) ^ p := by
  rw [factorial_cast_eq_zero, zero_mul, congrArg (fun n => (k : Witness p) ^ n) hp2,
    sq_eq_zero_of_mem p hp2 k.2]

/-- Homogeneity of the corrected operation at `p = 2`. -/
public lemma dpowCandidateTwo_smul [Fact p.Prime] (hp2 : p = 2) (a : Witness p) (k : K p) :
    dpowCandidateTwo p (a • k) = a ^ p • dpowCandidateTwo p k := by
  apply Subtype.ext
  have hθ : theta p (a * (k : Witness p)) = eps p a * theta p k :=
    coeffFun_mul_of_mem p _ good_u (by simp) k.2 a
  have hι : iota p (a * (k : Witness p)) = eps p a * iota p k :=
    coeffFun_mul_of_mem p _ good_v (by simp) k.2 a
  have hsq : eps p a ^ 2 = eps p a := by rw [← hp2]; exact ZMod.pow_card _
  have hpow : a ^ p * (dpowCandidateTwo p k : Witness p)
      = algebraMap (ZMod p) (Witness p) (eps p a ^ 2) * (dpowCandidateTwo p k : Witness p) := by
    rw [congrArg (fun n => a ^ n) hp2]
    exact pow_two_mul_mem p hp2 a (dpowCandidateTwo p k).2
  have hthird : eps p a * theta p (k : Witness p) * (eps p a * iota p (k : Witness p))
      = eps p a * (theta p (k : Witness p) * iota p (k : Witness p)) := by
    linear_combination (theta p (k : Witness p) * iota p (k : Witness p)) * hsq
  rw [Submodule.coe_smul, smul_eq_mul, hpow, coe_dpowCandidateTwo, coe_dpowCandidateTwo,
    show ((a • k : K p) : Witness p) = a * (k : Witness p) from rfl,
    xi_mul_of_mem p k.2, eta_mul_of_mem p k.2, hθ, hι, hthird, hsq]
  simp only [map_mul]
  ring

private lemma factorialInverse_one {A : Type*} [CommRing A] (q : ℕ) (hq : q.Prime)
    (hA : ∀ n : ℕ, ¬q ∣ n → IsUnit (n : A)) :
    _root_.DividedPowers.factorialInverse q hq hA 1 = 1 := by
  have key : ∀ h : ¬ q ∣ Nat.factorial 1,
      (((hA (Nat.factorial 1) h).unit⁻¹ : Aˣ) : A) = 1 := by
    intro h
    have h1 : (((hA (Nat.factorial 1) h).unit : Aˣ) : A) = 1 := by
      rw [IsUnit.unit_spec, Nat.factorial_one, Nat.cast_one]
    rw [show (hA (Nat.factorial 1) h).unit = (1 : Aˣ) from Units.ext h1, inv_one,
      Units.val_one]
  rw [_root_.DividedPowers.factorialInverse, dif_pos hq.one_lt]
  exact key (by simpa using hq.ne_one)

/-- The addition law for the corrected operation at `p = 2`. -/
public lemma dpowCandidateTwo_add [hp : Fact p.Prime] (hp2 : p = 2) (k k' : K p) :
    (dpowCandidateTwo p (k + k') : Witness p) = (dpowCandidateTwo p k : Witness p) +
      ∑ ij ∈ (Finset.antidiagonal p).filter (fun ij ↦ ij.1 ≠ 0 ∧ ij.2 ≠ 0),
        _root_.DividedPowers.factorialInverse p hp.out (isUnit_natCast p) ij.1 *
          _root_.DividedPowers.factorialInverse p hp.out (isUnit_natCast p) ij.2 *
          (k : Witness p) ^ ij.1 * (k' : Witness p) ^ ij.2 +
      (dpowCandidateTwo p k' : Witness p) := by
  have hfilter : (Finset.antidiagonal p).filter (fun ij : ℕ × ℕ ↦ ij.1 ≠ 0 ∧ ij.2 ≠ 0)
      = {(1, 1)} := by subst hp2; decide
  have hone : _root_.DividedPowers.factorialInverse p hp.out (isUnit_natCast p) 1
      = (1 : Witness p) := factorialInverse_one p hp.out (isUnit_natCast p)
  have hcross := mul_eq_of_mem p k.2 k'.2
  rw [hfilter, Finset.sum_singleton, hone, coe_dpowCandidateTwo, coe_dpowCandidateTwo,
    coe_dpowCandidateTwo, Submodule.coe_add,
    show (1 : Witness p) * 1 * (k : Witness p) ^ 1 * (k' : Witness p) ^ 1
      = (k : Witness p) * (k' : Witness p) from by ring, hcross, xi, eta, theta, iota,
    coeffFun_add, coeffFun_add, coeffFun_add, coeffFun_add]
  simp only [map_add, map_mul]
  ring

/-- The divided power structure on `K` at `p = 2`, whose second operation is the corrected
`DividedPowers.TorsionWitness.dpowCandidateTwo`. -/
public noncomputable def dividedPowersOfTwo [hp : Fact p.Prime] (hp2 : p = 2) :
    _root_.DividedPowers (K p) :=
  (_root_.DividedPowers.existsUnique_of_prime_operation (K p) p hp.out (isUnit_natCast p)
    (dpowCandidateTwo p) (dpowCandidateTwo_factorial p hp2) (dpowCandidateTwo_smul p hp2)
    (dpowCandidateTwo_add p hp2)).choose

/-- The `p`-th operation of `DividedPowers.TorsionWitness.dividedPowersOfTwo` is
`DividedPowers.TorsionWitness.dpowCandidateTwo`. -/
public lemma dividedPowersOfTwo_dpow [hp : Fact p.Prime] (hp2 : p = 2) (k : K p) :
    (dividedPowersOfTwo p hp2).dpow p k = dpowCandidateTwo p k :=
  (_root_.DividedPowers.existsUnique_of_prime_operation (K p) p hp.out (isUnit_natCast p)
    (dpowCandidateTwo p) (dpowCandidateTwo_factorial p hp2) (dpowCandidateTwo_smul p hp2)
    (dpowCandidateTwo_add p hp2)).choose_spec.1 k

/-- At `p = 2` the `p`-th divided power of `x²` is `u`. -/
public lemma dividedPowersOfTwo_dpow_x_sq [Fact p.Prime] (hp2 : p = 2) :
    (dividedPowersOfTwo p hp2).dpow p (x p ^ 2) = u p := by
  have h := dividedPowersOfTwo_dpow p hp2 ⟨x p ^ 2, x_sq_mem p⟩
  rw [coe_dpowCandidateTwo] at h
  simpa [xi, eta, theta, iota, x_sq_eq, coeffFun_mk, coeff_monomial,
    Finsupp.single_eq_single_iff] using h

/-- At `p = 2` the `p`-th divided power of `y²` is `v`. -/
public lemma dividedPowersOfTwo_dpow_y_sq [Fact p.Prime] (hp2 : p = 2) :
    (dividedPowersOfTwo p hp2).dpow p (y p ^ 2) = v p := by
  have h := dividedPowersOfTwo_dpow p hp2 ⟨y p ^ 2, y_sq_mem p⟩
  rw [coe_dpowCandidateTwo] at h
  simpa [xi, eta, theta, iota, y_sq_eq, coeffFun_mk, coeff_monomial,
    Finsupp.single_eq_single_iff] using h

/-! ### The divided power structure, for every prime -/

/-- **The divided power structure on `K`**, for every prime `p`: for odd `p` the operation
`ξ(k)·u + η(k)·v` of `DividedPowers.TorsionWitness.dividedPowersOfNeTwo`, and at `p = 2` its
correction `DividedPowers.TorsionWitness.dividedPowersOfTwo`. -/
public noncomputable def dividedPowers [Fact p.Prime] : _root_.DividedPowers (K p) :=
  if h : p = 2 then dividedPowersOfTwo p h else dividedPowersOfNeTwo p h

/-- The `p`-th divided power of `x²` is `u`. -/
public lemma dividedPowers_dpow_x_sq [Fact p.Prime] :
    (dividedPowers p).dpow p (x p ^ 2) = u p := by
  rw [dividedPowers]
  split_ifs with h
  · exact dividedPowersOfTwo_dpow_x_sq p h
  · exact dividedPowersOfNeTwo_dpow_x_sq p h

/-- The `p`-th divided power of `y²` is `v`. -/
public lemma dividedPowers_dpow_y_sq [Fact p.Prime] :
    (dividedPowers p).dpow p (y p ^ 2) = v p := by
  rw [dividedPowers]
  split_ifs with h
  · exact dividedPowersOfTwo_dpow_y_sq p h
  · exact dividedPowersOfNeTwo_dpow_y_sq p h

/-! ### Comparison with the `p`-adic integers -/

/-- The ring map `ℤ_[p] → B` obtained by reducing mod `p` and then mapping into the witness
ring. -/
public noncomputable def toWitness [Fact p.Prime] : ℤ_[p] →+* Witness p :=
  (algebraMap (ZMod p) (Witness p)).comp PadicInt.toZMod

private lemma toWitness_natCast [Fact p.Prime] : toWitness p (p : ℤ_[p]) = 0 := by
  rw [map_natCast, natCast_eq_zero]

private lemma toWitness_eq_zero_of_mem [Fact p.Prime] {a : ℤ_[p]}
    (ha : a ∈ Ideal.span {(p : ℤ_[p])}) : toWitness p a = 0 := by
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
  rw [map_mul, toWitness_natCast, zero_mul]

/-- The map `ℤ_[p] → B` is a divided power morphism from the canonical divided powers on the
ideal `(p)` of `ℤ_[p]` to the divided powers on `K`. -/
public lemma isDPMorphism_toWitness [Fact p.Prime] :
    _root_.DividedPowers.IsDPMorphism (PadicInt.dividedPowers p) (dividedPowers p)
      (toWitness p) where
  ideal_comp := by
    rw [Ideal.map_span, Set.image_singleton, toWitness_natCast,
      Ideal.span_singleton_eq_bot.mpr rfl]
    exact bot_le
  dpow_comp := by
    intro n a ha
    rw [toWitness_eq_zero_of_mem p ha]
    rcases eq_or_ne n 0 with rfl | hn
    · rw [(dividedPowers p).dpow_zero (Submodule.zero_mem _),
        (PadicInt.dividedPowers p).dpow_zero ha, map_one]
    · rw [(dividedPowers p).dpow_eval_zero hn,
        toWitness_eq_zero_of_mem p ((PadicInt.dividedPowers p).dpow_mem hn ha)]

/-- The ring map `ℤ_[p][T₀, T₁] → B` extending `toWitness` and sending `T₀ ↦ x`,
`T₁ ↦ y`. -/
public noncomputable def mvPolynomialHom [Fact p.Prime] :
    MvPolynomial (Fin 2) ℤ_[p] →+* Witness p :=
  MvPolynomial.eval₂Hom (toWitness p) ![x p, y p]

/-- The map `mvPolynomialHom` restricts to `toWitness` on constants. -/
public lemma mvPolynomialHom_C [Fact p.Prime] (a : ℤ_[p]) :
    mvPolynomialHom p (MvPolynomial.C a) = toWitness p a := by
  rw [mvPolynomialHom, MvPolynomial.eval₂Hom_C]

/-- The map `mvPolynomialHom` sends the first variable to `x`. -/
public lemma mvPolynomialHom_X_zero [Fact p.Prime] :
    mvPolynomialHom p (MvPolynomial.X 0) = x p := by
  rw [mvPolynomialHom, MvPolynomial.eval₂Hom_X']
  simp

/-- The map `mvPolynomialHom` sends the second variable to `y`. -/
public lemma mvPolynomialHom_X_one [Fact p.Prime] :
    mvPolynomialHom p (MvPolynomial.X 1) = y p := by
  rw [mvPolynomialHom, MvPolynomial.eval₂Hom_X']
  simp

/-- The composite of `mvPolynomialHom` with the inclusion of constants is `toWitness`. -/
public lemma mvPolynomialHom_comp_C [Fact p.Prime] :
    (mvPolynomialHom p).comp MvPolynomial.C = toWitness p :=
  RingHom.ext fun a => mvPolynomialHom_C p a

end DividedPowers.TorsionWitness

end
