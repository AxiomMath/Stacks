/-!
# Local-algebra reduction behind Rodicio's theorem

Let `(A, 𝔪)` be a Noetherian local ring and `I ⊆ J ⊆ A` proper ideals. Rodicio's theorem
(Stacks Tag 09PV) deduces injectivity of `I/𝔪I → J/𝔪J` from finiteness of the Tor dimension
of `A/J` over `A/I`, by contradiction: a nonzero class of `I/𝔪I` dying in `J/𝔪J` is converted
into the configuration that Gulliksen's obstruction (Stacks Tag 09PU) rules out.

This module collects the commutative-algebra half of that conversion, which involves neither
divided powers nor Tor. Given an element `x ∈ I` whose class in `I/𝔪I` is nonzero, the central
construction `exists_ideal_of_notMem_maximalIdeal_smul_top` produces an intermediate ideal
`𝔪I ⊆ I' ⊆ I` with `x ∉ I'` such that `I/I'` is generated by the image of `x`. This is a
linear-algebra statement in disguise: `I/𝔪I` is a vector space over the residue field `A/𝔪`,
so the line spanned by the class of `x` has a complement, and `I'` is the preimage of that
complement. Writing `R = A/I` and `R' = A/I'`, the quotient map `R' → R` is then a surjection
of local rings whose kernel is principal, generated by the class of `x`, and has square zero —
the three lemmas `ker_factor_eq_span_singleton_of_cyclic`, `ker_factor_sq_eq_bot` and
`map_ne_top_of_surjective` record this and its consequences.

The remaining lemmas handle the passage from the relation `x = ∑ rⱼ aⱼ` on a finite generating
family of `J` to a relation between *constant* polynomials in zero variables: `A/J` is presented
as `MvPolynomial (Fin 0) R` modulo the constants coming from the generators of `J`, which is the
shape Tag 09PU demands. `mvPolynomialFinZeroQuotientAlgEquiv` identifies that presentation with
the plain ring quotient and `span_range_mk_eq_ker_factor` identifies the ideal being divided out.

## Main results

* `exists_ideal_of_notMem_maximalIdeal_smul_top` — the intermediate ideal `I'`.
* `ker_factor_eq_span_singleton_of_cyclic`, `ker_factor_sq_eq_bot` — the kernel of `R' → R`
  is principal with square zero.
* `injective_mapQ_of_mem_maximalIdeal_smul_top` — injectivity of `I/𝔪I → J/𝔪J` reduced to the
  elementwise statement that a class of `I` landing in `𝔪J` already lies in `𝔪I`.
* `mvPolynomialFinZeroQuotientAlgEquiv`, `span_range_mk_eq_ker_factor` — the zero-variable
  polynomial presentation of `A/J` over `A/I`.

## References

* [Stacks Project, Tag 09PV](https://stacks.math.columbia.edu/tag/09PV)
-/

@[expose] public noncomputable section

namespace StacksDraft.Rodicio

universe u

/-- Injectivity of the canonical map `I/𝔪I → J/𝔪J` follows from the elementwise statement
that an element of `I` whose image lies in `𝔪J` already lies in `𝔪I`; that is, from the
intersection identity `I ∩ 𝔪J = 𝔪I` written on the underlying ideal modules. -/
public theorem injective_mapQ_of_mem_maximalIdeal_smul_top
    {A : Type u} [CommRing A] [IsLocalRing A]
    (I J : Ideal A) (hIJ : I ≤ J)
    (h : ∀ x : I, (Submodule.inclusion hIJ x : J) ∈
      IsLocalRing.maximalIdeal A • (⊤ : Submodule A J) →
      x ∈ IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)) :
    Function.Injective
      ((IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).mapQ
        (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J))
        (Submodule.inclusion hIJ)
        (Submodule.smul_top_le_comap_smul_top _ (Submodule.inclusion hIJ))) := by
  refine LinearMap.ker_eq_bot.mp (le_antisymm ?_ bot_le)
  rw [Submodule.ker_mapQ]
  rintro x ⟨y, hy, rfl⟩
  change (Submodule.Quotient.mk y :
    I ⧸ (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I))) = 0
  exact (Submodule.Quotient.mk_eq_zero _).2 (h y hy)

/-- A product of two elements of a proper ideal `I` of a local ring lies in `𝔪I`, since one
factor already lies in the maximal ideal. This is what makes the kernel constructed below
square-zero. -/
public theorem mul_mem_maximalIdeal_smul_top
    {A : Type u} [CommRing A] [IsLocalRing A]
    (I : Ideal A) (hI : I ≠ ⊤) (x y : I) :
    (⟨(x : A) * (y : A), I.mul_mem_left (x : A) y.property⟩ : I) ∈
      IsLocalRing.maximalIdeal A • (⊤ : Submodule A I) := by
  rw [Submodule.mem_smul_top_iff, Ideal.smul_eq_mul]
  exact Ideal.mul_mem_mul (IsLocalRing.le_maximalIdeal hI x.property) y.property

/-- **The intermediate ideal of Rodicio's argument.** If `x ∈ I` has nonzero class in `I/𝔪I`,
there is an ideal `I'` with `𝔪I ⊆ I' ⊆ I` avoiding `x` and such that `I/I'` is generated by the
image of `x`. The class of `x` spans a line in the `A/𝔪`-vector space `I/𝔪I`; take for `I'` the
preimage of a complement of that line. -/
public theorem exists_ideal_of_notMem_maximalIdeal_smul_top
    {A : Type u} [CommRing A] [IsLocalRing A]
    (I : Ideal A) (x : I)
    (hx : x ∉ IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)) :
    ∃ I' : Ideal A,
      (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).map I.subtype ≤ I' ∧
      I' ≤ I ∧ (x : A) ∉ I' ∧
      ∀ y : I, ∃ a : A, (y : A) - a * (x : A) ∈ I' := by
  let m := IsLocalRing.maximalIdeal A
  let V := I ⧸ m • (⊤ : Submodule A I)
  let _ : Field (A ⧸ m) := Ideal.Quotient.field m
  let v : V := Submodule.Quotient.mk x
  have hv : v ≠ 0 := fun he => hx ((Submodule.Quotient.mk_eq_zero _).mp he)
  let P : Submodule (A ⧸ m) V := Submodule.span (A ⧸ m) {v}
  obtain ⟨Q, hPQ⟩ := P.exists_isCompl
  let K : Submodule A I := Q.restrictScalars A |>.comap
    (Submodule.mkQ (m • (⊤ : Submodule A I)))
  refine ⟨K.map I.subtype, ?_, ?_, ?_, ?_⟩
  · rintro _ ⟨z, hz, rfl⟩
    refine ⟨z, ?_, rfl⟩
    change (Submodule.Quotient.mk z : V) ∈ Q
    rw [(Submodule.Quotient.mk_eq_zero (m • (⊤ : Submodule A I))).2 hz]
    exact Q.zero_mem
  · rintro _ ⟨y, _, rfl⟩
    exact y.property
  · rintro ⟨y, hy, hxy⟩
    obtain rfl : y = x := Subtype.ext hxy
    exact hv (Submodule.disjoint_def.mp hPQ.disjoint v (Submodule.mem_span_singleton_self v) hy)
  · intro y
    have hyTop : (Submodule.Quotient.mk y : V) ∈ P ⊔ Q := by
      rw [hPQ.codisjoint.eq_top]
      exact Submodule.mem_top
    obtain ⟨p, hp, q, hq, hpq⟩ := Submodule.mem_sup.mp hyTop
    obtain ⟨c, hc⟩ : ∃ c : A ⧸ m, c • v = p := by
      simpa only [P, Submodule.mem_span_singleton] using hp
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
    refine ⟨a, ⟨y - a • x, ?_, ?_⟩⟩
    · change (Submodule.Quotient.mk (y - a • x) : V) ∈ Q
      have hqeq : (Submodule.Quotient.mk (y - a • x) : V) = q := by
        change (m • (⊤ : Submodule A I)).mkQ (y - a • x) = q
        rw [map_sub, map_smul]
        change (Submodule.Quotient.mk y : V) -
          (Ideal.Quotient.mk m a) • v = q
        rw [hc]
        exact sub_eq_iff_eq_add.mpr (by simpa [add_comm] using hpq.symm)
      exact hqeq ▸ hq
    · simp

/-- Any ideal containing the image of `𝔪I` in `A` contains `I²`, by
`mul_mem_maximalIdeal_smul_top`. -/
public theorem mul_mem_of_map_maximalIdeal_smul_top_le
    {A : Type u} [CommRing A] [IsLocalRing A]
    (I I' : Ideal A) (hI : I ≠ ⊤)
    (hII' : (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).map
      I.subtype ≤ I')
    {a b : A} (ha : a ∈ I) (hb : b ∈ I) : a * b ∈ I' :=
  hII' ⟨_, mul_mem_maximalIdeal_smul_top I hI ⟨a, ha⟩ ⟨b, hb⟩, rfl⟩

/-- An element of `𝔪J` admits a relation on some finite generating family of `J` all of whose
coefficients lie in the maximal ideal. The family exists because `J` is finitely generated, and
the coefficients are produced by `Submodule.mem_ideal_smul_span_iff_exists_sum`. -/
public theorem exists_fin_generators_and_relation
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (J : Ideal A) (x : A) (hx : x ∈ IsLocalRing.maximalIdeal A • J) :
    ∃ (n : ℕ) (F r : Fin n → A),
      J = Submodule.span A (Set.range F) ∧
      (∀ j, r j ∈ IsLocalRing.maximalIdeal A) ∧
      x = ∑ j, r j * F j := by
  obtain ⟨n, F, hF⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian J)
  have hx' : x ∈ IsLocalRing.maximalIdeal A •
      Submodule.span A (Set.range F) := by rwa [hF]
  obtain ⟨r, hr, hrel⟩ :=
    (Submodule.mem_ideal_smul_span_iff_exists_sum
      (IsLocalRing.maximalIdeal A) F x).mp hx'
  refine ⟨n, F, r, hF.symm, hr, ?_⟩
  rw [Finsupp.sum_fintype _ _ (fun i => zero_smul A (F i))] at hrel
  simpa only [smul_eq_mul] using hrel.symm

/-- If `I/I'` is generated by the image of `x`, the kernel of `A/I' → A/I` is the principal
ideal generated by the class of `x`. -/
public theorem ker_factor_eq_span_singleton_of_cyclic
    {A : Type u} [CommRing A] (I I' : Ideal A) (hI'I : I' ≤ I)
    (x : I)
    (hcyc : ∀ y : I, ∃ a : A, (y : A) - a * (x : A) ∈ I') :
    RingHom.ker (Ideal.Quotient.factor hI'I) =
      Ideal.span {Ideal.Quotient.mk I' (x : A)} := by
  rw [Ideal.Quotient.factor_ker]
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    obtain ⟨c, hc⟩ := hcyc ⟨a, ha⟩
    rw [Ideal.mem_comap, Ideal.Quotient.eq.mpr hc, map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))
  · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.mem_map_of_mem _ x.property))

/-- The kernel of `A/I' → A/I` has square zero, because it is cut out by `I` and `I² ⊆ I'`. -/
public theorem ker_factor_sq_eq_bot
    {A : Type u} [CommRing A] [IsLocalRing A]
    (I I' : Ideal A) (hI : I ≠ ⊤) (hI'I : I' ≤ I)
    (hmI' : (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).map
      I.subtype ≤ I') :
    (RingHom.ker (Ideal.Quotient.factor hI'I)) ^ 2 = ⊥ := by
  rw [Ideal.Quotient.factor_ker, pow_two, ← Ideal.map_mul, eq_bot_iff,
    Ideal.map_le_iff_le_comap, Ideal.mul_le]
  intro a ha b hb
  rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
  exact mul_mem_of_map_maximalIdeal_smul_top_le I I' hI hmI' ha hb

/-- Every element of the maximal ideal annihilates the kernel generator modulo `I'`, so its
class in `A/I` lies in the image of that annihilator. This is the hypothesis of Tag 09PU that
the coefficients of the relation lie in the annihilator of `f`. -/
public theorem mk_mem_map_annihilator_of_mem_maximalIdeal
    {A : Type u} [CommRing A] [IsLocalRing A]
    (I I' : Ideal A) (hI'I : I' ≤ I)
    (hmI' : (IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).map
      I.subtype ≤ I') (x : I) (r : A)
    (hr : r ∈ IsLocalRing.maximalIdeal A) :
    Ideal.Quotient.mk I r ∈
      Ideal.map (Ideal.Quotient.factor hI'I)
        (Ideal.span {Ideal.Quotient.mk I' (x : A)}).annihilator := by
  have hrann : Ideal.Quotient.mk I' r ∈
      (Ideal.span {Ideal.Quotient.mk I' (x : A)}).annihilator := by
    rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul, ← map_mul,
      Ideal.Quotient.eq_zero_iff_mem]
    exact hmI' ⟨r • x, Submodule.smul_mem_smul hr Submodule.mem_top, rfl⟩
  simpa only [Ideal.Quotient.factor_mk] using
    (Ideal.mem_map_of_mem (Ideal.Quotient.factor hI'I) hrann)

/-- A surjection of local rings carries proper ideals to proper ideals, since it carries the
maximal ideal onto the maximal ideal. -/
public theorem map_ne_top_of_surjective
    {R S : Type u} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S]
    (g : R →+* S) (hg : Function.Surjective g)
    (L : Ideal R) (hL : L ≠ ⊤) : Ideal.map g L ≠ ⊤ := by
  apply ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal S).ne_top
  calc
    Ideal.map g L ≤ Ideal.map g (IsLocalRing.maximalIdeal R) :=
      Ideal.map_mono (IsLocalRing.le_maximalIdeal hL)
    _ = IsLocalRing.maximalIdeal S := IsLocalRing.map_maximalIdeal_of_surjective g hg

/-- A finite relation `x = ∑ rⱼ Fⱼ` with `x ∈ I` becomes the trivial relation between constant
polynomials over `A/I`. -/
public theorem sum_C_mul_C_eq_zero
    {A : Type u} [CommRing A] (I : Ideal A) (d : ℕ)
    (F r : Fin d → A) (x : A) (hx : x ∈ I)
    (hrel : x = ∑ j, r j * F j) :
    (∑ j, MvPolynomial.C (Ideal.Quotient.mk I (r j)) *
      MvPolynomial.C (Ideal.Quotient.mk I (F j)) :
      MvPolynomial (Fin 0) (A ⧸ I)) = 0 := by
  simp_rw [← map_mul, ← map_sum]
  rw [← hrel, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
  simp

/-- Over `A/I'` the same relation computes the constant polynomial represented by `x`, which is
the kernel generator. This is the lifted relation `∑ r'ⱼ F'ⱼ = g f` of Tag 09PU, with `g = 1`. -/
public theorem sum_C_mul_C_eq_C
    {A : Type u} [CommRing A] (I' : Ideal A) (d : ℕ)
    (F r : Fin d → A) (x : A)
    (hrel : x = ∑ j, r j * F j) :
    (∑ j, MvPolynomial.C (Ideal.Quotient.mk I' (r j)) *
      MvPolynomial.C (Ideal.Quotient.mk I' (F j)) :
      MvPolynomial (Fin 0) (A ⧸ I')) =
      MvPolynomial.C (Ideal.Quotient.mk I' x) := by
  simp_rw [← map_mul, ← map_sum]
  rw [← hrel]

/-- Dividing the zero-variable polynomial ring by an ideal generated by constants is the same as
dividing the coefficient ring by the corresponding elements. -/
public def mvPolynomialFinZeroQuotientAlgEquiv
    {R : Type u} [CommRing R] (d : ℕ) (F : Fin d → R) :
    (MvPolynomial (Fin 0) R ⧸
      Ideal.span (Set.range (fun j : Fin d => MvPolynomial.C (F j)))) ≃ₐ[R]
      (R ⧸ Ideal.span (Set.range F)) := by
  let e := MvPolynomial.isEmptyAlgEquiv R (Fin 0)
  have heC (a : R) : e (MvPolynomial.C a) = a := by
    simp [e]
  have hmap : Ideal.span (Set.range F) =
      Ideal.map (e : MvPolynomial (Fin 0) R →+* R)
        (Ideal.span (Set.range (fun j : Fin d => MvPolynomial.C (F j)))) := by
    rw [Ideal.map_span]
    congr 1
    ext z
    simp [heC]
  exact Ideal.quotientEquivAlg _ _ e hmap

/-- The classes in `A/I` of a generating family of `J` span the kernel of `A/I → A/J`. -/
public theorem span_range_mk_eq_ker_factor
    {A : Type u} [CommRing A] (I J : Ideal A) (hIJ : I ≤ J)
    (d : ℕ) (F : Fin d → A)
    (hF : J = Submodule.span A (Set.range F)) :
    Ideal.span (Set.range (fun j : Fin d => Ideal.Quotient.mk I (F j))) =
      RingHom.ker (Ideal.Quotient.factor hIJ) := by
  rw [Ideal.Quotient.factor_ker, hF, Ideal.map_span]
  congr 1
  ext z
  simp

end StacksDraft.Rodicio

