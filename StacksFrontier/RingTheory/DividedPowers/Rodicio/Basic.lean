module

public import Mathlib.Algebra.Category.ModuleCat.ProjectiveDimension
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import StacksFrontier.RingTheory.DividedPowers.Rodicio.LocalReduction
public import StacksFrontier.RingTheory.Tor.Balancing
public import StacksCore.Tactic.StacksAttribute

/-! # Rodicio's theorem

Let `(A, 𝔪)` be a Noetherian local ring and `I ⊆ J ⊆ A` proper ideals. If `A/J` has finite Tor
dimension over `A/I`, then the canonical map `I/𝔪I → J/𝔪J` is injective. This is Stacks Tag 09PV,
and the result is due to Rodicio.

The proof is by contradiction, and the whole of its commutative algebra is in
`StacksDraft.Rodicio` (see `Rodicio.LocalReduction`). Take `x ∈ I` whose class in `I/𝔪I` is
nonzero but which dies in `J/𝔪J`. Choose an intermediate ideal `𝔪I ⊆ I' ⊆ I` avoiding `x` with
`I/I'` generated by the image of `x`, and set `R = A/I`, `R' = A/I'`. The quotient map `R' → R` is
then a surjection of Noetherian local rings whose kernel is principal, generated by the class of
`x`, and has square zero. Writing `x = ∑ bⱼ aⱼ` on a finite generating family of `J` with all
`bⱼ ∈ 𝔪` gives a relation among constants whose lift is `1 · f`, and `1` is not nilpotent. That is
exactly the configuration Gulliksen's obstruction (Stacks Tag 09PU) forbids for an algebra of
finite Tor dimension, while `A/J` — identified with the zero-variable polynomial presentation
over `A/I` — has finite Tor dimension by hypothesis.

## The hypothesis `GulliksenObstruction`

Tag 09PU is stated here as a proposition, `GulliksenObstruction`, and taken as an explicit
hypothesis rather than cited. Its statement is reproduced verbatim from the Stacks formulation
and is the *only* thing this file assumes beyond Mathlib: supplying it closes 09PV outright, with
no further mathematics. It is kept as a hypothesis because its proof needs the Tate resolution of
Tag 09PN and the square-zero lift of Tag 09PS, which are separate and substantially harder
constructions; parameterising keeps Rodicio's own argument gated and complete in the
meantime.

## Main definitions

* `GulliksenObstruction` — the statement of Stacks Tag 09PU, as a proposition.

## Main results

* `injective_mapQ_maximalIdeal_of_gulliksenObstruction` — Rodicio's theorem, given 09PU.

## References

* [Stacks Project, Tag 09PV](https://stacks.math.columbia.edu/tag/09PV)
-/

@[expose] public noncomputable section

namespace StacksDraft.Rodicio

open CategoryTheory

universe u

/-- **The statement of Stacks Tag 09PU**, Gulliksen's obstruction, as a proposition: a relation
among the equations of a finite-type presentation whose coefficients annihilate the square-zero
generator, and which lifts to a non-nilpotent multiple of that generator, forces the presented
algebra to have infinite Tor dimension over the base. -/
public def GulliksenObstruction : Prop :=
  ∀ {R' : Type u} {R : Type u} [CommRing R'] [CommRing R]
    [IsNoetherianRing R'] [IsNoetherianRing R]
    (q : R' →+* R) (_ : Function.Surjective q)
    (f : R') (_ : RingHom.ker q = Ideal.span {f})
    (_ : (RingHom.ker q) ^ 2 = ⊥)
    (n m : ℕ)
    (F r : Fin m → MvPolynomial (Fin n) R)
    (_ : ∑ j, r j * F j = 0)
    (_ : ∀ (j : Fin m) (d : Fin n →₀ ℕ),
      (r j).coeff d ∈ Ideal.map q (Ideal.span {f}).annihilator)
    (F' r' : Fin m → MvPolynomial (Fin n) R')
    (g : MvPolynomial (Fin n) R')
    (_ : ∀ j, MvPolynomial.map q (F' j) = F j)
    (_ : ∀ j, MvPolynomial.map q (r' j) = r j)
    (_ : ∑ j, r' j * F' j = g * MvPolynomial.C f)
    (_ :
      let J : Ideal (MvPolynomial (Fin n) R) := Ideal.span (Set.range F)
      let S := MvPolynomial (Fin n) R ⧸ J
      let I : Ideal R := Ideal.map q (Ideal.span {f}).annihilator
      let IS : Ideal S := Ideal.map (algebraMap R S) I
      ¬ IsNilpotent
        (Ideal.Quotient.mk IS (Ideal.Quotient.mk J (MvPolynomial.map q g)))),
    (let J : Ideal (MvPolynomial (Fin n) R) := Ideal.span (Set.range F)
     let S := MvPolynomial (Fin n) R ⧸ J
     ¬ ∃ b : ℕ, ∀ (M : ModuleCat.{u} R) (i : ℕ), b < i →
      Limits.IsZero (((Tor (ModuleCat.{u} R) i).obj (ModuleCat.of R S)).obj M))

/-- Over local rings, a surjection carries the annihilator of a nonzero principal ideal to a
proper ideal. -/
private theorem map_annihilator_span_singleton_ne_top {R' R : Type u} [CommRing R'] [CommRing R]
    [IsLocalRing R'] [IsLocalRing R] (q : R' →+* R) (hq : Function.Surjective q) {f : R'}
    (hf : f ≠ 0) : Ideal.map q (Ideal.span {f}).annihilator ≠ ⊤ := by
  apply map_ne_top_of_surjective q hq
  intro heq
  have h1 : (1 : R') ∈ (Ideal.span {f}).annihilator := heq.symm ▸ Submodule.mem_top
  exact hf (by simpa using (Submodule.mem_annihilator_span_singleton f (1 : R')).mp h1)

/-- For `I ≤ J` and generators `F` of `J`, the quotient of the zero-variable polynomial ring over
`A ⧸ I` by the constants `F j` is `A ⧸ J`. -/
private def mvPolynomialFinZeroQuotientAlgEquivOfLE {A : Type u} [CommRing A] {I J : Ideal A}
    (hIJ : I ≤ J) {d : ℕ} (F : Fin d → A) (hF : J = Submodule.span A (Set.range F)) :
    letI : Algebra (A ⧸ I) (A ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
    (MvPolynomial (Fin 0) (A ⧸ I) ⧸
      Ideal.span (Set.range fun j => MvPolynomial.C (Ideal.Quotient.mk I (F j)))) ≃ₐ[A ⧸ I]
      A ⧸ J :=
  letI : Algebra (A ⧸ I) (A ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
  (mvPolynomialFinZeroQuotientAlgEquiv d fun j => Ideal.Quotient.mk I (F j)).trans <|
    (Ideal.quotientEquivAlgOfEq (A ⧸ I) (span_range_mk_eq_ker_factor I J hIJ d F hF)).trans <|
      Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId (A ⧸ I) (A ⧸ J))
        (Ideal.Quotient.factor_surjective hIJ)

/-- A bound beyond which `Tor_i(M', -)` vanishes is one for `Tor_i(M, -)` when `M ≃ M'`. -/
private theorem exists_isZero_tor_of_linearEquiv {R : Type u} [CommRing R] {M M' : Type u}
    [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M'] (e : M ≃ₗ[R] M')
    (h : ∃ b : ℕ, ∀ (N : ModuleCat.{u} R) (i : ℕ), b < i →
      Limits.IsZero (((Tor (ModuleCat.{u} R) i).obj (ModuleCat.of R M')).obj N)) :
    ∃ b : ℕ, ∀ (N : ModuleCat.{u} R) (i : ℕ), b < i →
      Limits.IsZero (((Tor (ModuleCat.{u} R) i).obj (ModuleCat.of R M)).obj N) :=
  h.imp fun _ hb N i hi =>
    (hb N i hi).of_iso (((Tor (ModuleCat.{u} R) i).mapIso e.toModuleIso).app N)

/-- If `S ≃ₐ[R] T` with `R → T` surjective and `R`, `T` local, then a proper ideal of `R`
generates a proper ideal of `S`, so `1` is not nilpotent modulo it. -/
private theorem not_isNilpotent_one_quotient_map_of_algEquiv {R S T : Type u} [CommRing R]
    [CommRing S] [CommRing T] [Algebra R S] [Algebra R T] [IsLocalRing R] [IsLocalRing T]
    (e : S ≃ₐ[R] T) (he : Function.Surjective (algebraMap R T)) {L : Ideal R} (hL : L ≠ ⊤) :
    ¬ IsNilpotent (Ideal.Quotient.mk (L.map (algebraMap R S)) 1) := by
  have : Nontrivial S := e.toEquiv.nontrivial
  have : IsLocalRing S := e.symm.toRingEquiv.isLocalRing
  have : Nontrivial (S ⧸ L.map (algebraMap R S)) := by
    refine Ideal.Quotient.nontrivial_iff.mpr (map_ne_top_of_surjective _ (fun s => ?_) L hL)
    obtain ⟨a, ha⟩ := he (e s)
    exact ⟨a, e.injective ((e.commutes a).trans ha)⟩
  exact not_isNilpotent_one

/-- **Rodicio's theorem, Stacks Tag 09PV.** For proper ideals `I ⊆ J` of a Noetherian local ring
`A` with `A/J` of finite Tor dimension over `A/I`, the canonical map `I/𝔪I → J/𝔪J` is injective.

Finite Tor dimension of the `A/I`-module `A/J` is spelled as in Stacks Tag 0652: a degree beyond
which `Tor_i^{A/I}(A/J, N)` vanishes for every `A/I`-module `N`.

The hypothesis `h09PU` is the statement of Tag 09PU; see the module docstring.

This statement is therefore **conditional**, and strictly weaker than Tag 09PV, which asserts
the conclusion outright. It deliberately carries **no** `@[stacks 09PV]` attribute: the tag
belongs on the unconditional statement, and placing it here would record Tag 09PV as
formalized while `GulliksenObstruction` is still open. Once that is discharged, the tag goes
on the specialization which drops `h09PU`, and the mathematics below is unchanged — the
hypothesis is used exactly once, on the final line. -/
public theorem injective_mapQ_maximalIdeal_of_gulliksenObstruction
    (h09PU : GulliksenObstruction.{u})
    {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (I J : Ideal A) (hI : I ≠ ⊤) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hTor : ∃ b : ℕ,
      letI : Algebra (A ⧸ I) (A ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
      ∀ (N : ModuleCat.{u} (A ⧸ I)) (i : ℕ), b < i →
        Limits.IsZero (((Tor (ModuleCat.{u} (A ⧸ I)) i).obj
          (ModuleCat.of (A ⧸ I) (A ⧸ J))).obj N)) :
    let f : I →ₗ[A] J := Submodule.inclusion hIJ
    Function.Injective
      ((IsLocalRing.maximalIdeal A • (⊤ : Submodule A I)).mapQ
        (IsLocalRing.maximalIdeal A • (⊤ : Submodule A J)) f
        (Submodule.smul_top_le_comap_smul_top _ f)) := by
  apply injective_mapQ_of_mem_maximalIdeal_smul_top I J hIJ
  intro x hx
  by_contra hnot
  obtain ⟨I', hmI', hI'I, hxI', hcyc⟩ := exists_ideal_of_notMem_maximalIdeal_smul_top I x hnot
  obtain ⟨d, F, r, hF, hr, hrel⟩ := exists_fin_generators_and_relation J (x : A)
    ((Submodule.mem_smul_top_iff _ J (Submodule.inclusion hIJ x)).mp hx)
  let q : (A ⧸ I') →+* (A ⧸ I) := Ideal.Quotient.factor hI'I
  let f : A ⧸ I' := Ideal.Quotient.mk I' (x : A)
  have hq : Function.Surjective q := Ideal.Quotient.factor_surjective hI'I
  have loc (K : Ideal A) (hK : K ≠ ⊤) : IsLocalRing (A ⧸ K) :=
    haveI := Ideal.Quotient.nontrivial_iff.mpr hK
    .of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have := loc I' (ne_top_of_le_ne_top hI hI'I)
  have := loc I hI
  have := loc J hJ
  have hAnn : Ideal.map q (Ideal.span {f}).annihilator ≠ ⊤ :=
    map_annihilator_span_singleton_ne_top q hq fun he => hxI' (Ideal.Quotient.eq_zero_iff_mem.mp he)
  let CC (K : Ideal A) (a : A) : MvPolynomial (Fin 0) (A ⧸ K) :=
    MvPolynomial.C (Ideal.Quotient.mk K a)
  let FF : Fin d → MvPolynomial (Fin 0) (A ⧸ I) := fun j => CC I (F j)
  let rr : Fin d → MvPolynomial (Fin 0) (A ⧸ I) := fun j => CC I (r j)
  let FF' : Fin d → MvPolynomial (Fin 0) (A ⧸ I') := fun j => CC I' (F j)
  let rr' : Fin d → MvPolynomial (Fin 0) (A ⧸ I') := fun j => CC I' (r j)
  have hlift0 : ∑ j, rr' j * FF' j = (1 : MvPolynomial (Fin 0) (A ⧸ I')) * MvPolynomial.C f := by
    simpa only [one_mul] using sum_C_mul_C_eq_C I' d F r (x : A) hrel
  have hcoeff (j : Fin d) (e : Fin 0 →₀ ℕ) :
      (rr j).coeff e ∈ Ideal.map q (Ideal.span {f}).annihilator := by
    obtain rfl : e = 0 := Subsingleton.elim e 0
    simpa [rr, CC, q, f, MvPolynomial.coeff_C] using
      mk_mem_map_annihilator_of_mem_maximalIdeal I I' hI'I hmI' x (r j) (hr j)
  let : Algebra (A ⧸ I) (A ⧸ J) := (Ideal.Quotient.factor hIJ).toAlgebra
  let K : Ideal (MvPolynomial (Fin 0) (A ⧸ I)) := Ideal.span (Set.range FF)
  let S := MvPolynomial (Fin 0) (A ⧸ I) ⧸ K
  let e : S ≃ₐ[A ⧸ I] (A ⧸ J) := mvPolynomialFinZeroQuotientAlgEquivOfLE hIJ F hF
  let L : Ideal S := Ideal.map (algebraMap (A ⧸ I) S) (Ideal.map q (Ideal.span {f}).annihilator)
  have : L.IsTwoSided := ⟨fun b ha ↦ mul_comm b _ ▸ L.smul_mem _ ha⟩
  have hnil : ¬ IsNilpotent (Ideal.Quotient.mk L
      (Ideal.Quotient.mk K (MvPolynomial.map q (1 : MvPolynomial (Fin 0) (A ⧸ I'))))) := by
    simpa using not_isNilpotent_one_quotient_map_of_algEquiv e
      (Ideal.Quotient.factor_surjective hIJ) hAnn
  exact h09PU q hq f (ker_factor_eq_span_singleton_of_cyclic I I' hI'I x hcyc)
    (ker_factor_sq_eq_bot I I' hI hI'I hmI') 0 d FF rr
    (sum_C_mul_C_eq_zero I d F r (x : A) x.property hrel) hcoeff FF' rr' 1
    (fun j => by simp [FF, FF', CC, q]) (fun j => by simp [rr, rr', CC, q]) hlift0 hnil
    (exists_isZero_tor_of_linearEquiv e.toLinearEquiv hTor)

end StacksDraft.Rodicio

end
