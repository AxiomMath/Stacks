module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.TowerPresentation.MixedStage

/-! # The divided power polynomial presentation of the colimit of the `ω`-tower

The successor step — adjoining one variable to a finite variable stage gives the odd or even
one-variable extension — the presentation theorem `gradedDividedPowerPolynomialOfMappingProperty`,
and its application to the lifted algebra, `liftPresentation`.
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w y z

section Presentation

attribute [local instance] GradedDPAlgebra.ring GradedDPAlgebra.algebra
  GradedDPAlgebra.graded GradedDPAlgebra.strict

variable {R : Type u} {P : Type v} {C : Type z}
  [CommRing R] [Ring P] [Algebra R P] [Ring C] [Algebra R C]
  {Cᵢ : ℕ → Submodule R C} [GradedAlgebra Cᵢ] [IsStrictlyGradedComm Cᵢ]
  (δ : DividedPowerStructure Cᵢ) (ι : P →ₐ[R] C) {Jdx : ℕ → Type z}
  (T : (Σ n : ℕ, Jdx n) → C)

/-- **Freeness of `C` on its coefficients and its variables.** A morphism out of the coefficient
algebra landing in degree zero, together with a homogeneous value of degree `n + 1` for each
variable of degree `n + 1`, extends to a divided power morphism out of `C`.

The target is a graded divided power algebra whose carrier lies in the *same* universe as `C`.
That is deliberately the weakest form that suffices: the freeness arguments test an element of
`C` against a one-variable extension of a subring of `C`, which lives in `C`'s universe, and it
is the form available for the colimit of the `ω`-tower, by
`DividedPowers.TateResolution.towerColimit_exists_gradedDPHom`. -/
public def HasVariableMappingProperty : Prop :=
  ∀ (E : GradedDPAlgebra.{u, z} R) (f : P →ₐ[R] E.carrier), (∀ p : P, f p ∈ E.grade 0) →
    ∀ t : (Σ n : ℕ, Jdx n) → E.carrier, (∀ j, t j ∈ E.grade (j.1 + 1)) →
      ∃ G : C →+* E.carrier, (∀ p : P, G (ι p) = f p) ∧ (∀ j, G (T j) = t j) ∧
        (∀ (m : ℕ) (x : C), x ∈ Cᵢ m → G x ∈ E.grade m) ∧
        (∀ (n : ℕ) (x : C), x ∈ positiveEvenPart Cᵢ → E.gamma.dpow n (G x) = G (δ.dpow n x))

/-- The coefficient map into a finite variable stage. -/
public def stageCoefficient (S : Finset (Σ n : ℕ, Jdx n)) :
    P →ₐ[R] finiteVariableStage δ ι T S where
  toFun p := ⟨ι p, mem_finiteVariableStage_coefficient δ ι T S p⟩
  map_one' := Subtype.ext (map_one ι)
  map_mul' p q := Subtype.ext (map_mul ι p q)
  map_zero' := Subtype.ext (map_zero ι)
  map_add' p q := Subtype.ext (map_add ι p q)
  commutes' r := Subtype.ext (ι.commutes r)

variable [IsHomogeneousVariableFamily Cᵢ ι T]
  (hdeg : ∀ j : (Σ n : ℕ, Jdx n), T j ∈ Cᵢ (j.1 + 1))

/-- The degree function of the variables of a divided power polynomial presentation: the
variables indexed by `Jdx n` have degree `n + 1`. -/
public abbrev varDeg : (Σ n : ℕ, Jdx n) → ℕ := fun j => j.1 + 1

include hdeg in
/-- A ring homomorphism out of the ambient algebra which restricts to a prescribed morphism of
graded divided power algebras on the coefficients and on the variables of a finite variable
stage restricts to it on the whole stage: the stage is generated by those elements together with
their divided powers, whose images are forced. -/
private theorem stage_restriction_eq (S : Finset (Σ n : ℕ, Jdx n))
    (E : GradedDPAlgebra.{u, z} R)
    (incl : GradedDPHom (stageDPAlgebra δ ι T varDeg hdeg S) E) (ρ : C →+* E.carrier)
    (hρι : ∀ p : P, ρ (ι p) = incl.hom (stageCoefficient δ ι T S p))
    (hρT : ∀ (j : Σ n : ℕ, Jdx n) (hj : j ∈ S),
      ρ (T j) = incl.hom ⟨T j, mem_finiteVariableStage_generator δ ι T hj⟩)
    (hρdpow : ∀ (n : ℕ) (x : C), x ∈ positiveEvenPart Cᵢ →
      E.gamma.dpow n (ρ x) = ρ (δ.dpow n x))
    (b : finiteVariableStage δ ι T S) : ρ (b : C) = incl.hom b := by
  refine DFunLike.congr_fun (finiteVariableStage_ringHom_ext δ ι T S
    (ρ.comp (finiteVariableStage δ ι T S).subtype) incl.hom.toRingHom (fun p => hρι p)
    (fun j hj => hρT j hj) ?_) b
  intro j hj n
  change ρ (δ.dpow n (T j)) = incl.hom ⟨δ.dpow n (T j), _⟩
  by_cases hpos : T j ∈ positiveEvenPart Cᵢ
  · have hb : (⟨T j, mem_finiteVariableStage_generator δ ι T hj⟩ :
        finiteVariableStage δ ι T S) ∈ positiveEvenPart (stageGrade δ ι T S) :=
      (mem_positiveEvenPart_stageGrade_iff δ ι T S _).2 hpos
    rw [← hρdpow n (T j) hpos, hρT j hj, incl.map_dpow n _ hb]
    rfl
  · have hz : δ.dpow n (T j) = 0 := δ.dpow_null hpos
    have h0 : (⟨δ.dpow n (T j), mem_finiteVariableStage_dpow_generator δ ι T hj n⟩ :
        finiteVariableStage δ ι T S) = 0 := Subtype.ext hz
    rw [h0, hz, map_zero]
    exact (map_zero incl.hom).symm

/-- A ring homomorphism with a left inverse whose range contains a subring is a bijection onto
that subring, once it lands in it. -/
private theorem codRestrict_bijective_of_leftInverse {A B : Type*} [Ring A] [Ring B]
    (k : A →+* B) (V : Subring B) (hk : ∀ x, k x ∈ V) {ρ : B → A} (hρ : ∀ x, ρ (k x) = x)
    (hsurj : V ≤ k.range) : Function.Bijective (k.codRestrict V hk) := by
  refine ⟨fun x y h => Function.LeftInverse.injective hρ (congrArg Subtype.val h), fun y => ?_⟩
  obtain ⟨x, hx⟩ := RingHom.mem_range.1 (hsurj y.2)
  exact ⟨x, Subtype.ext hx⟩

attribute [local implicit_reducible] TwistedModule

include hdeg in
/-- The coefficient morphism of the odd one-variable extension of a finite variable stage, as a
morphism of graded divided power algebras. -/
public noncomputable def stageToOddVariableHom (S : Finset (Σ n : ℕ, Jdx n)) (d : ℕ) (hd : 0 < d)
    (hodd : Odd d) :
    GradedDPHom (stageDPAlgebra δ ι T varDeg hdeg S)
      (oddVariableDPAlgebra (stageGrade δ ι T S)
        (stageDividedPowers δ ι T varDeg hdeg S) d hd hodd) where
  hom := OddVariableExtension.inclusionAlgHom (stageGrade δ ι T S) d
  map_grade m _ ha := OddVariableExtension.inclusion_mem_grade (stageGrade δ ι T S) d m ha
  map_dpow := oddVariableDividedPowerStructure_isExtension (stageGrade δ ι T S)
    (stageDividedPowers δ ι T varDeg hdeg S) d hd hodd

include hdeg in
/-- **Adjoining to a finite variable stage one more variable, of odd degree, gives exactly the
odd variable extension of Tag 09PH.** Surjectivity is a generation argument; injectivity is the
freeness of `C`, and is where the mapping property is used: the one-variable extension of the
stage is itself a graded divided power algebra in the universe of `C`, so `C` maps to it, and
that map retracts the comparison. -/
private theorem stage_successor_odd (hmap : HasVariableMappingProperty δ ι T)
    (S U : Finset (Σ n : ℕ, Jdx n)) (j₀ : Σ n : ℕ, Jdx n) (hj₀ : j₀ ∉ S)
    (hU : ∀ k : Σ n : ℕ, Jdx n, k ∈ U ↔ (k = j₀ ∨ k ∈ S)) (hodd : Odd (j₀.1 + 1)) :
    ∃ e : OddVariableExtension (stageGrade δ ι T S) (j₀.1 + 1) ≃+*
        finiteVariableStage δ ι T (U),
      (∀ b : finiteVariableStage δ ι T S,
          ((e (OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1) b) :
            finiteVariableStage δ ι T (U)) : C) = b) ∧
        ((e (OddVariableExtension.generator (stageGrade δ ι T S) (j₀.1 + 1)) :
            finiteVariableStage δ ι T (U)) : C) = T j₀ ∧
        (∀ (m : ℕ) (x : OddVariableExtension (stageGrade δ ι T S) (j₀.1 + 1)),
            x ∈ OddVariableExtension.grade (stageGrade δ ι T S) (j₀.1 + 1) m ↔
              ((e x : finiteVariableStage δ ι T (U)) : C) ∈ Cᵢ m) ∧
        (∀ (n : ℕ) (x : OddVariableExtension (stageGrade δ ι T S) (j₀.1 + 1)),
            x ∈ positiveEvenPart
                (OddVariableExtension.grade (stageGrade δ ι T S) (j₀.1 + 1)) →
            δ.dpow n ((e x : finiteVariableStage δ ι T (U)) : C) =
              ((e ((oddVariableDividedPowerStructure (stageGrade δ ι T S)
                (stageDividedPowers δ ι T varDeg hdeg S) (j₀.1 + 1)
                (Nat.zero_lt_succ j₀.1) hodd).dpow n x) :
                finiteVariableStage δ ι T (U)) : C)) := by
  classical
  have hd : 0 < j₀.1 + 1 := Nat.zero_lt_succ j₀.1
  obtain ⟨k, hk, -⟩ := existsUnique_oddVariableExtension_ringHom (stageGrade δ ι T S) Cᵢ
    (finiteVariableStage δ ι T S).subtype (fun _ _ hb => hb) (j₀.1 + 1) hodd (T j₀) (hdeg j₀)
  -- The prescribed images of the variables in the one-variable extension.
  obtain ⟨t, ht, htj₀, htS⟩ :
      ∃ t : (Σ n : ℕ, Jdx n) → OddVariableExtension (stageGrade δ ι T S) (j₀.1 + 1),
        (∀ j, t j ∈ OddVariableExtension.grade (stageGrade δ ι T S) (j₀.1 + 1) (j.1 + 1)) ∧
        t j₀ = OddVariableExtension.generator (stageGrade δ ι T S) (j₀.1 + 1) ∧
        ∀ (j : Σ n : ℕ, Jdx n) (hj : j ∈ S),
          t j = OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1)
            ⟨T j, mem_finiteVariableStage_generator δ ι T hj⟩ := by
    refine ⟨fun jj => if jj = j₀ then
        OddVariableExtension.generator (stageGrade δ ι T S) (j₀.1 + 1)
      else if hjj : jj ∈ S then
        OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1)
          ⟨T jj, mem_finiteVariableStage_generator δ ι T hjj⟩
      else 0, ?_, by simp, ?_⟩
    · intro jj
      by_cases h1 : jj = j₀
      · subst h1
        simpa using OddVariableExtension.generator_mem_grade (stageGrade δ ι T S) (jj.1 + 1)
      · by_cases h2 : jj ∈ S
        · simpa [h1, h2] using OddVariableExtension.inclusion_mem_grade
            (stageGrade δ ι T S) (j₀.1 + 1) (jj.1 + 1) (hdeg jj)
        · simp [h1, h2]
    · intro jj hjj
      have h1 : jj ≠ j₀ := fun h => hj₀ (h ▸ hjj)
      simp [h1, hjj]
  -- The retraction out of `C`.
  obtain ⟨ρ, hρι, hρT, hρgrade, hρdpow⟩ := hmap
    (oddVariableDPAlgebra (stageGrade δ ι T S) (stageDividedPowers δ ι T varDeg hdeg S)
      (j₀.1 + 1) hd hodd)
    ((OddVariableExtension.inclusionAlgHom (stageGrade δ ι T S) (j₀.1 + 1)).comp
      (stageCoefficient δ ι T S))
    (fun p => OddVariableExtension.inclusion_mem_grade (stageGrade δ ι T S) (j₀.1 + 1) 0
      (IsHomogeneousVariableFamily.coefficient_mem (Cᵢ := Cᵢ) (T := T) p))
    t ht
  have hρb := stage_restriction_eq δ ι T hdeg S _
    (stageToOddVariableHom δ ι T hdeg S (j₀.1 + 1) hd hodd) ρ (fun p => hρι p)
    (fun j hj => by rw [hρT j]; exact htS j hj) hρdpow
  -- The retraction composed with the comparison is the identity.
  obtain ⟨w, -, hwuniq⟩ := existsUnique_oddVariableExtension_ringHom (stageGrade δ ι T S)
    (OddVariableExtension.grade (stageGrade δ ι T S) (j₀.1 + 1))
    (OddVariableExtension.inclusionAlgHom (stageGrade δ ι T S) (j₀.1 + 1)).toRingHom
    (fun m b hb => OddVariableExtension.inclusion_mem_grade (stageGrade δ ι T S) (j₀.1 + 1) m hb)
    (j₀.1 + 1) hodd (OddVariableExtension.generator (stageGrade δ ι T S) (j₀.1 + 1))
    (OddVariableExtension.generator_mem_grade (stageGrade δ ι T S) (j₀.1 + 1))
  have hcomp : ρ.comp k = RingHom.id (OddVariableExtension (stageGrade δ ι T S) (j₀.1 + 1)) := by
    refine (hwuniq (ρ.comp k) ⟨fun b => ?_, ?_, fun m x hx => ?_⟩).trans
      (hwuniq (RingHom.id _) ⟨fun _ => rfl, rfl, fun _ _ hx => hx⟩).symm
    · change ρ (k (OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1) b)) = _
      rw [hk.1 b]
      exact hρb b
    · change ρ (k (OddVariableExtension.generator (stageGrade δ ι T S) (j₀.1 + 1))) = _
      rw [hk.2.1, hρT j₀, htj₀]
    · exact hρgrade m (k x) (hk.2.2 m x hx)
  have hρk : ∀ x, ρ (k x) = x := fun x => DFunLike.congr_fun hcomp x
  -- The image of the comparison is the next stage.
  have hrange : ∀ x, k x ∈ finiteVariableStage δ ι T (U) := by
    intro x
    rw [← OddVariableExtension.inclusion_fst_add_inclusion_snd_mul_generator
      (stageGrade δ ι T S) (j₀.1 + 1) x, map_add, map_mul, hk.1, hk.1, hk.2.1]
    refine Subring.add_mem _ ?_ (Subring.mul_mem _ ?_ ?_)
    · exact finiteVariableStage_le_of_subset δ ι T (fun kk hkk => (hU kk).2 (Or.inr hkk)) x.fst.2
    · exact finiteVariableStage_le_of_subset δ ι T (fun kk hkk => (hU kk).2 (Or.inr hkk))
        (show finiteVariableStage δ ι T S from x.snd).2
    · exact mem_finiteVariableStage_generator δ ι T ((hU j₀).2 (Or.inl rfl))
  have hsurj : finiteVariableStage δ ι T (U) ≤ k.range := by
    refine Subring.closure_le.2 ?_
    rintro x (⟨p, rfl⟩ | ⟨j, hj, rfl | ⟨n, rfl⟩⟩)
    · exact RingHom.mem_range.2 ⟨OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1)
        ⟨ι p, mem_finiteVariableStage_coefficient δ ι T S p⟩, hk.1 _⟩
    · rcases (hU j).1 hj with rfl | hjS
      · exact RingHom.mem_range.2 ⟨_, hk.2.1⟩
      · exact RingHom.mem_range.2
          ⟨OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1)
            ⟨T j, mem_finiteVariableStage_generator δ ι T hjS⟩, hk.1 _⟩
    · rcases (hU j).1 hj with rfl | hjS
      · by_cases hpos : T j ∈ positiveEvenPart Cᵢ
        · rcases positiveEven_homogeneous_eq_zero_or_grade Cᵢ (hdeg j) hpos with hz | ⟨c, hc⟩
          · rcases n with _ | n
            · exact RingHom.mem_range.2
                ⟨1, by rw [map_one, hz, δ.dpow_zero (Submodule.zero_mem _)]⟩
            · exact RingHom.mem_range.2
                ⟨0, by rw [map_zero, hz, δ.dpow_zero_eq_zero (Nat.succ_ne_zero n)]⟩
          · exact absurd hc (by obtain ⟨q, hq⟩ := hodd; omega)
        · exact RingHom.mem_range.2 ⟨0, by rw [map_zero, δ.dpow_null hpos]⟩
      · exact RingHom.mem_range.2
          ⟨OddVariableExtension.inclusion (stageGrade δ ι T S) (j₀.1 + 1)
            ⟨δ.dpow n (T j), mem_finiteVariableStage_dpow_generator δ ι T hjS n⟩, hk.1 _⟩
  have hbij := codRestrict_bijective_of_leftInverse k _ hrange hρk hsurj
  refine ⟨RingEquiv.ofBijective _ hbij, fun b => hk.1 b, hk.2.1, fun m x => ?_, fun n x hx => ?_⟩
  · refine ⟨fun hx => hk.2.2 m x hx, fun hx => ?_⟩
    have hx' := hρgrade m (k x) hx
    rwa [hρk x] at hx'
  · exact oddVariableExtension_ringHom_dpow (stageGrade δ ι T S)
      (stageDividedPowers δ ι T varDeg hdeg S) Cᵢ δ
      (finiteVariableStage δ ι T S).subtype (fun _ _ hb => hb)
      (fun n b hb => (stageDividedPowers_dpow δ ι T varDeg hdeg S n b).symm)
      (j₀.1 + 1) hd hodd (T j₀) (hdeg j₀) k hk.1 hk.2.1 n x hx

include hdeg in
/-- The coefficient morphism of the even one-variable extension of a finite variable stage, as a
morphism of graded divided power algebras. -/
public noncomputable def stageToEvenVariableHom (S : Finset (Σ n : ℕ, Jdx n)) (d : ℕ)
    (hd : 0 < d) [Fact (Even d)] :
    GradedDPHom (stageDPAlgebra δ ι T varDeg hdeg S)
      (evenVariableDPAlgebra (stageGrade δ ι T S)
        (stageDividedPowers δ ι T varDeg hdeg S) d hd) where
  hom := (EvenVariableAlgebra.coeffAlgHom :
    finiteVariableStage δ ι T S →ₐ[R] EvenVariableAlgebra (finiteVariableStage δ ι T S))
  map_grade m a ha := (EvenVariableAlgebra.coeffEmbedding_mem_grade_iff
    (stageGrade δ ι T S) d m a).2 ha
  map_dpow n _ ha :=
    dpow_coeffEmbedding d hd (stageDividedPowers δ ι T varDeg hdeg S) n ha

include hdeg in
/-- **Adjoining to a finite variable stage one more variable, of even degree, gives exactly the
even variable algebra of Tag 09PI.** As in the odd case, surjectivity is a generation argument
and injectivity comes from the mapping property, applied to the one-variable extension of the
stage. -/
private theorem stage_successor_even (hmap : HasVariableMappingProperty δ ι T)
    (S U : Finset (Σ n : ℕ, Jdx n)) (j₀ : Σ n : ℕ, Jdx n) (hj₀ : j₀ ∉ S)
    (hU : ∀ k : Σ n : ℕ, Jdx n, k ∈ U ↔ (k = j₀ ∨ k ∈ S)) [Fact (Even (j₀.1 + 1))] :
    ∃ e : EvenVariableAlgebra (finiteVariableStage δ ι T S) ≃+*
        finiteVariableStage δ ι T (U),
      (∀ b : finiteVariableStage δ ι T S,
          ((e (EvenVariableAlgebra.coeffEmbedding b) :
            finiteVariableStage δ ι T (U)) : C) = b) ∧
        ((e (EvenVariableAlgebra.monomial 1 1) :
            finiteVariableStage δ ι T (U)) : C) = T j₀ ∧
        (∀ (m : ℕ) (x : EvenVariableAlgebra (finiteVariableStage δ ι T S)),
            x ∈ EvenVariableAlgebra.grade (stageGrade δ ι T S) (j₀.1 + 1) m ↔
              ((e x : finiteVariableStage δ ι T (U)) : C) ∈ Cᵢ m) ∧
        (∀ (n : ℕ) (x : EvenVariableAlgebra (finiteVariableStage δ ι T S)),
            x ∈ positiveEvenPart
                (EvenVariableAlgebra.grade (stageGrade δ ι T S) (j₀.1 + 1)) →
            δ.dpow n ((e x : finiteVariableStage δ ι T (U)) : C) =
              ((e ((evenVariableDividedPowerStructure (j₀.1 + 1) (Nat.zero_lt_succ j₀.1)
                (stageDividedPowers δ ι T varDeg hdeg S)).dpow n x) :
                finiteVariableStage δ ι T (U)) : C)) := by
  classical
  have hd : 0 < j₀.1 + 1 := Nat.zero_lt_succ j₀.1
  have heven : Even (j₀.1 + 1) := Fact.out
  obtain ⟨c, hc⟩ : ∃ c, j₀.1 + 1 = 2 * c := by obtain ⟨c, hc⟩ := heven; exact ⟨c, by omega⟩
  have hTpos : T j₀ ∈ positiveEvenPart Cᵢ := by
    refine Submodule.mem_iSup_of_mem (c - 1) ?_
    rw [show 2 * (c - 1 + 1) = j₀.1 + 1 by omega]
    exact hdeg j₀
  obtain ⟨k, hk, -⟩ := existsUnique_evenVariableAlgebra_ringHom (stageGrade δ ι T S) Cᵢ δ
    (finiteVariableStage δ ι T S).subtype (fun _ _ hb => hb) (j₀.1 + 1) hd heven (T j₀) (hdeg j₀)
  have hmon : ∀ (n : ℕ) (a : finiteVariableStage δ ι T S),
      EvenVariableAlgebra.monomial n a =
        EvenVariableAlgebra.coeffEmbedding a * EvenVariableAlgebra.monomial n 1 := by
    intro n a
    simp [EvenVariableAlgebra.coeffEmbedding_apply, EvenVariableAlgebra.monomial_mul_monomial]
  obtain ⟨t, ht, htj₀, htS⟩ :
      ∃ t : (Σ n : ℕ, Jdx n) → EvenVariableAlgebra (finiteVariableStage δ ι T S),
        (∀ j, t j ∈ EvenVariableAlgebra.grade (stageGrade δ ι T S) (j₀.1 + 1) (j.1 + 1)) ∧
        t j₀ = EvenVariableAlgebra.monomial 1 1 ∧
        ∀ (j : Σ n : ℕ, Jdx n) (hj : j ∈ S),
          t j = EvenVariableAlgebra.coeffEmbedding
            ⟨T j, mem_finiteVariableStage_generator δ ι T hj⟩ := by
    refine ⟨fun jj => if jj = j₀ then EvenVariableAlgebra.monomial 1 1
      else if hjj : jj ∈ S then EvenVariableAlgebra.coeffEmbedding
          ⟨T jj, mem_finiteVariableStage_generator δ ι T hjj⟩
      else 0, ?_, by simp, ?_⟩
    · intro jj
      by_cases h1 : jj = j₀
      · subst h1
        simpa using EvenVariableAlgebra.monomial_one_mem_grade (stageGrade δ ι T S) (jj.1 + 1) 1
      · by_cases h2 : jj ∈ S
        · simpa [h1, h2] using (EvenVariableAlgebra.coeffEmbedding_mem_grade_iff
            (stageGrade δ ι T S) (j₀.1 + 1) (jj.1 + 1)
            ⟨T jj, mem_finiteVariableStage_generator δ ι T h2⟩).2 (hdeg jj)
        · simp [h1, h2]
    · intro jj hjj
      have h1 : jj ≠ j₀ := fun h => hj₀ (h ▸ hjj)
      simp [h1, hjj]
  obtain ⟨ρ, hρι, hρT, hρgrade, hρdpow⟩ := hmap
    (evenVariableDPAlgebra (stageGrade δ ι T S) (stageDividedPowers δ ι T varDeg hdeg S)
      (j₀.1 + 1) hd)
    ((EvenVariableAlgebra.coeffAlgHom :
        finiteVariableStage δ ι T S →ₐ[R]
          EvenVariableAlgebra (finiteVariableStage δ ι T S)).comp (stageCoefficient δ ι T S))
    (fun p => (EvenVariableAlgebra.coeffEmbedding_mem_grade_iff (stageGrade δ ι T S)
      (j₀.1 + 1) 0 (stageCoefficient δ ι T S p)).2
      (IsHomogeneousVariableFamily.coefficient_mem (Cᵢ := Cᵢ) (T := T) p))
    t ht
  have hρb := stage_restriction_eq δ ι T hdeg S _
    (stageToEvenVariableHom δ ι T hdeg S (j₀.1 + 1) hd) ρ (fun p => hρι p)
    (fun j hj => by rw [hρT j]; exact htS j hj) hρdpow
  obtain ⟨w, -, hwuniq⟩ := existsUnique_evenVariableAlgebra_ringHom (stageGrade δ ι T S)
    (EvenVariableAlgebra.grade (stageGrade δ ι T S) (j₀.1 + 1))
    (evenVariableDividedPowerStructure (j₀.1 + 1) hd (stageDividedPowers δ ι T varDeg hdeg S))
    ((EvenVariableAlgebra.coeffAlgHom :
      finiteVariableStage δ ι T S →ₐ[R]
        EvenVariableAlgebra (finiteVariableStage δ ι T S)) : _ →+* _)
    (fun m a ha => (EvenVariableAlgebra.coeffEmbedding_mem_grade_iff
      (stageGrade δ ι T S) (j₀.1 + 1) m a).2 ha)
    (j₀.1 + 1) hd heven (EvenVariableAlgebra.monomial 1 1)
    (by simpa using EvenVariableAlgebra.monomial_one_mem_grade (stageGrade δ ι T S) (j₀.1 + 1) 1)
  have hcomp : ρ.comp k =
      RingHom.id (EvenVariableAlgebra (finiteVariableStage δ ι T S)) := by
    refine (hwuniq (ρ.comp k) ⟨fun b => ?_, fun n => ?_, fun m x hx => ?_⟩).trans
      (hwuniq (RingHom.id _) ⟨fun _ => rfl, fun n => ?_, fun _ _ hx => hx⟩).symm
    · change ρ (k (EvenVariableAlgebra.coeffEmbedding b)) = _
      rw [hk.1 b]
      exact hρb b
    · change ρ (k (EvenVariableAlgebra.monomial n 1)) = _
      rw [hk.2.1 n, ← hρdpow n (T j₀) hTpos, hρT j₀, htj₀]
      rfl
    · exact hρgrade m (k x) (hk.2.2 m x hx)
    · exact (evenVariableDividedPowerStructure_dpow_monomial_one (stageGrade δ ι T S)
        (stageDividedPowers δ ι T varDeg hdeg S) (j₀.1 + 1) hd n).symm
  have hρk : ∀ x, ρ (k x) = x := fun x => DFunLike.congr_fun hcomp x
  have hrange : ∀ x, k x ∈ finiteVariableStage δ ι T (U) := by
    intro x
    induction x using EvenVariableAlgebra.induction_on with
    | zero => rw [map_zero]; exact Subring.zero_mem _
    | add n a x hx =>
        rw [map_add]
        refine Subring.add_mem _ ?_ hx
        rw [hmon n a, map_mul, hk.1, hk.2.1]
        refine Subring.mul_mem _
          (finiteVariableStage_le_of_subset δ ι T (fun kk hkk => (hU kk).2 (Or.inr hkk)) a.2) ?_
        exact mem_finiteVariableStage_dpow_generator δ ι T ((hU j₀).2 (Or.inl rfl)) n
  have hsurj : finiteVariableStage δ ι T (U) ≤ k.range := by
    refine Subring.closure_le.2 ?_
    rintro x (⟨p, rfl⟩ | ⟨j, hj, rfl | ⟨n, rfl⟩⟩)
    · exact RingHom.mem_range.2 ⟨EvenVariableAlgebra.coeffEmbedding
        ⟨ι p, mem_finiteVariableStage_coefficient δ ι T S p⟩, hk.1 _⟩
    · rcases (hU j).1 hj with rfl | hjS
      · refine RingHom.mem_range.2 ⟨EvenVariableAlgebra.monomial 1 1, ?_⟩
        rw [hk.2.1 1, δ.dpow_one hTpos]
      · exact RingHom.mem_range.2 ⟨EvenVariableAlgebra.coeffEmbedding
          ⟨T j, mem_finiteVariableStage_generator δ ι T hjS⟩, hk.1 _⟩
    · rcases (hU j).1 hj with rfl | hjS
      · exact RingHom.mem_range.2 ⟨EvenVariableAlgebra.monomial n 1, hk.2.1 n⟩
      · exact RingHom.mem_range.2 ⟨EvenVariableAlgebra.coeffEmbedding
          ⟨δ.dpow n (T j), mem_finiteVariableStage_dpow_generator δ ι T hjS n⟩, hk.1 _⟩
  have hbij := codRestrict_bijective_of_leftInverse k _ hrange hρk hsurj
  refine ⟨RingEquiv.ofBijective _ hbij, fun b => hk.1 b, ?_, fun m x => ?_, fun n x hx => ?_⟩
  · change k (EvenVariableAlgebra.monomial 1 1) = T j₀
    rw [hk.2.1 1, δ.dpow_one hTpos]
  · refine ⟨fun hx => hk.2.2 m x hx, fun hx => ?_⟩
    have hx' := hρgrade m (k x) hx
    rwa [hρk x] at hx'
  · exact evenVariableAlgebra_ringHom_dpow (stageGrade δ ι T S)
      (stageDividedPowers δ ι T varDeg hdeg S) Cᵢ δ
      (finiteVariableStage δ ι T S).subtype
      (fun n b hb => (stageDividedPowers_dpow δ ι T varDeg hdeg S n b).symm)
      (j₀.1 + 1) hd (T j₀) (hdeg j₀) k hk.1 hk.2.1 hk.2.2 n x hx

include hdeg in
/-- **The presentation theorem.** A graded divided power algebra whose coefficient algebra sits
injectively in degree zero, which is covered by the finite variable stages of a family of
homogeneous variables of degree `n + 1` for `n : ℕ`, and which is *free* on that data in the
sense of `DividedPowers.TateResolution.HasVariableMappingProperty`, is a graded divided power
polynomial algebra on those variables.

The `successor` field — that adjoining one variable to a finite variable stage spanning several
degrees gives exactly the relevant one-variable extension — is the content. Surjectivity of the
comparison is generation; injectivity is where freeness enters, and it enters through a target
built from the stage itself, which is why the mapping property has to be available for targets
in the algebra's own universe. -/
public noncomputable def gradedDividedPowerPolynomialOfMappingProperty
    (hιinj : Function.Injective ι)
    (hfin : ∀ x : C, ∃ S : Finset (Σ n : ℕ, Jdx n), x ∈ finiteVariableStage δ ι T S)
    (hmap : HasVariableMappingProperty δ ι T) :
    GradedDividedPowerPolynomial Cᵢ δ ι where
  indices := Jdx
  generator := T
  generator_mem := hdeg
  coefficient_mem := IsHomogeneousVariableFamily.coefficient_mem (Cᵢ := Cᵢ) (T := T)
  coefficient_injective := hιinj
  finite_support := hfin
  successor := by
    intro S j hj
    let hdec : DecidableEq (Σ n : ℕ, Jdx n) := Classical.decEq _
    refine ⟨stageAlgebra δ ι T S, fun _ => rfl,
      stageGrade δ ι T S, stageGradedAlgebra δ ι T S,
      stageStrictlyGradedComm δ ι T S, stageDividedPowers δ ι T varDeg hdeg S,
      fun _ _ _ => rfl, fun hodd => ?_, fun heven => ?_⟩
    · refine stage_successor_odd δ ι T hdeg hmap S _ j hj ?_ hodd
      exact fun _ => Finset.mem_insert
    · have : Fact (Even (j.1 + 1)) := ⟨heven⟩
      refine stage_successor_even δ ι T hdeg hmap S _ j hj ?_
      exact fun _ => Finset.mem_insert

end Presentation

section LiftPresentation

attribute [local instance] GradedDPAlgebra.ring GradedDPAlgebra.algebra
  GradedDPAlgebra.graded GradedDPAlgebra.strict

attribute [local instance] gradedLimitGradedAlgebra gradedLimitStrictlyGradedComm

variable {R' : Type u} {R : Type v} {A : Type w} {σ : Type z}
  [CommRing R'] [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℕ → Submodule R A} [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
  {γ : DividedPowerStructure 𝒜} {ι : MvPolynomial σ R →ₐ[R] A}
  (hpoly : GradedDividedPowerPolynomial 𝒜 γ ι)

/-- The variables of the lifted algebra `B`, indexed together with their degrees and moved into
the universe of `B`'s carrier, as the index field of a presentation requires. -/
public noncomputable def liftPresentationVariable
    (j : Σ n : ℕ, ULift.{u} (liftIndex hpoly n)) : (liftAlgebra (R' := R') hpoly).carrier :=
  towerVariable.{u, max v w z, w} (liftBase R' σ R A) (liftIndex hpoly) j.1 j.2.down

/-- Each variable of the lifted algebra is homogeneous of its prescribed degree. -/
public theorem liftPresentationVariable_mem (j : Σ n : ℕ, ULift.{u} (liftIndex hpoly n)) :
    liftPresentationVariable (R' := R') hpoly j ∈ (liftAlgebra (R' := R') hpoly).grade (j.1 + 1) :=
  towerVariable_mem.{u, max v w z, w} (liftBase R' σ R A) (liftIndex hpoly) j.1 j.2.down

/-- The coefficient algebra of the lifted algebra lands in degree zero. -/
public theorem liftCoefficientAlgHom_mem_grade_zero (p : MvPolynomial σ R') :
    liftCoefficientAlgHom (R' := R') hpoly p ∈ (liftAlgebra (R' := R') hpoly).grade 0 :=
  (liftCoefficientHom (R' := R') hpoly).map_grade 0 _
    (mem_degreeZeroGrade_zero R' (ULift.{max u v w z} (MvPolynomial σ R')) _)

/-- The coefficient algebra of the lifted algebra is a subalgebra: the inclusion of the base of
the tower is injective, and so is the identification of that base with `R'[xᵢ]`. -/
public theorem liftCoefficientAlgHom_injective :
    Function.Injective (liftCoefficientAlgHom (R' := R') hpoly) :=
  (towerInclusion_injective.{u, max v w z, w} (liftBase R' σ R A) (liftIndex hpoly) 0).comp
    (liftBaseEquiv R' σ R A).symm.injective

/-- The image of the coefficient algebra of the lifted algebra is the image of the base of the
tower: the two differ by an isomorphism of the base. -/
public theorem range_liftCoefficientAlgHom :
    Set.range (liftCoefficientAlgHom (R' := R') hpoly) =
      Set.range (liftCoefficientHom (R' := R') hpoly).hom := by
  ext y
  refine ⟨fun hy => ?_, fun hy => ?_⟩
  · obtain ⟨p, rfl⟩ := hy
    exact ⟨(liftBaseEquiv R' σ R A).symm p, rfl⟩
  · obtain ⟨b, rfl⟩ := hy
    refine ⟨liftBaseEquiv R' σ R A b, ?_⟩
    change (liftCoefficientHom (R' := R') hpoly).hom
      ((liftBaseEquiv R' σ R A).symm (liftBaseEquiv R' σ R A b)) = _
    rw [AlgEquiv.symm_apply_apply]

/-- The lifted algebra has degree-zero coefficients and homogeneous variables. -/
public instance liftIsHomogeneousVariableFamily :
    IsHomogeneousVariableFamily (liftAlgebra (R' := R') hpoly).grade
      (liftCoefficientAlgHom (R' := R') hpoly) (liftPresentationVariable (R' := R') hpoly) where
  coefficient_mem := liftCoefficientAlgHom_mem_grade_zero hpoly
  variable_homogeneous j := ⟨j.1 + 1, liftPresentationVariable_mem hpoly j⟩

/-- **The finite variable stages cover the lifted algebra.** -/
public theorem liftAlgebra_finite_support (x : (liftAlgebra (R' := R') hpoly).carrier) :
    ∃ S : Finset (Σ n : ℕ, ULift.{u} (liftIndex hpoly n)),
      x ∈ finiteVariableStage (liftAlgebra (R' := R') hpoly).gamma
        (liftCoefficientAlgHom (R' := R') hpoly) (liftPresentationVariable (R' := R') hpoly) S := by
  obtain ⟨S, hS⟩ := towerColimit_finite_support.{u, max v w z, max u v w z, w}
    (liftBase R' σ R A) (liftIndex hpoly)
    (fun j : Σ n : ℕ, ULift.{u} (liftIndex hpoly n) =>
      towerVariable.{u, max v w z, w} (liftBase R' σ R A) (liftIndex hpoly) j.1 j.2.down)
    (fun n k => ⟨⟨n, ULift.up k⟩, rfl⟩) x
  refine ⟨S, ?_⟩
  rwa [finiteVariableStage_congr_coefficient (liftAlgebra (R' := R') hpoly).gamma
    (liftCoefficientHom (R' := R') hpoly).hom (liftPresentationVariable (R' := R') hpoly)
    (liftCoefficientAlgHom (R' := R') hpoly) (range_liftCoefficientAlgHom hpoly) S]

/-- **The lifted algebra is free on its coefficients and its variables.** -/
public theorem liftAlgebra_hasVariableMappingProperty :
    HasVariableMappingProperty (liftAlgebra (R' := R') hpoly).gamma
      (liftCoefficientAlgHom (R' := R') hpoly) (liftPresentationVariable (R' := R') hpoly) := by
  intro E f hf t ht
  obtain ⟨F, hF1, hF2⟩ := liftAlgebra_exists_gradedDPHom hpoly E f hf
    (fun n j => t ⟨n, ULift.up (ULift.up j)⟩) (fun n j => ht ⟨n, ULift.up (ULift.up j)⟩)
  refine ⟨F.hom.toRingHom, fun p => hF1 p, fun j => ?_, F.map_grade, F.map_dpow⟩
  exact hF2 j.1 j.2.down.down

/-- **The lifted algebra of
`StacksFrontier/RingTheory/DividedPowers/TateResolution/SquareZeroLiftData.lean` is a graded divided
power polynomial algebra over `R'[xᵢ]`, on the same variables as `A` has.** This is the
presentation `DividedPowers.TateResolution.liftReduction` takes as its one hypothesis. -/
public noncomputable def liftPresentation :
    GradedDividedPowerPolynomial (liftAlgebra (R' := R') hpoly).grade
      (liftAlgebra (R' := R') hpoly).gamma (liftCoefficientAlgHom (R' := R') hpoly) :=
  gradedDividedPowerPolynomialOfMappingProperty (liftAlgebra (R' := R') hpoly).gamma
    (liftCoefficientAlgHom (R' := R') hpoly) (liftPresentationVariable (R' := R') hpoly)
    (liftPresentationVariable_mem hpoly) (liftCoefficientAlgHom_injective hpoly)
    (liftAlgebra_finite_support hpoly) (liftAlgebra_hasVariableMappingProperty hpoly)

/-- The variables of the presentation of the lifted algebra are those of `A`, degreewise. -/
public def liftPresentationIndexEquiv (n : ℕ) :
    hpoly.indices n ≃ (liftPresentation (R' := R') hpoly).indices n :=
  (Equiv.ulift.trans Equiv.ulift).symm

/-- The variables of the presentation of the lifted algebra are the lifted variables. -/
public theorem liftPresentation_generator (n : ℕ) (j : hpoly.indices n) :
    (liftPresentation (R' := R') hpoly).generator ⟨n, liftPresentationIndexEquiv hpoly n j⟩ =
      liftVariable (R' := R') hpoly n j := rfl

end LiftPresentation

end DividedPowers.TateResolution

