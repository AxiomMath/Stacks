/-!
# The kernel of the reduction of a graded divided-power polynomial algebra

Let `q : R' → R` be a ring map whose kernel is generated by one element `f`, let `A` be a graded
divided-power polynomial algebra over `MvPolynomial σ R` and `B` one over `MvPolynomial σ R'` on
the same variables, and let `π : B → A` be the reduction along `q` produced by
`DividedPowers.TateResolution.exists_gradedDividedPowerPolynomial_map_of_ringHom`. This file
computes the kernel of `π`: it is `f B`.

Together with
`DividedPowers.TateResolution.mem_annihilator_smul_top_of_smul_eq_zero_polynomialAlgebra`, this
is the last input of [Stacks, Tag 09PS](https://stacks.math.columbia.edu/tag/09PS).

## Main results

* `DividedPowers.TateResolution.mem_ker_iff_mul_of_gradedDividedPowerPolynomial_map`

## Implementation notes

The proof is an induction over the finite-variable stages of `B`. Its three ingredients are the
uniqueness of the coordinates on a successor stage, on the side of `A`; the fact that `π` carries
the stage of `B` at `S` into the stage of `A` at the image of `S` under the bijection of variable
index types; and, in degree zero, `MvPolynomial.ker_map`, which says that the kernel of a
coefficientwise reduction of polynomials is generated by the kernel of the reduction of scalars.

The containment of `π` of a stage in a stage is where the odd-degree variables need their own
argument, exactly as in the construction of `π` itself: the hypothesis relating `π` to the
divided powers applies only on the positive even part, which an odd-degree variable meets only in
zero. In that case either the variable is outside the positive even part, and its positive
divided powers vanish, or it is zero, and the divided powers of zero are `0` or `1` — in all
cases in the subring.

Index sets of successor stages are described by their membership rather than written as
`insert j S`, for the reason recorded in
`StacksFrontier/RingTheory/DividedPowers/TateResolution/StageDecomposition.lean`.

## References

* [Stacks Project, Tag 09PS](https://stacks.math.columbia.edu/tag/09PS)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w x z

/-- **The kernel of the reduction of a graded divided-power polynomial algebra along a ring map
with principal kernel is generated by that principal generator.**

Let `q : R' → R` have kernel `(f)`, let `A` be a graded divided-power polynomial algebra over
`MvPolynomial σ R`, let `B` be one over `MvPolynomial σ R'` with the same index type of variables
in each degree, and let `π : B → A` reduce the polynomial coefficients along `q`, carry each
variable of `B` to the corresponding variable of `A` and preserve the divided powers. Then an
element of `B` is killed by `π` exactly when it is divisible by `f`. -/
public theorem mem_ker_iff_mul_of_gradedDividedPowerPolynomial_map
    {R' : Type u} {R : Type v} {A : Type w} {B : Type x} {σ : Type z}
    [CommRing R'] [CommRing R] [Ring A] [Algebra R A] [Ring B] [Algebra R' B]
    (q : R' →+* R) (f : R') (hker : RingHom.ker q = Ideal.span {f})
    (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
    (γ : DividedPowerStructure 𝒜)
    (ι : MvPolynomial σ R →ₐ[R] A) (hpoly : GradedDividedPowerPolynomial 𝒜 γ ι)
    (ℬ : ℕ → Submodule R' B) [GradedAlgebra ℬ] [IsStrictlyGradedComm ℬ]
    (δ : DividedPowerStructure ℬ) (ι' : MvPolynomial σ R' →ₐ[R'] B)
    (hpolyB : GradedDividedPowerPolynomial ℬ δ ι')
    (e : ∀ n : ℕ, hpoly.indices n ≃ hpolyB.indices n)
    (π : B →+* A)
    (hπcoeff : ∀ p' : MvPolynomial σ R', π (ι' p') = ι (MvPolynomial.map q p'))
    (hπgen : ∀ (n : ℕ) (j : hpoly.indices n),
      π (hpolyB.generator ⟨n, e n j⟩) = hpoly.generator ⟨n, j⟩)
    (hπdpow : ∀ (n : ℕ) (b : B), b ∈ positiveEvenPart ℬ →
      π (δ.dpow n b) = γ.dpow n (π b))
    (b : B) :
    π b = 0 ↔ ∃ c : B, b = algebraMap R' B f * c := by
  classical
  -- the generator of the kernel, as an element of `B`, and its image
  have hFcoeff : algebraMap R' B f = ι' (MvPolynomial.C f) := by
    rw [← MvPolynomial.algebraMap_eq]
    exact (ι'.commutes f).symm
  have hqf : q f = 0 := by
    have hmem : f ∈ RingHom.ker q := by rw [hker]; exact Ideal.mem_span_singleton_self f
    exact hmem
  have hπF : π (algebraMap R' B f) = 0 := by
    rw [hFcoeff, hπcoeff, MvPolynomial.map_C, hqf, map_zero, map_zero]
  refine ⟨fun hb => ?_, fun ⟨c, hc⟩ => by rw [hc, map_mul, hπF, zero_mul]⟩
  -- the bijection of variable index types, as a map of the sigma types
  set Φ : (Σ n : ℕ, hpolyB.indices n) → (Σ n : ℕ, hpoly.indices n) :=
    fun k => ⟨k.1, (e k.1).symm k.2⟩ with hΦdef
  have hΦinj : Function.Injective Φ := by
    intro k l hkl
    obtain ⟨kn, ki⟩ := k
    obtain ⟨ln, li⟩ := l
    simp only [hΦdef, Sigma.mk.injEq] at hkl
    obtain ⟨rfl, hsnd⟩ := hkl
    exact Sigma.ext rfl (heq_of_eq ((e kn).symm.injective (eq_of_heq hsnd)))
  have hπgen' : ∀ k : Σ n : ℕ, hpolyB.indices n,
      π (hpolyB.generator k) = hpoly.generator (Φ k) := by
    intro k
    have h := hπgen k.1 ((e k.1).symm k.2)
    rwa [Equiv.apply_symm_apply] at h
  -- the divided powers of zero in `B`
  have hdpowB_zero : ∀ n : ℕ, δ.dpow n (0 : B) = 0 ∨ δ.dpow n (0 : B) = 1 := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact Or.inr (δ.dpow_zero (zero_mem _))
    · refine Or.inl ?_
      have hz := δ.dpow_mul_even (n := n) (x := 0) (y := 0) hn.ne'
        (zero_mem (evenPart ℬ)) (zero_mem (positiveEvenPart ℬ))
      rwa [mul_zero, zero_pow hn.ne', zero_mul] at hz
  -- the generators of even degree are in the positive even part
  have hpos : ∀ k : (Σ n : ℕ, hpolyB.indices n), Even (k.1 + 1) →
      hpolyB.generator k ∈ positiveEvenPart ℬ := by
    rintro k ⟨m, hm⟩
    refine mem_positiveEvenPart_of_mem_grade ℬ (d := m) (by omega) ?_
    have hgm := hpolyB.generator_mem k
    rwa [show (2 * m : ℕ) = k.1 + 1 from by omega]
  -- `π` carries a stage of `B` into the corresponding stage of `A`
  have hcontain : ∀ (S : Finset (Σ n : ℕ, hpolyB.indices n))
      (S' : Finset (Σ n : ℕ, hpoly.indices n)), (∀ k ∈ S, Φ k ∈ S') →
      ∀ c ∈ finiteVariableStage δ ι' hpolyB.generator S,
        π c ∈ finiteVariableStage γ ι hpoly.generator S' := by
    intro S S' hSS' c hc
    have hle : finiteVariableStage δ ι' hpolyB.generator S ≤
        Subring.comap π (finiteVariableStage γ ι hpoly.generator S') := by
      refine Subring.closure_le.mpr ?_
      rintro y (⟨p', rfl⟩ | ⟨k, hk, rfl | ⟨n, rfl⟩⟩)
      · exact Subring.subset_closure (Or.inl ⟨MvPolynomial.map q p', (hπcoeff p').symm⟩)
      · refine Subring.subset_closure (Or.inr ⟨Φ k, hSS' k hk, Or.inl ?_⟩)
        exact hπgen' k
      · rcases Nat.even_or_odd (k.1 + 1) with hev | hod
        · refine Subring.subset_closure (Or.inr ⟨Φ k, hSS' k hk, Or.inr ⟨n, ?_⟩⟩)
          show π (δ.dpow n (hpolyB.generator k)) = _
          rw [hπdpow n _ (hpos k hev), hπgen' k]
        · by_cases hposB : hpolyB.generator k ∈ positiveEvenPart ℬ
          · obtain ⟨m, hm⟩ := hod
            have hz : hpolyB.generator k = 0 := by
              refine eq_zero_of_mem_odd_grade_of_mem_positiveEvenPart ℬ (k := m) ?_ hposB
              have hgm := hpolyB.generator_mem k
              rwa [show (2 * m + 1 : ℕ) = k.1 + 1 from by omega]
            show π (δ.dpow n (hpolyB.generator k)) ∈
              finiteVariableStage γ ι hpoly.generator S'
            rw [hz]
            rcases hdpowB_zero n with h | h
            · rw [h, map_zero]; exact zero_mem _
            · rw [h, map_one]; exact one_mem _
          · show π (δ.dpow n (hpolyB.generator k)) ∈
              finiteVariableStage γ ι hpoly.generator S'
            rw [δ.dpow_null hposB, map_zero]
            exact zero_mem _
    exact hle hc
  -- the induction over the finite-variable stages of `B`
  have hstage : ∀ S : Finset (Σ n : ℕ, hpolyB.indices n),
      ∀ c ∈ finiteVariableStage δ ι' hpolyB.generator S, π c = 0 →
        ∃ y : B, c = algebraMap R' B f * y := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
        intro c hc hπc
        obtain ⟨p', rfl⟩ := exists_coefficient_of_mem_stage_empty hpolyB (by simp) hc
        have hmap : MvPolynomial.map q p' = 0 := by
          refine hpoly.coefficient_injective ?_
          rw [← hπcoeff p', hπc, map_zero]
        have hmem : p' ∈ RingHom.ker (MvPolynomial.map q (σ := σ)) := hmap
        rw [MvPolynomial.ker_map, hker, Ideal.map_span] at hmem
        simp only [Set.image_singleton] at hmem
        obtain ⟨p'', hp''⟩ := Ideal.mem_span_singleton'.mp hmem
        refine ⟨ι' p'', ?_⟩
        rw [hFcoeff, ← map_mul, ← hp'', mul_comm]
    | insert j S hj ih =>
        intro c hc hπc
        have hU : ∀ k, k ∈ insert j S ↔ k = j ∨ k ∈ S := by intro k; simp
        have hSS' : ∀ k ∈ S, Φ k ∈ S.image Φ := fun k hk => Finset.mem_image_of_mem Φ hk
        have hjnot : Φ j ∉ S.image Φ := by
          intro hmem
          obtain ⟨k, hk, hkj⟩ := Finset.mem_image.mp hmem
          exact hj (hΦinj hkj ▸ hk)
        have hU' : ∀ k, k ∈ insert (Φ j) (S.image Φ) ↔ k = Φ j ∨ k ∈ S.image Φ := by
          intro k; simp
        rcases Nat.even_or_odd (j.1 + 1) with heven | hodd
        · obtain ⟨-, huniqueA⟩ := stage_insert_even_decomposition hpoly (S.image Φ)
            (insert (Φ j) (S.image Φ)) (Φ j) hjnot hU' heven
          obtain ⟨hexists, -⟩ :=
            stage_insert_even_decomposition hpolyB S (insert j S) j hj hU heven
          obtain ⟨s, a, ha, rfl⟩ := hexists c hc
          have hzero : ∀ n ∈ s, π (a n) = 0 := by
            refine huniqueA s (fun n => π (a n))
              (fun n => hcontain S (S.image Φ) hSS' (a n) (ha n)) ?_
            rw [← hπc, map_sum]
            refine Finset.sum_congr rfl fun n _ => ?_
            rw [map_mul, hπdpow n _ (hpos j heven), hπgen' j]
          choose! y hy using fun n (hn : n ∈ s) => ih (a n) (ha n) (hzero n hn)
          refine ⟨∑ n ∈ s, y n * δ.dpow n (hpolyB.generator j), ?_⟩
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun n hn => ?_
          rw [hy n hn, mul_assoc]
        · obtain ⟨-, huniqueA⟩ := stage_insert_odd_decomposition hpoly (S.image Φ)
            (insert (Φ j) (S.image Φ)) (Φ j) hjnot hU' hodd
          obtain ⟨hexists, -⟩ :=
            stage_insert_odd_decomposition hpolyB S (insert j S) j hj hU hodd
          obtain ⟨b₀, b₁, h0, h1, rfl⟩ := hexists c hc
          obtain ⟨hz0, hz1⟩ := huniqueA (π b₀) (π b₁)
            (hcontain S (S.image Φ) hSS' b₀ h0) (hcontain S (S.image Φ) hSS' b₁ h1)
            (by rw [← hπgen' j, ← map_mul, ← map_add]; exact hπc)
          obtain ⟨y₀, hy₀⟩ := ih b₀ h0 hz0
          obtain ⟨y₁, hy₁⟩ := ih b₁ h1 hz1
          refine ⟨y₀ + y₁ * hpolyB.generator j, ?_⟩
          rw [hy₀, hy₁, mul_add, mul_assoc]
  obtain ⟨S, hS⟩ := hpolyB.finite_support b
  exact hstage S b hS hb

end DividedPowers.TateResolution

end
