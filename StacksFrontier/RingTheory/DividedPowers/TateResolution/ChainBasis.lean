module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.Polynomial
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.StageBasisStep
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.UniversalProperty

/-!
# Free homogeneous pieces of a graded divided-power polynomial algebra

A homogeneous piece of a graded divided-power polynomial algebra is the directed union of its
intersections with the finite variable stages, and freeness of a directed union of free
submodules does not follow from freeness of the members. What is needed is a family of bases of
those intersections increasing with the index set of adjoined variables, and the one-step
transfer of `StageBasisStep.lean` produces a basis of the next stage containing the basis of the
present one only because the new variable is adjoined last. Iterating it over arbitrary finite
sets is therefore not available: the bases obtained by adjoining two indices in the two possible
orders are incomparable sets, so a family indexed by the finite subsets and defined by recursion
is not monotone.

This file assembles the family along a *chain* instead. When the index type is countable the
finite subsets are exhausted by an increasing sequence each of whose steps adjoins at most one
index; the step lemma composes along that sequence by recursion, and the sequence is directed, so
the freeness lever applies with `ℕ` as its index type. The base of the recursion is the initial
stage, which is generated by the coefficient algebra and therefore concentrated in degree zero.

## Main definitions

* `DividedPowers.TateResolution.IsStageBasis` — a family of subsets of the ambient algebra is a
  basis family of a finite variable stage.

## Main results

* `DividedPowers.TateResolution.exists_finsetChain_of_countable` — the finite subsets of a
  countable type are exhausted by an increasing sequence adjoining one element at a time.
* `DividedPowers.TateResolution.exists_basis_insert` — the one-step transfer at a successor of a
  graded divided-power polynomial algebra, with the parity case split discharged.
* `DividedPowers.TateResolution.exists_basis_stage_empty` — the basis family of the initial
  stage.
* `DividedPowers.TateResolution.exists_basis_chain` — the basis families along a chain.
* `DividedPowers.TateResolution.free_grade_of_countable_indices` — every homogeneous piece of a
  graded divided-power polynomial algebra with countably many variables over a free coefficient
  algebra is free over the base ring.
* `DividedPowers.TateResolution.free_grade_of_finite_indices` — the same with finitely many
  variables in each degree, which is the form the construction supplies.

## Implementation notes

The recursion carries the family of subsets and the three properties collected in
`IsStageBasis`, and nothing else: the algebra structure, the grading and the divided powers of a
stage are re-obtained from the successor clause at each step and occur only in the hypotheses of
`exists_basis_insert`, never in its conclusion. That is what makes `Nat.rec` applicable, and it
is why the step is stated with its conclusion in the ambient algebra.

## References

* [Stacks Project, Tag 09PN](https://stacks.math.columbia.edu/tag/09PN)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w z

section Chain

/-- The finite subsets of a countable type are exhausted by an increasing sequence of finite
subsets starting at the empty set, each term of which is obtained from its predecessor by
adjoining at most one element. This is the index type along which the one-step basis transfer
composes: the step keeps the previous basis only because the new variable is adjoined last, so
the family of bases is built along a chain rather than over all finite subsets. -/
public theorem exists_finsetChain_of_countable {J : Type z} (hcount : Countable J) :
    ∃ Sn : ℕ → Finset J, Sn 0 = ∅ ∧
      (∀ n, Sn n = Sn (n + 1) ∨
        ∃ j, j ∉ Sn n ∧ ∀ k, k ∈ Sn (n + 1) ↔ k = j ∨ k ∈ Sn n) ∧
      ∀ S : Finset J, ∃ n, S ⊆ Sn n := by
  classical
  rcases isEmpty_or_nonempty J with hJ | hJ
  · refine ⟨fun _ => ∅, rfl, fun _ => Or.inl rfl, fun S => ⟨0, fun k _ => (hJ.false k).elim⟩⟩
  · obtain ⟨f, hf⟩ := exists_surjective_nat J
    refine ⟨fun n => (Finset.range n).image f, by simp, fun n => ?_, fun S => ?_⟩
    · have hiff : ∀ k, k ∈ (Finset.range (n + 1)).image f ↔
          k = f n ∨ k ∈ (Finset.range n).image f := fun k => by
        rw [Finset.range_add_one, Finset.image_insert, Finset.mem_insert]
      by_cases hmem : f n ∈ (Finset.range n).image f
      · refine Or.inl (Finset.ext fun k => ?_)
        rw [hiff k]
        exact ⟨Or.inr, fun hk => hk.elim (fun hk => hk ▸ hmem) id⟩
      · exact Or.inr ⟨f n, hmem, hiff⟩
    · choose g hg using hf
      refine ⟨(S.image g).sup id + 1, fun x hx => ?_⟩
      refine Finset.mem_image.mpr ⟨g x, Finset.mem_range.mpr ?_, hg x⟩
      exact Nat.lt_succ_of_le (Finset.le_sup (f := id) (Finset.mem_image_of_mem g hx))

end Chain

section StageBasis

variable {R : Type u} {P : Type v} {A : Type w}
  [CommRing R] [Ring P] [Algebra R P] [Ring A] [Algebra R A]

/-- A family of subsets of the ambient algebra is a *basis family* of a finite variable stage
when, degree by degree, it lies in the stage, spans the intersection of the stage with the
homogeneous piece of that degree, and is linearly independent.

The bases are recorded inside the ambient algebra rather than inside the stage, because that is
where the bases of two different stages can be compared, and comparing them is the whole point:
the stages themselves carry no canonical algebra structure. -/
public def IsStageBasis (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
    (γ : DividedPowerStructure 𝒜) (ι : P →ₐ[R] A) {J : Type z} (T : J → A) (S : Finset J)
    (b : ℕ → Set A) : Prop :=
  (∀ m, b m ⊆ finiteVariableStage γ ι T S) ∧
  (∀ m, Submodule.span R (b m) = 𝒜 m ⊓ finiteVariableStageSubmodule γ ι T S) ∧
  (∀ m, LinearIndepOn R id (b m))

end StageBasis

section Polynomial

variable {R : Type u} {P : Type v} {A : Type w}
  [CommRing R] [Ring P] [Algebra R P] [Ring A] [Algebra R A]
  {𝒜 : ℕ → Submodule R A} [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
  {γ : DividedPowerStructure 𝒜} {ι : P →ₐ[R] A}
  (h : GradedDividedPowerPolynomial 𝒜 γ ι)

/-- **The one-step basis transfer at a successor stage of a graded divided-power polynomial
algebra.** A basis family of a finite variable stage extends to a basis family of the stage
obtained by adjoining one further variable, and the extension contains the given family.

This is `exists_basis_insert_odd` and `exists_basis_insert_even` with the parity case split and
the destructuring of the successor clause carried out, so that neither the hypothesis nor the
conclusion mentions the stage's own algebra structure, grading or divided powers. That is what
lets the step compose: the recursion carries only the family of subsets and the three properties
of `IsStageBasis`, and re-obtains the structures from the clause at each step.

The next stage is described by a membership characterisation rather than written as
`insert j S`, so that the statement does not depend on a choice of decidable equality for the
index type — the successor clause supplies its own. -/
public theorem exists_basis_insert (S : Finset (Σ n : ℕ, h.indices n))
    (j : Σ n : ℕ, h.indices n) (hj : j ∉ S) (U : Finset (Σ n : ℕ, h.indices n))
    (hU : ∀ k, k ∈ U ↔ k = j ∨ k ∈ S) (b : ℕ → Set A)
    (hb : IsStageBasis 𝒜 γ ι h.generator S b) :
    ∃ b' : ℕ → Set A, (∀ m, b m ⊆ b' m) ∧ IsStageBasis 𝒜 γ ι h.generator U b' := by
  obtain ⟨hbsub, hbspan, hbind⟩ := hb
  obtain ⟨aS, halg, Sᵢ, gS, cS, δS, -, hoddBr, hevenBr⟩ := h.successor S j hj
  let instJ : DecidableEq ((n : ℕ) × h.indices n) := Classical.decEq _
  have hUeq : (insert j S : Finset ((n : ℕ) × h.indices n)) = U := by
    ext k
    simp [hU k]
  rw [hUeq] at hoddBr hevenBr
  let instA : Algebra R (finiteVariableStage γ ι h.generator S) := aS
  let instG : GradedAlgebra Sᵢ := gS
  let instC : IsStrictlyGradedComm Sᵢ := cS
  rcases Nat.even_or_odd (j.1 + 1) with heven | hodd
  · let instFact : Fact (Even (j.1 + 1)) := ⟨heven⟩
    obtain ⟨e, he1, -, he3, -⟩ := hevenBr heven
    exact exists_basis_insert_even 𝒜 γ ι h.generator S U halg (j.1 + 1) Sᵢ e he1 he3 b
      hbsub hbspan hbind
  · obtain ⟨e, he1, -, he3, -⟩ := hoddBr hodd
    exact exists_basis_insert_odd 𝒜 γ ι h.generator S U halg (j.1 + 1) Sᵢ e he1 he3 b
      hbsub hbspan hbind

/-- The initial finite variable stage consists of the coefficients. -/
public theorem mem_finiteVariableStage_empty_iff (x : A) :
    x ∈ finiteVariableStage γ ι h.generator (∅ : Finset (Σ n : ℕ, h.indices n)) ↔
      ∃ p : P, ι p = x := by
  rw [finiteVariableStage_empty 𝒜 γ ι h.generator]
  refine ⟨fun hx => ?_, fun hx => hx.elim fun p hp => hp ▸ Subring.subset_closure ⟨p, rfl⟩⟩
  induction hx using Subring.closure_induction with
  | mem y hy => exact hy
  | zero => exact ⟨0, map_zero ι⟩
  | one => exact ⟨1, map_one ι⟩
  | add _ _ _ _ hc hd =>
      obtain ⟨p, rfl⟩ := hc
      obtain ⟨q, rfl⟩ := hd
      exact ⟨p + q, map_add ι p q⟩
  | neg _ _ hc =>
      obtain ⟨p, rfl⟩ := hc
      exact ⟨-p, map_neg ι p⟩
  | mul _ _ _ _ hc hd =>
      obtain ⟨p, rfl⟩ := hc
      obtain ⟨q, rfl⟩ := hd
      exact ⟨p * q, map_mul ι p q⟩

/-- The initial finite variable stage meets a positive-degree homogeneous piece in zero only: it
is the image of the coefficient algebra, which is homogeneous of degree zero. -/
public theorem inf_finiteVariableStageSubmodule_empty_eq_bot {m : ℕ} (hm : m ≠ 0) :
    𝒜 m ⊓ finiteVariableStageSubmodule γ ι h.generator
      (∅ : Finset (Σ n : ℕ, h.indices n)) = ⊥ := by
  refine le_antisymm (fun y hy => ?_) bot_le
  obtain ⟨p, hp⟩ := (mem_finiteVariableStage_empty_iff h y).mp hy.2
  rw [Submodule.mem_bot]
  exact eq_zero_of_mem_grade_ne 𝒜 (hp ▸ h.coefficient_mem p) hy.1 (Ne.symm hm)

/-- **The base case of the recursion**: the basis family of the initial finite variable stage. A
basis of the coefficient algebra over the base ring, carried over by the coefficient embedding,
is a basis of the degree-zero piece of the initial stage, and the positive-degree pieces of that
stage vanish. -/
public theorem exists_basis_stage_empty {κ : Type*} (β : Module.Basis κ R P) :
    ∃ b : ℕ → Set A,
      IsStageBasis 𝒜 γ ι h.generator (∅ : Finset (Σ n : ℕ, h.indices n)) b := by
  have hspan0 : Submodule.span R ((ι : P → A) '' Set.range β) =
      𝒜 0 ⊓ finiteVariableStageSubmodule γ ι h.generator
        (∅ : Finset (Σ n : ℕ, h.indices n)) := by
    have himg : ((ι : P → A) '' Set.range β) = (ι.toLinearMap : P →ₗ[R] A) '' Set.range β := rfl
    rw [himg, ← Submodule.map_span, β.span_eq, Submodule.map_top]
    refine le_antisymm ?_ fun y hy => (mem_finiteVariableStage_empty_iff h y).mp hy.2
    rintro _ ⟨p, rfl⟩
    exact ⟨h.coefficient_mem p, (mem_finiteVariableStage_empty_iff h _).mpr ⟨p, rfl⟩⟩
  have key : ∀ m : ℕ, (if m = 0 then (ι : P → A) '' Set.range β else (∅ : Set A)) ⊆
        finiteVariableStage γ ι h.generator (∅ : Finset (Σ n : ℕ, h.indices n)) ∧
      Submodule.span R (if m = 0 then (ι : P → A) '' Set.range β else (∅ : Set A)) =
        𝒜 m ⊓ finiteVariableStageSubmodule γ ι h.generator
          (∅ : Finset (Σ n : ℕ, h.indices n)) ∧
      LinearIndepOn R id (if m = 0 then (ι : P → A) '' Set.range β else (∅ : Set A)) := by
    intro m
    by_cases hm : m = 0
    · subst hm
      rw [ite_eq_left rfl]
      refine ⟨?_, hspan0, linearIndepOn_image_of_ringHom (ι : P →+* A) (fun r => ι.commutes r)
        h.coefficient_injective _ β.linearIndependent.linearIndepOn_id⟩
      rintro _ ⟨y, -, rfl⟩
      exact (mem_finiteVariableStage_empty_iff h _).mpr ⟨y, rfl⟩
    · rw [ite_eq_right hm, Submodule.span_empty, inf_finiteVariableStageSubmodule_empty_eq_bot h hm]
      exact ⟨Set.empty_subset _, rfl, linearIndepOn_empty R id⟩
  exact ⟨fun m => if m = 0 then (ι : P → A) '' Set.range β else ∅, fun m => (key m).1,
    fun m => (key m).2.1, fun m => (key m).2.2⟩

/-- **The monotone family of bases along a chain of stages.** Along an increasing sequence of
finite index sets each of whose steps adjoins at most one index, a basis family of the initial
term propagates to a basis family of every term, each containing its predecessor.

The recursion is a plain `Nat.rec` together with a choice of successor family: this is exactly
what the shape of `exists_basis_insert` buys, since the data carried from one step to the next is
a family of subsets of the ambient algebra and nothing else. -/
public theorem exists_basis_chain (Sn : ℕ → Finset (Σ n : ℕ, h.indices n))
    (hchain : ∀ n, Sn n = Sn (n + 1) ∨
      ∃ j, j ∉ Sn n ∧ ∀ k, k ∈ Sn (n + 1) ↔ k = j ∨ k ∈ Sn n)
    (b₀ : ℕ → Set A) (hb₀ : IsStageBasis 𝒜 γ ι h.generator (Sn 0) b₀) :
    ∃ b : ℕ → ℕ → Set A, (∀ n m, b n m ⊆ b (n + 1) m) ∧
      ∀ n, IsStageBasis 𝒜 γ ι h.generator (Sn n) (b n) := by
  have hstep : ∀ (n : ℕ) (c : ℕ → Set A), IsStageBasis 𝒜 γ ι h.generator (Sn n) c →
      ∃ c' : ℕ → Set A, (∀ m, c m ⊆ c' m) ∧
        IsStageBasis 𝒜 γ ι h.generator (Sn (n + 1)) c' := by
    intro n c hc
    rcases hchain n with heq | ⟨j, hj, hU⟩
    · exact ⟨c, fun _ => subset_rfl, heq ▸ hc⟩
    · exact exists_basis_insert h (Sn n) j hj (Sn (n + 1)) hU c hc
  choose! F hF1 hF2 using hstep
  have hQ : ∀ n, IsStageBasis 𝒜 γ ι h.generator (Sn n)
      (Nat.rec (motive := fun _ => ℕ → Set A) b₀ (fun k c => F k c) n) := by
    intro n
    induction n with
    | zero => exact hb₀
    | succ k ih => exact hF2 k _ ih
  exact ⟨fun n => Nat.rec (motive := fun _ => ℕ → Set A) b₀ (fun k c => F k c) n,
    fun n m => hF1 n _ (hQ n) m, hQ⟩

/-- **Every homogeneous piece of a graded divided-power polynomial algebra with countably many
variables over a free coefficient algebra is free over the base ring.** This is the freeness
required of a Tate resolution, at the presentation its construction produces.

Countability of the index type is what makes the finite stages a chain, which is what makes the
one-step basis transfer compose; freeness of the coefficient algebra is the base case. Both hold
in the intended application, where the coefficients are a polynomial algebra and each degree
contributes finitely many variables. -/
public theorem free_grade_of_countable_indices {κ : Type*} (β : Module.Basis κ R P)
    (hcount : Countable (Σ n : ℕ, h.indices n)) (m : ℕ) :
    Module.Free R (𝒜 m) := by
  obtain ⟨Sn, hS0, hchain, hcover⟩ := exists_finsetChain_of_countable hcount
  obtain ⟨b₀, hb₀⟩ := exists_basis_stage_empty h β
  obtain ⟨b, hmono, hb⟩ := exists_basis_chain h Sn hchain b₀ (hS0 ▸ hb₀)
  refine free_submodule_of_directed_bases (𝒜 m)
    (fun n => 𝒜 m ⊓ finiteVariableStageSubmodule γ ι h.generator (Sn n))
    (fun n => b n m) (monotone_nat_of_le_succ fun n => hmono n m)
    (fun n => (hb n).2.1 m) (fun n => (hb n).2.2 m) ?_
  refine le_antisymm (iSup_le fun _ => inf_le_left) fun x hx => ?_
  obtain ⟨S, hS⟩ := h.finite_support x
  obtain ⟨n, hn⟩ := hcover S
  exact Submodule.mem_iSup_of_mem n
    ⟨hx, finiteVariableStage_le_of_subset γ ι h.generator hn hS⟩

/-- Finitely many variables in each degree make the variables of a graded divided-power
polynomial algebra countable. This is the hypothesis a Tate resolution with finite generators in
each degree carries. -/
public theorem countable_indices_of_finite (hfin : ∀ n, Finite (h.indices n)) :
    Countable (Σ n : ℕ, h.indices n) := by
  have hc : ∀ n, Countable (h.indices n) := fun n => (hfin n).to_countable
  infer_instance

/-- **The freeness field of a Tate resolution, discharged.** Every homogeneous piece of a graded
divided-power polynomial algebra over a free coefficient algebra with finitely many variables in
each degree is free over the base ring.

This is `free_grade_of_countable_indices` in the form the construction supplies: the coefficient
algebra is a polynomial algebra, hence free, and each degree contributes finitely many
variables. -/
public theorem free_grade_of_finite_indices [Module.Free R P]
    (hfin : ∀ n, Finite (h.indices n)) (m : ℕ) :
    Module.Free R (𝒜 m) :=
  free_grade_of_countable_indices h (Module.Free.chooseBasis R P)
    (countable_indices_of_finite h hfin) m

end Polynomial

end DividedPowers.TateResolution

