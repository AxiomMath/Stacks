module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.CoefficientGradeOne
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.FiniteTateStageExactness
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.PseudoCoherentCycles

/-! # Spanning families of cycles over a pseudo-coherent coefficient ring

`StacksFrontier/RingTheory/DividedPowers/TateResolution/FiniteTateTower.lean` builds the degreewise
finite Tate tower over a coefficient ring `P` with a prescribed finite family `s₀` of degree-zero
cycles, and shows in `DividedPowers.TateResolution.hasFiniteSpanningCycles_finiteTateStage` that
over a **Noetherian** `P` every stage has, in every degree, a finite family of cycles spanning all
of them: the homogeneous pieces of a stage are finitely generated over `P`, and over a Noetherian
ring the submodule of cycles is finitely generated too.

This file gets the same conclusion from pseudo-coherence instead. A submodule of a finitely
generated module need no longer be finitely generated, so the cycles are obtained from the
augmented complex `⋯ → A₁ → A₀ → M → 0` of the stage over `P`, whose terms above the bottom one
are finite free `P`-modules and whose bottom one is a pseudo-coherent module `M`. That complex is
pseudo-coherent by Stacks 064Y, and Stacks 064S (1) makes its cohomology finite where it is exact
above, which is
`DividedPowers.TateResolution.fg_coefficientCycles_of_isModulePseudoCoherent`.

The inputs that statement needs are supplied here. The augmentation is the identification of the
degree-zero piece of the stage with `P`, followed by a prescribed surjection `π : P → M` whose
kernel is the ideal generated by `s₀`; that ideal is exactly the set of boundaries coming from
degree one. In one direction the boundary of a degree-one element is a combination of the
differentials of the degree-one variables, which are the members of `s₀`, by
`DividedPowers.TateResolution.GradedDividedPowerPolynomial.differential_mem_span_image`; in the
other a combination of `s₀` is the boundary of the corresponding combination of those variables.
Exactness in the higher degrees is
`DividedPowers.TateResolution.exists_finiteTateStage_boundary_of_cycle`, which itself needs the
spanning property at the lower stages, so the two are established by a single induction.

## Main results

* `DividedPowers.TateResolution.hasFiniteSpanningCycles_finiteTateBase_of_isModulePseudoCoherent`
  — every stage of the degreewise finite tower over `P` has a finite spanning family of the
  cycles of its top degree, when `s₀` generates the kernel of a surjection of `P` onto a
  pseudo-coherent module.

## References

* [Stacks Project, Tag 09PN](https://stacks.math.columbia.edu/tag/09PN)
* [Stacks Project, Tag 064Y](https://stacks.math.columbia.edu/tag/064Y)
* [Stacks Project, Tag 064S](https://stacks.math.columbia.edu/tag/064S)
* [Stacks Project, Tag 0BZ9](https://stacks.math.columbia.edu/tag/0BZ9)
-/

open StacksDraft.PseudoCoherence

@[expose] public section

namespace DividedPowers.TateResolution

universe u v

attribute [local instance] GradedDPAlgebra.ring GradedDPAlgebra.algebra
  GradedDPAlgebra.graded GradedDPAlgebra.strict

attribute [local instance] TateDatum.dga TateDatum.compatible

section Stage

variable {R : Type u} [CommRing R] (P : Type (max u v)) [CommRing P] [Algebra R P]
  (s₀ : Finset P)

/-- The degree-zero cycle prescribed at an index of the base of the tower is the corresponding
member of `s₀`. -/
public theorem finiteTateCycle_finiteTateBase_mem
    (j : finiteTateIndex (finiteTateBase.{u, v} (R := R) P s₀) 0) :
    (finiteTateCycle (finiteTateBase.{u, v} (R := R) P s₀) 0 j : P) ∈ s₀ :=
  j.property

variable (M : Type (max u v)) [AddCommGroup M] [Module P M]

/-- **Over a pseudo-coherent coefficient ring every stage of the degreewise finite tower has a
finite spanning family of its top-degree cycles.** Let `s₀` be a finite subset of a commutative
ring `P` and let `π : P → M` be a surjection of `P`-modules with kernel the ideal generated by
`s₀` and with `M` pseudo-coherent. Then the stage `n + 1` of the degreewise finite tower over `P`
with `s₀` prescribed has a finite family of its degree-`n + 1` cycles spanning all of them with
coefficients of degree zero.

This is `DividedPowers.TateResolution.hasFiniteSpanningCycles_finiteTateStage` with
Noetherianness of `P` replaced by pseudo-coherence of `M`, and it is what replacing the
hypotheses of Tag 09PN by pseudo-coherence of `R → S` comes down to. -/
public theorem hasFiniteSpanningCycles_finiteTateBase_of_isModulePseudoCoherent
    [HasDerivedCategory (ModuleCat.{max u v} P)]
    (hM : IsModulePseudoCoherent (R := P) M) (π : P →ₗ[P] M)
    (hπ : Function.Surjective π)
    (hkerπ : LinearMap.ker π = Ideal.span (↑s₀ : Set P)) (n : ℕ) :
    HasFiniteSpanningCycles
      (finiteTateStage (finiteTateBase.{u, v} (R := R) P s₀) (n + 1)).datum (n + 1) := by
  classical
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  set A₀ : TateStageData.{u, v} R 0 := finiteTateBase.{u, v} (R := R) P s₀ with hA₀
  have hidx : ∀ i : ℕ, Finite (finiteTateIndex A₀ i) :=
    finite_finiteTateIndex A₀ (finite_finiteTateBase_kill P s₀)
  have hbase0 : ∀ p : (finiteTateAlgebra A₀ 0).carrier,
      p ∈ (finiteTateAlgebra A₀ 0).grade 0 := finiteTateBase_mem_grade_zero P s₀
  have h0 : ∀ p : P,
      chainStageCoefficient (finiteTateAlgebra A₀) (finiteTateStep A₀) (n + 1) p ∈
        (finiteTateAlgebra A₀ (n + 1)).grade 0 := fun p =>
    (chainMap (finiteTateAlgebra A₀) (finiteTateStep A₀) (Nat.zero_le (n + 1))).map_grade 0 p
      (hbase0 p)
  let ι : P →ₐ[R] (finiteTateAlgebra A₀ (n + 1)).carrier :=
    chainStageCoefficient (finiteTateAlgebra A₀) (finiteTateStep A₀) (n + 1)
  let _ : Algebra P (finiteTateAlgebra A₀ (n + 1)).carrier :=
    coefficientAlgebra (finiteTateAlgebra A₀ (n + 1)).grade ι h0
  have hι : ∀ p : P,
      algebraMap P (finiteTateAlgebra A₀ (n + 1)).carrier p = ι p := fun _ => rfl
  let G : GradedDividedPowerPolynomial (finiteTateAlgebra A₀ (n + 1)).grade
      (finiteTateAlgebra A₀ (n + 1)).gamma ι :=
    chainStagePresentation (finiteTateAlgebra A₀) (finiteTateStep A₀)
      (finiteTateIndex A₀) (finiteTateGenerator A₀)
      (finiteTateStage_isSetVariableExtension A₀) hbase0
      (finiteTateBase_exists_gradedDPHom P s₀) (n + 1)
  have hGidx : ∀ i : ℕ, Finite (G.indices i) := fun i =>
    finite_chainStagePresentation_indices (finiteTateAlgebra A₀) (finiteTateStep A₀)
      (finiteTateIndex A₀) (finiteTateGenerator A₀)
      (finiteTateStage_isSetVariableExtension A₀) hbase0
      (finiteTateBase_exists_gradedDPHom P s₀) (n + 1) i
  have hfin : ∀ i : ℕ,
      Module.Finite P ↥(coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 i) := fun i =>
    G.finite_coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 hι i
  have hfree : ∀ i : ℕ,
      Module.Free P ↥(coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 i) := fun i =>
    G.free_coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 hι i
  -- The coefficient morphism identifies `P` with the degree-zero piece of the stage.
  have hιinj : Function.Injective ι :=
    chainMap_injective (finiteTateAlgebra A₀) (finiteTateStep A₀)
      (finiteTateStep_injective A₀) (Nat.zero_le (n + 1))
  let χ : P →ₗ[P] ↥(coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 0) :=
    LinearMap.codRestrict _ (Algebra.linearMap P (finiteTateAlgebra A₀ (n + 1)).carrier) h0
  have hχsurj : Function.Surjective χ := by
    rintro ⟨x, hx⟩
    obtain ⟨y, -, hy⟩ := exists_chainMap_eq_of_mem_grade (finiteTateAlgebra A₀)
      (finiteTateStep A₀) (finiteTateGenerator A₀)
      (finiteTateStage_isSetVariableExtension A₀) (Nat.zero_le (n + 1)) hx
    exact ⟨y, Subtype.ext hy⟩
  let χe : P ≃ₗ[P] ↥(coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 0) :=
    LinearEquiv.ofBijective χ ⟨fun p q hpq => hιinj (congrArg Subtype.val hpq), hχsurj⟩
  let ε : ↥(coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 0) →ₗ[P] M :=
    π ∘ₗ χe.symm.toLinearMap
  have hεsurj : Function.Surjective ε := hπ.comp χe.symm.surjective
  -- The variables of degree one of the stage have the members of `s₀` for boundaries.
  have h₁ : 1 ≤ n + 1 := Nat.succ_le_succ (Nat.zero_le n)
  have hstepι : ∀ (h : 1 ≤ n + 1) (p : (finiteTateAlgebra A₀ 0).carrier),
      (chainMap (finiteTateAlgebra A₀) (finiteTateStep A₀) h).hom
        ((finiteTateStep A₀ 0).hom p) = ι p := by
    intro h p
    rw [← chainMap_hom_le_succ (finiteTateAlgebra A₀) (finiteTateStep A₀) 0 p,
      chainMap_hom_trans]
    rfl
  have hgenim : ∀ j : Σ i : ℕ, G.indices i, j.1 = 0 →
      finiteTateDifferential A₀ (n + 1) (G.generator j) ∈ ι '' (↑s₀ : Set P) := by
    rintro ⟨i, jj, hlt⟩ hj
    subst hj
    refine ⟨finiteTateCycle A₀ 0 jj, finiteTateCycle_finiteTateBase_mem P s₀ jj, ?_⟩
    show ι (finiteTateCycle A₀ 0 jj) = finiteTateDifferential A₀ (n + 1)
      ((chainMap (finiteTateAlgebra A₀) (finiteTateStep A₀) hlt).hom
        (finiteTateGenerator A₀ 0 jj))
    rw [finiteTateChainMap_differential A₀ hlt, finiteTateGenerator_differential A₀ 0 jj,
      hstepι hlt]
  have hdspan : ∀ x : (finiteTateAlgebra A₀ (n + 1)).carrier,
      x ∈ (finiteTateAlgebra A₀ (n + 1)).grade 1 →
      finiteTateDifferential A₀ (n + 1) x ∈ Submodule.span P (ι '' (↑s₀ : Set P)) := by
    intro x hx
    refine Submodule.span_mono ?_ (G.differential_mem_span_image
      (finiteTateAlgebra A₀ (n + 1)).grade (finiteTateDifferential A₀ (n + 1)) h0 hι hx)
    rintro y ⟨z, ⟨j, hj, rfl⟩, rfl⟩
    exact hgenim j hj
  have hιχ : ∀ v, ι (χe.symm v) = v.1 := fun v => congrArg Subtype.val (χe.apply_symm_apply v)
  have hε : ∀ x : ↥(coefficientGrade (finiteTateAlgebra A₀ (n + 1)).grade h0 1),
      ε (coefficientDifferential (finiteTateAlgebra A₀ (n + 1)).grade
        (finiteTateDifferential A₀ (n + 1)) h0 0 x) = 0 := by
    intro x
    have hmem : χe.symm (coefficientDifferential (finiteTateAlgebra A₀ (n + 1)).grade
        (finiteTateDifferential A₀ (n + 1)) h0 0 x) ∈ Ideal.span (↑s₀ : Set P) := by
      refine (Submodule.apply_mem_span_image_iff_mem_span
        (f := Algebra.linearMap P (finiteTateAlgebra A₀ (n + 1)).carrier) hιinj).1 ?_
      show ι _ ∈ Submodule.span P (ι '' (↑s₀ : Set P))
      rw [hιχ]
      exact hdspan x.1 x.2
    rw [← hkerπ] at hmem
    exact LinearMap.mem_ker.1 hmem
  have hkerε : LinearMap.ker ε =
      LinearMap.range (coefficientDifferential (finiteTateAlgebra A₀ (n + 1)).grade
        (finiteTateDifferential A₀ (n + 1)) h0 0) := by
    refine le_antisymm (fun v hv => ?_) ?_
    · have hp : χe.symm v ∈ Ideal.span (↑s₀ : Set P) :=
        hkerπ ▸ LinearMap.mem_ker.2 (LinearMap.mem_ker.1 hv)
      obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1 hp
      have hc' : ∑ y ∈ s₀, c y * y = χe.symm v := by simpa only [smul_eq_mul] using hc
      obtain ⟨b, hb, hdb⟩ := exists_finiteTateStage_boundary_of_combination A₀ 0
        s₀.attach (fun j => c (finiteTateCycle A₀ 0 j)) (fun _ => hbase0 _)
      have hsum := (Finset.sum_attach s₀ fun z => c z * z).trans hc'
      refine ⟨⟨(chainMap (finiteTateAlgebra A₀) (finiteTateStep A₀) h₁).hom b,
        (chainMap (finiteTateAlgebra A₀) (finiteTateStep A₀) h₁).map_grade 1 b hb⟩,
        Subtype.ext ?_⟩
      show finiteTateDifferential A₀ (n + 1) _ = _
      rw [finiteTateChainMap_differential A₀ h₁, hdb, hstepι h₁]
      exact (congrArg ι hsum).trans (hιχ v)
    · rintro _ ⟨x, rfl⟩
      exact LinearMap.mem_ker.2 (hε x)
  have hexact : ∀ i : ℕ, i + 1 ≤ n →
      LinearMap.range (coefficientDifferential (finiteTateAlgebra A₀ (n + 1)).grade
        (finiteTateDifferential A₀ (n + 1)) h0 (i + 1)) =
      LinearMap.ker (coefficientDifferential (finiteTateAlgebra A₀ (n + 1)).grade
        (finiteTateDifferential A₀ (n + 1)) h0 i) := by
    intro i hi
    refine le_antisymm ?_ fun x hx => ?_
    · rintro _ ⟨y, rfl⟩
      exact LinearMap.mem_ker.2 (coefficientDifferential_comp
        (finiteTateAlgebra A₀ (n + 1)).grade (finiteTateDifferential A₀ (n + 1)) h0 i y)
    · obtain ⟨b, hb, hdb⟩ := exists_finiteTateStage_boundary_of_cycle A₀ (N := n + 1)
        (i := i) (by lia) (ih i (by lia)) x.2
        (congrArg Subtype.val (LinearMap.mem_ker.1 hx))
      exact ⟨⟨b, hb⟩, Subtype.ext hdb⟩
  obtain ⟨s, hs⟩ := fg_coefficientCycles_of_isModulePseudoCoherent
    (finiteTateAlgebra A₀ (n + 1)).grade (finiteTateDifferential A₀ (n + 1)) h0 M ε hε n hM hfin
    hfree hεsurj hkerε hexact
  refine ⟨s, fun y hy => hs.le (Submodule.subset_span hy), fun x hx hdx => ?_⟩
  obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1
    (hs.ge (show x ∈ coefficientCycles (finiteTateAlgebra A₀ (n + 1)).grade
      (finiteTateDifferential A₀ (n + 1)) h0 (n + 1) from ⟨hx, hdx⟩))
  refine ⟨fun y => ι (c y), fun y => h0 (c y), ?_⟩
  rw [← hc]
  exact Finset.sum_congr rfl fun y _ => (Algebra.smul_def (c y) y).symm

end Stage

end DividedPowers.TateResolution

end
