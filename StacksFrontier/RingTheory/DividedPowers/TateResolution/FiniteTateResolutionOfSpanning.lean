module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.FiniteTateResolution

/-! # Tate's degreewise finite resolution from prescribed spanning families

`StacksFrontier/RingTheory/DividedPowers/TateResolution/FiniteTateResolution.lean` builds the
degreewise finite Tate resolution of a surjection `φ : R[xᵢ] → S` under the hypothesis
`IsNoetherianRing (resolutionCoefficientRing R S σ)`, which it uses in exactly one place: to know
that every stage of the degreewise finite tower has, in each degree, a finite family of cycles
spanning all of them with coefficients of degree zero.

This file removes that hypothesis. The spanning property is taken as the hypothesis instead, so
the resolution is built from it alone, with no finiteness condition on the coefficient ring. Over a
Noetherian coefficient ring the hypothesis is
`DividedPowers.TateResolution.hasFiniteSpanningCycles_finiteTateStage`, so what is proved here is a
generalisation of
`DividedPowers.TateResolution.finiteTateResolution` and of
`DividedPowers.TateResolution.finite_finiteTateResolution_polynomialIndices`: every other clause of
a Tate resolution — the grading, the divided powers, the differential, the augmentation and its
kernel, exactness in degree zero, and the finiteness of the index sets — holds for the tower
unconditionally.

## Main definitions

* `DividedPowers.TateResolution.finiteTateResolutionOfSpanning` — a surjection from a polynomial
  ring whose kernel is generated by a prescribed finite family extends to a Tate resolution with
  finitely many variables in each degree, provided each stage of the degreewise finite tower has a
  finite spanning family of the cycles of its top degree.

## Main results

* `DividedPowers.TateResolution.finite_finiteTateResolutionOfSpanning_polynomialIndices` — that
  resolution really is degreewise finite.
* `DividedPowers.TateResolution.exists_finite_tateResolution_of_spanning` — the two together, as
  an existence statement for a prescribed presentation.

## Implementation notes

The spanning hypothesis is stated for the stage `n + 1` in degree `n + 1`, which is the only
instance of it that the colimit's acyclicity
(`DividedPowers.TateResolution.exists_finiteTateColimitDifferential_boundary_of_cycle`) consumes.
Exactness in degree zero is independent of it: it comes from `s₀` generating the kernel, through
`DividedPowers.TateResolution.exists_finiteTateColimitDifferential_boundary_of_base`.

## References

* [Stacks Project, Tag 09PN](https://stacks.math.columbia.edu/tag/09PN)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w

attribute [local instance] GradedDPAlgebra.ring GradedDPAlgebra.algebra
  GradedDPAlgebra.graded GradedDPAlgebra.strict

attribute [local instance] gradedLimitGradedAlgebra gradedLimitStrictlyGradedComm

attribute [local instance] TateDatum.dga TateDatum.compatible

variable {R : Type u} {S : Type v} {σ : Type w} [CommRing R] [CommRing S] [Algebra R S]

/-- **Tate's resolution with finitely many generators in each degree, from prescribed spanning
families.** Let `φ : R[xᵢ] → S` be a surjection from a polynomial ring, let `s₀` be a finite
generating family of `ker φ`, and suppose that each stage `n + 1` of the degreewise finite tower
over `R[xᵢ]` with `s₀` as its prescribed family has a finite family of degree-`n + 1` cycles
spanning all of them with coefficients of degree zero. Then `φ` extends to a divided power
differential graded algebra over `R`, free over `R` in every degree, which is a graded divided
power polynomial algebra over `R[xᵢ]` on finitely many variables in each degree, and whose
augmentation to `S` is a quasi-isomorphism.

This is `DividedPowers.TateResolution.finiteTateResolution` with the Noetherian hypothesis on the
coefficient ring replaced by the single consequence of it that the construction uses. -/
public noncomputable def finiteTateResolutionOfSpanning (φ : MvPolynomial σ R →ₐ[R] S)
    (hφ : Function.Surjective φ) (s₀ : Finset (resolutionCoefficientRing R S σ))
    (hs₀ : Ideal.span (↑s₀ : Set (resolutionCoefficientRing R S σ)) =
      RingHom.ker (resolutionPresentation φ))
    (hspan : ∀ n : ℕ, HasFiniteSpanningCycles
      (finiteTateStage (finiteResolutionBase s₀) (n + 1)).datum (n + 1)) :
    Resolution R S σ φ where
  A := (finiteResolutionAlgebra s₀).carrier
  ring := (finiteResolutionAlgebra s₀).ring
  algebra := (finiteResolutionAlgebra s₀).algebra
  grade := (finiteResolutionAlgebra s₀).grade
  graded := (finiteResolutionAlgebra s₀).graded
  free := fun n => (finiteResolutionPolynomial s₀).free_grade n
  strict := (finiteResolutionAlgebra s₀).strict
  gamma := (finiteResolutionAlgebra s₀).gamma
  differential := finiteResolutionDifferential s₀
  dga := finiteTateColimitDga (finiteResolutionBase s₀)
  compatible := finiteTateColimitCompatible (finiteResolutionBase s₀)
  coefficient := finiteResolutionCoefficient s₀
  augmentation := (finiteResolutionAugmentation φ s₀).hom
  polynomial := finiteResolutionPolynomial s₀
  augmentation_surjective := by
    intro s
    obtain ⟨p, hp⟩ := hφ s
    exact ⟨finiteResolutionCoefficient s₀ p,
      (finiteResolutionAugmentation_coefficient φ s₀ p).trans hp⟩
  degree_zero := mem_finiteResolutionAlgebra_grade_zero_iff s₀
  augmentation_coefficient := AlgHom.ext (finiteResolutionAugmentation_coefficient φ s₀)
  augmentation_positive := fun n a hn ha =>
    finiteResolutionAugmentation_positive φ s₀ (Nat.pos_iff_ne_zero.1 hn) ha
  augmentation_differential := finiteResolutionAugmentation_differential φ s₀
    (resolutionPresentation_eq_zero_of_mem φ s₀ hs₀)
  exact_zero := by
    intro a ha haug
    obtain ⟨p, hp⟩ := (mem_finiteResolutionAlgebra_grade_zero_iff s₀ a).1 ha
    have hker : resolutionPresentation φ ((resolutionCoefficientEquiv R S σ).symm p) = 0 := by
      refine (finiteResolutionAugmentation_base φ s₀ _).symm.trans ?_
      rw [← hp] at haug
      exact haug
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1 (hs₀.ge (RingHom.mem_ker.2 hker))
    have hc' : ∑ y ∈ s₀, c y * y = (resolutionCoefficientEquiv R S σ).symm p := by
      simpa only [smul_eq_mul] using hc
    obtain ⟨b, hb, hdb⟩ :=
      exists_finiteTateColimitDifferential_boundary_of_base.{u, max v w} (R := R)
        (resolutionCoefficientRing R S σ) s₀ c
    exact ⟨b, hb, hdb.trans (Eq.trans (congrArg
      (fun z : resolutionCoefficientRing R S σ =>
        (finiteTateCoefficient (finiteResolutionBase s₀)).hom z) hc') hp)⟩
  exact_positive := by
    intro n a hn ha hda
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.1 hn)
    exact exists_finiteTateColimitDifferential_boundary_of_cycle (finiteResolutionBase s₀)
      hspan m ha hda

/-- The resolution built from prescribed spanning families has finitely many variables in each
degree: the variables of degree `i + 1` are the family chosen at the stage `i` of the tower, which
is finite by construction. -/
public theorem finite_finiteTateResolutionOfSpanning_polynomialIndices
    (φ : MvPolynomial σ R →ₐ[R] S) (hφ : Function.Surjective φ)
    (s₀ : Finset (resolutionCoefficientRing R S σ))
    (hs₀ : Ideal.span (↑s₀ : Set (resolutionCoefficientRing R S σ)) =
      RingHom.ker (resolutionPresentation φ))
    (hspan : ∀ n : ℕ, HasFiniteSpanningCycles
      (finiteTateStage (finiteResolutionBase s₀) (n + 1)).datum (n + 1)) (i : ℕ) :
    Finite ((finiteTateResolutionOfSpanning φ hφ s₀ hs₀ hspan).polynomialIndices i) :=
  finite_finiteTateIndex (finiteResolutionBase s₀)
    (finite_finiteTateBase_kill (resolutionCoefficientRing R S σ) s₀) i

/-- **A prescribed presentation with prescribed spanning families admits a degreewise finite Tate
resolution.** No finiteness hypothesis on the coefficient ring is used. -/
public theorem exists_finite_tateResolution_of_spanning (φ : MvPolynomial σ R →ₐ[R] S)
    (hφ : Function.Surjective φ) (s₀ : Finset (resolutionCoefficientRing R S σ))
    (hs₀ : Ideal.span (↑s₀ : Set (resolutionCoefficientRing R S σ)) =
      RingHom.ker (resolutionPresentation φ))
    (hspan : ∀ n : ℕ, HasFiniteSpanningCycles
      (finiteTateStage (finiteResolutionBase s₀) (n + 1)).datum (n + 1)) :
    ∃ A : Resolution R S σ φ, ∀ i : ℕ, Finite (A.polynomialIndices i) :=
  ⟨finiteTateResolutionOfSpanning φ hφ s₀ hs₀ hspan,
    finite_finiteTateResolutionOfSpanning_polynomialIndices φ hφ s₀ hs₀ hspan⟩

end DividedPowers.TateResolution

end
