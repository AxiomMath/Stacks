module

public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.Basic

/-!
# Finite-variable stages of a divided power variable extension

Let `C` be a strictly graded-commutative nonnegatively graded algebra carrying divided powers
`δ` on its positive even part, let `ι : A →ₐ[R] C` be a coefficient map and let `T : J → C` be a
family of elements, all homogeneous of one positive degree, indexed by an arbitrary set `J`.
For a finite subset `S ⊆ J` the *finite-variable stage* is the subring of `C` generated by the
image of `ι`, by the variables `T j` with `j ∈ S`, and by all divided powers of those variables.
These stages increase with `S`; the initial one is generated by the coefficients alone, and a
successor stage is obtained from its predecessor by adjoining one variable together with its
divided powers — which is the exterior extension when the degree is odd and the divided-power
extension when it is even. If the stages exhaust `C` then `C` is their directed colimit.

## Main definitions

* `DividedPowers.TateResolution.finiteVariableStage` — the subring of `C` generated by the
  coefficients, the variables indexed by a finite subset, and their divided powers.

## Main results

* `DividedPowers.TateResolution.finiteVariableStage_empty` — the initial stage is generated by
  the coefficient algebra.
* `DividedPowers.TateResolution.finiteVariableStage_insert` — a stage obtained by adjoining one
  further variable is generated by the preceding stage together with that variable and its
  divided powers.
* `DividedPowers.TateResolution.finiteVariableStages_directedColimit` — if the stages exhaust
  `C`, then a compatible family of ring homomorphisms out of the stages extends uniquely to `C`.

## Implementation notes

A stage is taken to be the subring generated by the coefficients, the variables of a finite
subset and *all* divided powers of those variables, rather than the subalgebra generated by the
variables alone. Divided powers are not polynomial expressions in their argument, so generating
by the variables only would not produce a divided-power subalgebra, and the divided powers of a
variable have to be put into the generating set by hand. Taking a subring rather than a
subalgebra costs nothing, since the image of `ι` contains the image of `algebraMap R C`.

## References

* [Stacks Project, Tag 0F4I](https://stacks.math.columbia.edu/tag/0F4I)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w z

/-- The finite-variable subring generated by coefficients, variables, and their divided
powers. These form the finite stages of the set-indexed extension. -/
public def finiteVariableStage
    {R : Type u} {A : Type v} {C : Type z}
    [CommRing R] [Ring A] [Ring C] [Algebra R A] [Algebra R C]
    {Cᵢ : ℕ → Submodule R C} [GradedAlgebra Cᵢ]
    [IsStrictlyGradedComm Cᵢ] (δ : DividedPowerStructure Cᵢ)
    (ι : A →ₐ[R] C) {J : Type w} (T : J → C) (S : Finset J) : Subring C :=
  Subring.closure
    (Set.range ι ∪
      {x : C | ∃ j : J, j ∈ S ∧
        (x = T j ∨ ∃ n : ℕ, x = δ.dpow n (T j))})

/-- A successor finite stage is obtained by adjoining its new variable and all of its
divided powers to the preceding stage. For an odd-degree variable its positive divided
powers vanish, recovering the exterior successor; in even degree this is the divided-power
successor. Iterating this equation over an enumeration of a finite set gives the finite
stages used in the directed colimit. -/
@[stacks 0F4I "finite iterated one-variable extensions"]
public theorem finiteVariableStage_insert
    {R : Type u} {A : Type v} {C : Type z} {J : Type w}
    [CommRing R] [Ring A] [Ring C] [Algebra R A] [Algebra R C]
    (Cᵢ : ℕ → Submodule R C) [GradedAlgebra Cᵢ]
    [IsStrictlyGradedComm Cᵢ] (δ : DividedPowerStructure Cᵢ)
    (ι : A →ₐ[R] C) (T : J → C) (S U : Finset J) (j : J)
    (hSU : S ⊆ U) (hj : j ∈ U)
    (hU : ∀ k : J, k ∈ U → (k ∈ S ∨ k = j)) :
    finiteVariableStage δ ι T U =
      Subring.closure
        ((finiteVariableStage δ ι T S : Set C) ∪
          {x : C | x = T j ∨ ∃ n : ℕ, x = δ.dpow n (T j)}) := by
  classical
  let V : Finset J → Set C := fun S =>
    {x | ∃ k, k ∈ S ∧ (x = T k ∨ ∃ n, x = δ.dpow n (T k))}
  let N : Set C := {x | x = T j ∨ ∃ n, x = δ.dpow n (T j)}
  change Subring.closure (Set.range ι ∪ V U) =
    Subring.closure ((Subring.closure (Set.range ι ∪ V S) : Set C) ∪ N)
  apply le_antisymm
  · apply Subring.closure_le.mpr
    intro x hx
    rcases hx with hx | hx
    · exact Subring.subset_closure (Or.inl (Subring.subset_closure (Or.inl hx)))
    · rcases hx with ⟨k, hkU, hx⟩
      rcases hU k hkU with hkS | rfl
      · exact Subring.subset_closure (Or.inl (Subring.subset_closure
          (Or.inr ⟨k, hkS, hx⟩)))
      · exact Subring.subset_closure (Or.inr (by simpa [N] using hx))
  · apply Subring.closure_le.mpr
    intro x hx
    rcases hx with hx | hx
    · refine Subring.closure_mono ?_ hx
      rintro y (hy | ⟨k, hkS, hy⟩)
      exacts [Or.inl hy, Or.inr ⟨k, hSU hkS, hy⟩]
    · rcases hx with rfl | ⟨n, rfl⟩
      · exact Subring.subset_closure (Or.inr ⟨j, hj, Or.inl rfl⟩)
      · exact Subring.subset_closure (Or.inr ⟨j, hj, Or.inr ⟨n, rfl⟩⟩)

/-- The initial finite stage is generated by the coefficient algebra. -/
@[stacks 0F4I "initial finite stage"]
public theorem finiteVariableStage_empty
    {R : Type u} {A : Type v} {C : Type z} {J : Type w}
    [CommRing R] [Ring A] [Ring C] [Algebra R A] [Algebra R C]
    (Cᵢ : ℕ → Submodule R C) [GradedAlgebra Cᵢ]
    [IsStrictlyGradedComm Cᵢ] (δ : DividedPowerStructure Cᵢ)
    (ι : A →ₐ[R] C) (T : J → C) :
    finiteVariableStage δ ι T ∅ = Subring.closure (Set.range ι) := by
  simp [finiteVariableStage]

/-- The finite-variable stages increase with the finite subset indexing their variables. -/
private theorem finiteVariableStage_mono
    {R : Type u} {A : Type v} {C : Type z} {J : Type w}
    [CommRing R] [Ring A] [Ring C] [Algebra R A] [Algebra R C]
    {Cᵢ : ℕ → Submodule R C} [GradedAlgebra Cᵢ]
    [IsStrictlyGradedComm Cᵢ] (δ : DividedPowerStructure Cᵢ)
    (ι : A →ₐ[R] C) (T : J → C) {S U : Finset J} (h : S ⊆ U) :
    finiteVariableStage δ ι T S ≤ finiteVariableStage δ ι T U := by
  apply Subring.closure_mono
  intro x hx
  rcases hx with hx | ⟨j, hj, hx⟩
  · exact Or.inl hx
  · exact Or.inr ⟨j, h hj, hx⟩

/-- If the finite-variable stages cover the algebra, they present it as their directed colimit:
a family of ring homomorphisms out of the stages which agree wherever their arguments agree in
the ambient algebra extends uniquely to a ring homomorphism out of the whole algebra. -/
@[stacks 0F4I "directed colimit of finite stages"]
public theorem finiteVariableStages_directedColimit
    {R : Type u} {A : Type v} {C : Type z} {D : Type w} {J : Type*}
    [CommRing R] [Ring A] [Ring C] [Ring D] [Algebra R A] [Algebra R C]
    (Cᵢ : ℕ → Submodule R C) [GradedAlgebra Cᵢ]
    [IsStrictlyGradedComm Cᵢ] (δ : DividedPowerStructure Cᵢ)
    (ι : A →ₐ[R] C) (T : J → C)
    (hfinite : ∀ x : C, ∃ S : Finset J,
      x ∈ finiteVariableStage δ ι T S)
    (f : (S : Finset J) → finiteVariableStage δ ι T S →+* D)
    (hcompat : ∀ (S U : Finset J)
      (x : finiteVariableStage δ ι T S)
      (y : finiteVariableStage δ ι T U),
      (x : C) = (y : C) → f S x = f U y) :
    ∃! g : C →+* D,
      ∀ (S : Finset J) (x : finiteVariableStage δ ι T S),
        g (x : C) = f S x := by
  classical
  let stage (x : C) : Finset J := Classical.choose (hfinite x)
  have memStage (x : C) : x ∈ finiteVariableStage δ ι T (stage x) :=
    Classical.choose_spec (hfinite x)
  have hpair (x y : C) : ∃ U : Finset J, ∃ (hx : x ∈ finiteVariableStage δ ι T U)
      (hy : y ∈ finiteVariableStage δ ι T U),
      f (stage x) ⟨x, memStage x⟩ = f U ⟨x, hx⟩ ∧ f (stage y) ⟨y, memStage y⟩ = f U ⟨y, hy⟩ :=
    ⟨stage x ∪ stage y,
      finiteVariableStage_mono δ ι T Finset.subset_union_left (memStage x),
      finiteVariableStage_mono δ ι T Finset.subset_union_right (memStage y),
      hcompat _ _ _ _ rfl, hcompat _ _ _ _ rfl⟩
  let g : C →+* D :=
    { toFun := fun x => f (stage x) ⟨x, memStage x⟩
      map_one' := by
        calc
          f (stage 1) ⟨1, memStage 1⟩ = f ∅ ⟨1, (finiteVariableStage δ ι T ∅).one_mem⟩ :=
            hcompat _ _ _ _ rfl
          _ = 1 := map_one (f ∅)
      map_mul' := by
        intro x y
        obtain ⟨U, hx, hy, h₁, h₂⟩ := hpair x y
        calc
          f (stage (x * y)) ⟨x * y, memStage (x * y)⟩ = f U ⟨x * y, mul_mem hx hy⟩ :=
            hcompat _ _ _ _ rfl
          _ = f U ⟨x, hx⟩ * f U ⟨y, hy⟩ := map_mul (f U) ⟨x, hx⟩ ⟨y, hy⟩
          _ = _ := by rw [h₁, h₂]
      map_zero' := by
        calc
          f (stage 0) ⟨0, memStage 0⟩ = f ∅ ⟨0, (finiteVariableStage δ ι T ∅).zero_mem⟩ :=
            hcompat _ _ _ _ rfl
          _ = 0 := map_zero (f ∅)
      map_add' := by
        intro x y
        obtain ⟨U, hx, hy, h₁, h₂⟩ := hpair x y
        calc
          f (stage (x + y)) ⟨x + y, memStage (x + y)⟩ = f U ⟨x + y, add_mem hx hy⟩ :=
            hcompat _ _ _ _ rfl
          _ = f U ⟨x, hx⟩ + f U ⟨y, hy⟩ := map_add (f U) ⟨x, hx⟩ ⟨y, hy⟩
          _ = _ := by rw [h₁, h₂] }
  refine ⟨g, fun S x => hcompat _ _ _ _ rfl, fun g' hg' => ?_⟩
  ext x
  obtain ⟨S, hx⟩ := hfinite x
  exact (hg' S ⟨x, hx⟩).trans (hcompat _ _ _ _ rfl)

end DividedPowers.TateResolution
