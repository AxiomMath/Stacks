module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.HomDifferential
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.TateColimitDifferential

/-! # Mapping Tate's tower into a differential graded algebra

`DividedPowers.TateResolution.tateColimit_exists_gradedDPHom` maps the colimit of Tate's tower
into a graded divided power algebra, given a value for every variable **chosen in advance**.
Tate's lifting argument of Tag 0GZ4 cannot use it: the value it must give to a variable of degree
`n + 1` is an element whose boundary is the image of the cycle that the variable kills, and that
image depends on the map already constructed out of the stage `n`. The values therefore have to
be chosen *during* the recursion, and the map has to commute with the differentials for the
choice at the next stage to be possible at all.

This file provides the two halves of that recursion for the tower which kills every cycle of
positive degree, together with the fact that the variables of the tower cover its colimit:

* one step — given a morphism out of the stage `k` which commutes with the differentials, and a
  homogeneous value of degree `k + 1` for each new variable whose boundary is the image of the
  cycle that variable kills, there is a morphism out of the stage `k + 1` restricting to it,
  taking the prescribed values, and again commuting with the differentials;
* the colimit — a family of morphisms out of all the stages, compatible with the steps and each
  commuting with the differentials, assembles into a morphism out of the colimit commuting with
  its differential.

The first is `DividedPowers.TateResolution.IsSetVariableExtension.existsUnique_ringHom` for the
algebra structure and
`DividedPowers.TateResolution.IsSetVariableExtension.algHom_comm_differential` for the
differential. The second is
`DividedPowers.TateResolution.chainColimit_existsUnique_lift` together with the fact that every
element of the colimit comes from a stage, so that commuting with the differential is checked one
stage at a time.

## Main results

* `DividedPowers.TateResolution.tateColimit_finite_support` — every element of the colimit lies
  in the subalgebra generated by finitely many variables.
* `DividedPowers.TateResolution.tateStep_exists_gradedDPHom_comm_differential` — the inductive
  step.
* `DividedPowers.TateResolution.tateColimit_exists_gradedDPHom_of_family` — the colimit.

## References

* [Stacks Project, Tag 09PN](https://stacks.math.columbia.edu/tag/09PN)
* [Stacks Project, Tag 0GZ4](https://stacks.math.columbia.edu/tag/0GZ4)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v y

attribute [local instance] GradedDPAlgebra.ring GradedDPAlgebra.algebra
  GradedDPAlgebra.graded GradedDPAlgebra.strict

attribute [local instance] gradedLimitGradedAlgebra gradedLimitStrictlyGradedComm

section Lift

variable {R : Type u} [CommRing R] (A₀ : TateStageData.{u, v} R 0)

/-- **The finite variable stages of the variables of Tate's tower cover its colimit.** Every
element of the colimit is a divided power polynomial, with coefficients in the base, in finitely
many of the variables. -/
public theorem tateColimit_finite_support (x : (tateColimit A₀).carrier) :
    ∃ T : Finset (Σ n : ℕ, tateIndex A₀ n),
      x ∈ finiteVariableStage (tateColimit A₀).gamma (tateCoefficient A₀).hom
        (fun j => tateVariable A₀ j.1 j.2) T :=
  chainColimit_finite_support (tateAlgebra A₀) (tateStep A₀) (tateIndex A₀)
    (tateGenerator A₀) (fun n => n + 1) (fun n => n.succ_pos)
    (tateStage_isSetVariableExtension A₀) (fun j => tateVariable A₀ j.1 j.2)
    (fun n j => ⟨⟨n, j⟩, rfl⟩) x

/-- **The inductive step of Tate's lifting argument.** Let `G` be a morphism of graded divided
power algebras from the stage `k` of Tate's tower into a differential graded algebra `E` with
divided powers compatible with its differential, and suppose `G` commutes with the two
differentials. Suppose given, for each variable `j` of degree `k + 1`, an element `t j` of `E`
homogeneous of degree `k + 1` whose boundary is the image under `G` of the degree-`k` cycle that
`j` kills. Then `G` extends to a morphism out of the stage `k + 1` sending each variable `j` to
`t j`, and the extension again commutes with the differentials. -/
public theorem tateStep_exists_gradedDPHom_comm_differential (k : ℕ)
    (E : GradedDPAlgebra.{u, y} R) (dE : E.carrier →ₗ[R] E.carrier)
    (dgaE : IsDifferentialGradedAlgebra E.grade dE)
    (compE : IsCompatibleWithDifferential E.gamma dE)
    (G : GradedDPHom (tateAlgebra A₀ k) E)
    (hGd : ∀ a : (tateAlgebra A₀ k).carrier,
      G.hom (tateDifferential A₀ k a) = dE (G.hom a))
    (t : tateIndex A₀ k → E.carrier)
    (ht : ∀ j : tateIndex A₀ k, t j ∈ E.grade (k + 1))
    (hdt : ∀ j : tateIndex A₀ k, dE (t j) = G.hom (tateCycle A₀ k j)) :
    ∃ G' : GradedDPHom (tateAlgebra A₀ (k + 1)) E,
      (∀ x : (tateAlgebra A₀ k).carrier, G'.hom ((tateStep A₀ k).hom x) = G.hom x) ∧
        (∀ j : tateIndex A₀ k, G'.hom (tateGenerator A₀ k j) = t j) ∧
          ∀ a : (tateAlgebra A₀ (k + 1)).carrier,
            G'.hom (tateDifferential A₀ (k + 1) a) = dE (G'.hom a) := by
  classical
  obtain ⟨g1, hg1, -⟩ := (tateStage_isSetVariableExtension A₀ k).existsUnique_ringHom
    E.grade E.gamma G.hom.toRingHom t G.map_grade G.map_dpow ht
  have hcomm : ∀ c : R, g1 (algebraMap R (tateAlgebra A₀ (k + 1)).carrier c) =
      algebraMap R E.carrier c := by
    intro c
    rw [← (tateStep A₀ k).hom.commutes c, hg1.1]
    exact G.hom.commutes c
  set G' : GradedDPHom (tateAlgebra A₀ (k + 1)) E :=
    ⟨{ toRingHom := g1, commutes' := hcomm }, hg1.2.2.1, hg1.2.2.2⟩ with hG'
  have hG'coeff : ∀ x : (tateAlgebra A₀ k).carrier,
      G'.hom ((tateStep A₀ k).hom x) = G.hom x := hg1.1
  have hG'gen : ∀ j : tateIndex A₀ k, G'.hom (tateGenerator A₀ k j) = t j := hg1.2.1
  refine ⟨G', hG'coeff, hG'gen, ?_⟩
  refine (tateStage_isSetVariableExtension A₀ k).algHom_comm_differential
    (tateDga A₀ (k + 1)) dgaE (tateCompatible A₀ (k + 1)) compE G'.hom
    G'.map_grade G'.map_dpow (fun a => ?_) (fun j => ?_)
  · rw [tateStep_differential A₀ k, hG'coeff, hG'coeff, hGd]
  · rw [tateGenerator_differential A₀ k j, hG'coeff, hG'gen, hdt j]

/-- **A compatible family of morphisms out of the stages of Tate's tower which commute with the
differentials assembles into a morphism out of the colimit commuting with its differential.**
Commuting with the differential is a condition on single elements, and every element of the
colimit comes from a stage, so it is enough to know it stage by stage. -/
public theorem tateColimit_exists_gradedDPHom_of_family
    (E : GradedDPAlgebra.{u, y} R) (dE : E.carrier →ₗ[R] E.carrier)
    (G : ∀ n : ℕ, GradedDPHom (tateAlgebra A₀ n) E)
    (hGstep : ∀ (n : ℕ) (x : (tateAlgebra A₀ n).carrier),
      (G (n + 1)).hom ((tateStep A₀ n).hom x) = (G n).hom x)
    (hGd : ∀ (n : ℕ) (a : (tateAlgebra A₀ n).carrier),
      (G n).hom (tateDifferential A₀ n a) = dE ((G n).hom a)) :
    ∃ F : GradedDPHom (tateColimit A₀) E,
      (∀ (n : ℕ) (x : (tateAlgebra A₀ n).carrier),
          F.hom ((tateInclusion A₀ n).hom x) = (G n).hom x) ∧
        ∀ a : (tateColimit A₀).carrier,
          F.hom (tateColimitDifferential A₀ a) = dE (F.hom a) := by
  obtain ⟨F, hF, -⟩ := chainColimit_existsUnique_lift (tateAlgebra A₀) (tateStep A₀) E G hGstep
  refine ⟨F, hF, fun a => ?_⟩
  obtain ⟨n, x, rfl⟩ := chainColimit_exists_stage (tateAlgebra A₀) (tateStep A₀) a
  rw [tateColimitDifferential_inclusion, hF, hF, hGd]

end Lift

end DividedPowers.TateResolution

end
