module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Operations
public import StacksCore.Tactic.StacksAttribute

/-! # Lifting polynomials across a principal square-zero extension

Let `q : R' → R` be a surjection of commutative rings whose kernel is the principal ideal
generated by `f : R'`. Computing the derivation of Stacks Tag 09PS on a lifted relation
(Stacks Tag 09PT) requires lifting polynomials over `R` to polynomials over `R'` while
controlling their coefficients, and the two statements needed are proved here:

* a polynomial over `R'` killed by `q` is divisible by the constant `f`
  (`exists_eq_C_mul_of_map_eq_zero`), and
* a polynomial over `R` all of whose coefficients lie in the image of the annihilator of `f`
  lifts to one whose coefficients annihilate `f` (`exists_map_eq_and_coeff_mem_annihilator`).

Both are proved coefficientwise, by choosing a witness for each coefficient and reassembling;
`polynomialOfSupportCoeffs` is that reassembly, replacing the coefficients of a polynomial on
its support by an arbitrary family taking values in another ring.

Two further auxiliary facts are collected here because they belong to the same computation: a
degree-lowering operator obeying the signed Leibniz rule is left `𝒜 0`-linear
(`differential_mul_of_mem_gradeZero`), and evaluating a polynomial whose coefficients lie in an
ideal `I` lands in `I • ⊤` (`eval_mul_mem_smul_top`).

## Main definitions

* `polynomialOfSupportCoeffs` — a polynomial's support, refilled with new coefficients.

## Main results

* `exists_eq_C_mul_of_map_eq_zero`, `exists_map_eq_and_coeff_mem_annihilator` — the two lifts.
* `differential_mul_of_mem_gradeZero` — `𝒜 0`-linearity of a signed derivation.
* `eval_mul_mem_smul_top` — evaluation of a polynomial with coefficients in `I`.

## References

* [Stacks Project, Tag 09PT](https://stacks.math.columbia.edu/tag/09PT)
-/

@[expose] public noncomputable section

namespace DividedPowers.TateResolution

universe u v z

/-- The polynomial supported on the support of `p` whose coefficient at `e` is `c e`. -/
public def polynomialOfSupportCoeffs
    {R₁ : Type u} {R₂ : Type v} {σ : Type z}
    [CommSemiring R₁] [CommSemiring R₂]
    (p : MvPolynomial σ R₁) (c : (σ →₀ ℕ) → R₂) : MvPolynomial σ R₂ :=
  p.support.sum fun e => MvPolynomial.monomial e (c e)

/-- The coefficients of `polynomialOfSupportCoeffs p c` are those of `c` on the support of `p`
and zero elsewhere. -/
public theorem coeff_polynomialOfSupportCoeffs
    {R₁ : Type u} {R₂ : Type v} {σ : Type z}
    [CommSemiring R₁] [CommSemiring R₂] [DecidableEq σ]
    (p : MvPolynomial σ R₁) (c : (σ →₀ ℕ) → R₂) (e : σ →₀ ℕ) :
    (polynomialOfSupportCoeffs p c).coeff e =
      if e ∈ p.support then c e else 0 := by
  classical
  simp [polynomialOfSupportCoeffs, MvPolynomial.coeff_monomial,
    Finset.sum_ite_eq']

/-- A polynomial over `R'` annihilated by a surjection `q : R' → R` with principal kernel
`(f)` is divisible by the constant polynomial `f`: each coefficient is a multiple of `f`, and
the quotients reassemble into a polynomial. -/
public theorem exists_eq_C_mul_of_map_eq_zero
    {R' : Type u} {R : Type v} {σ : Type z}
    [CommRing R'] [CommRing R]
    (q : R' →+* R) (f : R')
    (hker : RingHom.ker q = Ideal.span {f})
    (p : MvPolynomial σ R') (hp : MvPolynomial.map q p = 0) :
    ∃ b : MvPolynomial σ R', p = MvPolynomial.C f * b := by
  classical
  have hcoeff (e : σ →₀ ℕ) : q (p.coeff e) = 0 := by
    have he := congrArg (fun r : MvPolynomial σ R => r.coeff e) hp
    simpa [MvPolynomial.coeff_map] using he
  have hdiv (e : σ →₀ ℕ) : ∃ c : R', p.coeff e = f * c := by
    have he : p.coeff e ∈ RingHom.ker q := RingHom.mem_ker.mpr (hcoeff e)
    rw [hker] at he
    exact Ideal.mem_span_singleton.mp he
  choose c hc using hdiv
  refine ⟨polynomialOfSupportCoeffs p c, ?_⟩
  ext e
  rw [MvPolynomial.coeff_C_mul, coeff_polynomialOfSupportCoeffs]
  by_cases he : e ∈ p.support
  · simp [he, hc e]
  · have hz := MvPolynomial.notMem_support_iff.mp he
    simp [he, hz]

/-- A polynomial over `R` whose coefficients all lie in the image of the annihilator of `f`
lifts along a surjection `q : R' → R` to a polynomial whose coefficients annihilate `f`. The
coefficients are lifted one at a time and reassembled on the support. -/
public theorem exists_map_eq_and_coeff_mem_annihilator
    {R' : Type u} {R : Type v} {σ : Type z}
    [CommRing R'] [CommRing R]
    (q : R' →+* R) (hq : Function.Surjective q) (f : R')
    (p : MvPolynomial σ R)
    (hp : ∀ e, p.coeff e ∈ Ideal.map q (Ideal.span {f}).annihilator) :
    ∃ a : MvPolynomial σ R', MvPolynomial.map q a = p ∧
      ∀ e, a.coeff e ∈ (Ideal.span {f}).annihilator := by
  classical
  have hcoeff (e : σ →₀ ℕ) :
      ∃ a : R', a ∈ (Ideal.span {f}).annihilator ∧ q a = p.coeff e :=
    (Ideal.mem_map_iff_of_surjective q hq).mp (hp e)
  choose c hc using hcoeff
  refine ⟨polynomialOfSupportCoeffs p c, ?_, ?_⟩
  · calc
      MvPolynomial.map q (polynomialOfSupportCoeffs p c) =
          ∑ e ∈ p.support, MvPolynomial.monomial e (q (c e)) := by
        simp [polynomialOfSupportCoeffs]
      _ = ∑ e ∈ p.support, MvPolynomial.monomial e (p.coeff e) := by
        apply Finset.sum_congr rfl
        intro e _
        rw [(hc e).2]
      _ = p := p.as_sum.symm
  · intro e
    rw [coeff_polynomialOfSupportCoeffs]
    by_cases he : e ∈ p.support
    · simp [he, (hc e).1]
    · simp [he]

/-- A degree-lowering operator vanishing on `ℬ 0` and obeying the signed Leibniz rule is left
`ℬ 0`-linear: the sign is `+1` in degree zero and the correction term `D a` vanishes. The
statement is reduced to homogeneous `b` by decomposing it. -/
public theorem differential_mul_of_mem_gradeZero
    {R : Type u} {B : Type v} [CommRing R] [Ring B] [Algebra R B]
    (ℬ : ℕ → Submodule R B) [GradedAlgebra ℬ]
    (D : B →ₗ[R] B)
    (hDzero : ∀ b : B, b ∈ ℬ 0 → D b = 0)
    (hDmul : ∀ (i j : ℕ) (b c : B), b ∈ ℬ i → c ∈ ℬ j →
      D (b * c) = D b * c + (-1 : R) ^ i • (b * D c))
    {a : B} (ha : a ∈ ℬ 0) (b : B) : D (a * b) = a * D b := by
  classical
  let z := DirectSum.decompose ℬ b
  have hz : ∑ i ∈ z.support, (z i : B) = b := by
    simpa [z] using DirectSum.sum_support_decompose ℬ b
  rw [← hz, Finset.mul_sum, map_sum, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [hDmul 0 i a (z i) ha (z i).property, hDzero a ha]
  simp

/-- Evaluating a polynomial whose coefficients all lie in an ideal `I` and multiplying by any
element lands in `I • ⊤`: each monomial contributes `I`-scalar times an element of the algebra. -/
public theorem eval_mul_mem_smul_top
    {R : Type u} {A : Type v} {σ : Type z}
    [CommRing R] [Ring A] [Algebra R A]
    (I : Ideal R) (ψ : MvPolynomial σ R →ₐ[R] A)
    (p : MvPolynomial σ R) (hp : ∀ e, p.coeff e ∈ I)
    (a : A) : ψ p * a ∈ I • (⊤ : Submodule R A) := by
  classical
  rw [p.as_sum, map_sum, Finset.sum_mul]
  apply Submodule.sum_mem
  intro e _
  rw [MvPolynomial.monomial_eq, map_mul]
  simp only [MvPolynomial.algHom_C]
  rw [mul_assoc, ← Algebra.smul_def]
  exact Submodule.smul_mem_smul (hp e)
    (Submodule.mem_top : ψ (∏ i ∈ e.support, MvPolynomial.X i ^ e i) * a ∈
      (⊤ : Submodule R A))

end DividedPowers.TateResolution

end
