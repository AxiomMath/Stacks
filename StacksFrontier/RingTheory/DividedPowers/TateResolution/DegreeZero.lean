module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.DegreeZeroCore
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.Homology
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.Polynomial

/-!
# A commutative ring as a divided power differential graded algebra in degree zero

Let `A` be a commutative `R`-algebra, graded by placing all of it in degree zero and nothing in
positive degrees, with the unique divided power structure that grading carries; the grading and
the divided powers are `DividedPowers.TateResolution.degreeZeroGrade` and
`DividedPowers.TateResolution.degreeZeroDividedPowers`. The zero differential makes `A` a
differential graded algebra, and that differential is compatible with the divided powers.
Finally `A` is a graded divided-power polynomial algebra over itself with no variables.

This is the starting point `A(0) = R[x_j : j ∈ J]` of the tower of a Tate resolution, where the
degree-zero algebra is a polynomial ring with the zero differential and zero divided powers.

## Main definitions

* `DividedPowers.TateResolution.degreeZeroGradedDividedPowerPolynomial` — the presentation of `A`
  as a graded divided-power polynomial algebra over itself with no variables.

## Main results

* `DividedPowers.TateResolution.degreeZeroIsDifferentialGradedAlgebra` and
  `DividedPowers.TateResolution.degreeZeroIsCompatibleWithDifferential` — the zero differential
  is a divided-power differential.
* `DividedPowers.TateResolution.cycles_degreeZero` and
  `DividedPowers.TateResolution.boundaries_degreeZero` — every element is a cycle and there are
  no boundaries, so the homology is `A` itself.

## Implementation notes

The polynomial presentation is taken with the identity coefficient map and `PEmpty` variables in
every degree. The covering of `A` by its finite variable stages is the single stage over the
empty set, which is the subring generated by the image of the identity, and the successor
condition is vacuous because there is no variable to adjoin.

## References

* [Stacks Project, Tag 09PG](https://stacks.math.columbia.edu/tag/09PG)
* [Stacks Project, Tag 09PJ](https://stacks.math.columbia.edu/tag/09PJ)
* [Stacks Project, Tag 09PN](https://stacks.math.columbia.edu/tag/09PN)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v

variable (R : Type u) (A : Type v) [CommRing R] [CommRing A] [Algebra R A]

/-- The zero differential is a differential on the degree-zero grading. -/
public instance degreeZeroIsDifferentialGradedAlgebra :
    IsDifferentialGradedAlgebra (degreeZeroGrade R A) (0 : A →ₗ[R] A) where
  d_grade_zero := by intro x _; rfl
  d_mem := by
    intro n x _
    exact Submodule.zero_mem _
  d_sq_zero := by intro x; rfl
  leibniz := by intro i j x y _ _; simp

/-- Every element of a degree-zero concentrated algebra is a cycle. -/
public theorem cycles_degreeZero : cycles (0 : A →ₗ[R] A) = ⊤ := by
  ext x
  simp

/-- A degree-zero concentrated algebra has no boundaries, so its homology is itself. -/
public theorem boundaries_degreeZero :
    boundaries (𝒜 := degreeZeroGrade R A) (0 : A →ₗ[R] A) = ⊥ := by
  refine le_antisymm (fun x hx => ?_) bot_le
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
  exact Submodule.mem_bot _ |>.mpr (Subtype.ext rfl)

/-- The zero differential is compatible with the divided powers of the degree-zero grading. -/
public instance degreeZeroIsCompatibleWithDifferential :
    IsCompatibleWithDifferential (degreeZeroDividedPowers R A) (0 : A →ₗ[R] A) where
  d_dpow := by intro n x _ _; simp

/-- A commutative algebra, graded in degree zero, is a graded divided-power polynomial algebra
over itself with no variables. -/
public noncomputable def degreeZeroGradedDividedPowerPolynomial :
    GradedDividedPowerPolynomial (degreeZeroGrade R A)
      (degreeZeroDividedPowers R A) (AlgHom.id R A) where
  indices _ := PEmpty
  generator j := j.2.elim
  generator_mem j := j.2.elim
  coefficient_mem _ := Submodule.mem_top
  coefficient_injective _ _ h := h
  finite_support x := by
    refine ⟨∅, ?_⟩
    rw [finiteVariableStage_empty (degreeZeroGrade R A) (degreeZeroDividedPowers R A)]
    exact Subring.subset_closure ⟨x, rfl⟩
  successor _ j _ := j.2.elim

end DividedPowers.TateResolution

end
