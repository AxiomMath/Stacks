module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.SetVariableDerivation

/-! # Uniqueness of a derivation along a ring homomorphism out of a set-variable extension

Let `C` be the graded divided power algebra obtained from `A` by adjoining a set of variables of
a single positive degree, as recorded by
`DividedPowers.TateResolution.IsSetVariableExtension`, and let `φ : C → A'` be a ring
homomorphism. A *derivation along `φ`* is an additive map `E : C → A'` which kills degree zero
and obeys the signed Leibniz rule with `φ` inserted on the undifferentiated factor,
`E (x * y) = E x * φ y ± φ x * E y`.

Such a map is determined by its values on the coefficients and on the variables: this file proves
that one vanishing there vanishes identically. It is the uniqueness statement needed to lift a
differential across a surjection with square-zero kernel, Tag 09PS. There the comparison map `π`
of the lift is a ring homomorphism but not an isomorphism, and the two candidate operators
`π ∘ D` and `d ∘ π` are compared by applying this to their difference: that difference is a
derivation along `π`, and it vanishes on the coefficients and the variables by construction.

The untwisted case `A' = C`, `φ = id` is the uniqueness half of
`DividedPowers.TateResolution.existsUnique_gradedDerivation_setVariableExtension`; the point of
the twist is that `E` need not be valued in `C`, so no algebra structure on `A'` is needed at
all. The Koszul sign is consequently written as a power of `-1` in `A'` rather than as a scalar
action.

## Main results

* `DividedPowers.TateResolution.eq_zero_of_twisted_graded_leibniz` — a derivation along a ring
  homomorphism out of a set-variable divided power extension which vanishes on the coefficients,
  on the variables and on their divided powers is zero.

## Implementation notes

The proof is the one of `DividedPowers.TateResolution.IsSetVariableExtension`'s own uniqueness
argument, with the ambient algebra as target: the extension is covered by its finite variable
stages, each a `Subring` generated by the coefficients, the variables and their divided powers,
and the claim is proved for every homogeneous component of every element of a stage by
`Subring.closure_induction`. The multiplicative step decomposes both factors into homogeneous
components, where the Leibniz rule applies. Vanishing on all homogeneous components gives
vanishing, because the components sum to the element.

## References

* [Stacks Project, Tag 0F4I](https://stacks.math.columbia.edu/tag/0F4I)
* [Stacks Project, Tag 09PS](https://stacks.math.columbia.edu/tag/09PS)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w y z

section Twisted

variable {R : Type u} {A : Type v} {C : Type z} {A' : Type y} {J : Type w}
  [CommRing R] [Ring A] [Algebra R A] [Ring C] [Algebra R C] [Ring A']
  {Aᵢ : ℕ → Submodule R A} [GradedAlgebra Aᵢ] [IsStrictlyGradedComm Aᵢ]
  {γ : DividedPowerStructure Aᵢ}
  {Cᵢ : ℕ → Submodule R C} [GradedAlgebra Cᵢ] [IsStrictlyGradedComm Cᵢ]
  {δ : DividedPowerStructure Cᵢ}
  {ι : A →ₐ[R] C} {T : J → C} {d : ℕ} {hd : 0 < d}

/-- A derivation along a ring homomorphism `φ` out of a set-variable divided power extension is
determined by its values on the coefficients and on the variables: if it vanishes on the image of
the coefficient map, on every variable and on every divided power of a variable, it vanishes
identically.

The Koszul sign is written as a power of `-1` in the target, so that the target needs only to be
a ring. -/
public theorem eq_zero_of_twisted_graded_leibniz
    (hC : IsSetVariableExtension Aᵢ γ Cᵢ δ ι T d hd)
    (φ : C →+* A') (E : C →+ A')
    (hzero : ∀ x : C, x ∈ Cᵢ 0 → E x = 0)
    (hleib : ∀ (i k : ℕ) (x y : C), x ∈ Cᵢ i → y ∈ Cᵢ k →
      E (x * y) = E x * φ y + (-1 : A') ^ i * (φ x * E y))
    (hcoeff : ∀ a : A, E (ι a) = 0)
    (hgen : ∀ j : J, E (T j) = 0)
    (hdp : ∀ (j : J) (n : ℕ), E (δ.dpow n (T j)) = 0) (x : C) : E x = 0 := by
  classical
  have hhom : ∀ (y : C) (i : ℕ), y ∈ Cᵢ i → E y = 0 → ∀ m : ℕ,
      E (gradedPart Cᵢ y m) = 0 := by
    intro y i hyi hEy m
    by_cases hm : i = m
    · subst hm; rwa [gradedPart_of_mem_same Cᵢ hyi]
    · rw [gradedPart_of_mem_ne Cᵢ hyi hm, map_zero]
  have key : ∀ (S : Finset J) (y : C), y ∈ finiteVariableStage δ ι T S →
      ∀ m : ℕ, E (gradedPart Cᵢ y m) = 0 := by
    intro S y hy
    induction hy using Subring.closure_induction with
    | mem z hz =>
        rcases hz with ⟨a, rfl⟩ | ⟨j, -, rfl | ⟨n, rfl⟩⟩
        · intro m
          rw [gradedPart_algHom Aᵢ Cᵢ ι hC.coefficient_grade a m]
          exact hcoeff _
        · exact hhom (T j) d (hC.generator_mem j) (hgen j)
        · obtain ⟨m₀, hm₀⟩ := hC.exists_mem_grade_dpow_generator j n
          exact hhom _ m₀ hm₀ (hdp j n)
    | zero => intro m; rw [gradedPart_zero, map_zero]
    | one => exact hhom 1 0 (SetLike.one_mem_graded Cᵢ) (hzero 1 (SetLike.one_mem_graded Cᵢ))
    | add a b _ _ iha ihb => intro m; rw [gradedPart_add, map_add, iha m, ihb m, add_zero]
    | neg a _ iha => intro m; rw [gradedPart_neg, map_neg, iha m, neg_zero]
    | mul a b _ _ iha ihb =>
        intro m
        obtain ⟨s, hs⟩ := exists_gradedPart_decomposition Cᵢ a
        obtain ⟨t, ht⟩ := exists_gradedPart_decomposition Cᵢ b
        have hkey := gradedPart_mul_sum Cᵢ (s := s) (t := t)
          (gradedPart Cᵢ a) (gradedPart Cᵢ b) m
        rw [← hs, ← ht] at hkey
        rw [hkey, map_sum]
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [map_sum]
        refine Finset.sum_eq_zero fun k _ => ?_
        by_cases hik : i + k = m
        · rw [gradedPart_mul_homogeneous Cᵢ (gradedPart_mem Cᵢ a i)
            (gradedPart_mem Cᵢ b k) hik,
            hleib i k _ _ (gradedPart_mem Cᵢ a i) (gradedPart_mem Cᵢ b k),
            iha i, ihb k, zero_mul, mul_zero, mul_zero, add_zero]
        · rw [gradedPart_mul_homogeneous_of_ne Cᵢ (gradedPart_mem Cᵢ a i)
            (gradedPart_mem Cᵢ b k) hik, map_zero]
  obtain ⟨S, hS⟩ := hC.finite_support x
  obtain ⟨s, hs⟩ := exists_gradedPart_decomposition Cᵢ x
  rw [hs, map_sum]
  exact Finset.sum_eq_zero fun m _ => key S x hS m

end Twisted

end DividedPowers.TateResolution

end
