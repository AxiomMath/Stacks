module

public import StacksFrontier.RingTheory.DividedPowers.TateResolution.GradedPolynomialMap
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.Polynomial
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.UniversalProperty

/-!
# Restricting a graded divided-power algebra along a map of base rings

A graded divided-power algebra over `R` is one over `R'` for every ring map `q : R' → R`: the
homogeneous pieces, the grading, the strict graded commutativity and the divided powers are all
unchanged, only the scalars are pulled back. This is what lets the mapping property of a graded
divided-power polynomial algebra, which has one base ring for its source and its target, compare
an algebra over `R'` with an algebra over `R`.

The comparison itself is the second half of the file: two graded divided-power polynomial
algebras on the same variables, one over `MvPolynomial σ R'` and one over `MvPolynomial σ R`,
are related by a surjection reducing the coefficients along `q`.

## Main definitions

* `DividedPowers.TateResolution.coefficientRestrictGrade` — a homogeneous piece as an
  `R'`-submodule.
* `DividedPowers.TateResolution.restrictDividedPowerStructure` — the divided powers of the
  restricted grading.

## Main results

* `DividedPowers.TateResolution.gradedAlgebra_coefficientRestrictGrade`,
  `DividedPowers.TateResolution.isStrictlyGradedComm_coefficientRestrictGrade` — the restricted
  grading is again a strictly graded-commutative graded algebra structure.
* `DividedPowers.TateResolution.exists_gradedDividedPowerPolynomial_map_of_ringHom` — for a
  surjection `q : R' → R` of coefficient rings, a graded divided-power polynomial algebra over
  `MvPolynomial σ R'` surjects onto one over `MvPolynomial σ R` carrying the same variables,
  compatibly with the coefficient map, the variables, the grading and the divided powers.

## Implementation notes

The restricted grading is defined by hand, with the same carrier set, rather than through
`Submodule.restrictScalars`, which would need an `SMul R' R` and an `IsScalarTower R' R A` that
`q` alone does not provide. The payoff is that `↥(coefficientRestrictGrade q h 𝒜 n)` is the *same
type* as `↥(𝒜 n)`, so the direct sum `⨁ n, ↥(coefficientRestrictGrade q h 𝒜 n)` is the direct sum
of the original pieces and the decomposition transports by `rfl`; only the scalar multiplication
has to be checked, in one place.

The hypothesis `algebraMap R' A r' = algebraMap R A (q r')` is carried explicitly rather than as
an `IsScalarTower` instance because the `R'`-algebra structure on `A` is usually produced on the
spot from `q`, by `algebraOfCoefficientRingHom`, and then the hypothesis holds by `rfl`.

Surjectivity of the comparison map is read off the definition of a finite variable stage as the
subring generated by the coefficients, the variables and their divided powers. The divided powers
of a variable of *odd* degree need a separate argument: such a variable lies in the positive even
part only if it is zero, and the divided powers of zero are `0` and `1`, both in the image.

## References

* [Stacks Project, Tag 09PS](https://stacks.math.columbia.edu/tag/09PS)
* [Stacks Project, Tag 0F4I](https://stacks.math.columbia.edu/tag/0F4I)
-/

@[expose] public section

namespace DividedPowers.TateResolution

universe u v w x y

section Restrict

variable {R' : Type u} {R : Type v} {A : Type w}
  [CommRing R'] [CommRing R] [Ring A] [Algebra R A]

/-- `A` as an `R'`-algebra along a ring map `q : R' →+* R`. -/
@[instance_reducible]
public def algebraOfCoefficientRingHom (q : R' →+* R) : Algebra R' A :=
  ((algebraMap R A).comp q).toAlgebra' fun c x => Algebra.commutes (q c) x

variable [Algebra R' A]

/-- Along `q`, the `R'`-action on `A` is the `R`-action pulled back. -/
public theorem smul_eq_of_algebraMap_comp (q : R' →+* R)
    (hsmul : ∀ r' : R', algebraMap R' A r' = algebraMap R A (q r')) (r' : R') (a : A) :
    r' • a = q r' • a := by
  rw [Algebra.smul_def, hsmul, Algebra.smul_def]

variable (q : R' →+* R)
  (hsmul : ∀ r' : R', algebraMap R' A r' = algebraMap R A (q r'))

/-- A homogeneous piece of `A`, viewed as an `R'`-submodule along `q`. -/
public def coefficientRestrictGrade (𝒜 : ℕ → Submodule R A) (n : ℕ) : Submodule R' A where
  carrier := (𝒜 n : Set A)
  add_mem' := (𝒜 n).add_mem
  zero_mem' := (𝒜 n).zero_mem
  smul_mem' r' a ha := by
    rw [smul_eq_of_algebraMap_comp q hsmul]
    exact (𝒜 n).smul_mem _ ha

/-- Membership in the restricted homogeneous piece is membership in the original piece. -/
@[simp]
public theorem mem_coefficientRestrictGrade {𝒜 : ℕ → Submodule R A} {n : ℕ} {a : A} :
    a ∈ coefficientRestrictGrade q hsmul 𝒜 n ↔ a ∈ 𝒜 n := Iff.rfl

/-- The grading of `A` restricted along `q` is again a graded algebra structure. -/
@[instance_reducible]
public def gradedAlgebra_coefficientRestrictGrade (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] :
    GradedAlgebra (coefficientRestrictGrade q hsmul 𝒜) where
  one_mem := SetLike.one_mem_graded 𝒜
  mul_mem := SetLike.mul_mem_graded (A := 𝒜)
  decompose' a := DirectSum.decompose 𝒜 a
  left_inv a := DirectSum.Decomposition.left_inv (ℳ := 𝒜) a
  right_inv a := DirectSum.Decomposition.right_inv (ℳ := 𝒜) a

/-- Strict graded commutativity survives restriction of scalars along `q`: the Koszul sign is the
image of the Koszul sign. -/
public theorem isStrictlyGradedComm_coefficientRestrictGrade (𝒜 : ℕ → Submodule R A)
    [IsStrictlyGradedComm 𝒜] : IsStrictlyGradedComm (coefficientRestrictGrade q hsmul 𝒜) where
  graded_comm hx hy := by
    rw [IsStrictlyGradedComm.graded_comm (𝒜 := 𝒜) hx hy,
      smul_eq_of_algebraMap_comp q hsmul, map_pow, map_neg, map_one]
  odd_sq_zero hx := IsStrictlyGradedComm.odd_sq_zero (𝒜 := 𝒜) hx

variable (𝒜 : ℕ → Submodule R A)

/-- A supremum of restricted homogeneous pieces has the same elements as the original supremum. -/
private theorem mem_iSup_coefficientRestrictGrade_iff {𝒜 : ℕ → Submodule R A} (f : ℕ → ℕ)
    {a : A} : a ∈ ⨆ d, coefficientRestrictGrade q hsmul 𝒜 (f d) ↔ a ∈ ⨆ d, 𝒜 (f d) := by
  constructor <;> intro h <;>
    induction h using Submodule.iSup_induction' with
    | mem d x hx => exact Submodule.mem_iSup_of_mem d hx
    | zero => exact zero_mem _
    | add x y _ _ hx hy => exact add_mem hx hy

/-- The even part of the restricted grading has the same elements as the even part of `𝒜`. -/
@[simp]
public theorem mem_evenPart_coefficientRestrictGrade {a : A} :
    a ∈ evenPart (coefficientRestrictGrade q hsmul 𝒜) ↔ a ∈ evenPart 𝒜 :=
  mem_iSup_coefficientRestrictGrade_iff q hsmul (fun d => 2 * d)

/-- The positive even part of the restricted grading has the same elements as the positive even
part of `𝒜`. -/
@[simp]
public theorem mem_positiveEvenPart_coefficientRestrictGrade {a : A} :
    a ∈ positiveEvenPart (coefficientRestrictGrade q hsmul 𝒜) ↔ a ∈ positiveEvenPart 𝒜 :=
  mem_iSup_coefficientRestrictGrade_iff q hsmul (fun d => 2 * (d + 1))

/-- A divided-power structure survives restriction of scalars along `q`: the divided powers are
unchanged, and their domain, the positive even part, is cut out by the same homogeneous pieces. -/
public def restrictDividedPowerStructure [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
    [GradedAlgebra (coefficientRestrictGrade q hsmul 𝒜)]
    [IsStrictlyGradedComm (coefficientRestrictGrade q hsmul 𝒜)]
    (γ : DividedPowerStructure 𝒜) : DividedPowerStructure (coefficientRestrictGrade q hsmul 𝒜) where
  dpow := γ.dpow
  dpow_null hx := γ.dpow_null (by rwa [mem_positiveEvenPart_coefficientRestrictGrade] at hx)
  dpow_zero hx := γ.dpow_zero ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx)
  dpow_one hx := γ.dpow_one ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx)
  dpow_mem hn hx := (mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mpr
    (γ.dpow_mem hn ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx))
  dpow_mem_grade hn hx hxd :=
    γ.dpow_mem_grade hn ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx) hxd
  dpow_mul hx := γ.dpow_mul ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx)
  dpow_mul_even hn hx hy := γ.dpow_mul_even hn
    ((mem_evenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx)
    ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hy)
  dpow_mul_odd hn hx hy := γ.dpow_mul_odd hn hx hy
  dpow_add hx hy := γ.dpow_add ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx)
    ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hy)
  dpow_dpow hm hn hx :=
    γ.dpow_dpow hm hn ((mem_positiveEvenPart_coefficientRestrictGrade q hsmul 𝒜).mp hx)

/-- The divided powers of `restrictDividedPowerStructure q hsmul 𝒜 γ` are those of `γ`. -/
@[simp]
public theorem restrictDividedPowerStructure_dpow [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
    [GradedAlgebra (coefficientRestrictGrade q hsmul 𝒜)]
    [IsStrictlyGradedComm (coefficientRestrictGrade q hsmul 𝒜)]
    (γ : DividedPowerStructure 𝒜) (n : ℕ) (a : A) :
    (restrictDividedPowerStructure q hsmul 𝒜 γ).dpow n a = γ.dpow n a := rfl

end Restrict

section Map

variable {R' : Type u} {R : Type v} {A : Type w} {B : Type x} {σ : Type y}
  [CommRing R'] [CommRing R] [Ring A] [Algebra R A] [Ring B] [Algebra R' B]

/-- **Reduction of a graded divided-power polynomial algebra along a surjection of coefficient
rings.** Let `q : R' → R` be surjective, let `A` be a graded divided-power polynomial algebra
over `MvPolynomial σ R` and `B` one over `MvPolynomial σ R'`, with the same index type of
variables in every degree. Then `B` surjects onto `A` by a ring map which reduces the scalars
and the polynomial coefficients along `q`, sends each variable of `B` to the corresponding
variable of `A`, preserves the grading, and preserves the divided powers. -/
public theorem exists_gradedDividedPowerPolynomial_map_of_ringHom
    (q : R' →+* R) (hq : Function.Surjective q)
    (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] [IsStrictlyGradedComm 𝒜]
    (γ : DividedPowerStructure 𝒜)
    (ι : MvPolynomial σ R →ₐ[R] A) (hpoly : GradedDividedPowerPolynomial 𝒜 γ ι)
    (ℬ : ℕ → Submodule R' B) [GradedAlgebra ℬ] [IsStrictlyGradedComm ℬ]
    (δ : DividedPowerStructure ℬ) (ι' : MvPolynomial σ R' →ₐ[R'] B)
    (hpolyB : GradedDividedPowerPolynomial ℬ δ ι')
    (e : ∀ n : ℕ, hpoly.indices n ≃ hpolyB.indices n) :
    ∃ π : B →+* A,
      Function.Surjective π ∧
      (∀ r' : R', π (algebraMap R' B r') = algebraMap R A (q r')) ∧
      (∀ p' : MvPolynomial σ R', π (ι' p') = ι (MvPolynomial.map q p')) ∧
      (∀ (n : ℕ) (j : hpoly.indices n),
        π (hpolyB.generator ⟨n, e n j⟩) = hpoly.generator ⟨n, j⟩) ∧
      (∀ (n : ℕ) (b : B), b ∈ ℬ n → π b ∈ 𝒜 n) ∧
      (∀ (n : ℕ) (b : B), b ∈ positiveEvenPart ℬ →
        π (δ.dpow n b) = γ.dpow n (π b)) := by
  classical
  let : Algebra R' A := algebraOfCoefficientRingHom q
  have hsmul : ∀ r' : R', algebraMap R' A r' = algebraMap R A (q r') := fun _ => rfl
  let : GradedAlgebra (coefficientRestrictGrade q hsmul 𝒜) :=
    gradedAlgebra_coefficientRestrictGrade q hsmul 𝒜
  let : IsStrictlyGradedComm (coefficientRestrictGrade q hsmul 𝒜) :=
    isStrictlyGradedComm_coefficientRestrictGrade q hsmul 𝒜
  let ι'' : MvPolynomial σ R' →ₐ[R'] A :=
    { ι.toRingHom.comp (MvPolynomial.map q) with
      commutes' := fun r' => by
        show ι (MvPolynomial.map q (algebraMap R' (MvPolynomial σ R') r')) = algebraMap R' A r'
        rw [MvPolynomial.algebraMap_eq, MvPolynomial.map_C, hsmul, ← MvPolynomial.algebraMap_eq,
          ι.commutes] }
  have hι'' : ∀ p' : MvPolynomial σ R', ι'' p' = ι (MvPolynomial.map q p') := fun _ => rfl
  obtain ⟨g, ⟨hg1, hg2, hg3, hg4⟩, -⟩ :=
    existsUnique_gradedDividedPowerPolynomial_map ℬ δ ι' hpolyB
      (coefficientRestrictGrade q hsmul 𝒜) (restrictDividedPowerStructure q hsmul 𝒜 γ) ι''
      (fun p' => hpoly.coefficient_mem (MvPolynomial.map q p'))
      (fun j => hpoly.generator ⟨j.1, (e j.1).symm j.2⟩)
      (fun j => hpoly.generator_mem ⟨j.1, (e j.1).symm j.2⟩)
  have hπgen : ∀ (n : ℕ) (j : hpoly.indices n),
      g (hpolyB.generator ⟨n, e n j⟩) = hpoly.generator ⟨n, j⟩ := by
    intro n j
    rw [hg2 ⟨n, e n j⟩]
    simp
  have hπdpow : ∀ (n : ℕ) (b : B), b ∈ positiveEvenPart ℬ →
      g (δ.dpow n b) = γ.dpow n (g b) := fun n b hb => hg4 n b hb
  refine ⟨g.toRingHom, ?_, g.commutes, fun p' => (hg1 p').trans (hι'' p'), hπgen, hg3, hπdpow⟩
  intro xa
  obtain ⟨S, hS⟩ := hpoly.finite_support xa
  have hle : finiteVariableStage γ ι hpoly.generator S ≤ (g.toRingHom).range := by
    refine Subring.closure_le.mpr ?_
    rintro ya (⟨p, rfl⟩ | ⟨j, -, rfl | ⟨n, rfl⟩⟩)
    · obtain ⟨p', rfl⟩ := (MvPolynomial.map_surjective q hq) p
      exact ⟨ι' p', (hg1 p').trans (hι'' p')⟩
    · exact ⟨hpolyB.generator ⟨j.1, e j.1 j.2⟩, hπgen j.1 j.2⟩
    · rcases Nat.even_or_odd (j.1 + 1) with hev | hod
      · obtain ⟨m, hm⟩ := hev
        have hposB : hpolyB.generator ⟨j.1, e j.1 j.2⟩ ∈ positiveEvenPart ℬ := by
          refine mem_positiveEvenPart_of_mem_grade ℬ (d := m) (by omega) ?_
          rw [show 2 * m = j.1 + 1 by omega]
          exact hpolyB.generator_mem ⟨j.1, e j.1 j.2⟩
        exact ⟨δ.dpow n (hpolyB.generator ⟨j.1, e j.1 j.2⟩),
          (hπdpow n _ hposB).trans (congrArg (γ.dpow n) (hπgen j.1 j.2))⟩
      · by_cases hpos : hpoly.generator j ∈ positiveEvenPart 𝒜
        · obtain ⟨k, hk⟩ := hod
          have hz : hpoly.generator j = 0 := by
            refine eq_zero_of_mem_odd_grade_of_mem_positiveEvenPart 𝒜 (k := k) ?_ hpos
            rw [show 2 * k + 1 = j.1 + 1 by omega]
            exact hpoly.generator_mem j
          rw [hz]
          rcases Nat.eq_zero_or_pos n with rfl | hn
          · exact ⟨1, by rw [γ.dpow_zero (zero_mem _), map_one]⟩
          · exact ⟨0, by rw [dpow_zero_eq_zero 𝒜 γ hn.ne', map_zero]⟩
        · exact ⟨0, by rw [γ.dpow_null hpos, map_zero]⟩
  exact hle hS

end Map

end DividedPowers.TateResolution

end
