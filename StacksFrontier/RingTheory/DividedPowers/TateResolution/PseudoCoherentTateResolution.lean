module

public import StacksFrontier.Homology.PseudoCoherent.BaseRingEquiv
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.FiniteTateResolutionOfSpanning
public import StacksFrontier.RingTheory.DividedPowers.TateResolution.PseudoCoherentSpanningCycles
public import StacksFrontier.RingTheory.PseudoCoherentMap.Presentation

/-! # Tate resolutions of a pseudo-coherent ring map

The finiteness half of Tag 09PN produces a Tate resolution with finitely many generators in each
degree for a Noetherian ring `R` and an `R`-algebra `S` of finite type. Tag 0BZ9 produces one
under the single hypothesis that `R → S` is a pseudo-coherent ring map.

Both inputs of the construction come from that hypothesis. A pseudo-coherent ring map is of
finite presentation (Stacks 0682), so for every surjection `φ : R[x₁, …, x_k] → S` (and one
exists) `ker φ` is generated by a finite family; and pseudo-coherence of `S` as a module over
`R[x₁, …, x_k]` makes every stage of the degreewise finite tower over `R[x₁, …, x_k]` have a
finite spanning family of its cycles, by
`DividedPowers.TateResolution.hasFiniteSpanningCycles_finiteTateBase_of_isModulePseudoCoherent`.
Feeding those to `DividedPowers.TateResolution.exists_finite_tateResolution_of_spanning`, which
is the construction of Tag 09PN with the spanning property as its hypothesis in place of
Noetherianness, gives the resolution.

## Main results

* `DividedPowers.TateResolution.exists_finite_tateResolution_of_pseudoCoherent_of_surjective` —
  for a pseudo-coherent ring map `R → S`, every surjection `φ : R[x₁, …, x_k] → S` extends to a
  Tate resolution of `S` having finitely many generators in each degree.
* `DividedPowers.TateResolution.exists_finite_tateResolution_of_pseudoCoherent` — a
  pseudo-coherent ring map `R → S` admits a presentation of `S` by a polynomial ring in finitely
  many variables together with a Tate resolution of `S` along it having finitely many generators
  in each degree.

## Implementation notes

The coefficient ring of the tower is the copy
`DividedPowers.TateResolution.resolutionCoefficientRing` of `R[x₁, …, x_k]` living in the
universe of the resolution, so both the pseudo-coherence of `S` and the finite generating family
of the kernel have to be carried along that identification;
`StacksDraft.PseudoCoherence.isModulePseudoCoherent_restrictScalars_of_ringEquiv` carries the
first, and the second is carried by transporting the generating family itself.

## References

* [Stacks Project, Tag 0BZ9](https://stacks.math.columbia.edu/tag/0BZ9)
* [Stacks Project, Tag 09PN](https://stacks.math.columbia.edu/tag/09PN)
-/

open StacksDraft.PseudoCoherence

@[expose] public section

namespace DividedPowers.TateResolution

universe u

attribute [local instance] HasDerivedCategory.standard

section Presentation

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] {k : ℕ}
  (φ : MvPolynomial (Fin k) R →ₐ[R] S)

/-- The presentation read on the moved copy of the polynomial ring is the presentation composed
with the identification. -/
public theorem resolutionPresentation_apply (p : resolutionCoefficientRing R S (Fin k)) :
    resolutionPresentation φ p = φ (resolutionCoefficientEquiv R S (Fin k) p) := rfl

end Presentation

section Main

/-- **A pseudo-coherent ring map admits a Tate resolution with finitely many generators in each
degree, extending any prescribed finite presentation.** If `R → S` is pseudo-coherent and
`φ : R[x₁, …, x_k] → S` is any surjection from a polynomial ring in finitely many variables, then
there is a Tate resolution `A` of `S` along `φ` (all the conclusions of Tag 09PN: a divided power
differential graded algebra over `R` with degree-zero part `R[x₁, …, x_k]` mapping onto `S` by
`φ`, a graded divided power polynomial algebra over it, augmentation a quasi-isomorphism) whose
variables are finite in number in every degree.

Pseudo-coherence makes `S` a pseudo-coherent module over `R[x₁, …, x_k]` for the given `φ`
(Stacks 0682), so every stage of the degreewise finite tower has a finite spanning family of its
cycles, and `ker φ` is finitely generated. -/
@[stacks 0BZ9 "for a prescribed presentation"]
public theorem exists_finite_tateResolution_of_pseudoCoherent_of_surjective
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [h : Algebra.PseudoCoherent R S] {k : ℕ} (φ : MvPolynomial (Fin k) R →ₐ[R] S)
    (hφ : Function.Surjective φ) :
    ∃ A : Resolution R S (Fin k) φ, ∀ i : ℕ, Finite (A.polynomialIndices i) := by
  classical
  let e := resolutionCoefficientEquiv R S (Fin k)
  let _ : Module (MvPolynomial (Fin k) R) S := Module.compHom S φ.toRingHom
  have hQ : IsModulePseudoCoherent (R := MvPolynomial (Fin k) R) S :=
    h.isModulePseudoCoherent φ hφ
  let _ : Module (resolutionCoefficientRing R S (Fin k)) S :=
    Module.compHom S (resolutionPresentation φ).toRingHom
  have hP : IsModulePseudoCoherent (R := resolutionCoefficientRing R S (Fin k)) S :=
    isModulePseudoCoherent_restrictScalars_of_ringEquiv e.toRingEquiv (ModuleCat.of _ S) hQ
  -- The kernel of the presentation is finitely generated (Stacks 0682).
  obtain ⟨t, ht⟩ : (RingHom.ker φ : Ideal (MvPolynomial (Fin k) R)).FG :=
    Algebra.FinitePresentation.ker_fG_of_surjective φ hφ
  -- Move it along the identification of the polynomial ring with its moved copy.
  let s₀ : Finset (resolutionCoefficientRing R S (Fin k)) := t.image e.symm
  have hs₀ : Ideal.span (↑s₀ : Set (resolutionCoefficientRing R S (Fin k))) =
      RingHom.ker (resolutionPresentation φ) := by
    refine le_antisymm ?_ fun x hx => ?_
    · rw [Ideal.span_le]
      rintro x hx
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hx
      refine RingHom.mem_ker.2 ?_
      rw [resolutionPresentation_apply, e.apply_symm_apply]
      exact RingHom.mem_ker.1 (ht ▸ Ideal.subset_span hy)
    · have hex : e x ∈ Ideal.span (↑t : Set (MvPolynomial (Fin k) R)) :=
        ht ▸ RingHom.mem_ker.2 (RingHom.mem_ker.1 hx)
      have hkey := Ideal.mem_map_of_mem e.symm hex
      rwa [Ideal.map_span, ← Finset.coe_image, e.symm_apply_apply] at hkey
  -- The presentation, as a linear map over the moved copy.
  let π : resolutionCoefficientRing R S (Fin k) →ₗ[resolutionCoefficientRing R S (Fin k)] S :=
    { toFun := resolutionPresentation φ
      map_add' := map_add _
      map_smul' := map_mul (resolutionPresentation φ) }
  have hkerπ : LinearMap.ker π =
      Ideal.span (↑s₀ : Set (resolutionCoefficientRing R S (Fin k))) := by
    rw [hs₀]
    exact Submodule.ext fun _ => Iff.rfl
  exact exists_finite_tateResolution_of_spanning φ hφ s₀ hs₀ fun n =>
    hasFiniteSpanningCycles_finiteTateBase_of_isModulePseudoCoherent
      (resolutionCoefficientRing R S (Fin k)) s₀ S hP π (hφ.comp e.surjective) hkerπ n

/-- **A pseudo-coherent ring map admits a Tate resolution with finitely many generators in each
degree.** If `R → S` is pseudo-coherent then there are a surjection `φ : R[x₁, …, x_k] → S` from
a polynomial ring in finitely many variables and a Tate resolution of `S` along `φ` whose
variables are finite in number in every degree.

A pseudo-coherent ring map is of finite type, so such a `φ` exists, and
`DividedPowers.TateResolution.exists_finite_tateResolution_of_pseudoCoherent_of_surjective`
extends it. -/
@[stacks 0BZ9 "existence of some finite presentation with such a resolution"]
public theorem exists_finite_tateResolution_of_pseudoCoherent
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.PseudoCoherent R S] :
    ∃ (k : ℕ) (φ : MvPolynomial (Fin k) R →ₐ[R] S) (A : Resolution R S (Fin k) φ),
      Function.Surjective φ ∧ ∀ i : ℕ, Finite (A.polynomialIndices i) := by
  obtain ⟨k, φ, hφ⟩ :=
    (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R) (S := S)).mp inferInstance
  obtain ⟨A, hA⟩ := exists_finite_tateResolution_of_pseudoCoherent_of_surjective φ hφ
  exact ⟨k, φ, A, hφ, hA⟩

end Main

end DividedPowers.TateResolution

end
