module

public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.Algebra.DividedPowers.Mul
public import StacksFrontier.RingTheory.DividedPowers.AugmentationIdeal
public import StacksFrontier.RingTheory.DividedPowers.Extend
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.Basic

/-!
# Divided powers on the divided power polynomial algebra over an arbitrary base

Let `(A, I, γ)` be a divided power ring and let `ι` index a family of variables. The *divided
power polynomial algebra* `A⟨xᵢ : i ∈ ι⟩` is `DividedPowerAlgebra A (ι →₀ A)`, and its
distinguished ideal `I A⟨x⟩ + A⟨x⟩₊`, the sum of the extension of `I` and the augmentation
ideal, is `DividedPowers.dividedPowerPolynomialIdeal`. This file puts a divided power structure
on that ideal for an arbitrary index type `ι`, normalised by `dpow n (dp A 1 m) = dp A n m` for
every `m : ι →₀ A` and not merely on the variables, and shows that a divided power structure on
that ideal is determined by its values on the variables.

The structure is glued from two pieces by `DividedPowers.existsUnique_on_ideal_add`
(Stacks 07GQ(2)). On the extension `I A⟨x⟩` of the coefficient ideal it is the flat base change
of `γ` furnished by the extension criterion
`DividedPowers.DividedPowerRing.dividedPowers_extends_of_map_eq_bot_or_isPrincipal_or_flat`
(Stacks 07H1); flatness holds because `A⟨x⟩` is free over `A` on the divided power monomials, by
`DividedPowers.dividedPowerPolynomialMonomialBasis`. On the augmentation ideal `A⟨x⟩₊` it is
the structure constructed in the first half of this file. The two agree on the intersection
because that intersection is the product of the two ideals
(`DividedPowerAlgebra.map_inf_augIdeal`) and divided powers always agree on a product
(`DividedPowers.dpow_eq_of_mem_mul`).

The divided powers on the augmentation ideal exist over an arbitrary base: this is the one point
where the torsion-free hypothesis of `DividedPowerAlgebra.augIdealDividedPowers` has to be
removed. The removal is by descent along a surjection `π : R ↠ A` from a ring `R` which is
torsion-free, taken to be `MvPolynomial A ℤ`. Writing `𝔞 := ker π`, base change
`F : Γ_R(ι →₀ R) → Γ_A(ι →₀ A)` is surjective, carries the augmentation ideal onto the
augmentation ideal, and has kernel exactly `𝔞 Γ_R(ι →₀ R)` — the last point read off from the
monomial bases of the two divided power algebras, which exist over any commutative ring. Since
`𝔞 Γ_R ⊓ Γ_R₊` is a sub-divided-power ideal of `Γ_R₊`, the structure descends through `F` by
`DividedPowers.Quotient.OfSurjective.dividedPowers`.

Uniqueness rests on the observation that `A⟨x⟩₊` is generated by the divided powers `xᵢ^[k]` of
the *variables* alone (`DividedPowerAlgebra.span_dpVariableGenerators_eq_augIdeal`), not merely
by all divided powers `dp A k m`. The prescribed values on the variables therefore determine
everything, by `DividedPowers.dpow_eq_from_gens`.

## Main definitions

* `DividedPowerAlgebra.dpVariableGenerators` — the divided powers of positive order of the
  standard basis vectors of `ι →₀ A`.
* `DividedPowerAlgebra.augIdealFinsuppDividedPowers` — divided powers on the augmentation ideal
  of `Γ_A(ι →₀ A)` over an arbitrary commutative ring `A`.

## Main results

* `DividedPowerAlgebra.span_dpVariableGenerators_eq_augIdeal` — the augmentation ideal is
  generated by the divided powers of positive order of the variables.
* `DividedPowerAlgebra.exists_dividedPowers_augIdealFinsupp_of_surjective` — descent of divided
  powers on the augmentation ideal along a surjection of base rings.
* `DividedPowerAlgebra.augIdealFinsuppDividedPowers_dpow_dp_one` — those divided powers send
  `dp A 1 m` to `dp A n m`.
* `span_union_eq_dividedPowerPolynomialIdeal` — the ideal `I A⟨x⟩ + A⟨x⟩₊` is generated by the
  image of `I` together with the divided powers of positive order of the variables.
* `dividedPowers_eq_of_dpow_variable` — a divided power structure on `I A⟨x⟩ + A⟨x⟩₊` which
  makes the coefficient map a divided power morphism is determined by its values on the
  variables.
* `exists_dividedPowers_dividedPowerPolynomialIdeal` — existence, for an arbitrary index type,
  of a divided power structure on `I A⟨x⟩ + A⟨x⟩₊` sending `dp A 1 m` to `dp A n m`.
* `dividedPowerPolynomialDividedPowers_dpow_dp_one` — the canonical structure of
  `DividedPowers.dividedPowerPolynomialDividedPowers` sends `dp A 1 m` to `dp A n m`.

## References

* [Stacks Project, Tag 07H5](https://stacks.math.columbia.edu/tag/07H5)
-/

@[expose] public section

universe u v w

namespace DividedPowerAlgebra

/-! ### The augmentation ideal is generated by divided powers of the variables -/

/-- The set of divided powers of positive order of the standard basis vectors of `ι →₀ A`, that
is, of the divided power monomials `xᵢ^[k]` in a single variable. -/
public def dpVariableGenerators (A : Type u) [CommRing A] (ι : Type w) :
    Set (DividedPowerAlgebra A (ι →₀ A)) :=
  {x | ∃ (k : ℕ) (i : ι), k ≠ 0 ∧ x = dp A k (Finsupp.single i (1 : A))}

/-- The augmentation ideal of `Γ_A(ι →₀ A)` is generated by the divided powers of positive order
of the variables alone. This refines
`DividedPowerAlgebra.span_dpGenerators_eq_augIdeal`, whose generating set uses every element of
`ι →₀ A` in place of the basis vectors. -/
public theorem span_dpVariableGenerators_eq_augIdeal (A : Type u) [CommRing A] (ι : Type w) :
    Ideal.span (dpVariableGenerators A ι) = augIdeal A (ι →₀ A) := by
  classical
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro x ⟨k, i, hk, rfl⟩
    exact dp_mem_augIdeal hk _
  · rw [← span_dpGenerators_eq_augIdeal]
    refine Ideal.span_le.mpr ?_
    rintro x ⟨n, m, hn, rfl⟩
    have hm : (∑ i ∈ m.support, (m i) • (Finsupp.single i (1 : A))) = m := by
      conv_rhs => rw [← Finsupp.sum_single m]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
    rw [SetLike.mem_coe, ← hm, dp_sum_smul]
    refine Ideal.sum_mem _ fun k hk ↦ ?_
    refine Submodule.smul_of_tower_mem _ _ ?_
    obtain ⟨i₀, hi₀⟩ : ∃ i₀, i₀ ∈ (k : Multiset ι) :=
      Multiset.exists_mem_of_ne_zero fun h ↦ hn (by simpa [h] using k.2.symm)
    have hi₀s : i₀ ∈ m.support := (Finset.mem_sym_iff.mp hk) i₀ hi₀
    have hcount : Multiset.count i₀ (k : Multiset ι) ≠ 0 := Multiset.count_ne_zero.mpr hi₀
    rw [← Finset.mul_prod_erase _ _ hi₀s]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨_, i₀, hcount, rfl⟩)

/-! ### Divided powers on the augmentation ideal over an arbitrary base -/

/-- Divided powers on the augmentation ideal of `Γ_A(ι →₀ A)`, taking `dp A 1 m` to `dp A n m`,
descend along a surjective ring map `π : R →+* A` whose source has an additively torsion-free
divided power algebra. -/
public theorem exists_dividedPowers_augIdealFinsupp_of_surjective
    {R : Type u} [CommRing R] {A : Type v} [CommRing A] {ι : Type w}
    [IsAddTorsionFree (DividedPowerAlgebra R (ι →₀ R))]
    (π : R →+* A) (hπ : Function.Surjective π) :
    ∃ γ : DividedPowers (augIdeal A (ι →₀ A)),
      ∀ (n : ℕ) (m : ι →₀ A), γ.dpow n (dp A 1 m) = dp A n m := by
  classical
  let _ : Algebra R A := π.toAlgebra
  have hπ' : (algebraMap R A : R → A) = π := by rw [π.algebraMap_toAlgebra]
  set g : (ι →₀ R) →ₗ[R] (ι →₀ A) := Finsupp.mapRange.linearMap (Algebra.linearMap R A) with hg
  have hgsingle : ∀ i : ι, g (Finsupp.single i (1 : R)) = Finsupp.single i (1 : A) := by
    intro i
    rw [hg]
    simp [Finsupp.mapRange_single, hπ']
  have hlin : Function.Surjective (⇑(Algebra.linearMap R A) : R → A) := by
    intro a
    obtain ⟨r, hr⟩ := hπ a
    exact ⟨r, by simpa [hπ'] using hr⟩
  have hgsurj : Function.Surjective g := Finsupp.mapRange_surjective _ (map_zero _) hlin
  set F : DividedPowerAlgebra R (ι →₀ R) →+* DividedPowerAlgebra A (ι →₀ A) :=
    (map A g).toRingHom with hF
  have hFdp : ∀ (n : ℕ) (m : ι →₀ R), F (dp R n m) = dp A n (g m) := fun _ _ ↦ map_apply_dp A g
  have hFalg : ∀ r : R, F (algebraMap R (DividedPowerAlgebra R (ι →₀ R)) r)
      = algebraMap A (DividedPowerAlgebra A (ι →₀ A)) (π r) := by
    intro r
    have h1 : F (algebraMap R (DividedPowerAlgebra R (ι →₀ R)) r)
        = algebraMap R (DividedPowerAlgebra A (ι →₀ A)) r := (map A g).commutes r
    rw [h1, IsScalarTower.algebraMap_apply R A (DividedPowerAlgebra A (ι →₀ A)) r, hπ']
  have hFsurj : Function.Surjective F := map_surjective (hπ' ▸ hπ) hgsurj
  have himg : F '' dpGenerators R (ι →₀ R) = dpGenerators A (ι →₀ A) := by
    ext x
    constructor
    · rintro ⟨y, ⟨n, m, hn, rfl⟩, rfl⟩
      exact ⟨n, g m, hn, hFdp n m⟩
    · rintro ⟨n, m, hn, rfl⟩
      obtain ⟨m', rfl⟩ := hgsurj m
      exact ⟨dp R n m', ⟨n, m', hn, rfl⟩, hFdp n m'⟩
  have hmap : augIdeal A (ι →₀ A) = Ideal.map F (augIdeal R (ι →₀ R)) := by
    rw [← span_dpGenerators_eq_augIdeal (R := R), Ideal.map_span, himg,
      span_dpGenerators_eq_augIdeal]
  set BR := _root_.DividedPowers.dividedPowerPolynomialMonomialBasis R ι with hBR
  set BA := _root_.DividedPowers.dividedPowerPolynomialMonomialBasis A ι with hBA
  have hFB : ∀ k : ι →₀ ℕ, F (BR k) = BA k := by
    intro k
    rw [hBR, hBA, _root_.DividedPowers.dividedPowerPolynomialMonomialBasis_apply,
      _root_.DividedPowers.dividedPowerPolynomialMonomialBasis_apply,
      _root_.DividedPowers.dividedPowerPolynomialMonomial,
      _root_.DividedPowers.dividedPowerPolynomialMonomial,
      Finsupp.prod, Finsupp.prod, map_prod]
    exact Finset.prod_congr rfl fun i _ ↦ by rw [hFdp, hgsingle]
  have hker : RingHom.ker F
      = Ideal.map (algebraMap R (DividedPowerAlgebra R (ι →₀ R))) (RingHom.ker π) := by
    refine le_antisymm ?_ ?_
    · intro x hx
      set c := BR.repr x with hc
      set c' : (ι →₀ ℕ) →₀ A := Finsupp.mapRange π (map_zero π) c with hc'
      have hsub : c'.support ⊆ c.support := by rw [hc']; exact Finsupp.support_mapRange
      have hcomb : F (Finsupp.linearCombination R (BR : (ι →₀ ℕ) → _) c)
          = Finsupp.linearCombination A (BA : (ι →₀ ℕ) → _) c' := by
        rw [Finsupp.linearCombination_apply, Finsupp.linearCombination_apply,
          Finsupp.sum_of_support_subset _ hsub _ (by simp), Finsupp.sum, map_sum]
        refine Finset.sum_congr rfl fun k _ ↦ ?_
        rw [Algebra.smul_def, Algebra.smul_def, map_mul, hFB, hFalg, hc',
          Finsupp.mapRange_apply]
      have h0 : Finsupp.linearCombination A (BA : (ι →₀ ℕ) → _) c' = 0 := by
        rwa [← hcomb, hc, BR.linearCombination_repr]
      have hc'0 : c' = 0 := by
        have h1 := BA.repr_linearCombination c'
        rw [h0, map_zero] at h1
        exact h1.symm
      have hcoord : ∀ k, c k ∈ RingHom.ker π := by
        intro k
        have h2 : c' k = 0 := by rw [hc'0]; rfl
        rw [hc', Finsupp.mapRange_apply] at h2
        exact h2
      rw [← BR.linearCombination_repr x, ← hc, Finsupp.linearCombination_apply, Finsupp.sum]
      refine Ideal.sum_mem _ fun k _ ↦ ?_
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hcoord k))
    · rw [Ideal.map_le_iff_le_comap]
      intro r hr
      simp only [Ideal.mem_comap, RingHom.mem_ker, hFalg]
      rw [RingHom.mem_ker.mp hr, map_zero]
  have hIf : augIdealDividedPowers.IsSubDPIdeal (RingHom.ker F ⊓ augIdeal R (ι →₀ R)) := by
    rw [hker]
    exact isSubDPIdeal_map_inf_augIdeal _ _
  refine ⟨DividedPowers.Quotient.OfSurjective.dividedPowers augIdealDividedPowers hFsurj
    hmap hIf, fun n m ↦ ?_⟩
  obtain ⟨m', rfl⟩ := hgsurj m
  rw [← hFdp 1 m', DividedPowers.Quotient.OfSurjective.dpow_apply augIdealDividedPowers hFsurj
    hmap hIf (dp_mem_augIdeal one_ne_zero m'), dpow_dp_one, hFdp]

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- Divided powers on the augmentation ideal of `Γ_A(ι →₀ A)` taking `dp A 1 m` to `dp A n m`
exist over an arbitrary commutative ring `A`. The base is presented as a quotient of
`MvPolynomial A ℤ`, which is a free `ℤ`-module, hence additively torsion-free, so that
`DividedPowerAlgebra.augIdealDividedPowers` applies to it. -/
public theorem exists_dividedPowers_augIdealFinsupp (A : Type u) [CommRing A] (ι : Type w) :
    ∃ γ : DividedPowers (augIdeal A (ι →₀ A)),
      ∀ (n : ℕ) (m : ι →₀ A), γ.dpow n (dp A 1 m) = dp A n m := by
  have hinj : Function.Injective (algebraMap (MvPolynomial A ℤ) (MvPolynomial A ℚ)) :=
    MvPolynomial.map_injective _ Int.cast_injective
  have htf : IsAddTorsionFree
      (DividedPowerAlgebra (MvPolynomial A ℤ) (ι →₀ MvPolynomial A ℤ)) :=
    (basisDPMonomialFinsupp (ι := ι) (MvPolynomial A ℤ) (MvPolynomial A ℚ) hinj).isAddTorsionFree
  have hsurj : Function.Surjective
      ((MvPolynomial.aeval (id : A → A)).toRingHom : MvPolynomial A ℤ →+* A) :=
    fun a ↦ ⟨MvPolynomial.X a, by simp⟩
  exact exists_dividedPowers_augIdealFinsupp_of_surjective _ hsurj

/-- The divided power structure on the augmentation ideal of `Γ_A(ι →₀ A)`, over an arbitrary
commutative ring `A`. -/
public noncomputable def augIdealFinsuppDividedPowers (A : Type u) [CommRing A] (ι : Type w) :
    DividedPowers (augIdeal A (ι →₀ A)) :=
  (exists_dividedPowers_augIdealFinsupp A ι).choose

/-- The divided powers on the augmentation ideal of `Γ_A(ι →₀ A)` send `dp A 1 m` to
`dp A n m`. -/
public theorem augIdealFinsuppDividedPowers_dpow_dp_one (A : Type u) [CommRing A] (ι : Type w)
    (n : ℕ) (m : ι →₀ A) :
    (augIdealFinsuppDividedPowers A ι).dpow n (dp A 1 m) = dp A n m :=
  (exists_dividedPowers_augIdealFinsupp A ι).choose_spec n m

end DividedPowerAlgebra

/-! ### The divided power polynomial algebra -/

/-- The distinguished ideal of the divided power polynomial algebra is the sum of the extension of
the coefficient ideal and the augmentation ideal. -/
private theorem dividedPowerPolynomialIdeal_eq_sup {A : Type u} [CommRing A] (I : Ideal A)
    (ι : Type w) :
    DividedPowers.dividedPowerPolynomialIdeal I ι =
      Ideal.map (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) I
        ⊔ DividedPowerAlgebra.augIdeal A (ι →₀ A) :=
  rfl

/-- The extension of the coefficient ideal is contained in the distinguished ideal of the
divided power polynomial algebra. -/
public theorem map_le_dividedPowerPolynomialIdeal {A : Type u} [CommRing A] (I : Ideal A)
    (ι : Type w) :
    Ideal.map (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) I
      ≤ DividedPowers.dividedPowerPolynomialIdeal I ι := by
  rw [dividedPowerPolynomialIdeal_eq_sup]
  exact le_sup_left

/-- The augmentation ideal is contained in the distinguished ideal of the divided power
polynomial algebra. -/
public theorem augIdeal_le_dividedPowerPolynomialIdeal {A : Type u} [CommRing A] (I : Ideal A)
    (ι : Type w) :
    DividedPowerAlgebra.augIdeal A (ι →₀ A) ≤ DividedPowers.dividedPowerPolynomialIdeal I ι := by
  rw [dividedPowerPolynomialIdeal_eq_sup]
  exact le_sup_right

/-- The distinguished ideal of the divided power polynomial algebra is generated by the image of
the coefficient ideal together with the divided powers of positive order of the variables. -/
public theorem span_union_eq_dividedPowerPolynomialIdeal {A : Type u} [CommRing A] (I : Ideal A)
    (ι : Type w) :
    DividedPowers.dividedPowerPolynomialIdeal I ι =
      Ideal.span ((algebraMap A (DividedPowerAlgebra A (ι →₀ A))) '' (I : Set A)
        ∪ DividedPowerAlgebra.dpVariableGenerators A ι) := by
  rw [dividedPowerPolynomialIdeal_eq_sup, Ideal.span_union,
    DividedPowerAlgebra.span_dpVariableGenerators_eq_augIdeal, Ideal.map]

/-- Any divided power structure on `I A⟨x⟩ + A⟨x⟩₊` whose values on the variables are the
distinguished divided power monomials is determined on every divided power monomial `xᵢ^[j]` of
a single variable. -/
public theorem dpow_dp_single_of_dpow_variable (A : DividedPowerRing.{u}) (ι : Type w)
    (δ : DividedPowers (DividedPowers.dividedPowerPolynomialIdeal A.ideal ι))
    (hvar : ∀ (i : ι) (n : ℕ),
      δ.dpow n (DividedPowerAlgebra.dp A 1 (Finsupp.single i 1))
        = DividedPowerAlgebra.dp A n (Finsupp.single i 1))
    (n j : ℕ) (i : ι) (hj : j ≠ 0) :
    δ.dpow n (DividedPowerAlgebra.dp A j (Finsupp.single i 1))
      = (Nat.uniformBell n j : DividedPowerAlgebra A (ι →₀ A))
        * DividedPowerAlgebra.dp A (n * j) (Finsupp.single i 1) := by
  have hmem : DividedPowerAlgebra.dp A 1 (Finsupp.single i (1 : A))
      ∈ DividedPowers.dividedPowerPolynomialIdeal A.ideal ι :=
    augIdeal_le_dividedPowerPolynomialIdeal A.ideal ι
      (DividedPowerAlgebra.dp_mem_augIdeal one_ne_zero _)
  rw [← hvar i j, δ.dpow_comp hj hmem, hvar i (n * j)]

/-- Two divided power structures on `I A⟨x⟩ + A⟨x⟩₊` which take the prescribed values on the
variables and both make the coefficient map a divided power morphism are equal. -/
public theorem dividedPowers_eq_of_dpow_variable (A : DividedPowerRing.{u}) (ι : Type w)
    (δ δ' : DividedPowers (DividedPowers.dividedPowerPolynomialIdeal A.ideal ι))
    (hvar : ∀ (i : ι) (n : ℕ),
      δ.dpow n (DividedPowerAlgebra.dp A 1 (Finsupp.single i 1))
        = DividedPowerAlgebra.dp A n (Finsupp.single i 1))
    (hvar' : ∀ (i : ι) (n : ℕ),
      δ'.dpow n (DividedPowerAlgebra.dp A 1 (Finsupp.single i 1))
        = DividedPowerAlgebra.dp A n (Finsupp.single i 1))
    (hcoeff : DividedPowers.IsDPMorphism A.dividedPowers δ
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A))))
    (hcoeff' : DividedPowers.IsDPMorphism A.dividedPowers δ'
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A)))) :
    δ' = δ := by
  refine DividedPowers.dpow_eq_from_gens δ δ'
    (span_union_eq_dividedPowerPolynomialIdeal A.ideal ι) ?_
  intro n x hx
  rcases hx with ⟨a, ha, rfl⟩ | ⟨j, i, hj, rfl⟩
  · rw [hcoeff.dpow_comp a ha, hcoeff'.dpow_comp a ha]
  · rw [dpow_dp_single_of_dpow_variable A ι δ hvar n j i hj,
      dpow_dp_single_of_dpow_variable A ι δ' hvar' n j i hj]

/-- The distinguished ideal of the divided power polynomial algebra carries a divided power
structure which makes the coefficient map a divided power morphism and sends `dp A 1 m` to
`dp A n m`. -/
public theorem exists_dividedPowers_dividedPowerPolynomialIdeal (A : DividedPowerRing.{u})
    (ι : Type w) :
    ∃ ε : DividedPowers (DividedPowers.dividedPowerPolynomialIdeal A.ideal ι),
      DividedPowers.IsDPMorphism A.dividedPowers ε
          (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) ∧
        ∀ (n : ℕ) (m : ι →₀ A),
          ε.dpow n (DividedPowerAlgebra.dp A 1 m) = DividedPowerAlgebra.dp A n m := by
  have hfree : Module.Free A (DividedPowerAlgebra A (ι →₀ A)) :=
    Module.Free.of_basis (_root_.DividedPowers.dividedPowerPolynomialMonomialBasis A ι)
  have hflat : (algebraMap A (DividedPowerAlgebra A (ι →₀ A))).Flat :=
    RingHom.flat_algebraMap_iff.mpr Module.Flat.of_free
  obtain ⟨γ₁, hγ₁m⟩ :=
    DividedPowers.DividedPowerRing.dividedPowers_extends_of_map_eq_bot_or_isPrincipal_or_flat A
      (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) (Or.inr (Or.inr hflat))
  set γ₂ := DividedPowerAlgebra.augIdealFinsuppDividedPowers A ι with hγ₂
  have hagree : ∀ (n : ℕ) {x : DividedPowerAlgebra A (ι →₀ A)},
      x ∈ Ideal.map (algebraMap A (DividedPowerAlgebra A (ι →₀ A))) A.ideal
        ⊓ DividedPowerAlgebra.augIdeal A (ι →₀ A) → γ₁.dpow n x = γ₂.dpow n x := by
    intro n x hx
    rw [DividedPowerAlgebra.map_inf_augIdeal, Ideal.smul_eq_mul] at hx
    exact (DividedPowers.dpow_eq_of_mem_mul γ₂ γ₁ hx n).symm
  obtain ⟨ε, hε, -⟩ := DividedPowers.existsUnique_on_ideal_add γ₁ γ₂ hagree
  refine ⟨ε, ⟨map_le_dividedPowerPolynomialIdeal A.ideal ι, ?_⟩, ?_⟩
  · intro n a ha
    rw [hε.1 n (Ideal.mem_map_of_mem _ ha), hγ₁m.dpow_comp a ha]
  · intro n m
    rw [hε.2 n (DividedPowerAlgebra.dp_mem_augIdeal one_ne_zero m), hγ₂,
      DividedPowerAlgebra.augIdealFinsuppDividedPowers_dpow_dp_one]

/-- The canonical divided powers of `DividedPowers.dividedPowerPolynomialDividedPowers` send
`dp A 1 m` to `dp A n m`, for every `m : ι →₀ A`. -/
public theorem dividedPowerPolynomialDividedPowers_dpow_dp_one (A : DividedPowerRing.{u})
    (ι : Type w) [Finite ι] (n : ℕ) (m : ι →₀ A) :
    (DividedPowers.dividedPowerPolynomialDividedPowers A ι).dpow n
        (DividedPowerAlgebra.dp A 1 m)
      = DividedPowerAlgebra.dp A n m := by
  have hspec := (exists_dividedPowers_dividedPowerPolynomialIdeal A ι).choose_spec
  rw [← DividedPowers.dividedPowerPolynomialDividedPowers_unique A ι
    (exists_dividedPowers_dividedPowerPolynomialIdeal A ι).choose
    (fun i k ↦ hspec.2 k (Finsupp.single i 1)) hspec.1]
  exact hspec.2 n m

/-- The coefficient morphism acts as the structure map of the algebra. -/
@[simp]
public theorem dividedPowerPolynomialCoefficientDPMorphism_apply (A : DividedPowerRing.{u})
    (ι : Type w) [Finite ι] (a : A) :
    DividedPowers.dividedPowerPolynomialCoefficientDPMorphism A ι a
      = algebraMap A (DividedPowerAlgebra A (ι →₀ A)) a :=
  rfl

end
