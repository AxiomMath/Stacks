namespace Stacks.Flatness.NormalFibreAscent

open Algebra TensorProduct

/-! ### Regularity ascent along a flat local homomorphism -/

/-! ### The fibre ring -/

section Fiber

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- The fibre ring of a Noetherian ring is Noetherian: it is a quotient of a localization. -/
theorem isNoetherianRing_fiber {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [IsNoetherianRing S] (p : Ideal R) [p.IsPrime] : IsNoetherianRing (p.Fiber S) := by
  have : IsNoetherianRing (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) :=
    inferInstance
  exact isNoetherianRing_of_ringEquiv _ (Ideal.Fiber.algEquivQuotient p).toRingEquiv.symm

end Fiber

/-- The localization of the fibre ring `κ(𝔭) ⊗_R S` at a prime `Q` contracting to `𝔮 ⊆ S` is the
closed fibre `S_𝔮 / 𝔭 S_𝔮`. -/
theorem nonempty_ringEquiv_localization_fiber {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (p : Ideal R) [p.IsPrime] (Q : Ideal (p.Fiber S)) [Q.IsPrime]
    (q : Ideal S) [q.IsPrime] (hq : Q.comap (includeRight : S →ₐ[R] p.Fiber S) = q) :
    Nonempty (Localization.AtPrime Q ≃+*
      Localization.AtPrime q ⧸
        Ideal.map (algebraMap S (Localization.AtPrime q)) (Ideal.map (algebraMap R S) p)) := by
  subst hq
  exact ⟨(Ideal.Fiber.algEquivAux₂ p Q).toRingEquiv⟩

/-! ### Serre's condition `(R_k)` ascends along a flat ring map (Stacks 033A) -/

/-- Under `(R_k)` for the fibre rings, the closed fibre `S_𝔮/𝔭S_𝔮` over `𝔭 = φ^{-1}(𝔮)` is regular
when `𝔮/𝔭S` has height `≤ k`. -/
private theorem isRegularLocalRing_closedFibre_of_fiber {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [Algebra R S] {k : ℕ}
    (hfib : ∀ (p : Ideal R) [p.IsPrime] (Q : Ideal (p.Fiber S)) [Q.IsPrime],
      Q.height ≤ (k : ℕ∞) → IsRegularLocalRing (Localization.AtPrime Q))
    (q : Ideal S) [q.IsPrime]
    (hfk : (Ideal.map (Ideal.Quotient.mk
      (Ideal.map (algebraMap R S) (q.comap (algebraMap R S)))) q).height ≤ (k : ℕ∞)) :
    IsRegularLocalRing
      ((Localization.AtPrime q) ⧸
        Ideal.map (algebraMap S (Localization.AtPrime q))
          (Ideal.map (algebraMap R S) (q.comap (algebraMap R S)))) := by
  classical
  set p : Ideal R := q.comap (algebraMap R S)
  have : p.IsPrime := inferInstance
  have : q.LiesOver p := ⟨rfl⟩
  have hq_mem : q ∈ p.primesOver S := ⟨‹_›, ‹q.LiesOver p›⟩
  set P : PrimeSpectrum (p.Fiber S) :=
    PrimeSpectrum.primesOverOrderIsoFiber R S p ⟨q, hq_mem⟩ with hP_def
  have : P.asIdeal.IsPrime := P.isPrime
  have hrq : P.asIdeal.comap (includeRight : S →ₐ[R] p.Fiber S) = q := by
    refine SetLike.ext' ?_
    rw [Ideal.coe_comap,
      ← PrimeSpectrum.coe_primesOverOrderIsoFiber_symm_apply_coe (R := R) (S := S) (p := p) P]
    exact congrArg (fun (x : p.primesOver S) => ((x : Ideal S) : Set S))
      ((PrimeSpectrum.primesOverOrderIsoFiber R S p).symm_apply_apply ⟨q, hq_mem⟩)
  obtain ⟨hiso⟩ := nonempty_ringEquiv_localization_fiber p P.asIdeal q hrq
  set pS : Ideal S := Ideal.map (algebraMap R S) p with hpS_def
  have hpSq : pS ≤ q := by
    rw [hpS_def, Ideal.map_le_iff_le_comap]
  set qbar : Ideal (S ⧸ pS) := Ideal.map (Ideal.Quotient.mk pS) q with hqbar_def
  have hqbar_prime : qbar.IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
  have : IsLocalization (algebraMapSubmonoid (S ⧸ pS) q.primeCompl)
      ((Localization.AtPrime q) ⧸ pS.map (algebraMap S (Localization.AtPrime q))) :=
    IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
      q.primeCompl (Localization.AtPrime q) pS
  have hqbar_lo : qbar.LiesOver q := by
    refine ⟨?_⟩
    rw [hqbar_def, Ideal.under_def, Ideal.Quotient.algebraMap_eq,
      Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact (sup_eq_left.mpr hpSq).symm
  have hsubmonoid : algebraMapSubmonoid (S ⧸ pS) q.primeCompl = qbar.primeCompl :=
    Ideal.algebraMapSubmonoid_primeCompl_of_liesOver_surjective qbar q
      Ideal.Quotient.mk_surjective
  have : IsLocalization.AtPrime
      ((Localization.AtPrime q) ⧸ pS.map (algebraMap S (Localization.AtPrime q))) qbar := by
    rw [IsLocalization.AtPrime, ← hsubmonoid]
    infer_instance
  have hheight : P.asIdeal.height ≤ (k : ℕ∞) := by
    have h1 : (ringKrullDim (Localization.AtPrime P.asIdeal) : WithBot ℕ∞)
        = (P.asIdeal.height : ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height P.asIdeal (Localization.AtPrime P.asIdeal)
    have h2 : ringKrullDim (Localization.AtPrime P.asIdeal)
        = ringKrullDim ((Localization.AtPrime q) ⧸
            pS.map (algebraMap S (Localization.AtPrime q))) :=
      ringKrullDim_eq_of_ringEquiv hiso
    have h3 : (ringKrullDim ((Localization.AtPrime q) ⧸
          pS.map (algebraMap S (Localization.AtPrime q))) : WithBot ℕ∞)
        = (qbar.height : ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height qbar _
    have heq : (P.asIdeal.height : WithBot ℕ∞) = (qbar.height : ℕ∞) := by
      rw [← h1, h2, h3]
    have hcast : (P.asIdeal.height : ℕ∞) = qbar.height := by exact_mod_cast heq
    exact hcast ▸ hfk
  exact (hfib p P.asIdeal hheight).of_ringEquiv hiso

/-- Let `R → S` be flat and `𝔭 = φ^{-1}(𝔮)`. If `R_𝔭` and the closed fibre `S_𝔮/𝔭S_𝔮` are regular,
then so is `S_𝔮`. -/
private theorem isRegularLocalRing_atPrime_of_regular_closedFibre {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [Algebra R S]
    [IsNoetherianRing R] [IsNoetherianRing S] [Module.Flat R S] (q : Ideal S) [q.IsPrime]
    (hRp : IsRegularLocalRing (Localization.AtPrime (q.comap (algebraMap R S))))
    (hClosedFibreReg : IsRegularLocalRing
      ((Localization.AtPrime q) ⧸
        Ideal.map (algebraMap S (Localization.AtPrime q))
          (Ideal.map (algebraMap R S) (q.comap (algebraMap R S))))) :
    IsRegularLocalRing (Localization.AtPrime q) := by
  set p : Ideal R := q.comap (algebraMap R S) with hp
  let algRpSq : Algebra (Localization.AtPrime p) (Localization.AtPrime q) :=
    (Localization.localRingHom p q (algebraMap R S) hp).toAlgebra
  have hAM : algebraMap (Localization.AtPrime p) (Localization.AtPrime q)
      = Localization.localRingHom p q (algebraMap R S) hp := rfl
  have hST : IsScalarTower R (Localization.AtPrime p) (Localization.AtPrime q) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    rw [hAM, Localization.localRingHom_to_map, ← IsScalarTower.algebraMap_apply]
  have hFlat : Module.Flat (Localization.AtPrime p) (Localization.AtPrime q) :=
    inferInstance
  have hLocalHom : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) := by
    rw [hAM]
    infer_instance
  have hST2 : IsScalarTower R S (Localization.AtPrime q) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hidealeq :
      Ideal.map (algebraMap (Localization.AtPrime p) (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime p))
      = Ideal.map (algebraMap S (Localization.AtPrime q)) (Ideal.map (algebraMap R S) p) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
      ← IsScalarTower.algebraMap_eq R (Localization.AtPrime p) (Localization.AtPrime q),
      IsScalarTower.algebraMap_eq R S (Localization.AtPrime q),
      ← Ideal.map_map]
  rw [← hidealeq] at hClosedFibreReg
  exact isRegularLocalRing_of_flat_of_regular_closedFibre
    (Localization.AtPrime p) (Localization.AtPrime q) hRp hClosedFibreReg

/-- **Stacks Tag 033A**, in the form needed here: let `R → S` be a flat ring map of Noetherian
rings and `k ≥ 0`. If every fibre ring `κ(𝔭) ⊗_R S` has property `(R_k)` and `R` has `(R_k)`,
then `S` has `(R_k)`. -/
private theorem isRegularLocalRing_atPrime_of_flat_of_fiber {R : Type u} {S : Type v}
    [CommRing R] [CommRing S] [Algebra R S]
    [IsNoetherianRing R] [IsNoetherianRing S] [Module.Flat R S] {k : ℕ}
    (hfib : ∀ (p : Ideal R) [p.IsPrime] (Q : Ideal (p.Fiber S)) [Q.IsPrime],
      Q.height ≤ (k : ℕ∞) → IsRegularLocalRing (Localization.AtPrime Q))
    (hR : ∀ (p : Ideal R) [p.IsPrime],
      p.height ≤ (k : ℕ∞) → IsRegularLocalRing (Localization.AtPrime p))
    (q : Ideal S) [q.IsPrime] (hq : q.height ≤ (k : ℕ∞)) :
    IsRegularLocalRing (Localization.AtPrime q) := by
  have : Algebra.HasGoingDown R S := Algebra.HasGoingDown.of_flat
  set p : Ideal R := q.comap (algebraMap R S)
  have : p.IsPrime := inferInstance
  have : q.LiesOver p := ⟨rfl⟩
  have hform := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown p q
  exact isRegularLocalRing_atPrime_of_regular_closedFibre q (hR p (hq.trans' (hform ▸ le_self_add)))
    (isRegularLocalRing_closedFibre_of_fiber hfib q (hq.trans' (hform ▸ le_add_self)))

/-! ### The main statement -/

/-- Serre's criterion for normality (Lemma 031S) read through the library's `IsNormalRing`: that
predicate is by definition the "every localization at a prime is an integrally closed domain"
condition which 031S writes out, so this is 031S itself. -/
@[sga "2 XI 3.11" "more general"]
private theorem isNormalRing_iff_isRegularLocalRing_and_min_two_le_depth
    {A : Type*} [CommRing A] [IsNoetherianRing A] :
    IsNormalRing A ↔
      (∀ (p : Ideal A) [p.IsPrime], p.height ≤ 1 →
          IsRegularLocalRing (Localization.AtPrime p)) ∧
        ∀ (p : Ideal A) [p.IsPrime],
          min 2 (ringKrullDim (Localization.AtPrime p)) ≤
            (Module.depth (Localization.AtPrime p)
              (IsLocalRing.maximalIdeal (Localization.AtPrime p))
              (Localization.AtPrime p) : WithBot ℕ∞) :=
  isNormalRing_iff.trans
    isDomain_and_isIntegrallyClosed_atPrime_iff_isRegularLocalRing_and_min_two_le_depth

/-- Let `R → S` be a flat ring map of Noetherian rings. If `R` is a normal ring and every fibre
ring `κ(𝔭) ⊗_R S` is a normal ring, then `S` is a normal ring. -/
@[ega "IV 6.5.4" "(ii), special case"]
public theorem solution {R : Type u} {S : Type v} [CommRing R]
    [CommRing S] [Algebra R S] [IsNoetherianRing R] [IsNoetherianRing S] [Module.Flat R S]
    (hR : IsNormalRing R) (hfibre : ∀ (p : Ideal R) [p.IsPrime], IsNormalRing (p.Fiber S)) :
    IsNormalRing S := by
  obtain ⟨hR1, hR2⟩ := isNormalRing_iff_isRegularLocalRing_and_min_two_le_depth.mp hR
  have hfib (p : Ideal R) [p.IsPrime] :=
    have := isNoetherianRing_fiber (S := S) p
    isNormalRing_iff_isRegularLocalRing_and_min_two_le_depth.mp (hfibre p)
  refine isNormalRing_iff_isRegularLocalRing_and_min_two_le_depth.mpr
    ⟨fun q _ hq => ?_, fun q _ => ?_⟩
  · -- `(R_1)` for `S`, by Lemma 033A at `k = 1`.
    refine isRegularLocalRing_atPrime_of_flat_of_fiber (k := 1) (fun p _ Q _ hQ => ?_)
      (fun p _ hp => hR1 p (by simpa using hp)) q (by simpa using hq)
    exact (hfib p).1 Q (by simpa using hQ)
  · -- `(S_2)` for `S`, by Lemma 0339 at `k = 2`.
    simpa using min_le_depth_atPrime_of_flat (R := R) (S := S) (k := 2)
      (fun p _ Q _ => by simpa using (hfib p).2 Q)
      (fun p _ => by simpa using hR2 p) q

end Stacks.Flatness.NormalFibreAscent

end

/-!
# Normality ascends along a flat ring map with normal fibres

A commutative ring `A` is a *normal ring* (Definition 00GV) when the localization `A_𝔮` is a
normal domain — a domain integrally closed in its fraction field — for every prime `𝔮` of `A`.
Let `φ : R → S` be a flat ring map of Noetherian rings. If `R` is a normal ring and every fibre
ring `κ(𝔭) ⊗_R S`, `𝔭` a prime of `R`, is a normal ring, then `S` is a normal ring.

The source's proof. For a Noetherian ring, being normal is the conjunction of Serre's conditions
`(S_2)` and `(R_1)` (Lemma 031S, Serre's criterion). The hypotheses therefore say that `R` and all
the fibre rings have `(S_2)` and `(R_1)`, and both of these properties ascend along a flat map of
Noetherian rings whose fibres have the property — `(S_2)` by Lemma 0339 and `(R_1)` by Lemma 033A
— so `S` has `(S_2)` and `(R_1)`, that is `S` is normal by Lemma 031S again. This is the normal
analogue of Lemma 0C21, which runs the same argument with `(S_1)` and `(R_0)` in place of `(S_2)`
and `(R_1)`, and reducedness in place of normality.

## Main results

* `isNormalRing_of_flat_of_isNormalRing_fiber`: a flat ring map of Noetherian rings with normal
  source and normal fibre rings has normal target.

## Implementation notes

The ring map is an `Algebra R S` instance, so `φ` is `algebraMap R S` and flatness is
`Module.Flat R S`, as in the companion statements 0C21, 0339 and 045J. Normality is the library's
`IsNormalRing` (Definition 00GV), the spelling used by tags 037Z, 0380 and 06DF; it is by
definition the condition `∀ 𝔮, IsDomain (Localization.AtPrime 𝔮) ∧ IsIntegrallyClosed
(Localization.AtPrime 𝔮)` that item (1) of tag 030C, tag 031S and tag 033G write out, so Serre's
criterion 031S applies to the hypothesis and the conclusion here by `Iff.rfl`. The `IsDomain`
conjunct is genuine content: `IsIntegrallyClosed` is Mathlib's `IsIntegrallyClosedIn A
(FractionRing A)`, which carries no domain hypothesis. `IsNormalRing` is a plain predicate rather
than a class, so normality of `R` is an explicit hypothesis while the Noetherian and flatness
hypotheses are instances.

The fibre ring is Mathlib's `Ideal.Fiber 𝔭 S`, that is `κ(𝔭) ⊗[R] S` for
`κ(𝔭) = Ideal.ResidueField 𝔭` the residue field of `Localization.AtPrime 𝔭`; the source writes
`S ⊗_R κ(𝔭)`, the same ring by `Algebra.TensorProduct.comm`. Primes `𝔭` outside the image of
`Spec S → Spec R` constrain nothing, their fibre ring being zero, which is a normal ring for want
of primes. No Noetherian hypothesis on the fibre ring is needed: it is a quotient of a
localization of `S` by `Ideal.Fiber.algEquivQuotient`, hence Noetherian for free.

Mathlib has no predicate for a normal ring and no ascent of normality along a flat map: its
flat-descent lemmas of this shape are the reduced ones,
`AlgebraicGeometry.GeometricallyReduced.isReduced_of_flat_of_isLocallyNoetherian` and
`…isReduced_of_flat_of_finite_irreducibleComponents`, and `Mathlib.AlgebraicGeometry.Geometrically`
has `Reduced`, `Integral` and `Irreducible` but no `Normal`. Neither implies this statement: a
normal ring need not be geometrically normal over a residue field, and the conclusion here is
integral closedness of every localization, not reducedness.

Faithfulness to [StacksProject 0C22]:

1. No dead hypothesis. Flatness (3) is used: for `R = k[t]` and `S = k[t]/(t²)` both rings are
   Noetherian, `R` is normal, and every fibre ring is normal — `k` over `(t)`, and the zero ring
   over every other prime, `t` being invertible there — yet `S` is not normal, not even reduced;
   the map is not flat, `S` being `t`-torsion. Hypothesis (4) is used: `k → k[x, y]/(y² - x³)`,
   the cusp, is flat over the field `k` with `k` normal and Noetherian, and its single fibre ring
   is the cusp itself, a domain that is not integrally closed, so its target is not normal.
   Hypothesis (5) is used: the identity map of that same cusp `R` is flat, both Noetherian, and
   each fibre ring is a residue field `κ(𝔭)` hence normal, yet `R` is not normal. Both Noetherian
   hypotheses are used where the source uses them: Serre's criterion 031S, the equivalence of
   normality with `(S_2) + (R_1)`, holds for Noetherian rings, and the ascent Lemmas 0339 and 033A
   need the Noetherian hypothesis on `R` for additivity of height along a flat map (Lemma 00ON)
   and on `S` for depth (Lemma 0337).
2. The scalars and base are the source's. Flatness is that of `S` as an `R`-module along
   `algebraMap R S`, with no localization interposed, and the fibre ring is formed over `R` at
   `κ(𝔭)`, not over a localization of `R` nor after a field extension of `κ(𝔭)`: normal fibres,
   not geometrically normal ones.
3. The maps are pinned, not merely assumed to exist: `φ` is `algebraMap R S` of the `Algebra R S`
   instance, `Module.Flat R S` is flatness for that same `R`-module structure, the fibre is
   `Ideal.Fiber 𝔭 S` with its canonical `R`-algebra structure, and normality is read on the
   canonical local rings `Localization.AtPrime 𝔮` with their canonical algebra structures. So the
   hypotheses are about the fibres of `φ` itself and about the localizations of the rings at hand,
   not about rings with the same invariants.
4. The instantiation is not degenerate. `R = ℚ[x] → S = ℚ[x, y]` satisfies every hypothesis, `S`
   being free hence flat over `R`, both rings Noetherian, `R` normal and each fibre ring `κ(𝔭)[y]`
   a normal domain; the conclusion, that `ℚ[x, y]` is normal, is true and not vacuous. Content
   beyond the smooth case of Lemma 033C is `R = k[t] → S = k[t][x, y, z]/(xy - z²)`, free over `R`
   with fibre rings the quadric cones `κ(𝔭)[x, y, z]/(xy - z²)`, which are normal but not regular
   at the origin. Content beyond the reduced Lemma 0C21 is the cusp of item 1, reduced everywhere
   and normal nowhere at its singular point.

