module

public import StacksFrontier.RingTheory.Flat.DevissageProjectiveStages
public import StacksFrontier.RingTheory.Flat.DevissageTail
public import StacksFrontier.RingTheory.Flat.UniversallyInjectiveLocalize
public import StacksFrontier.RingTheory.Module.Kaplansky

/-!
# Projectivity and freeness from a complete dévissage

Let `N` be a finite module over a finite type `R`-algebra `S`, with a complete dévissage
`Module.CompleteDevissage` of `N/S/R` over a prime of `R`. If the maps `alpha i` of the dévissage
are injective, then `N` is a direct sum of finite free modules over the stage algebras, hence
projective over `R`. Over a local ring `R`, with `N` flat over `R` and the dévissage over the
maximal ideal, the maps `alpha i` are injective, and `N` is moreover free over `R`.

## Main results

* `Algebra.projective_of_smooth_of_geometricallyIrreducible`: a smooth algebra with
  geometrically irreducible fibres is projective over its base.
* `Algebra.comap_closedFiberIdeal`: over a local ring `R`, if the ideal `𝔪B` of an `R`-algebra
  `B` is prime, then it contracts to the maximal ideal `𝔪`.
* `Module.flat_coker_of_flat_of_projective_finsupp`: over a local base, the cokernel of a map
  from a finite free module to a flat module, bijective on the closed fibre, is flat.
* `Module.CompleteDevissage.projective_of_injective_alpha` and
  `Module.CompleteDevissage.free_of_injective_alpha_of_isLocalRing`: a module with a complete
  dévissage whose maps `alpha i` are injective is projective, and free over a local base.
* `Module.CompleteDevissage.flat_stageModule`: over a local base, flatness of `N` propagates
  to every stage module of a complete dévissage over the maximal ideal.
* `Module.CompleteDevissage.injective_alpha_of_flat`: over a local base, flatness of `N` makes
  every map `alpha i` of a complete dévissage over the maximal ideal injective.
* `Module.CompleteDevissage.nonempty_linearEquiv_directSum_of_flat`,
  `Module.CompleteDevissage.projective_of_flat` and `Module.CompleteDevissage.free_of_flat`: over
  a local base, `N` is the direct sum of finite free modules over the stage algebras, and is
  projective and free over `R`.

## References

* [Stacks Project, Tag 05IB](https://stacks.math.columbia.edu/tag/05IB)
* [Stacks Project, Tag 05IA](https://stacks.math.columbia.edu/tag/05IA)
* [Stacks Project, Tag 05ID](https://stacks.math.columbia.edu/tag/05ID)
* [Stacks Project, Tag 05FT](https://stacks.math.columbia.edu/tag/05FT)
* [Stacks Project, Tag 058P](https://stacks.math.columbia.edu/tag/058P)
* [Stacks Project, Tag 0593](https://stacks.math.columbia.edu/tag/0593)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CommRingCat
open scoped DirectSum

universe u v w

/-- **A smooth algebra with geometrically irreducible fibres is projective.** If `B` is a smooth
`R`-algebra whose fibres are geometrically irreducible, then `B` is projective as an
`R`-module. -/
public theorem Algebra.projective_of_smooth_of_geometricallyIrreducible (R B : Type u)
    [CommRing R] [CommRing B] [Algebra R B] [Algebra.Smooth R B]
    [GeometricallyIrreducible (Spec.map (ofHom (algebraMap R B)))] :
    Module.Projective R B := by
  have : AlgebraicGeometry.Smooth (Spec.map (ofHom (algebraMap R B))) :=
    (HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Smooth)).2
      (RingHom.smooth_algebraMap.2 inferInstance)
  have : GeometricallyReduced (Spec.map (ofHom (algebraMap R B))) :=
    geometricallyReduced_of_smooth _
  have : GeometricallyIntegral (Spec.map (ofHom (algebraMap R B))) :=
    GeometricallyIntegral.of_geometricallyReduced_of_geometricallyIrreducible _
  exact Algebra.projective_of_flat_of_geometricallyIntegral_of_isConstructible
    (fun R₀ S₀ _ _ _ _ _ _ =>
      Algebra.isConstructible_geometricallyIntegralFibreLocus_of_finiteType R₀ S₀)

/-- **The generic point of the closed fibre lies over the closed point.** If the ideal `𝔪B`
generated by the maximal ideal of a local ring `R` in an `R`-algebra `B` is prime, then it
contracts to `𝔪`. -/
public theorem Algebra.comap_closedFiberIdeal (R B : Type*) [CommRing R] [CommRing B]
    [IsLocalRing R] [Algebra R B] [(Algebra.closedFiberIdeal R B).IsPrime] :
    (Algebra.closedFiberIdeal R B).comap (algebraMap R B) = IsLocalRing.maximalIdeal R :=
  have := Ideal.comap_isPrime (algebraMap R B) (Algebra.closedFiberIdeal R B)
  ((IsLocalRing.maximalIdeal.isMaximal R).eq_of_le
    (Ideal.IsPrime.ne_top ‹_›) Ideal.le_comap_map).symm

/-- **Flatness of the cokernel of a finite free map over a local base.** Let `R` be local, let
`S` be an `R`-algebra which is flat and projective over `R` and whose closed fibre ideal `𝔪S` is
prime, and let `alpha` be a map from a finite free `S`-module to a finite `S`-module `N` whose
base change to `κ(𝔪S)` is bijective. If `N` is flat over `R` then so is the cokernel of
`alpha`. -/
public theorem Module.flat_coker_of_flat_of_projective_finsupp
    (R : Type u) (S : Type u) [CommRing R] [CommRing S] [IsLocalRing R] [Algebra R S]
    [Module.Flat R S] [Module.Projective R S]
    [(Algebra.closedFiberIdeal R S).IsPrime]
    (N : Type w) [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N]
    [Module.Finite S N] [Module.Flat R N]
    (r : ℕ) (alpha : (Fin r →₀ S) →ₗ[S] N)
    (halpha : Function.Bijective
      (alpha.baseChange (Algebra.closedFiberIdeal R S).ResidueField)) :
    Module.Flat R (N ⧸ LinearMap.range alpha) := by
  classical
  let e : (Fin r →₀ S) ≃ₗ[S] (Fin r → S) := Finsupp.linearEquivFunOnFinite S S (Fin r)
  obtain ⟨f, hf⟩ : ∃ f : (Fin r → S) →ₗ[S] N, f = alpha ∘ₗ e.symm.toLinearMap := ⟨_, rfl⟩
  have hbase : Function.Bijective (f.rTensor (Algebra.closedFiberIdeal R S).ResidueField) := by
    rw [hf, ← LinearMap.lTensor_bij_iff_rTensor_bij, ← LinearMap.baseChange_eq_ltensor,
      LinearMap.baseChange_comp]
    refine halpha.comp ?_
    rw [LinearMap.baseChange_eq_ltensor, LinearMap.lTensor_bij_iff_rTensor_bij,
      ← LinearEquiv.coe_rTensor _ e.symm]
    exact (e.symm.rTensor _).bijective
  have hrange : LinearMap.range f = LinearMap.range alpha := by
    rw [hf]
    exact LinearMap.range_comp_of_range_eq_top _ (LinearMap.range_eq_top.mpr e.symm.surjective)
  have htfae := (Module.flat_localizedModule_tfae_of_projective' R S
    (Algebra.closedFiberIdeal R S) (Algebra.comap_closedFiberIdeal R S) N r f hbase).out 1 2
  have hui : ∀ (Q : Type max u w) [AddCommGroup Q] [Module R Q],
      Function.Injective ((f.restrictScalars R).rTensor Q) :=
    (htfae.mp (Stacks.UniversalInjectivity.flat_localizedModule
      (Algebra.closedFiberIdeal R S).primeCompl)).1
  have hsurj : Function.Surjective ((LinearMap.range f).mkQ.restrictScalars R) :=
    Submodule.mkQ_surjective (LinearMap.range f)
  have hex : Function.Exact (f.restrictScalars R)
      ((LinearMap.range f).mkQ.restrictScalars R) := f.exact_map_mkQ_range
  have key := (Module.flat_of_middle_flat_of_rTensor_injective (f.restrictScalars R)
    ((LinearMap.range f).mkQ.restrictScalars R) hsurj hex hui).2
  rwa [hrange] at key

namespace Module.CompleteDevissage

variable {R : Type u} {S : Type v} {N : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [Algebra.FiniteType R S] [AddCommGroup N] [Module S N] [Module.Finite S N] {r : Ideal R}
  [r.IsPrime] [Module R N] [IsScalarTower R S N]

/-- **Projectivity from a complete dévissage with injective maps.** A module with a complete
dévissage whose maps `alpha i` are injective is projective over the base. The injectivity of the
maps `alpha i` is taken as a hypothesis. -/
public theorem projective_of_injective_alpha (D : CompleteDevissage R S N r)
    (hinj : ∀ i, letI : Module (D.B i) (D.M i) :=
        Module.compHom (D.M i) (D.toLeft i).toRingHom
      Function.Injective (D.alpha i)) :
    Module.Projective R N := by
  obtain ⟨e⟩ := D.nonempty_linearEquiv_directSum hinj
    (fun i => D.projective_lowerAlgebra i)
  have : ∀ i, Module.Projective R (Fin (D.multiplicity i) →₀ D.B i) := fun i =>
    have := D.projective_lowerAlgebra i
    .of_equiv' (DirectSum.linearEquivFunOnFintype R (Fin (D.multiplicity i)) (fun _ => D.B i) ≪≫ₗ
      (Finsupp.linearEquivFunOnFinite R (D.B i) (Fin (D.multiplicity i))).symm)
  exact Module.Projective.of_equiv' e.symm

/-- **Freeness from a complete dévissage with injective maps over a local base.** A module with
a complete dévissage over a local ring `R` whose maps `alpha i` are injective is free over `R`.
The injectivity of the maps `alpha i` is taken as a hypothesis. -/
public theorem free_of_injective_alpha_of_isLocalRing [IsLocalRing R]
    (D : CompleteDevissage R S N r)
    (hinj : ∀ i, letI : Module (D.B i) (D.M i) :=
        Module.compHom (D.M i) (D.toLeft i).toRingHom
      Function.Injective (D.alpha i)) :
    Module.Free R N :=
  have := D.projective_of_injective_alpha hinj
  Module.free_of_projective_of_isLocalRing

/-- **Flatness of the stage modules over a local base.** Let `R` be a local ring, let `N` be
flat over `R` and let `D` be a complete dévissage of `N/S/R` over the maximal ideal. Then every
stage module of `D` is flat over `R`. -/
public theorem flat_stageModule [IsLocalRing R] [Module.Flat R N] (D : CompleteDevissage R S N r)
    (hr : r = IsLocalRing.maximalIdeal R) (i : Fin (D.stepCount + 1)) :
    letI : Module R (D.M i) := Module.compHom (D.M i) (algebraMap R (D.A i))
    Module.Flat R (D.M i) := by
  subst hr
  let : ∀ j, Module (D.B j) (D.M j) := fun j =>
    Module.compHom (D.M j) (D.toLeft j).toRingHom
  let : ∀ j, Module R (D.M j) := fun j =>
    Module.compHom (D.M j) (algebraMap R (D.A j))
  have : ∀ j, IsScalarTower R (D.B j) (D.M j) := fun j =>
    Module.isScalarTower_compHom R (D.B j) (D.A j) (D.M j) (D.toLeft j)
  let : ∀ j, Algebra (D.B j) (D.A j) := fun j => (D.toLeft j).toRingHom.toAlgebra
  have : ∀ j, IsScalarTower (D.B j) (D.A j) (D.M j) := fun j =>
    ⟨fun b a m => by change (D.toLeft j b * a) • m = D.toLeft j b • (a • m); rw [mul_smul]⟩
  have : ∀ j, Module.Finite (D.B j) (D.A j) := fun j =>
    RingHom.finite_algebraMap.mp (D.left_finite j)
  have : ∀ j, Module.Finite (D.B j) (D.M j) := fun j => Module.Finite.trans (D.A j) (D.M j)
  have : ∀ j, Module.Projective R (D.B j) := fun j => D.projective_lowerAlgebra j
  have : ∀ j, (Algebra.closedFiberIdeal R (D.B j)).IsPrime := D.map_isPrime
  induction i using Fin.induction with
  | zero =>
    let : Module S (D.M 0) := Module.compHom (D.M 0) D.toA₀.toRingHom
    have : IsScalarTower R S (D.M 0) :=
      Module.isScalarTower_compHom R S (D.A 0) (D.M 0) D.toA₀
    exact (Module.Flat.equiv_iff (D.initialEquiv.restrictScalars R)).mp ‹_›
  | succ j ih =>
    have hcoker := Module.flat_coker_of_flat_of_projective_finsupp R (D.B j.castSucc)
      (D.M j.castSucc) (D.multiplicity j.castSucc) (D.alpha j.castSucc)
      (D.fiber_bijective j.castSucc)
    let : Module (D.B j.castSucc) (D.M j.succ) :=
      Module.compHom (D.M j.succ) (D.toRight j).toRingHom
    have : IsScalarTower R (D.B j.castSucc) (D.M j.succ) :=
      Module.isScalarTower_compHom R (D.B j.castSucc) (D.A j.succ) (D.M j.succ) (D.toRight j)
    exact (Module.Flat.equiv_iff ((D.cokerEquiv j).restrictScalars R)).mp hcoker

/-- **Injectivity of the maps of a complete dévissage over a local base.** If `R` is local and
`N` is flat over `R`, then every map `alpha i` of a complete dévissage of `N/S/R` over the
maximal ideal is injective. -/
public theorem injective_alpha_of_flat [IsLocalRing R] [Module.Flat R N]
    (D : CompleteDevissage R S N r) (hr : r = IsLocalRing.maximalIdeal R)
    (i : Fin (D.stepCount + 1)) :
    letI : Module (D.B i) (D.M i) := Module.compHom (D.M i) (D.toLeft i).toRingHom
    Function.Injective (D.alpha i) := by
  subst hr
  let : ∀ j, Module (D.B j) (D.M j) := fun j =>
    Module.compHom (D.M j) (D.toLeft j).toRingHom
  let : ∀ j, Module R (D.M j) := fun j =>
    Module.compHom (D.M j) (algebraMap R (D.A j))
  have : ∀ j, IsScalarTower R (D.B j) (D.M j) := fun j =>
    Module.isScalarTower_compHom R (D.B j) (D.A j) (D.M j) (D.toLeft j)
  have hp : ∀ j, (Algebra.closedFiberIdeal R (D.B j)).IsPrime := D.map_isPrime
  refine D.injective_alpha rfl (fun j => D.projective_lowerAlgebra j)
    (fun j => Algebra.closedFiberIdeal R (D.B j)) hp
    (fun j => Algebra.comap_closedFiberIdeal R (D.B j)) (fun j => ?_) i
  have := D.flat_stageModule rfl j
  exact Stacks.UniversalInjectivity.flat_localizedModule _

/-- **The decomposition over a local base.** Let `R` be a local ring, let `N` be a finite
`S`-module flat over `R` and let `N/S/R` have a complete dévissage over the maximal ideal of `R`.
Then `N` is, as an `R`-module, the direct sum of the finite free modules `Bᵢ^{⊕ rᵢ}` over the
smooth stage algebras of the dévissage. -/
@[stacks 05IB "the decomposition, over a local base"]
public theorem nonempty_linearEquiv_directSum_of_flat [IsLocalRing R] [Module.Flat R N]
    (D : CompleteDevissage R S N r) (hr : r = IsLocalRing.maximalIdeal R) :
    Nonempty (N ≃ₗ[R] ⨁ i : Fin (D.stepCount + 1), (Fin (D.multiplicity i) →₀ D.B i)) :=
  D.nonempty_linearEquiv_directSum (D.injective_alpha_of_flat hr)
    (fun i => D.projective_lowerAlgebra i)

/-- **Projectivity over a local base.** In the situation of
`Module.CompleteDevissage.nonempty_linearEquiv_directSum_of_flat` the module `N` is projective
over `R`. -/
@[stacks 05IB "projectivity over a local base"]
public theorem projective_of_flat [IsLocalRing R] [Module.Flat R N]
    (D : CompleteDevissage R S N r) (hr : r = IsLocalRing.maximalIdeal R) :
    Module.Projective R N :=
  D.projective_of_injective_alpha (D.injective_alpha_of_flat hr)

/-- **Freeness over a local base.** In the situation of
`Module.CompleteDevissage.nonempty_linearEquiv_directSum_of_flat` the module `N` is free over
`R`. -/
public theorem free_of_flat [IsLocalRing R] [Module.Flat R N] (D : CompleteDevissage R S N r)
    (hr : r = IsLocalRing.maximalIdeal R) :
    Module.Free R N :=
  have := D.projective_of_flat hr
  Module.free_of_projective_of_isLocalRing

end Module.CompleteDevissage

end
