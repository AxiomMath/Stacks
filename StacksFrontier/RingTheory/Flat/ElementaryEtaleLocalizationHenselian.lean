module

public import StacksFrontier.RingTheory.Flat.ElementaryEtaleNeighborhood
public import StacksFrontier.RingTheory.Henselian.EtaleLifting

/-!
# An elementary étale localization of a henselian local base is a localization of the base

Let `A` be a henselian local ring, let `A → S` be a ring map and let `q` be a prime of `S` lying
over the maximal ideal of `A`. Stacks Tag 05I1 produces an elementary étale localization
`E` of `A → S` at `q` — rings `E.R'` and `E.S'`, primes `E.p'` and `E.q'` — over which the base
change of the module admits a complete dévissage. The base of that dévissage is `E.R'`, not `A`,
and the dévissage can only be read over `A` once the two are compared.

This file does the comparison. Over a henselian local base the étale `A`-algebra `E.R'` admits an
`A`-algebra retraction `σ : E.R' → A` whose preimage of the maximal ideal is `E.p'`
(`henselian_etale_retraction`, Stacks Tag 08HQ), and `A` is then
*the localization of `E.R'` at `E.p'`*: the kernel of a retraction of a formally étale surjection
is generated by an idempotent `e₀`, which lies in `E.p'`, so `1 - e₀` is a denominator killing the
kernel.

So the base of the dévissage of Stacks Tag 05I1 is, over a henselian local base, the local ring
of `E.R'` at `E.p'`, and that local ring is `A` itself. This is what lets
`Module.CompleteDevissage.localizeAtPrime` — the base change of a complete dévissage to the local
ring of its base prime — be composed with the transport along an isomorphism of the base to put
the dévissage of Stacks Tag 05I1 over `A`.

## Main results

* `Algebra.isLocalization_primeCompl_of_etale_retraction`: if `A` is local, `A → R'` is étale and
  `σ : R' →ₐ[A] A` has `σ⁻¹(𝔪_A) = p'`, then `A` is the localization of `R'` at `p'`.
* `Algebra.ElementaryEtaleLocalization.exists_retraction_of_henselian`: over a henselian local
  base with `p = 𝔪_A`, the lower right ring of an elementary étale localization retracts onto `A`
  compatibly with `p'`.
* `Algebra.ElementaryEtaleLocalization.exists_isLocalization_primeCompl_of_henselian`: that
  retraction exhibits `A` as the localization of `E.R'` at `E.p'`.

## Implementation notes

The `A`-algebra structure on `R'` and the `R'`-algebra structure on `A` given by `σ` both appear;
the latter is introduced by `letI` inside the statements, since `σ` is not available before the
statement is read. `IsLocalization` is verified field by field rather than through a comparison
map, because the three fields are exactly the three facts the idempotent supplies.

Nothing here carries a Stacks tag: this is an input to Stacks Tag 05PG, not a proof of any tag.
Stacks Tag 05I1 remains registered on
`Module.exists_elementaryEtaleLocalization_completeDevissageAt`, whose statement is unchanged.

## References

* [Stacks Project, Tag 05HW](https://stacks.math.columbia.edu/tag/05HW)
* [Stacks Project, Tag 05I1](https://stacks.math.columbia.edu/tag/05I1)
* [Stacks Project, Tag 08HQ](https://stacks.math.columbia.edu/tag/08HQ)
* [Stacks Project, Tag 05PG](https://stacks.math.columbia.edu/tag/05PG)
-/

@[expose] public section

open IsLocalRing

universe u v w x

namespace Algebra

/-- **The kernel of an `A`-algebra retraction of an étale `A`-algebra is generated by an
idempotent.** The retraction is surjective, so formal étaleness makes its kernel an idempotent
ideal, and finite presentation makes it finitely generated; a finitely generated idempotent ideal
is generated by one idempotent element. -/
theorem exists_isIdempotentElem_ker_of_etale_retraction {A : Type u} {R' : Type v} [CommRing A]
    [CommRing R'] [Algebra A R'] [Algebra.Etale A R'] (σ : R' →ₐ[A] A) :
    ∃ e₀ : R', IsIdempotentElem e₀ ∧ RingHom.ker σ.toRingHom = Ideal.span {e₀} := by
  let : Algebra R' A := σ.toRingHom.toAlgebra
  have _ : IsScalarTower A R' A :=
    IsScalarTower.of_algebraMap_eq fun a ↦ (σ.commutes a).symm
  have hsurj : Function.Surjective σ := fun a ↦ ⟨algebraMap A R' a, σ.commutes a⟩
  have _ : Algebra.FormallyEtale R' A :=
    Algebra.FormallyEtale.of_restrictScalars (R := A) (A := R') (B := A)
  have hidem : IsIdempotentElem (RingHom.ker σ.toRingHom) :=
    (Algebra.FormallyEtale.iff_of_surjective hsurj).mp inferInstance
  have hfg : (RingHom.ker σ.toRingHom).FG :=
    Algebra.FinitePresentation.ker_fG_of_surjective σ hsurj
  obtain ⟨e₀, he₀, hspan⟩ := (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hidem
  exact ⟨e₀, he₀, hspan⟩

/-- **An étale algebra retracting onto a local base is a localization of it.** Let `A` be a local
ring, let `A → R'` be étale and let `σ : R' →ₐ[A] A` be an `A`-algebra retraction with
`σ⁻¹(𝔪_A) = p'`. Then `A`, read as an `R'`-algebra through `σ`, is the localization of `R'` at the
prime `p'`.

Each of the three conditions is immediate from the idempotent generator `e₀` of `ker σ` supplied
by `Algebra.exists_isIdempotentElem_ker_of_etale_retraction`: a denominator `y ∉ p'` has
`σ y ∉ 𝔪_A`, hence invertible; `σ` is surjective, so every element of `A` is already a value; and
two elements with the same value differ by an element of `ker σ = (e₀)`, which `1 - e₀` kills —
and `1 - e₀ ∉ p'`, because `e₀ ∈ ker σ ⊆ p'`. -/
theorem isLocalization_primeCompl_of_etale_retraction {A : Type u} {R' : Type v} [CommRing A]
    [IsLocalRing A] [CommRing R'] [Algebra A R'] [Algebra.Etale A R'] {p' : Ideal R'}
    [p'.IsPrime] (σ : R' →ₐ[A] A) (hσ : (maximalIdeal A).comap σ.toRingHom = p') :
    letI : Algebra R' A := σ.toRingHom.toAlgebra
    IsLocalization p'.primeCompl A := by
  let : Algebra R' A := σ.toRingHom.toAlgebra
  have hmap : ∀ r : R', algebraMap R' A r = σ r := fun _ ↦ rfl
  have hsurj : Function.Surjective σ := fun a ↦ ⟨algebraMap A R' a, σ.commutes a⟩
  obtain ⟨e₀, he₀, hker⟩ := Algebra.exists_isIdempotentElem_ker_of_etale_retraction σ
  have he₀ker : σ e₀ = 0 := by
    have hm : e₀ ∈ RingHom.ker σ.toRingHom := hker ▸ Ideal.mem_span_singleton_self e₀
    exact RingHom.mem_ker.mp hm
  have he₀p : e₀ ∈ p' := by
    rw [← hσ, Ideal.mem_comap]
    show σ e₀ ∈ maximalIdeal A
    rw [he₀ker]
    exact Submodule.zero_mem _
  have hone : (1 - e₀) ∈ p'.primeCompl := by
    intro h
    have h1 : (1 : R') ∈ p' := by simpa using Ideal.add_mem p' h he₀p
    exact (inferInstance : p'.IsPrime).ne_top ((Ideal.eq_top_iff_one p').mpr h1)
  refine (_root_.isLocalization_iff (M := p'.primeCompl) (S := A)).mpr
    ⟨fun y ↦ ?_, fun z ↦ ?_, fun {x y} h ↦ ⟨⟨1 - e₀, hone⟩, ?_⟩⟩
  · rw [hmap]
    by_contra hcon
    have hy : (y : R') ∈ Ideal.comap σ.toRingHom (maximalIdeal A) :=
      Ideal.mem_comap.mpr ((mem_maximalIdeal _).mpr hcon)
    exact y.2 (hσ ▸ hy)
  · obtain ⟨r, hr⟩ := hsurj z
    exact ⟨⟨r, 1⟩, by rw [hmap, hmap, hr]; simp⟩
  · have hsub : x - y ∈ RingHom.ker σ.toRingHom := by
      rw [RingHom.mem_ker]
      show σ (x - y) = 0
      rw [map_sub, sub_eq_zero]
      exact (hmap x).symm.trans (h.trans (hmap y))
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hker ▸ hsub)
    have hidem : e₀ * e₀ = e₀ := he₀
    have hzero : (1 - e₀) * (x - y) = 0 := by
      rw [← hc]
      linear_combination (-c) * hidem
    show (1 - e₀) * x = (1 - e₀) * y
    linear_combination hzero

end Algebra

namespace Algebra.ElementaryEtaleLocalization

variable {A : Type u} {S : Type v} [CommRing A] [CommRing S] [Algebra A S] [IsLocalRing A]
  {q : Ideal S} [q.IsPrime] [q.LiesOver (maximalIdeal A)]

/-- **Over a henselian local base an elementary étale localization retracts onto the base.** The
lower right ring `E.R'` is étale over `A`, the prime `E.p'` lies over the maximal ideal of `A`,
and the residue extension at `E.p'` is trivial; so Stacks Tag 08HQ for a henselian local ring
produces an `A`-algebra map `E.R' → A` whose preimage of the maximal ideal is `E.p'`. -/
theorem exists_retraction_of_henselian [HenselianLocalRing A]
    (E : ElementaryEtaleLocalization.{u, v, w, x} A S (maximalIdeal A) q) :
    ∃ σ : E.R' →ₐ[A] A, (maximalIdeal A).comap σ.toRingHom = E.p' :=
  _root_.henselian_etale_retraction A E.R' E.p' E.p'_liesOver.symm
    E.residueFieldMap_p_bijective

/-- **Over a henselian local base the lower right ring of an elementary étale localization is a
localization of the base — equivalently, the base may be taken to be `A` itself.** The retraction
of `Algebra.ElementaryEtaleLocalization.exists_retraction_of_henselian` makes `A` an
`E.R'`-algebra, and it exhibits `A` as the localization of `E.R'` at `E.p'`.

This is the comparison Stacks Tag 05PG needs: the complete dévissage of Stacks Tag 05I1 has base
`E.R'` and base prime `E.p'`, and
`Module.CompleteDevissage.localizeAtPrime` carries it to the local ring of `E.R'` at `E.p'`, which
this identifies with `A`. -/
theorem exists_isLocalization_primeCompl_of_henselian [HenselianLocalRing A]
    (E : ElementaryEtaleLocalization.{u, v, w, x} A S (maximalIdeal A) q) :
    ∃ σ : E.R' →ₐ[A] A, (maximalIdeal A).comap σ.toRingHom = E.p' ∧
      letI : Algebra E.R' A := σ.toRingHom.toAlgebra
      IsLocalization E.p'.primeCompl A := by
  obtain ⟨σ, hσ⟩ := E.exists_retraction_of_henselian
  exact ⟨σ, hσ, Algebra.isLocalization_primeCompl_of_etale_retraction σ hσ⟩

end Algebra.ElementaryEtaleLocalization

end
