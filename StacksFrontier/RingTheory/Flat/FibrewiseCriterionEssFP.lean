/-!
# Critère de platitude par fibres: the essentially finitely presented case

Let `R → S → S'` be local homomorphisms of local rings with `R → S` and `R → S'` essentially of
finite presentation, let `𝔪 ⊆ R` be the maximal ideal, and let `M` be a nonzero `S'`-module of
finite presentation. If the fibre `M/𝔪M` is flat over `S/𝔪S` and `M` is flat over `R`, then `S`
is flat over `R` and `M` is flat over `S`.

## Main results

* `Module.flat_algebra_and_flat_of_flat_quotient_maximalIdeal`: the criterion, both of whose
  conclusions — flatness of `S` over `R` and flatness of `M` over `S` — are stated together.
* `Stacks.Flatness.EssFPFibrewiseCriterion.tmul_one_sub_one_tmul_mem_of_isLocalization`: for
  `S = T⁻¹A` and an `S`-algebra `C`, an ideal of `S ⊗_R C` containing `a ⊗ 1 - 1 ⊗ a` for a set
  of `R`-algebra generators `a` of `A` contains `x ⊗ 1 - 1 ⊗ x` for every `x : S`.

## References

* [Stacks Project, Tag 00R7](https://stacks.math.columbia.edu/tag/00R7)
-/

@[expose] public section

namespace Stacks.Flatness.EssFPFibrewiseCriterion

open TensorProduct
open Stacks.Flatness.NilpotentFibreCriterion

open NoetherianFibreCriterion (injective_rTensor_subtype_map faithfullyFlat_of_flat)

universe u v w x

/-! ### Descent of essential finite presentation along the base -/

section MulTensor

/-- For a tower `R → A → C` the `R`-algebra map `A ⊗_R C → C`, `a ⊗ c ↦ a c`, has kernel the
ideal generated by the differences `a ⊗ 1 - 1 ⊗ a`. -/
private lemma ker_productMap_toAlgHom_id {R A C : Type*} [CommRing R] [CommRing A] [CommRing C]
    [Algebra R A] [Algebra R C] [Algebra A C] [IsScalarTower R A C] :
    RingHom.ker (Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A C) (AlgHom.id R C))
      = Ideal.span (Set.range fun a : A => a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A C a) := by
  set π := Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R A C) (AlgHom.id R C) with hπ
  set J := Ideal.span (Set.range fun a : A => a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A C a) with hJ
  have hgen : ∀ a : A, a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A C a ∈ J :=
    fun a => Ideal.subset_span ⟨a, rfl⟩
  have key : ∀ y : A ⊗[R] C, y - 1 ⊗ₜ π y ∈ J := by
    intro y
    induction y with
    | zero => simp
    | tmul a c =>
        have hval : π (a ⊗ₜ c) = algebraMap A C a * c := by simp [hπ]
        have hfac : a ⊗ₜ[R] c - 1 ⊗ₜ (algebraMap A C a * c)
            = (a ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap A C a) * (1 ⊗ₜ c) := by
          simp [Algebra.TensorProduct.tmul_mul_tmul, sub_mul]
        rw [hval, hfac]
        exact Ideal.mul_mem_right _ _ (hgen a)
    | add y z hy hz =>
        have e : y + z - 1 ⊗ₜ π (y + z) = (y - 1 ⊗ₜ π y) + (z - 1 ⊗ₜ π z) := by
          rw [map_add, TensorProduct.tmul_add]; ring
        rw [e]; exact add_mem hy hz
  refine le_antisymm (fun x hx => ?_) ?_
  · have h := key x
    rwa [RingHom.mem_ker.mp hx, TensorProduct.tmul_zero, sub_zero] at h
  · rw [hJ, Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    simp [RingHom.mem_ker, hπ]

/-- Let `R → A → S` be a tower with `S` a localization `T⁻¹A`, let `C` be an `S`-algebra, and let
`J` be an ideal of `S ⊗_R C` containing `a ⊗ 1 - 1 ⊗ a` for every `a` in a set `G` which generates
`A` as an `R`-algebra. Then `J` contains `x ⊗ 1 - 1 ⊗ x` for *every* `x : S`. -/
public lemma tmul_one_sub_one_tmul_mem_of_isLocalization
    {R A S C : Type*} [CommRing R] [CommRing A] [CommRing S] [CommRing C]
    [Algebra R A] [Algebra R S] [Algebra R C] [Algebra A S] [Algebra S C]
    [IsScalarTower R A S] [IsScalarTower R S C]
    (T : Submonoid A) [IsLocalization T S] {G : Set A} (hG : Algebra.adjoin R G = ⊤)
    (J : Ideal (S ⊗[R] C))
    (hJ : ∀ a ∈ G, (algebraMap A S a) ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C (algebraMap A S a) ∈ J)
    (x : S) : x ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C x ∈ J := by
  set P : S → Prop := fun y => y ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C y ∈ J with hP
  have hadd : ∀ y z, P y → P z → P (y + z) := by
    intro y z hy hz
    have e : (y + z) ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C (y + z)
        = (y ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C y)
          + (z ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C z) := by
      rw [map_add, TensorProduct.add_tmul, TensorProduct.tmul_add]; ring
    simp only [hP] at hy hz ⊢
    rw [e]; exact add_mem hy hz
  have hmul : ∀ y z, P y → P z → P (y * z) := by
    intro y z hy hz
    have e : (y * z) ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C (y * z)
        = (y ⊗ₜ[R] (1 : C)) * (z ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C z)
          + (y ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C y) * (1 ⊗ₜ algebraMap S C z) := by
      simp only [map_mul, mul_sub, sub_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      ring
    simp only [hP] at hy hz ⊢
    rw [e]
    exact add_mem (Ideal.mul_mem_left _ _ hz) (Ideal.mul_mem_right _ _ hy)
  have hbase : ∀ r : R, P (algebraMap R S r) := by
    intro r
    have e : (algebraMap R S r) ⊗ₜ[R] (1 : C) = 1 ⊗ₜ algebraMap R C r := by
      rw [Algebra.algebraMap_eq_smul_one (R := R) (A := S),
        Algebra.algebraMap_eq_smul_one (R := R) (A := C), TensorProduct.smul_tmul]
    simp only [hP, ← IsScalarTower.algebraMap_apply R S C, e, sub_self]
    exact Ideal.zero_mem J
  have hA : ∀ a : A, P (algebraMap A S a) := by
    intro a
    have ha : a ∈ Algebra.adjoin R G := hG ▸ Algebra.mem_top
    induction ha using Algebra.adjoin_induction with
    | mem b hb => exact hJ b hb
    | algebraMap r => rw [← IsScalarTower.algebraMap_apply R A S]; exact hbase r
    | add y z _ _ hy hz => rw [map_add]; exact hadd _ _ hy hz
    | mul y z _ _ hy hz => rw [map_mul]; exact hmul _ _ hy hz
  have hinv : ∀ w : Sˣ, P (w : S) → P ((w⁻¹ : Sˣ) : S) := by
    intro w hw
    have hmm : algebraMap S C ((w⁻¹ : Sˣ) : S) * algebraMap S C (w : S) = 1 := by
      rw [← map_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, map_one]
    have e : ((w⁻¹ : Sˣ) : S) ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C ((w⁻¹ : Sˣ) : S)
        = -((((w⁻¹ : Sˣ) : S) ⊗ₜ[R] algebraMap S C ((w⁻¹ : Sˣ) : S))
            * ((w : S) ⊗ₜ[R] (1 : C) - 1 ⊗ₜ algebraMap S C (w : S))) := by
      simp only [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, mul_one, Units.inv_mul, hmm]
      abel
    simp only [hP] at hw ⊢
    rw [e]
    exact neg_mem (Ideal.mul_mem_left _ _ hw)
  obtain ⟨⟨a, t⟩, hx⟩ := IsLocalization.surj T x
  have hx' : x * algebraMap A S (t : A) = algebraMap A S a := hx
  obtain ⟨w, hw⟩ := (IsLocalization.map_units S t : IsUnit (algebraMap A S (t : A)))
  have hxeq : x = algebraMap A S a * ((w⁻¹ : Sˣ) : S) := by
    rw [← hx', ← hw, mul_assoc, Units.mul_inv, mul_one]
  rw [hxeq]
  exact hmul _ _ (hA a) (hinv w (hw ▸ hA (t : A)))

end MulTensor

section BaseChangeLocalization

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-- Let `R → B → S'` be a tower with `S'` the localization of `B` at a submonoid `U`, and let `S`
be any `R`-algebra. Then `S ⊗[R] S'` is the localization of `S ⊗[R] B` at the image of `U`, for any
`S ⊗[R] B`-algebra structure on `S ⊗[R] S'` sending `s ⊗ b` to `s ⊗ algebraMap B S' b`. -/
private theorem isLocalization_algebraMapSubmonoid_baseChange
    {R S B S' : Type*} [CommRing R] [CommRing S] [CommRing B] [CommRing S']
    [Algebra R S] [Algebra R B] [Algebra R S'] [Algebra B S'] [IsScalarTower R B S']
    (U : Submonoid B) [IsLocalization U S']
    [Algebra (S ⊗[R] B) (S ⊗[R] S')]
    (hc : ∀ (s : S) (b : B),
      algebraMap (S ⊗[R] B) (S ⊗[R] S') (s ⊗ₜ b) = s ⊗ₜ algebraMap B S' b) :
    IsLocalization (Algebra.algebraMapSubmonoid (S ⊗[R] B) U) (S ⊗[R] S') := by
  have h0 : IsLocalization (Algebra.algebraMapSubmonoid (S ⊗[R] B) U) (S' ⊗[B] (S ⊗[R] B)) :=
    IsLocalization.tensorRight (R := B) (S := S ⊗[R] B) S' U
  let e₁ : S' ⊗[B] (S ⊗[R] B) ≃ₐ[B] S' ⊗[B] (B ⊗[R] S) :=
    Algebra.TensorProduct.congr AlgEquiv.refl (Algebra.TensorProduct.commRight R B S).symm
  let e₂ : S' ⊗[B] (B ⊗[R] S) ≃ₐ[S'] S' ⊗[R] S :=
    Algebra.TensorProduct.cancelBaseChange R B S' S' S
  let e₃ : S' ⊗[R] S ≃ₐ[R] S ⊗[R] S' := Algebra.TensorProduct.comm R S' S
  let e : (S' ⊗[B] (S ⊗[R] B)) ≃+* (S ⊗[R] S') :=
    e₁.toRingEquiv.trans (e₂.toRingEquiv.trans e₃.toRingEquiv)
  refine IsLocalization.isLocalization_of_algEquiv (S := S' ⊗[B] (S ⊗[R] B)) _
    (AlgEquiv.ofRingEquiv (f := e) ?_)
  intro x
  induction x with
  | zero => simp
  | add a b ha hb => simp only [map_add, ha, hb]
  | tmul s b =>
      show e (1 ⊗ₜ (s ⊗ₜ b)) = _
      rw [hc]
      simp [e, e₁, e₂, e₃, Algebra.smul_def]

end BaseChangeLocalization

/-- For a tower `R → S → S'` with `R → S` and `R → S'` essentially of finite presentation, the map
`S → S'` is essentially of finite presentation. -/
@[ega "IV 1.3.10" "partial"]
private theorem essentiallyOfFinitePresentation_of_tower {R : Type u} {S : Type v} {S' : Type w}
    [CommRing R] [CommRing S] [CommRing S'] [Algebra R S] [Algebra S S'] [Algebra R S']
    [IsScalarTower R S S'] (hS : (algebraMap R S).EssentiallyOfFinitePresentation)
    (hS' : (algebraMap R S').EssentiallyOfFinitePresentation) :
    (algebraMap S S').EssentiallyOfFinitePresentation := by
  classical
  obtain ⟨A, instA, algRA, algAS, towerRAS₀, fpRA, T, locTS⟩ := hS
  let := instA; let := algRA; let := algAS; let := fpRA
  have locTS : IsLocalization T S := locTS
  have towerRAS : IsScalarTower R A S := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    have h := @IsScalarTower.algebraMap_eq R A S _ _ _ algRA algAS
      ((algebraMap R S).toAlgebra) towerRAS₀
    rwa [RingHom.algebraMap_toAlgebra] at h
  obtain ⟨B, instB, algRB, algBS', towerRBS'₀, fpRB, U, locUS'⟩ := hS'
  let := instB; let := algRB; let := algBS'; let := fpRB
  have locUS' : IsLocalization U S' := locUS'
  have towerRBS' : IsScalarTower R B S' := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    have h := @IsScalarTower.algebraMap_eq R B S' _ _ _ algRB algBS'
      ((algebraMap R S').toAlgebra) towerRBS'₀
    rwa [RingHom.algebraMap_toAlgebra] at h
  have fpD : Algebra.FinitePresentation S (S ⊗[R] B) := Algebra.FinitePresentation.baseChange S
  let φ : (S ⊗[R] B) →ₐ[R] (S ⊗[R] S') :=
    Algebra.TensorProduct.map (AlgHom.id R S) (IsScalarTower.toAlgHom R B S')
  let algDL : Algebra (S ⊗[R] B) (S ⊗[R] S') := φ.toRingHom.toAlgebra
  have hc : ∀ (s : S) (b : B),
      algebraMap (S ⊗[R] B) (S ⊗[R] S') (s ⊗ₜ b) = s ⊗ₜ algebraMap B S' b := by
    intro s b
    show φ (s ⊗ₜ b) = _
    simp [φ]
  obtain ⟨W, hlocW⟩ : ∃ W : Submonoid (S ⊗[R] B), IsLocalization W (S ⊗[R] S') :=
    ⟨_, isLocalization_algebraMapSubmonoid_baseChange U hc⟩
  let π : (S ⊗[R] S') →ₐ[R] S' :=
    Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R S S') (AlgHom.id R S')
  have hπtmul : ∀ (x : S) (z : S'), π (x ⊗ₜ z) = algebraMap S S' x * z := fun x z => by
    simp [π]
  have hπker : RingHom.ker π
      = Ideal.span (Set.range fun x : S => x ⊗ₜ[R] (1 : S') - 1 ⊗ₜ algebraMap S S' x) :=
    ker_productMap_toAlgHom_id
  have hπzero : ∀ x : S, π (x ⊗ₜ[R] (1 : S') - 1 ⊗ₜ algebraMap S S' x) = 0 := by
    intro x
    rw [map_sub, hπtmul, hπtmul, mul_one, map_one, one_mul, sub_self]
  have hπsurj : Function.Surjective (π : (S ⊗[R] S') →+* S') := fun z =>
    ⟨1 ⊗ₜ z, by rw [show ((π : (S ⊗[R] S') →+* S') (1 ⊗ₜ z)) = π (1 ⊗ₜ z) from rfl, hπtmul,
      map_one, one_mul]⟩
  obtain ⟨G, hG⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra R A).FG)
  let ee : A → (S ⊗[R] S') := fun a =>
    (algebraMap A S a) ⊗ₜ[R] (1 : S') - 1 ⊗ₜ algebraMap S S' (algebraMap A S a)
  have hπee : ∀ a : A, π (ee a) = 0 := fun a => hπzero (algebraMap A S a)
  have hkerJ : RingHom.ker π ≤ Ideal.span (ee '' (G : Set A)) := by
    rw [hπker, Ideal.span_le]
    rintro _ ⟨x, rfl⟩
    exact tmul_one_sub_one_tmul_mem_of_isLocalization T hG (Ideal.span (ee '' (G : Set A)))
      (fun a ha => Ideal.subset_span ⟨a, ha, rfl⟩) x
  choose yy hyy using fun a : A => IsLocalization.surj W (ee a)
  let K : Ideal (S ⊗[R] B) := Ideal.span ((fun a => (yy a).1) '' (G : Set A))
  have hKfg : K.FG := Submodule.fg_span (G.finite_toSet.image _)
  have hKgen : ∀ a ∈ (G : Set A), (yy a).1 ∈ K := fun a ha => Ideal.subset_span ⟨a, ha, rfl⟩
  have hmapK : Ideal.map (algebraMap (S ⊗[R] B) (S ⊗[R] S')) K ≤ RingHom.ker π := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show π (algebraMap (S ⊗[R] B) (S ⊗[R] S') (yy a).1) = 0
    rw [← hyy a, map_mul, hπee a, zero_mul]
  have hkerK : RingHom.ker π ≤ Ideal.map (algebraMap (S ⊗[R] B) (S ⊗[R] S')) K := by
    refine hkerJ.trans ?_
    rw [Ideal.span_le]
    rintro _ ⟨a, ha, rfl⟩
    obtain ⟨u, hu⟩ := (IsLocalization.map_units (S ⊗[R] S') (yy a).2 :
      IsUnit (algebraMap (S ⊗[R] B) (S ⊗[R] S') ((yy a).2 : S ⊗[R] B)))
    have h2 : (↑u⁻¹ : S ⊗[R] S') * algebraMap (S ⊗[R] B) (S ⊗[R] S') (yy a).1 = ee a := by
      rw [← hyy a, ← hu, mul_comm (ee a) (↑u : S ⊗[R] S'), ← mul_assoc, ← Units.val_mul,
        inv_mul_cancel, Units.val_one, one_mul]
    rw [SetLike.mem_coe, ← h2]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hKgen a ha))
  have fpQ : Algebra.FinitePresentation S ((S ⊗[R] B) ⧸ K) :=
    Algebra.FinitePresentation.quotient hKfg
  let ψ : ((S ⊗[R] B) ⧸ K) →+* S' :=
    Ideal.Quotient.lift K ((π : (S ⊗[R] S') →+* S').comp
      (algebraMap (S ⊗[R] B) (S ⊗[R] S'))) fun d hd =>
        hmapK (Ideal.mem_map_of_mem _ hd)
  let algQS' : Algebra ((S ⊗[R] B) ⧸ K) S' := ψ.toAlgebra
  have hcomm : (π : (S ⊗[R] S') →+* S').comp (algebraMap (S ⊗[R] B) (S ⊗[R] S'))
      = (algebraMap ((S ⊗[R] B) ⧸ K) S').comp (Ideal.Quotient.mk K) := rfl
  have hlocQ : IsLocalization (Submonoid.map (Ideal.Quotient.mk K) W) S' :=
    IsLocalization.of_surjective W (S ⊗[R] S') (Ideal.Quotient.mk K)
      Ideal.Quotient.mk_surjective (π : (S ⊗[R] S') →+* S') hπsurj hcomm
      (by rw [Ideal.mk_ker]; exact hkerK)
  have towerSQS' : IsScalarTower S ((S ⊗[R] B) ⧸ K) S' := by
    refine IsScalarTower.of_algebraMap_eq' (RingHom.ext fun s => ?_)
    rw [RingHom.comp_apply,
      show algebraMap S ((S ⊗[R] B) ⧸ K) s = Ideal.Quotient.mk K (s ⊗ₜ[R] (1 : B)) from rfl]
    show algebraMap S S' s = π (algebraMap (S ⊗[R] B) (S ⊗[R] S') (s ⊗ₜ[R] (1 : B)))
    rw [hc, map_one, hπtmul, mul_one]
  obtain ⟨A', instA', algSA', algA'S', towerSA'S', fpSA', V, locV⟩ :=
    essFP_reuniverse (R := S) (T := S') ((S ⊗[R] B) ⧸ K) (Submonoid.map (Ideal.Quotient.mk K) W)
  refine ⟨A', instA', algSA', algA'S',
    @IsScalarTower.of_algebraMap_eq' S A' S' _ _ _ algSA' algA'S'
      ((algebraMap S S').toAlgebra) ?_, fpSA', V, locV⟩
  exact @IsScalarTower.algebraMap_eq S A' S' _ _ _ algSA' algA'S' _ towerSA'S'

open IsLocalRing in
/-- Let `R → S → S'` be local homomorphisms of local rings with `R → S` and `R → S'` essentially of
finite presentation, and let `M` be a finitely presented `S'`-module, flat over `R`, whose fibre
`M/𝔪M` over the maximal ideal `𝔪` of `R` is flat over `S/𝔪S`. Then `M` is flat over `S`. -/
private theorem flat_of_flat_quotient_maximalIdeal
    {R S S' M : Type*} [CommRing R] [CommRing S] [CommRing S']
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing S']
    [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap S S')]
    [AddCommGroup M] [Module R M] [Module S M] [Module S' M]
    [IsScalarTower R S M] [IsScalarTower S S' M]
    [Module.FinitePresentation S' M]
    [Module.Flat (S ⧸ (maximalIdeal R).map (algebraMap R S))
      (M ⧸ ((maximalIdeal R).map (algebraMap R S) • (⊤ : Submodule S M)))]
    [Module.Flat R M]
    (hS : (algebraMap R S).EssentiallyOfFinitePresentation)
    (hS' : (algebraMap R S').EssentiallyOfFinitePresentation) :
    Module.Flat S M :=
  Module.Flat.of_rTensor_subtype_injective_of_flat_quotient_of_essentiallyOfFinitePresentation
    S' M (essentiallyOfFinitePresentation_of_tower hS hS')
    ((maximalIdeal R).map (algebraMap R S))
    (map_maximalIdeal_lt_top (algebraMap R S)).ne
    (injective_rTensor_subtype_map R S M (maximalIdeal R)) inferInstance

open IsLocalRing in
/-- Let `R → S → S'` be local homomorphisms of local rings with `R → S` and `R → S'` essentially of
finite presentation, and let `M` be a nonzero finitely presented `S'`-module, flat over `R`, whose
fibre `M/𝔪M` over the maximal ideal `𝔪` of `R` is flat over `S/𝔪S`. Then `S` is flat over `R` and
`M` is flat over `S`. -/
public theorem solution
    {R S S' M : Type*} [CommRing R] [CommRing S] [CommRing S']
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing S']
    [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap S S')]
    [AddCommGroup M] [Module R M] [Module S M] [Module S' M]
    [IsScalarTower R S M] [IsScalarTower S S' M]
    [Module.FinitePresentation S' M] [Nontrivial M]
    [Module.Flat (S ⧸ (maximalIdeal R).map (algebraMap R S))
      (M ⧸ ((maximalIdeal R).map (algebraMap R S) • (⊤ : Submodule S M)))]
    [Module.Flat R M]
    (hS : (algebraMap R S).EssentiallyOfFinitePresentation)
    (hS' : (algebraMap R S').EssentiallyOfFinitePresentation) :
    Module.Flat R S ∧ Module.Flat S M := by
  have hMS : Module.Flat S M := flat_of_flat_quotient_maximalIdeal hS hS'
  have : Module.FaithfullyFlat S M := faithfullyFlat_of_flat S S' M
  exact ⟨NilpotentFibreCriterion.flat_of_flat_of_faithfullyFlat (R := R) (S := S) M, hMS⟩

end Stacks.Flatness.EssFPFibrewiseCriterion

open IsLocalRing in
/-- **Critère de platitude par fibres.** Let `R → S → S'` be local homomorphisms of
local rings with `R → S` and `R → S'` essentially of finite presentation, let `𝔪` be the maximal
ideal of `R`, and let `M` be a nonzero `S'`-module of finite presentation over `S'`. If the fibre
`M/𝔪M` is flat over `S/𝔪S` and `M` is flat over `R`, then `S` is flat over `R` and `M` is flat
over `S`.

Here `𝔪S` is `Ideal.map (algebraMap R S) (maximalIdeal R)` and `M/𝔪M` is `M ⧸ 𝔪S • ⊤` taken over
`S`, so that it is a module over `S/𝔪S`. -/
@[stacks 00R7 "Hypothesis (1) is `RingHom.EssentiallyOfFinitePresentation` (Definition 00QM (2))
applied to `algebraMap R S` and `algebraMap R S'`, Mathlib having no such predicate. The fibre is
`M ⧸ (𝔪S) • (⊤ : Submodule S M)` over the ring `S ⧸ 𝔪S`, as in 06A5, and the two conclusions are
conjoined; see the module docstring.",
  ega "IV 11.3.10" "special case",
  sga "1 I 5.9" "partial",
  sga "1 IV 5.9" "(ii) ⇒ (i)",
  sga "3 VIB 1.3.0" "special case",
  sga "3 VIB 12.7" "special case",
  sga "3 VIB 2.5" "flatness clause",
  sga "3 X 3.5" "Flat case"]
public theorem Module.flat_algebra_and_flat_of_flat_quotient_maximalIdeal
    {R S S' M : Type*} [CommRing R] [CommRing S] [CommRing S']
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing S']
    [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap S S')]
    [AddCommGroup M] [Module R M] [Module S M] [Module S' M]
    [IsScalarTower R S M] [IsScalarTower S S' M]
    [Module.FinitePresentation S' M] [Nontrivial M]
    [Module.Flat (S ⧸ (maximalIdeal R).map (algebraMap R S))
      (M ⧸ ((maximalIdeal R).map (algebraMap R S) • (⊤ : Submodule S M)))]
    [Module.Flat R M]
    (hS : (algebraMap R S).EssentiallyOfFinitePresentation)
    (hS' : (algebraMap R S').EssentiallyOfFinitePresentation) :
    Module.Flat R S ∧ Module.Flat S M :=
  Stacks.Flatness.EssFPFibrewiseCriterion.solution hS hS'
