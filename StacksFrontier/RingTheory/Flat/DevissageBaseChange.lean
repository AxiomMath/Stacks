module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.RingTheory.Localization.Algebra
public import Mathlib.RingTheory.Localization.Finiteness
public import Mathlib.RingTheory.RingHom.FinitePresentation
public import StacksFrontier.RingTheory.Flat.DevissageFibrePrime
public import StacksFrontier.RingTheory.Flat.DevissageLength

/-!
# Base change of a dévissage along a localization of the base

Let `R → R'` be the localization of `R` at a submonoid `P`. A stage of a dévissage
(`Module.CompleteDevissage`) consists of `R`-algebras `B → A`, a finite `A`-module `M`, a
surjection `S → A` of finite presentation and a map `α : B^(⊕ m) → M` which becomes an isomorphism
over the residue field of `rB`. This file shows that each condition imposed on a stage survives
replacing `S`, `A`, `B`, `N` and `M` by their localizations at the image of `P`, and every map by
`IsLocalization.mapₐ` of itself.

## Main results

* `Stacks.Flatness.bijective_congr`: two maps intertwined by bijections on the source and on the
  target are bijective together.
* `Stacks.Flatness.bijective_baseChange_iff_of_isBaseChange`: the base change `f ⊗ L` of a linear
  map is bijective exactly when a compatible map between base changes along `B → L` is.
* `Stacks.Flatness.bijective_baseChange_iff_of_bijective_algebraMap`: if `K → L` is bijective, then
  `f ⊗ K` is bijective exactly when `f ⊗ L` is.
* `Stacks.Flatness.bijective_baseChange_of_isBaseChange`: the combination of the two.
* `Stacks.Flatness.smooth_of_isLocalization`: smoothness of `B` over `R` survives the base change.
* `Stacks.Flatness.geometricallyIrreducible_of_isLocalization`: geometric irreducibility of the
  fibres of `Spec(B) → Spec(R)` survives the base change.
* `Stacks.Flatness.map_map_algebraMap_eq`: the ideal `r'B'` is the ideal generated by `rB`.
* `Stacks.Flatness.isPrime_map_algebraMap_of_disjoint` and
  `Stacks.Flatness.map_algebraMap_eq_comap_of_disjoint`: if the image of `P` misses `rB`, then
  `r'B'` is prime and contracts to `rB`.
* `Stacks.Flatness.bijective_residueFieldMap_of_isLocalization`: a localization induces a bijection
  `κ(p) → κ(p')` on residue fields of a prime `p'` and its contraction `p`.
* `Stacks.Flatness.bijective_baseChange_of_isLocalization` and
  `Stacks.Flatness.fiber_bijective_of_isLocalization`: the fibre condition on `α` survives the
  base change.
* `Stacks.Flatness.finite_of_isLocalization`: finiteness of `B → A` survives the base change.
* `Stacks.Flatness.finitePresentation_mapₐ_of_isLocalization`: the localization of a surjection of
  finite presentation is of finite presentation.
* `Stacks.Flatness.range_eq_localized'_range`: the image of the localized `α` is the localization
  of the image of `α`.
* `Stacks.Flatness.surjective_of_isLocalization`: the localization of a surjective `α` is
  surjective.
* `Stacks.Flatness.isLocalizedModule_of_quotient_range`: `M' ⧸ range α'` is the localization of
  `M ⧸ range α`.

## References

* [Stacks Project, Tag 05HX](https://stacks.math.columbia.edu/tag/05HX)
* [Stacks Project, Tag 05I5](https://stacks.math.columbia.edu/tag/05I5)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

open scoped TensorProduct

universe u

namespace Stacks.Flatness

/-! ### Transport of bijectivity -/

/-- **Bijectivity transported across a commuting square of bijections.** If `f'` and `f` are
intertwined by bijections on the source and on the target, they are bijective together. -/
public theorem bijective_congr {α β α' β' : Type*} {f : α → β} {f' : α' → β'}
    (eα : α ≃ α') (eβ : β ≃ β') (h : ∀ x, f' (eα x) = eβ (f x)) :
    Function.Bijective f ↔ Function.Bijective f' := by
  have hf : f' ∘ eα = eβ ∘ f := funext h
  rw [← eα.bijective_comp, hf, eβ.comp_bijective]

/-- The base change `f ⊗ K` is bijective exactly when an additive map `f'` is, if `f'` agrees with
it on pure tensors up to additive equivalences. -/
private theorem bijective_baseChange_iff_of_tmul {B : Type*} [CommRing B]
    {X Y : Type*} [AddCommGroup X] [Module B X] [AddCommGroup Y] [Module B Y] (f : X →ₗ[B] Y)
    {K : Type*} [CommRing K] [Algebra B K] {X' Y' : Type*} [AddCommGroup X'] [AddCommGroup Y']
    (eX : K ⊗[B] X ≃+ X') (eY : K ⊗[B] Y ≃+ Y') (f' : X' →+ Y')
    (h : ∀ k x, f' (eX (k ⊗ₜ x)) = eY (k ⊗ₜ f x)) :
    Function.Bijective (f.baseChange K) ↔ Function.Bijective f' := by
  refine bijective_congr eX eY fun z => ?_
  induction z with
  | tmul k x => simpa using h k x
  | add a b ha hb => simpa using congr($ha + $hb)

/-- **The base change of a linear map is bijective exactly when any realization of it is.**
If `X'` and `Y'` are base changes of `X` and `Y` along `B → L` and `f' : X' →ₗ[L] Y'` is
compatible with `f`, then `f'` is bijective exactly when `f ⊗ L` is. -/
public theorem bijective_baseChange_iff_of_isBaseChange {B : Type*} [CommRing B]
    {X Y : Type*} [AddCommGroup X] [Module B X] [AddCommGroup Y] [Module B Y] (f : X →ₗ[B] Y)
    {L : Type*} [CommRing L] [Algebra B L]
    {X' Y' : Type*} [AddCommGroup X'] [Module B X'] [Module L X'] [IsScalarTower B L X']
    [AddCommGroup Y'] [Module B Y'] [Module L Y'] [IsScalarTower B L Y']
    {gX : X →ₗ[B] X'} {gY : Y →ₗ[B] Y'} (hX : IsBaseChange L gX) (hY : IsBaseChange L gY)
    (f' : X' →ₗ[L] Y') (hf' : ∀ x, f' (gX x) = gY (f x)) :
    Function.Bijective (f.baseChange L) ↔ Function.Bijective f' := by
  exact bijective_baseChange_iff_of_tmul f hX.equiv.toAddEquiv hY.equiv.toAddEquiv
    f'.toAddMonoidHom fun l x => by simp [IsBaseChange.equiv_tmul, hf']

/-- If `K → L` is a bijective map of `B`-algebras, then `f ⊗ K` is bijective exactly when `f ⊗ L`
is. -/
public theorem bijective_baseChange_iff_of_bijective_algebraMap {B : Type*} [CommRing B]
    {X Y : Type*} [AddCommGroup X] [Module B X] [AddCommGroup Y] [Module B Y] (f : X →ₗ[B] Y)
    {K : Type*} [CommRing K] [Algebra B K]
    {L : Type*} [CommRing L] [Algebra B L] [Algebra K L] [IsScalarTower B K L]
    (hKL : Function.Bijective (algebraMap K L)) :
    Function.Bijective (f.baseChange K) ↔ Function.Bijective (f.baseChange L) := by
  let eK : K ≃ₗ[B] L := LinearEquiv.ofBijective (IsScalarTower.toAlgHom B K L).toLinearMap hKL
  exact bijective_baseChange_iff_of_tmul f
    (TensorProduct.congr eK (LinearEquiv.refl B X)).toAddEquiv
    (TensorProduct.congr eK (LinearEquiv.refl B Y)).toAddEquiv (f.baseChange L).toAddMonoidHom
    fun k x => by simp [eK]

/-- **A fibre condition survives a base change of the fibre field.**

Let `f : X →ₗ[B] Y` become bijective after `⊗ K`, let `L` be an extension of `K` with `K → L`
bijective, and let `f' : X' →ₗ[L] Y'` be a map between base changes of `X` and `Y` along `B → L`
which is compatible with `f`. Then `f'` is bijective. -/
public theorem bijective_baseChange_of_isBaseChange {B : Type*} [CommRing B]
    {X Y : Type*} [AddCommGroup X] [Module B X] [AddCommGroup Y] [Module B Y] (f : X →ₗ[B] Y)
    {K : Type*} [CommRing K] [Algebra B K]
    {L : Type*} [CommRing L] [Algebra B L] [Algebra K L] [IsScalarTower B K L]
    (hKL : Function.Bijective (algebraMap K L))
    {X' Y' : Type*} [AddCommGroup X'] [Module B X'] [Module L X'] [IsScalarTower B L X']
    [AddCommGroup Y'] [Module B Y'] [Module L Y'] [IsScalarTower B L Y']
    {gX : X →ₗ[B] X'} {gY : Y →ₗ[B] Y'} (hX : IsBaseChange L gX) (hY : IsBaseChange L gY)
    (f' : X' →ₗ[L] Y') (hf' : ∀ x, f' (gX x) = gY (f x))
    (hf : Function.Bijective (f.baseChange K)) :
    Function.Bijective f' :=
  (bijective_baseChange_iff_of_isBaseChange f hX hY f' hf').mp
    ((bijective_baseChange_iff_of_bijective_algebraMap f hKL).mp hf)

/-! ### Smoothness and geometrically irreducible fibres -/

/-- If `B` is smooth over `R`, then the localization `B'` of `B` at the image of `P` is smooth over
the localization `R'` of `R` at `P`. -/
public theorem smooth_of_isLocalization {R : Type u} (B : Type u) [CommRing R] [CommRing B]
    [Algebra R B]
    (P : Submonoid R) (R' : Type u) [CommRing R'] [Algebra R R'] [IsLocalization P R']
    (B' : Type u) [CommRing B'] [Algebra R B'] [Algebra B B'] [Algebra R' B']
    [IsScalarTower R B B'] [IsScalarTower R R' B']
    [IsLocalization (Algebra.algebraMapSubmonoid B P) B'] [Algebra.Smooth R B] :
    Algebra.Smooth R' B' := by
  rw [← RingHom.smooth_algebraMap]
  exact RingHom.Smooth.isStableUnderBaseChange.of_isLocalization P
    (RingHom.smooth_algebraMap.mpr ‹_›)

/-- If `Spec(B) → Spec(R)` has geometrically irreducible fibres, then so does
`Spec(B') → Spec(R')`, where `R'` is the localization of `R` at `P` and `B'` that of `B` at the
image of `P`. -/
public theorem geometricallyIrreducible_of_isLocalization {R : Type u} (B : Type u) [CommRing R]
    [CommRing B] [Algebra R B] (P : Submonoid R) (R' : Type u) [CommRing R'] [Algebra R R']
    [IsLocalization P R'] (B' : Type u) [CommRing B'] [Algebra R B'] [Algebra B B'] [Algebra R' B']
    [IsScalarTower R B B'] [IsScalarTower R R' B']
    [IsLocalization (Algebra.algebraMapSubmonoid B P) B']
    [GeometricallyIrreducible (Spec.map (CommRingCat.ofHom (algebraMap R B)))] :
    GeometricallyIrreducible (Spec.map (CommRingCat.ofHom (algebraMap R' B'))) :=
  have : IsLocalization (Submonoid.map (algebraMap R B) P) B' := ‹_›
  MorphismProperty.of_isPullback (P := @GeometricallyIrreducible)
    (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_of_isLocalization (algebraMap R B) (algebraMap R' B')
        (by rw [← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]) P)) ‹_›

/-! ### The fibre prime and its residue field -/

/-- The ideal generated in `B'` by the ideal `r'` generated by `r` in `R'` is the ideal generated
by `rB`. -/
public theorem map_map_algebraMap_eq {R : Type*} (B : Type*) [CommRing R] [CommRing B]
    [Algebra R B] (r : Ideal R) (R' : Type*) [CommRing R'] [Algebra R R']
    (B' : Type*) [CommRing B'] [Algebra R B'] [Algebra B B'] [Algebra R' B']
    [IsScalarTower R B B'] [IsScalarTower R R' B'] :
    Ideal.map (algebraMap R' B') (Ideal.map (algebraMap R R') r) =
      Ideal.map (algebraMap B B') (Ideal.map (algebraMap R B) r) := by
  rw [Ideal.map_map, Ideal.map_map, ← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]

/-- If `rB` is prime and the image of `P` in `B` misses it, then the ideal generated by `r` in the
localization `B'` of `B` at the image of `P` is prime. -/
public theorem isPrime_map_algebraMap_of_disjoint {R B : Type*} [CommRing R] [CommRing B]
    [Algebra R B] (P : Submonoid R) (r : Ideal R) (R' : Type*) [CommRing R'] [Algebra R R']
    (B' : Type*) [CommRing B'] [Algebra R B'] [Algebra B B'] [Algebra R' B']
    [IsScalarTower R B B'] [IsScalarTower R R' B']
    [IsLocalization (Algebra.algebraMapSubmonoid B P) B']
    [(Ideal.map (algebraMap R B) r).IsPrime]
    (hd : Disjoint ((Algebra.algebraMapSubmonoid B P : Submonoid B) : Set B)
      ((Ideal.map (algebraMap R B) r : Ideal B) : Set B)) :
    (Ideal.map (algebraMap R' B') (Ideal.map (algebraMap R R') r)).IsPrime := by
  rw [map_map_algebraMap_eq B r R' B']
  exact IsLocalization.isPrime_of_isPrime_disjoint (Algebra.algebraMapSubmonoid B P) B' _ ‹_› hd

/-- If `rB` is prime and the image of `P` in `B` misses it, then `rB` is the contraction of the
ideal generated by `r` in the localization `B'` of `B` at the image of `P`. -/
public theorem map_algebraMap_eq_comap_of_disjoint {R B : Type*} [CommRing R] [CommRing B]
    [Algebra R B] (P : Submonoid R) (r : Ideal R) (R' : Type*) [CommRing R'] [Algebra R R']
    (B' : Type*) [CommRing B'] [Algebra R B'] [Algebra B B'] [Algebra R' B']
    [IsScalarTower R B B'] [IsScalarTower R R' B']
    [IsLocalization (Algebra.algebraMapSubmonoid B P) B']
    [(Ideal.map (algebraMap R B) r).IsPrime]
    (hd : Disjoint ((Algebra.algebraMapSubmonoid B P : Submonoid B) : Set B)
      ((Ideal.map (algebraMap R B) r : Ideal B) : Set B)) :
    Ideal.map (algebraMap R B) r =
      (Ideal.map (algebraMap R' B') (Ideal.map (algebraMap R R') r)).comap (algebraMap B B') := by
  rw [map_map_algebraMap_eq B r R' B']
  exact (IsLocalization.under_map_of_isPrime_disjoint
    (Algebra.algebraMapSubmonoid B P) B' ‹_› hd).symm

/-- If `B'` is a localization of `B`, `p'` is a prime of `B'` and `p` is its contraction to `B`,
then the induced map of residue fields `κ(p) → κ(p')` is bijective. -/
public theorem bijective_residueFieldMap_of_isLocalization {B B' : Type*} [CommRing B]
    [CommRing B'] [Algebra B B'] (P : Submonoid B) [IsLocalization P B']
    (p : Ideal B) [p.IsPrime] (p' : Ideal B') [p'.IsPrime]
    (hp' : p = p'.comap (algebraMap B B')) :
    Function.Bijective (Ideal.ResidueField.map p p' (algebraMap B B') hp') :=
  (RingHom.surjectiveOnStalks_of_isLocalization P B').residueFieldMap_bijective p p' hp'

/-! ### The fibre condition on `α` -/

/-- Let `B'` be a localization of `B`, `g : M → M'` a localization of `B`-modules, and
`alpha' : B'^(⊕ m) → M'` the localization of `alpha : B^(⊕ m) → M` (hypothesis `halpha`). Let `K`
be a `B`-algebra and `L` a `B'`-algebra with a bijective `B`-algebra map `K → L`. If `alpha ⊗ K` is
bijective, then so is `alpha' ⊗ L`. -/
public theorem bijective_baseChange_of_isLocalization {B : Type*} [CommRing B] {M : Type*}
    [AddCommGroup M] [Module B M] {m : ℕ} (alpha : (Fin m →₀ B) →ₗ[B] M)
    {B' : Type*} [CommRing B'] [Algebra B B'] (P : Submonoid B) [IsLocalization P B']
    {M' : Type*} [AddCommGroup M'] [Module B M'] [Module B' M'] [IsScalarTower B B' M']
    (g : M →ₗ[B] M') [IsLocalizedModule P g]
    (alpha' : (Fin m →₀ B') →ₗ[B'] M')
    (halpha : ∀ x, alpha' (Finsupp.mapRange.linearMap (Algebra.linearMap B B') x) = g (alpha x))
    {K : Type*} [CommRing K] [Algebra B K]
    {L : Type*} [CommRing L] [Algebra B L] [Algebra B' L] [IsScalarTower B B' L]
    [Algebra K L] [IsScalarTower B K L]
    (hKL : Function.Bijective (algebraMap K L))
    (hf : Function.Bijective (alpha.baseChange K)) :
    Function.Bijective (alpha'.baseChange L) := by
  have hloc : IsLocalizedModule P (Algebra.linearMap B B') :=
    isLocalizedModule_iff_isLocalization.mpr inferInstance
  refine bijective_baseChange_of_isBaseChange alpha hKL
    ((IsLocalizedModule.isBaseChange P B'
      (Finsupp.mapRange.linearMap (α := Fin m) (Algebra.linearMap B B'))).comp
        (TensorProduct.isBaseChange B' (Fin m →₀ B') L))
    ((IsLocalizedModule.isBaseChange P B' g).comp (TensorProduct.isBaseChange B' M' L))
    (alpha'.baseChange L) (fun x => ?_) hf
  simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Function.comp_apply,
    TensorProduct.mk_apply, LinearMap.baseChange_tmul, halpha]

/-- Let `B'` be a localization of `B` and `alpha' : B'^(⊕ m) → M'` the localization of
`alpha : B^(⊕ m) → M` (hypothesis `halpha`). If `p'` is a prime of `B'` contracting to the prime
`p` of `B` and `alpha` becomes bijective over `κ(p)`, then `alpha'` becomes bijective over
`κ(p')`. -/
public theorem fiber_bijective_of_isLocalization {B : Type*} [CommRing B] {M : Type*}
    [AddCommGroup M] [Module B M] {m : ℕ} (alpha : (Fin m →₀ B) →ₗ[B] M)
    {B' : Type*} [CommRing B'] [Algebra B B'] (P : Submonoid B) [IsLocalization P B']
    {M' : Type*} [AddCommGroup M'] [Module B M'] [Module B' M'] [IsScalarTower B B' M']
    (g : M →ₗ[B] M') [IsLocalizedModule P g]
    (alpha' : (Fin m →₀ B') →ₗ[B'] M')
    (halpha : ∀ x, alpha' (Finsupp.mapRange.linearMap (Algebra.linearMap B B') x) = g (alpha x))
    (p : Ideal B) [p.IsPrime] (p' : Ideal B') [p'.IsPrime]
    (hp' : p = p'.comap (algebraMap B B'))
    (hf : Function.Bijective (alpha.baseChange p.ResidueField)) :
    Function.Bijective (alpha'.baseChange p'.ResidueField) :=
  let _ : Algebra B p'.ResidueField :=
    ((algebraMap B' p'.ResidueField).comp (algebraMap B B')).toAlgebra
  have _ : IsScalarTower B B' p'.ResidueField := IsScalarTower.of_algebraMap_eq' rfl
  let _ : Algebra p.ResidueField p'.ResidueField :=
    (Ideal.ResidueField.map p p' (algebraMap B B') hp').toAlgebra
  have _ : IsScalarTower B p.ResidueField p'.ResidueField :=
    IsScalarTower.of_algebraMap_eq fun b =>
      (Ideal.ResidueField.map_algebraMap p p' (algebraMap B B') hp' b).symm
  bijective_baseChange_of_isLocalization alpha P g alpha' halpha
    (bijective_residueFieldMap_of_isLocalization P p p' hp') hf

/-! ### Finiteness and finite presentation -/

/-- If `A` is finite over `B`, then the localization `A'` of `A` at the image of `P` is finite over
the localization `B'` of `B` at the image of `P`. -/
public theorem finite_of_isLocalization {R : Type*} [CommRing R] (P : Submonoid R)
    {A B : Type*} [CommRing A] [CommRing B] [Algebra R A] [Algebra R B] [Algebra B A]
    [IsScalarTower R B A] [Module.Finite B A]
    (B' : Type*) [CommRing B'] [Algebra R B'] [Algebra B B'] [IsScalarTower R B B']
    [IsLocalization (Algebra.algebraMapSubmonoid B P) B']
    (A' : Type*) [CommRing A'] [Algebra R A'] [Algebra A A'] [IsScalarTower R A A']
    [IsLocalization (Algebra.algebraMapSubmonoid A P) A']
    [Algebra B A'] [IsScalarTower B A A'] [Algebra B' A'] [IsScalarTower B B' A'] :
    Module.Finite B' A' :=
  have : IsLocalization (Algebra.algebraMapSubmonoid A (Algebra.algebraMapSubmonoid B P)) A' := by
    rwa [Algebra.algebraMapSubmonoid_map_map]
  Module.Finite.of_isLocalization B A (Algebra.algebraMapSubmonoid B P)

/-- **Finite presentation of a surjection survives a localization of the base.**

If `f : S →ₐ[R] A` is surjective and of finite presentation, then so is the induced map on the
localizations at the image of a submonoid of `R`. -/
public theorem finitePresentation_mapₐ_of_isLocalization {R : Type*} [CommRing R]
    (P : Submonoid R) {S A : Type*} [CommRing S] [CommRing A] [Algebra R S] [Algebra R A]
    (f : S →ₐ[R] A) (hsurj : Function.Surjective f) (hfp : (f : S →+* A).FinitePresentation)
    (R' : Type*) [CommRing R'] [Algebra R R'] [IsLocalization P R']
    (S' : Type*) [CommRing S'] [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S P) S'] [Algebra R' S'] [IsScalarTower R R' S']
    (A' : Type*) [CommRing A'] [Algebra R A'] [Algebra A A'] [IsScalarTower R A A']
    [IsLocalization (Algebra.algebraMapSubmonoid A P) A'] [Algebra R' A']
    [IsScalarTower R R' A'] :
    ((IsLocalization.mapₐ P R' S' A' f : S' →ₐ[R'] A') : S' →+* A').FinitePresentation := by
  have hker : (RingHom.ker (f : S →+* A)).FG := by
    let _ : Algebra S A := (f : S →+* A).toAlgebra
    have _ : Algebra.FinitePresentation S A := hfp
    exact Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId S A) hsurj
  refine RingHom.FinitePresentation.of_surjective _
    (IsLocalization.mapₐ_surjective_of_surjective P R' S' A' f hsurj) ?_
  rw [show ((IsLocalization.mapₐ P R' S' A' f : S' →ₐ[R'] A') : S' →+* A') =
      IsLocalization.map A' (f : S →+* A) (Algebra.algebraMapSubmonoid_le_comap P f) from rfl,
    IsLocalization.ker_map A' (f : S →+* A) (Algebra.algebraMapSubmonoid_map_eq P f)]
  exact hker.map _

/-! ### The cokernel -/

section Cokernel

variable {B : Type*} [CommRing B] {B' : Type*} [CommRing B'] [Algebra B B']
  (P : Submonoid B) [IsLocalization P B']
  {X M : Type*} [AddCommGroup X] [Module B X] [AddCommGroup M] [Module B M]
  {X' M' : Type*} [AddCommGroup X'] [Module B X'] [Module B' X'] [IsScalarTower B B' X']
  [AddCommGroup M'] [Module B M'] [Module B' M'] [IsScalarTower B B' M']
  (gX : X →ₗ[B] X') [IsLocalizedModule P gX] (g : M →ₗ[B] M') [IsLocalizedModule P g]
  (alpha : X →ₗ[B] M) (alpha' : X' →ₗ[B'] M')

/-- **The image of the localized map is the localization of the image.**

If `alpha'` is the localization of `alpha`, then the range of `alpha'` is the localization of the
range of `alpha` in the sense of `Submodule.localized'`. -/
public theorem range_eq_localized'_range (halpha : ∀ x, alpha' (gX x) = g (alpha x)) :
    LinearMap.range alpha' = (LinearMap.range alpha).localized' B' P g := by
  rw [Submodule.localized'_eq_span]
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · rintro y ⟨x', rfl⟩
    obtain ⟨⟨x, s⟩, hs⟩ := IsLocalizedModule.surj P gX x'
    have hs' : (s : B) • x' = gX x := hs
    have hu : IsUnit (algebraMap B B' (s : B)) := IsLocalization.map_units B' s
    have hy : (algebraMap B B' (s : B)) • alpha' x' ∈
        Submodule.span B' (g '' LinearMap.range alpha) := by
      rw [algebraMap_smul, ← LinearMap.map_smul_of_tower, hs', halpha]
      exact Submodule.subset_span ⟨alpha x, ⟨x, rfl⟩, rfl⟩
    have hz := Submodule.smul_mem _ (↑hu.unit⁻¹ : B') hy
    rwa [smul_smul, hu.val_inv_mul, one_smul] at hz
  · rintro y ⟨m, ⟨x, rfl⟩, rfl⟩
    exact ⟨gX x, halpha x⟩

include P in
/-- If `alpha'` is the localization of `alpha` and `alpha` is surjective, then so is `alpha'`. -/
public theorem surjective_of_isLocalization (halpha : ∀ x, alpha' (gX x) = g (alpha x))
    (h : Function.Surjective alpha) : Function.Surjective alpha' := by
  rw [← LinearMap.range_eq_top, range_eq_localized'_range P gX g alpha alpha' halpha,
    LinearMap.range_eq_top.mpr h, Submodule.localized'_top]

/-- **The cokernel of the localized map is the localization of the cokernel.** If `alpha'` is the
localization of `alpha`, then any map `q : M ⧸ range alpha → M' ⧸ range alpha'` sending the class
of `m` to the class of `g m` is a localization at `P`. -/
public theorem isLocalizedModule_of_quotient_range (halpha : ∀ x, alpha' (gX x) = g (alpha x))
    (q : (M ⧸ LinearMap.range alpha) →ₗ[B] (M' ⧸ LinearMap.range alpha'))
    (hq : ∀ m, q (Submodule.Quotient.mk m) = Submodule.Quotient.mk (g m)) :
    IsLocalizedModule P q := by
  have heq := range_eq_localized'_range P gX g alpha alpha' halpha
  have hqeq : q = ((Submodule.quotEquivOfEq _ _ heq.symm).restrictScalars B).toLinearMap ∘ₗ
      (LinearMap.range alpha).toLocalizedQuotient' B' P g := by
    refine LinearMap.ext fun z => ?_
    obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    simp [hq, Submodule.quotEquivOfEq_mk]
  rw [hqeq]
  infer_instance

end Cokernel

end Stacks.Flatness
