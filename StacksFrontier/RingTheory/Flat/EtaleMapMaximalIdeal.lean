module

public import Mathlib.RingTheory.Unramified.LocalRing
public import Mathlib.RingTheory.Etale.Locus
public import StacksCore.Tactic.StacksAttribute

/-!
# The maximal ideal of a local ring of an unramified algebra

Let `R → R'` be essentially of finite type and formally unramified — for instance étale, or an
étale algebra followed by a localization — and let `p'` be a prime of `R'` lying over a prime `p`
of `R`.  Then the local ring `R'_{p'}` is generated over `R_p` by nothing:  the ideal generated by
`p` in `R'_{p'}` is already the whole maximal ideal.  This is the local form of the statement that
an unramified map has discrete fibres, and it is the computation [Stacks, Tag 00UW] /
[Stacks, Tag 02FM] in the shape Mathlib's `Algebra.FormallyUnramified.map_maximalIdeal` provides.

The proof transports that lemma along `R_p → R'_{p'}`, the map of local rings induced by `R → R'`
(`Localization.AtPrime.algebraOfLiesOver`).  Its hypotheses hold because a localization is
formally étale, so `R → R'_{p'}` is formally unramified and hence so is `R_p → R'_{p'}` after
restricting scalars, while `R_p → R'_{p'}` is essentially of finite type because `R → R'_{p'}` is
and is local because it is a `Localization.localRingHom`.  Rewriting
`IsLocalization.AtPrime.map_eq_maximalIdeal` then replaces the maximal ideal of `R_p` by the image
of `p`, and the scalar tower collapses the two maps into `algebraMap R (Localization.AtPrime p')`.

The companion statement needs no hypothesis on `R → R'` at all:  contracting the maximal ideal of
`R'_{p'}` along `R → R'_{p'}` always returns `p`, because it contracts to `p'` in `R'` and `p'`
lies over `p`.

## Main results

* `Algebra.map_eq_maximalIdeal_localizationAtPrime_of_formallyUnramified`: for `R → R'`
  essentially of finite type and formally unramified and `p'` a prime of `R'` over `p`, the ideal
  generated by `p` in `Localization.AtPrime p'` is its maximal ideal.
* `Algebra.comap_maximalIdeal_localizationAtPrime_eq`: the maximal ideal of
  `Localization.AtPrime p'` contracts to `p` in `R`.

## References

* [Stacks Project, Tag 00UW](https://stacks.math.columbia.edu/tag/00UW)
* [Stacks Project, Tag 02FM](https://stacks.math.columbia.edu/tag/02FM)
-/

@[expose] public section

universe u

open IsLocalRing

/-- **The maximal ideal of a local ring of an unramified algebra is generated by the base.**  If
`R → R'` is essentially of finite type and formally unramified and `p'` is a prime of `R'` lying
over a prime `p` of `R`, then the ideal generated by `p` in `R'_{p'}` is the maximal ideal of
`R'_{p'}`. -/
@[stacks 02FM "The displayed equality `m_{p'} = p R'_{p'}`, for `R → R'` formally unramified and
essentially of finite type rather than étale.", ega "IV 18.6.1" "more general"]
theorem Algebra.map_eq_maximalIdeal_localizationAtPrime_of_formallyUnramified
    {R R' : Type u} [CommRing R] [CommRing R'] [Algebra R R']
    [Algebra.EssFiniteType R R'] [Algebra.FormallyUnramified R R']
    (p : Ideal R) [p.IsPrime] (p' : Ideal R') [p'.IsPrime] [p'.LiesOver p] :
    Ideal.map (algebraMap R (Localization.AtPrime p')) p
      = IsLocalRing.maximalIdeal (Localization.AtPrime p') := by
  let := Localization.AtPrime.algebraOfLiesOver p p'
  have : Algebra.EssFiniteType (Localization.AtPrime p) (Localization.AtPrime p') :=
    .of_comp R _ _
  have : Algebra.FormallyUnramified R (Localization.AtPrime p') :=
    .comp R R' (Localization.AtPrime p')
  have : Algebra.FormallyUnramified (Localization.AtPrime p) (Localization.AtPrime p') :=
    .of_restrictScalars R _ _
  have : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime p')) := by
    rw [Localization.AtPrime.algebraMap_eq]
    exact Localization.isLocalHom_localRingHom p p' (algebraMap R R') Ideal.LiesOver.over
  have h := Algebra.FormallyUnramified.map_maximalIdeal
    (R := Localization.AtPrime p) (S := Localization.AtPrime p')
  rwa [← IsLocalization.AtPrime.map_eq_maximalIdeal p (Localization.AtPrime p), Ideal.map_map,
    ← IsScalarTower.algebraMap_eq] at h

/-- The maximal ideal of `R'_{p'}` contracts to `p` in `R`, for any prime `p'` of `R'` lying over
a prime `p` of `R`:  it contracts to `p'` in `R'`, and `p'` lies over `p`. -/
theorem Algebra.comap_maximalIdeal_localizationAtPrime_eq
    {R R' : Type u} [CommRing R] [CommRing R'] [Algebra R R']
    (p : Ideal R) [p.IsPrime] (p' : Ideal R') [p'.IsPrime] [p'.LiesOver p] :
    (IsLocalRing.maximalIdeal (Localization.AtPrime p')).comap
        (algebraMap R (Localization.AtPrime p')) = p := by
  rw [IsScalarTower.algebraMap_eq R R' (Localization.AtPrime p'), ← Ideal.comap_comap]
  change ((IsLocalRing.maximalIdeal (Localization.AtPrime p')).under R').under R = p
  rw [IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime p') p']
  exact (Ideal.LiesOver.over (p := p) (P := p')).symm

end
