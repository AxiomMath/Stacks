module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.FiniteOverSmooth.PurelyTranscendental
public import StacksFrontier.RingTheory.Flat.CompleteDevissagePointedChain
public import StacksFrontier.RingTheory.Flat.DevissageLocalizeAwayProjective
public import StacksFrontier.RingTheory.Flat.DevissageQuotientBase
public import StacksFrontier.RingTheory.Flat.DevissagePrimeDataLocalize
public import StacksFrontier.RingTheory.RelativeDimension.Basic
public import StacksFrontier.RingTheory.Support.Fiber

/-!
# Away-localizing a pointed complete dévissage

Given a pointed complete dévissage of `N/S/R` over a prime `r` of `R`, pointed at a prime `q` of
`S`, and an element `a ∉ r`, localizing every ring and module at the image of the powers of `a`
gives a pointed complete dévissage of the localized data over `rR_a`, pointed at `qS_a`. The
residue field, fibre support and relative dimension conditions on the chosen primes are
transported along the localization.

## Main definitions

* `Module.CompleteDevissage.locAwayLowerPrime`, `Module.CompleteDevissage.locAwayUpperPrime`: the
  ideals generated by the chosen primes of a stage in the away-localized stage algebras.
* `Module.CompleteDevissage.locAwayPointed`: the away-localized pointed datum of a stage.
* `Module.PointedCompleteDevissage.localizeAway`: the base change of a pointed complete dévissage
  along the localization of its base away from an element outside its base prime.
* `Module.NonemptyCompleteDevissageAt.toPointedCompleteDevissage`: a nonempty complete dévissage
  at `q` as a pointed complete dévissage over `q.under R`.
* `Module.NonemptyCompleteDevissageAt.localizeAway`: the base change of a nonempty complete
  dévissage at a prime along the localization of its base away from an element.

## Main results

* `Stacks.Flatness.purelyTranscendental_residueField_away`: a purely transcendental residue
  extension stays purely transcendental after an away-localization of the base.
* `Stacks.Flatness.mem_support_fiber_away`: membership of a prime in the support of the fibre
  module is preserved by an away-localization of the base.
* `Stacks.Flatness.relativeDimension_eq_support_away`: the equality of the relative dimension
  with the local dimension of the support of the fibre module is preserved by an
  away-localization of the base.
* `Stacks.Flatness.relativeDimensionAt_away`: `dim_Q((C_a)/R_a) = dim_{Q ∩ C}(C/R)`.
* `Stacks.Flatness.fiberSupport_away_eq_preimage`: the part of the support lying over the base
  prime upstairs is the inverse image of the part lying over the base prime downstairs.
* `Module.PointedCompleteDevissage.disjoint_algebraMapSubmonoid_powers`: the powers of `a` miss
  the prime at which the dévissage is pointed.

## References

* [Stacks Project, Tag 05HZ](https://stacks.math.columbia.edu/tag/05HZ)
* [Stacks Project, Tag 05HX](https://stacks.math.columbia.edu/tag/05HX)
* [Stacks Project, Tag 00QD](https://stacks.math.columbia.edu/tag/00QD)
* [Stacks Project, Tag 0BUR](https://stacks.math.columbia.edu/tag/0BUR)
-/

@[expose] public section

open TensorProduct TopologicalSpace

attribute [local instance] Algebra.TensorProduct.rightAlgebra

universe u v w

namespace Stacks.Flatness

/-! ### The away-localization of an algebra at an element of the base -/

section AwayAlgebra

variable {R C : Type*} [CommRing R] [CommRing C] [Algebra R C] (a : R)
  (C' : Type*) [CommRing C'] [Algebra C C']
  [IsLocalization (Algebra.algebraMapSubmonoid C (Submonoid.powers a)) C']

/-- If `C'` is the localization of the `R`-algebra `C` at the image of the powers of `a : R`, then
`C'` is the localization of `C` away from `algebraMap R C a`. -/
public theorem isLocalizationAway_algebraMap : IsLocalization.Away (algebraMap R C a) C' := by
  change IsLocalization (Submonoid.powers (algebraMap R C a)) C'
  rw [← Algebra.algebraMapSubmonoid_powers]
  infer_instance

include a in
/-- For a subspace `X` of `Spec C` and a point `z` of `Spec C_a` mapping into `X`, the local
dimension at `z` of the inverse image of `X` in `Spec C_a` is the local dimension of `X` at the
image of `z`. -/
public theorem topologicalKrullDimAt_preimage_comap_away (X : Set (PrimeSpectrum C))
    (z : PrimeSpectrum C') (hz : PrimeSpectrum.comap (algebraMap C C') z ∈ X) :
    topologicalKrullDimAt ↥(PrimeSpectrum.comap (algebraMap C C') ⁻¹' X) ⟨z, hz⟩
      = topologicalKrullDimAt ↥X ⟨PrimeSpectrum.comap (algebraMap C C') z, hz⟩ := by
  have : IsLocalization.Away (algebraMap R C a) C' := isLocalizationAway_algebraMap a C'
  have hoe : Topology.IsOpenEmbedding (PrimeSpectrum.comap (algebraMap C C')) :=
    PrimeSpectrum.localization_away_isOpenEmbedding C' (algebraMap R C a)
  exact ((hoe.restrictPreimage X).topologicalKrullDimAt_eq ⟨z, hz⟩).symm

variable {M M' : Type*} [AddCommGroup M] [Module C M] [Module.Finite C M]
  [AddCommGroup M'] [Module C M'] [Module C' M'] [IsScalarTower C C' M']
  (f : M →ₗ[C] M')
  [IsLocalizedModule (Algebra.algebraMapSubmonoid C (Submonoid.powers a)) f]

include a f in
/-- The support of the localization `M'` of `M` at the image of the powers of `a` is the inverse
image of the support of `M` under `Spec C_a → Spec C`. -/
public theorem support_away_eq_preimage :
    Module.support C' M' = PrimeSpectrum.comap (algebraMap C C') ⁻¹' Module.support C M :=
  (IsLocalizedModule.isBaseChange (Algebra.algebraMapSubmonoid C (Submonoid.powers a)) C'
    f).support_eq_preimage_comap

end AwayAlgebra

/-! ### Localizing the base away from an element, with both scalar towers -/

section AwayBaseAux

variable {R C : Type*} [CommRing R] [CommRing C] [Algebra R C] (a : R)
  (Ra : Type*) [CommRing Ra] [Algebra R Ra] [IsLocalization.Away a Ra]
  (C' : Type*) [CommRing C'] [Algebra C C']
  [IsLocalization (Algebra.algebraMapSubmonoid C (Submonoid.powers a)) C']
  [Algebra R C'] [IsScalarTower R C C'] [Algebra Ra C'] [IsScalarTower R Ra C']

include a in
/-- A prime of `C_a` lies over a prime `r'` of `R_a` if and only if it lies over the contraction
`r` of `r'` to `R`. -/
public theorem comap_algebraMap_away_eq_iff (z : PrimeSpectrum C') (r : Ideal R) [r.IsPrime]
    (r' : Ideal Ra) [r'.IsPrime] (hr : r'.comap (algebraMap R Ra) = r) :
    PrimeSpectrum.comap (algebraMap Ra C') z = ⟨r', ‹_›⟩ ↔
      PrimeSpectrum.comap (algebraMap R C') z = ⟨r, ‹_›⟩ := by
  have hRa : PrimeSpectrum.comap (algebraMap R Ra) (⟨r', ‹_›⟩ : PrimeSpectrum Ra)
      = (⟨r, ‹_›⟩ : PrimeSpectrum R) := PrimeSpectrum.ext hr
  constructor
  · intro h
    rw [← PrimeSpectrum.comap_comap_algebraMap (B := Ra) z, h, hRa]
  · intro h
    refine PrimeSpectrum.localization_comap_injective Ra (Submonoid.powers a) ?_
    rw [PrimeSpectrum.comap_comap_algebraMap (B := Ra) z, h, hRa]

include a in
/-- The fibre of `Spec C_a → Spec R_a` through a point of `Spec C_a` is the fibre of
`Spec C_a → Spec R` through it, as a subset of `Spec C_a`. -/
public theorem fibre_away_eq (z : PrimeSpectrum C') :
    PrimeSpectrum.comap (algebraMap Ra C') ⁻¹'
        {PrimeSpectrum.comap (algebraMap Ra C') z}
      = PrimeSpectrum.comap (algebraMap R C') ⁻¹'
        {PrimeSpectrum.comap (algebraMap R C') z} := by
  have hr : (PrimeSpectrum.comap (algebraMap Ra C') z).asIdeal.comap (algebraMap R Ra)
      = (PrimeSpectrum.comap (algebraMap R C') z).asIdeal :=
    congrArg PrimeSpectrum.asIdeal (PrimeSpectrum.comap_comap_algebraMap (B := Ra) z)
  ext w
  rw [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_preimage, Set.mem_singleton_iff]
  exact comap_algebraMap_away_eq_iff a Ra C' w _ _ hr

include a in
/-- The relative dimension of `C_a` at a prime is the same over `R_a` as over `R`. -/
public theorem relativeDimensionAt_base_away (Q : Ideal C') [Q.IsPrime] :
    Algebra.relativeDimensionAt Ra Q = Algebra.relativeDimensionAt R Q := by
  rw [Algebra.relativeDimensionAt, Algebra.relativeDimensionAt]
  exact topologicalKrullDimAt_eq_of_homeomorph
    (Homeomorph.setCongr (fibre_away_eq a Ra C' ⟨Q, ‹_›⟩)) _

end AwayBaseAux

/-! ### Localizing the base away from an element -/

section AwayBase

variable {R C : Type*} [CommRing R] [CommRing C] [Algebra R C] (a : R)
  (Ra : Type*) [CommRing Ra] [Algebra R Ra] [IsLocalization.Away a Ra]
  (C' : Type*) [CommRing C'] [Algebra C C'] [Algebra Ra C']
  (hloc : IsLocalization (Algebra.algebraMapSubmonoid C (Submonoid.powers a)) C')
  (hcompat : ∀ x : R,
    algebraMap Ra C' (algebraMap R Ra x) = algebraMap C C' (algebraMap R C x))

include a hloc hcompat in
/-- Let `C_a` be the localization of `C` at the image of the powers of `a` (`hloc`), an
`R_a`-algebra such that the two maps `R → C_a` agree (`hcompat`). Then the relative dimension of
`C_a/R_a` at a prime `Q` is the relative dimension of `C/R` at the contraction of `Q` to `C`. -/
public theorem relativeDimensionAt_away (Q : Ideal C') [Q.IsPrime] :
    Algebra.relativeDimensionAt Ra Q
      = Algebra.relativeDimensionAt R (Q.comap (algebraMap C C')) := by
  have := hloc
  let : Algebra R C' := ((algebraMap C C').comp (algebraMap R C)).toAlgebra
  have : IsScalarTower R C C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R Ra C' := IsScalarTower.of_algebraMap_eq fun x => (hcompat x).symm
  have : IsLocalization.Away (algebraMap R C a) C' := isLocalizationAway_algebraMap a C'
  rw [relativeDimensionAt_base_away a Ra C' Q]
  exact (Algebra.relativeDimensionAt_comap_eq (algebraMap R C a) C' Q).symm

include a hloc hcompat in
/-- Under the hypotheses `hloc` and `hcompat`, the relative dimension of `C_a/R_a` is at most the
relative dimension of `C/R`. -/
public theorem relativeDimension_away_le :
    Algebra.relativeDimension Ra C' ≤ Algebra.relativeDimension R C := by
  have := hloc
  rw [Algebra.relativeDimension]
  refine iSup_le fun Q => ?_
  have hQ := relativeDimensionAt_away (C := C) a Ra C' hloc hcompat Q.asIdeal
  rw [hQ, Algebra.relativeDimension]
  exact le_iSup (fun w : PrimeSpectrum C => Algebra.relativeDimensionAt R w.asIdeal)
    (PrimeSpectrum.comap (algebraMap C C') Q)

variable {M M' : Type*} [AddCommGroup M] [Module C M] [Module.Finite C M]
  [AddCommGroup M'] [Module C' M'] [Module.Finite C' M']
  (hsupp : Module.support C' M'
    = PrimeSpectrum.comap (algebraMap C C') ⁻¹' Module.support C M)
  (r : Ideal R) [r.IsPrime] (r' : Ideal Ra) [r'.IsPrime] (p : Ideal C) [p.IsPrime]
  (p' : Ideal C') [p'.IsPrime]

omit [Module.Finite C M] [Module.Finite C' M'] in
include a hloc hcompat hsupp in
/-- Under the hypotheses `hloc` and `hcompat`, and given that the support of `M'` is the inverse
image of the support of `M` (`hsupp`), the part of the support of `M'` lying over a prime `r'` of
`R_a` is the inverse image under `Spec C_a → Spec C` of the part of the support of `M` lying over
the contraction `r` of `r'`. -/
public theorem fiberSupport_away_eq_preimage (hr : r'.comap (algebraMap R Ra) = r) :
    Module.fiberSupport Ra C' M' r'
      = PrimeSpectrum.comap (algebraMap C C') ⁻¹' Module.fiberSupport R C M r := by
  have := hloc
  let : Algebra R C' := ((algebraMap C C').comp (algebraMap R C)).toAlgebra
  have : IsScalarTower R C C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R Ra C' := IsScalarTower.of_algebraMap_eq fun x => (hcompat x).symm
  have hfib : PrimeSpectrum.comap (algebraMap Ra C') ⁻¹' {(⟨r', ‹_›⟩ : PrimeSpectrum Ra)}
      = PrimeSpectrum.comap (algebraMap C C') ⁻¹'
        (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {(⟨r, ‹_›⟩ : PrimeSpectrum R)}) := by
    ext w
    rw [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_preimage, Set.mem_preimage,
      PrimeSpectrum.comap_comap_algebraMap (R := R) (B := C) w, Set.mem_singleton_iff]
    exact comap_algebraMap_away_eq_iff a Ra C' w r r' hr
  rw [Module.fiberSupport, Module.fiberSupport, hsupp, hfib, ← Set.preimage_inter]

omit [Algebra R Ra] [IsLocalization.Away a Ra] in
include hsupp in
/-- Assume the support of `M'` is the inverse image of the support of `M` (`hsupp`), and let `p'`
be a prime of `C_a` over `r'` contracting to the prime `p` of `C` over `r`. If the point of the
fibre over `r` given by `p` lies in the support of the fibre module of `M`, then the point of the
fibre over `r'` given by `p'` lies in the support of the fibre module of `M'`. -/
public theorem mem_support_fiber_away (hp : p'.comap (algebraMap C C') = p)
    (hover : p.LiesOver r) (hover' : p'.LiesOver r')
    (hmem : PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩ ∈
      Module.support (r.Fiber C) (TensorProduct C (r.Fiber C) M)) :
    PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩ ∈
      Module.support (r'.Fiber C') (TensorProduct C' (r'.Fiber C') M') := by
  rw [Module.primesOverOrderIsoFiber_mem_support_iff Ra C' M' r' p' hover', hsupp,
    Set.mem_preimage,
    show PrimeSpectrum.comap (algebraMap C C') (⟨p', ‹_›⟩ : PrimeSpectrum C')
        = (⟨p, ‹_›⟩ : PrimeSpectrum C) from PrimeSpectrum.ext hp]
  exact (Module.primesOverOrderIsoFiber_mem_support_iff R C M r p hover).mp hmem

include a hloc hcompat hsupp in
/-- Under the hypotheses `hloc`, `hcompat` and `hsupp`, the local dimension of the support of the
fibre module of `M'` over `r'` at the point given by `p'` is the local dimension of the support of
the fibre module of `M` over `r` at the point given by `p`. -/
public theorem topologicalKrullDimAt_support_fiber_away
    (hr : r'.comap (algebraMap R Ra) = r) (hp : p'.comap (algebraMap C C') = p)
    (hover : p.LiesOver r) (hover' : p'.LiesOver r')
    (hmem : PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩ ∈
      Module.support (r.Fiber C) (TensorProduct C (r.Fiber C) M))
    (hmem' : PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩ ∈
      Module.support (r'.Fiber C') (TensorProduct C' (r'.Fiber C') M')) :
    topologicalKrullDimAt ↥(Module.support (r'.Fiber C') (TensorProduct C' (r'.Fiber C') M'))
        ⟨PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩, hmem'⟩
      = topologicalKrullDimAt ↥(Module.support (r.Fiber C) (TensorProduct C (r.Fiber C) M))
        ⟨PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩, hmem⟩ := by
  have := hloc
  have hcomap' : PrimeSpectrum.comap (algebraMap C' (r'.Fiber C'))
      (PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩)
      = (⟨p', ‹_›⟩ : PrimeSpectrum C') :=
    PrimeSpectrum.comap_primesOverOrderIsoFiber Ra C' r' p' hover'
  have hcomap : PrimeSpectrum.comap (algebraMap C (r.Fiber C))
      (PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩)
      = (⟨p, ‹_›⟩ : PrimeSpectrum C) :=
    PrimeSpectrum.comap_primesOverOrderIsoFiber R C r p hover
  have hfs' : (⟨p', ‹_›⟩ : PrimeSpectrum C') ∈ Module.fiberSupport Ra C' M' r' :=
    hcomap' ▸ Module.comap_mem_fiberSupport Ra C' M' r' hmem'
  have hfs : (⟨p, ‹_›⟩ : PrimeSpectrum C) ∈ Module.fiberSupport R C M r :=
    hcomap ▸ Module.comap_mem_fiberSupport R C M r hmem
  rw [Module.topologicalKrullDimAt_support_fiber Ra C' M' r' hmem',
    Module.topologicalKrullDimAt_support_fiber R C M r hmem,
    show (⟨PrimeSpectrum.comap (algebraMap C' (r'.Fiber C'))
            (PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩),
          Module.comap_mem_fiberSupport Ra C' M' r' hmem'⟩ :
          ↥(Module.fiberSupport Ra C' M' r')) = ⟨⟨p', ‹_›⟩, hfs'⟩ from Subtype.ext hcomap',
    show (⟨PrimeSpectrum.comap (algebraMap C (r.Fiber C))
            (PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩),
          Module.comap_mem_fiberSupport R C M r hmem⟩ :
          ↥(Module.fiberSupport R C M r)) = ⟨⟨p, ‹_›⟩, hfs⟩ from Subtype.ext hcomap]
  calc topologicalKrullDimAt ↥(Module.fiberSupport Ra C' M' r') ⟨⟨p', ‹_›⟩, hfs'⟩
      = topologicalKrullDimAt
          ↥(PrimeSpectrum.comap (algebraMap C C') ⁻¹' Module.fiberSupport R C M r)
          ⟨⟨p', ‹_›⟩, by
            rw [Set.mem_preimage, show PrimeSpectrum.comap (algebraMap C C')
                (⟨p', ‹_›⟩ : PrimeSpectrum C') = (⟨p, ‹_›⟩ : PrimeSpectrum C) from
              PrimeSpectrum.ext hp]
            exact hfs⟩ :=
        topologicalKrullDimAt_eq_of_homeomorph
          (Homeomorph.setCongr (fiberSupport_away_eq_preimage a Ra C' hloc hcompat hsupp r r' hr)) _
    _ = topologicalKrullDimAt ↥(Module.fiberSupport R C M r) ⟨⟨p, ‹_›⟩, hfs⟩ := by
        rw [topologicalKrullDimAt_preimage_comap_away a C' (Module.fiberSupport R C M r)]
        exact congrArg _ (Subtype.ext (PrimeSpectrum.ext hp))

include a hloc hcompat hsupp in
/-- Under the hypotheses `hloc`, `hcompat` and `hsupp`: if the relative dimension of `C/R` is the
local dimension at `p` of the support of the fibre module of `M` over `r`, then the relative
dimension of `C_a/R_a` is the local dimension at `p'` of the support of the fibre module of `M'`
over `r'`. -/
public theorem relativeDimension_eq_support_away
    (hr : r'.comap (algebraMap R Ra) = r) (hp : p'.comap (algebraMap C C') = p)
    (hover : p.LiesOver r) (hover' : p'.LiesOver r')
    (hmem : PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩ ∈
      Module.support (r.Fiber C) (TensorProduct C (r.Fiber C) M))
    (hmem' : PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩ ∈
      Module.support (r'.Fiber C') (TensorProduct C' (r'.Fiber C') M'))
    (h : Algebra.relativeDimension R C =
      topologicalKrullDimAt ↥(Module.support (r.Fiber C) (TensorProduct C (r.Fiber C) M))
        ⟨PrimeSpectrum.primesOverOrderIsoFiber R C r ⟨p, ‹_›, hover⟩, hmem⟩) :
    Algebra.relativeDimension Ra C' =
      topologicalKrullDimAt ↥(Module.support (r'.Fiber C') (TensorProduct C' (r'.Fiber C') M'))
        ⟨PrimeSpectrum.primesOverOrderIsoFiber Ra C' r' ⟨p', ‹_›, hover'⟩, hmem'⟩ := by
  have := hloc
  have hdim : Algebra.relativeDimension Ra C' = Algebra.relativeDimension R C := by
    refine le_antisymm (relativeDimension_away_le a Ra C' hloc hcompat) ?_
    calc Algebra.relativeDimension R C
        ≤ Algebra.relativeDimensionAt R p := by
          rw [h]
          exact Algebra.topologicalKrullDimAt_support_fiber_le_relativeDimensionAt R r p
            ⟨‹_›, hover⟩ M hmem
      _ = Algebra.relativeDimensionAt Ra p' := by
          have : (p'.comap (algebraMap C C')).IsPrime := Ideal.IsPrime.comap _
          rw [relativeDimensionAt_away (C := C) a Ra C' hloc hcompat p']
          exact (Algebra.relativeDimensionAt_congr hp).symm
      _ ≤ Algebra.relativeDimension Ra C' :=
          Algebra.relativeDimensionAt_le_relativeDimension Ra p'
  rw [hdim, h, topologicalKrullDimAt_support_fiber_away a Ra C' hloc hcompat hsupp r r' p p' hr hp
    hover hover' hmem hmem']

end AwayBase

/-! ### Residue fields under away-localization -/

section AwayResidue

variable {R C Ra C' : Type u} [CommRing R] [CommRing C] [Algebra R C] (a : R)
  [CommRing Ra] [Algebra R Ra] [IsLocalization.Away a Ra]
  [CommRing C'] [Algebra C C']
  [IsLocalization (Algebra.algebraMapSubmonoid C (Submonoid.powers a)) C'] [Algebra Ra C']
  (hcompat : ∀ x : R,
    algebraMap Ra C' (algebraMap R Ra x) = algebraMap C C' (algebraMap R C x))

include a in
/-- The map of residue fields `κ(r) → κ(r')` induced by the localization `R → R_a` is bijective. -/
public theorem bijective_residueField_map_away_base (r : Ideal R) [r.IsPrime] (r' : Ideal Ra)
    [r'.IsPrime] (hr : r = r'.comap (algebraMap R Ra)) :
    Function.Bijective (Ideal.ResidueField.map r r' (algebraMap R Ra) hr) :=
  (RingHom.surjectiveOnStalks_of_isLocalization (Submonoid.powers a)
    Ra).residueFieldMap_bijective r r' hr

include a in
/-- The map of residue fields `κ(p) → κ(p')` induced by the localization `C → C_a` is bijective. -/
public theorem bijective_residueField_map_away (p : Ideal C) [p.IsPrime] (p' : Ideal C')
    [p'.IsPrime] (hp : p = p'.comap (algebraMap C C')) :
    Function.Bijective (Ideal.ResidueField.map p p' (algebraMap C C') hp) :=
  (RingHom.surjectiveOnStalks_of_isLocalization
    (Algebra.algebraMapSubmonoid C (Submonoid.powers a))
    C').residueFieldMap_bijective p p' hp

include a hcompat in
/-- Assume the two maps `R → C_a` agree (`hcompat`). If the residue extension `κ(p)/κ(r)` is purely
transcendental, then so is `κ(p')/κ(r')`. -/
public theorem purelyTranscendental_residueField_away (r : Ideal R) [r.IsPrime] (p : Ideal C)
    [p.IsPrime] (r' : Ideal Ra) [r'.IsPrime] (p' : Ideal C') [p'.IsPrime]
    (hr : r = r'.comap (algebraMap R Ra)) (hp : p = p'.comap (algebraMap C C'))
    (hrp : r = p.comap (algebraMap R C)) (hrp' : r' = p'.comap (algebraMap Ra C'))
    (h : @PurelyTranscendental r.ResidueField p.ResidueField _ _
          (Ideal.ResidueField.mapₐ r p (Algebra.ofId R C) hrp).toRingHom.toAlgebra) :
    @PurelyTranscendental r'.ResidueField p'.ResidueField _ _
      (Ideal.ResidueField.mapₐ r' p' (Algebra.ofId Ra C') hrp').toRingHom.toAlgebra := by
  let : Algebra r.ResidueField p.ResidueField :=
    (Ideal.ResidueField.mapₐ r p (Algebra.ofId R C) hrp).toRingHom.toAlgebra
  let : Algebra r'.ResidueField p'.ResidueField :=
    (Ideal.ResidueField.mapₐ r' p' (Algebra.ofId Ra C') hrp').toRingHom.toAlgebra
  have := h
  refine PurelyTranscendental.of_ringEquiv_square
    (RingEquiv.ofBijective _ (bijective_residueField_map_away_base a r r' hr))
    (RingEquiv.ofBijective _ (bijective_residueField_map_away a p p' hp)) ?_
  refine IsLocalization.ringHom_ext (nonZeroDivisors (R ⧸ r)) (RingHom.ext fun y => ?_)
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  change Ideal.ResidueField.map r' p' (algebraMap Ra C') hrp'
        (Ideal.ResidueField.map r r' (algebraMap R Ra) hr (algebraMap R r.ResidueField y))
      = Ideal.ResidueField.map p p' (algebraMap C C') hp
        (Ideal.ResidueField.map r p (algebraMap R C) hrp (algebraMap R r.ResidueField y))
  simp only [Ideal.ResidueField.map_algebraMap]
  exact congrArg (algebraMap C' p'.ResidueField) (hcompat y)

end AwayResidue

end Stacks.Flatness

namespace Stacks.Flatness

/-- If `a ∉ r` and the ideal `p` of `C` contracts to `r`, then the image in `C` of the powers of
`a` is disjoint from `p`. -/
public theorem disjoint_algebraMapSubmonoid_powers_of_comap_eq {R C : Type*} [CommRing R]
    [CommRing C] [Algebra R C] {r : Ideal R} [r.IsPrime] {a : R} (ha : a ∈ r.primeCompl)
    {p : Ideal C} (hp : p.comap (algebraMap R C) = r) :
    Disjoint ((Algebra.algebraMapSubmonoid C (Submonoid.powers a) : Submonoid C) : Set C)
      (p : Set C) :=
  Set.disjoint_of_subset_left
    (fun _ hx => by
      obtain ⟨y, hy, rfl⟩ := hx
      exact ⟨y, r.primeCompl.powers_le.mpr ha hy, rfl⟩)
    (disjoint_algebraMapSubmonoid_of_comap_eq hp)

/-- If `a ∉ r`, the extension of `r` to `R_a` contracts back to `r`. -/
public theorem comap_map_algebraMap_powers {R : Type*} [CommRing R] {r : Ideal R} [r.IsPrime]
    {a : R} (ha : a ∈ r.primeCompl) (Ra : Type*) [CommRing Ra] [Algebra R Ra]
    [IsLocalization.Away a Ra] :
    (Ideal.map (algebraMap R Ra) r).comap (algebraMap R Ra) = r :=
  IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers a) Ra ‹_›
    (Set.disjoint_left.mpr fun _ hx hx' => by
      obtain ⟨k, rfl⟩ := hx
      exact r.primeCompl.pow_mem ha k hx')

/-- If `p'` in `B'` contracts to `p` in `B`, which contracts to `r` in `R`, and `a ∉ r`, then `p'`
contracts to the extension of `r` to `R_a`, for any localization `B'` of `B` away from `a`. -/
private theorem comap_algebraMap_eq_map_of_comap_eq {R B B' : Type*} [CommRing R] [CommRing B]
    [CommRing B'] [Algebra R B] [Algebra B B'] [Algebra R B'] [IsScalarTower R B B']
    {r : Ideal R} [r.IsPrime] {a : R} (ha : a ∈ r.primeCompl) (Ra : Type*) [CommRing Ra]
    [Algebra R Ra] [IsLocalization.Away a Ra] [Algebra Ra B'] [IsScalarTower R Ra B']
    [IsLocalization (Algebra.algebraMapSubmonoid B (Submonoid.powers a)) B']
    {p : Ideal B} {p' : Ideal B'} (hp : p'.comap (algebraMap B B') = p)
    (hr : p.comap (algebraMap R B) = r) :
    p'.comap (algebraMap Ra B') = Ideal.map (algebraMap R Ra) r := by
  refine eq_of_comap_algebraMap_eq (Submonoid.powers a) ?_
  rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq R Ra B',
    IsScalarTower.algebraMap_eq R B B', ← Ideal.comap_comap, hp, hr,
    comap_map_algebraMap_powers ha Ra]

end Stacks.Flatness

namespace Module.DevissageStageData.Pointed

variable {R : Type u} [CommRing R] {r : Ideal R} [r.IsPrime] {st : DevissageStageData.{u, w} R r}
  (P : st.Pointed)

/-- The chosen lower prime of a stage contracts to the base prime. -/
public theorem lowerPrime_comap : P.lowerPrime.comap (algebraMap R st.B) = r :=
  P.lowerPrime_liesOver.over.symm

/-- The chosen upper prime of a stage contracts to the base prime. -/
public theorem upperPrime_comap : P.upperPrime.comap (algebraMap R st.A) = r := by
  rw [← st.toLeft.comp_algebraMap, ← Ideal.comap_comap]
  exact (congrArg _ P.upperPrime_under).trans P.lowerPrime_comap

end Module.DevissageStageData.Pointed

namespace Module.CompleteDevissage

variable {R : Type u} {S : Type v} {N : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [Algebra.FiniteType R S] [AddCommGroup N] [Module S N] [Module.Finite S N] {r : Ideal R}
  [r.IsPrime] (D : CompleteDevissage R S N r) (a : R)


/-! ### The away-localized stage primes -/

/-- The away-localization of the chosen lower prime of a stage: the ideal it generates in the
away-localized lower algebra. -/
public noncomputable def locAwayLowerPrime (i : Fin (D.stepCount + 1))
    (P : (D.stages i).Pointed) : Ideal (D.locAwayB a i) :=
  Ideal.map (algebraMap (D.B i) (D.locAwayB a i)) P.lowerPrime

/-- The away-localization of the chosen upper prime of a stage: the ideal it generates in the
away-localized upper algebra. -/
public noncomputable def locAwayUpperPrime (i : Fin (D.stepCount + 1))
    (P : (D.stages i).Pointed) : Ideal (D.locAwayA a i) :=
  Ideal.map (algebraMap (D.A i) (D.locAwayA a i)) P.upperPrime

variable (ha : a ∈ r.primeCompl)

include ha in
/-- If `a ∉ r`, the away-localized lower stage prime contracts to the original lower stage prime.
-/
public theorem comap_locAwayLowerPrime (i : Fin (D.stepCount + 1)) (P : (D.stages i).Pointed) :
    (D.locAwayLowerPrime a i P).comap (algebraMap (D.B i) (D.locAwayB a i)) = P.lowerPrime :=
  IsLocalization.under_map_of_isPrime_disjoint
    (Algebra.algebraMapSubmonoid (D.B i) (Submonoid.powers a)) (D.locAwayB a i)
    P.lowerPrime_isPrime
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha P.lowerPrime_comap)

include ha in
/-- If `a ∉ r`, the away-localized upper stage prime contracts to the original upper stage prime.
-/
public theorem comap_locAwayUpperPrime (i : Fin (D.stepCount + 1)) (P : (D.stages i).Pointed) :
    (D.locAwayUpperPrime a i P).comap (algebraMap (D.A i) (D.locAwayA a i)) = P.upperPrime :=
  IsLocalization.under_map_of_isPrime_disjoint
    (Algebra.algebraMapSubmonoid (D.A i) (Submonoid.powers a)) (D.locAwayA a i)
    P.upperPrime_isPrime
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha P.upperPrime_comap)

include ha in
/-- **The away-localized lower stage prime is prime.** -/
public theorem locAwayLowerPrime_isPrime (i : Fin (D.stepCount + 1))
    (P : (D.stages i).Pointed) : (D.locAwayLowerPrime a i P).IsPrime :=
  IsLocalization.isPrime_of_isPrime_disjoint
    (Algebra.algebraMapSubmonoid (D.B i) (Submonoid.powers a)) (D.locAwayB a i) _
    P.lowerPrime_isPrime
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha P.lowerPrime_comap)

include ha in
/-- **The away-localized upper stage prime is prime.** -/
public theorem locAwayUpperPrime_isPrime (i : Fin (D.stepCount + 1))
    (P : (D.stages i).Pointed) : (D.locAwayUpperPrime a i P).IsPrime :=
  IsLocalization.isPrime_of_isPrime_disjoint
    (Algebra.algebraMapSubmonoid (D.A i) (Submonoid.powers a)) (D.locAwayA a i) _
    P.upperPrime_isPrime
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha P.upperPrime_comap)

include ha in
/-- If `a ∉ r`, the away-localized lower stage prime contracts to the extension of `r` to `R_a`. -/
public theorem locAwayLowerPrime_under (i : Fin (D.stepCount + 1)) (P : (D.stages i).Pointed) :
    (D.locAwayLowerPrime a i P).comap (algebraMap (Localization.Away a) (D.locAwayB a i))
      = Ideal.map (algebraMap R (Localization.Away a)) r := by
  exact Stacks.Flatness.comap_algebraMap_eq_map_of_comap_eq (B := D.B i) ha
    (Localization.Away a) (D.comap_locAwayLowerPrime a ha i P) P.lowerPrime_comap

include ha in
/-- If `a ∉ r`, the away-localized upper stage prime contracts, along the away-localization of
`toLeft`, to the away-localized lower stage prime. -/
public theorem locAwayUpperPrime_under (i : Fin (D.stepCount + 1)) (P : (D.stages i).Pointed) :
    (D.locAwayUpperPrime a i P).comap (D.locAwayToLeft a i).toRingHom
      = D.locAwayLowerPrime a i P :=
  Stacks.Flatness.comap_map_eq_map_of_comap_eq
    (Algebra.algebraMapSubmonoid (D.B i) (Submonoid.powers a))
    (Algebra.algebraMapSubmonoid (D.A i) (Submonoid.powers a)) (D.toLeft i).toRingHom
    (D.locAwayToLeft a i).toRingHom (D.locAwayToLeft_algebraMap a i) _ P.upperPrime_isPrime _
    P.upperPrime_under
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha P.upperPrime_comap)
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha P.lowerPrime_comap)

include ha in
/-- If `a ∉ r`, the away-localized upper stage prime is the unique prime of the away-localized
upper algebra contracting to the away-localized lower stage prime. -/
public theorem locAwayUpperPrime_unique (i : Fin (D.stepCount + 1)) (P : (D.stages i).Pointed)
    (p : Ideal (D.locAwayA a i)) (hp : p.IsPrime)
    (h : p.comap (D.locAwayToLeft a i).toRingHom = D.locAwayLowerPrime a i P) :
    p = D.locAwayUpperPrime a i P := by
  have := hp
  have key : (p.comap (algebraMap (D.A i) (D.locAwayA a i))).comap (D.toLeft i).toRingHom
      = P.lowerPrime := by
    rw [Ideal.comap_comap,
      show (algebraMap (D.A i) (D.locAwayA a i)).comp (D.toLeft i).toRingHom
          = (D.locAwayToLeft a i).toRingHom.comp (algebraMap (D.B i) (D.locAwayB a i)) from
        RingHom.ext fun b => (D.locAwayToLeft_algebraMap a i b).symm,
      ← Ideal.comap_comap, h, D.comap_locAwayLowerPrime a ha i P]
  have hmap : Ideal.map (algebraMap (D.A i) (D.locAwayA a i))
      (p.comap (algebraMap (D.A i) (D.locAwayA a i))) = p :=
    IsLocalization.map_under (Algebra.algebraMapSubmonoid (D.A i) (Submonoid.powers a))
      (D.locAwayA a i) p
  have h1 : p.comap (algebraMap (D.A i) (D.locAwayA a i)) = P.upperPrime :=
    P.upperPrime_unique _ (Ideal.IsPrime.comap (algebraMap (D.A i) (D.locAwayA a i))) key
  exact hmap.symm.trans (congrArg _ h1)

/-! ### The away-localized pointed datum of a stage -/

include ha in
/-- The away-localized pointed datum of a stage of a complete dévissage, for `a ∉ r`: its chosen
primes are the ideals generated by the original chosen primes in the away-localized stage algebras.
-/
public noncomputable def locAwayPointed
    [(Ideal.map (algebraMap R (Localization.Away a)) r).IsPrime]
    (S' : Type v) [CommRing S'] [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S']
    [Algebra (Localization.Away a) S'] [IsScalarTower R (Localization.Away a) S']
    (N' : Type max u w) [AddCommGroup N'] [Module S N'] [Module S' N']
    [IsScalarTower S S' N'] [Module.Finite S' N'] (gN : N →ₗ[S] N')
    [IsLocalizedModule (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) gN]
    [Algebra.FiniteType (Localization.Away a) S']
    (i : Fin (D.stepCount + 1)) (P : (D.stages i).Pointed) :
    ((D.localizeAway a S' N' gN ha).stages i).Pointed where
  lowerPrime := D.locAwayLowerPrime a i P
  lowerPrime_isPrime := D.locAwayLowerPrime_isPrime a ha i P
  lowerPrime_liesOver := ⟨(D.locAwayLowerPrime_under a ha i P).symm⟩
  residueField_purelyTranscendental := by
    have hcompat : ∀ x : R, algebraMap (Localization.Away a) (D.locAwayB a i)
        (algebraMap R (Localization.Away a) x)
        = algebraMap (D.B i) (D.locAwayB a i) (algebraMap R (D.B i) x) := fun x => by
      rw [← IsScalarTower.algebraMap_apply R (Localization.Away a) (D.locAwayB a i),
        ← IsScalarTower.algebraMap_apply R (D.B i) (D.locAwayB a i)]
    have : (show Ideal (D.B i) from P.lowerPrime).IsPrime := P.lowerPrime_isPrime
    have : (D.locAwayLowerPrime a i P).IsPrime := D.locAwayLowerPrime_isPrime a ha i P
    exact Stacks.Flatness.purelyTranscendental_residueField_away a hcompat r
      (show Ideal (D.B i) from P.lowerPrime)
      (Ideal.map (algebraMap R (Localization.Away a)) r) (D.locAwayLowerPrime a i P)
      (Stacks.Flatness.comap_map_algebraMap_powers ha (Localization.Away a)).symm
      (D.comap_locAwayLowerPrime a ha i P).symm P.lowerPrime_comap.symm
      (D.locAwayLowerPrime_under a ha i P).symm P.residueField_purelyTranscendental
  upperPrime := D.locAwayUpperPrime a i P
  upperPrime_isPrime := D.locAwayUpperPrime_isPrime a ha i P
  upperPrime_under := D.locAwayUpperPrime_under a ha i P
  upperPrime_unique := D.locAwayUpperPrime_unique a ha i P
  lowerPrime_mem_fiberSupport := by
    let : Algebra (D.B i) (D.locAwayB a i) := inferInstance
    have hcompat : ∀ x : R, algebraMap (Localization.Away a) (D.locAwayB a i)
        (algebraMap R (Localization.Away a) x)
        = algebraMap (D.B i) (D.locAwayB a i) (algebraMap R (D.B i) x) := fun x => by
      rw [← IsScalarTower.algebraMap_apply R (Localization.Away a) (D.locAwayB a i),
        ← IsScalarTower.algebraMap_apply R (D.B i) (D.locAwayB a i)]
    let : Module (D.B i) (D.M i) := Module.compHom (D.M i) (D.toLeft i).toRingHom
    have : Module.Finite (D.B i) (D.M i) :=
      inferInstanceAs (Module.Finite (D.stages i).B (D.stages i).M)
    have : Module.Finite (D.locAwayB a i) (D.locAwayM a i) :=
      Module.Finite.of_isLocalizedModule
        (Algebra.algebraMapSubmonoid (D.B i) (Submonoid.powers a)) (D.locAwayMk a i)
    have hp : (D.locAwayLowerPrime a i P).comap (algebraMap (D.B i) (D.locAwayB a i))
        = (show Ideal (D.B i) from P.lowerPrime) := D.comap_locAwayLowerPrime a ha i P
    have hsupp := Stacks.Flatness.support_away_eq_preimage a (D.locAwayB a i) (D.locAwayMk a i)
    have : (show Ideal (D.B i) from P.lowerPrime).IsPrime := P.lowerPrime_isPrime
    have : (D.locAwayLowerPrime a i P).IsPrime := D.locAwayLowerPrime_isPrime a ha i P
    exact Stacks.Flatness.mem_support_fiber_away (Localization.Away a) (D.locAwayB a i)
      hsupp r (Ideal.map (algebraMap R (Localization.Away a)) r)
      (show Ideal (D.B i) from P.lowerPrime) (D.locAwayLowerPrime a i P)
      hp P.lowerPrime_liesOver
      ⟨(D.locAwayLowerPrime_under a ha i P).symm⟩ P.lowerPrime_mem_fiberSupport
  relativeDimension_eq_support := by
    let : Algebra (D.B i) (D.locAwayB a i) := inferInstance
    have hcompat : ∀ x : R, algebraMap (Localization.Away a) (D.locAwayB a i)
        (algebraMap R (Localization.Away a) x)
        = algebraMap (D.B i) (D.locAwayB a i) (algebraMap R (D.B i) x) := fun x => by
      rw [← IsScalarTower.algebraMap_apply R (Localization.Away a) (D.locAwayB a i),
        ← IsScalarTower.algebraMap_apply R (D.B i) (D.locAwayB a i)]
    let : Module (D.B i) (D.M i) := Module.compHom (D.M i) (D.toLeft i).toRingHom
    have : Module.Finite (D.B i) (D.M i) :=
      inferInstanceAs (Module.Finite (D.stages i).B (D.stages i).M)
    have : Module.Finite (D.locAwayB a i) (D.locAwayM a i) :=
      Module.Finite.of_isLocalizedModule
        (Algebra.algebraMapSubmonoid (D.B i) (Submonoid.powers a)) (D.locAwayMk a i)
    have hp : (D.locAwayLowerPrime a i P).comap (algebraMap (D.B i) (D.locAwayB a i))
        = (show Ideal (D.B i) from P.lowerPrime) := D.comap_locAwayLowerPrime a ha i P
    have hsupp := Stacks.Flatness.support_away_eq_preimage a (D.locAwayB a i) (D.locAwayMk a i)
    have : (show Ideal (D.B i) from P.lowerPrime).IsPrime := P.lowerPrime_isPrime
    have : (D.locAwayLowerPrime a i P).IsPrime := D.locAwayLowerPrime_isPrime a ha i P
    have hover' : (D.locAwayLowerPrime a i P).LiesOver
        (Ideal.map (algebraMap R (Localization.Away a)) r) :=
      ⟨(D.locAwayLowerPrime_under a ha i P).symm⟩
    have hmem' := Stacks.Flatness.mem_support_fiber_away (Localization.Away a)
      (D.locAwayB a i) hsupp r (Ideal.map (algebraMap R (Localization.Away a)) r)
      (show Ideal (D.B i) from P.lowerPrime) (D.locAwayLowerPrime a i P)
      hp P.lowerPrime_liesOver hover' P.lowerPrime_mem_fiberSupport
    exact Stacks.Flatness.relativeDimension_eq_support_away a (Localization.Away a)
      (D.locAwayB a i) inferInstance hcompat hsupp r
      (Ideal.map (algebraMap R (Localization.Away a)) r)
      (show Ideal (D.B i) from P.lowerPrime) (D.locAwayLowerPrime a i P)
      (Stacks.Flatness.comap_map_algebraMap_powers ha (Localization.Away a))
      hp P.lowerPrime_liesOver hover' P.lowerPrime_mem_fiberSupport hmem'
      P.relativeDimension_eq_support

end Module.CompleteDevissage

namespace Module.PointedCompleteDevissage

variable {R : Type u} {S : Type v} {N : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [Algebra.FiniteType R S] [AddCommGroup N] [Module S N] [Module.Finite S N] {r : Ideal R}
  [r.IsPrime] {q : Ideal S} [q.IsPrime] (E : PointedCompleteDevissage R S N r q) (a : R)

/-- An element of `R` has image in the prime `q` at which a pointed complete dévissage is pointed
if and only if it lies in the base prime `r`. -/
private theorem algebraMap_mem_iff (E : PointedCompleteDevissage R S N r q) (x : R) :
    algebraMap R S x ∈ q ↔ x ∈ r := by
  rw [← SetLike.ext_iff.mp E.initial_under, ← SetLike.ext_iff.mp (E.pointed 0).upperPrime_comap x]
  exact Iff.of_eq
    (congrArg (· ∈ (E.pointed 0).upperPrime) (E.toCompleteDevissage.toA₀.commutes x))

include E in
/-- If `a ∉ r`, the image in `S` of the powers of `a` is disjoint from the prime `q` at which a
pointed complete dévissage is pointed. -/
public theorem disjoint_algebraMapSubmonoid_powers (ha : a ∈ r.primeCompl) :
    Disjoint ((Algebra.algebraMapSubmonoid S (Submonoid.powers a) : Submonoid S) : Set S)
      (q : Set S) := by
  rw [Set.disjoint_left]
  rintro y ⟨z, ⟨k, rfl⟩, rfl⟩ hy
  exact r.primeCompl.pow_mem ha k ((algebraMap_mem_iff E _).mp hy)

include E in
/-- The prime `q` at which a pointed complete dévissage is pointed contracts to the base prime `r`.
-/
public theorem under_eq : q.comap (algebraMap R S) = r :=
  Ideal.ext fun x => algebraMap_mem_iff E x

include E in
/-- If `a ∉ r`, the extension of `q` to `S'` contracts to the extension of `r` to `R_a`. -/
public theorem under_map_algebraMap (ha : a ∈ r.primeCompl) (S' : Type v) [CommRing S']
    [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S']
    [Algebra (Localization.Away a) S'] [IsScalarTower R (Localization.Away a) S'] :
    (Ideal.map (algebraMap S S') q).comap (algebraMap (Localization.Away a) S')
      = Ideal.map (algebraMap R (Localization.Away a)) r := by
  have hq : (Ideal.map (algebraMap S S') q).comap (algebraMap S S') = q :=
    IsLocalization.under_map_of_isPrime_disjoint
      (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S' ‹q.IsPrime›
      (E.disjoint_algebraMapSubmonoid_powers a ha)
  exact Stacks.Flatness.comap_algebraMap_eq_map_of_comap_eq ha (Localization.Away a) hq E.under_eq

include E in
/-- If `a ∉ r`, the extension of `q` to `S'` is prime. -/
public theorem isPrime_map_algebraMap (ha : a ∈ r.primeCompl) (S' : Type v) [CommRing S']
    [Algebra S S'] [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S'] :
    (Ideal.map (algebraMap S S') q).IsPrime :=
  IsLocalization.isPrime_of_isPrime_disjoint
    (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S' q ‹_›
    (E.disjoint_algebraMapSubmonoid_powers a ha)

include E in
/-- If `a ∉ r`, the first away-localized upper prime contracts, along the away-localization of
`toA₀`, to the extension of `q` to `S'`. -/
public theorem locAwayInitial_under (ha : a ∈ r.primeCompl) (S' : Type v) [CommRing S']
    [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S']
    [Algebra (Localization.Away a) S'] [IsScalarTower R (Localization.Away a) S'] :
    (E.toCompleteDevissage.locAwayUpperPrime a 0 (E.pointed 0)).comap
        (E.toCompleteDevissage.locAwayToA₀ a S').toRingHom
      = Ideal.map (algebraMap S S') q :=
  Stacks.Flatness.comap_map_eq_map_of_comap_eq
    (Algebra.algebraMapSubmonoid S (Submonoid.powers a))
    (Algebra.algebraMapSubmonoid (E.toCompleteDevissage.A 0) (Submonoid.powers a))
    E.toCompleteDevissage.toA₀.toRingHom
    (E.toCompleteDevissage.locAwayToA₀ a S').toRingHom
    (E.toCompleteDevissage.locAwayToA₀_algebraMap a S') _ (E.pointed 0).upperPrime_isPrime _
    E.initial_under
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha
      (E.pointed 0).upperPrime_comap)
    (E.disjoint_algebraMapSubmonoid_powers a ha)

include E in
/-- If `a ∉ r`, the away-localized upper prime of stage `i + 1` contracts, along the
away-localization of `toRight`, to the away-localized lower prime of stage `i`. -/
public theorem locAwayTransition_under (ha : a ∈ r.primeCompl)
    (i : Fin E.toCompleteDevissage.stepCount) :
    (E.toCompleteDevissage.locAwayUpperPrime a i.succ (E.pointed i.succ)).comap
        (E.toCompleteDevissage.locAwayToRight a i).toRingHom
      = E.toCompleteDevissage.locAwayLowerPrime a i.castSucc (E.pointed i.castSucc) :=
  Stacks.Flatness.comap_map_eq_map_of_comap_eq
    (Algebra.algebraMapSubmonoid (E.toCompleteDevissage.B i.castSucc) (Submonoid.powers a))
    (Algebra.algebraMapSubmonoid (E.toCompleteDevissage.A i.succ) (Submonoid.powers a))
    (E.toCompleteDevissage.toRight i).toRingHom
    (E.toCompleteDevissage.locAwayToRight a i).toRingHom
    (E.toCompleteDevissage.locAwayToRight_algebraMap a i) _
    (E.pointed i.succ).upperPrime_isPrime _ (E.transition_under i)
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha
      (E.pointed i.succ).upperPrime_comap)
    (Stacks.Flatness.disjoint_algebraMapSubmonoid_powers_of_comap_eq ha
      (E.pointed i.castSucc).lowerPrime_comap)

/-- The base change of a pointed complete dévissage along the localization of its base away from
an element outside its base prime: given a pointed complete dévissage of `N/S/R` over `r`, pointed
at `q`, and `a ∉ r`, localizing every ring and module at the image of the powers of `a` gives a
pointed complete dévissage of `N'/S'/R_a` over `rR_a`, pointed at `qS'`. -/
public noncomputable def localizeAway (ha : a ∈ r.primeCompl)
    [(Ideal.map (algebraMap R (Localization.Away a)) r).IsPrime]
    (S' : Type v) [CommRing S'] [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S']
    [Algebra (Localization.Away a) S'] [IsScalarTower R (Localization.Away a) S']
    (N' : Type max u w) [AddCommGroup N'] [Module S N'] [Module S' N']
    [IsScalarTower S S' N'] [Module.Finite S' N'] (gN : N →ₗ[S] N')
    [IsLocalizedModule (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) gN]
    [Algebra.FiniteType (Localization.Away a) S']
    [(Ideal.map (algebraMap S S') q).IsPrime] :
    PointedCompleteDevissage (Localization.Away a) S' N'
      (Ideal.map (algebraMap R (Localization.Away a)) r)
      (Ideal.map (algebraMap S S') q) where
  toCompleteDevissage := E.toCompleteDevissage.localizeAway a S' N' gN ha
  pointed i := E.toCompleteDevissage.locAwayPointed a ha S' N' gN i (E.pointed i)
  initial_under := E.locAwayInitial_under a ha S'
  transition_under i := E.locAwayTransition_under a ha i

/-- The away-localized dévissage has as many stages as the original. -/
public theorem stepCount_localizeAway (ha : a ∈ r.primeCompl)
    [(Ideal.map (algebraMap R (Localization.Away a)) r).IsPrime]
    (S' : Type v) [CommRing S'] [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S']
    [Algebra (Localization.Away a) S'] [IsScalarTower R (Localization.Away a) S']
    (N' : Type max u w) [AddCommGroup N'] [Module S N'] [Module S' N']
    [IsScalarTower S S' N'] [Module.Finite S' N'] (gN : N →ₗ[S] N')
    [IsLocalizedModule (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) gN]
    [Algebra.FiniteType (Localization.Away a) S']
    [(Ideal.map (algebraMap S S') q).IsPrime] :
    (E.localizeAway a ha S' N' gN).toCompleteDevissage.stepCount
      = E.toCompleteDevissage.stepCount := rfl

end Module.PointedCompleteDevissage

namespace Module.NonemptyCompleteDevissageAt

variable {R : Type u} {S : Type v} {N : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [Algebra.FiniteType R S] [AddCommGroup N] [Module S N] [Module.Finite S N] {q : Ideal S}
  [q.IsPrime] (E : NonemptyCompleteDevissageAt R S N q) (a : R)

/-- A nonempty complete dévissage at `q` as a pointed complete dévissage over `q.under R`, pointed
at `q`. -/
public def toPointedCompleteDevissage : PointedCompleteDevissage R S N (q.under R) q where
  toCompleteDevissage := E.toCompleteDevissage
  pointed := E.pointedStages
  initial_under := E.initial_under
  transition_under := E.transition_under

/-- The base change of a nonempty complete dévissage at a prime `q` along the localization of its
base away from an element outside `q.under R`. -/
public noncomputable def localizeAway (ha : a ∈ (q.under R).primeCompl)
    [(Ideal.map (algebraMap R (Localization.Away a)) (q.under R)).IsPrime]
    (S' : Type v) [CommRing S'] [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']
    [IsLocalization (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) S']
    [Algebra (Localization.Away a) S'] [IsScalarTower R (Localization.Away a) S']
    (N' : Type max u w) [AddCommGroup N'] [Module S N'] [Module S' N']
    [IsScalarTower S S' N'] [Module.Finite S' N'] (gN : N →ₗ[S] N')
    [IsLocalizedModule (Algebra.algebraMapSubmonoid S (Submonoid.powers a)) gN]
    [Algebra.FiniteType (Localization.Away a) S']
    [(Ideal.map (algebraMap S S') q).IsPrime] :
    NonemptyCompleteDevissageAt (Localization.Away a) S' N' (Ideal.map (algebraMap S S') q) :=
  (E.toPointedCompleteDevissage.localizeAway a ha S' N' gN).toNonemptyCompleteDevissageAt
    (E.toPointedCompleteDevissage.under_map_algebraMap a ha S')

end Module.NonemptyCompleteDevissageAt

end
