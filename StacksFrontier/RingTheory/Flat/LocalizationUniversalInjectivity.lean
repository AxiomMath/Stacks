module

public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Localization.BaseChange
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Flat.CompleteDevissageUniverse
public import StacksFrontier.RingTheory.Flat.UniversallyInjective

/-!
# Universal injectivity of an abstract localization, with a free test-module universe

Let `R` be a local ring, `S` an `R`-algebra and `M` an `S`-module which is projective over `R`.
This file proves that every element of `S` acting injectively on the closed fibre `M / 𝔪_R M`
acts universally injectively on `M` over `R`, and that *any* localization of `M` at a
multiplicative subset of such elements — presented abstractly as a map `g : M →ₗ[S] M'` with
`IsLocalizedModule T g` — is universally injective over `R`.

This is Stacks Tag 05FR, already available in this library as
`Stacks.UniversalInjectivity.universallyInjective_lsmul_of_mem_nonZeroSMulDivisors_quotient` and
`Stacks.UniversalInjectivity.universallyInjective_localizedModule_mkLinearMap`, in the two
respects in which a pure spreadout (Stacks 0AT6) needs it and those statements do not supply it:
the test modules range over an arbitrary universe, and the localization is an arbitrary map
exhibiting `M'` as `T⁻¹M` rather than the canonical `LocalizedModule T M`. The Noetherian and
finiteness hypotheses on the closed fibre carried by those two statements are dropped: they are
not needed once the `Small.{v} R` detour is avoided.

## Main results

* `Stacks.UniversalInjectivity.universallyInjectivePoly_lsmul_of_mem_nonZeroSMulDivisors_quotient`
  is the elementwise clause of Tag 05FR with a free test-module universe.
* `Stacks.UniversalInjectivity.universallyInjectivePoly_of_isLocalizedModule` is the
  localization clause of Tag 05FR for an abstract localization, with the source, the target and
  the test modules in three independent universes.

## Implementation notes

Both universe restrictions come from the same place. Universal injectivity of `f : M →ₗ[R] N` is
witnessed by injectivity of `f.rTensor Q` for test modules `Q` in a fixed universe, and Stacks
05FQ is available only with `M`, `N` and `Q` in one universe. Here the device of
`StacksFrontier.RingTheory.Flat.CompleteDevissageUniverse` is used once more: conjugating by
`ULift.moduleEquiv` lifts both modules into the universe generated by the ring, the two modules
*and the test module*, which is one universe larger than the form that file states, and the
conclusion is transported back along the test module's own `ULift`.

For the localization clause no reduction to `LocalizedModule T M` is made. The `S`-module
`M ⊗[R] Q` is a localization of itself at `T` (`IsLocalizedModule.rTensor`), so
`IsLocalizedModule.injective_iff_isRegular` turns injectivity of `g ⊗ id_Q` into regularity of
every `s ∈ T` on `M ⊗[R] Q`, which is the elementwise clause. In particular `T` is not required
to be all of `nonZeroSMulDivisors`, only to consist of such elements.

## References

* [Stacks Project, Tag 05FR](https://stacks.math.columbia.edu/tag/05FR)
* [Stacks Project, Tag 05FQ](https://stacks.math.columbia.edu/tag/05FQ)
-/

@[expose] public section

open TensorProduct

namespace Stacks.UniversalInjectivity

universe u v w w' t

section Transport

variable {R : Type u} [CommRing R]

/-- Injectivity of `f ⊗ id_Q` is inherited from the map conjugated by two isomorphisms. -/
private theorem injective_rTensor_of_conj {M : Type*} {M₀ : Type*} {N : Type*} {N₀ : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup M₀] [Module R M₀] [AddCommGroup N] [Module R N]
    [AddCommGroup N₀] [Module R N₀] (Q : Type*) [AddCommGroup Q] [Module R Q]
    (eM : M₀ ≃ₗ[R] M) (eN : N ≃ₗ[R] N₀) {u : M →ₗ[R] N}
    (h : Function.Injective ((eN.toLinearMap ∘ₗ u ∘ₗ eM.toLinearMap).rTensor Q)) :
    Function.Injective (u.rTensor Q) := by
  rw [LinearMap.rTensor_comp, LinearMap.rTensor_comp, LinearMap.coe_comp,
    LinearMap.coe_comp] at h
  refine h.of_comp.of_comp_right ?_
  rw [← LinearEquiv.coe_rTensor Q eM]
  exact (eM.rTensor Q).surjective

/-- Injectivity of `f ⊗ id_Q` depends on the test module only through its isomorphism class. -/
private theorem injective_rTensor_of_equiv {M N : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] {Q : Type*} {Q' : Type*} [AddCommGroup Q] [Module R Q]
    [AddCommGroup Q'] [Module R Q'] (f : M →ₗ[R] N) (e : Q ≃ₗ[R] Q')
    (h : Function.Injective (f.rTensor Q')) : Function.Injective (f.rTensor Q) := by
  have hcomm : (LinearEquiv.lTensor N e).toLinearMap ∘ₗ f.rTensor Q =
      (f.rTensor Q') ∘ₗ (LinearEquiv.lTensor M e).toLinearMap := by
    rw [LinearEquiv.coe_lTensor, LinearEquiv.coe_lTensor, LinearMap.rTensor_comp_lTensor,
      LinearMap.lTensor_comp_rTensor]
  have hc : Function.Injective
      ((LinearEquiv.lTensor N e).toLinearMap ∘ₗ f.rTensor Q) := by
    rw [hcomm]
    exact h.comp (LinearEquiv.lTensor M e).injective
  exact ((LinearEquiv.lTensor N e).injective.of_comp_iff (f.rTensor Q)).mp hc

end Transport

/-- **Stacks Project, Tag 05FQ**, with the test modules in a universe independent of those of
the base ring, the source and the target.

This strengthens `Module.Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top'`,
whose test modules are confined to the universe generated by the other three. -/
theorem universallyInjectivePoly_of_projective_of_mem_maximalIdeal_smul_top
    {R : Type u} [CommRing R] [IsLocalRing R] {M : Type v} {N : Type w} [AddCommGroup M]
    [Module R M] [Module.Projective R M] [AddCommGroup N] [Module R N] [Module.Flat R N]
    (u : M →ₗ[R] N)
    (hu : ∀ x : M, u x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R N) →
      x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) :
    UniversallyInjectivePoly.{u, t} u := by
  intro Q _ _
  let eM : ULift.{t} M ≃ₗ[R] M := ULift.moduleEquiv
  let eN : ULift.{t} N ≃ₗ[R] N := ULift.moduleEquiv
  have _ : Module.Projective R (ULift.{t} M) := Module.Projective.of_equiv eM.symm
  have _ : Module.Flat R (ULift.{t} N) := Module.Flat.of_linearEquiv eN
  set u' : ULift.{t} M →ₗ[R] ULift.{t} N := eN.symm.toLinearMap ∘ₗ u ∘ₗ eM.toLinearMap with hu'def
  have hu' : ∀ x : ULift.{t} M,
      u' x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R (ULift.{t} N)) →
        x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R (ULift.{t} M)) := by
    intro x hx
    have h1 : u (eM x) ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R N) := by
      simpa [hu'def] using Submodule.smul_top_le_comap_smul_top _ eN.toLinearMap hx
    simpa using Submodule.smul_top_le_comap_smul_top _ eM.symm.toLinearMap (hu _ h1)
  have hbig := Module.Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top' u' hu'
  refine injective_rTensor_of_equiv u (ULift.moduleEquiv.symm :
    Q ≃ₗ[R] ULift.{max u v w} Q) ?_
  exact injective_rTensor_of_conj _ eM eN.symm (hbig _)

/-- The closed fibre of `M` over `R` and the closed fibre of `M` over `S` are the same
submodule: extending `𝔪_R` to `S` does not change the submodule it generates. -/
private theorem mem_maximalIdeal_smul_top_iff {R : Type u} {S : Type v} {M : Type w}
    [CommRing R] [CommRing S] [IsLocalRing R] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M] (x : M) :
    x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) ↔
      x ∈ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) • (⊤ : Submodule S M) := by
  have h : IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) =
      (Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) •
        (⊤ : Submodule S M)).restrictScalars R := by
    rw [Ideal.smul_restrictScalars, Submodule.restrictScalars_top]
  rw [h]
  exact Iff.rfl

section Fibre

variable {R : Type u} {S : Type v} {M : Type w}
variable [CommRing R] [CommRing S] [IsLocalRing R] [Algebra R S]
variable [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
variable [Module.Projective R M]

/-- **Stacks Project, Tag 05FR**, elementwise clause, with a free test-module universe. An
element acting injectively on the closed fibre of a module projective over the local base ring
acts universally injectively on the module.

Neither the Noetherian hypothesis on `S ⧸ 𝔪_R S` nor the finiteness of the closed fibre, both
present in `universallyInjective_lsmul_of_mem_nonZeroSMulDivisors_quotient`, is used. -/
theorem universallyInjectivePoly_lsmul_of_mem_nonZeroSMulDivisors_quotient {s : S}
    (hs : s ∈ nonZeroSMulDivisors S
      (M ⧸ (Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) • (⊤ : Submodule S M)))) :
    UniversallyInjectivePoly.{u, t} ((LinearMap.lsmul S M s).restrictScalars R) := by
  have _ : Module.Free R M := Module.free_of_projective_of_isLocalRing
  refine universallyInjectivePoly_of_projective_of_mem_maximalIdeal_smul_top _ fun x hx ↦ ?_
  have hsx : s • x ∈ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) •
      (⊤ : Submodule S M) := (mem_maximalIdeal_smul_top_iff (S := S) _).mp hx
  refine (mem_maximalIdeal_smul_top_iff (S := S) x).mpr ?_
  refine (Submodule.Quotient.mk_eq_zero _).mp (hs _ ?_)
  rw [← Submodule.Quotient.mk_smul]
  exact (Submodule.Quotient.mk_eq_zero _).mpr hsx

/-- **Stacks Project, Tag 05FR**, localization clause, for an abstract localization and with the
source, the target and the test modules in three independent universes.

Let `R` be local, let `M` be an `S`-module projective over `R`, and let `T` be a multiplicative
subset of `S` all of whose elements act injectively on the closed fibre `M / 𝔪_R M`. Then any
map `g : M →ₗ[S] M'` exhibiting `M'` as `T⁻¹M` is universally injective over `R`. -/
theorem universallyInjectivePoly_of_isLocalizedModule {M' : Type w'} [AddCommGroup M']
    [Module S M'] [Module R M'] [IsScalarTower R S M'] (T : Submonoid S)
    (hT : ∀ s ∈ T, s ∈ nonZeroSMulDivisors S
      (M ⧸ (Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) • (⊤ : Submodule S M))))
    (g : M →ₗ[S] M') [IsLocalizedModule T g] :
    UniversallyInjectivePoly.{u, t} (g.restrictScalars R) := by
  intro Q _ _
  have hreg : ∀ c : T, IsSMulRegular (M ⊗[R] Q) (c : S) := by
    intro c
    have hc := universallyInjectivePoly_lsmul_of_mem_nonZeroSMulDivisors_quotient
      (M := M) (hT c c.2) Q
    intro x y hxy
    refine hc (a₁ := x) (a₂ := y) ?_
    have hsmul : ∀ z : M ⊗[R] Q,
        ((LinearMap.lsmul S M (c : S)).restrictScalars R).rTensor Q z = (c : S) • z := by
      intro z
      induction z with
      | zero => simp
      | add a b ha hb => rw [map_add, ha, hb, smul_add]
      | tmul m q => rfl
    rw [hsmul, hsmul]
    exact hxy
  have hinj : Function.Injective (AlgebraTensorModule.rTensor R Q g) :=
    (IsLocalizedModule.injective_iff_isRegular T _).2 hreg
  exact hinj

end Fibre

end Stacks.UniversalInjectivity

end
