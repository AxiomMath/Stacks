module

public import Mathlib.RingTheory.Flat.EquationalCriterion
public import Mathlib.RingTheory.Polynomial.Quotient
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.Algebra.MvPolynomial.Equiv

/-!
# Flat algebras over a truncated polynomial ring

Let `k` be a field and `A = k[t]/(t^(m+1))`. The element `t` of `A` is nilpotent and the
annihilator of `t ^ m` is the ideal `(t)`. This file shows that a flat `A`-algebra in which the
image of `t ^ m` vanishes is zero, and records the ring `A` together with the two `k`-algebra
maps relating it to affine space and to `k` which are used to probe a presheaf with the
infinitesimal neighbourhoods of a rational point.

## Main results

* `RingHom.Flat.subsingleton_of_map_pow_eq_zero`: for a nilpotent `t` in a ring `R` whose
  `t ^ m`-annihilator is `(t)`, a flat `R`-algebra killing `t ^ m` is zero.
* `exists_eq_thickeningParameter_mul`: in `k[t]/(t^(m+1))` the annihilator of `t ^ m` is `(t)`.

## Implementation notes

The flatness statement is proved with the equational criterion for flatness
(`Module.Flat.isTrivialRelation_of_sum_smul_eq_zero`), which avoids any local-ring or
faithful-flatness argument: the trivialization of the relation `t ^ m • 1 = 0` writes `1` as a
multiple of the image of `t`.
-/

@[expose] public section

universe u

open Polynomial

/-! ### Flat algebras over a truncated polynomial ring -/

/-- Let `t` be a nilpotent element of a commutative ring `R` such that every element annihilated
by `t ^ m` is a multiple of `t`, as for `t` in `k[t]/(t^(m+1))`. A flat `R`-algebra in which the
image of `t ^ m` vanishes is zero. By the equational criterion for flatness, the relation
`t ^ m • 1 = 0` is trivial, which writes `1` as a combination of elements with coefficients
annihilated by `t ^ m`, hence divisible by `t`; so the image of `t` is a unit, and it is
nilpotent. -/
theorem RingHom.Flat.subsingleton_of_map_pow_eq_zero {R A : Type*} [CommRing R]
    [CommRing A] {φ : R →+* A} (hφ : φ.Flat) {t : R} (ht : IsNilpotent t) {m : ℕ}
    (hann : ∀ a, t ^ m * a = 0 → ∃ c, a = t * c) (h : φ t ^ m = 0) : Subsingleton A := by
  let := φ.toAlgebra
  have : Module.Flat R A := hφ
  have hrel : ∑ _i : Unit, t ^ m • (1 : A) = 0 := by
    rw [Fintype.sum_unique, Algebra.smul_def, mul_one, map_pow]
    exact h
  obtain ⟨l, a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
  choose c hc using fun j => hann (a () j) (by simpa using ha j)
  have h1 : (1 : A) = φ t * ∑ j, φ (c j) * y j := by
    refine (hy ()).trans ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hc j, Algebra.smul_def, map_mul, mul_assoc]
    rfl
  obtain ⟨N, hN⟩ := ht
  refine subsingleton_of_zero_eq_one ?_
  calc (0 : A) = φ (t ^ N) * (∑ j, φ (c j) * y j) ^ N := by rw [hN, map_zero, zero_mul]
    _ = (φ t * ∑ j, φ (c j) * y j) ^ N := by rw [map_pow, mul_pow]
    _ = 1 := by rw [← h1, one_pow]

/-! ### Infinitesimal neighbourhoods of a point -/

section Thickening

variable (k : Type u) [Field k]

/-- The ring `k[t]/(t^(m+1))` of the `m`-th infinitesimal neighbourhood of a rational point. -/
abbrev thickeningRing (m : ℕ) : Type u :=
  Polynomial k ⧸ Ideal.span {(Polynomial.X : Polynomial k) ^ (m + 1)}

/-- The parameter `t` of `k[t]/(t^(m+1))`. -/
noncomputable abbrev thickeningParameter (m : ℕ) : thickeningRing k m :=
  Ideal.Quotient.mk _ Polynomial.X

variable {k}

/-- The parameter `t` of `k[t]/(t^(m+1))` has vanishing `(m+1)`-st power. -/
theorem thickeningParameter_pow_succ (m : ℕ) : thickeningParameter k m ^ (m + 1) = 0 := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span rfl

/-- The parameter `t` of `k[t]/(t^(m+1))` is nilpotent. -/
theorem isNilpotent_thickeningParameter (m : ℕ) : IsNilpotent (thickeningParameter k m) :=
  ⟨m + 1, thickeningParameter_pow_succ m⟩

/-- In `k[t]/(t^(m+1))` the annihilator of `t ^ m` is the ideal generated by `t`. -/
theorem exists_eq_thickeningParameter_mul (m : ℕ) (a : thickeningRing k m)
    (ha : thickeningParameter k m ^ m * a = 0) : ∃ c, a = thickeningParameter k m * c := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton,
    pow_succ] at ha
  obtain ⟨c, rfl⟩ := (mul_dvd_mul_iff_left (pow_ne_zero m Polynomial.X_ne_zero)).mp ha
  exact ⟨Ideal.Quotient.mk _ c, map_mul _ _ _⟩

/-- The ring `k[t]/(t^(m+1))` is nonzero. -/
instance (m : ℕ) : Nontrivial (thickeningRing k m) := by
  refine Ideal.Quotient.nontrivial_iff.mpr ?_
  rw [Ne, Ideal.span_singleton_eq_top]
  intro hu
  have := Polynomial.degree_eq_zero_of_isUnit hu
  rw [Polynomial.degree_X_pow] at this
  exact absurd this (by exact_mod_cast Nat.succ_ne_zero m)

/-- The `k`-algebra map `k[x_1, …, x_n] ⟶ k[t]/(t^(m+1))` sending every coordinate to `t`. -/
noncomputable abbrev thickeningCoordinates (n m : ℕ) :
    MvPolynomial (Fin n) k →ₐ[k] thickeningRing k m :=
  MvPolynomial.aeval fun _ => thickeningParameter k m

/-- The `k`-algebra map `k[t]/(t^(m+1)) ⟶ k` sending `t` to `0`. -/
noncomputable abbrev thickeningResidue (m : ℕ) : thickeningRing k m →ₐ[k] k :=
  Ideal.Quotient.liftₐ _ (Polynomial.aeval (0 : k)) (by
    intro p hp
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hp
    simp)

/-- Sending every coordinate to `t` and then `t` to `0` is evaluation at the origin. -/
theorem thickeningResidue_comp_thickeningCoordinates (n m : ℕ) :
    (thickeningResidue (k := k) m).comp (thickeningCoordinates n m) =
      MvPolynomial.aeval fun _ : Fin n => (0 : k) := by
  ext i
  simp

end Thickening

end
