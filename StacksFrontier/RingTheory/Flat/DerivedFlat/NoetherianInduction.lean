/-!
# Flatness in degree zero descends along a surjective family of finite type

Let `A₀` be a Noetherian ring, `A` an `A₀`-algebra and `D_1, …, D_n` algebras of finite type over
`A₀`, and put `B_j = A ⊗[A₀] D_j`. Suppose the maps `Spec B_j → Spec A` are jointly surjective.
Let `N ∈ D(A)` have no positive cohomology. If each derived base change `N ⊗ᴸ_A B_j` is
isomorphic to a flat `B_j`-module placed in degree zero, then so is `N`.

This is the algebraic content of the converse in Stacks 0H89.

## Main results

* `StacksDraft.DerivedFlat.isFlatInDegreeZero_of_tensor_family`: the statement above.
* `StacksDraft.DerivedFlat.isFlatInDegreeZero_of_finitePresentation_family`: the same for a
  finite family of algebras of finite presentation over an arbitrary ring `A`, which all descend
  to the subring generated by the coefficients of their relations.

## Implementation notes

The source argues with a flat stratification of the base (Stacks 0H3Z). Here the stratification
is replaced by Noetherian induction on the ideals `J` of `A₀`, for the statement that
`N ⊗ᴸ_A A/JA` is a flat module in degree zero: each step glues a principal open and its
complement by Stacks 0H85, using generic freeness (Stacks 051T) on the open part.

## References

* [Stacks Project, Lemma 37.54.3 (0H89)](https://stacks.math.columbia.edu/tag/0H89)
* [Stacks Project, Tag 0H85](https://stacks.math.columbia.edu/tag/0H85)
* [Stacks Project, Tag 051T](https://stacks.math.columbia.edu/tag/051T)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CochainComplex.DerivedExtensionScalars TensorProduct

attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace StacksDraft.DerivedFlat

/-- For a minimal prime `p` of an ideal `J` of a Noetherian ring there is `g ∉ p` such that
`x * g` lies in the radical of `J` for every `x ∈ p`. -/
lemma exists_notMem_mul_mem_radical {A₀ : Type u} [CommRing A₀] [IsNoetherianRing A₀]
    {J p : Ideal A₀} (hp : p ∈ J.minimalPrimes) :
    ∃ g : A₀, g ∉ p ∧ ∀ x ∈ p, ∃ m : ℕ, (x * g) ^ m ∈ J := by
  classical
  have hpp : p.IsPrime := hp.1.1
  let T : Finset (Ideal A₀) := (J.finite_minimalPrimes_of_isNoetherianRing).toFinset.erase p
  have hT : ∀ q ∈ T, ∃ g ∈ q, g ∉ p := by
    intro q hq
    obtain ⟨hqp, hq⟩ := Finset.mem_erase.1 hq
    have hq : q ∈ J.minimalPrimes := (Set.Finite.mem_toFinset _).1 hq
    by_contra hcon
    push Not at hcon
    exact hqp (le_antisymm hcon (hp.2 hq.1 hcon))
  choose! gq hgq hgqp using hT
  refine ⟨∏ q ∈ T, gq q, ?_, fun x hx => ?_⟩
  · rw [Ideal.IsPrime.prod_mem_iff]
    rintro ⟨q, hq, hmem⟩
    exact hgqp q hq hmem
  · show x * ∏ q ∈ T, gq q ∈ J.radical
    rw [← Ideal.sInf_minimalPrimes, Submodule.mem_sInf]
    intro q hq
    by_cases hqp : q = p
    · subst hqp
      exact Ideal.mul_mem_right _ _ hx
    · have hqT : q ∈ T := Finset.mem_erase.2 ⟨hqp, (Set.Finite.mem_toFinset _).2 hq⟩
      exact Ideal.mul_mem_left _ _
        (Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem gq hqT) (hgq q hqT))

/-- Elements of an ideal `K` of `R` map to zero in `S ⧸ K S`. -/
private theorem algebraMap_quotient_map_eq_zero {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] {K : Ideal R} {x : R} (hx : x ∈ K) :
    algebraMap R (S ⧸ K.map (algebraMap R S)) x = 0 := by
  rw [IsScalarTower.algebraMap_apply R S, Ideal.Quotient.algebraMap_eq,
    Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.mem_map_of_mem _ hx

variable {A₀ A : Type u} [CommRing A₀] [IsNoetherianRing A₀] [CommRing A] [Algebra A₀ A]
  {ι : Type*} [Finite ι] (D : ι → Type u) [∀ j, CommRing (D j)] [∀ j, Algebra A₀ (D j)]
  [∀ j, Algebra.FiniteType A₀ (D j)] {N : DerivedCategory (ModuleCat.{u} A)}

/-- If `N ⊗ᴸ_A A/J'A` is a flat module in degree zero for every ideal `J'` of `A₀` strictly
containing `J`, then so is `N ⊗ᴸ_A A/JA`. -/
lemma baseChangeFlat_quotient_step
    (hN : ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj N))
    (hsurj : ∀ P : PrimeSpectrum A, ∃ j,
      P ∈ Set.range (PrimeSpectrum.comap (algebraMap A (A ⊗[A₀] D j))))
    (h : ∀ j, BaseChangeFlat N (algebraMap A (A ⊗[A₀] D j))) (J : Ideal A₀)
    (ih : ∀ J', J < J' →
      BaseChangeFlat N (Ideal.Quotient.mk (J'.map (algebraMap A₀ A)))) :
    BaseChangeFlat N (Ideal.Quotient.mk (J.map (algebraMap A₀ A))) := by
  classical
  by_cases hJ : J = ⊤
  · have : Subsingleton (A ⧸ J.map (algebraMap A₀ A)) :=
      Ideal.Quotient.subsingleton_iff.2 (by rw [hJ, Ideal.map_top])
    exact baseChangeFlat_of_subsingleton _
  obtain ⟨p, hp⟩ := Ideal.nonempty_minimalPrimes hJ
  have hpp : p.IsPrime := hp.1.1
  have hJp : J ≤ p := hp.1.2
  obtain ⟨g, hgp, hg⟩ := exists_notMem_mul_mem_radical hp
  choose hh hhne hhflat using fun j => exists_flat_tensor_quotient (D := D j) p
  choose h' hh' using fun j => Ideal.Quotient.mk_surjective (hh j)
  let _ := Fintype.ofFinite ι
  let c : A₀ := g * ∏ j, h' j
  have hcp : c ∉ p := by
    refine (Ideal.IsPrime.mul_notMem hpp hgp ?_)
    rw [Ideal.IsPrime.prod_mem_iff]
    rintro ⟨j, -, hj⟩
    exact hhne j (by rw [← hh' j]; exact Ideal.Quotient.eq_zero_iff_mem.2 hj)
  have hcJ : c ∉ J := fun hc => hcp (hJp hc)
  let ι₀ := algebraMap A₀ A
  let J' := J.map ι₀
  let AJ := A ⧸ J'
  let cJ : AJ := algebraMap A₀ AJ c
  let R := Localization.Away cJ
  let I : Ideal R := p.map (algebraMap A₀ R)
  let R'' := R ⧸ I
  have hcR : IsUnit (algebraMap A₀ R c) := by
    rw [IsScalarTower.algebraMap_apply A₀ AJ R]
    exact IsLocalization.Away.algebraMap_isUnit cJ
  have hQuot : BaseChangeFlat N ((Ideal.Quotient.mk (Ideal.span {cJ})).comp
      (Ideal.Quotient.mk J')) := by
    have hlt : J < J ⊔ Ideal.span {c} := lt_of_le_of_ne le_sup_left fun e =>
      hcJ (e ▸ Ideal.mem_sup_right (Ideal.mem_span_singleton_self c))
    have hmap : (J ⊔ Ideal.span {c}).map ι₀ = J' ⊔ Ideal.span {ι₀ c} := by
      rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton]
    have hmap2 : (Ideal.span {ι₀ c}).map (Ideal.Quotient.mk J') = Ideal.span {cJ} := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    let e : AJ ⧸ Ideal.span {cJ} ≃+* A ⧸ (J ⊔ Ideal.span {c}).map ι₀ :=
      (Ideal.quotEquivOfEq hmap2.symm).trans
        ((DoubleQuot.quotQuotEquivQuotSup J' (Ideal.span {ι₀ c})).trans
          (Ideal.quotEquivOfEq hmap.symm))
    refine BaseChangeFlat.of_comp_ringEquiv e ((ih _ hlt).of_eq ?_)
    ext a
    show _ = (Ideal.quotEquivOfEq hmap.symm) (DoubleQuot.quotQuotEquivQuotSup _ _
      (DoubleQuot.quotQuotMk J' (Ideal.span {ι₀ c}) a))
    rw [DoubleQuot.quotQuotEquivQuotSup_quotQuotMk]
    simp [ι₀]
  let E := Localization.Away (Ideal.Quotient.mk p c)
  let χ : A₀ ⧸ p →+* R'' :=
    Ideal.Quotient.lift p (algebraMap A₀ R'') fun x hx => algebraMap_quotient_map_eq_zero hx
  have hχc : IsUnit (χ (Ideal.Quotient.mk p c)) := by
    show IsUnit (algebraMap A₀ R'' c)
    rw [IsScalarTower.algebraMap_apply A₀ R R'']
    exact hcR.map _
  let ψ : E →+* R'' := IsLocalization.Away.lift (Ideal.Quotient.mk p c) hχc
  let : Algebra E R'' := ψ.toAlgebra
  have : IsScalarTower A₀ E R'' := IsScalarTower.of_algebraMap_eq fun x => by
    show algebraMap A₀ R'' x = ψ (algebraMap A₀ E x)
    rw [IsScalarTower.algebraMap_apply A₀ (A₀ ⧸ p) E, IsLocalization.Away.lift_eq]
    rfl
  have hflatE : ∀ j, Module.Flat E (E ⊗[A₀] D j) := fun j => hhflat j _ (by
    rw [← hh' j]
    show _ ∣ Ideal.Quotient.mk p (g * ∏ j, h' j)
    rw [map_mul, map_prod]
    exact Dvd.dvd.mul_left (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)) _)
  have hflat : ∀ j, Module.Flat R'' (R'' ⊗[A₀] D j) := fun j =>
    Module.Flat.of_linearEquiv
      (Algebra.TensorProduct.cancelBaseChange A₀ E R'' R'' (D j)).symm.toLinearEquiv
  have hR'' : BaseChangeFlat N (algebraMap A R'') := by
    refine BaseChangeFlat.of_flat_family (algebraMap A R'') (fun j => R'' ⊗[A₀] D j)
      (fun P => ?_) (fun j => ?_)
    · obtain ⟨j, q, hq⟩ := hsurj (P.comap (algebraMap A R''))
      obtain ⟨Q, hQ⟩ := exists_comap_includeLeft_eq (A := A) (R' := R'')
        (B := A ⊗[A₀] D j) P q hq.symm
      let e := Algebra.TensorProduct.cancelBaseChange A₀ A R'' R'' (D j)
      refine ⟨j, Q.comap e.symm.toAlgHom.toRingHom, ?_⟩
      rw [← hQ, ← PrimeSpectrum.comap_comp_apply]
      congr 1
    · let θ := Algebra.TensorProduct.map (IsScalarTower.toAlgHom A₀ A R'') (AlgHom.id A₀ (D j))
      refine ((h j).comp θ.toRingHom).of_eq ?_
      ext a
      simp [θ, Algebra.TensorProduct.algebraMap_apply]
  have hR : BaseChangeFlat N (algebraMap A R) := by
    refine BaseChangeFlat.of_quotient_of_le_nilradical hN (algebraMap A R) I
      (Ideal.FG.map (IsNoetherian.noetherian p) _) ?_
      (hR''.of_eq (IsScalarTower.algebraMap_eq A R R''))
    refine Ideal.map_le_iff_le_comap.2 fun x hx => ?_
    obtain ⟨m, hm⟩ := hg x hx
    rw [Ideal.mem_comap, mem_nilradical]
    have hzero : algebraMap A₀ R ((x * g) ^ m) = 0 := by
      rw [IsScalarTower.algebraMap_apply A₀ AJ R]
      rw [algebraMap_quotient_map_eq_zero (S := A) hm, map_zero]
    have hgu : IsUnit (algebraMap A₀ R g) := by
      have : algebraMap A₀ R c = algebraMap A₀ R g * algebraMap A₀ R (∏ j, h' j) := map_mul _ _ _
      exact isUnit_of_mul_isUnit_left (this ▸ hcR)
    refine ⟨m, ?_⟩
    rw [map_pow, map_mul, mul_pow] at hzero
    exact (hgu.pow m).mul_left_eq_zero.1 hzero
  refine BaseChangeFlat.of_away_of_quotient hN (Ideal.Quotient.mk J') cJ ?_ hQuot
  refine hR.of_eq ?_
  rw [IsScalarTower.algebraMap_eq A AJ R]
  rfl

/-- **Flatness in degree zero descends along a jointly surjective family of base changes of
algebras of finite type over a Noetherian ring.** -/
theorem isFlatInDegreeZero_of_tensor_family
    (hN : ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj N))
    (hsurj : ∀ P : PrimeSpectrum A, ∃ j,
      P ∈ Set.range (PrimeSpectrum.comap (algebraMap A (A ⊗[A₀] D j))))
    (h : ∀ j, BaseChangeFlat N (algebraMap A (A ⊗[A₀] D j))) :
    IsFlatInDegreeZero N := by
  have key : ∀ J : Ideal A₀,
      BaseChangeFlat N (Ideal.Quotient.mk (J.map (algebraMap A₀ A))) := fun J =>
    WellFoundedGT.induction J (baseChangeFlat_quotient_step D hN hsurj h)
  let e : A ⧸ (⊥ : Ideal A₀).map (algebraMap A₀ A) ≃+* A :=
    (Ideal.quotEquivOfEq Ideal.map_bot).trans (RingEquiv.quotientBot A)
  refine baseChangeFlat_id_iff.1 (BaseChangeFlat.of_comp_ringEquiv e.symm ((key ⊥).of_eq ?_))
  ext a
  apply e.injective
  simp [e]

/-- **Flatness in degree zero descends along a jointly surjective finite family of algebras of
finite presentation.** Let `B_j` be finitely many algebras of finite presentation over `A` such
that the maps `Spec B_j → Spec A` are jointly surjective, and let `N ∈ D(A)` have no positive
cohomology. If every `N ⊗ᴸ_A B_j` is a flat `B_j`-module placed in degree zero, so is `N`. -/
theorem isFlatInDegreeZero_of_finitePresentation_family {A : Type u} [CommRing A]
    {ι : Type*} [Finite ι] (B : ι → Type u) [∀ j, CommRing (B j)] [∀ j, Algebra A (B j)]
    [∀ j, Algebra.FinitePresentation A (B j)] {N : DerivedCategory (ModuleCat.{u} A)}
    (hN : ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj N))
    (hsurj : ∀ P : PrimeSpectrum A, ∃ j,
      P ∈ Set.range (PrimeSpectrum.comap (algebraMap A (B j))))
    (h : ∀ j, BaseChangeFlat N (algebraMap A (B j))) :
    IsFlatInDegreeZero N := by
  classical
  choose n m hP using fun j => Algebra.Presentation.exists_presentation_fin A (B j)
  let P : ∀ j, Algebra.Presentation A (B j) (Fin (n j)) (Fin (m j)) := fun j => (hP j).some
  let s : Set A := ⋃ j, (P j).coeffs
  have hs : s.Finite := Set.finite_iUnion fun j => (P j).finite_coeffs
  let A₀ := Algebra.adjoin ℤ s
  have : Algebra.FiniteType ℤ A₀ := Algebra.FiniteType.adjoin_of_finite hs
  have : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing ℤ A₀
  have hcoeffs : ∀ j, (P j).HasCoeffs A₀ := fun j =>
    ⟨fun x hx => ⟨⟨x, Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨j, hx⟩)⟩, rfl⟩⟩
  let D : ι → Type u := fun j => (P j).ModelOfHasCoeffs A₀
  have : ∀ j, Algebra.FiniteType A₀ (D j) := fun j => inferInstance
  let e : ∀ j, A ⊗[A₀] D j ≃ₐ[A] B j := fun j => (P j).tensorModelOfHasCoeffsEquiv A₀
  refine isFlatInDegreeZero_of_tensor_family (A₀ := A₀) D hN (fun Q => ?_) (fun j => ?_)
  · obtain ⟨j, q, hq⟩ := hsurj Q
    refine ⟨j, q.comap (e j).toAlgHom.toRingHom, ?_⟩
    rw [← hq, ← PrimeSpectrum.comap_comp_apply]
    congr 1
    exact (e j).toAlgHom.comp_algebraMap
  · refine ((h j).comp (e j).symm.toAlgHom.toRingHom).of_eq ?_
    exact (e j).symm.toAlgHom.comp_algebraMap

end StacksDraft.DerivedFlat

