/-!
# Flatness from a regular system of parameters that stays regular

Let `R` be a Noetherian local ring whose maximal ideal is generated by a list `xs = x₁, …, x_d`,
let `R → S` be a local homomorphism into a Noetherian local ring and let `M` be a finite
`S`-module. If the images of `x₁, …, x_d` in `S` form a weakly `M`-regular sequence, then `M` is
flat over `R`. In particular this holds when `R` is regular and `xs` is a regular system of
parameters.

## Main results

* `Module.Flat.of_ofList_eq_maximalIdeal_of_isWeaklyRegular_map`: if `R` is a regular local ring
  and the image in `S` of a regular system of parameters of `R` is weakly `M`-regular, then `M`
  is flat over `R`.

## Implementation notes

A regular system of parameters is a list `xs : List R` with `Ideal.ofList xs = 𝔪_R` whose length
is `Submodule.spanFinrank 𝔪_R`, the minimal number of generators of `𝔪_R`. The statement is for
a finite `S`-module `M`; the case `M = S` is the flatness of `R → S`. The sequence hypothesis is
`RingTheory.Sequence.IsWeaklyRegular M (xs.map (algebraMap R S))`, that is,
`RingTheory.Sequence.IsRegular` without its nonvanishing clause `M ≠ (x₁, …, x_d)M`, and the
hypothesis `IsLocalHom (algebraMap R S)` is assumed in its place.

## References

* [Stacks, Tag 07DY](https://stacks.math.columbia.edu/tag/07DY)
* [Stacks, Tag 00ML](https://stacks.math.columbia.edu/tag/00ML)

## Tags

flat module, regular local ring, regular system of parameters, regular sequence,
local criterion of flatness
-/

open IsLocalRing Pointwise RingTheory.Sequence TensorProduct



namespace Stacks.Flatness.RegularParameters

/-- Every module over a field is flat. -/
private theorem flat_of_isField {R : Type*} [CommRing R] (M : Type*) [AddCommGroup M]
    [Module R M] (h : IsField R) : Module.Flat R M :=
  let := h.toField
  Module.Flat.of_free

/-- If `x` is a nonzerodivisor on `M`, then the map `xR ⊗_R M → R ⊗_R M` induced by the
inclusion `xR ⊆ R` is injective. -/
public theorem rTensor_subtype_span_singleton_injective_of_isSMulRegular {R : Type*}
    [CommRing R] (M : Type*) [AddCommGroup M] [Module R M] {x : R} (hx : IsSMulRegular M x) :
    Function.Injective ((Ideal.span {x} : Ideal R).subtype.rTensor M) := by
  set J : Ideal R := Ideal.span {x}
  set φ : R →ₗ[R] J := LinearMap.toSpanSingleton R J ⟨x, Ideal.mem_span_singleton_self x⟩ with hφ
  have hsurj : Function.Surjective (φ.rTensor M) := by
    refine LinearMap.rTensor_surjective M fun ⟨y, hy⟩ ↦ ?_
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    exact ⟨r, by ext; simp [hφ, LinearMap.toSpanSingleton_apply, smul_eq_mul]⟩
  have key : (J.subtype ∘ₗ φ).rTensor M = x • LinearMap.id := by
    ext m
    simp [hφ, LinearMap.toSpanSingleton_apply, TensorProduct.smul_tmul', smul_eq_mul]
  have hreg : IsSMulRegular (R ⊗[R] M) x :=
    (LinearEquiv.isSMulRegular_congr' (TensorProduct.lid R M) x).mpr hx
  refine Function.Injective.of_comp_right ?_ hsurj
  rw [← LinearMap.coe_comp, ← LinearMap.rTensor_comp, key]
  exact fun a b h ↦ hreg (by simpa using h)

/-- Let `x ∈ 𝔪_R` be a nonzerodivisor on `M`. If `M ⧸ xM` is flat over `R ⧸ xR`, then `M` is flat
over `R`. -/
private theorem flat_of_isSMulRegular_of_flat_quotSMulTop {R : Type u} (S : Type v) (M : Type w)
    [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [IsNoetherianRing R]
    [IsNoetherianRing S] [Algebra R S] [IsLocalHom (algebraMap R S)] [AddCommGroup M]
    [Module R M] [Module S M] [IsScalarTower R S M] [Module.Finite S M] {x : R}
    (hx : x ∈ maximalIdeal R) (hreg : IsSMulRegular M x)
    [Module (R ⧸ Ideal.span {x}) (QuotSMulTop (algebraMap R S x) M)]
    [IsScalarTower R (R ⧸ Ideal.span {x}) (QuotSMulTop (algebraMap R S x) M)]
    (hflat : Module.Flat (R ⧸ Ideal.span {x}) (QuotSMulTop (algebraMap R S x) M)) :
    Module.Flat R M :=
  have hxM : Submodule.restrictScalars R (algebraMap R S x • (⊤ : Submodule S M))
      = Ideal.span {x} • (⊤ : Submodule R M) := by
    rw [element_smul_restrictScalars, Submodule.restrictScalars_top,
      Submodule.ideal_span_singleton_smul]
  Module.Flat.of_rTensor_subtype_injective_of_flat_quotient S M (Ideal.span {x})
    (Ideal.span_singleton_ne_top ((mem_maximalIdeal x).mp hx))
    (rTensor_subtype_span_singleton_injective_of_isSMulRegular M hreg)
    (Module.Flat.of_linearEquiv
      (((Submodule.quotEquivOfEq _ _ hxM.symm).trans
        (Submodule.Quotient.restrictScalarsEquiv R _)).extendScalarsOfSurjective
          Ideal.Quotient.mk_surjective))

/-- If `f₁` is surjective and `g ∘ f₁ = f₂` is a local homomorphism, then `g` is a local
homomorphism. -/
private theorem isLocalHom_of_comp_surjective {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] {f₁ : R →+* S} {g : S →+* T} (f₂ : R →+* T) (hf₂ : IsLocalHom f₂)
    (hf₁ : Function.Surjective f₁) (h : ∀ a, g (f₁ a) = f₂ a) : IsLocalHom g := by
  have := hf₂
  refine ⟨fun {a} ha ↦ ?_⟩
  obtain ⟨b, rfl⟩ := hf₁ a
  rw [h] at ha
  exact (isUnit_of_map_unit f₂ b ha).map f₁

/-- If a list `x :: rest` generates the maximal ideal of a local ring `R`, then the images of
`rest` generate the maximal ideal of `R ⧸ xR`. -/
public theorem ofList_map_mk_eq_maximalIdeal {R : Type*} [CommRing R] [IsLocalRing R] (x : R)
    (rest : List R) [IsLocalRing (R ⧸ Ideal.span {x})]
    (hxs : Ideal.ofList (x :: rest) = maximalIdeal R) :
    Ideal.ofList (rest.map (Ideal.Quotient.mk (Ideal.span {x})))
      = maximalIdeal (R ⧸ Ideal.span {x}) := by
  rw [← Ideal.map_ofList, ← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective, ← hxs,
    Ideal.ofList_cons, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq]

/-- Let `R` be a Noetherian local ring whose maximal ideal is generated by a list `xs` of length
`n`. If the image of `xs` in `S` is weakly `M`-regular, then `M` is flat over `R`. -/
private theorem flat_of_ofList_eq_maximalIdeal_of_isWeaklyRegular {R : Type u} (S : Type v)
    (M : Type w) [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [IsNoetherianRing R]
    [IsNoetherianRing S] [Algebra R S] [IsLocalHom (algebraMap R S)] [AddCommGroup M]
    [Module R M] [Module S M] [IsScalarTower R S M] [Module.Finite S M] (n : ℕ) (xs : List R)
    (hlen : xs.length = n) (hxs : Ideal.ofList xs = maximalIdeal R)
    (hreg : IsWeaklyRegular M (xs.map (algebraMap R S))) : Module.Flat R M := by
  induction n generalizing R S M with
  | zero =>
    obtain rfl : xs = [] := List.length_eq_zero_iff.mp hlen
    exact flat_of_isField M (isField_iff_maximalIdeal_eq.mpr (hxs ▸ Ideal.ofList_nil))
  | succ n ih =>
    cases xs with
    | nil => simp at hlen
    | cons x rest =>
    have hx : x ∈ maximalIdeal R := by
      rw [← hxs, Ideal.ofList_cons]
      exact Submodule.mem_sup_left (Ideal.mem_span_singleton_self x)
    have hfx : algebraMap R S x ∈ maximalIdeal S :=
      map_maximalIdeal_le (algebraMap R S) (Ideal.mem_map_of_mem _ hx)
    have : IsLocalRing (R ⧸ Ideal.span {x}) :=
      isLocalRing_quotient (Ideal.span_singleton_ne_top ((mem_maximalIdeal x).mp hx))
    have : IsLocalRing (S ⧸ Ideal.span {algebraMap R S x}) :=
      isLocalRing_quotient (Ideal.span_singleton_ne_top ((mem_maximalIdeal _).mp hfx))
    let : Algebra (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x}) :=
      Ideal.Quotient.algebraQuotientOfLEComap
        ((Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_span_singleton_self _))
    have halg : ∀ a : R, algebraMap (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x})
        (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (algebraMap R S a) := fun _ ↦
      Ideal.quotientMap_mk
    have : IsLocalHom (Ideal.Quotient.mk (Ideal.span {algebraMap R S x})) :=
      .of_surjective _ Ideal.Quotient.mk_surjective
    have : IsLocalHom (algebraMap (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x})) :=
      isLocalHom_of_comp_surjective ((Ideal.Quotient.mk _).comp (algebraMap R S))
        (RingHom.isLocalHom_comp _ _) Ideal.Quotient.mk_surjective halg
    let : Module (R ⧸ Ideal.span {x}) (QuotSMulTop (algebraMap R S x) M) :=
      Module.compHom _ (algebraMap (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x}))
    have : IsScalarTower (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x})
        (QuotSMulTop (algebraMap R S x) M) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
    have : IsScalarTower R (R ⧸ Ideal.span {x}) (QuotSMulTop (algebraMap R S x) M) := by
      refine IsScalarTower.of_algebraMap_smul fun r m ↦ ?_
      change algebraMap (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x})
        (algebraMap R _ r) • m = r • m
      rw [Ideal.Quotient.algebraMap_eq, halg, ← Ideal.Quotient.algebraMap_eq,
        IsScalarTower.algebraMap_smul, algebraMap_smul]
    have : Module.Finite (S ⧸ Ideal.span {algebraMap R S x})
        (QuotSMulTop (algebraMap R S x) M) := Module.Finite.of_restrictScalars_finite S _ _
    rw [List.map_cons, isWeaklyRegular_cons_iff'] at hreg
    refine flat_of_isSMulRegular_of_flat_quotSMulTop S M hx
      ((isSMulRegular_algebraMap_iff S).mp hreg.1)
      (ih (S ⧸ Ideal.span {algebraMap R S x}) _ (rest.map (Ideal.Quotient.mk _))
        (by simpa using hlen) (ofList_map_mk_eq_maximalIdeal x rest hxs) ?_)
    rw [show (rest.map (Ideal.Quotient.mk (Ideal.span {x}))).map
          (algebraMap (R ⧸ Ideal.span {x}) (S ⧸ Ideal.span {algebraMap R S x}))
        = (rest.map (algebraMap R S)).map (Ideal.Quotient.mk (Ideal.span {algebraMap R S x})) by
      simp only [List.map_map]; exact List.map_congr_left fun a _ ↦ halg a]
    exact hreg.2

open IsLocalRing RingTheory.Sequence in
/-- Let `R` be a regular local ring, let `xs` be a regular system of parameters of `R`, let
`R → S` be a local homomorphism into a Noetherian local ring and let `M` be a finite `S`-module.
If the image of `xs` in `S` is weakly `M`-regular, then `M` is flat over `R`. -/
public theorem solution {R : Type u} (S : Type v) (M : Type w) [CommRing R]
    [IsRegularLocalRing R] [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)] [AddCommGroup M] [Module R M] [Module S M]
    [IsScalarTower R S M] [Module.Finite S M] (xs : List R)
    (hxs : Ideal.ofList xs = maximalIdeal R)
    (hmin : xs.length = (maximalIdeal R).spanFinrank)
    (hreg : IsWeaklyRegular M (xs.map (algebraMap R S))) :
    Module.Flat R M := by
  let _ := hmin
  exact flat_of_ofList_eq_maximalIdeal_of_isWeaklyRegular S M xs.length xs rfl hxs hreg

end Stacks.Flatness.RegularParameters

@[expose] public section

open IsLocalRing RingTheory.Sequence in
/-- Let `R` be a regular local ring, let `xs = x₁, …, x_d` be a regular system of parameters of
`R`, that is, a list generating `𝔪_R` whose length is the minimal number of generators of `𝔪_R`,
let `S` be a Noetherian local ring receiving a local homomorphism from `R` and let `M` be a
finite `S`-module. If the images of `x₁, …, x_d` in `S` form a weakly `M`-regular sequence, then
`M` is flat over `R`. Taking `M = S` shows that `R → S` is flat. -/
@[stacks 07DY "Stated for a finite `S`-module `M` in place of `S` itself, the source's statement
being the case `M = S`; a regular system of parameters is a list generating the maximal ideal
whose length is its minimal number of generators; and the source's regular sequence is weakened
to `RingTheory.Sequence.IsWeaklyRegular`, its nonvanishing clause being replaced by
`IsLocalHom`. See the module docstring."]
public theorem Module.Flat.of_ofList_eq_maximalIdeal_of_isWeaklyRegular_map
    {R : Type*} (S : Type*) (M : Type*) [CommRing R] [IsRegularLocalRing R] [CommRing S]
    [IsLocalRing S] [IsNoetherianRing S] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] [Module.Finite S M]
    (xs : List R) (hxs : Ideal.ofList xs = maximalIdeal R)
    (hmin : xs.length = (maximalIdeal R).spanFinrank)
    (hreg : IsWeaklyRegular M (xs.map (algebraMap R S))) :
    Module.Flat R M :=
  Stacks.Flatness.RegularParameters.solution S M xs hxs hmin hreg

end
