module

public import StacksFrontier.RingTheory.Flat.CompleteDevissage

/-!
# The fibre prime of a dévissage stage lies over the base prime

A complete dévissage `Module.CompleteDevissage` of `N/S/R` over a prime `r` of `R` records at each
stage that the extended ideal `rBᵢ` is prime. This file shows that `rBᵢ` contracts to `r`: the
fibres of `Spec(Bᵢ) → Spec(R)` are geometrically irreducible, hence nonempty, so
`Spec(Bᵢ) → Spec(R)` is surjective and `r` is the contraction of a prime of `Bᵢ` containing
`rBᵢ`.

## Main results

* `Ideal.comap_map_eq_of_comap_eq`: if some prime of `B` contracts to `r`, then the ideal
  `rB` contracts to `r` as well.
* `Module.CompleteDevissage.comap_map_eq`: the contraction of `rBᵢ` is `r`.
* `Module.CompleteDevissage.disjoint_map`: the image in `Bᵢ` of the complement of `r` misses
  `rBᵢ`.

## References

* [Stacks Project, Tag 05HX](https://stacks.math.columbia.edu/tag/05HX)
* [Stacks Project, Tag 05I5](https://stacks.math.columbia.edu/tag/05I5)
-/

@[expose] public section

open AlgebraicGeometry

universe u v w

/-- If a prime of `B` contracts to the ideal `r` of `R`, then so does the ideal `rB` generated by
`r` in `B`. -/
public theorem Ideal.comap_map_eq_of_comap_eq {R B : Type*} [CommRing R] [CommRing B]
    (φ : R →+* B) (r : Ideal R) (Q : Ideal B) (hQ : Q.comap φ = r) :
    (Ideal.map φ r).comap φ = r :=
  ((Ideal.comap_mono (Ideal.map_le_iff_le_comap.mpr hQ.ge)).trans hQ.le).antisymm
    Ideal.le_comap_map

namespace Module.CompleteDevissage

variable {R : Type u} {S : Type v} {N : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [Algebra.FiniteType R S] [AddCommGroup N] [Module S N] [Module.Finite S N] {r : Ideal R}
  [r.IsPrime]

/-- **The fibre prime of a stage lies over the base prime.** For every stage `Bᵢ` of a complete
dévissage over the prime `r`, the ideal `rBᵢ` contracts to `r`. -/
public theorem comap_map_eq (D : CompleteDevissage R S N r) (i : Fin (D.stepCount + 1)) :
    (Ideal.map (algebraMap R (D.B i)) r).comap (algebraMap R (D.B i)) = r := by
  obtain ⟨Q, hQ⟩ :=
    (Spec.map (CommRingCat.ofHom (algebraMap R (D.B i)))).surjective
      (⟨r, inferInstance⟩ : PrimeSpectrum R)
  exact Ideal.comap_map_eq_of_comap_eq _ r Q.asIdeal (congrArg PrimeSpectrum.asIdeal hQ)

/-- **The multiplicative set inverted by localizing the base at `r` misses the fibre prime.** For
every stage `Bᵢ` of a complete dévissage over the prime `r`, the image in `Bᵢ` of the complement
of `r` is disjoint from `rBᵢ`. -/
public theorem disjoint_map (D : CompleteDevissage R S N r) (i : Fin (D.stepCount + 1)) :
    Disjoint (Algebra.algebraMapSubmonoid (D.B i) r.primeCompl : Set (D.B i))
      (Ideal.map (algebraMap R (D.B i)) r : Set (D.B i)) := by
  rw [Set.disjoint_left]
  rintro x ⟨a, ha, rfl⟩ hx
  exact ha (by simpa [D.comap_map_eq i] using (Ideal.mem_comap (f := algebraMap R (D.B i))).2 hx)

end Module.CompleteDevissage

end
