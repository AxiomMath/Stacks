-/

@[expose] public noncomputable section

open TensorProduct

namespace Ideal

universe u

variable {R : Type u} [CommRing R] (I : Ideal R) (S : Type u) [CommRing S] [Algebra R S]

/-! ### Multiplication `I ⊗ S → I S` -/

/-- An element of `S` lies in the extended ideal `I S` exactly when it is the product of an
element of `I ⊗[R] S`, that is when it is in the image of `Ideal.tensorSMulHom`. -/
@[ega "0 1.0.3" "special case"]
theorem mem_map_algebraMap_iff_exists_tensorSMulHom (y : S) :
    y ∈ I.map (algebraMap R S) ↔ ∃ v, I.tensorSMulHom S v = y := by
  rw [← Submodule.restrictScalars_mem R, ← Ideal.smul_top_eq_map, ← I.range_tensorSMulHom S]
  exact LinearMap.mem_range

/-- **Multiplication with values in the extended ideal.** The canonical map `I ⊗[R] S → S` of
`Ideal.tensorSMulHom`, with its codomain cut down to the ideal `I S` that is its image. -/
def tensorSMulHomToMap : ↥I ⊗[R] S →ₗ[R] ↥(I.map (algebraMap R S)) :=
  LinearMap.codRestrict ((I.map (algebraMap R S)).restrictScalars R) (I.tensorSMulHom S)
    fun v => (I.mem_map_algebraMap_iff_exists_tensorSMulHom S _).mpr ⟨v, rfl⟩

/-- The value in `S` of `Ideal.tensorSMulHomToMap` is that of `Ideal.tensorSMulHom`. -/
@[simp]
theorem coe_tensorSMulHomToMap_apply (v : ↥I ⊗[R] S) :
    (I.tensorSMulHomToMap S v : S) = I.tensorSMulHom S v :=
  rfl

/-- **The first identification of the proof of [Stacks Project, Tag 0473]:** `I S = I ⊗[R] S`
for `S` flat over `R`.  Injectivity is flatness tested on the ideal `I`, and surjectivity is the
computation of the image of multiplication. -/
theorem bijective_tensorSMulHomToMap [Module.Flat R S] :
    Function.Bijective (I.tensorSMulHomToMap S) := by
  refine ⟨fun a b hab => ?_, fun y => ?_⟩
  · exact (I.injective_tensorSMulHom_iff S).mpr
      (Module.Flat.iff_rTensor_injective'.mp ‹Module.Flat R S› I) (congrArg Subtype.val hab)
  · obtain ⟨v, hv⟩ := (I.mem_map_algebraMap_iff_exists_tensorSMulHom S (y : S)).mp y.2
    exact ⟨v, Subtype.ext hv⟩

/-- The extended ideal `I S` is `I ⊗[R] S` when `S` is flat over `R`.  Applied to `I ^ 2` and
combined with `Ideal.map_pow` this also gives `(I S) ^ 2 = I ^ 2 ⊗[R] S`, the second
identification used in the proof of [Stacks Project, Tag 0473]. -/
def tensorEquivMap [Module.Flat R S] : ↥I ⊗[R] S ≃ₗ[R] ↥(I.map (algebraMap R S)) :=
  LinearEquiv.ofBijective _ (I.bijective_tensorSMulHomToMap S)

/-- The value of `Ideal.tensorEquivMap` in `S` is that of `Ideal.tensorSMulHom`. -/
@[simp]
theorem coe_tensorEquivMap_apply [Module.Flat R S] (v : ↥I ⊗[R] S) :
    (I.tensorEquivMap S v : S) = I.tensorSMulHom S v :=
  rfl

/-! ### The canonical map of conormal modules -/

/-- The structure map `R → S` restricted to a map `I → I S` of the ideal into its extension. -/
def algebraMapRestrict : ↥I →ₗ[R] ↥(I.map (algebraMap R S)) :=
  (Algebra.linearMap R S).restrict (p := I) (q := (I.map (algebraMap R S)).restrictScalars R)
    fun _ hx => Ideal.mem_map_of_mem _ hx

/-- The value of `Ideal.algebraMapRestrict` at `x ∈ I` is `algebraMap R S x`. -/
@[simp]
theorem coe_algebraMapRestrict_apply (x : I) :
    (I.algebraMapRestrict S x : S) = algebraMap R S (x : R) :=
  rfl

/-- The composite `I → I S → I S ⧸ (I S) ^ 2` of the structure map with the conormal quotient of
the extended ideal. -/
def toMapCotangent : ↥I →ₗ[R] (I.map (algebraMap R S)).Cotangent :=
  LinearMap.restrictScalars R (I.map (algebraMap R S)).toCotangent ∘ₗ I.algebraMapRestrict S

/-- `Ideal.toMapCotangent` sends `x ∈ I` to the class of `algebraMap R S x` in
`I S ⧸ (I S) ^ 2`. -/
theorem toMapCotangent_apply (x : I) :
    I.toMapCotangent S x = (I.map (algebraMap R S)).toCotangent
      ⟨algebraMap R S (x : R), Ideal.mem_map_of_mem _ x.2⟩ :=
  rfl

/-- The products `I · I` die in the conormal module of the extended ideal, because they map into
`(I S) ^ 2`. -/
theorem smul_top_le_ker_toMapCotangent :
    (I • ⊤ : Submodule R ↥I) ≤ LinearMap.ker (I.toMapCotangent S) := by
  rw [Submodule.smul_le]
  intro r hr x _
  rw [LinearMap.mem_ker, toMapCotangent_apply, Ideal.toCotangent_eq_zero, pow_two]
  show algebraMap R S ((r • x : ↥I) : R) ∈ _
  rw [show ((r • x : ↥I) : R) = r * (x : R) from rfl, map_mul]
  exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ hr) (Ideal.mem_map_of_mem _ x.2)

/-- The map `I ⧸ I ^ 2 → I S ⧸ (I S) ^ 2` induced by the structure map `R → S`. -/
def mapCotangentHom : I.Cotangent →ₗ[R] (I.map (algebraMap R S)).Cotangent :=
  Submodule.liftQ _ (I.toMapCotangent S) (I.smul_top_le_ker_toMapCotangent S)

/-- `Ideal.mapCotangentHom` sends the class of `x ∈ I` to the class of `algebraMap R S x` in
`I S ⧸ (I S) ^ 2`. -/
@[simp]
theorem mapCotangentHom_toCotangent (x : I) :
    I.mapCotangentHom S (I.toCotangent x) = (I.map (algebraMap R S)).toCotangent
      ⟨algebraMap R S (x : R), Ideal.mem_map_of_mem _ x.2⟩ :=
  rfl

/-- **The canonical map of conormal modules.** The `R`-linear map
`I ⧸ I ^ 2 ⊗[R] S → I S ⧸ (I S) ^ 2` carrying `(x + I ^ 2) ⊗ b` to `b * x + (I S) ^ 2`.  This is
the affine picture of the map of [Stacks Project, Tag 01R4] whose invertibility over a flat base
is [Stacks Project, Tag 0473]. -/
@[sga "6 VIII 2.2"]
def cotangentBaseChange : I.Cotangent ⊗[R] S →ₗ[R] (I.map (algebraMap R S)).Cotangent :=
  ((I.mapCotangentHom S).liftBaseChange S).restrictScalars R ∘ₗ
    (TensorProduct.comm R I.Cotangent S).toLinearMap

/-- `Ideal.cotangentBaseChange` sends `c ⊗ b` to `b • Ideal.mapCotangentHom S c`. -/
@[simp]
theorem cotangentBaseChange_tmul (c : I.Cotangent) (b : S) :
    I.cotangentBaseChange S (c ⊗ₜ[R] b) = b • I.mapCotangentHom S c :=
  rfl

/-- **The computation both halves run on.** Read inside `S ⧸ (I S) ^ 2`, the canonical map
applied to the image of `v : I ⊗[R] S` is the product of `v`.  Since
`Ideal.cotangentToQuotientSquare` is injective and `Ideal.toCotangent` is surjective, this
determines the canonical map. -/
theorem cotangentToQuotientSquare_cotangentBaseChange_rTensor (v : ↥I ⊗[R] S) :
    (I.map (algebraMap R S)).cotangentToQuotientSquare
        (I.cotangentBaseChange S (LinearMap.rTensor S I.toCotangent v)) =
      Submodule.mkQ (I.map (algebraMap R S) ^ 2) (I.tensorSMulHom S v) := by
  induction v with
  | zero => simp
  | tmul x b =>
      rw [LinearMap.rTensor_tmul, cotangentBaseChange_tmul, map_smul,
        mapCotangentHom_toCotangent, Ideal.toCotangent_to_quotient_square, tensorSMulHom_tmul]
      simp [Algebra.smul_def, mul_comm]
  | add x y hx hy => simp only [map_add, hx, hy]

/-! ### Surjectivity, with no hypotheses -/

/-- **The canonical map of conormal modules is surjective**, with no flatness hypothesis: this is
the affine picture of the surjectivity half of [Stacks Project, Tag 0473].  Every class in
`I S ⧸ (I S) ^ 2` is represented by an element of `I S`, which is a product coming from
`I ⊗[R] S`. -/
theorem surjective_cotangentBaseChange : Function.Surjective (I.cotangentBaseChange S) := by
  intro y
  obtain ⟨x, rfl⟩ := (I.map (algebraMap R S)).toCotangent_surjective y
  obtain ⟨v, hv⟩ := (I.mem_map_algebraMap_iff_exists_tensorSMulHom S (x : S)).mp x.2
  refine ⟨LinearMap.rTensor S I.toCotangent v, ?_⟩
  refine (I.map (algebraMap R S)).cotangentToQuotientSquare_injective ?_
  rw [cotangentToQuotientSquare_cotangentBaseChange_rTensor, hv,
    Ideal.toCotangent_to_quotient_square]

/-! ### Injectivity over a flat base -/

/-- Multiplication `I ^ 2 ⊗[R] S → S` factors through `I ⊗[R] S`, along the inclusion
`I ^ 2 ≤ I`. -/
theorem tensorSMulHom_rTensor_inclusion (w : ↥(I ^ 2) ⊗[R] S) :
    I.tensorSMulHom S
        (LinearMap.rTensor S (Submodule.inclusion (Ideal.pow_le_self two_ne_zero)) w) =
      (I ^ 2).tensorSMulHom S w := by
  induction w with
  | zero => simp
  | tmul x b => rfl
  | add x y hx hy => simp only [map_add, hx, hy]

/-- An element of `I ⊗[R] S` coming from `I ^ 2 ⊗[R] S` dies in `I ⧸ I ^ 2 ⊗[R] S`. -/
theorem rTensor_toCotangent_inclusion (w : ↥(I ^ 2) ⊗[R] S) :
    LinearMap.rTensor S I.toCotangent
        (LinearMap.rTensor S (Submodule.inclusion (Ideal.pow_le_self two_ne_zero)) w) = 0 := by
  rw [← LinearMap.rTensor_comp_apply,
    show I.toCotangent ∘ₗ Submodule.inclusion (Ideal.pow_le_self two_ne_zero) = 0 from
      LinearMap.ext fun x => (Ideal.toCotangent_eq_zero _ _).mpr x.2]
  simp

/-- **The canonical map of conormal modules is injective over a flat base.** An element of
`I ⧸ I ^ 2 ⊗[R] S` killed by the canonical map lifts to some `v : I ⊗[R] S` whose product lies in
`(I S) ^ 2`.  By `Ideal.map_pow` and `Ideal.mem_map_algebraMap_iff_exists_tensorSMulHom` that
product is also the product of some `w : I ^ 2 ⊗[R] S`, and flatness makes multiplication
injective, so `v` is the image of `w` and hence dies in `I ⧸ I ^ 2 ⊗[R] S`. -/
@[sga "3 III 4.13" "partial"]
theorem injective_cotangentBaseChange [Module.Flat R S] :
    Function.Injective (I.cotangentBaseChange S) := by
  have hinj : Function.Injective (I.tensorSMulHom S) := fun a b hab =>
    (I.bijective_tensorSMulHomToMap S).1 (Subtype.ext hab)
  rw [injective_iff_map_eq_zero]
  intro u hu
  obtain ⟨v, rfl⟩ := LinearMap.rTensor_surjective S I.toCotangent_surjective u
  have h1 := I.cotangentToQuotientSquare_cotangentBaseChange_rTensor S v
  rw [hu, map_zero] at h1
  have h2 : I.tensorSMulHom S v ∈ (I ^ 2).map (algebraMap R S) := by
    rw [Ideal.map_pow]
    rwa [eq_comm, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h1
  obtain ⟨w, hw⟩ := ((I ^ 2).mem_map_algebraMap_iff_exists_tensorSMulHom S _).mp h2
  have h3 : LinearMap.rTensor S (Submodule.inclusion (Ideal.pow_le_self two_ne_zero)) w = v :=
    hinj (by rw [tensorSMulHom_rTensor_inclusion, hw])
  rw [← h3, rTensor_toCotangent_inclusion]

/-- **[Stacks Project, Tag 0473], the flat case in the affine picture.** Let `S` be a flat
`R`-algebra, let `I` be an ideal of `R` and let `I S` be the ideal of `S` generated by its image.
Then the canonical map

`I ⧸ I ^ 2 ⊗[R] S ⟶ I S ⧸ (I S) ^ 2`

is an isomorphism.  This is the commutative algebra statement the proof of that tag reduces to;
the sheaf-level statement for a cartesian square of immersions of schemes is not proved here, and
the surjectivity half of the tag is `Stacks.Immersion.epi_immersionConormalSheafMap`. -/
@[stacks 0473 "flat case, affine",
  ega "IV 16.2.2" "(iii)",
  ega "IV 17.13.1" "special case",
  sga "6 VIII 2.2" "special case"]
theorem bijective_cotangentBaseChange [Module.Flat R S] :
    Function.Bijective (I.cotangentBaseChange S) :=
  ⟨I.injective_cotangentBaseChange S, I.surjective_cotangentBaseChange S⟩

/-- The canonical map of conormal modules as an isomorphism, for `S` flat over `R`. -/
@[sga "6 VIII 2.2" "special case"]
def cotangentBaseChangeEquiv [Module.Flat R S] :
    I.Cotangent ⊗[R] S ≃ₗ[R] (I.map (algebraMap R S)).Cotangent :=
  LinearEquiv.ofBijective _ (I.bijective_cotangentBaseChange S)

/-- `Ideal.cotangentBaseChangeEquiv` sends `c ⊗ b` to `b • Ideal.mapCotangentHom S c`. -/
@[simp]
theorem cotangentBaseChangeEquiv_tmul [Module.Flat R S] (c : I.Cotangent) (b : S) :
    I.cotangentBaseChangeEquiv S (c ⊗ₜ[R] b) = b • I.mapCotangentHom S c :=
  rfl

end Ideal

end
