/-!
# Flatness of `M / I₂ M` over `R / I₂`

All rings are commutative with unit and all ring maps are unital.

Let `φ : R → R'` be a ring map, `I ⊆ R` an ideal and `M` an `R`-module. Assume that
`M / IM` is flat over `R / I` and that `R' ⊗_R M` is flat over `R'`. Set
`I₂ = φ⁻¹(φ(I²) R') ⊆ R`. Then `M / I₂ M` is flat over `R / I₂`.

Here `R' ⊗_R M` is regarded as an `R'`-module via the left factor, that is via `φ`, and
`M / I₂ M` is an `R / I₂`-module by the canonical action: `I₂` annihilates `M / I₂ M`, so
the `R`-action factors through `R / I₂`.

## Modelling conventions

A unital ring map `φ : R → R'` between commutative rings is modelled by `[Algebra R R']`,
under which `φ = algebraMap R R'`; this also supplies the `R'`-module structure on the base
change `R' ⊗[R] M`. The ideal `φ(I²) R'` of `R'` generated by the image of `I²` is
`Ideal.map (algebraMap R R') (I ^ 2)`, and its contraction `φ⁻¹(φ(I²) R')` back to `R` is
the corresponding `Ideal.comap`. The quotient `M / IM` is `M ⧸ I • (⊤ : Submodule R M)`,
carrying a canonical `R ⧸ I`-module structure, and flatness is `Module.Flat`.
-/

@[expose] public section

open TensorProduct

universe w

/-- The ideal `I₂ = φ⁻¹(φ(I²) R')` associated to an ideal `I ⊆ R` and a ring
map `φ : R → R'` (modeled as `algebraMap R R'`). -/
noncomputable def idealTwo {R : Type*} [CommRing R] (I : Ideal R)
    (R' : Type*) [CommRing R'] [Algebra R R'] : Ideal R :=
  Ideal.comap (algebraMap R R') (Ideal.map (algebraMap R R') (I ^ 2))

/-- Since `φ(I²)` lands in `φ(I²) R'`, we have `I² ⊆ I₂`. -/
theorem sq_le_idealTwo
    {R : Type*} [CommRing R] (I : Ideal R)
    {R' : Type*} [CommRing R'] [Algebra R R'] :
    I ^ 2 ≤ idealTwo I R' := by
  intro x hx
  simp only [idealTwo, Ideal.mem_comap]
  exact Ideal.mem_map_of_mem _ hx

/-- In the quotient ring `R ⧸ I₂`, the image of the ideal `I` squares to zero,
because `I² ⊆ I₂`. This is the square-zero ideal that drives the local
criterion of flatness in the proof of
`flat_quot_idealTwo_smul_top_of_flat_quot_and_flat_baseChange`. -/
theorem image_I_sq_eq_bot
    {R : Type*} [CommRing R] (I : Ideal R)
    {R' : Type*} [CommRing R'] [Algebra R R'] :
    (Ideal.map (Ideal.Quotient.mk (idealTwo I R')) I) ^ 2 = ⊥ := by
  rw [← Ideal.map_pow]
  rw [Ideal.map_eq_bot_iff_le_ker]
  rw [Ideal.mk_ker]
  exact sq_le_idealTwo I

/-- Change-of-rings core of `factB_Jkilled`, for `A`, `B` in arbitrary universes. -/
private lemma factB_Jkilled_aux
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    {A : Type*} [AddCommGroup A] [Module S A] {B : Type*} [AddCommGroup B] [Module S B]
    (hA : J • (⊤ : Submodule S A) = ⊥) (hB : J • (⊤ : Submodule S B) = ⊥)
    (f : A →ₗ[S] B) (hf : Function.Injective f) :
    Function.Injective (f.lTensor N) := by
  have hsurj : Function.Surjective (algebraMap S (S ⧸ J)) := Ideal.Quotient.mk_surjective
  set NB := N ⧸ J • (⊤ : Submodule S N) with hNB
  let fbar : (A ⧸ J • (⊤ : Submodule S A)) →ₗ[S] (B ⧸ J • (⊤ : Submodule S B)) :=
    Submodule.mapQ _ _ f (by rw [hA]; exact bot_le)
  let f' : (A ⧸ J • (⊤ : Submodule S A)) →ₗ[S ⧸ J] (B ⧸ J • (⊤ : Submodule S B)) :=
    LinearMap.extendScalarsOfSurjective hsurj fbar
  let qt' : (S ⧸ J) ⊗[S] N ≃ₗ[S ⧸ J] NB :=
    LinearEquiv.extendScalarsOfSurjective hsurj (TensorProduct.quotTensorEquivQuotSMul N J)
  let ΦA : (A ⊗[S] N) ≃ₗ[S] ((A ⧸ J • (⊤ : Submodule S A)) ⊗[S ⧸ J] NB) :=
    (TensorProduct.congr (Submodule.quotEquivOfEqBot _ hA).symm (LinearEquiv.refl S N)).trans
      (((TensorProduct.AlgebraTensorModule.cancelBaseChange S (S ⧸ J) (S ⧸ J)
        (A ⧸ J • (⊤ : Submodule S A)) N).restrictScalars S).symm.trans
        ((TensorProduct.congr (LinearEquiv.refl (S ⧸ J) _) qt').restrictScalars S))
  let ΦB : (B ⊗[S] N) ≃ₗ[S] ((B ⧸ J • (⊤ : Submodule S B)) ⊗[S ⧸ J] NB) :=
    (TensorProduct.congr (Submodule.quotEquivOfEqBot _ hB).symm (LinearEquiv.refl S N)).trans
      (((TensorProduct.AlgebraTensorModule.cancelBaseChange S (S ⧸ J) (S ⧸ J)
        (B ⧸ J • (⊤ : Submodule S B)) N).restrictScalars S).symm.trans
        ((TensorProduct.congr (LinearEquiv.refl (S ⧸ J) _) qt').restrictScalars S))
  let ΨA : (N ⊗[S] A) ≃ₗ[S] ((A ⧸ J • (⊤ : Submodule S A)) ⊗[S ⧸ J] NB) :=
    (TensorProduct.comm S N A).trans ΦA
  let ΨB : (N ⊗[S] B) ≃ₗ[S] ((B ⧸ J • (⊤ : Submodule S B)) ⊗[S ⧸ J] NB) :=
    (TensorProduct.comm S N B).trans ΦB
  have hf'mk : ∀ a : A, f' (Submodule.Quotient.mk a) = Submodule.Quotient.mk (f a) := by
    intro a
    change fbar (Submodule.Quotient.mk a) = _
    simp only [fbar, Submodule.mapQ_apply]
  have hf'inj : Function.Injective f' := by
    change Function.Injective fbar
    intro x y hxy
    obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    simp only [fbar, Submodule.mapQ_apply] at hxy
    rw [Submodule.Quotient.eq, hB, Submodule.mem_bot, ← map_sub] at hxy
    rw [Submodule.Quotient.eq, hA, Submodule.mem_bot, sub_eq_zero]
    exact sub_eq_zero.mp (hf (hxy.trans (map_zero f).symm))
  have hlt : Function.Injective ((f'.rTensor NB)) :=
    Module.Flat.rTensor_preserves_injective_linearMap (M := NB) f' hf'inj
  have hsquare : (ΨB.toLinearMap) ∘ₗ (f.lTensor N) =
      ((f'.rTensor NB).restrictScalars S) ∘ₗ (ΨA.toLinearMap) := by
    apply TensorProduct.ext'
    intro n a
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.lTensor_tmul,
      LinearEquiv.coe_coe, LinearMap.restrictScalars_apply, ΨA, ΨB, ΦA, ΦB,
      LinearEquiv.trans_apply, TensorProduct.comm_tmul, TensorProduct.congr_tmul,
      LinearEquiv.refl_apply, LinearEquiv.restrictScalars_apply,
      LinearEquiv.restrictScalars_symm_apply,
      TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul,
      LinearMap.rTensor_tmul]
    rw [show ((J • (⊤ : Submodule S A)).quotEquivOfEqBot hA).symm a
          = Submodule.Quotient.mk a from rfl,
        show ((J • (⊤ : Submodule S B)).quotEquivOfEqBot hB).symm (f a)
          = Submodule.Quotient.mk (f a) from rfl,
        hf'mk a]
  have hcomp : Function.Injective ((ΨB.toLinearMap) ∘ₗ (f.lTensor N)) := by
    rw [hsquare, LinearMap.coe_comp]
    exact hlt.comp ΨA.injective
  intro x y hxy
  apply hcomp
  simp only [LinearMap.coe_comp, Function.comp_apply, hxy]

/-- **The `J`-killed change-of-rings lemma.** If `A, B` are `S`-modules
annihilated by `J` (hence `R = S ⧸ J`-modules) and `f : A →ₗ[S] B` is injective,
then `f.lTensor N` is injective.

For `J`-killed `X`, `X ⊗[S] N ≅ (X ⧸ J•⊤) ⊗[S⧸J] (N ⧸ J•⊤)`
naturally; under it `f.lTensor N` becomes `f'.rTensor (N⧸J•⊤)` for the induced
`S⧸J`-linear `f'`, injective because `N⧸J•⊤` is `S⧸J`-flat (`hquot`) via
`Module.Flat.rTensor_preserves_injective_linearMap`. Uses only `hquot`. -/
lemma factB_Jkilled
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    {A B : Type w} [AddCommGroup A] [Module S A] [AddCommGroup B] [Module S B]
    (hA : J • (⊤ : Submodule S A) = ⊥) (hB : J • (⊤ : Submodule S B) = ⊥)
    (f : A →ₗ[S] B) (hf : Function.Injective f) :
    Function.Injective (f.lTensor N) :=
  factB_Jkilled_aux J hquot hA hB f hf

/-- **The `J`-killed change-of-rings lemma, universe-independent variant.** Identical to
`factB_Jkilled` but with `A` and `B` in possibly-different universes (`Type*` rather than a
shared `Type w`). Same proof
(change-of-rings via `quotTensorEquivQuotSMul` + `cancelBaseChange`, using `hquot`). -/
@[sga "3 VIB 11.7" "affine case"]
lemma factB_Jkilled'
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    {A : Type*} [AddCommGroup A] [Module S A] {B : Type*} [AddCommGroup B] [Module S B]
    (hA : J • (⊤ : Submodule S A) = ⊥) (hB : J • (⊤ : Submodule S B) = ⊥)
    (f : A →ₗ[S] B) (hf : Function.Injective f) :
    Function.Injective (f.lTensor N) :=
  factB_Jkilled_aux J hquot hA hB f hf

/-- If `f : A → B` is injective and `J` kills the range of `f`, then `J` kills `A`. -/
private lemma smul_top_eq_bot_of_injective {S : Type*} [CommRing S] {J : Ideal S}
    {A B : Type*} [AddCommGroup A] [Module S A] [AddCommGroup B] [Module S B]
    (f : A →ₗ[S] B) (hf : Function.Injective f) (h : J • LinearMap.range f = ⊥) :
    J • (⊤ : Submodule S A) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  have hfx : f x ∈ (J • (⊤ : Submodule S A)).map f := Submodule.mem_map_of_mem hx
  rw [Submodule.map_smul'', Submodule.map_top, h, Submodule.mem_bot] at hfx
  exact hf (by simpa using hfx)

/-- A finitely supported function with all coefficients in `J` lies in `J • ⊤`. -/
private lemma finsupp_mem_smul_top {S : Type*} [CommRing S] {J : Ideal S} {Q : Type*}
    (f : Q →₀ S) (hf : ∀ q, f q ∈ J) : f ∈ J • (⊤ : Submodule S (Q →₀ S)) := by
  classical
  rw [← Finsupp.sum_single f]
  refine Submodule.sum_mem _ fun q _ => ?_
  rw [← mul_one (f q), ← smul_eq_mul, ← Finsupp.smul_single]
  exact Submodule.smul_mem_smul (hf q) Submodule.mem_top

/-- **Tor-vanishing for `J`-killed modules.** For every `S`-module `P`
annihilated by `J` (an `R = S ⧸ J`-module) and every submodule `K ≤ P` (also
`J`-killed), the inclusion-tensor `(K.subtype).lTensor N : K ⊗[S] N → P ⊗[S] N` is
injective. Equivalently `Tor₁^S(P/K, N) = 0` for `J`-killed `P` (and since every
`R`-module is such a `P/K`, this is `Tor₁^S(Q, N) = 0` for all `R`-modules `Q`).

**Informal proof.** Take a free
`R`-presentation `0 → K' → F → Q → 0` with `Q = P/K`, `F = R^{(ι)}` free over
`R = S⧸J`. The Tor LES of `S`-modules reads
`Tor₁^S(F,N) → Tor₁^S(Q,N) → K'⊗_S N →[b] F⊗_S N`, with `b = (K'↪F).lTensor N`.
* `Tor₁^S(R,N) = 0` from `htor`: the LES of `0→J→S→R→0` gives
  `0 = Tor₁^S(S,N) → Tor₁^S(R,N) →[∂] J⊗N →[μ_N] N`, `∂` injective and `μ_N`
  (= `htor`) injective ⟹ `Tor₁^S(R,N)=0`.
* `Tor₁^S(F,N) = 0` since Tor commutes with `⊕` (`F` free over `R`).
* So `∂'` is injective and it suffices that `b` is injective; but `K' ↪ F` is an
  injective `S`-map between `J`-killed `R`-modules, so `b` is injective by `factB_Jkilled`.
Hence `Tor₁^S(Q,N)=0`, i.e. `(K.subtype).lTensor N` injective.

This is the homological core. It uses `htor` for the base case together with
`factB_Jkilled`, hence `hquot`, and there is no circularity: `factB_Jkilled` is applied
only to injections of `J`-killed modules. -/
@[sga "3 VIB 11.7" "affine case"]
lemma step2_Jkilled_lTensor_subtype
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    {P : Type w} [AddCommGroup P] [Module S P]
    (hP : J • (⊤ : Submodule S P) = ⊥) (K : Submodule S P) :
    Function.Injective ((K.subtype).lTensor N) := by
  -- The conclusion `(K.subtype).lTensor N` injective is
  -- `factB_Jkilled` applied to the inclusion `K ↪ P` of J-killed S-modules:
  -- `P` is J-killed (hP) and so is its submodule `K`, and `K.subtype` is injective.
  -- The full free-R-presentation / Tor-LES argument proves the stronger
  -- `Tor₁^S(P/K,N)=0`; this exact lTensor-of-inclusion
  -- statement is the special case that is precisely `factB_Jkilled`.
  have hK : J • (⊤ : Submodule S K) = ⊥ :=
    smul_top_eq_bot_of_injective K.subtype K.subtype_injective
      (by rw [eq_bot_iff, ← hP]; exact Submodule.smul_mono le_rfl le_top)
  exact factB_Jkilled J hquot hK hP K.subtype K.subtype_injective

/-- `Function.Exact 0 i` is equivalent to injectivity of `i`. (One direction;
the standard `LinearMap.exact_zero_iff_injective` is stated with `AddCommGroup`
hypotheses that do not match the `AddCommMonoid` instances that typeclass resolution
picks for tensor products, so we provide this defeq-robust version by hand.) -/
theorem lemmaC_aux_inj_of_exact_zero
    {R : Type*} [CommRing R] {X Y : Type*} [AddCommGroup X] [Module R X]
    [AddCommGroup Y] [Module R Y] (i : X →ₗ[R] Y)
    (h : Function.Exact (0 : PUnit →ₗ[R] X) i) : Function.Injective i := by
  intro a b hab
  obtain ⟨y, hy⟩ := (h (a - b)).mp (by rw [map_sub, hab, sub_self])
  exact sub_eq_zero.mp (by simpa using hy.symm)

-- this proof's elaboration needs more than the default heartbeat budget
/-- **The snake-lemma reduction (`Tor₁`-vanishing ⟹ left-exactness).**
This is the linear-map–level statement that, for a short exact sequence
`0 → M →[g] N →[f] P → 0`, vanishing of `Tor₁^R(A, P)` — expressed concretely as
injectivity of `(ker π) ⊗ P → (A →₀ R) ⊗ P` for the canonical free presentation
`π : (A →₀ R) ↠ A` — implies that `g.lTensor A` is injective.

It is exactly Mathlib's `LinearMap.lTensor_injective_of_exact_of_flat` with the
hypothesis `[Module.Flat R P]` *weakened* to the single consequence of flatness that
its snake-lemma proof actually uses (namely `Function.Injective (rTensor P (ker π).subtype)`).
The proof is the `SnakeLemma.exact_δ'_left` chase of that Mathlib lemma, applied to the
free presentation `π : (A →₀ R) ↠ A` (kernel `K`), with the flatness step replaced by the
given `hTor`. -/
@[sga "3 VIB 12.7" "Vanishing of Tor₁^A(M"]
theorem lemmaC_reduction_tor {R : Type*} [CommRing R]
    {M : Type*} [AddCommGroup M] [Module R M]
    {N : Type*} {P : Type*} [AddCommGroup N] [AddCommGroup P] [Module R N] [Module R P]
    (f : N →ₗ[R] P) (hf : Function.Surjective f)
    (g : M →ₗ[R] N) (hg : Function.Injective g) (H : Function.Exact g f)
    (A : Type*) [AddCommGroup A] [Module R A]
    (hTor : Function.Injective
      (LinearMap.rTensor P (LinearMap.ker (Finsupp.linearCombination R (id : A → A))).subtype)) :
    Function.Injective (LinearMap.lTensor A g) := by
  classical
  set Q := A →₀ R with hQ
  set π : Q →ₗ[R] A := Finsupp.linearCombination R (id : A → A) with hπdef
  set K : Submodule R Q := LinearMap.ker π with hKdef
  have hπ : Function.Surjective π := Finsupp.linearCombination_id_surjective R A
  have hTor' : Function.Injective (LinearMap.rTensor P K.subtype) := hTor
  have hf12 : Function.Exact (LinearMap.lTensor (↥K) g) (LinearMap.lTensor (↥K) f) :=
    lTensor_exact (↥K) H hf
  have hg12 : Function.Exact (LinearMap.lTensor Q g) (LinearMap.lTensor Q f) :=
    lTensor_exact Q H hf
  have hsq1 : LinearMap.lTensor Q g ∘ₗ LinearMap.rTensor M K.subtype
      = LinearMap.rTensor N K.subtype ∘ₗ LinearMap.lTensor (↥K) g := by
    rw [LinearMap.lTensor_comp_rTensor, LinearMap.rTensor_comp_lTensor]
  have hsq2 : LinearMap.lTensor Q f ∘ₗ LinearMap.rTensor N K.subtype
      = LinearMap.rTensor P K.subtype ∘ₗ LinearMap.lTensor (↥K) f := by
    rw [LinearMap.lTensor_comp_rTensor, LinearMap.rTensor_comp_lTensor]
  have hsqG : LinearMap.lTensor A g ∘ₗ LinearMap.rTensor M π
      = LinearMap.rTensor N π ∘ₗ LinearMap.lTensor Q g := by
    rw [LinearMap.lTensor_comp_rTensor, LinearMap.rTensor_comp_lTensor]
  have hPinj : Function.Exact (0 : PUnit →ₗ[R] (↥K) ⊗[R] P) (LinearMap.rTensor P K.subtype) := by
    intro x
    refine ⟨fun hx => ⟨0, ?_⟩, ?_⟩
    · have hx0 : x = 0 := hTor' (by rwa [map_zero])
      simp [hx0]
    · rintro ⟨y, rfl⟩; simp
  have hp1e : Function.Exact (LinearMap.rTensor M K.subtype) (LinearMap.rTensor M π) :=
    rTensor_exact M (LinearMap.exact_subtype_ker_map π) hπ
  have hp2e : Function.Exact (LinearMap.rTensor N K.subtype) (LinearMap.rTensor N π) :=
    rTensor_exact N (LinearMap.exact_subtype_ker_map π) hπ
  have hf2s : Function.Surjective (LinearMap.lTensor (↥K) f) := LinearMap.lTensor_surjective (↥K) hf
  have hg1i : Function.Injective (LinearMap.lTensor Q g) :=
    Module.Flat.lTensor_preserves_injective_linearMap g hg
  have hp1s : Function.Surjective (LinearMap.rTensor M π) := LinearMap.rTensor_surjective M hπ
  apply lemmaC_aux_inj_of_exact_zero (LinearMap.lTensor A g)
  have key := SnakeLemma.exact_δ'_left
      (M₁ := (↥K) ⊗[R] M) (M₂ := (↥K) ⊗[R] N) (M₃ := (↥K) ⊗[R] P)
      (N₁ := Q ⊗[R] M) (N₂ := Q ⊗[R] N) (N₃ := Q ⊗[R] P)
      (LinearMap.rTensor M K.subtype) (LinearMap.rTensor N K.subtype)
      (LinearMap.rTensor P K.subtype)
      (LinearMap.lTensor (↥K) g) (LinearMap.lTensor (↥K) f) hf12
      (LinearMap.lTensor Q g) (LinearMap.lTensor Q f) hg12 hsq1 hsq2
      (0 : PUnit →ₗ[R] (↥K) ⊗[R] P) hPinj
      (LinearMap.rTensor M π) hp1e (LinearMap.rTensor N π) hp2e hf2s hg1i
      (LinearMap.lTensor A g) hsqG hp1s
  convert key using 2
  exact Subsingleton.elim _ _

-- this proof's elaboration needs more than the default heartbeat budget
/-- **Free base case: `(J•⊤_{Q→₀S}) ⊗ N ↪ (Q→₀S) ⊗ N`.**
For the canonical free `S`-module `P = Q →₀ S`, the inclusion-tensor
`(J • ⊤_P).subtype.rTensor N : (J•⊤_P) ⊗ N → P ⊗ N` is injective. This is the only
new homological input of the first-slot Tor-vanishing:
`P = ⊕_q S`, `J•⊤_P = ⊕_q J`, and the inclusion is
`⊕_q (J ↪ S)`; tensoring by `N` (which commutes with `⊕`), it becomes `⊕_q (μ_J)`,
injective because each `J⊗N → N` (= `htor`'s map `TensorProduct.lift ((lsmul S N)∘J.subtype)`)
is injective by `htor`. It uses only `htor` and the commutation of `-⊗N` with direct sums. -/
theorem tor_smul_top_free_rTensor_inj
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (htor : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul S N).comp J.subtype)))
    {Q : Type w} [AddCommGroup Q] [Module S Q] :
    Function.Injective
      (LinearMap.rTensor N (J • (⊤ : Submodule S (Q →₀ S))).subtype) := by
  classical
  -- `μ := lid ∘ (J ↪ S)⊗N` is injective (it equals `htor`'s map).
  have hJsub : Function.Injective (LinearMap.rTensor N J.subtype) := by
    have heq : (TensorProduct.lid S N).toLinearMap.comp (LinearMap.rTensor N J.subtype)
        = TensorProduct.lift ((LinearMap.lsmul S N).comp J.subtype) :=
      TensorProduct.ext' fun j n => by simp
    intro x y hxy
    apply (show Function.Injective
        ((TensorProduct.lid S N).toLinearMap.comp (LinearMap.rTensor N J.subtype)) by
      rwa [heq])
    simp only [LinearMap.coe_comp, Function.comp_apply, hxy]
  -- The pointwise inclusion `up := ⊕_q (J ↪ S) : (Q →₀ J) → (Q →₀ S)`.
  set up : (Q →₀ J) →ₗ[S] (Q →₀ S) := Finsupp.mapRange.linearMap (J.subtype) with hup
  -- Its range is exactly `J • ⊤_{Q→₀S}`.
  have hrange : LinearMap.range up = J • (⊤ : Submodule S (Q →₀ S)) := by
    apply le_antisymm
    · rintro _ ⟨f, rfl⟩
      refine finsupp_mem_smul_top _ fun q => ?_
      simp only [hup, Finsupp.mapRange.linearMap_apply, Finsupp.mapRange_apply]
      exact (f q).property
    · rw [Submodule.smul_le]
      intro s hs x _
      refine ⟨Finsupp.mapRange (fun t => ⟨s * t, J.mul_mem_right _ hs⟩) (by ext; simp) x, ?_⟩
      ext q
      simp [hup, Finsupp.mapRange.linearMap_apply, Finsupp.mapRange_apply]
  have hupinj : Function.Injective up :=
    Finsupp.mapRange_injective _ (by simp) (Submodule.subtype_injective J)
  -- Corestriction iso `φ : (Q →₀ J) ≃ J • ⊤`, so `(J•⊤).subtype = up ∘ φ⁻¹`.
  let φ : (Q →₀ J) ≃ₗ[S] ↥(J • (⊤ : Submodule S (Q →₀ S))) :=
    (LinearEquiv.ofInjective up hupinj).trans (LinearEquiv.ofEq _ _ hrange)
  have hfactor : (J • (⊤ : Submodule S (Q →₀ S))).subtype.comp (φ : (Q →₀ J) →ₗ[S] _) = up :=
    rfl
  have hsubeq : (J • (⊤ : Submodule S (Q →₀ S))).subtype
      = up.comp (φ.symm : ↥(J • (⊤ : Submodule S (Q →₀ S))) →ₗ[S] (Q →₀ J)) := by
    rw [← hfactor]
    ext x
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
      LinearEquiv.apply_symm_apply]
  -- Reduce to injectivity of `rTensor N up`.
  suffices h : Function.Injective (LinearMap.rTensor N up) by
    rw [hsubeq, LinearMap.rTensor_comp]
    exact h.comp (LinearEquiv.rTensor N φ.symm).injective
  -- `μ : J ⊗ N → N`, injective.
  set μ : (J ⊗[S] N) →ₗ[S] N :=
    (TensorProduct.lid S N).toLinearMap.comp (LinearMap.rTensor N J.subtype) with hμ
  have hμinj : Function.Injective μ := (TensorProduct.lid S N).injective.comp hJsub
  -- Direct-sum commutation isos for `-⊗N`.
  set e1 := TensorProduct.finsuppLeft S S J N Q with he1
  set e2 := TensorProduct.finsuppScalarLeft S N Q with he2
  -- The commuting square: `e2 ∘ (up ⊗ N) = (⊕_q μ) ∘ e1`.
  have hsquare : e2.toLinearMap.comp (LinearMap.rTensor N up)
      = (Finsupp.mapRange.linearMap μ).comp e1.toLinearMap := by
    apply TensorProduct.ext'
    intro f n
    ext q
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
      LinearMap.rTensor_tmul, hup, Finsupp.mapRange.linearMap_apply]
    rw [Finsupp.mapRange_apply, he2, TensorProduct.finsuppScalarLeft_apply_tmul_apply,
      Finsupp.mapRange_apply, he1, TensorProduct.finsuppLeft_apply_tmul_apply, hμ]
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.rTensor_tmul,
      LinearEquiv.coe_coe, TensorProduct.lid_tmul, Submodule.coe_subtype]
  -- `⊕_q μ` injective (μ injective), `e1` an iso ⟹ RHS injective ⟹ `up ⊗ N` injective.
  have hRHSinj : Function.Injective ((Finsupp.mapRange.linearMap μ).comp e1.toLinearMap) :=
    (Finsupp.mapRange_injective _ (by simp) hμinj).comp e1.injective
  rw [← hsquare] at hRHSinj
  exact (LinearMap.coe_comp e2.toLinearMap (LinearMap.rTensor N up) ▸ hRHSinj).of_comp

/-- **Diagram-chase core for the resolution-comparison ladder.** Abstract version of the
element chase used in `tor_first_slot_ladder`: given the commuting/exactness data of the
comparison ladder tensored by `N`, with the two relevant `rTensor` maps injective, the
syzygy-inclusion `ιK` stays injective after `rTensor N`. -/
theorem ladder_chase
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    {KM PM FM K'M DM : Type*}
    [AddCommGroup KM] [Module S KM] [AddCommGroup PM] [Module S PM]
    [AddCommGroup FM] [Module S FM] [AddCommGroup K'M] [Module S K'M]
    [AddCommGroup DM] [Module S DM]
    (ιK : KM →ₗ[S] PM) (φ : PM →ₗ[S] FM) (ψ : KM →ₗ[S] FM)
    (ιK' : K'M →ₗ[S] FM) (φK : KM →ₗ[S] K'M) (jD : DM →ₗ[S] KM) (lJ : DM →ₗ[S] PM)
    (hψ1 : ψ = φ.comp ιK) (hψ2 : ψ = ιK'.comp φK)
    (hιK'rT : Function.Injective (LinearMap.rTensor N ιK'))
    (hexact : Function.Exact jD φK) (hφKsurj : Function.Surjective φK)
    (hlJ : lJ = ιK.comp jD)
    (hlJrT : Function.Injective (LinearMap.rTensor N lJ)) :
    Function.Injective (LinearMap.rTensor N ιK) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  have hψx : LinearMap.rTensor N ψ x = 0 := by
    rw [hψ1, LinearMap.rTensor_comp, LinearMap.comp_apply, hx, map_zero]
  have hφKx : LinearMap.rTensor N φK x = 0 := by
    rw [hψ2, LinearMap.rTensor_comp, LinearMap.comp_apply] at hψx
    exact hιK'rT (by rw [hψx, map_zero])
  obtain ⟨z, hz⟩ := (rTensor_exact N hexact hφKsurj x).mp hφKx
  have hlJz : LinearMap.rTensor N lJ z = 0 := by
    rw [hlJ, LinearMap.rTensor_comp, LinearMap.comp_apply, hz, hx]
  have hz0 : z = 0 := hlJrT (by rw [hlJz, map_zero])
  rw [← hz, hz0, map_zero]

/-- **Resolution-comparison ladder chase.** Given the free-base injectivity
`hbase` (`tor_smul_top_free_rTensor_inj`), the first-slot
Tor-vanishing `Tor₁^S(Q,N)=0` for the `J`-killed `Q`
follows by comparing the canonical free `S`-presentation `0→K→(Q→₀S)→Q→0` with the free
`R = S⧸J`-presentation `0→K'→F→Q→0` (`F = Q →₀ R`, `J`-killed).
The coefficient-reduction `φ : (Q→₀S) → F` covers `id_Q`, restricts to `φ|_K : K → K'`,
and (using `J•Q = ⊥`) has `ker φ = J•⊤_{Q→₀S} ⊆ K`, giving the SES `0→J•⊤_P→K→K'→0`. The chase:
for `x` with `(ι_K ⊗ N) x = 0`, the left square + `(ι_{K'}⊗N)` injective (by `factB_Jkilled`,
`K',F` `J`-killed) give `(φ|_K ⊗ N) x = 0`; right-exactness lifts `x = (j ⊗ N) z`; then
`(ι_K∘j) ⊗ N = (J•⊤_P ↪ P) ⊗ N`, injective by `hbase`, forces `z = 0`, hence `x = 0`.
It uses `htor` only through `hbase`, and `factB_Jkilled` only on `J`-killed injections. -/
@[sga "3 VIB 12.7" "partial"]
theorem tor_first_slot_ladder
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    {Q : Type w} [AddCommGroup Q] [Module S Q] (hQ : J • (⊤ : Submodule S Q) = ⊥)
    (hbase : Function.Injective
      (LinearMap.rTensor N (J • (⊤ : Submodule S (Q →₀ S))).subtype)) :
    Function.Injective
      (LinearMap.rTensor N
        (LinearMap.ker (Finsupp.linearCombination S (id : Q → Q))).subtype) := by
  classical
  set P := Q →₀ S with hP
  set πQ : P →ₗ[S] Q := Finsupp.linearCombination S (id : Q → Q) with hπQ
  set K : Submodule S P := LinearMap.ker πQ with hKdef
  set JP : Submodule S P := J • (⊤ : Submodule S P) with hJPdef
  -- `F = Q →₀ (S ⧸ J)`, the free `R`-module, viewed as a `J`-killed `S`-module.
  set F := Q →₀ (S ⧸ J) with hF
  set φ : P →ₗ[S] F := Finsupp.mapRange.linearMap (Submodule.mkQ J) with hφ
  -- `ker φ = J • ⊤_P`.
  have hkerφ : LinearMap.ker φ = JP := by
    rw [hφ, Finsupp.ker_mapRange]
    have h1 : (Finsupp.submodule fun _ : Q => LinearMap.ker (Submodule.mkQ J))
        = Finsupp.submodule (fun _ : Q => J) := by
      congr 1
      ext q
      simp [Submodule.ker_mkQ]
    rw [h1, hJPdef]
    apply le_antisymm
    · intro f hf
      rw [Finsupp.mem_submodule_iff] at hf
      exact finsupp_mem_smul_top f hf
    · rw [Submodule.smul_le]
      intro s hs x _
      rw [Finsupp.mem_submodule_iff]
      intro q
      rw [Finsupp.smul_apply, smul_eq_mul]
      exact J.mul_mem_right _ hs
  -- `F` is `J`-killed.
  have hFkilled : J • (⊤ : Submodule S F) = ⊥ := by
    rw [eq_bot_iff, Submodule.smul_le]
    intro s hs x _
    rw [Submodule.mem_bot]
    ext q
    rw [Finsupp.smul_apply, Finsupp.coe_zero, Pi.zero_apply, Algebra.smul_def,
      Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hs, zero_mul]
  -- `J • ⊤_P ⊆ K` (because `πQ (J•⊤_P) = J • Q = ⊥`).
  have hsub : JP ≤ K := by
    rw [hJPdef, hKdef, Submodule.smul_le]
    intro s hs x _
    rw [LinearMap.mem_ker, ← Submodule.mem_bot S, ← hQ, map_smul]
    exact Submodule.smul_mem_smul hs Submodule.mem_top
  set ιK : K →ₗ[S] P := K.subtype with hιK
  set ψ : K →ₗ[S] F := φ.comp ιK with hψ
  set K' : Submodule S F := LinearMap.range ψ with hK'
  set φK : K →ₗ[S] K' := ψ.rangeRestrict with hφK
  set D : Submodule S K := Submodule.comap K.subtype JP with hD
  have hkerφK : LinearMap.ker φK = D := by
    rw [hφK, LinearMap.ker_rangeRestrict, hψ, hD, LinearMap.ker_comp, hkerφ]
  have hexactSES : Function.Exact (D.subtype) φK := by
    rw [LinearMap.exact_iff, hkerφK, Submodule.range_subtype]
  let e : D ≃ₗ[S] JP := Submodule.comapSubtypeEquivOfLe hsub
  have hcompose : JP.subtype.comp (e : D →ₗ[S] JP) = ιK.comp D.subtype := by
    refine LinearMap.ext fun d => ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.subtype_apply, hιK]
    exact Submodule.comapSubtypeEquivOfLe_apply_coe hsub d
  -- `(K' ↪ F) ⊗ N` injective by `step2_Jkilled_lTensor_subtype` (`K', F` are `J`-killed).
  have hιK'rT : Function.Injective (LinearMap.rTensor N K'.subtype) := by
    rw [← LinearMap.lTensor_inj_iff_rTensor_inj]
    exact step2_Jkilled_lTensor_subtype (P := F) J hquot hFkilled K'
  -- `(J•⊤_P ↪ P) ⊗ N` injective (= `ιK ∘ D.subtype` tensored) by `hbase`.
  have hlJrT : Function.Injective (LinearMap.rTensor N (ιK.comp D.subtype)) := by
    rw [← hcompose, LinearMap.rTensor_comp]
    exact hbase.comp (LinearEquiv.rTensor N e).injective
  -- Assemble the chase.
  exact ladder_chase (KM := K) (PM := P) (FM := F) (K'M := K') (DM := D)
    ιK φ ψ K'.subtype φK D.subtype (ιK.comp D.subtype)
    hψ rfl hιK'rT hexactSES ψ.surjective_rangeRestrict rfl hlJrT

/-- If `N ⧸ JN` is flat over `S ⧸ J` and `J ⊗ N → N` is injective, then for every
`S`-module `Q` annihilated by `J` the induced map in the first slot is injective. -/
@[sga "1 IV 5.2" "(ii) ⇒ (i), special case",
  sga "1 IV 5.3" "special case",
  sga "3 VIB 12.7" "partial"]
theorem tor_vanishing_Jkilled_first_slot
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    (htor : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul S N).comp J.subtype)))
    {Q : Type w} [AddCommGroup Q] [Module S Q] (hQ : J • (⊤ : Submodule S Q) = ⊥) :
    Function.Injective
      (LinearMap.rTensor N
        (LinearMap.ker (Finsupp.linearCombination S (id : Q → Q))).subtype) := by
  -- The comparison-ladder chase `tor_first_slot_ladder` reduces the goal to the free-base
  -- injectivity `tor_smul_top_free_rTensor_inj` (which is just `htor` + direct sums).
  exact tor_first_slot_ladder J hquot hQ (tor_smul_top_free_rTensor_inj J htor)

/-- If `J • ⊤ ≤ N`, then `J` kills the quotient `M ⧸ N`. -/
theorem smul_top_quotient_eq_bot_of_le {S M : Type*} [CommRing S] [AddCommGroup M] [Module S M]
    {J : Ideal S} {N : Submodule S M} (h : J • (⊤ : Submodule S M) ≤ N) :
    J • (⊤ : Submodule S (M ⧸ N)) = ⊥ := by
  rw [eq_bot_iff, ← N.range_mkQ, ← Submodule.map_top, ← Submodule.map_smul'', ← N.mkQ_map_self]
  exact Submodule.map_mono h

/-- **`Tor₁`-vanishing for the second slot against a `J`-killed module.**
For the canonical free `S`-presentation `π : (N →₀ S) ↠ N` with kernel `Kπ`, and for the
`J`-killed module `Q = P ⧸ (J•⊤_P)`, the map `Kπ ⊗ Q → (N →₀ S) ⊗ Q` is injective, i.e.
`Tor₁^S(N, Q) = 0`.

By `lTensor_inj_iff_rTensor_inj`
the goal is equivalent to `Injective (lTensor Q (ker π_N).subtype)`. Applying the
snake-lemma reduction `lemmaC_reduction_tor` to the canonical free `S`-presentation SES
`0 → ker π_N →[subtype] (N →₀ S) →[π_N] N → 0` with test module `A := Q` reduces the goal
to the FIRST-slot vanishing `Tor₁^S(Q, N) = 0` (= `tor_vanishing_Jkilled_first_slot`),
since `Q = P ⧸ J•⊤_P` is `J`-killed (`J • ⊤_Q = ⊥` because `J • J•⊤_P = J²•⊤_P = ⊥` by
`hJ`). -/
@[sga "1 IV 5.2" "(ii) ⇒ (i), special case", sga "1 IV 5.3" "special case"]
theorem lemmaC_tor_vanishing_Jkilled
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    (htor : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul S N).comp J.subtype)))
    {P : Type w} [AddCommGroup P] [Module S P] :
    Function.Injective
      (LinearMap.rTensor (P ⧸ J • (⊤ : Submodule S P))
        (LinearMap.ker (Finsupp.linearCombination S (id : N → N))).subtype) := by
  -- `Q = P ⧸ J•⊤_P` is J-killed: `J • ⊤_Q = ⊥` since `J • (J • ⊤_P) = J²•⊤_P = ⊥`.
  set Q := P ⧸ J • (⊤ : Submodule S P) with hQdef
  have hQ : J • (⊤ : Submodule S Q) = ⊥ := smul_top_quotient_eq_bot_of_le le_rfl
  -- Convert rTensor-injectivity to lTensor-injectivity, then apply the snake reduction.
  set πN : (N →₀ S) →ₗ[S] N := Finsupp.linearCombination S (id : N → N) with hπN
  set KN : Submodule S (N →₀ S) := LinearMap.ker πN with hKN
  rw [← LinearMap.lTensor_inj_iff_rTensor_inj Q KN.subtype]
  have hsurjN : Function.Surjective πN := Finsupp.linearCombination_id_surjective S N
  have HexactN : Function.Exact KN.subtype πN := LinearMap.exact_subtype_ker_map πN
  refine lemmaC_reduction_tor πN hsurjN KN.subtype KN.subtype_injective HexactN Q ?_
  exact tor_vanishing_Jkilled_first_slot J hquot htor hQ

/-- Under the same hypotheses, tensoring the inclusion `J • ⊤ ↪ P` with `N` stays
injective, for an arbitrary `S`-module `P`. -/
lemma lemmaC_smul_top_subtype_lTensor_injective
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    (htor : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul S N).comp J.subtype)))
    {P : Type w} [AddCommGroup P] [Module S P] :
    Function.Injective
      ((J • (⊤ : Submodule S P)).subtype.lTensor N) := by
  -- This is the `Tor₁` connecting-map core.
  -- We use the fundamental short exact sequence `0 → J•⊤_P → P → P/J•⊤_P → 0` and the
  -- snake-lemma reduction `lemmaC_reduction_tor`, whose `Tor₁`-input is exactly the
  -- `J`-killed `Tor`-vanishing fact `lemmaC_tor_vanishing_Jkilled`.
  set JP := J • (⊤ : Submodule S P) with hJP
  have Hexact : Function.Exact JP.subtype JP.mkQ := LinearMap.exact_subtype_mkQ JP
  have hmkQ : Function.Surjective JP.mkQ := JP.mkQ_surjective
  exact lemmaC_reduction_tor JP.mkQ hmkQ JP.subtype JP.subtype_injective Hexact N
    (lemmaC_tor_vanishing_Jkilled J hquot htor)

/-- **Assembly by a diagram chase.** For arbitrary
`S`-module `P` and submodule `K ≤ P`, `(K.subtype).lTensor N` is injective.

**Proof.** Write
`JP = J•⊤_P`, `P' = P ⧸ JP` (J-killed, since `J•JP = J²•⊤_P = ⊥` by `hJ`),
`D = {k ∈ K : k ∈ JP}` (a submodule of `K`, and `D ≤ JP`), `K'' = K ⧸ D`. The map
`ī' : K'' → P'` descending `qP ∘ K.subtype` is INJECTIVE (kernel `= D/D = 0`).
Two right-exact tensored rows (functorial `lTensor`):
* top from `0 → D →[p] K →[qK] K'' → 0`: `D⊗N →[pₙ] K⊗N →[qKₙ] K''⊗N → 0`;
* bottom from `0 → JP →[c₀] P →[qP] P' → 0`: `JP⊗N →[c₀ₙ] P⊗N →[qPₙ] P'⊗N → 0`,
  with `c₀ₙ` INJECTIVE by `lemmaC_smul_top_subtype_lTensor_injective`.
Commuting squares: `c₀ₙ ∘ vₙ = (K.subtype.lTensor N) ∘ pₙ` and
`qPₙ ∘ (K.subtype.lTensor N) = ī'ₙ ∘ qKₙ`, where `v : D → JP` is the inclusion.
Injective verticals: `vₙ` by `step2_Jkilled_lTensor_subtype` (`D ≤ JP`,
`JP` J-killed); `ī'ₙ` factors as `(range ī').subtype ∘ ε` with `ε` an iso and
`(range ī').subtype` injective by `step2_Jkilled_lTensor_subtype` (`range ī' ≤ P'`, `P'`
J-killed).
Chase: `(K.subtype.lTensor N) x = 0` ⟹ (R-square) `ī'ₙ(qKₙ x)=0` ⟹ `qKₙ x = 0`
⟹ (top exact) `x = pₙ u` ⟹ (L-square) `c₀ₙ(vₙ u) = 0` ⟹ (c₀ₙ inj) `vₙ u = 0`
⟹ (vₙ inj) `u = 0` ⟹ `x = 0`. -/
@[sga "3 VIB 11.7" "special case"]
lemma step3_assembly_lTensor_subtype
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    (J : Ideal S) (hJ : J ^ 2 = ⊥)
    (hquot : Module.Flat (S ⧸ J) (N ⧸ J • (⊤ : Submodule S N)))
    (htor : Function.Injective
      (TensorProduct.lift ((LinearMap.lsmul S N).comp J.subtype)))
    {P : Type w} [AddCommGroup P] [Module S P] (K : Submodule S P) :
    Function.Injective ((K.subtype).lTensor N) := by
  classical
  -- `JP := J • ⊤_P`, the bottom-left submodule.
  set JP : Submodule S P := J • (⊤ : Submodule S P) with hJPdef
  -- `JP` is J-killed: `J • JP = J² • ⊤_P = ⊥`.
  have hJJbot : J • JP = (⊥ : Submodule S P) := by
    rw [hJPdef, ← Submodule.mul_smul, ← pow_two, hJ, Submodule.bot_smul]
  have hJP : J • (⊤ : Submodule S JP) = ⊥ :=
    smul_top_eq_bot_of_injective JP.subtype JP.subtype_injective
      (by rw [Submodule.range_subtype]; exact hJJbot)
  -- `P' := P ⧸ JP`, the bottom-right quotient; `qP : P → P'`.
  set qP : P →ₗ[S] (P ⧸ JP) := JP.mkQ with hqP
  have hP' : J • (⊤ : Submodule S (P ⧸ JP)) = ⊥ := smul_top_quotient_eq_bot_of_le le_rfl
  -- `Dsub := comap K.subtype JP`, the preimage of `JP` in `K` ("D inside K").
  set Dsub : Submodule S K := Submodule.comap K.subtype JP with hDsub
  -- `Dsub` is J-killed: it embeds into the J-killed `JP` via `v`.
  -- `v : Dsub → JP` is `K.subtype ∘ Dsub.subtype` corestricted to `JP`.
  have hv_mem : ∀ d : Dsub, K.subtype (Dsub.subtype d) ∈ JP := by
    intro d
    exact (Submodule.mem_comap.mp d.property : K.subtype (d : K) ∈ JP)
  set v : Dsub →ₗ[S] JP :=
    LinearMap.codRestrict JP (K.subtype.comp Dsub.subtype) hv_mem with hvdef
  have hv_inj : Function.Injective v := by
    intro a b hab
    have hval : K.subtype (Dsub.subtype a) = K.subtype (Dsub.subtype b) := by
      have := congrArg Subtype.val hab
      simpa [hvdef, LinearMap.codRestrict] using this
    have : Dsub.subtype a = Dsub.subtype b := K.subtype_injective hval
    exact Dsub.subtype_injective this
  -- `c₀ ∘ v = K.subtype ∘ Dsub.subtype`.
  have hcv : JP.subtype.comp v = K.subtype.comp Dsub.subtype := by
    ext d; rfl
  -- `Dsub` is J-killed: `v` is injective into the J-killed `JP`.
  have hDsubkilled : J • (⊤ : Submodule S Dsub) = ⊥ :=
    smul_top_eq_bot_of_injective v hv_inj
      (by rw [eq_bot_iff, ← hJP]; exact Submodule.smul_mono le_rfl le_top)
  -- `ī' : (K ⧸ Dsub) → P'` descending `qP ∘ K.subtype`.
  have hker : LinearMap.ker (qP.comp K.subtype) = Dsub := by
    ext k
    simp only [LinearMap.mem_ker, LinearMap.comp_apply, hqP, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero, hDsub, Submodule.mem_comap, Submodule.subtype_apply]
  set ī' : (K ⧸ Dsub) →ₗ[S] (P ⧸ JP) :=
    Dsub.liftQ (qP.comp K.subtype) (le_of_eq hker.symm) with hī'def
  have hī'_inj : Function.Injective ī' := by
    rw [← LinearMap.ker_eq_bot]
    exact Submodule.ker_liftQ_eq_bot' _ _ hker.symm
  -- `qP ∘ K.subtype = ī' ∘ Dsub.mkQ`.
  have hRfact : qP.comp K.subtype = ī'.comp Dsub.mkQ := by
    rw [hī'def, Submodule.liftQ_mkQ]
  -- `K ⧸ Dsub` is J-killed: `J • ⊤_K ⊆ Dsub` so the quotient is killed.
  have hKquot : J • (⊤ : Submodule S (K ⧸ Dsub)) = ⊥ := by
    refine smul_top_quotient_eq_bot_of_le ?_
    rw [hDsub, Submodule.smul_le]
    intro s hs k _
    rw [Submodule.mem_comap, map_smul]
    exact Submodule.smul_mem_smul hs Submodule.mem_top
  -- Verticals after `lTensor N`.
  have hc₀N : Function.Injective (JP.subtype.lTensor N) :=
    lemmaC_smul_top_subtype_lTensor_injective J hquot htor (P := P)
  have hvN : Function.Injective (v.lTensor N) :=
    factB_Jkilled J hquot hDsubkilled hJP v hv_inj
  have hī'N : Function.Injective (ī'.lTensor N) :=
    factB_Jkilled J hquot hKquot hP' ī' hī'_inj
  -- Commuting squares after `lTensor N`.
  have hL : (JP.subtype.lTensor N).comp (v.lTensor N)
      = (K.subtype.lTensor N).comp (Dsub.subtype.lTensor N) := by
    rw [← LinearMap.lTensor_comp, ← LinearMap.lTensor_comp, hcv]
  have hR : (qP.lTensor N).comp (K.subtype.lTensor N)
      = (ī'.lTensor N).comp (Dsub.mkQ.lTensor N) := by
    rw [← LinearMap.lTensor_comp, ← LinearMap.lTensor_comp, hRfact]
  -- Top-row exactness: `0 → Dsub → K → K⧸Dsub → 0` tensored.
  have hTopExact : Function.Exact (Dsub.subtype.lTensor N) (Dsub.mkQ.lTensor N) :=
    lTensor_exact N (LinearMap.exact_subtype_mkQ Dsub) Dsub.mkQ_surjective
  -- The chase.
  intro x y hxy
  -- Reduce to: `(K.subtype.lTensor N) z = 0 → z = 0`.
  rw [← sub_eq_zero] at hxy ⊢
  set z := x - y with hz
  rw [← map_sub] at hxy
  -- 1. From (R): `ī'N (Dsub.mkQ_N z) = qP_N (K.subtype_N z) = 0`, so `Dsub.mkQ_N z = 0`.
  have h1 : (Dsub.mkQ.lTensor N) z = 0 := by
    apply hī'N
    have : (ī'.lTensor N) ((Dsub.mkQ.lTensor N) z)
        = (qP.lTensor N) ((K.subtype.lTensor N) z) := by
      rw [← LinearMap.comp_apply, ← hR, LinearMap.comp_apply]
    rw [this, hxy, map_zero, map_zero]
  -- 2. By top exactness, `z = Dsub.subtype_N u` for some `u`.
  obtain ⟨u, hu⟩ := (hTopExact z).mp h1
  -- 3. From (L): `c₀N (vN u) = K.subtype_N (Dsub.subtype_N u) = K.subtype_N z = 0`,
  --    so `vN u = 0`.
  have h3 : (v.lTensor N) u = 0 := by
    apply hc₀N
    have : (JP.subtype.lTensor N) ((v.lTensor N) u)
        = (K.subtype.lTensor N) ((Dsub.subtype.lTensor N) u) := by
      rw [← LinearMap.comp_apply, hL, LinearMap.comp_apply]
    rw [this, hu, hxy, map_zero]
  -- 4. `vN` injective ⟹ `u = 0` ⟹ `z = 0`.
  have h4 : u = 0 := hvN (by rw [h3, map_zero])
  rw [h4, map_zero] at hu
  exact hu.symm

end
