* [StacksProject 00KZ](https://stacks.math.columbia.edu/tag/00KZ)

## Tags

generic flatness, generic freeness, reduced ring, finite presentation, dense open
-/

@[expose] public section

open PrimeSpectrum TensorProduct

universe u v w

namespace Algebra.IsFinitePresentationFreeAway

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The condition 051U only depends on the module up to isomorphism. -/
theorem of_linearEquiv {M M' : Type*} [AddCommGroup M] [Module S M] [AddCommGroup M']
    [Module S M'] (e : M ≃ₗ[S] M') {f : R} (h : IsFinitePresentationFreeAway R S M f) :
    IsFinitePresentationFreeAway R S M' f := by
  obtain ⟨h₁, h₂, h₃, h₄⟩ := h
  let e' := e.baseChange S (Localization (algebraMapSubmonoid S (Submonoid.powers f)))
  exact ⟨h₁, .of_equiv e', h₃, .of_equiv (e'.restrictScalars (Localization.Away f))⟩

/-- For a subsingleton module the condition 051U reduces to its conditions on the algebra. -/
theorem of_subsingleton {M : Type*} [AddCommGroup M] [Module S M] [Subsingleton M] {f : R}
    (h : IsFinitePresentationFreeAway R S S f) : IsFinitePresentationFreeAway R S M f := by
  obtain ⟨h₁, -, h₃, -⟩ := h
  exact ⟨h₁, Module.finitePresentation_of_projective _ _, h₃, Module.Free.of_subsingleton _ _⟩

end Algebra.IsFinitePresentationFreeAway

section Plumbing

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
  [Algebra S T] [IsScalarTower R S T]

/-- The localization of `S` at the image of the powers of `f` is a localization away from the
image of `f`. -/
private theorem isLocalization_away_algebraMap (f : R) :
    IsLocalization.Away (algebraMap R S f)
      (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))) := by
  show IsLocalization (Submonoid.powers (algebraMap R S f)) _
  rw [← Algebra.algebraMapSubmonoid_powers (S := S) f]
  exact Localization.isLocalization

/-- The localization map of an `S`-algebra `T` at the powers of `f : R`, viewed as an `S`-linear
map, is a localization of the `S`-module `T` at the powers of the image of `f` in `S`. -/
private theorem isLocalizedModule_toAlgHom (f : R) :
    IsLocalizedModule (Submonoid.powers (algebraMap R S f))
      (IsScalarTower.toAlgHom S T
        (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f)))).toLinearMap := by
  rw [isLocalizedModule_iff_isLocalization]
  have h₂ := Algebra.algebraMapSubmonoid_powers (S := T) (algebraMap R S f)
  rw [← IsScalarTower.algebraMap_apply] at h₂
  rw [h₂, ← Algebra.algebraMapSubmonoid_powers (S := T) f]
  exact Localization.isLocalization

/-- There is an algebra structure of `S_f` on `T_f` compatible with the map `S → T`. -/
private theorem exists_algebra_localization (f : R) :
    ∃ _ : Algebra (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))),
      IsScalarTower S (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
        (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))) := by
  let φ := IsLocalization.map (M := Algebra.algebraMapSubmonoid S (Submonoid.powers f))
    (S := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
    (T := Algebra.algebraMapSubmonoid T (Submonoid.powers f))
    (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))) (algebraMap S T)
    (by
      rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
      exact ⟨_, ⟨k, rfl⟩, by simp [IsScalarTower.algebraMap_apply R S T]⟩)
  let := φ.toAlgebra
  exact ⟨this, IsScalarTower.of_algebraMap_eq' (IsLocalization.map_comp _).symm⟩

/-- A compatible `S_f`-algebra structure on `T_f` is automatically compatible with `R_f`. -/
private theorem isScalarTower_localization (f : R)
    [Algebra (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f)))]
    [IsScalarTower S (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f)))] :
    IsScalarTower (Localization.Away f)
      (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))) := by
  refine IsScalarTower.of_algebraMap_eq' ?_
  refine IsLocalization.ringHom_ext (Submonoid.powers f) ?_
  ext r
  simp only [RingHom.coe_comp, Function.comp_apply]
  let Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
  let Tf := Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))
  rw [← IsScalarTower.algebraMap_apply R (Localization.Away f) Sf,
    ← IsScalarTower.algebraMap_apply R (Localization.Away f) Tf,
    IsScalarTower.algebraMap_apply R S Sf, ← IsScalarTower.algebraMap_apply S Sf Tf,
    ← IsScalarTower.algebraMap_apply R S Tf]

/-- **The condition 051U for an `S`-algebra `T`**, tested on the canonical localizations `S_f` and
`T_f`, with any `S_f`-algebra structure on `T_f` compatible with `S → T`. -/
private theorem isFinitePresentationFreeAway_algebra_iff (f : R)
    [Algebra (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f)))]
    [IsScalarTower S (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f)))] :
    letI Rf := Localization.Away f
    letI Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
    letI Tf := Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))
    Algebra.IsFinitePresentationFreeAway R S T f ↔
      Algebra.FinitePresentation Rf Sf ∧ Module.FinitePresentation Sf Tf ∧
        Module.Free Rf Sf ∧ Module.Free Rf Tf := by
  let Rf := Localization.Away f
  let Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
  let Tf := Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))
  have : IsLocalization.Away (algebraMap R S f) Sf := isLocalization_away_algebraMap f
  have : IsLocalizedModule (Submonoid.powers (algebraMap R S f))
      (IsScalarTower.toAlgHom S T Tf).toLinearMap := isLocalizedModule_toAlgHom f
  have : IsScalarTower Rf Sf Tf := isScalarTower_localization f
  exact Algebra.isFinitePresentationFreeAway_iff f Rf Sf Tf
    (IsScalarTower.toAlgHom S T Tf).toLinearMap

/-- **The condition 051U for `T` over itself**: it says that `T_f` is free and of finite
presentation as an `R_f`-algebra. -/
private theorem isFinitePresentationFreeAway_self_iff (f : R) :
    letI Rf := Localization.Away f
    letI Tf := Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))
    Algebra.IsFinitePresentationFreeAway R T T f ↔
      Algebra.FinitePresentation Rf Tf ∧ Module.Free Rf Tf := by
  rw [isFinitePresentationFreeAway_algebra_iff f]
  exact ⟨fun h => ⟨h.1, h.2.2.1⟩,
    fun h => ⟨h.1, Module.finitePresentation_of_projective _ _, h.2, h.2⟩⟩

/-- **Goodness of an algebra over an algebra passes to the algebra over itself.** If `f`
satisfies 051U for `R → S` and the `S`-module `T`, then `f` satisfies 051U for `R → T` and `T`:
`T_f` is of finite presentation as an `S_f`-module, hence as an `S_f`-algebra, hence as an
`R_f`-algebra. -/
private theorem isFinitePresentationFreeAway_self_of_algebra {f : R}
    (h : Algebra.IsFinitePresentationFreeAway R S T f) :
    Algebra.IsFinitePresentationFreeAway R T T f := by
  obtain ⟨_, _⟩ := exists_algebra_localization (R := R) (S := S) (T := T) f
  have := isScalarTower_localization (R := R) (S := S) (T := T) f
  obtain ⟨_, _, _, _⟩ := (isFinitePresentationFreeAway_algebra_iff f).mp h
  refine (isFinitePresentationFreeAway_self_iff f).mpr ⟨?_, inferInstance⟩
  exact Algebra.FinitePresentation.trans (Localization.Away f)
    (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))) _

/-- **Goodness of a quotient algebra as a module.** If `S → T` is surjective and `f` satisfies
051U both for `R → S`, `S` and for `R → T`, `T`, then it satisfies 051U for `R → S` and the
`S`-module `T`. -/
private theorem isFinitePresentationFreeAway_algebra_of_surjective
    (hST : Function.Surjective (algebraMap S T)) {f : R}
    (hS : Algebra.IsFinitePresentationFreeAway R S S f)
    (hT : Algebra.IsFinitePresentationFreeAway R T T f) :
    Algebra.IsFinitePresentationFreeAway R S T f := by
  obtain ⟨_, _⟩ := exists_algebra_localization (R := R) (S := S) (T := T) f
  obtain ⟨_, _⟩ := (isFinitePresentationFreeAway_self_iff f).mp hS
  obtain ⟨_, _⟩ := (isFinitePresentationFreeAway_self_iff f).mp hT
  refine (isFinitePresentationFreeAway_algebra_iff f).mpr ⟨inferInstance, ?_, inferInstance,
    inferInstance⟩
  let Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
  let Tf := Localization (Algebra.algebraMapSubmonoid T (Submonoid.powers f))
  have : IsScalarTower (Localization.Away f) Sf Tf := isScalarTower_localization f
  have : Algebra.FinitePresentation Sf Tf :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation (Localization.Away f) _ _
  have hsurj : Function.Surjective (algebraMap Sf Tf) := by
    intro y
    obtain ⟨⟨t, _, x, ⟨k, rfl⟩, rfl⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (Algebra.algebraMapSubmonoid T (Submonoid.powers f)) y
    obtain ⟨s, rfl⟩ := hST t
    refine ⟨IsLocalization.mk' Sf s (⟨algebraMap R S (f ^ k), f ^ k, ⟨k, rfl⟩, rfl⟩ :
      Algebra.algebraMapSubmonoid S (Submonoid.powers f)), ?_⟩
    rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul]
    simp only
    rw [IsScalarTower.algebraMap_apply R S T, ← IsScalarTower.algebraMap_apply S T Tf,
      IsScalarTower.algebraMap_apply S Sf Tf, ← IsScalarTower.algebraMap_apply S T Tf,
      IsScalarTower.algebraMap_apply S Sf Tf, ← map_mul, IsLocalization.mk'_spec]
  have : Module.Finite Sf Tf := Module.Finite.of_surjective (Algebra.linearMap Sf Tf) hsurj
  exact Module.FinitePresentation.of_finite_of_finitePresentation _ _

end Plumbing

section Locus

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The `f`-step of Stacks 051Y: if the locus `U(R_f → S_f, M_f)` is dense in `Spec(R_f)`, then
`D(f)` lies in the closure of `U(R → S, M)`, by Stacks 051X. -/
private theorem basicOpen_subset_closure_of_dense_localization {M : Type*} [AddCommGroup M]
    [Module S M] (f : R)
    (H : Dense (⋃ g ∈ {g : Localization.Away f | Algebra.IsFinitePresentationFreeAway
        (Localization.Away f) (Localization (Algebra.algebraMapSubmonoid S (.powers f)))
        (Localization (Algebra.algebraMapSubmonoid S (.powers f)) ⊗[S] M) g},
      (basicOpen g : Set (PrimeSpectrum (Localization.Away f))))) :
    (basicOpen f : Set (PrimeSpectrum R)) ⊆
      closure (⋃ g ∈ {g : R | Algebra.IsFinitePresentationFreeAway R S M g},
        (basicOpen g : Set (PrimeSpectrum R))) := by
  let Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
  have : IsLocalization.Away (algebraMap R S f) Sf := isLocalization_away_algebraMap f
  have : IsLocalizedModule.Away (algebraMap R S f) (TensorProduct.mk S Sf M 1) :=
    (isLocalizedModule_iff_isBaseChange _ Sf _).mpr (TensorProduct.isBaseChange S M Sf)
  calc (basicOpen f : Set (PrimeSpectrum R))
      = Set.range (comap (algebraMap R (Localization.Away f))) :=
        (localization_away_comap_range (Localization.Away f) f).symm
    _ ⊆ _ :=
        ((continuous_comap _).range_subset_closure_image_dense H).trans <| closure_mono <|
          (Algebra.image_comap_iUnion_basicOpen_isFinitePresentationFreeAway
            (R := R) (S := S) (M := M) f (Localization.Away f) Sf (Sf ⊗[S] M)
            (TensorProduct.mk S Sf M 1)).subset.trans Set.inter_subset_right

/-- The `f`-step of Stacks 051Y for the module `S` itself. -/
private theorem basicOpen_subset_closure_of_dense_localization_self (f : R)
    (H : Dense (⋃ g ∈ {g : Localization.Away f | Algebra.IsFinitePresentationFreeAway
        (Localization.Away f) (Localization (Algebra.algebraMapSubmonoid S (.powers f)))
        (Localization (Algebra.algebraMapSubmonoid S (.powers f))) g},
      (basicOpen g : Set (PrimeSpectrum (Localization.Away f))))) :
    (basicOpen f : Set (PrimeSpectrum R)) ⊆
      closure (⋃ g ∈ {g : R | Algebra.IsFinitePresentationFreeAway R S S g},
        (basicOpen g : Set (PrimeSpectrum R))) := by
  let Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
  refine basicOpen_subset_closure_of_dense_localization f (H.mono ?_)
  refine Set.biUnion_mono (fun g hg => ?_) (fun _ _ => subset_rfl)
  exact Algebra.IsFinitePresentationFreeAway.of_linearEquiv
    (TensorProduct.AlgebraTensorModule.rid S Sf Sf).symm hg

omit [Algebra R S] in
/-- A set is dense as soon as its closure contains the members of a family of standard opens with
dense union. -/
private theorem dense_of_basicOpen_subset_closure (s : Set R) {U : Set (PrimeSpectrum R)}
    (hs : Dense (⋃ f ∈ s, (basicOpen f : Set (PrimeSpectrum R))))
    (h : ∀ f ∈ s, (basicOpen f : Set (PrimeSpectrum R)) ⊆ closure U) : Dense U :=
  (hs.mono (Set.iUnion₂_subset h)).of_closure

omit [Algebra R S] in
/-- **The dichotomy used throughout the proof.** For a reduced ring `R` and a set `t ⊆ R`, the
standard opens `D(c)`, `c ∈ t`, together with the standard opens `D(f)` for the `f` annihilating
every element of `t`, have dense union in `Spec R`: the first family covers the open
`U₁ = ⋃_{c ∈ t} D(c)`, the second covers the interior of its complement, since `D(f) ∩ D(c) = ∅`
means that `fc` is nilpotent, hence zero. -/
private theorem dense_iUnion_basicOpen_union_annihilator [IsReduced R] (t : Set R) :
    Dense (⋃ f ∈ t ∪ {f | ∀ c ∈ t, f * c = 0}, (basicOpen f : Set (PrimeSpectrum R))) := by
  set U₁ := ⋃ c ∈ t, (basicOpen c : Set (PrimeSpectrum R))
  have hsub : U₁ ∪ interior U₁ᶜ ⊆
      ⋃ f ∈ t ∪ {f | ∀ c ∈ t, f * c = 0}, (basicOpen f : Set (PrimeSpectrum R)) := by
    rintro p (hp | hp)
    · obtain ⟨c, hc, hpc⟩ := Set.mem_iUnion₂.mp hp
      exact Set.mem_iUnion₂.mpr ⟨c, Or.inl hc, hpc⟩
    · obtain ⟨_, ⟨f, rfl⟩, hpf, hfU⟩ := isTopologicalBasis_basic_opens.exists_subset_of_mem_open
        hp isOpen_interior
      refine Set.mem_iUnion₂.mpr ⟨f, Or.inr fun c hc => ?_, hpf⟩
      refine IsReduced.eq_zero _ ((basicOpen_eq_bot_iff _).mp ?_)
      rw [basicOpen_mul]
      ext q
      simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe,
        TopologicalSpace.Opens.mem_bot, iff_false, not_and]
      intro hqf hqc
      exact interior_subset (hfU hqf) (Set.mem_iUnion₂.mpr ⟨c, hc, hqc⟩)
  refine Dense.mono hsub ?_
  rw [dense_iff_closure_eq, Set.eq_univ_iff_forall]
  intro p
  rw [closure_union]
  by_cases hp : p ∈ closure U₁
  · exact Or.inl hp
  · exact Or.inr (subset_closure (by rwa [interior_compl]))

end Locus

section Presentation

open MvPolynomial

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {σ : Type*}

/-- **Localizing a presentation.** A surjection `π : R[x_σ] → S` of `R`-algebras induces, for
every `f : R`, a surjection `π_f : R_f[x_σ] → S_f` of `R_f`-algebras compatible with `π`. -/
private theorem exists_localized_presentation (π : MvPolynomial σ R →ₐ[R] S)
    (hπ : Function.Surjective π) (f : R) :
    ∃ πf : MvPolynomial σ (Localization.Away f) →ₐ[Localization.Away f]
        Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)),
      Function.Surjective πf ∧ ∀ p, πf (map (algebraMap R (Localization.Away f)) p) =
        algebraMap S (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))) (π p) := by
  let Rf := Localization.Away f
  let Sf := Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))
  have : IsLocalization.Away (algebraMap R S f) Sf := isLocalization_away_algebraMap f
  let πf : MvPolynomial σ Rf →ₐ[Rf] Sf := aeval fun i => algebraMap S Sf (π (X i))
  have hcomp : ∀ p, πf (map (algebraMap R Rf) p) = algebraMap S Sf (π p) := by
    intro p
    have h : (πf.toRingHom.comp (map (algebraMap R Rf))) = (algebraMap S Sf).comp π.toRingHom := by
      refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
      · simp only [RingHom.coe_comp, Function.comp_apply, map_C, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, πf, aeval_C]
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, ← IsScalarTower.algebraMap_apply,
          ← IsScalarTower.algebraMap_apply]
      · simp [πf]
    exact RingHom.congr_fun h p
  refine ⟨πf, fun y => ?_, hcomp⟩
  obtain ⟨n, a, hy⟩ := IsLocalization.Away.surj (algebraMap R S f) y
  obtain ⟨p, rfl⟩ := hπ a
  refine ⟨C (IsLocalization.Away.invSelf (S := Rf) f) ^ n * map (algebraMap R Rf) p, ?_⟩
  rw [map_mul, map_pow, hcomp, ← hy, aeval_C]
  have h1 : algebraMap S Sf (algebraMap R S f) * algebraMap Rf Sf (IsLocalization.Away.invSelf f)
      = 1 := by
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R Rf Sf, ← map_mul,
      IsLocalization.Away.mul_invSelf, map_one]
  calc algebraMap Rf Sf (IsLocalization.Away.invSelf f) ^ n *
        (y * algebraMap S Sf (algebraMap R S f) ^ n)
      = y * (algebraMap S Sf (algebraMap R S f) *
          algebraMap Rf Sf (IsLocalization.Away.invSelf f)) ^ n := by ring
    _ = y := by rw [h1, one_pow, mul_one]

attribute [local instance] MvPolynomial.algebraMvPolynomial in
/-- **A presentation with no relations after inverting `f`.** If `f` annihilates every
coefficient of every relation of the presentation `π`, then the localized presentation `π_f` is
injective. -/
private theorem injective_of_mul_coeff_eq_zero (π : MvPolynomial σ R →ₐ[R] S) (f : R)
    (hf : ∀ p ∈ RingHom.ker π, ∀ v, f * coeff v p = 0)
    (πf : MvPolynomial σ (Localization.Away f) →ₐ[Localization.Away f]
      Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
    (hcomp : ∀ p, πf (map (algebraMap R (Localization.Away f)) p) =
      algebraMap S (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f))) (π p)) :
    Function.Injective πf := by
  let Rf := Localization.Away f
  rw [injective_iff_map_eq_zero]
  intro q hq
  obtain ⟨⟨p, ⟨_, ⟨m, ⟨k, rfl⟩, rfl⟩⟩⟩, hpq⟩ :=
    IsLocalization.surj ((Submonoid.powers f).map (C (σ := σ))) q
  simp only [MvPolynomial.algebraMap_def, map_C] at hpq
  have hp : algebraMap S (Localization (Algebra.algebraMapSubmonoid S (Submonoid.powers f)))
      (π p) = 0 := by
    rw [← hcomp, ← hpq, map_mul, hq, zero_mul]
  obtain ⟨⟨_, _, ⟨j, rfl⟩, rfl⟩, hj⟩ :=
    (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid S (Submonoid.powers f)) _ _).mp hp
  have hker : C (f ^ j) * p ∈ RingHom.ker π := by
    rw [RingHom.mem_ker]
    simpa [← MvPolynomial.algebraMap_eq] using hj
  have hmap : map (algebraMap R Rf) p = 0 := by
    ext v
    rw [coeff_map, coeff_zero]
    refine (IsLocalization.map_eq_zero_iff (Submonoid.powers f) _ _).mpr
      ⟨⟨f ^ (j + 1), ⟨j + 1, rfl⟩⟩, ?_⟩
    have := hf _ hker v
    rw [coeff_C_mul] at this
    simpa [pow_succ, mul_comm, mul_left_comm, mul_assoc] using this
  have hu : IsUnit (C (algebraMap R Rf (f ^ k)) : MvPolynomial σ Rf) := by
    rw [map_pow]
    exact ((IsLocalization.Away.algebraMap_isUnit f).pow k).map C
  exact hu.mul_left_eq_zero.mp (hpq.trans hmap)

end Presentation

section NoetherNormalization

open MvPolynomial

variable {R : Type*} [CommRing R] {n : ℕ}

/-- The substitution `x_0 ↦ x_0`, `x_i ↦ x_i + c x_0 ^ (N ^ i)` for `i ≠ 0` of Nagata's proof of
Noether normalization. -/
private noncomputable def nagataHom (N : ℕ) (c : R) :
    MvPolynomial (Fin (n + 1)) R →ₐ[R] MvPolynomial (Fin (n + 1)) R :=
  aeval fun i => if i = 0 then X 0 else X i + c • X 0 ^ (N ^ (i : ℕ))

private theorem nagataHom_comp_nagataHom_neg (N : ℕ) (c : R) :
    (nagataHom (n := n) N c).comp (nagataHom N (-c)) = AlgHom.id _ _ := by
  rw [nagataHom, nagataHom, comp_aeval, ← MvPolynomial.aeval_X_left]
  ext i v
  cases i using Fin.cases <;> simp

/-- Nagata's substitution, as an automorphism of `R[x_0, …, x_n]`. -/
private noncomputable def nagataEquiv (N : ℕ) :
    MvPolynomial (Fin (n + 1)) R ≃ₐ[R] MvPolynomial (Fin (n + 1)) R :=
  AlgEquiv.ofAlgHom (nagataHom N 1) (nagataHom N (-1)) (nagataHom_comp_nagataHom_neg N 1)
    (by simpa using nagataHom_comp_nagataHom_neg (R := R) (n := n) N (-1))

/-- Nagata's substitution sends a monomial `a x^v`, viewed as a polynomial in `x_0` over
`R[x_1, …, x_n]`, to `a` times a monic polynomial. -/
private theorem finSuccEquiv_nagataEquiv_monomial (N : ℕ) (v : Fin (n + 1) →₀ ℕ) (a : R) :
    finSuccEquiv R n (nagataEquiv N (monomial v a)) =
      Polynomial.C (C a) * (Polynomial.X ^ v 0 * ∏ i : Fin n,
        (Polynomial.C (X i) + Polynomial.X ^ (N ^ ((i : ℕ) + 1))) ^ v i.succ) := by
  rw [monomial_eq, Finsupp.prod_pow v fun a ↦ X a]
  simp only [Fin.prod_univ_succ, map_mul, map_prod, map_pow, nagataEquiv, nagataHom,
    AlgEquiv.ofAlgHom_apply, MvPolynomial.aeval_C, MvPolynomial.aeval_X, Fin.succ_ne_zero,
    ite_false, ite_true, one_smul, map_add, finSuccEquiv_X_zero, finSuccEquiv_X_succ,
    algebraMap_eq, Fin.val_succ]
  rw [finSuccEquiv_apply, eval₂Hom_C]
  rfl

/-- Each factor of Nagata's monic polynomial is monic. -/
private theorem monic_nagata_factor (N : ℕ) (hN : N ≠ 0) (i : Fin n) :
    (Polynomial.C (X i : MvPolynomial (Fin n) R) +
      Polynomial.X ^ (N ^ ((i : ℕ) + 1))).Monic := by
  rw [add_comm]
  exact Polynomial.monic_X_pow_add_C _ (pow_ne_zero _ hN)

private theorem monic_nagata (N : ℕ) (hN : N ≠ 0) (v : Fin (n + 1) →₀ ℕ) :
    (Polynomial.X ^ v 0 * ∏ i : Fin n,
        (Polynomial.C (X i : MvPolynomial (Fin n) R) +
          Polynomial.X ^ (N ^ ((i : ℕ) + 1))) ^ v i.succ).Monic :=
  (Polynomial.monic_X_pow _).mul
    (Polynomial.monic_prod_of_monic _ _ fun i _ => (monic_nagata_factor N hN i).pow _)

private theorem natDegree_nagata [Nontrivial R] (N : ℕ) (hN : N ≠ 0) (v : Fin (n + 1) →₀ ℕ) :
    (Polynomial.X ^ v 0 * ∏ i : Fin n,
        (Polynomial.C (X i : MvPolynomial (Fin n) R) +
          Polynomial.X ^ (N ^ ((i : ℕ) + 1))) ^ v i.succ).natDegree =
      ∑ i : Fin (n + 1), N ^ (i : ℕ) * v i := by
  have hm := fun i : Fin n => (monic_nagata_factor (R := R) N hN i).pow (v i.succ)
  rw [(Polynomial.monic_X_pow _).natDegree_mul (Polynomial.monic_prod_of_monic _ _ fun i _ => hm i),
    Polynomial.natDegree_prod_of_monic _ _ fun i _ => hm i, Fin.sum_univ_succ]
  simp only [Polynomial.natDegree_X_pow, Fin.val_zero, pow_zero, one_mul, Fin.val_succ]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Polynomial.Monic.natDegree_pow (monic_nagata_factor N hN i), add_comm (Polynomial.C _),
    Polynomial.natDegree_X_pow_add_C, mul_comm]

/-- Distinct exponents all of whose entries are smaller than `N` have distinct weights
`∑ N ^ i v_i`: these are base-`N` expansions. -/
private theorem sum_pow_mul_ne {N : ℕ} (hN : 1 < N) {v w : Fin (n + 1) →₀ ℕ}
    (vlt : ∀ i, v i < N) (wlt : ∀ i, w i < N) (ne : v ≠ w) :
    ∑ i : Fin (n + 1), N ^ (i : ℕ) * v i ≠ ∑ i : Fin (n + 1), N ^ (i : ℕ) * w i := by
  intro h
  have lt : ∀ u : Fin (n + 1) →₀ ℕ, (∀ i, u i < N) → ∀ l ∈ List.ofFn u, l < N := by
    intro u hu l hl
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hl
    exact hu i
  refine ne <| Finsupp.ext <| congrFun <| List.ofFn_inj.mp ?_
  apply Nat.ofDigits_inj_of_len_eq hN (by simp) (lt v vlt) (lt w wlt)
  simpa only [Nat.ofDigits_eq_sum_mapIdx, List.mapIdx_eq_ofFn, List.get_ofFn, List.length_ofFn,
    Fin.val_cast, mul_comm, List.sum_ofFn] using! h

/-- **Nagata's trick over a ring** (the degree computation of Stacks 051N). If every coefficient
of the nonzero polynomial `g` is a unit, then after Nagata's substitution with
`N = 2 + deg g`, the polynomial `g` viewed as a polynomial in `x_0` has a unit leading
coefficient. -/
private theorem isUnit_leadingCoeff_finSuccEquiv_nagataEquiv [Nontrivial R]
    (g : MvPolynomial (Fin (n + 1)) R) (hg : g ≠ 0) (hu : ∀ v ∈ g.support, IsUnit (coeff v g)) :
    IsUnit (finSuccEquiv R n (nagataEquiv (2 + g.totalDegree) g)).leadingCoeff := by
  set N := 2 + g.totalDegree with hNdef
  have hN : N ≠ 0 := by omega
  set P := fun v => finSuccEquiv R n (nagataEquiv N (monomial v (coeff v g))) with hP
  have hPdeg : ∀ v ∈ g.support, (P v).natDegree = ∑ i : Fin (n + 1), N ^ (i : ℕ) * v i := by
    intro v hv
    simp only [hP]
    rw [finSuccEquiv_nagataEquiv_monomial, Polynomial.natDegree_C_mul_of_isUnit
      ((hu v hv).map C), natDegree_nagata N hN]
  have hPlc : ∀ v ∈ g.support, (P v).leadingCoeff = C (coeff v g) := by
    intro v hv
    simp only [hP]
    rw [finSuccEquiv_nagataEquiv_monomial, Polynomial.leadingCoeff_C_mul_of_isUnit
      ((hu v hv).map C), (monic_nagata N hN v).leadingCoeff, mul_one]
  have hPne : ∀ v ∈ g.support, P v ≠ 0 := fun v hv h0 => by
    have := hPlc v hv
    rw [h0, Polynomial.leadingCoeff_zero] at this
    exact ((hu v hv).map (C : R →+* MvPolynomial (Fin n) R)).ne_zero this.symm
  obtain ⟨v, hv, hmax⟩ := Finset.exists_max_image g.support
    (fun v => ∑ i : Fin (n + 1), N ^ (i : ℕ) * v i) (support_nonempty.mpr hg)
  have hlt : ∀ w ∈ g.support \ {v}, (P w).degree < (P v).degree := by
    intro w hw
    obtain ⟨hw₁, hw₂⟩ := Finset.mem_sdiff.mp hw
    rw [Polynomial.degree_eq_natDegree (hPne w hw₁), Polynomial.degree_eq_natDegree (hPne v hv),
      Nat.cast_lt, hPdeg w hw₁, hPdeg v hv]
    have hbound : ∀ u ∈ g.support, ∀ i, u i < N := fun u hu i =>
      lt_of_le_of_lt ((monomial_le_degreeOf i hu).trans (degreeOf_le_totalDegree g i))
        (by omega)
    exact lt_of_le_of_ne (hmax w hw₁) (sum_pow_mul_ne (by omega) (hbound w hw₁) (hbound v hv)
      (fun h => hw₂ (Finset.mem_singleton.mpr h)))
  have hsum : finSuccEquiv R n (nagataEquiv N g) =
      (∑ w ∈ g.support \ {v}, P w) + P v := by
    conv_lhs => rw [← g.support_sum_monomial_coeff,
      Finset.sum_eq_add_sum_sdiff_singleton_of_mem hv]
    simp only [map_add, map_sum, hP]
    rw [add_comm]
  rw [hsum, Polynomial.leadingCoeff_add_of_degree_lt, hPlc v hv]
  · exact (hu v hv).map C
  · refine (Polynomial.degree_sum_le _ _).trans_lt ?_
    refine (Finset.sup_lt_iff ?_).mpr hlt
    exact bot_lt_iff_ne_bot.mpr (fun h => hPne v hv (Polynomial.degree_eq_bot.mp h))

end NoetherNormalization

section NoetherNormalization

open MvPolynomial

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] {n : ℕ}

/-- **The finiteness step of Stacks 051Z.** Let `π : R[x_0, …, x_n] → S` be a surjection of
`R`-algebras whose kernel contains a nonzero polynomial `g` all of whose coefficients are units.
Then `S` is a finite algebra over a polynomial ring in `n` variables: after Nagata's substitution
`g` becomes a unit multiple of a monic polynomial in `x_0` over `R[x_1, …, x_n]`. -/
private theorem exists_finite_of_isUnit_coeff [Nontrivial R]
    (π : MvPolynomial (Fin (n + 1)) R →ₐ[R] S) (hπ : Function.Surjective π)
    (g : MvPolynomial (Fin (n + 1)) R) (hgπ : π g = 0) (hg : g ≠ 0)
    (hu : ∀ v ∈ g.support, IsUnit (coeff v g)) :
    ∃ _ : Algebra (MvPolynomial (Fin n) R) S, IsScalarTower R (MvPolynomial (Fin n) R) S ∧
      Module.Finite (MvPolynomial (Fin n) R) S := by
  set A := MvPolynomial (Fin n) R
  set T : MvPolynomial (Fin (n + 1)) R ≃ₐ[R] MvPolynomial (Fin (n + 1)) R :=
    nagataEquiv (2 + g.totalDegree)
  let Θ : Polynomial A →ₐ[R] S :=
    π.comp (T.symm.toAlgHom.comp (finSuccEquiv R n).symm.toAlgHom)
  have hΘ : Function.Surjective Θ :=
    hπ.comp (T.symm.surjective.comp (finSuccEquiv R n).symm.surjective)
  let ψ : A →ₐ[R] S := Θ.comp (IsScalarTower.toAlgHom R A (Polynomial A))
  let _ : Algebra A S := ψ.toRingHom.toAlgebra
  have : IsScalarTower R A S := IsScalarTower.of_algebraMap_eq fun r => (ψ.commutes r).symm
  refine ⟨_, this, ?_⟩
  set z : S := π (T.symm (X 0))
  have hΘz : ∀ q, Θ q = Polynomial.aeval z q := by
    intro q
    have h : Θ.toRingHom = (Polynomial.aeval (R := A) z).toRingHom := by
      refine Polynomial.ringHom_ext (fun a => ?_) ?_
      · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C]
        rfl
      · have hX : (finSuccEquiv R n).symm Polynomial.X = X 0 := by
          rw [AlgEquiv.symm_apply_eq, finSuccEquiv_X_zero]
        simp [Θ, hX, z]
    exact RingHom.congr_fun h q
  have hlc := isUnit_leadingCoeff_finSuccEquiv_nagataEquiv g hg hu
  set h := finSuccEquiv R n (T g)
  set p := hlc.unit⁻¹ • h
  have hp : p.Monic := Polynomial.monic_of_isUnit_leadingCoeff_inv_smul hlc
  have hz : p.eval₂ (Algebra.ofId A S : A →+* S) z = 0 := by
    have : Θ h = 0 := by simp [Θ, h, hgπ]
    show Polynomial.aeval z (hlc.unit⁻¹ • h) = 0
    rw [Units.smul_def, map_smul, ← hΘz, this, smul_zero]
  let L := AdjoinRoot.liftAlgHom p (Algebra.ofId A S) z hz
  have hL : Function.Surjective L := by
    intro s
    obtain ⟨q, rfl⟩ := hΘ s
    refine ⟨AdjoinRoot.mk p q, ?_⟩
    rw [AdjoinRoot.liftAlgHom_mk, hΘz]
    rfl
  have : Module.Finite A (AdjoinRoot p) := (AdjoinRoot.powerBasis' hp).finite
  exact Module.Finite.of_surjective L.toLinearMap hL

end NoetherNormalization

section Modules

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The locus `U(R → S, M)` of Stacks 051V: the union of the standard opens `D(f)` over the `f`
satisfying the condition 051U. -/
private abbrev goodLocus (R S M : Type*) [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] : Set (PrimeSpectrum R) :=
  ⋃ f ∈ {f : R | Algebra.IsFinitePresentationFreeAway R S M f},
    (basicOpen f : Set (PrimeSpectrum R))

private theorem isOpen_goodLocus (M : Type*) [AddCommGroup M] [Module S M] :
    IsOpen (goodLocus R S M) :=
  isOpen_iUnion fun _ => isOpen_iUnion fun _ => (basicOpen _).isOpen

private theorem goodLocus_mono {M M' : Type*} [AddCommGroup M] [Module S M] [AddCommGroup M']
    [Module S M']
    (h : ∀ f, Algebra.IsFinitePresentationFreeAway R S M f →
      Algebra.IsFinitePresentationFreeAway R S M' f) :
    goodLocus R S M ⊆ goodLocus R S M' :=
  Set.biUnion_mono (fun f hf => h f hf) (fun _ _ => subset_rfl)

/-- If every element satisfies 051U, the locus is everything, in particular dense. -/
private theorem dense_goodLocus_of_forall {M : Type*} [AddCommGroup M] [Module S M]
    (h : ∀ f, Algebra.IsFinitePresentationFreeAway R S M f) : Dense (goodLocus R S M) := by
  have : goodLocus R S M = Set.univ :=
    Set.eq_univ_of_univ_subset fun p _ => Set.mem_iUnion₂.mpr ⟨1, h 1, by simp⟩
  rw [this]
  exact dense_univ

/-- Over a subsingleton algebra every element satisfies 051U. -/
private theorem isFinitePresentationFreeAway_of_subsingleton [Subsingleton S] (f : R) :
    Algebra.IsFinitePresentationFreeAway R S S f := by
  have : Module.Finite R S := Module.Finite.of_surjective (0 : R →ₗ[R] S)
    (fun x => ⟨0, Subsingleton.elim _ _⟩)
  have : Module.FinitePresentation R S := Module.finitePresentation_of_projective R S
  exact Algebra.isFinitePresentationFreeAway_of_finitePresentation_of_free f

/-- Over a polynomial algebra in finitely many variables every element satisfies 051U. -/
private theorem isFinitePresentationFreeAway_of_algEquiv {k : ℕ}
    (e : MvPolynomial (Fin k) R ≃ₐ[R] S) (f : R) :
    Algebra.IsFinitePresentationFreeAway R S S f := by
  have : Algebra.FinitePresentation R S := Algebra.FinitePresentation.equiv e
  have : Module.Free R S := Module.Free.of_equiv e.toLinearEquiv
  exact Algebra.isFinitePresentationFreeAway_of_finitePresentation_of_free f

/-- **Reduction to cyclic modules** (the filtration step of Stacks 051Z). If `U(R → S, S)` and
every `U(R → S/J, S/J)` are dense, then `U(R → S, M)` is dense for every finite `S`-module `M`:
filter `M` by cyclic submodules (Stacks 00KZ) and use Stacks 051W. -/
private theorem dense_goodLocus_of_quotients (hS : Dense (goodLocus R S S))
    (hq : ∀ J : Ideal S, Dense (goodLocus R (S ⧸ J) (S ⧸ J)))
    (M : Type*) [AddCommGroup M] [Module S M] [Module.Finite S M] :
    Dense (goodLocus R S M) := by
  have hcyc : ∀ J : Ideal S, Dense (goodLocus R S (S ⧸ J)) := by
    intro J
    refine (hS.inter_of_isOpen_left (hq J) (isOpen_goodLocus _)).mono ?_
    rintro p ⟨hp₁, hp₂⟩
    obtain ⟨f₁, hf₁, hpf₁⟩ := Set.mem_iUnion₂.mp hp₁
    obtain ⟨f₂, hf₂, hpf₂⟩ := Set.mem_iUnion₂.mp hp₂
    refine Set.mem_iUnion₂.mpr ⟨f₁ * f₂, ?_, by rw [basicOpen_mul]; exact ⟨hpf₁, hpf₂⟩⟩
    exact isFinitePresentationFreeAway_algebra_of_surjective Ideal.Quotient.mk_surjective
      ((show Algebra.IsFinitePresentationFreeAway R S S f₁ from hf₁).of_dvd
        (dvd_mul_right f₁ f₂))
      ((show Algebra.IsFinitePresentationFreeAway R (S ⧸ J) (S ⧸ J) f₂ from hf₂).of_dvd
        (dvd_mul_left f₂ f₁))
  obtain ⟨k, s, hs⟩ := Module.Finite.exists_fin (R := S) (M := M)
  induction k generalizing M with
  | zero =>
    have htop : (⊤ : Submodule S M) = ⊥ := by
      rw [← hs, Set.range_eq_empty, Submodule.span_empty]
    have : Subsingleton M := ⟨fun x y => by
      have hx : x ∈ (⊥ : Submodule S M) := htop ▸ Submodule.mem_top
      have hy : y ∈ (⊥ : Submodule S M) := htop ▸ Submodule.mem_top
      rw [Submodule.mem_bot] at hx hy
      rw [hx, hy]⟩
    exact hS.mono (goodLocus_mono fun f hf =>
      Algebra.IsFinitePresentationFreeAway.of_subsingleton hf)
  | succ k ih =>
    set N := Submodule.span S {s 0}
    have hN : Dense (goodLocus R S N) := (hcyc (Ideal.torsionOf S M (s 0))).mono
      (goodLocus_mono fun f hf =>
        hf.of_linearEquiv (Ideal.quotTorsionOfEquivSpanSingleton S M (s 0)))
    have hspan : Submodule.span S (Set.range fun i : Fin k => N.mkQ (s i.succ)) = ⊤ := by
      refine eq_top_iff.mpr ?_
      have hmap : Submodule.map N.mkQ (Submodule.span S (Set.range s)) = ⊤ := by
        rw [hs, Submodule.map_top, Submodule.range_mkQ]
      rw [← hmap, Submodule.map_span, Submodule.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      cases i using Fin.cases with
      | zero =>
        rw [SetLike.mem_coe, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).mpr
          (Submodule.mem_span_singleton_self _)]
        exact Submodule.zero_mem _
      | succ j => exact Submodule.subset_span ⟨j, rfl⟩
    have hQ := ih (M ⧸ N) (fun i => N.mkQ (s i.succ)) hspan
    exact (hN.inter_of_isOpen_left hQ (isOpen_goodLocus _)).mono
      (Algebra.iUnion_basicOpen_isFinitePresentationFreeAway_inter_subset_of_shortExact
        N.subtype N.mkQ N.injective_subtype N.mkQ_surjective (LinearMap.exact_subtype_mkQ N))

end Modules

section Induction

open MvPolynomial

/-- The statement of Stacks 051Z for the module `S` itself and an algebra presented by `n`
generators, over reduced rings in fixed universes. This is the statement proved by induction on
`n`. -/
private def PresentedStatement.{u₁, u₂} (n : ℕ) : Prop :=
  ∀ (R : Type u₁) (S : Type u₂) [CommRing R] [IsReduced R] [CommRing S] [Algebra R S]
    (π : MvPolynomial (Fin n) R →ₐ[R] S), Function.Surjective π → Dense (goodLocus R S S)

/-- **The case `m = 0` of Stacks 051Z**: the kernel of the presentation contains a polynomial all
of whose coefficients are units, some coefficient being present. Then either `S = 0`, or `n ≥ 1`
and Noether normalization makes `S` finite over a polynomial ring in `n - 1` variables, where
the induction hypothesis on `n` applies. -/
private theorem dense_goodLocus_of_forall_isUnit.{u₁, u₂} {n : ℕ}
    (IH : ∀ n', n = n' + 1 → PresentedStatement.{u₁, u₁} n')
    {R : Type u₁} {S : Type u₂} [CommRing R] [IsReduced R] [CommRing S] [Algebra R S]
    (π : MvPolynomial (Fin n) R →ₐ[R] S) (hπ : Function.Surjective π)
    (g : MvPolynomial (Fin n) R) (hgπ : π g = 0) (hex : ∃ v, IsUnit (coeff v g))
    (hall : ∀ v ∈ g.support, IsUnit (coeff v g)) : Dense (goodLocus R S S) := by
  by_cases hS : Subsingleton S
  · exact dense_goodLocus_of_forall isFinitePresentationFreeAway_of_subsingleton
  rw [not_subsingleton_iff_nontrivial] at hS
  have : Nontrivial R := (algebraMap R S).domain_nontrivial
  obtain ⟨v₀, hv₀⟩ := hex
  have hg : g ≠ 0 := fun h => hv₀.ne_zero (by rw [h, coeff_zero])
  cases n with
  | zero =>
    exfalso
    have hC : g = C (coeff v₀ g) := by
      have := eq_C_of_isEmpty g
      rwa [Subsingleton.elim (0 : Fin 0 →₀ ℕ) v₀] at this
    have h0 : IsUnit (0 : S) := by
      rw [← hgπ, hC, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      exact hv₀.map _
    exact not_isUnit_zero h0
  | succ n' =>
    obtain ⟨_, _, _⟩ := exists_finite_of_isUnit_coeff π hπ g hgπ hg hall
    have hA := IH n' rfl R (MvPolynomial (Fin n') R) (AlgHom.id R _) Function.surjective_id
    have hq : ∀ J : Ideal (MvPolynomial (Fin n') R),
        Dense (goodLocus R (MvPolynomial (Fin n') R ⧸ J) (MvPolynomial (Fin n') R ⧸ J)) :=
      fun J => IH n' rfl R _ (Ideal.Quotient.mkₐ R J) Ideal.Quotient.mk_surjective
    exact (dense_goodLocus_of_quotients hA hq S).mono (Set.biUnion_mono
      (fun f hf => isFinitePresentationFreeAway_self_of_algebra hf) fun _ _ => subset_rfl)

open scoped Classical in
/-- **The induction on `m` of Stacks 051Z.** Suppose the kernel of the presentation `π` contains a
polynomial `g` with some unit coefficient, and at most `m` coefficients of `g` which are not
units. Then `U(R → S, S)` is dense. For `m > 0`, pick a coefficient `a` of `g` which is not a
unit; on `D(a)` it becomes a unit, and on the standard opens `D(f)` with `fa = 0` it becomes zero,
so in both cases the number of non-unit coefficients drops. -/
private theorem dense_goodLocus_of_card_le.{u₁, u₂} {n : ℕ}
    (IH : ∀ n', n = n' + 1 → PresentedStatement.{u₁, u₁} n') (m : ℕ) :
    ∀ (R : Type u₁) (S : Type u₂) [CommRing R] [IsReduced R] [CommRing S] [Algebra R S]
      (π : MvPolynomial (Fin n) R →ₐ[R] S), Function.Surjective π →
      ∀ g : MvPolynomial (Fin n) R, π g = 0 → (∃ v, IsUnit (coeff v g)) →
      (g.support.filter fun v => ¬IsUnit (coeff v g)).card ≤ m → Dense (goodLocus R S S) := by
  induction m with
  | zero =>
    intro R S _ _ _ _ π hπ g hgπ hex hm
    refine dense_goodLocus_of_forall_isUnit IH π hπ g hgπ hex fun v hv => ?_
    by_contra hnu
    have : v ∈ g.support.filter fun v => ¬IsUnit (coeff v g) := Finset.mem_filter.mpr ⟨hv, hnu⟩
    rw [Nat.le_zero, Finset.card_eq_zero] at hm
    simp [hm] at this
  | succ m ih =>
    intro R S _ _ _ _ π hπ g hgπ hex hm
    by_cases hall : ∀ v ∈ g.support, IsUnit (coeff v g)
    · exact dense_goodLocus_of_forall_isUnit IH π hπ g hgπ hex hall
    simp only [not_forall] at hall
    obtain ⟨v, hv, hnu⟩ := hall
    refine dense_of_basicOpen_subset_closure _
      (dense_iUnion_basicOpen_union_annihilator {coeff v g}) fun f hf => ?_
    refine basicOpen_subset_closure_of_dense_localization_self f ?_
    obtain ⟨πf, hπf, hcomp⟩ := exists_localized_presentation π hπ f
    set g' := map (algebraMap R (Localization.Away f)) g
    have hunit : ∀ w, IsUnit (coeff w g) → IsUnit (coeff w g') := fun w hw => by
      rw [coeff_map]
      exact hw.map _
    have hv' : v ∉ g'.support.filter fun w => ¬IsUnit (coeff w g') := by
      rw [Finset.mem_filter, mem_support_iff, not_and_or, not_not, not_not]
      rcases hf with hf | hf
      · rw [Set.mem_singleton_iff] at hf
        right
        rw [coeff_map, ← hf]
        exact IsLocalization.Away.algebraMap_isUnit f
      · left
        rw [coeff_map]
        have h0 := congrArg (algebraMap R (Localization.Away f)) (hf (coeff v g) rfl)
        rw [map_mul, map_zero] at h0
        exact (IsLocalization.Away.algebraMap_isUnit f).mul_right_eq_zero.mp h0
    have hsub : (g'.support.filter fun w => ¬IsUnit (coeff w g')) ⊆
        (g.support.filter fun w => ¬IsUnit (coeff w g)).erase v := by
      intro w hw
      refine Finset.mem_erase.mpr ⟨fun h => hv' (h ▸ hw), ?_⟩
      obtain ⟨hw₁, hw₂⟩ := Finset.mem_filter.mp hw
      exact Finset.mem_filter.mpr ⟨support_map_subset _ _ hw₁, fun h => hw₂ (hunit w h)⟩
    have hcard := (Finset.card_le_card hsub).trans_eq
      (Finset.card_erase_of_mem (Finset.mem_filter.mpr ⟨hv, hnu⟩))
    obtain ⟨w₀, hw₀⟩ := hex
    exact ih (Localization.Away f) _ πf hπf g' (by rw [hcomp, hgπ, map_zero])
      ⟨w₀, hunit w₀ hw₀⟩ (by omega)

/-- **The inductive step of Stacks 051Z**, given the statement for fewer variables. Let `I` be the
set of coefficients of the relations of the presentation. On a standard open `D(c)` with `c ∈ I`
some relation acquires a unit coefficient, and the previous lemma applies; on a standard open
`D(f)` with `fI = 0` the presentation has no relations left, so `S_f` is a polynomial ring over
`R_f`. These standard opens have dense union since `R` is reduced. -/
private theorem presentedStatement_of_lt.{u₁, u₂} (n : ℕ)
    (IH : ∀ n', n = n' + 1 → PresentedStatement.{u₁, u₁} n') :
    PresentedStatement.{u₁, u₂} n := by
  intro R S _ _ _ _ π hπ
  set t : Set R := {c | ∃ p ∈ RingHom.ker π, ∃ v, coeff v p = c}
  refine dense_of_basicOpen_subset_closure _ (dense_iUnion_basicOpen_union_annihilator t)
    fun f hf => basicOpen_subset_closure_of_dense_localization_self f ?_
  obtain ⟨πf, hπf, hcomp⟩ := exists_localized_presentation π hπ f
  rcases hf with ⟨p, hp, v, rfl⟩ | hf
  · refine dense_goodLocus_of_card_le IH _ (Localization.Away (coeff v p)) _ πf hπf
      (map (algebraMap R _) p) (by rw [hcomp, RingHom.mem_ker.mp hp, map_zero])
      ⟨v, ?_⟩ le_rfl
    rw [coeff_map]
    exact IsLocalization.Away.algebraMap_isUnit _
  · have hinj := injective_of_mul_coeff_eq_zero π f
      (fun p hp v => hf _ ⟨p, hp, v, rfl⟩) πf hcomp
    exact dense_goodLocus_of_forall
      (isFinitePresentationFreeAway_of_algEquiv (AlgEquiv.ofBijective πf ⟨hinj, hπf⟩))

private theorem presentedStatement_same.{u₁} (n : ℕ) : PresentedStatement.{u₁, u₁} n := by
  induction n with
  | zero => exact presentedStatement_of_lt 0 fun n' h => absurd h (by omega)
  | succ n ih => exact presentedStatement_of_lt (n + 1) fun n' h => (Nat.succ_injective h) ▸ ih

private theorem presentedStatement.{u₁, u₂} (n : ℕ) : PresentedStatement.{u₁, u₂} n :=
  presentedStatement_of_lt n fun n' _ => presentedStatement_same n'

end Induction

namespace Algebra

/-- **Generic freeness over a reduced base, density form.** Let `R` be a reduced ring, `S` a
finite type `R`-algebra and `M` a finite `S`-module. Then the locus `U(R → S, M)` of Stacks 051V,
the union of the standard opens `D(f)` over the `f` satisfying the condition 051U, is dense in
`Spec R`. -/
@[ega "IV 11.4.6" "special case"]
public theorem dense_iUnion_basicOpen_isFinitePresentationFreeAway {R S M : Type*} [CommRing R]
    [IsReduced R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S] [AddCommGroup M]
    [Module S M] [Module.Finite S M] :
    Dense (⋃ f ∈ {f : R | IsFinitePresentationFreeAway R S M f},
      (basicOpen f : Set (PrimeSpectrum R))) := by
  obtain ⟨n, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  refine dense_goodLocus_of_quotients (presentedStatement n R S π hπ) (fun J => ?_) M
  exact presentedStatement n R (S ⧸ J) ((Ideal.Quotient.mkₐ R J).comp π)
    (Ideal.Quotient.mk_surjective.comp hπ)

/-- **Stacks 051Z** (generic flatness over a reduced base). Let `R → S` be a ring map of finite
type with `R` reduced, and let `M` be a finite `S`-module. Then there is an open dense subset
`U ⊆ Spec R` such that every `u ∈ U` lies in a standard open `D(f) ⊆ U` for which `M_f` and `S_f`
are free over `R_f`, `S_f` is a finitely presented `R_f`-algebra and `M_f` is a finitely presented
`S_f`-module. -/
@[stacks 051Z "The four conditions on `f` are the condition of Equation 051U, cited as
`Algebra.IsFinitePresentationFreeAway`; that definition fixes the models of `R_f`, `S_f` and `M_f`,
and `Algebra.isFinitePresentationFreeAway_iff` moves the conclusion to any other models."]
public theorem exists_isOpen_dense_isFinitePresentationFreeAway {R S M : Type*} [CommRing R]
    [IsReduced R] [CommRing S] [Algebra R S] [Algebra.FiniteType R S] [AddCommGroup M]
    [Module S M] [Module.Finite S M] :
    ∃ U : Set (PrimeSpectrum R), IsOpen U ∧ Dense U ∧
      ∀ u ∈ U, ∃ f : R, u ∈ basicOpen f ∧ (basicOpen f : Set (PrimeSpectrum R)) ⊆ U ∧
        IsFinitePresentationFreeAway R S M f := by
  refine ⟨_, isOpen_goodLocus (R := R) (S := S) M,
    dense_iUnion_basicOpen_isFinitePresentationFreeAway, fun u hu => ?_⟩
  obtain ⟨f, hf, huf⟩ := Set.mem_iUnion₂.mp hu
  exact ⟨f, huf, fun q hq => Set.mem_iUnion₂.mpr ⟨f, hf, hq⟩, hf⟩

end Algebra
