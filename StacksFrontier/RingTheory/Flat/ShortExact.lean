/-!
# Ideal multiples of a flat module meet as expected

Let `R` be a commutative ring, let `I, J ⊆ R` be ideals and let `M` be a flat
`R`-module. Then, as `R`-submodules of `M`, `IM ∩ JM = (I ∩ J) M`. This is Stacks
Tag 0BBY.

Here `IM` is the `R`-submodule of `M` generated by `{a • m | a ∈ I, m ∈ M}`,
equivalently the set of finite sums of products of elements of `I` with elements of
`M`. As `R` is commutative there is no distinction between left and right ideals or
modules, so `IM` is unambiguously an `R`-submodule of `M`.

The inclusion `(I ∩ J) M ⊆ IM ∩ JM` holds for every `R`-module, flat or not, since
`I ∩ J` is contained in both `I` and `J`. The reverse inclusion is the substantive one
and is where flatness is used.

## Main results

* `ideal_smul_top_inf`: the equality `IM ∩ JM = (I ∩ J) M`.

## Implementation notes

The submodule `IM` is written `I • (⊤ : Submodule R M)`, Mathlib's scalar action of an
ideal on a submodule; `IM ∩ JM` and `I ∩ J` are the lattice meets `⊓` of submodules
and of ideals. Flatness is the typeclass `Module.Flat R M`.

The hard inclusion is obtained by tensoring the short exact sequence
`0 → I ∩ J → I ⊕ J → I + J → 0` with `M`, which stays exact by flatness. An element of
`IM ∩ JM` gives a pair in `(I ⊗ M) ⊕ (J ⊗ M)` killed by the right-hand map, hence
coming from `(I ∩ J) ⊗ M`, whose image in `M` is `(I ∩ J) M`.
-/

@[expose] public section

open TensorProduct in
/-- The canonical map `K ⊗ M → M`, `a ⊗ m ↦ a • m`, for an ideal `K`.
Its range is `K • ⊤` (Mathlib: `Ideal.subtype_rTensor_range`), and for flat `M` it is
injective (Mathlib: `Module.Flat.iff_rTensor_injective'`). -/
private noncomputable abbrev phiMap {R : Type*} [CommRing R] (K : Ideal R)
    (M : Type*) [AddCommGroup M] [Module R M] :
    TensorProduct R K M →ₗ[R] M :=
  (TensorProduct.lid R M).toLinearMap ∘ₗ LinearMap.rTensor M K.subtype

/-- `phiMap` is compatible with the map induced by an inclusion of ideals `K ≤ L`. -/
private theorem phiMap_rTensor_inclusion {R : Type*} [CommRing R] {K L : Ideal R} (h : K ≤ L)
    (M : Type*) [AddCommGroup M] [Module R M] (x : TensorProduct R K M) :
    phiMap L M (LinearMap.rTensor M (Submodule.inclusion h) x) = phiMap K M x := by
  simp only [phiMap, LinearMap.comp_apply]
  rw [← LinearMap.rTensor_comp_apply]
  congr 1

open TensorProduct in
/-- **Tensored exactness of `0 → I∩J → I⊕J → I+J → 0`.**
If `u ∈ I⊗M` and `v ∈ J⊗M` push to the *same* element of `(I+J)⊗M` along the
respective inclusions `I, J ↪ I+J`, then there is a single `w ∈ (I∩J)⊗M` whose
pushforwards along `I∩J ↪ I` and `I∩J ↪ J` recover `u` and `v` respectively. This is
the consequence of flatness that drives the hard inclusion.

Tensor the short exact sequence
`0 → I∩J --(x ↦ (x,x))--> I⊕J --((a,b) ↦ a-b)--> I+J → 0`
of `R`-modules with the flat module `M`. Flatness keeps it exact, giving
`0 → (I∩J)⊗M → (I⊗M)⊕(J⊗M) → (I+J)⊗M → 0`. The hypothesis says that the element
`(u, v)` of `(I⊗M)⊕(J⊗M)` maps to `ψ_I(u) − ψ_J(v) = 0` in `(I+J)⊗M`, so it lies in
the kernel of the right-hand map; by exactness it is the image of some `w ∈ (I∩J)⊗M`
under the left-hand map `w ↦ (δ_I(w), δ_J(w))`, which says exactly that
`δ_I(w) = u` and `δ_J(w) = v`. -/
private theorem tensor_inf_exact {R : Type*} [CommRing R] (I J : Ideal R)
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Flat R M]
    (u : TensorProduct R I M) (v : TensorProduct R J M)
    (huv : LinearMap.rTensor M (Submodule.inclusion (le_sup_left : I ≤ I ⊔ J)) u
        = LinearMap.rTensor M (Submodule.inclusion (le_sup_right : J ≤ I ⊔ J)) v) :
    ∃ w : TensorProduct R (I ⊓ J : Ideal R) M,
      LinearMap.rTensor M (Submodule.inclusion (inf_le_left : I ⊓ J ≤ I)) w = u ∧
      LinearMap.rTensor M (Submodule.inclusion (inf_le_right : I ⊓ J ≤ J)) w = v := by
  classical
  let f : (I ⊓ J : Ideal R) →ₗ[R] (I × J) :=
    LinearMap.prod (Submodule.inclusion (inf_le_left : I ⊓ J ≤ I))
                   (Submodule.inclusion (inf_le_right : I ⊓ J ≤ J))
  let g : (I × J) →ₗ[R] (I ⊔ J : Ideal R) :=
    (Submodule.inclusion (le_sup_left : I ≤ I ⊔ J)).comp (LinearMap.fst R I J)
      - (Submodule.inclusion (le_sup_right : J ≤ I ⊔ J)).comp (LinearMap.snd R I J)
  have hgf : Function.Exact f g := by
    rw [LinearMap.exact_iff]
    apply le_antisymm
    · rintro ⟨a, b⟩ hab
      simp only [LinearMap.mem_ker, g, LinearMap.sub_apply, LinearMap.comp_apply,
        LinearMap.fst_apply, LinearMap.snd_apply, sub_eq_zero] at hab
      have hval : (a : R) = (b : R) := by simpa using congrArg Subtype.val hab
      refine ⟨⟨(a : R), a.property, hval ▸ b.property⟩, ?_⟩
      simp only [f, LinearMap.prod_apply]
      ext
      · simp [Submodule.inclusion]
      · simp [Submodule.inclusion, hval]
    · rintro _ ⟨x, rfl⟩
      simp only [LinearMap.mem_ker, g, f, LinearMap.sub_apply, LinearMap.comp_apply,
        LinearMap.fst_apply, LinearMap.snd_apply, LinearMap.prod_apply, sub_eq_zero]
      apply Subtype.ext
      simp [Submodule.inclusion]
  have hgfT : Function.Exact (LinearMap.rTensor M f) (LinearMap.rTensor M g) :=
    Module.Flat.rTensor_exact M hgf
  let e := TensorProduct.prodLeft R R (I : Submodule R R) (J : Submodule R R) M
  have hf : e.toLinearMap ∘ₗ (LinearMap.rTensor M f)
      = LinearMap.prod (LinearMap.rTensor M (Submodule.inclusion (inf_le_left : I ⊓ J ≤ I)))
                       (LinearMap.rTensor M (Submodule.inclusion (inf_le_right : I ⊓ J ≤ J))) := by
    ext w <;> simp [e, f, LinearMap.rTensor_tmul, TensorProduct.prodLeft]
  have hg : LinearMap.rTensor M g
      = (LinearMap.rTensor M (Submodule.inclusion (le_sup_left : I ≤ I ⊔ J))) ∘ₗ
          (LinearMap.fst R _ _) ∘ₗ e.toLinearMap
        - (LinearMap.rTensor M (Submodule.inclusion (le_sup_right : J ≤ I ⊔ J))) ∘ₗ
          (LinearMap.snd R _ _) ∘ₗ e.toLinearMap := by
    ext z <;> simp [e, g, LinearMap.rTensor_tmul, TensorProduct.prodLeft, LinearMap.sub_apply]
  set z := e.symm (u, v) with hz
  have hez : e.toLinearMap z = (u, v) := by
    simp only [LinearEquiv.coe_coe, hz, LinearEquiv.apply_symm_apply]
  have hker : LinearMap.rTensor M g z = 0 := by
    rw [hg]
    simp only [LinearMap.sub_apply, LinearMap.comp_apply, hez,
      LinearMap.fst_apply, LinearMap.snd_apply]
    rw [huv, sub_self]
  obtain ⟨w, hw⟩ := (hgfT z).mp hker
  have key : (e.toLinearMap ∘ₗ LinearMap.rTensor M f) w = (u, v) := by
    rw [LinearMap.comp_apply, hw, hez]
  rw [hf] at key
  simp only [LinearMap.prod_apply, Prod.mk.injEq, Function.prod] at key
  exact ⟨w, key.left, key.right⟩

open TensorProduct in
/-- **Hard inclusion** `(I•⊤) ⊓ (J•⊤) ≤ (I⊓J)•⊤`, the part that needs flatness.

Let `x ∈ I•⊤ ⊓ J•⊤`. By `Ideal.subtype_rTensor_range`,
`I•⊤ = range (phiMap I M)` and `J•⊤ = range (phiMap J M)`, so there are `u ∈ I⊗M`,
`v ∈ J⊗M` with `phiMap I M u = x = phiMap J M v`.

Write `K := I + J = I ⊔ J`, with inclusions `ψ_I : I⊗M → K⊗M`, `ψ_J : J⊗M → K⊗M`
(rTensor of the ideal inclusions). Because the inclusions `I,J ↪ K` followed by
`K ↪ R` agree with `I ↪ R`, `J ↪ R`, we have `phiMap K M ∘ ψ_I = phiMap I M` and
`phiMap K M ∘ ψ_J = phiMap J M` (proved by `simp`/`ext`). Hence
`phiMap K M (ψ_I u) = x = phiMap K M (ψ_J v)`.
Flatness makes `phiMap K M` injective (`Module.Flat.iff_rTensor_injective'` gives
`rTensor M K.subtype` injective, and `lid` is an equiv), so `ψ_I u = ψ_J v` in `K⊗M`.
By `tensor_inf_exact` there is `w ∈ (I∩J)⊗M` with `δ_I w = u`, `δ_J w = v`
(where `δ_I, δ_J` are rTensor of `I∩J ↪ I`, `I∩J ↪ J`). Then, again because
`I∩J ↪ I ↪ R` equals `I∩J ↪ R`, `phiMap I M ∘ δ_I = phiMap (I∩J) M`, so
`x = phiMap I M u = phiMap I M (δ_I w) = phiMap (I⊓J) M w ∈ range (phiMap (I⊓J) M) = (I⊓J)•⊤`. ∎ -/
private theorem ideal_smul_top_inf_le {R : Type*} [CommRing R] (I J : Ideal R)
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Flat R M] :
    (I • (⊤ : Submodule R M)) ⊓ (J • (⊤ : Submodule R M)) ≤ (I ⊓ J) • (⊤ : Submodule R M) := by
  intro x hx
  obtain ⟨hxI, hxJ⟩ := Submodule.mem_inf.mp hx
  rw [← Ideal.subtype_rTensor_range M I, LinearMap.mem_range] at hxI
  rw [← Ideal.subtype_rTensor_range M J, LinearMap.mem_range] at hxJ
  obtain ⟨u, hu⟩ := hxI
  obtain ⟨v, hv⟩ := hxJ
  have compI := phiMap_rTensor_inclusion (le_sup_left : I ≤ I ⊔ J) M u
  have compJ := phiMap_rTensor_inclusion (le_sup_right : J ≤ I ⊔ J) M v
  have hinj : Function.Injective (phiMap (I ⊔ J) M) :=
    (TensorProduct.lid R M).injective.comp
      ((Module.Flat.iff_rTensor_injective' (R := R) (M := M)).mp ‹_› (I ⊔ J))
  have heq : LinearMap.rTensor M (Submodule.inclusion (le_sup_left : I ≤ I ⊔ J)) u
      = LinearMap.rTensor M (Submodule.inclusion (le_sup_right : J ≤ I ⊔ J)) v := by
    apply hinj
    rw [compI, compJ, hu, hv]
  obtain ⟨w, hwI, hwJ⟩ := tensor_inf_exact I J M u v heq
  rw [← Ideal.subtype_rTensor_range M (I ⊓ J), LinearMap.mem_range]
  exact ⟨w, by rw [← phiMap_rTensor_inclusion (inf_le_left : I ⊓ J ≤ I) M w, hwI, hu]⟩

/-- Stacks Tag 0BBY: for a flat module `M`, `IM ∩ JM = (I ∩ J) M`. -/
@[stacks 0BBY, ega "0 6.1.3" "second formula"]
theorem ideal_smul_top_inf (R : Type*) [CommRing R] (I J : Ideal R)
    (M : Type*) [AddCommGroup M] [Module R M] [Module.Flat R M] :
    (I • (⊤ : Submodule R M)) ⊓ (J • (⊤ : Submodule R M))
      = (I ⊓ J) • (⊤ : Submodule R M) :=
  -- `≤` needs flatness; `≥` does not, being `I ⊓ J ≤ I` and `I ⊓ J ≤ J`.
  le_antisymm (ideal_smul_top_inf_le I J M)
    (le_inf (Submodule.smul_mono_left inf_le_left) (Submodule.smul_mono_left inf_le_right))

open TensorProduct

/-- Naturality of `lTensor` and `rTensor`. -/
private lemma tensor_naturality
    {R : Type*} [CommSemiring R]
    {A B P Q : Type*}
    [AddCommMonoid A] [AddCommMonoid B] [AddCommMonoid P] [AddCommMonoid Q]
    [Module R A] [Module R B] [Module R P] [Module R Q]
    (u : A →ₗ[R] B) (h : P →ₗ[R] Q) (x : A ⊗[R] P) :
    h.lTensor B (u.rTensor P x) = u.rTensor Q (h.lTensor A x) :=
  LinearMap.congr_fun ((LinearMap.lTensor_comp_rTensor A u h).trans
    (LinearMap.rTensor_comp_lTensor A u h).symm) x

/-- Part 1: In a short exact sequence `0 → M' → M → M'' → 0` of `R`-modules,
if `M'` and `M''` are flat, then `M` is flat. -/
@[stacks 00HM,
  ega "0 6.4.3" "M is flat",
  ega "0 6.1.2" "M' flat implies M flat",
  ega "III 6.5.10" "special case",
  ega "IV 2.1.8" "(ii)", sga "1 IV 1.1" "(ii)"]
theorem flat_of_flat_of_flat
    {R : Type*} [CommRing R]
    {M' M M'' : Type*}
    [AddCommGroup M'] [AddCommGroup M] [AddCommGroup M'']
    [Module R M'] [Module R M] [Module R M'']
    (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Function.Injective f)
    (hfg : Function.Exact f g)
    (hg : Function.Surjective g)
    [Module.Flat R M'] [Module.Flat R M''] :
    Module.Flat R M := by
  refine Module.Flat.iff_rTensor_preserves_injective_linearMap.mpr ?_
  intro A B _ _ _ _ u hu
  rw [injective_iff_map_eq_zero]
  intro x hx
  -- `(g.lTensor A) x = 0` using flatness of `M''`.
  have hgAx : (g.lTensor A) x = 0 :=
    Module.Flat.rTensor_preserves_injective_linearMap (M := M'') u hu <| by
      rw [map_zero, ← tensor_naturality u g x, hx, map_zero]
  -- Exactness of the `lTensor` sequence lifts `x` to `x' : A ⊗[R] M'`.
  obtain ⟨x', hx'⟩ := (lTensor_exact A hfg hg x).mp hgAx
  -- `(u.rTensor M') x' = 0` via injectivity of `f.lTensor B` (from `M''` flat).
  have hux' : (LinearMap.rTensor M' u) x' = 0 :=
    LinearMap.lTensor_injective_of_exact_of_flat g hg f hf hfg B <| by
      rw [map_zero, tensor_naturality u f x', hx', hx]
  -- Flatness of `M'` gives `x' = 0`, hence `x = 0`.
  have hx'_zero : x' = 0 :=
    Module.Flat.rTensor_preserves_injective_linearMap (M := M') u hu
      (by rw [hux', map_zero])
  rw [← hx', hx'_zero, map_zero]

/-- Part 2: In a short exact sequence `0 → M' → M → M'' → 0` of `R`-modules,
if `M` and `M''` are flat, then `M'` is flat. -/
@[stacks 00HM,
  ega "0 20.6.21" "more general",
  ega "0 6.1.2" "M flat implies M' flat",
  ega "IV 2.1.10" "Affine case",
  ega "IV 2.1.8" "(ii)",
  sga "1 IV 1.1" "(ii)",
  sga "4 XVII 4.1.1" "(i), special case",
  sga "6 I 5.1.1" "special case"]
theorem flat_of_flat_of_flat_quotient
    {R : Type*} [CommRing R]
    {M' M M'' : Type*}
    [AddCommGroup M'] [AddCommGroup M] [AddCommGroup M'']
    [Module R M'] [Module R M] [Module R M'']
    (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Function.Injective f)
    (hfg : Function.Exact f g)
    (hg : Function.Surjective g)
    [Module.Flat R M] [Module.Flat R M''] :
    Module.Flat R M' := by
  refine Module.Flat.iff_rTensor_preserves_injective_linearMap.mpr ?_
  intro A B _ _ _ _ u hu
  rw [injective_iff_map_eq_zero]
  intro x hx
  -- `(f.lTensor A) x = 0` via injectivity of `u.rTensor M` (from `M` flat).
  have hfAx : (f.lTensor A) x = 0 :=
    Module.Flat.rTensor_preserves_injective_linearMap (M := M) u hu <| by
      rw [map_zero, ← tensor_naturality u f x, hx, map_zero]
  -- Injectivity of `f.lTensor A` (from `M''` flat) gives `x = 0`.
  exact LinearMap.lTensor_injective_of_exact_of_flat g hg f hf hfg A
    (by rw [hfAx, map_zero])

/-- If `0 → M'' → M' → M → 0` is a short exact sequence of `R`-modules whose quotient
term `M` is flat, then tensoring with an arbitrary `R`-module `N` leaves the sequence
short exact. -/
@[stacks 00HL,
  ega "IV 2.1.8" "(i), affine case",
  ega "0 15.1.17" "more general",
  ega "0 6.1.2",
  sga "1 IV 1.1",
  sga "3 XV 2.10" "partial",
  sga "4 XVII 4.1.1" "(ii), special case"]
theorem flat_tor_zero
    {R : Type*} [CommRing R]
    {M'' M' M N : Type*}
    [AddCommGroup M''] [AddCommGroup M'] [AddCommGroup M] [AddCommGroup N]
    [Module R M''] [Module R M'] [Module R M] [Module R N]
    [Module.Flat R M]
    (f : M'' →ₗ[R] M') (g : M' →ₗ[R] M)
    (hf : Function.Injective f)
    (hfg : Function.Exact f g)
    (hg : Function.Surjective g) :
    Function.Injective (LinearMap.lTensor N f) ∧
    Function.Exact (LinearMap.lTensor N f) (LinearMap.lTensor N g) ∧
    Function.Surjective (LinearMap.lTensor N g) :=
  ⟨LinearMap.lTensor_injective_of_exact_of_flat g hg f hf hfg N,
    lTensor_exact N hfg hg,
    LinearMap.lTensor_surjective N hg⟩

/-- **Flatness of a quotient forces `p A ∩ I = p I`.** Let `A` be an `R`-algebra and `I ⊆ A` an
ideal with `A/I` flat over `R`. For every ideal `p ⊆ R`, an element `∑ aⱼ rⱼ` of `pA`, `rⱼ ∈ p`,
lying in `I` is a relation `∑ rⱼ āⱼ = 0` in `A/I`; by the equational criterion (Lemma 00HK) it is
trivial, `āⱼ = ∑ₖ αⱼₖ ȳₖ` with `∑ⱼ rⱼ αⱼₖ = 0`, and then `∑ aⱼ rⱼ = ∑ rⱼ (aⱼ - ∑ₖ αⱼₖ yₖ) ∈ pI`. -/
theorem Ideal.map_inf_le_map_mul_of_flat {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (p : Ideal R) (I : Ideal A) [Module.Flat R (A ⧸ I)] :
    p.map (algebraMap R A) ⊓ I ≤ p.map (algebraMap R A) * I := by
  rintro z ⟨hz, hzI⟩
  rw [SetLike.mem_coe, Ideal.map, Ideal.span, Submodule.mem_span_set'] at hz
  obtain ⟨n, a, g, rfl⟩ := hz
  choose r hr hrg using fun j ↦ (g j).2
  have hsum : ∑ j, r j • Ideal.Quotient.mk I (a j) = 0 := by
    rw [← Ideal.Quotient.eq_zero_iff_mem.2 hzI, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, ← map_mul, smul_eq_mul, ← hrg j,
      mul_comm]
  obtain ⟨k, α, y, hy, hα⟩ :=
    Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := R) (M := A ⧸ I) hsum
  choose y' hy' using fun l ↦ Ideal.Quotient.mk_surjective (y l)
  have ht : ∀ j, a j - ∑ l, algebraMap R A (α j l) * y' l ∈ I := fun j ↦ by
    have hyj : Ideal.Quotient.mk I (a j) = ∑ l, α j l • y l := hy j
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sum, hyj, sub_eq_zero]
    refine Finset.sum_congr rfl fun l _ ↦ ?_
    rw [map_mul, Ideal.Quotient.mk_algebraMap, hy', Algebra.smul_def]
  have hz : ∑ j, a j • (g j : A) =
      ∑ j, algebraMap R A (r j) * (a j - ∑ l, algebraMap R A (α j l) * y' l) := by
    have h0 : ∑ j, algebraMap R A (r j) * ∑ l, algebraMap R A (α j l) * y' l = 0 := by
      simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
      rw [Finset.sum_comm]
      simp_rw [← Finset.sum_mul, ← map_sum, hα, map_zero, zero_mul, Finset.sum_const_zero]
    simp_rw [mul_sub, Finset.sum_sub_distrib, h0, sub_zero, smul_eq_mul, ← hrg, mul_comm]
  rw [hz]
  exact Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ (hr j)) (ht j)
