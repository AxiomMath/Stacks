module

public import Mathlib.Algebra.Algebra.Subalgebra.Directed
public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.Algebra.MvPolynomial.Cardinal
public import Mathlib.Algebra.Order.Ring.Star
public import Mathlib.Order.CompletePartialOrder
public import Mathlib.RingTheory.Flat.EquationalCriterion
public import Mathlib.RingTheory.Flat.FaithfullyFlat.Basic

/-!
# Constructing flat ring maps

Fix a commutative ring `A` and a commutative `A`-algebra `B`. Set
`κ = max (#A) ℵ₀`, the maximum of the cardinality of (the underlying set of) `A`
and the first infinite cardinal `ℵ₀`.

If `B` is a flat `A`-algebra, then `B` is the filtered colimit of its flat
`A`-subalgebras `B' ⊆ B` of cardinality `#B' ≤ κ`. The concrete content of this
"filtered colimit" statement is:

1. (Directedness) The family `F` of flat subalgebras of cardinality `≤ κ` is
   directed under inclusion.
2. (Covering) Every element of `B` lies in some member of `F`; equivalently the
   supremum (union) of the family is all of `B`.

The crux of the proof is:

3. (Key lemma) Every `A`-subalgebra `E ⊆ B` with `#E ≤ κ` is contained in a flat
   `A`-subalgebra `B' ⊆ B` with `#B' ≤ κ`.

The converse of (1) and (2) is also proved here: if *any* directed family of
`A`-subalgebras of `B` consists of flat subalgebras and has supremum `B`, then
`B` is flat over `A`.

## Implementation notes

`A` and `B` are kept in the same universe `u` so that their cardinalities can be
compared directly, avoiding `Cardinal.lift`.

The converse uses the equational criterion for flatness rather than the
direct-limit results of `StacksFrontier.RingTheory.Flat.DirectLimit`
(`Stacks.Flatness.colimit_flat_of_flat`, Stacks 05UT): those are stated for a
`Module.DirectLimit` over a directed *preorder* carrying a `DirectedSystem`,
whereas a directed family of subalgebras is indexed by a bare type and its union
is `B` on the nose, so the criterion is the shorter route and needs no transport
along a presentation of `B` as a colimit.
-/

@[expose] public section

namespace Stacks.Flatness.SmallSubalgebras

universe u

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- The cardinal `κ = max (#A) ℵ₀`, where `#A` is the cardinality of `A`. -/
noncomputable def kappa (A : Type u) [CommRing A] : Cardinal.{u} :=
  max (Cardinal.mk A) Cardinal.aleph0

/-- The family `F` of flat `A`-subalgebras of `B` of cardinality `≤ κ`. -/
def flatSmallSubalgebras (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] :
    Set (Subalgebra A B) :=
  {B' | Module.Flat A B' ∧ Cardinal.mk B' ≤ kappa A}

/-- The cardinality of an `A`-subalgebra generated by a set `S` is bounded by
`max (max #A #S) ℵ₀`. -/
theorem card_adjoin_le (S : Set B) :
    Cardinal.mk (Algebra.adjoin A S) ≤
      max (max (Cardinal.mk A) (Cardinal.mk S)) Cardinal.aleph0 := by
  rw [Algebra.adjoin_eq_range]
  exact Cardinal.mk_range_le.trans (MvPolynomial.cardinalMk_le_max (σ := S) (R := A))

/-- `kappa A` is infinite. -/
theorem aleph0_le_kappa : Cardinal.aleph0 ≤ kappa A := le_max_right _ _

/-- `#A ≤ kappa A`. -/
theorem card_le_kappa : Cardinal.mk A ≤ kappa A := le_max_left _ _

/-- If `S` has cardinality `≤ κ`, then so does the subalgebra it generates. -/
theorem card_adjoin_le_kappa (S : Set B) (hS : Cardinal.mk S ≤ kappa A) :
    Cardinal.mk (Algebra.adjoin A S) ≤ kappa A :=
  (card_adjoin_le S).trans (max_le (max_le card_le_kappa hS) aleph0_le_kappa)

-- Key lemma support: the equational criterion of flatness (Stacks 00HK) is
-- `Module.Flat.iff_forall_isTrivialRelation`:
--   `Flat A M ↔ ∀ {l} {f : Fin l → A} {x : Fin l → M}, ∑ i, f i • x i = 0 →
--      Module.IsTrivialRelation f x`
-- where `Module.IsTrivialRelation f x` unfolds to
--   `∃ k (a : Fin l → Fin k → A) (y : Fin k → M),
--      (∀ i, x i = ∑ j, a i j • y j) ∧ (∀ j, ∑ i, f i * a i j = 0)`.
-- The whole key lemma is the standard Stacks "countable saturation" argument:
-- close `E` under trivializing data for all its `A`-linear relations, iterate
-- ω-many times, and take the union; the union is flat by the criterion and has
-- cardinality `≤ κ` by infinite-cardinal absorption.

/-- Upward transport of triviality: triviality of a finite `A`-linear
relation is preserved by the inclusion of subalgebras `C ≤ C'`: if the relation
`(f, x)` (with `x` landing in `C`, viewed inside `C'` via `Subalgebra.inclusion`)
is `IsTrivialRelation` in `C`, then its image in `C'` is `IsTrivialRelation`.

Proof outline: `IsTrivialRelation f x` gives `k`, `a : Fin l → Fin k → A` and
`y : Fin k → C` with `x i = ∑ j a i j • y j` and `∑ i f i * a i j = 0`. Apply the
`A`-algebra map `ι := Subalgebra.inclusion h : C →ₐ[A] C'`. Since `ι` is
`A`-linear it commutes with `•` and finite sums, so `ι (x i) = ∑ j a i j • ι (y j)`
with witnesses `ι ∘ y : Fin k → C'`; the scalar equations `∑ i f i * a i j = 0`
are unchanged (they live in `A`). Hence the same `k, a, ι ∘ y` witness triviality
in `C'`. This is purely functorial; `map_sum`, `map_smul`, `map_zero` close it. -/
theorem isTrivialRelation_inclusion {C C' : Subalgebra A B} (h : C ≤ C')
    {l : ℕ} {f : Fin l → A} {x : Fin l → C}
    (htriv : Module.IsTrivialRelation f x) :
    Module.IsTrivialRelation f (fun i => Subalgebra.inclusion h (x i)) := by
  obtain ⟨k, a, y, hx, hf⟩ := htriv
  refine ⟨k, a, fun j => Subalgebra.inclusion h (y j), ?_, hf⟩
  intro i
  simp only [hx i, map_sum, map_smul]

/-- One-step saturation: given a subalgebra `C` with `#C ≤ κ`, there is
a larger subalgebra `next C ⊇ C` with `#(next C) ≤ κ` such that **every** finite
`A`-linear relation `∑ i, f i • (x i) = 0` among elements `x : Fin l → C` (the
sum taken in `C`, equivalently in `B`) becomes `IsTrivialRelation` once its
elements are viewed inside `next C`.

Proof outline (the cardinality crux): index the set `R` of all such
relations over `C`. A relation is the data `(l, f, x)` with `l : ℕ`,
`f : Fin l → A`, `x : Fin l → C` satisfying `∑ i, f i • x i = 0`. By flatness of
`B` (criterion `iff_forall_isTrivialRelation`, applied to the relation pushed
into `B` via `C ↪ B`, which still sums to `0`), each such relation is trivial in
`B`: there are `k`, `a`, and witnesses `y : Fin k → B`. Choose such witnesses for
every relation (axiom of choice over `R`), and collect ALL chosen `y`-elements
into a set `W ⊆ B`. Put `next C := Algebra.adjoin A (↑C ∪ W)`.

Then `C ≤ next C` (since `↑C ⊆ ↑C ∪ W ⊆ adjoin`), and the chosen witnesses for
each relation lie in `next C`, so by the criterion's definition each relation is
`IsTrivialRelation` when viewed in `next C` (the witnesses `y j` are now members
of `next C`, the equations `x i = ∑ j a i j • y j` and `∑ i f i * a i j = 0` are
the same). For the CARDINALITY bound: `#R ≤ κ`. Indeed a relation is determined
by `l : ℕ`, `f : Fin l → A` and `x : Fin l → C`; the number of finite tuples over
sets of size `≤ κ` is `≤ κ` since `κ` is infinite and `≥ #A` (and `#C ≤ κ`):
`#(Σ l, (Fin l → A) × (Fin l → C)) ≤ ℵ₀ * κ = κ` (using `card_le_kappa`,
`aleph0_le_kappa`, `Cardinal.mk_finsupp`/`Cardinal.mk_arrow`-style bounds and
`Cardinal.mul_eq_self`). Each relation contributes `k`-many witnesses with
`k : ℕ` finite, so `#W ≤ κ * ℵ₀ = κ`. Hence `#(↑C ∪ W) ≤ κ` and
`#(next C) ≤ κ` by `card_adjoin_le_kappa`. -/
theorem exists_saturated_step (hB : Module.Flat A B) (C : Subalgebra A B)
    (hC : Cardinal.mk C ≤ kappa A) :
    ∃ (C' : Subalgebra A B) (hCC' : C ≤ C'), Cardinal.mk C' ≤ kappa A ∧
      ∀ {l : ℕ} {f : Fin l → A} {x : Fin l → C}, ∑ i, f i • (x i : B) = 0 →
        Module.IsTrivialRelation f (fun i => Subalgebra.inclusion hCC' (x i)) := by
  classical
  -- The relation index type: all finite `A`-linear relations over `C`.
  set R := Σ l : ℕ,
    {p : (Fin l → A) × (Fin l → C) // ∑ i, p.fst i • ((p.snd i : C) : B) = 0}
    with hR
  -- For each relation, flatness of `B` gives trivializing data in `B`.
  have key : ∀ r : R,
      Module.IsTrivialRelation r.snd.val.fst (fun i => ((r.snd.val.snd i : C) : B)) :=
    fun r => Module.Flat.iff_forall_isTrivialRelation.mp hB r.snd.property
  -- Choose the witnesses for every relation.
  let kk : R → ℕ := fun r => (key r).choose
  let aa : ∀ r : R, Fin r.fst → Fin (kk r) → A := fun r => (key r).choose_spec.choose
  let yy : ∀ r : R, Fin (kk r) → B := fun r => (key r).choose_spec.choose_spec.choose
  have hyy : ∀ r : R, (∀ i, ((r.snd.val.snd i : C) : B) = ∑ j, aa r i j • yy r j) ∧
      (∀ j, ∑ i, r.snd.val.fst i * aa r i j = 0) :=
    fun r => (key r).choose_spec.choose_spec.choose_spec
  -- Cardinality of the relation index type.
  have hRcard : Cardinal.mk R ≤ kappa A := by
    have h1 : Cardinal.mk R ≤
        Cardinal.sum (fun l : ℕ => Cardinal.mk ((Fin l → A) × (Fin l → C))) := by
      rw [hR, Cardinal.mk_sigma]
      exact Cardinal.sum_le_sum _ _ (fun l => Cardinal.mk_subtype_le _)
    refine le_trans h1 ?_
    have hsummand : ∀ l : ℕ, Cardinal.mk ((Fin l → A) × (Fin l → C)) ≤ kappa A := by
      intro l
      rw [Cardinal.mk_prod]
      have hA : Cardinal.mk (Fin l → A) ≤ kappa A := by
        have e : Cardinal.mk (Fin l → A) = (Cardinal.mk A) ^ (l : ℕ) := by
          rw [Cardinal.mk_arrow]; simp
        rw [e]
        calc (Cardinal.mk A) ^ (l : ℕ) ≤ (kappa A) ^ (l : ℕ) :=
              pow_le_pow_left' card_le_kappa l
          _ ≤ kappa A := Cardinal.power_nat_le aleph0_le_kappa
      have hC' : Cardinal.mk (Fin l → C) ≤ kappa A := by
        have e : Cardinal.mk (Fin l → C) = (Cardinal.mk C) ^ (l : ℕ) := by
          rw [Cardinal.mk_arrow]; simp
        rw [e]
        calc (Cardinal.mk C) ^ (l : ℕ) ≤ (kappa A) ^ (l : ℕ) :=
              pow_le_pow_left' hC l
          _ ≤ kappa A := Cardinal.power_nat_le aleph0_le_kappa
      calc Cardinal.lift.{u, u} (Cardinal.mk (Fin l → A)) *
              Cardinal.lift.{u, u} (Cardinal.mk (Fin l → C))
          ≤ kappa A * kappa A := by
            rw [Cardinal.lift_id, Cardinal.lift_id]; exact mul_le_mul' hA hC'
        _ = kappa A := Cardinal.mul_eq_self aleph0_le_kappa
    refine le_trans (Cardinal.sum_le_sum _ (fun _ => kappa A) hsummand) ?_
    rw [Cardinal.sum_const, Cardinal.mk_eq_aleph0, Cardinal.lift_aleph0, Cardinal.lift_id']
    exact le_of_eq (Cardinal.aleph0_mul_eq aleph0_le_kappa)
  -- The witness set `W ⊆ B`.
  set W : Set B := Set.range (fun q : Σ r : R, Fin (kk r) => yy q.fst q.snd)
  -- The new subalgebra `C' = adjoin A (↑C ∪ W)`.
  refine ⟨Algebra.adjoin A ((C : Set B) ∪ W), fun _ hb => Algebra.subset_adjoin (Or.inl hb),
    ?_, ?_⟩
  · -- Cardinality `#C' ≤ κ`.
    have hWcard : Cardinal.mk W ≤ kappa A := by
      refine le_trans (Cardinal.mk_range_le) ?_
      have hinj : Function.Injective
          (fun q : (r : R) × Fin (kk r) => (q.fst, (q.snd : ℕ))) := by
        rintro ⟨r1, j1⟩ ⟨r2, j2⟩ h
        simp only [Prod.mk.injEq] at h
        obtain ⟨rfl, h2⟩ := h
        simp only [Sigma.mk.injEq, heq_eq_eq, true_and]
        exact Fin.ext h2
      refine le_trans (Cardinal.mk_le_of_injective hinj) ?_
      rw [Cardinal.mk_prod]
      simp only [Cardinal.mk_eq_aleph0, Cardinal.lift_aleph0]
      rw [Cardinal.lift_id']
      exact (mul_le_mul' hRcard aleph0_le_kappa).trans (Cardinal.mul_eq_self aleph0_le_kappa).le
    exact card_adjoin_le_kappa _ ((Cardinal.mk_union_le _ _).trans
      ((add_le_add hC hWcard).trans (Cardinal.add_eq_self aleph0_le_kappa).le))
  · -- Saturation property.
    intro l f x hsum
    set r : R := ⟨l, ⟨(f, x), hsum⟩⟩
    refine ⟨kk r, aa r, fun j => ⟨yy r j, Algebra.subset_adjoin (Or.inr ⟨⟨r, j⟩, rfl⟩)⟩, ?_,
      (hyy r).right⟩
    intro i
    apply Subtype.ext
    push_cast
    change ((x i : C) : B) = _
    rw [(hyy r).left i]

/-- Key lemma: every `A`-subalgebra `E ⊆ B` with `#E ≤ κ` is contained in a flat
`A`-subalgebra `B' ⊆ B` with `#B' ≤ κ`.

Proof outline: build the saturation chain and take its union.

Step 1 (chain). Using `exists_saturated_step` and dependent choice, build a
sequence `g : ℕ → {C : Subalgebra A B // #C ≤ κ}` with `g 0 = ⟨E, hE⟩` and
`g (n+1)` the saturated step of `g n`. Write `S n := (g n).val`. By construction
`S` is monotone (`S n ≤ S (n+1)` from the step's `hCC'`), each `#(S n) ≤ κ`, and
the step's saturation property holds: every relation among elements of `S n`,
viewed in `S (n+1)`, is `IsTrivialRelation`.

Step 2 (the limit). Set `B' := iSup S` (a `Subalgebra A B`). Then:
  • `E ≤ B'`: `E = S 0 ≤ iSup S` by `le_iSup`.
  • `#B' ≤ κ`: `B'` is the union/`iSup` of the chain, a countable family of
    subalgebras each of cardinality `≤ κ`. Its underlying set is contained in
    `⋃ n, (S n : Set B)`, so `#B' ≤ ∑ₙ #(S n) ≤ ℵ₀ * κ = κ` using
    `Cardinal.mk_iUnion_le`/`Cardinal.mk_iUnion_le_sum_mk`, `aleph0_le_kappa`,
    `Cardinal.aleph0_mul_eq`/`Cardinal.mul_eq_self`.
  • `Module.Flat A B'`: by the criterion `iff_forall_isTrivialRelation`. Given a
    relation `∑ i, f i • x i = 0` with `x : Fin l → B'`, each `x i` lies in some
    `S (n i)`; the chain is directed so all `x i` lie in a common `S N`
    (`N := max over i of n i`, monotonicity). Pull the relation back to `S N`
    (the inclusion `S N ↪ B'` is injective `A`-linear so the sum is `0` already
    in `S N`). By the saturation property of the `N`-th step, the relation is
    `IsTrivialRelation` in `S (N+1)`; transport that up to `B'` via
    `isTrivialRelation_inclusion` along `S (N+1) ≤ B'`. -/
theorem exists_flat_subalgebra_le_kappa
    (hB : Module.Flat A B)
    (E : Subalgebra A B) (hE : Cardinal.mk E ≤ kappa A) :
    ∃ B' : Subalgebra A B, E ≤ B' ∧ Module.Flat A B' ∧ Cardinal.mk B' ≤ kappa A := by
  -- Step 1: build the saturation chain `g : ℕ → {C // #C ≤ κ}`.
  classical
  -- `nextSub C hC` is the saturated step `C'` from `exists_saturated_step`.
  let nextSub : ∀ (C : Subalgebra A B), Cardinal.mk C ≤ kappa A → Subalgebra A B :=
    fun C hC => (exists_saturated_step hB C hC).choose
  -- Its cardinality bound, used to keep iterating.
  have nextSub_card : ∀ (C : Subalgebra A B) (hC : Cardinal.mk C ≤ kappa A),
      Cardinal.mk (nextSub C hC) ≤ kappa A :=
    fun C hC => (exists_saturated_step hB C hC).choose_spec.2.1
  -- The packaged chain: `g n = ⟨S n, #(S n) ≤ κ⟩`.
  let g : ℕ → {C : Subalgebra A B // Cardinal.mk C ≤ kappa A} :=
    fun n => Nat.rec ⟨E, hE⟩
      (fun _ p => ⟨nextSub p.val p.property, nextSub_card p.val p.property⟩) n
  set S : ℕ → Subalgebra A B := fun n => (g n).val with hS
  -- Each `#(S n) ≤ κ`.
  have hScard : ∀ n, Cardinal.mk (S n) ≤ kappa A := fun n => (g n).property
  -- Monotonicity of the chain: `S n ≤ S (n+1)`.
  have hmono_step : ∀ n, S n ≤ S (n + 1) :=
    fun n => (exists_saturated_step hB (S n) (hScard n)).choose_spec.1
  have hmono : Monotone S := monotone_nat_of_le_succ hmono_step
  -- The saturation property at step `n`: every relation among elements of `S n`,
  -- viewed in `S (n+1)`, is `IsTrivialRelation`.
  have hsat : ∀ (n : ℕ) {l : ℕ} {f : Fin l → A} {x : Fin l → S n},
      ∑ i, f i • (x i : B) = 0 →
      Module.IsTrivialRelation f (fun i => Subalgebra.inclusion (hmono_step n) (x i)) := by
    -- From the step's third component, modulo identifying `S (n+1)` with the
    -- chosen `C'` and the two inclusion witnesses (proof-irrelevant up to ≤).
    intro n l f x hrel
    exact (exists_saturated_step hB (S n) (hScard n)).choose_spec.2.2 hrel
  -- Step 2: the limit `B' := iSup S`.
  refine ⟨iSup S, ?_, ?_, ?_⟩
  · exact le_iSup S 0
  · -- Flatness of the limit via the criterion + directedness + L1/L2.
    -- SUB-LEMMA `flat_iSup`: rewrite via `Module.Flat.iff_forall_isTrivialRelation`;
    -- a relation among `x : Fin l → iSup S` has all `x i` in some `S (n i)`, hence
    -- (monotone chain) in a common `S N`; the relation holds in `S N`; by `hsat N`
    -- it is trivial in `S (N+1) ≤ iSup S`; transport up via `isTrivialRelation_inclusion`.
    have hdir : Directed (· ≤ ·) S := hmono.directed_le
    -- Set equality for the directed union, used to locate each `x i`.
    have hcoe : ((iSup S : Subalgebra A B) : Set B) = ⋃ n, ((S n : Subalgebra A B) : Set B) :=
      Subalgebra.coe_iSup_of_directed hdir
    rw [Module.Flat.iff_forall_isTrivialRelation]
    intro l f x hsum
    -- Each `x i` lies in some `S (n i)`.
    have hmem : ∀ i : Fin l, ∃ n, (x i : B) ∈ S n := by
      intro i
      have hb : (x i : B) ∈ ((iSup S : Subalgebra A B) : Set B) := (x i).property
      rw [hcoe] at hb
      simpa using hb
    choose n hn using hmem
    -- A common index `N` containing all `x i`.
    obtain ⟨N, hN⟩ := Finset.exists_le (Finset.univ.image n)
    have hxN : ∀ i : Fin l, (x i : B) ∈ S N := by
      intro i
      have : n i ≤ N := hN (n i) (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)
      exact hmono this (hn i)
    -- Build `x' : Fin l → S N`.
    let x' : Fin l → S N := fun i => ⟨(x i : B), hxN i⟩
    have hsumB : ∑ i, f i • (x i : B) = 0 := by
      have h := congrArg (iSup S).subtype hsum
      rw [map_sum, map_zero] at h
      exact h
    have hfin := isTrivialRelation_inclusion (le_iSup S (N + 1)) (hsat N (x := x') hsumB)
    have heq : (fun i => Subalgebra.inclusion (le_iSup S (N + 1))
        (Subalgebra.inclusion (hmono_step N) (x' i))) = x := by
      funext i
      apply Subtype.ext
      rfl
    rwa [heq] at hfin
  · -- Cardinality of the countable union of `≤ κ` subalgebras is `≤ κ`.
    -- SUB-LEMMA `card_iSup`: `(iSup S : Set B) = ⋃ n, (S n : Set B)` (directed sup
    -- of subalgebras), so `#(iSup S) ≤ Σ n, #(S n) ≤ ℵ₀ * κ = κ`.
    have hdir : Directed (· ≤ ·) S := hmono.directed_le
    have hcoe : ((iSup S : Subalgebra A B) : Set B) = ⋃ n, ((S n : Subalgebra A B) : Set B) :=
      Subalgebra.coe_iSup_of_directed hdir
    have hle : Cardinal.mk ((iSup S : Subalgebra A B) : Set B) ≤ kappa A := by
      rw [hcoe]
      -- Reindex over `ULift ℕ` (same universe `u` as `B`) so the union/sum lemmas apply.
      have hre : (⋃ m : ULift.{u} ℕ, ((S m.down : Subalgebra A B) : Set B))
          = ⋃ n : ℕ, ((S n : Subalgebra A B) : Set B) :=
        Set.iUnion_congr_of_surjective ULift.down
          (fun n => ⟨ULift.up n, rfl⟩) (fun m => rfl)
      rw [← hre]
      refine le_trans Cardinal.mk_iUnion_le_sum_mk ?_
      refine le_trans (Cardinal.sum_le_sum _ (fun _ => kappa A) (fun m => hScard m.down)) ?_
      rw [Cardinal.sum_const]
      have h1 : Cardinal.mk (ULift.{u} ℕ) = Cardinal.aleph0 := by simp
      rw [h1, Cardinal.lift_aleph0, Cardinal.lift_id]
      exact le_of_eq (Cardinal.aleph0_mul_eq aleph0_le_kappa)
    exact hle

/-- **(Directedness).** The family `F` of flat `A`-subalgebras of cardinality
`≤ κ` is directed under inclusion. -/
@[stacks 0GIL]
theorem directedOn_flatSmallSubalgebras
    (hB : Module.Flat A B) :
    DirectedOn (· ≤ ·) (flatSmallSubalgebras A B) := by
  intro B₁ hB₁ B₂ hB₂
  -- Take `E = B₁ ⊔ B₂` which has cardinality `≤ κ`, then apply the key lemma.
  have h₁ : Cardinal.mk (B₁ : Set B) ≤ kappa A := hB₁.2
  have h₂ : Cardinal.mk (B₂ : Set B) ≤ kappa A := hB₂.2
  obtain ⟨B', hEB', hflat, hcard⟩ := exists_flat_subalgebra_le_kappa hB
    (Algebra.adjoin A ((B₁ : Set B) ∪ (B₂ : Set B)))
    (card_adjoin_le_kappa _ ((Cardinal.mk_union_le _ _).trans
      ((add_le_add h₁ h₂).trans (Cardinal.add_eq_self aleph0_le_kappa).le)))
  exact ⟨B', ⟨hflat, hcard⟩, fun _ hx => hEB' (Algebra.subset_adjoin (Or.inl hx)),
    fun _ hx => hEB' (Algebra.subset_adjoin (Or.inr hx))⟩

/-- **(Covering).** Every element of `B` lies in some member of `F`. -/
theorem covering_flatSmallSubalgebras
    (hB : Module.Flat A B) (b : B) :
    ∃ B' ∈ flatSmallSubalgebras A B, b ∈ B' := by
  -- `E = adjoin A {b}` has cardinality `≤ κ`.
  have hcard : Cardinal.mk (Algebra.adjoin A ({b} : Set B)) ≤ kappa A := by
    apply card_adjoin_le_kappa
    refine le_trans ?_ aleph0_le_kappa
    simp
  obtain ⟨B', hEB', hflat, hcard'⟩ :=
    exists_flat_subalgebra_le_kappa hB (Algebra.adjoin A ({b} : Set B)) hcard
  exact ⟨B', ⟨hflat, hcard'⟩, hEB' (Algebra.subset_adjoin (Set.mem_singleton b))⟩

/-- **(Covering, supremum form).** The supremum (union) of the family `F` is all
of `B`. -/
@[stacks 0GIL]
theorem sSup_flatSmallSubalgebras
    (hB : Module.Flat A B) :
    sSup (flatSmallSubalgebras A B) = ⊤ := by
  rw [eq_top_iff]
  intro b _
  obtain ⟨B', hB'mem, hbB'⟩ := covering_flatSmallSubalgebras hB b
  exact (le_sSup hB'mem) hbB'

/-- **(Corollary / remark).** Any member of `F` is faithfully flat over `A`
whenever `B` is faithfully flat over `A`. -/
@[stacks 0GIL]
theorem faithfullyFlat_of_mem
    (hB : Module.FaithfullyFlat A B)
    (B' : Subalgebra A B) (hB' : B' ∈ flatSmallSubalgebras A B) :
    Module.FaithfullyFlat A B' := by
  rw [Module.FaithfullyFlat.iff_flat_and_proper_ideal]
  refine ⟨hB'.1, fun I hI => ?_⟩
  rw [Module.FaithfullyFlat.iff_flat_and_proper_ideal] at hB
  have hBI := hB.2 I hI
  rw [Ideal.smul_top_eq_map] at hBI ⊢
  intro hcontra
  apply hBI
  rw [Submodule.restrictScalars_eq_top_iff] at hcontra ⊢
  have key : (Ideal.map (algebraMap A B) I)
      = Ideal.map (B'.val.toRingHom) (Ideal.map (algebraMap A B') I) := by
    rw [Ideal.map_map]
    congr 1
  rw [key, hcontra, Ideal.map_top]

end Stacks.Flatness.SmallSubalgebras

namespace Stacks.Flatness

open SmallSubalgebras

universe u

/-- **A directed union of flat subalgebras is flat.** If `C : ι → Subalgebra A B` is a directed
family of `A`-subalgebras, each flat as an `A`-module, whose supremum is all of `B`, then `B`
is flat over `A`.

This is the converse of `Stacks.Flatness.SmallSubalgebras.directedOn_flatSmallSubalgebras`
together with `Stacks.Flatness.SmallSubalgebras.sSup_flatSmallSubalgebras`, and it is proved by
the equational criterion: a finite relation among elements of `B` has all of its terms in a
single `C N` by directedness, is trivial there by flatness of `C N`, and triviality is carried
along the inclusion `C N ⊆ B`. -/
theorem flat_of_directed_of_iSup_eq_top {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {ι : Type*} [Nonempty ι] (C : ι → Subalgebra A B) (hdir : Directed (· ≤ ·) C)
    (hflat : ∀ i, Module.Flat A (C i)) (htop : iSup C = ⊤) :
    Module.Flat A B := by
  classical
  have htopFlat : Module.Flat A (⊤ : Subalgebra A B) := by
    rw [Module.Flat.iff_forall_isTrivialRelation]
    intro l f x hsum
    have hmem : ∀ i : Fin l, ∃ j, (x i : B) ∈ C j := by
      intro i
      have hx : (x i : B) ∈ ((iSup C : Subalgebra A B) : Set B) := by
        rw [htop]; trivial
      rw [Subalgebra.coe_iSup_of_directed hdir] at hx
      simpa using hx
    choose j hj using hmem
    obtain ⟨N, hN⟩ := hdir.finset_le (Finset.univ.image j)
    have hxN : ∀ i : Fin l, (x i : B) ∈ C N := fun i =>
      hN (j i) (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩) (hj i)
    let x' : Fin l → C N := fun i => ⟨x i, hxN i⟩
    have hsum' : ∑ i, f i • x' i = 0 := by
      apply Subtype.ext
      push_cast
      have hz := congrArg (fun z : (⊤ : Subalgebra A B) => (z : B)) hsum
      push_cast at hz
      simpa using hz
    have htriv := isTrivialRelation_inclusion (le_top : C N ≤ ⊤)
      (Module.Flat.iff_forall_isTrivialRelation.mp (hflat N) hsum')
    have heq : (fun i => Subalgebra.inclusion (le_top : C N ≤ ⊤) (x' i)) = x := by
      funext i
      apply Subtype.ext
      rfl
    rwa [heq] at htriv
  exact Module.Flat.of_linearEquiv (Subalgebra.topEquiv (R := A) (A := B)).symm.toLinearEquiv

end Stacks.Flatness
