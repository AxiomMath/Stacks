module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.FirstOrderThickeningConormalConverse

/-!
# Flatness over the dual numbers of an extension with ideal generated by `ε`

Let `k` be a field and `k[ε] = k ⊕ kε` the dual numbers. Let `ψ : k[ε] → C` be a ring map and
`π : C → D` a surjection whose kernel is identified with `D` by an additive injection
`incl : D → C`, such that multiplication by `ψ(ε)` is `c ↦ incl(π c)`. This is what a first
order deformation over `k[ε]` of a ring `D` looks like when its ideal is `D ⊗_k kε`. Then `C` is
flat over `k[ε]` and the kernel of `π` is generated by `ε`.

This is the affine case of Stacks 063Y, (2) ⟹ (1), at `k ⊂ k[ε]`
(`Stacks.Thickenings.flat_and_ker_eq_of_extendScalars_chart`): the canonical map
`D ⊗_k kε ⟶ Ker(π)` is `d ⊗ ε ↦ incl(d)`, a bijection.

## Main results

* `Stacks.Thickenings.flat_and_ker_eq_of_dualNumbers`.

## References

* [Stacks Project, Tag 063Y](https://stacks.math.columbia.edu/tag/063Y)
-/

@[expose] public section

open TensorProduct

universe u

namespace Stacks.Thickenings

variable {k C D : Type u} [Field k] [CommRing C] [CommRing D]

/-- An ideal whose elements multiply to zero pairwise has zero square. -/
private theorem sq_eq_bot_of_mul_eq_zero {R : Type*} [CommRing R] (I : Ideal R)
    (h : ∀ r ∈ I, ∀ s ∈ I, r * s = 0) : I ^ 2 = ⊥ := by
  rw [eq_bot_iff, pow_two, Ideal.mul_le]
  exact h

/-- **An extension with ideal `D · ε` is flat over the dual numbers.** Let `ψ : k[ε] → C`, let
`π : C → D` be surjective, and let `incl : D → C` be an additive injection onto the kernel of
`π` with `ψ(ε) · c = incl(π c)` and `incl(d) · incl(d') = 0`. Then `ψ` is flat and
`Ker(π)` is generated by the image of `Ker(k[ε] → k) = kε`. -/
theorem flat_and_ker_eq_of_dualNumbers (ψ : TrivSqZeroExt k k →+* C) (π : C →+* D)
    (hπ : Function.Surjective π) (incl : D →+ C) (hincl : Function.Injective incl)
    (hmul : ∀ c, ψ (TrivSqZeroExt.inr 1) * c = incl (π c))
    (hexact : ∀ c, π c = 0 → ∃ d, incl d = c) (hπincl : ∀ d, π (incl d) = 0)
    (hsq : ∀ d d', incl d * incl d' = 0) :
    ψ.Flat ∧ RingHom.ker π =
      Ideal.map ψ (RingHom.ker (TrivSqZeroExt.fstHom k k k).toRingHom) := by
  let qR : TrivSqZeroExt k k →+* k := (TrivSqZeroExt.fstHom k k k).toRingHom
  let dd : k →+* D := π.comp (ψ.comp (TrivSqZeroExt.inlHom k k))
  have hε : π (ψ (TrivSqZeroExt.inr 1)) = 0 := by
    rw [← mul_one (ψ (TrivSqZeroExt.inr 1)), hmul, hπincl]
  have hinr : ∀ a : k, (TrivSqZeroExt.inr a : TrivSqZeroExt k k) =
      TrivSqZeroExt.inl a * TrivSqZeroExt.inr 1 := fun a => by
    rw [TrivSqZeroExt.inl_mul_inr, smul_eq_mul, mul_one]
  have hsqr : π.comp ψ = dd.comp qR := by
    ext r
    change π (ψ r) = π (ψ (TrivSqZeroExt.inl r.fst))
    conv_lhs => rw [← TrivSqZeroExt.inl_fst_add_inr_snd_eq r, hinr]
    rw [map_add, map_mul, map_add, map_mul, hε, mul_zero, add_zero]
  have hR : Function.Surjective qR := fun a => ⟨TrivSqZeroExt.inl a, rfl⟩
  have hflat : dd.Flat := by
    let := dd.toAlgebra
    exact (Module.Flat.of_free : Module.Flat k D)
  have hJ2 : RingHom.ker qR ^ 2 = ⊥ := sq_eq_bot_of_mul_eq_zero _ fun r hr s hs => by
    have hr' : r.fst = 0 := hr
    have hs' : s.fst = 0 := hs
    ext <;> simp [hr', hs']
  have hI2 : RingHom.ker π ^ 2 = ⊥ := sq_eq_bot_of_mul_eq_zero _ fun r hr s hs => by
    obtain ⟨d, rfl⟩ := hexact r hr
    obtain ⟨d', rfl⟩ := hexact s hs
    exact hsq d d'
  let : Module (TrivSqZeroExt k k) k := Module.compHom k qR
  have hN : ∀ (r : TrivSqZeroExt k k) (n : k), r • n = qR r • n := fun _ _ => rfl
  let w : k ≃ₗ[TrivSqZeroExt k k] RingHom.ker qR :=
    { toFun := fun n => ⟨TrivSqZeroExt.inr n, by simp [qR]⟩
      invFun := fun x => (x : TrivSqZeroExt k k).snd
      left_inv := fun n => rfl
      right_inv := fun x =>
        Subtype.ext (TrivSqZeroExt.ext (x.2 : (x : TrivSqZeroExt k k).fst = 0).symm rfl)
      map_add' := fun n n' => Subtype.ext (TrivSqZeroExt.inr_add k n n')
      map_smul' := fun r n => by
        refine Subtype.ext ?_
        change TrivSqZeroExt.inr (r.fst * n) = r * TrivSqZeroExt.inr n
        exact TrivSqZeroExt.ext (by simp) (by simp [mul_comm]) }
  let := dd.toAlgebra
  let incl' : D ≃+ RingHom.ker π :=
    AddEquiv.ofBijective
      ({ toFun := fun d => ⟨incl d, hπincl d⟩
         map_zero' := Subtype.ext (map_zero incl)
         map_add' := fun d d' => Subtype.ext (map_add incl d d') } : D →+ RingHom.ker π)
      ⟨fun d d' h => hincl (congrArg Subtype.val h),
        fun x => let ⟨d, hd⟩ := hexact x.1 x.2; ⟨d, Subtype.ext hd⟩⟩
  let Θ : ((ModuleCat.extendScalars dd).obj (ModuleCat.of k k)) ≃+ RingHom.ker π :=
    (ModuleCat.ExtendScalars.tensorAddEquiv dd k).symm.trans
      ((TensorProduct.rid k D).toAddEquiv.trans incl')
  refine flat_and_ker_eq_of_extendScalars_chart ψ qR π dd hsqr hR hπ hflat hJ2 hI2 hN w Θ ?_
  intro b n
  change incl (n • π b) = b * ψ (TrivSqZeroExt.inr n)
  rw [hinr n, map_mul, mul_comm (ψ _), ← mul_assoc, mul_comm b, mul_assoc, hmul, map_mul,
    Algebra.smul_def, mul_comm (π b)]
  rfl

end Stacks.Thickenings

end
