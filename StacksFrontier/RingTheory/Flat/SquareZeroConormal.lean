-/

@[expose] public noncomputable section

open TensorProduct

namespace Ideal

/-! ### The cotangent module of a square-zero ideal -/

section Cotangent

variable {R : Type*} [CommRing R] (I : Ideal R)

/-- A square-zero ideal annihilates itself: `I • I = 0` inside `I`, viewed as an `R`-module. -/
theorem smul_top_eq_bot_of_pow_two_eq_bot (h : I ^ 2 = ⊥) :
    (I • ⊤ : Submodule R I) = ⊥ := by
  rw [eq_bot_iff, Submodule.smul_le]
  intro r hr x _
  rw [Submodule.mem_bot]
  refine Subtype.ext ?_
  change r * (x : R) = 0
  rw [← Submodule.mem_bot (R := R), ← h, pow_two]
  exact Ideal.mul_mem_mul hr x.2

/-- For a square-zero ideal the cotangent module `I ⧸ I ^ 2` is `I` itself. -/
def cotangentEquivOfSqZero (h : I ^ 2 = ⊥) : I.Cotangent ≃ₗ[R] I :=
  Submodule.quotEquivOfEqBot _ (I.smul_top_eq_bot_of_pow_two_eq_bot h)

/-- The identification `I ⧸ I ^ 2 ≃ I` sends the class of `x` to `x`. -/
@[simp]
theorem cotangentEquivOfSqZero_toCotangent (h : I ^ 2 = ⊥) (x : I) :
    I.cotangentEquivOfSqZero h (I.toCotangent x) = x :=
  rfl

/-- The inverse of `I ⧸ I ^ 2 ≃ I` sends `x` to its class in the cotangent module. -/
@[simp]
theorem cotangentEquivOfSqZero_symm_apply (h : I ^ 2 = ⊥) (x : I) :
    (I.cotangentEquivOfSqZero h).symm x = I.toCotangent x :=
  rfl

end Cotangent

/-! ### The canonical map `I ⊗ B' → B'` -/

section TensorSMul

universe u

variable {A' : Type u} [CommRing A'] (I : Ideal A') (B' : Type u) [CommRing B'] [Algebra A' B']

/-- The canonical map `I ⊗[A'] B' → B'` attached to an ideal `I` of `A'` and a commutative
`A'`-algebra `B'`: it multiplies, carrying `i ⊗ b` to `i • b`. -/
def tensorSMulHom : I ⊗[A'] B' →ₗ[A'] B' :=
  (TensorProduct.lid A' B').toLinearMap ∘ₗ LinearMap.rTensor B' I.subtype

/-- The canonical map `I ⊗[A'] B' → B'` sends `x ⊗ b` to `x • b`. -/
@[simp]
theorem tensorSMulHom_tmul (x : I) (b : B') :
    I.tensorSMulHom B' (x ⊗ₜ[A'] b) = (x : A') • b :=
  rfl

/-- The canonical map `I ⊗[A'] B' → B'` is injective exactly when the inclusion `I → A'` stays
injective after tensoring with `B'`, which is the condition flatness of `B'` controls. -/
theorem injective_tensorSMulHom_iff :
    Function.Injective (I.tensorSMulHom B') ↔
      Function.Injective (LinearMap.rTensor B' I.subtype) := by
  have h : ⇑(I.tensorSMulHom B')
      = (TensorProduct.lid A' B') ∘ (LinearMap.rTensor B' I.subtype) := rfl
  rw [h]
  exact (TensorProduct.lid A' B').injective.of_comp_iff _

/-- The image of the canonical map `I ⊗[A'] B' → B'` is the submodule `I B'`. -/
theorem range_tensorSMulHom :
    LinearMap.range (I.tensorSMulHom B') = I • (⊤ : Submodule A' B') := by
  refine le_antisymm ?_ ?_
  · intro y hy
    obtain ⟨x, rfl⟩ := hy
    induction x with
    | tmul a b => exact Submodule.smul_mem_smul a.2 Submodule.mem_top
    | add x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  · rw [Submodule.smul_le]
    intro r hr b _
    exact ⟨(⟨r, hr⟩ : I) ⊗ₜ[A'] b, rfl⟩

/-- A square-zero ideal kills the elementary tensors `i ⊗ y` with `y ∈ I B'`. -/
private theorem tmul_eq_zero_of_mem_smul_top_aux (hI2 : I ^ 2 = ⊥) (x : I) {y : B'}
    (hy : y ∈ I • (⊤ : Submodule A' B')) : x ⊗ₜ[A'] y = (0 : I ⊗[A'] B') := by
  refine Submodule.smul_induction_on hy ?_ ?_
  · intro r hr b _
    have hrx : r • x = 0 := by
      have hm : r • x ∈ (I • ⊤ : Submodule A' I) :=
        Submodule.smul_mem_smul hr Submodule.mem_top
      rwa [I.smul_top_eq_bot_of_pow_two_eq_bot hI2, Submodule.mem_bot] at hm
    rw [← TensorProduct.smul_tmul, hrx, TensorProduct.zero_tmul]
  · intro y z hy hz
    rw [TensorProduct.tmul_add, hy, hz, add_zero]

/-- **The pullback of the conormal module is computed on the fibre product.** For a square-zero
ideal `I`, tensoring `I` with `B'` sees only the quotient `B' ⧸ I B'`. -/
@[sga "3 III 0.14" "partial"]
def tensorEquivTensorQuotSMulTop (hI2 : I ^ 2 = ⊥) :
    (I ⊗[A'] B') ≃ₗ[A'] (I ⊗[A'] (B' ⧸ (I • (⊤ : Submodule A' B')))) :=
  LinearEquiv.ofBijective (LinearMap.lTensor I (I • (⊤ : Submodule A' B')).mkQ)
    ⟨by
      rw [← LinearMap.ker_eq_bot, lTensor_mkQ, LinearMap.range_eq_bot]
      refine TensorProduct.ext' fun x y => ?_
      exact I.tmul_eq_zero_of_mem_smul_top_aux B' hI2 x y.2,
      LinearMap.lTensor_surjective _ (Submodule.mkQ_surjective _)⟩

/-- The identification `I ⊗[A'] B' ≃ I ⊗[A'] (B' ⧸ I B')` sends `x ⊗ b` to `x ⊗ [b]`. -/
@[simp]
theorem tensorEquivTensorQuotSMulTop_tmul (hI2 : I ^ 2 = ⊥) (x : I) (b : B') :
    I.tensorEquivTensorQuotSMulTop B' hI2 (x ⊗ₜ[A'] b)
      = x ⊗ₜ[A'] (Submodule.Quotient.mk b : B' ⧸ (I • (⊤ : Submodule A' B'))) :=
  rfl

end TensorSMul

/-! ### Stacks 063Y in the affine case -/

section Thickening

universe u

variable {A' : Type u} [CommRing A'] (I : Ideal A') (B' : Type u) [CommRing B'] [Algebra A' B']
  (B : Type u) [CommRing B] [Algebra A' B] [Algebra B' B] [Algebra (A' ⧸ I) B]
  [IsScalarTower A' B' B] [IsScalarTower A' (A' ⧸ I) B]

/-- **A morphism of thickenings carries the ideal into the ideal.** In the commuting square of
`A' → B'`, `A' → A' ⧸ I`, `B' → B`, `A' ⧸ I → B`, the submodule `I B'` lies in the kernel of
`B' → B`. -/
theorem smul_top_le_ker_algebraMap :
    I • (⊤ : Submodule A' B') ≤ (RingHom.ker (algebraMap B' B)).restrictScalars A' := by
  rw [Submodule.smul_le]
  intro r hr b _
  simp only [Submodule.restrictScalars_mem, RingHom.mem_ker]
  rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply A' B' B,
    IsScalarTower.algebraMap_apply A' (A' ⧸ I) B, Ideal.Quotient.algebraMap_eq,
    (Ideal.Quotient.eq_zero_iff_mem (I := I)).2 hr, map_zero, zero_mul]

/-- **The canonical map of conormal modules.** The canonical map `I ⊗[A'] B' → B'`, with its
codomain cut down to the conormal module of `X ⊂ X'`, that is to the kernel of `B' → B`. -/
def tensorSMulHomToKer :
    I ⊗[A'] B' →ₗ[A'] ((RingHom.ker (algebraMap B' B)).restrictScalars A') :=
  LinearMap.codRestrict _ (I.tensorSMulHom B') fun x => by
    refine I.smul_top_le_ker_algebraMap B' B ?_
    rw [← I.range_tensorSMulHom B']
    exact LinearMap.mem_range_self _ x

/-- `Ideal.tensorSMulHomToKer`, followed by the inclusion of the kernel, is
`Ideal.tensorSMulHom`. -/
@[simp]
theorem coe_tensorSMulHomToKer_apply (x : I ⊗[A'] B') :
    (I.tensorSMulHomToKer B' B x : B') = I.tensorSMulHom B' x :=
  rfl

/-- A map with values in a submodule is bijective onto that submodule exactly when it is
injective and its image is the whole submodule. -/
private theorem bijective_codRestrict_iff {R M N : Type*} [Ring R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (p : Submodule R N) (f : M →ₗ[R] N) (h : ∀ c, f c ∈ p) :
    Function.Bijective (f.codRestrict p h) ↔ Function.Injective f ∧ LinearMap.range f = p := by
  constructor
  · intro hb
    refine ⟨fun a b hab => hb.1 (Subtype.ext hab), le_antisymm ?_ fun y hy => ?_⟩
    · rintro _ ⟨x, rfl⟩
      exact h x
    · obtain ⟨x, hx⟩ := hb.2 ⟨y, hy⟩
      exact ⟨x, congrArg Subtype.val hx⟩
  · intro hb
    refine ⟨fun a b hab => hb.1 (congrArg Subtype.val hab), fun y => ?_⟩
    obtain ⟨x, hx⟩ := hb.2.ge y.2
    exact ⟨x, Subtype.ext hx⟩

/-- **The fibre product.** When the kernel of `B' → B` is `I B'`, the quotient `B' ⧸ I B'` is
`B`, linearly over `A' ⧸ I`: the closed subscheme `X` is the fibre product `S ×_{S'} X'`. -/
def quotSMulTopEquivOfKer (hsurj : Function.Surjective (algebraMap B' B))
    (hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B')) :
    (B' ⧸ (I • (⊤ : Submodule A' B'))) ≃ₗ[A' ⧸ I] B :=
  let g : B' →ₗ[A'] B := (Algebra.linearMap B' B).restrictScalars A'
  have hgker : LinearMap.ker g = (RingHom.ker (algebraMap B' B)).restrictScalars A' := rfl
  have hle : I • (⊤ : Submodule A' B') ≤ LinearMap.ker g := by rw [hgker, hker]
  let f : (B' ⧸ (I • (⊤ : Submodule A' B'))) →ₗ[A'] B := Submodule.liftQ _ g hle
  have hfinj : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot]
    exact Submodule.ker_liftQ_eq_bot _ _ _ (by rw [hgker, hker])
  have hfsurj : Function.Surjective f := fun y => by
    obtain ⟨b, hb⟩ := hsurj y
    exact ⟨Submodule.Quotient.mk b, hb⟩
  { (LinearEquiv.ofBijective f ⟨hfinj, hfsurj⟩).toAddEquiv with
    map_smul' := by
      intro c x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective c
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      change f (Submodule.Quotient.mk (r • b)) = Ideal.Quotient.mk I r • f (Submodule.Quotient.mk b)
      change g (r • b) = Ideal.Quotient.mk I r • g b
      rw [map_smul, ← Ideal.Quotient.algebraMap_eq, IsScalarTower.algebraMap_smul (A' ⧸ I)] }

/-- The identification `B' ⧸ I B' ≃ B` sends the class of `b` to its image in `B`. -/
@[simp]
theorem quotSMulTopEquivOfKer_mk (hsurj : Function.Surjective (algebraMap B' B))
    (hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B'))
    (b : B') :
    I.quotSMulTopEquivOfKer B' B hsurj hker
        (Submodule.Quotient.mk b : B' ⧸ (I • (⊤ : Submodule A' B'))) = algebraMap B' B b :=
  rfl

/-- **The source of the canonical map.** When the kernel of `B' → B` is `I B'` and `I ^ 2 = 0`,
the source `I ⊗[A'] B'` of the canonical map is the pullback `I ⊗[A'] B` of the conormal module
of `S ⊂ S'`.  Since `I ^ 2 = 0` identifies `I` with the cotangent module `I ⧸ I ^ 2` by
`Ideal.cotangentEquivOfSqZero`, this is the conormal module of `S ⊂ S'` pulled back to `X`. -/
def tensorEquivTensorQuot (hI2 : I ^ 2 = ⊥) (hsurj : Function.Surjective (algebraMap B' B))
    (hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B')) :
    (I ⊗[A'] B') ≃ₗ[A'] (I ⊗[A'] B) :=
  (I.tensorEquivTensorQuotSMulTop B' hI2).trans
    (TensorProduct.congr (LinearEquiv.refl A' I)
      ((I.quotSMulTopEquivOfKer B' B hsurj hker).restrictScalars A'))

/-- The identification `I ⊗[A'] B' ≃ I ⊗[A'] B` sends `x ⊗ b` to `x ⊗ b̄`, with `b̄` the image
of `b` in `B`. -/
@[simp]
theorem tensorEquivTensorQuot_tmul (hI2 : I ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B))
    (hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B'))
    (x : I) (b : B') :
    I.tensorEquivTensorQuot B' B hI2 hsurj hker (x ⊗ₜ[A'] b) = x ⊗ₜ[A'] (algebraMap B' B b) :=
  rfl

/-- When the kernel of `B' → B` is `I B'`, flatness of `A' ⧸ I → B` is flatness of the fibre
product `B' ⧸ I B'`. -/
theorem flat_quot_smul_top_of_ker (hflat : Module.Flat (A' ⧸ I) B)
    (hsurj : Function.Surjective (algebraMap B' B))
    (hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B')) :
    Module.Flat (A' ⧸ I) (B' ⧸ (I • (⊤ : Submodule A' B'))) :=
  have := hflat
  Module.Flat.of_linearEquiv (I.quotSMulTopEquivOfKer B' B hsurj hker)

/-- **Stacks 063Y, the affine case.** Let `I ^ 2 = 0` in `A'`, write `A = A' ⧸ I`, let `B` be a
quotient of the `A'`-algebra `B'` which is compatibly an `A`-algebra, and let `J` be the kernel of
`B' → B`.  Assume `A → B` flat.  Then the canonical map `I ⊗[A'] B' → J` is an isomorphism if and
only if `A' → B'` is flat and `J = I B'`.

The second condition says that `X = Spec B` is the fibre product `S ×_{S'} X'`, and
`I ⊗[A'] B'` is the pullback to `X` of the conormal module of `S ⊂ S'` by
`Ideal.tensorEquivTensorQuot`. -/
@[stacks 063Y "affine case", sga "3 III 0.14" "partial", sga "3 XV 2.7" "affine case"]
theorem bijective_tensorSMulHomToKer_iff (hI2 : I ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) (hflat : Module.Flat (A' ⧸ I) B) :
    Function.Bijective (I.tensorSMulHomToKer B' B) ↔
      Module.Flat A' B' ∧
        (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B') := by
  rw [tensorSMulHomToKer, bijective_codRestrict_iff]
  constructor
  · intro h
    have hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B') :=
      h.2.symm.trans (I.range_tensorSMulHom B')
    refine ⟨?_, hker⟩
    have hrt : Function.Injective (LinearMap.rTensor B' I.subtype) :=
      (I.injective_tensorSMulHom_iff B').mp h.1
    have hF : Tor1Vanishes A' A' B' :=
      Tor_iso_Tor'.tor_flat_isZero A' (ModuleCat.of A' A') (ModuleCat.of A' B') 0
    have ht : Tor1Vanishes A' (A' ⧸ I) B' :=
      tor1_vanishes_of_shortExact_rTensor_injective I.subtype I.mkQ
        (Submodule.injective_subtype I) I.mkQ_surjective
        (by rw [LinearMap.exact_iff]; simp) hF hrt
    exact flat_of_nilpotent I (I.flat_quot_smul_top_of_ker B' B hflat hsurj hker) ht
      ⟨2, by norm_num, hI2⟩
  · intro h
    refine ⟨(I.injective_tensorSMulHom_iff B').mpr (Module.Flat.iff_rTensor_injective'.mp h.1 I),
      (I.range_tensorSMulHom B').trans h.2.symm⟩

/-! ### The canonical map out of the pullback to the special fibre -/

/-- **A square-zero defining ideal is annihilated by `I`.** The image of `I` in `B'` lies in the
kernel `J` of `B' → B`, so if `J ^ 2 = 0` then `I` kills `J`.

This is what makes the canonical map of conormal modules well defined on `I ⊗[A'] B`: changing
the lift to `B'` of a section of `B` changes it by an element of `J`, and multiplying that by an
element of `I` gives zero. -/
theorem smul_eq_zero_of_mem_ker (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥) (x : I) {y : B'}
    (hy : y ∈ RingHom.ker (algebraMap B' B)) : (x : A') • y = 0 := by
  have hx : algebraMap A' B' (x : A') ∈ RingHom.ker (algebraMap B' B) := by
    have h := I.smul_top_le_ker_algebraMap B' B
      (Submodule.smul_mem_smul x.2 (show (1 : B') ∈ (⊤ : Submodule A' B') from Submodule.mem_top))
    simpa [Algebra.smul_def] using h
  have hmem : (x : A') • y ∈ RingHom.ker (algebraMap B' B) ^ 2 := by
    rw [pow_two, Algebra.smul_def]
    exact Ideal.mul_mem_mul hx hy
  rwa [hJ2, Ideal.mem_bot] at hmem

/-- **The defining ideal presents the special fibre.** The inclusion of the kernel of `B' → B`
and the structure map `B' → B` form an exact pair of `A'`-modules, by definition of the kernel. -/
theorem exact_ker_subtype_algebraLinearMap :
    Function.Exact
      (Submodule.subtype ((RingHom.ker (algebraMap B' B)).restrictScalars A'))
      ((Algebra.linearMap B' B).restrictScalars A') := by
  rw [LinearMap.exact_iff]
  exact (Submodule.range_subtype _).symm

/-- **The pullback of the conormal module to the special fibre.** `I ⊗[A'] B` is the quotient of
`I ⊗[A'] B'` by the image of `I ⊗[A'] J`, with `J` the defining ideal of `X ⊂ X'`: this is the
right exactness of `I ⊗[A'] -` applied to the presentation of `B` by `J`. -/
noncomputable def tensorFibreEquiv (hsurj : Function.Surjective (algebraMap B' B)) :
    ((I ⊗[A'] B') ⧸ LinearMap.range (LinearMap.lTensor I
        (Submodule.subtype ((RingHom.ker (algebraMap B' B)).restrictScalars A')))) ≃ₗ[A']
      (I ⊗[A'] B) :=
  lTensor.equiv I (exact_ker_subtype_algebraLinearMap B' B) hsurj

omit [Algebra (A' ⧸ I) B] [IsScalarTower A' (A' ⧸ I) B] in
/-- `Ideal.tensorFibreEquiv` sends the class of `z` to the image of `z` under
`I ⊗[A'] B' → I ⊗[A'] B`. -/
@[simp]
theorem tensorFibreEquiv_mk (hsurj : Function.Surjective (algebraMap B' B))
    (z : I ⊗[A'] B') :
    I.tensorFibreEquiv B' B hsurj (Submodule.Quotient.mk z) =
      LinearMap.lTensor I ((Algebra.linearMap B' B).restrictScalars A') z :=
  rfl

/-- **The canonical map of conormal modules, on the pullback to the special fibre.** The map
`I ⊗[A'] B → B'` carrying `i ⊗ b` to `i • b'` for any lift `b'` of `b`.

`I ⊗[A'] B` is the pullback to `X = Spec B` of the conormal module `I` of `S ⊂ S'`, so this is
the source in which condition (2) of [Stacks Project, Tag 063Y] is stated.  The companion
`Ideal.tensorSMulHom` has source `I ⊗[A'] B'` instead, and the two sources agree only once
`J = I B'` (`Ideal.tensorEquivTensorQuot`), which is half of what the lemma concludes; so the
map below, and not that one, is the map whose bijectivity the source asserts. -/
noncomputable def fibreTensorSMulHom (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) : (I ⊗[A'] B) →ₗ[A'] B' :=
  Submodule.liftQ _ (I.tensorSMulHom B')
      (LinearMap.range_le_ker_iff.2 (TensorProduct.ext' fun x y => by
        simpa using I.smul_eq_zero_of_mem_ker B' B hJ2 x y.2)) ∘ₗ
    (I.tensorFibreEquiv B' B hsurj).symm.toLinearMap

/-- **The canonical map is the one on `I ⊗[A'] B'`, read on the special fibre.** Precomposing
with the surjection `I ⊗[A'] B' → I ⊗[A'] B` returns `Ideal.tensorSMulHom`. Since that
surjection is surjective, this pins the map down. -/
theorem fibreTensorSMulHom_comp_lTensor (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) :
    (I.fibreTensorSMulHom B' B hJ2 hsurj) ∘ₗ
        LinearMap.lTensor I ((Algebra.linearMap B' B).restrictScalars A') =
      I.tensorSMulHom B' := by
  refine LinearMap.ext fun z => ?_
  have h : (I.tensorFibreEquiv B' B hsurj).symm
      (LinearMap.lTensor I ((Algebra.linearMap B' B).restrictScalars A') z) =
      Submodule.Quotient.mk z := by
    rw [LinearEquiv.symm_apply_eq, tensorFibreEquiv_mk]
  simp [fibreTensorSMulHom, h]

/-- The canonical map `I ⊗[A'] B → B'` sends `x ⊗ b̄` to `x • b`, for `b̄` the image of `b`
in `B`. -/
@[simp]
theorem fibreTensorSMulHom_tmul (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) (x : I) (b : B') :
    I.fibreTensorSMulHom B' B hJ2 hsurj (x ⊗ₜ[A'] algebraMap B' B b) = (x : A') • b := by
  have h := LinearMap.congr_fun (I.fibreTensorSMulHom_comp_lTensor B' B hJ2 hsurj) (x ⊗ₜ[A'] b)
  simpa using h

/-- The image of the canonical map is the submodule `I B'`, with no hypotheses beyond those
needed to form it: the same submodule as for `Ideal.tensorSMulHom`, because the two maps differ
by a surjection. -/
theorem range_fibreTensorSMulHom (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) :
    LinearMap.range (I.fibreTensorSMulHom B' B hJ2 hsurj) = I • (⊤ : Submodule A' B') := by
  conv_rhs => rw [← I.range_tensorSMulHom B']
  rw [← I.fibreTensorSMulHom_comp_lTensor B' B hJ2 hsurj, LinearMap.range_comp,
    LinearMap.range_eq_top.2 (LinearMap.lTensor_surjective I hsurj), Submodule.map_top]

/-- **The canonical map of conormal modules**, with codomain cut down to the conormal module `J`
of `X ⊂ X'`, that is to the kernel of `B' → B`. -/
noncomputable def fibreTensorSMulHomToKer (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) :
    (I ⊗[A'] B) →ₗ[A'] ((RingHom.ker (algebraMap B' B)).restrictScalars A') :=
  LinearMap.codRestrict _ (I.fibreTensorSMulHom B' B hJ2 hsurj) fun x => by
    refine I.smul_top_le_ker_algebraMap B' B ?_
    rw [← I.range_fibreTensorSMulHom B' B hJ2 hsurj]
    exact LinearMap.mem_range_self _ x

/-- `Ideal.fibreTensorSMulHomToKer`, followed by the inclusion of the kernel, is
`Ideal.fibreTensorSMulHom`. -/
@[simp]
theorem coe_fibreTensorSMulHomToKer_apply (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) (x : I ⊗[A'] B) :
    (I.fibreTensorSMulHomToKer B' B hJ2 hsurj x : B') = I.fibreTensorSMulHom B' B hJ2 hsurj x :=
  rfl

/-- The canonical map on the special fibre, precomposed with the surjection
`I ⊗[A'] B' → I ⊗[A'] B`, is `Ideal.tensorSMulHomToKer`. -/
@[ega "0 18.2.1" "partial"]
theorem fibreTensorSMulHomToKer_comp_lTensor (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) :
    (I.fibreTensorSMulHomToKer B' B hJ2 hsurj) ∘ₗ
        LinearMap.lTensor I ((Algebra.linearMap B' B).restrictScalars A') =
      I.tensorSMulHomToKer B' B :=
  LinearMap.ext fun z => Subtype.ext
    (LinearMap.congr_fun (I.fibreTensorSMulHom_comp_lTensor B' B hJ2 hsurj) z)

/-- When the kernel of `B' → B` is `I B'` the surjection `I ⊗[A'] B' → I ⊗[A'] B` is bijective:
it agrees on elementary tensors with the identification `Ideal.tensorEquivTensorQuot`. -/
theorem bijective_lTensor_algebraLinearMap (hI2 : I ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B))
    (hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B')) :
    Function.Bijective
      (LinearMap.lTensor I ((Algebra.linearMap B' B).restrictScalars A')) := by
  have h : LinearMap.lTensor I ((Algebra.linearMap B' B).restrictScalars A') =
      (I.tensorEquivTensorQuot B' B hI2 hsurj hker : (I ⊗[A'] B') →ₗ[A'] (I ⊗[A'] B)) :=
    TensorProduct.ext' fun x b => by
      simp [I.tensorEquivTensorQuot_tmul B' B hI2 hsurj hker x b]
  rw [h]
  exact (I.tensorEquivTensorQuot B' B hI2 hsurj hker).bijective

/-- **Stacks 063Y in the affine case, with the source as the pullback of the conormal module.**
Let `I ^ 2 = 0` in `A'`, write `A = A' ⧸ I`, let `B` be a quotient of the `A'`-algebra `B'` which
is compatibly an `A`-algebra, and let `J` be the kernel of `B' → B`. Assume `J ^ 2 = 0` and
`A → B` flat. Then the canonical map `I ⊗[A'] B → J` is an isomorphism if and only if `A' → B'`
is flat and `J = I B'`.

This is `Ideal.bijective_tensorSMulHomToKer_iff` with the source replaced by the pullback
`I ⊗[A'] B` of the conormal module of `S ⊂ S'` to `X`, which is the module condition (2) of the
source speaks about; that form needs `J ^ 2 = 0`, which the version with source `I ⊗[A'] B'` does
not. -/
@[stacks 063Y "affine case, with the source the pullback of the conormal module"]
theorem bijective_fibreTensorSMulHomToKer_iff (hI2 : I ^ 2 = ⊥)
    (hJ2 : RingHom.ker (algebraMap B' B) ^ 2 = ⊥)
    (hsurj : Function.Surjective (algebraMap B' B)) (hflat : Module.Flat (A' ⧸ I) B) :
    Function.Bijective (I.fibreTensorSMulHomToKer B' B hJ2 hsurj) ↔
      Module.Flat A' B' ∧
        (RingHom.ker (algebraMap B' B)).restrictScalars A' = I • (⊤ : Submodule A' B') := by
  have hcomp := I.fibreTensorSMulHomToKer_comp_lTensor B' B hJ2 hsurj
  constructor
  · intro hb
    have hker : (RingHom.ker (algebraMap B' B)).restrictScalars A' =
        I • (⊤ : Submodule A' B') := by
      rw [fibreTensorSMulHomToKer, bijective_codRestrict_iff] at hb
      exact hb.2.symm.trans (I.range_fibreTensorSMulHom B' B hJ2 hsurj)
    refine ⟨((I.bijective_tensorSMulHomToKer_iff B' B hI2 hsurj hflat).mp ?_).1, hker⟩
    rw [← hcomp]
    exact hb.comp (I.bijective_lTensor_algebraLinearMap B' B hI2 hsurj hker)
  · intro h
    have hq := I.bijective_lTensor_algebraLinearMap B' B hI2 hsurj h.2
    have hold := (I.bijective_tensorSMulHomToKer_iff B' B hI2 hsurj hflat).mpr h
    rw [← hcomp] at hold
    exact (Function.Bijective.of_comp_iff _ hq).mp hold

end Thickening

end Ideal

