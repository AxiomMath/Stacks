module

public import Mathlib.RingTheory.Flat.EquationalCriterion
public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.LinearAlgebra.LinearIndependent.Defs

/-!
# Relations with coefficients in the square-zero ideal of `k[M]`, in a flat module

Let `k` be a field, `M` a `k`-vector space and `k[M] = k ⊕ M` the trivial square-zero extension
of `k` by `M`. Let `N` be a `k[M]`-module which is flat over `k[M]`. If `(b_j)` is a basis of `M`
and `∑_j b_j · n_j = 0` in `N`, then every `n_j` lies in `M · N`.

This is the flatness input of the classification of first order deformations of a module over
the dual numbers, and more generally over `k[M]`: in an extension `0 ⟶ G ⊗ M ⟶ E ⟶ G ⟶ 0`
attached to a flat deformation, the map from the copower `G ⊗ M` is injective. The proof is the
equational criterion of flatness: the relation `∑_j b_j · n_j = 0` is trivial, so the `n_j` are
combinations of finitely many elements with coefficients `a_{jl}` satisfying
`∑_j b_j a_{jl} = 0`; the residue of each `a_{jl}` multiplies `b_j` into the second component, and
linear independence of the `b_j` forces those residues to vanish, so every `a_{jl}` lies in `M`.

## Main results

* `TrivSqZeroExt.mem_ker_fst_smul_top_of_sum_inr_smul_eq_zero`.
-/

@[expose] public section

namespace TrivSqZeroExt

variable {k : Type*} [Field k] {M : Type*} [AddCommGroup M] [Module k M] [Module kᵐᵒᵖ M]
  [IsCentralScalar k M]

/-- The square of the inclusion of `M`: `inr m * x = inr (x.fst • m)` in `k[M]`. -/
theorem inr_mul_eq (m : M) (x : TrivSqZeroExt k M) :
    inr m * x = inr (x.fst • m) := by
  ext
  · simp
  · simp [op_smul_eq_smul]

/-- **In a module flat over `k[M]`, a relation with coefficients a basis of `M` has all its
terms in `M · N`.** If `∑_j b_j · n_j = 0` for a basis `(b_j)` of `M`, every `n_j` lies in the
submodule generated by the products of elements of the square-zero ideal `M = ker(fst)` with
elements of `N`. -/
theorem mem_ker_fst_smul_top_of_sum_inr_smul_eq_zero {N : Type*} [AddCommGroup N]
    [Module (TrivSqZeroExt k M) N] [Module.Flat (TrivSqZeroExt k M) N]
    {ι : Type*} [Fintype ι] (b : Module.Basis ι k M) (n : ι → N)
    (h : ∑ j, (inr (b j) : TrivSqZeroExt k M) • n j = 0) (j : ι) :
    n j ∈ (RingHom.ker (fstHom k k M)) • (⊤ : Submodule (TrivSqZeroExt k M) N) := by
  obtain ⟨l, a, y, hx, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero h
  have hfst : ∀ i l', (a i l').fst = 0 := by
    intro i l'
    have h2 := congrArg TrivSqZeroExt.snd (hrel l')
    simp only [inr_mul_eq, snd_sum, snd_inr, snd_zero] at h2
    exact (Fintype.linearIndependent_iff.mp b.linearIndependent (fun i => (a i l').fst) h2) i
  rw [hx j]
  refine Submodule.sum_mem _ fun l' _ => Submodule.smul_mem_smul ?_ Submodule.mem_top
  exact hfst j l'

end TrivSqZeroExt

end
