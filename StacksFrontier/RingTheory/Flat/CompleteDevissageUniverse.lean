module

public import Mathlib.Algebra.Module.ULift
public import StacksFrontier.RingTheory.Flat.MittagLeffler
public import StacksFrontier.RingTheory.Flat.UniversallyExact

/-!
# Universal injectivity across universes

The three inputs of the induction step of Stacks 05I3 -- Stacks 05FQ, Stacks 058P and the
passage from universal injectivity to injectivity -- are available in the library only for
modules sharing a single universe, in the case of Stacks 058P the universe of the base ring as
well. In a complete dévissage (Stacks 05HX) the stage algebras live in the universe of the base
ring while the stage modules live in the universe of the module being devissaged, so the maps
`αᵢ` go between modules in *different* universes and none of the three applies.

This file removes that restriction. The restriction is an artefact of the way the library forms
test modules: universal injectivity of `f : M →ₗ[R] N` is spelled as injectivity of
`f.rTensor Q` for every test module `Q` in one fixed universe, and the available results require
`M` and `N` to live in that universe too.

Two different devices are used. Stacks 05FQ rests on Stacks 0AS5, whose forward direction needs
the two modules and the test modules in one universe; since both statements are invariant under
replacing a module by a `ULift` of it, conjugating by `ULift.moduleEquiv` lifts both modules
into `Type (max u v w)` and transports the conclusion back. Stacks 058P cannot be treated that
way, because its library form puts the base ring in the module universe too and `R` admits no
`ULift`; instead its proof is replayed over
`Module.Flat.iff_lTensor_preserves_injective_linearMap'`, the form of the flatness criterion
whose test modules range over an arbitrary universe containing `R`.

## Main definitions

There are no new definitions.

## Main results

* `Module.injective_of_rTensor_injective`: a map whose base changes are injective is injective,
  with the source, the target and the base ring in three independent universes.
* `Module.Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top'` and
  `Module.Flat.rTensor_injective_of_projective_of_injective_mapQ_maximalIdeal'`: Stacks 05FQ for
  a map between modules in two independent universes.
* `Module.flat_of_middle_flat_of_rTensor_injective`: Stacks 058P for a short exact sequence whose
  three terms live in three independent universes.

## Implementation notes

For `R : Type u`, `M : Type v` and `N : Type w` the test modules are taken to range over
`Type (max u v w)`, the smallest universe containing all the data. This is no weaker than the
single-universe form: `R` is `Small.{max u v w}`, so a module in `Type (max u v w)` suffices to
expose `R` itself as a test module, and conversely every test module in `Type v` has a `ULift`
in `Type (max u v w)` whose tensor product with a given module is isomorphic to the original
one.

`Submodule.smul_top_le_comap_smul_top` is used as the statement that a linear map carries
`I • ⊤` into `I • ⊤`, which is what transports the hypothesis of Stacks 05FQ along an
equivalence.

## References

* [Stacks Project, Tag 05FQ](https://stacks.math.columbia.edu/tag/05FQ)
* [Stacks Project, Tag 058P](https://stacks.math.columbia.edu/tag/058P)
-/

@[expose] public section

open scoped TensorProduct

universe u v w x

namespace Module

/-- Injectivity of a base change is inherited by any precomposition with a surjection and any
postcomposition with an injection. This is the shape in which a conjugated map's base change is
compared with the original one. -/
private theorem injective_rTensor_of_injective_rTensor_conj {R : Type u} [CommRing R]
    {M : Type v} {M' : Type*} {N : Type w} {N' : Type*} [AddCommGroup M] [Module R M]
    [AddCommGroup M'] [Module R M'] [AddCommGroup N] [Module R N] [AddCommGroup N'] [Module R N']
    (Q : Type x) [AddCommGroup Q] [Module R Q] (eM : M' ≃ₗ[R] M) (eN : N ≃ₗ[R] N')
    {u : M →ₗ[R] N}
    (h : Function.Injective ((eN.toLinearMap ∘ₗ u ∘ₗ eM.toLinearMap).rTensor Q)) :
    Function.Injective (u.rTensor Q) := by
  rw [LinearMap.rTensor_comp, LinearMap.rTensor_comp, LinearMap.coe_comp,
    LinearMap.coe_comp] at h
  refine h.of_comp.of_comp_right ?_
  rw [← LinearEquiv.coe_rTensor Q eM]
  exact (eM.rTensor Q).surjective

/-- A map of `R`-modules all of whose base changes are injective is injective. The source, the
target and the base ring live in three independent universes; the test modules range over the
universe generated by all three, which is where `R` itself becomes available as a test
module. -/
public theorem injective_of_rTensor_injective {R : Type u} [CommRing R] {M : Type v} {N : Type w}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (f : M →ₗ[R] N)
    (hf : ∀ (Q : Type max u v w) [AddCommGroup Q] [Module R Q],
      Function.Injective (f.rTensor Q)) :
    Function.Injective f := by
  intro a b hab
  let e : M ⊗[R] ULift.{max v w} R ≃ₗ[R] M :=
    LinearEquiv.lTensor M ULift.moduleEquiv ≪≫ₗ TensorProduct.rid R M
  have key : (a ⊗ₜ[R] ULift.up (1 : R) : M ⊗[R] ULift.{max v w} R)
      = b ⊗ₜ[R] ULift.up (1 : R) :=
    hf _ (by simp [hab])
  simpa [e] using congrArg e key

/-- **Stacks Project, Tag 05FQ**, for a map between modules in two independent universes. Let
`(R, 𝔪)` be a local ring and let `u : M →ₗ[R] N` be a map of `R`-modules with `M` projective and
`N` flat. If `u x ∈ 𝔪 • ⊤` forces `x ∈ 𝔪 • ⊤`, then `u ⊗ id_Q` is injective for every test
module `Q`.

This generalizes `Module.Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top`,
which requires `M` and `N` to share the universe of the test modules. -/
public theorem Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top'
    {R : Type u} [CommRing R] [IsLocalRing R] {M : Type v} {N : Type w} [AddCommGroup M]
    [Module R M] [Module.Projective R M] [AddCommGroup N] [Module R N] [Module.Flat R N]
    (u : M →ₗ[R] N)
    (hu : ∀ x : M, u x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R N) →
      x ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) :
    ∀ (Q : Type max u v w) [AddCommGroup Q] [Module R Q], Function.Injective (u.rTensor Q) := by
  intro Q _ _
  have : Small.{max u v w} R := ⟨⟨ULift.{max v w} R, ⟨Equiv.ulift.symm⟩⟩⟩
  set eM : ULift.{max u w} M ≃ₗ[R] M := ULift.moduleEquiv
  set eN : ULift.{max u v} N ≃ₗ[R] N := ULift.moduleEquiv
  refine injective_rTensor_of_injective_rTensor_conj Q eM eN.symm
    (Module.Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top _ ?_ Q)
  intro y hy
  have hx : u (eM y) ∈ IsLocalRing.maximalIdeal R • (⊤ : Submodule R N) := by
    simpa using Submodule.smul_top_le_comap_smul_top (IsLocalRing.maximalIdeal R)
      eN.toLinearMap hy
  simpa using Submodule.smul_top_le_comap_smul_top (IsLocalRing.maximalIdeal R)
    eM.symm.toLinearMap (hu _ hx)

/-- **Stacks Project, Tag 05FQ**, for a map between modules in two independent universes, with
the hypothesis in the map form: the reduction `M/𝔪M → N/𝔪N` is injective.

This generalizes `Module.Flat.rTensor_injective_of_projective_of_injective_mapQ_maximalIdeal`,
which requires `M` and `N` to share the universe of the test modules. -/
public theorem Flat.rTensor_injective_of_projective_of_injective_mapQ_maximalIdeal'
    {R : Type u} [CommRing R] [IsLocalRing R] {M : Type v} {N : Type w} [AddCommGroup M]
    [Module R M] [Module.Projective R M] [AddCommGroup N] [Module R N] [Module.Flat R N]
    (u : M →ₗ[R] N)
    (hu : Function.Injective ((IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)).mapQ
      (IsLocalRing.maximalIdeal R • (⊤ : Submodule R N)) u
      (Submodule.smul_top_le_comap_smul_top (IsLocalRing.maximalIdeal R) u))) :
    ∀ (Q : Type max u v w) [AddCommGroup Q] [Module R Q], Function.Injective (u.rTensor Q) :=
  Flat.rTensor_injective_of_projective_of_mem_maximalIdeal_smul_top' u
    ((Submodule.injective_mapQ_smul_top_iff u (IsLocalRing.maximalIdeal R)).mp hu)

/-- **Stacks Project, Tag 058P**, for a short exact sequence whose three terms live in three
independent universes. Let `0 → M₁ → M₂ → M₃ → 0` be a short exact sequence of `R`-modules with
`M₂` flat, and let the injection be universally injective. Then `M₁` and `M₃` are flat.

This generalizes `UniversallyExact.flat_of_middle_flat`, which requires the three terms *and*
the base ring to share one universe. -/
public theorem flat_of_middle_flat_of_rTensor_injective {R : Type u} [CommRing R] {M₁ : Type v}
    {M₂ : Type w} {M₃ : Type x} [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
    [AddCommGroup M₃] [Module R M₃] [Module.Flat R M₂] (f : M₁ →ₗ[R] M₂) (g : M₂ →ₗ[R] M₃)
    (hg : Function.Surjective g) (hfg : Function.Exact f g)
    (hu : ∀ (Q : Type max u v w x) [AddCommGroup Q] [Module R Q],
      Function.Injective (f.rTensor Q)) :
    Module.Flat R M₁ ∧ Module.Flat R M₃ := by
  have : Small.{max u v w x} R := ⟨⟨ULift.{max v w x} R, ⟨Equiv.ulift.symm⟩⟩⟩
  constructor
  · -- `M₁ ⊗ -` is injective on injections because `M₂ ⊗ -` is and `f` is universally injective.
    rw [Module.Flat.iff_lTensor_preserves_injective_linearMap'.{max u v w x}]
    intro A B _ _ _ _ j hj
    have hcomp : Function.Injective
        (LinearMap.rTensor B f ∘ₗ LinearMap.lTensor M₁ j : M₁ ⊗[R] A →ₗ[R] M₂ ⊗[R] B) := by
      rw [LinearMap.rTensor_comp_lTensor, ← LinearMap.lTensor_comp_rTensor, LinearMap.coe_comp]
      exact (Module.Flat.lTensor_preserves_injective_linearMap j hj).comp (hu A)
    rw [LinearMap.coe_comp] at hcomp
    exact hcomp.of_comp
  · -- The diagram chase of Stacks 058P for the quotient term.
    rw [Module.Flat.iff_lTensor_preserves_injective_linearMap'.{max u v w x}]
    intro A B _ _ _ _ j hj
    -- Base change along the two factors of a tensor product commutes.
    have hnatg (y : M₂ ⊗[R] A) :
        LinearMap.rTensor B g (LinearMap.lTensor M₂ j y) =
          LinearMap.lTensor M₃ j (LinearMap.rTensor A g y) := by
      rw [← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
        ← LinearMap.lTensor_comp_rTensor, LinearMap.comp_apply]
    have hnatf {A' B' : Type max u v w x} [AddCommGroup A'] [Module R A'] [AddCommGroup B']
        [Module R B'] (k : A' →ₗ[R] B') (c : M₁ ⊗[R] A') :
        LinearMap.rTensor B' f (LinearMap.lTensor M₁ k c) =
          LinearMap.lTensor M₂ k (LinearMap.rTensor A' f c) := by
      rw [← LinearMap.comp_apply, LinearMap.rTensor_comp_lTensor,
        ← LinearMap.lTensor_comp_rTensor, LinearMap.comp_apply]
    have hπj : (LinearMap.range j).mkQ ∘ₗ j = 0 := by
      ext a
      simp
    rw [injective_iff_map_eq_zero (LinearMap.lTensor M₃ j)]
    intro z hz
    obtain ⟨y, rfl⟩ := LinearMap.rTensor_surjective A hg z
    obtain ⟨c, hc⟩ := (rTensor_exact B hfg hg _).mp ((hnatg y).trans hz)
    have h2 : LinearMap.rTensor (B ⧸ LinearMap.range j) f
        (LinearMap.lTensor M₁ (LinearMap.range j).mkQ c) = 0 := by
      rw [hnatf, hc, ← LinearMap.comp_apply, ← LinearMap.lTensor_comp, hπj]
      simp
    have h3 : LinearMap.lTensor M₁ (LinearMap.range j).mkQ c = 0 := hu (B ⧸ LinearMap.range j) h2
    obtain ⟨a, ha⟩ := (lTensor_exact M₁ (LinearMap.exact_map_mkQ_range j)
      (LinearMap.range j).mkQ_surjective c).mp h3
    have h4 : LinearMap.lTensor M₂ j y = LinearMap.lTensor M₂ j (LinearMap.rTensor A f a) := by
      rw [← hc, ← ha, hnatf]
    rw [Module.Flat.lTensor_preserves_injective_linearMap j hj h4]
    exact (rTensor_exact A hfg hg).apply_apply_eq_zero a

end Module

end
