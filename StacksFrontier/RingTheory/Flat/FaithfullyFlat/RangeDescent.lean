module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.IsTensorProduct

/-!
# Descending membership in the image of a ring map along a faithfully flat cover

Let `A ⟶ B` be a homomorphism of commutative rings and `b ∈ B`.  If after a faithfully flat base
change `A ⟶ C` the element `1 ⊗ b` of `C ⊗_A B` lies in the `C`-submodule generated by the image
of `A`, then `b` lies in the image of `A`: `Submodule.baseChange_le_iff`.  For a finite family of
flat `A`-algebras `A_k` whose spectra cover `Spec A`, the product `∏ A_k` is faithfully flat, and
the condition may be checked one `A_k` at a time.  When moreover `B_k = A_k ⊗_A B` (an
`Algebra.IsPushout`), the condition at `A_k` is that the image of `b` in `B_k` comes from `A_k`.
This is the faithfully flat descent of surjectivity used to show that a ring map which is
surjective étale locally is surjective.

## Main results

* `Stacks.RangeDescent.mem_range_of_one_tmul_mem_baseChange`: descent along a faithfully flat
  algebra.
* `Stacks.RangeDescent.one_tmul_mem_baseChange_pi`: the condition for a finite product.
* `Stacks.RangeDescent.one_tmul_mem_baseChange_of_isPushout`: the condition at an algebra over
  which `B` has a pushout in which the image of `b` comes from the base.
* `Stacks.RangeDescent.mem_range_of_isPushout_cover`: the assembled statement.
-/

@[expose] public section

open TensorProduct

universe u

namespace Stacks.RangeDescent

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- **Descent of membership in the image along a faithfully flat algebra.** -/
theorem mem_range_of_one_tmul_mem_baseChange {C : Type*} [CommRing C] [Algebra A C]
    [Module.FaithfullyFlat A C] (b : B)
    (h : (1 : C) ⊗ₜ[A] b ∈ (LinearMap.range (Algebra.linearMap A B)).baseChange C) :
    b ∈ (algebraMap A B).range := by
  have hle : (Submodule.span A {b}).baseChange C ≤
      (LinearMap.range (Algebra.linearMap A B)).baseChange C := by
    rw [Submodule.baseChange_span]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, hx, rfl⟩
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact h
  obtain ⟨a, ha⟩ := (Submodule.baseChange_le_iff.1 hle) (Submodule.mem_span_singleton_self b)
  exact ⟨a, ha⟩

/-- **The condition for a finite product of algebras may be checked factor by factor.** -/
theorem one_tmul_mem_baseChange_pi {ι : Type*} [Finite ι]
    (Ak : ι → Type u) [∀ k, CommRing (Ak k)] [∀ k, Algebra A (Ak k)] (b : B)
    (h : ∀ k, (1 : Ak k) ⊗ₜ[A] b ∈ (LinearMap.range (Algebra.linearMap A B)).baseChange (Ak k)) :
    (1 : (k : ι) → Ak k) ⊗ₜ[A] b ∈
      (LinearMap.range (Algebra.linearMap A B)).baseChange ((k : ι) → Ak k) := by
  classical
  have := Fintype.ofFinite ι
  set N := LinearMap.range (Algebra.linearMap A B)
  have h1 : (1 : (k : ι) → Ak k) = ∑ k, Pi.single k 1 := (Finset.univ_sum_single 1).symm
  rw [h1, TensorProduct.sum_tmul]
  refine Submodule.sum_mem _ fun k _ => ?_
  have hsmul : ∀ (c : Ak k) (x : Ak k ⊗[A] B), ((LinearMap.single A Ak k).rTensor B) (c • x) =
      (Pi.single k c : (k : ι) → Ak k) • ((LinearMap.single A Ak k).rTensor B) x := by
    intro c x
    induction x using TensorProduct.inductionOn with
    | tmul a n => simp [TensorProduct.smul_tmul', ← Pi.single_mul]
    | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]
  have key : ∀ x : Ak k ⊗[A] B, x ∈ N.baseChange (Ak k) →
      ((LinearMap.single A Ak k).rTensor B) x ∈ N.baseChange ((k : ι) → Ak k) := by
    intro x hx
    have hx' : x ∈ Submodule.span (Ak k) (N.map (TensorProduct.mk A (Ak k) B 1)) := by
      rwa [← Submodule.baseChange_eq_span]
    refine Submodule.span_induction (p := fun x _ =>
      ((LinearMap.single A Ak k).rTensor B) x ∈ N.baseChange ((k : ι) → Ak k)) ?_ ?_ ?_ ?_ hx'
    · rintro _ ⟨n, hn, rfl⟩
      have : ((LinearMap.single A Ak k).rTensor B) ((TensorProduct.mk A (Ak k) B 1) n) =
          (Pi.single k (1 : Ak k) : (k : ι) → Ak k) • ((1 : (k : ι) → Ak k) ⊗ₜ[A] n) := by
        simp [TensorProduct.smul_tmul']
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.tmul_mem_baseChange_of_mem _ hn)
    · simp
    · intro x y _ _ hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
    · intro c x _ hx
      rw [hsmul]
      exact Submodule.smul_mem _ _ hx
  exact key _ (h k)

/-- **The condition at a pushout.**  If `B_k = A_k ⊗_A B` and the image of `b` in `B_k` comes from
`a ∈ A_k`, then `1 ⊗ b = a ⊗ 1` lies in the `A_k`-submodule generated by the image of `A`. -/
theorem one_tmul_mem_baseChange_of_isPushout {Ak Bk : Type u} [CommRing Ak] [CommRing Bk]
    [Algebra A Ak] [Algebra B Bk] [Algebra Ak Bk] [Algebra A Bk] [IsScalarTower A Ak Bk]
    [IsScalarTower A B Bk] [Algebra.IsPushout A Ak B Bk] (b : B) (a : Ak)
    (h : algebraMap B Bk b = algebraMap Ak Bk a) :
    (1 : Ak) ⊗ₜ[A] b ∈ (LinearMap.range (Algebra.linearMap A B)).baseChange Ak := by
  have h1 : (1 : Ak) ⊗ₜ[A] b = a • ((1 : Ak) ⊗ₜ[A] (1 : B)) := by
    apply (Algebra.IsPushout.equiv A Ak B Bk).injective
    rw [map_smul, Algebra.IsPushout.equiv_tmul, Algebra.IsPushout.equiv_tmul, map_one, map_one,
      one_mul, mul_one, h, Algebra.smul_def, mul_one]
  rw [h1]
  exact Submodule.smul_mem _ _ (Submodule.tmul_mem_baseChange_of_mem _ ⟨1, by simp⟩)

/-- **Descent of membership in the image along a finite flat cover.**  Let `A_k`, `k ∈ ι` finite,
be flat `A`-algebras whose spectra cover `Spec A`, and `B_k = A_k ⊗_A B`.  If the image of `b ∈ B`
in every `B_k` comes from `A_k`, then `b` comes from `A`. -/
theorem mem_range_of_isPushout_cover {ι : Type*} [Finite ι]
    (Ak Bk : ι → Type u) [∀ k, CommRing (Ak k)] [∀ k, CommRing (Bk k)] [∀ k, Algebra A (Ak k)]
    [∀ k, Algebra B (Bk k)] [∀ k, Algebra (Ak k) (Bk k)] [∀ k, Algebra A (Bk k)]
    [∀ k, IsScalarTower A (Ak k) (Bk k)] [∀ k, IsScalarTower A B (Bk k)]
    [∀ k, Algebra.IsPushout A (Ak k) B (Bk k)] [∀ k, Module.Flat A (Ak k)]
    (hcov : ∀ p : PrimeSpectrum A, ∃ k, ∃ q : PrimeSpectrum (Ak k),
      PrimeSpectrum.comap (algebraMap A (Ak k)) q = p)
    (b : B) (hb : ∀ k, ∃ a : Ak k, algebraMap B (Bk k) b = algebraMap (Ak k) (Bk k) a) :
    b ∈ (algebraMap A B).range := by
  classical
  have := Fintype.ofFinite ι
  have : Module.Flat A ((k : ι) → Ak k) :=
    Module.Flat.of_linearEquiv (DFinsupp.linearEquivFunOnFintype (R := A) (M := Ak)).symm
  have : Module.FaithfullyFlat A ((k : ι) → Ak k) := by
    refine Module.FaithfullyFlat.of_comap_surjective fun p => ?_
    obtain ⟨k, q, hq⟩ := hcov p
    refine ⟨PrimeSpectrum.comap (Pi.evalRingHom Ak k) q, ?_⟩
    rw [← hq, ← PrimeSpectrum.comap_comp_apply]
    rfl
  refine mem_range_of_one_tmul_mem_baseChange (C := (k : ι) → Ak k) b ?_
  refine one_tmul_mem_baseChange_pi Ak b fun k => ?_
  obtain ⟨a, ha⟩ := hb k
  exact one_tmul_mem_baseChange_of_isPushout b a ha

end Stacks.RangeDescent

end
