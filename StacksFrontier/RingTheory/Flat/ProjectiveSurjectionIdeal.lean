module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.LinearAlgebra.Finsupp.Defs
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness
public import Mathlib.RingTheory.Ideal.Maps

/-!
# The ideal cutting out where a surjection from a projective module becomes an isomorphism

Let `u : M → N` be a surjection of modules over a commutative ring `A` with `M` projective.
Stacks Tag 05PE asserts that there is an ideal `I ⊆ A` such that for every ring map
`A → B` the base change `u ⊗ 1 : M ⊗_A B → N ⊗_A B` is an isomorphism exactly when `I` dies
in `B`.

The ideal is `Module.kerCoeffIdeal u`, generated by the values of the `A`-linear functionals on
`M` at the elements of `ker u`.  For a free module with a fixed basis these values are the
coordinates of the elements of `ker u`, which is how the source describes the ideal; the
description by functionals needs no basis and is already correct for a projective module.

## Main definitions

* `Module.kerCoeffIdeal` is the ideal generated by the values of the functionals on `M` at the
  elements of `ker u`.

## Main results

* `Module.tmul_one_eq_zero_iff_forall_algebraMap_eq_zero`: for `M` projective, `1 ⊗ m` vanishes
  in `B ⊗_A M` exactly when every functional on `M` sends `m` into the kernel of `A → B`.  This
  is the one step that uses projectivity, and it is the reason a basis is not needed.
* `Module.injective_lTensor_iff_kerCoeffIdeal_le_ker`: `1 ⊗ u` is injective exactly when
  `Module.kerCoeffIdeal u` dies in `B`.
* `Module.bijective_rTensor_iff_map_kerCoeffIdeal_eq_bot` names the ideal of Stacks Tag 05PE:
  the base change of `u` along `A → B` is an isomorphism exactly when `Module.kerCoeffIdeal u`
  dies in `B`.  The existential form of the tag,
  `Module.exists_ideal_bijective_rTensor_iff_map_eq_bot`, is in
  `StacksFrontier/AlgebraicGeometry/Flatness/Flattening/VanishingAfterBaseChange.lean`.

## Implementation notes

The source writes the base change of `u` as `u ⊗ 1 : M ⊗_A B → N ⊗_A B`, which is
`LinearMap.rTensor B u`; the proofs run on the other side, `LinearMap.lTensor B u`, because
`B ⊗_A M` is a `B`-module and so an element `b ⊗ k` is `b • (1 ⊗ k)`, which is what reduces the
vanishing of the whole image of `B ⊗_A ker u` to the vanishing of the elements `1 ⊗ k`.  The two
sides are exchanged by `LinearMap.lTensor_bij_iff_rTensor_bij`, so the headline statement is
stated in the orientation of the source.

Surjectivity of the base change is automatic, so the content is its injectivity; that is the
right exactness of the tensor product, `lTensor_exact`, applied to
`ker u → M → N`.

## References

* [Stacks Project, Tag 05PE](https://stacks.math.columbia.edu/tag/05PE)
-/

@[expose] public section

open scoped TensorProduct

universe u v v' x

namespace Module

variable {A : Type u} [CommRing A] {M : Type v} {N : Type v'} [AddCommGroup M] [Module A M]
  [AddCommGroup N] [Module A N]

/-- The ideal of `A` generated by the values of the `A`-linear functionals on `M` at the elements
of the kernel of `u`.  For a free `M` with a fixed basis it is generated by the coordinates of
the elements of `ker u`, which is the description in Stacks Tag 05PE. -/
def kerCoeffIdeal (u : M →ₗ[A] N) : Ideal A :=
  Ideal.span {a : A | ∃ f : M →ₗ[A] A, ∃ k ∈ LinearMap.ker u, f k = a}

/-- An ideal contains `Module.kerCoeffIdeal u` exactly when every functional on `M` carries
`ker u` into it. -/
theorem kerCoeffIdeal_le_iff {u : M →ₗ[A] N} {J : Ideal A} :
    kerCoeffIdeal u ≤ J ↔ ∀ f : M →ₗ[A] A, ∀ k ∈ LinearMap.ker u, f k ∈ J := by
  rw [kerCoeffIdeal, Ideal.span_le]
  exact ⟨fun h f k hk ↦ h ⟨f, k, hk, rfl⟩, fun h _ ⟨f, k, hk, hfk⟩ ↦ hfk ▸ h f k hk⟩

/-- If `1 ⊗ m` vanishes in `B ⊗_A M` then every functional on `M` sends `m` into the kernel of
`A → B`: apply the functional to the second factor and contract `B ⊗_A A` to `B`. -/
theorem algebraMap_apply_eq_zero_of_tmul_one_eq_zero (B : Type x) [CommRing B] [Algebra A B]
    {m : M} (h : (1 : B) ⊗ₜ[A] m = 0) (f : M →ₗ[A] A) : algebraMap A B (f m) = 0 := by
  have h2 : TensorProduct.rid A B (f.lTensor B ((1 : B) ⊗ₜ[A] m)) = 0 := by
    rw [h, map_zero, map_zero]
  rwa [LinearMap.lTensor_tmul, TensorProduct.rid_tmul, ← Algebra.algebraMap_eq_smul_one] at h2

/-- If every functional on a projective module `M` sends `m` into the kernel of `A → B`, then
`1 ⊗ m` vanishes in `B ⊗_A M`.  A projective module has enough functionals: a splitting of
`Finsupp.linearCombination` writes `m` as a finite combination of elements of `M` whose
coefficients are values of functionals at `m`. -/
theorem tmul_one_eq_zero_of_forall_algebraMap_eq_zero [Module.Projective A M] (B : Type x)
    [CommRing B] [Algebra A B] {m : M} (h : ∀ f : M →ₗ[A] A, algebraMap A B (f m) = 0) :
    (1 : B) ⊗ₜ[A] m = 0 := by
  obtain ⟨s, hs⟩ := Module.projective_def.mp ‹Module.Projective A M›
  rw [← hs m, Finsupp.linearCombination_apply, Finsupp.sum, TensorProduct.tmul_sum]
  refine Finset.sum_eq_zero fun y _ ↦ ?_
  have hy : algebraMap A B (s m y) = 0 := by
    have := h (Finsupp.lapply y ∘ₗ s)
    rwa [LinearMap.comp_apply, Finsupp.lapply_apply] at this
  calc (1 : B) ⊗ₜ[A] (s m y • (id y : M))
      = (s m y • (1 : B)) ⊗ₜ[A] (id y : M) := (TensorProduct.smul_tmul _ _ _).symm
    _ = (0 : B) ⊗ₜ[A] (id y : M) := by rw [← Algebra.algebraMap_eq_smul_one, hy]
    _ = 0 := TensorProduct.zero_tmul _ _

/-- For a projective module `M`, the element `1 ⊗ m` of `B ⊗_A M` vanishes exactly when every
functional on `M` sends `m` into the kernel of `A → B`. -/
theorem tmul_one_eq_zero_iff_forall_algebraMap_eq_zero [Module.Projective A M] (B : Type x)
    [CommRing B] [Algebra A B] (m : M) :
    (1 : B) ⊗ₜ[A] m = 0 ↔ ∀ f : M →ₗ[A] A, algebraMap A B (f m) = 0 :=
  ⟨fun h f ↦ algebraMap_apply_eq_zero_of_tmul_one_eq_zero B h f,
    fun h ↦ tmul_one_eq_zero_of_forall_algebraMap_eq_zero B h⟩

/-- The base change of a surjection from a projective module is injective exactly when
`Module.kerCoeffIdeal u` dies in `B`.

By right exactness of the tensor product the kernel of `1 ⊗ u` is the image of `B ⊗_A ker u`,
which is generated as a `B`-module by the elements `1 ⊗ k` with `k ∈ ker u`; those vanish
exactly when the functionals carry `ker u` into the kernel of `A → B`. -/
theorem injective_lTensor_iff_kerCoeffIdeal_le_ker [Module.Projective A M] {u : M →ₗ[A] N}
    (hu : Function.Surjective u) (B : Type x) [CommRing B] [Algebra A B] :
    Function.Injective (u.lTensor B) ↔ kerCoeffIdeal u ≤ RingHom.ker (algebraMap A B) := by
  rw [kerCoeffIdeal_le_iff]
  refine ⟨fun hinj f k hk ↦ ?_, fun hle a b hab ↦ ?_⟩
  · refine RingHom.mem_ker.mpr (algebraMap_apply_eq_zero_of_tmul_one_eq_zero B (hinj ?_) f)
    rw [LinearMap.lTensor_tmul, LinearMap.mem_ker.mp hk, TensorProduct.tmul_zero, map_zero]
  · have hzero : ∀ z : B ⊗[A] (LinearMap.ker u), (LinearMap.ker u).subtype.lTensor B z = 0 := by
      intro z
      induction z with
      | tmul b k =>
          have hk : (1 : B) ⊗ₜ[A] (k : M) = 0 :=
            (tmul_one_eq_zero_iff_forall_algebraMap_eq_zero B _).mpr fun f ↦
              RingHom.mem_ker.mp (hle f k k.2)
          calc (LinearMap.ker u).subtype.lTensor B (b ⊗ₜ[A] k)
              = b ⊗ₜ[A] (k : M) := rfl
            _ = b • ((1 : B) ⊗ₜ[A] (k : M)) := by
                rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            _ = 0 := by rw [hk, smul_zero]
      | add z z' hz hz' => rw [map_add, hz, hz', add_zero]
    obtain ⟨z, hz⟩ := (lTensor_exact B u.exact_subtype_ker_map hu (a - b)).mp
      (by rw [map_sub, hab, sub_self])
    exact sub_eq_zero.mp (hz ▸ hzero z)

/-- The base change of a surjection from a projective module is an isomorphism exactly when
`Module.kerCoeffIdeal u` dies in `B`; surjectivity of the base change is automatic. -/
theorem bijective_lTensor_iff_map_kerCoeffIdeal_eq_bot [Module.Projective A M] {u : M →ₗ[A] N}
    (hu : Function.Surjective u) (B : Type x) [CommRing B] [Algebra A B] :
    Function.Bijective (u.lTensor B) ↔ Ideal.map (algebraMap A B) (kerCoeffIdeal u) = ⊥ := by
  rw [Ideal.map_eq_bot_iff_le_ker, ← injective_lTensor_iff_kerCoeffIdeal_le_ker hu B]
  exact ⟨And.left, fun h ↦ ⟨h, LinearMap.lTensor_surjective B hu⟩⟩

/-- Stacks Tag 05PE in the orientation of the source: `u ⊗ 1 : M ⊗_A B → N ⊗_A B` is an
isomorphism exactly when `Module.kerCoeffIdeal u` dies in `B`. -/
theorem bijective_rTensor_iff_map_kerCoeffIdeal_eq_bot [Module.Projective A M] {u : M →ₗ[A] N}
    (hu : Function.Surjective u) (B : Type x) [CommRing B] [Algebra A B] :
    Function.Bijective (u.rTensor B) ↔ Ideal.map (algebraMap A B) (kerCoeffIdeal u) = ⊥ := by
  rw [← LinearMap.lTensor_bij_iff_rTensor_bij]
  exact bijective_lTensor_iff_map_kerCoeffIdeal_eq_bot hu B

end Module

end
