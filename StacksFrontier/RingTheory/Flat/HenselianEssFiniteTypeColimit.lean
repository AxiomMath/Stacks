module

public import StacksFrontier.RingTheory.Flat.HenselianFlatFiniteColimit
public import StacksFrontier.RingTheory.Flat.MittagLefflerEssFiniteType

/-!
# Finite flat modules over a henselian base, essentially of finite type (Stacks 05U7)

Let `A → B` be a local homomorphism of local rings which is essentially of finite type, and let
`N` be a finite `B`-module which is flat as an `A`-module. If `A` is henselian, then `N` is a
filtered colimit of free `A`-modules whose transition maps are injective modulo `𝔪_A`, and `N` is
a Mittag-Leffler `A`-module (Stacks 05U7).

The source realises `N` as the stalk of a finite type quasi-coherent module on a scheme of finite
type over `Spec A`. Here `B` is a localization of the image of a polynomial ring
`R = A[x_1, …, x_n]`, and `N` is the localization at the prime under `𝔪_B` of the finite
`R`-submodule generated by finitely many generators of `N`
(`Module.exists_polynomial_localizedModule_linearEquiv`). The colimit presentation is then
`AlgebraicGeometry.exists_colimit_free_of_flat_localizedModule`, and the Mittag-Leffler
conclusion follows from it by Stacks 05FQ and 0AS7
(`isMittagLeffler_of_flat_finite_essFiniteType_local`).

## Main results

* `Module.exists_polynomial_localizedModule_linearEquiv`: the algebraic reduction.
* `exists_filteredColimit_free_with_injective_reduction_and_isMittagLeffler`: Stacks 05U7.

## References

* [Stacks Project, Tag 05U7](https://stacks.math.columbia.edu/tag/05U7)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u v uM uP uQ uN

namespace Module

/-- **The algebraic reduction for Stacks 05U7.** Let `A → B` be a local homomorphism of local
rings, essentially of finite type, and let `N` be a finite `B`-module. Then there are a
polynomial ring `R` over `A` in finitely many variables mapping to `B`, the prime `q` of `R`
under the maximal ideal of `B`, which lies over the maximal ideal of `A`, and a finite
`R`-module `M` whose localization at `q` is `A`-linearly isomorphic to `N`. -/
theorem exists_polynomial_localizedModule_linearEquiv {A : Type u} {B : Type v} {N : Type uM}
    [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] (hB : Algebra.EssFiniteType A B)
    [AddCommGroup N] [Module A N] [Module B N] [IsScalarTower A B N] [Module.Finite B N] :
    ∃ (n : ℕ) (q : Ideal (MvPolynomial (Fin n) A)) (_ : q.IsPrime)
      (M : Type u) (_ : AddCommGroup M) (_ : Module (MvPolynomial (Fin n) A) M)
      (_ : Module.Finite (MvPolynomial (Fin n) A) M) (_ : Module A M)
      (_ : IsScalarTower A (MvPolynomial (Fin n) A) M),
      q.comap (algebraMap A (MvPolynomial (Fin n) A)) = maximalIdeal A ∧
        Nonempty (LocalizedModule q.primeCompl M ≃ₗ[A] N) := by
  classical
  obtain ⟨s, hs⟩ := (Algebra.essFiniteType_iff A B).mp hB
  set n := s.card
  set R := MvPolynomial (Fin n) A
  let g : R →ₐ[A] B := MvPolynomial.aeval (fun i => (s.equivFin.symm i : B))
  have hrange : (Algebra.adjoin A (s : Set B)) = g.range := by
    rw [MvPolynomial.aeval_range]
    congr 1
    ext b
    constructor
    · intro hb
      exact ⟨s.equivFin ⟨b, hb⟩, by simp⟩
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
  let : Algebra R B := g.toRingHom.toAlgebra
  have : IsScalarTower A R B := IsScalarTower.of_algebraMap_eq fun a => (g.commutes a).symm
  let : Module R N := Module.compHom N (algebraMap R B)
  have : IsScalarTower R B N := IsScalarTower.of_compHom R B N
  have : IsScalarTower A R N := IsScalarTower.of_algebraMap_smul fun a y => by
    change algebraMap R B (algebraMap A R a) • y = a • y
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_smul]
  have hfrac : ∀ b : B, ∃ t c : R, IsUnit (algebraMap R B t) ∧
      b * algebraMap R B t = algebraMap R B c := by
    intro b
    obtain ⟨t, ht, htu, hbt⟩ := hs b
    rw [hrange] at ht hbt
    obtain ⟨t', rfl⟩ := ht
    obtain ⟨c', hc'⟩ := hbt
    exact ⟨t', c', htu, hc'.symm⟩
  set q : Ideal R := (maximalIdeal B).comap (algebraMap R B) with hqdef
  have : q.IsPrime := Ideal.comap_isPrime _ _
  have hq : q.comap (algebraMap A R) = maximalIdeal A := by
    rw [hqdef, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq]
    exact IsLocalRing.maximalIdeal_comap (algebraMap A B)
  -- the `R`-submodule generated by finitely many `B`-module generators of `N`
  obtain ⟨k, gen, hgen⟩ := Module.Finite.exists_fin (R := B) (M := N)
  let κ : (Fin k →₀ R) →ₗ[R] N := Finsupp.linearCombination R gen
  set M₀ : Submodule R N := LinearMap.range κ with hM₀
  let M := (Fin k →₀ R) ⧸ LinearMap.ker κ
  let fN : M →ₗ[R] N := (LinearMap.ker κ).liftQ κ le_rfl
  have hfNinj : Function.Injective fN := by
    rw [← LinearMap.ker_eq_bot]
    exact Submodule.ker_liftQ_eq_bot _ _ _ le_rfl
  have hfNrange : ∀ y ∈ M₀, ∃ m, fN m = y := by
    rintro y ⟨v, rfl⟩
    exact ⟨Submodule.Quotient.mk v, rfl⟩
  have hgenM₀ : ∀ i, gen i ∈ M₀ := fun i =>
    ⟨Finsupp.single i 1, by simp [κ]⟩
  have hfN : IsLocalizedModule q.primeCompl fN := by
    refine ⟨fun t => ?_, fun y => ?_, fun {m₁ m₂} h => ⟨1, ?_⟩⟩
    · obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp t.2
      rw [Module.End.isUnit_iff]
      refine ⟨fun y₁ y₂ h => ?_, fun y => ⟨(↑u⁻¹ : B) • y, ?_⟩⟩
      · have h' : (algebraMap R B t) • y₁ = (algebraMap R B t) • y₂ := h
        rw [← hu] at h'
        simpa [smul_smul] using congrArg (fun z => (↑u⁻¹ : B) • z) h'
      · change (algebraMap R B t) • ((↑u⁻¹ : B) • y) = y
        rw [← hu, smul_smul, Units.mul_inv, one_smul]
    · -- every element of `N` has a multiple, by an element outside `q`, in `M₀`
      have key : ∀ y : N, ∃ t : q.primeCompl, (t : R) • y ∈ M₀ := by
        intro y
        have hy : y ∈ Submodule.span B (Set.range gen) := hgen ▸ Submodule.mem_top
        induction hy using Submodule.span_induction with
        | mem y hy =>
          obtain ⟨i, rfl⟩ := hy
          exact ⟨1, by rw [OneMemClass.coe_one, one_smul]; exact hgenM₀ i⟩
        | zero => exact ⟨1, by rw [smul_zero]; exact M₀.zero_mem⟩
        | add y₁ y₂ _ _ h₁ h₂ =>
          obtain ⟨t₁, ht₁⟩ := h₁
          obtain ⟨t₂, ht₂⟩ := h₂
          refine ⟨t₁ * t₂, ?_⟩
          rw [smul_add, Submonoid.coe_mul]
          refine M₀.add_mem ?_ ?_
          · rw [mul_comm, mul_smul]; exact M₀.smul_mem _ ht₁
          · rw [mul_smul]; exact M₀.smul_mem _ ht₂
        | smul b y _ h =>
          obtain ⟨t, ht⟩ := h
          obtain ⟨t', c', ht'u, hbt'⟩ := hfrac b
          have ht'q : t' ∈ q.primeCompl := fun h =>
            (IsLocalRing.notMem_maximalIdeal.mpr ht'u) h
          refine ⟨⟨t', ht'q⟩ * t, ?_⟩
          rw [Submonoid.coe_mul, mul_smul]
          have : (t : R) • b • y = b • ((t : R) • y) := smul_comm _ _ _
          rw [this]
          change algebraMap R B t' • b • ((t : R) • y) ∈ M₀
          rw [smul_smul, mul_comm, hbt']
          exact M₀.smul_mem c' ht
      obtain ⟨t, ht⟩ := key y
      obtain ⟨m, hm⟩ := hfNrange _ ht
      exact ⟨⟨m, t⟩, hm.symm⟩
    · rw [one_smul, one_smul]
      exact hfNinj h
  refine ⟨n, q, inferInstance, M, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, hq, ⟨?_⟩⟩
  exact ((IsLocalizedModule.iso q.primeCompl fN).restrictScalars A)

end Module

/-- **Stacks Project, Tag 05U7.** Let `A → B` be a local homomorphism of local rings which is
essentially of finite type, and let `N` be a finite `B`-module which is flat as an `A`-module. If
`A` is henselian, then `N` is a filtered colimit `N = colim_i F_i` of free `A`-modules `F_i` such
that every transition map `F_i → F_{i'}` of the system induces an injective map
`F_i/𝔪_A F_i → F_{i'}/𝔪_A F_{i'}`. Also, `N` is a Mittag-Leffler `A`-module.

The colimit is computed in `ModuleCat A`, in the joint universe of `A` and `N`, so its vertex is
compared with the universe lift of `N`; `F_i/𝔪_A F_i` is `F_i ⧸ 𝔪_A • ⊤` and the induced map is
`Submodule.mapQ`. The Mittag-Leffler condition is that of Stacks 059F, with the finitely
presented source and the test module in arbitrary universes. -/
@[stacks 05U7]
theorem exists_filteredColimit_free_with_injective_reduction_and_isMittagLeffler
    {A : Type u} {B : Type v} {N : Type uM} [CommRing A] [CommRing B]
    [IsLocalRing B] [HenselianLocalRing A]
    [Algebra A B] [IsLocalHom (algebraMap A B)]
    (hB : Algebra.EssFiniteType A B)
    [AddCommGroup N] [Module A N] [Module B N] [IsScalarTower A B N]
    [Module.Finite B N] [Module.Flat A N] :
    (∃ (I : Type (max u uM)) (_ : SmallCategory I) (_ : IsFiltered I)
      (F : I ⥤ ModuleCat.{max u uM} A) (c : Cocone F),
      (∀ i, Module.Free A (F.obj i)) ∧
      (∀ {i j : I} (f : i ⟶ j), Function.Injective
        (Submodule.mapQ
          (maximalIdeal A • (⊤ : Submodule A (F.obj i)))
          (maximalIdeal A • (⊤ : Submodule A (F.obj j)))
          (F.map f).hom
          (Submodule.smul_top_le_comap_smul_top (maximalIdeal A)
            (F.map f).hom))) ∧
      Nonempty (IsColimit c) ∧
      Nonempty (c.pt ≅ ModuleCat.of A (ULift.{u} N))) ∧
    IsMittagLeffler.{u, uP, uM, max u uQ, uN} A N := by
  obtain ⟨n, q, _, M, _, _, _, _, _, hq, ⟨eN⟩⟩ :=
    Module.exists_polynomial_localizedModule_linearEquiv (N := N) hB
  obtain ⟨I, _, _, _, F, c, hfree, hinj, ⟨hc⟩, ⟨e⟩⟩ :=
    AlgebraicGeometry.exists_colimit_free_of_flat_localizedModule q hq M
      (Module.Flat.of_linearEquiv eN) eN
  exact ⟨⟨I, inferInstance, inferInstance, F, c, hfree, hinj, ⟨hc⟩, ⟨e⟩⟩,
    isMittagLeffler_of_flat_finite_essFiniteType_local hB⟩
