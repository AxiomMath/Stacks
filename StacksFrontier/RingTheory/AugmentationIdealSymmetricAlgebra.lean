module

public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Cotangent

/-!
# The conormal module of the augmentation ideal of a symmetric algebra

Let `A` be a commutative ring and `K` an arbitrary `A`-module. The augmentation
`ε = SymmetricAlgebra.algebraMapInv : Sym_A(K) →ₐ[A] A` retracts the structure map, and its
kernel `I` is the *augmentation ideal*, the sum of the symmetric powers of positive degree.
This file identifies the conormal module of `I`:

`I / I² ≅ K`

as `A`-modules, the class of `ι k` corresponding to `k`.

**No hypothesis on `K`.** It is an arbitrary module over an arbitrary commutative ring: not
free, not finitely generated, with no projectivity and no flatness assumption.
`MvPolynomial.augmentationGradedOneEquiv` is the same statement for a *polynomial* ring, that
is for a free module `K`.

## Main definitions

* `SymmetricAlgebra.augmentationIdeal A K`: the kernel of `SymmetricAlgebra.algebraMapInv`.
* `SymmetricAlgebra.augmentationToCotangent`: the `A`-linear map `K → I / I²` sending `k` to the
  class of `ι k`.

## Main results

* `SymmetricAlgebra.span_range_ι_eq_augmentationIdeal`: the augmentation ideal is generated by
  the degree-one elements.
* `SymmetricAlgebra.augmentationIdeal_le_range_ι_sup_sq`: every element of `I` is a degree-one
  element plus an element of `I²`. This is surjectivity of `K → I / I²`.
* `SymmetricAlgebra.eq_zero_of_ι_mem_augmentationIdeal_sq`: a degree-one element lying in `I²`
  is zero. This is injectivity of `K → I / I²`.
* `SymmetricAlgebra.augmentationCotangentEquiv`: **the main result**, the `A`-linear isomorphism
  `I / I² ≃ₗ[A] K`.
* `SymmetricAlgebra.augmentationCotangentEquiv_toCotangent_ι`: **the characterising equation**,
  the class of `ι k` is carried to `k`.

## Implementation notes

The conormal module is spelled as Mathlib's `Ideal.Cotangent`, which is `↥I ⧸ (I • ⊤)` carrying
the `A`-action restricted from `Sym_A(K)`.

Both halves of the proof avoid the graded decomposition of `Sym_A(K)`:

* Surjectivity is an induction over the generators of `I` as an ideal. The step that carries it
  is that an arbitrary scalar `s` splits as `algebraMap (ε s) + (s - algebraMap (ε s))` with the
  second summand in `I`; so `s * ι k` is `ι (ε s • k)` plus an element of `I · I`.
* Injectivity is the universal property applied to the trivial square-zero extension
  `TrivSqZeroExt A K = A ⊕ K`. The resulting algebra map `φ : Sym_A(K) → A ⊕ K` has first
  component `ε`, so a product of two elements of `I` has both first components zero and
  therefore, the extension being square-zero, vanishing second component; while `φ (ι k)` has
  second component `k`. The right `A`-action on `K` that the square-zero extension needs is
  supplied from the left one by commutativity of `A`, and stays inside the proof.
-/

@[expose] public noncomputable section

namespace SymmetricAlgebra

variable (A K : Type*) [CommRing A] [AddCommGroup K] [Module A K]

/-- **The augmentation ideal of `Sym_A(K)`**: the kernel of the augmentation
`SymmetricAlgebra.algebraMapInv : Sym_A(K) →ₐ[A] A`, the `A`-algebra map killing the degree-one
elements. For the grading of `Sym_A(K)` by the symmetric powers this is the sum of the pieces
of positive degree. -/
def augmentationIdeal : Ideal (SymmetricAlgebra A K) :=
  RingHom.ker (algebraMapInv (R := A) (M := K)).toRingHom

variable {A K}

/-- An element of `Sym_A(K)` lies in the augmentation ideal if and only if its augmentation
vanishes. -/
theorem mem_augmentationIdeal {x : SymmetricAlgebra A K} :
    x ∈ augmentationIdeal A K ↔ algebraMapInv x = 0 :=
  RingHom.mem_ker

/-- A degree-one element lies in the augmentation ideal. -/
theorem ι_mem_augmentationIdeal (k : K) : ι A K k ∈ augmentationIdeal A K :=
  mem_augmentationIdeal.2 (algebraMapInv_ι k)

/-- **The augmentation splits off the constant term.** Subtracting the image of its augmentation
puts any element of `Sym_A(K)` into the augmentation ideal. -/
theorem sub_algebraMap_algebraMapInv_mem_augmentationIdeal (x : SymmetricAlgebra A K) :
    x - algebraMap A (SymmetricAlgebra A K) (algebraMapInv x) ∈ augmentationIdeal A K := by
  rw [mem_augmentationIdeal, map_sub, algebraMap_leftInverse K (algebraMapInv x), sub_self]

/-- **The augmentation ideal is generated by the degree-one elements.** -/
theorem span_range_ι_eq_augmentationIdeal :
    Ideal.span (Set.range (ι A K)) = augmentationIdeal A K := by
  refine le_antisymm (Ideal.span_le.2 ?_) fun x hx => ?_
  · rintro _ ⟨k, rfl⟩
    exact ι_mem_augmentationIdeal k
  · have key : ∀ y : SymmetricAlgebra A K,
        y - algebraMap A (SymmetricAlgebra A K) (algebraMapInv y) ∈
          Ideal.span (Set.range (ι A K)) := by
      intro y
      induction y using SymmetricAlgebra.induction with
      | algebraMap r =>
          rw [algebraMap_leftInverse K r, sub_self]
          exact zero_mem _
      | ι m =>
          rw [algebraMapInv_ι, map_zero, sub_zero]
          exact Ideal.subset_span ⟨m, rfl⟩
      | mul a b ha hb =>
          convert Ideal.add_mem _ (Ideal.mul_mem_right b _ ha)
            (Ideal.mul_mem_left _ (algebraMap A (SymmetricAlgebra A K) (algebraMapInv a)) hb)
            using 1
          simp only [map_mul]
          ring
      | add a b ha hb =>
          convert Ideal.add_mem _ ha hb using 1
          simp only [map_add]
          ring
    have hx' := key x
    rwa [mem_augmentationIdeal.1 hx, map_zero, sub_zero] at hx'

/-- **Every element of the augmentation ideal is a degree-one element plus an element of `I²`.**
In graded terms: the summands of degree at least two make up `I²`. -/
theorem augmentationIdeal_le_range_ι_sup_sq :
    (augmentationIdeal A K).restrictScalars A ≤
      LinearMap.range (ι A K) ⊔ (augmentationIdeal A K ^ 2).restrictScalars A := by
  intro x hx
  replace hx : x ∈ Ideal.span (Set.range (ι A K)) := by
    rwa [span_range_ι_eq_augmentationIdeal]
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨k, rfl⟩ := hy
      exact Submodule.mem_sup_left (LinearMap.mem_range_self _ k)
  | zero => exact zero_mem _
  | add y z _ _ ihy ihz => exact add_mem ihy ihz
  | smul s y _ ih =>
      obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.1 ih
      obtain ⟨k, rfl⟩ := hu
      have hv' : v ∈ augmentationIdeal A K ^ 2 := hv
      have hsm : ι A K (algebraMapInv s • k)
          = algebraMap A (SymmetricAlgebra A K) (algebraMapInv s) * ι A K k := by
        rw [map_smul]
        exact Algebra.smul_def _ _
      have key : s • (ι A K k + v)
          = ι A K (algebraMapInv s • k)
            + ((s - algebraMap A (SymmetricAlgebra A K) (algebraMapInv s)) * ι A K k + s * v) := by
        rw [hsm, smul_eq_mul]
        ring
      rw [key]
      refine add_mem (Submodule.mem_sup_left (LinearMap.mem_range_self _ _))
        (Submodule.mem_sup_right (add_mem ?_ ?_))
      · show _ ∈ augmentationIdeal A K ^ 2
        rw [pow_two]
        exact Ideal.mul_mem_mul (sub_algebraMap_algebraMapInv_mem_augmentationIdeal s)
          (ι_mem_augmentationIdeal k)
      · show _ ∈ augmentationIdeal A K ^ 2
        exact Ideal.mul_mem_left _ _ hv'

/-- **A degree-one element lying in the square of the augmentation ideal is zero.**

The witness is the trivial square-zero extension `A ⊕ K`: the `A`-algebra map
`φ : Sym_A(K) → A ⊕ K` extending `k ↦ (0, k)` has first component the augmentation, so it kills
`I²` in its second component, while `φ (ι k) = (0, k)`. -/
theorem eq_zero_of_ι_mem_augmentationIdeal_sq {k : K}
    (hk : ι A K k ∈ augmentationIdeal A K ^ 2) : k = 0 := by
  let _ : Module Aᵐᵒᵖ K := Module.compHom K ((RingHom.id A).fromOpposite fun a b => mul_comm a b)
  have _ : IsCentralScalar A K := ⟨fun _ _ => rfl⟩
  let _ : CommRing (TrivSqZeroExt A K) := TrivSqZeroExt.commRing
  let f : K →ₗ[A] TrivSqZeroExt A K :=
    { toFun := fun m => TrivSqZeroExt.inr m
      map_add' := fun a b => by simp
      map_smul' := fun r a => by simp }
  have hf : ∀ m : K, lift f (ι A K m) = TrivSqZeroExt.inr m := fun m => by simp [f]
  have hfst : ∀ x : SymmetricAlgebra A K, (lift f x).fst = algebraMapInv x := by
    intro x
    induction x using SymmetricAlgebra.induction with
    | algebraMap r =>
        rw [AlgHom.commutes, algebraMap_leftInverse K r]
        rfl
    | ι m => rw [hf m, TrivSqZeroExt.fst_inr, algebraMapInv_ι]
    | mul a b ha hb => rw [map_mul, map_mul, TrivSqZeroExt.fst_mul, ha, hb]
    | add a b ha hb => rw [map_add, map_add, TrivSqZeroExt.fst_add, ha, hb]
  have hsnd : ∀ x ∈ augmentationIdeal A K ^ 2, (lift f x).snd = 0 := by
    intro x hx
    rw [pow_two] at hx
    refine Submodule.mul_induction_on hx (fun a ha b hb => ?_) fun u v hu hv => ?_
    · rw [map_mul, TrivSqZeroExt.snd_mul, hfst, hfst, mem_augmentationIdeal.1 ha,
        mem_augmentationIdeal.1 hb]
      simp
    · rw [map_add, TrivSqZeroExt.snd_add, hu, hv, add_zero]
  have hzero := hsnd _ hk
  rwa [hf k, TrivSqZeroExt.snd_inr] at hzero

/-- **The comparison map `K → I / I²`**: a degree-one element of `Sym_A(K)` lies in the
augmentation ideal, and this sends it to its class in the conormal module. -/
def augmentationToCotangent : K →ₗ[A] (augmentationIdeal A K).Cotangent :=
  (augmentationIdeal A K).toCotangent.restrictScalars A ∘ₗ
    (ι A K).codRestrict ((augmentationIdeal A K).restrictScalars A) ι_mem_augmentationIdeal

/-- `SymmetricAlgebra.augmentationToCotangent` sends `k` to the class of `ι k` in `I / I²`. -/
@[simp]
theorem augmentationToCotangent_apply (k : K) :
    augmentationToCotangent k =
      (augmentationIdeal A K).toCotangent ⟨ι A K k, ι_mem_augmentationIdeal k⟩ :=
  rfl

/-- The comparison map `K → I / I²` is injective. -/
theorem augmentationToCotangent_injective :
    Function.Injective (augmentationToCotangent (A := A) (K := K)) := by
  rw [injective_iff_map_eq_zero]
  intro k hk
  rw [augmentationToCotangent_apply, Ideal.toCotangent_eq_zero] at hk
  exact eq_zero_of_ι_mem_augmentationIdeal_sq hk

/-- The comparison map `K → I / I²` is surjective. -/
theorem augmentationToCotangent_surjective :
    Function.Surjective (augmentationToCotangent (A := A) (K := K)) := by
  intro z
  obtain ⟨x, rfl⟩ := (augmentationIdeal A K).toCotangent_surjective z
  obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.1 (augmentationIdeal_le_range_ι_sup_sq x.2)
  obtain ⟨k, rfl⟩ := hu
  refine ⟨k, ?_⟩
  rw [augmentationToCotangent_apply, Ideal.toCotangent_eq]
  have h : (ι A K k : SymmetricAlgebra A K) - (x : SymmetricAlgebra A K) = -v := by
    rw [← huv]
    ring
  rw [h]
  exact neg_mem hv

/-- **The conormal module of the augmentation ideal of `Sym_A(K)` is `K`**, for an arbitrary
module `K` over an arbitrary commutative ring `A`:

`I / I² ≃ₗ[A] K`, where `I = ker (Sym_A(K) → A)`.

The identification is the canonical one: by
`SymmetricAlgebra.augmentationCotangentEquiv_toCotangent_ι` it carries the class of the
degree-one element `ι k` to `k`. -/
def augmentationCotangentEquiv : (augmentationIdeal A K).Cotangent ≃ₗ[A] K :=
  (LinearEquiv.ofBijective (augmentationToCotangent (A := A) (K := K))
    ⟨augmentationToCotangent_injective, augmentationToCotangent_surjective⟩).symm

/-- **The characterising equation of `SymmetricAlgebra.augmentationCotangentEquiv`**: the class
of the degree-one element `ι k` in `I / I²` corresponds to `k`. -/
@[simp]
theorem augmentationCotangentEquiv_toCotangent_ι (k : K)
    (hk : ι A K k ∈ augmentationIdeal A K) :
    augmentationCotangentEquiv ((augmentationIdeal A K).toCotangent ⟨ι A K k, hk⟩) = k :=
  (LinearEquiv.ofBijective (augmentationToCotangent (A := A) (K := K))
    ⟨augmentationToCotangent_injective, augmentationToCotangent_surjective⟩).symm_apply_apply k

/-- The inverse of `SymmetricAlgebra.augmentationCotangentEquiv` sends `k` to the class of
`ι k` in `I / I²`. -/
theorem augmentationCotangentEquiv_symm_apply (k : K) :
    augmentationCotangentEquiv.symm k =
      (augmentationIdeal A K).toCotangent ⟨ι A K k, ι_mem_augmentationIdeal k⟩ :=
  rfl

end SymmetricAlgebra

end
