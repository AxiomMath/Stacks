module

public import Mathlib.Algebra.Polynomial.Lifts
public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.FieldTheory.SeparableClosure
public import StacksFrontier.RingTheory.DiscreteValuationRing.EppCondition
public import StacksFrontier.RingTheory.DiscreteValuationRing.MonicResidueIrreducible

/-!
# The finite unramified base change of Epp's route

Epp's proof of elimination of wild ramification (Stacks Tag 09F9) begins by enlarging the base
discrete valuation ring `A` so that its residue field absorbs the *perfect core* of the residue
field upstairs.  The Stacks Project performs this enlargement by passing to separable closures of
both residue fields, a reduction organised by Tag 09ET whose literal statement is false.  Epp
instead makes a **finite unramified base
change**, and this file constructs it.

The mechanism is elementary once the pieces are named.  Epp's hypothesis
`Stacks.EppTheorem.EppCondition A B p` says every element of `perfectCore κ_B p` is separable
  algebraic
over `κ_A`.  When `κ_A` is perfect its image in `κ_B` lands inside the perfect core
(`mem_perfectCore_of_perfectRing`), so the perfect core is an *intermediate field* of `κ_B / κ_A`;
Epp's hypothesis then says exactly that this intermediate field is separable over `κ_A`.  Assuming
in addition that it is finite-dimensional, it is a finite separable extension, hence generated by a
single element `α` whose minimal polynomial `q = minpoly κ_A α` is monic, irreducible and
separable.  Lifting `q` to a monic `P ∈ A[X]` — possible because `A → κ_A` is surjective — puts us
in the situation of
`StacksFrontier.RingTheory.DiscreteValuationRing.MonicResidueIrreducible`: `A₁ = A[X] ⧸ (P)` is
again a discrete valuation ring, the extension `A₁ / A` is weakly unramified (`e = 1`), and its
residue field is `κ_A[X] ⧸ (q) ≅ perfectCore κ_B p`.

No completeness of `A` is used anywhere: the monogenic construction of
`MonicResidueIrreducible` is available over an arbitrary discrete valuation ring, so the
hypothesis `IsAdicComplete (maximalIdeal A) A` that the classical statement of this step carries
is not needed to *realise* the residue extension.  (Completeness is what makes `A₁` the *unique*
such extension and what the later steps of Epp's argument use; it plays no role here.)

## Main definitions

* `perfectCoreIntermediateField K L p`: the perfect core of `L`, viewed as an intermediate field
  of `L / K` when `K` is perfect.

## Main results

* `isSeparable_perfectCoreIntermediateField`,
  `Stacks.EppTheorem.EppCondition.isSeparable_perfectCore`:
  **layer (a)** — Epp's condition says precisely that the perfect core upstairs is a separable
  extension of `κ_A`.  Together with finite-dimensionality it is a finite separable extension.
* `exists_monic_lift_map_residue_eq`: **layer (b)** — a monic polynomial over the residue field of
  a local ring lifts to a monic polynomial over the ring.
* `AdjoinRoot.residueFieldAlgEquiv`: **layer (c)/(d)** — for monic `P` with irreducible reduction,
  the residue field of the unramified extension `A[X] ⧸ (P)` is `κ_A[X] ⧸ (P̄)`, as a
  `κ_A`-algebra.  This is the identification that turns the numerical statement
  `AdjoinRoot.finrank_residueField_eq_natDegree` into a description of the residue field.
* `AdjoinRoot.algEquivOfPrimitiveElement`: a primitive element of a field extension identifies it
  with the monogenic algebra on its minimal polynomial.
* `Stacks.EppTheorem.exists_isWeaklyUnramified_residueField_algEquiv_perfectCore`: **the theorem**
  — under
  Epp's condition and finite-dimensionality of the perfect core there is a finite, weakly
  unramified extension `A₁ / A` of discrete valuation rings whose residue field is
  `κ_A`-isomorphic to `perfectCore κ_B p`.

## References

* [Epp, *Elimination of wild ramification*][epp1973]
* [The Stacks Project, Tag 09F9](https://stacks.math.columbia.edu/tag/09F9)
-/

@[expose] public section

open IsLocalRing Polynomial

/-! ### The perfect core as an intermediate field -/

section PerfectCoreIntermediateField

variable (K L : Type*) [Field K] [Field L] [Algebra K L] (p : ℕ) [ExpChar K p] [PerfectRing K p]
  [ExpChar L p]

/-- **The perfect core of an extension of a perfect field is an intermediate field.**

`perfectCore L p` is a priori only a subfield of `L`.  If `K` is perfect — which in Epp's setting
is free — then every element of the image of `K` is a
`p ^ n`-th power for all `n`, so the image is contained in the perfect core and the perfect core
becomes an intermediate field of `L / K`.

This is the form in which the perfect core is used below: an intermediate field carries the
`K`-algebra structure and the scalar tower `K → perfectCore → L` that the separability and
primitive-element arguments need. -/
def perfectCoreIntermediateField : IntermediateField K L :=
  (perfectCore L p).toIntermediateField fun x => mem_perfectCore_of_perfectRing (algebraMap K L) x

variable {K L p}

/-- An element of `L` lies in `perfectCoreIntermediateField K L p` if and only if it lies in
`perfectCore L p`. -/
@[simp]
theorem mem_perfectCoreIntermediateField_iff {x : L} :
    x ∈ perfectCoreIntermediateField K L p ↔ x ∈ perfectCore L p :=
  Iff.rfl

/-- The underlying set of `perfectCoreIntermediateField K L p` is that of `perfectCore L p`. -/
theorem coe_perfectCoreIntermediateField :
    (perfectCoreIntermediateField K L p : Set L) = perfectCore L p :=
  rfl

/-- **Layer (a): Epp's condition is separability of the perfect core.**

If every element of the perfect core of `L` is separable algebraic over `K`, then the perfect core,
as an intermediate field, is a separable extension of `K`. -/
theorem isSeparable_perfectCoreIntermediateField
    (h : ∀ x : L, x ∈ perfectCore L p → IsSeparable K x) :
    Algebra.IsSeparable K (perfectCoreIntermediateField K L p) :=
  (le_separableClosure_iff K L _).mp fun x hx => mem_separableClosure_iff.mpr (h x hx)

end PerfectCoreIntermediateField

/-! ### Lifting a monic polynomial through the residue map -/

/-- **Layer (b), first half: monic polynomials over the residue field lift.**

The residue map `A → κ_A` of a local ring is surjective, so every monic polynomial over `κ_A` is
the reduction of a monic polynomial over `A` (of the same degree). -/
theorem exists_monic_lift_map_residue_eq (A : Type*) [CommRing A] [IsLocalRing A]
    {q : (ResidueField A)[X]} (hq : q.Monic) :
    ∃ P : A[X], P.Monic ∧ P.map (residue A) = q := by
  obtain ⟨P, hmap, -, hmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic
      (Polynomial.mem_lifts_of_surjective (residue_surjective (R := A)) q) hq
  exact ⟨P, hmonic, hmap⟩

/-! ### The residue field of a monogenic unramified extension -/

namespace AdjoinRoot

/-- A primitive element identifies a field extension with a monogenic algebra.

If `α` generates `E` over `K` then `E` is `K`-isomorphic to `K[X] ⧸ (minpoly K α)`.  This is
Mathlib's `IntermediateField.adjoinRootEquivAdjoin` with `K⟮α⟯ = ⊤` folded in. -/
noncomputable def algEquivOfPrimitiveElement {K E : Type*} [Field K] [Field E] [Algebra K E]
    {α : E} (hα : IsIntegral K α) (htop : IntermediateField.adjoin K {α} = ⊤) :
    AdjoinRoot (minpoly K α) ≃ₐ[K] E :=
  (IntermediateField.adjoinRootEquivAdjoin K hα).trans
    ((IntermediateField.equivOfEq htop).trans IntermediateField.topEquiv)

section Residue

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] {P : A[X]}
  [IsLocalRing (AdjoinRoot P)] [IsLocalHom (algebraMap A (AdjoinRoot P))]

/-- The residue of the adjoined root is a root of the reduction `P̄`, read in the residue field as
a `κ_A`-algebra.

This is `AdjoinRoot.eval₂_residue_root_eq_zero` with the two legs of the commuting square
`A → A[X] ⧸ (P) → κ_{A[X] ⧸ (P)}` and `A → κ_A → κ_{A[X] ⧸ (P)}` identified. -/
theorem aeval_residue_root_map_residue_eq_zero :
    Polynomial.aeval (residue (AdjoinRoot P) (AdjoinRoot.root P)) (P.map (residue A)) = 0 := by
  have hcomp :
      (algebraMap (ResidueField A) (ResidueField (AdjoinRoot P))).comp (residue A) =
        (residue (AdjoinRoot P)).comp (algebraMap A (AdjoinRoot P)) :=
    RingHom.ext fun _ => rfl
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
  exact AdjoinRoot.eval₂_residue_root_eq_zero

/-- **Layer (c)/(d): the residue field of the unramified extension is the residue extension.**

For `P ∈ A[X]` monic of positive degree whose reduction `P̄ ∈ κ_A[X]` is irreducible, the residue
field of the discrete valuation ring `A[X] ⧸ (P)` is `κ_A`-isomorphic to `κ_A[X] ⧸ (P̄)`.

The map is the evaluation of `P̄` at the residue of the adjoined root, which is a root of `P̄` by
`AdjoinRoot.aeval_residue_root_map_residue_eq_zero`.  It is injective because its source is a
field, and then surjective because both sides have `κ_A`-dimension `deg P`
(`AdjoinRoot.finrank_residueField_eq_natDegree`). -/
noncomputable def residueFieldAlgEquiv [IsDomain (AdjoinRoot P)] (hP : P.Monic)
    (hirr : Irreducible (P.map (residue A))) (hd : 0 < P.natDegree) :
    AdjoinRoot (P.map (residue A)) ≃ₐ[ResidueField A] ResidueField (AdjoinRoot P) := by
  have hmonic : (P.map (residue A)).Monic := hP.map (residue A)
  have : Fact (Irreducible (P.map (residue A))) := ⟨hirr⟩
  have hfinA : Module.Finite A (AdjoinRoot P) := hP.finite_adjoinRoot
  have hfinq : Module.Finite (ResidueField A) (AdjoinRoot (P.map (residue A))) :=
    hmonic.finite_adjoinRoot
  set φ : AdjoinRoot (P.map (residue A)) →ₐ[ResidueField A] ResidueField (AdjoinRoot P) :=
    AdjoinRoot.liftAlgHom _ (Algebra.ofId (ResidueField A) (ResidueField (AdjoinRoot P)))
      (residue (AdjoinRoot P) (AdjoinRoot.root P))
      (aeval_residue_root_map_residue_eq_zero (P := P) :)
  have hinj : Function.Injective φ := RingHom.injective φ.toRingHom
  have hrank : Module.finrank (ResidueField A) (AdjoinRoot (P.map (residue A))) =
      Module.finrank (ResidueField A) (ResidueField (AdjoinRoot P)) := by
    rw [AdjoinRoot.finrank_eq_natDegree hmonic,
      AdjoinRoot.finrank_residueField_eq_natDegree hP hirr hd, hP.natDegree_map (residue A)]
  exact AlgEquiv.ofBijective φ
    ⟨hinj, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hrank
      (f := φ.toLinearMap)).mp hinj⟩

end Residue

end AdjoinRoot

/-! ### The finite unramified base change -/

namespace Stacks.EppTheorem

universe u v

section EppCondition

variable {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B] [Algebra A B]
  [IsLocalHom (algebraMap A B)] {p : ℕ} [ExpChar (ResidueField A) p]
  [PerfectRing (ResidueField A) p] [ExpChar (ResidueField B) p]

/-- **Layer (a), in Epp's language.** Epp's residue-field condition says precisely that the
perfect core of `κ_B` is a separable extension of `κ_A`.

Combined with finite-dimensionality — the other hypothesis of
`exists_isWeaklyUnramified_residueField_algEquiv_perfectCore` — this makes the perfect core a
*finite separable* extension of `κ_A`, which is what the primitive element theorem consumes. -/
theorem EppCondition.isSeparable_perfectCore (h : EppCondition A B p) :
    Algebra.IsSeparable (ResidueField A)
      (perfectCoreIntermediateField (ResidueField A) (ResidueField B) p) :=
  isSeparable_perfectCoreIntermediateField h

end EppCondition

/-- **The finite unramified base change realising the perfect core.**

Let `A → B` be a local homomorphism of discrete valuation rings whose lower residue field `κ_A`
is perfect of exponential characteristic `p`, and suppose

* Epp's condition holds: every element of `perfectCore κ_B p` is separable algebraic over `κ_A`;
* `perfectCore κ_B p` is finite-dimensional over `κ_A`.

Then there is a discrete valuation ring `A₁`, finite as an `A`-module, with `A₁ / A` an extension
of discrete valuation ring which is **weakly unramified** (`e = 1`), whose residue field is
`κ_A`-isomorphic to `perfectCore κ_B p`.

This is Epp's replacement for the infinite separable-closure reduction of Tag 09ET: the residue
field downstairs is enlarged to capture the whole perfect core upstairs, and the price is a
*finite* base change that does not touch the ramification.

The conclusion is not vacuous: the final clause pins the residue field of `A₁` to the perfect core
on the nose, so `A₁ = A` is a legitimate witness exactly when `κ_A` already *is* the perfect core
of `κ_B`.

Note that no completeness hypothesis on `A` appears.  The extension is produced as
`A[X] ⧸ (P)` for a monic lift `P` of the minimal polynomial of a primitive element of the perfect
core, and `StacksFrontier.RingTheory.DiscreteValuationRing.MonicResidueIrreducible` builds that over
any discrete valuation ring.  Completeness is what would make `A₁` unique up to isomorphism; it is
not needed to produce one. -/
theorem exists_isWeaklyUnramified_residueField_algEquiv_perfectCore {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] [IsDomain A] [IsDomain B] [IsDiscreteValuationRing A]
    [IsDiscreteValuationRing B] [Algebra A B] [IsLocalHom (algebraMap A B)] (p : ℕ)
    [ExpChar (ResidueField A) p] [ExpChar (ResidueField B) p] [PerfectField (ResidueField A)]
    (hepp : EppCondition A B p)
    (hfin : FiniteDimensional (ResidueField A)
      (perfectCoreIntermediateField (ResidueField A) (ResidueField B) p)) :
    ∃ (A₁ : Type u) (_ : CommRing A₁) (_ : IsDomain A₁) (_ : IsDiscreteValuationRing A₁)
      (_ : Algebra A A₁) (_ : Module.Finite A A₁)
      (_ : IsDiscreteValuationRing.IsExtension A A₁),
      IsDiscreteValuationRing.IsWeaklyUnramified A A₁ ∧
        Nonempty (ResidueField A₁ ≃ₐ[ResidueField A]
          perfectCoreIntermediateField (ResidueField A) (ResidueField B) p) := by
  have := hfin
  have := hepp.isSeparable_perfectCore
  -- A primitive element of the perfect core, and its minimal polynomial.
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (ResidueField A)
    (perfectCoreIntermediateField (ResidueField A) (ResidueField B) p)
  have hint : IsIntegral (ResidueField A) α := IsIntegral.of_finite (ResidueField A) α
  have hqmonic : (minpoly (ResidueField A) α).Monic := minpoly.monic hint
  have hqirr : Irreducible (minpoly (ResidueField A) α) := minpoly.irreducible hint
  have hqdeg : 0 < (minpoly (ResidueField A) α).natDegree := minpoly.natDegree_pos hint
  -- Lift it to a monic polynomial over `A`.
  obtain ⟨P, hP, hPmap⟩ := exists_monic_lift_map_residue_eq A hqmonic
  have hirr : Irreducible (P.map (residue A)) := hPmap ▸ hqirr
  have hd : 0 < P.natDegree := by
    rwa [← hP.natDegree_map (residue A), hPmap]
  -- The monogenic algebra on that lift is the extension we want.
  have hlocal := AdjoinRoot.isLocalRing_of_irreducible_map_residue hP hirr
  have hdom := AdjoinRoot.isDomain_of_irreducible_map_residue hP hirr
  have hdeg := Polynomial.natDegree_pos_iff_degree_pos.mp hd
  have hlh := AdjoinRoot.isLocalHom_of_monic_of_degree_pos (g := P) hP hdeg
  have hdvr := AdjoinRoot.isDiscreteValuationRing hP hirr hd
  have hmf : Module.Finite A (AdjoinRoot P) := hP.finite_adjoinRoot
  have hext : IsDiscreteValuationRing.IsExtension A (AdjoinRoot P) :=
    { toFaithfulSMul := AdjoinRoot.faithfulSMul_of_monic_of_degree_pos hP hdeg
      toIsLocalHom := hlh }
  refine ⟨AdjoinRoot P, inferInstance, hdom, hdvr, inferInstance, hmf, hext,
    AdjoinRoot.ramificationIdx_eq_one hP hirr hd, ⟨?_⟩⟩
  exact (AdjoinRoot.residueFieldAlgEquiv hP hirr hd).symm.trans
    ((AdjoinRoot.algEquivOfEq (ResidueField A) _ _ hPmap).trans
      (AdjoinRoot.algEquivOfPrimitiveElement hint hα))

end Stacks.EppTheorem
