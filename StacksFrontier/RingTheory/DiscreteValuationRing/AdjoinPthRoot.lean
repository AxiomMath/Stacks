module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.FieldTheory.KummerPolynomial
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.RingTheory.Henselian
public import Mathlib.RingTheory.PicardGroup
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import Mathlib.RingTheory.SimpleRing.Principal
public import StacksCore.LinearAlgebra.Matrix.CommSemiring

@[expose] public section

set_option backward.isDefEq.respectTransparency false

/-!
# Adjoining a `p`-th root to a discrete valuation ring

Let `A` be a discrete valuation ring with fraction field `K` and residue field `κ_A`, let `p` be a
prime, and let `a ∈ A` be an element whose residue class is not a `p`-th power in `κ_A`. Write
`K[a^{1/p}] = K[x]/(x^p - a)` and `A[a^{1/p}] = A[α]` for the `A`-subalgebra of `K[a^{1/p}]`
generated by the root `α` of `x^p - a`. Then `a` is not a `p`-th power in `K`, the integral closure
of `A` in `K[a^{1/p}]` is `A[α]`, and `A[α]` is a discrete valuation ring which is weakly
unramified over `A`: every uniformizer of `A` is a uniformizer of `A[α]`.

## Main definitions

* `Stacks.DiscreteValuationRing.AdjoinPthRoot.FieldExt`: the field `K[a^{1/p}]`.
* `Stacks.DiscreteValuationRing.AdjoinPthRoot.alpha`: the root `α` of `x^p - a` in `K[a^{1/p}]`.
* `Stacks.DiscreteValuationRing.AdjoinPthRoot.ringExt`: the ring `A[α]`.

## Main results

* `Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_not_pth_power`: `a` is not a `p`-th
  power in `K`.
* `Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_irreducible`: `x^p - a` is irreducible
  over `K`.
* `Stacks.DiscreteValuationRing.AdjoinPthRoot.statement2_integralClosure`: the integral closure
  of `A` in `K[a^{1/p}]` is `A[α]`.
* `Stacks.DiscreteValuationRing.AdjoinPthRoot.statement3_dvr_weaklyUnramified`: `A[α]` is a
  discrete valuation ring and every uniformizer of `A` maps to a uniformizer of `A[α]`.

## References

* [Stacks Project, Tag 09EX](https://stacks.math.columbia.edu/tag/09EX)
* [Stacks Project, Tag 09E4](https://stacks.math.columbia.edu/tag/09E4)
-/

namespace Stacks.DiscreteValuationRing.AdjoinPthRoot

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable {K : Type*} [Field K] [Algebra A K] [IsFractionRing A K]
variable (p : ℕ) [hp : Fact (Nat.Prime p)] (a : A)

/-! ### Main definitions -/

/-- The polynomial `x^p - a` with coefficients in `A`. -/
noncomputable def poly : Polynomial A := Polynomial.X ^ p - Polynomial.C a

/-- The polynomial `x^p - a` viewed over the fraction field `K`. -/
noncomputable def polyK : Polynomial K :=
  Polynomial.X ^ p - Polynomial.C (algebraMap A K a)

/-- The field `K[a^{1/p}] = K[x]/(x^p - a)`. -/
abbrev FieldExt : Type _ := AdjoinRoot (polyK (A := A) (K := K) p a)

/-- The distinguished root `alpha` of `x^p - a` in `K[a^{1/p}]`, so
`alpha^p = a`. -/
noncomputable def alpha : FieldExt (A := A) (K := K) p a := AdjoinRoot.root _

/-- The ring `A[a^{1/p}] = A[alpha]`, the `A`-subalgebra of `K[a^{1/p}]`
generated by `alpha`. -/
noncomputable def ringExt : Subalgebra A (FieldExt (A := A) (K := K) p a) :=
  Algebra.adjoin A {alpha (A := A) (K := K) p a}

/-! ### Characterizing the constructions -/

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] hp in
/-- `alpha` belongs to `B = A[alpha]`. -/
theorem alpha_mem_ringExt :
    alpha (A := A) (K := K) p a ∈ ringExt (A := A) (K := K) p a :=
  Algebra.self_mem_adjoin_singleton A _

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] hp in
/-- `x^p - a` over `K` is the base change of `x^p - a` over `A`. -/
theorem polyK_eq_map_poly :
    polyK (A := A) (K := K) p a = (poly p a).map (algebraMap A K) := by
  unfold polyK poly
  simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
    Polynomial.map_C]

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- `x^p - a` is monic over `A`. -/
theorem poly_monic : (poly p a).Monic :=
  Polynomial.monic_X_pow_sub_C _ hp.out.pos.ne'

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- `x^p - a` is monic over `K`. -/
theorem polyK_monic : (polyK (A := A) (K := K) p a).Monic :=
  Polynomial.monic_X_pow_sub_C _ hp.out.pos.ne'

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] hp in
/-- `x^p - a` has degree `p` over `K`. -/
@[simp]
theorem natDegree_polyK : (polyK (A := A) (K := K) p a).natDegree = p := by
  unfold polyK
  rw [Polynomial.natDegree_sub_C, Polynomial.natDegree_X_pow]

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] hp in
/-- `alpha` is a root of `x^p - a` over `K`. -/
@[simp]
theorem aeval_alpha :
    Polynomial.aeval (alpha (A := A) (K := K) p a)
      (polyK (A := A) (K := K) p a) = 0 := by
  rw [alpha, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- `alpha` is integral over `A`, being a root of the monic `x^p - a`. -/
theorem alpha_isIntegral : IsIntegral A (alpha (A := A) (K := K) p a) := by
  refine ⟨Polynomial.X ^ p - Polynomial.C a, poly_monic p a, ?_⟩
  show Polynomial.aeval (alpha (A := A) (K := K) p a)
      (Polynomial.X ^ p - Polynomial.C a) = 0
  rw [← Polynomial.aeval_map_algebraMap K (alpha (A := A) (K := K) p a)
    (Polynomial.X ^ p - Polynomial.C a)]
  simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X,
    Polynomial.map_C]
  show Polynomial.aeval (alpha (A := A) (K := K) p a)
      (polyK (A := A) (K := K) p a) = 0
  exact aeval_alpha p a

omit [IsDomain A] [IsDiscreteValuationRing A] hp in
/-- The structure map `A → K[a^{1/p}]` is injective. -/
theorem algebraMap_fieldExt_injective
    (hirr : Irreducible (polyK (A := A) (K := K) p a)) :
    Function.Injective (algebraMap A (FieldExt (A := A) (K := K) p a)) := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) := ⟨hirr⟩
  rw [IsScalarTower.algebraMap_eq A K (FieldExt (A := A) (K := K) p a)]
  exact ((algebraMap K (FieldExt (A := A) (K := K) p a)).injective).comp
    (IsFractionRing.injective A K)

omit [IsDomain A] [IsDiscreteValuationRing A] hp in
/-- The structure map `A → B = A[alpha]` is injective. -/
theorem algebraMap_ringExt_injective
    (hirr : Irreducible (polyK (A := A) (K := K) p a)) :
    Function.Injective (algebraMap A ↥(ringExt (A := A) (K := K) p a)) := by
  have hcomp : (Subtype.val : ↥(ringExt (A := A) (K := K) p a) →
        FieldExt (A := A) (K := K) p a) ∘
      algebraMap A ↥(ringExt (A := A) (K := K) p a)
      = algebraMap A (FieldExt (A := A) (K := K) p a) := by
    funext x
    simp [Algebra.algebraMap_eq_smul_one]
  have hcompinj : Function.Injective
      ((Subtype.val : ↥(ringExt (A := A) (K := K) p a) →
        FieldExt (A := A) (K := K) p a) ∘
        algebraMap A ↥(ringExt (A := A) (K := K) p a)) := by
    rw [hcomp]; exact algebraMap_fieldExt_injective p a hirr
  exact Function.Injective.of_comp hcompinj

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] hp in
/-- The distinguished root `alpha` of `K[a^{1/p}]` satisfies `alpha^p = a`
(here `a` is viewed in `K[a^{1/p}]` through `A → K → K[a^{1/p}]`). -/
theorem alpha_pow_eq_algebraMap :
    alpha (A := A) (K := K) p a ^ p
      = algebraMap K (FieldExt (A := A) (K := K) p a) (algebraMap A K a) := by
  have h := aeval_alpha (A := A) (K := K) p a
  unfold alpha polyK at *
  simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C] at h
  rw [sub_eq_zero] at h
  exact h

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- `K[a^{1/p}]` has dimension `p` over `K`. -/
theorem finrank_fieldExt :
    Module.finrank K (FieldExt (A := A) (K := K) p a) = p := by
  have hfr := (AdjoinRoot.powerBasis (f := polyK (A := A) (K := K) p a)
    (polyK_monic p a).ne_zero).finrank
  rw [AdjoinRoot.powerBasis_dim, natDegree_polyK] at hfr
  exact hfr

/-! ### Main statements -/

/-- If the residue class `abar` of `a` is not a `p`-th power in the residue field `kappa_A`,
then `a` is not a `p`-th power in `K`. -/
@[stacks 09EX "(1)"]
theorem statement1_not_pth_power
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    ¬ ∃ b : K, algebraMap A K a = b ^ p := by
  rintro ⟨b, hb⟩
  have hint : IsIntegral A b :=
    ⟨Polynomial.X ^ p - Polynomial.C a, Polynomial.monic_X_pow_sub_C _ hp.out.ne_zero,
      by simp [← hb]⟩
  obtain ⟨b₀, hb₀⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  have key : a = b₀ ^ p := IsFractionRing.injective A K (by rw [map_pow, hb₀, ← hb])
  exact ha ⟨IsLocalRing.residue A b₀, by rw [← map_pow, ← key]⟩

/-- If the residue class of `a` is not a `p`-th power in the residue field, then the
polynomial `x^p - a` is irreducible over `K`. -/
theorem statement1_irreducible
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    Irreducible (polyK (A := A) (K := K) p a) := by
  unfold polyK
  exact X_pow_sub_C_irreducible_of_prime hp.out fun b hbe =>
    statement1_not_pth_power p a ha ⟨b, hbe.symm⟩

/-! ### Structure lemmas for `B = A[alpha] = ringExt p a` -/

/-- If the residue class of `a` is not a `p`-th power in the residue field, then `a` is a unit
of `A`. -/
theorem isUnit_of_residue_not_pow
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    IsUnit a := by
  by_contra hnu
  have hmem : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hnu
  exact ha ⟨0, by
    rw [zero_pow hp.out.pos.ne', IsLocalRing.residue_eq_zero_iff]
    exact hmem⟩

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- `B = A[alpha]` is a finite `A`-module. -/
theorem ringExt_module_finite :
    Module.Finite A (ringExt (A := A) (K := K) p a) := by
  show Module.Finite A (Algebra.adjoin A {alpha (A := A) (K := K) p a})
  exact Module.Finite.iff_fg.mpr (alpha_isIntegral p a).fg_adjoin_singleton

/-- `K[a^{1/p}]` is the fraction field of `B = A[alpha]`. -/
theorem ringExt_isFractionRing (hirr : Irreducible (polyK (A := A) (K := K) p a)) :
    IsFractionRing ↥(ringExt (A := A) (K := K) p a)
      (FieldExt (A := A) (K := K) p a) := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) := ⟨hirr⟩
  set pb : PowerBasis K (FieldExt (A := A) (K := K) p a) :=
    AdjoinRoot.powerBasis (polyK_monic p a).ne_zero with hpb
  have hgen : pb.gen = alpha (A := A) (K := K) p a := by
    rw [hpb, AdjoinRoot.powerBasis_gen]; rfl
  have hbmem : ∀ i : Fin pb.dim,
      pb.basis i ∈ ringExt (A := A) (K := K) p a := by
    intro i
    rw [pb.basis_eq_pow, hgen]
    exact pow_mem (alpha_mem_ringExt p a) i
  apply IsFractionRing.of_field
  intro z
  set c := pb.basis.repr z with hc
  obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A)
    (Finset.univ : Finset (Fin pb.dim)) c
  have hdz : (algebraMap A (FieldExt (A := A) (K := K) p a) (d : A)) * z
      ∈ ringExt (A := A) (K := K) p a := by
    rw [← Algebra.smul_def]
    have hzsum : z = ∑ i, c i • pb.basis i := (pb.basis.sum_repr z).symm
    rw [hzsum, Finset.smul_sum]
    apply Subalgebra.sum_mem
    intro i _
    obtain ⟨aᵢ, haᵢ⟩ := hd i (Finset.mem_univ i)
    have hstep : (d : A) • c i • pb.basis i = aᵢ • pb.basis i := by
      rw [← smul_assoc, ← haᵢ, IsScalarTower.algebraMap_smul]
    rw [hstep]
    exact Subalgebra.smul_mem _ (hbmem i) aᵢ
  refine ⟨⟨_, hdz⟩, algebraMap A _ (d : A), ?_⟩
  have hd0 : algebraMap A (FieldExt (A := A) (K := K) p a) (d : A) ≠ 0 := fun h =>
    (nonZeroDivisors.coe_ne_zero d)
      (algebraMap_fieldExt_injective p a hirr (by rw [h, map_zero]))
  show z = (algebraMap A (FieldExt (A := A) (K := K) p a) (d : A) * z) /
      (algebraMap A (FieldExt (A := A) (K := K) p a) (d : A))
  rw [mul_comm, mul_div_assoc, div_self hd0, mul_one]

/-- The minimal polynomial of `alpha` over `A` is `x^p - a`. -/
theorem minpoly_alpha (hirr : Irreducible (polyK (A := A) (K := K) p a)) :
    minpoly A (alpha (A := A) (K := K) p a) = Polynomial.X ^ p - Polynomial.C a := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) := ⟨hirr⟩
  have hpolyK : minpoly K (alpha (A := A) (K := K) p a)
      = polyK (A := A) (K := K) p a :=
    (minpoly.eq_of_irreducible_of_monic (Fact.out) (aeval_alpha p a)
      (polyK_monic p a)).symm
  have hK := minpoly.isIntegrallyClosed_eq_field_fractions
    (R := A) (S := FieldExt (A := A) (K := K) p a)
    K (FieldExt (A := A) (K := K) p a)
    (s := alpha (A := A) (K := K) p a) (alpha_isIntegral p a)
  have hself : (algebraMap (FieldExt (A := A) (K := K) p a)
      (FieldExt (A := A) (K := K) p a)) (alpha (A := A) (K := K) p a)
      = alpha (A := A) (K := K) p a := rfl
  rw [hself] at hK
  have hpolymap : polyK (A := A) (K := K) p a
      = Polynomial.map (algebraMap A K) (Polynomial.X ^ p - Polynomial.C a) :=
    polyK_eq_map_poly p a
  have hmapeq : Polynomial.map (algebraMap A K) (minpoly A (alpha (A := A) (K := K) p a))
      = Polynomial.map (algebraMap A K) (Polynomial.X ^ p - Polynomial.C a) := by
    rw [← hK, hpolyK, hpolymap]
  exact Polynomial.map_injective _ (IsFractionRing.injective A K) hmapeq

/-- If `abar` is not a `p`-th power in `kappa_A = ResidueField A`, then the polynomial
`x^p - abar` is irreducible over `kappa_A`. -/
theorem residue_poly_irreducible
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    Irreducible
      (Polynomial.X ^ p - Polynomial.C (IsLocalRing.residue A a)
        : Polynomial (IsLocalRing.ResidueField A)) :=
  X_pow_sub_C_irreducible_of_prime hp.out fun b hbe => ha ⟨b, hbe.symm⟩

/-- The quotient `(A ⧸ m_A)[X] ⧸ (X^p - C a)` is a field. -/
theorem residue_poly_quot_isField
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    IsField (Polynomial (A ⧸ IsLocalRing.maximalIdeal A) ⧸
      Ideal.span {Polynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A))
        (Polynomial.X ^ p - Polynomial.C a : Polynomial A)}) := by
  have hirr := residue_poly_irreducible p a ha
  have hmax : (Ideal.span {(Polynomial.X ^ p - Polynomial.C (IsLocalRing.residue A a)
      : Polynomial (IsLocalRing.ResidueField A))}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hirr
  have hf : IsField (Polynomial (IsLocalRing.ResidueField A) ⧸
      Ideal.span {(Polynomial.X ^ p - Polynomial.C (IsLocalRing.residue A a)
        : Polynomial (IsLocalRing.ResidueField A))}) :=
    (Ideal.Quotient.field _).toIsField
  have hmap : Polynomial.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A))
        (Polynomial.X ^ p - Polynomial.C a : Polynomial A)
      = (Polynomial.X ^ p - Polynomial.C (IsLocalRing.residue A a)
          : Polynomial (IsLocalRing.ResidueField A)) := by
    rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
    rfl
  rw [hmap]
  exact hf

/-- The closed fibre `B / (m_A · B)` of `B = A[alpha]` is a field. -/
theorem closedFibre_field
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    IsField (↥(ringExt (A := A) (K := K) p a) ⧸
      Ideal.map (algebraMap A (↥(ringExt (A := A) (K := K) p a)))
        (IsLocalRing.maximalIdeal A)) := by
  have hirr : Irreducible (polyK (A := A) (K := K) p a) := statement1_irreducible p a ha
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) := ⟨hirr⟩
  have hint : IsIntegral A (alpha (A := A) (K := K) p a) := alpha_isIntegral p a
  have hmin : minpoly A (alpha (A := A) (K := K) p a)
      = Polynomial.X ^ p - Polynomial.C a := minpoly_alpha p a hirr
  have : Module.IsTorsionFree A (FieldExt (A := A) (K := K) p a) := by
    rw [Module.isTorsionFree_iff_algebraMap_injective]
    exact algebraMap_fieldExt_injective p a hirr
  set pb : PowerBasis A (↥(ringExt (A := A) (K := K) p a)) :=
    Algebra.adjoin.powerBasis' hint with hpb
  have hgenmin : minpoly A pb.gen = Polynomial.X ^ p - Polynomial.C a := by
    have hval : (algebraMap (↥(ringExt (A := A) (K := K) p a))
        (FieldExt (A := A) (K := K) p a)) pb.gen
        = alpha (A := A) (K := K) p a := by
      rw [hpb, Algebra.adjoin.powerBasis'_gen]; rfl
    have hinj : Function.Injective
        (algebraMap (↥(ringExt (A := A) (K := K) p a))
          (FieldExt (A := A) (K := K) p a)) := Subtype.val_injective
    rw [← minpoly.algebraMap_eq hinj pb.gen, hval, hmin]
  have hquot := pb.quotientEquivQuotientMinpolyMap (IsLocalRing.maximalIdeal A)
  rw [hgenmin] at hquot
  exact MulEquiv.isField (residue_poly_quot_isField p a ha) hquot.toRingEquiv.toMulEquiv

/-- `m_A · B` is a maximal ideal of `B = A[alpha]`. -/
theorem ringExt_maximalIdeal_map_isMaximal
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    (Ideal.map (algebraMap A ↥(ringExt (A := A) (K := K) p a))
      (IsLocalRing.maximalIdeal A)).IsMaximal := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
    ⟨statement1_irreducible p a ha⟩
  exact Ideal.Quotient.maximal_of_isField _ (closedFibre_field p a ha)

/-- `B = A[alpha]` is a local ring. -/
theorem ringExt_isLocalRing
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    IsLocalRing ↥(ringExt (A := A) (K := K) p a) := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
    ⟨statement1_irreducible p a ha⟩
  set B := ringExt (A := A) (K := K) p a with hB
  set J : Ideal (↥B) := Ideal.map (algebraMap A (↥B)) (IsLocalRing.maximalIdeal A) with hJ
  have hJmax : J.IsMaximal := ringExt_maximalIdeal_map_isMaximal p a ha
  have : Module.Finite A (↥B) := ringExt_module_finite p a
  have : Algebra.IsIntegral A (↥B) := Algebra.IsIntegral.of_finite A (↥B)
  apply IsLocalRing.of_unique_max_ideal
  refine ⟨J, hJmax, ?_⟩
  intro M hM
  have hcomap : (Ideal.comap (algebraMap A (↥B)) M).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal M
  have hcm : Ideal.comap (algebraMap A (↥B)) M = IsLocalRing.maximalIdeal A :=
    IsLocalRing.eq_maximalIdeal hcomap
  have hle : J ≤ M := by
    rw [hJ, ← hcm]
    exact Ideal.map_comap_le
  exact (hJmax.eq_of_le hM.ne_top hle).symm

/-- If `B = A[alpha]` is local, its maximal ideal is generated by the image of a uniformizer
of `A`. -/
private theorem maximalIdeal_ringExt_eq_span
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p)
    [IsLocalRing ↥(ringExt (A := A) (K := K) p a)] {π : A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) :
    IsLocalRing.maximalIdeal ↥(ringExt (A := A) (K := K) p a)
      = Ideal.span {algebraMap A ↥(ringExt (A := A) (K := K) p a) π} := by
  rw [← Set.image_singleton, ← Ideal.map_span, ← hπ]
  exact (IsLocalRing.eq_maximalIdeal (ringExt_maximalIdeal_map_isMaximal p a ha)).symm

/-- `B = A[alpha]` is a discrete valuation ring. -/
theorem ringExt_isDVR
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    haveI : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
      ⟨statement1_irreducible p a ha⟩
    letI B := ringExt (A := A) (K := K) p a
    haveI : IsDomain B := inferInstance
    IsDiscreteValuationRing B := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
    ⟨statement1_irreducible p a ha⟩
  set B := ringExt (A := A) (K := K) p a with hB
  have hlocal : IsLocalRing (↥B) := ringExt_isLocalRing p a ha
  have : Module.Finite A (↥B) := ringExt_module_finite p a
  have : IsNoetherianRing (↥B) := IsNoetherianRing.of_finite A (↥B)
  obtain ⟨π, hπ⟩ := IsPrincipalIdealRing.principal (R := A)
    (IsLocalRing.maximalIdeal A)
  have hmax := maximalIdeal_ringExt_eq_span (K := K) p a ha hπ
  have hJprinc : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (↥B)) := by
    rw [hmax]
    infer_instance
  have hnotfield : ¬ IsField (↥B) := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax]
    intro hbot
    have hπ0 : π ≠ 0 := by
      rintro rfl
      have : IsLocalRing.maximalIdeal A = ⊥ := by simp [hπ]
      exact (IsDiscreteValuationRing.not_isField A)
        (IsLocalRing.isField_iff_maximalIdeal_eq.mpr this)
    exact hπ0 ((map_eq_zero_iff _ (algebraMap_ringExt_injective p a
      (statement1_irreducible p a ha))).mp (Ideal.span_singleton_eq_bot.mp hbot))
  have htfae := IsDiscreteValuationRing.TFAE (↥B) hnotfield
  exact (htfae.out 5 1).mp hJprinc

/-- The image in `B = A[alpha]` of a uniformizer of `A` is a uniformizer of `B`. -/
theorem ringExt_uniformizer
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    haveI : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
      ⟨statement1_irreducible p a ha⟩
    letI B := ringExt (A := A) (K := K) p a
    ∀ ϖ : A, Irreducible ϖ → Irreducible (algebraMap A B ϖ) := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
    ⟨statement1_irreducible p a ha⟩
  set B := ringExt (A := A) (K := K) p a with hB
  have hdvr : IsDiscreteValuationRing (↥B) := ringExt_isDVR p a ha
  obtain ⟨π, hπ⟩ := IsPrincipalIdealRing.principal (R := A)
    (IsLocalRing.maximalIdeal A)
  have hπirr : Irreducible π :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hgenirr : Irreducible (algebraMap A (↥B) π) :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer (algebraMap A (↥B) π)).mpr
      (maximalIdeal_ringExt_eq_span (K := K) p a ha hπ)
  intro ϖ hϖ
  have hassoc : Associated ϖ π :=
    IsDiscreteValuationRing.associated_of_irreducible A hϖ hπirr
  exact ((hassoc.map (algebraMap A (↥B))).symm).irreducible hgenirr

/-- The integral closure of `A` in `K[a^{1/p}]` equals
`A[a^{1/p}] = A[alpha]`. -/
@[stacks 09EX "(2)"]
theorem statement2_integralClosure
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    integralClosure A (FieldExt (A := A) (K := K) p a)
      = ringExt (A := A) (K := K) p a := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
    ⟨statement1_irreducible p a ha⟩
  apply le_antisymm
  · have hdvr : IsDiscreteValuationRing ↥(ringExt (A := A) (K := K) p a) :=
      ringExt_isDVR p a ha
    have hfr : IsFractionRing ↥(ringExt (A := A) (K := K) p a)
        (FieldExt (A := A) (K := K) p a) :=
      ringExt_isFractionRing p a (statement1_irreducible p a ha)
    intro x hx
    rw [mem_integralClosure_iff] at hx
    have hxB : IsIntegral ↥(ringExt (A := A) (K := K) p a) x := hx.tower_top
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxB
    rw [← hy]
    exact y.property
  · rw [ringExt, Algebra.adjoin_le_iff]
    rintro x hx
    simp only [Set.mem_singleton_iff] at hx
    subst hx
    show IsIntegral A (alpha (A := A) (K := K) p a)
    exact alpha_isIntegral p a

/-- The ring `A[a^{1/p}] = A[alpha]` is a discrete valuation ring, and the extension
`A ⊆ A[a^{1/p}]` is weakly unramified: every uniformizer (irreducible element) of `A` maps to a
uniformizer (irreducible element) of `A[a^{1/p}]`. -/
@[stacks 09EX "(3)"]
theorem statement3_dvr_weaklyUnramified
    (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    haveI : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
      ⟨statement1_irreducible p a ha⟩
    letI B := ringExt (A := A) (K := K) p a
    haveI : IsDomain B := inferInstance
    IsDiscreteValuationRing B
      ∧ (∀ ϖ : A, Irreducible ϖ → Irreducible (algebraMap A B ϖ)) := by
  have : Fact (Irreducible (polyK (A := A) (K := K) p a)) :=
    ⟨statement1_irreducible p a ha⟩
  exact ⟨ringExt_isDVR p a ha, ringExt_uniformizer p a ha⟩

end Stacks.DiscreteValuationRing.AdjoinPthRoot
