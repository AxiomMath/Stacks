module

public import StacksFrontier.RingTheory.DiscreteValuationRing.AdjoinPthRoot
public import StacksFrontier.RingTheory.DiscreteValuationRing.WeakSolution
public import StacksFrontier.RingTheory.Nagata.PthRoot

open Stacks.DiscreteValuationRing.AdjoinPthRoot

/-!
# Eliminating ramification for a purely inseparable extension of prime degree

Let `A → B → C` be extensions of discrete valuation rings with compatible fraction fields
`K → L → M`. If `B` is a Nagata ring, `A → B` is weakly unramified, and `M / L` is purely
inseparable of prime degree `p`, then either `A → C` is weakly unramified, or `C` is obtained
from `B` by adjoining a `p`-th root of a uniformizer of `A`, or ramification is eliminated
after a separable totally ramified extension of `K` of degree `p`.

Along the way we record, for an extension of the fraction field of a discrete valuation ring
generated by a `p`-th root of an element whose residue is not a `p`-th power, the identification
of the integral closure with the subalgebra generated by that root, and the fact that this
integral closure is again a discrete valuation ring in which every uniformizer of the base stays
a uniformizer.

## Main results

* `fieldExtAlgEquiv`, `finrank_eq_prime_of_pow_eq`, `integralClosure_eq_adjoin_of_pow_eq`,
  `isDiscreteValuationRing_integralClosure_and_irreducible_of_pow_eq` and
  `maximalIdeal_map_eq_of_pow_eq`, in `Stacks.DiscreteValuationRing.AdjoinPthRoot`: the root
  extension of Stacks 09EX transported to an arbitrary field generated by the root.
* `Stacks.DiscreteValuationRing.AdjoinPthRoot.integralClosureEquivOfIsIntegral`: for an integral
  tower the two integral closures in a common algebra agree.
* `IsDiscreteValuationRing.weaklyUnramified_or_adjoin_root_or_after_totallyRamified_baseChange`:
  the three alternatives for a prime-degree purely inseparable extension.

## References

* [Stacks Project, Tag 09EY](https://stacks.math.columbia.edu/tag/09EY)
* [Stacks Project, Tag 09EX](https://stacks.math.columbia.edu/tag/09EX)
-/

@[expose] public section

open scoped TensorProduct

universe u v w t

namespace Stacks.DiscreteValuationRing.AdjoinPthRoot

section RootExtension

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable {K : Type v} [Field K] [Algebra A K] [IsFractionRing A K]
variable {E : Type w} [Field E] [Algebra K E] [Algebra A E] [IsScalarTower A K E]
variable (p : ℕ) [Fact p.Prime] (a : A)
variable (ha : ¬ ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p)
variable (x : E) (hx : x ^ p = algebraMap A E a) (hgen : Algebra.adjoin K {x} = ⊤)

/-- Identify the canonical root extension with any field generated by the specified root. -/
noncomputable def fieldExtAlgEquiv : Stacks.DiscreteValuationRing.AdjoinPthRoot.FieldExt (K := K) p
  a ≃ₐ[K] E := by
  let : Fact (Irreducible (Stacks.DiscreteValuationRing.AdjoinPthRoot.polyK (K := K) p a)) :=
    ⟨Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_irreducible p a ha⟩
  let f : Stacks.DiscreteValuationRing.AdjoinPthRoot.FieldExt (K := K) p a →ₐ[K] E :=
    AdjoinRoot.liftAlgHom _ (Algebra.ofId K E) x (by
      simp [Stacks.DiscreteValuationRing.AdjoinPthRoot.polyK, hx, IsScalarTower.algebraMap_apply A K
        E])
  refine AlgEquiv.ofBijective f ⟨f.injective, (AlgHom.range_eq_top f).1 (top_unique ?_)⟩
  rw [← hgen, Algebra.adjoin_le_iff]
  rintro y rfl
  exact ⟨AdjoinRoot.root _, AdjoinRoot.liftAlgHom_root _ _ _ _⟩

include ha hx hgen

set_option backward.isDefEq.respectTransparency false in
/-- `Stacks.DiscreteValuationRing.AdjoinPthRoot.fieldExtAlgEquiv` sends the canonical root to `x`.
-/
@[simp]
theorem fieldExtAlgEquiv_alpha :
    fieldExtAlgEquiv p a ha x hx hgen (Stacks.DiscreteValuationRing.AdjoinPthRoot.alpha (K := K) p
      a) = x := by
  simp [fieldExtAlgEquiv, Stacks.DiscreteValuationRing.AdjoinPthRoot.alpha,
    AlgEquiv.ofBijective_apply]

/-- The root generates an extension of degree `p`; no degree hypothesis is needed. -/
theorem finrank_eq_prime_of_pow_eq : Module.finrank K E = p := by
  let : Fact (Irreducible (Stacks.DiscreteValuationRing.AdjoinPthRoot.polyK (K := K) p a)) :=
    ⟨Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_irreducible p a ha⟩
  rw [← (fieldExtAlgEquiv p a ha x hx hgen).toLinearEquiv.finrank_eq]
  exact Stacks.DiscreteValuationRing.AdjoinPthRoot.finrank_fieldExt (A := A) (K := K) p a

/-- In any field generated by the root, the integral closure equals the subalgebra generated by
the root. -/
theorem integralClosure_eq_adjoin_of_pow_eq :
    integralClosure A E = Algebra.adjoin A {x} := by
  let : Fact (Irreducible (Stacks.DiscreteValuationRing.AdjoinPthRoot.polyK (K := K) p a)) :=
    ⟨Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_irreducible p a ha⟩
  let e := (fieldExtAlgEquiv p a ha x hx hgen).restrictScalars A
  rw [← integralClosure_map_algEquiv e,
    Stacks.DiscreteValuationRing.AdjoinPthRoot.statement2_integralClosure p a ha]
  simp [Stacks.DiscreteValuationRing.AdjoinPthRoot.ringExt, e, AlgHom.map_adjoin_singleton]

/-- The integral closure in any field generated by the root is a DVR, and every uniformizer of the
base remains a uniformizer. -/
theorem isDiscreteValuationRing_integralClosure_and_irreducible_of_pow_eq :
    IsDiscreteValuationRing (integralClosure A E) ∧
      ∀ π : A, Irreducible π → Irreducible (algebraMap A (integralClosure A E) π) := by
  let : Fact (Irreducible (Stacks.DiscreteValuationRing.AdjoinPthRoot.polyK (K := K) p a)) :=
    ⟨Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_irreducible p a ha⟩
  let e := (Subalgebra.equivOfEq _ _
    (Stacks.DiscreteValuationRing.AdjoinPthRoot.statement2_integralClosure (K := K) p a
      ha).symm).trans
      ((fieldExtAlgEquiv p a ha x hx hgen).restrictScalars A).mapIntegralClosure
  obtain ⟨hdvr, hπ⟩ := Stacks.DiscreteValuationRing.AdjoinPthRoot.statement3_dvr_weaklyUnramified (K
    := K) p a ha
  let := hdvr
  refine ⟨IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e, fun π h => ?_⟩
  rw [← e.commutes π]
  exact (MulEquiv.irreducible_iff (f := e.toMulEquiv)).mpr (hπ π h)

/-- The maximal ideal of the base generates the maximal ideal of the integral closure in any field
generated by the root. -/
theorem maximalIdeal_map_eq_of_pow_eq :
    letI := (isDiscreteValuationRing_integralClosure_and_irreducible_of_pow_eq
      p a ha x hx hgen).1
    Ideal.map (algebraMap A (integralClosure A E)) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal (integralClosure A E) := by
  let := (isDiscreteValuationRing_integralClosure_and_irreducible_of_pow_eq
    p a ha x hx hgen).1
  obtain ⟨π, hπ⟩ := IsPrincipalIdealRing.principal (R := A) (IsLocalRing.maximalIdeal A)
  have hspan : IsLocalRing.maximalIdeal A = Ideal.span {π} := by rw [hπ]
  have hirr := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hspan
  have hmap := (isDiscreteValuationRing_integralClosure_and_irreducible_of_pow_eq
    p a ha x hx hgen).2 π hirr
  rw [hspan, Ideal.map_span, Set.image_singleton]
  exact ((IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hmap).symm

end RootExtension

/-- For an integral extension `R → S`, the integral closure of `S` in `T`, viewed as an
`R`-subalgebra, is the integral closure of `R` in `T`. -/
theorem integralClosure_restrictScalars_eq_of_isIntegral
    {R : Type u} {S : Type v} {T : Type t}
    [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Algebra.IsIntegral R S] :
    (integralClosure S T).restrictScalars R = integralClosure R T := by
  ext y
  exact ⟨fun h => isIntegral_trans y h, fun h => h.tower_top⟩

/-- For an integral extension `R → S`, the `R`-algebra equivalence between the integral closures
of `S` and of `R` in `T`, which is the identity on elements of `T`. -/
noncomputable def integralClosureEquivOfIsIntegral
    {R : Type u} {S : Type v} {T : Type t}
    [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Algebra.IsIntegral R S] :
    integralClosure S T ≃ₐ[R] integralClosure R T :=
  Subalgebra.equivOfEq _ _ integralClosure_restrictScalars_eq_of_isIntegral

/-- `Stacks.DiscreteValuationRing.AdjoinPthRoot.integralClosureEquivOfIsIntegral` is the identity
on elements of `T`. -/
@[simp]
theorem coe_integralClosureEquivOfIsIntegral
    {R : Type u} {S : Type v} {T : Type t}
    [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Algebra.IsIntegral R S] (y : integralClosure S T) :
    (integralClosureEquivOfIsIntegral (R := R) y : T) = (y : T) := rfl

end Stacks.DiscreteValuationRing.AdjoinPthRoot

/-! ### The three alternatives for a purely inseparable extension of prime degree -/

namespace IsDiscreteValuationRing

open Polynomial

/-- **A purely inseparable extension of prime degree forces that prime to be the characteristic.**
-/
theorem charP_of_finrank_eq_prime
    (K L : Type*) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsPurelyInseparable K L]
    {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank K L = p) : CharP K p := by
  obtain ⟨q, hq⟩ := ExpChar.exists K
  let := hq
  obtain ⟨n, hn⟩ := IsPurelyInseparable.finrank_eq_pow K L q
  have hqp : q = p := (hp.pow_eq_iff.mp (hn.symm.trans hdegree)).1
  subst q
  cases hq with
  | zero => exact (hp.ne_one rfl).elim
  | prime _ => infer_instance

private theorem pow_mem_range_of_finrank_eq_prime
    (K L : Type*) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsPurelyInseparable K L]
    {p : ℕ} (hp : p.Prime) [CharP K p]
    (hdegree : Module.finrank K L = p) (x : L) :
    x ^ p ∈ (algebraMap K L).range := by
  let : Fact p.Prime := ⟨hp⟩
  have he : IsPurelyInseparable.elemExponent K x ≤ 1 := by
    have h := minpoly.natDegree_le x (A := K)
    rw [IsPurelyInseparable.minpoly_natDegree_eq' K p, hdegree] at h
    apply (Nat.pow_le_pow_iff_right hp.one_lt).mp
    simpa only [pow_one] using h
  obtain ⟨y, hy⟩ := IsPurelyInseparable.elemExponent_def' K p x
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp he with he | he
  · simp only [he, pow_zero, pow_one] at hy
    exact ⟨y ^ p, by rw [map_pow, hy]⟩
  · simpa only [he, pow_one] using (show x ^ p ^ IsPurelyInseparable.elemExponent K x ∈
      (algebraMap K L).range from ⟨y, hy⟩)

private theorem isInteger_of_map_isInteger
    (R S K L : Type*) [CommRing R] [IsDomain R] [ValuationRing R]
    [CommRing S] [Field K] [Field L]
    [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Algebra R K] [IsFractionRing R K]
    [Algebra S L] [IsFractionRing S L]
    [Algebra R L] [Algebra K L]
    [IsScalarTower R S L] [IsScalarTower R K L]
    (x : K) (hx : IsLocalization.IsInteger S (algebraMap K L x)) :
    IsLocalization.IsInteger R x := by
  by_cases hx0 : x = 0
  · subst x
    exact ⟨0, map_zero _⟩
  rcases ValuationRing.isInteger_or_isInteger R x with h | ⟨a, ha⟩
  · exact h
  obtain ⟨b, hb⟩ := hx
  have hab : algebraMap R S a * b = 1 := by
    apply IsFractionRing.injective S L
    rw [map_mul, map_one, hb, ← IsScalarTower.algebraMap_apply R S L,
      IsScalarTower.algebraMap_apply R K L, ha, map_inv₀, inv_mul_cancel₀]
    exact (map_ne_zero_iff _ (algebraMap K L).injective).mpr hx0
  have hu : IsUnit a := (isUnit_map_iff (algebraMap R S) a).mp
    (isUnit_iff_exists_inv.mpr ⟨b, hab⟩)
  obtain ⟨u, rfl⟩ := hu
  refine ⟨↑u⁻¹, ?_⟩
  rw [map_units_inv, ha, inv_inv]

private theorem exists_pow_eq_adicCompletion_of_forall_pow_dvd_sub
    (R : Type*) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    {p : ℕ} [Fact p.Prime] [CharP R p] (t a : R)
    (h : ∀ n : ℕ, ∃ b : R, t ^ (n * p) ∣ a - b ^ p) :
    ∃ α : AdicCompletion (Ideal.span {t}) R,
      α ^ p = algebraMap R (AdicCompletion (Ideal.span {t}) R) a := by
  classical
  choose b hb using h
  let I : Ideal R := Ideal.span {t}
  have hcompat : AdicCompletion.IsAdicCauchy I R b := by
    intro m n hmn
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    change b m - b n ∈ (Ideal.span {t}) ^ m
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    apply (IsIntegrallyClosed.pow_dvd_pow_iff (Fact.out : p.Prime).ne_zero).mp
    rw [← pow_mul, sub_pow_char]
    have hn : t ^ (m * p) ∣ a - b n ^ p :=
      (pow_dvd_pow t (Nat.mul_le_mul_right p hmn)).trans (hb n)
    convert dvd_sub hn (hb m) using 1
    ring
  let α := AdicCompletion.mk I R ⟨b, hcompat⟩
  refine ⟨α, AdicCompletion.ext_evalₐ fun n => ?_⟩
  simp only [map_pow, α, AlgHom.commutes]
  change (Ideal.Quotient.mk (I ^ n) (b n)) ^ p = Ideal.Quotient.mk (I ^ n) a
  rw [← map_pow, Ideal.Quotient.eq]
  have hmem : a - b n ^ p ∈ I ^ n := by
    change a - b n ^ p ∈ (Ideal.span {t}) ^ n
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    exact (pow_dvd_pow t (Nat.le_mul_of_pos_right n (Fact.out : p.Prime).pos)).trans (hb n)
  simpa only [neg_sub] using (I ^ n).neg_mem hmem

private theorem exists_expansion_of_no_nonpower_residue
    (R : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (p : ℕ) (π u : R) (hπ : Irreducible π)
    (h : ¬ ∃ (m : ℕ) (c : ℕ → R) (b : R),
      u = (∑ i ∈ Finset.range m, c i ^ p * π ^ i) + b * π ^ m ∧
        ¬ ∃ z : IsLocalRing.ResidueField R, IsLocalRing.residue R b = z ^ p)
    (m : ℕ) :
    ∃ (c : ℕ → R) (b : R),
      u = (∑ i ∈ Finset.range m, c i ^ p * π ^ i) + b * π ^ m := by
  classical
  induction m with
  | zero => exact ⟨fun _ => 0, u, by simp⟩
  | succ m ih =>
    obtain ⟨c, b, hb⟩ := ih
    have hr : ∃ z : IsLocalRing.ResidueField R, IsLocalRing.residue R b = z ^ p :=
      by_contra fun hn => h ⟨m, c, b, hb, hn⟩
    obtain ⟨z, hz⟩ := hr
    obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective z
    have hd : π ∣ b - a ^ p := by
      rw [← Ideal.mem_span_singleton, ← hπ.maximalIdeal_eq,
        ← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, ha, hz, sub_self]
    obtain ⟨d, hd⟩ := hd
    refine ⟨Function.update c m a, d, ?_⟩
    rw [Finset.sum_range_succ, Function.update_self, pow_succ]
    have hs : (∑ i ∈ Finset.range m, Function.update c m a i ^ p * π ^ i) =
        ∑ i ∈ Finset.range m, c i ^ p * π ^ i := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [Function.update_of_ne (Nat.ne_of_lt (Finset.mem_range.mp hi))]
    rw [hs, hb]
    linear_combination hd * π ^ m

private theorem exists_pow_eq_adicCompletion_of_no_nonpower_residue
    (R S : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsIntegrallyClosed S]
    {p : ℕ} [Fact p.Prime] [CharP S p]
    (f : R →+* S) (π u : R) (hπ : Irreducible π) (t : S) (ht : t ^ p = f π) (s : S) (hst : s ∣ t)
    (h : ¬ ∃ (m : ℕ) (c : ℕ → R) (b : R),
      u = (∑ i ∈ Finset.range m, c i ^ p * π ^ i) + b * π ^ m ∧
        ¬ ∃ z : IsLocalRing.ResidueField R, IsLocalRing.residue R b = z ^ p) :
    ∃ α : AdicCompletion (Ideal.span {s}) S,
      α ^ p = algebraMap S (AdicCompletion (Ideal.span {s}) S) (f u) := by
  apply exists_pow_eq_adicCompletion_of_forall_pow_dvd_sub S s (f u)
  intro m
  obtain ⟨c, b, hb⟩ := exists_expansion_of_no_nonpower_residue R p π u hπ h m
  refine ⟨∑ i ∈ Finset.range m, f (c i) * t ^ i, ?_⟩
  apply (pow_dvd_pow_of_dvd hst (m * p)).trans
  refine ⟨f b, ?_⟩
  rw [hb, map_add, map_mul, map_pow, map_sum, sum_pow_char]
  have hs : (∑ i ∈ Finset.range m, f (c i ^ p * π ^ i)) =
      ∑ i ∈ Finset.range m, (f (c i) * t ^ i) ^ p := by
    apply Finset.sum_congr rfl
    intro i hi
    rw [map_mul, map_pow, map_pow, mul_pow, ← ht, ← pow_mul, ← pow_mul,
      Nat.mul_comm p i]
  rw [hs, ← ht, ← pow_mul, Nat.mul_comm p m]
  ring

private theorem irreducible_map_or_pow_eq_unit_mul
    (R S : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    (f : R →+* S) (hf : Function.Injective f)
    (p : ℕ) (hp : p.Prime) (π : R) (hπ : Irreducible π)
    (hpow : ∀ x : S, ∃ b : R, f b = x ^ p) :
    Irreducible (f π) ∨
      ∃ (x : S) (u : Rˣ), Irreducible x ∧ x ^ p = f (↑u * π) := by
  by_cases hirr : Irreducible (f π)
  · exact Or.inl hirr
  right
  obtain ⟨x, hx⟩ := IsDiscreteValuationRing.exists_irreducible S
  obtain ⟨e, v, he⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
    ((map_ne_zero_iff f hf).mpr hπ.ne_zero) hx
  obtain ⟨b, hb⟩ := hpow x
  have hb0 : b ≠ 0 := by
    intro h
    rw [h, map_zero] at hb
    exact pow_ne_zero p hx.ne_zero hb.symm
  obtain ⟨n, u, hn⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hπ
  have he1 : e ≠ 1 := by
    intro h
    apply hirr
    rw [he, h, pow_one]
    exact (associated_unit_mul_left x (v : S) v.isUnit).symm.irreducible hx
  have hval : e * n = p := by
    have h := congrArg (IsDiscreteValuationRing.addVal S) hb
    rw [hn, map_mul, map_pow, IsDiscreteValuationRing.addVal_mul,
      IsDiscreteValuationRing.addVal_eq_zero_iff.mpr (u.isUnit.map f),
      zero_add, IsDiscreteValuationRing.addVal_pow,
      IsDiscreteValuationRing.addVal_def (f π) v hx e he, hx.addVal_pow] at h
    simpa only [nsmul_eq_mul, ← Nat.cast_mul, Nat.cast_inj, mul_comm] using h
  have hn1 : n = 1 := by
    by_contra h
    exact Nat.not_prime_of_mul_eq hval he1 h hp
  refine ⟨x, u, hx, ?_⟩
  rw [hn, hn1, pow_one] at hb
  exact hb.symm

private theorem pow_eq_algebraMap_of_finrank_eq_prime
    (R S K L : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    [Field K] [Field L] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Algebra R K] [IsFractionRing R K] [Algebra S L] [IsFractionRing S L]
    [Algebra R L] [Algebra K L] [IsScalarTower R S L] [IsScalarTower R K L]
    [FiniteDimensional K L] [IsPurelyInseparable K L]
    {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank K L = p) (x : S) :
    ∃ b : R, algebraMap R S b = x ^ p := by
  let := charP_of_finrank_eq_prime K L hp hdegree
  obtain ⟨a, ha⟩ := pow_mem_range_of_finrank_eq_prime K L hp hdegree
    (algebraMap S L x)
  have hai : IsLocalization.IsInteger S (algebraMap K L a) :=
    ⟨x ^ p, by rw [map_pow, ha]⟩
  obtain ⟨b, hb⟩ := isInteger_of_map_isInteger R S K L a hai
  refine ⟨b, IsFractionRing.injective S L ?_⟩
  rw [← IsScalarTower.algebraMap_apply R S L, IsScalarTower.algebraMap_apply R K L,
    hb, map_pow, ha]

private theorem isIntegral_of_finrank_eq_prime
    (R S K L : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    [Field K] [Field L] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Algebra R K] [IsFractionRing R K] [Algebra S L] [IsFractionRing S L]
    [Algebra R L] [Algebra K L] [IsScalarTower R S L] [IsScalarTower R K L]
    [FiniteDimensional K L] [IsPurelyInseparable K L]
    {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank K L = p) :
    Algebra.IsIntegral R S := by
  constructor
  intro x
  obtain ⟨b, hb⟩ := pow_eq_algebraMap_of_finrank_eq_prime R S K L hp hdegree x
  exact IsIntegral.of_pow hp.pos (hb ▸ isIntegral_algebraMap)

private theorem irreducible_X_pow_sub_C_of_irreducible
    (R K : Type*) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    {p : ℕ} (hp : p.Prime) (π : R) (hπ : Irreducible π) :
    Irreducible (Polynomial.X ^ p - Polynomial.C (algebraMap R K π)) := by
  apply X_pow_sub_C_irreducible_of_prime hp
  intro a ha
  have hai : IsIntegral R (a ^ p) := by rw [ha]; exact isIntegral_algebraMap
  obtain ⟨b, hb⟩ := IsIntegrallyClosed.exists_algebraMap_eq_of_isIntegral_pow hp.pos hai
  have hbπ : b ^ p = π := IsFractionRing.injective R K (by rw [map_pow, hb, ha])
  exact not_irreducible_pow hp.ne_one (hbπ.symm ▸ hπ)

/-- The map `K[X]/(f) → E` sending the root to a generator `x` of `E` is bijective. -/
private theorem bijective_liftAlgHom_of_adjoin_eq_top
    (K E : Type*) [Field K] [CommRing E] [Nontrivial E] [Algebra K E]
    (f : K[X]) [Fact (Irreducible f)] (x : E) (hx : Polynomial.aeval x f = 0)
    (hgen : Algebra.adjoin K {x} = ⊤) :
    Function.Bijective (AdjoinRoot.liftAlgHom f (Algebra.ofId K E) x hx) := by
  refine ⟨(AdjoinRoot.liftAlgHom f (Algebra.ofId K E) x hx).injective,
    (AlgHom.range_eq_top _).1 <| top_unique <| ?_⟩
  rw [← hgen, Algebra.adjoin_le_iff]
  rintro y rfl
  exact ⟨AdjoinRoot.root f, AdjoinRoot.liftAlgHom_root _ _ _ _⟩

/-- A root of a monic irreducible polynomial whose degree is `[E : K]` generates `E`. -/
private theorem adjoin_eq_top_of_aeval_eq_zero_of_finrank_eq
    (K E : Type*) [Field K] [Field E] [Algebra K E] [FiniteDimensional K E]
    (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (hdegree : Module.finrank K E = f.natDegree)
    (x : E) (hx : Polynomial.aeval x f = 0) :
    Algebra.adjoin K {x} = ⊤ := by
  apply Algebra.adjoin_eq_top_of_primitive_element (Algebra.IsAlgebraic.isAlgebraic x)
  apply (Field.primitive_element_iff_minpoly_natDegree_eq K x).mpr
  rw [← minpoly.eq_of_irreducible_of_monic hf hx hm, hdegree]

private theorem exists_algEquiv_adjoinRoot_of_finrank_eq
    (K E : Type*) [Field K] [Field E] [Algebra K E] [FiniteDimensional K E]
    (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (hdegree : Module.finrank K E = f.natDegree)
    (x : E) (hx : Polynomial.aeval x f = 0) :
    ∃ e : AdjoinRoot f ≃ₐ[K] E, e (AdjoinRoot.root f) = x := by
  let : Fact (Irreducible f) := ⟨hf⟩
  exact ⟨AlgEquiv.ofBijective _ (bijective_liftAlgHom_of_adjoin_eq_top K E f x hx
    (adjoin_eq_top_of_aeval_eq_zero_of_finrank_eq K E f hf hm hdegree x hx)),
    AdjoinRoot.liftAlgHom_root f (Algebra.ofId K E) x hx⟩

private theorem integralClosure_eq_adjoin_of_pow_eq_uniformizer
    (R K E : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Field E] [Algebra R K] [IsFractionRing R K]
    [Algebra K E] [Algebra R E] [IsScalarTower R K E]
    [FiniteDimensional K E] {p : ℕ} (hp : p.Prime)
    (hdegree : Module.finrank K E = p)
    (π : R) (hπ : Irreducible π) (x : E) (hx : x ^ p = algebraMap R E π) :
    integralClosure R E = Algebra.adjoin R {x} := by
  let f : K[X] := Polynomial.X ^ p - Polynomial.C (algebraMap R K π)
  have hf : Irreducible f := irreducible_X_pow_sub_C_of_irreducible R K hp π hπ
  obtain ⟨e, he⟩ := exists_algEquiv_adjoinRoot_of_finrank_eq K E f hf
    (Polynomial.monic_X_pow_sub_C _ hp.ne_zero)
    (by simpa only [f, Polynomial.natDegree_X_pow_sub_C] using hdegree)
    x (by simp [f, hx, IsScalarTower.algebraMap_apply R K E])
  have hclosure := Stacks.KummerExtension.integralClosure_eq_adjoin K π p hp.two_le hπ
  change integralClosure R (AdjoinRoot f) = Algebra.adjoin R {AdjoinRoot.root f} at hclosure
  rw [← integralClosure_map_algEquiv (e.restrictScalars R), hclosure,
    AlgHom.map_adjoin_singleton]
  change Algebra.adjoin R {e (AdjoinRoot.root f)} = Algebra.adjoin R {x}
  rw [he]

private theorem adjoin_eq_top_of_pow_eq_uniformizer
    (R S K L : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    [Field K] [Field L] [Algebra R S] [Algebra R K] [IsFractionRing R K]
    [Algebra S L] [IsFractionRing S L] [Algebra R L] [Algebra K L]
    [IsScalarTower R S L] [IsScalarTower R K L]
    [Algebra.IsIntegral R S] [FiniteDimensional K L]
    {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank K L = p)
    (π : R) (hπ : Irreducible π) (x : S) (hx : x ^ p = algebraMap R S π) :
    Algebra.adjoin R {x} = ⊤ := by
  let f := IsScalarTower.toAlgHom R S L
  have hi : Function.Injective f := IsFractionRing.injective S L
  have hc : f.range = integralClosure R L := by
    let := IsIntegralClosure.of_isIntegrallyClosed S R L
    ext y
    exact IsIntegralClosure.isIntegral_iff.symm
  apply (Subalgebra.map_injective hi)
  rw [Algebra.map_top, AlgHom.map_adjoin_singleton, hc]
  symm
  apply integralClosure_eq_adjoin_of_pow_eq_uniformizer R K L hp hdegree π hπ
  change (algebraMap S L x) ^ p = algebraMap R L π
  rw [← map_pow, hx, ← IsScalarTower.algebraMap_apply R S L]

set_option backward.isDefEq.respectTransparency false in
private theorem exists_root_uniformizer_of_no_nonpower_residue
    (R S K L : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    [Field K] [Field L] [Algebra R S] [IsLocalHom (algebraMap R S)]
    [Algebra R K] [IsFractionRing R K] [Algebra S L] [IsFractionRing S L]
    [Algebra R L] [Algebra K L] [IsScalarTower R S L] [IsScalarTower R K L]
    [FiniteDimensional K L] [IsPurelyInseparable K L]
    {p : ℕ} [Fact p.Prime] (hdegree : Module.finrank K L = p)
    (π : R) (hπ : Irreducible π) (hNagata : IsNagataRing R)
    (x : S) (u : Rˣ) (hx : x ^ p = algebraMap R S (↑u * π))
    (h : ¬ ∃ (m : ℕ) (c : ℕ → R) (b : R),
      (u : R) = (∑ i ∈ Finset.range m, c i ^ p * π ^ i) + b * π ^ m ∧
        ¬ ∃ z : IsLocalRing.ResidueField R, IsLocalRing.residue R b = z ^ p) :
    ∃ y : S, y ^ p = algebraMap R S π ∧ Algebra.adjoin R {y} = ⊤ := by
  let hp : p.Prime := Fact.out
  let := charP_of_finrank_eq_prime K L hp hdegree
  let : CharP R p := (algebraMap R K).charP (IsFractionRing.injective R K) p
  let f : K[X] := X ^ p - C (algebraMap R K π)
  have hf : Irreducible f := irreducible_X_pow_sub_C_of_irreducible R K hp π hπ
  let : Fact (Irreducible f) := ⟨hf⟩
  let : Fact (Irreducible (Stacks.KummerExtension.kummerPoly K π p)) := ⟨hf⟩
  let E := AdjoinRoot f
  let D := integralClosure R E
  let : IsDiscreteValuationRing D := Stacks.KummerExtension.isDiscreteValuationRing_A1 K π p
    hp.two_le hπ
  let : CharP E p := charP_of_injective_algebraMap (algebraMap K E).injective p
  let : CharP D p := (algebraMap D E).charP Subtype.val_injective p
  have htE : (AdjoinRoot.root f) ^ p = algebraMap R E π := by
    simpa [f, sub_eq_zero, ← AdjoinRoot.algebraMap_eq,
      IsScalarTower.algebraMap_apply R K E] using AdjoinRoot.eval₂_root f
  have hti : IsIntegral R (AdjoinRoot.root f) :=
    IsIntegral.of_pow hp.pos (htE.symm ▸ isIntegral_algebraMap)
  let t : D := ⟨AdjoinRoot.root f, hti⟩
  have ht : t ^ p = algebraMap R D π := Subtype.ext htE
  let : Module.Finite R D := by
    change Module.Finite R ↥(integralClosure R E)
    have hc : integralClosure R E = Algebra.adjoin R {AdjoinRoot.root f} :=
      Stacks.KummerExtension.integralClosure_eq_adjoin K π p hp.two_le hπ
    rw [hc]
    exact Algebra.finite_adjoin_simple_of_isIntegral hti
  have hfiniteType := ((isNagataRing_tfae (R := R)).out 1 2).mp hNagata
  have hDNagata : IsNagataRing D := hfiniteType D
  let : FaithfulSMul R D := (faithfulSMul_iff_algebraMap_injective R D).mpr (by
    intro a b hab
    apply IsFractionRing.injective R K
    apply (algebraMap K E).injective
    have habE : algebraMap R E a = algebraMap R E b := congrArg Subtype.val hab
    simpa only [← IsScalarTower.algebraMap_apply R K E] using habE)
  have htunit : ¬ IsUnit t := fun hu =>
    hπ.not_isUnit ((isUnit_map_iff (algebraMap R D) π).mp (ht ▸ hu.pow p))
  obtain ⟨δ, hδ⟩ := IsDiscreteValuationRing.exists_irreducible D
  have hδt : δ ∣ t := by
    rw [← Ideal.mem_span_singleton, ← hδ.maximalIdeal_eq]
    exact htunit
  have hα := exists_pow_eq_adicCompletion_of_no_nonpower_residue
    R D (algebraMap R D) π (u : R) hπ t ht δ hδt h
  rw [← hδ.maximalIdeal_eq] at hα
  obtain ⟨v, hv⟩ := (hDNagata.exists_pow_eq_iff_exists_pow_eq_adicCompletion hp.ne_zero
    (algebraMap R D (u : R))).mpr hα
  have hdegE : Module.finrank K E = p := Stacks.KummerExtension.finrank_K1 K π p hp.two_le hπ
  let : FiniteDimensional K E := (AdjoinRoot.powerBasis hf.ne_zero).finite
  have huπ : Irreducible ((u : R) * π) :=
    (associated_unit_mul_left π (u : R) u.isUnit).symm.irreducible hπ
  let q : K[X] := X ^ p - C (algebraMap R K (↑u * π))
  have hq : Irreducible q := irreducible_X_pow_sub_C_of_irreducible R K hp _ huπ
  have hm : q.Monic := monic_X_pow_sub_C _ hp.ne_zero
  have hxL : (algebraMap S L x) ^ p = algebraMap R L (↑u * π) := by
    rw [← map_pow, hx, ← IsScalarTower.algebraMap_apply R S L]
  have hzE : (algebraMap D E (v * t)) ^ p = algebraMap R E (↑u * π) := by
    rw [← map_pow, mul_pow, hv, ht, ← map_mul, ← IsScalarTower.algebraMap_apply R D E]
  obtain ⟨eL, _⟩ := exists_algEquiv_adjoinRoot_of_finrank_eq K L q hq hm
    (by simpa only [q, natDegree_X_pow_sub_C] using hdegree)
    (algebraMap S L x) (by simp [q, hxL, IsScalarTower.algebraMap_apply R K L])
  obtain ⟨eE, _⟩ := exists_algEquiv_adjoinRoot_of_finrank_eq K E q hq hm
    (by simpa only [q, natDegree_X_pow_sub_C] using hdegE)
    (algebraMap D E (v * t)) (by
      simp only [q, map_sub, map_pow, aeval_X, aeval_C]
      rw [← IsScalarTower.algebraMap_apply R K E, hzE, sub_self])
  let e : E ≃ₐ[R] L := (eE.symm.trans eL).restrictScalars R
  have hy : (e (AdjoinRoot.root f)) ^ p = algebraMap R L π := by
    rw [← map_pow, htE, e.commutes]
  have hyi : IsIntegral S (e (AdjoinRoot.root f)) := by
    apply IsIntegral.of_pow hp.pos
    rw [hy, IsScalarTower.algebraMap_apply R S L]
    exact isIntegral_algebraMap
  obtain ⟨y, hyval⟩ := IsIntegrallyClosed.isIntegral_iff.mp hyi
  have hyp : y ^ p = algebraMap R S π := IsFractionRing.injective S L (by
    rw [map_pow, hyval, hy, ← IsScalarTower.algebraMap_apply R S L])
  let := isIntegral_of_finrank_eq_prime R S K L hp hdegree
  exact ⟨y, hyp, adjoin_eq_top_of_pow_eq_uniformizer R S K L hp hdegree π hπ y hyp⟩

private theorem isField_of_adjoin_eq_top_of_pow_eq
    (R K E : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [CommRing E] [Nontrivial E] [Algebra K E] [Algebra R E] [IsScalarTower R K E]
    {p : ℕ} [Fact p.Prime] (a : R)
    (ha : ¬ ∃ z : IsLocalRing.ResidueField R, IsLocalRing.residue R a = z ^ p)
    (x : E) (hx : x ^ p = algebraMap R E a) (hgen : Algebra.adjoin K {x} = ⊤) :
    IsField E := by
  let f : K[X] := X ^ p - C (algebraMap R K a)
  have hf : Irreducible f := Stacks.DiscreteValuationRing.AdjoinPthRoot.statement1_irreducible p a
    ha
  let : Fact (Irreducible f) := ⟨hf⟩
  exact (AlgEquiv.ofBijective _ (bijective_liftAlgHom_of_adjoin_eq_top K E f x
    (by simp [f, hx, IsScalarTower.algebraMap_apply R K E]) hgen)).symm.toRingEquiv.isField
    (Field.toIsField _)

private theorem pow_dvd_sub_expansion
    (R S : Type*) [CommRing R] [CommRing S]
    {p : ℕ} [Fact p.Prime] [CharP S p]
    (f : R →+* S) (π u : R) (m n : ℕ) (c : ℕ → R) (b : R)
    (hu : u = (∑ i ∈ Finset.range m, c i ^ p * π ^ i) + b * π ^ m)
    (t a : S) (ht : f π = t ^ p + t ^ (n * p) * a) :
    ∃ d : S, f (u * π) = (∑ i ∈ Finset.range m, f (c i) * t ^ (i + 1)) ^ p +
      f b * t ^ ((m + 1) * p) + t ^ (n * p) * d := by
  let I : Ideal S := Ideal.span {t ^ (n * p)}
  let q := Ideal.Quotient.mk I
  have hqt : q (f π) = q t ^ p := by
    rw [ht, map_add, map_mul, map_pow, map_pow]
    have hzero : q t ^ (n * p) = 0 := by
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self _
    rw [hzero, zero_mul, add_zero]
  have heq : q (f (u * π)) =
      q ((∑ i ∈ Finset.range m, f (c i) * t ^ (i + 1)) ^ p +
        f b * t ^ ((m + 1) * p)) := by
    rw [hu]
    simp only [map_mul, map_add, map_sum, map_pow, hqt, sum_pow_char,
      Finset.sum_mul, add_mul]
    congr 1
    · apply Finset.sum_congr rfl
      intro i hi
      simp only [mul_pow, pow_succ]
      ring
    · ring
  have hd : t ^ (n * p) ∣ f (u * π) -
      ((∑ i ∈ Finset.range m, f (c i) * t ^ (i + 1)) ^ p +
        f b * t ^ ((m + 1) * p)) := by
    rw [← Ideal.mem_span_singleton]
    exact Ideal.Quotient.eq.mp heq
  obtain ⟨d, hd⟩ := hd
  exact ⟨d, by linear_combination hd⟩

/-- A ring map of discrete valuation rings carrying the maximal ideal onto the maximal ideal
preserves uniformizers. -/
private theorem irreducible_map_of_map_maximalIdeal_eq
    {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] (f : R →+* S)
    (hf : Ideal.map f (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S)
    {π : R} (hπ : Irreducible π) : Irreducible (f π) := by
  apply (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr
  rw [← hf, hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]

private theorem weaklyUnramified_or_adjoin_root_or_nonpower_expansion
    (A B C L M : Type u)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [CommRing C] [IsDomain C] [IsDiscreteValuationRing C]
    [Field L] [Field M]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C]
    [FaithfulSMul B C] [IsLocalHom (algebraMap B C)]
    [Algebra B L] [Algebra C M] [Algebra B M] [Algebra L M]
    [IsScalarTower B C M] [IsScalarTower B L M]
    [IsFractionRing B L] [IsFractionRing C M]
    {p : ℕ} [Fact p.Prime] [FiniteDimensional L M] [IsPurelyInseparable L M]
    (hdegree : Module.finrank L M = p) (π : A) (hπ : Irreducible π)
    (hNagata : IsNagataRing B)
    (hweak : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B) :
    Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) =
        IsLocalRing.maximalIdeal C ∨
      (∃ y : C, y ^ p = algebraMap A C π ∧ Algebra.adjoin B {y} = ⊤) ∨
      ∃ (x : C) (u : Bˣ) (m : ℕ) (c : ℕ → B) (b : B),
        Irreducible x ∧ x ^ p = algebraMap B C (↑u * algebraMap A B π) ∧
        (u : B) = (∑ i ∈ Finset.range m, c i ^ p * (algebraMap A B π) ^ i) +
          b * (algebraMap A B π) ^ m ∧
        ¬ ∃ z : IsLocalRing.ResidueField B, IsLocalRing.residue B b = z ^ p := by
  classical
  have hπB : Irreducible (algebraMap A B π) :=
    irreducible_map_of_map_maximalIdeal_eq _ hweak hπ
  rcases irreducible_map_or_pow_eq_unit_mul B C (algebraMap B C)
      (FaithfulSMul.algebraMap_injective B C) p Fact.out (algebraMap A B π) hπB
      (pow_eq_algebraMap_of_finrank_eq_prime B C L M Fact.out hdegree) with hirr | ⟨x, u, hx, hu⟩
  · left
    rw [IsScalarTower.algebraMap_eq A B C, ← Ideal.map_map, hweak,
      hπB.maximalIdeal_eq, Ideal.map_span, Set.image_singleton, ← hirr.maximalIdeal_eq]
  · right
    by_cases h : ∃ (m : ℕ) (c : ℕ → B) (b : B),
        (u : B) = (∑ i ∈ Finset.range m, c i ^ p * (algebraMap A B π) ^ i) +
          b * (algebraMap A B π) ^ m ∧
        ¬ ∃ z : IsLocalRing.ResidueField B, IsLocalRing.residue B b = z ^ p
    · obtain ⟨m, c, b, hb, hres⟩ := h
      exact Or.inr ⟨x, u, m, c, b, hx, hu, hb, hres⟩
    · obtain ⟨y, hyp, hgen⟩ := exists_root_uniformizer_of_no_nonpower_residue
        B C L M hdegree (algebraMap A B π) hπB hNagata x u hu h
      exact Or.inl ⟨y, by simpa only [← IsScalarTower.algebraMap_apply A B C] using hyp, hgen⟩

/-- **The residue field of a base-changed local ring, when the base change is residually
trivial.**

If `A → B` is residually surjective on maximal ideals (`hweak`), `D` has residue field
`A`-isomorphic to that of `A` (`er`), and `T` is a local ring presenting `B ⊗[A] D` with its
maximal ideal generated by that of `D` (`e`, `hm`), then `κ_T ≅ₐ[B] κ_B`. -/
theorem exists_residueField_algEquiv_of_tensorProduct
    (A B D T : Type*) [CommRing A] [CommRing B] [CommRing D] [CommRing T]
    [IsLocalRing A] [IsLocalRing B] [IsLocalRing D] [IsLocalRing T]
    [Algebra A B] [Algebra A D] [Algebra B T]
    (hweak : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B)
    (er : (D ⧸ IsLocalRing.maximalIdeal D) ≃ₐ[A] (A ⧸ IsLocalRing.maximalIdeal A))
    (e : (B ⊗[A] D) ≃ₐ[B] T)
    (hm : Ideal.map e.toRingHom
      (Ideal.map Algebra.TensorProduct.includeRight.toRingHom (IsLocalRing.maximalIdeal D)) =
      IsLocalRing.maximalIdeal T) :
    Nonempty ((T ⧸ IsLocalRing.maximalIdeal T) ≃ₐ[B]
      (B ⧸ IsLocalRing.maximalIdeal B)) :=
  ⟨(Ideal.quotientEquivAlg _ _ e hm.symm).symm |>.trans
    (Algebra.TensorProduct.tensorQuotientEquiv (R := A) B D B
      (IsLocalRing.maximalIdeal D)).symm |>.trans
    (Algebra.TensorProduct.congr (AlgEquiv.refl : B ≃ₐ[B] B) er) |>.trans
    (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (IsLocalRing.maximalIdeal A)).symm |>.trans
    (Ideal.quotientEquivAlgOfEq B hweak)⟩

private theorem exists_pow_eq_of_affine_pow_eq
    (K E : Type*) [Field K] [CommRing E] [Algebra K E]
    {p : ℕ} [Fact p.Prime] [CharP E p]
    (a s c : K) (hc : c ≠ 0) (x : E)
    (hx : x ^ p = algebraMap K E s ^ p +
      algebraMap K E c ^ p * algebraMap K E a)
    (hgen : Algebra.adjoin K {x} = ⊤) :
    ∃ y : E, y ^ p = algebraMap K E a ∧ Algebra.adjoin K {y} = ⊤ := by
  let y : E := (x - algebraMap K E s) * algebraMap K E c⁻¹
  have hci : algebraMap K E c * algebraMap K E c⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ hc, map_one]
  have hyp : y ^ p = algebraMap K E a := by
    dsimp [y]
    rw [mul_pow, sub_pow_char, hx, add_sub_cancel_left]
    calc
      (algebraMap K E c ^ p * algebraMap K E a) * algebraMap K E c⁻¹ ^ p =
          algebraMap K E a * (algebraMap K E c * algebraMap K E c⁻¹) ^ p := by
        rw [mul_pow]
        ring
      _ = algebraMap K E a := by rw [hci, one_pow, mul_one]
  have hxy : x = y * algebraMap K E c + algebraMap K E s := by
    dsimp [y]
    calc
      x = (x - algebraMap K E s) * 1 + algebraMap K E s := by ring
      _ = _ := by rw [← hci]; ring
  refine ⟨y, hyp, ?_⟩
  apply top_unique
  rw [← hgen, Algebra.adjoin_le_iff, Set.singleton_subset_iff, hxy]
  exact (Algebra.adjoin K {y}).add_mem
    ((Algebra.adjoin K {y}).mul_mem (Algebra.subset_adjoin (Set.mem_singleton y))
      ((Algebra.adjoin K {y}).algebraMap_mem c))
    ((Algebra.adjoin K {y}).algebraMap_mem s)

set_option backward.isDefEq.respectTransparency false in
private theorem adjoin_tensorProduct_eq_top_of_adjoin_eq_top
    (K L M K₁ : Type*) [Field K] [Field L] [Field M] [Field K₁]
    [Algebra K L] [Algebra K M] [Algebra K K₁] [Algebra L M] [IsScalarTower K L M]
    (x : M) (hx : Algebra.adjoin L {x} = ⊤) :
    let g : L ⊗[K] K₁ →ₐ[K] M ⊗[K] K₁ :=
      Algebra.TensorProduct.map (R := K) (S := K)
        (IsScalarTower.toAlgHom K L M) (AlgHom.id K K₁)
    letI := g.toRingHom.toAlgebra
    Algebra.adjoin (L ⊗[K] K₁)
      {(Algebra.TensorProduct.includeLeft : M →ₐ[K] M ⊗[K] K₁) x} = ⊤ := by
  let T := L ⊗[K] K₁
  let U := M ⊗[K] K₁
  let g : T →ₐ[K] U :=
    Algebra.TensorProduct.map (R := K) (S := K)
        (IsScalarTower.toAlgHom K L M) (AlgHom.id K K₁)
  let := g.toRingHom.toAlgebra
  let j : M →ₐ[K] U := Algebra.TensorProduct.includeLeft
  let S : Subalgebra T U := Algebra.adjoin T {j x}
  have hl (l : L) : j (algebraMap L M l) ∈ S := by
    have h := S.algebraMap_mem (l ⊗ₜ[K] (1 : K₁))
    change g (l ⊗ₜ[K] (1 : K₁)) ∈ S at h
    have hmap : g (l ⊗ₜ[K] (1 : K₁)) = j (algebraMap L M l) :=
      Algebra.TensorProduct.map_tmul (R := K) (S := K)
        (IsScalarTower.toAlgHom K L M) (AlgHom.id K K₁) l 1
    exact hmap ▸ h
  have hj (m : M) : j m ∈ S := by
    have hm : m ∈ Algebra.adjoin L {x} := by rw [hx]; trivial
    induction hm using Algebra.adjoin_induction with
    | mem y hy =>
      rcases hy with rfl
      exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap l => exact hl l
    | add a b _ _ ha hb => rw [map_add]; exact S.add_mem ha hb
    | mul a b _ _ ha hb => rw [map_mul]; exact S.mul_mem ha hb
  change S = ⊤
  suffices hall : ∀ z : U, z ∈ S from top_unique (fun z _ => hall z)
  intro z
  induction z using TensorProduct.inductionOn with
  | add z w hz hw => exact S.add_mem hz hw
  | tmul m k =>
    have hk := S.algebraMap_mem ((1 : L) ⊗ₜ[K] k)
    change g ((1 : L) ⊗ₜ[K] k) ∈ S at hk
    have hmap : g ((1 : L) ⊗ₜ[K] k) = (1 : M) ⊗ₜ[K] k :=
      (Algebra.TensorProduct.map_tmul (R := K) (S := K)
        (IsScalarTower.toAlgHom K L M) (AlgHom.id K K₁) 1 k).trans (by simp)
    rw [hmap] at hk
    have h := S.mul_mem (hj m) hk
    change (m ⊗ₜ[K] (1 : K₁)) * ((1 : M) ⊗ₜ[K] k) ∈ S at h
    simpa only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul] using h

private theorem residue_not_pow_of_residueField_algEquiv
    (R S : Type*) [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S]
    [Algebra R S]
    (e : IsLocalRing.ResidueField S ≃ₐ[R] IsLocalRing.ResidueField R)
    (p : ℕ) (b : R)
    (hb : ¬ ∃ z : IsLocalRing.ResidueField R, IsLocalRing.residue R b = z ^ p)
    (v : S) (hv : v ∈ IsLocalRing.maximalIdeal S) :
    ¬ ∃ z : IsLocalRing.ResidueField S,
      IsLocalRing.residue S (algebraMap R S b + v) = z ^ p := by
  rintro ⟨z, hz⟩
  have hv0 := (IsLocalRing.residue_eq_zero_iff v).mpr hv
  rw [map_add, hv0, add_zero] at hz
  have he := congrArg e hz
  change e (algebraMap R (IsLocalRing.ResidueField S) b) = e (z ^ p) at he
  rw [e.commutes, map_pow] at he
  exact hb ⟨e z, he⟩

/-- **A totally ramified extension has the residue field of its base.** -/
theorem exists_residueField_algEquiv_of_totallyRamified
    (A K E : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field E] [Algebra A K] [IsFractionRing A K]
    [Algebra K E] [Algebra A E] [IsScalarTower A K E]
    [FiniteDimensional K E] [Algebra.IsSeparable K E]
    [IsDiscreteValuationRing (integralClosure A E)]
    (htot : IsDiscreteValuationRing.IsTotallyRamifiedWithRespectTo A K E) :
    Nonempty ((integralClosure A E ⧸ IsLocalRing.maximalIdeal (integralClosure A E)) ≃ₐ[A]
      (A ⧸ IsLocalRing.maximalIdeal A)) := by
  let D := integralClosure A E
  obtain ⟨m, hm, hml, _, hf⟩ := htot
  have heqm : m = IsLocalRing.maximalIdeal D := IsLocalRing.eq_maximalIdeal hm
  have hfm := heqm ▸ hf
  let : (IsLocalRing.maximalIdeal D).LiesOver (IsLocalRing.maximalIdeal A) := heqm ▸ hml
  let := Ideal.Quotient.algebraOfLiesOver (IsLocalRing.maximalIdeal D)
    (IsLocalRing.maximalIdeal A)
  let : Field (A ⧸ IsLocalRing.maximalIdeal A) :=
    Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
  let : Field (D ⧸ IsLocalRing.maximalIdeal D) :=
    Ideal.Quotient.field (IsLocalRing.maximalIdeal D)
  let : Module.Free (A ⧸ IsLocalRing.maximalIdeal A) (D ⧸ IsLocalRing.maximalIdeal D) :=
    Module.Free.of_divisionRing _ _
  have hfmax : Module.finrank (A ⧸ IsLocalRing.maximalIdeal A)
      (D ⧸ IsLocalRing.maximalIdeal D) = 1 := by simpa using hfm
  have hbij := Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hfmax
  exact ⟨(AlgEquiv.ofBijective
    (IsScalarTower.toAlgHom A (A ⧸ IsLocalRing.maximalIdeal A)
      (D ⧸ IsLocalRing.maximalIdeal D)) hbij).symm⟩

/-- If a ring map `f : R →+* S` of local rings carries the maximal ideal of `R` onto the maximal
ideal of `S`, then its composite with a ring isomorphism `e : S ≃+* T` carries the maximal ideal of
`R` onto the maximal ideal of `T`. -/
theorem map_maximalIdeal_comp_ringEquiv
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing T]
    (f : R →+* S) (e : S ≃+* T)
    (hf : Ideal.map f (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S) :
    Ideal.map (e.toRingHom.comp f) (IsLocalRing.maximalIdeal R) =
      IsLocalRing.maximalIdeal T := by
  rw [← Ideal.map_map, hf]
  exact IsLocalRing.map_maximalIdeal_of_surjective e.toRingHom e.surjective

set_option backward.isDefEq.respectTransparency false in
private theorem exists_isDiscreteValuationRing_integralClosure_of_isIntegral
    (R S T E : Type*) [CommRing R] [CommRing S] [CommRing T] [Field E]
    [Algebra R S] [Algebra R T] [Algebra R E] [Algebra S E] [Algebra T E]
    [IsScalarTower R S E] [IsScalarTower R T E]
    [Algebra.IsIntegral R S] [Algebra.IsIntegral R T] [IsLocalRing S]
    [IsDiscreteValuationRing (integralClosure S E)]
    (hinj : Function.Injective (algebraMap S E))
    (hm : Ideal.map (algebraMap S (integralClosure S E)) (IsLocalRing.maximalIdeal S) =
      IsLocalRing.maximalIdeal (integralClosure S E)) :
    ∃ hv : IsDiscreteValuationRing (integralClosure T E),
      letI := hv
      ∃ f : S →+* integralClosure T E,
        Function.Injective f ∧
          (∀ s, (f s : E) = algebraMap S E s) ∧
          Ideal.map f (IsLocalRing.maximalIdeal S) =
            IsLocalRing.maximalIdeal (integralClosure T E) := by
  let D := integralClosure S E
  let C := integralClosure T E
  let e : D ≃ₐ[R] C :=
    (Stacks.DiscreteValuationRing.AdjoinPthRoot.integralClosureEquivOfIsIntegral (R := R) (S := S)
      (T := E)).trans
      (Stacks.DiscreteValuationRing.AdjoinPthRoot.integralClosureEquivOfIsIntegral (R := R) (S := T)
        (T := E)).symm
  let hv : IsDiscreteValuationRing C :=
    IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e
  let f : S →+* C := e.toRingHom.comp (algebraMap S D)
  refine ⟨hv, f, ?_, ?_, ?_⟩
  · exact e.injective.comp (fun _ _ h => hinj (congrArg Subtype.val h))
  · intro s
    rfl
  · exact map_maximalIdeal_comp_ringEquiv (algebraMap S D) e.toRingEquiv hm

-- The canonical tensor maps and integral closures involve several dependent scalar towers.
set_option backward.isDefEq.respectTransparency false in
/-- For a weakly unramified extension `A → B` of discrete valuation rings with `B`
Nagata, followed by a purely inseparable extension of fraction fields of prime degree `p`,
either the composite extension is weakly unramified, the upper DVR is generated by a
`p`-th root of a uniformizer of `A`, or a separable totally ramified degree-`p` base change
makes both maps between the resulting integral closures weakly unramified. -/
@[stacks 09EY]
theorem weaklyUnramified_or_adjoin_root_or_after_totallyRamified_baseChange
    (A B C K L M : Type u)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [CommRing C] [IsDomain C] [IsDiscreteValuationRing C]
    [Field K] [Field L] [Field M]
    [Algebra A B] [Algebra B C] [Algebra A C]
    [FaithfulSMul A B] [FaithfulSMul B C]
    [IsScalarTower A B C]
    [IsLocalHom (algebraMap A B)] [IsLocalHom (algebraMap B C)]
    [Algebra A K] [Algebra B L] [Algebra C M]
    [Algebra A L] [Algebra A M] [Algebra B M]
    [Algebra K L] [Algebra K M] [Algebra L M]
    [IsScalarTower A B L] [IsScalarTower B C M]
    [IsScalarTower A C M] [IsScalarTower B L M]
    [IsScalarTower A K L] [IsScalarTower K L M]
    [IsScalarTower A B M] [IsScalarTower A K M]
    [IsFractionRing A K] [IsFractionRing B L] [IsFractionRing C M]
    (p : ℕ) [Fact p.Prime] [FiniteDimensional L M] [IsPurelyInseparable L M]
    (hdegree : Module.finrank L M = p)
    (π : A) (hπ : Irreducible π)
    (hNagata : IsNagataRing B)
    (hweak : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B) :
    Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) =
        IsLocalRing.maximalIdeal C ∨
      (∃ x : C, x ^ p = algebraMap A C π ∧ Algebra.adjoin B {x} = ⊤) ∨
      ∃ (K₁ : Type u) (_ : Field K₁) (_ : Algebra K K₁) (_ : Algebra A K₁)
        (_ : IsScalarTower A K K₁) (_ : FiniteDimensional K K₁)
        (_ : Algebra.IsSeparable K K₁),
        Module.finrank K K₁ = p ∧
          IsDiscreteValuationRing.IsTotallyRamifiedWithRespectTo A K K₁ ∧
          let L₁ := L ⊗[K] K₁
          let M₁ := M ⊗[K] K₁
          let A₁ := integralClosure A K₁
          let B₁ := integralClosure B L₁
          let C₁ := integralClosure C M₁
          IsField L₁ ∧ IsField M₁ ∧
            ∃ hA₁ : IsDiscreteValuationRing A₁,
              letI := hA₁
              ∃ hB₁dom : IsDomain B₁,
                letI := hB₁dom
                ∃ hB₁ : IsDiscreteValuationRing B₁,
                  letI := hB₁
                  ∃ hC₁dom : IsDomain C₁,
                    letI := hC₁dom
                    ∃ hC₁ : IsDiscreteValuationRing C₁,
                      letI := hC₁
                      ∃ (g : L₁ →+* M₁) (f : A₁ →+* B₁) (f' : B₁ →+* C₁),
                        Function.Injective f ∧ Function.Injective f' ∧
                          (∀ l : L, g
                            ((Algebra.TensorProduct.includeLeft : L →ₐ[K] L₁) l) =
                            (Algebra.TensorProduct.includeLeft : M →ₐ[K] M₁)
                              (algebraMap L M l)) ∧
                          (∀ k : K₁, g
                            ((Algebra.TensorProduct.includeRight : K₁ →ₐ[K] L₁) k) =
                            (Algebra.TensorProduct.includeRight : K₁ →ₐ[K] M₁) k) ∧
                          (∀ a : A₁, ((f a : B₁) : L₁) =
                            (Algebra.TensorProduct.includeRight : K₁ →ₐ[K] L₁) (a : K₁)) ∧
                          (∀ b : B₁, ((f' b : C₁) : M₁) = g (b : L₁)) ∧
                          Ideal.map f (IsLocalRing.maximalIdeal A₁) =
                            IsLocalRing.maximalIdeal B₁ ∧
                          Ideal.map f' (IsLocalRing.maximalIdeal B₁) =
                            IsLocalRing.maximalIdeal C₁ := by
  classical
  rcases weaklyUnramified_or_adjoin_root_or_nonpower_expansion
      A B C L M hdegree π hπ hNagata hweak with hw | hr | ⟨x, u, m, c, b, hx, hxp, hu, hb⟩
  · exact Or.inl hw
  · exact Or.inr (Or.inl hr)
  right; right
  have hp : p.Prime := Fact.out
  let : CharP L p := charP_of_finrank_eq_prime L M hp hdegree
  let : CharP A p := (algebraMap A L).charP
    (by
      intro r s hrs
      apply IsFractionRing.injective A K
      apply (algebraMap K L).injective
      simpa only [← IsScalarTower.algebraMap_apply A K L] using hrs) p
  let : CharP M p := charP_of_injective_algebraMap (algebraMap L M).injective p
  let : CharP (A ⧸ IsLocalRing.maximalIdeal A) p :=
    CharP.of_ringHom_of_ne_zero (IsLocalRing.residue A) p hp.ne_zero
  have hres : ringChar (A ⧸ IsLocalRing.maximalIdeal A) = p := ringChar.eq _ p
  obtain ⟨K₁, hK₁, hKK₁, hAK₁, hAKK₁, hfin, hsep, hA₁, hdeg, htot, _, t, a, a', ht, _, htp⟩ :=
    Stacks.EisensteinExtension.exists_totallyRamifiedExtension_with_uniformizer_eq
      A K π hπ p (m + 2) p hp.pos hres (by omega) ⟨1, by simp⟩
  let L₁ := L ⊗[K] K₁
  let M₁ := M ⊗[K] K₁
  let A₁ := integralClosure A K₁
  let B₁ := integralClosure B L₁
  let C₁ := integralClosure C M₁
  obtain ⟨hL₁, hA₁', hBTdom, hBT, hiT, hmT, hB₁dom, hB₁, hfrac, e, he, hf, hm⟩ :=
    IsDiscreteValuationRing.isField_tensorProduct_and_isDVR_baseChange_of_totallyRamified
      A B K L K₁ hweak htot
  let : Field L₁ := hL₁.toField
  let : CharP L₁ p := CharP.of_ringHom_of_ne_zero (algebraMap L L₁) p hp.ne_zero
  let := hBTdom
  let := hBT
  let := hB₁dom
  let := hB₁
  let := hfrac
  let f : A₁ →+* B₁ := e.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom
  have hfm : Ideal.map f (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B₁ := hm
  have hft : Irreducible (f t) := irreducible_map_of_map_maximalIdeal_eq f hfm ht
  obtain ⟨erA⟩ := exists_residueField_algEquiv_of_totallyRamified A K K₁ htot
  obtain ⟨erB⟩ := exists_residueField_algEquiv_of_tensorProduct A B A₁ B₁ hweak erA e
    (by simpa only [Ideal.map_map] using hfm)
  have hfA (z : A) : f (algebraMap A A₁ z) = algebraMap B B₁ (algebraMap A B z) := by
    apply IsFractionRing.injective B₁ L₁
    change (f (algebraMap A A₁ z) : L₁) = _
    have hh := he (algebraMap A A₁ z)
    change (f (algebraMap A A₁ z) : L₁) = _ at hh
    rw [hh]
    change (Algebra.TensorProduct.includeRight : K₁ →ₐ[K] L₁) (algebraMap A K₁ z) =
      algebraMap B L₁ (algebraMap A B z)
    rw [← IsScalarTower.algebraMap_apply A B L₁, IsScalarTower.algebraMap_apply A K K₁,
      IsScalarTower.algebraMap_apply A K L₁]
    exact (Algebra.TensorProduct.includeRight : K₁ →ₐ[K] L₁).commutes (algebraMap A K z)
  have htB : algebraMap B B₁ (algebraMap A B π) = (f t) ^ p +
      (f t) ^ ((m + 2) * p) * f (-a') := by
    rw [← hfA]
    have hh := congrArg f htp
    simp only [map_add, map_mul, map_pow] at hh
    rw [map_neg]
    linear_combination -hh
  let g : L₁ →ₐ[K] M₁ := Algebra.TensorProduct.map (R := K) (S := K)
    (IsScalarTower.toAlgHom K L M) (AlgHom.id K K₁)
  have hgL (l : L) : g ((Algebra.TensorProduct.includeLeft : L →ₐ[K] L₁) l) =
      (Algebra.TensorProduct.includeLeft : M →ₐ[K] M₁) (algebraMap L M l) :=
    Algebra.TensorProduct.map_tmul _ _ l 1
  have hgK (k : K₁) : g ((Algebra.TensorProduct.includeRight : K₁ →ₐ[K] L₁) k) =
      (Algebra.TensorProduct.includeRight : K₁ →ₐ[K] M₁) k := by
    change (algebraMap L M 1) ⊗ₜ[K] k = (1 : M) ⊗ₜ[K] k
    rw [map_one]
  let : Algebra L₁ M₁ := g.toRingHom.toAlgebra
  let : Algebra B₁ M₁ := ((algebraMap L₁ M₁).comp (algebraMap B₁ L₁)).toAlgebra
  let : IsScalarTower B₁ L₁ M₁ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let : IsScalarTower B L₁ M₁ := IsScalarTower.of_algebraMap_eq fun z => by
    change algebraMap B M₁ z = g ((Algebra.TensorProduct.includeLeft : L →ₐ[K] L₁)
      (algebraMap B L z))
    rw [hgL, ← IsScalarTower.algebraMap_apply B L M]
    rfl
  let : IsScalarTower B B₁ M₁ := IsScalarTower.of_algebraMap_eq fun z => by
    rw [IsScalarTower.algebraMap_apply B L₁ M₁, IsScalarTower.algebraMap_apply B B₁ L₁]
    rfl
  let : CharP B₁ p := (algebraMap B₁ L₁).charP (IsFractionRing.injective B₁ L₁) p
  let : CharP M₁ p := CharP.of_ringHom_of_ne_zero (algebraMap M M₁) p hp.ne_zero
  have hπB : Irreducible (algebraMap A B π) :=
    irreducible_map_of_map_maximalIdeal_eq _ hweak hπ
  have huπ : Irreducible ((u : B) * algebraMap A B π) :=
    (associated_unit_mul_left _ (u : B) u.isUnit).symm.irreducible hπB
  have hxM : (algebraMap C M x) ^ p = algebraMap B M (↑u * algebraMap A B π) := by
    rw [← map_pow, hxp, ← IsScalarTower.algebraMap_apply B C M]
  have hxgen : Algebra.adjoin L {algebraMap C M x} = ⊤ :=
    adjoin_eq_top_of_aeval_eq_zero_of_finrank_eq L M _
      (irreducible_X_pow_sub_C_of_irreducible B L hp _ huπ) (monic_X_pow_sub_C _ hp.ne_zero)
      (by simpa only [natDegree_X_pow_sub_C] using hdegree) _
      (by simp [hxM, ← IsScalarTower.algebraMap_apply B L M])
  let j : M →ₐ[K] M₁ := Algebra.TensorProduct.includeLeft
  have hxgen₁ : Algebra.adjoin L₁ {j (algebraMap C M x)} = ⊤ :=
    adjoin_tensorProduct_eq_top_of_adjoin_eq_top K L M K₁ _ hxgen
  obtain ⟨d, hd⟩ := pow_dvd_sub_expansion B B₁ (algebraMap B B₁)
    (algebraMap A B π) ↑u m (m + 2) c b hu (f t) (f (-a')) htB
  let s : B₁ := ∑ i ∈ Finset.range m, algebraMap B B₁ (c i) * (f t) ^ (i + 1)
  let v : B₁ := algebraMap B B₁ b + (f t) ^ p * d
  have hv : ¬ ∃ z : IsLocalRing.ResidueField B₁, IsLocalRing.residue B₁ v = z ^ p := by
    apply residue_not_pow_of_residueField_algEquiv B B₁ erB p b hb
    rw [hft.maximalIdeal_eq, Ideal.mem_span_singleton]
    exact dvd_mul_of_dvd_left (dvd_pow_self _ hp.ne_zero) _
  have hd' : algebraMap B B₁ (↑u * algebraMap A B π) =
      s ^ p + ((f t) ^ (m + 1)) ^ p * v := by
    rw [hd]
    dsimp only [s, v]
    rw [← pow_mul, show (m + 2) * p = (m + 1) * p + p by ring, pow_add]
    ring
  have hx₁ : (j (algebraMap C M x)) ^ p =
      algebraMap L₁ M₁ (algebraMap B₁ L₁ s) ^ p +
        algebraMap L₁ M₁ (algebraMap B₁ L₁ ((f t) ^ (m + 1))) ^ p *
          algebraMap L₁ M₁ (algebraMap B₁ L₁ v) := by
    rw [← map_pow, hxM]
    change algebraMap B M₁ (↑u * algebraMap A B π) = _
    rw [IsScalarTower.algebraMap_apply B B₁ M₁, hd']
    simp only [map_add, map_mul, map_pow, IsScalarTower.algebraMap_apply B₁ L₁ M₁]
  obtain ⟨y, hyp, hygen⟩ := exists_pow_eq_of_affine_pow_eq L₁ M₁
    (algebraMap B₁ L₁ v) (algebraMap B₁ L₁ s)
    (algebraMap B₁ L₁ ((f t) ^ (m + 1)))
    ((map_ne_zero_iff _ (IsFractionRing.injective B₁ L₁)).mpr (pow_ne_zero _ hft.ne_zero))
    (j (algebraMap C M x)) hx₁ hxgen₁
  have hyp' : y ^ p = algebraMap B₁ M₁ v := by
    rw [hyp, ← IsScalarTower.algebraMap_apply B₁ L₁ M₁]
  have hM₁ : IsField M₁ := isField_of_adjoin_eq_top_of_pow_eq B₁ L₁ M₁ v hv y hyp' hygen
  let : Field M₁ := hM₁.toField
  let D := integralClosure B₁ M₁
  have hD :=
    isDiscreteValuationRing_integralClosure_and_irreducible_of_pow_eq
    (K := L₁) p v hv y hyp' hygen
  let : IsDomain D := inferInstance
  let hDVR : IsDiscreteValuationRing D := hD.1
  let : IsLocalRing D := hDVR.toIsLocalRing
  have hDm : Ideal.map (algebraMap B₁ D) (IsLocalRing.maximalIdeal B₁) =
      IsLocalRing.maximalIdeal D :=
    Stacks.DiscreteValuationRing.AdjoinPthRoot.maximalIdeal_map_eq_of_pow_eq (K := L₁) p v hv y hyp'
      hygen
  let : Algebra.IsIntegral B C := isIntegral_of_finrank_eq_prime B C L M hp hdegree
  obtain ⟨hCval, f', hf', hcomm, hfm'⟩ :=
    exists_isDiscreteValuationRing_integralClosure_of_isIntegral B B₁ C M₁
      (fun z w hh => (IsFractionRing.injective B₁ L₁)
        ((algebraMap L₁ M₁).injective hh)) hDm
  let := hCval
  exact ⟨K₁, hK₁, hKK₁, hAK₁, hAKK₁, hfin, hsep, hdeg, htot, hL₁, hM₁,
    hA₁, hB₁dom, hB₁, inferInstance, hCval, g.toRingHom, f, f', hf, hf',
    hgL, hgK, he, hcomm, hfm, hfm'⟩

end IsDiscreteValuationRing
