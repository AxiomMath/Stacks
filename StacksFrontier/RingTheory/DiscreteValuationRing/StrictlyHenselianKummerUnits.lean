module

public import StacksFrontier.RingTheory.DiscreteValuationRing.StrictlyHenselianIntegralClosure
public import Mathlib.FieldTheory.IsSepClosed
public import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
public import Mathlib.RingTheory.Norm.Basic

/-!
# Kummer theory over a strictly henselian discrete valuation ring

Let `R` be a henselian local ring with separably closed residue field and `m` an integer
invertible in `R`. Every unit of `R` is an `m`-th power and `R` contains a primitive `m`-th root
of unity: the polynomials `X ^ m - u` and `X ^ m - 1` are separable over the residue field, so
they have simple roots there, which lift by Hensel's lemma.

For a strictly henselian discrete valuation ring `B` with uniformizer `ϖ` and fraction field `K`,
and a prime `ℓ` invertible in `B`, this describes the `ℓ`-th power classes of a finite extension
`K'` of `K`: the integral closure of `B` in `K'` is again a strictly henselian discrete valuation
ring (`Stacks.Henselian.isDiscreteValuationRing_strictlyHenselian_integralClosure`), so
`K'ˣ / K'ˣ^ℓ` is generated by a uniformizer of it; if `ϖ` is not an `ℓ`-th power in `K'` then `ϖ`
generates it too. The latter holds when `ℓ` does not divide `[K' : K]`, by taking norms.

## Main results

* `Stacks.StrictlyHenselianKummer.exists_pow_eq_of_isUnit`: units are `m`-th powers.
* `Stacks.StrictlyHenselianKummer.exists_isPrimitiveRoot`: primitive `m`-th roots of unity.
* `Stacks.StrictlyHenselianKummer.not_exists_pow_eq_of_not_dvd_finrank`: a uniformizer is not an
  `ℓ`-th power in an extension of degree prime to `ℓ`.
* `Stacks.StrictlyHenselianKummer.exists_eq_pow_mul_pow`: if the uniformizer is not an `ℓ`-th
  power in `K'`, every nonzero element of `K'` is a power of it times an `ℓ`-th power.

## References

* J.-P. Serre, *Corps locaux*, IV §3.
-/

@[expose] public section

open Polynomial IsLocalRing

namespace Stacks.StrictlyHenselianKummer

section Hensel

variable (R : Type*) [CommRing R] [HenselianLocalRing R] [IsSepClosed (ResidueField R)]

omit [IsSepClosed (ResidueField R)] in
/-- Hensel's lemma for `X ^ m - u`: a root of its reduction which is a unit lifts. -/
theorem exists_pow_eq_of_residue {m : ℕ} (hm : IsUnit (m : R)) (u : R) (b₀ : R)
    (hb₀ : residue R b₀ ^ m = residue R u) (hb₀u : IsUnit b₀) :
    ∃ b : R, b ^ m = u ∧ residue R b = residue R b₀ := by
  have hm0 : m ≠ 0 := by
    rintro rfl
    simp at hm
  obtain ⟨b, hb, hbb₀⟩ := HenselianLocalRing.is_henselian (X ^ m - C u)
    (monic_X_pow_sub_C u hm0) b₀
    (by
      rw [← residue_eq_zero_iff]
      simp [hb₀])
    (by
      simp only [derivative_sub, derivative_X_pow, derivative_C, sub_zero, eval_mul, eval_C,
        eval_pow, eval_X]
      exact hm.mul (hb₀u.pow _))
  refine ⟨b, ?_, ?_⟩
  · have := hb
    simp only [IsRoot, eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at this
    exact this
  · rw [← sub_eq_zero, ← map_sub, residue_eq_zero_iff]
    exact hbb₀

/-- If `m` is invertible in a local ring, it is nonzero in the residue field. -/
private theorem neZero_residue_natCast {S : Type*} [CommRing S] [IsLocalRing S] {m : ℕ}
    (hm : IsUnit (m : S)) : NeZero (m : ResidueField S) :=
  ⟨by simpa using (hm.map (residue S)).ne_zero⟩

/-- If `b₀ ^ m` reduces to a unit, then `b₀` is a unit. -/
private theorem isUnit_of_residue_pow_eq {S : Type*} [CommRing S] [IsLocalRing S] {m : ℕ}
    (hm0 : m ≠ 0) {b₀ u : S} (hb₀ : residue S b₀ ^ m = residue S u) (hu : IsUnit u) :
    IsUnit b₀ := by
  rw [← residue_ne_zero_iff_isUnit] at hu ⊢
  rintro h0
  rw [h0, zero_pow hm0] at hb₀
  exact hu hb₀.symm

/-- **Units of a henselian local ring with separably closed residue field are `m`-th powers**
for every `m` invertible in the ring. -/
theorem exists_pow_eq_of_isUnit {m : ℕ} (hm : IsUnit (m : R)) {u : R} (hu : IsUnit u) :
    ∃ b : R, b ^ m = u := by
  have := neZero_residue_natCast hm
  have : NeZero m := .of_neZero_natCast (ResidueField R)
  obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (residue R u) m
  obtain ⟨b₀, rfl⟩ := residue_surjective z
  exact (exists_pow_eq_of_residue R hm u b₀ hz
    (isUnit_of_residue_pow_eq (NeZero.ne _) hz hu)).imp fun _ h => h.1

/-- **A henselian local ring with separably closed residue field contains a primitive `m`-th root
of unity** for every `m` invertible in it. -/
theorem exists_isPrimitiveRoot {m : ℕ} (hm : IsUnit (m : R)) : ∃ ζ : R, IsPrimitiveRoot ζ m := by
  have := neZero_residue_natCast hm
  have : NeZero m := .of_neZero_natCast (ResidueField R)
  have := IsSepClosed.hasEnoughRootsOfUnity (ResidueField R) m
  obtain ⟨z, hz⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (ResidueField R) m
  obtain ⟨b₀, rfl⟩ := residue_surjective z
  have hb₀ : residue R b₀ ^ m = residue R 1 := by rw [hz.pow_eq_one, map_one]
  obtain ⟨ζ, hζ, hres⟩ := exists_pow_eq_of_residue R hm 1 b₀ hb₀
    (isUnit_of_residue_pow_eq (NeZero.ne _) hb₀ isUnit_one)
  refine ⟨ζ, (IsPrimitiveRoot.iff_def ζ m).2 ⟨hζ, fun l hl => ?_⟩⟩
  exact hz.dvd_of_pow_eq_one l (by rw [← hres, ← map_pow, hl, map_one])

end Hensel

section Field

/-- **Power classes from a uniformizer.** In a field `F`, suppose every nonzero element is, up to
an `ℓ`-th power, a quotient of powers of `ϖ'`, and that `π = ϖ' ^ j₀ * w ^ ℓ` with `ℓ ∤ j₀`. Then
every nonzero element is a power of `π` times an `ℓ`-th power. -/
theorem exists_eq_pow_mul_pow_of_generator {F : Type*} [Field F] {ℓ : ℕ} (hℓ : ℓ.Prime)
    {ϖ' π : F} (hϖ' : ϖ' ≠ 0)
    (h1 : ∀ a : F, a ≠ 0 → ∃ (m n : ℕ) (b : F), a * ϖ' ^ n = ϖ' ^ m * b ^ ℓ)
    {j₀ : ℕ} (hj₀ : ¬ ℓ ∣ j₀) {w : F} (hw : w ≠ 0) (hπ : π = ϖ' ^ j₀ * w ^ ℓ) (a : F)
    (ha : a ≠ 0) : ∃ (i : ℕ) (b : F), a = π ^ i * b ^ ℓ := by
  obtain ⟨c, t, hct⟩ : ∃ c t : ℕ, c * j₀ = ℓ * t + 1 := by
    have hcop : Nat.Coprime j₀ ℓ :=
      Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hj₀)
    obtain ⟨c, -, hc⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hℓ.one_lt
    refine ⟨c, c * j₀ / ℓ, ?_⟩
    have := Nat.div_add_mod (c * j₀) ℓ
    rw [mul_comm j₀ c] at hc
    omega
  set β : F := (ϖ' ^ t * w ^ c)⁻¹ with hβdef
  have hβ : ϖ' = π ^ c * β ^ ℓ := by
    have hpow : π ^ c = ϖ' * (ϖ' ^ t * w ^ c) ^ ℓ := by
      rw [hπ, mul_pow, ← pow_mul, ← pow_mul, mul_comm j₀ c, hct, mul_pow, ← pow_mul, ← pow_mul,
        pow_succ]
      ring
    rw [hpow, hβdef, inv_pow, mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ (mul_ne_zero
      (pow_ne_zero _ hϖ') (pow_ne_zero _ hw))), mul_one]
  obtain ⟨m, n, b, hab⟩ := h1 a ha
  have hℓ1 : 1 ≤ ℓ := hℓ.one_lt.le
  have key : a = ϖ' ^ (m + (ℓ - 1) * n) * (b / ϖ' ^ n) ^ ℓ := by
    have hn : n * ℓ = (ℓ - 1) * n + n := by
      obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
      simp only [Nat.add_sub_cancel]
      ring
    rw [div_pow, ← pow_mul, hn, pow_add, pow_add]
    field_simp
    linear_combination hab
  set N := m + (ℓ - 1) * n
  have hN : ϖ' ^ N = π ^ (c * N) * (β ^ N) ^ ℓ := by
    calc ϖ' ^ N = (π ^ c * β ^ ℓ) ^ N := by rw [← hβ]
      _ = π ^ (c * N) * (β ^ N) ^ ℓ := by ring
  refine ⟨c * N, β ^ N * (b / ϖ' ^ n), ?_⟩
  rw [key, hN]
  ring

end Field

section DVR

variable {B : Type*} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
  {K : Type*} [Field K] [Algebra B K] [IsFractionRing B K]

/-- **A uniformizer is not an `ℓ`-th power in an extension of degree prime to `ℓ`.** Taking norms,
`ϖ ^ [K' : K]` would be an `ℓ`-th power in `K`, which the valuation forbids. -/
theorem not_exists_pow_eq_of_not_dvd_finrank {ϖ : B} (hϖ : Irreducible ϖ) {ℓ : ℕ} (hℓ : ℓ ≠ 0)
    (K' : Type*) [Field K'] [Algebra K K'] [FiniteDimensional K K']
    (hd : ¬ ℓ ∣ Module.finrank K K') :
    ¬ ∃ y : K', y ^ ℓ = algebraMap K K' (algebraMap B K ϖ) := by
  rintro ⟨y, hy⟩
  set d := Module.finrank K K'
  have hN : (Algebra.norm K y) ^ ℓ = (algebraMap B K ϖ) ^ d := by
    rw [← map_pow, hy, Algebra.norm_algebraMap]
  obtain ⟨r, s, hs, hrs⟩ := IsFractionRing.div_surjective (A := B) (Algebra.norm K y)
  have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
  have hsK : algebraMap B K s ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
  have hrsB : r ^ ℓ = ϖ ^ d * s ^ ℓ := by
    apply IsFractionRing.injective B K
    rw [← hrs, div_pow, div_eq_iff (pow_ne_zero _ hsK)] at hN
    simpa [map_pow, map_mul] using hN
  have hr0 : r ≠ 0 := by
    rintro rfl
    rw [zero_pow hℓ] at hrsB
    exact (mul_ne_zero (pow_ne_zero _ hϖ.ne_zero) (pow_ne_zero _ hs0)) hrsB.symm
  obtain ⟨a, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr0 hϖ
  obtain ⟨b, w, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs0 hϖ
  have heq : a * ℓ = b * ℓ + d := by
    refine IsDiscreteValuationRing.unit_mul_pow_congr_pow hϖ hϖ (u ^ ℓ) (w ^ ℓ) _ _ ?_
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
    linear_combination hrsB
  have : ℓ ∣ b * ℓ + d := heq ▸ Dvd.intro_left a rfl
  exact hd ((Nat.dvd_add_right (Dvd.intro_left b rfl)).1 this)

variable [StrictlyHenselianLocalRing B]

/-- **`ℓ`-th power classes of a finite extension of the fraction field of a strictly henselian
discrete valuation ring.** If `ℓ` is a prime invertible in `B` and the uniformizer `ϖ` is not an
`ℓ`-th power in the finite extension `K'`, then every nonzero element of `K'` is a power of `ϖ`
times an `ℓ`-th power. -/
theorem exists_eq_pow_mul_pow {ϖ : B} (hϖ : Irreducible ϖ) {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hℓB : IsUnit (ℓ : B)) (K' : Type*) [Field K'] [Algebra K K'] [FiniteDimensional K K']
    [Algebra B K'] [IsScalarTower B K K']
    (hπ : ¬ ∃ y : K', y ^ ℓ = algebraMap K K' (algebraMap B K ϖ)) (a : K') (ha : a ≠ 0) :
    ∃ (i : ℕ) (b : K'), a = algebraMap K K' (algebraMap B K ϖ) ^ i * b ^ ℓ := by
  obtain ⟨hdvr, hsh, -, hfr⟩ :=
    Stacks.Henselian.isDiscreteValuationRing_strictlyHenselian_integralClosure B K K'
  set C := integralClosure B K'
  obtain ⟨ϖ', hϖ'⟩ := IsDiscreteValuationRing.exists_irreducible C
  have hℓC : IsUnit (ℓ : C) := by simpa using hℓB.map (algebraMap B C)
  set ι := algebraMap C K' with hιdef
  have hι : Function.Injective ι := IsFractionRing.injective C K'
  have hι0 : ∀ {c : C}, c ≠ 0 → ι c ≠ 0 := fun hc => (map_ne_zero_iff ι hι).2 hc
  have hϖ'0 : ι ϖ' ≠ 0 := hι0 hϖ'.ne_zero
  have hunit : ∀ u : Cˣ, ∃ v : C, v ^ ℓ = u := fun u =>
    exists_pow_eq_of_isUnit C hℓC u.isUnit
  have h1 : ∀ x : K', x ≠ 0 → ∃ (m n : ℕ) (b : K'), x * ι ϖ' ^ n = ι ϖ' ^ m * b ^ ℓ := by
    intro x hx
    obtain ⟨r, s, hs, hrs⟩ := IsFractionRing.div_surjective (A := C) x
    have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
    have hsK : ι s ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hs
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_div] at hrs
      exact hx hrs.symm
    obtain ⟨m, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr0 hϖ'
    obtain ⟨n, w, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs0 hϖ'
    obtain ⟨v, hv⟩ := hunit (u * w⁻¹)
    have hv' : ι v ^ ℓ * ι w = ι u := by
      rw [← map_pow, ← map_mul, hv, Units.val_mul, mul_assoc, Units.inv_mul, mul_one]
    have hw0 : ι w ≠ 0 := hι0 w.ne_zero
    refine ⟨m, n, ι v, ?_⟩
    rw [← hrs, map_mul, map_mul, map_pow, map_pow, ← hv']
    field_simp
    exact mul_div_cancel_right₀ _ (pow_ne_zero n hϖ'0)
  -- the uniformizer of `B` in `C`
  have hπC : ι (algebraMap B C ϖ) = algebraMap K K' (algebraMap B K ϖ) := by
    rw [← IsScalarTower.algebraMap_apply B C K', IsScalarTower.algebraMap_apply B K K']
  have hπC0 : algebraMap B C ϖ ≠ 0 := by
    intro h0
    have := hπC
    rw [h0, map_zero, eq_comm] at this
    exact hϖ.ne_zero ((IsFractionRing.injective B K) ((algebraMap K K').injective
      (by rw [this, map_zero, map_zero])))
  obtain ⟨j₀, w₀, hw₀⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hπC0 hϖ'
  obtain ⟨v₀, hv₀⟩ := hunit w₀
  have hπeq : algebraMap K K' (algebraMap B K ϖ) = ι ϖ' ^ j₀ * ι v₀ ^ ℓ := by
    rw [← hπC, hw₀, ← hv₀, map_mul, map_pow, map_pow, mul_comm]
  have hj₀ : ¬ ℓ ∣ j₀ := by
    rintro ⟨k, rfl⟩
    exact hπ ⟨ι ϖ' ^ k * ι v₀, by rw [hπeq]; ring⟩
  have hv₀0 : ι v₀ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hℓ.ne_zero, mul_zero, ← hπC] at hπeq
    exact hπC0 (hι (by rw [hπeq, map_zero]))
  exact exists_eq_pow_mul_pow_of_generator hℓ hϖ'0 h1 hj₀ hv₀0 hπeq a ha

end DVR

end Stacks.StrictlyHenselianKummer

end
