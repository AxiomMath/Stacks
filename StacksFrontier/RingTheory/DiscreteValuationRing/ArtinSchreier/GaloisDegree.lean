/-!
# Artin--Schreier extensions of a discrete valuation field: Galois property and degree

Let `A` be a discrete valuation ring with fraction field `K` of characteristic `p > 0`. An
extension generated by a root `z` of `z ^ p - z = ξ` over `K` is Galois, and it is either
trivial, unramified of degree `p`, totally ramified of ramification index `p`, or weakly
unramified with a purely inseparable residue extension of degree `p`. The valuation of `ξ`
and its leading residue class distinguish the latter three possibilities: an integral `ξ`
gives one of the first two cases, a pole of order prime to `p` gives the totally ramified
case, and a pole whose positive order is divisible by `p` and whose leading coefficient is
not a `p`-th power in the residue field gives the weakly unramified, residually inseparable
case.

This part proves the degree bounds and the Galois property of the extension, and the reduction
of the field-factor case to a surjective tensor-product factor.

## Main results

* `IsDiscreteValuationRing.ramification_cases_of_isGalois_of_finrank_dvd_prime`: the
  prime-degree consequence of the uniform degree formula in a finite Galois extension.

## References

* [Stacks Project, Tag 09F0](https://stacks.math.columbia.edu/tag/09F0)
-/

@[expose] public section

open Polynomial
open nonZeroDivisors
open WithZero

open scoped TensorProduct

attribute [local instance] FractionRing.liftAlgebra
attribute [local instance] Ideal.Quotient.field

universe uA uB uC uK uL uM uK₁

namespace IsDiscreteValuationRing

/-- Let `A` be a discrete valuation ring with fraction field `K` and let `L / K` be a finite
separable extension. The ramification index and the inertia degree of a maximal ideal `m` of
`integralClosure A L` over `A` are both at most `[L : K]`: their product is one summand of the
degree formula `[L : K] = ∑ e f` of Tag 09E8, and both factors are positive. -/
theorem ramificationIdx_and_inertiaDeg_le_finrank
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L]
    (m : Ideal (integralClosure A L)) (hm : m.IsMaximal) :
    m.ramificationIdx A ≤ Module.finrank K L ∧
      m.inertiaDeg A ≤ Module.finrank K L := by
  classical
  let : Module.Finite A (integralClosure A L) :=
    IsIntegralClosure.finite A K L (integralClosure A L)
  let : m.IsPrime := hm.isPrime
  obtain ⟨-, -, -, -, n, ms, hmsmax, hmsiff, -, -, hsum, -, -⟩ :=
    integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia A K L
  obtain ⟨i₀, hi₀, -⟩ := (hmsiff m).mp hm
  have hterm : m.ramificationIdx A * m.inertiaDeg A ≤ Module.finrank K L := by
    rw [hsum, ← hi₀]
    exact Finset.single_le_sum
      (f := fun i => (ms i).ramificationIdx A * (ms i).inertiaDeg A)
      (fun i _ => Nat.zero_le _) (Finset.mem_univ i₀)
  exact ⟨(Nat.le_mul_of_pos_right _ (m.inertiaDeg_pos A)).trans hterm,
    (Nat.le_mul_of_pos_left _ (m.ramificationIdx_pos A)).trans hterm⟩

/-- Prime-degree consequence of the uniform degree formula in Stacks Tag 09EB.
This supplies the cases invoked from Section 09E3 in the proofs of Tags 09F0 and
09F3; it is an untagged helper, not a theorem attributed to the section tag. -/
theorem ramification_cases_of_isGalois_of_finrank_dvd_prime
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Algebra A K] [IsFractionRing A K]
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L]
    (p : ℕ) (hp : p.Prime) (hdegree : Module.finrank K L ∣ p) :
    let B := integralClosure A L
    let mA := IsLocalRing.maximalIdeal A
    let trivial : Prop := Function.Surjective (algebraMap K L)
    let unramified : Prop :=
      Module.finrank K L = p ∧
        ∀ m : Ideal B, m.IsMaximal → ∃ _ : m.LiesOver mA,
          Ideal.ramificationIdx' mA m = 1 ∧
            @Algebra.IsSeparable (A ⧸ mA) (B ⧸ m) _ _
              (Ideal.Quotient.algebraOfLiesOver m mA)
    let totallyRamified : Prop :=
      Stacks.KummerExtension.IsTotallyRamified A K L ∧
        ∀ m : Ideal B, m.IsMaximal → m.LiesOver mA →
          Ideal.ramificationIdx' mA m = p
    let residuallyInseparable : Prop :=
      ∃ hDVR : IsDiscreteValuationRing B,
        letI := hDVR
        let mB := IsLocalRing.maximalIdeal B
        ∃ _ : mB.LiesOver mA,
          Ideal.ramificationIdx' mA mB = 1 ∧
            letI := Ideal.Quotient.algebraOfLiesOver mB mA
            IsPurelyInseparable (A ⧸ mA) (B ⧸ mB) ∧
              Module.finrank (A ⧸ mA) (B ⧸ mB) = p
    trivial ∨ unramified ∨ totallyRamified ∨ residuallyInseparable := by
  classical
  dsimp only
  rcases (Nat.dvd_prime hp).mp hdegree with htriv | hdegree
  · exact Or.inl ((Algebra.finrank_eq_one_iff_bijective_algebraMap).mp htriv).2
  let B := integralClosure A L
  let mA := IsLocalRing.maximalIdeal A
  let : Module.Finite A B := IsIntegralClosure.finite A K L B
  let : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  let : Algebra.IsIntegral A B := IsIntegralClosure.isIntegral_algebra A L
  have hAB : Function.Injective (algebraMap A B) := by
    apply Function.Injective.of_comp (f := algebraMap B L)
    rw [← RingHom.coe_comp, ← IsScalarTower.algebraMap_eq,
      IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  let : Module.IsTorsionFree A B :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hAB
  have hOver (m : Ideal B) (hm : m.IsMaximal) : m.LiesOver mA := by
    let := hm
    exact ⟨((IsLocalRing.isMaximal_iff A).mp
      (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal m)).symm⟩
  obtain ⟨e, f, he, hf, hef, hnef⟩ :=
    exists_uniform_ramificationIdx_inertiaDeg_and_finrank_eq A K L
  change (mA.primesOver B).ncard * e * f = Module.finrank K L at hnef
  rw [hdegree] at hnef
  have hram (m : Ideal B) (hm : m.IsMaximal) : mA.ramificationIdx' m = e := by
    let := hm
    let := hOver m hm
    rw [Ideal.ramificationIdx'_eq_ramificationIdx mA m
      (IsDiscreteValuationRing.not_a_field A)]
    exact (hef ⟨m, hm.isPrime, inferInstance⟩).1
  have hres (m : Ideal B) (hm : m.IsMaximal) :
      letI := hm
      letI := hOver m hm
      letI := Ideal.Quotient.algebraOfLiesOver m mA
      Module.finrank (A ⧸ mA) (B ⧸ m) = f := by
    let := hm
    let := hOver m hm
    rw [← Ideal.inertiaDeg_eq_of_isMaximal mA m]
    exact (hef ⟨m, hm.isPrime, inferInstance⟩).2
  have hunique (hn : (mA.primesOver B).ncard = 1) :
      ∃ m : Ideal B, m.IsMaximal ∧ ∀ m' : Ideal B, m'.IsMaximal → m' = m := by
    obtain ⟨m, hm⟩ := Set.ncard_eq_one.mp hn
    have hmem : m ∈ mA.primesOver B := by rw [hm]; exact Set.mem_singleton m
    refine ⟨m, hmem.1.isMaximal (Ideal.ne_bot_of_mem_primesOver
      (IsDiscreteValuationRing.not_a_field A) hmem), ?_⟩
    intro m' hm'
    have hmem' : m' ∈ mA.primesOver B := ⟨hm'.isPrime, hOver m' hm'⟩
    simpa only [hm, Set.mem_singleton_iff] using hmem'
  have hn : 1 ≤ (mA.primesOver B).ncard := by
    by_contra h
    have hz : (mA.primesOver B).ncard = 0 := by omega
    simp only [hz, zero_mul] at hnef
    exact hp.ne_zero hnef.symm
  have hedvd : e ∣ p := ⟨(mA.primesOver B).ncard * f, by nlinarith [hnef]⟩
  have hfdvd : f ∣ p := ⟨(mA.primesOver B).ncard * e, by nlinarith [hnef]⟩
  rcases (Nat.dvd_prime hp).mp hedvd with rfl | rfl
  · rcases (Nat.dvd_prime hp).mp hfdvd with hf1 | hfp
    · refine Or.inr (Or.inl ⟨hdegree, fun m hm ↦ ?_⟩)
      let := hm
      let := hOver m hm
      let := Ideal.Quotient.algebraOfLiesOver m mA
      refine ⟨inferInstance, hram m hm, ?_⟩
      have hd : Module.finrank (A ⧸ mA) (B ⧸ m) = 1 := (hres m hm).trans hf1
      refine ⟨fun x ↦ ?_⟩
      obtain ⟨a, rfl⟩ := ((Algebra.finrank_eq_one_iff_bijective_algebraMap).mp hd).2 x
      exact isSeparable_algebraMap a
    · have hn1 : (mA.primesOver B).ncard = 1 := by nlinarith [hnef, hp.pos]
      obtain ⟨m, hm, huniq⟩ := hunique hn1
      let : IsLocalRing B := IsLocalRing.of_unique_max_ideal ⟨m, hm, huniq⟩
      have hnotfield : ¬IsField B := fun h ↦
        IsDiscreteValuationRing.not_isField A (isField_of_isIntegral_of_isField hAB h)
      let : IsDiscreteValuationRing B :=
        ((IsDiscreteValuationRing.TFAE B hnotfield).out 3 1).mp
          (show IsDedekindDomain B from inferInstance)
      let mB := IsLocalRing.maximalIdeal B
      let := hOver mB (IsLocalRing.maximalIdeal.isMaximal B)
      let := Ideal.Quotient.algebraOfLiesOver mB mA
      have hd : Module.finrank (A ⧸ mA) (B ⧸ mB) = p :=
        (hres mB (IsLocalRing.maximalIdeal.isMaximal B)).trans hfp
      let : FiniteDimensional (A ⧸ mA) (B ⧸ mB) :=
        Module.finite_of_finrank_pos (hd ▸ hp.pos)
      have hmul := Field.finSepDegree_mul_finInsepDegree (A ⧸ mA) (B ⧸ mB)
      have hsdvd : Field.finSepDegree (A ⧸ mA) (B ⧸ mB) ∣ p :=
        ⟨Field.finInsepDegree (A ⧸ mA) (B ⧸ mB), hmul.trans hd |>.symm⟩
      rcases (Nat.dvd_prime hp).mp hsdvd with hspure | hssep
      · refine Or.inr (Or.inr (Or.inr ⟨inferInstance, inferInstance,
          hram mB (IsLocalRing.maximalIdeal.isMaximal B), ?_, hd⟩))
        exact isPurelyInseparable_of_finSepDegree_eq_one hspure
      · have hs : Algebra.IsSeparable (A ⧸ mA) (B ⧸ mB) :=
          (Field.finSepDegree_eq_finrank_iff _ _).mp (hssep.trans hd.symm)
        refine Or.inr (Or.inl ⟨hdegree, fun m' hm' ↦ ?_⟩)
        have heq : m' = mB := (huniq m' hm').trans
          (huniq mB (IsLocalRing.maximalIdeal.isMaximal B)).symm
        subst m'
        exact ⟨inferInstance, hram mB hm', hs⟩
  · have hnf : (mA.primesOver B).ncard * f = 1 := by
      apply Nat.eq_of_mul_eq_mul_left hp.pos
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm, mul_one] using hnef
    have hn1 : (mA.primesOver B).ncard = 1 := by nlinarith
    have hf1 : f = 1 := by simpa only [hn1, one_mul] using hnf
    obtain ⟨m, hm, huniq⟩ := hunique hn1
    refine Or.inr (Or.inr (Or.inl ⟨?_, fun m' hm' _ ↦ hram m' hm'⟩))
    refine ⟨m, hm, hOver m hm, fun m' hm' _ ↦ huniq m' hm', ?_⟩
    let := hm
    let := hOver m hm
    have hinert : m.inertiaDeg A = 1 := (hef ⟨m, hm.isPrime, inferInstance⟩).2.trans hf1
    rw [Ideal.inertiaDeg_eq_of_isMaximal mA m] at hinert
    simpa using hinert


private theorem finite_artin_schreier
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : p.Prime) [CharP K p] (ξ : K) (z : L)
    (hz : z ^ p - z = algebraMap K L ξ)
    (hgen : Algebra.adjoin K {z} = ⊤) : Module.Finite K L := by
  let : Fact p.Prime := ⟨hp⟩
  let f : K[X] := X ^ p - X - C ξ
  have hmonic : f.Monic := monic_X_pow_sub_X_sub_C
  have hroot : aeval z f = 0 := by
    dsimp [f]
    simp [hz]
  have hint : IsIntegral K z := ⟨f, hmonic, hroot⟩
  have hfg : (Algebra.adjoin K {z}).toSubmodule.FG := hint.fg_adjoin_singleton
  rw [hgen, Algebra.top_toSubmodule] at hfg
  change (⊤ : Submodule K L).FG at hfg
  rw [Module.finite_def]
  exact hfg

private theorem splits_artin_schreier
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : p.Prime) [CharP K p] (ξ : K) (z : L)
    (hz : z ^ p - z = algebraMap K L ξ) :
    ((X ^ p - X - C ξ : K[X]).map (algebraMap K L)).Splits := by
  let : Fact p.Prime := ⟨hp⟩
  let : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
  let : Algebra (ZMod p) L := ZMod.algebra L p
  have hbase : (X ^ p - X : L[X]).Splits := by
    simpa using (GaloisField.splits_zmod_X_pow_sub_X p).map (algebraMap (ZMod p) L)
  have hshift := hbase.comp_X_sub_C z
  have heq : (X ^ p - X - C ξ : K[X]).map (algebraMap K L) =
      (X ^ p - X : L[X]).comp (X - C z) := by
    simp only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
      sub_comp, X_pow_comp, X_comp]
    rw [sub_pow_char]
    have hC := congrArg (C : L →+* L[X]) hz
    simp only [map_sub] at hC
    rw [← map_pow]
    linear_combination hC
  rw [heq]
  exact hshift

private theorem isGalois_artin_schreier
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : p.Prime) [CharP K p] (ξ : K) (z : L)
    (hz : z ^ p - z = algebraMap K L ξ)
    (hgen : Algebra.adjoin K {z} = ⊤) : IsGalois K L := by
  let : Fact p.Prime := ⟨hp⟩
  let f : K[X] := X ^ p - X - C ξ
  have hmonic : f.Monic := monic_X_pow_sub_X_sub_C
  have hroot : aeval z f = 0 := by
    dsimp [f]
    simp [hz]
  have hsep : f.Separable := by
    have hpoly : f = C (1 : K) * X ^ p + C (-1) * X + C (-ξ) := by
      dsimp [f]
      simp
      ring
    rw [hpoly]
    exact separable_C_mul_X_pow_add_C_mul_X_add_C' p p 1 (-1) (-ξ) (dvd_refl p)
      isUnit_neg_one
  have : f.IsSplittingField K L := {
    splits' := by simpa [f] using splits_artin_schreier K L p hp ξ z hz
    adjoin_rootSet' := by
      apply top_unique
      rw [← hgen]
      apply Algebra.adjoin_mono
      exact Set.singleton_subset_iff.mpr (hmonic.mem_rootSet.mpr hroot)
  }
  exact IsGalois.of_separable_splitting_field hsep

private theorem artin_schreier_gal_card_dvd
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : p.Prime) [CharP K p] (ξ : K) (z : L)
    (hz : z ^ p - z = algebraMap K L ξ)
    (hgen : Algebra.adjoin K {z} = ⊤) :
    Nat.card Gal(L/K) ∣ p := by
  let : Fact p.Prime := ⟨hp⟩
  let : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
  have hdelta (σ : Gal(L/K)) : σ z - z ∈ (⊥ : Subfield L) := by
    apply (Subfield.mem_bot_iff_pow_eq_self L p).2
    rw [sub_pow_char]
    have hσ := congrArg σ hz
    simp only [map_sub, map_pow, AlgEquiv.commutes] at hσ
    linear_combination hσ - hz
  let φ : Gal(L/K) →* Multiplicative (⊥ : Subfield L) := {
    toFun σ := Multiplicative.ofAdd ⟨σ z - z, hdelta σ⟩
    map_one' := by
      apply Subtype.ext
      change (1 : Gal(L/K)) z - z = 0
      simp
    map_mul' := by
      intro σ τ
      apply Subtype.ext
      have hfixed : σ (τ z - z) = τ z - z := by
        obtain ⟨n, hn⟩ := (mem_bot_iff_intCast p L).1 (hdelta τ)
        rw [← hn]
        simp
      change (σ * τ) z - z = (σ z - z) + (τ z - z)
      have hmap : σ (τ z) - σ z = τ z - z := by
        simpa only [map_sub] using hfixed
      change σ (τ z) - z = (σ z - z) + (τ z - z)
      linear_combination hmap
  }
  have hinj : Function.Injective φ := by
    intro σ τ h
    apply AlgEquiv.coe_toAlgHom_injective
    apply AlgHom.ext_of_adjoin_eq_top hgen
    have heq := congrArg (fun v : Multiplicative (⊥ : Subfield L) => (v.toAdd : L)) h
    change σ z - z = τ z - z at heq
    have hzz : σ z = τ z := calc
      σ z = (σ z - z) + z := by ring
      _ = (τ z - z) + z := by rw [heq]
      _ = τ z := by ring
    intro x hx
    have hx' : x = z := Set.mem_singleton_iff.mp hx
    subst x
    change σ z = τ z
    exact hzz
  have h := Subgroup.card_dvd_of_injective φ hinj
  rwa [Nat.card_congr (Multiplicative.toAdd : Multiplicative (⊥ : Subfield L) ≃ _),
    Subfield.card_bot L p] at h

private theorem finrank_dvd_artin_schreier
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : p.Prime) [CharP K p] (ξ : K) (z : L)
    (hz : z ^ p - z = algebraMap K L ξ)
    (hgen : Algebra.adjoin K {z} = ⊤) :
    ∃ hfin : Module.Finite K L,
      letI := hfin
      Module.finrank K L ∣ p := by
  let hfin := finite_artin_schreier K L p hp ξ z hz hgen
  let := hfin
  let : IsGalois K L := isGalois_artin_schreier K L p hp ξ z hz hgen
  refine ⟨hfin, ?_⟩
  rw [← IsGalois.card_aut_eq_finrank]
  exact artin_schreier_gal_card_dvd K L p hp ξ z hz hgen

/-- A surjective field factor of a scalar extension of a simple extension is generated by the
image of the same generator. -/
theorem adjoin_eq_top_of_surjective_tensorProduct_factor
    (K : Type uK) (L : Type uL) (E : Type uM) (F : Type uA)
    [CommRing K] [CommRing L] [CommRing E] [CommRing F]
    [Algebra K L] [Algebra K E] [Algebra L F]
    (x : E) (hx : Algebra.adjoin K {x} = ⊤)
    (f : (L ⊗[K] E) →ₐ[L] F) (hf : Function.Surjective f) :
    Algebra.adjoin L {f (1 ⊗ₜ[K] x)} = ⊤ := by
  have h := Algebra.TensorProduct.adjoin_one_tmul_image_eq_top (A := L) {x} hx
  have heq := Algebra.adjoin_image L f ((fun y : E ↦ (1 : L) ⊗ₜ[K] y) '' {x})
  rw [h, Algebra.map_top, f.range_eq_top.mpr hf] at heq
  simpa only [Set.image_singleton] using heq

/-- A field factor of a scalar-extended Artin--Schreier extension is either trivial or is again
an Artin--Schreier extension of the same prime degree.

The tensor factor is supplied by a surjective algebra map.  Its transported root still satisfies
the Artin--Schreier equation and generates the factor.  In the degree-one branch the structure map
is surjective, while in the degree-`p` branch the factor is Galois.  This is the field package
needed after Tag 09ER has transported the lower weak extension across a totally ramified base
change: the first branch is already trivial, and the second is ready for the degree-`p` finite
support argument. -/
theorem artinSchreierFactorPackage_of_surjective_tensorProduct
    (L : Type uL) (M : Type uM) (E : Type uK) (F : Type uA)
    [Field L] [Field M] [Field E] [Field F]
    [Algebra L M] [Algebra L E] [Algebra E F]
    (p : ℕ) (hp : p.Prime) [CharP L p]
    (ξ : L) (z : M)
    (hz : z ^ p - z = algebraMap L M ξ)
    (hgen : Algebra.adjoin L {z} = ⊤)
    (q : (E ⊗[L] M) →ₐ[E] F) (hq : Function.Surjective q) :
    let zF := q (1 ⊗ₜ[L] z)
    zF ^ p - zF = algebraMap E F (algebraMap L E ξ) ∧
      Algebra.adjoin E {zF} = ⊤ ∧
      ∃ hfin : Module.Finite E F,
        letI := hfin
        (Module.finrank E F = 1 ∧ Function.Surjective (algebraMap E F)) ∨
          (Module.finrank E F = p ∧ IsGalois E F) := by
  let zF := q (1 ⊗ₜ[L] z)
  have hchar : CharP E p :=
    charP_of_injective_algebraMap (algebraMap L E).injective p
  let : CharP E p := hchar
  have hzTensor : (1 ⊗ₜ[L] z : E ⊗[L] M) ^ p - 1 ⊗ₜ[L] z =
      algebraMap E (E ⊗[L] M) (algebraMap L E ξ) := by
    calc
      (1 ⊗ₜ[L] z : E ⊗[L] M) ^ p - 1 ⊗ₜ[L] z =
          1 ⊗ₜ[L] (z ^ p - z) := by
            rw [Algebra.TensorProduct.tmul_pow, one_pow, TensorProduct.tmul_sub]
      _ = 1 ⊗ₜ[L] algebraMap L M ξ := by rw [hz]
      _ = algebraMap E (E ⊗[L] M) (algebraMap L E ξ) := by
        rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul ξ]
        rfl
  have hzF : zF ^ p - zF = algebraMap E F (algebraMap L E ξ) := by
    simpa only [zF, map_sub, map_pow, AlgHom.commutes] using congrArg q hzTensor
  have hgenF : Algebra.adjoin E {zF} = ⊤ :=
    adjoin_eq_top_of_surjective_tensorProduct_factor L E M F z hgen q hq
  obtain ⟨hfin, hdegree⟩ := finrank_dvd_artin_schreier E F p hp
    (algebraMap L E ξ) zF hzF hgenF
  let := hfin
  refine ⟨hzF, hgenF, hfin, ?_⟩
  rcases (Nat.dvd_prime hp).mp hdegree with hdegree | hdegree
  · exact Or.inl ⟨hdegree,
      (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hdegree).2⟩
  · exact Or.inr ⟨hdegree,
      isGalois_artin_schreier E F p hp (algebraMap L E ξ) zF hzF hgenF⟩
/-- A field generated by one Artin--Schreier root in prime characteristic is either the base
field or has degree exactly `p`.

This is the field-factor dichotomy needed after a cyclic degree-`p` extension is base changed:
once a field factor is shown to be generated by the image of the original Artin--Schreier
generator, no intermediate degree can occur. -/
theorem finrank_eq_one_or_prime_of_adjoin_root_artinSchreier
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (p : ℕ) (hp : p.Prime) [CharP K p] (ξ : K) (z : L)
    (hz : z ^ p - z = algebraMap K L ξ)
    (hgen : Algebra.adjoin K {z} = ⊤) :
    ∃ hfin : Module.Finite K L,
      letI := hfin
      Module.finrank K L = 1 ∨ Module.finrank K L = p := by
  obtain ⟨hfin, hdegree⟩ := finrank_dvd_artin_schreier K L p hp ξ z hz hgen
  exact ⟨hfin, (Nat.dvd_prime hp).mp hdegree⟩

end IsDiscreteValuationRing
