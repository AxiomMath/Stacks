open Polynomial

/-! ### The presentation of a purely inseparable extension of prime degree of a DVR -/

open Stacks.DiscreteValuationRing.Ramification

/-- A finite field extension of prime degree is generated by any element not in the base field:
the lattice of intermediate fields of a prime-degree extension has only `⊥` and `⊤`. -/
private theorem adjoin_eq_top_of_finrank_prime
    (k E : Type*) [Field k] [Field E] [Algebra k E]
    {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank k E = p)
    (y : E) (hy : y ∉ Set.range (algebraMap k E)) :
    Algebra.adjoin k {y} = ⊤ := by
  have : FiniteDimensional k E :=
    Module.finite_of_finrank_pos (by rw [hdegree]; exact hp.pos)
  have := IntermediateField.isSimpleOrder_of_finrank_prime k E (by rw [hdegree]; exact hp)
  have hal : IsAlgebraic k y := Algebra.IsAlgebraic.isAlgebraic y
  rcases IsSimpleOrder.eq_bot_or_eq_top (IntermediateField.adjoin k {y}) with hbot | htop
  · exact absurd (IntermediateField.mem_bot.mp
      (hbot ▸ IntermediateField.mem_adjoin_simple_self k y)) hy
  · exact (IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hal).mp htop

/-- A `p`-th root in the fraction field of an element of an integrally closed domain lies in the
domain. -/
private theorem exists_pow_eq_of_pow_eq_algebraMap
    (A K : Type*) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [Field K] [Algebra A K] [IsFractionRing A K]
    {p : ℕ} (hp : 0 < p) (a : A) (c : K) (hc : c ^ p = algebraMap A K a) :
    ∃ b : A, b ^ p = a := by
  have hai : IsIntegral A (c ^ p) := by rw [hc]; exact isIntegral_algebraMap
  obtain ⟨b, hb⟩ := IsIntegrallyClosed.exists_algebraMap_eq_of_isIntegral_pow hp hai
  exact ⟨b, IsFractionRing.injective A K (by rw [map_pow, hb, hc])⟩

/-- A `p`-th root `x` of `a ∈ A` in a degree-`p` extension `L / K`, with `a` not a `p`-th power in
`K`, presents `L` as `K[T] ⧸ (Tᵖ - a)` with the canonical root going to `x`. -/
private theorem exists_algEquiv_adjoinRoot_of_pow_eq
    (A K L : Type*) [CommRing A] [Field K] [Field L] [Algebra A K] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [FiniteDimensional K L] {p : ℕ} (hp : p.Prime)
    (hdegree : Module.finrank K L = p) {x : L} {a : A} (hxp : x ^ p = algebraMap A L a)
    (hnp : ∀ c : K, c ^ p ≠ algebraMap A K a) :
    ∃ e : AdjoinRoot (X ^ p - C (algebraMap A K a)) ≃ₐ[K] L,
      e (AdjoinRoot.root (X ^ p - C (algebraMap A K a))) = x :=
  exists_algEquiv_adjoinRoot_of_finrank_eq K L (X ^ p - C (algebraMap A K a))
    (X_pow_sub_C_irreducible_of_prime hp hnp) (monic_X_pow_sub_C _ hp.ne_zero)
    (by rw [hdegree, natDegree_X_pow_sub_C]) x
    (by simp only [map_sub, map_pow, aeval_X, aeval_C, hxp, IsScalarTower.algebraMap_apply A K L,
      sub_self])

/-- **Nakayama for a monogenic subalgebra.**  Let `A → B` be a module-finite local homomorphism
of local rings carrying the maximal ideal of `A` onto the maximal ideal of `B`.  If the residue
of `x : B` generates the residue field of `B` over that of `A`, then `x` generates `B` as an
`A`-algebra: `A[x]` together with `𝔪_A B = 𝔪_B` exhausts `B`, and `B` is finite over the local
ring `A`. -/
@[sga "1 I 7.9" "special case"]
private theorem adjoin_eq_top_of_residue_adjoin_eq_top
    (A B : Type*) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
    [Algebra A B] [IsLocalHom (algebraMap A B)] [Module.Finite A B]
    (hweak : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
      IsLocalRing.maximalIdeal B)
    (x : B)
    (hgen : Algebra.adjoin (IsLocalRing.ResidueField A) {IsLocalRing.residue B x} = ⊤) :
    Algebra.adjoin A {x} = ⊤ := by
  have hsmul : (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A B) =
      Submodule.restrictScalars A (IsLocalRing.maximalIdeal B) := by
    rw [Ideal.smul_top_eq_map, hweak]
  have hcomm : (IsLocalRing.residue B).comp (algebraMap A B) =
      (algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)).comp
        (IsLocalRing.residue A) := by
    ext a
    exact (IsLocalRing.ResidueField.algebraMap_residue (S := B) a).symm
  have hkey : (⊤ : Submodule A B) ≤
      (Algebra.adjoin A {x}).toSubmodule ⊔
        (IsLocalRing.maximalIdeal A) • (⊤ : Submodule A B) := by
    intro b _
    have hb : IsLocalRing.residue B b ∈
        Algebra.adjoin (IsLocalRing.ResidueField A) {IsLocalRing.residue B x} := by
      rw [hgen]; exact Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨q, hq⟩ := hb
    have hq' : Polynomial.aeval (IsLocalRing.residue B x) q = IsLocalRing.residue B b := hq
    obtain ⟨Q, hQ⟩ := Polynomial.map_surjective (IsLocalRing.residue A)
      Ideal.Quotient.mk_surjective q
    have hresQ : IsLocalRing.residue B (Polynomial.aeval x Q) =
        Polynomial.aeval (IsLocalRing.residue B x) q := by
      rw [← hQ, Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map,
        Polynomial.hom_eval₂, hcomm]
    have hmem : b - Polynomial.aeval x Q ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hresQ, hq', sub_self]
    refine Submodule.mem_sup.mpr ⟨Polynomial.aeval x Q, ?_, b - Polynomial.aeval x Q, ?_, ?_⟩
    · rw [Subalgebra.mem_toSubmodule, Algebra.adjoin_singleton_eq_range_aeval]
      exact ⟨Q, rfl⟩
    · rw [hsmul]; exact hmem
    · ring
  have hle := Submodule.le_of_le_smul_of_le_jacobson_bot
    (Module.finite_def.mp (inferInstance : Module.Finite A B))
    (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top).ge hkey
  have htop : (Algebra.adjoin A {x}).toSubmodule = ⊤ := top_le_iff.mp hle
  rw [Algebra.eq_top_iff]
  intro b
  rw [← Subalgebra.mem_toSubmodule, htop]
  exact Submodule.mem_top

/-- **The second paragraph of the proof of [Stacks, Tag 0AX6].**  Let `A ⊆ B` be discrete
valuation rings with `B` module-finite over `A`, inducing a purely inseparable extension `L / K`
of fraction fields of prime degree `p`.  Then `B = A[x]` for an element `x` whose `p`-th power is
an element `a` of `A` which is not a `p`-th power in `K`.

The source's two cases are the two values the ramification index can take, since `e · f = p` is
prime: if `e = p` then a uniformizer of `B` is a `p`-th root of a uniformizer of `A`, and if
`e = 1` then the residue field extension has degree `p` and any lift of a residue class outside
`κ_A` is a `p`-th root of a unit. -/
theorem exists_pow_eq_algebraMap_and_adjoin_eq_top_of_isPurelyInseparable
    (A B K L : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Algebra A B] [FaithfulSMul A B] [IsLocalHom (algebraMap A B)] [Module.Finite A B]
    [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L]
    [Algebra A L] [Algebra K L] [IsScalarTower A B L] [IsScalarTower A K L]
    [IsPurelyInseparable K L] {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank K L = p) :
    ∃ (x : B) (a : A), x ^ p = algebraMap A B a ∧ Algebra.adjoin A {x} = ⊤ ∧
      ∀ c : K, c ^ p ≠ algebraMap A K a := by
  have : FiniteDimensional K L :=
    Module.finite_of_finrank_pos (by rw [hdegree]; exact hp.pos)
  have htf : Module.IsTorsionFree A B := by
    rw [Module.isTorsionFree_iff_algebraMap_injective]
    exact FaithfulSMul.algebraMap_injective A B
  have : Module.Free A B := Module.free_of_finite_type_torsion_free'
  have : Module.Flat A B := Module.Flat.of_free
  have : Algebra.IsIntegral A B := isIntegral_of_finrank_eq_prime A B K L hp hdegree
  have hef := ramificationIdx_mul_inertiaDeg_eq_finrank A B K L
  rw [hdegree] at hef
  obtain ⟨πA, hπA⟩ := IsDiscreteValuationRing.exists_irreducible A
  rcases hp.eq_one_or_self_of_dvd _ ⟨_, hef.symm⟩ with he | he
  · -- `e = 1`: weakly unramified, so the whole degree sits in the residue field.
    have hweak : Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
        IsLocalRing.maximalIdeal B := by
      rw [map_maximalIdeal_eq_maximalIdeal_pow_ramificationIdx A B, he, pow_one]
    have hres : Module.finrank (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) = p := by
      rw [← inertiaDeg_eq_finrank_residueField A B, ← hef, he, one_mul]
    have hnotsurj : ¬ ∀ y : IsLocalRing.ResidueField B,
        y ∈ Set.range (algebraMap (IsLocalRing.ResidueField A)
          (IsLocalRing.ResidueField B)) := by
      intro hsurj
      have hbij : Function.Bijective
          (algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)) :=
        ⟨(algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B)).injective,
          fun y => hsurj y⟩
      have h1 : Module.finrank (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField B) = 1 :=
        Algebra.finrank_eq_one_iff_bijective_algebraMap.mpr hbij
      rw [hres] at h1
      exact hp.ne_one h1
    obtain ⟨y, hy⟩ := not_forall.mp hnotsurj
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, ha⟩ := pow_eq_algebraMap_of_finrank_eq_prime A B K L hp hdegree x
    have hcK : CharP K p := charP_of_finrank_eq_prime K L hp hdegree
    have hcA : CharP A p := (algebraMap A K).charP (IsFractionRing.injective A K) p
    have hcB : CharP B p := charP_of_injective_algebraMap
      (FaithfulSMul.algebraMap_injective A B) p
    have : ExpChar B p := .prime hp
    refine ⟨x, a, ha.symm, ?_, ?_⟩
    · refine adjoin_eq_top_of_residue_adjoin_eq_top A B hweak x ?_
      exact adjoin_eq_top_of_finrank_prime _ _ hp hres _ (hx ▸ hy)
    · intro c hc
      obtain ⟨b, hb⟩ := exists_pow_eq_of_pow_eq_algebraMap A K hp.pos a c hc
      have hzero : (x - algebraMap A B b) ^ p = 0 := by
        rw [sub_pow_expChar, ← map_pow, hb, ← ha, sub_self]
      have hxb : x = algebraMap A B b := by
        have h0 := pow_eq_zero_iff hp.ne_zero |>.mp hzero
        linear_combination h0
      refine hy ⟨IsLocalRing.residue A b, ?_⟩
      rw [IsLocalRing.ResidueField.algebraMap_residue (S := B) b, ← hxb, ← hx]
      rfl
  · -- `e = p`: totally ramified, and a uniformizer of `B` is a `p`-th root of one of `A`.
    obtain ⟨πB, hπB⟩ := IsDiscreteValuationRing.exists_irreducible B
    obtain ⟨a, ha⟩ := pow_eq_algebraMap_of_finrank_eq_prime A B K L hp hdegree πB
    have ha0 : a ≠ 0 := by
      intro h
      rw [h, map_zero] at ha
      exact hπB.ne_zero (pow_eq_zero_iff hp.ne_zero |>.mp ha.symm)
    obtain ⟨k, u, hk⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hπA
    have hvalA := addVal_algebraMap_eq_ramificationIdx A B πA hπA
    rw [he] at hvalA
    obtain ⟨w, hw⟩ := (u.isUnit).map (algebraMap A B)
    have hval : IsDiscreteValuationRing.addVal B (algebraMap A B a) = ((k * p : ℕ) : ℕ∞) := by
      rw [hk, map_mul, map_pow, IsDiscreteValuationRing.addVal_mul,
        IsDiscreteValuationRing.addVal_pow, ← hw,
        IsDiscreteValuationRing.addVal_eq_zero_of_unit, hvalA]
      push_cast
      simp [nsmul_eq_mul]
    have hval2 : IsDiscreteValuationRing.addVal B (algebraMap A B a) = ((p : ℕ) : ℕ∞) := by
      rw [ha, IsDiscreteValuationRing.addVal_pow,
        IsDiscreteValuationRing.addVal_uniformizer hπB, nsmul_eq_mul, mul_one]
    have hk1 : k = 1 := by
      rw [hval2] at hval
      have hkp : k * p = p := by exact_mod_cast hval.symm
      exact Nat.eq_of_mul_eq_mul_right hp.pos (by rw [one_mul]; exact hkp)
    have hair : Irreducible a := by
      rw [hk, hk1, pow_one]
      exact (associated_unit_mul_left πA (u : A) u.isUnit).symm.irreducible hπA
    refine ⟨πB, a, ha.symm,
      adjoin_eq_top_of_pow_eq_uniformizer A B K L hp hdegree a hair πB ha.symm, ?_⟩
    intro c hc
    obtain ⟨b, hb⟩ := exists_pow_eq_of_pow_eq_algebraMap A K hp.pos a c hc
    exact not_irreducible_pow hp.ne_one (hb ▸ hair)

/-- **The presentation of the fraction field in the situation of [Stacks, Tag 0AX6].**  With the
hypotheses of `exists_pow_eq_algebraMap_and_adjoin_eq_top_of_isPurelyInseparable`, the generator
`x` of `B` over `A` presents `L` as `K[T] ⧸ (Tᵖ - a)` with `a ∈ A`, by an isomorphism carrying the
canonical root to `x`.

This is the form in which the trace map of [Stacks, Tag 0AX5] consumes the extension, with the
element whose `p`-th root is adjoined coming from `A` rather than merely from `K`. -/
theorem exists_algEquiv_adjoinRoot_of_isPurelyInseparable
    (A B K L : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Algebra A B] [FaithfulSMul A B] [IsLocalHom (algebraMap A B)] [Module.Finite A B]
    [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsFractionRing B L]
    [Algebra A L] [Algebra K L] [IsScalarTower A B L] [IsScalarTower A K L]
    [IsPurelyInseparable K L] {p : ℕ} (hp : p.Prime) (hdegree : Module.finrank K L = p) :
    ∃ (x : B) (a : A) (e : AdjoinRoot (X ^ p - C (algebraMap A K a)) ≃ₐ[K] L),
      x ^ p = algebraMap A B a ∧ Algebra.adjoin A {x} = ⊤ ∧
        e (AdjoinRoot.root (X ^ p - C (algebraMap A K a))) = algebraMap B L x := by
  have : FiniteDimensional K L :=
    Module.finite_of_finrank_pos (by rw [hdegree]; exact hp.pos)
  obtain ⟨x, a, hxp, hgen, hnp⟩ :=
    exists_pow_eq_algebraMap_and_adjoin_eq_top_of_isPurelyInseparable A B K L hp hdegree
  have hxpL : (algebraMap B L x) ^ p = algebraMap A L a := by
    rw [← map_pow, hxp, ← IsScalarTower.algebraMap_apply A B L]
  obtain ⟨e, he⟩ := exists_algEquiv_adjoinRoot_of_pow_eq A K L hp hdegree hxpL hnp
  exact ⟨x, a, e, hxp, hgen, he⟩

/-! ### A module-finite subalgebra of a purely inseparable extension of prime degree

`IsDiscreteValuationRing.exists_algEquiv_adjoinRoot_of_isPurelyInseparable` presents a discrete
valuation ring `B` module-finite over `A` as `A[x]` with `x ^ p` in `A`.  A consumer which only
knows that `B` is module-finite over `A` — not that it is normal, hence not that it is a discrete
valuation ring — cannot use it, and the integral closure of `A` in `L` is no substitute: it need
not be module-finite over `A`, so it need not be monogenic either.

What survives, and is all that the trace computation of [Stacks, Tag 0AX5] needs, is that every
module-finite `A`-subalgebra of `L` is *contained* in one of the form `A[x]`.  The proof splits on
how well the `p`-th power `c` of a generator `z` of `L` is approximated by `p`-th powers of `A`.
If `c - bᵖ` is divisible by arbitrarily high powers of a uniformizer `π`, then
`x = (z - b) / π ^ M` for a large `M` works, and the containment comes from the Frobenius: the
difference between an element of the subalgebra and its `A[x]`-part lies in `K` and has its `p`-th
power in `A`, hence lies in `A`.  If the approximation stops at order `n`, then the integral
closure of `A` in `L` is itself `A[x]` — totally ramified over `A` when `p` does not divide `n`,
with inseparable residue extension when it does — and it contains the subalgebra.
-/

/-- A power of a uniformizer clears the denominator of an element of the fraction field. -/
private theorem exists_pow_mul_mem_range (A K : Type*) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [Field K] [Algebra A K] [IsFractionRing A K]
    {π : A} (hπ : Irreducible π) (γ : K) :
    ∃ m : ℕ, algebraMap A K (π ^ m) * γ ∈ (algebraMap A K).range := by
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors A) γ
  obtain ⟨m, u, hm⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible (nonZeroDivisors.coe_ne_zero b) hπ
  refine ⟨m, a * ↑u⁻¹, ?_⟩
  have hu : algebraMap A K ((u : A)) * algebraMap A K ((↑u⁻¹ : A)) = 1 := by
    rw [← map_mul, Units.mul_inv, map_one]
  have key : γ * (algebraMap A K ((u : A)) * algebraMap A K (π ^ m)) = algebraMap A K a := by
    rw [← map_mul, ← hm]; exact hab
  have hgoal : algebraMap A K (π ^ m) * γ *
        (algebraMap A K ((u : A)) * algebraMap A K ((↑u⁻¹ : A))) =
      algebraMap A K a * algebraMap A K ((↑u⁻¹ : A)) := by
    rw [← key]; ring
  rw [map_mul, ← hgoal, hu, mul_one]

/-- A power of a uniformizer of `A` is nonzero in any field `L` over the fraction field of `A`. -/
private theorem algebraMap_pow_ne_zero (A K L : Type*) [CommRing A] [IsDomain A] [Field K]
    [Field L] [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] {π : A} (hπ : Irreducible π) (n : ℕ) : algebraMap A L (π ^ n) ≠ 0 := by
  rw [IsScalarTower.algebraMap_apply A K L]
  exact (map_ne_zero_iff _ (algebraMap K L).injective).mpr
    ((map_ne_zero_iff _ (IsFractionRing.injective A K)).mpr (pow_ne_zero n hπ.ne_zero))

/-- Dividing `w` by `πᵏ` divides its `p`-th power `πᵖᵏ d` by `πᵖᵏ`. -/
private theorem pow_mul_inv_pow_eq_algebraMap (A K L : Type*) [CommRing A] [IsDomain A]
    [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] {p : ℕ} {π : A} (hπ : Irreducible π) {w : L} {k : ℕ} {d : A}
    (hw : w ^ p = algebraMap A L (π ^ (p * k) * d)) :
    (w * (algebraMap A L (π ^ k))⁻¹) ^ p = algebraMap A L d := by
  rw [mul_pow, hw, inv_pow, ← map_pow, ← pow_mul, Nat.mul_comm k p, map_mul, mul_comm,
    ← mul_assoc, inv_mul_cancel₀ (algebraMap_pow_ne_zero A K L hπ _), one_mul]

/-- Multiplying by `πᴺ` moves the coefficient `γ` of `πᵐ γ ∈ A` to `πᴺ⁻ᵐ a`. -/
private theorem algebraMap_pow_mul_eq_of_le (A K : Type*) [CommRing A] [Field K] [Algebra A K]
    {π : A} {γ : K} {a : A} {m N : ℕ} (ha : algebraMap A K a = algebraMap A K (π ^ m) * γ)
    (h : m ≤ N) : algebraMap A K (π ^ N) * γ = algebraMap A K (π ^ (N - m) * a) := by
  rw [map_mul, ha, ← mul_assoc, ← map_mul, ← pow_add, Nat.sub_add_cancel h]

/-- The `p`-th power of an element of `A[x]` lies in `A` as soon as the `p`-th power of `x` does:
in characteristic `p` the elements with `p`-th power in `A` form a subalgebra. -/
private theorem pow_mem_range_of_mem_adjoin (A L : Type*) [CommRing A] [CommRing L]
    [Algebra A L] {p : ℕ} (hp : p.Prime) [CharP L p] {x : L} {a : A}
    (hx : x ^ p = algebraMap A L a) {ξ : L} (hξ : ξ ∈ Algebra.adjoin A ({x} : Set L)) :
    ξ ^ p ∈ (algebraMap A L).range := by
  have : Fact p.Prime := ⟨hp⟩
  let S : Subalgebra A L :=
    { carrier := {w : L | w ^ p ∈ (algebraMap A L).range}
      mul_mem' := fun {w v} hw hv => by
        obtain ⟨cw, hcw⟩ := hw
        obtain ⟨cv, hcv⟩ := hv
        exact ⟨cw * cv, by rw [map_mul, hcw, hcv, mul_pow]⟩
      one_mem' := ⟨1, by rw [map_one, one_pow]⟩
      add_mem' := fun {w v} hw hv => by
        obtain ⟨cw, hcw⟩ := hw
        obtain ⟨cv, hcv⟩ := hv
        exact ⟨cw + cv, by rw [map_add, hcw, hcv, add_pow_char]⟩
      zero_mem' := ⟨0, by rw [map_zero, zero_pow hp.ne_zero]⟩
      algebraMap_mem' := fun r => ⟨r ^ p, by rw [map_pow]⟩ }
  exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr (show x ∈ S from ⟨a, hx.symm⟩)) hξ

/-- An element of `L` integral over `A` has its `p`-th power in `A`: the `p`-th power lies in `K`
because `L / K` is purely inseparable of degree `p`, and `A` is integrally closed. -/
private theorem pow_mem_range_of_isIntegral (A K L : Type*) [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] [Field K] [Field L] [Algebra A K] [IsFractionRing A K]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L]
    [IsPurelyInseparable K L] {p : ℕ} (hp : p.Prime) [CharP K p]
    (hdegree : Module.finrank K L = p) {y : L} (hy : IsIntegral A y) :
    y ^ p ∈ (algebraMap A L).range := by
  obtain ⟨γ, hγ⟩ := pow_mem_range_of_finrank_eq_prime K L hp hdegree y
  have hint : IsIntegral A γ := by
    refine (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L)
      (algebraMap K L).injective).mp ?_
    change IsIntegral A (algebraMap K L γ)
    rw [hγ]
    exact hy.pow p
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  exact ⟨a, by rw [IsScalarTower.algebraMap_apply A K L, ha, hγ]⟩

/-- A `p`-th root of `a` in `L` which does not lie in `K` witnesses that `a` is not a `p`-th power
in `K`, so that `Xᵖ - a` is irreducible over `K`. -/
private theorem forall_pow_ne_of_notMem_range (A K L : Type*) [CommRing A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L] {p : ℕ} (hp : p.Prime)
    [CharP L p] {x : L} {a : A} (hxp : x ^ p = algebraMap A L a)
    (hxK : x ∉ Set.range (algebraMap K L)) : ∀ κ : K, κ ^ p ≠ algebraMap A K a := by
  have : Fact p.Prime := ⟨hp⟩
  intro κ hκ
  refine hxK ⟨κ, ?_⟩
  have h0 : (x - algebraMap K L κ) ^ p = 0 := by
    rw [sub_pow_char, hxp, ← map_pow, hκ, ← IsScalarTower.algebraMap_apply A K L, sub_self]
  exact (sub_eq_zero.mp ((pow_eq_zero_iff hp.ne_zero).mp h0)).symm

/-- A power of a uniformizer carries a finitely generated `A`-submodule of `L` into the
`A`-span of the first `p` powers of a generator `z` of `L` over `K`. -/
private theorem exists_pow_mul_mem_span (A K L : Type*) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [Field K] [Field L] [Algebra A K] [IsFractionRing A K]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] {p : ℕ} (hp : p.Prime) {π : A}
    (hπ : Irreducible π) {z : L} {c₀ : K} (hz : z ^ p = algebraMap K L c₀)
    (hgen : Algebra.adjoin K ({z} : Set L) = ⊤) (N : Submodule A L) (hN : N.FG) :
    ∃ M : ℕ, ∀ y ∈ N, algebraMap A L (π ^ M) * y ∈
      Submodule.span A (Set.range fun i : Fin p => z ^ (i : ℕ)) := by
  classical
  set C : Submodule A L := Submodule.span A (Set.range fun i : Fin p => z ^ (i : ℕ)) with hC
  have hmono : ∀ M M' : ℕ, M ≤ M' → ∀ w : L, algebraMap A L (π ^ M) * w ∈ C →
      algebraMap A L (π ^ M') * w ∈ C := by
    intro M M' hMM' w hw
    have hsplit : algebraMap A L (π ^ M') * w =
        (π ^ (M' - M)) • (algebraMap A L (π ^ M) * w) := by
      have hadd : M' - M + M = M' := by omega
      rw [Algebra.smul_def, ← mul_assoc, ← map_mul, ← pow_add, hadd]
    rw [hsplit]
    exact Submodule.smul_mem _ _ hw
  have hpoint : ∀ y : L, ∃ m : ℕ, algebraMap A L (π ^ m) * y ∈ C := by
    intro y
    have hspan : Submodule.span K (Set.range fun i : Fin p => z ^ (i : ℕ)) = ⊤ :=
      Algebra.span_range_pow_eq_top_of_adjoin_singleton_eq_top hp.pos hz hgen
    obtain ⟨γ, hγ⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp
      (hspan ▸ (Submodule.mem_top : y ∈ (⊤ : Submodule K L)))
    choose m hm using fun i : Fin p => exists_pow_mul_mem_range A K hπ (γ i)
    refine ⟨Finset.univ.sup m, ?_⟩
    rw [← hγ, Finset.mul_sum]
    refine Submodule.sum_mem _ fun i _ => ?_
    obtain ⟨a, ha⟩ := hm i
    have hcoef := algebraMap_pow_mul_eq_of_le _ _ ha (Finset.le_sup (Finset.mem_univ i))
    have heq : algebraMap A L (π ^ Finset.univ.sup m) * (γ i • z ^ (i : ℕ)) =
        (π ^ (Finset.univ.sup m - m i) * a) • z ^ (i : ℕ) := by
      rw [Algebra.smul_def, Algebra.smul_def, IsScalarTower.algebraMap_apply A K L,
        IsScalarTower.algebraMap_apply A K L, ← mul_assoc, ← map_mul, hcoef]
    rw [heq]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  obtain ⟨S, hS⟩ := hN
  choose mm hmm using hpoint
  refine ⟨S.sup mm, fun y hy => ?_⟩
  have hsub : (↑S : Set L) ⊆
      (C.comap (LinearMap.mulLeft A (algebraMap A L (π ^ S.sup mm))) : Set L) := by
    intro w hw
    exact hmono (mm w) (S.sup mm) (Finset.le_sup hw) w (hmm w)
  have hNle : N ≤ C.comap (LinearMap.mulLeft A (algebraMap A L (π ^ S.sup mm))) := by
    rw [← hS]
    exact Submodule.span_le.mpr hsub
  exact hNle hy

/-- **The approximable case.**  If `c - bᵖ` is divisible by arbitrarily high powers of the
uniformizer `π`, for `c` the `p`-th power of a generator `z` of `L` over `K`, then every
module-finite `A`-subalgebra of `L` is contained in `A[(z - b) / π ^ M]` for a suitable `b` and a
large enough `M`. -/
private theorem mem_adjoin_of_forall_pow_dvd_sub (A K L B₀ : Type*) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [Field K] [Field L] [Algebra A K] [IsFractionRing A K]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L]
    [IsPurelyInseparable K L] [CommRing B₀] [Algebra A B₀] [Algebra B₀ L]
    [IsScalarTower A B₀ L] [Module.Finite A B₀] {p : ℕ} (hp : p.Prime) [CharP K p] [CharP L p]
    (hdegree : Module.finrank K L = p) {π : A} (hπ : Irreducible π) {z : L} {c : A}
    (hz : z ^ p = algebraMap A L c) (hzK : z ∉ Set.range (algebraMap K L))
    (hforall : ∀ N : ℕ, ∃ b : A, π ^ N ∣ c - b ^ p) :
    ∃ (x : L) (a : A), x ^ p = algebraMap A L a ∧ x ∉ Set.range (algebraMap K L) ∧
      ∀ y : B₀, algebraMap B₀ L y ∈ Algebra.adjoin A ({x} : Set L) := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have hgen : Algebra.adjoin K ({z} : Set L) = ⊤ :=
    adjoin_eq_top_of_finrank_prime K L hp hdegree z hzK
  have hzK' : z ^ p = algebraMap K L (algebraMap A K c) := by
    rw [hz, IsScalarTower.algebraMap_apply A K L]
  have hNfg : (LinearMap.range ((Algebra.linearMap B₀ L).restrictScalars A)).FG := by
    rw [LinearMap.range_eq_map]
    exact (Module.Finite.iff_fg.mp inferInstance).map _
  obtain ⟨M, hM⟩ := exists_pow_mul_mem_span A K L hp hπ hzK' hgen _ hNfg
  obtain ⟨b, d, hdeq⟩ := hforall (p * M)
  have hu0 := algebraMap_pow_ne_zero A K L hπ M
  set x : L := (z - algebraMap A L b) * (algebraMap A L (π ^ M))⁻¹ with hxdef
  have hxu : algebraMap A L (π ^ M) * x = z - algebraMap A L b := by
    rw [hxdef, mul_comm, mul_assoc, inv_mul_cancel₀ hu0, mul_one]
  have hzx : z = algebraMap A L (π ^ M) * x + algebraMap A L b := by rw [hxu]; ring
  have hxp : x ^ p = algebraMap A L d :=
    pow_mul_inv_pow_eq_algebraMap A K L hπ
      (by rw [sub_pow_char, hz, ← map_pow, ← map_sub, hdeq])
  have hxK : x ∉ Set.range (algebraMap K L) := by
    rintro ⟨κ, hκ⟩
    refine hzK ⟨algebraMap A K (π ^ M) * κ + algebraMap A K b, ?_⟩
    rw [map_add, map_mul, ← IsScalarTower.algebraMap_apply A K L,
      ← IsScalarTower.algebraMap_apply A K L, hκ, ← hzx]
  refine ⟨x, d, hxp, hxK, fun y => ?_⟩
  have hzadj : ∀ j : ℕ, z ^ j ∈ Algebra.adjoin A ({x} : Set L) := by
    intro j
    refine pow_mem ?_ j
    rw [hzx]
    exact add_mem (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Algebra.self_mem_adjoin_singleton A x)) (Subalgebra.algebraMap_mem _ _)
  set W : Submodule A L := Subalgebra.toSubmodule (Algebra.adjoin A ({x} : Set L)) ⊔
    LinearMap.range ((Algebra.linearMap K L).restrictScalars A) with hW
  have hpow : ∀ j : ℕ, z ^ j * (algebraMap A L (π ^ M))⁻¹ ∈ W := by
    intro j
    induction j with
    | zero =>
      refine Submodule.mem_sup_right ⟨(algebraMap A K (π ^ M))⁻¹, ?_⟩
      change algebraMap K L ((algebraMap A K (π ^ M))⁻¹) = z ^ 0 * (algebraMap A L (π ^ M))⁻¹
      rw [pow_zero, one_mul, map_inv₀, IsScalarTower.algebraMap_apply A K L]
    | succ j ih =>
      have key : z ^ j * z * (algebraMap A L (π ^ M))⁻¹ =
          z ^ j * x + algebraMap A L b * (z ^ j * (algebraMap A L (π ^ M))⁻¹) := by
        have h1 : z ^ j * z * (algebraMap A L (π ^ M))⁻¹ =
            z ^ j * (z - algebraMap A L b) * (algebraMap A L (π ^ M))⁻¹ +
              algebraMap A L b * (z ^ j * (algebraMap A L (π ^ M))⁻¹) := by ring
        have h2 : z ^ j * (algebraMap A L (π ^ M) * x) * (algebraMap A L (π ^ M))⁻¹ =
            z ^ j * x * (algebraMap A L (π ^ M) * (algebraMap A L (π ^ M))⁻¹) := by ring
        rw [h1, ← hxu, h2, mul_inv_cancel₀ hu0, mul_one]
      rw [pow_succ, key]
      refine Submodule.add_mem _ (Submodule.mem_sup_left ?_) ?_
      · exact (Subalgebra.mem_toSubmodule _).mpr
          (Subalgebra.mul_mem _ (hzadj j) (Algebra.self_mem_adjoin_singleton A x))
      · rw [← Algebra.smul_def]
        exact Submodule.smul_mem _ b ih
  obtain ⟨cc, hcc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp
    (hM _ ⟨y, rfl⟩ : algebraMap A L (π ^ M) * algebraMap B₀ L y ∈ _)
  have hyW : algebraMap B₀ L y ∈ W := by
    have h1 : ∑ i : Fin p, cc i • (z ^ (i : ℕ) * (algebraMap A L (π ^ M))⁻¹) =
        (∑ i : Fin p, cc i • z ^ (i : ℕ)) * (algebraMap A L (π ^ M))⁻¹ := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun i _ => by
        rw [Algebra.smul_def, Algebra.smul_def]; ring
    have hsplit : algebraMap B₀ L y =
        ∑ i : Fin p, cc i • (z ^ (i : ℕ) * (algebraMap A L (π ^ M))⁻¹) := by
      rw [h1, hcc, mul_comm (algebraMap A L (π ^ M)) (algebraMap B₀ L y), mul_assoc,
        mul_inv_cancel₀ hu0, mul_one]
    rw [hsplit]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (hpow _)
  obtain ⟨ξ, hξ, w, hw, hsum⟩ := Submodule.mem_sup.mp hyW
  obtain ⟨γ, hγ⟩ := hw
  have hγ' : algebraMap K L γ = w := hγ
  have : Algebra.IsIntegral A B₀ := Algebra.IsIntegral.of_finite A B₀
  obtain ⟨ay, hay⟩ : (algebraMap B₀ L y) ^ p ∈ (algebraMap A L).range :=
    pow_mem_range_of_isIntegral A K L hp hdegree
      ((Algebra.IsIntegral.isIntegral (R := A) y).map (IsScalarTower.toAlgHom A B₀ L))
  obtain ⟨aξ, haξ⟩ : ξ ^ p ∈ (algebraMap A L).range :=
    pow_mem_range_of_mem_adjoin A L hp hxp ((Subalgebra.mem_toSubmodule _).mp hξ)
  have hγp : γ ^ p = algebraMap A K (ay - aξ) := by
    refine (algebraMap K L).injective ?_
    have hwγ : algebraMap K L γ = algebraMap B₀ L y - ξ := by rw [hγ', ← hsum]; ring
    rw [map_pow, hwγ, sub_pow_char, ← hay, ← haξ, ← map_sub,
      IsScalarTower.algebraMap_apply A K L]
  obtain ⟨aγ, haγ⟩ := IsIntegrallyClosed.exists_algebraMap_eq_of_isIntegral_pow (R := A) hp.pos
    (show IsIntegral A (γ ^ p) by rw [hγp]; exact isIntegral_algebraMap)
  have hwmem : w ∈ Algebra.adjoin A ({x} : Set L) := by
    have hwA : w = algebraMap A L aγ := by
      rw [← hγ', IsScalarTower.algebraMap_apply A K L, haγ]
    rw [hwA]
    exact Subalgebra.algebraMap_mem _ _
  rw [← hsum]
  exact add_mem ((Subalgebra.mem_toSubmodule _).mp hξ) hwmem

/-- **The non-approximable case.**  If the divisibility of `c - bᵖ` by powers of the uniformizer
`π` stops at order `n`, then the integral closure of `A` in `L` is monogenic: it is `A[x]` for a
`p`-th root `x` of a uniformizer when `p` does not divide `n`, and for a `p`-th root of a unit
whose residue is not a `p`-th power when `p` divides `n`. -/
private theorem exists_integralClosure_eq_adjoin_of_not_forall_pow_dvd_sub (A K L : Type*)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [Field K] [Field L] [Algebra A K]
    [IsFractionRing A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] {p : ℕ} (hp : p.Prime) [CharP K p] [CharP L p]
    (hdegree : Module.finrank K L = p) {π : A} (hπ : Irreducible π) {z : L} {c : A}
    (hz : z ^ p = algebraMap A L c) (hzK : z ∉ Set.range (algebraMap K L))
    (hnot : ¬ ∀ N : ℕ, ∃ b : A, π ^ N ∣ c - b ^ p) :
    ∃ (x : L) (a : A), x ^ p = algebraMap A L a ∧ (∀ κ : K, κ ^ p ≠ algebraMap A K a) ∧
      integralClosure A L = Algebra.adjoin A ({x} : Set L) := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have : CharP A p := (algebraMap A K).charP (IsFractionRing.injective A K) p
  have hmax : IsLocalRing.maximalIdeal A = Ideal.span {π} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ
  -- the order at which the approximation stops
  have hP0 : ∃ b : A, π ^ 0 ∣ c - b ^ p := ⟨0, by simp⟩
  have hstep : ∀ N : ℕ, (¬ ∃ b : A, π ^ N ∣ c - b ^ p) →
      ∃ n : ℕ, (∃ b : A, π ^ n ∣ c - b ^ p) ∧ ¬ ∃ b : A, π ^ (n + 1) ∣ c - b ^ p := by
    intro N
    induction N with
    | zero => intro h; exact absurd hP0 h
    | succ N ih =>
      intro h
      by_cases hN : ∃ b : A, π ^ N ∣ c - b ^ p
      · exact ⟨N, hN, h⟩
      · exact ih hN
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ¬ ∃ b : A, π ^ N ∣ c - b ^ p := by
    by_contra h
    push Not at h
    exact hnot h
  obtain ⟨n, hyes, hno'⟩ := hstep N hN
  have hno : ∀ b : A, ¬ π ^ (n + 1) ∣ c - b ^ p := fun b hb => hno' ⟨b, hb⟩
  obtain ⟨b₀, d, hdeq⟩ := hyes
  have hπd : ¬ π ∣ d := by
    rintro ⟨t, ht⟩
    exact hno b₀ ⟨t, by rw [hdeq, ht, pow_succ]; ring⟩
  have hd0 : d ≠ 0 := fun h => hno b₀ ⟨0, by rw [hdeq, h, mul_zero, mul_zero]⟩
  have hdunit : IsUnit d := by
    obtain ⟨k, u, hku⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hd0 hπ
    rcases Nat.eq_zero_or_pos k with hk0 | hk0
    · rw [hku, hk0, pow_zero, mul_one]
      exact u.isUnit
    · have hkk : π ^ (k - 1) * π = π ^ k := by
        rw [← pow_succ]
        congr 1
        omega
      refine absurd ⟨(u : A) * π ^ (k - 1), ?_⟩ hπd
      rw [hku, ← hkk]
      ring
  -- the shifted generator
  set z' : L := z - algebraMap A L b₀ with hz'def
  have hz'p : z' ^ p = algebraMap A L (π ^ n * d) := by
    rw [hz'def, sub_pow_char, hz, ← map_pow, ← map_sub, hdeq]
  have hz'K : z' ∉ Set.range (algebraMap K L) := by
    rintro ⟨κ, hκ⟩
    refine hzK ⟨κ + algebraMap A K b₀, ?_⟩
    rw [map_add, ← IsScalarTower.algebraMap_apply A K L, hκ, hz'def]
    ring
  by_cases hdvd : p ∣ n
  · -- the residue extension is inseparable
    obtain ⟨k, hk⟩ := hdvd
    have hπk0 := algebraMap_pow_ne_zero A K L hπ k
    set x : L := z' * (algebraMap A L (π ^ k))⁻¹ with hxdef
    have hxu : algebraMap A L (π ^ k) * x = z' := by
      rw [hxdef, mul_comm, mul_assoc, inv_mul_cancel₀ hπk0, mul_one]
    have hxp : x ^ p = algebraMap A L d :=
      pow_mul_inv_pow_eq_algebraMap A K L hπ (by rw [← hk]; exact hz'p)
    have hxK : x ∉ Set.range (algebraMap K L) := by
      rintro ⟨κ, hκ⟩
      refine hz'K ⟨algebraMap A K (π ^ k) * κ, ?_⟩
      rw [map_mul, ← IsScalarTower.algebraMap_apply A K L, hκ, hxu]
    have ha : ¬ ∃ β : IsLocalRing.ResidueField A, IsLocalRing.residue A d = β ^ p := by
      rintro ⟨β, hβ⟩
      obtain ⟨b₁, hb₁⟩ := IsLocalRing.residue_surjective (R := A) β
      have hdvd1 : π ∣ d - b₁ ^ p := by
        rw [← Ideal.mem_span_singleton, ← hmax, ← IsLocalRing.residue_eq_zero_iff, map_sub,
          map_pow, hβ, hb₁, sub_self]
      obtain ⟨t, ht⟩ := hdvd1
      refine hno (b₀ + π ^ k * b₁) ⟨t, ?_⟩
      have hexp : (b₀ + π ^ k * b₁) ^ p = b₀ ^ p + π ^ n * b₁ ^ p := by
        rw [add_pow_char, mul_pow, ← pow_mul, Nat.mul_comm k p, ← hk]
      have hfac : c - (b₀ + π ^ k * b₁) ^ p = π ^ n * (d - b₁ ^ p) := by
        rw [hexp, show c - (b₀ ^ p + π ^ n * b₁ ^ p) = c - b₀ ^ p - π ^ n * b₁ ^ p from by ring,
          hdeq]
        ring
      rw [hfac, ht, pow_succ]
      ring
    exact ⟨x, d, hxp, forall_pow_ne_of_notMem_range A K L hp hxp hxK,
      Stacks.DiscreteValuationRing.AdjoinPthRoot.integralClosure_eq_adjoin_of_pow_eq
        (K := K) p d ha x hxp (adjoin_eq_top_of_finrank_prime K L hp hdegree x hxK)⟩
  · -- totally ramified: a `p`-th root of a uniformizer
    have hn0 : n ≠ 0 := fun h => hdvd (h ▸ dvd_zero p)
    obtain ⟨s, t, hst⟩ : ∃ s t : ℕ, n * s = p * t + 1 := by
      have hcop : Nat.Coprime n p := ((Nat.Prime.coprime_iff_not_dvd hp).mpr hdvd).symm
      obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hcop
      have hp0 : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp.pos
      refine ⟨(u % (p : ℤ)).toNat + p, ?_⟩
      have hge : 1 ≤ n * ((u % (p : ℤ)).toNat + p) :=
        Nat.one_le_iff_ne_zero.mpr (mul_ne_zero hn0 (by omega))
      have hZ : (p : ℤ) ∣ ((n * ((u % (p : ℤ)).toNat + p) : ℕ) : ℤ) - 1 := by
        refine ⟨-v - (n : ℤ) * (u / (p : ℤ)) + (n : ℤ), ?_⟩
        push_cast [Int.toNat_of_nonneg (Int.emod_nonneg u (ne_of_gt hp0))]
        rw [Int.emod_def]
        linear_combination huv
      obtain ⟨t, ht⟩ : p ∣ n * ((u % (p : ℤ)).toNat + p) - 1 := by
        refine Int.natCast_dvd_natCast.mp ?_
        rwa [Nat.cast_sub hge, Nat.cast_one]
      exact ⟨t, by omega⟩
    set x : L := z' ^ s * (algebraMap A L (π ^ t))⁻¹ with hxdef
    have hxp : x ^ p = algebraMap A L (π * d ^ s) := by
      refine pow_mul_inv_pow_eq_algebraMap A K L hπ ?_
      have hsp : (z' ^ s) ^ p = (z' ^ p) ^ s := by
        rw [← pow_mul, ← pow_mul, Nat.mul_comm]
      rw [hsp, hz'p, ← map_pow]
      congr 1
      rw [mul_pow, ← pow_mul, hst, pow_succ]
      ring
    have hirrA : Irreducible (π * d ^ s) :=
      (associated_mul_unit_left π (d ^ s) (hdunit.pow s)).symm.irreducible hπ
    refine ⟨x, π * d ^ s, hxp, fun κ hκ => ?_, ?_⟩
    · obtain ⟨β, hβ⟩ := exists_pow_eq_of_pow_eq_algebraMap A K hp.pos (π * d ^ s) κ hκ
      exact not_irreducible_pow hp.ne_one (hβ ▸ hirrA)
    · exact integralClosure_eq_adjoin_of_pow_eq_uniformizer A K L hp hdegree (π * d ^ s)
        hirrA x hxp

/-- **A module-finite `A`-subalgebra of a purely inseparable extension of prime degree of the
fraction field of a discrete valuation ring is contained in a monogenic one.**

For `A` a discrete valuation ring with fraction field `K`, `L / K` purely inseparable of prime
degree `p` and `B₀` an `A`-algebra module-finite over `A` mapping to `L`, there is an `x` in `L`
with `xᵖ` in `A` whose `A`-subalgebra `A[x]` contains the image of `B₀`, together with the
presentation `L ≅ K[T] ⧸ (Tᵖ - a)` that `xᵖ = a` induces.

This is what the third paragraph of the proof of [Stacks, Tag 0AX6] needs when the source is not
assumed normal: `B₀` is the local ring of the source at a codimension-one point, which is then
module-finite over `A` but neither monogenic nor normal, while
`KaehlerDifferential.higherTrace_mem_range_mapExteriorPowerTower_of_tower` only needs it to map
into a monogenic ring. -/
theorem exists_algEquiv_adjoinRoot_and_mem_adjoin_of_isPurelyInseparable (A K L B₀ : Type*)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [Field K] [Field L] [Algebra A K]
    [IsFractionRing A K] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [IsPurelyInseparable K L] [CommRing B₀] [Algebra A B₀] [Algebra B₀ L]
    [IsScalarTower A B₀ L] [Module.Finite A B₀] {p : ℕ} (hp : p.Prime)
    (hdegree : Module.finrank K L = p) :
    ∃ (x : L) (a : A) (e : AdjoinRoot (X ^ p - C (algebraMap A K a)) ≃ₐ[K] L),
      x ^ p = algebraMap A L a ∧
        (∀ y : B₀, algebraMap B₀ L y ∈ Algebra.adjoin A ({x} : Set L)) ∧
        e (AdjoinRoot.root (X ^ p - C (algebraMap A K a))) = x := by
  classical
  have : FiniteDimensional K L := Module.finite_of_finrank_pos (by rw [hdegree]; exact hp.pos)
  have : CharP K p := charP_of_finrank_eq_prime K L hp hdegree
  have : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible A
  -- a generator of `L` over `K` whose `p`-th power lies in `A`
  obtain ⟨y₀, hy₀⟩ : ∃ y : L, y ∉ Set.range (algebraMap K L) := by
    by_contra h
    push Not at h
    have h1 : Module.finrank K L = 1 := by
      rw [← (LinearEquiv.ofBijective (Algebra.linearMap K L)
        ⟨(algebraMap K L).injective, fun y => h y⟩).finrank_eq, Module.finrank_self]
    exact hp.ne_one (hdegree ▸ h1)
  obtain ⟨γ, hγ⟩ := pow_mem_range_of_finrank_eq_prime K L hp hdegree y₀
  obtain ⟨m, a₁, ha₁⟩ := exists_pow_mul_mem_range A K hπ γ
  set z : L := algebraMap A L (π ^ m) * y₀ with hzdef
  have hzp : z ^ p = algebraMap A L (π ^ (m * p - m) * a₁) := by
    have hcoef := algebraMap_pow_mul_eq_of_le _ _ ha₁ (Nat.le_mul_of_pos_right m hp.pos)
    rw [hzdef, mul_pow, ← map_pow, ← pow_mul, ← hγ, IsScalarTower.algebraMap_apply A K L,
      IsScalarTower.algebraMap_apply A K L, ← map_mul, hcoef]
  have hzK : z ∉ Set.range (algebraMap K L) := by
    rintro ⟨κ, hκ⟩
    have hπm0 := algebraMap_pow_ne_zero A K L hπ m
    refine hy₀ ⟨κ / algebraMap A K (π ^ m), ?_⟩
    rw [map_div₀, hκ, ← IsScalarTower.algebraMap_apply A K L, hzdef]
    field_simp
  -- the two cases
  obtain ⟨x, a, hxp, hnp, hle⟩ : ∃ (x : L) (a : A), x ^ p = algebraMap A L a ∧
      (∀ κ : K, κ ^ p ≠ algebraMap A K a) ∧
      ∀ y : B₀, algebraMap B₀ L y ∈ Algebra.adjoin A ({x} : Set L) := by
    by_cases hforall : ∀ N : ℕ, ∃ b : A, π ^ N ∣ π ^ (m * p - m) * a₁ - b ^ p
    · obtain ⟨x, a, hxp, hxK, hle⟩ := mem_adjoin_of_forall_pow_dvd_sub A K L B₀ hp hdegree hπ
        hzp hzK hforall
      exact ⟨x, a, hxp, forall_pow_ne_of_notMem_range A K L hp hxp hxK, hle⟩
    · obtain ⟨x, a, hxp, hnp, hclosure⟩ :=
        exists_integralClosure_eq_adjoin_of_not_forall_pow_dvd_sub A K L hp hdegree hπ hzp hzK
          hforall
      have : Algebra.IsIntegral A B₀ := Algebra.IsIntegral.of_finite A B₀
      refine ⟨x, a, hxp, hnp, fun y => ?_⟩
      rw [← hclosure]
      exact (Algebra.IsIntegral.isIntegral (R := A) y).map (IsScalarTower.toAlgHom A B₀ L)
  -- the presentation of `L` the generator induces
  obtain ⟨e, he⟩ := exists_algEquiv_adjoinRoot_of_pow_eq A K L hp hdegree hxp hnp
  exact ⟨x, a, e, hxp, hle, he⟩

end IsDiscreteValuationRing
