/-! ### A `p`-th root generator gives a spanning set of `p` powers -/

/-- **An algebra generated by a single element whose `p`-th power comes from the base is spanned,
as a module, by the first `p` powers of that element.**  Every element is a polynomial in the
generator, and `xⁿ = a ^ (n / p) • x ^ (n % p)` reduces every power to one below the `p`-th.

With `Algebra.adjoin A {x} = ⊤` and `x ^ p = algebraMap A B a` as
`IsDiscreteValuationRing.exists_algEquiv_adjoinRoot_of_isPurelyInseparable` supplies them, this
is the statement that `1, x, …, x^{p-1}` generate `B` over `A`. -/
@[ega "0 21.1.7" "a)⇒b), special case"]
theorem Algebra.span_range_pow_eq_top_of_adjoin_singleton_eq_top {A B : Type*} [CommRing A]
    [CommRing B] [Algebra A B] {p : ℕ} (hp : 0 < p) {x : B} {a : A}
    (hx : x ^ p = algebraMap A B a) (hgen : Algebra.adjoin A ({x} : Set B) = ⊤) :
    Submodule.span A (Set.range fun i : Fin p => x ^ (i : ℕ)) = ⊤ := by
  set M : Submodule A B := Submodule.span A (Set.range fun i : Fin p => x ^ (i : ℕ)) with hM
  have hmod : ∀ n : ℕ, x ^ n ∈ M := by
    intro n
    have hred : a ^ (n / p) • x ^ (n % p) = x ^ n := by
      rw [Algebra.smul_def, map_pow, ← hx, ← pow_mul, ← pow_add, Nat.div_add_mod n p]
    rw [← hred]
    exact M.smul_mem _ (Submodule.subset_span ⟨⟨n % p, Nat.mod_lt n hp⟩, rfl⟩)
  refine top_unique fun b _ => ?_
  have hb : b ∈ (Polynomial.aeval (R := A) x).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval A x, hgen]
    exact Algebra.mem_top
  obtain ⟨P, hP⟩ := hb
  have hbP : b = Polynomial.aeval x P := hP.symm
  rw [hbP, Polynomial.aeval_eq_sum_range]
  exact M.sum_mem fun i _ => M.smul_mem _ (hmod i)

