module

public import StacksFrontier.RingTheory.DiscreteValuationRing.Unramified
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Constant field extensions of a discrete valuation ring with finite residue field

Let `A` be a discrete valuation ring with finite residue field `κ` and fraction field `K`, and let
`F / K` be a finite separable extension which contains a finite field `k₃` with
`|κ| ^ [F : K] ≤ |k₃|`; for instance `F = K(k₃)` with `k ⊆ K` a finite field of the size of `κ`
and `k₃ / k` finite (`IsDiscreteValuationRing.finrank_adjoin_range_le`). Such an extension is
*inert*: the integral closure of `A` in `F` has exactly one maximal ideal, with ramification
index one. So the integral closure is again a discrete valuation ring, a uniformizer of `A` stays
a uniformizer, and the residue field stays finite. This is the behaviour at `∞` of the constant
field extension `k'(x) / k(x)`, used to make the Artin–Schreier pole-order argument uniform in
the constant field.

## Main results

* `IsDiscreteValuationRing.finrank_adjoin_range_le`: `[K(k₃) : K] ≤ [k₃ : k]`.
* `IsDiscreteValuationRing.isDiscreteValuationRing_integralClosure_of_card_pow_le`: the integral
  closure is a discrete valuation ring.
* `IsDiscreteValuationRing.irreducible_algebraMap_integralClosure_of_card_pow_le`: a uniformizer
  of `A` stays a uniformizer.
* `IsDiscreteValuationRing.finite_quotient_integralClosure_of_card_pow_le`: the residue field
  stays finite.
* `IsDiscreteValuationRing.mem_range_of_mem_range_of_dominates`: a discrete valuation ring
  dominating another one with the same fraction field equals it.
-/

@[expose] public noncomputable section

namespace IsDiscreteValuationRing

section Span

/-- **A field generated by a finite extension of a subfield has bounded degree.** If `k ⊆ K` and
`φ : k₃ → F` is a `k`-algebra map from a finite extension `k₃ / k` into an extension `F / K`, then
`[K(φ(k₃)) : K] ≤ [k₃ : k]`: `K(φ(k₃))` is the `K`-span of the image of a `k`-basis of `k₃`. -/
theorem finrank_adjoin_range_le {k K F k₃ : Type*} [Field k] [Field K] [Field F] [Field k₃]
    [Algebra k K] [Algebra K F] [Algebra k F] [IsScalarTower k K F] [Algebra k k₃]
    [FiniteDimensional k k₃] (φ : k₃ →ₐ[k] F) :
    Module.finrank K (IntermediateField.adjoin K (Set.range φ)) ≤ Module.finrank k k₃ := by
  classical
  let b := Module.finBasis k k₃
  let W : Submodule K F := Submodule.span K (Set.range (φ ∘ b))
  have hφW : ∀ z : k₃, φ z ∈ W := by
    intro z
    rw [← b.sum_repr z, map_sum]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [map_smul, algebra_compatible_smul K (b.repr z i)]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hWW : W * W ≤ W := by
    rw [Submodule.span_mul_span]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨a, ⟨i, rfl⟩, c, ⟨j, rfl⟩, rfl⟩
    show φ (b i) * φ (b j) ∈ W
    rw [← map_mul]
    exact hφW _
  let S : Subalgebra K F := W.toSubalgebra (by rw [← map_one φ]; exact hφW 1)
    (fun x y hx hy => hWW (Submodule.mul_mem_mul hx hy))
  have halg : ∀ x ∈ Set.range φ, IsAlgebraic K x := by
    rintro _ ⟨z, rfl⟩
    exact ((Algebra.IsIntegral.isIntegral (R := k) z).map φ).tower_top.isAlgebraic
  have hle : (IntermediateField.adjoin K (Set.range φ)).toSubalgebra ≤ S := by
    rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg]
    exact Algebra.adjoin_le (Set.range_subset_iff.2 hφW)
  have hfin : Module.Finite K W := FiniteDimensional.span_of_finite K (Set.finite_range _)
  calc Module.finrank K (IntermediateField.adjoin K (Set.range φ))
      = Module.finrank K (Subalgebra.toSubmodule
          (IntermediateField.adjoin K (Set.range φ)).toSubalgebra) :=
        (IntermediateField.finrank_eq_finrank_subalgebra _).symm
    _ ≤ Module.finrank K W := Submodule.finrank_mono hle
    _ ≤ Fintype.card (Fin (Module.finrank k k₃)) := finrank_range_le_card _
    _ = Module.finrank k k₃ := Fintype.card_fin _

end Span

section Inert

variable (A K : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [Field K]
  [Algebra A K] [IsFractionRing A K] [Finite (IsLocalRing.ResidueField A)]
  (F : Type*) [Field F] [Algebra K F] [FiniteDimensional K F] [Algebra.IsSeparable K F]
  [Algebra A F] [IsScalarTower A K F]

omit [IsDomain A] [IsDiscreteValuationRing A] [Finite (IsLocalRing.ResidueField A)] in
/-- The elements of a finite field mapped into `F` are integral over `A`. -/
theorem isIntegral_of_ringHom_finite {k₃ : Type*} [Field k₃] [Finite k₃] (φ : k₃ →+* F)
    (z : k₃) : IsIntegral A (φ z) :=
  ((IsIntegral.of_finite ℤ z).map φ.toIntAlgHom).tower_top

omit [IsDomain A] [IsDiscreteValuationRing A] [Finite (IsLocalRing.ResidueField A)]
  [FiniteDimensional K F] [Algebra.IsSeparable K F] in
include K in
/-- `A` embeds in its integral closure in `F`. -/
theorem injective_algebraMap_integralClosure :
    Function.Injective (algebraMap A (integralClosure A F)) := by
  intro x y h
  have h' : algebraMap A F x = algebraMap A F y := congrArg Subtype.val h
  rw [IsScalarTower.algebraMap_apply A K F, IsScalarTower.algebraMap_apply A K F] at h'
  exact IsFractionRing.injective A K ((algebraMap K F).injective h')

/-- The residue field at a maximal ideal lying over the maximal ideal of `A` is finite. -/
private theorem finite_quotient_of_liesOver {B : Type*} [CommRing B] [Algebra A B]
    [Module.Finite A B] (m : Ideal B) [m.IsMaximal] [m.LiesOver (IsLocalRing.maximalIdeal A)] :
    Finite (B ⧸ m) := by
  let : Field (A ⧸ IsLocalRing.maximalIdeal A) :=
    Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
  have : Module.Finite (A ⧸ IsLocalRing.maximalIdeal A) (B ⧸ m) :=
    Module.Finite.of_restrictScalars_finite A _ _
  have : Finite (A ⧸ IsLocalRing.maximalIdeal A) :=
    inferInstanceAs (Finite (IsLocalRing.ResidueField A))
  exact Module.finite_of_finite (A ⧸ IsLocalRing.maximalIdeal A)

/-- **The count behind inertness.** If `F / K` contains a finite field `k₃` with
`|κ| ^ [F : K] ≤ |k₃|`, then the integral closure of `A` in `F` has exactly one maximal ideal, and
its ramification index is one: by `[F : K] = ∑ eᵢ fᵢ` every residue field `κᵢ` contains `k₃`, so
`|κ| ^ fᵢ ≥ |k₃| ≥ |κ| ^ [F : K]`, `fᵢ ≥ [F : K]`, and there is room for one term with `e = 1`. -/
theorem exists_maximalIdeal_integralClosure_of_card_pow_le {k₃ : Type*} [Field k₃] [Finite k₃]
    (φ : k₃ →+* F)
    (hcard : Nat.card (IsLocalRing.ResidueField A) ^ Module.finrank K F ≤ Nat.card k₃) :
    ∃ m : Ideal (integralClosure A F), m.IsMaximal ∧
      (∀ q : Ideal (integralClosure A F), q.IsMaximal → q = m) ∧
      m.LiesOver (IsLocalRing.maximalIdeal A) ∧ m.ramificationIdx A = 1 := by
  classical
  obtain ⟨hfin, -, -, -, n, m, hmax, hmaxiff, hlies, -, hsum, -, -⟩ :=
    integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia A K F
  let B := integralClosure A F
  let φ' : k₃ →+* B := φ.codRestrict (integralClosure A F) (isIntegral_of_ringHom_finite A F φ)
  set d := Module.finrank K F
  have hd0 : 0 < d := Module.finrank_pos
  set q := Nat.card (IsLocalRing.ResidueField A)
  have hq2 : 2 ≤ q := Finite.one_lt_card
  -- every inertia degree is at least `d`
  have hf : ∀ i, d ≤ (m i).inertiaDeg A := fun i => by
    have := hmax i
    have := hlies i
    have : Finite (B ⧸ m i) := finite_quotient_of_liesOver A (m i)
    let : Field (A ⧸ IsLocalRing.maximalIdeal A) :=
      Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
    let : Field (B ⧸ m i) := Ideal.Quotient.field (m i)
    have h1 : Nat.card k₃ ≤ Nat.card (B ⧸ m i) :=
      Nat.card_le_card_of_injective _ ((Ideal.Quotient.mk (m i)).comp φ').injective
    have h2 : Nat.card (B ⧸ m i) = q ^ (m i).inertiaDeg A := by
      rw [Ideal.inertiaDeg_eq_of_isMaximal (IsLocalRing.maximalIdeal A) (m i),
        Module.natCard_eq_pow_finrank (K := A ⧸ IsLocalRing.maximalIdeal A)]
      rfl
    exact (Nat.pow_le_pow_iff_right hq2).1 (hcard.trans (h1.trans h2.le))
  have he : ∀ i, 1 ≤ (m i).ramificationIdx A := by
    intro i
    have := (hmax i).isPrime
    exact Ideal.ramificationIdx_pos (m i) A
  -- there is at least one maximal ideal
  obtain ⟨M, hM⟩ := Ideal.exists_maximal B
  obtain ⟨i₀, hi₀, -⟩ := (hmaxiff M).1 hM
  have hn1 : n ≤ 1 := by
    have hle : n * d ≤ d := by
      calc n * d = ∑ _i : Fin n, d := by simp
        _ ≤ ∑ i, (m i).ramificationIdx A * (m i).inertiaDeg A :=
          Finset.sum_le_sum fun i _ => (Nat.le_mul_of_pos_left _ (he i)).trans
            (Nat.mul_le_mul_left _ (hf i)) |>.trans_eq' (by ring)
        _ = d := hsum.symm
    by_contra h
    have h2 : 2 ≤ n := by omega
    nlinarith
  obtain rfl : n = 1 := le_antisymm hn1 (Fin.pos i₀)
  refine ⟨m 0, hmax 0, fun Q hQ => ?_, hlies 0, ?_⟩
  · obtain ⟨i, hi, -⟩ := (hmaxiff Q).1 hQ
    rw [← hi, Subsingleton.elim i 0]
  · have hs : d = (m 0).ramificationIdx A * (m 0).inertiaDeg A := by simpa using hsum
    have h0 := hf 0
    have h1 := he 0
    by_contra h
    have h2 : 2 ≤ (m 0).ramificationIdx A := by omega
    nlinarith

/-- Under the hypothesis of
`IsDiscreteValuationRing.exists_maximalIdeal_integralClosure_of_card_pow_le`, the integral
closure of `A` in `F` is a local ring. -/
theorem isLocalRing_integralClosure_of_card_pow_le {k₃ : Type*} [Field k₃] [Finite k₃]
    (φ : k₃ →+* F)
    (hcard : Nat.card (IsLocalRing.ResidueField A) ^ Module.finrank K F ≤ Nat.card k₃) :
    IsLocalRing (integralClosure A F) := by
  obtain ⟨m, hm, huniq, -, -⟩ := exists_maximalIdeal_integralClosure_of_card_pow_le A K F φ hcard
  exact IsLocalRing.of_unique_max_ideal ⟨m, hm, huniq⟩

/-- **A constant field extension of a discrete valuation ring with finite residue field is again
a discrete valuation ring**: under the hypothesis of
`IsDiscreteValuationRing.exists_maximalIdeal_integralClosure_of_card_pow_le`, the integral
closure of `A` in `F` is a local Dedekind domain which is not a field. -/
@[sga "6 X 7.16" "special case"]
theorem isDiscreteValuationRing_integralClosure_of_card_pow_le {k₃ : Type*} [Field k₃] [Finite k₃]
    (φ : k₃ →+* F)
    (hcard : Nat.card (IsLocalRing.ResidueField A) ^ Module.finrank K F ≤ Nat.card k₃) :
    IsDiscreteValuationRing (integralClosure A F) := by
  obtain ⟨-, hnoeth, -, hded, -⟩ :=
    integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia A K F
  obtain ⟨m, hm, huniq, hlies, -⟩ :=
    exists_maximalIdeal_integralClosure_of_card_pow_le A K F φ hcard
  have := isLocalRing_integralClosure_of_card_pow_le A K F φ hcard
  have hnf : ¬ IsField (integralClosure A F) := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← IsLocalRing.eq_maximalIdeal hm]
    intro h0
    have hA := (Ideal.over_def m (IsLocalRing.maximalIdeal A)).symm
    rw [h0, Ideal.under, Ideal.comap_bot_of_injective _
      (injective_algebraMap_integralClosure A K F)] at hA
    exact IsDiscreteValuationRing.not_a_field A hA.symm
  exact ((IsDiscreteValuationRing.TFAE (integralClosure A F) hnf).out 3 1).1 hded

/-- **A uniformizer stays a uniformizer in a constant field extension**: under the hypothesis of
`IsDiscreteValuationRing.exists_maximalIdeal_integralClosure_of_card_pow_le`, the ramification
index is one, so the image of a uniformizer `π` of `A` lies in the maximal ideal of the integral
closure but not in its square. -/
theorem irreducible_algebraMap_integralClosure_of_card_pow_le {k₃ : Type*} [Field k₃] [Finite k₃]
    (φ : k₃ →+* F)
    (hcard : Nat.card (IsLocalRing.ResidueField A) ^ Module.finrank K F ≤ Nat.card k₃)
    {π : A} (hπ : Irreducible π) : Irreducible (algebraMap A (integralClosure A F) π) := by
  obtain ⟨-, -, -, hded, -⟩ :=
    integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia A K F
  obtain ⟨m, hm, -, hlies, he⟩ :=
    exists_maximalIdeal_integralClosure_of_card_pow_le A K F φ hcard
  have := isLocalRing_integralClosure_of_card_pow_le A K F φ hcard
  have := isDiscreteValuationRing_integralClosure_of_card_pow_le A K F φ hcard
  have : m.IsPrime := hm.isPrime
  have : FaithfulSMul A (integralClosure A F) :=
    (faithfulSMul_iff_algebraMap_injective A _).2 (injective_algebraMap_integralClosure A K F)
  have hmB : m = IsLocalRing.maximalIdeal (integralClosure A F) := IsLocalRing.eq_maximalIdeal hm
  have hp0 : IsLocalRing.maximalIdeal A ≠ ⊥ := IsDiscreteValuationRing.not_a_field A
  have he' : (IsLocalRing.maximalIdeal A).ramificationIdx' m = 1 := by
    rwa [Ideal.ramificationIdx'_eq_ramificationIdx _ _ hp0]
  have hmap : (IsLocalRing.maximalIdeal A).map (algebraMap A (integralClosure A F)) ≤ m :=
    Ideal.map_le_iff_le_comap.2 (Ideal.over_def m (IsLocalRing.maximalIdeal A)).le
  have hnot : ¬ (IsLocalRing.maximalIdeal A).map (algebraMap A (integralClosure A F)) ≤ m ^ 2 :=
    fun h => ((Ideal.ramificationIdx'_ne_one_iff hmap).2 h) he'
  have hmaxA := (irreducible_iff_uniformizer π).1 hπ
  set x := algebraMap A (integralClosure A F) π
  have hxm : x ∈ m :=
    hmap (Ideal.mem_map_of_mem _ (hmaxA ▸ Ideal.mem_span_singleton_self π))
  have hxm2 : x ∉ m ^ 2 := fun h => hnot (by
    rw [hmaxA, Ideal.map_span, Set.image_singleton]
    exact (Ideal.span_singleton_le_iff_mem _).2 h)
  have hx0 : x ≠ 0 := fun h0 =>
    hπ.ne_zero (injective_algebraMap_integralClosure A K F (h0.trans (map_zero _).symm))
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (integralClosure A F)
  obtain ⟨j, u, hx⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hϖ
  have hϖm : ϖ ∈ m := hmB ▸ (IsLocalRing.mem_maximalIdeal ϖ).2 hϖ.not_isUnit
  rcases j with _ | _ | j
  · exfalso
    rw [pow_zero, mul_one] at hx
    exact (IsLocalRing.mem_maximalIdeal x).1 (hmB ▸ hxm) (hx ▸ u.isUnit)
  · rw [zero_add, pow_one] at hx
    exact (show Associated ϖ x from ⟨u, by rw [hx, mul_comm]⟩).irreducible hϖ
  · exfalso
    apply hxm2
    rw [hx, show j + 1 + 1 = j + 2 by ring, pow_add]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hϖm 2))

/-- Under the hypothesis of
`IsDiscreteValuationRing.exists_maximalIdeal_integralClosure_of_card_pow_le`, the residue field of
the integral closure of `A` in `F` (at its unique maximal ideal) is finite. -/
theorem finite_quotient_integralClosure_of_card_pow_le {k₃ : Type*} [Field k₃] [Finite k₃]
    (φ : k₃ →+* F)
    (hcard : Nat.card (IsLocalRing.ResidueField A) ^ Module.finrank K F ≤ Nat.card k₃)
    (m : Ideal (integralClosure A F)) [m.IsMaximal] :
    Finite (integralClosure A F ⧸ m) := by
  obtain ⟨hfin, -⟩ :=
    integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia A K F
  obtain ⟨m₀, -, huniq, hlies, -⟩ :=
    exists_maximalIdeal_integralClosure_of_card_pow_le A K F φ hcard
  obtain rfl := huniq m inferInstance
  exact finite_quotient_of_liesOver A m

end Inert

section Domination

/-- **A discrete valuation ring dominating another one with the same fraction field is
contained in it.** Let `R` and `S` be discrete valuation rings with the same fraction field `K`,
with `R ⊆ S` and some nonzero element of the maximal ideal of `R` in the maximal ideal of `S`.
Then `S ⊆ R`: the maximal ideal of `R` lands in that of `S` (its preimage is a nonzero prime),
and an element of `S` outside `R` would have its inverse in the maximal ideal of `R`. -/
theorem mem_range_of_mem_range_of_dominates {R S K : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] [Field K]
    [Algebra R K] [IsFractionRing R K] [Algebra S K] [IsFractionRing S K]
    (hRS : ∀ r : R, algebraMap R K r ∈ Set.range (algebraMap S K))
    {r₀ : R} (hr₀ : r₀ ≠ 0) (hr₀m : r₀ ∈ IsLocalRing.maximalIdeal R)
    (hr₀S : ∀ s : S, algebraMap S K s = algebraMap R K r₀ → s ∈ IsLocalRing.maximalIdeal S)
    (s : S) : algebraMap S K s ∈ Set.range (algebraMap R K) := by
  classical
  let eS : S ≃+* (algebraMap S K).range := RingEquiv.ofBijective (algebraMap S K).rangeRestrict
    ⟨fun a b h => IsFractionRing.injective S K (congrArg Subtype.val h),
      (algebraMap S K).rangeRestrict_surjective⟩
  let g : R →+* S := eS.symm.toRingHom.comp
    ((algebraMap R K).codRestrict (algebraMap S K).range fun r => RingHom.mem_range.2 (hRS r))
  have hg : ∀ r, algebraMap S K (g r) = algebraMap R K r := fun r =>
    congrArg Subtype.val (eS.apply_symm_apply ⟨_, RingHom.mem_range.2 (hRS r)⟩)
  -- the maximal ideal of `R` maps into that of `S`
  have hgm : ∀ r ∈ IsLocalRing.maximalIdeal R, g r ∈ IsLocalRing.maximalIdeal S := by
    let P := (IsLocalRing.maximalIdeal S).comap g
    have hr₀P : r₀ ∈ P := hr₀S (g r₀) (hg r₀)
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨j, u, hj⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr₀ hϖ
    have hj0 : j ≠ 0 := by
      rintro rfl
      rw [pow_zero, mul_one] at hj
      exact (IsLocalRing.mem_maximalIdeal r₀).1 hr₀m (hj ▸ u.isUnit)
    have hϖP : ϖ ∈ P := by
      have hu : (u : R) ∉ P := fun h =>
        (IsLocalRing.mem_maximalIdeal _).1 h (u.isUnit.map g)
      rw [hj] at hr₀P
      exact Ideal.IsPrime.mem_of_pow_mem inferInstance j
        ((inferInstance : P.IsPrime).mem_or_mem hr₀P |>.resolve_left hu)
    intro r hr
    rw [(irreducible_iff_uniformizer ϖ).1 hϖ] at hr
    exact (Ideal.span_singleton_le_iff_mem P).2 hϖP hr
  rcases eq_or_ne s 0 with rfl | hs0
  · exact ⟨0, by simp⟩
  have hz0 : algebraMap S K s ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective S K)).2 hs0
  rcases ValuationRing.isInteger_or_isInteger R (algebraMap S K s) with ⟨r, hr⟩ | ⟨r, hr⟩
  · exact ⟨r, hr⟩
  · by_cases hru : IsUnit r
    · refine ⟨(hru.unit⁻¹ : Rˣ), ?_⟩
      rw [map_units_inv, IsUnit.unit_spec, hr, inv_inv]
    · exfalso
      have hrm := hgm r ((IsLocalRing.mem_maximalIdeal r).2 hru)
      have h1 : g r * s = 1 := IsFractionRing.injective S K (by
        rw [map_mul, hg, hr, map_one, inv_mul_cancel₀ hz0])
      exact (IsLocalRing.mem_maximalIdeal _).1 hrm (IsUnit.of_mul_eq_one _ h1)

end Domination

end IsDiscreteValuationRing

end
