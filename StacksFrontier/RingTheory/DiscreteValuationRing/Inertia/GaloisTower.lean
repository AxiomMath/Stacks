module

public import StacksFrontier.RingTheory.DiscreteValuationRing.Inertia.Character
public import Mathlib.RingTheory.Ideal.Quotient.Noetherian
public import Mathlib.RingTheory.Localization.Submodule
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Inertia in a tower of Galois extensions and the canonical inertia character

In a tower of finite Galois extensions, restriction surjects the decomposition, inertia and wild
inertia groups compatibly with residue fields and inertia characters (Tag 0BU7); the canonical
inertia character identifies tame inertia with roots of unity of order `|I_t|` (Tag 0BU8).
-/

@[expose] public section

open scoped Pointwise

namespace IsDiscreteValuationRing

section Tower

/-- A maximal ideal of the integral closure of a DVR in a finite separable extension is
generated by a prime element, and a uniformizer of the DVR factors as its power with exponent
the ramification index times an element prime to it. -/
private theorem exists_prime_eq_span_and_eq_pow_ramificationIdx_mul
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L]
    (P : Ideal (integralClosure A L)) [P.IsMaximal] {ρ : A} (hρ : Irreducible ρ) :
    ∃ π : integralClosure A L, Prime π ∧ P = Ideal.span {π} ∧
      ∃ u, algebraMap A (integralClosure A L) ρ = π ^ P.ramificationIdx A * u ∧ ¬ π ∣ u := by
  let B := integralClosure A L
  have : FaithfulSMul A L := by
    rw [faithfulSMul_iff_algebraMap_injective, IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have : FaithfulSMul A B := inferInstance
  let : Module.Finite A B := IsIntegralClosure.finite A K L B
  let : IsDedekindDomain B := IsIntegralClosure.isDedekindDomain A K L B
  let : IsPrincipalIdealRing B := IsPrincipalIdealRing.of_finite_maximals (by
    apply (Algebra.QuasiFinite.finite_primesOver (S := B) (IsLocalRing.maximalIdeal A)).subset
    intro Q hQ
    let : Q.IsMaximal := hQ
    have hQunder : Q.under A = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal inferInstance
    exact ⟨inferInstance, ⟨hQunder.symm⟩⟩)
  let p₀ := P.under A
  have hp₀ : p₀ = IsLocalRing.maximalIdeal A := IsLocalRing.eq_maximalIdeal inferInstance
  have hp₀ne : p₀ ≠ ⊥ := hp₀ ▸ IsDiscreteValuationRing.not_a_field A
  have hPne : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot hp₀ne P
  let π := Submodule.IsPrincipal.generator P
  have hπ : Prime π := Submodule.IsPrincipal.prime_generator_of_isPrime P hPne
  have hP : P = Ideal.span {π} := (Ideal.span_singleton_generator P).symm
  obtain ⟨u, hu, hun⟩ := exists_eq_pow_ramificationIdx_mul P p₀ hπ.ne_zero hP hρ.ne_zero
    (hp₀.trans hρ.maximalIdeal_eq)
  exact ⟨π, hπ, hP, u, hu, fun h ↦ hun (by rwa [hP, Ideal.mem_span_singleton])⟩

/-- The residue field of a maximal ideal of the integral closure of a DVR has the same
characteristic as the residue field of the DVR. -/
private theorem charP_integralClosure_quotient
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra A L] [IsScalarTower A K L]
    (P : Ideal (integralClosure A L)) [P.IsMaximal] :
    CharP (integralClosure A L ⧸ P) (ringChar (IsLocalRing.ResidueField A)) := by
  have hunder : P.under A = IsLocalRing.maximalIdeal A :=
    IsLocalRing.eq_maximalIdeal inferInstance
  let : P.LiesOver (IsLocalRing.maximalIdeal A) := ⟨hunder.symm⟩
  let : Field (integralClosure A L ⧸ P) := Ideal.Quotient.field P
  let : Algebra (IsLocalRing.ResidueField A) (integralClosure A L ⧸ P) :=
    Ideal.Quotient.algebraOfLiesOver P (IsLocalRing.maximalIdeal A)
  rw [Algebra.ringChar_eq (IsLocalRing.ResidueField A) (integralClosure A L ⧸ P)]
  infer_instance

/-- The wild inertia group is a `p`-group in positive residue characteristic `p`, trivial in
residue characteristic zero, and the roots of unity of order `e` in the residue field have
the prime-to-`p` part of `e` as cardinality. -/
@[sga "1 XIII 2.0"]
private theorem wildInertiaGroup_isPGroup_and_card_rootsOfUnity
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] [Algebra A L] [IsScalarTower A K L]
    (P : Ideal (integralClosure A L)) [P.IsMaximal] :
    letI := IsIntegralClosure.MulSemiringAction A K L (integralClosure A L)
    let p := ringChar (IsLocalRing.ResidueField A)
    (0 < p → IsPGroup p (wildInertiaGroup A K L P)) ∧
      (p = 0 → wildInertiaGroup A K L P = ⊥) ∧
      Nat.card (rootsOfUnity (P.ramificationIdx A) (integralClosure A L ⧸ P)) =
        P.ramificationIdx A / p ^ (P.ramificationIdx A).factorization p := by
  obtain ⟨W, -, -, -, -, hpg, hzero, -, θ, -, hexact, -, -, hcard, hchar, -⟩ :=
    exists_wildInertia_exact_and_tameInertia_equiv_rootsOfUnity A K L P
  have hθ : θ = inertiaCharacter A K L P :=
    inertiaCharacter_eq A K L P θ hchar
  have hW : wildInertiaGroup A K L P = W := by
    rw [wildInertiaGroup_eq_ker_inertiaCharacter, ← hθ, hexact.monoidHom_ker_eq,
      Subgroup.range_subtype]
  rw [hW]
  exact ⟨hpg, hzero, hcard⟩

/-- The prime-to-`p` part of `e` is coprime to the `p`-part, in characteristic `p`. -/
private theorem coprime_ordCompl_ordProj {F : Type*} [Field F] (p : ℕ) [CharP F p] {e : ℕ}
    (he : e ≠ 0) : (e / p ^ e.factorization p).Coprime (p ^ e.factorization p) := by
  by_cases hp : p = 0
  · simp [hp]
  · have hpp := (CharP.char_is_prime_or_zero F p).resolve_right hp
    exact (Nat.coprime_ordCompl hpp he).symm.pow_right _

private theorem not_mem_span_singleton_sq {R : Type*} [CommRing R] [IsDomain R] {π : R}
    (hπ : Prime π) : π ∉ Ideal.span {π} ^ 2 := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  rintro ⟨y, hy⟩
  apply hπ.not_isUnit
  refine IsUnit.of_mul_eq_one y (mul_left_cancel₀ hπ.ne_zero ?_)
  linear_combination -hy

private theorem eq_of_pow_mul_eq_pow_mul {R : Type*} [CommRing R] [IsDomain R] {π a b : R}
    (hπ : Prime π) {m n : ℕ} (ha : ¬ π ∣ a) (hb : ¬ π ∣ b) (h : π ^ m * a = π ^ n * b) :
    m = n := by
  have key : ∀ {m n : ℕ} {a b : R}, ¬ π ∣ a → π ^ m * a = π ^ n * b → m < n → False := by
    intro m n a b ha h hmn
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hmn
    apply ha
    refine ⟨π ^ k * b, mul_left_cancel₀ (pow_ne_zero m hπ.ne_zero) ?_⟩
    rw [h]
    ring
  rcases Nat.lt_trichotomy m n with hmn | hmn | hmn
  · exact (key ha h hmn).elim
  · exact hmn
  · exact (key hb h.symm hmn).elim

/-- If `f(π) = π' ^ j * u` with `u` fixed modulo `r` by `s`, if `s(π') = π' * c₀`, and if
`t(π) ≡ b * π` modulo `π²` with `f ∘ t = s ∘ f` at `π`, then `f(b) ≡ c₀ ^ j` modulo `r`. -/
private theorem mk_eq_pow_of_uniformizer_eq_pow_mul
    {B C : Type*} [CommRing B] [CommRing C] [IsDomain C]
    (f : B →+* C) (s : C →+* C) (t : B → B) (r : Ideal C) [r.IsPrime]
    {π b y : B} {π' u c₀ : C} {j : ℕ} (hj : 0 < j) (hπ' : π' ≠ 0) (hπ'r : π' ∈ r)
    (hu : u ∉ r) (hsu : s u - u ∈ r) (hfπ : f π = π' ^ j * u)
    (hc₀ : s π' = π' * c₀) (hy : t π - b * π = π ^ 2 * y) (ht : f (t π) = s (f π)) :
    Ideal.Quotient.mk r (f b) = Ideal.Quotient.mk r c₀ ^ j := by
  have hfy := congrArg f hy
  simp only [map_sub, map_mul, map_pow, ht, hfπ, hc₀] at hfy
  have hcancel : c₀ ^ j * s u - f b * u = π' ^ j * (u ^ 2 * f y) := by
    apply mul_left_cancel₀ (pow_ne_zero j hπ')
    linear_combination hfy
  have hmem : c₀ ^ j * s u - f b * u ∈ r := by
    rw [hcancel]
    exact r.mul_mem_right _ (r.pow_mem_of_mem hπ'r j hj)
  have hq := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
  have hsu' : Ideal.Quotient.mk r (s u) = Ideal.Quotient.mk r u :=
    Ideal.Quotient.eq.mpr hsu
  have hu' : Ideal.Quotient.mk r u ≠ 0 := fun h ↦ hu (Ideal.Quotient.eq_zero_iff_mem.mp h)
  simp only [map_sub, map_mul, map_pow, hsu'] at hq
  apply mul_right_cancel₀ hu'
  linear_combination -hq

/-- The image of a normal `p`-subgroup of prime-to-`p` index under a surjection is any normal
`p`-subgroup containing it. -/
private theorem map_eq_of_isPGroup_of_not_dvd_index
    {G H : Type*} [Group G] [Group H] [Finite G] {f : G →* H} (hf : Function.Surjective f)
    {p : ℕ} [Fact p.Prime] {W' : Subgroup G} {W : Subgroup H} [W.Normal]
    (hW' : IsPGroup p W') (hidx : ¬ p ∣ W'.index) (hW : IsPGroup p W)
    (hle : W'.map f ≤ W) : W'.map f = W := by
  refine le_antisymm hle ?_
  simpa using hW.le_sylow_of_normal (Sylow.mapSurjective hf (hW'.toSylow hidx))

private theorem exists_monoidHom_comp_eq_of_range_le {G H G' : Type*} [Group G] [Group H]
    [Group G'] {ι : G →* H} (hι : Function.Injective ι) (φ : G' →* H) (h : φ.range ≤ ι.range) :
    ∃ ψ : G' →* G, ∀ x, ι (ψ x) = φ x :=
  ⟨(MonoidHom.ofInjective hι).symm.toMonoidHom.comp
      (φ.codRestrict ι.range (fun x ↦ h ⟨x, rfl⟩)),
    fun x ↦ by
      change ((MonoidHom.ofInjective hι ((MonoidHom.ofInjective hι).symm
        ⟨φ x, h ⟨x, rfl⟩⟩) : ι.range) : H) = φ x
      rw [MulEquiv.apply_symm_apply]⟩

/-- A homomorphism restricted to a subgroup is surjective onto the image subgroup. -/
private theorem surjective_codRestrict_subtype_of_map_eq {G H : Type*} [Group G] [Group H]
    (f : G →* H) {S : Subgroup G} {T : Subgroup H} (h : S.map f = T) (hf : ∀ x : S, f x ∈ T) :
    Function.Surjective ((f.comp S.subtype).codRestrict T hf) := by
  rintro ⟨y, hy⟩
  obtain ⟨x, hx, rfl⟩ := h ▸ hy
  exact ⟨⟨x, hx⟩, rfl⟩

end Tower

set_option maxHeartbeats 2000000 in
-- The residue-field and inertia-character bookkeeping elaborates many instance chains.
/-- **Stacks Project, Tag 0BU7.** In a tower of finite Galois extensions of the fraction field
of a discrete valuation ring, restriction surjects on decomposition, inertia, and wild inertia
groups.  The induced maps commute with residue-field automorphisms and with the canonical inertia
characters; on roots of unity the latter vertical map is the `e' / e`-power map. -/
@[stacks 0BU7]
theorem surjective_restrictions_commute_with_residue_and_inertiaCharacter
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] [Algebra A L] [IsScalarTower A K L]
    (M : Type*) [Field M] [Algebra K M] [FiniteDimensional K M]
    [IsGalois K M] [Algebra L M] [IsScalarTower K L M]
    [Algebra A M] [IsScalarTower A K M] [IsScalarTower A L M]
    (r : Ideal (integralClosure A M)) [r.IsMaximal] :
    let B := integralClosure A L
    let C := integralClosure A M
    let fBC : B →ₐ[A] C := (IsScalarTower.toAlgHom A L M).mapIntegralClosure
    letI : Algebra B C := fBC.toRingHom.toAlgebra
    letI : IsScalarTower A B C :=
      IsScalarTower.of_algebraMap_eq fun x ↦ (fBC.commutes x).symm
    letI : Algebra.IsIntegral B C :=
      ⟨fun x ↦ IsIntegral.tower_top (IsIntegralClosure.isIntegral A M x)⟩
    letI : MulSemiringAction Gal(M/K) C :=
      IsIntegralClosure.MulSemiringAction A K M C
    letI : MulSemiringAction Gal(L/K) B :=
      IsIntegralClosure.MulSemiringAction A K L B
    let q := r.under B
    let p := r.under A
    letI : r.LiesOver q := ⟨rfl⟩
    letI : q.LiesOver p := ⟨r.under_under.symm⟩
    letI : Field (A ⧸ p) := Ideal.Quotient.field p
    letI : Field (B ⧸ q) := Ideal.Quotient.field q
    letI : Field (C ⧸ r) := Ideal.Quotient.field r
    letI : Algebra (B ⧸ q) (C ⧸ r) := Ideal.Quotient.algebraOfLiesOver r q
    letI : Algebra (A ⧸ p) (B ⧸ q) := Ideal.Quotient.algebraOfLiesOver q p
    letI : Algebra (A ⧸ p) (C ⧸ r) := Ideal.Quotient.algebraOfLiesOver r p
    let res : Gal(M/K) →* Gal(L/K) := AlgEquiv.restrictNormalHom L
    let D' := MulAction.stabilizer Gal(M/K) r
    let D := MulAction.stabilizer Gal(L/K) q
    let e' := r.ramificationIdx A
    let e := q.ramificationIdx A
    ∃ (resD : D' →* D)
      (resI : r.inertia Gal(M/K) →* q.inertia Gal(L/K))
      (resP : wildInertiaGroup A K M r →*
        wildInertiaGroup A K L q),
      Function.Surjective resD ∧ Function.Surjective resI ∧ Function.Surjective resP ∧
      (∀ σ, ((resD σ : D) : Gal(L/K)) = res ((σ : D') : Gal(M/K))) ∧
      (∀ σ, (resI σ).1 = res σ.1) ∧
      (∀ σ, (resP σ).1.1 = res σ.1.1) ∧
      e ∣ e' ∧
      ∃ (residueRestriction : Gal((C ⧸ r)/(A ⧸ p)) →* Gal((B ⧸ q)/(A ⧸ p)))
        (rootRestriction : rootsOfUnity e' (C ⧸ r) →* rootsOfUnity e (B ⧸ q)),
        (∀ τ b, algebraMap (B ⧸ q) (C ⧸ r) (residueRestriction τ b) =
          τ (algebraMap (B ⧸ q) (C ⧸ r) b)) ∧
        (∀ ζ, algebraMap (B ⧸ q) (C ⧸ r) (rootRestriction ζ).1.1 =
          (ζ ^ (e' / e)).1.1) ∧
        (∀ σ b, algebraMap (B ⧸ q) (C ⧸ r)
            (Ideal.Quotient.mk q ((resD σ).1 • b)) =
          Ideal.Quotient.mk r (σ.1 • fBC b)) ∧
        ∀ σ, rootRestriction (inertiaCharacter A K M r σ) =
          inertiaCharacter A K L q (resI σ) := by
  dsimp only
  let B := integralClosure A L
  let C := integralClosure A M
  let fBC : B →ₐ[A] C := (IsScalarTower.toAlgHom A L M).mapIntegralClosure
  let : Algebra B C := fBC.toRingHom.toAlgebra
  let : IsScalarTower A B C :=
    IsScalarTower.of_algebraMap_eq fun x ↦ (fBC.commutes x).symm
  let : IsScalarTower B C M :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let : Algebra.IsIntegral B C :=
    ⟨fun x ↦ IsIntegral.tower_top (IsIntegralClosure.isIntegral A M x)⟩
  let : IsFractionRing B L :=
    IsIntegralClosure.isFractionRing_of_finite_extension A K L B
  let : IsFractionRing C M :=
    IsIntegralClosure.isFractionRing_of_finite_extension A K M C
  let : MulSemiringAction Gal(M/K) C :=
    IsIntegralClosure.MulSemiringAction A K M C
  let : MulSemiringAction Gal(L/K) B :=
    IsIntegralClosure.MulSemiringAction A K L B
  let q := r.under B
  let p := r.under A
  let : r.LiesOver q := ⟨rfl⟩
  let : q.LiesOver p := ⟨r.under_under.symm⟩
  let : Field (A ⧸ p) := Ideal.Quotient.field p
  let : Field (B ⧸ q) := Ideal.Quotient.field q
  let : Field (C ⧸ r) := Ideal.Quotient.field r
  let : Algebra (B ⧸ q) (C ⧸ r) := Ideal.Quotient.algebraOfLiesOver r q
  let : Algebra (A ⧸ p) (B ⧸ q) := Ideal.Quotient.algebraOfLiesOver q p
  let : Algebra (A ⧸ p) (C ⧸ r) := Ideal.Quotient.algebraOfLiesOver r p
  let res : Gal(M/K) →* Gal(L/K) := AlgEquiv.restrictNormalHom L
  have hBSX :=
    IsIntegralClosure.image_stabilizer_and_inertia_restrictNormalHom A K L M B C r
  let D' := MulAction.stabilizer Gal(M/K) r
  let D := MulAction.stabilizer Gal(L/K) q
  have hD : D'.map res = D := SetLike.coe_injective (by simpa [res, D, D', q] using hBSX.1)
  have hI : (r.inertia Gal(M/K)).map res = q.inertia Gal(L/K) :=
    SetLike.coe_injective (by simpa [res, q] using hBSX.2)
  let resD : D' →* D := (res.comp D'.subtype).codRestrict D (fun σ ↦ hD.le ⟨σ, σ.2, rfl⟩)
  let resI : r.inertia Gal(M/K) →* q.inertia Gal(L/K) :=
    (res.comp (r.inertia Gal(M/K)).subtype).codRestrict (q.inertia Gal(L/K))
      (fun σ ↦ hI.le ⟨σ, σ.2, rfl⟩)
  have hresD : Function.Surjective resD := surjective_codRestrict_subtype_of_map_eq res hD _
  have hresI : Function.Surjective resI := surjective_codRestrict_subtype_of_map_eq res hI _
  have hcompat (g : Gal(M/K)) (x : B) : fBC (res g • x) = g • fBC x := by
    apply Subtype.ext
    change algebraMap L M (algebraMap B L (galRestrict A K L B (res g) x)) =
      algebraMap C M (galRestrict A K M C g (fBC x))
    rw [algebraMap_galRestrict_apply A, algebraMap_galRestrict_apply A]
    exact AlgEquiv.restrictNormal_commutes g L _
  have hfBC_inj : Function.Injective fBC := fun x y h ↦
    Subtype.ext ((algebraMap L M).injective (congrArg Subtype.val h))
  have hmemq (x : B) : x ∈ q ↔ fBC x ∈ r := Iff.rfl
  have : q.IsMaximal := Ideal.IsMaximal.under B r
  let : Module.Finite A B := IsIntegralClosure.finite A K L B
  obtain ⟨ρ, hρ⟩ := IsDiscreteValuationRing.exists_irreducible A
  obtain ⟨π, hπ, hqπ, uB, huB, huBπ⟩ :=
    exists_prime_eq_span_and_eq_pow_ramificationIdx_mul A K L q hρ
  obtain ⟨π', hπ', hrπ', uC, huC, huCπ'⟩ :=
    exists_prime_eq_span_and_eq_pow_ramificationIdx_mul A K M r hρ
  have hdvdr (x : C) : π' ∣ x ↔ x ∈ r := by rw [hrπ', Ideal.mem_span_singleton]
  have hπq : π ∈ q := hqπ ▸ Ideal.mem_span_singleton_self π
  have hπ'r : π' ∈ r := hrπ' ▸ Ideal.mem_span_singleton_self π'
  have hπr : fBC π ∈ r := (hmemq π).mp hπq
  have hfπ0 : fBC π ≠ 0 := fun h ↦ hπ.ne_zero (hfBC_inj (h.trans (map_zero fBC).symm))
  let : IsDedekindDomain C := IsIntegralClosure.isDedekindDomain A K M C
  have hfin := FiniteMultiplicity.of_prime_left hπ' hfπ0
  obtain ⟨v, hv, hvπ'⟩ := hfin.exists_eq_pow_mul_and_not_dvd
  set j := multiplicity π' (fBC π) with hjdef
  have hj : 0 < j := by
    rcases Nat.eq_zero_or_pos j with h | h
    · rw [h, pow_zero, one_mul] at hv
      exact (hvπ' ((hdvdr v).mpr (hv ▸ hπr))).elim
    · exact h
  have hvr : v ∉ r := fun h ↦ hvπ' ((hdvdr v).mpr h)
  have huBr : ¬ π' ∣ fBC uB := fun h ↦ huBπ (by
    rw [← Ideal.mem_span_singleton, ← hqπ]
    exact (hmemq uB).mpr ((hdvdr _).mp h))
  have hρC : algebraMap A C ρ =
      π' ^ (j * q.ramificationIdx A) * (v ^ q.ramificationIdx A * fBC uB) := by
    rw [← fBC.commutes ρ, huB, map_mul, map_pow, hv]
    ring
  have he' : r.ramificationIdx A = j * q.ramificationIdx A :=
    eq_of_pow_mul_eq_pow_mul hπ' huCπ'
      (fun h ↦ (hπ'.dvd_or_dvd h).elim (fun h ↦ hvπ' (hπ'.dvd_of_dvd_pow h)) huBr)
      (huC.symm.trans hρC)
  have : IsNoetherianRing B := (IsIntegralClosure.isDedekindDomain A K L B).toIsNoetherian
  have : IsNoetherianRing (Localization.AtPrime q ⧸
      (q.under A).map (algebraMap A (Localization.AtPrime q))) :=
    Ideal.Quotient.isNoetherianRing _
  have hepos : 0 < q.ramificationIdx A := Ideal.ramificationIdx_pos A q
  have he'pos : 0 < r.ramificationIdx A := he' ▸ Nat.mul_pos hj hepos
  have hdiv : r.ramificationIdx A / q.ramificationIdx A = j := by
    rw [he', Nat.mul_div_cancel j hepos]
  let θ' := inertiaCharacter A K M r
  let θ := inertiaCharacter A K L q
  have hθ'c := inertiaCharacter_characterizes A K M r
  have hθc := inertiaCharacter_characterizes A K L q
  have hθ'surj : Function.Surjective θ' := (inertiaCharacterData A K M r).surjective
  have hkey (σ : r.inertia Gal(M/K)) :
      algebraMap (B ⧸ q) (C ⧸ r) (θ (resI σ)).1.1 = (θ' σ).1.1 ^ j := by
    obtain ⟨a', ha'⟩ := Ideal.Quotient.mk_surjective (θ' σ).1.1
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (θ (resI σ)).1.1
    have h1 := hθ'c σ π' a' hπ'r (hrπ' ▸ not_mem_span_singleton_sq hπ') ha'
    have h2 := hθc (resI σ) π b hπq (hqπ ▸ not_mem_span_singleton_sq hπ) hb
    have h1' : π' ^ 2 ∣ (σ : Gal(M/K)) • π' - a' * π' := by
      rw [← Ideal.mem_span_singleton, ← Ideal.span_singleton_pow, ← hrπ']
      exact h1
    have h2' : π ^ 2 ∣ ((resI σ) : Gal(L/K)) • π - b * π := by
      rw [← Ideal.mem_span_singleton, ← Ideal.span_singleton_pow, ← hqπ]
      exact h2
    obtain ⟨y', hy'⟩ := h1'
    obtain ⟨y, hy⟩ := h2'
    have hc₀ : (σ : Gal(M/K)) • π' = π' * (a' + π' * y') := by linear_combination hy'
    have hmain := mk_eq_pow_of_uniformizer_eq_pow_mul fBC.toRingHom
      (MulSemiringAction.toRingHom _ C (σ : Gal(M/K))) (fun x ↦ ((resI σ) : Gal(L/K)) • x) r
      hj hπ'.ne_zero hπ'r hvr (σ.2 v) hv hc₀ hy (hcompat σ π)
    have hshift : Ideal.Quotient.mk r (a' + π' * y') = Ideal.Quotient.mk r a' := by
      rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr (r.mul_mem_right y' hπ'r), add_zero]
    rw [← hb, ← ha', Ideal.Quotient.algebraMap_mk_of_liesOver, ← hshift]
    exact hmain
  let ι : rootsOfUnity (q.ramificationIdx A) (B ⧸ q) →* (C ⧸ r)ˣ :=
    (Units.map (algebraMap (B ⧸ q) (C ⧸ r)).toMonoidHom).comp
      (rootsOfUnity (q.ramificationIdx A) (B ⧸ q)).subtype
  have hι : Function.Injective ι :=
    (Units.map_injective (algebraMap (B ⧸ q) (C ⧸ r)).injective).comp Subtype.val_injective
  let φ : rootsOfUnity (r.ramificationIdx A) (C ⧸ r) →* (C ⧸ r)ˣ :=
    (rootsOfUnity (r.ramificationIdx A) (C ⧸ r)).subtype.comp (powMonoidHom j)
  have hιθ (σ : r.inertia Gal(M/K)) : ι (θ (resI σ)) = φ (θ' σ) := by
    apply Units.ext
    simpa [ι, φ] using hkey σ
  have hrange : φ.range ≤ ι.range := by
    rintro _ ⟨ζ, rfl⟩
    obtain ⟨σ, rfl⟩ := hθ'surj ζ
    exact ⟨_, hιθ σ⟩
  obtain ⟨ψ, hψ⟩ := exists_monoidHom_comp_eq_of_range_le hι φ hrange
  let W' := wildInertiaGroup A K M r
  let W := wildInertiaGroup A K L q
  have : W.Normal := wildInertiaGroup_normal A K L q
  have hW'ker : W' = θ'.ker := wildInertiaGroup_eq_ker_inertiaCharacter A K M r
  have hWker : W = θ.ker := wildInertiaGroup_eq_ker_inertiaCharacter A K L q
  have hle : W'.map resI ≤ W := by
    rintro _ ⟨σ, hσ, rfl⟩
    have hσ' : θ' σ = 1 := by
      rw [← MonoidHom.mem_ker, ← hW'ker]
      exact hσ
    change _ ∈ wildInertiaGroup A K L q
    rw [wildInertiaGroup_eq_ker_inertiaCharacter, MonoidHom.mem_ker]
    apply hι
    rw [hιθ, hσ', map_one, map_one]
  have hmap : W'.map resI = W := by
    have hM := wildInertiaGroup_isPGroup_and_card_rootsOfUnity A K M r
    have hL := wildInertiaGroup_isPGroup_and_card_rootsOfUnity A K L q
    dsimp only at hM hL
    obtain ⟨hpg', -, hcard'⟩ := hM
    obtain ⟨hpg, hz, -⟩ := hL
    have := ringChar.charP (IsLocalRing.ResidueField A)
    rcases CharP.char_is_prime_or_zero (IsLocalRing.ResidueField A)
      (ringChar (IsLocalRing.ResidueField A)) with hp | hp
    · have := Fact.mk hp
      refine map_eq_of_isPGroup_of_not_dvd_index hresI (hpg' hp.pos) ?_ (hpg hp.pos) hle
      rw [hW'ker, Subgroup.index_ker, MonoidHom.range_eq_top.mpr hθ'surj, Subgroup.card_top,
        hcard']
      exact Nat.not_dvd_ordCompl hp he'pos.ne'
    · refine le_antisymm hle ?_
      change wildInertiaGroup A K L q ≤ _
      rw [hz hp]
      exact bot_le
  let resP : W' →* W := (resI.comp W'.subtype).codRestrict W (fun σ ↦ hle ⟨σ, σ.2, rfl⟩)
  have hresP : Function.Surjective resP := surjective_codRestrict_subtype_of_map_eq resI hmap _
  have htowerAlg : algebraMap (A ⧸ p) (C ⧸ r) =
      (algebraMap (B ⧸ q) (C ⧸ r)).comp (algebraMap (A ⧸ p) (B ⧸ q)) := by
    refine Ideal.Quotient.ringHom_ext (RingHom.ext fun a ↦ ?_)
    simp only [RingHom.comp_apply]
    rw [Ideal.Quotient.algebraMap_mk_of_liesOver, Ideal.Quotient.algebraMap_mk_of_liesOver,
      Ideal.Quotient.algebraMap_mk_of_liesOver, IsScalarTower.algebraMap_apply A B C]
  have : @IsScalarTower (A ⧸ p) (integralClosure A L ⧸ q) (integralClosure A M ⧸ r)
      (Algebra.toSMul) (Algebra.toSMul) (Algebra.toSMul) :=
    IsScalarTower.of_algebraMap_eq' htowerAlg
  have : p.IsMaximal := Ideal.IsMaximal.under A r
  let : IsGaloisGroup Gal(L/K) A B := IsGaloisGroup.of_isFractionRing _ _ _ K L
  have : Normal (A ⧸ p) (B ⧸ q) := Ideal.Quotient.normal Gal(L/K) p q
  refine ⟨resD, resI, resP, hresD, hresI, hresP, fun _ ↦ rfl, fun _ ↦ rfl, fun _ ↦ rfl,
    ⟨j, by rw [he', mul_comm]⟩, AlgEquiv.restrictNormalHom (B ⧸ q), ψ,
    fun τ b ↦ AlgEquiv.restrictNormal_commutes τ (B ⧸ q) b, fun ζ ↦ ?_, fun σ b ↦ ?_,
    fun σ ↦ hι ?_⟩
  · rw [hdiv]
    exact congrArg Units.val (hψ ζ)
  · rw [Ideal.Quotient.algebraMap_mk_of_liesOver]
    exact congrArg (Ideal.Quotient.mk r) (hcompat σ.1 b)
  · rw [hψ, hιθ]


/-- In a domain of characteristic `p`, the `e`-th roots of unity are the roots of unity of the
prime-to-`p` part of `e`. -/
theorem rootsOfUnity_eq_rootsOfUnity_ordCompl {F : Type*} [CommRing F] [IsDomain F] (p : ℕ)
    [CharP F p] (e : ℕ) : rootsOfUnity e F = rootsOfUnity (e / p ^ e.factorization p) F := by
  by_cases hp : p = 0
  · subst hp
    simp only [Nat.factorization_zero_right, pow_zero, Nat.div_one]
  · have : Fact p.Prime := ⟨(CharP.char_is_prime_or_zero F p).resolve_right hp⟩
    ext ζ
    have h := ExpChar.pow_prime_pow_mul_eq_one_iff (R := F) p (e.factorization p)
      (e / p ^ e.factorization p) (ζ : F)
    rwa [Nat.ordProj_mul_ordCompl_eq_self, ← mem_rootsOfUnity', ← mem_rootsOfUnity'] at h

section CanonicalInertiaCharacter

noncomputable section

variable
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] [Algebra A L] [IsScalarTower A K L]
    (P : Ideal (integralClosure A L)) [P.IsMaximal]

/-- The action of `Gal(L/K)` on the integral closure of `A` in `L` by ring automorphisms. -/
noncomputable local instance : MulSemiringAction Gal(L/K) (integralClosure A L) :=
  IsIntegralClosure.MulSemiringAction A K L (integralClosure A L)

/-- The residue-characteristic-primary factor of the ramification index. -/
abbrev wildRamificationFactor : ℕ :=
  ringChar (IsLocalRing.ResidueField A) ^
    (P.ramificationIdx A).factorization (ringChar (IsLocalRing.ResidueField A))

/-- The prime-to-residue-characteristic part of the ramification index. -/
abbrev tameRamificationIndex : ℕ :=
  P.ramificationIdx A / wildRamificationFactor A L P

/-- **Stacks Project, Tag 0BU8.** The canonical inertia character, obtained by raising the
ordinary inertia character to the residue-characteristic-primary part of the ramification
index. -/
@[stacks 0BU8]
noncomputable def canonicalInertiaCharacter :
    P.inertia Gal(L/K) →*
      rootsOfUnity (tameRamificationIndex A L P) (integralClosure A L ⧸ P) where
  toFun σ := ⟨(inertiaCharacter A K L P σ :
      (integralClosure A L ⧸ P)ˣ) ^ wildRamificationFactor A L P, by
    rw [mem_rootsOfUnity, ← pow_mul,
      Nat.ordProj_mul_ordCompl_eq_self,
      (inertiaCharacter A K L P σ).property]⟩
  map_one' := by simp
  map_mul' σ τ := by
    ext
    simp [mul_pow]

/-- The canonical inertia character is pointwise the wild-factor power of the ordinary inertia
character. -/
theorem canonicalInertiaCharacter_coe (σ : P.inertia Gal(L/K)) :
    ((canonicalInertiaCharacter A K L P σ :
      rootsOfUnity (tameRamificationIndex A L P) (integralClosure A L ⧸ P)) :
        (integralClosure A L ⧸ P)ˣ) =
      (inertiaCharacter A K L P σ :
        (integralClosure A L ⧸ P)ˣ) ^ wildRamificationFactor A L P :=
  rfl

set_option maxHeartbeats 800000 in
-- Elaborating the tower requires comparing several compatible algebra structures.
set_option synthInstance.maxHeartbeats 100000 in
-- Residue-field instances involve the integral-closure tower and its contractions.
/-- **Stacks Project, Tag 0BU8.** The scaled inertia character identifies tame inertia with the
roots of unity of order `|I_t|`.  Its order is the prime-to-residue-characteristic part of the
ramification index, it is equivariant under the decomposition group, and these canonical
characters form the stated power-map square in every finite Galois tower. -/
@[stacks 0BU8, sga "7 I 0.3" "finite Galois case"]
theorem canonicalInertiaCharacter_spec :
    let B := integralClosure A L
    letI := IsIntegralClosure.MulSemiringAction A K L B
    let D := MulAction.stabilizer Gal(L/K) P
    let I := P.inertia Gal(L/K)
    let e := P.ramificationIdx A
    let p := ringChar (IsLocalRing.ResidueField A)
    let q := wildRamificationFactor A L P
    let n := tameRamificationIndex A L P
    let conjugate : D → I → I := fun τ σ ↦
      ⟨(τ : Gal(L/K)) * (σ : Gal(L/K)) * (τ : Gal(L/K))⁻¹, by
        rw [Ideal.mem_inertia]
        intro x
        have hσ := (Ideal.mem_inertia.mp σ.property) ((τ : Gal(L/K))⁻¹ • x)
        have hτ := Ideal.smul_mem_pointwise_smul (τ : Gal(L/K)) _ P hσ
        rw [τ.property] at hτ
        simpa only [mul_smul, smul_sub, smul_inv_smul] using hτ⟩
    e = q * n ∧
    (p = 0 → q = 1) ∧
    (0 < p → ∃ a : ℕ, q = p ^ a) ∧
    rootsOfUnity e (B ⧸ P) = rootsOfUnity n (B ⧸ P) ∧
    Nat.card (tameInertiaGroup A K L P) = n ∧
    ∃ θcan : tameInertiaGroup A K L P ≃* rootsOfUnity n (B ⧸ P),
      (∀ σ : I, θcan (tameInertiaMap A K L P σ) =
        canonicalInertiaCharacter A K L P σ) ∧
      (∀ (τ : D) (σ : I),
        canonicalInertiaCharacter A K L P (conjugate τ σ) =
          (Ideal.quotientEquiv P P
            ((MulSemiringAction.toRingEquiv Gal(L/K) B) (τ : Gal(L/K)))
            τ.property.symm).toMulEquiv.restrictRootsOfUnity n
              (canonicalInertiaCharacter A K L P σ)) ∧
      ∀ (M : Type*) [Field M] [Algebra K M] [FiniteDimensional K M]
        [IsGalois K M] [Algebra L M] [IsScalarTower K L M]
        [Algebra A M] [IsScalarTower A K M] [IsScalarTower A L M]
        (r : Ideal (integralClosure A M)) [r.IsMaximal],
        let C := integralClosure A M
        let fBC : B →ₐ[A] C := (IsScalarTower.toAlgHom A L M).mapIntegralClosure
        letI : Algebra B C := fBC.toRingHom.toAlgebra
        letI : IsScalarTower A B C :=
          IsScalarTower.of_algebraMap_eq fun x ↦ (fBC.commutes x).symm
        letI : Algebra.IsIntegral B C :=
          ⟨fun x ↦ IsIntegral.tower_top (IsIntegralClosure.isIntegral A M x)⟩
        letI : MulSemiringAction Gal(M/K) C :=
          IsIntegralClosure.MulSemiringAction A K M C
        let Q := r.under B
        let pA := r.under A
        letI : r.LiesOver Q := ⟨rfl⟩
        letI : Q.LiesOver pA := ⟨r.under_under.symm⟩
        letI : Field (A ⧸ pA) := Ideal.Quotient.field pA
        letI : Field (B ⧸ Q) := Ideal.Quotient.field Q
        letI : Field (C ⧸ r) := Ideal.Quotient.field r
        letI : Algebra (B ⧸ Q) (C ⧸ r) := Ideal.Quotient.algebraOfLiesOver r Q
        let _e' := r.ramificationIdx A
        let n' := tameRamificationIndex A M r
        let n := tameRamificationIndex A L Q
        let res : Gal(M/K) →* Gal(L/K) := AlgEquiv.restrictNormalHom L
        ∃ (resI : r.inertia Gal(M/K) →* Q.inertia Gal(L/K))
          (rootRestriction : rootsOfUnity n' (C ⧸ r) →* rootsOfUnity n (B ⧸ Q)),
          (∀ σ, (resI σ).1 = res σ.1) ∧
          n ∣ n' ∧
          (∀ ζ, algebraMap (B ⧸ Q) (C ⧸ r) (rootRestriction ζ).1.1 =
            (ζ ^ (n' / n)).1.1) ∧
          ∀ σ, rootRestriction (canonicalInertiaCharacter A K M r σ) =
            canonicalInertiaCharacter A K L Q (resI σ) := by
  dsimp only
  let e := P.ramificationIdx A
  let p := ringChar (IsLocalRing.ResidueField A)
  let q := wildRamificationFactor A L P
  let n := tameRamificationIndex A L P
  have := charP_integralClosure_quotient A K L P
  have : Module.Finite A (integralClosure A L) := IsIntegralClosure.finite A K L _
  have he : e ≠ 0 := (Ideal.ramificationIdx_pos A P).ne'
  have heqn : e = q * n := (Nat.ordProj_mul_ordCompl_eq_self e p).symm
  have hq_zero : p = 0 → q = 1 := fun hp ↦ Nat.ordProj_of_not_prime e p (hp ▸ Nat.not_prime_zero)
  have hq_pos : 0 < p → ∃ a : ℕ, q = p ^ a := fun _ ↦ ⟨e.factorization p, rfl⟩
  have hroots : rootsOfUnity e (integralClosure A L ⧸ P) =
      rootsOfUnity n (integralClosure A L ⧸ P) :=
    rootsOfUnity_eq_rootsOfUnity_ordCompl p e
  obtain ⟨W, hW, hnormal, hdescI, hdesc, hpgroup, htrivial, hdescSep, θ, hinj, hexact, hsurj,
    hcyclic, hcardRootsE, hchar, hunique⟩ :=
    exists_wildInertia_exact_and_tameInertia_equiv_rootsOfUnity A K L P
  have hcardRootsN : Nat.card (rootsOfUnity n (integralClosure A L ⧸ P)) = n := by
    rwa [← hroots]
  have hcard : Nat.card (tameInertiaGroup A K L P) = n := by
    rw [Nat.card_congr (tameInertiaEquivRootsOfUnity A K L P).toEquiv, hroots, hcardRootsN]
  have hnq : n.Coprime q :=
    coprime_ordCompl_ordProj (F := IsLocalRing.ResidueField A) p he
  let powerEquiv : rootsOfUnity n (integralClosure A L ⧸ P) ≃*
      rootsOfUnity n (integralClosure A L ⧸ P) :=
    MulEquiv.ofBijective (powMonoidHom q) (by
      apply Nat.Coprime.pow_left_bijective
      rwa [hcardRootsN])
  let changeRoots := MulEquiv.subgroupCongr hroots
  let θcan := (tameInertiaEquivRootsOfUnity A K L P).trans
    (changeRoots.trans powerEquiv)
  refine ⟨heqn, hq_zero, hq_pos, hroots, hcard, θcan, ?_, ?_, ?_⟩
  · intro σ
    apply Subtype.ext
    change (inertiaCharacter A K L P σ :
      (integralClosure A L ⧸ P)ˣ) ^ q = _
    rfl
  · intro τ σ
    apply rootsOfUnity.coe_injective
    have hconj := inertiaCharacter_conj A K L P
      (inertiaCharacter A K L P)
      (inertiaCharacter_characterizes A K L P) τ σ
    have hpw := congrArg (fun z : rootsOfUnity e (integralClosure A L ⧸ P) ↦
      ((z : (integralClosure A L ⧸ P)ˣ) ^ q)) hconj
    simpa only [canonicalInertiaCharacter_coe, Units.val_pow_eq_pow_val,
      MulEquiv.restrictRootsOfUnity_coe_apply, map_pow] using congrArg Units.val hpw
  · intro M _ _ _ _ _ _ _ _ _ r _
    let fBC : integralClosure A L →ₐ[A] integralClosure A M :=
      (IsScalarTower.toAlgHom A L M).mapIntegralClosure
    let : Algebra (integralClosure A L) (integralClosure A M) :=
      fBC.toRingHom.toAlgebra
    let : IsScalarTower A (integralClosure A L) (integralClosure A M) :=
      IsScalarTower.of_algebraMap_eq fun x ↦ (fBC.commutes x).symm
    let : Algebra.IsIntegral (integralClosure A L) (integralClosure A M) :=
      ⟨fun x ↦ IsIntegral.tower_top (IsIntegralClosure.isIntegral A M x)⟩
    obtain ⟨resD, resI, resP, hresDsurj, hresIsurj, hresPsurj,
      hresD, hresI, hresP, hediv, residueRestriction, rootRestriction,
      hresidue, hroot, haction, hcharTower⟩ :=
      surjective_restrictions_commute_with_residue_and_inertiaCharacter
        A K L M r
    let eL := (r.under (integralClosure A L)).ramificationIdx A
    let eM := r.ramificationIdx A
    let qL := wildRamificationFactor A L (r.under (integralClosure A L))
    let qM := wildRamificationFactor A M r
    let nL := tameRamificationIndex A L (r.under (integralClosure A L))
    let nM := tameRamificationIndex A M r
    have hnDiv : nL ∣ nM :=
      Nat.ordCompl_dvd_ordCompl_of_dvd hediv
        (ringChar (IsLocalRing.ResidueField A))
    have : Module.Finite A (integralClosure A M) := IsIntegralClosure.finite A K M _
    have heMne : eM ≠ 0 := (Ideal.ramificationIdx_pos A r).ne'
    have hqDiv : qL ∣ qM := Nat.ordProj_dvd_ordProj_of_dvd heMne hediv _
    let c := qM / qL
    have hqLne : qL ≠ 0 := by
      intro h
      have : eM = 0 := by
        rw [show eM = qM * nM from (Nat.ordProj_mul_ordCompl_eq_self eM _).symm]
        rcases hqDiv with ⟨d, hd⟩
        rw [hd, h, zero_mul, zero_mul]
      exact heMne this
    have hqeq : qM = qL * c := (Nat.mul_div_cancel' hqDiv).symm
    have hnMc : nM.Coprime c :=
      Nat.Coprime.of_dvd_right (Nat.div_dvd_of_dvd hqDiv)
        (coprime_ordCompl_ordProj (F := IsLocalRing.ResidueField A) _ heMne)
    have := charP_integralClosure_quotient A K M r
    have hrootsM : rootsOfUnity eM (integralClosure A M ⧸ r) =
        rootsOfUnity nM (integralClosure A M ⧸ r) :=
      rootsOfUnity_eq_rootsOfUnity_ordCompl (ringChar (IsLocalRing.ResidueField A)) eM
    let powerC : rootsOfUnity nM (integralClosure A M ⧸ r) ≃*
        rootsOfUnity nM (integralClosure A M ⧸ r) :=
      MulEquiv.ofBijective (powMonoidHom c) (by
        apply Nat.Coprime.pow_left_bijective
        obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hcard, _, _⟩ :=
          exists_wildInertia_exact_and_tameInertia_equiv_rootsOfUnity A K M r
        rwa [← hrootsM, show Nat.card (rootsOfUnity eM (integralClosure A M ⧸ r)) = nM from hcard])
    have := charP_integralClosure_quotient A K L (r.under (integralClosure A L))
    have hrootsL : rootsOfUnity eL
        (integralClosure A L ⧸ r.under (integralClosure A L)) =
        rootsOfUnity nL (integralClosure A L ⧸ r.under (integralClosure A L)) :=
      rootsOfUnity_eq_rootsOfUnity_ordCompl (ringChar (IsLocalRing.ResidueField A)) eL
    let changeM := MulEquiv.subgroupCongr hrootsM
    let changeL := MulEquiv.subgroupCongr hrootsL
    let rootT := changeL.toMonoidHom.comp
      (rootRestriction.comp
        (changeM.symm.toMonoidHom.comp powerC.symm.toMonoidHom))
    have hquot : eM / eL = c * (nM / nL) := by
      rw [show eM = qM * nM from (Nat.ordProj_mul_ordCompl_eq_self eM _).symm,
        show eL = qL * nL from (Nat.ordProj_mul_ordCompl_eq_self eL _).symm,
        hqeq, Nat.mul_assoc, Nat.mul_div_mul_left _ _ (Nat.pos_of_ne_zero hqLne)]
      exact Nat.mul_div_assoc c hnDiv
    refine ⟨resI, rootT, hresI, hnDiv, ?_, ?_⟩
    · intro ζ
      have hη := powerC.apply_symm_apply ζ
      change algebraMap _ _
          ((rootRestriction (changeM.symm (powerC.symm ζ))).1.1) = _
      rw [hroot]
      simp only [changeM]
      change ((powerC.symm ζ : (integralClosure A M ⧸ r)ˣ) :
        integralClosure A M ⧸ r) ^ (eM / eL) = _
      rw [hquot, pow_mul]
      have hη' := congrArg (fun z : rootsOfUnity nM (integralClosure A M ⧸ r) ↦
        ((z : (integralClosure A M ⧸ r)ˣ) : integralClosure A M ⧸ r)) hη
      exact congrArg (fun z : integralClosure A M ⧸ r ↦
        z ^ (nM / nL)) hη'
    · intro σ
      have hscaled : canonicalInertiaCharacter A K M r σ =
          powerC (changeM (inertiaCharacter A K M r σ) ^ qL) := by
        apply Subtype.ext
        change (inertiaCharacter A K M r σ :
          (integralClosure A M ⧸ r)ˣ) ^ qM =
            ((inertiaCharacter A K M r σ :
              (integralClosure A M ⧸ r)ˣ) ^ qL) ^ c
        rw [hqeq, pow_mul]
      change changeL (rootRestriction (changeM.symm
        (powerC.symm (canonicalInertiaCharacter A K M r σ)))) = _
      rw [hscaled, powerC.symm_apply_apply, map_pow, changeM.symm_apply_apply,
        map_pow, hcharTower]
      rfl

end

end CanonicalInertiaCharacter

end IsDiscreteValuationRing
