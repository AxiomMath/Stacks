open IsLocalRing

namespace IsDiscreteValuationRing

/-- A ring with a nonunit `π`, no power of which is zero, in which every nonzero element is a unit
times a power of `π`, is a discrete valuation ring with uniformizer `π`. -/
theorem of_forall_eq_unit_mul_pow {R : Type*} [CommRing R] {π : R} (hπ : ¬IsUnit π)
    (hpow : ∀ n : ℕ, π ^ n ≠ 0)
    (hfac : ∀ x : R, x ≠ 0 → ∃ (n : ℕ) (u : R), IsUnit u ∧ x = u * π ^ n) :
    ∃ _ : IsDomain R, IsDiscreteValuationRing R ∧ Irreducible π := by
  have : Nontrivial R := ⟨⟨1, 0, by simpa using hpow 0⟩⟩
  have : NoZeroDivisors R := by
    refine ⟨fun {x y} hxy => ?_⟩
    by_contra! h
    obtain ⟨n, u, hu, rfl⟩ := hfac x h.1
    obtain ⟨m, v, hv, rfl⟩ := hfac y h.2
    have : (u * v) * π ^ (n + m) = 0 := by rw [← hxy]; ring
    exact hpow (n + m) ((hu.mul hv).mul_right_eq_zero.mp this)
  have hdom : IsDomain R := NoZeroDivisors.to_isDomain R
  have hπ0 : π ≠ 0 := by simpa using hpow 1
  have hirr : Irreducible π := by
    refine ⟨hπ, fun a b hab => ?_⟩
    have ha : a ≠ 0 := by rintro rfl; simp [hπ0] at hab
    have hb : b ≠ 0 := by rintro rfl; simp [hπ0] at hab
    obtain ⟨n, u, hu, rfl⟩ := hfac a ha
    obtain ⟨m, v, hv, rfl⟩ := hfac b hb
    rcases n with _ | n
    · exact Or.inl (by simpa using hu)
    rcases m with _ | m
    · exact Or.inr (by simpa using hv)
    refine absurd ?_ hπ
    have h1 : π * (1 - u * v * π ^ (n + m + 1)) = 0 := by
      rw [mul_sub, mul_one]; nth_rw 1 [hab]; ring
    have h2 : π * (u * v * π ^ (n + m)) = 1 := by
      have := sub_eq_zero.mp ((mul_eq_zero.mp h1).resolve_left hπ0)
      calc π * (u * v * π ^ (n + m)) = u * v * π ^ (n + m + 1) := by ring
        _ = 1 := this.symm
    exact IsUnit.of_mul_eq_one _ h2
  refine ⟨hdom, ofHasUnitMulPowIrreducibleFactorization ⟨π, hirr, fun {x} hx => ?_⟩, hirr⟩
  obtain ⟨n, u, hu, rfl⟩ := hfac x hx
  exact ⟨n, hu.unit, by rw [mul_comm]; rfl⟩

end IsDiscreteValuationRing

namespace IsLocalRing

variable {S : Type*} [CommRing S] [IsLocalRing S] [IsNoetherianRing S]

/-- In a Noetherian local ring whose maximal ideal is generated by `π`, every nonzero element is a
unit times a power of `π`. -/
theorem exists_eq_unit_mul_pow_of_maximalIdeal_eq_span {π : S}
    (hπ : maximalIdeal S = Ideal.span {π}) {x : S} (hx : x ≠ 0) :
    ∃ (n : ℕ) (u : S), IsUnit u ∧ x = u * π ^ n := by
  classical
  have hex : ∃ n : ℕ, x ∉ maximalIdeal S ^ (n + 1) := by
    by_contra! h
    refine hx ?_
    rw [← Ideal.mem_bot, ← Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal S)
      (maximalIdeal.isMaximal S).ne_top, Ideal.mem_iInf]
    rintro (_ | n)
    · simp
    · exact h n
  obtain ⟨N, hN, hmem⟩ : ∃ N : ℕ, x ∉ maximalIdeal S ^ (N + 1) ∧ x ∈ maximalIdeal S ^ N := by
    refine ⟨Nat.find hex, Nat.find_spec hex, ?_⟩
    rcases h : Nat.find hex with _ | k
    · simp
    · simpa using Nat.find_min hex (h ▸ Nat.lt_succ_self k)
  rw [hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem hN
  obtain ⟨u, hu⟩ := hmem
  refine ⟨N, u, ?_, hu.symm⟩
  by_contra hunit
  have hu' : u ∈ Ideal.span {π} := hπ ▸ (mem_maximalIdeal u).mpr hunit
  obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton'.mp hu'
  refine hN ?_
  exact ⟨v, by rw [← hu]; ring⟩

/-- A Noetherian local ring whose maximal ideal is generated by a nonzerodivisor `π` is a discrete
valuation ring with uniformizer `π`. -/
@[ega "IV 3.4.1" "(iii)", ega "IV 3.4.1.2" "Parenthetical in β"]
theorem isDiscreteValuationRing_of_maximalIdeal_eq_span {π : S}
    (hπ : maximalIdeal S = Ideal.span {π}) (hreg : IsSMulRegular S π) :
    ∃ _ : IsDomain S, IsDiscreteValuationRing S ∧ Irreducible π := by
  refine IsDiscreteValuationRing.of_forall_eq_unit_mul_pow ?_ (fun n h => ?_)
    (fun x hx => exists_eq_unit_mul_pow_of_maximalIdeal_eq_span hπ hx)
  · exact (mem_maximalIdeal π).mp (hπ ▸ Ideal.subset_span rfl)
  · exact one_ne_zero ((hreg.pow n) (by simpa [smul_eq_mul] using h))

end IsLocalRing

namespace IsDiscreteValuationRing

variable {A S : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
  [CommRing S] [IsLocalRing S] [Algebra A S] [IsLocalHom (algebraMap A S)]
  [Algebra.EssFiniteType A S] [Algebra.FormallyUnramified A S] [Module.Flat A S]

include A in
/-- A local ring which is flat, essentially of finite type and formally unramified over a
discrete valuation ring `A` is a discrete valuation ring, and every uniformizer of `A` maps to a
uniformizer of it. -/
theorem of_formallyUnramified {ϖ : A} (hϖ : Irreducible ϖ) :
    ∃ _ : IsDomain S, IsDiscreteValuationRing S ∧ Irreducible (algebraMap A S ϖ) ∧
      maximalIdeal S = Ideal.span {algebraMap A S ϖ} := by
  have : IsNoetherianRing S := Algebra.EssFiniteType.isNoetherianRing A S
  have hπ : maximalIdeal S = Ideal.span {algebraMap A S ϖ} := by
    rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := A),
      (irreducible_iff_uniformizer ϖ).mp hϖ, Ideal.map_span, Set.image_singleton]
  have hreg : IsSMulRegular S (algebraMap A S ϖ) :=
    IsSMulRegular.of_flat (IsSMulRegular.of_right_eq_zero_of_smul fun x hx =>
      (mul_eq_zero.mp hx).resolve_left hϖ.ne_zero)
  obtain ⟨hdom, hdvr, hirr⟩ := IsLocalRing.isDiscreteValuationRing_of_maximalIdeal_eq_span hπ hreg
  exact ⟨hdom, hdvr, hirr, hπ⟩

/-- A ring covered by subalgebras, each local and flat, essentially of finite type and formally
unramified over a discrete valuation ring `A` with local structure map, is a discrete valuation
ring provided `A → R` is local; every uniformizer of `A` maps to a uniformizer of it. -/
theorem of_forall_mem_subalgebra {R : Type*} [CommRing R] [Algebra A R]
    [IsLocalHom (algebraMap A R)] (𝒮 : Set (Subalgebra A R)) (hcover : ∀ x : R, ∃ T ∈ 𝒮, x ∈ T)
    (h𝒮 : ∀ T ∈ 𝒮, ∃ _ : IsLocalRing T, IsLocalHom (algebraMap A T) ∧
      Algebra.EssFiniteType A T ∧ Algebra.FormallyUnramified A T ∧ Module.Flat A T)
    {ϖ : A} (hϖ : Irreducible ϖ) :
    ∃ _ : IsDomain R, IsDiscreteValuationRing R ∧ Irreducible (algebraMap A R ϖ) := by
  have key : ∀ T ∈ 𝒮, ∃ _ : IsLocalRing T, ∃ _ : IsDomain T, IsDiscreteValuationRing T ∧
      Irreducible (algebraMap A T ϖ) ∧
      maximalIdeal T = Ideal.span {algebraMap A T ϖ} := by
    intro T hT
    obtain ⟨_, _, _, _, _⟩ := h𝒮 T hT
    exact ⟨inferInstance, of_formallyUnramified hϖ⟩
  refine of_forall_eq_unit_mul_pow ?_ (fun n h => ?_) (fun x hx => ?_)
  · exact fun h => hϖ.not_isUnit (isUnit_of_map_unit _ _ h)
  · obtain ⟨T, hT, -⟩ := hcover 0
    obtain ⟨_, _, -, hirr, -⟩ := key T hT
    refine pow_ne_zero n hirr.ne_zero (Subtype.ext ?_)
    simpa using h
  · obtain ⟨T, hT, hxT⟩ := hcover x
    obtain ⟨_, _, _, _, hπ⟩ := key T hT
    obtain ⟨n, u, hu, hxu⟩ := IsLocalRing.exists_eq_unit_mul_pow_of_maximalIdeal_eq_span
      (π := algebraMap A T ϖ) hπ (x := ⟨x, hxT⟩) (fun h => hx (congrArg Subtype.val h))
    refine ⟨n, u, hu.map T.val, ?_⟩
    have h := congrArg Subtype.val hxu
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow] at h
    exact h

end IsDiscreteValuationRing

