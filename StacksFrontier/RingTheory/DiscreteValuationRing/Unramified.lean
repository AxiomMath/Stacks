/-! ### The integral closure in a finite separable extension -/

/-- A domain which is module-finite over a henselian local ring is itself local. -/
@[ega "IV 18.5.11" "special case"]
private lemma isLocalRing_of_finite_domain_of_henselian
    (A : Type u) (B : Type v) [CommRing A] [HenselianLocalRing A]
    [CommRing B] [IsDomain B] [Algebra A B] [Module.Finite A B] :
    IsLocalRing B := by
  classical
  let U := ULift.{u} B
  let : Algebra A U := ULift.algebra
  have : Module.Finite A U := Module.Finite.equiv (ULift.algEquiv (R := A)).toLinearEquiv.symm
  have : IsDomain U :=
    (ULift.ringEquiv : U ≃+* B).injective.isDomain (ULift.ringEquiv : U ≃+* B)
  obtain ⟨n, C, hCring, hCalg, hlocal, hfinite, ⟨e⟩⟩ :=
    exists_algEquiv_pi_isLocalRing A U
  let : ∀ i, CommRing (C i) := hCring
  have : ∀ i, IsLocalRing (C i) := hlocal
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact zero_ne_one (e.injective (Subsingleton.elim _ _))
  have hnle : n ≤ 1 := by
    by_contra hn
    have hn2 : 2 ≤ n := by lia
    let i0 : Fin n := ⟨0, by lia⟩
    let i1 : Fin n := ⟨1, by lia⟩
    have h01 : i0 ≠ i1 := by simp [i0, i1, Fin.ext_iff]
    let y0 : ∀ i, C i := Pi.single i0 1
    let y1 : ∀ i, C i := Pi.single i1 1
    have hy0 : y0 ≠ 0 := fun h => by simpa [y0] using congr_fun h i0
    have hy1 : y1 ≠ 0 := fun h => by simpa [y1] using congr_fun h i1
    have hy : y0 * y1 = 0 := by
      ext i
      by_cases hi : i = i0
      · subst i
        simp [y0, y1, h01]
      · simp [y0, hi]
    rcases mul_eq_zero.mp (show e.symm y0 * e.symm y1 = 0 by
      apply e.injective
      simpa using hy) with h0 | h1
    · exact hy0 (e.symm.injective (by simpa using h0))
    · exact hy1 (e.symm.injective (by simpa using h1))
  have hn : n = 1 := Nat.le_antisymm hnle (Nat.one_le_iff_ne_zero.mpr hn0)
  subst n
  have : IsLocalRing U := (e.toRingEquiv.trans (RingEquiv.piUnique C)).symm.isLocalRing
  exact ULift.ringEquiv.isLocalRing

/-- The structure map from `A` to its integral closure in an extension of its fraction field is
injective. -/
private theorem algebraMap_integralClosure_injective
    (A K L : Type*) [CommRing A] [Field K] [Field L] [Algebra A K] [IsFractionRing A K]
    [Algebra K L] [Algebra A L] [IsScalarTower A K L] :
    Function.Injective (algebraMap A (integralClosure A L)) := by
  intro x y h
  apply IsFractionRing.injective A K
  apply (algebraMap K L).injective
  simpa [IsScalarTower.algebraMap_apply A K L] using congrArg Subtype.val h

/-- Let `A` be a discrete valuation ring with fraction field `K`, and let `L / K` be a finite
separable extension. The integral closure `B` of `A` in `L` is finite and Noetherian over `A`,
has dimension one, and is Dedekind. Its maximal ideals `m i` are precisely the primes over the
maximal ideal of `A`; every `B_(m i)` is a discrete valuation ring, and
`[L : K] = ∑ i, e(m i / m_A) * f(m i / m_A)`. If `A` is henselian—or, in particular,
maximal-ideal-adically complete—there is exactly one such maximal ideal. -/
@[stacks 09E8]
theorem integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L] :
    let B := integralClosure A L
    Module.Finite A B ∧
      IsNoetherianRing B ∧
      ringKrullDim B = 1 ∧
      IsDedekindDomain B ∧
      ∃ (n : ℕ) (m : Fin n → Ideal B),
        ∃ hmax : ∀ i, (m i).IsMaximal,
          (∀ q : Ideal B, q.IsMaximal ↔ ∃! i, m i = q) ∧
          (∀ i, (m i).LiesOver (IsLocalRing.maximalIdeal A)) ∧
          (∀ i, letI : (m i).IsPrime := (hmax i).isPrime
            IsDiscreteValuationRing (Localization.AtPrime (m i))) ∧
          Module.finrank K L = ∑ i, (m i).ramificationIdx A * (m i).inertiaDeg A ∧
          (HenselianLocalRing A → n = 1) ∧
          (IsAdicComplete (IsLocalRing.maximalIdeal A) A → n = 1) := by
  let B := integralClosure A L
  have hfinite : Module.Finite A B := IsIntegralClosure.finite A K L B
  have hnoeth : IsNoetherianRing B := IsIntegralClosure.isNoetherianRing A K L B
  have hded : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  have hinjAB : Function.Injective (algebraMap A B) :=
    algebraMap_integralClosure_injective A K L
  have : FaithfulSMul A B :=
    (faithfulSMul_iff_algebraMap_injective A B).mpr hinjAB
  have : Module.IsTorsionFree A L :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr
      (Subtype.val_injective.comp hinjAB)
  let p := IsLocalRing.maximalIdeal A
  have : p.IsMaximal := IsLocalRing.maximalIdeal.isMaximal A
  let e := Fintype.equivFin (p.primesOver B)
  let n := Fintype.card (p.primesOver B)
  let m : Fin n → Ideal B := fun i => (e.symm i).1
  have hlies : ∀ i, (m i).LiesOver p := fun i => (e.symm i).2.2
  have hmax : ∀ i, (m i).IsMaximal := fun i =>
    Ideal.IsMaximal.of_liesOver_isMaximal (P := m i) (p := p)
  have hBnotfield : ¬ IsField B := fun hfield => IsDiscreteValuationRing.not_isField A <|
    isField_of_isIntegral_of_isField (FaithfulSMul.algebraMap_injective A B) hfield
  have hhens : HenselianLocalRing A → n = 1 := fun _ => by
    show Fintype.card (p.primesOver B) = 1
    apply Fintype.card_eq_one_iff.mpr
    have : IsLocalRing B := isLocalRing_of_finite_domain_of_henselian A B
    obtain ⟨q, hqmax, hq⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := B) p
    refine ⟨⟨q, hqmax.isPrime, hq⟩, fun r => Subtype.ext ?_⟩
    exact (IsLocalRing.maximal_ideal_unique B).unique
      (Ideal.IsMaximal.of_liesOver_isMaximal (P := r.1) (p := p))
      (Ideal.IsMaximal.of_liesOver_isMaximal (P := q) (p := p))
  refine ⟨hfinite, hnoeth, ?_, hded, n, m, hmax, ?_, hlies, ?_, ?_, hhens, fun _ =>
    hhens ⟨fun f hf a ha hu => HenselianRing.is_henselian f hf a ha (hu.map _)⟩⟩
  · apply eq_of_le_of_not_lt
    · exact Ring.krullDimLE_iff.mp inferInstance
    · intro hdim
      have hle : ringKrullDim B ≤ 0 := Order.le_of_lt_succ hdim
      rw [← Nat.cast_zero, ← Ring.krullDimLE_iff] at hle
      exact hBnotfield Ring.KrullDimLE.isField_of_isDomain
  · intro q
    constructor
    · intro hq
      have hlo : q.LiesOver p := by
        rw [Ideal.liesOver_iff]
        exact (IsLocalRing.maximal_ideal_unique A).unique
          (IsLocalRing.maximalIdeal.isMaximal A)
          (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := A) q)
      let Q : p.primesOver B := ⟨q, hq.isPrime, hlo⟩
      refine ⟨e Q, ?_, ?_⟩
      · simp [m, Q]
      · intro j hj
        apply e.symm.injective
        apply Subtype.ext
        simpa [m, Q] using hj
    · rintro ⟨i, rfl, -⟩
      exact hmax i
  · exact fun i => IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B
      (fun hi => hBnotfield (Ring.isField_iff_maximal_bot.mpr (hi ▸ hmax i)))
      (Localization.AtPrime (m i))
  · rw [← IsIntegralClosure.rank A K L B,
      ← Ideal.sum_ramification_inertia_eq_finrank p B]
    exact (Equiv.sum_comp e.symm
      (fun q : p.primesOver B => q.1.ramificationIdx A * q.1.inertiaDeg A)).symm

/-! ### Unramified, tamely ramified and totally ramified extensions -/

/-- An extension is unramified with respect to a discrete valuation ring `A` if, at every
maximal ideal of the integral closure lying over the maximal ideal of `A`, the ramification index
is one and the induced residue field extension is separable. -/
@[stacks 09E9 "(1)"]
def IsUnramifiedWithRespectTo
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L] : Prop :=
  ∀ m : Ideal (integralClosure A L), m.IsMaximal →
    ∀ _ : m.LiesOver (IsLocalRing.maximalIdeal A),
      Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m = 1 ∧
        @Algebra.IsSeparable (A ⧸ IsLocalRing.maximalIdeal A) (integralClosure A L ⧸ m) _ _
          (Ideal.Quotient.algebraOfLiesOver m (IsLocalRing.maximalIdeal A))

/-- An extension is tamely ramified with respect to `A` if every induced residue field extension
is separable and, in positive residue characteristic, every ramification index is relatively
prime to that characteristic. This is `Stacks.KummerExtension.IsTamelyRamified`. -/
@[stacks 09E9 "(2)", sga "1 XIII 2.0" "L a field extension"]
abbrev IsTamelyRamifiedWithRespectTo
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L] : Prop :=
  Stacks.KummerExtension.IsTamelyRamified A K L

/-- An extension is totally ramified with respect to `A` if its integral closure has a unique
maximal ideal above that of `A` and its induced residue field extension is trivial. This is
`Stacks.KummerExtension.IsTotallyRamified`. -/
@[stacks 09E9 "(3)"]
abbrev IsTotallyRamifiedWithRespectTo
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L] : Prop :=
  Stacks.KummerExtension.IsTotallyRamified A K L

/-- For a finite separable extension, the unique ramification index of a totally ramified
extension equals its degree. This is the fundamental degree identity with one prime above the
maximal ideal and residue degree one. -/
theorem ramificationIdx_eq_finrank_of_totallyRamified
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L]
    (htot : IsTotallyRamifiedWithRespectTo A K L)
    (m : Ideal (integralClosure A L)) (hmmax : m.IsMaximal)
    (hmlies : m.LiesOver (IsLocalRing.maximalIdeal A)) :
    Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m = Module.finrank K L := by
  classical
  let B := integralClosure A L
  let p : Ideal A := IsLocalRing.maximalIdeal A
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  have : Module.IsTorsionFree A B :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr (algebraMap_integralClosure_injective A K L)
  have : p.IsMaximal := IsLocalRing.maximalIdeal.isMaximal A
  have hpne : p ≠ ⊥ := IsDiscreteValuationRing.not_a_field A
  obtain ⟨m₀, hm₀max, hm₀lies, huniq, hf⟩ := htot
  have hm : m = m₀ := huniq m hmmax hmlies
  subst hm
  have : m.IsPrime := hmmax.isPrime
  have hinert : m.inertiaDeg A = 1 := by
    rw [Ideal.inertiaDeg_eq_of_isMaximal p m]
    simpa using hf
  obtain ⟨-, -, -, -, n, ms, hmsmax, hmsiff, hmslies, -, hsum, -, -⟩ :=
    integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia A K L
  obtain ⟨i₀, hi₀, hi₀uniq⟩ := (hmsiff m).mp hmmax
  have hsingle : ∑ i, (ms i).ramificationIdx A * (ms i).inertiaDeg A
      = m.ramificationIdx A * m.inertiaDeg A := by
    rw [Finset.sum_eq_single i₀
      (fun b _ hb => absurd (hi₀uniq b (huniq (ms b) (hmsmax b) (hmslies b))) hb)
      (fun h => absurd (Finset.mem_univ i₀) h), hi₀]
  rw [Ideal.ramificationIdx'_eq_ramificationIdx p m hpne, hsum, hsingle, hinert, mul_one]

/-! ### Permanence properties of unramified extensions -/

/-- An algebra unramified at every maximal ideal is formally unramified. -/
private theorem formallyUnramified_of_forall_maximal
    (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    (h : ∀ (m : Ideal S) [m.IsMaximal], Algebra.IsUnramifiedAt R m) :
    Algebra.FormallyUnramified R S := by
  rw [Algebra.formallyUnramified_iff]
  apply subsingleton_of_forall_eq 0
  intro y
  apply Module.eq_zero_of_localization_maximal
    (fun m _ => KaehlerDifferential R (Localization.AtPrime m))
    (fun m _ => KaehlerDifferential.map R R S (Localization.AtPrime m)) y
  intro m hm
  have := h m
  exact Subsingleton.elim _ _

/-- Being unramified with respect to `A` is formal unramifiedness of the integral closure. -/
private theorem isUnramifiedWithRespectTo_iff_formallyUnramified
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L] :
    IsUnramifiedWithRespectTo A K L ↔
      Algebra.FormallyUnramified A (integralClosure A L) := by
  let B := integralClosure A L
  let p := IsLocalRing.maximalIdeal A
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  have : Module.IsTorsionFree A B :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr (algebraMap_integralClosure_injective A K L)
  constructor
  · intro h
    apply formallyUnramified_of_forall_maximal
    intro m hm
    have hmp : m.LiesOver p := ⟨(IsLocalRing.eq_maximalIdeal ((hm.under A))).symm⟩
    let := Localization.AtPrime.algebraOfLiesOver p m
    obtain ⟨he, hs⟩ := h m hm hmp
    apply (Algebra.isUnramifiedAt_iff_map_eq A p m).mpr
    refine ⟨Algebra.isSeparable_residueField_iff.mpr hs, ?_⟩
    apply (Ideal.IsDedekindDomain.ramificationIdx'_eq_one_iff ?_ ?_).mp he
    · intro hm0
      have hp0 : p = ⊥ := by simpa [hm0, Ideal.under_bot] using (m.over_def p)
      exact IsDiscreteValuationRing.not_a_field A hp0
    · exact Ideal.map_le_of_le_comap (m.over_def p).le
  · intro h m hm hmp
    let := Localization.AtPrime.algebraOfLiesOver p m
    constructor
    · rw [Ideal.ramificationIdx'_eq_ramificationIdx p m
        (IsDiscreteValuationRing.not_a_field A)]
      exact Ideal.ramificationIdx_eq_one m A
    · exact Algebra.isSeparable_residueField_iff.mp inferInstance

/-- An intermediate Dedekind domain of a formally unramified integral extension is itself
formally unramified. -/
private theorem formallyUnramified_of_integral_injective
    (R S T : Type*) [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T]
    [IsDedekindDomain S] [IsDomain T] [Module.IsTorsionFree S T]
    [Algebra.EssFiniteType R S] [Algebra.EssFiniteType R T]
    [Algebra.IsIntegral S T] [Algebra.FormallyUnramified R T] :
    Algebra.FormallyUnramified R S := by
  apply formallyUnramified_of_forall_maximal
  intro m hm
  obtain ⟨q, hq, he⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain (S := T) m
      (by
        intro y hy
        have hy0 : y = 0 := (FaithfulSMul.algebraMap_injective S T) (by simpa using hy)
        simp [hy0])
  have : q.LiesOver m := ⟨he.symm⟩
  exact Algebra.IsUnramifiedAt.of_liesOver R m q

/-- Unramifiedness with respect to `A` descends to a subextension. -/
private theorem isUnramifiedWithRespectTo_of_tower
    (A : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    (L : Type*) [Field L] [Algebra K L] [FiniteDimensional K L]
    [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L]
    (M : Type*) [Field M] [Algebra L M] [Algebra K M] [IsScalarTower K L M]
    [FiniteDimensional K M] [Algebra.IsSeparable K M]
    [Algebra A M] [IsScalarTower A K M]
    (h : IsUnramifiedWithRespectTo A K M) :
    IsUnramifiedWithRespectTo A K L := by
  have : IsScalarTower A L M := .of_algebraMap_eq' (by
    rw [IsScalarTower.algebraMap_eq A K L, ← RingHom.comp_assoc,
      ← IsScalarTower.algebraMap_eq K L M, ← IsScalarTower.algebraMap_eq A K M])
  let B := integralClosure A L
  let C := integralClosure A M
  let f : B →ₐ[A] C := (IsScalarTower.toAlgHom A L M).mapIntegralClosure
  let : Algebra B C := f.toAlgebra
  have : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' f.comp_algebraMap.symm
  have : Module.IsTorsionFree B C :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr (by
      intro b b' hb
      apply Subtype.ext
      apply (algebraMap L M).injective
      exact congrArg Subtype.val hb)
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : Module.Finite A C := IsIntegralClosure.finite A K M C
  have : Module.Finite B C := Module.Finite.of_restrictScalars_finite A B C
  have : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  have : Algebra.FormallyUnramified A C :=
    (isUnramifiedWithRespectTo_iff_formallyUnramified A K M).mp h
  exact (isUnramifiedWithRespectTo_iff_formallyUnramified A K L).mpr
    (formallyUnramified_of_integral_injective A B C)

/-- The join of two formally unramified subalgebras is formally unramified. -/
private theorem formallyUnramified_sup
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (B C : Subalgebra R S) [Algebra.FormallyUnramified R B]
    [Algebra.FormallyUnramified R C] : Algebra.FormallyUnramified R ↥(B ⊔ C) := by
  have : Algebra.FormallyUnramified B (B ⊗[R] C) := inferInstance
  have : Algebra.FormallyUnramified R (B ⊗[R] C) :=
    Algebra.FormallyUnramified.comp R B _
  exact Algebra.FormallyUnramified.of_surjective (B.mulMap' C) (B.mulMap'_surjective C)

/-- A subalgebra generating the whole field over `K` has it as a fraction field. -/
private theorem isFractionRing_of_adjoin_eq_top
    (A K M : Type*) [CommRing A] [Field K] [Field M]
    [Algebra A K] [IsFractionRing A K] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] (S : Subalgebra A M)
    (hS : IntermediateField.adjoin K (S : Set M) = ⊤) : IsFractionRing S M := by
  let f : FractionRing S →ₐ[S] M :=
    IsFractionRing.liftAlgHom
      (show Function.Injective (Algebra.ofId S M) from Subtype.val_injective)
  let F : IntermediateField K M :=
    { f.toRingHom.fieldRange with
      algebraMap_mem' := fun k => by
        obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective A k
        rw [map_div₀]
        apply f.toRingHom.fieldRange.div_mem
        · exact ⟨algebraMap S (FractionRing S) (algebraMap A S a), by
            simp [IsScalarTower.algebraMap_apply A K M]⟩
        · exact ⟨algebraMap S (FractionRing S) (algebraMap A S b), by
            simp [IsScalarTower.algebraMap_apply A K M]⟩ }
  have hF : F = ⊤ := by
    apply top_le_iff.mp
    rw [← hS]
    apply IntermediateField.adjoin_le_iff.mpr
    intro y hy
    exact ⟨algebraMap S (FractionRing S) ⟨y, hy⟩, by simp⟩
  have hf : Function.Surjective f := fun y => show y ∈ F by rw [hF]; trivial
  exact IsFractionRing.of_algEquiv (AlgEquiv.ofBijective f ⟨f.injective, hf⟩)

/-- Formal unramifiedness of a generating subalgebra passes to the integral closure. -/
private theorem formallyUnramified_integralClosure_of_adjoin_eq_top
    (A K M : Type*) [CommRing A] [IsDedekindDomain A] [Field K] [Field M]
    [Algebra A K] [IsFractionRing A K] [Algebra K M] [Algebra A M]
    [IsScalarTower A K M] (S : Subalgebra A M)
    [Module.Finite A S] [Algebra.FormallyUnramified A S]
    (hS : IntermediateField.adjoin K (S : Set M) = ⊤) :
    Algebra.FormallyUnramified A (integralClosure A M) := by
  have : IsDedekindDomain S := IsDedekindDomain.of_formallyUnramified A S
  have : IsFractionRing S M := isFractionRing_of_adjoin_eq_top A K M S hS
  have : IsIntegralClosure S A M := inferInstance
  exact Algebra.FormallyUnramified.of_equiv (IsIntegralClosure.equiv A S M (integralClosure A M))

/-- A finite join of finite formally unramified subalgebras is finite and formally unramified. -/
private theorem finite_formallyUnramified_sup
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {ι : Type*} (s : Finset ι) (B : ι → Subalgebra R S)
    (h : ∀ i ∈ s, Module.Finite R (B i) ∧ Algebra.FormallyUnramified R (B i)) :
    Module.Finite R ↥(s.sup B) ∧ Algebra.FormallyUnramified R ↥(s.sup B) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    show Module.Finite R ↥(⊥ : Subalgebra R S) ∧
      Algebra.FormallyUnramified R ↥(⊥ : Subalgebra R S)
    refine ⟨inferInstance, ?_⟩
    apply Algebra.FormallyUnramified.of_surjective (Algebra.ofId R (⊥ : Subalgebra R S))
    rintro ⟨y, hy⟩
    obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hy
    exact ⟨r, Subtype.ext hr⟩
  | @insert i s hi ih =>
    have hi' := h i (Finset.mem_insert_self i s)
    have hs := ih (fun j hj => h j (Finset.mem_insert_of_mem hj))
    have := hi'.1
    have := hi'.2
    have := hs.1
    have := hs.2
    rw [Finset.sup_insert]
    exact ⟨Subalgebra.finite_sup _ _, formallyUnramified_sup (B i) (s.sup B)⟩

/-- The image of a finite formally unramified subalgebra under an injective algebra map is again
finite and formally unramified. -/
private theorem finite_formallyUnramified_map
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
    (B : Subalgebra R S) [Module.Finite R B] [Algebra.FormallyUnramified R B]
    (f : S →ₐ[R] T) (hf : Function.Injective f) :
    Module.Finite R (B.map f) ∧ Algebra.FormallyUnramified R (B.map f) :=
  let e := B.equivMapOfInjective f hf
  ⟨Module.Finite.equiv e.toLinearEquiv, Algebra.FormallyUnramified.of_equiv e⟩

/-- The range of an embedding is generated over `K` by the image of the integral closure. -/
private theorem fieldRange_le_adjoin_integralClosure
    (A K L M : Type*) [CommRing A] [IsDomain A] [Field K] [Field L] [Field M]
    [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra K M]
    [Algebra A L] [Algebra A M] [IsScalarTower A K L] [IsScalarTower A K M]
    [FiniteDimensional K L] (f : L →ₐ[K] M) :
    f.fieldRange ≤ IntermediateField.adjoin K
      ((integralClosure A L).map (f.restrictScalars A) : Set M) := by
  have : IsFractionRing (integralClosure A L) L :=
    integralClosure.isFractionRing_of_finite_extension K L
  rintro y ⟨z, rfl⟩
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (integralClosure A L) z
  rw [map_div₀]
  apply IntermediateField.div_mem
  · exact IntermediateField.subset_adjoin _ _ ⟨a, a.property, rfl⟩
  · exact IntermediateField.subset_adjoin _ _ ⟨b, b.property, rfl⟩

/-- An extension generated by the images of an unramified extension is unramified. -/
private theorem isUnramifiedWithRespectTo_of_iSup_fieldRange_eq_top
    (A K L M : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Field M] [Algebra A K] [IsFractionRing A K]
    [Algebra K L] [FiniteDimensional K L] [Algebra.IsSeparable K L]
    [Algebra A L] [IsScalarTower A K L]
    [Algebra K M] [FiniteDimensional K M] [Algebra.IsSeparable K M]
    [Algebra A M] [IsScalarTower A K M]
    (hL : IsUnramifiedWithRespectTo A K L)
    (hgen : (⨆ f : L →ₐ[K] M, f.fieldRange) = ⊤) :
    IsUnramifiedWithRespectTo A K M := by
  classical
  let B := integralClosure A L
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have : Algebra.FormallyUnramified A B :=
    (isUnramifiedWithRespectTo_iff_formallyUnramified A K L).mp hL
  let C (f : L →ₐ[K] M) := B.map (f.restrictScalars A)
  let S : Subalgebra A M := Finset.univ.sup C
  have hS := finite_formallyUnramified_sup Finset.univ C
    (fun f _ => finite_formallyUnramified_map B (f.restrictScalars A) f.injective)
  have := hS.1
  have := hS.2
  apply (isUnramifiedWithRespectTo_iff_formallyUnramified A K M).mpr
  apply formallyUnramified_integralClosure_of_adjoin_eq_top A K M S
  apply top_le_iff.mp
  rw [← hgen]
  refine iSup_le fun f => (fieldRange_le_adjoin_integralClosure A K L M f).trans ?_
  exact IntermediateField.adjoin.mono K _ _
    (show C f ≤ S from Finset.le_sup (Finset.mem_univ f))

/-- An extension generated by the images of two unramified extensions is unramified. -/
private theorem isUnramifiedWithRespectTo_of_sup_fieldRange_eq_top
    (A K L₁ L₂ M : Type*) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L₁] [Field L₂] [Field M] [Algebra A K] [IsFractionRing A K]
    [Algebra K L₁] [FiniteDimensional K L₁] [Algebra.IsSeparable K L₁]
    [Algebra A L₁] [IsScalarTower A K L₁]
    [Algebra K L₂] [FiniteDimensional K L₂] [Algebra.IsSeparable K L₂]
    [Algebra A L₂] [IsScalarTower A K L₂]
    [Algebra K M] [FiniteDimensional K M] [Algebra.IsSeparable K M]
    [Algebra A M] [IsScalarTower A K M]
    (f₁ : L₁ →ₐ[K] M) (f₂ : L₂ →ₐ[K] M)
    (h₁ : IsUnramifiedWithRespectTo A K L₁)
    (h₂ : IsUnramifiedWithRespectTo A K L₂)
    (hgen : f₁.fieldRange ⊔ f₂.fieldRange = ⊤) :
    IsUnramifiedWithRespectTo A K M := by
  let B₁ := integralClosure A L₁
  let B₂ := integralClosure A L₂
  have : Module.Finite A B₁ := IsIntegralClosure.finite A K L₁ B₁
  have : Module.Finite A B₂ := IsIntegralClosure.finite A K L₂ B₂
  have : Algebra.FormallyUnramified A B₁ :=
    (isUnramifiedWithRespectTo_iff_formallyUnramified A K L₁).mp h₁
  have : Algebra.FormallyUnramified A B₂ :=
    (isUnramifiedWithRespectTo_iff_formallyUnramified A K L₂).mp h₂
  let C₁ := B₁.map (f₁.restrictScalars A)
  let C₂ := B₂.map (f₂.restrictScalars A)
  obtain ⟨_, _⟩ := finite_formallyUnramified_map B₁ (f₁.restrictScalars A) f₁.injective
  obtain ⟨_, _⟩ := finite_formallyUnramified_map B₂ (f₂.restrictScalars A) f₂.injective
  have : Module.Finite A ↥(C₁ ⊔ C₂) := Subalgebra.finite_sup C₁ C₂
  have : Algebra.FormallyUnramified A ↥(C₁ ⊔ C₂) := formallyUnramified_sup C₁ C₂
  apply (isUnramifiedWithRespectTo_iff_formallyUnramified A K M).mpr
  apply formallyUnramified_integralClosure_of_adjoin_eq_top A K M (C₁ ⊔ C₂)
  apply top_le_iff.mp
  rw [← hgen]
  apply sup_le
  · exact (fieldRange_le_adjoin_integralClosure A K L₁ M f₁).trans
      (IntermediateField.adjoin.mono K _ _ (show C₁ ≤ C₁ ⊔ C₂ from le_sup_left))
  · exact (fieldRange_le_adjoin_integralClosure A K L₂ M f₂).trans
      (IntermediateField.adjoin.mono K _ _ (show C₂ ≤ C₁ ⊔ C₂ from le_sup_right))

/-- **Stacks 0EXR.** Unramified finite separable extensions of the fraction field of a discrete
valuation ring are closed under passage to intermediate fields, admit finite Galois
overextensions which remain unramified, and any two admit a common finite separable
overextension which remains unramified. -/
@[stacks 0EXR]
theorem isUnramifiedWithRespectTo_of_tower_and_exists_isGalois_and_common_extension
    (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type v) [Field K] [Algebra A K] [IsFractionRing A K] :
    (∀ (L : Type w) [Field L] [Algebra K L] [FiniteDimensional K L]
        [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L]
        (M : Type x) [Field M] [Algebra L M] [FiniteDimensional L M]
        [Algebra.IsSeparable L M] [Algebra K M] [IsScalarTower K L M]
        [Algebra A M] [IsScalarTower A K M],
      letI : FiniteDimensional K M := FiniteDimensional.trans K L M
      letI : Algebra.IsSeparable K M := Algebra.IsSeparable.trans K L M
      IsUnramifiedWithRespectTo A K M →
        IsUnramifiedWithRespectTo A K L) ∧
    (∀ (L : Type w) [Field L] [Algebra K L] [FiniteDimensional K L]
        [Algebra.IsSeparable K L] [Algebra A L] [IsScalarTower A K L],
      IsUnramifiedWithRespectTo A K L →
        ∃ (M : Type (max u v w)) (_ : Field M) (_ : Algebra K M)
          (_ : FiniteDimensional K M) (_ : Algebra.IsSeparable K M)
          (_ : Algebra A M) (_ : IsScalarTower A K M)
          (_ : Algebra L M) (_ : IsScalarTower K L M),
          IsGalois K M ∧ IsUnramifiedWithRespectTo A K M) ∧
    (∀ (L₁ : Type w) [Field L₁] [Algebra K L₁] [FiniteDimensional K L₁]
        [Algebra.IsSeparable K L₁] [Algebra A L₁] [IsScalarTower A K L₁]
        (L₂ : Type x) [Field L₂] [Algebra K L₂] [FiniteDimensional K L₂]
        [Algebra.IsSeparable K L₂] [Algebra A L₂] [IsScalarTower A K L₂],
      IsUnramifiedWithRespectTo A K L₁ →
        IsUnramifiedWithRespectTo A K L₂ →
        ∃ (L : Type (max u v w x)) (_ : Field L) (_ : Algebra K L)
          (_ : FiniteDimensional K L) (_ : Algebra.IsSeparable K L)
          (_ : Algebra A L) (_ : IsScalarTower A K L)
          (_ : Algebra L₁ L) (_ : IsScalarTower K L₁ L)
          (_ : Algebra L₂ L) (_ : IsScalarTower K L₂ L),
          IsUnramifiedWithRespectTo A K L) := by
  refine ⟨?_, ?_, ?_⟩
  · intro L _ _ _ _ _ _ M _ _ _ _ _ _ _ _
    have : FiniteDimensional K M := FiniteDimensional.trans K L M
    have : Algebra.IsSeparable K M := Algebra.IsSeparable.trans K L M
    exact isUnramifiedWithRespectTo_of_tower A K L M
  · intro L _ _ _ _ _ _ hL
    let E := ULift.{max u v} (AlgebraicClosure L)
    have : IsScalarTower K L E := inferInstance
    have : Normal K E :=
      Normal.of_algEquiv (ULift.algEquiv (R := K) (A := AlgebraicClosure L)).symm
    have : Nonempty (L →ₐ[K] E) := ⟨IsScalarTower.toAlgHom K L E⟩
    let M := IntermediateField.normalClosure K L E
    have : FiniteDimensional K M := inferInstance
    have : Normal K M := inferInstance
    let : Algebra L M := inferInstance
    have : IsScalarTower K L M := inferInstance
    have : IsNormalClosure K L M := inferInstance
    have hgen : (⨆ f : L →ₐ[K] M, f.fieldRange) = ⊤ :=
      (Algebra.IsAlgebraic.isNormalClosure_iff (F := K) (K := L) (L := M)).mp
        (inferInstance : IsNormalClosure K L M) |>.2
    have hsep : ∀ g : L →ₐ[K] E, Algebra.IsSeparable K g.fieldRange := fun g =>
      Algebra.IsSeparable.of_algHom K L (AlgEquiv.ofInjectiveField g).symm.toAlgHom
    have : Algebra.IsSeparable K M := IntermediateField.isSeparable_iSup K E
    let : Algebra A M := ((algebraMap K M).comp (algebraMap A K)).toAlgebra
    have : IsScalarTower A K M := IsScalarTower.of_algebraMap_eq' rfl
    refine ⟨M, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, inferInstance, IsGalois.mk, ?_⟩
    exact isUnramifiedWithRespectTo_of_iSup_fieldRange_eq_top A K L M hL hgen
  · intro L₁ _ _ _ _ _ _ L₂ _ _ _ _ _ _ h₁ h₂
    let E := ULift.{max u w x} (AlgebraicClosure K)
    let f₁ : L₁ →ₐ[K] E := (ULift.algEquiv (R := K) (A := AlgebraicClosure K)).symm.toAlgHom.comp
      (IsAlgClosed.lift : L₁ →ₐ[K] AlgebraicClosure K)
    let f₂ : L₂ →ₐ[K] E := (ULift.algEquiv (R := K) (A := AlgebraicClosure K)).symm.toAlgHom.comp
      (IsAlgClosed.lift : L₂ →ₐ[K] AlgebraicClosure K)
    let F := f₁.fieldRange ⊔ f₂.fieldRange
    have : FiniteDimensional K f₁.fieldRange := f₁.toLinearMap.finiteDimensional_range
    have : FiniteDimensional K f₂.fieldRange := f₂.toLinearMap.finiteDimensional_range
    have : FiniteDimensional K F := IntermediateField.finiteDimensional_sup _ _
    have : Algebra.IsSeparable K f₁.fieldRange :=
      Algebra.IsSeparable.of_algHom K L₁ (AlgEquiv.ofInjectiveField f₁).symm.toAlgHom
    have : Algebra.IsSeparable K f₂.fieldRange :=
      Algebra.IsSeparable.of_algHom K L₂ (AlgEquiv.ofInjectiveField f₂).symm.toAlgHom
    have : Algebra.IsSeparable K F := IntermediateField.isSeparable_sup K E _ _
    let g₁ : L₁ →ₐ[K] F := f₁.codRestrict F.toSubalgebra
      (fun z => (show f₁.fieldRange ≤ F from le_sup_left) ⟨z, rfl⟩)
    let g₂ : L₂ →ₐ[K] F := f₂.codRestrict F.toSubalgebra
      (fun z => (show f₂.fieldRange ≤ F from le_sup_right) ⟨z, rfl⟩)
    let : Algebra L₁ F := g₁.toAlgebra
    let : Algebra L₂ F := g₂.toAlgebra
    have : IsScalarTower K L₁ F := IsScalarTower.of_algebraMap_eq' g₁.comp_algebraMap.symm
    have : IsScalarTower K L₂ F := IsScalarTower.of_algebraMap_eq' g₂.comp_algebraMap.symm
    let : Algebra A F := ((algebraMap K F).comp (algebraMap A K)).toAlgebra
    have : IsScalarTower A K F := IsScalarTower.of_algebraMap_eq' rfl
    have hgen : g₁.fieldRange ⊔ g₂.fieldRange = ⊤ := by
      apply IntermediateField.map_injective F.val
      rw [IntermediateField.map_sup, AlgHom.map_fieldRange, AlgHom.map_fieldRange]
      show f₁.fieldRange ⊔ f₂.fieldRange = (⊤ : IntermediateField K F).map F.val
      rw [← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val]
    refine ⟨F, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, ?_⟩
    exact isUnramifiedWithRespectTo_of_sup_fieldRange_eq_top A K L₁ L₂ F g₁ g₂ h₁ h₂ hgen

/-! ### Unramifiedness in a tower -/

/-- If `p` is unramified in `B` and `C` is unramified over every prime of `B` lying over `p`,
then `p` is unramified in `C`. -/
@[stacks 0EXS, sga "1 I 10.4" "(ii) transitivity"]
theorem isUnramifiedIn_comp
    (A B C : Type*) [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C]
    (p : Ideal A) (hAB : Algebra.IsUnramifiedIn B p)
    (hBC : ∀ (q : Ideal B) (_ : q.IsPrime), q.LiesOver p → Algebra.IsUnramifiedIn C q) :
    Algebra.IsUnramifiedIn C p := by
  intro P hP hPp
  let q := P.comap (algebraMap B C)
  have hq : q.IsPrime := Ideal.IsPrime.comap (algebraMap B C)
  have hqp : q.LiesOver p := by
    constructor
    show p = Ideal.comap (algebraMap A B) (Ideal.comap (algebraMap B C) P)
    rw [Ideal.comap_comap, ← IsScalarTower.algebraMap_eq A B C]
    exact hPp.over
  have : P.LiesOver q := ⟨rfl⟩
  have : Algebra.IsUnramifiedAt A q := hAB q hq hqp
  have : Algebra.IsUnramifiedAt B P := hBC q hq hqp P hP inferInstance
  exact Algebra.IsUnramifiedAt.comp q P

end IsDiscreteValuationRing
