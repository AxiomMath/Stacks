module

public import StacksFrontier.RingTheory.DiscreteValuationRing.Kummer.RingOfIntegers

@[expose] public section

/-!
# Kummer extensions: the residue map, the discrete valuation ring `A₁`, and ramification

The residue map of `A' = A[x]/(xⁿ - π)`, the discrete valuation ring `A₁` with uniformizer `π'`,
its ramification index `n`, and total and tame ramification of `K₁/K` (Stacks Tag 09EV (3)-(6)).
-/

open Polynomial

namespace Stacks.KummerExtension

section Statements

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
variable (π : A) (n : ℕ)

/-- Modulo the maximal ideal of `A`, the Kummer polynomial `x^n - pi` vanishes at `0`. -/
theorem kummerPolyA_eval₂_residue_eq_zero (hn : 1 ≤ n) (hπ : Irreducible π) :
    eval₂ (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A))
      (0 : A ⧸ IsLocalRing.maximalIdeal A) (kummerPolyA π n) = 0 := by
  rw [kummerPolyA, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C, zero_pow (by omega : n ≠ 0),
    zero_sub, neg_eq_zero, Ideal.Quotient.eq_zero_iff_mem, hπ.maximalIdeal_eq]
  exact Ideal.mem_span_singleton_self π

/-- The residue homomorphism `A' = A[x]/(x^n - pi) -> kappa_A = A / m_A`, sending `pi'` to `0`
and an element of `A` to its residue class. -/
noncomputable def residueA' (hn : 1 ≤ n) (hπ : Irreducible π) :
    A' π n →+* A ⧸ IsLocalRing.maximalIdeal A :=
  AdjoinRoot.lift (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A)) 0
    (kummerPolyA_eval₂_residue_eq_zero π n hn hπ)

/-- The residue homomorphism of `A' = A[x]/(x^n - pi)` sends `pi'` to `0`. -/
@[simp]
theorem residueA'_piRootA (hn : 1 ≤ n) (hπ : Irreducible π) :
    residueA' π n hn hπ (piRootA π n) = 0 := AdjoinRoot.lift_root _

/-- The residue homomorphism of `A'` sends the image of `a : A` to the residue class of `a`. -/
@[simp]
theorem residueA'_algebraMap (hn : 1 ≤ n) (hπ : Irreducible π) (a : A) :
    residueA' π n hn hπ (algebraMap A (A' π n) a) = Ideal.Quotient.mk _ a := by
  rw [AdjoinRoot.algebraMap_eq]; simp [residueA', AdjoinRoot.lift_of]

/-- The residue homomorphism `A' -> kappa_A` is surjective. -/
theorem residueA'_surjective (hn : 1 ≤ n) (hπ : Irreducible π) :
    Function.Surjective (residueA' π n hn hπ) := by
  intro y
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨algebraMap A (A' π n) a, residueA'_algebraMap π n hn hπ a⟩

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- Every element of `A' = A[x]/(x^n - pi)` agrees, modulo `(pi')`, with the image of its
constant coefficient. -/
theorem sub_algebraMap_mem_span_piRootA (z : A' π n) :
    ∃ a : A, z - algebraMap A (A' π n) a ∈ Ideal.span {piRootA π n} := by
  obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective (g := kummerPolyA π n) z
  refine ⟨g.coeff 0, ?_⟩
  have hdvd : (X : A[X]) ∣ (g - C (g.coeff 0)) := by rw [X_dvd_iff]; simp
  obtain ⟨h, hh⟩ := hdvd
  have : (AdjoinRoot.mk (kummerPolyA π n)) g - algebraMap A (A' π n) (g.coeff 0)
      = piRootA π n * (AdjoinRoot.mk (kummerPolyA π n)) h := by
    rw [AdjoinRoot.algebraMap_eq, ← AdjoinRoot.mk_C, ← map_sub, hh, map_mul, AdjoinRoot.mk_X]
  rw [this]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- The kernel of the residue homomorphism of `A' = A[x]/(x^n - pi)` is the principal ideal
generated by `pi'`. -/
theorem ker_residueA' (hn : 1 ≤ n) (hπ : Irreducible π) :
    RingHom.ker (residueA' π n hn hπ) = Ideal.span {piRootA π n} := by
  apply le_antisymm
  · intro z hz
    rw [RingHom.mem_ker] at hz
    obtain ⟨a, ha⟩ := sub_algebraMap_mem_span_piRootA π n z
    have hzero : residueA' π n hn hπ (z - algebraMap A (A' π n) a) = 0 := by
      rw [Ideal.mem_span_singleton] at ha; obtain ⟨c, hc⟩ := ha
      rw [hc, map_mul, residueA'_piRootA, zero_mul]
    have hmk : Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) a = 0 := by
      rw [map_sub, hz, zero_sub, neg_eq_zero] at hzero
      rw [← residueA'_algebraMap π n hn hπ a]; exact hzero
    rw [Ideal.Quotient.eq_zero_iff_mem, hπ.maximalIdeal_eq, Ideal.mem_span_singleton] at hmk
    obtain ⟨b, hb⟩ := hmk
    have hag : algebraMap A (A' π n) a ∈ Ideal.span {piRootA π n} := by
      rw [hb, map_mul, ← piRootA_pow π n, Ideal.mem_span_singleton]
      refine ⟨piRootA π n ^ (n-1) * algebraMap A (A' π n) b, ?_⟩
      rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hn]
    have hsplit : z = (z - algebraMap A (A' π n) a) + algebraMap A (A' π n) a := by ring
    rw [hsplit]; exact Ideal.add_mem _ ha hag
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
    exact residueA'_piRootA π n hn hπ

/-- `(pi')` is a maximal ideal of `A' = A[x]/(x^n - pi)`, since the quotient is the residue
field `kappa_A` of `A`. -/
theorem span_piRootA_isMaximal (hn : 1 ≤ n) (hπ : Irreducible π) :
    (Ideal.span {piRootA π n} : Ideal (A' π n)).IsMaximal := by
  rw [← ker_residueA' π n hn hπ]
  apply Ideal.Quotient.maximal_of_isField
  have hfield : IsField (A ⧸ IsLocalRing.maximalIdeal A) :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp inferInstance
  exact MulEquiv.isField hfield
    (RingHom.quotientKerEquivOfSurjective (residueA'_surjective π n hn hπ)).toMulEquiv


/-- If `A' = A[x]/(x^n - pi)` is a domain, then it is a discrete valuation ring. -/
theorem isDiscreteValuationRing_A' [IsDomain (A' π n)] (hn : 2 ≤ n) (hπ : Irreducible π) :
    IsDiscreteValuationRing (A' π n) := by
  have hn1 : 1 ≤ n := by omega
  have pi_mem_max : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ.maximalIdeal_eq]; exact Ideal.mem_span_singleton_self π
  have hfin : Module.Finite A (A' π n) := (powerBasisA' π n hn1).finite
  have hint : Algebra.IsIntegral A (A' π n) := inferInstance
  have hnoeth : IsNoetherianRing (A' π n) := by
    have h : IsNoetherian (A' π n) (A' π n) := isNoetherian_of_tower A inferInstance
    rwa [isNoetherianRing_iff]
  have piRootA_mem_jac : piRootA π n ∈ Ring.jacobson (A' π n) := by
    rw [Ring.jacobson_eq_sInf_isMaximal, Submodule.mem_sInf]
    intro M hM
    simp only [Set.mem_ofPred_eq] at hM
    have hcomap : (Ideal.comap (algebraMap A (A' π n)) M).IsMaximal :=
      Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := A) (hI := hM) M
    have heq : Ideal.comap (algebraMap A (A' π n)) M = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal hcomap
    have hpi : π ∈ Ideal.comap (algebraMap A (A' π n)) M := by rw [heq]; exact pi_mem_max
    rw [Ideal.mem_comap, ← piRootA_pow π n] at hpi
    exact hM.isPrime.mem_of_pow_mem n hpi
  have hPmax : (Ideal.span {piRootA π n}).IsMaximal := span_piRootA_isMaximal π n hn1 hπ
  have span_jac : Ideal.span {piRootA π n} = Ring.jacobson (A' π n) := by
    apply le_antisymm
    · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]; exact piRootA_mem_jac
    · have := hPmax; exact Ring.jacobson_le_of_isMaximal _
  have hloc : IsLocalRing (A' π n) := by
    apply IsLocalRing.of_unique_max_ideal
    refine ⟨Ideal.span {piRootA π n}, hPmax, ?_⟩
    intro M hM
    have hle : Ideal.span {piRootA π n} ≤ M := by
      rw [span_jac]; have := hM; exact Ring.jacobson_le_of_isMaximal M
    exact (hPmax.eq_of_le hM.ne_top hle).symm
  have hmaxeq : IsLocalRing.maximalIdeal (A' π n) = Ideal.span {piRootA π n} :=
    (IsLocalRing.eq_maximalIdeal hPmax).symm
  have hπ'ne : piRootA π n ≠ 0 := by
    intro h
    have : Module.Free A (A' π n) := Module.Free.of_basis (powerBasisA' π n hn1).basis
    have hinj : Function.Injective (algebraMap A (A' π n)) :=
      FaithfulSMul.algebraMap_injective A (A' π n)
    have hz : algebraMap A (A' π n) π = 0 := by
      rw [← piRootA_pow π n, h, zero_pow (by omega : n ≠ 0)]
    have : π = 0 := hinj (by rw [hz, map_zero])
    exact hπ.ne_zero this
  have hmax_ne : IsLocalRing.maximalIdeal (A' π n) ≠ ⊥ := by
    rw [hmaxeq]
    intro h
    rw [Ideal.span_singleton_eq_bot] at h
    exact hπ'ne h
  have hprinc : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (A' π n)) := by
    rw [hmaxeq]; exact ⟨piRootA π n, by rw [Ideal.submodule_span_eq]⟩
  have hpir : IsPrincipalIdealRing (A' π n) :=
    ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain (A' π n)).out 5 1).mp hprinc
  exact IsDiscreteValuationRing.mk hmax_ne

/-- If `A' = A[x]/(x^n - pi)` is a domain, then `pi'` is irreducible in `A'`. -/
theorem irreducible_piRootA [IsDomain (A' π n)] (hn : 2 ≤ n) (hπ : Irreducible π) :
    Irreducible (piRootA π n) := by
  have := isDiscreteValuationRing_A' π n hn hπ
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr
    (IsLocalRing.eq_maximalIdeal (span_piRootA_isMaximal π n (by omega) hπ)).symm

/-- The Kummer polynomial is irreducible, packaged as a `Fact`. -/
private theorem fact_irreducible_kummerPoly (hn : 2 ≤ n) (hπ : Irreducible π) :
    Fact (Irreducible (kummerPoly K π n)) :=
  ⟨kummerPoly_irreducible K π n (by omega) hπ⟩

/-- `A' = A[x]/(x^n - pi)` is a domain when the Kummer polynomial is irreducible. -/
private theorem isDomain_A'_of_fact [Fact (Irreducible (kummerPoly K π n))]
    (hn : 2 ≤ n) (hπ : Irreducible π) : IsDomain (A' π n) :=
  (canonAlgEquiv K π n hn hπ).toRingEquiv.injective.isDomain
    (canonAlgEquiv K π n hn hπ).toRingEquiv.toRingHom

/-- `A_1` is a discrete valuation ring. -/
@[stacks 09EV "(3)"]
theorem isDiscreteValuationRing_A1 [Fact (Irreducible (kummerPoly K π n))]
    (hn : 2 ≤ n) (hπ : Irreducible π) :
    IsDiscreteValuationRing (A1 K π n) := by
  have ee : (A' π n) ≃+* (A1 K π n) := (canonAlgEquiv K π n hn hπ).toRingEquiv
  have hdA' : IsDomain (A' π n) := isDomain_A'_of_fact K π n hn hπ
  have hdvrA' : IsDiscreteValuationRing (A' π n) := isDiscreteValuationRing_A' π n hn hπ
  let hpir : IsPrincipalIdealRing (A1 K π n) :=
    IsPrincipalIdealRing.of_surjective ee.toRingHom ee.surjective
  let hloc : IsLocalRing (A1 K π n) := RingEquiv.isLocalRing ee
  refine IsDiscreteValuationRing.mk ?_
  intro hbot
  have hA'nf : ¬ IsField (A' π n) := IsDiscreteValuationRing.not_isField (A' π n)
  exact hA'nf (MulEquiv.isField (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot) ee.toMulEquiv)

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- The `n`-th root `pi' = pi^{1/n}` lies in `A_1`. -/
theorem piRoot_mem_A1 (hn : 2 ≤ n) :
    piRoot K π n ∈ A1 K π n := by
  refine ⟨kummerPolyA π n, kummerPolyA_monic π n (by omega), ?_⟩
  have := kummerPolyA_eval_piRoot K π n
  simpa [aeval_def] using this

/-- `pi' = pi^{1/n}` is irreducible in `A_1`, that is, a uniformizer of `A_1`. -/
theorem irreducible_piRoot (hn : 2 ≤ n) (hπ : Irreducible π) :
    Irreducible (⟨piRoot K π n, piRoot_mem_A1 K π n hn⟩ : A1 K π n) := by
  have := fact_irreducible_kummerPoly K π n hn hπ
  have hdA' : IsDomain (A' π n) := isDomain_A'_of_fact K π n hn hπ
  have hirrA' : Irreducible (piRootA π n) := irreducible_piRootA π n hn hπ
  have heq : (⟨piRoot K π n, piRoot_mem_A1 K π n hn⟩ : A1 K π n)
      = canonAlgEquiv K π n hn hπ (piRootA π n) :=
    Subtype.ext (by rw [canonAlgEquiv_coe_apply, canonAlgHom_piRootA])
  rw [heq]
  exact (MulEquiv.irreducible_iff (canonAlgEquiv K π n hn hπ).toMulEquiv).mpr hirrA'

/-- `A_1` has a unique maximal ideal `m` lying over `m_A`, and the ramification index of `m`
over `m_A` is `n`. -/
@[stacks 09EV "(4)"]
theorem exists_ramificationIdx_eq (hn : 2 ≤ n) (hπ : Irreducible π) :
    ∃ m : Ideal (A1 K π n), m.IsMaximal ∧
      m.LiesOver (IsLocalRing.maximalIdeal A) ∧
      (∀ m' : Ideal (A1 K π n), m'.IsMaximal →
        m'.LiesOver (IsLocalRing.maximalIdeal A) → m' = m) ∧
      Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m = n := by
  have hn1 : 1 ≤ n := by omega
  have := fact_irreducible_kummerPoly K π n hn hπ
  have hdvr : IsDiscreteValuationRing (A1 K π n) := isDiscreteValuationRing_A1 K π n hn hπ
  set π' : A1 K π n := ⟨piRoot K π n, piRoot_mem_A1 K π n hn⟩ with hπ'
  have hirr : Irreducible π' := irreducible_piRoot K π n hn hπ
  set m : Ideal (A1 K π n) := IsLocalRing.maximalIdeal (A1 K π n) with hm
  have hmspan : m = Ideal.span {π'} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer π').mp hirr
  have hpow : π' ^ n = algebraMap A (A1 K π n) π := by
    apply Subtype.ext
    have hcoe : ((π' ^ n : A1 K π n) : K1 K π n) = (piRoot K π n) ^ n := by
      push_cast [hπ']; rfl
    rw [hcoe, piRoot_pow]
    rfl
  refine ⟨m, IsLocalRing.maximalIdeal.isMaximal _, ?_, ?_, ?_⟩
  · refine ⟨?_⟩
    have hle : IsLocalRing.maximalIdeal A ≤ Ideal.under A m := by
      rw [hπ.maximalIdeal_eq, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
        Ideal.mem_under, hmspan, Ideal.mem_span_singleton]
      refine ⟨π' ^ (n - 1), ?_⟩
      rw [← pow_succ', Nat.sub_add_cancel hn1, hpow]
    have hne : Ideal.under A m ≠ ⊤ := by
      intro htop
      have h1 : (1 : A) ∈ Ideal.under A m := by rw [htop]; trivial
      rw [Ideal.mem_under, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (Ideal.eq_top_of_unit_mem _ _ 1 h1
          (one_mul 1))
    exact ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hne hle)
  · intro m' hm'max _
    exact IsLocalRing.eq_maximalIdeal hm'max
  · have hmapeq : Ideal.map (algebraMap A (A1 K π n)) (IsLocalRing.maximalIdeal A) = m ^ n := by
      rw [hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton, hmspan,
        Ideal.span_singleton_pow, hpow]
    apply Ideal.ramificationIdx'_spec
    · rw [hmapeq]
    · rw [hmapeq]
      rw [hmspan, Ideal.span_singleton_pow, Ideal.span_singleton_pow,
        Ideal.span_singleton_le_span_singleton]
      intro hdvd
      obtain ⟨c, hc⟩ := hdvd
      have hne0 : (π' ^ n : A1 K π n) ≠ 0 := pow_ne_zero _ hirr.ne_zero
      have hcancel : π' * c = 1 := by
        apply mul_left_cancel₀ hne0
        rw [mul_one]
        conv_rhs => rw [hc]
        rw [pow_succ]; ring
      exact hirr.not_isUnit (IsUnit.of_mul_eq_one c hcancel)

-- `Ideal.sum_ramification_inertia` is deprecated in favour of the parallel
-- `RingTheory.RamificationInertia` API, whose statement genuinely differs (a `Fintype`
-- subtype index instead of `primesOverFinset`, unprimed `ramificationIdx`/`inertiaDeg`, and
-- `finrank A A₁` instead of `[K₁:K]`). Porting the proof across is a real change, not a
-- rename, so the call stays and the deprecation is silenced for this declaration only.
set_option linter.deprecated false in
/-- `K_1 / K` is totally ramified with respect to `A`, whatever the residue characteristic of
`A`. -/
@[stacks 09EV "(5)"]
theorem isTotallyRamified_K1 [Fact (Irreducible (kummerPoly K π n))]
    (hn : 2 ≤ n) (hπ : Irreducible π) :
    IsTotallyRamified A K (K1 K π n) := by
  have hn1 : 1 ≤ n := by omega
  have hdvr : IsDiscreteValuationRing (A1 K π n) := isDiscreteValuationRing_A1 K π n hn hπ
  have hfr : IsFractionRing (A1 K π n) (K1 K π n) :=
    integralClosure.isFractionRing_of_finite_extension K (K1 K π n)
  have hTF : Module.IsTorsionFree A (A1 K π n) := by
    rw [Module.isTorsionFree_iff_algebraMap_injective]
    have hAK1 : Function.Injective (algebraMap A (K1 K π n)) := by
      rw [IsScalarTower.algebraMap_eq A K (K1 K π n), RingHom.coe_comp]
      exact (algebraMap K (K1 K π n)).injective.comp (IsFractionRing.injective A K)
    have hcomp : ∀ a : A, (algebraMap (A1 K π n) (K1 K π n)) (algebraMap A (A1 K π n) a) =
        algebraMap A (K1 K π n) a := fun a ↦ by
      rw [← RingHom.comp_apply, ← IsScalarTower.algebraMap_eq]
    intro a b hab
    apply hAK1
    rw [← hcomp a, ← hcomp b, hab]
  have hfinA' : Module.Finite A (A' π n) := PowerBasis.finite (powerBasisA' π n hn1)
  have hfinA1 : Module.Finite A (A1 K π n) :=
    Module.Finite.equiv (canonAlgEquiv K π n hn hπ).toLinearEquiv
  obtain ⟨m, hmmax, hmlies, hmuniq, hmrami⟩ := exists_ramificationIdx_eq K π n hn hπ
  refine ⟨m, hmmax, hmlies, hmuniq, ?_⟩
  set p : Ideal A := IsLocalRing.maximalIdeal A with hp
  have hpmax : p.IsMaximal := IsLocalRing.maximalIdeal.isMaximal A
  have hpne : p ≠ ⊥ := IsDiscreteValuationRing.not_a_field A
  have hprimes : IsDedekindDomain.primesOverFinset p (A1 K π n) = {m} := by
    apply Finset.coe_injective
    rw [IsDedekindDomain.coe_primesOverFinset hpne (A1 K π n), Finset.coe_singleton]
    ext P
    simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff, Ideal.primesOver]
    refine ⟨fun ⟨hPprime, hPlies⟩ ↦ hmuniq P (hPprime.isMaximal fun hP0 ↦
      hpne (by simpa [hP0] using hPlies.over)) hPlies, ?_⟩
    rintro rfl
    exact ⟨hmmax.isPrime, hmlies⟩
  have hsum := Ideal.sum_ramification_inertia (A1 K π n) K (K1 K π n) hpne
  rw [hprimes, Finset.sum_singleton, hmrami, finrank_K1 K π n hn hπ] at hsum
  have : n * Ideal.inertiaDeg' p m = n * 1 := by rw [hsum, mul_one]
  exact Nat.eq_of_mul_eq_mul_left (by omega) this

/-- If `n` is prime to the residue characteristic of `A` (`char kappa_A = 0`, or
`char kappa_A = p > 0` with `p ∤ n`), then `K_1 / K` is separable. -/
theorem isSeparable_K1 (hn : 2 ≤ n) (hπ : Irreducible π)
    (hcop : ringChar (A ⧸ IsLocalRing.maximalIdeal A) = 0 ∨
      Nat.Coprime (ringChar (A ⧸ IsLocalRing.maximalIdeal A)) n) :
    Algebra.IsSeparable K (K1 K π n) := by
  have hn1 : 1 ≤ n := by omega
  have := fact_irreducible_kummerPoly K π n hn hπ
  have hirr : Irreducible (kummerPoly K π n) := Fact.out
  have hinj : ∀ {a : A}, algebraMap A K a ≠ 0 ↔ a ≠ 0 :=
    map_ne_zero_iff _ (IsFractionRing.injective A K)
  have haK : algebraMap A K π ≠ 0 := hinj.mpr hπ.ne_zero
  have hnK : (n : K) ≠ 0 := by
    rw [← map_natCast (algebraMap A K) n]
    exact hinj.mpr (isUnit_natCast_of_coprime_ringChar n (by omega) hcop).ne_zero
  have hsep : (kummerPoly K π n).Separable := by
    rw [kummerPoly]
    exact Polynomial.separable_X_pow_sub_C _ hnK haK
  have hne : (kummerPoly K π n) ≠ 0 := hirr.ne_zero
  have hroot : IsSeparable K (AdjoinRoot.root (kummerPoly K π n)) := by
    rw [IsSeparable, AdjoinRoot.minpoly_root hne]
    have hu : IsUnit (C (kummerPoly K π n).leadingCoeff⁻¹) :=
      isUnit_C.mpr (IsUnit.inv (isUnit_iff_ne_zero.mpr (leadingCoeff_ne_zero.mpr hne)))
    exact Separable.mul_unit hsep hu
  have hint : IsIntegral K (AdjoinRoot.root (kummerPoly K π n)) :=
    IsSeparable.isIntegral hroot
  have hsa : Algebra.IsSeparable K
      (IntermediateField.adjoin K {AdjoinRoot.root (kummerPoly K π n)}) :=
    (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K
      (AdjoinRoot (kummerPoly K π n))).mpr hroot
  have htop : IntermediateField.adjoin K {AdjoinRoot.root (kummerPoly K π n)} =
      (⊤ : IntermediateField K (AdjoinRoot (kummerPoly K π n))) := by
    apply IntermediateField.toSubalgebra_injective
    rw [IntermediateField.top_toSubalgebra,
      IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic]
    simpa [AdjoinRoot.powerBasis_gen hne] using (AdjoinRoot.powerBasis hne).adjoin_gen_eq_top
  rw [htop] at hsa
  exact Algebra.IsSeparable.of_algHom K _ (IntermediateField.topEquiv.symm.toAlgHom)

set_option synthInstance.maxHeartbeats 1000000 in
-- `Ideal.inertiaDeg'` has no semantics-preserving replacement here: `Ideal.inertiaDeg` is a
-- different definition (residue fields of localizations), equal only under `LiesOver` plus
-- maximality, so migrating would change this statement.
set_option linter.deprecated false in
/-- If `n` is prime to the residue characteristic of `A`, then `K_1 / K` is tamely ramified
with respect to `A`. -/
@[stacks 09EV "(6)"]
theorem isTamelyRamified_K1 [Fact (Irreducible (kummerPoly K π n))]
    [Algebra.IsSeparable K (K1 K π n)]
    (hn : 2 ≤ n) (hπ : Irreducible π)
    (hcop : ringChar (A ⧸ IsLocalRing.maximalIdeal A) = 0 ∨
      Nat.Coprime (ringChar (A ⧸ IsLocalRing.maximalIdeal A)) n) :
    IsTamelyRamified A K (K1 K π n) := by
  intro m hm hlo
  obtain ⟨m₀, hm₀max, hm₀lo, hm₀uniq, hm₀rami⟩ := exists_ramificationIdx_eq K π n hn hπ
  have hmeq : m = m₀ := hm₀uniq m hm hlo
  subst hmeq
  have : m.LiesOver (IsLocalRing.maximalIdeal A) := hlo
  refine ⟨?_, ?_⟩
  · obtain ⟨m', hm'max, hm'lo, hm'uniq, hm'inertia⟩ := isTotallyRamified_K1 K π n hn hπ
    have hmeq' : m = m' := hm'uniq m hm₀max hlo
    subst hmeq'
    rw [Ideal.inertiaDeg'_algebraMap] at hm'inertia
    let : Field (A ⧸ IsLocalRing.maximalIdeal A) := Ideal.Quotient.field _
    let : Field (A1 K π n ⧸ m) := Ideal.Quotient.field _
    let alg := Ideal.Quotient.algebraOfLiesOver m (IsLocalRing.maximalIdeal A)
    have hb : Function.Bijective
        (algebraMap (A ⧸ IsLocalRing.maximalIdeal A) (A1 K π n ⧸ m)) := by
      rwa [Algebra.bijective_algebraMap_iff, ← Subalgebra.finrank_eq_one_iff,
        Subalgebra.topEquiv.toLinearEquiv.finrank_eq]
    let e : (A ⧸ IsLocalRing.maximalIdeal A) ≃+* (A1 K π n ⧸ m) :=
      RingEquiv.ofBijective _ hb
    refine Algebra.IsSeparable.of_equiv_equiv (RingEquiv.refl _) e ?_
    ext x
    simp [e]
  · rwa [hm₀rami]

end Statements

end Stacks.KummerExtension
