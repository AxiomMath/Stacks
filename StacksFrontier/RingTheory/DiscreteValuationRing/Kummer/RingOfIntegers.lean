@[expose] public section

/-!
# Kummer extensions of a discrete valuation ring

Let `A` be a discrete valuation ring with fraction field `K` and uniformizer `π`, represented by
`Irreducible π`, and let `n ≥ 2`. Let `K₁ = K[x]/(xⁿ - π)`, let `π'` be the image of `x`, and let
`A₁` be the integral closure of `A` in `K₁`. Then `[K₁ : K] = n`, the ring `A₁ = A[π']` is a
discrete valuation ring with uniformizer `π'`, and `K₁/K` is totally ramified with ramification
index `n`. If `n` is prime to the residue characteristic of `A`, then `K₁/K` is separable and
tamely ramified, and every intermediate field is `K[π^{1/d}]` for a divisor `d` of `n`.

If the residue characteristic of `A` is `p > 0`, then for every `n > 1` and every power `q` of `p`
there is a separable extension of `K` of degree `q`, totally ramified with respect to `A`, with a
uniformizer `π_B` of the integral closure satisfying `π_B^q = π + πⁿ b` and
`π_B^q = π + π_B^{nq} b'`.

## Main definitions

* `Stacks.KummerExtension.IsTotallyRamified`: a finite extension `L/K` is totally ramified with
  respect to `A`.
* `Stacks.KummerExtension.IsTamelyRamified`: a finite separable extension `L/K` is tamely ramified
  with respect to `A`.
* `Stacks.KummerExtension.A'`: the `A`-algebra `A[x]/(xⁿ - π)`.
* `Stacks.KummerExtension.K1`: the `K`-algebra `K₁ = K[x]/(xⁿ - π)`.
* `Stacks.KummerExtension.A1`: the integral closure `A₁` of `A` in `K₁`.
* `Stacks.KummerExtension.canonAlgEquiv`: the isomorphism `A[x]/(xⁿ - π) ≃ₐ[A] A₁`.

## Main results

* `Stacks.KummerExtension.finrank_K1`: `[K₁ : K] = n`.
* `Stacks.KummerExtension.integralClosure_eq_adjoin`: `A₁ = A[π']`.
* `Stacks.KummerExtension.isDiscreteValuationRing_A1`: `A₁` is a discrete valuation ring.
* `Stacks.KummerExtension.exists_ramificationIdx_eq`: `A₁` has a unique maximal ideal over the
  maximal ideal of `A`, with ramification index `n`.
* `Stacks.KummerExtension.isTotallyRamified_K1`: `K₁/K` is totally ramified with respect to `A`.
* `Stacks.KummerExtension.isTamelyRamified_K1`: if `n` is prime to the residue characteristic of
  `A`, then `K₁/K` is tamely ramified with respect to `A`.
* `Stacks.KummerExtension.intermediateField_eq_adjoin`: if `n` is prime to the residue
  characteristic of `A`, then every intermediate field of `K₁/K` is generated by `(π')^{n/d}`
  for a positive divisor `d` of `n`.
* `Stacks.EisensteinExtension.exists_totallyRamifiedExtension_with_uniformizer_eq`: totally
  ramified separable extensions of every `p`-power degree, with prescribed uniformizer.

## References

* [Stacks Project, Tag 09EV](https://stacks.math.columbia.edu/tag/09EV)
* [Stacks Project, Tag 09EW](https://stacks.math.columbia.edu/tag/09EW)
-/

open Polynomial

namespace Stacks.KummerExtension

/-! ## Total and tame ramification

We phrase total and tame ramification for a finite field extension `L / K`,
where `A` is a local ring (here a DVR) with `K` a `A`-algebra, and `B` is taken
to be `integralClosure A L`, the integral closure of `A` in `L`. The residue
extension at a prime `m` lying over `m_A` is the field extension
`(A / m_A) -> (B / m)` provided by `Ideal.Quotient.algebraOfLiesOver`. -/

-- `Ideal.inertiaDeg'` has no semantics-preserving replacement here: `Ideal.inertiaDeg` is a
-- different definition (residue fields of localizations), equal only under `LiesOver` plus
-- maximality, so migrating would change this statement.
set_option linter.deprecated false in
/-- A finite extension `L / K` is totally ramified with respect to `A` if
`B = integralClosure A L` has a unique maximal ideal `m` lying over the maximal ideal `m_A` of `A`,
and the residue field extension `kappa(m) / kappa_A` has inertia degree `1`. -/
def IsTotallyRamified (A K L : Type*)
    [CommRing A] [IsLocalRing A] [Field K] [Field L]
    [Algebra A K] [Algebra A L] [Algebra K L] [IsScalarTower A K L]
    [Module.Finite K L] : Prop :=
  ∃ m : Ideal (integralClosure A L), m.IsMaximal ∧
    m.LiesOver (IsLocalRing.maximalIdeal A) ∧
    (∀ m' : Ideal (integralClosure A L), m'.IsMaximal →
      m'.LiesOver (IsLocalRing.maximalIdeal A) → m' = m) ∧
    Ideal.inertiaDeg' (IsLocalRing.maximalIdeal A) m = 1

/-- A finite separable extension `L / K` is tamely ramified with respect to `A` if, for
`B = integralClosure A L` and every maximal ideal `m` of `B` lying over `m_A`, the residue
extension `kappa(m) / kappa_A` is separable, and the residue characteristic
`ringChar (A / m_A)` is `0` or prime to the ramification index of `m` over `m_A`. -/
def IsTamelyRamified (A K L : Type*)
    [CommRing A] [IsLocalRing A] [Field K] [Field L]
    [Algebra A K] [Algebra A L] [Algebra K L] [IsScalarTower A K L]
    [Module.Finite K L] [Algebra.IsSeparable K L] : Prop :=
  ∀ m : Ideal (integralClosure A L), m.IsMaximal →
    ∀ _ : m.LiesOver (IsLocalRing.maximalIdeal A),
      (@Algebra.IsSeparable (A ⧸ IsLocalRing.maximalIdeal A) (integralClosure A L ⧸ m) _ _
        (Ideal.Quotient.algebraOfLiesOver m (IsLocalRing.maximalIdeal A))) ∧
      (ringChar (A ⧸ IsLocalRing.maximalIdeal A) = 0 ∨
        Nat.Coprime (ringChar (A ⧸ IsLocalRing.maximalIdeal A))
          (Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m))

/-! ## The Kummer extension `K_1 = K[pi^{1/n}]` and its ring of integers -/

section Setup

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
variable (π : A) (n : ℕ)

/-- The Kummer polynomial `x^n - pi` over the base ring `A`. -/
noncomputable def kummerPolyA : A[X] := (X : A[X]) ^ n - C π

/-- The `A`-algebra `A' = A[x] / (x^n - pi)`. -/
noncomputable abbrev A' := AdjoinRoot (kummerPolyA π n)

/-- The image `pi'` of `x` in `A' = A[x] / (x^n - pi)`. -/
noncomputable abbrev piRootA : A' π n := AdjoinRoot.root (kummerPolyA π n)

/-- The Kummer polynomial `x^n - pi` over `K` (the image of `kummerPolyA` under
`A -> K`). -/
noncomputable def kummerPoly : K[X] := (X : K[X]) ^ n - C (algebraMap A K π)

/-- The `K`-algebra `K_1 = K[pi^{1/n}] = K[x] / (x^n - pi)`, a field when `x^n - pi` is
irreducible. -/
noncomputable abbrev K1 := AdjoinRoot (kummerPoly K π n)

/-- The chosen `n`-th root `pi' = pi^{1/n}` of `pi` in `K_1`, the image of `x`. -/
noncomputable abbrev piRoot : K1 K π n := AdjoinRoot.root (kummerPoly K π n)

/-- `A_1`, the integral closure of `A` in `K_1`. -/
noncomputable abbrev A1 : Subalgebra A (K1 K π n) := integralClosure A (K1 K π n)

end Setup

/-! ## Irreducibility, finiteness, and the free `A`-basis -/

section Basic

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
variable (π : A) (n : ℕ)

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- The chosen root `pi'` of `x^n - pi` in `A' = A[x] / (x^n - pi)` is an `n`-th root of
`pi`: `(pi')^n = pi`. -/
theorem piRootA_pow : (piRootA π n) ^ n = algebraMap A (A' π n) π := by
  have h := AdjoinRoot.eval₂_root (kummerPolyA π n)
  rw [kummerPolyA, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C] at h
  rw [sub_eq_zero] at h
  rw [AdjoinRoot.algebraMap_eq]; exact h

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- The Kummer polynomial `x^n - pi` is monic for `n >= 1`. -/
theorem kummerPolyA_monic (hn : 1 ≤ n) : (kummerPolyA π n).Monic :=
  monic_X_pow_sub_C π (Nat.one_le_iff_ne_zero.mp hn)

omit [IsDiscreteValuationRing A] in
/-- The Kummer polynomial `x^n - pi` over `A` has degree `n`. -/
theorem kummerPolyA_natDegree : (kummerPolyA π n).natDegree = n := by
  rw [kummerPolyA, natDegree_X_pow_sub_C]

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- The Kummer polynomial `x^n - pi` over `K` has degree `n`. -/
theorem kummerPoly_natDegree : (kummerPoly K π n).natDegree = n := by
  rw [kummerPoly, natDegree_X_pow_sub_C]

/-- If `pi` is a uniformizer of the DVR `A` and `n >= 1`, then `x^n - pi` is Eisenstein
at `(pi)`. -/
theorem kummerPolyA_isEisensteinAt (hn : 1 ≤ n) (hπ : Irreducible π) :
    (kummerPolyA π n).IsEisensteinAt (Ideal.span {π}) := by
  have hprime : (Ideal.span {π}).IsPrime :=
    (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ.prime
  constructor
  · rw [kummerPolyA, leadingCoeff_X_pow_sub_C (by omega)]
    exact fun hmem ↦ hprime.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem isUnit_one)
  · intro k hk
    rw [kummerPolyA_natDegree] at hk
    rw [kummerPolyA, coeff_sub, coeff_X_pow, coeff_C]
    obtain rfl | hk0 := Nat.eq_zero_or_pos k
    · simp only [ite_eq_right (by omega : ¬ (0 : ℕ) = n), zero_sub, ite_true]
      exact neg_mem (Ideal.mem_span_singleton_self π)
    · simp only [ite_eq_right (by omega : ¬ k = n), ite_eq_right (by omega : ¬ k = 0), sub_zero]
      exact Ideal.zero_mem _
  · rw [kummerPolyA, coeff_sub, coeff_X_pow, coeff_C]
    simp only [ite_eq_right (by omega : ¬ (0 : ℕ) = n), zero_sub, ite_true]
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton, dvd_neg]
    exact fun hdvd ↦ hπ.not_isUnit <| isUnit_of_dvd_one <|
      (mul_dvd_mul_iff_left hπ.ne_zero).mp (by simpa [pow_two] using hdvd)

/-- If `pi` is a uniformizer of the DVR `A` and `n >= 1`, then `x^n - pi` is irreducible
over `A`. -/
private theorem kummerPolyA_irreducible (hn : 1 ≤ n) (hπ : Irreducible π) :
    Irreducible (kummerPolyA π n) :=
  (kummerPolyA_isEisensteinAt π n hn hπ).irreducible
    ((Ideal.span_singleton_prime hπ.ne_zero).mpr hπ.prime)
    (kummerPolyA_monic π n hn).isPrimitive (by rw [kummerPolyA_natDegree]; omega)

/-- If `pi` is a uniformizer of the DVR `A` and `n >= 1`, then `x^n - pi` is irreducible over
`K`. -/
theorem kummerPoly_irreducible (hn : 1 ≤ n) (hπ : Irreducible π) :
    Irreducible (kummerPoly K π n) := by
  have hmonic : (kummerPolyA π n).Monic := kummerPolyA_monic π n hn
  have hmap : map (algebraMap A K) (kummerPolyA π n) = kummerPoly K π n := by
    rw [kummerPolyA, kummerPoly]; simp
  rw [kummerPoly] at *
  rw [← hmap, ← hmonic.irreducible_iff_irreducible_map_fraction_map]
  exact kummerPolyA_irreducible π n hn hπ

/-- The `A`-power basis `1, pi', ..., (pi')^{n-1}` of `A' = A[x] / (x^n - pi)`. -/
noncomputable def powerBasisA' (hn : 1 ≤ n) : PowerBasis A (A' π n) :=
  AdjoinRoot.powerBasis' (kummerPolyA_monic π n hn)

omit [IsDiscreteValuationRing A] in
/-- The power basis `powerBasisA' π n hn` of `A'` over `A` has dimension `n`. -/
@[simp]
theorem powerBasisA'_dim (hn : 1 ≤ n) : (powerBasisA' π n hn).dim = n := by
  rw [powerBasisA', AdjoinRoot.powerBasis'_dim, kummerPolyA_natDegree]

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- The generator of the power basis `powerBasisA' π n hn` is `pi'`, the image of `x` in `A'`. -/
@[simp]
theorem powerBasisA'_gen (hn : 1 ≤ n) : (powerBasisA' π n hn).gen = piRootA π n := by
  rw [powerBasisA', AdjoinRoot.powerBasis'_gen]

omit [IsDiscreteValuationRing A] in
/-- Every element of `A' = A[x]/(x^n - pi)` is the image of a polynomial of degree `< n`,
namely of its remainder modulo the monic polynomial `x^n - pi`. -/
theorem exists_natDegree_lt_mk_eq (hn : 1 ≤ n) (w : A' π n) :
    ∃ g : A[X], g.natDegree < n ∧ AdjoinRoot.mk (kummerPolyA π n) g = w := by
  obtain ⟨g₀, rfl⟩ := AdjoinRoot.mk_surjective (g := kummerPolyA π n) w
  have hmonic : (kummerPolyA π n).Monic := kummerPolyA_monic π n hn
  have hfdeg : (kummerPolyA π n).natDegree = n := kummerPolyA_natDegree π n
  have hfne1 : (kummerPolyA π n) ≠ 1 := by
    intro h; rw [h] at hfdeg; simp at hfdeg; omega
  refine ⟨g₀ %ₘ (kummerPolyA π n), ?_, ?_⟩
  · have hlt := natDegree_modByMonic_lt g₀ hmonic hfne1
    rwa [hfdeg] at hlt
  · rw [AdjoinRoot.mk_eq_mk, modByMonic_eq_sub_mul_div g₀ (kummerPolyA π n)]
    exact ⟨-(g₀ /ₘ (kummerPolyA π n)), by ring⟩

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- A polynomial `g` of degree `< n` represents in `A' = A[x]/(x^n - pi)` the sum of its
coefficients against the free `A`-basis `1, pi', ..., (pi')^(n-1)`. -/
theorem mk_eq_sum_range (g : A[X]) (hdeg : g.natDegree < n) :
    AdjoinRoot.mk (kummerPolyA π n) g
      = ∑ i ∈ Finset.range n, algebraMap A (A' π n) (g.coeff i) * (piRootA π n) ^ i := by
  classical
  set f : ℕ → A' π n := fun i ↦ algebraMap A (A' π n) (g.coeff i) * (piRootA π n) ^ i with hf
  have hfF : ∀ i, f i
      = AdjoinRoot.of (kummerPolyA π n) (g.coeff i) * (AdjoinRoot.root (kummerPolyA π n)) ^ i := by
    intro i; rw [hf]; simp only [AdjoinRoot.algebraMap_eq]
  have hrep : AdjoinRoot.mk (kummerPolyA π n) g
      = ∑ i ∈ Finset.range (g.natDegree + 1), f i := by
    conv_lhs => rw [g.as_sum_range' (g.natDegree + 1) (Nat.lt_succ_self _)]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [hfF, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, AdjoinRoot.mk_C, map_pow,
        AdjoinRoot.mk_X]
  rw [hrep]
  apply Finset.sum_subset
  · intro i hi
    rw [Finset.mem_range] at hi ⊢
    omega
  · intro i _ hi
    rw [Finset.mem_range, not_lt] at hi
    rw [hf]
    simp only
    rw [g.coeff_eq_zero_of_natDegree_lt (by omega), map_zero, zero_mul]

end Basic

/-! ## The canonical map `A' = A[x]/(x^n - pi) -> K_1` -/

section CanonMap

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
variable (π : A) (n : ℕ)

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- The element `pi' = pi^{1/n}` of `K_1` is a root of the Kummer polynomial
`x^n - pi` over the base ring `A` (evaluated through `A -> K_1`). -/
theorem kummerPolyA_eval_piRoot :
    eval₂ ((algebraMap A (K1 K π n)) : A →+* (K1 K π n)) (piRoot K π n)
      (kummerPolyA π n) = 0 := by
  have hroot := AdjoinRoot.eval₂_root (kummerPoly K π n)
  rw [kummerPoly, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C] at hroot
  rw [kummerPolyA, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
  have htower : (algebraMap A (K1 K π n)) π
      = (AdjoinRoot.of (kummerPoly K π n)) ((algebraMap A K) π) := by
    change (algebraMap A (K1 K π n)) π = (algebraMap K (K1 K π n)) ((algebraMap A K) π)
    rw [← IsScalarTower.algebraMap_apply A K (K1 K π n)]
  rw [htower]
  change AdjoinRoot.root (kummerPoly K π n) ^ n
      - (AdjoinRoot.of (kummerPoly K π n)) ((algebraMap A K) π) = 0
  rw [kummerPoly]
  exact hroot

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- The chosen `n`-th root `pi' = pi^{1/n}` of `pi` in `K_1` satisfies `(pi')^n = pi`. -/
theorem piRoot_pow : (piRoot K π n) ^ n = algebraMap A (K1 K π n) π := by
  have h := kummerPolyA_eval_piRoot K π n
  rwa [kummerPolyA, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C, sub_eq_zero] at h

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- For a divisor `d` of `n`, the element `(pi')^(n/d)` of `K_1` is a `d`-th root of `pi`. -/
theorem piRoot_pow_div_pow {d : ℕ} (hdvd : d ∣ n) :
    ((piRoot K π n) ^ (n / d)) ^ d = algebraMap A (K1 K π n) π := by
  rw [← pow_mul, Nat.div_mul_cancel hdvd, piRoot_pow]

/-- The **canonical `A`-algebra map** `A' = A[x]/(x^n - pi) -> K_1`, sending the
image `pi'` of `x` in `A'` to the chosen `n`-th root `pi'` of `pi` in `K_1`. -/
noncomputable def canonAlgHom : A' π n →ₐ[A] K1 K π n :=
  AdjoinRoot.liftAlgHom (kummerPolyA π n) (Algebra.ofId A (K1 K π n)) (piRoot K π n)
    (by have := kummerPolyA_eval_piRoot K π n; simpa using this)

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- The canonical map `A' -> K_1` sends the image `pi'` of `x` in `A'` to the chosen `n`-th root
`pi'` of `pi` in `K_1`. -/
@[simp]
theorem canonAlgHom_piRootA :
    canonAlgHom K π n (piRootA π n) = piRoot K π n := by
  rw [canonAlgHom]
  exact AdjoinRoot.liftAlgHom_root (kummerPolyA π n) (Algebra.ofId A (K1 K π n))
    (piRoot K π n) _

omit [IsDomain A] [IsDiscreteValuationRing A] [IsFractionRing A K] in
/-- The range of the canonical map `A' -> K_1` is the `A`-subalgebra `A[pi']` generated by
the chosen `n`-th root `pi'` of `pi`. -/
theorem canonAlgHom_range_eq_adjoin (hn : 1 ≤ n) :
    (canonAlgHom K π n).range = Algebra.adjoin A {piRoot K π n} := by
  rw [← Algebra.map_top, ← (powerBasisA' π n hn).adjoin_gen_eq_top,
    powerBasisA'_gen π n hn, ← Algebra.adjoin_image, Set.image_singleton,
    canonAlgHom_piRootA]

end CanonMap

/-! ## The residue characteristic -/

section ResidueChar

/-- If `n` is nonzero and prime to the residue characteristic of a local ring `R`
(either `char kappa_R = 0`, or `char kappa_R` is prime to `n`), then `n` is a unit in `R`. -/
@[ega "0 21.1.3" "special case"]
theorem isUnit_natCast_of_coprime_ringChar {R : Type*} [CommRing R] [IsLocalRing R] (n : ℕ)
    (hn : n ≠ 0)
    (hcop : ringChar (R ⧸ IsLocalRing.maximalIdeal R) = 0 ∨
      Nat.Coprime (ringChar (R ⧸ IsLocalRing.maximalIdeal R)) n) :
    IsUnit (n : R) := by
  rw [← IsLocalRing.notMem_maximalIdeal]
  intro hmem
  have hzero : ((n : R) : R ⧸ IsLocalRing.maximalIdeal R) = 0 :=
    (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
  rw [map_natCast] at hzero
  have hdvd : ringChar (R ⧸ IsLocalRing.maximalIdeal R) ∣ n :=
    (ringChar.spec _ n).mp hzero
  rcases hcop with hc0 | hccop
  · rw [hc0, Nat.zero_dvd] at hdvd; exact hn hdvd
  · have hg1 : Nat.gcd (ringChar (R ⧸ IsLocalRing.maximalIdeal R)) n
        = ringChar (R ⧸ IsLocalRing.maximalIdeal R) := Nat.gcd_eq_left hdvd
    rw [hccop] at hg1
    have : (1 : R ⧸ IsLocalRing.maximalIdeal R) = 0 := by
      have := ringChar.spec (R ⧸ IsLocalRing.maximalIdeal R) 1
      rw [Nat.cast_one] at this
      exact this.mpr (by rw [hg1])
    exact one_ne_zero this

end ResidueChar


/-! ## Degree, ring of integers and ramification of `K_1` -/

section Statements

variable {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
variable (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
variable (π : A) (n : ℕ)

/-- `K_1 = K[pi^{1/n}]` is finite-dimensional over `K` when `x^n - pi` is irreducible. -/
instance instFiniteK1 [Fact (Irreducible (kummerPoly K π n))] :
    Module.Finite K (K1 K π n) :=
  PowerBasis.finite (AdjoinRoot.powerBasis (f := kummerPoly K π n)
    (Fact.out (p := Irreducible (kummerPoly K π n))).ne_zero)

/-- `[K_1 : K] = n`. -/
@[stacks 09EV "(1)"]
theorem finrank_K1 (hn : 2 ≤ n) (hπ : Irreducible π) :
    Module.finrank K (K1 K π n) = n := by
  have hirr := kummerPoly_irreducible K π n (by omega) hπ
  have hne : (kummerPoly K π n) ≠ 0 := hirr.ne_zero
  rw [(AdjoinRoot.powerBasis hne).finrank, AdjoinRoot.powerBasis_dim]
  rw [kummerPoly_natDegree]

/-- The minimal polynomial of `pi'` over `A` is `x^n - pi`. -/
theorem minpoly_piRoot (hn : 1 ≤ n) (hπ : Irreducible π) :
    minpoly A (piRoot K π n) = kummerPolyA π n := by
  have : Fact (Irreducible (kummerPoly K π n)) := ⟨kummerPoly_irreducible K π n hn hπ⟩
  have hmonic : (kummerPolyA π n).Monic := kummerPolyA_monic π n (by omega)
  have hmpEval : aeval (piRoot K π n) (kummerPolyA π n) = 0 := by
    simpa [aeval_def] using kummerPolyA_eval_piRoot K π n
  have hpiInt : IsIntegral A (piRoot K π n) := ⟨_, hmonic, hmpEval⟩
  have hTF : Module.IsTorsionFree A (K1 K π n) := by
    rw [Module.isTorsionFree_iff_algebraMap_injective,
      IsScalarTower.algebraMap_eq A K (K1 K π n), RingHom.coe_comp]
    exact (algebraMap K (K1 K π n)).injective.comp (IsFractionRing.injective A K)
  have hKirr := kummerPolyA_irreducible π n hn hπ
  refine eq_of_monic_of_associated (minpoly.monic hpiInt) hmonic ?_
  obtain ⟨c, hc⟩ := minpoly.isIntegrallyClosed_dvd hpiInt hmpEval
  rcases hKirr.isUnit_or_isUnit hc with hu | hu
  · exact absurd hu (minpoly.not_isUnit A _)
  · exact ⟨hu.unit, by rw [hc]; rfl⟩

/-- Every element of `K_1` becomes an element of `A[pi']` after multiplication by a
power of `pi`. -/
theorem exists_pow_smul_mem_adjoin_piRoot (hn : 1 ≤ n) (hπ : Irreducible π)
    (z : K1 K π n) : ∃ m : ℕ, π ^ m • z ∈ Algebra.adjoin A {piRoot K π n} := by
  have hirr := kummerPoly_irreducible K π n hn hπ
  have : Fact (Irreducible (kummerPoly K π n)) := ⟨hirr⟩
  set pbK := AdjoinRoot.powerBasis (f := kummerPoly K π n) hirr.ne_zero with hpbK
  have hgenK : pbK.gen = piRoot K π n := by rw [hpbK, AdjoinRoot.powerBasis_gen]
  obtain ⟨f, _, hfz⟩ := pbK.exists_eq_aeval z
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A)
    (Finset.range (f.natDegree + 1)) (fun i ↦ f.coeff i)
  have hbne : (b : A) ≠ 0 := nonZeroDivisors.coe_ne_zero b
  obtain ⟨m, u, hbu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hbne hπ
  refine ⟨m, ?_⟩
  have hbz : (b : A) • z ∈ Algebra.adjoin A {piRoot K π n} := by
    rw [← IsScalarTower.algebraMap_smul K (b : A) z]
    have hsmul : (algebraMap A K (b : A)) • z
        = (aeval (piRoot K π n)) (Polynomial.C (algebraMap A K (b:A)) * f) := by
      rw [map_mul, aeval_C, hfz, ← hgenK, Algebra.smul_def]
    rw [hsmul]
    set q : K[X] := Polynomial.C (algebraMap A K (b:A)) * f with hq
    have hlift : q ∈ Polynomial.lifts (algebraMap A K) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rcases le_or_gt (f.natDegree + 1) i with hi | hi
      · refine ⟨0, ?_⟩
        rw [map_zero, hq, coeff_C_mul]
        have : f.coeff i = 0 := f.coeff_eq_zero_of_natDegree_lt (by omega)
        rw [this, mul_zero]
      · obtain ⟨a, ha⟩ := hb i (Finset.mem_range.mpr hi)
        refine ⟨a, ?_⟩
        rw [Algebra.smul_def] at ha
        rw [hq, coeff_C_mul, ha]
    obtain ⟨g, hg⟩ := hlift
    rw [← hg, Polynomial.coe_mapRingHom, Polynomial.aeval_map_algebraMap]
    exact aeval_mem_adjoin_singleton A _
  have key : (π ^ m : A) • z = ((u⁻¹ : Aˣ) : A) • ((b : A) • z) := by
    rw [smul_smul, hbu]
    congr 1
    rw [← mul_assoc]
    simp
  rw [key]
  exact Subalgebra.smul_mem _ hbz _

/-- The range of the canonical `A`-algebra map `A' = A[x]/(x^n - pi) -> K_1` is the integral
closure `A_1`. -/
theorem canonAlgHom_range (hn : 2 ≤ n) (hπ : Irreducible π) :
    (canonAlgHom K π n).range = A1 K π n := by
  have hn1 : 1 ≤ n := by omega
  have hirr : Irreducible (kummerPoly K π n) := kummerPoly_irreducible K π n hn1 hπ
  have : Fact (Irreducible (kummerPoly K π n)) := ⟨hirr⟩
  have hpiMem : piRoot K π n ∈ A1 K π n := by
    refine ⟨kummerPolyA π n, kummerPolyA_monic π n (by omega), ?_⟩
    simpa [aeval_def] using kummerPolyA_eval_piRoot K π n
  rw [canonAlgHom_range_eq_adjoin K π n hn1]
  apply le_antisymm
  · exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr hpiMem)
  · intro z hz
    set pbK := AdjoinRoot.powerBasis (f := kummerPoly K π n) hirr.ne_zero with hpbK
    have hgenK : pbK.gen = piRoot K π n := by rw [hpbK, AdjoinRoot.powerBasis_gen]
    obtain ⟨m, hm⟩ := exists_pow_smul_mem_adjoin_piRoot K π n hn1 hπ z
    have := mem_adjoin_of_smul_prime_pow_smul_of_minpoly_isEisensteinAt
      (R := A) (K := K) (L := K1 K π n) (B := pbK) hπ.prime (by rwa [hgenK]) hz (n := m)
      (by rwa [hgenK]) (by
        rw [hgenK, minpoly_piRoot K π n hn1 hπ]
        exact kummerPolyA_isEisensteinAt π n hn1 hπ)
    rwa [hgenK] at this

/-- The canonical `A`-algebra map `A' = A[x]/(x^n - pi) -> K_1` is injective. -/
theorem canonAlgHom_injective (hn : 2 ≤ n) (hπ : Irreducible π) :
    Function.Injective (canonAlgHom K π n) := by
  have hn1 : 1 ≤ n := by omega
  have hirr := kummerPoly_irreducible K π n hn1 hπ
  set pbA := powerBasisA' π n hn1 with hpbA
  have hdimA : pbA.dim = n := powerBasisA'_dim π n hn1
  have hgenA : pbA.gen = piRootA π n := powerBasisA'_gen π n hn1
  set pbK := AdjoinRoot.powerBasis (f := kummerPoly K π n) hirr.ne_zero with hpbK
  have hdimK : pbK.dim = n := by
    rw [hpbK, AdjoinRoot.powerBasis_dim, kummerPoly_natDegree]
  have hgenK : pbK.gen = piRoot K π n := by rw [hpbK, AdjoinRoot.powerBasis_gen]
  have hAKinj : Function.Injective (algebraMap A K) := FaithfulSMul.algebraMap_injective A K
  have hsmul : Function.Injective (fun r : A ↦ r • (1 : K)) := by
    simpa [Algebra.smul_def] using hAKinj
  have hLIK : LinearIndependent K (fun i : Fin pbA.dim ↦ piRoot K π n ^ (i : ℕ)) := by
    have hLIpbK : LinearIndependent K (fun j : Fin pbK.dim ↦ piRoot K π n ^ (j : ℕ)) := by
      have heq : (fun j : Fin pbK.dim ↦ piRoot K π n ^ (j : ℕ)) = ⇑pbK.basis := by
        funext j; rw [PowerBasis.basis_eq_pow, hgenK]
      rw [heq]; exact pbK.basis.linearIndependent
    have hcast : pbK.dim = pbA.dim := by rw [hdimA, hdimK]
    exact hcast ▸ hLIpbK
  have hLIA : LinearIndependent A (fun i : Fin pbA.dim ↦ piRoot K π n ^ (i : ℕ)) :=
    hLIK.restrict_scalars hsmul
  have himg : (⇑(canonAlgHom K π n).toLinearMap ∘ ⇑pbA.basis)
      = (fun i : Fin pbA.dim ↦ piRoot K π n ^ (i : ℕ)) := by
    funext i
    simp only [Function.comp_apply, AlgHom.toLinearMap_apply, pbA.basis_eq_pow, hgenA,
      map_pow, canonAlgHom_piRootA]
  have hLIimg : LinearIndependent A (⇑(canonAlgHom K π n).toLinearMap ∘ ⇑pbA.basis) := by
    rw [himg]; exact hLIA
  have hinj : Function.Injective ⇑(canonAlgHom K π n).toLinearMap := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [Fintype.linearIndependent_iff] at hLIimg
    have hsum : ∑ i, (pbA.basis.repr x i) •
        (⇑(canonAlgHom K π n).toLinearMap ∘ ⇑pbA.basis) i = 0 := by
      have h2 : (canonAlgHom K π n).toLinearMap
          (∑ i, (pbA.basis.repr x i) • pbA.basis i) = 0 := by
        rw [pbA.basis.sum_repr x]; exact hx
      rw [map_sum] at h2
      simp only [map_smul] at h2
      exact h2
    have hall := hLIimg (fun i ↦ pbA.basis.repr x i) hsum
    have hz : pbA.basis.repr x = 0 := by ext i; exact hall i
    exact pbA.basis.repr.injective (by rw [hz]; simp : pbA.basis.repr x = pbA.basis.repr 0)
  exact hinj

/-- The canonical `A`-algebra isomorphism `A' = A[x]/(x^n - pi) ≃ₐ[A] A_1`, the corestriction
of `canonAlgHom` to its range. -/
noncomputable def canonAlgEquiv (hn : 2 ≤ n) (hπ : Irreducible π) :
    A' π n ≃ₐ[A] A1 K π n :=
  (AlgEquiv.ofInjective (canonAlgHom K π n) (canonAlgHom_injective K π n hn hπ)).trans
    (Subalgebra.equivOfEq _ _ (canonAlgHom_range K π n hn hπ))

/-- Viewed inside `K_1`, the canonical isomorphism `A' ≃ₐ[A] A_1` is the canonical map
`canonAlgHom`. -/
@[simp]
theorem canonAlgEquiv_coe_apply (hn : 2 ≤ n) (hπ : Irreducible π) (x : A' π n) :
    ((canonAlgEquiv K π n hn hπ x : K1 K π n)) = canonAlgHom K π n x := by
  simp [canonAlgEquiv, AlgEquiv.ofInjective_apply]

/-- The integral closure `A_1` of `A` in `K_1` is the `A`-subalgebra `A[pi'] = A[pi^{1/n}]`
generated by `pi'`. -/
@[stacks 09EV "(2)"]
theorem integralClosure_eq_adjoin (hn : 2 ≤ n) (hπ : Irreducible π) :
    (A1 K π n) = Algebra.adjoin A {piRoot K π n} := by
  rw [← canonAlgHom_range_eq_adjoin K π n (by omega), canonAlgHom_range K π n hn hπ]

end Statements

end Stacks.KummerExtension
