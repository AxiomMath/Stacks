theorem perfectRing_of_range_eq_iInter_pow
    {R S : Type*} [CommRing R] [CommRing S] [IsReduced S]
    (p : ℕ) [ExpChar S p] (f : R →+* S) (hf : Function.Injective f)
    (h : ∀ x : S, x ∈ Set.range f ↔
      ∀ n : ℕ, 1 ≤ n → ∃ y : S, y ^ (p ^ n) = x) : PerfectRing R p := by
  have hinj : Function.Injective (fun x : S => x ^ p) := frobenius_inj S p
  refine ⟨⟨?_, ?_⟩⟩
  · intro x y hxy
    apply hf
    apply hinj
    simp only [← map_pow, hxy]
  · intro x
    obtain ⟨y, hy⟩ := (h (f x)).mp ⟨x, rfl⟩ 1 le_rfl
    simp only [pow_one] at hy
    have hyrange : y ∈ Set.range f := by
      apply (h y).mpr
      intro n hn
      obtain ⟨z, hz⟩ := (h (f x)).mp ⟨x, rfl⟩ (n + 1) (by omega)
      refine ⟨z, hinj ?_⟩
      show (z ^ (p ^ n)) ^ p = y ^ p
      rw [← pow_mul, ← pow_succ, hz, hy]
    obtain ⟨a, ha⟩ := hyrange
    refine ⟨a, hf ?_⟩
    simpa only [map_pow, ha] using hy

theorem exists_pow_eq_and_not_isPow
    {R : Type*} [Monoid R] (p : ℕ) (x : R)
    (h : ∃ n : ℕ, ¬∃ y : R, y ^ (p ^ n) = x) :
    ∃ (r : ℕ) (y : R), y ^ (p ^ r) = x ∧ ¬∃ z : R, z ^ p = y := by
  classical
  let n := Nat.find h
  have hn : ¬∃ y : R, y ^ (p ^ n) = x := Nat.find_spec h
  have hnpos : 0 < n := by
    by_contra hn0
    have hzero : n = 0 := by omega
    exact hn ⟨x, by simp [hzero]⟩
  have hprev : ∃ y : R, y ^ (p ^ (n - 1)) = x := by
    by_contra hprev
    exact Nat.find_min h (by dsimp [n]; omega) hprev
  obtain ⟨y, hy⟩ := hprev
  refine ⟨n - 1, y, hy, ?_⟩
  rintro ⟨z, hz⟩
  apply hn
  refine ⟨z, ?_⟩
  rw [show n = (n - 1) + 1 by omega, pow_succ', pow_mul, hz, hy]

theorem level_decrement_bounds
    (n e p : ℕ) (hn : 0 < n) (he : 0 < e) (hfinite : n < p * e) :
    let m := min n (min e (p * e - n))
    0 < m ∧ m ≤ n ∧ m ≤ e ∧
      ((n - m : ℕ) : ℚ) / e =
        max 0 (max ((n : ℚ) / e - 1) (2 * ((n : ℚ) / e) - p)) := by
  dsimp only
  have hm : min n (min e (p * e - n)) ≤ n := min_le_left _ _
  refine ⟨by omega, hm, by omega, ?_⟩
  have heq : (e : ℚ) ≠ 0 := by positivity
  have hpos : (0 : ℚ) < e := by positivity
  apply (div_eq_iff heq).mpr
  rw [max_mul_of_nonneg _ _ hpos.le, max_mul_of_nonneg _ _ hpos.le,
    zero_mul, sub_mul, sub_mul, div_mul_cancel₀ _ heq, one_mul,
    mul_assoc, div_mul_cancel₀ _ heq]
  rw [Nat.cast_sub hm]
  have hne : (n : ℚ) ≤ p * e := by exact_mod_cast hfinite.le
  have hnat : ((p * e - n : ℕ) : ℚ) = p * e - n := by
    rw [Nat.cast_sub hfinite.le, Nat.cast_mul]
  simp only [Nat.cast_min, hnat]
  simp only [min_def, max_def]
  split_ifs <;> linarith

/-- Elements with the same residue differ by a multiple of the uniformizer. -/
private theorem exists_eq_add_mul_of_residue_eq
    {R : Type*} [CommRing R] [IsLocalRing R] {π : R}
    (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π}) {x y : R}
    (h : IsLocalRing.residue R x = IsLocalRing.residue R y) : ∃ c : R, x = y + π * c := by
  have hxy : x - y ∈ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, h, sub_self]
  rw [hπ, Ideal.mem_span_singleton] at hxy
  obtain ⟨c, hc⟩ := hxy
  exact ⟨c, by linear_combination hc⟩

theorem exists_eq_sum_pow_add_pow_mul
    {R : Type*} [CommRing R] [IsLocalRing R]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π})
    (σ : IsLocalRing.ResidueField R → R)
    (hσ : ∀ x, IsLocalRing.residue R (σ x) = x) (a : R) (m : ℕ) :
    ∃ (cfs : ℕ → IsLocalRing.ResidueField R) (b : R),
      a = (∑ i ∈ Finset.range m, σ (cfs i) * π ^ i) + π ^ m * b := by
  classical
  have hdigit : ∀ b : R, ∃ c : R, b = σ (IsLocalRing.residue R b) + π * c := fun b =>
    exists_eq_add_mul_of_residue_eq hπ (hσ _).symm
  induction m with
  | zero => exact ⟨fun _ => 0, a, by simp⟩
  | succ m ih =>
    obtain ⟨cfs, b, hab⟩ := ih
    obtain ⟨c, hbc⟩ := hdigit b
    refine ⟨Function.update cfs m (IsLocalRing.residue R b), c, ?_⟩
    rw [Finset.sum_range_succ, Function.update_self]
    have hsum :
        (∑ i ∈ Finset.range m,
          σ (Function.update cfs m (IsLocalRing.residue R b) i) * π ^ i) =
        ∑ i ∈ Finset.range m, σ (cfs i) * π ^ i := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [Function.update_of_ne (Nat.ne_of_lt (Finset.mem_range.mp hi))]
    rw [hsum, hab, pow_succ]
    linear_combination π ^ m * hbc

theorem adjoin_affine_eq_top
    {K L : Type*} [Field K] [CommRing L] [Algebra K L]
    (a b : K) (ha : a ≠ 0) (z : L)
    (hz : Algebra.adjoin K ({z} : Set L) = ⊤) :
    Algebra.adjoin K ({algebraMap K L a * z + algebraMap K L b} : Set L) = ⊤ := by
  let S := Algebra.adjoin K ({algebraMap K L a * z + algebraMap K L b} : Set L)
  have hzS : z ∈ S := by
    have hmul : algebraMap K L a * z ∈ S := by
      have := S.sub_mem (Algebra.subset_adjoin
        (Set.mem_singleton (algebraMap K L a * z + algebraMap K L b)))
        (S.algebraMap_mem b)
      simpa only [add_sub_cancel_right] using this
    have := S.mul_mem (S.algebraMap_mem a⁻¹) hmul
    simpa only [← mul_assoc, ← map_mul, inv_mul_cancel₀ ha, map_one, one_mul] using this
  apply top_unique
  rw [← hz]
  apply Algebra.adjoin_le
  intro y hy
  rcases hy with rfl
  exact hzS

theorem aeval_cyclotomic_add
    {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    {p : ℕ} [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (hP : funcEq f P) (x y : R) :
    Polynomial.aeval (x + y + algebraMap A R (wElt f) * x * y) P =
      Polynomial.aeval x P + Polynomial.aeval y P +
        algebraMap A R (wElt f) ^ p * Polynomial.aeval x P * Polynomial.aeval y P := by
  let φ : MvPolynomial (Fin 2) A →ₐ[A] R :=
    MvPolynomial.aeval (fun i => if i = 0 then x else y)
  have h := congrArg φ hP
  simpa [φ, funcEq, ← Polynomial.aeval_algHom_apply] using h

/-- **A finiteness datum for the level yields an admissible numerator `p * e - 1`.**

If `w` is associated to `π ^ e` and `w ^ p * ξ` is the image of an element of `A` divisible by `π`,
then `π ^ (p * e - 1) * ξ` is itself in the image of `A`. -/
theorem mul_pow_sub_one_mul_mem_range
    {A K : Type*} [CommRing A] [Field K] [Algebra A K]
    (π w : A) (hπ : algebraMap A K π ≠ 0)
    (p e : ℕ) (hpe : 0 < p * e) (hw : Associated w (π ^ e))
    (ξ : K) (a : A) (ha : π ∣ a)
    (hξ : algebraMap A K a = algebraMap A K w ^ p * ξ) :
    ∃ b : A, algebraMap A K b = algebraMap A K (π ^ (p * e - 1)) * ξ := by
  obtain ⟨b, rfl⟩ := ha
  obtain ⟨v, hv⟩ := hw
  refine ⟨b * (v : A) ^ p, ?_⟩
  have hwv : w ^ p * (v : A) ^ p = π ^ (p * e) := by
    rw [← mul_pow, hv, ← pow_mul, Nat.mul_comm]
  have hexp : π ^ (p * e) = π * π ^ (p * e - 1) := (mul_pow_sub_one hpe.ne' π).symm
  apply mul_left_cancel₀ hπ
  calc
    algebraMap A K π * algebraMap A K (b * (v : A) ^ p) =
        algebraMap A K (π * b) * algebraMap A K ((v : A) ^ p) := by
      simp only [map_mul]
      ring
    _ = (algebraMap A K w ^ p * ξ) * algebraMap A K ((v : A) ^ p) := by rw [hξ]
    _ = algebraMap A K (w ^ p * (v : A) ^ p) * ξ := by
      simp only [map_mul, map_pow]
      ring
    _ = algebraMap A K (π ^ (p * e)) * ξ := by rw [hwv]
    _ = algebraMap A K π * (algebraMap A K (π ^ (p * e - 1)) * ξ) := by
      rw [hexp, map_mul, mul_assoc]

private theorem valuation_eval₂_monic_of_one_lt
    {A R Γ : Type*} [Semiring A] [Ring R]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation R Γ) (f : A →+* R)
    (P : Polynomial A) (hP : P.Monic)
    (hcoeff : ∀ i < P.natDegree, v (f (P.coeff i)) ≤ 1)
    (x : R) (hx : 1 < v x) : v (P.eval₂ f x) = v x ^ P.natDegree := by
  classical
  rw [Polynomial.eval₂_eq_sum_range]
  have htop : v (f (P.coeff P.natDegree) * x ^ P.natDegree) =
      v x ^ P.natDegree := by
    simp only [Polynomial.coeff_natDegree, hP.leadingCoeff, map_one, one_mul, map_pow]
  rw [← htop]
  apply v.map_sum_eq_of_lt (Finset.mem_range.mpr (Nat.lt_succ_self _))
  intro i hi
  have hid : i < P.natDegree := by
    have ⟨hi, hne⟩ := Finset.mem_sdiff.mp hi
    have hin := Finset.mem_range.mp hi
    have hine : i ≠ P.natDegree := by simpa only [Finset.mem_singleton] using hne
    omega
  rw [htop, map_mul, map_pow]
  have hle : v (f (P.coeff i)) * v x ^ i ≤ v x ^ i := by
    simpa only [one_mul] using
      mul_le_mul_of_nonneg_right (hcoeff i hid) zero_le
  exact lt_of_le_of_lt hle (pow_lt_pow_right₀ hx hid)

/-- A polynomial satisfying `intProp` is monic of degree `p`. -/
private theorem monic_natDegree_of_intProp
    {A : Type*} [CommRing A] [Nontrivial A]
    {p : ℕ} [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (hP : intProp f P) : P.Monic ∧ P.natDegree = p := by
  have hc : P.coeff p = 1 := by
    simpa only [Nat.sub_self, pow_zero, one_mul, Nat.choose_self, Nat.cast_one] using
      hP.2.2.2 p (Fact.out : p.Prime).pos le_rfl
  exact ⟨Polynomial.monic_of_natDegree_le_of_coeff_eq_one p hP.2.1 hc,
    le_antisymm hP.2.1 (Polynomial.le_natDegree_of_ne_zero (hc ▸ one_ne_zero))⟩

theorem valuation_aeval_cyclotomic_error
    {A R Γ : Type*} [CommRing A] [Nontrivial A] [CommRing R] [Algebra A R]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation R Γ)
    (hv : ∀ a : A, v (algebraMap A R a) ≤ 1)
    {p : ℕ} [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (hInt : intProp f P) (hShape : shapeProp f P) (x : R) :
    v (Polynomial.aeval x P - (x ^ p - x)) ≤
      v (algebraMap A R (wElt f)) * max 1 (v (Polynomial.aeval x P)) := by
  classical
  obtain ⟨hmonic, hdegree⟩ := monic_natDegree_of_intProp f P hInt
  have hxpow : ∀ i < p, v x ^ i ≤ max 1 (v (Polynomial.aeval x P)) := by
    intro i hi
    by_cases hx : v x ≤ 1
    · exact (pow_le_one₀ zero_le hx).trans (le_max_left _ _)
    · have hxgt : 1 < v x := lt_of_not_ge hx
      have heval := valuation_eval₂_monic_of_one_lt v (algebraMap A R) P hmonic
        (fun j _ => hv (P.coeff j)) x hxgt
      rw [hdegree, ← Polynomial.aeval_def] at heval
      rw [heval]
      exact (pow_le_pow_right₀ hxgt.le hi.le).trans (le_max_right _ _)
  obtain ⟨c, hc, hP⟩ := hShape
  have herror : Polynomial.aeval x P - (x ^ p - x) =
      ∑ i ∈ Finset.Ioo 0 p, algebraMap A R (c i) * x ^ i := by
    rw [hP]
    simp only [map_add, map_sub, map_sum, map_mul, map_pow,
      Polynomial.aeval_X, Polynomial.aeval_C, add_sub_cancel_left]
  rw [herror]
  apply v.map_sum_le
  intro i hi
  have hci : v (algebraMap A R (c i)) ≤ v (algebraMap A R (wElt f)) := by
    have hdiv := hc i (Finset.mem_Ioo.mp hi).1 (Finset.mem_Ioo.mp hi).2
    rw [Ideal.mem_span_singleton] at hdiv
    obtain ⟨b, hb⟩ := hdiv
    rw [hb, map_mul, map_mul]
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left (hv b) (show 0 ≤ v (algebraMap A R (wElt f)) from zero_le)
  rw [map_mul, map_pow]
  exact (mul_le_mul_of_nonneg_right hci zero_le).trans
    (mul_le_mul_of_nonneg_left (hxpow i (Finset.mem_Ioo.mp hi).2) zero_le)

private theorem valuation_cyclotomic_product_error
    {R Γ : Type*} [CommRing R] [LinearOrderedCommGroupWithZero Γ]
    (v : Valuation R Γ) (w x y : R) (p : ℕ) (g : Γ)
    (hx : v x ≤ g) (hy : v y ≤ g) :
    v ((x + y + w ^ p * x * y) - (x + y)) ≤ v w ^ p * g ^ 2 := by
  rw [add_sub_cancel_left, map_mul, map_mul, map_pow, pow_two, ← mul_assoc]
  exact (mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hx zero_le) zero_le).trans
      (mul_le_mul_of_nonneg_left hy zero_le)

theorem isNilpotent_maximalIdeal_quotient_pow
    (R : Type*) [CommRing R] [IsLocalRing R] (n : ℕ)
    [IsLocalRing (R ⧸ IsLocalRing.maximalIdeal R ^ n)] :
    IsNilpotent (IsLocalRing.maximalIdeal (R ⧸ IsLocalRing.maximalIdeal R ^ n)) := by
  let I := IsLocalRing.maximalIdeal R ^ n
  let Q := R ⧸ I
  have hI : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  let : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hmap : (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk I) =
      IsLocalRing.maximalIdeal Q := by
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [Q, sup_eq_left.mpr (IsLocalRing.le_maximalIdeal hI)]
  refine ⟨n, ?_⟩
  show (IsLocalRing.maximalIdeal Q) ^ n = 0
  rw [← hmap, ← Ideal.map_pow]
  exact Ideal.map_quotient_self I

theorem sum_frobenius_sub
    {R : Type*} [CommRing R] (p : ℕ) [ExpChar R p] (x : R) (r : ℕ) :
    (∑ i ∈ Finset.range r, x ^ (p ^ i)) ^ p -
      (∑ i ∈ Finset.range r, x ^ (p ^ i)) = x ^ (p ^ r) - x := by
  induction r with
  | zero => simp [zero_pow (expChar_pos R p).ne']
  | succ r ih =>
    rw [Finset.sum_range_succ, add_pow_expChar, ← pow_mul, ← pow_succ]
    linear_combination ih

theorem natCast_mem_maximalIdeal_pow_of_cyclotomic
    {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (hP : intProp f P)
    (π : A) (hπ : Irreducible π) (e m : ℕ)
    (hw : Associated (wElt f) (π ^ e)) (hm : m ≤ e) :
    (p : A) ∈ IsLocalRing.maximalIdeal A ^ m := by
  rw [hπ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  have hwm : π ^ m ∣ wElt f := (pow_dvd_pow π hm).trans hw.symm.dvd
  have hwp : wElt f ∣ wElt f ^ (p - 1) := by
    simpa only [pow_one] using
      pow_dvd_pow (wElt f) (show 1 ≤ p - 1 by have := (Fact.out : p.Prime).two_le; omega)
  have hcoeff := hP.2.2.2 1 (by decide) (Fact.out : p.Prime).one_lt.le
  simp only [Nat.choose_one_right] at hcoeff
  rw [← hcoeff]
  exact dvd_mul_of_dvd_left (hwm.trans hwp) _

theorem exists_residueField_section_quotient_pow
    (R : Type*) [CommRing R] [IsLocalRing R] (n : ℕ)
    [IsLocalRing (R ⧸ IsLocalRing.maximalIdeal R ^ n)]
    (p : ℕ) [Fact p.Prime] (hp : (p : R) ∈ IsLocalRing.maximalIdeal R ^ n) :
    ∃ σ : IsLocalRing.ResidueField (R ⧸ IsLocalRing.maximalIdeal R ^ n) →+*
        (R ⧸ IsLocalRing.maximalIdeal R ^ n),
      (IsLocalRing.residue _).comp σ = RingHom.id _ := by
  let Q := R ⧸ IsLocalRing.maximalIdeal R ^ n
  let : CharP Q p := (CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)).mpr (by
    simpa only [map_natCast] using (Ideal.Quotient.eq_zero_iff_mem.mpr hp))
  obtain ⟨σ, hσ, _⟩ := IsLocalRing.exists_residueField_section_compatible.{_, 0} (p := p) Q
    (isNilpotent_maximalIdeal_quotient_pow R n)
  exact ⟨σ, hσ⟩

theorem exists_lift_residueField_section
    {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S]
    (f : R →+* S) [IsLocalHom f] (hf : Function.Surjective f)
    (τ : IsLocalRing.ResidueField S →+* S)
    (hτ : (IsLocalRing.residue S).comp τ = RingHom.id _) :
    ∃ (σ : IsLocalRing.ResidueField R → R) (σbar : IsLocalRing.ResidueField R →+* S),
      (∀ x, IsLocalRing.residue R (σ x) = x) ∧ ∀ x, f (σ x) = σbar x := by
  classical
  let σbar := τ.comp (IsLocalRing.ResidueField.map f)
  choose σ hσ using fun x => hf (σbar x)
  refine ⟨σ, σbar, ?_, hσ⟩
  intro x
  apply (IsLocalRing.ResidueField.map f).injective
  rw [IsLocalRing.ResidueField.map_residue, hσ]
  exact DFunLike.congr_fun hτ ((IsLocalRing.ResidueField.map f) x)

theorem ringHom_eq_of_sub_mem_nilpotent_of_perfect
    {R S : Type*} [CommRing R] [CommRing S] (p : ℕ) [Fact p.Prime]
    [PerfectRing R p] [CharP S p] (I : Ideal S) (hI : IsNilpotent I)
    (f g : R →+* S) (hfg : ∀ x, f x - g x ∈ I) : f = g := by
  obtain ⟨n, hn⟩ := hI
  ext x
  obtain ⟨y, hy⟩ := (PerfectRing.bijective_frobenius (R := R) (p := p ^ n)).2 x
  change y ^ (p ^ n) = x at hy
  have hmem : (f y - g y) ^ (p ^ n) ∈ I ^ n :=
    Ideal.pow_le_pow_right (Nat.lt_pow_self (Fact.out : p.Prime).one_lt).le
      (Ideal.pow_mem_pow (hfg y) (p ^ n))
  rw [hn] at hmem
  have hz : (f y - g y) ^ (p ^ n) = 0 := hmem
  rw [sub_pow_expChar_pow, ← map_pow, ← map_pow, hy] at hz
  exact sub_eq_zero.mp hz

/-- Two characteristic-`p` lifts through a nilpotent ideal agree on the perfect core once their
residues agree.  This pointwise form is what is needed when only the finitely many coefficients
of a prepared polynomial, rather than the entire (possibly imperfect) residue field, are known
to be infinitely Frobenius-divisible. -/
theorem ringHom_eq_on_perfectCore_of_sub_mem_nilpotent
    {F S : Type*} [Field F] [CommRing S]
    (p : ℕ) [Fact p.Prime] [ExpChar F p] [CharP S p]
    (I : Ideal S) (hI : IsNilpotent I) (f g : F →+* S)
    (hfg : ∀ x, f x - g x ∈ I) {x : F} (hx : x ∈ perfectCore F p) :
    f x = g x := by
  let C := perfectCore F p
  let fC : C →+* S := f.comp C.subtype
  let gC : C →+* S := g.comp C.subtype
  have hC : ∀ y : C, fC y - gC y ∈ I := fun y => hfg y
  have heq := ringHom_eq_of_sub_mem_nilpotent_of_perfect p I hI fC gC hC
  exact DFunLike.congr_fun heq ⟨x, hx⟩

/-- The set of level numerators depends on the parameter only up to associates: associated
elements `π` and `π'` of `A` give the same set `extensionLevelNumerators A K L P π`. -/
theorem extensionLevelNumerators_eq_of_associated
    {A K L : Type*} [CommRing A] [IsDomain A] [Field K] [Field L]
    [Algebra A K] [Algebra K L] (P : Polynomial A) {π π' : A}
    (h : Associated π π') :
    Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π =
      Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π' := by
  suffices ∀ {s t : A}, Associated s t →
      Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P s ⊆
        Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P t from
    Set.Subset.antisymm (this h) (this h.symm)
  intro s t hst n hn
  obtain ⟨v, hv⟩ := hst
  obtain ⟨ξ, z, hz, hPz, a, ha⟩ := hn
  refine ⟨ξ, z, hz, hPz, a * (v : A) ^ n, ?_⟩
  rw [map_mul, ha, ← hv, mul_pow, map_mul]
  ring

private theorem exists_eq_pow_add_mul_of_perfect_residueField
    {R : Type*} [CommRing R] [IsLocalRing R]
    (p : ℕ) [PerfectRing (IsLocalRing.ResidueField R) p]
    (π : R) (hπ : IsLocalRing.maximalIdeal R = Ideal.span {π}) (a : R) :
    ∃ b c : R, a = b ^ p + π * c := by
  obtain ⟨x, hx⟩ :=
    (PerfectRing.bijective_frobenius (R := IsLocalRing.ResidueField R) (p := p)).2
      (IsLocalRing.residue R a)
  change x ^ p = IsLocalRing.residue R a at hx
  obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective x
  obtain ⟨c, hc⟩ := exists_eq_add_mul_of_residue_eq hπ (x := a) (y := b ^ p)
    (by rw [map_pow, hb, hx])
  exact ⟨b, c, hc⟩

theorem isUnit_of_isLeast_extensionLevelNumerator
    {A K L : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L] [IsFractionRing A K]
    (P : Polynomial A) (π : A) (hπ : Irreducible π) (n : ℕ) (hn : 0 < n)
    (hmin : IsLeast (Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π) n)
    (ξ : K) (z : L) (a : A) (hz : Algebra.adjoin K {z} = ⊤)
    (hPz : Polynomial.eval₂ ((algebraMap K L).comp (algebraMap A K)) z P =
      algebraMap K L ξ)
    (ha : algebraMap A K a = algebraMap A K (π ^ n) * ξ) : IsUnit a := by
  by_contra hau
  have hadiv : π ∣ a := by
    rw [← Ideal.mem_span_singleton, ← hπ.maximalIdeal_eq]
    exact hau
  obtain ⟨b, hb⟩ := hadiv
  have hπK : algebraMap A K π ≠ 0 := (map_ne_zero_iff _
    (IsFractionRing.injective A K)).mpr hπ.ne_zero
  have hprev : n - 1 ∈ Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π := by
    obtain ⟨b', hb'⟩ := mul_pow_sub_one_mul_mem_range π (π ^ n) hπK 1 n (by omega) Associated.rfl
      ξ a ⟨b, hb⟩ (by rw [ha, map_pow, pow_one])
    exact ⟨ξ, z, hz, hPz, b', by simpa only [one_mul] using hb'⟩
  have := hmin.2 hprev
  omega

theorem exists_unit_of_isLeast_extensionLevelNumerator
    {A K L : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L] [IsFractionRing A K]
    (P : Polynomial A) (π : A) (hπ : Irreducible π) (n : ℕ) (hn : 0 < n)
    (hmin : IsLeast (Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π) n) :
    ∃ (ξ : K) (z : L) (a : A),
      Algebra.adjoin K ({z} : Set L) = ⊤ ∧
      Polynomial.eval₂ ((algebraMap K L).comp (algebraMap A K)) z P =
        algebraMap K L ξ ∧ IsUnit a ∧
      algebraMap A K a = algebraMap A K (π ^ n) * ξ := by
  obtain ⟨ξ, z, hz, hPz, a, ha⟩ := hmin.1
  refine ⟨ξ, z, a, hz, hPz, ?_, ha⟩
  exact isUnit_of_isLeast_extensionLevelNumerator P π hπ n hn hmin ξ z a hz hPz ha

theorem monic_natDegree_cyclotomic_quotient
    {A : Type*} [CommRing A] [Nontrivial A]
    {p : ℕ} [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (hP : intProp f P) : P.Monic ∧ P.natDegree = p :=
  monic_natDegree_of_intProp f P hP

private theorem residue_eval_scaleRoots
    {A : Type*} [CommRing A] [IsLocalRing A]
    (P : Polynomial A) (hP : P.Monic) (s a : A)
    (hs : IsLocalRing.residue A s = 0) :
    IsLocalRing.residue A ((P.scaleRoots s).eval a) =
      IsLocalRing.residue A a ^ P.natDegree := by
  have hlead : IsLocalRing.residue A P.leadingCoeff ≠ 0 := by
    rw [hP.leadingCoeff, map_one]
    exact one_ne_zero
  have hred : (P.scaleRoots s).map (IsLocalRing.residue A) =
      Polynomial.X ^ P.natDegree := by
    rw [Polynomial.map_scaleRoots P s (IsLocalRing.residue A) hlead, hs,
      Polynomial.scaleRoots_zero, Polynomial.leadingCoeff_map_of_leadingCoeff_ne_zero _ hlead,
      hP.leadingCoeff, map_one, one_smul, Polynomial.natDegree_map_of_leadingCoeff_ne_zero _ hlead]
  rw [← Polynomial.eval₂_at_apply, ← Polynomial.eval_map, hred]
  simp

theorem map_eval_scaleRoots_inv_mul
    {A K : Type*} [CommRing A] [Field K] [Algebra A K]
    (P : Polynomial A) (s a : A) (hs : algebraMap A K s ≠ 0) :
    algebraMap A K ((P.scaleRoots s).eval a) =
      algebraMap A K s ^ P.natDegree *
        Polynomial.aeval ((algebraMap A K s)⁻¹ * algebraMap A K a) P := by
  have h := Polynomial.scaleRoots_aeval_smul
    (r := (algebraMap A K s)⁻¹ * algebraMap A K a) (s := s) (p := P)
  simp only [Algebra.smul_def, mul_inv_cancel_left₀ hs] at h
  simpa only [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, map_pow] using h

theorem exists_mem_maximalIdeal_mul_eq_of_associated
    {A : Type*} [CommRing A] [IsLocalRing A]
    (π w : A) (hπ : π ∈ IsLocalRing.maximalIdeal A)
    (e k : ℕ) (hw : Associated w (π ^ e)) (hk : k < e) :
    ∃ c : A, c ∈ IsLocalRing.maximalIdeal A ∧ w = π ^ k * c := by
  obtain ⟨v, hv⟩ := hw
  refine ⟨π ^ (e - k) * (↑v⁻¹ : A), ?_, ?_⟩
  · exact (IsLocalRing.maximalIdeal A).mul_mem_right _
      (Ideal.pow_mem_of_mem _ hπ _ (by omega))
  · rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le hk.le, ← hv]
    simp

private theorem exists_predecessor_extensionLevelNumerator_of_residue_isPow
    {A K L : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L]
    [Algebra A L] [IsScalarTower A K L] [IsFractionRing A K]
    (p : ℕ) [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A)
    (hP : intProp f P) (hfun : funcEq f P)
    (π : A) (hπ : Irreducible π) (e n : ℕ)
    (hw : Associated (wElt f) (π ^ e)) (hn : 0 < n) (hne : n < p * e)
    (hpn : p ∣ n) (ξ : K) (z : L) (a : A)
    (hz : Algebra.adjoin K {z} = ⊤)
    (heval : Polynomial.aeval z P = algebraMap K L ξ)
    (ha : algebraMap A K a = algebraMap A K π ^ n * ξ)
    (hpow : ∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p) :
    n - 1 ∈ Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π := by
  obtain ⟨k, rfl⟩ := hpn
  have hk : 0 < k := by nlinarith
  have hke : k < e := (Nat.mul_lt_mul_left (Fact.out : p.Prime).pos).mp hne
  have hπmem : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ.maximalIdeal_eq]
    exact Ideal.mem_span_singleton_self π
  have hπres : IsLocalRing.residue A π = 0 :=
    (IsLocalRing.residue_eq_zero_iff π).mpr hπmem
  have hπK : algebraMap A K π ≠ 0 := by
    simpa only [map_zero] using (IsFractionRing.injective A K).ne hπ.ne_zero
  obtain ⟨b₀, hb₀⟩ := hpow
  obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective (-b₀)
  let x : K := (algebraMap A K (π ^ k))⁻¹ * algebraMap A K b
  let t : A := (P.scaleRoots (π ^ k)).eval b
  obtain ⟨hmonic, hdeg⟩ := monic_natDegree_cyclotomic_quotient f P hP
  have ht : algebraMap A K t = algebraMap A K π ^ (p * k) * Polynomial.aeval x P := by
    dsimp only [x, t]
    rw [map_eval_scaleRoots_inv_mul P (π ^ k) b (by simpa using pow_ne_zero k hπK),
      map_pow, ← pow_mul, hdeg, Nat.mul_comm k p]
  have htres : IsLocalRing.residue A t = -IsLocalRing.residue A a := by
    rw [residue_eval_scaleRoots P hmonic (π ^ k) b
      (by rw [map_pow, hπres, zero_pow hk.ne']), hdeg, hb, ← frobenius_def,
      map_neg, frobenius_def, hb₀]
  obtain ⟨c, hc, hwc⟩ :=
    exists_mem_maximalIdeal_mul_eq_of_associated π (wElt f) hπmem e k hw hke
  have hcoeff : 1 + algebraMap A K (wElt f) * x = algebraMap A K (1 + c * b) := by
    dsimp [x]
    simp only [hwc, map_mul, map_add, map_one, map_pow]
    field_simp
  have hunit : IsUnit (1 + c * b) := by
    apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
    rw [map_add, map_one, map_mul, (IsLocalRing.residue_eq_zero_iff c).mpr hc, zero_mul,
      add_zero]
    exact one_ne_zero
  have hcoeffne : 1 + algebraMap A K (wElt f) * x ≠ 0 := by
    rw [hcoeff]
    exact (hunit.map (algebraMap A K)).ne_zero
  let z' : L := z + algebraMap K L x + algebraMap A L (wElt f) * z * algebraMap K L x
  have hz' : Algebra.adjoin K {z'} = ⊤ := by
    convert adjoin_affine_eq_top (1 + algebraMap A K (wElt f) * x) x hcoeffne z hz using 1
    dsimp [z']
    congr 2
    simp only [map_add, map_one, map_mul, ← IsScalarTower.algebraMap_apply A K L]
    ring
  let ξ' : K := ξ + Polynomial.aeval x P +
    algebraMap A K (wElt f) ^ p * ξ * Polynomial.aeval x P
  have heval' : Polynomial.aeval z' P = algebraMap K L ξ' := by
    rw [aeval_cyclotomic_add f P hfun z (algebraMap K L x), heval,
      Polynomial.aeval_algebraMap_apply]
    simp only [ξ', map_add, map_mul, map_pow, ← IsScalarTower.algebraMap_apply A K L]
  obtain ⟨d, hd, hwd⟩ := exists_mem_maximalIdeal_mul_eq_of_associated π
    (wElt f ^ p) hπmem (p * e) (p * k)
    (by simpa only [← pow_mul, Nat.mul_comm e p] using hw.pow_pow (n := p)) hne
  let a' : A := a + t + d * a * t
  have ha' : algebraMap A K a' = algebraMap A K π ^ (p * k) * ξ' := by
    have hwdK := congrArg (algebraMap A K) hwd
    simp only [map_mul, map_pow] at hwdK
    dsimp [a', ξ']
    simp only [map_add, map_mul, ha, ht, hwdK]
    ring
  have ha'mem : a' ∈ IsLocalRing.maximalIdeal A := by
    apply (IsLocalRing.residue_eq_zero_iff _).mp
    simp only [a', map_add, map_mul, htres, (IsLocalRing.residue_eq_zero_iff d).mpr hd,
      zero_mul, add_neg_cancel, add_zero]
  rw [hπ.maximalIdeal_eq, Ideal.mem_span_singleton] at ha'mem
  obtain ⟨b', hb'⟩ := mul_pow_sub_one_mul_mem_range π (π ^ k) hπK p k (by positivity)
    Associated.rfl ξ' a' ha'mem (by rw [ha', map_pow _ π k, ← pow_mul, Nat.mul_comm])
  exact ⟨ξ', z', hz', by simpa only [← IsScalarTower.algebraMap_eq A K L, Polynomial.aeval_def]
    using heval', b', hb'⟩

theorem not_isPow_residue_of_isLeast_extensionLevelNumerator
    {A K L : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L]
    [Algebra A L] [IsScalarTower A K L] [IsFractionRing A K]
    (p : ℕ) [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A)
    (hP : intProp f P) (hfun : funcEq f P)
    (π : A) (hπ : Irreducible π) (e n : ℕ)
    (hw : Associated (wElt f) (π ^ e)) (hn : 0 < n) (hne : n < p * e)
    (hmin : IsLeast (Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π) n)
    (hpn : p ∣ n) (ξ : K) (z : L) (a : A)
    (hz : Algebra.adjoin K {z} = ⊤)
    (heval : Polynomial.aeval z P = algebraMap K L ξ)
    (ha : algebraMap A K a = algebraMap A K π ^ n * ξ) :
    ¬∃ b : IsLocalRing.ResidueField A, IsLocalRing.residue A a = b ^ p := by
  intro hpow
  have := hmin.2 (exists_predecessor_extensionLevelNumerator_of_residue_isPow
    p f P hP hfun π hπ e n hw hn hne hpn ξ z a hz heval ha hpow)
  omega

/-- **A separable extension whose ramification indices are all divisible by its degree is totally
ramified.**

Given `d` with `0 < d` and `Module.finrank K L ≤ d`, if every maximal ideal `m` of
`integralClosure A L` lying over the maximal ideal of `A` has
`d ∣ Ideal.ramificationIdx' (𝔪 A) m`, then `L / K` is totally ramified with respect to `A`. -/
theorem isTotallyRamified_of_dvd_ramificationIdx
    (A K L : Type*)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Algebra A K] [IsFractionRing A K]
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [Module.Finite K L] [Algebra.IsSeparable K L]
    (d : ℕ) (hd : 0 < d) (hdegree : Module.finrank K L ≤ d)
    (hdiv : ∀ m : Ideal (integralClosure A L), m.IsMaximal →
      m.LiesOver (IsLocalRing.maximalIdeal A) →
        d ∣ Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m) :
    IsDiscreteValuationRing.IsTotallyRamifiedWithRespectTo A K L := by
  classical
  let B := integralClosure A L
  let mA := IsLocalRing.maximalIdeal A
  let : Module.Finite A B := IsIntegralClosure.finite A K L B
  let : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  let : Algebra.IsIntegral A B := IsIntegralClosure.isIntegral_algebra A L
  let : IsFractionRing B L :=
    IsIntegralClosure.isFractionRing_of_finite_extension A K L B
  have hAB : Function.Injective (algebraMap A B) := by
    apply Function.Injective.of_comp (f := algebraMap B L)
    rw [← RingHom.coe_comp, ← IsScalarTower.algebraMap_eq,
      IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  let : Module.IsTorsionFree A B :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hAB
  obtain ⟨m, hm⟩ := Ideal.exists_maximal B
  let : m.IsMaximal := hm
  have hOver : m.LiesOver mA := ⟨((IsLocalRing.isMaximal_iff A).mp
    (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := A) m)).symm⟩
  let : m.LiesOver mA := hOver
  obtain ⟨-, -, -, -, N, ms, hmsmax, hmsiff, -, -, hsum, -, -⟩ :=
    IsDiscreteValuationRing.integralClosure_finite_dedekind_and_degree_eq_sum_ramification_inertia
      A K L
  have hepos : ∀ i, 0 < (ms i).ramificationIdx A := fun i => by
    let : (ms i).IsPrime := (hmsmax i).isPrime
    exact (ms i).ramificationIdx_pos A
  have hfpos : ∀ i, 0 < (ms i).inertiaDeg A := fun i => by
    let : (ms i).IsPrime := (hmsmax i).isPrime
    exact (ms i).inertiaDeg_pos A
  obtain ⟨i₀, hi₀, -⟩ := (hmsiff m).mp hm
  have hepos' : 0 < m.ramificationIdx A := hi₀ ▸ hepos i₀
  have hfpos' : 0 < m.inertiaDeg A := hi₀ ▸ hfpos i₀
  have hidx : Ideal.ramificationIdx' mA m = m.ramificationIdx A :=
    Ideal.ramificationIdx'_eq_ramificationIdx mA m (IsDiscreteValuationRing.not_a_field A)
  have hem : d ≤ m.ramificationIdx A := by
    have hdvd := hdiv m hm hOver
    rw [hidx] at hdvd
    exact Nat.le_of_dvd hepos' hdvd
  have hsplit : (∑ i ∈ Finset.univ.erase i₀,
        (ms i).ramificationIdx A * (ms i).inertiaDeg A) +
        (ms i₀).ramificationIdx A * (ms i₀).inertiaDeg A =
      ∑ i, (ms i).ramificationIdx A * (ms i).inertiaDeg A :=
    Finset.sum_erase_add Finset.univ _ (Finset.mem_univ i₀)
  have htermle : m.ramificationIdx A * m.inertiaDeg A ≤ Module.finrank K L := by
    rw [hsum, ← hi₀]
    omega
  have hef : m.ramificationIdx A * m.inertiaDeg A = Module.finrank K L := by
    refine le_antisymm htermle ?_
    exact hdegree.trans (hem.trans (Nat.le_mul_of_pos_right _ hfpos'))
  have hf : m.inertiaDeg A = 1 := by
    have hepos'' : 0 < m.ramificationIdx A := lt_of_lt_of_le hd hem
    have h1 : m.ramificationIdx A * m.inertiaDeg A ≤ m.ramificationIdx A * 1 := by
      rw [mul_one, hef]
      exact hdegree.trans hem
    have h2 := Nat.le_of_mul_le_mul_left h1 hepos''
    omega
  refine ⟨m, hm, hOver, ?_, ?_⟩
  · intro q hq hqOver
    by_contra hqm
    obtain ⟨j, hj, -⟩ := (hmsiff q).mp hq
    have hjne : j ≠ i₀ := fun h => hqm (by rw [← hj, h, hi₀])
    have hzero : ∑ i ∈ Finset.univ.erase i₀,
        (ms i).ramificationIdx A * (ms i).inertiaDeg A = 0 := by
      rw [← hi₀] at hef
      omega
    have hqzero := (Finset.sum_eq_zero_iff.mp hzero) j
      (Finset.mem_erase.mpr ⟨hjne, Finset.mem_univ j⟩)
    have := Nat.mul_pos (hepos j) (hfpos j)
    omega
  · rw [Ideal.inertiaDeg_eq_of_isMaximal mA m] at hf
    simpa using hf

private theorem exists_totallyRamified_adjoin_root_of_coprime_pole
    (A : Type*) (K : Type u)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
    (P : Polynomial A) (hP : P.Monic) (hd : 0 < P.natDegree)
    (π a : A) (hπ : Irreducible π) (ha : IsUnit a)
    (n : ℕ) (hn : 0 < n) (hcop : P.natDegree.Coprime n) :
    ∃ (E : Type u) (_ : Field E) (_ : Algebra K E) (_ : Algebra A E)
      (_ : IsScalarTower A K E) (_ : Module.Finite K E) (_ : Algebra.IsSeparable K E),
      IsDiscreteValuationRing.IsTotallyRamifiedWithRespectTo A K E ∧
        Module.finrank K E = P.natDegree ∧
          ∃ y : E, Algebra.adjoin K {y} = ⊤ ∧
            Polynomial.aeval y P =
              algebraMap K E ((algebraMap A K π)⁻¹ ^ n * algebraMap A K a) := by
  let ξ : K := (algebraMap A K π)⁻¹ ^ n * algebraMap A K a
  let Q : Polynomial K := P.map (algebraMap A K) - Polynomial.C ξ
  have hQdeg : Q.natDegree = P.natDegree := by
    rw [Polynomial.natDegree_sub_C, hP.natDegree_map]
  have hQne : Q ≠ 0 := by
    intro heq
    rw [heq, Polynomial.natDegree_zero] at hQdeg
    omega
  obtain ⟨g, hg, hgQ⟩ := Polynomial.exists_irreducible_of_natDegree_pos
    (show 0 < Q.natDegree by omega)
  let : Fact (Irreducible g) := ⟨hg⟩
  let E := AdjoinRoot g
  let : Module.Finite K E := (AdjoinRoot.powerBasis hg.ne_zero).finite
  let : Algebra.IsSeparable K E := inferInstance
  let y : E := AdjoinRoot.root g
  have hy : Polynomial.aeval y P = algebraMap K E ξ := by
    have hgroot : Polynomial.aeval y g = 0 := AdjoinRoot.eval₂_root g
    have hQroot : Polynomial.aeval y Q = 0 := by
      obtain ⟨q, hq⟩ := hgQ
      rw [hq, map_mul, hgroot, zero_mul]
    change Polynomial.aeval y (P.map (algebraMap A K) - Polynomial.C ξ) = 0 at hQroot
    rw [map_sub, Polynomial.aeval_C, Polynomial.aeval_map_algebraMap] at hQroot
    exact sub_eq_zero.mp hQroot
  have hdegree : Module.finrank K E ≤ P.natDegree := by
    rw [(AdjoinRoot.powerBasis hg.ne_zero).finrank, AdjoinRoot.powerBasis_dim, ← hQdeg]
    exact Polynomial.natDegree_le_of_dvd hgQ hQne
  have hdiv : ∀ m : Ideal (integralClosure A E), m.IsMaximal →
      m.LiesOver (IsLocalRing.maximalIdeal A) →
        P.natDegree ∣ Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m := by
    intro m hm hmOver
    let := hmOver
    exact IsDiscreteValuationRing.natDegree_dvd_ramificationIdx_of_coprime_pole A K E
      P.natDegree n hn hcop π a hπ ha P hP rfl ξ y hy rfl m hm
  have htot := isTotallyRamified_of_dvd_ramificationIdx A K E P.natDegree hd hdegree hdiv
  have hdegEq : Module.finrank K E = P.natDegree := by
    have htotCopy := htot
    obtain ⟨m, hm, hmOver, _⟩ := htotCopy
    let : m.IsMaximal := hm
    let := hmOver
    have heq := IsDiscreteValuationRing.ramificationIdx_eq_finrank_of_totallyRamified A K E htot m
      hm hmOver
    have hepos : 0 < Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m := by
      rw [heq]
      exact Module.finrank_pos
    exact le_antisymm hdegree (heq ▸ Nat.le_of_dvd hepos (hdiv m hm hmOver))
  exact ⟨E, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, htot, hdegEq, y, AdjoinRoot.adjoinRoot_eq_top, hy⟩

theorem exists_totallyRamified_root_uniformizer
    (A : Type*) (K : Type u)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
    (π : A) (hπ : Irreducible π) (d : ℕ) (hd : 0 < d) :
    ∃ (E : Type u) (_ : Field E) (_ : Algebra K E) (_ : Algebra A E)
      (_ : IsScalarTower A K E) (_ : Module.Finite K E) (_ : Algebra.IsSeparable K E),
      IsDiscreteValuationRing.IsTotallyRamifiedWithRespectTo A K E ∧ Module.finrank K E = d ∧
        ∃ t : E, t ^ d = algebraMap A E π ∧ IsIntegral A t := by
  obtain ⟨E, hE, hKE, hAE, htower, hfin, hsep, htot, hdeg, y, _, hy⟩ :=
    exists_totallyRamified_adjoin_root_of_coprime_pole A K (Polynomial.X ^ d)
      (Polynomial.monic_X_pow d) (by simpa only [Polynomial.natDegree_X_pow] using hd)
      π 1 hπ isUnit_one 1 (by decide) (by simp)
  simp only [map_pow, Polynomial.aeval_X, pow_one, map_one, mul_one] at hy
  have ht : (y⁻¹) ^ d = algebraMap A E π := by
    rw [inv_pow, hy, map_inv₀, inv_inv, ← IsScalarTower.algebraMap_apply A K E]
  refine ⟨E, hE, hKE, hAE, htower, hfin, hsep, htot,
    hdeg.trans (Polynomial.natDegree_X_pow d), y⁻¹, ht, ?_⟩
  refine ⟨Polynomial.X ^ d - Polynomial.C π, Polynomial.monic_X_pow_sub_C π hd.ne', ?_⟩
  show Polynomial.aeval y⁻¹ (Polynomial.X ^ d - Polynomial.C π) = 0
  rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, ht, sub_self]

theorem exists_totallyRamified_root_pow_sub
    (A : Type*) (K : Type u)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
    (d : ℕ) (hd : 1 < d) (π a : A) (hπ : Irreducible π) (ha : IsUnit a)
    (n : ℕ) (hn : 0 < n) (hcop : d.Coprime n) :
    ∃ (E : Type u) (_ : Field E) (_ : Algebra K E) (_ : Algebra A E)
      (_ : IsScalarTower A K E) (_ : Module.Finite K E) (_ : Algebra.IsSeparable K E),
      IsDiscreteValuationRing.IsTotallyRamifiedWithRespectTo A K E ∧ Module.finrank K E = d ∧
        ∃ y : E, Algebra.adjoin K {y} = ⊤ ∧
          y ^ d - y = algebraMap K E ((algebraMap A K π)⁻¹ ^ n * algebraMap A K a) := by
  let Q : Polynomial A := Polynomial.X ^ d - Polynomial.X
  have hQ : Q.Monic := Polynomial.monic_X_pow_sub (by
    rw [Polynomial.degree_X]
    exact_mod_cast hd)
  have hQdeg : Q.natDegree = d := by
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt (by
      rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
      exact hd), Polynomial.natDegree_X_pow]
  obtain ⟨E, hE, hKE, hAE, htower, hfin, hsep, htot, hdeg, y, hygen, hy⟩ :=
    exists_totallyRamified_adjoin_root_of_coprime_pole A K Q hQ
      (by omega) π a hπ ha n hn (hQdeg ▸ hcop)
  refine ⟨E, hE, hKE, hAE, htower, hfin, hsep, htot, hdeg.trans hQdeg, y, hygen, ?_⟩
  simpa only [Q, map_sub, map_pow, Polynomial.aeval_X] using hy

end Stacks.DiscreteValuationRing.EppLevelInduction
