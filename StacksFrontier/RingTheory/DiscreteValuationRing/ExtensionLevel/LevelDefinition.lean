module

public import StacksFrontier.NumberTheory.Cyclotomic.OneAddPow
public import StacksFrontier.RingTheory.DiscreteValuationRing.PurelyInseparable
public import StacksFrontier.RingTheory.LocalRing.ResidueSection

open Stacks.DiscreteValuationRing.AdjoinPthRoot

/-!
# The level of a degree-`p` extension

The definition of a degree-`p` extension of finite level, its candidate numerators and its level,
and the proof that the infimum defining the level is attained and lies in `[0, p)`.
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u uA uK uL

namespace Stacks.DegreePExtensionLevel

/-- A finite extension `L / K` of the fraction field of a mixed-characteristic discrete
valuation ring is a degree-`p` extension of finite level (for the specified cyclotomic
quotient polynomial) if it has degree `p`, is generated by a root of `P(z) = ξ`, and
`w ^ p · ξ` comes from the maximal ideal of the discrete valuation ring. -/
def IsDegreePExtensionOfFiniteLevel
    (A K L : Type u)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L]
    [IsFractionRing A K] [Module.Finite K L]
    (p : ℕ) [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) : Prop :=
  Module.finrank K L = p ∧
    ∃ (ξ : K) (z : L),
      Algebra.adjoin K {z} = ⊤ ∧
        Polynomial.eval₂ ((algebraMap K L).comp (algebraMap A K)) z P =
            algebraMap K L ξ ∧
        ∃ a : A, a ∈ IsLocalRing.maximalIdeal A ∧
          algebraMap A K a = algebraMap A K (wElt f) ^ p * ξ

/-! ### The level of a degree-`p` extension -/

/-- The possible numerators `n` occurring in the definition of the level of a degree-`p`
extension. The existential quantification over `z` makes the set independent of a chosen
generator. -/
def extensionLevelNumerators
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [Field K] [Field L]
    [Algebra A K] [Algebra K L]
    (P : Polynomial A) (π : A) : Set ℕ :=
  {n | ∃ (ξ : K) (z : L),
    Algebra.adjoin K ({z} : Set L) = ⊤ ∧
      Polynomial.eval₂ ((algebraMap K L).comp (algebraMap A K)) z P =
        algebraMap K L ξ ∧
      ∃ a : A, algebraMap A K a = algebraMap A K (π ^ n) * ξ}

/-- The level of an extension with a nonempty set of level numerators, defined without
choosing a generator, is the infimum of all its candidate values `n / e₁`. -/
def extensionLevel
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [Field K] [Field L]
    [Algebra A K] [Algebra K L]
    (P : Polynomial A) (π : A) (e₁ : ℕ)
    (_he₁ : 0 < e₁)
    (_hne : (extensionLevelNumerators A K L P π).Nonempty) : ℚ :=
  ((sInf (extensionLevelNumerators A K L P π) : ℕ) : ℚ) / (e₁ : ℚ)

private def finiteLevel
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L]
    (p : ℕ) [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A) : Prop :=
  ∃ (ξ : K) (z : L),
    Algebra.adjoin K {z} = ⊤ ∧
      Polynomial.eval₂ ((algebraMap K L).comp (algebraMap A K)) z P =
        algebraMap K L ξ ∧
      ∃ a : A, a ∈ IsLocalRing.maximalIdeal A ∧
        algebraMap A K a = algebraMap A K (wElt f) ^ p * ξ

private lemma finiteLevel_candidate
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L]
    [IsFractionRing A K]
    (p : ℕ) [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (π : A) (e₁ : ℕ)
    (hfin : finiteLevel A K L p f P) (hπ : Irreducible π) (he₁ : 0 < e₁)
    (hw : Associated (wElt f) (π ^ e₁)) :
    ∃ n ∈ Stacks.DegreePExtensionLevel.extensionLevelNumerators A K L P π, n < p * e₁ := by
  rcases hfin with ⟨ξ, z, hz, hP, a, ha, haeq⟩
  rw [hπ.maximalIdeal_eq, Ideal.mem_span_singleton] at ha
  rcases ha with ⟨b, rfl⟩
  rcases hw with ⟨u, hu⟩
  have hp : 0 < p := (Fact.out : p.Prime).pos
  have hpe : 0 < p * e₁ := Nat.mul_pos hp he₁
  refine ⟨p * e₁ - 1, ?_, Nat.sub_lt hpe (by decide)⟩
  refine ⟨ξ, z, hz, hP, b * (u : A) ^ p, ?_⟩
  have hpow : (wElt f) ^ p * (u : A) ^ p = π ^ (p * e₁) := by
    rw [← mul_pow, hu, ← pow_mul, Nat.mul_comm]
  have hexp : π ^ (p * e₁) = π * π ^ (p * e₁ - 1) := by
    conv_lhs => rw [show p * e₁ = (p * e₁ - 1) + 1 by omega, pow_succ]
    ac_rfl
  have hmap : algebraMap A K π ≠ 0 := by
    simpa using (IsFractionRing.injective A K).ne hπ.ne_zero
  apply mul_left_cancel₀ hmap
  calc
    algebraMap A K π * algebraMap A K (b * (u : A) ^ p) =
        algebraMap A K (π * b) * algebraMap A K ((u : A) ^ p) := by simp [map_mul]; ring
    _ = (algebraMap A K (wElt f) ^ p * ξ) * algebraMap A K ((u : A) ^ p) := by
      rw [haeq]
    _ = algebraMap A K ((wElt f) ^ p * (u : A) ^ p) * ξ := by
      simp only [map_mul, map_pow]
      ring
    _ = algebraMap A K (π ^ (p * e₁)) * ξ := by rw [hpow]
    _ = algebraMap A K π * (algebraMap A K (π ^ (p * e₁ - 1)) * ξ) := by
      rw [hexp, map_mul]
      ring

/-- For a finite-level degree-`p` extension, if `π` is a uniformizer and
`w` is associated to `π ^ e₁` with `e₁ > 0`, the level is an attained minimum of
the values coming from all generators. It is a rational number in `[0, p)`. -/
theorem exists_extensionLevel_isLeast_and_mem_Ico
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Field L] [Algebra A K] [Algebra K L]
    [IsFractionRing A K] [Module.Finite K L]
    (p : ℕ) [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A)
    (P : Polynomial A) (π : A) (e₁ : ℕ)
    (hfinite :
      let A' := ULift.{max uK uL} A
      let K' := ULift.{max uA uL} K
      let L' := ULift.{max uA uK} L
      let eA : A' ≃+* A := ULift.ringEquiv
      let eK : K' ≃+* K := ULift.ringEquiv
      let eL : L' ≃+* L := ULift.ringEquiv
      letI : Field K' := ULift.field
      letI : Field L' := ULift.field
      letI : IsDomain A' := eA.toMulEquiv.isDomain A
      letI : IsDiscreteValuationRing A' :=
        IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing eA.symm
      letI : Algebra A K' := ULift.algebra
      letI : IsFractionRing A K' :=
        IsFractionRing.of_algEquiv (ULift.algEquiv (R := A) (A := K)).symm
      letI : Algebra A' K' := ULift.algebra' A K'
      letI : IsFractionRing A' K' :=
        IsFractionRing.of_ringEquiv_left eA (fun _ ↦ rfl)
      letI : Algebra K L' := ULift.algebra
      letI : Algebra K' L' := ULift.algebra' K L'
      letI : RingHomInvPair (eK.symm : K →+* K') (eK : K' →+* K) :=
        RingHomInvPair.of_ringEquiv_symm eK
      letI : RingHomInvPair (eK : K' →+* K) (eK.symm : K →+* K') :=
        RingHomInvPair.of_ringEquiv eK
      let eKL : L ≃ₛₗ[(eK.symm : K →+* K')] L' :=
        { eL.symm.toAddEquiv with map_smul' := fun _ _ ↦ rfl }
      let hfin : Module.Finite K' L' :=
        Module.Finite.of_surjective eKL.toLinearMap eKL.surjective
      @IsDegreePExtensionOfFiniteLevel A' K' L' inferInstance inferInstance
        inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance hfin p
        inferInstance (eA.symm.toRingHom.comp f) (P.map eA.symm.toRingHom))
    (hπ : Irreducible π) (he₁ : 0 < e₁)
    (hw : Associated (wElt f) (π ^ e₁)) :
    ∃ hne : (extensionLevelNumerators A K L P π).Nonempty,
      IsLeast (extensionLevelNumerators A K L P π)
          (sInf (extensionLevelNumerators A K L P π)) ∧
        extensionLevel A K L P π e₁ he₁ hne ∈ Set.Ico (0 : ℚ) (p : ℚ) := by
  have hfin' : finiteLevel A K L p f P := by
    let A' := ULift.{max uK uL} A
    let K' := ULift.{max uA uL} K
    let L' := ULift.{max uA uK} L
    let eA : A' ≃+* A := ULift.ringEquiv
    let eK : K' ≃+* K := ULift.ringEquiv
    let eL : L' ≃+* L := ULift.ringEquiv
    let : Field K' := ULift.field
    let : Field L' := ULift.field
    let : IsDomain A' := eA.toMulEquiv.isDomain A
    let : IsDiscreteValuationRing A' :=
      IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing eA.symm
    let : Algebra A K' := ULift.algebra
    let : IsFractionRing A K' :=
      IsFractionRing.of_algEquiv (ULift.algEquiv (R := A) (A := K)).symm
    let : Algebra A' K' := ULift.algebra' A K'
    let : IsFractionRing A' K' :=
      IsFractionRing.of_ringEquiv_left eA (fun _ ↦ rfl)
    let : Algebra K L' := ULift.algebra
    let : Algebra K' L' := ULift.algebra' K L'
    dsimp at hfinite
    rw [IsDegreePExtensionOfFiniteLevel] at hfinite
    rcases hfinite.2 with ⟨ξ, z, hz, hP, a, ha, haeq⟩
    refine ⟨ξ.down, z.down, ?_, ?_, a.down, ?_, ?_⟩
    · rw [Algebra.adjoin_singleton_eq_range_aeval] at hz ⊢
      apply top_unique
      intro y _
      have hy : (ULift.up y : L') ∈ (Polynomial.aeval (R := K') z).range := by
        rw [hz]
        trivial
      obtain ⟨q, hq⟩ := hy
      refine ⟨q.map ULift.ringEquiv.toRingHom, ?_⟩
      change Polynomial.eval₂ (algebraMap K' L') z q = ULift.up y at hq
      show Polynomial.eval₂ (algebraMap K L) z.down
        (q.map ULift.ringEquiv.toRingHom) = y
      have hd := congrArg eL.toRingHom hq
      rw [Polynomial.hom_eval₂] at hd
      rw [Polynomial.eval₂_map]
      convert hd using 1 <;> rfl
    · rw [Polynomial.eval₂_map] at hP
      have hd := congrArg eL.toRingHom hP
      rw [Polynomial.hom_eval₂] at hd
      convert hd using 1 <;> rfl
    · intro hau
      exact ha (hau.map (ULift.ringEquiv (R := A)).symm.toRingHom)
    · change ULift.up (algebraMap A K a.down) =
        ULift.up (algebraMap A K (wElt f) ^ p * ξ.down) at haeq
      exact ULift.up_injective haeq
  obtain ⟨n, hn, hnbound⟩ := finiteLevel_candidate A K L p f P π e₁ hfin' hπ he₁ hw
  let hne : (extensionLevelNumerators A K L P π).Nonempty := ⟨n, hn⟩
  refine ⟨hne, ⟨Nat.sInf_mem hne, fun m hm ↦ Nat.sInf_le hm⟩, ?_⟩
  constructor
  · exact div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  · rw [extensionLevel, div_lt_iff₀ (by exact_mod_cast he₁)]
    exact_mod_cast (lt_of_le_of_lt (Nat.sInf_le hn) hnbound)

end Stacks.DegreePExtensionLevel
