module

public import StacksFrontier.RingTheory.DiscreteValuationRing.EliminateRamificationSolution.LocalSolutions
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Tag 09II from Epp's theorem: finiteness of integral closures and finite stages

Part 5 of the development of Stacks Tag 09II from Epp's theorem (Tag 09F9) in
`StacksFrontier.RingTheory.DiscreteValuationRing.EliminateRamificationSolution`. It contains
finiteness of integral closures over discrete valuation rings (via Nagata rings, adic
completions and geometric reducedness), the descent of primes and of nilradicals along directed
unions of finite subextensions, and the finite stages at which reduced tensor products become
geometrically reduced.
-/

@[expose] public section

universe uA uB uK uL v uK₁ uL₁ uA₁ uB₁

namespace Stacks.EliminateRamification

open IsLocalRing
open scoped TensorProduct

/-- Finiteness of integral closure descends along a faithfully flat extension. -/
private theorem finite_integralClosure_of_faithfullyFlat
    (R S T : Type*) [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Module.FaithfullyFlat R S] [IsNoetherianRing S]
    [Module.Finite S (integralClosure S (S ⊗[R] T))] :
    Module.Finite R (integralClosure R T) := by
  have : Module.Finite S (S ⊗[R] integralClosure R T) :=
    Module.Finite.of_injective (TensorProduct.toIntegralClosure R S T).toLinearMap
      TensorProduct.toIntegralClosure_injective_of_flat
  exact Module.Finite.of_finite_tensorProduct_of_faithfullyFlat S

/-- An essentially finite type algebra over a Nagata ring is Nagata. -/
private theorem isNagataRing_of_essFiniteType
    (R S : Type uK) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.EssFiniteType R S] (hR : IsNagataRing R) : IsNagataRing S := by
  obtain ⟨s, hloc⟩ := Algebra.EssFiniteType.cond (R := R) (S := S)
  let S₀ := Algebra.adjoin R (s : Set S)
  have : Algebra.FiniteType R S₀ := by
    constructor
    rw [Subalgebra.fg_top]
    exact Subalgebra.fg_adjoin_finset s
  have hft : ∀ (D : Type uK) [CommRing D] [Algebra R D] [Algebra.FiniteType R D],
      IsNagataRing D := ((isNagataRing_tfae (R := R)).out 1 2).mp hR
  have hS₀ : IsNagataRing S₀ := hft S₀
  exact isNagata_of_isLocalization S₀
    (Submonoid.comap (algebraMap S₀ S) (IsUnit.submonoid S)) S hS₀

/-- A reduced base change to a faithfully flat Nagata algebra has finite integral closure. -/
private theorem finite_integralClosure_of_faithfullyFlat_of_isNagataRing
    (R S T : Type uK) [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Module.FaithfullyFlat R S]
    [Algebra.EssFiniteType R T] [IsReduced (S ⊗[R] T)]
    (hS : IsNagataRing S) : Module.Finite R (integralClosure R T) := by
  have : IsNoetherianRing S := hS.1
  have : Module.Finite S (integralClosure S (S ⊗[R] T)) :=
    IsIntegralClosure.finite_of_essFiniteType_of_isReduced (S := S ⊗[R] T) hS.2
  exact finite_integralClosure_of_faithfullyFlat R S T

/-- A Noetherian local ring with maximal ideal generated by a nonzerodivisor is reduced. -/
private theorem isReduced_of_maximalIdeal_eq_span_nonZeroDivisor
    (R : Type*) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (π : R) (hπ : π ∈ nonZeroDivisors R) (hm : maximalIdeal R = Ideal.span {π}) :
    IsReduced R := by
  classical
  refine ⟨fun {x} hx => ?_⟩
  by_contra hx0
  have hN : ∃ N : ℕ, x ∉ Ideal.span {π ^ N} := by
    by_contra! h
    have hmem : x ∈ ⨅ i : ℕ, maximalIdeal R ^ i := by
      simp only [Submodule.mem_iInf, hm, Ideal.span_singleton_pow]
      exact h
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal R).ne_top] at hmem
    exact hx0 hmem
  have hN0 : Nat.find hN ≠ 0 := by
    intro he
    have hn := Nat.find_spec hN
    simp [he] at hn
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
  have hnot : x ∉ Ideal.span {π ^ (n + 1)} := by
    simpa only [hn] using Nat.find_spec hN
  have hmem : x ∈ Ideal.span {π ^ n} := by
    by_contra h
    have := Nat.find_min' hN h
    omega
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hmem
  have hcunit : IsUnit c := by
    rw [← notMem_maximalIdeal, hm]
    intro h
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp h
    apply hnot
    rw [Ideal.mem_span_singleton, hc, hd]
    exact ⟨d, by ring⟩
  have hxreg : x ∈ nonZeroDivisors R := by
    rw [hc]
    exact (nonZeroDivisors R).mul_mem ((nonZeroDivisors R).pow_mem hπ n)
      hcunit.mem_nonZeroDivisors
  obtain ⟨k, hk⟩ := hx
  have hkreg := (nonZeroDivisors R).pow_mem hxreg k
  rw [hk] at hkreg
  exact zero_notMem_nonZeroDivisors hkreg

/-- The maximal-ideal-adic completion of a DVR is reduced. -/
private theorem isReduced_adicCompletion_of_isDiscreteValuationRing
    (R : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] :
    IsReduced (AdicCompletion (maximalIdeal R) R) := by
  let S := AdicCompletion (maximalIdeal R) R
  have : Module.Flat R S := AdicCompletion.flat_of_isNoetherian _
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  apply isReduced_of_maximalIdeal_eq_span_nonZeroDivisor S (algebraMap R S π)
  · have hreg : IsSMulRegular S (algebraMap R S π) :=
      (show IsSMulRegular R π from fun _ _ h => mul_left_cancel₀ hπ.ne_zero h).of_flat
    exact (isLeftRegular_iff_isRegular.mp hreg).mem_nonZeroDivisors
  · exact AdicCompletion.maximalIdeal_eq_map.trans
      ((congrArg (Ideal.map (algebraMap R S)) hπ.maximalIdeal_eq).trans (by
        simp only [Ideal.map_span, Set.image_singleton]))

/-- A geometrically reduced generic algebra remains reduced over any reduced base algebra. -/
private theorem isReduced_tensorProduct_of_generic_geometricallyReduced (R K S T : Type*)
    [CommRing R] [Field K] [Algebra R K] [IsFractionRing R K]
    [CommRing S] [Algebra R S] [IsReduced S]
    [CommRing T] [Algebra K T] [Algebra R T] [IsScalarTower R K T]
    [Algebra.IsGeometricallyReduced K T] : IsReduced (S ⊗[R] T) := by
  let : Algebra S (K ⊗[R] S) := Algebra.TensorProduct.rightAlgebra
  have : IsLocalization (Algebra.algebraMapSubmonoid S (nonZeroDivisors R))
      (K ⊗[R] S) := inferInstance
  let f := IsLocalization.algEquiv (Algebra.algebraMapSubmonoid S (nonZeroDivisors R))
    (K ⊗[R] S) (Localization (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)))
  have : IsReduced (K ⊗[R] S) := isReduced_of_injective f.toRingHom f.injective
  have : IsReduced ((K ⊗[R] S) ⊗[K] T) := inferInstance
  let e := (Algebra.TensorProduct.comm R S T).trans
    ((Algebra.TensorProduct.cancelBaseChange R K K T S).restrictScalars R).symm
  let e' := e.trans ((Algebra.TensorProduct.comm K T (K ⊗[R] S)).restrictScalars R)
  exact isReduced_of_injective e'.toRingHom e'.injective

/-- An essentially finite type DVR model has finite normalization when its generic algebra
is geometrically reduced. -/
private theorem finite_integralClosure_of_isDiscreteValuationRing_of_isGeometricallyReduced_aux
    (R : Type uK) (K : Type*) (S T : Type uK) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [CommRing S] [Algebra R S] [Algebra.EssFiniteType R S]
    [CommRing T] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Algebra K T] [IsScalarTower R K T] [Algebra.EssFiniteType S T]
    [Algebra.IsGeometricallyReduced K T] :
    Module.Finite S (integralClosure S T) := by
  let Rhat := AdicCompletion (maximalIdeal R) R
  have : Module.FaithfullyFlat R Rhat :=
    AdicCompletion.faithfullyFlat_of_le_ringJacobson _
      (le_of_eq (ringJacobson_eq_maximalIdeal R).symm)
  have : IsReduced Rhat := isReduced_adicCompletion_of_isDiscreteValuationRing R
  have hRhat : IsNagataRing Rhat := IsNagataRing.of_isPrecomplete_maximalIdeal
  let Shat := S ⊗[R] Rhat
  have hShat : IsNagataRing Shat := MonogenicN1.isNagataRing_of_ringEquiv
    (Algebra.TensorProduct.comm R Rhat S).toRingEquiv
    (isNagataRing_of_essFiniteType Rhat (Rhat ⊗[R] S) hRhat)
  have : IsReduced (Rhat ⊗[R] T) :=
    isReduced_tensorProduct_of_generic_geometricallyReduced R K Rhat T
  let e := ((Algebra.TensorProduct.comm S Shat T).restrictScalars R).trans
    (((Algebra.TensorProduct.cancelBaseChange R S S T Rhat).restrictScalars R).trans
      (Algebra.TensorProduct.comm R T Rhat))
  have : IsReduced (Shat ⊗[S] T) := isReduced_of_injective e.toRingHom e.injective
  exact finite_integralClosure_of_faithfullyFlat_of_isNagataRing S Shat T hShat

/-- An essentially finite type algebra has a model in the universe of its base ring. -/
private theorem small_of_essFiniteType
    (R : Type uK) (S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.EssFiniteType R S] : Small.{uK} S := by
  classical
  obtain ⟨s, hs⟩ := Algebra.EssFiniteType.cond (R := R) (S := S)
  let S₀ := Algebra.adjoin R (s : Set S)
  have : Small.{uK} S₀ := Algebra.small_adjoin
  let M := Submonoid.comap (algebraMap S₀ S) (IsUnit.submonoid S)
  have : IsLocalization M S := hs
  exact small_of_surjective (f := fun p : S₀ × M => IsLocalization.mk' S p.1 p.2)
    fun z => let ⟨x, y, h⟩ := IsLocalization.exists_mk'_eq M z; ⟨(x, y), h⟩

/-- The algebra structure on `Shrink T` is compatible with that of `T`. -/
private theorem isScalarTower_shrink (R X T : Type*) [CommRing R] [CommRing X] [CommRing T]
    [Algebra R X] [Algebra R T] [Algebra X T] [IsScalarTower R X T] [Small.{uK} T] :
    IsScalarTower R X (Shrink.{uK} T) := IsScalarTower.of_algebraMap_eq fun r => by
  apply (Shrink.algEquiv R T).injective
  change (Shrink.algEquiv R T) (algebraMap R (Shrink T) r) =
    (Shrink.algEquiv X T) (algebraMap X (Shrink T) (algebraMap R X r))
  rw [AlgEquiv.commutes, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply]

/-- The normalization finiteness criterion is independent of the universes of its algebras. -/
@[ega "II 6.3.10" "partial, special case"]
private theorem finite_integralClosure_of_isDiscreteValuationRing_of_isGeometricallyReduced
    (R : Type uK) (K S T : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [CommRing S] [Algebra R S] [Algebra.EssFiniteType R S]
    [CommRing T] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Algebra K T] [IsScalarTower R K T] [Algebra.EssFiniteType S T]
    [Algebra.IsGeometricallyReduced K T] :
    Module.Finite S (integralClosure S T) := by
  have : Algebra.EssFiniteType R T := Algebra.EssFiniteType.comp R S T
  have : Small.{uK} S := small_of_essFiniteType R S
  have : Small.{uK} T := small_of_essFiniteType R T
  let S' := Shrink.{uK} S
  let T' := Shrink.{uK} T
  let eS : S' ≃ₐ[R] S := Shrink.algEquiv R S
  have : IsScalarTower R S T' := isScalarTower_shrink R S T
  have : IsScalarTower R K T' := isScalarTower_shrink R K T
  let : Algebra S' T' := ((algebraMap S T').comp eS.toRingHom).toAlgebra
  have : IsScalarTower R S' T' := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R T' r = algebraMap S T' (eS (algebraMap R S' r))
    rw [eS.commutes, ← IsScalarTower.algebraMap_apply]
  have : Algebra.EssFiniteType R S' :=
    Algebra.EssFiniteType.of_surjective eS.symm.toAlgHom eS.symm.surjective
  have : Algebra.EssFiniteType R T' :=
    Algebra.EssFiniteType.of_surjective (Shrink.algEquiv R T).symm.toAlgHom
      (Shrink.algEquiv R T).symm.surjective
  have : Algebra.EssFiniteType S' T' := Algebra.EssFiniteType.of_comp R S' T'
  have : Algebra.IsGeometricallyReduced K T' :=
    Algebra.IsGeometricallyReduced.of_injective (Shrink.algEquiv K T).toAlgHom
      (Shrink.algEquiv K T).injective
  have : Module.Finite S' (integralClosure S' T') :=
    finite_integralClosure_of_isDiscreteValuationRing_of_isGeometricallyReduced_aux R K S' T'
  have : IsScalarTower S S' T' :=
    IsScalarTower.of_algebraMap_eq (R := S) (S := S') (A := T') fun s => by
    change algebraMap S T' s = algebraMap S T' (eS (eS.symm s))
    rw [eS.apply_symm_apply]
  have : Module.Finite S S' := Module.Finite.equiv (Shrink.algEquiv S S).symm.toLinearEquiv
  have : IsScalarTower S S' (integralClosure S' T') :=
    IsScalarTower.of_algebraMap_eq fun s => by
      apply Subtype.ext
      exact IsScalarTower.algebraMap_apply S S' T' s
  have : Module.Finite S (integralClosure S' T') := RingHom.finite_algebraMap.mp (by
    rw [IsScalarTower.algebraMap_eq S S' (integralClosure S' T')]
    exact (RingHom.finite_algebraMap.mpr (inferInstance :
      Module.Finite S' (integralClosure S' T'))).comp
      (Shrink.algEquiv S S).symm.toRingEquiv.finite)
  have : Algebra.IsIntegral S S' :=
    ⟨RingHom.isIntegral_of_surjective (f := algebraMap S S')
      (Shrink.algEquiv S S).symm.surjective⟩
  have : IsIntegralClosure (integralClosure S' T') S T' :=
    ⟨IsIntegralClosure.algebraMap_injective _ S' _,
      fun hx => (IsIntegralClosure.isIntegral_iff (R := S')).mp hx.tower_top,
      fun hx => isIntegral_trans (R := S) _
        ((IsIntegralClosure.isIntegral_iff (R := S')).mpr hx)⟩
  let e := IsIntegralClosure.equiv S (integralClosure S' T') T' (integralClosure S T')
  have : Module.Finite S (integralClosure S T') := Module.Finite.equiv e.toLinearEquiv
  exact Module.Finite.equiv (Shrink.algEquiv S T).mapIntegralClosure.toLinearEquiv

/-- Finite subextensions of a field extension form a directed family. -/
private theorem isDirectedOrder_finite_intermediateField (K E : Type*) [Field K] [Field E]
    [Algebra K E] : IsDirectedOrder {F : IntermediateField K E // Module.Finite K F} :=
  ⟨fun F G => by
    have := F.property
    have := G.property
    exact ⟨⟨F.val ⊔ G.val, inferInstance⟩,
      show F.val ≤ F.val ⊔ G.val from le_sup_left,
      show G.val ≤ F.val ⊔ G.val from le_sup_right⟩⟩

/-- The tensor maps of inclusions of subextensions are compatible with the maps to `E`. -/
private theorem map_comp_map_inclusion {K E L : Type*} [Field K] [Field E] [CommRing L]
    [Algebra K E] [Algebra K L] {F G : IntermediateField K E} (h : F ≤ G) :
    (Algebra.TensorProduct.map (.id L L) G.val).comp
      (Algebra.TensorProduct.map (.id L L) (IntermediateField.inclusion h)) =
        Algebra.TensorProduct.map (.id L L) F.val := by ext; rfl

/-- Every tensor over an algebraic extension comes from a finite subextension. -/
private theorem exists_finite_intermediateField_tensorProduct_preimage
    (K L E : Type*) [Field K] [CommRing L] [Algebra K L] [Field E]
    [Algebra K E] [Algebra.IsAlgebraic K E] (x : L ⊗[K] E) :
    ∃ F : IntermediateField K E, Module.Finite K F ∧
      ∃ y : L ⊗[K] F, Algebra.TensorProduct.map (.id L L) F.val y = x := by
  classical
  induction x using TensorProduct.inductionOn with
  | tmul l e =>
    let F := IntermediateField.adjoin K {e}
    have : Module.Finite K F :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral e)
    exact ⟨F, inferInstance, l ⊗ₜ[K] ⟨e, IntermediateField.subset_adjoin K _ rfl⟩, rfl⟩
  | add x z hx hz =>
    obtain ⟨F, hF, y, rfl⟩ := hx
    obtain ⟨G, hG, w, rfl⟩ := hz
    have := hF
    have := hG
    refine ⟨F ⊔ G, inferInstance,
      Algebra.TensorProduct.map (.id L L) (IntermediateField.inclusion le_sup_left) y +
      Algebra.TensorProduct.map (.id L L) (IntermediateField.inclusion le_sup_right) w, ?_⟩
    rw [map_add, ← AlgHom.comp_apply, map_comp_map_inclusion, ← AlgHom.comp_apply,
      map_comp_map_inclusion]

/-- A finitely generated ideal in a directed union is extended from a finite stage. -/
private theorem exists_map_comap_eq_of_directed_ranges
    {C : Type*} [CommRing C] {ι : Type*} [Preorder ι]
    [IsDirectedOrder ι] [Nonempty ι] (S : ι → Type*)
    [∀ i, CommRing (S i)] (f : ∀ i, S i →+* C)
    (hmono : Monotone fun i => (f i).range)
    (hcover : ∀ x : C, ∃ i, x ∈ (f i).range)
    (q : Ideal C) (hq : q.FG) :
    ∃ i, ∀ j, i ≤ j → (q.comap (f j)).map (f j) = q := by
  classical
  obtain ⟨s, hs⟩ := hq
  choose g hg using fun x : s => hcover x.val
  obtain ⟨i, hi⟩ := Finite.exists_le g
  refine ⟨i, fun j hij => le_antisymm Ideal.map_comap_le ?_⟩
  apply le_trans (le_of_eq hs.symm)
  rw [Ideal.span_le]
  intro x hx
  obtain ⟨y, hy⟩ := hmono ((hi ⟨x, hx⟩).trans hij) (hg ⟨x, hx⟩)
  have hyq : y ∈ q.comap (f j) := by
    change f j y ∈ q
    rw [hy, ← hs]
    exact Ideal.subset_span hx
  have hy' : f j y = x := hy
  rw [← hy']
  exact Ideal.mem_map_of_mem (f j) hyq

/-- All primes of a Noetherian ring with finite spectrum are extended from one stage. -/
private theorem exists_forall_prime_map_comap_eq_of_directed_ranges
    {C : Type*} [CommRing C] [IsNoetherianRing C]
    [Finite (PrimeSpectrum C)] {ι : Type*} [Preorder ι]
    [IsDirectedOrder ι] [Nonempty ι] (S : ι → Type*)
    [∀ i, CommRing (S i)] (f : ∀ i, S i →+* C)
    (hmono : Monotone fun i => (f i).range)
    (hcover : ∀ x : C, ∃ i, x ∈ (f i).range) :
    ∃ i, ∀ j, i ≤ j → ∀ q : PrimeSpectrum C,
      (q.asIdeal.comap (f j)).map (f j) = q.asIdeal := by
  choose g hg using fun q : PrimeSpectrum C =>
    exists_map_comap_eq_of_directed_ranges S f hmono hcover q.asIdeal
      (Ideal.fg_of_isNoetherianRing q.asIdeal)
  obtain ⟨i, hi⟩ := Finite.exists_le g
  exact ⟨i, fun j hij q => hg q j ((hi q).trans hij)⟩

/-- Extension of the contracted prime gives equality of the localized maximal ideals. -/
theorem map_maximalIdeal_localRingHom_of_map_comap_eq
    {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (q : Ideal S) [q.IsPrime]
    (hq : (q.comap f).map f = q) :
    (maximalIdeal (Localization.AtPrime (q.comap f))).map
        (Localization.localRingHom (q.comap f) q f rfl) =
      maximalIdeal (Localization.AtPrime q) := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (q.comap f), Ideal.map_map]
  have hcomp : (Localization.localRingHom (q.comap f) q f rfl).comp
      (algebraMap R (Localization.AtPrime (q.comap f))) =
      (algebraMap S (Localization.AtPrime q)).comp f :=
    RingHom.ext (Localization.localRingHom_to_map (q.comap f) q f rfl)
  rw [hcomp, ← Ideal.map_map, hq]
  exact IsLocalization.AtPrime.map_eq_maximalIdeal q _

/-- Injective integral maps covering a finite spectrum eventually induce bijections on spectra. -/
private theorem exists_primeSpectrum_comap_bijective_of_directed_ranges
    (B C : Type*) [CommRing B] [CommRing C] [Algebra B C]
    [Algebra.IsIntegral B C] [IsNoetherianRing C] [Finite (PrimeSpectrum C)]
    {ι : Type*} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]
    (S : ι → Type*) [∀ i, CommRing (S i)] [∀ i, Algebra B (S i)]
    (f : ∀ i, S i →ₐ[B] C) (hf : ∀ i, Function.Injective (f i))
    (hmono : Monotone fun i => (f i).range)
    (hcover : ∀ x : C, ∃ i, x ∈ (f i).range) :
    ∃ i, ∀ j, i ≤ j → Function.Bijective (PrimeSpectrum.comap (f j).toRingHom) ∧
      ∀ q : PrimeSpectrum C, (q.asIdeal.comap (f j)).map (f j) = q.asIdeal := by
  let R (i : ι) := (f i).range.toSubring
  have hint (i : ι) : (R i).subtype.IsIntegral := by
    let g : B →+* R i := (algebraMap B C).codRestrict (R i) fun b =>
      (f i).range.algebraMap_mem b
    apply RingHom.IsIntegral.tower_top g
    change (algebraMap B C).IsIntegral
    exact algebraMap_isIntegral_iff.mpr inferInstance
  obtain ⟨i, hi⟩ := exists_primeSpectrum_comap_bijective R hmono hcover hint
  obtain ⟨k, hk⟩ := exists_forall_prime_map_comap_eq_of_directed_ranges S
    (fun j => (f j).toRingHom) hmono hcover
  obtain ⟨m, him, hkm⟩ := exists_ge_ge i k
  refine ⟨m, fun j hmj => ⟨?_, hk j (hkm.trans hmj)⟩⟩
  have hij := him.trans hmj
  let e := AlgEquiv.ofInjective (f j) (hf j)
  have hb := (PrimeSpectrum.comapEquiv e.toRingEquiv).symm.bijective.comp (hi j hij)
  convert hb using 1
  change PrimeSpectrum.comap (f j).toRingHom =
    PrimeSpectrum.comap e.toRingHom ∘ PrimeSpectrum.comap (R j).subtype
  rw [← PrimeSpectrum.comap_comp]
  rfl

noncomputable abbrev integralClosureReducedTensorMap
    (B K L : Type*) {E : Type*} [CommRing B] [Field K] [CommRing L] [Field E]
    [Algebra K L] [Algebra K E] [Algebra B L] (F : IntermediateField K E) :=
  ((ReducedTensorTower.reductionMap
    (Algebra.TensorProduct.map (.id L L) F.val)).restrictScalars B).mapIntegralClosure

theorem monotone_integralClosureReducedTensorMap_range
    (B K L E : Type*) [CommRing B] [Field K] [CommRing L] [Field E]
    [Algebra K L] [Algebra K E] [Algebra B L] :
    Monotone fun F : IntermediateField K E => (integralClosureReducedTensorMap B K L F).range := by
  intro F G hFG x hx
  obtain ⟨y, rfl⟩ := hx
  let i := (ReducedTensorTower.reductionMap
    (Algebra.TensorProduct.map (.id L L) (IntermediateField.inclusion hFG))).restrictScalars B
  refine ⟨i.mapIntegralClosure y, ?_⟩
  apply Subtype.ext
  change (ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (.id L L) G.val))
    ((ReducedTensorTower.reductionMap
      (Algebra.TensorProduct.map (.id L L) (IntermediateField.inclusion hFG))) y.val) = _
  rw [← AlgHom.comp_apply, ← ReducedTensorTower.reductionMap_comp]
  rw [map_comp_map_inclusion hFG]
  rfl

theorem exists_mem_integralClosureReducedTensorMap_range
    (B K L E : Type*) [CommRing B] [Field K] [CommRing L] [Field E]
    [Algebra K L] [Algebra K E] [Algebra B L] [Algebra.IsAlgebraic K E]
    (x : integralClosure B (ReducedTensorTower.Reduction (L ⊗[K] E))) :
    ∃ F : IntermediateField K E, Module.Finite K F ∧
      x ∈ (integralClosureReducedTensorMap B K L F).range := by
  obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective x.val
  obtain ⟨F, hF, y, hy⟩ := exists_finite_intermediateField_tensorProduct_preimage K L E z
  let f := (ReducedTensorTower.reductionMap
    (Algebra.TensorProduct.map (.id L L) F.val)).restrictScalars B
  let y' : ReducedTensorTower.Reduction (L ⊗[K] F) := Ideal.Quotient.mk _ y
  have hxy : f y' = x.val := by
    change Ideal.Quotient.mk _ (Algebra.TensorProduct.map (.id L L) F.val y) = x.val
    rw [hy, hz]
  have hyint : IsIntegral B y' :=
    (isIntegral_algHom_iff f (reducedTensorProduct_map_injective K L F.val)).mp (by
      rw [hxy]
      exact x.property)
  exact ⟨F, hF, ⟨⟨y', hyint⟩, Subtype.ext hxy⟩⟩

theorem exists_primeSpectrum_bijective_integralClosure_reducedTensor_finite_stage
    (B K L E : Type*) [CommRing B] [Field K] [CommRing L] [Field E]
    [Algebra K L] [Algebra K E] [Algebra B L] [Algebra.IsAlgebraic K E]
    [IsNoetherianRing (integralClosure B ((L ⊗[K] E) ⧸ nilradical (L ⊗[K] E)))]
    [Finite (PrimeSpectrum (integralClosure B ((L ⊗[K] E) ⧸ nilradical (L ⊗[K] E))))] :
    let f (F : IntermediateField K E) :=
      (ReducedTensorTower.reductionMap
        (Algebra.TensorProduct.map (.id L L) F.val)).restrictScalars B
    ∃ F : IntermediateField K E, Module.Finite K F ∧
      ∀ G : IntermediateField K E, Module.Finite K G → F ≤ G →
        Function.Bijective (PrimeSpectrum.comap (f G).mapIntegralClosure.toRingHom) ∧
        ∀ q : PrimeSpectrum (integralClosure B ((L ⊗[K] E) ⧸ nilradical (L ⊗[K] E))),
          (q.asIdeal.comap (f G).mapIntegralClosure).map (f G).mapIntegralClosure =
            q.asIdeal := by
  classical
  dsimp only
  let C := integralClosure B ((L ⊗[K] E) ⧸ nilradical (L ⊗[K] E))
  let f (F : IntermediateField K E) :=
    (ReducedTensorTower.reductionMap
      (Algebra.TensorProduct.map (.id L L) F.val)).restrictScalars B
  let g (F : IntermediateField K E) := (f F).mapIntegralClosure
  have hf (F : IntermediateField K E) : Function.Injective (f F) :=
    reducedTensorProduct_map_injective K L F.val
  have hg (F : IntermediateField K E) : Function.Injective (g F) := fun x y h =>
    Subtype.ext (hf F (congrArg Subtype.val h))
  let ι := {F : IntermediateField K E // Module.Finite K F}
  have : Nonempty ι := ⟨⟨⊥, inferInstance⟩⟩
  have : IsDirectedOrder ι := isDirectedOrder_finite_intermediateField K E
  have hmono : Monotone (fun F : ι => (g F.val).range) :=
    fun _ _ h => monotone_integralClosureReducedTensorMap_range B K L E h
  have hcover (x : C) : ∃ F : ι, x ∈ (g F.val).range := by
    obtain ⟨F, hF, hx⟩ := exists_mem_integralClosureReducedTensorMap_range B K L E x
    exact ⟨⟨F, hF⟩, hx⟩
  obtain ⟨F, hF⟩ := exists_primeSpectrum_comap_bijective_of_directed_ranges B C
    (fun F : ι => integralClosure B (ReducedTensorTower.Reduction (L ⊗[K] F.val)))
    (fun F => g F.val) (fun F => hg F.val) hmono hcover
  exact ⟨F.val, F.property, fun G hG hFG => hF ⟨G, hG⟩ hFG⟩

/-- The canonical normalization maps eventually induce bijections on prime spectra. -/
theorem exists_primeSpectrum_bijective_integralClosureMap_finite_stage
    (A K E : Type*) [CommRing A] [Field K] [Field E]
    [Algebra A K] [Algebra K E] [Algebra A E] [IsScalarTower A K E]
    [Algebra.IsAlgebraic K E] [IsNoetherianRing (integralClosure A E)]
    [Finite (PrimeSpectrum (integralClosure A E))] :
    ∃ F : IntermediateField K E, Module.Finite K F ∧
      ∀ G : IntermediateField K E, Module.Finite K G → F ≤ G →
        Function.Bijective (PrimeSpectrum.comap
          (G.val.restrictScalars A).mapIntegralClosure.toRingHom) ∧
        ∀ q : PrimeSpectrum (integralClosure A E),
          (q.asIdeal.comap (G.val.restrictScalars A).mapIntegralClosure).map
            (G.val.restrictScalars A).mapIntegralClosure = q.asIdeal := by
  classical
  let C := integralClosure A E
  let g (F : IntermediateField K E) := (F.val.restrictScalars A).mapIntegralClosure
  have hg (F : IntermediateField K E) : Function.Injective (g F) := fun x y h =>
    Subtype.ext (F.val.injective (congrArg (fun z : C => (z : E)) h))
  let ι := {F : IntermediateField K E // Module.Finite K F}
  have : Nonempty ι := ⟨⟨⊥, inferInstance⟩⟩
  have : IsDirectedOrder ι := isDirectedOrder_finite_intermediateField K E
  have hmono : Monotone (fun F : ι => (g F.val).range) := by
    intro F G hFG x hx
    obtain ⟨y, rfl⟩ := hx
    let i := (IntermediateField.inclusion hFG).restrictScalars A
    exact ⟨i.mapIntegralClosure y, rfl⟩
  have hcover (x : C) : ∃ F : ι, x ∈ (g F.val).range := by
    let F := IntermediateField.adjoin K {x.val}
    have hF : Module.Finite K F :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral x.val)
    let y : F := ⟨x.val, IntermediateField.subset_adjoin K _ rfl⟩
    have hy : IsIntegral A y :=
      (isIntegral_algHom_iff (F.val.restrictScalars A) F.val.injective).mp x.property
    exact ⟨⟨F, hF⟩, ⟨⟨y, hy⟩, rfl⟩⟩
  obtain ⟨F, hF⟩ := exists_primeSpectrum_comap_bijective_of_directed_ranges A C
    (fun F : ι => integralClosure A F.val) (fun F => g F.val) (fun F => hg F.val)
    hmono hcover
  exact ⟨F.val, F.property, fun G hG hFG => hF ⟨G, hG⟩ hFG⟩

/-- Over an algebraic extension, a finitely generated nilradical descends to a finite stage. -/
theorem exists_finite_intermediateField_nilradical_map_eq
    (K A E : Type*) [Field K] [CommRing A] [Field E] [Algebra K A] [Algebra K E]
    [Algebra.IsAlgebraic K E] (hn : (nilradical (A ⊗[K] E)).FG) :
    ∃ F : IntermediateField K E, Module.Finite K F ∧
      (nilradical (A ⊗[K] F)).map
        (Algebra.TensorProduct.map (AlgHom.id A A) F.val).toRingHom =
          nilradical (A ⊗[K] E) := by
  classical
  let ι := {F : IntermediateField K E // Module.Finite K F}
  have : Nonempty ι := ⟨⟨⊥, inferInstance⟩⟩
  have : IsDirectedOrder ι := isDirectedOrder_finite_intermediateField K E
  let f (F : ι) := (Algebra.TensorProduct.map (AlgHom.id A A) F.val.val).toRingHom
  have hmono : Monotone fun F : ι => (f F).range := by
    intro F G hFG x hx
    obtain ⟨y, rfl⟩ := hx
    refine ⟨Algebra.TensorProduct.map (AlgHom.id A A) (IntermediateField.inclusion hFG) y, ?_⟩
    exact DFunLike.congr_fun (map_comp_map_inclusion hFG) y
  have hcover (x : A ⊗[K] E) : ∃ F : ι, x ∈ (f F).range := by
    obtain ⟨F, hF, y, hy⟩ := exists_finite_intermediateField_tensorProduct_preimage K A E x
    exact ⟨⟨F, hF⟩, y, hy⟩
  have hstage := @exists_map_comap_eq_of_directed_ranges (A ⊗[K] E) inferInstance
    ι inferInstance inferInstance inferInstance (fun F : ι => A ⊗[K] F.val)
    (fun F => inferInstance) f hmono hcover (nilradical (A ⊗[K] E)) hn
  obtain ⟨F, hF⟩ := hstage
  refine ⟨F.val, F.property, ?_⟩
  have hnil : (nilradical (A ⊗[K] E)).comap (f F) = nilradical (A ⊗[K] F.val) := by
    ext x
    simp only [Ideal.mem_comap, mem_nilradical]
    exact IsNilpotent.map_iff
      (Module.Flat.lTensor_preserves_injective_linearMap F.val.val.toLinearMap F.val.val.injective)
  rw [← hnil]
  exact hF F le_rfl

/-- An algebra is geometrically reduced if its base change to an algebraically closed field is
reduced. -/
private theorem isGeometricallyReduced_of_isReduced_tensorProduct_of_isAlgClosed
    (K Ω A : Type*) [Field K] [Field Ω] [IsAlgClosed Ω] [Algebra K Ω] [CommRing A] [Algebra K A]
    [IsReduced (Ω ⊗[K] A)] : Algebra.IsGeometricallyReduced K A := by
  apply (Algebra.isGeometricallyReduced_field_iff K A).mpr
  let j : AlgebraicClosure K →ₐ[K] Ω := IsAlgClosed.lift
  exact isReduced_of_injective (Algebra.TensorProduct.map j (AlgHom.id K A))
    (Module.Flat.rTensor_preserves_injective_linearMap j.toLinearMap j.injective)

/-- A finite-stage reduction is geometrically reduced if its nilradical extends to the
nilradical over an algebraically closed extension. -/
private theorem isGeometricallyReduced_reduction_of_nilradical_map_eq
    (K F E A : Type*) [Field K] [Field F] [Field E] [IsAlgClosed E] [CommRing A]
    [Algebra K F] [Algebra K E] [Algebra F E] [IsScalarTower K F E] [Algebra K A]
    (hn : (nilradical (A ⊗[K] F)).map
      (Algebra.TensorProduct.map (AlgHom.id A A) (IsScalarTower.toAlgHom K F E)).toRingHom =
        nilradical (A ⊗[K] E)) :
    let : Algebra F (A ⊗[K] F) := Algebra.TensorProduct.rightAlgebra
    Algebra.IsGeometricallyReduced F (ReducedTensorTower.Reduction (A ⊗[K] F)) := by
  let : Algebra E (A ⊗[K] E) := Algebra.TensorProduct.rightAlgebra
  let : Algebra F (A ⊗[K] F) := Algebra.TensorProduct.rightAlgebra
  let e : E ⊗[F] (A ⊗[K] F) ≃ₐ[E] A ⊗[K] E :=
    (Algebra.TensorProduct.congr (AlgEquiv.refl : E ≃ₐ[E] E)
      (Algebra.TensorProduct.commRight K F A).symm).trans
        ((Algebra.TensorProduct.cancelBaseChange K F E E A).trans
          (Algebra.TensorProduct.commRight K E A))
  have he : e.toRingHom.comp
      (Algebra.TensorProduct.includeRight : A ⊗[K] F →ₐ[F] E ⊗[F] (A ⊗[K] F)).toRingHom =
        (Algebra.TensorProduct.map (AlgHom.id A A) (IsScalarTower.toAlgHom K F E)).toRingHom := by
    apply RingHom.ext
    intro x
    induction x using TensorProduct.inductionOn with
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
    | tmul a f =>
      change e (1 ⊗ₜ[F] (a ⊗ₜ[K] f)) = a ⊗ₜ[K] algebraMap F E f
      simp only [e, AlgEquiv.trans_apply, Algebra.TensorProduct.congr_apply,
        Algebra.TensorProduct.map_tmul, AlgEquiv.coe_refl, AlgEquiv.coe_toAlgHom,
        Algebra.TensorProduct.commRight_symm_tmul, Algebra.TensorProduct.cancelBaseChange_tmul,
        Algebra.TensorProduct.commRight_tmul, Algebra.smul_def, id_eq, mul_one]
  have hnil : (nilradical (A ⊗[K] F)).map
      (Algebra.TensorProduct.includeRight : A ⊗[K] F →ₐ[F] E ⊗[F] (A ⊗[K] F)).toRingHom =
        nilradical (E ⊗[F] (A ⊗[K] F)) := by
    apply Function.LeftInverse.injective
      (fun I => Ideal.comap_map_of_bijective e.toRingHom e.bijective (I := I))
    rw [Ideal.map_map, he, hn]
    apply le_antisymm
    · intro x hx
      rw [Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective]
      exact ⟨e.symm x, mem_nilradical.mpr ((mem_nilradical.mp hx).map e.symm),
        e.apply_symm_apply x⟩
    · apply Ideal.map_le_iff_le_comap.mpr
      intro x hx
      exact mem_nilradical.mpr ((mem_nilradical.mp hx).map e)
  have : IsReduced (E ⊗[F] (ReducedTensorTower.Reduction (A ⊗[K] F))) :=
    isReduced_tensorProduct_reduction_of_nilradical_map_eq F E (A ⊗[K] F) hnil
  exact isGeometricallyReduced_of_isReduced_tensorProduct_of_isAlgClosed F E _

/-- After a finite field extension, the reduction of an essentially finite type algebra is
geometrically reduced. -/
private theorem exists_finite_extension_isGeometricallyReduced_reduction
    (K A : Type*) [Field K] [CommRing A] [Algebra K A] [Algebra.EssFiniteType K A] :
    ∃ F : IntermediateField K (AlgebraicClosure K), Module.Finite K F ∧
      let : Algebra F (A ⊗[K] F) := Algebra.TensorProduct.rightAlgebra
      Algebra.IsGeometricallyReduced F (ReducedTensorTower.Reduction (A ⊗[K] F)) := by
  classical
  let E := AlgebraicClosure K
  let : Algebra E (A ⊗[K] E) := Algebra.TensorProduct.rightAlgebra
  have : Algebra.EssFiniteType E (A ⊗[K] E) :=
    (Algebra.EssFiniteType.iff_of_algEquiv (Algebra.TensorProduct.commRight K E A)).mp inferInstance
  have : IsNoetherianRing (A ⊗[K] E) := Algebra.EssFiniteType.isNoetherianRing E _
  obtain ⟨F, hF, hn⟩ := exists_finite_intermediateField_nilradical_map_eq K A E
    (Ideal.fg_of_isNoetherianRing _)
  refine ⟨F, hF, ?_⟩
  exact isGeometricallyReduced_reduction_of_nilradical_map_eq K F E A hn

/-- Geometric reducedness of the reduced iterated base change is geometric reducedness
of the reduced direct base change. -/
private theorem isGeometricallyReduced_reducedTensorProduct_of_tower
    (K F E A : Type*) [Field K] [Field F] [Field E] [CommRing A]
    [Algebra K F] [Algebra K E] [Algebra F E] [IsScalarTower K F E] [Algebra K A]
    (h : let : Algebra F (A ⊗[K] F) := Algebra.TensorProduct.rightAlgebra
      let : Algebra E ((A ⊗[K] F) ⊗[F] E) := Algebra.TensorProduct.rightAlgebra
      Algebra.IsGeometricallyReduced E
        (ReducedTensorTower.Reduction ((A ⊗[K] F) ⊗[F] E))) :
    let : Algebra E (A ⊗[K] E) := Algebra.TensorProduct.rightAlgebra
    Algebra.IsGeometricallyReduced E (ReducedTensorTower.Reduction (A ⊗[K] E)) := by
  let : Algebra F (A ⊗[K] F) := Algebra.TensorProduct.rightAlgebra
  let : Algebra E ((A ⊗[K] F) ⊗[F] E) := Algebra.TensorProduct.rightAlgebra
  let : Algebra E (A ⊗[K] E) := Algebra.TensorProduct.rightAlgebra
  have := h
  let e : (A ⊗[K] F) ⊗[F] E ≃ₐ[E] A ⊗[K] E :=
    (Algebra.TensorProduct.commRight F E (A ⊗[K] F)).symm.trans
      ((Algebra.TensorProduct.congr (AlgEquiv.refl : E ≃ₐ[E] E)
        (Algebra.TensorProduct.commRight K F A).symm).trans
          ((Algebra.TensorProduct.cancelBaseChange K F E E A).trans
            (Algebra.TensorProduct.commRight K E A)))
  exact Algebra.IsGeometricallyReduced.of_injective
    (ReducedTensorTower.reductionEquiv e).symm.toAlgHom
    (ReducedTensorTower.reductionEquiv e).symm.injective

/-- Generic inseparability can be removed by a finite extension of any given base extension. -/
theorem exists_finite_extension_isGeometricallyReduced_reducedTensorProduct
    (K : Type*) (E : Type uK) (A : Type*) [Field K] [Field E] [CommRing A]
    [Algebra K E] [Algebra K A] [Algebra.EssFiniteType K A] :
    ∃ (F : Type uK) (_ : Field F) (_ : Algebra E F) (_ : Algebra K F)
      (_ : IsScalarTower K E F) (_ : Module.Finite E F),
      let : Algebra F (A ⊗[K] F) := Algebra.TensorProduct.rightAlgebra
      Algebra.IsGeometricallyReduced F (ReducedTensorTower.Reduction (A ⊗[K] F)) := by
  let : Algebra E (A ⊗[K] E) := Algebra.TensorProduct.rightAlgebra
  have : Algebra.EssFiniteType E (A ⊗[K] E) :=
    (Algebra.EssFiniteType.iff_of_algEquiv (Algebra.TensorProduct.commRight K E A)).mp inferInstance
  obtain ⟨F, hF, hgeom⟩ := exists_finite_extension_isGeometricallyReduced_reduction E (A ⊗[K] E)
  let : Algebra K F := ((algebraMap E F).comp (algebraMap K E)).toAlgebra
  have : IsScalarTower K E F := IsScalarTower.of_algebraMap_eq fun _ => rfl
  refine ⟨F, inferInstance, inferInstance, inferInstance, inferInstance, hF, ?_⟩
  exact isGeometricallyReduced_reducedTensorProduct_of_tower K E F A hgeom

/-- Geometric reducedness descends through an injective scalar-extension map. -/
private theorem isGeometricallyReduced_of_injective_tensorProduct
    (K E A B : Type*) [Field K] [Field E] [CommRing A] [CommRing B]
    [Algebra K E] [Algebra K A] [Algebra E B]
    [Algebra.IsGeometricallyReduced E B]
    (f : E ⊗[K] A →ₐ[E] B) (hf : Function.Injective f) :
    Algebra.IsGeometricallyReduced K A := by
  let Ω := AlgebraicClosure E
  have : IsScalarTower K E Ω := inferInstance
  have : IsReduced (Ω ⊗[E] B) :=
    (Algebra.isGeometricallyReduced_field_iff E B).mp inferInstance
  let g : Ω ⊗[E] (E ⊗[K] A) →ₐ[Ω] Ω ⊗[E] B :=
    Algebra.TensorProduct.map (AlgHom.id Ω Ω) f
  have hg : Function.Injective g := Module.Flat.lTensor_preserves_injective_linearMap
    f.toLinearMap hf
  let e := Algebra.TensorProduct.cancelBaseChange K E Ω Ω A
  have : IsReduced (Ω ⊗[K] A) :=
    isReduced_of_injective (g.comp e.symm.toAlgHom) (hg.comp e.symm.injective)
  exact isGeometricallyReduced_of_isReduced_tensorProduct_of_isAlgClosed K Ω A

/-- A field extension is separable when its scalar extension injects into a separable field. -/
theorem isSeparableExtension_of_injective_tensorProduct
    (K E L M : Type*) [Field K] [Field E] [Field L] [Field M]
    [Algebra K E] [Algebra K L] [Algebra E M] [Algebra.IsSeparableExtension E M]
    (f : E ⊗[K] L →ₐ[E] M) (hf : Function.Injective f) :
    Algebra.IsSeparableExtension K L := by
  have : Algebra.IsGeometricallyReduced E M :=
    ((Algebra.isSeparableExtension_tfae E M (ringExpChar E)).out 1 4).mp
      (show Algebra.IsSeparableExtension E M from inferInstance)
  have : Algebra.IsGeometricallyReduced K L :=
    isGeometricallyReduced_of_injective_tensorProduct K E L M f hf
  exact ((Algebra.isSeparableExtension_tfae K L (ringExpChar K)).out 4 1).mp
    (show Algebra.IsGeometricallyReduced K L from inferInstance)

open IsDiscreteValuationRing in
/-- Finiteness of a semilocal normalization can be checked on its canonical localizations. -/
theorem finite_integralClosure_of_isLocalized_maximal
    (R T : Type*) [CommRing R] [CommRing T] [Algebra R T]
    [Finite (MaximalSpectrum R)]
    (h : ∀ (p : Ideal R) [p.IsMaximal],
      Module.Finite (Localization.AtPrime p)
        (integralClosure (Localization.AtPrime p)
          (Localization (Algebra.algebraMapSubmonoid T p.primeCompl)))) :
    Module.Finite R (integralClosure R T) := by
  let C := integralClosure R T
  let Tₚ (p : Ideal R) [p.IsMaximal] := Localization (Algebra.algebraMapSubmonoid T p.primeCompl)
  let Cₚ (p : Ideal R) [p.IsMaximal] := integralClosure (Localization.AtPrime p) (Tₚ p)
  let f (p : Ideal R) [p.IsMaximal] : C →ₐ[R] Cₚ p :=
    integralClosureMapOfScalarTower (S := Localization.AtPrime p)
      (IsScalarTower.toAlgHom R T (Tₚ p))
  let (p : Ideal R) [p.IsMaximal] : Algebra C (Cₚ p) := (f p).toAlgebra
  have (p : Ideal R) [p.IsMaximal] : IsScalarTower R C (Cₚ p) :=
    IsScalarTower.of_algebraMap_eq fun x => (f p).commutes x |>.symm
  have (p : Ideal R) [p.IsMaximal] :
      IsLocalization (Algebra.algebraMapSubmonoid C p.primeCompl) (Cₚ p) :=
    isLocalization_integralClosureMapOfScalarTower R T (Localization.AtPrime p) (Tₚ p) p.primeCompl
  have hloc (p : Ideal R) [p.IsMaximal] : IsLocalizedModule p.primeCompl (f p).toLinearMap := by
    have hloc := IsLocalizedModule.restrictScalars p.primeCompl (Algebra.linearMap C (Cₚ p))
    convert! hloc using 1
  exact @Module.Finite.of_isLocalized_maximal R _ _ C _ _
    (fun p _ => Localization.AtPrime p) (fun p _ => inferInstance)
    (fun p _ => inferInstance) (fun p _ => inferInstance)
    (fun p _ => (Cₚ p : Type _)) (fun p _ => inferInstance)
    (fun p _ => inferInstance) (fun p _ => inferInstance) (fun p _ => inferInstance)
    (fun p _ => (f p).toLinearMap) (fun p _ => hloc p) h

/-- Geometric reducedness is preserved by localization. -/
private theorem isGeometricallyReduced_of_isLocalization
    (K R T : Type*) [Field K] [CommRing R] [CommRing T]
    [Algebra K R] [Algebra K T] [Algebra R T] [IsScalarTower K R T]
    [Algebra.IsGeometricallyReduced K R]
    (M : Submonoid R) [IsLocalization M T] :
    Algebra.IsGeometricallyReduced K T := by
  let Ω := AlgebraicClosure K
  have : IsReduced (Ω ⊗[K] R) :=
    (Algebra.isGeometricallyReduced_field_iff K R).mp inferInstance
  let f : Ω ⊗[K] R →ₐ[Ω] Ω ⊗[K] T :=
    Algebra.TensorProduct.map (AlgHom.id Ω Ω) (IsScalarTower.toAlgHom K R T)
  let : Algebra (Ω ⊗[K] R) (Ω ⊗[K] T) := f.toAlgebra
  have : IsScalarTower Ω (Ω ⊗[K] R) (Ω ⊗[K] T) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  let N := M.map (Algebra.TensorProduct.includeRight : R →ₐ[K] Ω ⊗[K] R)
  have : IsLocalization N (Ω ⊗[K] T) := by
    apply IsLocalization.tensorProduct_tensorProduct_right K Ω M T
    ext x
    rfl
  let e := IsLocalization.algEquiv N (Ω ⊗[K] T) (Localization N)
  exact (Algebra.isGeometricallyReduced_field_iff K T).mpr
    (isReduced_of_injective e.toRingHom e.injective)

/-- Localizing an essentially finite type model over a Dedekind domain above a nonzero
prime gives a finite normalization if the generic algebra is geometrically reduced. -/
theorem finite_integralClosure_localization_of_isDedekindDomain
    (R K S T : Type*) [CommRing R] [IsDedekindDomain R]
    [Field K] [Algebra R K] [IsFractionRing R K]
    [CommRing S] [Algebra R S] [Algebra.EssFiniteType R S]
    [CommRing T] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Algebra K T] [IsScalarTower R K T] [Algebra.EssFiniteType S T]
    [Algebra.IsGeometricallyReduced K T]
    (q : Ideal S) [q.IsPrime] (hq : q.comap (algebraMap R S) ≠ ⊥) :
    Module.Finite (Localization.AtPrime q)
      (integralClosure (Localization.AtPrime q)
        (Localization (Algebra.algebraMapSubmonoid T q.primeCompl))) := by
  let p := q.comap (algebraMap R S)
  let Rp := Localization.AtPrime p
  let Sq := Localization.AtPrime q
  let Tq := Localization (Algebra.algebraMapSubmonoid T q.primeCompl)
  let g : Rp →ₐ[R] K := Localization.mapToFractionRing K p.primeCompl Rp
    p.primeCompl_le_nonZeroDivisors
  let : Algebra Rp K := g.toAlgebra
  have : IsScalarTower R Rp K := IsScalarTower.of_algebraMap_eq fun r => (g.commutes r).symm
  have : IsFractionRing Rp K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization p.primeCompl Rp K
  have : IsDiscreteValuationRing Rp :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R hq Rp
  let j : Rp →+* Sq := Localization.localRingHom p q (algebraMap R S) rfl
  let : Algebra Rp Sq := j.toAlgebra
  have : IsScalarTower R Rp Sq := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap R Sq r = j (algebraMap R Rp r)
    exact (IsScalarTower.algebraMap_apply R S Sq r).trans
      (Localization.localRingHom_to_map p q (algebraMap R S) rfl r).symm
  have : IsScalarTower R Sq Tq := IsScalarTower.to₁₃₄ R S Sq Tq
  let : Algebra Rp Tq := ((algebraMap K Tq).comp (algebraMap Rp K)).toAlgebra
  have : IsScalarTower Rp K Tq := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R Rp Tq := IsScalarTower.to₁₂₄ R Rp K Tq
  have : IsScalarTower Rp Sq Tq := IsScalarTower.of_algebraMap_eq' (by
    apply IsLocalization.ringHom_ext p.primeCompl
    ext r
    simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply])
  have : Algebra.EssFiniteType S Sq := Algebra.EssFiniteType.of_isLocalization Sq q.primeCompl
  have : Algebra.EssFiniteType R Sq := Algebra.EssFiniteType.comp R S Sq
  have : Algebra.EssFiniteType Rp Sq := Algebra.EssFiniteType.of_comp R Rp Sq
  have : Algebra.EssFiniteType T Tq :=
    Algebra.EssFiniteType.of_isLocalization Tq (Algebra.algebraMapSubmonoid T q.primeCompl)
  have : Algebra.EssFiniteType S Tq := Algebra.EssFiniteType.comp S T Tq
  have : Algebra.EssFiniteType Sq Tq := Algebra.EssFiniteType.of_comp S Sq Tq
  have : Algebra.IsGeometricallyReduced K Tq :=
    isGeometricallyReduced_of_isLocalization K T Tq (Algebra.algebraMapSubmonoid T q.primeCompl)
  exact finite_integralClosure_of_isDiscreteValuationRing_of_isGeometricallyReduced Rp K Sq Tq

end Stacks.EliminateRamification
