module

public import StacksFrontier.RingTheory.DiscreteValuationRing.EliminateRamificationSolution.PerfectResidueCase

/-!
# Tag 09II from Epp's theorem: reduced tensor products and localizations of integral closures

Part 3 of the development of Stacks Tag 09II from Epp's theorem (Tag 09F9) in
`StacksFrontier.RingTheory.DiscreteValuationRing.EliminateRamificationSolution`. It contains
nilradicals and reductions of tensor products, the base change equivalences of reduced tensor
products, and localizations of integral closures along scalar towers and of reduced tensor
products.
-/

@[expose] public section

universe uA uB uK uL v uK₁ uL₁ uA₁ uB₁

namespace Stacks.EliminateRamification

open IsLocalRing
open scoped TensorProduct

/-- A ring map sends the nilradical into the nilradical. -/
theorem nilradical_le_comap {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) :
    nilradical R ≤ (nilradical S).comap f := fun _ hx =>
  mem_nilradical.mpr ((mem_nilradical.mp hx).map f)

/-- An injective ring map induces an injective map of reductions. -/
private theorem quotientMap_nilradical_injective {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : Function.Injective f) :
    Function.Injective (Ideal.quotientMap (nilradical S) f (nilradical_le_comap f)) := by
  apply Ideal.quotientMap_injective'
  intro x hx
  exact mem_nilradical.mpr ((IsNilpotent.map_iff hf).mp (mem_nilradical.mp hx))

/-- For a field extension `E → F` over a field `K`, the induced map of reduced tensor products
`(L ⊗[K] E)_red → (L ⊗[K] F)_red` is injective. -/
theorem reducedTensorProduct_map_injective (K L : Type*) {E F : Type*}
    [Field K] [CommRing L] [Algebra K L] [Field E] [Field F] [Algebra K E] [Algebra K F]
    (g : E →ₐ[K] F) :
    Function.Injective
      (Ideal.quotientMap (nilradical (L ⊗[K] F))
        (Algebra.TensorProduct.map (AlgHom.id K L) g).toRingHom
        (nilradical_le_comap _)) :=
  quotientMap_nilradical_injective _
    (Module.Flat.lTensor_preserves_injective_linearMap g.toLinearMap g.injective)

/-- A surjective algebra map with nil kernel induces an equivalence on reductions. -/
private theorem reductionMap_bijective_of_surjective_of_ker_le_nilradical
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
    (f : A →ₐ[R] B) (hf : Function.Surjective f)
    (hker : RingHom.ker f ≤ nilradical A) :
    Function.Bijective (ReducedTensorTower.reductionMap f) := by
  have hnil := nilradical_le_comap f.toRingHom
  have hanti : (nilradical B).comap f.toRingHom ≤ nilradical A := by
    change (Ideal.comap f.toRingHom (⊥ : Ideal B).radical) ≤ (⊥ : Ideal A).radical
    rw [Ideal.comap_radical]
    exact (Ideal.radical_mono hker).trans_eq (Ideal.radical_idem ⊥)
  exact ⟨Ideal.quotientMap_injective' (H := hnil) hanti,
    Ideal.quotientMap_surjective (H := hnil) hf⟩

/-- The kernel of `A ⊗[R] B → A ⊗[R] (B ⧸ nilradical B)` is generated by the nilradical of `B`. -/
private theorem ker_map_quotient_nilradical
    (R A B : Type*) [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B] :
    RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R A)
      (Ideal.Quotient.mkₐ R (nilradical B))) =
      (nilradical B).map (Algebra.TensorProduct.includeRight : B →ₐ[R] A ⊗[R] B).toRingHom := by
  rw [Algebra.TensorProduct.lTensor_ker _ Ideal.Quotient.mk_surjective]
  exact congrArg (Ideal.map _) (Ideal.mk_ker (I := nilradical B))

/-- Reducing a tensor factor does not change the reduction of the tensor product. -/
theorem reductionMap_tensorProduct_quotient_nilradical_bijective
    (R A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] :
    Function.Bijective (ReducedTensorTower.reductionMap
      (Algebra.TensorProduct.map (AlgHom.id A A) (Ideal.Quotient.mkₐ R (nilradical B)))) := by
  apply reductionMap_bijective_of_surjective_of_ker_le_nilradical
  · exact Algebra.TensorProduct.map_surjective _ _ Function.surjective_id
      Ideal.Quotient.mk_surjective
  · change RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R A)
      (Ideal.Quotient.mkₐ R (nilradical B))) ≤ _
    rw [ker_map_quotient_nilradical, Ideal.map_le_iff_le_comap]
    exact nilradical_le_comap _

/-- Reduction and extension of scalars commute after reducing the result. -/
noncomputable def reducedTensorProductCancelBaseChange
    (R S T A : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Algebra R A] :
    ReducedTensorTower.Reduction (T ⊗[S] ReducedTensorTower.Reduction (S ⊗[R] A)) ≃ₐ[T]
      ReducedTensorTower.Reduction (T ⊗[R] A) := by
  let f : T ⊗[S] (S ⊗[R] A) →ₐ[T] T ⊗[S] ReducedTensorTower.Reduction (S ⊗[R] A) :=
    Algebra.TensorProduct.map (AlgHom.id T T)
      (Ideal.Quotient.mkₐ S (nilradical (S ⊗[R] A)))
  have hf : Function.Bijective (ReducedTensorTower.reductionMap f) :=
    reductionMap_tensorProduct_quotient_nilradical_bijective S T (S ⊗[R] A)
  let e : ReducedTensorTower.Reduction (T ⊗[S] (S ⊗[R] A)) ≃ₐ[T]
      ReducedTensorTower.Reduction (T ⊗[S] ReducedTensorTower.Reduction (S ⊗[R] A)) :=
    AlgEquiv.ofBijective (ReducedTensorTower.reductionMap f) hf
  exact e.symm.trans (ReducedTensorTower.reductionEquiv
    (Algebra.TensorProduct.cancelBaseChange R S T T A))

/-- The reduced scalar-extension comparison sends a pure tensor to its canonical image. -/
private theorem reducedTensorProductCancelBaseChange_tmul
    (R S T A : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Algebra R A]
    (t : T) (s : S) (a : A) :
    reducedTensorProductCancelBaseChange R S T A
        (Ideal.Quotient.mk _ (t ⊗ₜ[S] (Ideal.Quotient.mk _ (s ⊗ₜ[R] a)))) =
      Ideal.Quotient.mk _ ((s • t) ⊗ₜ[R] a) := by
  let f : T ⊗[S] (S ⊗[R] A) →ₐ[T] T ⊗[S] ReducedTensorTower.Reduction (S ⊗[R] A) :=
    Algebra.TensorProduct.map (AlgHom.id T T)
      (Ideal.Quotient.mkₐ S (nilradical (S ⊗[R] A)))
  have hf : Function.Bijective (ReducedTensorTower.reductionMap f) :=
    reductionMap_tensorProduct_quotient_nilradical_bijective S T (S ⊗[R] A)
  let e : ReducedTensorTower.Reduction (T ⊗[S] (S ⊗[R] A)) ≃ₐ[T]
      ReducedTensorTower.Reduction (T ⊗[S] ReducedTensorTower.Reduction (S ⊗[R] A)) :=
    AlgEquiv.ofBijective (ReducedTensorTower.reductionMap f) hf
  have he : e (Ideal.Quotient.mk _ (t ⊗ₜ[S] (s ⊗ₜ[R] a))) =
      Ideal.Quotient.mk _ (t ⊗ₜ[S] (Ideal.Quotient.mk _ (s ⊗ₜ[R] a))) := by
    change ReducedTensorTower.reductionMap f (Ideal.Quotient.mk _ (t ⊗ₜ[S] (s ⊗ₜ[R] a))) = _
    rw [ReducedTensorTower.reductionMap_mk]
    simp only [f, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      Ideal.Quotient.mkₐ_eq_mk]
  change ReducedTensorTower.reductionEquiv (Algebra.TensorProduct.cancelBaseChange R S T T A)
    (e.symm _) = _
  rw [← he, e.symm_apply_apply, ReducedTensorTower.reductionEquiv_mk,
    Algebra.TensorProduct.cancelBaseChange_tmul]

/-- A scalar extension of a reduction is reduced when it generates the full nilradical. -/
theorem isReduced_tensorProduct_reduction_of_nilradical_map_eq
    (R S A : Type*) [CommRing R] [CommRing S] [CommRing A]
    [Algebra R S] [Algebra R A]
    (hn : (nilradical A).map
      (Algebra.TensorProduct.includeRight : A →ₐ[R] S ⊗[R] A).toRingHom =
        nilradical (S ⊗[R] A)) :
    IsReduced (S ⊗[R] (A ⧸ nilradical A)) := by
  let f := Algebra.TensorProduct.map (AlgHom.id S S) (Ideal.Quotient.mkₐ R (nilradical A))
  have hf : Function.Surjective f := Algebra.TensorProduct.map_surjective _ _
    Function.surjective_id Ideal.Quotient.mk_surjective
  apply (RingHom.ker_isRadical_iff_reduced_of_surjective hf).mp
  change (RingHom.ker (Algebra.TensorProduct.map (AlgHom.id R S)
    (Ideal.Quotient.mkₐ R (nilradical A)))).IsRadical
  rw [ker_map_quotient_nilradical, hn]
  exact Ideal.radical_isRadical ⊥

/-- Reduction of an iterated tensor product agrees canonically with direct base change. -/
noncomputable def reducedTensorProductBaseChangeEquiv
    (R S T A : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Algebra R A] :
    letI : Algebra S (A ⊗[R] S) := Algebra.TensorProduct.rightAlgebra
    letI : Algebra T (A ⊗[R] T) := Algebra.TensorProduct.rightAlgebra
    ReducedTensorTower.Reduction (T ⊗[S] ReducedTensorTower.Reduction (A ⊗[R] S)) ≃ₐ[T]
      ReducedTensorTower.Reduction (A ⊗[R] T) := by
  letI : Algebra S (A ⊗[R] S) := Algebra.TensorProduct.rightAlgebra
  letI : Algebra T (A ⊗[R] T) := Algebra.TensorProduct.rightAlgebra
  let e : ReducedTensorTower.Reduction (A ⊗[R] S) ≃ₐ[S] ReducedTensorTower.Reduction (S ⊗[R] A) :=
    ReducedTensorTower.reductionEquiv (Algebra.TensorProduct.commRight R S A).symm
  exact (ReducedTensorTower.reductionEquiv (Algebra.TensorProduct.congr
    (AlgEquiv.refl : T ≃ₐ[T] T) e)).trans
    ((reducedTensorProductCancelBaseChange R S T A).trans
      (ReducedTensorTower.reductionEquiv (Algebra.TensorProduct.commRight R T A)))

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem reducedTensorProductBaseChangeEquiv_tmul
    (R S T A : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Algebra R A]
    (t : T) (a : A) (s : S) :
    reducedTensorProductBaseChangeEquiv R S T A
        (Ideal.Quotient.mk _ (t ⊗ₜ[S] (Ideal.Quotient.mk _ (a ⊗ₜ[R] s)))) =
      Ideal.Quotient.mk _ (a ⊗ₜ[R] (s • t)) := by
  simp only [reducedTensorProductBaseChangeEquiv, AlgEquiv.trans_apply,
    ReducedTensorTower.reductionEquiv_mk, Algebra.TensorProduct.congr_apply,
    Algebra.TensorProduct.map_tmul,
    AlgEquiv.coe_refl, AlgEquiv.coe_toAlgHom,
    Algebra.TensorProduct.commRight_symm_tmul,
    reducedTensorProductCancelBaseChange_tmul, Algebra.TensorProduct.commRight_tmul]
  rfl

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
private theorem reducedTensorProductBaseChangeEquiv_includeRight
    (R S T A : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] [Algebra R A]
    (x : ReducedTensorTower.Reduction (A ⊗[R] S)) :
    reducedTensorProductBaseChangeEquiv R S T A (Ideal.Quotient.mk _ (1 ⊗ₜ[S] x)) =
      ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id A A)
        (IsScalarTower.toAlgHom R S T)) x := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction x using TensorProduct.inductionOn with
  | add x y hx hy => simp only [map_add, TensorProduct.tmul_add, hx, hy]
  | tmul a s =>
    rw [reducedTensorProductBaseChangeEquiv_tmul, ReducedTensorTower.reductionMap_mk]
    simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, IsScalarTower.toAlgHom_apply,
      Algebra.smul_def, mul_one]

open IsDiscreteValuationRing in
/-- Localization commutes with normalization for the canonical comparison map. -/
theorem isLocalization_integralClosureMapOfScalarTower
    (R S Rf Sf : Type*) [CommRing R] [CommRing S] [CommRing Rf] [CommRing Sf]
    [Algebra R S] [Algebra R Rf] [Algebra S Sf] [Algebra Rf Sf] [Algebra R Sf]
    [IsScalarTower R S Sf] [IsScalarTower R Rf Sf]
    (M : Submonoid R) [IsLocalization M Rf]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) Sf] :
    letI := (integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)).toAlgebra
    IsLocalization (Algebra.algebraMapSubmonoid (integralClosure R S) M)
      (integralClosure Rf Sf) := by
  let g := integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)
  let := g.toAlgebra
  have : IsScalarTower R (integralClosure R S) (integralClosure Rf Sf) :=
    IsScalarTower.of_algebraMap_eq fun r => (g.commutes r).symm
  have : IsScalarTower (integralClosure R S) (integralClosure Rf Sf) Sf :=
    IsScalarTower.of_algebraMap_eq fun x => rfl
  exact IsLocalization.integralClosure M

open IsDiscreteValuationRing in
/-- A prime localization of the localized normalization is a prime localization of the original
normalization. -/
private theorem isLocalization_atPrime_integralClosureMapOfScalarTower
    (R S Rf Sf : Type*) [CommRing R] [CommRing S] [CommRing Rf] [CommRing Sf]
    [Algebra R S] [Algebra R Rf] [Algebra S Sf] [Algebra Rf Sf] [Algebra R Sf]
    [IsScalarTower R S Sf] [IsScalarTower R Rf Sf]
    (M : Submonoid R) [IsLocalization M Rf]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) Sf]
    (q : Ideal (integralClosure Rf Sf)) [q.IsPrime] :
    letI := (integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)).toAlgebra
    IsLocalization.AtPrime (Localization.AtPrime q)
      (q.comap (integralClosureMapOfScalarTower (S := Rf)
        (IsScalarTower.toAlgHom R S Sf)).toRingHom) := by
  let := (integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)).toAlgebra
  have := isLocalization_integralClosureMapOfScalarTower R S Rf Sf M
  exact IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
    (Algebra.algebraMapSubmonoid (integralClosure R S) M) (Localization.AtPrime q) q

open IsDiscreteValuationRing in
/-- Normalizing after localization gives the same prime localization of the normalization. -/
private noncomputable def integralClosureLocalizationAtPrimeEquiv
    (R S Rf Sf : Type*) [CommRing R] [CommRing S] [CommRing Rf] [CommRing Sf]
    [Algebra R S] [Algebra R Rf] [Algebra S Sf] [Algebra Rf Sf] [Algebra R Sf]
    [IsScalarTower R S Sf] [IsScalarTower R Rf Sf]
    (M : Submonoid R) [IsLocalization M Rf]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) Sf]
    (q : Ideal (integralClosure Rf Sf)) [q.IsPrime] :
    letI := (integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)).toAlgebra
    Localization.AtPrime (q.comap (integralClosureMapOfScalarTower (S := Rf)
      (IsScalarTower.toAlgHom R S Sf)).toRingHom) ≃ₐ[
      integralClosure R S] Localization.AtPrime q := by
  letI := (integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)).toAlgebra
  have := isLocalization_atPrime_integralClosureMapOfScalarTower R S Rf Sf M q
  let g := integralClosureMapOfScalarTower (S := Rf) (IsScalarTower.toAlgHom R S Sf)
  exact IsLocalization.algEquiv (q.comap g.toRingHom).primeCompl
    (Localization.AtPrime (q.comap g.toRingHom)) (Localization.AtPrime q)

noncomputable def integralClosureEquivOfIntegralBase
    (R C T : Type*) [CommRing R] [CommRing C] [CommRing T]
    [Algebra R C] [Algebra R T] [Algebra C T] [IsScalarTower R C T]
    [Algebra.IsIntegral R C] :
    letI := (IsIntegralClosure.lift R (integralClosure R T) T :
      C →ₐ[R] integralClosure R T).toAlgebra
    integralClosure R T ≃ₐ[C] integralClosure C T := by
  let f : C →ₐ[R] integralClosure R T := IsIntegralClosure.lift R (integralClosure R T) T
  letI := f.toAlgebra
  have : IsScalarTower C (integralClosure R T) T := IsScalarTower.of_algebraMap_eq fun x =>
    (IsIntegralClosure.algebraMap_lift R (integralClosure R T) T x).symm
  have : IsIntegralClosure (integralClosure R T) C T := IsIntegralClosure.tower_top (R := R)
  exact IsIntegralClosure.equiv C (integralClosure R T) T (integralClosure C T)

theorem integralClosureEquivOfIntegralBase_apply
    (R C T : Type*) [CommRing R] [CommRing C] [CommRing T]
    [Algebra R C] [Algebra R T] [Algebra C T] [IsScalarTower R C T]
    [Algebra.IsIntegral R C] (x : integralClosure R T) :
    (integralClosureEquivOfIntegralBase R C T x).val = x.val := by
  let f : C →ₐ[R] integralClosure R T := IsIntegralClosure.lift R (integralClosure R T) T
  let := f.toAlgebra
  have : IsScalarTower C (integralClosure R T) T := IsScalarTower.of_algebraMap_eq fun x =>
    (IsIntegralClosure.algebraMap_lift R (integralClosure R T) T x).symm
  have : IsIntegralClosure (integralClosure R T) C T := IsIntegralClosure.tower_top (R := R)
  exact IsIntegralClosure.algebraMap_equiv C (integralClosure R T) T (integralClosure C T) x

open IsDiscreteValuationRing in
noncomputable def integralClosureMapOfIntegralBase
    (R C T Cf Tf : Type*) [CommRing R] [CommRing C] [CommRing T] [CommRing Cf] [CommRing Tf]
    [Algebra R C] [Algebra R T] [Algebra C T] [IsScalarTower R C T]
    [Algebra.IsIntegral R C]
    [Algebra C Cf] [Algebra C Tf] [Algebra T Tf] [Algebra Cf Tf]
    [IsScalarTower C T Tf] [IsScalarTower C Cf Tf] :
    letI := (IsIntegralClosure.lift R (integralClosure R T) T :
      C →ₐ[R] integralClosure R T).toAlgebra
    integralClosure R T →ₐ[C] integralClosure Cf Tf := by
  letI := (IsIntegralClosure.lift R (integralClosure R T) T : C →ₐ[R] integralClosure R T).toAlgebra
  exact (integralClosureMapOfScalarTower (S := Cf) (IsScalarTower.toAlgHom C T Tf)).comp
    (integralClosureEquivOfIntegralBase R C T).toAlgHom

theorem integralClosureMapOfIntegralBase_apply
    (R C T Cf Tf : Type*) [CommRing R] [CommRing C] [CommRing T] [CommRing Cf] [CommRing Tf]
    [Algebra R C] [Algebra R T] [Algebra C T] [IsScalarTower R C T]
    [Algebra.IsIntegral R C]
    [Algebra C Cf] [Algebra C Tf] [Algebra T Tf] [Algebra Cf Tf]
    [IsScalarTower C T Tf] [IsScalarTower C Cf Tf] (x : integralClosure R T) :
    (integralClosureMapOfIntegralBase R C T Cf Tf x).val = algebraMap T Tf x.val := by
  change algebraMap T Tf (integralClosureEquivOfIntegralBase R C T x).val = _
  rw [integralClosureEquivOfIntegralBase_apply]

open IsDiscreteValuationRing in
theorem isLocalization_integralClosureMapOfIntegralBase
    (R C T Cf Tf : Type*) [CommRing R] [CommRing C] [CommRing T] [CommRing Cf] [CommRing Tf]
    [Algebra R C] [Algebra R T] [Algebra C T] [IsScalarTower R C T]
    [Algebra.IsIntegral R C]
    [Algebra C Cf] [Algebra C Tf] [Algebra T Tf] [Algebra Cf Tf]
    [IsScalarTower C T Tf] [IsScalarTower C Cf Tf]
    (M : Submonoid C) [IsLocalization M Cf]
    [IsLocalization (Algebra.algebraMapSubmonoid T M) Tf] :
    letI := (IsIntegralClosure.lift R (integralClosure R T) T :
      C →ₐ[R] integralClosure R T).toAlgebra
    letI := (integralClosureMapOfIntegralBase R C T Cf Tf).toAlgebra
    IsLocalization (Algebra.algebraMapSubmonoid (integralClosure R T) M)
      (integralClosure Cf Tf) := by
  let := (IsIntegralClosure.lift R (integralClosure R T) T : C →ₐ[R] integralClosure R T).toAlgebra
  let e := integralClosureEquivOfIntegralBase R C T
  let g := integralClosureMapOfScalarTower (S := Cf) (IsScalarTower.toAlgHom C T Tf)
  let := g.toAlgebra
  have : IsLocalization (Algebra.algebraMapSubmonoid (integralClosure C T) M)
      (integralClosure Cf Tf) := isLocalization_integralClosureMapOfScalarTower C T Cf Tf M
  let := (integralClosureMapOfIntegralBase R C T Cf Tf).toAlgebra
  apply IsLocalization.of_ringEquiv_left e.toRingEquiv
    (M₁ := Algebra.algebraMapSubmonoid (integralClosure C T) M)
  · change (M.map (algebraMap C (integralClosure R T)).toMonoidHom).map e.toMonoidHom =
      M.map (algebraMap C (integralClosure C T)).toMonoidHom
    rw [Submonoid.map_map]
    congr 1
    ext x
    exact congrArg Subtype.val (e.commutes x)
  · intro x
    rfl

open IsDiscreteValuationRing in
private theorem isLocalization_reducedTensorProduct
    (R S A B : Type*) [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra R B] [Algebra A B] [IsScalarTower R A B]
    (M : Submonoid A) [IsLocalization M B] :
    let f := Algebra.TensorProduct.map (AlgHom.id S S) (IsScalarTower.toAlgHom R A B)
    letI := (ReducedTensorTower.reductionMap f).toAlgebra
    IsLocalization
      (Algebra.algebraMapSubmonoid (ReducedTensorTower.Reduction (S ⊗[R] A))
        (M.map (Algebra.TensorProduct.includeRight : A →ₐ[R] S ⊗[R] A)))
      (ReducedTensorTower.Reduction (S ⊗[R] B)) := by
  let f : S ⊗[R] A →ₐ[S] S ⊗[R] B :=
    Algebra.TensorProduct.map (AlgHom.id S S) (IsScalarTower.toAlgHom R A B)
  let := f.toAlgebra
  have : IsScalarTower S (S ⊗[R] A) (S ⊗[R] B) :=
    IsScalarTower.of_algebraMap_eq fun s => (f.commutes s).symm
  have hcomp : (algebraMap (S ⊗[R] A) (S ⊗[R] B)).comp
      (Algebra.TensorProduct.includeRight : A →ₐ[R] S ⊗[R] A).toRingHom =
      (Algebra.TensorProduct.includeRight : B →ₐ[R] S ⊗[R] B).toRingHom.comp (algebraMap A B) := by
    ext a
    change f (1 ⊗ₜ[R] a) = 1 ⊗ₜ[R] algebraMap A B a
    simp only [f, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, IsScalarTower.toAlgHom_apply]
  have := IsLocalization.tensorProduct_tensorProduct_right R S M B hcomp
  let : Algebra (ReducedTensorTower.Reduction (S ⊗[R] A))
      (ReducedTensorTower.Reduction (S ⊗[R] B)) := (ReducedTensorTower.reductionMap f).toAlgebra
  exact isLocalization_reduction (S ⊗[R] A) (S ⊗[R] B)
    (M.map (Algebra.TensorProduct.includeRight : A →ₐ[R] S ⊗[R] A)) (fun _ => rfl)

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
noncomputable def reducedTensorProductLocalizationMap
    (R S T A B : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T]
    [Algebra R A] [Algebra S B]
    (g : ReducedTensorTower.Reduction (A ⊗[R] S) →ₐ[S] B) :
    ReducedTensorTower.Reduction (A ⊗[R] T) →ₐ[T] ReducedTensorTower.Reduction (B ⊗[S] T) :=
  (ReducedTensorTower.reductionEquiv (Algebra.TensorProduct.commRight S T B)).toAlgHom.comp
    ((ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id T T) g)).comp
      (reducedTensorProductBaseChangeEquiv R S T A).symm.toAlgHom)

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
theorem reducedTensorProductLocalizationMap_includeRight
    (R S T A B : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T]
    [Algebra R A] [Algebra S B]
    (g : ReducedTensorTower.Reduction (A ⊗[R] S) →ₐ[S] B)
    (x : ReducedTensorTower.Reduction (A ⊗[R] S)) :
    reducedTensorProductLocalizationMap R S T A B g
        (ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id A A)
          (IsScalarTower.toAlgHom R S T)) x) =
      Ideal.Quotient.mk _ (g x ⊗ₜ[S] (1 : T)) := by
  rw [← reducedTensorProductBaseChangeEquiv_includeRight R S T A x]
  simp only [reducedTensorProductLocalizationMap, AlgHom.comp_apply,
    AlgEquiv.coe_toAlgHom, AlgEquiv.symm_apply_apply,
    ReducedTensorTower.reductionMap_mk, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
    ReducedTensorTower.reductionEquiv_mk, Algebra.TensorProduct.commRight_tmul]

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
theorem isLocalization_reducedTensorProductLocalizationMap
    (R S T A B : Type*) [CommRing R] [CommRing S] [CommRing T] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T]
    [Algebra R A] [Algebra S B]
    (g : ReducedTensorTower.Reduction (A ⊗[R] S) →ₐ[S] B)
    (M : Submonoid (ReducedTensorTower.Reduction (A ⊗[R] S)))
    (hM : letI := g.toAlgebra; IsLocalization M B) :
    letI := (reducedTensorProductLocalizationMap R S T A B g).toAlgebra
    IsLocalization
      (M.map (ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id A A)
        (IsScalarTower.toAlgHom R S T))))
      (ReducedTensorTower.Reduction (B ⊗[S] T)) := by
  let Q := ReducedTensorTower.Reduction (A ⊗[R] S)
  let := g.toAlgebra
  have : IsScalarTower S Q B := IsScalarTower.of_algebraMap_eq fun s => (g.commutes s).symm
  have : IsLocalization M B := hM
  let f : ReducedTensorTower.Reduction (T ⊗[S] Q) →ₐ[T] ReducedTensorTower.Reduction (T ⊗[S] B) :=
    ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id T T) g)
  let := f.toAlgebra
  let N : Submonoid (ReducedTensorTower.Reduction (T ⊗[S] Q)) :=
    Algebra.algebraMapSubmonoid (ReducedTensorTower.Reduction (T ⊗[S] Q))
      (M.map (Algebra.TensorProduct.includeRight : Q →ₐ[S] T ⊗[S] Q))
  have : IsLocalization N (ReducedTensorTower.Reduction (T ⊗[S] B)) :=
    isLocalization_reducedTensorProduct S T Q B M
  let e := reducedTensorProductBaseChangeEquiv R S T A
  let c := ReducedTensorTower.reductionEquiv (Algebra.TensorProduct.commRight S T B)
  have he := IsLocalization.isLocalization_of_base_ringEquiv N
    (ReducedTensorTower.Reduction (T ⊗[S] B)) e.toRingEquiv
  let := (f.toRingHom.comp e.symm.toRingHom).toAlgebra
  have : IsLocalization (N.map e.toRingEquiv) (ReducedTensorTower.Reduction (T ⊗[S] B)) := he
  have hc := (IsLocalization.isLocalization_iff_of_ringEquiv (N.map e.toRingEquiv) c.toRingEquiv).mp
    (inferInstance : IsLocalization (N.map e.toRingEquiv) (ReducedTensorTower.Reduction (T ⊗[S] B)))
  have hN : N.map e.toRingEquiv =
      M.map (ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id A A)
        (IsScalarTower.toAlgHom R S T))) := by
    change ((M.map (Algebra.TensorProduct.includeRight : Q →ₐ[S] T ⊗[S] Q).toMonoidHom).map
      (algebraMap (T ⊗[S] Q)
        (ReducedTensorTower.Reduction (T ⊗[S] Q))).toMonoidHom).map e.toMonoidHom =
      M.map (ReducedTensorTower.reductionMap (Algebra.TensorProduct.map (AlgHom.id A A)
        (IsScalarTower.toAlgHom R S T))).toMonoidHom
    rw [Submonoid.map_map, Submonoid.map_map]
    congr 1
    ext x
    exact reducedTensorProductBaseChangeEquiv_includeRight R S T A x
  convert! hc using 1
  exact hN.symm

end Stacks.EliminateRamification
