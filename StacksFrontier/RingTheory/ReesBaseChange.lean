module

public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Maps
public import Mathlib.RingTheory.GradedAlgebra.RingHom
public import Mathlib.RingTheory.GradedAlgebra.TensorProduct
public import Mathlib.RingTheory.PolynomialAlgebra
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesGrading

/-!
# The Rees algebra commutes with flat base change

Let `φ : A ⟶ B` be a homomorphism of commutative rings, let `J` be an ideal of `A` and let `K` be
the ideal of `B` generated by the image of `J`. Applying `φ` to coefficients sends the Rees
algebra `A[Jt]` into the Rees algebra `B[Kt]`, and respects the gradings
`Stacks.Blowup.reesGrading`.

When `B` is moreover a *flat* `A`-algebra and `φ` is its structure map, that homomorphism exhibits
`B[Kt]` as the base change of `A[Jt]`: the canonical comparison

```
B ⊗[A] A[Jt] ⟶ B[Kt]
```

is an isomorphism of graded rings, for the base-changed grading `Submodule.baseChange` on the
left.

## Main definitions

* `Stacks.Blowup.reesRingMap` is the homomorphism `A[Jt] ⟶ B[Kt]` induced by `φ`.
* `Stacks.Blowup.reesGradedMap` is the same homomorphism, graded.
* `Stacks.Blowup.reesBaseChange` is the induced homomorphism `B ⊗[A] A[Jt] ⟶ B[Kt]`.
* `Stacks.Blowup.reesBaseChangeGradedHom` is the comparison, graded.
* `Stacks.Blowup.reesBaseChangeGradedHomSymm` is its inverse, graded.

## Main results

* `Stacks.Blowup.reesGradedMap_id` and `Stacks.Blowup.reesGradedMap_comp`: the induced
  homomorphism is functorial in `φ`.
* `Stacks.Blowup.reesBaseChange_injective`: the comparison is injective when `B` is flat over `A`.
* `Stacks.Blowup.reesBaseChange_surjective`: the comparison is always surjective.
* `Stacks.Blowup.reesBaseChange_mem_reesGrading` and
  `Stacks.Blowup.exists_baseChange_eq_of_mem_reesGrading`: the comparison maps the degree-`n`
  piece of the base-changed grading onto the degree-`n` piece of `B[Kt]`.
* `Stacks.Blowup.irrelevant_le_reesBaseChangeGradedHom` and
  `Stacks.Blowup.irrelevant_le_reesBaseChangeGradedHomSymm`: the two irrelevant-ideal conditions
  which `AlgebraicGeometry.Proj.map` asks for, for the comparison and for its inverse.

## Implementation notes

The target ideal `K` is a parameter, constrained by the hypothesis `J.map φ = K`, rather than
being spelled `J.map φ` throughout, so that an ideal sheaf `ℐ` on a scheme can supply its own
value `ℐ(U)` for it with no transport along an equality of ideals.

## References

* [Stacks Project, Tag 01NO](https://stacks.math.columbia.edu/tag/01NO)
* [Stacks Project, Tag 01OG](https://stacks.math.columbia.edu/tag/01OG)
-/

@[expose] public noncomputable section

open Polynomial TensorProduct HomogeneousIdeal

universe u

namespace Stacks.Blowup

/-! ### The homomorphism induced by a ring homomorphism -/

section Map

variable {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (φ : A →+* B)
  (J : Ideal A) (K : Ideal B) (hK : J.map φ = K)

include hK in
/-- The image in `B[X]` of an element of the Rees algebra of `J` lies in the Rees algebra of the
ideal generated by the image of `J`. -/
theorem polynomial_map_mem_reesAlgebra (f : reesAlgebra J) :
    Polynomial.map φ (f : A[X]) ∈ reesAlgebra K := by
  intro i
  rw [Polynomial.coeff_map, ← hK, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ (f.2 i)

/-- The homomorphism of Rees algebras induced by a ring homomorphism `φ : A ⟶ B` carrying `J` onto
`K`. On polynomials it is coefficientwise application of `φ`. -/
def reesRingMap : reesAlgebra J →+* reesAlgebra K where
  toFun f := ⟨Polynomial.map φ (f : A[X]), polynomial_map_mem_reesAlgebra φ J K hK f⟩
  map_one' := Subtype.ext (by simp)
  map_mul' f g := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' f g := Subtype.ext (by simp)

/-- The induced homomorphism is coefficientwise application of `φ`. -/
@[simp]
theorem coe_reesRingMap (f : reesAlgebra J) :
    ((reesRingMap φ J K hK f : reesAlgebra K) : B[X]) = Polynomial.map φ (f : A[X]) :=
  rfl

/-- **The homomorphism of Rees algebras induced by a ring homomorphism, graded.** It carries the
degree-`n` piece `Jⁿ` of `A[Jt]` into the degree-`n` piece `Kⁿ` of `B[Kt]`. -/
def reesGradedMap : reesGrading J →+*ᵍ reesGrading K where
  __ := reesRingMap φ J K hK
  map_mem {n} {f} hf i hi := by
    rw [coe_reesRingMap, coe_eq_monomial J hf]
    simp [Polynomial.coeff_monomial, Ne.symm hi]

/-- The graded induced homomorphism is coefficientwise application of `φ`. -/
@[simp]
theorem coe_reesGradedMap (f : reesAlgebra J) :
    ((reesGradedMap φ J K hK f : reesAlgebra K) : B[X]) = Polynomial.map φ (f : A[X]) :=
  rfl

/-- The homomorphism induced by the identity is the identity. -/
theorem reesGradedMap_id (hJ : J.map (RingHom.id A) = J) :
    reesGradedMap (RingHom.id A) J J hJ = GradedRingHom.id (reesGrading J) :=
  GradedRingHom.ext fun _ ↦ Subtype.ext Polynomial.map_id

/-- The homomorphism induced by a composite is the composite of the induced homomorphisms. -/
theorem reesGradedMap_comp {ψ : B →+* C} {L : Ideal C} (hL : K.map ψ = L)
    (hcomp : J.map (ψ.comp φ) = L) :
    reesGradedMap (ψ.comp φ) J L hcomp =
      (reesGradedMap ψ K L hL).comp (reesGradedMap φ J K hK) :=
  GradedRingHom.ext fun f ↦ Subtype.ext (Polynomial.map_map φ ψ (f : A[X])).symm

include hK in
/-- The induced homomorphism may be rewritten along an equality of ring homomorphisms. -/
theorem reesGradedMap_congr {φ' : A →+* B} (hφ : φ = φ') (hK' : J.map φ' = K) :
    reesGradedMap φ J K hK = reesGradedMap φ' J K hK' := by
  subst hφ
  rfl

end Map

/-! ### The comparison with the base change -/

section BaseChange

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] (J : Ideal A) (K : Ideal B)
  (hK : J.map (algebraMap A B) = K)

/-- The homomorphism `Stacks.Blowup.reesRingMap` for the structure map of an algebra, as a
homomorphism of `A`-algebras. -/
def reesAlgMap : reesAlgebra J →ₐ[A] reesAlgebra K where
  __ := reesRingMap (algebraMap A B) J K hK
  commutes' a := Subtype.ext (by simp [Polynomial.algebraMap_apply])

/-- The induced algebra homomorphism is coefficientwise application of the structure map. -/
@[simp]
theorem coe_reesAlgMap (f : reesAlgebra J) :
    ((reesAlgMap J K hK f : reesAlgebra K) : B[X]) =
      Polynomial.map (algebraMap A B) (f : A[X]) :=
  rfl

/-- **The comparison homomorphism `B ⊗[A] A[Jt] ⟶ B[Kt]`.** It is the universal property of the
tensor product applied to the structure map of `B[Kt]` and to `Stacks.Blowup.reesAlgMap`. -/
def reesBaseChange : B ⊗[A] reesAlgebra J →ₐ[B] reesAlgebra K :=
  Algebra.TensorProduct.lift (Algebra.ofId B _) (reesAlgMap J K hK) fun _ _ ↦ mul_comm _ _

/-- The comparison homomorphism sends `b ⊗ f` to `b` times the image of `f`. -/
@[simp]
theorem coe_reesBaseChange_tmul (b : B) (f : reesAlgebra J) :
    ((reesBaseChange J K hK (b ⊗ₜ[A] f) : reesAlgebra K) : B[X]) =
      Polynomial.C b * Polynomial.map (algebraMap A B) (f : A[X]) := by
  have h : reesBaseChange J K hK (b ⊗ₜ[A] f) =
      Algebra.ofId B (reesAlgebra K) b * reesAlgMap J K hK f :=
    Algebra.TensorProduct.lift_tmul _ _ _ b f
  rw [h, Subalgebra.coe_mul, coe_reesAlgMap]
  congr 1

/-- The comparison homomorphism restricted along `a ↦ 1 ⊗ a` is
`Stacks.Blowup.reesGradedMap`. -/
theorem reesBaseChange_one_tmul (f : reesAlgebra J) :
    reesBaseChange J K hK (1 ⊗ₜ[A] f) = reesGradedMap (algebraMap A B) J K hK f :=
  Subtype.ext (by rw [coe_reesBaseChange_tmul, coe_reesGradedMap, map_one, one_mul])

/-! #### Injectivity -/

/-- The comparison homomorphism, followed by the inclusion of `B[Kt]` into `B[X]`, is the base
change of the inclusion of `A[Jt]` into `A[X]` read through `Polynomial.polyEquivTensor`. -/
theorem coe_reesBaseChange_eq (x : B ⊗[A] reesAlgebra J) :
    ((reesBaseChange J K hK x : reesAlgebra K) : B[X]) =
      (polyEquivTensor A B).symm (LinearMap.lTensor B (reesAlgebra J).val.toLinearMap x) := by
  induction x with
  | zero => simp
  | tmul b f =>
      rw [coe_reesBaseChange_tmul]
      change _ = (polyEquivTensor A B).symm (b ⊗ₜ[A] (f : A[X]))
      rw [polyEquivTensor_symm_apply_tmul_eq_smul, Algebra.smul_def, Polynomial.algebraMap_apply]
      simp
  | add x y hx hy => simp only [map_add, Subalgebra.coe_add, hx, hy]

/-- **The comparison homomorphism is injective when `B` is flat over `A`.** -/
theorem reesBaseChange_injective [Module.Flat A B] :
    Function.Injective (reesBaseChange J K hK) := fun x y h ↦ by
  have h₁ : ((reesBaseChange J K hK x : reesAlgebra K) : B[X]) =
      ((reesBaseChange J K hK y : reesAlgebra K) : B[X]) :=
    congrArg (fun z : reesAlgebra K ↦ (z : B[X])) h
  rw [coe_reesBaseChange_eq, coe_reesBaseChange_eq] at h₁
  exact Module.Flat.lTensor_preserves_injective_linearMap _ Subtype.val_injective
    ((polyEquivTensor A B).symm.injective h₁)

/-! #### Surjectivity -/

/-- Every monomial `monomial n r` with `r` in `Kⁿ` is the image of an element of the degree-`n`
piece of the base-changed grading. -/
private theorem exists_baseChange_coe_eq_monomial (n : ℕ) {r : B} (hr : r ∈ K ^ n) :
    ∃ x ∈ (reesGrading J n).baseChange B,
      ((reesBaseChange J K hK x : reesAlgebra K) : B[X]) = Polynomial.monomial n r := by
  rw [← hK, ← Ideal.map_pow, Ideal.map, ← Ideal.submodule_span_eq] at hr
  induction hr using Submodule.span_induction with
  | mem r hr =>
      obtain ⟨a, ha, rfl⟩ := hr
      refine ⟨1 ⊗ₜ[A] (reesMonomial J n ⟨a, ha⟩ : reesAlgebra J),
        Submodule.tmul_mem_baseChange_of_mem 1 (reesMonomial J n ⟨a, ha⟩).2, ?_⟩
      rw [coe_reesBaseChange_tmul]
      simp
  | zero => exact ⟨0, zero_mem _, by simp⟩
  | add r s _ _ ihr ihs =>
      obtain ⟨x, hx, hxr⟩ := ihr
      obtain ⟨y, hy, hys⟩ := ihs
      exact ⟨x + y, add_mem hx hy, by rw [map_add, Subalgebra.coe_add, hxr, hys, ← map_add]⟩
  | smul b r _ ih =>
      obtain ⟨x, hx, hxr⟩ := ih
      refine ⟨b • x, Submodule.smul_mem _ b hx, ?_⟩
      rw [map_smul, SetLike.val_smul, hxr]
      exact (map_smul (Polynomial.monomial n : B →ₗ[B] B[X]) b r).symm

/-- The image of the comparison homomorphism, as a `B`-subalgebra of `B[X]`. -/
def reesBaseChangeImage : Subalgebra B B[X] :=
  ((reesAlgebra K).val.comp (reesBaseChange J K hK)).range

/-- Every monomial `monomial n r` with `r` in the degree-`n` part `Kⁿ` of the target is in the
image of the comparison homomorphism. -/
theorem monomial_mem_reesBaseChangeImage (n : ℕ) {r : B} (hr : r ∈ K ^ n) :
    Polynomial.monomial n r ∈ reesBaseChangeImage J K hK :=
  let ⟨x, _, hx⟩ := exists_baseChange_coe_eq_monomial J K hK n hr
  ⟨x, hx⟩

/-- The Rees algebra of `K` is contained in the image of the comparison homomorphism. -/
theorem reesAlgebra_le_reesBaseChangeImage :
    reesAlgebra K ≤ reesBaseChangeImage J K hK := fun p hp ↦ by
  rw [p.as_sum_support]
  exact Subalgebra.sum_mem _ fun i _ ↦ monomial_mem_reesBaseChangeImage J K hK i (hp i)

/-- **The comparison homomorphism is surjective**, with no hypothesis on `B`. -/
theorem reesBaseChange_surjective : Function.Surjective (reesBaseChange J K hK) := fun g ↦ by
  obtain ⟨x, hx⟩ := reesAlgebra_le_reesBaseChangeImage J K hK g.2
  exact ⟨x, Subtype.ext hx⟩

/-! #### The grading -/

/-- The comparison homomorphism respects the grading: the degree-`n` piece of the base-changed
grading of `B ⊗[A] A[Jt]` is mapped into the degree-`n` piece of `B[Kt]`. -/
theorem reesBaseChange_mem_reesGrading {n : ℕ} {x : B ⊗[A] reesAlgebra J}
    (hx : x ∈ (reesGrading J n).baseChange B) :
    reesBaseChange J K hK x ∈ reesGrading K n := by
  rw [Submodule.baseChange_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨y, hy, rfl⟩ := hx
      change reesBaseChange J K hK (1 ⊗ₜ[A] y) ∈ _
      rw [reesBaseChange_one_tmul]
      exact GradedFunLike.map_mem _ hy
  | zero => simp
  | add x y _ _ ihx ihy => simpa [map_add] using add_mem ihx ihy
  | smul b x _ ih =>
      rw [map_smul]
      exact Submodule.smul_mem _ b ih

/-- The comparison homomorphism is onto each graded piece: every homogeneous element of degree `n`
of `B[Kt]` is the image of an element of the degree-`n` piece of the base-changed grading. -/
theorem exists_baseChange_eq_of_mem_reesGrading (n : ℕ) (g : reesGrading K n) :
    ∃ x ∈ (reesGrading J n).baseChange B,
      reesBaseChange J K hK x = (g : reesAlgebra K) := by
  have hg : ∀ i, (((g : reesAlgebra K) : B[X])).coeff i ∈ K ^ i :=
    (mem_reesAlgebra_iff _ _).mp (g : reesAlgebra K).2
  obtain ⟨x, hx, hxg⟩ := exists_baseChange_coe_eq_monomial J K hK n (hg n)
  exact ⟨x, hx, Subtype.ext (hxg.trans (coe_eq_monomial _ g.2).symm)⟩

/-- **The comparison homomorphism as a homomorphism of graded rings.** -/
def reesBaseChangeGradedHom :
    (fun n ↦ (reesGrading J n).baseChange B) →+*ᵍ reesGrading K where
  __ := (reesBaseChange J K hK).toRingHom
  map_mem hx := reesBaseChange_mem_reesGrading J K hK hx

/-- The graded comparison homomorphism is the comparison homomorphism. -/
@[simp]
theorem reesBaseChangeGradedHom_apply (x : B ⊗[A] reesAlgebra J) :
    reesBaseChangeGradedHom J K hK x = reesBaseChange J K hK x :=
  rfl

/-- **The first irrelevant-ideal condition.** The irrelevant ideal of `B[Kt]` is contained in the
ideal generated by the image of the irrelevant ideal of the base change. -/
theorem irrelevant_le_reesBaseChangeGradedHom :
    irrelevant (reesGrading K) ≤
      (irrelevant fun n ↦ (reesGrading J n).baseChange B).map
        (reesBaseChangeGradedHom J K hK) := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi y hy
  obtain ⟨x, hx, hxy⟩ := exists_baseChange_eq_of_mem_reesGrading J K hK i ⟨y, hy⟩
  have hxy' : reesBaseChangeGradedHom J K hK x = y := hxy
  rw [← hxy']
  exact Ideal.mem_map_of_mem _ (mem_irrelevant_of_mem _ hi hx)

variable [Module.Flat A B]

/-- The comparison homomorphism as a ring isomorphism, for `B` flat over `A`. -/
def reesBaseChangeEquiv : (B ⊗[A] reesAlgebra J) ≃+* reesAlgebra K :=
  RingEquiv.ofBijective (reesBaseChange J K hK).toRingHom
    ⟨reesBaseChange_injective J K hK, reesBaseChange_surjective J K hK⟩

/-- **The inverse of the comparison homomorphism, as a homomorphism of graded rings.** -/
def reesBaseChangeGradedHomSymm :
    reesGrading K →+*ᵍ fun n ↦ (reesGrading J n).baseChange B where
  __ := (reesBaseChangeEquiv J K hK).symm.toRingHom
  map_mem {n} {y} hy := by
    obtain ⟨x, hx, hxy⟩ := exists_baseChange_eq_of_mem_reesGrading J K hK n ⟨y, hy⟩
    have hxy' : reesBaseChange J K hK x = y := hxy
    have hsymm : (reesBaseChangeEquiv J K hK).symm y = x := by
      rw [← hxy']
      exact (reesBaseChangeEquiv J K hK).symm_apply_apply x
    rwa [show (reesBaseChangeEquiv J K hK).symm.toRingHom y =
      (reesBaseChangeEquiv J K hK).symm y from rfl, hsymm]

/-- The inverse comparison is a left inverse of the comparison. -/
theorem reesBaseChangeGradedHomSymm_comp :
    (reesBaseChangeGradedHomSymm J K hK).comp (reesBaseChangeGradedHom J K hK) =
      GradedRingHom.id (fun n ↦ (reesGrading J n).baseChange B) :=
  GradedRingHom.ext fun x ↦ (reesBaseChangeEquiv J K hK).symm_apply_apply x

/-- The inverse comparison is a right inverse of the comparison. -/
theorem reesBaseChangeGradedHom_comp :
    (reesBaseChangeGradedHom J K hK).comp (reesBaseChangeGradedHomSymm J K hK) =
      GradedRingHom.id (reesGrading K) :=
  GradedRingHom.ext fun y ↦ (reesBaseChangeEquiv J K hK).apply_symm_apply y

/-- **The second irrelevant-ideal condition.** The irrelevant ideal of the base change is
contained in the ideal generated by the image of the irrelevant ideal of `B[Kt]` under the inverse
comparison. -/
theorem irrelevant_le_reesBaseChangeGradedHomSymm :
    (irrelevant fun n ↦ (reesGrading J n).baseChange B) ≤
      (irrelevant (reesGrading K)).map (reesBaseChangeGradedHomSymm J K hK) := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi x hx
  have hxx : reesBaseChangeGradedHomSymm J K hK (reesBaseChange J K hK x) = x :=
    (reesBaseChangeEquiv J K hK).symm_apply_apply x
  rw [← hxx]
  exact Ideal.mem_map_of_mem _
    (mem_irrelevant_of_mem _ hi (reesBaseChange_mem_reesGrading J K hK hx))

end BaseChange

end Stacks.Blowup

end
