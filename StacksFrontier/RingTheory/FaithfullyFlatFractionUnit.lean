module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.Localization.FractionRing
public import StacksFrontier.RingTheory.IntegrallyClosed.FaithfullyFlatDescent
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A total fraction which becomes a unit downstairs is a unit upstairs

Let `A → D` be a faithfully flat ring map, let `K` and `K'` be the total rings of fractions of
`A` and of `D`, and let `f : K → K'` be a ring map over `A → D`. If an element `c` of `K`
becomes, in `K'`, the image of a *unit* of `D`, then `c` is already the image of a unit of `A`.

Faithful flatness enters twice. Once to descend the divisibility that clears the denominator —
a presentation `c = x / b` has `x = b · a` in `A` because it does in `D`, which is
`Stacks.IntegrallyClosed.FlatDescent.algebraMap_dvd_algebraMap_iff` — and once on the principal
ideal generated by the resulting `a`, to descend `a` being a unit from `D` to `A`, which is
`Ideal.comap_map_eq_self_of_faithfullyFlat` directly. Flatness alone is what makes the image of
a nonzerodivisor a nonzerodivisor (`Module.Flat.isSMulRegular_of_nonZeroDivisors`), which is
what lets `b` be cancelled in `D`.

## Main results

* `mem_nonZeroDivisors_algebraMap_of_flat`: a flat algebra carries nonzerodivisors to
  nonzerodivisors.
* `exists_isUnit_eq_algebraMap_of_isUnit_of_faithfullyFlat`: the statement above.
* `exists_isUnit_eq_algebraMap_of_isUnit_of_flat_of_isLocalHom`: the form the geometry
  produces, where the unit is found not over `D` itself but over an intermediate ring `O` with
  `A → O → D`, and `D` is only assumed flat and local over the local ring `A` — faithful
  flatness is then automatic. The comparison map is `ρ : K → K_O` between the total rings of
  fractions of `A` and of `O`, which is what a restriction of meromorphic functions to a chart
  is; the lift to the total ring of fractions of `D` is constructed here and the two possible
  lifts of `ρ` are identified by uniqueness of the localization lift, so no surjectivity of
  `Spec D → Spec A` is needed.

## Implementation notes

The total ring of fractions is Mathlib's `IsFractionRing`, which is `IsLocalization` at the
nonzerodivisors and carries no domain hypothesis — neither `A` nor `D` is assumed to be a
domain, which matters for the intended use, where `A` is the local ring of an étale chart of an
integral algebraic space and so is reduced but need not be irreducible.

The map `f` is an arbitrary ring map over `A → D` rather than the localization lift: the only
property used is the compatibility `hf`, so assuming it rather than constructing it keeps the
statement applicable to whichever comparison map is at hand.
-/

@[expose] public section

open scoped nonZeroDivisors

/-- **A flat algebra carries nonzerodivisors to nonzerodivisors**: multiplication by a
nonzerodivisor of the base is injective on a flat module, which on the algebra itself is
multiplication by the image. -/
@[ega "0 6.3.4" "M = D", sga "1 IV 1.3" "special case"]
theorem mem_nonZeroDivisors_algebraMap_of_flat {A D : Type*} [CommRing A] [CommRing D]
    [Algebra A D] [Module.Flat A D] {b : A} (hb : b ∈ A⁰) : algebraMap A D b ∈ D⁰ := by
  rw [mem_nonZeroDivisors_iff_left]
  intro y hy
  refine Module.Flat.isSMulRegular_of_nonZeroDivisors (M := D) hb (a₁ := y) (a₂ := 0) ?_
  change b • y = b • (0 : D)
  rw [smul_zero, Algebra.smul_def]
  exact hy

/-- **A total fraction which becomes a unit after a faithfully flat base change was already the
image of a unit.** If `c : K` in the total ring of fractions of `A` has, in the total ring of
fractions of a faithfully flat `A`-algebra `D`, the form `algebraMap D K' d` with `d` a unit of
`D`, then `c = algebraMap A K a` for a unit `a` of `A`. -/
theorem exists_isUnit_eq_algebraMap_of_isUnit_of_faithfullyFlat
    {A D K K' : Type*} [CommRing A] [CommRing D] [CommRing K] [CommRing K']
    [Algebra A D] [Module.FaithfullyFlat A D]
    [Algebra A K] [IsFractionRing A K] [Algebra D K'] [IsFractionRing D K']
    (f : K →+* K')
    (hf : ∀ a : A, f (algebraMap A K a) = algebraMap D K' (algebraMap A D a))
    {c : K} {d : D} (hd : IsUnit d) (hc : f c = algebraMap D K' d) :
    ∃ a : A, IsUnit a ∧ c = algebraMap A K a := by
  obtain ⟨⟨x, b⟩, hxb⟩ := IsLocalization.surj (M := A⁰) (S := K) c
  -- The image of the nonzerodivisor `b` is a nonzerodivisor of `D`, by flatness.
  have hbD : algebraMap A D (b : A) ∈ D⁰ := mem_nonZeroDivisors_algebraMap_of_flat b.2
  -- Reading the presentation `c · b = x` of `c` in `K'` gives `d · b = x` in `D`.
  have key : algebraMap A D (b : A) * d = algebraMap A D x := by
    refine IsFractionRing.injective D K' ?_
    have h := congrArg f hxb
    rw [map_mul, hc, hf, hf] at h
    rw [map_mul]
    exact (mul_comm (algebraMap D K' d) _ ▸ h)
  -- So `b ∣ x` in `D`, hence in `A`: faithful flatness contracts `bD` back to `bA`.
  obtain ⟨a, ha⟩ : (b : A) ∣ x :=
    (Stacks.IntegrallyClosed.FlatDescent.algebraMap_dvd_algebraMap_iff A D).mp ⟨d, key.symm⟩
  -- The image of `a` in `D` is `d`, by cancelling the nonzerodivisor `b`.
  have himg : algebraMap A D a = d := by
    refine ((mul_cancel_left_mem_nonZeroDivisors hbD).mp ?_).symm
    rw [key, ha, map_mul]
  refine ⟨a, ?_, ?_⟩
  · -- `a` is a unit of `A`, again by contracting the ideal it generates.
    refine Ideal.span_singleton_eq_top.mp ?_
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := D) (Ideal.span {a}), Ideal.map_span,
      Set.image_singleton, himg, Ideal.span_singleton_eq_top.mpr hd, Ideal.comap_top]
  · -- Cancelling the unit `algebraMap A K b` in `K` turns `c · b = x = b · a` into `c = a`.
    have hbK : IsUnit (algebraMap A K (b : A)) := IsLocalization.map_units K b
    refine (IsUnit.mul_left_cancel hbK ?_)
    rw [mul_comm (algebraMap A K (b : A)) c, hxb, ha, map_mul]

/-- A flat algebra `D` over `R` receives a ring map from the total ring of fractions of `R` into
the total ring of fractions of `D`, compatible with `R → D`. -/
private theorem exists_ringHom_fractionRing_of_flat {K : Type*} (R D : Type*) [CommRing R]
    [CommRing D] [CommRing K] [Algebra R D] [Module.Flat R D] [Algebra R K] [IsFractionRing R K] :
    ∃ f : K →+* FractionRing D, ∀ a : R,
      f (algebraMap R K a) = algebraMap D (FractionRing D) (algebraMap R D a) := by
  have hu : ∀ y : R⁰,
      IsUnit (((algebraMap D (FractionRing D)).comp (algebraMap R D)) (y : R)) := fun y ↦
    IsLocalization.map_units (M := D⁰) (FractionRing D)
      ⟨algebraMap R D (y : R), mem_nonZeroDivisors_algebraMap_of_flat y.2⟩
  exact ⟨IsLocalization.lift (M := R⁰) hu, fun a ↦ IsLocalization.lift_eq (M := R⁰) hu a⟩

/-- **A total fraction which becomes a unit over an intermediate ring of a flat local algebra
was already the image of a unit.** Let `A → O → D` be ring maps with `A` and `D` local, `D` flat
and local over `A` and flat over `O`, let `K` and `K_O` be the total rings of fractions of `A`
and of `O` and let `ρ : K → K_O` be a ring map over `A → O`. If `ρ c` is the image of a unit of
`O`, then `c` is the image of a unit of `A`.

This is the form the geometry produces: `A` is the ring of regular functions on the spectrum of
a local ring, `O` the ring of regular functions on an affine étale chart of it, `D` the local
ring of that chart at a point over the closed point, and `ρ` the restriction of meromorphic
functions to the chart. Faithful flatness of `A → D` is automatic from locality
(`Module.FaithfullyFlat.of_flat_of_isLocalHom`), which is why the *local ring* of the chart is
used rather than its ring of functions: an étale chart need not be faithfully flat, and its
local ring at a point over the closed point always is.

No surjectivity on spectra is needed anywhere. The comparison `K → Frac(D)` is built as the
localization lift over `A → D`, and it agrees with `ρ` followed by the lift of `K_O → Frac(D)`
over `O → D` because both are ring maps out of a localization of `A` agreeing on `A`. -/
theorem exists_isUnit_eq_algebraMap_of_isUnit_of_flat_of_isLocalHom
    {A O D K KO : Type*} [CommRing A] [CommRing O] [CommRing D] [CommRing K] [CommRing KO]
    [Algebra A O] [Algebra A D] [Algebra O D] [IsScalarTower A O D]
    [IsLocalRing A] [IsLocalRing D]
    [Algebra A K] [IsFractionRing A K] [Algebra O KO] [IsFractionRing O KO]
    (hAD : Module.Flat A D) (hlocal : IsLocalHom (algebraMap A D)) (hOD : Module.Flat O D)
    (ρ : K →+* KO) (hρ : ∀ a : A, ρ (algebraMap A K a) = algebraMap O KO (algebraMap A O a))
    {c : K} {v : O} (hv : IsUnit v) (hc : ρ c = algebraMap O KO v) :
    ∃ a : A, IsUnit a ∧ c = algebraMap A K a := by
  let := hAD
  let := hOD
  let := hlocal
  have : Module.FaithfullyFlat A D := Module.FaithfullyFlat.of_flat_of_isLocalHom
  -- The two localization lifts into the total ring of fractions of `D`.
  obtain ⟨f, hfA⟩ := exists_ringHom_fractionRing_of_flat (K := K) A D
  obtain ⟨g, hgO⟩ := exists_ringHom_fractionRing_of_flat (K := KO) O D
  -- They agree on `K`: both are ring maps out of a localization of `A` agreeing on `A`.
  have hcomp : g.comp ρ = f := by
    refine IsLocalization.ringHom_ext A⁰ (RingHom.ext fun a ↦ ?_)
    refine Eq.trans (congrArg g (hρ a)) ?_
    refine ((hgO (algebraMap A O a)).trans ?_).trans (hfA a).symm
    exact congrArg (algebraMap D (FractionRing D))
      (IsScalarTower.algebraMap_apply A O D a).symm
  refine exists_isUnit_eq_algebraMap_of_isUnit_of_faithfullyFlat f hfA
    (hv.map (algebraMap O D)) ?_
  have hfc : f c = g (ρ c) := (congrArg (fun h : K →+* FractionRing D ↦ h c) hcomp).symm
  exact hfc.trans ((congrArg g hc).trans (hgO v))

end
