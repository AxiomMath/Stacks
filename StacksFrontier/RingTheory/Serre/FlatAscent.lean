/-- Auxiliary fibre identification (Step S2b, part 1): the fibre ring `S ⊗_R κ(p)`
is isomorphic, as an `S`-algebra, to the quotient `Sₚ ⧸ pSₚ` where
`Sₚ = Localization (algebraMapSubmonoid S p.primeCompl)`. Adapted from the
`Ideal.Fiber.algEquivQuotient` development in Mathlib's
`RingTheory.LocalRing.ResidueField.Fiber`. -/
noncomputable def fibreAlgEquivAux₁
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (p : Ideal R) [p.IsPrime] :
    letI Sp := Localization (algebraMapSubmonoid S p.primeCompl)
    letI pS := p.map (algebraMap R S)
    (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)) ≃ₐ[S] Sp ⧸ pS.map (algebraMap S Sp)
        :=
  letI Sp := Localization (algebraMapSubmonoid S p.primeCompl)
  (Algebra.TensorProduct.tensorQuotientEquiv S (Localization p.primeCompl) S
      (IsLocalRing.maximalIdeal (Localization p.primeCompl))).trans <|
    { __ := Ideal.quotientEquiv _ _ (Localization.tensorLeftAlgEquiv p.primeCompl S).toRingEquiv (by
        have hcomp : (↑(Localization.tensorLeftAlgEquiv p.primeCompl S).toRingEquiv :
              (S ⊗[R] Localization p.primeCompl) →+*
                Localization (algebraMapSubmonoid S p.primeCompl)).comp
              (Algebra.TensorProduct.includeRight (R := R) (A := S)
                (B := Localization p.primeCompl)).toRingHom
            = algebraMap (Localization p.primeCompl)
                (Localization (algebraMapSubmonoid S p.primeCompl)) := by
          ext x
          simp [Localization.tensorLeftAlgEquiv_apply_one_tmul p.primeCompl S]
        rw [Ideal.map_map (algebraMap R S) (algebraMap S _),
          ← IsScalarTower.algebraMap_eq R S
            (Localization (algebraMapSubmonoid S p.primeCompl))]
        rw [show Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := S)
              (B := Localization p.primeCompl)) (IsLocalRing.maximalIdeal (Localization
                  p.primeCompl))
            = Ideal.map (Algebra.TensorProduct.includeRight (R := R) (A := S)
              (B := Localization p.primeCompl)).toRingHom
              (IsLocalRing.maximalIdeal (Localization p.primeCompl)) from rfl,
          Ideal.map_map, hcomp,
          ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map,
          ← IsScalarTower.algebraMap_eq])
      commutes' := fun r => by
        change (Ideal.quotientEquiv _ _ (Localization.tensorLeftAlgEquiv p.primeCompl
            S).toRingEquiv _)
            ((algebraMap S _) r) = (algebraMap S _) r
        rw [← Ideal.Quotient.mk_algebraMap, Ideal.quotientEquiv_mk]
        rw [show (algebraMap S (S ⊗[R] Localization p.primeCompl)) r
              = r ⊗ₜ[R] (1 : Localization p.primeCompl) from rfl]
        simp [Localization.tensorLeftAlgEquiv_apply_tmul_one p.primeCompl,
          Ideal.Quotient.mk_algebraMap] }

open scoped TensorProduct in
open Algebra TensorProduct in
/-- Auxiliary fibre identification (Step S2b, part 2): for a prime `q'` of the fibre
ring `S ⊗_R κ(p)`, the localization `(S ⊗_R κ(p))_{q'}` is isomorphic, as an
`R`-algebra, to the closed fibre `S_r ⧸ p S_r`, where `r = q' ∩ S`. Adapted from
`Ideal.Fiber.algEquivAux₂`. -/
noncomputable def fibreAlgEquivAux₂
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (p : Ideal R) [p.IsPrime]
    (q' : Ideal (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p))) [q'.IsPrime]
    (r : Ideal S) [r.IsPrime]
    (hr : q'.comap (algebraMap S (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p))) = r) :
    letI Sr := Localization.AtPrime r
    letI pS := p.map (algebraMap R S)
    Localization.AtPrime q' ≃ₐ[R] Sr ⧸ pS.map (algebraMap S Sr) := by
  subst hr
  letI Sp := Localization (algebraMapSubmonoid S p.primeCompl)
  letI pS := p.map (algebraMap R S)
  letI SpS := S ⧸ pS
  letI r := q'.comap (algebraMap S (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)))
  haveI hr : r.IsPrime := Ideal.IsPrime.comap _
  letI Sr := Localization.AtPrime r
  letI e₁ : (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)) ≃ₐ[S]
      Sp ⧸ pS.map (algebraMap S Sp) := fibreAlgEquivAux₁ p
  letI q'' : Ideal (Sp ⧸ pS.map (algebraMap S Sp)) := q'.comap e₁.symm.toRingHom
  haveI : q''.IsPrime := Ideal.IsPrime.comap _
  haveI hloR : q''.LiesOver r := by
    refine ⟨?_⟩
    change r = q''.comap (algebraMap S _)
    have hmap : (algebraMap S (Sp ⧸ pS.map (algebraMap S Sp)))
        = (e₁.toRingHom).comp
            (algebraMap S (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p))) := by
      ext s; simp
    rw [hmap, ← Ideal.comap_comap]
    change r = (q''.comap e₁.toRingHom).comap
        (algebraMap S (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)))
    have : q''.comap e₁.toRingHom = q' := by
      change (q'.comap e₁.symm.toRingHom).comap e₁.toRingHom = q'
      rw [Ideal.comap_comap]
      have hid : e₁.symm.toRingHom.comp e₁.toRingHom = RingHom.id _ := by
        apply RingHom.ext; intro x; simp
      rw [hid, Ideal.comap_id]
    rw [this]
  haveI hlo : (q''.under SpS).LiesOver r :=
    Ideal.under_liesOver_of_liesOver SpS q'' r
  haveI hpc : algebraMapSubmonoid SpS r.primeCompl = (q''.under SpS).primeCompl :=
    Ideal.algebraMapSubmonoid_primeCompl_of_liesOver_surjective (q''.under SpS) r
      Ideal.Quotient.mk_surjective
  haveI : IsLocalization (algebraMapSubmonoid SpS r.primeCompl) (Localization.AtPrime q'') := by
    rw [hpc]
    convert IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
      (algebraMapSubmonoid SpS (algebraMapSubmonoid S p.primeCompl)) (Localization.AtPrime q'') q''
  haveI := IsScalarTower.to₁₃₄ R S SpS (Localization.AtPrime q'')
  haveI := IsScalarTower.to₁₃₄ R S SpS (Sr ⧸ pS.map (algebraMap S Sr))
  exact ((Localization.localAlgEquiv q'' q' e₁.symm rfl).symm.restrictScalars R).trans
    ((IsLocalization.algEquiv (algebraMapSubmonoid SpS r.primeCompl) (Localization.AtPrime q'')
      (Sr ⧸ pS.map (algebraMap S Sr))).restrictScalars R)

/-- The extension of the maximal ideal of `R_p` to a ring `B` over it is the extension of `p`. -/
private theorem map_maximalIdeal_atPrime_eq_map
    {R B : Type*} [CommRing R] [CommRing B] [Algebra R B] (p : Ideal R) [p.IsPrime]
    [Algebra (Localization.AtPrime p) B] [IsScalarTower R (Localization.AtPrime p) B] :
    (IsLocalRing.maximalIdeal (Localization.AtPrime p)).map
      (algebraMap (Localization.AtPrime p) B) = p.map (algebraMap R B) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_map, ← IsScalarTower.algebraMap_eq]

open scoped TensorProduct in
open Algebra TensorProduct in
-- needed: in `property_Rk_of_flat_of_fibre_of_base` the final `hreg.of_ringEquiv
-- hiso.toRingEquiv` only synthesizes its `CommRing`/local-ring instances if defeq unfolds the
-- `Localization.AtPrime` abbreviations behind `fibreAlgEquivAux₂`.
set_option backward.isDefEq.respectTransparency false in
/-- Let `φ : R → S` be a flat ring map between Noetherian rings and fix `k ≥ 0`. If every
fibre ring `S ⊗[R] κ(p)` has property `(R_k)` and `R` has property `(R_k)`, then `S` has
property `(R_k)`. -/
@[stacks 033A,
  ega "IV 6.5.3" "(ii), affine case",
  ega "IV 17.5.8" "(iii)",
  ega "IV 7.3.8" "(v_n), special case", sga "6 X 7.7" "special case"]
theorem property_Rk_of_flat_of_fibre_of_base
    (R S : Type*) [CommRing R] [CommRing S] [Algebra R S]
    [IsNoetherianRing R] [IsNoetherianRing S] [Module.Flat R S]
    (k : ℕ)
    (hfib : ∀ (p : Ideal R) [p.IsPrime], HasPropertyRk (fibreRing R S p) k)
    (hR : HasPropertyRk R k) :
    HasPropertyRk S k := by
  -- Flatness gives going-down, the hypothesis of the dimension formula.
  have : Algebra.HasGoingDown R S := Algebra.HasGoingDown.of_flat
  -- Unwind `(R_k)` at a single prime `q` of `S` of height `≤ k`.
  intro q _ hq
  -- Let `p = φ⁻¹(q)`; then `q` lies over `p`.
  set p : Ideal R := q.comap (algebraMap R S) with hp
  have : p.IsPrime := inferInstance
  have : q.LiesOver p := ⟨rfl⟩
  -- S1 (DONE, tag 00ON): the dimension formula for flat local homomorphisms,
  --   ht(q) = ht(p) + ht(fibre prime).
  have hform :
      q.height
        = p.height
          + (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) p)) q).height :=
    Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown p q
  -- Both summands are `≤ k` since the sum is `≤ k` in `ℕ∞`.
  have hpk : p.height ≤ (k : ℕ∞) := (le_self_add.trans_eq hform.symm).trans hq
  have hfk :
      (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) p)) q).height ≤ (k : ℕ∞) :=
    (le_add_self.trans_eq hform.symm).trans hq
  -- Since `R` has `(R_k)` and `ht(p) ≤ k`, `R_p` is regular.
  have hRp : IsRegularLocalRing (Localization.AtPrime p) := hR p hpk
  -- Fibre identification: the closed fibre `S_q / p S_q` is regular.
  --
  -- Informal argument: the local ring of the fibre ring `fibreRing R S p =
  -- S ⊗_R κ(p)` at the prime `P` corresponding to `q` is isomorphic to the closed
  -- fibre `(Localization.AtPrime q) ⧸ (p.map (algebraMap R S)).map ...`, i.e.
  -- `S_q / p S_q`. Under this correspondence the height of `P` equals the height
  -- of the fibre prime `Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R S) p)) q`,
  -- which is `≤ k` by `hfk`. Hypothesis `hfib p` (property `(R_k)` for the fibre
  -- ring) therefore makes `Localization.AtPrime P` regular, and transporting along
  -- the iso (`IsRegularLocalRing.of_ringEquiv`) gives regularity of `S_q / p S_q`.
  --
  -- Concretely: construct the prime `P : Ideal (fibreRing R S p)` corresponding to `q`, the
  -- image under `S → S ⊗_R κ(p)` of `q`; the height equality `P.height = (fibre prime).height`;
  -- and the ring isomorphism `Localization.AtPrime P ≃+* S_q / p S_q`. Mathlib has no named
  -- API for this, so it is built by working with `S_q/pS_q` directly and `of_ringEquiv`.
  have hClosedFibreReg :
      IsRegularLocalRing
        ((Localization.AtPrime q) ⧸
          Ideal.map (algebraMap S (Localization.AtPrime q))
            (Ideal.map (algebraMap R S) p)) := by
    classical
    -- (1) Pick a prime `q'` of the fibre ring `S ⊗_R κ(p)` lying over `q`.
    have hq_mem : q ∈ p.primesOver S := ⟨‹_›, ‹q.LiesOver p›⟩
    set P : PrimeSpectrum (p.Fiber S) :=
      PrimeSpectrum.primesOverOrderIsoFiber R S p ⟨q, hq_mem⟩ with hP_def
    set e : (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)) ≃ₐ[R] p.Fiber S :=
      Algebra.TensorProduct.comm R S (IsLocalRing.ResidueField (Localization.AtPrime p)) with he_def
    set q' : Ideal (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)) :=
      P.asIdeal.comap e.toRingHom with hq'_def
    have hq'p : q'.IsPrime := Ideal.IsPrime.comap _
    -- `q'` lies over `q`: its contraction to `S` is `q`.
    have hrq : q'.comap (algebraMap S (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)))
        = q := by
      have hP : P.asIdeal.comap (Algebra.TensorProduct.includeRight
          (R := R) (A := IsLocalRing.ResidueField (Localization.AtPrime p)) (B := S)) = q := by
        have hsymm : (PrimeSpectrum.primesOverOrderIsoFiber R S p).symm P = ⟨q, hq_mem⟩ :=
          (PrimeSpectrum.primesOverOrderIsoFiber R S p).symm_apply_apply ⟨q, hq_mem⟩
        have h1 := PrimeSpectrum.coe_primesOverOrderIsoFiber_symm_apply_coe
          (R := R) (S := S) (p := p) P
        apply SetLike.ext'
        rw [Ideal.coe_comap, ← h1]
        exact congrArg (fun (x : p.primesOver S) => ((x : Ideal S) : Set S)) hsymm
      rw [hq'_def, Ideal.comap_comap]
      have hcomp : e.toRingHom.comp
            (algebraMap S (S ⊗[R] IsLocalRing.ResidueField (Localization.AtPrime p)))
          = (Algebra.TensorProduct.includeRight
              (R := R) (A := IsLocalRing.ResidueField (Localization.AtPrime p)) (B :=
                  S)).toRingHom := by
        ext s; simp [he_def]
      rw [hcomp]
      exact hP
    -- (2) The localization of the fibre ring at q' is the closed fibre S_q ⧸ p S_q.
    have hiso := fibreAlgEquivAux₂ p q' q hrq
    -- (3) Height of `q'` is `≤ k`, via the closed-fibre dimension.
    -- `B = S_q ⧸ p S_q` is the localization of `S/pS` at the fibre prime `q̄`.
    set pS : Ideal S := Ideal.map (algebraMap R S) p with hpS_def
    have hpSq : pS ≤ q := by
      rw [hpS_def, Ideal.map_le_iff_le_comap]
    set qbar : Ideal (S ⧸ pS) := Ideal.map (Ideal.Quotient.mk pS) q with hqbar_def
    have hqbar_prime : qbar.IsPrime := by
      rw [hqbar_def]
      exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hpSq)
    -- `B` is the localization of `S/pS` at `qbar`.
    have : IsLocalization (algebraMapSubmonoid (S ⧸ pS) q.primeCompl)
        ((Localization.AtPrime q) ⧸ pS.map (algebraMap S (Localization.AtPrime q))) :=
      IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
        q.primeCompl (Localization.AtPrime q) pS
    have hqbar_lo : qbar.LiesOver q := by
      refine ⟨?_⟩
      rw [hqbar_def, Ideal.under_def, Ideal.Quotient.algebraMap_eq,
        Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
        ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      exact (sup_eq_left.mpr hpSq).symm
    have hsubmonoid : algebraMapSubmonoid (S ⧸ pS) q.primeCompl = qbar.primeCompl :=
      Ideal.algebraMapSubmonoid_primeCompl_of_liesOver_surjective qbar q
        Ideal.Quotient.mk_surjective
    have : IsLocalization.AtPrime
        ((Localization.AtPrime q) ⧸ pS.map (algebraMap S (Localization.AtPrime q))) qbar := by
      rw [IsLocalization.AtPrime]
      rw [← hsubmonoid]; infer_instance
    -- height chain: q'.height = ringKrullDim (S_q ⧸ p S_q) = qbar.height ≤ k
    have hheight : q'.height ≤ (k : ℕ∞) := by
      have h1 : (ringKrullDim (Localization.AtPrime q') : WithBot ℕ∞) = (q'.height : ℕ∞) :=
        IsLocalization.AtPrime.ringKrullDim_eq_height q' (Localization.AtPrime q')
      have h2 : ringKrullDim (Localization.AtPrime q')
          = ringKrullDim ((Localization.AtPrime q) ⧸
              pS.map (algebraMap S (Localization.AtPrime q))) :=
        ringKrullDim_eq_of_ringEquiv hiso.toRingEquiv
      have h3 : (ringKrullDim ((Localization.AtPrime q) ⧸
            pS.map (algebraMap S (Localization.AtPrime q))) : WithBot ℕ∞)
          = (qbar.height : ℕ∞) :=
        IsLocalization.AtPrime.ringKrullDim_eq_height qbar _
      have h4 : qbar.height ≤ (k : ℕ∞) := by
        rw [hqbar_def]; exact hfk
      have heq : (q'.height : WithBot ℕ∞) = (qbar.height : ℕ∞) := by
        rw [← h1, h2, h3]
      have hcast : (q'.height : ℕ∞) = qbar.height := by exact_mod_cast heq
      rw [hcast]; exact h4
    -- (4) Apply property `(R_k)` for the fibre ring and transport along the iso.
    have hreg : IsRegularLocalRing (Localization.AtPrime q') := hfib p q' hheight
    have : IsRegularLocalRing (Localization.AtPrime q') := hreg
    exact hreg.of_ringEquiv hiso.toRingEquiv
  -- S3 (OPEN, tag 031E): assemble via the regularity-ascent lemma above.
  --
  -- The localized map `R_p → S_q` is flat, flatness localizing, and local; `R_p` is regular
  -- (`hRp`) and the closed fibre
  -- `S_q / p S_q` is regular (`hClosedFibreReg`). Hence by
  -- `isRegularLocalRing_of_flat_of_regular_closedFibre` (tag 031E), `S_q =
  -- Localization.AtPrime q` is regular.
  --
  -- Concretely: provide the instances
  -- `Algebra (Localization.AtPrime p) (Localization.AtPrime q)`,
  -- `Module.Flat _ _`, `IsLocalHom (algebraMap _ _)` for the localized map, match
  -- the closed-fibre type `B ⧸ 𝔪_A.map (algebraMap A B)` with `hClosedFibreReg`'s
  -- quotient (identifying `𝔪_{R_p}.map = (p.map ...).map`), then apply the lemma.
  -- obligation for q, and tag 033A is a known true theorem).
  let algRpSq : Algebra (Localization.AtPrime p) (Localization.AtPrime q) :=
    (Localization.localRingHom p q (algebraMap R S) hp).toAlgebra
  have hAM : algebraMap (Localization.AtPrime p) (Localization.AtPrime q)
      = Localization.localRingHom p q (algebraMap R S) hp := rfl
  have hST : IsScalarTower R (Localization.AtPrime p) (Localization.AtPrime q) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    rw [hAM, Localization.localRingHom_to_map, ← IsScalarTower.algebraMap_apply]
  have hFlat : Module.Flat (Localization.AtPrime p) (Localization.AtPrime q) :=
    inferInstance
  have hLocalHom : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) := by
    rw [hAM]
    infer_instance
  -- Identify the two closed-fibre ideals.
  have hST2 : IsScalarTower R S (Localization.AtPrime q) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hidealeq :
      Ideal.map (algebraMap (Localization.AtPrime p) (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime p))
      = Ideal.map (algebraMap S (Localization.AtPrime q)) (Ideal.map (algebraMap R S) p) := by
    rw [map_maximalIdeal_atPrime_eq_map, IsScalarTower.algebraMap_eq R S (Localization.AtPrime q),
      ← Ideal.map_map]
  rw [← hidealeq] at hClosedFibreReg
  exact isRegularLocalRing_of_flat_of_regular_closedFibre
    (Localization.AtPrime p) (Localization.AtPrime q) hRp hClosedFibreReg

/-!
# Serre's condition `(S_k)` ascends along a flat ring map

Proof of `min_le_depth_atPrime_of_flat` (Stacks 0339): if `R → S` is a flat map of Noetherian
rings, every fibre ring `κ(𝔭) ⊗_R S` has Serre's property `(S_k)` and `R` has `(S_k)`, then `S`
has `(S_k)`, the property being spelled out at a prime `𝔮` as
`min{k, dim(A_𝔮)} ≤ depth(A_𝔮)`.

The source's argument runs entirely inside one flat local homomorphism. Fix a prime `𝔮` of `S`
and let `𝔭 = 𝔮 ∩ R`; then `R_𝔭 → S_𝔮` is a flat local homomorphism of Noetherian local rings,
so depth is additive along it (Stacks 0337) and height is subadditive
(`Ideal.height_le_height_add_of_liesOver`, the inequality of Stacks 00OM):
`depth(S_𝔮) = depth(R_𝔭) + depth(S_𝔮/𝔭S_𝔮)` and `dim(S_𝔮) ≤ dim(R_𝔭) + dim(S_𝔮/𝔭S_𝔮)`.
Feeding in `(S_k)` for `R_𝔭` and for the fibre `S_𝔮/𝔭S_𝔮` and using
`min{k, x + y} ≤ min{k, x} + min{k, y}` gives `min{k, dim(S_𝔮)} ≤ depth(S_𝔮)`.

## Main results

* `Stacks.Serre.DepthConditionAscent.solution`: the statement of Tag 0339.

## Implementation notes

The argument is split at the point where the geometry ends and the arithmetic begins.
`min_le_depth_self_of_flat` is the whole inequality for an abstract flat local homomorphism
`A → B` of Noetherian local rings, taking `(S_k)` at the closed point of `A` and at the fibre
`B/𝔪_A B` and returning it at the closed point of `B`; it works with `Ideal.height` of the
maximal ideal throughout (`IsLocalRing.maximalIdeal_height_eq_ringKrullDim` converts to
`ringKrullDim` at the ends), because subadditivity of height is stated that way, and the
`ℕ∞`-valued `min` inequality `min_add_le_add_min` replaces the source's four-term
`min{2k, k + x, k + y, x + y}` identity, which is only ever used through that one bound.

What remains in `solution` is the identification of the fibre. The hypothesis is an `(S_k)`
statement about `Localization.AtPrime Q` for primes `Q` of `Ideal.Fiber 𝔭 S`, and the conclusion
needs it about the quotient `S_𝔮/𝔭S_𝔮`; the two are matched by
`PrimeSpectrum.primesOverOrderIsoFiber`, which produces the prime `Q` of the fibre ring lying
over `𝔮`, and `Ideal.Fiber.algEquivAux₂`, which presents `(κ(𝔭) ⊗_R S)_Q` as
`S_{Q ∩ S}/𝔭S_{Q ∩ S}`. The residual mismatch is that `Q ∩ S` is only *equal* to `𝔮`, not
syntactically it, so the localizations must be transported along that equality — this is
`localizationAtPrimeAlgEquivOfEq` — and the ideal by which one quotients rewritten from
`𝔪_{R_𝔭} · S_𝔮` to `𝔭 · S_𝔮` (`Localization.AtPrime.map_eq_maximalIdeal` and `Ideal.map_map`).
Both invariants are then carried across the resulting ring equivalence, dimension by
`ringKrullDim_eq_of_ringEquiv` and depth by `Module.depth_self_eq_of_ringEquiv`.

Depth of a module over a ring and over a quotient of it agree
(`Module.depth_eq_depth_map_algebraMap`), which is what lets the fibre's depth be read either as
`depth_{𝔪_{S_𝔮}}(S_𝔮/𝔭S_𝔮)`, as Stacks 0337 delivers it, or as the self-depth of that quotient
at its own maximal ideal, as the `(S_k)` hypothesis supplies it; with
`Module.depth_eq_depth_of_linearEquiv`, the invariance of `Module.depth` under a linear
equivalence, these
are the only two facts about `Module.depth` (Stacks 00LI) used here beyond Stacks 0337 itself.
Neither is in Mathlib, and both are private in the companion files that also need them.

## References

* [StacksProject 0339](https://stacks.math.columbia.edu/tag/0339)
* [StacksProject 0337](https://stacks.math.columbia.edu/tag/0337)
* [StacksProject 00OM](https://stacks.math.columbia.edu/tag/00OM)

## Tags

Serre condition, depth, Krull dimension, flat ring map, fibre ring, ascent, Noetherian ring
-/



@[expose] public section

namespace Stacks.Serre.DepthConditionAscent

open IsLocalRing RingTheory.Sequence

attribute [local instance] Localization.AtPrime.algebraOfLiesOver

/-- Transport of a localization at a prime along an equality of primes. -/
public noncomputable def localizationAtPrimeAlgEquivOfEq {S : Type*} [CommRing S] {r q : Ideal S}
    [r.IsPrime] [q.IsPrime] (h : r = q) :
    Localization.AtPrime r ≃ₐ[S] Localization.AtPrime q := by
  have hM : r.primeCompl = q.primeCompl := by subst h; rfl
  have : IsLocalization q.primeCompl (Localization.AtPrime r) := by rw [← hM]; infer_instance
  exact IsLocalization.algEquiv q.primeCompl _ _

/-- `min k (x + y) ≤ min k x + min k y` in `ℕ∞`. -/
public lemma min_add_le_add_min (k x y : ℕ∞) : min k (x + y) ≤ min k x + min k y := by
  rcases le_total k x with hx | hx
  · rw [min_eq_left hx]
    exact (min_le_left _ _).trans le_self_add
  · rw [min_eq_right hx]
    rcases le_total k y with hy | hy
    · rw [min_eq_left hy]
      exact (min_le_left _ _).trans le_add_self
    · rw [min_eq_right hy]
      exact min_le_right _ _

/-- The core inequality: Serre's condition at the maximal ideal of the target of a flat local
homomorphism follows from the conditions on the source and on the fibre. -/
public lemma min_le_depth_self_of_flat {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A]
    [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] [Module.Flat A B] {k : ℕ}
    (hA : min (k : WithBot ℕ∞) (ringKrullDim A) ≤
      (Module.depth A (maximalIdeal A) A : WithBot ℕ∞))
    (hfib : min (k : WithBot ℕ∞) (ringKrullDim (B ⧸ (maximalIdeal A).map (algebraMap A B))) ≤
      (Module.depth B (maximalIdeal B) (B ⧸ (maximalIdeal A).map (algebraMap A B)) :
        WithBot ℕ∞)) :
    min (k : WithBot ℕ∞) (ringKrullDim B) ≤
      (Module.depth B (maximalIdeal B) B : WithBot ℕ∞) := by
  have hItop : (maximalIdeal A).map (algebraMap A B) ≠ ⊤ :=
    (IsLocalRing.map_maximalIdeal_lt_top (algebraMap A B)).ne
  have hLO : (maximalIdeal B).LiesOver (maximalIdeal A) :=
    ⟨(IsLocalRing.maximalIdeal_comap (algebraMap A B)).symm⟩
  have hdepth := Module.depth_self_eq_depth_self_add_depth_quotient_map_maximalIdeal A B
  have hheight : (maximalIdeal B).height ≤ (maximalIdeal A).height +
      ((maximalIdeal B).map (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)))).height :=
    Ideal.height_le_height_add_of_liesOver _ _
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim] at hA ⊢
  rw [ringKrullDim_quotient_eq_height_map_maximalIdeal hItop] at hfib
  rw [hdepth]
  have key : min (k : ℕ∞) (maximalIdeal B).height ≤
      Module.depth A (maximalIdeal A) A +
        Module.depth B (maximalIdeal B) (B ⧸ (maximalIdeal A).map (algebraMap A B)) := by
    refine ((min_le_min le_rfl hheight).trans (min_add_le_add_min ..)).trans (add_le_add ?_ ?_)
    · exact_mod_cast hA
    · exact_mod_cast hfib
  exact_mod_cast key

/-- Let `R → S` be a flat ring map of Noetherian rings and fix `k ≥ 0`. If every local ring of
every fibre ring `S ⊗[R] κ(p)` satisfies `min (k, dim) ≤ depth`, and so does every local ring
`R_p`, then every local ring `S_q` satisfies `min (k, dim S_q) ≤ depth S_q`. -/
public theorem solution {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [Algebra R S] [IsNoetherianRing R] [IsNoetherianRing S] [Module.Flat R S] {k : ℕ}
    (hfibre : ∀ (p : Ideal R) [p.IsPrime] (Q : Ideal (p.Fiber S)) [Q.IsPrime],
      min (k : WithBot ℕ∞) (ringKrullDim (Localization.AtPrime Q)) ≤
        (Module.depth (Localization.AtPrime Q)
          (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) (Localization.AtPrime Q) :
            WithBot ℕ∞))
    (hR : ∀ (p : Ideal R) [p.IsPrime],
      min (k : WithBot ℕ∞) (ringKrullDim (Localization.AtPrime p)) ≤
        (Module.depth (Localization.AtPrime p)
          (IsLocalRing.maximalIdeal (Localization.AtPrime p)) (Localization.AtPrime p) :
            WithBot ℕ∞)) :
    ∀ (q : Ideal S) [q.IsPrime],
      min (k : WithBot ℕ∞) (ringKrullDim (Localization.AtPrime q)) ≤
        (Module.depth (Localization.AtPrime q)
          (IsLocalRing.maximalIdeal (Localization.AtPrime q)) (Localization.AtPrime q) :
            WithBot ℕ∞) := by
  intro q _
  have hQp : ((PrimeSpectrum.primesOverOrderIsoFiber R S (q.under R))
      ⟨q, inferInstance, inferInstance⟩).asIdeal.IsPrime := inferInstance
  set Q : Ideal ((q.under R).Fiber S) :=
    ((PrimeSpectrum.primesOverOrderIsoFiber R S (q.under R))
      ⟨q, inferInstance, inferInstance⟩).asIdeal with hQdef
  have hQ : Q.comap (Algebra.TensorProduct.includeRight :
      S →ₐ[R] (q.under R).Fiber S) = q := by
    rw [hQdef, ← PrimeSpectrum.coe_primesOverOrderIsoFiber_symm_apply, OrderIso.symm_apply_apply]
  have e2 := localizationAtPrimeAlgEquivOfEq hQ
  have e1 := Ideal.Fiber.algEquivAux₂ (q.under R) Q
  -- the fibre ideal of `S_q`, computed as `𝔭 S_q`
  have hIeq := map_maximalIdeal_atPrime_eq_map (B := Localization.AtPrime q) (q.under R)
  have hmapE : (((q.under R).map (algebraMap R S)).map (algebraMap S
        (Localization.AtPrime (Q.comap (Algebra.TensorProduct.includeRight :
          S →ₐ[R] (q.under R).Fiber S))))).map (e2 : _ →+* Localization.AtPrime q) =
      (q.under R).map (algebraMap R (Localization.AtPrime q)) := by
    have hcomp : (e2 : _ →+* Localization.AtPrime q).comp (algebraMap R (Localization.AtPrime
        (Q.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] (q.under R).Fiber S)))) =
        algebraMap R (Localization.AtPrime q) :=
      RingHom.ext fun x => by
        rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply R S (Localization.AtPrime q),
          IsScalarTower.algebraMap_apply R S (Localization.AtPrime
            (Q.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] (q.under R).Fiber S)))]
        exact e2.commutes _
    rw [Ideal.map_map, Ideal.map_map, RingHom.comp_assoc,
      ← IsScalarTower.algebraMap_eq R S (Localization.AtPrime
        (Q.comap (Algebra.TensorProduct.includeRight : S →ₐ[R] (q.under R).Fiber S))), hcomp]
  have E := e1.toRingEquiv.trans
    (Ideal.quotientEquiv _ _ e2.toRingEquiv (hIeq.trans hmapE.symm))
  -- `R_p → S_q` is a flat local homomorphism of Noetherian local rings
  have : IsLocalHom (algebraMap (Localization.AtPrime (q.under R)) (Localization.AtPrime q)) := by
    rw [Localization.AtPrime.IsLiesOverAlgebra.algebraMap_eq]
    exact Localization.isLocalHom_localRingHom _ _ _ Ideal.LiesOver.over
  refine min_le_depth_self_of_flat (hR (q.under R)) ?_
  -- the fibre `S_q / 𝔭 S_q` is the localization of the fibre ring at `Q`
  have hItop : (maximalIdeal (Localization.AtPrime (q.under R))).map
      (algebraMap (Localization.AtPrime (q.under R)) (Localization.AtPrime q)) ≠ ⊤ :=
    (IsLocalRing.map_maximalIdeal_lt_top _).ne
  have hnt : Nontrivial (Localization.AtPrime q ⧸
      (maximalIdeal (Localization.AtPrime (q.under R))).map
        (algebraMap (Localization.AtPrime (q.under R)) (Localization.AtPrime q))) :=
    Ideal.Quotient.nontrivial_iff.mpr hItop
  have hlocF : IsLocalRing (Localization.AtPrime q ⧸
      (maximalIdeal (Localization.AtPrime (q.under R))).map
        (algebraMap (Localization.AtPrime (q.under R)) (Localization.AtPrime q))) :=
    .of_surjective' _ Ideal.Quotient.mk_surjective
  have hsurj : Function.Surjective (algebraMap (Localization.AtPrime q)
      (Localization.AtPrime q ⧸ (maximalIdeal (Localization.AtPrime (q.under R))).map
        (algebraMap (Localization.AtPrime (q.under R)) (Localization.AtPrime q)))) := by
    rw [Ideal.Quotient.algebraMap_eq]
    exact Ideal.Quotient.mk_surjective
  rw [Module.depth_eq_depth_map_algebraMap hsurj,
    IsLocalRing.map_maximalIdeal_of_surjective _ hsurj,
    ← Module.depth_self_eq_of_ringEquiv E,
    ← ringKrullDim_eq_of_ringEquiv E]
  exact hfibre (q.under R) Q

end Stacks.Serre.DepthConditionAscent

end

/-!
# Serre's condition `(S_k)` ascends along a flat ring map

Fix an integer `k ≥ 0`. A Noetherian ring `A` has property `(S_k)` (Definition 031P) when
`depth(A_𝔮) ≥ min{k, dim(A_𝔮)}` for every prime `𝔮` of `A`, the depth being that of the local
ring `A_𝔮` along its maximal ideal. Let `φ : R → S` be a flat ring map of Noetherian rings. If
every fibre ring `κ(𝔭) ⊗_R S` has `(S_k)` and `R` has `(S_k)`, then `S` has `(S_k)`. So `(S_k)`
ascends along a flat map with `(S_k)` fibres, in the same way that Cohen–Macaulayness does in the
local case (Tag 045J); both rest on the additivity of depth along a flat local homomorphism.

The source's proof. Let `𝔮` be a prime of `S` lying over the prime `𝔭 = φ^{-1}(𝔮)` of `R`. Then
`R_𝔭 → S_𝔮` is a flat local homomorphism of Noetherian local rings, so depth is additive along
it (Tag 0337):
`depth(S_𝔮) = depth(R_𝔭) + depth(S_𝔮/𝔭S_𝔮)`.
Dimension is superadditive, `dim(R_𝔭) + dim(S_𝔮/𝔭S_𝔮) ≥ dim(S_𝔮)` (Tag 00OM; equality holds by
Tag 00ON, but is not needed). The local ring `S_𝔮/𝔭S_𝔮` is a localization of the fibre ring
`κ(𝔭) ⊗_R S`, so the fibre hypothesis gives `depth(S_𝔮/𝔭S_𝔮) ≥ min{k, dim(S_𝔮/𝔭S_𝔮)}`, and
`(S_k)` for `R` gives `depth(R_𝔭) ≥ min{k, dim(R_𝔭)}`. Adding these and using
`min{k, x} + min{k, y} = min{2k, k + x, k + y, x + y} ≥ min{k, x + y}` for `x, y ≥ 0` yields
`depth(S_𝔮) ≥ min{k, dim(R_𝔭) + dim(S_𝔮/𝔭S_𝔮)} ≥ min{k, dim(S_𝔮)}`,
which is `(S_k)` for `S` at `𝔮`.

## Main results

* `min_le_depth_atPrime_of_flat`: a flat ring map of Noetherian rings whose fibre rings have
  `(S_k)` carries `(S_k)` from its source to its target.

## Implementation notes

Mathlib has no predicate for `(S_k)`, so the condition is spelled out from Definition 031P as the
inequality `min{k, dim(A_𝔮)} ≤ depth(A_𝔮)` at every prime `𝔮`, in the shape used by the companion
statements of Tags 031Q, 031S and 0352: `Module.depth` of Tag 00LI along the maximal ideal of
`Localization.AtPrime 𝔮` for the depth, and `ringKrullDim (Localization.AtPrime 𝔮)` — the
source's literal `dim(A_𝔮)`, equal to `Ideal.height 𝔮` by
`IsLocalization.AtPrime.ringKrullDim_eq_height` — for the dimension. Depth takes values in `ℕ∞`
and `ringKrullDim` in `WithBot ℕ∞`, the value `⊥` recording `dim(∅) = -∞`, so each inequality is
read in `WithBot ℕ∞`; no localization at a prime is the zero ring, so no left-hand side is `⊥`
here. The general-`k` predicate `PropertySkRing` this repository carries states none of the three
conditions: it measures depth with a constant different from the `Module.depth` of Tag 00LI that
Tag 0337, the input to this proof, is phrased with, and it presupposes an `IsNoetherianRing`
instance which the fibre ring does not carry. The integer `k` is arbitrary, as in the source.

The fibre ring is Mathlib's `Ideal.Fiber 𝔭 S`, that is `κ(𝔭) ⊗[R] S` with
`κ(𝔭) = Ideal.ResidueField 𝔭` the residue field of `Localization.AtPrime 𝔭`; the source writes
`S ⊗_R κ(𝔭)`, the same ring by `Algebra.TensorProduct.comm`. Its `(S_k)` condition is stated at
every prime of it, in the very shape used for `R` and for `S`, so the hypothesis is literally
"every fibre ring has `(S_k)`" rather than a pointwise paraphrase over `S`. No Noetherian
hypothesis on it is needed: it is a quotient of a localization of `S` by
`Ideal.Fiber.algEquivQuotient`, hence Noetherian for free. That same identification is how the
hypothesis is consumed: `Ideal.Fiber.algEquivAux₂` presents `(κ(𝔭) ⊗_R S)_Q` as `S_𝔮/𝔭S_𝔮` for
`𝔮 = Q ∩ S`, and `PrimeSpectrum.primesOverOrderIsoFiber` says that `Q ↦ 𝔮` matches the primes of
the fibre with the primes of `S` over `𝔭`, so the hypothesis at `Q` is the source's inequality
`depth(S_𝔮/𝔭S_𝔮) ≥ min{k, dim(S_𝔮/𝔭S_𝔮)}`. Primes `𝔭` outside the image of `Spec S → Spec R`
constrain nothing, their fibre ring being zero and so without primes.

Both Noetherian hypotheses are kept, unlike in Tags 0337 and 045J where the base's Noetherianity
follows from faithful flatness of a local homomorphism. Here `Spec S → Spec R` need not be
surjective, so `IsNoetherianRing R` is derivable only at the primes of `R` in the image, and it
is used where the source uses it: additivity of height along a flat map (Tag 00ON, in Mathlib as
`Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown`, going down coming from flatness)
requires the base Noetherian, and Definition 031P presupposes it for the phrase `(S_k)`.

Faithfulness to [StacksProject 0339]:

1. No dead hypothesis. Flatness is used: for `R = k[t] → S = k[x, y]/(x², xy)`, `t ↦ y`, both
   rings are Noetherian and `R`, being regular, has `(S_k)` for every `k`, while every fibre ring
   is `(S_k)` too — `k(y)` over `(0)`, the field `k` over `(t - a)` with `a ≠ 0`, and `k[x]/(x²)`,
   of depth and dimension `0`, over `(t)` — yet `S` fails `(S_2)`: at `𝔪 = (x, y)` the nonzero
   element `x` is killed by `𝔪`, so `depth(S_𝔪) = 0 < 1 = min{2, dim(S_𝔪)}`. The map is not flat,
   `S` having `y`-torsion. Hypothesis (4) is used: over `R = k` the ring `S = k[x, y]/(x², xy)` is
   flat and `R` has `(S_k)`, but `S` fails `(S_2)`, the single fibre being `S` itself. Hypothesis
   (5) is used: the identity map of `S = k[x, y]/(x², xy)` is flat with all fibres fields, hence
   `(S_k)`, and `S` fails `(S_2)`. `IsNoetherianRing S` is used by every step — additivity of
   depth (Tag 0337) and of height (Tag 00ON) both need it — and `IsNoetherianRing R` as above.
   The integer `k` appears in all three conditions.
2. The scalars and base are the source's. Each of the three `(S_k)` conditions is formed at a
   prime over the local ring there and over that local ring itself: the depth of `A_𝔮` as a
   module over `A_𝔮` along its maximal ideal, not `Module.depth A 𝔮 A`, and the dimension of
   `A_𝔮`, not of `A`. Flatness is that of `S` as an `R`-module along `algebraMap R S`, with no
   localization interposed, and the fibre ring is formed over `R` at `κ(𝔭)`.
3. The maps are pinned, not merely assumed to exist: `Algebra R S` provides `φ` as
   `algebraMap R S`, `Module.Flat R S` is flatness for that `R`-module structure, the local rings
   are the canonical models `Localization.AtPrime 𝔭`, `Localization.AtPrime 𝔮` and
   `Localization.AtPrime Q`, and the fibre ring is `Ideal.Fiber 𝔭 S` with its canonical
   `R`-algebra structure, so the conditions are about the localizations and the fibres of `φ`
   itself and not about rings with the same invariants.
4. The instantiation is not degenerate. `R = ℚ[x] → S = ℚ[x, y]` and `k = 2` satisfy every
   hypothesis, `S` being free hence flat over `R` and both rings regular, so all fibre rings
   `κ(𝔭)[y]` are regular; the conclusion is a genuine statement about the primes of `ℚ[x, y]`,
   where depth and dimension are computed rather than forced. Content beyond the regular case:
   for `R = k[t]` and `S = k[t][x, y, u, v]/(xy - uv)`, free over `R`, the fibre rings are
   hypersurfaces, hence Cohen–Macaulay and `(S_k)` for every `k`, and the conclusion gives
   `(S_2)` for a ring that is not regular. The conclusion is not vacuous for any `k`: at a prime
   of dimension `≥ k` in a ring failing `(S_k)` the inequality genuinely fails, as the union of
   the two counterexamples above shows for `k = 2`.

