/-!
# Serre's criterion: a Noetherian ring is reduced iff it has `(R_0)` and `(S_1)`

Throughout, `R` is a Noetherian commutative unital ring. For a prime ideal `p ⊂ R`, `R_p` is
the localization of `R` at `p`, `dim (R_p)` its Krull dimension — equal to the height of `p` —
and `depth (R_p)` the depth of the local ring `R_p` with respect to its maximal ideal `p R_p`,
i.e. the length of a maximal `p R_p`-regular sequence in `R_p`.

The main result (Stacks Tag 031R, Lemma 10.157.3) is that a Noetherian ring `R` is reduced if
and only if it has both property `(R_0)` and property `(S_1)`.

## Conventions

* `R` is *reduced* if it has no nonzero nilpotent elements, i.e. `x ^ n = 0` with `n ≥ 1`
  implies `x = 0` (Mathlib: `IsReduced`).
* `R` has property `(R_0)` if for every prime `p` of height `0` — equivalently every minimal
  prime — the local ring `R_p` is a regular local ring; for a height-`0` prime that is the same
  as being a field. More generally `R` has `(R_k)` if `R_p` is regular for every prime of
  height `≤ k` (Stacks Definition 10.157.1, Tag 031P); only `k = 0` is used below.
* `R` has property `(S_1)` if `depth (R_p) ≥ min 1 (dim (R_p))` for every prime `p`. More
  generally `R` has `(S_k)` if `depth (R_p) ≥ min k (dim (R_p))` for every prime `p`
  (Tag 031P); only `k = 1` is used below.
* All primes are proper prime ideals, and "minimal prime" means a minimal element of the set of
  primes, equivalently a prime of height `0`.
* Depth is taken over the maximal ideal of the local ring `R_p`, and by convention the depth of
  the zero module is `+∞`. These conventions do not affect the case `k = 1` used here, where
  the only nontrivial requirement is at primes of height `≥ 1`.
* For a prime `p` one has `dim (R_p) = height p`; in Mathlib, `Ideal.height`, with
  `IsLocalization.AtPrime.ringKrullDim_eq_height` recording
  `(p.height : WithBot ℕ∞) = ringKrullDim (Localization.AtPrime p)`. Property `(S_1)` is
  therefore phrased directly with `p.height` in place of `dim (R_p)`.
-/

@[expose] public section

open Ring
/-- Property `(R_0)`: for every height-`0` prime ideal `p` (equivalently every
minimal prime), the localization `R_p` is a regular local ring. This is the case
`k = 0` of property `(R_k)` (Stacks Tag 031P). -/
@[ega "IV 5.8.2" "ring formulation, k = 0", ega "IV 7.5.3" "partial"]
def HasR0 (R : Type*) [CommRing R] : Prop :=
  ∀ (p : Ideal R) [p.IsPrime], p.height = 0 → IsRegularLocalRing (Localization.AtPrime p)

/-- Property `(S_1)`: for every prime ideal `p`, the depth of the local ring
`R_p` (with respect to its maximal ideal) is at least `min {1, dim(R_p)}`, where
`dim(R_p) = p.height`. This is the case `k = 1` of property `(S_k)`
(Stacks Tag 031P). -/
@[ega "IV 5.7.2" "special case", ega "IV 5.7.3", ega "IV 7.5.3" "special case"]
def HasS1 (R : Type*) [CommRing R] : Prop :=
  ∀ (p : Ideal R) [p.IsPrime],
    min 1 p.height ≤
      Module.depthSup (Localization.AtPrime p)
        (IsLocalRing.maximalIdeal (Localization.AtPrime p)) (Localization.AtPrime p)

/-- (Forward, R_0) If `R` is reduced (Noetherian), then `R` has property `(R_0)`.

The argument: let `p` be a height-`0` prime. Then `R_p` is Noetherian, local,
of Krull dimension `0` (`dim R_p = height p = 0`), and reduced (localizations of a
reduced ring are reduced). A reduced Noetherian local ring of dimension `0` is a
field: its maximal ideal is the unique prime, hence the nilradical, hence (by
reducedness) the zero ideal, so `R_p` is a field. A field is a regular local ring
(its maximal ideal `(0)` is generated by `0` elements, matching `dim = 0`). -/
-- A reduced Noetherian local ring of Krull dimension `0` is a regular local ring
-- (it is a field: its maximal ideal is the unique prime, hence the nilradical, hence `⊥`).
private theorem isRegularLocalRing_of_reduced_dim_zero (S : Type*) [CommRing S]
    [IsNoetherianRing S] [IsLocalRing S] [IsReduced S] (hdim : ringKrullDim S = 0) :
    IsRegularLocalRing S := by
  -- The maximal ideal has height `0`, hence is a minimal prime.
  have hmh : (IsLocalRing.maximalIdeal S).height = 0 := by
    have := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := S)
    rw [hdim] at this
    exact_mod_cast this
  have hmin : IsLocalRing.maximalIdeal S ∈ minimalPrimes S := by
    rw [← Ideal.height_eq_zero_iff]
    exact hmh
  -- In a local ring, a minimal maximal ideal is the unique prime.
  have huniq : ∀ (p : Ideal S), p.IsPrime → p = IsLocalRing.maximalIdeal S := by
    intro p hp
    have := hp
    have hpm : p ≤ IsLocalRing.maximalIdeal S :=
      IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
    obtain ⟨⟨_, _⟩, hmindown⟩ := hmin
    exact ((hmindown ⟨inferInstance, bot_le⟩ hpm).antisymm hpm).symm
  -- Hence the maximal ideal is contained in the nilradical, which is `⊥` by reducedness.
  have hmle : IsLocalRing.maximalIdeal S ≤ nilradical S := by
    rw [nilradical_eq_sInf_minimalPrimes]
    apply le_sInf
    intro q hq
    have : q.IsPrime := hq.isPrime
    rw [huniq q this]
  have hm0 : IsLocalRing.maximalIdeal S = ⊥ := by
    rw [nilradical_eq_zero S] at hmle
    exact le_bot_iff.mp hmle
  -- So `spanFinrank (maximalIdeal S) = 0 = ringKrullDim S`, i.e. `S` is regular.
  refine ⟨?_⟩
  rw [hm0, Submodule.spanFinrank_bot, hdim]
  rfl

/-- A reduced Noetherian ring has property `(R_0)`. -/
@[ega "IV 3.2.1" "a)",
  ega "IV 5.8.5" "Necessity of (R_0)",
  ega "IV 7.3.9" "(i): (vi) implies (v_0)"]
theorem hasR0_of_isReduced (R : Type*) [CommRing R] [IsNoetherianRing R]
    [IsReduced R] : HasR0 R := by
  intro p _ hp
  -- `S := Localization.AtPrime p` is Noetherian, local and reduced; its dimension is
  -- `height p = 0`. A reduced Noetherian local ring of dimension `0` is a regular local ring.
  apply isRegularLocalRing_of_reduced_dim_zero
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height p (Localization.AtPrime p), hp]
  rfl

/-- If `q` is the annihilator of `y`, then `r ∈ q` iff `r * y = 0`. -/
private theorem mem_iff_mul_eq_zero_of_eq_colon {S : Type*} [CommRing S] {q : Ideal S} {y : S}
    (hy : q = (⊥ : Submodule S S).colon {y}) (r : S) : r ∈ q ↔ r * y = 0 := by
  rw [hy, Submodule.mem_colon_singleton]
  simp [Submodule.mem_bot, smul_eq_mul]

/-- If a prime `q` is the annihilator of `y`, then `y` does not vanish in `R_q`. -/
private theorem algebraMap_atPrime_ne_zero_of_eq_colon {S : Type*} [CommRing S] {q : Ideal S}
    [q.IsPrime] {y : S} (hy : q = (⊥ : Submodule S S).colon {y}) :
    algebraMap S (Localization.AtPrime q) y ≠ 0 := by
  intro h
  rw [IsLocalization.map_eq_zero_iff q.primeCompl] at h
  obtain ⟨m, hm⟩ := h
  exact m.property ((mem_iff_mul_eq_zero_of_eq_colon hy m).mpr hm)

/-- In a reduced Noetherian ring, every associated prime is a minimal prime. -/
private theorem assoc_mem_minimalPrimes_of_isReduced {S : Type*} [CommRing S]
    [IsNoetherianRing S] [IsReduced S] (q : Ideal S) (hq : q ∈ associatedPrimes S S) :
    q ∈ minimalPrimes S := by
  rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff] at hq
  obtain ⟨hp, x, hx⟩ := hq
  have := hp
  have hmemq := mem_iff_mul_eq_zero_of_eq_colon hx
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hp.ne_top (Ideal.eq_top_iff_one _ |>.mpr ((hmemq 1).mpr (by simp)))
  have hxnil : x ∉ nilradical S := by
    rw [nilradical_eq_zero S]; simpa using hx0
  rw [nilradical_eq_sInf_minimalPrimes] at hxnil
  rw [Submodule.mem_sInf] at hxnil
  push Not at hxnil
  obtain ⟨p0, hp0mem, hxp0⟩ := hxnil
  obtain ⟨⟨hp0prime, _⟩, hp0min⟩ := hp0mem
  have : Ideal.IsPrime p0 := hp0prime
  have hqsub : q ≤ p0 := by
    intro r hr
    have : r * x ∈ p0 := by rw [(hmemq r).mp hr]; exact p0.zero_mem
    rcases hp0prime.mem_or_mem this with h | h
    · exact h
    · exact absurd h hxp0
  have hp0q : p0 ≤ q := hp0min ⟨hp, bot_le⟩ hqsub
  have hqp0 : q = p0 := le_antisymm hqsub hp0q
  rw [hqp0]
  exact ⟨⟨hp0prime, bot_le⟩, hp0min⟩

/-- A reduced Noetherian local ring of positive Krull dimension has a regular element in its
maximal ideal. -/
public theorem exists_regular_mem_maximalIdeal {S : Type*} [CommRing S] [IsNoetherianRing S]
    [IsLocalRing S] [IsReduced S] (hpos : 0 < ringKrullDim S) :
    ∃ t ∈ IsLocalRing.maximalIdeal S, IsSMulRegular S t := by
  by_contra hcon
  push Not at hcon
  have hmsub : (IsLocalRing.maximalIdeal S : Set S) ⊆ ⋃ p ∈ associatedPrimes S S, (p : Set S) := by
    rw [biUnion_associatedPrimes_eq_compl_nonZeroDivisors S]
    intro t ht
    simp only [Set.mem_compl_iff, SetLike.mem_coe]
    intro htnzd
    exact hcon t ht (Module.Flat.isSMulRegular_of_nonZeroDivisors htnzd)
  set sFin := (associatedPrimes.finite S S).toFinset with hsFin
  have hbiUnion : (⋃ p ∈ associatedPrimes S S, (p : Set S))
      = ⋃ i ∈ (sFin : Set (Ideal S)), ((id i : Ideal S) : Set S) := by
    rw [hsFin]; simp
  rw [hbiUnion] at hmsub
  obtain ⟨q0, hq0⟩ := associatedPrimes.nonempty S S
  have hprime_all : ∀ i ∈ sFin, i ≠ q0 → i ≠ q0 → (id i).IsPrime := by
    intro i hi _ _
    rw [hsFin, Set.Finite.mem_toFinset] at hi
    exact hi.isPrime
  obtain ⟨q, hqFin, hmq⟩ := (Ideal.subset_union_prime q0 q0 hprime_all).mp hmsub
  rw [hsFin, Set.Finite.mem_toFinset] at hqFin
  have hqle : q ≤ IsLocalRing.maximalIdeal S := IsLocalRing.le_maximalIdeal hqFin.isPrime.ne_top
  have hqeq : q = IsLocalRing.maximalIdeal S := le_antisymm hqle hmq
  have hqmin : q ∈ minimalPrimes S := assoc_mem_minimalPrimes_of_isReduced q hqFin
  have := hqFin.isPrime
  have hqheight : q.height = 0 := Ideal.height_eq_zero_iff.mpr hqmin
  have hheightdim := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := S)
  rw [← hqeq, hqheight] at hheightdim
  rw [← hheightdim] at hpos
  exact absurd hpos (by simp)

/-- A regular element in the maximal ideal of a local ring witnesses depth `≥ 1`. -/
private theorem one_le_depth_of_regular {S : Type*} [CommRing S] [IsLocalRing S] (t : S)
    (ht : t ∈ IsLocalRing.maximalIdeal S) (htreg : IsSMulRegular S t) :
    1 ≤ Module.depthSup S (IsLocalRing.maximalIdeal S) S := by
  rw [Module.depthSup]
  apply le_sSup
  refine ⟨[t], by simp, ?_, ?_⟩
  · intro r hr; simp only [List.mem_cons, List.not_mem_nil, or_false] at hr; subst hr; exact ht
  · rw [RingTheory.Sequence.isRegular_cons_iff]
    refine ⟨htreg, ?_⟩
    have : Nontrivial (QuotSMulTop t S) := by
      apply (Submodule.Quotient.nontrivial_iff).mpr
      intro h
      have h1 : (1 : S) ∈ (⊤ : Submodule S S) := trivial
      rw [← h] at h1
      rw [Submodule.mem_smul_pointwise_iff_exists] at h1
      obtain ⟨a, _, ha⟩ := h1
      rw [smul_eq_mul] at ha
      have hu : IsUnit t := IsUnit.of_mul_eq_one a ha
      exact IsLocalRing.maximalIdeal.isMaximal S |>.ne_top (Ideal.eq_top_of_isUnit_mem _ ht hu)
    exact RingTheory.Sequence.IsRegular.nil S _

/-- (Forward, S_1) If `R` is reduced (Noetherian), then `R` has property `(S_1)`.

The argument: let `p` be a prime. If `height p = 0` then `min 1 (height p) = 0`
and the bound `0 ≤ depth` is trivial (depth is a `ℕ∞`-valued quantity). So assume
`height p ≥ 1`; then `min 1 (height p) = 1`, and we must show `1 ≤ depth(R_p)`, i.e.
the maximal ideal `m = pR_p` of the local ring `S := R_p` contains a nonzerodivisor
(equivalently `depth ≥ 1`, equivalently `m ∉ Ass(S)`).

Note `S = R_p` is Noetherian, local, reduced (localization of a reduced ring), and of
dimension `height p ≥ 1`, so `m ≠ 0` (a `0`-dimensional local ring would have `m`
nilpotent, but `dim ≥ 1`). For depth `≥ 1` it suffices that `m` is not contained in
the union of the associated primes of `S` — equivalently, since `S` is Noetherian, it
suffices that `m` is not itself an associated prime and `m` contains a nonzerodivisor.

Key reduction via reducedness: in a reduced Noetherian ring the associated primes are
exactly the minimal primes (no embedded primes), because a reduced ring's set of
zerodivisors is the union of its minimal primes. The maximal ideal `m` has `height p
≥ 1`, so `m` is *not* a minimal prime of `S`, hence `m` is not an associated prime,
hence `m` is not contained in the union of associated primes (which are the minimal
primes, all strictly contained in `m` since `m` is not minimal and `S` is local with
`m` the unique maximal ideal — and a finite union of primes none containing `m` cannot
cover `m` by prime avoidance). Therefore `m` contains a nonzerodivisor `t`, giving
`depth(R_p) ≥ 1`. -/
@[ega "IV 12.1.8" "more general",
  ega "IV 3.2.1" "a)",
  ega "IV 5.8.5" "Necessity of (S_1)",
  ega "IV 7.3.9" "(i)"]
theorem hasS1_of_isReduced (R : Type*) [CommRing R] [IsNoetherianRing R]
    [IsReduced R] : HasS1 R := by
  intro p _
  rcases eq_or_ne p.height 0 with hh | hh
  · rw [hh]; simp
  · have h1 : (1 : ℕ∞) ≤ p.height := Order.one_le_iff_ne_zero.mpr hh
    rw [min_eq_left h1]
    have hpos : 0 < ringKrullDim (Localization.AtPrime p) := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height p (Localization.AtPrime p)]
      have hle : (1 : WithBot ℕ∞) ≤ (p.height : WithBot ℕ∞) := by exact_mod_cast h1
      exact lt_of_lt_of_le (by simp) hle
    obtain ⟨t, htmem, htreg⟩ := exists_regular_mem_maximalIdeal (S := Localization.AtPrime p) hpos
    exact one_le_depth_of_regular t htmem htreg

/- (Reverse) If `R` (Noetherian) has properties `(R_0)` and `(S_1)`, then `R` is
reduced.

The argument: reducedness is a local property — `R` is reduced iff `R_p` is
reduced for every prime (indeed every maximal) `p`. So it suffices to show each `R_p`
is reduced, which we do by induction on `height p`.
- If `height p = 0`, then by `(R_0)` `R_p` is a regular local ring of dimension `0`,
  hence a field, hence reduced.
- If `height p ≥ 1`, by `(S_1)` `depth(R_p) ≥ 1`, so the maximal ideal `m = pR_p`
  contains a nonzerodivisor `t`. Then `R_p → R_p[1/t]` is injective. The ring
  `R_p[1/t]` has all its primes among the primes of `R_p` not containing `t`, i.e.
  primes `q ⊊ m`, which correspond to primes of `R` of height `< height p`. By the
  inductive hypothesis every localization of `R_p[1/t]` at a maximal ideal is reduced
  (it is a localization of `R` at a prime of smaller height), and reducedness is local
  (`injective_of_localized_maximal` / Stacks 00HN), so `R_p[1/t]` is reduced; since
  `R_p ↪ R_p[1/t]`, `R_p` is reduced. -/
/-- `1 ≤ depth I M` yields an `M`-regular element of `I`. -/
private theorem one_le_depth_exists {A : Type*} [CommRing A] (I : Ideal A) (M : Type*)
    [AddCommGroup M] [Module A M] (h : 1 ≤ Module.depthSup A I M) :
    ∃ r ∈ I, IsSMulRegular M r := by
  by_contra hcon
  push Not at hcon
  have hle : Module.depthSup A I M ≤ 0 := by
    rw [Module.depthSup]
    apply sSup_le
    intro n hn
    obtain ⟨rs, hlen, hmem, hreg⟩ := hn
    match rs with
    | [] => simpa using hlen.symm
    | r :: t =>
      exfalso
      rw [RingTheory.Sequence.isRegular_cons_iff] at hreg
      exact hcon r (hmem r (by simp)) hreg.left
  exact absurd (le_trans h hle) (by simp)

/-- A regular local ring of Krull dimension `0` is reduced (it is a field). -/
private theorem isReduced_of_regular_dim_zero (A : Type*) [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 0) : IsReduced A := by
  have hm : IsLocalRing.maximalIdeal A = ⊥ := by
    have hsf : (Submodule.spanFinrank (IsLocalRing.maximalIdeal A) : WithBot ℕ∞) = ringKrullDim A :=
      IsRegularLocalRing.spanFinrank_maximalIdeal
    rw [hdim] at hsf
    have hsf0 : Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = 0 := by exact_mod_cast hsf
    have hfg : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
    exact (Submodule.spanFinrank_eq_zero_iff_eq_bot hfg).mp hsf0
  have hfield : IsField A := (IsLocalRing.isField_iff_maximalIdeal_eq).mpr hm
  let := hfield.toField
  infer_instance

/-- If `R` has `(R_0)` and `(S_1)`, then for every prime `q` that is the annihilator of a
nonzero element `y` (i.e. `q ∈ Ass(R)`), the localization `R_q` is reduced.

The point is that `(S_1)` forces such a `q` to have height `0`: otherwise `depth(R_q) ≥ 1`
would give a nonzerodivisor `t ∈ qR_q`, yet every element of `qR_q` annihilates `y/1 ≠ 0`,
a contradiction. Then `(R_0)` makes `R_q` a regular local ring of dimension `0`, hence a
field, hence reduced. -/
private theorem isReduced_localization_of_associated {R : Type*} [CommRing R] [IsNoetherianRing R]
    (hR0 : HasR0 R) (hS1 : HasS1 R) (q : Ideal R) [hq : q.IsPrime] (y : R)
    (hy : q = (⊥ : Submodule R R).colon {y}) :
    IsReduced (Localization.AtPrime q) := by
  have hmemq := mem_iff_mul_eq_zero_of_eq_colon hy
  have hheight : q.height = 0 := by
    by_contra hne
    have h1 : (1 : ℕ∞) ≤ q.height := Order.one_le_iff_ne_zero.mpr hne
    have hdepth : 1 ≤ Module.depthSup (Localization.AtPrime q)
        (IsLocalRing.maximalIdeal (Localization.AtPrime q)) (Localization.AtPrime q) := by
      have := hS1 q
      rwa [min_eq_left h1] at this
    obtain ⟨t, htmem, htreg⟩ := one_le_depth_exists _ _ hdepth
    have hkill : t * algebraMap R (Localization.AtPrime q) y = 0 := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q (Localization.AtPrime q)] at htmem
      have hsub : Ideal.map (algebraMap R (Localization.AtPrime q)) q ≤
          (Submodule.span (Localization.AtPrime q)
            {algebraMap R (Localization.AtPrime q) y}).annihilator := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, Submodule.mem_annihilator_span_singleton, smul_eq_mul, ← map_mul]
        rw [(hmemq a).mp ha, map_zero]
      have hmem2 := hsub htmem
      rwa [Submodule.mem_annihilator_span_singleton, smul_eq_mul] at hmem2
    have hw0 : algebraMap R (Localization.AtPrime q) y = 0 := by
      have heq : t • algebraMap R (Localization.AtPrime q) y
          = t • (0 : Localization.AtPrime q) := by simpa using hkill
      exact htreg heq
    exact algebraMap_atPrime_ne_zero_of_eq_colon hy hw0
  have := hR0 q hheight
  apply isReduced_of_regular_dim_zero
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height q (Localization.AtPrime q), hheight]
  rfl

/-- A Noetherian ring with properties `(R_0)` and `(S_1)` is reduced. -/
@[ega "IV 3.2.1" "c)", ega "IV 5.8.5" "Sufficiency direction", ega "IV 7.3.9" "(i)"]
theorem isReduced_of_hasR0_hasS1 (R : Type*) [CommRing R] [IsNoetherianRing R]
    (hR0 : HasR0 R) (hS1 : HasS1 R) : IsReduced R := by
  rw [isReduced_iff]
  intro x hx
  by_contra hx0
  -- `M = R ∙ x` is a nonzero submodule, so it has an associated prime `q`.
  have hnt : Nontrivial (Submodule.span R {x}) := by
    rw [Submodule.nontrivial_iff_ne_bot]
    intro hb
    apply hx0
    have : x ∈ (⊥ : Submodule R R) := hb ▸ Submodule.mem_span_singleton_self x
    simpa using this
  obtain ⟨q, hqass⟩ := associatedPrimes.nonempty R (Submodule.span R {x})
  rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff] at hqass
  obtain ⟨hp, z, hz⟩ := hqass
  have : q.IsPrime := hp
  -- `q` is the annihilator of the nonzero element `z ∈ R ∙ x`.
  have hqcolon : q = (⊥ : Submodule R R).colon {(z : R)} := by
    rw [hz]; ext r
    rw [Submodule.mem_colon_singleton, Submodule.mem_colon_singleton]
    simp only [Submodule.mem_bot]
    rw [← Submodule.coe_smul, ZeroMemClass.coe_eq_zero]
  -- Hence `q ∈ Ass(R)`, and by `(R_0)`, `(S_1)` the localization `R_q` is reduced.
  have hred : IsReduced (Localization.AtPrime q) :=
    isReduced_localization_of_associated hR0 hS1 q (z : R) hqcolon
  -- `x` is nilpotent, so `x/1 = 0` in the reduced ring `R_q`.
  have hx1 : algebraMap R (Localization.AtPrime q) x = 0 := by
    have : IsNilpotent (algebraMap R (Localization.AtPrime q) x) := hx.map _
    exact IsReduced.eq_zero _ this
  -- `z = c • x`, hence `z/1 = 0` in `R_q`.
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp z.property
  have hz1 : algebraMap R (Localization.AtPrime q) (z : R) = 0 := by
    rw [← hc, smul_eq_mul, map_mul, hx1, mul_zero]
  -- But `z/1 ≠ 0` because `q = Ann(z)` is a proper ideal: contradiction.
  exact algebraMap_atPrime_ne_zero_of_eq_colon hqcolon hz1

/-- Stacks Tag 031R (Lemma 10.157.3, Serre's criterion). A Noetherian ring `R`
is reduced if and only if it has both property `(R_0)` and property `(S_1)`. -/
@[stacks 031R,
  ega "IV 12.1.8" "more general",
  ega "IV 3.2.1" "a), special case",
  ega "IV 5.8.5" "special case",
  ega "IV 7.3.9" "(i), special case"]
theorem isReduced_iff_hasR0_and_hasS1 (R : Type*) [CommRing R] [IsNoetherianRing R] :
    IsReduced R ↔ HasR0 R ∧ HasS1 R := by
  constructor
  · intro hred
    exact ⟨hasR0_of_isReduced R, hasS1_of_isReduced R⟩
  · rintro ⟨hR0, hS1⟩
    exact isReduced_of_hasR0_hasS1 R hR0 hS1

end
