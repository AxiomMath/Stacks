module

public import StacksFrontier.RingTheory.FormsTrace.DescentKernel
public import StacksFrontier.RingTheory.FormsTrace.BaseChange
public import StacksFrontier.RingTheory.FormsTrace.Differential

/-!
# Descent of trace maps on differential forms along a surjection

Let `R → A` be a surjective ring map with kernel `I`, let `S` be a finite projective `R`-algebra
and let `B = A ⊗_R S` (in the form `Algebra.IsPushout R S A B`), so that `S → B` is surjective
with kernel `I S`. Suppose given `R`-linear maps `Θ^p : Ω^p_S → Ω^p_R` (absolute differential
forms) satisfying conditions (1) of Stacks, Lemma 0FLB and (2) of Proposition 0FLC. Then the
`Θ^p` descend: there are unique `A`-linear maps `Θ^p_A : Ω^p_B → Ω^p_A` with
`Θ^p_A(η|_B) = Θ^p(η)|_A`, and they again satisfy (1) and (2), and they commute with the de Rham
differentials if the `Θ^p` do.

All names below are in the namespace `Stacks.FormsTrace`.

## Main definitions

* `descendForms`: the descended maps `Θ^p_A`.

## Main results

* `formsMap_descent_eq_zero`: `Θ^p` maps `ker(Ω^p_S → Ω^p_B)` into `ker(Ω^p_R → Ω^p_A)`.
* `descendForms_formsMap`: the defining compatibility `Θ^p_A(η|_B) = Θ^p(η)|_A`.
* `eq_of_formsMap_comp_eq`: a family on `Ω^•_B` is determined by its composite with the
  restriction `Ω^•_S → Ω^•_B`; in particular `descendForms` is the only family with the
  compatibility.
* `isFormsTrace_descendForms`, `isWedgeLinear_descendForms`, `commutesWithD_descendForms`: the
  descended maps inherit the three conditions.
* `exists_unique_descent`: there is a unique family with the compatibility; it satisfies (1) and
  (2), and it commutes with the de Rham differentials if the `Θ^p` do.
* `algebraMap_surjective_of_isPushout`, `mem_smul_top_of_algebraMap_eq_zero`,
  `finite_of_isPushout`, `projective_of_isPushout`: the base change `S → B` of the surjection
  `R → A` is surjective with kernel `I S`, and `B` is finite projective over `A`.

## References

* [Stacks Project, Tag 0FLB](https://stacks.math.columbia.edu/tag/0FLB)
* [Stacks Project, Tag 0FLC](https://stacks.math.columbia.edu/tag/0FLC)
-/

@[expose] public noncomputable section

open scoped TensorProduct
open KaehlerDifferential

universe u

namespace Stacks.FormsTrace

namespace DescentAux

/-- The pull-back of forms along a surjective ring map is surjective. -/
theorem formsMap_surjective {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : Function.Surjective (algebraMap A B)) (p : ℕ) :
    Function.Surjective (formsMap A B p) :=
  powMapₛₗ_surjective h _ (KaehlerDifferential.map_surjective_of_surjective ℤ ℤ A B h) p

end DescentAux

open DescentAux

/-- **The kernel of `Ω_S → Ω_B` for a surjection `S → B`** is generated by `J · Ω_S` and `d(J)`,
`J = ker(S → B)`: the conormal sequence `J/J² → B ⊗_S Ω_S → Ω_B → 0`. -/
theorem mem_of_kaehlerMap_eq_zero {S B : Type u} [CommRing S] [CommRing B] [Algebra S B]
    (h : Function.Surjective (algebraMap S B)) (ω : Ω[S⁄ℤ])
    (hω : KaehlerDifferential.map ℤ ℤ S B ω = 0) :
    ω ∈ (RingHom.ker (algebraMap S B) • ⊤ : Submodule S Ω[S⁄ℤ]) ⊔
      Submodule.span S (D ℤ S '' (RingHom.ker (algebraMap S B) : Set S)) := by
  have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange ℤ S B h
  have h0 : KaehlerDifferential.mapBaseChange ℤ S B ((1 : B) ⊗ₜ ω) = 0 := by
    rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, hω]
  obtain ⟨c, hc⟩ := (hex _).1 h0
  obtain ⟨j, rfl⟩ := Ideal.toCotangent_surjective _ c
  rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hc
  have h1 : ω - D ℤ S j.1 ∈ LinearMap.ker (TensorProduct.mk S B Ω[S⁄ℤ] 1) := by
    rw [LinearMap.mem_ker, map_sub, TensorProduct.mk_apply, TensorProduct.mk_apply, ← hc,
      sub_self]
  rw [ker_tensorProductMk_of_surjective h] at h1
  have h2 : D ℤ S j.1 ∈ Submodule.span S (D ℤ S '' (RingHom.ker (algebraMap S B) : Set S)) :=
    Submodule.subset_span ⟨j.1, j.2, rfl⟩
  have := Submodule.add_mem_sup h1 h2
  rwa [sub_add_cancel] at this

section Descent

variable {R S A B : Type u} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
  [Algebra R S] [Algebra R A] [Algebra A B] [Algebra S B] [Algebra R B]
  [IsScalarTower R A B] [IsScalarTower R S B] [Algebra.IsPushout R S A B]

variable (R S A B) in
/-- In a pushout square, the base change `S → B = A ⊗_R S` of a surjection `R → A` is
surjective. -/
theorem algebraMap_surjective_of_isPushout (h : Function.Surjective (algebraMap R A)) :
    Function.Surjective (algebraMap S B) := by
  intro y
  refine (Algebra.IsPushout.out (R := R) (S := S) (R' := A) (S' := B)).inductionOn
    (motive := fun y => y ∈ Set.range (algebraMap S B)) y ?_ ?_ ?_
  · intro a
    obtain ⟨r, rfl⟩ := h a
    refine ⟨algebraMap R S r, ?_⟩
    change _ = algebraMap A B (algebraMap R A r)
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  · rintro s _ ⟨s', rfl⟩
    exact ⟨s * s', by rw [map_mul, Algebra.smul_def]⟩
  · rintro _ _ ⟨s, rfl⟩ ⟨s', rfl⟩
    exact ⟨s + s', map_add _ s s'⟩

variable (R S A B) in
/-- In a pushout square with `R → A` surjective, the kernel of `S → B = A ⊗_R S` is
`I S`, `I = ker(R → A)`. -/
theorem mem_smul_top_of_algebraMap_eq_zero (h : Function.Surjective (algebraMap R A)) (s : S)
    (hs : algebraMap S B s = 0) :
    s ∈ (RingHom.ker (algebraMap R A) • ⊤ : Submodule R S) := by
  have hpo := (Algebra.IsPushout.symm (inferInstance : Algebra.IsPushout R S A B)).out
  have h1 : (1 : A) ⊗ₜ[R] s ∈ LinearMap.ker (hpo.equiv : A ⊗[R] S →ₗ[A] B) := by
    rwa [LinearMap.mem_ker, LinearEquiv.coe_coe, IsBaseChange.equiv_tmul, one_smul]
  rw [LinearEquiv.ker, Submodule.mem_bot] at h1
  have h2 : s ∈ LinearMap.ker (TensorProduct.mk R A S 1) := h1
  rwa [ker_tensorProductMk_of_surjective h] at h2

variable (R S A) in
/-- The submodule of forms `x` all of whose multiples `c • x` are carried by `Θ` into the kernel
of `Ω^p_R → Ω^p_A`. -/
def descentKerSubmodule (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (p : ℕ) :
    Submodule S (⋀[S]^p Ω[S⁄ℤ]) where
  carrier := {x | ∀ c : S, formsMap R A p (Θ p (c • x)) = 0}
  add_mem' {x y} hx hy c := by rw [smul_add, map_add, map_add, hx c, hy c, add_zero]
  zero_mem' c := by rw [smul_zero, map_zero, map_zero]
  smul_mem' a x hx c := by rw [smul_smul]; exact hx (c * a)

omit [Algebra A B] [Algebra S B] [Algebra R B] [IsScalarTower R A B] [IsScalarTower R S B]
  [Algebra.IsPushout R S A B] in
/-- Multiples of forms by elements of `I = ker(R → A)` lie in `descentKerSubmodule`. -/
theorem algebraMap_smul_mem_descentKerSubmodule
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) {p : ℕ} {i : R}
    (hi : algebraMap R A i = 0) (x : ⋀[S]^p Ω[S⁄ℤ]) :
    algebraMap R S i • x ∈ descentKerSubmodule R S A Θ p := by
  intro c
  rw [algebraMap_smul, smul_comm, map_smul, map_smulₛₗ, hi, zero_smul]

/-- Multiples of forms by elements of `J = ker(S → B)` lie in `descentKerSubmodule`. -/
theorem smul_mem_descentKerSubmodule (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) {p : ℕ} {j : S}
    (hj : algebraMap S B j = 0) (x : ⋀[S]^p Ω[S⁄ℤ]) :
    j • x ∈ descentKerSubmodule R S A Θ p := by
  refine Submodule.smul_induction_on (mem_smul_top_of_algebraMap_eq_zero R S A B hRA j hj) ?_ ?_
  · intro i hi s _
    rw [Algebra.smul_def, mul_smul]
    exact algebraMap_smul_mem_descentKerSubmodule Θ hi _
  · intro a b ha hb
    rw [add_smul]
    exact Submodule.add_mem _ ha hb

omit [Algebra A B] [Algebra S B] [Algebra R B] [IsScalarTower R A B] [IsScalarTower R S B]
  [Algebra.IsPushout R S A B] in
/-- A wedge `d(i) ∧ ζ` with `i ∈ I = ker(R → A)` lies in `descentKerSubmodule`, by condition (2)
of Proposition 0FLC. -/
theorem mem_descentKerSubmodule_of_coe_eq
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ) {k : ℕ}
    {i : R} (hi : algebraMap R A i = 0) (ζ : ⋀[S]^k Ω[S⁄ℤ]) (z : ⋀[S]^(k + 1) Ω[S⁄ℤ])
    (hz : (z : ExteriorAlgebra S Ω[S⁄ℤ]) =
      ExteriorAlgebra.ι S (D ℤ S (algebraMap R S i)) * (ζ : ExteriorAlgebra S Ω[S⁄ℤ])) :
    z ∈ descentKerSubmodule R S A Θ (k + 1) := by
  intro c
  set ω₁ : ⋀[R]^1 Ω[R⁄ℤ] := ⟨ExteriorAlgebra.ι R (D ℤ R i), exteriorPower.ι_mem_degreeOne _⟩
  have hω₁ : ((formsMap R S 1 ω₁ : ⋀[S]^1 Ω[S⁄ℤ]) : ExteriorAlgebra S Ω[S⁄ℤ]) =
      ExteriorAlgebra.ι S (D ℤ S (algebraMap R S i)) := by
    rw [ExteriorAlgebra.powMapₛₗ_coe, ExteriorAlgebra.mapₛₗ_ι]
    exact congrArg _ (Stacks.DeRham.kaehlerMapₛₗ_D R S i)
  have h := Nat.add_comm 1 k
  have hzw : c • z = exteriorPower.degCongr h
      (exteriorPower.wedgeMul 1 k (formsMap R S 1 ω₁) (c • ζ)) :=
    Subtype.ext (by
      rw [exteriorPower.coe_degCongr, exteriorPower.wedgeMul_apply_coe, hω₁, SetLike.val_smul,
        SetLike.val_smul, hz, mul_smul_comm])
  rw [hzw, apply_degCongr, hΘ 1 k ω₁ (c • ζ)]
  refine Subtype.ext ?_
  rw [ExteriorAlgebra.powMapₛₗ_coe, exteriorPower.coe_degCongr,
    exteriorPower.wedgeMul_apply_coe, map_mul, ExteriorAlgebra.mapₛₗ_ι]
  change ExteriorAlgebra.ι A (KaehlerDifferential.map ℤ ℤ R A (D ℤ R i)) * _ = 0
  rw [KaehlerDifferential.map_D, hi, map_zero, map_zero, zero_mul]

/-- **`Θ^p` carries `ker(Ω^p_S → Ω^p_B)` into `ker(Ω^p_R → Ω^p_A)`.** Here `R → A` is surjective,
`B = A ⊗_R S`, and `Θ` satisfies condition (2) of Stacks, Proposition 0FLC. -/
theorem formsMap_descent_eq_zero (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ) (p : ℕ)
    (η : ⋀[S]^p Ω[S⁄ℤ]) (hη : formsMap S B p η = 0) :
    formsMap R A p (Θ p η) = 0 := by
  have hSB := algebraMap_surjective_of_isPushout R S A B hRA
  suffices η ∈ descentKerSubmodule R S A Θ p by simpa using this 1
  cases p with
  | zero =>
    have hmem : (η : ExteriorAlgebra S Ω[S⁄ℤ]) ∈ (1 : Submodule S (ExteriorAlgebra S Ω[S⁄ℤ])) := by
      have h0 : (⋀[S]^0 Ω[S⁄ℤ]) = 1 := pow_zero _
      exact h0 ▸ η.2
    obtain ⟨s, hs⟩ := Submodule.mem_one.1 hmem
    have hηs : η = s • exteriorPower.unitDegZero S Ω[S⁄ℤ] := by
      refine Subtype.ext ?_
      rw [SetLike.val_smul, exteriorPower.coe_unitDegZero, ← hs, Algebra.algebraMap_eq_smul_one]
    have hs0 : algebraMap S B s = 0 := by
      have h1 := congrArg Subtype.val hη
      rw [ExteriorAlgebra.powMapₛₗ_coe, ← hs, ExteriorAlgebra.mapₛₗ_algebraMap] at h1
      exact (ExteriorAlgebra.algebraMap_leftInverse Ω[B⁄ℤ]).injective (h1.trans (map_zero _).symm)
    rw [hηs]
    exact smul_mem_descentKerSubmodule hRA Θ hs0 _
  | succ k =>
    have hker := ker_powMapₛₗ_le_span_wedgeLeft hSB (Stacks.DeRham.kaehlerMapₛₗ S B)
      (KaehlerDifferential.map_surjective_of_surjective ℤ ℤ S B hSB) k (LinearMap.mem_ker.2 hη)
    refine (Submodule.span_le.2 ?_) hker
    rintro _ ⟨m, y, hm, rfl⟩
    have hm' := mem_of_kaehlerMap_eq_zero hSB m hm
    let L : Ω[S⁄ℤ] →ₗ[S] ⋀[S]^(k + 1) Ω[S⁄ℤ] :=
      { toFun := fun m => exteriorPower.wedgeLeft m k y
        map_add' := fun a b => by
          simp only [exteriorPower.wedgeLeft, map_add, LinearMap.add_apply]
        map_smul' := fun c a => by
          simp only [exteriorPower.wedgeLeft, map_smul, LinearMap.smul_apply, RingHom.id_apply] }
    change m ∈ (descentKerSubmodule R S A Θ (k + 1)).comap L
    suffices hle : (RingHom.ker (algebraMap S B) • ⊤ : Submodule S Ω[S⁄ℤ]) ⊔
        Submodule.span S (D ℤ S '' (RingHom.ker (algebraMap S B) : Set S)) ≤
          (descentKerSubmodule R S A Θ (k + 1)).comap L from hle hm'
    refine sup_le ?_ ?_
    · refine Submodule.smul_le.2 fun j hj a _ => ?_
      rw [Submodule.mem_comap, map_smul]
      exact smul_mem_descentKerSubmodule hRA Θ hj _
    · refine Submodule.span_le.2 ?_
      rintro _ ⟨j, hj, rfl⟩
      refine Submodule.smul_induction_on (mem_smul_top_of_algebraMap_eq_zero R S A B hRA j hj)
        ?_ ?_
      · intro i hi s _
        rw [Algebra.smul_def, Derivation.leibniz, SetLike.mem_coe, Submodule.mem_comap, map_add,
          map_smul, map_smul]
        refine Submodule.add_mem _ (algebraMap_smul_mem_descentKerSubmodule Θ hi _)
          (Submodule.smul_mem _ _ ?_)
        exact mem_descentKerSubmodule_of_coe_eq Θ hΘ hi y _ (exteriorPower.coe_wedgeLeft _ _ _)
      · intro a b ha hb
        rw [map_add]
        exact Submodule.add_mem _ ha hb

/-- Two forms of `S` with the same restriction to `B` have the same image under `Θ^p` followed
by the restriction to `A`. -/
theorem formsMap_descent_eq (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ) (p : ℕ)
    {η η' : ⋀[S]^p Ω[S⁄ℤ]} (h : formsMap S B p η = formsMap S B p η') :
    formsMap R A p (Θ p η) = formsMap R A p (Θ p η') := by
  rw [← sub_eq_zero, ← map_sub, ← map_sub]
  exact formsMap_descent_eq_zero hRA Θ hΘ p _ (by rw [map_sub, h, sub_self])

variable (R S A B) in
/-- **The descended trace maps** `Θ^p_A : Ω^p_B → Ω^p_A`: the value on the restriction of a
form `η` of `S` is the restriction of `Θ^p(η)`. -/
def descendForms (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ) (p : ℕ) :
    ⋀[B]^p Ω[B⁄ℤ] →ₗ[A] ⋀[A]^p Ω[A⁄ℤ] where
  toFun y := formsMap R A p (Θ p (Function.surjInv
    (formsMap_surjective (algebraMap_surjective_of_isPushout R S A B hRA) p) y))
  map_add' y y' := by
    have hs := formsMap_surjective (algebraMap_surjective_of_isPushout R S A B hRA) p
    rw [← map_add, ← map_add]
    refine formsMap_descent_eq (B := B) hRA Θ hΘ p ?_
    rw [map_add, Function.surjInv_eq hs, Function.surjInv_eq hs, Function.surjInv_eq hs]
  map_smul' a y := by
    have hs := formsMap_surjective (algebraMap_surjective_of_isPushout R S A B hRA) p
    obtain ⟨r, rfl⟩ := hRA a
    rw [RingHom.id_apply, ← map_smulₛₗ, ← map_smul]
    refine formsMap_descent_eq (B := B) hRA Θ hΘ p ?_
    rw [Function.surjInv_eq hs, ← algebraMap_smul S r, map_smulₛₗ, Function.surjInv_eq hs,
      ← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R A B, algebraMap_smul,
      ← IsScalarTower.algebraMap_apply R A B, algebraMap_smul]

/-- **The defining property of the descended maps**: `Θ^p_A(η|_B) = Θ^p(η)|_A`. -/
theorem descendForms_formsMap (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ) (p : ℕ)
    (η : ⋀[S]^p Ω[S⁄ℤ]) :
    descendForms R S A B hRA Θ hΘ p (formsMap S B p η) = formsMap R A p (Θ p η) :=
  formsMap_descent_eq hRA Θ hΘ p
    (Function.surjInv_eq (formsMap_surjective (algebraMap_surjective_of_isPushout R S A B hRA) p) _)

omit [Algebra R S] [Algebra R A] [Algebra R B] [IsScalarTower R A B] [IsScalarTower R S B]
  [Algebra.IsPushout R S A B] in
/-- **Uniqueness**: for `S → B` surjective, a family of maps on the forms of `B` is determined
by its composite with the restriction `Ω^•_S → Ω^•_B`. -/
theorem eq_of_formsMap_comp_eq (hSB : Function.Surjective (algebraMap S B))
    {Θ₁ Θ₂ : ∀ p : ℕ, ⋀[B]^p Ω[B⁄ℤ] →ₗ[A] ⋀[A]^p Ω[A⁄ℤ]}
    (h : ∀ (p : ℕ) (η : ⋀[S]^p Ω[S⁄ℤ]), Θ₁ p (formsMap S B p η) = Θ₂ p (formsMap S B p η)) :
    Θ₁ = Θ₂ := by
  funext p
  refine LinearMap.ext fun y => ?_
  obtain ⟨η, rfl⟩ := formsMap_surjective hSB p y
  exact h p η

variable (R S) in
/-- The base change `B = A ⊗_R S` of a finite `R`-algebra is finite over `A`. -/
theorem finite_of_isPushout [Module.Finite R S] : Module.Finite A B :=
  Module.Finite.equiv (Algebra.IsPushout.symm (inferInstance : Algebra.IsPushout R S A B)).out.equiv

variable (R S) in
/-- The base change `B = A ⊗_R S` of a projective `R`-algebra is projective over `A`. -/
theorem projective_of_isPushout [Module.Projective R S] : Module.Projective A B :=
  Module.Projective.of_equiv
    (Algebra.IsPushout.symm (inferInstance : Algebra.IsPushout R S A B)).out.equiv

/-- **Condition (1) of Lemma 0FLB descends**: if `Θ` is compatible with the trace of `S/R`, the
descended maps are compatible with the trace of `B/A`. -/
theorem isFormsTrace_descendForms [Module.Finite R S] [Module.Projective R S]
    [Module.Finite A B] [Module.Projective A B] (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ)
    (htr : IsFormsTrace R S Θ) : IsFormsTrace A B (descendForms R S A B hRA Θ hΘ) := by
  intro p b ω
  obtain ⟨s, rfl⟩ := algebraMap_surjective_of_isPushout R S A B hRA b
  obtain ⟨ω, rfl⟩ := formsMap_surjective hRA p ω
  rw [formsMap_formsMap, ← formsMap_formsMap (B := S), ← map_smulₛₗ, descendForms_formsMap,
    htr, map_smulₛₗ, trace_algebraMap_of_isPushout (R₁ := R)]

/-- **Condition (2) of Proposition 0FLC descends.** -/
theorem isWedgeLinear_descendForms (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ) :
    IsWedgeLinear A B (descendForms R S A B hRA Θ hΘ) := by
  intro q p ω η
  obtain ⟨ω, rfl⟩ := formsMap_surjective hRA q ω
  obtain ⟨η, rfl⟩ := formsMap_surjective (algebraMap_surjective_of_isPushout R S A B hRA) p η
  rw [formsMap_formsMap, ← formsMap_formsMap (B := S), ← formsMap_wedgeMul,
    descendForms_formsMap, hΘ, formsMap_wedgeMul, descendForms_formsMap]

/-- **Compatibility with the de Rham differentials descends.** -/
theorem commutesWithD_descendForms (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (hΘ : IsWedgeLinear R S Θ)
    (hd : CommutesWithD R S Θ) : CommutesWithD A B (descendForms R S A B hRA Θ hΘ) := by
  intro p η
  obtain ⟨η, rfl⟩ := formsMap_surjective (algebraMap_surjective_of_isPushout R S A B hRA) p η
  rw [← formsMap_deRhamDifferential, descendForms_formsMap, hd, formsMap_deRhamDifferential,
    descendForms_formsMap]

/-- **Descent of trace maps on forms along a surjection.** Let `R → A` be surjective, `S` a
finite projective `R`-algebra and `B = A ⊗_R S`. If `Θ^p : Ω^p_S → Ω^p_R` satisfy condition (1)
of Stacks, Lemma 0FLB and condition (2) of Proposition 0FLC, there is a unique family
`Θ^p_A : Ω^p_B → Ω^p_A` with `Θ^p_A(η|_B) = Θ^p(η)|_A`; it satisfies (1) and (2) for `B/A`, and
it commutes with the de Rham differentials if the `Θ^p` do. -/
theorem exists_unique_descent [Module.Finite R S] [Module.Projective R S]
    [Module.Finite A B] [Module.Projective A B] (hRA : Function.Surjective (algebraMap R A))
    (Θ : ∀ p : ℕ, ⋀[S]^p Ω[S⁄ℤ] →ₗ[R] ⋀[R]^p Ω[R⁄ℤ]) (htr : IsFormsTrace R S Θ)
    (hΘ : IsWedgeLinear R S Θ) :
    ∃! ΘA : ∀ p : ℕ, ⋀[B]^p Ω[B⁄ℤ] →ₗ[A] ⋀[A]^p Ω[A⁄ℤ],
      (∀ (p : ℕ) (η : ⋀[S]^p Ω[S⁄ℤ]), ΘA p (formsMap S B p η) = formsMap R A p (Θ p η)) ∧
      IsFormsTrace A B ΘA ∧ IsWedgeLinear A B ΘA ∧
      (CommutesWithD R S Θ → CommutesWithD A B ΘA) :=
  ⟨descendForms R S A B hRA Θ hΘ,
    ⟨descendForms_formsMap hRA Θ hΘ, isFormsTrace_descendForms hRA Θ hΘ htr,
      isWedgeLinear_descendForms hRA Θ hΘ, commutesWithD_descendForms hRA Θ hΘ⟩,
    fun _ hΘA => eq_of_formsMap_comp_eq (algebraMap_surjective_of_isPushout R S A B hRA)
      fun p η => (hΘA.1 p η).trans (descendForms_formsMap hRA Θ hΘ p η).symm⟩

end Descent

end Stacks.FormsTrace

