module

public import Mathlib.RingTheory.Noetherian.Basic
public import Mathlib.RingTheory.Noetherian.Defs
public import StacksFrontier.RingTheory.Filtration.AssociatedGraded

/-!
# Degree-one generation of a Noetherian graded module over an associated graded ring

Let `I` be an ideal of a commutative ring `A` and let `⨁ₙ Bₙ` be a graded module over the
associated graded ring `⨁ₙ Iⁿ/Iⁿ⁺¹` whose scalar action raises degrees by the degree of the
scalar.  The positive part of `⨁ₙ Iⁿ/Iⁿ⁺¹` is generated in degree one, so if `⨁ₙ Bₙ` is
Noetherian then every graded submodule `E` is, above a uniform degree, obtained from its
preceding degree by multiplying with *one fixed finite family* of degree-one scalars.

This is the algebraic engine of [Stacks, Tag 0GYS]: the source there chooses generators of the
ideal `I` and invokes the open mapping lemma, which needs `I` to be finitely generated; the
finite family produced here comes instead from finite generation of the submodule
`J · E`, where `J` is the ideal generated by all degree-one classes, and therefore needs no
hypothesis on `I` itself.

## Main definitions

* `AssociatedGraded.classOfPow`: the class in degree `n` of an element of `Iⁿ`, as an additive
  map `Iⁿ → ⨁ₖ Iᵏ/Iᵏ⁺¹`.
* `AssociatedGraded.homogeneousPart`: the degree-`n` homogeneous part of an element of a direct
  sum, viewed again inside the direct sum.
* `AssociatedGraded.homogeneousSubmodule`: a degreewise family of subgroups closed under the
  graded action, as a submodule of the direct sum.

## Main results

* `AssociatedGraded.classOfPow_mem_span_degree_one`: a class of positive degree lies in the
  ideal generated by the degree-one classes.
* `AssociatedGraded.homogeneousPart_mem_span_degree_one_smul`: above a uniform degree every
  homogeneous part of a finitely generated graded submodule lies in its multiple by that ideal.
* `AssociatedGraded.exists_eventual_degree_one_generators`: a Noetherian graded module has, for
  each graded submodule, a single finite family of degree-one scalars which above a uniform
  degree expresses every homogeneous element of the submodule in terms of the preceding degree.

## Implementation notes

A graded submodule is presented as a family of additive subgroups `P n ⊆ Bₙ` closed under the
graded action (`homogeneousSubmodule`), rather than as a submodule of the direct sum that
happens to be graded.  Both forms are needed: the family is what the geometric applications
produce, and the submodule is what Noetherianity is stated for.

## References

* [Stacks Project, Tag 0GYS](https://stacks.math.columbia.edu/tag/0GYS)
-/

@[expose] public section

open scoped DirectSum

universe u v

namespace AssociatedGraded

variable {A : Type u} [CommRing A]

/-- The class in degree `n` of an element of `Iⁿ`, as an element of the associated graded
ring `⨁ₖ Iᵏ/Iᵏ⁺¹`. -/
def classOfPow (I : Ideal A) (n : ℕ) : ↥(I ^ n) →+ gradedRing I where
  toFun a := DirectSum.of (fun j => piece (M := A) I j) n
    (mk I n ⟨a.1, by simpa only [ring_power_eq] using a.2⟩)
  map_zero' := by
    change DirectSum.of _ n (0 : piece (M := A) I n) = 0
    exact map_zero _
  map_add' a b := by
    rw [← map_add]
    rfl

/-- Multiplying the classes of `a ∈ Iⁱ` and `b ∈ Iʲ` gives the class of `a * b` in degree
`i + j`. -/
theorem classOfPow_mul (I : Ideal A) (i j : ℕ) (a : ↥(I ^ i)) (b : ↥(I ^ j)) :
    classOfPow I (i + j) ⟨a.1 * b.1, by simpa only [pow_add] using Ideal.mul_mem_mul a.2 b.2⟩ =
      classOfPow I i a * classOfPow I j b := by
  dsimp [classOfPow]
  rw [of_mul_of, homogeneousSMul_mk]
  rfl

private theorem mul_mem_right (I : Ideal A) (J : Ideal (gradedRing I))
    (a b : gradedRing I) (ha : a ∈ J) : a * b ∈ J := by
  rw [mul_comm a b]
  exact J.mul_mem_left b ha

/-- The positive part of the associated graded ring is generated in degree one: the class of an
element of `Iⁿ` with `n > 0` lies in the ideal generated by all degree-one classes. -/
theorem classOfPow_mem_span_degree_one (I : Ideal A) (n : ℕ) (hn : 0 < n) (a : ↥(I ^ n)) :
    classOfPow I n a ∈ Ideal.span (Set.range (classOfPow I 1)) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = 1 + k := ⟨n - 1, by omega⟩
  have h : ∀ (b : A) (hb : b ∈ I ^ 1 * I ^ k),
      classOfPow I (1 + k) ⟨b, by simpa only [pow_add] using hb⟩ ∈
        Ideal.span (Set.range (classOfPow I 1)) := by
    intro b hb
    induction hb using Submodule.mul_induction_on' with
    | mem_mul_mem x hx y hy =>
      rw [classOfPow_mul I 1 k ⟨x, hx⟩ ⟨y, hy⟩]
      exact mul_mem_right I _ _ _ (Submodule.subset_span (Set.mem_range_self _))
    | add x hx y hy ihx ihy =>
      show classOfPow I (1 + k)
        ((⟨x, by simpa only [pow_add] using hx⟩ : ↥(I ^ (1 + k))) +
          ⟨y, by simpa only [pow_add] using hy⟩) ∈ _
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
  exact h a.1 (by simpa only [← pow_add] using a.2)

/-- The degree-`n` homogeneous part of an element of a direct sum, viewed again as an element of
the direct sum. -/
def homogeneousPart (B : ℕ → Type v) [∀ n, AddCommGroup (B n)] (n : ℕ) :
    (⨁ j, B j) →+ (⨁ j, B j) :=
  (DirectSum.of B n).comp (DFinsupp.evalAddMonoidHom n)

/-- The degree-`n` homogeneous part of a homogeneous element of degree `j` is the element itself
when `j = n`, and zero otherwise. -/
theorem homogeneousPart_of (B : ℕ → Type v) [∀ n, AddCommGroup (B n)] (n j : ℕ) (x : B j) :
    homogeneousPart B n (DirectSum.of B j x) =
      if j = n then DirectSum.of B j x else 0 := by
  by_cases h : j = n
  · subst j
    show DirectSum.of B n ((DirectSum.of B n x) n) = _
    simp
  · show DirectSum.of B n ((DirectSum.of B j x) n) = _
    simp [DirectSum.of_apply, h]

/-- The homogeneous part of a homogeneous element in its own degree is the element itself. -/
@[simp]
theorem homogeneousPart_of_self (B : ℕ → Type v) [∀ n, AddCommGroup (B n)] (n : ℕ) (x : B n) :
    homogeneousPart B n (DirectSum.of B n x) = DirectSum.of B n x := by
  show DirectSum.of B n ((DirectSum.of B n x) n) = _
  simp

/-- **Homogeneous parts of a degree-`k` scalar multiple.** If `s` raises the degree of every
homogeneous element by `k`, then the degree-`k + n` part of `s • x` is `s` times the degree-`n`
part of `x`. -/
theorem homogeneousPart_smul_of {R : Type u} [Semiring R] {B : ℕ → Type v}
    [∀ n, AddCommGroup (B n)] [Module R (⨁ j, B j)] (s : R) (k : ℕ)
    (hs : ∀ j (x : B j), ∃ y : B (k + j), s • DirectSum.of B j x = DirectSum.of B (k + j) y)
    (n : ℕ) (x : ⨁ j, B j) :
    homogeneousPart B (k + n) (s • x) = s • homogeneousPart B n x := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | add x y hx hy => simp [smul_add, hx, hy]
  | of j x =>
    obtain ⟨y, hy⟩ := hs j x
    by_cases hj : j = n
    · subst j
      rw [hy, homogeneousPart_of, homogeneousPart_of]
      simp [hy]
    · rw [hy, homogeneousPart_of, homogeneousPart_of]
      simp [hj]

/-- If `s` raises the degree of every homogeneous element by `k`, then `s • x` has no
homogeneous part in any degree `n < k`. -/
theorem homogeneousPart_smul_of_lt {R : Type u} [Semiring R] {B : ℕ → Type v}
    [∀ n, AddCommGroup (B n)] [Module R (⨁ j, B j)] (s : R) (k : ℕ)
    (hs : ∀ j (x : B j), ∃ y : B (k + j), s • DirectSum.of B j x = DirectSum.of B (k + j) y)
    (n : ℕ) (hn : n < k) (x : ⨁ j, B j) : homogeneousPart B n (s • x) = 0 := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | add x y hx hy => simp [smul_add, hx, hy]
  | of j x =>
    obtain ⟨y, hy⟩ := hs j x
    rw [hy, homogeneousPart_of]
    exact ite_eq_right_iff.mpr fun hj => absurd hj (by omega)

/-- `Ideal.span T • N` is the supremum of the `Ideal.span {x} • N` over `x ∈ T`. -/
private theorem ideal_span_smul_eq_iSup {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] (T : Set R) (N : Submodule R M) :
    Ideal.span T • N = ⨆ x ∈ T, Ideal.span {x} • N := by
  rw [show Ideal.span T = ⨆ x ∈ T, Ideal.span {x} from
    Submodule.span_eq_iSup_of_singleton_spans T]
  simp only [Submodule.iSup_smul]

/-- **A finitely generated `Ideal.span s • N` is already `Ideal.span t • N` for a finite
`t ⊆ s`.** The submodule is a compact element of the lattice, and `Ideal.span s • N` is the
supremum of the `Ideal.span {x} • N` over `x ∈ s`. -/
public theorem exists_finset_ideal_span_smul_eq {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] (s : Set R) (N : Submodule R M)
    (hfg : (Ideal.span s • N).FG) :
    ∃ t : Finset R, ↑t ⊆ s ∧ Ideal.span s • N = Ideal.span (↑t : Set R) • N := by
  classical
  have heq : Ideal.span s • N = ⨆ x : s, Ideal.span {x.1} • N := by
    rw [ideal_span_smul_eq_iSup, ← iSup_subtype'' s (fun x => Ideal.span {x} • N)]
  obtain ⟨t, ht⟩ := IsCompactElement.exists_finset_of_le_iSup
    ((Submodule.fg_iff_compact _).mp hfg) (fun x : s => Ideal.span {x.1} • N) heq.le
  refine ⟨t.image Subtype.val, ?_, le_antisymm ?_ ?_⟩
  · simp only [Finset.coe_image, Set.image_subset_iff]
    exact fun x _ => x.2
  · refine ht.trans <| iSup_le fun x => iSup_le fun hx => ?_
    exact Submodule.smul_mono
      (Submodule.span_mono (Set.singleton_subset_iff.mpr
        (Finset.mem_image.mpr ⟨x, hx, rfl⟩))) le_rfl
  · apply Submodule.smul_mono (Submodule.span_mono ?_) le_rfl
    simp only [Finset.coe_image, Set.image_subset_iff]
    exact fun x _ => x.2

/-- Above a uniform degree, every homogeneous part of an element of a finitely generated graded
submodule lies in the multiple of that submodule by the ideal of degree-one classes. -/
theorem homogeneousPart_mem_span_degree_one_smul (I : Ideal A) {B : ℕ → Type v}
    [∀ n, AddCommGroup (B n)] [Module (gradedRing I) (⨁ j, B j)]
    (hgraded : ∀ k (a : ↥(I ^ k)) j (x : B j), ∃ y : B (k + j),
      classOfPow I k a • DirectSum.of B j x = DirectSum.of B (k + j) y)
    (E : Submodule (gradedRing I) (⨁ j, B j)) (hE : E.FG)
    (hhom : ∀ n x, x ∈ E → homogeneousPart B n x ∈ E) :
    ∃ c : ℕ, ∀ n, c < n → ∀ x, x ∈ E →
      homogeneousPart B n x ∈ Ideal.span (Set.range (classOfPow I 1)) • E := by
  classical
  obtain ⟨s, hs⟩ := hE
  let c := (s.biUnion DFinsupp.support).sup id
  let J := Ideal.span (Set.range (classOfPow I 1))
  refine ⟨c, ?_⟩
  have hsupp (x : ⨁ j, B j) (hx : x ∈ s) (n : ℕ) (hn : c < n) :
      homogeneousPart B n x = 0 := by
    have hnot : n ∉ x.support := fun h =>
      (not_le_of_gt hn) (Finset.le_sup (f := id) (Finset.mem_biUnion.mpr ⟨x, hx, h⟩))
    have hz : x n = 0 := by simpa only [DFinsupp.mem_support_toFun, not_not] using hnot
    show DirectSum.of B n (x n) = 0
    rw [hz, map_zero]
  have hmul (a : gradedRing I) (x : ⨁ j, B j) (hx : x ∈ E)
      (hlarge : ∀ n, c < n → homogeneousPart B n x ∈ J • E) :
      ∀ n, c < n → homogeneousPart B n (a • x) ∈ J • E := by
    induction a using DirectSum.induction_on with
    | zero =>
      intro n _
      rw [show (0 : gradedRing I) • x = 0 from Module.zero_smul x, map_zero]
      exact Submodule.zero_mem _
    | add a b ha hb =>
      intro n hn
      rw [add_smul (a : gradedRing I) b x, map_add]
      exact Submodule.add_mem _ (ha n hn) (hb n hn)
    | of k a =>
      induction a using Quotient.inductionOn with
      | _ a =>
        let a' : ↥(I ^ k) := ⟨a.1, by simpa only [ring_power_eq] using a.2⟩
        show ∀ n, c < n → homogeneousPart B n (classOfPow I k a' • x) ∈ J • E
        intro n hn
        by_cases hk : k = 0
        · subst k
          rw [show homogeneousPart B n (classOfPow I 0 a' • x) =
            classOfPow I 0 a' • homogeneousPart B n x by
              simpa only [zero_add] using
                homogeneousPart_smul_of (classOfPow I 0 a') 0 (hgraded 0 a') n x]
          exact (J • E).smul_mem _ (hlarge n hn)
        · by_cases hkn : k ≤ n
          · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkn
            rw [homogeneousPart_smul_of _ k (hgraded k a')]
            exact Submodule.smul_mem_smul
              (classOfPow_mem_span_degree_one I k (Nat.pos_of_ne_zero hk) a') (hhom d x hx)
          · rw [homogeneousPart_smul_of_lt _ k (hgraded k a') n (Nat.lt_of_not_ge hkn)]
            exact Submodule.zero_mem _
  intro n hn x hx
  rw [← hs] at hx
  have h : ∀ m, c < m → homogeneousPart B m x ∈ J • E := by
    induction hx using Submodule.span_induction with
    | mem x hx =>
      intro m hm
      rw [hsupp x hx m hm]
      exact Submodule.zero_mem _
    | zero => simp
    | add x y _ _ ihx ihy =>
      intro m hm
      rw [map_add]
      exact Submodule.add_mem _ (ihx m hm) (ihy m hm)
    | smul a x hx ih => exact hmul a x (hs ▸ hx) ih
  exact h n hn

/-- A Noetherian graded module over the associated graded ring is, above a uniform degree,
generated from the preceding degree by one fixed finite family of degree-one scalars. -/
theorem exists_eventual_degree_one_generators (I : Ideal A) {B : ℕ → Type v}
    [∀ n, AddCommGroup (B n)] [Module (gradedRing I) (⨁ j, B j)]
    [IsNoetherian (gradedRing I) (⨁ j, B j)]
    (hgraded : ∀ k (a : ↥(I ^ k)) j (x : B j), ∃ y : B (k + j),
      classOfPow I k a • DirectSum.of B j x = DirectSum.of B (k + j) y)
    (E : Submodule (gradedRing I) (⨁ j, B j))
    (hhom : ∀ n x, x ∈ E → homogeneousPart B n x ∈ E) :
    ∃ (s : Finset (gradedRing I)) (a : s → ↥(I ^ 1)) (c : ℕ),
      ∀ n, c ≤ n → ∀ x : B (n + 1), DirectSum.of B (n + 1) x ∈ E →
        ∃ y : s → B n, (∀ i, DirectSum.of B n (y i) ∈ E) ∧
          DirectSum.of B (n + 1) x =
            ∑ i, classOfPow I 1 (a i) • DirectSum.of B n (y i) := by
  classical
  let J := Ideal.span (Set.range (classOfPow I 1))
  obtain ⟨c, hc⟩ := homogeneousPart_mem_span_degree_one_smul I hgraded E
    (IsNoetherian.noetherian E) hhom
  obtain ⟨s, hs, heq⟩ := exists_finset_ideal_span_smul_eq
    (Set.range (classOfPow I 1)) E (IsNoetherian.noetherian (J • E))
  have hrepr : ∀ i : s, ∃ a : ↥(I ^ 1), classOfPow I 1 a = i.1 := fun i => hs i.2
  choose a ha using hrepr
  refine ⟨s, a, c, ?_⟩
  intro n hn x hx
  have hxJ : DirectSum.of B (n + 1) x ∈ Ideal.span (↑s : Set (gradedRing I)) • E := by
    rw [← heq]
    simpa only [homogeneousPart_of_self] using hc (n + 1) (by omega) _ hx
  rw [ideal_span_smul_eq_iSup] at hxJ
  obtain ⟨μ, hμ⟩ := (Submodule.mem_iSup_finset_iff_exists_sum
    (fun y => Ideal.span {y} • E) _).mp hxJ
  have : SMulCommClass (gradedRing I) (gradedRing I) (⨁ j, B j) :=
    ⟨fun b d x => by rw [smul_smul, smul_smul, mul_comm b d]⟩
  have hμ' (b : gradedRing I) : ∃ y ∈ E, b • y = (μ b).1 := by
    apply (Submodule.mem_smul_pointwise_iff_exists _ b E).mp
    simpa only [Submodule.ideal_span_singleton_smul b E] using (μ b).2
  choose y hy hyμ using hμ'
  refine ⟨fun i => y i.1 n, fun i => hhom n (y i.1) (hy i.1), ?_⟩
  have hsum : (∑ i : s, (μ i.1).1) = DirectSum.of B (n + 1) x :=
    (Finset.sum_coe_sort s (fun b => (μ b).1)).trans hμ
  have hproj := congrArg (homogeneousPart B (n + 1)) hsum
  rw [map_sum, homogeneousPart_of_self] at hproj
  rw [← hproj]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← hyμ i.1, ha i]
  have he := homogeneousPart_smul_of (classOfPow I 1 (a i)) 1 (hgraded 1 (a i)) n (y i.1)
  change homogeneousPart B (1 + n) (classOfPow I 1 (a i) • y i.1) =
    classOfPow I 1 (a i) • DirectSum.of B n (y i.1 n) at he
  simpa only [Nat.add_comm 1 n, ha i] using he

/-- A degreewise family of subgroups closed under the graded action, as a submodule of the
direct sum. -/
def homogeneousSubmodule (I : Ideal A) {B : ℕ → Type v} [∀ n, AddCommGroup (B n)]
    [Module (gradedRing I) (⨁ j, B j)] (P : ∀ n, AddSubgroup (B n))
    (hP : ∀ k (a : ↥(I ^ k)) n (x : B n), x ∈ P n →
      ∃ y : B (k + n), y ∈ P (k + n) ∧
        classOfPow I k a • DirectSum.of B n x = DirectSum.of B (k + n) y) :
    Submodule (gradedRing I) (⨁ j, B j) := by
  classical
  let E : AddSubgroup (⨁ j, B j) :=
    { carrier := {x | ∀ n, x n ∈ P n}
      zero_mem' := fun n => (P n).zero_mem
      add_mem' := fun hx hy n => (P n).add_mem (hx n) (hy n)
      neg_mem' := fun hx n => (P n).neg_mem (hx n) }
  have hof (n : ℕ) (x : B n) (hx : x ∈ P n) : DirectSum.of B n x ∈ E := by
    intro m
    by_cases h : n = m
    · subst m
      simpa only [DirectSum.of_eq_same] using hx
    · simpa only [DirectSum.of_eq_of_ne _ _ _ (Ne.symm h)] using (P m).zero_mem
  refine { E with smul_mem' := ?_ }
  intro b x hx
  induction b using DirectSum.induction_on with
  | zero =>
    rw [show (0 : gradedRing I) • x = 0 from Module.zero_smul x]
    exact E.zero_mem
  | add b d hb hd =>
    change (b + d : gradedRing I) • x ∈ E
    rw [add_smul]
    exact E.add_mem hb hd
  | of k a =>
    induction a using Quotient.inductionOn with
    | _ a =>
      let a' : ↥(I ^ k) := ⟨a.1, by simpa only [ring_power_eq] using a.2⟩
      change classOfPow I k a' • x ∈ E
      have he : (∑ n ∈ x.support, DirectSum.of B n (x n)) = x := DFinsupp.sum_single
      rw [← he, Finset.smul_sum]
      refine E.sum_mem fun n _ => ?_
      obtain ⟨y, hy, hxy⟩ := hP k a' n (x n) (hx n)
      rw [hxy]
      exact hof _ _ hy

/-- An element lies in `AssociatedGraded.homogeneousSubmodule` exactly when each of its
components lies in the subgroup of its degree. -/
theorem mem_homogeneousSubmodule (I : Ideal A) {B : ℕ → Type v} [∀ n, AddCommGroup (B n)]
    [Module (gradedRing I) (⨁ j, B j)] (P : ∀ n, AddSubgroup (B n))
    (hP : ∀ k (a : ↥(I ^ k)) n (x : B n), x ∈ P n →
      ∃ y : B (k + n), y ∈ P (k + n) ∧
        classOfPow I k a • DirectSum.of B n x = DirectSum.of B (k + n) y)
    (x : ⨁ n, B n) : x ∈ homogeneousSubmodule I P hP ↔ ∀ n, x n ∈ P n := Iff.rfl

/-- A homogeneous element of degree `n` lies in `AssociatedGraded.homogeneousSubmodule` exactly
when it lies in the degree-`n` subgroup. -/
theorem of_mem_homogeneousSubmodule_iff (I : Ideal A) {B : ℕ → Type v}
    [∀ n, AddCommGroup (B n)] [Module (gradedRing I) (⨁ j, B j)] (P : ∀ n, AddSubgroup (B n))
    (hP : ∀ k (a : ↥(I ^ k)) n (x : B n), x ∈ P n →
      ∃ y : B (k + n), y ∈ P (k + n) ∧
        classOfPow I k a • DirectSum.of B n x = DirectSum.of B (k + n) y)
    (n : ℕ) (x : B n) :
    DirectSum.of B n x ∈ homogeneousSubmodule I P hP ↔ x ∈ P n := by
  rw [mem_homogeneousSubmodule]
  refine ⟨fun h => by simpa only [DirectSum.of_eq_same] using h n, fun hx m => ?_⟩
  by_cases h : n = m
  · subst m
    simpa only [DirectSum.of_eq_same] using hx
  · simpa only [DirectSum.of_eq_of_ne _ _ _ (Ne.symm h)] using (P m).zero_mem

end AssociatedGraded

end
