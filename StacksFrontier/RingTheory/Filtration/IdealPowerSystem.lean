module

public import Mathlib.RingTheory.Ideal.Operations

/-!
# Uniform bounds for a system of modules graded by powers of an ideal

Let `R` be a commutative ring and `I ⊂ R` an ideal. An `IdealPowerSystem` packages an inverse
system of `R`-modules `M 0 ← M 1 ← M 2 ← ⋯` sitting over a fixed module `M₀`, together with
multiplication maps `I ^ k ⊗ M n → M (k + n)` compatible with the transition maps. The motivating
example is `M n = Hᵖ(X, Iⁿ F)` over `M₀ = Hᵖ(X, F)` for a proper morphism `X → Spec A`, where the
multiplication maps make `⨁ₙ M n` a graded module over the Rees algebra `⨁ₙ Iⁿ`.

The main result `IdealPowerSystem.exists_uniform_bound` is the purely algebraic core of
[Stacks, Tag 02OA]: if every graded subobject of the system is finitely generated by homogeneous
elements, then one single constant `c` controls both the image of `M r → M₀` and the kernels of
the maps out of `M k`.

## Main definitions

* `Stacks.RingTheory.IdealPowerSystem` is the system of modules with its ideal-power
  multiplication.
* `Stacks.RingTheory.IdealPowerSystem.genSubmodule` is the degree-`n` part of the graded
  subobject generated by finitely many homogeneous elements.
* `Stacks.RingTheory.IdealPowerSystem.Subsystem` is a graded subobject of the system.
* `Stacks.RingTheory.IdealPowerSystem.IsNoetherianSystem` says every graded subobject is
  finitely generated by homogeneous elements.

## Main results

* `Stacks.RingTheory.IdealPowerSystem.range_proj_le`: the image of `M r → M₀` lies in
  `I ^ (r - c) M₀`, where `c` bounds the degrees of a homogeneous generating family of the whole
  system. This is part (2) of [Stacks, Tag 02OA] in the case `n = 0` of that statement.
* `Stacks.RingTheory.IdealPowerSystem.ker_proj_eq_ker_tr`: the kernel of `M k → M₀` is already
  the kernel of `M k → M m` whenever `m + c ≤ k`, where `c` bounds the degrees of a homogeneous
  generating family of the kernel subobject. This is part (3) of [Stacks, Tag 02OA].
* `Stacks.RingTheory.IdealPowerSystem.exists_uniform_bound`: one constant serves both, obtained
  from `IsNoetherianSystem`.

## Implementation notes

The transition maps are indexed by `m ≤ n`, so composability is a single field `tr_tr` and no
coherence beyond it is needed; no identity law is assumed, because none is used.

The field `tr_mul_of_proj_eq_zero` is the displayed consequence `Iⁿ · y ⊂ Ker(M (n + d) → M n)`
for `y ∈ Ker(M d → M₀)` that the source extracts from the compatibility of the multiplication
maps with the transition maps. Assuming only this consequence keeps the hypothesis minimal.

`genSubmodule` uses truncated subtraction, so for `n` below the degree of a generator the
corresponding summand is a span of transported multiples by `I ^ 0 = R` rather than being
absent. This only enlarges the generated subobject, hence weakens the generation hypothesis;
the results below are used at degrees exceeding every generator degree, where the truncation is
inactive.

A `Subsystem` is required to be closed under multiplication by powers of `I` but not under the
transition maps; the kernel subobject `kerSubsystem`, which is the one the source uses, is in
fact closed under both, but only multiplicative closure enters the argument.

## References

* [Stacks Project, Tag 02OA](https://stacks.math.columbia.edu/tag/02OA)
-/

@[expose] public section

universe u v w

namespace Stacks.RingTheory

variable {R : Type u} [CommRing R] (I : Ideal R)
  (M : ℕ → Type v) [∀ n, AddCommGroup (M n)] [∀ n, Module R (M n)]
  (M₀ : Type w) [AddCommGroup M₀] [Module R M₀]

/-- An inverse system of `R`-modules `M 0 ← M 1 ← ⋯` over a module `M₀`, with multiplication
maps `I ^ k ⊗ M n → M (k + n)` compatible with the projections to `M₀`.

This is the structure carried by `n ↦ Hᵖ(X, Iⁿ F)` over `Hᵖ(X, F)` in [Stacks, Tag 02OA]. -/
structure IdealPowerSystem where
  /-- The transition map `M n → M m` for `m ≤ n`. -/
  tr : ∀ ⦃m n : ℕ⦄, m ≤ n → M n →ₗ[R] M m
  /-- The transition maps compose. -/
  tr_tr : ∀ {l m n : ℕ} (h₁ : l ≤ m) (h₂ : m ≤ n) (x : M n),
    tr h₁ (tr h₂ x) = tr (h₁.trans h₂) x
  /-- The projection `M n → M₀`. -/
  proj : ∀ n : ℕ, M n →ₗ[R] M₀
  /-- The projections to `M₀` are compatible with the transition maps. -/
  proj_tr : ∀ {m n : ℕ} (h : m ≤ n) (x : M n), proj m (tr h x) = proj n x
  /-- Multiplication `I ^ k ⊗ M n → M (k + n)`. -/
  mul : ∀ k n : ℕ, ↥(I ^ k) →ₗ[R] M n →ₗ[R] M (k + n)
  /-- On `M₀` the multiplication maps become the module structure. -/
  proj_mul : ∀ (k n : ℕ) (a : ↥(I ^ k)) (x : M n),
    proj (k + n) (mul k n a x) = (a : R) • proj n x
  /-- A multiple of an element killed by `proj` is killed by the transition map that drops the
  element's own degree. -/
  tr_mul_of_proj_eq_zero : ∀ (k n : ℕ) (a : ↥(I ^ k)) (x : M n), proj n x = 0 →
    tr (Nat.le_add_right k n) (mul k n a x) = 0

namespace IdealPowerSystem

variable {I M M₀} (S : IdealPowerSystem I M M₀)

/-- The degree-`n` part of the graded subobject generated by homogeneous elements `x i` of
degrees `d i`: the span of the transported multiples `I ^ (n - d i) · x i`. -/
def genSubmodule {t : ℕ} (d : Fin t → ℕ) (x : ∀ i, M (d i)) (n : ℕ) : Submodule R (M n) :=
  ⨆ i : Fin t, Submodule.span R
    (Set.range fun a : ↥(I ^ (n - d i)) ↦
      S.tr (show n ≤ (n - d i) + d i by omega) (S.mul (n - d i) (d i) a (x i)))

/-- A graded subobject of the system: a family of submodules closed under multiplication by
powers of `I`. -/
structure Subsystem where
  /-- The submodule in each degree. -/
  N : ∀ n : ℕ, Submodule R (M n)
  /-- The family is closed under multiplication by powers of `I`. -/
  mul_mem : ∀ (k n : ℕ) (a : ↥(I ^ k)) {x : M n}, x ∈ N n → S.mul k n a x ∈ N (k + n)

/-- A graded subobject is finitely generated when finitely many of its homogeneous elements
generate it in every degree. -/
def Subsystem.FG (T : S.Subsystem) : Prop :=
  ∃ (t : ℕ) (d : Fin t → ℕ) (x : ∀ i, M (d i)),
    (∀ i, x i ∈ T.N (d i)) ∧ ∀ n, T.N n ≤ S.genSubmodule d x n

/-- The system is Noetherian when every graded subobject is finitely generated by homogeneous
elements.

For `n ↦ Hᵖ(X, Iⁿ F)` this is [Stacks, Tag 02O8] — finiteness of `⨁ₙ Hᵖ(X, Iⁿ F)` over the Rees
algebra `⨁ₙ Iⁿ` — together with the Noetherianity of that Rees algebra, which upgrades
finiteness of the module to finiteness of each of its graded submodules. -/
def IsNoetherianSystem : Prop := ∀ T : S.Subsystem, T.FG

/-- The whole system, as a graded subobject. -/
def topSubsystem : S.Subsystem where
  N _ := ⊤
  mul_mem := by intros; exact Submodule.mem_top

/-- The kernels of the projections to `M₀`, as a graded subobject. -/
def kerSubsystem : S.Subsystem where
  N n := LinearMap.ker (S.proj n)
  mul_mem := by
    intro k n a x hx
    simp only [LinearMap.mem_ker] at hx ⊢
    rw [S.proj_mul, hx, smul_zero]

/-- A multiple of an element killed by `proj` is killed by every transition map that drops at
least the element's own degree. -/
theorem tr_mul_eq_zero_of_le {k n m : ℕ} (hm : m ≤ k) (a : ↥(I ^ k)) (x : M n)
    (hx : S.proj n x = 0) (h : m ≤ k + n) :
    S.tr h (S.mul k n a x) = 0 := by
  rw [← S.tr_tr hm (Nat.le_add_right k n), S.tr_mul_of_proj_eq_zero k n a x hx, map_zero]

/-- The two-step form of `tr_mul_eq_zero_of_le`, as it appears after composing the transition
map used in `genSubmodule` with a further one. -/
theorem tr_tr_mul_eq_zero {k n m j : ℕ} (hm : m ≤ k) (h₁ : m ≤ j) (h₂ : j ≤ k + n)
    (a : ↥(I ^ k)) (x : M n) (hx : S.proj n x = 0) :
    S.tr h₁ (S.tr h₂ (S.mul k n a x)) = 0 := by
  rw [S.tr_tr]
  exact S.tr_mul_eq_zero_of_le hm a x hx _

/-- The zero system: all modules trivial and all maps zero. -/
def trivialSystem (J : Ideal R) : IdealPowerSystem J (fun _ : ℕ ↦ PUnit.{v + 1})
    PUnit.{w + 1} where
  tr := fun {_ _} _ ↦ 0
  tr_tr _ _ _ := Subsingleton.elim _ _
  proj _ := 0
  proj_tr _ _ := Subsingleton.elim _ _
  mul _ _ := 0
  proj_mul _ _ _ _ := Subsingleton.elim _ _
  tr_mul_of_proj_eq_zero _ _ _ _ _ := Subsingleton.elim _ _

/-- The zero system is Noetherian. This witnesses that `IsNoetherianSystem` is consistent, so
the results below are not vacuous for want of a model. -/
theorem trivialSystem_isNoetherianSystem (J : Ideal R) :
    (trivialSystem J : IdealPowerSystem J (fun _ : ℕ ↦ PUnit.{v + 1})
      PUnit.{w + 1}).IsNoetherianSystem := by
  intro T
  refine ⟨0, Fin.elim0, fun i ↦ i.elim0, fun i ↦ i.elim0, fun n x _ ↦ ?_⟩
  rw [Subsingleton.elim x 0]
  exact Submodule.zero_mem _

/-- Part (2) of [Stacks, Tag 02OA] at degree `0`: if homogeneous elements of degrees at most `c`
generate the whole system, then the image of `M r → M₀` lies in `I ^ (r - c) M₀` for `r ≥ c`. -/
theorem range_proj_le {t : ℕ} {d : Fin t → ℕ} {x : ∀ i, M (d i)} {c : ℕ}
    (hgen : ∀ n, (⊤ : Submodule R (M n)) ≤ S.genSubmodule d x n) (hc : ∀ i, d i ≤ c)
    (r : ℕ) (hr : c ≤ r) :
    LinearMap.range (S.proj r) ≤ I ^ (r - c) • (⊤ : Submodule R M₀) := by
  have key : S.genSubmodule d x r ≤
      Submodule.comap (S.proj r) (I ^ (r - c) • (⊤ : Submodule R M₀)) := by
    refine iSup_le fun i ↦ Submodule.span_le.2 ?_
    rintro _ ⟨a, rfl⟩
    have hmem : (a : R) • S.proj (d i) (x i) ∈ I ^ (r - d i) • (⊤ : Submodule R M₀) :=
      Submodule.smul_mem_smul a.2 Submodule.mem_top
    have hle : I ^ (r - d i) ≤ I ^ (r - c) :=
      Ideal.pow_le_pow_right (by have := hc i; omega)
    simp only [SetLike.mem_coe, Submodule.mem_comap, S.proj_tr, S.proj_mul]
    exact Submodule.smul_mono_left hle hmem
  rintro y ⟨z, rfl⟩
  have hz : z ∈ S.genSubmodule d x r := hgen r Submodule.mem_top
  exact Submodule.mem_comap.mp (key hz)

/-- Part (3) of [Stacks, Tag 02OA]: if homogeneous elements of degrees at most `c`, each killed
by the projection to `M₀`, generate the kernel subobject, then the kernel of `M k → M₀` is
already the kernel of `M k → M m` whenever `m + c ≤ k`. -/
theorem ker_proj_eq_ker_tr {t : ℕ} {d : Fin t → ℕ} {y : ∀ i, M (d i)} {c : ℕ}
    (hy : ∀ i, S.proj (d i) (y i) = 0)
    (hgen : ∀ n, LinearMap.ker (S.proj n) ≤ S.genSubmodule d y n) (hc : ∀ i, d i ≤ c)
    (m k : ℕ) (hmk : m + c ≤ k) :
    LinearMap.ker (S.proj k) =
      LinearMap.ker (S.tr (show m ≤ k from le_trans (Nat.le_add_right m c) hmk)) := by
  have hmle : m ≤ k := le_trans (Nat.le_add_right m c) hmk
  refine le_antisymm (le_trans (hgen k) (iSup_le fun i ↦ ?_)) fun z hz ↦ ?_
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨a, rfl⟩
    have hmd : m ≤ k - d i := by have := hc i; omega
    simp only [SetLike.mem_coe, LinearMap.mem_ker]
    exact S.tr_tr_mul_eq_zero hmd hmle _ a (y i) (hy i)
  · simp only [LinearMap.mem_ker] at hz ⊢
    rw [← S.proj_tr hmle z, hz, map_zero]

/-- The algebraic core of [Stacks, Tag 02OA]: in a Noetherian ideal-power system one constant `c`
bounds both the image of `M r → M₀` and the kernels of the maps out of `M k`. -/
theorem exists_uniform_bound (hS : S.IsNoetherianSystem) :
    ∃ c : ℕ,
      (∀ r, c ≤ r → LinearMap.range (S.proj r) ≤ I ^ (r - c) • (⊤ : Submodule R M₀)) ∧
      (∀ (m k : ℕ) (hmk : m + c ≤ k), LinearMap.ker (S.proj k) =
        LinearMap.ker (S.tr (show m ≤ k from le_trans (Nat.le_add_right m c) hmk))) := by
  obtain ⟨t₁, d₁, x, -, hgen₁⟩ := hS S.topSubsystem
  obtain ⟨t₂, d₂, y, hy, hgen₂⟩ := hS S.kerSubsystem
  refine ⟨max (Finset.univ.sup d₁) (Finset.univ.sup d₂), fun r hr ↦ ?_, fun m k hmk ↦ ?_⟩
  · exact S.range_proj_le hgen₁
      (fun i ↦ le_trans (Finset.le_sup (Finset.mem_univ i)) (le_max_left _ _)) r hr
  · exact S.ker_proj_eq_ker_tr hy
      hgen₂ (fun i ↦ le_trans (Finset.le_sup (Finset.mem_univ i)) (le_max_right _ _)) m k hmk

end IdealPowerSystem

end Stacks.RingTheory

end
