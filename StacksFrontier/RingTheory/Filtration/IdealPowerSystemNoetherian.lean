module

public import Mathlib.Algebra.Module.GradedModule
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesGrading
public import StacksFrontier.RingTheory.Filtration.IdealPowerSystem
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Noetherianity of an ideal-power system from finiteness over the Rees algebra

The Artin–Rees argument of [Stacks, Tag 02OA], carried out in
`Stacks.RingTheory.IdealPowerSystem.exists_uniform_bound`, consumes
`IdealPowerSystem.IsNoetherianSystem`: *every* graded subobject of the system
`M 0 ← M 1 ← M 2 ← ⋯` is generated by finitely many homogeneous elements. The source's actual
input is weaker — it is [Stacks, Tag 02O8], the statement that the graded module `⨁ₙ Mₙ` is a
*finite* module over the Rees algebra `⨁ₙ Iⁿ`. This file closes the gap between the two: the
upgrade from finiteness to Noetherianity of all graded subobjects is a theorem, because the
Rees algebra of an ideal of a Noetherian ring is a Noetherian ring.

The development has two layers. The first is pure graded algebra: for a graded ring `⨁ₙ Aₙ`
that is Noetherian and a graded module `⨁ₙ Mₙ` finite over it, every graded submodule is
generated by finitely many homogeneous elements, with coefficients read off degreewise
(`exists_homogeneous_generators`). The second specializes `Aₙ` to the homogeneous pieces of the
Rees algebra of an ideal `I` of `A`, whose Noetherianity is Mathlib's
`IsNoetherianRing (reesAlgebra I)` transported along the grading of
`StacksFrontier/AlgebraicGeometry/Blowup/ReesGrading.lean`, and concludes
`IsNoetherianSystem` (`ReesSystem.isNoetherianSystem_of_isReesFinite`).

## Main definitions

* `Stacks.RingTheory.gradedSubmodule` turns a degreewise family of submodules closed under the
  graded action into a submodule of `⨁ₙ Mₙ` over `⨁ₙ Aₙ`.
* `Stacks.RingTheory.ReesSystem` is an `IdealPowerSystem` whose multiplication maps obey the
  graded-module laws over the Rees algebra of an ideal `I` of `A`, along a ring homomorphism
  `φ : A →+* R`.
* `Stacks.RingTheory.ReesSystem.IsReesFinite` is the finiteness input [Stacks, Tag 02O8]:
  `⨁ₙ Mₙ` is a finite module over `⨁ₙ Iⁿ`.

## Main results

* `Stacks.RingTheory.exists_homogeneous_generators`: a graded submodule of a finitely generated
  graded module over a Noetherian graded ring is generated by finitely many homogeneous
  elements.
* `Stacks.RingTheory.isNoetherianRing_reesGradingDirectSum`: `⨁ₙ Iⁿ` is a Noetherian ring when
  `A` is.
* `Stacks.RingTheory.ReesSystem.isNoetherianSystem_of_isReesFinite`: the finiteness input
  implies `IdealPowerSystem.IsNoetherianSystem`.

## Implementation notes

The ideal whose powers grade the acting ring lives in `A`, not in the ring `R` over which the
modules `Mₙ` are modules, and the two are related by a ring homomorphism `φ : A →+* R`. This is
forced by the application: in [Stacks, Tag 02OA] the modules are the cohomology modules
`Hᵖ(X, Iⁿ F)`, which are modules over the global sections of `X`, whereas the ring known to be
Noetherian — and whose Rees algebra therefore acts Noetherianly — is the base ring `A`. The
`IdealPowerSystem` structure is accordingly taken for the extended ideal `I.map φ`, while the
graded action is indexed by `Iᵏ` itself.

Three laws beyond those of `IdealPowerSystem` are needed to get a graded module: the transition
map between equal degrees is the identity, multiplication by a degree-zero element is the
module action, and the multiplication maps are associative. They are stated as equalities in
the sigma type `Σ n, M n`, which is how `GradedMonoid` states the graded-monoid laws and which
avoids transporting along index equalities by hand. None of them is a finiteness statement; all
hold for `n ↦ Hᵖ(X, Iⁿ F)` by functoriality and bilinearity.

Degreewise coefficients are extracted in the cast-free form
`of M n ((b • of M d y) n) = of M (m + d) (GSMul.smul (b m) y)` for `m + d = n`: both sides are
elements of `⨁ₙ Mₙ`, so no transport along `n - d + d = n` appears, and the degreewise
statement is recovered from injectivity of `DirectSum.of`.

The finite family of homogeneous generators is carried by a `List (Σ n, M n)` rather than a
`Finset`, because the modules `Mₙ` have no decidable equality.

## References

* [Stacks Project, Tag 02OA](https://stacks.math.columbia.edu/tag/02OA)
* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
-/

@[expose] public noncomputable section

open DirectSum Stacks.Blowup

universe u u' v w

namespace Stacks.RingTheory

/-! ### The external graded module over an external graded ring -/

section Graded

variable {A : ℕ → Type u} [∀ n, AddCommMonoid (A n)] [DirectSum.GSemiring A]
  {M : ℕ → Type v} [∀ n, AddCommMonoid (M n)] [DirectSum.Gmodule A M]

/-- The degree-`(m + d)` component of `b • y` for `y` homogeneous of degree `d`: only the
degree-`m` part of `b` contributes. -/
theorem smul_of_apply_add (b : ⨁ n, A n) {d : ℕ} (y : M d) (m : ℕ) :
    (b • of M d y) (m + d) = GradedMonoid.GSMul.smul (b m) y := by
  induction b using DirectSum.induction_on with
  | zero => simp [DirectSum.Gmodule.zero_smul]
  | of k a =>
      rw [DirectSum.Gmodule.of_smul_of]
      simp only [vadd_eq_add]
      by_cases hk : k = m
      · subst hk
        simp
      · rw [DirectSum.of_eq_of_ne _ _ _ (show m + d ≠ k + d by omega),
          DirectSum.of_eq_of_ne _ _ _ (Ne.symm hk), DirectSum.Gmodule.zero_smul]
  | add b₁ b₂ h₁ h₂ =>
      rw [add_smul, DirectSum.add_apply, h₁, h₂, DirectSum.add_apply,
        DirectSum.Gmodule.add_smul]

/-- The degree-`n` component of `b • y` vanishes for `y` homogeneous of degree `d > n`. -/
theorem smul_of_apply_of_lt (b : ⨁ n, A n) {d : ℕ} (y : M d) {n : ℕ} (hn : n < d) :
    (b • of M d y) n = 0 := by
  induction b using DirectSum.induction_on with
  | zero => simp
  | of k a =>
      rw [DirectSum.Gmodule.of_smul_of]
      simp only [vadd_eq_add]
      exact DirectSum.of_eq_of_ne _ _ _ (by omega)
  | add b₁ b₂ h₁ h₂ => rw [add_smul, DirectSum.add_apply, h₁, h₂, add_zero]

/-- The degree-`n` component of `b • y`, placed back in degree `n`, for `y` homogeneous of
degree `d` with `m + d = n`. -/
theorem of_smul_of_apply {b : ⨁ n, A n} {d m n : ℕ} (y : M d) (e : m + d = n) :
    of M n ((b • of M d y) n) = of M (m + d) (GradedMonoid.GSMul.smul (b m) y) := by
  subst e
  exact congrArg _ (smul_of_apply_add b y m)

end Graded

/-! ### Graded submodules of a finitely generated graded module -/

section Noetherian

variable {R : Type w} [CommRing R]
  {A : ℕ → Type u} [∀ n, AddCommGroup (A n)] [DirectSum.GRing A]
  {M : ℕ → Type v} [∀ n, AddCommGroup (M n)] [∀ n, Module R (M n)] [DirectSum.Gmodule A M]

/-- A degreewise family of submodules closed under the graded action, as a submodule of
`⨁ n, M n` over `⨁ n, A n`. -/
def gradedSubmodule (T : ∀ n, Submodule R (M n))
    (hT : ∀ (k n : ℕ) (a : A k) (y : M n), y ∈ T n → GradedMonoid.GSMul.smul a y ∈ T (k + n)) :
    Submodule (⨁ n, A n) (⨁ n, M n) where
  carrier := {w | ∀ n, w n ∈ T n}
  add_mem' hw hw' n := by
    rw [DirectSum.add_apply]
    exact Submodule.add_mem _ (hw n) (hw' n)
  zero_mem' n := by simp
  smul_mem' b w hw n := by
    classical
    rw [← DirectSum.sum_support_of w, Finset.smul_sum, DirectSum.sum_apply]
    refine Submodule.sum_mem _ fun m _ ↦ ?_
    by_cases hmn : m ≤ n
    · obtain ⟨k, rfl⟩ : ∃ k, n = k + m := ⟨n - m, by omega⟩
      rw [smul_of_apply_add]
      exact hT _ _ _ _ (hw m)
    · rw [smul_of_apply_of_lt _ _ (by omega)]
      exact Submodule.zero_mem _

/-- An element of `⨁ n, M n` lies in `gradedSubmodule T hT` if and only if each of its components
`w n` lies in `T n`. -/
@[simp]
theorem mem_gradedSubmodule {T : ∀ n, Submodule R (M n)} {hT} {w : ⨁ n, M n} :
    w ∈ gradedSubmodule (A := A) T hT ↔ ∀ n, w n ∈ T n := Iff.rfl

/-- **A graded submodule of a finitely generated graded module over a Noetherian graded ring is
generated by finitely many homogeneous elements.**

The family `T` is a degreewise family of submodules closed under the graded action, i.e. a
graded submodule. The conclusion exhibits finitely many homogeneous elements of `T`, of degrees
`d' i`, such that every element of `T n` is a sum of multiples of them by elements of
`A (n - d' i)`. -/
theorem exists_homogeneous_generators [IsNoetherianRing (⨁ n, A n)]
    [Module.Finite (⨁ n, A n) (⨁ n, M n)]
    (T : ∀ n, Submodule R (M n))
    (hT : ∀ (k n : ℕ) (a : A k) (y : M n), y ∈ T n → GradedMonoid.GSMul.smul a y ∈ T (k + n)) :
    ∃ (t' : ℕ) (d' : Fin t' → ℕ) (x' : ∀ i, M (d' i)),
      (∀ i, x' i ∈ T (d' i)) ∧
      ∀ (n : ℕ) (z : M n), z ∈ T n → ∃ c : (∀ i : Fin t', A (n - d' i)),
        (∀ i, n < d' i → c i = 0) ∧
        of M n z = ∑ i, of M (n - d' i + d' i) (GradedMonoid.GSMul.smul (c i) (x' i)) := by
  classical
  -- the module is Noetherian, so the graded submodule is finitely generated
  obtain ⟨t₀, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (IsNoetherian.noetherian (gradedSubmodule (A := A) T hT))
  have hgP : ∀ i, ∀ n, (g i) n ∈ T n := fun i ↦ by
    have : g i ∈ gradedSubmodule (A := A) T hT := by
      rw [← hg]
      exact Submodule.subset_span (Set.mem_range_self i)
    exact this
  -- split the generators into their homogeneous pieces
  set L : List (Σ m, M m) :=
    (List.finRange t₀).flatMap fun i ↦ (g i).support.toList.map fun m ↦ ⟨m, (g i) m⟩ with hL
  have hmemL : ∀ p ∈ L, p.2 ∈ T p.1 := by
    intro p hp
    rw [hL, List.mem_flatMap] at hp
    obtain ⟨i, -, hp⟩ := hp
    rw [List.mem_map] at hp
    obtain ⟨m, -, rfl⟩ := hp
    exact hgP i m
  have hofL : ∀ (i : Fin t₀) (m : ℕ), m ∈ (g i).support →
      ∃ j : Fin L.length, (L.get j).1 = m ∧ of M (L.get j).1 (L.get j).2 = of M m ((g i) m) := by
    intro i m hm
    have : (⟨m, (g i) m⟩ : Σ m, M m) ∈ L := by
      rw [hL, List.mem_flatMap]
      exact ⟨i, List.mem_finRange i, List.mem_map.2 ⟨m, Finset.mem_toList.2 hm, rfl⟩⟩
    obtain ⟨j, hj⟩ := List.mem_iff_get.1 this
    exact ⟨j, by rw [hj], by rw [hj]⟩
  refine ⟨L.length, fun j ↦ (L.get j).1, fun j ↦ (L.get j).2,
    fun j ↦ hmemL _ (List.get_mem L j), ?_⟩
  -- the homogeneous pieces generate the graded submodule
  have hspan : (gradedSubmodule (A := A) T hT) ≤ Submodule.span (⨁ n, A n)
      (Set.range fun j : Fin L.length ↦ of M (L.get j).1 (L.get j).2) := by
    rw [← hg]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    rw [← DirectSum.sum_support_of (g i)]
    refine Submodule.sum_mem _ fun m hm ↦ ?_
    obtain ⟨j, -, hj⟩ := hofL i m hm
    exact hj ▸ Submodule.subset_span (Set.mem_range_self j)
  -- read off the coefficients degreewise
  intro n z hz
  have hzP : of M n z ∈ gradedSubmodule (A := A) T hT := by
    intro k
    by_cases hk : k = n
    · subst hk
      rw [DirectSum.of_eq_same]
      exact hz
    · rw [DirectSum.of_eq_of_ne _ _ _ hk]
      exact Submodule.zero_mem _
  obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun (⨁ n, A n)).1 (hspan hzP)
  refine ⟨fun j ↦ if n < (L.get j).1 then 0 else (b j) (n - (L.get j).1),
    fun j hj ↦ ite_eq_left hj, ?_⟩
  have key := congrArg (fun w : ⨁ n, M n ↦ of M n (w n)) hb
  simp only [DirectSum.sum_apply, DirectSum.of_eq_same] at key
  rw [← key, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  dsimp only
  by_cases hj : n < (L.get j).1
  · rw [smul_of_apply_of_lt _ _ hj]
    simp only [hj, ite_true, DirectSum.Gmodule.zero_smul, map_zero]
  · rw [of_smul_of_apply _ (show n - (L.get j).1 + (L.get j).1 = n by omega)]
    simp only [hj, ite_false]

end Noetherian

/-! ### Ideal-power systems that are graded modules over the Rees algebra -/

section Rees

variable {A : Type u'} [CommRing A] {R : Type u} [CommRing R] {φ : A →+* R} {I : Ideal A}
  {M : ℕ → Type v} [∀ n, AddCommGroup (M n)] [∀ n, Module R (M n)]
  {M₀ : Type w} [AddCommGroup M₀] [Module R M₀]

/-- **The Rees algebra of an ideal of a Noetherian ring is a Noetherian graded ring.** This is
Mathlib's `IsNoetherianRing (reesAlgebra I)` transported along the decomposition of the Rees
algebra into its homogeneous pieces. -/
@[ega "III 4.1.7.7"]
theorem isNoetherianRing_reesGradingDirectSum (I : Ideal A) [IsNoetherianRing A] :
    IsNoetherianRing (⨁ n, ↥(reesGrading I n)) :=
  isNoetherianRing_of_surjective (reesAlgebra I) _
    (DirectSum.decomposeRingEquiv (reesGrading I)).toRingHom
    (DirectSum.decomposeRingEquiv (reesGrading I)).surjective

/-- `φ` carries `Iᵏ` into the `k`-th power of the extension of `I`. -/
theorem map_mem_map_pow (φ : A →+* R) (I : Ideal A) {k : ℕ} {a : A} (ha : a ∈ I ^ k) :
    φ a ∈ (I.map φ) ^ k := by
  rw [← Ideal.map_pow]
  exact Ideal.mem_map_of_mem φ ha

/-- An `IdealPowerSystem` for the extension of an ideal `I` of `A` along `φ : A →+* R`, whose
multiplication maps obey the graded-module laws over the Rees algebra `⨁ₙ Iⁿ` of `I`.

The three added axioms are the identity law for the transition maps, the statement that
multiplication by a degree-zero element is the module action, and associativity of the
multiplication maps. All three hold for the system `n ↦ Hᵖ(X, Iⁿ F)` of [Stacks, Tag 02OA] by
functoriality and bilinearity of the multiplication; none of them is a finiteness statement.

The ideal is taken in `A` rather than in `R` because the Rees algebra that acts is the Rees
algebra of `I` in `A`, and it is the Noetherianity of `A` -- not of `R` -- that
[Stacks, Tag 02OA] has available. -/
structure ReesSystem (φ : A →+* R) (I : Ideal A) (M : ℕ → Type v) [∀ n, AddCommGroup (M n)]
    [∀ n, Module R (M n)] (M₀ : Type w) [AddCommGroup M₀] [Module R M₀] extends
    IdealPowerSystem (I.map φ) M M₀ where
  /-- A transition map between equal degrees is the identity. -/
  tr_of_eq : ∀ {m n : ℕ} (h : m ≤ n), n = m → ∀ x : M n, (⟨m, tr h x⟩ : Σ k, M k) = ⟨n, x⟩
  /-- Multiplication by a degree-zero element is the module action. -/
  mul_zero_eq_smul : ∀ (n : ℕ) (a : ↥(I ^ 0)) (x : M n),
    (⟨0 + n, mul 0 n ⟨φ a, map_mem_map_pow φ I a.2⟩ x⟩ : Σ k, M k) = ⟨n, φ a • x⟩
  /-- The multiplication maps are associative. -/
  mul_mul : ∀ (k l n : ℕ) (a : ↥(I ^ k)) (b : ↥(I ^ l)) (c : ↥(I ^ (k + l))) (x : M n),
    (c : A) = (a : A) * (b : A) →
    (⟨k + l + n, mul (k + l) n ⟨φ c, map_mem_map_pow φ I c.2⟩ x⟩ : Σ j, M j) =
      ⟨k + (l + n), mul k (l + n) ⟨φ a, map_mem_map_pow φ I a.2⟩
        (mul l n ⟨φ b, map_mem_map_pow φ I b.2⟩ x)⟩

namespace ReesSystem

variable (S : ReesSystem φ I M M₀)

/-- The coefficient of a product of homogeneous elements of the Rees algebra is the product of
their coefficients. -/
theorem coe_symm_gMul {i i' : ℕ} (p : ↥(reesGrading I i)) (p' : ↥(reesGrading I i')) :
    (((reesGradingEquivPow I (i + i')).symm
        (GradedMonoid.GMul.mul (A := fun n ↦ ↥(reesGrading I n)) p p')) : A) =
      ((reesGradingEquivPow I i).symm p : A) * ((reesGradingEquivPow I i').symm p' : A) := by
  rw [coe_reesGradingEquivPow_symm, coe_reesGradingEquivPow_symm, coe_reesGradingEquivPow_symm,
    SetLike.coe_gMul, Subalgebra.coe_mul, coe_eq_monomial I p.2, coe_eq_monomial I p'.2,
    Polynomial.monomial_mul_monomial]
  simp

/-- The element of `(φ I)ⁱ` underlying a homogeneous element of degree `i` of the Rees
algebra. -/
def coeff {i : ℕ} (b : ↥(reesGrading I i)) : ↥((I.map φ) ^ i) :=
  ⟨φ ((reesGradingEquivPow I i).symm b), map_mem_map_pow φ I ((reesGradingEquivPow I i).symm b).2⟩

/-- The coefficient of the zero element of degree `i` is zero. -/
@[simp]
theorem coeff_zero {i : ℕ} : coeff (φ := φ) (0 : ↥(reesGrading I i)) = 0 :=
  Subtype.ext (by simp [coeff])

/-- The coefficient of a sum of homogeneous elements of degree `i` is the sum of their
coefficients. -/
@[simp]
theorem coeff_add {i : ℕ} (b b' : ↥(reesGrading I i)) :
    coeff (φ := φ) (b + b') = coeff (φ := φ) b + coeff (φ := φ) b' :=
  Subtype.ext (by simp [coeff])

/-- The action of the degree-`i` part of the Rees algebra on `M j`. -/
def gsmul {i j : ℕ} (b : ↥(reesGrading I i)) (x : M j) : M (i + j) :=
  S.mul i j (coeff (φ := φ) b) x

/-- A Rees system makes `n ↦ Mₙ` a graded module over the graded Rees algebra of `I`. -/
@[instance_reducible]
def gmodule : DirectSum.Gmodule (fun n ↦ ↥(reesGrading I n)) M where
  smul := S.gsmul
  one_smul := by
    rintro ⟨j, x⟩
    refine (S.mul_zero_eq_smul j _ x).trans ?_
    dsimp only [GradedMonoid.fst_one, GradedMonoid.snd_one]
    rw [coe_reesGradingEquivPow_symm, SetLike.coe_gOne, OneMemClass.coe_one,
      Polynomial.coeff_one_zero, map_one, one_smul]
  mul_smul := by
    rintro ⟨i, p⟩ ⟨i', p'⟩ ⟨j, x⟩
    refine S.mul_mul i i' j _ _ _ x ?_
    change (((reesGradingEquivPow I (i + i')).symm
        (GradedMonoid.GMul.mul (A := fun n ↦ ↥(reesGrading I n)) p p')) : A) =
      ((reesGradingEquivPow I i).symm p : A) * ((reesGradingEquivPow I i').symm p' : A)
    exact coe_symm_gMul p p'
  smul_add _ _ _ := map_add _ _ _
  smul_zero _ := map_zero _
  add_smul a a' b := by
    simp only [gsmul, coeff_add, map_add, LinearMap.add_apply]
  zero_smul b := by
    simp only [gsmul, coeff_zero, map_zero, LinearMap.zero_apply]

/-- **The finiteness input of [Stacks, Tag 02O8]**: the graded module `⨁ₙ Mₙ` is a finite
module over the Rees algebra `⨁ₙ Iⁿ`. -/
def IsReesFinite : Prop :=
  letI := S.gmodule
  Module.Finite (⨁ n, ↥(reesGrading I n)) (⨁ n, M n)

/-- **Finiteness over the Rees algebra implies Noetherianity of the system.**

This discharges the Noetherianity half of the input of [Stacks, Tag 02OA]: every graded
subobject of the system is finitely generated by homogeneous elements as soon as the system
itself is a finite module over the Rees algebra, which is exactly [Stacks, Tag 02O8]. -/
theorem isNoetherianSystem_of_isReesFinite [IsNoetherianRing A] (h : S.IsReesFinite) :
    S.toIdealPowerSystem.IsNoetherianSystem := by
  let inst := S.gmodule
  have : Module.Finite (⨁ n, ↥(reesGrading I n)) (⨁ n, M n) := h
  have : IsNoetherianRing (⨁ n, ↥(reesGrading I n)) := isNoetherianRing_reesGradingDirectSum I
  intro T
  obtain ⟨t, d, x, hxT, hcoef⟩ :=
    exists_homogeneous_generators (A := fun n ↦ ↥(reesGrading I n)) (fun n ↦ T.N n)
      (fun k n a y hy ↦ by
        change S.mul k n (coeff (φ := φ) a) y ∈ T.N (k + n)
        exact T.mul_mem k n _ hy)
  refine ⟨t, d, x, hxT, fun n z hz ↦ ?_⟩
  obtain ⟨c, hc0, hceq⟩ := hcoef n z hz
  have hz' : z = ∑ i, S.tr (show n ≤ n - d i + d i by omega)
      (S.mul (n - d i) (d i) (coeff (φ := φ) (c i)) (x i)) := by
    refine DirectSum.of_injective n ?_
    rw [hceq, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    by_cases hi : n < d i
    · rw [hc0 i hi]
      simp only [DirectSum.Gmodule.zero_smul, coeff_zero, map_zero, LinearMap.zero_apply]
    · exact (DirectSum.of_eq_of_gradedMonoid_eq
        (S.tr_of_eq (show n ≤ n - d i + d i by omega) (by omega) _)).symm
  rw [hz']
  exact Submodule.sum_mem _ fun i _ ↦
    Submodule.mem_iSup_of_mem i (Submodule.subset_span (Set.mem_range_self _))

/-- The zero system, as a Rees system: all modules trivial and all maps zero. With
`trivialReesSystem_isReesFinite` this witnesses that the axioms of `ReesSystem` together with
the input `IsReesFinite` are consistent, so the theorem above is not vacuous for want of a
model. -/
def trivialReesSystem (φ : A →+* R) (I : Ideal A) :
    ReesSystem φ I (fun _ : ℕ ↦ PUnit.{v + 1}) PUnit.{w + 1} :=
  { IdealPowerSystem.trivialSystem (I.map φ) with
    tr_of_eq := fun _ e _ ↦ Sigma.ext e.symm (heq_of_eq (Subsingleton.elim _ _))
    mul_zero_eq_smul := fun n _ _ ↦
      Sigma.ext (Nat.zero_add n) (heq_of_eq (Subsingleton.elim _ _))
    mul_mul := fun k l n _ _ _ _ _ ↦
      Sigma.ext (Nat.add_assoc k l n) (heq_of_eq (Subsingleton.elim _ _)) }

/-- The zero system is finite over the Rees algebra. -/
theorem trivialReesSystem_isReesFinite (φ : A →+* R) (I : Ideal A) :
    (trivialReesSystem φ I : ReesSystem φ I (fun _ : ℕ ↦ PUnit.{v + 1})
      PUnit.{w + 1}).IsReesFinite := by
  let inst := (trivialReesSystem φ I : ReesSystem φ I (fun _ : ℕ ↦ PUnit.{v + 1})
    PUnit.{w + 1}).gmodule
  change Module.Finite (⨁ n, ↥(reesGrading I n)) (⨁ _ : ℕ, PUnit.{v + 1})
  infer_instance

end ReesSystem

end Rees

end Stacks.RingTheory

