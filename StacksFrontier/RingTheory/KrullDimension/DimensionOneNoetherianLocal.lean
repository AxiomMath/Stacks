/-!
# Noetherian local rings of dimension one

Let `(R, m)` be a Noetherian local ring. The following are equivalent:

1. `dim(R) = 1`;
2. `d(R) = 1`, where `d(R)` is the degree of the Hilbert–Samuel function
   `n ↦ length_R (R / m ^ (n + 1))` (Definition 00KA);
3. there is a non-nilpotent `x ∈ m` with `V(x) = {m}`;
4. there is a non-nilpotent `x ∈ m` with `m = √(x)`;
5. some ideal of definition of `R` is generated by one element, and none is generated by zero
   elements.

For (1) ⇒ (3): the minimal primes of `R` are finitely many, and none of them is `m` since
`dim(R) = 1`, so by prime avoidance some `x ∈ m` lies in no minimal prime. Such an `x` is not
nilpotent, and a prime `q ∋ x` is not minimal, so it strictly contains a minimal prime; if
also `q ≠ m` this gives a chain of primes of length two, which is impossible. For (3) ⇒ (1):
`m` is a minimal prime over the principal ideal `(x)`, so has height at most one by Krull's
principal ideal theorem, and since `x` is not nilpotent some prime avoids `x`, hence lies
strictly inside `m`. Conditions (3) and (4) are equivalent because `√(x)` is the intersection
of the primes containing `x`, and (4) and (5) are two spellings of the same condition, an
ideal generated by zero elements being `(0)`, whose radical is `m` exactly when every element
of `m` is nilpotent.

## Main results

* `IsLocalRing.zeroLocus_singleton_eq_iff_radical_span_singleton_eq`: in a local ring,
  `V(x) = {m}` if and only if `√(x) = m`.
* `IsLocalRing.ringKrullDim_eq_one_tfae`: the five conditions above are equivalent.

## Implementation notes

`dim(R) = 1` is `ringKrullDim R = 1`, and `d(R)` is `Module.hilbertSamuelDegree R R`, with
values in `WithBot ℕ`. `V(x) = {m}` is the equation
`PrimeSpectrum.zeroLocus {x} = {IsLocalRing.closedPoint R}` in `Spec(R)`. An ideal of definition
is an ideal whose radical is `m` (Tag 07DU); an ideal generated by one element is
`Ideal.span {x}`, and the ideal generated by zero elements is `⊥ = (0)`.

The source proves (5) ⇒ (2) by bounding the lengths of `I ^ n / I ^ (n + 1)` for `I = (x)`, and
(2) ⇒ (1) by a direct application of Lemmas 00KC and 00KI to the quotients `R / p` and
`R / (xR + p)`. Here the equivalence of (1) and (2) is instead read off from the equality
`d(M) = dim Supp(M)` of Lemma 00L8 for `M = R`, whose support is all of `Spec(R)`; this proves
the same equivalence, and the chain (1) ⇒ (3) ⇒ (4) ⇒ (5) ⇒ (4) ⇒ (3) ⇒ (1) of the source is
kept.

## References

* [Stacks Project, Tag 00KK](https://stacks.math.columbia.edu/tag/00KK)
-/

public section

open IsLocalRing PrimeSpectrum

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- If `V(x) = {m}`, every prime containing `x` contains the maximal ideal. -/
private theorem maximalIdeal_le_of_zeroLocus_eq {x : R} {q : Ideal R}
    (h : zeroLocus {x} = {closedPoint R}) (hq : q.IsPrime) (hxq : x ∈ q) : maximalIdeal R ≤ q := by
  have hmem : (⟨q, hq⟩ : PrimeSpectrum R) ∈ zeroLocus {x} := by simpa [mem_zeroLocus] using hxq
  rw [h, Set.mem_singleton_iff] at hmem
  exact (congrArg PrimeSpectrum.asIdeal hmem).ge

/-- In a local ring `(R, m)` the closed point is the only prime containing `x` exactly when
`√(x) = m`. No condition on `x` is needed: for a unit `x` both sides fail. -/
theorem zeroLocus_singleton_eq_iff_radical_span_singleton_eq (x : R) :
    zeroLocus {x} = {closedPoint R} ↔ (Ideal.span {x}).radical = maximalIdeal R := by
  constructor
  · intro h
    have hx : x ∈ maximalIdeal R := by
      have : closedPoint R ∈ zeroLocus {x} := h ▸ rfl
      rwa [mem_zeroLocus, Set.singleton_subset_iff] at this
    apply le_antisymm
    · rw [(maximalIdeal.isMaximal R).isPrime.radical_le_iff, Ideal.span_le]
      simpa using hx
    · rw [Ideal.radical_eq_sInf]
      refine le_sInf fun J ⟨hxJ, hJ⟩ => ?_
      exact maximalIdeal_le_of_zeroLocus_eq h hJ (by simpa [Ideal.span_le] using hxJ)
  · intro h
    ext q
    simp only [mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe,
      Set.mem_singleton_iff]
    constructor
    · intro hxq
      have hle : (Ideal.span {x}).radical ≤ q.asIdeal := by
        rw [q.isPrime.radical_le_iff, Ideal.span_le]
        simpa using hxq
      rw [h] at hle
      ext1
      exact ((maximalIdeal.isMaximal R).eq_of_le q.isPrime.ne_top hle).symm
    · rintro rfl
      change x ∈ maximalIdeal R
      rw [← h]
      exact Ideal.le_radical (Ideal.mem_span_singleton_self x)

variable [IsNoetherianRing R]

/-- For a Noetherian local ring, `dim(R) = n` exactly when `d(R) = n`. -/
private theorem ringKrullDim_eq_natCast_iff_hilbertSamuelDegree_eq (n : ℕ) :
    ringKrullDim R = n ↔ Module.hilbertSamuelDegree R R = n := by
  have h := Module.hilbertSamuelDegree_eq_supportDim R R
  rw [Module.supportDim_self_eq_ringKrullDim] at h
  rw [← h]
  induction Module.hilbertSamuelDegree R R using WithBot.recBotCoe with
  | bot => simp
  | coe m =>
    change ((m : ℕ∞) : WithBot ℕ∞) = ((n : ℕ) : ℕ∞) ↔ (m : WithBot ℕ) = ((n : ℕ) : WithBot ℕ)
    simp

/-- A Noetherian local ring has dimension zero exactly when its Hilbert–Samuel degree `d(R)`
is zero. -/
@[stacks 00KI "The source reads this off from `d(R) = 0` if and only if `R` has finite length;
here it is read off from `d(M) = dim Supp(M)` (Lemma 00L8) for `M = R`."]
theorem ringKrullDim_eq_zero_iff_hilbertSamuelDegree_eq_zero :
    ringKrullDim R = 0 ↔ Module.hilbertSamuelDegree R R = 0 :=
  ringKrullDim_eq_natCast_iff_hilbertSamuelDegree_eq 0

/-- **Noetherian local rings of dimension one.** For a Noetherian local ring `(R, m)` the
following are equivalent: `dim(R) = 1`; `d(R) = 1`; there is a non-nilpotent `x ∈ m` with
`V(x) = {m}`; there is a non-nilpotent `x ∈ m` with `m = √(x)`; some ideal of definition is
generated by one element, and the ideal `(0)` generated by zero elements is not an ideal of
definition. -/
@[stacks 00KK "Items (1)-(5), in the source's order. The ideal generated by zero elements is
`⊥`; an ideal of definition is an ideal with radical `m`.", ega "IV 5.1.6" "special case"]
theorem ringKrullDim_eq_one_tfae :
    List.TFAE
      [ringKrullDim R = 1,
        Module.hilbertSamuelDegree R R = 1,
        ∃ x ∈ maximalIdeal R, ¬ IsNilpotent x ∧ zeroLocus {x} = {closedPoint R},
        ∃ x ∈ maximalIdeal R, ¬ IsNilpotent x ∧ (Ideal.span {x}).radical = maximalIdeal R,
        (∃ x : R, (Ideal.span {x}).radical = maximalIdeal R) ∧
          (⊥ : Ideal R).radical ≠ maximalIdeal R] := by
  have hm : ((maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
    maximalIdeal_height_eq_ringKrullDim
  tfae_have 1 ↔ 2 := ringKrullDim_eq_natCast_iff_hilbertSamuelDegree_eq 1
  tfae_have 1 → 3 := by
    intro h
    have hm1 : (maximalIdeal R).height = 1 := by
      rw [h] at hm; exact_mod_cast hm
    have hnotmin : maximalIdeal R ∉ minimalPrimes R := by
      intro hmin
      rw [← Ideal.height_eq_zero_iff, hm1] at hmin
      exact one_ne_zero hmin
    have hnsub : ¬ ((maximalIdeal R : Set R) ⊆ ⋃ p ∈ minimalPrimes R, (p : Set R)) := by
      intro hsub
      obtain ⟨p, hp, hle⟩ := (Ideal.subset_union_prime_finite (f := id)
        (minimalPrimes.finite_of_isNoetherianRing R) (maximalIdeal R) (maximalIdeal R)
        (fun p hp _ _ => hp.1.1)).1 hsub
      have : maximalIdeal R = p := (maximalIdeal.isMaximal R).eq_of_le hp.1.1.ne_top hle
      exact hnotmin (this ▸ hp)
    obtain ⟨x, hxm, hxp⟩ := Set.not_subset.1 hnsub
    simp only [Set.mem_iUnion, SetLike.mem_coe, not_exists] at hxp
    refine ⟨x, hxm, ?_, ?_⟩
    · rintro ⟨n, hn⟩
      obtain ⟨p, hp, -⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ maximalIdeal R)
      exact hxp p hp (hp.1.1.mem_of_pow_mem n (hn ▸ p.zero_mem))
    · ext q
      simp only [mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe,
        Set.mem_singleton_iff]
      constructor
      · intro hxq
        ext1
        by_contra hne
        have hlt : q.asIdeal < maximalIdeal R :=
          lt_of_le_of_ne (le_maximalIdeal q.isPrime.ne_top) hne
        have hq0 : q.asIdeal.height ≠ 0 := by
          rw [Ne, Ideal.height_eq_zero_iff]
          exact fun hmin => hxp _ hmin hxq
        have h2 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
        rw [hm1] at h2
        have : 1 ≤ q.asIdeal.height := Order.one_le_iff_ne_zero.2 hq0
        have : (1 : ℕ∞) + 1 ≤ 1 := le_trans (add_le_add_left this 1) h2
        exact absurd this (by decide)
      · rintro rfl
        exact hxm
  tfae_have 3 → 1 := by
    rintro ⟨x, hxm, hnil, hV⟩
    have : (Ideal.span {x}).IsPrincipal := ⟨⟨x, rfl⟩⟩
    have hmin : maximalIdeal R ∈ (Ideal.span {x}).minimalPrimes := by
      refine ⟨⟨inferInstance, by simpa [Ideal.span_le] using hxm⟩, fun q ⟨hq, hxq⟩ _ => ?_⟩
      exact maximalIdeal_le_of_zeroLocus_eq hV hq (by simpa [Ideal.span_le] using hxq)
    have hle : (maximalIdeal R).height ≤ 1 :=
      Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ _ hmin
    obtain ⟨p, hp, hxp⟩ : ∃ p : Ideal R, p.IsPrime ∧ x ∉ p := by
      by_contra! H
      exact hnil (mem_nilradical.1 (by
        rw [nilradical_eq_sInf, Submodule.mem_sInf]; exact fun p hp => H p hp))
    have hlt : p < maximalIdeal R :=
      lt_of_le_of_ne (le_maximalIdeal hp.ne_top) fun h => hxp (h ▸ hxm)
    have hge : 1 ≤ (maximalIdeal R).height :=
      le_trans (le_add_self) (Ideal.height_add_one_le_of_lt_of_isPrime hlt)
    rw [← hm, le_antisymm hle hge]
    rfl
  tfae_have 3 ↔ 4 := by
    simp only [zeroLocus_singleton_eq_iff_radical_span_singleton_eq]
  tfae_have 4 → 5 := by
    rintro ⟨x, hxm, hnil, hrad⟩
    refine ⟨⟨x, hrad⟩, fun h => hnil ?_⟩
    obtain ⟨n, hn⟩ : x ∈ (⊥ : Ideal R).radical := h ▸ hxm
    exact ⟨n, by simpa using hn⟩
  tfae_have 5 → 4 := by
    rintro ⟨⟨x, hrad⟩, hbot⟩
    refine ⟨x, hrad ▸ Ideal.le_radical (Ideal.mem_span_singleton_self x), fun ⟨n, hn⟩ => hbot ?_,
      hrad⟩
    rw [← hrad]
    refine le_antisymm (Ideal.radical_mono bot_le) ?_
    rw [Ideal.radical_le_radical_iff, Ideal.span_le, Set.singleton_subset_iff]
    exact ⟨n, by simp [hn]⟩
  tfae_finish

end IsLocalRing
