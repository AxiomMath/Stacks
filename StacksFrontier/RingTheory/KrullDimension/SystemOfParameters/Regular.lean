module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import StacksFrontier.RingTheory.KrullDimension.SystemOfParameters.Defs
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Regular systems of parameters and regular local rings

Let `(R, m)` be a Noetherian local ring of dimension `d`. Item (2) of [StackProject 00KU] says: if
there are `x_1, …, x_d ∈ m` with `m = (x_1, …, x_d)`, then `R` is a *regular local ring* and
`x_1, …, x_d` is a *regular system of parameters*. This file states both notions of that item in
the source's own terms and relates them to Mathlib.

## Main definitions

* `IsLocalRing.IsRegularSystemOfParametersList`: a list `rs` of elements of a local ring `R` is a
  regular system of parameters when it generates `m` and has `dim R` entries.
* `IsLocalRing.HasRegularSystemOfParameters`: the source's definition of a regular local ring,
  the existence of a regular system of parameters.

## Main results

* `IsLocalRing.IsRegularSystemOfParametersList.isSystemOfParameters`: a regular system of
  parameters is a system of parameters (item (1), `IsLocalRing.IsSystemOfParameters`).
* `IsLocalRing.isRegularLocalRing_iff_hasRegularSystemOfParameters`: over a Noetherian local ring,
  the source's definition of a regular local ring is Mathlib's `IsRegularLocalRing`, which is
  spelled `(maximalIdeal R).spanFinrank = ringKrullDim R`.

## Implementation notes

As for `IsLocalRing.IsSystemOfParameters`, a sequence is a `List R`, `Ideal.ofList rs` is the
ideal `(x_1, …, x_d)` and `rs.length` is `d`. The condition `x_i ∈ m` is not a conjunct since it
follows from `Ideal.ofList rs = m`. The name carries the suffix `List` to keep it apart from the
root-level `IsRegularSystemOfParameters` (EGA 0 17.1.6), a different notion: a family in `m` whose
images form a basis of `m / m ^ 2`, with no condition on its length relating it to `dim R`.

## References

* [StackProject 00KU](https://stacks.math.columbia.edu/tag/00KU)
-/

@[expose] public section

open IsLocalRing

namespace IsLocalRing

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- **Regular system of parameters** (Stacks 00KU, item (2)). A sequence `rs` of elements of a
local ring `(R, m)` is a *regular system of parameters* of `R` if it generates the maximal ideal
`m` and has `dim R` entries. Its entries then lie in `m`. -/
@[stacks 00KU "Item (2), the sequence notion: a regular system of parameters, \
`m = (x_1, …, x_d)` with `d = dim R`."]
def IsRegularSystemOfParametersList (rs : List R) : Prop :=
  Ideal.ofList rs = maximalIdeal R ∧ ringKrullDim R = rs.length

variable (R) in
/-- **Regular local ring, Stacks' definition** (Stacks 00KU, item (2)). A local ring `R` is
regular in the sense of the source if it admits a regular system of parameters, i.e. its maximal
ideal is generated by `dim R` elements. Over a Noetherian local ring this is Mathlib's
`IsRegularLocalRing`, see `IsLocalRing.isRegularLocalRing_iff_hasRegularSystemOfParameters`. -/
@[stacks 00KU "Item (2), the predicate on the ring: there exist `x_1, …, x_d ∈ m` with \
`m = (x_1, …, x_d)`, `d = dim R`. Equivalent to Mathlib's `IsRegularLocalRing` over a Noetherian \
local ring by `isRegularLocalRing_iff_hasRegularSystemOfParameters`."]
def HasRegularSystemOfParameters : Prop :=
  ∃ rs : List R, IsRegularSystemOfParametersList rs

/-- The entries of a regular system of parameters lie in the maximal ideal. -/
theorem IsRegularSystemOfParametersList.mem_maximalIdeal {rs : List R}
    (h : IsRegularSystemOfParametersList rs) {x : R} (hx : x ∈ rs) : x ∈ maximalIdeal R :=
  h.1 ▸ Ideal.subset_span hx

/-- A regular system of parameters is a system of parameters (Stacks 00KU, item (2) refines
item (1)). -/
theorem IsRegularSystemOfParametersList.isSystemOfParameters {rs : List R}
    (h : IsRegularSystemOfParametersList rs) : IsSystemOfParameters rs :=
  ⟨by rw [h.1]; exact (maximalIdeal.isMaximal R).isPrime.radical, h.2⟩

/-- Over a Noetherian local ring, the source's definition of a regular local ring (the maximal
ideal is generated by a sequence of `dim R` elements) is Mathlib's `IsRegularLocalRing`. -/
theorem isRegularLocalRing_iff_hasRegularSystemOfParameters [IsNoetherianRing R] :
    IsRegularLocalRing R ↔ HasRegularSystemOfParameters R := by
  constructor
  · intro hR
    obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (IsNoetherian.noetherian (maximalIdeal R))
    refine ⟨s.toList, ?_, ?_⟩
    · have : {r | r ∈ s.toList} = (s : Set R) := by ext; simp
      rw [Ideal.ofList, this]
      exact hspan
    · rw [← hR.spanFinrank_maximalIdeal, Finset.length_toList, hcard]
  · classical
    rintro ⟨rs, hgen, hdim⟩
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    have hset : {r | r ∈ rs} = (rs.toFinset : Set R) := by ext; simp
    have hle : (maximalIdeal R).spanFinrank ≤ rs.length := by
      rw [← hgen, Ideal.ofList, hset]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite rs.toFinset.finite_toSet).trans ?_
      rw [Set.ncard_coe_finset]
      exact List.toFinset_card_le rs
    rw [hdim]
    exact_mod_cast hle

end IsLocalRing
