/-!
# The category `Rig.AdicFiniteTypeAlgebra` and completed base change

The category, the maps `Rig.completionMap`, and the functor `Rig.completedBaseChange`.
-/

@[expose] public section

open CategoryTheory

universe u v u₁ u₂

namespace Rig

/-- The category of `I`-adically complete `A`-algebras whose reduction modulo `I` is of
finite type over `A ⧸ I`. -/
@[stacks 0AL4] public abbrev AdicFiniteTypeAlgebra (A : Type u) [CommRing A] (I : Ideal A) :=
  ObjectProperty.FullSubcategory fun B : CommAlgCat.{v} A ↦
    IsAdicComplete (I.map (algebraMap A B)) B ∧
      Algebra.FiniteType (A ⧸ I) (B ⧸ I.map (algebraMap A B))

namespace AdicFiniteTypeAlgebra

variable {A : Type u} [CommRing A] {I : Ideal A}

/-- The underlying commutative ring of an adically complete algebra of finite type modulo
`I`. -/
public abbrev carrier (B : AdicFiniteTypeAlgebra.{u, v} A I) := B.obj

/-- The ideal generated by `I` in an object of `AdicFiniteTypeAlgebra A I`. -/
public abbrev adicIdeal (B : AdicFiniteTypeAlgebra.{u, v} A I) : Ideal B.carrier :=
  I.map (algebraMap A B.carrier)

/-- The reduction modulo `I` of an object of `AdicFiniteTypeAlgebra A I`. -/
public abbrev reduction (B : AdicFiniteTypeAlgebra.{u, v} A I) := B.carrier ⧸ B.adicIdeal

/-- An object of `AdicFiniteTypeAlgebra A I` is complete for the ideal generated by `I`. -/
public theorem isAdicallyComplete (B : AdicFiniteTypeAlgebra.{u, v} A I) :
    IsAdicComplete B.adicIdeal B.carrier := B.property.1

/-- The reduction of an object of `AdicFiniteTypeAlgebra A I` is of finite type over
`A ⧸ I`. -/
public instance finiteTypeReduction (B : AdicFiniteTypeAlgebra.{u, v} A I) :
    Algebra.FiniteType (A ⧸ I) B.reduction := B.property.2

/-- Construct an object of `AdicFiniteTypeAlgebra A I` from an `A`-algebra satisfying
the two defining conditions. -/
public def of (B : Type v) [CommRing B] [Algebra A B]
    (hcomplete : IsAdicComplete (I.map (algebraMap A B)) B)
    [Algebra.FiniteType (A ⧸ I) (B ⧸ I.map (algebraMap A B))] :
    AdicFiniteTypeAlgebra.{u, v} A I := ⟨CommAlgCat.of A B, hcomplete, inferInstance⟩

/-- The carrier of `AdicFiniteTypeAlgebra.of B hcomplete` is `B` itself. -/
@[simp] public theorem carrier_of (B : Type v) [CommRing B] [Algebra A B]
    (hcomplete : IsAdicComplete (I.map (algebraMap A B)) B)
    [Algebra.FiniteType (A ⧸ I) (B ⧸ I.map (algebraMap A B))] :
    (of B hcomplete).carrier = B := rfl

/-- Regard an `A`-algebra map as a morphism between objects of
`AdicFiniteTypeAlgebra A I`. -/
public def homMk {B C : AdicFiniteTypeAlgebra.{u, v} A I}
    (f : B.carrier →ₐ[A] C.carrier) : B ⟶ C :=
  ObjectProperty.homMk (ConcreteCategory.ofHom f)

/-- The underlying `A`-algebra map of a morphism in `AdicFiniteTypeAlgebra A I`. -/
public abbrev hom {B C : AdicFiniteTypeAlgebra.{u, v} A I} (f : B ⟶ C) :
    B.carrier →ₐ[A] C.carrier := f.hom.hom

/-- The underlying algebra map of `AdicFiniteTypeAlgebra.homMk f` is `f`. -/
@[simp] public theorem hom_homMk {B C : AdicFiniteTypeAlgebra.{u, v} A I}
    (f : B.carrier →ₐ[A] C.carrier) : hom (homMk f) = f := rfl

end AdicFiniteTypeAlgebra

section
variable {A₁ : Type u₁} [CommRing A₁]
variable {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
variable {I₁ : Ideal A₁} {I₂ : Ideal A₂}

/-- The scalar extension `B ⊗[A₁] A₂` of an adically finite type `A₁`-algebra `B`. -/
public abbrev baseChangedAlgebra
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :=
  TensorProduct A₁ B.carrier A₂

/-- The ideal generated by `I₂` in `B ⊗[A₁] A₂`. -/
public abbrev baseChangedIdeal
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) : Ideal (baseChangedAlgebra (A₂ := A₂) B) :=
  I₂.map (Algebra.TensorProduct.includeRight :
    A₂ →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) B)

/-- The extension of a finitely generated ideal `I₂` to `B ⊗[A₁] A₂` is finitely generated. -/
public theorem baseChangedIdeal_fg (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁)
    (hI₂ : I₂.FG) : (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B).FG := hI₂.map _

/-- A homomorphism carrying `I` into `J` carries `I ^ n` into `J ^ n`. -/
public theorem idealMapPow_le {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J) (n : ℕ) :
    I ^ n ≤ (J ^ n).comap f := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
  exact pow_le_pow_left' h n

/-- The compatible family `Â_I → S ⧸ J ^ n` out of which the map of adic completions induced
by a homomorphism carrying `I` into `J` is assembled. -/
public noncomputable def completionMapFamily {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J)
    (n : ℕ) : AdicCompletion I R →+* S ⧸ J ^ n :=
  (Ideal.quotientMap (J ^ n) f (idealMapPow_le I J f h n)).comp
    (AdicCompletion.evalₐ I n).toRingHom

/-- The family `completionMapFamily` is compatible with the transition maps of the
`J`-adic system. -/
public theorem completionMapFamily_comp {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J) :
    ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorPow J hle).comp (completionMapFamily I J f h n) =
        completionMapFamily I J f h m := by
  intro m n hmn
  apply RingHom.ext
  intro x
  simp only [RingHom.comp_apply]
  show (Ideal.Quotient.factorPow J hmn)
      ((Ideal.quotientMap (J ^ n) f (idealMapPow_le I J f h n))
        (AdicCompletion.evalₐ I n x)) =
    (Ideal.quotientMap (J ^ m) f (idealMapPow_le I J f h m))
      (AdicCompletion.evalₐ I m x)
  rw [← AdicCompletion.factorPow_evalₐ I hmn x]
  induction AdicCompletion.evalₐ I n x using Quotient.inductionOn' with
  | _ r => rfl

/-- The map of adic completions `Â_I → Ŝ_J` induced by a ring homomorphism `f : R →+* S`
which carries `I` into `J`. -/
public noncomputable def completionMap {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J) :
    AdicCompletion I R →+* AdicCompletion J S :=
  AdicCompletion.liftRingHom J (completionMapFamily I J f h)
    (completionMapFamily_comp I J f h)

/-- The induced map of completions is compatible with the canonical maps from the
uncompleted rings. -/
public theorem completionMap_of {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J) (r : R) :
    completionMap I J f h (AdicCompletion.of I R r) =
      AdicCompletion.of J S (f r) := by
  apply AdicCompletion.ext_evalₐ
  intro n
  unfold completionMap
  rw [AdicCompletion.evalₐ_liftRingHom]
  show (Ideal.quotientMap (J ^ n) f (idealMapPow_le I J f h n))
      (AdicCompletion.evalₐ I n (AdicCompletion.of I R r)) =
    Ideal.Quotient.mk (J ^ n) (f r)
  rw [AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]

/-- The `n`-th component of the induced map of completions is the `n`-th member of
`completionMapFamily`. -/
public theorem completionMap_eval {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f : R →+* S) (h : I.map f ≤ J)
    (n : ℕ) (x : AdicCompletion I R) :
    AdicCompletion.evalₐ J n (completionMap I J f h x) =
      completionMapFamily I J f h n x :=
  AdicCompletion.evalₐ_liftRingHom J
    (completionMapFamily I J f h) (completionMapFamily_comp I J f h) n x

/-- The map of completions induced by the identity is the identity. -/
public theorem completionMap_id {R : Type*} [CommRing R] (I : Ideal R)
    (h : I.map (RingHom.id R) ≤ I) :
    completionMap I I (RingHom.id R) h = RingHom.id (AdicCompletion I R) := by
  apply RingHom.ext
  intro x
  apply AdicCompletion.ext_evalₐ
  intro n
  rw [completionMap_eval]
  show (Ideal.quotientMap (I ^ n) (RingHom.id R) (idealMapPow_le I I _ h n))
      (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I n x
  induction AdicCompletion.evalₐ I n x using Quotient.inductionOn' with
  | _ r => rfl

/-- The map of completions induced by a composite is the composite of the induced maps. -/
public theorem completionMap_comp {R S T : Type*}
    [CommRing R] [CommRing S] [CommRing T]
    (I : Ideal R) (J : Ideal S) (K : Ideal T)
    (f : R →+* S) (g : S →+* T)
    (hf : I.map f ≤ J) (hg : J.map g ≤ K)
    (hgf : I.map (g.comp f) ≤ K) :
    (completionMap J K g hg).comp (completionMap I J f hf) =
      completionMap I K (g.comp f) hgf := by
  apply RingHom.ext
  intro x
  apply AdicCompletion.ext_evalₐ
  intro n
  show AdicCompletion.evalₐ K n
      (completionMap J K g hg (completionMap I J f hf x)) =
    AdicCompletion.evalₐ K n (completionMap I K (g.comp f) hgf x)
  simp only [completionMap_eval]
  show (Ideal.quotientMap (K ^ n) g (idealMapPow_le J K g hg n))
      (AdicCompletion.evalₐ J n (completionMap I J f hf x)) =
    (completionMapFamily I K (g.comp f) hgf n) x
  rw [completionMap_eval]
  show (Ideal.quotientMap (K ^ n) g (idealMapPow_le J K g hg n))
      ((Ideal.quotientMap (J ^ n) f (idealMapPow_le I J f hf n))
        (AdicCompletion.evalₐ I n x)) =
    (Ideal.quotientMap (K ^ n) (g.comp f) (idealMapPow_le I K (g.comp f) hgf n))
      (AdicCompletion.evalₐ I n x)
  induction AdicCompletion.evalₐ I n x using Quotient.inductionOn' with
  | _ r => rfl

/-- The induced map of completions depends only on the underlying homomorphism, not on the
proof that it carries one ideal into the other. -/
public theorem completionMap_congr {R S : Type*} [CommRing R] [CommRing S]
    (I : Ideal R) (J : Ideal S) (f g : R →+* S)
    (hf : I.map f ≤ J) (hg : I.map g ≤ J) (h : f = g) :
    completionMap I J f hf = completionMap I J g hg := by
  cases h
  rfl

/-- If `I` is finitely generated, the reduction of the `I`-adic completion of `S` modulo the
extension of `I` is `S ⧸ I` itself, so it inherits finite type over the base ring. -/
public theorem finiteType_quotient_adicCompletion {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (I : Ideal S) (hI : I.FG)
    (hft : Algebra.FiniteType R (S ⧸ I)) :
    Algebra.FiniteType R
      (AdicCompletion I S ⧸ I.map (algebraMap S (AdicCompletion I S))) := by
  let p : AdicCompletion I S →ₐ[R] S ⧸ I :=
    (AdicCompletion.evalOneₐ I).restrictScalars R
  have hp : Function.Surjective p := AdicCompletion.evalOneₐ_surjective I
  have hker : RingHom.ker p.toRingHom =
      I.map (algebraMap S (AdicCompletion I S)) :=
    AdicCompletion.ker_evalOneₐ_eq_map I hI
  let e : (AdicCompletion I S ⧸ I.map (algebraMap S (AdicCompletion I S))) ≃ₐ[R]
      (S ⧸ I) :=
    (Ideal.quotientEquivAlgOfEq R hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hp)
  exact hft.equiv e.symm

/-- If a positive power of `I₁` maps into `I₂`, then the ideal generated by `I₁` in `A₂ ⧸ I₂`
is nilpotent. -/
public theorem imageIdeal_nilpotent (c : ℕ) (_hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) :
    IsNilpotent (I₁.map (algebraMap A₁ (A₂ ⧸ I₂))) := by
  refine ⟨c, ?_⟩
  rw [← Ideal.map_pow]
  exact (Ideal.map_eq_bot_iff_le_ker _).2 fun x hx =>
    Ideal.Quotient.eq_zero_iff_mem.2 (hmap (Ideal.mem_map_of_mem _ hx))

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The reduction `B ⊗[A₁] (A₂ ⧸ I₂)` of a base-changed object is of finite type over
`A₂ ⧸ I₂`. -/
public theorem baseChangedAlgebra_finiteType
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) (c : ℕ) (hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) :
    Algebra.FiniteType (A₂ ⧸ I₂)
      (TensorProduct A₁ B.carrier (A₂ ⧸ I₂)) := by
  let R := A₂ ⧸ I₂
  let K : Ideal R := I₁.map (algebraMap A₁ R)
  let R₀ := R ⧸ K
  let Q := TensorProduct A₁ B.carrier R
  let _ : Algebra A₁ Q := Algebra.TensorProduct.leftAlgebra
  let _ : Algebra R Q := Algebra.TensorProduct.rightAlgebra
  let L : Ideal Q := K.map (algebraMap R Q)
  have hK : IsNilpotent K := imageIdeal_nilpotent c hc hmap
  let A₀ := A₁ ⧸ I₁
  let B₀ := B.carrier ⧸ (I₁.map (algebraMap A₁ B.carrier))
  have hfA : ∀ a ∈ I₁, (Algebra.ofId A₁ R₀) a = 0 := fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem (algebraMap A₁ R) ha)
  have hfB : ∀ a ∈ I₁, (Algebra.ofId A₁ B₀) a = 0 := fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem (algebraMap A₁ B.carrier) ha)
  let fA : A₀ →ₐ[A₁] R₀ := Ideal.Quotient.liftₐ (R₁ := A₁) I₁ (Algebra.ofId A₁ R₀) hfA
  let fB : A₀ →ₐ[A₁] B₀ := Ideal.Quotient.liftₐ (R₁ := A₁) I₁ (Algebra.ofId A₁ B₀) hfB
  let _ : Algebra A₀ R₀ := fA.toRingHom.toAlgebra
  let _ : Algebra A₀ B₀ := Ideal.Quotient.algebraQuotientMapQuotient
  let _ : IsScalarTower A₁ A₀ R₀ := IsScalarTower.of_algebraMap_eq' (by
    show fA.toRingHom.comp (algebraMap A₁ A₀) = algebraMap A₁ R₀
    simp [fA])
  let _ : IsScalarTower A₁ A₀ B₀ := IsScalarTower.of_algebraMap_eq' (by
    show fB.toRingHom.comp (algebraMap A₁ A₀) = algebraMap A₁ B₀
    simp [fB])
  let T := Q ⧸ L
  let _ : Algebra A₁ T := Ideal.Quotient.algebra A₁
  let _ : Algebra R T := Ideal.Quotient.algebra R
  let _ : Algebra R₀ T := Ideal.Quotient.algebraQuotientMapQuotient
  let _ : IsScalarTower A₁ R Q := IsScalarTower.of_algebraMap_eq'
      (R := A₁) (S := R) (A := Q) (by
    show (Algebra.TensorProduct.includeLeftRingHom.comp (algebraMap A₁ B.carrier)) =
      (Algebra.TensorProduct.includeRight.toRingHom.comp (algebraMap A₁ R))
    exact Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
      (R := A₁) (A := B.carrier) (B := R))
  let fR₀ : R₀ →ₐ[A₁] T :=
    Ideal.Quotient.liftₐ (R₁ := A₁) K
      ((Ideal.Quotient.mkₐ A₁ L).comp (Algebra.TensorProduct.includeRight)) fun r hr =>
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem (algebraMap R Q) hr)
  have hfR₀ : fR₀.toRingHom = algebraMap R₀ T := by
    apply RingHom.ext
    intro x
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp only [fR₀]
    rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
    rfl
  let _ : IsScalarTower A₁ R₀ T := IsScalarTower.of_algebraMap_eq
      (R := A₁) (S := R₀) (A := T) (by
    intro a
    rw [← hfR₀]
    exact (fR₀.commutes a).symm)
  let _ : Algebra A₀ T := Algebra.compHom T fA.toRingHom
  let _ : IsScalarTower A₁ A₀ T := IsScalarTower.of_algebraMap_eq
      (R := A₁) (S := A₀) (A := T) (by
    intro a
    rw [Algebra.compHom_algebraMap_apply]
    calc
      algebraMap A₁ T a = fR₀ (algebraMap A₁ R₀ a) := (fR₀.commutes a).symm
      _ = fR₀ (fA (algebraMap A₁ A₀ a)) := by rw [fA.commutes]
      _ = (algebraMap R₀ T) (fA (algebraMap A₁ A₀ a)) := by
        show fR₀.toRingHom _ = _
        exact congrArg (fun g : R₀ →+* T => g (fA (algebraMap A₁ A₀ a))) hfR₀)
  let qB : B.carrier →ₐ[A₁] T :=
    (Ideal.Quotient.mkₐ A₁ L).comp Algebra.TensorProduct.includeLeft
  have hkill : ∀ b ∈ I₁.map (algebraMap A₁ B.carrier), qB b = 0 := by
    intro b hb
    have hbI : ∀ a ∈ I₁, qB (algebraMap A₁ B.carrier a) = 0 := by
      intro a ha
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      have hscalar :
          (Algebra.TensorProduct.includeLeft : B.carrier →ₐ[A₁] Q)
              (algebraMap A₁ B.carrier a) =
            algebraMap R Q (algebraMap A₁ R a) :=
        (AlgHom.commutes _ a).trans (IsScalarTower.algebraMap_apply A₁ R Q a)
      show (Algebra.TensorProduct.includeLeft : B.carrier →ₐ[A₁] Q)
        (algebraMap A₁ B.carrier a) ∈ L
      rw [hscalar]
      exact Ideal.mem_map_of_mem (algebraMap R Q)
        (Ideal.mem_map_of_mem (algebraMap A₁ R) ha)
    show b ∈ RingHom.ker qB.toRingHom
    exact Ideal.map_le_iff_le_comap.2 hbI hb
  let qB₀ : B₀ →ₐ[A₁] T :=
    Ideal.Quotient.liftₐ (R₁ := A₁) (I₁.map (algebraMap A₁ B.carrier)) qB hkill
  let qB₀' : B₀ →ₐ[A₀] T :=
    { toRingHom := qB₀.toRingHom
      commutes' := by
        intro a
        obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective a
        rw [← hx]
        have hmk : algebraMap A₁ A₀ x = Ideal.Quotient.mk I₁ x := rfl
        calc
          qB₀ (algebraMap A₀ B₀ (Ideal.Quotient.mk I₁ x)) =
              qB₀ (algebraMap A₀ B₀ (algebraMap A₁ A₀ x)) := by rw [← hmk]
          _ = qB₀ (algebraMap A₁ B₀ x) := by
            rw [← IsScalarTower.algebraMap_apply A₁ A₀ B₀ x]
          _ = algebraMap A₁ T x := qB₀.commutes x
          _ = algebraMap A₀ T (algebraMap A₁ A₀ x) :=
            IsScalarTower.algebraMap_apply A₁ A₀ T x
          _ = algebraMap A₀ T (Ideal.Quotient.mk I₁ x) := by rw [hmk] }
  let qR₀ : R₀ →ₐ[A₀] T :=
    { toRingHom := algebraMap R₀ T
      commutes' := fun _ => rfl }
  let f₀ : TensorProduct A₀ R₀ B₀ →ₐ[A₀] T :=
    Algebra.TensorProduct.lift qR₀ qB₀'
      (fun x y => @Commute.all T (inferInstance) (qR₀ x) (qB₀' y))
  let _ : Algebra R₀ (TensorProduct A₀ R₀ B₀) := Algebra.TensorProduct.leftAlgebra
  let f : TensorProduct A₀ R₀ B₀ →ₐ[R₀] T :=
    { toRingHom := f₀.toRingHom
      commutes' := by
        intro r
        show f₀ (r ⊗ₜ[A₀] (1 : B₀)) = qR₀ r
        simp only [f₀, Algebra.TensorProduct.lift_tmul, map_one]
        exact mul_one (qR₀ r) }
  have hf : Function.Surjective f := by
    intro z
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
    induction q using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp [f]⟩
    | tmul b r =>
        refine ⟨r ⊗ₜ[A₀] (Ideal.Quotient.mk _ b), ?_⟩
        show f₀ (r ⊗ₜ[A₀] (Ideal.Quotient.mk _ b)) = _
        simp only [f₀, Algebra.TensorProduct.lift_tmul, qR₀, qB₀', qB₀]
        show (algebraMap R₀ T) (Ideal.Quotient.mk K r) *
          qB₀ (Ideal.Quotient.mk _ b) = _
        rw [Ideal.Quotient.algebraMap_quotient_map_quotient]
        have hqB : qB₀ (Ideal.Quotient.mk _ b) =
            Ideal.Quotient.mk L
              ((Algebra.TensorProduct.includeLeft : B.carrier →ₐ[A₁] Q) b) := rfl
        rw [hqB, ← map_mul (Ideal.Quotient.mk L)]
        congr 1
        rw [Algebra.TensorProduct.algebraMap_eq_includeRight]
        simp only [RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.includeLeft_apply]
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    | add x y hx hy =>
        obtain ⟨u, hu⟩ := hx
        obtain ⟨v, hv⟩ := hy
        exact ⟨u + v, by rw [map_add, map_add, hu, hv]⟩
  let _ : Algebra.FiniteType A₀ B₀ := B.finiteTypeReduction
  let _ : Algebra.FiniteType R₀ (TensorProduct A₀ R₀ B₀) :=
    Algebra.FiniteType.baseChange R₀
  exact finiteType_of_isNilpotent_quotient_finiteType R K Q hK
    (Algebra.FiniteType.of_surjective f hf)

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The reduction of `B ⊗[A₁] A₂` modulo the extension of `I₂` is of finite type over `A₂`. -/
public theorem baseChangedQuotient_finiteType
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) (c : ℕ) (hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) :
    Algebra.FiniteType A₂
      (baseChangedAlgebra (A₂ := A₂) B ⧸ baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B) := by
  let S := baseChangedAlgebra (A₂ := A₂) B
  let _ : Algebra A₂ S := Algebra.TensorProduct.rightAlgebra
  let D := TensorProduct A₁ B.carrier (A₂ ⧸ I₂)
  let _ : Algebra (A₂ ⧸ I₂) D := Algebra.TensorProduct.rightAlgebra
  let _ : Algebra A₂ D := Algebra.compHom D (algebraMap A₂ (A₂ ⧸ I₂))
  let _ : IsScalarTower A₂ (A₂ ⧸ I₂) D :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hD : Algebra.FiniteType A₂ D :=
    Algebra.FiniteType.trans (Algebra.FiniteType.quotient A₂ I₂)
      (baseChangedAlgebra_finiteType B c hc hmap)
  let e₀ := Algebra.TensorProduct.tensorQuotientEquiv (R := A₁)
    A₁ A₂ B.carrier I₂
  let e : D ≃ₐ[A₂] S ⧸ baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B :=
    { toRingEquiv := e₀.toRingEquiv
      commutes' := by
        intro a
        show e₀ ((1 : B.carrier) ⊗ₜ[A₁] (Ideal.Quotient.mk I₂ a)) =
          Ideal.Quotient.mk _ ((1 : B.carrier) ⊗ₜ[A₁] a)
        simp [e₀] }
  exact hD.equiv e

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Extending `I₂` to the completion of `B ⊗[A₁] A₂` is the same as extending the ideal
`baseChangedIdeal B` there. -/
public theorem baseChangedIdeal_completionMap_eq
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    I₂.map (algebraMap A₂
      (AdicCompletion (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
        (baseChangedAlgebra (A₂ := A₂) B))) =
      (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B).map
        (algebraMap (baseChangedAlgebra (A₂ := A₂) B)
          (AdicCompletion (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
            (baseChangedAlgebra (A₂ := A₂) B))) := by
  let S := baseChangedAlgebra (A₂ := A₂) B
  let _ : Algebra A₂ S := Algebra.TensorProduct.rightAlgebra
  let J := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B
  let C := AdicCompletion J S
  show I₂.map (algebraMap A₂ C) =
    (I₂.map (Algebra.TensorProduct.includeRight.toRingHom : A₂ →+* S)).map
      (algebraMap S C)
  rw [Ideal.map_map (Algebra.TensorProduct.includeRight.toRingHom : A₂ →+* S)
    (algebraMap S C)]
  congr 1

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The reduction of the completed base change modulo the extension of `I₂` is of finite type
over `A₂ ⧸ I₂`. -/
public theorem completedReduction_finiteType
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) (c : ℕ) (hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (hI₂ : I₂.FG) :
    Algebra.FiniteType (A₂ ⧸ I₂)
      (AdicCompletion (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
          (baseChangedAlgebra (A₂ := A₂) B) ⧸
        I₂.map (algebraMap A₂
          (AdicCompletion (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
            (baseChangedAlgebra (A₂ := A₂) B)))) := by
  let S := baseChangedAlgebra (A₂ := A₂) B
  let _ : Algebra A₂ S := Algebra.TensorProduct.rightAlgebra
  let J := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B
  let C := AdicCompletion J S
  let K : Ideal C := I₂.map (algebraMap A₂ C)
  have hJ : J.FG := baseChangedIdeal_fg B hI₂
  have hK : K = J.map (algebraMap S C) :=
    baseChangedIdeal_completionMap_eq B
  have hftA₂ : Algebra.FiniteType A₂ (C ⧸ K) := by
    rw [hK]
    exact finiteType_quotient_adicCompletion J hJ
      (baseChangedQuotient_finiteType B c hc hmap)
  let _ : Algebra (A₂ ⧸ I₂) (C ⧸ K) :=
    Ideal.Quotient.algebraQuotientMapQuotient
  exact Algebra.FiniteType.of_restrictScalars_finiteType A₂ (A₂ ⧸ I₂) (C ⧸ K)

/-- The `I₂`-adic completion of the scalar extension `B ⊗[A₁] A₂`. -/
public abbrev completedBaseChangedAlgebra
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :=
  AdicCompletion (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
    (baseChangedAlgebra (A₂ := A₂) B)

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The completed base change of an object, as an object of the category attached to `A₂` and
`I₂`: the `I₂`-adic completion of `B ⊗[A₁] A₂`. -/
public noncomputable abbrev completedBaseChangeObj (I₁ : Ideal A₁) (I₂ : Ideal A₂)
    (c : ℕ) (hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (hI₂ : I₂.FG)
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    AdicFiniteTypeAlgebra.{u₂, max v u₂} A₂ I₂ := by
  let S := baseChangedAlgebra (A₂ := A₂) B
  letI : Algebra A₂ S := Algebra.TensorProduct.rightAlgebra
  let J := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B
  let C := AdicCompletion J S
  have hJ : J.FG := baseChangedIdeal_fg B hI₂
  have hK : I₂.map (algebraMap A₂ C) = J.map (algebraMap S C) :=
    baseChangedIdeal_completionMap_eq B
  have hcomplete : IsAdicComplete (I₂.map (algebraMap A₂ C)) C := by
    rw [hK]
    exact AdicCompletion.isAdicComplete_self J hJ
  letI : Algebra.FiniteType (A₂ ⧸ I₂) (C ⧸ I₂.map (algebraMap A₂ C)) :=
    completedReduction_finiteType B c hc hmap hI₂
  exact ⟨CommAlgCat.of A₂ C, hcomplete, inferInstance⟩

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The `A₂`-algebra map `B ⊗[A₁] A₂ → C ⊗[A₁] A₂` obtained from a morphism `B ⟶ C` by
extension of scalars. -/
public def baseChangedMap
    {B C : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} (f : B ⟶ C) :
    baseChangedAlgebra (A₂ := A₂) B →ₐ[A₂]
      baseChangedAlgebra (A₂ := A₂) C := by
  letI : Algebra A₂ (baseChangedAlgebra (A₂ := A₂) B) :=
    Algebra.TensorProduct.rightAlgebra
  letI : Algebra A₂ (baseChangedAlgebra (A₂ := A₂) C) :=
    Algebra.TensorProduct.rightAlgebra
  let F := Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom f) (AlgHom.id A₁ A₂)
  exact {
    toRingHom := F.toRingHom
    commutes' := by
      intro a
      have h := congrArg
        (fun g : A₂ →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) C => g a)
        (Algebra.TensorProduct.map_comp_includeRight
          (AdicFiniteTypeAlgebra.hom f) (AlgHom.id A₁ A₂))
      change F ((Algebra.TensorProduct.includeRight :
        A₂ →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) B) a) =
        (Algebra.TensorProduct.includeRight :
          A₂ →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) C) a
      simpa only [AlgHom.comp_apply, AlgHom.id_apply] using h }

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Extension of scalars carries the extension of `I₂` in `B ⊗[A₁] A₂` into its extension in
`C ⊗[A₁] A₂`. -/
public theorem baseChangedMap_ideal
    {B C : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} (f : B ⟶ C) :
    (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B).map
      (baseChangedMap (A₂ := A₂) f).toRingHom ≤
        baseChangedIdeal (A₂ := A₂) (I₂ := I₂) C := by
  let _ : Algebra A₂ (baseChangedAlgebra (A₂ := A₂) B) :=
    Algebra.TensorProduct.rightAlgebra
  let _ : Algebra A₂ (baseChangedAlgebra (A₂ := A₂) C) :=
    Algebra.TensorProduct.rightAlgebra
  show (I₂.map (algebraMap A₂ (baseChangedAlgebra (A₂ := A₂) B))).map
      (baseChangedMap (A₂ := A₂) f).toRingHom ≤
    I₂.map (algebraMap A₂ (baseChangedAlgebra (A₂ := A₂) C))
  rw [Ideal.map_map]
  have h : (baseChangedMap (A₂ := A₂) f).toRingHom.comp
      (algebraMap A₂ (baseChangedAlgebra (A₂ := A₂) B)) =
      algebraMap A₂ (baseChangedAlgebra (A₂ := A₂) C) := by
    ext a
    exact (baseChangedMap (A₂ := A₂) f).commutes a
  rw [h]

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The map of completions `(B ⊗[A₁] A₂)^ → (C ⊗[A₁] A₂)^` induced by a morphism `B ⟶ C`. -/
public noncomputable def completedBaseChangeMap
    {B C : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} (f : B ⟶ C) :
    completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B →ₐ[A₂]
      completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) C := by
  let S := baseChangedAlgebra (A₂ := A₂) B
  let T := baseChangedAlgebra (A₂ := A₂) C
  letI : Algebra A₂ S := Algebra.TensorProduct.rightAlgebra
  letI : Algebra A₂ T := Algebra.TensorProduct.rightAlgebra
  let J := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B
  let K := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) C
  let F := baseChangedMap (A₂ := A₂) f
  let h : J.map F.toRingHom ≤ K := baseChangedMap_ideal (A₂ := A₂) f
  let G := completionMap J K F.toRingHom h
  exact {
    toRingHom := G
    commutes' := by
      intro a
      change G (AdicCompletion.of J S (algebraMap A₂ S a)) =
        AdicCompletion.of K T (algebraMap A₂ T a)
      rw [completionMap_of]
      exact congrArg (AdicCompletion.of K T) (F.commutes a) }

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- On the canonical image of the uncompleted tensor product, the completed base change of a
morphism is extension of scalars. -/
public theorem completedBaseChangeMap_of
    {B C : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} (f : B ⟶ C)
    (x : baseChangedAlgebra (A₂ := A₂) B) :
    completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) f
      (AdicCompletion.of (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
        (baseChangedAlgebra (A₂ := A₂) B) x) =
      AdicCompletion.of (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) C)
        (baseChangedAlgebra (A₂ := A₂) C)
        (Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom f) (AlgHom.id A₁ A₂) x) :=
  completionMap_of _ _ _ _ x

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Extension of scalars sends the identity to the identity. -/
public theorem baseChangedMap_id
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    baseChangedMap (A₂ := A₂) (𝟙 B) =
      AlgHom.id A₂ (baseChangedAlgebra (A₂ := A₂) B) := by
  apply AlgHom.ext
  intro x
  show Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom (𝟙 B))
    (AlgHom.id A₁ A₂) x = x
  have h : AdicFiniteTypeAlgebra.hom (𝟙 B) = AlgHom.id A₁ B.carrier := rfl
  rw [h, Algebra.TensorProduct.map_id]
  rfl

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Extension of scalars sends a composite to the composite. -/
public theorem baseChangedMap_comp
    {B C D : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁}
    (f : B ⟶ C) (g : C ⟶ D) :
    baseChangedMap (A₂ := A₂) (f ≫ g) =
      (baseChangedMap (A₂ := A₂) g).comp (baseChangedMap (A₂ := A₂) f) := by
  apply AlgHom.ext
  intro x
  show Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom (f ≫ g))
    (AlgHom.id A₁ A₂) x =
      Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom g) (AlgHom.id A₁ A₂)
        (Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom f) (AlgHom.id A₁ A₂) x)
  have h : AdicFiniteTypeAlgebra.hom (f ≫ g) =
      (AdicFiniteTypeAlgebra.hom g).comp (AdicFiniteTypeAlgebra.hom f) := rfl
  rw [h]
  simpa only [AlgHom.id_comp, AlgHom.comp_apply] using congrArg (fun F => F x)
    (Algebra.TensorProduct.map_comp (AdicFiniteTypeAlgebra.hom g)
      (AdicFiniteTypeAlgebra.hom f) (AlgHom.id A₁ A₂) (AlgHom.id A₁ A₂))

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- The underlying ring homomorphism of the completed base change of a morphism is the induced
map of completions. -/
public theorem completedBaseChangeMap_toRingHom
    {B C : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} (f : B ⟶ C) :
    (completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) f).toRingHom =
      completionMap
        (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
        (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) C)
        (baseChangedMap (A₂ := A₂) f).toRingHom
        (baseChangedMap_ideal (A₂ := A₂) (I₂ := I₂) f) := rfl

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Completed base change sends the identity to the identity. -/
public theorem completedBaseChangeMap_id
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) (𝟙 B) =
      AlgHom.id A₂ (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B) := by
  apply AlgHom.ext
  intro x
  let J := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B
  have hid : J.map (RingHom.id (baseChangedAlgebra (A₂ := A₂) B)) ≤ J := by
    simp
  exact RingHom.congr_fun
    ((completedBaseChangeMap_toRingHom (A₂ := A₂) (I₂ := I₂) (𝟙 B)).trans
      ((completionMap_congr _ _ _ _ _ hid
        (congrArg AlgHom.toRingHom (baseChangedMap_id (A₂ := A₂) B))).trans
        (completionMap_id J hid))) x

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Completed base change sends a composite to the composite. -/
public theorem completedBaseChangeMap_comp
    {B C D : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁}
    (f : B ⟶ C) (g : C ⟶ D) :
    completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) (f ≫ g) =
      (completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) g).comp
        (completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) f) := by
  apply AlgHom.ext
  intro x
  let JB := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B
  let JC := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) C
  let JD := baseChangedIdeal (A₂ := A₂) (I₂ := I₂) D
  let F := (baseChangedMap (A₂ := A₂) f).toRingHom
  let G := (baseChangedMap (A₂ := A₂) g).toRingHom
  let hF : JB.map F ≤ JC := baseChangedMap_ideal (A₂ := A₂) (I₂ := I₂) f
  let hG : JC.map G ≤ JD := baseChangedMap_ideal (A₂ := A₂) (I₂ := I₂) g
  have hbase : (baseChangedMap (A₂ := A₂) (f ≫ g)).toRingHom = G.comp F :=
    congrArg AlgHom.toRingHom (baseChangedMap_comp (A₂ := A₂) f g)
  have hGF : JB.map (G.comp F) ≤ JD := hbase ▸ baseChangedMap_ideal (A₂ := A₂) (I₂ := I₂) (f ≫ g)
  exact RingHom.congr_fun
    ((completedBaseChangeMap_toRingHom (A₂ := A₂) (I₂ := I₂) (f ≫ g)).trans
      ((completionMap_congr _ _ _ _ _ hGF hbase).trans
        (completionMap_comp JB JC JD F G hF hG hGF).symm)) x

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- Completed base change as a functor, without the identification of its values with the
adic completions of the tensor products. -/
public noncomputable def completedBaseChangeFunctor (I₁ : Ideal A₁) (I₂ : Ideal A₂)
    (c : ℕ) (hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (hI₂ : I₂.FG) :
    AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁ ⥤
      AdicFiniteTypeAlgebra.{u₂, max v u₂} A₂ I₂ where
  obj B := completedBaseChangeObj I₁ I₂ c hc hmap hI₂ B
  map f := AdicFiniteTypeAlgebra.homMk (completedBaseChangeMap (A₂ := A₂) (I₂ := I₂) f)
  map_id B := ObjectProperty.hom_ext _ <| CommAlgCat.hom_ext <|
    completedBaseChangeMap_id (A₂ := A₂) (I₂ := I₂) B
  map_comp f g := ObjectProperty.hom_ext _ <| CommAlgCat.hom_ext <|
    completedBaseChangeMap_comp (A₂ := A₂) (I₂ := I₂) f g

/-- A completed base-change functor, canonically identified on objects with
`B ↦ (B ⊗[A₁] A₂)⁁`.

The last two fields say that the identification respects the `A₂`-algebra structure and is
natural on the canonical images of the uncompleted tensor products. -/
public structure CompletedBaseChange where
  /-- The completed base-change functor. -/
  functor : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁ ⥤
    AdicFiniteTypeAlgebra.{u₂, max v u₂} A₂ I₂
  /-- The canonical identification of a base-changed object with the appropriate completion. -/
  completedTensorProductEquiv (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    (functor.obj B).carrier ≃+*
      completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B
  /-- The objectwise identification carries the structural map from `A₂` to the canonical map
  into the completion of the tensor product. -/
  algebraMap_completedTensorProductEquiv
      (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) (a : A₂) :
    completedTensorProductEquiv B (algebraMap A₂ (functor.obj B).carrier a) =
      AdicCompletion.of (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
        (baseChangedAlgebra (A₂ := A₂) B)
        (Algebra.TensorProduct.includeRight a)
  /-- On the canonical dense subrings, the functor acts by scalar extension of algebra maps. -/
  map_completedTensorProductEquiv
      {B C : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} (f : B ⟶ C)
      (x : baseChangedAlgebra (A₂ := A₂) B) :
    completedTensorProductEquiv C
        (AdicFiniteTypeAlgebra.hom (functor.map f)
          ((completedTensorProductEquiv B).symm
            (AdicCompletion.of (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B)
              (baseChangedAlgebra (A₂ := A₂) B) x))) =
      AdicCompletion.of (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) C)
        (baseChangedAlgebra (A₂ := A₂) C)
        (Algebra.TensorProduct.map (AdicFiniteTypeAlgebra.hom f) (AlgHom.id A₁ A₂) x)

/-- **Stacks Project, Tag 0AK0.** If a positive power of `I₁` maps into the finitely generated
ideal `I₂`, then `B ↦ (B ⊗[A₁] A₂)⁁` is a functor between the categories of adically complete
algebras of finite type modulo `I₁` and `I₂`. -/
@[stacks 0AK0]
public noncomputable def completedBaseChange (I₁ : Ideal A₁) (I₂ : Ideal A₂) (c : ℕ)
    (hc : 0 < c) (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (hI₂ : I₂.FG) :
    CompletedBaseChange (A₁ := A₁) (A₂ := A₂) (I₁ := I₁) (I₂ := I₂) :=
  { functor := completedBaseChangeFunctor I₁ I₂ c hc hmap hI₂
    completedTensorProductEquiv := fun _ => RingEquiv.refl _
    algebraMap_completedTensorProductEquiv := fun _ _ => rfl
    map_completedTensorProductEquiv := fun f x =>
      completedBaseChangeMap_of (A₂ := A₂) (I₂ := I₂) f x }

/-- The completed base change `B ↦ (B ⊗[A₁] A₂)⁁` of Stacks Remark 0AL5 over a Noetherian ring
`A₂`, as used by the lemmas of Stacks chapter 88 stated "as in Remark 0AL5 with `A₁` and `A₂`
Noetherian".  The only datum of the remark is that some positive power of `I₁` maps into `I₂`;
finite generation of `I₂` is automatic since `A₂` is Noetherian.  The values are, by definition,
the `I₂`-adic completions `Rig.completedBaseChangedAlgebra B`, with their canonical
`A₂`-algebra structure (`Rig.completedBaseChangeOfIsNoetherianRing_obj_carrier`); the exponent
chosen from `h` only enters the proofs that these completions lie in the category. -/
public noncomputable def completedBaseChangeOfIsNoetherianRing [IsNoetherianRing A₂]
    (h : ∃ c : ℕ, 0 < c ∧ (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) :
    CompletedBaseChange (A₁ := A₁) (A₂ := A₂) (I₁ := I₁) (I₂ := I₂) :=
  completedBaseChange I₁ I₂ h.choose h.choose_spec.1 h.choose_spec.2 I₂.fg_of_isNoetherianRing

/-- The completed base change over a Noetherian ring sends `B` to the `I₂`-adic completion of
`B ⊗[A₁] A₂`. -/
public theorem completedBaseChangeOfIsNoetherianRing_obj_carrier [IsNoetherianRing A₂]
    (h : ∃ c : ℕ, 0 < c ∧ (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    ((completedBaseChangeOfIsNoetherianRing h).functor.obj B).carrier =
      completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B := rfl

/-- The identification of the completed base change over a Noetherian ring with the completion
of the tensor product is the identity. -/
@[simp] public theorem completedBaseChangeOfIsNoetherianRing_completedTensorProductEquiv
    [IsNoetherianRing A₂] (h : ∃ c : ℕ, 0 < c ∧ (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
    (B : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    (completedBaseChangeOfIsNoetherianRing h).completedTensorProductEquiv B =
      RingEquiv.refl _ := rfl

end

