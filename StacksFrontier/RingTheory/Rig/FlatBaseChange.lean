-/

@[expose] public section

namespace TopologicalRing

open Filter
open scoped Topology TensorProduct

universe u

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-! ### Noetherianity of a completed tensor product, symmetrically -/

/-- **Stacks 0GB4, symmetric form.** A completed tensor product of pre-adic Noetherian
algebras is Noetherian as soon as either structure morphism is of finite type on reductions.
Tag 0GB4 gives the case of the first factor; the other case follows by transporting along the
commutativity isomorphism `completedTensorProductComm`. -/
@[ega "0 19.7.1.2" "(i)"]
public theorem completedTensorProduct_isNoetherianRing_of_isFiniteTypeOnReductions
    {B A C : Type*} [CommRing B] [CommRing A] [CommRing C]
    [Algebra B A] [Algebra B C]
    [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
    [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [TopologicalSpace C] [IsTopologicalRing C] [IsLinearTopology C C]
    [IsNoetherianRing A] [IsNoetherianRing C]
    (hA : IsPreAdic A) (hC : IsPreAdic C)
    (hBA : Continuous (algebraMap B A)) (hBC : Continuous (algebraMap B C))
    (hQ : Rig.IsFiniteTypeOnReductions (algebraMap B A) hBA ∨
      Rig.IsFiniteTypeOnReductions (algebraMap B C) hBC) :
    IsNoetherianRing (CompletedTensorProduct (R := B) (M := A) (N := C)) := by
  rcases hQ with hQA | hQC
  · exact completedTensorProduct_isNoetherianRing hBA hBC hA hC
      ⟨topologicalNilradical_le_comap _ hBA, hQA⟩
  · have hNoeth := completedTensorProduct_isNoetherianRing hBC hBA hC hA
      ⟨topologicalNilradical_le_comap _ hBC, hQC⟩
    let : IsNoetherianRing (CompletedTensorProduct (R := B) (M := C) (N := A)) := hNoeth
    exact isNoetherianRing_of_ringEquiv _
      (completedTensorProductComm (B := B) (A := A) (C := C)).symm

/-! ### Transporting locality from the weakly admissible to the Noetherian adic setting -/

/-- A Noetherian adic topological ring is weakly admissible with a countable fundamental system
of open ideals: its ideal of definition consists of topologically nilpotent elements and the
powers of that ideal form a countable basis of neighbourhoods of zero. -/
private theorem isCountablyWeaklyAdmissible_of_isAdic
    {R : Type u} [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
    [IsLinearTopology R R] (hR : IsAdic R) :
    IsCountablyWeaklyAdmissible R := by
  obtain ⟨⟨I, hI, hIadic⟩, hcomplete⟩ := hR
  have hnil : ∀ x ∈ I, IsTopologicallyNilpotent x := by
    intro x hx
    rw [IsTopologicallyNilpotent, Filter.tendsto_def]
    intro U hU
    obtain ⟨n, hn⟩ := hI.2 U hU
    filter_upwards [eventually_ge_atTop n] with m hm
    exact hn (Ideal.pow_le_pow_right hm (Ideal.pow_mem_pow hx m))
  have hcount : (𝓝 (0 : R)).IsCountablyGenerated := by
    rw [hIadic]
    exact I.hasBasis_nhds_zero_adic.isCountablyGenerated
  exact ⟨⟨⟨I, hI.1, hnil⟩, hcomplete.2, hcomplete.1⟩, hcount⟩

/-- A Noetherian adic topological ring is weakly admissible with a countable fundamental system
of open ideals: its ideal of definition consists of topologically nilpotent elements and the
powers of that ideal form a countable basis of neighbourhoods of zero. -/
public alias isCountablyWeaklyAdmissible_of_isAdic' := isCountablyWeaklyAdmissible_of_isAdic

/-- A local property of morphisms of countably indexed weakly admissible rings is in particular
a local property in the Noetherian adic sense of Remark 0ANI. -/
private theorem propertyIsLocalNoetherian_of_propertyIsLocal
    (P : ∀ {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
      [CommRing A] [TopologicalSpace A] [IsTopologicalRing A], (B →+* A) → Prop)
    (hP : PropertyIsLocal P) : PropertyIsLocalNoetherian P := by
  show PropertyIsLocal P (fun R ↦ IsAdic R ∧ IsNoetherianRing R)
  refine ⟨?_, ?_, ?_⟩
  · intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _ _ hA' hB' hProp
    exact hP.localizationPreserves D
      ⟨D.weaklyAdmissibleA, D.countableA⟩ ⟨D.weaklyAdmissibleB, D.countableB⟩
      (isCountablyWeaklyAdmissible_of_isAdic hA'.1)
      (isCountablyWeaklyAdmissible_of_isAdic hB'.1) hProp
  · intro A B A' B' _ _ _ _ _ _ _ _ _ _ D _ _ hA' hB' hFF hProp
    exact hP.faithfullyFlatDescent D
      ⟨D.weaklyAdmissibleA, D.countableA⟩ ⟨D.weaklyAdmissibleB, D.countableB⟩
      (isCountablyWeaklyAdmissible_of_isAdic hA'.1)
      (isCountablyWeaklyAdmissible_of_isAdic hB'.1) hFF hProp
  · intro B _ _ _ _ hB hBcount ι _ A _ _ _ _ hAweak hAcount f hf _ _ hfProp
    exact hP.finiteProduct hB hBcount A hAweak hAcount f hf
      ⟨hB, hBcount⟩ (fun i ↦ ⟨hAweak i, hAcount i⟩) hfProp

/-- A continuous homomorphism topologically of finite type into a topological ring induces a
homomorphism of finite type onto every open quotient of the target: a dense polynomial
presentation becomes a surjection modulo an open ideal. -/
private theorem finiteType_quotient_of_isTopologicallyOfFiniteType
    {B C : Type u} [CommRing B] [CommRing C] [TopologicalSpace C]
    [IsTopologicalRing C] [Algebra B C]
    (h : IsTopologicallyOfFiniteType (algebraMap B C))
    (J : Ideal C) (hJ : IsOpen (J : Set C)) :
    Algebra.FiniteType B (C ⧸ J) := by
  rcases h with ⟨n, f, hf, hdense⟩
  let fA : MvPolynomial (Fin n) B →ₐ[B] C :=
    { f with commutes' := fun b ↦ DFunLike.congr_fun hf b }
  let fq : MvPolynomial (Fin n) B →ₐ[B] C ⧸ J := (Ideal.Quotient.mkₐ B J).comp fA
  have hsurj : Function.Surjective fq := by
    intro y
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨x, hx⟩ := hdense.exists_mem_open (s := {x : C | x - c ∈ J})
      (hJ.preimage (continuous_id.sub continuous_const)) ⟨c, by simp⟩
    exact ⟨x, show Ideal.Quotient.mk J (f x) = Ideal.Quotient.mk J c from Ideal.Quotient.eq.mpr hx⟩
  exact (inferInstance : Algebra.FiniteType B (MvPolynomial (Fin n) B)).of_surjective fq hsurj

/-! ### Adic completions of a base change, as a tower -/

section

open CategoryTheory CategoryTheory.Limits

/-- The map of completions for extended ideals induced by an algebra homomorphism. -/
private noncomputable def adicCompletionMapLinearMap {R S T : Type*} [CommRing R]
    [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
    (I : Ideal R) (f : S →ₐ[R] T) :
    AdicCompletion (I.map (algebraMap R S)) S →ₗ[R]
      AdicCompletion (I.map (algebraMap R T)) T :=
  ((adicCompletionLinearEquivMap I T).toLinearMap.comp
    ((AdicCompletion.map I f.toLinearMap).restrictScalars R)).comp
      (adicCompletionLinearEquivMap I S).symm.toLinearMap

/-- The completion of a surjection is surjective. -/
private theorem adicCompletionMapLinearMap_surjective {R S T : Type*} [CommRing R]
    [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
    (I : Ideal R) (f : S →ₐ[R] T) (hf : Function.Surjective f) :
    Function.Surjective (adicCompletionMapLinearMap I f) := by
  intro y
  obtain ⟨x, hx⟩ := AdicCompletion.map_surjective
    (I := I) (f := f.toLinearMap) hf ((adicCompletionLinearEquivMap I T).symm y)
  refine ⟨(adicCompletionLinearEquivMap I S) x, ?_⟩
  dsimp [adicCompletionMapLinearMap]
  rw [(adicCompletionLinearEquivMap I S).symm_apply_apply, hx]
  exact (adicCompletionLinearEquivMap I T).apply_symm_apply y

/-- An element of an adic completion is determined by its images in the quotient rings. -/
private theorem completion_ext {R : Type*} [CommRing R] (I : Ideal R)
    {x y : AdicCompletion I R} (h : ∀ n, AdicCompletion.evalₐ I n x =
      AdicCompletion.evalₐ I n y) : x = y := by
  refine AdicCompletion.ext fun n ↦ ?_
  exact (Ideal.quotientEquivAlgOfEq R (by simp : I ^ n • (⊤ : Ideal R) = I ^ n)).injective (h n)

/-- The map induced by an algebra homomorphism on the `n`-th stage of the adic completion for an
extended ideal. -/
private def completionQuotientMap {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T)
    (n : ℕ) : S ⧸ (I.map (algebraMap R S)) ^ n →+*
      T ⧸ (I.map (algebraMap R T)) ^ n :=
  Ideal.quotientMap _ f.toRingHom (by
    rw [← Ideal.map_le_iff_le_comap, ← Ideal.map_pow, ← Ideal.map_pow, Ideal.map_map]
    change Ideal.map ((f : S →+* T).comp (algebraMap R S)) (I ^ n) ≤ _
    rw [f.comp_algebraMap])

/-- The stage maps of an algebra homomorphism are compatible with the transition maps. -/
private theorem completionRingMap_compatible {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T)
    {m n : ℕ} (h : m ≤ n) :
    (Ideal.Quotient.factorPow (I.map (algebraMap R T)) h).comp
      ((completionQuotientMap I f n).comp (AdicCompletion.evalₐ _ n).toRingHom) =
      (completionQuotientMap I f m).comp (AdicCompletion.evalₐ _ m).toRingHom := by
  ext x
  have he : (Ideal.Quotient.factorPow (I.map (algebraMap R T)) h).comp
      (completionQuotientMap I f n) =
    (completionQuotientMap I f m).comp
      (Ideal.Quotient.factorPow (I.map (algebraMap R S)) h) := by
    ext s
    rfl
  show (Ideal.Quotient.factorPow _ h)
    (completionQuotientMap I f n (AdicCompletion.evalₐ _ n x)) = _
  rw [show (Ideal.Quotient.factorPow _ h)
      (completionQuotientMap I f n (AdicCompletion.evalₐ _ n x)) =
    completionQuotientMap I f m ((Ideal.Quotient.factorPow _ h)
      (AdicCompletion.evalₐ _ n x)) from DFunLike.congr_fun he _]
  exact congrArg (completionQuotientMap I f m) (AdicCompletion.factorPow_evalₐ _ h x)

/-- The ring homomorphism of adic completions for extended ideals induced by an algebra
homomorphism. -/
private noncomputable def completionRingMap {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T) :
    AdicCompletion (I.map (algebraMap R S)) S →+*
      AdicCompletion (I.map (algebraMap R T)) T :=
  AdicCompletion.liftRingHom _
    (fun n ↦ (completionQuotientMap I f n).comp (AdicCompletion.evalₐ _ n).toRingHom)
    (completionRingMap_compatible I f)

/-- The defining effect of `completionRingMap` on stages. -/
private theorem eval_completionRingMap {R S T : Type*} [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T)
    (n : ℕ) (x : AdicCompletion (I.map (algebraMap R S)) S) :
    AdicCompletion.evalₐ _ n (completionRingMap I f x) =
      completionQuotientMap I f n (AdicCompletion.evalₐ _ n x) := by
  unfold completionRingMap
  exact AdicCompletion.evalₐ_liftRingHom _ _ (completionRingMap_compatible I f) n x

/-- Base change commutes with taking the quotient by a power of an ideal of the first factor. -/
private noncomputable def tensorQuotientPowEquiv
    {B A D : Type*} [CommRing B] [CommRing A] [CommRing D]
    [Algebra B A] [Algebra B D] (I : Ideal A) (m : ℕ) :
    (A ⧸ I ^ m) ⊗[B] D ≃+* (A ⊗[B] D) ⧸ (I.map (algebraMap A (A ⊗[B] D))) ^ m :=
  (Algebra.TensorProduct.quotientTensorEquiv (R := B) B D A (I ^ m)).toRingEquiv.trans
    (Ideal.quotEquivOfEq (Ideal.map_pow _ _ _))

/-- The base-change identification is the evident one on pure tensors. -/
private theorem tensorQuotientPowEquiv_tmul
    {B A D : Type*} [CommRing B] [CommRing A] [CommRing D]
    [Algebra B A] [Algebra B D] (I : Ideal A) (m : ℕ) (a : A) (d : D) :
    tensorQuotientPowEquiv (B := B) I m (Ideal.Quotient.mk _ a ⊗ₜ[B] d) =
      Ideal.Quotient.mk _ (a ⊗ₜ[B] d) :=
  rfl

/-- `completionRingMap` is compatible with the structure maps. -/
private theorem completionRingMap_algebraMap
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T) (s : S) :
    completionRingMap I f (algebraMap S _ s) = algebraMap T _ (f s) := by
  apply completion_ext
  intro n
  rw [eval_completionRingMap]
  simp only [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    AdicCompletion.evalₐ_of]
  rfl

/-- `completionRingMap` of the identity is the identity. -/
private theorem completionRingMap_id
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (I : Ideal R)
    (x : AdicCompletion (I.map (algebraMap R S)) S) :
    completionRingMap I (AlgHom.id R S) x = x := by
  apply completion_ext
  intro n
  rw [eval_completionRingMap]
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
  rw [← hs]
  rfl

/-- Base change of an algebra homomorphism, as a homomorphism of algebras over the untouched
factor. -/
private def tensorRightMap
    {B A D E : Type*} [CommRing B] [CommRing A] [CommRing D] [CommRing E]
    [Algebra B A] [Algebra B D] [Algebra B E] (f : D →ₐ[B] E) :
    A ⊗[B] D →ₐ[A] A ⊗[B] E where
  __ := (Algebra.TensorProduct.map (AlgHom.id B A) f).toRingHom
  commutes' a := by simp

/-- The base-change identification is natural in the second factor. -/
private theorem tensorQuotientPowEquiv_right
    {B A D E : Type*} [CommRing B] [CommRing A] [CommRing D] [CommRing E]
    [Algebra B A] [Algebra B D] [Algebra B E] (I : Ideal A) (m : ℕ)
    (f : D →ₐ[B] E) (x : (A ⧸ I ^ m) ⊗[B] D) :
    completionQuotientMap I (tensorRightMap (A := A) f) m (tensorQuotientPowEquiv I m x) =
      tensorQuotientPowEquiv I m (Algebra.TensorProduct.map (AlgHom.id B _) f x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a d =>
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rfl
  | add x y hx hy => simp only [map_add, hx, hy]

/-- The components of an element of an adic completion are compatible, in the form indexed by an
inclusion of ideal powers. -/
private theorem completion_eval_factor_of_le {R : Type*} [CommRing R] (I : Ideal R)
    {m n : ℕ} (h : I ^ m ≤ I ^ n) (x : AdicCompletion I R) :
    Ideal.Quotient.factor h (AdicCompletion.evalₐ I m x) = AdicCompletion.evalₐ I n x := by
  have hh (z : R ⧸ I ^ max m n) :
      Ideal.Quotient.factor h (Ideal.Quotient.factorPow I (Nat.le_max_left m n) z) =
        Ideal.Quotient.factorPow I (Nat.le_max_right m n) z := by
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    rfl
  calc
    _ = Ideal.Quotient.factor h (Ideal.Quotient.factorPow I (Nat.le_max_left m n)
        (AdicCompletion.evalₐ I (max m n) x)) :=
      congrArg (Ideal.Quotient.factor h) (AdicCompletion.factorPow_evalₐ I _ x).symm
    _ = _ := hh _
    _ = _ := AdicCompletion.factorPow_evalₐ I _ x

/-- The base-change identification is natural in the first factor. -/
private theorem tensorQuotientPowEquiv_left_of_le
    {B A D : Type*} [CommRing B] [CommRing A] [CommRing D]
    [Algebra B A] [Algebra B D] (I : Ideal A) {m n : ℕ} (h : I ^ m ≤ I ^ n)
    (x : (A ⧸ I ^ m) ⊗[B] D) :
    Ideal.Quotient.factor
        (show (I.map (algebraMap A (A ⊗[B] D))) ^ m ≤ (I.map (algebraMap A (A ⊗[B] D))) ^ n by
          simpa only [← Ideal.map_pow] using Ideal.map_mono h)
        (tensorQuotientPowEquiv I m x) =
      tensorQuotientPowEquiv I n (Algebra.TensorProduct.map
        (Ideal.Quotient.factorₐ B h) (AlgHom.id B D) x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a d =>
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rfl
  | add x y hx hy => simp only [map_add, hx, hy]

/-! ### The tower of stagewise completions -/

section TensorLimits

variable {B A C : Type*} [CommRing B] [CommRing A] [CommRing C] [Algebra B A] [Algebra B C]

/-- The `n`-th stage of the tower: the adic completion of `A ⊗_B (C / Jⁿ)`. -/
private abbrev tensorStage (I : Ideal A) (J : Ideal C) (n : ℕ) :=
  AdicCompletion (I.map (algebraMap A (A ⊗[B] (C ⧸ J ^ n)))) (A ⊗[B] (C ⧸ J ^ n))

/-- The double inverse limit of the quotient tensor products. -/
private abbrev tensorDoubleLimit (I : Ideal A) (J : Ideal C) :=
  quotientLimit (B := B) (fun m : ℕ ↦ I ^ m) (fun n : ℕ ↦ J ^ n)

/-- A component projection of the double inverse limit. -/
private def tensorDoubleProjection (I : Ideal A) (J : Ideal C) (m n : ℕ) :
    tensorDoubleLimit (B := B) I J →+* (A ⧸ I ^ m) ⊗[B] (C ⧸ J ^ n) :=
  (Pi.evalRingHom _ (m, n)).comp (quotientLimitSubring
    (B := B) (fun m : ℕ ↦ I ^ m) (fun n : ℕ ↦ J ^ n)).subtype

/-- The components of the double limit are compatible in the first index. -/
private theorem tensorStageProjection_compatibleQuotients (I : Ideal A) (J : Ideal C)
    (n : ℕ) {i j : ℕ} (h : i ≤ j) (x : tensorDoubleLimit (B := B) I J) :
    Ideal.Quotient.factorPow _ h (tensorQuotientPowEquiv I j (x.val (j, n))) =
      tensorQuotientPowEquiv I i (x.val (i, n)) := by
  rw [tensorQuotientPowEquiv_left_of_le I (Ideal.pow_le_pow_right h)]
  congr 1
  simpa only [Ideal.Quotient.factorₐ_refl] using
    x.property (j, n) (i, n) (Ideal.pow_le_pow_right h) le_rfl

/-- The comparison from the double limit to the `n`-th stage of the tower. -/
private noncomputable def tensorStageProjection (I : Ideal A) (J : Ideal C) (n : ℕ) :
    tensorDoubleLimit (B := B) I J →+* tensorStage (B := B) I J n :=
  AdicCompletion.liftRingHom _
    (fun m ↦ (tensorQuotientPowEquiv I m).toRingHom.comp (tensorDoubleProjection I J m n)) (by
      intro i j h
      ext x
      exact tensorStageProjection_compatibleQuotients I J n h x)

/-- The defining effect of `tensorStageProjection` on stages. -/
private theorem eval_tensorStageProjection (I : Ideal A) (J : Ideal C) (m n : ℕ)
    (x : tensorDoubleLimit (B := B) I J) :
    AdicCompletion.evalₐ _ m (tensorStageProjection I J n x) =
      tensorQuotientPowEquiv I m (x.val (m, n)) := by
  let f := fun m ↦ (tensorQuotientPowEquiv (B := B) (D := C ⧸ J ^ n) I m).toRingHom.comp
    (tensorDoubleProjection I J m n)
  have hf : ∀ {i j : ℕ} (h : i ≤ j), (Ideal.Quotient.factorPow _ h).comp (f j) = f i := by
    intro i j h
    ext x
    exact tensorStageProjection_compatibleQuotients I J n h x
  exact AdicCompletion.evalₐ_liftRingHom _ f hf m x

/-- The transition homomorphism of the tower. -/
private noncomputable def tensorStageRingMap (I : Ideal A) (J : Ideal C) {m n : ℕ}
    (h : J ^ n ≤ J ^ m) : tensorStage (B := B) I J n →+* tensorStage (B := B) I J m :=
  completionRingMap I (tensorRightMap (Ideal.Quotient.factorₐ B h))

/-- The comparisons from the double limit form a cone over the tower. -/
private theorem tensorStageProjection_compatible (I : Ideal A) (J : Ideal C)
    {m n : ℕ} (h : J ^ n ≤ J ^ m) (x : tensorDoubleLimit (B := B) I J) :
    tensorStageRingMap I J h (tensorStageProjection I J n x) =
      tensorStageProjection I J m x := by
  apply completion_ext
  intro i
  rw [tensorStageRingMap, eval_completionRingMap, eval_tensorStageProjection,
    tensorQuotientPowEquiv_right, eval_tensorStageProjection]
  congr 1
  simpa only [Ideal.Quotient.factorₐ_refl] using x.property (i, n) (i, m) le_rfl h

/-- The comparisons from the double limit are jointly injective. -/
private theorem tensorStageProjection_jointly_injective (I : Ideal A) (J : Ideal C)
    {x y : tensorDoubleLimit (B := B) I J}
    (h : ∀ n, tensorStageProjection I J n x = tensorStageProjection I J n y) : x = y := by
  apply Subtype.ext
  funext p
  apply (tensorQuotientPowEquiv I p.1).injective
  simpa only [eval_tensorStageProjection] using
    congrArg (AdicCompletion.evalₐ _ p.1) (h p.2)

/-- A compatible family of elements of the tower assembles into an element of the double
limit. -/
private noncomputable def tensorDoubleOfStages (I : Ideal A) (J : Ideal C)
    (x : ∀ n, tensorStage (B := B) I J n)
    (hx : ∀ m n (h : J ^ n ≤ J ^ m), tensorStageRingMap I J h (x n) = x m) :
    tensorDoubleLimit (B := B) I J :=
  ⟨fun p ↦ (tensorQuotientPowEquiv I p.1).symm (AdicCompletion.evalₐ _ p.1 (x p.2)), by
    intro p q hi hj
    have hsplit (z : (A ⧸ I ^ p.1) ⊗[B] (C ⧸ J ^ p.2)) :
        Algebra.TensorProduct.map (Ideal.Quotient.factorₐ B hi)
            (Ideal.Quotient.factorₐ B hj) z =
          Algebra.TensorProduct.map (Ideal.Quotient.factorₐ B hi) (AlgHom.id B _)
            (Algebra.TensorProduct.map (AlgHom.id B _) (Ideal.Quotient.factorₐ B hj) z) := by
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a c => rfl
      | add z w hz hw => simp only [map_add, hz, hw]
    rw [hsplit]
    apply (tensorQuotientPowEquiv I q.1).injective
    rw [← tensorQuotientPowEquiv_left_of_le, ← tensorQuotientPowEquiv_right,
      RingEquiv.apply_symm_apply]
    change Ideal.Quotient.factor _
        (completionQuotientMap I (tensorRightMap (Ideal.Quotient.factorₐ B hj)) p.1
          (AdicCompletion.evalₐ _ p.1 (x p.2))) = _
    rw [← eval_completionRingMap]
    change Ideal.Quotient.factor _
        (AdicCompletion.evalₐ _ p.1 (tensorStageRingMap I J hj (x p.2))) = _
    rw [hx, RingEquiv.apply_symm_apply]
    exact completion_eval_factor_of_le _ _ _⟩

/-- The assembled element of the double limit has the prescribed components. -/
private theorem tensorStageProjection_ofStages (I : Ideal A) (J : Ideal C)
    (x : ∀ n, tensorStage (B := B) I J n)
    (hx : ∀ m n (h : J ^ n ≤ J ^ m), tensorStageRingMap I J h (x n) = x m) (n : ℕ) :
    tensorStageProjection I J n (tensorDoubleOfStages I J x hx) = x n := by
  apply completion_ext
  intro m
  rw [eval_tensorStageProjection]
  exact (tensorQuotientPowEquiv I m).apply_symm_apply _

/-- The transition homomorphisms of the tower compose. -/
private theorem tensorStageRingMap_comp (I : Ideal A) (J : Ideal C)
    {k m n : ℕ} (h : J ^ n ≤ J ^ m) (h' : J ^ m ≤ J ^ k)
    (x : tensorStage (B := B) I J n) :
    tensorStageRingMap I J h' (tensorStageRingMap I J h x) =
      tensorStageRingMap I J (h.trans h') x := by
  apply completion_ext
  intro i
  simp only [tensorStageRingMap, eval_completionRingMap]
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ i x)
  rw [← hs]
  show Ideal.Quotient.mk _
      (tensorRightMap (Ideal.Quotient.factorₐ B h')
        (tensorRightMap (Ideal.Quotient.factorₐ B h) s)) =
    Ideal.Quotient.mk _ (tensorRightMap (Ideal.Quotient.factorₐ B (h.trans h')) s)
  congr 1
  clear hs
  induction s using TensorProduct.induction_on with
  | zero => simp
  | tmul a c =>
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
    rfl
  | add s t hs ht => simp only [map_add, hs, ht]

/-- The identity transition of the tower is the identity. -/
private theorem tensorStageRingMap_id (I : Ideal A) (J : Ideal C)
    (n : ℕ) (x : tensorStage (B := B) I J n) :
    tensorStageRingMap I J (le_refl (J ^ n)) x = x := by
  have hid : tensorRightMap (A := A) (Ideal.Quotient.factorₐ B (le_refl (J ^ n))) =
      AlgHom.id A (A ⊗[B] (C ⧸ J ^ n)) := by
    ext c
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
    rfl
  simp only [tensorStageRingMap, hid, completionRingMap_id]

/-- Compatibility of a family over the tower only has to be checked for the inclusions coming
from inequalities of exponents. -/
private theorem tensorStage_compatible_of_le (I : Ideal A) (J : Ideal C)
    (x : ∀ n, tensorStage (B := B) I J n)
    (hx : ∀ m n (h : m ≤ n), tensorStageRingMap I J (Ideal.pow_le_pow_right h) (x n) = x m)
    (m n : ℕ) (h : J ^ n ≤ J ^ m) : tensorStageRingMap I J h (x n) = x m := by
  calc
    _ = tensorStageRingMap I J h
        (tensorStageRingMap I J (Ideal.pow_le_pow_right (Nat.le_max_right m n))
          (x (max m n))) := congrArg _ (hx n (max m n) (Nat.le_max_right m n)).symm
    _ = _ := tensorStageRingMap_comp I J _ _ _
    _ = _ := hx m (max m n) (Nat.le_max_left m n)

end TensorLimits

/-- The ring homomorphism of completions agrees with the linear map of completions. -/
private theorem completionRingMap_eq_linearMap
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T)
    (x : AdicCompletion (I.map (algebraMap R S)) S) :
    completionRingMap I f x = adicCompletionMapLinearMap I f x := by
  apply completion_ext
  intro n
  rw [eval_completionRingMap]
  show completionQuotientMap I f n (Ideal.quotientEquivAlgOfEq S (by simp) (x.val n)) =
    Ideal.quotientEquivAlgOfEq T (by simp) (quotEquivMapPow I T n
      (LinearMap.reduceModIdeal (I ^ n) f.toLinearMap
        ((quotEquivMapPow I S n).symm (x.val n))))
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (x.val n)
  rw [← hs]
  rfl

/-- The completion of a surjection of algebras is surjective. -/
private theorem completionRingMap_surjective
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] (I : Ideal R) (f : S →ₐ[R] T)
    (hf : Function.Surjective f) : Function.Surjective (completionRingMap I f) := by
  intro y
  obtain ⟨x, hx⟩ := adicCompletionMapLinearMap_surjective I f hf y
  exact ⟨x, (completionRingMap_eq_linearMap I f x).trans hx⟩

section TensorTower

variable {B A C : Type*} [CommRing B] [CommRing A] [CommRing C] [Algebra B A] [Algebra B C]

/-- The stages of the tower are algebras over `C` through the quotient maps. -/
@[instance_reducible] private noncomputable def tensorQuotientAlgebra
    (J : Ideal C) (n : ℕ) : Algebra C (A ⊗[B] (C ⧸ J ^ n)) :=
  Algebra.compHom _ (algebraMap C (C ⧸ J ^ n))

attribute [local instance] tensorQuotientAlgebra

/-- The `C`-algebra structure on a stage factors through its quotient. -/
private theorem tensorQuotient_scalarTower (J : Ideal C) (n : ℕ) :
    IsScalarTower C (C ⧸ J ^ n) (A ⊗[B] (C ⧸ J ^ n)) :=
  IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

attribute [local instance] tensorQuotient_scalarTower

/-- The transition homomorphisms of the tower are `C`-algebra maps. -/
private theorem tensorStageRingMap_algebraMap (I : Ideal A) (J : Ideal C)
    {m n : ℕ} (h : J ^ n ≤ J ^ m) (c : C) :
    tensorStageRingMap (B := B) I J h (algebraMap C _ c) = algebraMap C _ c := by
  show completionRingMap I (tensorRightMap (Ideal.Quotient.factorₐ B h))
    (algebraMap (A ⊗[B] (C ⧸ J ^ n)) _ (1 ⊗ₜ[B] Ideal.Quotient.mk _ c)) = _
  rw [completionRingMap_algebraMap]
  rfl

/-- The transition map of the tower, as a `C`-linear map. -/
private noncomputable def tensorStageMap (I : Ideal A) (J : Ideal C)
    {m n : ℕ} (h : J ^ n ≤ J ^ m) :
    tensorStage (B := B) I J n →ₗ[C] tensorStage (B := B) I J m where
  __ := (tensorStageRingMap I J h).toAddMonoidHom
  map_smul' c x := by
    change tensorStageRingMap I J h (c • x) = c • tensorStageRingMap I J h x
    simp only [Algebra.smul_def, map_mul, tensorStageRingMap_algebraMap]

/-- The tower of stagewise completions, as a diagram of `C`-modules. -/
private noncomputable def tensorStageTower (I : Ideal A) (J : Ideal C) : ℕᵒᵖ ⥤ ModuleCat C where
  obj n := ModuleCat.of C (tensorStage (B := B) I J n.unop)
  map {n m} f := ModuleCat.ofHom (tensorStageMap I J (Ideal.pow_le_pow_right (leOfHom f.unop)))
  map_id n := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change tensorStageRingMap I J (le_refl (J ^ n.unop)) x = x
    exact tensorStageRingMap_id I J n.unop x
  map_comp f g := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change tensorStageRingMap I J _ x = tensorStageRingMap I J _ (tensorStageRingMap I J _ x)
    exact (tensorStageRingMap_comp I J _ _ x).symm

/-- The transition maps of the tower are surjective. -/
private theorem tensorStageMap_surjective (I : Ideal A) (J : Ideal C)
    {m n : ℕ} (h : J ^ n ≤ J ^ m) :
    Function.Surjective (tensorStageMap (B := B) I J h) := by
  apply completionRingMap_surjective
  apply TensorProduct.map_surjective
  · exact Function.surjective_id
  · intro c
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
    exact ⟨Ideal.Quotient.mk _ c, rfl⟩

/-- A ring identified with the double inverse limit, compatibly with the structure map, is flat
over `C` as soon as every stage of the tower is flat over the corresponding quotient of `C`.
This is Tag 0912 applied to the tower `tensorStageTower`. -/
private theorem flat_of_tensorDoubleLimit
    {B A C : Type u} [CommRing B] [CommRing A] [CommRing C]
    [Algebra B A] [Algebra B C] [IsNoetherianRing C]
    (I : Ideal A) (J : Ideal C) (T : Type u) [CommRing T] [Algebra C T]
    (e : T ≃+* tensorDoubleLimit (B := B) I J)
    (he : ∀ c m n, (e (algebraMap C T c)).val (m, n) =
      (1 : A ⧸ I ^ m) ⊗ₜ[B] (Ideal.Quotient.mk (J ^ n) c))
    (hflat : ∀ n, Module.Flat (C ⧸ J ^ n) (tensorStage (B := B) I J n)) :
    Module.Flat C T := by
  let p (n : ℕ) : T →ₐ[C] tensorStage (B := B) I J n :=
    { __ := (tensorStageProjection I J n).comp e.toRingHom
      commutes' := fun c ↦ by
        apply completion_ext
        intro m
        show AdicCompletion.evalₐ _ m
          (tensorStageProjection I J n (e (algebraMap C T c))) = _
        rw [eval_tensorStageProjection, he]
        show tensorQuotientPowEquiv I m
          (Ideal.Quotient.mk _ (1 : A) ⊗ₜ[B] Ideal.Quotient.mk _ c) = _
        rw [tensorQuotientPowEquiv_tmul]
        rfl }
  let F := tensorStageTower (B := B) I J
  let cn : Cone F :=
    { pt := ModuleCat.of C T
      π :=
        { app n := ModuleCat.ofHom (p n.unop).toLinearMap
          naturality := by
            intro n m f
            ext x
            exact (tensorStageProjection_compatible I J
              (Ideal.pow_le_pow_right (leOfHom f.unop)) (e x)).symm } }
  have hsep {x y : T} (h : ∀ n, p n x = p n y) : x = y :=
    e.injective (tensorStageProjection_jointly_injective I J h)
  have hx (s : Cone F) (x : s.pt) : ∀ m n (h : J ^ n ≤ J ^ m),
      tensorStageRingMap I J h ((s.π.app (.op n)) x) = (s.π.app (.op m)) x := by
    apply tensorStage_compatible_of_le I J
    intro m n h
    exact congrArg (fun f : s.pt ⟶ F.obj (.op m) ↦ f x) (s.w (homOfLE h).op)
  let g (s : Cone F) (x : s.pt) : T :=
    e.symm (tensorDoubleOfStages I J (fun n ↦ (s.π.app (.op n)) x) (hx s x))
  have hg (s : Cone F) (x : s.pt) (n : ℕ) : p n (g s x) = (s.π.app (.op n)) x := by
    show tensorStageProjection I J n (e (e.symm _)) = _
    rw [e.apply_symm_apply]
    exact tensorStageProjection_ofStages I J (fun n ↦ (s.π.app (.op n)) x) (hx s x) n
  let lift (s : Cone F) : s.pt ⟶ cn.pt := ModuleCat.ofHom
    { toFun := g s
      map_add' := fun x y ↦ by
        refine hsep fun n ↦ ?_
        exact (hg s (x + y) n).trans
          (((s.π.app (.op n)).hom.map_add x y).trans
            ((congrArg₂ (· + ·) (hg s x n).symm (hg s y n).symm).trans
              (map_add (p n) (g s x) (g s y)).symm))
      map_smul' := fun c x ↦ by
        refine hsep fun n ↦ ?_
        show p n (g s (c • x)) = p n (c • g s x)
        exact (hg s (c • x) n).trans
          (((s.π.app (.op n)).hom.map_smul c x).trans
            ((congrArg (c • ·) (hg s x n).symm).trans
              (map_smul (p n).toLinearMap c (g s x)).symm)) }
  have hc : IsLimit cn := IsLimit.mk lift
    (fun s n ↦ by ext x; exact hg s x n.unop)
    (by
      intro s f hf
      ext x
      refine hsep fun n ↦ ?_
      show p n (f x) = p n (g s x)
      rw [hg]
      exact congrArg (fun f : s.pt ⟶ F.obj (.op n) ↦ f x) (hf (.op n)))
  let qmod : ∀ n : ℕ, Module (C ⧸ J ^ n) (F.obj (.op n)) := fun n ↦
    inferInstanceAs (Module (C ⧸ J ^ n) (tensorStage (B := B) I J n))
  have hscalar : ∀ n : ℕ, let := qmod n
      IsScalarTower C (C ⧸ J ^ n) (F.obj (.op n)) := by
    intro n
    show IsScalarTower C (C ⧸ J ^ n) (tensorStage (B := B) I J n)
    infer_instance
  have hflat' : ∀ n : ℕ, let := qmod n
      Module.Flat (C ⧸ J ^ n) (F.obj (.op n)) := hflat
  have hsurj : ∀ n : ℕ, Function.Surjective (F.map (homOfLE (Nat.le_succ n)).op) :=
    fun n ↦ tensorStageMap_surjective I J _
  have : Module.Flat C (limit.cone F).pt :=
    (flat_limit_and_tensor_limit_of_flat_quotients J F qmod hscalar hflat' hsurj).1
  exact Module.Flat.of_linearEquiv
    ((limit.isLimit F).conePointUniqueUpToIso hc).toLinearEquiv.symm

end TensorTower

end

/-! ### Flatness of a completed base change from Noetherian stages -/

/-- A pre-adic Noetherian ring has a finitely generated ideal of definition. -/
private theorem exists_isIdealOfDefinition_fg {R : Type u} [CommRing R] [TopologicalSpace R]
    [IsNoetherianRing R] (h : IsPreAdic R) : ∃ I : Ideal R, IsIdealOfDefinition I ∧ I.FG := by
  obtain ⟨I, hIdef, -⟩ := h
  exact ⟨I, hIdef, Ideal.fg_of_isNoetherianRing I⟩

/-- Let `B → A` be flat, with `A` and `C` Noetherian adic. If `A ⊗_B C/J^n` is Noetherian for
every ideal of definition `J ⊆ C` and every `n`, then `A ⊗̂_B C` is flat over `C`.

This is the argument shared by both parts of Stacks 0GCA: each stage
`T_n = (A ⊗_B C/J^n)^∧` is flat over `C/J^n`, as the completion of a Noetherian ring flat over
`C/J^n`, and Tag 0912 applied to the tower `T_n` gives flatness of its limit `A ⊗̂_B C`. The two
parts differ only in why the stages `A ⊗_B C/J^n` are Noetherian. -/
private theorem flat_completedTensorProduct_of_isNoetherianRing_stages
    {B A C : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [IsLinearTopology B B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [IsLinearTopology A A] [CommRing C] [TopologicalSpace C] [IsTopologicalRing C]
    [IsLinearTopology C C] [Algebra B A] [Algebra B C] [IsNoetherianRing C]
    (hA : IsAdic A) (hC : IsAdic C) (hP : (algebraMap B A).Flat)
    (hstage : ∀ J : Ideal C, IsIdealOfDefinition J → _root_.IsAdic J →
      ∀ n : ℕ, IsNoetherianRing (A ⊗[B] (C ⧸ J ^ n))) :
    (algebraMap C (CompletedTensorProduct (R := B) (M := A) (N := C))).Flat := by
  let T := CompletedTensorProduct (R := B) (M := A) (N := C)
  obtain ⟨IA, -, hIAadic⟩ := hA.1
  obtain ⟨JC, hJCdef, hJCadic⟩ := hC.1
  have hAflat : Module.Flat B A := RingHom.flat_algebraMap_iff.mp hP
  have hstageFlat (n : ℕ) :
      Module.Flat (C ⧸ JC ^ n)
        (AdicCompletion
          (Ideal.map (Algebra.TensorProduct.includeLeft :
            A →ₐ[B] A ⊗[B] (C ⧸ JC ^ n)).toRingHom IA)
          (A ⊗[B] (C ⧸ JC ^ n))) := by
    let D := C ⧸ JC ^ n
    let S := A ⊗[B] D
    let K : Ideal S := Ideal.map (Algebra.TensorProduct.includeLeft : A →ₐ[B] S).toRingHom IA
    have : IsNoetherianRing S := hstage JC hJCdef hJCadic n
    have : Module.Flat D (D ⊗[B] A) := Module.Flat.baseChange B D A
    have : Module.Flat D S :=
      Module.Flat.of_linearEquiv (Algebra.TensorProduct.commRight B D A).toLinearEquiv.symm
    exact Module.Flat.trans D S (AdicCompletion K S)
  apply RingHom.flat_algebraMap_iff.mpr
  have bI : (𝓝 (0 : A)).HasBasis (fun _ : ℕ ↦ True) (fun m ↦ (IA ^ m : Ideal A)) := by
    rw [hIAadic]
    exact IA.hasBasis_nhds_zero_adic
  have bJ : (𝓝 (0 : C)).HasBasis (fun _ : ℕ ↦ True) (fun n ↦ (JC ^ n : Ideal C)) := by
    rw [hJCadic]
    exact JC.hasBasis_nhds_zero_adic
  obtain ⟨e, _, _, he⟩ := exists_completedTensorProductRingEquivQuotientLimit
    (B := B) (fun m : ℕ ↦ IA ^ m) (fun n : ℕ ↦ JC ^ n) bI bJ
  apply flat_of_tensorDoubleLimit IA JC T e ?_ hstageFlat
  intro c m n
  show (e (↑((1 : A) ⊗ₜ[B] c) : T)).val (m, n) = _
  rw [he]
  simp only [Algebra.TensorProduct.map_tmul, map_one]
  rfl

/-! ### Part (1): base change by a morphism of finite type on reductions -/

/-- **Stacks 0GCA, part (1).** Flatness of morphisms of Noetherian adic topological rings
(Stacks 0GC9) is stable under completed tensor-product base change along morphisms of finite
type on reductions (Stacks 0GC2), in the sense of Remark 0GBG. -/
@[stacks 0GCA "part (1)"]
public theorem flat_isStableUnderBaseChangeByFiniteTypeOnReductions :
    IsStableUnderBaseChangeBy
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] (φ : B →+* A) ↦ φ.Flat)
      FiniteTypeOnReductionsProperty := by
  refine ⟨flat_isLocalNoetherian,
    propertyIsLocalNoetherian_of_propertyIsLocal _ isFiniteTypeOnReductions_propertyIsLocal, ?_⟩
  intro B A C _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hA hC hBA hBC hP hQ
  have hAfg := exists_isIdealOfDefinition_fg hA.1
  have hCfg := exists_isIdealOfDefinition_fg hC.1
  rcases hQ with ⟨_, hredQ⟩
  have hredC : Rig.IsFiniteTypeOnReductions (algebraMap B C) hBC := hredQ
  have hCweak := isCountablyWeaklyAdmissible_of_isAdic hC
  have hBCtft : IsTopologicallyOfFiniteType (algebraMap B C) :=
    Rig.isTopologicallyOfFiniteType_of_isFiniteTypeOnReductions
      (algebraMap B C) hBC hCweak.1 hredC
  have hstage (J : Ideal C) (_ : IsIdealOfDefinition J) (hJ : _root_.IsAdic J) (n : ℕ) :
      IsNoetherianRing (A ⊗[B] (C ⧸ J ^ n)) := by
    have := finiteType_quotient_of_isTopologicallyOfFiniteType hBCtft (J ^ n)
      ((isAdic_iff.mp hJ).1 n)
    exact Algebra.FiniteType.isNoetherianRing A _
  exact ⟨completedTensorProduct_isAdic hBA hBC hA.1 hAfg hC.1 hCfg,
    completedTensorProduct_isNoetherianRing_of_isFiniteTypeOnReductions hA.1 hC.1 hBA hBC
      (Or.inr hredC),
    flat_completedTensorProduct_of_isNoetherianRing_stages hA hC hP hstage⟩

/-! ### Part (2): arbitrary base change of a flat adic morphism of topologically finite type -/

/-- Two local properties of morphisms have a local conjunction: each of the three axioms of
Situation 0CBA holds for `P ∧ Q` because it holds for `P` and for `Q` separately. -/
public theorem PropertyIsLocal.and
    {P Q : ∀ {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
      [CommRing A] [TopologicalSpace A] [IsTopologicalRing A], (B →+* A) → Prop}
    {K : ∀ (R : Type u) [CommRing R] [TopologicalSpace R] [IsTopologicalRing R]
      [IsLinearTopology R R], Prop}
    (hP : PropertyIsLocal P K) (hQ : PropertyIsLocal Q K) :
    PropertyIsLocal (fun φ ↦ P φ ∧ Q φ) K := by
  refine ⟨?_, ?_, ?_⟩
  · intro A B A' B' _ _ _ _ _ _ _ _ _ _ D hA hB hA' hB' h
    exact ⟨hP.localizationPreserves D hA hB hA' hB' h.1,
      hQ.localizationPreserves D hA hB hA' hB' h.2⟩
  · intro A B A' B' _ _ _ _ _ _ _ _ _ _ D hA hB hA' hB' hff h
    exact ⟨hP.faithfullyFlatDescent D hA hB hA' hB' hff h.1,
      hQ.faithfullyFlatDescent D hA hB hA' hB' hff h.2⟩
  · intro B _ _ _ _ hB hBcount ι _ A _ _ _ _ hAw hAcount f hf hKB hKA h
    exact ⟨hP.finiteProduct hB hBcount A hAw hAcount f hf hKB hKA (fun i ↦ (h i).1),
      hQ.finiteProduct hB hBcount A hAw hAcount f hf hKB hKA (fun i ↦ (h i).2)⟩

/-- If `B → A` is adic and topologically of finite type, all three rings being Noetherian adic,
then `A ⊗_B C/J^n` is Noetherian for every open ideal `J^n` of `C`.

Some power `I^k` of an ideal of definition `I ⊆ B` with `I A` an ideal of definition of `A`
maps into `J^n`, so the `B`-algebra map `A → A ⊗_B C/J^n` kills the open ideal `I^k A`, and
`A ⊗_B C/J^n` is a quotient of `C/J^n ⊗_B A/I^kA`. The latter is of finite type over the
Noetherian ring `C/J^n`, because `B → A/I^kA` is of finite type. -/
private theorem isNoetherianRing_tensor_quotient_of_isAdic_of_isTopologicallyOfFiniteType
    {B A C : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [CommRing A]
    [TopologicalSpace A] [IsTopologicalRing A] [CommRing C] [TopologicalSpace C] [Algebra B A]
    [Algebra B C] [IsNoetherianRing C] (hBC : Continuous (algebraMap B C))
    (hadic : RingHom.IsAdic (algebraMap B A))
    (hft : IsTopologicallyOfFiniteType (algebraMap B A))
    (J : Ideal C) (hJ : IsOpen (J : Set C)) :
    IsNoetherianRing (A ⊗[B] (C ⧸ J)) := by
  obtain ⟨I, hI, hIA⟩ := hadic
  let D := C ⧸ J
  have hpre : (algebraMap B C) ⁻¹' (J : Set C) ∈ 𝓝 (0 : B) :=
    (hJ.preimage hBC).mem_nhds (by simp)
  obtain ⟨k, hk⟩ := (isAdic_iff.mp hI).2 _ hpre
  let K : Ideal A := (I ^ k).map (algebraMap B A)
  have hKopen : IsOpen (K : Set A) := by
    show IsOpen (((I ^ k).map (algebraMap B A) : Ideal A) : Set A)
    rw [Ideal.map_pow]
    exact (isAdic_iff.mp hIA).1 k
  have hKft := finiteType_quotient_of_isTopologicallyOfFiniteType hft K hKopen
  have hle : K ≤ RingHom.ker
      ((Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] D) : A →+* A ⊗[B] D) := by
    refine Ideal.map_le_of_le_comap fun b hb ↦ ?_
    show (Algebra.TensorProduct.includeLeft : A →ₐ[B] A ⊗[B] D) (algebraMap B A b) = 0
    rw [AlgHom.commutes, ← (Algebra.TensorProduct.includeRight : D →ₐ[B] A ⊗[B] D).commutes,
      IsScalarTower.algebraMap_apply B C D, Ideal.Quotient.algebraMap_eq,
      (Ideal.Quotient.eq_zero_iff_mem).mpr (hk hb), map_zero]
  let g : A ⧸ K →ₐ[B] A ⊗[B] D :=
    Ideal.Quotient.liftₐ K Algebra.TensorProduct.includeLeft fun _ ha ↦ hle ha
  let h : D ⊗[B] (A ⧸ K) →ₐ[B] A ⊗[B] D :=
    Algebra.TensorProduct.lift Algebra.TensorProduct.includeRight g fun _ _ ↦ Commute.all _ _
  have hsurj : Function.Surjective h := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero h⟩
    | tmul a d =>
      refine ⟨d ⊗ₜ[B] Ideal.Quotient.mk K a, ?_⟩
      rw [Algebra.TensorProduct.lift_tmul]
      show (1 : A) ⊗ₜ[B] d * (a ⊗ₜ[B] (1 : D)) = a ⊗ₜ[B] d
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
    | add x y hx hy =>
      obtain ⟨x', rfl⟩ := hx
      obtain ⟨y', rfl⟩ := hy
      exact ⟨x' + y', map_add h x' y'⟩
  have : IsNoetherianRing (D ⊗[B] (A ⧸ K)) := Algebra.FiniteType.isNoetherianRing D _
  exact isNoetherianRing_of_surjective _ _ h.toRingHom hsurj

/-- **Stacks 0GCA, part (2).** Flatness (Stacks 0GC9) together with the property of Stacks
0GBW, being adic and topologically of finite type, is stable under base change in the sense of
Remark 0GBF: for continuous homomorphisms `B → A` and `B → C` of Noetherian adic topological
rings with `B → A` flat, adic and topologically of finite type, the completed tensor product
`A ⊗̂_B C` is Noetherian adic and `C → A ⊗̂_B C` is again flat, adic and topologically of finite
type. No condition is imposed on `B → C`. -/
@[stacks 0GCA "part (2)"]
public theorem flatAdicFiniteType_isStableUnderBaseChange :
    IsStableUnderBaseChangeNoetherian
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] (φ : B →+* A) ↦
        φ.Flat ∧ RingHom.IsAdic φ ∧ IsTopologicallyOfFiniteType φ) := by
  refine ⟨PropertyIsLocal.and flat_isLocalNoetherian adicAndFiniteType_propertyIsLocalNoetherian,
    ?_⟩
  intro B A C _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hB hA hC hBA hBC ⟨hP, hR⟩
  have hAfg := exists_isIdealOfDefinition_fg hA.1
  have hCfg := exists_isIdealOfDefinition_fg hC.1
  have hBweak := isCountablyWeaklyAdmissible_of_isAdic hB
  have hred : Rig.IsFiniteTypeOnReductions (algebraMap B A) hBA :=
    Rig.isFiniteTypeOnReductions_of_isTaut_of_isTopologicallyOfFiniteType (algebraMap B A) hBA
      hBweak.1.1 (RingHom.isTaut_of_isAdic (algebraMap B A) hBA hR.1) hR.2
  have hstage (J : Ideal C) (_ : IsIdealOfDefinition J) (hJ : _root_.IsAdic J) (n : ℕ) :
      IsNoetherianRing (A ⊗[B] (C ⧸ J ^ n)) :=
    isNoetherianRing_tensor_quotient_of_isAdic_of_isTopologicallyOfFiniteType hBC hR.1 hR.2
      (J ^ n) ((isAdic_iff.mp hJ).1 n)
  exact ⟨completedTensorProduct_isAdic hBA hBC hA.1 hAfg hC.1 hCfg,
    completedTensorProduct_isNoetherianRing_of_isFiniteTypeOnReductions hA.1 hC.1 hBA hBC
      (Or.inl hred),
    flat_completedTensorProduct_of_isNoetherianRing_stages hA hC hP hstage,
    isAdic_and_isTopologicallyOfFiniteType_completedTensorProduct_baseChange
      (isCountablyWeaklyAdmissible_of_isAdic hA).1 (isCountablyWeaklyAdmissible_of_isAdic hC).1
      (Rig.exists_fg_isAdic_of_isAdicRing hC) hBA hBC hR⟩

end TopologicalRing

