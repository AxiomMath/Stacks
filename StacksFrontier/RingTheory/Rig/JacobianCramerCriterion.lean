module

public import StacksFrontier.RingTheory.Rig.JacobianCramer
public import StacksFrontier.RingTheory.Rig.RigEtaleCriterion

/-!
# The Jacobian–Cramer criterion for rig-étaleness: part (7) of Stacks 0AJU

Let `A` be a Noetherian ring, `I ⊆ A` an ideal, `B` an `I`-adically complete `A`-algebra of
finite type modulo `I`, and fix a completed polynomial presentation
`B = A⟨x₁, …, x_r⟩ / J`.  Choosing generators `f₁, …, f_t` of `J`, part (7) of Stacks 0AJU
reads

* (a) the **Jacobian ideal** of `B` over `A` — the ideal of `B` generated by the `r × r`
  minors of the matrix `(∂fⱼ/∂xᵢ)` — contains `IᶜB` for some `c`;
* (b) the **Cramer ideal** of `B` over `A` — the image in `B` of the `r`th Fitting ideal of
  `J` as a module over `A⟨x₁, …, x_r⟩` — contains `IᶜB` for some `c`.

This file defines the two ideals and proves that (a) together with (b) is equivalent to
rig-étaleness of `B` over `(A, I)`.

## Main definitions

* `Rig.completedJacobianMatrix` and `Rig.completedJacobianIdeal`: the Jacobian matrix of a
  family of elements of `J` and the ideal generated by its maximal minors.
* `Rig.completedCramerIdeal`: the Cramer ideal of a completed polynomial presentation.

## Main results

* `Rig.fittingIdeal_cotangent_eq_completedCramerIdeal`: the Cramer ideal is `Fit_r(J / J²)`.
* `Rig.isRigEtale_iff_exists_pow_le_completedJacobianIdeal_and_completedCramerIdeal`:
  **Stacks 0AJY**, part (7) of Stacks 0AJU.

## Implementation notes

The two identifications that turn condition (7) into the cohomological condition (3) are the
ones the source makes in its proof.  The Jacobian ideal is `Fit₀(H⁰(NL^∧_{B/A}))`: the classes
of `f₁, …, f_t` generate `J / J²`, so the image of the differential `J / J² → ⨁ i, B dxᵢ` is
spanned by the columns of the Jacobian matrix, and the cokernel is therefore presented by that
matrix.  The Cramer ideal is `Fit_r(J / J²)`: the conormal module is `B ⊗_{A⟨x⟩} J`
(`Algebra.Extension.cotangentEquiv`), and Fitting ideals commute with scalar extension.  With
both identifications in hand the statement is
`Rig.exists_pow_le_annihilator_iff_exists_pow_le_fittingIdeal` applied to the differential,
composed with `Rig.isRigEtale_iff_exists_annihilator_cohomology`.

The source's condition (3) uses one exponent for both cohomology modules while condition (7)
allows a separate exponent in each of (a) and (b); `Rig.exists_pow_le_and_iff` reconciles the
two, since the conditions only weaken as the exponent grows.

## References

* [Stacks Project, Tag 0AJU](https://stacks.math.columbia.edu/tag/0AJU)
* [Stacks Project, Tag 0AJY](https://stacks.math.columbia.edu/tag/0AJY)
-/

universe u v

@[expose] public noncomputable section

namespace Rig

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}

/-- Two ideals each containing a power of `K` is the same as a single power of `K` lying in
both, since the powers of `K` decrease. -/
public theorem exists_pow_le_and_iff {R : Type*} [CommRing R] (K U V : Ideal R) :
    (∃ c : ℕ, K ^ c ≤ U ∧ K ^ c ≤ V) ↔ (∃ c : ℕ, K ^ c ≤ U) ∧ ∃ c : ℕ, K ^ c ≤ V := by
  refine ⟨fun ⟨c, h₁, h₂⟩ => ⟨⟨c, h₁⟩, ⟨c, h₂⟩⟩, fun ⟨⟨c₁, h₁⟩, ⟨c₂, h₂⟩⟩ => ⟨max c₁ c₂, ?_, ?_⟩⟩
  · exact le_trans (Ideal.pow_le_pow_right (le_max_left c₁ c₂)) h₁
  · exact le_trans (Ideal.pow_le_pow_right (le_max_right c₁ c₂)) h₂

/-- The Jacobian matrix of a family `f` of elements of the completed polynomial algebra of a
presentation `B = A⟨x₁, …, x_r⟩ / J`: its `(i, j)` entry is the image in `B` of `∂fⱼ/∂xᵢ`. -/
public def completedJacobianMatrix (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B) {t : ℕ}
    (f : Fin t → P.completedPolynomialRing) :
    Matrix (Fin P.variableCount) (Fin t) B.carrier :=
  fun i j => P.toAlgHom ((completedNaiveCotangentComplex B P).partialDeriv i (f j))

/-- The Jacobian ideal of `B` over `A` attached to a family `f` of generators of `J`: the ideal
of `B` generated by the `r × r` minors of the Jacobian matrix of `f`. -/
public def completedJacobianIdeal (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B) {t : ℕ}
    (f : Fin t → P.completedPolynomialRing) : Ideal B.carrier :=
  minorIdeal (completedJacobianMatrix B P f) P.variableCount

/-- The Cramer ideal of `B` over `A`: the image in `B` of the `r`th Fitting ideal of `J`
viewed as a module over the completed polynomial algebra `A⟨x₁, …, x_r⟩`. -/
public def completedCramerIdeal (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B) : Ideal B.carrier :=
  (fittingIdeal (R := P.completedPolynomialRing) (M := P.ker) (P.variableCount : ℤ)).map
    P.toAlgHom.toRingHom

/-- The completed polynomial algebra of a presentation is Noetherian, also when it is viewed
as the ring of the associated extension. -/
public instance isNoetherianRing_extension_ring (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B) : IsNoetherianRing P.extension.Ring :=
  inferInstanceAs (IsNoetherianRing P.completedPolynomialRing)

/-- The conormal module `J / J²` of a completed polynomial presentation is a finite
`B`-module, since `J` is a finitely generated ideal. -/
public instance moduleFinite_extension_cotangent (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B) :
    Module.Finite B.carrier P.extension.Cotangent :=
  Algebra.Extension.Cotangent.finite (Ideal.fg_of_isNoetherianRing P.extension.ker)

omit [IsNoetherianRing A] in
/-- The conormal module `J / J²` is generated over `B` by the classes of any family of
generators of `J`. -/
public theorem span_range_cotangentMk_eq_top (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B) {t : ℕ} (g : Fin t → P.extension.ker)
    (hg : P.extension.ker ≤ Ideal.span (Set.range fun j => (g j : P.extension.Ring))) :
    Submodule.span B.carrier
        (Set.range fun j => Algebra.Extension.Cotangent.mk (g j)) = ⊤ := by
  refine top_unique fun x _ => ?_
  obtain ⟨y, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective x
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp (hg y.2)
  have hy : y = ∑ j, c j • g j := Subtype.ext (by simpa using hc.symm)
  rw [hy, map_sum]
  refine Submodule.sum_mem _ fun j _ => ?_
  rw [map_smul, ← algebraMap_smul B.carrier (c j)]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

/-- The image of the differential `J / J² → ⨁ i, B dxᵢ` is spanned by the columns of the
Jacobian matrix of a family of generators of `J`. -/
public theorem range_differential_eq_span_completedJacobianMatrix
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (P : CompletedPolynomialPresentation I B) {t : ℕ}
    (f : Fin t → P.completedPolynomialRing) (hf : P.ker = Ideal.span (Set.range f)) :
    LinearMap.range (completedNaiveCotangentComplex B P).differential =
      Submodule.span B.carrier
        (Set.range fun j => fun i => completedJacobianMatrix B P f i j) := by
  have hmem : ∀ j, f j ∈ P.extension.ker := fun j => hf.ge (Ideal.subset_span ⟨j, rfl⟩)
  set g : Fin t → P.extension.ker := fun j => ⟨f j, hmem j⟩
  have hcol : ∀ j, (completedNaiveCotangentComplex B P).differential
      (Algebra.Extension.Cotangent.mk (g j)) =
        fun i => completedJacobianMatrix B P f i j :=
    fun j => (completedNaiveCotangentComplex B P).differential_mk (g j)
  refine le_antisymm ?_ ?_
  · rw [LinearMap.range_eq_map, ← span_range_cotangentMk_eq_top B P g hf.le,
      Submodule.map_span, Submodule.span_le]
    rintro z ⟨w, ⟨j, rfl⟩, rfl⟩
    exact Submodule.subset_span ⟨j, (hcol j).symm⟩
  · rw [Submodule.span_le]
    rintro z ⟨j, rfl⟩
    exact ⟨Algebra.Extension.Cotangent.mk (g j), hcol j⟩

/-- The zeroth Fitting ideal of `H⁰(NL^∧_{B/A}) = coker(J / J² → ⨁ i, B dxᵢ)` is the Jacobian
ideal of any family of generators of `J`. -/
public theorem fittingIdeal_zero_quotient_range_differential_eq
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (P : CompletedPolynomialPresentation I B) {t : ℕ}
    (f : Fin t → P.completedPolynomialRing) (hf : P.ker = Ideal.span (Set.range f)) :
    fittingIdeal (R := B.carrier)
        (M := (Fin P.variableCount → B.carrier) ⧸
          LinearMap.range (completedNaiveCotangentComplex B P).differential) 0 =
      completedJacobianIdeal B P f := by
  have e := Submodule.quotEquivOfEq
    (Submodule.span B.carrier (Set.range fun j => fun i => completedJacobianMatrix B P f i j))
    (LinearMap.range (completedNaiveCotangentComplex B P).differential)
    (range_differential_eq_span_completedJacobianMatrix B P f hf).symm
  simpa [completedJacobianIdeal] using
    fittingIdeal_eq_minorIdeal_of_presentation (completedJacobianMatrix B P f) 0 e

/-- The Cramer ideal is the `r`th Fitting ideal of the conormal module `J / J²`, because
`J / J² = B ⊗_{A⟨x₁, …, x_r⟩} J` and Fitting ideals commute with scalar extension. -/
public theorem fittingIdeal_cotangent_eq_completedCramerIdeal
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (P : CompletedPolynomialPresentation I B) :
    fittingIdeal (R := B.carrier) (M := P.extension.Cotangent) (P.variableCount : ℤ) =
      completedCramerIdeal B P := by
  rw [← fittingIdeal_eq_of_linearEquiv (Algebra.Extension.cotangentEquiv P.extension)
    P.variableCount]
  exact (fittingIdeal_basic_properties.{u, u, u, v} (R := P.extension.Ring)
    (M := P.extension.ker)).2.2.1 B.carrier P.variableCount

/-- **Stacks 0AJY**, part (7) of Stacks 0AJU.  For an `I`-adically complete `A`-algebra `B` of
finite type modulo `I` over a Noetherian ring `A`, a completed polynomial presentation
`B = A⟨x₁, …, x_r⟩ / J` and generators `f₁, …, f_t` of `J`, rig-étaleness of `B` over `(A, I)`
is equivalent to the Jacobian ideal and the Cramer ideal of `B` over `A` each containing a
power of `IB`. -/
@[stacks 0AJY "(7) of 0AJU, as an equivalence with rig-étaleness"]
public theorem isRigEtale_iff_exists_pow_le_completedJacobianIdeal_and_completedCramerIdeal
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (P : CompletedPolynomialPresentation I B) {t : ℕ}
    (f : Fin t → P.completedPolynomialRing) (hf : P.ker = Ideal.span (Set.range f)) :
    IsRigEtale B ↔
      ((∃ c : ℕ, (I ^ c).map (algebraMap A B.carrier) ≤ completedJacobianIdeal B P f) ∧
        ∃ c : ℕ, (I ^ c).map (algebraMap A B.carrier) ≤ completedCramerIdeal B P) := by
  have hcore := exists_pow_le_annihilator_iff_exists_pow_le_fittingIdeal
    (I.map (algebraMap A B.carrier)) (completedNaiveCotangentComplex B P).differential
  rw [fittingIdeal_zero_quotient_range_differential_eq B P f hf,
    fittingIdeal_cotangent_eq_completedCramerIdeal B P] at hcore
  rw [isRigEtale_iff_exists_annihilator_cohomology B P]
  simp only [Ideal.map_pow]
  rw [exists_pow_le_and_iff, hcore, and_comm]

end Rig

end
