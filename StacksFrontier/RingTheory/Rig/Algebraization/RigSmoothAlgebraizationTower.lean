module

public import Mathlib.RingTheory.Smooth.Flat
public import Mathlib.RingTheory.Smooth.Locus
public import StacksFrontier.RingTheory.Rig.Algebraization.RigEtaleAlgebraizationTower
public import StacksFrontier.RingTheory.Rig.Algebraization.SmoothAlgebraizationTower
public import StacksFrontier.RingTheory.Rig.RigSmoothAlgEquiv

/-!
# The induction of Gabber–Zavyalov: algebraization of rig-smooth algebras

Let `A` be a Noetherian ring, `I = (s ∪ {a})` and `B` rig-smooth over `(A, I)`.  This file runs the
induction of Gabber–Zavyalov [Theorem 1.2] (the main claim of Stacks 0GAX) on the number of
generators of `I`, in the form in which the library runs the induction of Stacks 0AKA for
rig-étale algebras (`RigEtaleAlgebraizationTower.lean`): the quotients `B ⧸ aᵐ B` are algebraized
by the induction hypothesis, the algebraizations are made compatible one level at a time by a
square-zero lifting lemma, and the limit `B'` of the resulting system is algebraized by the case of
a principal ideal.

## The pieces proved here

* `Rig.isRigSmooth_completedBaseChange_quotient_span_pow`: the completed base change of `B` to
  `Ā = A ⧸ (aᵐ)` with the ideal `Ī` generated by the image of `s` is rig-smooth (Stacks 0GAM,
  since `V(I Ā) = V(Ī)`).
* `Rig.SmoothAwayFrom.of_le_radical`, `Rig.smoothAwayFrom_iff_of_radical_eq`: smoothness off
  `V(I)` depends only on the radical of `I`.
* `Rig.flat_away_of_smoothAwayFrom`: for `D` of finite type and smooth off `V(J)`, the
  localizations at elements of `J` of the completion of `D` are flat.
* `Rig.exists_level_of_isRigSmooth`: for every `m ≥ 1` a finite type `Ā`-algebra, smooth off
  `V(I)`, whose `I`-adic completion is `B ⧸ aᵐ B` (Stacks 0GAK (2) supplies the localization).
* `Rig.exists_next_of_isRigSmooth`: a level `n` lifts to a level `n + 1`.
* `Rig.SmoothAlgebraizationTower.exists_algebraization`: a compatible system algebraizes `B`.
* `Rig.exists_finiteType_algEquiv_of_isRigSmooth_span`: the induction.

## Inputs carried as hypotheses

Three inputs are proved elsewhere in this development and are taken here as explicit
hypotheses, each the statement of the corresponding lemma, so that this file does not wait for
them; none of the declarations here is registered.

* `hLift`: the smooth square-zero lifting lemma (`Rig.exists_squareZeroLift_of_smoothAwayFrom`),
  the rig-smooth counterpart of `Rig.exists_squareZeroLift`.
* `hPrincipal`: the principal case, Elkik [III, Theorem 7]
  (`Rig.exists_finiteType_adicCompletion_algEquiv_of_isRigSmooth_principal`).
* `hSmoothify`: the limit of a compatible system of smooth algebraizations of the quotients
  `B ⧸ aⁿ⁺¹ B` is rig-smooth over `(A, (a))`
  (`Rig.isRigSmooth_of_isBijectiveMod_of_smoothAwayFrom_quotients`).

## References

* [Stacks Project, Tag 0GAX](https://stacks.math.columbia.edu/tag/0GAX)
* [Stacks Project, Tag 0GAK](https://stacks.math.columbia.edu/tag/0GAK)
* [Stacks Project, Tag 0GAM](https://stacks.math.columbia.edu/tag/0GAM)
* [Stacks Project, Tag 0AKA](https://stacks.math.columbia.edu/tag/0AKA)
* O. Gabber, B. Zavyalov, *Rigid-analytic varieties with projective reduction*, Theorem 1.2.
-/

@[expose] public noncomputable section

open CategoryTheory

namespace Rig

universe u v w

/-! ### Smoothness off `V(I)` depends only on the radical of `I` -/

section Radical

variable {A : Type u} [CommRing A] {I J : Ideal A} {B : Type v} [CommRing B] [Algebra A B]

/-- Smoothness off `V(I)` gives smoothness off `V(J)` when `J ⊆ √I`, that is when
`V(I) ⊆ V(J)`. -/
public theorem SmoothAwayFrom.of_le_radical (h : SmoothAwayFrom A I B) (hJI : J ≤ I.radical) :
    SmoothAwayFrom A J B := by
  intro q hq hJq
  refine h q hq fun hIq => hJq ?_
  rw [Ideal.map_le_iff_le_comap] at hIq ⊢
  exact hJI.trans ((Ideal.radical_mono hIq).trans (Ideal.comap_isPrime _ q).radical.le)

/-- **Smoothness off `V(I)` depends only on the radical of `I`.** -/
public theorem smoothAwayFrom_iff_of_radical_eq (hIJ : I.radical = J.radical) :
    SmoothAwayFrom A I B ↔ SmoothAwayFrom A J B :=
  ⟨fun h => h.of_le_radical (Ideal.le_radical.trans hIJ.ge),
    fun h => h.of_le_radical (Ideal.le_radical.trans hIJ.le)⟩

end Radical

/-! ### Flatness of the localized completions -/

section Flat

/-- **Flatness of the localized completions, smooth case.**  Let `R` be a Noetherian ring,
`J ⊆ R` an ideal and `D` a finite type `R`-algebra which is smooth over `Spec R ∖ V(J)`.  If `H`
is `R`-isomorphic to the `J`-adic completion of `D`, then for every `x ∈ J` the localization `H_x`
is flat over `R`: `D_x` is smooth, hence flat, over `R`. -/
public theorem flat_away_of_smoothAwayFrom {R : Type u} [CommRing R] [IsNoetherianRing R]
    {J : Ideal R} {D : Type v} [CommRing D] [Algebra R D] [Algebra.FiniteType R D]
    (hD : SmoothAwayFrom R J D) {H : Type w} [CommRing H] [Algebra R H]
    (e : AdicCompletion (J.map (algebraMap R D)) D ≃ₐ[R] H) {x : R} (hx : x ∈ J) :
    Module.Flat R (Localization.Away (algebraMap R H x)) := by
  have : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing R D
  have : Algebra.FinitePresentation R D :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  have hSm : Algebra.Smooth R (Localization.Away (algebraMap R D x)) := by
    refine Algebra.basicOpen_subset_smoothLocus_iff_smooth.mp fun p hp => ?_
    rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hp
    have hq : ¬ J.map (algebraMap R D) ≤ p.asIdeal := fun hle =>
      hp (hle (Ideal.mem_map_of_mem _ hx))
    exact (Algebra.smoothAt_iff_isSmoothAt R D p.asIdeal).mp (hD p.asIdeal p.isPrime hq)
  exact flat_away_of_flat_away_of_algEquiv e inferInstance

end Flat

/-! ### Dropping a generator -/

section GeneratorDrop

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

omit [IsNoetherianRing A] in
/-- `I Ā` and `Ī` have the same radical in `Ā = A ⧸ (aᵐ)`. -/
public theorem radical_map_span_insert_eq (s : Finset A) (a : A) {m : ℕ} (hm : 0 < m) :
    ((Ideal.span (insert a (s : Set A))).map (algebraMap A (A ⧸ Ideal.span {a ^ m}))).radical =
      (quotientPowSubIdeal s a m).radical :=
  le_antisymm (Ideal.radical_le_radical_iff.mpr
      (map_span_insert_le_radical_quotientPowSubIdeal s a hm))
    (Ideal.radical_mono (quotientPowSubIdeal_le_map_span_insert s a m))

/-- **The generator-dropping step, rig-smooth case.**  Let `A` be a Noetherian ring, let
`I = (s ∪ {a})` and let `B` be an object of the category of Stacks 0AL4 over `(A, I)` which is
rig-smooth.  Then the completed base change of `B` along `A → A ⧸ (aᵐ)` is rig-smooth over
`(Ā, Ī)`, where `Ī` is generated by the image of `s`.  This is Stacks 0GAM, since
`V(I Ā) = V(Ī)`. -/
public theorem isRigSmooth_completedBaseChange_quotient_span_pow (s : Finset A) (a : A) {m : ℕ}
    (hm : 0 < m)
    (C : CompletedBaseChange (A₁ := A) (A₂ := A ⧸ Ideal.span {a ^ m})
      (I₁ := Ideal.span (insert a (s : Set A))) (I₂ := quotientPowSubIdeal s a m))
    (B : AdicFiniteTypeAlgebra.{u, v} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigSmooth B) :
    IsRigSmooth (C.functor.obj B) :=
  isRigSmooth_completedBaseChange (radical_map_span_insert_eq s a hm) C B hB

end GeneratorDrop

/-! ### The levels of the system -/

section Step

variable {A : Type u} [CommRing A] [IsNoetherianRing A] (s : Finset A) (a : A)

/-- The `A`-algebra equivalence between the adic completions of equal ideals. -/
private abbrev adicCompletionAlgEquivOfEq {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    {I J : Ideal R} (h : J = I) : AdicCompletion I R ≃ₐ[A] AdicCompletion J R :=
  AdicCompletion.congrAlgEquiv AlgEquiv.refl (by rw [AlgEquiv.refl_toRingHom, Ideal.map_id, h])

/-- **One level of the system, rig-smooth case.**  Assume the algebraization of rig-smooth
objects over every `Ā = A ⧸ (aᵐ)` for the ideal `Ī` generated by the image of `s` (the induction
hypothesis).  Then for every `m ≥ 1` there is a finite type `Ā`-algebra `C`, smooth over the
complement of `V(I)`, whose `I`-adic completion is `A`-isomorphic to `B ⧸ aᵐ B`.  The induction
hypothesis algebraizes the completed base change `B ⧸ aᵐ B` by some `C₀`; Stacks 0GAK (2) makes
`C₀` smooth off `V(Ī) = V(I Ā)` after inverting some `g ∈ 1 + Ī C₀`, which does not change the
completion. -/
public theorem exists_level_of_isRigSmooth
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigSmooth B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigSmooth B) {m : ℕ} (hm : 0 < m) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C) (_ : Algebra A C)
      (_ : IsScalarTower A (A ⧸ Ideal.span {a ^ m}) C),
      Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
      SmoothAwayFrom (A ⧸ Ideal.span {a ^ m}) ((Ideal.span (insert a (s : Set A))).map
        (Ideal.Quotient.mk (Ideal.span {a ^ m}))) C ∧
      Nonempty (AdicCompletion ((Ideal.span (insert a (s : Set A))).map (algebraMap A C)) C
        ≃ₐ[A] B.carrier ⧸ (Ideal.span {a ^ m}).map (algebraMap A B.carrier)) := by
  let I := Ideal.span (insert a (s : Set A))
  let Q := A ⧸ Ideal.span {a ^ m}
  let J := quotientPowSubIdeal s a m
  let Bm := (quotientPowBaseChange s a hm).functor.obj B
  have hBm : IsRigSmooth Bm := isRigSmooth_completedBaseChange_quotient_span_pow s a hm _ B hB
  obtain ⟨C₀, _, _, hft, ⟨E₀⟩⟩ := hIH m hm Bm hBm
  let : Algebra A C₀ := ((algebraMap Q C₀).comp (algebraMap A Q)).toAlgebra
  have : IsScalarTower A Q C₀ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hrig : IsRigSmooth (adicCompletionObj J (B := C₀)) :=
    isRigSmooth_of_algEquiv (B := adicCompletionObj J (B := C₀)) E₀.symm hBm
  obtain ⟨g, hg1, hgSm⟩ := exists_sub_one_mem_and_smoothAwayFrom_of_isRigSmooth J hrig
  obtain ⟨c, -, hcle⟩ := exists_pow_map_span_insert_le_quotientPowSubIdeal s a hm
  let K₁ := I.map (algebraMap A C₀)
  let K₂ := J.map (algebraMap Q C₀)
  have hK₁ : K₁ = (I.map (Ideal.Quotient.mk (Ideal.span {a ^ m}))).map (algebraMap Q C₀) :=
    (map_map_quotientMk I C₀).symm
  have h12 : K₁ ^ c ≤ K₂ := by
    rw [hK₁, ← Ideal.map_pow, ← Ideal.map_pow]
    exact Ideal.map_mono hcle
  have h21 : K₂ ^ 1 ≤ K₁ := by
    rw [pow_one, hK₁]
    exact Ideal.map_mono (quotientPowSubIdeal_le_map_span_insert s a m)
  obtain ⟨Eg, -⟩ := exists_adicCompletion_algEquiv_away K₁ (h21 (by rwa [pow_one]))
  have hCideal : I.map (algebraMap A (Localization.Away g)) =
      K₁.map (algebraMap C₀ (Localization.Away g)) := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  obtain ⟨β, hβ⟩ := exists_ringEquiv_quotientPowBaseChange s a hm B
  let γ : AdicCompletion K₂ C₀ ≃ₐ[Q]
      B.carrier ⧸ (Ideal.span {a ^ m}).map (algebraMap A B.carrier) :=
    AlgEquiv.ofRingEquiv (f := E₀.symm.toRingEquiv.trans β) fun y => by
      rw [RingEquiv.trans_apply, AlgEquiv.coe_toRingEquiv,
        AlgEquiv.commutes, hβ]
  refine ⟨Localization.Away g, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, ?_, ⟨?_⟩⟩
  · exact hgSm.of_le_radical (map_span_insert_le_radical_quotientPowSubIdeal s a hm)
  · exact (adicCompletionAlgEquivOfEq hCideal.symm).trans
      ((Eg.restrictScalars A).symm.trans
      ((AdicCompletion.compareAlgEquiv A h12 h21).trans (γ.restrictScalars A)))

/-- The level `0` of the system, from `Rig.exists_level_of_isRigSmooth` at `m = 1`. -/
public theorem nonempty_smoothAlgebraizationStage_zero
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigSmooth B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigSmooth B) :
    Nonempty (SmoothAlgebraizationStage (Ideal.span (insert a (s : Set A))) a B.carrier 0) := by
  obtain ⟨C, _, _, _, _, _, hsm, ⟨eq⟩⟩ :=
    exists_level_of_isRigSmooth s a hIH B hB (m := 0 + 1) one_pos
  exact ⟨{ C := C, smooth := hsm, equiv := eq }⟩

/-- **Flatness of the localized quotients, rig-smooth case.**  Under the induction hypothesis of
`Rig.exists_level_of_isRigSmooth`, for generators `f` of `I Ā` in `Ā = A ⧸ (aᵐ)` the
localizations of `B ⧸ aᵐ B` at the `f i` are flat over `Ā`. -/
private theorem flat_away_quotient_of_isRigSmooth
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigSmooth B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigSmooth B) {m : ℕ} (hm : 0 < m) {k : ℕ} (f : Fin k → A ⧸ Ideal.span {a ^ m})
    (hf : Ideal.span (Set.range f) =
      (Ideal.span (insert a (s : Set A))).map (Ideal.Quotient.mk (Ideal.span {a ^ m})))
    (i : Fin k) :
    Module.Flat (A ⧸ Ideal.span {a ^ m}) (Localization.Away (algebraMap (A ⧸ Ideal.span {a ^ m})
      (B.carrier ⧸ (Ideal.span {a ^ m}).map (algebraMap A B.carrier)) (f i))) := by
  obtain ⟨D, _, _, _, _, _, hDsm, ⟨eD⟩⟩ := exists_level_of_isRigSmooth s a hIH B hB hm
  refine flat_away_of_smoothAwayFrom (J := Ideal.span (Set.range f)) (by rwa [hf])
    (AlgEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
      ((adicCompletionAlgEquivOfEq (by rw [hf, map_map_quotientMk])).trans eD))
    (Ideal.subset_span ⟨i, rfl⟩)

omit [IsNoetherianRing A] in
/-- The kernel of `A ⧸ (aⁿ⁺²) → A ⧸ (aⁿ⁺¹)` squares to zero. -/
private theorem ker_factor_span_pow_succ_sq_eq_bot (n : ℕ)
    (hle : Ideal.span {a ^ (n + 1 + 1)} ≤ Ideal.span {a ^ (n + 1)}) :
    RingHom.ker (Ideal.Quotient.factor hle) ^ 2 = ⊥ := by
  rw [Ideal.Quotient.factor_ker hle, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_pow,
    Ideal.span_singleton_eq_bot, ← map_pow, Ideal.Quotient.eq_zero_iff_mem, ← pow_mul]
  exact Ideal.mem_span_singleton.mpr (pow_dvd_pow a (by omega))

/-- The identification `(B ⧸ aⁿ⁺² B) ⧸ aⁿ⁺¹ ≃ B ⧸ aⁿ⁺¹ B`, the quotient being taken by the kernel
of `A ⧸ (aⁿ⁺²) → A ⧸ (aⁿ⁺¹)`. -/
private def quotientKerFactorAlgEquiv (B : Type*) [CommRing B] [Algebra A B] (n : ℕ)
    (hle : Ideal.span {a ^ (n + 1 + 1)} ≤ Ideal.span {a ^ (n + 1)}) :
    ((B ⧸ (Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B)) ⧸
      (RingHom.ker (Ideal.Quotient.factor hle)).map (algebraMap (A ⧸ Ideal.span {a ^ (n + 1 + 1)})
        (B ⧸ (Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B)))) ≃ₐ[A]
      B ⧸ (Ideal.span {a ^ (n + 1)}).map (algebraMap A B) :=
  (Ideal.quotientEquivAlgOfEq A (J := ((Ideal.span {a ^ (n + 1)}).map (algebraMap A B)).map
      (Ideal.Quotient.mkₐ A ((Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B)))) (by
    rw [Ideal.Quotient.factor_ker hle, map_map_quotientMk]
    exact (Ideal.map_map (algebraMap A B) (Ideal.Quotient.mk _)).symm)).trans
    (DoubleQuot.quotQuotEquivQuotOfLEₐ A (Ideal.map_mono hle))

omit [IsNoetherianRing A] in
/-- `quotientKerFactorAlgEquiv` sends the class of `h` to its image in `B ⧸ aⁿ⁺¹ B`. -/
private theorem quotientKerFactorAlgEquiv_mk (B : Type*) [CommRing B] [Algebra A B] (n : ℕ)
    (hle : Ideal.span {a ^ (n + 1 + 1)} ≤ Ideal.span {a ^ (n + 1)})
    (h : B ⧸ (Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B)) :
    quotientKerFactorAlgEquiv a B n hle (Ideal.Quotient.mk _ h) =
      Ideal.Quotient.factor (Ideal.map_mono hle) h := by
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective h
  rfl

variable
  (hLift : ∀ {R : Type u} [CommRing R] [IsNoetherianRing R] {R₀ : Type u} [CommRing R₀]
    [Algebra R R₀], Function.Surjective (algebraMap R R₀) →
    RingHom.ker (algebraMap R R₀) ^ 2 = ⊥ →
    ∀ {k : ℕ} (f : Fin k → R) (S : Type u) [CommRing S] [Algebra R₀ S] [Algebra R S]
      [IsScalarTower R R₀ S] [Algebra.FiniteType R₀ S],
    SmoothAwayFrom R₀ ((Ideal.span (Set.range f)).map (algebraMap R R₀)) S →
    ∀ (H : Type u) [CommRing H] [Algebra R H] [IsNoetherianRing H],
    IsAdicComplete ((Ideal.span (Set.range f)).map (algebraMap R H)) H →
    (∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i)))) →
    ∀ (e : (H ⧸ (RingHom.ker (algebraMap R R₀)).map (algebraMap R H)) ≃ₐ[R]
      AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S),
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T),
      Algebra.FiniteType R T ∧ SmoothAwayFrom R (Ideal.span (Set.range f)) T ∧
      ∃ (p : T →ₐ[R] S) (φ : T →ₐ[R] H), Function.Surjective p ∧
        RingHom.ker p.toRingHom = (RingHom.ker (algebraMap R R₀)).map (algebraMap R T) ∧
        (∀ x : T, e (Ideal.Quotient.mk _ (φ x)) =
          algebraMap S (AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S)
            (p x)) ∧
        ∃ E : AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R T)) T ≃ₐ[R] H,
          ∀ x : T, E (algebraMap T _ x) = φ x)

include hLift in
/-- **Lifting one level of the system to the next, rig-smooth case.**  Under the induction
hypothesis of `Rig.exists_level_of_isRigSmooth`, every level `n` of the compatible system lifts to
a level `n + 1`: a surjection `C_{n+2} → C_{n+1}` of kernel `aⁿ⁺¹ C_{n+2}`, compatible with the
identifications of the completions.  This is the smooth square-zero lifting lemma `hLift` along
`A ⧸ (aⁿ⁺²) → A ⧸ (aⁿ⁺¹)`, applied to `H = B ⧸ aⁿ⁺² B`; the flatness of the localizations of `H`
comes from the level `n + 2` given by `Rig.exists_level_of_isRigSmooth`. -/
public theorem exists_next_of_isRigSmooth
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigSmooth B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigSmooth B) (n : ℕ)
    (St : SmoothAlgebraizationStage (Ideal.span (insert a (s : Set A))) a B.carrier n) :
    ∃ (T : SmoothAlgebraizationStage (Ideal.span (insert a (s : Set A))) a B.carrier (n + 1))
      (p : T.C →ₐ[A] St.C), Function.Surjective p ∧
        RingHom.ker p.toRingHom = (Ideal.span {a ^ (n + 1)}).map (algebraMap A T.C) ∧
        ∀ x : T.C, St.equiv (algebraMap St.C _ (p x)) =
          Ideal.Quotient.factor (Ideal.map_mono (Ideal.span_singleton_le_span_singleton.mpr
            (pow_dvd_pow a (Nat.le_succ (n + 1))))) (T.equiv (algebraMap T.C _ x)) := by
  let I := Ideal.span (insert a (s : Set A))
  let R := A ⧸ Ideal.span {a ^ (n + 1 + 1)}
  let R₀ := A ⧸ Ideal.span {a ^ (n + 1)}
  have hle : Ideal.span {a ^ (n + 1 + 1)} ≤ Ideal.span {a ^ (n + 1)} :=
    Ideal.span_singleton_le_span_singleton.mpr (pow_dvd_pow a (Nat.le_succ (n + 1)))
  let : Algebra R R₀ := (Ideal.Quotient.factor hle).toAlgebra
  have : IsScalarTower A R R₀ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hsurj : Function.Surjective (algebraMap R R₀) := Ideal.Quotient.factor_surjective hle
  have hker : RingHom.ker (algebraMap R R₀) =
      (Ideal.span {a ^ (n + 1)}).map (Ideal.Quotient.mk (Ideal.span {a ^ (n + 1 + 1)})) :=
    Ideal.Quotient.factor_ker hle
  obtain ⟨k, f, hf'⟩ : ∃ (k : ℕ) (f : Fin k → R),
      Ideal.span (Set.range f) = I.map (Ideal.Quotient.mk (Ideal.span {a ^ (n + 1 + 1)})) :=
    Submodule.fg_iff_exists_fin_generating_family.mp (Ideal.fg_of_isNoetherianRing _)
  have hJR : ∀ (X : Type u) [CommRing X] [Algebra A X] [Algebra R X] [IsScalarTower A R X],
      (Ideal.span (Set.range f)).map (algebraMap R X) = I.map (algebraMap A X) :=
    fun _ _ _ _ _ => by rw [hf', map_map_quotientMk]
  let S := St.C
  let : Algebra R S := ((algebraMap R₀ S).comp (algebraMap R R₀)).toAlgebra
  have : IsScalarTower R R₀ S := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply A R₀ S]
    rfl
  have hS : SmoothAwayFrom R₀ ((Ideal.span (Set.range f)).map (algebraMap R R₀)) S := by
    rw [hJR R₀, Ideal.Quotient.algebraMap_eq]
    exact St.smooth
  let H := B.carrier ⧸ (Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B.carrier)
  have hH : IsAdicComplete ((Ideal.span (Set.range f)).map (algebraMap R H)) H := by
    rw [hJR H]
    exact (quotient_isAdicFiniteType B _).1
  let ψ : (H ⧸ (RingHom.ker (algebraMap R R₀)).map (algebraMap R H)) ≃ₐ[A]
      B.carrier ⧸ (Ideal.span {a ^ (n + 1)}).map (algebraMap A B.carrier) :=
    quotientKerFactorAlgEquiv a B.carrier n hle
  let F : AdicCompletion (I.map (algebraMap A S)) S ≃ₐ[A]
      AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S :=
    adicCompletionAlgEquivOfEq (hJR S)
  have hF : ∀ y : S, F (algebraMap S _ y) = algebraMap S _ y := fun y =>
    AdicCompletion.congrAlgEquiv_of _ _ y
  let e : (H ⧸ (RingHom.ker (algebraMap R R₀)).map (algebraMap R H)) ≃ₐ[R]
      AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S :=
    AlgEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
      (ψ.trans (St.equiv.symm.trans F))
  obtain ⟨T, _, _, hTft, hTsm, p, φ, hpsurj, hpker, hcompat, E, hE⟩ :=
    hLift hsurj (ker_factor_span_pow_succ_sq_eq_bot a n hle) f S hS H hH
      (flat_away_quotient_of_isRigSmooth s a hIH B hB (m := n + 1 + 1) (by omega) f hf') e
  let : Algebra A T := ((algebraMap R T).comp (algebraMap A R)).toAlgebra
  have : IsScalarTower A R T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let T' : SmoothAlgebraizationStage I a B.carrier (n + 1) :=
    { C := T
      smooth := by rwa [← hf']
      equiv := (adicCompletionAlgEquivOfEq (hJR T)).trans (E.restrictScalars A) }
  refine ⟨T', p.restrictScalars A, hpsurj, ?_, fun x => ?_⟩
  · rwa [hker, map_map_quotientMk] at hpker
  · have h2 : T'.equiv (algebraMap T _ x) = φ x := by
      simp only [T', AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
      exact (congrArg E (AdicCompletion.congrAlgEquiv_of _ _ x)).trans (hE x)
    have h3 : St.equiv.symm (ψ (Ideal.Quotient.mk _ (φ x))) =
        algebraMap S (AdicCompletion (I.map (algebraMap A S)) S) (p x) := by
      apply F.injective
      rw [hF, ← hcompat x]
      rfl
    rw [h2, ← quotientKerFactorAlgEquiv_mk a B.carrier n hle]
    exact (St.equiv.symm_apply_eq.mp h3).symm

end Step

/-! ### The limit of the system, and the induction -/

section Induction

variable
  (hLift : ∀ {R : Type u} [CommRing R] [IsNoetherianRing R] {R₀ : Type u} [CommRing R₀]
    [Algebra R R₀], Function.Surjective (algebraMap R R₀) →
    RingHom.ker (algebraMap R R₀) ^ 2 = ⊥ →
    ∀ {k : ℕ} (f : Fin k → R) (S : Type u) [CommRing S] [Algebra R₀ S] [Algebra R S]
      [IsScalarTower R R₀ S] [Algebra.FiniteType R₀ S],
    SmoothAwayFrom R₀ ((Ideal.span (Set.range f)).map (algebraMap R R₀)) S →
    ∀ (H : Type u) [CommRing H] [Algebra R H] [IsNoetherianRing H],
    IsAdicComplete ((Ideal.span (Set.range f)).map (algebraMap R H)) H →
    (∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i)))) →
    ∀ (e : (H ⧸ (RingHom.ker (algebraMap R R₀)).map (algebraMap R H)) ≃ₐ[R]
      AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S),
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T),
      Algebra.FiniteType R T ∧ SmoothAwayFrom R (Ideal.span (Set.range f)) T ∧
      ∃ (p : T →ₐ[R] S) (φ : T →ₐ[R] H), Function.Surjective p ∧
        RingHom.ker p.toRingHom = (RingHom.ker (algebraMap R R₀)).map (algebraMap R T) ∧
        (∀ x : T, e (Ideal.Quotient.mk _ (φ x)) =
          algebraMap S (AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S)
            (p x)) ∧
        ∃ E : AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R T)) T ≃ₐ[R] H,
          ∀ x : T, E (algebraMap T _ x) = φ x)
  (hSmoothify : ∀ {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A} {a : A}, a ∈ I →
    ∀ (B' : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span {a}))
      (B : AdicFiniteTypeAlgebra.{u, u} A I), IsRigSmooth B →
    ∀ (θ : B'.carrier →ₐ[A] B.carrier), (∀ n, IsBijectiveMod (I ^ n) θ) →
    (∀ n, ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ (n + 1)}) C)
      (_ : Algebra A C) (_ : IsScalarTower A (A ⧸ Ideal.span {a ^ (n + 1)}) C),
      Algebra.FiniteType (A ⧸ Ideal.span {a ^ (n + 1)}) C ∧
      SmoothAwayFrom (A ⧸ Ideal.span {a ^ (n + 1)}) (I.map (Ideal.Quotient.mk _)) C ∧
      Nonempty ((B'.carrier ⧸ (Ideal.span {a ^ (n + 1)}).map (algebraMap A B'.carrier)) ≃ₐ[A]
        C)) →
    IsRigSmooth B')
  (hPrincipal : ∀ {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}, I.IsPrincipal →
    ∀ (B : AdicFiniteTypeAlgebra.{u, u} A I), IsRigSmooth B →
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Algebra.FiniteType A C ∧
      Nonempty (B.carrier ≃ₐ[A] AdicCompletion (I.map (algebraMap A C)) C))

include hSmoothify hPrincipal in
/-- **The end of the induction step.**  A compatible system of smooth algebraizations of the
quotients `B ⧸ aⁿ⁺¹ B`, for an element `a ∈ I` and a rig-smooth `B` over `(A, I)`, algebraizes
`B`: its limit `B'` is rig-smooth over `(A, (a))` by `hSmoothify`, so the principal case
`hPrincipal` algebraizes it by a finite type `A`-algebra `D`, and the `I`-adic completion of `D`
is `B` because `B' → B` is bijective modulo every `Iⁿ`. -/
public theorem SmoothAlgebraizationTower.exists_algebraization
    {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A} {a : A} (ha : a ∈ I)
    (B : AdicFiniteTypeAlgebra.{u, u} A I) (hB : IsRigSmooth B)
    (T : SmoothAlgebraizationTower I a B.carrier) :
    ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D),
      Algebra.FiniteType A D ∧
        Nonempty (B.carrier ≃ₐ[A] AdicCompletion (I.map (algebraMap A D)) D) := by
  have : IsAdicComplete (I.map (algebraMap A B.carrier)) B.carrier := B.isAdicallyComplete
  have hT : IsRigSmooth T.limit := hSmoothify ha T.limit B hB (T.toCarrier ha)
    (T.isBijectiveMod_toCarrier ha) T.exists_quotient_smoothAwayFrom
  obtain ⟨D, _, _, hD, ⟨E⟩⟩ := hPrincipal ⟨a, rfl⟩ T.limit hT
  let θ : D →ₐ[A] B.carrier := (T.toCarrier ha).comp ((E.symm : _ →ₐ[A] T.limit.carrier).comp
    (toAdicCompletionAlgHom ((Ideal.span {a}).map (algebraMap A D))))
  have hθ : ∀ n, IsBijectiveMod (I ^ n) θ := fun n =>
    (T.isBijectiveMod_toCarrier ha n).comp ((IsBijectiveMod.of_algEquiv E.symm).comp
      ((isBijectiveMod_toAdicCompletionAlgHom (Ideal.span {a})
        (Ideal.FG.map (Submodule.fg_span_singleton a) _) n).mono
        (Ideal.pow_right_mono ((Ideal.span_singleton_le_iff_mem _).mpr ha) n)))
  exact ⟨D, inferInstance, inferInstance, hD,
    nonempty_algEquiv_adicCompletion I θ B.isAdicallyComplete hθ⟩

include hLift hSmoothify hPrincipal in
/-- **The induction step, rig-smooth case.**  Let `A` be a Noetherian ring, `I = (s ∪ {a})` and
`B` rig-smooth over `(A, I)`.  If rig-smooth objects over every `A ⧸ (aᵐ)` for the ideal generated
by the image of `s` are algebraized, then `B` is the `I`-adic completion of a finite type
`A`-algebra: the levels of `Rig.exists_level_of_isRigSmooth` are made compatible by
`Rig.exists_next_of_isRigSmooth`, and the resulting system algebraizes `B`
(`Rig.SmoothAlgebraizationTower.exists_algebraization`). -/
public theorem exists_finiteType_algEquiv_of_isRigSmooth_of_algebraizes_quotients
    {A : Type u} [CommRing A] [IsNoetherianRing A] (s : Finset A) (a : A)
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigSmooth B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigSmooth B) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
      Algebra.FiniteType A C ∧
        Nonempty (B.carrier ≃ₐ[A]
          AdicCompletion ((Ideal.span (insert a (s : Set A))).map (algebraMap A C)) C) := by
  obtain ⟨T⟩ := nonempty_smoothAlgebraizationTower _ a B.carrier
    (nonempty_smoothAlgebraizationStage_zero s a hIH B hB)
    (exists_next_of_isRigSmooth s a hLift hIH B hB)
  exact SmoothAlgebraizationTower.exists_algebraization hSmoothify hPrincipal
    (Ideal.subset_span (Set.mem_insert a _)) B hB T

include hLift hSmoothify hPrincipal in
/-- **Gabber–Zavyalov for an ideal with at most `n` given generators**, for objects whose carrier
lies in the universe of `A`: the induction on the number of generators.  An ideal with at most
one generator is principal (`hPrincipal`); otherwise one generator `a` is split off and the
induction hypothesis over the quotients `A ⧸ (aᵐ)` feeds
`Rig.exists_finiteType_algEquiv_of_isRigSmooth_of_algebraizes_quotients`. -/
public theorem exists_finiteType_algEquiv_of_isRigSmooth_span (n : ℕ) :
    ∀ {A : Type u} [CommRing A] [IsNoetherianRing A] (s : Finset A), s.card ≤ n →
      ∀ B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (s : Set A)), IsRigSmooth B →
        ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
          Algebra.FiniteType A C ∧
            Nonempty (B.carrier ≃ₐ[A]
              AdicCompletion ((Ideal.span (s : Set A)).map (algebraMap A C)) C) := by
  classical
  induction n with
  | zero =>
    intro A _ _ s hs B hB
    exact hPrincipal (isPrincipal_span_of_card_le_one (hs.trans zero_le_one)) B hB
  | succ n ih =>
    intro A _ _ s hs B hB
    rcases le_or_gt s.card 1 with h1 | h1
    · exact hPrincipal (isPrincipal_span_of_card_le_one h1) B hB
    obtain ⟨a, ha⟩ := Finset.card_pos.mp (zero_lt_one.trans h1)
    have hcard : (s.erase a).card ≤ n := by
      rw [Finset.card_erase_of_mem ha]
      omega
    have hs' : Ideal.span (s : Set A) = Ideal.span (insert a ((s.erase a : Finset A) : Set A)) := by
      rw [← Finset.coe_insert, Finset.insert_erase ha]
    revert B
    rw [hs']
    intro B hB
    refine exists_finiteType_algEquiv_of_isRigSmooth_of_algebraizes_quotients hLift hSmoothify
      hPrincipal (s.erase a) a ?_ B hB
    intro m _ B' hB'
    have h := ih ((s.erase a).image (Ideal.Quotient.mk (Ideal.span {a ^ m})))
      (Finset.card_image_le.trans hcard)
    rw [Finset.coe_image] at h
    exact h B' hB'

end Induction

end Rig

end
