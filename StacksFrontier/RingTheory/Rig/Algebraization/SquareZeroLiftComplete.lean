module

public import StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftLambda
public import Mathlib.RingTheory.AdicCompletion.Completeness
public import Mathlib.RingTheory.Flat.EquationalCriterion
import all StacksFrontier.RingTheory.Localization.Glueing.FormalGlueingComplex

/-!
# The completion of the glued ring

In the setting of `StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftRing`, the projection
`φ : T → H` induces isomorphisms `T ⧸ Iⁿ T ≅ H ⧸ Iⁿ H` for `I = (f₁, …, f_k)` and all `n`. Since
`H` is `I`-adically complete, `φ` identifies the `I`-adic completion of `T` with `H`.

Surjectivity holds because `S` is dense in `S^∧` and `N H` is generated by `N` over `φ(T)`.
Injectivity uses the flatness of `S → S^∧` through the equational criterion, and the effectivity
of the glueing (an element of `P ⊗[S] S^∧` with vanishing image in `H` comes from `P`).

## Main results

* `Rig.SquareZeroLift.exists_adicCompletion_algEquiv`: the completion of `T` is `H`.
-/

@[expose] public section

namespace Rig.SquareZeroLift

open TensorProduct Cech FormalGlueing
open _root_.IPowerTorsion (unitMap)

universe u

variable {R : Type u} [CommRing R] (N : Ideal R) (hN : N ^ 2 = ⊥)
variable {k : ℕ} (f : Fin k → R)
variable (S : Type u) [CommRing S] [Algebra R S]

/-- The extension of `Iⁿ` to `S^∧` along `R → S^∧` equals the extension of `(I S)ⁿ` along
`S → S^∧`. -/
theorem map_pow_Sh (n : ℕ) :
    ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (Sh f S)) =
      (((Ideal.span (Set.range f)).map (algebraMap R S)) ^ n).map (algebraMap S (Sh f S)) := by
  rw [← Ideal.map_pow, Ideal.map_map, ← IsScalarTower.algebraMap_eq]

/-- An element of `S^∧` vanishes in `S ⧸ (I S)ⁿ` if and only if it lies in `Iⁿ S^∧`. -/
theorem ker_eval_Sh [IsNoetherianRing S] (n : ℕ) (x : Sh f S) :
    AdicCompletion.eval ((Ideal.span (Set.range f)).map (algebraMap R S)) S n x = 0 ↔
      x ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (Sh f S)) := by
  rw [← LinearMap.mem_ker, ← AdicCompletion.pow_smul_top_eq_ker_eval (IsNoetherian.noetherian _),
    Ideal.smul_top_eq_map, map_pow_Sh]
  rfl

/-- Every element of `S^∧` is congruent to an element of `S` modulo `Iⁿ S^∧`. -/
theorem exists_sub_mem_Sh [IsNoetherianRing S] (n : ℕ) (x : Sh f S) :
    ∃ s : S, x - algebraMap S (Sh f S) s ∈
      ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (Sh f S)) := by
  obtain ⟨s, hs⟩ := Submodule.mkQ_surjective _
    (AdicCompletion.eval ((Ideal.span (Set.range f)).map (algebraMap R S)) S n x)
  refine ⟨s, (ker_eval_Sh f S n _).mp ?_⟩
  rw [map_sub, ← hs, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    AdicCompletion.eval_of, sub_self]

/-- An element of `S` whose image in `S^∧` lies in `Iⁿ S^∧` lies in `Iⁿ S`. -/
theorem mem_of_algebraMap_mem_Sh [IsNoetherianRing S] (n : ℕ) (s : S)
    (hs : algebraMap S (Sh f S) s ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (Sh f S))) :
    s ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R S) := by
  rw [← ker_eval_Sh, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    AdicCompletion.eval_of, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    Ideal.smul_top_eq_map, ← Ideal.map_pow] at hs
  simpa using hs

variable (H : Type u) [CommRing H] [Algebra R H]
variable (e : (H ⧸ N.map (algebraMap R H)) ≃ₐ[R] Sh f S)
variable (L : ∀ s : Finset (Fin k), NilLift R N (Sl f S s))
variable (hL : ∀ s, s.Nonempty → Algebra.Etale R (L s).carrier)
variable [IsNoetherianRing S] (hNS : N.map (algebraMap R S) = ⊥)
variable (hflat : ∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i))))

/-- An `R`-algebra map sends `K A` into `K B`. -/
private theorem algHom_mem_map {A B : Type*} [CommRing A] [Algebra R A] [CommRing B]
    [Algebra R B] (φ : A →ₐ[R] B) {K : Ideal R} {x : A} (hx : x ∈ K.map (algebraMap R A)) :
    φ x ∈ K.map (algebraMap R B) := by
  have := Ideal.mem_map_of_mem φ.toRingHom hx
  rwa [Ideal.map_map, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap] at this

omit [IsNoetherianRing S] in
/-- If `h ∈ K H`, then the image of `h` under `H → H ⧸ N H ≃ S^∧` lies in `K S^∧`. -/
theorem e_mem_map {K : Ideal R} {h : H} (hh : h ∈ K.map (algebraMap R H)) :
    e (Ideal.Quotient.mk _ h) ∈ K.map (algebraMap R (Sh f S)) :=
  algHom_mem_map e.toAlgHom (algHom_mem_map (Ideal.Quotient.mkₐ R _) hh)

omit [IsNoetherianRing S] in
/-- If the image of `h` under `H → H ⧸ N H ≃ S^∧` lies in `K S^∧`, then `h ∈ K H + N H`. -/
theorem mem_map_of_e_mem {K : Ideal R} {h : H}
    (hh : e (Ideal.Quotient.mk _ h) ∈ K.map (algebraMap R (Sh f S))) :
    h ∈ K.map (algebraMap R H) ⊔ N.map (algebraMap R H) := by
  have h2 := algHom_mem_map e.symm.toAlgHom hh
  have h2' : Ideal.Quotient.mk (N.map (algebraMap R H)) h ∈
      K.map (algebraMap R (H ⧸ N.map (algebraMap R H))) := by
    simpa using h2
  rw [show algebraMap R (H ⧸ N.map (algebraMap R H)) =
    (Ideal.Quotient.mk (N.map (algebraMap R H))).comp (algebraMap R H) from
    (RingHom.ext fun r ↦ (Ideal.Quotient.mkₐ R (N.map (algebraMap R H))).commutes r).symm,
    ← Ideal.map_map] at h2'
  have h3 := Ideal.mem_comap.mpr h2'
  rwa [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
    Ideal.mk_ker] at h3

include hflat in
/-- Every element of `H` is congruent to an element of the image of `T` modulo `Iⁿ H + N H`. -/
theorem exists_sub_prH_mem_sup (n : ℕ) (c : H) :
    ∃ t, c - prH N hN f S H e L hL t ∈
      ((Ideal.span (Set.range f)) ^ n).map (algebraMap R H) ⊔ N.map (algebraMap R H) := by
  obtain ⟨s, hs⟩ := exists_sub_mem_Sh f S n (e (Ideal.Quotient.mk _ c))
  obtain ⟨t, rfl⟩ := prS_surjective N hN f S H e L hL hflat s
  refine ⟨t, mem_map_of_e_mem N f S H e ?_⟩
  rwa [map_sub, map_sub, compat]

include hflat in
/-- Every element of `N H` is congruent to an element of the image of `T` modulo `Iⁿ H`. -/
theorem exists_sub_prH_mem_of_mem (n : ℕ) (j : H) (hj : j ∈ N.map (algebraMap R H)) :
    ∃ t, j - prH N hN f S H e L hL t ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R H) := by
  induction hj using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨r, -, rfl⟩ := hx
    exact ⟨algebraMap R _ r, by rw [AlgHom.commutes, sub_self]; exact zero_mem _⟩
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [map_add, add_sub_add_comm]; exact add_mem ha hb⟩
  | smul c x hxN hx =>
    obtain ⟨t, ht⟩ := hx
    obtain ⟨tc, htc⟩ := exists_sub_prH_mem_sup N hN f S H e L hL hflat n c
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp htc
    refine ⟨tc * t, ?_⟩
    have hbx : b * x = 0 := by
      have : b * x ∈ N.map (algebraMap R H) ^ 2 := by
        rw [pow_two]
        exact Ideal.mul_mem_mul hb hxN
      rwa [map_sq_eq_bot N hN] at this
    have : c • x - prH N hN f S H e L hL (tc * t) =
        prH N hN f S H e L hL tc * (x - prH N hN f S H e L hL t) + a * x + b * x := by
      rw [smul_eq_mul, map_mul, show c = prH N hN f S H e L hL tc + a + b by
        rw [add_assoc, hab]; ring]
      ring
    rw [this, hbx, add_zero]
    exact add_mem (Ideal.mul_mem_left _ _ ht) (Ideal.mul_mem_right _ _ ha)

include hflat in
/-- Surjectivity of `T ⧸ Iⁿ T → H ⧸ Iⁿ H`. -/
theorem exists_sub_prH_mem (n : ℕ) (c : H) :
    ∃ t, c - prH N hN f S H e L hL t ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R H) := by
  obtain ⟨t₀, ht₀⟩ := exists_sub_prH_mem_sup N hN f S H e L hL hflat n c
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp ht₀
  obtain ⟨t₁, ht₁⟩ := exists_sub_prH_mem_of_mem N hN f S H e L hL hflat n b hb
  refine ⟨t₀ + t₁, ?_⟩
  rw [map_add, show c - (prH N hN f S H e L hL t₀ + prH N hN f S H e L hL t₁) =
    a + (b - prH N hN f S H e L hL t₁) by linear_combination -hab]
  exact add_mem ha ht₁

omit [IsNoetherianRing S] in
/-- If `h ∈ H` maps to `x ∈ S^∧`, then `muH0` sends `z ⊗ x` to `muH0 (z ⊗ 1) * h`. -/
theorem muH0_tmul_mul (z : PS N S) (x : Sh f S) (h : H) (hh : e (Ideal.Quotient.mk _ h) = x) :
    muH0 N hN f S H e (z ⊗ₜ x) = muH0 N hN f S H e (z ⊗ₜ 1) * h := by
  induction z using TensorProduct.inductionOn with
  | tmul a n =>
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (e.symm (algebraMap S (Sh f S) a))
    rw [muH0_tmul N hN f S H e a n 1 b (by rw [mul_one, hb]),
      muH0_tmul N hN f S H e a n x (b * h) (by rw [map_mul, hb, map_mul, ← hh,
        AlgEquiv.symm_apply_apply]), smul_mul_assoc]
  | add x y hx hy => rw [TensorProduct.add_tmul, TensorProduct.add_tmul, map_add, map_add, hx, hy,
      add_mul]

include hflat in
/-- **Effectivity.** An element of `P ⊗[S] S^∧` with vanishing image in `H` comes from an element
of `P` with vanishing localizations. -/
theorem exists_tmul_eq_of_muH0_eq_zero (w : PH N f S) (hw : muH0 N hN f S H e w = 0) :
    ∃ z : PS N S, z ⊗ₜ 1 = w ∧ ∀ u : {s : Finset (Fin k) // s.card = 1},
      LocalizedModule.mkLinearMap (cechSub (gS f S) u.1) (PS N S) z = 0 := by
  have hβ : glueingBeta (Sh f S) (gS f S) (PS N S) (w, 0) = 0 := by
    apply Prod.ext
    · funext u
      apply muH_injective N hN f S H e hflat u.1 (nonempty_of_card_eq u)
      change muH N hN f S H e u.1 (LocalizedModule.mkLinearMap _ _ w -
        LocalizedModule.map (cechSub (gS f S) u.1)
          ((TensorProduct.mk S (PS N S) (Sh f S)).flip 1) 0) = muH N hN f S H e u.1 0
      rw [map_zero, sub_zero, muH_mk, hw, map_zero, map_zero]
    · funext T
      change -(glueingDifferential (gS f S) (PS N S) 1 0 T) = 0
      simp
  obtain ⟨z, hz⟩ := ((glueingComplex_exact S (Sh f S) (gS f S) (PS N S) (flat_Sh f S)
    (quotientMap_Sh_bijective f S)).2 (w, 0)).mp hβ
  exact ⟨z, congrArg Prod.fst hz, fun u ↦ congrFun (congrArg Prod.snd hz) u⟩

include hflat in
/-- **Effectivity.** An element of `P ⊗[S] S^∧` with vanishing image in `H` comes from an element
of `P` with vanishing localizations. -/
theorem exists_eq_tmul_of_muH0_eq_zero (w : PH N f S) (hw : muH0 N hN f S H e w = 0) :
    ∃ z : PS N S, z ⊗ₜ 1 = w ∧ ∀ u : {s : Finset (Fin k) // s.card = 1},
      LocalizedModule.mkLinearMap (cechSub (gS f S) u.1) (PS N S) z = 0 :=
  exists_tmul_eq_of_muH0_eq_zero N hN f S H e hflat w hw

omit [IsNoetherianRing S] in
/-- For an ideal `K` of `R` and an `S`-module `M`, the submodule `K M` is contained in
`(K S) M`. -/
theorem smul_mem_map_of_mem {M : Type*} [AddCommGroup M] [Module S M] [Module R M]
    [IsScalarTower R S M] (K : Ideal R) {x : M} (hx : x ∈ K • (⊤ : Submodule R M)) :
    x ∈ (K.map (algebraMap R S)) • (⊤ : Submodule S M) := by
  refine Submodule.smul_induction_on hx (fun r hr n _ ↦ ?_) (fun x y hx hy ↦ add_mem hx hy)
  rw [← algebraMap_smul S r n]
  exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top

/-- The reduction `H → S^∧`. -/
noncomputable def Psi : H →ₐ[R] Sh f S := e.toAlgHom.comp (Ideal.Quotient.mkₐ R _)

omit [IsNoetherianRing S] in
/-- The reduction `Psi` sends the image of `t ∈ T` in `H` to the image of `t` in `S^∧`. -/
theorem Psi_prH (t : TT N hN f S H e L hL) :
    Psi N f S H e (prH N hN f S H e L hL t) = algebraMap S _ (prS N hN f S H e L hL t) :=
  compat N hN f S H e L hL t

omit [IsNoetherianRing S] in
/-- The reduction `Psi` vanishes on `N H`. -/
theorem Psi_eq_zero {h : H} (hh : h ∈ N.map (algebraMap R H)) : Psi N f S H e h = 0 := by
  simp [Psi, Ideal.Quotient.eq_zero_iff_mem.mpr hh]

omit [IsNoetherianRing S] in
/-- The kernel of the reduction `Psi` is `N H`. -/
theorem Psi_sub_eq_zero_iff (h : H) : Psi N f S H e h = 0 ↔ h ∈ N.map (algebraMap R H) := by
  refine ⟨fun hh ↦ ?_, Psi_eq_zero N f S H e⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  exact e.injective (hh.trans (map_zero e).symm)

/-- `∑ₗ (∑ᵢ aᵢ • Aᵢₗ) Yₗ = ∑ᵢ aᵢ • ∑ₗ Aᵢₗ Yₗ`. -/
theorem sum_comm_smul_mul {ι : Type*} [Fintype ι] {m : ℕ} (a : ι → R) (A : ι → Fin m → H)
    (Y : Fin m → H) :
    ∑ l, (∑ i, a i • A i l) * Y l = ∑ i, a i • ∑ l, A i l * Y l := by
  simp only [Finset.sum_mul, Finset.smul_sum, smul_mul_assoc]
  exact Finset.sum_comm

/-- Every element of `Iⁿ S` is the image of an element of `Iⁿ T`. -/
private theorem exists_mem_map_prS_eq
    (hflat : ∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i))))
    (K : Ideal R) {x : S} (hx : x ∈ K.map (algebraMap R S)) :
    ∃ t ∈ K.map (algebraMap R (TT N hN f S H e L hL)), prS N hN f S H e L hL t = x := by
  have hx' : x ∈ (K.map (algebraMap R (TT N hN f S H e L hL))).map
      (prS N hN f S H e L hL).toRingHom := by
    rwa [Ideal.map_map, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
  exact (Ideal.mem_map_iff_of_surjective _ (prS_surjective N hN f S H e L hL hflat)).mp hx'

include hL hNS hflat in
/-- An element of `P` whose base change lies in `Iⁿ P'` up to the kernel of `P' → H` is
sent into `Iⁿ T`. -/
theorem Lam_mem_of_tmul (n : ℕ) (hn : 0 < n) (z : PS N S) (w₁ : PH N f S)
    (hw₁ : w₁ ∈ (((Ideal.span (Set.range f)) ^ n).map (algebraMap R S)) •
      (⊤ : Submodule S (PH N f S)))
    (hD : muH0 N hN f S H e (z ⊗ₜ 1 - w₁) = 0) :
    Lam N hN f S H e L hL hNS hflat z ∈
      ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (TT N hN f S H e L hL)) := by
  set K : Ideal S := ((Ideal.span (Set.range f)) ^ n).map (algebraMap R S)
  obtain ⟨z₀, hz₀, hz₀V⟩ := exists_eq_tmul_of_muH0_eq_zero N hN f S H e hflat _ hD
  have hLz₀ : Lam N hN f S H e L hL hNS hflat z₀ = 0 :=
    Lam_eq_zero N hN f S H e L hL hNS hflat z₀ (by rw [hz₀, hD]) hz₀V
  let u : PS N S := z - z₀
  have hu1 : u ⊗ₜ (1 : Sh f S) ∈ K • (⊤ : Submodule S (PH N f S)) := by
    have : u ⊗ₜ (1 : Sh f S) = w₁ := by
      simp only [u, TensorProduct.sub_tmul, hz₀]
      abel
    rwa [this]
  have hu : u ∈ K • (⊤ : Submodule S (PS N S)) := by
    let q := (K • (⊤ : Submodule S (PS N S))).mkQ
    have hq0 : q u = 0 := by
      apply unitMap_eq_zero_of_torsion (Ideal.span (Set.range (gS f S))) (flat_Sh f S)
        (quotientMap_Sh_bijective f S)
      · refine ⟨n, hn, fun c hc ↦ ?_⟩
        rw [span_range_gS] at hc
        rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact Submodule.smul_mem_smul (by simpa only [K, Ideal.map_pow] using hc) Submodule.mem_top
      · change q.rTensor (Sh f S) (u ⊗ₜ 1) = 0
        refine Submodule.smul_induction_on hu1 (fun c hc x _ ↦ ?_)
          (fun x y hx hy ↦ by rw [map_add, hx, hy, add_zero])
        rw [map_smul]
        induction (q.rTensor (Sh f S) x) using TensorProduct.inductionOn with
        | tmul a b =>
          rw [TensorProduct.smul_tmul']
          obtain ⟨a', rfl⟩ := Submodule.mkQ_surjective _ a
          rw [← map_smul q, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero _).mpr
            (Submodule.smul_mem_smul hc Submodule.mem_top), TensorProduct.zero_tmul]
        | add a b ha hb => rw [smul_add, ha, hb, add_zero]
    exact (Submodule.Quotient.mk_eq_zero _).mp hq0
  have hLu : Lam N hN f S H e L hL hNS hflat u ∈
      ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (TT N hN f S H e L hL)) := by
    refine Submodule.smul_induction_on hu (fun c hc x _ ↦ ?_)
      (fun x y hx hy ↦ by rw [map_add]; exact add_mem hx hy)
    obtain ⟨tc, htc, htc'⟩ := exists_mem_map_prS_eq N hN f S H e L hL hflat _ hc
    rw [Lam_smul N hN f S H e L hL hNS hflat c x tc htc']
    exact Ideal.mul_mem_right _ _ htc
  have hz : z = u + z₀ := by
    simp only [u]
    abel
  rwa [hz, map_add, hLz₀, add_zero]

/-- An element of `K H` is a finite sum `∑ aᵢ • hᵢ` with every `aᵢ ∈ K`. -/
theorem exists_finite_sum {K : Ideal R} {x : H} (hx : x ∈ K.map (algebraMap R H)) :
    ∃ (s : Finset H) (a : H → R), (∀ i, a i ∈ K) ∧ ∑ i ∈ s, a i • i = x := by
  have hx' : x ∈ K • Submodule.span R (Set.range (id : H → H)) := by
    rwa [Set.range_id, Submodule.span_univ, Ideal.smul_top_eq_map]
  obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp hx'
  exact ⟨a.support, a, ha, hsum⟩

include hL hNS hflat in
/-- Approximation of an element of `P` whose image in `H` lies in `Iⁿ H`. -/
theorem exists_approx (n : ℕ) (z : PS N S) (s : Finset H) (a : H → R)
    (ha : ∀ i, a i ∈ (Ideal.span (Set.range f)) ^ n)
    (hsum : ∑ i ∈ s, a i • i = muH0 N hN f S H e (z ⊗ₜ 1)) :
    ∃ z₁ : PS N S, Lam N hN f S H e L hL hNS hflat z₁ ∈
        ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (TT N hN f S H e L hL)) ∧
      ∃ w₁ ∈ (((Ideal.span (Set.range f)) ^ n).map (algebraMap R S)) •
          (⊤ : Submodule S (PH N f S)),
        muH0 N hN f S H e (z ⊗ₜ 1 - z₁ ⊗ₜ 1 - w₁) = 0 := by
  classical
  set K : Ideal S := ((Ideal.span (Set.range f)) ^ n).map (algebraMap R S)
  let Ψ := Psi N f S H e
  have hsum' : ∑ i : s, a i • (i : H) = muH0 N hN f S H e (z ⊗ₜ 1) :=
    (Finset.sum_coe_sort s fun i ↦ a i • i).trans hsum
  have hrel : ∑ i : s, algebraMap R S (a i) • Ψ (i : H) = 0 := by
    simp only [algebraMap_smul]
    rw [show ∑ i : s, a i • Ψ (i : H) = Ψ (∑ i : s, a i • (i : H)) by
      simp only [map_sum, map_smul], hsum']
    exact Psi_eq_zero N f S H e (muH0_mem N hN f S H e _)
  have := flat_Sh f S
  obtain ⟨m, σ, yh, hxσ, hσ⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
  choose τ hτ using prS_surjective N hN f S H e L hL hflat
  have hyh : ∀ l, ∃ h : H, Ψ h = yh l := fun l ↦ by
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (e.symm (yh l))
    exact ⟨b, by simp [Ψ, Psi, hb]⟩
  choose yt hyt using hyh
  have hq : ∀ i : s, (i : H) - ∑ l, prH N hN f S H e L hL (τ (σ i l)) * yt l ∈
      N.map (algebraMap R H) := fun i ↦ by
    rw [← Psi_sub_eq_zero_iff N f S H e, map_sub, map_sum, show Ψ (i : H) = _ from hxσ i]
    simp only [map_mul, Psi_prH, hτ, hyt, Algebra.smul_def, Ψ, sub_self]
  choose w hw using fun i : s ↦ exists_muH0_eq N hN f S H e _ (hq i)
  let y : Fin m → TT N hN f S H e L hL := fun l ↦ ∑ i : s, a i • τ (σ i l)
  have hyker : ∀ l, y l ∈ N.map (algebraMap R (TT N hN f S H e L hL)) := fun l ↦ by
    rw [← ker_prS N hN f S H e L hL hNS hflat]
    change prS N hN f S H e L hL (y l) = 0
    simp only [y, map_sum, Algebra.smul_def, map_mul, AlgHom.commutes, hτ]
    exact hσ l
  have hyIn : ∀ l, y l ∈ ((Ideal.span (Set.range f)) ^ n).map
      (algebraMap R (TT N hN f S H e L hL)) := fun l ↦ by
    refine Submodule.sum_mem _ fun i _ ↦ ?_
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (ha i))
  choose zl hzl using fun l ↦ exists_Lam_eq N hN f S H e L hL hNS hflat (y l) (hyker l)
  choose sl hsl using fun l ↦ exists_sub_mem_Sh f S n (yh l)
  refine ⟨∑ l, sl l • zl l, ?_, ∑ i : s, a i • w i +
    ∑ l, zl l ⊗ₜ (yh l - algebraMap S _ (sl l)), ?_, ?_⟩
  · rw [map_sum]
    refine Submodule.sum_mem _ fun l _ ↦ ?_
    rw [Lam_smul N hN f S H e L hL hNS hflat _ _ (τ (sl l)) (hτ _), hzl]
    exact Ideal.mul_mem_left _ _ (hyIn l)
  · refine add_mem (Submodule.sum_mem _ fun i _ ↦ ?_) (Submodule.sum_mem _ fun l _ ↦ ?_)
    · rw [← algebraMap_smul S (a i) (w i)]
      exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ (ha i)) Submodule.mem_top
    · have hm := hsl l
      rw [map_pow_Sh, ← Ideal.map_pow] at hm
      have hm' : yh l - algebraMap S _ (sl l) ∈ K • (⊤ : Submodule S (Sh f S)) := by
        rwa [Ideal.smul_top_eq_map]
      refine Submodule.smul_induction_on hm' (fun c hc x _ ↦ ?_) (fun x y hx hy ↦ ?_)
      · rw [TensorProduct.tmul_smul]
        exact Submodule.smul_mem_smul hc Submodule.mem_top
      · rw [TensorProduct.tmul_add]
        exact add_mem hx hy
  · have h1 : ∀ l, (sl l • zl l) ⊗ₜ[S] (1 : Sh f S) +
        zl l ⊗ₜ[S] (yh l - algebraMap S (Sh f S) (sl l)) = zl l ⊗ₜ[S] yh l := by
      intro l
      rw [TensorProduct.smul_tmul, Algebra.smul_def, mul_one, ← TensorProduct.tmul_add]
      congr 1
      abel
    have h2 : z ⊗ₜ[S] (1 : Sh f S) - (∑ l, sl l • zl l) ⊗ₜ[S] (1 : Sh f S) -
        (∑ i : s, a i • w i + ∑ l, zl l ⊗ₜ[S] (yh l - algebraMap S (Sh f S) (sl l))) =
        z ⊗ₜ[S] (1 : Sh f S) - ∑ l, zl l ⊗ₜ[S] yh l - ∑ i : s, a i • w i := by
      have h1' : ∑ l, zl l ⊗ₜ[S] yh l = ∑ l, (sl l • zl l) ⊗ₜ[S] (1 : Sh f S) +
          ∑ l, zl l ⊗ₜ[S] (yh l - algebraMap S (Sh f S) (sl l)) := by
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun l _ ↦ (h1 l).symm
      rw [TensorProduct.sum_tmul, h1']
      abel
    rw [h2, map_sub, map_sub, map_sum, map_sum]
    simp only [map_smul, hw, muH0_tmul_mul N hN f S H e _ _ _ (hyt _)]
    simp only [← prH_Lam N hN f S H e L hL hNS hflat, hzl, y, map_sum, map_smul]
    rw [sum_comm_smul_mul, prH_Lam, ← hsum']
    simp only [smul_sub, Finset.sum_sub_distrib]
    abel

include hL hNS hflat in
/-- Injectivity of `T ⧸ Iⁿ T → H ⧸ Iⁿ H`. -/
theorem mem_map_of_prH_mem (n : ℕ) (t : TT N hN f S H e L hL)
    (hH : prH N hN f S H e L hL t ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R H)) :
    t ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R (TT N hN f S H e L hL)) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]
    exact Submodule.mem_top
  have hS : prS N hN f S H e L hL t ∈ ((Ideal.span (Set.range f)) ^ n).map (algebraMap R S) := by
    apply mem_of_algebraMap_mem_Sh f S n
    rw [← Psi_prH]
    exact e_mem_map N f S H e hH
  obtain ⟨t', ht', htt'⟩ := exists_mem_map_prS_eq N hN f S H e L hL hflat _ hS
  have hker : t - t' ∈ N.map (algebraMap R (TT N hN f S H e L hL)) := by
    rw [← ker_prS N hN f S H e L hL hNS hflat]
    change prS N hN f S H e L hL (t - t') = 0
    rw [map_sub, sub_eq_zero]
    exact htt'.symm
  have hH' : prH N hN f S H e L hL (t - t') ∈
      ((Ideal.span (Set.range f)) ^ n).map (algebraMap R H) := by
    rw [map_sub]
    exact sub_mem hH (algHom_mem_map _ ht')
  suffices t - t' ∈ ((Ideal.span (Set.range f)) ^ n).map
      (algebraMap R (TT N hN f S H e L hL)) by
    simpa using add_mem this ht'
  obtain ⟨z, hz⟩ := exists_Lam_eq N hN f S H e L hL hNS hflat _ hker
  rw [← hz] at hH' ⊢
  rw [prH_Lam] at hH'
  obtain ⟨s, a, ha, hsum⟩ := exists_finite_sum H hH'
  obtain ⟨z₁, hz₁, w₁, hw₁, hD⟩ := exists_approx N hN f S H e L hL hNS hflat n z s a ha hsum
  have h2 := Lam_mem_of_tmul N hN f S H e L hL hNS hflat n hn (z - z₁) w₁ hw₁
    (by rwa [TensorProduct.sub_tmul])
  rw [map_sub] at h2
  simpa using add_mem h2 hz₁

end Rig.SquareZeroLift

