module

public import StacksFrontier.RingTheory.AdicCompletion.IteratedMvPolynomial
public import StacksFrontier.RingTheory.Rig.Algebraization.AlgebraizationTower
public import StacksFrontier.RingTheory.Rig.Algebraization.GeneratorDrop
public import StacksFrontier.RingTheory.Rig.Algebraization.RigEtaleAlgebraizationAux
public import StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLift

/-!
# Algebraizing a rig-étale algebra from algebraizations of its quotients

Let `A` be a Noetherian ring, `I = (s ∪ {a})` and `B` rig-étale over `(A, I)`. Suppose that for
every `m ≥ 1` every rig-étale algebra over `Ā = A ⧸ (aᵐ)` and the ideal `Ī` generated by the image
of `s` is the `Ī`-adic completion of a finite type `Ā`-algebra. Then `B` is the `I`-adic completion
of a finite type `A`-algebra.

## Main definitions

* `Rig.AlgebraizationStage`: a finite type `A ⧸ (aⁿ⁺¹)`-algebra, étale over the complement of
  `V(I)`, with an identification of its `I`-adic completion with `B ⧸ aⁿ⁺¹ B`.

## Main results

* `Rig.nonempty_algebraizationTower`: a level `0` and a lift of every level `n` to a level `n + 1`
  give a compatible system `Rig.AlgebraizationTower I a B`.
* `Rig.exists_ringEquiv_quotientPowBaseChange`: the completed base change of `B` along
  `A → A ⧸ (aᵐ)` is `B ⧸ aᵐ B`.
* `Rig.exists_level`: for every `m ≥ 1` there is a finite type `Ā`-algebra, étale over the
  complement of `V(I)`, whose `I`-adic completion is `B ⧸ aᵐ B`.
* `Rig.exists_next`: every level `n` lifts to a level `n + 1` along a surjection of kernel `aⁿ⁺¹`.
* `Rig.exists_finiteType_algEquiv_of_algebraizes_quotients`: `B` is the `I`-adic completion of a
  finite type `A`-algebra.

## References

* [Stacks Project, Tag 0AKA](https://stacks.math.columbia.edu/tag/0AKA)
* [Stacks Project, Tag 0ALQ](https://stacks.math.columbia.edu/tag/0ALQ)
* [Stacks Project, Tag 0AL6](https://stacks.math.columbia.edu/tag/0AL6)
-/

@[expose] public noncomputable section

open CategoryTheory

namespace Rig

universe u

/-- Pushing `I` to `A ⧸ 𝔞` and then to an `A ⧸ 𝔞`-algebra `X` is pushing it to `X`. -/
public theorem map_map_quotientMk {A : Type u} [CommRing A] {𝔞 : Ideal A} (I : Ideal A)
    (X : Type*) [CommRing X] [Algebra A X] [Algebra (A ⧸ 𝔞) X] [IsScalarTower A (A ⧸ 𝔞) X] :
    (I.map (Ideal.Quotient.mk 𝔞)).map (algebraMap (A ⧸ 𝔞) X) = I.map (algebraMap A X) := by
  rw [Ideal.map_map, ← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_eq]

section Stage

variable {A : Type u} [CommRing A] (I : Ideal A) (a : A) (B : Type u) [CommRing B] [Algebra A B]

/-- A finite type `A ⧸ (aⁿ⁺¹)`-algebra `C`, étale over the complement of `V(I)`, with an
`A`-algebra isomorphism between its `I`-adic completion and `B ⧸ aⁿ⁺¹ B`. -/
public structure AlgebraizationStage (n : ℕ) where
  /-- The algebra `C`. -/
  C : Type u
  [commRing : CommRing C]
  [algebraQuot : Algebra (A ⧸ Ideal.span {a ^ (n + 1)}) C]
  [algebra : Algebra A C]
  [isScalarTower : IsScalarTower A (A ⧸ Ideal.span {a ^ (n + 1)}) C]
  [finiteType : Algebra.FiniteType (A ⧸ Ideal.span {a ^ (n + 1)}) C]
  /-- `C` is étale over the complement of `V(I)`. -/
  etale : IsEtaleOutside (I.map (Ideal.Quotient.mk (Ideal.span {a ^ (n + 1)}))) C
  /-- The identification of the completion of `C` with `B ⧸ aⁿ⁺¹ B`. -/
  equiv : AdicCompletion (I.map (algebraMap A C)) C ≃ₐ[A]
    B ⧸ (Ideal.span {a ^ (n + 1)}).map (algebraMap A B)

attribute [instance] AlgebraizationStage.commRing AlgebraizationStage.algebraQuot
  AlgebraizationStage.algebra AlgebraizationStage.isScalarTower AlgebraizationStage.finiteType

/-- If there is a level `0` and every level `n` lifts to a level `n + 1` along a surjection of
kernel `aⁿ⁺¹` compatible with the identifications of the completions, then there is a compatible
system `Rig.AlgebraizationTower I a B`. -/
public theorem nonempty_algebraizationTower (h0 : Nonempty (AlgebraizationStage I a B 0))
    (hnext : ∀ (n : ℕ) (St : AlgebraizationStage I a B n),
      ∃ (T : AlgebraizationStage I a B (n + 1)) (p : T.C →ₐ[A] St.C),
        Function.Surjective p ∧
        RingHom.ker p.toRingHom = (Ideal.span {a ^ (n + 1)}).map (algebraMap A T.C) ∧
        ∀ x : T.C, St.equiv (algebraMap St.C _ (p x)) =
          Ideal.Quotient.factor (Ideal.map_mono (Ideal.span_singleton_le_span_singleton.mpr
            (pow_dvd_pow a (Nat.le_succ (n + 1))))) (T.equiv (algebraMap T.C _ x))) :
    Nonempty (AlgebraizationTower I a B) := by
  let st : ∀ n, AlgebraizationStage I a B n := fun n ↦
    Nat.rec (motive := fun n ↦ AlgebraizationStage I a B n) h0.some
      (fun n St ↦ (hnext n St).choose) n
  exact ⟨{
    C := fun n ↦ (st n).C
    commRing := fun n ↦ (st n).commRing
    algebraQuot := fun n ↦ (st n).algebraQuot
    algebra := fun n ↦ (st n).algebra
    isScalarTower := fun n ↦ (st n).isScalarTower
    finiteType := fun n ↦ (st n).finiteType
    etale := fun n ↦ (st n).etale
    transition := fun n ↦ (hnext n (st n)).choose_spec.choose
    transition_surjective := fun n ↦ (hnext n (st n)).choose_spec.choose_spec.1
    transition_ker := fun n ↦ (hnext n (st n)).choose_spec.choose_spec.2.1
    equiv := fun n ↦ (st n).equiv
    equiv_transition := fun n ↦ (hnext n (st n)).choose_spec.choose_spec.2.2 }⟩

end Stage

/-- The `A`-algebra equivalence between the adic completions for two equal ideals. -/
private def adicCompletionCongrOfEq (A : Type*) {S : Type*} [CommRing A] [CommRing S] [Algebra A S]
    {I J : Ideal S} (h : J = I) : AdicCompletion I S ≃ₐ[A] AdicCompletion J S :=
  AdicCompletion.congrAlgEquiv AlgEquiv.refl (by rw [AlgEquiv.refl_toRingHom, Ideal.map_id, h])

private theorem adicCompletionCongrOfEq_algebraMap (A : Type*) {S : Type*} [CommRing A]
    [CommRing S] [Algebra A S] {I J : Ideal S} (h : J = I) (y : S) :
    adicCompletionCongrOfEq A h (algebraMap S _ y) = algebraMap S _ y :=
  AdicCompletion.congrAlgEquiv_of _ _ y

section Step

variable {A : Type u} [CommRing A] [IsNoetherianRing A] (s : Finset A) (a : A)

/-- The completed base change of `B` along `A → A ⧸ (aᵐ)` is `B ⧸ aᵐ B`, compatibly with the
structure maps from `A ⧸ (aᵐ)`. -/
public theorem exists_ringEquiv_quotientPowBaseChange {m : ℕ} (hm : 0 < m)
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A)))) :
    ∃ β : ((quotientPowBaseChange s a hm).functor.obj B).carrier ≃+*
        B.carrier ⧸ (Ideal.span {a ^ m}).map (algebraMap A B.carrier),
      ∀ y : A ⧸ Ideal.span {a ^ m},
        β (algebraMap _ _ y) = algebraMap (A ⧸ Ideal.span {a ^ m}) _ y := by
  let BC := quotientPowBaseChange s a hm
  obtain ⟨hc, hI⟩ := (exists_pow_map_span_insert_le_quotientPowSubIdeal s a hm).choose_spec
  have hbarI : quotientPowSubIdeal s a m ^ 1 ≤
      (Ideal.span (insert a (s : Set A))).map (Ideal.Quotient.mk (Ideal.span {a ^ m})) :=
    (pow_one (quotientPowSubIdeal s a m)).le.trans (quotientPowSubIdeal_le_map_span_insert s a m)
  have hbij := tensor_quotient_completion_bijective (Ideal.span (insert a (s : Set A)))
    (Ideal.span {a ^ m}) (quotientPowSubIdeal s a m) hc one_pos hI hbarI B
  let T := baseChangedAlgebra (A₂ := A ⧸ Ideal.span {a ^ m}) B
  let K := baseChangedIdeal (A₂ := A ⧸ Ideal.span {a ^ m}) (I₂ := quotientPowSubIdeal s a m) B
  have hof : ∀ t : T, algebraMap T (AdicCompletion K T) t = AdicCompletion.of K T t := fun t ↦ by
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply]
  have hbij' : Function.Bijective (algebraMap T (AdicCompletion K T)) := by
    rwa [show ⇑(algebraMap T (AdicCompletion K T)) = AdicCompletion.of K T from funext hof]
  let φ := RingEquiv.ofBijective (algebraMap T (AdicCompletion K T)) hbij'
  let q := Algebra.TensorProduct.quotIdealMapEquivTensorQuot B.carrier (Ideal.span {a ^ m})
  refine ⟨(BC.completedTensorProductEquiv B).trans (φ.symm.trans q.symm.toRingEquiv), fun y ↦ ?_⟩
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [RingEquiv.trans_apply, BC.algebraMap_completedTensorProductEquiv, RingEquiv.trans_apply,
    ← hof, show algebraMap T (AdicCompletion K T) (Algebra.TensorProduct.includeRight
      (Ideal.Quotient.mk _ x)) = φ (Algebra.TensorProduct.includeRight (Ideal.Quotient.mk _ x))
      from rfl, RingEquiv.symm_apply_apply, AlgEquiv.toRingEquiv_eq_coe, AlgEquiv.coe_ringEquiv,
    AlgEquiv.symm_apply_eq, Ideal.Quotient.algebraMap_quotient_map_quotient,
    Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk, Algebra.TensorProduct.includeRight_apply,
    ← Ideal.Quotient.algebraMap_eq]
  exact (Algebra.TensorProduct.tmul_one_eq_one_tmul (R := A) x).symm

/-- Suppose that for every `m ≥ 1` every rig-étale algebra over `Ā = A ⧸ (aᵐ)` and the ideal `Ī`
generated by the image of `s` is the `Ī`-adic completion of a finite type `Ā`-algebra. Then for
every `m ≥ 1` there is a finite type `Ā`-algebra `C`, étale over the complement of `V(I)`, whose
`I`-adic completion is `A`-isomorphic to `B ⧸ aᵐ B`. -/
public theorem exists_level
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigEtale B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigEtale B) {m : ℕ} (hm : 0 < m) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C) (_ : Algebra A C)
      (_ : IsScalarTower A (A ⧸ Ideal.span {a ^ m}) C),
      Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
      IsEtaleOutside ((Ideal.span (insert a (s : Set A))).map
        (Ideal.Quotient.mk (Ideal.span {a ^ m}))) C ∧
      Nonempty (AdicCompletion ((Ideal.span (insert a (s : Set A))).map (algebraMap A C)) C
        ≃ₐ[A] B.carrier ⧸ (Ideal.span {a ^ m}).map (algebraMap A B.carrier)) := by
  let I := Ideal.span (insert a (s : Set A))
  let Q := A ⧸ Ideal.span {a ^ m}
  let J := quotientPowSubIdeal s a m
  let Bm := (quotientPowBaseChange s a hm).functor.obj B
  have hBm : IsRigEtale Bm := isRigEtale_completedBaseChange_quotient_span_pow s a hm _ B hB
  obtain ⟨C₀, _, _, hft, ⟨E₀⟩⟩ := hIH m hm Bm hBm
  let : Algebra A C₀ := ((algebraMap Q C₀).comp (algebraMap A Q)).toAlgebra
  have : IsScalarTower A Q C₀ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hrig : IsRigEtale (adicCompletionObj J (B := C₀)) :=
    isRigEtale_of_algEquiv (B := adicCompletionObj J (B := C₀)) E₀.symm hBm
  obtain ⟨g, hg1, hgEt⟩ := exists_isEtaleOutside_localization_of_isRigEtale_adicCompletionObj J hrig
  obtain ⟨c, -, hcle⟩ := exists_pow_map_span_insert_le_quotientPowSubIdeal s a hm
  let K₁ := I.map (algebraMap A C₀)
  let K₂ := J.map (algebraMap Q C₀)
  have hK₁ : K₁ = (I.map (Ideal.Quotient.mk (Ideal.span {a ^ m}))).map (algebraMap Q C₀) :=
    (map_map_quotientMk I C₀).symm
  have h12 : K₁ ^ c ≤ K₂ := by
    rw [hK₁, ← Ideal.map_pow, ← Ideal.map_pow]
    exact Ideal.map_mono hcle
  have h21 : K₂ ^ 1 ≤ K₁ := by
    rw [pow_one, hK₁]
    exact Ideal.map_mono (quotientPowSubIdeal_le_map_span_insert s a m)
  have hg1' : g - 1 ∈ K₁ := h21 (by rwa [pow_one])
  obtain ⟨Eg, -⟩ := exists_adicCompletion_algEquiv_away K₁ hg1'
  have hCideal : I.map (algebraMap A (Localization.Away g)) =
      K₁.map (algebraMap C₀ (Localization.Away g)) := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  obtain ⟨β, hβ⟩ := exists_ringEquiv_quotientPowBaseChange s a hm B
  let γ : AdicCompletion K₂ C₀ ≃ₐ[Q]
      B.carrier ⧸ (Ideal.span {a ^ m}).map (algebraMap A B.carrier) :=
    AlgEquiv.ofRingEquiv (f := E₀.symm.toRingEquiv.trans β) fun y ↦ by
      rw [RingEquiv.trans_apply, AlgEquiv.toRingEquiv_eq_coe, AlgEquiv.coe_ringEquiv,
        AlgEquiv.commutes, hβ]
  refine ⟨Localization.Away g, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, ?_, ⟨?_⟩⟩
  · rwa [IsEtaleOutside, zeroLocus_map_span_insert_eq s a hm]
  · exact (adicCompletionCongrOfEq A hCideal.symm).trans
      ((Eg.restrictScalars A).symm.trans
      ((AdicCompletion.compareAlgEquiv A h12 h21).trans (γ.restrictScalars A)))

/-- Under the hypothesis of `Rig.exists_level`, every level `n` of the compatible system lifts to
a level `n + 1`: a surjection `C_{n+2} → C_{n+1}` of kernel `aⁿ⁺¹ C_{n+2}`, compatible with the
identifications of the completions. -/
public theorem exists_next
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigEtale B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigEtale B) (n : ℕ)
    (St : AlgebraizationStage (Ideal.span (insert a (s : Set A))) a B.carrier n) :
    ∃ (T : AlgebraizationStage (Ideal.span (insert a (s : Set A))) a B.carrier (n + 1))
      (p : T.C →ₐ[A] St.C), Function.Surjective p ∧
        RingHom.ker p.toRingHom = (Ideal.span {a ^ (n + 1)}).map (algebraMap A T.C) ∧
        ∀ x : T.C, St.equiv (algebraMap St.C _ (p x)) =
          Ideal.Quotient.factor (Ideal.map_mono (Ideal.span_singleton_le_span_singleton.mpr
            (pow_dvd_pow a (Nat.le_succ (n + 1))))) (T.equiv (algebraMap T.C _ x)) := by
  let I := Ideal.span (insert a (s : Set A))
  let R := A ⧸ Ideal.span {a ^ (n + 1 + 1)}
  let R₀ := A ⧸ Ideal.span {a ^ (n + 1)}
  have hle : Ideal.span {a ^ (n + 1 + 1)} ≤ Ideal.span {a ^ (n + 1)} :=
    Ideal.span_singleton_le_span_singleton.mpr (pow_dvd_pow a (Nat.le_succ (n + 1)))
  let : Algebra R R₀ := (Ideal.Quotient.factor hle).toAlgebra
  have : IsScalarTower A R R₀ := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hsurj : Function.Surjective (algebraMap R R₀) := Ideal.Quotient.factor_surjective hle
  have hker : RingHom.ker (algebraMap R R₀) =
      (Ideal.span {a ^ (n + 1)}).map (Ideal.Quotient.mk (Ideal.span {a ^ (n + 1 + 1)})) :=
    Ideal.Quotient.factor_ker hle
  have hsq : RingHom.ker (algebraMap R R₀) ^ 2 = ⊥ := by
    rw [hker, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_pow,
      Ideal.span_singleton_eq_bot, ← map_pow, Ideal.Quotient.eq_zero_iff_mem, ← pow_mul]
    exact Ideal.mem_span_singleton.mpr (pow_dvd_pow a (by omega))
  obtain ⟨k, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (Ideal.fg_of_isNoetherianRing (I.map (Ideal.Quotient.mk (Ideal.span {a ^ (n + 1 + 1)}))))
  have hf' : Ideal.span (Set.range f) =
      I.map (Ideal.Quotient.mk (Ideal.span {a ^ (n + 1 + 1)})) := hf
  have hJR : ∀ (X : Type u) [CommRing X] [Algebra A X] [Algebra R X] [IsScalarTower A R X],
      (Ideal.span (Set.range f)).map (algebraMap R X) = I.map (algebraMap A X) := by
    intro X _ _ _ _
    rw [hf', map_map_quotientMk]
  let S := St.C
  let : Algebra R S := ((algebraMap R₀ S).comp (algebraMap R R₀)).toAlgebra
  have : IsScalarTower R R₀ S := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq fun x ↦ by
    rw [IsScalarTower.algebraMap_apply A R₀ S]
    rfl
  have hS : IsEtaleOutside ((Ideal.span (Set.range f)).map (algebraMap R R₀)) S := by
    rw [hJR R₀, Ideal.Quotient.algebraMap_eq]
    exact St.etale
  let H := B.carrier ⧸ (Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B.carrier)
  have hH : IsAdicComplete ((Ideal.span (Set.range f)).map (algebraMap R H)) H := by
    rw [hJR H]
    exact (quotient_isAdicFiniteType B _).1
  obtain ⟨D, _, _, _, _, hDft, hDet, ⟨eD⟩⟩ :=
    exists_level s a hIH B hB (m := n + 1 + 1) (Nat.succ_pos _)
  have hDet' : IsEtaleOutside (Ideal.span (Set.range f)) D := by
    rwa [hf']
  let eD' : AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R D)) D ≃ₐ[R] H :=
    AlgEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
      ((adicCompletionCongrOfEq A (hJR D).symm).trans eD)
  have hflat : ∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i))) := fun i ↦
    flat_away_of_isEtaleOutside hDet' eD' (Ideal.subset_span ⟨i, rfl⟩)
  have hKH : (RingHom.ker (algebraMap R R₀)).map (algebraMap R H) =
      ((Ideal.span {a ^ (n + 1)}).map (algebraMap A B.carrier)).map
        (Ideal.Quotient.mkₐ A ((Ideal.span {a ^ (n + 1 + 1)}).map (algebraMap A B.carrier))) := by
    rw [hker, map_map_quotientMk]
    exact (Ideal.map_map (algebraMap A B.carrier) (Ideal.Quotient.mk _)).symm
  let ψ : (H ⧸ (RingHom.ker (algebraMap R R₀)).map (algebraMap R H)) ≃ₐ[A]
      B.carrier ⧸ (Ideal.span {a ^ (n + 1)}).map (algebraMap A B.carrier) :=
    (Ideal.quotientEquivAlgOfEq A hKH).trans
      (DoubleQuot.quotQuotEquivQuotOfLEₐ A (Ideal.map_mono hle))
  have hψ : ∀ h : H, ψ (Ideal.Quotient.mk _ h) = Ideal.Quotient.factor (Ideal.map_mono hle) h := by
    intro h
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective h
    rfl
  have hSI : (Ideal.span (Set.range f)).map (algebraMap R S) = I.map (algebraMap A S) := hJR S
  let F : AdicCompletion (I.map (algebraMap A S)) S ≃ₐ[A]
      AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S :=
    adicCompletionCongrOfEq A hSI
  let e : (H ⧸ (RingHom.ker (algebraMap R R₀)).map (algebraMap R H)) ≃ₐ[R]
      AdicCompletion ((Ideal.span (Set.range f)).map (algebraMap R S)) S :=
    AlgEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
      (ψ.trans (St.equiv.symm.trans F))
  obtain ⟨T, _, _, hTft, hTet, p, φ, hpsurj, hpker, hcompat, E, hE⟩ :=
    exists_squareZeroLift hsurj hsq f S hS H hH hflat e
  let : Algebra A T := ((algebraMap R T).comp (algebraMap A R)).toAlgebra
  have : IsScalarTower A R T := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let T' : AlgebraizationStage I a B.carrier (n + 1) :=
    { C := T
      etale := by rwa [← hf']
      equiv := (adicCompletionCongrOfEq A (hJR T)).trans (E.restrictScalars A) }
  refine ⟨T', p.restrictScalars A, hpsurj, ?_, fun x ↦ ?_⟩
  · rwa [hker, map_map_quotientMk] at hpker
  · have h2 : T'.equiv (algebraMap T _ x) = φ x := by
      simp only [T', AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
      exact (congrArg E (adicCompletionCongrOfEq_algebraMap A _ x)).trans (hE x)
    have h3 : St.equiv.symm (ψ (Ideal.Quotient.mk _ (φ x))) =
        algebraMap S (AdicCompletion (I.map (algebraMap A S)) S) (p x) := by
      apply F.injective
      rw [adicCompletionCongrOfEq_algebraMap, ← hcompat x]
      rfl
    rw [h2, ← hψ]
    exact (congrArg St.equiv h3).symm.trans (St.equiv.apply_symm_apply _)

/-- Under the hypothesis of `Rig.exists_level`, the compatible system has a level `0`. -/
public theorem nonempty_algebraizationStage_zero
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigEtale B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigEtale B) :
    Nonempty (AlgebraizationStage (Ideal.span (insert a (s : Set A))) a B.carrier 0) := by
  obtain ⟨C, _, _, _, _, _, het, ⟨eq⟩⟩ := exists_level s a hIH B hB (m := 0 + 1) one_pos
  exact ⟨{ C := C, etale := het, equiv := eq }⟩

/-- Let `A` be a Noetherian ring, `I = (s ∪ {a})` and `B` rig-étale over `(A, I)`. If for every
`m ≥ 1` every rig-étale algebra over `A ⧸ (aᵐ)` and the ideal generated by the image of `s` is the
adic completion of a finite type algebra, then `B` is the `I`-adic completion of a finite type
`A`-algebra. -/
public theorem exists_finiteType_algEquiv_of_algebraizes_quotients
    (hIH : ∀ m, 0 < m → ∀ B' : AdicFiniteTypeAlgebra.{u, u} (A ⧸ Ideal.span {a ^ m})
        (quotientPowSubIdeal s a m), IsRigEtale B' →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ Ideal.span {a ^ m}) C),
        Algebra.FiniteType (A ⧸ Ideal.span {a ^ m}) C ∧
          Nonempty (B'.carrier ≃ₐ[A ⧸ Ideal.span {a ^ m}]
            AdicCompletion ((quotientPowSubIdeal s a m).map
              (algebraMap (A ⧸ Ideal.span {a ^ m}) C)) C))
    (B : AdicFiniteTypeAlgebra.{u, u} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigEtale B) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
      Algebra.FiniteType A C ∧
        Nonempty (B.carrier ≃ₐ[A]
          AdicCompletion ((Ideal.span (insert a (s : Set A))).map (algebraMap A C)) C) := by
  obtain ⟨T⟩ := nonempty_algebraizationTower _ a B.carrier
    (nonempty_algebraizationStage_zero s a hIH B hB) (exists_next s a hIH B hB)
  exact AlgebraizationTower.exists_algebraization (Ideal.subset_span (Set.mem_insert a _)) B hB T

end Step

end Rig

