module

public import StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftComplete

/-!
# Recognising a completion from its quotients

An `R`-algebra map `φ : T → H` to an `I`-adically complete `R`-algebra which induces
isomorphisms `T ⧸ Iⁿ T ≅ H ⧸ Iⁿ H` for all `n` identifies the `I`-adic completion of `T`
(`T` Noetherian) with `H`.

## Main results

* `Rig.SquareZeroLift.evalₐ_eq_zero_iff`: the kernel of `AdicCompletion.evalₐ J n` is `J ^ n`
  times the completion.
* `Rig.SquareZeroLift.exists_algEquiv_adicCompletion_of_bijective`: an `R`-algebra map `T → H`
  inducing bijections on all quotients by powers of `I` extends to an isomorphism from the
  `I`-adic completion of `T` onto `H`.
-/

@[expose] public section

namespace Rig.SquareZeroLift

universe u

/-- For a Noetherian ring `A`, an element `y` of the `J`-adic completion of `A` maps to zero in
`A ⧸ J ^ n` if and only if `y` lies in `J ^ n` times the completion. -/
theorem evalₐ_eq_zero_iff {A : Type*} [CommRing A] [IsNoetherianRing A] (J : Ideal A) (n : ℕ)
    (y : AdicCompletion J A) :
    AdicCompletion.evalₐ J n y = 0 ↔ y ∈ J ^ n • (⊤ : Submodule A (AdicCompletion J A)) := by
  rw [AdicCompletion.pow_smul_top_eq_ker_eval (IsNoetherian.noetherian J), LinearMap.mem_ker]
  constructor
  · intro h
    rw [← AdicCompletion.factor_evalₐ_eq_eval J y (by rw [smul_eq_mul, Ideal.mul_top]), h,
      map_zero]
  · intro h
    rw [← AdicCompletion.factor_eval_eq_evalₐ J y (by rw [smul_eq_mul, Ideal.mul_top]), h,
      map_zero]

/-- For `m ≤ n`, the image of an element of the `J`-adic completion of `A` in `A ⧸ J ^ n`, reduced
to `A ⧸ J ^ m`, is its image in `A ⧸ J ^ m`. -/
theorem factor_evalₐ {A : Type*} [CommRing A] [IsNoetherianRing A] (J : Ideal A) {m n : ℕ}
    (hle : m ≤ n) (y : AdicCompletion J A) :
    Ideal.Quotient.factor (Ideal.pow_le_pow_right hle) (AdicCompletion.evalₐ J n y) =
      AdicCompletion.evalₐ J m y := by
  obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n y)
  have h1 : AdicCompletion.evalₐ J n (y - AdicCompletion.of J A t) = 0 := by
    rw [map_sub, AdicCompletion.evalₐ_of, ht, sub_self]
  rw [evalₐ_eq_zero_iff] at h1
  have h2 : AdicCompletion.evalₐ J m (y - AdicCompletion.of J A t) = 0 := by
    rw [evalₐ_eq_zero_iff]
    exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hle) h1
  rw [map_sub, AdicCompletion.evalₐ_of, sub_eq_zero] at h2
  rw [← ht, h2, Ideal.Quotient.factor_mk]

/-- Let `φ : T → H` be an `R`-algebra map with `T` Noetherian and `H` complete for the ideal
generated by `I`. If `φ` induces bijections `T ⧸ Iⁿ T → H ⧸ Iⁿ H` for all `n`, then there is an
`R`-algebra isomorphism from the `I`-adic completion of `T` onto `H` extending `φ`. -/
theorem exists_algEquiv_adicCompletion_of_bijective {R : Type*} [CommRing R] (I : Ideal R)
    {T H : Type*} [CommRing T] [Algebra R T] [IsNoetherianRing T] [CommRing H] [Algebra R H]
    [IsAdicComplete (I.map (algebraMap R H)) H] (φ : T →ₐ[R] H)
    (hsurj : ∀ n (h : H), ∃ t, h - φ t ∈ (I ^ n).map (algebraMap R H))
    (hinj : ∀ n (t : T), φ t ∈ (I ^ n).map (algebraMap R H) → t ∈ (I ^ n).map (algebraMap R T)) :
    ∃ E : AdicCompletion (I.map (algebraMap R T)) T ≃ₐ[R] H,
      ∀ x, E (algebraMap T _ x) = φ x := by
  set IT := I.map (algebraMap R T)
  set IH := I.map (algebraMap R H)
  have hle : ∀ n, IT ^ n ≤ (IH ^ n).comap φ.toRingHom := fun n ↦ by
    rw [← Ideal.map_le_iff_le_comap, ← Ideal.map_pow, ← Ideal.map_pow, Ideal.map_map,
      AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
  let φn : ∀ n, (T ⧸ IT ^ n) →ₐ[R] (H ⧸ IH ^ n) := fun n ↦ Ideal.quotientMapₐ _ φ (hle n)
  have hφn : ∀ n t, φn n (Ideal.Quotient.mk _ t) = Ideal.Quotient.mk _ (φ t) := fun _ _ ↦ rfl
  have hbij : ∀ n, Function.Bijective (φn n) := by
    intro n
    constructor
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hφn, Ideal.Quotient.eq_zero_iff_mem, ← Ideal.map_pow] at hx
      rw [Ideal.Quotient.eq_zero_iff_mem, ← Ideal.map_pow]
      exact hinj n t hx
    · intro y
      obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨t, ht⟩ := hsurj n h
      refine ⟨Ideal.Quotient.mk _ t, ?_⟩
      rw [hφn, Ideal.Quotient.eq, ← Ideal.map_pow, ← neg_mem_iff, neg_sub]
      exact ht
  let εn : ∀ n, (T ⧸ IT ^ n) ≃ₐ[R] (H ⧸ IH ^ n) := fun n ↦ AlgEquiv.ofBijective (φn n) (hbij n)
  let ψn : ∀ n, H →ₐ[R] T ⧸ IT ^ n := fun n ↦
    (εn n).symm.toAlgHom.comp (Ideal.Quotient.mkₐ R (IH ^ n))
  have hψn : ∀ n h, φn n (ψn n h) = Ideal.Quotient.mk _ h := fun n h ↦
    (εn n).apply_symm_apply _
  have hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
      (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp (ψn n) = ψn m := by
    intro m n hmn
    ext h
    apply (hbij m).1
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (ψn n h)
    have h1 := hψn n h
    rw [← ht, hφn, Ideal.Quotient.eq] at h1
    rw [AlgHom.comp_apply, ← ht, Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk, hφn,
      hψn, Ideal.Quotient.eq]
    exact Ideal.pow_le_pow_right hmn h1
  let F := AdicCompletion.liftAlgHom IT ψn hcompat
  have hFe : ∀ n h, AdicCompletion.evalₐ IT n (F h) = ψn n h := fun n h ↦
    AdicCompletion.evalₐ_liftAlgHom _ _ _ _ _
  have hcompat' : ∀ {m n : ℕ} (hmn : m ≤ n),
      (Ideal.Quotient.factorₐ R (Ideal.pow_le_pow_right hmn)).comp
        ((φn n).comp ((AdicCompletion.evalₐ IT n).restrictScalars R)) =
        (φn m).comp ((AdicCompletion.evalₐ IT m).restrictScalars R) := by
    intro m n hmn
    ext y
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ IT n y)
    simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply]
    rw [← factor_evalₐ IT hmn y, ← ht, Ideal.Quotient.factor_mk, hφn, hφn,
      Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk]
  let G := AdicCompletion.liftAlgHom IH
    (fun n ↦ (φn n).comp ((AdicCompletion.evalₐ IT n).restrictScalars R)) hcompat'
  have hFinj : Function.Injective F :=
    (injective_iff_map_eq_zero F).2 fun h hh ↦ IsHausdorff.haus' (I := IH) h fun n ↦ by
      rw [SModEq.zero, smul_eq_mul, Ideal.mul_top, ← Ideal.Quotient.eq_zero_iff_mem, ← hψn,
        ← hFe, hh, map_zero, map_zero]
  have hFsurj : Function.Surjective F := by
    intro x
    refine ⟨(AdicCompletion.ofAlgEquiv IH).symm (G x), AdicCompletion.ext_evalₐ fun n ↦ ?_⟩
    rw [hFe]
    apply (hbij n).1
    rw [hψn, AdicCompletion.mk_ofAlgEquiv_symm]
    exact AdicCompletion.evalₐ_liftAlgHom _ _ _ _ _
  refine ⟨(AlgEquiv.ofBijective F ⟨hFinj, hFsurj⟩).symm, fun x ↦ ?_⟩
  rw [AlgEquiv.symm_apply_eq]
  refine AdicCompletion.ext_evalₐ fun n ↦ ?_
  change _ = AdicCompletion.evalₐ IT n (F (φ x))
  rw [hFe]
  apply (hbij n).1
  rw [hψn, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    AdicCompletion.evalₐ_of, hφn]

end Rig.SquareZeroLift

end
