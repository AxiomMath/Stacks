module

public import StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftRing
public import StacksFrontier.RingTheory.Localization.Glueing.FormalGlueingComplexH1

/-!
# The glued ring surjects onto `S`

In the setting of `StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftRing`, this file
proves that the projection `T → S` is surjective. Given `s ∈ S`, choose lifts `h ∈ H` and
`v_i ∈ V_i`; their defects on the overlaps form a cocycle of the glueing complex of
`P = S ⊗[R] N` for the flat map `S → S^∧`, which is a coboundary by
`FormalGlueing.glueingComplex_exact_two`; correcting the lifts by it gives a preimage of `s`.

## Main results

* `Rig.SquareZeroLift.prS_surjective`: the projection `T → S` is surjective.
-/

@[expose] public section

namespace Rig.SquareZeroLift

open TensorProduct Cech FormalGlueing

universe u

variable {R : Type u} [CommRing R] (N : Ideal R) (hN : N ^ 2 = ⊥)
variable {k : ℕ} (f : Fin k → R)
variable (S : Type u) [CommRing S] [Algebra R S]
variable (H : Type u) [CommRing H] [Algebra R H]
variable (e : (H ⧸ N.map (algebraMap R H)) ≃ₐ[R] Sh f S)
variable (L : ∀ s : Finset (Fin k), NilLift R N (Sl f S s))
variable (hL : ∀ s, s.Nonempty → Algebra.Etale R (L s).carrier)

/-- The ideal of `S` generated by the images of the `f i` is the extension of the ideal `(f)` of
`R`. -/
theorem span_range_gS :
    Ideal.span (Set.range (gS f S)) = (Ideal.span (Set.range f)).map (algebraMap R S) := by
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- For `S` Noetherian, the completion `S^∧` is flat over `S`. -/
theorem flat_Sh [IsNoetherianRing S] : Module.Flat S (Sh f S) :=
  AdicCompletion.flat_of_isNoetherian _

/-- For `S` Noetherian, the map `S ⧸ (gS f S) → S^∧ ⧸ (gS f S) S^∧` induced by
`S → S^∧` is bijective. -/
theorem quotientMap_Sh_bijective [IsNoetherianRing S] :
    Function.Bijective (Ideal.quotientMap
      ((Ideal.span (Set.range (gS f S))).map (algebraMap S (Sh f S)))
      (algebraMap S (Sh f S)) Ideal.le_comap_map) := by
  rw [span_range_gS]
  exact quotientMap_adicCompletion_bijective _ (IsNoetherian.noetherian _)

/-- A two-element subset of `Fin k` is `{i, j}` for some `i < j`. -/
theorem exists_sorted_pair (T : {s : Finset (Fin k) // s.card = 2}) :
    ∃ i j : Fin k, i < j ∧ T.1 = {i, j} := by
  obtain ⟨i, j, hij, hT⟩ := Finset.card_eq_two.mp T.2
  rcases lt_or_gt_of_ne hij with h | h
  · exact ⟨i, j, h, hT⟩
  · exact ⟨j, i, h, hT.trans (Finset.pair_comm i j)⟩

/-- For `T = {i, j}` with `i < j`, the Čech differential of a `1`-cochain `x` at `T` is
`ι (x j) - ι (x i)`. -/
private theorem cechDiff_one_sorted {X : Finset (Fin k) → Type*} [∀ s, AddCommGroup (X s)]
    (ι : ∀ {s t : Finset (Fin k)}, s ⊆ t → X s →+ X t) (x : FamTerm X 1)
    (T : {s : Finset (Fin k) // s.card = 2}) {i j : Fin k} (hij : i < j) (hT : T.1 = {i, j}) :
    ∃ (hu : (singletonIndex i).1 ⊆ T.1) (hv : (singletonIndex j).1 ⊆ T.1),
      cechDiff X ι 1 x T = ι hv (x (singletonIndex j)) - ι hu (x (singletonIndex i)) := by
  have hu : (singletonIndex i).1 ⊆ T.1 := by rw [hT]; simp
  have hv : (singletonIndex j).1 ⊆ T.1 := by rw [hT]; simp
  exact ⟨hu, hv, cechDiff_one_apply X ι x T hij hT _ _ rfl rfl hu hv⟩

/-- On a two-element subset `T`, the Čech differential of a `1`-cochain `x` is
`ι (x v) - ι (x u)` for some singletons `u, v ⊆ T`. -/
theorem cechDiff_one_pair {X : Finset (Fin k) → Type*} [∀ s, AddCommGroup (X s)]
    (ι : ∀ {s t : Finset (Fin k)}, s ⊆ t → X s →+ X t) (x : FamTerm X 1)
    (T : {s : Finset (Fin k) // s.card = 2}) :
    ∃ (u v : {s : Finset (Fin k) // s.card = 1}) (hu : u.1 ⊆ T.1) (hv : v.1 ⊆ T.1),
      cechDiff X ι 1 x T = ι hv (x v) - ι hu (x u) := by
  obtain ⟨i, j, hij, hT⟩ := exists_sorted_pair T
  obtain ⟨hu, hv, h⟩ := cechDiff_one_sorted ι x T hij hT
  exact ⟨_, _, hu, hv, h⟩

/-- In positive degree, the comparison maps `muV` commute with the differentials of the glueing
complex of `P` and of the Čech complex of the lifts `V_s`. -/
theorem muV_cechDiff (p : ℕ) (hp : 0 < p) (y : GlueingTerm (gS f S) (PS N S) p)
    (T : {s : Finset (Fin k) // s.card = p + 1}) :
    muV N hN f S L T.1 (glueingDifferential (gS f S) (PS N S) p y T) =
      cechDiff (XV N f S L) (ιV N hN f S L hL) p (fun s ↦ muV N hN f S L s.1 (y s)) T := by
  rw [glueingDifferential_eq_cechDiff]
  exact cechDiff_natural _ _ (ιV N hN f S L hL) (fun s ↦ (muV N hN f S L s).toAddMonoidHom) hp
    (fun s t h hs x ↦ by
      simp only [LinearMap.toAddMonoidHom_coe]
      rw [ιV_apply N hN f S L hL h hs]
      exact muV_cechι N hN f S L hL h hs x) y T

/-- In positive degree, the comparison maps `muH` commute with the differentials of the glueing
complex of `P'` and of the Čech complex of the localizations `H_s`. -/
theorem muH_cechDiff (p : ℕ) (y : GlueingTerm (gS f S) (PH N f S) p)
    (T : {s : Finset (Fin k) // s.card = p + 1}) (hp : 0 < p) :
    muH N hN f S H e T.1 (glueingDifferential (gS f S) (PH N f S) p y T) =
      cechDiff (Hl f H) (ιH f H) p (fun s ↦ muH N hN f S H e s.1 (y s)) T := by
  rw [glueingDifferential_eq_cechDiff]
  exact cechDiff_natural _ _ (ιH f H) (fun s ↦ (muH N hN f S H e s).toAddMonoidHom) hp
    (fun s t h _ x ↦ muH_cechι N hN f S H e h x) y T

/-- The composite of two consecutive Čech differentials of the family of lifts `V_s`, from
degree `1` to degree `3`, is zero. -/
theorem cechDiff_ιV_cechDiff (x : FamTerm (XV N f S L) 1) :
    cechDiff (XV N f S L) (ιV N hN f S L hL) 2 (cechDiff (XV N f S L) (ιV N hN f S L hL) 1 x) =
      0 :=
  cechDiff_cechDiff _ _ (fun s t w h h' hs x ↦ by
    rw [ιV_apply N hN f S L hL h hs, ιV_apply N hN f S L hL h' (hs.mono h),
      ιV_apply N hN f S L hL (h.trans h') hs, sig_sig]) x

variable (s₀ : S) (h₀ : H) (v₀ : FamTerm (XV N f S L) 1)

/-- If each `v₀ u` lifts the image of `s₀` in `S_u`, then its transport to any `V_t` with
`u ⊆ t` lifts the image of `s₀` in `S_t`. -/
theorem psi_ιV_v₀ (hv₀ : ∀ u : {s : Finset (Fin k) // s.card = 1},
      (L u.1).ψ (v₀ u) = algebraMap S (Sl f S u.1) s₀)
    (u : {s : Finset (Fin k) // s.card = 1}) {t : Finset (Fin k)} (h : u.1 ⊆ t) :
    (L t).ψ (ιV N hN f S L hL h (v₀ u)) = algebraMap S _ s₀ := by
  rw [ιV_apply N hN f S L hL h (nonempty_of_card_eq u), psi_sig, hv₀, locS_algebraMap]

/-- If `h₀ ∈ H` and the `v₀ u ∈ V_u` all lift `s₀ ∈ S`, then for every singleton `u` the
difference `ρ_u (v₀ u) - h₀` in `H_u` lies in `N H_u`. -/
theorem defect_mem (hhb : e (Ideal.Quotient.mk _ h₀) = algebraMap S (Sh f S) s₀)
    (hv₀ : ∀ u : {s : Finset (Fin k) // s.card = 1},
      (L u.1).ψ (v₀ u) = algebraMap S (Sl f S u.1) s₀)
    (u : {s : Finset (Fin k) // s.card = 1}) :
    rho N hN f S H e L hL u.1 (nonempty_of_card_eq u) (v₀ u) - algebraMap H _ h₀ ∈
      N.map (algebraMap R (Hl f H u.1)) := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, mk_rho, hv₀, chi_algebraMap, sub_eq_zero]
  have : e.symm (algebraMap S (Sh f S) s₀) = Ideal.Quotient.mk _ h₀ := by
    rw [← hhb, AlgEquiv.symm_apply_apply]
  show redMap N _ (e.symm (algebraMap S (Sh f S) s₀)) = _
  rw [this, redMap_mk]
  rfl

/-- If the `v₀ u ∈ V_u` all lift `s₀ ∈ S`, then the Čech differential of `v₀` at a two-element
subset `T` lies in `N V_T`. -/
theorem dd_mem (hv₀ : ∀ u : {s : Finset (Fin k) // s.card = 1},
      (L u.1).ψ (v₀ u) = algebraMap S (Sl f S u.1) s₀)
    (T : {s : Finset (Fin k) // s.card = 2}) :
    cechDiff (XV N f S L) (ιV N hN f S L hL) 1 v₀ T ∈ N.map (algebraMap R (L T.1).carrier) := by
  obtain ⟨u, v, hu, hv, hT⟩ := cechDiff_one_pair (ιV N hN f S L hL) v₀ T
  rw [NilLift.mem_iff, hT, map_sub, psi_ιV_v₀ N hN f S L hL s₀ v₀ hv₀,
    psi_ιV_v₀ N hN f S L hL s₀ v₀ hv₀, sub_self]

/-- A degree-`2` cochain `X` of the glueing complex of `P` mapped by `muV` to the Čech
differential of `v₀` is a cocycle. -/
theorem cocycle_X (X : GlueingTerm (gS f S) (PS N S) 2)
    (hX : ∀ T : {s : Finset (Fin k) // s.card = 2},
      muV N hN f S L T.1 (X T) = cechDiff (XV N f S L) (ιV N hN f S L hL) 1 v₀ T) :
    glueingDifferential (gS f S) (PS N S) 2 X = 0 := by
  funext T
  apply muV_injective N hN f S L hL T.1 (nonempty_of_card_eq T)
  rw [muV_cechDiff N hN f S L hL 2 (by norm_num), Pi.zero_apply, map_zero]
  have : (fun s : {s : Finset (Fin k) // s.card = 2} ↦ muV N hN f S L s.1 (X s)) =
      cechDiff (XV N f S L) (ιV N hN f S L hL) 1 v₀ := funext hX
  rw [this, cechDiff_ιV_cechDiff]
  rfl

/-- If `X` is mapped by `muV` to the Čech differential of `v₀` and `Y` is mapped by `muH` to the
defects `ρ_u (v₀ u) - h₀`, then the differential of `Y` in the glueing complex of `P'` is the
image of `X` under `localizationTensorMap`. -/
theorem compat_YX (hflat : ∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i))))
    (X : GlueingTerm (gS f S) (PS N S) 2) (Y : GlueingTerm (gS f S) (PH N f S) 1)
    (hX : ∀ T : {s : Finset (Fin k) // s.card = 2},
      muV N hN f S L T.1 (X T) = cechDiff (XV N f S L) (ιV N hN f S L hL) 1 v₀ T)
    (hY : ∀ u : {s : Finset (Fin k) // s.card = 1}, muH N hN f S H e u.1 (Y u) =
      rho N hN f S H e L hL u.1 (nonempty_of_card_eq u) (v₀ u) - algebraMap H _ h₀) :
    glueingDifferential (gS f S) (PH N f S) 1 Y =
      localizationTensorMap (Sh f S) (gS f S) (PS N S) 2 X := by
  funext T
  apply muH_injective N hN f S H e hflat T.1 (nonempty_of_card_eq T)
  rw [muH_cechDiff N hN f S H e 1 Y T (by norm_num)]
  have h1 : muH N hN f S H e T.1 (localizationTensorMap (Sh f S) (gS f S) (PS N S) 2 X T) =
      rho N hN f S H e L hL T.1 (nonempty_of_card_eq T)
        (cechDiff (XV N f S L) (ιV N hN f S L hL) 1 v₀ T) := by
    rw [← hX]
    exact muH_unit_eq_rho_muV N hN f S H e L hL T.1 (nonempty_of_card_eq T) (X T)
  rw [h1, show (fun s : {s : Finset (Fin k) // s.card = 1} ↦ muH N hN f S H e s.1 (Y s)) =
    fun u ↦ rho N hN f S H e L hL u.1 (nonempty_of_card_eq u) (v₀ u) - algebraMap H _ h₀ from
    funext hY]
  obtain ⟨i, j, hij, hT⟩ := exists_sorted_pair T
  obtain ⟨hu, hv, h2⟩ := cechDiff_one_sorted (ιH f H) _ T hij hT
  obtain ⟨hu', hv', h3⟩ := cechDiff_one_sorted (ιV N hN f S L hL) v₀ T hij hT
  rw [h2, h3,
    ιV_apply N hN f S L hL _ (nonempty_of_card_eq _),
    ιV_apply N hN f S L hL _ (nonempty_of_card_eq _),
    map_sub (rho N hN f S H e L hL T.1 (nonempty_of_card_eq T)), rho_sig, rho_sig]
  simp only [ιH, AddMonoidHom.coe_coe, RingHom.toAddMonoidHom_eq_coe,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, locH_algebraMap]
  abel

/-- If `(y₀, x)` is a preimage of `(Y, X)` under `glueingBeta`, then correcting `h₀` by
`muH0 y₀` and each `v₀ u` by `muV (x u)` gives an element of the glued ring `T` lying over
`s₀`. -/
theorem new_mem (hhb : e (Ideal.Quotient.mk _ h₀) = algebraMap S (Sh f S) s₀)
    (hv₀ : ∀ u : {s : Finset (Fin k) // s.card = 1},
      (L u.1).ψ (v₀ u) = algebraMap S (Sl f S u.1) s₀)
    (X : GlueingTerm (gS f S) (PS N S) 2) (Y : GlueingTerm (gS f S) (PH N f S) 1)
    (hX : ∀ T : {s : Finset (Fin k) // s.card = 2},
      muV N hN f S L T.1 (X T) = cechDiff (XV N f S L) (ιV N hN f S L hL) 1 v₀ T)
    (hY : ∀ u : {s : Finset (Fin k) // s.card = 1}, muH N hN f S H e u.1 (Y u) =
      rho N hN f S H e L hL u.1 (nonempty_of_card_eq u) (v₀ u) - algebraMap H _ h₀)
    (y₀ : PH N f S) (x : GlueingTerm (gS f S) (PS N S) 1)
    (hyx : glueingBeta (Sh f S) (gS f S) (PS N S) (y₀, x) = (Y, X)) :
    (s₀, h₀ + muH0 N hN f S H e y₀, fun u ↦ v₀ u + muV N hN f S L u.1 (x u)) ∈
      glued N hN f S H e L hL := by
  have hYx : ∀ u, Y u = LocalizedModule.mkLinearMap _ _ y₀ -
      LocalizedModule.map (cechSub (gS f S) u.1)
        ((TensorProduct.mk S (PS N S) (Sh f S)).flip 1) (x u) := by
    intro u
    exact (congrFun (congrArg Prod.fst hyx) u).symm
  have hXx : X = -glueingDifferential (gS f S) (PS N S) 1 x :=
    (congrArg Prod.snd hyx).symm
  rw [mem_glued]
  refine ⟨?_, fun u ↦ ?_, fun u ↦ ?_, ?_⟩
  · have : Ideal.Quotient.mk (N.map (algebraMap R H)) (muH0 N hN f S H e y₀) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (muH0_mem N hN f S H e y₀)
    simp only [map_add, this, add_zero, hhb]
  · have : (L u.1).ψ (muV N hN f S L u.1 (x u)) = 0 :=
      ((L u.1).mem_iff N _).mp (muV_mem N hN f S L u.1 (x u))
    simp only [map_add, this, add_zero, hv₀]
  · have h2 := hY u
    rw [hYx u, map_sub, muH_mk, muH_unit_eq_rho_muV N hN f S H e L hL u.1
      (nonempty_of_card_eq u)] at h2
    simp only [map_add]
    linear_combination -h2
  · funext T
    let w : FamTerm (XV N f S L) 1 := fun u ↦ muV N hN f S L u.1 (x u)
    have hw : (fun u : {s : Finset (Fin k) // s.card = 1} ↦ v₀ u + muV N hN f S L u.1 (x u)) =
        v₀ + w := rfl
    rw [hw, cechDiff_add, Pi.add_apply]
    have h3 : cechDiff (XV N f S L) (ιV N hN f S L hL) 1 w T =
        muV N hN f S L T.1 (glueingDifferential (gS f S) (PS N S) 1 x T) :=
      (muV_cechDiff N hN f S L hL 1 (by norm_num) x T).symm
    rw [h3, ← hX T, ← map_add, hXx, Pi.neg_apply, neg_add_cancel, map_zero]
    rfl

/-- **The glued ring surjects onto `S`.** -/
theorem prS_surjective [IsNoetherianRing S]
    (hflat : ∀ i, Module.Flat R (Localization.Away (algebraMap R H (f i)))) :
    Function.Surjective (prS N hN f S H e L hL) := by
  classical
  intro s₀
  obtain ⟨hb, hhb⟩ := e.surjective (algebraMap S (Sh f S) s₀)
  obtain ⟨h₀, rfl⟩ := Ideal.Quotient.mk_surjective hb
  choose v₀ hv₀ using fun u : {s : Finset (Fin k) // s.card = 1} ↦
    (L u.1).surj (algebraMap S (Sl f S u.1) s₀)
  choose Y hY using fun u : {s : Finset (Fin k) // s.card = 1} ↦ exists_muH_eq N hN f S H e u.1 _
    (defect_mem N hN f S H e L hL s₀ h₀ v₀ hhb hv₀ u)
  choose X hX using fun T : {s : Finset (Fin k) // s.card = 2} ↦
    exists_muV_eq N hN f S L T.1 _ (dd_mem N hN f S L hL s₀ v₀ hv₀ T)
  obtain ⟨⟨y₀, x⟩, hyx⟩ := glueingComplex_exact_two S (Sh f S) (gS f S) (PS N S)
    (flat_Sh f S) (quotientMap_Sh_bijective f S) Y X
    (compat_YX N hN f S H e L hL h₀ v₀ hflat X Y hX hY)
    (cocycle_X N hN f S L hL v₀ X hX)
  exact ⟨⟨_, new_mem N hN f S H e L hL s₀ h₀ v₀ hhb hv₀ X Y hX hY y₀ x hyx⟩, rfl⟩

end Rig.SquareZeroLift

end
