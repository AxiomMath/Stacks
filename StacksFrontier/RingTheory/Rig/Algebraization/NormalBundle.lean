module

public import StacksFrontier.RingTheory.AdicCompletion.MapOfPowLe
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChange
public import StacksFrontier.RingTheory.Rig.RigEtaleCriterion
public import StacksFrontier.RingTheory.RigSmooth.ComparisonAlgHom

/-!
# The completed normal bundle of a rig-smooth algebra over a principal ideal

Let `A` be a Noetherian ring, `a ∈ A`, and `B = A⟨x₁, …, x_N⟩ / J` an object of the category of
Stacks 0AL4 over `(A, (a))`, with generators `f₁, …, f_m` of `J` and Jacobian matrix
`Jac = (∂fₗ/∂xᵢ)`. Suppose given matrices `S` and `Ẽ` over `A⟨x⟩` with

* `∑ₗ (S · Jac − aᶜ)ₗⱼ fₗ ∈ J²` for every `j`,
* `Ẽ ≡ (Jac · S)ᵀ` modulo `J`,
* `Ẽ² − aᶜ Ẽ ≡ 0` modulo `J²`.

These are the data a rig-smooth algebra supplies (see `Rig.NormalBundle.Data`). The matrix
`E = Ẽ mod J` is then a quasi-idempotent, `E² = aᶜ E`, which off `V(a)` is `aᶜ` times the
projection of `Bᴺ` onto the normal directions of `Spec B ⊆ 𝔸ᴺ`.

The *completed normal bundle* is
`Ĉ = A[X]⟨x', T⟩ / (f(x'), (aᶜ − Ẽ(x')) T, X − x' − aᵏ T)` with `k = c + 1`: the total space of
the normal bundle `{(b, τ) : (aᶜ − E(b)) τ = 0}`, mapped to `𝔸ᴺ` by the tubular map
`(b, τ) ↦ b + aᵏ τ`. This file constructs it as an object of the category of Stacks 0AL4 over
`(A[X], (a))` and proves that it is **rig-étale** over `(A[X], (a))`.

## Main definitions

* `Rig.NormalBundle.Data`: the matrices `S`, `Ẽ` with their three congruences.
* `Rig.NormalBundle.Data.obj`: the completed normal bundle as an object over `(A[X], (a))`.

## Main results

* `Rig.NormalBundle.Data.isRigEtale`: the completed normal bundle is rig-étale over
  `(A[X], (a))`.
-/

@[expose] public noncomputable section

open MvPolynomial
open scoped Matrix

universe u v

namespace Rig

namespace NormalBundle

variable {A : Type u} [CommRing A] [IsNoetherianRing A] (a : A)

/-- The base ring `A[X₁, …, X_N]` of the tubular map. -/
abbrev Base (N : ℕ) := MvPolynomial (Fin N) A

/-- The ideal generated by `a` in `A[X₁, …, X_N]`. -/
abbrev baseIdeal (N : ℕ) : Ideal (Base (A := A) N) :=
  (Ideal.span {a}).map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A)

/-- The ambient ring `A[X]⟨x'₁, …, x'_N, T₁, …, T_N⟩` of the normal bundle; the first `N`
variables are the `x'ᵢ`, the last `N` the `Tᵢ`. -/
abbrev Amb (N : ℕ) := completedPolynomialAlgebra (baseIdeal a N) (N + N)

/-- The polynomial map `A[x] → A[X][x', T]`, `xᵢ ↦ x'ᵢ`. -/
def inclPoly (N : ℕ) :
    MvPolynomial (Fin N) A →ₐ[A] MvPolynomial (Fin (N + N)) (Base (A := A) N) :=
  MvPolynomial.aeval fun i ↦ MvPolynomial.X (Fin.castAdd N i)

omit [IsNoetherianRing A] in
/-- The polynomial inclusion `A[x] → A[X][x', T]` carries the ideal `(a)` into the ideal
generated by `a`. -/
theorem map_inclPoly_le (N : ℕ) :
    (((Ideal.span {a}).map (MvPolynomial.C : A →+* MvPolynomial (Fin N) A)) ^ 1).map
        (inclPoly (A := A) N) ≤
      (baseIdeal a N).map
        (MvPolynomial.C : Base (A := A) N →+* MvPolynomial (Fin (N + N)) (Base (A := A) N)) := by
  rw [pow_one, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap, Ideal.span_le]
  rintro x rfl
  have h : inclPoly (A := A) N (MvPolynomial.C x) = MvPolynomial.C (MvPolynomial.C x) := by
    simp [inclPoly, MvPolynomial.algebraMap_apply]
  simp only [SetLike.mem_coe, Ideal.mem_comap, h]
  exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self x))

/-- The inclusion `A⟨x⟩ → A[X]⟨x', T⟩`, `xᵢ ↦ x'ᵢ`. -/
def incl (N : ℕ) : completedPolynomialAlgebra (Ideal.span {a}) N →ₐ[A] Amb a N :=
  AdicCompletion.algHomOfMapPowLe A (inclPoly (A := A) N) (map_inclPoly_le a N)

omit [IsNoetherianRing A] in
/-- The polynomial inclusion `A[x] → A[X][x', T]` fixes constants. -/
theorem inclPoly_C (N : ℕ) (r : A) :
    inclPoly (A := A) N (MvPolynomial.C r) = MvPolynomial.C (MvPolynomial.C r) := by
  simp [inclPoly, MvPolynomial.algebraMap_apply]

omit [IsNoetherianRing A] in
/-- The polynomial inclusion `A[x] → A[X][x', T]` sends `xᵢ` to `x'ᵢ`. -/
theorem inclPoly_X (N : ℕ) (i : Fin N) :
    inclPoly (A := A) N (MvPolynomial.X i) = MvPolynomial.X (Fin.castAdd N i) := by
  simp [inclPoly]

omit [IsNoetherianRing A] in
/-- The inclusion `A[x] → A[X][x', T]` intertwines `∂/∂xⱼ` with `∂/∂x'ⱼ`. -/
theorem pderiv_castAdd_inclPoly (N : ℕ) (j : Fin N) (p : MvPolynomial (Fin N) A) :
    MvPolynomial.pderiv (Fin.castAdd N j) (inclPoly (A := A) N p) =
      inclPoly (A := A) N (MvPolynomial.pderiv j p) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i h =>
    simp only [map_mul, Derivation.leibniz, smul_eq_mul, map_add, inclPoly_X, h]
    by_cases hij : i = j
    · subst hij
      simp
    · have hne : (Fin.castAdd N i : Fin (N + N)) ≠ Fin.castAdd N j :=
        fun hc ↦ hij (Fin.castAdd_injective _ _ hc)
      simp [hij, hne]

omit [IsNoetherianRing A] in
/-- The variable `Tⱼ` does not occur in the image of `A[x] → A[X][x', T]`. -/
theorem pderiv_natAdd_inclPoly (N : ℕ) (j : Fin N) (p : MvPolynomial (Fin N) A) :
    MvPolynomial.pderiv (Fin.natAdd N j) (inclPoly (A := A) N p) = 0 := by
  classical
  induction p using MvPolynomial.induction_on with
  | C r => rw [inclPoly_C, MvPolynomial.pderiv_C]
  | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
  | mul_X p i h =>
    have hne : (Fin.castAdd N i : Fin (N + N)) ≠ Fin.natAdd N j := by
      intro hc
      have := congrArg Fin.val hc
      simp only [Fin.coe_castAdd, Fin.coe_natAdd] at this
      omega
    rw [map_mul, inclPoly_X, Derivation.leibniz, h, MvPolynomial.pderiv_X_of_ne hne, smul_zero,
      smul_zero, add_zero]

omit [IsNoetherianRing A] in
/-- On polynomials, the inclusion `A⟨x⟩ → A[X]⟨x', T⟩` is the polynomial inclusion `inclPoly`. -/
theorem incl_algebraMap (N : ℕ) (p : MvPolynomial (Fin N) A) :
    incl a N (algebraMap _ (completedPolynomialAlgebra (Ideal.span {a}) N) p) =
      algebraMap _ (Amb a N) (inclPoly (A := A) N p) :=
  AdicCompletion.algHomOfMapPowLe_algebraMap A _ _ p

omit [IsNoetherianRing A] in
/-- The inclusion `A⟨x⟩ → A[X]⟨x', T⟩` is continuous for the limit topologies. -/
theorem continuous_incl (N : ℕ) :
    @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (Ideal.span {a}) (Fin N))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N)))
      (incl a N) :=
  continuous_algHomOfMapPowLe _ (map_inclPoly_le a N)

omit [IsNoetherianRing A] in
/-- **Chain rule for the inclusion `A⟨x⟩ → A[X]⟨x', T⟩`, inner variables.** Any continuous
derivations computing `∂/∂xⱼ` on polynomials of the source and `∂/∂x'ⱼ` on polynomials of the
target are intertwined by the inclusion. -/
theorem incl_partialDeriv_castAdd (N : ℕ) (j : Fin N)
    (Dsrc : Derivation A (completedPolynomialAlgebra (Ideal.span {a}) N)
      (completedPolynomialAlgebra (Ideal.span {a}) N))
    (Dtgt : Amb a N → Amb a N)
    (hDsrc : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (Ideal.span {a}) (Fin N))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (Ideal.span {a}) (Fin N)) Dsrc)
    (hDtgt : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N)))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N)))
      Dtgt)
    (hDsrcp : ∀ p : MvPolynomial (Fin N) A,
      Dsrc (algebraMap _ (completedPolynomialAlgebra (Ideal.span {a}) N) p) =
        algebraMap _ (completedPolynomialAlgebra (Ideal.span {a}) N) (MvPolynomial.pderiv j p))
    (hDtgtp : ∀ p : MvPolynomial (Fin (N + N)) (Base (A := A) N),
      Dtgt (algebraMap _ (Amb a N) p) =
        algebraMap _ (Amb a N) (MvPolynomial.pderiv (Fin.castAdd N j) p))
    (x : completedPolynomialAlgebra (Ideal.span {a}) N) :
    incl a N (Dsrc x) = Dtgt (incl a N x) := by
  let _ : TopologicalSpace (completedPolynomialAlgebra (Ideal.span {a}) N) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology (Ideal.span {a}) (Fin N)
  let _ : TopologicalSpace (Amb a N) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N))
  have _ : T2Space (Amb a N) := t2Space_completedPolynomialAlgebra (baseIdeal a N) (N + N)
  have hfun : (fun y ↦ incl a N (Dsrc y)) = (fun y ↦ Dtgt (incl a N y)) := by
    refine eq_of_continuous_of_algebraMap (Ideal.span {a}) N _ _
      ((continuous_incl a N).comp hDsrc) (hDtgt.comp (continuous_incl a N)) fun p ↦ ?_
    rw [hDsrcp, incl_algebraMap, incl_algebraMap, hDtgtp, pderiv_castAdd_inclPoly]
  exact congrFun hfun x

omit [IsNoetherianRing A] in
/-- **Chain rule for the inclusion `A⟨x⟩ → A[X]⟨x', T⟩`, fibre variables.** A continuous
derivation computing `∂/∂Tⱼ` on polynomials kills the image of the inclusion. -/
theorem partialDeriv_natAdd_incl (N : ℕ) (j : Fin N) (Dtgt : Amb a N → Amb a N)
    (hDtgt : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N)))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N)))
      Dtgt)
    (hDtgtp : ∀ p : MvPolynomial (Fin (N + N)) (Base (A := A) N),
      Dtgt (algebraMap _ (Amb a N) p) =
        algebraMap _ (Amb a N) (MvPolynomial.pderiv (Fin.natAdd N j) p))
    (x : completedPolynomialAlgebra (Ideal.span {a}) N) :
    Dtgt (incl a N x) = 0 := by
  let _ : TopologicalSpace (completedPolynomialAlgebra (Ideal.span {a}) N) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology (Ideal.span {a}) (Fin N)
  let _ : TopologicalSpace (Amb a N) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology (baseIdeal a N) (Fin (N + N))
  have _ : T2Space (Amb a N) := t2Space_completedPolynomialAlgebra (baseIdeal a N) (N + N)
  have hfun : (fun y ↦ Dtgt (incl a N y)) = (fun _ ↦ (0 : Amb a N)) := by
    refine eq_of_continuous_of_algebraMap (Ideal.span {a}) N _ _
      (hDtgt.comp (continuous_incl a N)) continuous_const fun p ↦ ?_
    rw [incl_algebraMap, hDtgtp, pderiv_natAdd_inclPoly, map_zero]
  exact congrFun hfun x

omit [IsNoetherianRing A] in
/-- A derivation carries the square of an ideal into the ideal. -/
theorem derivation_mem_of_mem_sq {S : Type*} [CommRing S] [Algebra A S] (δ : Derivation A S S)
    {J : Ideal S} {x : S} (hx : x ∈ J ^ 2) : δ x ∈ J := by
  rw [pow_two] at hx
  refine Submodule.mul_induction_on hx (fun y hy z hz ↦ ?_) (fun y z hy hz ↦ ?_)
  · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact J.add_mem (J.mul_mem_right _ hy) (J.mul_mem_right _ hz)
  · rw [map_add]
    exact J.add_mem hy hz

omit [IsNoetherianRing A] in
/-- The algebra behind `E · E₁ = 0`: if `∑ₘ (Eᵢₘ dEₘₗ + Eₘₗ dEᵢₘ) = s dEᵢₗ` and `E T = s T`, then
`∑ₘ Eᵢₘ ∑ₗ dEₘₗ Tₗ = 0`. -/
theorem sum_mul_sum_eq_zero_of_derivative {R : Type*} [CommRing R] {n : ℕ}
    (E dE : Fin n → Fin n → R) (T : Fin n → R) (sc : R)
    (hrel : ∀ i l, ∑ m, (E i m * dE m l + E m l * dE i m) = sc * dE i l)
    (hT : ∀ m, ∑ l, E m l * T l = sc * T m) (i : Fin n) :
    ∑ m, E i m * ∑ l, dE m l * T l = 0 := by
  have h1 : ∑ m, E i m * ∑ l, dE m l * T l = ∑ l, ∑ m, E i m * dE m l * T l := by
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun _ _ ↦ Finset.sum_congr rfl fun _ _ ↦ by ring
  have h2 : ∑ l, ∑ m, E m l * dE i m * T l = ∑ m, dE i m * ∑ l, E m l * T l := by
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun _ _ ↦ Finset.sum_congr rfl fun _ _ ↦ by ring
  have key : ∑ m, E i m * ∑ l, dE m l * T l =
      ∑ l, (∑ m, (E i m * dE m l + E m l * dE i m)) * T l - ∑ m, dE i m * ∑ l, E m l * T l := by
    simp only [Finset.sum_mul, add_mul, Finset.sum_add_distrib]
    rw [h1, h2]
    ring
  rw [key]
  simp only [hrel, hT]
  rw [sub_eq_zero]
  exact Finset.sum_congr rfl fun _ _ ↦ by ring

omit [IsNoetherianRing A] in
/-- The algebra behind `E · [ℓ] = 0`: `∑ᵢ' Eᵢᵢ' ((aᶜ − E) T)ᵢ' = −∑ⱼ (E² − aᶜE)ᵢⱼ Tⱼ`. -/
theorem sum_mul_linear_eq {R : Type*} [CommRing R] {n : ℕ} (E : Matrix (Fin n) (Fin n) R)
    (T : Fin n → R) (u : R) (i : Fin n) :
    ∑ i', E i i' * ∑ j, ((1 : Matrix (Fin n) (Fin n) R) i' j * u - E i' j) * T j =
      -∑ j, (∑ m, E i m * E m j - u * E i j) * T j := by
  classical
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  simp only [Matrix.one_apply, sub_mul, mul_sub, Finset.sum_sub_distrib, ite_mul, one_mul,
    zero_mul, mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true, Finset.sum_mul]
  rw [neg_sub]
  congr 1
  · ring
  · exact Finset.sum_congr rfl fun _ _ ↦ by ring

section ConormalAlgebra

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {n m : ℕ}
  (E : Fin n → Fin n → R) (J : Fin m → Fin n → R) (S : Fin m → Fin n → R) (c : R)
  (f : Fin m → M) (ℓ g : Fin n → M)

/-- The classes `Φᵢ = ∑ₗ Sₗᵢ [fₗ]`. -/
def phiVec (i : Fin n) : M := ∑ l, S l i • f l

/-- The `2n` classes `[gᵢ]`, `[ℓᵢ] + Φᵢ` spanning the conormal module up to `c²`. -/
def kappa : Fin n ⊕ Fin n → M := Sum.elim g (fun i ↦ ℓ i + phiVec S f i)

omit [IsNoetherianRing A] in
include E in
/-- **Relation (R3)** `E Φ = c Φ`, from `E = (J · S)ᵀ` and `(R1)`. Here `J l i` stands for the
Jacobian entry `∂fₗ/∂xᵢ`. -/
theorem sum_smul_phiVec (hE : ∀ i j, E i j = ∑ l, J l j * S l i)
    (hR1 : ∀ j, ∑ l, (∑ i, S l i * J j i) • f l = c • f j) (i : Fin n) :
    ∑ i', E i i' • phiVec S f i' = c • phiVec S f i := by
  have hL : ∑ i', E i i' • phiVec S f i' =
      ∑ l', ∑ l, ∑ i', (S l' i * (S l i' * J l' i')) • f l := by
    have h1 : ∑ i', E i i' • phiVec S f i' =
        ∑ i', ∑ l, ∑ l', (S l' i * (S l i' * J l' i')) • f l := by
      simp only [phiVec, hE, Finset.smul_sum, Finset.sum_smul, Finset.sum_mul, smul_smul]
      exact Finset.sum_congr rfl fun _ _ ↦ Finset.sum_congr rfl fun _ _ ↦
        Finset.sum_congr rfl fun _ _ ↦ by congr 1; ring
    rw [h1, Finset.sum_comm]
    rw [Finset.sum_congr rfl fun l _ ↦ Finset.sum_comm (f := fun i' l' ↦
      (S l' i * (S l i' * J l' i')) • f l)]
    exact Finset.sum_comm
  have hR : c • phiVec S f i = ∑ l', ∑ l, ∑ i', (S l' i * (S l i' * J l' i')) • f l := by
    simp only [phiVec, Finset.smul_sum]
    refine Finset.sum_congr rfl fun l' _ ↦ ?_
    rw [smul_comm, ← hR1 l']
    simp only [Finset.smul_sum, Finset.sum_smul, smul_smul]
  rw [hL, hR]

omit [IsNoetherianRing A] in
/-- **The span estimate (I)**: `c²` carries every `[fⱼ]`, `[ℓᵢ]` and `[gᵢ]` into the span of the
classes `kappa`. -/
theorem smul_mem_span_kappa (hE : ∀ i j, E i j = ∑ l, J l j * S l i)
    (hR1 : ∀ j, ∑ l, (∑ i, S l i * J j i) • f l = c • f j)
    (hR2 : ∀ i, ∑ i', E i i' • ℓ i' = 0) :
    (∀ j, (c * c) • f j ∈ Submodule.span R (Set.range (kappa S f ℓ g))) ∧
    (∀ i, (c * c) • ℓ i ∈ Submodule.span R (Set.range (kappa S f ℓ g))) ∧
    (∀ i, (c * c) • g i ∈ Submodule.span R (Set.range (kappa S f ℓ g))) := by
  set K := Submodule.span R (Set.range (kappa S f ℓ g))
  have hψ : ∀ i, ℓ i + phiVec S f i ∈ K := fun i ↦ Submodule.subset_span ⟨Sum.inr i, rfl⟩
  have hΦ : ∀ i, c • phiVec S f i ∈ K := by
    intro i
    have h : c • phiVec S f i = ∑ i', E i i' • (ℓ i' + phiVec S f i') := by
      simp only [smul_add, Finset.sum_add_distrib, hR2, zero_add]
      exact (sum_smul_phiVec E J S c f hE hR1 i).symm
    rw [h]
    exact K.sum_mem fun i' _ ↦ K.smul_mem _ (hψ i')
  refine ⟨fun j ↦ ?_, fun i ↦ ?_, fun i ↦ ?_⟩
  · have h : c • f j = ∑ i, J j i • phiVec S f i := by
      rw [← hR1 j]
      simp only [phiVec, Finset.smul_sum, smul_smul, Finset.sum_smul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ ↦ Finset.sum_congr rfl fun _ _ ↦ by
        rw [mul_comm]
    rw [mul_smul, h, Finset.smul_sum]
    refine K.sum_mem fun i _ ↦ ?_
    rw [smul_comm]
    exact K.smul_mem _ (hΦ i)
  · have h : (c * c) • ℓ i = c • (c • (ℓ i + phiVec S f i)) - c • (c • phiVec S f i) := by
      rw [smul_add, smul_add, add_sub_cancel_right, mul_smul]
    rw [h]
    exact K.sub_mem (K.smul_mem _ (K.smul_mem _ (hψ i))) (K.smul_mem _ (hΦ i))
  · exact K.smul_mem _ (Submodule.subset_span ⟨Sum.inl i, rfl⟩)

end ConormalAlgebra

section MatrixAlgebra

variable {R : Type*} [CommRing R] {n : ℕ} (α : R) (c : ℕ) (E E1 : Matrix (Fin n) (Fin n) R)

/-- The matrix of the differential on the classes `kappa`, in block form: rows are the
coordinates `(x', T)`, columns the classes `([gᵢ], [ℓᵢ] + Φᵢ)`. -/
def kappaMatrix : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R :=
  Matrix.fromBlocks (-1) (E - E1)ᵀ (-(α ^ (c + 1) • 1)) (α ^ c • 1 - E)ᵀ

/-- The Schur-complement inverse. -/
def schurInv : Matrix (Fin n) (Fin n) R :=
  (α ^ (2 * c + 1) • 1 - (1 + α ^ (c + 1)) • Eᵀ) * (1 + α • E1ᵀ).adjugate

/-- The right inverse, up to the scalar `α^{3c+1} det(1 + α E₁ᵀ)`, of `kappaMatrix`. -/
def kappaInv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R :=
  Matrix.fromBlocks
    (-(α ^ (c + 1) • ((E - E1)ᵀ * schurInv α c E E1)) -
      (α ^ (3 * c + 1) * (1 + α • E1ᵀ).det) • 1)
    ((E - E1)ᵀ * schurInv α c E E1) (-(α ^ (c + 1) • schurInv α c E E1)) (schurInv α c E E1)

omit [IsNoetherianRing A] in
/-- If `E² = αᶜ E` and `E E₁ = 0`, then `schurInv` is a right inverse of the Schur complement
`(αᶜ − E)ᵀ − α^{c+1} (E − E₁)ᵀ` up to the scalar `α^{3c+1} det(1 + α E₁ᵀ)`. -/
theorem schur_mul_schurInv (hE : E * E = α ^ c • E) (hEE1 : E * E1 = 0) :
    ((α ^ c • 1 - E)ᵀ - α ^ (c + 1) • (E - E1)ᵀ) * schurInv α c E E1 =
      (α ^ (3 * c + 1) * (1 + α • E1ᵀ).det) • 1 := by
  have hE' : Eᵀ * Eᵀ = α ^ c • Eᵀ := by
    rw [← Matrix.transpose_mul, hE, Matrix.transpose_smul]
  have hE1E : E1ᵀ * Eᵀ = 0 := by
    rw [← Matrix.transpose_mul, hEE1, Matrix.transpose_zero]
  have key : ((α ^ c • 1 - E)ᵀ - α ^ (c + 1) • (E - E1)ᵀ) *
      (α ^ (2 * c + 1) • 1 - (1 + α ^ (c + 1)) • Eᵀ) =
      α ^ (3 * c + 1) • (1 + α • E1ᵀ) := by
    simp only [Matrix.transpose_sub, Matrix.transpose_smul, Matrix.transpose_one, sub_mul,
      mul_sub, Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul, Matrix.mul_one, add_smul,
      one_smul, Matrix.mul_add, hE', hE1E, smul_add, smul_smul]
    rw [show 3 * c + 1 = c + (2 * c + 1) by ring, show 2 * c + 1 = c + (c + 1) by ring]
    simp only [pow_add]
    module
  rw [schurInv, ← mul_assoc, key, Matrix.smul_mul, Matrix.mul_adjugate, smul_smul]

omit [IsNoetherianRing A] in
/-- If `E² = αᶜ E` and `E E₁ = 0`, then `kappaInv` is a right inverse of `kappaMatrix` up to the
scalar `α^{3c+1} det(1 + α E₁ᵀ)`. -/
theorem kappaMatrix_mul_kappaInv (hE : E * E = α ^ c • E) (hEE1 : E * E1 = 0) :
    kappaMatrix α c E E1 * kappaInv α c E E1 =
      (α ^ (3 * c + 1) * (1 + α • E1ᵀ).det) • 1 := by
  have hS := schur_mul_schurInv α c E E1 hE hEE1
  set W := schurInv α c E E1
  set s := α ^ (3 * c + 1) * (1 + α • E1ᵀ).det
  set B := (E - E1)ᵀ
  set D := (α ^ c • 1 - E)ᵀ
  have hD : D * W = s • 1 + α ^ (c + 1) • (B * W) := by
    rw [← hS, sub_mul, Matrix.smul_mul, sub_add_cancel]
  have hR : s • (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R) =
      Matrix.fromBlocks (s • 1) 0 0 (s • 1) := by
    rw [← Matrix.fromBlocks_one, Matrix.fromBlocks_smul, smul_zero]
  rw [hR, kappaMatrix, kappaInv, Matrix.fromBlocks_multiply]
  refine Matrix.fromBlocks_inj.mpr ⟨?_, ?_, ?_, ?_⟩
  · simp only [Matrix.neg_mul, Matrix.one_mul, Matrix.mul_neg, Matrix.mul_smul, neg_sub]
    abel
  · simp only [Matrix.neg_mul, Matrix.one_mul]
    abel
  · simp only [Matrix.neg_mul, Matrix.smul_mul, Matrix.one_mul, Matrix.mul_neg, Matrix.mul_smul,
      mul_sub]
    simp only [smul_neg]
    rw [hD]
    module
  · have h4 : (α ^ c • 1 - E)ᵀ * schurInv α c E E1 -
        α ^ (c + 1) • ((E - E1)ᵀ * schurInv α c E E1) = s • 1 := by
      rw [← Matrix.smul_mul, ← sub_mul]
      exact hS
    simp only [Matrix.neg_mul, Matrix.smul_mul, Matrix.one_mul]
    rw [← h4]
    abel

end MatrixAlgebra

omit [IsNoetherianRing A] in
/-- **Cohomology from a right inverse.** Let `d : M → Rⁱ` be linear, `κ : ι → M` a family whose
span contains `r M`, and suppose the matrix `(d κ_w)_v` has a right inverse up to the scalar `s`.
Then `s` carries `Rⁱ` into the image of `d`, and `s^{|ι|} r` kills the kernel of `d`. -/
theorem cohomology_of_matrix {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Fintype ι] [DecidableEq ι] (d : M →ₗ[R] (ι → R)) (κ : ι → M) (W : Matrix ι ι R) (s r : R)
    (hMW : Matrix.of (fun v w ↦ d (κ w) v) * W = s • 1)
    (hspan : ∀ z, r • z ∈ Submodule.span R (Set.range κ)) :
    (∀ y, s • y ∈ LinearMap.range d) ∧
      (∀ z, d z = 0 → (s ^ Fintype.card ι * r) • z = 0) := by
  set Mx := Matrix.of (fun v w ↦ d (κ w) v)
  have hmul : ∀ γ : ι → R, Mx.mulVec γ = d (∑ w, γ w • κ w) := by
    intro γ
    ext v
    simp [Mx, Matrix.mulVec, dotProduct, map_sum, mul_comm]
  refine ⟨fun y ↦ ⟨∑ w, (W.mulVec y) w • κ w, ?_⟩, fun z hz ↦ ?_⟩
  · rw [← hmul, Matrix.mulVec_mulVec, hMW, Matrix.smul_mulVec, Matrix.one_mulVec]
  · obtain ⟨γ, hγ⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp (hspan z)
    have h0 : Mx.mulVec γ = 0 := by rw [hmul, hγ, map_smul, hz, smul_zero]
    have hdet : Mx.det * W.det = s ^ Fintype.card ι := by
      rw [← Matrix.det_mul, hMW, Matrix.det_smul, Matrix.det_one, mul_one]
    have hleft : (W.det • Mx.adjugate) * Mx = (s ^ Fintype.card ι) • 1 := by
      rw [Matrix.smul_mul, Matrix.adjugate_mul, smul_smul, mul_comm, hdet]
    have hγ0 : (s ^ Fintype.card ι) • γ = 0 := by
      have := congrArg ((W.det • Mx.adjugate).mulVec) h0
      rwa [Matrix.mulVec_mulVec, hleft, Matrix.smul_mulVec, Matrix.one_mulVec,
        Matrix.mulVec_zero] at this
    rw [mul_smul, ← hγ, Finset.smul_sum]
    refine Finset.sum_eq_zero fun w _ ↦ ?_
    have hw : s ^ Fintype.card ι * γ w = 0 := by
      simpa using congrFun hγ0 w
    rw [smul_smul, hw, zero_smul]

/-- The fibre coordinate `xᵢ'` of the ambient ring. -/
def xv (N : ℕ) (i : Fin N) : Amb a N :=
  algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N) (X (Fin.castAdd N i))

/-- The fibre coordinate `Tᵢ` of the ambient ring. -/
def tv (N : ℕ) (i : Fin N) : Amb a N :=
  algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N) (X (Fin.natAdd N i))

/-- The base coordinate `Xᵢ` in the ambient ring. -/
def bv (N : ℕ) (i : Fin N) : Amb a N :=
  algebraMap (Base (A := A) N) (Amb a N) (X i)

variable {a}

section DataSection

variable (B : AdicFiniteTypeAlgebra.{u, v} A (Ideal.span {a}))
  (Pres : CompletedPolynomialPresentation (Ideal.span {a}) B)

/-- The Jacobian matrix `(∂fₗ/∂xᵢ)ᵢₗ` of a family `f` of elements of `A⟨x⟩`, for the formal
partial derivatives of the presentation. -/
def jacobian {m : ℕ} (f : Fin m → Pres.completedPolynomialRing) :
    Matrix (Fin Pres.variableCount) (Fin m) Pres.completedPolynomialRing :=
  fun i l ↦ (completedNaiveCotangentComplex B Pres).partialDeriv i (f l)

/-- **The data of a completed normal bundle.** Generators `f` of the ideal `J` of the
presentation, an exponent `c`, and matrices `S`, `Ẽ` over `A⟨x⟩` such that
`∑ₗ (S · Jac − aᶜ)ₗⱼ fₗ ∈ J²`, `Ẽ ≡ (Jac · S)ᵀ mod J` and `Ẽ² − aᶜ Ẽ ≡ 0 mod J²`. -/
structure Data where
  /-- The number of generators of `J`. -/
  m : ℕ
  /-- Generators of `J`. -/
  f : Fin m → Pres.completedPolynomialRing
  span_eq : Ideal.span (Set.range f) = Pres.ideal
  /-- The exponent. -/
  c : ℕ
  /-- The matrix of the factorization `σ ∘ d = aᶜ` on `J / J²`. -/
  S : Matrix (Fin m) (Fin Pres.variableCount) Pres.completedPolynomialRing
  /-- A lift of the quasi-idempotent `E = (Jac · S)ᵀ`. -/
  Et : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount) Pres.completedPolynomialRing
  rel : ∀ j, ∑ l, ((S * jacobian B Pres f) l j -
      (1 : Matrix (Fin m) (Fin m) Pres.completedPolynomialRing) l j *
        algebraMap A Pres.completedPolynomialRing (a ^ c)) * f l ∈ Pres.ideal ^ 2
  lift : ∀ i j, Et i j - (jacobian B Pres f * S) j i ∈ Pres.ideal
  quasi : ∀ i j, (Et * Et - algebraMap A Pres.completedPolynomialRing (a ^ c) • Et) i j ∈
    Pres.ideal ^ 2

namespace Data

variable {B Pres} (D : Data B Pres)

/-- The exponent `k = c + 1` of the tubular map `(b, τ) ↦ b + aᵏ τ`. -/
def k : ℕ := D.c + 1

/-- The quasi-idempotent `Ẽ`, moved to the ambient ring. -/
def ambE : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount) (Amb a Pres.variableCount) :=
  D.Et.map (incl a Pres.variableCount)

/-- The equations `xᵢ' ↦ fₗ(x')` of `B`, moved to the ambient ring. -/
def fGen (l : Fin D.m) : Amb a Pres.variableCount := incl a Pres.variableCount (D.f l)

/-- The linear equations `((aᶜ − Ẽ) T)ᵢ` of the normal bundle. -/
def lGen (i : Fin Pres.variableCount) : Amb a Pres.variableCount :=
  ∑ j, ((1 : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount)
      (Amb a Pres.variableCount)) i j * algebraMap A (Amb a Pres.variableCount) (a ^ D.c) -
    D.ambE i j) * tv a Pres.variableCount j

/-- The equations `Xᵢ − xᵢ' − aᵏ Tᵢ` of the tubular map. -/
def gGen (i : Fin Pres.variableCount) : Amb a Pres.variableCount :=
  bv a Pres.variableCount i - xv a Pres.variableCount i -
    algebraMap A (Amb a Pres.variableCount) (a ^ D.k) * tv a Pres.variableCount i

/-- All the equations of the normal bundle, indexed by `Fin m ⊕ (Fin N ⊕ Fin N)`. -/
def gens : Fin D.m ⊕ (Fin Pres.variableCount ⊕ Fin Pres.variableCount) →
    Amb a Pres.variableCount :=
  Sum.elim D.fGen (Sum.elim D.lGen D.gGen)

/-- The ideal of the normal bundle in `A[X]⟨x', T⟩`. -/
def ideal : Ideal (Amb a Pres.variableCount) := Ideal.span (Set.range D.gens)

/-- **The completed normal bundle**, as an object of the category of Stacks 0AL4 over
`(A[X], (a))`. -/
def obj : AdicFiniteTypeAlgebra.{u, u} (Base (A := A) Pres.variableCount)
    (baseIdeal a Pres.variableCount) :=
  PerturbedPresentation.quotientObj _ _ (Pres.variableCount + Pres.variableCount) D.ideal

/-- The tautological presentation of the normal bundle. -/
abbrev pres : CompletedPolynomialPresentation (baseIdeal a Pres.variableCount) D.obj where
  variableCount := Pres.variableCount + Pres.variableCount
  ideal := D.ideal
  quotientEquiv := AlgEquiv.refl

/-- The completed naive cotangent complex of the normal bundle over `A[X]`. -/
abbrev nl := completedNaiveCotangentComplex D.obj D.pres

/-- The quotient map `A[X]⟨x', T⟩ → Ĉ`. -/
abbrev π : Amb a Pres.variableCount →ₐ[Base (A := A) Pres.variableCount] D.obj.carrier :=
  D.pres.toAlgHom

/-- The quotient map `π` is the quotient map by the ideal of the normal bundle. -/
theorem π_apply (g : Amb a Pres.variableCount) : D.π g = Ideal.Quotient.mk D.ideal g := rfl

/-- The kernel of the presentation of the normal bundle is the ideal of the normal bundle. -/
theorem mem_ker_iff (g : Amb a Pres.variableCount) : g ∈ D.pres.extension.ker ↔ g ∈ D.ideal :=
  Ideal.Quotient.eq_zero_iff_mem (I := D.ideal)

/-- The class in `𝔎 / 𝔎²` of an element of the ideal `𝔎` of the normal bundle. -/
def cl (g : Amb a Pres.variableCount) (hg : g ∈ D.ideal) : D.pres.extension.Cotangent :=
  Algebra.Extension.Cotangent.mk ⟨g, (D.mem_ker_iff g).2 hg⟩

/-- The class map `cl` is additive. -/
theorem cl_add (g h : Amb a Pres.variableCount) (hg : g ∈ D.ideal) (hh : h ∈ D.ideal) :
    D.cl (g + h) (D.ideal.add_mem hg hh) = D.cl g hg + D.cl h hh := by
  simp only [cl, ← map_add]
  rfl

/-- The class of `x g` in `𝔎 / 𝔎²` is `π(x)` times the class of `g`. -/
theorem cl_mul (x g : Amb a Pres.variableCount) (hg : g ∈ D.ideal)
    (hxg : x * g ∈ D.ideal := D.ideal.mul_mem_left x hg) :
    D.cl (x * g) hxg = D.π x • D.cl g hg := by
  show _ = (show D.pres.extension.Ring from x) • D.cl g hg
  ext1
  rw [Algebra.Extension.Cotangent.val_smul', cl, cl, Algebra.Extension.Cotangent.val_mk,
    Algebra.Extension.Cotangent.val_mk, ← map_smul]
  rfl

/-- An element of `𝔎²` has class zero in `𝔎 / 𝔎²`. -/
theorem cl_eq_zero (g : Amb a Pres.variableCount) (hg : g ∈ D.ideal) (hg2 : g ∈ D.ideal ^ 2) :
    D.cl g hg = 0 := by
  have hk : D.pres.extension.ker = D.ideal := Ideal.ext D.mem_ker_iff
  have h2 : g ∈ D.pres.extension.ker ^ 2 := by rw [hk]; exact hg2
  exact (Algebra.Extension.Cotangent.mk_eq_zero_iff _).2 h2

/-- Equal elements of `𝔎` have equal classes, whatever the membership proofs. -/
theorem cl_congr (g h : Amb a Pres.variableCount) (hg : g ∈ D.ideal) (hh : h ∈ D.ideal)
    (hgh : g = h) : D.cl g hg = D.cl h hh := by
  subst hgh
  rfl

/-- The differential of the class of `g` is the image in `Ĉ` of its vector of formal partial
derivatives. -/
theorem differential_cl (g : Amb a Pres.variableCount) (hg : g ∈ D.ideal) :
    D.nl.differential (D.cl g hg) = fun v ↦ D.π (D.nl.partialDeriv v g) :=
  D.nl.differential_mk _

/-- The `v`-th coordinate of the differential of the class of `g` is the image in `Ĉ` of the
formal partial derivative `∂g/∂v`. -/
theorem differential_cl_apply (g : Amb a Pres.variableCount) (hg : g ∈ D.ideal)
    (v : Fin (Pres.variableCount + Pres.variableCount)) :
    D.nl.differential (D.cl g hg) v = D.π (D.nl.partialDeriv v g) := by
  rw [differential_cl]

/-- The class map `cl` commutes with finite sums. -/
theorem cl_sum {ι : Type*} (t : Finset ι) (g : ι → Amb a Pres.variableCount)
    (hg : ∀ i, g i ∈ D.ideal) :
    D.cl (∑ i ∈ t, g i) (D.ideal.sum_mem fun i _ ↦ hg i) = ∑ i ∈ t, D.cl (g i) (hg i) := by
  have h : (⟨∑ i ∈ t, g i, (D.mem_ker_iff _).2 (D.ideal.sum_mem fun i _ ↦ hg i)⟩ :
      D.pres.extension.ker) = ∑ i ∈ t, ⟨g i, (D.mem_ker_iff _).2 (hg i)⟩ :=
    Subtype.ext (by rw [Submodule.coe_sum])
  simp only [cl]
  rw [← map_sum]
  exact congrArg _ h

/-- The class of `∑ rᵢ gᵢ` in `𝔎 / 𝔎²` is the sum of the classes of the `gᵢ`, weighted by
`π(rᵢ)`. -/
private theorem cl_sum_mul {ι : Type*} (t : Finset ι) (r g : ι → Amb a Pres.variableCount)
    (hg : ∀ i, g i ∈ D.ideal) :
    D.cl (∑ i ∈ t, r i * g i) (D.ideal.sum_mem fun i _ ↦ D.ideal.mul_mem_left _ (hg i)) =
      ∑ i ∈ t, D.π (r i) • D.cl (g i) (hg i) := by
  rw [D.cl_sum _ _ fun i ↦ D.ideal.mul_mem_left _ (hg i)]
  exact Finset.sum_congr rfl fun i _ ↦ D.cl_mul _ _ (hg i)

/-- A combination `∑ rᵢ gᵢ` lying in `𝔎²` gives the relation `∑ π(rᵢ) [gᵢ] = 0` in `𝔎 / 𝔎²`. -/
private theorem sum_smul_cl_eq_zero {ι : Type*} (t : Finset ι) (r g : ι → Amb a Pres.variableCount)
    (hg : ∀ i, g i ∈ D.ideal) (h : ∑ i ∈ t, r i * g i ∈ D.ideal ^ 2) :
    ∑ i ∈ t, D.π (r i) • D.cl (g i) (hg i) = 0 := by
  rw [← D.cl_sum_mul t r g hg]
  exact D.cl_eq_zero _ _ h

/-- Each equation of the normal bundle lies in its ideal. -/
theorem gens_mem (x : Fin D.m ⊕ (Fin Pres.variableCount ⊕ Fin Pres.variableCount)) :
    D.gens x ∈ D.ideal :=
  Ideal.subset_span ⟨x, rfl⟩

/-- Each equation `fₗ(x')` lies in the ideal of the normal bundle. -/
theorem fGen_mem (l : Fin D.m) : D.fGen l ∈ D.ideal := D.gens_mem (Sum.inl l)

/-- Each linear equation `((aᶜ − Ẽ) T)ᵢ` lies in the ideal of the normal bundle. -/
theorem lGen_mem (i : Fin Pres.variableCount) : D.lGen i ∈ D.ideal :=
  D.gens_mem (Sum.inr (Sum.inl i))

/-- Each equation `Xᵢ − xᵢ' − aᵏ Tᵢ` lies in the ideal of the normal bundle. -/
theorem gGen_mem (i : Fin Pres.variableCount) : D.gGen i ∈ D.ideal :=
  D.gens_mem (Sum.inr (Sum.inr i))

/-- The inclusion carries the ideal `J` of the presentation into the ideal of the bundle. -/
theorem map_incl_le : Pres.ideal.map (incl a Pres.variableCount) ≤ D.ideal := by
  rw [← D.span_eq, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
  exact D.fGen_mem l

/-- The inclusion carries an element of `J` into the ideal of the normal bundle. -/
theorem incl_mem {x : Pres.completedPolynomialRing} (hx : x ∈ Pres.ideal) :
    incl a Pres.variableCount x ∈ D.ideal :=
  D.map_incl_le (Ideal.mem_map_of_mem _ hx)

/-- The inclusion carries an element of `J²` into the square of the ideal of the normal bundle. -/
theorem incl_mem_sq {x : Pres.completedPolynomialRing} (hx : x ∈ Pres.ideal ^ 2) :
    incl a Pres.variableCount x ∈ D.ideal ^ 2 := by
  have h : incl a Pres.variableCount x ∈ (Pres.ideal.map (incl a Pres.variableCount)) ^ 2 := by
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hx
  exact Ideal.pow_right_mono D.map_incl_le 2 h

/-- An element of `J` vanishes in the normal bundle. -/
theorem π_incl_eq_zero {x : Pres.completedPolynomialRing} (hx : x ∈ Pres.ideal) :
    D.π (incl a Pres.variableCount x) = 0 :=
  (D.mem_ker_iff _).2 (D.incl_mem hx)

/-! ### Formal partial derivatives on the ambient ring -/

/-- The formal partial derivatives on `A[X]⟨x', T⟩` kill `A[X]`. -/
theorem partialDeriv_algebraMap_base (v : Fin (Pres.variableCount + Pres.variableCount))
    (x : Base (A := A) Pres.variableCount) :
    D.nl.partialDeriv v (algebraMap _ (Amb a Pres.variableCount) x) = 0 :=
  Derivation.map_algebraMap _ _

/-- The formal partial derivatives on `A[X]⟨x', T⟩` kill `A`. -/
theorem partialDeriv_algebraMap_A (v : Fin (Pres.variableCount + Pres.variableCount)) (r : A) :
    D.nl.partialDeriv v (algebraMap A (Amb a Pres.variableCount) r) = 0 := by
  rw [IsScalarTower.algebraMap_apply A (Base (A := A) Pres.variableCount)
    (Amb a Pres.variableCount)]
  exact D.partialDeriv_algebraMap_base v _

/-- The formal partial derivative `∂/∂v` of the variable `w` is `1` if `w = v` and `0`
otherwise. -/
theorem partialDeriv_X (v w : Fin (Pres.variableCount + Pres.variableCount)) :
    D.nl.partialDeriv v (algebraMap (MvPolynomial (Fin (Pres.variableCount + Pres.variableCount))
        (Base (A := A) Pres.variableCount)) (Amb a Pres.variableCount) (X w)) =
      if w = v then 1 else 0 := by
  classical
  rw [D.nl.partialDeriv_polynomial, MvPolynomial.pderiv_X]
  by_cases h : w = v
  · subst h; simp
  · simp [h]

/-- The formal partial derivatives of the fibre coordinate `Tⱼ`. -/
theorem partialDeriv_tv (v : Fin (Pres.variableCount + Pres.variableCount))
    (j : Fin Pres.variableCount) :
    D.nl.partialDeriv v (tv a Pres.variableCount j) =
      if Fin.natAdd Pres.variableCount j = v then 1 else 0 :=
  D.partialDeriv_X v _

/-- The formal partial derivatives of the coordinate `xⱼ'`. -/
theorem partialDeriv_xv (v : Fin (Pres.variableCount + Pres.variableCount))
    (j : Fin Pres.variableCount) :
    D.nl.partialDeriv v (xv a Pres.variableCount j) =
      if Fin.castAdd Pres.variableCount j = v then 1 else 0 :=
  D.partialDeriv_X v _

/-- On the image of `A⟨x⟩`, the partial derivative `∂/∂xⱼ'` is the image of `∂/∂xⱼ`. -/
theorem partialDeriv_castAdd_incl (j : Fin Pres.variableCount)
    (x : Pres.completedPolynomialRing) :
    D.nl.partialDeriv (Fin.castAdd Pres.variableCount j) (incl a Pres.variableCount x) =
      incl a Pres.variableCount ((completedNaiveCotangentComplex B Pres).partialDeriv j x) :=
  (incl_partialDeriv_castAdd a Pres.variableCount j _ _
    ((completedNaiveCotangentComplex B Pres).partialDeriv_continuous j)
    (D.nl.partialDeriv_continuous _)
    ((completedNaiveCotangentComplex B Pres).partialDeriv_polynomial j)
    (D.nl.partialDeriv_polynomial _) x).symm

/-- The partial derivative `∂/∂Tⱼ` kills the image of `A⟨x⟩`. -/
theorem partialDeriv_natAdd_incl (j : Fin Pres.variableCount)
    (x : Pres.completedPolynomialRing) :
    D.nl.partialDeriv (Fin.natAdd Pres.variableCount j) (incl a Pres.variableCount x) = 0 :=
  NormalBundle.partialDeriv_natAdd_incl a Pres.variableCount j _
    (D.nl.partialDeriv_continuous _) (D.nl.partialDeriv_polynomial _) x

/-! ### The quasi-idempotent and its derivative on the normal bundle -/

/-- The image of `aʲ` in the normal bundle. -/
abbrev sc (j : ℕ) : D.obj.carrier := D.π (algebraMap A (Amb a Pres.variableCount) (a ^ j))

/-- The fibre coordinate `Tⱼ` of the normal bundle. -/
abbrev Tb (j : Fin Pres.variableCount) : D.obj.carrier := D.π (tv a Pres.variableCount j)

/-- The quasi-idempotent `E` on the normal bundle. -/
abbrev Eb (i j : Fin Pres.variableCount) : D.obj.carrier := D.π (D.ambE i j)

/-- The Jacobian matrix on the normal bundle. -/
abbrev Jb (j : Fin Pres.variableCount) (l : Fin D.m) : D.obj.carrier :=
  D.π (incl a Pres.variableCount (jacobian B Pres D.f j l))

/-- The matrix `S` on the normal bundle. -/
abbrev Sb (l : Fin D.m) (i : Fin Pres.variableCount) : D.obj.carrier :=
  D.π (incl a Pres.variableCount (D.S l i))

/-- The derivatives `∂Ẽᵢₗ/∂xⱼ'` on the normal bundle. -/
abbrev dEb (j i l : Fin Pres.variableCount) : D.obj.carrier :=
  D.π (incl a Pres.variableCount
    ((completedNaiveCotangentComplex B Pres).partialDeriv j (D.Et i l)))

/-- The matrix `E₁ᵢⱼ = ∑ₗ (∂Ẽᵢₗ/∂xⱼ') Tₗ`. -/
abbrev E1b (i j : Fin Pres.variableCount) : D.obj.carrier := ∑ l, D.dEb j i l * D.Tb l

/-- The image in `Ĉ` of `r ∈ A` is the same through `A⟨x⟩` as through `A[X]⟨x', T⟩`. -/
theorem π_incl_algebraMap (r : A) :
    D.π (incl a Pres.variableCount (algebraMap A Pres.completedPolynomialRing r)) =
      D.π (algebraMap A (Amb a Pres.variableCount) r) := by
  rw [AlgHom.commutes]

/-- `E = (Jac · S)ᵀ` on the normal bundle. -/
theorem Eb_eq (i j : Fin Pres.variableCount) : D.Eb i j = ∑ l, D.Jb j l * D.Sb l i := by
  have h := D.π_incl_eq_zero (D.lift i j)
  rw [map_sub, map_sub, sub_eq_zero] at h
  rw [Eb, ambE, Matrix.map_apply, h, Matrix.mul_apply, map_sum, map_sum]
  simp only [map_mul]

/-- `E² = aᶜ E` on the normal bundle. -/
theorem Eb_mul_Eb (i j : Fin Pres.variableCount) :
    ∑ m, D.Eb i m * D.Eb m j = D.sc D.c * D.Eb i j := by
  have h := D.π_incl_eq_zero (Ideal.pow_le_self two_ne_zero (D.quasi i j))
  rw [Matrix.sub_apply, Matrix.smul_apply, Matrix.mul_apply, smul_eq_mul, map_sub, map_sub,
    sub_eq_zero, map_sum, map_sum, map_mul, map_mul, D.π_incl_algebraMap] at h
  simp only [map_mul] at h
  exact h

/-- The linear equations of the bundle: `E T = aᶜ T`. -/
theorem Eb_mul_Tb (i : Fin Pres.variableCount) :
    ∑ l, D.Eb i l * D.Tb l = D.sc D.c * D.Tb i := by
  classical
  have h : D.π (D.lGen i) = 0 := (D.mem_ker_iff _).2 (D.lGen_mem i)
  rw [lGen, map_sum] at h
  simp only [map_mul, map_sub, Matrix.one_apply, sub_mul, Finset.sum_sub_distrib] at h
  rw [sub_eq_zero] at h
  rw [← h]
  simp [Finset.sum_ite_eq, ite_mul, sc, Tb, map_pow]

/-- The ring map `A⟨x⟩ → Ĉ`. -/
abbrev φ : Pres.completedPolynomialRing →+* D.obj.carrier :=
  (D.π : Amb a Pres.variableCount →+* D.obj.carrier).comp
    (incl a Pres.variableCount : Pres.completedPolynomialRing →+* Amb a Pres.variableCount)

/-- The derivative of `E² = aᶜ E`, entrywise. -/
theorem dEb_relation (j i l : Fin Pres.variableCount) :
    ∑ m, (D.Eb i m * D.dEb j m l + D.Eb m l * D.dEb j i m) = D.sc D.c * D.dEb j i l := by
  set δ := (completedNaiveCotangentComplex B Pres).partialDeriv j
  have h0 : D.φ (δ ((D.Et * D.Et -
      algebraMap A Pres.completedPolynomialRing (a ^ D.c) • D.Et) i l)) = 0 :=
    D.π_incl_eq_zero (derivation_mem_of_mem_sq δ (D.quasi i l))
  have hδ : δ ((D.Et * D.Et - algebraMap A Pres.completedPolynomialRing (a ^ D.c) • D.Et) i l) =
      ∑ m, (D.Et i m * δ (D.Et m l) + D.Et m l * δ (D.Et i m)) -
        algebraMap A Pres.completedPolynomialRing (a ^ D.c) * δ (D.Et i l) := by
    rw [Matrix.sub_apply, Matrix.smul_apply, Matrix.mul_apply, smul_eq_mul, map_sub, map_sum,
      Derivation.leibniz, Derivation.map_algebraMap, smul_zero, add_zero, smul_eq_mul]
    simp only [Derivation.leibniz, smul_eq_mul]
  rw [hδ, map_sub, sub_eq_zero, map_sum, map_mul] at h0
  have hu : D.φ (algebraMap A Pres.completedPolynomialRing (a ^ D.c)) = D.sc D.c :=
    D.π_incl_algebraMap _
  rw [hu] at h0
  refine Eq.trans ?_ h0
  refine Finset.sum_congr rfl fun m _ ↦ ?_
  rw [map_add, map_mul, map_mul]
  rfl

/-- `E · E₁ = 0` on the normal bundle: the derivative of `E` along the fibre coordinates lands in
the kernel of `E`. -/
theorem Eb_mul_E1b (i j : Fin Pres.variableCount) : ∑ m, D.Eb i m * D.E1b m j = 0 :=
  sum_mul_sum_eq_zero_of_derivative D.Eb (D.dEb j) D.Tb (D.sc D.c) (D.dEb_relation j)
    D.Eb_mul_Tb i

/-! ### The differential on the generators -/

omit [IsNoetherianRing A] in
/-- The first `N` and the last `N` indices of `Fin (N + N)` are disjoint. -/
theorem castAdd_ne_natAdd {N : ℕ} (i j : Fin N) :
    (Fin.castAdd N i : Fin (N + N)) ≠ Fin.natAdd N j := by
  intro h
  have := congrArg Fin.val h
  simp only [Fin.coe_castAdd, Fin.coe_natAdd] at this
  omega

/-- The formal partial derivatives kill the entries of the identity matrix. -/
theorem partialDeriv_one_apply (v : Fin (Pres.variableCount + Pres.variableCount))
    (i j : Fin Pres.variableCount) :
    D.nl.partialDeriv v ((1 : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount)
      (Amb a Pres.variableCount)) i j) = 0 := by
  classical
  rw [Matrix.one_apply]
  split_ifs
  · exact Derivation.map_one_eq_zero _
  · exact map_zero _

/-- The formal partial derivatives of `gᵢ = Xᵢ − xᵢ' − aᵏ Tᵢ`: `−1` along `xᵢ'`, `−aᵏ` along `Tᵢ`,
and `0` otherwise. -/
theorem partialDeriv_gGen (i : Fin Pres.variableCount)
    (v : Fin (Pres.variableCount + Pres.variableCount)) :
    D.nl.partialDeriv v (D.gGen i) = -(if Fin.castAdd Pres.variableCount i = v then 1 else 0) -
      algebraMap A (Amb a Pres.variableCount) (a ^ D.k) *
        (if Fin.natAdd Pres.variableCount i = v then 1 else 0) := by
  simp only [gGen, map_sub, Derivation.leibniz, D.partialDeriv_algebraMap_A, add_zero,
    bv, D.partialDeriv_algebraMap_base, D.partialDeriv_xv, D.partialDeriv_tv, smul_eq_mul,
    zero_sub, mul_zero]

/-- The `xⱼ'`-coordinate of the differential of `[gᵢ]` is `−δᵢⱼ`. -/
theorem d_gGen_castAdd (i j : Fin Pres.variableCount) :
    D.nl.differential (D.cl _ (D.gGen_mem i)) (Fin.castAdd Pres.variableCount j) =
      -(if i = j then 1 else 0) := by
  rw [differential_cl_apply, partialDeriv_gGen, if_neg (castAdd_ne_natAdd j i).symm, mul_zero,
    sub_zero, map_neg]
  by_cases h : i = j
  · subst h; simp
  · rw [if_neg (fun hc ↦ h (Fin.castAdd_injective _ _ hc)), if_neg h, map_zero]

/-- The `Tⱼ`-coordinate of the differential of `[gᵢ]` is `−aᵏ δᵢⱼ`. -/
theorem d_gGen_natAdd (i j : Fin Pres.variableCount) :
    D.nl.differential (D.cl _ (D.gGen_mem i)) (Fin.natAdd Pres.variableCount j) =
      -(D.sc D.k * if i = j then 1 else 0) := by
  rw [differential_cl_apply, partialDeriv_gGen, if_neg (castAdd_ne_natAdd i j), neg_zero,
    zero_sub, map_neg, map_mul]
  by_cases h : i = j
  · subst h; simp [sc, map_pow]
  · rw [if_neg (fun hc ↦ h ((Fin.natAdd_inj _).mp hc)), if_neg h, map_zero]

/-- The `xⱼ'`-coordinate of the differential of `[fₗ]` is the Jacobian entry `∂fₗ/∂xⱼ`. -/
theorem d_fGen_castAdd (l : Fin D.m) (j : Fin Pres.variableCount) :
    D.nl.differential (D.cl _ (D.fGen_mem l)) (Fin.castAdd Pres.variableCount j) = D.Jb j l := by
  rw [differential_cl_apply, fGen, D.partialDeriv_castAdd_incl]
  rfl

/-- The `Tⱼ`-coordinate of the differential of `[fₗ]` is zero. -/
theorem d_fGen_natAdd (l : Fin D.m) (j : Fin Pres.variableCount) :
    D.nl.differential (D.cl _ (D.fGen_mem l)) (Fin.natAdd Pres.variableCount j) = 0 := by
  rw [differential_cl_apply, fGen, D.partialDeriv_natAdd_incl, map_zero]

/-- The `xⱼ'`-coordinate of the differential of `[ℓᵢ]` is `−E₁ᵢⱼ`. -/
theorem d_lGen_castAdd (i j : Fin Pres.variableCount) :
    D.nl.differential (D.cl _ (D.lGen_mem i)) (Fin.castAdd Pres.variableCount j) =
      -D.E1b i j := by
  rw [differential_cl_apply, lGen, map_sum, map_sum, E1b, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [Derivation.leibniz, D.partialDeriv_tv, if_neg (castAdd_ne_natAdd j l).symm, smul_zero,
    zero_add, map_sub, Derivation.leibniz, D.partialDeriv_one_apply, D.partialDeriv_algebraMap_A,
    smul_zero, smul_zero, add_zero, zero_sub, ambE, Matrix.map_apply, D.partialDeriv_castAdd_incl,
    smul_eq_mul, map_mul, map_neg]
  rw [mul_neg, mul_comm]

/-- The `Tⱼ`-coordinate of the differential of `[ℓᵢ]` is `(aᶜ − E)ᵢⱼ`. -/
theorem d_lGen_natAdd (i j : Fin Pres.variableCount) :
    D.nl.differential (D.cl _ (D.lGen_mem i)) (Fin.natAdd Pres.variableCount j) =
      (if i = j then D.sc D.c else 0) - D.Eb i j := by
  classical
  rw [differential_cl_apply, lGen, map_sum, map_sum]
  have hterm : ∀ l, D.π (D.nl.partialDeriv (Fin.natAdd Pres.variableCount j)
      (((1 : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount)
        (Amb a Pres.variableCount)) i l * algebraMap A (Amb a Pres.variableCount) (a ^ D.c) -
        D.ambE i l) * tv a Pres.variableCount l)) =
      if l = j then (if i = j then D.sc D.c else 0) - D.Eb i j else 0 := by
    intro l
    rw [Derivation.leibniz, D.partialDeriv_tv, map_sub, Derivation.leibniz,
      D.partialDeriv_one_apply, D.partialDeriv_algebraMap_A, smul_zero, smul_zero, add_zero,
      ambE, Matrix.map_apply, D.partialDeriv_natAdd_incl, sub_zero, smul_zero, add_zero]
    by_cases h : l = j
    · subst h
      rw [if_pos rfl, if_pos rfl, smul_eq_mul, mul_one, map_sub, map_mul, Matrix.one_apply]
      by_cases hil : i = l
      · subst hil; simp [Eb, ambE, sc, map_pow]
      · simp [hil, Eb, ambE]
    · rw [if_neg (fun hc ↦ h ((Fin.natAdd_inj _).mp hc)), if_neg h, smul_zero, map_zero]
  simp only [hterm, Finset.sum_ite_eq', Finset.mem_univ, if_true]

/-! ### Relations in the conormal module -/

/-- **Relation (R1)**: `aᶜ [fⱼ] = ∑ₗ (S · Jac)ₗⱼ [fₗ]` in `𝔎 / 𝔎²`. -/
theorem cl_fGen_relation (j : Fin D.m) :
    ∑ l, (∑ i, D.Sb l i * D.Jb i j) • D.cl _ (D.fGen_mem l) = D.sc D.c • D.cl _ (D.fGen_mem j) := by
  classical
  set u := algebraMap A Pres.completedPolynomialRing (a ^ D.c)
  have hx := D.incl_mem_sq (D.rel j)
  have he : incl a Pres.variableCount (∑ l, ((D.S * jacobian B Pres D.f) l j -
      (1 : Matrix (Fin D.m) (Fin D.m) _) l j * u) * D.f l) =
      ∑ l, incl a Pres.variableCount ((D.S * jacobian B Pres D.f) l j -
        (1 : Matrix (Fin D.m) (Fin D.m) _) l j * u) * D.fGen l := by
    rw [map_sum]
    exact Finset.sum_congr rfl fun l _ ↦ map_mul _ _ _
  have h0 := D.sum_smul_cl_eq_zero Finset.univ _ D.fGen D.fGen_mem (he ▸ hx)
  have hcoef : ∀ l, D.π (incl a Pres.variableCount
      ((D.S * jacobian B Pres D.f) l j - (1 : Matrix (Fin D.m) (Fin D.m) _) l j * u)) =
      (∑ i, D.Sb l i * D.Jb i j) - if l = j then D.sc D.c else 0 := by
    intro l
    rw [map_sub, map_sub, Matrix.mul_apply, map_sum, map_sum, map_mul, map_mul, D.π_incl_algebraMap,
      Matrix.one_apply]
    simp only [map_mul]
    split_ifs <;> simp [sc, map_pow]
  simp only [hcoef, sub_smul, Finset.sum_sub_distrib, ite_smul, zero_smul, Finset.sum_ite_eq',
    Finset.mem_univ, if_true] at h0
  exact sub_eq_zero.mp h0

/-- **Relation (R2)**: `∑ᵢ' Eᵢᵢ' [ℓᵢ'] = 0` in `𝔎 / 𝔎²`. -/
theorem cl_lGen_relation (i : Fin Pres.variableCount) :
    ∑ i', D.Eb i i' • D.cl _ (D.lGen_mem i') = 0 := by
  have hsq : ∑ i', D.ambE i i' * D.lGen i' ∈ D.ideal ^ 2 := by
    simp only [lGen]
    rw [sum_mul_linear_eq, neg_mem_iff]
    refine Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_right _ _ ?_
    have h := D.incl_mem_sq (D.quasi i j)
    rw [Matrix.sub_apply, Matrix.smul_apply, Matrix.mul_apply, smul_eq_mul, map_sub, map_sum,
      map_mul, AlgHom.commutes] at h
    simpa only [map_mul, ambE, Matrix.map_apply] using h
  exact D.sum_smul_cl_eq_zero Finset.univ _ D.lGen D.lGen_mem hsq

/-! ### Rig-étaleness -/

/-- The conormal module `𝔎 / 𝔎²` is spanned by the classes of the equations of the bundle. -/
theorem mem_span_cl_gens (z : D.pres.extension.Cotangent) :
    z ∈ Submodule.span D.obj.carrier
      (Set.range fun x ↦ D.cl (D.gens x) (D.gens_mem x)) := by
  obtain ⟨⟨g, hg⟩, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective z
  have hgI : g ∈ D.ideal := (D.mem_ker_iff g).1 hg
  obtain ⟨r, hr⟩ := (Ideal.mem_span_range_iff_exists_fun (R := Amb a Pres.variableCount)).mp hgI
  have h : Algebra.Extension.Cotangent.mk ⟨g, hg⟩ = D.cl g hgI := rfl
  rw [h, D.cl_congr g _ hgI (D.ideal.sum_mem fun x _ ↦ D.ideal.mul_mem_left _ (D.gens_mem x))
    (by rw [← hr]), D.cl_sum_mul _ _ _ D.gens_mem]
  refine Submodule.sum_mem _ fun x _ ↦ ?_
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨x, rfl⟩)

/-- The `2N` classes of the conormal module spanning it up to `a^{2c}`. -/
def κ : Fin Pres.variableCount ⊕ Fin Pres.variableCount → D.pres.extension.Cotangent :=
  kappa D.Sb (fun l ↦ D.cl _ (D.fGen_mem l)) (fun i ↦ D.cl _ (D.lGen_mem i))
    (fun i ↦ D.cl _ (D.gGen_mem i))

/-- `a^{2c}` carries the conormal module `𝔎 / 𝔎²` into the span of the classes `κ`. -/
theorem smul_mem_span_κ (z : D.pres.extension.Cotangent) :
    (D.sc D.c * D.sc D.c) • z ∈ Submodule.span D.obj.carrier (Set.range D.κ) := by
  obtain ⟨hf, hl, hg⟩ := smul_mem_span_kappa D.Eb (fun l j ↦ D.Jb j l) D.Sb (D.sc D.c)
    (fun l ↦ D.cl _ (D.fGen_mem l)) (fun i ↦ D.cl _ (D.lGen_mem i))
    (fun i ↦ D.cl _ (D.gGen_mem i)) D.Eb_eq D.cl_fGen_relation D.cl_lGen_relation
  have hgen : ∀ x, (D.sc D.c * D.sc D.c) • D.cl (D.gens x) (D.gens_mem x) ∈
      Submodule.span D.obj.carrier (Set.range D.κ) := by
    rintro (l | i | i)
    · exact hf l
    · exact hl i
    · exact hg i
  have hz := D.mem_span_cl_gens z
  induction hz using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨x, rfl⟩ := hy
    exact hgen x
  | zero => rw [smul_zero]; exact Submodule.zero_mem _
  | add y y' _ _ hy hy' => rw [smul_add]; exact Submodule.add_mem _ hy hy'
  | smul r y _ hy => rw [smul_comm]; exact Submodule.smul_mem _ r hy

/-- The image of `a` in the normal bundle. -/
abbrev α : D.obj.carrier := D.π (algebraMap A (Amb a Pres.variableCount) a)

/-- The image of `aʲ` in the normal bundle is the `j`-th power of the image of `a`. -/
theorem sc_eq (j : ℕ) : D.sc j = D.α ^ j := by
  rw [sc, map_pow, map_pow]

/-- The differential, with its target indexed by `Fin N ⊕ Fin N`. -/
def dSum : D.pres.extension.Cotangent →ₗ[D.obj.carrier]
    (Fin Pres.variableCount ⊕ Fin Pres.variableCount → D.obj.carrier) :=
  (LinearMap.funLeft D.obj.carrier D.obj.carrier finSumFinEquiv).comp D.nl.differential

/-- The coordinates of `dSum` are those of the differential, reindexed by `finSumFinEquiv`. -/
theorem dSum_apply (z : D.pres.extension.Cotangent)
    (v : Fin Pres.variableCount ⊕ Fin Pres.variableCount) :
    D.dSum z v = D.nl.differential z (finSumFinEquiv v) := rfl

/-- The `xⱼ'`-coordinate of the differential of `[gᵢ]` is `−δᵢⱼ`. -/
theorem dSum_κ_inl_inl (i j : Fin Pres.variableCount) :
    D.dSum (D.κ (Sum.inl i)) (Sum.inl j) = -(if i = j then 1 else 0) := by
  rw [dSum_apply, finSumFinEquiv_apply_left]
  exact D.d_gGen_castAdd i j

/-- The `Tⱼ`-coordinate of the differential of `[gᵢ]` is `−aᵏ δᵢⱼ`. -/
theorem dSum_κ_inl_inr (i j : Fin Pres.variableCount) :
    D.dSum (D.κ (Sum.inl i)) (Sum.inr j) = -(D.sc D.k * if i = j then 1 else 0) := by
  rw [dSum_apply, finSumFinEquiv_apply_right]
  exact D.d_gGen_natAdd i j

/-- The class `κ (inr i)` is `[ℓᵢ] + Φᵢ`, with `Φᵢ = ∑ₗ Sₗᵢ [fₗ]`. -/
theorem κ_inr (i : Fin Pres.variableCount) :
    D.κ (Sum.inr i) = D.cl _ (D.lGen_mem i) + ∑ l, D.Sb l i • D.cl _ (D.fGen_mem l) := rfl

/-- The `xⱼ'`-coordinate of the differential of `[ℓᵢ] + Φᵢ` is `Eᵢⱼ − E₁ᵢⱼ`. -/
theorem dSum_κ_inr_inl (i j : Fin Pres.variableCount) :
    D.dSum (D.κ (Sum.inr i)) (Sum.inl j) = D.Eb i j - D.E1b i j := by
  rw [dSum_apply, finSumFinEquiv_apply_left, κ_inr, map_add, map_sum, Pi.add_apply,
    Finset.sum_apply, d_lGen_castAdd, D.Eb_eq, neg_add_eq_sub]
  congr 1
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [map_smul, Pi.smul_apply, d_fGen_castAdd, smul_eq_mul, mul_comm]

/-- The `Tⱼ`-coordinate of the differential of `[ℓᵢ] + Φᵢ` is `(aᶜ − E)ᵢⱼ`. -/
theorem dSum_κ_inr_inr (i j : Fin Pres.variableCount) :
    D.dSum (D.κ (Sum.inr i)) (Sum.inr j) = (if i = j then D.sc D.c else 0) - D.Eb i j := by
  rw [dSum_apply, finSumFinEquiv_apply_right, κ_inr, map_add, map_sum, Pi.add_apply,
    Finset.sum_apply, d_lGen_natAdd]
  rw [Finset.sum_eq_zero fun l _ ↦ by rw [map_smul, Pi.smul_apply, d_fGen_natAdd, smul_zero],
    add_zero]

/-- The matrix of the differential on the classes `κ` is `kappaMatrix` for `α = a`, `E` and
`E₁`. -/
theorem matrix_dSum_κ :
    Matrix.of (fun v w ↦ D.dSum (D.κ w) v) =
      kappaMatrix D.α D.c (Matrix.of D.Eb) (Matrix.of D.E1b) := by
  classical
  ext v w
  rcases v with j | j <;> rcases w with i | i
  · rw [Matrix.of_apply, dSum_κ_inl_inl, kappaMatrix, Matrix.fromBlocks_apply₁₁, Matrix.neg_apply,
      Matrix.one_apply]
    by_cases h : i = j
    · subst h; simp
    · rw [if_neg h, if_neg (Ne.symm h)]
  · rw [Matrix.of_apply, dSum_κ_inr_inl, kappaMatrix, Matrix.fromBlocks_apply₁₂,
      Matrix.transpose_apply, Matrix.sub_apply, Matrix.of_apply, Matrix.of_apply]
  · rw [Matrix.of_apply, dSum_κ_inl_inr, kappaMatrix, Matrix.fromBlocks_apply₂₁, Matrix.neg_apply,
      Matrix.smul_apply, Matrix.one_apply, smul_eq_mul, sc_eq, k]
    by_cases h : i = j
    · subst h; simp
    · rw [if_neg h, if_neg (Ne.symm h)]
  · rw [Matrix.of_apply, dSum_κ_inr_inr, kappaMatrix, Matrix.fromBlocks_apply₂₂,
      Matrix.transpose_apply, Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply,
      smul_eq_mul, Matrix.of_apply, sc_eq]
    by_cases h : i = j
    · subst h; simp
    · simp [h]

/-- `E² = aᶜ E` on the normal bundle, as an identity of matrices. -/
theorem matrix_Eb_mul_Eb : Matrix.of D.Eb * Matrix.of D.Eb = D.α ^ D.c • Matrix.of D.Eb := by
  ext i j
  rw [Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul, ← sc_eq]
  exact D.Eb_mul_Eb i j

/-- `E · E₁ = 0` on the normal bundle, as an identity of matrices. -/
theorem matrix_Eb_mul_E1b : Matrix.of D.Eb * Matrix.of D.E1b = 0 := by
  ext i j
  rw [Matrix.mul_apply, Matrix.zero_apply]
  exact D.Eb_mul_E1b i j

/-- The image of `a` in the normal bundle is the image of the constant `a ∈ A[X]`. -/
private theorem α_eq_algebraMap_C :
    D.α = algebraMap (Base (A := A) Pres.variableCount) D.obj.carrier (MvPolynomial.C a) := by
  rw [α, IsScalarTower.algebraMap_apply A (Base (A := A) Pres.variableCount)
    (Amb a Pres.variableCount), AlgHom.commutes]
  rfl

/-- `det(1 + a E₁ᵀ)` is a unit of the normal bundle, which is `a`-adically complete. -/
theorem isUnit_det : IsUnit (1 + D.α • (Matrix.of D.E1b)ᵀ).det := by
  have hc : IsAdicComplete D.obj.adicIdeal D.obj.carrier := D.obj.isAdicallyComplete
  have hα : D.α ∈ D.obj.adicIdeal := by
    rw [D.α_eq_algebraMap_C]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self a))
  have hJ : D.obj.adicIdeal ≤ (⊥ : Ideal D.obj.carrier).jacobson := hc.le_jacobson_bot
  set q := Ideal.Quotient.mk D.obj.adicIdeal
  have hq : q (1 + D.α • (Matrix.of D.E1b)ᵀ).det = 1 := by
    rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.map_add _ (map_add q),
      Matrix.map_one _ (map_zero q) (map_one q), Matrix.map_smul' _ _ _ (map_mul q),
      Ideal.Quotient.eq_zero_iff_mem.mpr hα, zero_smul, add_zero, Matrix.det_one]
  have hmem : (1 + D.α • (Matrix.of D.E1b)ᵀ).det - 1 ∈ D.obj.adicIdeal := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hq, map_one, sub_self]
  have := (Ideal.mem_jacobson_bot.mp (hJ hmem)) 1
  rwa [mul_one, sub_add_cancel] at this

/-- **The completed normal bundle is rig-étale over `(A[X], (a))`.** -/
theorem isRigEtale : IsRigEtale D.obj := by
  classical
  set N := Pres.variableCount
  set u := (1 + D.α • (Matrix.of D.E1b)ᵀ).det
  set s := D.α ^ (3 * D.c + 1) * u
  have hMW : Matrix.of (fun v w ↦ D.dSum (D.κ w) v) *
      kappaInv D.α D.c (Matrix.of D.Eb) (Matrix.of D.E1b) = s • 1 := by
    rw [matrix_dSum_κ]
    exact kappaMatrix_mul_kappaInv _ _ _ _ D.matrix_Eb_mul_Eb D.matrix_Eb_mul_E1b
  obtain ⟨hcoker, hker⟩ := cohomology_of_matrix D.dSum D.κ _ s (D.sc D.c * D.sc D.c) hMW
    D.smul_mem_span_κ
  obtain ⟨v, hv⟩ := D.isUnit_det
  set p := 3 * D.c + 1
  set q := p * (N + N) + 2 * D.c + p
  have hcard : Fintype.card (Fin N ⊕ Fin N) = N + N := by simp
  have huv : u * ((v⁻¹ : D.obj.carrierˣ) : D.obj.carrier) = 1 := by
    rw [show u = (v : D.obj.carrier) from hv.symm, Units.mul_inv]
  have hcancel : ∀ (x : D.obj.carrier) (m : ℕ) (z : D.pres.extension.Cotangent),
      (x * u ^ m) • z = 0 → x • z = 0 := by
    intro x m z hz
    have hu : u ^ m * ((v⁻¹ : D.obj.carrierˣ) : D.obj.carrier) ^ m = 1 := by
      rw [← mul_pow, huv, one_pow]
    calc x • z = (((v⁻¹ : D.obj.carrierˣ) : D.obj.carrier) ^ m * (x * u ^ m)) • z := by
          congr 1
          rw [mul_comm x, ← mul_assoc, mul_comm _ (u ^ m), hu, one_mul]
      _ = 0 := by rw [mul_smul, hz, smul_zero]
  have hk : ∀ z, D.nl.differential z = 0 → D.α ^ q • z = 0 := by
    intro z hz
    have hz' : D.dSum z = 0 := by
      ext v
      rw [dSum_apply, hz, Pi.zero_apply, Pi.zero_apply]
    have h := hker z hz'
    have h' : (D.α ^ (p * (N + N) + 2 * D.c) * u ^ (N + N)) • z = 0 := by
      rw [hcard, sc_eq] at h
      rw [← h]
      congr 1
      simp only [s, p, mul_pow, ← pow_mul, ← pow_add]
      ring
    have h'' := hcancel _ _ z h'
    rw [show q = p + (p * (N + N) + 2 * D.c) by ring, pow_add, mul_smul, h'', smul_zero]
  have hc : ∀ y : Fin (N + N) → D.obj.carrier,
      D.α ^ q • y ∈ LinearMap.range D.nl.differential := by
    intro y
    obtain ⟨z, hz⟩ := hcoker (((v⁻¹ : D.obj.carrierˣ) : D.obj.carrier) • (y ∘ finSumFinEquiv))
    have hz' : D.nl.differential z = D.α ^ p • y := by
      ext w
      obtain ⟨w', rfl⟩ := finSumFinEquiv.surjective w
      have := congrFun hz w'
      rw [dSum_apply] at this
      rw [this, Pi.smul_apply, Pi.smul_apply, Pi.smul_apply, Function.comp_apply, smul_smul]
      congr 1
      rw [show s = D.α ^ p * u from rfl, mul_assoc, huv, mul_one]
    rw [show q = (p * (N + N) + 2 * D.c) + p by ring, pow_add, mul_smul, ← hz']
    exact Submodule.smul_mem _ _ ⟨z, rfl⟩
  have hαC : (algebraMap (Base (A := A) Pres.variableCount) D.obj.carrier).comp MvPolynomial.C
      a = D.α := D.α_eq_algebraMap_C.symm
  have hspan : (baseIdeal a N ^ q).map (algebraMap (Base (A := A) Pres.variableCount)
      D.obj.carrier) ≤ Ideal.span {D.α ^ q} := by
    rw [Ideal.map_pow, Ideal.map_map, Ideal.map_span, Set.image_singleton, hαC,
      Ideal.span_singleton_pow]
  refine (isRigEtale_iff_exists_annihilator_cohomology D.obj D.pres).mpr ⟨q, ?_, ?_⟩
  · refine hspan.trans (Ideal.span_le.mpr ?_)
    rintro _ rfl
    refine Module.mem_annihilator.mpr fun z ↦ Subtype.ext ?_
    exact hk z.1 z.2
  · refine hspan.trans (Ideal.span_le.mpr ?_)
    rintro _ rfl
    refine Module.mem_annihilator.mpr fun m ↦ ?_
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ m
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hc y

end Data

