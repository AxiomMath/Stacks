module

public import StacksFrontier.RingTheory.Rig.Algebraization.NormalBundle
public import StacksFrontier.RingTheory.Rig.Algebraization.PerturbedZeroSection
public import StacksFrontier.RingTheory.AdicCompletion.LiftToComplete

/-!
# The sections of the completed normal bundle

Let `B = A⟨x₁, …, x_N⟩ / J` be presented by `Pres`, write `B₀ = A⟨x⟩ / J` for the quotient itself
and let `D : Rig.NormalBundle.Data B Pres` be the data of a completed normal bundle
`Ĉ = A[X]⟨x', T⟩ / (f(x'), (aᶜ − Ẽ(x')) T, X − x' − aᵏ T)`. This file constructs the maps
relating `Ĉ` to `B₀`:

* the map `β : B₀ → Ĉ`, `xᵢ ↦ x'ᵢ`;
* for every point `τ ∈ B₀ᴺ` of the bundle `aᶜ τ = E τ`, the section `ev τ : Ĉ → B₀`,
  `x'ᵢ ↦ xᵢ`, `Tᵢ ↦ τᵢ`, `Xᵢ ↦ xᵢ + aᵏ τᵢ`; the zero section is `s = ev 0`.

They satisfy `ev τ ∘ β = id`, `ev τ (Tᵢ) = τᵢ`, `ker s ⊆ (T₁, …, T_N)`, and `ev τ ≡ ev τ'` modulo
`aⁿ` when `τ ≡ τ'` modulo `aⁿ`. These are the hypotheses of
`Rig.exists_algEquiv_quotient_of_perturbed_zeroSection`, which we apply.

## Main definitions

* `Rig.NormalBundle.Data.β`: the map `B₀ → Ĉ`.
* `Rig.NormalBundle.Data.ev`: the section `Ĉ → B₀` through a point `τ` of the bundle.
* `Rig.NormalBundle.Data.s`: the zero section.

## Main results

* `Rig.NormalBundle.Data.ker_s_le`: `ker s ⊆ (T₁, …, T_N)`.
* `Rig.NormalBundle.Data.ev_sub_mem`: `τ ↦ ev τ` is continuous for the `a`-adic topologies.
* `Rig.NormalBundle.Data.nonempty_algEquiv_quotient`: for `t ≡ T` modulo a high power of `a`
  satisfying `aᶜ t = E₀ t` with `E₀ ≡ E`, the quotient `Ĉ / (t)` is isomorphic to `B₀`.
-/

@[expose] public noncomputable section

open MvPolynomial
open scoped Matrix

universe u v

namespace Rig

namespace NormalBundle

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {a : A}

section Generic

omit [IsNoetherianRing A]

/-- An `A`-algebra map out of a polynomial ring over `A` carries the extension of `(a)` into the
ideal generated by the image of `a`. -/
theorem map_span_C_le {σ T : Type*} [CommRing T] [Algebra A T]
    (g : MvPolynomial σ A →ₐ[A] T) :
    ((Ideal.span {a}).map (C : A →+* MvPolynomial σ A)).map g ≤
      Ideal.span {algebraMap A T a} := by
  rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap, Ideal.span_le]
  intro x hx
  rw [Set.mem_singleton_iff.mp hx]
  simp only [SetLike.mem_coe, Ideal.mem_comap]
  rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
  exact Ideal.mem_span_singleton_self _

/-- An `A`-algebra map out of a polynomial ring over `A[X]` carries the extension of `(a)` into
the ideal generated by the image of `a`. -/
theorem map_baseIdeal_le {σ T : Type*} [CommRing T] [Algebra A T] (N : ℕ)
    (g : MvPolynomial σ (Base (A := A) N) →ₐ[A] T) :
    ((baseIdeal a N).map (C : Base (A := A) N →+* MvPolynomial σ (Base (A := A) N))).map g ≤
      Ideal.span {algebraMap A T a} := by
  rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap,
    Ideal.span_le]
  intro x hx
  rw [Set.mem_singleton_iff.mp hx]
  simp only [SetLike.mem_coe, Ideal.mem_comap]
  have h : (C (C a) : MvPolynomial σ (Base (A := A) N)) =
      algebraMap A (MvPolynomial σ (Base (A := A) N)) a := by
    simp [MvPolynomial.algebraMap_apply]
  rw [h, AlgHom.commutes]
  exact Ideal.mem_span_singleton_self _

/-- The ideal `(a)` of `A` is finitely generated. -/
theorem fg_span_singleton (r : A) : (Ideal.span {r}).FG := ⟨{r}, by simp⟩

/-- The expansion of `((u − E) T)ᵢ` under a ring map. -/
theorem map_sum_one_mul_sub {R S : Type*} [CommRing R] [CommRing S] {n : ℕ} (f : R →+* S)
    (u : R) (E : Matrix (Fin n) (Fin n) R) (T : Fin n → R) (i : Fin n) :
    f (∑ j, ((1 : Matrix (Fin n) (Fin n) R) i j * u - E i j) * T j) =
      (f u • (fun j ↦ f (T j)) - (E.map f).mulVec (fun j ↦ f (T j))) i := by
  classical
  simp only [map_sum, map_mul, map_sub, Matrix.one_apply, Pi.sub_apply, Pi.smul_apply,
    smul_eq_mul, Matrix.mulVec, dotProduct, Matrix.map_apply, sub_mul, Finset.sum_sub_distrib]
  congr 1
  simp [apply_ite f]

/-- `(x + c t) − (x + c t') = c (t − t')`. -/
theorem add_mul_sub_add_mul {R : Type*} [CommRing R] (x c t t' : R) :
    x + c * t - (x + c * t') = c * (t - t') := by ring

/-- A quotient by a power of `(a)` is `a`-adically separated, the ideal being nilpotent. -/
theorem isHausdorff_quotient_pow {R : Type*} [CommRing R] [Algebra A R] (n : ℕ) :
    IsHausdorff (Ideal.span {algebraMap A (R ⧸ Ideal.span {algebraMap A R a} ^ n) a})
      (R ⧸ Ideal.span {algebraMap A R a} ^ n) := by
  have hnil : IsNilpotent
      (Ideal.span {algebraMap A (R ⧸ Ideal.span {algebraMap A R a} ^ n) a}) := by
    refine ⟨n, ?_⟩
    have e := Ideal.span_singleton_pow (algebraMap A (R ⧸ Ideal.span {algebraMap A R a} ^ n) a) n
    rw [e, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot, ← map_pow]
    change Ideal.Quotient.mk _ (algebraMap A R (a ^ n)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem, map_pow]
    exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n
  have := IsAdicComplete.of_isNilpotent _ hnil
  infer_instance

/-- The coordinate `Xᵢ` of the ambient ring is the image of the constant `C (Xᵢ)`. -/
private theorem algebraMap_C_X_eq_bv {N : ℕ} (i : Fin N) :
    algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N) (C (X i)) = bv a N i := by
  rw [bv, IsScalarTower.algebraMap_apply (Base (A := A) N)
    (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N), MvPolynomial.algebraMap_eq]

end Generic

/-! ### Uniqueness of maps out of the completed polynomial algebras -/

omit [IsNoetherianRing A] in
/-- Two `A`-algebra maps `A[X]⟨x', T⟩ → T` into an `a`-adically separated algebra agree as soon
as they agree on the coordinates `Xᵢ`, `x'ᵢ` and `Tᵢ`. -/
theorem ambHom_ext {N : ℕ} {T : Type*} [CommRing T] [Algebra A T]
    [IsHausdorff (Ideal.span {algebraMap A T a}) T] (f g : Amb a N →ₐ[A] T)
    (hb : ∀ i, f (bv a N i) = g (bv a N i)) (hx : ∀ i, f (xv a N i) = g (xv a N i))
    (ht : ∀ i, f (tv a N i) = g (tv a N i)) : f = g := by
  have hC : ∀ r : A, algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N)
      (C (C r)) = algebraMap A (Amb a N) r := fun r ↦ by
    rw [IsScalarTower.algebraMap_apply A (MvPolynomial (Fin (N + N)) (Base (A := A) N))
      (Amb a N), MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
  have hfg : (f : Amb a N →+* T).comp
        (algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N)) =
      (g : Amb a N →+* T).comp
        (algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N)) := by
    refine MvPolynomial.ringHom_ext (fun r ↦ ?_) (fun v ↦ ?_)
    · have h' : ((f : Amb a N →+* T).comp
            (algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N))).comp C =
          ((g : Amb a N →+* T).comp
            (algebraMap (MvPolynomial (Fin (N + N)) (Base (A := A) N)) (Amb a N))).comp C := by
        refine MvPolynomial.ringHom_ext (fun r ↦ ?_) (fun i ↦ ?_)
        · simp only [RingHom.comp_apply, RingHom.coe_coe]
          rw [hC, f.commutes, g.commutes]
        · simp only [RingHom.comp_apply, RingHom.coe_coe]
          rw [algebraMap_C_X_eq_bv]
          exact hb i
      exact RingHom.congr_fun h' r
    · induction v using Fin.addCases with
      | left i => exact hx i
      | right i => exact ht i
  refine AdicCompletion.algHom_ext_of_isHausdorff _
    (((fg_span_singleton a).map _).map _) (Ideal.span {algebraMap A T a}) f g
    (fun p ↦ RingHom.congr_fun hfg p) (fun p hp ↦ ?_)
  exact map_baseIdeal_le N (f.comp (IsScalarTower.toAlgHom A _ (Amb a N)))
    (Ideal.mem_map_of_mem _ hp)

omit [IsNoetherianRing A] in
/-- Two `A`-algebra maps `A⟨x⟩ → T` into an `a`-adically separated algebra agree as soon as they
agree on the variables. -/
theorem polyHom_ext {n : ℕ} {T : Type*} [CommRing T] [Algebra A T]
    [IsHausdorff (Ideal.span {algebraMap A T a}) T]
    (f g : completedPolynomialAlgebra (Ideal.span {a}) n →ₐ[A] T)
    (h : ∀ i, f (algebraMap (MvPolynomial (Fin n) A) _ (X i)) =
      g (algebraMap (MvPolynomial (Fin n) A) _ (X i))) : f = g := by
  have hfg : f.comp (IsScalarTower.toAlgHom A (MvPolynomial (Fin n) A) _) =
      g.comp (IsScalarTower.toAlgHom A (MvPolynomial (Fin n) A) _) :=
    MvPolynomial.algHom_ext fun i ↦ h i
  refine AdicCompletion.algHom_ext_of_isHausdorff _ ((fg_span_singleton a).map _)
    (Ideal.span {algebraMap A T a}) f g (fun p ↦ AlgHom.congr_fun hfg p) (fun p hp ↦ ?_)
  exact map_span_C_le (f.comp (IsScalarTower.toAlgHom A _ _)) (Ideal.mem_map_of_mem _ hp)

variable {B : AdicFiniteTypeAlgebra.{u, v} A (Ideal.span {a})}
  {Pres : CompletedPolynomialPresentation (Ideal.span {a}) B}

variable (Pres) in
/-- The algebra `B₀ = A⟨x⟩ / J` presented by `Pres`. -/
abbrev B0 : Type u := Pres.completedPolynomialRing ⧸ Pres.ideal

/-- `B₀` is `a`-adically complete. -/
instance : IsAdicComplete (Ideal.span {algebraMap A (B0 Pres) a}) (B0 Pres) := by
  have h : IsAdicComplete ((Ideal.span {a}).map (algebraMap A (B0 Pres))) (B0 Pres) :=
    PerturbedPresentation.isAdicComplete_quotRing A (Ideal.span {a}) Pres.variableCount
      Pres.ideal
  have he : (Ideal.span {a}).map (algebraMap A (B0 Pres)) =
      Ideal.span {algebraMap A (B0 Pres) a} := by
    simp only [Ideal.map_span, Set.image_singleton]
  exact he ▸ h

/-- The coordinate `xᵢ` of `B₀`. -/
def xb (i : Fin Pres.variableCount) : B0 Pres :=
  Ideal.Quotient.mk Pres.ideal
    (algebraMap (MvPolynomial (Fin Pres.variableCount) A) Pres.completedPolynomialRing (X i))

namespace Data

variable (D : Data B Pres)

/-- The completed normal bundle is an `A`-algebra through `A → A[X]`. -/
instance : Algebra A D.obj.carrier :=
  inferInstanceAs (Algebra A (Amb a Pres.variableCount ⧸ D.ideal))

/-- The `A`-algebra structure of the normal bundle factors through `A[X]`. -/
instance : IsScalarTower A (Base (A := A) Pres.variableCount) D.obj.carrier :=
  inferInstanceAs (IsScalarTower A (Base (A := A) Pres.variableCount)
    (Amb a Pres.variableCount ⧸ D.ideal))

/-- The completed normal bundle is `a`-adically complete. -/
instance : IsAdicComplete (Ideal.span {algebraMap A D.obj.carrier a}) D.obj.carrier := by
  have h : IsAdicComplete D.obj.adicIdeal D.obj.carrier := D.obj.isAdicallyComplete
  have he : D.obj.adicIdeal = Ideal.span {algebraMap A D.obj.carrier a} := by
    rw [AdicFiniteTypeAlgebra.adicIdeal, Ideal.map_map, Ideal.map_span,
      Set.image_singleton, RingHom.comp_apply, ← MvPolynomial.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply]
  rw [he] at h
  exact h

/-- The quotient map `A[X]⟨x', T⟩ → Ĉ` as an `A`-algebra map. -/
def πA : Amb a Pres.variableCount →ₐ[A] D.obj.carrier := Ideal.Quotient.mkₐ A D.ideal

/-- The `A`-algebra map `πA` agrees with the quotient map `π`. -/
theorem πA_apply (z : Amb a Pres.variableCount) : D.πA z = D.π z := rfl

/-- The map `β : B₀ → Ĉ`, induced by `A⟨x⟩ → A[X]⟨x', T⟩ → Ĉ`, `xᵢ ↦ x'ᵢ`. -/
def β : B0 Pres →ₐ[A] D.obj.carrier :=
  Ideal.Quotient.liftₐ Pres.ideal (D.πA.comp (incl a Pres.variableCount))
    fun _ hx ↦ D.π_incl_eq_zero hx

/-- `β` sends the class of `y ∈ A⟨x⟩` to the image of `y` in `Ĉ`. -/
theorem β_mk (y : Pres.completedPolynomialRing) :
    D.β (Ideal.Quotient.mk Pres.ideal y) = D.π (incl a Pres.variableCount y) := rfl

/-- `β (xᵢ) = x'ᵢ`. -/
theorem β_xb (i : Fin Pres.variableCount) : D.β (xb i) = D.π (xv a Pres.variableCount i) := by
  rw [xb, β_mk, incl_algebraMap, inclPoly_X]
  rfl

/-- The quasi-idempotent `E` over `B₀`. -/
def Eb0 : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount) (B0 Pres) :=
  D.Et.map (Ideal.Quotient.mk Pres.ideal)

/-- `β` sends the entries of `E` over `B₀` to the entries of `E` over `Ĉ`. -/
theorem β_Eb0 (i j : Fin Pres.variableCount) : D.β (D.Eb0 i j) = D.Eb i j := rfl

set_option synthInstance.maxHeartbeats 200000 in
-- instance synthesis over the quotient ring `B0 Pres` in the matrix rewrites below
/-- `E² = aᶜ E` over `B₀`. -/
theorem Eb0_mul_Eb0 : D.Eb0 * D.Eb0 = algebraMap A (B0 Pres) (a ^ D.c) • D.Eb0 := by
  ext i j
  have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_self two_ne_zero (D.quasi i j))
  rw [Matrix.sub_apply, Matrix.smul_apply, Matrix.mul_apply, smul_eq_mul, map_sub, sub_eq_zero,
    map_sum, map_mul] at h
  simp only [map_mul] at h
  rw [Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul]
  exact h

/-- The relation `aᶜ T = E T` in the completed normal bundle. -/
theorem smul_Tb_eq_mulVec :
    algebraMap A D.obj.carrier (a ^ D.c) • D.Tb = (Matrix.of D.Eb).mulVec D.Tb := by
  funext i
  rw [Pi.smul_apply, smul_eq_mul]
  exact (D.Eb_mul_Tb i).symm

/-! ### The sections `ev τ` -/

/-- The tubular map `A[X] → B₀`, `Xᵢ ↦ xᵢ + aᵏ τᵢ`. -/
def baseMap (τ : Fin Pres.variableCount → B0 Pres) :
    Base (A := A) Pres.variableCount →ₐ[A] B0 Pres :=
  aeval fun i ↦ xb i + algebraMap A (B0 Pres) (a ^ D.k) * τ i

/-- The map `A[X][x', T] → B₀`, `Xᵢ ↦ xᵢ + aᵏ τᵢ`, `x'ᵢ ↦ xᵢ`, `Tᵢ ↦ τᵢ`. -/
def evPoly (τ : Fin Pres.variableCount → B0 Pres) :
    MvPolynomial (Fin (Pres.variableCount + Pres.variableCount))
      (Base (A := A) Pres.variableCount) →ₐ[A] B0 Pres where
  __ := eval₂Hom (D.baseMap τ : Base (A := A) Pres.variableCount →+* B0 Pres) (Fin.append xb τ)
  commutes' r := by
    change eval₂ _ _ (algebraMap A _ r) = _
    rw [MvPolynomial.algebraMap_apply, eval₂_C]
    exact (D.baseMap τ).commutes r

/-- The map `evPoly τ` extends to an `A`-algebra map `A[X]⟨x', T⟩ → B₀`. -/
theorem exists_evAmb (τ : Fin Pres.variableCount → B0 Pres) :
    ∃ H : Amb a Pres.variableCount →ₐ[A] B0 Pres,
      ∀ p, H (AdicCompletion.of _ _ p) = D.evPoly τ p :=
  AdicCompletion.exists_algHom_of_isAdicComplete _ (Ideal.span {algebraMap A (B0 Pres) a})
    (D.evPoly τ) (map_baseIdeal_le _ _)

/-- The extension `A[X]⟨x', T⟩ → B₀` of `evPoly τ`. -/
def evAmb (τ : Fin Pres.variableCount → B0 Pres) : Amb a Pres.variableCount →ₐ[A] B0 Pres :=
  Classical.choose (D.exists_evAmb τ)

/-- `evAmb τ` restricts to `evPoly τ` on `A[X][x', T]`. -/
theorem evAmb_algebraMap (τ : Fin Pres.variableCount → B0 Pres)
    (p : MvPolynomial (Fin (Pres.variableCount + Pres.variableCount))
      (Base (A := A) Pres.variableCount)) :
    D.evAmb τ (algebraMap _ (Amb a Pres.variableCount) p) = D.evPoly τ p :=
  Classical.choose_spec (D.exists_evAmb τ) p

/-- `evAmb τ` sends a coordinate `x'ᵢ` or `Tᵢ` to the corresponding entry of `xb ++ τ`. -/
private theorem evAmb_algebraMap_X (τ : Fin Pres.variableCount → B0 Pres)
    (k : Fin (Pres.variableCount + Pres.variableCount)) :
    D.evAmb τ (algebraMap (MvPolynomial (Fin (Pres.variableCount + Pres.variableCount))
      (Base (A := A) Pres.variableCount)) (Amb a Pres.variableCount) (X k)) =
      Fin.append xb τ k := by
  rw [evAmb_algebraMap]
  change eval₂ _ _ (X _) = _
  rw [eval₂_X]

/-- `evAmb τ (x'ᵢ) = xᵢ`. -/
theorem evAmb_xv (τ : Fin Pres.variableCount → B0 Pres) (i : Fin Pres.variableCount) :
    D.evAmb τ (xv a Pres.variableCount i) = xb i := by
  rw [xv, evAmb_algebraMap_X, Fin.append_left]

/-- `evAmb τ (Tᵢ) = τᵢ`. -/
theorem evAmb_tv (τ : Fin Pres.variableCount → B0 Pres) (i : Fin Pres.variableCount) :
    D.evAmb τ (tv a Pres.variableCount i) = τ i := by
  rw [tv, evAmb_algebraMap_X, Fin.append_right]

/-- `evAmb τ (Xᵢ) = xᵢ + aᵏ τᵢ`. -/
theorem evAmb_bv (τ : Fin Pres.variableCount → B0 Pres) (i : Fin Pres.variableCount) :
    D.evAmb τ (bv a Pres.variableCount i) = xb i + algebraMap A (B0 Pres) (a ^ D.k) * τ i := by
  rw [← algebraMap_C_X_eq_bv, evAmb_algebraMap]
  change eval₂ _ _ (C _) = _
  rw [eval₂_C]
  change aeval _ (X i) = _
  rw [aeval_X]

/-- `evAmb τ` sends the image of `y ∈ A⟨x⟩` to the class of `y` in `B₀`. -/
theorem evAmb_incl (τ : Fin Pres.variableCount → B0 Pres) (y : Pres.completedPolynomialRing) :
    D.evAmb τ (incl a Pres.variableCount y) = Ideal.Quotient.mk Pres.ideal y := by
  have h : (D.evAmb τ).comp (incl a Pres.variableCount) = Ideal.Quotient.mkₐ A Pres.ideal := by
    refine polyHom_ext _ _ fun i ↦ ?_
    rw [AlgHom.comp_apply, incl_algebraMap, inclPoly_X, ← xv, evAmb_xv]
    rfl
  exact AlgHom.congr_fun h y

/-- `evAmb τ` sends the matrix `E` over `A[X]⟨x', T⟩` to the matrix `E` over `B₀`. -/
theorem evAmb_ambE (τ : Fin Pres.variableCount → B0 Pres) :
    D.ambE.map (D.evAmb τ) = D.Eb0 := by
  ext i j
  exact D.evAmb_incl τ (D.Et i j)

/-- If `aᶜ τ = E τ`, then `evAmb τ` vanishes on the ideal defining `Ĉ`. -/
theorem evAmb_eq_zero (τ : Fin Pres.variableCount → B0 Pres)
    (h : algebraMap A (B0 Pres) (a ^ D.c) • τ = D.Eb0.mulVec τ) :
    ∀ z ∈ D.ideal, D.evAmb τ z = 0 := by
  have hle : D.ideal ≤ RingHom.ker (D.evAmb τ) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨x, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker]
    rcases x with l | i | i
    · change D.evAmb τ (incl a Pres.variableCount (D.f l)) = 0
      rw [evAmb_incl, Ideal.Quotient.eq_zero_iff_mem, ← D.span_eq]
      exact Ideal.subset_span ⟨l, rfl⟩
    · change D.evAmb τ (D.lGen i) = 0
      have e := map_sum_one_mul_sub (D.evAmb τ : Amb a Pres.variableCount →+* B0 Pres)
        (algebraMap A (Amb a Pres.variableCount) (a ^ D.c)) D.ambE (tv a Pres.variableCount) i
      have hτ : (fun j ↦ (D.evAmb τ : Amb a Pres.variableCount →+* B0 Pres)
          (tv a Pres.variableCount j)) = τ := funext fun j ↦ D.evAmb_tv τ j
      rw [hτ, RingHom.coe_coe, AlgHom.commutes] at e
      rw [lGen]
      refine e.trans ?_
      rw [D.evAmb_ambE τ, h, sub_self, Pi.zero_apply]
    · change D.evAmb τ (D.gGen i) = 0
      rw [gGen, map_sub, map_sub, map_mul, evAmb_bv, evAmb_xv, evAmb_tv, AlgHom.commutes,
        add_sub_cancel_left, sub_self]
  exact fun z hz ↦ hle hz

/-- **The section `ev τ : Ĉ → B₀`** attached to a point `τ` of the bundle `aᶜ τ = E τ`:
`x'ᵢ ↦ xᵢ`, `Tᵢ ↦ τᵢ`, `Xᵢ ↦ xᵢ + aᵏ τᵢ`. -/
def ev (τ : Fin Pres.variableCount → B0 Pres)
    (h : algebraMap A (B0 Pres) (a ^ D.c) • τ = D.Eb0.mulVec τ) :
    D.obj.carrier →ₐ[A] B0 Pres :=
  Ideal.Quotient.liftₐ D.ideal (D.evAmb τ) (D.evAmb_eq_zero τ h)

/-- `ev τ ∘ π = evAmb τ`. -/
theorem ev_π (τ : Fin Pres.variableCount → B0 Pres)
    (h : algebraMap A (B0 Pres) (a ^ D.c) • τ = D.Eb0.mulVec τ) (z : Amb a Pres.variableCount) :
    D.ev τ h (D.π z) = D.evAmb τ z := rfl

/-- `ev τ ∘ β = id`. -/
theorem ev_β (τ : Fin Pres.variableCount → B0 Pres)
    (h : algebraMap A (B0 Pres) (a ^ D.c) • τ = D.Eb0.mulVec τ) (b : B0 Pres) :
    D.ev τ h (D.β b) = b := by
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [β_mk, ev_π, evAmb_incl]

/-- `ev τ (Tᵢ) = τᵢ`. -/
theorem ev_Tb (τ : Fin Pres.variableCount → B0 Pres)
    (h : algebraMap A (B0 Pres) (a ^ D.c) • τ = D.Eb0.mulVec τ) (i : Fin Pres.variableCount) :
    D.ev τ h (D.Tb i) = τ i :=
  D.evAmb_tv τ i

/-- **Continuity of `τ ↦ ev τ`**: if `τ ≡ τ'` modulo `aⁿ` then `ev τ ≡ ev τ'` modulo `aⁿ`. -/
theorem ev_sub_mem (τ : Fin Pres.variableCount → B0 Pres)
    (h : algebraMap A (B0 Pres) (a ^ D.c) • τ = D.Eb0.mulVec τ)
    (τ' : Fin Pres.variableCount → B0 Pres)
    (h' : algebraMap A (B0 Pres) (a ^ D.c) • τ' = D.Eb0.mulVec τ') (n : ℕ)
    (hτ : ∀ i, τ i - τ' i ∈ Ideal.span {algebraMap A (B0 Pres) a} ^ n) (y : D.obj.carrier) :
    D.ev τ h y - D.ev τ' h' y ∈ Ideal.span {algebraMap A (B0 Pres) a} ^ n := by
  have := isHausdorff_quotient_pow (a := a) (R := B0 Pres) n
  set q := Ideal.Quotient.mkₐ A (Ideal.span {algebraMap A (B0 Pres) a} ^ n)
  have hq : ∀ x x', x - x' ∈ Ideal.span {algebraMap A (B0 Pres) a} ^ n → q x = q x' :=
    fun x x' hx ↦ Ideal.Quotient.eq.mpr hx
  have hfg : q.comp (D.evAmb τ) = q.comp (D.evAmb τ') := by
    refine ambHom_ext _ _ (fun i ↦ ?_) (fun i ↦ ?_) (fun i ↦ ?_)
    · rw [AlgHom.comp_apply, AlgHom.comp_apply, evAmb_bv, evAmb_bv]
      refine hq _ _ ?_
      rw [add_mul_sub_add_mul]
      exact Ideal.mul_mem_left _ _ (hτ i)
    · rw [AlgHom.comp_apply, AlgHom.comp_apply, evAmb_xv, evAmb_xv]
    · rw [AlgHom.comp_apply, AlgHom.comp_apply, evAmb_tv, evAmb_tv]
      exact hq _ _ (hτ i)
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective (I := D.ideal) y
  have hz := AlgHom.congr_fun hfg z
  change Ideal.Quotient.mk _ (D.evAmb τ z) = Ideal.Quotient.mk _ (D.evAmb τ' z) at hz
  exact Ideal.Quotient.eq.mp hz

/-- The zero vector satisfies `aᶜ τ = E τ` over `B₀`. -/
theorem smul_zero_eq_mulVec_zero :
    algebraMap A (B0 Pres) (a ^ D.c) • (0 : Fin Pres.variableCount → B0 Pres) =
      D.Eb0.mulVec 0 := by
  rw [smul_zero, Matrix.mulVec_zero]

/-- **The zero section** `s = ev 0 : Ĉ → B₀`. -/
def s : D.obj.carrier →ₐ[A] B0 Pres := D.ev 0 D.smul_zero_eq_mulVec_zero

/-- `s ∘ β = id`. -/
theorem s_β (b : B0 Pres) : D.s (D.β b) = b := D.ev_β _ _ b

/-- The kernel of the zero section is contained in the ideal `(T₁, …, T_N)`: modulo `(T)` the
identity of `Ĉ` factors as `β ∘ s`. -/
theorem ker_s_le : RingHom.ker D.s ≤ Ideal.span (Set.range D.Tb) := by
  set K := Ideal.span (Set.range D.Tb)
  have hjac : Ideal.span {algebraMap A (D.obj.carrier ⧸ K) a} ≤ Ideal.jacobson ⊥ := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_jacobson_bot]
    intro q
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hα : algebraMap A (D.obj.carrier ⧸ K) a =
        Ideal.Quotient.mk K (algebraMap A D.obj.carrier a) := rfl
    rw [hα, ← map_mul, ← map_one (Ideal.Quotient.mk K), ← map_add]
    exact (Ideal.mem_jacobson_bot.mp (IsAdicComplete.le_jacobson_bot
      (I := Ideal.span {algebraMap A D.obj.carrier a}) (Ideal.mem_span_singleton_self _)) q).map _
  have : IsHausdorff (Ideal.span {algebraMap A (D.obj.carrier ⧸ K) a}) (D.obj.carrier ⧸ K) :=
    IsHausdorff.of_le_jacobson _ _ hjac
  set q := Ideal.Quotient.mkₐ A K
  have hfg : q.comp D.πA = (q.comp D.β).comp (D.s.comp D.πA) := by
    refine ambHom_ext _ _ (fun i ↦ ?_) (fun i ↦ ?_) (fun i ↦ ?_)
    · simp only [AlgHom.comp_apply]
      rw [πA_apply, s, ev_π, evAmb_bv, Pi.zero_apply, mul_zero, add_zero, β_xb]
      refine Ideal.Quotient.eq.mpr ?_
      have h0 : D.π (D.gGen i) = 0 := (D.mem_ker_iff _).2 (D.gGen_mem i)
      rw [gGen, map_sub, map_sub, sub_eq_zero] at h0
      rw [h0, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    · simp only [AlgHom.comp_apply]
      rw [πA_apply, s, ev_π, evAmb_xv, β_xb]
    · simp only [AlgHom.comp_apply]
      rw [πA_apply, s, ev_π, evAmb_tv, Pi.zero_apply, map_zero, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  intro y hy
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective (I := D.ideal) y
  have h1 := AlgHom.congr_fun hfg z
  have hs0 : D.s (D.π z) = 0 := hy
  change Ideal.Quotient.mk K (D.π z) = Ideal.Quotient.mk K (D.β (D.s (D.π z))) at h1
  rw [hs0, map_zero] at h1
  exact Ideal.Quotient.eq_zero_iff_mem.mp h1

/-- **Perturbing the zero section of the completed normal bundle.** There is an `n` such that
for all `t₁, …, t_N ∈ Ĉ` with `tᵢ ≡ Tᵢ` modulo `aⁿ` and every matrix `E₀` over `Ĉ` with
`E₀ ≡ E` modulo `aⁿ` and `aᶜ t = E₀ t`, the quotient `Ĉ / (t₁, …, t_N)` is isomorphic to
`B₀ = A⟨x⟩ / J` as an `A`-algebra. -/
theorem nonempty_algEquiv_quotient :
    ∃ n : ℕ, ∀ (t : Fin Pres.variableCount → D.obj.carrier)
      (E0 : Matrix (Fin Pres.variableCount) (Fin Pres.variableCount) D.obj.carrier),
      (∀ i, t i - D.Tb i ∈ Ideal.span {algebraMap A D.obj.carrier a} ^ n) →
      (∀ i j, E0 i j - D.Eb i j ∈ Ideal.span {algebraMap A D.obj.carrier a} ^ n) →
      algebraMap A D.obj.carrier (a ^ D.c) • t = E0.mulVec t →
      Nonempty (B0 Pres ≃ₐ[A] D.obj.carrier ⧸ Ideal.span (Set.range t)) :=
  exists_algEquiv_quotient_of_perturbed_zeroSection a D.β D.s D.s_β D.Tb D.ker_s_le D.Eb0
    D.Eb0_mul_Eb0 D.ev D.ev_β D.ev_Tb D.ev_sub_mem

end Data
