module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Rig.Algebraization.PrincipalIsomorphism
public import StacksFrontier.RingTheory.Rig.RigEtaleBaseChange

/-!
# Dropping a generator of the ideal of a rig-étale algebra

Let `A` be a Noetherian ring, let `s` be a finite subset of `A`, let `a ∈ A` and let
`I = (s ∪ {a})`.  Write `Ā = A ⧸ (a^m)` and `Ī` for the ideal of `Ā` generated by the image of
`s`, which has one generator fewer than `I`.  This file shows that `V(I Ā) = V(Ī)`, and that the
completed base change along `A → Ā` of an object of the category of Stacks 0AL4 which is
rig-étale over `(A, I)` is rig-étale over `(Ā, Ī)`.

## Main definitions

* `Rig.quotientPowSubIdeal`: the ideal `Ī` of `A ⧸ (a^m)`.
* `Rig.quotientPowBaseChange`: the completed base change functor along `A → A ⧸ (a^m)` from
  `(A, I)` to `(Ā, Ī)`.

## Main results

* `Rig.zeroLocus_map_span_insert_eq`: `V(I Ā) = V(Ī)`.
* `Rig.exists_pow_map_span_insert_le_quotientPowSubIdeal`: a positive power of `I` maps into `Ī`.
* `Rig.isRigEtale_completedBaseChange_quotient_span_pow`: the completed base change of a
  rig-étale object along `A → A ⧸ (a^m)` is rig-étale.
* `Rig.exists_finiteType_algEquiv_of_isRigEtale_of_card_le_one`: if `I` is generated by at most
  one element, a rig-étale object over `(A, I)` is the `I`-adic completion of a finite type
  `A`-algebra.

## References

* [Stacks Project, Tag 0AKA](https://stacks.math.columbia.edu/tag/0AKA)
* [Stacks Project, Tag 0GB2](https://stacks.math.columbia.edu/tag/0GB2)
* [Stacks Project, Tag 0AK0](https://stacks.math.columbia.edu/tag/0AK0)
* [Stacks Project, Tag 0AL4](https://stacks.math.columbia.edu/tag/0AL4)
* [Stacks Project, Tag 0ALT](https://stacks.math.columbia.edu/tag/0ALT)
-/

@[expose] public noncomputable section

open CategoryTheory

namespace Rig

universe u v

section GeneratorDrop

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

/-- The ideal `Ī` of `A ⧸ (a^m)` generated by the image of `s`. -/
public abbrev quotientPowSubIdeal (s : Finset A) (a : A) (m : ℕ) :
    Ideal (A ⧸ Ideal.span {a ^ m}) :=
  Ideal.span (Ideal.Quotient.mk (Ideal.span {a ^ m}) '' (s : Set A))

omit [IsNoetherianRing A] in
/-- The image of `a` in `A ⧸ (a^m)` is nilpotent, so it lies in the radical of every ideal. -/
public theorem quotientMk_mem_radical (a : A) {m : ℕ} (_hm : 0 < m)
    (J : Ideal (A ⧸ Ideal.span {a ^ m})) :
    Ideal.Quotient.mk (Ideal.span {a ^ m}) a ∈ J.radical := by
  refine ⟨m, ?_⟩
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)]
  exact J.zero_mem

omit [IsNoetherianRing A] in
/-- `Ī` is contained in the image of `I = (s ∪ {a})` in `A ⧸ (a^m)`. -/
public theorem quotientPowSubIdeal_le_map_span_insert (s : Finset A) (a : A) (m : ℕ) :
    quotientPowSubIdeal s a m ≤
      (Ideal.span (insert a (s : Set A))).map (Ideal.Quotient.mk (Ideal.span {a ^ m})) := by
  rw [Ideal.span_le]
  rintro x ⟨y, hy, rfl⟩
  exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ hy))

omit [IsNoetherianRing A] in
/-- The image of `I = (s ∪ {a})` in `A ⧸ (a^m)` is contained in the radical of `Ī`. -/
public theorem map_span_insert_le_radical_quotientPowSubIdeal (s : Finset A) (a : A) {m : ℕ}
    (hm : 0 < m) :
    (Ideal.span (insert a (s : Set A))).map (Ideal.Quotient.mk (Ideal.span {a ^ m})) ≤
      (quotientPowSubIdeal s a m).radical := by
  rw [Ideal.map_span, Ideal.span_le]
  rintro x ⟨y, hy, rfl⟩
  rcases hy with rfl | hy
  · exact quotientMk_mem_radical y hm _
  · exact Ideal.le_radical (Ideal.subset_span ⟨y, hy, rfl⟩)

omit [IsNoetherianRing A] in
/-- `V(I Ā) = V(Ī)` in `Ā = A ⧸ (a^m)`, for `I = (s ∪ {a})` and `m > 0`. -/
public theorem zeroLocus_map_span_insert_eq (s : Finset A) (a : A) {m : ℕ} (hm : 0 < m) :
    PrimeSpectrum.zeroLocus
        (((Ideal.span (insert a (s : Set A))).map
          (Ideal.Quotient.mk (Ideal.span {a ^ m})) : Ideal (A ⧸ Ideal.span {a ^ m})) :
          Set (A ⧸ Ideal.span {a ^ m})) =
      PrimeSpectrum.zeroLocus ((quotientPowSubIdeal s a m : Ideal (A ⧸ Ideal.span {a ^ m})) :
        Set (A ⧸ Ideal.span {a ^ m})) := by
  refine Set.Subset.antisymm
    (PrimeSpectrum.zeroLocus_anti_mono_ideal
      (quotientPowSubIdeal_le_map_span_insert s a m)) ?_
  rw [← PrimeSpectrum.zeroLocus_radical (quotientPowSubIdeal s a m)]
  exact PrimeSpectrum.zeroLocus_anti_mono_ideal
    (map_span_insert_le_radical_quotientPowSubIdeal s a hm)

/-- A positive power of `I = (s ∪ {a})` maps into `Ī` in `A ⧸ (a^m)`. -/
public theorem exists_pow_map_span_insert_le_quotientPowSubIdeal (s : Finset A) (a : A) {m : ℕ}
    (hm : 0 < m) :
    ∃ c : ℕ, 0 < c ∧
      ((Ideal.span (insert a (s : Set A))) ^ c).map
          (Ideal.Quotient.mk (Ideal.span {a ^ m})) ≤ quotientPowSubIdeal s a m := by
  obtain ⟨c, hc⟩ := Ideal.exists_pow_le_of_le_radical_of_fg
    (map_span_insert_le_radical_quotientPowSubIdeal s a hm)
    (Ideal.fg_of_isNoetherianRing _)
  refine ⟨c + 1, c.succ_pos, ?_⟩
  rw [Ideal.map_pow]
  exact (Ideal.pow_le_pow_right c.le_succ).trans hc

/-- The completed base change functor of Stacks 0AK0 along `A → A ⧸ (a^m)`, from `(A, I)` with
`I = (s ∪ {a})` to `(Ā, Ī)` with `Ī` generated by the image of `s`. -/
public def quotientPowBaseChange (s : Finset A) (a : A) {m : ℕ} (hm : 0 < m) :
    CompletedBaseChange (A₁ := A) (A₂ := A ⧸ Ideal.span {a ^ m})
      (I₁ := Ideal.span (insert a (s : Set A))) (I₂ := quotientPowSubIdeal s a m) :=
  completedBaseChange _ _ _
    (exists_pow_map_span_insert_le_quotientPowSubIdeal s a hm).choose_spec.1
    (exists_pow_map_span_insert_le_quotientPowSubIdeal s a hm).choose_spec.2
    (Ideal.fg_of_isNoetherianRing _)

/-- Let `A` be a Noetherian ring, let `I = (s ∪ {a})` and let `B` be an object of the category of
Stacks 0AL4 over `(A, I)` which is rig-étale over `(A, I)`.  Then the completed base change of `B`
along `A → A ⧸ (a^m)` is rig-étale over `(Ā, Ī)`, where `Ī` is generated by the image of `s` — an
ideal with one generator fewer than `I`. -/
public theorem isRigEtale_completedBaseChange_quotient_span_pow (s : Finset A) (a : A) {m : ℕ}
    (hm : 0 < m)
    (C : CompletedBaseChange (A₁ := A) (A₂ := A ⧸ Ideal.span {a ^ m})
      (I₁ := Ideal.span (insert a (s : Set A))) (I₂ := quotientPowSubIdeal s a m))
    (B : AdicFiniteTypeAlgebra.{u, v} A (Ideal.span (insert a (s : Set A))))
    (hB : IsRigEtale B) :
    IsRigEtale (C.functor.obj B) :=
  isRigEtale_completedBaseChangeFunctor (zeroLocus_map_span_insert_eq s a hm) C B hB

/-! ### Ideals generated by at most one element -/

omit [IsNoetherianRing A] in
/-- The span of a finite set with at most one element is principal. -/
public theorem isPrincipal_span_of_card_le_one {s : Finset A} (hs : s.card ≤ 1) :
    (Ideal.span (s : Set A)).IsPrincipal := by
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hs with h | h
  · obtain rfl := Finset.card_eq_zero.mp h
    exact ⟨⟨0, by simp⟩⟩
  · obtain ⟨x, rfl⟩ := Finset.card_eq_one.mp h
    exact ⟨⟨x, by simp⟩⟩

/-- If `I` is the span of a finite set with at most one element, a rig-étale object over `(A, I)`
is the `I`-adic completion of a finite type `A`-algebra. -/
public theorem exists_finiteType_algEquiv_of_isRigEtale_of_card_le_one {s : Finset A}
    (hs : s.card ≤ 1) (B : AdicFiniteTypeAlgebra.{u, v} A (Ideal.span (s : Set A)))
    (hB : IsRigEtale B) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
      Algebra.FiniteType A C ∧
        Nonempty (B.carrier ≃ₐ[A]
          AdicCompletion ((Ideal.span (s : Set A)).map (algebraMap A C)) C) :=
  exists_finiteType_algEquiv_of_isRigEtale_principal (isPrincipal_span_of_card_le_one hs) B hB

end GeneratorDrop

end Rig

end
