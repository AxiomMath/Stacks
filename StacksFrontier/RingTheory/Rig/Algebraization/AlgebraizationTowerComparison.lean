/-!
# Comparing algebras modulo powers of an ideal

Auxiliary results for the last step of the proof of Stacks 0AKA
(`Rig.AlgebraizationTower.exists_algebraization`).

For an ideal `𝔞` of a ring `A`, an `A`-algebra map `f : X → Y` *is bijective modulo `𝔞`* if the
induced map `X ⧸ 𝔞X → Y ⧸ 𝔞Y` is bijective (`Rig.IsBijectiveMod`, stated elementwise).  This
property is stable under composition, under cancellation (up to congruence modulo `𝔞`), and
under enlarging `𝔞`; it holds for isomorphisms, for surjections whose kernel lies in `𝔞X`,
and, for every power of `𝔟`, for the map `C → C^∧` into the `𝔟`-adic completion.  If an
`A`-algebra map into an `I`-adically complete algebra `Y` is bijective modulo every power of `I`,
then `Y` is the `I`-adic completion of its source (`Rig.nonempty_algEquiv_adicCompletion`).

Finally, an `A`-algebra isomorphism `S ≅ S'` of algebras over a quotient `A ⧸ K` transports the
annihilation of `H¹(L_{S'/(A/K)})` and of `Ω_{S'/(A/K)}` by an element of `A` to `S`.
-/

@[expose] public section

namespace Rig

variable {A : Type*} [CommRing A]

section IsBijectiveMod

variable {X Y Z : Type*} [CommRing X] [CommRing Y] [CommRing Z] [Algebra A X] [Algebra A Y]
  [Algebra A Z]

/-- An `A`-algebra map `f : X → Y` is *bijective modulo* an ideal `𝔞` of `A` when the induced
map `X ⧸ 𝔞X → Y ⧸ 𝔞Y` is bijective; stated elementwise: every element of `Y` is congruent to
an element of the image of `f` modulo `𝔞Y`, and `f x ∈ 𝔞Y` forces `x ∈ 𝔞X`. -/
def IsBijectiveMod (𝔞 : Ideal A) (f : X →ₐ[A] Y) : Prop :=
  (∀ y, ∃ x, y - f x ∈ 𝔞.map (algebraMap A Y)) ∧
    ∀ x, f x ∈ 𝔞.map (algebraMap A Y) → x ∈ 𝔞.map (algebraMap A X)

/-- The ideal generated by `𝔞` is carried into the ideal generated by `𝔞`. -/
theorem map_map_algebraMap (𝔞 : Ideal A) (f : X →ₐ[A] Y) :
    (𝔞.map (algebraMap A X)).map (f : X →+* Y) = 𝔞.map (algebraMap A Y) := by
  rw [Ideal.map_map, AlgHom.comp_algebraMap]

/-- A map of `A`-algebras carries `𝔞X` into `𝔞Y`. -/
theorem map_mem_map_algebraMap {𝔞 : Ideal A} (f : X →ₐ[A] Y) {x : X}
    (hx : x ∈ 𝔞.map (algebraMap A X)) : f x ∈ 𝔞.map (algebraMap A Y) := by
  rw [← map_map_algebraMap 𝔞 f]
  exact Ideal.mem_map_of_mem _ hx

namespace IsBijectiveMod

variable {𝔞 : Ideal A}

/-- A composite of maps bijective modulo `𝔞` is bijective modulo `𝔞`. -/
theorem comp {f : X →ₐ[A] Y} {g : Y →ₐ[A] Z} (hg : IsBijectiveMod 𝔞 g)
    (hf : IsBijectiveMod 𝔞 f) : IsBijectiveMod 𝔞 (g.comp f) := by
  refine ⟨fun z => ?_, fun x hx => hf.2 x (hg.2 _ hx)⟩
  obtain ⟨y, hy⟩ := hg.1 z
  obtain ⟨x, hx⟩ := hf.1 y
  refine ⟨x, ?_⟩
  have h := Ideal.add_mem _ hy (map_mem_map_algebraMap g hx)
  rw [map_sub] at h
  simpa using h

/-- If `ψ ≡ g ∘ f` modulo `𝔞` and both `ψ` and `g` are bijective modulo `𝔞`, so is `f`. -/
theorem of_comp {f : X →ₐ[A] Y} {g : Y →ₐ[A] Z} {ψ : X →ₐ[A] Z} (hg : IsBijectiveMod 𝔞 g)
    (hψ : IsBijectiveMod 𝔞 ψ) (h : ∀ x, g (f x) - ψ x ∈ 𝔞.map (algebraMap A Z)) :
    IsBijectiveMod 𝔞 f := by
  refine ⟨fun y => ?_, fun x hx => hψ.2 x ?_⟩
  · obtain ⟨x, hx⟩ := hψ.1 (g y)
    refine ⟨x, hg.2 _ ?_⟩
    have h' := Ideal.sub_mem _ hx (h x)
    rw [map_sub]
    convert h' using 1
    ring
  · have h' := Ideal.sub_mem _ (map_mem_map_algebraMap g hx) (h x)
    simpa using h'

/-- An isomorphism is bijective modulo every ideal. -/
theorem of_algEquiv (e : X ≃ₐ[A] Y) : IsBijectiveMod 𝔞 (e : X →ₐ[A] Y) := by
  refine ⟨fun y => ⟨e.symm y, by simp⟩, fun x hx => ?_⟩
  have h := map_mem_map_algebraMap (e.symm : Y →ₐ[A] X) hx
  simpa using h

/-- A surjection whose kernel lies in `𝔞X` is bijective modulo `𝔞`. -/
theorem of_surjective {f : X →ₐ[A] Y} (hf : Function.Surjective f)
    (hker : RingHom.ker (f : X →+* Y) ≤ 𝔞.map (algebraMap A X)) : IsBijectiveMod 𝔞 f := by
  refine ⟨fun y => ?_, fun x hx => ?_⟩
  · obtain ⟨x, rfl⟩ := hf y
    exact ⟨x, by simp⟩
  · rw [← map_map_algebraMap 𝔞 f] at hx
    obtain ⟨u, hu, hux⟩ := (Ideal.mem_map_iff_of_surjective _ hf).1 hx
    have hmem : x - u ∈ RingHom.ker (f : X →+* Y) := by
      rw [RingHom.mem_ker, map_sub, AlgHom.coe_toRingHom, hux, sub_self]
    have := Ideal.add_mem _ (hker hmem) hu
    simpa using this

/-- Bijectivity modulo `𝔟` implies bijectivity modulo any larger ideal `𝔞`. -/
theorem mono {𝔟 : Ideal A} {f : X →ₐ[A] Y} (hf : IsBijectiveMod 𝔟 f) (h𝔟 : 𝔟 ≤ 𝔞) :
    IsBijectiveMod 𝔞 f := by
  refine ⟨fun y => ?_, fun x hx => ?_⟩
  · obtain ⟨x, hx⟩ := hf.1 y
    exact ⟨x, Ideal.map_mono h𝔟 hx⟩
  · set q := Ideal.Quotient.mk (𝔟.map (algebraMap A Y))
    set g : X →+* Y ⧸ 𝔟.map (algebraMap A Y) := q.comp (f : X →+* Y)
    have hg : Function.Surjective g := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨x, hx⟩ := hf.1 y
      exact ⟨x, ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).2 hx).symm⟩
    have hq : q (f x) ∈ (𝔞.map (algebraMap A X)).map g := by
      rw [← Ideal.map_map, map_map_algebraMap]
      exact Ideal.mem_map_of_mem q hx
    obtain ⟨u, hu, hux⟩ := (Ideal.mem_map_iff_of_surjective g hg).1 hq
    have hsub : x - u ∈ 𝔟.map (algebraMap A X) := by
      refine hf.2 _ ?_
      rw [map_sub, ← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      exact hux.symm
    have := Ideal.add_mem _ (Ideal.map_mono h𝔟 hsub) hu
    simpa using this

end IsBijectiveMod

end IsBijectiveMod

section Completion

variable {C : Type*} [CommRing C] [Algebra A C]

/-- The canonical map from an `A`-algebra `C` to an adic completion of `C`, as a map of
`A`-algebras. -/
noncomputable def toAdicCompletionAlgHom (K : Ideal C) : C →ₐ[A] AdicCompletion K C where
  toRingHom := algebraMap C (AdicCompletion K C)
  commutes' _ := rfl

/-- `Rig.toAdicCompletionAlgHom` is the algebra map into the completion. -/
@[simp] theorem toAdicCompletionAlgHom_apply (K : Ideal C) (c : C) :
    toAdicCompletionAlgHom (A := A) K c = algebraMap C (AdicCompletion K C) c := rfl

/-- The map from `C` to its `𝔟`-adic completion is bijective modulo every power of `𝔟`, if `𝔟C`
is finitely generated. -/
theorem isBijectiveMod_toAdicCompletionAlgHom (𝔟 : Ideal A)
    (h𝔟 : (𝔟.map (algebraMap A C)).FG) (m : ℕ) :
    IsBijectiveMod (𝔟 ^ m) (toAdicCompletionAlgHom (A := A) (𝔟.map (algebraMap A C))) := by
  set K := 𝔟.map (algebraMap A C)
  have hker : RingHom.ker (AdicCompletion.evalₐ K m).toRingHom =
      (𝔟 ^ m).map (algebraMap A (AdicCompletion K C)) := by
    rw [AdicCompletion.ker_evalₐ_eq_map_pow K h𝔟 m, Ideal.map_pow, Ideal.map_pow,
      Ideal.map_map]
    rfl
  have heval : ∀ c : C, AdicCompletion.evalₐ K m (algebraMap C (AdicCompletion K C) c) =
      Ideal.Quotient.mk (K ^ m) c := fun c =>
    (AdicCompletion.evalₐ K m).commutes c
  refine ⟨fun y => ?_, fun c hc => ?_⟩
  · obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ K m y)
    refine ⟨c, ?_⟩
    rw [← hker, RingHom.mem_ker]
    show AdicCompletion.evalₐ K m (y - algebraMap C _ c) = 0
    rw [map_sub, heval, hc, sub_self]
  · rw [← hker, RingHom.mem_ker] at hc
    change AdicCompletion.evalₐ K m (algebraMap C _ c) = 0 at hc
    rw [heval, Ideal.Quotient.eq_zero_iff_mem, ← Ideal.map_pow] at hc
    exact hc

end Completion

section Comparison

/-- **Recognising an adic completion.**  Let `f : X → Y` be a map of `A`-algebras with `Y`
`I`-adically complete.  If `f` is bijective modulo every power of `I`, then `Y` is the `I`-adic
completion of `X`. -/
theorem nonempty_algEquiv_adicCompletion (I : Ideal A) {X Y : Type*} [CommRing X] [CommRing Y]
    [Algebra A X] [Algebra A Y] (f : X →ₐ[A] Y)
    (hY : IsAdicComplete (I.map (algebraMap A Y)) Y) (hf : ∀ n, IsBijectiveMod (I ^ n) f) :
    Nonempty (Y ≃ₐ[A] AdicCompletion (I.map (algebraMap A X)) X) := by
  set K := I.map (algebraMap A X)
  have hK : K.map (f : X →+* Y) = I.map (algebraMap A Y) := map_map_algebraMap I f
  have hKn : ∀ n, (K ^ n).map (f : X →+* Y) = (I ^ n).map (algebraMap A Y) := fun n => by
    rw [← Ideal.map_pow, map_map_algebraMap]
  have hbij : ∀ n, Function.Bijective
      (Ideal.quotientMap ((K ^ n).map (f : X →+* Y)) (f : X →+* Y) Ideal.le_comap_map) := by
    intro n
    refine ⟨Ideal.quotientMap_injective' fun x hx => ?_, fun z => ?_⟩
    · rw [Ideal.mem_comap, hKn] at hx
      rw [← Ideal.map_pow]
      exact (hf n).2 x hx
    · obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨x, hx⟩ := (hf n).1 y
      refine ⟨Ideal.Quotient.mk _ x, ?_⟩
      rw [Ideal.quotientMap_mk, Ideal.Quotient.mk_eq_mk_iff_sub_mem, hKn, ← neg_sub]
      exact (Ideal.neg_mem_iff _).2 hx
  have : IsAdicComplete (K.map (f : X →+* Y)) Y := by rw [hK]; exact hY
  let e₁ : AdicCompletion K X ≃+* AdicCompletion (K.map (f : X →+* Y)) Y :=
    RingEquiv.ofBijective _
      (Stacks.AdicCompletion.adicCompletionMap_bijective_of_quotientMap_bijective _ K hbij)
  have he₁ : ∀ a : A, e₁ (algebraMap A (AdicCompletion K X) a) =
      AdicCompletion.ofAlgEquiv (K.map (f : X →+* Y)) (algebraMap A Y a) := by
    intro a
    have h := DFunLike.congr_fun
      (adicCompletionMap_comp_algebraMap (f : X →+* Y) K (K.map (f : X →+* Y)) le_rfl)
      (algebraMap A X a)
    simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.commutes] at h
    exact h
  refine ⟨AlgEquiv.ofRingEquiv
    (f := (AdicCompletion.ofAlgEquiv (K.map (f : X →+* Y))).toRingEquiv.trans e₁.symm)
    fun a => ?_⟩
  apply e₁.injective
  simp only [RingEquiv.coe_trans, Function.comp_apply, RingEquiv.apply_symm_apply, he₁]
  rfl

end Comparison

section Cotangent

/-- An `A`-algebra isomorphism of algebras over `A ⧸ K` commutes with the maps from `A ⧸ K`. -/
private theorem algEquiv_algebraMap_quotient {K : Ideal A} {S S' : Type*} [CommRing S]
    [CommRing S'] [Algebra A S] [Algebra A S'] [Algebra (A ⧸ K) S] [IsScalarTower A (A ⧸ K) S]
    [Algebra (A ⧸ K) S'] [IsScalarTower A (A ⧸ K) S'] (e : S ≃ₐ[A] S') (r : A ⧸ K) :
    e (algebraMap (A ⧸ K) S r) = algebraMap (A ⧸ K) S' r := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
  change e (algebraMap (A ⧸ K) S (algebraMap A (A ⧸ K) r)) =
    algebraMap (A ⧸ K) S' (algebraMap A (A ⧸ K) r)
  rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  exact e.commutes r

/-- **Transport of the annihilation of `H¹(L)` along an isomorphism.**  Let `S` and `S'` be
algebras over `A ⧸ K` and `A ⧸ K'` with `K = K'`, and `S ≅ S'` as `A`-algebras.  If the image of
`x ∈ A` kills `H¹(L_{S'/(A/K')})`, then it kills `H¹(L_{S/(A/K)})`. -/
theorem algebraMap_mem_annihilator_h1Cotangent_of_algEquiv {K K' : Ideal A} (hK : K = K')
    {S S' : Type*} [CommRing S] [CommRing S'] [Algebra A S] [Algebra A S'] [Algebra (A ⧸ K) S]
    [IsScalarTower A (A ⧸ K) S] [Algebra (A ⧸ K') S'] [IsScalarTower A (A ⧸ K') S']
    (e : S ≃ₐ[A] S') (x : A)
    (h : algebraMap A S' x ∈ Module.annihilator S' (Algebra.H1Cotangent (A ⧸ K') S')) :
    algebraMap A S x ∈ Module.annihilator S (Algebra.H1Cotangent (A ⧸ K) S) := by
  subst hK
  let e' : S ≃ₐ[A ⧸ K] S' :=
    { e.toRingEquiv with
      commutes' := algEquiv_algebraMap_quotient e }
  let φ := Algebra.H1Cotangent.mapEquiv (A ⧸ K) S' S e'.symm
  rw [Module.mem_annihilator] at h ⊢
  intro m
  obtain ⟨m, rfl⟩ := φ.surjective m
  rw [IsScalarTower.algebraMap_apply A (A ⧸ K) S, algebraMap_smul, ← map_smul,
    ← algebraMap_smul S', ← IsScalarTower.algebraMap_apply, h, map_zero]

/-- **Transport of the annihilation of `Ω` along an isomorphism.**  Let `S` and `S'` be algebras
over `A ⧸ K` and `A ⧸ K'` with `K = K'`, and `S ≅ S'` as `A`-algebras.  If the image of `x ∈ A`
kills `Ω_{S'/(A/K')}`, then it kills `Ω_{S/(A/K)}`. -/
theorem algebraMap_mem_annihilator_kaehler_of_algEquiv {K K' : Ideal A} (hK : K = K')
    {S S' : Type*} [CommRing S] [CommRing S'] [Algebra A S] [Algebra A S'] [Algebra (A ⧸ K) S]
    [IsScalarTower A (A ⧸ K) S] [Algebra (A ⧸ K') S'] [IsScalarTower A (A ⧸ K') S']
    (e : S ≃ₐ[A] S') (x : A)
    (h : algebraMap A S' x ∈ Module.annihilator S' Ω[S'⁄A ⧸ K']) :
    algebraMap A S x ∈ Module.annihilator S Ω[S⁄A ⧸ K] := by
  subst hK
  let : Algebra S' S := (e.symm : S' →ₐ[A] S).toRingHom.toAlgebra
  have halg : ∀ s : S', algebraMap S' S s = e.symm s := fun _ => rfl
  have : IsScalarTower (A ⧸ K) S' S :=
    IsScalarTower.of_algebraMap_eq fun r => (algEquiv_algebraMap_quotient e.symm r).symm
  have hsurj : Function.Surjective (algebraMap S' S) := fun s => ⟨e s, by simp [halg]⟩
  rw [Module.mem_annihilator] at h ⊢
  intro m
  obtain ⟨m, rfl⟩ := KaehlerDifferential.map_surjective_of_surjective (A ⧸ K) (A ⧸ K) S' S
    hsurj m
  have hx : algebraMap A S x = algebraMap S' S (algebraMap A S' x) := by
    rw [halg, e.symm.commutes]
  rw [hx, algebraMap_smul, ← map_smul, h, map_zero]

end Cotangent

end Rig

