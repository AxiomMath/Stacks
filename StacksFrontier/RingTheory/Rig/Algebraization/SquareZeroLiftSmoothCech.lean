module

public import StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftSmoothChart
public import StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftSurj
public import StacksFrontier.RingTheory.Localization.Glueing.FormalGlueingComplexH2
import all StacksFrontier.RingTheory.Localization.Glueing.FormalGlueingComplex

/-!
# The Čech complexes of derivations in the smooth square-zero lifting step

In the setting of `StacksFrontier.RingTheory.Rig.Algebraization.SquareZeroLiftData`, the defects
of the charts of the smooth square-zero lifting step are derivations of `S` with values in
`S_s ⊗[R] N` (on the side of the lifts) and in `(S_s ⊗[S] S^∧) ⊗[R] N` (on the side of `H`).
This file identifies these two families, indexed by the finite sets `s` of indices, with the
localizations of the `S`-module `M = Derivation R S (S ⊗[R] N)` and of its base change
`M ⊗[S] S^∧`, and transports the exactness of the glueing complex of `M` at its fourth term
(`FormalGlueing.glueingComplex_exact_fourth`) to them.

## Main definitions

* `Rig.SquareZeroLift.isoV`: the isomorphism `M_s ≃ Derivation R S (S_s ⊗[R] N)`.
* `Rig.SquareZeroLift.isoH`: the isomorphism
  `(M ⊗[S] S^∧)_s ≃ Derivation R S ((S_s ⊗[S] S^∧) ⊗[R] N)`.

## Main results

* `Rig.SquareZeroLift.exists_family_correction`: a pair `(D, E)` of a family of `S^∧`-side
  derivations on pairs and of `S`-side derivations on triples with `dD = E ⊗ 1` and `dE = 0`
  is `(d y - x ⊗ 1, -d x)` for families `y` on singletons and `x` on pairs.
-/

@[expose] public section

namespace Rig.SquareZeroLift

open TensorProduct Cech FormalGlueing

universe u

variable {R : Type u} [CommRing R] (N : Ideal R)
variable {k : ℕ} (f : Fin k → R)
variable (S : Type u) [CommRing S] [Algebra R S]

/-! ### The families -/

/-- The localization `S_s → S_t` as an `S`-linear map. -/
noncomputable def locSL {s t : Finset (Fin k)} (h : s ⊆ t) : Sl f S s →ₗ[S] Sl f S t :=
  (IsLocalization.Away.liftAlgHom (algebraMap R S (rs f s)) (f := Algebra.ofId S (Sl f S t))
    (IsLocalization.Away.isUnit_of_dvd _ (map_dvd _ (rs_dvd f h)))).toLinearMap

/-- `locSL f S h` agrees with the localization map `locS f S h`. -/
theorem locSL_apply {s t : Finset (Fin k)} (h : s ⊆ t) (x : Sl f S s) :
    locSL f S h x = locS f S h x := rfl

/-- The `S`-side family: derivations of `S` into `S_s ⊗[R] N`. -/
abbrev derV (s : Finset (Fin k)) := Derivation R S (Sl f S s ⊗[R] N)

/-- The `S^∧`-side family: derivations of `S` into `(S_s ⊗[S] S^∧) ⊗[R] N`. -/
abbrev derH (s : Finset (Fin k)) := Derivation R S ((Sl f S s ⊗[S] Sh f S) ⊗[R] N)

/-- The transition maps of the `S`-side family. -/
noncomputable def derιV {s t : Finset (Fin k)} (h : s ⊆ t) : derV N f S s →+ derV N f S t :=
  (Derivation.llcomp (R := R) (A := S)
    (AlgebraTensorModule.rTensor R N (locSL f S h))).toAddMonoidHom

/-- The transition maps of the `S^∧`-side family. -/
noncomputable def derιH {s t : Finset (Fin k)} (h : s ⊆ t) : derH N f S s →+ derH N f S t :=
  (Derivation.llcomp (R := R) (A := S)
    (AlgebraTensorModule.rTensor R N ((locSL f S h).rTensor (Sh f S)))).toAddMonoidHom

/-- The map from the `S`-side family to the `S^∧`-side family, `x ⊗ n ↦ (x ⊗ 1) ⊗ n`. -/
noncomputable def derT (s : Finset (Fin k)) : derV N f S s →+ derH N f S s :=
  (Derivation.llcomp (R := R) (A := S)
    (AlgebraTensorModule.rTensor R N
      (Algebra.TensorProduct.includeLeft (R := S) (S := S) (A := Sl f S s)
        (B := Sh f S)).toLinearMap)).toAddMonoidHom

/-- The transition map `derιV N f S h` sends `D` to the composite of `D` with the localization
`S_s ⊗[R] N → S_t ⊗[R] N`. -/
theorem derιV_apply {s t : Finset (Fin k)} (h : s ⊆ t) (D : derV N f S s) (v : S) :
    derιV N f S h D v = (locS f S h).toLinearMap.rTensor N (D v) := by
  show AlgebraTensorModule.rTensor R N (locSL f S h) (D v) = _
  induction D v using TensorProduct.induction_on with
  | zero => simp
  | tmul x n => rfl
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-! ### The module of derivations and its localizations -/

/-- The `S`-module `M = Derivation R S (S ⊗[R] N)`. -/
abbrev derM := Derivation R S (S ⊗[R] N)

/-- The map `M → X_s`. -/
noncomputable def derΦV (s : Finset (Fin k)) : derM N S →ₗ[S] derV N f S s :=
  Derivation.llcomp (R := R) (A := S)
    (AlgebraTensorModule.rTensor R N (Algebra.linearMap S (Sl f S s)))

/-- The Čech submonoid of `gS f S` at `s` is generated by the image of the product `rs f s`. -/
theorem cechSub_gS (s : Finset (Fin k)) :
    cechSub (gS f S) s = Submonoid.powers (algebraMap R S (rs f s)) := by
  rw [cechSub, prod_gS]

/-- The algebra map `S → S_s` is a localization of `S`-modules at the powers of `rs f s`. -/
instance isLocalizedModule_algebraMap_Sl (s : Finset (Fin k)) :
    IsLocalizedModule (Submonoid.powers (algebraMap R S (rs f s)))
      (Algebra.linearMap S (Sl f S s)) :=
  inferInstanceAs (IsLocalizedModule _ (IsScalarTower.toAlgHom S S (Sl f S s)).toLinearMap)

/-- If `Ω[S⁄R]` is finitely presented, then `derΦV N f S s : M → X_s` is a localization at the
Čech submonoid of `s`. -/
theorem isLocalizedModule_derΦV [Module.FinitePresentation S Ω[S⁄R]] (s : Finset (Fin k)) :
    IsLocalizedModule (cechSub (gS f S) s) (derΦV N f S s) := by
  rw [cechSub_gS]
  exact isLocalizedModule_llcomp R _ _

/-- If `Ω[S⁄R]` is finitely presented, then `derΦV N f S s : M → X_s` is a localization at the
submonoid generated by the elements `gS f S i` with `i ∈ s`. -/
theorem isLocalizedModule_closure_derΦV [Module.FinitePresentation S Ω[S⁄R]]
    (s : Finset (Fin k)) :
    IsLocalizedModule (Submonoid.closure (gS f S '' (s : Set (Fin k)))) (derΦV N f S s) :=
  have := isLocalizedModule_derΦV N f S s
  IsLocalizedModule.of_exists_mul_mem _ _ (cechSub_le_closure (gS f S) le_rfl) dvd_pow_prod _

/-- The map `(S ⊗[R] N) ⊗[S] S^∧ → (S_s ⊗[S] S^∧) ⊗[R] N`. -/
noncomputable def gH (s : Finset (Fin k)) :
    (S ⊗[R] N) ⊗[S] Sh f S →ₗ[S] (Sl f S s ⊗[S] Sh f S) ⊗[R] N :=
  (AlgebraTensorModule.rTensor R N (TensorProduct.mk S (Sl f S s) (Sh f S) 1)) ∘ₗ
    ((TensorProduct.comm S (S ⊗[R] N) (Sh f S)).trans
      ((AlgebraTensorModule.cancelBaseChange R S (Sh f S) (Sh f S) N).restrictScalars
        S)).toLinearMap

/-- `gH` sends `(c ⊗ n) ⊗ x` to `(1 ⊗ c • x) ⊗ n`. -/
theorem gH_tmul (c : S) (n : N) (x : Sh f S) (s : Finset (Fin k)) :
    gH N f S s ((c ⊗ₜ n) ⊗ₜ x) = (1 ⊗ₜ (c • x)) ⊗ₜ n := by
  simp [gH]

/-- The map `gH N f S s` is a localization of `S`-modules at the powers of `rs f s`. -/
theorem isLocalizedModule_gH (s : Finset (Fin k)) :
    IsLocalizedModule (Submonoid.powers (algebraMap R S (rs f s))) (gH N f S s) := by
  have : IsLocalizedModule (Submonoid.powers (algebraMap R S (rs f s)))
      (TensorProduct.mk S (Sl f S s) (Sh f S) 1) :=
    (isLocalizedModule_iff_isBaseChange (Submonoid.powers (algebraMap R S (rs f s)))
      (Sl f S s) _).mpr (TensorProduct.isBaseChange S (Sh f S) (Sl f S s))
  exact IsLocalizedModule.of_linearEquiv_right _ _ _

/-- The map `M ⊗[S] S^∧ → X^∧_s`. -/
noncomputable def derΦH (s : Finset (Fin k)) : derM N S ⊗[S] Sh f S →ₗ[S] derH N f S s :=
  Derivation.llcomp (R := R) (A := S) (gH N f S s) ∘ₗ
    derivationBaseChange R S (Sh f S) (S ⊗[R] N)

/-- If `S` is Noetherian and `Ω[S⁄R]` is finitely presented, then
`derΦH N f S s : M ⊗[S] S^∧ → X^∧_s` is a localization at the Čech submonoid of `s`. -/
theorem isLocalizedModule_derΦH [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S]
    (s : Finset (Fin k)) : IsLocalizedModule (cechSub (gS f S) s) (derΦH N f S s) := by
  have := flat_Sh f S
  have := isLocalizedModule_gH N f S s
  have hb := bijective_derivationBaseChange R S (Sh f S) (S ⊗[R] N)
  have : IsLocalizedModule (Submonoid.powers (algebraMap R S (rs f s)))
      (Derivation.llcomp (R := R) (A := S) (gH N f S s)) := isLocalizedModule_llcomp R _ _
  rw [cechSub_gS]
  exact IsLocalizedModule.of_linearEquiv_right _ _ (LinearEquiv.ofBijective _ hb)

/-- If `S` is Noetherian and `Ω[S⁄R]` is finitely presented, then
`derΦH N f S s : M ⊗[S] S^∧ → X^∧_s` is a localization at the submonoid generated by the
elements `gS f S i` with `i ∈ s`. -/
theorem isLocalizedModule_closure_derΦH [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S]
    (s : Finset (Fin k)) :
    IsLocalizedModule (Submonoid.closure (gS f S '' (s : Set (Fin k)))) (derΦH N f S s) :=
  have := isLocalizedModule_derΦH N f S s
  IsLocalizedModule.of_exists_mul_mem _ _ (cechSub_le_closure (gS f S) le_rfl) dvd_pow_prod _

/-- If `iso s : M_s ≃ X_s` is compatible with maps `φ s : M → X_s`, the `φ t` are localizations
and `ψ` is compatible with the `φ`, then `iso` intertwines `cechι` with `ψ`. -/
private theorem iso_cechι_apply {M : Type*} [AddCommGroup M] [Module S M]
    {X : Finset (Fin k) → Type*} [∀ s, AddCommGroup (X s)] [∀ s, Module S (X s)]
    (iso : ∀ s, cechMod (gS f S) M s ≃ₗ[S] X s) (φ : ∀ s, M →ₗ[S] X s)
    (hmk : ∀ s m, iso s (LocalizedModule.mkLinearMap _ _ m) = φ s m)
    (ψ : ∀ s t : Finset (Fin k), s ⊆ t → X s →ₗ[S] X t)
    (hψ : ∀ (s t : Finset (Fin k)) (h : s ⊆ t) m, ψ s t h (φ s m) = φ t m)
    {s t : Finset (Fin k)} (h : s ⊆ t) [IsLocalizedModule (Submonoid.closure (gS f S '' t)) (φ t)]
    (z : cechMod (gS f S) M s) : iso t (cechι (gS f S) M h z) = ψ s t h (iso s z) := by
  have key : (iso t).toLinearMap ∘ₗ cechι (gS f S) M h = ψ s t h ∘ₗ (iso s).toLinearMap := by
    apply IsLocalizedModule.ext (cechSub (gS f S) s)
      (LocalizedModule.mkLinearMap (cechSub (gS f S) s) M)
      (Cech.isUnit_algebraMap (gS f S) M h (φ t))
    refine LinearMap.ext fun m ↦ ?_
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply]
    rw [cechι_mk, hmk, hmk, hψ]
  exact LinearMap.congr_fun key z

/-! ### The identifications with the localizations -/

variable [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S]

/-- `M_s ≅ X_s`. -/
noncomputable def isoV (s : Finset (Fin k)) : cechMod (gS f S) (derM N S) s ≃ₗ[S] derV N f S s :=
  haveI := isLocalizedModule_derΦV N f S s
  IsLocalizedModule.iso (cechSub (gS f S) s) (derΦV N f S s)

/-- `(M ⊗[S] S^∧)_s ≅ X^∧_s`. -/
noncomputable def isoH (s : Finset (Fin k)) :
    cechMod (gS f S) (derM N S ⊗[S] Sh f S) s ≃ₗ[S] derH N f S s :=
  haveI := isLocalizedModule_derΦH N f S s
  IsLocalizedModule.iso (cechSub (gS f S) s) (derΦH N f S s)

omit [IsNoetherianRing S] in
/-- `isoV` sends the class of `m ∈ M` to `derΦV N f S s m`. -/
theorem isoV_mk (s : Finset (Fin k)) (m : derM N S) :
    isoV N f S s (LocalizedModule.mkLinearMap _ _ m) = derΦV N f S s m := by
  have := isLocalizedModule_derΦV N f S s
  simp [isoV]

/-- `isoH` sends the class of `m ∈ M ⊗[S] S^∧` to `derΦH N f S s m`. -/
theorem isoH_mk (s : Finset (Fin k)) (m : derM N S ⊗[S] Sh f S) :
    isoH N f S s (LocalizedModule.mkLinearMap _ _ m) = derΦH N f S s m := by
  have := isLocalizedModule_derΦH N f S s
  simp [isoH]

omit [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S] in
/-- The composite `S ⊗[R] N → S_s ⊗[R] N → S_t ⊗[R] N` is the map induced by `S → S_t`. -/
theorem rTensor_locSL_algebraMap {s t : Finset (Fin k)} (h : s ⊆ t) (z : S ⊗[R] N) :
    AlgebraTensorModule.rTensor R N (locSL f S h)
        (AlgebraTensorModule.rTensor R N (Algebra.linearMap S (Sl f S s)) z) =
      AlgebraTensorModule.rTensor R N (Algebra.linearMap S (Sl f S t)) z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul c n =>
    simp only [AlgebraTensorModule.rTensor_tmul, Algebra.linearMap_apply, locSL_apply,
      locS_algebraMap]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]

omit [IsNoetherianRing S] in
/-- The identifications `isoV` intertwine the Čech transition maps `cechι` of the localizations
of `M` with the transition maps `derιV`. -/
theorem isoV_cechι {s t : Finset (Fin k)} (h : s ⊆ t) (z : cechMod (gS f S) (derM N S) s) :
    isoV N f S t (cechι (gS f S) (derM N S) h z) = derιV N f S h (isoV N f S s z) := by
  have := isLocalizedModule_closure_derΦV N f S t
  exact iso_cechι_apply f S (isoV N f S) (derΦV N f S) (isoV_mk N f S)
    (fun _ _ h ↦ Derivation.llcomp (R := R) (A := S)
      (AlgebraTensorModule.rTensor R N (locSL f S h)))
    (fun _ _ h m ↦ Derivation.ext fun v ↦ rTensor_locSL_algebraMap N f S h (m v)) h z

omit [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S] in
/-- Composing `gH N f S s` with the localization `(S_s ⊗[S] S^∧) ⊗[R] N → (S_t ⊗[S] S^∧) ⊗[R] N`
gives `gH N f S t`. -/
theorem gH_rTensor_locSL {s t : Finset (Fin k)} (h : s ⊆ t) (z : (S ⊗[R] N) ⊗[S] Sh f S) :
    AlgebraTensorModule.rTensor R N ((locSL f S h).rTensor (Sh f S)) (gH N f S s z) =
      gH N f S t z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a x =>
    induction a using TensorProduct.induction_on with
    | zero => simp
    | tmul c n =>
      rw [gH_tmul, gH_tmul, AlgebraTensorModule.rTensor_tmul, LinearMap.rTensor_tmul, locSL_apply,
        map_one]
    | add a b ha hb => rw [TensorProduct.add_tmul, map_add, map_add, ha, hb, map_add]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]

/-- The identifications `isoH` intertwine the Čech transition maps `cechι` of the localizations
of `M ⊗[S] S^∧` with the transition maps `derιH`. -/
theorem isoH_cechι {s t : Finset (Fin k)} (h : s ⊆ t)
    (z : cechMod (gS f S) (derM N S ⊗[S] Sh f S) s) :
    isoH N f S t (cechι (gS f S) (derM N S ⊗[S] Sh f S) h z) = derιH N f S h (isoH N f S s z) := by
  have := isLocalizedModule_closure_derΦH N f S t
  exact iso_cechι_apply f S (isoH N f S) (derΦH N f S) (isoH_mk N f S)
    (fun _ _ h ↦ Derivation.llcomp (R := R) (A := S)
      (AlgebraTensorModule.rTensor R N ((locSL f S h).rTensor (Sh f S))))
    (fun _ _ h m ↦ Derivation.ext fun v ↦ gH_rTensor_locSL N f S h _) h z

omit [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S] in
/-- `gH` sends `z ⊗ 1` to the image of `z` under `S ⊗[R] N → S_s ⊗[R] N → (S_s ⊗[S] S^∧) ⊗[R] N`,
the second map being `x ⊗ n ↦ (x ⊗ 1) ⊗ n`. -/
theorem gH_tmul_one (s : Finset (Fin k)) (z : S ⊗[R] N) :
    gH N f S s (z ⊗ₜ 1) = AlgebraTensorModule.rTensor R N
      (Algebra.TensorProduct.includeLeft (R := S) (S := S) (A := Sl f S s)
        (B := Sh f S)).toLinearMap
      (AlgebraTensorModule.rTensor R N (Algebra.linearMap S (Sl f S s)) z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul c n =>
    rw [gH_tmul, AlgebraTensorModule.rTensor_tmul, AlgebraTensorModule.rTensor_tmul]
    simp only [AlgHom.toLinearMap_apply, Algebra.TensorProduct.includeLeft_apply,
      Algebra.linearMap_apply]
    congr 1
    rw [Algebra.algebraMap_eq_smul_one c]
    exact (TensorProduct.smul_tmul c (1 : Sl f S s) (1 : Sh f S)).symm
  | add x y hx hy => rw [TensorProduct.add_tmul, map_add, hx, hy, ← map_add, ← map_add]

omit [Module.FinitePresentation S Ω[S⁄R]] [IsNoetherianRing S] in
/-- `derΦH N f S s (m ⊗ 1) = derT N f S s (derΦV N f S s m)` for `m ∈ M`. -/
theorem derΦH_tmul_one (s : Finset (Fin k)) (m : derM N S) :
    derΦH N f S s (m ⊗ₜ 1) = derT N f S s (derΦV N f S s m) :=
  Derivation.ext fun v ↦ gH_tmul_one N f S s (m v)

/-- On the class of `m ∈ M`, the identifications `isoV` and `isoH` intertwine the map
`M_s → (M ⊗[S] S^∧)_s` induced by `m ↦ m ⊗ 1` with `derT`. -/
theorem isoH_map_mk (s : Finset (Fin k)) (m : derM N S) :
    isoH N f S s (((LocalizedModule.map (cechSub (gS f S) s)
      ((TensorProduct.mk S (derM N S) (Sh f S)).flip 1)).restrictScalars S)
        (LocalizedModule.mkLinearMap _ _ m)) =
      derT N f S s (isoV N f S s (LocalizedModule.mkLinearMap _ _ m)) := by
  have h1 : ((LocalizedModule.map (cechSub (gS f S) s)
      ((TensorProduct.mk S (derM N S) (Sh f S)).flip 1)).restrictScalars S)
        (LocalizedModule.mkLinearMap _ _ m) = LocalizedModule.mkLinearMap _ _ (m ⊗ₜ 1) := by
    simp [LocalizedModule.map_mk]
  rw [h1, isoH_mk, isoV_mk, derΦH_tmul_one]

/-- The identifications `isoV` and `isoH` intertwine the map `M_s → (M ⊗[S] S^∧)_s` induced by
`m ↦ m ⊗ 1` with `derT`. -/
theorem isoH_map (s : Finset (Fin k)) (z : cechMod (gS f S) (derM N S) s) :
    isoH N f S s (((LocalizedModule.map (cechSub (gS f S) s)
      ((TensorProduct.mk S (derM N S) (Sh f S)).flip 1)).restrictScalars S) z) =
      derT N f S s (isoV N f S s z) := by
  have := isLocalizedModule_derΦH N f S s
  let A : cechMod (gS f S) (derM N S) s →ₗ[S] derH N f S s :=
    (isoH N f S s).toLinearMap ∘ₗ (LocalizedModule.map (cechSub (gS f S) s)
      ((TensorProduct.mk S (derM N S) (Sh f S)).flip 1)).restrictScalars S
  let B : cechMod (gS f S) (derM N S) s →ₗ[S] derH N f S s :=
    (Derivation.llcomp (R := R) (A := S) (AlgebraTensorModule.rTensor R N
      (Algebra.TensorProduct.includeLeft (R := S) (S := S) (A := Sl f S s)
        (B := Sh f S)).toLinearMap)) ∘ₗ (isoV N f S s).toLinearMap
  have key : A = B :=
    IsLocalizedModule.ext (cechSub (gS f S) s)
      (LocalizedModule.mkLinearMap (cechSub (gS f S) s) (derM N S))
      (IsLocalizedModule.map_units (derΦH N f S s))
      (LinearMap.ext fun m ↦ isoH_map_mk N f S s m)
  exact LinearMap.congr_fun key z

/-! ### Transport of the exactness of the glueing complex -/

omit [IsNoetherianRing S] in
/-- In positive degree, the identifications `isoV` carry the differential of the glueing complex
of `M` to the Čech differential of the family `derV`. -/
theorem isoV_glueingDifferential (p : ℕ) (hp : 0 < p) (x : GlueingTerm (gS f S) (derM N S) p)
    (T : {s : Finset (Fin k) // s.card = p + 1}) :
    isoV N f S T.1 (glueingDifferential (gS f S) (derM N S) p x T) =
      cechDiff (derV N f S) (derιV N f S) p (fun u ↦ isoV N f S u.1 (x u)) T := by
  rw [glueingDifferential_eq_cechDiff]
  exact cechDiff_natural (cechMod (gS f S) (derM N S))
    (fun h ↦ (cechι (gS f S) (derM N S) h).toAddMonoidHom) (derιV N f S)
    (fun s ↦ (isoV N f S s).toLinearMap.toAddMonoidHom) hp
    (fun _ _ h _ z ↦ isoV_cechι N f S h z) x T

/-- In positive degree, the identifications `isoH` carry the differential of the glueing complex
of `M ⊗[S] S^∧` to the Čech differential of the family `derH`. -/
theorem isoH_glueingDifferential (p : ℕ) (hp : 0 < p)
    (x : GlueingTerm (gS f S) (derM N S ⊗[S] Sh f S) p)
    (T : {s : Finset (Fin k) // s.card = p + 1}) :
    isoH N f S T.1 (glueingDifferential (gS f S) (derM N S ⊗[S] Sh f S) p x T) =
      cechDiff (derH N f S) (derιH N f S) p (fun u ↦ isoH N f S u.1 (x u)) T := by
  rw [glueingDifferential_eq_cechDiff]
  exact cechDiff_natural (cechMod (gS f S) (derM N S ⊗[S] Sh f S))
    (fun h ↦ (cechι (gS f S) (derM N S ⊗[S] Sh f S) h).toAddMonoidHom) (derιH N f S)
    (fun s ↦ (isoH N f S s).toLinearMap.toAddMonoidHom) hp
    (fun _ _ h _ z ↦ isoH_cechι N f S h z) x T

/-- The identifications `isoV` and `isoH` carry `localizationTensorMap` to `derT`. -/
theorem isoH_localizationTensorMap (p : ℕ) (x : GlueingTerm (gS f S) (derM N S) p)
    (T : {s : Finset (Fin k) // s.card = p}) :
    isoH N f S T.1 (localizationTensorMap (Sh f S) (gS f S) (derM N S) p x T) =
      derT N f S T.1 (isoV N f S T.1 (x T)) :=
  isoH_map N f S T.1 (x T)

/-- **The Čech correction of the smooth square-zero lifting step.** Let `D` be a family of
`S^∧`-side derivations on the pairs of indices and `E` a family of `S`-side derivations on the
triples, with `dD = E ⊗ 1` and `dE = 0`. Then there are families `y` on the singletons and `x`
on the pairs with `d y - x ⊗ 1 = D` and `d x = -E`. This is the exactness of the glueing complex
of `Derivation R S (S ⊗[R] N)` at its fourth term, `FormalGlueing.glueingComplex_exact_fourth`,
read through the identifications `isoV`, `isoH`. -/
theorem exists_family_correction (D : FamTerm (derH N f S) 2) (E : FamTerm (derV N f S) 3)
    (h1 : ∀ T, cechDiff (derH N f S) (derιH N f S) 2 D T = derT N f S T.1 (E T))
    (h2 : ∀ T, cechDiff (derV N f S) (derιV N f S) 3 E T = 0) :
    ∃ (y : FamTerm (derH N f S) 1) (x : FamTerm (derV N f S) 2),
      (∀ T, cechDiff (derH N f S) (derιH N f S) 1 y T - derT N f S T.1 (x T) = D T) ∧
      (∀ T, cechDiff (derV N f S) (derιV N f S) 2 x T = -E T) := by
  let D' : GlueingTerm (gS f S) (derM N S ⊗[S] Sh f S) 2 := fun T ↦ (isoH N f S T.1).symm (D T)
  let E' : GlueingTerm (gS f S) (derM N S) 3 := fun T ↦ (isoV N f S T.1).symm (E T)
  have hD : (fun u : {s : Finset (Fin k) // s.card = 2} ↦ isoH N f S u.1 (D' u)) = D :=
    funext fun u ↦ LinearEquiv.apply_symm_apply _ _
  have hE : (fun u : {s : Finset (Fin k) // s.card = 3} ↦ isoV N f S u.1 ((-E') u)) = -E :=
    funext fun u ↦ by simp [E']
  have hdelta : glueingDelta (Sh f S) (gS f S) (derM N S) (D', -E') = 0 := by
    refine Prod.ext (funext fun T ↦ ?_) (funext fun T ↦ ?_)
    · apply (isoH N f S T.1).injective
      show isoH N f S T.1 (glueingDifferential (gS f S) (derM N S ⊗[S] Sh f S) 2 D' T +
        localizationTensorMap (Sh f S) (gS f S) (derM N S) 3 (-E') T) = isoH N f S T.1 0
      rw [map_add, isoH_glueingDifferential N f S 2 (by norm_num), isoH_localizationTensorMap,
        hD, h1, map_zero]
      simp [E']
    · apply (isoV N f S T.1).injective
      show isoV N f S T.1 (glueingDifferential (gS f S) (derM N S) 3 (-E') T) = isoV N f S T.1 0
      rw [isoV_glueingDifferential N f S 3 (by norm_num), hE, map_zero, cechDiff_neg, Pi.neg_apply,
        h2, neg_zero]
  obtain ⟨⟨y', x'⟩, hz⟩ := glueingComplex_exact_fourth S (Sh f S) (gS f S) (derM N S)
    (flat_Sh f S) (quotientMap_Sh_bijective f S) D' (-E') hdelta
  have hz1 : glueingDifferential (gS f S) (derM N S ⊗[S] Sh f S) 1 y' -
      localizationTensorMap (Sh f S) (gS f S) (derM N S) 2 x' = D' := by
    simpa [glueingGamma] using congrArg Prod.fst hz
  have hz2 : glueingDifferential (gS f S) (derM N S) 2 x' = -E' := by
    simpa [glueingGamma] using congrArg Prod.snd hz
  refine ⟨fun u ↦ isoH N f S u.1 (y' u), fun u ↦ isoV N f S u.1 (x' u), fun T ↦ ?_, fun T ↦ ?_⟩
  · rw [← isoH_glueingDifferential N f S 1 one_pos, ← isoH_localizationTensorMap, ← map_sub]
    show isoH N f S T.1 ((glueingDifferential (gS f S) (derM N S ⊗[S] Sh f S) 1 y' -
      localizationTensorMap (Sh f S) (gS f S) (derM N S) 2 x') T) = D T
    rw [hz1]
    exact LinearEquiv.apply_symm_apply _ _
  · rw [← isoV_glueingDifferential N f S 2 (by norm_num), hz2]
    simp [E']

end Rig.SquareZeroLift

