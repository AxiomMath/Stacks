module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Rig.DeformationPrincipal

/-!
# The torsion hypothesis of Stacks 0AK7 is automatic over a Noetherian ring

Stacks 0AK7 (`Rig.exists_algHom_lift_of_torsion_disjoint`) lifts an `A`-algebra map
`ψₙ : B → C / IⁿC` to an `A`-algebra map `B → C`, for `I = (a)` principal, under the
hypothesis that the `a`-power torsion `C[a^∞]` of the target meets `a^d C` in `0` for some
`d`. This file discharges that hypothesis whenever `C` is Noetherian, and records the
resulting lifting statement for a target which is an object of the category of Stacks 0AL4.

The point is quantitative. In a Noetherian ring the chain of annihilators
`(0 : b) ⊆ (0 : b²) ⊆ ⋯` stabilises, say at `N`. Then `C[b^∞] = (0 : b^N)`, so `b^N`
annihilates the whole torsion ideal; and if `x = y·b^N` lies in the torsion then
`b^{2N}·y = 0`, so `y ∈ (0 : b^{2N}) = (0 : b^N)` and `x = 0`. Hence `d = N` works.

## Main results

* `Rig.exists_pow_annihilates_torsionIdeal`: in a Noetherian ring a single power of `b`
  annihilates the whole `b`-power torsion ideal.
* `Rig.exists_disjoint_torsionIdeal_pow_span_singleton`: in a Noetherian ring the `b`-power
  torsion meets some power of `(b)` in `0`.
* `Rig.exists_disjoint_torsionIdeal_pow_map`: the same, for the ideal generated by a
  principal ideal of the base in a Noetherian algebra — the exact shape Stacks 0AK7 asks for.
* `Rig.exists_algHom_lift_of_isPrincipal`: Stacks 0AK7 with its torsion hypothesis
  discharged, for a target which is an object of the category of Stacks 0AL4.

## Implementation notes

The stabilisation of the annihilator chain is the reverse direction of
`monotone_stabilizes_iff_noetherian`, applied to
`n ↦ LinearMap.ker (LinearMap.mulLeft C (b ^ n))`, whose values are the ideals `(0 : b^n)`.

`Rig.exists_algHom_lift_of_isPrincipal` carries no hypothesis beyond those of Stacks 0AK7
other than the ones the category of Stacks 0AL4 supplies: the target is Noetherian by
`Rig.isNoetherianRing` (Stacks 0AJQ) and complete by
`Rig.AdicFiniteTypeAlgebra.isAdicallyComplete`. In particular the target is allowed to live
in a universe of its own, as it does in Stacks 0AK7 and unlike in Stacks 0GAQ.

## References

* [Stacks Project, Tag 0AK7](https://stacks.math.columbia.edu/tag/0AK7)
-/

@[expose] public noncomputable section

open CategoryTheory

namespace Rig

universe u v w

section Torsion

variable {C : Type*} [CommRing C]

/-- The ideals `(0 : b^n)` of elements annihilated by `b ^ n`, as a monotone family. -/
private def powAnnihilator (b : C) : ℕ →o Ideal C where
  toFun n := LinearMap.ker (LinearMap.mulLeft C (b ^ n))
  monotone' := by
    intro n m hnm x hx
    have hx' : b ^ n * x = 0 := hx
    change b ^ m * x = 0
    rw [show m = (m - n) + n by omega, pow_add, mul_assoc, hx', mul_zero]

private theorem mem_powAnnihilator_iff (b : C) (n : ℕ) (x : C) :
    x ∈ powAnnihilator b n ↔ b ^ n * x = 0 := Iff.rfl

/-- In a Noetherian ring a single power of `b` annihilates the whole `b`-power torsion ideal
`C[b^∞]`: the chain of annihilators of the powers of `b` stabilises. -/
public theorem exists_pow_annihilates_torsionIdeal [IsNoetherianRing C] (b : C) :
    ∃ N : ℕ, ∀ x ∈ torsionIdeal C b, b ^ N * x = 0 := by
  have hnoeth : IsNoetherian C C := isNoetherianRing_iff.mp ‹_›
  obtain ⟨N, hN⟩ := monotone_stabilizes_iff_noetherian.mpr hnoeth (powAnnihilator b)
  refine ⟨N, fun x hx => ?_⟩
  obtain ⟨m, hm⟩ := (mem_torsionIdeal_iff C b x).mp hx
  have hmem : x ∈ powAnnihilator b (max N m) :=
    (powAnnihilator b).monotone (le_max_right N m) ((mem_powAnnihilator_iff b m x).mpr hm)
  rw [← hN (max N m) (le_max_left N m)] at hmem
  exact (mem_powAnnihilator_iff b N x).mp hmem

/-- In a Noetherian ring the `b`-power torsion ideal `C[b^∞]` meets a power of the principal
ideal `(b)` in `0`. -/
public theorem exists_disjoint_torsionIdeal_pow_span_singleton [IsNoetherianRing C] (b : C) :
    ∃ d : ℕ, Disjoint (torsionIdeal C b) (Ideal.span {b} ^ d) := by
  obtain ⟨N, hN⟩ := exists_pow_annihilates_torsionIdeal (C := C) b
  refine ⟨N, disjoint_iff.mpr (eq_bot_iff.mpr fun x hx => ?_)⟩
  obtain ⟨hxT, hxb⟩ := hx
  rw [Ideal.span_singleton_pow] at hxb
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hxb
  have hyT : y ∈ torsionIdeal C b := by
    refine (mem_torsionIdeal_iff C b y).mpr ⟨N + N, ?_⟩
    rw [pow_add, mul_assoc, show b ^ N * y = x by rw [← hy]; ring]
    exact hN x hxT
  exact Ideal.mem_bot.mpr (by rw [← hy, mul_comm]; exact hN y hyT)

/-- In a Noetherian algebra the `a`-power torsion meets a power of the ideal generated by the
principal ideal `I = (a)` in `0`. This is the hypothesis `htorsion` of Stacks 0AK7. -/
public theorem exists_disjoint_torsionIdeal_pow_map {A : Type*} [CommRing A] {I : Ideal A}
    {a : A} (hI : I = Ideal.span {a}) (C : Type*) [CommRing C] [Algebra A C]
    [IsNoetherianRing C] :
    ∃ d : ℕ, Disjoint (torsionIdeal C (algebraMap A C a)) ((I.map (algebraMap A C)) ^ d) := by
  have hmap : I.map (algebraMap A C) = Ideal.span {algebraMap A C a} := by
    rw [hI, Ideal.map_span, Set.image_singleton]
  rw [hmap]
  exact exists_disjoint_torsionIdeal_pow_span_singleton (algebraMap A C (a := a))

end Torsion

section Lift

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

attribute [local instance] HasDerivedCategory.standard

/-- **Stacks 0AK7 with its torsion hypothesis discharged.**

Let `A` be a Noetherian ring, `I = (a)` a principal ideal, `B` an object of the category of
Stacks 0AL4 with a completed polynomial presentation `P` such that `a ^ c` annihilates
`Ext¹_B(NL^∧_{B/A}, N)` for every `B`-module `N`, and let `C` be another object of that
category. Then there is a `d` such that for every `n > max (2c) (c + d)` every `A`-algebra
map `B → C / IⁿC` agrees modulo `I^{n-c}` with the reduction of an `A`-algebra map `B → C`.

No hypothesis on `C` beyond membership of the category is needed: objects of the category of
Stacks 0AL4 over a Noetherian base are Noetherian (Stacks 0AJQ), and over a Noetherian ring
the `a`-power torsion meets a power of `(a)` in `0`
(`Rig.exists_disjoint_torsionIdeal_pow_map`).

This is the lifting input the source of Stacks 0ALS points to when it says that in the
principal case the use of Stacks 0GAQ can be replaced by the much easier Stacks 0AK7. Unlike
Stacks 0GAQ it carries no `DualSituation` data, no invariants `d`, `q₀`, `k` of Local
Cohomology Section 0GA6 and no open duality input, and it places no universe restriction on
the target. -/
public theorem exists_algHom_lift_of_isPrincipal
    (a : A) (I : Ideal A) (hI : I = Ideal.span {a})
    (B : AdicFiniteTypeAlgebra.{u, v} A I)
    (P : CompletedPolynomialPresentation I B)
    (c : ℕ)
    (hExt : ∀ (N : ModuleCat.{max u v} B.carrier)
      (ξ : DerivedCategory.Ext
        (DerivedCategory.Q.obj (completedNaiveCotangentComplex B P).cochainComplex)
        ((DerivedCategory.singleFunctor (ModuleCat.{max u v} B.carrier) 0).obj N) 1),
      (algebraMap A B.carrier a) ^ c • ξ = 0)
    (C : AdicFiniteTypeAlgebra.{u, w} A I) :
    ∃ d : ℕ, ∀ n : ℕ, max (2 * c) (c + d) < n →
      ∀ ψn : B.carrier →ₐ[A] C.carrier ⧸ C.adicIdeal ^ n,
        ∃ φ : B.carrier →ₐ[A] C.carrier,
          (Ideal.Quotient.factorₐ A
            (Ideal.pow_le_pow_right (Nat.sub_le n c))).comp ψn =
            (Ideal.Quotient.mkₐ A (C.adicIdeal ^ (n - c))).comp φ := by
  have : IsAdicComplete (I.map (algebraMap A C.carrier)) C.carrier := C.isAdicallyComplete
  obtain ⟨d, hd⟩ := exists_disjoint_torsionIdeal_pow_map hI C.carrier
  exact ⟨d, fun n hn ψn =>
    exists_algHom_lift_of_torsion_disjoint a I hI B P c hExt d hd n hn ψn⟩

end Lift

end Rig

end
