-/

@[expose] public noncomputable section

open Polynomial TopologicalRing

namespace Rig.RigEtaleConditionCounterexample

universe u

/-- The field `ℚ`, in universe `u`. -/
abbrev K : Type u := ULift.{u} ℚ

/-- The ideal `(X)` of `K[X]`. -/
abbrev ideal₀ : Ideal K[X] := Ideal.span {X}

/-- The base ring `ℚ⟦X⟧`, as the `X`-adic completion of `K[X]`. -/
abbrev Base : Type u := AdicCompletion ideal₀ K[X]

/-- The ideal `(X)` of the base ring. -/
abbrev baseIdeal : Ideal Base := ideal₀.map (algebraMap K[X] Base)

/-- The polynomial ring in one variable over the base ring. -/
abbrev Poly : Type u := MvPolynomial (Fin 1) Base

/-- The ideal generated by `X` in the polynomial ring. -/
abbrev polyIdeal : Ideal Poly := baseIdeal.map (algebraMap Base Poly)

/-- The `X`-adic completion `ℚ⟦X⟧⟨t⟩` of the polynomial ring. -/
abbrev Target : Type u := AdicCompletion polyIdeal Poly

/-- The ideal generated by `X` in `ℚ⟦X⟧⟨t⟩`. -/
abbrev targetIdeal : Ideal Target := polyIdeal.map (algebraMap Poly Target)

/-- The `X`-adic topology of the base ring. -/
@[instance_reducible] def baseWithIdeal : WithIdeal Base := ⟨baseIdeal⟩

/-- The `X`-adic topology of `ℚ⟦X⟧⟨t⟩`. -/
@[instance_reducible] def targetWithIdeal : WithIdeal Target := ⟨targetIdeal⟩

attribute [local instance] baseWithIdeal targetWithIdeal

/-- The ideal `(X)` of `K[X]` is finitely generated. -/
theorem ideal₀_fg : ideal₀.FG := ⟨{X}, by simp⟩

/-- The base ring `ℚ⟦X⟧` is an adic topological ring. -/
theorem isAdic_base : TopologicalRing.IsAdic Base :=
  isAdic_adicCompletion ideal₀ ideal₀_fg

/-- The ring `ℚ⟦X⟧⟨t⟩` is an adic topological ring. -/
theorem isAdic_target : TopologicalRing.IsAdic Target :=
  isAdic_adicCompletion polyIdeal (Ideal.fg_of_isNoetherianRing _)

/-- The image of `X` in the base ring. -/
abbrev s : Base := algebraMap K[X] Base X

/-- The ideal `(X)` of the base ring is generated by `s`, the image of `X`. -/
theorem baseIdeal_eq : baseIdeal = Ideal.span {s} := by
  simp [baseIdeal, ideal₀, Ideal.map_span]

/-- No power of `X` vanishes in `ℚ⟦X⟧⟨t⟩`. -/
theorem algebraMap_pow_ne_zero (n : ℕ) : algebraMap Base Target (s ^ n) ≠ 0 := by
  intro h
  have h₁ : AdicCompletion.evalₐ polyIdeal (n + 1) (algebraMap Base Target (s ^ n)) = 0 := by
    rw [h, map_zero]
  rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of,
    Ideal.Quotient.eq_zero_iff_mem] at h₁
  have h₂ : MvPolynomial.constantCoeff (algebraMap Base Poly (s ^ n)) ∈
      (polyIdeal ^ (n + 1)).map MvPolynomial.constantCoeff := Ideal.mem_map_of_mem _ h₁
  rw [MvPolynomial.algebraMap_eq, MvPolynomial.constantCoeff_C, Ideal.map_pow, polyIdeal,
    Ideal.map_map, MvPolynomial.algebraMap_eq] at h₂
  have hcc : (MvPolynomial.constantCoeff : Poly →+* Base).comp MvPolynomial.C = RingHom.id _ := by
    ext
    simp
  rw [hcc, Ideal.map_id, baseIdeal, ← Ideal.map_pow] at h₂
  let ev : Base →+* K[X] ⧸ ideal₀ ^ (n + 1) := (AdicCompletion.evalₐ ideal₀ (n + 1)).toRingHom
  have h₃ : ev (s ^ n) ∈ ((ideal₀ ^ (n + 1)).map (algebraMap K[X] Base)).map ev :=
    Ideal.mem_map_of_mem _ h₂
  have hev : ev.comp (algebraMap K[X] Base) = Ideal.Quotient.mk _ := by
    ext x <;> simp [ev]
  rw [Ideal.map_map, hev, Ideal.map_quotient_self, Ideal.mem_bot, map_pow] at h₃
  have hs : ev s = Ideal.Quotient.mk _ X := by
    rw [← RingHom.comp_apply, hev]
  rw [hs, ← map_pow,
    Ideal.Quotient.eq_zero_iff_mem, ideal₀, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton, Polynomial.X_pow_dvd_iff] at h₃
  simpa using h₃ n (Nat.lt_succ_self n)

/-- The topology of the base ring is the `(X)`-adic topology. -/
theorem isAdic_baseIdeal : _root_.IsAdic baseIdeal := rfl

/-- The ideal `(X)` is an ideal of definition of the base ring. -/
theorem isIdealOfDefinition_baseIdeal : IsIdealOfDefinition baseIdeal :=
  ⟨by simpa using (isAdic_iff.mp isAdic_baseIdeal).1 1, (isAdic_iff.mp isAdic_baseIdeal).2⟩

/-- A scalar killing a module with a basis indexed by a nonempty type is zero. -/
theorem eq_zero_of_smul_basis {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (b : Module.Basis ι R M) (i : ι) {a : R} (ha : a • b i = 0) : a = 0 := by
  simpa using congrArg (fun x ↦ b.repr x i) ha

/-- The image of `s ^ n` under any ring map lies in the extension of `(X) ^ n`. -/
private theorem map_s_pow_mem_map_pow {R : Type*} [CommRing R] (f : Base →+* R) (n : ℕ) :
    f (s ^ n) ∈ (baseIdeal ^ n).map f :=
  Ideal.mem_map_of_mem _
    (Ideal.pow_mem_pow (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _)) n)

/-- **`ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩` is not rig-étale.** Its completed module of differentials is free of rank
one, and no power of `X` kills it. -/
theorem not_isRigEtaleArrow : ¬ RingHom.IsRigEtaleArrow (algebraMap Base Target) := by
  intro h
  obtain ⟨hcont, hrig⟩ := h
  obtain ⟨hc, hf, hrig⟩ := hrig.forall_idealOfDefinition hcont isAdic_base isAdic_target
    baseIdeal isIdealOfDefinition_baseIdeal
  let e : (adicCompletionObj baseIdeal (B := Poly)).carrier ≃ₐ[Base]
      (let : Algebra Base Target := (algebraMap Base Target).toAlgebra
       let : Algebra.FiniteType (Base ⧸ baseIdeal)
         (Target ⧸ baseIdeal.map (algebraMap Base Target)) := hf
       AdicFiniteTypeAlgebra.of (I := baseIdeal) Target hc).carrier :=
    AlgEquiv.ofRingEquiv (f := RingEquiv.refl Target) fun _ ↦ rfl
  obtain ⟨c, -, hc⟩ := (isRigEtale_adicCompletionObj_iff baseIdeal (B := Poly)).mp
    (isRigEtale_of_algEquiv e hrig)
  let b := (KaehlerDifferential.mvPolynomialBasis Base (Fin 1)).baseChange
    (adicCompletionObj baseIdeal (B := Poly)).carrier
  exact algebraMap_pow_ne_zero c (eq_zero_of_smul_basis b 0
    (Module.mem_annihilator.mp (hc (map_s_pow_mem_map_pow (algebraMap _ _) c)) (b 0)))

/-! ### Transport along isomorphisms -/

/-- Adicness and topological finite type of a ring map transport along homeomorphic ring
isomorphisms of its source and target. -/
theorem isAdic_and_isTopologicallyOfFiniteType_of_ringEquiv {A B A' B' : Type*}
    [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
    [CommRing A'] [TopologicalSpace A'] [IsTopologicalRing A']
    [CommRing B'] [TopologicalSpace B'] [IsTopologicalRing B']
    (φ : A →+* B) (e₀ : A ≃+* A') (he₀ : Continuous e₀) (he₀' : Continuous e₀.symm)
    (e : B ≃+* B') (he : Continuous e) (he' : Continuous e.symm)
    (φ' : A' →+* B') (hcomm : φ'.comp (e₀ : A →+* A') = (e : B →+* B').comp φ)
    (h : RingHom.IsAdic φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ) :
    RingHom.IsAdic φ' ∧ TopologicalRing.IsTopologicallyOfFiniteType φ' := by
  obtain ⟨⟨I, hI, hIφ⟩, n, F, hF, hd⟩ := h
  refine ⟨⟨I.map (e₀ : A →+* A'), isAdic_map_of_ringEquiv e₀ he₀ he₀' hI, ?_⟩,
    n, ((e : B →+* B').comp F).comp (MvPolynomial.map (e₀.symm : A' →+* A)), ?_, ?_⟩
  · rw [Ideal.map_map, hcomm, ← Ideal.map_map]
    exact isAdic_map_of_ringEquiv e he he' hIφ
  · ext a
    · simp only [RingHom.coe_comp, Function.comp_apply, MvPolynomial.map_C]
      rw [← RingHom.comp_apply F, hF]
      simpa using (congrArg (fun g : A →+* B' ↦ g (e₀.symm a)) hcomm).symm
  · have hsurj : Function.Surjective (MvPolynomial.map (σ := Fin n) (e₀.symm : A' →+* A)) :=
      MvPolynomial.map_surjective _ e₀.symm.surjective
    rw [RingHom.coe_comp, DenseRange, hsurj.range_comp]
    exact e.surjective.denseRange.comp hd he

/-- The natural map from `A` to its completion over `B` is a homeomorphic ring isomorphism
when `A` is complete for, and topologized by, the ideal generated by an adic ideal of
definition of `B`. -/
theorem exists_ringEquiv_ofTarget {B A : Type*} [CommRing B] [TopologicalSpace B]
    [IsTopologicalRing B] [CommRing A] [TopologicalSpace A] [IsTopologicalRing A]
    (f : B →+* A) {I : Ideal B} (hdef : IsIdealOfDefinition I) (hadic : _root_.IsAdic I)
    (hfadic : _root_.IsAdic (I.map f)) (hc : IsAdicComplete (I.map f) A)
    (hcont : Continuous (CompletionOver.ofTarget f)) :
    ∃ ε : A ≃+* CompletionOver f, (∀ a, ε a = CompletionOver.ofTarget f a) ∧
      Continuous ε ∧ Continuous ε.symm := by
  have h2 : Function.Bijective (algebraMap A (AdicCompletion (I.map f) A)) :=
    AdicCompletion.of_bijective_iff.mpr hc
  have hbij : Function.Bijective (CompletionOver.ofTarget f) := by
    rw [← CompletionOver.toAdicCompletion_comp_ofTarget hdef hadic f, RingHom.coe_comp] at h2
    refine ⟨h2.1.of_comp, fun y ↦ ?_⟩
    obtain ⟨a, ha⟩ := h2.2 (CompletionOver.toAdicCompletion hdef hadic f y)
    exact ⟨a, (CompletionOver.bijective_toAdicCompletion hdef hadic f).1 ha⟩
  let ε := RingEquiv.ofBijective _ hbij
  refine ⟨ε, fun _ ↦ rfl, hcont, ?_⟩
  refine continuous_of_continuousAt_zero (ε.symm : CompletionOver f →+* A) ?_
  rw [ContinuousAt, map_zero]
  refine hfadic.hasBasis_nhds_zero.tendsto_right_iff.mpr fun n _ ↦ ?_
  refine Filter.mem_of_superset ((CompletionOver.isOpen_ker_projection f
    (CompletionOver.powIndex hdef hadic n)).mem_nhds (RingHom.mem_ker.mpr (map_zero _)))
    fun y hy ↦ ?_
  have hy' : y = CompletionOver.ofTarget f (ε.symm y) := (ε.apply_symm_apply y).symm
  rw [SetLike.mem_coe, RingHom.mem_ker, hy', CompletionOver.projection_ofTarget,
    Ideal.Quotient.eq_zero_iff_mem] at hy
  have hle : (I ^ (n + 1)).map f ≤ (I.map f) ^ n := by
    rw [Ideal.map_pow]
    exact Ideal.pow_le_pow_right (Nat.le_succ n)
  exact hle hy

/-- The image of an adic ideal under a continuous open surjective ring homomorphism is adic. -/
theorem isAdic_map_of_isOpenMap {R S : Type*} [CommRing R] [TopologicalSpace R]
    [IsTopologicalRing R] [CommRing S] [TopologicalSpace S] [IsTopologicalRing S]
    (f : R →+* S) (hs : Function.Surjective f) (ho : IsOpenMap f) (hc : Continuous f)
    {I : Ideal R} (hI : _root_.IsAdic I) : _root_.IsAdic (I.map f) := by
  rw [isAdic_iff] at hI ⊢
  refine ⟨fun n ↦ ?_, fun U hU ↦ ?_⟩
  · rw [← Ideal.map_pow, Ideal.map_eq_image_of_surjective _ hs]
    exact ho _ (hI.1 n)
  · obtain ⟨n, hn⟩ := hI.2 _ (hc.tendsto' 0 0 (map_zero f) hU)
    refine ⟨n, ?_⟩
    rw [← Ideal.map_pow, Ideal.map_eq_image_of_surjective _ hs]
    exact Set.image_subset_iff.mpr hn

/-! ### The localization diagram -/

/-- Reduction `ℚ⟦X⟧ → ℚ` modulo `X`. -/
def π : Base →+* K :=
  (Ideal.Quotient.lift (ideal₀ ^ 1) (Polynomial.evalRingHom 0) fun a ha ↦ by
    rw [pow_one, ideal₀, Ideal.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    simp).comp (AdicCompletion.evalₐ ideal₀ 1).toRingHom

/-- The reduction `π` modulo `X` kills `s`. -/
theorem π_s : π s = 0 := by
  simp [π, s, AdicCompletion.algebraMap_apply]

/-- The composite `ℚ⟦X⟧ → ℚ → ℚ⟦X⟧⟨t⟩`, which kills `X`. -/
def χ : Base →+* Target := (algebraMap K Target).comp π

/-- The composite `χ` kills `s`. -/
theorem χ_s : χ s = 0 := by simp [χ, π_s]

/-- The ideal `(X)` is sent to zero by `χ`. -/
theorem map_baseIdeal_χ : baseIdeal.map χ = ⊥ := by
  rw [baseIdeal_eq, Ideal.map_span, Set.image_singleton, χ_s, Ideal.span_singleton_eq_bot]

/-- The ideal `(X)` of the base ring generates the ideal `(X)` of `ℚ⟦X⟧⟨t⟩`. -/
theorem map_baseIdeal_algebraMap : baseIdeal.map (algebraMap Base Target) = targetIdeal := by
  simp only [targetIdeal, polyIdeal, Ideal.map_map, ← IsScalarTower.algebraMap_eq]

/-- The structure map `ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩` is continuous. -/
theorem continuous_algebraMap : Continuous (algebraMap Base Target) :=
  continuous_of_isAdic_of_map_le isAdic_baseIdeal (rfl : _root_.IsAdic targetIdeal) _
    map_baseIdeal_algebraMap.le

/-- The composite `χ : ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩` is continuous. -/
theorem continuous_χ : Continuous χ :=
  continuous_of_isAdic_of_map_le isAdic_baseIdeal (rfl : _root_.IsAdic targetIdeal) χ
    (map_baseIdeal_χ.trans_le bot_le)

/-- The index type of the two factors of the source. -/
abbrev idx : Type u := ULift.{u} (Fin 2)

/-- The first factor. -/
abbrev i0 : idx.{u} := ⟨0⟩

/-- The second factor. -/
abbrev i1 : idx.{u} := ⟨1⟩

/-- The source `ℚ⟦X⟧⟨t⟩ × ℚ⟦X⟧⟨t⟩` of the localization diagram. -/
abbrev Source : Type u := idx.{u} → Target.{u}

/-- The product topology of the source is linear. -/
@[instance_reducible] def sourceIsLinearTopology : IsLinearTopology Source Source :=
  TopologicalRing.pi_isLinearTopology

attribute [local instance] sourceIsLinearTopology

/-- The map `ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩ × ℚ⟦X⟧⟨t⟩`, the inclusion on the first factor and `χ` on the
second. It is not adic. -/
def φ : Base →+* Source := Pi.ringHom fun i ↦ ![algebraMap Base Target, χ] i.down

/-- The map `φ : ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩ × ℚ⟦X⟧⟨t⟩` is continuous. -/
theorem continuous_φ : Continuous φ :=
  continuous_pi fun ⟨i⟩ ↦ by fin_cases i; exacts [continuous_algebraMap, continuous_χ]

/-- The projection onto the first factor, the localization at the idempotent `(1, 0)`. -/
abbrev evalFirst : Source →+* Target := Pi.evalRingHom (fun _ : idx ↦ Target) i0

/-- The projection onto the first factor is étale, being a localization at an idempotent. -/
theorem etale_evalFirst : evalFirst.Etale := by
  let _ : Algebra Source Target := evalFirst.toAlgebra
  have : IsLocalization.Away (Pi.single i0 1 : Source) Target :=
    IsLocalization.away_of_isIdempotentElem (by simp [IsIdempotentElem, ← Pi.single_mul_left])
      (RingHom.ker_evalRingHom _ _) (Function.surjective_eval i0)
  exact RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway (Pi.single i0 1))

/-- The source `ℚ⟦X⟧⟨t⟩ × ℚ⟦X⟧⟨t⟩` is an adic topological ring. -/
theorem isAdic_source : TopologicalRing.IsAdic Source :=
  isAdic_pi (fun _ : idx ↦ Target) fun _ ↦ isAdic_target

/-- The base ring is identified, as a topological ring, with its completion over the identity,
through the canonical map. -/
theorem exists_ringEquiv_base : ∃ ε : Base ≃+* CompletionOver (RingHom.id Base),
    (∀ a, ε a = CompletionOver.canonicalMap (RingHom.id Base) a) ∧
      Continuous ε ∧ Continuous ε.symm := by
  have hc : IsAdicComplete (baseIdeal.map (RingHom.id Base)) Base := by
    rw [Ideal.map_id]
    exact (IsAdicComplete.map_algebraMap_iff ideal₀ Base).mpr
      (AdicCompletion.isAdicComplete ideal₀_fg)
  exact exists_ringEquiv_ofTarget (RingHom.id Base) isIdealOfDefinition_baseIdeal
    isAdic_baseIdeal (by simpa using isAdic_baseIdeal) hc
    (TopologicalRing.continuous_canonicalMap (RingHom.id Base))

/-- `ℚ⟦X⟧⟨t⟩` is identified, as a topological ring, with the completion of the source over
`evalFirst`, through the map from the target. -/
theorem exists_ringEquiv_target : ∃ ε : Target ≃+* CompletionOver evalFirst,
    (∀ a, ε a = CompletionOver.ofTarget evalFirst a) ∧ Continuous ε ∧ Continuous ε.symm := by
  obtain ⟨I, hdef, hadic⟩ := isAdic_source.1
  have hfadic : _root_.IsAdic (I.map evalFirst) :=
    isAdic_map_of_isOpenMap evalFirst (Function.surjective_eval i0) (isOpenMap_eval i0)
      (continuous_apply i0) hadic
  have hc : IsAdicComplete (I.map evalFirst) Target :=
    hfadic.isAdicComplete_iff.mpr ⟨isAdic_target.2.2, isAdic_target.2.1⟩
  have hdiag : CompletionOver.ofTarget evalFirst = (CompletionOver.canonicalMap evalFirst).comp
      (Pi.ringHom fun _ : idx ↦ RingHom.id Target) := by
    rw [← CompletionOver.ofTarget_comp, RingHom.comp_assoc]
    rfl
  refine exists_ringEquiv_ofTarget evalFirst hdef hadic hfadic hc ?_
  rw [hdiag, RingHom.coe_comp]
  exact (TopologicalRing.continuous_canonicalMap evalFirst).comp
    (continuous_pi fun _ ↦ continuous_id)

/-- The element `s` lies in the ideal `(X)`. -/
theorem s_mem_baseIdeal : s ∈ baseIdeal := by
  rw [baseIdeal_eq]
  exact Ideal.mem_span_singleton_self s

/-- **`φ` is not adic of finite type**: the ideal it generates vanishes on the second factor,
which is not discrete. So the annihilation half of rig-étaleness holds for `φ` vacuously. -/
theorem not_finiteTypeAdicAlgebraForEveryIdeal : ¬ FiniteTypeAdicAlgebraForEveryIdeal φ := by
  intro hft
  obtain ⟨hadic, -⟩ := hft baseIdeal isIdealOfDefinition_baseIdeal
  have hle : baseIdeal.map φ ≤ RingHom.ker (Pi.evalRingHom (fun _ : idx ↦ Target) i1) := by
    rw [Ideal.map_le_iff_le_comap, baseIdeal_eq, Ideal.span_le, Set.singleton_subset_iff]
    exact χ_s
  have hopen := (isAdic_iff.mp hadic).1 1
  rw [pow_one] at hopen
  have h0 : ({0} : Set Target) ∈ nhds (0 : Target) :=
    Filter.mem_of_superset ((hopen.preimage (continuous_single i1)).mem_nhds (by simp))
      fun a ha ↦ by simpa using hle ha
  have hT : _root_.IsAdic targetIdeal := rfl
  obtain ⟨n, -, hn⟩ := hT.hasBasis_nhds_zero.mem_iff.mp h0
  rw [← map_baseIdeal_algebraMap, ← Ideal.map_pow] at hn
  exact algebraMap_pow_ne_zero n (hn (map_s_pow_mem_map_pow _ n))

/-- `ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩` is adic and topologically of finite type. -/
theorem isAdic_and_isTopologicallyOfFiniteType_algebraMap :
    RingHom.IsAdic (algebraMap Base Target) ∧
      IsTopologicallyOfFiniteType (algebraMap Base Target) := by
  refine ⟨⟨baseIdeal, isAdic_baseIdeal, ?_⟩, 1, algebraMap Poly Target, ?_,
    denseRange_algebraMap_adicCompletion polyIdeal (Ideal.fg_of_isNoetherianRing _)⟩
  · rw [map_baseIdeal_algebraMap]
    rfl
  · ext b
    simp [IsScalarTower.algebraMap_apply Base Poly Target, MvPolynomial.algebraMap_eq]

end Rig.RigEtaleConditionCounterexample

namespace Rig

open RigEtaleConditionCounterexample

universe u

attribute [local instance] baseWithIdeal targetWithIdeal sourceIsLinearTopology

/-- **The annihilation half of rig-étaleness is not a local property of arrows of
`WAdm^Noeth`.** The three locality axioms of Situation 0CBA (Remark 0ANI) for
`Rig.RigEtaleCondition` fail: ascent along a localization diagram fails.

Take `B = ℚ⟦X⟧`, `A = ℚ⟦X⟧⟨t⟩ × ℚ⟦X⟧⟨t⟩` with `B → A` the inclusion on the first factor and
`ℚ⟦X⟧ → ℚ → ℚ⟦X⟧⟨t⟩` on the second, and `A' = ℚ⟦X⟧⟨t⟩` the localization of `A` at the idempotent
`(1, 0)`, `B' = B`. The map `B → A` is not adic, so `Rig.RigEtaleCondition` holds for it
vacuously; the completed map `B'^ → A'^` is `ℚ⟦X⟧ → ℚ⟦X⟧⟨t⟩` up to isomorphism, adic of finite
type, and not rig-étale, since its module of differentials is free of rank one.

Consequently the hypothesis `hcond` of `Rig.rigEtale_isLocalNoetherian`, and of the statements
built on it, is never satisfied, in any universe; the locality of rig-étaleness itself is
`Rig.rigEtale_propertyIsLocalNoetherian`. -/
public theorem not_propertyIsLocalNoetherian_rigEtaleCondition :
    ¬ TopologicalRing.PropertyIsLocalNoetherian.{u}
      (fun {B A : Type u} [CommRing B] [TopologicalSpace B] [IsTopologicalRing B]
        [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] (φ : B →+* A) ↦
        Rig.RigEtaleCondition φ) := by
  intro hcond
  obtain ⟨εB, hεB, hεBc, hεBc'⟩ := exists_ringEquiv_base
  obtain ⟨εT, hεT, hεTc, hεTc'⟩ := exists_ringEquiv_target
  let cm : CompletionOver (RingHom.id Base) →+* CompletionOver evalFirst :=
    ((εT : Target →+* CompletionOver evalFirst).comp (algebraMap Base Target)).comp
      (εB.symm : CompletionOver (RingHom.id Base) →+* Base)
  have hcm_cont : Continuous cm := hεTc.comp (continuous_algebraMap.comp hεBc')
  have hA'C := TopologicalRing.completionOver_isNoetherianAdic evalFirst
    ⟨isAdic_source, inferInstance⟩ (inferInstance : IsNoetherianRing Target)
  have hB'C := TopologicalRing.completionOver_isNoetherianAdic (RingHom.id Base)
    ⟨isAdic_base, inferInstance⟩ (inferInstance : IsNoetherianRing Base)
  have := hA'C.2
  have := hB'C.2
  obtain ⟨IS, -, hISadic⟩ := isAdic_source.1
  let D : LocalizationDiagram Source Base Target Base :=
    { toA' := evalFirst
      toB' := RingHom.id Base
      map := φ
      completedMap := cm
      weaklyAdmissibleA := isAdic_source.isWeaklyAdmissible
      weaklyAdmissibleB := isAdic_base.isWeaklyAdmissible
      countableA := hISadic.hasBasis_nhds_zero.isCountablyGenerated
      countableB := isAdic_baseIdeal.hasBasis_nhds_zero.isCountablyGenerated
      etaleA := etale_evalFirst
      etaleB := RingHom.Etale.of_bijective Function.bijective_id
      continuousMap := continuous_φ
      continuousCompletedMap := hcm_cont
      commutes := by
        ext b
        simp only [RingHom.comp_apply, cm, RingEquiv.coe_toRingHom]
        rw [← hεB b, RingEquiv.symm_apply_apply, hεT]
        rfl }
  have hvac : Rig.RigEtaleCondition φ := by
    intro _ _ _ _ hft
    exact absurd hft not_finiteTypeAdicAlgebraForEveryIdeal
  have h1 : Rig.RigEtaleCondition cm := hcond.localizationPreserves D
    ⟨isAdic_source, inferInstance⟩ ⟨isAdic_base, inferInstance⟩ hA'C hB'C hvac
  have hone : RingHom.IsAdic cm ∧ IsTopologicallyOfFiniteType cm :=
    isAdic_and_isTopologicallyOfFiniteType_of_ringEquiv (algebraMap Base Target) εB hεBc hεBc'
      εT hεTc hεTc' cm (by ext b; simp [cm]) isAdic_and_isTopologicallyOfFiniteType_algebraMap
  have hft' : FiniteTypeAdicAlgebraForEveryIdeal cm :=
    ((adicFiniteType_tfae cm hcm_cont hB'C.1 hA'C.1 (exists_idealOfDefinition_fg hB'C.1 hB'C.2)
      (exists_idealOfDefinition_fg hA'C.1 hA'C.2)).out 1 6).mp hone
  have harrow : RingHom.IsRigEtaleArrow cm := by
    intro _ _ _ _
    obtain ⟨I', hI', -⟩ := hB'C.1.1
    exact ⟨hcm_cont, hft', I', hI', isRigEtaleOver_of_isRigEtale cm hft' I' hI' (h1 hft' I' hI')⟩
  refine not_isRigEtaleArrow (isRigEtaleArrow_of_isRigEtaleArrow_of_ringEquiv hB'C.1 hA'C.1 cm
    harrow εB.symm hεBc' (by simpa using hεBc) εT.symm hεTc' (by simpa using hεTc)
    (algebraMap Base Target) ?_)
  ext x
  simp [cm]

end Rig

