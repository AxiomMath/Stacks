module

public import StacksFrontier.RingTheory.LocalCompleteIntersection.CompletionCriterion
public import StacksFrontier.RingTheory.Rig.FlatBaseChangeReduction
public import StacksFrontier.RingTheory.Rig.RigSmoothRegularSequenceDescent
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Rig-smooth arrows are rig-flat, with regular presentations on the generic fibre

**Stacks 0GH1**: a rig-smooth arrow `φ : A → B` of `WAdm^{Noeth}` is rig-flat, and for every
presentation `B = A⟨x₁, …, x_n⟩ / J` and every prime `J ⊆ 𝔮` of `A⟨x⟩` not containing an ideal of
definition, `J_𝔮` is generated by a regular sequence.

The presentation ideal has a Jacobian chart at every prime of the generic fibre
(`Rig.exists_restrictedJacobianChart`, from the Jacobian criterion of Stacks 0GAJ), so
`Rig.exists_isRegular_and_flat_of_forall_jacobianChart` gives the regular sequences and the
flatness of `B` on the generic fibre.  Rig-flatness asks for naive rig-flatness of every map
`A_{\{f\}} → B_{\{f\}}` of completed principal localizations.  Completed principal localization is
exact on a presentation (`Rig.completedAwayMap_surjective_and_ker`), so
`B_{\{f\}} = A{x}_{\{f\}} / J = A_{\{f\}}{x} / J`; the charts transport
(`Rig.forall_jacobianChart_map`), and the same argument over `A_{\{f\}}` gives flatness of
`B_{\{f\}}` on its generic fibre, which is naive rig-flatness by Stacks 0GGL.

## Main results

* `Rig.exists_restrictedJacobianChart`: the Jacobian charts of a rig-smooth presentation.
* `Rig.flat_localization_atPrime_of_forall_jacobianChart`: flatness on the generic fibre of a
  quotient with Jacobian charts.
* `Rig.exists_isRegular_ofList_eq_map_presentationIdeal`: the regular-sequence conclusion.
* `Rig.isNaivelyRigFlat_completedAwayMap_of_isRigSmooth`: naive rig-flatness of the completed
  principal localizations.
* `Rig.isRigFlat_and_exists_isRegular_of_isRigSmooth`: **Stacks 0GH1**.

## Implementation notes

An arrow of `WAdm^{Noeth}` is a continuous homomorphism of Noetherian adic topological rings, and
rig-smoothness is `RingHom.IsRigSmooth` (Stacks 0GCJ).  A presentation is a
`Rig.CompletedPolynomialPresentation` over an ideal of definition `I`, and the prime `𝔮` not
containing an ideal of definition is `¬ I · A⟨x⟩ ≤ 𝔮`.  The arguments run in the model
`RestrictedPowerSeries I (Fin n)` of `A⟨x⟩`, where Stacks 0GGG's identification lives, and the
conclusion is carried back along `RestrictedPowerSeries.adicCompletionAlgEquiv`.

## References

* [Stacks Project, Tag 0GH1](https://stacks.math.columbia.edu/tag/0GH1)
* [Stacks Project, Tag 0GAJ](https://stacks.math.columbia.edu/tag/0GAJ)
* [Stacks Project, Tag 0GGL](https://stacks.math.columbia.edu/tag/0GGL)
* [Stacks Project, Tag 0GGP](https://stacks.math.columbia.edu/tag/0GGP)
-/

@[expose] public noncomputable section

open RingTheory.Sequence RestrictedPowerSeries

universe u v

namespace Rig

/-- Extending an ideal along `θ` and then to the local ring at `Q` is the generated-by-images
statement for the local ring at `θ⁻¹(Q)`. -/
private theorem map_map_atPrime_eq_span {R S ι : Type*} [CommRing R] [CommRing S] (θ : R →+* S)
    (Q : Ideal S) [Q.IsPrime] {J : Ideal R} {y : ι → R}
    (hgen : J.map (algebraMap R (Localization.AtPrime (Q.comap θ))) =
      Ideal.span (Set.range fun j ↦ algebraMap R (Localization.AtPrime (Q.comap θ)) (y j))) :
    (J.map θ).map (algebraMap S (Localization.AtPrime Q)) =
      Ideal.span (Set.range fun j ↦ algebraMap S (Localization.AtPrime Q) (θ (y j))) := by
  let ℓ := Localization.localRingHom (Q.comap θ) Q θ rfl
  have hℓ := Localization.localRingHom_to_map (Q.comap θ) Q θ rfl
  have hcomp : (algebraMap S (Localization.AtPrime Q)).comp θ =
      ℓ.comp (algebraMap R (Localization.AtPrime (Q.comap θ))) :=
    RingHom.ext fun z ↦ (hℓ z).symm
  rw [Ideal.map_map, hcomp, ← Ideal.map_map, hgen, Ideal.map_span, ← Set.range_comp]
  congr 1
  exact congrArg Set.range (funext fun j ↦ hℓ (y j))

/-- If `g ∘ f = h` and `Q` does not contain `I.map h`, then `g⁻¹(Q)` does not contain `I.map f`. -/
private theorem not_map_le_comap {A R S : Type*} [CommRing A] [CommRing R] [CommRing S]
    (I : Ideal A) (f : A →+* R) (g : R →+* S) (h : A →+* S) (hfg : g.comp f = h) (Q : Ideal S)
    (hQ : ¬ I.map h ≤ Q) : ¬ I.map f ≤ Q.comap g := fun hle ↦ hQ <| by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  have := hle (Ideal.mem_map_of_mem f ha)
  rwa [Ideal.mem_comap, ← RingHom.comp_apply, hfg] at this

/-- **The Jacobian charts of a rig-smooth presentation, read in restricted power series.**  Let
`B` be rig-smooth over `(A, I)` with completed polynomial presentation `P`, and transport its
ideal to `A{x₁, …, x_n}` along the identification with the completed polynomial algebra.  At
every prime `𝔮 ⊇ J` of `A{x}` not containing `I`, there are `y₁, …, y_m ∈ J` generating `J_𝔮`
whose Jacobian minor `det (∂y_j/∂x_{T i})` is a unit at `𝔮`: this is
`Rig.exists_jacobianChart_map_eq_span_atPrime`, transported along the identification, which
carries the formal partial derivatives to the formal partial derivatives. -/
public theorem exists_restrictedJacobianChart
    {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (P : CompletedPolynomialPresentation I B)
    (hB : IsRigSmooth B)
    (q : Ideal (RestrictedPowerSeries I (Fin P.variableCount))) [q.IsPrime]
    (hJq : P.ideal.comap (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingHom ≤ q)
    (hq : ¬ coefficientIdeal I (Fin P.variableCount) ≤ q) :
    ∃ (m : ℕ) (T : Fin m ↪ Fin P.variableCount)
      (y : Fin m → RestrictedPowerSeries I (Fin P.variableCount)),
      (∀ j, y j ∈ P.ideal.comap (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingHom) ∧
      Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (y j)) ∉ q ∧
      (P.ideal.comap (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingHom).map
          (algebraMap _ (Localization.AtPrime q)) =
        Ideal.span (Set.range fun j ↦ algebraMap _ (Localization.AtPrime q) (y j)) := by
  let e : RestrictedPowerSeries I (Fin P.variableCount) ≃+* P.completedPolynomialRing :=
    (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingEquiv
  let qC : Ideal P.completedPolynomialRing := q.comap e.symm.toRingHom
  have : qC.IsPrime := Ideal.comap_isPrime _ _
  have hJ : P.ideal.comap e.toRingHom = P.ideal.map e.symm.toRingHom :=
    (Ideal.map_symm e).symm
  have hJqC : P.ideal ≤ qC := by
    intro z hz
    change e.symm z ∈ q
    refine hJq ?_
    change e (e.symm z) ∈ P.ideal
    rwa [e.apply_symm_apply]
  have hqC : ¬ I.map (algebraMap A P.completedPolynomialRing) ≤ qC :=
    not_map_le_comap I _ e.symm.toRingHom (coefficientRingHom I (Fin P.variableCount))
      (RingHom.ext fun a ↦ (adicCompletionAlgEquiv I (Fin P.variableCount)).symm.commutes a) q hq
  obtain ⟨m, T, f, hfJ, hdet, hgen⟩ :=
    exists_jacobianChart_map_eq_span_atPrime B P hB qC hqC hJqC
  refine ⟨m, T, fun j ↦ e.symm (f j), fun j ↦ ?_, ?_, ?_⟩
  · change e (e.symm (f j)) ∈ P.ideal
    rw [e.apply_symm_apply]
    exact hfJ j
  · have hd : (Matrix.det fun i j : Fin m ↦
        (completedNaiveCotangentComplex B P).partialDeriv (T i) (f j)) =
        e.toRingHom
          (Matrix.det fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (e.symm (f j))) := by
      rw [RingHom.map_det e.toRingHom
        (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (e.symm (f j)))]
      congr 1
    intro hmem
    have hnot : (Matrix.det fun i j : Fin m ↦
        (completedNaiveCotangentComplex B P).partialDeriv (T i) (f j)) ∉ qC :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime qC) qC _).mp hdet
    apply hnot
    rw [hd]
    change e.symm (e _) ∈ q
    rwa [e.symm_apply_apply]
  · rw [hJ]
    exact map_map_atPrime_eq_span e.symm.toRingHom q hgen

/-- **Flatness of a local ring of a quotient, from the presentation.**  Let `ρ : R → C` be a
surjective `A`-algebra map and `𝔔` a prime of `C`, contracting to `𝔮 = ρ⁻¹(𝔔)`.  The local ring
`C_𝔔` is `R_𝔮 ⧸ (ker ρ) R_𝔮`, so it is flat over `A` as soon as that quotient is. -/
public theorem flat_localization_atPrime_of_surjective {A R C : Type*} [CommRing A] [CommRing R]
    [CommRing C] [Algebra A R] [Algebra A C] (ρ : R →ₐ[A] C) (hρ : Function.Surjective ρ)
    (𝔔 : Ideal C) [𝔔.IsPrime]
    (hflat : Module.Flat A (Localization.AtPrime (𝔔.comap ρ.toRingHom) ⧸
      (RingHom.ker ρ.toRingHom).map
        (algebraMap R (Localization.AtPrime (𝔔.comap ρ.toRingHom))))) :
    Module.Flat A (Localization.AtPrime 𝔔) := by
  let Q := 𝔔.comap ρ.toRingHom
  let K := RingHom.ker ρ.toRingHom
  let j : (R ⧸ K) ≃+* C := RingHom.quotientKerEquivOfSurjective hρ
  have hM : (Algebra.algebraMapSubmonoid (R ⧸ K) Q.primeCompl).map j.toMonoidHom =
      𝔔.primeCompl := by
    ext c
    constructor
    · rintro ⟨_, ⟨r, hr, rfl⟩, rfl⟩
      exact hr
    · intro hc
      obtain ⟨r, rfl⟩ := hρ c
      exact ⟨_, ⟨r, hc, rfl⟩, rfl⟩
  let E : (Localization.AtPrime Q ⧸ K.map (algebraMap R (Localization.AtPrime Q))) ≃+*
      Localization.AtPrime 𝔔 :=
    IsLocalization.ringEquivOfRingEquiv (M := Algebra.algebraMapSubmonoid (R ⧸ K) Q.primeCompl)
      (T := 𝔔.primeCompl) _ _ j hM
  have hE : ∀ r : R, E (Ideal.Quotient.mk _ (algebraMap R (Localization.AtPrime Q) r)) =
      algebraMap C (Localization.AtPrime 𝔔) (ρ r) := fun r ↦
    IsLocalization.ringEquivOfRingEquiv_eq hM (Ideal.Quotient.mk K r)
  let E' : (Localization.AtPrime Q ⧸ K.map (algebraMap R (Localization.AtPrime Q))) ≃ₐ[A]
      Localization.AtPrime 𝔔 :=
    AlgEquiv.ofRingEquiv (f := E) fun a ↦ by
      rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime Q),
        IsScalarTower.algebraMap_apply A R (Localization.AtPrime Q), Ideal.Quotient.algebraMap_eq,
        hE, AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  exact Module.Flat.of_linearEquiv E'.symm.toLinearEquiv

/-- **Flatness at the primes of the generic fibre of a quotient with Jacobian charts.**  Let `A`
be a Noetherian adic ring with ideal of definition `I`, let `J` be an ideal of `A{x₁, …, x_n}`
with a Jacobian chart at every prime `𝔮 ⊇ J` not containing `I`, and let `ρ : A{x} → C` be a
surjective `A`-algebra map with kernel `J`.  Then `C_𝔔` is flat over `A` for every prime `𝔔` of
`C` not containing `I C`. -/
public theorem flat_localization_atPrime_of_forall_jacobianChart
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A] (hA : TopologicalRing.IsAdic A) {I : Ideal A} (hI : _root_.IsAdic I)
    {n : ℕ} (J : Ideal (RestrictedPowerSeries I (Fin n)))
    (hchart : ∀ (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime], J ≤ q →
      ¬ coefficientIdeal I (Fin n) ≤ q → ∃ (m : ℕ) (T : Fin m ↪ Fin n)
        (y : Fin m → RestrictedPowerSeries I (Fin n)), (∀ j, y j ∈ J) ∧
        Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (y j)) ∉ q ∧
        J.map (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q)) =
          Ideal.span (Set.range fun j ↦
            algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q) (y j)))
    {C : Type*} [CommRing C] [Algebra A C] (ρ : RestrictedPowerSeries I (Fin n) →ₐ[A] C)
    (hρ : Function.Surjective ρ) (hker : RingHom.ker ρ.toRingHom = J)
    (𝔔 : Ideal C) [𝔔.IsPrime] (h𝔔 : ¬ I.map (algebraMap A C) ≤ 𝔔) :
    Module.Flat A (Localization.AtPrime 𝔔) := by
  have hJQ : J ≤ 𝔔.comap ρ.toRingHom := by
    rw [← hker, RingHom.ker_eq_comap_bot]
    exact Ideal.comap_mono bot_le
  have hQ : ¬ coefficientIdeal I (Fin n) ≤ 𝔔.comap ρ.toRingHom :=
    not_map_le_comap I (coefficientRingHom I (Fin n)) ρ.toRingHom (algebraMap A C)
      (RingHom.ext fun a ↦ ρ.commutes a) 𝔔 h𝔔
  obtain ⟨-, -, -, hflat⟩ := exists_isRegular_and_flat_of_forall_jacobianChart hA hI J hchart
    (𝔔.comap ρ.toRingHom) hJQ hQ
  refine flat_localization_atPrime_of_surjective ρ hρ 𝔔 ?_
  rwa [hker]

/-- **Naive rig-flatness from flatness on the generic fibre.**  An adic, topologically finite type
continuous map `ψ : A → C` of weakly admissible rings with finitely generated ideals of definition
is naively rig-flat once `C_𝔔` is flat over `A` at every prime `𝔔` not containing `I C`, for one
ideal of definition `I` of `A` whose extension defines the topology of `C`: this is condition (3)
of Stacks 0GGL, since a prime avoids one ideal of definition exactly when it avoids all of them. -/
public theorem isNaivelyRigFlat_of_flat_localization_atPrime {A C : Type*} [CommRing A]
    [CommRing C] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [TopologicalSpace C] [IsTopologicalRing C] [IsLinearTopology C C]
    (ψ : A →+* C) (hψ : Continuous ψ) (hA : TopologicalRing.IsWeaklyAdmissible A)
    (hC : TopologicalRing.IsWeaklyAdmissible C) (hAfg : ∃ I : Ideal A, _root_.IsAdic I ∧ I.FG)
    (hCfg : ∃ J : Ideal C, _root_.IsAdic J ∧ J.FG) (hadic : _root_.RingHom.IsAdic ψ)
    (hft : TopologicalRing.IsTopologicallyOfFiniteType ψ) (I : Ideal A)
    (hIψ : _root_.IsAdic (I.map ψ))
    (hflat : ∀ (𝔔 : Ideal C) [𝔔.IsPrime], ¬ I.map ψ ≤ 𝔔 →
      _root_.RingHom.Flat ((algebraMap C (Localization.AtPrime 𝔔)).comp ψ)) :
    Rig.RingHom.IsNaivelyRigFlat ψ := by
  refine ⟨hadic, hft, ?_⟩
  refine ((naivelyRigFlat_tfae ψ hψ hA hC hAfg hCfg hadic).out 3 1).mp ?_
  rintro q hq ⟨J, hJ, hJq⟩
  refine hflat q fun hle ↦ hJq ?_
  have hopen : IsOpen ((I.map ψ : Ideal C) : Set C) := by
    simpa using (isAdic_iff.mp hIψ).1 1
  obtain ⟨k, hk⟩ := hJ.2 _ (hopen.mem_nhds (I.map ψ).zero_mem)
  exact hq.le_of_pow_le ((SetLike.coe_subset_coe.mp hk).trans hle)

/-- The surjection `A{x₁, …, x_n} → B` of a completed polynomial presentation, read in
restricted power series. -/
public noncomputable abbrev CompletedPolynomialPresentation.restrictedAlgHom
    {A : Type u} [CommRing A] {I : Ideal A} {B : AdicFiniteTypeAlgebra.{u, v} A I}
    (P : CompletedPolynomialPresentation I B) :
    RestrictedPowerSeries I (Fin P.variableCount) →ₐ[A] B.carrier :=
  P.toAlgHom.comp (adicCompletionAlgEquiv I (Fin P.variableCount)).toAlgHom

/-- The surjection of a presentation, read in restricted power series, is surjective with kernel
the ideal of the presentation read in restricted power series. -/
public theorem CompletedPolynomialPresentation.restrictedAlgHom_surjective_and_ker
    {A : Type u} [CommRing A] {I : Ideal A} {B : AdicFiniteTypeAlgebra.{u, v} A I}
    (P : CompletedPolynomialPresentation I B) :
    Function.Surjective P.restrictedAlgHom ∧
      RingHom.ker P.restrictedAlgHom.toRingHom =
        P.ideal.comap (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingHom := by
  refine ⟨P.toAlgHom_surjective.comp (adicCompletionAlgEquiv I (Fin P.variableCount)).surjective,
    ?_⟩
  ext x
  change P.toAlgHom.toRingHom ((adicCompletionAlgEquiv I (Fin P.variableCount)) x) = 0 ↔ _
  rw [← RingHom.mem_ker, show RingHom.ker P.toAlgHom.toRingHom = P.ideal from P.ker_eq_ideal]
  rfl

/-- **Rig-smoothness gives flatness on the generic fibre.**  If `B` is rig-smooth over `(A, I)`,
then `B_𝔔` is flat over `A` at every prime `𝔔` of `B` not containing `I B`: the presentation
ideal has Jacobian charts (`Rig.exists_restrictedJacobianChart`), so
`Rig.flat_localization_atPrime_of_forall_jacobianChart` applies. -/
public theorem flat_localization_atPrime_of_isRigSmooth
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A] (hA : TopologicalRing.IsAdic A) {I : Ideal A} (hI : _root_.IsAdic I)
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (hB : IsRigSmooth B)
    (𝔔 : Ideal B.carrier) [𝔔.IsPrime] (h𝔔 : ¬ B.adicIdeal ≤ 𝔔) :
    Module.Flat A (Localization.AtPrime 𝔔) := by
  rcases id hB with ⟨P, -⟩
  obtain ⟨hsurj, hker⟩ := P.restrictedAlgHom_surjective_and_ker
  exact flat_localization_atPrime_of_forall_jacobianChart hA hI _
    (fun q _ hJq hq ↦ exists_restrictedJacobianChart B P hB q hJq hq) P.restrictedAlgHom hsurj
    hker 𝔔 h𝔔

/-- A regular sequence stays regular along a ring isomorphism. -/
public theorem isRegular_map_of_bijective {S S' : Type*} [CommRing S] [CommRing S']
    (ℓ : S →+* S') (hℓ : Function.Bijective ℓ) (fs : List S) (h : IsRegular S fs) :
    IsRegular S' (fs.map ℓ) := by
  let : Algebra S S' := ℓ.toAlgebra
  have : Module.FaithfullyFlat S S' := RingHom.FaithfullyFlat.of_bijective hℓ
  exact (isRegular_map_algebraMap_iff_of_faithfullyFlat_of_isBaseChange
    (IsBaseChange.linearMap S S') fs).mpr h

/-- A ring isomorphism induces an isomorphism of the localizations at corresponding primes,
compatible with the structure maps. -/
public theorem exists_localRingHom_bijective_of_ringEquiv {R R' : Type*} [CommRing R]
    [CommRing R'] (e : R ≃+* R') (q : Ideal R') [q.IsPrime] :
    ∃ ℓ : Localization.AtPrime (q.comap e.toRingHom) →+* Localization.AtPrime q,
      ℓ.comp (algebraMap R _) = (algebraMap R' (Localization.AtPrime q)).comp e.toRingHom ∧
        Function.Bijective ℓ := by
  let qR := q.comap e.toRingHom
  let ℓ := Localization.localRingHom qR q e.toRingHom rfl
  have hℓ : ∀ z, ℓ (algebraMap R (Localization.AtPrime qR) z) =
      algebraMap R' (Localization.AtPrime q) (e z) :=
    Localization.localRingHom_to_map qR q e.toRingHom rfl
  have hq : q = qR.comap e.symm.toRingHom := by
    ext x
    change x ∈ q ↔ e (e.symm x) ∈ q
    rw [e.apply_symm_apply]
  let ℓ' := Localization.localRingHom q qR e.symm.toRingHom hq
  have h1 : ℓ'.comp ℓ = RingHom.id _ := by
    refine IsLocalization.ringHom_ext qR.primeCompl (RingHom.ext fun z ↦ ?_)
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hℓ, Localization.localRingHom_to_map]
    change algebraMap _ _ (e.symm (e z)) = _
    rw [e.symm_apply_apply]
  have h2 : ℓ.comp ℓ' = RingHom.id _ := by
    refine IsLocalization.ringHom_ext q.primeCompl (RingHom.ext fun z ↦ ?_)
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [Localization.localRingHom_to_map]
    change ℓ (algebraMap _ _ (e.symm z)) = _
    rw [hℓ, e.apply_symm_apply]
  exact ⟨ℓ, RingHom.ext hℓ, Function.bijective_iff_has_inverse.mpr
    ⟨ℓ', fun x ↦ congrArg (· x) h1, fun x ↦ congrArg (· x) h2⟩⟩

/-- **Stacks 0GH1, the regular-sequence statement for a presentation.**  Let `B` be rig-smooth
over a Noetherian adic ring `(A, I)` and let `B = A⟨x₁, …, x_n⟩ / J` be a completed polynomial
presentation.  For every prime `J ⊆ 𝔮 ⊆ A⟨x⟩` not containing `I A⟨x⟩`, the ideal `J_𝔮` of
`A⟨x⟩_𝔮` is generated by a regular sequence.

Read in restricted power series this is `Rig.exists_isRegular_and_flat_of_forall_jacobianChart`,
the charts coming from `Rig.exists_restrictedJacobianChart`; the identification of the two
models of `A⟨x⟩` carries the conclusion back. -/
public theorem exists_isRegular_ofList_eq_map_presentationIdeal
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A] (hA : TopologicalRing.IsAdic A) {I : Ideal A} (hI : _root_.IsAdic I)
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (hB : IsRigSmooth B)
    (P : CompletedPolynomialPresentation I B)
    (q : Ideal P.completedPolynomialRing) [q.IsPrime]
    (hq : ¬ I.map (algebraMap A P.completedPolynomialRing) ≤ q) (hJq : P.ideal ≤ q) :
    ∃ fs : List (Localization.AtPrime q),
      RingTheory.Sequence.IsRegular (Localization.AtPrime q) fs ∧
        Ideal.ofList fs =
          P.ideal.map (algebraMap P.completedPolynomialRing (Localization.AtPrime q)) := by
  let e : RestrictedPowerSeries I (Fin P.variableCount) ≃+* P.completedPolynomialRing :=
    (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingEquiv
  let qR : Ideal (RestrictedPowerSeries I (Fin P.variableCount)) := q.comap e.toRingHom
  have : qR.IsPrime := Ideal.comap_isPrime _ _
  have hJqR : P.ideal.comap e.toRingHom ≤ qR := Ideal.comap_mono hJq
  have hqR : ¬ coefficientIdeal I (Fin P.variableCount) ≤ qR :=
    not_map_le_comap I (coefficientRingHom I (Fin P.variableCount)) e.toRingHom
      (algebraMap A P.completedPolynomialRing)
      (RingHom.ext fun a ↦ (adicCompletionAlgEquiv I (Fin P.variableCount)).commutes a) q hq
  obtain ⟨fs, hreg, hfs, -⟩ := exists_isRegular_and_flat_of_forall_jacobianChart hA hI
    (P.ideal.comap e.toRingHom)
    (fun q' _ hJq' hq' ↦ exists_restrictedJacobianChart B P hB q' hJq' hq')
    qR hJqR hqR
  -- carry the conclusion along `A{x}_{𝔮_R} ≃ A⟨x⟩_𝔮`
  obtain ⟨ℓ, hℓ, hℓbij⟩ := exists_localRingHom_bijective_of_ringEquiv e q
  refine ⟨fs.map ℓ, isRegular_map_of_bijective ℓ hℓbij fs hreg, ?_⟩
  rw [← Ideal.map_ofList, hfs, Ideal.map_map, hℓ, ← Ideal.map_map]
  congr 1
  exact Ideal.map_comap_of_surjective _ e.surjective _

/-- **Completed principal localization of a surjection.**  For a surjective homomorphism
`π : R → S` of Noetherian rings, an ideal `K` of `R` and `f ∈ R`, the induced map
`R_{\{f\}} → S_{\{π f\}}` is surjective with kernel `(ker π) R_{\{f\}}`: localization is exact,
and so is adic completion of finite modules over a Noetherian ring. -/
@[ega "0 7.3.1" "surjectivity of v̂"]
public theorem completedAwayMap_surjective_and_ker {R S : Type*} [CommRing R] [CommRing S]
    [IsNoetherianRing R] (π : R →+* S) (hπ : Function.Surjective π) (K : Ideal R) (f : R) :
    Function.Surjective (RingHom.completedAwayMap π K f) ∧
      RingHom.ker (RingHom.completedAwayMap π K f) =
        (RingHom.ker π).map (algebraMap R (CompletedAway K f)) := by
  have : IsNoetherianRing S := isNoetherianRing_of_surjective R S π hπ
  let φf : Localization.Away f →+* Localization.Away (π f) :=
    IsLocalization.Away.map (Localization.Away f) (Localization.Away (π f)) π f
  let : Algebra (Localization.Away f) (Localization.Away (π f)) := φf.toAlgebra
  have hmax : (K.map (algebraMap R (Localization.Away f))).map φf =
      (K.map π).map (algebraMap S (Localization.Away (π f))) := by
    rw [Ideal.map_map, Ideal.map_map, awayMap_comp_algebraMap]
  have heq : RingHom.completedAwayMap π K f =
      adicCompletionMap φf (K.map (algebraMap R (Localization.Away f)))
        ((K.map π).map (algebraMap S (Localization.Away (π f)))) hmax.le := by
    change Stacks.Nagata.PthRootDescent.mapAdicCompletion _ _ _ = _
    exact mapAdicCompletion_eq_adicCompletionMap _ _ _
  have hsurj : Function.Surjective φf := by
    intro z
    obtain ⟨⟨x, ⟨_, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (π f)) z
    obtain ⟨r, rfl⟩ := hπ x
    refine ⟨IsLocalization.mk' (Localization.Away f) r
      (⟨f ^ n, n, rfl⟩ : Submonoid.powers f), ?_⟩
    simp only [φf, IsLocalization.Away.map, IsLocalization.map_mk', map_pow]
  have hker : RingHom.ker φf = (RingHom.ker π).map (algebraMap R (Localization.Away f)) :=
    IsLocalization.ker_map (M := Submonoid.powers f) (Localization.Away (π f)) π
      (Submonoid.map_powers π f)
  rw [heq]
  refine ⟨LocalCompleteIntersection.adicCompletionMap_surjective_of_map_eq φf _ _ hmax hsurj, ?_⟩
  rw [LocalCompleteIntersection.adicCompletionMap_ker_eq_map_ker_of_surjective φf _ _ hmax hsurj,
    hker, Ideal.map_map, ← IsScalarTower.algebraMap_eq]

/-- **Jacobian charts transport along a change of coefficients.**  Let
`Θ : A{x₁, …, x_n} → A'{x₁, …, x_n}` commute with the formal partial derivatives, with the
coefficient ideal of `A'{x}` contained in the extension of that of `A{x}`.  If `J` has a
Jacobian chart at every prime of the generic fibre containing it, so does `J A'{x}`: the images
of a chart at `Θ⁻¹(𝔮')` form a chart at `𝔮'`. -/
public theorem forall_jacobianChart_map {A A' : Type*} [CommRing A] [CommRing A']
    {I : Ideal A} {K : Ideal A'} {n : ℕ}
    (Θ : RestrictedPowerSeries I (Fin n) →+* RestrictedPowerSeries K (Fin n))
    (hΘD : ∀ i x, restrictedPartialDeriv K i (Θ x) = Θ (restrictedPartialDeriv I i x))
    (hK : coefficientIdeal K (Fin n) ≤ (coefficientIdeal I (Fin n)).map Θ)
    (J : Ideal (RestrictedPowerSeries I (Fin n)))
    (hchart : ∀ (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime], J ≤ q →
      ¬ coefficientIdeal I (Fin n) ≤ q → ∃ (m : ℕ) (T : Fin m ↪ Fin n)
        (y : Fin m → RestrictedPowerSeries I (Fin n)), (∀ j, y j ∈ J) ∧
        Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (y j)) ∉ q ∧
        J.map (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q)) =
          Ideal.span (Set.range fun j ↦
            algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q) (y j)))
    (Q : Ideal (RestrictedPowerSeries K (Fin n))) [Q.IsPrime] (hJQ : J.map Θ ≤ Q)
    (hQ : ¬ coefficientIdeal K (Fin n) ≤ Q) :
    ∃ (m : ℕ) (T : Fin m ↪ Fin n) (y : Fin m → RestrictedPowerSeries K (Fin n)),
      (∀ j, y j ∈ J.map Θ) ∧
      Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv K (T i) (y j)) ∉ Q ∧
      (J.map Θ).map (algebraMap (RestrictedPowerSeries K (Fin n)) (Localization.AtPrime Q)) =
        Ideal.span (Set.range fun j ↦
          algebraMap (RestrictedPowerSeries K (Fin n)) (Localization.AtPrime Q) (y j)) := by
  let q := Q.comap Θ
  have hJq : J ≤ q := Ideal.map_le_iff_le_comap.mp hJQ
  have hq : ¬ coefficientIdeal I (Fin n) ≤ q := fun h ↦
    hQ (hK.trans (Ideal.map_le_iff_le_comap.mpr h))
  obtain ⟨m, T, y, hyJ, hdet, hgen⟩ := hchart q hJq hq
  refine ⟨m, T, fun j ↦ Θ (y j), fun j ↦ Ideal.mem_map_of_mem Θ (hyJ j), ?_, ?_⟩
  · rw [det_map_of_comm Θ (fun i ↦ ⇑(restrictedPartialDeriv I i))
      (fun i ↦ ⇑(restrictedPartialDeriv K i)) hΘD T y]
    exact hdet
  · exact map_map_atPrime_eq_span Θ Q hgen

/-- `Rig.completedAwayMap_surjective_and_ker` with the target ideal and element in any spelling
equal to the computed ones. -/
public theorem exists_completedAwayMap_surjective_and_ker {R S : Type*} [CommRing R] [CommRing S]
    [IsNoetherianRing R] (π : R →+* S) (hπ : Function.Surjective π) (K : Ideal R) (f : R)
    (L : Ideal S) (hL : K.map π = L) (g : S) (hg : π f = g) :
    ∃ ρ : CompletedAway K f →+* CompletedAway L g,
      ρ.comp (algebraMap R (CompletedAway K f)) = (algebraMap S (CompletedAway L g)).comp π ∧
      Function.Surjective ρ ∧
      RingHom.ker ρ = (RingHom.ker π).map (algebraMap R (CompletedAway K f)) := by
  subst hL hg
  obtain ⟨hs, hk⟩ := completedAwayMap_surjective_and_ker π hπ K f
  exact ⟨RingHom.completedAwayMap π K f, RingHom.completedAwayMap_comp_base π K f, hs, hk⟩

/-- **A presentation of a completed principal localization.**  For a completed polynomial
presentation `B = A⟨x⟩ / J` and `f ∈ A`, the completed principal localization `B_{\{f\}}` is the
quotient of `A_{\{f\}}{x}` by `J A_{\{f\}}{x}`, compatibly with the induced map
`A_{\{f\}} → B_{\{f\}}`: completed principal localization is exact on `A{x} → B`
(`Rig.exists_completedAwayMap_surjective_and_ker`), and `A{x}_{\{f\}} = A_{\{f\}}{x}` by Stacks
0GGG. The source's "details omitted" in the proof of Stacks 0GH1. -/
public theorem exists_restrictedPowerSeries_completedAway_surjective
    {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}
    {B : AdicFiniteTypeAlgebra.{u, v} A I} (P : CompletedPolynomialPresentation I B) (f : A) :
    ∃ ρ : RestrictedPowerSeries (completedAwayCoefficientIdeal I f) (Fin P.variableCount) →+*
        CompletedAway (I.map (algebraMap A B.carrier)) (algebraMap A B.carrier f),
      Function.Surjective ρ ∧
      RingHom.ker ρ = (P.ideal.comap
          (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingHom).map
        (restrictedPowerSeriesCompletedAwayHom I (Ideal.fg_of_isNoetherianRing I)
          (Fin P.variableCount) f) ∧
      ρ.comp (algebraMap (CompletedAway I f)
          (RestrictedPowerSeries (completedAwayCoefficientIdeal I f) (Fin P.variableCount))) =
        RingHom.completedAwayMap (algebraMap A B.carrier) I f := by
  have hIfg : I.FG := Ideal.fg_of_isNoetherianRing I
  obtain ⟨hsurj, hker⟩ := P.restrictedAlgHom_surjective_and_ker
  let n := P.variableCount
  have : IsNoetherianRing (RestrictedPowerSeries I (Fin n)) :=
    isNoetherianRing_restrictedPowerSeries I (Fin n)
  let π := P.restrictedAlgHom
  let K := completedAwayCoefficientIdeal I f
  let Bf := CompletedAway (I.map (algebraMap A B.carrier)) (algebraMap A B.carrier f)
  have hL : (coefficientIdeal I (Fin n)).map π.toRingHom = I.map (algebraMap A B.carrier) := by
    rw [Ideal.map_map]
    congr 1
    exact π.comp_algebraMap
  obtain ⟨ρ₀, hρ₀, hρ₀s, hρ₀k⟩ := exists_completedAwayMap_surjective_and_ker π.toRingHom hsurj
    (coefficientIdeal I (Fin n)) (coefficientRingHom I (Fin n) f) _ hL _ (π.commutes f)
  let E := restrictedPowerSeriesCompletedAwayEquiv I hIfg (Fin n) f
  let Ee := RingEquiv.ofBijective E
    (bijective_restrictedPowerSeriesCompletedAwayEquiv I hIfg (Fin n) f)
  let Θ := restrictedPowerSeriesCompletedAwayHom I hIfg (Fin n) f
  let ρ : RestrictedPowerSeries K (Fin n) →+* Bf := ρ₀.comp Ee.symm.toRingHom
  have hρk : RingHom.ker ρ = (P.ideal.comap
      (adicCompletionAlgEquiv I (Fin P.variableCount)).toRingHom).map Θ := by
    change RingHom.ker (ρ₀.comp Ee.symm.toRingHom) = _
    have hsymm : ∀ X : Ideal (CompletedAway (coefficientIdeal I (Fin n))
        (coefficientRingHom I (Fin n) f)), X.comap Ee.symm.toRingHom = X.map Ee.toRingHom :=
      fun X ↦ (Ideal.map_comap_of_equiv Ee).symm
    rw [← RingHom.comap_ker, hρ₀k, hsymm, hker, Ideal.map_map]
    rfl
  have hρΘ : ∀ x, ρ (Θ x) = algebraMap B.carrier Bf (π x) := fun x ↦ by
    change ρ₀ (Ee.symm (E (algebraMap _ _ x))) = _
    rw [show Ee.symm (E (algebraMap _ _ x)) = algebraMap _ _ x from Ee.symm_apply_apply _]
    exact DFunLike.congr_fun hρ₀ x
  have hsq := restrictedPowerSeriesCompletedAwayHom_comp_algebraMap I hIfg (Fin n) f
  have hbase : (ρ.comp (algebraMap (CompletedAway I f) (RestrictedPowerSeries K (Fin n)))).comp
      (algebraMap A (CompletedAway I f)) =
        (algebraMap B.carrier Bf).comp (algebraMap A B.carrier) := by
    refine RingHom.ext fun a ↦ ?_
    have h1 := DFunLike.congr_fun hsq a
    simp only [RingHom.comp_apply] at h1 ⊢
    rw [← h1, hρΘ, π.commutes]
  exact ⟨ρ, hρ₀s.comp Ee.symm.surjective, hρk,
    completedAwayHom_unique (algebraMap A B.carrier) I hIfg f _ rfl _ _ _ hbase
      (RingHom.completedAwayMap_comp_base (algebraMap A B.carrier) I f)⟩

/-- **Flatness on the generic fibre of a completed principal localization of a rig-smooth
algebra.**  Let `B` be rig-smooth over `(A, I)` and `f ∈ A`, and regard `B_{\{f\}}` as an
`A_{\{f\}}`-algebra through the induced map `ψ : A_{\{f\}} → B_{\{f\}}`.  Then `(B_{\{f\}})_𝔔` is
flat over `A_{\{f\}}` at every prime `𝔔` not containing `I B_{\{f\}}`.

A presentation of `B` gives one of `B_{\{f\}}` over `A_{\{f\}}`
(`Rig.exists_restrictedPowerSeries_completedAway_surjective`), the Jacobian charts transport to it
(`Rig.forall_jacobianChart_map`), and `Rig.flat_localization_atPrime_of_forall_jacobianChart`
applies over `A_{\{f\}}`. -/
public theorem flat_localization_atPrime_completedAway_of_isRigSmooth
    {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}
    (B : AdicFiniteTypeAlgebra.{u, v} A I) (hB : IsRigSmooth B) (f : A)
    (𝔔 : Ideal (CompletedAway (I.map (algebraMap A B.carrier)) (algebraMap A B.carrier f)))
    [𝔔.IsPrime]
    (h𝔔 : ¬ (completedAwayCoefficientIdeal I f).map
      (RingHom.completedAwayMap (algebraMap A B.carrier) I f) ≤ 𝔔) :
    letI : Algebra (CompletedAway I f)
        (CompletedAway (I.map (algebraMap A B.carrier)) (algebraMap A B.carrier f)) :=
      (RingHom.completedAwayMap (algebraMap A B.carrier) I f).toAlgebra
    Module.Flat (CompletedAway I f) (Localization.AtPrime 𝔔) := by
  have hIfg : I.FG := Ideal.fg_of_isNoetherianRing I
  rcases id hB with ⟨P, -⟩
  obtain ⟨ρ, hρs, hρk, hρψ⟩ := exists_restrictedPowerSeries_completedAway_surjective P f
  let n := P.variableCount
  let K := completedAwayCoefficientIdeal I f
  let : Algebra (CompletedAway I f)
      (CompletedAway (I.map (algebraMap A B.carrier)) (algebraMap A B.carrier f)) :=
    (RingHom.completedAwayMap (algebraMap A B.carrier) I f).toAlgebra
  let : TopologicalSpace (CompletedAway I f) := K.adicTopology
  let : IsTopologicalRing (CompletedAway I f) := K.nonarchimedean.toIsTopologicalRing
  let : IsLinearTopology (CompletedAway I f) (CompletedAway I f) := K.isLinearTopology
  have hKw := isWeaklyAdmissible_completedAway I hIfg f
  let : @CompleteSpace (CompletedAway I f)
      (IsTopologicalAddGroup.rightUniformSpace (CompletedAway I f)) := hKw.2.1
  let : T2Space (CompletedAway I f) := hKw.2.2
  have hKdef : TopologicalRing.IsIdealOfDefinition K :=
    (isIdealOfDefinition_iff_isAdic ⟨K, rfl⟩ K).2 rfl
  have hAf : TopologicalRing.IsAdic (CompletedAway I f) := ⟨⟨K, hKdef, rfl⟩, hKw.2.2, hKw.2.1⟩
  let ρA : RestrictedPowerSeries K (Fin n) →ₐ[CompletedAway I f]
      CompletedAway (I.map (algebraMap A B.carrier)) (algebraMap A B.carrier f) :=
    { ρ with commutes' := fun a ↦ DFunLike.congr_fun hρψ a }
  have hKΘ : coefficientIdeal K (Fin n) ≤
      (coefficientIdeal I (Fin n)).map
        (restrictedPowerSeriesCompletedAwayHom I hIfg (Fin n) f) := by
    refine le_of_eq ?_
    change (completedAwayCoefficientIdeal I f).map
        (algebraMap (CompletedAway I f) (RestrictedPowerSeries K (Fin n))) =
      (I.map (algebraMap A (RestrictedPowerSeries I (Fin n)))).map _
    have h := congrArg (Ideal.map (algebraMap (CompletedAway I f)
      (RestrictedPowerSeries K (Fin n)))) (completedAwayCoefficientIdeal_eq I f)
    rw [h, Ideal.map_map (algebraMap A (CompletedAway I f)),
      Ideal.map_map (algebraMap A (RestrictedPowerSeries I (Fin n))),
      restrictedPowerSeriesCompletedAwayHom_comp_algebraMap I hIfg (Fin n) f]
  exact flat_localization_atPrime_of_forall_jacobianChart hAf (I := K) rfl _
    (forall_jacobianChart_map _
      (restrictedPowerSeriesCompletedAwayHom_restrictedPartialDeriv I hIfg f) hKΘ _
      (fun q _ hJq hq ↦ exists_restrictedJacobianChart B P hB q hJq hq))
    ρA hρs hρk 𝔔 h𝔔

/-- **The completed principal localizations of a rig-smooth arrow are naively rig-flat.**  For a
rig-smooth arrow `φ : A → B` of `WAdm^{Noeth}`, rig-smooth over the ideal of definition `I`, and
`f ∈ A`, the induced map `A_{\{f\}} → B_{\{f\}}` is naively rig-flat: it is adic and topologically
of finite type, and flat on the generic fibre
(`Rig.flat_localization_atPrime_completedAway_of_isRigSmooth`), so condition (3) of Stacks 0GGL
holds. -/
public theorem isNaivelyRigFlat_completedAwayMap_of_isRigSmooth
    {A : Type u} {B : Type v}
    [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A]
    [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
    [IsNoetherianRing B]
    (φ : A →+* B) (hφ : Continuous φ)
    (hφft : TopologicalRing.IsTopologicallyOfFiniteType φ)
    (hft : FiniteTypeAdicAlgebraForEveryIdeal φ) (I : Ideal A)
    (hI : TopologicalRing.IsIdealOfDefinition I) (hIadic : _root_.IsAdic I)
    (hIφ : _root_.IsAdic (I.map φ)) (hsm : IsRigSmooth (adicFiniteTypeAlgebra φ hft I hI))
    (f : A) :
    let A_f := Localization.Away f
    let B_f := Localization.Away (φ f)
    let I_f := I.map (algebraMap A A_f)
    let J_f := (I.map φ).map (algebraMap B B_f)
    let I_hat := I_f.map (algebraMap A_f (AdicCompletion I_f A_f))
    let J_hat := J_f.map (algebraMap B_f (AdicCompletion J_f B_f))
    letI : TopologicalSpace (AdicCompletion I_f A_f) := I_hat.adicTopology
    letI : TopologicalSpace (AdicCompletion J_f B_f) := J_hat.adicTopology
    RingHom.IsNaivelyRigFlat (RingHom.completedAwayMap φ I f) := by
  let A_f := Localization.Away f
  let B_f := Localization.Away (φ f)
  let I_f := I.map (algebraMap A A_f)
  let J_f := (I.map φ).map (algebraMap B B_f)
  let I_hat := I_f.map (algebraMap A_f (AdicCompletion I_f A_f))
  let J_hat := J_f.map (algebraMap B_f (AdicCompletion J_f B_f))
  let : TopologicalSpace (AdicCompletion I_f A_f) := I_hat.adicTopology
  let : TopologicalSpace (AdicCompletion J_f B_f) := J_hat.adicTopology
  have hIfg : I.FG := Ideal.fg_of_isNoetherianRing I
  let : IsTopologicalRing (AdicCompletion I_f A_f) := I_hat.nonarchimedean.toIsTopologicalRing
  let : IsLinearTopology (AdicCompletion I_f A_f) (AdicCompletion I_f A_f) :=
    I_hat.isLinearTopology
  let : IsTopologicalRing (AdicCompletion J_f B_f) := J_hat.nonarchimedean.toIsTopologicalRing
  let : IsLinearTopology (AdicCompletion J_f B_f) (AdicCompletion J_f B_f) :=
    J_hat.isLinearTopology
  obtain ⟨hψft, -, hψc, -, -⟩ := RingHom.isTopologicallyOfFiniteType_completedAwayMap φ hφ hφft I
    hIadic hIφ f
  have hmap : I_hat.map (RingHom.completedAwayMap φ I f) = J_hat :=
    RingHom.completedAwayMap_map_ideal φ I f
  refine isNaivelyRigFlat_of_flat_localization_atPrime _ hψc
    (isWeaklyAdmissible_completedAway I hIfg f)
    (isWeaklyAdmissible_completedAway (I.map φ) (hIfg.map φ) (φ f))
    ⟨I_hat, rfl, Ideal.fg_of_isNoetherianRing _⟩ ⟨J_hat, rfl, Ideal.fg_of_isNoetherianRing _⟩
    (RingHom.isAdic_completedAwayMap φ I f) hψft I_hat (by rw [hmap]; rfl) fun 𝔔 h𝔔p h𝔔 ↦ ?_
  have h := @flat_localization_atPrime_completedAway_of_isRigSmooth A _ _ I
    (adicFiniteTypeAlgebra φ hft I hI) hsm f 𝔔 h𝔔p h𝔔
  let : Algebra (AdicCompletion I_f A_f) (AdicCompletion J_f B_f) :=
    (RingHom.completedAwayMap φ I f).toAlgebra
  rw [show (algebraMap (AdicCompletion J_f B_f) (Localization.AtPrime 𝔔)).comp
      (RingHom.completedAwayMap φ I f) = algebraMap (AdicCompletion I_f A_f)
        (Localization.AtPrime 𝔔) from
      (IsScalarTower.algebraMap_eq _ (AdicCompletion J_f B_f) _).symm]
  exact RingHom.flat_algebraMap_iff.mpr h

/-- **Stacks Project, Tag 0GH1.**  Let `φ : A → B` be an arrow of `WAdm^{Noeth}` — a continuous
homomorphism of Noetherian adic topological rings — which is rig-smooth.  Then `φ` is rig-flat,
and for every presentation `B = A⟨x₁, …, x_n⟩ / J` (over an ideal of definition `I` of `A`) and
every prime `J ⊆ 𝔮 ⊆ A⟨x⟩` not containing an ideal of definition, the ideal `J_𝔮` of `A⟨x⟩_𝔮` is
generated by a regular sequence.

Rig-flatness asks naive rig-flatness of every map `A_{\{f\}} → B_{\{f\}}`, which is
`Rig.isNaivelyRigFlat_completedAwayMap_of_isRigSmooth`; the regular sequences are
`Rig.exists_isRegular_ofList_eq_map_presentationIdeal`.  Both rest on the reduction of the
source's proof to a rig-closed prime lying over a rig-closed prime, through the completed
principal localization of Stacks 0GGG, where the Jacobian criterion on the regular fibre
(Stacks 0GGJ, 0GEE, 00MG) concludes. -/
@[stacks 0GH1]
public theorem isRigFlat_and_exists_isRegular_of_isRigSmooth
    {A : Type u} {B : Type v}
    [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A]
    [CommRing B] [TopologicalSpace B] [IsTopologicalRing B] [IsLinearTopology B B]
    [IsNoetherianRing B]
    (hA : TopologicalRing.IsAdic A) (hB : TopologicalRing.IsAdic B)
    (φ : A →+* B) (hφ : Continuous φ) (hsm : _root_.RingHom.IsRigSmooth φ) :
    RingHom.IsRigFlat φ ∧
      ∀ (hft : FiniteTypeAdicAlgebraForEveryIdeal φ) (I : Ideal A)
        (hI : TopologicalRing.IsIdealOfDefinition I)
        (P : CompletedPolynomialPresentation I (adicFiniteTypeAlgebra φ hft I hI))
        (q : Ideal P.completedPolynomialRing) [q.IsPrime],
        ¬ I.map (algebraMap A P.completedPolynomialRing) ≤ q → P.ideal ≤ q →
        ∃ fs : List (Localization.AtPrime q),
          RingTheory.Sequence.IsRegular (Localization.AtPrime q) fs ∧
            Ideal.ofList fs =
              P.ideal.map (algebraMap P.completedPolynomialRing (Localization.AtPrime q)) := by
  obtain ⟨hft₀, I₀, hI₀, hsm₀⟩ := hsm
  have hrig : ∀ (hft : FiniteTypeAdicAlgebraForEveryIdeal φ) (I : Ideal A)
      (hI : TopologicalRing.IsIdealOfDefinition I),
      IsRigSmooth (adicFiniteTypeAlgebra φ hft I hI) := fun hft ↦
    (isRigSmooth_iff_forall_idealOfDefinition (weaklyAdmissible_of_isAdicRing hA)
      (weaklyAdmissible_of_isAdicRing hB) φ hφ hft).mp ⟨I₀, hI₀, hsm₀⟩
  obtain ⟨J₀, hJ₀, -⟩ := hB.1
  have hφadic : _root_.RingHom.IsAdic φ ∧ TopologicalRing.IsTopologicallyOfFiniteType φ :=
    ((adicFiniteType_tfae φ hA hB ⟨I₀, hI₀, Ideal.fg_of_isNoetherianRing I₀⟩
      ⟨J₀, hJ₀, Ideal.fg_of_isNoetherianRing J₀⟩).out 6 1).mp hft₀
  obtain ⟨K₀, hK₀⟩ := hA.1
