/-!
# Regular sequences of a rig-smooth presentation at every prime of the generic fibre

Let `A` be a Noetherian adic ring with ideal of definition `I` and let `J` be an ideal of the
restricted power series ring `A{x₁, …, x_n}` with a Jacobian chart at every prime of the generic
fibre containing it: elements `y₁, …, y_m ∈ J` generating `J_𝔮` with `det (∂y_j/∂x_{T i}) ∉ 𝔮`.
This file proves that `J_𝔮` is then generated by a regular sequence, with `A{x}_𝔮 ⧸ J_𝔮` flat
over `A`, at every such prime `𝔮` — the second and third paragraphs of the proof of Stacks
0GH1, which reduce to the case of
`Rig.isRegular_and_flat_of_isUnit_det_of_isRigPointLocalCondition`.

* The third paragraph removes the hypothesis that `𝔮 ∩ A` be rig-closed when `𝔮` is
  rig-closed: Stacks 0GGG gives `f ∈ A` such that, through `A{x}_{\{f\}} = A_{\{f\}}{x}`, the prime
  `𝔮` comes from a prime of `A_{\{f\}}{x}` over a rig-closed prime of `A_{\{f\}}`.  The map
  `A{x} → A_{\{f\}}{x}` is flat and commutes with `∂/∂xᵢ`, so the chart stays a chart, and the
  regular sequence and the flatness descend along the flat local map of local rings
  (Stacks 00LM and flat descent of flatness).
* The second paragraph reduces an arbitrary prime of the generic fibre to a rig-closed one
  containing it, and localizes.

## Main results

* `Rig.isRegular_and_flat_of_flat_localRingHom`: descent along a flat local homomorphism.
* `Rig.restrictedPowerSeriesCompletedAwayHom`: the map `A{σ} → A_{\{f\}}{σ}`, with its
  compatibility with derivatives, coefficients and flatness.
* `Rig.exists_comap_restrictedPowerSeriesCompletedAwayHom_eq`: Stacks 0GGG read on
  `A_{\{f\}}{x}`.
* `Rig.isRegular_and_flat_of_isUnit_det_of_isClosedPointAwayFrom`: the chart is a regular
  sequence with flat quotient at every rig-closed prime.
* `Rig.exists_isRegular_and_flat_of_forall_jacobianChart`: the same at every prime of the
  generic fibre.

## References

* [Stacks Project, Tag 0GH1](https://stacks.math.columbia.edu/tag/0GH1)
* [Stacks Project, Tag 0GGG](https://stacks.math.columbia.edu/tag/0GGG)
* [Stacks Project, Tag 00LM](https://stacks.math.columbia.edu/tag/00LM)
-/

@[expose] public noncomputable section

open RingTheory.Sequence TensorProduct RestrictedPowerSeries

universe u v

namespace Rig

/-- **Regular sequences and flat quotients descend along a flat local homomorphism.**  Let
`Θ : R → R'` be a flat ring homomorphism over a flat ring map `A → A'`, and let `Q` be a prime of
`R'` lying over the prime `q` of `R`.  If the images of a sequence `rs` of `R` form a regular
sequence in `R'_Q` whose quotient is flat over `A'`, then `rs` is a regular sequence in `R_q`
whose quotient is flat over `A`.

The local homomorphism `R_q → R'_Q` is flat and local, hence faithfully flat; Stacks 00LM reflects
regularity along it, and flatness over `A` of `R_q ⧸ (rs)` is read off its faithfully flat base
change `R'_Q ⧸ (rs)`, which is flat over `A'` and so over `A`. -/
public theorem isRegular_and_flat_of_flat_localRingHom
    {A A' R R' : Type*} [CommRing A] [CommRing A'] [CommRing R] [CommRing R']
    [Algebra A R] [Algebra A' R'] [Algebra A A'] [Module.Flat A A']
    (Θ : R →+* R') (hsq : Θ.comp (algebraMap A R) = (algebraMap A' R').comp (algebraMap A A'))
    (hΘ : Θ.Flat) (q : Ideal R) [q.IsPrime] (Q : Ideal R') [Q.IsPrime] (hQ : q = Q.comap Θ)
    (rs : List R)
    (hreg : IsRegular (Localization.AtPrime Q)
      (rs.map ((algebraMap R' (Localization.AtPrime Q)).comp Θ)))
    (hflat : Module.Flat A' (Localization.AtPrime Q ⧸
      Ideal.ofList (rs.map ((algebraMap R' (Localization.AtPrime Q)).comp Θ)))) :
    IsRegular (Localization.AtPrime q) (rs.map (algebraMap R (Localization.AtPrime q))) ∧
      Module.Flat A (Localization.AtPrime q ⧸
        Ideal.ofList (rs.map (algebraMap R (Localization.AtPrime q)))) := by
  let C := Localization.AtPrime q
  let D := Localization.AtPrime Q
  let ℓ : C →+* D := Localization.localRingHom q Q Θ hQ
  let : Algebra C D := ℓ.toAlgebra
  have hℓflat : Module.Flat C D := RingHom.Flat.localRingHom hΘ Q q hQ
  have : IsLocalHom (algebraMap C D) := Localization.isLocalHom_localRingHom q Q Θ hQ
  have : Module.FaithfullyFlat C D := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hmap : (rs.map (algebraMap R C)).map (algebraMap C D) =
      rs.map ((algebraMap R' D).comp Θ) := by
    rw [List.map_map]
    exact List.map_congr_left fun x _ ↦ Localization.localRingHom_to_map q Q Θ hQ x
  refine ⟨(isRegular_map_algebraMap_iff_of_faithfullyFlat_of_isBaseChange
    (IsBaseChange.linearMap C D) (rs.map (algebraMap R C))).mp (hmap ▸ hreg), ?_⟩
  let J : Ideal C := Ideal.ofList (rs.map (algebraMap R C))
  let K : Ideal D := J.map (algebraMap C D)
  have hK : K = Ideal.ofList (rs.map ((algebraMap R' D).comp Θ)) := by
    show J.map (algebraMap C D) = _
    rw [Ideal.map_ofList, hmap]
  let : Algebra A D := (ℓ.comp (algebraMap A C)).toAlgebra
  have : IsScalarTower A C D := IsScalarTower.of_algebraMap_eq' rfl
  have hAD : algebraMap A D = (algebraMap A' D).comp (algebraMap A A') := by
    refine RingHom.ext fun a ↦ ?_
    show ℓ (algebraMap A C a) = algebraMap A' D (algebraMap A A' a)
    rw [IsScalarTower.algebraMap_apply A R C a, Localization.localRingHom_to_map q Q Θ hQ,
      IsScalarTower.algebraMap_apply A' R' D, ← RingHom.comp_apply Θ, hsq, RingHom.comp_apply]
  have : IsScalarTower A A' D := IsScalarTower.of_algebraMap_eq' hAD
  have hflatK : Module.Flat A' (D ⧸ K) := by rwa [hK]
  have : Module.Flat A (D ⧸ K) := Module.Flat.trans A A' (D ⧸ K)
  let e : (D ⧸ K) ≃ₗ[D] D ⊗[C] (C ⧸ J) := J.qoutMapEquivTensorQout (S := D)
  have : Module.Flat A (D ⊗[C] (C ⧸ J)) := Module.Flat.of_linearEquiv (e.restrictScalars A).symm
  exact Module.Flat.of_tensorProduct_of_faithfullyFlat (A := A) (C := C) (D := D)

/-- **Coefficientwise reduction commutes with formal partial differentiation.**  Both are computed
coefficient quotient by coefficient quotient, where the identity is `MvPolynomial.pderiv_map`. -/
public theorem restrictedPowerSeriesMap_restrictedPartialDeriv {A B : Type u} [CommRing A]
    [CommRing B] [Algebra A B] (I : Ideal A) {σ : Type*} (i : σ)
    (x : RestrictedPowerSeries I σ) :
    TopologicalRing.restrictedPowerSeriesMap (B := B) I σ (restrictedPartialDeriv I i x) =
      restrictedPartialDeriv (I.map (algebraMap A B)) i
        (TopologicalRing.restrictedPowerSeriesMap I σ x) := by
  rw [restrictedPartialDeriv_apply, restrictedPartialDeriv_apply]
  refine RestrictedPowerSeries.idealSystem_ext fun n ↦ ?_
  rw [TopologicalRing.coefficientProjection_restrictedPowerSeriesMap,
    coefficientProjection_partialDerivative, coefficientProjection_partialDerivative,
    TopologicalRing.coefficientProjection_restrictedPowerSeriesMap]
  exact MvPolynomial.pderiv_map.symm

/-- **The coefficientwise map `A{σ} → A_{\{f\}}{σ}`.**  The structure map of the completed
principal localization of `A{σ}` at `f`, followed by the identification
`A{σ}_{\{f\}} = A_{\{f\}}{σ}` of Stacks 0GGG. -/
public noncomputable def restrictedPowerSeriesCompletedAwayHom {A : Type*} [CommRing A]
    (I : Ideal A) (hI : I.FG) (σ : Type*) (f : A) :
    RestrictedPowerSeries I σ →+* RestrictedPowerSeries (completedAwayCoefficientIdeal I f) σ :=
  (restrictedPowerSeriesCompletedAwayEquiv I hI σ f).comp
    (algebraMap (RestrictedPowerSeries I σ)
      (CompletedAway (coefficientIdeal I σ) (coefficientRingHom I σ f)))

/-- **The map `A{σ} → A_{\{f\}}{σ}` commutes with formal partial differentiation.**  It is the
coefficientwise reduction along `A → A[1/f] → A_{\{f\}}`, which commutes with `∂/∂xᵢ`. -/
public theorem restrictedPowerSeriesCompletedAwayHom_restrictedPartialDeriv
    {A : Type*} [CommRing A] (I : Ideal A) (hI : I.FG) {σ : Type*} (f : A) (i : σ)
    (x : RestrictedPowerSeries I σ) :
    restrictedPartialDeriv (completedAwayCoefficientIdeal I f) i
        (restrictedPowerSeriesCompletedAwayHom I hI σ f x) =
      restrictedPowerSeriesCompletedAwayHom I hI σ f (restrictedPartialDeriv I i x) := by
  have h := TopologicalRing.restrictedPowerSeriesMap_comp_completedAway_comp_algebraMap I hI σ f
  have key : ∀ y : RestrictedPowerSeries I σ,
      restrictedPowerSeriesCompletedAwayHom I hI σ f y =
        TopologicalRing.restrictedPowerSeriesMap (B := CompletedAway I f)
          (I.map (algebraMap A (Localization.Away f))) σ
          (TopologicalRing.restrictedPowerSeriesMap (B := Localization.Away f) I σ y) :=
    fun y ↦ DFunLike.congr_fun h y
  rw [key, key, restrictedPowerSeriesMap_restrictedPartialDeriv,
    restrictedPowerSeriesMap_restrictedPartialDeriv]

/-- **The map `A{σ} → A_{\{f\}}{σ}` is compatible with the coefficient maps.**  On a constant
`a ∈ A` it gives the constant series of the image of `a` in `A_{\{f\}}`. -/
public theorem restrictedPowerSeriesCompletedAwayHom_comp_algebraMap
    {A : Type*} [CommRing A] [IsNoetherianRing A] (I : Ideal A) (hI : I.FG) (σ : Type*) (f : A) :
    (restrictedPowerSeriesCompletedAwayHom I hI σ f).comp
        (algebraMap A (RestrictedPowerSeries I σ)) =
      (algebraMap (CompletedAway I f)
          (RestrictedPowerSeries (completedAwayCoefficientIdeal I f) σ)).comp
        (algebraMap A (CompletedAway I f)) := by
  refine RingHom.ext fun a ↦ ?_
  have h1 := DFunLike.congr_fun
    (RingHom.completedAwayMap_comp_base (coefficientRingHom I σ) I f) a
  have h2 := DFunLike.congr_fun
    (restrictedPowerSeriesCompletedAwayEquiv_comp_completedAwayMap I hI σ f)
    (algebraMap A (CompletedAway I f) a)
  simp only [RingHom.comp_apply] at h1 h2
  show restrictedPowerSeriesCompletedAwayEquiv I hI σ f
      (algebraMap (RestrictedPowerSeries I σ) _ (coefficientRingHom I σ a)) =
    coefficientRingHom (completedAwayCoefficientIdeal I f) σ (algebraMap A (CompletedAway I f) a)
  rwa [← h1]

/-- **The map `A{σ} → A_{\{f\}}{σ}` is flat**, being the flat map to a completed principal
localization of the Noetherian ring `A{σ}` followed by an isomorphism. -/
public theorem flat_restrictedPowerSeriesCompletedAwayHom {A : Type*} [CommRing A]
    [IsNoetherianRing A] (I : Ideal A) (hI : I.FG) (σ : Type*) [Finite σ] (f : A) :
    (restrictedPowerSeriesCompletedAwayHom I hI σ f).Flat := by
  have : IsNoetherianRing (RestrictedPowerSeries I σ) := isNoetherianRing_restrictedPowerSeries I σ
  exact (flat_algebraMap_completedAway (coefficientIdeal I σ) (coefficientRingHom I σ f)).comp
    (RingHom.Flat.of_bijective (bijective_restrictedPowerSeriesCompletedAwayEquiv I hI σ f))

/-- **Stacks 0GGG for a restricted power series ring, read on `A_{\{f\}}{x}`.**  For a rig-closed
prime `𝔮` of `A{x₁, …, x_n}` there are `f ∈ A` and a prime `𝔮'` of `A_{\{f\}}{x}` with
`𝔮 = 𝔮' ∩ A{x}`, whose contraction to `A_{\{f\}}` is rig-closed. -/
public theorem exists_comap_restrictedPowerSeriesCompletedAwayHom_eq
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A] (hA : TopologicalRing.IsAdic A) {I : Ideal A} (hI : _root_.IsAdic I)
    {n : ℕ} (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime]
    (hq : Ideal.IsClosedPointAwayFrom (coefficientIdeal I (Fin n)) q) :
    ∃ (f : A) (Q : Ideal (RestrictedPowerSeries (completedAwayCoefficientIdeal I f) (Fin n)))
      (_ : Q.IsPrime),
      q = Q.comap (restrictedPowerSeriesCompletedAwayHom I (Ideal.fg_of_isNoetherianRing I)
        (Fin n) f) ∧
      Ideal.IsClosedPointAwayFrom (completedAwayCoefficientIdeal I f)
        (Q.comap (algebraMap (CompletedAway I f)
          (RestrictedPowerSeries (completedAwayCoefficientIdeal I f) (Fin n)))) := by
  have hIfg : I.FG := Ideal.fg_of_isNoetherianRing I
  have : IsNoetherianRing (RestrictedPowerSeries I (Fin n)) :=
    isNoetherianRing_restrictedPowerSeries I (Fin n)
  have : IsLinearTopology (RestrictedPowerSeries I (Fin n)) (RestrictedPowerSeries I (Fin n)) :=
    isLinearTopology_restrictedPowerSeries I hIfg (Fin n)
  have : IsAdicComplete (coefficientIdeal I (Fin n)) (RestrictedPowerSeries I (Fin n)) :=
    isAdicComplete_restrictedPowerSeries I (Fin n)
  have hLadic : _root_.IsAdic (coefficientIdeal I (Fin n)) := isAdic_coefficientIdeal I hIfg (Fin n)
  have hft : TopologicalRing.IsTopologicallyOfFiniteType (coefficientRingHom I (Fin n)) := by
    rw [hLadic]
    exact isTopologicallyOfFiniteType_coefficientRingHom I (Fin n)
  obtain ⟨f, hunit, ψ₀, hcomm₀, hq'prime, hp'prime, -, hp'closed⟩ :=
    exists_isClosedPointAwayFrom_completedAway_comap_of_map_eq (weaklyAdmissible_of_isAdicRing hA)
      (isWeaklyAdmissible_restrictedPowerSeries I hIfg (Fin n)) (coefficientRingHom I (Fin n))
      (continuous_coefficientRingHom I hI hIfg (Fin n)) I hI (coefficientIdeal I (Fin n)) rfl
      hLadic hft q (isClosedPointAwayFrom_topologicalNilradical_of_isAdic _ hLadic q hq)
  have hψ₀ : ψ₀ = RingHom.completedAwayMap (coefficientRingHom I (Fin n)) I f :=
    completedAwayHom_unique (coefficientRingHom I (Fin n)) I hIfg f (coefficientIdeal I (Fin n))
      rfl _ ψ₀ _ hcomm₀ (RingHom.completedAwayMap_comp_base (coefficientRingHom I (Fin n)) I f)
  subst hψ₀
  let q' := extendedIdeal (coefficientIdeal I (Fin n)) q (coefficientRingHom I (Fin n) f)
  let Ee := RingEquiv.ofBijective _
    (bijective_restrictedPowerSeriesCompletedAwayEquiv I hIfg (Fin n) f)
  let Q := q'.comap Ee.symm.toRingHom
  have hQE : Q.comap (restrictedPowerSeriesCompletedAwayEquiv I hIfg (Fin n) f) = q' := by
    show (q'.comap Ee.symm.toRingHom).comap Ee.toRingHom = q'
    rw [Ideal.comap_comap]
    convert Ideal.comap_id q'
    exact RingHom.ext fun x ↦ Ee.symm_apply_apply x
  refine ⟨f, Q, Ideal.comap_isPrime _ _, ?_, ?_⟩
  · show q = Q.comap ((restrictedPowerSeriesCompletedAwayEquiv I hIfg (Fin n) f).comp _)
    rw [← Ideal.comap_comap, hQE]
    exact (comap_extendedIdeal_eq (coefficientIdeal I (Fin n)) q (coefficientRingHom I (Fin n) f)
      hunit).symm
  · have hp'' : Q.comap (algebraMap (CompletedAway I f)
          (RestrictedPowerSeries (completedAwayCoefficientIdeal I f) (Fin n))) = q'.comap
        (RingHom.completedAwayMap (coefficientRingHom I (Fin n)) I f) := by
      show Q.comap (coefficientRingHom (completedAwayCoefficientIdeal I f) (Fin n)) = _
      rw [comap_coefficientRingHom_completedAway I hIfg (Fin n) f Q, hQE]
    exact isClosedPointAwayFrom_congr_prime _ _ _ hp''.symm hp'closed

/-- A ring homomorphism intertwining two families of operators carries the determinant of a
Jacobian-type matrix to the determinant of the corresponding matrix. -/
public theorem det_map_of_comm {R R' ι : Type*} [CommRing R] [CommRing R'] (Θ : R →+* R')
    (D : ι → R → R) (D' : ι → R' → R') (h : ∀ i x, D' i (Θ x) = Θ (D i x)) {m : ℕ}
    (T : Fin m → ι) (y : Fin m → R) :
    Matrix.det (fun i j : Fin m ↦ D' (T i) (Θ (y j))) =
      Θ (Matrix.det fun i j : Fin m ↦ D (T i) (y j)) := by
  rw [RingHom.map_det Θ (fun i j : Fin m ↦ D (T i) (y j))]
  congr 1
  exact Matrix.ext fun i j ↦ h _ _

/-- Mapping `List.ofFn y` by a function is `List.ofFn` of the pointwise image. -/
private theorem map_ofFn_apply {α β : Type*} {m : ℕ} (g : α → β) (y : Fin m → α) :
    (List.ofFn y).map g = List.ofFn fun j ↦ g (y j) := by
  rw [List.map_ofFn]
  rfl

/-- **The descent step of Stacks 0GH1, for an abstract flat change of coefficients.**  Let
`Θ : A{x₁, …, x_n} → A'{x₁, …, x_n}` be a flat ring homomorphism over a flat ring map `A → A'`,
commuting with the formal partial derivatives, where `A'` is a Noetherian adic ring with ideal of
definition `K`.  Let `𝔮 = Θ⁻¹(𝔮')` for a prime `𝔮'` lying over a rig-closed prime of `A'`.  If
`y₁, …, y_m ∈ 𝔮` have `det (∂y_j/∂x_{T i}) ∉ 𝔮`, the `y_j` form a regular sequence in `A{x}_𝔮`
with quotient flat over `A`: the images `Θ(y_j)` do so in `A'{x}_{𝔮'}` by
`Rig.isRegular_and_flat_of_isUnit_det_of_isRigPointLocalCondition`, and both properties descend
by `Rig.isRegular_and_flat_of_flat_localRingHom`. -/
public theorem isRegular_and_flat_of_isUnit_det_of_flat_restrictedPowerSeriesHom
    {A A' : Type u} [CommRing A] [CommRing A'] [Algebra A A'] [Module.Flat A A']
    [IsNoetherianRing A'] [TopologicalSpace A'] [IsTopologicalRing A']
    (hA' : TopologicalRing.IsAdic A') {I : Ideal A} {K : Ideal A'} (hK : _root_.IsAdic K) {n : ℕ}
    (Θ : RestrictedPowerSeries I (Fin n) →+* RestrictedPowerSeries K (Fin n))
    (hΘD : ∀ i x, restrictedPartialDeriv K i (Θ x) = Θ (restrictedPartialDeriv I i x))
    (hsq : Θ.comp (algebraMap A (RestrictedPowerSeries I (Fin n))) =
      (algebraMap A' (RestrictedPowerSeries K (Fin n))).comp (algebraMap A A'))
    (hΘ : Θ.Flat) (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime]
    (Q : Ideal (RestrictedPowerSeries K (Fin n))) [Q.IsPrime] (hQ : q = Q.comap Θ)
    (hp : Ideal.IsRigPointLocalCondition
      (Q.comap (algebraMap A' (RestrictedPowerSeries K (Fin n)))))
    {m : ℕ} (T : Fin m ↪ Fin n) (y : Fin m → RestrictedPowerSeries I (Fin n))
    (hy : ∀ j, y j ∈ q)
    (hdet : Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (y j)) ∉ q) :
    IsRegular (Localization.AtPrime q)
        (List.ofFn fun j ↦ algebraMap (RestrictedPowerSeries I (Fin n))
          (Localization.AtPrime q) (y j)) ∧
      Module.Flat A (Localization.AtPrime q ⧸ Ideal.ofList (List.ofFn fun j ↦
        algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q) (y j))) := by
  rw [hQ] at hdet hy
  have hdet' : Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv K (T i) (Θ (y j))) ∉ Q := by
    rw [det_map_of_comm Θ (fun i ↦ ⇑(restrictedPartialDeriv I i))
      (fun i ↦ ⇑(restrictedPartialDeriv K i)) hΘD T y]
    exact hdet
  have hy' : ∀ j, Θ (y j) ∈ Q := hy
  obtain ⟨hreg', hflat'⟩ := isRegular_and_flat_of_isUnit_det_of_isRigPointLocalCondition hA'
    hK (fun i ↦ restrictedPartialDeriv K i) Q hp T (fun j ↦ Θ (y j)) hy' hdet'
  obtain ⟨hreg, hflat⟩ := isRegular_and_flat_of_flat_localRingHom Θ hsq hΘ q Q hQ (List.ofFn y)
    (by rwa [map_ofFn_apply]) (by rwa [map_ofFn_apply])
  rw [← map_ofFn_apply]
  exact ⟨hreg, hflat⟩

/-- **Elements with an invertible Jacobian minor at a rig-closed prime form a regular sequence.**
Let `A` be a Noetherian adic ring with ideal of definition `I`, let `𝔮` be a rig-closed prime of
`A{x₁, …, x_n}`, and let `y₁, …, y_m ∈ 𝔮` be such that `det (∂y_j/∂x_{T i}) ∉ 𝔮` for an
injection `T` of `{1, …, m}` into `{1, …, n}`.  Then the images of the `y_j` form a regular
sequence in `A{x}_𝔮`, and the quotient of `A{x}_𝔮` by them is flat over `A`.

This is the third paragraph of the proof of Stacks 0GH1: Stacks 0GGG supplies `f ∈ A` such
that, through `A{x}_{\{f\}} = A_{\{f\}}{x}`, the prime `𝔮` becomes the contraction of a prime of
`A_{\{f\}}{x}` lying over a rig-closed prime
(`Rig.exists_comap_restrictedPowerSeriesCompletedAwayHom_eq`), and
`Rig.isRegular_and_flat_of_isUnit_det_of_flat_restrictedPowerSeriesHom` descends both
conclusions along the flat map `A{x} → A_{\{f\}}{x}`. -/
public theorem isRegular_and_flat_of_isUnit_det_of_isClosedPointAwayFrom
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A] (hA : TopologicalRing.IsAdic A) {I : Ideal A} (hI : _root_.IsAdic I)
    {n : ℕ} (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime]
    (hq : Ideal.IsClosedPointAwayFrom (coefficientIdeal I (Fin n)) q)
    {m : ℕ} (T : Fin m ↪ Fin n) (y : Fin m → RestrictedPowerSeries I (Fin n))
    (hy : ∀ j, y j ∈ q)
    (hdet : Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (y j)) ∉ q) :
    IsRegular (Localization.AtPrime q)
        (List.ofFn fun j ↦ algebraMap (RestrictedPowerSeries I (Fin n))
          (Localization.AtPrime q) (y j)) ∧
      Module.Flat A (Localization.AtPrime q ⧸ Ideal.ofList (List.ofFn fun j ↦
        algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q) (y j))) := by
  have hIfg : I.FG := Ideal.fg_of_isNoetherianRing I
  obtain ⟨f, Q, _, hQ, hpclosed⟩ :=
    exists_comap_restrictedPowerSeriesCompletedAwayHom_eq hA hI q hq
  let K : Ideal (CompletedAway I f) := completedAwayCoefficientIdeal I f
  let : TopologicalSpace (CompletedAway I f) := K.adicTopology
  let : IsTopologicalRing (CompletedAway I f) := K.nonarchimedean.toIsTopologicalRing
  let : IsLinearTopology (CompletedAway I f) (CompletedAway I f) := K.isLinearTopology
  have hKw := isWeaklyAdmissible_completedAway I hIfg f
  let : @CompleteSpace (CompletedAway I f)
      (IsTopologicalAddGroup.rightUniformSpace (CompletedAway I f)) := hKw.2.1
  let : T2Space (CompletedAway I f) := hKw.2.2
  have hKdef : TopologicalRing.IsIdealOfDefinition K :=
    (isIdealOfDefinition_iff_isAdic ⟨K, rfl⟩ K).2 rfl
  have hAf : TopologicalRing.IsAdic (CompletedAway I f) := ⟨⟨K, hKdef, rfl⟩, hKw.2.2, hKw.2.1⟩
  have : Module.Flat A (CompletedAway I f) :=
    RingHom.flat_algebraMap_iff.mp (flat_algebraMap_completedAway I f)
  have hplocal : Ideal.IsRigPointLocalCondition
      (Q.comap (algebraMap (CompletedAway I f) (RestrictedPowerSeries K (Fin n)))) := by
    have hKa : ∃ J : Ideal (CompletedAway I f), _root_.IsAdic J := ⟨K, rfl⟩
    have htfae := rigPoint_tfae (A := CompletedAway I f) hKa
      (Q.comap (algebraMap (CompletedAway I f) (RestrictedPowerSeries K (Fin n))))
    have h2 : ∃ J : Ideal (CompletedAway I f), TopologicalRing.IsIdealOfDefinition J ∧
        Ideal.IsClosedPointAwayFrom J
          (Q.comap (algebraMap (CompletedAway I f) (RestrictedPowerSeries K (Fin n)))) :=
      ⟨K, hKdef, hpclosed⟩
    exact (htfae.out 2 8).mp h2
  exact isRegular_and_flat_of_isUnit_det_of_flat_restrictedPowerSeriesHom hAf (K := K) rfl
    (restrictedPowerSeriesCompletedAwayHom I hIfg (Fin n) f)
    (restrictedPowerSeriesCompletedAwayHom_restrictedPartialDeriv I hIfg f)
    (restrictedPowerSeriesCompletedAwayHom_comp_algebraMap I hIfg (Fin n) f)
    (flat_restrictedPowerSeriesCompletedAwayHom I hIfg (Fin n) f) q Q hQ hplocal T y hy hdet

/-- **Regular sequences with flat quotient ascend along a flat map into a local ring.**  If `rs`
is a weakly regular sequence in `S` with `S ⧸ (rs)` flat over `A`, and `S → S'` is flat with
`S'` local and the images of `rs` in its maximal ideal, then the images of `rs` form a regular
sequence in `S'` with `S' ⧸ (rs)` flat over `A`. -/
public theorem isRegular_and_flat_of_flat_of_isWeaklyRegular {A S S' : Type*} [CommRing A]
    [CommRing S] [CommRing S'] [Algebra A S] [Algebra S S'] [Algebra A S'] [IsScalarTower A S S']
    [Module.Flat S S'] [IsLocalRing S'] (rs : List S) (hreg : IsWeaklyRegular S rs)
    (hflat : Module.Flat A (S ⧸ Ideal.ofList rs))
    (hmem : ∀ r ∈ rs, algebraMap S S' r ∈ IsLocalRing.maximalIdeal S') :
    IsRegular S' (rs.map (algebraMap S S')) ∧
      Module.Flat A (S' ⧸ Ideal.ofList (rs.map (algebraMap S S'))) := by
  refine ⟨IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal S' (fun r hr ↦ ?_) hreg.of_flat, ?_⟩
  · obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hr
    exact hmem s hs
  · rw [← Ideal.map_ofList]
    let e : (S' ⧸ (Ideal.ofList rs).map (algebraMap S S')) ≃ₗ[S'] S' ⊗[S] (S ⧸ Ideal.ofList rs) :=
      (Ideal.ofList rs).qoutMapEquivTensorQout (S := S')
    have : Module.Flat A (S' ⊗[S] (S ⧸ Ideal.ofList rs)) :=
      Module.Flat.tensorProduct_of_flat_left
    exact Module.Flat.of_linearEquiv (e.restrictScalars A)

/-- **Regular sequences with flat quotient pass to the localization at a smaller prime.**  If the
images of `rs ⊆ 𝔮` form a regular sequence in `R_{𝔮₀}` generating `J_{𝔮₀}`, with quotient flat
over `A`, and `𝔮 ⊆ 𝔮₀`, then they do so in `R_𝔮`, a localization of `R_{𝔮₀}`. -/
public theorem isRegular_and_flat_atPrime_of_le {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (q q₀ : Ideal R) [q.IsPrime] [q₀.IsPrime] (hle : q ≤ q₀) (rs : List R)
    (hmem : ∀ r ∈ rs, r ∈ q)
    (hreg : IsRegular (Localization.AtPrime q₀) (rs.map (algebraMap R (Localization.AtPrime q₀))))
    (hflat : Module.Flat A (Localization.AtPrime q₀ ⧸
      Ideal.ofList (rs.map (algebraMap R (Localization.AtPrime q₀)))))
    (J : Ideal R) (hJ : J.map (algebraMap R (Localization.AtPrime q₀)) =
      Ideal.ofList (rs.map (algebraMap R (Localization.AtPrime q₀)))) :
    IsRegular (Localization.AtPrime q) (rs.map (algebraMap R (Localization.AtPrime q))) ∧
      Module.Flat A (Localization.AtPrime q ⧸
        Ideal.ofList (rs.map (algebraMap R (Localization.AtPrime q)))) ∧
      J.map (algebraMap R (Localization.AtPrime q)) =
        Ideal.ofList (rs.map (algebraMap R (Localization.AtPrime q))) := by
  let S := Localization.AtPrime q₀
  let S' := Localization.AtPrime q
  have hle' : q₀.primeCompl ≤ q.primeCompl := fun x hx h ↦ hx (hle h)
  let : Algebra S S' := IsLocalization.localizationAlgebraOfSubmonoidLe S S' _ _ hle'
  have : IsScalarTower R S S' :=
    IsLocalization.localization_isScalarTower_of_submonoid_le S S' _ _ hle'
  have : IsLocalization (q.primeCompl.map (algebraMap R S)) S' :=
    IsLocalization.isLocalization_of_submonoid_le S S' _ _ hle'
  have : Module.Flat S S' := IsLocalization.flat S' (q.primeCompl.map (algebraMap R S))
  have : IsScalarTower A S S' := IsScalarTower.of_algebraMap_eq fun a ↦ by
    rw [IsScalarTower.algebraMap_apply A R S, IsScalarTower.algebraMap_apply A R S',
      ← IsScalarTower.algebraMap_apply R S S']
  have hmap : (rs.map (algebraMap R S)).map (algebraMap S S') = rs.map (algebraMap R S') := by
    rw [List.map_map, ← RingHom.coe_comp, ← IsScalarTower.algebraMap_eq]
  have hmem' :
      ∀ r ∈ rs.map (algebraMap R S), algebraMap S S' r ∈ IsLocalRing.maximalIdeal S' := by
    intro r hr
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hr
    rw [← IsScalarTower.algebraMap_apply, ← Localization.AtPrime.map_eq_maximalIdeal (I := q)]
    exact Ideal.mem_map_of_mem _ (hmem s hs)
  have h := isRegular_and_flat_of_flat_of_isWeaklyRegular (A := A) _ hreg.1 hflat hmem'
  rw [hmap] at h
  refine ⟨h.1, h.2, ?_⟩
  rw [IsScalarTower.algebraMap_eq R S S', ← Ideal.map_map, hJ, Ideal.map_ofList, hmap,
    ← IsScalarTower.algebraMap_eq]

/-- **Stacks 0GH1, the regular-sequence statement at an arbitrary prime of the generic fibre, from
Jacobian charts.**  Let `A` be a Noetherian adic ring with ideal of definition `I`, and let `J`
be an ideal of `A{x₁, …, x_n}` which admits a Jacobian chart at every prime `𝔮 ⊇ J` not
containing `I`: elements `y₁, …, y_m ∈ J` generating `J_𝔮` with `det (∂y_j/∂x_{T i}) ∉ 𝔮`.  Then
for every such prime, `J_𝔮` is generated by a regular sequence of `A{x}_𝔮`, and
`A{x}_𝔮 ⧸ J_𝔮` is flat over `A`.

The second paragraph of the proof of Stacks 0GH1: a prime `𝔮` is contained in one `𝔮₀` maximal
among the primes not containing `I`, that is a rig-closed one; at `𝔮₀` the chart is a regular
sequence with flat quotient (`Rig.isRegular_and_flat_of_isUnit_det_of_isClosedPointAwayFrom`),
and both properties pass to the localization `A{x}_𝔮` of `A{x}_{𝔮₀}`. -/
public theorem exists_isRegular_and_flat_of_forall_jacobianChart
    {A : Type u} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [IsLinearTopology A A]
    [IsNoetherianRing A] (hA : TopologicalRing.IsAdic A) {I : Ideal A} (hI : _root_.IsAdic I)
    {n : ℕ} (J : Ideal (RestrictedPowerSeries I (Fin n)))
    (hchart : ∀ (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime], J ≤ q →
      ¬ coefficientIdeal I (Fin n) ≤ q → ∃ (m : ℕ) (T : Fin m ↪ Fin n)
        (y : Fin m → RestrictedPowerSeries I (Fin n)), (∀ j, y j ∈ J) ∧
        Matrix.det (fun i j : Fin m ↦ restrictedPartialDeriv I (T i) (y j)) ∉ q ∧
        J.map (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q)) =
          Ideal.span (Set.range fun j ↦
            algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q) (y j)))
    (q : Ideal (RestrictedPowerSeries I (Fin n))) [q.IsPrime] (hJq : J ≤ q)
    (hq : ¬ coefficientIdeal I (Fin n) ≤ q) :
    ∃ fs : List (Localization.AtPrime q), IsRegular (Localization.AtPrime q) fs ∧
      Ideal.ofList fs =
        J.map (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q)) ∧
      Module.Flat A (Localization.AtPrime q ⧸
        J.map (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q))) := by
  have hIfg : I.FG := Ideal.fg_of_isNoetherianRing I
  obtain ⟨q₀, hq₀, hqq₀, hq₀I, hmax⟩ := exists_maximal_prime_avoiding
    (coefficientIdeal I (Fin n)) q (hIfg.map _) inferInstance hq
  have hq₀closed : Ideal.IsClosedPointAwayFrom (coefficientIdeal I (Fin n)) q₀ :=
    (isClosedPointAway_iff_isMaximalAmongPrimesAvoiding _ q₀).mpr ⟨hq₀I, hmax⟩
  obtain ⟨m, T, y, hyJ, hdet, hgen⟩ := hchart q₀ (hJq.trans hqq₀) hq₀I
  obtain ⟨hreg₀, hflat₀⟩ := isRegular_and_flat_of_isUnit_det_of_isClosedPointAwayFrom hA hI q₀
    hq₀closed T y (fun j ↦ hqq₀ (hJq (hyJ j))) hdet
  have hspan₀ : J.map (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q₀)) =
      Ideal.ofList ((List.ofFn y).map
        (algebraMap (RestrictedPowerSeries I (Fin n)) (Localization.AtPrime q₀))) := by
    rw [hgen, map_ofFn_apply]
    congr 1
    ext x
    simp [List.mem_ofFn, Set.mem_range]
  obtain ⟨hreg, hflat, hspan⟩ := isRegular_and_flat_atPrime_of_le (A := A) q q₀ hqq₀ (List.ofFn y)
    (fun r hr ↦ by obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hr; exact hJq (hyJ j))
    (by rwa [map_ofFn_apply]) (by rwa [map_ofFn_apply]) J hspan₀
  refine ⟨_, hreg, hspan.symm, ?_⟩
  rwa [hspan]

end Rig

