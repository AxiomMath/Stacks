module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.AdicCompletion.Basic
public import Mathlib.RingTheory.AdicCompletion.Topology
public import StacksFrontier.RingTheory.RestrictedPowerSeries

/-!
# Deformations of ring homomorphisms into a complete algebra

Let `A` be a ring with a finitely generated ideal `I` and let `C` be an `I`-adically
complete `A`-algebra. A continuous `A`-algebra homomorphism `ψ` from the ring of restricted
power series `A⟨x_i⟩` to `C` is determined by the images of the variables, so it may be
deformed by prescribing increments `δ i` for those images. This file constructs the deformed
homomorphism and computes its values to first order: the value of the deformation at a
restricted power series `g` is `ψ g` plus the linear term `∑ i, ψ (∂g/∂x_i) · δ i`, with an
error lying in the ideal generated by the pairwise products `δ i · δ j`.

## Main definitions

* `Rig.partialDerivative` — formal partial differentiation of a restricted power series,
  performed on each polynomial coefficient quotient.

## Main results

* `Rig.exists_continuousAlgHom_add_variables` — the deformation prescribing the increments
  `δ` exists and is unique.
* `Rig.eval_add_variables_eq_linear_add_error` — the first-order expansion of the deformed
  homomorphism, with quadratic error.

## Implementation notes

The source's finite list of variables is represented by a finite indexing type. The error
term is produced by summing the quadratic remainders of a sequence of polynomial truncations
of `g`; the series of coefficients converges because the `n`-th remainder lies in
`(IC)ⁿ · (δ i δ j)`, and `C` is complete.

## References

* [Stacks Project, Tag 0AK3](https://stacks.math.columbia.edu/tag/0AK3)
-/

@[expose] public section

open RestrictedPowerSeries

namespace Rig

universe u v w

/-- Formal partial differentiation of a restricted power series, coefficient quotient by
coefficient quotient. -/
public noncomputable def partialDerivative {A : Type u} [CommRing A]
    (I : Ideal A) {σ : Type v} (i : σ) :
    RestrictedPowerSeries I σ →+ RestrictedPowerSeries I σ where
  toFun g := ⟨fun n ↦ MvPolynomial.pderiv i (g.1 n), by
    intro m n hmn
    change MvPolynomial.map (Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn))
      (MvPolynomial.pderiv i (g.1 n)) = MvPolynomial.pderiv i (g.1 m)
    rw [← MvPolynomial.pderiv_map]
    exact congrArg (MvPolynomial.pderiv i) (g.2 hmn)⟩
  map_zero' := by
    apply Subtype.ext
    funext n
    simp
  map_add' g h := by
    apply Subtype.ext
    funext n
    simp

/-- An adically complete ring is complete for its adic topology. -/
private lemma isComplete_of_isAdic {C : Type w} [CommRing C] [TopologicalSpace C]
    [IsTopologicalRing C] {J : Ideal C} (hJ : IsAdic J) [IsAdicComplete J C] :
    TopologicalRing.IsComplete C := by
  let _ := IsTopologicalAddGroup.rightUniformSpace C
  have : IsUniformAddGroup C := isUniformAddGroup_of_addCommGroup
  rcases (IsAdic.isAdicComplete_iff hJ).mp ‹IsAdicComplete J C› with ⟨hc, hh⟩
  exact ⟨hh, hc⟩

private noncomputable def polynomialRemainder
    {A : Type u} [CommRing A] (I : Ideal A) {C : Type w} [CommRing C]
    [Algebra A C] {σ : Type v} [Fintype σ]
    (ψ ψ' : RestrictedPowerSeries I σ →ₐ[A] C) (δ : σ → C)
    (p : MvPolynomial σ A) : C :=
  ψ' (polynomialAlgHom I σ p) - ψ (polynomialAlgHom I σ p) -
    ∑ i, ψ (polynomialAlgHom I σ (MvPolynomial.pderiv i p)) * δ i

private lemma polynomialRemainder_add
    {A : Type u} [CommRing A] (I : Ideal A) {C : Type w} [CommRing C]
    [Algebra A C] {σ : Type v} [Fintype σ]
    (ψ ψ' : RestrictedPowerSeries I σ →ₐ[A] C) (δ : σ → C)
    (p q : MvPolynomial σ A) :
    polynomialRemainder I ψ ψ' δ (p + q) =
      polynomialRemainder I ψ ψ' δ p + polynomialRemainder I ψ ψ' δ q := by
  simp only [polynomialRemainder, map_add, add_mul, Finset.sum_add_distrib]
  ring

private lemma polynomialRemainder_sub
    {A : Type u} [CommRing A] (I : Ideal A) {C : Type w} [CommRing C]
    [Algebra A C] {σ : Type v} [Fintype σ]
    (ψ ψ' : RestrictedPowerSeries I σ →ₐ[A] C) (δ : σ → C)
    (p q : MvPolynomial σ A) :
    polynomialRemainder I ψ ψ' δ (p - q) =
      polynomialRemainder I ψ ψ' δ p - polynomialRemainder I ψ ψ' δ q := by
  simp only [polynomialRemainder, map_sub, Finset.sum_sub_distrib, sub_mul]
  ring

private lemma exists_coefficients_of_mem_mul_span_range
    {C : Type w} [CommRing C] {α β : Type*} [Fintype α] [Finite β]
    (J : Ideal C) (b : β → C) (hb : Ideal.span (Set.range b) = J)
    (s : α → C) {x : C} (hx : x ∈ J * Ideal.span (Set.range s)) :
    ∃ c : α → C, (∀ i, c i ∈ J) ∧ ∑ i, c i * s i = x := by
  classical
  have := Fintype.ofFinite β
  have hmul : J * Ideal.span (Set.range s) =
      Ideal.span (Set.range (fun ij : β × α ↦ b ij.1 * s ij.2)) := by
    rw [← hb, Ideal.span_mul_span]
    congr 1
    ext x
    simp [Set.mem_mul]
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp (hmul ▸ hx)
  refine ⟨fun i ↦ ∑ j, c (j, i) * b j, ?_, ?_⟩
  · exact fun i ↦ Ideal.sum_mem _ fun j _ ↦
      J.mul_mem_left _ (hb ▸ Ideal.subset_span ⟨j, rfl⟩)
  · calc
      (∑ i, (∑ j, c (j, i) * b j) * s i) =
          ∑ i, ∑ j, c (j, i) * b j * s i := by simp only [Finset.sum_mul]
      _ = ∑ j, ∑ i, c (j, i) * b j * s i := Finset.sum_comm
      _ = x := by
        rw [← Finset.univ_product_univ, Finset.sum_product_right, Finset.sum_comm] at hc
        simpa [mul_assoc] using hc

private lemma exists_adic_quadratic_decomposition
    {A : Type u} [CommRing A] (I : Ideal A) (hI : I.FG)
    {C : Type w} [CommRing C] [Algebra A C] {σ : Type v} [Fintype σ]
    (δ : σ → C) (n : ℕ) {x : C}
    (hx : x ∈ (I.map (algebraMap A C)) ^ n *
      Ideal.span (Set.range (fun ij : σ × σ ↦ δ ij.1 * δ ij.2))) :
    ∃ c : σ × σ → C, (∀ ij, c ij ∈ (I.map (algebraMap A C)) ^ n) ∧
      ∑ ij, c ij * (δ ij.1 * δ ij.2) = x := by
  classical
  have hFG : ((I.map (algebraMap A C)) ^ n).FG := by
    rw [← Ideal.map_pow]
    exact hI.pow.map (algebraMap A C)
  obtain ⟨m, b, hb⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hFG
  exact exists_coefficients_of_mem_mul_span_range _ b hb
    (fun ij : σ × σ ↦ δ ij.1 * δ ij.2) hx

private lemma polynomialRemainder_monomial_mem_pow_mul
    {A : Type u} [CommRing A] (I : Ideal A) {C : Type w} [CommRing C]
    [Algebra A C] {σ : Type v} [Fintype σ]
    (ψ ψ' : RestrictedPowerSeries I σ →ₐ[A] C) (δ : σ → C)
    (hδ : ∀ i, ψ' (polynomialAlgHom I σ (MvPolynomial.X i)) =
      ψ (polynomialAlgHom I σ (MvPolynomial.X i)) + δ i)
    (n : ℕ) (a : A) (ha : a ∈ I ^ n) (s : σ →₀ ℕ) :
    polynomialRemainder I ψ ψ' δ (MvPolynomial.monomial s a) ∈
      (I.map (algebraMap A C)) ^ n *
        Ideal.span (Set.range (fun ij : σ × σ ↦ δ ij.1 * δ ij.2)) := by
  classical
  let Jn : Ideal C := (I.map (algebraMap A C)) ^ n
  let K : Ideal C := Ideal.span (Set.range (fun ij : σ × σ ↦ δ ij.1 * δ ij.2))
  let Ja : A → Ideal C := fun a ↦ Ideal.map (algebraMap A C) (Ideal.span {a})
  let P : MvPolynomial σ A →ₐ[A] C := ψ.comp (polynomialAlgHom I σ)
  let P' : MvPolynomial σ A →ₐ[A] C := ψ'.comp (polynomialAlgHom I σ)
  have hvar : ∀ i, P' (MvPolynomial.X i) = P (MvPolynomial.X i) + δ i := hδ
  have hderiv : ∀ p j,
      (∑ i, P (MvPolynomial.pderiv i (p * MvPolynomial.X j)) * δ i) =
        (∑ i, P (MvPolynomial.pderiv i p) * δ i) * P (MvPolynomial.X j) +
          P p * δ j := by
    intro p j
    simp only [MvPolynomial.pderiv_mul, map_add, map_mul, add_mul]
    rw [Finset.sum_add_distrib]
    have hfirst :
        (∑ i, P (MvPolynomial.pderiv i p) * P (MvPolynomial.X j) * δ i) =
          (∑ i, P (MvPolynomial.pderiv i p) * δ i) * P (MvPolynomial.X j) := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun i _ ↦ by ring
    have hsecond :
        (∑ i, P p * P (MvPolynomial.pderiv i (MvPolynomial.X j)) * δ i) = P p * δ j := by
      rw [Finset.sum_eq_single j]
      · simp
      · intro i hi hij
        simp [MvPolynomial.pderiv_X_of_ne (Ne.symm hij)]
      · simp
    rw [hfirst, hsecond]
  have hrec : ∀ p j, polynomialRemainder I ψ ψ' δ (p * MvPolynomial.X j) =
      polynomialRemainder I ψ ψ' δ p * P (MvPolynomial.X j) +
        (P' p - P p) * δ j := by
    intro p j
    show P' (p * MvPolynomial.X j) - P (p * MvPolynomial.X j) -
        (∑ i, P (MvPolynomial.pderiv i (p * MvPolynomial.X j)) * δ i) =
      (P' p - P p - ∑ i, P (MvPolynomial.pderiv i p) * δ i) * P (MvPolynomial.X j) +
        (P' p - P p) * δ j
    rw [map_mul, map_mul, hvar j, hderiv p j]
    ring
  have hdiff : ∀ p,
      P' p - P p = polynomialRemainder I ψ ψ' δ p +
        ∑ i, P (MvPolynomial.pderiv i p) * δ i := fun p ↦ by
    simp [polynomialRemainder, P, P', AlgHom.comp_apply]
  have hmon : ∀ s a, ∃ t b, MvPolynomial.monomial s a = MvPolynomial.monomial t b ∧
      P (MvPolynomial.monomial s a) ∈ Ja b ∧
      (∀ i, P (MvPolynomial.pderiv i (MvPolynomial.monomial s a)) ∈ Ja b) ∧
      polynomialRemainder I ψ ψ' δ (MvPolynomial.monomial s a) ∈ Ja b * K := by
    intro s a
    refine MvPolynomial.induction_on_monomial
      (motive := fun p => ∃ t b, p = MvPolynomial.monomial t b ∧
        P p ∈ Ja b ∧ (∀ i, P (MvPolynomial.pderiv i p) ∈ Ja b) ∧
        polynomialRemainder I ψ ψ' δ p ∈ Ja b * K) ?_ ?_ s a
    · intro b
      refine ⟨0, b, ?_, ?_, ?_, ?_⟩
      · simp
      · simpa [P, Ja] using
          (Ideal.mem_map_of_mem (algebraMap A C) (Ideal.subset_span (by simp)))
      · simp [P]
      · simp [polynomialRemainder]
    · intro p j hp
      obtain ⟨t, b, hpEq, hp, hdp, hr⟩ := hp
      subst p
      refine ⟨t + Finsupp.single j 1, b, ?_, ?_, ?_, ?_⟩
      · symm
        rw [MvPolynomial.monomial_add_single, pow_one]
      · rw [map_mul]
        exact (Ja b).mul_mem_right _ hp
      · intro i
        rw [MvPolynomial.pderiv_mul, map_add, map_mul]
        apply (Ja b).add_mem
        · exact (Ja b).mul_mem_right _ (hdp i)
        · by_cases hij : i = j
          · subst i
            simp only [MvPolynomial.pderiv_X, Pi.single_eq_same, mul_one]
            exact hp
          · simp [MvPolynomial.pderiv_X_of_ne (Ne.symm hij)]
      · rw [hrec, hdiff, add_mul]
        refine (Ja b * K).add_mem ((Ja b * K).mul_mem_right _ hr)
          ((Ja b * K).add_mem ((Ja b * K).mul_mem_right _ hr) ?_)
        rw [Finset.sum_mul]
        refine Ideal.sum_mem _ fun i _ ↦ ?_
        rw [mul_assoc]
        exact Ideal.mul_mem_mul (hdp i) (Ideal.subset_span ⟨(i, j), rfl⟩)
  obtain ⟨t, b, hEq, _, _, hr⟩ := hmon s a
  have hb : b ∈ I ^ n := by
    by_cases hts : t = s
    · subst t
      have hab : a = b := by simpa using congrArg (fun q : MvPolynomial _ _ ↦ q.coeff s) hEq
      simpa [hab] using ha
    · have hb0 : b = 0 := by
        simpa [MvPolynomial.coeff_monomial, Ne.symm hts] using
          (congrArg (fun q : MvPolynomial _ _ ↦ q.coeff t) hEq).symm
      exact hb0 ▸ (I ^ n).zero_mem
  have hJa : Ja b ≤ Jn := by
    show Ideal.map (algebraMap A C) (Ideal.span {b}) ≤
      (I.map (algebraMap A C)) ^ n
    rw [← Ideal.map_pow]
    exact Ideal.map_mono ((Ideal.span_singleton_le_iff_mem _).2 hb)
  exact Ideal.mul_mono_left hJa hr

private lemma polynomialRemainder_mem_pow_mul
    {A : Type u} [CommRing A] (I : Ideal A) {C : Type w} [CommRing C]
    [Algebra A C] {σ : Type v} [Fintype σ]
    (ψ ψ' : RestrictedPowerSeries I σ →ₐ[A] C) (δ : σ → C)
    (hδ : ∀ i, ψ' (polynomialAlgHom I σ (MvPolynomial.X i)) =
      ψ (polynomialAlgHom I σ (MvPolynomial.X i)) + δ i)
    (n : ℕ) (p : MvPolynomial σ A)
    (hp : ∀ m, p.coeff m ∈ I ^ n) :
    polynomialRemainder I ψ ψ' δ p ∈
      (I.map (algebraMap A C)) ^ n *
        Ideal.span (Set.range (fun ij : σ × σ ↦ δ ij.1 * δ ij.2)) := by
  classical
  rw [MvPolynomial.as_sum p]
  have hsum : ∀ t : Finset (σ →₀ ℕ),
      polynomialRemainder I ψ ψ' δ
        (∑ s ∈ t, MvPolynomial.monomial s (p.coeff s)) =
      ∑ s ∈ t, polynomialRemainder I ψ ψ' δ
        (MvPolynomial.monomial s (p.coeff s)) := by
    intro t
    induction t using Finset.induction_on with
    | empty => simp [polynomialRemainder]
    | @insert s t hs ih =>
        simp only [Finset.sum_insert hs, polynomialRemainder_add, ih]
  rw [hsum]
  exact Ideal.sum_mem _ fun s _ ↦
    polynomialRemainder_monomial_mem_pow_mul I ψ ψ' δ hδ n _ (hp s) s

private lemma partialDerivative_polynomial
    {A : Type u} [CommRing A] (I : Ideal A) {σ : Type v} (i : σ)
    (p : MvPolynomial σ A) :
    partialDerivative I i (polynomialAlgHom I σ p) =
      polynomialAlgHom I σ (MvPolynomial.pderiv i p) :=
  Subtype.ext <| funext fun _ ↦ MvPolynomial.pderiv_map

/-- A continuous algebra map on restricted series can be perturbed by arbitrary increments
in the images of its finitely many variables. -/
@[stacks 0AK3 "existence of the perturbed map"]
public theorem exists_continuousAlgHom_add_variables
    {A : Type u} [CommRing A] (I : Ideal A) (hI : I.FG)
    {C : Type w} [CommRing C] [Algebra A C]
    [IsAdicComplete (I.map (algebraMap A C)) C]
    {σ : Type v}
    (ψ : RestrictedPowerSeries I σ →ₐ[A] C)
    (hψ : @Continuous _ _ (limitTopology I σ)
      ((I.map (algebraMap A C)).adicTopology) ψ)
    (δ : σ → C) :
    ∃! ψ' : RestrictedPowerSeries I σ →ₐ[A] C,
      @Continuous _ _ (limitTopology I σ)
        ((I.map (algebraMap A C)).adicTopology) ψ' ∧
      ∀ i, ψ' (polynomialAlgHom I σ (MvPolynomial.X i)) =
        ψ (polynomialAlgHom I σ (MvPolynomial.X i)) + δ i := by
  classical
  have := hI
  have := hψ
  let _ : TopologicalSpace A := I.adicTopology
  let _ : IsTopologicalRing A := inferInstance
  let J : Ideal C := I.map (algebraMap A C)
  let _ : TopologicalSpace C := J.adicTopology
  let _ : IsTopologicalRing C := inferInstance
  let _ : IsLinearTopology C C := J.isLinearTopology
  have hopen : ∀ n : ℕ, IsOpen ((I ^ n : Ideal A) : Set A) := by
    intro n
    rw [isOpen_iff_mem_nhds]
    intro a ha
    rw [(I.hasBasis_nhds_adic a).mem_iff]
    exact ⟨n, trivial, by
      rintro b ⟨c, hc, rfl⟩
      exact (I ^ n).add_mem ha hc⟩
  have hfund : ∀ U ∈ nhds (0 : A), ∃ n : ℕ, ((I ^ n : Ideal A) : Set A) ⊆ U :=
    fun _ hU ↦ (I.hasBasis_nhds_zero_adic.mem_iff.mp hU).imp fun _ ↦ And.right
  let _ : WithIdeal A := ⟨I⟩
  let _ : WithIdeal C := ⟨J⟩
  have hAC : Continuous (algebraMap A C) :=
    (WithIdeal.uniformContinuous_of_map_le (f := algebraMap A C) (le_of_eq rfl)).continuous
  have hC : TopologicalRing.IsComplete C := isComplete_of_isAdic (J := J) rfl
  let f : MvPolynomial σ A →ₐ[A] C :=
    MvPolynomial.aeval (fun i ↦ ψ (polynomialAlgHom I σ (MvPolynomial.X i)) + δ i)
  obtain ⟨g, ⟨hgcont, hgf⟩, hgunique⟩ :=
    RestrictedPowerSeries.existsUnique_continuousAlgHom_extends
      (J := fun n : ℕ ↦ I ^ n)
      (hJ := fun _ _ h ↦ Ideal.pow_le_pow_right h)
      hopen hfund hAC hC f
  refine ⟨g, ⟨hgcont, fun i ↦ ?_⟩, ?_⟩
  · simpa [f] using congrArg (fun q : MvPolynomial σ A →ₐ[A] C => q (MvPolynomial.X i)) hgf
  · intro g' hg'
    exact hgunique g' ⟨hg'.1, MvPolynomial.algHom_ext fun i ↦ by simpa [f] using hg'.2 i⟩

/-- The evaluation of a perturbed restricted series is its original evaluation plus the
formal linear term, up to the ideal generated by pairwise products of increments. -/
@[stacks 0AK3 "linear approximation and quadratic error"]
public theorem eval_add_variables_eq_linear_add_error
    {A : Type u} [CommRing A] (I : Ideal A) (hI : I.FG)
    {C : Type w} [CommRing C] [Algebra A C]
    [IsAdicComplete (I.map (algebraMap A C)) C]
    {σ : Type v} [Fintype σ]
    (ψ ψ' : RestrictedPowerSeries I σ →ₐ[A] C)
    (hψ : @Continuous _ _ (limitTopology I σ)
      ((I.map (algebraMap A C)).adicTopology) ψ)
    (hψ' : @Continuous _ _ (limitTopology I σ)
      ((I.map (algebraMap A C)).adicTopology) ψ')
    (δ : σ → C)
    (hδ : ∀ i, ψ' (polynomialAlgHom I σ (MvPolynomial.X i)) =
      ψ (polynomialAlgHom I σ (MvPolynomial.X i)) + δ i)
    (g : RestrictedPowerSeries I σ) :
    ∃ ξ : C,
      ξ ∈ Ideal.span (Set.range (fun ij : σ × σ ↦ δ ij.1 * δ ij.2)) ∧
      ψ' g = ψ g + (∑ i, ψ (partialDerivative I i g) * δ i) + ξ := by
  classical
  let J : Ideal C := I.map (algebraMap A C)
  let _ : TopologicalSpace C := J.adicTopology
  let _ : IsTopologicalRing C := inferInstance
  let _ : IsLinearTopology C C := J.isLinearTopology
  let _ : WithIdeal C := ⟨J⟩
  have hC : TopologicalRing.IsComplete C := isComplete_of_isAdic (J := J) rfl
  let _ : T2Space C := hC.1
  let _ : CompleteSpace C := hC.2
  let K : Ideal C := Ideal.span (Set.range (fun ij : σ × σ ↦ δ ij.1 * δ ij.2))
  let E : RestrictedPowerSeries I σ → C := fun f ↦
    ψ' f - ψ f - ∑ i, ψ (partialDerivative I i f) * δ i
  have hD (i : σ) : Continuous (partialDerivative I i :
      RestrictedPowerSeries I σ → RestrictedPowerSeries I σ) := by
    let : ∀ n : ℕ, TopologicalSpace (MvPolynomial σ (A ⧸ I ^ n)) := fun _ ↦ ⊥
    let : ∀ n : ℕ, DiscreteTopology (MvPolynomial σ (A ⧸ I ^ n)) :=
      fun _ ↦ ⟨rfl⟩
    apply (continuous_idealSystem_iff
      (fun n : ℕ ↦ I ^ n) (fun _ _ h ↦ Ideal.pow_le_pow_right h) σ
      (partialDerivative I i)).2
    intro n
    have hπ : Continuous (coefficientProjection I σ n) :=
      continuous_coefficientProjection I σ n
    have hpd : Continuous (MvPolynomial.pderiv i :
        MvPolynomial σ (A ⧸ I ^ n) → MvPolynomial σ (A ⧸ I ^ n)) :=
      continuous_of_discreteTopology
    show Continuous fun f ↦ MvPolynomial.pderiv i (coefficientProjection I σ n f)
    exact hpd.comp hπ
  have hEcont : @Continuous (RestrictedPowerSeries I σ) C
      (limitTopology I σ) ((I.map (algebraMap A C)).adicTopology) E := by
    have hsum : @Continuous (RestrictedPowerSeries I σ) C
        (limitTopology I σ) ((I.map (algebraMap A C)).adicTopology)
        (fun f : RestrictedPowerSeries I σ ↦
        ∑ i, ψ (partialDerivative I i f) * δ i) :=
      continuous_finsetSum _ fun i _ ↦ (hψ.comp (hD i)).mul continuous_const
    show @Continuous (RestrictedPowerSeries I σ) C
      (limitTopology I σ) ((I.map (algebraMap A C)).adicTopology)
      (fun f ↦ ψ' f - ψ f - ∑ i, ψ (partialDerivative I i f) * δ i)
    exact (hψ'.sub hψ).sub hsum
  have hEpoly (p : MvPolynomial σ A) :
      E (polynomialAlgHom I σ p) = polynomialRemainder I ψ ψ' δ p := by
    simp [E, polynomialRemainder, partialDerivative_polynomial]
  have hLiftExists (n : ℕ) : ∃ q : MvPolynomial σ A,
      MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) q =
        coefficientProjection I σ n g :=
    (MvPolynomial.map_surjective (Ideal.Quotient.mk (I ^ n))
      Ideal.Quotient.mk_surjective) (coefficientProjection I σ n g)
  let lift : ℕ → MvPolynomial σ A := fun n ↦ Classical.choose (hLiftExists n)
  have hlift (n : ℕ) :
      MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) (lift n) =
        coefficientProjection I σ n g := Classical.choose_spec (hLiftExists n)
  let p : ℕ → MvPolynomial σ A
    | 0 => 0
    | n + 1 => lift (n + 1)
  have hp (n : ℕ) :
      MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) (p n) =
        coefficientProjection I σ n g := by
    cases n with
    | zero =>
      have : Subsingleton (A ⧸ I ^ 0) := by
        rw [Submodule.pow_zero, Ideal.one_eq_top]
        infer_instance
      exact Subsingleton.elim _ _
    | succ n => exact hlift (n + 1)
  have hred (m n : ℕ) (hmn : m ≤ n) :
      MvPolynomial.map (Ideal.Quotient.mk (I ^ m)) (p n) =
        coefficientProjection I σ m g := by
    have hcompat := g.property hmn
    change MvPolynomial.map (Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn))
        (coefficientProjection I σ n g) = coefficientProjection I σ m g at hcompat
    rw [← hp n, ← hp m] at hcompat
    change MvPolynomial.map (Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn))
        (MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) (p n)) = _ at hcompat
    rw [MvPolynomial.map_map, Ideal.Quotient.factor_comp_mk] at hcompat
    exact hcompat.trans (hp m)
  have hmapDiff (n : ℕ) :
      MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) (p (n + 1) - p n) = 0 := by
    rw [map_sub, hred n (n + 1) (Nat.le_succ n), hp n, sub_self]
  have hcoeffDiff (n : ℕ) (m : σ →₀ ℕ) :
      (p (n + 1) - p n).coeff m ∈ I ^ n := by
    have hzero := congrArg (fun q : MvPolynomial _ _ ↦ q.coeff m) (hmapDiff n)
    have hq : Ideal.Quotient.mk (I ^ n)
        ((p (n + 1) - p n).coeff m) = 0 := by
      simpa [MvPolynomial.coeff_map] using hzero
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hq
  have hRdiff (n : ℕ) :
      polynomialRemainder I ψ ψ' δ (p (n + 1)) -
          polynomialRemainder I ψ ψ' δ (p n) ∈ J ^ n * K := by
    rw [← polynomialRemainder_sub]
    exact polynomialRemainder_mem_pow_mul I ψ ψ' δ hδ n
      (p (n + 1) - p n) (hcoeffDiff n)
  have hDecomp (n : ℕ) := exists_adic_quadratic_decomposition I hI δ n (hRdiff n)
  let qCoefficient : ℕ → σ × σ → C := fun n ↦ Classical.choose (hDecomp n)
  have hqProperties (n : ℕ) :
      (∀ ij, qCoefficient n ij ∈ J ^ n) ∧
      (∑ ij, qCoefficient n ij * (δ ij.1 * δ ij.2) =
        polynomialRemainder I ψ ψ' δ (p (n + 1)) -
          polynomialRemainder I ψ ψ' δ (p n)) := Classical.choose_spec (hDecomp n)
  let qSum (ij : σ × σ) (N : ℕ) : C :=
    ∑ n ∈ Finset.range N, qCoefficient n ij
  have hqSum_succ (ij : σ × σ) (N : ℕ) :
      qSum ij (N + 1) = qSum ij N + qCoefficient N ij := by
    simp [qSum, Finset.sum_range_succ]
  have htelescoping : ∀ N : ℕ,
      (∑ ij, qSum ij N * (δ ij.1 * δ ij.2)) =
        polynomialRemainder I ψ ψ' δ (p N) := by
    intro N
    induction N with
    | zero => simp [qSum, p, polynomialRemainder]
    | succ N ih =>
        calc
          (∑ ij, qSum ij (N + 1) * (δ ij.1 * δ ij.2)) =
              (∑ ij, qSum ij N * (δ ij.1 * δ ij.2)) +
                ∑ ij, qCoefficient N ij * (δ ij.1 * δ ij.2) := by
            simp_rw [hqSum_succ]
            simp only [add_mul, Finset.sum_add_distrib]
          _ = polynomialRemainder I ψ ψ' δ (p N) +
                (polynomialRemainder I ψ ψ' δ (p (N + 1)) -
                  polynomialRemainder I ψ ψ' δ (p N)) := by
            rw [ih, hqProperties N |>.2]
          _ = polynomialRemainder I ψ ψ' δ (p (N + 1)) := by ring
  let : ∀ n : ℕ, TopologicalSpace (MvPolynomial σ (A ⧸ I ^ n)) := fun _ ↦ ⊥
  have hpseq : Filter.Tendsto (fun n ↦ polynomialAlgHom I σ (p n))
      Filter.atTop (nhds g) := by
    apply tendsto_subtype_rng.mpr
    apply tendsto_pi_nhds.mpr
    intro m
    refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
    filter_upwards [Filter.eventually_atTop.mpr ⟨m + 1, fun n hn ↦ hn⟩] with n hn
    show coefficientProjection I σ m g =
      coefficientProjection I σ m (polynomialRingHom I σ (p n))
    rw [coefficientProjection_polynomialRingHom]
    exact (hred m n (by omega)).symm
  have hElim : Filter.Tendsto (fun n ↦ E (polynomialAlgHom I σ (p n)))
      Filter.atTop (nhds (E g)) := (hEcont.tendsto g).comp hpseq
  let qPartial (ij : σ × σ) (N : ℕ) : C := qSum ij N
  have htail : ∀ (ij : σ × σ) (N k l : ℕ), N ≤ k → k ≤ l →
      qPartial ij l - qPartial ij k ∈ J ^ N := by
    intro ij N k l hNk hkl
    revert k hNk
    induction l with
    | zero =>
        intro k hNk hk
        have : k = 0 := Nat.eq_zero_of_le_zero hk
        subst k
        simp [qPartial, qSum]
    | succ l ih =>
        intro k hNk hk
        by_cases hkl' : k ≤ l
        · have hold := ih k hNk hkl'
          show qSum ij (l + 1) - qSum ij k ∈ J ^ N
          rw [hqSum_succ]
          rw [show qSum ij l + qCoefficient l ij - qSum ij k =
            (qSum ij l - qSum ij k) + qCoefficient l ij by ring]
          exact (J ^ N).add_mem hold
            ((Ideal.pow_le_pow_right (Nat.le_trans hNk hkl')) ((hqProperties l).1 ij))
        · have : k = l + 1 := by omega
          subst k
          simp [qPartial, qSum]
  have hqCauchy (ij : σ × σ) : CauchySeq (qPartial ij) := by
    rw [cauchySeq_iff, uniformity_eq_comap_nhds_zero]
    intro V hV
    obtain ⟨U, hU, hUV⟩ := Filter.mem_comap.mp hV
    obtain ⟨N, -, hNU⟩ := (J.hasBasis_nhds_zero_adic).mem_iff.mp hU
    refine ⟨N, ?_⟩
    intro k hk l hl
    apply hUV
    rcases le_total k l with hkl | hlk
    · exact hNU (htail ij N k l hk hkl)
    · have h := htail ij N l k hl hlk
      simpa using hNU ((J ^ N).neg_mem h)
  have hqLimits : ∀ ij : σ × σ, ∃ x : C,
      Filter.Tendsto (qPartial ij) Filter.atTop (nhds x) := fun ij ↦
    cauchySeq_tendsto_of_complete (hqCauchy ij)
  choose ξ hξ using hqLimits
  let error : C := ∑ ij, ξ ij * (δ ij.1 * δ ij.2)
  have herror_mem : error ∈ K :=
    Ideal.sum_mem _ fun ij _ ↦ K.mul_mem_left _ (Ideal.subset_span ⟨ij, rfl⟩)
  have hF : Continuous (fun z : σ × σ → C ↦
      ∑ ij, z ij * (δ ij.1 * δ ij.2)) :=
    continuous_finsetSum _ fun ij _ ↦ (continuous_apply ij).mul continuous_const
  have hqVector : Filter.Tendsto (fun N ij ↦ qPartial ij N)
      Filter.atTop (nhds ξ) := tendsto_pi_nhds.mpr hξ
  have herrorLimit : Filter.Tendsto
      (fun N ↦ ∑ ij, qPartial ij N * (δ ij.1 * δ ij.2))
      Filter.atTop (nhds error) :=
    (hF.tendsto ξ).comp hqVector
  have hEpolySeq : ∀ N,
      E (polynomialAlgHom I σ (p N)) =
        ∑ ij, qPartial ij N * (δ ij.1 * δ ij.2) := fun N ↦ by
    rw [hEpoly, htelescoping]
  have hEerror : E g = error :=
    tendsto_nhds_unique hElim (Filter.Tendsto.congr'
      (Filter.Eventually.of_forall fun N ↦ (hEpolySeq N).symm) herrorLimit)
  refine ⟨error, herror_mem, ?_⟩
  dsimp [E] at hEerror
  linear_combination hEerror

end Rig

