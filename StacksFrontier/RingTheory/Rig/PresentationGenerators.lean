module

public import StacksFrontier.RingTheory.AdicCompletion.Comparison
public import StacksFrontier.RingTheory.Rig.Category

/-!
# Completed polynomial presentations from a chosen generating set

Let `A` be a commutative ring, let `I ⊆ A` be a finitely generated ideal and let `B` be an
`I`-adically complete `A`-algebra whose reduction `B / IB` is of finite type over `A / I`. For a
family `g : Fin r → B`, substituting `g` for the variables gives an `A`-algebra map
`A[x₁, …, x_r] → B` carrying the coefficient ideal `I · A[x₁, …, x_r]` into `IB`; it extends to
the completion `A[x₁, …, x_r]^∧`. When the reductions of `g` generate `B / IB` over `A / I` the
extension is surjective, giving a presentation `B = A[x₁, …, x_r]^∧ / J`.

## Main definitions

* `Rig.completedPolynomialAlgebra` — the completed polynomial algebra
  `A[x₁, …, x_r]^∧`, completed along the ideal generated by `I`.
* `Rig.completedAeval` — the `A`-algebra map `A[x₁, …, x_r]^∧ → B` substituting a family
  `g : Fin r → B` for the variables.
* `Rig.CompletedPolynomialPresentation.ofGenerators` — the presentation of `B` cut out by
  such a family.

## Main results

* `Rig.completedAeval_algebraMap` — on polynomials `Rig.completedAeval` is `aeval g`.
* `Rig.completedAeval_surjective` — it is surjective as soon as the reductions of `g`
  generate `B / IB` over `A / I`.
* `Rig.subalgebra_eq_top_of_isNilpotent` — a subalgebra which together with a nilpotent ideal
  extended from the base exhausts the algebra is the whole algebra.
* `Rig.le_adjoin_sup_smul_top` — the generation hypothesis restated: every element of `B`
  differs from a polynomial expression in `g` by an element of `IB`.

## References

* [Stacks Project, Tag 0AJP](https://stacks.math.columbia.edu/tag/0AJP)
* [Stacks Project, Tag 0G8U](https://stacks.math.columbia.edu/tag/0G8U)
-/

@[expose] public section

namespace Rig

universe u v

section Nilpotent

variable {R : Type*} [CommRing R] {S : Type*} [CommRing S] [Algebra R S]

/-- From `I • M ≤ M` and `⊤ ≤ M ⊔ I • ⊤`, iterating gives `⊤ ≤ M ⊔ I ^ (k + 1) • ⊤` for
every `k`. -/
private theorem le_sup_pow_smul_top (I : Ideal R) (M : Submodule R S) (hIM : I • M ≤ M)
    (h : (⊤ : Submodule R S) ≤ M ⊔ I • ⊤) (k : ℕ) :
    (⊤ : Submodule R S) ≤ M ⊔ I ^ (k + 1) • (⊤ : Submodule R S) := by
  induction k with
  | zero => simpa using h
  | succ n ih =>
      have h₁ : I • (⊤ : Submodule R S) ≤ M ⊔ I ^ (n + 2) • ⊤ := by
        calc I • (⊤ : Submodule R S) ≤ I • (M ⊔ I ^ (n + 1) • ⊤) :=
              Submodule.smul_mono le_rfl ih
          _ = I • M ⊔ I • (I ^ (n + 1) • ⊤) := by rw [Submodule.smul_sup]
          _ = I • M ⊔ (I * I ^ (n + 1)) • ⊤ := by rw [Submodule.mul_smul]
          _ = I • M ⊔ I ^ (n + 2) • ⊤ := by ring_nf
          _ ≤ M ⊔ I ^ (n + 2) • ⊤ := sup_le_sup_right hIM _
      calc (⊤ : Submodule R S) ≤ M ⊔ I • ⊤ := h
        _ ≤ M ⊔ (M ⊔ I ^ (n + 2) • ⊤) := sup_le_sup_left h₁ _
        _ = M ⊔ I ^ (n + 2) • ⊤ := by rw [← sup_assoc, sup_idem]

/-- A subalgebra `T` of `S` which together with the extension of a nilpotent ideal `I` of the
base exhausts `S` is all of `S`. -/
public theorem subalgebra_eq_top_of_isNilpotent (I : Ideal R) (hI : IsNilpotent I)
    (T : Subalgebra R S)
    (h : (⊤ : Submodule R S) ≤ T.toSubmodule ⊔ I • (⊤ : Submodule R S)) :
    T = ⊤ := by
  obtain ⟨m, hm⟩ := hI
  have hIM : I • T.toSubmodule ≤ T.toSubmodule :=
    Submodule.smul_le.mpr fun r _ _ hn ↦ T.toSubmodule.smul_mem r hn
  have key : (⊤ : Submodule R S) ≤ T.toSubmodule ⊔ I ^ m • (⊤ : Submodule R S) := by
    cases m with
    | zero =>
        rw [pow_zero, one_smul]
        exact le_sup_right
    | succ p => simpa using le_sup_pow_smul_top I T.toSubmodule hIM h p
  have hzero : I ^ m • (⊤ : Submodule R S) = ⊥ := by rw [hm]; simp
  rw [hzero, sup_bot_eq] at key
  exact Subalgebra.toSubmodule_injective (le_antisymm le_top key)

end Nilpotent

section

variable {A : Type u} [CommRing A]

/-- The completed polynomial algebra `A[x₁, …, x_r]^∧`: the polynomial algebra in `r`
variables over `A`, completed along the ideal generated by `I`. -/
public abbrev completedPolynomialAlgebra (I : Ideal A) (r : ℕ) :=
  AdicCompletion (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A))
    (MvPolynomial (Fin r) A)

end

open AdicFiniteTypeAlgebra

attribute [local instance] AdicFiniteTypeAlgebra.isAdicallyComplete

section

variable {A : Type u} [CommRing A] {I : Ideal A} (B : AdicFiniteTypeAlgebra.{u, v} A I)
  (r : ℕ) (g : Fin r → B.carrier)

/-- Substituting `g` for the variables carries the coefficient ideal of the polynomial algebra
into the ideal generated by `I`. -/
public theorem map_aeval_le_adicIdeal :
    (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)).map
        (MvPolynomial.aeval g : MvPolynomial (Fin r) A →ₐ[A] B.carrier).toRingHom ≤
      B.adicIdeal := by
  rw [Ideal.map_map]
  have hf : (MvPolynomial.aeval g : MvPolynomial (Fin r) A →ₐ[A] B.carrier).toRingHom.comp
      (MvPolynomial.C : A →+* MvPolynomial (Fin r) A) = algebraMap A B.carrier := by
    ext a
    exact (MvPolynomial.aeval g).commutes a
  rw [hf]

/-- Substituting `g` for the variables carries the `n`-th power of the coefficient ideal into
the `n`-th power of the ideal generated by `I`. -/
public theorem pow_le_comap_pow_aeval (n : ℕ) :
    (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) ^ n ≤
      (B.adicIdeal ^ n).comap
        (MvPolynomial.aeval g : MvPolynomial (Fin r) A →ₐ[A] B.carrier) := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
  exact Ideal.pow_right_mono (map_aeval_le_adicIdeal B r g) n

/-- The map `A[x₁, …, x_r]^∧ → B / (IB) ^ n` which reduces modulo the `n`-th power of the
coefficient ideal and then substitutes `g`. -/
public noncomputable def aevalQuotientFamily (n : ℕ) :
    completedPolynomialAlgebra I r →ₐ[A] B.carrier ⧸ B.adicIdeal ^ n :=
  (Ideal.quotientMapₐ (R₁ := A) (B.adicIdeal ^ n)
      (MvPolynomial.aeval g : MvPolynomial (Fin r) A →ₐ[A] B.carrier)
      (pow_le_comap_pow_aeval B r g n)).comp
    ((AdicCompletion.evalₐ
      (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) n).restrictScalars A)

/-- The family `Rig.aevalQuotientFamily` is compatible with the reductions of the `IB`-adic
tower. -/
public theorem factorₐ_comp_aevalQuotientFamily {m n : ℕ} (hmn : m ≤ n) :
    (Ideal.Quotient.factorₐ A (Ideal.pow_le_pow_right hmn)).comp
        (aevalQuotientFamily B r g n) = aevalQuotientFamily B r g m := by
  ext x
  have heval : Ideal.Quotient.factor (Ideal.pow_le_pow_right hmn)
      (AdicCompletion.evalₐ (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) n x) =
      AdicCompletion.evalₐ (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) m x :=
    AdicCompletion.factor_evalₐ _ hmn x
  simp only [aevalQuotientFamily, AlgHom.comp_apply, AlgHom.coe_restrictScalars',
    Ideal.Quotient.factorₐ_apply]
  rw [← heval]
  induction AdicCompletion.evalₐ
      (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) n x using
    Quotient.inductionOn' with
  | _ z => rfl

/-- The `A`-algebra map `A[x₁, …, x_r]^∧ → B` substituting the family `g` for the variables. -/
public noncomputable def completedAeval :
    completedPolynomialAlgebra I r →ₐ[A] B.carrier :=
  IsAdicComplete.liftAlgHom B.adicIdeal (aevalQuotientFamily B r g)
    (fun hmn ↦ factorₐ_comp_aevalQuotientFamily B r g hmn)

/-- Reducing `Rig.completedAeval` modulo `(I B) ^ n` gives the `n`-th member of the
family `Rig.aevalQuotientFamily`. -/
public theorem mk_completedAeval (n : ℕ) (x : completedPolynomialAlgebra I r) :
    Ideal.Quotient.mk (B.adicIdeal ^ n) (completedAeval B r g x) =
      aevalQuotientFamily B r g n x :=
  IsAdicComplete.mk_liftAlgHom B.adicIdeal (aevalQuotientFamily B r g)
    (fun hmn ↦ factorₐ_comp_aevalQuotientFamily B r g hmn) n x

/-- On polynomials, the family `Rig.aevalQuotientFamily` is substitution of `g` followed by
reduction. -/
public theorem aevalQuotientFamily_algebraMap (n : ℕ) (p : MvPolynomial (Fin r) A) :
    aevalQuotientFamily B r g n
        (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) =
      Ideal.Quotient.mk (B.adicIdeal ^ n) (MvPolynomial.aeval g p) := by
  simp only [aevalQuotientFamily, AlgHom.comp_apply, AlgHom.coe_restrictScalars',
    AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply,
    AdicCompletion.evalₐ_of]
  rfl

/-- On polynomials, `Rig.completedAeval` is substitution of `g` for the variables. -/
public theorem completedAeval_algebraMap (p : MvPolynomial (Fin r) A) :
    completedAeval B r g
        (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) =
      MvPolynomial.aeval g p := by
  have h : (completedAeval B r g).comp
        (IsScalarTower.toAlgHom A (MvPolynomial (Fin r) A)
          (completedPolynomialAlgebra I r)) =
      (MvPolynomial.aeval g : MvPolynomial (Fin r) A →ₐ[A] B.carrier) := by
    refine IsAdicComplete.algHom_ext B.adicIdeal fun n ↦ AlgHom.ext fun q ↦ ?_
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, IsScalarTower.coe_toAlgHom',
      mk_completedAeval, aevalQuotientFamily_algebraMap]
  exact DFunLike.congr_fun h p

/-- `Rig.completedAeval` sends the `i`-th variable to `g i`. -/
@[simp] public theorem completedAeval_X (i : Fin r) :
    completedAeval B r g
        (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r)
          (MvPolynomial.X i)) = g i := by
  rw [completedAeval_algebraMap, MvPolynomial.aeval_X]

/-- Reducing a substituted polynomial modulo `IB` is substituting the reductions of `g` into
the reduction of the polynomial. -/
public theorem mk_aeval (p : MvPolynomial (Fin r) A) :
    Ideal.Quotient.mk B.adicIdeal (MvPolynomial.aeval g p) =
      MvPolynomial.aeval (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i))
        (MvPolynomial.map (Ideal.Quotient.mk I) p) := by
  calc Ideal.Quotient.mk B.adicIdeal (MvPolynomial.aeval g p)
      = MvPolynomial.aeval (R := A) (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) p := by
        simpa using MvPolynomial.comp_aeval_apply g (Ideal.Quotient.mkₐ A B.adicIdeal) p
    _ = _ := (MvPolynomial.aeval_map_algebraMap (A := A ⧸ I)
        (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) p).symm

/-- If the reductions of `g` generate `B / IB` over `A / I`, every element of `B` is congruent
modulo `IB` to a polynomial expression in `g`. -/
private theorem exists_mk_aeval_eq
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) (b : B.carrier) :
    ∃ z : MvPolynomial (Fin r) A, Ideal.Quotient.mk B.adicIdeal (MvPolynomial.aeval g z) =
      Ideal.Quotient.mk B.adicIdeal b := by
  obtain ⟨x, hx⟩ := hgen (Ideal.Quotient.mk B.adicIdeal b)
  obtain ⟨z, hz⟩ := MvPolynomial.map_surjective (σ := Fin r) (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective x
  exact ⟨z, by rw [mk_aeval, hz, hx]⟩

/-- If the reductions of `g` generate `B / IB` over `A / I`, then `Rig.completedAeval` is
surjective. -/
public theorem completedAeval_surjective (hI : I.FG)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) :
    Function.Surjective (completedAeval B r g) := by
  let K := I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)
  let L := B.adicIdeal
  let F := completedAeval B r g
  have hred : Function.Surjective ((Ideal.Quotient.mk L).comp F.toRingHom) := by
    intro b
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨z, hz⟩ := exists_mk_aeval_eq B r g hgen b
    refine ⟨algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) z, ?_⟩
    show Ideal.Quotient.mk B.adicIdeal (completedAeval B r g (algebraMap _ _ z)) = _
    rw [completedAeval_algebraMap, hz]
  let T := completedPolynomialAlgebra I r
  let M : Ideal T := K.map (algebraMap (MvPolynomial (Fin r) A) T)
  have hKfg : K.FG := hI.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)
  have : IsAdicComplete K T := AdicCompletion.isAdicComplete hKfg
  have : IsPrecomplete M T := (IsPrecomplete.map_algebraMap_iff).mpr inferInstance
  have hML : M.map F.toRingHom = L := by
    dsimp only [M, K, L, AdicFiniteTypeAlgebra.adicIdeal]
    rw [Ideal.map_map, Ideal.map_map]
    congr 1
    ext a
    simp only [RingHom.comp_apply]
    rw [AdicCompletion.algebraMap_apply]
    exact F.commutes a
  have : IsHausdorff (M.map F.toRingHom) B.carrier := hML.symm ▸ inferInstance
  apply surjective_of_mk_map_comp_surjective (I := M) (f := F.toRingHom)
  show Function.Surjective ((Ideal.Quotient.mk (M.map F.toRingHom)).comp F.toRingHom)
  rwa [hML]

/-- If the reductions of `g` generate `B / IB` over `A / I`, then every element of `B` differs
from a polynomial expression in `g` by an element of `IB`. -/
public theorem le_adjoin_sup_smul_top
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) :
    (⊤ : Submodule A B.carrier) ≤
      (Algebra.adjoin A (Set.range g)).toSubmodule ⊔ I • (⊤ : Submodule A B.carrier) := by
  intro b _
  obtain ⟨z, hb⟩ := exists_mk_aeval_eq B r g hgen b
  have hmem : b - MvPolynomial.aeval g z ∈ I • (⊤ : Submodule A B.carrier) := by
    rw [Ideal.smul_top_eq_map]
    refine (Submodule.restrictScalars_mem A _ _).mpr ?_
    exact Ideal.Quotient.eq_zero_iff_mem.mp (by rw [map_sub, hb, sub_self])
  have hadj : MvPolynomial.aeval g z ∈ (Algebra.adjoin A (Set.range g)).toSubmodule := by
    rw [Subalgebra.mem_toSubmodule, Algebra.adjoin_range_eq_range_aeval]
    exact ⟨z, rfl⟩
  rw [show b = MvPolynomial.aeval g z + (b - MvPolynomial.aeval g z) by ring]
  exact Submodule.add_mem_sup hadj hmem

namespace CompletedPolynomialPresentation

/-- The presentation `B = A[x₁, …, x_r]^∧ / J` cut out by a family `g : Fin r → B` whose
reductions generate `B / IB` over `A / I`. -/
public noncomputable def ofGenerators (hI : I.FG)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) :
    CompletedPolynomialPresentation I B where
  variableCount := r
  ideal := RingHom.ker (completedAeval B r g).toRingHom
  quotientEquiv :=
    Ideal.quotientKerAlgEquivOfSurjective (completedAeval_surjective B r g hI hgen)

/-- The number of variables of `Rig.CompletedPolynomialPresentation.ofGenerators` is `r`. -/
@[simp] public theorem ofGenerators_variableCount (hI : I.FG)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) :
    (ofGenerators B r g hI hgen).variableCount = r := rfl

/-- The ideal of `Rig.CompletedPolynomialPresentation.ofGenerators` is the kernel of
`Rig.completedAeval`. -/
@[simp] public theorem ofGenerators_ideal (hI : I.FG)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) :
    (ofGenerators B r g hI hgen).ideal =
      RingHom.ker (completedAeval B r g).toRingHom := rfl

/-- The presenting equivalence of `Rig.CompletedPolynomialPresentation.ofGenerators` sends
the class of a restricted power series to its image under `Rig.completedAeval`. -/
@[simp] public theorem ofGenerators_quotientEquiv_mk (hI : I.FG)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction))
    (x : completedPolynomialAlgebra I r) :
    (ofGenerators B r g hI hgen).quotientEquiv
        (Ideal.Quotient.mk (ofGenerators B r g hI hgen).ideal x) =
      completedAeval B r g x := rfl

end CompletedPolynomialPresentation

end

end Rig

