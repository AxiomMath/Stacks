/-!
# The Jacobian determinant annihilates the naive cotangent complex

Let `B = A[x₁, …, xₙ]/(f₁, …, fₘ)` with `m ≤ n`, and let `J` be the Jacobian matrix formed
from the first `m` variables.  The image of `det J` in `B` annihilates the naive cotangent
complex `NL_{B/A}` in the derived category of `B`-modules: it kills `Ext¹_B(NL_{B/A}, N)` for
every `B`-module `N`, and when `m = n` it is already the zero endomorphism of `NL_{B/A}`.

Both statements are transported from the truncated presentation complex of
`StacksFrontier.RingTheory.Rig.Algebraization.Ext`, where the adjugate of the Jacobian gives an
explicit null homotopy.  The transport goes along the basis isomorphism to the presentation
complex and then along the comparison with the canonical presentation; at each step a
homotopy equivalence of two-term complexes carries a factorisation of multiplication by a
scalar through the differential to a factorisation on the target.

## Main definitions

* `Rig.derivedNaiveCotangentComplex` — the homologically indexed naive cotangent complex,
  universe-lifted and regarded as an object of the derived category.

## Main results

* `Rig.jacobianDet_smul_naiveCotangentComplex_eq_zero` — for a square presentation the
  Jacobian determinant is zero on `NL_{B/A}` in the derived category.
* `Rig.jacobianDet_smul_ext_one_naiveCotangentComplex_eq_zero` — the Jacobian determinant
  annihilates `Ext¹_B(NL_{B/A}, N)` for every `N`.

## Implementation notes

For the square case the equality of the numbers of equations and variables is incorporated by
indexing both families by `Fin n`, and the derived naive cotangent complex is the existing
construction `Deformation.Artin.derivedNaiveCotangentComplex`.

For the Ext statement the existing naive cotangent complex is indexed homologically in
degrees `1` and `0`; to form derived Ext we universe-lift its two terms, place them with the
same differential in cohomological degrees `-1` and `0`, and apply the localization functor
to the derived category.  The quotient algebra is written explicitly as the quotient of
`MvPolynomial (Fin n) A` by the ideal generated by the given equations, and the inequality
`m ≤ n` embeds the first `m` variables into the full set of variables in the Jacobian matrix.

## References

* [Stacks Project, Tag 0GAV](https://stacks.math.columbia.edu/tag/0GAV)
-/

@[expose] public section

attribute [local instance] HasDerivedCategory.standard

namespace Rig

section

open CategoryTheory CategoryTheory.Limits MvPolynomial

universe u

/-- Conjugating by isomorphisms transports `d ≫ t = a • 𝟙` through `D = e₁.hom ≫ d ≫ e₀.inv`. -/
private theorem comp_conj_eq_smul_id_iff
    {R : Type*} {C : Type*} [CommRing R] [Category C] [Preadditive C] [Linear R C]
    {X Y X' Y' : C} (e₁ : X' ≅ X) (e₀ : Y' ≅ Y) {D : X' ⟶ Y'} {d : X ⟶ Y}
    (hd : D = e₁.hom ≫ d ≫ e₀.inv) {h : Y' ⟶ X'} {t : Y ⟶ X}
    (ht : h = e₀.hom ≫ t ≫ e₁.inv) (a : R) :
    D ≫ h = a • 𝟙 X' ↔ d ≫ t = a • 𝟙 X := by
  subst hd ht
  constructor
  · intro h
    simpa using congrArg (fun z => e₁.inv ≫ z ≫ e₁.hom) h
  · intro h
    simp [reassoc_of% h]

/-- Conjugating by isomorphisms transports `t ≫ d = a • 𝟙` through `D = e₁.hom ≫ d ≫ e₀.inv`. -/
private theorem conj_comp_eq_smul_id_iff
    {R : Type*} {C : Type*} [CommRing R] [Category C] [Preadditive C] [Linear R C]
    {X Y X' Y' : C} (e₁ : X' ≅ X) (e₀ : Y' ≅ Y) {D : X' ⟶ Y'} {d : X ⟶ Y}
    (hd : D = e₁.hom ≫ d ≫ e₀.inv) {h : Y' ⟶ X'} {t : Y ⟶ X}
    (ht : h = e₀.hom ≫ t ≫ e₁.inv) (a : R) :
    h ≫ D = a • 𝟙 Y' ↔ t ≫ d = a • 𝟙 Y := by
  subst hd ht
  constructor
  · intro h
    simpa using congrArg (fun z => e₀.inv ≫ z ≫ e₀.hom) h
  · intro h
    simp [reassoc_of% h]

/-- A composite of linear maps is a scalar iff the composite of the `ModuleCat` morphisms is. -/
private theorem ofHom_comp_eq_smul_id_iff {R : Type u} [CommRing R] {M N : Type u}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (d : M →ₗ[R] N)
    (t : N →ₗ[R] M) (a : R) :
    ModuleCat.ofHom d ≫ ModuleCat.ofHom t = a • 𝟙 (ModuleCat.of R M) ↔
      t ∘ₗ d = a • LinearMap.id := by
  simp [ModuleCat.hom_ext_iff, LinearMap.ext_iff]

/-- The comparison from the presentation `f` to the canonical presentation of its quotient
is a homotopy equivalence of naive cotangent complexes. -/
private theorem isHomotopyEquiv_nlMap_canonical
    {A : Type u} [CommRing A] {m n : ℕ} (f : Fin m → MvPolynomial (Fin n) A) :
    NaiveCotangent.IsHomotopyEquiv (NaiveCotangent.nlMap (presentation f)
      (NaiveCotangent.canonicalGenerators A (PresentationQuotient f))
      ((presentation f).defaultHom
        (NaiveCotangent.canonicalGenerators A (PresentationQuotient f)))) :=
  (NaiveCotangent.nlMap_isHomotopyEquiv_and_isQuasiIso
    (R' := A) (S' := PresentationQuotient f) (R := A) (S := PresentationQuotient f)
    (by simpa using (Function.bijective_id : Function.Bijective (id : A → A)))
    (by simpa using (Function.bijective_id :
      Function.Bijective (id : PresentationQuotient f → PresentationQuotient f)))
    (presentation f)
    (NaiveCotangent.canonicalGenerators A (PresentationQuotient f))
    ((presentation f).defaultHom
      (NaiveCotangent.canonicalGenerators A (PresentationQuotient f)))).1

private lemma transfer_scalar_nullhomotopy
    {R : Type u} [CommRing R] {P Q : NaiveCotangent.TwoTerm R}
    (e : NaiveCotangent.ChainMap P Q)
    (he : NaiveCotangent.IsHomotopyEquiv e) (a : R)
    (h : P.X₀ →ₗ[R] P.X₁)
    (h₁ : a • LinearMap.id = h ∘ₗ P.d)
    (h₀ : a • LinearMap.id = P.d ∘ₗ h) :
    ∃ k : Q.X₀ →ₗ[R] Q.X₁,
      a • LinearMap.id = k ∘ₗ Q.d ∧ a • LinearMap.id = Q.d ∘ₗ k := by
  obtain ⟨g, _, ⟨k, hk₁, hk₀⟩⟩ := he
  refine ⟨e.f₁ ∘ₗ h ∘ₗ g.f₀ - a • k, ?_, ?_⟩
  · apply LinearMap.ext
    intro x
    have hg : P.d (g.f₁ x) = g.f₀ (Q.d x) := congrArg (fun z => z x) g.comm
    have hh : h (P.d (g.f₁ x)) = a • g.f₁ x := (congrArg (fun z => z (g.f₁ x)) h₁).symm
    have hkx : e.f₁ (g.f₁ x) - x = k (Q.d x) := congrArg (fun z => z x) hk₁
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
      LinearMap.comp_apply]
    rw [← hg, hh, map_smul, ← hkx]
    module
  · apply LinearMap.ext
    intro x
    have heq : Q.d (e.f₁ (h (g.f₀ x))) = e.f₀ (P.d (h (g.f₀ x))) :=
      congrArg (fun z => z (h (g.f₀ x))) e.comm
    have hh : P.d (h (g.f₀ x)) = a • g.f₀ x := (congrArg (fun z => z (g.f₀ x)) h₀).symm
    have hkx : e.f₀ (g.f₀ x) - x = Q.d (k x) := congrArg (fun z => z x) hk₀
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
      LinearMap.comp_apply, map_sub, map_smul]
    rw [heq, hh, map_smul, ← hkx]
    module

private theorem scalarNullHomotopy_of_homotopy
    {R : Type u} [CommRing R] [Small.{u} R]
    (L : CochainComplex (ModuleCat.{u} R) ℤ) (a : R)
    (H : Homotopy (a • 𝟙 L) 0)
    (hzneg : IsZero (L.X (-2))) (hzpos : IsZero (L.X 1)) :
    ∃ h : L.X 0 ⟶ L.X (-1),
      L.d (-1) 0 ≫ h = a • 𝟙 (L.X (-1)) ∧
        h ≫ L.d (-1) 0 = a • 𝟙 (L.X 0) := by
  refine ⟨H.hom 0 (-1), ?_, ?_⟩
  · have hh := H.comm (-1)
    rw [show HomologicalComplex.Hom.f (0 : L ⟶ L) (-1) = 0 from rfl,
      add_zero, HomologicalComplex.smul_f_apply, HomologicalComplex.id_f] at hh
    rw [dNext_eq H.hom (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl),
      prevD_eq H.hom (ComplexShape.up_mk (-2) (-1) (by norm_num))] at hh
    rw [hzneg.eq_zero_of_tgt (H.hom (-1) (-2)), Limits.zero_comp, add_zero] at hh
    simpa using hh.symm
  · have hh := H.comm (0 : ℤ)
    rw [show HomologicalComplex.Hom.f (0 : L ⟶ L) 0 = 0 from rfl,
      add_zero, HomologicalComplex.smul_f_apply, HomologicalComplex.id_f] at hh
    rw [dNext_eq H.hom (show (ComplexShape.up ℤ).Rel 0 1 from rfl),
      prevD_eq H.hom (ComplexShape.up_mk (-1) 0 (by norm_num))] at hh
    rw [hzpos.eq_zero_of_src (H.hom 1 0), Limits.comp_zero, zero_add] at hh
    simpa using hh.symm

/-- For a square presentation `B = A[x₁, …, xₙ]/(f₁, …, fₙ)`, the image of the
Jacobian determinant annihilates `NL_{B/A}` in the derived category of `B`-modules. -/
@[stacks 0GAV "square_null_action"]
public theorem jacobianDet_smul_naiveCotangentComplex_eq_zero
    (A : Type u) [CommRing A] (n : ℕ)
    (f : Fin n → MvPolynomial (Fin n) A) :
    (Ideal.Quotient.mk (Ideal.span (Set.range f))
      (Matrix.det (fun i j : Fin n ↦ MvPolynomial.pderiv i (f j)))) •
        𝟙 (Deformation.Artin.derivedNaiveCotangentComplex A
          (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f))) = 0 := by
  let B := MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f)
  let L := truncatedPresentation (le_refl n) f
  let C := truncatedPresentationCochain (le_refl n) f
  let a : B := Ideal.Quotient.mk (Ideal.span (Set.range f))
    (jacobian (le_refl n) f).det
  have hpos : ∀ i : ℤ, 0 < i → IsZero (C.X i) := fun i hi ↦
    HomologicalComplex.isZero_double_X _ _ i (by omega) (by omega)
  have hlow : ∀ i : ℤ, i ≤ (-3 : ℤ) → IsZero (C.X i) := fun i hi ↦
    HomologicalComplex.isZero_double_X _ _ i (by omega) (by omega)
  let e₀ : C.X 0 ≅ ModuleCat.of B L.X₀ :=
    HomologicalComplex.doubleXIso₁ (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  have hproj : Projective (C.X 0) := by
    have : Module.Free B L.X₀ := Module.Free.function (Fin n) B B
    exact Projective.of_iso e₀.symm inferInstance
  obtain ⟨H⟩ := TwoTermComplexExt.nonempty_homotopy_of_Q_map_eq C C hpos hproj hlow
    (a • 𝟙 C) 0 (by simpa using jacobianDet_smul_truncatedPresentation_eq_zero (le_refl n) f)
    (by simp)
  obtain ⟨hC, hC₁, hC₀⟩ := scalarNullHomotopy_of_homotopy C a H
    (HomologicalComplex.isZero_double_X (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (-2) (by omega) (by omega))
    (hpos 1 (by norm_num))
  let e₁ : C.X (-1) ≅ ModuleCat.of B L.X₁ :=
    HomologicalComplex.doubleXIso₀ (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  have hdL : C.d (-1) 0 = e₁.hom ≫ ModuleCat.ofHom L.d ≫ e₀.inv :=
    HomologicalComplex.double_d (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  let hL : L.X₀ →ₗ[B] L.X₁ := (e₀.inv ≫ hC ≫ e₁.hom).hom
  have hL₁ : a • LinearMap.id = hL ∘ₗ L.d :=
    ((ofHom_comp_eq_smul_id_iff _ _ _).1
      ((comp_conj_eq_smul_id_iff e₁ e₀ hdL (by simp [hL]) a).1 hC₁)).symm
  have hL₀ : a • LinearMap.id = L.d ∘ₗ hL :=
    ((ofHom_comp_eq_smul_id_iff _ _ _).1
      ((conj_comp_eq_smul_id_iff e₁ e₀ hdL (by simp [hL]) a).1 hC₀)).symm
  let eP := coordinatePresentationToPresentation f
  have heP : NaiveCotangent.IsHomotopyEquiv eP :=
    coordinatePresentationToPresentation_isHomotopyEquiv f
  obtain ⟨hPres, hPres₁, hPres₀⟩ :=
    transfer_scalar_nullhomotopy eP heP a hL hL₁ hL₀
  let B' := PresentationQuotient f
  let P' := NaiveCotangent.NL (presentation f)
  let Q' := NaiveCotangent.NL (NaiveCotangent.canonicalGenerators A B')
  let e : NaiveCotangent.ChainMap P' Q' := NaiveCotangent.nlMap (presentation f)
    (NaiveCotangent.canonicalGenerators A B')
    ((presentation f).defaultHom
      (NaiveCotangent.canonicalGenerators A B'))
  have he : NaiveCotangent.IsHomotopyEquiv e := isHomotopyEquiv_nlMap_canonical f
  obtain ⟨hQ, hQ₁, hQ₀⟩ := transfer_scalar_nullhomotopy e he a hPres hPres₁ hPres₀
  let T : CochainComplex (ModuleCat B) ℤ :=
    HomologicalComplex.double (ModuleCat.ofHom Q'.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  let q₁ : T.X (-1) ≅ ModuleCat.of B Q'.X₁ :=
    HomologicalComplex.doubleXIso₀ (ModuleCat.ofHom Q'.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  let q₀ : T.X 0 ≅ ModuleCat.of B Q'.X₀ :=
    HomologicalComplex.doubleXIso₁ (ModuleCat.ofHom Q'.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  let tT : T.X 0 ⟶ T.X (-1) := q₀.hom ≫ ModuleCat.ofHom hQ ≫ q₁.inv
  have hdT : T.d (-1) 0 = q₁.hom ≫ ModuleCat.ofHom Q'.d ≫ q₀.inv :=
    HomologicalComplex.double_d (ModuleCat.ofHom Q'.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  have ht₁ : T.d (-1) 0 ≫ tT = a • 𝟙 (T.X (-1)) :=
    (comp_conj_eq_smul_id_iff q₁ q₀ hdT rfl a).2
      ((ofHom_comp_eq_smul_id_iff _ _ _).2 hQ₁.symm)
  have ht₀ : tT ≫ T.d (-1) 0 = a • 𝟙 (T.X 0) :=
    (conj_comp_eq_smul_id_iff q₁ q₀ hdT rfl a).2
      ((ofHom_comp_eq_smul_id_iff _ _ _).2 hQ₀.symm)
  let hcomp : ∀ i j, T.X i ⟶ T.X j := fun i j =>
    if h : i = 0 ∧ j = -1 then by
      rcases h with ⟨rfl, rfl⟩
      exact tT
    else 0
  let H : Homotopy (a • 𝟙 T) 0 := {
    hom := hcomp
    zero := by
      intro i j hij
      simp only [hcomp]
      split_ifs with h
      · rcases h with ⟨rfl, rfl⟩
        exact (hij rfl).elim
      · rfl
    comm := by
      intro i
      rw [show HomologicalComplex.Hom.f (0 : T ⟶ T) i = 0 from rfl,
        add_zero, HomologicalComplex.smul_f_apply, HomologicalComplex.id_f]
      rw [dNext_eq hcomp
          (show (ComplexShape.up ℤ).Rel i (i + 1) from by simp [ComplexShape.up]),
        prevD_eq hcomp
          (show (ComplexShape.up ℤ).Rel (i - 1) i from sub_add_cancel i 1)]
      by_cases hi : i = -1
      · subst i
        change _ = T.d (-1) 0 ≫ tT + hcomp (-1) (-2) ≫ T.d (-2) (-1)
        rw [show hcomp (-1) (-2) = 0 by simp [hcomp], Limits.zero_comp, add_zero]
        exact ht₁.symm
      · by_cases hi0 : i = 0
        · subst i
          change _ = T.d 0 1 ≫ hcomp 1 0 + tT ≫ T.d (-1) 0
          rw [show hcomp 1 0 = 0 by simp [hcomp], Limits.comp_zero, zero_add]
          exact ht₀.symm
        · have hz := HomologicalComplex.isZero_double_X (ModuleCat.ofHom Q'.d)
            (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) i (by omega) (by omega)
          exact hz.eq_of_src _ _ }
  have hT' : a • 𝟙 (DerivedCategory.Q.obj T) = 0 := by
    rw [← DerivedCategory.Q.map_id, ← DerivedCategory.Q.map_smul]
    exact (DerivedCategory.Q_map_eq_of_homotopy _ H).trans (by simp)
  convert hT' using 1
  rfl

end

section

open CategoryTheory CategoryTheory.Limits

universe u v

/-- The naive cotangent complex, with its homological degrees `1, 0` read as cohomological
degrees `-1, 0`, as an object of the derived category of modules. -/
public noncomputable def derivedNaiveCotangentComplex
    (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] :
    DerivedCategory (ModuleCat.{max u v} S) :=
  let K := ((ModuleCat.uliftFunctor.{v} S).mapHomologicalComplex (ComplexShape.down ℕ)).obj
    (Algebra.naiveCotangentComplex R S)
  DerivedCategory.Q.obj
    (HomologicalComplex.double (K.d 1 0)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl))

/-- A complex of the form `double d` in degrees `-1, 0` is strictly `≥ -1` and `≤ 0`. -/
private theorem isStrictlyGE_and_isStrictlyLE_double
    {R : Type u} [CommRing R] {X Y : ModuleCat.{v} R} (d : X ⟶ Y)
    (C : CochainComplex (ModuleCat.{v} R) ℤ)
    (hC : C = HomologicalComplex.double d (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)) :
    C.IsStrictlyGE (-1) ∧ C.IsStrictlyLE 0 := by
  subst hC
  rw [CochainComplex.isStrictlyGE_iff, CochainComplex.isStrictlyLE_iff]
  exact ⟨fun i hi => HomologicalComplex.isZero_double_X _ _ i (by omega) (by omega),
    fun i hi => HomologicalComplex.isZero_double_X _ _ i (by omega) (by omega)⟩

/-- On a two-term complex in degrees `-1, 0` with projective degree `0`, multiplication by `a`
kills `Ext¹` exactly when it factors through the differential. -/
private theorem forall_Q_map_neg_smul_comp_eq_zero_iff
    {R : Type u} [CommRing R] [Small.{v} R]
    (L : CochainComplex (ModuleCat.{v} R) ℤ)
    (hge : L.IsStrictlyGE (-1)) (hle : L.IsStrictlyLE 0)
    (hproj : Projective (L.X 0)) (a : R) :
    (∀ (N : ModuleCat.{v} R) (ξ : TwoTermComplexExt.ExtMod L N 1),
      DerivedCategory.Q.map (-(a • 𝟙 L)) ≫ ξ = 0) ↔
    ∃ h : L.X 0 ⟶ L.X (-1), L.d (-1) 0 ≫ h = a • 𝟙 (L.X (-1)) := by
  have hpos : ∀ i : ℤ, 0 < i → IsZero (L.X i) :=
    fun i hi => L.isZero_of_isStrictlyLE 0 i hi
  have hsupp : ∀ i : ℤ, i ≠ -1 → i ≠ 0 → IsZero (L.X i) := by
    intro i hi₁ hi₀
    rcases lt_or_gt_of_ne hi₀ with hi | hi
    · exact L.isZero_of_isStrictlyGE (-1) i (by omega)
    · exact L.isZero_of_isStrictlyLE 0 i hi
  have hneg : (-(a • 𝟙 L)).f (-1) = -(a • 𝟙 (L.X (-1))) := by simp
  rw [TwoTermComplexExt.forall_Q_map_comp_eq_zero_iff L L hpos hproj hsupp hproj, hneg]
  exact exists_congr fun h => by rw [neg_add_eq_zero, eq_comm]

private theorem factor_of_zero_scalar
    {R : Type u} [CommRing R] [Small.{v} R]
    (L : CochainComplex (ModuleCat.{v} R) ℤ)
    (hge : L.IsStrictlyGE (-1)) (hle : L.IsStrictlyLE 0)
    (hproj : Projective (L.X 0)) (a : R)
    (hz : (DerivedCategory.Q (C := ModuleCat.{v} R)).map (a • 𝟙 L) = 0) :
    ∃ h : L.X 0 ⟶ L.X (-1), L.d (-1) 0 ≫ h = a • 𝟙 (L.X (-1)) :=
  (forall_Q_map_neg_smul_comp_eq_zero_iff L hge hle hproj a).mp fun N ξ => by
    rw [Functor.map_neg, hz, neg_zero, zero_comp]

private theorem factor_of_homotopy_equiv
    {R : Type u} [CommRing R]
    {P Q : NaiveCotangent.TwoTerm R}
    (e : NaiveCotangent.ChainMap P Q)
    (he : NaiveCotangent.IsHomotopyEquiv e)
    (a : R) (h : ∃ t : P.X₀ →ₗ[R] P.X₁,
      t ∘ₗ P.d = a • LinearMap.id) :
    ∃ t : Q.X₀ →ₗ[R] Q.X₁, t ∘ₗ Q.d = a • LinearMap.id := by
  obtain ⟨g, _, ⟨k, hk, _⟩⟩ := he
  obtain ⟨t, ht⟩ := h
  refine ⟨e.f₁ ∘ₗ t ∘ₗ g.f₀ - a • k, LinearMap.ext fun x => ?_⟩
  have hg : P.d (g.f₁ x) = g.f₀ (Q.d x) := congrArg (fun z => z x) g.comm
  have hP : t (P.d (g.f₁ x)) = a • g.f₁ x := congrArg (fun z => z (g.f₁ x)) ht
  have hkx : e.f₁ (g.f₁ x) - x = k (Q.d x) := congrArg (fun z => z x) hk
  simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.smul_apply,
    LinearMap.id_apply]
  rw [← hg, hP, map_smul, ← hkx]
  module

private theorem factor_truncated_jacobian
    {A : Type u} [CommRing A] {m n : ℕ}
    (f : Fin m → MvPolynomial (Fin n) A) (hm : m ≤ n) :
    let B := PresentationQuotient f
    let L := truncatedPresentation hm f
    ∃ t : L.X₀ →ₗ[B] L.X₁,
      t ∘ₗ L.d =
        (Ideal.Quotient.mk (Ideal.span (Set.range f))
          (jacobian hm f).det) • LinearMap.id := by
  let B := PresentationQuotient f
  let L := truncatedPresentation hm f
  let C := truncatedPresentationCochain hm f
  let a : B := Ideal.Quotient.mk (Ideal.span (Set.range f))
    (jacobian hm f).det
  obtain ⟨hge, hle⟩ := isStrictlyGE_and_isStrictlyLE_double _ C rfl
  let e₁ : C.X (-1) ≅ ModuleCat.of B L.X₁ :=
    HomologicalComplex.doubleXIso₀ (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  let e₀ : C.X 0 ≅ ModuleCat.of B L.X₀ :=
    HomologicalComplex.doubleXIso₁ (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  have hproj : Projective (C.X 0) := by
    have : Module.Free B L.X₀ := Module.Free.function (Fin m) B B
    exact Projective.of_iso e₀.symm inferInstance
  obtain ⟨h, hh⟩ := factor_of_zero_scalar C hge hle hproj a
    (jacobianDet_smul_truncatedPresentation_eq_zero hm f)
  have hd : C.d (-1) 0 = e₁.hom ≫ ModuleCat.ofHom L.d ≫ e₀.inv :=
    HomologicalComplex.double_d (ModuleCat.ofHom L.d)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  exact ⟨(e₀.inv ≫ h ≫ e₁.hom).hom, (ofHom_comp_eq_smul_id_iff _ _ _).1
    ((comp_conj_eq_smul_id_iff e₁ e₀ hd (by simp) a).1 hh)⟩

private theorem factor_presentation_jacobian
    {A : Type u} [CommRing A] {m n : ℕ}
    (f : Fin m → MvPolynomial (Fin n) A) (hm : m ≤ n) :
    let B := PresentationQuotient f
    let P := NaiveCotangent.NL (presentation f)
    ∃ t : P.X₀ →ₗ[B] P.X₁,
      t ∘ₗ P.d =
        (Ideal.Quotient.mk (Ideal.span (Set.range f))
          (jacobian hm f).det) • LinearMap.id := by
  let B := PresentationQuotient f
  let L := truncatedPresentation hm f
  let P := NaiveCotangent.NL (presentation f)
  let q : P.X₀ →ₗ[B] L.X₀ := LinearMap.pi fun i ↦
    (Finsupp.lapply (Fin.castLE hm i)) ∘ₗ
      (presentation f).cotangentSpaceBasis.repr.toLinearMap
  obtain ⟨t, ht⟩ := factor_truncated_jacobian f hm
  exact ⟨t ∘ₗ q, LinearMap.ext fun x => congrArg (fun z : L.X₁ →ₗ[B] L.X₁ => z x) ht⟩

private theorem factor_canonical_jacobian
    {A : Type u} [CommRing A] {m n : ℕ}
    (f : Fin m → MvPolynomial (Fin n) A) (hm : m ≤ n) :
    let B := PresentationQuotient f
    let Q := NaiveCotangent.NL (NaiveCotangent.canonicalGenerators A B)
    ∃ t : Q.X₀ →ₗ[B] Q.X₁,
      t ∘ₗ Q.d =
        (Ideal.Quotient.mk (Ideal.span (Set.range f))
          (jacobian hm f).det) • LinearMap.id := by
  let B := PresentationQuotient f
  let P := NaiveCotangent.NL (presentation f)
  let Q := NaiveCotangent.NL (NaiveCotangent.canonicalGenerators A B)
  let e := NaiveCotangent.nlMap (presentation f)
      (NaiveCotangent.canonicalGenerators A B)
      ((presentation f).defaultHom (NaiveCotangent.canonicalGenerators A B))
  exact factor_of_homotopy_equiv e (isHomotopyEquiv_nlMap_canonical f) _
    (factor_presentation_jacobian f hm)

private theorem ext_one_annihilated_of_factor
    {R : Type u} [CommRing R] [Small.{v} R]
    (C : CochainComplex (ModuleCat.{v} R) ℤ)
    (hge : C.IsStrictlyGE (-1)) (hle : C.IsStrictlyLE 0)
    (hproj : Projective (C.X 0)) (a : R)
    (hfac : ∃ h : C.X 0 ⟶ C.X (-1),
      C.d (-1) 0 ≫ h = a • 𝟙 (C.X (-1))) :
    ∀ (N : ModuleCat.{v} R)
      (ξ : DerivedCategory.Ext (DerivedCategory.Q.obj C)
        ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj N) 1),
      a • ξ = 0 := by
  let targetIso (N : ModuleCat.{v} R) :
      DerivedCategory.Q.obj (TwoTermComplexExt.shiftSingle N 1) ≅
        ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj N)⟦(1 : ℤ)⟧ :=
    ((DerivedCategory.Q (C := ModuleCat.{v} R)).commShiftIso (1 : ℤ)).app
      ((CochainComplex.singleFunctor (ModuleCat.{v} R) 0).obj N)
  have hzero := (forall_Q_map_neg_smul_comp_eq_zero_iff C hge hle hproj a).mpr hfac
  intro N ξ
  apply (cancel_mono (targetIso N).inv).mp
  simpa [Category.assoc] using hzero N (ξ ≫ (targetIso N).inv)

private theorem lifted_factor_canonical_jacobian
    {A : Type u} [CommRing A] {m n : ℕ}
    (f : Fin m → MvPolynomial (Fin n) A) (hm : m ≤ n) :
    let B := PresentationQuotient f
    let U := ModuleCat.uliftFunctor.{v} B
    let K := (U.mapHomologicalComplex (ComplexShape.down ℕ)).obj
      (Algebra.naiveCotangentComplex A B)
    let C : CochainComplex (ModuleCat.{max u v} B) ℤ := HomologicalComplex.double (K.d 1 0)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
    ∃ h : C.X 0 ⟶ C.X (-1),
      C.d (-1) 0 ≫ h =
        (Ideal.Quotient.mk (Ideal.span (Set.range f))
          (jacobian hm f).det) • 𝟙 (C.X (-1)) := by
  let B := PresentationQuotient f
  let Q := NaiveCotangent.NL (NaiveCotangent.canonicalGenerators A B)
  let U := ModuleCat.uliftFunctor.{v} B
  let K := (U.mapHomologicalComplex (ComplexShape.down ℕ)).obj
    (Algebra.naiveCotangentComplex A B)
  let C := HomologicalComplex.double (K.d 1 0)
    (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  let a : B := Ideal.Quotient.mk (Ideal.span (Set.range f))
    (jacobian hm f).det
  obtain ⟨t, ht⟩ := factor_canonical_jacobian f hm
  let D := Algebra.naiveCotangentComplex A B
  let p₁ : D.X 1 ≅ ModuleCat.of B Q.X₁ :=
    HomologicalComplex.doubleXIso₀ (ModuleCat.ofHom Q.d)
      (show (ComplexShape.down ℕ).Rel 1 0 from rfl)
  let p₀ : D.X 0 ≅ ModuleCat.of B Q.X₀ :=
    HomologicalComplex.doubleXIso₁ (ModuleCat.ofHom Q.d)
      (show (ComplexShape.down ℕ).Rel 1 0 from rfl) (by omega)
  let tD : D.X 0 ⟶ D.X 1 := p₀.hom ≫ ModuleCat.ofHom t ≫ p₁.inv
  have hdD : D.d 1 0 = p₁.hom ≫ ModuleCat.ofHom Q.d ≫ p₀.inv :=
    HomologicalComplex.double_d (ModuleCat.ofHom Q.d)
      (show (ComplexShape.down ℕ).Rel 1 0 from rfl) (by omega)
  have hD : D.d 1 0 ≫ tD = a • 𝟙 (D.X 1) :=
    (comp_conj_eq_smul_id_iff p₁ p₀ hdD rfl a).2 ((ofHom_comp_eq_smul_id_iff _ _ _).2 ht)
  have hK : K.d 1 0 ≫ U.map tD = a • 𝟙 (K.X 1) := by
    change U.map (D.d 1 0) ≫ U.map tD = a • 𝟙 (U.obj (D.X 1))
    rw [← U.map_comp, hD]
    apply ModuleCat.hom_ext
    ext x
    rfl
  let e₁ : C.X (-1) ≅ K.X 1 :=
    HomologicalComplex.doubleXIso₀ (K.d 1 0)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  let e₀ : C.X 0 ≅ K.X 0 :=
    HomologicalComplex.doubleXIso₁ (K.d 1 0)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  have hd : C.d (-1) 0 = e₁.hom ≫ K.d 1 0 ≫ e₀.inv :=
    HomologicalComplex.double_d (K.d 1 0)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  exact ⟨e₀.hom ≫ U.map tD ≫ e₁.inv, (comp_conj_eq_smul_id_iff e₁ e₀ hd rfl a).2 hK⟩

/-- Let `B = A[x₁, …, xₙ]/(f₁, …, fₘ)`, where `m ≤ n`.  The image in `B` of the
Jacobian determinant formed with the first `m` variables annihilates
`Ext¹_B(NL_{B/A}, N)` for every `B`-module `N`. -/
@[stacks 0GAV "ext_annihilation"]
public theorem jacobianDet_smul_ext_one_naiveCotangentComplex_eq_zero
    (A : Type u) [CommRing A] (m n : ℕ) (f : Fin m → MvPolynomial (Fin n) A)
    (h : m ≤ n)
    (N : ModuleCat.{max u v}
      (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f)))
    (x : DerivedCategory.Ext
      (derivedNaiveCotangentComplex A
        (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f)))
      ((DerivedCategory.singleFunctor
        (ModuleCat.{max u v} (MvPolynomial (Fin n) A ⧸ Ideal.span (Set.range f))) 0).obj N) 1) :
    Ideal.Quotient.mk (Ideal.span (Set.range f))
        (Matrix.det (fun i j : Fin m => MvPolynomial.pderiv (Fin.castLE h i) (f j))) • x = 0 := by
  let B := PresentationQuotient f
  let U := ModuleCat.uliftFunctor.{v} B
  let D := Algebra.naiveCotangentComplex A B
  let K := (U.mapHomologicalComplex (ComplexShape.down ℕ)).obj D
  let C : CochainComplex (ModuleCat.{max u v} B) ℤ := HomologicalComplex.double (K.d 1 0)
    (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl)
  let a : B := Ideal.Quotient.mk (Ideal.span (Set.range f))
    (jacobian h f).det
  obtain ⟨hge, hle⟩ := isStrictlyGE_and_isStrictlyLE_double _ C rfl
  let Q := NaiveCotangent.NL (NaiveCotangent.canonicalGenerators A B)
  let p₀ : D.X 0 ≅ ModuleCat.of B Q.X₀ :=
    HomologicalComplex.doubleXIso₁ (ModuleCat.ofHom Q.d)
      (show (ComplexShape.down ℕ).Rel 1 0 from rfl) (by omega)
  have hpD : Projective (D.X 0) := by
    have : Module.Free B Q.X₀ :=
      Module.Free.of_basis (NaiveCotangent.canonicalGenerators A B).cotangentSpaceBasis
    exact Projective.of_iso p₀.symm inferInstance
  have hpK : Projective (K.X 0) := inferInstanceAs (Projective (U.obj (D.X 0)))
  let e₀ : C.X 0 ≅ K.X 0 :=
    HomologicalComplex.doubleXIso₁ (K.d 1 0)
      (show (ComplexShape.up ℤ).Rel (-1) 0 from rfl) (by omega)
  convert ext_one_annihilated_of_factor C hge hle (Projective.of_iso e₀.symm hpK) a
    (lifted_factor_canonical_jacobian f h) N x using 1
  rfl

end

