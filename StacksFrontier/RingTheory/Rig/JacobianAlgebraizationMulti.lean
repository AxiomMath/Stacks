module

public import Mathlib.Algebra.Group.Pointwise.Set.BigOperators
public import Mathlib.Combinatorics.Pigeonhole
public import StacksFrontier.AlgebraicGeometry.IdealPowerSections.CompatibleFractions
public import StacksFrontier.RingTheory.Rig.Algebraization
public import StacksFrontier.RingTheory.Smoothing.StandardSmoothPresentation

/-!
# The multi-generator Jacobian algebra

Let `A` be a commutative ring, let `f₁, …, f_m ∈ A[x₁, …, x_r]` with `m ≤ r`, write
`Δ = det(∂fⱼ/∂xᵢ)_{1 ≤ i, j ≤ m}` for the Jacobian determinant formed from the first `m`
variables, and let `a₁, …, a_t ∈ A` and `c : ℕ`.  This file builds the algebra

`C = A[z₁, …, z_t, x₁, …, x_r] / (z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m)`

obtained by adjoining one variable `z_k` per generator `a_k`, each inverting `Δ` up to
`a_k^c`, and computes the two facts about it that the Jacobian criterion for algebraization
needs.

The first is a determinant: the Jacobian of the enlarged system with respect to the
variables `z₁, …, z_t, x₁, …, x_m` is `Δ^{t+1}`.  The matrix is block triangular — no
relation `z_kΔ - a_k^c` involves an `x`-variable outside `Δ`, and no `fⱼ` involves a
`z`-variable — with the diagonal `Δ · 1` of size `t` in one corner and the Jacobian of
`f₁, …, f_m` in the other.

The second is the consequence for the naive cotangent complex.  By Tag 0GAV the image of
`Δ^{t+1}` annihilates `Ext¹_C(NL_{C/A}, N)`, and `a_k^c = z_kΔ` in `C`, so each
`a_k^{(t+1)c}` annihilates it; a pigeonhole argument on monomials in the `a_k` then shows
that the whole of `I^{c₁}` annihilates it, where `I = (a₁, …, a_t)` and

`c₁ = 1 + t((t+1)c - 1)`.

The point of the exponent is that it is a function of `t` and `c` alone.  In the intended
application the `fⱼ` are polynomial approximations, modulo a varying power `I^n`, of elements
of a completed polynomial ring; the number `c₁` does not involve `n`, so a single power of
`I` works for every approximation order simultaneously.

Everything here is stated for a general, possibly non-square, system `f : Fin m → A[x₁, …,
x_r]` with `m ≤ r`, and for a general family `a : Fin t → A`; the one-variable, one-generator,
square case is `StacksFrontier.RingTheory.Rig.JacobianAlgebraization`.

## Main definitions

* `Rig.multiJacobianRelations` — the system `z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m`, with
  `t + m` members in `t + r` variables.
* `Rig.MultiJacobianAlgebra` — the finite type `A`-algebra `C` it presents.

## Main results

* `Rig.span_range_pow_le_span_range_pow_succ` — the pigeonhole step: the `(t·d+1)`-st power
  of the ideal generated by `t` elements lies in the ideal generated by their `(d+1)`-st
  powers.
* `Rig.span_range_pow_le_of_forall_pow_mem` — the form in which it is used: an ideal
  containing `a_k^M` for every `k` contains `I^{1 + t(M-1)}`.
* `Rig.det_pderiv_multiJacobianRelations` — the Jacobian determinant of the enlarged system
  with respect to `z₁, …, z_t, x₁, …, x_m` is `Δ^{t+1}`.
* `Rig.pow_smul_ext_one_multiJacobianAlgebra_eq_zero` — the image of `a_k^{(t+1)c}`
  annihilates `Ext¹_C(NL_{C/A}, N)`, for each `k`.
* `Rig.span_pow_smul_ext_one_multiJacobianAlgebra_eq_zero` — the image of every element of
  `I^{1 + t((t+1)c - 1)}` annihilates `Ext¹_C(NL_{C/A}, N)`.

## Implementation notes

The `z`-variables come first and the relations involving them come first, because Tag 0GAV
takes the Jacobian with respect to an initial segment of the variables, selected by
`Fin.castLE`.  Putting the `t` new variables and the `t` new relations at the front makes the
square submatrix of interest the one cut out by `Fin.castLE : Fin (t + m) → Fin (t + r)`,
which is what that lemma consumes; with the new variables last, the first `t + m` variables
would be `x₁, …, x_m` together with `x_{m+1}, …, x_{m+t}` and the statement would be about the
wrong minor.

For the same reason `det_pderiv_multiJacobianRelations` carries the inequality
`t + m ≤ t + r` as a hypothesis of its own rather than deriving it from `m ≤ r`: the proof
term appears inside `Fin.castLE` in the statement, and taking it as a variable lets the
equality be rewritten into whichever instance of Tag 0GAV is at hand.

The annihilation statement is proved by exhibiting the set of scalars annihilating a fixed
`Ext` class as an ideal of `A` and applying `span_range_pow_le_of_forall_pow_mem` to it.

`span_range_pow_le_span_range_pow_succ` sharpens
`Stacks.AlgebraicGeometry.IdealPowerSections.span_range_pow_le_span_range_pow` by one in the
exponent — that lemma reads the hypothesis as `I^{t·M+1} ⊆ (a₁^M, …, a_t^M)`, which is enough
for its own purposes but gives `1 + t(t+1)c` in place of `1 + t((t+1)c - 1)` here.  It shares
that lemma's proof and its set-power reformulation of a power of a span.

## References

* [Stacks Project, Tag 0GAV](https://stacks.math.columbia.edu/tag/0GAV)
* [Stacks Project, Tag 0GAW](https://stacks.math.columbia.edu/tag/0GAW)
-/

@[expose] public noncomputable section

open CategoryTheory MvPolynomial

namespace Rig

universe u v

attribute [local instance] HasDerivedCategory.standard

section Pigeonhole

variable {A : Type u} [CommRing A] {t : ℕ}

/-- **The sharp pigeonhole step.** For a family `a₁, …, a_t` generating an ideal `I`, the
`(t·d+1)`-st power of `I` is contained in the ideal generated by the `(d+1)`-st powers
`a_k^{d+1}`: a product of `t·d+1` of the generators must repeat one of them at least `d+1`
times. -/
public theorem span_range_pow_le_span_range_pow_succ (a : Fin t → A) (d : ℕ) :
    Ideal.span (Set.range a) ^ (t * d + 1) ≤
      Ideal.span (Set.range fun k ↦ a k ^ (d + 1)) := by
  classical
  rw [Stacks.AlgebraicGeometry.IdealPowerSections.span_pow_eq_span_setPow, Ideal.span_le]
  intro x hx
  obtain ⟨g, hg, rfl⟩ := Set.mem_pow_iff_prod.mp hx
  choose w hw using hg
  have hcard : (Finset.univ : Finset (Fin t)).card * d <
      (Finset.univ : Finset (Fin (t * d + 1))).card := by simp
  obtain ⟨k₀, -, hk₀⟩ :=
    Finset.exists_lt_card_fiber_of_mul_lt_card_of_maps_to
      (f := w) (fun k _ ↦ Finset.mem_univ (w k)) hcard
  obtain ⟨S, hS, hScard⟩ :=
    Finset.exists_subset_card_eq (s := {k ∈ Finset.univ | w k = k₀}) (n := d + 1) hk₀
  have hw0 : ∀ k ∈ S, w k = k₀ := fun k hk ↦ (Finset.mem_filter.mp (hS hk)).2
  have hconst : ∀ k ∈ S, g k = a k₀ := fun k hk ↦ by rw [← hw k, hw0 k hk]
  have hSprod : (∏ k ∈ S, g k) = a k₀ ^ (d + 1) := by
    rw [Finset.prod_congr rfl hconst, Finset.prod_const, hScard]
  have hrw : (∏ k, g k) = a k₀ ^ (d + 1) * ∏ k ∈ Sᶜ, g k := by
    rw [← Finset.prod_mul_prod_compl S, hSprod]
  rw [SetLike.mem_coe, hrw]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨k₀, rfl⟩)

/-- An ideal `J` containing the `M`-th power of each of `t` generators of `I` contains
`I^{1 + t(M-1)}`.  For `M = 0` the hypothesis says `1 ∈ J` whenever there is a generator at
all, and `I` is the zero ideal when there is none. -/
public theorem span_range_pow_le_of_forall_pow_mem (a : Fin t → A) (M : ℕ) (J : Ideal A)
    (hJ : ∀ k, a k ^ M ∈ J) :
    Ideal.span (Set.range a) ^ (1 + t * (M - 1)) ≤ J := by
  match M with
  | 0 =>
    rw [show 1 + t * (0 - 1) = 1 by omega, pow_one, Ideal.span_le]
    rintro z ⟨k, rfl⟩
    have h1 : (1 : A) ∈ J := by simpa using hJ k
    simpa using Ideal.mul_mem_left J (a k) h1
  | (d + 1) =>
    rw [show 1 + t * (d + 1 - 1) = t * d + 1 by rw [Nat.add_sub_cancel]; ring]
    exact (span_range_pow_le_span_range_pow_succ a d).trans
      (Ideal.span_le.mpr (by rintro z ⟨k, rfl⟩; exact hJ k))

end Pigeonhole

section Relations

variable {A : Type u} [CommRing A] {r m t : ℕ}

/-- The system `z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m` of `t + m` polynomials in the
`t + r` variables `z₁, …, z_t, x₁, …, x_r`, where `Δ = det(∂fⱼ/∂xᵢ)_{1 ≤ i, j ≤ m}` is the
Jacobian determinant of `f₁, …, f_m` formed from the first `m` variables.

The variables `z₁, …, z_t` are indexed by `Fin.castAdd r` and `x₁, …, x_r` by `Fin.natAdd t`;
the relations involving the `z`-variables come first, indexed by `Fin.castAdd m`. -/
public def multiJacobianRelations (hm : m ≤ r) (f : Fin m → MvPolynomial (Fin r) A)
    (a : Fin t → A) (c : ℕ) : Fin (t + m) → MvPolynomial (Fin (t + r)) A :=
  Fin.addCases
    (fun k : Fin t ↦
      X (Fin.castAdd r k) * rename (Fin.natAdd t) (jacobian hm f).det - C (a k ^ c))
    (fun j : Fin m ↦ rename (Fin.natAdd t) (f j))

/-- The relation of `Rig.multiJacobianRelations` attached to the generator `a_k` is
`z_kΔ - a_k^c`. -/
@[simp]
public theorem multiJacobianRelations_castAdd (hm : m ≤ r) (f : Fin m → MvPolynomial (Fin r) A)
    (a : Fin t → A) (c : ℕ) (k : Fin t) :
    multiJacobianRelations hm f a c (Fin.castAdd m k) =
      X (Fin.castAdd r k) * rename (Fin.natAdd t) (jacobian hm f).det - C (a k ^ c) :=
  Fin.addCases_left k

/-- The relation of `Rig.multiJacobianRelations` attached to `fⱼ` is `fⱼ` itself, read in the
enlarged variable set. -/
@[simp]
public theorem multiJacobianRelations_natAdd (hm : m ≤ r) (f : Fin m → MvPolynomial (Fin r) A)
    (a : Fin t → A) (c : ℕ) (j : Fin m) :
    multiJacobianRelations hm f a c (Fin.natAdd t j) = rename (Fin.natAdd t) (f j) :=
  Fin.addCases_right j

/-- The finite type `A`-algebra
`C = A[z₁, …, z_t, x₁, …, x_r]/(z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m)`, in which the
Jacobian determinant `Δ` of `f₁, …, f_m` divides each `a_k^c`. -/
public abbrev MultiJacobianAlgebra (hm : m ≤ r) (f : Fin m → MvPolynomial (Fin r) A)
    (a : Fin t → A) (c : ℕ) : Type u :=
  MvPolynomial (Fin (t + r)) A ⧸ Ideal.span (Set.range (multiJacobianRelations hm f a c))

/-- **The Jacobian of the enlarged system is `Δ^{t+1}`.** The determinant of the square
matrix of size `t + m` of partial derivatives of
`z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m` with respect to the first `t + m` variables
`z₁, …, z_t, x₁, …, x_m` is the `(t+1)`-st power of the Jacobian determinant
`Δ = det(∂fⱼ/∂xᵢ)_{1 ≤ i, j ≤ m}` of `f₁, …, f_m`, read in the enlarged variable set.

The matrix is block triangular: the `z`-rows meet the `f`-columns in zero, the `z`-rows meet
the `z`-columns in `Δ · 1`, and the `x`-rows meet the `f`-columns in the Jacobian matrix of
`f₁, …, f_m`. -/
public theorem det_pderiv_multiJacobianRelations (hm : m ≤ r) (h : t + m ≤ t + r)
    (f : Fin m → MvPolynomial (Fin r) A) (a : Fin t → A) (c : ℕ) :
    (Matrix.det fun i j : Fin (t + m) ↦
        MvPolynomial.pderiv (Fin.castLE h i) (multiJacobianRelations hm f a c j)) =
      rename (Fin.natAdd t) (jacobian hm f).det ^ (t + 1) := by
  classical
  have hgoal : (Matrix.det fun i j : Fin (t + m) ↦
      MvPolynomial.pderiv (Fin.castLE h i) (multiJacobianRelations hm f a c j)) =
      (jacobian h (multiJacobianRelations hm f a c)).det := rfl
  rw [hgoal]
  have hzero : ∀ (k : Fin t) (p : MvPolynomial (Fin r) A),
      MvPolynomial.pderiv (Fin.castAdd r k) (rename (Fin.natAdd t) p) = 0 := by
    intro k p
    refine pderiv_rename_eq_zero_of_not_mem_range _ _ (fun hk ↦ ?_) p
    obtain ⟨s, hs⟩ := hk
    have := congrArg Fin.val hs
    simp at this
    omega
  have hcz : ∀ k : Fin t, Fin.castLE h (Fin.castAdd m k) = Fin.castAdd r k :=
    fun k ↦ Fin.ext (by simp)
  have hcx : ∀ i : Fin m, Fin.castLE h (Fin.natAdd t i) = Fin.natAdd t (Fin.castLE hm i) :=
    fun i ↦ Fin.ext (by simp)
  have hzz : ∀ k k' : Fin t,
      MvPolynomial.pderiv (Fin.castLE h (Fin.castAdd m k))
          (multiJacobianRelations hm f a c (Fin.castAdd m k')) =
        (if k = k' then rename (Fin.natAdd t) (jacobian hm f).det else 0) := by
    intro k k'
    rw [hcz k, multiJacobianRelations_castAdd, map_sub, pderiv_C, sub_zero, pderiv_mul, hzero,
      mul_zero, add_zero]
    by_cases hk : k = k'
    · subst hk
      rw [pderiv_X_self, one_mul]
      simp
    · rw [pderiv_X_of_ne (by simpa using Ne.symm hk), zero_mul]
      simp [hk]
  have hzx : ∀ (k : Fin t) (j : Fin m),
      MvPolynomial.pderiv (Fin.castLE h (Fin.castAdd m k))
        (multiJacobianRelations hm f a c (Fin.natAdd t j)) = 0 := by
    intro k j
    rw [hcz k, multiJacobianRelations_natAdd]
    exact hzero k (f j)
  have hxx : ∀ i j : Fin m,
      MvPolynomial.pderiv (Fin.castLE h (Fin.natAdd t i))
          (multiJacobianRelations hm f a c (Fin.natAdd t j)) =
        rename (Fin.natAdd t) (MvPolynomial.pderiv (Fin.castLE hm i) (f j)) := by
    intro i j
    rw [hcx i, multiJacobianRelations_natAdd]
    exact MvPolynomial.pderiv_rename (Fin.natAdd_injective r t) _ _
  have hb : (jacobian h (multiJacobianRelations hm f a c)).submatrix
        finSumFinEquiv finSumFinEquiv =
      Matrix.fromBlocks
        (Matrix.diagonal fun _ : Fin t ↦ rename (Fin.natAdd t) (jacobian hm f).det) 0
        (Matrix.of fun i k ↦ MvPolynomial.pderiv (Fin.castLE h (Fin.natAdd t i))
          (multiJacobianRelations hm f a c (Fin.castAdd m k)))
        ((jacobian hm f).map (MvPolynomial.rename (R := A) (Fin.natAdd t))) := by
    refine Matrix.ext fun i j ↦ ?_
    rcases i with i | i <;> rcases j with j | j
    · simp only [Matrix.submatrix_apply, finSumFinEquiv_apply_left, Matrix.fromBlocks_apply₁₁,
        Matrix.diagonal_apply, jacobian, Matrix.of_apply]
      exact hzz i j
    · simp only [Matrix.submatrix_apply, finSumFinEquiv_apply_left, finSumFinEquiv_apply_right,
        Matrix.fromBlocks_apply₁₂, Matrix.zero_apply, jacobian, Matrix.of_apply]
      exact hzx i j
    · simp only [Matrix.submatrix_apply, finSumFinEquiv_apply_left, finSumFinEquiv_apply_right,
        Matrix.fromBlocks_apply₂₁, Matrix.of_apply, jacobian]
    · simp only [Matrix.submatrix_apply, finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₂₂,
        Matrix.map_apply, jacobian, Matrix.of_apply]
      exact hxx i j
  have hdet : ((jacobian hm f).map (MvPolynomial.rename (R := A) (Fin.natAdd t))).det =
      rename (Fin.natAdd t) (jacobian hm f).det :=
    (AlgHom.map_det (MvPolynomial.rename (R := A) (Fin.natAdd t)) (jacobian hm f)).symm
  rw [← Matrix.det_submatrix_equiv_self finSumFinEquiv
      (jacobian h (multiJacobianRelations hm f a c)),
    hb, Matrix.det_fromBlocks_zero₁₂, Matrix.det_diagonal, hdet, Finset.prod_const,
    Finset.card_univ, Fintype.card_fin, pow_succ]

end Relations

section ExtAnnihilation

/-- **Each `a_k^{(t+1)c}` annihilates `Ext¹` of the naive cotangent complex.** For
`C = A[z₁, …, z_t, x₁, …, x_r]/(z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m)` and every
`C`-module `N`, the image of `a_k^{(t+1)c}` annihilates `Ext¹_C(NL_{C/A}, N)`: the Jacobian
determinant of the enlarged system is `Δ^{t+1}`, which annihilates it by Tag 0GAV, and
`a_k^c = z_kΔ` in `C`. -/
public theorem pow_smul_ext_one_multiJacobianAlgebra_eq_zero
    (A : Type u) [CommRing A] {r m t : ℕ} (hm : m ≤ r) (f : Fin m → MvPolynomial (Fin r) A)
    (a : Fin t → A) (c : ℕ) (k : Fin t)
    (N : ModuleCat.{max u v} (MultiJacobianAlgebra hm f a c))
    (x : DerivedCategory.Ext
      (Rig.derivedNaiveCotangentComplex.{u, v} A (MultiJacobianAlgebra hm f a c))
      ((DerivedCategory.singleFunctor
        (ModuleCat.{max u v} (MultiJacobianAlgebra hm f a c)) 0).obj N) 1) :
    algebraMap A (MultiJacobianAlgebra hm f a c) (a k ^ ((t + 1) * c)) • x = 0 := by
  have h0 := Rig.jacobianDet_smul_ext_one_naiveCotangentComplex_eq_zero.{u, v}
    A (t + m) (t + r) (multiJacobianRelations hm f a c) (Nat.add_le_add_left hm t) N x
  rw [det_pderiv_multiJacobianRelations hm (Nat.add_le_add_left hm t) f a c, map_pow] at h0
  have h1 : Ideal.Quotient.mk (Ideal.span (Set.range (multiJacobianRelations hm f a c)))
      (multiJacobianRelations hm f a c (Fin.castAdd m k)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨Fin.castAdd m k, rfl⟩)
  rw [multiJacobianRelations_castAdd, map_sub, sub_eq_zero, map_mul] at h1
  rw [show a k ^ ((t + 1) * c) = (a k ^ c) ^ (t + 1) by rw [mul_comm, pow_mul], map_pow,
    show algebraMap A (MultiJacobianAlgebra hm f a c) (a k ^ c) =
      Ideal.Quotient.mk (Ideal.span (Set.range (multiJacobianRelations hm f a c)))
          (X (Fin.castAdd r k)) *
        Ideal.Quotient.mk (Ideal.span (Set.range (multiJacobianRelations hm f a c)))
          (rename (Fin.natAdd t) (jacobian hm f).det) from h1.symm,
    mul_pow, mul_smul, h0, smul_zero]

/-- **The ideal `I^{c₁}` annihilates `Ext¹` of the naive cotangent complex, with
`c₁ = 1 + t((t+1)c - 1)`.** For `I = (a₁, …, a_t)` and
`C = A[z₁, …, z_t, x₁, …, x_r]/(z₁Δ - a₁^c, …, z_tΔ - a_t^c, f₁, …, f_m)`, the image of every
element of `I^{1 + t((t+1)c - 1)}` annihilates `Ext¹_C(NL_{C/A}, N)` for every `C`-module
`N`.

The exponent depends only on `t` and `c`; in particular it is independent of the number `r`
of `x`-variables, of the polynomials `f₁, …, f_m` themselves, and hence of the accuracy to
which those polynomials approximate a given system. -/
public theorem span_pow_smul_ext_one_multiJacobianAlgebra_eq_zero
    (A : Type u) [CommRing A] {r m t : ℕ} (hm : m ≤ r) (f : Fin m → MvPolynomial (Fin r) A)
    (a : Fin t → A) (c : ℕ)
    (N : ModuleCat.{max u v} (MultiJacobianAlgebra hm f a c))
    (x : DerivedCategory.Ext
      (Rig.derivedNaiveCotangentComplex.{u, v} A (MultiJacobianAlgebra hm f a c))
      ((DerivedCategory.singleFunctor
        (ModuleCat.{max u v} (MultiJacobianAlgebra hm f a c)) 0).obj N) 1)
    (y : A) (hy : y ∈ Ideal.span (Set.range a) ^ (1 + t * ((t + 1) * c - 1))) :
    algebraMap A (MultiJacobianAlgebra hm f a c) y • x = 0 := by
  classical
  let ann : Ideal A := Ideal.comap (algebraMap A (MultiJacobianAlgebra hm f a c))
    (LinearMap.ker (LinearMap.toSpanSingleton (MultiJacobianAlgebra hm f a c) _ x))
  exact span_range_pow_le_of_forall_pow_mem a ((t + 1) * c) ann
    (fun k ↦ pow_smul_ext_one_multiJacobianAlgebra_eq_zero.{u, v} A hm f a c k N x) hy

end ExtAnnihilation

end Rig

end
