module

public import StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChange
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.SmulIdModule

/-!
# Stacks 0GAG on conormal modules, and the transport it performs

Let `(A₁, I₁) → (A₂, I₂)` be as in Stacks Remark 0AL5, let `B₁` be adically of finite type over
`(A₁, I₁)` and let `B₂` be its base change.  Choosing a presentation `B₁ = A₁[x]^∧ / J₁` by a
generating family `g`, `StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChange` produces the
compatible presentation `B₂ = A₂[x]^∧ / J₂` in the *same* variables and the comparison square of
Stacks 0GAG

```
J₁ / J₁²  --d-->  ⨁ B₁ dxᵢ
   |                 |
   v                 v
J₂ / J₂²  --d-->  ⨁ B₂ dxᵢ
```

Stacks 0GAG then asserts that the induced map `NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}` is an
isomorphism on `H⁰` and a surjection on `H⁻¹`.  Both assertions come from the single fact that
`J₂` is generated by the image of `J₁`: in degree `0` the two terms are `⨁ B₁ dxᵢ` and
`⨁ B₂ dxᵢ` in the same variables, so the comparison is the base change of a free module, and in
degree `-1` generation of `J₂` by the image of `J₁` is exactly surjectivity of

`J₁ / J₁² ⊗_{B₁} B₂ → J₂ / J₂²`.

This file proves that implication and runs it through the transport it is wanted for.  Writing
`β : A₁[x]^∧ → A₂[x]^∧` for `Rig.polynomialBaseChange`, the hypothesis is the ideal inclusion
`J₂ ≤ β(J₁) · A₂[x]^∧` — the one step Stacks states as "`J₂` is generated by the image of `J₁`"
and whose own proof is the limit computation `A₂[x]^∧ = (A₁[x]^∧ ⊗_{A₁} A₂)^∧`.  Given it:

* the conormal comparison map `Rig.baseChangeCotangentMap` has `B₂`-spanning image, which is the
  `H⁻¹`-surjectivity of 0GAG;
* a null-homotopy of `f₁ • 𝟙` on `NL^∧_{B₁/A₁}` transports to one of `f₂ • 𝟙` on
  `NL^∧_{B₂/A₂}`, the two halves of the homotopy relation using the comparison square and the
  spanning respectively;
* hence **Stacks 0AK2**: if `f₁` acts by zero on `NL^∧_{B₁/A₁}` in `D(B₁)` then its image acts
  by zero on `NL^∧_{B₂/A₂}` in `D(B₂)`.

The spanning is where surjectivity is genuinely used: the identity `s₂ ≫ d₂ = f₂ • 𝟙` on the
free term follows from the square alone, while `d₂ ≫ s₂ = f₂ • 𝟙` on `J₂ / J₂²` is checked on
the image of `J₁ / J₁²` and needs that image to span.

## Main results

* `Rig.map_ker_le_ker_baseChangePresentation` — the image of `J₁` lands in `J₂`, so the
  comparison square is defined; the reverse inclusion is the hypothesis `hker` below.
* `Rig.span_range_baseChangeCotangentMap_eq_top` — **the `H⁻¹` half of Stacks 0GAG**: if `J₂` is
  generated by the image of `J₁` then `J₂ / J₂²` is spanned over `B₂` by the image of
  `J₁ / J₁²`.
* `Rig.exists_differential_section_baseChange` — the transport of a null-homotopy.
* `Rig.smul_id_baseChange_of_ker_le` — **Stacks 0AK2** for the compatible presentations, and
  `Rig.smul_id_baseChange_presentation_of_ker_le` for an arbitrary presentation of `B₂`.

## References

* [Stacks Project, Tag 0GAG](https://stacks.math.columbia.edu/tag/0GAG)
* [Stacks Project, Tag 0AK2](https://stacks.math.columbia.edu/tag/0AK2)
* [Stacks Project, Tag 0GAE](https://stacks.math.columbia.edu/tag/0GAE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Rig

universe u₁ u₂ v w

open AdicFiniteTypeAlgebra CompletedPolynomialPresentation CompletedNaiveCotangentComplex

attribute [local instance] HasDerivedCategory.standard


section Transport

/-- **The transport of a null-homotopy along a spanning comparison map.**  Let `ι : R₁ → R₂` be
a ring map, let `d₁ : M₁ → R₁ ^ r` and `d₂ : M₂ → R₂ ^ r` be linear maps, and let
`θ : M₁ → M₂` be `R₁`-linear with `d₂ ∘ θ = ι ∘ d₁` coefficientwise and with `R₂`-spanning
image.  Then a null-homotopy of `f₁ • 𝟙` for `d₁` transports to one of `ι f₁ • 𝟙` for `d₂`.

The transported map is the `R₂`-linear extension of `θ ∘ σ₁` along the standard basis of
`R₂ ^ r`.  The identity on `R₂ ^ r` only uses the commuting square; the identity on `M₂` is
checked on the image of `θ`, which is where the spanning hypothesis is used.

This is the module-theoretic content of the step from Stacks 0GAG to Stacks 0AK2, isolated from
the completed naive cotangent complex so that none of its machinery enters the argument. -/
public theorem exists_section_of_spanning_comparison
    {R₁ : Type*} [CommRing R₁] {R₂ : Type*} [CommRing R₂] [Algebra R₁ R₂]
    {M₁ : Type*} [AddCommGroup M₁] [Module R₁ M₁]
    {M₂ : Type*} [AddCommGroup M₂] [Module R₂ M₂] [Module R₁ M₂] [IsScalarTower R₁ R₂ M₂]
    (r : ℕ) (d₁ : M₁ →ₗ[R₁] (Fin r → R₁)) (d₂ : M₂ →ₗ[R₂] (Fin r → R₂)) (θ : M₁ →ₗ[R₁] M₂)
    (hθd : ∀ x : M₁, d₂ (θ x) = fun i => algebraMap R₁ R₂ (d₁ x i))
    (hθspan : Submodule.span R₂ (Set.range θ) = ⊤)
    (f₁ : R₁) (σ₁ : (Fin r → R₁) →ₗ[R₁] M₁)
    (hneg₁ : ∀ y : M₁, σ₁ (d₁ y) = f₁ • y)
    (hzero₁ : ∀ x : Fin r → R₁, d₁ (σ₁ x) = f₁ • x) :
    ∃ σ₂ : (Fin r → R₂) →ₗ[R₂] M₂,
      (∀ y : M₂, σ₂ (d₂ y) = algebraMap R₁ R₂ f₁ • y) ∧
      (∀ x : Fin r → R₂, d₂ (σ₂ x) = algebraMap R₁ R₂ f₁ • x) := by
  classical
  have hθsmul : ∀ (b : R₁) (x : M₁), θ (b • x) = algebraMap R₁ R₂ b • θ x :=
    fun b x => (map_smul θ b x).trans (algebraMap_smul R₂ b (θ x)).symm
  have hsingle : ∀ v : Fin r → R₁, ∑ i : Fin r, v i • Pi.single i (1 : R₁) = v := by
    intro v
    funext j
    simp [Finset.sum_apply, Pi.single_apply]
  obtain ⟨σ₂, hσ₂⟩ : ∃ σ₂ : (Fin r → R₂) →ₗ[R₂] M₂,
      σ₂ = ∑ i : Fin r, LinearMap.smulRight
        (LinearMap.proj i : (Fin r → R₂) →ₗ[R₂] R₂) (θ (σ₁ (Pi.single i 1))) := ⟨_, rfl⟩
  have hσ₂apply : ∀ x : Fin r → R₂,
      σ₂ x = ∑ i : Fin r, x i • θ (σ₁ (Pi.single i 1)) := by
    intro x
    rw [hσ₂]
    simp
  have hσ₂comp : ∀ v : Fin r → R₁,
      σ₂ (fun i => algebraMap R₁ R₂ (v i)) = θ (σ₁ v) := by
    intro v
    rw [hσ₂apply]
    calc ∑ i : Fin r, algebraMap R₁ R₂ (v i) • θ (σ₁ (Pi.single i 1))
        = ∑ i : Fin r, θ (σ₁ (v i • Pi.single i (1 : R₁))) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_smul, hθsmul]
      _ = θ (σ₁ (∑ i : Fin r, v i • Pi.single i (1 : R₁))) := by rw [map_sum, map_sum]
      _ = θ (σ₁ v) := by rw [hsingle]
  refine ⟨σ₂, fun y => ?_, fun x => ?_⟩
  · -- checked on the spanning image of `θ`
    have hkey : σ₂.comp d₂ = algebraMap R₁ R₂ f₁ • LinearMap.id := by
      refine LinearMap.ext_on hθspan ?_
      rintro z ⟨x, rfl⟩
      change σ₂ (d₂ (θ x)) = algebraMap R₁ R₂ f₁ • θ x
      rw [hθd, hσ₂comp (d₁ x), hneg₁, hθsmul]
    simpa using LinearMap.congr_fun hkey y
  · -- the commuting square alone
    have hkey : d₂.comp σ₂ = algebraMap R₁ R₂ f₁ • LinearMap.id := by
      refine (Pi.basisFun R₂ (Fin r)).ext fun j => ?_
      have hsj : (Pi.basisFun R₂ (Fin r)) j =
          fun i => algebraMap R₁ R₂ ((Pi.single j (1 : R₁) : Fin r → R₁) i) := by
        rw [Pi.basisFun_apply]
        funext i
        by_cases hij : j = i <;> simp [hij]
      change d₂ (σ₂ ((Pi.basisFun R₂ (Fin r)) j)) =
        algebraMap R₁ R₂ f₁ • (Pi.basisFun R₂ (Fin r)) j
      rw [hsj, hσ₂comp (Pi.single j (1 : R₁)), hθd, hzero₁]
      funext i
      simp [Pi.smul_apply, map_mul]
    simpa using LinearMap.congr_fun hkey x

end Transport

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]
  (hI₁ : I₁.FG) (hI₂ : I₂.FG) (hc : 0 < c)
  (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
  (hspan : (⊤ : Submodule A₂ B₂.carrier) ≤
    Submodule.span A₂ (Set.range (algebraMap B₁.carrier B₂.carrier)) ⊔
      Submodule.restrictScalars A₂ B₂.adicIdeal)
  (r : ℕ) (g : Fin r → B₁.carrier)
  (hgen : Function.Surjective (MvPolynomial.aeval
    (fun i ↦ Ideal.Quotient.mk B₁.adicIdeal (g i)) :
      MvPolynomial (Fin r) (A₁ ⧸ I₁) →ₐ[A₁ ⧸ I₁] B₁.reduction))

/-- The base-change map of completed polynomial algebras carries `J₁` into `J₂`: that is the
content of the second field of `Rig.baseChangeExtensionHom`, and it is what makes the comparison
square of Stacks 0GAG exist.  The reverse inclusion — that `J₂` is *generated* by the image of
`J₁` — is the remaining assertion of 0GAG and appears below as a hypothesis. -/
public theorem map_ker_le_ker_baseChangePresentation :
    Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker ≤
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker := by
  rw [Ideal.map_le_iff_le_comap]
  intro z hz
  rw [RingHom.mem_ker] at hz
  simp only [Ideal.mem_comap, RingHom.mem_ker,
    (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).algebraMap_toRingHom z, hz,
    map_zero]

/-- **The `H⁻¹` half of Stacks 0GAG.**  If `J₂` is generated by the image of `J₁` under the
base-change map of completed polynomial algebras, then the conormal module `J₂ / J₂²` is
spanned over `B₂` by the image of `J₁ / J₁²` under the comparison map
`Rig.baseChangeCotangentMap`.

Equivalently: the comparison map `J₁ / J₁² ⊗_{B₁} B₂ → J₂ / J₂²` is surjective, which is the
assertion of Stacks 0GAG in degree `-1`. -/
public theorem span_range_baseChangeCotangentMap_eq_top
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker) :
    Submodule.span B₂.carrier
        (Set.range (baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen)) = ⊤ := by
  have hspanker : Ideal.span (Set.range
        (fun z : (ofGenerators B₁ r g hI₁ hgen).extension.ker =>
          (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom z.1)) =
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker := by
    refine le_antisymm (Ideal.span_le.mpr ?_) (hker.trans ?_)
    · rintro t ⟨z, rfl⟩
      exact map_ker_le_ker_baseChangePresentation hI₁ hI₂ hc hmap hspan r g hgen
        (Ideal.mem_map_of_mem _ z.2)
    · refine Ideal.map_le_iff_le_comap.mpr fun y hy => ?_
      exact Ideal.subset_span ⟨⟨y, hy⟩, rfl⟩
  have hbasis := Algebra.Extension.Cotangent.span_eq_top_of_span_eq_ker
    (P := (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension)
    (fun z : (ofGenerators B₁ r g hI₁ hgen).extension.ker =>
      (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom z.1) hspanker
  refine le_antisymm le_top (hbasis.ge.trans (Submodule.span_le.mpr ?_))
  rintro t ⟨z, rfl⟩
  exact Submodule.subset_span ⟨Algebra.Extension.Cotangent.mk z,
    (Algebra.Extension.Cotangent.map_mk
      (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen) z).symm⟩

variable [IsNoetherianRing A₁] [IsNoetherianRing A₂]

/-- **The transport of Stacks 0GAG.**  A null-homotopy `σ₁` of `f₁ • 𝟙` on the complex of the
chosen presentation of `B₁` gives a null-homotopy of `f₂ • 𝟙` on the complex of the compatible
presentation of `B₂`, where `f₂` is the image of `f₁`.

This is `Rig.exists_section_of_spanning_comparison` fed the comparison square
`Rig.baseChange_differential` and the spanning
`Rig.span_range_baseChangeCotangentMap_eq_top`. -/
public theorem exists_differential_section_baseChange
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker)
    (f₁ : B₁.carrier)
    (σ₁ : (Fin r → B₁.carrier) →ₗ[B₁.carrier]
      (ofGenerators B₁ r g hI₁ hgen).extension.Cotangent)
    (hneg₁ : ∀ y : (ofGenerators B₁ r g hI₁ hgen).extension.Cotangent,
      σ₁ ((completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)).differential y) =
        f₁ • y)
    (hzero₁ : ∀ x : Fin r → B₁.carrier,
      (completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)).differential (σ₁ x) =
        f₁ • x) :
    ∃ σ₂ : (Fin r → B₂.carrier) →ₗ[B₂.carrier]
        (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.Cotangent,
      (∀ y : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.Cotangent,
        σ₂ ((completedNaiveCotangentComplex B₂
            (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)).differential y) =
          algebraMap B₁.carrier B₂.carrier f₁ • y) ∧
      (∀ x : Fin r → B₂.carrier,
        (completedNaiveCotangentComplex B₂
            (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)).differential
          (σ₂ x) = algebraMap B₁.carrier B₂.carrier f₁ • x) :=
  exists_section_of_spanning_comparison r
    (completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)).differential
    (completedNaiveCotangentComplex B₂
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)).differential
    (baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen)
    (baseChange_differential hI₁ hI₂ hc hmap hspan r g hgen
      (completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen))
      (completedNaiveCotangentComplex B₂
        (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)))
    (span_range_baseChangeCotangentMap_eq_top hI₁ hI₂ hc hmap hspan r g hgen hker)
    f₁ σ₁ hneg₁ hzero₁

/-- **Stacks 0AK2 for the compatible presentations**, given that `J₂` is generated by the image
of `J₁`.  If a scalar `f₁ ∈ B₁` acts by zero on `NL^∧_{B₁/A₁}` in `D(B₁)` then its image acts by
zero on `NL^∧_{B₂/A₂}` in `D(B₂)`.

The hypothesis `hker` is the one step of Stacks 0GAG whose proof is the limit computation
`A₂[x]^∧ = (A₁[x]^∧ ⊗_{A₁} A₂)^∧`; everything else in 0AK2 is discharged here. -/
public theorem smul_id_baseChange_of_ker_le
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker)
    (f₁ : B₁.carrier)
    (h : f₁ • 𝟙 (derivedCompletedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)) = 0) :
    algebraMap B₁.carrier B₂.carrier f₁ •
      𝟙 (derivedCompletedNaiveCotangentComplex B₂
        (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)) = 0 := by
  obtain ⟨σ₁, hneg₁, hzero₁⟩ :=
    exists_differential_section_of_smul_id_eq_zero B₁ (ofGenerators B₁ r g hI₁ hgen) f₁ h
  obtain ⟨σ₂, hneg₂, hzero₂⟩ :=
    exists_differential_section_baseChange hI₁ hI₂ hc hmap hspan r g hgen hker f₁ σ₁
      hneg₁ hzero₁
  exact smul_id_eq_zero_of_differential_section B₂
    (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)
    (algebraMap B₁.carrier B₂.carrier f₁) σ₂ hneg₂ hzero₂

/-- **Stacks 0AK2**, for an arbitrary completed polynomial presentation of `B₂`, given that `J₂`
is generated by the image of `J₁` for the compatible presentations.  The complexes of two
presentations of `B₂` are isomorphic in `D(B₂)` by Stacks 0GAE, so the conclusion does not
depend on the presentation. -/
public theorem smul_id_baseChange_presentation_of_ker_le
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker)
    (Q : CompletedPolynomialPresentation I₂ B₂) (f₁ : B₁.carrier)
    (h : f₁ • 𝟙 (derivedCompletedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)) = 0) :
    algebraMap B₁.carrier B₂.carrier f₁ •
      𝟙 (derivedCompletedNaiveCotangentComplex B₂ Q) = 0 :=
  smul_id_congr_presentation B₂
    (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen) Q
    (algebraMap B₁.carrier B₂.carrier f₁)
    (smul_id_baseChange_of_ker_le hI₁ hI₂ hc hmap hspan r g hgen hker f₁ h)

end Rig

end
