module

public import StacksFrontier.RingTheory.Rig.Category

/-!
# A morphism of (0AL4) presents its target as an object over its source

Let `A` be a Noetherian ring, let `I ⊆ A` be an ideal, and let `B` and `C` be objects of the
category (Stacks 0AL4) of `I`-adically complete `A`-algebras of finite type modulo `I`.  A
morphism `B ⟶ C` makes `C` an algebra over `B`, and this file proves the two conditions that
exhibit `C` as an object of (0AL4) for the pair `(B, I B)`:

* `C` is `I B`-adically complete, which holds because `I B · C = I C`;
* `C / I C` is of finite type over `B / I B`, because it is of finite type over `A / I` and
  `A / I → B / I B → C / I C` is a tower.

This is the standing hypothesis of **Stacks 0ALM**, whose proof opens *"`(B, I B)` is a pair
where `B` is a Noetherian ring (Lemma 0AJQ) and `C` is in the corresponding category
(0AL4)"*, and it is equally what lets `NL^∧_{C/B}` be formed at all.  Noetherianity of `B` is
already available as `Rig.AdicFiniteTypeAlgebra.isNoetherianRing`.

## Main results

* `Rig.AdicFiniteTypeAlgebra.map_adicIdeal_tower`: `I B · C = I C`.
* `Rig.AdicFiniteTypeAlgebra.isAdicComplete_over`: `C` is `I B`-adically complete.
* `Rig.AdicFiniteTypeAlgebra.finiteType_reduction_over`: `C / I C` is of finite type over
  `B / I B`.
* `Rig.AdicFiniteTypeAlgebra.map_adicIdeal_hom`: the same ideal identity read off a
  categorical morphism `B ⟶ C` rather than off a scalar tower.

## Implementation notes

The hypotheses are an `Algebra B.carrier C.carrier` instance together with
`IsScalarTower A B.carrier C.carrier`, rather than a categorical morphism `f : B ⟶ C`: a
morphism supplies exactly these through `(AdicFiniteTypeAlgebra.hom f).toRingHom.toAlgebra`,
while the tower form is what the `Algebra.FiniteType` API consumes.  The two
morphism-level lemmas `algebraMap_comp_hom` and `map_adicIdeal_hom` are stated separately so
that a consumer holding only `f` need not install the algebra instance to use the ideal
identity.

`Rig.AdicFiniteTypeAlgebra.reductionAlgebra` has to be a named definition rather than an
instance: Mathlib's `Ideal.Quotient.algebraQuotientMapQuotient` provides
`Algebra (B / I B) (C / (I B · C))` with the ideal in the `Ideal.map` spelling, and rewriting
that spelling to `I C` inside the statement is not type correct, since the algebra instance
itself depends on the ideal.  `finiteType_reduction_over` is therefore stated with
`reductionAlgebra` in scope.

## References

* [Stacks Project, Tag 0ALM](https://stacks.math.columbia.edu/tag/0ALM)
* [Stacks Project, Tag 0AL4](https://stacks.math.columbia.edu/tag/0AL4)
-/

@[expose] public section

open CategoryTheory

namespace Rig

namespace AdicFiniteTypeAlgebra

universe u v

variable {A : Type u} [CommRing A] {I : Ideal A}

section Hom

variable {B C : AdicFiniteTypeAlgebra.{u, v} A I}

/-- A morphism of (0AL4) is a morphism of `A`-algebras. -/
public theorem algebraMap_comp_hom (f : B ⟶ C) :
    ((hom f).toRingHom).comp (algebraMap A B.carrier) = algebraMap A C.carrier := by
  ext a
  exact (hom f).commutes a

/-- Along a morphism of (0AL4), the ideal `I B` of the source generates the ideal `I C` of
the target. -/
public theorem map_adicIdeal_hom (f : B ⟶ C) :
    B.adicIdeal.map (hom f).toRingHom = C.adicIdeal := by
  rw [AdicFiniteTypeAlgebra.adicIdeal, Ideal.map_map, algebraMap_comp_hom]

end Hom

section Tower

variable {B C : AdicFiniteTypeAlgebra.{u, v} A I} [Algebra B.carrier C.carrier]
  [IsScalarTower A B.carrier C.carrier]

/-- `I B · C = I C`: the ideal of `C` generated by the adic ideal of `B` is the adic ideal of
`C`. -/
public theorem map_adicIdeal_tower :
    B.adicIdeal.map (algebraMap B.carrier C.carrier) = C.adicIdeal := by
  rw [AdicFiniteTypeAlgebra.adicIdeal, Ideal.map_map, ← IsScalarTower.algebraMap_eq]

/-- The first condition of (0AL4) for `C` over `(B, I B)`: `C` is `I B`-adically complete.
Since `I B · C = I C`, this is the adic completeness of `C` over `(A, I)`. -/
public theorem isAdicComplete_over :
    IsAdicComplete (B.adicIdeal.map (algebraMap B.carrier C.carrier)) C.carrier := by
  rw [map_adicIdeal_tower]
  exact C.isAdicallyComplete

/-- `C / I C` as an algebra over `B / I B`.  The map is the one induced by `B → C`, which
sends `I B` into `I C` by `map_adicIdeal_tower`. -/
@[instance_reducible]
public noncomputable def reductionAlgebra :
    Algebra (B.carrier ⧸ B.adicIdeal) (C.carrier ⧸ C.adicIdeal) :=
  Ideal.Quotient.algebraQuotientOfLEComap (p := B.adicIdeal) (P := C.adicIdeal)
    (by rw [← map_adicIdeal_tower (B := B) (C := C)]; exact Ideal.le_comap_map)

/-- The reduction `B / I B → C / I C` is a map of `A / I`-algebras. -/
public theorem isScalarTower_reduction_over :
    letI := reductionAlgebra (B := B) (C := C)
    IsScalarTower (A ⧸ I) (B.carrier ⧸ B.adicIdeal) (C.carrier ⧸ C.adicIdeal) := by
  let _ := reductionAlgebra (B := B) (C := C)
  refine IsScalarTower.of_algebraMap_eq fun x => ?_
  induction x using Quotient.inductionOn' with
  | h a =>
    exact congrArg (Ideal.Quotient.mk C.adicIdeal)
      (IsScalarTower.algebraMap_apply A B.carrier C.carrier a)

/-- The second condition of (0AL4) for `C` over `(B, I B)`: `C / I C` is of finite type over
`B / I B`.  It is of finite type over `A / I` by assumption on `C`, and `A / I → B / I B →
C / I C` is a tower. -/
public theorem finiteType_reduction_over :
    letI := reductionAlgebra (B := B) (C := C)
    Algebra.FiniteType (B.carrier ⧸ B.adicIdeal) (C.carrier ⧸ C.adicIdeal) := by
  let _ := reductionAlgebra (B := B) (C := C)
  have := isScalarTower_reduction_over (B := B) (C := C)
  exact Algebra.FiniteType.of_restrictScalars_finiteType (A ⧸ I) _ _

/-- `C / (I B) C` is of finite type over `B / I B`, for the quotient algebra structure in which
the second condition of (0AL4) for `C` over `(B, I B)` is stated. -/
public theorem finiteType_quotient_map_adicIdeal :
    Algebra.FiniteType (B.carrier ⧸ B.adicIdeal)
      (C.carrier ⧸ B.adicIdeal.map (algebraMap B.carrier C.carrier)) := by
  let _ := reductionAlgebra (B := B) (C := C)
  let e : (C.carrier ⧸ C.adicIdeal) ≃+*
      (C.carrier ⧸ B.adicIdeal.map (algebraMap B.carrier C.carrier)) :=
    Ideal.quotEquivOfEq (map_adicIdeal_tower (B := B) (C := C)).symm
  have h2 : algebraMap (B.carrier ⧸ B.adicIdeal)
      (C.carrier ⧸ B.adicIdeal.map (algebraMap B.carrier C.carrier)) =
      (e : _ →+* _).comp (algebraMap (B.carrier ⧸ B.adicIdeal) (C.carrier ⧸ C.adicIdeal)) := by
    refine RingHom.ext fun x => ?_
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    rfl
  rw [← RingHom.finiteType_algebraMap, h2]
  exact (RingHom.FiniteType.of_surjective _ e.surjective).comp
    (RingHom.finiteType_algebraMap.mpr (finiteType_reduction_over (B := B) (C := C)))

/-- **`C` as an object of (0AL4) over `(B, I B)`.**  This is the object over which
`NL^∧_{C/B}` is formed, and over which "the arrow `B → C` is rig-smooth" (Stacks 0GCJ) is
asserted. -/
public noncomputable def overBase : AdicFiniteTypeAlgebra.{v, v} B.carrier B.adicIdeal :=
  haveI := finiteType_quotient_map_adicIdeal (B := B) (C := C)
  AdicFiniteTypeAlgebra.of C.carrier (isAdicComplete_over (B := B) (C := C))

end Tower

end AdicFiniteTypeAlgebra

end Rig

end
