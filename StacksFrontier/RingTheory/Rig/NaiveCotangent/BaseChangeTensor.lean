module

public import StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChangeKer

/-!
# The limit computation of Stacks 0GAG, for the canonical completed base change

Let `(A₁, I₁) → (A₂, I₂)` be as in Stacks Remark 0AL5, let `B₁` be adically of finite type over
`(A₁, I₁)` and let `B₂` be its completed base change `(B₁ ⊗_{A₁} A₂)^∧_{I₂}`.  Choosing a
presentation of `B₁` by a family `g` of `r` generators,
`StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChange` produces the compatible presentation of
`B₂` in the same `r` variables, and
`StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChangeCotangent` deduces both assertions of
Stacks 0GAG from the single ideal inclusion

`J₂ ≤ β(J₁) · A₂[x]^∧`,   `β : A₁[x]^∧ → A₂[x]^∧` the base-change map,

which is Stacks' sentence "`J₂` is generated by the image of `J₁`".  That inclusion was the one
step still open, and `Rig.ker_le_map_ker_of_polynomial_level` had reduced it to a statement
about *polynomials*.  This file proves it.

The route is the one Stacks indicates — the identification
`A₂[x₁, …, x_r]^∧ = (A₁[x₁, …, x_r]^∧ ⊗_{A₁} A₂)^∧` — but it needs only the *map*
`Ψ : A₁[x]^∧ ⊗_{A₁} A₂ → A₂[x]^∧`, not the isomorphism.  Writing
`P₁ = A₁[x]^∧`, `P₂ = A₂[x]^∧`, `φ₁ : P₁ ↠ B₁` for the presentation, `S = B₁ ⊗_{A₁} A₂` and
`T = S^∧_{I₂ S}`, a polynomial `p ∈ A₂[x]` is the image under `Ψ` of a canonical element
`Θ p ∈ P₁ ⊗_{A₁} A₂`, and the square

```
P₁ ⊗_{A₁} A₂  --φ₁ ⊗ id-->  S  --of-->  T
      |                                 ≃
      Ψ                                 |
      v                                 |
     P₂  ------ x ↦ g ------>  B₂  ------
```

commutes.  So if `p` evaluates into `(I₂ B₂)ⁿ` then `(φ₁ ⊗ id)(Θ p)` lies in `(I₂ S)ⁿ` — this is
where the completion is removed, by `AdicCompletion.mem_pow_of_algebraMap_mem_map_pow` — whence
`Θ p ∈ J₁ · (P₁ ⊗_{A₁} A₂) + I₂ ^ n · (P₁ ⊗_{A₁} A₂)` by right exactness of the tensor product
(`Rig.mem_sup_of_tensorProduct_map_mem`), and pushing forward along `Ψ` gives
`p ∈ β(J₁) · P₂ + (I₂ P₂)ⁿ` as required.

With this, Stacks 0GAG and Stacks 0AK2 are complete for the canonical completed base change.

## Main results

* `AdicCompletion.mem_pow_of_algebraMap_mem_map_pow` — an element of a ring whose image in the
  `I`-adic completion lies in the `n`-th power of the extended ideal lies in `I ^ n`.
* `Rig.polynomialBaseChangeTensor` — the map `Ψ : A₁[x]^∧ ⊗_{A₁} A₂ → A₂[x]^∧`.
* `Rig.tensorPolynomialEval` — the element `Θ p` of `A₁[x]^∧ ⊗_{A₁} A₂` attached to a
  polynomial `p ∈ A₂[x]`, with `Rig.polynomialBaseChangeTensor_comp_tensorPolynomialEval` and
  `Rig.map_comp_tensorPolynomialEval` the two edges of the square above.
* `Rig.ker_le_map_ker_of_completedBaseChange` — **the remaining step of Stacks 0GAG**: for the
  canonical completed base change, `J₂` is generated by the image of `J₁`.

## References

* [Stacks Project, Tag 0GAG](https://stacks.math.columbia.edu/tag/0GAG)
* [Stacks Project, Tag 0AK2](https://stacks.math.columbia.edu/tag/0AK2)
* [Stacks Project, Tag 0AL5](https://stacks.math.columbia.edu/tag/0AL5)
-/

@[expose] public noncomputable section

universe u u₁ u₂ v w

namespace AdicCompletion

/-- **Powers of the adic ideal are detected in the completion.**  If `I` is a finitely generated
ideal of `R` and the image of `x : R` in the `I`-adic completion lies in the `n`-th power of the
extended ideal, then `x ∈ I ^ n`.

The kernel of the level-`n` evaluation `R^∧ → R / Iⁿ` is the `n`-th power of the extended ideal
(`AdicCompletion.pow_smul_top_eq_ker_eval`), and that evaluation sends the image of `x` to the
class of `x`. -/
public theorem mem_pow_of_algebraMap_mem_map_pow {R : Type u} [CommRing R] (I : Ideal R)
    (hI : I.FG) (n : ℕ) (x : R)
    (hx : algebraMap R (AdicCompletion I R) x ∈
      Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n)) :
    x ∈ I ^ n := by
  have hker : RingHom.ker (AdicCompletion.evalₐ I n).toRingHom =
      Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n) := by
    ext y
    rw [RingHom.mem_ker]
    have hs : I ^ n • (⊤ : Ideal R) = I ^ n := by simp
    have hsubeq : (I ^ n • (⊤ : Submodule R R)) = (I ^ n : Submodule R R) := by simp
    have hinj : Function.Injective (Submodule.factor (le_of_eq hsubeq)) := by
      change Function.Injective (Submodule.quotEquivOfEq _ _ hsubeq)
      exact (Submodule.quotEquivOfEq _ _ hsubeq).injective
    have he : (AdicCompletion.evalₐ I n) y = 0 ↔ (AdicCompletion.eval I R n) y = 0 := by
      rw [← AdicCompletion.factor_eval_eq_evalₐ I y (le_of_eq hs)]
      exact map_eq_zero_iff _ hinj
    change (AdicCompletion.evalₐ I n) y = 0 ↔ _
    rw [he, ← LinearMap.mem_ker, ← AdicCompletion.pow_smul_top_eq_ker_eval hI]
    have hsub : I ^ n • (⊤ : Submodule R (AdicCompletion I R)) =
        (Ideal.map (algebraMap R (AdicCompletion I R)) (I ^ n) :
          Ideal (AdicCompletion I R)).restrictScalars R := by
      simp
    rw [hsub]
    rfl
  have hmem : algebraMap R (AdicCompletion I R) x ∈
      RingHom.ker (AdicCompletion.evalₐ I n).toRingHom := by
    rw [hker]
    exact hx
  have hx0 : (AdicCompletion.evalₐ I n) (algebraMap R (AdicCompletion I R) x) = 0 :=
    RingHom.mem_ker.mp hmem
  rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply,
    AdicCompletion.evalₐ_of] at hx0
  exact Ideal.Quotient.eq_zero_iff_mem.mp hx0

end AdicCompletion

namespace Rig

open AdicFiniteTypeAlgebra CompletedPolynomialPresentation

section Variables

variable {A : Type u} [CommRing A]

/-- The `i`-th variable of the completed polynomial algebra `A[x₁, …, x_r]^∧`. -/
public abbrev completedX (I : Ideal A) (r : ℕ) (i : Fin r) : completedPolynomialAlgebra I r :=
  algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) (MvPolynomial.X i)

/-- A constant polynomial has the same image in the completion as the constant itself. -/
public theorem algebraMap_completedPolynomialAlgebra_C (I : Ideal A) (r : ℕ) (a : A) :
    algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) (MvPolynomial.C a) =
      algebraMap A (completedPolynomialAlgebra I r) a := by
  rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
    Algebra.algebraMap_self_apply]
  simp

end Variables

section Tensor

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}

/-- The inclusion of the left factor `A₁[x₁, …, x_r]^∧ → A₁[x₁, …, x_r]^∧ ⊗_{A₁} A₂`. -/
public abbrev polynomialTensorLeft (A₂ : Type u₂) [CommRing A₂] [Algebra A₁ A₂]
    (I₁ : Ideal A₁) (r : ℕ) :
    completedPolynomialAlgebra I₁ r →ₐ[A₁]
      TensorProduct A₁ (completedPolynomialAlgebra I₁ r) A₂ :=
  Algebra.TensorProduct.includeLeft

/-- The inclusion of the right factor `A₂ → A₁[x₁, …, x_r]^∧ ⊗_{A₁} A₂`. -/
public abbrev polynomialTensorRight (A₂ : Type u₂) [CommRing A₂] [Algebra A₁ A₂]
    (I₁ : Ideal A₁) (r : ℕ) :
    A₂ →ₐ[A₁] TensorProduct A₁ (completedPolynomialAlgebra I₁ r) A₂ :=
  Algebra.TensorProduct.includeRight

/-- **The map of the limit computation of Stacks 0GAG**:
`Ψ : A₁[x₁, …, x_r]^∧ ⊗_{A₁} A₂ → A₂[x₁, …, x_r]^∧`, built from the base-change map of completed
polynomial algebras on the left factor and the structural map of `A₂` on the right. -/
public def polynomialBaseChangeTensor (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) :
    TensorProduct A₁ (completedPolynomialAlgebra I₁ r) A₂ →ₐ[A₁]
      completedPolynomialAlgebra I₂ r :=
  Algebra.TensorProduct.productMap (polynomialBaseChange hmap r)
    (IsScalarTower.toAlgHom A₁ A₂ (completedPolynomialAlgebra I₂ r))

/-- On the left factor, `Rig.polynomialBaseChangeTensor` is the base-change map of completed
polynomial algebras. -/
public theorem polynomialBaseChangeTensor_includeLeft
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ)
    (x : completedPolynomialAlgebra I₁ r) :
    polynomialBaseChangeTensor hmap r (polynomialTensorLeft A₂ I₁ r x) =
      polynomialBaseChange hmap r x :=
  DFunLike.congr_fun
    (Algebra.TensorProduct.productMap_left (polynomialBaseChange hmap r)
      (IsScalarTower.toAlgHom A₁ A₂ (completedPolynomialAlgebra I₂ r))) x

/-- On the right factor, `Rig.polynomialBaseChangeTensor` is the structural map of `A₂`. -/
public theorem polynomialBaseChangeTensor_includeRight
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) (a : A₂) :
    polynomialBaseChangeTensor hmap r (polynomialTensorRight A₂ I₁ r a) =
      algebraMap A₂ (completedPolynomialAlgebra I₂ r) a :=
  DFunLike.congr_fun
    (Algebra.TensorProduct.productMap_right (polynomialBaseChange hmap r)
      (IsScalarTower.toAlgHom A₁ A₂ (completedPolynomialAlgebra I₂ r))) a

/-- **The canonical lift of a polynomial of `A₂[x₁, …, x_r]` to `A₁[x₁, …, x_r]^∧ ⊗_{A₁} A₂`**,
sending a coefficient to the right factor and a variable to the corresponding variable of the
left factor.  It exists because `A₂[x] = A₁[x] ⊗_{A₁} A₂`, which is the finite-level identity
Stacks' proof of 0GAG uses. -/
public def tensorPolynomialEval (A₂ : Type u₂) [CommRing A₂] [Algebra A₁ A₂] (I₁ : Ideal A₁)
    (r : ℕ) :
    MvPolynomial (Fin r) A₂ →+* TensorProduct A₁ (completedPolynomialAlgebra I₁ r) A₂ :=
  MvPolynomial.eval₂Hom (polynomialTensorRight A₂ I₁ r).toRingHom
    fun i ↦ polynomialTensorLeft A₂ I₁ r (completedX I₁ r i)

/-- The canonical lift sends a constant to the right factor. -/
@[simp] public theorem tensorPolynomialEval_C (I₁ : Ideal A₁) (r : ℕ) (a : A₂) :
    tensorPolynomialEval A₂ I₁ r (MvPolynomial.C a) = polynomialTensorRight A₂ I₁ r a := by
  rw [tensorPolynomialEval]
  exact MvPolynomial.eval₂Hom_C _ _ a

/-- The canonical lift sends a variable to the corresponding variable of the left factor. -/
@[simp] public theorem tensorPolynomialEval_X (I₁ : Ideal A₁) (r : ℕ) (i : Fin r) :
    tensorPolynomialEval A₂ I₁ r (MvPolynomial.X i) =
      polynomialTensorLeft A₂ I₁ r (completedX I₁ r i) := by
  rw [tensorPolynomialEval]
  exact MvPolynomial.eval₂Hom_X' _ _ i

/-- **The lower edge of the square of Stacks 0GAG.**  Composing the canonical lift with
`Rig.polynomialBaseChangeTensor` recovers the canonical map of `A₂[x₁, …, x_r]` into its own
completion: both sides are ring maps agreeing on constants and on variables. -/
public theorem polynomialBaseChangeTensor_comp_tensorPolynomialEval
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) :
    (polynomialBaseChangeTensor hmap r).toRingHom.comp (tensorPolynomialEval A₂ I₁ r) =
      algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) := by
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) fun i ↦ ?_ <;>
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      tensorPolynomialEval_C, tensorPolynomialEval_X]
  · rw [polynomialBaseChangeTensor_includeRight,
      algebraMap_completedPolynomialAlgebra_C I₂ r a]
  · rw [polynomialBaseChangeTensor_includeLeft, completedX,
      polynomialBaseChange_algebraMap, MvPolynomial.map_X]

end Tensor

section CompletedBaseChange

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁}

/-- The inclusion `B₁ → B₁ ⊗_{A₁} A₂` of the left factor of the uncompleted base change. -/
public abbrev baseChangedLeft (A₂ : Type u₂) [CommRing A₂] [Algebra A₁ A₂]
    (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    B₁.carrier →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) B₁ :=
  Algebra.TensorProduct.includeLeft

/-- The inclusion `A₂ → B₁ ⊗_{A₁} A₂` of the right factor of the uncompleted base change. -/
public abbrev baseChangedRight (A₂ : Type u₂) [CommRing A₂] [Algebra A₁ A₂]
    (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    A₂ →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) B₁ :=
  Algebra.TensorProduct.includeRight

/-- **The upper edge of the square of Stacks 0GAG.**  Base-changing the presenting surjection
`φ₁ : A₁[x₁, …, x_r]^∧ → B₁` and precomposing with the canonical lift of a polynomial of
`A₂[x₁, …, x_r]` is substitution of the images of the generators in `B₁ ⊗_{A₁} A₂`. -/
public theorem map_comp_tensorPolynomialEval (r : ℕ) (g : Fin r → B₁.carrier) :
    (Algebra.TensorProduct.map (completedAeval B₁ r g)
          (AlgHom.id A₁ A₂)).toRingHom.comp (tensorPolynomialEval A₂ I₁ r) =
      MvPolynomial.eval₂Hom (baseChangedRight A₂ B₁).toRingHom
        fun i ↦ baseChangedLeft A₂ B₁ (g i) := by
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) fun i ↦ ?_ <;>
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      tensorPolynomialEval_C, MvPolynomial.eval₂Hom_C, tensorPolynomialEval_X,
      MvPolynomial.eval₂Hom_X']
  · exact DFunLike.congr_fun
      (Algebra.TensorProduct.map_comp_includeRight (completedAeval B₁ r g)
        (AlgHom.id A₁ A₂)) a
  · rw [show Algebra.TensorProduct.map (completedAeval B₁ r g) (AlgHom.id A₁ A₂)
          (polynomialTensorLeft A₂ I₁ r (completedX I₁ r i)) =
        (Algebra.TensorProduct.map (completedAeval B₁ r g)
          (AlgHom.id A₁ A₂)).comp (polynomialTensorLeft A₂ I₁ r) (completedX I₁ r i) from rfl,
      Algebra.TensorProduct.map_comp_includeLeft]
    simp only [AlgHom.comp_apply, completedX, completedAeval_algebraMap, MvPolynomial.aeval_X]

variable {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂} [Algebra B₁.carrier B₂.carrier]

/-- **The remaining step of Stacks 0GAG, for the canonical completed base change.**  Let `B₂` be
ring-isomorphic to `(B₁ ⊗_{A₁} A₂)^∧_{I₂}` compatibly with the maps from `A₂` and from `B₁` —
the case of `Rig.completedBaseChange` — and let `g` present `B₁` on `r` variables.  Then the
kernel `J₂` of the compatible presentation of `B₂` is generated by the image of `J₁` under the
base-change map `β` of completed polynomial algebras.

This is Stacks' sentence "`J₂` is generated by the image of `J₁`", whose proof is the limit
computation `A₂[x]^∧ = (A₁[x]^∧ ⊗_{A₁} A₂)^∧`.  Its two inputs are
`Rig.mem_sup_of_tensorProduct_map_mem`, which is right exactness of the tensor product, and
`AdicCompletion.mem_pow_of_algebraMap_mem_map_pow`, which removes the completion. -/
public theorem ker_le_map_ker_of_completedBaseChange [IsNoetherianRing A₂] (hI₂ : I₂.FG)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) (g : Fin r → B₁.carrier)
    (hsurj : Function.Surjective (completedAeval B₁ r g))
    (e : B₂.carrier ≃+* completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)
    (heA : ∀ a : A₂, e (algebraMap A₂ B₂.carrier a) =
      algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
        (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) (baseChangedRight A₂ B₁ a))
    (heB : ∀ b : B₁.carrier, e (algebraMap B₁.carrier B₂.carrier b) =
      algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
        (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) (baseChangedLeft A₂ B₁ b)) :
    RingHom.ker
        (completedAeval B₂ r (fun i ↦ algebraMap B₁.carrier B₂.carrier (g i))).toRingHom ≤
      Ideal.map (polynomialBaseChange hmap r).toRingHom
        (RingHom.ker (completedAeval B₁ r g).toRingHom) := by
  refine ker_le_map_ker_of_polynomial_level hI₂ hmap r g fun n p hp ↦ ?_
  -- `Θ p`, the canonical lift of `p` to `A₁[x]^∧ ⊗_{A₁} A₂`
  set v : TensorProduct A₁ (completedPolynomialAlgebra I₁ r) A₂ :=
    tensorPolynomialEval A₂ I₁ r p with hv
  -- the image of `Θ p` in `B₁ ⊗_{A₁} A₂`
  set u : baseChangedAlgebra (A₂ := A₂) B₁ :=
    Algebra.TensorProduct.map (completedAeval B₁ r g) (AlgHom.id A₁ A₂) v with hu
  -- the hypothesis, transported to `(B₁ ⊗_{A₁} A₂)^∧` and then down to `B₁ ⊗_{A₁} A₂`
  have hpu : u ∈ Ideal.map (baseChangedRight A₂ B₁) (I₂ ^ n) := by
    have hadic : Ideal.map (e : B₂.carrier →+* _) B₂.adicIdeal =
        Ideal.map (algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
            (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁))
          (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁) := by
      change Ideal.map (e : B₂.carrier →+* _) (Ideal.map (algebraMap A₂ B₂.carrier) I₂) =
        Ideal.map (algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
            (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁))
          (Ideal.map (baseChangedRight A₂ B₁).toRingHom I₂)
      rw [Ideal.map_map, Ideal.map_map]
      exact congrArg (Ideal.map · I₂) (RingHom.ext heA)
    have himg : e (completedAeval B₂ r (fun i ↦ algebraMap B₁.carrier B₂.carrier (g i))
          (algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) p)) =
        algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
          (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) u := by
      rw [completedAeval_algebraMap, hu, hv,
        show Algebra.TensorProduct.map (completedAeval B₁ r g) (AlgHom.id A₁ A₂)
            (tensorPolynomialEval A₂ I₁ r p) =
          (Algebra.TensorProduct.map (completedAeval B₁ r g)
            (AlgHom.id A₁ A₂)).toRingHom.comp (tensorPolynomialEval A₂ I₁ r) p from rfl,
        map_comp_tensorPolynomialEval r g]
      have hring : (e : B₂.carrier →+* completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁).comp
          (MvPolynomial.aeval (fun i ↦ algebraMap B₁.carrier B₂.carrier (g i)) :
            MvPolynomial (Fin r) A₂ →ₐ[A₂] B₂.carrier).toRingHom =
          (algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
              (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)).comp
            (MvPolynomial.eval₂Hom (baseChangedRight A₂ B₁).toRingHom
              fun i ↦ baseChangedLeft A₂ B₁ (g i)) := by
        refine MvPolynomial.ringHom_ext (fun a ↦ ?_) fun i ↦ ?_ <;>
          simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
            RingHom.coe_coe, MvPolynomial.eval₂Hom_C, MvPolynomial.aeval_C,
            MvPolynomial.eval₂Hom_X', MvPolynomial.aeval_X]
        exacts [heA a, heB (g i)]
      exact DFunLike.congr_fun hring p
    have hT : algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
        (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) u ∈
        Ideal.map (algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
          (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁))
          ((baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁) ^ n) := by
      rw [Ideal.map_pow, ← hadic, ← Ideal.map_pow, ← himg]
      exact Ideal.mem_map_of_mem _ hp
    have hS : u ∈ (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁) ^ n :=
      AdicCompletion.mem_pow_of_algebraMap_mem_map_pow _
        (baseChangedIdeal_fg B₁ hI₂) n u hT
    rwa [baseChangedIdeal, ← Ideal.map_pow] at hS
  -- right exactness of the tensor product
  have hvmem := mem_sup_of_tensorProduct_map_mem (completedAeval B₁ r g) hsurj (I₂ ^ n) v hpu
  -- push forward along `Ψ`
  have hle : Ideal.map (polynomialBaseChangeTensor hmap r).toRingHom
      (Ideal.map (polynomialTensorLeft A₂ I₁ r)
          (RingHom.ker (completedAeval B₁ r g).toRingHom) ⊔
        Ideal.map (polynomialTensorRight A₂ I₁ r) (I₂ ^ n)) ≤
      Ideal.map (polynomialBaseChange hmap r).toRingHom
          (RingHom.ker (completedAeval B₁ r g).toRingHom) ⊔
        Ideal.map (algebraMap A₂ (completedPolynomialAlgebra I₂ r)) I₂ ^ n := by
    rw [Ideal.map_sup]
    refine sup_le ?_ ?_
    · refine Ideal.map_le_iff_le_comap.mpr (Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_)
