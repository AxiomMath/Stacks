/-!
# The kernel of a completed polynomial presentation is detected on polynomials

The one step of Stacks 0GAG left open by
`StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChangeCotangent` is the ideal inclusion
`J₂ ≤ β(J₁) · A₂[x]^∧`, where `β : A₁[x]^∧ → A₂[x]^∧` is the base-change map of completed
polynomial algebras — Stacks' sentence "`J₂` is generated by the image of `J₁`".

This file removes the completion from that statement.  Over a Noetherian base the completed
polynomial algebra `P = A[x₁, …, x_r]^∧` is Noetherian (Stacks 0316 through Stacks 0AJQ) and
`I P`-adically complete, so `I P` lies in its Jacobson radical and every ideal of `P` is closed
for the `I P`-adic topology: an element of `P` lying in `K + (I P)ⁿ` for every `n` lies in `K`
(Krull's intersection theorem, `submodule_iInf_sup_pow_smul_le`).  Since the polynomials are
dense in `P` (`AdicCompletion.exists_sub_mem_map_pow`), it follows that

> to prove `ker φ ≤ K` for a ring map `φ` out of `P` carrying `I P` into an ideal `D` of the
> target, it suffices to prove, for every `n` and every **polynomial** `p`, that
> `φ(p) ∈ Dⁿ` implies `p ∈ K + (I P)ⁿ`.

Applied to the presentation of the base change this is exactly the finite-level computation
Stacks performs, `A₂/I₂ⁿ[x] = A₁/I₁^{cn}[x] ⊗_{A₁/I₁^{cn}} A₂/I₂ⁿ`, and nothing else is left of
0GAG.

## Main results

* `Ideal.le_of_le_sup_pow` — ideals of a Noetherian adically complete ring are closed.
* `Rig.ker_le_of_polynomial_level` — the reduction of `ker φ ≤ K` to polynomials.
* `Rig.mem_sup_of_tensorProduct_map_mem` — the tensor step: base change of a surjection has
  kernel generated by the original kernel, so an element whose image lies in the ideal
  generated by `M` lies in the ideal generated by `J₁` together with that of `M`.
* `Rig.ker_le_map_ker_of_polynomial_level` — that reduction applied to the compatible
  presentations of Stacks 0GAG, producing the hypothesis `hker` of
  `Rig.smul_id_baseChange_of_ker_le` from a statement about polynomials only.
* `Rig.smul_id_baseChange_of_polynomial_level` — **Stacks 0AK2** conditional on that one
  finite-level statement about polynomials, and nothing else.

## References

* [Stacks Project, Tag 0GAG](https://stacks.math.columbia.edu/tag/0GAG)
* [Stacks Project, Tag 0AJQ](https://stacks.math.columbia.edu/tag/0AJQ)
* [Stacks Project, Tag 0316](https://stacks.math.columbia.edu/tag/0316)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

/-- **Ideals of a Noetherian adically complete ring are closed.**  If `R` is Noetherian and
`L`-adically complete and `J ≤ K ⊔ Lⁿ` for every `n`, then `J ≤ K`.

`L` lies in the Jacobson radical of `R` by completeness, so Krull's intersection theorem
applies to the finite `R`-module `R ⧸ K`. -/
@[sga "3 VIIB 5.5.2" "partial"]
public theorem Ideal.le_of_le_sup_pow {R : Type*} [CommRing R] [IsNoetherianRing R]
    (L : Ideal R) [IsAdicComplete L R] {K J : Ideal R} (h : ∀ n : ℕ, J ≤ K ⊔ L ^ n) :
    J ≤ K := by
  refine le_trans (le_iInf fun n => ?_)
    (submodule_iInf_sup_pow_smul_le L (IsAdicComplete.le_jacobson_bot L) (K : Submodule R R))
  have hpow : L ^ n • (⊤ : Submodule R R) = (L ^ n : Ideal R) := by
    rw [← Ideal.one_eq_top, Ideal.smul_eq_mul, mul_one]
  rw [hpow]
  exact h n

namespace Rig

universe u u₁ u₂ v w

open AdicFiniteTypeAlgebra CompletedPolynomialPresentation

attribute [local instance] HasDerivedCategory.standard

section Polynomial

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

/-- **The kernel of a map out of a completed polynomial algebra is detected on polynomials.**
Let `P = A[x₁, …, x_r]^∧` with `A` Noetherian, let `K` be an ideal of `P` and let
`φ : P → C` be a ring map carrying the ideal `L = I P` into an ideal `D` of `C`.  If for every
`n` and every polynomial `p` the condition `φ(p) ∈ Dⁿ` forces `p ∈ K ⊔ Lⁿ`, then
`ker φ ≤ K`.

The polynomials are dense in `P`, so an element of `ker φ` is a polynomial up to `Lⁿ`; and `K`
is closed, so the resulting membership in `K ⊔ Lⁿ` for all `n` gives membership in `K`. -/
public theorem ker_le_of_polynomial_level (I : Ideal A) (hI : I.FG) (r : ℕ)
    {C : Type*} [CommRing C] (φ : completedPolynomialAlgebra I r →+* C) (D : Ideal C)
    (K : Ideal (completedPolynomialAlgebra I r))
    (hmapD : ((I.map (algebraMap A (completedPolynomialAlgebra I r)))).map φ ≤ D)
    (hlevel : ∀ (n : ℕ) (p : MvPolynomial (Fin r) A),
      φ (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) ∈ D ^ n →
        algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p ∈
          K ⊔ (I.map (algebraMap A (completedPolynomialAlgebra I r))) ^ n) :
    RingHom.ker φ ≤ K := by
  have hJfg : (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)).FG := hI.map _
  -- the adic ideal of the completion, written both through `A` and through the polynomials
  have hLeq : I.map (algebraMap A (completedPolynomialAlgebra I r)) =
      (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)).map
        (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r)) := by
    have hcomp : (algebraMap (MvPolynomial (Fin r) A)
          (completedPolynomialAlgebra I r)).comp
          (MvPolynomial.C : A →+* MvPolynomial (Fin r) A) =
        algebraMap A (completedPolynomialAlgebra I r) := by
      ext a
      simp [AdicCompletion.algebraMap_apply]
    rw [Ideal.map_map, hcomp]
  have hcomplete : IsAdicComplete (I.map (algebraMap A (completedPolynomialAlgebra I r)))
      (completedPolynomialAlgebra I r) := by
    rw [hLeq]
    exact (IsAdicComplete.map_algebraMap_iff (R := MvPolynomial (Fin r) A)
      (S := completedPolynomialAlgebra I r) (M := completedPolynomialAlgebra I r)
      (I := I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A))).mpr
      (AdicCompletion.isAdicComplete hJfg)
  refine Ideal.le_of_le_sup_pow (I.map (algebraMap A (completedPolynomialAlgebra I r)))
    fun n y hy => ?_
  obtain ⟨p, hp⟩ := AdicCompletion.exists_sub_mem_map_pow
    (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) hJfg n y
  rw [Ideal.map_pow, ← hLeq] at hp
  have hφL : ((I.map (algebraMap A (completedPolynomialAlgebra I r))) ^ n).map φ ≤ D ^ n := by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono hmapD n
  have hφp : φ (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) ∈
      D ^ n := by
    have hsub : φ (y -
        algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) ∈ D ^ n :=
      hφL (Ideal.mem_map_of_mem φ hp)
    have hy0 : φ y = 0 := hy
    rw [map_sub, hy0, zero_sub] at hsub
    simpa using (D ^ n).neg_mem hsub
  rw [show y = algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p +
    (y - algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) by ring]
  exact Submodule.add_mem _ (hlevel n p hφp) (Submodule.mem_sup_right hp)

end Polynomial

section TensorLevel

/-- **The tensor step of Stacks 0GAG.**  Let `φ₁ : P₁ → B₁` be a surjective `A₁`-algebra map
with kernel `J₁` and base change it to `ψ = φ₁ ⊗ id : P₁ ⊗_{A₁} A₂ → B₁ ⊗_{A₁} A₂`.  If `ψ v`
lies in the ideal of `B₁ ⊗_{A₁} A₂` generated by an ideal `M` of `A₂`, then `v` lies in the
ideal generated by `J₁` joined with the ideal generated by `M`.

`ψ` is surjective with kernel generated by the image of `J₁` — that is right exactness of the
tensor product, `Algebra.TensorProduct.rTensor_ker` — and the preimage under a surjection of
the image of an ideal is that ideal joined with the kernel.

This is the only place in Stacks' proof of 0GAG where the *tensor product* is used: fed the
identification `A₂[x₁, …, x_r]^∧ = (A₁[x₁, …, x_r]^∧ ⊗_{A₁} A₂)^∧` and `M = I₂ ^ n`, it is the
statement that a polynomial whose value lies in `(I₂ B₂)ⁿ` already lies in
`J₁ · A₂[x]^∧ + (I₂ A₂[x]^∧)ⁿ`. -/
public theorem mem_sup_of_tensorProduct_map_mem
    {A₁ : Type*} [CommRing A₁] {A₂ : Type*} [CommRing A₂] [Algebra A₁ A₂]
    {P₁ : Type*} [CommRing P₁] [Algebra A₁ P₁] {Bb : Type*} [CommRing Bb] [Algebra A₁ Bb]
    (φ₁ : P₁ →ₐ[A₁] Bb) (hφ₁ : Function.Surjective φ₁) (M : Ideal A₂)
    (v : TensorProduct A₁ P₁ A₂)
    (hv : Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂) v ∈
      Ideal.map (Algebra.TensorProduct.includeRight :
        A₂ →ₐ[A₁] TensorProduct A₁ Bb A₂) M) :
    v ∈ Ideal.map (Algebra.TensorProduct.includeLeft :
          P₁ →ₐ[A₁] TensorProduct A₁ P₁ A₂) (RingHom.ker φ₁.toRingHom) ⊔
        Ideal.map (Algebra.TensorProduct.includeRight :
          A₂ →ₐ[A₁] TensorProduct A₁ P₁ A₂) M := by
  have hψ : Function.Surjective (Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂)) :=
    Algebra.TensorProduct.map_surjective φ₁ (AlgHom.id A₁ A₂) hφ₁ Function.surjective_id
  have hker : RingHom.ker (Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂)) =
      Ideal.map (Algebra.TensorProduct.includeLeft :
        P₁ →ₐ[A₁] TensorProduct A₁ P₁ A₂) (RingHom.ker φ₁) :=
    Algebra.TensorProduct.rTensor_ker φ₁ hφ₁
  have hXle : Ideal.map (Algebra.TensorProduct.includeRight :
        A₂ →ₐ[A₁] TensorProduct A₁ Bb A₂) M ≤
      Ideal.map (Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂))
        (Ideal.map (Algebra.TensorProduct.includeRight :
          A₂ →ₐ[A₁] TensorProduct A₁ P₁ A₂) M) := by
    refine Ideal.map_le_iff_le_comap.mpr fun a ha => ?_
    rw [Ideal.mem_comap]
    have hcongr := congrArg (fun F : A₂ →ₐ[A₁] TensorProduct A₁ Bb A₂ => F a)
      (Algebra.TensorProduct.map_comp_includeRight φ₁ (AlgHom.id A₁ A₂))
    simp only [AlgHom.comp_apply, AlgHom.id_apply] at hcongr
    rw [← hcongr]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha)
  have hmem : v ∈ Ideal.comap (Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂))
      (Ideal.map (Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂))
        (Ideal.map (Algebra.TensorProduct.includeRight :
          A₂ →ₐ[A₁] TensorProduct A₁ P₁ A₂) M)) := Ideal.mem_comap.mpr (hXle hv)
  rw [Ideal.comap_map_of_surjective _ hψ, ← RingHom.ker_eq_comap_bot] at hmem
  have hle : Ideal.map (Algebra.TensorProduct.includeRight :
        A₂ →ₐ[A₁] TensorProduct A₁ P₁ A₂) M ⊔
      RingHom.ker (Algebra.TensorProduct.map φ₁ (AlgHom.id A₁ A₂)) ≤
      Ideal.map (Algebra.TensorProduct.includeLeft :
          P₁ →ₐ[A₁] TensorProduct A₁ P₁ A₂) (RingHom.ker φ₁.toRingHom) ⊔
        Ideal.map (Algebra.TensorProduct.includeRight :
          A₂ →ₐ[A₁] TensorProduct A₁ P₁ A₂) M := by
    refine sup_le le_sup_right ?_
    rw [hker]
    exact le_sup_left
  exact hle hmem

end TensorLevel

section BaseChange

variable {A₁ : Type u₁} [CommRing A₁]
  {A₂ : Type u₂} [CommRing A₂] [IsNoetherianRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier]
  (hI₂ : I₂.FG) (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
  (r : ℕ) (g : Fin r → B₁.carrier)

include hI₂ in
/-- **The remaining step of Stacks 0GAG, reduced to polynomials.**  To know that `J₂` is
generated by the image of `J₁` — the hypothesis `hker` of
`Rig.smul_id_baseChange_of_ker_le` — it suffices to know, for every `n` and every
*polynomial* `p ∈ A₂[x₁, …, x_r]`, that if the value of `p` at the images of the generators
lies in `(I₂ B₂)ⁿ` then `p` already lies in `β(J₁) · A₂[x]^∧ + (I₂ A₂[x]^∧)ⁿ`.

That finite-level statement is the limit computation Stacks performs, and it is the only thing
still missing from 0GAG and hence from Stacks 0AK2. -/
public theorem ker_le_map_ker_of_polynomial_level
    (hlevel : ∀ (n : ℕ) (p : MvPolynomial (Fin r) A₂),
      completedAeval B₂ r (fun i => algebraMap B₁.carrier B₂.carrier (g i))
          (algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) p) ∈
            B₂.adicIdeal ^ n →
        algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) p ∈
          Ideal.map (polynomialBaseChange hmap r).toRingHom
              (RingHom.ker (completedAeval B₁ r g).toRingHom) ⊔
            (I₂.map (algebraMap A₂ (completedPolynomialAlgebra I₂ r))) ^ n) :
    RingHom.ker
        (completedAeval B₂ r (fun i => algebraMap B₁.carrier B₂.carrier (g i))).toRingHom ≤
      Ideal.map (polynomialBaseChange hmap r).toRingHom
        (RingHom.ker (completedAeval B₁ r g).toRingHom) :=
  ker_le_of_polynomial_level I₂ hI₂ r
    (completedAeval B₂ r (fun i => algebraMap B₁.carrier B₂.carrier (g i))).toRingHom
    B₂.adicIdeal _
    (by
      rw [Ideal.map_map]
      have hcomm : (completedAeval B₂ r
            (fun i => algebraMap B₁.carrier B₂.carrier (g i))).toRingHom.comp
            (algebraMap A₂ (completedPolynomialAlgebra I₂ r)) =
          algebraMap A₂ B₂.carrier :=
        RingHom.ext fun a =>
          (completedAeval B₂ r (fun i => algebraMap B₁.carrier B₂.carrier (g i))).commutes a
      rw [hcomm])
    hlevel

end BaseChange

section Square

/-- The kernel of the extension of a presentation is the kernel of any equal presenting map. -/
private theorem ker_extension_eq_ker_of_toAlgHom_eq {A : Type u} [CommRing A] {I : Ideal A}
    {B : AdicFiniteTypeAlgebra.{u, v} A I} (P : CompletedPolynomialPresentation I B)
    (f : completedPolynomialAlgebra I P.variableCount →ₐ[A] B.carrier) (h : P.toAlgHom = f) :
    P.extension.ker = RingHom.ker f.toRingHom := by
  subst h
  rfl

variable {A₁ : Type u₁} [CommRing A₁] [IsNoetherianRing A₁]
  {A₂ : Type u₂} [CommRing A₂] [IsNoetherianRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]
  (hI₁ : I₁.FG) (hI₂ : I₂.FG) (hc : 0 < c)
  (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
  (hspan : (⊤ : Submodule A₂ B₂.carrier) ≤
    Submodule.span A₂ (Set.range (algebraMap B₁.carrier B₂.carrier)) ⊔
      Submodule.restrictScalars A₂ B₂.adicIdeal)
  (r : ℕ) (g : Fin r → B₁.carrier)
  (hgen : Function.Surjective (MvPolynomial.aeval
    (fun i ↦ Ideal.Quotient.mk B₁.adicIdeal (g i)) :
      MvPolynomial (Fin r) (A₁ ⧸ I₁) →ₐ[A₁ ⧸ I₁] B₁.reduction))

omit [IsNoetherianRing A₁] in
/-- The kernel of a presentation built from a generating family is the kernel of
`Rig.completedAeval`. -/
public theorem ker_extension_ofGenerators :
    (CompletedPolynomialPresentation.ofGenerators B₁ r g hI₁ hgen).extension.ker =
      RingHom.ker (completedAeval B₁ r g).toRingHom :=
  ker_extension_eq_ker_of_toAlgHom_eq _ _ (ofGenerators_toAlgHom B₁ r g hI₁ hgen)

omit [IsNoetherianRing A₁] [IsNoetherianRing A₂] in
/-- The kernel of the compatible presentation of the base change is the kernel of
`Rig.completedAeval` at the images of the generators. -/
public theorem ker_extension_baseChangePresentation :
    (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker =
      RingHom.ker (completedAeval B₂ r
        (fun i => algebraMap B₁.carrier B₂.carrier (g i))).toRingHom :=
  ker_extension_eq_ker_of_toAlgHom_eq _ _
    (baseChangePresentation_toAlgHom hI₂ hc hmap hspan r g hgen)

/-- **Stacks 0AK2, reduced to a finite-level statement about polynomials.**  Combining
`Rig.smul_id_baseChange_of_ker_le` with `Rig.ker_le_map_ker_of_polynomial_level`: the
conclusion of Stacks 0AK2 for the compatible presentations follows from the single hypothesis
that, for every `n` and every polynomial `p ∈ A₂[x₁, …, x_r]`, `p` evaluating into `(I₂ B₂)ⁿ`
forces `p ∈ β(J₁) · A₂[x]^∧ + (I₂ A₂[x]^∧)ⁿ`.

No completion appears in the hypothesis: it is exactly the limit computation
`A₂/I₂ⁿ[x] = A₁/I₁^{cn}[x] ⊗_{A₁/I₁^{cn}} A₂/I₂ⁿ` of the source's proof of Stacks 0GAG. -/
public theorem smul_id_baseChange_of_polynomial_level
    (hlevel : ∀ (n : ℕ) (p : MvPolynomial (Fin r) A₂),
      completedAeval B₂ r (fun i => algebraMap B₁.carrier B₂.carrier (g i))
          (algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) p) ∈
            B₂.adicIdeal ^ n →
        algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) p ∈
          Ideal.map (polynomialBaseChange hmap r).toRingHom
              (RingHom.ker (completedAeval B₁ r g).toRingHom) ⊔
            (I₂.map (algebraMap A₂ (completedPolynomialAlgebra I₂ r))) ^ n)
    (f₁ : B₁.carrier)
    (h : f₁ • 𝟙 (derivedCompletedNaiveCotangentComplex B₁
      (CompletedPolynomialPresentation.ofGenerators B₁ r g hI₁ hgen)) = 0) :
    algebraMap B₁.carrier B₂.carrier f₁ •
      𝟙 (derivedCompletedNaiveCotangentComplex B₂
        (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)) = 0 := by
  refine smul_id_baseChange_of_ker_le hI₁ hI₂ hc hmap hspan r g hgen ?_ f₁ h
  rw [ker_extension_baseChangePresentation hI₂ hc hmap hspan r g hgen,
    ker_extension_ofGenerators hI₁ r g hgen]
  exact ker_le_map_ker_of_polynomial_level hI₂ hmap r g hlevel

end Square

end Rig

