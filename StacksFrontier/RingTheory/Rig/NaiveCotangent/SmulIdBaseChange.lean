module

public import StacksFrontier.Homology.TwoTermComplex.SmulIdZero
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.ExtAnnihilation
public import StacksFrontier.RingTheory.Rig.RigSmooth

/-!
# A scalar acting by zero on the completed naive cotangent complex

Let `A` be a Noetherian ring, `I` an ideal of `A`, and `B` an `I`-adically complete `A`-algebra
of finite type modulo `I`.  Rig-étaleness (Stacks 0GAY) asks that a power of `I` act by zero on
the completed naive cotangent complex `NL^∧_{B/A}` *in the derived category* `D(B)` — a
condition strictly stronger than the rig-smoothness condition on `Ext¹`, and one which, taken
at face value, does not transport along a ring map.

This file reads that condition against a completed polynomial presentation
`B = A[x₁, …, xᵣ]^∧ / J`, where `NL^∧_{B/A}` is the two-term complex `(J/J² → ⨁ i, B dxᵢ)` with
free degree-zero term.  By `TwoTermComplex.smul_id_Q_obj_eq_zero_iff_exists_factorization` the
condition is then the existence of a single `B`-linear map `s : ⨁ i, B dxᵢ → J/J²` with

`d ≫ s = f • 𝟙 (J/J²)`  and  `s ≫ d = f • 𝟙 (⨁ i, B dxᵢ)`,

i.e. a null-homotopy of `f • 𝟙`.  Being concrete module data, `s` transports; and the
sufficiency half of the criterion needs no projectivity, so the transported `s` proves the
transported statement.  That is what reduces **Stacks 0AK2** to the module-level comparison of
**Stacks 0GAG**.

## Main results

* `Rig.exists_factorization_of_smul_id_eq_zero` and `Rig.smul_id_eq_zero_of_factorization`: the
  two halves of the criterion at the completed naive cotangent complex.
* `Rig.smul_id_congr_presentation`: the condition does not depend on the presentation, by
  **Stacks 0GAE**.
* `Rig.smul_id_of_baseChange_of_factorization`: **the reduction of Stacks 0AK2 to Stacks 0GAG.**

## Implementation notes

The reduction lemma takes as its hypothesis the transport of a null-homotopy over `B₁` to one
over `B₂`, in the shape the comparison map produces. That transport is what the surjectivity of
the comparison map `J₁/J₁² ⊗_{B₁} B₂ → J₂/J₂²` of Stacks 0GAG supplies — equivalently, that
`J₂` is generated by the image of `J₁`. The comparison square of Stacks 0GAG is in
`StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChange`
(`Rig.baseChangeCotangentMap`, `Rig.baseChange_differential`).

This mirrors `Rig.smul_ext_one_of_baseChange_of_factorization`, which performs the same
reduction for the `Ext¹` condition of Stacks 0GAL; the difference is that the derived condition
needs both halves of the homotopy relation rather than the one factorization.

## References

* [Stacks Project, Tag 0AK2](https://stacks.math.columbia.edu/tag/0AK2)
* [Stacks Project, Tag 0GAG](https://stacks.math.columbia.edu/tag/0GAG)
* [Stacks Project, Tag 0GAE](https://stacks.math.columbia.edu/tag/0GAE)
* [Stacks Project, Tag 0GAY](https://stacks.math.columbia.edu/tag/0GAY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Rig

universe u v u₁ u₂

open AdicFiniteTypeAlgebra CompletedNaiveCotangentComplex

attribute [local instance] HasDerivedCategory.standard

section Criterion

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}
  (B : AdicFiniteTypeAlgebra.{u, v} A I)

/-- The degree `0` term `⨁ i, B dxᵢ` of the complex of a completed polynomial presentation is
projective, being free. -/
public theorem projective_X_zero (P : CompletedPolynomialPresentation I B) :
    Projective ((completedNaiveCotangentComplex B P).cochainComplex.X 0) := by
  have hproj : Module.Projective B.carrier
      ((completedNaiveCotangentComplex B P).cochainComplex.X 0) := by
    have := (completedNaiveCotangentComplex B P).free_X_zero
    infer_instance
  exact (IsProjective.iff_projective (R := B.carrier) _).mp hproj

/-- If a scalar `f ∈ B` acts by zero on `NL^∧_{B/A}` in `D(B)`, then multiplication by `f` on
both terms of the presentation's complex is realized by a single map
`s : ⨁ i, B dxᵢ → J/J²` against the differential: a null-homotopy of `f • 𝟙`.

The degree-zero term is free, so this is the forcing direction of
`TwoTermComplex.smul_id_Q_obj_eq_zero_iff_exists_factorization`. -/
public theorem exists_factorization_of_smul_id_eq_zero
    (P : CompletedPolynomialPresentation I B) (f : B.carrier)
    (h : f • 𝟙 (derivedCompletedNaiveCotangentComplex B P) = 0) :
    ∃ s : (completedNaiveCotangentComplex B P).cochainComplex.X 0 ⟶
        (completedNaiveCotangentComplex B P).cochainComplex.X (-1),
      (completedNaiveCotangentComplex B P).cochainComplex.d (-1) 0 ≫ s =
          f • 𝟙 ((completedNaiveCotangentComplex B P).cochainComplex.X (-1)) ∧
        s ≫ (completedNaiveCotangentComplex B P).cochainComplex.d (-1) 0 =
          f • 𝟙 ((completedNaiveCotangentComplex B P).cochainComplex.X 0) := by
  have := (completedNaiveCotangentComplex B P).isStrictlyGE
  have := (completedNaiveCotangentComplex B P).isStrictlyLE
  have := projective_X_zero B P
  exact TwoTermComplex.exists_factorization_of_smul_id_Q_obj_eq_zero f _ h

/-- Conversely, a map `s : ⨁ i, B dxᵢ → J/J²` realizing multiplication by `f` on both terms of
the presentation's complex makes `f` act by zero on `NL^∧_{B/A}` in `D(B)`.

This direction uses nothing about the degree-zero term, so it applies to data transported from
another algebra. -/
public theorem smul_id_eq_zero_of_factorization
    (P : CompletedPolynomialPresentation I B) (f : B.carrier)
    (s : (completedNaiveCotangentComplex B P).cochainComplex.X 0 ⟶
      (completedNaiveCotangentComplex B P).cochainComplex.X (-1))
    (hneg : (completedNaiveCotangentComplex B P).cochainComplex.d (-1) 0 ≫ s =
      f • 𝟙 ((completedNaiveCotangentComplex B P).cochainComplex.X (-1)))
    (hzero : s ≫ (completedNaiveCotangentComplex B P).cochainComplex.d (-1) 0 =
      f • 𝟙 ((completedNaiveCotangentComplex B P).cochainComplex.X 0)) :
    f • 𝟙 (derivedCompletedNaiveCotangentComplex B P) = 0 := by
  have := (completedNaiveCotangentComplex B P).isStrictlyGE
  have := (completedNaiveCotangentComplex B P).isStrictlyLE
  exact TwoTermComplex.smul_id_Q_obj_eq_zero_of_factorization f _ s hneg hzero

/-- A scalar acting by zero on the completed naive cotangent complex in `D(B)` does so for
every completed polynomial presentation of `B`: the complexes of two presentations are
isomorphic in `D(B)` by **Stacks 0GAE**. -/
public theorem smul_id_congr_presentation (P Q : CompletedPolynomialPresentation I B)
    (f : B.carrier) (h : f • 𝟙 (derivedCompletedNaiveCotangentComplex B P) = 0) :
    f • 𝟙 (derivedCompletedNaiveCotangentComplex B Q) = 0 := by
  obtain ⟨e⟩ := nonempty_derivedCompletedNaiveCotangentComplex_iso B P Q
  exact smul_id_eq_zero_of_iso e f h

end Criterion

section BaseChange

variable {A₁ : Type u₁} [CommRing A₁] [IsNoetherianRing A₁]
variable {A₂ : Type u₂} [CommRing A₂] [IsNoetherianRing A₂] [Algebra A₁ A₂]
variable {I₁ : Ideal A₁} {I₂ : Ideal A₂}

variable (C : CompletedBaseChange (A₁ := A₁) (A₂ := A₂) (I₁ := I₁) (I₂ := I₂))
  (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁)
  (P₁ : CompletedPolynomialPresentation I₁ B₁)
  (P₂ : CompletedPolynomialPresentation I₂ (C.functor.obj B₁))
  (f₁ : B₁.carrier)

/-- **Reduction of Stacks 0AK2 to Stacks 0GAG.**  Let `(A₁, I₁) → (A₂, I₂)` be a completed base
change of Noetherian adic pairs, `B₁` adically of finite type over `(A₁, I₁)`, and
`B₂ = (B₁ ⊗_{A₁} A₂)^∧` its base change.  Let `f₁ ∈ B₁` with image `f₂ ∈ B₂`.  If every
null-homotopy of `f₁ • 𝟙` on `NL^∧_{B₁/A₁}` yields a null-homotopy of `f₂ • 𝟙` on
`NL^∧_{B₂/A₂}` — which is what the comparison map `NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}` of
Stacks 0GAG supplies, being an isomorphism in degree `0` and surjective on conormal modules —
then `f₁` acting by zero on `NL^∧_{B₁/A₁}` in `D(B₁)` gives `f₂` acting by zero on
`NL^∧_{B₂/A₂}` in `D(B₂)`. -/
public theorem smul_id_of_baseChange_of_factorization
    (hcomparison : ∀ s₁ : (completedNaiveCotangentComplex B₁ P₁).cochainComplex.X 0 ⟶
        (completedNaiveCotangentComplex B₁ P₁).cochainComplex.X (-1),
        (completedNaiveCotangentComplex B₁ P₁).cochainComplex.d (-1) 0 ≫ s₁ =
            f₁ • 𝟙 ((completedNaiveCotangentComplex B₁ P₁).cochainComplex.X (-1)) →
        s₁ ≫ (completedNaiveCotangentComplex B₁ P₁).cochainComplex.d (-1) 0 =
            f₁ • 𝟙 ((completedNaiveCotangentComplex B₁ P₁).cochainComplex.X 0) →
          ∃ s₂ : (completedNaiveCotangentComplex (C.functor.obj B₁) P₂).cochainComplex.X 0 ⟶
              (completedNaiveCotangentComplex (C.functor.obj B₁) P₂).cochainComplex.X (-1),
            (completedNaiveCotangentComplex (C.functor.obj B₁) P₂).cochainComplex.d (-1) 0 ≫
                s₂ =
              C.scalar B₁ f₁ • 𝟙 ((completedNaiveCotangentComplex (C.functor.obj B₁)
                P₂).cochainComplex.X (-1)) ∧
            s₂ ≫ (completedNaiveCotangentComplex (C.functor.obj B₁)
                P₂).cochainComplex.d (-1) 0 =
              C.scalar B₁ f₁ • 𝟙 ((completedNaiveCotangentComplex (C.functor.obj B₁)
                P₂).cochainComplex.X 0))
    (h : f₁ • 𝟙 (derivedCompletedNaiveCotangentComplex B₁ P₁) = 0) :
    (C.completedTensorProductEquiv B₁).symm
      (AdicCompletion.of (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁)
        (baseChangedAlgebra (A₂ := A₂) B₁)
        ((Algebra.TensorProduct.includeLeft : B₁.carrier →ₐ[A₁]
          baseChangedAlgebra (A₂ := A₂) B₁) f₁)) •
      𝟙 (derivedCompletedNaiveCotangentComplex (C.functor.obj B₁) P₂) = 0 := by
  obtain ⟨s₁, hneg₁, hzero₁⟩ := exists_factorization_of_smul_id_eq_zero B₁ P₁ f₁ h
  obtain ⟨s₂, hneg₂, hzero₂⟩ := hcomparison s₁ hneg₁ hzero₁
  exact smul_id_eq_zero_of_factorization (C.functor.obj B₁) P₂ (C.scalar B₁ f₁) s₂ hneg₂ hzero₂

end BaseChange

end Rig

end
