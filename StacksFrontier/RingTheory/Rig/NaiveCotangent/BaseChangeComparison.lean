module

public import Mathlib.LinearAlgebra.TensorProduct.Pi
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChangeExt
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.DegreeZeroRow
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.Homology

/-!
# The comparison map of Stacks 0GAG and its effect on cohomology

Let `(A₁, I₁) → (A₂, I₂)` be as in Stacks Remark 0AL5 with `A₁` and `A₂` Noetherian, let `B₁`
be an `I₁`-adically complete `A₁`-algebra of finite type modulo `I₁`, and let `B₂` be its
completed base change `(B₁ ⊗_{A₁} A₂)^∧_{I₂}`. There is a canonical map of two-term complexes of
`B₂`-modules

`NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}`

which induces an isomorphism on `H⁰` and a surjection on `H⁻¹`. It is built on the presentations
`B₁ = A₁[x₁, …, x_r]^∧ / J₁` and `B₂ = A₂[x₁, …, x_r]^∧ / J₂` in the same variables that a
generating family `g` of `B₁` modulo `I₁` determines.

The indexing of `NaiveCotangent.TwoTerm` is homological: the conormal module `J / J²` is the
degree-`1` term `X₁` and the free module `⨁ B dxᵢ` is the degree-`0` term `X₀`. Thus
`NaiveCotangent.ChainMap.onH₁`, the map on `ker d`, is the map on `H⁻¹`, and
`NaiveCotangent.ChainMap.onH₀`, the map on `coker d`, is the map on `H⁰`.

## Main definitions

* `Rig.freeBaseChangeEquiv`: the identification `(⨁ᵢ R₁) ⊗_{R₁} R₂ ≅ ⨁ᵢ R₂` of the degree-`0`
  terms.
* `Rig.baseChangedTwoTerm`: the base change along `R₁ → R₂` of a two-term complex whose
  degree-`0` term is the free module on `r` generators; at the differential of
  `Rig.completedNaiveCotangentComplex` this is `NL^∧_{B₁/A₁} ⊗_{B₁} B₂`.
* `Rig.freeBaseChangeChainMap`: the chain map out of that base change determined by a commuting
  square.
* `Rig.baseChangeComparison`: the canonical comparison map `NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}`
  of Stacks 0GAG, for the compatible presentations attached to a generating family of `B₁`
  modulo `I₁`.

## Main results

* `Rig.bijective_onH₀_freeBaseChangeChainMap` and `Rig.surjective_onH₁_freeBaseChangeChainMap`:
  for a comparison whose degree-`1` component has `R₂`-spanning image, the map on `coker d` is
  bijective and the map on `ker d` is surjective.
* `Rig.baseChangeComparison_f₁_tmul` and `Rig.baseChangeComparison_f₀_tmul`: in degree `-1` the
  comparison is the map on conormal modules induced by the base-change map of completed
  polynomial algebras, and in degree `0` it is `dxᵢ ↦ dxᵢ`.
* `Rig.surjective_baseChangeComparison_f₁` and `Rig.bijective_baseChangeComparison_f₀`: the
  comparison is surjective in degree `-1` when `J₂` is generated by the image of `J₁`, and
  bijective in degree `0`.
* `Rig.bijective_onH₀_baseChangeComparison` and `Rig.surjective_onH₁_baseChangeComparison`: the
  two assertions of Stacks 0GAG, when `J₂` is generated by the image of `J₁`.
* `Rig.bijective_onH₀_baseChangeComparison_of_completedBaseChange` and
  `Rig.surjective_onH₁_baseChangeComparison_of_completedBaseChange`: the same two assertions
  when `B₂` is the completed base change, the identification of `B₂` with
  `(B₁ ⊗_{A₁} A₂)^∧_{I₂}` taken as data.

## References

* [Stacks Project, Tag 0GAG](https://stacks.math.columbia.edu/tag/0GAG)
* [Stacks Project, Tag 0AL5](https://stacks.math.columbia.edu/tag/0AL5)
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace Rig

universe u₁ u₂ v w

open AdicFiniteTypeAlgebra CompletedPolynomialPresentation

section TwoTermHomology

variable {S : Type*} [CommRing S] {X Y : NaiveCotangent.TwoTerm S}

/-- A chain map of two-term complexes which is surjective in degree `1` and injective in
degree `0` is surjective on `H₁ = ker d`. -/
private theorem surjective_onH₁_of_surjective_f₁ (F : NaiveCotangent.ChainMap X Y)
    (h₁ : Function.Surjective F.f₁) (h₀ : Function.Injective F.f₀) :
    Function.Surjective F.onH₁ := by
  intro y
  obtain ⟨x, hx⟩ := h₁ (y : Y.X₁)
  refine ⟨⟨x, h₀ ?_⟩, Subtype.ext hx⟩
  rw [map_zero, ← NaiveCotangent.ChainMap.comm_apply, hx]
  exact y.2

/-- A chain map of two-term complexes which is surjective in degree `1` and injective in
degree `0` is injective on `H₀ = coker d`. -/
private theorem injective_onH₀_of_surjective_f₁ (F : NaiveCotangent.ChainMap X Y)
    (h₁ : Function.Surjective F.f₁) (h₀ : Function.Injective F.f₀) :
    Function.Injective F.onH₀ := by
  rw [injective_iff_map_eq_zero]
  intro xbar hxbar
  obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (LinearMap.range X.d) xbar
  rw [NaiveCotangent.ChainMap.onH₀_mkQ, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero] at hxbar
  obtain ⟨y, hy⟩ := hxbar
  obtain ⟨z, hz⟩ := h₁ y
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  refine ⟨z, h₀ ?_⟩
  rw [← NaiveCotangent.ChainMap.comm_apply, hz, hy]

/-- A chain map of two-term complexes which is surjective in degree `1` and bijective in
degree `0` is bijective on `H₀ = coker d`. -/
private theorem bijective_onH₀_of_surjective_f₁ (F : NaiveCotangent.ChainMap X Y)
    (h₁ : Function.Surjective F.f₁) (h₀ : Function.Bijective F.f₀) :
    Function.Bijective F.onH₀ :=
  ⟨injective_onH₀_of_surjective_f₁ F h₁ h₀.1, NaiveCotangent.surjective_onH₀ F h₀.2⟩

end TwoTermHomology

/-! ## Base change of a two-term complex with finite free degree-`0` term -/

section FreeBaseChange

variable {R₁ : Type*} [CommRing R₁] {R₂ : Type*} [CommRing R₂] [Algebra R₁ R₂]
  {M₁ : Type*} [AddCommGroup M₁] [Module R₁ M₁]
  {M₂ : Type*} [AddCommGroup M₂] [Module R₂ M₂] [Module R₁ M₂] [IsScalarTower R₁ R₂ M₂]
  {r : ℕ}

/-- The canonical `R₂`-linear identification `R₂ ⊗_{R₁} (⨁_{i<r} R₁) ≅ ⨁_{i<r} R₂`: base
change of a finite free module, sending `b ⊗ v` to `i ↦ v i · b`. -/
public abbrev freeBaseChangeEquiv (R₁ : Type*) [CommRing R₁] (R₂ : Type*) [CommRing R₂]
    [Algebra R₁ R₂] (r : ℕ) :
    TensorProduct R₁ R₂ (Fin r → R₁) ≃ₗ[R₂] (Fin r → R₂) :=
  TensorProduct.piScalarRight R₁ R₂ R₂ (Fin r)

/-- On a pure tensor, the identification `R₂ ⊗_{R₁} (⨁_{i<r} R₁) ≅ ⨁_{i<r} R₂` is
`b ⊗ v ↦ b · (i ↦ v i)`. -/
@[simp] public theorem freeBaseChangeEquiv_tmul (b : R₂) (v : Fin r → R₁) :
    freeBaseChangeEquiv R₁ R₂ r (b ⊗ₜ[R₁] v) = b • fun i ↦ algebraMap R₁ R₂ (v i) := by
  rw [freeBaseChangeEquiv, TensorProduct.piScalarRight_apply,
    TensorProduct.piScalarRightHom_tmul]
  funext i
  rw [Pi.smul_apply, smul_eq_mul, Algebra.smul_def, mul_comm]

/-- The base change along `R₁ → R₂` of a two-term complex `M₁ --d₁--> ⨁_{i<r} R₁` whose
degree-`0` term is finite free: the two-term complex of `R₂`-modules
`R₂ ⊗_{R₁} M₁ --d₁ ⊗ id--> R₂ ⊗_{R₁} (⨁_{i<r} R₁)`. -/
public def baseChangedTwoTerm (R₂ : Type*) [CommRing R₂] [Algebra R₁ R₂]
    (d₁ : M₁ →ₗ[R₁] (Fin r → R₁)) : NaiveCotangent.TwoTerm R₂ where
  X₁ := TensorProduct R₁ R₂ M₁
  X₀ := TensorProduct R₁ R₂ (Fin r → R₁)
  d := LinearMap.baseChange R₂ d₁

/-- The differential of the base-changed complex is the base change of the differential. -/
@[simp] public theorem baseChangedTwoTerm_d (d₁ : M₁ →ₗ[R₁] (Fin r → R₁)) :
    (baseChangedTwoTerm R₂ d₁).d = LinearMap.baseChange R₂ d₁ := rfl

variable (d₁ : M₁ →ₗ[R₁] (Fin r → R₁)) (d₂ : M₂ →ₗ[R₂] (Fin r → R₂)) (θ : M₁ →ₗ[R₁] M₂)
  (hθd : ∀ x : M₁, d₂ (θ x) = fun i ↦ algebraMap R₁ R₂ (d₁ x i))

/-- Let `ι : R₁ → R₂` be a ring map, let `d₁ : M₁ → ⨁_{i<r} R₁` and `d₂ : M₂ → ⨁_{i<r} R₂` be
linear maps and let `θ : M₁ → M₂` be `R₁`-linear with `d₂ ∘ θ = ι ∘ d₁` coefficientwise. Then
the square is a chain map

`(M₁ --d₁--> ⨁_{i<r} R₁) ⊗_{R₁} R₂ → (M₂ --d₂--> ⨁_{i<r} R₂)`,

whose degree-`1` component is the `R₂`-linear extension of `θ` and whose degree-`0` component
is the identification of `R₂ ⊗_{R₁} (⨁_{i<r} R₁)` with `⨁_{i<r} R₂`. -/
public def freeBaseChangeChainMap :
    NaiveCotangent.ChainMap (baseChangedTwoTerm R₂ d₁) (NaiveCotangent.TwoTerm.ofFree d₂) where
  f₁ := θ.liftBaseChange R₂
  f₀ := (freeBaseChangeEquiv R₁ R₂ r).toLinearMap
  comm := by
    refine LinearMap.ext fun x ↦ ?_
    change d₂ (θ.liftBaseChange R₂ x) =
      freeBaseChangeEquiv R₁ R₂ r (LinearMap.baseChange R₂ d₁ x)
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul b y => rw [LinearMap.liftBaseChange_tmul, map_smul, hθd y,
        LinearMap.baseChange_tmul, freeBaseChangeEquiv_tmul]
    | add x y hx hy => simp only [map_add, hx, hy]

/-- The degree-`1` component of the comparison map is the `R₂`-linear extension of `θ`. -/
@[simp] public theorem freeBaseChangeChainMap_f₁_tmul (b : R₂) (y : M₁) :
    (freeBaseChangeChainMap d₁ d₂ θ hθd).f₁ (b ⊗ₜ[R₁] y) = b • θ y := rfl

/-- The degree-`0` component of the comparison map is the identification of
`R₂ ⊗_{R₁} (⨁_{i<r} R₁)` with `⨁_{i<r} R₂`. -/
@[simp] public theorem freeBaseChangeChainMap_f₀_tmul (b : R₂) (v : Fin r → R₁) (i : Fin r) :
    (freeBaseChangeChainMap d₁ d₂ θ hθd).f₀ (b ⊗ₜ[R₁] v) i = algebraMap R₁ R₂ (v i) * b := by
  rw [show (freeBaseChangeChainMap d₁ d₂ θ hθd).f₀ (b ⊗ₜ[R₁] v) =
      freeBaseChangeEquiv R₁ R₂ r (b ⊗ₜ[R₁] v) from rfl, freeBaseChangeEquiv_tmul,
    Pi.smul_apply, smul_eq_mul, mul_comm]

/-- The comparison map is bijective in degree `0`. -/
public theorem bijective_freeBaseChangeChainMap_f₀ :
    Function.Bijective (freeBaseChangeChainMap d₁ d₂ θ hθd).f₀ :=
  (freeBaseChangeEquiv R₁ R₂ r).bijective

/-- The comparison map is surjective in degree `1` as soon as the image of `θ` spans `M₂`
over `R₂`. -/
public theorem surjective_freeBaseChangeChainMap_f₁
    (hθspan : Submodule.span R₂ (Set.range θ) = ⊤) :
    Function.Surjective (freeBaseChangeChainMap d₁ d₂ θ hθd).f₁ :=
  LinearMap.range_eq_top.mp (show LinearMap.range (θ.liftBaseChange R₂) = ⊤ by
    rwa [LinearMap.range_liftBaseChange, LinearMap.coe_range])

/-- If the image of `θ` spans `M₂` over `R₂`, the comparison map induces an isomorphism on
`H₀ = coker d`. -/
public theorem bijective_onH₀_freeBaseChangeChainMap
    (hθspan : Submodule.span R₂ (Set.range θ) = ⊤) :
    Function.Bijective (freeBaseChangeChainMap d₁ d₂ θ hθd).onH₀ :=
  bijective_onH₀_of_surjective_f₁ _
    (surjective_freeBaseChangeChainMap_f₁ d₁ d₂ θ hθd hθspan)
    (bijective_freeBaseChangeChainMap_f₀ d₁ d₂ θ hθd)

/-- If the image of `θ` spans `M₂` over `R₂`, the comparison map is surjective on
`H₁ = ker d`. -/
public theorem surjective_onH₁_freeBaseChangeChainMap
    (hθspan : Submodule.span R₂ (Set.range θ) = ⊤) :
    Function.Surjective (freeBaseChangeChainMap d₁ d₂ θ hθd).onH₁ :=
  surjective_onH₁_of_surjective_f₁ _
    (surjective_freeBaseChangeChainMap_f₁ d₁ d₂ θ hθd hθspan)
    (bijective_freeBaseChangeChainMap_f₀ d₁ d₂ θ hθd).1

end FreeBaseChange

/-! ## The comparison map of Stacks 0GAG -/

section Comparison

open CompletedNaiveCotangentComplex

variable {A₁ : Type u₁} [CommRing A₁] [IsNoetherianRing A₁]
  {A₂ : Type u₂} [CommRing A₂] [IsNoetherianRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]
  (hI₁ : I₁.FG) (hI₂ : I₂.FG) (hc : 0 < c)
  (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
  (hspan : (⊤ : Submodule A₂ B₂.carrier) ≤
    Submodule.span A₂ (Set.range (algebraMap B₁.carrier B₂.carrier)) ⊔
      Submodule.restrictScalars A₂ B₂.adicIdeal)
  (r : ℕ) (g : Fin r → B₁.carrier)
  (hgen : Function.Surjective (MvPolynomial.aeval
    (fun i ↦ Ideal.Quotient.mk B₁.adicIdeal (g i)) :
      MvPolynomial (Fin r) (A₁ ⧸ I₁) →ₐ[A₁ ⧸ I₁] B₁.reduction))

/-- The canonical comparison map `NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}`, for the presentation of
`B₁` cut out by a generating family `g` of `B₁` modulo `I₁` and the compatible presentation of the
base change `B₂` in the same variables.

In degree `-1` it is the `B₂`-linear extension of the map `J₁ / J₁² → J₂ / J₂²` induced by the
base-change map of completed polynomial algebras, and in degree `0` it is `dxᵢ ↦ dxᵢ`. -/
@[stacks 0GAG "the comparison map"]
public def baseChangeComparison :
    NaiveCotangent.ChainMap
      (baseChangedTwoTerm B₂.carrier
        (completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)).differential)
      (completedNaiveCotangentComplex B₂
        (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)).twoTerm :=
  freeBaseChangeChainMap
    (completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen)).differential
    (completedNaiveCotangentComplex B₂
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)).differential
    (baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen)
    (baseChange_differential hI₁ hI₂ hc hmap hspan r g hgen
      (completedNaiveCotangentComplex B₁ (ofGenerators B₁ r g hI₁ hgen))
      (completedNaiveCotangentComplex B₂
        (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen)))

/-- In degree `-1` the comparison map is the map `J₁ / J₁² → J₂ / J₂²` induced by the
base-change map of completed polynomial algebras, extended `B₂`-linearly. -/
@[simp] public theorem baseChangeComparison_f₁_tmul
    (b : B₂.carrier) (y : (ofGenerators B₁ r g hI₁ hgen).extension.Cotangent) :
    (baseChangeComparison hI₁ hI₂ hc hmap hspan r g hgen).f₁ (b ⊗ₜ[B₁.carrier] y) =
      b • baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen y :=
  rfl

/-- In degree `0` the comparison map is `dxᵢ ↦ dxᵢ`: it sends `b ⊗ v` to the tuple
`i ↦ v i · b`. -/
@[simp] public theorem baseChangeComparison_f₀_tmul
    (b : B₂.carrier) (v : Fin r → B₁.carrier) (i : Fin r) :
    (baseChangeComparison hI₁ hI₂ hc hmap hspan r g hgen).f₀ (b ⊗ₜ[B₁.carrier] v) i =
      algebraMap B₁.carrier B₂.carrier (v i) * b :=
  freeBaseChangeChainMap_f₀_tmul _ _ _ _ b v i

/-- The comparison map is bijective in degree `0`. -/
public theorem bijective_baseChangeComparison_f₀ :
    Function.Bijective (baseChangeComparison hI₁ hI₂ hc hmap hspan r g hgen).f₀ :=
  bijective_freeBaseChangeChainMap_f₀ _ _ _ _

/-- The comparison map is surjective in degree `-1`, that is,
`J₁ / J₁² ⊗_{B₁} B₂ → J₂ / J₂²` is surjective, as soon as `J₂` is generated by the image of
`J₁` under the base-change map of completed polynomial algebras. -/
public theorem surjective_baseChangeComparison_f₁
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker) :
    Function.Surjective (baseChangeComparison hI₁ hI₂ hc hmap hspan r g hgen).f₁ :=
  surjective_freeBaseChangeChainMap_f₁ _ _ _ _
    (span_range_baseChangeCotangentMap_eq_top hI₁ hI₂ hc hmap hspan r g hgen hker)

/-- The comparison map induces an isomorphism on `H⁰`, the cokernel of the differential, as
soon as `J₂` is generated by the image of `J₁`. -/
public theorem bijective_onH₀_baseChangeComparison
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker) :
    Function.Bijective (baseChangeComparison hI₁ hI₂ hc hmap hspan r g hgen).onH₀ :=
  bijective_onH₀_freeBaseChangeChainMap _ _ _ _
    (span_range_baseChangeCotangentMap_eq_top hI₁ hI₂ hc hmap hspan r g hgen hker)

/-- The comparison map induces a surjection on `H⁻¹`, the kernel of the differential, as soon
as `J₂` is generated by the image of `J₁`. -/
public theorem surjective_onH₁_baseChangeComparison
    (hker : (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker) :
    Function.Surjective (baseChangeComparison hI₁ hI₂ hc hmap hspan r g hgen).onH₁ :=
  surjective_onH₁_freeBaseChangeChainMap _ _ _ _
    (span_range_baseChangeCotangentMap_eq_top hI₁ hI₂ hc hmap hspan r g hgen hker)

end Comparison

/-! ## Stacks 0GAG for the completed base change -/

section CompletedBaseChange

open CompletedNaiveCotangentComplex

variable {A₁ : Type u₁} [CommRing A₁] [IsNoetherianRing A₁]
  {A₂ : Type u₂} [CommRing A₂] [IsNoetherianRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]
  (hI₁ : I₁.FG) (hI₂ : I₂.FG) (hc : 0 < c)
  (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
  (e : B₂.carrier ≃+* completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)
  (heA : ∀ a : A₂, e (algebraMap A₂ B₂.carrier a) =
    algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
      (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) (baseChangedRight A₂ B₁ a))
  (heB : ∀ b : B₁.carrier, e (algebraMap B₁.carrier B₂.carrier b) =
    algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
      (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) (baseChangedLeft A₂ B₁ b))
  (r : ℕ) (g : Fin r → B₁.carrier)
  (hgen : Function.Surjective (MvPolynomial.aeval
    (fun i ↦ Ideal.Quotient.mk B₁.adicIdeal (g i)) :
      MvPolynomial (Fin r) (A₁ ⧸ I₁) →ₐ[A₁ ⧸ I₁] B₁.reduction))

omit [IsNoetherianRing A₁] in
/-- When `B₂` is the completed base change, `J₂` is generated by the image of `J₁` under the
base-change map of completed polynomial algebras. -/
private theorem ker_le_map_ker_baseChangeExtensionHom :
    (baseChangePresentation (B₁ := B₁) hI₂ hc hmap
          (le_span_range_sup_adicIdeal_of_completedBaseChange hI₂ e heA heB) r g
        hgen).extension.ker ≤
      Ideal.map (baseChangeExtensionHom hI₁ hI₂ hc hmap
          (le_span_range_sup_adicIdeal_of_completedBaseChange hI₂ e heA heB) r g hgen).toRingHom
        (ofGenerators B₁ r g hI₁ hgen).extension.ker := by
  rw [ker_extension_baseChangePresentation hI₂ hc hmap
      (le_span_range_sup_adicIdeal_of_completedBaseChange hI₂ e heA heB) r g hgen,
    ker_extension_ofGenerators hI₁ r g hgen]
  exact ker_le_map_ker_of_completedBaseChange hI₂ hmap r g
    (completedAeval_surjective B₁ r g hI₁ hgen) e heA heB

/-- Let `(A₁, I₁) → (A₂, I₂)` be as in Stacks Remark 0AL5 — a map of Noetherian pairs carrying a
positive power of `I₁` into `I₂` — let `B₁` be adically of finite type over `(A₁, I₁)`, and let
`B₂` be its completed base change `(B₁ ⊗_{A₁} A₂)^∧_{I₂}`. Then the canonical comparison map
`NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}` of `Rig.baseChangeComparison` induces an isomorphism on
`H⁰`. The identification of `B₂` with `(B₁ ⊗_{A₁} A₂)^∧_{I₂}` is the data `e`, `heA`, `heB`. -/
@[stacks 0GAG "isomorphism on H⁰"]
public theorem bijective_onH₀_baseChangeComparison_of_completedBaseChange :
    Function.Bijective (baseChangeComparison hI₁ hI₂ hc hmap
      (le_span_range_sup_adicIdeal_of_completedBaseChange hI₂ e heA heB) r g hgen).onH₀ :=
  bijective_onH₀_baseChangeComparison hI₁ hI₂ hc hmap _ r g hgen
    (ker_le_map_ker_baseChangeExtensionHom hI₁ hI₂ hc hmap e heA heB r g hgen)

/-- In the situation of
`Rig.bijective_onH₀_baseChangeComparison_of_completedBaseChange` — `(A₁, I₁) → (A₂, I₂)` as in
Stacks Remark 0AL5 with both rings Noetherian, and `B₂` the completed base change of `B₁` —
the canonical comparison map `NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}` induces a surjection on
`H⁻¹`. -/
@[stacks 0GAG "surjection on H⁻¹"]
public theorem surjective_onH₁_baseChangeComparison_of_completedBaseChange :
    Function.Surjective (baseChangeComparison hI₁ hI₂ hc hmap
      (le_span_range_sup_adicIdeal_of_completedBaseChange hI₂ e heA heB) r g hgen).onH₁ :=
  surjective_onH₁_baseChangeComparison hI₁ hI₂ hc hmap _ r g hgen
    (ker_le_map_ker_baseChangeExtensionHom hI₁ hI₂ hc hmap e heA heB r g hgen)

end CompletedBaseChange

