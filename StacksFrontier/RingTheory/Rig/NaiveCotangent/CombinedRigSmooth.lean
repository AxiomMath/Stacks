/-!
# Stacks 0GH2: the kernel at the left end of the sequence of Stacks 0ALM

Let `A` be a Noetherian ring, `I ⊆ A` an ideal, let `B` and `C` be objects of the category
(Stacks 0AL4) and `B → C` a morphism.  Fix a completed polynomial presentation
`B = A⟨x₁, …, x_r⟩ / J` and a presentation `ψ : B⟨y₁, …, y_s⟩ ↠ C` of `C` over `B`, so that the
combined presentation of Stacks 0ALM presents `C = A⟨x, y⟩ / K`.  **Stacks 0GH2** says that if
`B → C` is rig-smooth, then the kernel of the first map

`H⁻¹(NL^∧_{B/A} ⊗_B C) ⟶ H⁻¹(NL^∧_{C/A})`

of the six-term sequence of Stacks 0ALM is annihilated by an ideal of definition of `C`.

Rig-smoothness of `B → C` (that is, rig-smoothness of `C` over `(B, I B)`,
`Rig.AdicFiniteTypeAlgebra.overBase`) enters the source's proof only through **Stacks 0GH1**,
which converts it into the statement that `ker ψ` localizes to an ideal generated by a regular
sequence at every prime of `B⟨y⟩` which contains `ker ψ` and no ideal of definition
(`Rig.exists_isRegular_ofList_eq_map_presentationIdeal`).  From there: the kernel in
question is a submodule of the kernel of the conormal comparison `C ⊗_B J/J² → K/K²`, which is a
finite `C`-module, so it suffices to kill it after localizing at each prime of `C` off the ideal
of definition; and there the comparison is injective, because `A⟨x⟩ → A⟨x, y⟩` is flat and
`J·A⟨x, y⟩ ∩ K² = J·A⟨x, y⟩·K` holds after localization by Stacks 07CX.

## Main results

* `Rig.CompletedPolynomialPresentation.exists_pow_adicIdeal_le_annihilator_ker_onH₁_chainMapInl`
  — **Stacks 0GH2**.  The map is the library's own 0ALM map, namely the one induced on `H⁻¹` by
  the left-hand chain map
  `Rig.CompletedPolynomialPresentation.combinedDifferential_comp_innerCotangentMap` of
  `Rig.CompletedPolynomialPresentation.exists_sixTerm_exact_combined`.

## Implementation notes

The reduction from the kernel on `H⁻¹` to the kernel of the conormal comparison is
`Rig.CombinedRigSmooth.annihilator_ker_le_annihilator_ker_restrict`:
`NaiveCotangent.ChainMap.onH₁` is by definition
the restriction of the degree-`1` map, and the degree-`1` map of `NaiveCotangent.chainMapInl` is
the conormal comparison itself, so no identification of maps is needed.

Flatness of the inclusion of the inner variables is obtained from
`Rig.CompletedPolynomialPresentation.combinedInclusion_eq`, which says that it is the completion
of the renaming `A[x] → A[x, y]`: that renaming exhibits `A[x, y]` as a polynomial algebra over
`A[x]`, hence is flat, and `AdicCompletion.isNoetherianRing_and_flat_of_flat_quotient`
(Stacks 0AGW) transports flatness through the completion.

## References

* [Stacks Project, Tag 0GH2](https://stacks.math.columbia.edu/tag/0GH2)
* [Stacks Project, Tag 0ALM](https://stacks.math.columbia.edu/tag/0ALM)
* [Stacks Project, Tag 0GH1](https://stacks.math.columbia.edu/tag/0GH1)
* [Stacks Project, Tag 07CX](https://stacks.math.columbia.edu/tag/07CX)
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace Rig

namespace CombinedRigSmooth

/-! ## Annihilation of a finite module with small support -/

section Support

/-- A finite module whose localizations away from `V 𝔞` all vanish is annihilated by a power
of `𝔞`, provided `𝔞` is finitely generated. -/
private theorem exists_pow_le_annihilator_of_localization_subsingleton
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (𝔞 : Ideal R) (h𝔞 : 𝔞.FG)
    (h : ∀ p : PrimeSpectrum R, ¬ 𝔞 ≤ p.asIdeal →
      Subsingleton (LocalizedModule p.asIdeal.primeCompl M)) :
    ∃ n : ℕ, 𝔞 ^ n ≤ Module.annihilator R M := by
  apply Ideal.exists_pow_le_of_le_radical_of_fg _ h𝔞
  rw [Ideal.radical_eq_sInf]
  apply le_sInf
  rintro p ⟨hle, hp⟩
  by_contra hnot
  have hsupport : (⟨p, hp⟩ : PrimeSpectrum R) ∈ Module.support R M :=
    Module.mem_support_iff_of_finite.mpr hle
  exact (Module.notMem_support_iff.mpr (h ⟨p, hp⟩ hnot)) hsupport

/-- Restricting a linear map to a pair of submodules can only shrink its kernel, so whatever
annihilates the kernel of the map annihilates the kernel of the restriction. -/
private theorem annihilator_ker_le_annihilator_ker_restrict
    {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (f : M →ₗ[R] N)
    {U : Submodule R M} {V : Submodule R N}
    (hf : ∀ x ∈ U, f x ∈ V) :
    Module.annihilator R (LinearMap.ker f) ≤
      Module.annihilator R (LinearMap.ker (f.restrict hf)) := by
  intro scalar hscalar
  rw [Module.mem_annihilator] at hscalar ⊢
  intro element
  apply Subtype.ext
  apply Subtype.ext
  have hker : f element.val.val = 0 :=
    congrArg Subtype.val element.property
  simpa only [Submodule.coe_smul, Submodule.coe_zero] using
    congrArg (fun value : LinearMap.ker f => (value : M))
      (hscalar ⟨element.val.val, hker⟩)

end Support

/-! ## The conormal intersection formula after localization -/

section Intersection

/-- Stacks 0666 for a surjection: if the image of `K` in the target is generated by a regular
sequence, then `ker φ ∩ K² = (ker φ) K`. -/
private theorem inf_sq_eq_mul_of_surjective_of_isRegular
    {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (hφ : Function.Surjective φ)
    (K : Ideal R) (hK : RingHom.ker φ ≤ K)
    (f : List S) (hreg : RingTheory.Sequence.IsRegular S f)
    (hspan : Ideal.ofList f = K.map φ) :
    RingHom.ker φ ⊓ K ^ 2 = RingHom.ker φ * K := by
  let e := φ.quotientKerEquivOfSurjective hφ
  let g : Fin f.length → R ⧸ RingHom.ker φ := fun i => e.symm (f.get i)
  have hreg' : Koszul.IsH1Regular (fun i => f.get i) :=
    ((Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular (M := S)).2.2
      (by simpa using hreg)).isH1Regular
  apply Koszul.inf_sq_eq_mul_of_quotient_generated_by_isH1Regular _ K hK g
  · apply (show Function.Injective (Ideal.map e.toRingHom) from by
      intro U V h
      have he : e.symm.toRingHom.comp e.toRingHom = RingHom.id _ :=
        RingHom.ext fun x => e.symm_apply_apply x
      simpa only [Ideal.map_map, he, Ideal.map_id] using
        congrArg (Ideal.map e.symm.toRingHom) h)
    rw [Ideal.map_span, Ideal.map_map]
    have hc : e.toRingHom.comp (Ideal.Quotient.mk (RingHom.ker φ)) = φ := by
      apply RingHom.ext
      intro r
      exact RingHom.quotientKerEquivOfSurjective_apply_mk hφ r
    rw [hc]
    convert hspan using 1
    congr 1
    ext x
    simp [g, Set.mem_range, List.mem_iff_get]
  · exact isH1Regular_map_ringEquiv e.symm _ hreg'

/-- The conormal intersection formula after localizing at a prime of the target: if the image
of `K` in the localization of `S` is generated by a regular sequence, then
`ker φ ∩ K² = (ker φ) K` holds in the localization of `R` at the contracted prime. -/
private theorem localized_inf_sq_eq_mul_of_isRegular
    {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (hφ : Function.Surjective φ)
    (K : Ideal R) (hK : RingHom.ker φ ≤ K)
    (p : Ideal S) [p.IsPrime]
    (f : List (Localization.AtPrime p))
    (hreg : RingTheory.Sequence.IsRegular (Localization.AtPrime p) f)
    (hspan : Ideal.ofList f = (K.map φ).map
      (algebraMap S (Localization.AtPrime p))) :
    let q := p.comap φ
    (RingHom.ker φ).map (algebraMap R (Localization.AtPrime q)) ⊓
      (K.map (algebraMap R (Localization.AtPrime q))) ^ 2 =
      (RingHom.ker φ).map (algebraMap R (Localization.AtPrime q)) *
        K.map (algebraMap R (Localization.AtPrime q)) := by
  let q := p.comap φ
  have : q.IsPrime := Ideal.comap_isPrime φ p
  have hM : q.primeCompl.map φ = p.primeCompl := by
    ext s
    constructor
    · rintro ⟨r, hr, rfl⟩
      exact hr
    · intro hs
      obtain ⟨r, rfl⟩ := hφ s
      exact ⟨r, hs, rfl⟩
  let ψ : Localization.AtPrime q →+* Localization.AtPrime p :=
    IsLocalization.map (Localization.AtPrime p) φ (Submonoid.map_le_iff_le_comap.mp hM.le)
  have hker : RingHom.ker ψ = (RingHom.ker φ).map
      (algebraMap R (Localization.AtPrime q)) := IsLocalization.ker_map _ φ hM
  have hsurj : Function.Surjective ψ := by
    have : IsLocalization (q.primeCompl.map φ) (Localization.AtPrime p) := by
      rw [hM]
      infer_instance
    exact IsLocalization.map_surjective_of_surjective q.primeCompl
      (Localization.AtPrime q) (Localization.AtPrime p) hφ
  have hcomm : ψ.comp (algebraMap R (Localization.AtPrime q)) =
      (algebraMap S (Localization.AtPrime p)).comp φ := by
    apply RingHom.ext
    intro r
    exact IsLocalization.map_eq (M := q.primeCompl) (T := p.primeCompl)
      (S := Localization.AtPrime q) (Q := Localization.AtPrime p) (g := φ)
      (Submonoid.map_le_iff_le_comap.mp hM.le) r
  dsimp only
  rw [← hker]
  apply inf_sq_eq_mul_of_surjective_of_isRegular ψ hsurj _
    (by rw [hker]; exact Ideal.map_mono hK) f hreg
  rw [Ideal.map_map, hcomm, ← Ideal.map_map]
  exact hspan

end Intersection

/-! ## Killing the kernel of a conormal comparison map -/

section ConormalKernel

open Algebra TensorProduct

/-- An element of `(ker of the presentation) · I` dies in `C ⊗ I`. -/
private theorem tmul_one_eq_zero_of_mem_ker_mul
    {R C : Type*} [CommRing R] [CommRing C] [Algebra R C]
    (E : Extension R C) (I : Ideal E.Ring) (z : E.Ring) (hz : z ∈ E.ker * I) :
    (1 : C) ⊗ₜ[E.Ring] (⟨z, Ideal.mul_le_right hz⟩ : I) = 0 := by
  refine Submodule.smul_induction_on' (p := fun z (hz : z ∈ E.ker * I) ↦
    (1 : C) ⊗ₜ[E.Ring] (⟨z, Ideal.mul_le_right hz⟩ : I) = 0) (hx := hz) ?_ ?_
  · intro a ha b hb
    trans (a • (1 : C)) ⊗ₜ[E.Ring] (⟨b, hb⟩ : I)
    · rw [smul_tmul]; rfl
    · have ha0 : algebraMap E.Ring C a = 0 := ha
      simp [Algebra.smul_def, ha0]
  · intro a ha b hb ha' hb'
    convert congrArg₂ (· + ·) ha' hb' using 1
    · rw [← tmul_add]; rfl
    · simp

/-- Along a flat map of presentations, an element of the kernel of the conormal comparison
`T ⊗_S (ker P)/(ker P)² → (ker Q)/(ker Q)²` is killed by a scalar outside a given prime, as
soon as every element of `(ker P)·Q.Ring` lying in `(ker Q)²` becomes a member of
`(ker P)·Q.Ring · ker Q` after multiplication by such a scalar. -/
private theorem exists_smul_eq_zero_of_mem_ker_cotangentMap
    {R S T : Type*} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T]
    (P : Extension R S) (Q : Extension R T) (f : P.Hom Q)
    [Algebra P.Ring Q.Ring] [Module.Flat P.Ring Q.Ring]
    (halg : algebraMap P.Ring Q.Ring = f.toRingHom)
    (p : Ideal T)
    (hsq : ∀ i : Q.Ring, i ∈ P.ker.map f.toRingHom → i ∈ Q.ker ^ 2 →
      ∃ s : Q.Ring, algebraMap Q.Ring T s ∉ p ∧
        s * i ∈ P.ker.map f.toRingHom * Q.ker)
    (x : T ⊗[S] P.Cotangent)
    (hx : (Extension.Cotangent.map f).liftBaseChange T x = 0) :
    ∃ s : T, s ∉ p ∧ s • x = 0 := by
  let := ((algebraMap S T).comp (algebraMap P.Ring S)).toAlgebra
  have : IsScalarTower P.Ring S T := .of_algebraMap_eq' rfl
  have : IsScalarTower P.Ring Q.Ring T :=
    .of_algebraMap_eq fun r ↦ halg ▸ (f.algebraMap_toRingHom r).symm
  let I := P.ker.map (algebraMap P.Ring Q.Ring)
  have hIQ : I ≤ Q.ker := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    change algebraMap Q.Ring T (algebraMap P.Ring Q.Ring x) = 0
    rw [halg, f.algebraMap_toRingHom]
    rw [show algebraMap P.Ring S x = 0 from hx, map_zero]
  let eI := LinearEquiv.ofBijective _ (idealMap_liftBaseChange_bijective (S := Q.Ring) P.ker)
  let eP := (AlgebraTensorModule.cancelBaseChange P.Ring S T T P.ker).symm ≪≫ₗ
    LinearEquiv.baseChange S T _ _ P.cotangentEquiv
  let eQ := (AlgebraTensorModule.cancelBaseChange P.Ring Q.Ring T T P.ker).symm ≪≫ₗ
    LinearEquiv.baseChange Q.Ring T _ _ eI
  let g := (Extension.Cotangent.mk ∘ₗ Submodule.inclusion hIQ).liftBaseChange T
  have hcomm : ((Extension.Cotangent.map f).liftBaseChange T) ∘ₗ eP.toLinearMap =
      g ∘ₗ eQ.toLinearMap := by
    apply LinearMap.ext
    intro z
    induction z using TensorProduct.inductionOn with
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
    | tmul t x =>
      dsimp only [I] at *
      simp only [eP, eQ, eI, g, LinearMap.comp_apply, LinearEquiv.coe_coe,
        LinearEquiv.trans_apply, AlgebraTensorModule.cancelBaseChange_symm_tmul,
        LinearEquiv.baseChange_tmul, Extension.cotangentEquiv_tmul,
        one_smul, LinearMap.liftBaseChange_tmul, Extension.Cotangent.map_mk,
        LinearEquiv.ofBijective_apply]
      change t • Extension.Cotangent.mk (P := Q) _ = t • Extension.Cotangent.mk (P := Q) _
      congr 2
      apply Subtype.ext
      simp [Algebra.idealMap_apply_coe, halg, Extension.Hom.toAlgHom_apply]
  obtain ⟨z, rfl⟩ := eP.surjective x
  have hz : g (eQ z) = 0 := by
    change (g.comp eQ.toLinearMap) z = 0
    rw [← hcomm]
    exact hx
  obtain ⟨i, hi⟩ := TensorProduct.mk_surjective Q.Ring I T Q.algebraMap_surjective (eQ z)
  have hiSq : (i : Q.Ring) ∈ Q.ker ^ 2 := by
    rw [← hi] at hz
    change (1 : T) • Extension.Cotangent.mk (P := Q) (Submodule.inclusion hIQ i) = 0 at hz
    simpa only [one_smul, Extension.Cotangent.mk_eq_zero_iff,
      Submodule.inclusion_apply] using hz
  obtain ⟨s, hs, hsi⟩ := hsq i (by simpa only [← halg] using i.property) hiSq
  have hk : s * (i : Q.Ring) ∈ Q.ker * I := by
    simpa only [I, halg, Ideal.mul_comm] using hsi
  have hzero : algebraMap Q.Ring T s • eQ z = 0 := by
    rw [← hi]
    calc
      algebraMap Q.Ring T s • ((1 : T) ⊗ₜ[Q.Ring] i) =
          (s • (1 : T)) ⊗ₜ[Q.Ring] i := by simp [Algebra.smul_def, smul_tmul']
      _ = (1 : T) ⊗ₜ[Q.Ring] (s • i) := smul_tmul s 1 i
      _ = 0 := tmul_one_eq_zero_of_mem_ker_mul Q I _ hk
  refine ⟨algebraMap Q.Ring T s, hs, ?_⟩
  rw [← eP.map_smul, ← eP.map_zero]
  congr 1
  apply eQ.injective
  rw [eQ.map_smul, eQ.map_zero]
  exact hzero

end ConormalKernel

/-! ## Flatness of the inclusion of the inner variables -/

section Flatness

universe u v

/-- The `K`-adic completion of `U` as an `R`-module is the `L`-adic completion of `U` as a
ring, when `L` is the extension of `K`. -/
private def completionEquivOfMapEq {R : Type*} [CommRing R] (K : Ideal R)
    (U : Type*) [CommRing U] [Algebra R U] (L : Ideal U)
    (hKL : K.map (algebraMap R U) = L) :
    AdicCompletion K U ≃+ AdicCompletion L U where
  __ := Equiv.subtypeEquiv
    (Equiv.piCongrRight fun m => (Rig.quotientSmulTopEquiv K U L hKL m).toEquiv) fun v => by
      refine ⟨fun h m n hmn => ?_, fun h m n hmn => ?_⟩
      · change AdicCompletion.transitionMap L U hmn
          (Rig.quotientSmulTopEquiv K U L hKL n (v n)) = Rig.quotientSmulTopEquiv K U L hKL m (v m)
        rw [Rig.quotientSmulTopEquiv_transitionMap]
        exact congrArg (Rig.quotientSmulTopEquiv K U L hKL m) (h hmn)
      · change AdicCompletion.transitionMap K U hmn (v n) = v m
        apply (Rig.quotientSmulTopEquiv K U L hKL m).injective
        rw [← Rig.quotientSmulTopEquiv_transitionMap]
        exact h hmn
  map_add' x y := by
    apply Subtype.ext
    funext m
    exact (Rig.quotientSmulTopEquiv K U L hKL m).map_add (x.val m) (y.val m)

private theorem completionEquivOfMapEq_val {R : Type*} [CommRing R]
    (K : Ideal R) (U : Type*) [CommRing U] [Algebra R U] (L : Ideal U)
    (hKL : K.map (algebraMap R U) = L) (x : AdicCompletion K U) (m : ℕ) :
    (completionEquivOfMapEq K U L hKL x).val m =
      Rig.quotientSmulTopEquiv K U L hKL m (x.val m) := rfl

/-- The identification of the two completions is semilinear over the induced map of
completions of the base. -/
private theorem completionEquivOfMapEq_smul {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (K : Ideal R) (L : Ideal S)
    (h : K.map (algebraMap R S) = L)
    (a : AdicCompletion K R) (x : AdicCompletion K S) :
    completionEquivOfMapEq K S L h (a • x) =
      adicCompletionMap (algebraMap R S) K L h.le a * completionEquivOfMapEq K S L h x := by
  apply AdicCompletion.ext
  intro n
  change Rig.quotientSmulTopEquiv K S L h n (a.val n • x.val n) = _
  obtain ⟨r, hr⟩ := Submodule.Quotient.mk_surjective _ (a.val n)
  obtain ⟨s, hs⟩ := Submodule.Quotient.mk_surjective _ (x.val n)
  have ha : AdicCompletion.evalₐ K n a = Ideal.Quotient.mk (K ^ n) r := by
    change Ideal.quotientEquivAlgOfEq R (show K ^ n • (⊤ : Ideal R) = K ^ n by simp) (a.val n) = _
    rw [← hr]
    rfl
  rw [← hr, ← hs]
  change _ = (adicCompletionMap (algebraMap R S) K L h.le a).val n * _
  have hm : (adicCompletionMap (algebraMap R S) K L h.le a).val n =
      Submodule.Quotient.mk (algebraMap R S r) := by
    apply (Ideal.quotientEquivAlgOfEq S (show L ^ n * ⊤ = L ^ n by simp)).injective
    change AdicCompletion.evalₐ L n (adicCompletionMap (algebraMap R S) K L h.le a) =
        Ideal.Quotient.mk (L ^ n) (algebraMap R S r)
    rw [adicCompletionMap, AdicCompletion.evalₐ_liftRingHom, RingHom.comp_apply]
    change Ideal.quotientMap (L ^ n) (algebraMap R S) _ (AdicCompletion.evalₐ K n a) = _
    rw [ha, Ideal.quotientMap_mk]
  rw [hm, completionEquivOfMapEq_val, ← hs]
  change Rig.quotientSmulTopEquiv K S L h n (r • Submodule.Quotient.mk s) = _
  rw [map_smul]
  simp [Rig.quotientSmulTopEquiv, Algebra.smul_def]

/-- **Flatness is preserved by adic completion**: if `S` is a flat algebra over a Noetherian
ring `R` and `L` is the extension of `K`, then `R̂_K → Ŝ_L` is flat. -/
private theorem flat_adicCompletionMap {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    [IsNoetherianRing R] [Algebra R S] [Module.Flat R S]
    (K : Ideal R) (L : Ideal S) (h : K.map (algebraMap R S) = L) :
    (adicCompletionMap (algebraMap R S) K L h.le).Flat := by
  let : Algebra (AdicCompletion K R) (AdicCompletion L S) :=
    (adicCompletionMap (algebraMap R S) K L h.le).toAlgebra
  let e : AdicCompletion K S ≃ₗ[AdicCompletion K R] AdicCompletion L S :=
    { completionEquivOfMapEq K S L h with
      map_smul' := completionEquivOfMapEq_smul K L h }
  have hflat : Module.Flat (R ⧸ K) (S ⧸ K • (⊤ : Submodule R S)) := by
    have : Module.Flat (R ⧸ K) ((R ⧸ K) ⊗[R] S) := Module.Flat.baseChange R _ S
    let e₀ := TensorProduct.quotTensorEquivQuotSMul S K
    let e : ((R ⧸ K) ⊗[R] S) ≃ₗ[R ⧸ K] (S ⧸ K • (⊤ : Submodule R S)) :=
      { e₀ with
        map_smul' := by
          rintro ⟨r⟩ x
          exact e₀.map_smul r x }
    exact Module.Flat.of_linearEquiv e.symm
  have : Module.Flat (ULift.{v} R) (ULift.{u} S) :=
    Module.Flat.ulift_left_iff.mpr (Module.Flat.ulift_right_iff.mpr inferInstance)
  have htor := isZero_Tor_one_of_flat
    (ModuleCat.of (ULift.{v} R) (ULift.{u} S))
    (ModuleCat.of (ULift.{v} R) (ULift.{v} (R ⧸ K)))
  have := (AdicCompletion.isNoetherianRing_and_flat_of_flat_quotient
    K (Ideal.fg_of_isNoetherianRing _) inferInstance hflat htor).2
  exact Module.Flat.of_linearEquiv e.symm

/-- A ring map out of a completion along a finitely generated ideal is determined by its
restriction to the uncompleted ring, provided it is bounded and the target is separated. -/
private theorem ringHom_ext_of_completion {R S : Type*} [CommRing R] [CommRing S]
    (K : Ideal R) (hK : K.FG) (L : Ideal S) [IsHausdorff L S]
    (f g : AdicCompletion K R →+* S)
    (hfg : f.comp (algebraMap R (AdicCompletion K R)) =
      g.comp (algebraMap R (AdicCompletion K R)))
    (hf : K.map (f.comp (algebraMap R (AdicCompletion K R))) ≤ L) : f = g := by
  apply RingHom.ext
  apply congrFun (IsHausdorff.funext' L ?_)
  intro n x
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ K n x)
  have hx : x - algebraMap R (AdicCompletion K R) r ∈
      (K.map (algebraMap R (AdicCompletion K R))) ^ n := by
    rw [← AdicCompletion.ker_evalₐ K hK n, RingHom.mem_ker]
    simp [AdicCompletion.algebraMap_apply, hr]
  have hh (f : AdicCompletion K R →+* S)
      (hf : K.map (f.comp (algebraMap R (AdicCompletion K R))) ≤ L) :
      Ideal.Quotient.mk (L ^ n) (f x) =
        Ideal.Quotient.mk (L ^ n) (f (algebraMap R (AdicCompletion K R) r)) := by
    rw [Ideal.Quotient.eq]
    have hp : ((K.map (algebraMap R (AdicCompletion K R))) ^ n).map f ≤ L ^ n := by
      rw [Ideal.map_pow, Ideal.map_map]
      exact Ideal.pow_right_mono hf n
    simpa only [map_sub] using hp (Ideal.mem_map_of_mem f hx)
  rw [hh f hf, hh g (hfg ▸ hf)]
  exact congrArg (Ideal.Quotient.mk (L ^ n)) (DFunLike.congr_fun hfg r)

/-- Renaming the first block of variables of a polynomial ring is a flat ring map: it exhibits
the big ring as a polynomial ring over the small one. -/
private theorem flat_rename_castAdd {R : Type*} [CommRing R] (r s : ℕ) :
    (MvPolynomial.rename (R := R) (Fin.castAdd s : Fin r → Fin (r + s))).toRingHom.Flat := by
  let f := MvPolynomial.rename (R := R) (Fin.castAdd s : Fin r → Fin (r + s))
  let : Algebra (MvPolynomial (Fin r) R) (MvPolynomial (Fin (r + s)) R) := f.toRingHom.toAlgebra
  let e' := (finSumFinEquiv (m := r) (n := s)).symm.trans (Equiv.sumComm (Fin r) (Fin s))
  let E := (MvPolynomial.renameEquiv R e').trans (MvPolynomial.sumAlgEquiv R (Fin s) (Fin r))
  have hrename : (MvPolynomial.renameEquiv R e').toAlgHom.comp f =
      MvPolynomial.rename (R := R) (Sum.inr : Fin r → Fin s ⊕ Fin r) := by
    ext i
    simp [f, e']
  let E' : MvPolynomial (Fin (r + s)) R ≃ₐ[MvPolynomial (Fin r) R]
      MvPolynomial (Fin s) (MvPolynomial (Fin r) R) :=
    { E.toRingEquiv with
      commutes' := fun p => by
        change MvPolynomial.sumAlgEquiv R (Fin s) (Fin r)
          (MvPolynomial.renameEquiv R e' (f p)) = MvPolynomial.C p
        rw [show MvPolynomial.renameEquiv R e' (f p) =
          MvPolynomial.rename Sum.inr p from DFunLike.congr_fun hrename p]
        exact DFunLike.congr_fun (MvPolynomial.sumAlgEquiv_comp_rename_inr
          R (Fin s) (Fin r)) p }
  exact Module.Flat.of_linearEquiv E'.toLinearEquiv

/-- The induced map of completions sends the canonical image of `r` to that of `f r`. -/
private theorem adicCompletionMap_algebraMap {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (K : Ideal R) (L : Ideal S) (h : K.map f ≤ L) (r : R) :
    adicCompletionMap f K L h (algebraMap R (AdicCompletion K R) r) =
      algebraMap S (AdicCompletion L S) (f r) := by
  apply AdicCompletion.ext_evalₐ
  intro n
  rw [adicCompletionMap, AdicCompletion.evalₐ_liftRingHom, RingHom.comp_apply]
  change Ideal.quotientMap (L ^ n) f _ (AdicCompletion.evalₐ K n
    (AdicCompletion.of K R r)) = AdicCompletion.evalₐ L n (AdicCompletion.of L S (f r))
  rw [AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]

end Flatness

end CombinedRigSmooth

open CombinedRigSmooth

section FlatInclusion

universe u v

namespace CompletedPolynomialPresentation

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}
  {B : AdicFiniteTypeAlgebra.{u, v} A I} (P : CompletedPolynomialPresentation I B) (s : ℕ)

/-- **The inclusion `A⟨x⟩ → A⟨x, y⟩` of the inner variables is flat.**  It is the completion
of the flat map `A[x] → A[x, y]`, and adic completion of a Noetherian ring preserves
flatness. -/
private theorem flat_combinedInclusion : (P.combinedInclusion s).toRingHom.Flat := by
  let R := MvPolynomial (Fin P.variableCount) A
  let S := MvPolynomial (Fin (P.variableCount + s)) A
  let K : Ideal R := I.map (MvPolynomial.C : A →+* R)
  let L : Ideal S := I.map (algebraMap A S)
  let f : R →+* S := (MvPolynomial.rename (Fin.castAdd s)).toRingHom
  let : Algebra R S := f.toAlgebra
  have hf : Module.Flat R S := flat_rename_castAdd P.variableCount s
  have hKL : K.map (algebraMap R S) = L := by
    change (I.map (MvPolynomial.C : A →+* R)).map f = I.map (algebraMap A S)
    rw [Ideal.map_map, MvPolynomial.algebraMap_eq]
    congr 1
    apply RingHom.ext
    intro a
    exact MvPolynomial.rename_C _ _
  have hflat := flat_adicCompletionMap K L hKL
  change K.map f = L at hKL
  have hbase : (P.combinedInclusion s).toRingHom.comp (algebraMap R (AdicCompletion K R)) =
      (algebraMap S (AdicCompletion L S)).comp f := by
    apply RingHom.ext
    intro p
    exact P.combinedInclusion_algebraMap s p
  have hcomp : (adicCompletionMap f K L hKL.le).comp (algebraMap R (AdicCompletion K R)) =
      (algebraMap S (AdicCompletion L S)).comp f := by
    apply RingHom.ext
    intro r
    exact adicCompletionMap_algebraMap f K L hKL.le r
  have : IsHausdorff (L.map (algebraMap S (AdicCompletion L S))) (AdicCompletion L S) :=
    IsHausdorff.map_algebraMap_iff.mpr inferInstance
  have hle : K.map ((P.combinedInclusion s).toRingHom.comp
      (algebraMap R (AdicCompletion K R))) ≤ L.map (algebraMap S (AdicCompletion L S)) := by
    rw [hbase, Ideal.map_le_iff_le_comap]
    intro k hk
    have hfk : f k ∈ L := hKL ▸ Ideal.mem_map_of_mem f hk
    exact Ideal.mem_comap.mpr
      (Ideal.mem_map_of_mem (algebraMap S (AdicCompletion L S)) hfk)
  have heq : (P.combinedInclusion s).toRingHom = adicCompletionMap f K L hKL.le :=
    ringHom_ext_of_completion K (Ideal.fg_of_isNoetherianRing _)
      (L.map (algebraMap S (AdicCompletion L S)))
      (P.combinedInclusion s).toRingHom (adicCompletionMap f K L hKL.le)
      (hbase.trans hcomp.symm) hle
  rw [heq]
  exact hflat

end CompletedPolynomialPresentation

end FlatInclusion

/-! ## The kernel at the left end of the sequence of Stacks 0ALM -/

section RigSmooth

universe u v

namespace CompletedPolynomialPresentation

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}
  {B : AdicFiniteTypeAlgebra.{u, v} A I} (P : CompletedPolynomialPresentation I B) (s : ℕ)
  {C : AdicFiniteTypeAlgebra.{u, v} A I} [Algebra B.carrier C.carrier]
  [IsScalarTower A B.carrier C.carrier]
  (ψ : AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s) →ₐ[B.carrier] C.carrier)
  (hψ : Function.Surjective (ψ.restrictScalars A))

/-- **Stacks Project, Tag 0GH2.**  Let `A → B → C` be morphisms of (0AL4), so that `B` and `C`
are adic and topologically of finite type over `A`, and suppose `B → C` is rig-smooth, i.e. `C`
is rig-smooth over `(B, I B)` (Stacks 0GAI, 0GCJ).  Then the kernel of the first map
`H⁻¹(NL^∧_{B/A} ⊗_B C) → H⁻¹(NL^∧_{C/A})` of the six-term sequence of Stacks 0ALM is annihilated
by a power of the ideal of definition `I C`.

The presentations are the given ones: `P` of `B` over `A`, the presentation `ψ` of `C` over
`B`, and the combined presentation of `C` over `A` they define. -/
@[stacks 0GH2]
public theorem exists_pow_adicIdeal_le_annihilator_ker_onH₁_chainMapInl
    (KB : CompletedNaiveCotangentComplex P)
    (KC : CompletedNaiveCotangentComplex
      (P.combinedPresentation s (ψ.restrictScalars A) hψ))
    (hBC : IsRigSmooth (AdicFiniteTypeAlgebra.overBase (B := B) (C := C))) :
    ∃ n : ℕ, C.adicIdeal ^ n ≤ Module.annihilator C.carrier
      (LinearMap.ker (NaiveCotangent.chainMapInl _
        (P.combinedDifferential_comp_innerCotangentMap s ψ hψ KB KC)).onH₁) := by
  -- Stacks 0GH1 for the presentation `ψ` of `C` over `B`
  have hreg : ∀ (q : Ideal (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s)))
      [q.IsPrime],
      ¬ B.adicIdeal.map (algebraMap B.carrier
          (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s))) ≤ q →
      RingHom.ker ψ.toRingHom ≤ q →
      ∃ g : List (Localization.AtPrime q),
        RingTheory.Sequence.IsRegular (Localization.AtPrime q) g ∧
          Ideal.ofList g = (RingHom.ker ψ.toRingHom).map
            (algebraMap (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s))
              (Localization.AtPrime q)) := by
    intro q hqprime hq hJq
    have := hqprime
    let : TopologicalSpace B.carrier := B.adicIdeal.adicTopology
    let : IsTopologicalRing B.carrier := B.adicIdeal.nonarchimedean.toIsTopologicalRing
    let : IsLinearTopology B.carrier B.carrier := B.adicIdeal.isLinearTopology
    have hBadic : _root_.IsAdic B.adicIdeal := rfl
    have hw := TopologicalRing.isWeaklyAdmissible_of_isAdic hBadic B.isAdicallyComplete
    have hBA : TopologicalRing.IsAdic B.carrier :=
      ⟨⟨_, (isIdealOfDefinition_iff_isAdic ⟨_, hBadic⟩ _).2 hBadic, hBadic⟩, hw.2.2, hw.2.1⟩
    let P' : CompletedPolynomialPresentation B.adicIdeal
        (AdicFiniteTypeAlgebra.overBase (B := B) (C := C)) :=
      { variableCount := s
        ideal := RingHom.ker ψ.toRingHom
        quotientEquiv := Ideal.quotientKerAlgEquivOfSurjective hψ }
    exact @exists_isRegular_ofList_eq_map_presentationIdeal _ _ _ _ _ _ hBA _ hBadic _ hBC P' q
      hqprime hq hJq
  classical
  set Q := P.combinedPresentation s (ψ.restrictScalars A) hψ with hQdef
  let fhom := P.innerExtensionHom s ψ hψ
  let : Algebra P.extension.Ring Q.extension.Ring :=
    (P.combinedInclusion s).toRingHom.toAlgebra
  have hflat : Module.Flat P.extension.Ring Q.extension.Ring := P.flat_combinedInclusion s
  have hPnoeth : IsNoetherianRing P.extension.Ring := AdicCompletion.isNoetherianRing _
  have hQnoeth : IsNoetherianRing Q.extension.Ring := AdicCompletion.isNoetherianRing _
  have hCnoeth : IsNoetherianRing C.carrier :=
    isNoetherianRing_of_surjective Q.completedPolynomialRing C.carrier
      Q.toAlgHom.toRingHom Q.toAlgHom_surjective
  have hfinP : Module.Finite B.carrier P.extension.Cotangent :=
    Algebra.Extension.Cotangent.finite (Ideal.fg_of_isNoetherianRing _)
  have hfinT : Module.Finite C.carrier (C.carrier ⊗[B.carrier] P.extension.Cotangent) :=
    Module.Finite.base_change B.carrier C.carrier P.extension.Cotangent
  have hNoethT : IsNoetherian C.carrier (C.carrier ⊗[B.carrier] P.extension.Cotangent) :=
    isNoetherian_of_isNoetherianRing_of_finite _ _
  have hfinKer : Module.Finite C.carrier
      (LinearMap.ker ((Algebra.Extension.Cotangent.map fhom).liftBaseChange C.carrier)) :=
    Module.Finite.of_injective
      (LinearMap.ker ((Algebra.Extension.Cotangent.map fhom).liftBaseChange C.carrier)).subtype
      (Submodule.subtype_injective _)
  have hkerφ : RingHom.ker (P.combinedProjection s).toRingHom =
      P.extension.ker.map fhom.toRingHom := by
    rw [show Algebra.Extension.ker P.extension = P.ideal from P.ker_eq_ideal]
    exact P.ker_combinedProjection s
  have hQkerEq : Algebra.Extension.ker Q.extension =
      Ideal.comap (P.combinedProjection s).toRingHom (RingHom.ker ψ.toRingHom) :=
    P.ker_combinedPresentation s (ψ.restrictScalars A) hψ
  have hkey : ∀ p : Ideal C.carrier, p.IsPrime → ¬ C.adicIdeal ≤ p →
      ∀ i : AdicCompletion.completedMvPolynomial I (Fin (P.variableCount + s)),
        i ∈ RingHom.ker (P.combinedProjection s).toRingHom →
        i ∈ (Ideal.comap (P.combinedProjection s).toRingHom (RingHom.ker ψ.toRingHom)) ^ 2 →
        ∃ t : AdicCompletion.completedMvPolynomial I (Fin (P.variableCount + s)),
          ψ (P.combinedProjection s t) ∉ p ∧
            t * i ∈ RingHom.ker (P.combinedProjection s).toRingHom *
              Ideal.comap (P.combinedProjection s).toRingHom (RingHom.ker ψ.toRingHom) := by
    intro p hp hpdef i hi hiSq
    have := hp
    set φ := (P.combinedProjection s).toRingHom with hφdef
    set Kbig := Ideal.comap φ (RingHom.ker ψ.toRingHom) with hKbigdef
    have hφ : Function.Surjective φ := P.combinedProjection_surjective s
    have hle : RingHom.ker φ ≤ Kbig := Ideal.ker_le_comap φ
    let p' : Ideal (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s)) :=
      p.comap ψ.toRingHom
    have hp' : p'.IsPrime := Ideal.comap_isPrime _ p
    have hpdef' : ¬ B.adicIdeal.map (algebraMap B.carrier
        (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s))) ≤ p' := by
      intro h
      refine hpdef ?_
      rw [← AdicFiniteTypeAlgebra.map_adicIdeal_tower (A := A) (B := B) (C := C),
        Ideal.map_le_iff_le_comap]
      intro b hb
      have hh := h (Ideal.mem_map_of_mem (algebraMap B.carrier
        (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s))) hb)
      change ψ.toRingHom (algebraMap B.carrier
        (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s)) b) ∈ p at hh
      have hcom : ψ.toRingHom (algebraMap B.carrier
          (AdicCompletion.completedMvPolynomial B.adicIdeal (Fin s)) b) =
          algebraMap B.carrier C.carrier b := ψ.commutes b
      exact Ideal.mem_comap.mpr (hcom ▸ hh)
    have hJp' : RingHom.ker ψ.toRingHom ≤ p' := Ideal.ker_le_comap ψ.toRingHom
    obtain ⟨g, hg, hgspan⟩ := hreg p' hpdef' hJp'
    have hmap : Kbig.map φ = RingHom.ker ψ.toRingHom :=
      Ideal.map_comap_of_surjective φ hφ _
    have hinter := localized_inf_sq_eq_mul_of_isRegular φ hφ Kbig hle p' g hg
      (by rw [hmap]; exact hgspan)
    let q : Ideal (AdicCompletion.completedMvPolynomial I (Fin (P.variableCount + s))) :=
      p'.comap φ
    have hq : q.IsPrime := Ideal.comap_isPrime _ p'
    let α : AdicCompletion.completedMvPolynomial I (Fin (P.variableCount + s)) →+*
      Localization.AtPrime q := algebraMap _ _
    have hiLocal : α i ∈ (RingHom.ker φ).map α ⊓ (Kbig.map α) ^ 2 := by
      refine ⟨Ideal.mem_map_of_mem α hi, ?_⟩
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem α hiSq
    have hiMul : α i ∈ ((RingHom.ker φ) * Kbig).map α := by
      rw [hinter] at hiLocal
      rwa [Ideal.map_mul]
    obtain ⟨t, ht, hti⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
      q.primeCompl (Localization.AtPrime q) _ i).mp hiMul
    exact ⟨t, ht, hti⟩
  have hsq : ∀ p : Ideal C.carrier, p.IsPrime → ¬ C.adicIdeal ≤ p →
      ∀ i : Q.extension.Ring, i ∈ P.extension.ker.map fhom.toRingHom →
        i ∈ Q.extension.ker ^ 2 →
        ∃ t : Q.extension.Ring, algebraMap Q.extension.Ring C.carrier t ∉ p ∧
          t * i ∈ P.extension.ker.map fhom.toRingHom * Q.extension.ker := by
    intro p hp hpdef i hi hiSq
    rw [← hkerφ] at hi
    rw [hQkerEq] at hiSq
    obtain ⟨t, ht, hti⟩ := hkey p hp hpdef i hi hiSq
    have hval : algebraMap Q.extension.Ring C.carrier t = ψ (P.combinedProjection s t) :=
      congrArg (fun h : Q.completedPolynomialRing →ₐ[A] C.carrier => h t)
        (P.combinedPresentation_toAlgHom s ψ hψ)
    refine ⟨t, ?_, ?_⟩
    · rw [hval]
      exact ht
    · rw [← hkerφ, hQkerEq]
      exact hti
  have hpow : ∃ n : ℕ, C.adicIdeal ^ n ≤ Module.annihilator C.carrier
      (LinearMap.ker ((Algebra.Extension.Cotangent.map fhom).liftBaseChange C.carrier)) := by
    apply exists_pow_le_annihilator_of_localization_subsingleton
      (M := LinearMap.ker ((Algebra.Extension.Cotangent.map fhom).liftBaseChange C.carrier))
      C.adicIdeal (Ideal.fg_of_isNoetherianRing _)
    intro p hp
    rw [LocalizedModule.subsingleton_iff]
    intro x
    obtain ⟨t, ht, htx⟩ := exists_smul_eq_zero_of_mem_ker_cotangentMap P.extension Q.extension
      fhom rfl p.asIdeal (hsq p.asIdeal p.isPrime hp) x.val x.property
    exact ⟨t, ht, Subtype.ext htx⟩
  obtain ⟨n, hn⟩ := hpow
  exact ⟨n, hn.trans (annihilator_ker_le_annihilator_ker_restrict _ _)⟩

end CompletedPolynomialPresentation

end RigSmooth

end Rig

