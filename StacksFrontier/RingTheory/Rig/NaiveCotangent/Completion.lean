module

public import Mathlib.RingTheory.AdicCompletion.AsTensorProduct
public import Mathlib.RingTheory.AdicCompletion.Exactness
import StacksFrontier.RingTheory.AdicCompletion.SmulTopPow
public import StacksFrontier.RingTheory.Rig.FiniteTypeCompletions
public import StacksFrontier.RingTheory.Rig.NaiveCotangent
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.BaseChangeComparison

/-!
# The completed naive cotangent complex of the completion of a finite type algebra

Let `A` be a Noetherian ring, let `I ⊆ A` be an ideal and let `A → B` be of finite type.
A presentation `α : A[x₁, …, xₙ] → B` with kernel `J` completes to a presentation
`α^ : A[x₁, …, xₙ]^ → B^` of the `I`-adic completion `B^`, whose kernel is the ideal
`J^ = J · A[x₁, …, xₙ]^`, and the naive cotangent complex of `α^` is the base change of that
of `α` to `B^`.

## Main definitions

* `Rig.adicCompletionObj` — the completion `B^` as an object of `Rig.AdicFiniteTypeAlgebra A I`.
* `Rig.completedPresentationMap` — the completion `α^ : A[x₁, …, xₙ]^ → B^` of `α`.
* `Rig.completedPresentation` — the resulting presentation of `B^` as a quotient of the
  completed polynomial algebra, in the variables of `α` and by the ideal `J^`.
* `Rig.adicCompletionIdealEquiv` — the identification `R^ ⊗_R J = J · R^` for an ideal `J` of a
  Noetherian ring.
* `Rig.presentationDifferential` — the differential `J / J² → ⨁ᵢ B dxᵢ` of `NL(α)`, written in
  the canonical basis of the degree-`0` term.
* `Rig.completionComparison` — the comparison of complexes
  `NL(α) ⊗_B B^ → NL^∧_{B^/A}`.

## Main results

* `Rig.surjective_completedPresentationMap` and `Rig.ker_completedPresentationMap` — `α^` is
  surjective with kernel `J^`, so `B^ = A[x₁, …, xₙ]^ / J^`.
* `Rig.differential_conormalComparison` — the comparison of complexes commutes with the two
  differentials: both send the class of `g ∈ J` to the tuple of the images of `∂g/∂xᵢ`.
* `Rig.bijective_completionComparison_f₀` — the comparison is bijective in degree `0`, both
  terms being free on `dx₁, …, dxₙ`.
* `Rig.bijective_completionComparison_f₁` — the comparison is bijective in degree `1`, that is
  `B^ ⊗_B (J / J²) = J^ / (J^)²`.
* `Rig.bijective_completionComparison` — **Stacks 0GAF, first clause**: the comparison is an
  isomorphism of complexes, so `NL^∧_{B^/A} = NL(α) ⊗_B B^`.

## Implementation notes

Two adic completions of `B` are in play and they are not definitionally the same object: the
completion of `B` as a module over `A[x₁, …, xₙ]` along `I · A[x₁, …, xₙ]`, which is what
Mathlib's exactness results speak about, and the completion of the ring `B` along `I · B`,
which is what the category of Stacks 0AL4 uses. The two filtrations of `B` coincide, and
`Rig.adicCompletionRestrictScalarsEquiv` is the resulting identification.

## References

* [Stacks Project, Lemma 88.3.2 (Tag 0GAF)](https://stacks.math.columbia.edu/tag/0GAF)
* [Stacks Project, Lemma 10.97.1 (Tag 00MA)](https://stacks.math.columbia.edu/tag/00MA)
* [Stacks Project, Lemma 10.97.2 (Tag 00MB)](https://stacks.math.columbia.edu/tag/00MB)
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u v w t

namespace Rig

/-! ## Comparing the module and the ring adic completion of an algebra -/

section RestrictScalars

variable {R : Type*} [CommRing R] (K : Ideal R) (U : Type*) [CommRing U] [Algebra R U]
  (L : Ideal U) (hKL : K.map (algebraMap R U) = L)

include hKL in
/-- The `K`-adic filtration of `U` as an `R`-module is the `L`-adic filtration of the ring `U`,
when `L` is the ideal generated by `K`. -/
public theorem smul_top_pow_eq_restrictScalars (m : ℕ) :
    K ^ m • (⊤ : Submodule R U) = (L ^ m • (⊤ : Ideal U)).restrictScalars R :=
  smul_top_pow_eq_restrictScalars_module K U U hKL.symm m

include hKL in
/-- Level `m` of the identification of the two adic filtrations of `U`. -/
public def quotientSmulTopEquiv (m : ℕ) :
    (U ⧸ K ^ m • (⊤ : Submodule R U)) ≃ₗ[R] U ⧸ L ^ m • (⊤ : Ideal U) :=
  quotEquivMapPowModule K U U hKL.symm m

include hKL in
/-- The level identifications commute with the transition maps of the two adic systems. -/
public theorem quotientSmulTopEquiv_transitionMap {m n : ℕ} (hmn : m ≤ n)
    (x : U ⧸ K ^ n • (⊤ : Submodule R U)) :
    AdicCompletion.transitionMap L U hmn (quotientSmulTopEquiv K U L hKL n x) =
      quotientSmulTopEquiv K U L hKL m (AdicCompletion.transitionMap K U hmn x) := by
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rfl

include hKL in
/-- **The two adic completions of an algebra agree.** The completion of `U` as an `R`-module
along `K` is the completion of the ring `U` along the ideal `L` generated by `K`. -/
public def adicCompletionRestrictScalarsEquiv :
    AdicCompletion K U ≃+ AdicCompletion L U where
  __ := Equiv.subtypeEquiv
    (Equiv.piCongrRight fun m => (quotientSmulTopEquiv K U L hKL m).toEquiv) fun v => by
      refine ⟨fun h m n hmn => ?_, fun h m n hmn => ?_⟩
      · change AdicCompletion.transitionMap L U hmn
          (quotientSmulTopEquiv K U L hKL n (v n)) =
            quotientSmulTopEquiv K U L hKL m (v m)
        rw [quotientSmulTopEquiv_transitionMap]
        exact congrArg (quotientSmulTopEquiv K U L hKL m) (h hmn)
      · change AdicCompletion.transitionMap K U hmn (v n) = v m
        apply (quotientSmulTopEquiv K U L hKL m).injective
        rw [← quotientSmulTopEquiv_transitionMap]
        exact h hmn
  map_add' x y :=
    Subtype.ext <| funext fun m => (quotientSmulTopEquiv K U L hKL m).map_add (x.val m) (y.val m)

include hKL in
/-- At level `m`, the identification of the two adic completions is `quotientSmulTopEquiv`. -/
@[simp] public theorem adicCompletionRestrictScalarsEquiv_val
    (x : AdicCompletion K U) (m : ℕ) :
    (adicCompletionRestrictScalarsEquiv K U L hKL x).val m =
      quotientSmulTopEquiv K U L hKL m (x.val m) := rfl

end RestrictScalars

/-! ## Exactness of adic completion on finite presentations -/

section Exactness

/-- **Adic completion is exact on finite modules over a Noetherian ring**, in the form needed
for a presentation: the completion of a short exact sequence `0 → M → N → Q → 0` with `N`
finite is exact at the middle term, with `Q` in any universe. -/
public theorem map_exact_of_surjective {R M N : Type w} {Q : Type t}
    [CommRing R] [IsNoetherianRing R] (K : Ideal R)
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module.Finite R N]
    [AddCommGroup Q] [Module R Q] {f : M →ₗ[R] N} {g : N →ₗ[R] Q}
    (hf : Function.Injective f) (hfg : Function.Exact f g) (hg : Function.Surjective g) :
    Function.Exact (AdicCompletion.map K f) (AdicCompletion.map K g) := by
  have he : (g.quotKerEquivOfSurjective hg).toLinearMap.comp (LinearMap.ker g).mkQ = g := by
    ext; rfl
  have hq : Function.Exact f (LinearMap.ker g).mkQ := by
    intro x
    simpa only [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      LinearMap.mem_ker] using hfg x
  have h := AdicCompletion.map_exact hf hq (LinearMap.ker g).mkQ_surjective (I := K)
  intro x
  rw [← he, ← AdicCompletion.map_comp, LinearMap.comp_apply]
  change AdicCompletion.congr K (g.quotKerEquivOfSurjective hg)
    (AdicCompletion.map K (LinearMap.ker g).mkQ x) = 0 ↔ _
  rw [map_eq_zero_iff _ (AdicCompletion.congr K (g.quotKerEquivOfSurjective hg)).injective]
  exact h x

/-- **The completion of an ideal is the ideal it generates in the completion.** For an ideal
`J` of a Noetherian ring `R`, the image of the `K`-adic completion of the inclusion
`J → R` is `J · R^`. -/
public theorem range_map_subtype_eq_map_ideal {R : Type*} [CommRing R] [IsNoetherianRing R]
    (K J : Ideal R) :
    LinearMap.range (AdicCompletion.map K J.subtype) =
      J.map (algebraMap R (AdicCompletion K R)) := by
  classical
  have hJ : Module.Finite R (J : Submodule R R) :=
    Module.Finite.iff_fg.mpr (IsNoetherian.noetherian J)
  have hJbij : Function.Bijective (AdicCompletion.ofTensorProduct K (J : Submodule R R)) :=
    AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian K J
  have hJrange : LinearMap.range (AdicCompletion.ofTensorProduct K (J : Submodule R R)) = ⊤ :=
    LinearMap.range_eq_top_of_surjective _ hJbij.2
  have hnat := AdicCompletion.ofTensorProduct_naturality K J.subtype
  let t : AdicCompletion K R ⊗[R] J →ₗ[AdicCompletion K R] AdicCompletion K R ⊗[R] R :=
    TensorProduct.AlgebraTensorModule.map
      (LinearMap.id : AdicCompletion K R →ₗ[AdicCompletion K R] AdicCompletion K R) J.subtype
  have hrange := LinearMap.range_comp_of_range_eq_top
    (AdicCompletion.map K J.subtype) hJrange
  refine le_antisymm (fun x hx => ?_) (fun x hx => ?_)
  · have hx' : x ∈ LinearMap.range (AdicCompletion.map K J.subtype ∘ₗ
        AdicCompletion.ofTensorProduct K (J : Submodule R R)) := by rw [hrange]; exact hx
    obtain ⟨z, rfl⟩ := hx'
    have hmem (z : AdicCompletion K R ⊗[R] J) :
        AdicCompletion.ofTensorProduct K R (t z) ∈ J.map (algebraMap R (AdicCompletion K R)) := by
      induction z using TensorProduct.inductionOn with
      | add z z' hz hz' => rw [map_add, map_add]; exact add_mem hz hz'
      | tmul s j =>
        change AdicCompletion.ofTensorProduct K R (s ⊗ₜ[R] (j : R)) ∈ _
        rw [AdicCompletion.ofTensorProduct_tmul]
        have h_of : AdicCompletion.of K R (j : R) = algebraMap R (AdicCompletion K R) (j : R) := by
          simp [AdicCompletion.algebraMap_apply]
        rw [h_of]
        change s * algebraMap R (AdicCompletion K R) (j : R) ∈ _
        exact Ideal.mul_mem_left _ s (Ideal.mem_map_of_mem _ j.property)
    rw [congrFun (congrArg DFunLike.coe hnat) z]
    exact hmem z
  · rw [Ideal.map, ← Ideal.submodule_span_eq] at hx
    induction hx using Submodule.span_induction with
    | mem _ hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      exact ⟨AdicCompletion.of K J ⟨j, hj⟩, by simp [AdicCompletion.map_of,
        AdicCompletion.algebraMap_apply]⟩
    | zero => exact zero_mem _
    | add _ _ _ _ hy hz => exact add_mem hy hz
    | smul _ _ _ hy => exact Submodule.smul_mem _ _ hy

/-- **The base change of an ideal to the completion is the ideal it generates.** For an ideal
`J` of a Noetherian ring `R`, the canonical map `R^ ⊗_R J → J · R^` is an isomorphism. -/
public def adicCompletionIdealEquiv {R : Type*} [CommRing R] [IsNoetherianRing R]
    (K J : Ideal R) :
    AdicCompletion K R ⊗[R] J ≃ₗ[AdicCompletion K R]
      J.map (algebraMap R (AdicCompletion K R)) := by
  have ht : Function.Injective ((AdicCompletion.map K J.subtype).comp
      (AdicCompletion.ofTensorProduct K J)) :=
    (AdicCompletion.map_injective K (Submodule.injective_subtype J)).comp
      (AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian K J).1
  have hr : LinearMap.range ((AdicCompletion.map K J.subtype).comp
      (AdicCompletion.ofTensorProduct K J)) = J.map (algebraMap R (AdicCompletion K R)) := by
    rw [LinearMap.range_comp_of_range_eq_top _
      (LinearMap.range_eq_top.mpr
        (AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian K J).2)]
    exact range_map_subtype_eq_map_ideal K J
  exact (LinearEquiv.ofInjective _ ht).trans (LinearEquiv.ofEq _ _ hr)

/-- On a pure tensor the identification of `R^ ⊗_R J` with `J · R^` is `s ⊗ j ↦ s · j`. -/
public theorem adicCompletionIdealEquiv_tmul {R : Type*} [CommRing R] [IsNoetherianRing R]
    (K J : Ideal R) (s : AdicCompletion K R) (j : J) :
    (adicCompletionIdealEquiv K J (s ⊗ₜ j)).val =
      s * algebraMap R (AdicCompletion K R) j.val := by
  change AdicCompletion.map K J.subtype (AdicCompletion.ofTensorProduct K J (s ⊗ₜ j)) = _
  rw [AdicCompletion.ofTensorProduct_tmul, map_smul, AdicCompletion.map_of]
  rfl

end Exactness

/-! ## The completion of a presentation -/

section CompletedPresentation

variable {A : Type u} [CommRing A] [IsNoetherianRing A] (I : Ideal A)
  {B : Type v} [CommRing B] [Algebra A B]

/-- `I · A[x₁, …, xₙ]`, the ideal generated by `I` in the polynomial ring. -/
public abbrev polynomialAdicIdeal (n : ℕ) : Ideal (MvPolynomial (Fin n) A) :=
  I.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A)

/-- `A[x₁, …, xₙ]^`, the `I`-adic completion of the polynomial ring. -/
public abbrev adicCompletionMvPolynomial (n : ℕ) : Type u :=
  AdicCompletion (polynomialAdicIdeal I n) (MvPolynomial (Fin n) A)

/-- `B^`, the completion of `B` along the ideal generated by `I`. -/
public abbrev adicCompletionAlgebra : Type v := AdicCompletion (I.map (algebraMap A B)) B

variable {n : ℕ}

omit [IsNoetherianRing A] in
/-- A presentation `α : A[x₁, …, xₙ] → B` carries `I · A[x₁, …, xₙ]` onto `I · B`. -/
public theorem map_polynomialAdicIdeal (α : MvPolynomial (Fin n) A →ₐ[A] B) :
    (polynomialAdicIdeal I n).map α.toRingHom = I.map (algebraMap A B) := by
  rw [polynomialAdicIdeal, Ideal.map_map]
  have hcomp : α.toRingHom.comp (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) =
      algebraMap A B := RingHom.ext fun a => α.commutes a
  rw [hcomp]

omit [IsNoetherianRing A] in
/-- The completion `α^ : A[x₁, …, xₙ]^ → B^` of a presentation `α : A[x₁, …, xₙ] → B`: the map
of adic completions induced by `α`. -/
public def completedPresentationMap (α : MvPolynomial (Fin n) A →ₐ[A] B) :
    adicCompletionMvPolynomial I n →ₐ[A] adicCompletionAlgebra I (B := B) where
  __ := completionMap (polynomialAdicIdeal I n) (I.map (algebraMap A B)) α.toRingHom
    (le_of_eq (map_polynomialAdicIdeal I α))
  commutes' a := by
    refine AdicCompletion.ext_evalₐ fun k => ?_
    change AdicCompletion.evalₐ (I.map (algebraMap A B)) k
      (completionMap (polynomialAdicIdeal I n) (I.map (algebraMap A B)) α.toRingHom
        (le_of_eq (map_polynomialAdicIdeal I α))
        (algebraMap (MvPolynomial (Fin n) A) (adicCompletionMvPolynomial I n)
          (algebraMap A (MvPolynomial (Fin n) A) a))) = _
    rw [AdicCompletion.algebraMap_apply, completionMap_of, AdicCompletion.evalₐ_of,
      AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
    exact congrArg (Ideal.Quotient.mk _) (α.commutes a)

omit [IsNoetherianRing A] in
/-- `α^` is the map of adic completions induced by `α`. -/
@[simp] public theorem completedPresentationMap_apply (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (x : adicCompletionMvPolynomial I n) :
    completedPresentationMap I α x =
      completionMap (polynomialAdicIdeal I n) (I.map (algebraMap A B)) α.toRingHom
        (le_of_eq (map_polynomialAdicIdeal I α)) x := rfl

omit [IsNoetherianRing A] in
/-- The completion of `α` extends `α` along the two completion maps. -/
public theorem completedPresentationMap_algebraMap (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (f : MvPolynomial (Fin n) A) :
    completedPresentationMap I α
        (algebraMap (MvPolynomial (Fin n) A) (adicCompletionMvPolynomial I n) f) =
      algebraMap B (adicCompletionAlgebra I (B := B)) (α f) := by
  change completionMap (polynomialAdicIdeal I n) (I.map (algebraMap A B)) α.toRingHom
      (le_of_eq (map_polynomialAdicIdeal I α)) (AdicCompletion.of _ _ f) =
    AdicCompletion.of _ _ (α f)
  exact completionMap_of _ _ _ _ f

/-- An element of the ring adic completion with `k`-th component the class of `p` has image
`p` in `R ⧸ K ^ k`. -/
private theorem evalₐ_eq_mk_of_val_eq {R : Type*} [CommRing R] (K : Ideal R) (k : ℕ)
    (x : AdicCompletion K R) (p : R) (hp : Submodule.Quotient.mk p = x.val k) :
    AdicCompletion.evalₐ K k x = Ideal.Quotient.mk (K ^ k) p := by
  have h : K ^ k • (⊤ : Ideal R) = K ^ k := by rw [Ideal.smul_eq_mul, Ideal.mul_top]
  change Ideal.quotientEquivAlgOfEq R h (AdicCompletion.eval K _ k x) = _
  rw [← Ideal.quotientEquivAlgOfEq_mk (R₁ := R) h p, AdicCompletion.eval_apply, ← hp]
  rfl

omit [IsNoetherianRing A] in
/-- The completion of `α` read through the completion of `B` as a module over the polynomial
ring: it is the module-theoretic completion of `α`, followed by the identification of the two
adic completions of `B`. -/
private theorem completedPresentationMap_eq_map (α : MvPolynomial (Fin n) A →ₐ[A] B)
    [Algebra (MvPolynomial (Fin n) A) B]
    (halg : ∀ p, algebraMap (MvPolynomial (Fin n) A) B p = α p)
    (hKL : (polynomialAdicIdeal I n).map (algebraMap (MvPolynomial (Fin n) A) B) =
      I.map (algebraMap A B))
    (x : adicCompletionMvPolynomial I n) :
    completedPresentationMap I α x =
      adicCompletionRestrictScalarsEquiv (polynomialAdicIdeal I n) B
        (I.map (algebraMap A B)) hKL
        (AdicCompletion.map (polynomialAdicIdeal I n)
          (Algebra.linearMap (MvPolynomial (Fin n) A) B) x) := by
  refine AdicCompletion.ext_evalₐ fun k => ?_
  obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _ (x.val k)
  have hEval := evalₐ_eq_mk_of_val_eq (polynomialAdicIdeal I n) k x p hp
  have hlhs : AdicCompletion.evalₐ (I.map (algebraMap A B)) k
      (completedPresentationMap I α x) =
      Ideal.Quotient.mk (I.map (algebraMap A B) ^ k) (α p) := by
    rw [completedPresentationMap_apply, completionMap_eval]
    change Ideal.quotientMap (I.map (algebraMap A B) ^ k) α.toRingHom
      (idealMapPow_le (polynomialAdicIdeal I n) (I.map (algebraMap A B)) α.toRingHom
        (le_of_eq (map_polynomialAdicIdeal I α)) k)
      (AdicCompletion.evalₐ (polynomialAdicIdeal I n) k x) = _
    rw [hEval, Ideal.quotientMap_mk]
    rfl
  have hrhs : AdicCompletion.evalₐ (I.map (algebraMap A B)) k
      (adicCompletionRestrictScalarsEquiv (polynomialAdicIdeal I n) B
        (I.map (algebraMap A B)) hKL
        (AdicCompletion.map (polynomialAdicIdeal I n)
          (Algebra.linearMap (MvPolynomial (Fin n) A) B) x)) =
      Ideal.Quotient.mk (I.map (algebraMap A B) ^ k) (α p) := by
    refine evalₐ_eq_mk_of_val_eq _ k _ _ ?_
    rw [adicCompletionRestrictScalarsEquiv_val, AdicCompletion.map_val_apply, ← hp]
    simp only [LinearMap.reduceModIdeal_apply]
    change _ = quotientSmulTopEquiv (polynomialAdicIdeal I n) B (I.map (algebraMap A B)) hKL k
      (Submodule.Quotient.mk (algebraMap (MvPolynomial (Fin n) A) B p))
    rw [halg p]
    rfl
  rw [hlhs, hrhs]

/-- **Stacks 0GAF.** The completion `α^ : A[x₁, …, xₙ]^ → B^` of a presentation
`α : A[x₁, …, xₙ] → B` is surjective and its kernel is the ideal generated by `J = ker α`; in
other words `B^ = A[x₁, …, xₙ]^ / J^`. -/
private theorem surjective_and_ker_completedPresentationMap
    (α : MvPolynomial (Fin n) A →ₐ[A] B) (hα : Function.Surjective α) :
    Function.Surjective (completedPresentationMap I α) ∧
      RingHom.ker (completedPresentationMap I α).toRingHom =
        (RingHom.ker α.toRingHom).map
          (algebraMap (MvPolynomial (Fin n) A) (adicCompletionMvPolynomial I n)) := by
  let _ : Algebra (MvPolynomial (Fin n) A) B := α.toRingHom.toAlgebra
  have halg : ∀ p, algebraMap (MvPolynomial (Fin n) A) B p = α p := fun _ => rfl
  have hKL : (polynomialAdicIdeal I n).map (algebraMap (MvPolynomial (Fin n) A) B) =
      I.map (algebraMap A B) := map_polynomialAdicIdeal I α
  set J : Ideal (MvPolynomial (Fin n) A) := RingHom.ker α.toRingHom with hJdef
  set g : MvPolynomial (Fin n) A →ₗ[MvPolynomial (Fin n) A] B :=
    Algebra.linearMap (MvPolynomial (Fin n) A) B with hgdef
  have hg : Function.Surjective g := hα
  have hfg : Function.Exact (J.subtype : ↥J →ₗ[MvPolynomial (Fin n) A] _) g :=
    LinearMap.exact_subtype_ker_map g
  have hExact := map_exact_of_surjective (polynomialAdicIdeal I n)
    (Submodule.injective_subtype J) hfg hg
  have hRange := range_map_subtype_eq_map_ideal (polynomialAdicIdeal I n) J
  have hψ := completedPresentationMap_eq_map I α halg hKL
  refine ⟨?_, ?_⟩
  · intro b
    obtain ⟨c, hc⟩ :=
      (adicCompletionRestrictScalarsEquiv (polynomialAdicIdeal I n) B _ hKL).surjective b
    obtain ⟨x, hx⟩ := AdicCompletion.map_surjective (polynomialAdicIdeal I n) hg c
    exact ⟨x, by rw [hψ, hx, hc]⟩
  · refine le_antisymm (fun x hx => ?_) (fun x hx => ?_)
    · rw [RingHom.mem_ker] at hx
      have hz : AdicCompletion.map (polynomialAdicIdeal I n) g x = 0 :=
        (adicCompletionRestrictScalarsEquiv (polynomialAdicIdeal I n) B _ hKL).injective <| by
          rwa [map_zero, ← hψ]
      rw [← hRange]
      exact (hExact x).mp hz
    · rw [← hRange] at hx
      obtain ⟨y, rfl⟩ := hx
      rw [RingHom.mem_ker]
      change completedPresentationMap I α _ = 0
      rw [hψ, AdicCompletion.map_comp_apply, hfg.linearMap_comp_eq_zero,
        AdicCompletion.map_zero, LinearMap.zero_apply, map_zero]

/-- The completion `α^ : A[x₁, …, xₙ]^ → B^` of a presentation `α : A[x₁, …, xₙ] → B` of a finite
type algebra over a Noetherian ring is surjective. -/
@[stacks 0GAF "B^ = A[x₁, …, xₙ]^ / J^: the completed presentation is surjective"]
public theorem surjective_completedPresentationMap (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (hα : Function.Surjective α) : Function.Surjective (completedPresentationMap I α) :=
  (surjective_and_ker_completedPresentationMap I α hα).1

/-- The kernel of the completion `α^` of a presentation `α` with kernel `J` is the ideal
`J^ = J · A[x₁, …, xₙ]^` generated by `J` in the completed polynomial ring. -/
@[stacks 0GAF "B^ = A[x₁, …, xₙ]^ / J^: the kernel of the completed presentation is J^"]
public theorem ker_completedPresentationMap (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (hα : Function.Surjective α) :
    RingHom.ker (completedPresentationMap I α).toRingHom =
      (RingHom.ker α.toRingHom).map
        (algebraMap (MvPolynomial (Fin n) A) (adicCompletionMvPolynomial I n)) :=
  (surjective_and_ker_completedPresentationMap I α hα).2

variable [Algebra.FiniteType A B]

/-- **Stacks 0AJQ.** The `I`-adic completion `B^` of a finite type `A`-algebra, as an object of
the category of `I`-adically complete `A`-algebras of finite type modulo `I`. -/
public def adicCompletionObj : AdicFiniteTypeAlgebra.{u, v} A I :=
  ⟨CommAlgCat.of A (adicCompletionAlgebra I (B := B)),
    adicCompletion_isAdicallyComplete A I B,
    adicCompletion_finiteType_quotient A I B⟩

/-- The underlying algebra of `Rig.adicCompletionObj` is `B^`. -/
@[simp] public theorem adicCompletionObj_carrier :
    (adicCompletionObj I (B := B)).carrier = adicCompletionAlgebra I (B := B) := rfl

/-- `B^` is a `B`-algebra. -/
public instance : Algebra B (adicCompletionObj I (B := B)).carrier :=
  inferInstanceAs (Algebra B (adicCompletionAlgebra I (B := B)))

/-- The maps `A → B → B^` compose to the structure map `A → B^`. -/
public instance : IsScalarTower A B (adicCompletionObj I (B := B)).carrier :=
  inferInstanceAs (IsScalarTower A B (adicCompletionAlgebra I (B := B)))

/-- **Stacks 0GAF.** The presentation `B^ = A[x₁, …, xₙ]^ / J^` of the completion determined by
a presentation `α : A[x₁, …, xₙ] → B` of `B`: its variable count is that of `α` and its ideal
is the ideal generated by `J = ker α`. -/
public def completedPresentation (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (hα : Function.Surjective α) :
    CompletedPolynomialPresentation I (adicCompletionObj I (B := B)) where
  variableCount := n
  ideal := (RingHom.ker α.toRingHom).map
    (algebraMap (MvPolynomial (Fin n) A) (adicCompletionMvPolynomial I n))
  quotientEquiv :=
    (Ideal.quotientEquivAlgOfEq A (ker_completedPresentationMap I α hα).symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective (surjective_completedPresentationMap I α hα))

/-- `Rig.completedPresentation` has the variables of `α`. -/
@[simp] public theorem completedPresentation_variableCount
    (α : MvPolynomial (Fin n) A →ₐ[A] B) (hα : Function.Surjective α) :
    (completedPresentation I α hα).variableCount = n := rfl

/-- The presenting surjection of `Rig.completedPresentation` is the completion `α^` of `α`. -/
@[simp] public theorem completedPresentation_toAlgHom (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (hα : Function.Surjective α) (x : adicCompletionMvPolynomial I n) :
    (completedPresentation I α hα).toAlgHom x = completedPresentationMap I α x := rfl

/-- The kernel of `Rig.completedPresentation` is `J^ = J · A[x₁, …, xₙ]^`. -/
public theorem completedPresentation_ker (α : MvPolynomial (Fin n) A →ₐ[A] B)
    (hα : Function.Surjective α) :
    (completedPresentation I α hα).ker =
      (RingHom.ker α.toRingHom).map
        (algebraMap (MvPolynomial (Fin n) A) (adicCompletionMvPolynomial I n)) :=
  ker_completedPresentationMap I α hα

end CompletedPresentation

/-! ## The naive cotangent complex of the presentation, and its base change -/

section Comparison

variable {A : Type u} [CommRing A] [IsNoetherianRing A] (I : Ideal A)
  {B : Type v} [CommRing B] [Algebra A B] [Algebra.FiniteType A B] {n : ℕ}
  (G : Algebra.Generators A B (Fin n))

/-- The presenting surjection `α : A[x₁, …, xₙ] → B` of a presentation of `B` by `n`
variables, as an `A`-algebra map. -/
public abbrev presentationAlgHom : G.Ring →ₐ[A] B := IsScalarTower.toAlgHom A G.Ring B

/-- `NL(α)` in the coordinates of the presentation: the differential `J / J² → ⨁ᵢ B dxᵢ` of
the naive cotangent complex of `α`, with its degree-`0` term written in the canonical basis
`dx₁, …, dxₙ`. It sends the class of `g ∈ J` to the tuple of the images in `B` of the partial
derivatives `∂g/∂xᵢ`. -/
public def presentationDifferential : G.toExtension.Cotangent →ₗ[B] (Fin n → B) :=
  G.cotangentSpaceBasis.equivFun.toLinearMap ∘ₗ G.toExtension.cotangentComplex

omit [IsNoetherianRing A] [Algebra.FiniteType A B] in
/-- The differential sends the class of `g ∈ J` to the tuple of the images in `B` of the
`∂g/∂xᵢ`. -/
@[simp] public theorem presentationDifferential_mk (g : G.toExtension.ker) (i : Fin n) :
    presentationDifferential G (Algebra.Extension.Cotangent.mk g) i =
      algebraMap G.Ring B (MvPolynomial.pderiv i g.val) := by
  rw [presentationDifferential, LinearMap.comp_apply, LinearEquiv.coe_coe,
    Module.Basis.equivFun_apply, Algebra.Extension.cotangentComplex_mk,
    Algebra.Generators.cotangentSpaceBasis_repr_one_tmul, G.algebraMap_apply]

/-- The presentation `B^ = A[x₁, …, xₙ]^ / J^` of the completion determined by `G`. -/
public abbrev presentationCompletion :
    CompletedPolynomialPresentation I (adicCompletionObj I (B := B)) :=
  completedPresentation I (presentationAlgHom G) G.algebraMap_surjective

/-- The morphism of extensions from `α` to its completion `α^`, given by the completion map
`A[x₁, …, xₙ] → A[x₁, …, xₙ]^`. -/
public def presentationCompletionHom :
    G.toExtension.Hom (presentationCompletion I G).extension where
  toRingHom := algebraMap G.Ring (adicCompletionMvPolynomial I n)
  toRingHom_algebraMap x :=
    (IsScalarTower.algebraMap_apply A G.Ring (adicCompletionMvPolynomial I n) x).symm
  algebraMap_toRingHom x := completedPresentationMap_algebraMap I (presentationAlgHom G) x

/-- `NL^∧_{B^/A}`, the completed naive cotangent complex of the completed presentation. -/
public abbrev completedComplex :
    CompletedNaiveCotangentComplex (presentationCompletion I G) :=
  completedNaiveCotangentComplex (adicCompletionObj I (B := B)) (presentationCompletion I G)

/-- The comparison `J / J² → J^ / (J^)²` on conormal modules induced by the completion map
`A[x₁, …, xₙ] → A[x₁, …, xₙ]^`. -/
public abbrev conormalComparison :
    G.toExtension.Cotangent →ₗ[B] (presentationCompletion I G).extension.Cotangent :=
  Algebra.Extension.Cotangent.map (presentationCompletionHom I G)

/-- **The square of differentials commutes**: both ways round, the class of `g ∈ J` goes to the
tuple of the images in `B^` of the partial derivatives `∂g/∂xᵢ`. -/
@[stacks 0GAF "the comparison commutes with the differentials"]
public theorem differential_conormalComparison (x : G.toExtension.Cotangent) :
    (completedComplex I G).differential (conormalComparison I G x) =
      fun i ↦ algebraMap B (adicCompletionObj I (B := B)).carrier
        (presentationDifferential G x i) := by
  obtain ⟨g, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective x
  rw [conormalComparison, Algebra.Extension.Cotangent.map_mk,
    (completedComplex I G).differential_mk]
  funext i
  rw [show presentationDifferential G (Algebra.Extension.Cotangent.mk g) i =
      algebraMap G.Ring B (MvPolynomial.pderiv i g.val) from
    presentationDifferential_mk G g i]
  change (presentationCompletion I G).toAlgHom ((completedComplex I G).partialDeriv i
    (algebraMap G.Ring (adicCompletionMvPolynomial I n) g.val)) = _
  rw [show (completedComplex I G).partialDeriv i
        (algebraMap G.Ring (adicCompletionMvPolynomial I n) g.val) =
      algebraMap G.Ring (adicCompletionMvPolynomial I n) (MvPolynomial.pderiv i g.val) from
    (completedComplex I G).partialDeriv_polynomial i g.val]
  exact completedPresentationMap_algebraMap I (presentationAlgHom G) (MvPolynomial.pderiv i g.val)

/-- The canonical comparison of complexes `NL(α) ⊗_B B^ → NL^∧_{B^/A}`: in degree `-1` it is the
`B^`-linear extension of the map `J / J² → J^ / (J^)²` and in degree `0` it is `dxᵢ ↦ dxᵢ`. -/
@[stacks 0GAF "the comparison of complexes NL(α) ⊗_B B^ → NL^∧_{B^/A}"]
public def completionComparison :
    NaiveCotangent.ChainMap
      (baseChangedTwoTerm (adicCompletionObj I (B := B)).carrier (presentationDifferential G))
      (completedComplex I G).twoTerm :=
  freeBaseChangeChainMap (presentationDifferential G) (completedComplex I G).differential
    (conormalComparison I G) (differential_conormalComparison I G)

/-- In degree `-1` the comparison sends `b ⊗ y` to `b` times the image of `y` in `J^ / (J^)²`. -/
@[simp] public theorem completionComparison_f₁_tmul
    (b : (adicCompletionObj I (B := B)).carrier) (y : G.toExtension.Cotangent) :
    (completionComparison I G).f₁ (b ⊗ₜ[B] y) = b • conormalComparison I G y := rfl

/-- In degree `0` the comparison sends `b ⊗ v` to the tuple of the `v i · b`. -/
@[simp] public theorem completionComparison_f₀_tmul
    (b : (adicCompletionObj I (B := B)).carrier) (v : Fin n → B) (i : Fin n) :
    (completionComparison I G).f₀ (b ⊗ₜ[B] v) i =
      algebraMap B (adicCompletionObj I (B := B)).carrier (v i) * b :=
  freeBaseChangeChainMap_f₀_tmul _ _ _ _ b v i

/-- The comparison `NL(α) ⊗_B B^ → NL^∧_{B^/A}` is bijective in degree `0`. -/
@[stacks 0GAF "the comparison is bijective in degree 0"]
public theorem bijective_completionComparison_f₀ :
    Function.Bijective (completionComparison I G).f₀ :=
  bijective_freeBaseChangeChainMap_f₀ _ _ _ _

/-- The comparison `NL(α) ⊗_B B^ → NL^∧_{B^/A}` is bijective in degree `1`, that is
`B^ ⊗_B (J / J²) = J^ / (J^)²`. -/
@[stacks 0GAF "the comparison is bijective in degree 1"]
public theorem bijective_completionComparison_f₁ :
    Function.Bijective (completionComparison I G).f₁ := by
  let _ : Algebra G.Ring (adicCompletionObj I (B := B)).carrier :=
    ((algebraMap B (adicCompletionObj I (B := B)).carrier).comp
      (algebraMap G.Ring B)).toAlgebra
  let _ : Algebra (adicCompletionMvPolynomial I n) (adicCompletionObj I (B := B)).carrier :=
    (presentationCompletion I G).extension.algebra₂
  have : IsScalarTower G.Ring B (adicCompletionObj I (B := B)).carrier :=
    IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower G.Ring (adicCompletionMvPolynomial I n)
      (adicCompletionObj I (B := B)).carrier :=
    IsScalarTower.of_algebraMap_eq fun x =>
      ((presentationCompletionHom I G).algebraMap_toRingHom x).symm
  let eJ := (adicCompletionIdealEquiv (polynomialAdicIdeal I n) G.ker).trans
      (LinearEquiv.ofEq _ _
        (ker_completedPresentationMap I (presentationAlgHom G) G.algebraMap_surjective).symm)
  let w := (TensorProduct.AlgebraTensorModule.cancelBaseChange G.Ring B
      (adicCompletionObj I (B := B)).carrier
      (adicCompletionObj I (B := B)).carrier G.ker).symm.trans
    (G.toExtension.cotangentEquiv.baseChange (A := (adicCompletionObj I (B := B)).carrier))
  let w' := ((TensorProduct.AlgebraTensorModule.cancelBaseChange G.Ring
      (adicCompletionMvPolynomial I n)
      (adicCompletionObj I (B := B)).carrier
      (adicCompletionObj I (B := B)).carrier G.ker).symm.trans
    (eJ.baseChange (A := (adicCompletionObj I (B := B)).carrier))).trans
      (presentationCompletion I G).extension.cotangentEquiv
  let F := (conormalComparison I G).liftBaseChange (adicCompletionObj I (B := B)).carrier
  have key : ∀ (s : (adicCompletionObj I (B := B)).carrier) (j : G.ker),
      F (w (s ⊗ₜ[G.Ring] j)) = w' (s ⊗ₜ[G.Ring] j) := by
    intro s j
    have hw : w (s ⊗ₜ[G.Ring] j) =
        s ⊗ₜ[B] ((1 : B) • Algebra.Extension.Cotangent.mk j) := rfl
    rw [one_smul] at hw
    have hw' : w' (s ⊗ₜ[G.Ring] j) =
        s • Algebra.Extension.Cotangent.mk
          (eJ ((1 : adicCompletionMvPolynomial I n) ⊗ₜ[G.Ring] j)) := rfl
    have hval : ((eJ ((1 : adicCompletionMvPolynomial I n) ⊗ₜ[G.Ring] j) :
          adicCompletionMvPolynomial I n)) =
        algebraMap G.Ring (adicCompletionMvPolynomial I n) j.val := by
      change (adicCompletionIdealEquiv (polynomialAdicIdeal I n) G.ker
        ((1 : adicCompletionMvPolynomial I n) ⊗ₜ[G.Ring] j)).val = _
      rw [adicCompletionIdealEquiv_tmul, one_mul]
    have hj : eJ ((1 : adicCompletionMvPolynomial I n) ⊗ₜ[G.Ring] j) =
        ⟨algebraMap G.Ring (adicCompletionMvPolynomial I n) j.val, hval ▸
          (eJ ((1 : adicCompletionMvPolynomial I n) ⊗ₜ[G.Ring] j)).2⟩ := Subtype.ext hval
    rw [hw, hw', LinearMap.liftBaseChange_tmul, hj]
    rfl
  have hcomp : F ∘ₗ w.toLinearMap = w'.toLinearMap := by
    refine LinearMap.ext fun x => ?_
    induction x using TensorProduct.inductionOn with
    | tmul s j => exact key s j
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hf : F = (w.symm.trans w').toLinearMap :=
    LinearMap.ext fun y =>
      (congrArg F (w.apply_symm_apply y)).symm.trans
        (LinearMap.congr_fun hcomp (w.symm y))
  have hFbij : Function.Bijective F := by
    rw [hf]
    exact (w.symm.trans w').bijective
  exact hFbij

/-- `NL^∧_{B^/A} = NL(α) ⊗_B B^` as complexes: the comparison of two-term complexes is bijective
in both degrees and commutes with the two differentials. -/
@[stacks 0GAF "NL^∧_{B^/A} = NL(α) ⊗_B B^ as complexes"]
public theorem bijective_completionComparison :
    Function.Bijective (completionComparison I G).f₁ ∧
      Function.Bijective (completionComparison I G).f₀ ∧
      (completedComplex I G).twoTerm.d ∘ₗ (completionComparison I G).f₁ =
        (completionComparison I G).f₀ ∘ₗ
          (baseChangedTwoTerm (adicCompletionObj I (B := B)).carrier
            (presentationDifferential G)).d :=
  ⟨bijective_completionComparison_f₁ I G, bijective_completionComparison_f₀ I G,
    (completionComparison I G).comm⟩

end Comparison

end Rig

end
