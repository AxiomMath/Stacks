module

public import StacksFrontier.RingTheory.AdicCompletion.MapOfPowLe
public import StacksFrontier.RingTheory.Rig.NaiveCotangent
public import StacksFrontier.RingTheory.Rig.PresentationGenerators

/-!
# The completed naive cotangent complex and completed base change (Stacks 0GAG)

Let `(A₁, I₁) → (A₂, I₂)` be as in Stacks Remark 0AL5: a ring map carrying `I₁ ^ c` into
`I₂`.  Let `B₁` be an `I₁`-adically complete `A₁`-algebra of finite type modulo `I₁` and let
`B₂` be its completed base change.  Stacks tag 0GAG constructs a canonical comparison map

`NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}`

and asserts that it is an isomorphism on `H⁰` and a surjection on `H⁻¹`.  The construction of
the source's proof is: choose a presentation `B₁ = A₁[x₁, …, x_r]^∧ / J₁`; use the identity
`A₂ / I₂ ^ n[x] = A₁ / I₁ ^ {cn}[x] ⊗_{A₁ / I₁ ^ {cn}} A₂ / I₂ ^ n` to obtain a *compatible*
presentation `B₂ = A₂[x₁, …, x_r]^∧ / J₂` in the **same** variables; and read off the square

```
J₁ / J₁²  --d-->  ⨁ B₁ dxᵢ
   |                 |
   v                 v
J₂ / J₂²  --d-->  ⨁ B₂ dxᵢ
```

This file builds that square.  Its pieces are:

* the base-change map `A₁[x]^∧ → A₂[x]^∧` of completed polynomial algebras — the only map
  available, since a power and not `I₁` itself is carried into `I₂`;
* the fact that it commutes with the formal partial derivatives `∂/∂xᵢ`, proved by density of
  the polynomials in the completion;
* the presentation of `B₂` in the same `r` variables, obtained from
  `Rig.CompletedPolynomialPresentation.ofGenerators` once one knows that the images of the
  chosen generators of `B₁ / I₁ B₁` generate `B₂ / I₂ B₂`;
* the resulting map of extensions, hence of conormal modules, and the commuting square.

## Main definitions

* `Rig.polynomialBaseChange` — the `A₁`-algebra map `A₁[x₁, …, x_r]^∧ → A₂[x₁, …, x_r]^∧`.
* `Rig.baseChangePresentation` — the presentation of `B₂` in the same variables as a given
  presentation of `B₁` by generators.
* `Rig.baseChangeExtensionHom` — the induced map of the two algebra extensions, and
  `Rig.baseChangeCotangentMap` the induced `B₁`-linear map `J₁ / J₁² → J₂ / J₂²`.
* `Rig.toCompletedBaseChange` — the canonical map `B₁ → (B₁ ⊗_{A₁} A₂)^∧_{I₂}`.

## Main results

* `Rig.continuous_algHomOfMapPowLe` — **every map of completed polynomial algebras induced by
  a homomorphism shifting powers of the coefficient ideals is continuous**, of which
  `Rig.continuous_polynomialBaseChange` is the case at hand.
* `Rig.eq_of_continuous_of_algebraMap` — **two continuous maps out of a completed polynomial
  algebra which agree on polynomials are equal**, the reusable form of the density argument.
* `Rig.polynomialBaseChange_derivation` — the base-change map commutes with the formal
  partial derivatives, by density of the polynomials
  (`Rig.denseRange_completedPolynomialAlgebra`) and continuity
  (`Rig.continuous_polynomialBaseChange`).
* `Rig.aeval_surjective_baseChange` — the images of generators of `B₁ / I₁ B₁` generate
  `B₂ / I₂ B₂`, so `Rig.baseChangePresentation` is a presentation in the same variables.
* `Rig.completedAeval_polynomialBaseChange` — the two presentations are compatible:
  `A₁[x]^∧ → A₂[x]^∧ → B₂` agrees with `A₁[x]^∧ → B₁ → B₂`.
* `Rig.baseChange_differential` — the comparison square of Stacks 0GAG commutes.
* `Rig.le_span_range_toCompletedBaseChange_sup` — the spanning hypothesis below holds for the
  canonical completed base change, so the construction applies to it.

## Implementation notes

The identification `B₂ ≅ (B₁ ⊗_{A₁} A₂)^∧` enters only through the hypothesis
`hspan` of `Rig.aeval_surjective_baseChange`: that `B₂` is spanned over `A₂`, modulo `I₂ B₂`,
by the image of `B₁`.  Keeping it as a hypothesis makes the construction usable for any
realization of the base change; `Rig.le_span_range_toCompletedBaseChange_sup` verifies it for
the realization `(B₁ ⊗_{A₁} A₂)^∧_{I₂}` used by `Rig.completedBaseChange`.

What is **not** proved here is that `J₂` is generated by the image of `J₁`.  That is the one
remaining ingredient of 0GAG: it gives surjectivity of `J₁ / J₁² ⊗_{B₁} B₂ → J₂ / J₂²`, hence
the assertions about `H⁰` and `H⁻¹`.

## References

* [Stacks Project, Tag 0GAG](https://stacks.math.columbia.edu/tag/0GAG)
* [Stacks Project, Tag 0AL5](https://stacks.math.columbia.edu/tag/0AL5)
-/

@[expose] public noncomputable section

namespace Rig

universe u₁ u₂ v w

section Polynomial

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}

/-- Base change of coefficients, as an `A₁`-algebra map of polynomial algebras. -/
public abbrev polynomialCoeffBaseChange (A₁ : Type u₁) [CommRing A₁] (A₂ : Type u₂)
    [CommRing A₂] [Algebra A₁ A₂] (r : ℕ) :
    MvPolynomial (Fin r) A₁ →ₐ[A₁] MvPolynomial (Fin r) A₂ :=
  MvPolynomial.mapAlgHom (Algebra.ofId A₁ A₂)

/-- Base change of coefficients carries constants to constants. -/
@[simp] public theorem polynomialCoeffBaseChange_C (r : ℕ) (a : A₁) :
    polynomialCoeffBaseChange A₁ A₂ r (MvPolynomial.C a) =
      MvPolynomial.C (algebraMap A₁ A₂ a) := by
  simp [polynomialCoeffBaseChange]

/-- If `I₁ ^ c` lands in `I₂`, then the `c`-th power of the coefficient ideal of
`A₁[x₁, …, x_r]` lands in the coefficient ideal of `A₂[x₁, …, x_r]`. -/
public theorem map_pow_coeffIdeal_le (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) :
    ((I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)) ^ c).map
        (polynomialCoeffBaseChange A₁ A₂ r) ≤
      I₂.map (MvPolynomial.C : A₂ →+* MvPolynomial (Fin r) A₂) := by
  calc ((I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)) ^ c).map
        (polynomialCoeffBaseChange A₁ A₂ r)
      = ((I₁ ^ c).map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)).map
          ((polynomialCoeffBaseChange A₁ A₂ r).toRingHom) := by
        rw [← Ideal.map_pow]
        rfl
    _ = ((I₁ ^ c).map (algebraMap A₁ A₂)).map
          (MvPolynomial.C : A₂ →+* MvPolynomial (Fin r) A₂) := by
        rw [Ideal.map_map, Ideal.map_map]
        congr 1
        ext a
        simp
    _ ≤ I₂.map (MvPolynomial.C : A₂ →+* MvPolynomial (Fin r) A₂) := Ideal.map_mono hmap

/-- The base-change map `A₁[x₁, …, x_r]^∧ → A₂[x₁, …, x_r]^∧` of completed polynomial
algebras, for a map `(A₁, I₁) → (A₂, I₂)` carrying `I₁ ^ c` into `I₂`. -/
public def polynomialBaseChange (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) :
    completedPolynomialAlgebra I₁ r →ₐ[A₁] completedPolynomialAlgebra I₂ r :=
  AdicCompletion.algHomOfMapPowLe A₁ (polynomialCoeffBaseChange A₁ A₂ r)
    (map_pow_coeffIdeal_le hmap r)

/-- On the canonical image of the polynomials, the base-change map of completed polynomial
algebras is base change of coefficients. -/
@[simp] public theorem polynomialBaseChange_of (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
    (r : ℕ) (p : MvPolynomial (Fin r) A₁) :
    polynomialBaseChange hmap r
        (AdicCompletion.of (I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁))
          (MvPolynomial (Fin r) A₁) p) =
      AdicCompletion.of (I₂.map (MvPolynomial.C : A₂ →+* MvPolynomial (Fin r) A₂))
        (MvPolynomial (Fin r) A₂) (MvPolynomial.map (algebraMap A₁ A₂) p) :=
  AdicCompletion.algHomOfMapPowLe_of A₁ _ _ p

/-- On polynomials, the base-change map of completed polynomial algebras is base change of
coefficients. -/
public theorem polynomialBaseChange_algebraMap
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) (p : MvPolynomial (Fin r) A₁) :
    polynomialBaseChange hmap r
        (algebraMap (MvPolynomial (Fin r) A₁) (completedPolynomialAlgebra I₁ r) p) =
      algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r)
        (MvPolynomial.map (algebraMap A₁ A₂) p) := by
  rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
    Algebra.algebraMap_self_apply, Algebra.algebraMap_self_apply, polynomialBaseChange_of]

/-- The level-`n` reduction of the base-change map of completed polynomial algebras. -/
public theorem evalₐ_polynomialBaseChange (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
    (r n : ℕ) (x : completedPolynomialAlgebra I₁ r) :
    AdicCompletion.evalₐ (I₂.map (MvPolynomial.C : A₂ →+* MvPolynomial (Fin r) A₂)) n
        (polynomialBaseChange hmap r x) =
      Ideal.quotientMapₐ (R₁ := A₁) _ (polynomialCoeffBaseChange A₁ A₂ r)
        (AdicCompletion.pow_mul_le_comap_pow A₁ (polynomialCoeffBaseChange A₁ A₂ r)
          (map_pow_coeffIdeal_le hmap r) n)
        (AdicCompletion.evalₐ
          (I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)) (c * n) x) :=
  AdicCompletion.evalₐ_algHomOfMapPowLe A₁ _ _ n x

omit [Algebra A₁ A₂] in
/-- **Every map of completed polynomial algebras built by `AdicCompletion.algHomOfMapPowLe`
is continuous** for the two inverse-limit topologies: by
`AdicCompletion.evalₐ_algHomOfMapPowLe` it reads level `n` of its value off level `a * n` of
its argument, which is exactly the hypothesis of
`RestrictedPowerSeries.continuous_of_evalₐ_comm`. -/
public theorem continuous_algHomOfMapPowLe {A : Type w} [CommRing A] [Algebra A A₁]
    [Algebra A A₂] {a r s : ℕ} (f : MvPolynomial (Fin r) A₁ →ₐ[A] MvPolynomial (Fin s) A₂)
    (ha : ((I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)) ^ a).map f ≤
      I₂.map (MvPolynomial.C : A₂ →+* MvPolynomial (Fin s) A₂)) :
    @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₁ (Fin r))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₂ (Fin s))
      (AdicCompletion.algHomOfMapPowLe A f ha) :=
  RestrictedPowerSeries.continuous_of_evalₐ_comm I₁ r I₂ s _ (fun n ↦ a * n)
    (fun n ↦ Ideal.quotientMapₐ (R₁ := A) _ f
      (AdicCompletion.pow_mul_le_comap_pow A f ha n))
    (fun n x ↦ AdicCompletion.evalₐ_algHomOfMapPowLe A f ha n x)

/-- The base-change map of completed polynomial algebras is continuous for the two
inverse-limit topologies. -/
public theorem continuous_polynomialBaseChange
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) :
    @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₁ (Fin r))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₂ (Fin r))
      (polynomialBaseChange hmap r) :=
  continuous_algHomOfMapPowLe (polynomialCoeffBaseChange A₁ A₂ r)
    (map_pow_coeffIdeal_le hmap r)

end Polynomial

section Density

variable {A : Type u₁} [CommRing A]

/-- The polynomials are dense in the completed polynomial algebra.  This is the
presentation-free form of `Rig.denseRange_completedPolynomials`. -/
public theorem denseRange_completedPolynomialAlgebra (I : Ideal A) (r : ℕ) :
    letI : TopologicalSpace (completedPolynomialAlgebra I r) :=
      RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)
    DenseRange (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r)) := by
  let _ : TopologicalSpace (RestrictedPowerSeries I (Fin r)) :=
    RestrictedPowerSeries.limitTopology I (Fin r)
  let _ : ∀ n : ℕ, TopologicalSpace (MvPolynomial (Fin r) (A ⧸ I ^ n)) := fun _ ↦ ⊥
  let _ : ∀ n : ℕ, DiscreteTopology (MvPolynomial (Fin r) (A ⧸ I ^ n)) := fun _ ↦ ⟨rfl⟩
  let _ : TopologicalSpace (completedPolynomialAlgebra I r) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)
  let h := RestrictedPowerSeries.adicCompletionHomeomorph I (Fin r)
  have heq : (fun f ↦ h (RestrictedPowerSeries.polynomialAlgHom I (Fin r) f)) =
      (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r)) := by
    funext f
    change RestrictedPowerSeries.adicCompletionEquiv I (Fin r)
      (RestrictedPowerSeries.polynomialRingHom I (Fin r) f) = _
    rw [RestrictedPowerSeries.adicCompletionEquiv_polynomialRingHom]
    rfl
  rw [← heq]
  exact h.surjective.denseRange.comp (denseRange_restrictedPolynomials (I := I) (Fin r))
    h.continuous_toFun

/-- The completed polynomial algebra is Hausdorff for the inverse-limit topology. -/
public theorem t2Space_completedPolynomialAlgebra (I : Ideal A) (r : ℕ) :
    @T2Space (completedPolynomialAlgebra I r)
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)) := by
  let _ : TopologicalSpace (RestrictedPowerSeries I (Fin r)) :=
    RestrictedPowerSeries.limitTopology I (Fin r)
  let _ : ∀ n : ℕ, TopologicalSpace (MvPolynomial (Fin r) (A ⧸ I ^ n)) := fun _ ↦ ⊥
  let _ : ∀ n : ℕ, DiscreteTopology (MvPolynomial (Fin r) (A ⧸ I ^ n)) := fun _ ↦ ⟨rfl⟩
  let _ : TopologicalSpace (completedPolynomialAlgebra I r) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)
  have : T2Space (RestrictedPowerSeries I (Fin r)) := by infer_instance
  exact (RestrictedPowerSeries.adicCompletionHomeomorph I (Fin r)).t2Space

/-- **Two continuous maps out of a completed polynomial algebra which agree on the
polynomials are equal.**  This is `DenseRange.equalizer` for
`Rig.denseRange_completedPolynomialAlgebra`, with the Hausdorff hypothesis on the target
discharged by the caller and the one on the source supplied by
`Rig.t2Space_completedPolynomialAlgebra`; it is the form in which the density argument is
used, so that the topological instances never have to be reassembled at the point of use. -/
public theorem eq_of_continuous_of_algebraMap (I : Ideal A) (r : ℕ) {N : Type*}
    [TopologicalSpace N] [T2Space N] (g h : completedPolynomialAlgebra I r → N)
    (hg : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)) _ g)
    (hh : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)) _ h)
    (hgh : ∀ p : MvPolynomial (Fin r) A,
      g (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) =
        h (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p)) :
    g = h := by
  let _ : TopologicalSpace (completedPolynomialAlgebra I r) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology I (Fin r)
  exact (denseRange_completedPolynomialAlgebra I r).equalizer hg hh (funext hgh)

end Density

section Derivation

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}

/-- **The density argument of Stacks 0GAG.** Base change of coefficients commutes with the
formal partial derivatives: if `D₁` is a continuous derivation of `A₁[x₁, …, x_r]^∧` which is
`∂/∂xᵢ` on polynomials, and `D₂` is such a derivation of `A₂[x₁, …, x_r]^∧`, then the
base-change map intertwines them.  Both composites are continuous and agree on the dense
subring of polynomials. -/
public theorem polynomialBaseChange_derivation
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) (i : Fin r)
    (D₁ : Derivation A₁ (completedPolynomialAlgebra I₁ r) (completedPolynomialAlgebra I₁ r))
    (D₂ : Derivation A₂ (completedPolynomialAlgebra I₂ r) (completedPolynomialAlgebra I₂ r))
    (hD₁ : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₁ (Fin r))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₁ (Fin r)) D₁)
    (hD₂ : @Continuous _ _
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₂ (Fin r))
      (RestrictedPowerSeries.polynomialCompletionLimitTopology I₂ (Fin r)) D₂)
    (hp₁ : ∀ p : MvPolynomial (Fin r) A₁,
      D₁ (algebraMap (MvPolynomial (Fin r) A₁) (completedPolynomialAlgebra I₁ r) p) =
        algebraMap (MvPolynomial (Fin r) A₁) (completedPolynomialAlgebra I₁ r)
          (MvPolynomial.pderiv i p))
    (hp₂ : ∀ p : MvPolynomial (Fin r) A₂,
      D₂ (algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r) p) =
        algebraMap (MvPolynomial (Fin r) A₂) (completedPolynomialAlgebra I₂ r)
          (MvPolynomial.pderiv i p))
    (x : completedPolynomialAlgebra I₁ r) :
    polynomialBaseChange hmap r (D₁ x) = D₂ (polynomialBaseChange hmap r x) := by
  let _ : TopologicalSpace (completedPolynomialAlgebra I₁ r) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology I₁ (Fin r)
  let _ : TopologicalSpace (completedPolynomialAlgebra I₂ r) :=
    RestrictedPowerSeries.polynomialCompletionLimitTopology I₂ (Fin r)
  have _ : T2Space (completedPolynomialAlgebra I₂ r) :=
    t2Space_completedPolynomialAlgebra I₂ r
  have hβ := continuous_polynomialBaseChange hmap r (I₁ := I₁) (I₂ := I₂)
  refine congrFun ((denseRange_completedPolynomialAlgebra I₁ r).equalizer (hβ.comp hD₁)
    (hD₂.comp hβ) ?_) x
  funext p
  change polynomialBaseChange hmap r (D₁ (algebraMap _ _ p)) =
    D₂ (polynomialBaseChange hmap r (algebraMap _ _ p))
  rw [hp₁, polynomialBaseChange_algebraMap, polynomialBaseChange_algebraMap, hp₂,
    MvPolynomial.pderiv_map]

end Derivation

section BaseChangeGenerators

open AdicFiniteTypeAlgebra

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]

/-- The reduction `B₂ / I₂ B₂` is an `A₂ / I₂`-algebra compatibly with its `A₁`-algebra
structure. -/
public theorem isScalarTower_reduction :
    IsScalarTower A₁ (A₂ ⧸ I₂) (B₂.reduction) := by
  refine IsScalarTower.of_algebraMap_eq fun a ↦ ?_
  rw [IsScalarTower.algebraMap_apply A₁ A₂ (A₂ ⧸ I₂) a,
    ← IsScalarTower.algebraMap_apply A₂ (A₂ ⧸ I₂) B₂.reduction,
    ← IsScalarTower.algebraMap_apply A₁ A₂ B₂.reduction]

/-- The ideal generated by `I₁` in `B₂ / I₂ B₂`, written as a submodule over `A₂ / I₂`. -/
public theorem smul_top_eq_map_reduction :
    (I₁.map (algebraMap A₁ (A₂ ⧸ I₂))) • (⊤ : Submodule (A₂ ⧸ I₂) B₂.reduction) =
      Submodule.restrictScalars (A₂ ⧸ I₂) (I₁.map (algebraMap A₁ B₂.reduction)) := by
  have := isScalarTower_reduction (A₁ := A₁) (B₂ := B₂)
  rw [Ideal.smul_top_eq_map, Ideal.map_map,
    ← IsScalarTower.algebraMap_eq A₁ (A₂ ⧸ I₂) B₂.reduction]

/-- **Step 2 of Stacks 0GAG.** Suppose the reductions of `g : Fin r → B₁` generate
`B₁ / I₁ B₁` over `A₁ / I₁`, and suppose `B₂` is spanned over `A₂`, modulo `I₂ B₂`, by the
image of `B₁` — which is what the completed base change `B₂ = (B₁ ⊗_{A₁} A₂)^∧` provides.
Then the images of `g` in `B₂` generate `B₂ / I₂ B₂` over `A₂ / I₂`.

The point is that `I₁` becomes nilpotent in `A₂ / I₂`, by `Rig.imageIdeal_nilpotent`, so
generation modulo `I₁` suffices. -/
public theorem aeval_surjective_baseChange (hc : 0 < c)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
    (hspan : (⊤ : Submodule A₂ B₂.carrier) ≤
      Submodule.span A₂ (Set.range (algebraMap B₁.carrier B₂.carrier)) ⊔
        Submodule.restrictScalars A₂ B₂.adicIdeal)
    (r : ℕ) (g : Fin r → B₁.carrier)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B₁.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A₁ ⧸ I₁) →ₐ[A₁ ⧸ I₁] B₁.reduction)) :
    Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B₂.adicIdeal (algebraMap B₁.carrier B₂.carrier (g i))) :
        MvPolynomial (Fin r) (A₂ ⧸ I₂) →ₐ[A₂ ⧸ I₂] B₂.reduction) := by
  have htower := isScalarTower_reduction (A₁ := A₁) (B₂ := B₂)
  set gbar : Fin r → B₂.reduction :=
    fun i ↦ Ideal.Quotient.mk B₂.adicIdeal (algebraMap B₁.carrier B₂.carrier (g i)) with hgbar
  set T : Subalgebra (A₂ ⧸ I₂) B₂.reduction :=
    Algebra.adjoin (A₂ ⧸ I₂) (Set.range gbar) with hT
  set N : Ideal (A₂ ⧸ I₂) := I₁.map (algebraMap A₁ (A₂ ⧸ I₂)) with hN
  set W : Submodule (A₂ ⧸ I₂) B₂.reduction :=
    T.toSubmodule ⊔ N • (⊤ : Submodule (A₂ ⧸ I₂) B₂.reduction) with hW
  have hmemT : ∀ z : MvPolynomial (Fin r) A₁,
      Ideal.Quotient.mk B₂.adicIdeal
          (algebraMap B₁.carrier B₂.carrier (MvPolynomial.aeval g z)) ∈ T.toSubmodule := by
    intro z
    have h1 : Ideal.Quotient.mk B₂.adicIdeal
        (algebraMap B₁.carrier B₂.carrier (MvPolynomial.aeval g z)) =
        MvPolynomial.aeval (R := A₁) gbar z := by
      rw [← MvPolynomial.aeval_algebraMap_apply (A := B₁.carrier) (B := B₂.carrier) g z]
      exact MvPolynomial.comp_aeval_apply
        (fun i ↦ IsScalarTower.toAlgHom A₁ B₁.carrier B₂.carrier (g i))
        (Ideal.Quotient.mkₐ A₁ B₂.adicIdeal) z
    have h2 : MvPolynomial.aeval (R := A₁) gbar z =
        MvPolynomial.aeval (R := A₂ ⧸ I₂) gbar
          (MvPolynomial.map (algebraMap A₁ (A₂ ⧸ I₂)) z) :=
      (MvPolynomial.aeval_map_algebraMap (A := A₂ ⧸ I₂) gbar z).symm
    rw [h1, h2, Subalgebra.mem_toSubmodule, hT, Algebra.adjoin_range_eq_range_aeval]
    exact ⟨_, rfl⟩
  have hmemN : ∀ k ∈ B₁.adicIdeal,
      Ideal.Quotient.mk B₂.adicIdeal (algebraMap B₁.carrier B₂.carrier k) ∈
        N • (⊤ : Submodule (A₂ ⧸ I₂) B₂.reduction) := by
    intro k hk
    rw [hN, smul_top_eq_map_reduction (A₁ := A₁) (B₂ := B₂) (I₁ := I₁)]
    refine (Submodule.restrictScalars_mem (A₂ ⧸ I₂) _ _).mpr ?_
    have hle : I₁.map (algebraMap A₁ B₁.carrier) ≤
        Ideal.comap ((Ideal.Quotient.mk B₂.adicIdeal).comp
            (algebraMap B₁.carrier B₂.carrier))
          (I₁.map (algebraMap A₁ B₂.reduction)) := by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_map]
      have hcomp : ((Ideal.Quotient.mk B₂.adicIdeal).comp
          (algebraMap B₁.carrier B₂.carrier)).comp
          (algebraMap A₁ B₁.carrier) = algebraMap A₁ B₂.reduction := by
        ext a
        change Ideal.Quotient.mk B₂.adicIdeal
          (algebraMap B₁.carrier B₂.carrier (algebraMap A₁ B₁.carrier a)) = _
        rw [← IsScalarTower.algebraMap_apply A₁ B₁.carrier B₂.carrier a]
        rfl
      rw [hcomp]
    exact hle hk
  have hstep1 : ∀ b : B₁.carrier,
      Ideal.Quotient.mk B₂.adicIdeal (algebraMap B₁.carrier B₂.carrier b) ∈ W := by
    intro b
    obtain ⟨t, ht, k, hk, heq⟩ := Submodule.mem_sup.mp
      (le_adjoin_sup_smul_top B₁ r g hgen (Submodule.mem_top (x := b)))
    rw [Subalgebra.mem_toSubmodule, Algebra.adjoin_range_eq_range_aeval] at ht
    obtain ⟨z, hz⟩ := ht
    rw [Ideal.smul_top_eq_map] at hk
    replace hk := (Submodule.restrictScalars_mem A₁ _ _).mp hk
    rw [← heq, map_add, map_add, hW]
    exact Submodule.add_mem_sup (hz ▸ hmemT z) (hmemN k hk)
  have hstep2 : ∀ y : B₂.carrier, Ideal.Quotient.mk B₂.adicIdeal y ∈ W := by
    intro y
    obtain ⟨sb, hsb, zb, hzb, rfl⟩ :=
      Submodule.mem_sup.mp (hspan (Submodule.mem_top (x := y)))
    have hz0 : Ideal.Quotient.mk B₂.adicIdeal zb = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr ((Submodule.restrictScalars_mem A₂ _ _).mp hzb)
    rw [map_add, hz0, add_zero]
    induction hsb using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨b, rfl⟩ := hx
        exact hstep1 b
    | zero =>
        rw [map_zero]
        exact W.zero_mem
    | add x y _ _ hx hy =>
        rw [map_add]
        exact W.add_mem hx hy
    | smul a x _ hx =>
        have hsmul : Ideal.Quotient.mk B₂.adicIdeal (a • x) =
            (algebraMap A₂ (A₂ ⧸ I₂) a) • Ideal.Quotient.mk B₂.adicIdeal x := by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul]
          congr 1
        rw [hsmul]
        exact W.smul_mem _ hx
  have hTtop : T = ⊤ := by
    refine subalgebra_eq_top_of_isNilpotent N (hN ▸ imageIdeal_nilpotent c hc hmap) T ?_
    intro x _
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact hW ▸ hstep2 y
  rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
  exact hTtop

end BaseChangeGenerators

section Compatibility

open AdicFiniteTypeAlgebra

attribute [local instance] AdicFiniteTypeAlgebra.isAdicallyComplete

/-- Two `A`-algebra maps out of `A[x₁, …, x_r]^∧` into an `L`-adically complete `A`-algebra
agree as soon as they agree on polynomials and each carries the ideal generated by
`(I · A[x₁, …, x_r]) ^ (d * n)` into `L ^ n` for every `n`.  The point is that every element
of the completion agrees modulo such an ideal with a polynomial. -/
public theorem completedPolynomialAlgebra_algHom_ext {A : Type u₁} [CommRing A] {I : Ideal A}
    (hI : I.FG) (r : ℕ) {C : Type*} [CommRing C] [Algebra A C] (L : Ideal C)
    [IsAdicComplete L C] (F G : completedPolynomialAlgebra I r →ₐ[A] C) (d : ℕ)
    (hF : ∀ n, ((I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) ^ (d * n)).map
        (F.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A)
          (completedPolynomialAlgebra I r))) ≤ L ^ n)
    (hG : ∀ n, ((I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) ^ (d * n)).map
        (G.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A)
          (completedPolynomialAlgebra I r))) ≤ L ^ n)
    (hpoly : ∀ p : MvPolynomial (Fin r) A,
      F (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p) =
        G (algebraMap (MvPolynomial (Fin r) A) (completedPolynomialAlgebra I r) p)) :
    F = G := by
  refine IsAdicComplete.algHom_ext L fun n ↦ AlgHom.ext fun x ↦ ?_
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
  obtain ⟨p, hp⟩ := AdicCompletion.exists_sub_mem_map_pow
    (I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A))
    (hI.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) (d * n) x
  have key : ∀ H : completedPolynomialAlgebra I r →ₐ[A] C,
      (((I.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A)) ^ (d * n)).map
        (H.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A)
          (completedPolynomialAlgebra I r))) ≤ L ^ n) →
      Ideal.Quotient.mk (L ^ n) (H x) =
        Ideal.Quotient.mk (L ^ n) (H (algebraMap (MvPolynomial (Fin r) A)
          (completedPolynomialAlgebra I r) p)) := by
    intro H hH
    have h2 := Ideal.mem_map_of_mem H.toRingHom hp
    rw [Ideal.map_map] at h2
    replace h2 := hH h2
    rw [map_sub] at h2
    have h3 := Ideal.Quotient.eq_zero_iff_mem.mpr h2
    rw [map_sub, sub_eq_zero] at h3
    exact h3
  rw [key F (hF n), key G (hG n), hpoly]

section

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]

/-- The `(c * n)`-th power of the ideal of definition of `B₁` maps into the `n`-th power of
the ideal of definition of `B₂`. -/
public theorem map_adicIdeal_pow_le (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (n : ℕ) :
    (B₁.adicIdeal ^ (c * n)).map (algebraMap B₁.carrier B₂.carrier) ≤ B₂.adicIdeal ^ n := by
  have hstep : (I₁ ^ c).map (algebraMap A₁ B₂.carrier) ≤ B₂.adicIdeal := by
    rw [IsScalarTower.algebraMap_eq A₁ A₂ B₂.carrier, ← Ideal.map_map]
    exact Ideal.map_mono hmap
  calc (B₁.adicIdeal ^ (c * n)).map (algebraMap B₁.carrier B₂.carrier)
      = ((I₁ ^ (c * n)).map (algebraMap A₁ B₁.carrier)).map
          (algebraMap B₁.carrier B₂.carrier) := by
        rw [AdicFiniteTypeAlgebra.adicIdeal, ← Ideal.map_pow]
    _ = (I₁ ^ (c * n)).map (algebraMap A₁ B₂.carrier) := by
        rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq A₁ B₁.carrier B₂.carrier]
    _ = ((I₁ ^ c).map (algebraMap A₁ B₂.carrier)) ^ n := by
        rw [pow_mul, Ideal.map_pow]
    _ ≤ B₂.adicIdeal ^ n := Ideal.pow_right_mono hstep n

/-- **Compatibility of the two presentations in Stacks 0GAG.** Substituting the images of `g`
after base change agrees with base-changing the substitution of `g`: the square

```
A₁[x]^∧ ---> A₂[x]^∧
   |             |
   v             v
  B₁   ------>  B₂
```

commutes.  Both composites are `A₁`-algebra maps which agree on polynomials and carry
`(I₁ · A₁[x]) ^ (c n)` into `(I₂ B₂) ^ n`, so they agree by
`Rig.completedPolynomialAlgebra_algHom_ext`. -/
public theorem completedAeval_polynomialBaseChange (hI₁ : I₁.FG)
    (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂) (r : ℕ) (g : Fin r → B₁.carrier)
    (x : completedPolynomialAlgebra I₁ r) :
    completedAeval B₂ r (fun i ↦ algebraMap B₁.carrier B₂.carrier (g i))
        (polynomialBaseChange hmap r x) =
      algebraMap B₁.carrier B₂.carrier (completedAeval B₁ r g x) := by
  set g₂ : Fin r → B₂.carrier := fun i ↦ algebraMap B₁.carrier B₂.carrier (g i) with hg₂
  set F : completedPolynomialAlgebra I₁ r →ₐ[A₁] B₂.carrier :=
    ((completedAeval B₂ r g₂).restrictScalars A₁).comp (polynomialBaseChange hmap r) with hFdef
  set G : completedPolynomialAlgebra I₁ r →ₐ[A₁] B₂.carrier :=
    (IsScalarTower.toAlgHom A₁ B₁.carrier B₂.carrier).comp (completedAeval B₁ r g) with hGdef
  have hFcomp : F.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A₁)
        (completedPolynomialAlgebra I₁ r)) =
      (MvPolynomial.aeval g₂ : MvPolynomial (Fin r) A₂ →ₐ[A₂] B₂.carrier).toRingHom.comp
        (polynomialCoeffBaseChange A₁ A₂ r).toRingHom := by
    refine RingHom.ext fun q ↦ ?_
    change completedAeval B₂ r g₂ (polynomialBaseChange hmap r (algebraMap _ _ q)) = _
    rw [polynomialBaseChange_algebraMap, completedAeval_algebraMap]
    rfl
  have hGcomp : G.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A₁)
        (completedPolynomialAlgebra I₁ r)) =
      (algebraMap B₁.carrier B₂.carrier).comp
        (MvPolynomial.aeval g : MvPolynomial (Fin r) A₁ →ₐ[A₁] B₁.carrier).toRingHom := by
    refine RingHom.ext fun q ↦ ?_
    change algebraMap B₁.carrier B₂.carrier
      (completedAeval B₁ r g (algebraMap _ _ q)) = _
    rw [completedAeval_algebraMap]
    rfl
  have hF : ∀ n, ((I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)) ^ (c * n)).map
      (F.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A₁)
        (completedPolynomialAlgebra I₁ r))) ≤ B₂.adicIdeal ^ n := by
    intro n
    rw [hFcomp, ← Ideal.map_map]
    refine le_trans (Ideal.map_mono (AdicCompletion.map_pow_mul_le_pow A₁
      (polynomialCoeffBaseChange A₁ A₂ r) (map_pow_coeffIdeal_le hmap r) n)) ?_
    exact Ideal.map_le_iff_le_comap.mpr (pow_le_comap_pow_aeval B₂ r g₂ n)
  have hG : ∀ n, ((I₁.map (MvPolynomial.C : A₁ →+* MvPolynomial (Fin r) A₁)) ^ (c * n)).map
      (G.toRingHom.comp (algebraMap (MvPolynomial (Fin r) A₁)
        (completedPolynomialAlgebra I₁ r))) ≤ B₂.adicIdeal ^ n := by
    intro n
    rw [hGcomp, ← Ideal.map_map]
    refine le_trans (Ideal.map_mono (Ideal.map_le_iff_le_comap.mpr
      (pow_le_comap_pow_aeval B₁ r g (c * n)))) ?_
    exact map_adicIdeal_pow_le hmap n
  have hpoly : ∀ p : MvPolynomial (Fin r) A₁,
      F (algebraMap (MvPolynomial (Fin r) A₁) (completedPolynomialAlgebra I₁ r) p) =
        G (algebraMap (MvPolynomial (Fin r) A₁) (completedPolynomialAlgebra I₁ r) p) := by
    intro p
    change completedAeval B₂ r g₂ (polynomialBaseChange hmap r (algebraMap _ _ p)) =
      algebraMap B₁.carrier B₂.carrier (completedAeval B₁ r g (algebraMap _ _ p))
    rw [polynomialBaseChange_algebraMap, completedAeval_algebraMap, completedAeval_algebraMap,
      ← MvPolynomial.aeval_algebraMap_apply (A := B₁.carrier) (B := B₂.carrier) g p]
    exact MvPolynomial.aeval_map_algebraMap (A := A₂) g₂ p
  exact DFunLike.congr_fun
    (completedPolynomialAlgebra_algHom_ext hI₁ r B₂.adicIdeal F G c hF hG hpoly) x

end

end Compatibility

section Square

open AdicFiniteTypeAlgebra CompletedPolynomialPresentation

/-- The presenting surjection of `Rig.CompletedPolynomialPresentation.ofGenerators` is
`Rig.completedAeval`. -/
public theorem ofGenerators_toAlgHom {A : Type u₁} [CommRing A] {I : Ideal A}
    (B : AdicFiniteTypeAlgebra.{u₁, v} A I) (r : ℕ) (g : Fin r → B.carrier) (hI : I.FG)
    (hgen : Function.Surjective (MvPolynomial.aeval
      (fun i ↦ Ideal.Quotient.mk B.adicIdeal (g i)) :
        MvPolynomial (Fin r) (A ⧸ I) →ₐ[A ⧸ I] B.reduction)) :
    (ofGenerators B r g hI hgen).toAlgHom = completedAeval B r g :=
  AlgHom.ext fun x ↦ ofGenerators_quotientEquiv_mk B r g hI hgen x

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂} {c : ℕ}
  {B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁} {B₂ : AdicFiniteTypeAlgebra.{u₂, w} A₂ I₂}
  [Algebra B₁.carrier B₂.carrier] [Algebra A₁ B₂.carrier]
  [IsScalarTower A₁ A₂ B₂.carrier] [IsScalarTower A₁ B₁.carrier B₂.carrier]
  (hI₁ : I₁.FG) (hI₂ : I₂.FG) (hc : 0 < c)
  (hmap : (I₁ ^ c).map (algebraMap A₁ A₂) ≤ I₂)
  (hspan : (⊤ : Submodule A₂ B₂.carrier) ≤
    Submodule.span A₂ (Set.range (algebraMap B₁.carrier B₂.carrier)) ⊔
      Submodule.restrictScalars A₂ B₂.adicIdeal)
  (r : ℕ) (g : Fin r → B₁.carrier)
  (hgen : Function.Surjective (MvPolynomial.aeval
    (fun i ↦ Ideal.Quotient.mk B₁.adicIdeal (g i)) :
      MvPolynomial (Fin r) (A₁ ⧸ I₁) →ₐ[A₁ ⧸ I₁] B₁.reduction))

/-- **The compatible presentation of Stacks 0GAG.** The presentation of the base change `B₂`
in the *same* `r` variables as the given presentation of `B₁` by the generating family `g`:
its presenting surjection sends `xᵢ` to the image of `g i`. -/
public def baseChangePresentation : CompletedPolynomialPresentation I₂ B₂ :=
  ofGenerators B₂ r (fun i ↦ algebraMap B₁.carrier B₂.carrier (g i)) hI₂
    (aeval_surjective_baseChange hc hmap hspan r g hgen)

/-- The compatible presentation of `B₂` has `r` variables. -/
@[simp] public theorem baseChangePresentation_variableCount :
    (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).variableCount = r := rfl

/-- The presenting surjection of the compatible presentation. -/
public theorem baseChangePresentation_toAlgHom :
    (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).toAlgHom =
      completedAeval B₂ r (fun i ↦ algebraMap B₁.carrier B₂.carrier (g i)) :=
  ofGenerators_toAlgHom _ _ _ _ _

/-- **The map of extensions of Stacks 0GAG.** The base-change map of completed polynomial
algebras, viewed as a map from the extension presenting `B₁` to the extension presenting
`B₂`.  The second field is exactly the compatibility of the two presentations. -/
public def baseChangeExtensionHom :
    (ofGenerators B₁ r g hI₁ hgen).extension.Hom
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension where
  toRingHom := (polynomialBaseChange hmap r).toRingHom
  toRingHom_algebraMap x := by
    change polynomialBaseChange hmap r (algebraMap A₁ _ x) = _
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply A₁ A₂
      (completedPolynomialAlgebra I₂ r) x]
    rfl
  algebraMap_toRingHom x := by
    change (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).toAlgHom
        (polynomialBaseChange hmap r x) =
      algebraMap B₁.carrier B₂.carrier ((ofGenerators B₁ r g hI₁ hgen).toAlgHom x)
    rw [baseChangePresentation_toAlgHom, ofGenerators_toAlgHom]
    exact completedAeval_polynomialBaseChange hI₁ hmap r g x

/-- **The comparison map on conormal modules of Stacks 0GAG**: the `B₁`-linear map
`J₁ / J₁² → J₂ / J₂²` induced by the base-change map of completed polynomial algebras. -/
public def baseChangeCotangentMap :
    (ofGenerators B₁ r g hI₁ hgen).extension.Cotangent →ₗ[B₁.carrier]
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.Cotangent :=
  Algebra.Extension.Cotangent.map (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen)

/-- `Rig.baseChangeCotangentMap` sends the class of `z ∈ J₁` to the class of its image under
the base-change map of completed polynomial algebras. -/
@[simp] public theorem baseChangeCotangentMap_mk
    (z : (ofGenerators B₁ r g hI₁ hgen).extension.ker)
    (hz : polynomialBaseChange hmap r z.1 ∈
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).extension.ker) :
    baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen
        (Algebra.Extension.Cotangent.mk z) =
      Algebra.Extension.Cotangent.mk ⟨polynomialBaseChange hmap r z.1, hz⟩ :=
  Algebra.Extension.Cotangent.map_mk
    (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen) z

/-- **The comparison square of Stacks 0GAG.** With the compatible presentations of `B₁` and
`B₂` in the same variables, the square

```
J₁ / J₁²  --d-->  ⨁ B₁ dxᵢ
   |                 |
   v                 v
J₂ / J₂²  --d-->  ⨁ B₂ dxᵢ
```

commutes, where the left vertical map is `Rig.baseChangeCotangentMap` and the right one is
coefficientwise base change.  It is this square which determines the comparison map
`NL^∧_{B₁/A₁} ⊗_{B₁} B₂ → NL^∧_{B₂/A₂}`. -/
public theorem baseChange_differential
    (K₁ : CompletedNaiveCotangentComplex (ofGenerators B₁ r g hI₁ hgen))
    (K₂ : CompletedNaiveCotangentComplex
      (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen))
    (y : (ofGenerators B₁ r g hI₁ hgen).extension.Cotangent) :
    K₂.differential (baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen y) =
      fun i ↦ algebraMap B₁.carrier B₂.carrier (K₁.differential y i) := by
  obtain ⟨z, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective y
  rw [show baseChangeCotangentMap hI₁ hI₂ hc hmap hspan r g hgen
        (Algebra.Extension.Cotangent.mk z) =
      Algebra.Extension.Cotangent.map
        (baseChangeExtensionHom hI₁ hI₂ hc hmap hspan r g hgen)
        (Algebra.Extension.Cotangent.mk z) from rfl,
    Algebra.Extension.Cotangent.map_mk, K₂.differential_mk, K₁.differential_mk]
  funext i
  have hD := polynomialBaseChange_derivation hmap r i (K₁.partialDeriv i) (K₂.partialDeriv i)
    (K₁.partialDeriv_continuous i) (K₂.partialDeriv_continuous i)
    (K₁.partialDeriv_polynomial i) (K₂.partialDeriv_polynomial i)
    (z.1 : completedPolynomialAlgebra I₁ r)
  calc (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).toAlgHom
        (K₂.partialDeriv i (polynomialBaseChange hmap r z.1))
      = (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g hgen).toAlgHom
          (polynomialBaseChange hmap r (K₁.partialDeriv i z.1)) :=
        congrArg (fun w ↦ (baseChangePresentation (B₁ := B₁) hI₂ hc hmap hspan r g
          hgen).toAlgHom w) hD.symm
    _ = algebraMap B₁.carrier B₂.carrier
          ((ofGenerators B₁ r g hI₁ hgen).toAlgHom (K₁.partialDeriv i z.1)) := by
        rw [baseChangePresentation_toAlgHom, ofGenerators_toAlgHom]
        exact completedAeval_polynomialBaseChange hI₁ hmap r g _

end Square

section CompletedBaseChange

open AdicFiniteTypeAlgebra

attribute [local instance] Algebra.TensorProduct.rightAlgebra

variable {A₁ : Type u₁} [CommRing A₁] {A₂ : Type u₂} [CommRing A₂] [Algebra A₁ A₂]
  {I₁ : Ideal A₁} {I₂ : Ideal A₂}

/-- The inclusion `B₁ → B₁ ⊗_{A₁} A₂` of the uncompleted base change. -/
public abbrev toBaseChange (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    B₁.carrier →ₐ[A₁] baseChangedAlgebra (A₂ := A₂) B₁ :=
  Algebra.TensorProduct.includeLeft

/-- The canonical map `B₁ → (B₁ ⊗_{A₁} A₂)^∧_{I₂}` into the completed base change. -/
public abbrev toCompletedBaseChange (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    B₁.carrier →ₐ[A₁] completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁ :=
  (IsScalarTower.toAlgHom A₁ (baseChangedAlgebra (A₂ := A₂) B₁)
      (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)).comp
    (toBaseChange (A₂ := A₂) B₁)

/-- The image of `B₁` spans the uncompleted base change `B₁ ⊗_{A₁} A₂` over `A₂`. -/
public theorem span_range_toBaseChange_eq_top (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    Submodule.span A₂ (Set.range (toBaseChange (A₂ := A₂) B₁)) = ⊤ := by
  set M : Submodule A₂ (baseChangedAlgebra (A₂ := A₂) B₁) :=
    Submodule.span A₂ (Set.range (toBaseChange (A₂ := A₂) B₁)) with hM
  have key : ∀ s : baseChangedAlgebra (A₂ := A₂) B₁, s ∈ M := by
    intro s
    induction s using TensorProduct.inductionOn with
    | tmul b a =>
        have h : (b ⊗ₜ[A₁] a : baseChangedAlgebra (A₂ := A₂) B₁) =
            a • (toBaseChange (A₂ := A₂) B₁ b) := by
          rw [Algebra.smul_def]
          change _ = (Algebra.TensorProduct.includeRight a) * (b ⊗ₜ[A₁] 1)
          rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
            one_mul, mul_one]
        rw [h, hM]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, rfl⟩)
    | add x y hx hy => exact M.add_mem hx hy
  exact le_antisymm le_top fun s _ ↦ key s

/-- **The hypothesis `hspan` of `Rig.aeval_surjective_baseChange`, verified for the canonical
completed base change.** Every element of `(B₁ ⊗_{A₁} A₂)^∧_{I₂}` differs, modulo `I₂`, from
an `A₂`-linear combination of elements of the image of `B₁`.  Indeed `B₁ ⊗_{A₁} A₂` is spanned
over `A₂` by that image, and the completion maps onto its reduction modulo `I₂`. -/
public theorem le_span_range_toCompletedBaseChange_sup (hI₂ : I₂.FG)
    (B₁ : AdicFiniteTypeAlgebra.{u₁, v} A₁ I₁) :
    (⊤ : Submodule A₂ (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)) ≤
      Submodule.span A₂ (Set.range (toCompletedBaseChange (A₂ := A₂) (I₂ := I₂) B₁)) ⊔
      Submodule.restrictScalars A₂ (I₂.map (algebraMap A₂
        (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁))) := by
  intro x _
  have hspan' : ∀ t : baseChangedAlgebra (A₂ := A₂) B₁,
      algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
          (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) t ∈
        Submodule.span A₂
          (Set.range (toCompletedBaseChange (A₂ := A₂) (I₂ := I₂) B₁)) := by
    intro t
    have ht : t ∈ Submodule.span A₂ (Set.range (toBaseChange (A₂ := A₂) B₁)) := by
      rw [span_range_toBaseChange_eq_top]
      exact Submodule.mem_top
    induction ht using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨b, rfl⟩ := hy
        exact Submodule.subset_span ⟨b, rfl⟩
    | zero =>
        rw [map_zero]
        exact Submodule.zero_mem _
    | add y z _ _ hy hz =>
        rw [map_add]
        exact Submodule.add_mem _ hy hz
    | smul a y _ hy =>
        have hs : algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
            (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) (a • y) =
            a • algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
              (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) y := by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul,
            ← IsScalarTower.algebraMap_apply A₂ (baseChangedAlgebra (A₂ := A₂) B₁)
              (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)]
        rw [hs]
        exact Submodule.smul_mem _ _ hy
  obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalOneₐ (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁) x)
  have hmem : x - algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
      (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) s ∈
      I₂.map (algebraMap A₂ (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁)) := by
    rw [baseChangedIdeal_completionMap_eq B₁,
      ← AdicCompletion.ker_evalOneₐ_eq_map (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁)
        (baseChangedIdeal_fg B₁ hI₂), RingHom.mem_ker, map_sub]
    have h2 : AdicCompletion.evalOneₐ (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁)
        (algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
          (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) s) =
        Ideal.Quotient.mk (baseChangedIdeal (A₂ := A₂) (I₂ := I₂) B₁) s := by
      rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply,
        AdicCompletion.evalOneₐ_of]
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, h2, hs, sub_self]
  rw [show x = algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
      (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) s +
      (x - algebraMap (baseChangedAlgebra (A₂ := A₂) B₁)
        (completedBaseChangedAlgebra (A₂ := A₂) (I₂ := I₂) B₁) s) by ring]
  exact Submodule.add_mem_sup (hspan' s) ((Submodule.restrictScalars_mem A₂ _ _).mpr hmem)

end CompletedBaseChange

end Rig

