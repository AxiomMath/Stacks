module

public import Mathlib.RingTheory.Polynomial.Quotient
public import StacksFrontier.RingTheory.Rig.NaiveCotangent.ReducedPresentation

/-!
# The comparison `A⟨x₁, …, x_r⟩ → Aₙ[x₁, …, x_r]`, and `Jₙ / Jₙ²`

Let `A` be a Noetherian ring, let `I ⊆ A` be an ideal, let `B` be an object of the category
(Stacks 0AL4) and fix a completed polynomial presentation `B = A⟨x₁, …, x_r⟩ / J`, where
`A⟨x⟩` is the `I`-adic completion of `A[x₁, …, x_r]`.  Writing `Aₙ = A / Iⁿ` and `Bₙ = B / IⁿB`,
Stacks 0AJS presents `Bₙ = Aₙ[x₁, …, x_r] / Jₙ` with `Jₙ = J / (J ∩ Iⁿ A⟨x⟩)`.
`Rig.CompletedPolynomialPresentation.reductionGenerators` is that presentation; this file
constructs the map of presentations behind it and computes what it does in degree `-1` of the
naive cotangent complex.

The map is the reduction of coefficients

`ψₙ : A⟨x₁, …, x_r⟩ ⟶ Aₙ[x₁, …, x_r]`,

surjective with kernel exactly `Iⁿ A⟨x⟩`: it is `AdicCompletion.evalₐ`, whose target
`A[x] / Iⁿ A[x]` is `Aₙ[x]` by `MvPolynomial.quotientEquivQuotientMvPolynomial`.  It covers the
square `A → Aₙ`, `B → Bₙ`, so it is an `Algebra.Extension.Hom` from `B = A⟨x⟩ / J` to
`Bₙ = Aₙ[x] / Jₙ`, and therefore induces `Algebra.Extension.Cotangent.map` on conormal modules.

That induced map is surjective with kernel exactly
`Rig.CompletedPolynomialPresentation.conormalSub n`, the submodule of `J / J²` generated by the
image of `J ∩ Iⁿ A⟨x⟩`.  So

`Jₙ / Jₙ² = (J / J²) / ⟨image of J ∩ Iⁿ A⟨x⟩⟩`,

which is the degree-`-1` part of the identification of
`Rig.CompletedNaiveCotangentComplex.reducedComplex n` with `NL(Bₙ = Aₙ[x] / Jₙ)`.

## Main definitions

* `Rig.CompletedPolynomialPresentation.reductionAlgHom`: `ψₙ : A⟨x⟩ → Aₙ[x]`.
* `Rig.CompletedPolynomialPresentation.reductionHom`: `ψₙ` as an `Algebra.Extension.Hom`.
* `Rig.CompletedPolynomialPresentation.cotangentQuotConormalSubEquiv`:
  `(J / J²) / ⟨image of J ∩ Iⁿ A⟨x⟩⟩ ≃ Jₙ / Jₙ²`.

## Main results

* `Rig.CompletedPolynomialPresentation.surjective_reductionAlgHom` and
  `…_.ker_reductionAlgHom`: `ψₙ` is surjective with kernel `Iⁿ A⟨x⟩`.
* `Rig.CompletedPolynomialPresentation.map_reductionAlgHom_ker`: `ψₙ(J) = Jₙ`.
* `Rig.CompletedPolynomialPresentation.surjective_cotangentMap_reductionHom` and
  `…_.ker_cotangentMap_reductionHom`: the induced map `J / J² → Jₙ / Jₙ²` is surjective with
  kernel `conormalSub n`.

## References

* [Stacks Project, Tag 0AJS](https://stacks.math.columbia.edu/tag/0AJS)
* [Stacks Project, Tag 0AJU](https://stacks.math.columbia.edu/tag/0AJU)
-/

@[expose] public section

open Algebra MvPolynomial

namespace Rig

namespace CompletedPolynomialPresentation

universe u v

variable {A : Type u} [CommRing A] {I : Ideal A}
  {B : AdicFiniteTypeAlgebra.{u, v} A I} (P : CompletedPolynomialPresentation I B)

/-! ## The reduction of coefficients `A⟨x⟩ → Aₙ[x]` -/

/-- The isomorphism `A[x₁, …, x_r] / Iⁿ A[x₁, …, x_r] ≃ Aₙ[x₁, …, x_r]`. -/
public noncomputable def polyQuotEquiv (n : ℕ) :
    (MvPolynomial (Fin P.variableCount) A ⧸
        ((I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) ^ n)) ≃ₐ[A]
      MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n) :=
  (Ideal.quotientEquivAlgOfEq A (by rw [← Ideal.map_pow])).trans
    (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin P.variableCount) (I ^ n)).symm

/-- On the class of a polynomial, `polyQuotEquiv` reduces the coefficients modulo `Iⁿ`. -/
public theorem polyQuotEquiv_mk (n : ℕ) (q : MvPolynomial (Fin P.variableCount) A) :
    P.polyQuotEquiv n (Ideal.Quotient.mk _ q)
      = MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) q := by
  rw [MvPolynomial.map_eq_eval₂Hom_C_comp]
  rfl

/-- The reduction of coefficients `ψₙ : A⟨x₁, …, x_r⟩ → Aₙ[x₁, …, x_r]`: the evaluation
`AdicCompletion.evalₐ` at level `n`, followed by `polyQuotEquiv`. -/
public noncomputable def reductionAlgHom (n : ℕ) :
    P.extension.Ring →ₐ[A] MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n) :=
  (P.polyQuotEquiv n).toAlgHom.comp
    ((AdicCompletion.evalₐ (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) n
      ).restrictScalars A)

/-- `ψₙ` is surjective. -/
public theorem surjective_reductionAlgHom (n : ℕ) :
    Function.Surjective (P.reductionAlgHom n) :=
  (P.polyQuotEquiv n).surjective.comp (AdicCompletion.surjective_evalₐ _ n)

/-- On a polynomial, `ψₙ` reduces the coefficients modulo `Iⁿ`. -/
public theorem reductionAlgHom_polynomial (n : ℕ) (q : MvPolynomial (Fin P.variableCount) A) :
    P.reductionAlgHom n
        (algebraMap (MvPolynomial (Fin P.variableCount) A) P.completedPolynomialRing q)
      = MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) q := by
  have hof : algebraMap (MvPolynomial (Fin P.variableCount) A) P.completedPolynomialRing q =
      AdicCompletion.of (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A))
        (MvPolynomial (Fin P.variableCount) A) q := by
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply]
  have heval : (AdicCompletion.evalₐ
      (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) n).restrictScalars A
        (AdicCompletion.of (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A))
          (MvPolynomial (Fin P.variableCount) A) q)
      = Ideal.Quotient.mk _ q := AdicCompletion.evalₐ_of _ n q
  have hmain : (P.polyQuotEquiv n).toAlgHom.comp
      ((AdicCompletion.evalₐ (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) n
        ).restrictScalars A)
        (algebraMap (MvPolynomial (Fin P.variableCount) A) P.completedPolynomialRing q)
      = MvPolynomial.map (Ideal.Quotient.mk (I ^ n)) q := by
    rw [AlgHom.comp_apply, hof, heval]
    exact P.polyQuotEquiv_mk n q
  exact hmain

/-- `ψₙ` kills `Iⁿ A⟨x⟩`. -/
public theorem adicPow_le_ker_reductionAlgHom (n : ℕ) :
    P.adicPow n ≤ RingHom.ker (P.reductionAlgHom n).toRingHom := by
  refine Ideal.map_le_iff_le_comap.mpr fun a ha => Ideal.mem_comap.mpr ?_
  rw [RingHom.mem_ker]
  have hv : (P.reductionAlgHom n).toRingHom (algebraMap A P.extension.Ring a)
      = algebraMap A (MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n)) a :=
    (P.reductionAlgHom n).commutes a
  have hC : (algebraMap A (MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n)) a)
      = MvPolynomial.C (Ideal.Quotient.mk (I ^ n) a) := by
    rw [IsScalarTower.algebraMap_apply A (A ⧸ I ^ n)
      (MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n)), MvPolynomial.algebraMap_eq]
    rfl
  rw [hv, hC, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]

/-- `ψₙ` vanishes on `Iⁿ A⟨x⟩`, elementwise. -/
public theorem reductionAlgHom_eq_zero_of_mem (n : ℕ) {x : P.extension.Ring}
    (hx : x ∈ P.adicPow n) : P.reductionAlgHom n x = 0 :=
  RingHom.mem_ker.mp (P.adicPow_le_ker_reductionAlgHom n hx)

/-- `ψₙ` identifies two elements congruent modulo `Iⁿ A⟨x⟩`. -/
public theorem reductionAlgHom_eq_of_sub_mem (n : ℕ) {x y : P.extension.Ring}
    (h : x - y ∈ P.adicPow n) : P.reductionAlgHom n x = P.reductionAlgHom n y := by
  have h0 := P.reductionAlgHom_eq_zero_of_mem n h
  rwa [map_sub, sub_eq_zero] at h0

/-- The kernel of `ψₙ` is exactly `Iⁿ A⟨x⟩`. -/
public theorem ker_reductionAlgHom [IsNoetherianRing A] (n : ℕ) :
    RingHom.ker (P.reductionAlgHom n).toRingHom = P.adicPow n := by
  have key : ∀ y : P.completedPolynomialRing, P.reductionAlgHom n y = 0 →
      y ∈ P.completedAdicPow n := by
    intro x hx
    have hfg : (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)).FG :=
      (Ideal.fg_of_isNoetherianRing I).map _
    have heval : AdicCompletion.evalₐ
        (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) n x = 0 := by
      have h0 : P.polyQuotEquiv n (AdicCompletion.evalₐ
          (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) n x) = 0 := hx
      simpa using (P.polyQuotEquiv n).injective (h0.trans (map_zero _).symm)
    have hker : x ∈ LinearMap.ker (AdicCompletion.eval
        (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A))
        (MvPolynomial (Fin P.variableCount) A) n) := by
      rw [LinearMap.mem_ker, ← AdicCompletion.factor_evalₐ_eq_eval
        (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) x (by simp), heval, map_zero]
    rw [← AdicCompletion.pow_smul_top_eq_ker_eval hfg] at hker
    have hbridge := map_smul_top_le_map_smul_top (A := A)
      (R := MvPolynomial (Fin P.variableCount) A) (S := P.completedPolynomialRing)
      (M := P.completedPolynomialRing) (I ^ n)
    rw [Ideal.smul_eq_mul, Ideal.mul_top] at hbridge
    have hmap : (I ^ n).map (algebraMap A (MvPolynomial (Fin P.variableCount) A)) =
        (I.map (C : A →+* MvPolynomial (Fin P.variableCount) A)) ^ n := by
      rw [MvPolynomial.algebraMap_eq, Ideal.map_pow]
    rw [hmap] at hbridge
    have hres := hbridge hker
    rwa [Submodule.restrictScalars_mem] at hres
  exact le_antisymm (fun x hx => key x (RingHom.mem_ker.mp hx))
    (P.adicPow_le_ker_reductionAlgHom n)

/-- Evaluating `ψₙ f` at the generators of `Bₙ` gives the class in `Bₙ` of the image of `f`
in `B`. -/
public theorem aeval_reductionVal_reductionAlgHom [IsNoetherianRing A] (n : ℕ)
    (f : P.completedPolynomialRing) :
    MvPolynomial.aeval (P.reductionVal n) (P.reductionAlgHom n f)
      = Ideal.Quotient.mk (B.adicIdealPow n) (P.toAlgHom f) := by
  obtain ⟨q, hq⟩ := P.exists_sub_mem_adicPow n f
  have hz : P.reductionAlgHom n f
      = P.reductionAlgHom n
          (algebraMap (MvPolynomial (Fin P.variableCount) A) P.completedPolynomialRing q) :=
    P.reductionAlgHom_eq_of_sub_mem n hq
  have hB : Ideal.Quotient.mk (B.adicIdealPow n) (P.toAlgHom f)
      = Ideal.Quotient.mk (B.adicIdealPow n) (P.toAlgHom
          (algebraMap (MvPolynomial (Fin P.variableCount) A) P.completedPolynomialRing q)) := by
    refine Ideal.Quotient.eq.mpr ?_
    have hmem := P.toAlgHom_mem_adicIdealPow (n := n) hq
    rwa [map_sub] at hmem
  rw [hz, hB, P.reductionAlgHom_polynomial n q]
  exact P.aeval_reductionVal_map n q

/-- `ψₙ` as a morphism of presentations, from `B = A⟨x₁, …, x_r⟩ / J` over `A` to
`Bₙ = Aₙ[x₁, …, x_r] / Jₙ` over `Aₙ`. -/
public noncomputable def reductionHom [IsNoetherianRing A] (n : ℕ) :
    Algebra.Extension.Hom P.extension (P.reductionGenerators n).toExtension where
  toRingHom := (P.reductionAlgHom n).toRingHom
  toRingHom_algebraMap x := by
    have h := (P.reductionAlgHom n).commutes x
    rwa [IsScalarTower.algebraMap_apply A (A ⧸ I ^ n)
      (MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n))] at h
  algebraMap_toRingHom x := P.aeval_reductionVal_reductionAlgHom n x

/-! ## `Jₙ = ψₙ(J)`, and the conormal module in degree `-1` -/

/-- The preimage in `A⟨x⟩` of the ideal `IⁿB` is `Iⁿ A⟨x⟩ + J`. -/
public theorem comap_adicIdealPow (n : ℕ) :
    Ideal.comap P.toAlgHom.toRingHom (B.adicIdealPow n)
      = P.completedAdicPow n ⊔ RingHom.ker P.toAlgHom.toRingHom := by
  have hcomp : (P.toAlgHom.toRingHom).comp (algebraMap A P.completedPolynomialRing)
      = algebraMap A B.carrier := by
    ext a
    exact P.toAlgHom.commutes a
  have himg : Ideal.map P.toAlgHom.toRingHom (P.completedAdicPow n) = B.adicIdealPow n := by
    rw [Ideal.map_map, hcomp]
  rw [← himg, Ideal.comap_map_of_surjective P.toAlgHom.toRingHom P.toAlgHom_surjective,
    RingHom.ker_eq_comap_bot]

/-- An element of `A⟨x⟩` whose image in `B` lies in `IⁿB` is a sum of an element of `Iⁿ A⟨x⟩`
and one of `J`. -/
public theorem mem_adicPow_sup_ker (n : ℕ) {f : P.extension.Ring}
    (hf : algebraMap P.extension.Ring B.carrier f ∈ B.adicIdealPow n) :
    f ∈ P.adicPow n ⊔ P.extension.ker :=
  (P.comap_adicIdealPow n).le (Ideal.mem_comap.mpr hf)

/-- `Jₙ = ψₙ(J)`. -/
public theorem map_reductionAlgHom_ker [IsNoetherianRing A] (n : ℕ) :
    Ideal.map (P.reductionAlgHom n).toRingHom P.extension.ker
      = (P.reductionGenerators n).toExtension.ker := by
  apply le_antisymm
  · refine Ideal.map_le_iff_le_comap.mpr fun g hg => Ideal.mem_comap.mpr ?_
    have hg' : P.toAlgHom g = 0 := hg
    have hz : MvPolynomial.aeval (P.reductionVal n) (P.reductionAlgHom n g) = 0 := by
      rw [P.aeval_reductionVal_reductionAlgHom n g, hg', map_zero]
    exact hz
  · intro y hy
    obtain ⟨f, rfl⟩ := P.surjective_reductionAlgHom n y
    have hy' : MvPolynomial.aeval (P.reductionVal n) (P.reductionAlgHom n f) = 0 := hy
    have h0 : algebraMap P.extension.Ring B.carrier f ∈ B.adicIdealPow n := by
      have h := P.aeval_reductionVal_reductionAlgHom n f
      rw [hy'] at h
      exact Ideal.Quotient.eq_zero_iff_mem.mp h.symm
    obtain ⟨k, hk, j, hj, hkj⟩ := Submodule.mem_sup.mp (P.mem_adicPow_sup_ker n h0)
    have hsplit : P.reductionAlgHom n f = P.reductionAlgHom n j := by
      refine P.reductionAlgHom_eq_of_sub_mem n ?_
      have hfj : f - j = k := by rw [← hkj, add_sub_cancel_right]
      exact hfj ▸ hk
    rw [hsplit]
    exact Ideal.mem_map_of_mem _ hj

/-- Every element of `Jₙ` is `ψₙ` of an element of `J`. -/
public theorem exists_preimage_reductionGenerators_ker [IsNoetherianRing A] (n : ℕ)
    (y : MvPolynomial (Fin P.variableCount) (A ⧸ I ^ n))
    (hy : y ∈ (P.reductionGenerators n).toExtension.ker) :
    ∃ g ∈ P.extension.ker, P.reductionAlgHom n g = y := by
  have h1 : y ∈ Ideal.map (P.reductionAlgHom n).toRingHom P.extension.ker := by
    rwa [P.map_reductionAlgHom_ker n]
  exact (Ideal.mem_map_iff_of_surjective _ (P.surjective_reductionAlgHom n)).mp h1

/-- The map `J / J² → Jₙ / Jₙ²` induced by `ψₙ` is surjective. -/
public theorem surjective_cotangentMap_reductionHom [IsNoetherianRing A] (n : ℕ) :
    Function.Surjective (Algebra.Extension.Cotangent.map (P.reductionHom n)) := by
  intro x
  obtain ⟨g', rfl⟩ := Algebra.Extension.Cotangent.mk_surjective x
  obtain ⟨g, hg, hgy⟩ := P.exists_preimage_reductionGenerators_ker n _ g'.2
  refine ⟨Algebra.Extension.Cotangent.mk ⟨g, hg⟩, ?_⟩
  rw [Algebra.Extension.Cotangent.map_mk]
  congr 1
  exact Subtype.ext hgy

/-- The class of `g ∈ J` maps to zero in `Jₙ / Jₙ²` iff `ψₙ g ∈ Jₙ²`. -/
private theorem cotangentMap_reductionHom_mk_eq_zero_iff [IsNoetherianRing A] (n : ℕ)
    (g : P.extension.ker) :
    Algebra.Extension.Cotangent.map (P.reductionHom n) (Algebra.Extension.Cotangent.mk g) = 0 ↔
      P.reductionAlgHom n (g : P.extension.Ring) ∈
        ((P.reductionGenerators n).toExtension.ker) ^ 2 := by
  rw [Algebra.Extension.Cotangent.map_mk, Algebra.Extension.Cotangent.mk_eq_zero_iff]
  rfl

/-- The classes of `J ∩ Iⁿ A⟨x⟩` lie in the kernel of `J / J² → Jₙ / Jₙ²`. -/
public theorem conormalSub_le_ker_cotangentMap [IsNoetherianRing A] (n : ℕ) :
    P.conormalSub n ≤ LinearMap.ker (Algebra.Extension.Cotangent.map (P.reductionHom n)) := by
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨g, hg, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, P.cotangentMap_reductionHom_mk_eq_zero_iff,
    P.reductionAlgHom_eq_zero_of_mem n hg]
  exact Ideal.zero_mem _

/-- The kernel of `J / J² → Jₙ / Jₙ²` is exactly `conormalSub n`, the submodule generated by the
classes of `J ∩ Iⁿ A⟨x⟩`. -/
public theorem ker_cotangentMap_reductionHom [IsNoetherianRing A] (n : ℕ) :
    LinearMap.ker (Algebra.Extension.Cotangent.map (P.reductionHom n)) = P.conormalSub n := by
  refine le_antisymm (fun x hx => ?_) (P.conormalSub_le_ker_cotangentMap n)
  obtain ⟨g, rfl⟩ := Algebra.Extension.Cotangent.mk_surjective x
  have hx2 := (P.cotangentMap_reductionHom_mk_eq_zero_iff n g).mp hx
  have hsq : Ideal.map (P.reductionAlgHom n).toRingHom (P.extension.ker ^ 2)
      = ((P.reductionGenerators n).toExtension.ker) ^ 2 :=
    (Ideal.map_pow _ _ _).trans (congrArg (· ^ 2) (P.map_reductionAlgHom_ker n))
  have hmem : (g : P.extension.Ring) ∈ P.extension.ker ^ 2 ⊔ P.adicPow n := by
    have h1 : (g : P.extension.Ring) ∈ Ideal.comap (P.reductionAlgHom n).toRingHom
        (Ideal.map (P.reductionAlgHom n).toRingHom (P.extension.ker ^ 2)) :=
      Ideal.mem_comap.mpr (by rw [hsq]; exact hx2)
    rwa [Ideal.comap_map_of_surjective (P.reductionAlgHom n).toRingHom
      (P.surjective_reductionAlgHom n), ← RingHom.ker_eq_comap_bot,
      P.ker_reductionAlgHom n] at h1
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hmem
  have hyJ : y ∈ P.extension.ker := Ideal.pow_le_self two_ne_zero hy
  have hzJ : z ∈ P.extension.ker := by
    have hsub : z = (g : P.extension.Ring) - y := by rw [← hyz, add_sub_cancel_left]
    rw [hsub]
    exact Ideal.sub_mem _ g.2 hyJ
  have hsplit : Algebra.Extension.Cotangent.mk g
      = Algebra.Extension.Cotangent.mk (⟨y, hyJ⟩ : P.extension.ker)
        + Algebra.Extension.Cotangent.mk (⟨z, hzJ⟩ : P.extension.ker) := by
    rw [← map_add]
    congr 1
    exact Subtype.ext hyz.symm
  rw [hsplit, (Algebra.Extension.Cotangent.mk_eq_zero_iff (⟨y, hyJ⟩ : P.extension.ker)).mpr hy,
    zero_add]
  exact P.mk_mem_conormalSub ⟨z, hzJ⟩ hz

/-- The isomorphism `(J / J²) / ⟨image of J ∩ Iⁿ A⟨x⟩⟩ ≃ Jₙ / Jₙ²`. -/
public noncomputable def cotangentQuotConormalSubEquiv [IsNoetherianRing A] (n : ℕ) :
    (P.extension.Cotangent ⧸ P.conormalSub n) ≃ₗ[B.carrier]
      (P.reductionGenerators n).toExtension.Cotangent :=
  (Submodule.quotEquivOfEq _ _ (P.ker_cotangentMap_reductionHom n).symm).trans
    (LinearMap.quotKerEquivOfSurjective _ (P.surjective_cotangentMap_reductionHom n))

end CompletedPolynomialPresentation

end Rig

end
