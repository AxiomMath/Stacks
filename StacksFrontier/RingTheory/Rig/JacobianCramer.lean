module

public import Mathlib.Algebra.Module.LocalizedModule.Exact
public import Mathlib.RingTheory.Localization.Module
public import StacksFrontier.RingTheory.Fitting.Rank

/-!
# Fitting ideals of a two-term complex `M → Rʳ`

Let `R` be a Noetherian ring, `I ⊆ R` an ideal, `M` a finite `R`-module and
`d : M → Rʳ` an `R`-linear map. This file proves that

* the cohomology of `M → Rʳ` is annihilated by a power of `I`

is equivalent to

* the ideals `Fit_r(M)` and `Fit_0(coker d)` each contain a power of `I`.

This is the purely algebraic statement isolated in the last two paragraphs of the proof of
**Stacks 0AJU**, where it supplies the equivalence of the cohomological criterion for
rig-étaleness with the Jacobian–Cramer ideal criterion: the Cramer ideal of a completed
presentation `B = A[x₁, …, x_r]^/J` is `Fit_r(J/J²)` and its Jacobian ideal is
`Fit_0(H⁰(NL^_{B/A}))`.

## Main results

* `Rig.exists_pow_le_annihilator_iff_support_subset`: for a finite module, some power of `I`
  annihilates it exactly when its support lies in `V(I)`.
* `Rig.injective_localizedMap_iff` and `Rig.surjective_localizedMap_iff`: a prime lies outside
  the support of `ker d`, resp. of `coker d`, exactly when `d` becomes injective, resp.
  surjective, after localizing there.
* `Rig.exists_pow_le_annihilator_iff_exists_pow_le_fittingIdeal`: the equivalence above.

## Implementation notes

Both sides of the equivalence are first rewritten as inclusions of closed subsets of
`Spec R`, which is legitimate because `R` is Noetherian, so an ideal contains a power of `I`
exactly when its zero locus is contained in `V(I)`
(`Rig.exists_pow_le_iff_zeroLocus_subset`). The second halves of the two sides then agree
on the nose, since `V(Fit_0 N) = Supp N` for a finite module `N`.

What is left is a statement about a single prime `p` outside `V(I)`: given that `d` is
surjective after localizing at `p`, it is injective there exactly when `M_p` is generated by
`r` elements, which is `Fit_r(M) ⊄ p` by Stacks 07ZC. The `⟸` direction is the usual
argument that a surjective endomorphism of a finitely generated module over a Noetherian ring
is injective, applied to `Rᵖ ↠ M_p → (Rʳ)_p ≅ Rᵖ`, where the last identification comes from
the localized standard basis.

Localization of `ker d` and of `coker d` is handled by exactness of localization
(`LocalizedModule.map_exact`) rather than by computing them.

## References

* [Stacks Project, Tag 0AJU](https://stacks.math.columbia.edu/tag/0AJU)
* [Stacks Project, Tag 07ZC](https://stacks.math.columbia.edu/tag/07ZC)
-/

universe u v

@[expose] public section

namespace Rig

variable {R : Type u} [CommRing R]

/-- Over a Noetherian ring an ideal `K` contains a power of `I` exactly when the zero locus of
`K` is contained in the zero locus of `I`. -/
theorem exists_pow_le_iff_zeroLocus_subset [IsNoetherianRing R] (I K : Ideal R) :
    (∃ c : ℕ, I ^ c ≤ K) ↔
      PrimeSpectrum.zeroLocus (K : Set R) ⊆ PrimeSpectrum.zeroLocus (I : Set R) := by
  rw [PrimeSpectrum.zeroLocus_subset_zeroLocus_iff]
  exact ⟨fun ⟨c, hc⟩ _ hx => Ideal.mem_radical_iff.2 ⟨c, hc (Ideal.pow_mem_pow hx c)⟩,
    fun h => Ideal.exists_pow_le_of_le_radical_of_fg h (IsNoetherian.noetherian I)⟩

/-- A finite module over a Noetherian ring is annihilated by a power of `I` exactly when its
support is contained in `V(I)`. -/
theorem exists_pow_le_annihilator_iff_support_subset [IsNoetherianRing R] (I : Ideal R)
    (N : Type v) [AddCommGroup N] [Module R N] [Module.Finite R N] :
    (∃ c : ℕ, I ^ c ≤ Module.annihilator R N) ↔
      Module.support R N ⊆ PrimeSpectrum.zeroLocus (I : Set R) := by
  rw [Module.support_eq_zeroLocus]
  exact exists_pow_le_iff_zeroLocus_subset I _

section Localized

variable {M : Type v} [AddCommGroup M] [Module R M] {r : ℕ}

/-- The localization of `d : M → Rʳ` at a prime `p` is surjective exactly when `p` lies outside
the support of the cokernel of `d`. -/
theorem surjective_localizedMap_iff (d : M →ₗ[R] (Fin r → R)) (p : PrimeSpectrum R) :
    Function.Surjective (LocalizedModule.map p.asIdeal.primeCompl d) ↔
      p ∉ Module.support R ((Fin r → R) ⧸ LinearMap.range d) := by
  set S := p.asIdeal.primeCompl with hS
  rw [Module.notMem_support_iff]
  have hex : Function.Exact (LocalizedModule.map S d)
      (LocalizedModule.map S (LinearMap.range d).mkQ) :=
    LocalizedModule.map_exact S d _ (LinearMap.exact_map_mkQ_range d)
  have hq : Function.Surjective (LocalizedModule.map S (LinearMap.range d).mkQ) :=
    LocalizedModule.map_surjective S _ (Submodule.mkQ_surjective _)
  constructor
  · intro hsurj
    have hzero : ∀ y, LocalizedModule.map S (LinearMap.range d).mkQ y = 0 := fun y =>
      (hex y).2 (hsurj y)
    exact ⟨fun a b => by
      obtain ⟨x, rfl⟩ := hq a
      obtain ⟨y, rfl⟩ := hq b
      rw [hzero, hzero]⟩
  · intro _ y
    exact (hex y).1 (Subsingleton.elim _ _)

/-- The localization of `d : M → Rʳ` at a prime `p` is injective exactly when `p` lies outside
the support of the kernel of `d`. -/
theorem injective_localizedMap_iff (d : M →ₗ[R] (Fin r → R)) (p : PrimeSpectrum R) :
    Function.Injective (LocalizedModule.map p.asIdeal.primeCompl d) ↔
      p ∉ Module.support R ↥(LinearMap.ker d) := by
  set S := p.asIdeal.primeCompl with hS
  rw [Module.notMem_support_iff]
  have hex : Function.Exact (LocalizedModule.map S (LinearMap.ker d).subtype)
      (LocalizedModule.map S d) :=
    LocalizedModule.map_exact S _ d (LinearMap.exact_subtype_ker_map d)
  have hinj : Function.Injective (LocalizedModule.map S (LinearMap.ker d).subtype) :=
    LocalizedModule.map_injective S _ (Submodule.injective_subtype _)
  constructor
  · intro hD
    have h1 : ∀ x, LocalizedModule.map S (LinearMap.ker d).subtype x = 0 := by
      intro x
      refine hD ?_
      rw [map_zero]
      exact (hex _).2 ⟨x, rfl⟩
    exact ⟨fun a b => hinj (by rw [h1, h1])⟩
  · intro _
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨x, hx⟩ := (hex y).1 hy
    rw [← hx, Subsingleton.elim x 0, map_zero]

/-- If `d : M → Rʳ` is surjective after localizing at `S`, then it is injective there exactly
when the localization of `M` is generated by `r` elements. -/
theorem injective_localizedMap_iff_exists_span_eq_top
    [IsNoetherianRing R] (d : M →ₗ[R] (Fin r → R)) (S : Submonoid R)
    (hsurj : Function.Surjective (LocalizedModule.map S d)) :
    Function.Injective (LocalizedModule.map S d) ↔
      ∃ g : Fin r → LocalizedModule S M,
        Submodule.span (Localization S) (Set.range g) = ⊤ := by
  have hNoeth : IsNoetherianRing (Localization S) :=
    IsLocalization.isNoetherianRing S _ inferInstance
  let bN : Module.Basis (Fin r) (Localization S) (LocalizedModule S (Fin r → R)) :=
    (Pi.basisFun R (Fin r)).ofIsLocalizedModule (Localization S) S
      (LocalizedModule.mkLinearMap S (Fin r → R))
  constructor
  · intro hinj
    let e := LinearEquiv.ofBijective (LocalizedModule.map S d) ⟨hinj, hsurj⟩
    refine ⟨fun i => e.symm (bN i), ?_⟩
    have hrange : Set.range (fun i => e.symm (bN i)) =
        (e.symm : LocalizedModule S (Fin r → R) → LocalizedModule S M) '' Set.range bN :=
      Set.range_comp _ _
    rw [hrange, ← LinearEquiv.coe_coe, ← Submodule.map_span, bN.span_eq, Submodule.map_top]
    exact e.symm.range
  · rintro ⟨g, hg⟩
    set ψ := Fintype.linearCombination (Localization S) g with hψdef
    have hψ : Function.Surjective ψ := by
      rw [← LinearMap.range_eq_top, hψdef, Fintype.range_linearCombination, hg]
    set θ := (bN.equivFun.toLinearMap).comp ((LocalizedModule.map S d).comp ψ) with hθdef
    have hθ : Function.Surjective θ := by
      rw [hθdef]
      exact bN.equivFun.surjective.comp (hsurj.comp hψ)
    have hθinj : Function.Injective θ :=
      IsNoetherian.injective_of_surjective_endomorphism θ hθ
    intro m m' hmm
    obtain ⟨x, rfl⟩ := hψ m
    obtain ⟨x', rfl⟩ := hψ m'
    refine congrArg ψ (hθinj ?_)
    rw [hθdef]
    simp only [LinearMap.comp_apply]
    rw [hmm]

/-- Away from `V(I)`, the kernel of `d : M → Rʳ` vanishes exactly where `Fit_r(M)` is the unit
ideal, provided the cokernel of `d` already vanishes there. -/
theorem notMem_support_ker_iff_not_fittingIdeal_le
    [IsNoetherianRing R] [Module.Finite R M] (d : M →ₗ[R] (Fin r → R)) (p : PrimeSpectrum R)
    (hC : p ∉ Module.support R ((Fin r → R) ⧸ LinearMap.range d)) :
    p ∉ Module.support R ↥(LinearMap.ker d) ↔
      ¬ (fittingIdeal (R := R) (M := M) (r : ℤ) ≤ p.asIdeal) := by
  have hp := p.isPrime
  rw [← injective_localizedMap_iff d p,
    injective_localizedMap_iff_exists_span_eq_top d _
      ((surjective_localizedMap_iff d p).2 hC)]
  exact (fittingIdeal_local_generation_tfae r p.asIdeal).out 3 1

/-- **The algebraic core of Stacks 0AJU.** Let `R` be a Noetherian ring, `I ⊆ R` an ideal, `M` a
finite `R`-module and `d : M → Rʳ` an `R`-linear map. The cohomology of the two-term complex
`M → Rʳ` is annihilated by a power of `I` if and only if the ideals `Fit_r(M)` and
`Fit_0(coker d)` each contain a power of `I`. -/
theorem exists_pow_le_annihilator_iff_exists_pow_le_fittingIdeal
    [IsNoetherianRing R] [Module.Finite R M] (I : Ideal R) (d : M →ₗ[R] (Fin r → R)) :
    ((∃ c : ℕ, I ^ c ≤ Module.annihilator R ↥(LinearMap.ker d)) ∧
        ∃ c : ℕ, I ^ c ≤ Module.annihilator R ((Fin r → R) ⧸ LinearMap.range d)) ↔
      ((∃ c : ℕ, I ^ c ≤ fittingIdeal (R := R) (M := M) (r : ℤ)) ∧
        ∃ c : ℕ, I ^ c ≤
          fittingIdeal (R := R) (M := (Fin r → R) ⧸ LinearMap.range d) 0) := by
  have hcoker :
      PrimeSpectrum.zeroLocus
          ((fittingIdeal (R := R) (M := (Fin r → R) ⧸ LinearMap.range d) 0 : Ideal R) : Set R) =
        Module.support R ((Fin r → R) ⧸ LinearMap.range d) :=
    (fittingIdeal_basic_properties.{u, u, u, u}
      (R := R) (M := (Fin r → R) ⧸ LinearMap.range d)).2.2.2.2.2.2.1
  rw [exists_pow_le_annihilator_iff_support_subset I ↥(LinearMap.ker d),
    exists_pow_le_annihilator_iff_support_subset I ((Fin r → R) ⧸ LinearMap.range d),
    exists_pow_le_iff_zeroLocus_subset I (fittingIdeal (R := R) (M := M) (r : ℤ)),
    exists_pow_le_iff_zeroLocus_subset I
      (fittingIdeal (R := R) (M := (Fin r → R) ⧸ LinearMap.range d) 0),
    hcoker]
  refine and_congr_left_iff.2 fun h2 => forall_congr' fun p => ?_
  by_cases hpI : p ∈ PrimeSpectrum.zeroLocus (I : Set R)
  · exact iff_of_true (fun _ => hpI) (fun _ => hpI)
  · have hC : p ∉ Module.support R ((Fin r → R) ⧸ LinearMap.range d) := fun h => hpI (h2 h)
    simpa only [hpI, imp_false, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] using
      notMem_support_ker_iff_not_fittingIdeal_le d p hC

end Localized

end Rig

end
