module

public import Mathlib.Order.Filter.AtTopBot.Basic
public import Mathlib.Order.Filter.Finite
public import Mathlib.RingTheory.FinitePresentation

/-!
# Bijectivity modulo a directed union of ideals descends to one of them

Let `φ : P → Q` be a map of finitely presented `R`-algebras and let `(I k)` be a directed family
of ideals of `R`. If `φ` becomes bijective modulo `⨆ k, I k`, that is if
`P / (⨆ I) P → Q / (⨆ I) Q` is bijective, then it is already bijective modulo some `I k`, and
then modulo every larger `I k'`.

This is the commutative-algebra step of the proof of Stacks 07SQ (if the limit of a directed
inverse system of quasi-compact and quasi-separated algebraic spaces with affine transition maps
is affine, then some member of the system is affine), of the same kind as the descent arguments
of Stacks 00QO. Surjectivity descends because `Q` is
generated by finitely many elements; injectivity descends because the kernel of a surjection
between finitely presented algebras is finitely generated
(`Algebra.FinitePresentation.ker_fG_of_surjective`), so only finitely many elements have to be
killed. The proof never passes to the quotient rings `R / I k`: the finiteness is extracted over
`R` itself, from the quotient of `Q` by a finitely generated ideal.

## Main results

* `Algebra.FinitePresentation.exists_bijective_quotientMap_of_bijective_iSup`: bijectivity
  modulo `⨆ k, I k` implies bijectivity modulo some `I k`.
* `Ideal.bijective_quotientMap_of_le`: bijectivity modulo `I k` implies
  bijectivity modulo every `I k'` with `k ≤ k'`.
* `Ideal.bijective_quotientMap_of_surjective`: the criterion behind both,
  bijectivity modulo `A` from a surjection `P → Q / L` with `L ⊆ A Q` and `φ⁻¹ L ⊆ A P`.
-/

@[expose] public section

open Filter

/-- An element of the extension of a directed union of ideals lies in the extension of all
sufficiently late members of the family. -/
theorem Ideal.eventually_mem_map_of_mem_map_iSup {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) {κ : Type*} [Nonempty κ] [Preorder κ] [IsDirected κ (· ≤ ·)]
    {I : κ → Ideal R} (hI : Monotone I) {x : S} (hx : x ∈ (⨆ k, I k).map f) :
    ∀ᶠ k in atTop, x ∈ (I k).map f := by
  rw [Ideal.map_iSup] at hx
  obtain ⟨k, hk⟩ := (Submodule.mem_iSup_of_directed _
    (Monotone.directed_le fun _ _ h => Ideal.map_mono (hI h))).mp hx
  exact eventually_atTop.mpr ⟨k, fun _ h => Ideal.map_mono (hI h) hk⟩

variable {R P Q : Type*} [CommRing R] [CommRing P] [CommRing Q] [Algebra R P] [Algebra R Q]

/-- An `R`-algebra map `φ : P → Q` carries the extension `A P` of an ideal `A` of `R` into its
extension `A Q`; this is what makes `P / A P → Q / A Q` well defined. -/
theorem AlgHom.map_algebraMap_le_comap (φ : P →ₐ[R] Q) (A : Ideal R) :
    A.map (algebraMap R P) ≤ (A.map (algebraMap R Q)).comap φ.toRingHom :=
  Ideal.map_le_iff_le_comap.mp (by
    rw [Ideal.map_map, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap])

namespace Ideal

/-- A criterion for `P / A P → Q / A Q` to be bijective: there is an ideal `L ⊆ A Q` of `Q` such
that `P → Q / L` is surjective and `φ⁻¹ L ⊆ A P`. -/
theorem bijective_quotientMap_of_surjective (φ : P →ₐ[R] Q) {L : Ideal Q}
    (hL : Function.Surjective ((Ideal.Quotient.mkₐ R L).comp φ)) {A : Ideal R}
    (hLQ : L ≤ A.map (algebraMap R Q)) (hLP : L.comap φ.toRingHom ≤ A.map (algebraMap R P)) :
    Function.Bijective (Ideal.quotientMap (A.map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap A)) := by
  refine ⟨Ideal.quotientMap_injective' fun y hy => ?_, fun z => ?_⟩
  · have hmap : (A.map (algebraMap R Q)).map (Ideal.Quotient.mk L) =
        (A.map (algebraMap R P)).map ((Ideal.Quotient.mkₐ R L).comp φ).toRingHom := by
      simp only [Ideal.map_map]
      congr 1
      ext r
      simp
    have hy' : Ideal.Quotient.mk L (φ y) ∈ (A.map (algebraMap R Q)).map (Ideal.Quotient.mk L) :=
      Ideal.mem_map_of_mem _ hy
    rw [hmap] at hy'
    obtain ⟨p, hp, hpy⟩ :=
      (Ideal.mem_map_iff_of_surjective ((Ideal.Quotient.mkₐ R L).comp φ).toRingHom hL).mp hy'
    have hyp : y - p ∈ L.comap φ.toRingHom := by
      rw [Ideal.mem_comap, map_sub]
      exact Ideal.Quotient.eq.mp hpy.symm
    simpa using add_mem (hLP hyp) hp
  · obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨p, hp⟩ := hL (Ideal.Quotient.mk L q)
    refine ⟨Ideal.Quotient.mk _ p, ?_⟩
    rw [Ideal.quotientMap_mk]
    exact Ideal.Quotient.eq.mpr (hLQ (Ideal.Quotient.eq.mp hp))

/-- If `φ : P → Q` is bijective modulo `A`, every element of `Q` is the image of an element of `P`
modulo `A Q`. -/
private theorem exists_sub_mem_of_bijective_quotientMap (φ : P →ₐ[R] Q) {A : Ideal R}
    (h : Function.Bijective (Ideal.quotientMap (A.map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap A)))
    (q : Q) : ∃ p : P, φ p - q ∈ A.map (algebraMap R Q) := by
  obtain ⟨a, ha⟩ := h.2 (Ideal.Quotient.mk _ q)
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [Ideal.quotientMap_mk] at ha
  exact ⟨p, Ideal.Quotient.eq.mp ha⟩

/-- If `φ : P → Q` is bijective modulo `A` and `φ y ∈ A Q`, then `y ∈ A P`. -/
private theorem mem_map_of_bijective_quotientMap (φ : P →ₐ[R] Q) {A : Ideal R}
    (h : Function.Bijective (Ideal.quotientMap (A.map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap A)))
    {y : P} (hy : φ y ∈ A.map (algebraMap R Q)) : y ∈ A.map (algebraMap R P) := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  apply h.1
  rw [Ideal.quotientMap_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
  exact hy

/-- If `φ : P → Q` is bijective modulo an ideal `A` of `R`, then it is bijective modulo every
larger ideal `B`. -/
theorem bijective_quotientMap_of_le (φ : P →ₐ[R] Q) {A B : Ideal R} (hAB : A ≤ B)
    (h : Function.Bijective (Ideal.quotientMap (A.map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap A))) :
    Function.Bijective (Ideal.quotientMap (B.map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap B)) := by
  refine bijective_quotientMap_of_surjective φ (L := A.map (algebraMap R Q)) (fun z => ?_)
    (Ideal.map_mono hAB) fun y hy => Ideal.map_mono hAB ?_
  · obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨p, hp⟩ := exists_sub_mem_of_bijective_quotientMap φ h q
    exact ⟨p, Ideal.Quotient.eq.mpr hp⟩
  · exact mem_map_of_bijective_quotientMap φ h hy

end Ideal

namespace Algebra.FinitePresentation

/-- Let `φ : P → Q` be a map of finitely presented `R`-algebras and let `I` be a monotone family
of ideals of `R` over a directed index type. If `φ` is bijective modulo `⨆ k, I k`, then it is
bijective modulo some `I k`.

This is the commutative-algebra step of the proof of Stacks 07SQ. -/
theorem exists_bijective_quotientMap_of_bijective_iSup
    [Algebra.FinitePresentation R P] [Algebra.FinitePresentation R Q] (φ : P →ₐ[R] Q)
    {κ : Type*} [Nonempty κ] [Preorder κ] [IsDirected κ (· ≤ ·)] (I : κ → Ideal R)
    (hI : Monotone I)
    (h : Function.Bijective (Ideal.quotientMap ((⨆ k, I k).map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap (⨆ k, I k)))) :
    ∃ k, Function.Bijective (Ideal.quotientMap ((I k).map (algebraMap R Q)) φ.toRingHom
      (φ.map_algebraMap_le_comap (I k))) := by
  classical
  -- every element of `Q` is the image of an element of `P` modulo `(⨆ I) Q`
  have hsurj := Ideal.exists_sub_mem_of_bijective_quotientMap φ h
  choose p hp using hsurj
  -- the finitely many errors on a finite generating set of `Q` generate an ideal `L`
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := Q)
  let L : Ideal Q := Ideal.span ((fun q => φ (p q) - q) '' s)
  have hLfg : L.FG := ⟨s.image fun q => φ (p q) - q, by simp [L]⟩
  have hLJ : L ≤ (⨆ k, I k).map (algebraMap R Q) :=
    Ideal.span_le.mpr (by rintro _ ⟨q, -, rfl⟩; exact hp q)
  -- `P → Q / L` is surjective, between finitely presented `R`-algebras
  have hπ : Function.Surjective ((Ideal.Quotient.mkₐ R L).comp φ) := by
    have htop : (⊤ : Subalgebra R Q) ≤
        ((Ideal.Quotient.mkₐ R L).comp φ).range.comap (Ideal.Quotient.mkₐ R L) := by
      rw [← hs, Algebra.adjoin_le_iff]
      intro q hq
      exact ⟨p q, Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨q, hq, rfl⟩)⟩
    intro z
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact htop (Algebra.mem_top (x := q))
  have := Algebra.FinitePresentation.quotient (R := R) hLfg
  -- so its kernel `φ⁻¹ L` is generated by a finite set `G`, which dies modulo `(⨆ I) P`
  obtain ⟨G, hG⟩ := Algebra.FinitePresentation.ker_fG_of_surjective _ hπ
  have hGJ : ∀ g ∈ G, g ∈ (⨆ k, I k).map (algebraMap R P) := by
    intro g hg
    have hg' : g ∈ RingHom.ker ((Ideal.Quotient.mkₐ R L).comp φ).toRingHom :=
      hG ▸ Ideal.subset_span hg
    have hφg : φ g ∈ L := Ideal.Quotient.eq_zero_iff_mem.mp hg'
    exact Ideal.mem_map_of_bijective_quotientMap φ h (hLJ hφg)
  -- choose `k` large enough for the finitely many generators of `L` and of `φ⁻¹ L`
  have hk : ∀ᶠ k in atTop, (∀ q ∈ s, φ (p q) - q ∈ (I k).map (algebraMap R Q)) ∧
      ∀ g ∈ G, g ∈ (I k).map (algebraMap R P) :=
    ((eventually_all_finset s).mpr fun q _ =>
      Ideal.eventually_mem_map_of_mem_map_iSup _ hI (hp q)).and
      ((eventually_all_finset G).mpr fun g hg =>
        Ideal.eventually_mem_map_of_mem_map_iSup _ hI (hGJ g hg))
  obtain ⟨k, hks, hkG⟩ := hk.exists
  refine ⟨k, Ideal.bijective_quotientMap_of_surjective φ hπ
    (Ideal.span_le.mpr (by rintro _ ⟨q, hq, rfl⟩; exact hks q hq)) fun y hy => ?_⟩
  have hy' : y ∈ RingHom.ker ((Ideal.Quotient.mkₐ R L).comp φ).toRingHom :=
    Ideal.Quotient.eq_zero_iff_mem.mpr hy
  rw [← hG] at hy'
  exact Ideal.span_le.mpr hkG hy'

end Algebra.FinitePresentation
