module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import Mathlib.RingTheory.FinitePresentation
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.RingTheory.RingHom.Finite
public import Mathlib.RingTheory.RingHom.FinitePresentation
public import StacksCore.Tactic.StacksAttribute

/-!
# An integral algebra as a filtered colimit of finite, finitely presented algebras

Let `R → A` be an integral ring map. This file exhibits `A` as the colimit of a directed system
of `R`-algebras each of which is simultaneously a finite `R`-module and of finite presentation
over `R`. This is the affine form of part (2) of [Stacks, Tag 0817].

The system is indexed by `Stacks.RingTheory.IntegralFiniteColimit.Index R A`: a pair of a finite
set `gens ⊆ A` of generators and a finite set `rels` of polynomial relations, the latter living in
the polynomial ring `MvPolynomial A R` on the whole of `A` so that the index type carries no
dependency and is ordered by componentwise inclusion. The algebra attached to an index is
`MvPolynomial ↥gens R` modulo the ideal generated by one monic relation for each generator
together with those members of `rels` that both involve only the chosen generators and vanish in
`A`.

## Main definitions

* `Stacks.RingTheory.IntegralFiniteColimit.Index`: the index type, a nonempty directed preorder.
* `Stacks.RingTheory.IntegralFiniteColimit.Stage`: the algebra attached to an index.
* `Stacks.RingTheory.IntegralFiniteColimit.diagram`: the resulting functor to `CommRingCat`,
  with `structureMap` the family of structure maps from `R` and `cocone` the family of maps to
  `A`.

## Main results

* `Stacks.RingTheory.IntegralFiniteColimit.nonempty_isColimitCocone`: the cocone with point `A`
  is a colimit, and `Stacks.RingTheory.IntegralFiniteColimit.isColimitCocone` a chosen witness.
* `Stacks.RingTheory.IntegralFiniteColimit.moduleFinite_stage` and
  `Stacks.RingTheory.IntegralFiniteColimit.finitePresentation_stage`: every stage is a finite
  `R`-module and of finite presentation over `R`.
* `Stacks.RingTheory.IntegralFiniteColimit.exists_isColimit_finite_finitePresentation`: the
  packaged statement, phrased for a morphism of `CommRingCat`.

## Implementation notes

Nothing in this file is tagged with [Stacks, Tag 0817]: that tag is a statement about
quasi-coherent algebras on a quasi-compact and quasi-separated scheme, and what is proved here is
only its restriction to an affine scheme, stated in commutative-algebra terms.

## References

* [Stacks Project, Tag 0817](https://stacks.math.columbia.edu/tag/0817)
* [Stacks Project, Tag 09YZ](https://stacks.math.columbia.edu/tag/09YZ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.RingTheory.IntegralFiniteColimit

variable (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]

/-- Evaluation of the polynomial ring on the underlying set of `A`, sending the variable `X a`
to `a`. -/
noncomputable def ev : MvPolynomial A R →ₐ[R] A := MvPolynomial.aeval id

/-- `Stacks.RingTheory.IntegralFiniteColimit.ev` sends the variable `X a` to `a`. -/
@[simp]
theorem ev_X (a : A) : ev R A (MvPolynomial.X a) = a := by simp [ev]

/-- The index type of the approximating system: a finite set of generators in `A` together with a
finite set of polynomial relations, taken in the polynomial ring on all of `A`. -/
structure Index where
  /-- The chosen finite set of generators of `A`. -/
  gens : Finset A
  /-- The chosen finite set of relations, as polynomials in the variables indexed by `A`. -/
  rels : Finset (MvPolynomial A R)

variable {R A}

/-- Indices are ordered by componentwise inclusion. -/
instance : Preorder (Index R A) where
  le i j := i.gens ⊆ j.gens ∧ i.rels ⊆ j.rels
  le_refl _ := ⟨Finset.Subset.refl _, Finset.Subset.refl _⟩
  le_trans _ _ _ h₁ h₂ := ⟨h₁.1.trans h₂.1, h₁.2.trans h₂.2⟩

/-- The index with no generators and no relations. -/
instance : Nonempty (Index R A) := ⟨⟨∅, ∅⟩⟩

/-- Two indices are bounded above by their componentwise union. -/
instance : IsDirected (Index R A) (· ≤ ·) := by
  classical
  refine ⟨fun i j => ⟨⟨i.gens ∪ j.gens, i.rels ∪ j.rels⟩, ⟨?_, ?_⟩, ?_, ?_⟩⟩ <;>
    simp [Finset.subset_union_left, Finset.subset_union_right]

variable (R A) in
/-- A monic polynomial over `R` annihilating a given element of an integral algebra. -/
noncomputable def monicOf [Algebra.IsIntegral R A] (a : A) : Polynomial R :=
  (show ∃ p : Polynomial R, p.Monic ∧ Polynomial.aeval a p = 0 from
    Algebra.IsIntegral.isIntegral a).choose

/-- `Stacks.RingTheory.IntegralFiniteColimit.monicOf R A a` is monic. -/
theorem monicOf_monic [Algebra.IsIntegral R A] (a : A) : (monicOf R A a).Monic :=
  (show ∃ p : Polynomial R, p.Monic ∧ Polynomial.aeval a p = 0 from
    Algebra.IsIntegral.isIntegral a).choose_spec.1

/-- `Stacks.RingTheory.IntegralFiniteColimit.monicOf R A a` annihilates `a`. -/
@[simp]
theorem aeval_monicOf [Algebra.IsIntegral R A] (a : A) :
    Polynomial.aeval a (monicOf R A a) = 0 :=
  (show ∃ p : Polynomial R, p.Monic ∧ Polynomial.aeval a p = 0 from
    Algebra.IsIntegral.isIntegral a).choose_spec.2

section Basic

/-- The polynomial ring on the generators chosen by an index. -/
abbrev Poly (i : Index R A) : Type u := MvPolynomial ↥i.gens R

/-- The inclusion of the polynomial ring on the generators chosen by an index into the polynomial
ring on all of `A`. -/
noncomputable def amb (i : Index R A) : Poly i →ₐ[R] MvPolynomial A R :=
  MvPolynomial.rename Subtype.val

/-- Evaluation of the polynomial ring on the generators chosen by an index. -/
noncomputable def evalPoly (i : Index R A) : Poly i →ₐ[R] A :=
  MvPolynomial.aeval Subtype.val

/-- The inclusion of the polynomial ring on the generators of one index into that of a larger
index. -/
noncomputable def renameLE {i j : Index R A} (h : i ≤ j) : Poly i →ₐ[R] Poly j :=
  MvPolynomial.rename fun x => ⟨x.1, h.1 x.2⟩

omit [CommRing A] [Algebra R A] in
/-- `Stacks.RingTheory.IntegralFiniteColimit.amb` sends the variable `X x` to `X x`. -/
@[simp]
theorem amb_X (i : Index R A) (x : ↥i.gens) : amb i (MvPolynomial.X x) = MvPolynomial.X x.1 := by
  simp [amb]

/-- `Stacks.RingTheory.IntegralFiniteColimit.evalPoly` sends the variable `X x` to `x`. -/
@[simp]
theorem evalPoly_X (i : Index R A) (x : ↥i.gens) : evalPoly i (MvPolynomial.X x) = x.1 := by
  simp [evalPoly]

omit [CommRing A] [Algebra R A] in
/-- `Stacks.RingTheory.IntegralFiniteColimit.renameLE` sends the variable `X x` to `X x`. -/
@[simp]
theorem renameLE_X {i j : Index R A} (h : i ≤ j) (x : ↥i.gens) :
    renameLE h (MvPolynomial.X x) = MvPolynomial.X ⟨x.1, h.1 x.2⟩ := by
  simp [renameLE]

omit [CommRing A] [Algebra R A] in
/-- The inclusions into the polynomial ring on all of `A` commute with
`Stacks.RingTheory.IntegralFiniteColimit.renameLE`. -/
theorem amb_renameLE {i j : Index R A} (h : i ≤ j) (F : Poly i) :
    amb j (renameLE h F) = amb i F := by
  simp only [amb, renameLE, MvPolynomial.rename_rename]
  rfl

/-- Evaluation commutes with `Stacks.RingTheory.IntegralFiniteColimit.renameLE`. -/
theorem evalPoly_renameLE {i j : Index R A} (h : i ≤ j) (F : Poly i) :
    evalPoly j (renameLE h F) = evalPoly i F := by
  simp only [evalPoly, renameLE, MvPolynomial.aeval_rename]
  rfl

end Basic

section Stage

variable [Algebra.IsIntegral R A]

/-- The monic relation imposed on the generator `x`. -/
noncomputable def monicRel (i : Index R A) (x : ↥i.gens) : Poly i :=
  Polynomial.aeval (MvPolynomial.X x) (monicOf R A x.1)

/-- The monic relation of a generator vanishes in `A`. -/
theorem evalPoly_monicRel (i : Index R A) (x : ↥i.gens) : evalPoly i (monicRel i x) = 0 := by
  rw [monicRel, ← Polynomial.aeval_algHom_apply, evalPoly_X, aeval_monicOf]

/-- `Stacks.RingTheory.IntegralFiniteColimit.renameLE` sends the monic relation of a generator
to the monic relation of the same generator. -/
theorem renameLE_monicRel {i j : Index R A} (h : i ≤ j) (x : ↥i.gens) :
    renameLE h (monicRel i x) = monicRel j ⟨x.1, h.1 x.2⟩ := by
  rw [monicRel, monicRel, ← Polynomial.aeval_algHom_apply, renameLE_X]

/-- The relations of an index that are usable in its own polynomial ring: those polynomials in the
chosen generators whose image in the polynomial ring on all of `A` is one of the chosen relations
and which vanish in `A`. -/
def usableRels (i : Index R A) : Set (Poly i) :=
  {F | amb i F ∈ (i.rels : Set (MvPolynomial A R)) ∧ evalPoly i F = 0}

/-- The ideal cut out by the monic relations of the generators together with the usable
relations. -/
noncomputable def relIdeal (i : Index R A) : Ideal (Poly i) :=
  Ideal.span (Set.range (monicRel i) ∪ usableRels i)

/-- The monic relation of a generator lies in the ideal of relations. -/
theorem monicRel_mem_relIdeal (i : Index R A) (x : ↥i.gens) : monicRel i x ∈ relIdeal i :=
  Ideal.subset_span (Or.inl ⟨x, rfl⟩)

/-- The ideal of relations is contained in the kernel of evaluation. -/
theorem relIdeal_le_ker (i : Index R A) : relIdeal i ≤ RingHom.ker (evalPoly i) := by
  rw [relIdeal, Ideal.span_le]
  rintro F (⟨x, rfl⟩ | hF)
  · exact evalPoly_monicRel i x
  · exact hF.2

/-- The ideal of relations is finitely generated. -/
theorem relIdeal_fg (i : Index R A) : (relIdeal i).FG := by
  refine Submodule.fg_span (Set.Finite.union (Set.finite_range _) ?_)
  refine Set.Finite.subset (Set.Finite.preimage ?_ i.rels.finite_toSet) fun F hF => hF.1
  exact ((MvPolynomial.rename_injective _ Subtype.val_injective).injOn)

/-- The approximating algebra attached to an index. -/
abbrev Stage (i : Index R A) : Type u := Poly i ⧸ relIdeal i

/-- The map from the stage attached to an index to `A`. -/
noncomputable def toTarget (i : Index R A) : Stage i →ₐ[R] A :=
  Ideal.Quotient.liftₐ _ (evalPoly i) fun _ ha => relIdeal_le_ker i ha

/-- `Stacks.RingTheory.IntegralFiniteColimit.toTarget` on the class of a polynomial is its
evaluation. -/
@[simp]
theorem toTarget_mk (i : Index R A) (F : Poly i) :
    toTarget i (Ideal.Quotient.mk (relIdeal i) F) = evalPoly i F := rfl

/-- Every stage is a finite `R`-module. -/
instance moduleFinite_stage (i : Index R A) : Module.Finite R (Stage i) := by
  have hint : ∀ x : ↥i.gens,
      IsIntegral R ((Ideal.Quotient.mkₐ R (relIdeal i)) (MvPolynomial.X x)) := by
    intro x
    refine ⟨monicOf R A x.1, monicOf_monic x.1, ?_⟩
    rw [← Polynomial.aeval_def, Polynomial.aeval_algHom_apply]
    exact (Ideal.Quotient.eq_zero_iff_mem).2 (monicRel_mem_relIdeal i x)
  have htop : Algebra.adjoin R
      (Set.range fun x : ↥i.gens =>
        (Ideal.Quotient.mkₐ R (relIdeal i)) (MvPolynomial.X x)) = ⊤ := by
    have h := AlgHom.map_adjoin (Ideal.Quotient.mkₐ R (relIdeal i))
      (Set.range (MvPolynomial.X : ↥i.gens → Poly i))
    rw [MvPolynomial.adjoin_range_X, Algebra.map_top] at h
    simp only [← Set.range_comp, Function.comp_def] at h
    rw [← h, AlgHom.range_eq_top]
    exact Ideal.Quotient.mkₐ_surjective R _
  have hfin : Module.Finite R (Algebra.adjoin R
      (Set.range fun x : ↥i.gens =>
        (Ideal.Quotient.mkₐ R (relIdeal i)) (MvPolynomial.X x))) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range _)
      (Set.forall_mem_range.2 hint)
  rw [htop] at hfin
  exact Module.Finite.equiv (Subalgebra.topEquiv (R := R) (A := Stage i)).toLinearEquiv

/-- Every stage is of finite presentation over `R`. -/
instance finitePresentation_stage (i : Index R A) : Algebra.FinitePresentation R (Stage i) :=
  have : Algebra.FinitePresentation R (Poly i) :=
    Algebra.FinitePresentation.mvPolynomial_of_finitePresentation (A := R) _
  Algebra.FinitePresentation.quotient (relIdeal_fg i)

/-- A polynomial in the generators of `i` whose image in the polynomial ring on all of `A` is a
relation of `j` and which vanishes in `A` maps into the ideal of relations of `j`. -/
private theorem renameLE_mem_relIdeal_of_mem_rels {i j : Index R A} (h : i ≤ j) (F : Poly i)
    (hF : amb i F ∈ (j.rels : Set (MvPolynomial A R))) (hev : evalPoly i F = 0) :
    renameLE h F ∈ relIdeal j :=
  Ideal.subset_span (Or.inr ⟨by rwa [amb_renameLE], by rwa [evalPoly_renameLE]⟩)

/-- Two algebra maps out of a stage agree once they agree on the classes of the variables. -/
private theorem stage_algHom_ext {i : Index R A} {B : Type*} [Semiring B] [Algebra R B]
    {f g : Stage i →ₐ[R] B}
    (h : ∀ x : ↥i.gens, f (Ideal.Quotient.mk _ (MvPolynomial.X x)) =
      g (Ideal.Quotient.mk _ (MvPolynomial.X x))) : f = g :=
  Ideal.Quotient.algHom_ext R (MvPolynomial.algHom_ext h)

/-- `Stacks.RingTheory.IntegralFiniteColimit.renameLE` carries the ideal of relations of an index
into that of a larger index. -/
theorem renameLE_mem_relIdeal {i j : Index R A} (h : i ≤ j) (F : Poly i)
    (hF : F ∈ relIdeal i) : renameLE h F ∈ relIdeal j := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hF
  · rintro G (⟨x, rfl⟩ | hG)
    · rw [renameLE_monicRel]; exact monicRel_mem_relIdeal j _
    · exact renameLE_mem_relIdeal_of_mem_rels h G (h.2 hG.1) hG.2
  · simp
  · intro G G' _ _ hG hG'; simpa using Ideal.add_mem _ hG hG'
  · intro c G _ hG; simpa using Ideal.mul_mem_left _ _ hG

/-- The transition map of the system between two comparable indices. -/
noncomputable def transition {i j : Index R A} (h : i ≤ j) : Stage i →ₐ[R] Stage j :=
  Ideal.Quotient.liftₐ _ ((Ideal.Quotient.mkₐ R (relIdeal j)).comp (renameLE h))
    fun F hF => (Ideal.Quotient.eq_zero_iff_mem).2 (renameLE_mem_relIdeal h F hF)

/-- The transition map on the class of a polynomial. -/
@[simp]
theorem transition_mk {i j : Index R A} (h : i ≤ j) (F : Poly i) :
    transition h (Ideal.Quotient.mk (relIdeal i) F) =
      Ideal.Quotient.mk (relIdeal j) (renameLE h F) := rfl

/-- The transition map from an index to itself is the identity. -/
theorem transition_refl (i : Index R A) (h : i ≤ i) :
    transition h = AlgHom.id R (Stage i) := by
  refine stage_algHom_ext fun x => ?_
  simp

/-- Transition maps compose. -/
theorem transition_comp {i j k : Index R A} (h₁ : i ≤ j) (h₂ : j ≤ k) (h : i ≤ k) :
    (transition h₂).comp (transition h₁) = transition h := by
  refine stage_algHom_ext fun x => ?_
  simp

/-- The maps to `A` commute with the transition maps. -/
theorem toTarget_transition {i j : Index R A} (h : i ≤ j) :
    (toTarget j).comp (transition h) = toTarget i := by
  refine stage_algHom_ext fun x => ?_
  simp

end Stage

section Diagram

variable [Algebra.IsIntegral R A]
variable (R A)

/-- The directed system of finite, finitely presented `R`-algebras approximating `A`. -/
noncomputable def diagram : Index R A ⥤ CommRingCat.{u} where
  obj i := CommRingCat.of (Stage i)
  map {_ _} h := CommRingCat.ofHom (transition (leOfHom h)).toRingHom
  map_id i := by
    rw [show (transition (leOfHom (𝟙 i))) = AlgHom.id R (Stage i) from
      transition_refl i (leOfHom (𝟙 i))]
    rfl
  map_comp {i j k} h₁ h₂ := by
    rw [← transition_comp (leOfHom h₁) (leOfHom h₂) (leOfHom (h₁ ≫ h₂))]
    rfl

/-- The map of `Stacks.RingTheory.IntegralFiniteColimit.diagram` is the transition map. -/
@[simp]
theorem diagram_map_hom {i j : Index R A} (h : i ⟶ j) :
    ((diagram R A).map h).hom = (transition (leOfHom h)).toRingHom := rfl

/-- The object of `Stacks.RingTheory.IntegralFiniteColimit.diagram` at an index is its stage. -/
@[simp]
theorem diagram_obj_carrier (i : Index R A) : ((diagram R A).obj i : Type u) = Stage i := rfl

/-- The structure maps of the system, from `R` to each stage. -/
noncomputable def structureMap :
    (Functor.const (Index R A)).obj (CommRingCat.of R) ⟶ diagram R A where
  app i := CommRingCat.ofHom (algebraMap R (Stage i))
  naturality {i j} h := by
    ext r
    exact ((transition (leOfHom h)).commutes r).symm

/-- The component of `Stacks.RingTheory.IntegralFiniteColimit.structureMap` at an index is the
algebra map. -/
@[simp]
theorem structureMap_app_hom (i : Index R A) :
    ((structureMap R A).app i).hom = algebraMap R (Stage i) := rfl

/-- The cocone of the system with point `A`. -/
noncomputable def cocone : diagram R A ⟶ (Functor.const (Index R A)).obj (CommRingCat.of A) where
  app i := CommRingCat.ofHom (toTarget i).toRingHom
  naturality {i j} h := by
    ext x
    exact AlgHom.congr_fun (toTarget_transition (leOfHom h)) x

/-- The component of `Stacks.RingTheory.IntegralFiniteColimit.cocone` at an index is
`Stacks.RingTheory.IntegralFiniteColimit.toTarget`. -/
@[simp]
theorem cocone_app_hom (i : Index R A) :
    ((cocone R A).app i).hom = (toTarget i).toRingHom := rfl

/-- The structure map of a stage followed by its map to `A` is the algebra map of `A`. -/
theorem structureMap_comp_cocone (i : Index R A) :
    (structureMap R A).app i ≫ (cocone R A).app i = CommRingCat.ofHom (algebraMap R A) := by
  ext r
  exact (toTarget i).commutes r

/-- The maps from the stages to `A` are jointly surjective. -/
theorem exists_toTarget_eq (a : A) : ∃ (i : Index R A) (x : Stage i), toTarget i x = a := by
  classical
  refine ⟨⟨{a}, ∅⟩, Ideal.Quotient.mk _ (MvPolynomial.X ⟨a, by simp⟩), ?_⟩
  simp only [toTarget_mk, evalPoly, MvPolynomial.aeval_X]

/-- Two elements of a stage with the same image in `A` agree at a later stage. -/
theorem exists_transition_eq {i : Index R A} (x y : Stage i)
    (hxy : toTarget i x = toTarget i y) :
    ∃ (j : Index R A) (h : i ≤ j), transition h x = transition h y := by
  classical
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective (I := relIdeal i) x
  obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective (I := relIdeal i) y
  refine ⟨⟨i.gens, insert (amb i (F - G)) i.rels⟩,
    ⟨Finset.Subset.refl _, Finset.subset_insert _ _⟩, ?_⟩
  rw [transition_mk, transition_mk, ← sub_eq_zero, ← map_sub, ← map_sub,
    Ideal.Quotient.eq_zero_iff_mem]
  exact renameLE_mem_relIdeal_of_mem_rels _ _ (Finset.mem_insert_self _ _)
    (by simpa [sub_eq_zero] using hxy)

/-- **The affine form of part (2) of [Stacks, Tag 0817].** An integral algebra is the colimit of
the directed system of its finite, finitely presented approximations. -/
theorem nonempty_isColimitCocone :
    Nonempty (IsColimit (Cocone.mk (CommRingCat.of A) (cocone R A))) := by
  have : ReflectsFilteredColimits (forget CommRingCat.{u}) :=
    ⟨fun _ => reflectsColimitsOfShape_of_reflectsIsomorphisms⟩
  exact ReflectsColimit.reflects (F := forget CommRingCat.{u})
    (Types.FilteredColimit.isColimitOf' (diagram R A ⋙ forget CommRingCat.{u})
      ((forget CommRingCat.{u}).mapCocone (Cocone.mk (CommRingCat.of A) (cocone R A)))
      (fun a => (exists_toTarget_eq R A a).imp fun _ ⟨x, hx⟩ => ⟨x, hx.symm⟩)
      fun _ x y hxy => (exists_transition_eq R A x y hxy).imp fun _ ⟨h, hj⟩ => ⟨homOfLE h, hj⟩)

/-- **The affine form of part (2) of [Stacks, Tag 0817]**, as a chosen colimit witness. -/
noncomputable def isColimitCocone :
    IsColimit (Cocone.mk (CommRingCat.of A) (cocone R A)) :=
  (nonempty_isColimitCocone R A).some

end Diagram

/-- **The affine form of part (2) of [Stacks, Tag 0817], for a morphism of `CommRingCat`.** An
integral ring map `φ : R ⟶ A` is the colimit of a directed system of `R`-algebras which are
simultaneously finite `R`-modules and of finite presentation over `R`. -/
theorem exists_isColimit_finite_finitePresentation {R A : CommRingCat.{u}} (φ : R ⟶ A)
    (hφ : φ.hom.IsIntegral) :
    ∃ (Λ : Type u) (_ : Preorder Λ) (_ : Nonempty Λ) (_ : IsDirected Λ (· ≤ ·))
      (D : Λ ⥤ CommRingCat.{u}) (t : (Functor.const Λ).obj R ⟶ D)
      (c : D ⟶ (Functor.const Λ).obj A) (_ : IsColimit (Cocone.mk A c)),
      (∀ i, (t.app i).hom.Finite) ∧ (∀ i, (t.app i).hom.FinitePresentation) ∧
        ∀ i, t.app i ≫ c.app i = φ := by
  let alg : Algebra ↥R ↥A := φ.hom.toAlgebra
  have : Algebra.IsIntegral ↥R ↥A := ⟨fun x => hφ x⟩
  refine ⟨Index ↥R ↥A, inferInstance, inferInstance, inferInstance, diagram ↥R ↥A,
    structureMap ↥R ↥A, cocone ↥R ↥A, isColimitCocone ↥R ↥A, fun i => ?_, fun i => ?_,
    fun i => ?_⟩
  · exact (RingHom.finite_algebraMap (A := ↥R) (B := Stage i)).mpr (moduleFinite_stage i)
  · exact (RingHom.finitePresentation_algebraMap (A := ↥R) (B := Stage i)).mpr
      (finitePresentation_stage i)
  · exact structureMap_comp_cocone ↥R ↥A i

end Stacks.RingTheory.IntegralFiniteColimit

end
