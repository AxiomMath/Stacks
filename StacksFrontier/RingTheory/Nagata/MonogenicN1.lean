@[expose] public section

namespace MonogenicN1

universe u v

open Polynomial IsLocalRing

/-! ### Generalities on N-1 -/

/-- A Noetherian normal domain is N-1: its integral closure is itself. -/
theorem isN1_of_isIntegrallyClosed (R : Type*) [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [IsIntegrallyClosed R] : IsN1 R := by
  show Module.Finite R (integralClosure R (FractionRing R))
  rw [IsIntegrallyClosed.integralClosure_eq_bot (R := R) (FractionRing R)]
  exact Module.Finite.equiv
    (Algebra.botEquivOfInjective
      (IsFractionRing.injective R (FractionRing R))).symm.toLinearEquiv

/-- N-1 read on an arbitrary fraction field. -/
theorem isN1_of_module_finite (R : Type*) [CommRing R] (K : Type*) [Field K]
    [Algebra R K] [IsFractionRing R K] (h : Module.Finite R (integralClosure R K)) :
    IsN1 R :=
  have := h
  Module.Finite.equiv
    (IsLocalization.algEquiv (nonZeroDivisors R) (FractionRing R)
      K).symm.mapIntegralClosure.toLinearEquiv

/-- N-1 is invariant under a ring isomorphism. -/
theorem isN1_of_ringEquiv {R S : Type u} [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]
    (e : R ≃+* S) (h : IsN1 R) : IsN1 S := by
  let : Algebra R S := e.toRingHom.toAlgebra
  have halg : ∀ r : R, algebraMap R S r = e r := fun _ => rfl
  have : IsLocalization (⊥ : Submonoid R) S := by
    rw [isLocalization_iff]
    refine ⟨fun y => ?_, fun z => ⟨⟨e.symm z, 1⟩, ?_⟩, fun {x y} hxy => ⟨1, ?_⟩⟩
    · rw [show (y : R) = 1 from Submonoid.mem_bot.1 y.2, map_one]
      exact isUnit_one
    · simp [halg]
    · have hxy' : x = y := e.injective (by rw [← halg x, ← halg y]; exact hxy)
      rw [hxy']
  exact (isN1_and_isJapaneseRing_of_isLocalization (⊥ : Submonoid R) S).1 h

/-- The Nagata condition is invariant under a ring isomorphism, across universes.

Noetherianity transports by `isNoetherianRing_of_ringEquiv`, which is already polymorphic, and
each prime quotient of `S` is isomorphic to a prime quotient of `R` — across universes, so the
N-2 half is `IsJapaneseRing.of_ringEquiv`. -/
theorem isNagataRing_of_ringEquiv {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (e : R ≃+* S) (hR : IsNagataRing R) : IsNagataRing S := by
  have : IsNoetherianRing R := hR.1
  refine ⟨isNoetherianRing_of_ringEquiv R e, fun q hq => ?_⟩
  have : (q.comap (e : R →+* S)).IsPrime := Ideal.comap_isPrime (e : R →+* S) q
  exact IsJapaneseRing.of_ringEquiv
    (Ideal.quotientEquiv _ q e
      (Ideal.map_comap_of_surjective (e : R →+* S) e.surjective q).symm)
    (hR.2 _)

/-- A quotient of a Nagata ring is Nagata. -/
theorem isNagataRing_quotient {R : Type u} [CommRing R] (hR : IsNagataRing R) (I : Ideal R) :
    IsNagataRing (R ⧸ I) := by
  have : IsNoetherianRing R := hR.1
  refine ⟨inferInstance, fun q hq => ?_⟩
  have : (q.comap (Ideal.Quotient.mk I)).IsPrime := Ideal.comap_isPrime _ q
  have hsurj : Function.Surjective (Ideal.quotientMap q (Ideal.Quotient.mk I) le_rfl) := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨Ideal.Quotient.mk _ w, Ideal.quotientMap_mk⟩
  exact IsJapaneseRing.of_ringEquiv
    (RingEquiv.ofBijective _ ⟨Ideal.quotientMap_injective, hsurj⟩) (hR.2 _)

/-- A Nagata domain is N-2. -/
theorem isJapaneseRing_of_isNagataRing {R : Type u} [CommRing R] [IsDomain R]
    (hR : IsNagataRing R) : IsJapaneseRing R := by
  have : (⊥ : Ideal R).IsPrime := Ideal.isPrime_bot
  exact IsJapaneseRing.of_ringEquiv (RingEquiv.quotientBot R) (hR.2 ⊥)

/-- Any realisation of the localization of `C` at a prime `𝔮` computes N-1 at `𝔮`. -/
theorem isN1_atPrime_of_isLocalization {C T : Type u} [CommRing C] [IsDomain C] [CommRing T]
    [IsDomain T] [Algebra C T] (𝔮 : Ideal C) [𝔮.IsPrime] [IsLocalization 𝔮.primeCompl T]
    (h : IsN1 T) : IsN1 (Localization.AtPrime 𝔮) := by
  have : IsDomain (Localization.AtPrime 𝔮) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ 𝔮.primeCompl_le_nonZeroDivisors
  exact isN1_of_ringEquiv
    (IsLocalization.algEquiv 𝔮.primeCompl T (Localization.AtPrime 𝔮)).toRingEquiv h

/-- A ring between a domain and its fraction field has that field as its fraction field. -/
theorem isFractionRing_of_injective {A C K : Type u} [CommRing A] [IsDomain A] [CommRing C]
    [Field K] [Algebra A C] [Algebra C K] [Algebra A K] [IsScalarTower A C K] [IsFractionRing A K]
    (hinj : Function.Injective (algebraMap C K)) : IsFractionRing C K := by
  have : IsDomain C := Function.Injective.isDomain (algebraMap C K) hinj
  refine (isLocalization_iff (M := nonZeroDivisors C) (S := K)).2
    ⟨fun y => isUnit_iff_ne_zero.2 fun hy => nonZeroDivisors.ne_zero y.2
      (hinj (by rw [hy, map_zero])), fun z => ?_, fun {x y} hxy => ⟨1, by rw [hinj hxy]⟩⟩
  obtain ⟨a, b, hb, hz⟩ := IsFractionRing.div_surjective (A := A) (K := K) z
  have hbK : algebraMap A K b ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  have hbC : algebraMap A C b ∈ nonZeroDivisors C := by
    refine mem_nonZeroDivisors_of_ne_zero fun hc => hbK ?_
    rw [IsScalarTower.algebraMap_apply A C K, hc, map_zero]
  refine ⟨⟨algebraMap A C a, ⟨algebraMap A C b, hbC⟩⟩, ?_⟩
  show z * algebraMap C K (algebraMap A C b) = algebraMap C K (algebraMap A C a)
  rw [← IsScalarTower.algebraMap_apply A C K, ← IsScalarTower.algebraMap_apply A C K, ← hz,
    div_mul_cancel₀ _ hbK]

/-- An algebra generated by one element is of finite type. -/
theorem finiteType_of_adjoin_singleton {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤) : Algebra.FiniteType A C :=
  ⟨⟨{y}, by simpa using hgen⟩⟩

/-- An algebra generated by one element over a Noetherian ring is Noetherian. -/
theorem isNoetherianRing_of_adjoin_singleton {A C : Type u} [CommRing A] [IsNoetherianRing A]
    [CommRing C] [Algebra A C] (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤) :
    IsNoetherianRing C :=
  have := finiteType_of_adjoin_singleton y hgen
  Algebra.FiniteType.isNoetherianRing A C

/-- The structure map of a domain into a subring of its fraction field is injective. -/
private theorem injective_algebraMap_of_isFractionRing {A C K : Type u} [CommRing A] [CommRing C]
    [Field K] [Algebra A C] [Algebra C K] [Algebra A K] [IsScalarTower A C K]
    [IsFractionRing A K] : Function.Injective (algebraMap A C) := fun a b hab =>
  IsFractionRing.injective A K (by
    rw [IsScalarTower.algebraMap_apply A C K, IsScalarTower.algebraMap_apply A C K, hab])

/-! ### Clearing denominators in a monogenic algebra -/

/-- If `a y = b` with `a b : A` and `C` is generated over `A` by `y`, then every element of `C`
becomes an element of `A` after multiplication by a power of `a`. -/
theorem exists_pow_mul_eq_algebraMap {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤) (a b : A)
    (hab : algebraMap A C a * y = algebraMap A C b) (c : C) :
    ∃ (n : ℕ) (α : A), algebraMap A C a ^ n * c = algebraMap A C α := by
  have hc : c ∈ Algebra.adjoin A ({y} : Set C) := by rw [hgen]; exact Algebra.mem_top
  induction hc using Algebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact ⟨1, b, by rwa [pow_one]⟩
  | algebraMap r => exact ⟨0, r, by rw [pow_zero, one_mul]⟩
  | add c₁ c₂ _ _ ih₁ ih₂ =>
    obtain ⟨n₁, α₁, e₁⟩ := ih₁
    obtain ⟨n₂, α₂, e₂⟩ := ih₂
    have k₁ : max n₁ n₂ - n₁ + n₁ = max n₁ n₂ := Nat.sub_add_cancel (le_max_left _ _)
    have k₂ : max n₁ n₂ - n₂ + n₂ = max n₁ n₂ := Nat.sub_add_cancel (le_max_right _ _)
    refine ⟨max n₁ n₂, a ^ (max n₁ n₂ - n₁) * α₁ + a ^ (max n₁ n₂ - n₂) * α₂, ?_⟩
    calc algebraMap A C a ^ max n₁ n₂ * (c₁ + c₂)
        = algebraMap A C a ^ (max n₁ n₂ - n₁ + n₁) * c₁
            + algebraMap A C a ^ (max n₁ n₂ - n₂ + n₂) * c₂ := by
          rw [k₁, k₂, mul_add]
      _ = algebraMap A C a ^ (max n₁ n₂ - n₁) * (algebraMap A C a ^ n₁ * c₁)
            + algebraMap A C a ^ (max n₁ n₂ - n₂) * (algebraMap A C a ^ n₂ * c₂) := by
          rw [pow_add, pow_add, mul_assoc, mul_assoc]
      _ = algebraMap A C (a ^ (max n₁ n₂ - n₁) * α₁ + a ^ (max n₁ n₂ - n₂) * α₂) := by
          rw [e₁, e₂, map_add, map_mul, map_mul, map_pow, map_pow]
  | mul c₁ c₂ _ _ ih₁ ih₂ =>
    obtain ⟨n₁, α₁, e₁⟩ := ih₁
    obtain ⟨n₂, α₂, e₂⟩ := ih₂
    refine ⟨n₁ + n₂, α₁ * α₂, ?_⟩
    calc algebraMap A C a ^ (n₁ + n₂) * (c₁ * c₂)
        = (algebraMap A C a ^ n₁ * c₁) * (algebraMap A C a ^ n₂ * c₂) := by ring
      _ = algebraMap A C (α₁ * α₂) := by rw [e₁, e₂, map_mul]

/-- The generator of a monogenic subring of the fraction field is a fraction. -/
theorem exists_mul_eq_of_isFractionRing {A C K : Type u} [CommRing A] [IsDomain A] [CommRing C]
    [Field K] [Algebra A C] [Algebra C K] [Algebra A K] [IsScalarTower A C K]
    [IsFractionRing A K] (hinj : Function.Injective (algebraMap C K)) (y : C) :
    ∃ a b : A, a ≠ 0 ∧ algebraMap A C a * y = algebraMap A C b := by
  obtain ⟨b, a, ha, hab⟩ := IsFractionRing.div_surjective (A := A) (K := K) (algebraMap C K y)
  have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
  have hane : algebraMap A K a ≠ 0 := by simp [ha0]
  have key : algebraMap A K a * algebraMap C K y = algebraMap A K b := by
    rw [← hab]
    field_simp
  refine ⟨a, b, ha0, hinj ?_⟩
  rwa [map_mul, ← IsScalarTower.algebraMap_apply A C K, ← IsScalarTower.algebraMap_apply A C K]

/-! ### The kernel of `A[X] → A[y]` -/

/-- Let `A` be a domain integrally closed in its fraction field `K`, let `y ∈ K` and let
`z ∈ A[y] ⊆ K`. If `y * z` lies in `A` then so does `z`.

This is the source's claim that the kernel of `A[X] → A[y]`, `X ↦ y`, is generated by the linear
forms `aX - b` with `ay = b`: an element of the kernel of degree `d` and leading coefficient `a_d`
has `a_d y` integral over `A` (`isIntegral_leadingCoeff_smul`), hence in `A` by normality, which
lowers the degree by one. -/
theorem mem_bot_of_mul_mem_bot_of_mem_adjoin_singleton {A K : Type u} [CommRing A]
    [IsDomain A] [IsIntegrallyClosed A] [Field K] [Algebra A K] [IsFractionRing A K] {y z : K}
    (hz : z ∈ Algebra.adjoin A ({y} : Set K)) (h : y * z ∈ (⊥ : Subalgebra A K)) :
    z ∈ (⊥ : Subalgebra A K) := by
  have aux : ∀ (n : ℕ) (f : A[X]), f.natDegree ≤ n →
      y * aeval y f ∈ (⊥ : Subalgebra A K) → aeval y f ∈ (⊥ : Subalgebra A K) := by
    intro n
    induction n with
    | zero =>
      intro f hf _
      rw [Polynomial.eq_C_of_natDegree_le_zero hf]
      simp
    | succ n ih =>
      intro f hf h
      by_cases hd : f.natDegree = 0
      · rw [Polynomial.eq_C_of_natDegree_le_zero hd.le]
        simp
      obtain ⟨a, ha⟩ := Algebra.mem_bot.1 h
      have hf0 : f ≠ 0 := fun h0 => hd (by simp [h0])
      -- `g = f X - a` vanishes at `y` and has the same leading coefficient as `f`.
      set g : A[X] := f * X - C a with hg
      have hgy : aeval y g = 0 := by
        simp only [hg, map_sub, map_mul, aeval_X, aeval_C]
        rw [ha]; ring
      have hfx : (f * X).natDegree = f.natDegree + 1 := Polynomial.natDegree_mul_X hf0
      have hlc : g.leadingCoeff = f.leadingCoeff := by
        have hdeg : (-(C a) : A[X]).degree < (f * X).degree := by
          rw [degree_neg]
          exact lt_of_le_of_lt degree_C_le
            (Polynomial.natDegree_pos_iff_degree_pos.1 (by rw [hfx]; omega))
        have hadd := Polynomial.leadingCoeff_add_of_degree_lt hdeg
        rw [hg, sub_eq_neg_add, hadd, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_X,
          mul_one]
      have hint : IsIntegral A (f.leadingCoeff • y) := by
        rw [← hlc]; exact isIntegral_leadingCoeff_smul _ _ hgy
      obtain ⟨b, hb⟩ := IsIntegrallyClosed.isIntegral_iff.1 hint
      -- Replacing the top term `a_d y ^ d` of `f` by `b y ^ (d - 1)` lowers the degree.
      set d := f.natDegree with hdd
      set f' : A[X] := f.eraseLead + C b * X ^ (d - 1) with hf'
      have hev : aeval y f' = aeval y f := by
        have hsplit : f.eraseLead + C f.leadingCoeff * X ^ d = f :=
          Polynomial.eraseLead_add_C_mul_X_pow f
        have h1 : aeval y f = aeval y f.eraseLead + algebraMap A K f.leadingCoeff * y ^ d := by
          conv_lhs => rw [← hsplit]
          simp
        have h2 : algebraMap A K b = algebraMap A K f.leadingCoeff * y := by
          rw [hb, Algebra.smul_def]
        have hdpos : d - 1 + 1 = d := Nat.succ_pred_eq_of_pos (Nat.pos_of_ne_zero hd)
        simp only [hf', map_add, map_mul, aeval_C, map_pow, aeval_X, h2, h1]
        rw [mul_assoc, ← pow_succ', hdpos]
      have hdeg' : f'.natDegree ≤ n := by
        refine le_trans (Polynomial.natDegree_add_le _ _) (max_le ?_ ?_)
        · exact le_trans (Polynomial.eraseLead_natDegree_le f) (by omega)
        · exact le_trans (Polynomial.natDegree_C_mul_X_pow_le _ _) (by omega)
      rw [← hev]
      exact ih f' hdeg' (by rwa [hev])
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
  obtain ⟨f, rfl⟩ := hz
  exact aux f.natDegree f le_rfl h

/-- **The source's `S / xS = R / J`.** Let `A` be a domain integrally closed in its fraction field
`K`, and let `B` be an `A`-algebra inside `K` — the structure map `B → K` being injective — which
is generated over `A` by a single element `y₀`. Then the composite `A → B → B ⧸ y₀B` is surjective
with kernel the ideal `J = A ∩ yA` of the source, the pullback of the `A`-submodule
`yA ⊆ K` along `A → K`, where `y` is the image of `y₀`.

So `B ⧸ y₀B ≅ A ⧸ J`, which is what Tag 031T is read on. -/
theorem surjective_and_ker_quotient_span_singleton {A B K : Type u} [CommRing A]
    [IsDomain A] [IsIntegrallyClosed A] [CommRing B] [Field K] [Algebra A B] [Algebra A K]
    [Algebra B K] [IsScalarTower A B K] [IsFractionRing A K]
    (hinj : Function.Injective (algebraMap B K)) (y₀ : B)
    (htop : Algebra.adjoin A ({y₀} : Set B) = ⊤) :
    Function.Surjective ((Ideal.Quotient.mk (Ideal.span {y₀})).comp (algebraMap A B)) ∧
      RingHom.ker ((Ideal.Quotient.mk (Ideal.span {y₀})).comp (algebraMap A B))
        = (Submodule.span A {algebraMap B K y₀}).comap (Algebra.linearMap A K) := by
  set y : K := algebraMap B K y₀ with hy
  have htower : ∀ a : A, algebraMap A K a = algebraMap B K (algebraMap A B a) := fun a =>
    IsScalarTower.algebraMap_apply A B K a
  -- The image of `B` in `K` is `A[y]`.
  have hrange : ∀ b : B, algebraMap B K b ∈ Algebra.adjoin A ({y} : Set K) := by
    have hmap : (Algebra.adjoin A ({y₀} : Set B)).map (IsScalarTower.toAlgHom A B K)
        = Algebra.adjoin A ({y} : Set K) := by
      rw [AlgHom.map_adjoin, Set.image_singleton]; rfl
    intro b
    rw [htop] at hmap
    rw [← hmap]
    exact ⟨b, Algebra.mem_top, rfl⟩
  refine ⟨?_, ?_⟩
  · -- Modulo `y₀`, an element of `B = A[y₀]` is its own constant term.
    intro c
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
    have hb : b ∈ Algebra.adjoin A ({y₀} : Set B) := by rw [htop]; exact Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨f, rfl⟩ := hb
    obtain ⟨g, hg⟩ : (Polynomial.X : Polynomial A) ∣ f - Polynomial.C (f.coeff 0) := by
      rw [Polynomial.X_dvd_iff]; simp
    have heq : Polynomial.aeval y₀ f
        = algebraMap A B (f.coeff 0) + y₀ * Polynomial.aeval y₀ g := by
      have hcong := congrArg (Polynomial.aeval y₀) hg
      simp only [map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at hcong
      linear_combination hcong
    refine ⟨f.coeff 0, ?_⟩
    show Ideal.Quotient.mk (Ideal.span {y₀}) (algebraMap A B (f.coeff 0))
      = Ideal.Quotient.mk _ (Polynomial.aeval y₀ f)
    rw [heq, map_add, Ideal.Quotient.eq_zero_iff_mem.2
      (Ideal.mem_span_singleton.2 ⟨Polynomial.aeval y₀ g, rfl⟩), add_zero]
  · ext a
    simp only [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton, Submodule.mem_comap, Algebra.linearMap_apply,
      Submodule.mem_span_singleton]
    constructor
    · rintro ⟨c, hc⟩
      have hzK : algebraMap A K a = y * algebraMap B K c := by rw [htower, hc, map_mul]
      have hmem : algebraMap B K c ∈ (⊥ : Subalgebra A K) := by
        refine mem_bot_of_mul_mem_bot_of_mem_adjoin_singleton (hrange c) ?_
        rw [← hzK]
        exact ⟨a, rfl⟩
      obtain ⟨a', ha'⟩ := Algebra.mem_bot.1 hmem
      exact ⟨a', by rw [Algebra.smul_def, ha', hzK]; ring⟩
    · rintro ⟨a', ha'⟩
      refine ⟨algebraMap A B a', hinj ?_⟩
      rw [map_mul, ← htower a, ← hy, ← ha', Algebra.smul_def, ← htower a']
      ring

/-! ### Two facts about associated primes and heights -/

/-! ### Tag 0333 for a localization of a monogenic algebra -/

/-- **Tag 0333 applied to a localization of `C = A[y]`.** For `D` a localization of `C` at a
submonoid of nonzerodivisors, N-1 at every maximal ideal of `D` gives N-1 for `D`: the
first condition of Tag 0333 is met by the denominator of `y`, since inverting it turns `D`
into a localization of the normal ring `A`. -/
theorem isN1_of_forall_isN1_atPrime {A C D K : Type u} [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] [CommRing C] [IsDomain C] [CommRing D] [IsDomain D]
    [Field K] [Algebra A C] [Algebra C K] [Algebra A K] [IsScalarTower A C K] [IsFractionRing A K]
    [Algebra C D] [Algebra D K] [IsScalarTower C D K] [IsNoetherianRing D]
    (M : Submonoid C) [IsLocalization M D] (hM : M ≤ nonZeroDivisors C)
    (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤)
    (h : ∀ (𝔪 : Ideal D) (_ : 𝔪.IsMaximal), IsN1 (Localization.AtPrime 𝔪)) :
    IsN1 D := by
  -- `A → C → D` is injective, so `A` sits inside `D`.
  have hAC : Function.Injective (algebraMap A C) :=
    injective_algebraMap_of_isFractionRing (K := K)
  have hCD : Function.Injective (algebraMap C D) := IsLocalization.injective D hM
  -- `a` is the denominator of `y`: `a y = b` with `a b : A`, `a ≠ 0`.
  obtain ⟨a, b, ha0, hab⟩ := exists_mul_eq_of_isFractionRing (A := A) hinj y
  obtain ⟨g, hgdef⟩ : ∃ g : D, g = algebraMap C D (algebraMap A C a) := ⟨_, rfl⟩
  have hg0 : g ≠ 0 := by
    intro hh
    refine ha0 (hAC (hCD ?_))
    rw [map_zero, map_zero, ← hgdef]
    exact hh
  have hpow : Submonoid.powers g ≤ nonZeroDivisors D :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hg0
  rw [isN1_iff_exists_isIntegrallyClosed_away_and_forall_isN1_atPrime D]
  refine ⟨⟨g, hg0, ?_⟩, fun 𝔪 h𝔪 => h 𝔪 h𝔪⟩
  -- Inverting `g` turns `D` into a localization of `A`, hence into a normal ring.
  suffices H : ∀ (E : Type u) [CommRing E] [Algebra D E] [IsLocalization (Submonoid.powers g) E],
      IsIntegrallyClosed E by
    exact H (Localization.Away g)
  intro E _ _ _
  have : IsDomain E := IsLocalization.isDomain_of_le_nonZeroDivisors E hpow
  let : Algebra A E := ((algebraMap D E).comp ((algebraMap C D).comp (algebraMap A C))).toAlgebra
  obtain ⟨F, hF⟩ : ∃ F : C →+* E, ∀ x : C, F x = algebraMap D E (algebraMap C D x) :=
    ⟨(algebraMap D E).comp (algebraMap C D), fun _ => rfl⟩
  have hAF : ∀ x : A, algebraMap A E x = F (algebraMap A C x) := by
    intro x
    rw [hF]
    rfl
  have hDE : Function.Injective (algebraMap D E) := IsLocalization.injective E hpow
  have hAE : Function.Injective (algebraMap A E) := by
    intro x z hxz
    rw [hAF, hAF, hF, hF] at hxz
    exact hAC (hCD (hDE hxz))
  have hga : algebraMap D E g = algebraMap A E a := by rw [hAF, hF, hgdef]
  have hau : IsUnit (algebraMap A E a) := by
    rw [← hga]
    exact IsLocalization.map_units E ⟨g, Submonoid.mem_powers g⟩
  -- `N` is the submonoid of elements of `A` that become invertible in `E`.
  obtain ⟨N, hmemN⟩ : ∃ N : Submonoid A, ∀ x : A, x ∈ N ↔ IsUnit (algebraMap A E x) :=
    ⟨Submonoid.comap (algebraMap A E) (IsUnit.submonoid E),
      fun x => Submonoid.mem_comap.trans (IsUnit.mem_submonoid_iff _)⟩
  have hNle : N ≤ nonZeroDivisors A := by
    intro x hx
    refine mem_nonZeroDivisors_of_ne_zero fun hx0 => ?_
    rw [hmemN, hx0, map_zero] at hx
    exact not_isUnit_zero hx
  have : IsLocalization N E := by
    rw [isLocalization_iff]
    refine ⟨fun w => (hmemN _).1 w.2, ?_, fun {x z} hxz => ⟨1, by rw [hAE hxz]⟩⟩
    intro z
    -- Write `z = d / gⁿ`, `d = c / m`, `c = α / a ^ k` and `m = α' / a ^ k'`.
    obtain ⟨⟨d, gn⟩, hz⟩ := IsLocalization.surj (M := Submonoid.powers g) z
    obtain ⟨n, hn⟩ := gn.2
    have hn : g ^ n = (gn : D) := hn
    obtain ⟨⟨c, m⟩, hd⟩ := IsLocalization.surj (M := M) d
    obtain ⟨k, α, hk⟩ := exists_pow_mul_eq_algebraMap y hgen a b hab c
    obtain ⟨k', α', hk'⟩ := exists_pow_mul_eq_algebraMap y hgen a b hab (m : C)
    have hz' : z * algebraMap A E a ^ n = algebraMap D E d := by
      rw [← hga, ← map_pow, hn]
      exact hz
    have hd' : algebraMap D E d * F (m : C) = F c := by simp only [hF, ← map_mul, hd]
    have hk2 : algebraMap A E a ^ k * F c = algebraMap A E α := by
      rw [hAF a, hAF α, ← map_pow, ← map_mul, hk]
    have hk2' : algebraMap A E a ^ k' * F (m : C) = algebraMap A E α' := by
      rw [hAF a, hAF α', ← map_pow, ← map_mul, hk']
    have hmu : IsUnit (F (m : C)) := by
      rw [hF]
      exact (IsLocalization.map_units D m).map (algebraMap D E)
    have hα'u : IsUnit (algebraMap A E α') := by
      rw [← hk2']
      exact (hau.pow k').mul hmu
    refine ⟨⟨α * a ^ k', ⟨α' * a ^ (n + k), ?_⟩⟩, ?_⟩
    · rw [hmemN, map_mul, map_pow]
      exact hα'u.mul (hau.pow (n + k))
    · show z * algebraMap A E (α' * a ^ (n + k)) = algebraMap A E (α * a ^ k')
      simp only [map_mul, map_pow]
      linear_combination (-(z * algebraMap A E a ^ (n + k))) * hk2' +
        (algebraMap A E a ^ k * algebraMap A E a ^ k' * F (m : C)) * hz' +
        (algebraMap A E a ^ (k + k')) * hd' + (algebraMap A E a ^ k') * hk2
  exact isIntegrallyClosed_of_isLocalization E N hNle

/-! ### The local core: Tag 0330 applied to `C_𝔮` -/

/-- **The source's `S_𝔪 / x S_𝔪 = A / J`.** Let `R` be a localization of `C = A[y]` at a prime
`𝔮` containing `y`, and suppose every element of `A` outside `𝔮` is a unit of `A`. Then
`A → R ⧸ yR` is surjective with kernel the ideal `J = A ∩ yA`.

The point is that `A → C ⧸ yC` is already surjective with kernel `J`
(`surjective_and_ker_quotient_span_singleton`), and modulo `y` every element of `𝔮.primeCompl`
agrees with a unit of `A`, so the further localization changes nothing. -/
theorem surjective_and_ker_of_isLocalization {A C K R : Type u} [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] [CommRing C] [IsDomain C] [Field K] [CommRing R]
    [Algebra A C] [Algebra C K] [Algebra A K] [IsScalarTower A C K] [IsFractionRing A K]
    [Algebra C R] [Algebra A R] [IsScalarTower A C R]
    (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤)
    (𝔮 : Ideal C) [𝔮.IsPrime] [IsLocalization 𝔮.primeCompl R] (hy𝔮 : y ∈ 𝔮)
    (hunit : ∀ α : A, algebraMap A C α ∉ 𝔮 → IsUnit α) :
    Function.Surjective
        ((Ideal.Quotient.mk (Ideal.span {algebraMap C R y})).comp (algebraMap A R)) ∧
      RingHom.ker ((Ideal.Quotient.mk (Ideal.span {algebraMap C R y})).comp (algebraMap A R))
        = (Submodule.span A {algebraMap C K y}).comap (Algebra.linearMap A K) := by
  obtain ⟨hsurjC, hkerC⟩ :=
    surjective_and_ker_quotient_span_singleton (A := A) (B := C) (K := K) hinj y hgen
  set J := (Submodule.span A {algebraMap C K y}).comap (Algebra.linearMap A K) with hJdef
  -- Modulo `y`, every element of `C` is the image of an element of `A`.
  have hsplit : ∀ c : C, ∃ (β : A) (c' : C), c = algebraMap A C β + y * c' := by
    intro c
    obtain ⟨β, hβ⟩ := hsurjC (Ideal.Quotient.mk (Ideal.span {y}) c)
    rw [RingHom.comp_apply] at hβ
    have hmem : c - algebraMap A C β ∈ Ideal.span ({y} : Set C) := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hβ, sub_self]
    obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton.1 hmem
    exact ⟨β, c', by linear_combination hc'⟩
  -- The kernel of `A → C ⧸ yC` is `J`.
  have hker : ∀ α : A, algebraMap A C α ∈ Ideal.span ({y} : Set C) ↔ α ∈ J := by
    intro α
    rw [← hkerC, RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
  set q := Ideal.Quotient.mk (Ideal.span {algebraMap C R y}) with hqdef
  have hq0 : ∀ t : R, q (algebraMap C R y * t) = 0 := fun t =>
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton.2 ⟨t, rfl⟩)
  have hstep : ∀ (c : C) (β : A) (c' : C), c = algebraMap A C β + y * c' →
      q (algebraMap C R c) = q (algebraMap A R β) := by
    intro c β c' hc
    rw [hc, map_add, map_mul, map_add, ← IsScalarTower.algebraMap_apply A C R, hq0, add_zero]
  -- An element outside `𝔮` agrees modulo `y` with a unit of `A`.
  have hden : ∀ u : C, u ∉ 𝔮 → ∃ (α α' : A) (c'' : C),
      α * α' = 1 ∧ u = algebraMap A C α + y * c'' := by
    intro u hu
    obtain ⟨α, c'', hc⟩ := hsplit u
    have hα : algebraMap A C α ∉ 𝔮 := fun hmem =>
      hu (hc ▸ 𝔮.add_mem hmem (Ideal.mul_mem_right c'' 𝔮 hy𝔮))
    obtain ⟨α', hα'⟩ := (hunit α hα).exists_right_inv
    exact ⟨α, α', c'', hα', hc⟩
  have hCinj : Function.Injective (algebraMap C R) :=
    IsLocalization.injective R (Ideal.primeCompl_le_nonZeroDivisors 𝔮)
  refine ⟨?_, le_antisymm (fun α hα => ?_) (fun α hα => ?_)⟩
  · intro z
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨⟨c, u⟩, hru⟩ := IsLocalization.surj (M := 𝔮.primeCompl) r
    obtain ⟨β, c', hc⟩ := hsplit c
    obtain ⟨α, α', c'', hαα', hu⟩ := hden (u : C) (Ideal.mem_primeCompl_iff.1 u.2)
    have h1 := hstep c β c' hc
    have h2 := hstep (u : C) α c'' hu
    have key : q r * q (algebraMap A R α) = q (algebraMap A R β) := by
      rw [← h1, ← h2, ← map_mul, hru]
    have hinvq : q (algebraMap A R α) * q (algebraMap A R α') = 1 := by
      rw [← map_mul, ← map_mul, hαα', map_one, map_one]
    refine ⟨β * α', ?_⟩
    rw [RingHom.comp_apply, map_mul, map_mul]
    linear_combination (-(q (algebraMap A R α'))) * key + (q r) * hinvq
  · -- `ker ≤ J`: clear the denominator of a witness, then use the kernel computation in `C`.
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton] at hα
    obtain ⟨ρ, hρ⟩ := hα
    obtain ⟨⟨c, u⟩, hcu⟩ := IsLocalization.surj (M := 𝔮.primeCompl) ρ
    have heq : algebraMap A C α * (u : C) = y * c := by
      apply hCinj
      rw [map_mul, map_mul, ← IsScalarTower.algebraMap_apply A C R, hρ, mul_assoc, hcu]
    obtain ⟨α₀, α₀', c'', hinv, hu⟩ := hden (u : C) (Ideal.mem_primeCompl_iff.1 u.2)
    have hmem : algebraMap A C (α * α₀) ∈ Ideal.span ({y} : Set C) := by
      rw [map_mul]
      refine Ideal.mem_span_singleton.2 ⟨c - algebraMap A C α * c'', ?_⟩
      rw [hu] at heq
      linear_combination heq
    have hsm := J.smul_mem α₀' ((hker _).1 hmem)
    rw [smul_eq_mul] at hsm
    rw [show α = α₀' * (α * α₀) from by linear_combination (-α) * hinv]
    exact hsm
  · -- `J ≤ ker`: the witness in `C` maps to a witness in `R`.
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.1 ((hker α).2 hα)
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton]
    exact ⟨algebraMap C R c, by rw [IsScalarTower.algebraMap_apply A C R, hc, map_mul]⟩

/-- The localization of a normal Noetherian domain at a height one prime is a one-dimensional
normal Noetherian local domain. -/
private theorem localization_props_of_height_eq_one {A V : Type u} [CommRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A] (𝔭 : Ideal A) [𝔭.IsPrime] (hh : 𝔭.height = 1)
    [CommRing V] [Algebra A V] [IsLocalization.AtPrime V 𝔭] :
    IsNoetherianRing V ∧ IsLocalRing V ∧ IsDomain V ∧ IsIntegrallyClosed V ∧
      ringKrullDim V = 1 :=
  ⟨IsLocalization.isNoetherianRing 𝔭.primeCompl V ‹_›, IsLocalization.AtPrime.isLocalRing V 𝔭,
    IsLocalization.isDomain_of_le_nonZeroDivisors V 𝔭.primeCompl_le_nonZeroDivisors,
    isIntegrallyClosed_of_isLocalization V 𝔭.primeCompl 𝔭.primeCompl_le_nonZeroDivisors,
    by rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔭 V, hh]; rfl⟩

/-- **The source's `R_𝔭 = S_𝔮`, first half.** If `𝔭` is a height one prime of the normal
Noetherian domain `A` containing `J = A ∩ yA`, then `y` lies in `A_𝔭`: otherwise `y⁻¹ ∈ A_𝔭`,
which exhibits an element of `J` outside `𝔭`. -/
theorem exists_mul_eq_of_height_eq_one {A C K : Type u} [CommRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A] [CommRing C] [IsDomain C] [Field K]
    [Algebra A C] [Algebra C K] [Algebra A K] [IsScalarTower A C K] [IsFractionRing A K]
    (hinj : Function.Injective (algebraMap C K)) (y : C) (hy0 : y ≠ 0)
    (𝔭 : Ideal A) [𝔭.IsPrime] (hh : 𝔭.height = 1)
    (hJ : (Submodule.span A {algebraMap C K y}).comap (Algebra.linearMap A K) ≤ 𝔭) :
    ∃ a s : A, s ∉ 𝔭 ∧ algebraMap A C s * y = algebraMap A C a := by
  have hAinj : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  set η : K := algebraMap C K y with hη
  have hη0 : η ≠ 0 := fun h => hy0 (hinj (by rw [← hη, h, map_zero]))
  -- `K` is a fraction field of the local ring `V` of `A` at `𝔭`.
  have hunit : ∀ s : 𝔭.primeCompl, IsUnit (algebraMap A K (s : A)) := fun s =>
    isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ hAinj).mpr fun h0 => s.2 (h0 ▸ 𝔭.zero_mem))
  let _ : Algebra (Localization.AtPrime 𝔭) K :=
    (IsLocalization.lift (M := 𝔭.primeCompl) (g := algebraMap A K) hunit).toAlgebra
  have : IsScalarTower A (Localization.AtPrime 𝔭) K :=
    IsScalarTower.of_algebraMap_eq fun a => (IsLocalization.lift_eq hunit a).symm
  have : IsFractionRing (Localization.AtPrime 𝔭) K :=
    IsFractionRing.isFractionRing_of_isLocalization 𝔭.primeCompl _ K
      𝔭.primeCompl_le_nonZeroDivisors
  -- `V` is a normal Noetherian local domain of dimension one, hence a valuation ring.
  obtain ⟨hdom, hdvr⟩ := ((isDiscreteValuationRing_tfae (Localization.AtPrime 𝔭)).out 5 1).mp
    (localization_props_of_height_eq_one 𝔭 hh)
  have := hdom
  have := hdvr
  -- Clearing denominators in `V`: an element of `V` is a fraction over `A`.
  have hmk : ∀ x : Localization.AtPrime 𝔭, ∀ z : K,
      algebraMap (Localization.AtPrime 𝔭) K x = z →
      ∃ a : A, ∃ s : 𝔭.primeCompl, z * algebraMap A K (s : A) = algebraMap A K a := by
    intro x z hx
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj 𝔭.primeCompl x
    refine ⟨a, s, ?_⟩
    have h1 := congrArg (algebraMap (Localization.AtPrime 𝔭) K) hs
    rw [map_mul, hx, ← IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) K,
      ← IsScalarTower.algebraMap_apply A (Localization.AtPrime 𝔭) K] at h1
    exact h1
  -- Either `η` or `η⁻¹` lies in `V`; the latter exhibits an element of `J` outside `𝔭`.
  obtain ⟨v, hv⟩ | ⟨v, hv⟩ := ValuationRing.isInteger_or_isInteger (Localization.AtPrime 𝔭) η
  · obtain ⟨a, s, key⟩ := hmk v η hv
    refine ⟨a, (s : A), s.2, hinj ?_⟩
    rw [map_mul, ← IsScalarTower.algebraMap_apply A C K, ← IsScalarTower.algebraMap_apply A C K,
      ← hη]
    linear_combination key
  · obtain ⟨a, s, key⟩ := hmk v η⁻¹ hv
    have hsn : (s : A) ∉ 𝔭 := s.2
    have key2 : algebraMap A K (s : A) = η * algebraMap A K a := by
      rw [← key, ← mul_assoc, mul_inv_cancel₀ hη0, one_mul]
    refine absurd (hJ ?_) hsn
    simp only [Submodule.mem_comap, Algebra.linearMap_apply, Submodule.mem_span_singleton]
    exact ⟨a, by rw [Algebra.smul_def, key2]; ring⟩

/-- A localization of a normal Noetherian domain at a height one prime is a regular local ring:
it is a discrete valuation ring. -/
@[ega "IV 7.9.1" "partial"]
theorem isRegularLocalRing_of_height_eq_one {A V : Type u} [CommRing A] [IsDomain A]
    [IsNoetherianRing A] [IsIntegrallyClosed A] (𝔭 : Ideal A) [𝔭.IsPrime] (hh : 𝔭.height = 1)
    [CommRing V] [Algebra A V] [IsLocalization.AtPrime V 𝔭] : IsRegularLocalRing V := by
  have h3 : IsRegularLocalRing V ∧ ringKrullDim V = 1 :=
    ((isDiscreteValuationRing_tfae V).out 5 3).mp (localization_props_of_height_eq_one 𝔭 hh)
  exact h3.1

/-- **The source's `R_𝔭 = S_𝔮`, second half.** If `y = a/s` with `s ∉ 𝔮`, then a localization of
`C = A[y]` at the prime `𝔮` is already a localization of `A` at `𝔮 ∩ A`. -/
theorem isLocalization_of_comap {A C T : Type u} [CommRing A] [CommRing C] [CommRing T]
    [Algebra A C] [Algebra A T] [Algebra C T] [IsScalarTower A C T]
    (hAC : Function.Injective (algebraMap A C))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤) (a s : A)
    (hs : algebraMap A C s * y = algebraMap A C a)
    (q : Ideal C) [q.IsPrime] [IsLocalization q.primeCompl T]
    (hsq : algebraMap A C s ∉ q) :
    IsLocalization (q.comap (algebraMap A C)).primeCompl T := by
  have hqp : q.IsPrime := inferInstance
  -- Clearing a denominator out of an element outside `𝔮` keeps it outside `𝔭 = 𝔮 ∩ A`.
  have key : ∀ u : C, u ∉ q → ∀ (m : ℕ) (γ : A),
      algebraMap A C s ^ m * u = algebraMap A C γ →
      γ ∈ (q.comap (algebraMap A C)).primeCompl := by
    intro u hu m γ hγ hmem
    have hmem' : algebraMap A C γ ∈ q := hmem
    rw [← hγ] at hmem'
    rcases hqp.mem_or_mem hmem' with h | h
    · exact hsq (hqp.mem_of_pow_mem m h)
    · exact hu h
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · intro t
    have ht : algebraMap A C (t : A) ∈ q.primeCompl := t.2
    have := IsLocalization.map_units T (⟨algebraMap A C (t : A), ht⟩ : q.primeCompl)
    rwa [IsScalarTower.algebraMap_apply A C T]
  · intro z
    obtain ⟨⟨c, u⟩, hz⟩ := IsLocalization.surj q.primeCompl z
    obtain ⟨n, α, hn⟩ := exists_pow_mul_eq_algebraMap y hgen s a hs c
    obtain ⟨m, γ, hm⟩ := exists_pow_mul_eq_algebraMap y hgen s a hs (u : C)
    have hγ : γ ∈ (q.comap (algebraMap A C)).primeCompl := key (u : C) u.2 m γ hm
    have hsm : s ∈ (q.comap (algebraMap A C)).primeCompl := hsq
    refine ⟨⟨α * s ^ m, ⟨γ * s ^ n, mul_mem hγ (pow_mem hsm n)⟩⟩, ?_⟩
    have Hn : algebraMap C T (algebraMap A C s) ^ n * algebraMap C T c
        = algebraMap C T (algebraMap A C α) := by
      rw [← map_pow, ← map_mul, hn]
    have Hm : algebraMap C T (algebraMap A C s) ^ m * algebraMap C T (u : C)
        = algebraMap C T (algebraMap A C γ) := by
      rw [← map_pow, ← map_mul, hm]
    show z * algebraMap A T (γ * s ^ n) = algebraMap A T (α * s ^ m)
    simp only [IsScalarTower.algebraMap_apply A C T, map_mul, map_pow]
    rw [← Hm, ← Hn, ← hz]
    ring
  · intro x x' hxx
    rw [IsScalarTower.algebraMap_apply A C T, IsScalarTower.algebraMap_apply A C T] at hxx
    obtain ⟨u, hu⟩ := IsLocalization.exists_of_eq (M := q.primeCompl) (S := T) hxx
    obtain ⟨m, γ, hm⟩ := exists_pow_mul_eq_algebraMap y hgen s a hs (u : C)
    refine ⟨⟨γ, key (u : C) u.2 m γ hm⟩, hAC ?_⟩
    show algebraMap A C (γ * x) = algebraMap A C (γ * x')
    rw [map_mul, map_mul, ← hm, mul_assoc, mul_assoc, hu]

/-- **The source's application of Tag 0330.** Let `A` be a normal Nagata domain with fraction
field `K`, let `C = A[y]` be a monogenic `A`-subalgebra of `K` and let `𝔮` be a prime of `C`
containing `y` at which the base is local, in the sense that every element of `A` outside `𝔮` is
already a unit of `A`. Then `C_𝔮` is N-1. -/
theorem isN1_atPrime_of_mem {A C K : Type u} [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [CommRing C] [IsDomain C] [Field K] [Algebra A C] [Algebra C K] [Algebra A K]
    [IsScalarTower A C K] [IsFractionRing A K]
    (hA : IsNagataRing A) (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤) (hy0 : y ≠ 0)
    (𝔮 : Ideal C) [𝔮.IsPrime] (hy𝔮 : y ∈ 𝔮)
    (hunit : ∀ α : A, algebraMap A C α ∉ 𝔮 → IsUnit α) :
    IsN1 (Localization.AtPrime 𝔮) := by
  have : IsNoetherianRing A := hA.1
  have : IsNoetherianRing C := isNoetherianRing_of_adjoin_singleton y hgen
  set R := Localization.AtPrime 𝔮
  have : IsNoetherianRing R := IsLocalization.isNoetherianRing 𝔮.primeCompl R inferInstance
  have : IsLocalRing R := IsLocalization.AtPrime.isLocalRing R 𝔮
  have : IsDomain R :=
    IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors 𝔮)
  have hCR : Function.Injective (algebraMap C R) :=
    IsLocalization.injective R (Ideal.primeCompl_le_nonZeroDivisors 𝔮)
  have hAC : Function.Injective (algebraMap A C) :=
    injective_algebraMap_of_isFractionRing (K := K)
  have hzne : algebraMap C K y ≠ 0 := fun h => hy0 (hinj (by rw [h, map_zero]))
  obtain ⟨hsurj, hker⟩ := surjective_and_ker_of_isLocalization (R := R) hinj y hgen 𝔮 hy𝔮 hunit
  have h031T := (associatedPrimes_minimal_and_height_eq_one_and_iInf_localization_eq_bot
    (R := A) K).2.2 (algebraMap C K y) hzne
  set x : R := algebraMap C R y
  set J : Ideal A := (Submodule.span A {algebraMap C K y}).comap (Algebra.linearMap A K)
  have hx0 : x ≠ 0 := fun h => hy0 (hCR (by rw [map_zero]; exact h))
  have hxnzd : x ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hx0
  have hxm : x ∈ IsLocalRing.maximalIdeal R :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff R 𝔮 y).2 hy𝔮
  -- Step 2: the `A`-linear isomorphism `A ⧸ J ≃ R ⧸ xR`.
  have hsurj' : Function.Surjective (Algebra.ofId A (R ⧸ Ideal.span {x})) := hsurj
  have hker' : RingHom.ker (Algebra.ofId A (R ⧸ Ideal.span {x})) = J := hker
  have eAlg : (A ⧸ J) ≃ₐ[A] (R ⧸ Ideal.span {x}) :=
    (Ideal.quotientEquivAlgOfEq A hker'.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hsurj')
  -- Step 3: associated primes descend to `A`.
  have key : ∀ p : Ideal R, p ∈ associatedPrimes R (R ⧸ Ideal.span {x}) →
      p.comap (algebraMap A R) ∈ associatedPrimes A (A ⧸ J) := by
    intro p hp
    have : p.IsPrime := hp.1
    obtain ⟨m, hm⟩ := hp.2
    refine (LinearEquiv.isAssociatedPrime_iff eAlg.toLinearEquiv).2 ⟨Ideal.comap_isPrime _ _, m, ?_⟩
    rw [hm, Ideal.comap_radical]
    congr 1
    ext a
    simp only [Ideal.mem_comap, Submodule.mem_colon_singleton, Submodule.mem_bot,
      IsScalarTower.algebraMap_smul]
  -- Step 5: the associated primes of `R ⧸ xR` are regular of height one.
  have hmain : ∀ (p : Ideal R) (_ : p.IsPrime),
      p ∈ associatedPrimes R (R ⧸ Ideal.span {x}) →
      IsRegularLocalRing (Localization.AtPrime p) ∧ p.height = 1 := by
    intro p hpp hp
    set 𝔭 : Ideal A := p.comap (algebraMap A R) with h𝔭def
    have : 𝔭.IsPrime := Ideal.comap_isPrime _ _
    have hp𝔭 : 𝔭 ∈ associatedPrimes A (A ⧸ J) := key p hp
    have h𝔭h : 𝔭.height = 1 := (h031T 𝔭 hp𝔭).2
    have hJ𝔭 : J ≤ 𝔭 := Stacks.AnalyticallyUnramified.NagataDomain.le_of_mem_associatedPrimes hp𝔭
    obtain ⟨a, s, hs, hsy⟩ := exists_mul_eq_of_height_eq_one (C := C) hinj y hy0 𝔭 h𝔭h hJ𝔭
    set T := Localization.AtPrime p
    set q : Ideal C := p.comap (algebraMap C R) with hqdef
    have : q.IsPrime := Ideal.comap_isPrime _ _
    have : IsLocalization.AtPrime T q :=
      IsLocalization.isLocalization_isLocalization_atPrime_isLocalization 𝔮.primeCompl T p
    have hcomapq : q.comap (algebraMap A C) = 𝔭 := by
      rw [hqdef, h𝔭def, Ideal.comap_comap, ← IsScalarTower.algebraMap_eq]
    have hsq : algebraMap A C s ∉ q := by
      intro hmem
      rw [hqdef, Ideal.mem_comap, ← IsScalarTower.algebraMap_apply A C R] at hmem
      exact hs hmem
    have hpc : (q.comap (algebraMap A C)).primeCompl = 𝔭.primeCompl := by
      ext b
      simp only [Ideal.mem_primeCompl_iff, hcomapq]
    have hloc𝔭 : IsLocalization 𝔭.primeCompl T := by
      rw [← hpc]
      exact isLocalization_of_comap (T := T) hAC y hgen a s hsy q hsq
    refine ⟨isRegularLocalRing_of_height_eq_one 𝔭 h𝔭h, ?_⟩
    have h1 : ringKrullDim T = (p.height : WithBot ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height p T
    have h2 : ringKrullDim T = (𝔭.height : WithBot ℕ∞) :=
      IsLocalization.AtPrime.ringKrullDim_eq_height 𝔭 T
    rw [h𝔭h] at h2
    have h3 : (p.height : WithBot ℕ∞) = ((1 : ℕ∞) : WithBot ℕ∞) := h1.symm.trans h2
    exact_mod_cast h3
  -- Steps 6-8: Tag 0330, then Tag 032Y.
  refine (isAnalyticallyUnramified_iff_minimalPrimes_and_isN1 R).2
    (IsAnalyticallyUnramified.of_associatedPrimes_quotient_span_singleton hxnzd hxm ?_ ?_)
  · intro p hp
    have : p.IsPrime := hp.1
    exact Stacks.AnalyticallyUnramified.NagataDomain.mem_minimalPrimes_of_height_eq_one hx0
      (Stacks.AnalyticallyUnramified.NagataDomain.le_of_mem_associatedPrimes hp
        (Ideal.mem_span_singleton_self x)) (hmain p hp.1 hp).2
  · intro p hpp hploc hp
    refine ⟨(hmain p hpp hp).1, ?_⟩
    have : IsDomain (R ⧸ p) := Ideal.Quotient.isDomain p
    have hle : Ideal.span {x} ≤ p :=
      Stacks.AnalyticallyUnramified.NagataDomain.le_of_mem_associatedPrimes hp
    have hsurj2 : Function.Surjective (algebraMap A (R ⧸ p)) := by
      intro z
      obtain ⟨w, rfl⟩ := Ideal.Quotient.factor_surjective hle z
      obtain ⟨b, rfl⟩ := hsurj w
      exact ⟨b, (Ideal.Quotient.factor_mk _ _).symm⟩
    have hker2 : RingHom.ker (algebraMap A (R ⧸ p)) = p.comap (algebraMap A R) := by
      ext b
      rw [RingHom.mem_ker, Ideal.mem_comap]
      exact Ideal.Quotient.eq_zero_iff_mem
    have e2 : (A ⧸ p.comap (algebraMap A R)) ≃+* (R ⧸ p) :=
      (Ideal.quotEquivOfEq hker2.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj2)
    exact IsAnalyticallyUnramified.of_isNagataRing
      (isNagataRing_of_ringEquiv e2 (isNagataRing_quotient hA _))

/-! ### Reduction to a local base -/

/-- **Replacing `A` by `A_𝔫`.** To prove that `C_𝔮` is N-1 one may assume that every element of
the base outside `𝔮` is a unit: localizing `A` at `𝔫 = 𝔮 ∩ A` changes neither `K` nor `C_𝔮`. -/
theorem isN1_atPrime_reduce {A C K : Type u} [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [CommRing C] [IsDomain C] [Field K] [Algebra A C] [Algebra C K] [Algebra A K]
    [IsScalarTower A C K] [IsFractionRing A K]
    (hA : IsNagataRing A) (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤)
    (𝔮 : Ideal C) [𝔮.IsPrime]
    (H : ∀ (A₁ : Type u) [CommRing A₁] [IsDomain A₁] [IsIntegrallyClosed A₁]
           [Algebra A₁ K] [IsFractionRing A₁ K] (C₁ : Type u) [CommRing C₁] [IsDomain C₁]
           [Algebra A₁ C₁] [Algebra C₁ K] [IsScalarTower A₁ C₁ K] (φ : C →+* C₁) (y₁ : C₁)
           (𝔮₁ : Ideal C₁) [𝔮₁.IsPrime],
         IsNagataRing A₁ → Function.Injective (algebraMap C₁ K) → Function.Injective φ →
         Algebra.adjoin A₁ ({y₁} : Set C₁) = ⊤ → φ y = y₁ → 𝔮₁.comap φ = 𝔮 →
         (𝔮.IsMaximal → 𝔮₁.IsMaximal) →
         (∀ α : A₁, algebraMap A₁ C₁ α ∉ 𝔮₁ → IsUnit α) →
         IsN1 (Localization.AtPrime 𝔮₁)) :
    IsN1 (Localization.AtPrime 𝔮) := by
  -- The prime of `A` lying under `𝔮`.
  let 𝔫 : Ideal A := 𝔮.comap (algebraMap A C)
  have h𝔫 : 𝔫.IsPrime := Ideal.comap_isPrime (algebraMap A C) 𝔮
  -- (a) The localized base `A₁ = A_𝔫`, with `K` as its fraction field.
  have hunitsAK : ∀ t : 𝔫.primeCompl, IsUnit (algebraMap A K (t : A)) := by
    intro t
    have ht0 : (t : A) ≠ 0 := fun h0 => t.2 (by rw [h0]; exact 𝔫.zero_mem)
    exact isUnit_iff_ne_zero.2 fun h => ht0 (IsFractionRing.injective A K (by rw [h, map_zero]))
  let A₁ := Localization.AtPrime 𝔫
  let : Algebra A₁ K :=
    (IsLocalization.lift (M := 𝔫.primeCompl) (S := A₁) (g := algebraMap A K) hunitsAK).toAlgebra
  have hAK : ∀ a : A, algebraMap A₁ K (algebraMap A A₁ a) = algebraMap A K a := fun a =>
    IsLocalization.lift_eq (M := 𝔫.primeCompl) hunitsAK a
  have : IsScalarTower A A₁ K := IsScalarTower.of_algebraMap_eq fun a => (hAK a).symm
  have : IsFractionRing A₁ K :=
    IsFractionRing.isFractionRing_of_isLocalization 𝔫.primeCompl A₁ K
      𝔫.primeCompl_le_nonZeroDivisors
  have : IsDomain A₁ :=
    IsLocalization.isDomain_of_le_nonZeroDivisors A₁ 𝔫.primeCompl_le_nonZeroDivisors
  have : IsIntegrallyClosed A₁ :=
    isIntegrallyClosed_of_isLocalization A₁ 𝔫.primeCompl 𝔫.primeCompl_le_nonZeroDivisors
  have hA₁nag : IsNagataRing A₁ := isNagata_of_isLocalization A 𝔫.primeCompl A₁ hA
  -- (b) The localization `C₁` of `C` at the image of `𝔫.primeCompl`.
  have : IsFractionRing C K := isFractionRing_of_injective (A := A) hinj
  let M : Submonoid C := Submonoid.map (algebraMap A C) 𝔫.primeCompl
  have hMout : ∀ x : C, x ∈ M → ∃ t : A, t ∈ 𝔫.primeCompl ∧ algebraMap A C t = x :=
    fun _ hx => hx
  have hMq : M ≤ 𝔮.primeCompl := by
    intro x hx
    obtain ⟨t, ht, rfl⟩ := hMout x hx
    exact ht
  have hMnzd : M ≤ nonZeroDivisors C := hMq.trans 𝔮.primeCompl_le_nonZeroDivisors
  let C₁ := Localization M
  have : IsDomain C₁ := IsLocalization.isDomain_of_le_nonZeroDivisors C₁ hMnzd
  have hunitsCK : ∀ m : M, IsUnit (algebraMap C K (m : C)) := fun m =>
    isUnit_iff_ne_zero.2 fun h =>
      mem_nonZeroDivisors_iff_ne_zero.1 (hMnzd m.2) (hinj (by rw [h, map_zero]))
  let : Algebra C₁ K :=
    (IsLocalization.lift (M := M) (S := C₁) (g := algebraMap C K) hunitsCK).toAlgebra
  have hCK : ∀ c : C, algebraMap C₁ K (algebraMap C C₁ c) = algebraMap C K c := fun c =>
    IsLocalization.lift_eq (M := M) hunitsCK c
  have : IsScalarTower C C₁ K := IsScalarTower.of_algebraMap_eq fun c => (hCK c).symm
  have : IsFractionRing C₁ K := IsFractionRing.isFractionRing_of_isLocalization M C₁ K hMnzd
  have hinj₁ : Function.Injective (algebraMap C₁ K) := IsFractionRing.injective C₁ K
  have hunitsA₁C₁ : ∀ t : 𝔫.primeCompl,
      IsUnit (((algebraMap C C₁).comp (algebraMap A C)) (t : A)) := fun t =>
    IsLocalization.map_units C₁ (⟨algebraMap A C (t : A), ⟨t, t.2, rfl⟩⟩ : M)
  let : Algebra A₁ C₁ :=
    (IsLocalization.lift (M := 𝔫.primeCompl) (S := A₁)
      (g := (algebraMap C C₁).comp (algebraMap A C)) hunitsA₁C₁).toAlgebra
  have hAC₁ : ∀ a : A,
      algebraMap A₁ C₁ (algebraMap A A₁ a) = algebraMap C C₁ (algebraMap A C a) := fun a =>
    IsLocalization.lift_eq (M := 𝔫.primeCompl) hunitsA₁C₁ a
  have : IsScalarTower A₁ C₁ K := by
    refine IsScalarTower.of_algebraMap_eq' (IsLocalization.ringHom_ext 𝔫.primeCompl ?_)
    refine RingHom.ext fun a => ?_
    simp only [RingHom.comp_apply]
    rw [hAK, hAC₁, hCK, ← IsScalarTower.algebraMap_apply]
  -- The image of `y` generates `C₁` over `A₁`.
  have hgen₁ : Algebra.adjoin A₁ ({algebraMap C C₁ y} : Set C₁) = ⊤ := by
    have hCmem : ∀ c : C,
        algebraMap C C₁ c ∈ Algebra.adjoin A₁ ({algebraMap C C₁ y} : Set C₁) := by
      intro c
      have hc : c ∈ Algebra.adjoin A ({y} : Set C) := by rw [hgen]; exact Algebra.mem_top
      induction hc using Algebra.adjoin_induction with
      | mem x hx =>
          rw [Set.mem_singleton_iff.1 hx]
          exact Algebra.self_mem_adjoin_singleton _ _
      | algebraMap a =>
          rw [← hAC₁ a]
          exact Subalgebra.algebraMap_mem _ _
      | add u v hu hv ihu ihv => rw [map_add]; exact Subalgebra.add_mem _ ihu ihv
      | mul u v hu hv ihu ihv => rw [map_mul]; exact Subalgebra.mul_mem _ ihu ihv
    refine Algebra.eq_top_iff.2 fun z => ?_
    obtain ⟨⟨c, m⟩, hz⟩ := IsLocalization.surj M z
    obtain ⟨t, ht, htm⟩ := hMout (m : C) m.2
    obtain ⟨v, hv⟩ := (IsLocalization.map_units A₁ (⟨t, ht⟩ : 𝔫.primeCompl)).exists_right_inv
    have key : z = algebraMap C C₁ c * algebraMap A₁ C₁ v :=
      calc z = z * (algebraMap A₁ C₁ (algebraMap A A₁ t) * algebraMap A₁ C₁ v) := by
            rw [← map_mul, hv, map_one, mul_one]
        _ = z * algebraMap C C₁ (m : C) * algebraMap A₁ C₁ v := by rw [hAC₁, htm, mul_assoc]
        _ = algebraMap C C₁ c * algebraMap A₁ C₁ v := by rw [hz]
    rw [key]
    exact Subalgebra.mul_mem _ (hCmem c) (Subalgebra.algebraMap_mem _ _)
  -- (c) The prime `𝔮₁` of `C₁` above `𝔮`.
  have hdisj : Disjoint (M : Set C) (𝔮 : Set C) :=
    Set.disjoint_left.2 fun x hx hx' => hMq hx hx'
  have h𝔮₁ : (𝔮.map (algebraMap C C₁)).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint M C₁ 𝔮 inferInstance hdisj
  have hcomap : (𝔮.map (algebraMap C C₁)).comap (algebraMap C C₁) = 𝔮 :=
    IsLocalization.under_map_of_isPrime_disjoint M C₁ (I := 𝔮) inferInstance hdisj
  -- (d) Maximality is inherited.
  have hmax : 𝔮.IsMaximal → (𝔮.map (algebraMap C C₁)).IsMaximal := by
    intro h
    have := h
    exact IsLocalization.isMaximal_of_isMaximal_disjoint M C₁ 𝔮 hdisj
  -- (e) Every element of `A₁` whose image avoids `𝔮₁` is a unit.
  have hunit₁ : ∀ α : A₁, algebraMap A₁ C₁ α ∉ 𝔮.map (algebraMap C C₁) → IsUnit α := by
    intro α hα
    obtain ⟨⟨a, t⟩, hat⟩ := IsLocalization.surj 𝔫.primeCompl α
    have hanot : a ∉ 𝔫 := by
      intro ha
      have ha' : algebraMap A C a ∈ 𝔮 := ha
      have h1 : algebraMap C C₁ (algebraMap A C a) ∈ 𝔮.map (algebraMap C C₁) :=
        Ideal.mem_map_of_mem _ ha'
      rw [← hAC₁, ← hat, map_mul] at h1
      rcases h𝔮₁.mem_or_mem h1 with h | h
      · exact hα h
      · rw [hAC₁] at h
        have h2 : algebraMap A C (t : A) ∈ 𝔮 := by rw [← hcomap]; exact h
        exact t.2 h2
    have hunitA : IsUnit (algebraMap A A₁ a) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff A₁ 𝔫 a).2 hanot
    rw [← hat] at hunitA
    exact isUnit_of_mul_isUnit_left hunitA
  -- (f) Transport the conclusion back along `C_𝔮 = (C₁)_𝔮₁`.
  let T := Localization.AtPrime (𝔮.map (algebraMap C C₁))
  have : IsDomain T :=
    IsLocalization.isDomain_of_le_nonZeroDivisors T
      (𝔮.map (algebraMap C C₁)).primeCompl_le_nonZeroDivisors
  have hsub : ((𝔮.map (algebraMap C C₁)).comap (algebraMap C C₁)).primeCompl = 𝔮.primeCompl :=
    Submonoid.ext fun x => by
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
  have : IsLocalization 𝔮.primeCompl T :=
    hsub ▸ (inferInstance :
      IsLocalization ((𝔮.map (algebraMap C C₁)).comap (algebraMap C C₁)).primeCompl T)
  exact isN1_atPrime_of_isLocalization (T := T) 𝔮
    (H A₁ C₁ (algebraMap C C₁) (algebraMap C C₁ y) (𝔮.map (algebraMap C C₁)) hA₁nag hinj₁
      (IsLocalization.injective C₁ hMnzd) hgen₁ rfl hcomap hmax hunit₁)

/-- **Tag 0330 at a prime containing the generator, general base.** -/
theorem isN1_atPrime_of_mem' {A C K : Type u} [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [CommRing C] [IsDomain C] [Field K] [Algebra A C] [Algebra C K] [Algebra A K]
    [IsScalarTower A C K] [IsFractionRing A K]
    (hA : IsNagataRing A) (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤)
    (𝔮 : Ideal C) [𝔮.IsPrime] (hy𝔮 : y ∈ 𝔮) :
    IsN1 (Localization.AtPrime 𝔮) := by
  refine isN1_atPrime_reduce hA hinj y hgen 𝔮 ?_
  intro A₁ _ _ _ _ _ C₁ _ _ _ _ _ φ y₁ 𝔮₁ _ hA₁ hinj₁ _ hgen₁ hφy hcomap _ hunit₁
  have hAC₁ : Function.Injective (algebraMap A₁ C₁) :=
    injective_algebraMap_of_isFractionRing (K := K)
  have hy₁ : y₁ ∈ 𝔮₁ := by
    have h : y ∈ 𝔮₁.comap φ := by rw [hcomap]; exact hy𝔮
    rw [← hφy]; exact h
  by_cases hy₁0 : y₁ = 0
  · -- `C₁` is the image of `A₁`, so `C₁_𝔮₁` is a localization of the normal ring `A₁`.
    have hnA₁ : IsNoetherianRing A₁ := hA₁.1
    have hone : algebraMap A₁ C₁ 1 ∉ 𝔮₁ := by
      rw [map_one]; exact 𝔮₁.primeCompl.one_mem
    have : IsLocalization (𝔮₁.comap (algebraMap A₁ C₁)).primeCompl (Localization.AtPrime 𝔮₁) :=
      isLocalization_of_comap hAC₁ y₁ hgen₁ 0 1 (by rw [hy₁0, mul_zero, map_zero]) 𝔮₁ hone
    have : IsDomain (Localization.AtPrime 𝔮₁) :=
      IsLocalization.isDomain_localization 𝔮₁.primeCompl_le_nonZeroDivisors
    have : IsIntegrallyClosed (Localization.AtPrime 𝔮₁) :=
      isIntegrallyClosed_of_isLocalization _ (𝔮₁.comap (algebraMap A₁ C₁)).primeCompl
        (𝔮₁.comap (algebraMap A₁ C₁)).primeCompl_le_nonZeroDivisors
    have : IsNoetherianRing (Localization.AtPrime 𝔮₁) :=
      IsLocalization.isNoetherianRing 𝔮₁.primeCompl _
        (isNoetherianRing_of_adjoin_singleton y₁ hgen₁)
    exact isN1_of_isIntegrallyClosed _
  · exact isN1_atPrime_of_mem hA₁ hinj₁ y₁ hgen₁ hy₁0 𝔮₁ hy₁ hunit₁

/-! ### The residue field at a maximal ideal -/

/-- **The source's monic `f` with `f(x) ∈ 𝔪`.** At a maximal ideal `𝔪` of `C = A[y]` over which
the base is local, the residue field `C/𝔪` is generated by the class of `y` over the *field*
`A/𝔫`, hence is algebraic over it; clearing denominators in a minimal polynomial gives a monic
`f ∈ A[X]` with `f(y) ∈ 𝔪`. -/
theorem exists_monic_aeval_mem {A C : Type u} [CommRing A] [CommRing C] [Algebra A C]
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤)
    (𝔪 : Ideal C) [𝔪.IsMaximal] (hunit : ∀ α : A, algebraMap A C α ∉ 𝔪 → IsUnit α) :
    ∃ f : A[X], f.Monic ∧ aeval y f ∈ 𝔪 := by
  have hnmax : (𝔪.comap (algebraMap A C)).IsMaximal := by
    refine Ideal.isMaximal_iff.2 ⟨?_, fun J x hle hx hxJ => ?_⟩
    · simp only [Ideal.mem_comap, map_one]
      exact fun h => ‹𝔪.IsMaximal›.ne_top ((Ideal.eq_top_iff_one _).2 h)
    · exact (Ideal.eq_top_iff_one J).1 (J.eq_top_of_isUnit_mem hxJ (hunit x hx))
  have hcomp : (algebraMap (A ⧸ 𝔪.comap (algebraMap A C)) (C ⧸ 𝔪)).comp
        (Ideal.Quotient.mk (𝔪.comap (algebraMap A C)))
      = (Ideal.Quotient.mk 𝔪).comp (algebraMap A C) := by
    ext a
    rfl
  have key : ∀ p : A[X], Ideal.Quotient.mk 𝔪 (aeval y p)
      = aeval (Ideal.Quotient.mk 𝔪 y)
          (p.map (Ideal.Quotient.mk (𝔪.comap (algebraMap A C)))) := by
    intro p
    rw [aeval_def, Polynomial.hom_eval₂, aeval_def, Polynomial.eval₂_map, hcomp]
  have hadj : Algebra.adjoin (A ⧸ 𝔪.comap (algebraMap A C))
      ({Ideal.Quotient.mk 𝔪 y} : Set (C ⧸ 𝔪)) = ⊤ := by
    refine le_antisymm le_top fun z _ => ?_
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
    have hc : c ∈ Algebra.adjoin A ({y} : Set C) := hgen ▸ Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hc
    obtain ⟨p, hp⟩ := hc
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range]
    exact ⟨p.map (Ideal.Quotient.mk _), by rw [← key p, hp]⟩
  have hint : IsIntegral (A ⧸ 𝔪.comap (algebraMap A C)) (Ideal.Quotient.mk 𝔪 y) := by
    let := Ideal.Quotient.field (𝔪.comap (algebraMap A C))
    let := Ideal.Quotient.field 𝔪
    have : Algebra.FiniteType (A ⧸ 𝔪.comap (algebraMap A C)) (C ⧸ 𝔪) :=
      ⟨⟨{Ideal.Quotient.mk 𝔪 y}, by simpa using hadj⟩⟩
    have := finite_of_finite_type_of_isJacobsonRing
      (A ⧸ 𝔪.comap (algebraMap A C)) (C ⧸ 𝔪)
    exact Algebra.IsIntegral.isIntegral _
  obtain ⟨g, hgmonic, hgeval⟩ := hint
  obtain ⟨f, hfmap, -, hfmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic
      (Polynomial.mem_lifts_of_surjective Ideal.Quotient.mk_surjective g) hgmonic
  refine ⟨f, hfmonic, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, key f, hfmap]
  exact hgeval

/-! ### The finite extension splitting `f` -/

/-- The generator of a monogenic subalgebra generates it over the base. -/
theorem adjoin_singleton_top {A L : Type u} [CommRing A] [CommRing L] [Algebra A L] (z : L) :
    Algebra.adjoin A ({(⟨z, Algebra.self_mem_adjoin_singleton A z⟩ :
        ↥(Algebra.adjoin A ({z} : Set L)))} : Set ↥(Algebra.adjoin A ({z} : Set L))) = ⊤ := by
  rw [← Algebra.adjoin_adjoin_coe_preimage (R := A) (s := ({z} : Set L))]
  congr 1
  ext w
  simp [Subtype.ext_iff]

/-- **The source's `S' = S[e]`.** If `A'` is module-finite over `A` and `C'` is generated over `A'`
by the image of the generator `y` of `C`, then `C'` is module-finite over `C`: an `A`-module
generating set of `A'` generates `C'` over `C`, since the powers of the generator already come
from `C`. -/
theorem module_finite_adjoin_singleton {A A' C C' : Type u} [CommRing A] [CommRing A'] [CommRing C]
    [CommRing C'] [Algebra A A'] [Algebra A C] [Algebra C C'] [Algebra A' C'] [Algebra A C']
    [IsScalarTower A A' C'] [IsScalarTower A C C'] [Module.Finite A A'] (y : C)
    (hgen' : Algebra.adjoin A' ({algebraMap C C' y} : Set C') = ⊤) : Module.Finite C C' := by
  classical
  obtain ⟨e, he⟩ := Module.finite_def.mp ‹Module.Finite A A'›
  refine Module.finite_def.mpr ⟨e.image (algebraMap A' C'), ?_⟩
  rw [Finset.coe_image]
  set N : Submodule C C' := Submodule.span C ((algebraMap A' C') '' (e : Set A'))
  have hA' : ∀ v : A', algebraMap A' C' v ∈ N := by
    intro v
    have hv : v ∈ Submodule.span A (e : Set A') := he ▸ Submodule.mem_top
    induction hv using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
    | zero => simp
    | add x y _ _ hx hy => simpa [map_add] using N.add_mem hx hy
    | smul a x _ hx =>
        have h1 : algebraMap A' C' (a • x) = algebraMap A C a • algebraMap A' C' x := by
          rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply A A' C',
            Algebra.smul_def, IsScalarTower.algebraMap_apply A C C']
        rw [h1]
        exact N.smul_mem _ hx
  have key : ∀ p : A'[X], aeval (algebraMap C C' y) p ∈ N := by
    intro p
    induction p using Polynomial.induction_on' with
    | add p q hp hq => simpa [map_add] using N.add_mem hp hq
    | monomial n v =>
        have h2 : aeval (algebraMap C C' y) (Polynomial.monomial n v)
            = (y ^ n) • algebraMap A' C' v := by
          rw [Polynomial.aeval_monomial, Algebra.smul_def, map_pow, mul_comm]
        rw [h2]
        exact N.smul_mem _ (hA' v)
  refine eq_top_iff.2 fun w _ => ?_
  have hw : w ∈ Algebra.adjoin A' ({algebraMap C C' y} : Set C') := hgen' ▸ Algebra.mem_top
  rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.mem_range] at hw
  obtain ⟨p, hp⟩ := hw
  exact hp ▸ key p

/-- **The source's `R'`.** The integral closure of a Nagata domain `A` in a finite extension `L` of
its fraction field is module-finite over `A` — because `A` is N-2 — and again Nagata, by
Tag 032T. -/
theorem module_finite_and_isNagataRing_integralClosure {A K L : Type u} [CommRing A] [IsDomain A]
    [Field K] [Field L] [Algebra A K] [IsFractionRing A K] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] [FiniteDimensional K L] (hA : IsNagataRing A) :
    Module.Finite A ↥(integralClosure A L) ∧ IsNagataRing ↥(integralClosure A L) := by
  let e : FractionRing A ≃ₐ[A] K := IsLocalization.algEquiv (nonZeroDivisors A) _ _
  let _ : Algebra (FractionRing A) K := (e : FractionRing A →+* K).toAlgebra
  let _ : Algebra (FractionRing A) L :=
    ((algebraMap K L).comp (e : FractionRing A →+* K)).toAlgebra
  have hAK : ∀ x : FractionRing A, algebraMap (FractionRing A) K x = e x := fun _ => rfl
  have hAL : ∀ x : FractionRing A, algebraMap (FractionRing A) L x = algebraMap K L (e x) :=
    fun _ => rfl
  have : IsScalarTower A (FractionRing A) L := IsScalarTower.of_algebraMap_eq fun a => by
    rw [hAL, e.commutes, ← IsScalarTower.algebraMap_apply A K L]
  have : IsScalarTower (FractionRing A) K L := IsScalarTower.of_algebraMap_eq fun x => rfl
  have : Module.Finite (FractionRing A) K :=
    Module.Finite.of_surjective (Algebra.linearMap (FractionRing A) K) fun z =>
      ⟨e.symm z, by simp [Algebra.linearMap_apply, hAK]⟩
  have : FiniteDimensional (FractionRing A) L := Module.Finite.trans K L
  have hfin : Module.Finite A ↥(integralClosure A L) := (isJapaneseRing_of_isNagataRing hA).finite L
  exact ⟨hfin, isNagataRing_of_quasiFinite hA⟩

/-- **The source's passage to a finite extension of `K`.** If some monic `f ∈ A[X]` has
`f(y) ∈ 𝔪`, then `C_𝔪` is N-1: split `f` in a finite extension `L/K`, replace `A` by its
integral closure `A'` in `L` — module-finite over `A` since `A` is N-2, and again Nagata by
Tag 032T — and `C` by `C' = A'[y]`, which is module-finite over `C`. Every maximal ideal of the
localization of `C'` above `𝔪` contains `y - α` for one of the roots `α ∈ A'` of `f`, so
`isN1_atPrime_of_mem'` applies there; Tag 0333 assembles these and Tag 032K descends the
conclusion to `C_𝔪`. -/
theorem isN1_atPrime_of_exists_monic {A C K : Type u} [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] [CommRing C] [IsDomain C] [Field K] [Algebra A C] [Algebra C K]
    [Algebra A K] [IsScalarTower A C K] [IsFractionRing A K]
    (hA : IsNagataRing A) (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤)
    (𝔪 : Ideal C) [𝔪.IsMaximal] (hf : ∃ f : A[X], f.Monic ∧ aeval y f ∈ 𝔪) :
    IsN1 (Localization.AtPrime 𝔪) := by
  obtain ⟨f, hfm, hfy⟩ := hf
  have hnA : IsNoetherianRing A := hA.1
  have hnC : IsNoetherianRing C := isNoetherianRing_of_adjoin_singleton y hgen
  have : IsDomain (Localization.AtPrime 𝔪) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors _ 𝔪.primeCompl_le_nonZeroDivisors
  -- The algebraic core: `C'` is module-finite over `C`, so N-1 descends from a localization of
  -- `C'` to `C_𝔪`, and Tag 0333 gives N-1 for that localization.
  have main : ∀ (L : Type u) [Field L] (A' : Type u) [CommRing A'] [IsDomain A']
      [IsIntegrallyClosed A'] [Algebra A' L] [IsFractionRing A' L] (C' : Type u) [CommRing C']
      [IsDomain C'] [Algebra A' C'] [Algebra C' L] [IsScalarTower A' C' L] [Algebra C C']
      [Module.Finite C C'], IsNagataRing A' → Function.Injective (algebraMap C' L) →
      Function.Injective (algebraMap C C') →
      Algebra.adjoin A' ({algebraMap C C' y} : Set C') = ⊤ →
      (∃ s : Multiset C', (∀ z ∈ s, Algebra.adjoin A' ({z} : Set C') = ⊤) ∧
        algebraMap C C' (aeval y f) = s.prod) →
      IsN1 (Localization.AtPrime 𝔪) := by
    intro L _ A' _ _ _ _ _ C' _ _ _ _ _ _ _ hnag' hinjL hinjφ hgen' hfact
    have hM'le : Algebra.algebraMapSubmonoid C' 𝔪.primeCompl ≤ nonZeroDivisors C' := by
      rintro x ⟨c, hc, rfl⟩
      refine mem_nonZeroDivisors_of_ne_zero fun h0 => ?_
      have hc0 : c = 0 := hinjφ (by rw [h0, map_zero])
      exact Ideal.mem_primeCompl_iff.mp hc (by rw [hc0]; exact 𝔪.zero_mem)
    have : IsDomain (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors _ hM'le
    have : IsNoetherianRing C' := IsNoetherianRing.of_finite C C'
    have : IsNoetherianRing (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) :=
      IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)
        (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) ‹IsNoetherianRing C'›
    have hunit : ∀ w : Algebra.algebraMapSubmonoid C' 𝔪.primeCompl,
        IsUnit (algebraMap C' L (w : C')) := by
      intro w
      refine isUnit_iff_ne_zero.2 fun h0 => nonZeroDivisors.ne_zero (hM'le w.2) ?_
      exact hinjL (by rw [h0, map_zero])
    let : Algebra (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) L :=
      (IsLocalization.lift (M := Algebra.algebraMapSubmonoid C' 𝔪.primeCompl) hunit).toAlgebra
    have : IsScalarTower C' (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) L :=
      IsScalarTower.of_algebraMap_eq fun x => (IsLocalization.lift_eq hunit x).symm
    have hTN1 : IsN1 (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) := by
      refine isN1_of_forall_isN1_atPrime (A := A') (K := L)
        (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl) hM'le hinjL (algebraMap C C' y) hgen'
        fun 𝔫 h𝔫 => ?_
      have := h𝔫
      have hqprime : (𝔫.comap (algebraMap C'
          (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)))).IsPrime :=
        Ideal.comap_isPrime _ _
      -- the contraction of `𝔫` to `C` is `𝔪`
      have hcomp : (algebraMap C' (Localization (Algebra.algebraMapSubmonoid C'
            𝔪.primeCompl))).comp (algebraMap C C')
          = (algebraMap (Localization.AtPrime 𝔪) (Localization (Algebra.algebraMapSubmonoid C'
            𝔪.primeCompl))).comp (algebraMap C (Localization.AtPrime 𝔪)) := by
        rw [IsLocalization.algebraMap_eq_map_map_submonoid 𝔪.primeCompl C'
          (Localization.AtPrime 𝔪) (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl))]
        exact (IsLocalization.map_comp _).symm
      have : Algebra.IsIntegral (Localization.AtPrime 𝔪)
          (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)) :=
        Algebra.IsIntegral.of_finite _ _
      have hmax : (𝔫.comap (algebraMap (Localization.AtPrime 𝔪)
          (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)))).IsMaximal :=
        Ideal.isMaximal_under_of_isIntegral_of_isMaximal 𝔫
      have hq𝔪 : (𝔫.comap (algebraMap C' (Localization (Algebra.algebraMapSubmonoid C'
          𝔪.primeCompl)))).comap (algebraMap C C') = 𝔪 := by
        rw [Ideal.comap_comap, hcomp, ← Ideal.comap_comap, IsLocalRing.eq_maximalIdeal hmax]
        exact Localization.AtPrime.under_maximalIdeal
      obtain ⟨s, hs, hprod⟩ := hfact
      have hmemq : s.prod ∈ 𝔫.comap (algebraMap C'
          (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl))) := by
        rw [← hprod]
        have h2 : aeval y f ∈ (𝔫.comap (algebraMap C' (Localization
            (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)))).comap (algebraMap C C') := by
          rw [hq𝔪]; exact hfy
        exact h2
      obtain ⟨z, hzs, hzq⟩ := (hqprime.multiset_prod_mem_iff_exists_mem s).1 hmemq
      have h1 : IsN1 (Localization.AtPrime (𝔫.comap (algebraMap C'
          (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl))))) :=
        isN1_atPrime_of_mem' (A := A') (C := C') (K := L) hnag' hinjL z (hs z hzs) _ hzq
      have : IsDomain (Localization.AtPrime 𝔫) :=
        IsLocalization.isDomain_of_le_nonZeroDivisors _ 𝔫.primeCompl_le_nonZeroDivisors
      exact isN1_of_ringEquiv (IsLocalization.algEquiv (𝔫.comap (algebraMap C'
        (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl)))).primeCompl
        (Localization.AtPrime (𝔫.comap (algebraMap C' (Localization
          (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl))))) (Localization.AtPrime 𝔫)).toRingEquiv h1
    exact isN1_of_finite_of_isN1 (Localization.AtPrime 𝔪)
      (Localization (Algebra.algebraMapSubmonoid C' 𝔪.primeCompl))
      (localizationAlgebra_injective _ _ hinjφ) inferInstance hTN1
  -- Passing to a finite extension of `K` in which `f` splits.
  have step1 : ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L],
      ((f.map (algebraMap A K)).map (algebraMap K L)).Splits →
      IsN1 (Localization.AtPrime 𝔪) := by
    intro L _ _ _ hsplit
    let : Algebra A L := ((algebraMap K L).comp (algebraMap A K)).toAlgebra
    have : IsScalarTower A K L := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let : Algebra C L := ((algebraMap K L).comp (algebraMap C K)).toAlgebra
    have : IsScalarTower C K L := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hACL : ∀ a : A, algebraMap A L a = algebraMap C L (algebraMap A C a) := fun a => by
      show algebraMap K L (algebraMap A K a) = algebraMap K L (algebraMap C K (algebraMap A C a))
      rw [← IsScalarTower.algebraMap_apply A C K]
    have : IsScalarTower A C L := IsScalarTower.of_algebraMap_eq hACL
    have hCLinj : Function.Injective (algebraMap C L) := fun a b hab =>
      hinj ((algebraMap K L).injective
        (show algebraMap K L (algebraMap C K a) = algebraMap K L (algebraMap C K b) from hab))
    obtain ⟨hfinA', hnagA'⟩ :=
      module_finite_and_isNagataRing_integralClosure (A := A) (K := K) (L := L) hA
    have := hfinA'
    have : IsFractionRing ↥(integralClosure A L) L :=
      integralClosure.isFractionRing_of_finite_extension K L
    have : IsIntegrallyClosed ↥(integralClosure A L) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension K
    -- the image of `C` in `L` lies in `A'[y]`
    have hmemC' : ∀ c : C, algebraMap C L c ∈
        Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L) := by
      intro c
      have hc : c ∈ Algebra.adjoin A ({y} : Set C) := hgen ▸ Algebra.mem_top
      induction hc using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact Algebra.self_mem_adjoin_singleton _ _
      | algebraMap r =>
        rw [← hACL r]
        exact Subalgebra.algebraMap_mem _
          (⟨algebraMap A L r, (mem_integralClosure_iff A L).2 isIntegral_algebraMap⟩ :
            ↥(integralClosure A L))
      | add u v _ _ hu hv => rw [map_add]; exact add_mem hu hv
      | mul u v _ _ hu hv => rw [map_mul]; exact mul_mem hu hv
    let : Algebra C ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) :=
      RingHom.toAlgebra
        { toFun := fun c => ⟨algebraMap C L c, hmemC' c⟩
          map_one' := Subtype.ext (map_one (algebraMap C L))
          map_mul' := fun a b => Subtype.ext (map_mul (algebraMap C L) a b)
          map_zero' := Subtype.ext (map_zero (algebraMap C L))
          map_add' := fun a b => Subtype.ext (map_add (algebraMap C L) a b) }
    have hφ : ∀ c : C, (algebraMap C
        ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) c : L)
        = algebraMap C L c := fun _ => rfl
    have hinjC'L : Function.Injective (algebraMap
        ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) L) :=
      fun a b hab => Subtype.ext hab
    have hφinj : Function.Injective (algebraMap C
        ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L))) := by
      intro a b hab
      exact hCLinj (by rw [← hφ a, ← hφ b, hab])
    have hgen' : Algebra.adjoin ↥(integralClosure A L)
        ({algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
          ({algebraMap C L y} : Set L)) y} :
          Set ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L))) = ⊤ :=
      adjoin_singleton_top (algebraMap C L y)
    have : IsScalarTower A C
        ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) :=
      IsScalarTower.of_algebraMap_eq fun a => Subtype.ext (hACL a)
    have : Module.Finite C
        ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) :=
      module_finite_adjoin_singleton (A := A) y hgen'
    -- the roots of `f` in `L`
    have hgeq : (f.map (algebraMap A K)).map (algebraMap K L) = f.map (algebraMap A L) := by
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq A K L]
    have hsplit' : (f.map (algebraMap A L)).Splits := hgeq ▸ hsplit
    have hmonic' : (f.map (algebraMap A L)).Monic := hfm.map _
    have hroot : ∀ r ∈ (f.map (algebraMap A L)).roots, r ∈ integralClosure A L := by
      intro r hr
      rw [Polynomial.mem_roots'] at hr
      refine (mem_integralClosure_iff A L).2 ⟨f, hfm, ?_⟩
      have h2 : Polynomial.eval r (f.map (algebraMap A L)) = 0 := hr.2
      rwa [Polynomial.eval_map] at h2
    refine main L ↥(integralClosure A L)
      ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L))
      hnagA' hinjC'L hφinj hgen' ⟨(f.map (algebraMap A L)).roots.attach.map
        (fun r => algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
            ({algebraMap C L y} : Set L)) y
          - algebraMap ↥(integralClosure A L) ↥(Algebra.adjoin ↥(integralClosure A L)
            ({algebraMap C L y} : Set L)) ⟨r.1, hroot r.1 r.2⟩), ?_, ?_⟩
    · intro z hz
      rw [Multiset.mem_map] at hz
      obtain ⟨r, -, rfl⟩ := hz
      have h1 : Algebra.adjoin ↥(integralClosure A L)
          ({algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
              ({algebraMap C L y} : Set L)) y
            - algebraMap ↥(integralClosure A L) ↥(Algebra.adjoin ↥(integralClosure A L)
              ({algebraMap C L y} : Set L)) ⟨r.1, hroot r.1 r.2⟩} :
            Set ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)))
          = Algebra.adjoin ↥(integralClosure A L)
            ({algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
              ({algebraMap C L y} : Set L)) y} :
              Set ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L))) := by
        refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
        · rw [Set.singleton_subset_iff]
          exact sub_mem (Algebra.self_mem_adjoin_singleton _ _) (Subalgebra.algebraMap_mem _ _)
        · rw [Set.singleton_subset_iff]
          have h3 := add_mem (Algebra.self_mem_adjoin_singleton ↥(integralClosure A L)
            (algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
                ({algebraMap C L y} : Set L)) y
              - algebraMap ↥(integralClosure A L) ↥(Algebra.adjoin ↥(integralClosure A L)
                ({algebraMap C L y} : Set L)) ⟨r.1, hroot r.1 r.2⟩))
            (Subalgebra.algebraMap_mem _ (⟨r.1, hroot r.1 r.2⟩ : ↥(integralClosure A L)))
          simpa using h3
      rw [h1]
      exact hgen'
    · apply hinjC'L
      have key : ∀ r : {x // x ∈ (f.map (algebraMap A L)).roots},
          algebraMap ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) L
              (algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
                  ({algebraMap C L y} : Set L)) y
                - algebraMap ↥(integralClosure A L) ↥(Algebra.adjoin ↥(integralClosure A L)
                  ({algebraMap C L y} : Set L)) ⟨r.1, hroot r.1 r.2⟩)
            = algebraMap C L y - r.1 := by
        intro r
        rw [RingHom.map_sub]
        rfl
      calc algebraMap ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) L
            (algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
              ({algebraMap C L y} : Set L)) (aeval y f))
          = Polynomial.eval (algebraMap C L y) (f.map (algebraMap A L)) := by
            rw [Polynomial.eval_map_algebraMap, Polynomial.aeval_algebraMap_apply L y f]
            rfl
        _ = ((f.map (algebraMap A L)).roots.map fun x => algebraMap C L y - x).prod :=
            hsplit'.eval_eq_prod_roots_of_monic hmonic' _
        _ = algebraMap ↥(Algebra.adjoin ↥(integralClosure A L) ({algebraMap C L y} : Set L)) L
            (((f.map (algebraMap A L)).roots.attach.map
              (fun r => algebraMap C ↥(Algebra.adjoin ↥(integralClosure A L)
                  ({algebraMap C L y} : Set L)) y
                - algebraMap ↥(integralClosure A L) ↥(Algebra.adjoin ↥(integralClosure A L)
                  ({algebraMap C L y} : Set L)) ⟨r.1, hroot r.1 r.2⟩)).prod) := by
            rw [map_multiset_prod, Multiset.map_map]
            conv_lhs => rw [← Multiset.attach_map_val (f.map (algebraMap A L)).roots]
            rw [Multiset.map_map]
            exact congrArg Multiset.prod (Multiset.map_congr rfl fun r _ => (key r).symm)
  exact step1 (f.map (algebraMap A K)).SplittingField (Polynomial.SplittingField.splits _)

/-! ### The main theorem -/

/-- **The source's `(***)`.** Let `A` be a normal Nagata domain with fraction field `K` and let
`C` be an `A`-subalgebra of `K` generated by a single element. Then `C` is N-1: the integral
closure of `C` in `K` is a finite `C`-module. -/
theorem module_finite_integralClosure {A C K : Type u} [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] [CommRing C] [IsDomain C] [Field K] [Algebra A C] [Algebra C K]
    [Algebra A K] [IsScalarTower A C K] [IsFractionRing A K]
    (hA : IsNagataRing A) (hinj : Function.Injective (algebraMap C K))
    (y : C) (hgen : Algebra.adjoin A ({y} : Set C) = ⊤) :
    Module.Finite C (integralClosure C K) := by
  have : IsNoetherianRing A := hA.1
  have : IsFractionRing C K := isFractionRing_of_injective (A := A) hinj
  have : IsNoetherianRing C := isNoetherianRing_of_adjoin_singleton y hgen
  have : IsLocalization (⊥ : Submonoid C) C := by
    rw [isLocalization_iff]
    refine ⟨fun t => ?_, fun z => ⟨⟨z, 1⟩, by simp⟩, fun {x z} h => ⟨1, by simpa using h⟩⟩
    rw [show (t : C) = 1 from Submonoid.mem_bot.1 t.2, map_one]
    exact isUnit_one
  have hbot : (⊥ : Submonoid C) ≤ nonZeroDivisors C := by
    intro t ht
    rw [Submonoid.mem_bot.1 ht]
    exact Submonoid.one_mem _
  have hN1 : IsN1 C := by
    refine isN1_of_forall_isN1_atPrime (A := A) (C := C) (D := C) (K := K) ⊥ hbot hinj y hgen ?_
    intro 𝔪 h𝔪
    have := h𝔪
    refine isN1_atPrime_reduce hA hinj y hgen 𝔪 ?_
    intro A₁ _ _ _ _ _ C₁ _ _ _ _ _ φ y₁ 𝔮₁ _ hA₁ hinj₁ _ hgen₁ _ _ hmax hunit₁
    have := hmax h𝔪
    exact isN1_atPrime_of_exists_monic hA₁ hinj₁ y₁ hgen₁ 𝔮₁
      (exists_monic_aeval_mem y₁ hgen₁ 𝔮₁ hunit₁)
  exact module_finite_integralClosure_of_isN1 C K hN1

end MonogenicN1

