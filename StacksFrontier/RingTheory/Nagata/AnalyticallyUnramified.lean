/-!
# Nagata local rings and analytic unramifiedness

Proof of `isNagataRing_tfae_isAnalyticallyUnramified` (Stacks 0BI2): for a Noetherian local ring
`(R, 𝔪)` the following are equivalent:

1. `R` is Nagata;
2. for `R → S` finite with `S` a domain and `𝔪' ⊂ S` maximal, `S_{𝔪'}` is analytically unramified;
3. for `(R, 𝔪) → (S, 𝔪')` a finite local homomorphism with `S` a domain, `S` is analytically
   unramified.

The argument is the source's. A finite algebra over a Nagata ring is Nagata, and so are its
localizations, and a Nagata local ring is analytically unramified (Lemma 0331); this gives
(1) ⇒ (2).
A finite local domain over `R` is its own localization at its maximal ideal, which gives
(2) ⇒ (3).
For (3) ⇒ (1), let `𝔭` be a prime of `R`, `A = R/𝔭` and `L` a finite extension of the fraction
field of `A`. If `A` is a field there is nothing to prove. Otherwise choose `0 ≠ g ∈ 𝔪_A` and a
basis of `L` over `Frac(A)` of elements integral over `A` whose minimal polynomials have all
non-leading coefficients divisible by `g`. The `A`-algebra `B` they generate is finite and local
— its generators lie in every maximal ideal — with fraction field `L`, and it is analytically
unramified by (3), so its integral closure in `L` is finite over `B` (Lemma 032Y), hence over `A`.

## Main results

* `IsAnalyticallyUnramified.of_ringEquiv`: analytic unramifiedness transports along ring
  isomorphisms.
* `isNagataRing_tfae_isAnalyticallyUnramified`: Stacks 0BI2.

## Implementation notes

The two families of test algebras live in `Type (max u v)` and `Type (max u w)` for `R : Type u`:
every finite `R`-algebra is small over `R`, so each family contains a copy of every finite domain
algebra, while quantifying over a universe below `u` could make the conditions vacuous. In item (2)
the maximal ideal is arbitrary; in item (3) the local ring structure on `S` and locality of
`R → S` are explicit hypotheses.

## References

* [Stacks Project, Tag 0BI2](https://stacks.math.columbia.edu/tag/0BI2)
-/

@[expose] public section

universe u v w

open Polynomial IsLocalRing

/-- Analytic unramifiedness transports along an isomorphism of local rings, which induces an
isomorphism of their completions. -/
theorem IsAnalyticallyUnramified.of_ringEquiv {A B : Type*} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] (e : A ≃+* B) (hB : IsAnalyticallyUnramified B) :
    IsAnalyticallyUnramified A := by
  obtain ⟨E⟩ := AdicCompletion.nonempty_algEquiv_of_algEquiv e.toIntAlgEquiv (maximalIdeal A)
    (maximalIdeal B) (map_ringEquiv_maximalIdeal e).symm
  rw [isAnalyticallyUnramified_iff] at hB ⊢
  exact isReduced_of_injective E.toRingHom E.injective

namespace Stacks.Nagata.AnalyticUnramifiedTFAE

/-- A root of a monic polynomial whose non-leading coefficients lie in the maximal ideal of the
local base lies in every maximal ideal of an integral algebra: modulo such an ideal the polynomial
becomes `Xⁿ`. -/
private theorem mem_maximal_of_aeval_eq_zero {A B : Type*} [CommRing A] [IsLocalRing A]
    [CommRing B] [Algebra A B] [Algebra.IsIntegral A B] (q : Ideal B) [q.IsMaximal] (x : B)
    (f : A[X]) (hf : f.Monic) (hc : ∀ i < f.natDegree, f.coeff i ∈ maximalIdeal A)
    (hx : aeval x f = 0) : x ∈ q := by
  have hq : q.under A = maximalIdeal A := eq_maximalIdeal inferInstance
  have hc' (i : ℕ) (hi : i < f.natDegree) : algebraMap A (B ⧸ q) (f.coeff i) = 0 := by
    have hmem : f.coeff i ∈ q.under A := hq ▸ hc i hi
    rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_comap.mp hmem
  have hmap : f.map (algebraMap A (B ⧸ q)) = X ^ f.natDegree := by
    ext i
    by_cases hi : i = f.natDegree
    · simp [hi, hf]
    · rcases lt_or_gt_of_ne hi with hlt | hgt
      · simp [hi, hc' i hlt]
      · simp [hi, coeff_eq_zero_of_natDegree_lt hgt]
  have he : aeval (Ideal.Quotient.mkₐ A q x) f = 0 := by rw [aeval_algHom_apply, hx, map_zero]
  rw [← aeval_map_algebraMap (B ⧸ q), hmap, map_pow, aeval_X, Ideal.Quotient.mkₐ_eq_mk] at he
  exact Ideal.Quotient.eq_zero_iff_mem.mp (eq_zero_of_pow_eq_zero he)

/-- An integral algebra over a local ring is local when it is generated by elements lying in every
maximal ideal: modulo any maximal ideal, every element is congruent to the same element of the
base, so any two maximal ideals contain each other. -/
private theorem isLocalRing_of_adjoin_eq_top_of_mem_maximal {A B : Type*} [CommRing A]
    [IsLocalRing A] [CommRing B] [Nontrivial B] [Algebra A B] [Algebra.IsIntegral A B] (s : Set B)
    (hs : Algebra.adjoin A s = ⊤) (hm : ∀ (q : Ideal B) [q.IsMaximal], s ⊆ q) : IsLocalRing B := by
  obtain ⟨q, hq⟩ := Ideal.exists_maximal B
  refine IsLocalRing.of_unique_max_ideal ⟨q, hq, fun p hp ↦ ?_⟩
  refine hp.eq_of_le hq.ne_top fun x hx ↦ ?_
  have hrep : ∃ a : A, Ideal.Quotient.mk p x = algebraMap A (B ⧸ p) a ∧
      Ideal.Quotient.mk q x = algebraMap A (B ⧸ q) a := by
    clear hx
    have hmem : x ∈ Algebra.adjoin A s := hs.symm ▸ Algebra.mem_top
    induction hmem using Algebra.adjoin_induction with
    | mem x hx =>
      exact ⟨0, by simpa using Ideal.Quotient.eq_zero_iff_mem.mpr (hm p hx),
        by simpa using Ideal.Quotient.eq_zero_iff_mem.mpr (hm q hx)⟩
    | algebraMap a => exact ⟨a, rfl, rfl⟩
    | add x y hx hy ihx ihy =>
      obtain ⟨a, ha, ha'⟩ := ihx
      obtain ⟨b, hb, hb'⟩ := ihy
      exact ⟨a + b, by simp [ha, hb], by simp [ha', hb']⟩
    | mul x y hx hy ihx ihy =>
      obtain ⟨a, ha, ha'⟩ := ihx
      obtain ⟨b, hb, hb'⟩ := ihy
      exact ⟨a * b, by simp [ha, hb], by simp [ha', hb']⟩
  obtain ⟨a, ha, ha'⟩ := hrep
  have ha0 : a ∈ p.under A := Ideal.mem_comap.mpr <| by
    rw [← Ideal.Quotient.eq_zero_iff_mem, Ideal.Quotient.mk_algebraMap, ← ha]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
  have haq : a ∈ q.under A := by
    rwa [eq_maximalIdeal (Ideal.IsMaximal.under A p),
      ← eq_maximalIdeal (Ideal.IsMaximal.under A q)] at ha0
  exact Ideal.Quotient.eq_zero_iff_mem.mp
    (ha'.trans (by
      rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_comap.mp haq))

/-- The subalgebra of a field generated by finitely many roots of monic polynomials whose
non-leading coefficients lie in the maximal ideal of the local base is local. -/
private theorem isLocalRing_adjoin_of_monic {A L : Type*} [CommRing A] [IsLocalRing A] [Field L]
    [Algebra A L] (s : Finset L) (hs : ∀ x ∈ s, ∃ f : A[X], f.Monic ∧
      (∀ i < f.natDegree, f.coeff i ∈ maximalIdeal A) ∧ aeval x f = 0) :
    IsLocalRing (Algebra.adjoin A (s : Set L)) := by
  let B := Algebra.adjoin A (s : Set L)
  have : Module.Finite A B := Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
    fun x hx ↦ by
      obtain ⟨f, hf, _, he⟩ := hs x hx
      exact ⟨f, hf, he⟩
  refine isLocalRing_of_adjoin_eq_top_of_mem_maximal {x : B | x.val ∈ s}
    Algebra.adjoin_adjoin_coe_preimage fun q _ x hx ↦ ?_
  obtain ⟨f, hf, hc, he⟩ := hs x.val hx
  refine mem_maximal_of_aeval_eq_zero q x f hf hc (Subtype.val_injective ?_)
  rw [Polynomial.aeval_subalgebra_coe, ZeroMemClass.coe_zero]
  exact he

/-- A module-finite algebra map between local rings is local. -/
private theorem isLocalHom_of_finite {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B]
    [IsLocalRing B] [Algebra A B] [Module.Finite A B] : IsLocalHom (algebraMap A B) :=
  ((local_hom_TFAE (algebraMap A B)).out 1 5).mpr
    (eq_maximalIdeal (Ideal.IsMaximal.under A (maximalIdeal B)))

/-- **(3) ⇒ (1).** A Noetherian local ring all of whose finite local domain algebras are
analytically unramified is Nagata. -/
private theorem isNagataRing_of_finite_local_domains {R : Type u} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R]
    (H : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsLocalRing S] [Algebra R S]
      [Module.Finite R S] [IsLocalHom (algebraMap R S)], IsAnalyticallyUnramified S) :
    IsNagataRing R := by
  refine ⟨inferInstance, fun p _ ↦ ?_⟩
  let A := R ⧸ p
  have : IsLocalRing A :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
  refine { finite := fun L _ _ _ _ _ => ?_ }
  by_cases hm : maximalIdeal A = ⊥
  · let _ : Field A := (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm).toField
    let e := IsLocalization.algEquiv (nonZeroDivisors A) A (FractionRing A)
    have : Module.Finite A (FractionRing A) :=
      Module.Finite.of_surjective e.toLinearMap e.surjective
    have : Module.Finite A L := Module.Finite.trans (FractionRing A) L
    exact Module.Finite.of_injective (integralClosure A L).val.toLinearMap Subtype.val_injective
  obtain ⟨g, hg, hg0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm
  obtain ⟨s, hs, hspan⟩ := exists_clearedBasis_spanning (K := FractionRing A) (L := L) g hg0
  let B := Algebra.adjoin A (s : Set L)
  have : Module.Finite A B := Algebra.finite_adjoin_of_finite_of_isIntegral s.finite_toSet
    fun x hx ↦ by
      obtain ⟨f, hf, _, he⟩ := hs x hx
      exact ⟨f, hf, he⟩
  have : IsLocalRing B := isLocalRing_adjoin_of_monic s fun x hx ↦ by
    obtain ⟨f, hf, hc, he⟩ := hs x hx
    exact ⟨f, hf, fun i hi ↦ Ideal.mem_of_dvd _ (hc i hi) hg, he⟩
  let _ : Algebra R B := ((algebraMap A B).comp (algebraMap R A)).toAlgebra
  have : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq' rfl
  have : Module.Finite R B := Module.Finite.trans A B
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R B
  have : IsLocalHom (algebraMap R B) := isLocalHom_of_finite
  have : IsFractionRing B L := isFractionRing_of_span_eq_top B
    (top_unique (hspan.symm.trans_le (Submodule.span_mono (Algebra.subset_adjoin (R := A)))))
  have : Module.Finite B (integralClosure B L) := module_finite_integralClosure_of_isN1 B L
    ((isAnalyticallyUnramified_iff_minimalPrimes_and_isN1 B).2 (H B))
  have : Algebra.IsIntegral A (integralClosure B L) := Algebra.IsIntegral.trans B
  have : Module.Finite A (integralClosure B L) := Module.Finite.trans B _
  have : IsIntegralClosure (integralClosure B L) A L := IsIntegralClosure.of_isIntegrallyClosedIn
  exact Module.Finite.equiv
    (IsIntegralClosure.equiv A (integralClosure B L) L (integralClosure A L)).toLinearEquiv

/-- **(1) ⇒ (2).** Over a Nagata ring, the localization of a finite domain algebra at a maximal
ideal is analytically unramified. -/
private theorem isAnalyticallyUnramified_atPrime_of_finite {R : Type u} [CommRing R]
    (hR : IsNagataRing R) (S : Type v) [CommRing S] [IsDomain S] [Algebra R S] [Module.Finite R S]
    (q : Ideal S) [q.IsMaximal] : IsAnalyticallyUnramified (Localization.AtPrime q) := by
  have : Small.{u} S := Module.Finite.small R S
  let e : Shrink.{u} S ≃ₐ[R] S := Shrink.algEquiv R S
  have := Module.Finite.equiv e.symm.toLinearEquiv
  let p := q.comap e.toRingHom
  have : p.IsMaximal := Ideal.IsMaximal.comap_bijective e.toRingHom e.bijective inferInstance
  have hp : IsNagataRing (Localization.AtPrime p) := isNagata_of_isLocalization (Shrink.{u} S)
    p.primeCompl (Localization.AtPrime p) (isNagataRing_of_quasiFinite hR)
  exact IsAnalyticallyUnramified.of_ringEquiv
    (Localization.localRingEquiv p q e.toRingEquiv rfl).symm
    (IsAnalyticallyUnramified.of_isNagataRing hp)

/-- A local ring is analytically unramified when its localization at the maximal ideal is. -/
private theorem isAnalyticallyUnramified_of_localization_maximalIdeal {S : Type*} [CommRing S]
    [IsLocalRing S] (h : IsAnalyticallyUnramified (Localization.AtPrime (maximalIdeal S))) :
    IsAnalyticallyUnramified S :=
  IsAnalyticallyUnramified.of_ringEquiv (IsLocalization.atUnits S (maximalIdeal S).primeCompl
    fun x hx ↦ by
      simpa [mem_maximalIdeal, mem_nonunits_iff, IsUnit.mem_submonoid_iff] using hx).toRingEquiv h

end Stacks.Nagata.AnalyticUnramifiedTFAE

open Stacks.Nagata.AnalyticUnramifiedTFAE in
/-- **Stacks 0BI2.** For a Noetherian local ring `R`, the following are equivalent:

1. `R` is a Nagata ring;
2. for every finite `R`-algebra `S` which is a domain and every maximal ideal `𝔪'` of `S`, the
   localization `S_{𝔪'}` is analytically unramified;
3. for every finite local homomorphism `R → S` to a local domain `S`, the ring `S` is analytically
   unramified. -/
@[stacks 0BI2]
theorem isNagataRing_tfae_isAnalyticallyUnramified {R : Type u} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] :
    [IsNagataRing R,
      ∀ (S : Type (max u v)) [CommRing S] [IsDomain S] [Algebra R S] [Module.Finite R S]
        (m' : Ideal S) [m'.IsMaximal], IsAnalyticallyUnramified (Localization.AtPrime m'),
      ∀ (S : Type (max u w)) [CommRing S] [IsDomain S] [IsLocalRing S] [Algebra R S]
        [Module.Finite R S] [IsLocalHom (algebraMap R S)], IsAnalyticallyUnramified S].TFAE := by
  tfae_have 1 → 2
  | h, S, _, _, _, _, q, _ => isAnalyticallyUnramified_atPrime_of_finite h S q
  tfae_have 2 → 3 := by
    intro H S _ _ _ _ _ _
    have : Small.{u} S := Module.Finite.small R S
    let e : ULift.{v} (Shrink.{u} S) ≃ₐ[R] S := ULift.algEquiv.trans (Shrink.algEquiv R S)
    have : IsDomain (ULift.{v} (Shrink.{u} S)) := Function.Injective.isDomain e e.injective
    have : IsLocalRing (ULift.{v} (Shrink.{u} S)) := e.symm.toRingEquiv.isLocalRing
    have := Module.Finite.equiv e.symm.toLinearEquiv
    exact IsAnalyticallyUnramified.of_ringEquiv e.symm.toRingEquiv
      (isAnalyticallyUnramified_of_localization_maximalIdeal
        (H (ULift.{v} (Shrink.{u} S)) (maximalIdeal _)))
  tfae_have 3 → 1 := by
    intro H
    refine isNagataRing_of_finite_local_domains fun S _ _ _ _ _ _ ↦ ?_
    let e : ULift.{w} S ≃ₐ[R] S := ULift.algEquiv
    have : IsDomain (ULift.{w} S) := Function.Injective.isDomain e e.injective
    have : IsLocalRing (ULift.{w} S) := e.symm.toRingEquiv.isLocalRing
    have := Module.Finite.equiv e.symm.toLinearEquiv
    have : IsLocalHom (algebraMap R (ULift.{w} S)) := isLocalHom_of_finite
    exact IsAnalyticallyUnramified.of_ringEquiv e.symm.toRingEquiv (H (ULift.{w} S))
  tfae_finish
