@[expose] public section

universe u

namespace Stacks.Nagata.FiniteTypeTFAE

/-- If `S` is generated over `R` by `x`, a subalgebra of an `S`-algebra `F` containing the image
of `x` contains the image of `S`. -/
private theorem algebraMap_mem_of_adjoin_singleton_eq_top {R S F : Type u} [CommRing R]
    [CommRing S] [CommRing F] [Algebra R S] [Algebra S F] [Algebra R F] [IsScalarTower R S F]
    (x : S) (hx : Algebra.adjoin R ({x} : Set S) = ⊤) (T : Subalgebra R F)
    (hxT : algebraMap S F x ∈ T) (s : S) : algebraMap S F s ∈ T := by
  have hs : s ∈ Algebra.adjoin R ({x} : Set S) := by rw [hx]; exact Algebra.mem_top
  induction hs using Algebra.adjoin_induction with
  | mem z hz => obtain rfl := Set.mem_singleton_iff.1 hz; exact hxT
  | algebraMap r => rw [← IsScalarTower.algebraMap_apply R S F]; exact T.algebraMap_mem r
  | add a b _ _ ha hb => simpa only [map_add] using add_mem ha hb
  | mul a b _ _ ha hb => simpa only [map_mul] using mul_mem ha hb

/-- If the domain `S` is generated over the domain `R` by a single element algebraic over `R`,
then a fraction field of `S` is a finite extension of a fraction field of `R`. -/
private theorem finiteDimensional_of_adjoin_singleton {R S : Type u} [CommRing R]
    [CommRing S] [Algebra R S] (x : S) (hx : Algebra.adjoin R ({x} : Set S) = ⊤)
    {f : Polynomial R} (hf0 : f ≠ 0) (hfx : Polynomial.aeval x f = 0)
    (K F : Type u) [Field K] [Field F] [Algebra R K] [IsFractionRing R K] [Algebra S F]
    [IsFractionRing S F] [Algebra R F] [IsScalarTower R S F] [Algebra K F]
    [IsScalarTower R K F] : FiniteDimensional K F := by
  have hInt : IsIntegral K (algebraMap S F x) := by
    have hmap : f.map (algebraMap R K) ≠ 0 :=
      (Polynomial.map_ne_zero_iff (IsFractionRing.injective R K)).2 hf0
    have haev : Polynomial.aeval (algebraMap S F x) (f.map (algebraMap R K)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap, Polynomial.aeval_algebraMap_apply, hfx, map_zero]
    exact isAlgebraic_iff_isIntegral.mp ⟨_, hmap, haev⟩
  have hmemS : ∀ s : S, algebraMap S F s ∈ (IntermediateField.adjoin K {algebraMap S F x}) :=
    algebraMap_mem_of_adjoin_singleton_eq_top x hx
      ((IntermediateField.adjoin K {algebraMap S F x}).toSubalgebra.restrictScalars R)
      (IntermediateField.mem_adjoin_simple_self K _)
  have htop : (IntermediateField.adjoin K {algebraMap S F x}) = ⊤ := by
    refine eq_top_iff.2 fun z _ => ?_
    obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.mk'_surjective (nonZeroDivisors S) z
    rw [← hrs]
    change IsLocalization.mk' F r s ∈ _
    rw [IsFractionRing.mk'_eq_div]
    exact div_mem (hmemS r) (hmemS ↑s)
  have hfd : FiniteDimensional K (⊤ : IntermediateField K F) := by
    rw [← htop]
    exact IntermediateField.adjoin.finiteDimensional hInt
  exact Module.Finite.equiv (IntermediateField.topEquiv (F := K) (E := F)).toLinearEquiv

/-- **The source's (\*\*\*), the content of the source's Step 5.** Let `A` be a normal Nagata
domain with fraction field `K` and let `y ∈ K`. Then the subring `A[y] ⊆ K` generated by `A` and
`y` is N-1: the integral closure of `A[y]` in `K` is a finite `A[y]`-module.

`K` is a fraction field of `A[y]` too, so this is the N-1 condition of Definition 032F(1) for
`A[y]`, read on the fraction field `K` rather than on `FractionRing (A[y])`.

The source's route, for `y = b/a`: `A[y]_a = A_a` is normal, so Tag 0333 reduces the claim to N-1
for `A[y]_𝔪` at every maximal ideal `𝔪` of `A[y]`. There one passes to a finite extension of `K`
splitting a monic `f ∈ A[X]` with `f(y) ∈ 𝔪`, whose integral closure over `A` is finite over `A`
and again Nagata (Tag 032T), so that Tags 032K and 0333 reduce further to the case `y ∈ 𝔪`. Then
`A[y] ⧸ y A[y] = A ⧸ (yA ∩ A)` and Tag 031T says that this quotient has no embedded primes and
that its associated primes have height one, which is what Tag 0330 consumes to make `A[y]_𝔪`
analytically unramified, hence N-1 by Tag 032Y. All of that is carried out in
`MonogenicN1.module_finite_integralClosure`, for an abstract carrier of the subring `A[y] ⊆ K`;
this is its instance at the subalgebra itself. -/
private theorem module_finite_integralClosure_adjoin_singleton
    (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (hA : IsNagataRing A)
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (y : K) :
    Module.Finite (Algebra.adjoin A ({y} : Set K))
      (integralClosure (Algebra.adjoin A ({y} : Set K)) K) :=
  MonogenicN1.module_finite_integralClosure (A := A) (K := K) hA Subtype.coe_injective
    ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ (MonogenicN1.adjoin_singleton_top y)

/-- **The source's (\*\*\*) for an abstract realisation of `A[y]`.** Let `A` be a normal Nagata
domain with fraction field `K`, let `y ∈ K`, and let `B` be a ring realising the subring
`A[y] ⊆ K` — that is, the structure map `B → K` is injective with image `A[y]`. Then `B` is N-1:
the integral closure of `B` in `K` is a finite `B`-module.

Only the image of `B` in `K` matters here, so this is
`module_finite_integralClosure_adjoin_singleton` transported along the isomorphism `B ≅ A[y]`: an
element of `K` is integral over `B` if and only if it is integral over `A[y]`, and a `B`-submodule
of `K` is an `A[y]`-submodule and conversely, so a finite `A[y]`-generating set of the integral
closure generates it over `B` as well (Stacks 0308, in the form `isN1_of_le_fg`). -/
private theorem module_finite_integralClosure_of_range_eq_adjoin
    (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (hA : IsNagataRing A)
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    (B : Type u) [CommRing B] [Algebra B K] (y : K)
    (hinjB : Function.Injective (algebraMap B K))
    (hB : Set.range (algebraMap B K) = (Algebra.adjoin A ({y} : Set K) : Set K)) :
    Module.Finite B (integralClosure B K) := by
  have hnA : IsNoetherianRing A := hA.1
  set C := Algebra.adjoin A ({y} : Set K) with hC
  have hmem : ∀ b : B, algebraMap B K b ∈ C := fun b => by
    rw [← SetLike.mem_coe, ← hB]
    exact ⟨b, rfl⟩
  let φ : B →+* C := (algebraMap B K).codRestrict C hmem
  have hφinj : Function.Injective φ := fun a b h => hinjB (congrArg Subtype.val h)
  have hφsurj : Function.Surjective φ := by
    intro z
    obtain ⟨b, hb⟩ : (z : K) ∈ Set.range (algebraMap B K) := by rw [hB]; exact z.2
    exact ⟨b, Subtype.ext hb⟩
  have hcomp : (algebraMap C K).comp φ = algebraMap B K := rfl
  have hnC : IsNoetherianRing C := isNoetherianRing_of_fg (S := C) ⟨{y}, by simp [hC]⟩
  have hnB : IsNoetherianRing B :=
    isNoetherianRing_of_ringEquiv C (RingEquiv.ofBijective φ ⟨hφinj, hφsurj⟩).symm
  -- A finite `C`-generating set of the integral closure of `C = A[y]` in `K`.
  obtain ⟨s, hs⟩ : (Subalgebra.toSubmodule (integralClosure C K)).FG :=
    Module.Finite.iff_fg.1 (module_finite_integralClosure_adjoin_singleton A hA K y)
  refine isN1_of_le_fg (Submodule.span B (s : Set K)) (Submodule.fg_span s.finite_toSet) ?_
  intro z hz
  obtain ⟨q, hqm, hq⟩ : IsIntegral B z := hz
  -- Integrality over `B` and over `C` agree: the two rings have the same image in `K`.
  have hzspan : z ∈ Submodule.span C (s : Set K) := by
    rw [hs]
    exact (⟨q.map φ, hqm.map φ, by rw [Polynomial.eval₂_map, hcomp, hq]⟩ : IsIntegral C z)
  clear hq hs
  -- A `C`-linear combination is a `B`-linear combination, `B` and `C` having the same image.
  induction hzspan using Submodule.span_induction with
  | mem w hw => exact Submodule.subset_span hw
  | zero => exact zero_mem _
  | add u v _ _ hu hv => exact add_mem hu hv
  | smul c u _ hu =>
      obtain ⟨b, rfl⟩ := hφsurj c
      have hcu : (φ b) • u = b • u := by
        simp only [Algebra.smul_def]
        rfl
      rw [hcu]
      exact Submodule.smul_mem _ _ hu

/-- **The source's Step 4.** Let `R ⊆ S` be a monogenic extension of domains inside a field `L`,
and let `A ⊆ L` be a normal Nagata `R`-subalgebra, module-finite over `R`, with `L` as its
fraction field. Then the integral closure of `S` in `L` is a finite `S`-module.

The integral closure of `S` in `L` is the integral closure of `A[x] = S[A]` in `L`, and `A[x]` is
module-finite over `S` because `A` is module-finite over `R`; so the source's (\*\*\*) applied to
the normal Nagata domain `A` and the element `x` of its fraction field finishes it. -/
private theorem module_finite_integralClosure_of_module_finite_subalgebra
    {R S L : Type u} [CommRing R] [CommRing S] [Field L]
    [Algebra R S] [Algebra S L] [Algebra R L] [IsScalarTower R S L]
    (x : S) (hx : Algebra.adjoin R ({x} : Set S) = ⊤)
    (A : Subalgebra R L) [Module.Finite R A] [IsIntegrallyClosed A] [IsFractionRing A L]
    (hA : IsNagataRing A) :
    Module.Finite S (integralClosure S L) := by
  obtain ⟨e, he⟩ := Module.Finite.fg_top (R := R) (M := A)
  -- Every element of `A` lies in the `S`-subalgebra of `L` generated by the module generators
  -- `e` of `A` over `R`.
  have hAsub : ∀ a : A, (a : L) ∈ Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A)) := by
    intro a
    have ha : a ∈ Submodule.span R (e : Set A) := by rw [he]; trivial
    induction ha using Submodule.span_induction with
    | mem w hw => exact Algebra.subset_adjoin ⟨w, hw, rfl⟩
    | zero => simp
    | add u v _ _ hu hv =>
        have h : ((u + v : A) : L) = (u : L) + (v : L) := by push_cast; ring
        rw [h]; exact add_mem hu hv
    | smul r u _ hu =>
        have h : ((r • u : A) : L) = algebraMap S L (algebraMap R S r) * (u : L) := by
          rw [← IsScalarTower.algebraMap_apply R S L, ← Algebra.smul_def]; rfl
        rw [h]; exact mul_mem (Subalgebra.algebraMap_mem _ _) hu
  -- Every element of `S` lies in the `A`-subalgebra of `L` generated by `x`.
  have hmemT : ∀ s : S, algebraMap S L s ∈ Algebra.adjoin A ({algebraMap S L x} : Set L) :=
    algebraMap_mem_of_adjoin_singleton_eq_top x hx
      ((Algebra.adjoin A ({algebraMap S L x} : Set L)).restrictScalars R)
      (Algebra.self_mem_adjoin_singleton A _)
  -- The two descriptions `S[e]` and `A[x]` of the source's `S'` agree.
  have hset : (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A)) : Set L)
      = (Algebra.adjoin A ({algebraMap S L x} : Set L) : Set L) := by
    refine Set.Subset.antisymm (fun z hz => ?_) (fun z hz => ?_)
    · induction hz using Algebra.adjoin_induction with
      | mem w hw =>
          obtain ⟨a, _, rfl⟩ := hw
          exact Subalgebra.algebraMap_mem _ a
      | algebraMap s => exact hmemT s
      | add a b _ _ ha hb => exact add_mem ha hb
      | mul a b _ _ ha hb => exact mul_mem ha hb
    · induction hz using Algebra.adjoin_induction with
      | mem w hw =>
          obtain rfl := Set.mem_singleton_iff.1 hw
          exact Subalgebra.algebraMap_mem _ x
      | algebraMap a => exact hAsub a
      | add a b _ _ ha hb => exact add_mem ha hb
      | mul a b _ _ ha hb => exact mul_mem ha hb
  -- `S' = S[e]` is module-finite over `S`, its elements being integral over `R`.
  have hgint : ∀ z ∈ (Subalgebra.val A) '' (e : Set A), IsIntegral S z := by
    rintro z ⟨a, _, rfl⟩
    exact ((Algebra.IsIntegral.of_finite R A).isIntegral a).map (Subalgebra.val A) |>.tower_top
  have hfinST : Module.Finite S (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral (e.finite_toSet.image _) hgint
  -- The source's (***) applied to `A` and `x`.
  have hfinT : Module.Finite (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A)))
      (integralClosure (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) L) := by
    refine module_finite_integralClosure_of_range_eq_adjoin A hA L _ (algebraMap S L x)
      Subtype.coe_injective ?_
    rw [← hset]
    exact Subtype.range_coe
  -- The integral closure of `S'` in `L` is the integral closure of `S` in `L`.
  have : Algebra.IsIntegral S (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) :=
    Algebra.IsIntegral.of_finite S _
  have : Algebra.IsIntegral S
      (integralClosure (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) L) :=
    Algebra.IsIntegral.trans (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A)))
  have : IsIntegralClosure
      (integralClosure (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) L) S L :=
    IsIntegralClosure.of_isIntegrallyClosedIn
  have : Module.Finite S
      (integralClosure (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) L) :=
    Module.Finite.trans (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) _
  exact Module.Finite.equiv (IsIntegralClosure.equiv S (integralClosure S L) L
    (integralClosure (Algebra.adjoin S ((Subalgebra.val A) '' (e : Set A))) L)).symm.toLinearEquiv

/-- **The source's (\*\*).** A monogenic extension `R ⊆ S` of domains with `R` a Nagata domain
and the generator algebraic over `R` has `S` N-2. This is the source's Steps 4 and 5. -/
private theorem isJapaneseRing_of_monogenic_algebraic (R S : Type u) [CommRing R] [IsDomain R]
    [CommRing S] [IsDomain S] [Algebra R S] (hinj : Function.Injective (algebraMap R S))
    (hR : IsNagataRing R) (x : S) (hx : Algebra.adjoin R ({x} : Set S) = ⊤)
    (halg : ∃ f : Polynomial R, f ≠ 0 ∧ Polynomial.aeval x f = 0) :
    IsJapaneseRing S := by
  obtain ⟨f, hf0, hfx⟩ := halg
  have hJapR : IsJapaneseRing R := MonogenicN1.isJapaneseRing_of_isNagataRing hR
  refine { finite := fun L _ _ _ _ _ => ?_ }
  -- The towers `R → S → L` and `R → S → Frac S`.
  let : Algebra R L := ((algebraMap S L).comp (algebraMap R S)).toAlgebra
  have : IsScalarTower R S L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower R (FractionRing S) L :=
    IsScalarTower.of_algebraMap_eq fun r => by
      rw [IsScalarTower.algebraMap_apply R S L, IsScalarTower.algebraMap_apply R S (FractionRing S),
        ← IsScalarTower.algebraMap_apply S (FractionRing S) L]
  have hinjSL : Function.Injective (algebraMap S L) := by
    rw [IsScalarTower.algebraMap_eq S (FractionRing S) L]
    exact (algebraMap (FractionRing S) L).injective.comp (IsFractionRing.injective S _)
  have hinjRL : Function.Injective (algebraMap R L) := by
    rw [IsScalarTower.algebraMap_eq R S L]
    exact hinjSL.comp hinj
  have hinjRF : Function.Injective (algebraMap R (FractionRing S)) := by
    rw [IsScalarTower.algebraMap_eq R S (FractionRing S)]
    exact (IsFractionRing.injective S (FractionRing S)).comp hinj
  -- `L` and `Frac S` as extensions of `Frac R`; `Frac S / Frac R` is finite because `x` is
  -- algebraic over `R`, so `L / Frac R` is finite.
  let : Algebra (FractionRing R) L := (IsFractionRing.lift hinjRL).toAlgebra
  have : IsScalarTower R (FractionRing R) L :=
    IsScalarTower.of_algebraMap_eq fun r => (IsFractionRing.lift_algebraMap hinjRL r).symm
  let : Algebra (FractionRing R) (FractionRing S) := (IsFractionRing.lift hinjRF).toAlgebra
  have : IsScalarTower R (FractionRing R) (FractionRing S) :=
    IsScalarTower.of_algebraMap_eq fun r => (IsFractionRing.lift_algebraMap hinjRF r).symm
  have : IsScalarTower (FractionRing R) (FractionRing S) L := by
    refine IsScalarTower.of_algebraMap_eq fun k => ?_
    have hEq : (algebraMap (FractionRing R) L)
        = (algebraMap (FractionRing S) L).comp
            (algebraMap (FractionRing R) (FractionRing S)) := by
      refine IsLocalization.ringHom_ext (nonZeroDivisors R) (RingHom.ext fun r => ?_)
      simp only [RingHom.coe_comp, Function.comp_apply]
      rw [← IsScalarTower.algebraMap_apply R (FractionRing R) L r,
        ← IsScalarTower.algebraMap_apply R (FractionRing R) (FractionRing S) r,
        ← IsScalarTower.algebraMap_apply R (FractionRing S) L r]
    exact DFunLike.congr_fun hEq k
  have : FiniteDimensional (FractionRing R) (FractionRing S) :=
    finiteDimensional_of_adjoin_singleton x hx hf0 hfx (FractionRing R) (FractionRing S)
  have : FiniteDimensional (FractionRing R) L := Module.Finite.trans (FractionRing S) L
  -- `A`, the integral closure of `R` in `L`: module-finite over `R` because `R` is N-2, Nagata
  -- by Tag 032T, normal, and with `L` as its fraction field.
  have : Module.Finite R (integralClosure R L) := hJapR.finite L
  have : Algebra.FiniteType R (integralClosure R L) := Module.Finite.finiteType _
  have : IsIntegralClosure (integralClosure R L) R L := integralClosure.isIntegralClosure R L
  have : IsFractionRing (integralClosure R L) L :=
    IsIntegralClosure.isFractionRing_of_finite_extension R (FractionRing R) L _
  have : IsIntegrallyClosed (integralClosure R L) :=
    integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing R)
  exact module_finite_integralClosure_of_module_finite_subalgebra x hx (integralClosure R L)
    (isNagataRing_of_quasiFinite hR)


/-- **The source's (\*).** A monogenic extension `R ⊆ S` of domains with `R` a Nagata domain
has `S` N-2. This is the content of the source's Steps 3 to 5: the source's Step 3, the split on
whether the generator is transcendental over `R`, is carried out here, and the transcendental case
is Tag 032O applied to the isomorphism `R[X] ≅ S`. -/
private theorem isJapaneseRing_of_monogenic (R S : Type u) [CommRing R] [IsDomain R]
    [CommRing S] [IsDomain S] [Algebra R S] (hinj : Function.Injective (algebraMap R S))
    (hR : IsNagataRing R) (x : S) (hx : Algebra.adjoin R ({x} : Set S) = ⊤) :
    IsJapaneseRing S := by
  by_cases halg : ∃ f : Polynomial R, f ≠ 0 ∧ Polynomial.aeval x f = 0
  · exact isJapaneseRing_of_monogenic_algebraic R S hinj hR x hx halg
  -- The generator is transcendental over `R`, so `R[X] → S` is an isomorphism and Tag 032O
  -- applies.
  have hsurj : Function.Surjective (Polynomial.aeval x : Polynomial R →ₐ[R] S) := by
    rwa [← AlgHom.range_eq_top, ← Algebra.adjoin_singleton_eq_range_aeval R x]
  have hinj' : Function.Injective (Polynomial.aeval x : Polynomial R →ₐ[R] S) := by
    intro f g hfg
    by_contra hne
    exact halg ⟨f - g, sub_ne_zero.2 hne, by rw [map_sub, hfg, sub_self]⟩
  exact IsJapaneseRing.of_ringEquiv
    (RingEquiv.ofBijective (Polynomial.aeval x : Polynomial R →ₐ[R] S).toRingHom ⟨hinj', hsurj⟩)
    ((Polynomial.isN1_and_isJapaneseRing R).2 hR.1 (MonogenicN1.isJapaneseRing_of_isNagataRing hR))

/-- The Nagata condition passes from `R` to the polynomial ring `R[X]`. -/
private theorem isNagataRing_polynomial (R : Type u) [CommRing R] (hR : IsNagataRing R) :
    IsNagataRing (Polynomial R) := by
  have : IsNoetherianRing R := hR.1
  refine ⟨inferInstance, fun q hq => ?_⟩
  have hpp : (q.comap (Polynomial.C : R →+* Polynomial R)).IsPrime := Ideal.comap_isPrime _ q
  let A := R ⧸ q.comap (Polynomial.C : R →+* Polynomial R)
  let B := Polynomial R ⧸ q
  let alg : Algebra A B :=
    (Ideal.quotientMap q (Polynomial.C : R →+* Polynomial R) le_rfl).toAlgebra
  have hinj : Function.Injective (algebraMap A B) := Ideal.quotientMap_injective
  have halg : ∀ a : R, algebraMap A B (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk q
      (Polynomial.C a) := fun _ => Ideal.quotientMap_mk
  set x : B := Ideal.Quotient.mk q Polynomial.X with hxdef
  have key : ∀ f : Polynomial R, (Ideal.Quotient.mk q f : B) ∈ Algebra.adjoin A ({x} : Set B) := by
    intro f
    induction f using Polynomial.induction_on' with
    | add f g hf hg => simpa only [map_add] using add_mem hf hg
    | monomial n a =>
        have hmono : (Ideal.Quotient.mk q (Polynomial.monomial n a) : B)
            = algebraMap A B (Ideal.Quotient.mk _ a) * x ^ n := by
          rw [halg, hxdef, ← map_pow, ← map_mul, Polynomial.C_mul_X_pow_eq_monomial]
        rw [hmono]
        exact mul_mem (Subalgebra.algebraMap_mem _ _)
          (pow_mem (Algebra.self_mem_adjoin_singleton A x) n)
  refine isJapaneseRing_of_monogenic A B hinj (MonogenicN1.isNagataRing_quotient hR _) x
    (eq_top_iff.2 fun y _ => ?_)
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact key f

/-- The Nagata condition passes from `R` to a polynomial ring in finitely many variables. -/
private theorem isNagataRing_mvPolynomial (R : Type u) [CommRing R] (hR : IsNagataRing R) :
    ∀ n : ℕ, IsNagataRing (MvPolynomial (Fin n) R)
  | 0 => MonogenicN1.isNagataRing_of_ringEquiv
      (MvPolynomial.isEmptyAlgEquiv R (Fin 0)).symm.toRingEquiv hR
  | n + 1 => MonogenicN1.isNagataRing_of_ringEquiv (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv
      (isNagataRing_polynomial _ (isNagataRing_mvPolynomial R hR n))

/-- **Nagata's theorem, the substantial implication.** An algebra of finite type over a Nagata
ring is a Nagata ring. -/
private theorem isNagataRing_of_finiteType (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    [Algebra.FiniteType R S] (hR : IsNagataRing R) : IsNagataRing S := by
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  exact MonogenicN1.isNagataRing_of_ringEquiv
    (RingHom.quotientKerEquivOfSurjective (f := (f : MvPolynomial (Fin n) R →+* S)) hf)
    (MonogenicN1.isNagataRing_quotient (isNagataRing_mvPolynomial R hR n) _)

/-- The proof of `isNagataRing_tfae`: a ring is Nagata, has every finite type algebra Nagata,
or is universally Japanese and Noetherian, all three or none. -/
public theorem solution {R : Type u} [CommRing R] :
    List.TFAE
      [ IsNagataRing R,
        ∀ (S : Type u) [CommRing S] [Algebra R S] [Algebra.FiniteType R S], IsNagataRing S,
        IsUniversallyJapaneseRing R ∧ IsNoetherianRing R ] := by
  tfae_have 1 → 2 := fun hR S _ _ _ => isNagataRing_of_finiteType R S hR
  tfae_have 2 → 1 := fun h => h R
  tfae_have 2 → 3 := fun h => by
    refine ⟨{ japanese := fun S _ _ _ _ => ?_ }, (h R).1⟩
    have : (⊥ : Ideal S).IsPrime := Ideal.isPrime_bot
    exact IsJapaneseRing.of_ringEquiv (RingEquiv.quotientBot S) ((h S).2 ⊥)
  tfae_have 3 → 2 := fun ⟨hUJ, hN⟩ S _ _ _ => by
    have : IsNoetherianRing R := hN
    refine ⟨Algebra.FiniteType.isNoetherianRing R S, fun q hq => ?_⟩
    have : Algebra.FiniteType R (S ⧸ q) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R q) Ideal.Quotient.mk_surjective
    exact hUJ.japanese (S ⧸ q)
  tfae_finish

end Stacks.Nagata.FiniteTypeTFAE

/-- **Nagata's theorem.** For a ring `R` the following are equivalent: `R` is a Nagata ring;
every finite-type `R`-algebra is a Nagata ring; `R` is universally Japanese and Noetherian.

In particular an algebra of finite type over a Nagata ring is a Nagata ring. Nagata is
`IsNagataRing` and universally Japanese is `IsUniversallyJapaneseRing`, the two conditions of
Definition 032R. -/
@[stacks 0334 "Items (1)-(3) as a `List.TFAE`. Nagata is `IsNagataRing` (032R(2)) and \
  universally Japanese is `IsUniversallyJapaneseRing` (032R(1)); item (2), the condition the \
  source's proof calls universally Nagata, is stated as the quantification over finite-type \
  `R`-algebras rather than through a predicate of its own. See the module docstring.",
  ega "IV 7.7.2" "a) <=> b)", ega "IV 10.4.10" "more general"]
public theorem isNagataRing_tfae {R : Type u} [CommRing R] :
    List.TFAE
      [ IsNagataRing R,
        ∀ (S : Type u) [CommRing S] [Algebra R S] [Algebra.FiniteType R S], IsNagataRing S,
        IsUniversallyJapaneseRing R ∧ IsNoetherianRing R ] :=
  Stacks.Nagata.FiniteTypeTFAE.solution

end
