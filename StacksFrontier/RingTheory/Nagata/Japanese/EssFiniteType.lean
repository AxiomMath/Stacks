-- Auxiliary lemmas (decomposition of the main statement)

/-- **Bridge lemma.** The Stacks-style predicate `IsEssentiallyOfFiniteType R A
(algebraMap R A)` (there exist a finite-type intermediate `R`-algebra `T`, a
scalar tower `R → T → A`, and a multiplicative set `M` with `A` a localization
of `T` at `M`) implies the Mathlib typeclass `Algebra.EssFiniteType R A`.

Mathematically these are the same notion (Tag 00QM): being a localization of a
finite-type algebra. The Mathlib class `Algebra.EssFiniteType` is phrased via a
finite generating set `s` with `A` a localization of `Algebra.adjoin R s`; the
Stacks predicate is phrased via an arbitrary finite-type intermediate `T`. The
two are equivalent because (i) any finite-type `R`-algebra `T` is itself a
quotient of, hence generated by, finitely many elements, so `T = Algebra.adjoin R s'`
for a finite `s'`, and (ii) a localization of `T` is then a localization of
`Algebra.adjoin R s'`. Conversely `Algebra.adjoin R s` is finite type. Thus the
existential data of `IsEssentiallyOfFiniteType` can be massaged into the
`Algebra.EssFiniteType.cond` form.

PROOF STRATEGY:
`obtain ⟨T, _, _, hFT, M, _, hTower, hLoc⟩ := hA` to get `T`, `Algebra.FiniteType R T`,
`M`, `IsScalarTower R T A`, `IsLocalization M A`. Then
  `haveI : Algebra.EssFiniteType R T := Algebra.EssFiniteType.of_finiteType R T`
  `haveI : Algebra.EssFiniteType T A := Algebra.EssFiniteType.of_isLocalization A M`
  `exact Algebra.EssFiniteType.comp R T A`.
WRINKLE found while probing: the `Algebra R A` instance recorded inside `hA`/`hTower`
is `(algebraMap R A).toAlgebra`, which is only *defeq* (not syntactically equal) to
the ambient `inst : Algebra R A`; `comp` then reports an `IsScalarTower` instance
mismatch on that algebra structure. Resolve by reconciling the two `Algebra R A`
instances — e.g. `Subsingleton.elim`/`Algebra.algebra_ext`, or by rebuilding the
scalar tower against the ambient instance via `IsScalarTower.of_algebraMap_eq`,
before invoking `comp`. (`of_finiteType`, `of_isLocalization`, `comp` all confirmed
to exist with the needed signatures.) -/
theorem essFiniteType_of_isEssentiallyOfFiniteType (R : Type u) [CommRing R] (A : Type u)
    [CommRing A] [Algebra R A] (hA : IsEssentiallyOfFiniteType R A (algebraMap R A)) :
    Algebra.EssFiniteType R A := by
  rcases hA with ⟨T, instRT, instTA, hFT, M, hMmap, hTower, hLoc⟩
  let := instRT
  let := instTA
  let := hMmap
  have := hFT
  have := hLoc
  have : IsScalarTower R T A := by
    refine IsScalarTower.of_algebraMap_eq (fun r => ?_)
    have h :=
      @IsScalarTower.algebraMap_apply R T A _ _ _ _ _ (RingHom.toAlgebra (algebraMap R A)) hTower r
    rwa [RingHom.algebraMap_toAlgebra] at h
  have : Algebra.EssFiniteType R T := Algebra.EssFiniteType.of_finiteType R T
  have : Algebra.EssFiniteType T A := Algebra.EssFiniteType.of_isLocalization A M
  exact Algebra.EssFiniteType.comp R T A

/-- A submonoid inside the nonzerodivisors has nonzero image under an injective algebra map. -/
private theorem algebraMap_ne_zero_of_le_nonZeroDivisors {S₀ L : Type u} [CommRing S₀]
    [IsDomain S₀] [Semiring L] [Algebra S₀ L] {M : Submonoid S₀} (hM : M ≤ nonZeroDivisors S₀)
    (hinj : Function.Injective (algebraMap S₀ L)) {m : S₀} (hm : m ∈ M) :
    algebraMap S₀ L m ≠ 0 :=
  (map_ne_zero_iff _ hinj).2 (mem_nonZeroDivisors_iff_ne_zero.mp (hM hm))

/-- **Localization of a domain shares its fraction field.** If `S₀` is a domain,
`S` is a localization of `S₀` at a multiplicative set `M ≤ nonZeroDivisors S₀`,
and `FracS` is a fraction field of `S`, then `FracS` is also a fraction field of
`S₀`. -/
@[ega "0 7.6.10" "special case"]
theorem isFractionRing_of_localization_aux (S₀ S FracS : Type u) [CommRing S₀] [CommRing S]
    [Field FracS] [IsDomain S₀] [IsDomain S] [Algebra S₀ S] [Algebra S₀ FracS] [Algebra S FracS]
    [IsScalarTower S₀ S FracS] (M : Submonoid S₀) [IsLocalization M S] [IsFractionRing S FracS]
    (hMnz : M ≤ nonZeroDivisors S₀) (hinj : Function.Injective (algebraMap S₀ FracS)) :
    IsFractionRing S₀ FracS := by
  have : FaithfulSMul S₀ FracS := (faithfulSMul_iff_algebraMap_injective S₀ FracS).mpr hinj
  apply IsFractionRing.of_field
  intro z
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors S) z
  simp only at hab
  obtain ⟨⟨a₀, m⟩, ha⟩ := IsLocalization.surj M a
  obtain ⟨⟨b₀, n⟩, hb⟩ := IsLocalization.surj M (b : S)
  simp only at ha hb
  refine ⟨a₀ * n, b₀ * m, ?_⟩
  have key : ∀ x : S₀, algebraMap S₀ FracS x = algebraMap S FracS (algebraMap S₀ S x) := fun x =>
    (IsScalarTower.algebraMap_apply S₀ S FracS x)
  have hb0 : algebraMap S FracS (b : S) ≠ 0 := by
    rw [ne_eq, IsFractionRing.to_map_eq_zero_iff]; exact nonZeroDivisors.coe_ne_zero b
  have hm0 := algebraMap_ne_zero_of_le_nonZeroDivisors hMnz hinj m.property
  have hn0 := algebraMap_ne_zero_of_le_nonZeroDivisors hMnz hinj n.property
  have clear : ∀ (x : S) (c x₀ : S₀), x * algebraMap S₀ S c = algebraMap S₀ S x₀ →
      algebraMap S FracS x * algebraMap S₀ FracS c = algebraMap S₀ FracS x₀ := fun x c x₀ h => by
    rw [key x₀, key c, ← map_mul, h]
  have ha' := clear _ _ _ ha
  have hb' := clear _ _ _ hb
  have hb0' : algebraMap S₀ FracS b₀ ≠ 0 := by
    rw [← hb']; exact mul_ne_zero hb0 hn0
  rw [eq_div_iff
      (by
        rw [map_mul]; exact mul_ne_zero hb0' hm0)]
  rw [map_mul, map_mul]
  linear_combination
    (-(z * algebraMap S₀ FracS (m : S₀))) * hb' +
      (algebraMap S₀ FracS (m : S₀) * algebraMap S₀ FracS (n : S₀)) * hab +
      (algebraMap S₀ FracS (n : S₀)) * ha'

/- **Core lemma (the crux: Stacks Tags 032S core / 032G).** If `R` is
universally Japanese and `S` is a *domain* essentially of finite type over `R`,
then `S` is N-2 (Japanese).

This is the heart of Tag 032S. The reduction in the main theorem turns the goal
into exactly this statement (for `S` the given finite-type `A`-algebra domain,
which is essentially of finite type over `R` via the scalar tower).

Argument (Tags 032S and 032G):
Since `S` is essentially of finite type over `R`, write `S = M⁻¹ S₀` where
`S₀ = Algebra.adjoin R s` (a finite generating set `s`) is a *finite-type*
`R`-algebra and `M ⊆ S₀` is a multiplicative set with `S` the localization
`IsLocalization M S`. Because `S` is a domain and `S₀ → S` is a localization,
`S₀` is itself a domain (it embeds into the domain `S`: the localization map is
injective when `M ⊆ nonZeroDivisors`, which holds here since `S` is a domain and
`0 ∉ M`, or one passes to the domain `S₀ / ker`). As a finite-type `R`-algebra
domain, `S₀` is N-2 by `hR` (`R` universally Japanese, Definition 032R).

Now N-2 is preserved under localization of domains (Tag 032G): given a finite
field extension `L / Frac(S)`, note `Frac(S) = Frac(S₀)` (localizations of a
domain share the same fraction field), so `L` is also a finite extension of
`Frac(S₀)`. The integral closure of `S` in `L` equals the localization at `M`
of the integral closure of `S₀` in `L` — this is precisely Tag 0307,
`IsLocalization.integralClosure` (the integral closure commutes with
localization). Since `S₀` is N-2, the integral closure of `S₀` in `L` is a
finite `S₀`-module; localizing, the integral closure of `S` in `L` is a finite
`S`-module. Hence `S` is N-2.

PROOF STRATEGY:
1. From `Algebra.EssFiniteType R S` extract `s` and the localization data; set
   `S₀ := Algebra.adjoin R s`, with `Algebra.FiniteType R S₀` and the
   localization `IsLocalization (Submonoid.comap …) S`.
2. Show `IsDomain S₀` (subalgebra of the domain `S`, or via injectivity of the
   localization map: `IsLocalization.injective` with `M ≤ nonZeroDivisors`).
3. Get `IsN2_032s S₀` from `hR S₀`.
4. Transport N-2 from `S₀` to its localization `S` using
   `IsLocalization.integralClosure` (Tag 0307), matching fraction fields
   (`IsFractionRing`/`FractionRing` of `S` and `S₀` agree) and using that
   localization of a finite module is finite (`IsLocalization`/
   `Module.Finite` base change). This localization-preservation step (Tag 032G)
   is the natural sub-lemma to isolate. -/
/-- **Applying N-2 with an arbitrary fraction field.** If `S₀` is N-2 and `K` is
*any* fraction field of `S₀` (`IsFractionRing S₀ K`), then for every finite
field extension `L / K` the integral closure of `S₀` in `L` is a finite
`S₀`-module.

This generalizes the definition `IsN2_032s S₀` (which is phrased with the specific
fraction field `FractionRing S₀`) to an arbitrary fraction field, by transporting
the data along the canonical algebra isomorphism `FractionRing S₀ ≃ₐ[S₀] K`. -/
lemma isN2_apply_of_isFractionRing (S₀ : Type u) [CommRing S₀] [IsDomain S₀] (h : IsN2_032s S₀)
    (K : Type u) [Field K] [Algebra S₀ K] [IsFractionRing S₀ K] (L : Type u) [Field L]
    [Algebra S₀ L] [Algebra K L] [IsScalarTower S₀ K L] [FiniteDimensional K L] :
    Module.Finite S₀ (integralClosure S₀ L) := by
  let e : FractionRing S₀ ≃ₐ[S₀] K := FractionRing.algEquiv S₀ K
  -- Algebra (FractionRing S₀) K via e
  let : Algebra (FractionRing S₀) K := e.toRingHom.toAlgebra
  have : IsScalarTower S₀ (FractionRing S₀) K := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    show algebraMap S₀ K x = e (algebraMap S₀ (FractionRing S₀) x)
    rw [AlgEquiv.commutes]
  -- give L an Algebra (FractionRing S₀) structure via e then K → L
  let : Algebra (FractionRing S₀) L := ((algebraMap K L).comp e.toRingHom).toAlgebra
  have : IsScalarTower S₀ (FractionRing S₀) L := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    show algebraMap S₀ L x = (algebraMap K L) (e (algebraMap S₀ (FractionRing S₀) x))
    rw [AlgEquiv.commutes]
    rw [← IsScalarTower.algebraMap_apply S₀ K L]
  have : IsScalarTower (FractionRing S₀) K L := by
    apply IsScalarTower.of_algebraMap_eq
    intro y
    show (algebraMap K L) (e y) = algebraMap K L (algebraMap (FractionRing S₀) K y)
    rfl
  have : Module.Finite (FractionRing S₀) K := by
    have : Function.Surjective (algebraMap (FractionRing S₀) K) := e.surjective
    exact Module.Finite.of_surjective (Algebra.linearMap (FractionRing S₀) K) this
  have : FiniteDimensional (FractionRing S₀) L := Module.Finite.trans K L
  exact h L

/-- **Tag 0307 / 032G: the localization step.** If `S₀` is a domain, `S` is a
localization of `S₀` at a multiplicative set `M ≤ nonZeroDivisors S₀`, `L` is a
field with `algebraMap S₀ L` injective, and the integral closure of `S₀` in `L`
is a finite `S₀`-module, then the integral closure of `S` in `L` is a finite
`S`-module.

This is Tag 0307 (integral closure commutes with localization,
`IsLocalization.integralClosure`) combined with the fact that a localization of a
finite module is finite (`Module.Finite.of_isLocalization`): the integral closure
of `S` in `L` is the localization of the integral closure of `S₀` in `L` at `M`. -/
@[ega "II 6.3.10" "Locality on X", ega "IV 6.13.6" "(i)"]
lemma module_finite_integralClosure_localization (S₀ S L : Type u) [CommRing S₀] [CommRing S]
    [Field L] [IsDomain S₀] [IsDomain S] [Algebra S₀ S] [Algebra S₀ L] [Algebra S L]
    [IsScalarTower S₀ S L] (M : Submonoid S₀) [IsLocalization M S] (hM : M ≤ nonZeroDivisors S₀)
    (hinj : Function.Injective (algebraMap S₀ L))
    (hfin : Module.Finite S₀ (integralClosure S₀ L)) : Module.Finite S (integralClosure S L) := by
  -- L is a localization of L at the images of M (units in the field L)
  have hLloc : IsLocalization (Algebra.algebraMapSubmonoid L M) L := by
    apply IsLocalization.of_le_isUnit
    rintro _ ⟨m, hm, rfl⟩
    rw [IsUnit.mem_submonoid_iff]
    exact isUnit_iff_ne_zero.mpr (algebraMap_ne_zero_of_le_nonZeroDivisors hM hinj hm)
  -- inclusion ring hom integralClosure S₀ L → integralClosure S L
  let incl : (integralClosure S₀ L) →+* (integralClosure S L) :=
    { toFun := fun x => ⟨x.val, IsIntegral.tower_top x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let : Algebra (integralClosure S₀ L) (integralClosure S L) := incl.toAlgebra
  have : IsScalarTower (integralClosure S₀ L) (integralClosure S L) L := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    rfl
  have : IsScalarTower S₀ (integralClosure S₀ L) (integralClosure S L) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    apply Subtype.ext
    rfl
  -- Tag 0307: integral closure commutes with localization
  have :
    IsLocalization (Algebra.algebraMapSubmonoid (integralClosure S₀ L) M) (integralClosure S L) :=
    IsLocalization.integralClosure M
  -- localization of a finite module is finite
  exact Module.Finite.of_isLocalization S₀ (integralClosure S₀ L) M

/-- **The crux (Tag 032G).** N-2 is preserved under localization of a domain: if
`S₀` is N-2 and `S` is a localization of `S₀` at `M ≤ nonZeroDivisors S₀`, then
`S` is N-2.

Given a finite field extension `L / Frac(S)`, we use that `Frac(S)` is also a
fraction field of `S₀` (`isFractionRing_of_localization_aux`), so `L` is a finite
extension of `Frac(S₀)`; thus the integral closure of `S₀` in `L` is finite over
`S₀` by `isN2_apply_of_isFractionRing`. Localizing
(`module_finite_integralClosure_localization`) gives that the integral closure of
`S` in `L` is finite over `S`. -/
theorem isN2_of_isLocalization (S₀ S : Type u) [CommRing S₀] [CommRing S] [IsDomain S₀]
    [IsDomain S] [Algebra S₀ S] (M : Submonoid S₀) [IsLocalization M S]
    (hM : M ≤ nonZeroDivisors S₀) (h : IsN2_032s S₀) : IsN2_032s S := by
  intro L _ _ _ _ _
  let : Algebra S₀ L := ((algebraMap S L).comp (algebraMap S₀ S)).toAlgebra
  have : IsScalarTower S₀ S L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hinjS : Function.Injective (algebraMap S₀ S) := IsLocalization.injective S hM
  have inj : ∀ (T : Type u) [CommRing T] [Algebra S T] [Algebra S₀ T] [IsScalarTower S₀ S T],
      Function.Injective (algebraMap S T) → Function.Injective (algebraMap S₀ T) :=
    fun T _ _ _ _ h => by
      rw [IsScalarTower.algebraMap_eq S₀ S T]
      exact h.comp hinjS
  have hinjSL : Function.Injective (algebraMap S L) := by
    rw [IsScalarTower.algebraMap_eq S (FractionRing S) L]
    exact
      (algebraMap (FractionRing S) L).injective.comp (IsFractionRing.injective S (FractionRing S))
  have hinjFS := inj (FractionRing S) (IsFractionRing.injective S (FractionRing S))
  have : IsFractionRing S₀ (FractionRing S) :=
    isFractionRing_of_localization_aux S₀ S (FractionRing S) M hM hinjFS
  have : IsScalarTower S₀ (FractionRing S) L := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    rw [IsScalarTower.algebraMap_eq S₀ S (FractionRing S)]
    simp only [RingHom.comp_apply]
    rw [← IsScalarTower.algebraMap_apply S (FractionRing S) L]
    rw [← IsScalarTower.algebraMap_apply S₀ S L]
  have hS₀fin : Module.Finite S₀ (integralClosure S₀ L) :=
    isN2_apply_of_isFractionRing S₀ h (FractionRing S) L
  exact module_finite_integralClosure_localization S₀ S L M hM (inj L hinjSL) hS₀fin

/-- If `R` is universally Japanese and `S` is a domain essentially of finite type over `R`,
then `S` is N-2. -/
@[ega "IV 7.7.2" "more general"]
theorem isN2_of_essFiniteType_of_universallyJapanese (R : Type u) [CommRing R] (S : Type u)
    [CommRing S] [IsDomain S] [Algebra R S] [Algebra.EssFiniteType R S]
    (hR : IsUniversallyJapanese R) : IsN2_032s S := by
  -- Extract the finite generating set and the localization data (Tag 00QM).
  obtain ⟨s, hloc⟩ := Algebra.EssFiniteType.cond (R := R) (S := S)
  set S₀ := Algebra.adjoin R (↑s : Set S) with hS₀
  set M := Submonoid.comap (algebraMap S₀ S) (IsUnit.submonoid S) with hM
  -- `S₀` is a domain (a subalgebra of the domain `S`).
  have : IsDomain S₀ := inferInstance
  -- `S₀ = R[s]` is of finite type over `R`.
  have : Algebra.FiniteType R S₀ := by
    constructor
    rw [Subalgebra.fg_top]
    exact Subalgebra.fg_adjoin_finset s
  -- The localizing set lies in the nonzerodivisors of `S₀`.
  have hMnz : M ≤ nonZeroDivisors S₀ := by
    intro x hx
    rw [hM, Submonoid.mem_comap] at hx
    rw [mem_nonZeroDivisors_iff_ne_zero]
    intro h0
    rw [h0, map_zero] at hx
    exact not_isUnit_zero hx
  -- `S` is a localization of the N-2 domain `S₀ = R[s]` (N-2 as `R` is universally Japanese),
  -- hence N-2 (Tag 032G).
  exact isN2_of_isLocalization S₀ S M hMnz (hR S₀)

/-- (Stacks Tag 032S, Lemma 10.162.4) If `R` is universally Japanese then any
`R`-algebra `A` essentially of finite type over `R` is universally Japanese. -/
@[stacks 032S, ega "IV 7.7.2" "moreover clause"]
theorem isUniversallyJapanese_of_isEssentiallyOfFiniteType (R : Type u) [CommRing R] (A : Type u)
    [CommRing A] [Algebra R A] (hR : IsUniversallyJapanese R)
    (hA : IsEssentiallyOfFiniteType R A (algebraMap R A)) : IsUniversallyJapanese A := by
  -- Reduce to: any domain `S` of finite type over `A` is N-2.
  intro S _ _ _ _
  -- `S` is essentially of finite type over `A` (finite type ⇒ essentially of finite type).
  have : Algebra.EssFiniteType A S := Algebra.EssFiniteType.of_finiteType A S
  -- Give `S` an `R`-algebra structure via `R → A → S`, compatible as a scalar tower.
  let : Algebra R S := ((algebraMap A S).comp (algebraMap R A)).toAlgebra
  have : IsScalarTower R A S := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  -- `A` is essentially of finite type over `R` (bridge lemma); composing with
  -- `A → S`, the tower `R → A → S` makes `S` essentially of finite type over `R`.
  have hAR : Algebra.EssFiniteType R A := essFiniteType_of_isEssentiallyOfFiniteType R A hA
  have : Algebra.EssFiniteType R S := Algebra.EssFiniteType.comp R A S
  -- It remains to show that a domain `S` essentially of finite type over a
  -- universally Japanese ring `R` is N-2 — the core lemma above.
  exact isN2_of_essFiniteType_of_universallyJapanese R S hR
