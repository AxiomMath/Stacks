module

public import Mathlib.RingTheory.ReesAlgebra
public import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
public import Mathlib.RingTheory.Nakayama
public import StacksFrontier.RingTheory.DimensionFormula

/-!
# A power of an ideal of a local ring has a reduction generated by `dim A` elements

Let `(A, 𝔪)` be a Noetherian local ring of Krull dimension `d` and let `I ⊆ 𝔪` be an ideal. This
file shows that there are an exponent `s ≥ 1` and elements `x₁, …, x_d ∈ I ^ s` such that
`J = (x₁, …, x_d)` is a reduction of `I ^ s`: `I ^ n = J * I ^ (n - s)` for all large `n`.
In particular the `I`-adic and the `J`-adic filtrations are comparable with a linear loss,
`J ^ q ⊆ I ^ (s * q)` and `I ^ n ⊆ J ^ q` as soon as `n ≥ N + q * s`.

## Main results

* `Stacks.ReesAlgebra.chainBound_map_maximalIdeal`: in the Rees algebra `R = A[I t]`, every chain
  of primes containing `𝔪 R` and contained in the homogeneous maximal ideal `𝔪 ⊕ R₊` has length
  at most `dim A`. In other words the fibre cone `R / 𝔪 R` has dimension at most `dim A` at its
  homogeneous maximal ideal.
* `Stacks.ReesAlgebra.exists_pow_le_span_mul_pow`: the reduction `J` of `I ^ s` with `dim A`
  generators.
* `Stacks.ReesAlgebra.exists_pow_le_span_pow`: the resulting comparison `I ^ n ⊆ J ^ q`.

## Implementation notes

The dimension bound is the dimension formula (Stacks 02IJ), applied to the image of the Rees
algebra in `(A ⧸ 𝔭)[t]` for a prime `𝔭` of `A` under a minimal prime of the Rees algebra: that
image is a domain of transcendence degree at most one over `A ⧸ 𝔭`, so its primes have height at
most `dim (A ⧸ 𝔭) + 1 ≤ d + 1`, and a chain above `𝔪 R` gains one more step at the bottom.

The generators are then chosen one at a time, each a homogeneous element of positive degree
avoiding every minimal prime of the ideal generated so far (together with `𝔪 R`) that lies
strictly inside the homogeneous maximal ideal. This homogeneous prime avoidance is proved
directly, by multiplying and adding powers of homogeneous elements of equal degree. Each choice
drops the length of the longest chain by one, so after `d` choices the homogeneous maximal ideal
is minimal over `𝔪 R + (y₁, …, y_d)`; raising the `yᵢ` to powers gives them a common degree `s`.
Localizing at the homogeneous maximal ideal and reading off the degree `n` component then gives
`I ^ n ⊆ 𝔪 I ^ n + J I ^ (n - s)` for large `n`, and Nakayama's lemma removes `𝔪 I ^ n`.
-/

@[expose] public section

open Polynomial

universe u

namespace Stacks.ReesAlgebra

/-! ### Chains of primes between two ideals -/

/-- Every strictly increasing chain of primes of `R` that starts above `𝔞` and ends below `𝔑` has
length at most `k`. -/
def ChainBound {R : Type*} [CommRing R] (𝔞 𝔑 : Ideal R) (k : ℕ) : Prop :=
  ∀ p : LTSeries (PrimeSpectrum R), 𝔞 ≤ p.head.asIdeal → p.last.asIdeal ≤ 𝔑 → p.length ≤ k

/-- A chain bound between `𝔞` and `𝔑` persists when `𝔞` is enlarged. -/
lemma ChainBound.anti {R : Type*} [CommRing R] {𝔞 𝔞' 𝔑 : Ideal R} {k : ℕ}
    (h : ChainBound 𝔞 𝔑 k) (h𝔞 : 𝔞 ≤ 𝔞') : ChainBound 𝔞' 𝔑 k :=
  fun p hhead hlast ↦ h p (h𝔞.trans hhead) hlast

/-- A strict chain whose last member lies below its first member has length zero. -/
lemma LTSeries.length_eq_zero_of_last_le {α : Type*} [Preorder α] (p : LTSeries α)
    (h : p.last ≤ p.head) : p.length = 0 := by
  by_contra hne
  have hlt : p.head < p.last :=
    p.strictMono (show (0 : Fin (p.length + 1)) < Fin.last p.length from
      Fin.lt_def.mpr (by simp; omega))
  exact absurd (hlt.trans_le h) (lt_irrefl _)

/-- An ideal containing the kernel of a surjection is the preimage of its image. -/
private theorem comap_map_eq_of_ker_le {R S : Type*} [CommRing R] [CommRing S] {π : R →+* S}
    (hπ : Function.Surjective π) {P : Ideal R} (hP : RingHom.ker π ≤ P) :
    (P.map π).comap π = P := by
  rw [Ideal.comap_map_of_surjective' _ hπ, sup_eq_left.mpr hP]

/-- A strict chain of primes of `R` containing the kernel of a surjection `π : R → S` maps to a
strict chain of primes of `S` of the same length. -/
lemma LTSeries.exists_map_of_surjective {R S : Type*} [CommRing R] [CommRing S] {π : R →+* S}
    (hπ : Function.Surjective π) (p : LTSeries (PrimeSpectrum R))
    (hp : ∀ i, RingHom.ker π ≤ (p i).asIdeal) :
    ∃ q : LTSeries (PrimeSpectrum S), q.length = p.length ∧
      q.head.asIdeal = p.head.asIdeal.map π ∧ q.last.asIdeal = p.last.asIdeal.map π := by
  refine ⟨LTSeries.mk p.length
    (fun i ↦ ⟨(p i).asIdeal.map π, Ideal.map_isPrime_of_surjective hπ (hp i)⟩) ?_, rfl, rfl, rfl⟩
  intro i j hij
  have hlt : (p i).asIdeal < (p j).asIdeal := p.strictMono hij
  rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
  refine lt_of_le_of_ne (Ideal.map_mono hlt.le) fun heq ↦ hlt.ne ?_
  rw [← comap_map_eq_of_ker_le hπ (hp i), ← comap_map_eq_of_ker_le hπ (hp j)]
  exact congrArg (Ideal.comap π) heq

/-! ### Homogeneous elements of the Rees algebra -/

section Homogeneous

variable {A : Type u} [CommRing A] {I : Ideal A}

/-- An element of the Rees algebra `reesAlgebra I ⊆ A[X]` is homogeneous of degree `s` when it
is a monomial of degree `s`. -/
def IsHomOfDeg (s : ℕ) (f : reesAlgebra I) : Prop :=
  ∃ a : A, (f : A[X]) = monomial s a

/-- The product of homogeneous elements of degrees `s` and `t` is homogeneous of degree
`s + t`. -/
lemma IsHomOfDeg.mul {s t : ℕ} {f g : reesAlgebra I} (hf : IsHomOfDeg s f)
    (hg : IsHomOfDeg t g) : IsHomOfDeg (s + t) (f * g) := by
  obtain ⟨a, ha⟩ := hf
  obtain ⟨b, hb⟩ := hg
  exact ⟨a * b, by rw [MulMemClass.coe_mul, ha, hb, monomial_mul_monomial]⟩

/-- The sum of two homogeneous elements of degree `s` is homogeneous of degree `s`. -/
lemma IsHomOfDeg.add {s : ℕ} {f g : reesAlgebra I} (hf : IsHomOfDeg s f)
    (hg : IsHomOfDeg s g) : IsHomOfDeg s (f + g) := by
  obtain ⟨a, ha⟩ := hf
  obtain ⟨b, hb⟩ := hg
  exact ⟨a + b, by rw [AddMemClass.coe_add, ha, hb, map_add]⟩

/-- The `k`-th power of a homogeneous element of degree `s` is homogeneous of degree `s * k`. -/
lemma IsHomOfDeg.pow {s : ℕ} {f : reesAlgebra I} (hf : IsHomOfDeg s f) (k : ℕ) :
    IsHomOfDeg (s * k) (f ^ k) := by
  obtain ⟨a, ha⟩ := hf
  exact ⟨a ^ k, by rw [SubmonoidClass.coe_pow, ha, monomial_pow]⟩

/-- Zero is homogeneous of every degree. -/
lemma isHomOfDeg_zero (s : ℕ) : IsHomOfDeg s (0 : reesAlgebra I) :=
  ⟨0, by simp⟩

/-- A finite product of homogeneous elements is homogeneous of degree the sum of their degrees. -/
lemma isHomOfDeg_prod {ι : Type*} (t : Finset ι) (s : ι → ℕ) (f : ι → reesAlgebra I)
    (h : ∀ i ∈ t, IsHomOfDeg (s i) (f i)) : IsHomOfDeg (∑ i ∈ t, s i) (∏ i ∈ t, f i) := by
  classical
  induction t using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert i t hi ih =>
    rw [Finset.prod_insert hi, Finset.sum_insert hi]
    exact (h i (Finset.mem_insert_self i t)).mul
      (ih fun j hj ↦ h j (Finset.mem_insert_of_mem hj))

/-- A finite sum of homogeneous elements of degree `s` is homogeneous of degree `s`. -/
lemma isHomOfDeg_sum {ι : Type*} (t : Finset ι) (s : ℕ) (f : ι → reesAlgebra I)
    (h : ∀ i ∈ t, IsHomOfDeg s (f i)) : IsHomOfDeg s (∑ i ∈ t, f i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simpa using isHomOfDeg_zero s
  | insert i t hi ih =>
    rw [Finset.sum_insert hi]
    exact (h i (Finset.mem_insert_self i t)).add
      (ih fun j hj ↦ h j (Finset.mem_insert_of_mem hj))

/-- A homogeneous element of positive degree lies in the homogeneous maximal ideal. -/
lemma IsHomOfDeg.coeff_zero {s : ℕ} {f : reesAlgebra I} (hf : IsHomOfDeg s f) (hs : 0 < s) :
    (f : A[X]).coeff 0 = 0 := by
  obtain ⟨a, ha⟩ := hf
  rw [ha, coeff_monomial, ite_eq_right (by omega)]

/-- **Homogeneous prime avoidance.** If none of finitely many primes of the Rees algebra contains
every homogeneous element of degree one, some homogeneous element of positive degree lies in
none of them. -/
theorem exists_isHomOfDeg_forall_notMem (𝒬 : Finset (Ideal (reesAlgebra I)))
    (hprime : ∀ Q ∈ 𝒬, Q.IsPrime) (havoid : ∀ Q ∈ 𝒬, ∃ f, IsHomOfDeg 1 f ∧ f ∉ Q) :
    ∃ s, 0 < s ∧ ∃ f, IsHomOfDeg s f ∧ ∀ Q ∈ 𝒬, f ∉ Q := by
  classical
  induction h : 𝒬.card using Nat.strong_induction_on generalizing 𝒬 with
  | _ n ih =>
  rcases Nat.lt_or_ge n 2 with hn | hn
  · interval_cases n
    · rw [Finset.card_eq_zero] at h
      subst h
      exact ⟨1, one_pos, 0, isHomOfDeg_zero 1, by simp⟩
    · obtain ⟨Q, rfl⟩ := Finset.card_eq_one.mp h
      obtain ⟨f, hf, hfQ⟩ := havoid Q (Finset.mem_singleton_self Q)
      exact ⟨1, one_pos, f, hf, by simpa using hfQ⟩
  have key : ∀ Q ∈ 𝒬, ∃ s, 0 < s ∧ ∃ f, IsHomOfDeg s f ∧ ∀ Q' ∈ 𝒬.erase Q, f ∉ Q' := by
    intro Q hQ
    exact ih _ (by rw [Finset.card_erase_of_mem hQ]; omega) (𝒬.erase Q)
      (fun Q' hQ' ↦ hprime Q' (Finset.mem_of_mem_erase hQ'))
      (fun Q' hQ' ↦ havoid Q' (Finset.mem_of_mem_erase hQ')) rfl
  choose! s hs y hy hyavoid using key
  by_cases hex : ∃ Q ∈ 𝒬, y Q ∉ Q
  · obtain ⟨Q, hQ, hyQ⟩ := hex
    refine ⟨s Q, hs Q hQ, y Q, hy Q hQ, fun Q' hQ' ↦ ?_⟩
    by_cases hQQ' : Q' = Q
    · rw [hQQ']
      exact hyQ
    · exact hyavoid Q hQ Q' (Finset.mem_erase.mpr ⟨hQQ', hQ'⟩)
  push Not at hex
  -- `p Q` is the product of the `y Q'` for `Q' ≠ Q`: it avoids `Q` and lies in every other `Q'`.
  set p : Ideal (reesAlgebra I) → reesAlgebra I := fun Q ↦ ∏ Q' ∈ 𝒬.erase Q, y Q' with hp_def
  set e : Ideal (reesAlgebra I) → ℕ := fun Q ↦ ∑ Q' ∈ 𝒬.erase Q, s Q' with he_def
  have hp : ∀ Q ∈ 𝒬, IsHomOfDeg (e Q) (p Q) := fun Q _ ↦
    isHomOfDeg_prod _ _ _ fun Q' hQ' ↦ hy Q' (Finset.mem_of_mem_erase hQ')
  have he : ∀ Q ∈ 𝒬, 0 < e Q := by
    intro Q hQ
    obtain ⟨Q', hQ'⟩ : (𝒬.erase Q).Nonempty := by
      rw [← Finset.card_pos, Finset.card_erase_of_mem hQ]
      omega
    exact lt_of_lt_of_le (hs Q' (Finset.mem_of_mem_erase hQ'))
      (Finset.single_le_sum (f := s) (fun _ _ ↦ Nat.zero_le _) hQ')
  have hpQ : ∀ Q ∈ 𝒬, p Q ∉ Q := by
    intro Q hQ hmem
    have := hprime Q hQ
    obtain ⟨Q', hQ', hyQ'⟩ := (Ideal.IsPrime.prod_mem_iff (p := Q)).mp hmem
    exact hyavoid Q' (Finset.mem_of_mem_erase hQ') Q
      (Finset.mem_erase.mpr ⟨fun h ↦ Finset.ne_of_mem_erase hQ' h.symm, hQ⟩) hyQ'
  have hpQ' : ∀ Q ∈ 𝒬, ∀ Q'' ∈ 𝒬, Q'' ≠ Q → p Q'' ∈ Q := by
    intro Q hQ Q'' _ hne
    have hmem : Q ∈ 𝒬.erase Q'' := Finset.mem_erase.mpr ⟨fun h ↦ hne h.symm, hQ⟩
    simp only [hp_def]
    rw [← Finset.mul_prod_erase _ _ hmem]
    exact Q.mul_mem_right _ (hex Q hQ)
  set k : Ideal (reesAlgebra I) → ℕ := fun Q ↦ ∏ Q' ∈ 𝒬.erase Q, e Q' with hk_def
  have hk : ∀ Q ∈ 𝒬, 0 < k Q := fun Q _ ↦
    Finset.prod_pos fun Q' hQ' ↦ he Q' (Finset.mem_of_mem_erase hQ')
  have hek : ∀ Q ∈ 𝒬, e Q * k Q = ∏ Q ∈ 𝒬, e Q := fun Q hQ ↦ Finset.mul_prod_erase 𝒬 e hQ
  refine ⟨∏ Q ∈ 𝒬, e Q, Finset.prod_pos he, ∑ Q ∈ 𝒬, p Q ^ k Q,
    isHomOfDeg_sum _ _ _ fun Q hQ ↦ hek Q hQ ▸ (hp Q hQ).pow (k Q), fun Q hQ hmem ↦ ?_⟩
  have := hprime Q hQ
  rw [← Finset.add_sum_erase 𝒬 _ hQ] at hmem
  have hrest : ∑ Q'' ∈ 𝒬.erase Q, p Q'' ^ k Q'' ∈ Q := Ideal.sum_mem _ fun Q'' hQ'' ↦
    Q.pow_mem_of_mem (hpQ' Q hQ Q'' (Finset.mem_of_mem_erase hQ'') (Finset.ne_of_mem_erase hQ''))
      _ (hk Q'' (Finset.mem_of_mem_erase hQ''))
  exact hpQ Q hQ (Ideal.IsPrime.mem_of_pow_mem ‹_› _ ((Ideal.add_mem_iff_left Q hrest).mp hmem))

/-- The homogeneous element `a X ^ n` of the Rees algebra lies in the `n`-th power of the ideal
generated by the homogeneous elements of degree one. -/
lemma exists_mem_pow_span_isHomOfDeg_one (n : ℕ) {a : A} (ha : a ∈ I ^ n) :
    ∃ f ∈ (Ideal.span {f : reesAlgebra I | IsHomOfDeg 1 f}) ^ n, (f : A[X]) = monomial n a := by
  induction n generalizing a with
  | zero =>
    refine ⟨algebraMap A (reesAlgebra I) a, by simp, ?_⟩
    simp [monomial_zero_left]
  | succ n ih =>
    rw [pow_succ'] at ha
    refine Submodule.mul_induction_on ha (fun x hx y hy ↦ ?_) (fun x y hx hy ↦ ?_)
    · obtain ⟨f, hf, hfy⟩ := ih hy
      refine ⟨⟨monomial 1 x, reesAlgebra.monomial_mem.mpr (by simpa using hx)⟩ * f, ?_, ?_⟩
      · rw [pow_succ']
        exact Ideal.mul_mem_mul (Ideal.subset_span ⟨x, rfl⟩) hf
      · rw [MulMemClass.coe_mul, hfy, monomial_mul_monomial, add_comm 1 n]
    · obtain ⟨f, hf, hfx⟩ := hx
      obtain ⟨g, hg, hgy⟩ := hy
      exact ⟨f + g, add_mem hf hg, by rw [AddMemClass.coe_add, hfx, hgy, map_add]⟩

/-- The homogeneous ideal of the Rees algebra lying over `𝔪` in degree zero: the elements whose
constant coefficient lies in `𝔪`. For `𝔪` the maximal ideal of a local ring this is the
homogeneous maximal ideal `𝔪 ⊕ I t ⊕ I ^ 2 t ^ 2 ⊕ ⋯`. -/
noncomputable def homIdeal (I 𝔪 : Ideal A) : Ideal (reesAlgebra I) :=
  𝔪.comap (constantCoeff.comp (reesAlgebra I).val.toRingHom)

/-- An element lies in `homIdeal I 𝔪` if and only if its constant coefficient lies in `𝔪`. -/
lemma mem_homIdeal {𝔪 : Ideal A} {f : reesAlgebra I} :
    f ∈ homIdeal I 𝔪 ↔ (f : A[X]).coeff 0 ∈ 𝔪 := by
  simp [homIdeal, Ideal.mem_comap, constantCoeff_apply]

/-- The homogeneous ideal over a prime `𝔪` is prime. -/
instance (𝔪 : Ideal A) [𝔪.IsPrime] : (homIdeal I 𝔪).IsPrime :=
  Ideal.comap_isPrime _ _

/-- The extension of `𝔪` to the Rees algebra is contained in `homIdeal I 𝔪`. -/
lemma map_le_homIdeal (𝔪 : Ideal A) :
    𝔪.map (algebraMap A (reesAlgebra I)) ≤ homIdeal I 𝔪 := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  simpa [mem_homIdeal, Ideal.mem_comap] using ha

/-- A homogeneous element of positive degree lies in `homIdeal I 𝔪`. -/
lemma IsHomOfDeg.mem_homIdeal {𝔪 : Ideal A} {s : ℕ} {f : reesAlgebra I} (hf : IsHomOfDeg s f)
    (hs : 0 < s) : f ∈ homIdeal I 𝔪 := by
  rw [Stacks.ReesAlgebra.mem_homIdeal, hf.coeff_zero hs]
  exact 𝔪.zero_mem

/-- An ideal of the Rees algebra containing `𝔪` (in degree zero) and every homogeneous element
of degree one contains the homogeneous ideal over `𝔪`. -/
lemma homIdeal_le {𝔪 : Ideal A} {Q : Ideal (reesAlgebra I)}
    (h𝔪 : 𝔪.map (algebraMap A (reesAlgebra I)) ≤ Q) (h1 : ∀ f, IsHomOfDeg 1 f → f ∈ Q) :
    homIdeal I 𝔪 ≤ Q := by
  intro f hf
  have hspan : Ideal.span {f : reesAlgebra I | IsHomOfDeg 1 f} ≤ Q := Ideal.span_le.mpr h1
  have hcoeff : ∀ n, (f : A[X]).coeff n ∈ I ^ n := (mem_reesAlgebra_iff I _).mp f.2
  have hsum : f = ∑ n ∈ Finset.range ((f : A[X]).natDegree + 1),
      (⟨monomial n ((f : A[X]).coeff n), reesAlgebra.monomial_mem.mpr (hcoeff n)⟩ :
        reesAlgebra I) := by
    apply Subtype.ext
    rw [AddSubmonoidClass.coe_finsetSum]
    exact (f : A[X]).as_sum_range
  rw [hsum]
  refine Ideal.sum_mem _ fun n _ ↦ ?_
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have : (⟨monomial 0 ((f : A[X]).coeff 0), reesAlgebra.monomial_mem.mpr (hcoeff 0)⟩ :
        reesAlgebra I) = algebraMap A (reesAlgebra I) ((f : A[X]).coeff 0) := by
      apply Subtype.ext
      simp [monomial_zero_left]
    rw [this]
    exact h𝔪 (Ideal.mem_map_of_mem _ (Stacks.ReesAlgebra.mem_homIdeal.mp hf))
  · obtain ⟨g, hg, hgf⟩ := exists_mem_pow_span_isHomOfDeg_one n (hcoeff n)
    have : (⟨monomial n ((f : A[X]).coeff n), reesAlgebra.monomial_mem.mpr (hcoeff n)⟩ :
        reesAlgebra I) = g := Subtype.ext hgf.symm
    rw [this]
    exact hspan (Ideal.pow_le_self hn.ne' hg)

end Homogeneous

/-! ### The fibre cone has dimension at most `dim A` -/

section Dimension

variable {A : Type u} [CommRing A] {I : Ideal A}

/-- Reducing the coefficients modulo an ideal `𝔭` maps the Rees algebra of `I` onto the Rees
algebra of the image of `I` in `A ⧸ 𝔭`. -/
noncomputable def quotientMap (I 𝔭 : Ideal A) :
    reesAlgebra I →+* reesAlgebra (I.map (Ideal.Quotient.mk 𝔭)) :=
  RingHom.codRestrict ((mapRingHom (Ideal.Quotient.mk 𝔭)).comp (reesAlgebra I).val.toRingHom)
    (reesAlgebra (I.map (Ideal.Quotient.mk 𝔭))) fun f ↦ by
      rw [mem_reesAlgebra_iff]
      intro n
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        Subalgebra.coe_val, coe_mapRingHom, coeff_map, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ ((mem_reesAlgebra_iff I _).mp f.2 n)

/-- `quotientMap I 𝔭` reduces the coefficients of a polynomial modulo `𝔭`. -/
lemma coe_quotientMap (𝔭 : Ideal A) (f : reesAlgebra I) :
    (quotientMap I 𝔭 f : (A ⧸ 𝔭)[X]) = (f : A[X]).map (Ideal.Quotient.mk 𝔭) :=
  rfl

/-- `quotientMap I 𝔭` is surjective. -/
lemma quotientMap_surjective (𝔭 : Ideal A) : Function.Surjective (quotientMap I 𝔭) := by
  suffices h : ∀ g ∈ Algebra.adjoin (A ⧸ 𝔭)
      ((Submodule.map (monomial 1 : (A ⧸ 𝔭) →ₗ[A ⧸ 𝔭] (A ⧸ 𝔭)[X])
        (I.map (Ideal.Quotient.mk 𝔭))) : Set (A ⧸ 𝔭)[X]),
      ∃ f : reesAlgebra I, (f : A[X]).map (Ideal.Quotient.mk 𝔭) = g by
    rintro ⟨g, hg⟩
    rw [← adjoin_monomial_eq_reesAlgebra] at hg
    obtain ⟨f, hf⟩ := h g hg
    exact ⟨f, Subtype.ext hf⟩
  intro g hg
  induction hg using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨r, hr, rfl⟩ := hx
    obtain ⟨a, ha, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hr
    exact ⟨⟨monomial 1 a, reesAlgebra.monomial_mem.mpr (by simpa using ha)⟩, by simp⟩
  | algebraMap r =>
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective r
    exact ⟨algebraMap A (reesAlgebra I) a, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨f, hf⟩ := hx
    obtain ⟨f', hf'⟩ := hy
    exact ⟨f + f', by simp [hf, hf']⟩
  | mul x y _ _ hx hy =>
    obtain ⟨f, hf⟩ := hx
    obtain ⟨f', hf'⟩ := hy
    exact ⟨f * f', by simp [hf, hf']⟩

/-- If a prime `P` of `A[X]` contains `𝔭` in degree zero, the kernel of `quotientMap I 𝔭` is
contained in the restriction of `P` to the Rees algebra. -/
lemma ker_quotientMap_le (𝔭 : Ideal A) {P : Ideal A[X]} (h : 𝔭 ≤ P.comap C) :
    RingHom.ker (quotientMap I 𝔭) ≤ P.comap (reesAlgebra I).val.toRingHom := by
  intro f hf
  have hf' : (f : A[X]) ∈ RingHom.ker (mapRingHom (Ideal.Quotient.mk 𝔭)) := by
    rw [RingHom.mem_ker, coe_mapRingHom, ← coe_quotientMap, RingHom.mem_ker.mp hf]
    rfl
  rw [Polynomial.ker_mapRingHom, Ideal.mk_ker] at hf'
  exact Ideal.map_le_iff_le_comap.mpr h hf'

/-- The image under `quotientMap I 𝔭` of a prime containing its kernel is prime. -/
lemma isPrime_map_quotientMap (𝔭 : Ideal A) {P : Ideal (reesAlgebra I)} [P.IsPrime]
    (hP : RingHom.ker (quotientMap I 𝔭) ≤ P) : (P.map (quotientMap I 𝔭)).IsPrime :=
  Ideal.map_isPrime_of_surjective (quotientMap_surjective 𝔭) hP

/-- **The fibre cone has dimension at most `dim A`.** Let `(A, 𝔪)` be a Noetherian local ring
with `dim A ≤ d` and let `I ⊆ 𝔪`. Every strictly increasing chain of primes of the Rees algebra
that starts above `𝔪` and ends below the homogeneous maximal ideal has length at most `d`. -/
theorem chainBound_map_maximalIdeal [IsNoetherianRing A] [IsLocalRing A]
    (hI : I ≤ IsLocalRing.maximalIdeal A) {d : ℕ} (hd : ringKrullDim A ≤ d) :
    ChainBound ((IsLocalRing.maximalIdeal A).map (algebraMap A (reesAlgebra I)))
      (homIdeal I (IsLocalRing.maximalIdeal A)) d := by
  intro p hhead hlast
  set 𝔪 := IsLocalRing.maximalIdeal A
  obtain ⟨Q, hQ, hQP⟩ :=
    Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal (reesAlgebra I)) ≤ p.head.asIdeal)
  have hinj : Function.Injective (reesAlgebra I).val.toRingHom := Subtype.val_injective
  obtain ⟨P', hP'min, hP'⟩ := Ideal.exists_minimalPrimes_comap_eq (I := (⊥ : Ideal A[X]))
    (reesAlgebra I).val.toRingHom Q (by rwa [Ideal.comap_bot_of_injective _ hinj])
  have : P'.IsPrime := hP'min.1.1
  set 𝔭 : Ideal A := P'.comap C
  set π := quotientMap I 𝔭
  have hker : RingHom.ker π ≤ p.head.asIdeal :=
    (ker_quotientMap_le 𝔭 le_rfl).trans (hP' ▸ hQP)
  have hkerp : ∀ i, RingHom.ker π ≤ (p i).asIdeal := fun i ↦ hker.trans (p.head_le i)
  by_cases hP₀ : p.head.asIdeal ≤ RingHom.ker π
  · have h𝔪𝔭 : 𝔪 ≤ 𝔭 := by
      intro a ha
      have h1 : π (algebraMap A (reesAlgebra I) a) = 0 :=
        hP₀ (hhead (Ideal.mem_map_of_mem _ ha))
      have h2 := congrArg (fun g : reesAlgebra (I.map (Ideal.Quotient.mk 𝔭)) ↦
        (g : (A ⧸ 𝔭)[X]).coeff 0) h1
      simp only [π, coe_quotientMap] at h2
      simpa [Ideal.Quotient.eq_zero_iff_mem] using h2
    have hN : homIdeal I 𝔪 ≤ p.head.asIdeal := homIdeal_le hhead fun f ⟨a, ha⟩ ↦ by
      apply hker
      have haI : a ∈ I := by
        have := (mem_reesAlgebra_iff I _).mp f.2 1
        simpa [ha] using this
      rw [RingHom.mem_ker]
      apply Subtype.ext
      rw [coe_quotientMap, ha, map_monomial,
        Ideal.Quotient.eq_zero_iff_mem.mpr (h𝔪𝔭 (hI haI))]
      simp
    have := LTSeries.length_eq_zero_of_last_le p (hlast.trans hN)
    omega
  · obtain ⟨q, hqlen, hqhead, hqlast⟩ := LTSeries.exists_map_of_surjective
      (quotientMap_surjective (I := I) 𝔭) p hkerp
    have hbot : (⟨⊥, Ideal.isPrime_bot⟩ :
        PrimeSpectrum (reesAlgebra (I.map (Ideal.Quotient.mk 𝔭)))) < q.head := by
      rw [← PrimeSpectrum.asIdeal_lt_asIdeal, bot_lt_iff_ne_bot, hqhead]
      intro h
      apply hP₀
      rw [← comap_map_eq_of_ker_le (quotientMap_surjective 𝔭) hker, h]
      exact le_rfl
    have hlen : ((p.length + 1 : ℕ) : ℕ∞) ≤ q.last.asIdeal.height := by
      rw [PrimeSpectrum.height_eq_orderHeight]
      have := Order.length_le_height_last (p := q.cons _ hbot)
      simpa [hqlen] using this
    set Q' := q.last.asIdeal
    have hinjS :
        Function.Injective (algebraMap (A ⧸ 𝔭) (reesAlgebra (I.map (Ideal.Quotient.mk 𝔭)))) := by
      intro a b h
      have := congrArg Subtype.val h
      simpa using this
    have hdf := height_add_trdeg_residue_le hinjS (Q'.under (A ⧸ 𝔭)) Q'
    have htr :
        Cardinal.toNat (Algebra.trdeg (A ⧸ 𝔭) (reesAlgebra (I.map (Ideal.Quotient.mk 𝔭)))) ≤ 1 := by
      have h1 : Algebra.trdeg (A ⧸ 𝔭) (reesAlgebra (I.map (Ideal.Quotient.mk 𝔭))) ≤ 1 := by
        have := trdeg_le_of_injective ((reesAlgebra (I.map (Ideal.Quotient.mk 𝔭))).val)
          Subtype.val_injective
        rwa [Polynomial.trdeg_of_isDomain] at this
      have := Cardinal.toNat_le_toNat h1 Cardinal.one_lt_aleph0
      simpa using this
    have hht : (Q'.under (A ⧸ 𝔭)).height ≤ d := by
      have h1 := Ideal.height_le_ringKrullDim_of_isPrime (I := Q'.under (A ⧸ 𝔭))
      have h2 := ringKrullDim_quotient_le 𝔭
      exact_mod_cast h1.trans (h2.trans hd)
    have key : ((p.length + 1 : ℕ) : ℕ∞) ≤ ((d + 1 : ℕ) : ℕ∞) := by
      calc ((p.length + 1 : ℕ) : ℕ∞) ≤ Q'.height := hlen
        _ ≤ _ := le_self_add
        _ ≤ _ := hdf
        _ ≤ (d : ℕ∞) + (1 : ℕ) := add_le_add hht (by exact_mod_cast htr)
        _ = ((d + 1 : ℕ) : ℕ∞) := by push_cast; rfl
    have := Nat.cast_le.mp key
    omega

end Dimension

/-! ### Choosing the generators -/

section Reduction

variable {A : Type u} [CommRing A] {I : Ideal A}

/-- One step of the construction: if every chain of primes between `𝔞 ⊇ 𝔪 R` and the homogeneous
ideal over `𝔪` has length at most `k + 1`, a single homogeneous element of positive degree can be
added to `𝔞` so that the bound drops to `k`. -/
theorem exists_isHomOfDeg_chainBound_sup [IsNoetherianRing A] {𝔪 : Ideal A}
    {𝔞 : Ideal (reesAlgebra I)} {k : ℕ} (h𝔪 : 𝔪.map (algebraMap A (reesAlgebra I)) ≤ 𝔞)
    (hb : ChainBound 𝔞 (homIdeal I 𝔪) (k + 1)) :
    ∃ s, 0 < s ∧ ∃ y, IsHomOfDeg s y ∧ ChainBound (𝔞 ⊔ Ideal.span {y}) (homIdeal I 𝔪) k := by
  classical
  have hfin : {Q : Ideal (reesAlgebra I) |
      Q ∈ 𝔞.minimalPrimes ∧ Q ≤ homIdeal I 𝔪 ∧ Q ≠ homIdeal I 𝔪}.Finite :=
    (Ideal.finite_minimalPrimes_of_isNoetherianRing _ 𝔞).subset fun Q hQ ↦ hQ.1
  obtain ⟨s, hs, y, hy, hyQ⟩ := exists_isHomOfDeg_forall_notMem hfin.toFinset
    (fun Q hQ ↦ ((hfin.mem_toFinset.mp hQ).1).1.1)
    (fun Q hQ ↦ by
      obtain ⟨hQmin, hQN, hQne⟩ := hfin.mem_toFinset.mp hQ
      by_contra! hall
      exact hQne (le_antisymm hQN (homIdeal_le (h𝔪.trans hQmin.1.2) fun f hf ↦ hall f hf)))
  refine ⟨s, hs, y, hy, fun p hhead hlast ↦ ?_⟩
  have hP₀ : 𝔞 ≤ p.head.asIdeal := le_sup_left.trans hhead
  obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_minimalPrimes_le hP₀
  have hQN : Q ≤ homIdeal I 𝔪 :=
    hQP.trans ((show p.head.asIdeal ≤ p.last.asIdeal from p.head_le_last).trans hlast)
  by_cases hQeq : Q = homIdeal I 𝔪
  · have : p.last ≤ p.head := show p.last.asIdeal ≤ p.head.asIdeal from hlast.trans (hQeq ▸ hQP)
    rw [LTSeries.length_eq_zero_of_last_le p this]
    exact Nat.zero_le _
  · have hyP : y ∈ p.head.asIdeal := hhead (Ideal.mem_sup_right (Ideal.subset_span rfl))
    have hyQ' : y ∉ Q := hyQ Q (hfin.mem_toFinset.mpr ⟨hQ, hQN, hQeq⟩)
    have hlt : (⟨Q, hQ.1.1⟩ : PrimeSpectrum (reesAlgebra I)) < p.head := by
      refine lt_of_le_of_ne hQP fun h ↦ hyQ' ?_
      rw [← h] at hyP
      exact hyP
    have := hb (p.cons ⟨Q, hQ.1.1⟩ hlt) hQ.1.2 (by simpa using hlast)
    simp only [RelSeries.cons_length] at this
    omega

/-- Iterating `exists_isHomOfDeg_chainBound_sup`: `k` homogeneous elements of positive degree
bring the chain bound from `k` down to `0`. -/
theorem exists_isHomOfDeg_family_chainBound_zero [IsNoetherianRing A] {𝔪 : Ideal A} (k : ℕ) :
    ∀ 𝔞 : Ideal (reesAlgebra I), 𝔪.map (algebraMap A (reesAlgebra I)) ≤ 𝔞 →
      ChainBound 𝔞 (homIdeal I 𝔪) k →
      ∃ s : Fin k → ℕ, ∃ y : Fin k → reesAlgebra I,
        (∀ i, 0 < s i ∧ IsHomOfDeg (s i) (y i)) ∧
        ChainBound (𝔞 ⊔ Ideal.span (Set.range y)) (homIdeal I 𝔪) 0 := by
  induction k with
  | zero =>
    intro 𝔞 _ hb
    exact ⟨Fin.elim0, Fin.elim0, fun i ↦ i.elim0, hb.anti le_sup_left⟩
  | succ k ih =>
    intro 𝔞 h𝔪 hb
    obtain ⟨s₀, hs₀, y₀, hy₀, hb'⟩ := exists_isHomOfDeg_chainBound_sup h𝔪 hb
    obtain ⟨s, y, hsy, hb''⟩ := ih _ (h𝔪.trans le_sup_left) hb'
    refine ⟨Fin.cons s₀ s, Fin.cons y₀ y, Fin.forall_fin_succ.mpr ⟨⟨hs₀, hy₀⟩, hsy⟩,
      hb''.anti ?_⟩
    rw [Fin.range_cons, Ideal.span_insert, sup_assoc]

/-- The ideal of the Rees algebra whose degree `n` coefficients lie in `𝔪 I ^ n + J I ^ (n - s)`.
-/
def coeffIdeal (I 𝔪 J : Ideal A) (s : ℕ) : Ideal (reesAlgebra I) where
  carrier := {f | ∀ n, (f : A[X]).coeff n ∈ 𝔪 * I ^ n ⊔ J * I ^ (n - s)}
  add_mem' {f g} hf hg n := by
    rw [AddMemClass.coe_add, coeff_add]
    exact add_mem (hf n) (hg n)
  zero_mem' n := by simp
  smul_mem' c f hf n := by
    rw [smul_eq_mul, MulMemClass.coe_mul, coeff_mul]
    refine Ideal.sum_mem _ fun x hx ↦ ?_
    rw [Finset.mem_antidiagonal] at hx
    have hc : (c : A[X]).coeff x.1 ∈ I ^ x.1 := (mem_reesAlgebra_iff I _).mp c.2 x.1
    have hle : I ^ x.1 * (𝔪 * I ^ x.2 ⊔ J * I ^ (x.2 - s)) ≤ 𝔪 * I ^ n ⊔ J * I ^ (n - s) := by
      rw [Ideal.mul_sup]
      refine sup_le_sup (le_of_eq ?_) ?_
      · rw [← hx, pow_add]
        ring
      · calc I ^ x.1 * (J * I ^ (x.2 - s)) = J * I ^ (x.1 + (x.2 - s)) := by
              rw [pow_add]; ring
          _ ≤ J * I ^ (n - s) := Ideal.mul_mono_right (Ideal.pow_le_pow_right (by omega))
    exact hle (Ideal.mul_mem_mul hc (hf x.2))

/-- An element lies in `coeffIdeal I 𝔪 J s` if and only if its degree `n` coefficient lies in
`𝔪 I ^ n + J I ^ (n - s)` for every `n`. -/
lemma mem_coeffIdeal {𝔪 J : Ideal A} {s : ℕ} {f : reesAlgebra I} :
    f ∈ coeffIdeal I 𝔪 J s ↔ ∀ n, (f : A[X]).coeff n ∈ 𝔪 * I ^ n ⊔ J * I ^ (n - s) :=
  Iff.rfl

/-- If the only prime between `𝔞` and a prime `𝔑 ⊇ 𝔞` of a Noetherian ring is `𝔑`, a power of
`𝔑` is moved into `𝔞` by multiplication with an element outside `𝔑`. -/
theorem exists_pow_mul_mem_of_chainBound_zero {R : Type*} [CommRing R] [IsNoetherianRing R]
    {𝔞 𝔑 : Ideal R} [𝔑.IsPrime] (h𝔞 : 𝔞 ≤ 𝔑) (hb : ChainBound 𝔞 𝔑 0) :
    ∃ N, ∀ z ∈ 𝔑 ^ N, ∃ w ∉ 𝔑, w * z ∈ 𝔞 := by
  have hmin : 𝔑 ∈ 𝔞.minimalPrimes := by
    refine ⟨⟨‹_›, h𝔞⟩, fun P ⟨hP, h𝔞P⟩ hPN ↦ ?_⟩
    by_contra hne
    have hlt : (⟨P, hP⟩ : PrimeSpectrum R) < ⟨𝔑, ‹_›⟩ :=
      lt_of_le_of_ne hPN fun h ↦ hne (by rw [show P = 𝔑 from congrArg PrimeSpectrum.asIdeal h])
    let q : LTSeries (PrimeSpectrum R) :=
      (RelSeries.singleton _ (⟨𝔑, ‹_›⟩ : PrimeSpectrum R)).cons ⟨P, hP⟩ hlt
    have := hb q (show 𝔞 ≤ P from h𝔞P) (show 𝔑 ≤ 𝔑 from le_rfl)
    have hq : q.length = 1 := rfl
    omega
  have hrad := IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes
    (A := Localization.AtPrime 𝔑) 𝔑 𝔞 hmin
  obtain ⟨N, hN⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad.ge
    (IsNoetherian.noetherian _)
  refine ⟨N, fun z hz ↦ ?_⟩
  have hz' : algebraMap R (Localization.AtPrime 𝔑) z ∈ 𝔞.map (algebraMap R _) := by
    apply hN
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hz
  obtain ⟨w, hw, hwz⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff 𝔑.primeCompl _ 𝔞 z).mp hz'
  exact ⟨w, hw, hwz⟩

/-- **A reduction of a power with `dim A` generators.** Let `(A, 𝔪)` be a Noetherian local ring
with `dim A ≤ d` and let `I ⊆ 𝔪` be an ideal. There are `s ≥ 1` and `x₁, …, x_d ∈ I ^ s` such
that `I ^ n = (x₁, …, x_d) I ^ (n - s)` for all large `n`. -/
theorem exists_pow_le_span_mul_pow [IsNoetherianRing A] [IsLocalRing A]
    (hI : I ≤ IsLocalRing.maximalIdeal A) {d : ℕ} (hd : ringKrullDim A ≤ d) :
    ∃ s, 0 < s ∧ ∃ x : Fin d → A, (∀ i, x i ∈ I ^ s) ∧
      ∃ N, ∀ n, N ≤ n → I ^ n ≤ Ideal.span (Set.range x) * I ^ (n - s) := by
  classical
  set 𝔪 := IsLocalRing.maximalIdeal A
  obtain ⟨s, y, hsy, hb⟩ := exists_isHomOfDeg_family_chainBound_zero d _ le_rfl
    (chainBound_map_maximalIdeal hI hd)
  set S := ∏ i, s i
  have hS : 0 < S := Finset.prod_pos fun i _ ↦ (hsy i).1
  have hy' : ∀ i, IsHomOfDeg S (y i ^ (S / s i)) := by
    intro i
    have := (hsy i).2.pow (S / s i)
    rwa [Nat.mul_div_cancel' (Finset.dvd_prod_of_mem s (Finset.mem_univ i))] at this
  choose x hx using hy'
  have hxI : ∀ i, x i ∈ I ^ S := fun i ↦ by
    have := (mem_reesAlgebra_iff I _).mp (y i ^ (S / s i)).2 S
    simpa [hx i] using this
  set J := Ideal.span (Set.range x)
  set 𝔞 := 𝔪.map (algebraMap A (reesAlgebra I)) ⊔
    Ideal.span (Set.range fun i ↦ y i ^ (S / s i))
  have hb' : ChainBound 𝔞 (homIdeal I 𝔪) 0 := by
    intro p hhead hlast
    refine hb p (sup_le (le_sup_left.trans hhead) (Ideal.span_le.mpr ?_)) hlast
    rintro _ ⟨i, rfl⟩
    exact p.head.isPrime.mem_of_pow_mem _
      (hhead (Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩)))
  have h𝔞N : 𝔞 ≤ homIdeal I 𝔪 := by
    refine sup_le (map_le_homIdeal 𝔪) (Ideal.span_le.mpr ?_)
    rintro _ ⟨i, rfl⟩
    exact IsHomOfDeg.mem_homIdeal (show IsHomOfDeg S (y i ^ (S / s i)) from ⟨x i, hx i⟩) hS
  have h𝔞T : 𝔞 ≤ coeffIdeal I 𝔪 J S := by
    refine sup_le ?_ (Ideal.span_le.mpr ?_)
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha n
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · refine Ideal.mem_sup_left ?_
        simpa using ha
      · simp [coeff_C, hn.ne']
    · rintro _ ⟨i, rfl⟩ n
      rw [hx i, coeff_monomial]
      split_ifs with h
      · subst h
        refine Ideal.mem_sup_right ?_
        rw [Nat.sub_self, pow_zero, Ideal.one_eq_top, Ideal.mul_top]
        exact Ideal.subset_span (Set.mem_range_self i)
      · exact zero_mem _
  obtain ⟨N, hN⟩ := exists_pow_mul_mem_of_chainBound_zero h𝔞N hb'
  refine ⟨S, hS, x, hxI, N, fun n hn ↦ ?_⟩
  refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
    (IsLocalRing.maximalIdeal_le_jacobson ⊥) ?_
  intro a ha
  obtain ⟨g, hg, hga⟩ := exists_mem_pow_span_isHomOfDeg_one n ha
  have hgN : g ∈ homIdeal I 𝔪 ^ N := by
    refine Ideal.pow_le_pow_right hn (Ideal.pow_right_mono ?_ n hg)
    exact Ideal.span_le.mpr fun f hf ↦ IsHomOfDeg.mem_homIdeal hf one_pos
  obtain ⟨w, hw, hwg⟩ := hN g hgN
  have hcoeff := (mem_coeffIdeal.mp (h𝔞T hwg)) n
  have hmono := coeff_mul_monomial (w : A[X]) n 0 a
  rw [zero_add] at hmono
  rw [MulMemClass.coe_mul, hga, hmono] at hcoeff
  have hu : IsUnit ((w : A[X]).coeff 0) := by
    by_contra hnu
    exact hw (mem_homIdeal.mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu))
  have := (Ideal.unit_mul_mem_iff_mem _ hu).mp hcoeff
  rw [sup_comm] at this
  simpa [Ideal.smul_eq_mul] using this

/-- **Comparison of the filtrations.** Let `(A, 𝔪)` be a Noetherian local ring with
`dim A ≤ d` and let `I ⊆ 𝔪` be an ideal. There are `s ≥ 1`, `x₁, …, x_d ∈ I ^ s` and `N` such
that, with `J = (x₁, …, x_d)`, `I ^ n ⊆ J ^ q` whenever `N + q * s ≤ n`. -/
theorem exists_pow_le_span_pow [IsNoetherianRing A] [IsLocalRing A]
    (hI : I ≤ IsLocalRing.maximalIdeal A) {d : ℕ} (hd : ringKrullDim A ≤ d) :
    ∃ s, 0 < s ∧ ∃ x : Fin d → A, (∀ i, x i ∈ I ^ s) ∧
      ∃ N, ∀ q n, N + q * s ≤ n → I ^ n ≤ Ideal.span (Set.range x) ^ q := by
  obtain ⟨s, hs, x, hx, N, hN⟩ := exists_pow_le_span_mul_pow hI hd
  refine ⟨s, hs, x, hx, N, fun q ↦ ?_⟩
  induction q with
  | zero => intro n _; simp
  | succ q ih =>
    intro n hn
    calc I ^ n ≤ Ideal.span (Set.range x) * I ^ (n - s) := hN n (by nlinarith)
      _ ≤ Ideal.span (Set.range x) * Ideal.span (Set.range x) ^ q :=
          Ideal.mul_mono_right (ih (n - s) (by rw [Nat.add_mul] at hn; omega))
      _ = Ideal.span (Set.range x) ^ (q + 1) := (pow_succ' _ _).symm

end Reduction

end Stacks.ReesAlgebra
