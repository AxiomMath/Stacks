/-!
# Extending a Rees-algebra map to a finite module

Let `A` be a commutative ring, `I ⊆ A` an ideal generated by a finite family `f`, and let
`φ : Fin r → (I ^ c) →ₗ[A] A` split the inclusion of `I ^ c` into `A` against `f`, in the sense
that `∑ⱼ f j · φ j g = g` on `I ^ c`. This file extends that splitting to the Rees module of a
finite module: for a Noetherian `A`-algebra `B` and a finite `B`-module `N` there is a power
`c' ≥ c` and a splitting `φ'` on `I ^ c'` restricting `φ`, for which the graded algebra map
`extendLinearMaps (I ^ c') φ'` lifts to a graded map on the Rees module `⨁ₙ I^(nc') N`, uniquely.

The splitting is transported to `B` by base change: `B ⊗_A I^c ⟶ B` factors through
`I^c B` after killing a kernel which is annihilated by a power of `I B`, which is where
Noetherianity and finiteness enter. Raising `c` to `c' = c + k` for that power makes the
factorization exact on the nose.

## Main definitions

* `Stacks.ReesAlgebra.reesModulePiece` — the degree-`n` part `I^(nc) N` of the Rees module.
* `Stacks.ReesAlgebra.moduleMvPolynomial` — multivariable polynomials with coefficients in a
  module, in monomial coordinates.

## Main results

* `Stacks.ReesAlgebra.exists_unique_extendLinearMaps_module` — the adjusted power, the restricted
  coefficient maps, and the unique degreewise graded module map, with its scalar formula and its
  evaluation at the chosen generators.

## Implementation notes

The degree-`n` part of the Rees module is the submodule `I^(nc) N` of `N`, and a graded map out of
it is given degreewise, as a family indexed by `n`. Its target is `moduleMvPolynomial r N`, the
finitely supported functions on monomials in `r` variables with values in `N`, which is the
module-coefficient analogue of `MvPolynomial (Fin r) A`; the grading condition says that the
coefficient at a monomial of total degree other than `n` vanishes.

Base change to `B` is through `B ⊗[A] (I ^ c)`, and the comparison with the honest ideal
`I^c B ⊆ B` is `idealPowerMap`. The kernel of that comparison is annihilated by a power of `I B`,
since each generator `f j` of `I` kills it after raising to the power `c`; the needed power is
produced by `exists_pow_inf_eq_bot_of_le_radical_annihilator` from Noetherianity.

## References

* [Stacks Project, Tag 0EIC](https://stacks.math.columbia.edu/tag/0EIC)
-/

@[expose] public noncomputable section

open TensorProduct

namespace Stacks.ReesAlgebra

universe u v w

/-- The degree-`n` part of the Rees module for a power of an ideal. -/
public abbrev reesModulePiece {A : Type u} {B : Type v} {N : Type w}
    [CommRing A] [CommRing B] [Algebra A B] [AddCommGroup N] [Module B N]
    (I : Ideal A) (c n : ℕ) : Submodule B N :=
  (I.map (algebraMap A B)) ^ (n * c) • ⊤

/-- Multivariate polynomials with coefficients in a module, in monomial coordinates. -/
public abbrev moduleMvPolynomial (r : ℕ) (N : Type w) [AddCommGroup N] :=
  (Fin r →₀ ℕ) →₀ N

private lemma map_pow_eq_top_of_mem_away {A : Type u} [CommRing A]
    (I : Ideal A) (a : A) (ha : a ∈ I) (n : ℕ) :
    Ideal.map (algebraMap A (Localization.Away a)) (I ^ n) = ⊤ := by
  have hnd : ¬ Disjoint (Submonoid.powers a : Set A) ((I ^ n : Ideal A) : Set A) := by
    intro hd
    have h := (Set.disjoint_left.mp hd) (show a ^ n ∈ Submonoid.powers a from ⟨n, rfl⟩)
    exact h (Ideal.pow_mem_pow ha n)
  have hne : ¬ Ideal.map (algebraMap A (Localization.Away a)) (I ^ n) ≠ ⊤ :=
    (Iff.not (IsLocalization.map_algebraMap_ne_top_iff_disjoint
      (Submonoid.powers a) (Localization.Away a) (I ^ n))).mpr hnd
  exact not_ne_iff.mp hne

private lemma exists_pow_smul_eq_bot_of_le_radical_annihilator
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [IsNoetherianRing R] [Module.Finite R M] (J : Ideal R)
    (hJ : J ≤ (Module.annihilator R M).radical) :
    ∃ n : ℕ, (J ^ n) • (⊤ : Submodule R M) = ⊥ := by
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hJ (IsNoetherian.noetherian J)
  refine ⟨n, ?_⟩
  apply Submodule.le_annihilator_iff.mp
  simpa [Submodule.annihilator_top] using hn

private lemma exists_pow_inf_eq_bot_of_le_radical_annihilator
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [IsNoetherianRing R] [Module.Finite R M] (J : Ideal R)
    (K : Submodule R M)
    (hK : J ≤ (Module.annihilator R ↥K).radical) :
    ∃ n : ℕ, (J ^ n) • (⊤ : Submodule R M) ⊓ K = ⊥ := by
  have hfg : K.FG := IsNoetherian.noetherian K
  have _ : Module.Finite R ↥K := Module.Finite.of_fg hfg
  obtain ⟨q, hq⟩ := exists_pow_smul_eq_bot_of_le_radical_annihilator J hK
  have hkill : J ^ q • K = ⊥ := by
    refine eq_bot_iff.mpr (Submodule.smul_le.mpr fun a ha x hx => ?_)
    have hmem : a • (⟨x, hx⟩ : ↥K) ∈ (J ^ q) • (⊤ : Submodule R ↥K) :=
      Submodule.smul_mem_smul ha Submodule.mem_top
    rw [hq] at hmem
    apply (Submodule.mem_bot R).2
    simpa using congrArg Subtype.val ((Submodule.mem_bot R).mp hmem)
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul J K
  refine ⟨k + q, ?_⟩
  rw [hk (k + q) (by omega)]
  refine eq_bot_iff.mpr (Submodule.smul_le.mpr fun a ha x hx => ?_)
  have hmem : a • x ∈ J ^ q • K := Submodule.smul_mem_smul (by simpa using ha) hx.2
  rwa [hkill] at hmem

private def baseChangeToRing {A R M : Type*} [CommRing A] [CommRing R]
    [Algebra A R] [AddCommGroup M] [Module A M] (f : M →ₗ[A] A) :
    (R ⊗[A] M) →ₗ[R] R :=
  (AlgebraTensorModule.rid A R R).toLinearMap.comp (f.baseChange R)

private lemma baseChangeToRing_tmul {A R M : Type*} [CommRing A] [CommRing R]
    [Algebra A R] [AddCommGroup M] [Module A M]
    (f : M →ₗ[A] A) (r : R) (x : M) :
    baseChangeToRing (R := R) f (r ⊗ₜ[A] x) = r * algebraMap A R (f x) := by
  simp [baseChangeToRing, Algebra.smul_def, mul_comm]

private def idealPowerMapRaw {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    (I : Ideal A) (c : ℕ) : (R ⊗[A] (I ^ c : Ideal A)) →ₗ[R] R :=
  baseChangeToRing (Submodule.subtype (I ^ c))

/-- The base-changed inclusion of `I ^ c` sends an elementary tensor to the product of its
factors, read in `R`. -/
private lemma idealPowerMapRaw_tmul {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    (I : Ideal A) (c : ℕ) (r : R) (x : ↥(I ^ c : Ideal A)) :
    idealPowerMapRaw (A := A) (R := R) I c (r ⊗ₜ[A] x) = r * algebraMap A R (x : A) := by
  exact baseChangeToRing_tmul _ r x

private lemma idealPowerMapRaw_range {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) (c : ℕ) :
    (idealPowerMapRaw (A := A) (R := R) I c).range =
      Ideal.map (algebraMap A R) (I ^ c) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    induction x using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simpa using Ideal.add_mem _ hx hy
    | tmul r x =>
        rw [idealPowerMapRaw_tmul I c r x]
        exact Ideal.mul_mem_left _ r (Ideal.mem_map_of_mem (algebraMap A R) x.property)
  · show Ideal.map (algebraMap A R) (I ^ c) ≤ _
    apply Ideal.map_le_iff_le_comap.mpr
    intro x hx
    refine ⟨1 ⊗ₜ[A] ⟨x, hx⟩, ?_⟩
    simp [idealPowerMapRaw_tmul]

private lemma idealPowerMapRaw_smul_eq {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) (c : ℕ) (a : A) (ha : a ^ c ∈ I ^ c)
    (z : R ⊗[A] (I ^ c : Ideal A)) :
    algebraMap A R (a ^ c) • z =
      (idealPowerMapRaw (A := A) (R := R) I c z) • (1 ⊗ₜ[A] ⟨a ^ c, ha⟩) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [smul_add, hx, hy, map_add, add_smul]
  | tmul r x =>
      rw [idealPowerMapRaw_tmul]
      simp only [TensorProduct.smul_tmul']
      calc
        ((algebraMap A R (a ^ c)) • r) ⊗ₜ[A] x =
            ((a ^ c : A) • r) ⊗ₜ[A] x := by
              congr 1
              simp [Algebra.smul_def]
        _ = r ⊗ₜ[A] ((a ^ c) • x) := TensorProduct.smul_tmul (R := A) (R' := A) (a ^ c) r x
        _ = r ⊗ₜ[A] ((x : A) • (⟨a ^ c, ha⟩ : ↥(I ^ c))) := by
              congr 1
              apply Subtype.ext
              simp [smul_eq_mul, mul_comm]
        _ = ((x : A) • r) ⊗ₜ[A] (⟨a ^ c, ha⟩ : ↥(I ^ c)) :=
              (TensorProduct.smul_tmul (R := A) (R' := A) (x : A) r (⟨a ^ c, ha⟩ : ↥(I ^ c))).symm
        _ = ((r * algebraMap A R (x : A)) • 1) ⊗ₜ[A] (⟨a ^ c, ha⟩ : ↥(I ^ c)) := by
              congr 1
              simp [Algebra.smul_def, mul_comm]

private lemma idealPowerMapRaw_ker_le_radical_annihilator
    {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    (I : Ideal A) {r : ℕ} (f : Fin r → A)
    (hf : I = Ideal.span (Set.range f)) (c : ℕ) :
    Ideal.map (algebraMap A R) I ≤
      (Module.annihilator R
        ↥(idealPowerMapRaw (A := A) (R := R) I c).ker).radical := by
  have hmap : Ideal.map (algebraMap A R) I =
      Ideal.span ((algebraMap A R) '' Set.range f) := by
    rw [hf, Ideal.map_span]
  rw [hmap]
  apply Ideal.span_le.mpr
  rintro _ ⟨a, ⟨j, rfl⟩, rfl⟩
  refine (Ideal.mem_radical_iff).2 ⟨c, ?_⟩
  rw [Module.mem_annihilator]
  intro z
  have ha : f j ^ c ∈ I ^ c := Ideal.pow_mem_pow (show f j ∈ I by
    rw [hf]
    exact Ideal.subset_span ⟨j, rfl⟩) c
  have hz : (idealPowerMapRaw (A := A) (R := R) I c) z = 0 := z.property
  have h := idealPowerMapRaw_smul_eq (A := A) (R := R) I c (f j) ha z
  rw [hz] at h
  apply Subtype.ext
  simpa [map_pow] using h

private lemma exists_pow_kernel_smul_inf_eq_bot
    {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    [IsNoetherianRing R] (I : Ideal A) {r : ℕ} (f : Fin r → A)
    (hf : I = Ideal.span (Set.range f)) (c : ℕ)
    [Module.Finite R (R ⊗[A] (I ^ c : Ideal A))] :
    ∃ k : ℕ, ((I.map (algebraMap A R)) ^ k) •
      (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) ⊓
        (idealPowerMapRaw (A := A) (R := R) I c).ker = ⊥ :=
  exists_pow_inf_eq_bot_of_le_radical_annihilator
    (I.map (algebraMap A R)) (idealPowerMapRaw (A := A) (R := R) I c).ker
    (idealPowerMapRaw_ker_le_radical_annihilator (A := A) (R := R) I f hf c)

private def idealPowerMap {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    (I : Ideal A) (c : ℕ) : (R ⊗[A] (I ^ c : Ideal A)) →ₗ[R]
      ↥(I.map (algebraMap A R) ^ c : Ideal R) := by
  let f := idealPowerMapRaw (A := A) (R := R) I c
  refine LinearMap.codRestrict _ f ?_
  intro x
  have hx : f x ∈ (idealPowerMapRaw (A := A) (R := R) I c).range := ⟨x, rfl⟩
  rw [idealPowerMapRaw_range] at hx
  simpa [Ideal.map_pow] using hx

private def tensorPowerRestrict {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) (c k : ℕ) :
    (R ⊗[A] (I ^ (c + k) : Ideal A)) →ₗ[R] (R ⊗[A] (I ^ c : Ideal A)) :=
  (Submodule.inclusion (Ideal.pow_le_pow_right (Nat.le_add_right c k) :
    I ^ (c + k) ≤ I ^ c)).baseChange R

private lemma tensorPowerRestrict_raw_comp {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) (c k : ℕ) :
    (idealPowerMapRaw (A := A) (R := R) I c).comp
        (tensorPowerRestrict (A := A) (R := R) I c k) =
      idealPowerMapRaw (A := A) (R := R) I (c + k) := by
  apply LinearMap.ext
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | tmul r x =>
      simp [tensorPowerRestrict, idealPowerMapRaw_tmul]

private lemma tensorPowerRestrict_range_le_smul {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] (I : Ideal A) (c k : ℕ) :
    LinearMap.range (tensorPowerRestrict (A := A) (R := R) I c k) ≤
      (I.map (algebraMap A R) ^ k) •
        (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) := by
  rintro _ ⟨x, rfl⟩
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simpa using Submodule.add_mem _ hx hy
  | tmul r x =>
      simp only [tensorPowerRestrict, LinearMap.baseChange_tmul]
      have hx : (x : A) ∈ I ^ k * I ^ c := by
        simpa [pow_add, mul_comm] using x.property
      have hmul : I ^ k * I ^ c ≤ I ^ c := Ideal.mul_le_right
      have hmain : ∀ (z : A) (hz : z ∈ I ^ k * I ^ c),
          r ⊗ₜ[A] (⟨z, hmul hz⟩ : ↥(I ^ c : Ideal A)) ∈
            (I.map (algebraMap A R) ^ k) •
              (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) := by
        intro z hz
        refine Submodule.mul_induction_on' (M := I ^ k) (N := I ^ c)
          (C := fun z _ => ∀ hz' : z ∈ I ^ k * I ^ c,
            r ⊗ₜ[A] (⟨z, hmul hz'⟩ : ↥(I ^ c : Ideal A)) ∈
              (I.map (algebraMap A R) ^ k) •
                (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A)))) ?_ ?_ hz hz
        · intro a ha b hb _
          have hsub : (⟨a * b, hmul (Ideal.mul_mem_mul ha hb)⟩ : ↥(I ^ c : Ideal A)) =
              a • (⟨b, hb⟩ : ↥(I ^ c : Ideal A)) := by
            apply Subtype.ext
            simp [smul_eq_mul]
          rw [hsub, TensorProduct.tmul_smul, ← IsScalarTower.algebraMap_smul (R := A) (A := R) a
            (r ⊗ₜ[A] (⟨b, hb⟩ : ↥(I ^ c : Ideal A)))]
          refine Submodule.smul_mem_smul ?_ Submodule.mem_top
          rw [← Ideal.map_pow]
          exact Ideal.mem_map_of_mem (algebraMap A R) ha
        · intro x hx y hy ihx ihy hz'
          have hsub : (⟨x + y, hmul hz'⟩ : ↥(I ^ c : Ideal A)) =
              (⟨x, hmul hx⟩ : ↥(I ^ c : Ideal A)) + ⟨y, hmul hy⟩ := Subtype.ext rfl
          rw [hsub, TensorProduct.tmul_add]
          exact Submodule.add_mem _ (ihx hx) (ihy hy)
      simpa only [Submodule.inclusion_apply] using hmain (x : A) hx

private def descendBaseChangeLinearMap {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) (c k : ℕ)
    (f : (I ^ c : Ideal A) →ₗ[A] A)
    (hkill : (I.map (algebraMap A R) ^ k) •
        (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) ⊓
          (idealPowerMapRaw (A := A) (R := R) I c).ker = ⊥) :
    LinearMap.range (idealPowerMapRaw (A := A) (R := R) I (c + k)) →ₗ[R] R := by
  let rawHi := idealPowerMapRaw (A := A) (R := R) I (c + k)
  let hi := (baseChangeToRing (R := R) f).comp
    (tensorPowerRestrict (A := A) (R := R) I c k)
  have hker : rawHi.ker ≤ hi.ker := by
    intro z hz
    have hHi : rawHi z = 0 := hz
    have hLo : idealPowerMapRaw (A := A) (R := R) I c
        (tensorPowerRestrict (A := A) (R := R) I c k z) = 0 := by
      change ((idealPowerMapRaw (A := A) (R := R) I c).comp
        (tensorPowerRestrict (A := A) (R := R) I c k)) z = 0
      rw [tensorPowerRestrict_raw_comp (A := A) (R := R) I c k]
      exact hHi
    have hRange : tensorPowerRestrict (A := A) (R := R) I c k z ∈
        (I.map (algebraMap A R) ^ k) •
          (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) :=
      tensorPowerRestrict_range_le_smul (A := A) (R := R) I c k ⟨z, rfl⟩
    have hInter : tensorPowerRestrict (A := A) (R := R) I c k z ∈
        (I.map (algebraMap A R) ^ k) •
          (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) ⊓
            (idealPowerMapRaw (A := A) (R := R) I c).ker := ⟨hRange, hLo⟩
    have hZero : tensorPowerRestrict (A := A) (R := R) I c k z = 0 := by
      apply (Submodule.mem_bot R).mp
      simpa [hkill] using hInter
    change hi z = 0
    simp [hi, hZero]
  exact (LinearMap.ker rawHi).liftQ hi hker |>.comp rawHi.quotKerEquivRange.symm.toLinearMap

private lemma descendBaseChangeLinearMap_apply {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] (I : Ideal A) (c k : ℕ)
    (f : (I ^ c : Ideal A) →ₗ[A] A)
    (hkill : (I.map (algebraMap A R) ^ k) •
        (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) ⊓
          (idealPowerMapRaw (A := A) (R := R) I c).ker = ⊥)
    (z : R ⊗[A] (I ^ (c + k) : Ideal A)) :
    descendBaseChangeLinearMap I c k f hkill
        ⟨idealPowerMapRaw (A := A) (R := R) I (c + k) z, ⟨z, rfl⟩⟩ =
    baseChangeToRing (R := R) f
        (tensorPowerRestrict (A := A) (R := R) I c k z) := by
  classical
  dsimp [descendBaseChangeLinearMap]
  rw [LinearMap.quotKerEquivRange_symm_apply_image
    (f := idealPowerMapRaw (A := A) (R := R) I (c + k)) z ⟨z, rfl⟩]
  simp only [Submodule.mkQ_apply, Submodule.liftQ_apply, LinearMap.comp_apply]

private def descendBaseChangeLinearMapIdeal {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] (I : Ideal A) (c k : ℕ)
    (f : (I ^ c : Ideal A) →ₗ[A] A)
    (hkill : (I.map (algebraMap A R) ^ k) •
        (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) ⊓
          (idealPowerMapRaw (A := A) (R := R) I c).ker = ⊥) :
    ((I.map (algebraMap A R)) ^ (c + k) : Ideal R) →ₗ[R] R := by
  let e : LinearMap.range (idealPowerMapRaw (A := A) (R := R) I (c + k)) ≃ₗ[R]
      ((I.map (algebraMap A R)) ^ (c + k) : Ideal R) :=
    LinearEquiv.ofEq _ _ (by rw [idealPowerMapRaw_range, Ideal.map_pow])
  exact (descendBaseChangeLinearMap I c k f hkill).comp e.symm.toLinearMap

private lemma descendBaseChangeLinearMapIdeal_apply {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] (I : Ideal A) (c k : ℕ)
    (f : (I ^ c : Ideal A) →ₗ[A] A)
    (hkill : (I.map (algebraMap A R) ^ k) •
        (⊤ : Submodule R (R ⊗[A] (I ^ c : Ideal A))) ⊓
          (idealPowerMapRaw (A := A) (R := R) I c).ker = ⊥)
    (z : R ⊗[A] (I ^ (c + k) : Ideal A)) :
    descendBaseChangeLinearMapIdeal I c k f hkill
        ⟨idealPowerMapRaw (A := A) (R := R) I (c + k) z, by
          rw [← Ideal.map_pow, ← idealPowerMapRaw_range]
          exact ⟨z, rfl⟩⟩ =
      baseChangeToRing (R := R) f
        (tensorPowerRestrict (A := A) (R := R) I c k z) :=
  descendBaseChangeLinearMap_apply I c k f hkill z

private lemma baseChangeToRing_sum_eq {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) (c : ℕ) {r : ℕ} (f : Fin r → A)
    (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    (hφ : ∀ x : (I ^ c : Ideal A), (∑ j, f j * φ j x) = (x : A))
    (z : R ⊗[A] (I ^ c : Ideal A)) :
    (∑ j, algebraMap A R (f j) * baseChangeToRing (R := R) (φ j) z) =
      idealPowerMapRaw (A := A) (R := R) I c z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add z w hz hw =>
      simp only [LinearMap.map_add, mul_add, Finset.sum_add_distrib, hz, hw,
        (idealPowerMapRaw (A := A) (R := R) I c).map_add]
  | tmul r x =>
      simp only [baseChangeToRing_tmul]
      calc
        (∑ j, algebraMap A R (f j) *
              (r * algebraMap A R (φ j x))) =
            r * ∑ j, algebraMap A R (f j) * algebraMap A R (φ j x) := by
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun j _ => by ring
        _ = r * algebraMap A R (∑ j, f j * φ j x) := by
              congr 1
              rw [map_sum (algebraMap A R) (fun j => f j * φ j x) Finset.univ]
              apply Finset.sum_congr rfl
              intro j hj
              rw [map_mul]
        _ = r * algebraMap A R (x : A) := by rw [hφ x]
        _ = idealPowerMapRaw (A := A) (R := R) I c (r ⊗ₜ[A] x) :=
              (idealPowerMapRaw_tmul I c r x).symm

/-- The image of an element of `I ^ c` lies in the `c`-th power of the extended ideal. -/
private lemma algebraMap_mem_map_pow {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    (I : Ideal A) (c : ℕ) {g : A} (hg : g ∈ I ^ c) :
    algebraMap A R g ∈ I.map (algebraMap A R) ^ c :=
  Ideal.map_pow (algebraMap A R) I c ▸ Ideal.mem_map_of_mem (algebraMap A R) hg

private lemma exists_baseChanged_splitting {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] [IsNoetherianRing R]
    (I : Ideal A) {r : ℕ} (f : Fin r → A)
    (hf : I = Ideal.span (Set.range f)) (c : ℕ)
    (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    (hφ : ∀ x : (I ^ c : Ideal A), (∑ j, f j * φ j x) = (x : A))
    [Module.Finite R (R ⊗[A] (I ^ c : Ideal A))] :
    ∃ k : ℕ, ∃ ψ : Fin r → ((I.map (algebraMap A R)) ^ (c + k) : Ideal R) →ₗ[R] R,
      (∀ x : ((I.map (algebraMap A R)) ^ (c + k) : Ideal R),
        (∑ j, algebraMap A R (f j) * ψ j x) = (x : R)) ∧
      (∀ j (g : (I ^ (c + k) : Ideal A)),
        ψ j ⟨algebraMap A R (g : A), algebraMap_mem_map_pow I _ g.property⟩ =
            algebraMap A R
              (φ j ⟨g, Ideal.pow_le_pow_right (Nat.le_add_right c k) g.property⟩)) := by
  obtain ⟨k, hkill⟩ := exists_pow_kernel_smul_inf_eq_bot
    (A := A) (R := R) I f hf c
  let ψ : Fin r → ((I.map (algebraMap A R)) ^ (c + k) : Ideal R) →ₗ[R] R :=
    fun j => descendBaseChangeLinearMapIdeal I c k (φ j) hkill
  refine ⟨k, ψ, ?_, ?_⟩
  · rintro ⟨x, hx⟩
    obtain ⟨z, rfl⟩ : x ∈ LinearMap.range (idealPowerMapRaw (A := A) (R := R) I (c + k)) := by
      rwa [idealPowerMapRaw_range, Ideal.map_pow]
    calc
      _ = ∑ j, algebraMap A R (f j) *
            baseChangeToRing (R := R) (φ j)
              (tensorPowerRestrict (A := A) (R := R) I c k z) :=
            Finset.sum_congr rfl fun j _ => by
              rw [show ψ j ⟨_, hx⟩ = _ from
                descendBaseChangeLinearMapIdeal_apply I c k (φ j) hkill z]
      _ = idealPowerMapRaw (A := A) (R := R) I c
            (tensorPowerRestrict (A := A) (R := R) I c k z) :=
              baseChangeToRing_sum_eq I c f φ hφ
                (tensorPowerRestrict (A := A) (R := R) I c k z)
      _ = idealPowerMapRaw (A := A) (R := R) I (c + k) z :=
            LinearMap.congr_fun (tensorPowerRestrict_raw_comp (A := A) (R := R) I c k) z
  · intro j g
    let z : R ⊗[A] (I ^ (c + k) : Ideal A) := 1 ⊗ₜ[A] g
    let y : ((I.map (algebraMap A R)) ^ (c + k) : Ideal R) :=
      ⟨algebraMap A R (g : A), algebraMap_mem_map_pow I _ g.property⟩
    have hraw : idealPowerMapRaw (A := A) (R := R) I (c + k) z =
        algebraMap A R (g : A) := by
      simp [z, idealPowerMapRaw_tmul]
    have hy : y = ⟨idealPowerMapRaw (A := A) (R := R) I (c + k) z,
        by
          rw [← Ideal.map_pow, ← idealPowerMapRaw_range]
          exact ⟨z, rfl⟩⟩ := Subtype.ext hraw.symm
    show (descendBaseChangeLinearMapIdeal I c k (φ j) hkill) y = _
    rw [hy, descendBaseChangeLinearMapIdeal_apply I c k (φ j) hkill z]
    have htensor : tensorPowerRestrict (A := A) (R := R) I c k z =
        1 ⊗ₜ[A] (⟨(g : A), Ideal.pow_le_pow_right (Nat.le_add_right c k) g.property⟩ :
          (I ^ c : Ideal A)) := by
      simp only [z, tensorPowerRestrict, LinearMap.baseChange_tmul]
      congr 1
    rw [htensor, baseChangeToRing_tmul]
    simp

private lemma tensor_ideal_power_finite {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] (I : Ideal A) (hI : I.FG) (c : ℕ) :
    Module.Finite R (R ⊗[A] (I ^ c : Ideal A)) := by
  have _ : Module.Finite A (I ^ c : Ideal A) := Module.Finite.of_fg (Ideal.FG.pow hI)
  infer_instance

private def polynomialSnd {B N : Type*} [CommRing B] [AddCommGroup N]
    [Module B N] [Module Bᵐᵒᵖ N] [IsCentralScalar B N]
    [SMulCommClass B Bᵐᵒᵖ N] (r : ℕ) :
    MvPolynomial (Fin r) (TrivSqZeroExt B N) →ₗ[B] moduleMvPolynomial r N :=
  (Finsupp.mapRange.linearMap (α := Fin r →₀ ℕ)
      (TrivSqZeroExt.sndHom B N)).comp
    (AddMonoidAlgebra.coeffLinearEquiv B).toLinearMap

private def mapReesAlgebra {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (J : Ideal A) (K : Ideal R)
    (h : ∀ n, Ideal.map (algebraMap A R) (J ^ n) ≤ K ^ n) :
    reesAlgebra J →ₐ[A] reesAlgebra K := {
  toFun := fun p => ⟨Polynomial.map (algebraMap A R) p.1, fun n => by
    rw [Polynomial.coeff_map]
    exact h n (Ideal.mem_map_of_mem (algebraMap A R) (p.2 n))⟩
  map_one' := by ext n; simp
  map_mul' := fun _ _ => Subtype.ext (by simp)
  map_zero' := by ext n; simp
  map_add' := fun _ _ => Subtype.ext (by simp)
  commutes' := fun _ => Subtype.ext (by simp)
}

private lemma map_pow_pow_le {A R : Type*} [CommRing A] [CommRing R] [Algebra A R]
    (I : Ideal A) (c q : ℕ) :
    Ideal.map (algebraMap A R) ((I ^ c) ^ q) ≤ (I.map (algebraMap A R) ^ c) ^ q := by
  rw [Ideal.map_pow, Ideal.map_pow]

private lemma extendLinearMaps_mapReesAlgebra_degreeOne {A R : Type*} [CommRing A]
    [CommRing R] [Algebra A R] (I : Ideal A) {r : ℕ} (c : ℕ)
    (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    (ψ : Fin r → (I.map (algebraMap A R) ^ c : Ideal R) →ₗ[R] R)
    (hψ : ∀ j (g : (I ^ c : Ideal A)),
      ψ j ⟨algebraMap A R g, algebraMap_mem_map_pow I c g.property⟩ = algebraMap A R (φ j g))
    (a : A) (ha : a ∈ I ^ c) :
    extendLinearMaps (I.map (algebraMap A R) ^ c) ψ
        (mapReesAlgebra (I ^ c) _ (map_pow_pow_le I c) (degreeOne (I ^ c) ⟨a, ha⟩)) =
      MvPolynomial.mapAlgHom (Algebra.ofId A R)
        (extendLinearMaps (I ^ c) φ (degreeOne (I ^ c) ⟨a, ha⟩)) := by
  have hinc : mapReesAlgebra (I ^ c) _ (map_pow_pow_le I c) (degreeOne (I ^ c) ⟨a, ha⟩) =
      degreeOne (I.map (algebraMap A R) ^ c) ⟨algebraMap A R a, algebraMap_mem_map_pow I c ha⟩ := by
    apply Subtype.ext
    simp [mapReesAlgebra, degreeOne]
  rw [hinc, extendLinearMaps_degreeOne, extendLinearMaps_degreeOne, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hψ j ⟨a, ha⟩]
  simp

private lemma extendLinearMaps_mapReesAlgebra {A R : Type*} [CommRing A] [CommRing R]
    [Algebra A R] (I : Ideal A) {r : ℕ} (c : ℕ) (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    (ψ : Fin r → (I.map (algebraMap A R) ^ c : Ideal R) →ₗ[R] R)
    (hψ : ∀ j (g : (I ^ c : Ideal A)),
      ψ j ⟨algebraMap A R g, algebraMap_mem_map_pow I c g.property⟩ = algebraMap A R (φ j g))
    (p : reesAlgebra (I ^ c)) :
    extendLinearMaps (I.map (algebraMap A R) ^ c) ψ
        (mapReesAlgebra (I ^ c) _ (map_pow_pow_le I c) p) =
      MvPolynomial.mapAlgHom (Algebra.ofId A R) (extendLinearMaps (I ^ c) φ p) := by
  let inc := mapReesAlgebra (I ^ c) _ (map_pow_pow_le (R := R) I c)
  let extR := extendLinearMaps (I.map (algebraMap A R) ^ c) ψ
  let F : reesAlgebra (I ^ c) →ₐ[A] MvPolynomial (Fin r) R := {
    toRingHom := extR.toRingHom.comp inc.toRingHom
    commutes' := by
      intro a
      calc
        extR (inc (algebraMap A (reesAlgebra (I ^ c)) a)) =
            extR (algebraMap R (reesAlgebra (I.map (algebraMap A R) ^ c))
              (algebraMap A R a)) := congrArg extR (inc.commutes' a)
        _ = algebraMap R (MvPolynomial (Fin r) R) (algebraMap A R a) :=
          extR.commutes _
        _ = algebraMap A (MvPolynomial (Fin r) R) a := by simp
  }
  have hFG : F = (MvPolynomial.mapAlgHom (Algebra.ofId A R)).comp (extendLinearMaps (I ^ c) φ) := by
    apply AlgHom.ext_of_eq_adjoin (adjoin_monomial_eq_reesAlgebra (I ^ c)).symm
    intro z hz
    obtain ⟨a, ha, hza⟩ := Submodule.mem_map.mp hz
    have hdegree :
        (⟨z, (adjoin_monomial_eq_reesAlgebra (I ^ c)).symm.ge
          (Algebra.subset_adjoin hz)⟩ : reesAlgebra (I ^ c)) = degreeOne (I ^ c) ⟨a, ha⟩ := by
      apply Subtype.ext
      simpa [degreeOne] using hza.symm
    rw [hdegree]
    exact extendLinearMaps_mapReesAlgebra_degreeOne I c φ ψ hψ a ha
  exact DFunLike.congr_fun hFG p

private lemma reesModulePiece_linearMap_ext {A B N M : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [AddCommGroup N] [Module B N] [AddCommGroup M] [Module B M]
    (I : Ideal A) (c n : ℕ) {Ψ₁ Ψ₂ : reesModulePiece (B := B) (N := N) I c n →ₗ[B] M}
    (h : ∀ a ∈ I ^ (n * c), ∀ (z : N)
      (hz : algebraMap A B a • z ∈ reesModulePiece (B := B) (N := N) I c n),
        Ψ₁ ⟨_, hz⟩ = Ψ₂ ⟨_, hz⟩) :
    Ψ₁ = Ψ₂ := by
  refine LinearMap.ext fun y => ?_
  let J : Ideal B := I.map (algebraMap A B)
  let K : Ideal A := I ^ (n * c)
  have hmapPow : Ideal.map (algebraMap A B) K = J ^ (n * c) := Ideal.map_pow _ _ _
  let spanSet : Set B := (algebraMap A B) '' (K : Set A)
  let pieceVal (b : B) (hb : b ∈ Submodule.span B spanSet) (z : N) :=
    (⟨b • z, by
      show b • z ∈ J ^ (n * c) • (⊤ : Submodule B N)
      exact Submodule.smul_mem_smul (by rwa [← hmapPow]) Submodule.mem_top⟩ :
        reesModulePiece (B := B) (N := N) I c n)
  have hspan : ∀ (b : B) (hb : b ∈ Submodule.span B spanSet) (z : N),
      Ψ₁ (pieceVal b hb z) = Ψ₂ (pieceVal b hb z) := by
    intro b hb
    induction hb using Submodule.span_induction with
    | mem b hb =>
        obtain ⟨a, ha, rfl⟩ := hb
        exact fun z => h a ha z _
    | zero =>
        intro z
        have hz : pieceVal 0 (Submodule.zero_mem _) z = 0 := Subtype.ext (zero_smul B z)
        simp [hz]
    | add b₁ b₂ hb₁ hb₂ ih₁ ih₂ =>
        intro z
        have hsum := Submodule.add_mem (Submodule.span B spanSet) hb₁ hb₂
        have heq : pieceVal (b₁ + b₂) hsum z =
            pieceVal b₁ hb₁ z + pieceVal b₂ hb₂ z := Subtype.ext (add_smul b₁ b₂ z)
        rw [heq, Ψ₁.map_add, Ψ₂.map_add, ih₁ z, ih₂ z]
    | smul a b hb ih =>
        intro z
        have hsmem := Submodule.smul_mem (Submodule.span B spanSet) a hb
        have heq : pieceVal (a • b) hsmem z = pieceVal b hb (a • z) :=
          Subtype.ext ((mul_smul a b z).trans (smul_comm a b z))
        rw [heq]
        exact ih (a • z)
  have hscalar : ∀ (b : B) (hb : b ∈ J ^ (n * c)) (z : N),
      Ψ₁ ⟨b • z, Submodule.smul_mem_smul hb (Submodule.mem_top : z ∈ (⊤ : Submodule B N))⟩ =
        Ψ₂ ⟨b • z, Submodule.smul_mem_smul hb (Submodule.mem_top : z ∈ (⊤ : Submodule B N))⟩ := by
    intro b hb z
    have hbpre : b ∈ Ideal.map (algebraMap A B) K := hmapPow ▸ hb
    have hbspan : b ∈ Submodule.span B spanSet := by
      simpa [Ideal.map, spanSet] using hbpre
    have heq : pieceVal b hbspan z =
        ⟨b • z, Submodule.smul_mem_smul hb (Submodule.mem_top : z ∈ ⊤)⟩ := Subtype.ext rfl
    rw [← heq]
    exact hspan b hbspan z
  refine Submodule.smul_induction_on'
    (p := fun z hz => Ψ₁ ⟨z, hz⟩ = Ψ₂ ⟨z, hz⟩) y.property ?_ ?_
  · exact fun b hb z _ => hscalar b hb z
  · intro y₁ hy₁ y₂ hy₂ hy₁' hy₂'
    have heq : (⟨y₁ + y₂, Submodule.add_mem _ hy₁ hy₂⟩ : reesModulePiece (B := B) (N := N) I c n) =
        (⟨y₁, hy₁⟩ : reesModulePiece (B := B) (N := N) I c n) + ⟨y₂, hy₂⟩ := Subtype.ext rfl
    rw [heq, Ψ₁.map_add, Ψ₂.map_add, hy₁', hy₂']

private lemma reesModulePiece_linearMap_ext_of_formula {A B N : Type*} [CommRing A]
    [CommRing B] [Algebra A B] [AddCommGroup N] [Module B N] (I : Ideal A) {r : ℕ} (c n : ℕ)
    (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    {Ψ₁ Ψ₂ : reesModulePiece (B := B) (N := N) I c n →ₗ[B] moduleMvPolynomial r N}
    (h₁ : ∀ (p : reesAlgebra (I ^ c)) (_hp : ∀ k : ℕ, k ≠ n → (p : Polynomial A).coeff k = 0)
      (x : N) (hx : (algebraMap A B ((p : Polynomial A).coeff n)) • x ∈
        reesModulePiece (B := B) (N := N) I c n) (m : Fin r →₀ ℕ),
      (Ψ₁ ⟨_, hx⟩) m = (algebraMap A B ((extendLinearMaps (I ^ c) φ p).coeff m)) • x)
    (h₂ : ∀ (p : reesAlgebra (I ^ c)) (_hp : ∀ k : ℕ, k ≠ n → (p : Polynomial A).coeff k = 0)
      (x : N) (hx : (algebraMap A B ((p : Polynomial A).coeff n)) • x ∈
        reesModulePiece (B := B) (N := N) I c n) (m : Fin r →₀ ℕ),
      (Ψ₂ ⟨_, hx⟩) m = (algebraMap A B ((extendLinearMaps (I ^ c) φ p).coeff m)) • x) :
    Ψ₁ = Ψ₂ := by
  refine reesModulePiece_linearMap_ext I c n fun a ha z hz => ?_
  have haPow : a ∈ (I ^ c : Ideal A) ^ n := by rwa [← pow_mul, Nat.mul_comm]
  let p : reesAlgebra (I ^ c) :=
    ⟨Polynomial.monomial n a, reesAlgebra.monomial_mem.mpr haPow⟩
  have hp : ∀ k : ℕ, k ≠ n → (p : Polynomial A).coeff k = 0 := by
    intro k hkn
    simp [p, Polynomial.coeff_monomial, Ne.symm hkn]
  have hpval : (p : Polynomial A).coeff n = a := by simp [p]
  have hmem : (algebraMap A B ((p : Polynomial A).coeff n)) • z ∈
      reesModulePiece (B := B) (N := N) I c n := by rwa [hpval]
  have hinput : (⟨algebraMap A B a • z, hz⟩ : reesModulePiece (B := B) (N := N) I c n) =
      ⟨(algebraMap A B ((p : Polynomial A).coeff n)) • z, hmem⟩ :=
    Subtype.ext (by simp only [hpval])
  rw [hinput]
  ext m
  rw [h₁ p hp z hmem m, h₂ p hp z hmem m]

private lemma sum_polynomialSnd_smul_eq_snd_eval {B N : Type*} [CommRing B] [AddCommGroup N]
    [Module B N] [Module Bᵐᵒᵖ N] [IsCentralScalar B N] [SMulCommClass B Bᵐᵒᵖ N] {r : ℕ}
    (fB : Fin r → B) (v : MvPolynomial (Fin r) (TrivSqZeroExt B N)) :
    ∑ m ∈ (polynomialSnd (B := B) (N := N) r v).support,
        (∏ j, fB j ^ m j) • polynomialSnd (B := B) (N := N) r v m =
      (MvPolynomial.eval (fun j => algebraMap B (TrivSqZeroExt B N) (fB j)) v).snd := by
  classical
  set P := polynomialSnd (B := B) (N := N) r v
  have hcoeff : ∀ m, P m = (v.coeff m).snd := fun _ => rfl
  have hsupport : P.support ⊆ v.support := by
    intro m hm
    by_contra hmv
    have hv0 : v.coeff m = 0 := by
      simpa [MvPolynomial.mem_support_iff] using hmv
    exact (Finsupp.mem_support_iff.mp hm) (by simp [hcoeff m, hv0])
  have hterm (m : Fin r →₀ ℕ) :
      (v.coeff m * ∏ j, (algebraMap B (TrivSqZeroExt B N) (fB j)) ^ m j).snd =
        (∏ j, fB j ^ m j) • P m := by
    have hprod : ∏ j, (algebraMap B (TrivSqZeroExt B N) (fB j)) ^ m j =
        algebraMap B (TrivSqZeroExt B N) (∏ j, fB j ^ m j) := by
      simp only [map_prod, map_pow]
    have hAlgB (b : B) : algebraMap B (TrivSqZeroExt B N) b = TrivSqZeroExt.inl b := rfl
    rw [hprod, hAlgB, TrivSqZeroExt.snd_mul]
    simp only [TrivSqZeroExt.fst_inl, TrivSqZeroExt.snd_inl, smul_zero, zero_add]
    rw [IsCentralScalar.op_smul_eq_smul, ← hcoeff m]
  rw [MvPolynomial.eval_eq']
  show _ = TrivSqZeroExt.sndHom B N
    (∑ m ∈ v.support, v.coeff m * ∏ j, (algebraMap B (TrivSqZeroExt B N) (fB j)) ^ m j)
  rw [map_sum, Finset.sum_subset hsupport]
  · exact Finset.sum_congr rfl fun m _ => (hterm m).symm
  · intro m hm hnot
    have hP0 : P m = 0 := by
      simpa [Finsupp.mem_support_iff] using hnot
    rw [hP0, smul_zero]

section TrivSqZeroExt

variable {A B N : Type*} [CommRing A] [CommRing B] [Algebra A B] [AddCommGroup N] [Module B N]
  [Module Bᵐᵒᵖ N] [IsCentralScalar B N] [SMulCommClass B Bᵐᵒᵖ N]
  [Algebra A (TrivSqZeroExt B N)] [IsScalarTower A B (TrivSqZeroExt B N)]

local notation "𝓡" => TrivSqZeroExt B N

private lemma inr_mem_map_pow (I : Ideal A) (m : ℕ) {y : N}
    (hy : y ∈ I.map (algebraMap A B) ^ m • (⊤ : Submodule B N)) :
    TrivSqZeroExt.inr y ∈ I.map (algebraMap A 𝓡) ^ m := by
  have hJL : (I.map (algebraMap A B)).map (algebraMap B 𝓡) = I.map (algebraMap A 𝓡) := by
    rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  refine Submodule.smul_induction_on hy ?_ ?_
  · intro b hb x hx
    have hbR : algebraMap B 𝓡 b ∈ I.map (algebraMap A 𝓡) ^ m := by
      simpa only [Ideal.map_pow, hJL] using Ideal.mem_map_of_mem (algebraMap B 𝓡) hb
    rw [TrivSqZeroExt.inr_smul, Algebra.smul_def]
    exact (I.map (algebraMap A 𝓡) ^ m).mul_mem_right _ hbR
  · intro y z hy hz
    simpa using Ideal.add_mem _ hy hz

private def reesFromPiece (I : Ideal A) (c n : ℕ) :
    reesModulePiece (B := B) (N := N) I c n →ₗ[B] reesAlgebra (I.map (algebraMap A 𝓡) ^ c) := by
  let q : reesModulePiece (B := B) (N := N) I c n →ₗ[B] Polynomial 𝓡 := {
    toFun := fun y => Polynomial.monomial n (TrivSqZeroExt.inr (y : N))
    map_add' := by intro x y; simp
    map_smul' := by
      intro b y
      calc
        Polynomial.monomial n (TrivSqZeroExt.inr (b • (y : N))) =
            Polynomial.monomial n (algebraMap B 𝓡 b • TrivSqZeroExt.inr (y : N)) := by
              rw [TrivSqZeroExt.inr_smul,
                ← IsScalarTower.algebraMap_smul (R := B) (A := 𝓡) b (TrivSqZeroExt.inr (y : N))]
        _ = algebraMap B 𝓡 b • Polynomial.monomial n (TrivSqZeroExt.inr (y : N)) :=
              (Polynomial.monomial n).map_smul _ _
        _ = b • Polynomial.monomial n (TrivSqZeroExt.inr (y : N)) := by
              rw [IsScalarTower.algebraMap_smul]
  }
  let S : Submodule B (Polynomial 𝓡) :=
    (reesAlgebra (I.map (algebraMap A 𝓡) ^ c)).toSubmodule.restrictScalars B
  refine LinearMap.codRestrict S q fun y => reesAlgebra.monomial_mem.mpr ?_
  rw [← pow_mul, Nat.mul_comm]
  exact inr_mem_map_pow I (n * c) y.property

private lemma reesFromPiece_val (I : Ideal A) (c n : ℕ)
    (y : reesModulePiece (B := B) (N := N) I c n) :
    (reesFromPiece I c n y : Polynomial 𝓡) = Polynomial.monomial n (TrivSqZeroExt.inr (y : N)) :=
  rfl

private def moduleExtension (I : Ideal A) {r : ℕ} (c : ℕ)
    (ψ : Fin r → (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡) →ₗ[𝓡] 𝓡) (n : ℕ) :
    reesModulePiece (B := B) (N := N) I c n →ₗ[B] moduleMvPolynomial r N :=
  (polynomialSnd (B := B) (N := N) r).comp
    (((extendLinearMaps (I.map (algebraMap A 𝓡) ^ c) ψ).toLinearMap.restrictScalars B).comp
      (reesFromPiece I c n))

private lemma moduleExtension_apply_of_ne (I : Ideal A) {r : ℕ} (c : ℕ)
    (ψ : Fin r → (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡) →ₗ[𝓡] 𝓡) {n : ℕ}
    (y : reesModulePiece (B := B) (N := N) I c n) {m : Fin r →₀ ℕ}
    (hmn : (m.sum fun _ e => e) ≠ n) : moduleExtension I c ψ n y m = 0 := by
  have hhom := extendLinearMaps_homogeneous _ ψ n (reesFromPiece I c n y) fun k hkn => by
    rw [reesFromPiece_val]
    simp [Polynomial.coeff_monomial, Ne.symm hkn]
  show TrivSqZeroExt.snd ((extendLinearMaps _ ψ (reesFromPiece I c n y)).coeff m) = 0
  rw [hhom.coeff_eq_zero (show Finsupp.degree m ≠ n from hmn)]
  rfl

private lemma moduleExtension_smul_apply (I : Ideal A) {r : ℕ} (c : ℕ)
    (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    (ψ : Fin r → (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡) →ₗ[𝓡] 𝓡)
    (hψ : ∀ j (g : (I ^ c : Ideal A)),
      ψ j ⟨algebraMap A 𝓡 g, algebraMap_mem_map_pow I c g.property⟩ = algebraMap A 𝓡 (φ j g))
    (n : ℕ) (p : reesAlgebra (I ^ c))
    (hp : ∀ k : ℕ, k ≠ n → (p : Polynomial A).coeff k = 0) (x : N)
    (hx : (algebraMap A B ((p : Polynomial A).coeff n)) • x ∈
      reesModulePiece (B := B) (N := N) I c n) (m : Fin r →₀ ℕ) :
    moduleExtension I c ψ n ⟨_, hx⟩ m =
      (algebraMap A B ((extendLinearMaps (I ^ c) φ p).coeff m)) • x := by
  have hpEq : (p : Polynomial A) = Polynomial.monomial n ((p : Polynomial A).coeff n) := by
    ext q
    by_cases hqn : q = n
    · subst q
      simp
    · rw [Polynomial.coeff_monomial, ite_eq_right (Ne.symm hqn)]
      exact hp q hqn
  have hsource : reesFromPiece I c n ⟨_, hx⟩ =
      mapReesAlgebra (I ^ c) _ (map_pow_pow_le I c) p *
        algebraMap 𝓡 (reesAlgebra (I.map (algebraMap A 𝓡) ^ c)) (TrivSqZeroExt.inr x) := by
    apply Subtype.ext
    show Polynomial.monomial n
        (TrivSqZeroExt.inr (algebraMap A B ((p : Polynomial A).coeff n) • x)) =
      Polynomial.map (algebraMap A 𝓡) (p : Polynomial A) * Polynomial.C (TrivSqZeroExt.inr x)
    rw [hpEq]
    simp [Algebra.smul_def, TrivSqZeroExt.inr_smul, IsScalarTower.algebraMap_apply A B 𝓡,
      mul_comm]
  show TrivSqZeroExt.snd ((extendLinearMaps _ ψ (reesFromPiece I c n ⟨_, hx⟩)).coeff m) = _
  rw [hsource, map_mul, AlgHom.commutes, extendLinearMaps_mapReesAlgebra I c φ ψ hψ p,
    show algebraMap 𝓡 (MvPolynomial (Fin r) 𝓡) (TrivSqZeroExt.inr x) =
      MvPolynomial.C (TrivSqZeroExt.inr x) by simp,
    mul_comm (MvPolynomial.mapAlgHom _ _), MvPolynomial.coeff_C_mul]
  simp only [MvPolynomial.mapAlgHom_apply, Algebra.toRingHom_ofId, MvPolynomial.coeff_map,
    TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_inr, zero_smul, TrivSqZeroExt.snd_inr,
    op_smul_eq_smul, zero_add]
  have hfst (a : A) : (algebraMap A 𝓡 a).fst = algebraMap A B a :=
    (congrArg TrivSqZeroExt.fst (IsScalarTower.algebraMap_apply A B 𝓡 a)).trans rfl
  rw [hfst]

private lemma eval_extendLinearMaps_reesFromPiece (I : Ideal A) {r : ℕ} (c : ℕ) (f : Fin r → A)
    (hfR : ∀ j, algebraMap A 𝓡 (f j) ∈ I.map (algebraMap A 𝓡))
    (ψ : Fin r → (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡) →ₗ[𝓡] 𝓡)
    (hψ : ∀ x : (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡),
      (∑ j, algebraMap A 𝓡 (f j) * ψ j x) = (x : 𝓡))
    {n : ℕ} (y : reesModulePiece (B := B) (N := N) I c n) :
    MvPolynomial.eval (fun j => algebraMap A 𝓡 (f j))
        (extendLinearMaps (I.map (algebraMap A 𝓡) ^ c) ψ (reesFromPiece I c n y)) =
      TrivSqZeroExt.inr (y : N) := by
  let L := I.map (algebraMap A 𝓡)
  let q := reesFromPiece I c n y
  let v := extendLinearMaps (L ^ c) ψ q
  let fR : Fin r → 𝓡 := fun j => algebraMap A 𝓡 (f j)
  let evalRees : reesAlgebra L →ₐ[𝓡] 𝓡 := {
    toRingHom := (Polynomial.evalRingHom (1 : 𝓡)).comp (Subalgebra.val (reesAlgebra L)).toRingHom
    commutes' := by intro a; simp [RingHom.comp_apply] }
  have hDegree : ∀ j, evalRees (degreeOne L ⟨fR j, hfR j⟩) = fR j := by
    intro j
    simp [evalRees, degreeOne, Polynomial.eval_monomial]
  calc
    MvPolynomial.eval fR v =
        evalRees (MvPolynomial.aeval (fun j => degreeOne L ⟨fR j, hfR j⟩) v) := by
      rw [MvPolynomial.comp_aeval_apply]
      simp [hDegree, MvPolynomial.aeval_eq_eval]
    _ = Polynomial.eval (1 : 𝓡) (q : Polynomial 𝓡) :=
        congrArg (Polynomial.eval (1 : 𝓡)) (aeval_extendLinearMaps_eq (I := L) c fR hfR ψ hψ q)
    _ = TrivSqZeroExt.inr (y : N) := by simp [q, reesFromPiece_val]

private lemma sum_moduleExtension (I : Ideal A) {r : ℕ} (c : ℕ) (f : Fin r → A)
    (hfR : ∀ j, algebraMap A 𝓡 (f j) ∈ I.map (algebraMap A 𝓡))
    (ψ : Fin r → (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡) →ₗ[𝓡] 𝓡)
    (hψ : ∀ x : (I.map (algebraMap A 𝓡) ^ c : Ideal 𝓡),
      (∑ j, algebraMap A 𝓡 (f j) * ψ j x) = (x : 𝓡))
    {n : ℕ} (y : reesModulePiece (B := B) (N := N) I c n) :
    ∑ m ∈ (moduleExtension I c ψ n y).support,
      (∏ j, (algebraMap A B (f j)) ^ m j) • (moduleExtension I c ψ n y) m = (y : N) := by
  have h := sum_polynomialSnd_smul_eq_snd_eval (B := B) (N := N) (fun j => algebraMap A B (f j))
    (extendLinearMaps (I.map (algebraMap A 𝓡) ^ c) ψ (reesFromPiece I c n y))
  simp only [← IsScalarTower.algebraMap_apply A B 𝓡] at h
  rwa [eval_extendLinearMaps_reesFromPiece I c f hfR ψ hψ y] at h

end TrivSqZeroExt

/-- The degreewise graded map extending the maps on a power of `I`. -/
@[stacks 0EIC]
public theorem exists_unique_extendLinearMaps_module
    (A : Type u) (B : Type v) (N : Type w)
    [CommRing A]
    [CommRing B] [Algebra A B] [IsNoetherianRing B]
    [AddCommGroup N] [Module B N] [Module.Finite B N]
    (I : Ideal A) {r : ℕ} (f : Fin r → A)
    (hf : I = Ideal.span (Set.range f))
    (c : ℕ) (_hc : 1 ≤ c)
    (φ : Fin r → (I ^ c : Ideal A) →ₗ[A] A)
    (hφ : ∀ g : (I ^ c : Ideal A), (∑ j, f j * φ j g) = (g : A)) :
    ∃ c' : ℕ, ∃ hc' : c ≤ c',
      ∃ φ' : Fin r → (I ^ c' : Ideal A) →ₗ[A] A,
        (∀ j (g : A) (hg : g ∈ I ^ c'),
          φ' j ⟨g, hg⟩ = φ j ⟨g, Ideal.pow_le_pow_right hc' hg⟩) ∧
        (∀ g : (I ^ c' : Ideal A), (∑ j, f j * φ' j g) = (g : A)) ∧
        ∃! Ψ : ∀ n : ℕ, reesModulePiece (B := B) (N := N) I c' n →ₗ[B] moduleMvPolynomial r N,
          (∀ n (y : reesModulePiece (B := B) (N := N) I c' n) (m : Fin r →₀ ℕ),
            (m.sum fun _ e => e) ≠ n → (Ψ n y) m = 0) ∧
          (∀ n (p : reesAlgebra (I ^ c'))
              (_hp : ∀ k : ℕ, k ≠ n → (p : Polynomial A).coeff k = 0)
              (x : N)
              (hx : (algebraMap A B ((p : Polynomial A).coeff n)) • x ∈
                reesModulePiece (B := B) (N := N) I c' n)
              (m : Fin r →₀ ℕ),
            (Ψ n ⟨(algebraMap A B ((p : Polynomial A).coeff n)) • x, hx⟩) m =
              (algebraMap A B
                ((Stacks.ReesAlgebra.extendLinearMaps (I ^ c') φ' p).coeff m)) • x) ∧
          (∀ n (y : reesModulePiece (B := B) (N := N) I c' n),
            ∑ m ∈ (Ψ n y).support,
              (∏ j, (algebraMap A B (f j)) ^ m j) • (Ψ n y) m = (y : N)) := by
  classical
  let R := TrivSqZeroExt B N
  let : Module Bᵐᵒᵖ N :=
    Module.compHom N ((RingHom.id B).fromOpposite (fun x y => Commute.all _ _))
  have : IsCentralScalar B N := ⟨fun _ _ => rfl⟩
  have : SMulCommClass B Bᵐᵒᵖ N := ⟨fun a b x => smul_comm a b.unop x⟩
  let : Algebra A R := Algebra.compHom R (algebraMap A B)
  have : IsScalarTower A B R := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Module.Finite B R := by
    show Module.Finite B (B × N)
    infer_instance
  have : IsNoetherianRing R := IsNoetherianRing.of_finite B R
  have hIfg : I.FG := Submodule.fg_def.2 ⟨Set.range f, Set.finite_range f, by simp [hf]⟩
  have : Module.Finite R (R ⊗[A] (I ^ c : Ideal A)) := tensor_ideal_power_finite I hIfg c
  obtain ⟨k, ψ, hψ, hψφ⟩ := exists_baseChanged_splitting (A := A) (R := R) I f hf c φ hφ
  have hfR : ∀ j, algebraMap A R (f j) ∈ I.map (algebraMap A R) := fun j =>
    Ideal.mem_map_of_mem _ (by
      rw [hf]
      exact Ideal.subset_span ⟨j, rfl⟩)
  have hck : c ≤ c + k := Nat.le_add_right c k
  let φ' : Fin r → (I ^ (c + k) : Ideal A) →ₗ[A] A :=
    fun j => (φ j).comp (Submodule.inclusion (Ideal.pow_le_pow_right hck))
  refine ⟨c + k, hck, φ', fun _ _ _ => rfl,
    fun g => hφ ⟨g, Ideal.pow_le_pow_right hck g.property⟩, moduleExtension I (c + k) ψ,
    ⟨fun _ y _ hmn => moduleExtension_apply_of_ne I (c + k) ψ y hmn,
      moduleExtension_smul_apply I (c + k) φ' ψ hψφ,
      fun _ y => sum_moduleExtension I (c + k) f hfR ψ hψ y⟩, ?_⟩
  rintro Ψ ⟨-, hΨ, -⟩
  exact funext fun n => reesModulePiece_linearMap_ext_of_formula I (c + k) n φ' (hΨ n)
    (moduleExtension_smul_apply I (c + k) φ' ψ hψφ n)

end Stacks.ReesAlgebra

