module

public import Mathlib.Data.Finsupp.Weight
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.ReesAlgebra

/-!
# The Rees algebra of a polynomial ring along a set of variables

Let `R` be a commutative ring, let `σ` index the variables of `A = R[σ]`, and let `v : ι → σ` be
an injective family singling out some of them, the `y`-variables. This file presents the Rees
algebra of `A` with respect to the ideal `(y_j : j ∈ ι)` by generators and relations: it is the
polynomial ring `A[T_j : j ∈ ι]` modulo the Koszul relations `y_i T_j - y_j T_i`, with `T_j`
mapping to the degree-one element `y_j` of `A[X]`.

No finiteness hypotheses are needed: neither `σ` nor `ι` is assumed finite, and `R` is an
arbitrary commutative ring.

## Main definitions

* `Stacks.ReesAlgebra.variableIdeal` is the ideal of `R[σ]` generated by the variables in the
  image of `v`.
* `Stacks.ReesAlgebra.reesPresentationHom` is the `A`-algebra map `A[T_j] → A[X]` sending `T_j`
  to the degree-one element `y_j`.
* `Stacks.ReesAlgebra.koszulIdeal` is the ideal of `A[T_j]` generated by the Koszul relations
  `y_i T_j - y_j T_i`.

## Main results

* `Stacks.ReesAlgebra.range_reesPresentationHom`: the image of the presentation map is exactly
  the Rees algebra of `variableIdeal v`.
* `Stacks.ReesAlgebra.ker_reesPresentationHom`: its kernel is exactly the Koszul ideal.
* `Stacks.ReesAlgebra.exists_reesPresentation`: hence `A[T_j]/(y_i T_j - y_j T_i)` is the Rees
  algebra of `(y_j : j ∈ ι)`, by an isomorphism carrying `T_j` to the degree-one element `y_j`.

## Implementation notes

The image computation is Mathlib's `adjoin_monomial_eq_reesAlgebra` together with the description
of the range of an `aeval` as an `Algebra.adjoin`.

The kernel computation is the whole content. Write `reesMonomial u α` for the monomial
`T^α · x^u` of `A[T_j]`; the presentation map sends it to `X^(deg α) · x^(u + v_*α)`, so two such
monomials have the same image exactly when `deg α` and `u + v_*α` agree. The key step is that
this necessary condition is also sufficient modulo the Koszul ideal
(`reesMonomial_sub_reesMonomial_mem`), proved by induction on `deg α`: if `α` and `α'` share a
variable in their supports one divides out that variable and applies the inductive hypothesis,
and if they do not, a single Koszul relation moves one unit of degree from a variable of `α` to a
variable of `α'`, after which the supports do meet.

From that congruence one builds, by choice, a well-defined value `reesFiberValue v d z` in the
quotient for each pair `(d, z)`, and assembles the `R`-linear map `reesSection` on `A[X]` that
realises it; `reesSection` composed with the presentation map is the quotient map
(`reesSection_comp`), which forces the kernel to lie inside the Koszul ideal. The grouping of the
monomials of a general element into fibres is thereby replaced by ordinary linearity.

## References

* [Stacks Project, Tag 0H1H](https://stacks.math.columbia.edu/tag/0H1H)
-/

@[expose] public section

open MvPolynomial

namespace Stacks.ReesAlgebra

variable {R : Type*} [CommRing R] {σ ι : Type*} (v : ι → σ)

/-- The ideal of `R[σ]` generated by the variables in the image of `v`. -/
public noncomputable def variableIdeal : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun j ↦ X (v j))

/-- The presentation map of the Rees algebra: the `A`-algebra map from the polynomial ring
`A[T_j : j ∈ ι]` over `A = R[σ]` to `A[X]` sending `T_j` to the degree-one element `y_j`. -/
public noncomputable def reesPresentationHom :
    MvPolynomial ι (MvPolynomial σ R) →ₐ[MvPolynomial σ R] Polynomial (MvPolynomial σ R) :=
  aeval fun j ↦ Polynomial.monomial 1 (X (v j) : MvPolynomial σ R)

/-- The ideal of Koszul relations `y_i T_j - y_j T_i` in `A[T_j : j ∈ ι]`. -/
public noncomputable def koszulIdeal : Ideal (MvPolynomial ι (MvPolynomial σ R)) :=
  Ideal.span (Set.range fun p : ι × ι ↦ C (X (v p.1)) * X p.2 - C (X (v p.2)) * X p.1)

/-- The image of the presentation map is the Rees algebra of the ideal of the `y`-variables. -/
public theorem range_reesPresentationHom :
    (reesPresentationHom (R := R) v).range = reesAlgebra (variableIdeal (R := R) v) := by
  rw [reesPresentationHom, aeval_range, ← adjoin_monomial_eq_reesAlgebra, variableIdeal,
    Submodule.map_span, Algebra.adjoin_span, ← Set.range_comp]
  rfl

/-- The monomial `T^α · x^u` of `A[T_j : j ∈ ι]`, for `u` a monomial exponent in the variables
`σ` and `α` one in the variables `ι`. -/
private noncomputable def reesMonomial (u : σ →₀ ℕ) (α : ι →₀ ℕ) :
    MvPolynomial ι (MvPolynomial σ R) :=
  monomial α (monomial u (1 : R))

/-- The presentation map sends `T^α` to `X^(deg α) · y^α`. -/
private theorem reesPresentationHom_monomial_one (α : ι →₀ ℕ) :
    reesPresentationHom (R := R) v (monomial α 1) =
      Polynomial.monomial α.degree (monomial (Finsupp.mapDomain v α) 1) := by
  induction α using Finsupp.induction_linear with
  | zero => simp [reesPresentationHom]
  | add f g hf hg =>
    have h1 : (monomial (f + g) (1 : MvPolynomial σ R)) = monomial f 1 * monomial g 1 := by
      rw [monomial_mul, one_mul]
    rw [h1, map_mul, hf, hg, Polynomial.monomial_mul_monomial, monomial_mul, one_mul,
      map_add, Finsupp.mapDomain_add]
  | single a b =>
    rw [← X_pow_eq_monomial, map_pow, reesPresentationHom, aeval_X, Polynomial.monomial_pow,
      Finsupp.degree_single, Finsupp.mapDomain_single, X_pow_eq_monomial, one_mul]

/-- The presentation map sends `T^α · x^u · r` to `X^(deg α) · x^(u + v_*α) · r`. -/
private theorem reesPresentationHom_monomial (u : σ →₀ ℕ) (α : ι →₀ ℕ) (r : R) :
    reesPresentationHom v (monomial α (monomial u r)) =
      Polynomial.monomial α.degree (monomial (u + Finsupp.mapDomain v α) r) := by
  have h : (monomial α (monomial u r) : MvPolynomial ι (MvPolynomial σ R)) =
      C (monomial u r) * monomial α 1 := by
    rw [C_mul_monomial, mul_one]
  rw [h, map_mul, reesPresentationHom_monomial_one, reesPresentationHom, aeval_C,
    Polynomial.algebraMap_eq, Polynomial.C_mul_monomial, monomial_mul, mul_one]

/-- The Koszul relations lie in the kernel of the presentation map. -/
private theorem koszulIdeal_le_ker :
    koszulIdeal (R := R) v ≤ RingHom.ker (reesPresentationHom (R := R) v) := by
  rw [koszulIdeal, Ideal.span_le]
  rintro _ ⟨⟨i, j⟩, rfl⟩
  simp only [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, reesPresentationHom, aeval_C,
    aeval_X, Polynomial.algebraMap_eq, Polynomial.C_mul_monomial]
  rw [mul_comm (X (v j) : MvPolynomial σ R), sub_self]

/-- Multiplying `reesMonomial u β` by the variable `T_k` raises the exponent of `T_k` by one. -/
private theorem reesMonomial_mul_X (u : σ →₀ ℕ) (β : ι →₀ ℕ) (k : ι) :
    reesMonomial (R := R) u β * X k = reesMonomial u (β + Finsupp.single k 1) := by
  rw [reesMonomial, reesMonomial, monomial_add_single, pow_one]

/-- Multiplying `reesMonomial u β` by a constant variable `x_s` raises the exponent of `x_s` by
one. -/
private theorem reesMonomial_mul_C_X (u : σ →₀ ℕ) (β : ι →₀ ℕ) (s : σ) :
    reesMonomial (R := R) u β * C (X s) = reesMonomial (u + Finsupp.single s 1) β := by
  rw [reesMonomial, reesMonomial, mul_comm, C_mul_monomial, monomial_add_single, pow_one, mul_comm]

/-- An exponent vector that is nonzero at `k` splits off one copy of `k`, dropping its total
degree by one. -/
private theorem exists_eq_add_single {τ : Type*} {α : τ →₀ ℕ} {k : τ} (h : α k ≠ 0) :
    ∃ β : τ →₀ ℕ, α = β + Finsupp.single k 1 ∧ β.degree + 1 = α.degree := by
  have hb : α = (α - Finsupp.single k 1) + Finsupp.single k 1 := by
    ext x
    rcases eq_or_ne x k with rfl | hx
    · simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]
      omega
    · have hz : (Finsupp.single k (1 : ℕ)) x = 0 := Finsupp.single_eq_of_ne hx
      simp only [Finsupp.add_apply, Finsupp.tsub_apply, hz]
      omega
  refine ⟨_, hb, ?_⟩
  nth_rewrite 2 [hb]
  rw [map_add, Finsupp.degree_single]

/-- The congruence lemma: two monomials of `A[T_j : j ∈ ι]` with the same image under the
presentation map are congruent modulo the Koszul ideal. -/
private theorem reesMonomial_sub_reesMonomial_mem (hv : Function.Injective v) (d : ℕ) :
    ∀ (α α' : ι →₀ ℕ) (u u' : σ →₀ ℕ), α.degree = d → α'.degree = d →
      u + Finsupp.mapDomain v α = u' + Finsupp.mapDomain v α' →
      reesMonomial (R := R) u α - reesMonomial u' α' ∈ koszulIdeal v := by
  induction d with
  | zero =>
    intro α α' u u' ha ha' h
    rw [Finsupp.degree_eq_zero_iff] at ha ha'
    subst ha
    subst ha'
    simp only [Finsupp.mapDomain_zero, add_zero] at h
    subst h
    simp
  | succ d ih =>
    have caseShared : ∀ (k : ι) (β β' : ι →₀ ℕ) (w w' : σ →₀ ℕ),
        β.degree = d → β'.degree = d →
        w + Finsupp.mapDomain v (β + Finsupp.single k 1) =
          w' + Finsupp.mapDomain v (β' + Finsupp.single k 1) →
        reesMonomial (R := R) w (β + Finsupp.single k 1) -
          reesMonomial w' (β' + Finsupp.single k 1) ∈ koszulIdeal v := by
      intro k β β' w w' hb hb' h
      simp only [Finsupp.mapDomain_add, Finsupp.mapDomain_single, ← add_assoc] at h
      rw [← reesMonomial_mul_X, ← reesMonomial_mul_X, ← sub_mul]
      exact Ideal.mul_mem_right _ _ (ih β β' w w' hb hb' (add_right_cancel h))
    intro α α' u u' ha ha' h
    by_cases hmeet : ∃ k, α k ≠ 0 ∧ α' k ≠ 0
    · obtain ⟨k, hk, hk'⟩ := hmeet
      obtain ⟨β, rfl, hdb⟩ := exists_eq_add_single hk
      obtain ⟨β', rfl, hdb'⟩ := exists_eq_add_single hk'
      exact caseShared k β β' u u' (by omega) (by omega) h
    · push Not at hmeet
      have ha0 : α ≠ 0 := fun hz ↦ by simp [hz] at ha
      have ha0' : α' ≠ 0 := fun hz ↦ by simp [hz] at ha'
      obtain ⟨i, hi⟩ : ∃ i, α i ≠ 0 := by simpa using Finsupp.ne_iff.1 ha0
      obtain ⟨j, hj⟩ : ∃ j, α' j ≠ 0 := by simpa using Finsupp.ne_iff.1 ha0'
      have haj : α j = 0 := by
        by_contra hc
        exact hj (hmeet j hc)
      obtain ⟨β, hb, hdb⟩ := exists_eq_add_single hi
      obtain ⟨β', hb', hdb'⟩ := exists_eq_add_single hj
      have hev := congrArg (fun f : σ →₀ ℕ ↦ f (v j)) h
      simp only [Finsupp.add_apply, Finsupp.mapDomain_apply_of_injective hv] at hev
      have huj : u (v j) ≠ 0 := by omega
      obtain ⟨w, hw, -⟩ := exists_eq_add_single huj
      have hgen : (C (X (v i)) * X j - C (X (v j)) * X i :
          MvPolynomial ι (MvPolynomial σ R)) ∈ koszulIdeal v :=
        Ideal.subset_span ⟨(i, j), rfl⟩
      have e1 : reesMonomial (R := R) u α =
          reesMonomial (R := R) w β * (C (X (v j)) * X i) := by
        rw [hb, hw, ← mul_assoc, reesMonomial_mul_C_X, reesMonomial_mul_X]
      have e2 : reesMonomial (R := R) (w + Finsupp.single (v i) 1) (β + Finsupp.single j 1) =
          reesMonomial (R := R) w β * (C (X (v i)) * X j) := by
        rw [← mul_assoc, reesMonomial_mul_C_X, reesMonomial_mul_X]
      have step1 : reesMonomial (R := R) u α -
          reesMonomial (R := R) (w + Finsupp.single (v i) 1) (β + Finsupp.single j 1) ∈
            koszulIdeal v := by
        have e : reesMonomial (R := R) u α -
            reesMonomial (R := R) (w + Finsupp.single (v i) 1) (β + Finsupp.single j 1) =
            -(reesMonomial (R := R) w β * (C (X (v i)) * X j - C (X (v j)) * X i)) := by
          rw [e1, e2]; ring
        rw [e]
        exact neg_mem (Ideal.mul_mem_left _ _ hgen)
      have hkey : (w + Finsupp.single (v i) 1) + Finsupp.mapDomain v (β + Finsupp.single j 1) =
          u' + Finsupp.mapDomain v (β' + Finsupp.single j 1) := by
        rw [← hb', ← h, hb, hw]
        simp only [Finsupp.mapDomain_add, Finsupp.mapDomain_single]
        abel
      have step2 := caseShared j β β' (w + Finsupp.single (v i) 1) u' (by omega) (by omega) hkey
      rw [← hb'] at step2
      have hsum := add_mem step1 step2
      rwa [sub_add_sub_cancel] at hsum

/-- The common class in the quotient by the Koszul ideal of all monomials `reesMonomial u α`
with `deg α = d` and `u + v_*α = z`, and `0` if there is no such monomial. -/
private noncomputable def reesFiberValue (d : ℕ) (z : σ →₀ ℕ) :
    MvPolynomial ι (MvPolynomial σ R) ⧸ koszulIdeal (R := R) v :=
  open scoped Classical in
  if h : ∃ p : (ι →₀ ℕ) × (σ →₀ ℕ), p.1.degree = d ∧ p.2 + Finsupp.mapDomain v p.1 = z then
    Ideal.Quotient.mk _ (reesMonomial h.choose.2 h.choose.1)
  else 0

/-- `reesFiberValue` is indeed the class of each monomial in its fibre. -/
private theorem reesFiberValue_eq (hv : Function.Injective v) (u : σ →₀ ℕ) (α : ι →₀ ℕ) :
    reesFiberValue v α.degree (u + Finsupp.mapDomain v α) =
      Ideal.Quotient.mk (koszulIdeal v) (reesMonomial (R := R) u α) := by
  classical
  have hex : ∃ p : (ι →₀ ℕ) × (σ →₀ ℕ), p.1.degree = α.degree ∧
      p.2 + Finsupp.mapDomain v p.1 = u + Finsupp.mapDomain v α := ⟨(α, u), rfl, rfl⟩
  rw [reesFiberValue, dif_pos hex]
  obtain ⟨h1, h2⟩ := hex.choose_spec
  exact Ideal.Quotient.eq.2
    (reesMonomial_sub_reesMonomial_mem v hv α.degree _ α _ u h1 rfl h2)

/-- The `R`-linear retraction of the presentation map: it sends `X^d · x^z` to the common class
`reesFiberValue v d z`. -/
private noncomputable def reesSection :
    Polynomial (MvPolynomial σ R) →ₗ[R] MvPolynomial ι (MvPolynomial σ R) ⧸ koszulIdeal v :=
  Polynomial.lsum fun d ↦ (MvPolynomial.basisMonomials σ R).constr R (reesFiberValue v d)

/-- The value of `reesSection` on a monomial of `A[X]`. -/
private theorem reesSection_monomial (d : ℕ) (z : σ →₀ ℕ) (r : R) :
    reesSection v (Polynomial.monomial d (monomial z r)) = r • reesFiberValue (R := R) v d z := by
  have h1 : (monomial z r : MvPolynomial σ R) = r • (basisMonomials σ R) z := by
    rw [coe_basisMonomials, smul_monomial, smul_eq_mul, mul_one]
  show (Polynomial.monomial d (monomial z r)).sum
      (fun n a ↦ (MvPolynomial.basisMonomials σ R).constr R (reesFiberValue v n) a) = _
  rw [Polynomial.sum_monomial_index _ _ (by simp), h1, map_smul, Module.Basis.constr_basis]

/-- The quotient map by the Koszul ideal is `R`-linear. -/
private theorem mk_smul (r : R) (x : MvPolynomial ι (MvPolynomial σ R)) :
    Ideal.Quotient.mk (koszulIdeal v) (r • x) =
      r • Ideal.Quotient.mk (koszulIdeal v) x :=
  map_smul (Ideal.Quotient.mkₐ R (koszulIdeal v)) r x

/-- The retraction undoes the presentation map: the composite is the quotient map by the Koszul
ideal. -/
private theorem reesSection_comp (hv : Function.Injective v)
    (x : MvPolynomial ι (MvPolynomial σ R)) :
    reesSection v (reesPresentationHom v x) = Ideal.Quotient.mk (koszulIdeal (R := R) v) x := by
  have hmon : ∀ (α : ι →₀ ℕ) (u : σ →₀ ℕ) (r : R),
      reesSection v (reesPresentationHom v (monomial α (monomial u r))) =
        Ideal.Quotient.mk (koszulIdeal (R := R) v) (monomial α (monomial u r)) := by
    intro α u r
    have hsm : (monomial α (monomial u r) : MvPolynomial ι (MvPolynomial σ R)) =
        r • reesMonomial (R := R) u α := by
      rw [reesMonomial, smul_monomial, smul_monomial, smul_eq_mul, mul_one]
    rw [reesPresentationHom_monomial, reesSection_monomial, reesFiberValue_eq v hv, hsm,
      mk_smul]
  have hstep : ∀ (α : ι →₀ ℕ) (a : MvPolynomial σ R),
      reesSection v (reesPresentationHom v (monomial α a)) =
        Ideal.Quotient.mk (koszulIdeal (R := R) v) (monomial α a) := by
    intro α a
    rw [a.as_sum, map_sum (monomial α), map_sum, map_sum, map_sum]
    exact Finset.sum_congr rfl fun u _ ↦ hmon α u _
  rw [x.as_sum, map_sum, map_sum, map_sum]
  exact Finset.sum_congr rfl fun α _ ↦ hstep α _

/-- The kernel of the presentation map is exactly the ideal of Koszul relations. -/
public theorem ker_reesPresentationHom (hv : Function.Injective v) :
    RingHom.ker (reesPresentationHom (R := R) v) = koszulIdeal v := by
  refine le_antisymm (fun x hx ↦ ?_) (koszulIdeal_le_ker v)
  have h := reesSection_comp v hv x
  rw [RingHom.mem_ker.1 hx, map_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.1 h.symm

/-- The Rees algebra of `R[σ]` with respect to the ideal generated by the variables `y_j = x_{v j}`
is the polynomial ring `A[T_j : j ∈ ι]` modulo the Koszul relations `y_i T_j - y_j T_i`, by an
isomorphism carrying `T_j` to the degree-one element `y_j`. -/
public theorem exists_reesPresentation (hv : Function.Injective v) :
    ∃ E : (MvPolynomial ι (MvPolynomial σ R) ⧸ koszulIdeal v) ≃ₐ[MvPolynomial σ R]
        reesAlgebra (variableIdeal (R := R) v),
      ∀ j : ι, (E (Ideal.Quotient.mk _ (X j)) : Polynomial (MvPolynomial σ R)) =
        Polynomial.monomial 1 (X (v j)) := by
  refine ⟨((Ideal.quotientEquivAlgOfEq (MvPolynomial σ R)
      (ker_reesPresentationHom v hv).symm).trans
    ((Ideal.quotientKerEquivRange (reesPresentationHom v)).trans
      (Subalgebra.equivOfEq _ _ (range_reesPresentationHom v)))), fun j ↦ ?_⟩
  rw [AlgEquiv.trans_apply, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerEquivRange, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk, Subalgebra.equivOfEq_apply]
  exact aeval_X _ j

end Stacks.ReesAlgebra

end
