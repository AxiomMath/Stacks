module

public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Ideal.Cotangent
public import StacksFrontier.AlgebraicGeometry.ConormalSheaf.Basic

/-!
# The augmentation ideal of a symmetric algebra

Let `R` be a commutative ring, let `M` be an `R`-module and write `S = SymmetricAlgebra R M`.
The algebra map `R → S` has a canonical retraction `SymmetricAlgebra.algebraMapInv : S →ₐ[R] R`,
the *augmentation*, which kills every element of `M`. Its kernel is the *augmentation ideal*
`I = augIdeal R M`, the ideal of the origin of the affine space attached to `M`, and `M` is
isomorphic to the cotangent module `I / I²`.

## Main definitions

* `SymmetricAlgebra.augIdeal R M`: the augmentation ideal, the kernel of
  `SymmetricAlgebra.algebraMapInv`.
* `SymmetricAlgebra.augDeriv`: the `R`-linear "derivative at the origin" `S →ₗ[R] M`, a retraction
  of `SymmetricAlgebra.ι R M`.
* `SymmetricAlgebra.augToCotangent`: the `R`-linear map `M →ₗ[R] (augIdeal R M).Cotangent`
  sending `m` to the class of `ι R M m`.
* `SymmetricAlgebra.augCotangentEquiv`: the resulting `R`-linear isomorphism
  `M ≃ₗ[R] (augIdeal R M).Cotangent`.
* `SymmetricAlgebra.augQuotTensorEquiv`: the same identification in base-change form,
  `(S ⧸ I) ⊗[S] I ≃ₗ[R] M`.

## Main results

* `SymmetricAlgebra.augIdeal_eq_span`: the augmentation ideal is generated by the image of `M`.
* `SymmetricAlgebra.augDeriv_eq_zero_of_mem_sq`: the derivative at the origin vanishes on the
  square of the augmentation ideal, so it factors through the cotangent module.
* `SymmetricAlgebra.augCotangentEquiv`: the cotangent module of the augmentation ideal of
  `Sym_R(M)` is `M`.
-/

@[expose] public section

open scoped TensorProduct

universe u v

namespace SymmetricAlgebra

variable (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]

/-- The augmentation ideal of `SymmetricAlgebra R M`, i.e. the kernel of the augmentation
`SymmetricAlgebra.algebraMapInv : SymmetricAlgebra R M →ₐ[R] R`. Geometrically it is the ideal
of the origin of the affine space attached to `M`. -/
def augIdeal : Ideal (SymmetricAlgebra R M) := RingHom.ker (algebraMapInv (R := R) (M := M))

variable {R M}

/-- Membership in the augmentation ideal is exactly the vanishing of the augmentation. -/
theorem mem_augIdeal_iff {x : SymmetricAlgebra R M} :
    x ∈ augIdeal R M ↔ algebraMapInv x = 0 :=
  RingHom.mem_ker

/-- The image of `M` in `SymmetricAlgebra R M` lies in the augmentation ideal. -/
theorem ι_mem_augIdeal (m : M) : ι R M m ∈ augIdeal R M :=
  mem_augIdeal_iff.mpr (algebraMapInv_ι m)

/-- The augmentation ideal is generated by the image of `M`. -/
theorem augIdeal_eq_span : augIdeal R M = Ideal.span (Set.range (ι R M)) := by
  refine le_antisymm (fun x hx => ?_) (Ideal.span_le.mpr ?_)
  · have key : Ideal.Quotient.mkₐ R (Ideal.span (Set.range (ι R M)))
        = (Algebra.ofId R (SymmetricAlgebra R M ⧸ Ideal.span (Set.range (ι R M)))).comp
          algebraMapInv := by
      refine algHom_ext (LinearMap.ext fun m => ?_)
      have hm : ι R M m ∈ Ideal.span (Set.range (ι R M)) := Ideal.subset_span ⟨m, rfl⟩
      simp [Algebra.ofId_apply, algebraMapInv_ι, Ideal.Quotient.eq_zero_iff_mem.mpr hm]
    have hx' : Ideal.Quotient.mk (Ideal.span (Set.range (ι R M))) x = 0 := by
      simpa [Algebra.ofId_apply, mem_augIdeal_iff.mp hx] using congr($key x)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hx'
  · rintro x ⟨m, rfl⟩
    exact ι_mem_augIdeal m

/-- The derivative at the origin: the `R`-linear retraction of `SymmetricAlgebra.ι R M`, the
second component of the `R`-algebra map `S →ₐ[R] TrivSqZeroExt R M` lifting `m ↦ (0, m)`. -/
noncomputable def augDeriv : SymmetricAlgebra R M →ₗ[R] M := by
  letI : Module Rᵐᵒᵖ M := Module.compHom _ ((RingHom.id R).fromOpposite mul_comm)
  haveI : IsCentralScalar R M := ⟨fun _ _ => rfl⟩
  exact (TrivSqZeroExt.sndHom R M).comp
    (SymmetricAlgebra.lift (TrivSqZeroExt.inrHom R M)).toLinearMap

/-- The derivative at the origin is a retraction of `SymmetricAlgebra.ι R M`. -/
@[simp]
theorem augDeriv_ι (m : M) : augDeriv (ι R M m) = m := by simp [augDeriv]

/-- The derivative at the origin kills the square of the augmentation ideal, hence factors
through the cotangent module of the augmentation ideal. -/
theorem augDeriv_eq_zero_of_mem_sq {x : SymmetricAlgebra R M}
    (hx : x ∈ augIdeal R M ^ 2) : augDeriv x = 0 := by
  let : Module Rᵐᵒᵖ M := Module.compHom _ ((RingHom.id R).fromOpposite mul_comm)
  have : IsCentralScalar R M := ⟨fun _ _ => rfl⟩
  set ψ : SymmetricAlgebra R M →ₐ[R] TrivSqZeroExt R M :=
    SymmetricAlgebra.lift (TrivSqZeroExt.inrHom R M) with hψ
  have hsnd : ∀ y : SymmetricAlgebra R M, augDeriv y = (ψ y).snd := fun _ => rfl
  have hfst : ∀ y : SymmetricAlgebra R M, (ψ y).fst = algebraMapInv y := by
    have key : (TrivSqZeroExt.fstHom R R M).comp ψ = algebraMapInv := by
      refine algHom_ext (LinearMap.ext fun m => ?_)
      simp [hψ, algebraMapInv_ι]
    exact fun y => congr($key y)
  rw [pow_two] at hx
  refine Submodule.mul_induction_on hx (fun a ha b hb => ?_) (fun a b ha hb => ?_)
  · rw [hsnd, map_mul, TrivSqZeroExt.snd_mul, hfst, hfst, mem_augIdeal_iff.mp ha,
      mem_augIdeal_iff.mp hb]
    simp
  · rw [map_add, ha, hb, add_zero]

variable (R M)

/-- The `R`-linear map `M → (augIdeal R M).Cotangent` sending `m` to the class of `ι R M m`
modulo the square of the augmentation ideal. -/
noncomputable def augToCotangent : M →ₗ[R] (augIdeal R M).Cotangent where
  toFun m := (augIdeal R M).toCotangent ⟨ι R M m, ι_mem_augIdeal m⟩
  map_add' m n := by
    rw [← map_add]
    exact congrArg _ (Subtype.ext (map_add (ι R M) m n))
  map_smul' r m := by
    have h : (⟨ι R M (r • m), ι_mem_augIdeal _⟩ : ↥(augIdeal R M))
        = algebraMap R (SymmetricAlgebra R M) r • ⟨ι R M m, ι_mem_augIdeal m⟩ :=
      Subtype.ext (by simp [Algebra.smul_def])
    rw [h, map_smul, algebraMap_smul, RingHom.id_apply]

variable {R M}

/-- `SymmetricAlgebra.augToCotangent` sends `m` to the class of `ι R M m`. -/
@[simp]
theorem augToCotangent_apply (m : M) :
    augToCotangent R M m = (augIdeal R M).toCotangent ⟨ι R M m, ι_mem_augIdeal m⟩ :=
  rfl

/-- An element `a` of `SymmetricAlgebra R M` acts on the range of `augToCotangent` through the
scalar `algebraMapInv a`. -/
theorem smul_augToCotangent (a : SymmetricAlgebra R M) (m : M) :
    a • augToCotangent R M m = augToCotangent R M (algebraMapInv a • m) := by
  have h : a - algebraMap R (SymmetricAlgebra R M) (algebraMapInv a) ∈ augIdeal R M := by
    simp [mem_augIdeal_iff]
  have h0 := Ideal.Cotangent.smul_eq_zero_of_mem h (augToCotangent R M m)
  rw [sub_smul, sub_eq_zero] at h0
  rw [h0, algebraMap_smul, map_smul]

/-- `SymmetricAlgebra.augToCotangent` is injective. -/
theorem augToCotangent_injective : Function.Injective (augToCotangent R M) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro m hm
  rw [← augDeriv_ι (R := R) m]
  exact augDeriv_eq_zero_of_mem_sq ((Ideal.toCotangent_eq_zero _ _).mp hm)

/-- `SymmetricAlgebra.augToCotangent` is surjective. -/
theorem augToCotangent_surjective : Function.Surjective (augToCotangent R M) := by
  let W : Submodule (SymmetricAlgebra R M) (augIdeal R M).Cotangent :=
    { carrier := Set.range (augToCotangent R M)
      add_mem' := by
        rintro _ _ ⟨m, rfl⟩ ⟨n, rfl⟩
        exact ⟨m + n, map_add _ _ _⟩
      zero_mem' := ⟨0, map_zero _⟩
      smul_mem' := by
        rintro a _ ⟨m, rfl⟩
        exact ⟨algebraMapInv a • m, (smul_augToCotangent a m).symm⟩ }
  have hspan : Ideal.span (Set.range (ι R M))
      ≤ Submodule.map (augIdeal R M).subtype (W.comap (augIdeal R M).toCotangent) := by
    rw [Ideal.span_le]
    rintro x ⟨m, rfl⟩
    exact ⟨⟨ι R M m, ι_mem_augIdeal m⟩, ⟨m, rfl⟩, rfl⟩
  intro c
  obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective (augIdeal R M) c
  obtain ⟨z, hz, hzy⟩ := augIdeal_eq_span.trans_le hspan y.2
  obtain rfl : z = y := Subtype.ext hzy
  exact hz

/-- **The cotangent module of the augmentation ideal of `Sym_R(M)` is `M`.** -/
noncomputable def augCotangentEquiv : M ≃ₗ[R] (augIdeal R M).Cotangent :=
  LinearEquiv.ofBijective (augToCotangent R M)
    ⟨augToCotangent_injective, augToCotangent_surjective⟩

/-- `SymmetricAlgebra.augCotangentEquiv` sends `m` to the class of `ι R M m` modulo the square of
the augmentation ideal. -/
@[simp]
theorem augCotangentEquiv_apply (m : M) :
    augCotangentEquiv m = (augIdeal R M).toCotangent ⟨ι R M m, ι_mem_augIdeal m⟩ :=
  rfl

/-- The inverse of `SymmetricAlgebra.augCotangentEquiv` sends the class of `ι R M m` to `m`. -/
@[simp]
theorem augCotangentEquiv_symm_toCotangent (m : M) :
    augCotangentEquiv.symm ((augIdeal R M).toCotangent ⟨ι R M m, ι_mem_augIdeal m⟩) = m :=
  augCotangentEquiv.symm_apply_apply m

variable (R M)

/-- **The base change of the augmentation ideal to the quotient is `M`**: with
`S = SymmetricAlgebra R M` and `I = augIdeal R M`, the module `(S ⧸ I) ⊗[S] I` is isomorphic to
`M` as an `R`-module. -/
noncomputable def augQuotTensorEquiv :
    ((SymmetricAlgebra R M ⧸ augIdeal R M) ⊗[SymmetricAlgebra R M] ↥(augIdeal R M)) ≃ₗ[R] M :=
  (((augIdeal R M).quotTensorEquivCotangent.restrictScalars
    (SymmetricAlgebra R M)).restrictScalars R).trans augCotangentEquiv.symm

variable {R M}

/-- `SymmetricAlgebra.augQuotTensorEquiv` carries `1 ⊗ ι R M m` to `m`. -/
@[simp]
theorem augQuotTensorEquiv_one_tmul_ι (m : M) :
    augQuotTensorEquiv R M ((1 : SymmetricAlgebra R M ⧸ augIdeal R M)
        ⊗ₜ[SymmetricAlgebra R M] (⟨ι R M m, ι_mem_augIdeal m⟩ : ↥(augIdeal R M))) = m :=
  (congrArg augCotangentEquiv.symm
      ((augIdeal R M).quotTensorEquivCotangent_one_tmul _)).trans
    (augCotangentEquiv_symm_toCotangent m)

end SymmetricAlgebra

end
