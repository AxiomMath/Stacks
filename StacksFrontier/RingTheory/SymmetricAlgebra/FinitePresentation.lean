module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
public import Mathlib.RingTheory.FinitePresentation

/-!
# The symmetric algebra of a finitely presented module is a finitely presented algebra

Let `R` be a commutative ring and `M` an `R`-module. If `M` is finitely presented as a module
then `Sym_R(M)` is finitely presented as an `R`-algebra. Writing `M = R^n ⧸ K` with `K` finitely
generated, `Sym_R(M)` is `R[x_1, …, x_n]` modulo the ideal generated by the finitely many
generators of `K`, read as linear forms.

The statement is needed wherever a finitely presented quasi-coherent module has to be turned into
a quasi-coherent algebra of finite presentation — the step `ℬ_i = Sym(ℱ_i)` in the proof of
[Stacks, Tag 05JS]. The library's finite presentation statement for symmetric algebras covers only
finite **projective** modules, and it is proved through a projective splitting, so it does not
apply: a finitely presented module need not be projective.

## Main definitions

* `Stacks.SymAlg.idealOfSubmodule`: the ideal of `Sym_R(N)` generated by a submodule `K ⊆ N`,
  read in degree one.
* `Stacks.SymAlg.quotientEquiv`: **`Sym_R(N ⧸ K) ≅ Sym_R(N) ⧸ (K)`**, i.e. right exactness of
  the symmetric algebra functor, in ideal-generation form.
* `Stacks.SymAlg.congrEquiv`: a linear equivalence of modules induces an algebra equivalence of
  their symmetric algebras.

## Main results

* `Stacks.SymAlg.idealOfSubmodule_span`: the ideal generated by a spanned submodule is generated
  by the spanning set.
* `Stacks.SymAlg.fg_idealOfSubmodule`: a finitely generated submodule generates a finitely
  generated ideal.
* `Stacks.SymAlg.finitePresentation`: **`Sym_R(M)` is a finitely presented `R`-algebra when `M`
  is a finitely presented `R`-module.**
* `Stacks.SymAlg.finiteType`: the finite type consequence.

## Implementation notes

Right exactness is proved by exhibiting the two algebra maps and checking that both composites
are the identity on generators. `SymmetricAlgebra.algHom_ext` reduces a check on `Sym_R(N ⧸ K)`
to a check on `N ⧸ K`, which `Submodule.mkQ_surjective` reduces to a check on `N`; a map out of
`Sym_R(N) ⧸ (K)` is checked on `Ideal.Quotient.mk` of an element, which
`Ideal.Quotient.mk_surjective` supplies. No ring is presented by hand and no monomial
calculation occurs. The composite `toQuotient ∘ mapQuotient = mk` is named separately because
both branches of `AlgEquiv.ofAlgHom` need it.

`idealOfSubmodule_span` is the only induction: the ideal generated by `ι '' (span R S)` is
generated by `ι '' S`, because `ι` is linear and an ideal is closed under multiplication by
`algebraMap`, which is what `Algebra.smul_def` turns the `smul` case into.

The namespace is `Stacks.SymAlg` rather than `Stacks.SymmetricAlgebra`: inside a namespace of the
latter name, `open SymmetricAlgebra` resolves to the enclosing namespace and silently fails to
open Mathlib's, so every `ι` becomes an unknown identifier.

`congrEquiv` is stated rather than taken from the library because the pinned Mathlib has no
functoriality for `SymmetricAlgebra` in the module beyond `SymmetricAlgebra.lift`.

## References

* [Stacks Project, Tag 05JS](https://stacks.math.columbia.edu/tag/05JS)
* [Stacks Project, Tag 00DO](https://stacks.math.columbia.edu/tag/00DO)
-/

@[expose] public section

open SymmetricAlgebra

universe u v w

namespace Stacks.SymAlg

variable {R : Type u} [CommRing R]

/-! ### Functoriality in the module -/

section Congr

variable {M : Type v} {M' : Type w} [AddCommGroup M] [Module R M] [AddCommGroup M']
  [Module R M']

/-- A linear equivalence of modules induces an algebra equivalence of their symmetric
algebras. -/
noncomputable def congrEquiv (e : M ≃ₗ[R] M') :
    SymmetricAlgebra R M ≃ₐ[R] SymmetricAlgebra R M' :=
  AlgEquiv.ofAlgHom (SymmetricAlgebra.lift (ι R M' ∘ₗ (e : M →ₗ[R] M')))
    (SymmetricAlgebra.lift (ι R M ∘ₗ (e.symm : M' →ₗ[R] M)))
    (SymmetricAlgebra.algHom_ext (LinearMap.ext fun x => by simp))
    (SymmetricAlgebra.algHom_ext (LinearMap.ext fun x => by simp))

end Congr

/-! ### The ideal generated by a submodule in degree one -/

section Ideal

variable {N : Type v} [AddCommGroup N] [Module R N]

/-- The ideal of `Sym_R(N)` generated by a submodule `K ⊆ N`, read in degree one. -/
def idealOfSubmodule (K : Submodule R N) : Ideal (SymmetricAlgebra R N) :=
  Ideal.span (ι R N '' K)

/-- For `x ∈ K`, the degree-one element `ι x` lies in the ideal generated by `K`. -/
theorem ι_mem_idealOfSubmodule {K : Submodule R N} {x : N} (hx : x ∈ K) :
    ι R N x ∈ idealOfSubmodule K :=
  Ideal.subset_span ⟨x, hx, rfl⟩

/-- The ideal generated by a spanned submodule is generated by the spanning set. -/
theorem idealOfSubmodule_span (S : Set N) :
    idealOfSubmodule (Submodule.span R S) = Ideal.span (ι R N '' S) := by
  refine le_antisymm ?_ ?_
  · rw [idealOfSubmodule, Ideal.span_le]
    rintro y ⟨x, hx, rfl⟩
    induction hx using Submodule.span_induction with
    | mem x hx => exact Ideal.subset_span ⟨x, hx, rfl⟩
    | zero => simpa only [map_zero, SetLike.mem_coe] using Submodule.zero_mem _
    | add a b _ _ ha hb =>
        simpa only [map_add, SetLike.mem_coe] using
          Ideal.add_mem _ (SetLike.mem_coe.1 ha) (SetLike.mem_coe.1 hb)
    | smul r a _ ha =>
        rw [map_smul, Algebra.smul_def, SetLike.mem_coe]
        exact Ideal.mul_mem_left _ _ (SetLike.mem_coe.1 ha)
  · rw [Ideal.span_le]
    rintro y ⟨x, hx, rfl⟩
    exact ι_mem_idealOfSubmodule (Submodule.subset_span hx)

/-- A finitely generated submodule generates a finitely generated ideal. -/
theorem fg_idealOfSubmodule {K : Submodule R N} (hK : K.FG) : (idealOfSubmodule K).FG := by
  classical
  obtain ⟨S, hS⟩ := hK
  refine ⟨S.image (ι R N), ?_⟩
  rw [← hS, idealOfSubmodule_span, Finset.coe_image]

end Ideal

/-! ### Right exactness -/

section RightExact

variable {N : Type v} [AddCommGroup N] [Module R N] (K : Submodule R N)

/-- The algebra map `Sym_R(N) ⟶ Sym_R(N ⧸ K)` induced by the quotient map. -/
noncomputable def mapQuotient : SymmetricAlgebra R N →ₐ[R] SymmetricAlgebra R (N ⧸ K) :=
  SymmetricAlgebra.lift (ι R (N ⧸ K) ∘ₗ K.mkQ)

/-- `mapQuotient K` sends `ι x` to `ι` of the class of `x` in `N ⧸ K`. -/
theorem mapQuotient_ι (x : N) : mapQuotient K (ι R N x) = ι R (N ⧸ K) (K.mkQ x) := by
  rw [mapQuotient, SymmetricAlgebra.lift_ι_apply, LinearMap.comp_apply]

/-- The degree-one generator of `Sym_R(N) ⧸ (K)` out of `N ⧸ K`. -/
noncomputable def quotientGen : N ⧸ K →ₗ[R] SymmetricAlgebra R N ⧸ idealOfSubmodule K :=
  K.liftQ ((Ideal.Quotient.mkₐ R (idealOfSubmodule K)).toLinearMap ∘ₗ ι R N)
    (fun x hx => by
      simp only [LinearMap.mem_ker, LinearMap.coe_comp, Function.comp_apply,
        AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk]
      exact (Ideal.Quotient.eq_zero_iff_mem).2 (ι_mem_idealOfSubmodule hx))

/-- `quotientGen K` sends the class of `x` to the class of `ι x` in `Sym_R(N) ⧸ (K)`. -/
theorem quotientGen_mkQ (x : N) :
    quotientGen K (K.mkQ x) = Ideal.Quotient.mk (idealOfSubmodule K) (ι R N x) :=
  Submodule.liftQ_apply _ _ x

/-- The algebra map `Sym_R(N ⧸ K) ⟶ Sym_R(N) ⧸ (K)`. -/
noncomputable def toQuotient :
    SymmetricAlgebra R (N ⧸ K) →ₐ[R] SymmetricAlgebra R N ⧸ idealOfSubmodule K :=
  SymmetricAlgebra.lift (quotientGen K)

/-- The algebra map `Sym_R(N) ⧸ (K) ⟶ Sym_R(N ⧸ K)`: the induced map kills the ideal. -/
noncomputable def ofQuotient :
    SymmetricAlgebra R N ⧸ idealOfSubmodule K →ₐ[R] SymmetricAlgebra R (N ⧸ K) :=
  Ideal.Quotient.liftₐ _ (mapQuotient K) (fun a ha => by
    refine (show idealOfSubmodule K ≤ RingHom.ker (mapQuotient K).toRingHom from ?_) ha
    rw [idealOfSubmodule, Ideal.span_le]
    rintro y ⟨x, hx, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe, mapQuotient_ι]
    rw [Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero K).2 hx, map_zero])

/-- `ofQuotient K` sends the class of `y` to `mapQuotient K y`. -/
theorem ofQuotient_mk (y : SymmetricAlgebra R N) :
    ofQuotient K (Ideal.Quotient.mk (idealOfSubmodule K) y) = mapQuotient K y :=
  rfl

/-- The composite `Sym_R(N) ⟶ Sym_R(N ⧸ K) ⟶ Sym_R(N) ⧸ (K)` is the quotient map. -/
theorem toQuotient_comp_mapQuotient :
    (toQuotient K).comp (mapQuotient K) = Ideal.Quotient.mkₐ R (idealOfSubmodule K) := by
  refine SymmetricAlgebra.algHom_ext (LinearMap.ext fun x => ?_)
  change (toQuotient K) ((mapQuotient K) (ι R N x)) =
    Ideal.Quotient.mk (idealOfSubmodule K) (ι R N x)
  rw [mapQuotient_ι, toQuotient, SymmetricAlgebra.lift_ι_apply, quotientGen_mkQ]

/-- **Right exactness of the symmetric algebra: `Sym_R(N ⧸ K) ≅ Sym_R(N) ⧸ (K)`.** -/
noncomputable def quotientEquiv :
    SymmetricAlgebra R (N ⧸ K) ≃ₐ[R] SymmetricAlgebra R N ⧸ idealOfSubmodule K :=
  AlgEquiv.ofAlgHom (toQuotient K) (ofQuotient K)
    (AlgHom.ext fun z => by
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      change (toQuotient K) ((ofQuotient K) (Ideal.Quotient.mk (idealOfSubmodule K) y)) =
        Ideal.Quotient.mk (idealOfSubmodule K) y
      rw [ofQuotient_mk]
      exact AlgHom.congr_fun (toQuotient_comp_mapQuotient K) y)
    (SymmetricAlgebra.algHom_ext (LinearMap.ext fun m => by
      obtain ⟨x, rfl⟩ := K.mkQ_surjective m
      change (ofQuotient K) ((toQuotient K) (ι R (N ⧸ K) (K.mkQ x))) = ι R (N ⧸ K) (K.mkQ x)
      rw [toQuotient, SymmetricAlgebra.lift_ι_apply, quotientGen_mkQ, ofQuotient_mk,
        mapQuotient_ι]))

end RightExact

/-! ### Finite presentation -/

variable (R) in
/-- **The symmetric algebra of a finitely presented module is a finitely presented algebra.**

Writing `M = R^n ⧸ K` with `K` finitely generated, `Sym_R(M)` is `R[x_1, …, x_n]` modulo the
ideal generated in degree one by the finitely many generators of `K`. -/
theorem finitePresentation (M : Type v) [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] : Algebra.FinitePresentation R (SymmetricAlgebra R M) := by
  obtain ⟨n, K, e, hK⟩ := Module.FinitePresentation.exists_fin R M
  have hfree : Algebra.FinitePresentation R (SymmetricAlgebra R (Fin n → R)) :=
    Algebra.FinitePresentation.equiv
      (SymmetricAlgebra.equivMvPolynomial (Pi.basisFun R (Fin n))).symm
  have hquot : Algebra.FinitePresentation R
      (SymmetricAlgebra R (Fin n → R) ⧸ idealOfSubmodule K) :=
    Algebra.FinitePresentation.quotient (fg_idealOfSubmodule hK)
  exact Algebra.FinitePresentation.equiv ((quotientEquiv K).symm.trans (congrEquiv e.symm))

variable (R) in
/-- The symmetric algebra of a finitely presented module is of finite type. -/
theorem finiteType (M : Type v) [AddCommGroup M] [Module R M]
    [Module.FinitePresentation R M] : Algebra.FiniteType R (SymmetricAlgebra R M) := by
  have := finitePresentation R M
  infer_instance

end Stacks.SymAlg

end
