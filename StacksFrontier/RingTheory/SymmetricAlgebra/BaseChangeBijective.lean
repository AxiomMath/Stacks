module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SymmetricPowerSheafification
public import StacksFrontier.RingTheory.TensorAlgebra.Localization
public import Mathlib.LinearAlgebra.TensorProduct.RightExactness

/-!
# The symmetric algebra of a base change, through a semilinear map

Let `φ : R →+* R'` be a ring homomorphism and `u : M →ₛₗ[φ] M'` a semilinear map whose
`R'`-linear extension `R' ⊗[R] M ⟶ M'` is bijective, that is, `u` exhibits `M'` as the base
change of `M`.  Then the comparison

`R' ⊗[R] Sym_R(M) ⟶ Sym_{R'}(M')`,   `b ⊗ s ↦ b · Sym(u)(s)`,

is bijective.  This is `SymmetricAlgebra.exists_algEquiv_baseChange` (Stacks 0C6F (2)) read
through `u`; it is the form in which the restriction maps of a cartesian presheaf of modules
are transported to the presheaf of its sectionwise symmetric algebras.

## Main results

* `SymmetricAlgebra.bijective_of_bijective_baseChange`: the comparison is bijective.
-/

@[expose] public section

open scoped TensorProduct

/-- An additive map out of a tensor product of algebras is multiplicative as soon as it sends
`a ⊗ b` to `f a * g b` for ring homomorphisms `f` and `g`. -/
private theorem TensorProduct.map_mul_of_map_tmul {R A B C : Type*} [CommSemiring R]
    [Semiring A] [Semiring B] [Algebra R A] [Algebra R B] [CommSemiring C] (Ψ : A ⊗[R] B →+ C)
    (f : A →+* C) (g : B →+* C) (h : ∀ a b, Ψ (a ⊗ₜ b) = f a * g b) (p q : A ⊗[R] B) :
    Ψ (p * q) = Ψ p * Ψ q := by
  induction p using TensorProduct.induction_on with
  | zero => rw [zero_mul, map_zero, zero_mul]
  | add x y hx hy => rw [add_mul, map_add, map_add, hx, hy, add_mul]
  | tmul a b =>
    induction q using TensorProduct.induction_on with
    | zero => rw [mul_zero, map_zero, mul_zero]
    | add x y hx hy => rw [mul_add, map_add, map_add, hx, hy, mul_add]
    | tmul a' b' =>
      rw [Algebra.TensorProduct.tmul_mul_tmul, h, h, h, map_mul, map_mul]
      ring

/-- If a multiplicative additive surjection `c : T → A'` carries an additive submonoid `K` of `T`
closed under left multiplication onto a set containing `X`, then its image of `K` contains the
ideal generated by `X`. -/
private theorem AddMonoidHom.exists_mem_of_mem_ideal_span {T A' S : Type*} [Semiring T]
    [Semiring A'] [SetLike S T] [AddSubmonoidClass S T] (c : T →+ A') (hc : Function.Surjective c)
    (hmul : ∀ s t, c (s * t) = c s * c t) (K : S) (hK : ∀ s k, k ∈ K → s * k ∈ K)
    {X : Set A'} (hX : ∀ x ∈ X, ∃ t ∈ K, c t = x) {x : A'} (hx : x ∈ Ideal.span X) :
    ∃ t ∈ K, c t = x := by
  refine Submodule.span_induction (p := fun x _ => ∃ t ∈ K, c t = x) (fun x hx => hX x hx)
    ?_ ?_ ?_ hx
  · exact ⟨0, zero_mem _, map_zero _⟩
  · rintro _ _ _ _ ⟨t, ht, rfl⟩ ⟨t₂, ht₂, rfl⟩
    exact ⟨t + t₂, add_mem ht ht₂, map_add _ _ _⟩
  · rintro a _ _ ⟨t, ht, rfl⟩
    obtain ⟨s, rfl⟩ := hc a
    exact ⟨s * t, hK _ _ ht, hmul s t⟩

namespace SymmetricAlgebra

/-- Base change of the symmetric algebra along a linear equivalence is bijective. -/
private theorem bijective_mapₛₗ_id {S N P : Type*} [CommRing S] [AddCommGroup N] [Module S N]
    [AddCommGroup P] [Module S P] (e : N ≃ₗ[S] P) :
    Function.Bijective (mapₛₗ (RingHom.id S) e.toLinearMap) :=
  Function.bijective_iff_has_inverse.mpr ⟨mapₛₗ (RingHom.id S) e.symm.toLinearMap,
    fun x => (mapₛₗ_eq_comp (χ := RingHom.id S) e.toLinearMap e.symm.toLinearMap LinearMap.id
      (fun _ => rfl) (fun m => (e.symm_apply_apply m).symm) x).symm.trans
      (mapₛₗ_eq_self LinearMap.id (fun _ => rfl) (fun _ => rfl) x),
    fun x => (mapₛₗ_eq_comp (χ := RingHom.id S) e.symm.toLinearMap e.toLinearMap LinearMap.id
      (fun _ => rfl) (fun m => (e.apply_symm_apply m).symm) x).symm.trans
      (mapₛₗ_eq_self LinearMap.id (fun _ => rfl) (fun _ => rfl) x)⟩

variable {R R' : Type*} [CommRing R] [CommRing R'] (φ : R →+* R')
  {M M' : Type*} [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R' M']

/-- **The symmetric algebra of a base change.**  If the `R'`-linear extension of a `φ`-semilinear
map `u : M ⟶ M'` is bijective, then so is every additive map
`R' ⊗[R] Sym_R(M) ⟶ Sym_{R'}(M')` sending `b ⊗ s` to `b · Sym(u)(s)`. -/
theorem bijective_of_bijective_baseChange (u : M →ₛₗ[φ] M')
    (hu : letI := φ.toAlgebra
      ∃ c : R' ⊗[R] M →+ M', (∀ (b : R') (m : M), c (b ⊗ₜ m) = b • u m) ∧
        Function.Bijective c)
    (Ψ : letI := φ.toAlgebra; R' ⊗[R] SymmetricAlgebra R M →+ SymmetricAlgebra R' M')
    (hΨ : letI := φ.toAlgebra
      ∀ (b : R') (s : SymmetricAlgebra R M),
        Ψ (b ⊗ₜ s) = algebraMap R' (SymmetricAlgebra R' M') b * mapₛₗ φ u s) :
    Function.Bijective Ψ := by
  let := φ.toAlgebra
  obtain ⟨c, hc, hcb⟩ := hu
  have hcl : ∀ (b' : R') (z : R' ⊗[R] M), c (b' • z) = b' • c z := by
    intro b' z
    induction z using TensorProduct.induction_on with
    | zero => rw [smul_zero, map_zero, smul_zero]
    | tmul b m => rw [TensorProduct.smul_tmul', hc, hc, smul_eq_mul, mul_smul]
    | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]
  let cL : (R' ⊗[R] M) ≃ₗ[R'] M' :=
    { AddEquiv.ofBijective c hcb with map_smul' := hcl }
  obtain ⟨e, he⟩ := SymmetricAlgebra.exists_algEquiv_baseChange R R' M
  let g := mapₛₗ (RingHom.id R') cL.toLinearMap
  have hmul := TensorProduct.map_mul_of_map_tmul Ψ (algebraMap R' _) (mapₛₗ φ u) hΨ
  have key : ∀ x, Ψ (e x) = g x := by
    intro x
    induction x using SymmetricAlgebra.induction with
    | algebraMap r =>
      rw [AlgEquiv.commutes, Algebra.TensorProduct.algebraMap_apply, hΨ, map_one, mul_one]
      exact (mapₛₗ_algebraMap _ _ r).symm
    | ι t =>
      induction t using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero, map_zero, map_zero]
      | add x y hx hy => rw [map_add, map_add, map_add, hx, hy, map_add]
      | tmul b m =>
        have h1 : (b ⊗ₜ[R] m : R' ⊗[R] M) = b • (1 ⊗ₜ[R] m) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [h1, map_smul, map_smul, he, TensorProduct.smul_tmul', smul_eq_mul, mul_one, hΨ,
          mapₛₗ_ι, Algebra.smul_def, map_mul, mapₛₗ_algebraMap, mapₛₗ_ι]
        congr 2
        show u m = c (1 ⊗ₜ[R] m)
        rw [hc, one_smul]
    | mul x y hx hy => rw [map_mul, hmul, hx, hy, map_mul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]
  have hfun : (Ψ : R' ⊗[R] SymmetricAlgebra R M → SymmetricAlgebra R' M') = g ∘ e.symm := by
    funext p
    rw [Function.comp_apply, ← key, AlgEquiv.apply_symm_apply]
  rw [hfun]
  exact (bijective_mapₛₗ_id cL).comp e.symm.bijective

end SymmetricAlgebra

namespace TensorProduct

/-- **Bijectivity of a base change comparison is invariant under isomorphism of its data.**  If
`Ψ₀ : R' ⊗[R] P ⟶ P'` is bijective and `Ψ : R' ⊗[R] Q ⟶ Q'` agrees with it through an
`R`-linear equivalence `e : P ≃ Q` and an additive equivalence `e' : P' ≃ Q'`, then `Ψ` is
bijective. -/
theorem bijective_of_bijective_of_equiv {R R' : Type*} [CommRing R] [CommRing R'] [Algebra R R']
    {P Q P' Q' : Type*} [AddCommGroup P] [Module R P] [AddCommGroup Q] [Module R Q]
    [AddCommGroup P'] [AddCommGroup Q'] (e : P ≃ₗ[R] Q) (e' : P' ≃+ Q')
    (Ψ₀ : R' ⊗[R] P →+ P') (hΨ₀ : Function.Bijective Ψ₀) (Ψ : R' ⊗[R] Q →+ Q')
    (h : ∀ (b : R') (p : P), Ψ (b ⊗ₜ e p) = e' (Ψ₀ (b ⊗ₜ p))) : Function.Bijective Ψ := by
  let L : (R' ⊗[R] P) ≃ₗ[R] (R' ⊗[R] Q) := LinearEquiv.lTensor R' e
  have key : ∀ z, Ψ (L z) = e' (Ψ₀ z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero, map_zero]
    | tmul b p => exact h b p
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  have hfun : (Ψ : R' ⊗[R] Q → Q') = e' ∘ Ψ₀ ∘ L.symm := by
    funext q
    rw [Function.comp_apply, Function.comp_apply, ← key, LinearEquiv.apply_symm_apply]
  rw [hfun]
  exact e'.bijective.comp (hΨ₀.comp L.symm.bijective)

/-- The range of `R' ⊗[R] J → R' ⊗[R] A` is closed under left multiplication, for an ideal `J`
of an `R`-algebra `A`. -/
private theorem mul_mem_range_lTensor_subtype {R R' A : Type*} [CommSemiring R]
    [CommSemiring R'] [Algebra R R'] [CommSemiring A] [Algebra R A] (J : Ideal A) (s k : R' ⊗[R] A)
    (hk : k ∈ LinearMap.range (LinearMap.lTensor R' (J.restrictScalars R).subtype)) :
    s * k ∈ LinearMap.range (LinearMap.lTensor R' (J.restrictScalars R).subtype) := by
  obtain ⟨k, rfl⟩ := hk
  induction k using TensorProduct.induction_on with
  | zero =>
    rw [map_zero, mul_zero]
    exact zero_mem _
  | add x y hx hy =>
    rw [map_add, mul_add]
    exact add_mem hx hy
  | tmul b j =>
    induction s using TensorProduct.induction_on with
    | zero =>
      rw [zero_mul]
      exact zero_mem _
    | add x y hx hy =>
      rw [add_mul]
      exact add_mem hx hy
    | tmul b' a =>
      rw [LinearMap.lTensor_tmul, Algebra.TensorProduct.tmul_mul_tmul]
      exact ⟨(b' * b) ⊗ₜ ⟨a * j.1, J.mul_mem_left a j.2⟩, rfl⟩

/-- **Base change of a quotient by the ideal generated by the image of a module.**  Let
`φ : R →+* R'`, and let `h : A →+* A'` exhibit the `R'`-algebra `A'` as the base change of the
`R`-algebra `A` (structure maps `ι`, `ι'`).  Let `n : M ⟶ A` be `R`-linear and `n' : M' ⟶ A'` be
`R'`-linear, compatible with a `φ`-semilinear `u : M ⟶ M'` whose image spans `M'`.  Let
`q : A ⟶ Q` and `q' : A' ⟶ Q'` be surjective ring maps with kernels the ideals generated by `n(M)`
and by `n'(M')`, and let `Q` be an `R`-module through `q ∘ ι`.  Then every additive map
`R' ⊗[R] Q ⟶ Q'` sending `b ⊗ q(a)` to `q'(ι'(b) h(a))` is bijective. -/
theorem bijective_quotient_baseChange {R R' A A' Q Q' : Type*} [CommRing R] [CommRing R']
    [CommRing A] [CommRing A'] [CommRing Q] [CommRing Q'] (φ : R →+* R') (ι : R →+* A)
    (ι' : R' →+* A') (h : A →+* A')
    (hA : letI := φ.toAlgebra; letI := ι.toAlgebra
      ∃ c : R' ⊗[R] A →+ A', (∀ (b : R') (a : A), c (b ⊗ₜ a) = ι' b * h a) ∧
        Function.Bijective c)
    {M M' : Type*} [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R' M']
    (u : M →ₛₗ[φ] M') (hu : ∀ m' : M', m' ∈ Submodule.span R' (Set.range u))
    (n : letI := ι.toAlgebra; M →ₗ[R] A) (n' : letI := ι'.toAlgebra; M' →ₗ[R'] A')
    (hnn : ∀ m, h (n m) = n' (u m))
    (q : A →+* Q) (hq : Function.Surjective q) (hqker : RingHom.ker q = Ideal.span (Set.range n))
    (q' : A' →+* Q') (hq' : Function.Surjective q')
    (hq'ker : RingHom.ker q' = Ideal.span (Set.range n'))
    [instQ : Module R Q] (hsmul : ∀ (r : R) (a : A), r • q a = q (ι r * a))
    (Ψ : letI := φ.toAlgebra; R' ⊗[R] Q →+ Q')
    (hΨ : letI := φ.toAlgebra; ∀ (b : R') (a : A), Ψ (b ⊗ₜ q a) = q' (ι' b * h a)) :
    Function.Bijective Ψ := by
  let := φ.toAlgebra
  let instA : Algebra R A := ι.toAlgebra
  let instA' : Algebra R' A' := ι'.toAlgebra
  obtain ⟨c, hc, hcb⟩ := hA
  let p : A →ₗ[R] Q :=
    { toFun := q
      map_add' := map_add _
      map_smul' := fun r a => (hsmul r a).symm }
  let Jr : Submodule R A := (Ideal.span (Set.range n)).restrictScalars R
  have hex : Function.Exact Jr.subtype p := by
    intro a
    show q a = 0 ↔ a ∈ Set.range Jr.subtype
    rw [← RingHom.mem_ker, hqker]
    exact ⟨fun ha => ⟨⟨a, ha⟩, rfl⟩, fun ⟨x, hx⟩ => hx ▸ x.2⟩
  have hπs := LinearMap.lTensor_surjective R' (g := p) hq
  have hcmul := map_mul_of_map_tmul c ι' h hc
  have hΨc : ∀ t, Ψ (LinearMap.lTensor R' p t) = q' (c t) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero, map_zero]
    | tmul b a =>
      rw [LinearMap.lTensor_tmul, hc]
      exact hΨ b a
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  let K := LinearMap.range (LinearMap.lTensor R' Jr.subtype)
  have hK := mul_mem_range_lTensor_subtype (R := R) (R' := R') (Ideal.span (Set.range n))
  have hJ'K : ∀ x ∈ Ideal.span (Set.range n'), ∃ t ∈ K, c t = x := by
    refine fun x hx => AddMonoidHom.exists_mem_of_mem_ideal_span c hcb.2 hcmul K hK ?_ hx
    rintro _ ⟨m', rfl⟩
    refine Submodule.span_induction (p := fun m' _ => ∃ t ∈ K, c t = n' m') ?_ ?_ ?_ ?_ (hu m')
    · rintro _ ⟨m, rfl⟩
      refine ⟨1 ⊗ₜ n m, ⟨1 ⊗ₜ ⟨n m, Ideal.subset_span ⟨m, rfl⟩⟩, rfl⟩, ?_⟩
      rw [hc, map_one, one_mul, hnn]
    · exact ⟨0, zero_mem _, by rw [map_zero, map_zero]⟩
    · rintro _ _ _ _ ⟨t, ht, e⟩ ⟨t₂, ht₂, e₂⟩
      exact ⟨t + t₂, add_mem ht ht₂, by rw [map_add, map_add, e, e₂]⟩
    · rintro b _ _ ⟨t, ht, hct⟩
      refine ⟨(b ⊗ₜ 1) * t, hK _ _ ht, ?_⟩
      rw [hcmul, hct, hc, map_one, mul_one, map_smul]
      rfl
  refine ⟨fun z₁ z₂ hz => ?_, fun y => ?_⟩
  · obtain ⟨t₁, rfl⟩ := hπs z₁
    obtain ⟨t₂, rfl⟩ := hπs z₂
    rw [hΨc, hΨc, ← sub_eq_zero, ← map_sub, ← map_sub, ← RingHom.mem_ker, hq'ker] at hz
    obtain ⟨t, ht, hct⟩ := hJ'K _ hz
    rw [← sub_eq_zero, ← map_sub, ← hcb.1 hct]
    exact (lTensor_exact R' hex hq t).2 ht
  · obtain ⟨a2, rfl⟩ := hq' y
    obtain ⟨t, rfl⟩ := hcb.2 a2
    exact ⟨LinearMap.lTensor R' p t, hΨc t⟩

end TensorProduct

end
