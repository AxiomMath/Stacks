module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Spectrum.Prime.Basic

/-!
# The kernel of a retraction is carried to the kernel of its base change

Let `ι : S ⟶ R` be a ring map with a retraction `τ : R ⟶ S`, so `τ ∘ ι = id`, and suppose the
kernel of `τ` is generated by a single element `e`. If the square

```
S ⟶ R
↓     ↓
S₁ ⟶ R₁
```

is a **pushout** of commutative rings and `τ₁ : R₁ ⟶ S₁` is a retraction of its lower edge
compatible with `τ`, then the kernel of `τ₁` is generated by the image of `e`.

## Main results

* `CommRingCat.ker_eq_span_singleton_map_of_isPushout`: **the kernel of the base-changed
  retraction is generated by the image of the generator.**
* `CommRingCat.ker_eq_span_singleton_of_iso_comp`: the generator of a principal kernel transported
  along identifications of the source and the target of the map.
* `IsIdempotentElem.eq_of_span_singleton_eq`: an ideal generated by an idempotent determines that
  idempotent, so the generator obtained this way is *the* idempotent of the base-changed kernel.
* `IsIdempotentElem.eq_of_zeroLocus_singleton_eq`: an idempotent is determined by its **zero
  locus**.

## References

* [Stacks Project, Tag 0DT9](https://stacks.math.columbia.edu/tag/0DT9)

## Tags

retraction, pushout, base change, kernel, idempotent
-/

@[expose] public section

open CategoryTheory

universe u

/-- **An ideal generated by an idempotent determines that idempotent.** If `e` and `f` are
idempotents of a commutative ring generating the same principal ideal then `e = f`. -/
theorem IsIdempotentElem.eq_of_span_singleton_eq {R : Type*} [CommRing R] {e f : R}
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (h : Ideal.span {e} = Ideal.span {f}) : e = f := by
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (h ▸ Ideal.mem_span_singleton_self e)
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (h.symm ▸ Ideal.mem_span_singleton_self f)
  calc e = f * e := by rw [← ha, ← mul_assoc, mul_comm f a, mul_assoc, hf]
    _ = e * f := mul_comm f e
    _ = f := by rw [← hb, ← mul_assoc, mul_comm e b, mul_assoc, he]

/-- An idempotent lying in the radical of an ideal lies in the ideal itself. -/
private theorem IsIdempotentElem.mem_of_mem_radical {R : Type*} [CommRing R] {e : R}
    (he : IsIdempotentElem e) {I : Ideal R} (h : e ∈ I.radical) : e ∈ I := by
  have hpow : ∀ m : ℕ, e ^ (m + 1) = e := by
    intro m
    induction m with
    | zero => simp
    | succ k ih => rw [pow_succ, ih]; exact he
  obtain ⟨n, hn⟩ := h
  match n with
  | 0 =>
    rw [pow_zero] at hn
    rw [(Ideal.eq_top_iff_one I).mpr hn]
    exact Submodule.mem_top
  | (m + 1) => rwa [hpow m] at hn

/-- **An idempotent is determined by its zero locus.** If two idempotents of a commutative ring
cut out the same closed subset of the spectrum then they are equal. -/
theorem IsIdempotentElem.eq_of_zeroLocus_singleton_eq {R : Type*} [CommRing R] {e f : R}
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (h : PrimeSpectrum.zeroLocus ({e} : Set R) = PrimeSpectrum.zeroLocus ({f} : Set R)) :
    e = f := by
  have hrad : (Ideal.span {e}).radical = (Ideal.span {f}).radical := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      PrimeSpectrum.zeroLocus_span, PrimeSpectrum.zeroLocus_span, h]
  have hef : e ∈ Ideal.span ({f} : Set R) := by
    refine he.mem_of_mem_radical ?_
    rw [← hrad]
    exact Ideal.le_radical (Ideal.mem_span_singleton_self e)
  have hfe : f ∈ Ideal.span ({e} : Set R) := by
    refine hf.mem_of_mem_radical ?_
    rw [hrad]
    exact Ideal.le_radical (Ideal.mem_span_singleton_self f)
  exact he.eq_of_span_singleton_eq hf
    (le_antisymm (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hef))
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hfe)))

namespace CommRingCat

/-- **The kernel of a retraction is carried to the kernel of its base change.** Around a pushout
square of commutative rings, if the left edge has a retraction whose kernel is generated by `e`
and the right edge has a compatible retraction, then the kernel of the latter is generated by the
image of `e`. -/
theorem ker_eq_span_singleton_map_of_isPushout {S R S₁ R₁ : CommRingCat.{u}} {ι : S ⟶ R}
    {ψ : S ⟶ S₁} {φ : R ⟶ R₁} {ι₁ : S₁ ⟶ R₁} (po : IsPushout ι ψ φ ι₁) {τ : R ⟶ S}
    {τ₁ : R₁ ⟶ S₁} (hτ : ι ≫ τ = 𝟙 S) (hτ₁ : ι₁ ≫ τ₁ = 𝟙 S₁) (hc : φ ≫ τ₁ = τ ≫ ψ) {e : R}
    (hker : RingHom.ker τ.hom = Ideal.span {e}) :
    RingHom.ker τ₁.hom = Ideal.span {φ.hom e} := by
  have heker : e ∈ RingHom.ker τ.hom := by rw [hker]; exact Ideal.mem_span_singleton_self e
  have heτ : τ.hom e = 0 := heker
  refine le_antisymm ?_ ?_
  · set I : Ideal R₁ := Ideal.span {φ.hom e} with hI
    set q : R₁ ⟶ CommRingCat.of (R₁ ⧸ I) := CommRingCat.ofHom (Ideal.Quotient.mk I) with hq
    have hr : ∀ r : R, φ.hom r - φ.hom (ι.hom (τ.hom r)) ∈ I := by
      intro r
      have hsub : r - ι.hom (τ.hom r) ∈ RingHom.ker τ.hom := by
        simp only [RingHom.mem_ker, map_sub]
        rw [← CommRingCat.comp_apply, hτ]
        simp
      rw [hker] at hsub
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hsub
      rw [← map_sub, hI]
      exact Ideal.mem_span_singleton'.mpr ⟨φ.hom a, by rw [← ha, map_mul]⟩
    have key : q = τ₁ ≫ ι₁ ≫ q := by
      refine po.hom_ext ?_ ?_
      · have hstep : φ ≫ τ₁ ≫ ι₁ ≫ q = τ ≫ ι ≫ φ ≫ q := by
          rw [← Category.assoc, hc, Category.assoc, ← Category.assoc ψ ι₁ q, ← po.w,
            Category.assoc]
        rw [hstep]
        ext r
        exact (Ideal.Quotient.eq.mpr (hr r)).symm ▸ rfl
      · rw [← Category.assoc, ← Category.assoc, hτ₁, Category.id_comp]
    intro z hz
    have hzker : τ₁.hom z = 0 := hz
    have h2 : q.hom z = q.hom (ι₁.hom (τ₁.hom z)) := congr($(key).hom z)
    rw [hzker, map_zero] at h2
    have hz0 : q.hom z = 0 := by rw [h2]; exact map_zero _
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hz0
  · refine Ideal.span_le.mpr ?_
    rintro x ⟨rfl⟩
    show τ₁.hom (φ.hom e) = 0
    rw [← CommRingCat.comp_apply, hc, CommRingCat.comp_apply, heτ, map_zero]

/-- **The generator of the kernel of a map read through identifications of its source and its
target.** If the kernel of `i⁻¹ ≫ T ≫ j` is generated by one element then the kernel of `T` is
generated by the image of that element under `i⁻¹`. -/
theorem ker_eq_span_singleton_of_iso_comp {R R' S S' : CommRingCat.{u}} (i : R ≅ R') (j : S ≅ S')
    (T : R ⟶ S) {ε : R'}
    (h : RingHom.ker (i.inv ≫ T ≫ j.hom).hom = Ideal.span {ε}) :
    RingHom.ker T.hom = Ideal.span {i.inv.hom ε} := by
  have hinv : ∀ z : R, i.inv.hom (i.hom.hom z) = z := fun z => congr($(i.hom_inv_id).hom z)
  have hjinj : Function.Injective j.hom.hom := fun a b hab => by
    have h2 := congrArg j.inv.hom hab
    rwa [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, j.hom_inv_id] at h2
  have hkey : ∀ z : R, (i.inv ≫ T ≫ j.hom).hom (i.hom.hom z) = j.hom.hom (T.hom z) := fun z => by
    show j.hom.hom (T.hom (i.inv.hom (i.hom.hom z))) = j.hom.hom (T.hom z)
    rw [hinv]
  have hεker : T.hom (i.inv.hom ε) = 0 := by
    have hmem : ε ∈ RingHom.ker (i.inv ≫ T ≫ j.hom).hom := by
      rw [h]; exact Ideal.mem_span_singleton_self ε
    have h0 : j.hom.hom (T.hom (i.inv.hom ε)) = 0 := hmem
    exact hjinj (h0.trans (map_zero j.hom.hom).symm)
  refine Ideal.ext fun z => ?_
  refine ⟨fun hz => ?_, fun hz => ?_⟩
  · have h1 : i.hom.hom z ∈ RingHom.ker (i.inv ≫ T ≫ j.hom).hom := by
      show (i.inv ≫ T ≫ j.hom).hom (i.hom.hom z) = 0
      rw [hkey z, show T.hom z = 0 from hz, map_zero]
    rw [h] at h1
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp h1
    refine Ideal.mem_span_singleton'.mpr ⟨i.inv.hom a, ?_⟩
    rw [← map_mul, ha, hinv]
  · obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hz
    show T.hom z = 0
    rw [← hb, map_mul, hεker, mul_zero]

end CommRingCat

end
