open TensorProduct



namespace Stacks.Etale.ZariskiFiniteFlatCover

/-- Transport of a factorization along an `R`-algebra map: if the canonical map
`R → Loc(A, g'')` factors through `X` and `ψ : A →ₐ[R] S'` carries `g''` to `g'`, then
`R → B` factors through `X` for every localization `B` of `S'` away from `g'`. -/
private lemma exists_comp_eq_of_algHom {R X A S' : Type*} [CommRing R] [CommRing X] [Algebra R X]
    [CommRing A] [Algebra R A] [CommRing S'] [Algebra R S'] (ψ : A →ₐ[R] S')
    {g'' : A} {g' : S'} (hg' : ψ g'' = g')
    (B : Type*) [CommRing B] [Algebra S' B] [IsLocalization.Away g' B]
    (φ₀ : X →+* Localization.Away g'')
    (hφ₀ : φ₀.comp (algebraMap R X) =
      (algebraMap A (Localization.Away g'')).comp (algebraMap R A)) :
    ∃ φ : X →+* B, φ.comp (algebraMap R X) = (algebraMap S' B).comp (algebraMap R S') := by
  have hu : ∀ y : Submonoid.powers g'', IsUnit (((algebraMap S' B).comp ψ.toRingHom) y) := by
    rintro ⟨y, n, rfl⟩
    simpa [hg'] using (IsLocalization.Away.algebraMap_isUnit (S := B) g').pow n
  refine ⟨(IsLocalization.lift (M := Submonoid.powers g'') hu).comp φ₀, ?_⟩
  rw [RingHom.comp_assoc, hφ₀, ← RingHom.comp_assoc, IsLocalization.lift_comp, RingHom.comp_assoc]
  congr 1
  exact ψ.comp_algebraMap

/-- The same transport, read as a statement about the primes over a fixed prime `p` of `R`: a
factorization of `R → Loc(A, g'')` through `X` at every prime of `A` over `p` gives one of
`R → Loc(S', g')` through `X` at every prime of `S'` over `p`, along any `ψ : A →ₐ[R] S'`. -/
private lemma exists_notMem_and_comp_eq_of_algHom {R X A S' : Type*} [CommRing R] [CommRing X]
    [Algebra R X] [CommRing A] [Algebra R A] [CommRing S'] [Algebra R S'] (ψ : A →ₐ[R] S')
    {p : Ideal R} {q' : Ideal S'} (hq' : q'.IsPrime) (hp : Ideal.under R q' = p)
    (H : ∀ q'' : Ideal A, q''.IsPrime → Ideal.under R q'' = p →
      ∃ g'' ∉ q'', ∃ φ : X →+* Localization.Away g'',
        φ.comp (algebraMap R X) = (algebraMap A (Localization.Away g'')).comp (algebraMap R A)) :
    ∃ g' ∉ q', ∃ φ : X →+* Localization.Away g',
      φ.comp (algebraMap R X) =
        (algebraMap S' (Localization.Away g')).comp (algebraMap R S') := by
  have := hq'
  have hcomap : Ideal.under R (q'.comap ψ.toRingHom) = p := by
    rw [show Ideal.under R (q'.comap ψ.toRingHom) = Ideal.under R q' by
      ext x; simp [Ideal.under_def, Ideal.mem_comap, AlgHom.commutes], hp]
  obtain ⟨g'', hg'', φ₀, hφ₀⟩ := H (q'.comap ψ.toRingHom) (Ideal.IsPrime.comap _) hcomap
  exact ⟨ψ g'', fun h => hg'' (Ideal.mem_comap.mpr h),
    exists_comp_eq_of_algHom ψ rfl _ φ₀ hφ₀⟩

/-- Stacks 00UE together with quasi-compactness of `Spec(S)` (Stacks 00E8): for `R → S` étale
there is a finite set `t` of elements of `S`, each with `R → S_g` standard étale, whose basic
opens cover `Spec(S)`. -/
private lemma exists_finset_isStandardEtale {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    [Algebra R S] [Algebra.Etale R S] :
    ∃ t : Finset S, (∀ g ∈ t, Algebra.IsStandardEtale R (Localization.Away g)) ∧
      ∀ q : Ideal S, q.IsPrime → ∃ g ∈ t, g ∉ q := by
  have hspan : Ideal.span {g : S | Algebra.IsStandardEtale R (Localization.Away g)} = ⊤ := by
    by_contra h
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ h
    have := hm.isPrime
    obtain ⟨g, hgm, hg⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (S := S) m
    exact hgm (hle (Ideal.subset_span hg))
  obtain ⟨t, hts, ht1⟩ :=
    Submodule.mem_span_finite_of_mem_span (hspan ▸ Submodule.mem_top (x := (1 : S)))
  refine ⟨t, fun g hg => hts hg, fun q hq => ?_⟩
  by_contra! h
  exact hq.ne_top ((Ideal.eq_top_iff_one _).2 (Ideal.span_le.2 (fun x hx => h x hx) ht1))

/-- The heart of Stacks 00UG: a finite flat cover `R → S'` which, for every `g` in a given finite
set of elements of `S` with `R → S_g` standard étale, receives `S_g` after localizing `S'` away
from a suitable element, prime by prime as in Stacks 00UF. The cover is the tensor product over
`R` of the covers Stacks 00UF supplies for the individual `S_g`. -/
private lemma exists_finite_faithfullyFlat_forall_mem_finset {R : Type u} [CommRing R]
    {S : Type v} [CommRing S] [Algebra R S] (t : Finset S)
    (ht : ∀ g ∈ t, Algebra.IsStandardEtale R (Localization.Away g)) :
    ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra R S') (_ : Module.Finite R S')
      (_ : Algebra.FinitePresentation R S') (_ : Module.FaithfullyFlat R S'),
      ∀ g ∈ t, ∀ q : Ideal (Localization.Away g), q.IsPrime → ∀ q' : Ideal S', q'.IsPrime →
        Ideal.under R q = Ideal.under R q' →
          ∃ g' ∉ q', ∃ φ : Localization.Away g →+* Localization.Away g',
            φ.comp (algebraMap R (Localization.Away g)) =
              (algebraMap S' (Localization.Away g')).comp (algebraMap R S') := by
  classical
  induction t using Finset.induction_on with
  | empty =>
    exact ⟨R, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, by simp⟩
  | @insert a s _ ih =>
    obtain ⟨U, hUr, hUa, hUf, hUp, hUff, hU⟩ :=
      ih fun g hg => ht g (Finset.mem_insert_of_mem hg)
    let := hUr; let := hUa; let := hUf; let := hUp; let := hUff
    let := ht a (Finset.mem_insert_self a s)
    obtain ⟨T, hTr, hTa, hTf, hTp, hTff, hT⟩ :=
      Algebra.IsStandardEtale.exists_finite_faithfullyFlat_forall_exists_comp_eq_comap_eq.{u, v, u}
        R (Localization.Away a)
    let := hTr; let := hTa; let := hTf; let := hTp; let := hTff
    refine ⟨U ⊗[R] T, inferInstance, inferInstance, inferInstance,
      Algebra.FinitePresentation.trans R U _, Module.FaithfullyFlat.trans R U _, ?_⟩
    intro g hg q hq q' hq' hqq'
    rcases Finset.mem_insert.mp hg with rfl | hgs
    · refine exists_notMem_and_comp_eq_of_algHom Algebra.TensorProduct.includeRight hq'
        hqq'.symm fun q'' h1 h2 => ?_
      obtain ⟨g'', hg'', hB⟩ := hT q hq q'' h1 h2.symm
      obtain ⟨φ, hφ, -⟩ := hB (Localization.Away g'') inferInstance inferInstance inferInstance
      exact ⟨g'', hg'', φ, hφ⟩
    · exact exists_notMem_and_comp_eq_of_algHom Algebra.TensorProduct.includeLeft hq' hqq'.symm
        fun q'' h1 h2 => hU g hgs q hq q'' h1 h2.symm

/-- An étale, faithfully flat `R`-algebra `S` is refined, up to Zariski localization
on `S'`, by one finite, finitely presented, faithfully flat `R`-algebra `S'`. This is the
statement of `Algebra.Etale.exists_finite_faithfullyFlat_forall_exists_comp_eq`. -/
public theorem solution (R : Type u) [CommRing R] (S : Type v) [CommRing S] [Algebra R S]
    [Algebra.Etale R S] [Module.FaithfullyFlat R S] :
    ∃ (S' : Type u) (_ : CommRing S') (_ : Algebra R S') (_ : Module.Finite R S')
      (_ : Algebra.FinitePresentation R S') (_ : Module.FaithfullyFlat R S'),
      ∀ (q' : Ideal S') (_ : q'.IsPrime), ∃ g' ∉ q', ∀ (B : Type w) (_ : CommRing B)
        (_ : Algebra S' B) (_ : IsLocalization.Away g' B), ∃ φ : S →+* B,
          φ.comp (algebraMap R S) = (algebraMap S' B).comp (algebraMap R S') := by
  obtain ⟨t, ht, hcover⟩ := exists_finset_isStandardEtale (R := R) (S := S)
  obtain ⟨S', hcr, halg, hfin, hfp, hff, H⟩ := exists_finite_faithfullyFlat_forall_mem_finset t ht
  let := hcr; let := halg; let := hfin; let := hfp; let := hff
  refine ⟨S', hcr, halg, hfin, hfp, hff, fun q' hq' => ?_⟩
  have := hq'
  obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := R) (B := S)
    ⟨Ideal.under R q', Ideal.IsPrime.under R q'⟩
  obtain ⟨g, hgt, hgQ⟩ := hcover Q.asIdeal Q.isPrime
  have hd : Disjoint (Submonoid.powers g : Set S) (Q.asIdeal : Set S) :=
    (Ideal.disjoint_powers_iff_notMem_of_isPrime _).mpr hgQ
  have hqp : (Q.asIdeal.map (algebraMap S (Localization.Away g))).IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (.powers g) _ _ Q.isPrime hd
  have hunder : Ideal.under R (Q.asIdeal.map (algebraMap S (Localization.Away g))) =
      Ideal.under R q' := by
    rw [← Ideal.under_under (A := R) (B := S),
      IsLocalization.under_map_of_isPrime_disjoint (.powers g) _ Q.isPrime hd, Ideal.under_def]
    exact congrArg PrimeSpectrum.asIdeal hQ
  obtain ⟨g', hg', φ₀, hφ₀⟩ := H g hgt _ hqp q' hq' hunder
  refine ⟨g', hg', fun B hcrB halgB hlocB => ?_⟩
  let := hcrB; let := halgB; let := hlocB
  refine exists_comp_eq_of_algHom (AlgHom.id R S') (g'' := g') (g' := g') rfl B
    (φ₀.comp (algebraMap S (Localization.Away g))) ?_
  rw [RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq, hφ₀]

end Stacks.Etale.ZariskiFiniteFlatCover

/-!
# A surjective étale cover is dominated by a finite flat cover, Zariski-locally

Let `R → S` be étale with `Spec(S) → Spec(R)` surjective. Then `R` admits a *single* finite flat
cover `R → S'` — finite, of finite presentation and faithfully flat, that is, finite projective as
an `R`-module and surjective on spectra — through which `R → S` factors after a Zariski
localization at each point of `Spec(S')`: for every prime `q' ⊂ S'` there is a `g' ∈ S'`,
`g' ∉ q'`, and a ring map `φ : S → S'_{g'}` making `R → S'_{g'}` factor as `R → S → S'_{g'}`.
Thus every étale covering of `R` is refined by a finite flat covering, up to Zariski
localization: the topology generated by Zariski coverings and finite flat coverings is at least as
fine as the étale topology.

The source's proof. By Proposition 00UE and quasi-compactness of `Spec(S)` (Lemma 00E8) there are
`g_1, …, g_n ∈ S` generating the unit ideal with each `R → S_{g_i}` standard étale; proving the
lemma for `R → ∏ S_{g_i}` proves it for `R → S`, so one may assume `S = ∏_{i} S_i` with each
`R → S_i` standard étale. Apply Lemma 00UF to each `R → S_i`, obtaining `R → S_i'` finite, finitely
presented and faithfully flat with the prime-by-prime factorization property, and set
`S' = S_1' ⊗_R ⋯ ⊗_R S_n'`. Properties (1) and (2) are immediate. Given a prime `q' ⊂ S'` lying
over `p ⊂ R`, choose `i` with `p` in the image of `Spec(S_i) → Spec(R)` — possible because
`Spec(S) → Spec(R)` is surjective, which is where hypothesis (2) enters — pick a prime `q ⊂ S_i`
over `p`, let `q_i'` be the contraction of `q'` to `S_i'`, and let `g_i' ∈ S_i'` and
`φ_i : S_i → (S_i')_{g_i'}` be as supplied by 00UF for the pair `q, q_i'`. Then `g_i'`, viewed in
`S'`, and the composite `S → S_i → (S_i')_{g_i'} → S'_{g_i'}` serve.

The typical instance: `R = ℚ` and `S = ℚ[x]/(x² + 1) ≅ ℚ(i)`, étale over `ℚ` since `x² + 1` is
separable, and surjective on spectra since both rings have a single prime. Here `S' = S` works,
with `q' = 0`, `g' = 1` and `φ` the identity — but `S' = R` does *not*: there is no `ℚ`-algebra map
`ℚ(i) → ℚ_{g'} = ℚ`. So the conclusion genuinely needs a nontrivial finite flat cover and is not
the Zariski-local splitting of `R → S`, which is what makes the étale topology strictly finer than
the Zariski one and this lemma a statement about finite flat descent.

## Main results

* `Algebra.Etale.exists_finite_faithfullyFlat_forall_exists_comp_eq`: Lemma 00UG.

## Implementation notes

Hypotheses (1) and (2) are `[Algebra.Etale R S]` together with `[Module.FaithfullyFlat R S]`. In
the presence of flatness, which `Algebra.Etale` supplies, faithful flatness is *equivalent* to
surjectivity of `Spec(S) → Spec(R)` — `Module.FaithfullyFlat.of_comap_surjective` one way and
`PrimeSpectrum.comap_surjective_of_faithfullyFlat` the other, both checked to close the
`↔` in Lean — so nothing is added or lost by fusing them, and the fused form is the one instance
resolution can discharge. The same fusion is used in the conclusion, where the source's (1) and (2)
for `R → S'` become `Module.Finite R S'`, `Algebra.FinitePresentation R S'` and
`Module.FaithfullyFlat R S'`; finite together with flat and finitely presented is the source's
parenthetical "finite projective as an `R`-module". This matches Lemma 00UF as stated in
`Algebra.IsStandardEtale.exists_finite_faithfullyFlat_forall_exists_comp_eq_comap_eq`, of which
this is the consumer. No `Nontrivial R` is needed: for `R = 0` the choice `S' = 0` works.

`S'` lives in the universe of `R`, since the source builds it from `R` as a tensor product of the
algebras produced by 00UF, which are themselves in the universe of `R`. The localization `S'_{g'}`
is allowed to be *any* localization of `S'` away from `g'`, in any universe: the conclusion
quantifies over an arbitrary `B` with `[IsLocalization.Away g' B]` rather than naming
`Localization.Away g'`, so that a user may supply their own model of it; by uniqueness of
localizations this is equivalent to the statement for `Localization.Away g'`.

Unlike 00UF, no prime of `S` is constrained: the source's clause (3) asserts only that the
factorization exists, the prime of `S` that the factoring map hits being chosen inside the proof
(and depending on `q'`). Only the existence of the factorization is claimed here, exactly as in the
source.

Faithfulness to [StacksProject 00UG]:

1. No dead hypothesis. `[Algebra.Etale R S]` is load-bearing: for `R = ℚ` and `S = ℚ(x)`, which is
   faithfully flat over `ℚ` but not étale, any finite `S'` has `S'_{g'}` finite-dimensional over
   `ℚ` and nonzero (`g' ∉ q'` with `q'` prime makes `g'` non-nilpotent), so an `R`-algebra map
   `ℚ(x) → S'_{g'}` would embed `ℚ(x)` into a finite-dimensional `ℚ`-algebra: impossible.
   `[Module.FaithfullyFlat R S]`, i.e. surjectivity of `Spec(S) → Spec(R)`, is load-bearing: for
   `R = ℤ`, `S = ℤ[1/2]`, étale but missing the prime `(2)`, a prime `q'` of a finite flat `S'`
   over `(2)` exists by faithful flatness of `S'`, and `2` is not invertible in `S'_{g'}` for any
   `g' ∉ q'`, since `q'S'_{g'}` is a prime containing `2`; so no `φ` factoring `R → S'_{g'}`
   through `S = ℤ[1/2]` exists. Primality of `q'` is what makes `q'S'_{g'}` a prime and `g'` a
   nonzerodivisor-free choice, and it is how the source phrases (3).
2. The scalars and the base are the source's. `S'` is an algebra over `R` itself, not over `S` or a
   localization of `R`; finiteness, finite presentation and faithful flatness are all over `R`;
   `g'` is an element of `S'` and `φ` is defined on all of `S`, not on a localization of it.
3. What the source names is pinned. `R → S'` is `algebraMap R S'` and `S' → S'_{g'}` is
   `algebraMap S' B`, and "the ring map `R → S'_{g'}` factors as `R → S → S'_{g'}`" is the equation
   `φ.comp (algebraMap R S) = (algebraMap S' B).comp (algebraMap R S')` between the two canonical
   maps, so `φ` is a map of `R`-algebras and not merely a ring map. Only `S'`, `g'` and `φ`, which
   the source also merely asserts to exist, are existentially quantified.
4. The instantiation is not degenerate. In the witness `R = ℚ`, `S = ℚ(i)` recorded above, `S` is
   neither `R` nor a localization of `R`, and `S' = R` provably fails, so the conclusion is not the
   tautology obtained from `S = R`, `S' = R`, `φ = id`.

