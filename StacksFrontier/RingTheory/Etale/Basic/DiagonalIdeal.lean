module

public import StacksFrontier.RingTheory.DifferentialOperator.Defs
public import Mathlib.RingTheory.RingHom.Etale
import StacksFrontier.RingTheory.Etale.AssociatedGraded
import StacksCore.Tactic.StacksAttribute

/-!
# Powers of the diagonal ideal under a formally étale extension

For a ring map `R → S` let `J ⊆ S ⊗[R] S` be the kernel of the multiplication map,
`KaehlerDifferential.ideal R S`; the quotient `(S ⊗[R] S) ⧸ J ^ (k + 1)` is the ring of functions
on the `k`-th order neighbourhood of the diagonal of `S` over `R`, and as an `S`-module through the
left factor it is the module of principal parts `Pᵏ_{S/R}(S)`. Along a formally étale `S → S'`
these neighbourhoods base change:
`S' ⊗_S ((S ⊗[R] S) ⧸ J ^ n) = (S' ⊗[R] S') ⧸ (J') ^ n`.

This file was split from `StacksFrontier.RingTheory.Etale.Basic`, which re-exports it.

## Main results

* `KaehlerDifferential.isBaseChange_quotient_ideal_pow_of_formallyEtale`: for `S → S'` formally
  étale, `(S' ⊗[R] S') ⧸ (J') ^ n` is the base change of `(S ⊗[R] S) ⧸ J ^ n` along `S → S'`.

## Implementation notes

The base change result is stated in the `IsBaseChange` form of
`KaehlerDifferential.isBaseChange_of_formallyEtale`, and the comparison map `φ` is a hypothesis
pinned by its values `hφ`. The `S`-module structure on `(S ⊗[R] S) ⧸ J ^ n` is the one through the
left factor (`Algebra.TensorProduct.leftAlgebra`). For `n = 0` both sides are the zero ring.

## References

* [StacksProject 0H93](https://stacks.math.columbia.edu/tag/0H93)
-/

@[expose] public section

universe u v w x y

open scoped TensorProduct

/-! ### Powers of the diagonal ideal under a formally étale extension -/

namespace KaehlerDifferential

/-! #### Base change and quotients -/

section General

variable {k k' A B : Type*} [CommRing k] [CommRing k'] [CommRing A] [CommRing B] [Algebra k k']
  [Algebra k A] [Algebra k B] [Algebra k' B] [IsScalarTower k k' B]

/-- If `p : A → B` exhibits `B` as the base change of `A` to `k'`, then `B` is `k' ⊗[k] A` as a
`k'`-algebra: this is `Algebra.IsPushout.equiv` for the `A`-algebra structure `p` puts on `B`. -/
private noncomputable def baseChangeEquiv {p : A →ₐ[k] B} (hp : IsBaseChange k' p.toLinearMap) :
    (k' ⊗[k] A) ≃ₐ[k'] B :=
  letI : Algebra A B := p.toRingHom.toAlgebra
  letI : IsScalarTower k A B := .of_algebraMap_eq fun x => (p.commutes x).symm
  haveI : Algebra.IsPushout k k' A B := ⟨hp⟩
  Algebra.IsPushout.equiv k k' A B

private lemma baseChangeEquiv_one_tmul {p : A →ₐ[k] B} (hp : IsBaseChange k' p.toLinearMap)
    (a : A) : baseChangeEquiv hp ((1 : k') ⊗ₜ[k] a) = p a := by
  rw [baseChangeEquiv, Algebra.IsPushout.equiv_tmul, map_one, one_mul,
    RingHom.algebraMap_toAlgebra]
  rfl

/-- `baseChangeEquiv hp` matches the ideal generated by the image of `K` in `k' ⊗[k] A` with the
ideal generated by the image of `K` under `p`. -/
private lemma map_map_baseChangeEquiv (K : Ideal A) {p : A →ₐ[k] B}
    (hp : IsBaseChange k' p.toLinearMap) :
    (K.map (Algebra.TensorProduct.includeRight (R := k) (A := k') (B := A))).map
      (baseChangeEquiv hp : (k' ⊗[k] A) →+* B) = K.map p :=
  (Ideal.map_map _ _).trans <| congrArg (K.map ·) <| RingHom.ext (baseChangeEquiv_one_tmul hp)

/-- Base change commutes with the quotient by an ideal: if `p : A → B` exhibits `B` as the base
change of `A` to `k'` and `L` is the ideal generated by the image of `K`, then `B ⧸ L` is the base
change of `A ⧸ K`. -/
private lemma isBaseChange_quotient {p : A →ₐ[k] B} (hp : IsBaseChange k' p.toLinearMap)
    {K : Ideal A} {L : Ideal B} (hL : L = K.map p) {ψ : (A ⧸ K) →ₐ[k] (B ⧸ L)}
    (hψ : ∀ a : A, ψ (Ideal.Quotient.mk K a) = Ideal.Quotient.mk L (p a)) :
    IsBaseChange k' ψ.toLinearMap := by
  refine IsBaseChange.of_equiv
    (((Algebra.TensorProduct.tensorQuotientEquiv (R := k) k' A k' K).trans
      (Ideal.quotientEquivAlg _ L (baseChangeEquiv hp)
        (hL.trans (map_map_baseChangeEquiv K hp).symm))).toLinearEquiv) fun x => ?_
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  simp only [AlgEquiv.toLinearEquiv_apply, AlgEquiv.trans_apply,
    Algebra.TensorProduct.tensorQuotientEquiv_apply_tmul, Ideal.quotientEquivAlg_mk,
    AlgHom.toLinearMap_apply, hψ a, baseChangeEquiv_one_tmul hp a]

/-- For a base change `p : A → B` of `k`-algebras with augmentations `μ` and `μ'`, every element of
`B` agrees with a scalar modulo the ideal generated by the image of the augmentation ideal of `A`.
-/
private lemma sub_algebraMap_mem_map_ker (μ : A →ₐ[k] k) (μ' : B →ₐ[k'] k') {p : A →ₐ[k] B}
    (hp : IsBaseChange k' p.toLinearMap) (hcomm : ∀ a, μ' (p a) = algebraMap k k' (μ a)) (y : B) :
    y - algebraMap k' B (μ' y) ∈ (RingHom.ker μ).map p := by
  refine hp.inductionOn y (fun a => ?_) (fun s n hn => ?_) fun n₁ n₂ h₁ h₂ => ?_
  · show p a - algebraMap k' B (μ' (p a)) ∈ _
    rw [hcomm a, ← IsScalarTower.algebraMap_apply k k' B, ← p.commutes, ← map_sub]
    exact Ideal.mem_map_of_mem _ (by simp [RingHom.mem_ker])
  · show s • n - algebraMap k' B (μ' (s • n)) ∈ _
    rw [map_smul, smul_eq_mul, map_mul, ← Algebra.smul_def, ← smul_sub, Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ hn
  · show n₁ + n₂ - algebraMap k' B (μ' (n₁ + n₂)) ∈ _
    rw [map_add, map_add, add_sub_add_comm]
    exact Ideal.add_mem _ h₁ h₂

/-- For a base change `p : A → B` of augmented `k`-algebras, the kernel of the augmentation of `B`
is generated by the image of the kernel of the augmentation of `A`. -/
private lemma ker_eq_map_of_isBaseChange (μ : A →ₐ[k] k) (μ' : B →ₐ[k'] k') {p : A →ₐ[k] B}
    (hp : IsBaseChange k' p.toLinearMap) (hcomm : ∀ a, μ' (p a) = algebraMap k k' (μ a)) :
    RingHom.ker μ' = (RingHom.ker μ).map p := by
  refine le_antisymm (fun x hx => ?_) (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_)
  · simpa [show μ' x = 0 from hx] using sub_algebraMap_mem_map_ker μ μ' hp hcomm x
  · simp only [Ideal.mem_comap, RingHom.mem_ker] at ha ⊢
    rw [hcomm a, ha, map_zero]

end General

/-! #### Formal étaleness of a ring isomorphism -/

/-- A ring isomorphism is formally étale. -/
private lemma formallyEtale_ringEquiv {A B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B) :
    e.toRingHom.FormallyEtale := by
  let _ : Algebra A B := e.toRingHom.toAlgebra
  exact Algebra.FormallyEtale.of_equiv (R := A) (A := A)
    (AlgEquiv.ofRingEquiv (f := e) fun _ => by simp [RingHom.algebraMap_toAlgebra])

/-! #### The two base changes `S ⊗[R] S → S' ⊗[R] S → S' ⊗[R] S'` -/

section Maps

variable {R : Type*} {S : Type*} {S' : Type*} [CommRing R] [CommRing S] [CommRing S'] [Algebra R S]
  [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']

/-- Base change of the left factor: `S ⊗[R] S → S' ⊗[R] S`. -/
private noncomputable def pmap : (S ⊗[R] S) →ₐ[S] (S' ⊗[R] S) :=
  Algebra.TensorProduct.map (Algebra.ofId S S') (AlgHom.id R S)

/-- Base change of the right factor: `S' ⊗[R] S → S' ⊗[R] S'`. -/
private noncomputable def qmap : (S' ⊗[R] S) →ₐ[S'] (S' ⊗[R] S') :=
  Algebra.TensorProduct.map (AlgHom.id S' S') (IsScalarTower.toAlgHom R S S')

/-- The same map as `qmap`, with the two factors exchanged: `S ⊗[R] S' → S' ⊗[R] S'`. -/
private noncomputable def qmapSwap : (S ⊗[R] S') →ₐ[S] (S' ⊗[R] S') :=
  Algebra.TensorProduct.map (Algebra.ofId S S') (AlgHom.id R S')

/-- The multiplication map `S' ⊗[R] S → S'`, `x ⊗ₜ b ↦ x * b`, presented as the multiplication map
of `S' ⊗[R] S'` composed with `qmap`. -/
private noncomputable def mulT : (S' ⊗[R] S) →ₐ[S'] S' :=
  (Algebra.TensorProduct.lmul'' R).comp qmap

private lemma ker_lmul'' :
    RingHom.ker (Algebra.TensorProduct.lmul'' (S := S) R) = KaehlerDifferential.ideal R S := rfl

private lemma mulT_pmap (a : S ⊗[R] S) :
    mulT (pmap (R := R) (S := S) (S' := S') a) =
      algebraMap S S' (Algebra.TensorProduct.lmul'' R a) := by
  induction a with
  | tmul a b => simp [pmap, qmap, mulT, Algebra.TensorProduct.lmul'']
  | add a b ha hb => simp [ha, hb]

private lemma isBaseChange_pmap :
    IsBaseChange S' (pmap (R := R) (S := S) (S' := S')).toLinearMap := by
  have he : (pmap (R := R) (S := S) (S' := S')).toLinearMap =
      TensorProduct.AlgebraTensorModule.map (Algebra.linearMap S S')
        (LinearMap.id (R := R) (M := S)) := by
    ext a
    simp [pmap]
  rw [he]
  exact isBaseChange_tensorProduct_map (R := R) (M := S) (N := S') (S := S) (P := S) S'
    (f := Algebra.linearMap S S') (IsBaseChange.linearMap S S')

end Maps

/-! #### Formal étaleness of the base change of the right factor -/

section FormallyEtale

variable {R : Type*} {S : Type*} {S' : Type*} [CommRing R] [CommRing S] [CommRing S'] [Algebra R S]
  [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']

/-- `S' ⊗[R] S'` is the base change of `S'` along `S → S ⊗[R] S'`. -/
private noncomputable def swapEquiv : ((S ⊗[R] S') ⊗[S] S') ≃+* (S' ⊗[R] S') :=
  (Algebra.TensorProduct.comm S (S ⊗[R] S') S').toRingEquiv.trans
    (Algebra.TensorProduct.cancelBaseChange R S S' S' S').toRingEquiv

private lemma swapEquiv_algebraMap (t : S ⊗[R] S') :
    swapEquiv (algebraMap (S ⊗[R] S') ((S ⊗[R] S') ⊗[S] S') t) =
      qmapSwap (R := R) (S := S) (S' := S') t := by
  induction t with
  | tmul s y =>
      simp [swapEquiv, qmapSwap, Algebra.TensorProduct.algebraMap_apply, Algebra.smul_def]
  | add t u ht hu => simp only [map_add, ht, hu]

private lemma formallyEtale_qmapSwap [Algebra.FormallyEtale S S'] :
    (qmapSwap (R := R) (S := S) (S' := S')).toRingHom.FormallyEtale := by
  let _ : Algebra (S ⊗[R] S') (S' ⊗[R] S') :=
    (qmapSwap (R := R) (S := S) (S' := S')).toRingHom.toAlgebra
  exact Algebra.FormallyEtale.of_equiv (R := S ⊗[R] S') (A := (S ⊗[R] S') ⊗[S] S')
    (AlgEquiv.ofRingEquiv (f := swapEquiv) fun t => by
      rw [RingHom.algebraMap_toAlgebra]
      exact swapEquiv_algebraMap t)

private lemma formallyEtale_qmap [Algebra.FormallyEtale S S'] :
    (qmap (R := R) (S := S) (S' := S')).toRingHom.FormallyEtale := by
  have hfactor : (qmap (R := R) (S := S) (S' := S')).toRingHom =
      ((Algebra.TensorProduct.comm R S' S').symm.toRingEquiv.toRingHom).comp
        (((qmapSwap (R := R) (S := S) (S' := S')).toRingHom).comp
          ((Algebra.TensorProduct.comm R S' S).toRingEquiv.toRingHom)) := by
    refine RingHom.ext fun t => ?_
    induction t with
    | tmul x b => simp [qmap, qmapSwap]
    | add t u ht hu => simp only [map_add, ht, hu]
  rw [hfactor]
  exact RingHom.FormallyEtale.comp
    (RingHom.FormallyEtale.comp (formallyEtale_ringEquiv _) formallyEtale_qmapSwap)
    (formallyEtale_ringEquiv _)

end FormallyEtale

/-! #### The kernel of the multiplication map of `S' ⊗[R] S` -/

section Iideal

variable {R : Type*} {S : Type*} {S' : Type*} [CommRing R] [CommRing S] [CommRing S'] [Algebra R S]
  [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']

/-- The contraction of `J'` along `qmap`: the kernel of the multiplication map `S' ⊗[R] S → S'`
(`iideal_eq_ker`). -/
private noncomputable abbrev iideal : Ideal (S' ⊗[R] S) :=
  FormallyEtaleH1D.Iideal (qmap (R := R) (S := S) (S' := S')).toRingHom
    (KaehlerDifferential.ideal R S')

/-- `I` is the kernel of the multiplication map `S' ⊗[R] S → S'`. -/
private lemma iideal_eq_ker :
    iideal (R := R) (S := S) (S' := S') = RingHom.ker (mulT (R := R) (S := S) (S' := S')) := by
  ext t
  have hl : t ∈ iideal (R := R) (S := S) (S' := S') ↔
      Algebra.TensorProduct.lmul'' R (qmap (R := R) (S := S) (S' := S') t) = 0 := by
    show Ideal.Quotient.mk (KaehlerDifferential.ideal R S')
        (qmap (R := R) (S := S) (S' := S') t) = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem, ← ker_lmul'']
    exact RingHom.mem_ker
  rw [hl]
  exact RingHom.mem_ker.symm

/-- `I` is generated by the image of `J`. -/
private lemma iideal_eq_map :
    iideal (R := R) (S := S) (S' := S') =
      (KaehlerDifferential.ideal R S).map (pmap (R := R) (S := S) (S' := S')) := by
  rw [iideal_eq_ker, ← ker_lmul'']
  exact ker_eq_map_of_isBaseChange (Algebra.TensorProduct.lmul'' R) mulT isBaseChange_pmap
    mulT_pmap

private lemma iideal_pow_eq_map (n : ℕ) :
    iideal (R := R) (S := S) (S' := S') ^ n =
      (KaehlerDifferential.ideal R S ^ n).map (pmap (R := R) (S := S) (S' := S')) := by
  rw [Ideal.map_pow, iideal_eq_map]

/-- `S' ⊗[R] S → (S' ⊗[R] S') ⧸ J'` is surjective. -/
private lemma surjective_mk_comp_qmap :
    Function.Surjective ((Ideal.Quotient.mk (KaehlerDifferential.ideal R S')).comp
      (qmap (R := R) (S := S) (S' := S')).toRingHom) := by
  intro z
  obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective z
  refine ⟨Algebra.TensorProduct.lmul' (S := S') R u ⊗ₜ[R] (1 : S), ?_⟩
  simp only [RingHom.comp_apply, Ideal.Quotient.mk_eq_mk_iff_sub_mem,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, RingHom.mem_ker, map_sub]
  simp [qmap]

/-- `FormallyEtaleH1D.quotMap` for `qmap` sends the class of `t` to the class of `qmap t`. -/
private lemma quotMap_qmap_mk (n : ℕ) (t : S' ⊗[R] S) :
    FormallyEtaleH1D.quotMap (qmap (R := R) (S := S) (S' := S')).toRingHom
        (KaehlerDifferential.ideal R S') n (Ideal.Quotient.mk _ t) =
      Ideal.Quotient.mk _ (qmap (R := R) (S := S) (S' := S') t) := by
  rw [FormallyEtaleH1D.quotMap, Ideal.quotientMap_mk]
  rfl

/-- The map of `FormallyEtaleH1D.quotMap` is a map of `S'`-algebras. -/
private lemma quotMap_algebraMap (n : ℕ) (s : S') :
    FormallyEtaleH1D.quotMap (qmap (R := R) (S := S) (S' := S')).toRingHom
        (KaehlerDifferential.ideal R S') n
        (algebraMap S' ((S' ⊗[R] S) ⧸ iideal (R := R) (S := S) (S' := S') ^ n) s) =
      algebraMap S' ((S' ⊗[R] S') ⧸ KaehlerDifferential.ideal R S' ^ n) s :=
  (quotMap_qmap_mk n _).trans <| congrArg (Ideal.Quotient.mk _)
    ((qmap (R := R) (S := S) (S' := S')).commutes s)

/-- The map `(S' ⊗[R] S) ⧸ I ^ n → (S' ⊗[R] S') ⧸ (J') ^ n` induced by `qmap` is bijective. -/
private lemma quotMap_qmap_bijective [Algebra.FormallyEtale S S'] (n : ℕ) :
    Function.Bijective (FormallyEtaleH1D.quotMap (qmap (R := R) (S := S) (S' := S')).toRingHom
      (KaehlerDifferential.ideal R S') n) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have h0 : Subsingleton ((S' ⊗[R] S) ⧸ iideal (R := R) (S := S) (S' := S') ^ 0) :=
      Ideal.Quotient.subsingleton_iff.mpr ((pow_zero _).trans Ideal.one_eq_top)
    have h1 : Subsingleton ((S' ⊗[R] S') ⧸ KaehlerDifferential.ideal R S' ^ 0) :=
      Ideal.Quotient.subsingleton_iff.mpr ((pow_zero _).trans Ideal.one_eq_top)
    exact ⟨fun a b _ => Subsingleton.elim a b, fun b => ⟨0, Subsingleton.elim _ _⟩⟩
  · exact FormallyEtaleH1D.quotMap_bijective _ _ formallyEtale_qmap surjective_mk_comp_qmap n hn

/-- The isomorphism of `S'`-algebras `(S' ⊗[R] S) ⧸ I ^ n ≃ (S' ⊗[R] S') ⧸ (J') ^ n` induced by
`qmap`. -/
private noncomputable def quotEquiv [Algebra.FormallyEtale S S'] (n : ℕ) :
    ((S' ⊗[R] S) ⧸ iideal (R := R) (S := S) (S' := S') ^ n) ≃ₐ[S']
      ((S' ⊗[R] S') ⧸ KaehlerDifferential.ideal R S' ^ n) :=
  AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective _ (quotMap_qmap_bijective n))
    (quotMap_algebraMap n)

private lemma quotEquiv_mk [Algebra.FormallyEtale S S'] (n : ℕ) (t : S' ⊗[R] S) :
    quotEquiv (R := R) (S := S) (S' := S') n (Ideal.Quotient.mk _ t) =
      Ideal.Quotient.mk _ (qmap (R := R) (S := S) (S' := S') t) :=
  quotMap_qmap_mk n t

/-- Base change of the left factor, on the quotients:
`(S ⊗[R] S) ⧸ J ^ n → (S' ⊗[R] S) ⧸ I ^ n`. -/
private noncomputable def pmapQuot (n : ℕ) :
    ((S ⊗[R] S) ⧸ KaehlerDifferential.ideal R S ^ n) →ₐ[S]
      ((S' ⊗[R] S) ⧸ iideal (R := R) (S := S) (S' := S') ^ n) :=
  Ideal.quotientMapₐ _ (pmap (R := R) (S := S) (S' := S'))
    (by rw [iideal_pow_eq_map]; exact Ideal.le_comap_map)

private lemma pmapQuot_mk (n : ℕ) (a : S ⊗[R] S) :
    pmapQuot (R := R) (S := S) (S' := S') n (Ideal.Quotient.mk _ a) =
      Ideal.Quotient.mk _ (pmap (R := R) (S := S) (S' := S') a) := rfl

/-- `(S' ⊗[R] S) ⧸ I ^ n` is the base change of `(S ⊗[R] S) ⧸ J ^ n` along `S → S'`. -/
private lemma isBaseChange_pmapQuot (n : ℕ) :
    IsBaseChange S' (pmapQuot (R := R) (S := S) (S' := S') n).toLinearMap :=
  isBaseChange_quotient (k' := S') (p := pmap (R := R) (S := S) (S' := S'))
    (K := KaehlerDifferential.ideal R S ^ n)
    (L := iideal (R := R) (S := S) (S' := S') ^ n)
    (ψ := pmapQuot (R := R) (S := S) (S' := S') n)
    isBaseChange_pmap (iideal_pow_eq_map n) (pmapQuot_mk n)

end Iideal

/-! #### The comparison of the two identifications -/

section Comparison

variable {R : Type*} {S : Type*} {S' : Type*} [CommRing R] [CommRing S] [CommRing S'] [Algebra R S]
  [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']

/-- The two identifications compose to `φ`: base change of the left factor followed by `quotEquiv`
sends the class of `a ⊗ₜ b` to the class of `a ⊗ₜ b`, which is what `hφ` says of `φ`. -/
private lemma quotEquiv_pmapQuot [Algebra.FormallyEtale S S'] (n : ℕ)
    (φ : ((S ⊗[R] S) ⧸ KaehlerDifferential.ideal R S ^ n) →ₐ[S]
      ((S' ⊗[R] S') ⧸ KaehlerDifferential.ideal R S' ^ n))
    (hφ : ∀ a b : S, φ (Ideal.Quotient.mk _ (a ⊗ₜ[R] b)) =
      Ideal.Quotient.mk _ (algebraMap S S' a ⊗ₜ[R] algebraMap S S' b))
    (y : (S ⊗[R] S) ⧸ KaehlerDifferential.ideal R S ^ n) :
    quotEquiv (R := R) (S := S) (S' := S') n (pmapQuot n y) = φ y := by
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
  induction a with
  | tmul a b =>
      rw [pmapQuot_mk, quotEquiv_mk, hφ a b]
      exact congrArg (Ideal.Quotient.mk (KaehlerDifferential.ideal R S' ^ n))
        (by simp [qmap, pmap])
  | add a b ha hb => simp only [map_add, ha, hb]
end Comparison

section Statement

variable {R : Type u} {S : Type v} {S' : Type w} [CommRing R] [CommRing S] [CommRing S']
variable [Algebra R S] [Algebra R S'] [Algebra S S'] [IsScalarTower R S S']

/-- Let `R → S → S'` be ring maps and let `J`, resp. `J'`, be the kernel of the
multiplication map `S ⊗[R] S → S`, resp. `S' ⊗[R] S' → S'`. If `S → S'` is formally étale, then
the canonical ring map `(S ⊗[R] S) ⧸ J ^ n → (S' ⊗[R] S') ⧸ (J') ^ n`, i.e. the unique one sending
the class of `a ⊗ₜ b` to the class of `a ⊗ₜ b`, exhibits its target as the base change of its
source along `S → S'`:
`S' ⊗_S ((S ⊗[R] S) ⧸ J ^ n) = (S' ⊗[R] S') ⧸ (J') ^ n`. -/
@[stacks 0H93 "Stated for an arbitrary exponent `n` in place of the source's `k + 1`, and in
Mathlib's `IsBaseChange` form; the map is the hypothesis `hφ`, which pins it. The source's final
assertion, that `S' ⊗_S Ω[S⁄R] → Ω[S'⁄R]` is an isomorphism, is
`KaehlerDifferential.isBaseChange_of_formallyEtale`. See the module docstring.",
  ega "IV 17.2.4" "affine case"]
theorem isBaseChange_quotient_ideal_pow_of_formallyEtale [Algebra.FormallyEtale S S']
    (n : ℕ)
    (φ : ((S ⊗[R] S) ⧸ KaehlerDifferential.ideal R S ^ n) →ₐ[S]
      ((S' ⊗[R] S') ⧸ KaehlerDifferential.ideal R S' ^ n))
    (hφ : ∀ a b : S, φ (Ideal.Quotient.mk _ (a ⊗ₜ[R] b)) =
      Ideal.Quotient.mk _ (algebraMap S S' a ⊗ₜ[R] algebraMap S S' b)) :
    IsBaseChange S' φ.toLinearMap := by
  refine IsBaseChange.of_equiv
    ((isBaseChange_pmapQuot n).equiv ≪≫ₗ (quotEquiv n).toLinearEquiv) fun x => ?_
  simp only [LinearEquiv.trans_apply, (isBaseChange_pmapQuot n).equiv_tmul, one_smul,
    AlgEquiv.toLinearEquiv_apply, AlgHom.toLinearMap_apply]
  exact quotEquiv_pmapQuot n φ hφ x

end Statement

