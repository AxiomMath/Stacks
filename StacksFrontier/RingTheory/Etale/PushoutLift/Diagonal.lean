module

public import Mathlib.RingTheory.Unramified.Basic
public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.Kaehler.Basic

/-!
# The diagonal idempotent of an unramified algebra which is an isomorphism modulo `I`

Let `B₀ → Γ₀` be a formally unramified ring map of essentially finite type. Then the kernel of the
multiplication `Γ₀ ⊗[B₀] Γ₀ → Γ₀` is generated by an idempotent, so there is an idempotent `ε₀`
(the *diagonal idempotent*) with `μ ε₀ = 1` which annihilates that kernel
(`exists_diagonal_idempotent`).

If moreover `B₀ → Γ₀ ⧸ I Γ₀` is surjective and `B₀ ⧸ I B₀ → Γ₀ ⧸ I Γ₀` is injective for an ideal
`I` of a base ring `A`, then the kernel of the multiplication lies in `I (Γ₀ ⊗[B₀] Γ₀)`
(`ideal_le_map_of_surjective_of_injective`): geometrically, the complement of the diagonal of
`Spec Γ₀ ×_{Spec B₀} Spec Γ₀` lies over `Spec A \ V(I)`.

## References

* [Stacks Project, Tag 0ALT](https://stacks.math.columbia.edu/tag/0ALT)
-/

@[expose] public section

open TensorProduct

namespace Stacks.Etale.PushoutLift

variable {B₀ Γ₀ : Type*} [CommRing B₀] [CommRing Γ₀] [Algebra B₀ Γ₀]

/-- **The diagonal idempotent.** For a formally unramified algebra of essentially finite type,
there is an idempotent `ε₀ ∈ Γ₀ ⊗[B₀] Γ₀` with `μ ε₀ = 1` which annihilates the kernel of the
multiplication `μ`, and `1 - ε₀` lies in that kernel. -/
theorem exists_diagonal_idempotent [Algebra.FormallyUnramified B₀ Γ₀]
    [Algebra.EssFiniteType B₀ Γ₀] :
    ∃ ε₀ : Γ₀ ⊗[B₀] Γ₀, IsIdempotentElem ε₀ ∧
      1 - ε₀ ∈ KaehlerDifferential.ideal B₀ Γ₀ ∧
      ∀ x ∈ KaehlerDifferential.ideal B₀ Γ₀, ε₀ * x = 0 := by
  obtain ⟨e, he, hsp⟩ : ∃ e, IsIdempotentElem e ∧
      KaehlerDifferential.ideal B₀ Γ₀ = (Γ₀ ⊗[B₀] Γ₀) ∙ e :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg B₀ Γ₀)).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[Γ₀⁄B₀]
  refine ⟨1 - e, he.one_sub, ?_, ?_⟩
  · rw [sub_sub_cancel, hsp]
    exact Submodule.mem_span_singleton_self e
  · intro x hx
    rw [hsp] at hx
    obtain ⟨y, rfl⟩ := Submodule.mem_span_singleton.mp hx
    rw [smul_eq_mul, sub_mul, one_mul, ← mul_assoc, mul_comm (e) y, mul_assoc, he.eq, sub_self]

variable {A : Type*} [CommRing A]

/-- An `A`-algebra map carries the extension of an ideal of `A` into its extension. -/
theorem mem_map_algebraMap_of_algHom (I : Ideal A) {X Y : Type*} [CommRing X] [CommRing Y]
    [Algebra A X] [Algebra A Y] (f : X →ₐ[A] Y) {x : X} (hx : x ∈ I.map (algebraMap A X)) :
    f x ∈ I.map (algebraMap A Y) := by
  have h : (f.toRingHom).comp (algebraMap A X) = algebraMap A Y := by
    ext a
    simp
  have := Ideal.mem_map_of_mem f.toRingHom hx
  rw [Ideal.map_map, h] at this
  exact this

variable [Algebra A B₀] [Algebra A Γ₀] [IsScalarTower A B₀ Γ₀]

/-- **The complement of the diagonal lies over `Spec A \ V(I)`.** If `B₀ → Γ₀ ⧸ I Γ₀` is surjective
and `B₀ ⧸ I B₀ → Γ₀ ⧸ I Γ₀` is injective, the kernel of the multiplication
`Γ₀ ⊗[B₀] Γ₀ → Γ₀` lies in `I (Γ₀ ⊗[B₀] Γ₀)`. -/
theorem ideal_le_map_of_surjective_of_injective (I : Ideal A)
    (hsurj : ∀ y : Γ₀, ∃ b : B₀, y - algebraMap B₀ Γ₀ b ∈ I.map (algebraMap A Γ₀))
    (hinj : ∀ b : B₀, algebraMap B₀ Γ₀ b ∈ I.map (algebraMap A Γ₀) →
      b ∈ I.map (algebraMap A B₀)) :
    KaehlerDifferential.ideal B₀ Γ₀ ≤ I.map (algebraMap A (Γ₀ ⊗[B₀] Γ₀)) := by
  set 𝔦 := I.map (algebraMap A (Γ₀ ⊗[B₀] Γ₀))
  let iL : Γ₀ →ₐ[B₀] Γ₀ ⊗[B₀] Γ₀ := Algebra.TensorProduct.includeLeft
  let iR : Γ₀ →ₐ[B₀] Γ₀ ⊗[B₀] Γ₀ := Algebra.TensorProduct.includeRight
  have hmem : ∀ (f : Γ₀ →ₐ[B₀] Γ₀ ⊗[B₀] Γ₀) (y : Γ₀) (b : B₀),
      y - algebraMap B₀ Γ₀ b ∈ I.map (algebraMap A Γ₀) →
      f y - algebraMap B₀ (Γ₀ ⊗[B₀] Γ₀) b ∈ 𝔦 := fun f y b h => by
    have := mem_map_algebraMap_of_algHom I (f.restrictScalars A) h
    rwa [AlgHom.coe_restrictScalars', map_sub, AlgHom.commutes] at this
  have key : ∀ z : Γ₀ ⊗[B₀] Γ₀, ∃ b : B₀, z - algebraMap B₀ (Γ₀ ⊗[B₀] Γ₀) b ∈ 𝔦 := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul y y' =>
      obtain ⟨b, hb⟩ := hsurj y
      obtain ⟨b', hb'⟩ := hsurj y'
      refine ⟨b * b', ?_⟩
      have h1 := hmem iL y b hb
      have h2 := hmem iR y' b' hb'
      have hyy : y ⊗ₜ[B₀] y' = iL y * iR y' := by simp [iL, iR]
      have : iL y * iR y' - algebraMap B₀ (Γ₀ ⊗[B₀] Γ₀) (b * b') =
          (iL y - algebraMap B₀ _ b) * iR y' +
            algebraMap B₀ _ b * (iR y' - algebraMap B₀ _ b') := by
        rw [map_mul]
        ring
      rw [hyy, this]
      exact add_mem (Ideal.mul_mem_right _ _ h1) (Ideal.mul_mem_left _ _ h2)
    | add z w hz hw =>
      obtain ⟨b, hb⟩ := hz
      obtain ⟨b', hb'⟩ := hw
      refine ⟨b + b', ?_⟩
      rw [map_add, add_sub_add_comm]
      exact add_mem hb hb'
  intro z hz
  obtain ⟨b, hb⟩ := key z
  have hμ : Algebra.TensorProduct.lmul' B₀ z = 0 := hz
  have hmap : ∀ w ∈ 𝔦, Algebra.TensorProduct.lmul' (S := Γ₀) B₀ w ∈ I.map (algebraMap A Γ₀) :=
    fun w hw => mem_map_algebraMap_of_algHom I
      ((Algebra.TensorProduct.lmul' (S := Γ₀) B₀).restrictScalars A) hw
  have h1 := hmap _ hb
  rw [map_sub, hμ, zero_sub, neg_mem_iff, AlgHom.commutes] at h1
  have h2 := hinj b h1
  have h3 : algebraMap B₀ (Γ₀ ⊗[B₀] Γ₀) b ∈ 𝔦 := by
    have := Ideal.mem_map_of_mem (algebraMap B₀ (Γ₀ ⊗[B₀] Γ₀)) h2
    rwa [Ideal.map_map, ← IsScalarTower.algebraMap_eq] at this
  have := add_mem hb h3
  rwa [sub_add_cancel] at this

end Stacks.Etale.PushoutLift

end
