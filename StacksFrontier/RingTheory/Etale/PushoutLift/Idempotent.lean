module

public import Mathlib.RingTheory.Idempotents
public import StacksFrontier.RingTheory.Etale.PushoutLift.LiftOverOpen

/-!
# Ring maps into a ring split by an idempotent

Let `ε` be an idempotent of a commutative ring `Δ`. A ring map into `Δ` is the same as a pair of
ring maps into `Δ ⧸ (1 - ε)` and `Δ ⧸ (ε)`. This file records two consequences.

## Main definitions

* `Stacks.Etale.PushoutLift.Twist`: a type synonym of a ring, carrying the same ring structure.

## Main results

* `exists_ringHom_mul_idempotent`: given `f₁ : Γ → Δ` and `f₂ : Γ → Δ ⧸ (ε)` there is a ring map
  `s : Γ → Δ` which agrees with `f₁` after multiplication by `ε` and with `f₂` modulo `ε`.
* `algHom_ext_of_idempotent`: two `A`-algebra maps `Γ → T` agree as soon as they agree modulo a
  nilpotent ideal and after multiplication by an idempotent `η` such that `(T ⧸ (η)) ⊗[A] Γ` is
  formally étale over `T ⧸ (η)`.

## References

* [Stacks Project, Tag 0ALT](https://stacks.math.columbia.edu/tag/0ALT)
-/
@[expose] public section

open TensorProduct

namespace Stacks.Etale.PushoutLift

/-- The type synonym `Twist X` of `X`. -/
def Twist (X : Type*) : Type _ := X

/-- The commutative ring structure on `Twist X` is that of `X`. -/
instance {X : Type*} [CommRing X] : CommRing (Twist X) := inferInstanceAs (CommRing X)

/-- The identity of `X`, viewed as a ring isomorphism `X ≃+* Twist X`. -/
def Twist.equiv (X : Type*) [CommRing X] : X ≃+* Twist X := RingEquiv.refl X

/-- `Twist.equiv X` sends `x` to `x`. -/
lemma Twist.equiv_apply {X : Type*} [CommRing X] (x : X) : Twist.equiv X x = x := rfl

/-- The inverse of `Twist.equiv X` sends `x` to `x`. -/
lemma Twist.equiv_symm_apply {X : Type*} [CommRing X] (x : Twist X) :
    (Twist.equiv X).symm x = x := rfl

/-- An element of the ideal generated by an idempotent `e` is fixed by multiplication by `e`. -/
private theorem mul_eq_self_of_mem_span_idempotent {R : Type*} [CommRing R] {e y : R}
    (he : IsIdempotentElem e) (hy : y ∈ Ideal.span {e}) : y * e = y := by
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.1 hy
  rw [mul_assoc, he.eq]

variable {Γ Δ : Type*} [CommRing Γ] [CommRing Δ]

/-- **A ring map into a ring split by an idempotent.** For an idempotent `ε ∈ Δ`, a ring map
`f₁ : Γ → Δ` and a ring map `f₂ : Γ → Δ ⧸ (ε)`, there is a ring map `s : Γ → Δ` with
`ε * s x = ε * f₁ x` and `s x ≡ f₂ x` modulo `ε`. -/
theorem exists_ringHom_mul_idempotent {ε : Δ} (hε : IsIdempotentElem ε) (f₁ : Γ →+* Δ)
    (f₂ : Γ →+* Δ ⧸ Ideal.span {ε}) :
    ∃ s : Γ →+* Δ, (∀ x, ε * s x = ε * f₁ x) ∧ ∀ x, Ideal.Quotient.mk _ (s x) = f₂ x := by
  have hb := RingHom.prod_bijective_of_isIdempotentElem hε.one_sub hε (sub_add_cancel 1 ε)
    (by rw [sub_mul, one_mul, hε.eq, sub_self])
  let e := RingEquiv.ofBijective _ hb
  let s : Γ →+* Δ := e.symm.toRingHom.comp
    (((Ideal.Quotient.mk (Ideal.span {1 - ε})).comp f₁).prod f₂)
  have hs : ∀ x, e (s x) = (Ideal.Quotient.mk _ (f₁ x), f₂ x) := fun x => by
    simp [s]
  refine ⟨s, fun x => ?_, fun x => ?_⟩
  · have h1 := congrArg Prod.fst (hs x)
    change Ideal.Quotient.mk _ (s x) = Ideal.Quotient.mk _ (f₁ x) at h1
    rw [Ideal.Quotient.eq] at h1
    rw [← sub_eq_zero, ← mul_sub, ← mul_eq_self_of_mem_span_idempotent hε.one_sub h1,
      mul_left_comm, hε.mul_one_sub_self, mul_zero]
  · exact congrArg Prod.snd (hs x)

variable {A : Type*} [CommRing A] [Algebra A Γ]

/-- **Extensionality across an idempotent.** Let `η` be an idempotent of an `A`-algebra `T` such
that `(T ⧸ (η)) ⊗[A] Γ` is formally étale over `T ⧸ (η)` (for example `Γ` étale over
`Spec A \ V(I)` and `I` generating the unit ideal of `T ⧸ (η)`), and let `N` be a nilpotent ideal
of `T`. Two `A`-algebra maps `Γ → T` which agree modulo `N` and after multiplication
by `η` agree. -/
theorem algHom_ext_of_idempotent
    {T : Type*} [CommRing T] [Algebra A T] {η : T} (hη : IsIdempotentElem η)
    (hT : Algebra.FormallyEtale (T ⧸ Ideal.span {η}) ((T ⧸ Ideal.span {η}) ⊗[A] Γ))
    (N : Ideal T) (hN : IsNilpotent N)
    {f₁ f₂ : Γ →ₐ[A] T} (hmod : ∀ x, f₁ x - f₂ x ∈ N) (hmul : ∀ x, f₁ x * η = f₂ x * η) :
    f₁ = f₂ := by
  let q := Ideal.Quotient.mkₐ A (Ideal.span {η})
  have hN' : IsNilpotent (N.map q) := by
    obtain ⟨n, hn⟩ := hN
    refine ⟨n, ?_⟩
    rw [← Ideal.map_pow, hn]
    exact Ideal.map_bot
  have hq : q.comp f₁ = q.comp f₂ := by
    refine ext_of_map_eq_top hT (N.map q) hN' fun x => ?_
    rw [Ideal.Quotient.eq]
    have := Ideal.mem_map_of_mem q (hmod x)
    simpa using this
  ext x
  have h1 := AlgHom.congr_fun hq x
  simp only [AlgHom.coe_comp, Function.comp_apply, q, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.eq] at h1
  rw [← sub_eq_zero, ← mul_eq_self_of_mem_span_idempotent hη h1, sub_mul, hmul, sub_self]

end Stacks.Etale.PushoutLift

end
