module

public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.RingTheory.Kaehler.Basic
public import StacksFrontier.RingTheory.Etale.PushoutLift.Idempotent
public import StacksFrontier.RingTheory.Etale.PushoutLift.Diagonal

/-!
# The unit and the second projection of the lifted Čech groupoid

Let `A` be a ring, `I, J ⊆ A` ideals with `J` nilpotent, `Γ` an `A`-algebra étale over
`Spec A \ V(I)`, `Γ → Γ₀` a surjection with kernel `J Γ` and `B₀ → Γ₀` a ring map of `A`-algebras.
Let `Δ` be a formally smooth `Γ`-algebra together with a surjection `ψ : Δ → Δ₀ = Γ₀ ⊗[B₀] Γ₀` of
`Γ`-algebras with kernel `J Δ` (`Γ` acting on `Δ₀` through the left factor), and let `ε ∈ Δ` be an
idempotent lifting a diagonal idempotent `ε₀` of `Δ₀` whose complement `1 - ε₀` lies in `I Δ₀`.

We construct

* the *unit* `e : Δ → Γ` (`unit`), the `Γ`-algebra map lifting the multiplication
  `Δ₀ → Γ₀`, which satisfies `e ε = 1`;
* the *second projection* `s : Γ → Δ` (`exists_secondProjection`), an `A`-algebra map lifting the
  inclusion of the second factor `Γ₀ → Δ₀`, with `ε s(x) = ε t(x)` (where `t = algebraMap Γ Δ`)
  and `e ∘ s = id`.

The second projection is built on the two pieces of `Δ` cut out by `ε`: on the diagonal piece it
is `t`, and on the off-diagonal piece, which lies over `Spec A \ V(I)`, it is the unique lift
provided by `Stacks.Etale.PushoutLift.exists_lift_of_map_eq_top`.

## References

* [Stacks Project, Tag 0ALT](https://stacks.math.columbia.edu/tag/0ALT)
-/

@[expose] public section

open TensorProduct

universe u

namespace Stacks.Etale.PushoutLift

/-- The extension of a nilpotent ideal of `A` to any `A`-algebra is nilpotent. -/
theorem isNilpotent_map_algebraMap {A : Type*} [CommRing A] {J : Ideal A} (hJ : IsNilpotent J)
    (X : Type*) [CommRing X] [Algebra A X] : IsNilpotent (J.map (algebraMap A X)) := by
  obtain ⟨n, hn⟩ := hJ
  refine ⟨n, ?_⟩
  rw [← Ideal.map_pow, hn]
  exact Ideal.map_bot

/-- Elements of a nilpotent ideal are nilpotent. -/
theorem isNilpotent_of_mem {R : Type*} [CommRing R] {N : Ideal R} (hN : IsNilpotent N) {x : R}
    (hx : x ∈ N) : IsNilpotent x := by
  obtain ⟨n, hn⟩ := hN
  refine ⟨n, ?_⟩
  have := Ideal.pow_mem_pow hx n
  rw [hn] at this
  exact (Submodule.mem_bot _).mp this

/-- An element of the ideal generated by an idempotent `ε` which `ε` annihilates is zero. -/
theorem eq_zero_of_mem_span_idempotent {R : Type*} [CommRing R] {ε z : R}
    (hε : IsIdempotentElem ε) (hz : z ∈ Ideal.span {ε}) (h : ε * z = 0) : z = 0 := by
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  rw [mul_comm, mul_assoc, hε.eq] at h
  rw [h]

variable {A : Type u} [CommRing A] (I J : Ideal A)
variable {Γ : Type u} [CommRing Γ] [Algebra A Γ]
variable {B₀ : Type u} [CommRing B₀] [Algebra A B₀]
variable {Γ₀ : Type u} [CommRing Γ₀] [Algebra A Γ₀] [Algebra Γ Γ₀] [IsScalarTower A Γ Γ₀]
  [Algebra B₀ Γ₀] [IsScalarTower A B₀ Γ₀]
variable {Δ : Type u} [CommRing Δ] [Algebra Γ Δ] [Algebra A Δ] [IsScalarTower A Γ Δ]
variable (ψ : Δ →ₐ[Γ] Γ₀ ⊗[B₀] Γ₀)

section OffDiagonal

variable (hψ : Function.Surjective ψ) (hψker : RingHom.ker ψ = J.map (algebraMap A Δ))
variable {ε₀ : Γ₀ ⊗[B₀] Γ₀} (hε₀k : 1 - ε₀ ∈ KaehlerDifferential.ideal B₀ Γ₀)
variable {ε : Δ} (hεψ : ψ ε = ε₀)

include hψ hψker hεψ hε₀k in
/-- `1 - ε` lies in `(I + J) Δ`. -/
lemma one_sub_idempotent_mem
    (hdiag : KaehlerDifferential.ideal B₀ Γ₀ ≤ I.map (algebraMap A (Γ₀ ⊗[B₀] Γ₀))) :
    1 - ε ∈ I.map (algebraMap A Δ) ⊔ J.map (algebraMap A Δ) := by
  have hcomp : (ψ.toRingHom).comp (algebraMap A Δ) = algebraMap A (Γ₀ ⊗[B₀] Γ₀) := by
    ext a
    simp [IsScalarTower.algebraMap_apply A Γ Γ₀]
  have h1 : ψ (1 - ε) ∈ (I.map (algebraMap A Δ)).map ψ.toRingHom := by
    rw [Ideal.map_map, hcomp, map_sub, map_one, hεψ]
    exact hdiag hε₀k
  obtain ⟨y, hy, hyψ⟩ := (Ideal.mem_map_iff_of_surjective _ hψ).mp h1
  have h2 : 1 - ε - y ∈ J.map (algebraMap A Δ) := by
    rw [← hψker, RingHom.mem_ker, map_sub]
    rw [← hyψ]
    exact sub_self _
  have := Submodule.add_mem_sup hy h2
  rwa [add_sub_cancel] at this

include hψ hψker hεψ hε₀k in
/-- `I` generates the unit ideal of the off-diagonal piece `Δ ⧸ (ε)`. -/
lemma map_eq_top_offDiagonal (hJ : IsNilpotent J)
    (hdiag : KaehlerDifferential.ideal B₀ Γ₀ ≤ I.map (algebraMap A (Γ₀ ⊗[B₀] Γ₀))) :
    I.map (algebraMap A (Δ ⧸ Ideal.span {ε})) = ⊤ := by
  have h := one_sub_idempotent_mem I J ψ hψ hψker hε₀k hεψ hdiag
  have h' := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {ε})) h
  have hq : (Ideal.Quotient.mk (Ideal.span {ε})).comp (algebraMap A Δ) =
      algebraMap A (Δ ⧸ Ideal.span {ε}) := rfl
  rw [Ideal.map_sup, Ideal.map_map, Ideal.map_map, hq,
    map_sub, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self ε),
    sub_zero] at h'
  refine eq_top_of_sup_eq_top_of_isNilpotent (isNilpotent_map_algebraMap hJ _) ?_
  exact (Ideal.eq_top_iff_one _).mpr h'

omit [Algebra A Γ] [Algebra A B₀] [Algebra A Γ₀] [IsScalarTower A Γ Γ₀] [IsScalarTower A B₀ Γ₀]
  [IsScalarTower A Γ Δ] in
include hψker in
/-- The kernel of `ψ` is contained in the kernel of the projection `Δ → (Δ ⧸ (ε)) ⧸ J`. -/
lemma ker_le_offDiagonal :
    RingHom.ker ψ ≤ RingHom.ker ((Ideal.Quotient.mkₐ A
      (J.map (algebraMap A (Δ ⧸ Ideal.span {ε})))).comp
        (Ideal.Quotient.mkₐ A (Ideal.span {ε}))) := by
  rw [hψker]
  intro x hx
  rw [RingHom.mem_ker, AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk,
    Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
  exact mem_map_algebraMap_of_algHom J (Ideal.Quotient.mkₐ A (Ideal.span {ε})) hx

/-- The comparison `Δ₀ → (Δ ⧸ (ε)) ⧸ J`, induced by `ψ`. -/
noncomputable def offDiagonalBar :
    Γ₀ ⊗[B₀] Γ₀ →ₐ[A] (Δ ⧸ Ideal.span {ε}) ⧸ J.map (algebraMap A (Δ ⧸ Ideal.span {ε})) :=
  (Ideal.Quotient.liftₐ (RingHom.ker ψ) ((Ideal.Quotient.mkₐ A _).comp
      (Ideal.Quotient.mkₐ A (Ideal.span {ε})))
    (fun _ hx => (ker_le_offDiagonal J ψ hψker) hx)).comp
    ((Ideal.quotientKerAlgEquivOfSurjective hψ).symm.toAlgHom.restrictScalars A)

/-- `offDiagonalBar` sends `ψ d` to the image of `d` in `(Δ ⧸ (ε)) ⧸ J`. -/
lemma offDiagonalBar_apply (d : Δ) :
    offDiagonalBar J ψ hψ hψker (ε := ε) (ψ d) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.span {ε}) d) := by
  have : (Ideal.quotientKerAlgEquivOfSurjective hψ).symm (ψ d) =
      Ideal.Quotient.mk (RingHom.ker ψ) d := by
    rw [AlgEquiv.symm_apply_eq]
    rfl
  simp only [offDiagonalBar, AlgHom.coe_comp, Function.comp_apply, AlgHom.coe_restrictScalars',
    AlgEquiv.coe_toAlgHom, this]
  rfl

end OffDiagonal

section Unit

variable [Algebra.FormallySmooth Γ Δ]
variable (hΓ₀ : Function.Surjective (algebraMap Γ Γ₀))
  (hΓ₀ker : RingHom.ker (algebraMap Γ Γ₀) = J.map (algebraMap A Γ)) (hJ : IsNilpotent J)

/-- The multiplication `Δ → Δ₀ → Γ₀`, as a map of `Γ`-algebras. -/
noncomputable def unitBar : Δ →ₐ[Γ] Γ₀ :=
  ((Algebra.TensorProduct.lmul'' (R := B₀) (S := Γ₀)).restrictScalars Γ).comp ψ

omit [Algebra A Γ₀] [IsScalarTower A Γ Γ₀] in
include hΓ₀ker hJ in
/-- The kernel of `Γ → Γ₀` is a nilpotent ideal. -/
lemma isNilpotent_ker_algebraMap :
    IsNilpotent (RingHom.ker (Algebra.ofId Γ Γ₀ : Γ →+* Γ₀)) := by
  show IsNilpotent (RingHom.ker (algebraMap Γ Γ₀))
  rw [hΓ₀ker]
  exact isNilpotent_map_algebraMap hJ Γ

/-- **The unit** `e : Δ → Γ`, the lift of the multiplication `Δ → Δ₀ → Γ₀` along the nilpotent
thickening `Γ → Γ₀`. -/
noncomputable def unit : Δ →ₐ[Γ] Γ :=
  Algebra.FormallySmooth.liftOfSurjective (unitBar ψ) (Algebra.ofId Γ Γ₀) hΓ₀
    (isNilpotent_ker_algebraMap J hΓ₀ker hJ)

omit [Algebra A B₀] [Algebra A Γ₀] [IsScalarTower A Γ Γ₀] [IsScalarTower A B₀ Γ₀] [Algebra A Δ]
  [IsScalarTower A Γ Δ] in
/-- The image of `e d` in `Γ₀` is the product of the two factors of `ψ d`. -/
lemma algebraMap_unit (d : Δ) :
    algebraMap Γ Γ₀ (unit J ψ hΓ₀ hΓ₀ker hJ d) =
      Algebra.TensorProduct.lmul'' (R := B₀) (S := Γ₀) (ψ d) :=
  Algebra.FormallySmooth.liftOfSurjective_apply (unitBar ψ) (Algebra.ofId Γ Γ₀) hΓ₀
    (isNilpotent_ker_algebraMap J hΓ₀ker hJ) d

variable {ε₀ : Γ₀ ⊗[B₀] Γ₀} (hε₀k : 1 - ε₀ ∈ KaehlerDifferential.ideal B₀ Γ₀)
variable {ε : Δ} (hε : IsIdempotentElem ε) (hεψ : ψ ε = ε₀)

omit [Algebra A B₀] [Algebra A Γ₀] [IsScalarTower A Γ Γ₀] [IsScalarTower A B₀ Γ₀] [Algebra A Δ]
  [IsScalarTower A Γ Δ] in
include hε₀k hε hεψ in
/-- The unit takes the value `1` on the lifted diagonal idempotent. -/
lemma unit_idempotent : unit J ψ hΓ₀ hΓ₀ker hJ ε = 1 := by
  have h1 : algebraMap Γ Γ₀ (unit J ψ hΓ₀ hΓ₀ker hJ ε) = 1 := by
    rw [algebraMap_unit, hεψ]
    have : Algebra.TensorProduct.lmul' B₀ (1 - ε₀) = 0 := hε₀k
    rw [map_sub, map_one, sub_eq_zero] at this
    exact this.symm
  refine eq_of_isNilpotent_sub_of_isIdempotentElem (hε.map (unit J ψ hΓ₀ hΓ₀ker hJ))
    IsIdempotentElem.one ?_
  refine isNilpotent_of_mem (isNilpotent_map_algebraMap hJ Γ) ?_
  rw [← hΓ₀ker, RingHom.mem_ker, map_sub, h1, map_one, sub_self]

end Unit

section SecondProjection

variable [Algebra.FormallySmooth Γ Δ]
variable (hΓ₀ : Function.Surjective (algebraMap Γ Γ₀))
  (hΓ₀ker : RingHom.ker (algebraMap Γ Γ₀) = J.map (algebraMap A Γ)) (hJ : IsNilpotent J)
variable (hψ : Function.Surjective ψ) (hψker : RingHom.ker ψ = J.map (algebraMap A Δ))
variable {ε₀ : Γ₀ ⊗[B₀] Γ₀} (hε₀k : 1 - ε₀ ∈ KaehlerDifferential.ideal B₀ Γ₀)
  (hε₀ : ∀ x ∈ KaehlerDifferential.ideal B₀ Γ₀, ε₀ * x = 0)
variable {ε : Δ} (hε : IsIdempotentElem ε) (hεψ : ψ ε = ε₀)
variable (hΓU : ∀ (T : Type u) [CommRing T] [Algebra A T], I.map (algebraMap A T) = ⊤ →
    Algebra.FormallyEtale T (T ⊗[A] Γ))
  (hdiag : KaehlerDifferential.ideal B₀ Γ₀ ≤ I.map (algebraMap A (Γ₀ ⊗[B₀] Γ₀)))

/-- The inclusion of the second factor `Γ → Γ₀ → Δ₀`. -/
noncomputable def secondBar : Γ →ₐ[A] Γ₀ ⊗[B₀] Γ₀ :=
  ((Algebra.TensorProduct.includeRight : Γ₀ →ₐ[B₀] Γ₀ ⊗[B₀] Γ₀).restrictScalars A).comp
    (IsScalarTower.toAlgHom A Γ Γ₀)

include hJ hψ hψker hε₀k hε₀ hε hεψ hΓU hdiag in
/-- **The second projection.** There is an `A`-algebra map `s : Γ → Δ` lifting the inclusion of
the second factor, with `ε s(x) = ε t(x)` and `e ∘ s = id`. -/
theorem exists_secondProjection :
    ∃ s : Γ →ₐ[A] Δ, (∀ x, ε * s x = ε * algebraMap Γ Δ x) ∧
      (∀ x, ψ (s x) = Algebra.TensorProduct.includeRight (algebraMap Γ Γ₀ x)) ∧
      (∀ x, unit J ψ hΓ₀ hΓ₀ker hJ (s x) = x) := by
  set T := Δ ⧸ Ideal.span {ε}
  have hT : I.map (algebraMap A T) = ⊤ :=
    map_eq_top_offDiagonal I J ψ hψ hψker hε₀k hεψ hJ hdiag
  obtain ⟨sR, hsR⟩ := exists_lift_of_map_eq_top (hΓU T hT) (J.map (algebraMap A T))
    (isNilpotent_map_algebraMap hJ T)
    ((offDiagonalBar J ψ hψ hψker (ε := ε)).comp
      (secondBar (A := A) (Γ := Γ) (B₀ := B₀) (Γ₀ := Γ₀)))
  obtain ⟨s₁, h1, h2⟩ := exists_ringHom_mul_idempotent hε (algebraMap Γ Δ) sR.toRingHom
  have hA : ∀ a : A, s₁ (algebraMap A Γ a) = algebraMap A Δ a := by
    intro a
    have hz : s₁ (algebraMap A Γ a) - algebraMap A Δ a ∈ Ideal.span {ε} := by
      rw [← Ideal.Quotient.eq, h2]
      exact sR.commutes a
    refine sub_eq_zero.mp (eq_zero_of_mem_span_idempotent hε hz ?_)
    rw [mul_sub, h1, ← IsScalarTower.algebraMap_apply, sub_self]
  let s : Γ →ₐ[A] Δ := { s₁ with commutes' := hA }
  have hs1 : ∀ x, ε * s x = ε * algebraMap Γ Δ x := h1
  have hunit : ∀ x, unit J ψ hΓ₀ hΓ₀ker hJ (s x) = x := by
    intro x
    have := congrArg (unit J ψ hΓ₀ hΓ₀ker hJ) (hs1 x)
    rwa [map_mul, map_mul, unit_idempotent J ψ hΓ₀ hΓ₀ker hJ hε₀k hε hεψ, one_mul, one_mul,
      AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply] at this
  refine ⟨s, hs1, fun x => ?_, hunit⟩
  set y := algebraMap Γ Γ₀ x
  have hdec : ψ (s x) = ε₀ * ψ (s x) + (1 - ε₀) * ψ (s x) := by ring
  have hdiagpart : ε₀ * ψ (s x) = ε₀ * Algebra.TensorProduct.includeRight y := by
    have := congrArg ψ (hs1 x)
    rw [map_mul, map_mul, hεψ, AlgHom.commutes] at this
    rw [this]
    have hk : algebraMap Γ (Γ₀ ⊗[B₀] Γ₀) x - Algebra.TensorProduct.includeRight y ∈
        KaehlerDifferential.ideal B₀ Γ₀ := by
      rw [RingHom.mem_ker, map_sub]
      simp [Algebra.TensorProduct.algebraMap_apply, y]
    have := hε₀ _ hk
    rw [mul_sub, sub_eq_zero] at this
    exact this
  have hoff : (1 - ε₀) * ψ (s x) = (1 - ε₀) * Algebra.TensorProduct.includeRight y := by
    obtain ⟨d, hd⟩ := hψ (ψ (s x) - Algebra.TensorProduct.includeRight y)
    have hsx : Ideal.Quotient.mk (Ideal.span {ε}) (s x) = sR x := h2 x
    have hbar : offDiagonalBar J ψ hψ hψker (ε := ε) (ψ d) = 0 := by
      rw [hd, map_sub, offDiagonalBar_apply, hsx]
      have := AlgHom.congr_fun hsR x
      simp only [AlgHom.coe_comp, Function.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
      show Ideal.Quotient.mk _ (sR x) - _ = 0
      rw [this]
      simp [secondBar, y]
    rw [offDiagonalBar_apply, Ideal.Quotient.eq_zero_iff_mem] at hbar
    have hJT : J.map (algebraMap A T) =
        (J.map (algebraMap A Δ)).map (Ideal.Quotient.mk (Ideal.span {ε})) := by
      rw [Ideal.map_map]
      rfl
    rw [hJT] at hbar
    obtain ⟨d', hd', hdd'⟩ := (Ideal.mem_map_iff_of_surjective _
      Ideal.Quotient.mk_surjective).mp hbar
    have hdiff : d - d' ∈ Ideal.span {ε} := by
      rw [← Ideal.Quotient.eq, hdd']
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hdiff
    have hψd' : ψ d' = 0 := by rw [← RingHom.mem_ker, hψker]; exact hd'
    have : ψ d = ψ a * ε₀ := by
      rw [← hεψ, ← map_mul, ha, map_sub, hψd', sub_zero]
    have hε₀i : IsIdempotentElem ε₀ := hεψ ▸ hε.map ψ
    rw [← sub_eq_zero, ← mul_sub, ← hd, this, mul_comm (ψ a), ← mul_assoc, sub_mul, one_mul,
      hε₀i.eq, sub_self, zero_mul]
  rw [hdec, hdiagpart, hoff, ← add_mul, add_sub_cancel, one_mul]

end SecondProjection

end Stacks.Etale.PushoutLift

end
