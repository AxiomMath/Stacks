module

public import Mathlib.Algebra.Lie.OfAssociative
public import Mathlib.RingTheory.MvPolynomial.IrreducibleQuadratic
public import Mathlib.RingTheory.Smooth.StandardSmoothOfFree
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Étale ring maps lift along surjections of rings

Let $A' \twoheadrightarrow A$ be a surjection of commutative rings with kernel $I$, and let $B$ be
a commutative $A$-algebra whose structure map $A \to B$ is étale. Then $B$ is the reduction of an
étale $A'$-algebra: there are a commutative $A'$-algebra $C$ with $A' \to C$ étale and a
surjection of $A'$-algebras $\psi : C \to B$ whose kernel is $IC$, the ideal of $C$ generated by
the image of $I$. Equivalently $B \cong C/IC$ as $(A'/I)$-algebras, the quotient $C/IC$ carrying
its canonical $(A'/I)$-algebra structure because $I$ maps into $IC$. This is Stacks tag 04D1.

A ring map is *étale* when it is flat, of finite presentation and unramified; equivalently, by
Stacks 00U9 (`Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero`), standard smooth of
relative dimension $0$, which is the form the construction uses. Taking $A = A'/I$, write
$B = (A'/I)[x_1,\dots,x_n]/(\overline{f}_1,\dots,\overline{f}_n)$ with
$\overline{\Delta} = \det(\partial \overline{f}_i/\partial x_j)$ invertible in $B$, lift the
$\overline{f}_i$ to $f_i \in A'[x_1,\dots,x_n]$, and put
$$C = A'[x_1,\dots,x_n,x_{n+1}]/(f_1,\dots,f_n,\ x_{n+1}\Delta - 1), \qquad
\Delta = \det(\partial f_i/\partial x_j).$$
The extra variable inverts $\Delta$, so $C$ carries a submersive presentation of relative
dimension $0$ and $A' \to C$ is again étale; base change along $A' \to A'/I$ inverts the already
invertible $\overline{\Delta}$, hence changes nothing and recovers $B$.

## Main definitions

* `tensorQuotientAlgEquiv`: the canonical $(R/I)$-algebra isomorphism
  $(R/I) \otimes_R S \cong S/IS$ for an $R$-algebra $S$.

## Main results

* `etale_lift_along_surjection`: étale ring maps lift along surjections of rings, as above.
* `etale_lift_construction`: the lift of a relative-dimension-$0$ submersive presentation of $B$
  over $R/I$ to one of $C$ over $R$, together with the base-change isomorphism
  $(R/I) \otimes_R C \cong B$.

## Implementation notes

The base of the étale algebra to be lifted is an arbitrary ring $A$ with a surjection from $A'$
rather than the literal quotient $A'/I$ of the source, and the conclusion is a surjection $\psi$
with $\ker \psi = IC$ rather than an isomorphism $B \cong C/IC$. The two forms differ by transport
along the isomorphism $A'/I \cong A$ of `RingHom.quotientKerEquivOfSurjective`. The construction
itself is carried out over a literal quotient, in the private `etale_lift_of_quotient`.

The three rings live in independent universes. The lift $C$, being a quotient of a localization of
a polynomial ring over $A'$, lives in the universe of $A'$.
-/

@[expose] public section

universe u v w

open Algebra TensorProduct in
/-- Let `P₀` be a pre-submersive presentation of `S₀` over `R`, with generators `ι` and relations
`σ`, and let `S` be a localization of `S₀` away from `Δ₀ = P₀.jacobian`. Then the Jacobian of the
presentation `((localizationAway S Δ₀).comp P₀).reindex (sumComm ι Unit) (sumComm σ Unit)` of `S`
over `R` is a unit in `S`. -/
theorem etale_lift_jacobian_isUnit
    (R : Type u) [CommRing R] (S₀ : Type u) [CommRing S₀] [Algebra R S₀]
    (ι σ : Type) [Finite σ]
    (P₀ : Algebra.PreSubmersivePresentation R S₀ ι σ)
    (S : Type u) [CommRing S] [Algebra R S] [Algebra S₀ S] [IsScalarTower R S₀ S]
    [IsLocalization.Away P₀.jacobian S] :
    IsUnit (((Algebra.PreSubmersivePresentation.localizationAway S P₀.jacobian).comp P₀).reindex
      (Equiv.sumComm ι Unit) (Equiv.sumComm σ Unit)).jacobian := by
  rw [Algebra.PreSubmersivePresentation.jacobian_reindex,
      Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
      Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
  have hu : IsUnit (algebraMap S₀ S P₀.jacobian) :=
    IsLocalization.Away.algebraMap_isUnit P₀.jacobian
  exact hu.mul hu

-- needed: `etale_lift_baseChange_iso` leaves goals unsolved otherwise — the
-- `IsLocalization.atUnit` collapse needs `(R ⧸ I) ⊗[R] S₀` and `Sbar` defeq
-- without respecting transparency.
set_option backward.isDefEq.respectTransparency false in
open Algebra TensorProduct in
/-- Let `P` be a submersive presentation of `Sbar` over `R ⧸ I`, let `f` be a family of
polynomials over `R` lifting the relations of `P`, let `P₀` be the naive pre-submersive
presentation of `S₀ = MvPolynomial ι R ⧸ span (range f)` with the generators `P.map`, and let `S`
be a localization of `S₀` away from `P₀.jacobian`. Then `(R ⧸ I) ⊗[R] S` and `Sbar` are isomorphic
as `(R ⧸ I)`-algebras. -/
theorem etale_lift_baseChange_iso
    (R : Type u) [CommRing R] (I : Ideal R)
    (Sbar : Type*) [CommRing Sbar] [Algebra (R ⧸ I) Sbar]
    (ι σ : Type) [Finite σ]
    (P : Algebra.SubmersivePresentation (R ⧸ I) Sbar ι σ)
    (f : σ → MvPolynomial ι R)
    (hf : ∀ j, MvPolynomial.map (Ideal.Quotient.mk I) (f j) = P.relation j)
    (S : Type u) [CommRing S] [Algebra R S]
    [Algebra (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) S]
    [IsScalarTower R (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) S]
    [IsLocalization.Away
      (Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := f))
        P.map P.map_inj).jacobian S] :
    Nonempty (((R ⧸ I) ⊗[R] S) ≃ₐ[R ⧸ I] Sbar) := by
  classical
  set P₀ := Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := f))
        P.map P.map_inj with hP₀
  set QP := (P₀.toPresentation).baseChange (R ⧸ I) with hQP
  have hrel : QP.relation = P.relation := by
    funext i
    rw [hQP, Algebra.Presentation.baseChange_relation, Ideal.Quotient.algebraMap_eq,
        show P₀.toPresentation = Algebra.Presentation.naive (v := f) from rfl,
        Algebra.Presentation.naive_relation]
    exact hf i
  have hker : QP.ker = P.ker := by
    rw [← Algebra.Presentation.span_range_relation_eq_ker,
        ← Algebra.Presentation.span_range_relation_eq_ker, hrel]
  let eQ := (QP.quotientEquiv.symm).restrictScalars (R ⧸ I)
  let ekereq := (Ideal.quotientEquivAlgOfEq QP.Ring hker).restrictScalars (R ⧸ I)
  let eP := (P.toPresentation.quotientEquiv).restrictScalars (R ⧸ I)
  let e0 := eQ.trans (ekereq.trans eP)
  have e1 := IsLocalization.Away.tensorProductEquivTMulRight R (R ⧸ I) P₀.jacobian S
  set x : (R ⧸ I) ⊗[R] (MvPolynomial ι R ⧸ Ideal.span (Set.range f)) :=
    (1 : R ⧸ I) ⊗ₜ[R] P₀.jacobian with hx
  set QP' := P₀.baseChange (R ⧸ I) with hQP'
  have hfin : Fintype σ := Fintype.ofFinite σ
  have hmat : QP'.jacobiMatrix = P.jacobiMatrix := by
    ext i j
    rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    have h1 : QP'.map i = P.map i := rfl
    have h2 : QP'.relation j = P.relation j := by
      change QP.relation j = P.relation j; rw [hrel]
    rw [h1, h2]
  have hxjac : x = QP'.jacobian := by
    rw [hx, hQP', Algebra.PreSubmersivePresentation.baseChange_jacobian]
  have he0x : e0 x = P.jacobian := by
    have hunfold : e0 x = P.toPresentation.quotientEquiv
        ((Ideal.quotientEquivAlgOfEq QP.Ring hker) (QP.quotientEquiv.symm x)) := rfl
    rw [hunfold, hxjac, Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det QP', hmat]
    rw [show QP.quotientEquiv.symm (algebraMap QP'.Ring _ P.jacobiMatrix.det)
        = Ideal.Quotient.mk QP.ker P.jacobiMatrix.det from by
          rw [AlgEquiv.symm_apply_eq, Algebra.Presentation.quotientEquiv_mk]]
    rw [Ideal.quotientEquivAlgOfEq_mk, Algebra.Presentation.quotientEquiv_mk]
    exact (Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det
      P.toPreSubmersivePresentation).symm
  have hux : IsUnit x := by
    have h : IsUnit (e0.toRingEquiv x) := by
      change IsUnit (e0 x); rw [he0x]; exact P.jacobian_isUnit
    rw [← e0.toRingEquiv.symm_apply_apply x]
    exact h.map e0.toRingEquiv.symm
  exact ⟨e1.trans (((IsLocalization.atUnit _ _ x hux).symm.restrictScalars (R ⧸ I)).trans e0)⟩

open Algebra TensorProduct in
/-- Let `P` be a submersive presentation of `Sbar` over `R ⧸ I`, with generators `ι` and
relations `σ`. Then there are an `R`-algebra `S` and a pre-submersive presentation `Q` of `S` over
`R`, with generators `ι ⊕ Unit` and relations `σ ⊕ Unit`, such that `Q.jacobian` is a unit and
`(R ⧸ I) ⊗[R] S ≃ₐ[R ⧸ I] Sbar`. Explicitly, `S = R[x, t] / (f, t Δ - 1)` for lifts `f` of the
relations of `P` and the determinant `Δ` of their Jacobian matrix. -/
@[ega "IV 18.1.1" "special case"]
theorem etale_lift_presentation
    (R : Type u) [CommRing R] (I : Ideal R)
    (Sbar : Type*) [CommRing Sbar] [Algebra (R ⧸ I) Sbar]
    (ι σ : Type) [Finite σ] [Finite ι]
    (P : Algebra.SubmersivePresentation (R ⧸ I) Sbar ι σ) :
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S)
      (Q : Algebra.PreSubmersivePresentation R S (ι ⊕ Unit) (σ ⊕ Unit)),
      IsUnit Q.jacobian ∧ Nonempty (((R ⧸ I) ⊗[R] S) ≃ₐ[R ⧸ I] Sbar) := by
  classical
  choose f hf using fun j => MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
      (P.relation j)
  let S₀ := MvPolynomial ι R ⧸ Ideal.span (Set.range f)
  let P₀ : Algebra.PreSubmersivePresentation R S₀ ι σ :=
    Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := f)) P.map P.map_inj
  let Δ₀ : S₀ := P₀.jacobian
  let S := Localization.Away Δ₀
  let Q : Algebra.PreSubmersivePresentation R S (ι ⊕ Unit) (σ ⊕ Unit) :=
    ((Algebra.PreSubmersivePresentation.localizationAway S Δ₀).comp P₀).reindex
      (Equiv.sumComm ι Unit) (Equiv.sumComm σ Unit)
  exact ⟨S, inferInstance, inferInstance, Q, etale_lift_jacobian_isUnit R S₀ ι σ P₀ S,
    etale_lift_baseChange_iso R I Sbar ι σ P f hf S⟩

open Algebra TensorProduct in
/-- Let `P` be a submersive presentation of relative dimension `0` of `Sbar` over `R ⧸ I`, with
generators `ι` and relations `σ`. Then there are an `R`-algebra `S` and a submersive presentation
`Q` of relative dimension `0` of `S` over `R`, with generators `ι ⊕ Unit` and relations
`σ ⊕ Unit`, such that `(R ⧸ I) ⊗[R] S ≃ₐ[R ⧸ I] Sbar`. -/
@[ega "IV 18.1.1" "special case"]
theorem etale_lift_construction
    (R : Type u) [CommRing R] (I : Ideal R)
    (Sbar : Type*) [CommRing Sbar] [Algebra (R ⧸ I) Sbar]
    (ι σ : Type) [Finite σ] [Finite ι]
    (P : Algebra.SubmersivePresentation (R ⧸ I) Sbar ι σ) (hP : P.dimension = 0) :
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S)
      (Q : Algebra.SubmersivePresentation R S (ι ⊕ Unit) (σ ⊕ Unit)),
      Q.dimension = 0 ∧ Nonempty (((R ⧸ I) ⊗[R] S) ≃ₐ[R ⧸ I] Sbar) := by
  classical
  obtain ⟨S, _, _, Q₀, hQunit, ⟨eBase⟩⟩ := etale_lift_presentation R I Sbar ι σ P
  refine ⟨S, inferInstance, inferInstance, Algebra.SubmersivePresentation.mk Q₀ hQunit, ?_, ⟨eBase⟩⟩
  have hcardσ : Nat.card σ ≤ Nat.card ι := Nat.card_le_card_of_injective _ P.map_inj
  have hPdim : P.dimension = Nat.card ι - Nat.card σ := rfl
  change Nat.card (ι ⊕ Unit) - Nat.card (σ ⊕ Unit) = 0
  rw [Nat.card_sum, Nat.card_sum]
  omega

-- needed: `tensorQuotientAlgEquiv`'s `Ideal.map (algebraMap R S) I` let-binding must
-- unfold non-transparently for the remaining algebra-map goals to close.
set_option backward.isDefEq.respectTransparency false in
open TensorProduct in
/-- The canonical `(R ⧸ I)`-algebra isomorphism between the base change of an
`R`-algebra `S` to `R ⧸ I` and the quotient `S ⧸ I·S`. -/
noncomputable def tensorQuotientAlgEquiv
    (R : Type*) [CommRing R] (I : Ideal R) (S : Type*) [CommRing S] [Algebra R S] :
    ((R ⧸ I) ⊗[R] S) ≃ₐ[R ⧸ I] (S ⧸ I.map (algebraMap R S)) := by
  set J := I.map (algebraMap R S) with hJ
  let fwd : ((R ⧸ I) ⊗[R] S) →ₐ[R ⧸ I] (S ⧸ J) :=
    Algebra.TensorProduct.lift (Algebra.ofId (R ⧸ I) (S ⧸ J))
      (Ideal.Quotient.mkₐ R J) (fun _ _ => mul_comm _ _)
  let inc : S →ₐ[R] ((R ⧸ I) ⊗[R] S) := Algebra.TensorProduct.includeRight
  have hker : J ≤ RingHom.ker inc.toRingHom := by
    rw [hJ, Ideal.map_le_iff_le_comap]
    intro r hr
    simp only [Ideal.mem_comap, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    change inc (algebraMap R S r) = 0
    rw [inc.commutes r, Algebra.TensorProduct.algebraMap_apply,
      show (algebraMap R (R ⧸ I)) r = 0 from
        (Ideal.Quotient.algebraMap_eq I ▸ (Ideal.Quotient.eq_zero_iff_mem).mpr hr)]
    simp
  let inv : (S ⧸ J) →ₐ[R] ((R ⧸ I) ⊗[R] S) := Ideal.Quotient.liftₐ J inc hker
  have hfwd : ∀ (a : R ⧸ I) (s : S),
      fwd (a ⊗ₜ[R] s) = (Algebra.ofId (R ⧸ I) (S ⧸ J)) a * (Ideal.Quotient.mk J s) := by
    intro a s
    simp only [fwd, Algebra.TensorProduct.lift_tmul, Ideal.Quotient.mkₐ_eq_mk]
  have hinv : ∀ (s : S), inv (Ideal.Quotient.mk J s) = inc s := by
    intro s
    simp only [inv, Ideal.Quotient.liftₐ_apply, Ideal.Quotient.lift_mk]
    rfl
  refine AlgEquiv.ofBijective fwd ?_
  rw [Function.bijective_iff_has_inverse]
  refine ⟨inv, ?_, ?_⟩
  · intro y
    induction y using TensorProduct.inductionOn with
    | tmul a s =>
        rw [hfwd]
        obtain ⟨a₀, rfl⟩ := Ideal.Quotient.mk_surjective a
        have hofId : (Algebra.ofId (R ⧸ I) (S ⧸ J)) (Ideal.Quotient.mk I a₀)
            = Ideal.Quotient.mk J (algebraMap R S a₀) := by
          rw [Algebra.ofId_apply,
            show (algebraMap (R ⧸ I) (S ⧸ J)) (Ideal.Quotient.mk I a₀)
                = algebraMap R (S ⧸ J) a₀ from by
              rw [IsScalarTower.algebraMap_apply R (R ⧸ I) (S ⧸ J), Ideal.Quotient.algebraMap_eq],
            IsScalarTower.algebraMap_apply R S (S ⧸ J), Ideal.Quotient.algebraMap_eq]
        rw [hofId, ← map_mul, hinv]
        change inc (algebraMap R S a₀ * s) = _
        rw [map_mul]
        change (inc (algebraMap R S a₀)) * (1 ⊗ₜ[R] s) = _
        rw [inc.commutes a₀, Algebra.TensorProduct.algebraMap_apply,
          Ideal.Quotient.algebraMap_eq, Algebra.TensorProduct.tmul_mul_tmul]
        simp
    | add x y hx hy => simp only [map_add, hx, hy]
  · intro x
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [hinv]
    change fwd (inc s) = _
    rw [show inc s = (1 : R ⧸ I) ⊗ₜ[R] s from rfl, hfwd, map_one, one_mul]

/-- If `Sbar` is an étale `(R ⧸ I)`-algebra, then there is an étale `R`-algebra `S`, in the
universe of `R`, together with an isomorphism of `(R ⧸ I)`-algebras
`Sbar ≃ₐ[R ⧸ I] (S ⧸ I.map (algebraMap R S))`. -/
private theorem etale_lift_of_quotient (R : Type u) [CommRing R] (I : Ideal R)
    (Sbar : Type v) [CommRing Sbar] [Algebra (R ⧸ I) Sbar] [Algebra.Etale (R ⧸ I) Sbar] :
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra R S), Algebra.Etale R S ∧
      Nonempty (Sbar ≃ₐ[R ⧸ I] (S ⧸ I.map (algebraMap R S))) := by
  classical
  have hss : Algebra.IsStandardSmoothOfRelativeDimension 0 (R ⧸ I) Sbar :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
  obtain ⟨ι, σ, _, _, P, hP⟩ := hss.out
  obtain ⟨S, _, _, Q, hQdim, ⟨eBase⟩⟩ := etale_lift_construction R I Sbar ι σ P hP
  exact ⟨S, inferInstance, inferInstance,
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr
      (Q.isStandardSmoothOfRelativeDimension hQdim),
    ⟨eBase.symm.trans (tensorQuotientAlgEquiv R I S)⟩⟩

/-- Étale ring maps lift along surjections of rings: if `A' → A` is a surjection of commutative
rings with kernel `I` and `B` is an étale `A`-algebra, then `B` is the reduction of an étale
`A'`-algebra, in the sense that there are an étale `A'`-algebra `C` and a surjection of
`A'`-algebras `ψ : C → B` with `RingHom.ker ψ = I C`. -/
@[stacks 04D1, ega "IV 18.1.1" "special case"]
theorem etale_lift_along_surjection (A' : Type u) (A : Type v) (B : Type w)
    [CommRing A'] [CommRing A] [CommRing B] [Algebra A' A] [Algebra A B] [Algebra A' B]
    [IsScalarTower A' A B] (hA : Function.Surjective (algebraMap A' A)) [Algebra.Etale A B] :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A' C), Algebra.Etale A' C ∧
      ∃ ψ : C →ₐ[A'] B, Function.Surjective ψ ∧
        RingHom.ker (ψ : C →+* B) = (RingHom.ker (algebraMap A' A)).map (algebraMap A' C) := by
  set I := RingHom.ker (algebraMap A' A)
  let e : A' ⧸ I ≃+* A := RingHom.quotientKerEquivOfSurjective hA
  let : Algebra (A' ⧸ I) A := (e : A' ⧸ I →+* A).toAlgebra
  let : Algebra (A' ⧸ I) B := ((algebraMap A B).comp (algebraMap (A' ⧸ I) A)).toAlgebra
  have : IsScalarTower (A' ⧸ I) A B := .of_algebraMap_eq fun _ => rfl
  have : IsScalarTower A' (A' ⧸ I) B := .of_algebraMap_eq fun x => by
    rw [IsScalarTower.algebraMap_apply (A' ⧸ I) A B, IsScalarTower.algebraMap_apply A' A B]
    rfl
  have : Algebra.Etale (A' ⧸ I) A := .of_equiv (AlgEquiv.ofRingEquiv (f := e) fun _ => rfl)
  have : Algebra.Etale (A' ⧸ I) B := .comp _ A B
  obtain ⟨C, _, _, hC, ⟨ε⟩⟩ := etale_lift_of_quotient A' I B
  let ψ : C →ₐ[A'] B :=
    (ε.symm.restrictScalars A').toAlgHom.comp (Ideal.Quotient.mkₐ A' (I.map (algebraMap A' C)))
  refine ⟨C, inferInstance, inferInstance, hC, ψ, ?_, ?_⟩
  · exact ε.symm.surjective.comp Ideal.Quotient.mk_surjective
  · change RingHom.ker ((ε.symm : (C ⧸ I.map (algebraMap A' C)) ≃+* B).toRingHom.comp
      (Ideal.Quotient.mk (I.map (algebraMap A' C)))) = _
    rw [← RingHom.comap_ker,
      show RingHom.ker (ε.symm : (C ⧸ I.map (algebraMap A' C)) ≃+* B).toRingHom = ⊥ from
        (RingHom.injective_iff_ker_eq_bot _).mp ε.symm.injective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
