module

public import Mathlib.RingTheory.Etale.Field
public import Mathlib.RingTheory.Idempotents
public import StacksFrontier.RingTheory.Etale.IndEtaleUniverse
public import StacksFrontier.RingTheory.Etale.IndEtaleUniverseSupplement

/-!
# Ind-étale algebras over a separably closed field

An étale algebra over a separably closed field `K` is a finite product of copies of `K`. Passing
to filtered colimits, every element of an ind-étale `K`-algebra `B` is a `K`-linear combination
of a complete family of orthogonal idempotents. Consequently every residue field of `B` is `K`
itself, and the kernel of the evaluation at a prime is generated by idempotents: an element
vanishing at a prime `𝔭` is killed by an idempotent not in `𝔭`. In geometric terms `Spec B` is a
profinite set of `K`-points, and the clopen neighbourhoods of a point cut out that point.

## Main results

* `StacksDraft.finite_primeSpectrum_of_etale`: an étale algebra over a field has finitely many
  primes.
* `StacksDraft.IndEtale.exists_completeOrthogonalIdempotents_sum`: an element of an ind-étale
  algebra over a separably closed field is a linear combination of a complete family of
  orthogonal idempotents.
* `StacksDraft.IndEtale.exists_algebraMap_eq`: every algebra map from such an algebra to a
  domain takes values in the image of `K`.
* `StacksDraft.IndEtale.exists_idempotent_not_mem_mul_eq_zero`: an element lying in a prime `𝔭`
  is annihilated by an idempotent not in `𝔭`.
* `StacksDraft.IndEtale.exists_algHom_ker_eq`: every prime is the kernel of a `K`-algebra map
  to `K`.
* `StacksDraft.IndEtale.isMaximal_of_isPrime`: every prime is maximal.
* `StacksDraft.IndEtale.exists_isIdempotentElem_separating`: a prime and a quasi-compact set of
  primes not containing it are separated by an idempotent.

## References

* [Stacks Project, Tag 0EZV](https://stacks.math.columbia.edu/tag/0EZV), first paragraph of the
  proof.
-/

@[expose] public section

open scoped BigOperators

universe u

/-- In a domain, a complete family of orthogonal idempotents has exactly one member equal to
`1`, all others being `0`. -/
public theorem CompleteOrthogonalIdempotents.exists_eq_one_of_isDomain {D : Type*} [CommRing D]
    [IsDomain D] {ι : Type*} [Fintype ι] {e : ι → D} (he : CompleteOrthogonalIdempotents e) :
    ∃ j, e j = 1 ∧ ∀ i, i ≠ j → e i = 0 := by
  classical
  have h01 : ∀ i, e i = 0 ∨ e i = 1 := fun i => IsIdempotentElem.iff_eq_zero_or_one.mp (he.idem i)
  obtain ⟨j, hj⟩ : ∃ j, e j ≠ 0 := by
    by_contra! H
    have := he.complete
    simp [H] at this
  have hj1 : e j = 1 := (h01 j).resolve_left hj
  refine ⟨j, hj1, fun i hij => ?_⟩
  have h : e i * e j = 0 := he.ortho hij
  rwa [hj1, mul_one] at h

namespace StacksDraft

/-- An étale algebra over a field is finite as a module and hence artinian, so it has only
finitely many primes. -/
public theorem finite_primeSpectrum_of_etale (K : Type*) [Field K] (A : Type*) [CommRing A]
    [Algebra K A] [Algebra.Etale K A] : Finite (PrimeSpectrum A) := by
  have := Algebra.FormallyUnramified.finite_of_free K A
  have : IsArtinianRing A := isArtinian_of_tower K inferInstance
  infer_instance

variable {K : Type u} [Field K] {B : Type u} [CommRing B] [Algebra K B]

/-- **Elements of an ind-étale algebra over a separably closed field.** Every element of an
ind-étale algebra `B` over a separably closed field `K` is a `K`-linear combination of a complete
family of orthogonal idempotents of `B`: the map `K[X] → B` it defines factors through an étale
`K`-algebra, which is a finite product of copies of `K`. -/
public theorem IndEtale.exists_completeOrthogonalIdempotents_sum [IsSepClosed K]
    (hB : IndEtale K B) (b : B) :
    ∃ (ι : Type u) (_ : Fintype ι) (e : ι → B) (c : ι → K),
      CompleteOrthogonalIdempotents e ∧ b = ∑ i, c i • e i := by
  classical
  obtain ⟨E, _, _, hE, g, h, hgh⟩ :=
    hB.exists_etale_factorization (Polynomial K) (Polynomial.aeval b)
  have := finite_primeSpectrum_of_etale K E
  let := Fintype.ofFinite (PrimeSpectrum E)
  let φ := Algebra.FormallyEtale.equivPiOfIsSepClosed K E
  refine ⟨PrimeSpectrum E, inferInstance,
    fun i => h (φ.symm (Pi.single i 1)), fun i => φ (g Polynomial.X) i, ?_, ?_⟩
  · exact (CompleteOrthogonalIdempotents.single
      (fun _ : PrimeSpectrum E => K)).map ((h : E →+* B).comp (φ.symm : _ →+* E))
  · have hX : φ (g Polynomial.X) = ∑ i, φ (g Polynomial.X) i • Pi.single i 1 := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    calc b = h (g Polynomial.X) := by
            rw [← AlgHom.comp_apply, hgh, Polynomial.aeval_X]
      _ = h (φ.symm (φ (g Polynomial.X))) := by rw [AlgEquiv.symm_apply_apply]
      _ = ∑ i, φ (g Polynomial.X) i • h (φ.symm (Pi.single i 1)) := by
            conv_lhs => rw [hX]
            simp [map_sum, map_smul]


/-- Multiplying a combination of orthogonal idempotents by one of them picks out its term. -/
private theorem sum_smul_mul_eq_smul {ι : Type*} [Fintype ι] {e : ι → B}
    (he : CompleteOrthogonalIdempotents e) (c : ι → K) (j : ι) :
    (∑ i, c i • e i) * e j = c j • e j := by
  classical
  rw [Finset.sum_mul, Finset.sum_eq_single j]
  · rw [smul_mul_assoc, (he.idem j).eq]
  · intro i _ hij
    rw [smul_mul_assoc, he.ortho hij, smul_zero]
  · simp

/-- **An ind-étale algebra over a separably closed field is reduced**: a nilpotent combination
of a complete family of orthogonal idempotents has nilpotent, hence vanishing, coefficients at
every nonzero member of the family. -/
public theorem IndEtale.isReduced [IsSepClosed K] (hB : IndEtale K B) : IsReduced B := by
  classical
  refine ⟨fun b hb => ?_⟩
  obtain ⟨ι, _, e, c, he, rfl⟩ := hB.exists_completeOrthogonalIdempotents_sum b
  have hj : ∀ j, c j • e j = 0 := by
    intro j
    obtain ⟨n, hn⟩ := hb
    have h1 : (c j • e j) ^ n = 0 := by
      rw [← sum_smul_mul_eq_smul he c j, mul_pow, hn, zero_mul]
    rcases n with _ | n
    · rw [pow_zero] at hn
      rw [← mul_one (c j • e j), hn, mul_zero]
    have h2 : (c j • e j) ^ (n + 1) = c j ^ (n + 1) • e j := by
      rw [smul_pow, (he.idem j).pow_succ_eq]
    rw [h2, smul_eq_zero] at h1
    rcases h1 with h1 | h1
    · rw [pow_eq_zero_iff (Nat.succ_ne_zero n)] at h1
      rw [h1, zero_smul]
    · rw [h1, smul_zero]
  simp [hj]

/-- **The residue fields of an ind-étale algebra over a separably closed field are trivial.**
Every `K`-algebra map from an ind-étale `K`-algebra `B` to a domain takes values in the image
of `K`. -/
public theorem IndEtale.exists_algebraMap_eq [IsSepClosed K] (hB : IndEtale K B)
    {D : Type*} [CommRing D] [IsDomain D] [Algebra K D] (χ : B →ₐ[K] D) (b : B) :
    ∃ c : K, χ b = algebraMap K D c := by
  classical
  obtain ⟨ι, _, e, c, he, rfl⟩ := hB.exists_completeOrthogonalIdempotents_sum b
  obtain ⟨j, hj, hi⟩ := (he.map (χ : B →+* D)).exists_eq_one_of_isDomain
  refine ⟨c j, ?_⟩
  rw [map_sum, Finset.sum_eq_single j]
  · simp only [map_smul]
    show c j • (χ : B →+* D) (e j) = _
    rw [show (χ : B →+* D) (e j) = 1 from hj, Algebra.smul_def, mul_one]
  · intro i _ hij
    simp only [map_smul]
    show c i • (χ : B →+* D) (e i) = 0
    rw [show (χ : B →+* D) (e i) = 0 from hi i hij, smul_zero]
  · simp

/-- **The kernel of the evaluation at a prime is generated by idempotents.** If `B` is
ind-étale over a separably closed field and `b` lies in the prime `𝔭`, there is an idempotent
`e ∉ 𝔭` with `b * e = 0`. -/
public theorem IndEtale.exists_idempotent_not_mem_mul_eq_zero [IsSepClosed K]
    (hB : IndEtale K B) (P : Ideal B) [P.IsPrime] {b : B} (hb : b ∈ P) :
    ∃ e : B, IsIdempotentElem e ∧ e ∉ P ∧ b * e = 0 := by
  classical
  obtain ⟨ι, _, e, c, he, rfl⟩ := hB.exists_completeOrthogonalIdempotents_sum b
  obtain ⟨j, hj, hi⟩ := (he.map (Ideal.Quotient.mk P)).exists_eq_one_of_isDomain
  have hjP : e j ∉ P := by
    intro h
    have : Ideal.Quotient.mk P (e j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr h
    exact one_ne_zero (((Function.comp_apply ▸ hj).symm).trans this)
  have hmul := sum_smul_mul_eq_smul he c j
  refine ⟨e j, he.idem j, hjP, ?_⟩
  rw [hmul]
  by_cases hc : c j = 0
  · rw [hc, zero_smul]
  · exfalso
    apply hjP
    have : c j • e j ∈ P := hmul ▸ P.mul_mem_right _ hb
    rw [Algebra.smul_def] at this
    rcases Ideal.IsPrime.mem_or_mem ‹_› this with h | h
    · exact absurd (P.eq_top_of_isUnit_mem h ((isUnit_iff_ne_zero.mpr hc).map _))
        (Ideal.IsPrime.ne_top ‹_›)
    · exact h

/-- **Every prime of an ind-étale algebra over a separably closed field is a `K`-point.** For
a prime `𝔭` of such an algebra `B` there is a `K`-algebra map `B → K` with kernel `𝔭`. -/
public theorem IndEtale.exists_algHom_ker_eq [IsSepClosed K] (hB : IndEtale K B)
    (P : Ideal B) [P.IsPrime] : ∃ χ : B →ₐ[K] K, RingHom.ker χ = P := by
  have hsurj : Function.Surjective (algebraMap K (B ⧸ P)) := by
    intro x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨c, hc⟩ := hB.exists_algebraMap_eq (Ideal.Quotient.mkₐ K P) b
    exact ⟨c, hc.symm⟩
  have hinj : Function.Injective (algebraMap K (B ⧸ P)) := (algebraMap K (B ⧸ P)).injective
  let ψ : K ≃ₐ[K] B ⧸ P := AlgEquiv.ofBijective (Algebra.ofId K (B ⧸ P)) ⟨hinj, hsurj⟩
  refine ⟨(ψ.symm : B ⧸ P →ₐ[K] K).comp (Ideal.Quotient.mkₐ K P), ?_⟩
  ext b
  simp only [RingHom.mem_ker, AlgHom.coe_comp, Function.comp_apply]
  rw [show ((ψ.symm : B ⧸ P →ₐ[K] K) (Ideal.Quotient.mkₐ K P b) = 0) ↔
      Ideal.Quotient.mkₐ K P b = 0 from by
    exact ⟨fun h => by simpa using congrArg ψ h, fun h => by simp [h]⟩]
  exact Ideal.Quotient.eq_zero_iff_mem

/-- **Every prime of an ind-étale algebra over a separably closed field is maximal.** -/
public theorem IndEtale.isMaximal_of_isPrime [IsSepClosed K] (hB : IndEtale K B)
    (P : Ideal B) [P.IsPrime] : P.IsMaximal := by
  obtain ⟨χ, hχ⟩ := hB.exists_algHom_ker_eq P
  rw [← hχ]
  exact RingHom.ker_isMaximal_of_surjective (χ : B →+* K)
    fun c => ⟨algebraMap K B c, χ.commutes c⟩

/-- **A point of the spectrum of an ind-étale algebra over a separably closed field is separated
from a quasi-compact set not containing it by an idempotent.** There is an idempotent `e` not in
the prime `P` which lies in every prime of the quasi-compact set `Z`; that is, `D(e)` is a clopen
neighbourhood of `P` disjoint from `Z`. -/
public theorem IndEtale.exists_isIdempotentElem_separating [IsSepClosed K] (hB : IndEtale K B)
    {Z : Set (PrimeSpectrum B)} (hZ : IsCompact Z) {P : PrimeSpectrum B} (hP : P ∉ Z) :
    ∃ e : B, IsIdempotentElem e ∧ e ∉ P.asIdeal ∧ ∀ Q ∈ Z, e ∈ Q.asIdeal := by
  classical
  have hsep : ∀ Q : Z, ∃ g : B, IsIdempotentElem g ∧ g ∉ (Q : PrimeSpectrum B).asIdeal ∧
      g ∈ P.asIdeal := by
    rintro ⟨Q, hQ⟩
    have hmax := hB.isMaximal_of_isPrime Q.asIdeal
    have hne : ¬ Q.asIdeal ≤ P.asIdeal := fun hle =>
      hP (PrimeSpectrum.ext (hmax.eq_of_le P.isPrime.ne_top hle) ▸ hQ)
    obtain ⟨a, haQ, haP⟩ := Set.not_subset.mp hne
    obtain ⟨g, hg, hgQ, hag⟩ := hB.exists_idempotent_not_mem_mul_eq_zero Q.asIdeal haQ
    refine ⟨g, hg, hgQ, ?_⟩
    have : a * g ∈ P.asIdeal := hag ▸ P.asIdeal.zero_mem
    exact (P.isPrime.mem_or_mem this).resolve_left haP
  choose g hg hgQ hgP using hsep
  obtain ⟨t, ht⟩ := hZ.elim_finite_subcover
    (fun Q : Z => ((PrimeSpectrum.basicOpen (g Q) : TopologicalSpace.Opens _) : Set _))
    (fun Q => (PrimeSpectrum.basicOpen (g Q)).isOpen)
    (by
      intro Q hQ
      exact Set.mem_iUnion.mpr ⟨⟨Q, hQ⟩, hgQ ⟨Q, hQ⟩⟩)
  refine ⟨∏ Q ∈ t, (1 - g Q), ?_, ?_, ?_⟩
  · clear ht
    induction t using Finset.induction_on with
    | empty => simpa using IsIdempotentElem.one
    | insert a t ha ih =>
      rw [Finset.prod_insert ha]
      exact (hg a).one_sub.mul ih
  · rw [← Ideal.mem_primeCompl_iff (P := P.asIdeal)]
    refine Submonoid.prod_mem _ fun Q _ => ?_
    rw [Ideal.mem_primeCompl_iff]
    intro h
    exact P.isPrime.ne_top (P.asIdeal.eq_top_of_isUnit_mem
      (by simpa using P.asIdeal.add_mem h (hgP Q)) isUnit_one)
  · intro Q' hQ'
    obtain ⟨Q, hQt, hQ'Q⟩ := Set.mem_iUnion₂.mp (ht hQ')
    rw [← Finset.mul_prod_erase t _ hQt]
    refine Q'.asIdeal.mul_mem_right _ ?_
    have h0 : (1 - g Q) * g Q ∈ Q'.asIdeal := by
      rw [sub_mul, one_mul, (hg Q).eq, sub_self]
      exact Q'.asIdeal.zero_mem
    exact (Q'.isPrime.mem_or_mem h0).resolve_right hQ'Q

end StacksDraft
