module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal

/-!
# A hypersurface whose differential generates the relative differentials is étale

Let `P` be a formally smooth `R`-algebra of finite presentation, `f ∈ P` and `T = P ⧸ (f)`.
Suppose that `T ⊗[P] Ω[P⁄R]` is generated by `1 ⊗ df` and that `κ(q) ⊗[P] Ω[P⁄R] ≠ 0` at every
prime `q ∋ f`. Then `T` is étale over `R`.

The conormal map `(f)/(f²) ⟶ T ⊗[P] Ω[P⁄R]`, `f ↦ 1 ⊗ df`, is onto by the first hypothesis, so
`Ω[T⁄R] = 0` (`KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange`). It is also
injective: `(f)/(f²)` is cyclic, generated by the class of `f`, and the surjection
`T ⟶ T ⊗[P] Ω[P⁄R]`, `c ↦ c • (1 ⊗ df)`, onto a projective module splits by some `s` with
`s(1 ⊗ df) • (1 ⊗ df) = 1 ⊗ df`; the second hypothesis makes `s(1 ⊗ df)` a unit, so the
surjection is injective. Injectivity of the conormal map is the vanishing of `H¹(L_{T/R})`
(`Algebra.FormallySmooth.kerCotangentToTensor_injective_iff`), so `T` is formally smooth, and
formally unramified since `Ω[T⁄R] = 0`.

This is the étaleness over the base of the divisor `V(h(t))` cut out on a family of smooth curves
by a monic separable polynomial in a separating coordinate `t`, along which the Gysin map of
`R² g_!` is taken in the reduction of the weight bound of Weil II
([Tag 03VH](https://stacks.math.columbia.edu/tag/03VH)).

## Main results

* `LinearMap.injective_toSpanSingleton_of_projective`.
* `Algebra.etale_quotient_span_singleton_of_span_D`.
-/

public section

open TensorProduct

/-- **A cyclic projective module with nonzero fibres is free on its generator**: if `v` generates
the projective `T`-module `N` and `v ∉ q • N` for every maximal ideal `q` (that is, `c • v ≠ v`
for `c ∈ q`), then `c ↦ c • v` is injective. A splitting `s` of `c ↦ c • v` has
`s(v) • v = v`, so `s(v)` lies in no maximal ideal. -/
theorem LinearMap.injective_toSpanSingleton_of_projective {T N : Type*} [CommRing T]
    [AddCommGroup N] [Module T N] [Module.Projective T N] (v : N)
    (hv : Submodule.span T {v} = ⊤) (hq : ∀ q : Ideal T, q.IsMaximal → ∀ c ∈ q, c • v ≠ v) :
    Function.Injective (LinearMap.toSpanSingleton T N v) := by
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton T N v) := by
    rw [← LinearMap.range_eq_top, ← LinearMap.span_singleton_eq_range, hv]
  obtain ⟨s, hs⟩ := Module.projective_lifting_property (LinearMap.toSpanSingleton T N v)
    LinearMap.id hsurj
  have he : s v • v = v := by
    have := LinearMap.congr_fun hs v
    simpa using this
  have hunit : IsUnit (s v) := by
    by_contra h
    obtain ⟨q, hq', hmem⟩ := exists_max_ideal_of_mem_nonunits h
    exact hq q hq' _ hmem he
  intro c d hcd
  have h1 : s (c • v) = s (d • v) := by simpa using congrArg s hcd
  rw [map_smul, map_smul, smul_eq_mul, smul_eq_mul] at h1
  exact hunit.mul_right_cancel h1

namespace Algebra

variable {R P : Type*} [CommRing R] [CommRing P] [Algebra R P]

/-- **A hypersurface whose differential generates the relative differentials is étale**: for `P`
formally smooth and of finite presentation over `R` and `f ∈ P`, if `1 ⊗ df` generates
`P ⧸ (f) ⊗[P] Ω[P⁄R]` and `κ(q) ⊗[P] Ω[P⁄R] ≠ 0` at every prime `q ∋ f`, then `P ⧸ (f)` is étale
over `R`. -/
theorem etale_quotient_span_singleton_of_span_D [FormallySmooth R P] [FinitePresentation R P]
    (f : P) (hspan : Submodule.span (P ⧸ Ideal.span {f})
      {(1 : P ⧸ Ideal.span {f}) ⊗ₜ[P] KaehlerDifferential.D R P f} = ⊤)
    (hne : ∀ (q : Ideal P) [q.IsPrime], f ∈ q → Nontrivial (q.ResidueField ⊗[P] Ω[P⁄R])) :
    Etale R (P ⧸ Ideal.span {f}) := by
  set T := P ⧸ Ideal.span {f}
  set I := RingHom.ker (algebraMap P T)
  have hsurj : Function.Surjective (algebraMap P T) := Ideal.Quotient.mk_surjective
  set φ := KaehlerDifferential.kerCotangentToTensor R P T
  set v : T ⊗[P] Ω[P⁄R] := (1 : T) ⊗ₜ[P] KaehlerDifferential.D R P f
  have hI : I = Ideal.span {f} := Ideal.mk_ker
  have hfI : f ∈ I := hI ▸ Ideal.mem_span_singleton_self f
  have hφf : φ (I.toCotangent ⟨f, hfI⟩) = v :=
    KaehlerDifferential.kerCotangentToTensor_toCotangent R P T ⟨f, hfI⟩
  -- the cotangent `(f)/(f²)` is generated by the class of `f`
  have hcyc : ∀ x : I.Cotangent, ∃ c : P, x = c • I.toCotangent ⟨f, hfI⟩ := by
    intro x
    obtain ⟨⟨y, hy⟩, rfl⟩ := I.toCotangent_surjective x
    rw [hI] at hy
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hy
    exact ⟨c, by rw [← map_smul]; rfl⟩
  -- every element of `T ⊗ Ω` is a multiple of `v` by an element of `P`
  have hmul : ∀ z : T ⊗[P] Ω[P⁄R], ∃ c : P, z = c • v := by
    intro z
    have hz : z ∈ Submodule.span T {v} := hspan ▸ Submodule.mem_top
    obtain ⟨t, rfl⟩ := Submodule.mem_span_singleton.1 hz
    obtain ⟨c, rfl⟩ := hsurj t
    exact ⟨c, algebraMap_smul T c v⟩
  -- `v` does not lie in `q • (T ⊗ Ω)` for a maximal ideal `q` of `T`
  have hq : ∀ q : Ideal T, q.IsMaximal → ∀ c ∈ q, c • v ≠ v := by
    intro q hqm c hc hcv
    let q' := q.comap (algebraMap P T)
    have : q'.IsPrime := Ideal.comap_isPrime _ _
    have hfq : f ∈ q' := by
      show algebraMap P T f ∈ q
      rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.2
        (Ideal.mem_span_singleton_self f)]
      exact q.zero_mem
    have := hne q' hfq
    obtain ⟨c', rfl⟩ := hsurj c
    have hc' : algebraMap P q'.ResidueField c' = 0 := Ideal.algebraMap_residueField_eq_zero.2 hc
    -- the reduction `T ⟶ κ(q')`
    have hfz : ∀ a ∈ Ideal.span {f}, IsScalarTower.toAlgHom P P q'.ResidueField a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.1 ha
      simp only [map_mul, IsScalarTower.toAlgHom_apply]
      rw [Ideal.algebraMap_residueField_eq_zero.2 hfq, mul_zero]
    let τ : T →ₗ[P] q'.ResidueField :=
      (Ideal.Quotient.liftₐ (Ideal.span {f}) (IsScalarTower.toAlgHom P P q'.ResidueField)
        hfz).toLinearMap
    have hτ1 : τ 1 = 1 := map_one (Ideal.Quotient.liftₐ (Ideal.span {f}) _ hfz)
    let ρ := LinearMap.rTensor Ω[P⁄R] τ
    have hρv : ρ v = 0 := by
      rw [algebraMap_smul] at hcv
      calc ρ v = ρ (c' • v) := by rw [hcv]
        _ = c' • ρ v := map_smul _ _ _
        _ = algebraMap P q'.ResidueField c' • ρ v := (algebraMap_smul _ _ _).symm
        _ = 0 := by rw [hc', zero_smul]
    have hzero : ∀ ω : Ω[P⁄R], (1 : q'.ResidueField) ⊗ₜ[P] ω = 0 := by
      intro ω
      obtain ⟨d, hd⟩ := hmul ((1 : T) ⊗ₜ[P] ω)
      have := congrArg ρ hd
      rw [map_smul, hρv, smul_zero, LinearMap.rTensor_tmul, hτ1] at this
      exact this
    have hsub : Subsingleton (q'.ResidueField ⊗[P] Ω[P⁄R]) := by
      refine subsingleton_of_forall_eq 0 fun z => ?_
      induction z using TensorProduct.induction_on with
      | zero => rfl
      | tmul k ω =>
        have : k ⊗ₜ[P] ω = k • ((1 : q'.ResidueField) ⊗ₜ[P] ω) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [this, hzero, smul_zero]
      | add x y hx hy => rw [hx, hy, add_zero]
    exact not_subsingleton _ hsub
  have hinj := LinearMap.injective_toSpanSingleton_of_projective v hspan hq
  -- the conormal map is bijective
  have hφinj : Function.Injective φ := by
    intro x y hxy
    obtain ⟨c, rfl⟩ := hcyc x
    obtain ⟨d, rfl⟩ := hcyc y
    rw [map_smul, map_smul, hφf] at hxy
    have hcd : algebraMap P T c = algebraMap P T d := by
      apply hinj
      simp only [LinearMap.toSpanSingleton_apply]
      exact hxy
    have hmem : c - d ∈ Ideal.span {f} := by
      rw [← Ideal.Quotient.eq]
      exact hcd
    rw [← sub_eq_zero, ← sub_smul, ← map_smul, Ideal.toCotangent_eq_zero]
    show (c - d) * f ∈ I ^ 2
    rw [pow_two]
    exact Ideal.mul_mem_mul (hI ▸ hmem) hfI
  have hφsurj : Function.Surjective φ := by
    intro z
    obtain ⟨c, rfl⟩ := hmul z
    exact ⟨c • I.toCotangent ⟨f, hfI⟩, by rw [map_smul, hφf]⟩
  -- `Ω[T⁄R] = 0`
  have hΩ : Subsingleton Ω[T⁄R] := by
    refine subsingleton_of_forall_eq 0 fun ω => ?_
    obtain ⟨z, rfl⟩ := KaehlerDifferential.mapBaseChange_surjective R P T hsurj ω
    obtain ⟨x, rfl⟩ := hφsurj z
    exact (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R P T hsurj)
      |>.apply_apply_eq_zero x
  have : FormallyUnramified R T := ⟨hΩ⟩
  have : FormallySmooth R T :=
    ⟨Module.Projective.of_free, (FormallySmooth.kerCotangentToTensor_injective_iff hsurj).1 hφinj⟩
  have : FormallyEtale R T := FormallyEtale.of_formallyUnramified_and_formallySmooth
  have : FinitePresentation R T := FinitePresentation.quotient ⟨{f}, by simp⟩
  exact ⟨inferInstance, inferInstance⟩

end Algebra
