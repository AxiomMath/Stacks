module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Etale.Locus
public import Mathlib.RingTheory.Finiteness.FinitePresentationLocal
public import StacksCore.Tactic.StacksAttribute

/-!
# Inverting a single element on the étale locus

Let `A → B` be a map of commutative rings and `J` an ideal of `B`. The locus where `A → B` is
étale is open, so if it contains every prime containing `J` it contains a basic open neighbourhood
of `V(J)`: there is a single `g : B`, a unit modulo `J`, with `A → B_g` étale. This lets a
statement proved only near `V(J)` be turned into one about an honest étale `A`-algebra, and it is
the step used repeatedly in the lifting results of this directory.

## Main results

* `exists_isUnit_quotient_mk_and_etale_away`: the element `g` inverting `B` into an étale
  `A`-algebra.

## Implementation notes

The ideal `I` generated by all `f : B` with `A → B_f` étale is the one to work with: the
hypothesis says no prime containing `J` contains `I`, so `J ⊔ I = ⊤` and `1 = j + g` with `j ∈ J`
and `g ∈ I`, whence `g` is a unit modulo `J`. That `A → B_g` is then étale for such a `g` is
`etale_away_of_mem_span`: étaleness of `B_f` for `f` in a family generating the unit ideal of
`B_g` gives formal étaleness on the whole étale locus of `Spec B_g`, and finite presentation by
`Algebra.FinitePresentation.of_span_eq_top_target`. Passing from `B_f` to `(B_g)_f` uses the
commuting-localizations isomorphism, which is `etale_away_algebraMap`.

## References

* [Stacks Project, Tag 07M0](https://stacks.math.columbia.edu/tag/07M0)
-/

universe u v

@[expose] public section

private lemma etale_away_algebraMap
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    (f g : B) (hf : Algebra.Etale A (Localization.Away f)) :
    Algebra.Etale A (Localization.Away (algebraMap B (Localization.Away g) f)) := by
  let T := Localization.Away (algebraMap B (Localization.Away g) f)
  let Bf := Localization.Away f
  let : Algebra Bf T :=
    (IsLocalization.Away.awayToAwayRight (S := Bf) (P := T) f g).toAlgebra
  let : IsScalarTower B Bf T := IsScalarTower.of_algebraMap_eq' (by
    ext x
    exact (IsLocalization.Away.awayToAwayRight_eq (S := Bf) (P := T) f g x).symm)
  let : IsLocalization.Away (algebraMap B Bf g) T :=
    IsLocalization.Away.commutes Bf (Localization.Away g) T f g
  let : Algebra A Bf := inferInstance
  let : Algebra.Etale A Bf := hf
  let : IsScalarTower A Bf T := IsScalarTower.of_algebraMap_eq' (by
    ext x
    change algebraMap B T (algebraMap A B x) =
      algebraMap Bf T (algebraMap B Bf (algebraMap A B x))
    exact (IsLocalization.Away.awayToAwayRight_eq (S := Bf) (P := T) f g _).symm)
  exact Algebra.Etale.of_equiv <| (IsLocalization.algEquiv (Submonoid.powers (algebraMap B Bf g))
    (Localization.Away (algebraMap B Bf g)) T).restrictScalars A

private lemma etale_away_of_mem_span
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
    {g : B}
    (hg : g ∈ Ideal.span { f : B | Algebra.Etale A (Localization.Away f) }) :
    Algebra.Etale A (Localization.Away g) := by
  let T := Localization.Away g
  let s : Set T := algebraMap B T '' { f : B | Algebra.Etale A (Localization.Away f) }
  have hs : Ideal.span s = ⊤ := by
    rw [← Ideal.map_span]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem (algebraMap B T) hg)
      (IsLocalization.Away.algebraMap_isUnit g)
  refine ⟨?_, Algebra.FinitePresentation.of_span_eq_top_target s hs ?_⟩
  · rw [← Algebra.basicOpen_subset_etaleLocus_iff]
    intro q hq
    by_contra hnq
    have hall : { f : B | Algebra.Etale A (Localization.Away f) } ⊆ q.asIdeal := by
      intro f hf
      by_contra hfn
      exact hnq (Algebra.basicOpen_subset_etaleLocus_iff.mpr
        (show Algebra.Etale A (Localization.Away f) from hf).formallyEtale hfn)
    exact hq (Ideal.span_le.mpr hall hg)
  · rintro x ⟨f, hf, rfl⟩
    exact (etale_away_algebraMap f g hf).finitePresentation

/-- **Stacks 07M0.** If `A → B` is étale at every prime containing `J`, there is an element
`g : B` whose image in `B ⧸ J` is a unit and such that `B` localized away from `g` is étale
over `A`. -/
@[stacks 07M0]
theorem exists_isUnit_quotient_mk_and_etale_away
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B] (J : Ideal B)
    (h : ∀ (q : Ideal B) [q.IsPrime], J ≤ q →
      ∃ f ∉ q, Algebra.Etale A (Localization.Away f)) :
    ∃ g : B, IsUnit (Ideal.Quotient.mk J g) ∧
      Algebra.Etale A (Localization.Away g) := by
  let I : Ideal B := Ideal.span { f : B | Algebra.Etale A (Localization.Away f) }
  have hsup : J ⊔ I = ⊤ := by
    by_contra hne
    obtain ⟨q, hq, hle⟩ := Ideal.exists_le_maximal (J ⊔ I) hne
    let : q.IsPrime := hq.isPrime
    obtain ⟨f, hfq, hf⟩ := h q (le_sup_left.trans hle)
    exact hfq (hle (Ideal.mem_sup_right (Ideal.subset_span hf)))
  have hone : (1 : B) ∈ J ⊔ I := hsup ▸ Submodule.mem_top
  obtain ⟨j, hj, g, hg, hjg⟩ := Submodule.mem_sup.mp hone
  refine ⟨g, ?_, etale_away_of_mem_span hg⟩
  have hgm : Ideal.Quotient.mk J g = 1 := by
    rw [← map_one (Ideal.Quotient.mk J), ← hjg, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hj,
      zero_add]
  exact hgm ▸ isUnit_one
