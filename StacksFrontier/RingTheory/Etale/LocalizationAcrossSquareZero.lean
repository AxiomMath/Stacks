module

public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# A formally smooth algebra whose reduction is a localization is a localization

Let `p : A' ⟶ A` be a surjection of commutative rings whose kernel `I` has square zero, let `B'`
be a formally smooth `A'`-algebra, and let `q : B' ⟶ B` be a surjection whose kernel is generated
by the image of `I`.  If `B` is the localization of `A` away from the image of some `a : A'`, then
`B'` is the localization of `A'` away from `a`.

This is the algebraic form of the statement that an étale algebra over a square-zero extension
which reduces to a *basic open* is itself a basic open; through
`AlgebraicGeometry.IsOpenImmersion.of_isLocalization` it says that `Spec B' ⟶ Spec A'` is an open
immersion, which is the step that makes the chart diagram `U ↦ Spec(𝒜(U))` of
[Stacks Project, Tag 05ZT] a diagram of open immersions over the affine charts.

## Main results

* `Stacks.Etale.isLocalization_away_of_squareZero`: **the statement above.**

## Implementation notes

The two reductions are taken as surjections `p`, `q` with a commuting square rather than as the
literal quotients `A' ⧸ I` and `B' ⧸ IB'`, as elsewhere in the base-change API of this
development: the consumer holds a map of sheaves of rings together with its kernel, not a
quotient.

The proof is in two halves, and only the second uses formal smoothness.  Write
`ι : A' ⟶ B'` for the algebra map.

*Surjectivity of the comparison `A'[1/a] ⟶ B'`.*  Because `B` is `A` away from `p a`, every
`b : B'` satisfies `b · ι(a)ⁿ ≡ ι y` modulo `ker q` for some `n` and `y`; and every element `d` of
`ker q` satisfies `d · ι(a)ⁿ = ι y` *exactly*, for some `n` and some `y` in `ker p`.  The latter
is an induction over the span generating `ker q` from the image of `ker p`, whose only non-formal
step is multiplication by a scalar `b : B'`: there one applies the former to `b` and absorbs the
error term, which lies in `(ker q)² = 0`.  Together they put `b · ι(a)ⁿ` in the image of `A'`,
which is the surjectivity.

*Injectivity of the comparison.*  Its kernel `K` consists of elements which, after multiplication
by a power of `a`, come from `ker p`; hence `K² = 0`.  Formal smoothness of `B'` over `A'` then
splits the surjection, because its kernel has square zero, and formal unramifiedness of the
localization `A'[1/a]` over `A'` — which holds for every localization — makes the resulting
endomorphism of `A'[1/a]` the identity, since it is the identity modulo `K`.

The hypothesis is formal smoothness rather than étaleness because that is all the argument uses;
the consumer supplies it from `Algebra.Etale`.

## References

* [Stacks Project, Tag 05ZT](https://stacks.math.columbia.edu/tag/05ZT)
-/

@[expose] public noncomputable section

universe u v w t

namespace Stacks.Etale

variable {A' : Type u} {A : Type v} {B' : Type w} {B : Type t}
  [CommRing A'] [CommRing A] [CommRing B'] [CommRing B] [Algebra A' B'] [Algebra A B]

/-- Two elements of an ideal with square zero multiply to zero. -/
private theorem mul_eq_zero_of_mem_of_sq_eq_bot {R : Type*} [CommRing R] {I : Ideal R}
    (h : I ^ 2 = ⊥) {x y : R} (hx : x ∈ I) (hy : y ∈ I) : x * y = 0 := by
  have hm : x * y ∈ I ^ 2 := by rw [pow_two]; exact Ideal.mul_mem_mul hx hy
  rwa [h, Ideal.mem_bot] at hm

/-- **A formally smooth algebra over a square-zero extension whose reduction is a localization
away from an element is itself a localization away from a lift of that element.**

Here `p : A' ⟶ A` and `q : B' ⟶ B` are the two reductions, `hpq` says that they commute with the
algebra maps, `hsq` says that the kernel of `p` has square zero, and `hker` says that the kernel
of `q` is generated by the image of the kernel of `p` — the base-change property of the kernel
ideals.  The conclusion is the hypothesis of
`AlgebraicGeometry.IsOpenImmersion.of_isLocalization`, so it says in particular that
`Spec B' ⟶ Spec A'` is an open immersion. -/
theorem isLocalization_away_of_squareZero
    (p : A' →+* A) (q : B' →+* B) (hp : Function.Surjective p) (hq : Function.Surjective q)
    (hpq : ∀ x : A', q (algebraMap A' B' x) = algebraMap A B (p x))
    (hsq : RingHom.ker p ^ 2 = ⊥)
    (hker : RingHom.ker q ≤ Ideal.map (algebraMap A' B') (RingHom.ker p))
    [Algebra.FormallySmooth A' B'] (a : A') [IsLocalization.Away (p a) B] :
    IsLocalization.Away a B' := by
  classical
  -- The kernel of `q` has square zero, being generated by the image of the kernel of `p`.
  have hJsq : RingHom.ker q ^ 2 = ⊥ := by
    refine le_antisymm ?_ bot_le
    calc RingHom.ker q ^ 2 ≤ Ideal.map (algebraMap A' B') (RingHom.ker p) ^ 2 := by
          rw [pow_two, pow_two]; exact Ideal.mul_mono hker hker
      _ = Ideal.map (algebraMap A' B') (RingHom.ker p ^ 2) := (Ideal.map_pow _ _ 2).symm
      _ = ⊥ := by rw [hsq, Ideal.map_bot]
  have hmul0 : ∀ x ∈ RingHom.ker q, ∀ y ∈ RingHom.ker q, x * y = 0 := fun _ hx _ hy =>
    mul_eq_zero_of_mem_of_sq_eq_bot hJsq hx hy
  have hIJ : ∀ y ∈ RingHom.ker p, algebraMap A' B' y ∈ RingHom.ker q := by
    intro y hy
    rw [RingHom.mem_ker, hpq, RingHom.mem_ker.mp hy, map_zero]
  -- Units lift across the square-zero kernel of `q`.
  have hunit : ∀ y : B', IsUnit (q y) → IsUnit y := by
    intro y hy
    obtain ⟨u, hu⟩ := hy
    obtain ⟨v, hv⟩ := hq ((u⁻¹ : Bˣ) : B)
    have hj : y * v - 1 ∈ RingHom.ker q := by
      rw [RingHom.mem_ker, map_sub, map_mul, map_one, hv, ← hu, u.mul_inv, sub_self]
    have hkey : y * (v * (1 - (y * v - 1))) = 1 := by
      rw [show y * (v * (1 - (y * v - 1))) = 1 - (y * v - 1) * (y * v - 1) by ring,
        hmul0 _ hj _ hj, sub_zero]
    exact ⟨⟨y, v * (1 - (y * v - 1)), hkey, by rw [mul_comm, hkey]⟩, rfl⟩
  have ha : IsUnit (algebraMap A' B' a) := by
    refine hunit _ ?_
    rw [hpq]
    exact IsLocalization.Away.algebraMap_isUnit (S := B) (p a)
  -- Every element of `B'` comes from `A'` after multiplying by a power of `a`, up to `ker q`.
  have hstep : ∀ b : B', ∃ (n : ℕ) (y : A'),
      b * algebraMap A' B' a ^ n - algebraMap A' B' y ∈ RingHom.ker q := by
    intro b
    obtain ⟨⟨x₀, s⟩, hs⟩ := IsLocalization.surj (M := Submonoid.powers (p a)) (q b)
    obtain ⟨n, hn⟩ := s.2
    have hn' : p a ^ n = (s : A) := hn
    obtain ⟨y, hy⟩ := hp x₀
    refine ⟨n, y, RingHom.mem_ker.mpr ?_⟩
    rw [map_sub, map_mul, map_pow, hpq, ← map_pow, hn', hpq, hy, sub_eq_zero]
    exact hs
  -- The span generating the kernel of `q` from the image of the kernel of `p`.
  have hspan : Ideal.map (algebraMap A' B') (RingHom.ker p)
      = Ideal.span ((algebraMap A' B') '' (RingHom.ker p : Set A')) := by
    rw [← Ideal.map_span, Ideal.span_eq]
  -- Every element of that span comes from the kernel of `p` after multiplying by a power of `a`.
  have hgen : ∀ d ∈ Ideal.span ((algebraMap A' B') '' (RingHom.ker p : Set A')),
      ∃ (n : ℕ) (y : A'), y ∈ RingHom.ker p ∧
        d * algebraMap A' B' a ^ n = algebraMap A' B' y := by
    intro d hd
    induction hd using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      exact ⟨0, i, hi, by simp⟩
    | zero => exact ⟨0, 0, Submodule.zero_mem _, by simp⟩
    | add x y _ _ ihx ihy =>
      obtain ⟨n₁, y₁, hy₁, e₁⟩ := ihx
      obtain ⟨n₂, y₂, hy₂, e₂⟩ := ihy
      refine ⟨n₁ + n₂, y₁ * a ^ n₂ + y₂ * a ^ n₁,
        Ideal.add_mem _ (Ideal.mul_mem_right _ _ hy₁) (Ideal.mul_mem_right _ _ hy₂), ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← e₁, ← e₂]
      ring
    | smul b x _ ih =>
      obtain ⟨n, y, hy, e⟩ := ih
      obtain ⟨m, y₀, hj⟩ := hstep b
      refine ⟨m + n, y₀ * y, Ideal.mul_mem_left _ _ hy, ?_⟩
      have hj0 : (b * algebraMap A' B' a ^ m - algebraMap A' B' y₀)
          * algebraMap A' B' y = 0 := hmul0 _ hj _ (hIJ y hy)
      rw [smul_eq_mul, map_mul, ← sub_eq_zero, ← hj0, ← e]
      ring
  -- Hence every element of `B'` comes from `A'` after multiplying by a power of `a`.
  have hsurj : ∀ b : B', ∃ (n : ℕ) (y : A'),
      b * algebraMap A' B' a ^ n = algebraMap A' B' y := by
    intro b
    obtain ⟨m, y₀, hj⟩ := hstep b
    obtain ⟨n, y, -, e⟩ := hgen _ (by rw [← hspan]; exact hker hj)
    refine ⟨m + n, y₀ * a ^ n + y, ?_⟩
    rw [map_add, map_mul, map_pow, ← e]
    ring
  -- The comparison from the localization away from `a`.
  have haL : IsUnit ((Algebra.ofId A' B') a) := ha
  let φ : Localization.Away a →ₐ[A'] B' := IsLocalization.Away.liftAlgHom a haL
  have hφ : ∀ x : A', φ (algebraMap A' (Localization.Away a) x) = algebraMap A' B' x := fun x =>
    IsLocalization.Away.lift_eq a haL x
  have haunitL : IsUnit (algebraMap A' (Localization.Away a) a) :=
    IsLocalization.Away.algebraMap_isUnit (S := Localization.Away a) a
  have hcancelL : ∀ (n : ℕ) (x y : Localization.Away a),
      x * algebraMap A' (Localization.Away a) a ^ n
        = y * algebraMap A' (Localization.Away a) a ^ n → x = y :=
    fun n _ _ h => ((haunitL.pow n).mul_left_inj).mp h
  -- `φ` is surjective.
  have hφsurj : Function.Surjective φ := by
    intro b
    obtain ⟨n, y, hb⟩ := hsurj b
    have hu := haunitL.pow n
    refine ⟨algebraMap A' _ y * ↑hu.unit⁻¹, ((hu.map φ).mul_left_inj).mp ?_⟩
    rw [← map_mul, mul_assoc, hu.val_inv_mul, mul_one, hφ, ← hb, map_pow, hφ]
  -- Elements of the kernel of `φ` come from the kernel of `p`.
  have hkerrep : ∀ c : Localization.Away a, φ c = 0 → ∃ (n : ℕ) (y : A'), y ∈ RingHom.ker p ∧
      c * algebraMap A' (Localization.Away a) a ^ n
        = algebraMap A' (Localization.Away a) y := by
    intro c hc
    obtain ⟨⟨y₀, s⟩, hs⟩ := IsLocalization.surj (M := Submonoid.powers a) c
    obtain ⟨n, hn⟩ := s.2
    have hn' : a ^ n = (s : A') := hn
    have hs' : c * algebraMap A' (Localization.Away a) a ^ n
        = algebraMap A' (Localization.Away a) y₀ := by
      rw [← map_pow, hn']
      exact hs
    have h0 : algebraMap A' B' y₀ = 0 := by
      have hcong := congrArg φ hs'
      rw [map_mul, map_pow, hφ, hφ, hc, zero_mul] at hcong
      exact hcong.symm
    have h1 : algebraMap A B (p y₀) = 0 := by rw [← hpq, h0, map_zero]
    obtain ⟨m', hm'⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers (p a)) B (p y₀)).mp h1
    obtain ⟨k, hk⟩ := m'.2
    have hk' : p a ^ k = (m' : A) := hk
    refine ⟨n + k, a ^ k * y₀, RingHom.mem_ker.mpr ?_, ?_⟩
    · rwa [map_mul, map_pow, hk']
    · rw [map_mul, map_pow, ← hs']
      ring
  -- The kernel of `φ` has square zero.
  have hkφsq : RingHom.ker φ ^ 2 = ⊥ := by
    refine le_antisymm ?_ bot_le
    rw [pow_two]
    refine Ideal.mul_le.mpr fun r hr s hs => ?_
    obtain ⟨n, y, hy, er⟩ := hkerrep r (RingHom.mem_ker.mp hr)
    obtain ⟨m, z, hz, es⟩ := hkerrep s (RingHom.mem_ker.mp hs)
    have hyz := mul_eq_zero_of_mem_of_sq_eq_bot hsq hy hz
    rw [Ideal.mem_bot]
    refine hcancelL (n + m) _ _ ?_
    rw [zero_mul, pow_add, mul_mul_mul_comm, er, es, ← map_mul, hyz, map_zero]
  -- `φ` is injective: formal smoothness splits it, formal unramifiedness pins the splitting.
  have hnil : IsNilpotent (RingHom.ker φ) := ⟨2, hkφsq⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : B' →ₐ[A'] Localization.Away a, ∀ b : B', φ (ψ b) = b := by
    refine ⟨Algebra.FormallySmooth.lift (RingHom.ker φ) hnil
      (Ideal.quotientKerAlgEquivOfSurjective hφsurj).symm.toAlgHom, fun b => ?_⟩
    obtain ⟨c, rfl⟩ := hφsurj b
    have hmk := Algebra.FormallySmooth.mk_lift (RingHom.ker φ) hnil
      (Ideal.quotientKerAlgEquivOfSurjective hφsurj).symm.toAlgHom (φ c)
    have hmk2 : Ideal.Quotient.mk (RingHom.ker φ)
        (Algebra.FormallySmooth.lift (RingHom.ker φ) hnil
          (Ideal.quotientKerAlgEquivOfSurjective hφsurj).symm.toAlgHom (φ c))
        = Ideal.Quotient.mk (RingHom.ker φ) c :=
      hmk.trans (Ideal.quotientKerAlgEquivOfSurjective_symm_apply hφsurj c)
    have hmem := RingHom.mem_ker.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp hmk2)
    rwa [map_sub, sub_eq_zero] at hmem
  have hφinj : Function.Injective φ := by
    have hid : ψ.comp φ = AlgHom.id A' (Localization.Away a) := by
      refine Algebra.FormallyUnramified.comp_injective (RingHom.ker φ) hkφsq
        (AlgHom.ext fun c => ?_)
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply]
      rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, RingHom.mem_ker, map_sub, hψ, sub_self]
    intro x y hxy
    have hx := AlgHom.congr_fun hid x
    have hy := AlgHom.congr_fun hid y
    simp only [AlgHom.comp_apply, AlgHom.id_apply] at hx hy
    exact hx.symm.trans ((congrArg ψ hxy).trans hy)
  exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers a)
    (AlgEquiv.ofBijective φ ⟨hφinj, hφsurj⟩)

end Stacks.Etale

end
