/-!
# Bézout domains and elementary divisor domains

A *Bézout domain* is a domain all of whose finitely generated ideals are principal; this is
Mathlib's `IsBezout`. A rectangular matrix over a commutative ring `R` is in Smith normal form if
its off-diagonal entries vanish and its diagonal entries form a divisibility chain
`f₀ ∣ f₁ ∣ ⋯`. The ring `R` is an *elementary divisor domain* if every `n × m` matrix with
`n, m ≥ 1` can be brought into Smith normal form by multiplying on the left and on the right by
invertible matrices over `R`.

## Main definitions

* `Matrix.IsSmithNormal`: a rectangular matrix is diagonal with a divisibility chain on the
  diagonal.
* `IsElementaryDivisorDomain`: a class asserting that every nonempty rectangular matrix is
  equivalent to one in Smith normal form.
* `Matrix.entriesIdeal`: the ideal generated by the entries of a matrix.

## Main results

* `isBezout_of_isElementaryDivisorDomain`: an elementary divisor domain is a Bézout domain.
* `bezout_unimodular_completion`: over a Bézout domain, a unimodular row is the first row of an
  invertible square matrix.

## Implementation notes

The Bézout property is Mathlib's `IsBezout`, so the two notions of Stacks Tag 0ASR are recorded by
tagging `IsBezout` and `IsElementaryDivisorDomain` rather than by introducing new predicates.

## References

* [Stacks, Tag 0ASR](https://stacks.math.columbia.edu/tag/0ASR)
* [Stacks, Tag 0ASS](https://stacks.math.columbia.edu/tag/0ASS)
* [Stacks, Tag 0ASW](https://stacks.math.columbia.edu/tag/0ASW)
-/

@[expose] public section

variable {R : Type*} [CommRing R]

/-- A rectangular matrix `D : Matrix (Fin n) (Fin m) R` is a *Smith normal form*
(a "diagonal" matrix with a divisibility chain) if there is a family
`f : Fin (min n m) → R` such that:
  * the diagonal entries `D i i` (for `i < min n m`) are the `f i`;
  * all off-diagonal entries are `0`;
  * the `f i` form a divisibility chain `f₀ ∣ f₁ ∣ ⋯`.
Diagonality is measured by the natural-number values of the indices. -/
def Matrix.IsSmithNormal {n m : ℕ} (D : Matrix (Fin n) (Fin m) R) : Prop :=
  ∃ f : Fin (min n m) → R,
    (∀ (i : Fin n) (j : Fin m), (i : ℕ) ≠ (j : ℕ) → D i j = 0) ∧
    (∀ (i : Fin n) (j : Fin m) (k : Fin (min n m)),
        (i : ℕ) = (j : ℕ) → (i : ℕ) = (k : ℕ) → D i j = f k) ∧
    (∀ i : Fin (min n m), ∀ h : (i : ℕ) + 1 < min n m,
        f i ∣ f ⟨(i : ℕ) + 1, h⟩)

/-- Off-diagonal entries of a matrix in Smith normal form vanish. -/
theorem Matrix.IsSmithNormal.apply_eq_zero_of_ne {n m : ℕ}
    {D : Matrix (Fin n) (Fin m) R} (hD : D.IsSmithNormal) {i : Fin n} {j : Fin m}
    (hij : (i : ℕ) ≠ (j : ℕ)) : D i j = 0 := by
  obtain ⟨_, h0, _⟩ := hD
  exact h0 i j hij

/-- A matrix in Smith normal form has a family of diagonal entries forming a divisibility chain. -/
theorem Matrix.IsSmithNormal.exists_diag {n m : ℕ}
    {D : Matrix (Fin n) (Fin m) R} (hD : D.IsSmithNormal) :
    ∃ f : Fin (min n m) → R,
      (∀ (i : Fin n) (j : Fin m) (k : Fin (min n m)),
          (i : ℕ) = (j : ℕ) → (i : ℕ) = (k : ℕ) → D i j = f k) ∧
      ∀ i : Fin (min n m), ∀ h : (i : ℕ) + 1 < min n m, f i ∣ f ⟨(i : ℕ) + 1, h⟩ := by
  obtain ⟨f, -, hdiag, hchain⟩ := hD
  exact ⟨f, hdiag, hchain⟩

/-- `R` is an *elementary divisor domain* if for all `n, m ≥ 1` and every
`n × m` matrix `A` there exist invertible matrices `U` (size `n`) and `V`
(size `m`) such that `U * A * V` is in Smith normal form. -/
class IsElementaryDivisorDomain (R : Type*) [CommRing R] : Prop where
  /-- Every nonempty rectangular matrix over `R` becomes Smith normal after multiplying by
  invertible matrices on both sides. -/
  exists_isSmithNormal : ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m → ∀ (A : Matrix (Fin n) (Fin m) R),
    ∃ (U : Matrix (Fin n) (Fin n) R) (V : Matrix (Fin m) (Fin m) R),
      IsUnit U ∧ IsUnit V ∧ (U * A * V).IsSmithNormal

add_to_stacks 0ASR
  "(1) A Bézout domain: every finitely generated ideal is principal."
  IsBezout

attribute [stacks_fixed 0ASR
  "(2) An elementary divisor domain: every rectangular matrix with at least one row and one
  column can be brought into Smith normal form by invertible row and column operations."]
  IsElementaryDivisorDomain

/-- The ideal of `R` generated by the entries of a matrix. -/
def Matrix.entriesIdeal {n m : Type*} (A : Matrix n m R) : Ideal R :=
  Ideal.span (Set.range (Function.uncurry A))

/-- `Matrix.entriesIdeal A` is the span of the entries of `A`. -/
theorem Matrix.entriesIdeal_def {n m : Type*} (A : Matrix n m R) :
    A.entriesIdeal = Ideal.span (Set.range (Function.uncurry A)) := rfl

/-- Every entry of `A` belongs to the ideal generated by the entries of `A`. -/
@[simp]
theorem Matrix.apply_mem_entriesIdeal {n m : Type*} (A : Matrix n m R) (i : n) (j : m) :
    A i j ∈ A.entriesIdeal :=
  Ideal.subset_span ⟨(i, j), rfl⟩

/-- The ideal generated by the entries of `A` is contained in an ideal `I` exactly when every
entry of `A` belongs to `I`. -/
theorem Matrix.entriesIdeal_le_iff {n m : Type*} {A : Matrix n m R} {I : Ideal R} :
    A.entriesIdeal ≤ I ↔ ∀ i j, A i j ∈ I := by
  simp [Matrix.entriesIdeal_def, Ideal.span_le, Set.range_subset_iff, Prod.forall,
    Function.uncurry]

/-- The ideal generated by the entries of `M * N` is contained in the ideal generated by the
entries of the right factor `N`. -/
theorem Matrix.entriesIdeal_mul_le_right {p n m : Type*} [Fintype n]
    (M : Matrix p n R) (N : Matrix n m R) : (M * N).entriesIdeal ≤ N.entriesIdeal :=
  Matrix.entriesIdeal_le_iff.mpr fun i j => by
    rw [Matrix.mul_apply]
    exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (N.apply_mem_entriesIdeal k j)

/-- The ideal generated by the entries of `M * N` is contained in the ideal generated by the
entries of the left factor `M`. -/
theorem Matrix.entriesIdeal_mul_le_left {p n m : Type*} [Fintype n]
    (M : Matrix p n R) (N : Matrix n m R) : (M * N).entriesIdeal ≤ M.entriesIdeal :=
  Matrix.entriesIdeal_le_iff.mpr fun i j => by
    rw [Matrix.mul_apply]
    exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_right _ _ (M.apply_mem_entriesIdeal i k)

/-- Multiplying a matrix on both sides by invertible matrices preserves the ideal generated by
its entries. -/
theorem Matrix.entriesIdeal_mul_mul_of_isUnit {n m : Type*} [Fintype n] [DecidableEq n]
    [Fintype m] [DecidableEq m] {U : Matrix n n R} {V : Matrix m m R}
    (A : Matrix n m R) (hU : IsUnit U) (hV : IsUnit V) :
    (U * A * V).entriesIdeal = A.entriesIdeal := by
  obtain ⟨u, rfl⟩ := hU
  obtain ⟨v, rfl⟩ := hV
  refine le_antisymm ((Matrix.entriesIdeal_mul_le_left _ _).trans
    (Matrix.entriesIdeal_mul_le_right _ _)) ?_
  have hA : A = (↑u⁻¹ : Matrix n n R) *
      ((u : Matrix n n R) * A * (v : Matrix m m R)) * (↑v⁻¹ : Matrix m m R) := by
    rw [Matrix.mul_assoc, Matrix.mul_assoc, Units.mul_inv, Matrix.mul_one, ← Matrix.mul_assoc,
      Units.inv_mul, Matrix.one_mul]
  conv_lhs => rw [hA]
  exact (Matrix.entriesIdeal_mul_le_left _ _).trans (Matrix.entriesIdeal_mul_le_right _ _)

/-- **Stacks 0ASS**.
Every elementary divisor domain is a Bézout ring: if `R` is an elementary divisor
domain, then every finitely generated ideal of `R` is principal (`IsBezout R`). -/
@[stacks 0ASS]
theorem isBezout_of_isElementaryDivisorDomain {R : Type*} [CommRing R]
    [IsElementaryDivisorDomain R] : IsBezout R := by
  rw [IsBezout.iff_span_pair_isPrincipal]
  intro x y
  set A : Matrix (Fin 2) (Fin 1) R := fun i _ => if i = 0 then x else y with hA
  obtain ⟨U, V, hU, hV, hD⟩ :=
    IsElementaryDivisorDomain.exists_isSmithNormal 2 1 (by norm_num) (by norm_num) A
  obtain ⟨f, hdiag, -⟩ := hD.exists_diag
  have hf0 : (0 : ℕ) < min 2 1 := by norm_num
  have hAspan : A.entriesIdeal = Ideal.span {x, y} := by
    refine le_antisymm (Matrix.entriesIdeal_le_iff.mpr fun i j => ?_) ?_
    · fin_cases i <;> fin_cases j <;> exact Ideal.subset_span (by simp [hA])
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨by simpa [hA] using A.apply_mem_entriesIdeal 0 0,
        by simpa [hA] using A.apply_mem_entriesIdeal 1 0⟩
  have hDf : (U * A * V).entriesIdeal = Ideal.span {f ⟨0, hf0⟩} := by
    refine le_antisymm (Matrix.entriesIdeal_le_iff.mpr fun i j => ?_) ?_
    · fin_cases i <;> fin_cases j
      · simp [hdiag 0 0 ⟨0, hf0⟩ rfl rfl]
      · simp [hD.apply_eq_zero_of_ne (i := 1) (j := 0) (by decide)]
    · rw [Ideal.span_le, Set.singleton_subset_iff, ← hdiag 0 0 ⟨0, hf0⟩ rfl rfl]
      exact (U * A * V).apply_mem_entriesIdeal 0 0
  rw [← hAspan, ← Matrix.entriesIdeal_mul_mul_of_isUnit A hU hV, hDf]
  exact ⟨f ⟨0, hf0⟩, by rw [Ideal.submodule_span_eq]⟩

/-- Over a Bézout ring without zero divisors, a common factor can be pulled out of a finite
tuple `t : Fin (m+1) → R`: there are `d` and a unimodular tuple `g` (witnessed by coefficients
`c` with `∑ c i * g i = 1`) such that `t i = d * g i` for all `i`. -/
theorem exists_factor_unimodular [IsBezout R] [NoZeroDivisors R] {m : ℕ} (t : Fin (m + 1) → R) :
    ∃ (d : R) (g c : Fin (m + 1) → R), (∀ i, t i = d * g i) ∧ ∑ i, c i * g i = 1 := by
  induction m with
  | zero =>
    refine ⟨t 0, fun _ => 1, fun _ => 1, ?_, ?_⟩
    · intro i
      fin_cases i
      simp
    · simp
  | succ m ih =>
    obtain ⟨d', g', c', ht', hg'⟩ := ih (Fin.tail t)
    set e := IsBezout.gcd (t 0) d'
    obtain ⟨p, hp⟩ : e ∣ t 0 := IsBezout.gcd_dvd_left (t 0) d'
    obtain ⟨q, hq⟩ : e ∣ d' := IsBezout.gcd_dvd_right (t 0) d'
    obtain ⟨a, b, hab⟩ := IsBezout.gcd_eq_sum (t 0) d'
    by_cases he : e = 0
    · have htzero : ∀ i, t i = 0 := by
        intro i
        refine Fin.cases ?_ ?_ i
        · rw [hp, he, zero_mul]
        · intro j
          simpa [Fin.tail] using (show Fin.tail t j = 0 by rw [ht' j, hq, he, zero_mul, zero_mul])
      refine ⟨0, Fin.cons 1 0, Fin.cons 1 0, ?_, ?_⟩
      · intro i
        rw [htzero i, zero_mul]
      · rw [Fin.sum_univ_succ]
        simp
    · have hpq : a * p + b * q = 1 := by
        refine mul_left_cancel₀ he ?_
        rw [mul_one]
        linear_combination hab - a * hp - b * hq
      refine ⟨e, Fin.cons p (fun i => q * g' i), Fin.cons a (fun i => b * c' i), ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ ?_ i
        · simp [hp]
        · intro j
          rw [show t j.succ = Fin.tail t j from rfl, ht' j, hq, Fin.cons_succ]
          ring
      · rw [Fin.sum_univ_succ]
        simp only [Fin.cons_zero, Fin.cons_succ]
        have : ∑ i, b * c' i * (q * g' i) = b * q * ∑ i, c' i * g' i := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun i _ => by ring
        rwa [this, hg', mul_one]

/-- The determinant of the block matrix with rows `(x, d • A₀)`, `(-y, a • A₀)` and
`(0, Aᵢ)` for `i ≥ 1`, where `Aᵢ` is the `i`-th row of `A`, is `(a * x + y * d) * det A`. -/
theorem Matrix.det_cons_cons_smul_row_zero {n : ℕ} (x y a d : R)
    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) R) :
    (Matrix.of (Fin.cons (Fin.cons x (fun j => d * A 0 j))
      (Fin.cons (Fin.cons (-y) (fun j => a * A 0 j))
        (fun i => Fin.cons 0 (fun j => A (Fin.succ i) j)))) :
          Matrix (Fin (n+2)) (Fin (n+2)) R).det = (a * x + y * d) * A.det := by
  set M : Matrix (Fin (n+2)) (Fin (n+2)) R :=
    Matrix.of (Fin.cons (Fin.cons x (fun j => d * A 0 j))
      (Fin.cons (Fin.cons (-y) (fun j => a * A 0 j))
        (fun i => Fin.cons 0 (fun j => A (Fin.succ i) j)))) with hM_def
  rw [Matrix.det_succ_column_zero, Fin.sum_univ_succ, Fin.sum_univ_succ]
  have htail : ∀ i : Fin n,
      (-1:R) ^ (((Fin.succ (Fin.succ i)) : Fin (n+2)) : ℕ) * M (Fin.succ (Fin.succ i)) 0 *
        (M.submatrix (Fin.succ (Fin.succ i)).succAbove Fin.succ).det = 0 := by
    intro i
    have : M (Fin.succ (Fin.succ i)) 0 = 0 := by
      simp [hM_def, Matrix.of_apply, Fin.cons_succ, Fin.cons_zero]
    rw [this]
    ring
  rw [Finset.sum_eq_zero (fun i _ => htail i)]
  have minors : (M.submatrix (Fin.succAbove 0) Fin.succ = A.updateRow 0 (a • A 0)) ∧
      (M.submatrix ((Fin.succ 0 : Fin (n+2))).succAbove Fin.succ = A.updateRow 0 (d • A 0)) := by
    refine ⟨?_, ?_⟩ <;> ext i j <;> refine Fin.cases ?_ (fun k => ?_) i <;>
      simp [hM_def, Matrix.submatrix_apply, Fin.cons_succ, Matrix.updateRow_self,
        Matrix.updateRow_ne]
  have hM00 : M 0 0 = x := by
    simp [hM_def, Matrix.of_apply, Fin.cons_zero]
  have hM10 : M (Fin.succ 0) 0 = -y := by
    simp [hM_def, Matrix.of_apply, Fin.cons_zero]
  rw [hM00, hM10, minors.1, minors.2, add_zero]
  simp only [Matrix.det_updateRow_smul, Matrix.updateRow_eq_self,
    Fin.val_zero, Fin.val_succ, pow_zero]
  ring

@[deprecated (since := "2026-09-27")]
alias Matrix.det_cons_cons := Matrix.det_cons_cons_smul_row_zero

/-- A row of length `n+1` admitting coefficients `c` with `∑ c i * f i = 1` is the first row of a
square matrix with unit determinant. -/
theorem unimodular_completion_of_sum_mul_eq_one [IsBezout R] [NoZeroDivisors R] {n : ℕ}
    (f c : Fin (n + 1) → R) (hc : ∑ i, c i * f i = 1) :
    ∃ M : Matrix (Fin (n + 1)) (Fin (n + 1)) R, IsUnit M.det ∧ ∀ j, M 0 j = f j := by
  induction n with
  | zero =>
    refine ⟨Matrix.of (fun _ _ => f 0), ?_, ?_⟩
    · rw [Matrix.det_fin_one]
      exact IsUnit.of_mul_eq_one (c 0) (by simpa [mul_comm] using hc)
    · intro j
      fin_cases j
      rfl
  | succ n ih =>
    obtain ⟨d, g, gc, htg, hg⟩ := exists_factor_unimodular (Fin.tail f)
    set b := ∑ i, c (Fin.succ i) * g i with hb_def
    have hbez : c 0 * f 0 + b * d = 1 := by
      have key : ∑ i, c (Fin.succ i) * f (Fin.succ i) = b * d := by
        rw [hb_def, Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => by rw [show f i.succ = d * g i from htg i]; ring
      rwa [Fin.sum_univ_succ, key] at hc
    obtain ⟨A, hAdet, hA0⟩ := ih g gc hg
    refine ⟨Matrix.of (Fin.cons (Fin.cons (f 0) (fun j => d * A 0 j))
        (Fin.cons (Fin.cons (-b) (fun j => c 0 * A 0 j))
          (fun i => Fin.cons 0 (fun j => A (Fin.succ i) j)))), ?_, ?_⟩
    · rwa [Matrix.det_cons_cons_smul_row_zero, hbez, one_mul]
    · intro j
      refine Fin.cases ?_ ?_ j
      · simp [Matrix.of_apply, Fin.cons_zero]
      · intro k
        rw [show f k.succ = d * g k from htg k]
        simp [Matrix.of_apply, Fin.cons_zero, Fin.cons_succ, hA0 k]

/-- **Stacks 0ASW**.
Over a Bézout domain `R`, any row `f : Fin n → R` whose entries generate the unit ideal is the
first row of some invertible `n × n` matrix over `R`. -/
@[stacks 0ASW]
theorem bezout_unimodular_completion {R : Type*} [CommRing R] [IsBezout R] [IsDomain R]
    {n : ℕ} [NeZero n] (f : Fin n → R)
    (hf : Ideal.span (Set.range f) = ⊤) :
    ∃ M : Matrix (Fin n) (Fin n) R, IsUnit M.det ∧ ∀ j : Fin n, M 0 j = f j := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne n)
  obtain ⟨c, hc⟩ : ∃ c : Fin (m+1) → R, ∑ i, c i * f i = 1 := by
    rw [Ideal.eq_top_iff_one, Ideal.span, Submodule.mem_span_range_iff_exists_fun] at hf
    obtain ⟨c, hc⟩ := hf
    exact ⟨c, by simpa [smul_eq_mul] using hc⟩
  exact unimodular_completion_of_sum_mul_eq_one f c hc
