module

public import StacksFrontier.RingTheory.SerreIntersection.TwistedFlatness
public import StacksFrontier.RingTheory.CompleteLocalRing.Regular
public import StacksFrontier.RingTheory.MvPowerSeries.RegularLocal
public import StacksFrontier.AlgebraicGeometry.Intersection.ReductionToTheDiagonal.SerreMultiplicity

/-!
# The diagonal of a power series ring

For a commutative ring `K`, the power series ring `K[[y, x]]` in two sets of `n` variables receives
two inclusions `left` and `right` of `K[[x]]` and maps onto it by the diagonal `diag`. This file
proves that both inclusions are flat local homomorphisms, computes the kernel of `killFirst`, and
expresses the Euler characteristic of two finite `K[[x]]`-modules as an intersection multiplicity
against the diagonal.

## Main definitions

* `left`: the inclusion `K[[x]] → K[[y, x]]`, `x ↦ x`.
* `right`: the inclusion `K[[x]] → K[[y, x]]`, `x ↦ y`.
* `diag`: the diagonal `K[[y, x]] → K[[x]]`, `y ↦ x`, `x ↦ x`.
* `killFirst`: the map `K[[y, x]] → K[[x]]`, `y ↦ 0`.

## Main results

* `torEulerCharacteristic_eq_localIntersectionMultiplicity`: the Euler characteristic `χ(M, N)`
  over `K[[x]]` equals the intersection multiplicity over `K[[y, x]]` of the diagonal against
  `(K[[y, x]] ⊗_{K[[x]]} M) ⊗_{K[[x]]} N`.
* `exists_isRegular_span_eq_ker`: the kernel of a surjection of regular local rings is generated by
  a regular sequence.
-/

@[expose] public noncomputable section

open MvPowerSeries IsLocalRing

universe u

namespace Stacks.SerreIntersection.PowerSeriesDiagonal

section CommRing

variable (K : Type u) [CommRing K] (n : ℕ)

/-- The inclusion of the second set of variables `K[[x]] → K[[y, x]]`, `x ↦ x`. -/
def left : MvPowerSeries (Fin n) K →+* MvPowerSeries (Fin n ⊕ Fin n) K :=
  (rename (R := K) (Function.Embedding.inr : Fin n ↪ Fin n ⊕ Fin n)).toRingHom

/-- The inclusion of the first set of variables `K[[x]] → K[[y, x]]`, `x ↦ y`. -/
def right : MvPowerSeries (Fin n) K →+* MvPowerSeries (Fin n ⊕ Fin n) K :=
  (rename (R := K) (Function.Embedding.inl : Fin n ↪ Fin n ⊕ Fin n)).toRingHom

/-- The diagonal `K[[y, x]] → K[[x]]`, `y ↦ x`, `x ↦ x`. -/
def diag : MvPowerSeries (Fin n ⊕ Fin n) K →+* MvPowerSeries (Fin n) K :=
  (rename (R := K) (Sum.elim id id : Fin n ⊕ Fin n → Fin n)).toRingHom

/-- Killing the first set of variables, `K[[y, x]] → K[[x]]`, `y ↦ 0`. -/
def killFirst : MvPowerSeries (Fin n ⊕ Fin n) K →+* MvPowerSeries (Fin n) K :=
  (killCompl (R := K) (Function.Embedding.inr : Fin n ↪ Fin n ⊕ Fin n)).toRingHom

/-- The diagonal restricted along `left` is the identity of `K[[x]]`. -/
theorem diag_left (r : MvPowerSeries (Fin n) K) : diag K n (left K n r) = r := by
  change rename _ (rename _ r) = r
  rw [rename_rename]
  exact rename_id_apply r

/-- The diagonal restricted along `right` is the identity of `K[[x]]`. -/
theorem diag_right (r : MvPowerSeries (Fin n) K) : diag K n (right K n r) = r := by
  change rename _ (rename _ r) = r
  rw [rename_rename]
  exact rename_id_apply r

/-- Killing the first set of variables restricted along `left` is the identity of `K[[x]]`. -/
theorem killFirst_left (r : MvPowerSeries (Fin n) K) : killFirst K n (left K n r) = r :=
  killCompl_rename_app r

/-- The kernel of killing the first set of variables is generated by them. -/
theorem ker_killFirst_eq_map_span_X :
    RingHom.ker (killFirst K n) = Ideal.map (right K n)
      (Ideal.span (Set.range (X : Fin n → MvPowerSeries (Fin n) K))) := by
  change RingHom.ker (killCompl (R := K) (Function.Embedding.inr : Fin n ↪ Fin n ⊕ Fin n)) = _
  rw [ker_killCompl_inr, Ideal.map_span, ← Set.range_comp]
  congr 1
  ext i
  simp [right, rename_X]

/-- Composing `right` with the swap of the two sets of variables gives `left`. -/
theorem swap_right : (renameEquiv K (Equiv.sumComm (Fin n) (Fin n))).toRingEquiv.toRingHom.comp
    (right K n) = left K n := by
  ext r : 1
  change rename (Equiv.sumComm (Fin n) (Fin n))
    (rename (Function.Embedding.inl : Fin n ↪ Fin n ⊕ Fin n) r) =
      rename (Function.Embedding.inr : Fin n ↪ Fin n ⊕ Fin n) r
  rw [rename_rename]
  rfl

variable [IsNoetherianRing K]

/-- `K[[y, x]]` is flat over `K[[x]]` through `right`. -/
theorem flat_right : (right K n).Flat := flat_rename_inl n

/-- `K[[y, x]]` is flat over `K[[x]]` through `left`. -/
theorem flat_left : (left K n).Flat := by
  rw [← swap_right]
  exact (flat_right K n).comp (RingHom.Flat.of_bijective
    (renameEquiv K (Equiv.sumComm (Fin n) (Fin n))).toRingEquiv.bijective)

omit [IsNoetherianRing K] in
/-- Renaming variables along a map with finite fibres is a local homomorphism of power series
rings. -/
theorem isLocalHom_rename {σ τ : Type*} (f : σ → τ) [Filter.TendstoCofinite f] :
    IsLocalHom (rename (R := K) f).toRingHom := by
  refine ⟨fun p hp => ?_⟩
  rw [MvPowerSeries.isUnit_iff_constantCoeff] at hp ⊢
  change IsUnit (constantCoeff (rename f p)) at hp
  rwa [constantCoeff_rename] at hp

/-- `right` is a local homomorphism. -/
instance : IsLocalHom (right K n) := isLocalHom_rename K _

/-- `left` is a local homomorphism. -/
instance : IsLocalHom (left K n) := isLocalHom_rename K _

/-- `K[[y, x]]`, viewed as a `K[[x]]`-module through `left`, is flat. -/
instance : Module.Flat (MvPowerSeries (Fin n) K)
    (Twist (left K n) (MvPowerSeries (Fin n ⊕ Fin n) K)) :=
  Twist.flat_of_ringHomFlat (flat_left K n)

/-- `K[[y, x]]`, viewed as a `K[[x]]`-module through `right`, is flat. -/
instance : Module.Flat (MvPowerSeries (Fin n) K)
    (Twist (right K n) (MvPowerSeries (Fin n ⊕ Fin n) K)) :=
  Twist.flat_of_ringHomFlat (flat_right K n)

omit [IsNoetherianRing K] in
/-- Over a local ring `K`, each variable `X i` lies in the maximal ideal of `K[[x]]`. -/
theorem X_mem_maximalIdeal [IsLocalRing K] (i : Fin n) :
    (X i : MvPowerSeries (Fin n) K) ∈ maximalIdeal (MvPowerSeries (Fin n) K) := by
  rw [mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
    constantCoeff_X]
  exact not_isUnit_zero

omit [IsNoetherianRing K] in
/-- The kernel of killing the first set of variables lies in the ideal generated by the image of
the maximal ideal through the second. -/
theorem ker_killFirst_le [IsLocalRing K] :
    RingHom.ker (killFirst K n) ≤
      Ideal.map (right K n) (maximalIdeal (MvPowerSeries (Fin n) K)) := by
  rw [ker_killFirst_eq_map_span_X]
  exact Ideal.map_mono (Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact X_mem_maximalIdeal K n i))

end CommRing

section Field

variable (K : Type u) [Field K] (n : ℕ)

/-- Over a field, the kernel of killing the first set of variables is the ideal generated by the
image of the maximal ideal of `K[[x]]` under `right`. -/
theorem ker_killFirst :
    RingHom.ker (killFirst K n) =
      Ideal.map (right K n) (maximalIdeal (MvPowerSeries (Fin n) K)) := by
  rw [ker_killFirst_eq_map_span_X, MvPowerSeries.maximalIdeal_eq_span_range_X]

/-- **Tor independence**: the base change of a finite `K[[x]]`-module along the inclusion of the
second set of variables is flat over `K[[x]]` through the first. -/
instance flat_twist_ext_left (M : Type u) [AddCommGroup M] [Module (MvPowerSeries (Fin n) K) M]
    [Module.Finite (MvPowerSeries (Fin n) K) M] :
    Module.Flat (MvPowerSeries (Fin n) K) (Twist (right K n) (Ext (left K n) M)) :=
  flat_twist_ext (left K n) (right K n) (killFirst K n) (killFirst_left K n) (ker_killFirst K n) M

end Field

section Diagonal

variable (K : Type u) [CommRing K] [IsNoetherianRing K] (n : ℕ)

/-- **Reduction to the diagonal for power series.** For finite `K[[x]]`-modules `M` and `N`, with
`K[[y, x]] ⊗_{K[[x]]} M` flat over `K[[x]]` through the inclusion of the first set of variables
(automatic over a field, `flat_twist_ext_left`), the Euler characteristic `χ(M, N)` over `K[[x]]`
is the Tor-formula multiplicity over `K[[y, x]]` of the diagonal against the complete tensor
product `(K[[y, x]] ⊗_{K[[x]]} M) ⊗_{K[[x]]} N`. -/
theorem torEulerCharacteristic_eq_localIntersectionMultiplicity (M N : Type u) [AddCommGroup M]
    [Module (MvPowerSeries (Fin n) K) M] [Module.Finite (MvPowerSeries (Fin n) K) M]
    [Module.Flat (MvPowerSeries (Fin n) K) (Twist (right K n) (Ext (left K n) M))]
    [AddCommGroup N] [Module (MvPowerSeries (Fin n) K) N]
    [Module.Finite (MvPowerSeries (Fin n) K) N] :
    Stacks.Intersection.torEulerCharacteristic (MvPowerSeries (Fin n) K) M N =
      (RingHom.ker (diag K n)).localIntersectionMultiplicity (Pair (left K n) (right K n) M N) := by
  unfold Stacks.Intersection.torEulerCharacteristic Ideal.localIntersectionMultiplicity
  congr 1
  funext i
  rw [length_tor_diag_pair (left K n) (right K n) (diag K n) (diag_left K n) (diag_right K n) M N i]

end Diagonal

end Stacks.SerreIntersection.PowerSeriesDiagonal

namespace Stacks.SerreIntersection

/-- **The kernel of a surjection of regular local rings is generated by a regular sequence** of
length the difference of the dimensions (Stacks 00NR and 00NQ). -/
theorem exists_isRegular_span_eq_ker {A C : Type u} [CommRing A] [CommRing C]
    [IsRegularLocalRing A] [IsRegularLocalRing C] (g : A →+* C) (hg : Function.Surjective g)
    (c d : ℕ) (hC : ringKrullDim C = d) (hA : ringKrullDim A = (d + c : ℕ)) :
    ∃ f : Fin c → A, RingTheory.Sequence.IsRegular A (List.ofFn f) ∧
      RingHom.ker g = Ideal.span (Set.range f) := by
  have hq : IsRegularLocalRing (A ⧸ RingHom.ker g) :=
    IsRegularLocalRing.of_ringEquiv (RingHom.quotientKerEquivOfSurjective hg).symm
  obtain ⟨xs, hxs, hlen, c', hc', htake, hdim⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
      (RingHom.ker g) hq
  have hdq : ringKrullDim (A ⧸ RingHom.ker g) = d := by
    rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hg), hC]
  rw [hdq, hA] at hdim
  have hcc : c' = c := by
    have : ((d + c' : ℕ) : WithBot ℕ∞) = ((d + c : ℕ) : WithBot ℕ∞) := by
      rw [← hdim]; push_cast; rfl
    have := Nat.cast_injective (R := WithBot ℕ∞) this
    omega
  subst hcc
  have hreg :=
    ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      A).1 xs hxs hlen).1
  have hmem : ∀ x ∈ xs.take c', x ∈ IsLocalRing.maximalIdeal A := fun x hx => by
    rw [← hxs]
    exact Ideal.subset_span (List.mem_of_mem_take hx)
  have hweak : RingTheory.Sequence.IsWeaklyRegular A (xs.take c') := by
    have h := hreg.toIsWeaklyRegular
    rw [← List.take_append_drop c' xs] at h
    exact ((RingTheory.Sequence.isWeaklyRegular_append_iff A _ _).mp h).1
  have hregt := RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal A hmem hweak
  have hl : (xs.take c').length = c' := by
    rw [List.length_take]; omega
  refine ⟨fun i => (xs.take c').get (i.cast hl.symm), ?_, ?_⟩
  · convert hregt
    exact List.ext_get (by simp [hl]) (fun i h1 h2 => by simp)
  · rw [← htake, Ideal.ofList]
    congr 1
    refine Set.ext fun x => ⟨fun hx => ?_, ?_⟩
    · obtain ⟨i, hi⟩ := List.get_of_mem hx
      exact ⟨i.cast hl, by simp [← hi]⟩
    · rintro ⟨i, rfl⟩
      exact List.get_mem _ _

end Stacks.SerreIntersection
