module

public import StacksFrontier.AlgebraicGeometry.Intersection.ComputingIntersectionMultiplicities.HilbertPolynomialMultiplicity
public import StacksFrontier.AlgebraicGeometry.Intersection.AlgebraicMultiplicities.FiniteLengthConditions
public import StacksFrontier.RingTheory.KrullDimension.SystemOfParameters

/-!
# The Tor-formula multiplicity of a module against a regular sequence
-/

@[expose] public noncomputable section

open Polynomial IsLocalRing

universe u

namespace Stacks.SerreIntersection

variable {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

/-- **Krull's height theorem for modules.** If `M ⧸ I M` has dimension zero for an ideal `I`
generated by `c` elements, then `dim Supp M ≤ c`. -/
theorem supportDim_le_of_supportDim_quotient_eq_zero {c : ℕ} (f : Fin c → A) (I : Ideal A)
    (hI : I = Ideal.span (Set.range f)) (M : Type u) [AddCommGroup M] [Module A M]
    [Module.Finite A M] (hM : Module.supportDim A (M ⧸ I • (⊤ : Submodule A M)) = 0) :
    Module.supportDim A M ≤ (c : WithBot ℕ∞) := by
  have hne : Nontrivial (M ⧸ I • (⊤ : Submodule A M)) :=
    (Module.supportDim_ne_bot_iff_nontrivial A _).mp (by rw [hM]; norm_num)
  have : Nontrivial M := (I • (⊤ : Submodule A M)).mkQ_surjective.nontrivial
  let K : Ideal A := Module.annihilator A M
  have : Nontrivial (A ⧸ K) := Ideal.Quotient.nontrivial_iff.mpr
    (mt Module.annihilator_eq_top_iff.mp (not_subsingleton M))
  have : IsLocalRing (A ⧸ K) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk K) Ideal.Quotient.mk_surjective
  have hdef : IsIdealOfDefinition (Ideal.map (Ideal.Quotient.mk K) I) :=
    ((Ideal.idealOfDefinition_support_length_tfae I hne).out 4 2).mp (le_of_eq hM)
  set J := Ideal.map (Ideal.Quotient.mk K) I with hJ
  have hdef' : J.radical = maximalIdeal (A ⧸ K) := hdef
  have hJne : J ≠ ⊤ := fun e =>
    (maximalIdeal.isMaximal (A ⧸ K)).ne_top (by rw [← hdef', e, Ideal.radical_top])
  have hspan : J.spanFinrank ≤ c := by
    have : J = Ideal.span (Set.range fun i => Ideal.Quotient.mk K (f i)) := by
      simp only [J, hI, Ideal.map_span, ← Set.range_comp]
      rfl
    rw [this]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
    simpa [← Set.image_univ] using Set.ncard_image_le
      (f := fun i => Ideal.Quotient.mk K (f i)) Set.finite_univ
  rw [Module.supportDim_eq_ringKrullDim_quotient_annihilator]
  calc ringKrullDim (A ⧸ K) = ((maximalIdeal (A ⧸ K)).height : WithBot ℕ∞) :=
        maximalIdeal_height_eq_ringKrullDim.symm
    _ = ((J.height : ℕ∞) : WithBot ℕ∞) := by
        rw [← hdef',
          Stacks.KrullDimension.SystemOfParameters.radical_height]
    _ ≤ ((J.spanFinrank : ℕ∞) : WithBot ℕ∞) := by
        exact_mod_cast Ideal.height_le_spanFinrank J hJne
    _ ≤ (c : WithBot ℕ∞) := by exact_mod_cast hspan

/-- The degree of a polynomial computing the generalized Hilbert function, read in `WithBot ℕ`. -/
private theorem degree_eq_of_map_eq {P : ℚ[X]} {d : WithBot ℕ∞} {c : ℕ}
    (h : P.degree.map (Nat.cast : ℕ → ℕ∞) = d) (hd : d = (c : WithBot ℕ∞)) :
    P.degree = (c : WithBot ℕ) := by
  have hinj : Function.Injective (WithBot.map (Nat.cast : ℕ → ℕ∞)) :=
    WithBot.map_injective (fun a b hab => by exact_mod_cast hab)
  apply hinj
  rw [h, hd]
  simp

/-- The multiplicity is `c !` times the degree-`c` coefficient of a polynomial computing the
generalized Hilbert function, whose degree is read off from `dim Supp M`. -/
private theorem exists_poly_computes_hilbert_and_multiplicity_eq {c : ℕ} (f : Fin c → A)
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f)) (I : Ideal A)
    (hI : I = Ideal.span (Set.range f)) (M : Type u) [AddCommGroup M] [Module A M]
    [Module.Finite A M] (hM : Module.supportDim A (M ⧸ I • (⊤ : Submodule A M)) = 0) :
    ∃ P : ℚ[X], I.ComputesGeneralizedHilbertPoly M P ∧
      P.degree.map (Nat.cast : ℕ → ℕ∞) = Module.supportDim A M ∧
      I.localIntersectionMultiplicity M = (c.factorial : ℚ) * P.coeff c := by
  obtain ⟨P, hP⟩ := Ideal.exists_computesGeneralizedHilbertPoly I hM
  refine ⟨P, hP, Ideal.degree_eq_supportDim_of_computesGeneralizedHilbertPoly I hM hP, ?_⟩
  rw [Ideal.localIntersectionMultiplicity_eq_generalizedHilbertSamuelMultiplicity f I M hf hI hM,
    Ideal.generalizedHilbertSamuelMultiplicity_eq_factorial_mul_coeff I M hP c]

/-- **The multiplicity vanishes below the length of the sequence.** Let `f₁, …, f_c` be a regular
sequence generating `I` and let `M` be a finite module with `M ⧸ I M` of dimension zero. If
`dim Supp M < c`, then the Tor-formula multiplicity `∑ (-1)ⁱ length Torᵢ(A ⧸ I, M)` vanishes: it
is `c !` times the coefficient of degree `c` of a polynomial of degree `dim Supp M`. -/
theorem localIntersectionMultiplicity_eq_zero_of_supportDim_lt {c : ℕ} (f : Fin c → A)
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f)) (I : Ideal A)
    (hI : I = Ideal.span (Set.range f)) (M : Type u) [AddCommGroup M] [Module A M]
    [Module.Finite A M] (hM : Module.supportDim A (M ⧸ I • (⊤ : Submodule A M)) = 0)
    (hlt : Module.supportDim A M < (c : WithBot ℕ∞)) :
    I.localIntersectionMultiplicity M = 0 := by
  obtain ⟨P, hP, hdeg, hmul⟩ :=
    exists_poly_computes_hilbert_and_multiplicity_eq f hf I hI M hM
  rw [hmul]
  have hlt' : P.degree < (c : WithBot ℕ) := by
    rw [← hdeg] at hlt
    cases hP' : P.degree with
    | bot => exact WithBot.bot_lt_coe c
    | coe k =>
      rw [hP'] at hlt
      exact WithBot.coe_lt_coe.mpr (by simpa using hlt)
  rw [Polynomial.coeff_eq_zero_of_degree_lt hlt', mul_zero]

/-- **The multiplicity is positive at the length of the sequence.** Let `f₁, …, f_c` be a regular
sequence generating `I` and let `M` be a finite module with `M ⧸ I M` of dimension zero. If
`dim Supp M = c`, then the Tor-formula multiplicity is positive: it is `c !` times the leading
coefficient of a polynomial of degree `c` taking natural values. -/
theorem localIntersectionMultiplicity_pos_of_supportDim_eq {c : ℕ} (f : Fin c → A)
    (hf : RingTheory.Sequence.IsRegular A (List.ofFn f)) (I : Ideal A)
    (hI : I = Ideal.span (Set.range f)) (M : Type u) [AddCommGroup M] [Module A M]
    [Module.Finite A M] (hM : Module.supportDim A (M ⧸ I • (⊤ : Submodule A M)) = 0)
    (heq : Module.supportDim A M = (c : WithBot ℕ∞)) :
    0 < I.localIntersectionMultiplicity M := by
  obtain ⟨P, hP, hmap, hmul⟩ :=
    exists_poly_computes_hilbert_and_multiplicity_eq f hf I hI M hM
  have hdeg : P.degree = (c : WithBot ℕ) := degree_eq_of_map_eq hmap heq
  rw [hmul]
  have hPne : P ≠ 0 := fun h => by simp [h] at hdeg
  have hnonneg : 0 ≤ P.leadingCoeff := by
    refine Stacks.HilbertFunction.PolynomialQuotient.leadingCoeff_nonneg_of_eventually_nonneg P ?_
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp hP
    refine Filter.eventually_atTop.mpr ⟨(N : ℤ), fun k hk => ?_⟩
    obtain ⟨p, -, hp2⟩ := hN k.toNat (by omega)
    have hcast : ((k.toNat : ℕ) : ℚ) = (k : ℚ) := by
      have : (k.toNat : ℤ) = k := Int.toNat_of_nonneg (by omega)
      exact_mod_cast congrArg (fun z : ℤ => (z : ℚ)) this
    rw [← hcast, hp2]
    positivity
  have hlead : 0 < P.leadingCoeff :=
    lt_of_le_of_ne hnonneg (Ne.symm (Polynomial.leadingCoeff_ne_zero.mpr hPne))
  have hcoeff : P.leadingCoeff = P.coeff c := by
    rw [Polynomial.leadingCoeff, Polynomial.natDegree, hdeg]
    rfl
  rw [← hcoeff]
  exact mul_pos (by positivity) hlead

end Stacks.SerreIntersection
