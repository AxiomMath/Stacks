module

public import StacksFrontier.RingTheory.MvPowerSeries.KrullDimension
public import StacksFrontier.RingTheory.RegularLocalRing.Criteria
public import StacksFrontier.RingTheory.SerreIntersection.ComplementaryDimension
public import StacksFrontier.RingTheory.SerreIntersection.PowerSeriesDiagonal

/-!
# Serre's intersection theorems over a power series ring

For nonzero finite modules `M` and `N` over `K[[x_1, …, x_n]]` with `M ⊗ N` of finite length, the
Tor Euler characteristic `χ(M, N)` is computed on `K[[y, x]]` as the intersection multiplicity of
the diagonal against the complete tensor product `(K[[y, x]] ⊗ M) ⊗ N`.

## Main results

* `exists_isRegular_span_eq_ker_diag`: over a regular local ring, the kernel of the diagonal is
  generated by a regular sequence of length `n`.
* `supportDim_pair`: the dimension of the support of the complete tensor product is the sum of
  the dimensions of the supports of `M` and `N`.
* `serre_mvPowerSeries`: Serre's dimension inequality, vanishing and positivity theorems over a
  power series ring over a field.
-/

@[expose] public noncomputable section

open MvPowerSeries IsLocalRing
open scoped TensorProduct

universe u

namespace Stacks.SerreIntersection.PowerSeriesDiagonal

section General

variable (K : Type u) [CommRing K] [IsLocalRing K] [IsNoetherianRing K] (n : ℕ)

variable {K n}

omit [IsLocalRing K] [IsNoetherianRing K] in
/-- For finite `K[[x]]`-modules `M` and `N`, the complete tensor product
`(K[[y, x]] ⊗ M) ⊗ N` is a finite `K[[y, x]]`-module. -/
theorem finite_pair (M N : Type u) [AddCommGroup M] [Module (MvPowerSeries (Fin n) K) M]
    [Module.Finite (MvPowerSeries (Fin n) K) M] [AddCommGroup N]
    [Module (MvPowerSeries (Fin n) K) N] [Module.Finite (MvPowerSeries (Fin n) K) N] :
    Module.Finite (MvPowerSeries (Fin n ⊕ Fin n) K) (Pair (left K n) (right K n) M N) := by
  obtain ⟨k, p, hp⟩ := Module.Finite.exists_fin' (MvPowerSeries (Fin n) K) N
  have : Module.Finite (MvPowerSeries (Fin n ⊕ Fin n) K) (Ext (left K n) M) :=
    finite_ext (left K n) M
  have : Module.Finite (MvPowerSeries (Fin n ⊕ Fin n) K) (Twist (right K n) (Ext (left K n) M)) :=
    Module.Finite.equiv (Twist.of _ _)
  have : Module.Finite (MvPowerSeries (Fin n ⊕ Fin n) K)
      (Pair (left K n) (right K n) M (Fin k → MvPowerSeries (Fin n) K)) :=
    Module.Finite.equiv (piScalarRightOver (B := MvPowerSeries (Fin n ⊕ Fin n) K) _ (Fin k)).symm
  exact Module.Finite.of_surjective (pairMap (left K n) (right K n) LinearMap.id p)
    (pairMap_right_surjective _ _ hp)

/-- For nonzero finite `K[[x]]`-modules `M` and `N`, the tensor product of the complete tensor
product `(K[[y, x]] ⊗ M) ⊗ N` with the diagonal is nonzero. -/
private theorem nontrivial_pair_tensor_diag {K : Type u} [CommRing K] [IsLocalRing K] {n : ℕ}
    (M N : Type u) [AddCommGroup M]
    [Module (MvPowerSeries (Fin n) K) M] [Module.Finite (MvPowerSeries (Fin n) K) M] [Nontrivial M]
    [AddCommGroup N] [Module (MvPowerSeries (Fin n) K) N]
    [Module.Finite (MvPowerSeries (Fin n) K) N] [Nontrivial N] :
    Nontrivial (Pair (left K n) (right K n) M N ⊗[MvPowerSeries (Fin n ⊕ Fin n) K]
      Diag (diag K n)) := by
  have : Nontrivial (M ⊗[MvPowerSeries (Fin n) K] N) :=
    Stacks.Intersection.nontrivial_tensorProduct_of_isLocalRing _ M N
  exact (diagEquiv (left K n) (right K n) (diag K n) (diag_left K n) (diag_right K n) M
    N).toEquiv.nontrivial

omit [IsNoetherianRing K] in
/-- For nonzero finite `K[[x]]`-modules `M` and `N`, the complete tensor product
`(K[[y, x]] ⊗ M) ⊗ N` is nonzero. -/
theorem nontrivial_pair (M N : Type u) [AddCommGroup M] [Module (MvPowerSeries (Fin n) K) M]
    [Module.Finite (MvPowerSeries (Fin n) K) M] [Nontrivial M] [AddCommGroup N]
    [Module (MvPowerSeries (Fin n) K) N] [Module.Finite (MvPowerSeries (Fin n) K) N]
    [Nontrivial N] : Nontrivial (Pair (left K n) (right K n) M N) := by
  have := nontrivial_pair_tensor_diag (K := K) (n := n) M N
  by_contra hC
  rw [not_nontrivial_iff_subsingleton] at hC
  exact not_subsingleton _ (inferInstance : Subsingleton
    (Pair (left K n) (right K n) M N ⊗[MvPowerSeries (Fin n ⊕ Fin n) K] Diag (diag K n)))

variable (K n) in
/-- The ring isomorphism `K[[y, x]] ≅ K[[z_1, …, z_{2n}]]`. -/
def sumEquiv : MvPowerSeries (Fin n ⊕ Fin n) K ≃+* MvPowerSeries (Fin (n + n)) K :=
  (renameEquiv K finSumFinEquiv).toRingEquiv

variable (K n) in
omit [IsLocalRing K] [IsNoetherianRing K] in
/-- Over a regular local ring `K`, the power series ring `K[[y, x]]` is a regular local ring. -/
theorem isRegularLocalRing_sum [IsRegularLocalRing K] :
    IsRegularLocalRing (MvPowerSeries (Fin n ⊕ Fin n) K) :=
  have := MvPowerSeries.isRegularLocalRing K (n + n)
  IsRegularLocalRing.of_ringEquiv (sumEquiv K n).symm

variable (K n) in
/-- The Krull dimension of `K[[y, x]]` is `dim K + 2n`. -/
theorem ringKrullDim_sum :
    ringKrullDim (MvPowerSeries (Fin n ⊕ Fin n) K) =
      ringKrullDim K + ((n + n : ℕ) : WithBot ℕ∞) := by
  rw [ringKrullDim_eq_of_ringEquiv (sumEquiv K n), MvPowerSeries.ringKrullDim_fin_eq_add]

variable (K n) in
omit [IsLocalRing K] [IsNoetherianRing K] in
/-- **The diagonal is cut out by a regular sequence of length `n`**, over a regular local ring `K`
of dimension `e`. -/
theorem exists_isRegular_span_eq_ker_diag [IsRegularLocalRing K] (e : ℕ)
    (he : ringKrullDim K = e) :
    ∃ f : Fin n → MvPowerSeries (Fin n ⊕ Fin n) K,
      RingTheory.Sequence.IsRegular (MvPowerSeries (Fin n ⊕ Fin n) K) (List.ofFn f) ∧
        RingHom.ker (diag K n) = Ideal.span (Set.range f) := by
  have := isRegularLocalRing_sum K n
  have := MvPowerSeries.isRegularLocalRing K n
  refine exists_isRegular_span_eq_ker (diag K n) (fun r => ⟨left K n r, diag_left K n r⟩) n
    (e + n) ?_ ?_
  · rw [MvPowerSeries.ringKrullDim_fin_eq_add, he]
    push_cast
    rfl
  · rw [ringKrullDim_sum, he]
    push_cast
    rw [add_assoc]

open _root_.Stacks.CategoryTheory in
/-- The quotient of the complete tensor product by the ideal of the diagonal has dimension zero
when `M ⊗ N` is supported in the closed point. -/
theorem supportDim_quotient_ker_diag (M N : Type u) [AddCommGroup M]
    [Module (MvPowerSeries (Fin n) K) M] [Module.Finite (MvPowerSeries (Fin n) K) M]
    [Nontrivial M] [AddCommGroup N] [Module (MvPowerSeries (Fin n) K) N]
    [Module.Finite (MvPowerSeries (Fin n) K) N] [Nontrivial N]
    (hMN : Module.support (MvPowerSeries (Fin n) K) (M ⊗[MvPowerSeries (Fin n) K] N) ⊆
      {closedPoint (MvPowerSeries (Fin n) K)}) :
    Module.supportDim (MvPowerSeries (Fin n ⊕ Fin n) K)
      (Pair (left K n) (right K n) M N ⧸
        (RingHom.ker (diag K n)) • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K)
          (Pair (left K n) (right K n) M N))) = 0 := by
  have := finite_pair (K := K) (n := n) M N
  set C := Pair (left K n) (right K n) M N
  set I := RingHom.ker (diag K n)
  have hann : I ≤ Module.annihilator (MvPowerSeries (Fin n ⊕ Fin n) K)
      (C ⊗[MvPowerSeries (Fin n ⊕ Fin n) K] Diag (diag K n)) := by
    intro b hb
    rw [Module.mem_annihilator]
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul c q =>
      rw [← TensorProduct.tmul_smul,
        Module.mem_annihilator.mp (ker_le_annihilator_diag (diag K n) hb) q,
        TensorProduct.tmul_zero]
    | add x y hx hy => rw [smul_add, hx, hy, add_zero]
  let e : (C ⧸ I • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C)) ≃ₗ[MvPowerSeries
      (Fin n ⊕ Fin n) K] (C ⊗[MvPowerSeries (Fin n ⊕ Fin n) K] Diag (diag K n)) :=
    (TensorProduct.quotTensorEquivQuotSMul C I).symm.trans (TensorProduct.comm _ _ _)
  have hlen : Module.length (MvPowerSeries (Fin n ⊕ Fin n) K)
      (C ⧸ I • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C)) =
      Module.length (MvPowerSeries (Fin n) K) (M ⊗[MvPowerSeries (Fin n) K] N) := by
    rw [e.length_eq, ← length_twist_of_le_annihilator (right K n) (diag K n) (diag_right K n) _
      hann]
    exact (diagEquiv (left K n) (right K n) (diag K n) (diag_left K n) (diag_right K n) M
      N).length_eq
  have hfin : Module.length (MvPowerSeries (Fin n) K) (M ⊗[MvPowerSeries (Fin n) K] N) ≠ ⊤ := by
    have h := Stacks.Intersection.length_tor_ne_top_of_support_subset M N hMN 0
    have e0 := (((CategoryTheory.MonoidalCategory.tensoringLeft
      (ModuleCat.{u} (MvPowerSeries (Fin n) K))).obj (ModuleCat.of _ M)).leftDerivedZeroIsoSelf.app
        (ModuleCat.of _ N)).toLinearEquiv
    exact e0.length_eq ▸ h
  have hnt : Nontrivial (C ⧸ I • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C)) := by
    have := nontrivial_pair_tensor_diag (K := K) (n := n) M N
    exact e.toEquiv.nontrivial
  have hle : Module.supportDim (MvPowerSeries (Fin n ⊕ Fin n) K)
      (C ⧸ I • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C)) ≤ 0 :=
    ((Ideal.idealOfDefinition_support_length_tfae I hnt).out 5 4).mp
      (by rw [hlen]; exact lt_top_iff_ne_top.mpr hfin)
  have hne' := (Module.supportDim_ne_bot_iff_nontrivial (MvPowerSeries (Fin n ⊕ Fin n) K)
    (C ⧸ I • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C))).mpr hnt
  refine le_antisymm hle ?_
  cases h : Module.supportDim (MvPowerSeries (Fin n ⊕ Fin n) K)
      (C ⧸ I • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C)) with
  | bot => exact absurd h hne'
  | coe x => exact WithBot.coe_le_coe.mpr (zero_le (a := x))

end General

section Field

variable (K : Type u) [Field K] (n : ℕ)

/-- Over a field `K`, the maximal ideal of `K[[y, x]]` is generated by the variables. -/
theorem maximalIdeal_eq_span_range_X_sum :
    maximalIdeal (MvPowerSeries (Fin n ⊕ Fin n) K) =
      Ideal.span (Set.range (X : Fin n ⊕ Fin n → MvPowerSeries (Fin n ⊕ Fin n) K)) := by
  classical
  rw [← IsLocalRing.ker_eq_maximalIdeal (constantCoeff : MvPowerSeries (Fin n ⊕ Fin n) K →+* K)
    fun c => ⟨C c, by simp⟩]
  apply le_antisymm
  · intro g hg
    have hs : (Set.range (X : Fin n ⊕ Fin n → MvPowerSeries (Fin n ⊕ Fin n) K)) =
        (fun a => (X a : MvPowerSeries (Fin n ⊕ Fin n) K)) ''
          ((Finset.univ : Finset (Fin n ⊕ Fin n)) : Set (Fin n ⊕ Fin n)) := by simp
    rw [hs]
    refine Stacks.MvPowerSeries.RegularParameters.QuotInitVars.mem_span_X_image_of_coeff_eq_zero
      _ _ fun e he => ?_
    have he0 : e = 0 := Finsupp.ext fun i => he i (Finset.mem_univ i)
    rw [he0, coeff_zero_eq_constantCoeff_apply]
    exact hg
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    simp

/-- Over a field `K`, the maximal ideal of `K[[y, x]]` is the sum of the extensions of the
maximal ideal of `K[[x]]` along `left K n` and `right K n`. -/
theorem maximalIdeal_eq_sup :
    maximalIdeal (MvPowerSeries (Fin n ⊕ Fin n) K) =
      Ideal.map (left K n) (maximalIdeal (MvPowerSeries (Fin n) K)) ⊔
        Ideal.map (right K n) (maximalIdeal (MvPowerSeries (Fin n) K)) := by
  rw [maximalIdeal_eq_span_range_X_sum, MvPowerSeries.maximalIdeal_eq_span_range_X,
    Ideal.map_span, Ideal.map_span, ← Ideal.span_union]
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_union, Set.mem_image]
  constructor
  · rintro ⟨i | i, rfl⟩
    · right; exact ⟨X i, ⟨i, rfl⟩, by simp [right, rename_X]⟩
    · left; exact ⟨X i, ⟨i, rfl⟩, by simp [left, rename_X]⟩
  · rintro (⟨_, ⟨i, rfl⟩, rfl⟩ | ⟨_, ⟨i, rfl⟩, rfl⟩)
    · exact ⟨Sum.inr i, by simp [left, rename_X]⟩
    · exact ⟨Sum.inl i, by simp [right, rename_X]⟩

variable {K n}

open Polynomial Filter in
/-- **The dimension of a complete tensor product is the sum of the dimensions**: for nonzero
finite `K[[x]]`-modules `M` and `N`,
`dim Supp_{K[[y, x]]} ((K[[y, x]] ⊗ M) ⊗ N) = dim Supp M + dim Supp N`. The Hilbert function of
the complete tensor product for `(y, x)` is squeezed between the products of the Hilbert
functions of `M` and `N` at `t` and at `2 t`, because `(y, x)^{2t} ⊆ (y^t, x^t) ⊆ (y, x)^t` and the
complete tensor product of `M/(x)^t M` and `N/(x)^t N` has the product of their lengths. -/
theorem supportDim_pair (M N : Type u) [AddCommGroup M] [Module (MvPowerSeries (Fin n) K) M]
    [Module.Finite (MvPowerSeries (Fin n) K) M] [Nontrivial M] [AddCommGroup N]
    [Module (MvPowerSeries (Fin n) K) N] [Module.Finite (MvPowerSeries (Fin n) K) N]
    [Nontrivial N] :
    Module.supportDim (MvPowerSeries (Fin n ⊕ Fin n) K) (Pair (left K n) (right K n) M N) =
      Module.supportDim (MvPowerSeries (Fin n) K) M +
        Module.supportDim (MvPowerSeries (Fin n) K) N := by
  have := finite_pair (K := K) (n := n) M N
  have := nontrivial_pair (K := K) (n := n) M N
  set mR := maximalIdeal (MvPowerSeries (Fin n) K)
  set mB := maximalIdeal (MvPowerSeries (Fin n ⊕ Fin n) K)
  set C := Pair (left K n) (right K n) M N
  have hsup : mB = Ideal.map (left K n) mR ⊔ Ideal.map (right K n) mR := maximalIdeal_eq_sup K n
  have h0M := supportDim_quotient_maximalIdeal_smul (R := MvPowerSeries (Fin n) K) M
  have h0N := supportDim_quotient_maximalIdeal_smul (R := MvPowerSeries (Fin n) K) N
  have h0C := supportDim_quotient_maximalIdeal_smul (R := MvPowerSeries (Fin n ⊕ Fin n) K) C
  obtain ⟨PM, hPM⟩ := Ideal.exists_computesGeneralizedHilbertPoly mR h0M
  obtain ⟨PN, hPN⟩ := Ideal.exists_computesGeneralizedHilbertPoly mR h0N
  obtain ⟨PC, hPC⟩ := Ideal.exists_computesGeneralizedHilbertPoly mB h0C
  have hdM := Ideal.degree_eq_supportDim_of_computesGeneralizedHilbertPoly mR h0M hPM
  have hdN := Ideal.degree_eq_supportDim_of_computesGeneralizedHilbertPoly mR h0N hPN
  have hdC := Ideal.degree_eq_supportDim_of_computesGeneralizedHilbertPoly mB h0C hPC
  have hne0 : ∀ (P : ℚ[X]) (A X : Type u) [CommRing A] [AddCommGroup X] [Module A X]
      [Nontrivial X], P.degree.map (Nat.cast : ℕ → ℕ∞) = Module.supportDim A X → P ≠ 0 := by
    intro P A X _ _ _ _ h hP
    rw [hP, Polynomial.degree_zero] at h
    exact (Module.supportDim_ne_bot_iff_nontrivial A X).mpr inferInstance (h.symm.trans rfl)
  have hPM0 := hne0 PM _ M hdM
  have hPN0 := hne0 PN _ N hdN
  have hPC0 := hne0 PC _ C hdC
  have hlM := leadingCoeff_pos_of_eventually_natCast hPM0 (hPM.mono fun _ ⟨p, _, hp⟩ => ⟨p, hp⟩)
  have hlN := leadingCoeff_pos_of_eventually_natCast hPN0 (hPN.mono fun _ ⟨p, _, hp⟩ => ⟨p, hp⟩)
  have hlC := leadingCoeff_pos_of_eventually_natCast hPC0 (hPC.mono fun _ ⟨p, _, hp⟩ => ⟨p, hp⟩)
  have hlMN : 0 < (PM * PN).leadingCoeff := by
    rw [Polynomial.leadingCoeff_mul]; exact mul_pos hlM hlN
  -- the two ideals of `B` generated by the powers of the two maximal ideals
  have hmap_le : ∀ t : ℕ, Ideal.map (left K n) (mR ^ t) ⊔ Ideal.map (right K n) (mR ^ t) ≤ mB ^ t :=
    fun t => by
      rw [Ideal.map_pow, Ideal.map_pow]
      exact sup_le (Ideal.pow_right_mono (by rw [hsup]; exact le_sup_left) t)
        (Ideal.pow_right_mono (by rw [hsup]; exact le_sup_right) t)
  have hle_map : ∀ t : ℕ, mB ^ (t + t) ≤
      Ideal.map (left K n) (mR ^ t) ⊔ Ideal.map (right K n) (mR ^ t) := fun t => by
    rw [Ideal.map_pow, Ideal.map_pow, hsup]
    exact Ideal.sup_pow_add_le_pow_sup_pow
  -- the length of the reduction modulo `(y^t, x^t)`
  have hpair : ∀ t : ℕ, Module.length (MvPowerSeries (Fin n) K)
      (N ⧸ mR ^ t • (⊤ : Submodule (MvPowerSeries (Fin n) K) N)) ≠ ⊤ →
      Module.length (MvPowerSeries (Fin n ⊕ Fin n) K)
        (C ⧸ LinearMap.ker (pairQuot (left K n) (right K n) (mR ^ t) M N)) =
        Module.length (MvPowerSeries (Fin n) K)
            (M ⧸ mR ^ t • (⊤ : Submodule (MvPowerSeries (Fin n) K) M)) *
          Module.length (MvPowerSeries (Fin n) K)
            (N ⧸ mR ^ t • (⊤ : Submodule (MvPowerSeries (Fin n) K) N)) := by
    intro t ht
    rw [((pairQuot (left K n) (right K n) (mR ^ t) M N).quotKerEquivOfSurjective
      (pairQuot_surjective _ _ _ M N)).length_eq]
    exact length_pair_eq_mul (left K n) (right K n) (killFirst K n) (killFirst_left K n)
      (ker_killFirst K n) _ _ (Module.length_ne_top_iff.mp ht)
  have h1 : ∀ᶠ t : ℕ in atTop, PC.eval (t : ℚ) ≤ (PM * PN).eval (t : ℚ) := by
    filter_upwards [hPM, hPN, hPC] with t ⟨pM, hlenM, hvM⟩ ⟨pN, hlenN, hvN⟩ ⟨pC, hlenC, hvC⟩
    rw [Polynomial.eval_mul, hvM, hvN, hvC]
    have hker : LinearMap.ker (pairQuot (left K n) (right K n) (mR ^ t) M N) ≤ mB ^ t • ⊤ :=
      (ker_pairQuot_le _ _ _ M N).trans (Submodule.smul_mono_left (hmap_le t))
    have key := Module.length_le_of_surjective (Submodule.factor hker)
      (Submodule.factor_surjective hker)
    rw [hpair t (by rw [hlenN]; exact ENat.natCast_ne_top pN), hlenC, hlenM, hlenN] at key
    exact_mod_cast key
  have hPC2 : ∀ᶠ t : ℕ in atTop, ∃ p : ℕ, Module.length (MvPowerSeries (Fin n ⊕ Fin n) K)
      (C ⧸ mB ^ (t + t) • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C)) = p ∧
        PC.eval ((t + t : ℕ) : ℚ) = p := by
    obtain ⟨T, hT⟩ := Filter.eventually_atTop.mp hPC
    exact Filter.eventually_atTop.mpr ⟨T, fun t ht => hT (t + t) (by omega)⟩
  have h2 : ∀ᶠ t : ℕ in atTop,
      (PM * PN).eval (t : ℚ) ≤ (PC.comp (Polynomial.C 2 * Polynomial.X)).eval (t : ℚ) := by
    filter_upwards [hPM, hPN, hPC2] with t ⟨pM, hlenM, hvM⟩ ⟨pN, hlenN, hvN⟩ ⟨pC, hlenC, hvC⟩
    rw [Polynomial.eval_mul, Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X, show (2 : ℚ) * t = ((t + t : ℕ) : ℚ) by push_cast; ring, hvM, hvN, hvC]
    have hle : mB ^ (t + t) • (⊤ : Submodule (MvPowerSeries (Fin n ⊕ Fin n) K) C) ≤
        LinearMap.ker (pairQuot (left K n) (right K n) (mR ^ t) M N) :=
      (Submodule.smul_mono_left (hle_map t)).trans (le_ker_pairQuot _ _ _ M N)
    have key := Module.length_le_of_surjective (Submodule.factor hle)
      (Submodule.factor_surjective hle)
    rw [hpair t (by rw [hlenN]; exact ENat.natCast_ne_top pN), hlenC, hlenM, hlenN] at key
    exact_mod_cast key
  have hd1 := natDegree_le_of_eventually_le hlC h1
  have hd2 := natDegree_le_of_eventually_le hlMN h2
  rw [Polynomial.natDegree_comp, Polynomial.natDegree_C_mul_X 2 two_ne_zero, mul_one] at hd2
  rw [Polynomial.natDegree_mul hPM0 hPN0] at hd1 hd2
  have hdeg : PC.natDegree = PM.natDegree + PN.natDegree := le_antisymm hd1 hd2
  rw [← hdM, ← hdN, ← hdC, Polynomial.degree_eq_natDegree hPM0,
    Polynomial.degree_eq_natDegree hPN0, Polynomial.degree_eq_natDegree hPC0, hdeg]
  rw [Nat.cast_withBot, Nat.cast_withBot, Nat.cast_withBot, WithBot.map_coe, WithBot.map_coe,
    WithBot.map_coe]
  push_cast
  rfl

/-- **Serre's theorems over a power series ring over a field.** Let `M`, `N` be nonzero finite
modules over `R = K[[x_1, …, x_n]]` with `M ⊗_R N` supported in the closed point, and let
`r = dim Supp M`, `s = dim Supp N`. Then `r + s ≤ dim R`; if `r + s < dim R` then `χ(M, N) = 0`;
and if `r + s = dim R` then `χ(M, N) > 0`. By the reduction to the diagonal `χ(M, N)` is the
multiplicity over `K[[y, x]]` of the diagonal, cut out by a regular sequence of length `n`,
against the complete tensor product `M ⊗̂_K N`, whose dimension is `r + s`. -/
theorem serre_mvPowerSeries (M N : Type u) [AddCommGroup M] [Module (MvPowerSeries (Fin n) K) M]
    [Module.Finite (MvPowerSeries (Fin n) K) M] [Nontrivial M] [AddCommGroup N]
    [Module (MvPowerSeries (Fin n) K) N] [Module.Finite (MvPowerSeries (Fin n) K) N]
    [Nontrivial N]
    (hMN : Module.support (MvPowerSeries (Fin n) K) (M ⊗[MvPowerSeries (Fin n) K] N) ⊆
      {closedPoint (MvPowerSeries (Fin n) K)}) :
    Module.supportDim (MvPowerSeries (Fin n) K) M + Module.supportDim (MvPowerSeries (Fin n) K) N ≤
        ringKrullDim (MvPowerSeries (Fin n) K) ∧
      (Module.supportDim (MvPowerSeries (Fin n) K) M +
          Module.supportDim (MvPowerSeries (Fin n) K) N < ringKrullDim (MvPowerSeries (Fin n) K) →
        Stacks.Intersection.torEulerCharacteristic (MvPowerSeries (Fin n) K) M N = 0) ∧
      (Module.supportDim (MvPowerSeries (Fin n) K) M +
          Module.supportDim (MvPowerSeries (Fin n) K) N = ringKrullDim (MvPowerSeries (Fin n) K) →
        0 < Stacks.Intersection.torEulerCharacteristic (MvPowerSeries (Fin n) K) M N) := by
  have := finite_pair (K := K) (n := n) M N
  obtain ⟨f, hf, hI⟩ := exists_isRegular_span_eq_ker_diag K n 0 (ringKrullDim_eq_zero_of_field K)
  have hdimC := supportDim_pair (K := K) (n := n) M N
  have h0 := supportDim_quotient_ker_diag (K := K) (n := n) M N hMN
  rw [torEulerCharacteristic_eq_localIntersectionMultiplicity K n M N,
    MvPowerSeries.ringKrullDim_eq, ← hdimC]
  refine ⟨supportDim_le_of_supportDim_quotient_eq_zero f _ hI _ h0, fun hlt => ?_, fun heq => ?_⟩
  · exact localIntersectionMultiplicity_eq_zero_of_supportDim_lt f hf _ hI _ h0 hlt
  · exact localIntersectionMultiplicity_pos_of_supportDim_eq f hf _ hI _ h0 heq

end Field

