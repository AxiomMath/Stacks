module

public import Mathlib.RingTheory.MvPowerSeries.Rename
public import Mathlib.RingTheory.Flat.Basic
public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.Algebra.MittagLeffler.MvPowerSeries
public import StacksFrontier.RingTheory.MvPowerSeries.CotangentSpace

/-!
# Power series in two complementary sets of variables

For power series `g` in the variables `σ ⊕ τ`, the coefficients of `g` along a fixed exponent of
the variables of `τ` form a power series in the variables of `σ`. This identifies `K[[σ ⊕ τ]]` with
`K[[σ]][[τ]]`.

## Main definitions

* `Stacks.SerreIntersection.splitCoeff`: the power series in `σ` given by the coefficients of a
  power series in `σ ⊕ τ` along a fixed exponent of the variables of `τ`.
* `Stacks.SerreIntersection.splitCoeffEquiv`: the bijection `K[[σ ⊕ τ]] ≃ K[[σ]][[τ]]`.

## Main results

* `Stacks.SerreIntersection.flat_rename_inl`: `K[[σ ⊕ Fin m]]` is flat over `K[[σ]]` when `K[[σ]]`
  is Noetherian.
* `Stacks.SerreIntersection.ker_killCompl_inr`: for `σ` finite, the kernel of setting the variables
  of `σ` to zero in `K[[σ ⊕ τ]]` is the ideal generated by those variables.
-/

@[expose] public noncomputable section

open MvPowerSeries

namespace Stacks.SerreIntersection

universe u

variable {K : Type u} [CommRing K] {σ τ : Type*}

/-- Splitting off the coefficients of a power series in `σ ⊕ τ` along the exponents of the
variables of `τ`: the coefficient of `y^b` is a power series in the variables of `σ`. -/
def splitCoeff (g : MvPowerSeries (σ ⊕ τ) K) (b : τ →₀ ℕ) : MvPowerSeries σ K :=
  fun a => coeff (Finsupp.sumElim a b) g

/-- The coefficient of `x^a` in `splitCoeff g b` is the coefficient of `x^a y^b` in `g`. -/
theorem coeff_splitCoeff (g : MvPowerSeries (σ ⊕ τ) K) (b : τ →₀ ℕ) (a : σ →₀ ℕ) :
    coeff a (splitCoeff g b) = coeff (Finsupp.sumElim a b) g := rfl

/-- Extending an exponent `a` on `σ` by zero along `Sum.inl` gives the exponent on `σ ⊕ τ` that is
`a` on `σ` and zero on `τ`. -/
theorem embDomain_inl_eq_sumElim (a : σ →₀ ℕ) :
    Finsupp.embDomain (Function.Embedding.inl) a = Finsupp.sumElim a (0 : τ →₀ ℕ) := by
  ext (x | y)
  · simp
  · rw [Finsupp.embDomain_notin_range]
    · simp
    · simp

/-- For `r` a power series in the variables of `σ`, viewed in `K[[σ ⊕ τ]]`, splitting the
coefficients of `r * g` along `b` gives `r` times the splitting of `g` along `b`. -/
theorem splitCoeff_rename_inl_mul (r : MvPowerSeries σ K) (g : MvPowerSeries (σ ⊕ τ) K)
    (b : τ →₀ ℕ) :
    splitCoeff (rename (R := K) (Function.Embedding.inl : σ ↪ σ ⊕ τ) r * g) b =
      r * splitCoeff g b := by
  classical
  ext a
  rw [coeff_splitCoeff, coeff_mul, coeff_mul]
  let i : (σ →₀ ℕ) × (σ →₀ ℕ) → ((σ ⊕ τ) →₀ ℕ) × ((σ ⊕ τ) →₀ ℕ) :=
    fun p => (Finsupp.sumElim p.1 0, Finsupp.sumElim p.2 b)
  have hi : Set.InjOn i (Finset.antidiagonal a : Set _) := by
    intro p _ q _ h
    simp only [i, Prod.mk.injEq, Finsupp.ext_iff, Sum.forall] at h
    exact Prod.ext (Finsupp.ext h.1.1) (Finsupp.ext h.2.1)
  have himage : (Finset.antidiagonal a).image i ⊆ Finset.antidiagonal (Finsupp.sumElim a b) := by
    intro q hq
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hq
    rw [Finset.mem_antidiagonal] at hp ⊢
    ext (x | y)
    · simp [i, ← hp]
    · simp [i]
  rw [← Finset.sum_subset himage, Finset.sum_image hi]
  · refine Finset.sum_congr rfl fun p _ => ?_
    simp only [i]
    rw [← embDomain_inl_eq_sumElim, coeff_embDomain_rename]
    rfl
  · intro q hq hqi
    rw [coeff_rename_eq_zero, zero_mul]
    rintro ⟨c, hc⟩
    apply hqi
    rw [Finset.mem_antidiagonal] at hq
    refine Finset.mem_image.mpr ⟨(c, Finsupp.comapDomain Sum.inl q.2 Sum.inl_injective.injOn),
      ?_, ?_⟩
    · rw [Finset.mem_antidiagonal]
      ext x
      have := congrArg (fun f => f (Sum.inl x)) hq
      simp only [Finsupp.add_apply, Finsupp.sumElim_inl] at this
      rw [← this, ← hc]
      simp [Finsupp.mapDomain_apply_of_injective Sum.inl_injective]
    · have hq1 : q.1 = Finsupp.sumElim c 0 := by
        rw [← hc, ← embDomain_inl_eq_sumElim, Finsupp.embDomain_eq_mapDomain]
      refine Prod.ext hq1.symm ?_
      ext (x | y)
      · simp [i]
      · have := congrArg (fun f => f (Sum.inr y)) hq
        simp only [Finsupp.add_apply, Finsupp.sumElim_inr, hq1] at this
        simpa [i] using this.symm

/-- The splitting of coefficients is a bijection onto power series in the variables of `τ` with
coefficients power series in the variables of `σ`. -/
def splitCoeffEquiv : MvPowerSeries (σ ⊕ τ) K ≃ MvPowerSeries τ (MvPowerSeries σ K) where
  toFun g := fun b => splitCoeff g b
  invFun h := fun e => coeff (Finsupp.sumFinsuppEquivProdFinsupp e).1
    (coeff (Finsupp.sumFinsuppEquivProdFinsupp e).2 h)
  left_inv g := by
    ext e
    change coeff (Finsupp.sumElim _ _) g = coeff e g
    have he : Finsupp.sumElim (Finsupp.sumFinsuppEquivProdFinsupp e).1
        (Finsupp.sumFinsuppEquivProdFinsupp e).2 = e :=
      Finsupp.ext fun x => by cases x <;> rfl
    rw [he]
  right_inv h := by
    ext b a
    change coeff (Finsupp.sumFinsuppEquivProdFinsupp (Finsupp.sumElim a b)).1
      (coeff (Finsupp.sumFinsuppEquivProdFinsupp (Finsupp.sumElim a b)).2 h) = _
    have hab : Finsupp.sumFinsuppEquivProdFinsupp (Finsupp.sumElim a b) = (a, b) :=
      Prod.ext (Finsupp.ext fun _ => rfl) (Finsupp.ext fun _ => rfl)
    rw [hab]

/-- **Power series in `σ ⊕ Fin m` are flat over power series in `σ`**, through the inclusion of
the variables of `σ`, when `K[[σ]]` is Noetherian: splitting off the exponents of the variables
of `Fin m` identifies the module with `K[[σ]][[Fin m]]`, which is flat over `K[[σ]]` by
Stacks 059T. -/
theorem flat_rename_inl [IsNoetherianRing (MvPowerSeries σ K)] (m : ℕ) :
    (rename (R := K) (Function.Embedding.inl : σ ↪ σ ⊕ Fin m)).toRingHom.Flat := by
  let := (rename (R := K) (Function.Embedding.inl : σ ↪ σ ⊕ Fin m)).toRingHom.toAlgebra
  let e : MvPowerSeries (σ ⊕ Fin m) K ≃ₗ[MvPowerSeries σ K]
      MvPowerSeries (Fin m) (MvPowerSeries σ K) :=
    { splitCoeffEquiv with
      map_add' := fun g g' => by ext b a; rfl
      map_smul' := fun r g => by
        ext b a
        show coeff a (splitCoeff (rename (R := K) (Function.Embedding.inl : σ ↪ σ ⊕ Fin m) r
          * g) b) = coeff a (r * splitCoeff g b)
        rw [splitCoeff_rename_inl_mul] }
  have := (Module.flat_and_mittagLeffler_mvPowerSeries (MvPowerSeries σ K) m).1
  exact Module.Flat.of_linearEquiv e

/-- **The kernel of killing the variables of `σ`** in `K[[σ ⊕ τ]]` is the ideal they generate,
for `σ` finite. -/
theorem ker_killCompl_inr [Finite σ] :
    RingHom.ker (killCompl (R := K) (Function.Embedding.inr : τ ↪ σ ⊕ τ)) =
      Ideal.span (Set.range fun i : σ => (X (Sum.inl i) : MvPowerSeries (σ ⊕ τ) K)) := by
  classical
  have := Fintype.ofFinite σ
  have hset : (Set.range fun i : σ => (X (Sum.inl i) : MvPowerSeries (σ ⊕ τ) K)) =
      (fun a => (X a : MvPowerSeries (σ ⊕ τ) K)) ''
        ((Finset.univ.image (Sum.inl : σ → σ ⊕ τ) : Finset (σ ⊕ τ)) : Set (σ ⊕ τ)) := by
    simp [Set.range_comp']
  apply le_antisymm
  · intro g hg
    rw [RingHom.mem_ker] at hg
    rw [hset]
    refine Stacks.MvPowerSeries.RegularParameters.QuotInitVars.mem_span_X_image_of_coeff_eq_zero
      _ _ fun e he => ?_
    have he' : Finsupp.embDomain (Function.Embedding.inr : τ ↪ σ ⊕ τ)
        (Finsupp.comapDomain Sum.inr e Sum.inr_injective.injOn) = e := by
      ext (x | y)
      · rw [Finsupp.embDomain_notin_range _ _ _ (by simp)]
        exact (he _ (Finset.mem_image.mpr ⟨x, Finset.mem_univ _, rfl⟩)).symm
      · exact Finsupp.embDomain_apply_self (Function.Embedding.inr : τ ↪ σ ⊕ τ) _ y
    rw [← he', ← coeff_killCompl, hg, map_zero]
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact killCompl_X_eq_zero (by simp)

end Stacks.SerreIntersection
