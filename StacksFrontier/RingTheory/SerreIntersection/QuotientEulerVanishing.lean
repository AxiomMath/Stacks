module

public import StacksFrontier.AlgebraicGeometry.Intersection.TorFormula.TorSheafVanishing
public import StacksFrontier.RingTheory.Length.IndexAdditivity
public import StacksFrontier.RingTheory.SerreIntersection.QuotientChangeOfRings

/-!
# Vanishing of the Euler characteristic over a ring for modules over a quotient

Let `S → T` be a surjection of regular local rings whose kernel is generated by a nonzerodivisor
`f`, and let `M`, `N` be finite `T`-modules with `M ⊗_T N` of finite length. Then
`χ^S(M, N) = ∑ᵢ (-1)ⁱ length_S Torᵢ^S(M, N) = 0`.

This is the change-of-rings spectral sequence `Tor_p^T(Tor_q^S(N, T), M) ⇒ Tor_{p+q}^S(N, M)`
with its two rows `Tor_q^S(N, T) = N` for `q = 0, 1`, made explicit: along a finite free cover
`0 → K → S^j → N → 0` the `Tor^S(N, M)` are the `Tor^T(T ⊗ K, M)` shifted by one
(`StacksFrontier.RingTheory.SerreIntersection.QuotientChangeOfRings`), and the reduction
`T ⊗ K → T ⊗ S^j` has kernel and cokernel both isomorphic to `N`; the alternating sum of the
long exact sequences of `Tor^T(-, M)` then cancels.

## Main results

* `Stacks.SerreIntersection.sum_alternating_length_tor'_shortExact` — the alternating sum of the
  lengths along the long exact sequence of `Tor_•(-, Q)` of a short exact sequence.
* `Stacks.SerreIntersection.torEulerCharacteristic_eq_zero_of_quotient` — `χ^S(M, N) = 0`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory IsLocalRing
open scoped TensorProduct Pointwise

universe u

namespace Stacks.SerreIntersection

section Arithmetic

/-- The telescoping identity behind the alternating sum along a long exact sequence. -/
theorem sum_alternating_telescope (a b c d u v : ℕ → ℤ) (D : ℕ)
    (ha : ∀ i, 1 ≤ i → a i = d i + u i) (hb : ∀ i, 1 ≤ i → b i = u i + v i)
    (hc : ∀ i, 1 ≤ i → c i = v i + d (i - 1)) :
    ∑ i ∈ Finset.Icc 1 D, (-1 : ℤ) ^ i * (a i - b i + c i) = (-1) ^ D * d D - d 0 := by
  induction D with
  | zero => simp
  | succ D ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih, ha _ (by omega), hb _ (by omega),
      hc _ (by omega), Nat.add_sub_cancel, pow_succ]
    ring

end Arithmetic

section Bookkeeping

/-- Splitting off the first two terms of `∑_{i<d+2} (-1)^i x_i` and reindexing the rest. -/
theorem sum_range_alternating_shift (x : ℕ → ℤ) (d : ℕ) :
    ∑ i ∈ Finset.range (d + 2), (-1 : ℤ) ^ i * x i =
      x 0 - x 1 - ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * x (i + 1) := by
  induction d with
  | zero => simp [Finset.sum_range_succ]; ring
  | succ d ih =>
    rw [Finset.sum_range_succ, ih, Finset.sum_Icc_succ_top (by omega), pow_succ]
    ring

/-- Shifting the index of `∑_{i=1}^{d} (-1)^i y_{i+1}` down by one. -/
theorem sum_Icc_alternating_succ (y : ℕ → ℤ) (d : ℕ) :
    ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * y (i + 1) =
      -(∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * y i) - y 1 + (-1) ^ d * y (d + 1) := by
  induction d with
  | zero => simp
  | succ d ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih, Finset.sum_Icc_succ_top (by omega), pow_succ]
    ring

/-- If the terms `tS i` are related to `tT`, `b`, `w`, `c` by the given shifts and
`tT (d + 1) = 0`, then `∑_{i<d+2} (-1)^i tS i = 0`. -/
theorem alternating_sum_eq_zero_of_shifts (tS tT b w : ℕ → ℤ) (c : ℤ) (d : ℕ)
    (h1 : ∀ i, tS (i + 2) = b (i + 1)) (h2 : tS 1 = c + tT 1) (h3 : tS 0 = tT 0)
    (h5 : ∀ i, tT (i + 2) = w (i + 1))
    (h6 : ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * (tT i - b i + w i) = c - tT 0)
    (h7 : tT (d + 1) = 0) :
    ∑ i ∈ Finset.range (d + 2), (-1 : ℤ) ^ i * tS i = 0 := by
  rw [sum_range_alternating_shift]
  have shift : ∀ x y : ℕ → ℤ, (∀ i, x (i + 2) = y (i + 1)) →
      ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * x (i + 1) =
        ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * y i := by
    intro x y hxy
    refine Finset.sum_congr rfl fun i hi => ?_
    obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by have := (Finset.mem_Icc.mp hi).1; omega⟩
    rw [hxy k]
  have h6' : ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * tT i - ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * b i
      + ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * w i = c - tT 0 := by
    rw [← h6, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => by ring
  rw [shift _ _ h1, h2, h3]
  rw [← shift _ _ h5, sum_Icc_alternating_succ, h7, mul_zero, add_zero] at h6'
  linarith

end Bookkeeping

section LES

variable {R : Type u} [CommRing R] {SC : ShortComplex (ModuleCat.{u} R)} (hS : SC.ShortExact)
  (Q : ModuleCat.{u} R)

/-- The length of a finite-length module is the length of the kernel plus that of the range of
any linear map out of it, in `ℤ`. -/
theorem intLength_eq_ker_add_range {X Y : Type u} [AddCommGroup X] [Module R X]
    [AddCommGroup Y] [Module R Y] (g : X →ₗ[R] Y) (hX : Module.length R X ≠ ⊤) :
    ((Module.length R X).toNat : ℤ) = ((Module.length R (LinearMap.ker g)).toNat : ℤ) +
      ((Module.length R (LinearMap.range g)).toNat : ℤ) := by
  rw [Module.lengthToNat_eq_ker_add_range g (Module.length_ne_top_iff.mp hX)]
  push_cast
  rfl

include hS in
/-- **The alternating sum along the long exact sequence of `Tor_•(-, Q)`.** For a short exact
sequence `0 → X₁ → X₂ → X₃ → 0` such that `Tor_i(X₁, Q)` and `Tor_i(X₃, Q)` have finite length for
`i ≥ 1`, `X₁ ⊗ Q` has finite length and `Tor_{D+1}(X₃, Q) = 0`,
`∑_{i=1}^{D} (-1)^i (ℓ Tor_i(X₁, Q) - ℓ Tor_i(X₂, Q) + ℓ Tor_i(X₃, Q))` is the length of the image
of `X₁ ⊗ Q → X₂ ⊗ Q` minus the length of `X₁ ⊗ Q` (read on `Tor_0`). -/
theorem sum_alternating_length_tor'_shortExact (D : ℕ)
    (hA : ∀ i, Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₁).obj Q) ≠ ⊤)
    (hC : ∀ i, 1 ≤ i → Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₃).obj Q) ≠ ⊤)
    (hD : IsZero (((Tor' (ModuleCat.{u} R) (D + 1)).obj SC.X₃).obj Q)) :
    ∑ i ∈ Finset.Icc 1 D, (-1 : ℤ) ^ i *
        (((Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₁).obj Q)).toNat : ℤ) -
          ((Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₂).obj Q)).toNat : ℤ) +
          ((Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₃).obj Q)).toNat : ℤ)) =
      ((Module.length R (LinearMap.range
          (((Tor' (ModuleCat.{u} R) 0).map SC.f).app Q).hom)).toNat : ℤ) -
        ((Module.length R (((Tor' (ModuleCat.{u} R) 0).obj SC.X₁).obj Q)).toNat : ℤ) := by
  -- the maps of the long exact sequence
  let uu : ℕ → ℤ := fun i => ((Module.length R (LinearMap.range
    (((Tor' (ModuleCat.{u} R) i).map SC.f).app Q).hom)).toNat : ℤ)
  let vv : ℕ → ℤ := fun i => ((Module.length R (LinearMap.range
    (((Tor' (ModuleCat.{u} R) i).map SC.g).app Q).hom)).toNat : ℤ)
  let dd : ℕ → ℤ := fun i => ((Module.length R (LinearMap.range
    (Stacks.Tor.Tor'δFirst hS Q i).hom)).toNat : ℤ)
  -- exactness at the three spots
  have exA : ∀ i, LinearMap.range (Stacks.Tor.Tor'δFirst hS Q i).hom =
      LinearMap.ker (((Tor' (ModuleCat.{u} R) i).map SC.f).app Q).hom := fun i =>
    ((Stacks.Tor.Tor'_composableArrows_exact_first hS Q i).exact' 2 3 4).moduleCat_range_eq_ker
  have exB : ∀ i, LinearMap.range (((Tor' (ModuleCat.{u} R) i).map SC.f).app Q).hom =
      LinearMap.ker (((Tor' (ModuleCat.{u} R) i).map SC.g).app Q).hom := fun i =>
    ((Stacks.Tor.Tor'_composableArrows_exact_first hS Q i).exact' 3 4 5).moduleCat_range_eq_ker
  have exC : ∀ i, LinearMap.range (((Tor' (ModuleCat.{u} R) (i + 1)).map SC.g).app Q).hom =
      LinearMap.ker (Stacks.Tor.Tor'δFirst hS Q i).hom := fun i =>
    ((Stacks.Tor.Tor'_composableArrows_exact_first hS Q i).exact' 1 2 3).moduleCat_range_eq_ker
  -- lengths along the sequence
  have hBfin : ∀ i, 1 ≤ i →
      Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₂).obj Q) ≠ ⊤ := by
    intro i hi
    have hex : Function.Exact (((Tor' (ModuleCat.{u} R) i).map SC.f).app Q).hom
        (((Tor' (ModuleCat.{u} R) i).map SC.g).app Q).hom := by
      rw [LinearMap.exact_iff]
      exact (exB i).symm
    exact Module.length_ne_top_iff.mpr (Module.finiteLength_middle_of_exact _ _ hex
      (Module.length_ne_top_iff.mp (hA i)) (Module.length_ne_top_iff.mp (hC i hi)))
  have ha : ∀ i, ((Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₁).obj Q)).toNat : ℤ) =
      dd i + uu i := fun i => by
    rw [intLength_eq_ker_add_range (((Tor' (ModuleCat.{u} R) i).map SC.f).app Q).hom (hA i),
      ← exA i]
  have hb : ∀ i, 1 ≤ i →
      ((Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₂).obj Q)).toNat : ℤ) =
        uu i + vv i := fun i hi => by
    rw [intLength_eq_ker_add_range (((Tor' (ModuleCat.{u} R) i).map SC.g).app Q).hom (hBfin i hi),
      ← exB i]
  have hc : ∀ i, 1 ≤ i →
      ((Module.length R (((Tor' (ModuleCat.{u} R) i).obj SC.X₃).obj Q)).toNat : ℤ) =
        vv i + dd (i - 1) := fun i hi => by
    obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
    rw [intLength_eq_ker_add_range (Stacks.Tor.Tor'δFirst hS Q k).hom (hC _ hi), ← exC k,
      Nat.add_sub_cancel, add_comm]
  have hdD : dd D = 0 := by
    have : Subsingleton (LinearMap.range (Stacks.Tor.Tor'δFirst hS Q D).hom) := by
      have := ModuleCat.subsingleton_of_isZero hD
      refine ⟨fun a b => Subtype.ext ?_⟩
      obtain ⟨x, hx⟩ := a.2
      obtain ⟨y, hy⟩ := b.2
      rw [← hx, ← hy, Subsingleton.elim x y]
    simp [dd, Module.length_eq_zero]
  rw [sum_alternating_telescope _ _ _ dd uu vv D (fun i _ => ha i) hb hc, hdD, mul_zero, zero_sub,
    ha 0]
  ring

end LES

section Cover

variable {S T : Type u} [CommRing S] [CommRing T] [Algebra S T]
  (hT : Function.Surjective (algebraMap S T)) {f : S}
  (hf : RingHom.ker (algebraMap S T) = Ideal.span {f})

include hT in
/-- Every element of `T ⊗_S X` is `1 ⊗ x`, `S → T` being surjective. -/
theorem exists_one_tmul_eq (X : Type u) [AddCommGroup X] [Module S X] (z : T ⊗[S] X) :
    ∃ x : X, (1 : T) ⊗ₜ[S] x = z := by
  induction z using TensorProduct.inductionOn with
  | tmul t x =>
    obtain ⟨s, rfl⟩ := hT t
    exact ⟨s • x, by rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]⟩
  | add a b ha hb =>
    obtain ⟨x, rfl⟩ := ha
    obtain ⟨y, rfl⟩ := hb
    exact ⟨x + y, TensorProduct.tmul_add _ _ _⟩

include hT hf in
/-- `1 ⊗ x` vanishes in `T ⊗_S X` exactly when `x ∈ f X`. -/
theorem one_tmul_eq_zero_iff (X : Type u) [AddCommGroup X] [Module S X] (x : X) :
    (1 : T) ⊗ₜ[S] x = 0 ↔ x ∈ f • (⊤ : Submodule S X) := by
  rw [← (baseChangeEquivQuotSMulTop hT hf X).map_eq_zero_iff, baseChangeEquivQuotSMulTop_one_tmul,
    Submodule.Quotient.mk_eq_zero]

include hf in
/-- The generator `f` of the kernel of `S → T` acts by zero on every `T`-module. -/
theorem smul_eq_zero_of_isScalarTower (N : Type u) [AddCommGroup N] [Module T N] [Module S N]
    [IsScalarTower S T N] (n : N) : f • n = 0 := by
  have hf0 : algebraMap S T f = 0 := by
    rw [← RingHom.mem_ker, hf]
    exact Ideal.mem_span_singleton_self f
  rw [← algebraMap_smul T f n, hf0, zero_smul]

variable {N : Type u} [AddCommGroup N] [Module T N] [Module S N] [IsScalarTower S T N] {j : ℕ}
  (p : (Fin j → S) →ₗ[S] N) (hp : Function.Surjective p)

include hT in
/-- The kernel of `T ⊗_S S^j → N` is the image of `T ⊗_S K → T ⊗_S S^j`, for `K` the kernel of
`p`. -/
theorem ker_liftBaseChange_eq_range :
    LinearMap.ker (LinearMap.liftBaseChange T p) =
      LinearMap.range (LinearMap.baseChange T (LinearMap.ker p).subtype) := by
  ext z
  obtain ⟨v, rfl⟩ := exists_one_tmul_eq hT _ z
  rw [LinearMap.mem_ker, LinearMap.liftBaseChange_tmul, one_smul]
  constructor
  · intro hv
    exact ⟨(1 : T) ⊗ₜ ⟨v, hv⟩, rfl⟩
  · rintro ⟨w, hw⟩
    obtain ⟨k, rfl⟩ := exists_one_tmul_eq hT _ w
    rw [LinearMap.baseChange_tmul] at hw
    have := congrArg (LinearMap.liftBaseChange T p) hw
    rw [LinearMap.liftBaseChange_tmul, LinearMap.liftBaseChange_tmul, one_smul, one_smul] at this
    rw [← this]
    exact k.2

include hp in
/-- The map `T ⊗_S S^j → N` induced by a surjection `p : S^j → N` is surjective. -/
theorem liftBaseChange_surjective : Function.Surjective (LinearMap.liftBaseChange T p) := by
  intro n
  obtain ⟨v, rfl⟩ := hp n
  exact ⟨(1 : T) ⊗ₜ v, by rw [LinearMap.liftBaseChange_tmul, one_smul]⟩

include hf in
/-- `f • v` lies in the kernel of `p : S^j → N` for every `v`. -/
theorem smul_mem_ker (v : Fin j → S) : f • v ∈ LinearMap.ker p := by
  rw [LinearMap.mem_ker, map_smul, smul_eq_zero_of_isScalarTower hf]

/-- `v ↦ 1 ⊗ f v`, from `S^j` to `T ⊗_S K` for `K` the kernel of the cover. -/
def coverKerMap : (Fin j → S) →ₗ[S] T ⊗[S] (LinearMap.ker p) :=
  (TensorProduct.mk S T (LinearMap.ker p) 1) ∘ₗ
    (LinearMap.codRestrict (LinearMap.ker p) (f • LinearMap.id) (smul_mem_ker hf p))

/-- `coverKerMap hf p v = 1 ⊗ f v`. -/
theorem coverKerMap_apply (v : Fin j → S) :
    coverKerMap hf p v = (1 : T) ⊗ₜ[S] (⟨f • v, smul_mem_ker hf p v⟩ : LinearMap.ker p) := rfl

include hT in
/-- For `f` a nonzerodivisor on `S`, the kernel of `coverKerMap hf p` is the kernel of `p`. -/
theorem ker_coverKerMap (hfS : IsSMulRegular S f) :
    LinearMap.ker (coverKerMap hf p) = LinearMap.ker p := by
  ext v
  rw [LinearMap.mem_ker, coverKerMap_apply, one_tmul_eq_zero_iff hT hf,
    Submodule.mem_smul_pointwise_iff_exists]
  constructor
  · rintro ⟨k, -, hk⟩
    have : f • (k : Fin j → S) = f • v := congrArg Subtype.val hk
    have hkv : (k : Fin j → S) = v := isSMulRegular_pi hfS j this
    rw [← hkv]
    exact k.2
  · intro hv
    exact ⟨⟨v, hv⟩, Submodule.mem_top, rfl⟩

include hT in
/-- The range of `coverKerMap hf p` is the kernel of `T ⊗_S K → T ⊗_S S^j`, for `K` the kernel
of `p`. -/
theorem range_coverKerMap :
    LinearMap.range (coverKerMap hf p) = (LinearMap.ker
      (LinearMap.baseChange T (LinearMap.ker p).subtype)).restrictScalars S := by
  ext z
  rw [Submodule.restrictScalars_mem, LinearMap.mem_ker]
  constructor
  · rintro ⟨v, rfl⟩
    rw [coverKerMap_apply, LinearMap.baseChange_tmul, one_tmul_eq_zero_iff hT hf]
    exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top
  · intro hz
    obtain ⟨k, rfl⟩ := exists_one_tmul_eq hT _ z
    rw [LinearMap.baseChange_tmul, one_tmul_eq_zero_iff hT hf,
      Submodule.mem_smul_pointwise_iff_exists] at hz
    obtain ⟨v, -, hv⟩ := hz
    exact ⟨v, by rw [coverKerMap_apply]; congr 1; exact Subtype.ext hv⟩

include hT hp in
/-- **The kernel of the reduction of a cover.** For a `T`-module `N` with finite free cover
`p : S^j → N` and kernel `K`, the kernel of `T ⊗ K → T ⊗ S^j` is `N` again
(it is `f S^j / f K ≅ S^j / K`). -/
def kerBaseChangeEquiv (hfS : IsSMulRegular S f) :
    N ≃ₗ[T] LinearMap.ker (LinearMap.baseChange T (LinearMap.ker p).subtype) :=
  LinearEquiv.extendScalarsOfSurjective hT
    ((p.quotKerEquivOfSurjective hp).symm.trans
      ((Submodule.quotEquivOfEq _ _ (ker_coverKerMap hT hf p hfS).symm).trans
        ((coverKerMap hf p).quotKerEquivRange.trans
          ((LinearEquiv.ofEq _ _ (range_coverKerMap hT hf p)).trans
            ((Submodule.restrictScalarsEquiv S T _ _).restrictScalars S)))))

end Cover

section Vanishing

variable {S T : Type u} [CommRing S] [CommRing T] [Algebra S T]
  [IsRegularLocalRing S] [IsRegularLocalRing T]
  (hT : Function.Surjective (algebraMap S T)) {f : S}
  (hf : RingHom.ker (algebraMap S T) = Ideal.span {f}) (hfS : IsSMulRegular S f)

/-- The length of the kernel of a composite with a surjection. -/
theorem length_ker_comp_of_surjective {R X Y W : Type u} [CommRing R] [AddCommGroup X] [Module R X]
    [AddCommGroup Y] [Module R Y] [AddCommGroup W] [Module R W] (h : X →ₗ[R] Y) (g : Y →ₗ[R] W)
    (hh : Function.Surjective h) :
    Module.length R (LinearMap.ker (g ∘ₗ h)) =
      Module.length R (LinearMap.ker h) + Module.length R (LinearMap.ker g) := by
  let i : LinearMap.ker h →ₗ[R] LinearMap.ker (g ∘ₗ h) :=
    LinearMap.codRestrict _ (LinearMap.ker h).subtype (fun x => by
      change g (h x) = 0
      rw [LinearMap.mem_ker.mp x.2, map_zero])
  let q : LinearMap.ker (g ∘ₗ h) →ₗ[R] LinearMap.ker g :=
    LinearMap.codRestrict _ (h ∘ₗ (LinearMap.ker (g ∘ₗ h)).subtype) (fun x => x.2)
  refine Module.length_eq_add_of_exact i q (fun a b hab => Subtype.ext (congrArg
    (fun z : LinearMap.ker (g ∘ₗ h) => (z : X)) hab)) (fun y => ?_) ?_
  · obtain ⟨x, hx⟩ := hh y
    exact ⟨⟨x, by rw [LinearMap.mem_ker, LinearMap.comp_apply, hx]; exact y.2⟩, Subtype.ext hx⟩
  · rw [LinearMap.exact_iff]
    ext x
    simp only [LinearMap.mem_ker, LinearMap.mem_range]
    constructor
    · intro hx
      exact ⟨⟨x, congrArg Subtype.val hx⟩, rfl⟩
    · rintro ⟨y, rfl⟩
      exact Subtype.ext y.2

/-- The length of the range of a map of modules is unchanged by composing with isomorphisms. -/
theorem length_range_conj {R : Type u} [CommRing R] {X X' Y Y' : ModuleCat.{u} R} (g : X ⟶ Y)
    (g' : X' ⟶ Y') (eX : X ≅ X') (eY : Y ≅ Y') (h : g ≫ eY.hom = eX.hom ≫ g') :
    Module.length R (LinearMap.range g.hom) = Module.length R (LinearMap.range g'.hom) := by
  have h1 : LinearMap.range (eY.hom.hom ∘ₗ g.hom) = LinearMap.range g'.hom := by
    have : eY.hom.hom ∘ₗ g.hom = g'.hom ∘ₗ eX.hom.hom := congrArg ModuleCat.Hom.hom h
    rw [this, LinearMap.range_comp_of_range_eq_top]
    exact LinearMap.range_eq_top.mpr eX.toLinearEquiv.surjective
  rw [← h1, LinearMap.range_comp]
  exact (Submodule.equivMapOfInjective _ eY.toLinearEquiv.injective _).length_eq

/-- The short complex `A → B → C` of `T`-modules attached to an exact pair of linear maps. -/
private def shortComplexOfExact {T : Type u} [CommRing T] {A B C : Type u} [AddCommGroup A]
    [Module T A] [AddCommGroup B] [Module T B] [AddCommGroup C] [Module T C] {f : A →ₗ[T] B}
    {g : B →ₗ[T] C} (h : Function.Exact f g) : ShortComplex (ModuleCat.{u} T) :=
  ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g)
    (ModuleCat.hom_ext (LinearMap.ext fun z => h.apply_apply_eq_zero z))

/-- The short complex of an exact pair, injective on the left and surjective on the right, is
short exact. -/
private theorem shortExact_shortComplexOfExact {T : Type u} [CommRing T] {A B C : Type u}
    [AddCommGroup A] [Module T A] [AddCommGroup B] [Module T B] [AddCommGroup C] [Module T C]
    {f : A →ₗ[T] B} {g : B →ₗ[T] C} (h : Function.Exact f g) (hf : Function.Injective f)
    (hg : Function.Surjective g) : (shortComplexOfExact h).ShortExact :=
  ModuleCat.shortComplex_shortExact _ h hf hg

include hT hf hfS in
/-- **Serre's change-of-rings vanishing.** Let `S → T` be a surjection of regular local rings
whose kernel is generated by the nonzerodivisor `f`, and let `M`, `N` be finite `T`-modules with
`M ⊗_T N` supported in the closed point. Then `χ^S(M, N) = 0`. -/
theorem torEulerCharacteristic_eq_zero_of_quotient (M N : Type u) [AddCommGroup M] [Module T M]
    [Module S M] [IsScalarTower S T M] [Module.Finite T M] [AddCommGroup N] [Module T N]
    [Module S N] [IsScalarTower S T N] [Module.Finite T N]
    (hMN : Module.support T (M ⊗[T] N) ⊆ {closedPoint T}) :
    Stacks.Intersection.torEulerCharacteristic S M N = 0 := by
  have : Module.Finite S T := Module.Finite.of_surjective (Algebra.linearMap S T) hT
  have : Module.Finite S N := Module.Finite.trans T N
  obtain ⟨d, hd⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim S
  have hdT : ringKrullDim T ≤ (d : WithBot ℕ∞) :=
    hd ▸ ringKrullDim_le_of_surjective (algebraMap S T) hT
  obtain ⟨j, p, hp⟩ := Module.Finite.exists_fin' S N
  have hK : IsSMulRegular (LinearMap.ker p) f := fun a b hab =>
    Subtype.ext (isSMulRegular_pi hfS j (congrArg Subtype.val hab))
  let ι := LinearMap.baseChange T (LinearMap.ker p).subtype
  let Q := ModuleCat.of T M
  -- the two short exact sequences over `T`
  have hex1 : Function.Exact (LinearMap.ker ι).subtype ι.rangeRestrict :=
    LinearMap.exact_iff.mpr (by rw [LinearMap.ker_rangeRestrict, Submodule.range_subtype])
  let E1 := shortComplexOfExact hex1
  have hE1 : E1.ShortExact := shortExact_shortComplexOfExact hex1
    (Submodule.injective_subtype _) (LinearMap.surjective_rangeRestrict _)
  have hex2 : Function.Exact (LinearMap.range ι).subtype (LinearMap.liftBaseChange T p) :=
    LinearMap.exact_iff.mpr (by rw [Submodule.range_subtype, ker_liftBaseChange_eq_range hT p])
  let E2 := shortComplexOfExact hex2
  have hE2 : E2.ShortExact := shortExact_shortComplexOfExact hex2
    (Submodule.injective_subtype _) (liftBaseChange_surjective p hp)
  have : Projective E2.X₂ := projective_baseChange_pi j
  have hS := coverSC_shortExact p hp
  have : Projective (coverSC p).X₂ :=
    (ModuleCat.of S (Fin j → S)).projective_of_categoryTheory_projective
  -- lengths
  have hTw : ∀ (X : Type u) [AddCommGroup X] [Module T X],
      Module.length S (Twist (algebraMap S T) X) = Module.length T X := fun X _ _ =>
    Twist.length_eq _ X (fun b => by
      obtain ⟨r, rfl⟩ := hT b
      exact ⟨r, fun _ => rfl⟩)
  let tS : ℕ → ℤ := fun i => ((Module.length S
    (((Tor' (ModuleCat.{u} S) i).obj (ModuleCat.of S N)).obj (ModuleCat.of S M))).toNat : ℤ)
  let tT : ℕ → ℤ := fun i => ((Module.length T
    (((Tor' (ModuleCat.{u} T) i).obj (ModuleCat.of T N)).obj Q)).toNat : ℤ)
  let b : ℕ → ℤ := fun i =>
    ((Module.length T (((Tor' (ModuleCat.{u} T) i).obj E1.X₂).obj Q)).toNat : ℤ)
  let w : ℕ → ℤ := fun i =>
    ((Module.length T (((Tor' (ModuleCat.{u} T) i).obj E1.X₃).obj Q)).toNat : ℤ)
  let c : ℤ := ((Module.length T (LinearMap.range
    (LinearMap.rTensor M (LinearMap.ker ι).subtype))).toNat : ℤ)
  have hfinT : ∀ i,
      Module.length T (((Tor' (ModuleCat.{u} T) i).obj (ModuleCat.of T N)).obj Q) ≠ ⊤ :=
    fun i => (((torFlip_iso_Tor' T i).app (ModuleCat.of T N)).app Q).toLinearEquiv.length_eq ▸
      Stacks.Intersection.length_tor_ne_top_of_support_subset M N hMN i
  have hvanT : ∀ i, d < i → IsZero (((Tor' (ModuleCat.{u} T) i).obj (ModuleCat.of T N)).obj Q) :=
    fun i hi => (AlgebraicGeometry.TorFormula.isZero_Tor_of_isRegularLocalRing Q
      (ModuleCat.of T N) d i hdT hi).of_iso
        (((torFlip_iso_Tor' T i).app (ModuleCat.of T N)).app Q).symm
  -- (1) the higher `Tor^S(N, M)` are `Tor^T(T ⊗ K, M)` shifted by one
  have h1 : ∀ i, tS (i + 2) = b (i + 1) := fun i => by
    let eS := (tor'δFirstIso hS (ModuleCat.of S M) (i + 1)
      (isZero_Tor'_succ_of_projective _ _ _ (i + 1))
      (isZero_Tor'_succ_of_projective _ _ _ i)).toLinearEquiv
    obtain ⟨e⟩ := nonempty_tor'_quotient_equiv M hT hf hfS i (LinearMap.ker p) hK
    exact congrArg (fun x : ℕ∞ => ((ENat.toNat x : ℕ) : ℤ))
      ((eS.trans e).length_eq.trans (hTw _))
  -- (2) in degree one, the kernel of `(T ⊗ K) ⊗ M → (T ⊗ S^j) ⊗ M`
  have hzero1 : IsZero (((Tor' (ModuleCat.{u} S) 1).obj (coverSC p).X₂).obj (ModuleCat.of S M)) :=
    isZero_Tor'_succ_of_projective _ _ _ 0
  have h2a : Module.length S (((Tor' (ModuleCat.{u} S) 1).obj (ModuleCat.of S N)).obj
      (ModuleCat.of S M)) = Module.length T (LinearMap.ker (LinearMap.rTensor M ι)) := by
    exact ((tor'OneIsoKernel hS (ModuleCat.of S M) hzero1 ≪≫
      ModuleCat.kernelIsoKer _).toLinearEquiv.trans
      (kerRTensorBaseChangeEquiv (T := T) M (LinearMap.ker p))).length_eq.trans (hTw _)
  have hcomp : LinearMap.rTensor M ι = LinearMap.rTensor M (LinearMap.range ι).subtype ∘ₗ
      LinearMap.rTensor M ι.rangeRestrict := by
    rw [← LinearMap.rTensor_comp, LinearMap.subtype_comp_codRestrict]
  have hzero2 : IsZero (((Tor' (ModuleCat.{u} T) 1).obj E2.X₂).obj Q) :=
    isZero_Tor'_succ_of_projective _ _ _ 0
  have hT1 : Module.length T (((Tor' (ModuleCat.{u} T) 1).obj (ModuleCat.of T N)).obj Q) =
      Module.length T (LinearMap.ker (LinearMap.rTensor M (LinearMap.range ι).subtype)) :=
    (tor'OneIsoKernel hE2 Q hzero2 ≪≫ ModuleCat.kernelIsoKer _).toLinearEquiv.length_eq
  have hker1 : LinearMap.ker (LinearMap.rTensor M ι.rangeRestrict) =
      LinearMap.range (LinearMap.rTensor M (LinearMap.ker ι).subtype) :=
    (LinearMap.exact_iff.mp (rTensor_exact M hex1 (LinearMap.surjective_rangeRestrict _)))
  -- `N` is the kernel of `T ⊗ K → T ⊗ S^j`, and `N ⊗_T M` has finite length
  let eZ := kerBaseChangeEquiv hT hf p hp hfS
  let z0N := (((tensoringRight (ModuleCat.{u} T)).obj Q).leftDerivedZeroIsoSelf.app
    (ModuleCat.of T N)).toLinearEquiv
  have hNM : Module.length T (N ⊗[T] M) ≠ ⊤ := z0N.length_eq ▸ hfinT 0
  have hcfin : Module.length T (LinearMap.range
      (LinearMap.rTensor M (LinearMap.ker ι).subtype)) ≠ ⊤ := by
    refine ne_top_of_le_ne_top ?_ (Module.length_le_of_surjective _
      (LinearMap.surjective_rangeRestrict (LinearMap.rTensor M (LinearMap.ker ι).subtype)))
    rw [← (LinearEquiv.rTensor M eZ).length_eq]
    exact hNM
  have h2 : tS 1 = c + tT 1 := by
    have hsplit := length_ker_comp_of_surjective (LinearMap.rTensor M ι.rangeRestrict)
      (LinearMap.rTensor M (LinearMap.range ι).subtype)
      (LinearMap.rTensor_surjective M (LinearMap.surjective_rangeRestrict _))
    rw [← hcomp, hker1, ← hT1, ← h2a] at hsplit
    change ((Module.length S _).toNat : ℤ) = ((Module.length T _).toNat : ℤ) +
      ((Module.length T _).toNat : ℤ)
    rw [hsplit, ENat.toNat_add hcfin (hfinT 1)]
    push_cast
    rfl
  -- (3) in degree zero
  have h3 : tS 0 = tT 0 := by
    let z0S := (((tensoringRight (ModuleCat.{u} S)).obj
      (ModuleCat.of S M)).leftDerivedZeroIsoSelf.app
      (ModuleCat.of S N)).toLinearEquiv
    let eN : T ⊗[S] N ≃ₗ[T] N := LinearEquiv.ofBijective (LinearMap.liftBaseChange T LinearMap.id)
      ⟨by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨n, rfl⟩ := exists_one_tmul_eq hT N z
        rw [LinearMap.liftBaseChange_tmul, one_smul, LinearMap.id_apply] at hz
        rw [hz, TensorProduct.tmul_zero],
       fun n => ⟨(1 : T) ⊗ₜ n, by rw [LinearMap.liftBaseChange_tmul, one_smul, LinearMap.id_apply]⟩⟩
    exact congrArg (fun x : ℕ∞ => ((ENat.toNat x : ℕ) : ℤ))
      (((z0S.trans ((baseChangeTensorEquiv (T := T) M N).symm.trans
        (Twist.congr (eN.rTensor M)))).length_eq.trans (hTw _)).trans z0N.length_eq.symm)
  -- (4) the shift along the cover of `N` over `T`
  have h5iso : ∀ i, (((Tor' (ModuleCat.{u} T) (i + 2)).obj (ModuleCat.of T N)).obj Q) ≅
      (((Tor' (ModuleCat.{u} T) (i + 1)).obj E1.X₃).obj Q) := fun i =>
    tor'δFirstIso hE2 Q (i + 1) (isZero_Tor'_succ_of_projective _ _ _ (i + 1))
      (isZero_Tor'_succ_of_projective _ _ _ i)
  have h5 : ∀ i, tT (i + 2) = w (i + 1) := fun i => by
    change ((Module.length T _).toNat : ℤ) = ((Module.length T _).toNat : ℤ)
    rw [(h5iso i).toLinearEquiv.length_eq]
  -- (5) the long exact sequence of `0 → N → T ⊗ K → N' → 0`
  have hZ : ∀ i, Module.length T (((Tor' (ModuleCat.{u} T) i).obj E1.X₁).obj Q) =
      Module.length T (((Tor' (ModuleCat.{u} T) i).obj (ModuleCat.of T N)).obj Q) := fun i =>
    (((Tor' (ModuleCat.{u} T) i).mapIso eZ.toModuleIso).app Q).toLinearEquiv.length_eq.symm
  have hles := sum_alternating_length_tor'_shortExact hE1 Q d (fun i => hZ i ▸ hfinT i)
    (fun i hi => by
      obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
      rw [← (h5iso k).toLinearEquiv.length_eq]
      exact hfinT _)
    ((hvanT (d + 2) (by omega)).of_iso (h5iso d).symm)
  have hc : ((Module.length T (LinearMap.range
      (((Tor' (ModuleCat.{u} T) 0).map E1.f).app Q).hom)).toNat : ℤ) = c := by
    let F := (tensoringRight (ModuleCat.{u} T)).obj Q
    have := length_range_conj (((Tor' (ModuleCat.{u} T) 0).map E1.f).app Q) (F.map E1.f)
      (F.leftDerivedZeroIsoSelf.app E1.X₁) (F.leftDerivedZeroIsoSelf.app E1.X₂)
      (F.leftDerivedZeroIsoSelf.hom.naturality E1.f)
    rw [this]
    rfl
  have h6 : ∑ i ∈ Finset.Icc 1 d, (-1 : ℤ) ^ i * (tT i - b i + w i) = c - tT 0 := by
    simp only [hZ] at hles
    rw [← hc]
    exact hles
  have h7 : tT (d + 1) = 0 := by
    change ((Module.length T _).toNat : ℤ) = 0
    rw [Module.length_eq_zero_iff.mpr (ModuleCat.subsingleton_of_isZero (hvanT _ (by omega)))]
    rfl
  -- assembly
  have key := alternating_sum_eq_zero_of_shifts tS tT b w c d h1 h2 h3 h5 h6 h7
  rw [Stacks.Intersection.torEulerCharacteristic_eq_sum_range M N (d + 1)
    (hd.trans_le (by exact_mod_cast Nat.le_succ d))]
  have hflip : ∀ i, ((Module.length S (((Tor (ModuleCat.{u} S) i).obj (ModuleCat.of S M)).obj
      (ModuleCat.of S N))).toNat : ℚ) = (tS i : ℚ) := fun i => by
    change _ = ((((Module.length S _).toNat : ℕ) : ℤ) : ℚ)
    rw [Int.cast_natCast]
    exact congrArg (fun x : ℕ∞ => ((ENat.toNat x : ℕ) : ℚ))
      (((torFlip_iso_Tor' S i).app (ModuleCat.of S N)).app
        (ModuleCat.of S M)).toLinearEquiv.length_eq
  simp_rw [hflip]
  exact_mod_cast key

end Vanishing

end Stacks.SerreIntersection
