module

public import StacksFrontier.RingTheory.DifferentialOperator.PrincipalParts

/-!
# The sequence of principal parts of the presented module `P¹_{S/R}(M)`

Let `R → S` be a ring map and let `M` be an `S`-module. The proof of Lemma 09CK constructs the
module of principal parts of order `1` of `M` (Definition 09CL) by generators and relations: it is
the quotient of the free `S`-module `F = ⨁_{m ∈ M} S[m]` by the submodule generated by the elements
`[m + m'] - [m] - [m']`, `f[m] - [fm]` and `g₀g₁[m] - g₀[g₁m] - g₁[g₀m] + [g₁g₀m]` for `m, m' ∈ M`,
`f ∈ R` and `g₀, g₁ ∈ S`, with universal differential operator `m ↦ [m]`. This file builds that
module, `PrincipalPartsOne R S M`, with its operator `PrincipalPartsOne.universalOperator`, and
proves Lemma 09CN for it: the sequence of principal parts
`0 → Ω[S⁄R] ⊗[S] M → P¹_{S/R}(M) → M → 0`
is exact, and it is functorial in `M`.

## Main definitions

* `PrincipalPartsOne R S M`: the source's presentation of `P¹_{S/R}(M)`, the quotient of
  `M →₀ S` (the free `S`-module on the symbols `[m]`) by `PrincipalPartsOne.relations R S M`.
* `PrincipalPartsOne.universalOperator`: the operator `m ↦ [m]`.
* `PrincipalPartsOne.map`: the `S`-linear map `P¹_{S/R}(M) → P¹_{S/R}(M')` induced by an
  `S`-linear `f : M → M'`, sending `[m]` to `[f m]`.
* `PrincipalPartsOne.symbol`, `PrincipalPartsOne.proj`: the two maps of the sequence, with
  `symbol (d b ⊗ₜ m) = [b m] - b [m]` and `proj [m] = m`.

## Main results

* `PrincipalPartsOne.isUniversalDifferentialOperatorOfOrderLE_universalOperator`: the pair
  `(P¹_{S/R}(M), m ↦ [m])` is a module of principal parts of order `1` of `M`.
* `PrincipalPartsOne.shortExact_symbol_proj`: Lemma 09CN for this module.

## Implementation notes

The free module `⨁_{m ∈ M} S[m]` is `M →₀ S`, with `[m] = Finsupp.single m 1`. The relation
`f[m] - [fm]` has `f ∈ R` acting on `M →₀ S` by restriction of scalars along `R → S`, and the
product `g₁g₀m` of the source is `g₁ • g₀ • m`.

Exactness of the sequence is
`LinearMap.IsDifferentialOperatorOfOrderLE.exists_shortExact_principalParts`, which proves it for
any universal operator of order at most `1`; what is done here is to construct the source's
module, to check that `m ↦ [m]` is universal — the converse half of the proof of Lemma 09CK, that
an `S`-linear map `F → N` annihilating the listed elements is `m ↦ D m` for an operator `D` of
order at most `1`, and the direct half — and to prove functoriality in `M`, which the source
derives from the construction of the first map.

## References

* [Stacks 09CN](https://stacks.math.columbia.edu/tag/09CN), Lemma 10.133.6, and the construction
  in the proof of [Stacks 09CK](https://stacks.math.columbia.edu/tag/09CK), in the section
  "Finite order differential operators" (Tag 09CH).
-/

@[expose] public section

open TensorProduct

universe u v w w' w''

variable (R : Type u) (S : Type v) (M : Type w) [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]

/-- The submodule of the free `S`-module `M →₀ S` on symbols `[m] = Finsupp.single m 1` generated
by the relations of the proof of Stacks 09CK for operators of order `1`:
`[m + m'] - [m] - [m']`, `f[m] - [fm]` for `f ∈ R`, and
`g₀g₁[m] - g₀[g₁m] - g₁[g₀m] + [g₁g₀m]` for `g₀, g₁ ∈ S`. -/
noncomputable def PrincipalPartsOne.relations : Submodule S (M →₀ S) :=
  Submodule.span S
    (Set.range (fun x : M × M =>
        Finsupp.single (x.1 + x.2) (1 : S) - Finsupp.single x.1 1 - Finsupp.single x.2 1) ∪
      Set.range (fun x : R × M => x.1 • Finsupp.single x.2 (1 : S) - Finsupp.single (x.1 • x.2) 1) ∪
      Set.range (fun x : S × S × M =>
        x.1 • x.2.1 • Finsupp.single x.2.2 (1 : S) - x.1 • Finsupp.single (x.2.1 • x.2.2) 1 -
          x.2.1 • Finsupp.single (x.1 • x.2.2) 1 + Finsupp.single (x.2.1 • x.1 • x.2.2) 1))

/-- **The module of principal parts of order one**, `P¹_{S/R}(M)`, as constructed in the proof of
Stacks 09CK: the quotient of the free `S`-module on symbols `[m]`, `m ∈ M`, by
`PrincipalPartsOne.relations R S M`. -/
abbrev PrincipalPartsOne : Type (max w v) :=
  (M →₀ S) ⧸ PrincipalPartsOne.relations R S M

namespace PrincipalPartsOne

variable {R S M}

omit [IsScalarTower R S M] in
lemma single_add_mem (m m' : M) :
    Finsupp.single (m + m') (1 : S) - Finsupp.single m 1 - Finsupp.single m' 1 ∈
      relations R S M :=
  Submodule.subset_span (Or.inl (Or.inl ⟨(m, m'), rfl⟩))

omit [IsScalarTower R S M] in
lemma single_smul_mem (f : R) (m : M) :
    f • Finsupp.single m (1 : S) - Finsupp.single (f • m) 1 ∈ relations R S M :=
  Submodule.subset_span (Or.inl (Or.inr ⟨(f, m), rfl⟩))

omit [IsScalarTower R S M] in
lemma single_smul_smul_mem (g₀ g₁ : S) (m : M) :
    g₀ • g₁ • Finsupp.single m (1 : S) - g₀ • Finsupp.single (g₁ • m) 1 -
        g₁ • Finsupp.single (g₀ • m) 1 + Finsupp.single (g₁ • g₀ • m) 1 ∈ relations R S M :=
  Submodule.subset_span (Or.inr ⟨(g₀, g₁, m), rfl⟩)

variable (R S M) in
/-- The universal differential operator `M → P¹_{S/R}(M)`, `m ↦ [m]`. -/
noncomputable def universalOperator : M →ₗ[R] PrincipalPartsOne R S M where
  toFun m := Submodule.Quotient.mk (Finsupp.single m 1)
  map_add' m m' := by
    have h := (Submodule.Quotient.mk_eq_zero _).mpr (single_add_mem (R := R) (S := S) m m')
    rwa [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_sub, sub_sub, sub_eq_zero] at h
  map_smul' f m := by
    have h := (Submodule.Quotient.mk_eq_zero _).mpr (single_smul_mem (S := S) f m)
    rw [Submodule.Quotient.mk_sub, sub_eq_zero, Submodule.Quotient.mk_smul] at h
    exact h.symm

omit [IsScalarTower R S M] in
lemma universalOperator_apply (m : M) :
    universalOperator R S M m = Submodule.Quotient.mk (Finsupp.single m 1) := rfl

omit [IsScalarTower R S M] in
/-- `S`-linear maps out of `P¹_{S/R}(M)` agreeing on the symbols `[m]` are equal. -/
lemma hom_ext {N : Type*} [AddCommGroup N] [Module S N] {α β : PrincipalPartsOne R S M →ₗ[S] N}
    (h : ∀ m : M, α (universalOperator R S M m) = β (universalOperator R S M m)) : α = β := by
  refine Submodule.linearMap_qext _ (Finsupp.lhom_ext' fun m => LinearMap.ext_ring ?_)
  exact h m

/-- The operator `m ↦ [m]` has order at most `1`: this is the third family of relations. -/
lemma isDifferentialOperatorOfOrderLE_universalOperator :
    (universalOperator R S M).IsDifferentialOperatorOfOrderLE S 1 := by
  refine LinearMap.isDifferentialOperatorOfOrderLE_succ_iff.mpr fun g₁ =>
    LinearMap.isDifferentialOperatorOfOrderLE_zero_iff.mpr fun g₀ m => ?_
  have h := (Submodule.Quotient.mk_eq_zero _).mpr (single_smul_smul_mem (R := R) g₀ g₁ m)
  simp only [Submodule.Quotient.mk_add, Submodule.Quotient.mk_sub,
    Submodule.Quotient.mk_smul] at h
  simp only [LinearMap.commSMul_apply, universalOperator_apply, smul_sub]
  rw [← sub_eq_zero, ← h]
  abel

/-- The `S`-linear map `P¹_{S/R}(M) → N` attached to an operator `E : M → N` of order at most
`1`, sending `[m]` to `E m`. -/
noncomputable def lift {N : Type*} [AddCommGroup N] [Module R N] [Module S N]
    [IsScalarTower R S N] (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) :
    PrincipalPartsOne R S M →ₗ[S] N :=
  (relations R S M).liftQ (Finsupp.linearCombination S E) <| by
    refine Submodule.span_le.mpr ?_
    rintro _ ((⟨⟨m, m'⟩, rfl⟩ | ⟨⟨f, m⟩, rfl⟩) | ⟨⟨g₀, g₁, m⟩, rfl⟩)
    · simp
    · simp
    · have h := LinearMap.isDifferentialOperatorOfOrderLE_zero_iff.mp
        (LinearMap.isDifferentialOperatorOfOrderLE_succ_iff.mp hE g₁) g₀ m
      simp only [LinearMap.commSMul_apply, smul_sub] at h
      simp only [SetLike.mem_coe, LinearMap.mem_ker, map_add, map_sub, map_smul,
        Finsupp.linearCombination_single, one_smul]
      rw [← sub_eq_zero] at h
      rw [← h]
      abel

lemma lift_universalOperator {N : Type*} [AddCommGroup N] [Module R N] [Module S N]
    [IsScalarTower R S N] (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) (m : M) :
    lift E hE (universalOperator R S M m) = E m := by
  simp [lift, universalOperator_apply]

/-- **The construction of `P¹_{S/R}(M)` in the proof of Stacks 09CK.** The quotient of the free
`S`-module on symbols `[m]` by the relations `[m + m'] - [m] - [m']`, `f[m] - [fm]` and
`g₀g₁[m] - g₀[g₁m] - g₁[g₀m] + [g₁g₀m]`, with the operator `m ↦ [m]`, is a module of principal
parts of order `1` of `M`. -/
theorem isUniversalDifferentialOperatorOfOrderLE_universalOperator :
    (universalOperator R S M).IsUniversalDifferentialOperatorOfOrderLE S 1 := by
  refine ⟨isDifferentialOperatorOfOrderLE_universalOperator, fun N _ _ _ _ E hE => ?_⟩
  refine ⟨lift E hE, lift_universalOperator E hE, fun α hα => hom_ext fun m => ?_⟩
  rw [hα, lift_universalOperator]

/-! ### Functoriality in `M` -/

variable {M' : Type w'} [AddCommGroup M'] [Module R M'] [Module S M'] [IsScalarTower R S M']
  {M'' : Type w''} [AddCommGroup M''] [Module R M''] [Module S M''] [IsScalarTower R S M'']

/-- The `S`-linear map `P¹_{S/R}(M) → P¹_{S/R}(M')` induced by an `S`-linear map `f : M → M'`,
sending `[m]` to `[f m]`. -/
noncomputable def map (f : M →ₗ[S] M') : PrincipalPartsOne R S M →ₗ[S] PrincipalPartsOne R S M' :=
  (relations R S M).mapQ (relations R S M') (Finsupp.lmapDomain S S f) <| by
    refine Submodule.span_le.mpr ?_
    rintro _ ((⟨⟨m, m'⟩, rfl⟩ | ⟨⟨r, m⟩, rfl⟩) | ⟨⟨g₀, g₁, m⟩, rfl⟩)
    all_goals
      simp only [SetLike.mem_coe, Submodule.mem_comap, map_sub, map_add, map_smul,
        LinearMap.map_smul_of_tower]
      simp only [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, map_add, map_smul,
        LinearMap.map_smul_of_tower]
    · exact single_add_mem (f m) (f m')
    · exact single_smul_mem r (f m)
    · exact single_smul_smul_mem (R := R) g₀ g₁ (f m)

lemma map_universalOperator (f : M →ₗ[S] M') (m : M) :
    map f (universalOperator R S M m) = universalOperator R S M' (f m) := by
  simp [map, universalOperator_apply]

lemma map_id : map (LinearMap.id : M →ₗ[S] M) = (LinearMap.id : _ →ₗ[S] PrincipalPartsOne R S M) :=
  hom_ext fun m => by rw [map_universalOperator]; rfl

lemma map_comp (f : M →ₗ[S] M') (g : M' →ₗ[S] M'') :
    map (R := R) (g ∘ₗ f) = map g ∘ₗ map f :=
  hom_ext fun m => by simp [map_universalOperator]

/-! ### The sequence of principal parts -/

lemma exists_shortExact :
    ∃ (ι : Ω[S⁄R] ⊗[S] M →ₗ[S] PrincipalPartsOne R S M) (π : PrincipalPartsOne R S M →ₗ[S] M),
      (∀ (b : S) (m : M), ι (KaehlerDifferential.D R S b ⊗ₜ[S] m) =
        universalOperator R S M (b • m) - b • universalOperator R S M m) ∧
      (∀ m : M, π (universalOperator R S M m) = m) ∧
      Function.Injective ι ∧ Function.Exact ι π ∧ Function.Surjective π :=
  LinearMap.IsDifferentialOperatorOfOrderLE.exists_shortExact_principalParts _
    isDifferentialOperatorOfOrderLE_universalOperator
    fun _ _ _ _ _ E hE => isUniversalDifferentialOperatorOfOrderLE_universalOperator.2 E hE

variable (R S M) in
/-- The first map `Ω[S⁄R] ⊗[S] M → P¹_{S/R}(M)` of the sequence of principal parts, the map
`d b ⊗ₜ m ↦ [b m] - b [m]` (`symbol_tmul`). -/
noncomputable def symbol : Ω[S⁄R] ⊗[S] M →ₗ[S] PrincipalPartsOne R S M :=
  Classical.choose exists_shortExact

variable (R S M) in
/-- The second map `P¹_{S/R}(M) → M = P⁰_{S/R}(M)` of the sequence of principal parts, the map
`[m] ↦ m` (`proj_universalOperator`). -/
noncomputable def proj : PrincipalPartsOne R S M →ₗ[S] M :=
  Classical.choose (Classical.choose_spec (exists_shortExact (R := R) (S := S) (M := M)))

lemma symbol_proj_spec :
    (∀ (b : S) (m : M), symbol R S M (KaehlerDifferential.D R S b ⊗ₜ[S] m) =
        universalOperator R S M (b • m) - b • universalOperator R S M m) ∧
      (∀ m : M, proj R S M (universalOperator R S M m) = m) ∧
      Function.Injective (symbol R S M) ∧ Function.Exact (symbol R S M) (proj R S M) ∧
        Function.Surjective (proj R S M) :=
  Classical.choose_spec (Classical.choose_spec (exists_shortExact (R := R) (S := S) (M := M)))

lemma symbol_tmul (b : S) (m : M) :
    symbol R S M (KaehlerDifferential.D R S b ⊗ₜ[S] m) =
      universalOperator R S M (b • m) - b • universalOperator R S M m :=
  symbol_proj_spec.1 b m

lemma proj_universalOperator (m : M) : proj R S M (universalOperator R S M m) = m :=
  symbol_proj_spec.2.1 m

omit [Module R M] [IsScalarTower R S M] in
/-- Two `S`-linear maps out of `Ω[S⁄R] ⊗[S] M` agreeing on the elements `d b ⊗ₜ m` are equal. -/
private lemma tensor_ext {N : Type*} [AddCommGroup N] [Module S N]
    {α β : Ω[S⁄R] ⊗[S] M →ₗ[S] N}
    (h : ∀ (b : S) (m : M), α (KaehlerDifferential.D R S b ⊗ₜ[S] m)
      = β (KaehlerDifferential.D R S b ⊗ₜ[S] m)) : α = β := by
  refine TensorProduct.ext' fun x m => ?_
  have key : α ∘ₗ (TensorProduct.mk S (Ω[S⁄R]) M).flip m
      = β ∘ₗ (TensorProduct.mk S (Ω[S⁄R]) M).flip m := by
    refine LinearMap.ext_on (KaehlerDifferential.span_range_derivation R S) ?_
    rintro y ⟨b, rfl⟩
    simpa using h b m
  simpa using LinearMap.congr_fun key x

lemma map_comp_symbol (f : M →ₗ[S] M') :
    map (R := R) f ∘ₗ symbol R S M = symbol R S M' ∘ₗ f.lTensor (Ω[S⁄R]) :=
  tensor_ext fun b m => by
    simp [symbol_tmul, map_universalOperator]

lemma proj_comp_map (f : M →ₗ[S] M') :
    proj R S M' ∘ₗ map f = f ∘ₗ proj R S M :=
  hom_ext fun m => by simp [map_universalOperator, proj_universalOperator]

/-- **Stacks 09CN.** Let `R → S` be a ring map and let `M` be an `S`-module, and let
`P¹_{S/R}(M)` be the module of principal parts of order `1` of `M` as constructed in the proof of
Lemma 09CK. There is a canonical short exact sequence
`0 → Ω[S⁄R] ⊗[S] M → P¹_{S/R}(M) → M → 0`, the *sequence of principal parts*: its first map sends
`d b ⊗ₜ m` to `[b m] - b [m]`, its second map sends `[m]` to `m`, and it is functorial in `M`:
`P¹_{S/R}(-)` is a functor on `S`-modules (`[m] ↦ [f m]`) and both maps are natural. -/
@[stacks 09CN "`P¹_{S/R}(M)` is `PrincipalPartsOne R S M`, the quotient of the free `S`-module on
symbols `[m]` by the relations of the proof of Lemma 09CK for order `1`. The two maps of the
sequence are pinned by `ι (d b ⊗ₜ m) = [b m] - b [m]` and `π [m] = m`; functoriality in `M` is
stated as functoriality of `PrincipalPartsOne.map` and naturality of both maps.",
  sga "6 II AppII.1.2.4" "n = 1, ring setting"]
theorem shortExact_symbol_proj :
    (∀ (b : S) (m : M), symbol R S M (KaehlerDifferential.D R S b ⊗ₜ[S] m) =
        universalOperator R S M (b • m) - b • universalOperator R S M m) ∧
      (∀ m : M, proj R S M (universalOperator R S M m) = m) ∧
      Function.Injective (symbol R S M) ∧ Function.Exact (symbol R S M) (proj R S M) ∧
      Function.Surjective (proj R S M) ∧
      map (LinearMap.id : M →ₗ[S] M) = (LinearMap.id : _ →ₗ[S] PrincipalPartsOne R S M) ∧
      (∀ (M' : Type w') [AddCommGroup M'] [Module R M'] [Module S M'] [IsScalarTower R S M']
        (M'' : Type w'') [AddCommGroup M''] [Module R M''] [Module S M''] [IsScalarTower R S M'']
        (f : M →ₗ[S] M') (g : M' →ₗ[S] M''), map (R := R) (g ∘ₗ f) = map g ∘ₗ map f) ∧
      ∀ (M' : Type w') [AddCommGroup M'] [Module R M'] [Module S M'] [IsScalarTower R S M']
        (f : M →ₗ[S] M'),
        map (R := R) f ∘ₗ symbol R S M = symbol R S M' ∘ₗ f.lTensor (Ω[S⁄R]) ∧
          proj R S M' ∘ₗ map f = f ∘ₗ proj R S M :=
  ⟨symbol_proj_spec.1, symbol_proj_spec.2.1, symbol_proj_spec.2.2.1, symbol_proj_spec.2.2.2.1,
    symbol_proj_spec.2.2.2.2, map_id,
    fun _ _ _ _ _ _ _ _ _ _ f g => map_comp f g,
    fun _ _ _ _ _ f => ⟨map_comp_symbol f, proj_comp_map f⟩⟩

end PrincipalPartsOne

end
