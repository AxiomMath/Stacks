module

public import StacksFrontier.RingTheory.DifferentialOperator.Defs
import StacksCore.Tactic.EgaSgaAttribute

@[expose] public section

universe t

/-!
# Existence of the module of principal parts

Let `R → S` be a ring map, let `M` be an `S`-module and let `k : ℕ`. This file proves that the
functor `N ↦ Diffᵏ_{S/R}(M, N)` of differential operators of order at most `k` out of `M`
(Definition 09CI) is representable: there are an `S`-module `Pᵏ_{S/R}(M)` and a universal
differential operator `D_univ : M → Pᵏ_{S/R}(M)` of order at most `k` such that precomposition
with `D_univ` is a bijection from `Hom_S(Pᵏ_{S/R}(M), N)` onto `Diffᵏ_{S/R}(M, N)`, functorially
in the `S`-module `N`.

## Main results

* `Stacks.PrincipalParts.Representability.solution`: Stacks 09CK, in the universal-object form of
  `LinearMap.exists_universal_isDifferentialOperatorOfOrderLE`.

## Implementation notes

The source constructs the representing module as the quotient of the free `S`-module
`F = ⨁_{m ∈ M} S[m]` on the underlying set of `M` by the submodule generated by the elements
`[m + m'] - [m] - [m']`, `f[m] - [fm]` for `f ∈ R`, and the alternating sums
`g₀ ⋯ g_k[m] - ∑ᵢ g₀ ⋯ ĝᵢ ⋯ g_k[gᵢm] + … + (-1)^(k+1)[g₀ ⋯ g_k m]` for `g₀, …, g_k ∈ S`.

The first two families of relations say exactly that an `S`-linear map `F → N` annihilating them
restricts to an `R`-linear map on `M`, so the quotient of `F` by the submodule they generate is
the base change `S ⊗[R] M`, and the construction is carried out here with that base change in
place of `F`: by `TensorProduct.isBaseChange`, composition with `incl : m ↦ 1 ⊗ m` identifies
`Hom_S(S ⊗[R] M, N)` with `Hom_R(M, N)` for every `S`-module `N` — injectively by
`comp_incl_injective`, onto by `lift_comp_incl` — so what remains to be cut out is only the
condition of being of order at most `k`.

The remaining alternating sums are not written down. Instead the submodule they generate is
produced by the same induction on `k` that defines the order: `commSMulHom g`, the `S`-linear
endomorphism of `S ⊗[R] M` extending `m ↦ 1 ⊗ g • m - g • (1 ⊗ m)`, is universal for forming the
commutator with `g ∈ S`, in the sense that the commutator of the operator attached to `α` is the
operator attached to `α ∘ commSMulHom g` (`commSMul_comp_incl`). Hence `relations R S M k`, which
is `⨆ g, range (commSMulHom g)` at `k = 0` and `⨆ g, map (commSMulHom g) (relations R S M k)` at
`k + 1`, has the property that an `S`-linear `α : S ⊗[R] M → N` annihilates it if and only if
the operator attached to `α` is of order at most `k`. That equivalence,
`isDifferentialOperatorOfOrderLE_iff`, carries the whole content of the lemma, and it is one
induction: at both `0` and `k + 1` it is a congruence in `g : S` between the vanishing of a
commutator and an inclusion of submodules. Unwinding it, `relations R S M k` is the `S`-span of
the `(k + 1)`-fold iterated commutators applied to the generators `1 ⊗ m`, which is the source's
list of alternating sums. The representing module is
`Pᵏ_{S/R}(M) = (S ⊗[R] M) ⧸ relations R S M k`, whose universe is `max v w` as the statement
requires, and the universal differential operator `universalOperator k` is the composite of `incl`
with the quotient map.

The two forms of Definition 09CI used throughout,
`isDifferentialOperatorOfOrderLE_zero_iff_commSMul_eq_zero` and
`isDifferentialOperatorOfOrderLE_succ_iff`, state it at the level of maps rather than of elements,
with the commutator `commSMul D g = D (g • ·) - g • D ·` named; the definition itself is the
elementwise form at `0` and the map-level form at `k + 1`.

## References

* [Stacks 09CK](https://stacks.math.columbia.edu/tag/09CK)
-/

universe u v w x

namespace Stacks.PrincipalParts.Representability

open TensorProduct

open LinearMap (commSMul commSMul_apply isDifferentialOperatorOfOrderLE_succ_iff
  isDifferentialOperatorOfOrderLE_zero_iff_commSMul_eq_zero)

/-! ### `S`-linear maps out of the base change `S ⊗[R] M` -/

section BaseChange

variable {R : Type u} {S : Type v} {M : Type w} {N : Type x} [CommSemiring R] [CommSemiring S]
  [Algebra R S] [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N] [Module S N]
  [IsScalarTower R S N]

/-- The canonical `R`-linear map `M → S ⊗[R] M`, `m ↦ 1 ⊗ m`, which exhibits `S ⊗[R] M` as the
base change of `M` along `R → S`. -/
private abbrev incl : M →ₗ[R] S ⊗[R] M := TensorProduct.mk R S M 1

/-- Composition with `incl` is injective on `S`-linear maps out of `S ⊗[R] M`: two of them that
agree on the elements `1 ⊗ m` are equal, those elements generating `S ⊗[R] M` over `S`. -/
private lemma comp_incl_injective :
    Function.Injective fun α : (S ⊗[R] M) →ₗ[S] N => α.restrictScalars R ∘ₗ incl :=
  fun α β h =>
    (TensorProduct.isBaseChange R M S).algHom_ext α β fun m => LinearMap.congr_fun h m

/-- An `S`-linear map out of `S ⊗[R] M` vanishes as soon as it vanishes on the elements `1 ⊗ m`. -/
private lemma comp_incl_eq_zero_iff (α : (S ⊗[R] M) →ₗ[S] N) :
    α.restrictScalars R ∘ₗ incl = 0 ↔ α = 0 :=
  comp_incl_injective.eq_iff' rfl

/-- Composition with `incl` is onto the `R`-linear maps `M → N`: the `S`-linear extension of `D`
along the base change restricts to `D` on the elements `1 ⊗ m`. -/
private lemma lift_comp_incl (D : M →ₗ[R] N) :
    ((TensorProduct.isBaseChange R M S).lift D).restrictScalars R ∘ₗ incl = D :=
  LinearMap.ext fun m => (TensorProduct.isBaseChange R M S).lift_eq D m

end BaseChange

/-! ### The relations cutting out the operators of order at most `k` -/

section Relations

variable {R : Type u} {S : Type v} {M : Type w} {N : Type x} [CommSemiring R] [CommRing S]
  [Algebra R S] [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
  [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]

/-- The `S`-linear endomorphism of `S ⊗[R] M` extending the `R`-linear map
`m ↦ 1 ⊗ g • m - g • (1 ⊗ m)`. It is universal for forming the commutator with `g` of a
differential operator out of `M`; see `commSMul_comp_incl`. -/
private noncomputable def commSMulHom (g : S) : (S ⊗[R] M) →ₗ[S] S ⊗[R] M :=
  (TensorProduct.isBaseChange R M S).lift
    (incl ∘ₗ Algebra.lsmul R R M g - Algebra.lsmul R R (S ⊗[R] M) g ∘ₗ incl)

/-- The value of `commSMulHom g` on the generator `1 ⊗ m` of `S ⊗[R] M`. -/
private lemma commSMulHom_tmul (g : S) (m : M) :
    commSMulHom g ((1 : S) ⊗ₜ[R] m) = (1 : S) ⊗ₜ[R] (g • m) - g • ((1 : S) ⊗ₜ[R] m) :=
  (TensorProduct.isBaseChange R M S).lift_eq _ m

/-- The commutator with `g` of the operator attached to `α` is the operator attached to
`α ∘ commSMulHom g`: precomposition with `commSMulHom g` implements the commutator. -/
private lemma commSMul_comp_incl (g : S) (α : (S ⊗[R] M) →ₗ[S] N) :
    commSMul (α.restrictScalars R ∘ₗ incl) g
      = (α ∘ₗ commSMulHom g).restrictScalars R ∘ₗ incl := by
  ext m
  simp [commSMul_apply, commSMulHom_tmul]

/-- The `S`-submodule of `S ⊗[R] M` cut out by the order-`≤ k` condition: an `S`-linear map
`α : S ⊗[R] M → N` annihilates `relations R S M k` exactly when the `R`-linear map `α ∘ incl` is a
differential operator of order at most `k`. See `isDifferentialOperatorOfOrderLE_iff`. -/
private noncomputable def relations (R : Type u) (S : Type v) (M : Type w) [CommSemiring R]
    [CommRing S] [Algebra R S] [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] :
    ℕ → Submodule S (S ⊗[R] M)
  | 0 => ⨆ g : S, LinearMap.range (commSMulHom g)
  | k + 1 => ⨆ g : S, (relations R S M k).map (commSMulHom g)

/-- The universal property of `relations R S M k`: the differential operator attached to an
`S`-linear map `α : S ⊗[R] M → N` is of order at most `k` if and only if `α` annihilates
`relations R S M k`. This is the content of Stacks 09CK; what follows it is bookkeeping. -/
private lemma isDifferentialOperatorOfOrderLE_iff (k : ℕ) (α : (S ⊗[R] M) →ₗ[S] N) :
    (α.restrictScalars R ∘ₗ incl).IsDifferentialOperatorOfOrderLE S k
      ↔ relations R S M k ≤ LinearMap.ker α := by
  induction k generalizing α with
  | zero =>
    rw [isDifferentialOperatorOfOrderLE_zero_iff_commSMul_eq_zero, relations, iSup_le_iff]
    refine forall_congr' fun g => ?_
    rw [commSMul_comp_incl, comp_incl_eq_zero_iff]
    exact LinearMap.range_le_ker_iff.symm
  | succ k ih =>
    rw [isDifferentialOperatorOfOrderLE_succ_iff, relations, iSup_le_iff]
    refine forall_congr' fun g => ?_
    rw [commSMul_comp_incl, ih, LinearMap.ker_comp, Submodule.map_le_iff_le_comap]

/-! ### The module of principal parts and its universal operator -/

/-- The universal differential operator of order at most `k` out of `M`: the composite of
`incl : m ↦ 1 ⊗ m` with the quotient map onto the module of principal parts
`Pᵏ_{S/R}(M) = (S ⊗[R] M) ⧸ relations R S M k`. -/
private noncomputable def universalOperator (k : ℕ) :
    M →ₗ[R] (S ⊗[R] M) ⧸ relations R S M k :=
  (relations R S M k).mkQ.restrictScalars R ∘ₗ incl

/-- Composing the universal operator with an `S`-linear map `α` out of `Pᵏ_{S/R}(M)` gives the
operator attached to `α ∘ mkQ`. -/
private lemma comp_universalOperator (k : ℕ)
    (α : ((S ⊗[R] M) ⧸ relations R S M k) →ₗ[S] N) :
    α.restrictScalars R ∘ₗ universalOperator k
      = (α ∘ₗ (relations R S M k).mkQ).restrictScalars R ∘ₗ incl :=
  rfl

/-- The universal operator is a differential operator of order at most `k`. -/
private lemma isDifferentialOperatorOfOrderLE_universalOperator (k : ℕ) :
    LinearMap.IsDifferentialOperatorOfOrderLE S k
      (universalOperator k : M →ₗ[R] (S ⊗[R] M) ⧸ relations R S M k) :=
  (isDifferentialOperatorOfOrderLE_iff k (relations R S M k).mkQ).mpr
    (relations R S M k).ker_mkQ.ge

/-- Every composite of the universal operator with an `S`-linear map out of `Pᵏ_{S/R}(M)` is a
differential operator of order at most `k`. -/
private lemma isDifferentialOperatorOfOrderLE_comp_universalOperator (k : ℕ)
    (α : ((S ⊗[R] M) ⧸ relations R S M k) →ₗ[S] N) :
    (α.restrictScalars R ∘ₗ universalOperator k).IsDifferentialOperatorOfOrderLE S k := by
  rw [comp_universalOperator, isDifferentialOperatorOfOrderLE_iff]
  exact (relations R S M k).ker_mkQ.ge.trans (LinearMap.ker_le_ker_comp _ α)

/-- Precomposition with the universal operator is injective on `S`-linear maps out of
`Pᵏ_{S/R}(M)`: the quotient is generated by the image of the elements `1 ⊗ m`. -/
private lemma comp_universalOperator_injective (k : ℕ) :
    Function.Injective fun α : ((S ⊗[R] M) ⧸ relations R S M k) →ₗ[S] N =>
      α.restrictScalars R ∘ₗ universalOperator k := by
  intro α β h
  have h' : α ∘ₗ (relations R S M k).mkQ = β ∘ₗ (relations R S M k).mkQ :=
    comp_incl_injective h
  exact Submodule.linearMap_qext _ h'

/-- The differential operators `M → N` of order at most `k` are exactly the composites of the
universal operator with an `S`-linear map out of `Pᵏ_{S/R}(M)`. -/
private lemma range_comp_universalOperator (k : ℕ) :
    Set.range (fun α : ((S ⊗[R] M) ⧸ relations R S M k) →ₗ[S] N =>
        α.restrictScalars R ∘ₗ universalOperator k)
      = {D : M →ₗ[R] N | D.IsDifferentialOperatorOfOrderLE S k} := by
  refine Set.ext fun D => ⟨?_, fun hD => ?_⟩
  · rintro ⟨α, rfl⟩
    exact isDifferentialOperatorOfOrderLE_comp_universalOperator k α
  · exact ⟨(relations R S M k).liftQ ((TensorProduct.isBaseChange R M S).lift D)
      (by rw [← isDifferentialOperatorOfOrderLE_iff, lift_comp_incl]; exact hD),
      LinearMap.ext fun m => LinearMap.congr_fun (lift_comp_incl D) m⟩

end Relations

/-- **Stacks 09CK.** Let `R → S` be a ring map, let `M` be an `S`-module and let `k : ℕ`. There
exist an `S`-module `P` and a differential operator `D_univ : M → P` of order at most `k`
relative to `R → S` such that, for every `S`-module `N`, precomposition with `D_univ` is a
bijection from the `S`-linear maps `P → N` onto the differential operators `M → N` of order at
most `k`. -/
public theorem solution {R : Type u} {S : Type v} {M : Type w} [CommSemiring R] [CommRing S]
    [Algebra R S] [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M] (k : ℕ) :
    ∃ (P : Type (max v w)) (_ : AddCommGroup P) (_ : Module R P) (_ : Module S P)
      (_ : IsScalarTower R S P) (Duniv : M →ₗ[R] P),
      Duniv.IsDifferentialOperatorOfOrderLE S k ∧
        ∀ (N : Type x) [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N],
          Function.Injective (fun α : P →ₗ[S] N => α.restrictScalars R ∘ₗ Duniv) ∧
            Set.range (fun α : P →ₗ[S] N => α.restrictScalars R ∘ₗ Duniv) =
              {D : M →ₗ[R] N | D.IsDifferentialOperatorOfOrderLE S k} :=
  ⟨(S ⊗[R] M) ⧸ relations R S M k, inferInstance, inferInstance, inferInstance, inferInstance,
    universalOperator k, isDifferentialOperatorOfOrderLE_universalOperator k,
    fun _ => ⟨comp_universalOperator_injective k, range_comp_universalOperator k⟩⟩

end Stacks.PrincipalParts.Representability

/-!
# Existence of the module of principal parts

Let `R → S` be a ring map, let `M` be an `S`-module and let `k : ℕ`. The differential operators
`M → N` of order at most `k` relative to `R → S` (Definition 09CI) depend on the target `S`-module
`N` in a way that is representable: there is an `S`-module `Pᵏ_{S/R}(M)`, the *module of principal
parts of order `k`* of `M`, and an isomorphism
`Diffᵏ_{S/R}(M, N) = Hom_S(Pᵏ_{S/R}(M), N)` functorial in `N`. By the Yoneda lemma this says that
there is a *universal* differential operator `D_univ : M → Pᵏ_{S/R}(M)` of order at most `k` such
that every differential operator `D : M → N` of order at most `k` factors as `D = α ∘ D_univ` for
a unique `S`-linear `α : Pᵏ_{S/R}(M) → N`, and that is the form stated here: the isomorphism is
the map `α ↦ α ∘ D_univ`, so the universal element is pinned rather than merely asserted to
exist, and the pair `(Pᵏ_{S/R}(M), D_univ)` is thereby unique up to unique isomorphism.

At `k = 0` the operators of order at most `0` are the `S`-linear maps, so `M` itself, carried into
the universe of the statement, with `D_univ` the identity is a witness, and `P⁰_{S/R}(M) = M` as
the source records. In general the source
constructs the representing module as the quotient of the free `S`-module `⨁_{m ∈ M} S` on symbols
`[m]`, `m ∈ M`, by the submodule generated by `[m + m'] - [m] - [m']`, `f[m] - [fm]` for `f ∈ R`,
and the alternating sums
`g₀g₁⋯g_k[m] - ∑ᵢ g₀⋯ĝᵢ⋯g_k[gᵢm] + … + (-1)^(k+1)[g₀⋯g_k m]` for `g₀, …, g_k ∈ S`.

## Main results

* `LinearMap.exists_universal_isDifferentialOperatorOfOrderLE`: existence of an `S`-module and a
  universal differential operator of order at most `k` out of `M` representing the differential
  operators of order at most `k` out of `M`.

## Implementation notes

The isomorphism of the source is not stated as a bare bijection but as the assertion that the
specific map `α ↦ α.restrictScalars R ∘ₗ D_univ` from `Pᵏ_{S/R}(M) →ₗ[S] N` to `M →ₗ[R] N` is
injective with image exactly the differential operators of order at most `k`; that is the same
data as an isomorphism `Diffᵏ_{S/R}(M, N) = Hom_S(Pᵏ_{S/R}(M), N)`, with the map realizing it
named. Functoriality in `N` then needs no clause of its own: a family of bijections given by
precomposition with one fixed `D_univ` is natural in `N` by associativity of composition, since
an `S`-linear `f : N → N'` carries `α ∘ D_univ` to `(f ∘ₗ α) ∘ D_univ`, and for the same reason
the bijection is `S`-linear in `α`. Phrasing it instead as an `S`-linear equivalence would need
`Diffᵏ_{S/R}(M, N)` as a submodule of `M →ₗ[R] N` — the content of the paragraph following
Definition 09CI — which is a separate statement; the set `{D | D.IsDifferentialOperatorOfOrderLE
S k}` carries the same information here.

The `R`-module structures on `M`, on the representing module and on `N` are the restrictions along
`R → S`, pinned by `IsScalarTower` as in `LinearMap.IsDifferentialOperatorOfOrderLE`, and the
structures on the representing module are existentially quantified hypotheses of class type, hence
available to instance search once the statement is destructured. `S` is taken to be a commutative
ring rather than 09CI's semiring: the relations above subtract, and their symmetry in `g₀, …, g_k`
is the source's commutative setting. The representing module is pinned to the universe
`max v w` of the source's `⨁_{m ∈ M} S`, while the universe of the test module `N` is a parameter
of the statement, so, as for any representability asserted by a single `∃`, the witness is claimed
for one universe of test modules at a time although the construction is uniform in it.

The source's remark writes the factorization as `D = D_univ ∘ α`; with `D_univ : M → Pᵏ_{S/R}(M)`
and `α : Pᵏ_{S/R}(M) → N` the composite that typechecks is `α ∘ D_univ`, which is what is stated.

Faithfulness. (1) No dead hypothesis: `R`, `S`, `M` and `k` all occur in the conclusion, `k`
through the order bound on `D_univ` and on the operators represented, and nothing is assumed
beyond the source's data of a ring map and an `S`-module. (2) The scalars and base are the
source's: `D_univ` and the operators represented are `R`-linear for the ring map `R → S`, the
factoring map `α` is `S`-linear, and the two actions are tied by the scalar towers, so no
unrelated `R`-action can be substituted. (3) The canonical map is pinned, not merely asserted to
exist: the isomorphism is the precomposition map `α ↦ α.restrictScalars R ∘ₗ D_univ` for the
`D_univ` produced, which is itself required to be a differential operator of order at most `k`.
(4) The instantiation is not degenerate: at `k = 0` the module `ULift M` with `D_univ` the
identity satisfies both clauses, the operators of order at most `0` being exactly the `S`-linear
maps, while at `k = 1` the represented set is strictly larger — for `S = M = N = R[X]` it contains
`d/dX`, which is not of order at most `0` — so no single module witnesses every `k`.

## References

* [Stacks 09CK](https://stacks.math.columbia.edu/tag/09CK), in the section "Finite order
  differential operators" (Tag 09CH), whose Definition 09CI is
  `LinearMap.IsDifferentialOperatorOfOrderLE`. The representing module is named in Definition
  09CL.
-/

@[expose] public section


namespace LinearMap

variable {R : Type u} {S : Type v} {M : Type w} [CommSemiring R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]

/-- **Stacks 09CK.** Let `R → S` be a ring map, let `M` be an `S`-module and let `k : ℕ`. There
exist an `S`-module `P` and a differential operator `D_univ : M → P` of order at most `k`
relative to `R → S` such that, for every `S`-module `N`, precomposition with `D_univ` is a
bijection from the `S`-linear maps `P → N` onto the differential operators `M → N` of order at
most `k`. Thus `P = Pᵏ_{S/R}(M)` represents `Diffᵏ_{S/R}(M, -)`, functorially in `N`. -/
@[stacks 09CK "Stated in the universal-object form of the paragraph following the lemma: the
isomorphism `Diffᵏ_{S/R}(M, N) = Hom_S(Pᵏ_{S/R}(M), N)` is the map `α ↦ α ∘ D_univ`, so the
universal operator is pinned and functoriality in `N` is automatic. See the module docstring.",
  ega "IV 16.8.3" "affine case",
  sga "6 II AppII.1.2.3" "affine (module) case",
  sga "6 II AppII.1.2.2" "affine case"]
public theorem exists_universal_isDifferentialOperatorOfOrderLE (k : ℕ) :
    ∃ (P : Type (max v w)) (_ : AddCommGroup P) (_ : Module R P) (_ : Module S P)
      (_ : IsScalarTower R S P) (Duniv : M →ₗ[R] P),
      Duniv.IsDifferentialOperatorOfOrderLE S k ∧
        ∀ (N : Type x) [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N],
          Function.Injective (fun α : P →ₗ[S] N => α.restrictScalars R ∘ₗ Duniv) ∧
            Set.range (fun α : P →ₗ[S] N => α.restrictScalars R ∘ₗ Duniv) =
              {D : M →ₗ[R] N | D.IsDifferentialOperatorOfOrderLE S k} :=
    by apply Stacks.PrincipalParts.Representability.solution

end LinearMap

end

/-!
# The sequence of principal parts

Let `R → S` be a ring map, let `M` be an `S`-module and let `D : M → P` be a universal
differential operator of order at most `1` on `M` relative to `R → S` (Definition 09CI): `P` is a
module of principal parts `P¹_{S/R}(M)` (Definition 09CL) and every order-`≤ 1` operator out of
`M` factors uniquely through `D` by an `S`-linear map (Lemma 09CK). This file proves that `P` sits
in a short exact sequence
`0 → Ω[S⁄R] ⊗[S] M → P → M → 0`,
the *sequence of principal parts*, whose first map sends `d b ⊗ₜ m` to `D (b • m) - b • D m` and
whose second one is the retraction of `D`.

## Main results

* `Stacks.PrincipalParts.ShortExactSequence.solution`: Stacks 09CN, in the form
  `LinearMap.IsDifferentialOperatorOfOrderLE.exists_shortExact_principalParts`.

## Implementation notes

Three constructions carry the proof.

*The symbol.* For an order-`≤ 1` operator `E : M → N` and `b : S` the commutator
`m ↦ E (b • m) - b • E m` is `S`-linear, which is what order `≤ 1` says, and
`b ↦ (m ↦ E (b • m) - b • E m)` is an `R`-derivation `S → Hom_S(M, N)`, its Leibniz rule being
again the order-`≤ 1` condition. Composing the `S`-linear map on `Ω[S⁄R]` it induces
(`Derivation.liftKaehlerDifferential`, the content of Lemma 00RO) with the universal property of
the tensor product gives the *symbol* `symbol E : Ω[S⁄R] ⊗[S] M → N`,
`d b ⊗ₜ m ↦ E (b • m) - b • E m`. For `E = D` this is the first map of the sequence, and it is
natural: `symbol (α ∘ D) = α ∘ symbol D` for `S`-linear `α` (`symbol_comp`).

*Generation.* `P` is generated over `S` by the image of `D` (`span_range_eq_top`), since the
projection to the quotient of `P` by that submodule and the zero map are two `S`-linear maps
agreeing on the image of `D`. Consequently an `S`-linear map out of `P` is determined by its
values on the image of `D` for a test module in *any* universe, which is how the universe
restriction in the hypothesis is circumvented (`ext_of_comp_D`). Exactness at `P` follows: modulo
the image of the symbol the operator `D` becomes `S`-linear, so the projection `mkQ` factors as
`E ∘ π` with `E` `S`-linear on `M`, and `E ∘ π = mkQ` by generation, whence
`ker π ⊆ range (symbol D)`.

*The model.* Injectivity of the symbol is proved by exhibiting one universal operator whose
symbol is visibly injective, and transporting. `Jet R S M` is the group `Ω[S⁄R] ⊗[S] M × M` with
the twisted `S`-action `s • (η, m) = (s • η + d s ⊗ₜ m, s • m)`, an action precisely because `d`
obeys the Leibniz rule; it is the first-order neighbourhood of the diagonal written out in these
coordinates. Then `Jet.D m = (0, m)` is an order-`≤ 1` operator whose symbol is the injective map
`x ↦ (-x, 0)`, and the `S`-linear `α : P → Jet R S M` with `α ∘ D = Jet.D` given by the universal
property satisfies `α ∘ symbol D = symbol Jet.D`; hence `symbol D` is injective. For `M = S` the
model is isomorphic, by `(η, m) ↦ (d m - η, m)`, to the pair `(Ω[S⁄R] × S, b ↦ (d b, b))` of
Example 09CM.

This replaces the free presentation, the snake lemma and the reduction to `M = S` of the source's
argument for injectivity: for the explicit model injectivity is a projection formula, and the
universal property carries it to every `P`.

## References

* [Stacks 09CN](https://stacks.math.columbia.edu/tag/09CN), Lemma 10.133.6, in the section
  "Finite order differential operators" (Tag 09CH).
-/

@[expose] public section

open TensorProduct



namespace Stacks.PrincipalParts.ShortExactSequence

open LinearMap (isDifferentialOperatorOfOrderLE_succ isDifferentialOperatorOfOrderLE_postcomp)

/-! ### Maps out of `Ω[S⁄R] ⊗[S] M` -/

section TensorExt

variable {R : Type*} {S : Type*} {M : Type*} {N : Type*} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module S M] [AddCommGroup N] [Module S N]

/-- Two `S`-linear maps out of `Ω[S⁄R] ⊗[S] M` agreeing on the elements `d b ⊗ₜ m` are equal. -/
private lemma tensor_ext {f g : Ω[S⁄R] ⊗[S] M →ₗ[S] N}
    (h : ∀ (b : S) (m : M), f (KaehlerDifferential.D R S b ⊗ₜ[S] m)
      = g (KaehlerDifferential.D R S b ⊗ₜ[S] m)) : f = g := by
  refine TensorProduct.ext' fun x m => ?_
  have key : f ∘ₗ (TensorProduct.mk S (Ω[S⁄R]) M).flip m
      = g ∘ₗ (TensorProduct.mk S (Ω[S⁄R]) M).flip m := by
    refine LinearMap.ext_on (KaehlerDifferential.span_range_derivation R S) ?_
    rintro y ⟨b, rfl⟩
    simpa using h b m
  simpa using LinearMap.congr_fun key x

end TensorExt

/-! ### The symbol of a differential operator of order at most one -/

section Symbol

variable {R : Type*} {S : Type*} {M : Type*} {N : Type*} {N' : Type*}
  [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
  [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
  [AddCommGroup N'] [Module R N'] [Module S N'] [IsScalarTower R S N']

/-- The commutator `m ↦ E (b • m) - b • E m` of an operator of order at most `1` with `b : S`,
as an `S`-linear map: its `S`-linearity is the definition of order at most `1`. -/
private def commutator (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) (b : S) :
    M →ₗ[S] N where
  toFun m := E (b • m) - b • E m
  map_add' x y := by simp [smul_add, sub_add_sub_comm]
  map_smul' g m := by simpa using hE b g m

/-- For an operator `E` of order at most `1`, the map `b ↦ (m ↦ E (b • m) - b • E m)` is an
`R`-derivation `S → Hom_S(M, N)`; the Leibniz rule is the order-`≤ 1` condition. -/
private def symbolDerivation (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) :
    Derivation R S (M →ₗ[S] N) where
  toFun := commutator E hE
  map_add' b b' := by
    ext m; simp [commutator, add_smul]; abel
  map_smul' r b := by
    ext m; simp [commutator, smul_assoc, smul_sub]
  map_one_eq_zero' := by
    ext m; simp [commutator]
  leibniz' b b' := by
    ext m
    have key := hE b b' m
    simp only [LinearMap.sub_apply, LinearMap.comp_apply, Algebra.lsmul_coe] at key
    simp only [commutator, LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply,
      LinearMap.smul_apply, mul_smul]
    rw [eq_add_of_sub_eq key]
    simp only [smul_sub, smul_smul]
    rw [mul_comm b' b]
    abel

/-- The *symbol* of an operator `E : M → N` of order at most `1`: the `S`-linear map
`Ω[S⁄R] ⊗[S] M → N` with `d b ⊗ₜ m ↦ E (b • m) - b • E m`. -/
private noncomputable def symbol (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) :
    Ω[S⁄R] ⊗[S] M →ₗ[S] N :=
  TensorProduct.lift (symbolDerivation E hE).liftKaehlerDifferential

@[local simp]
private lemma symbol_tmul_D (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) (b : S)
    (m : M) : symbol E hE (KaehlerDifferential.D R S b ⊗ₜ[S] m) = E (b • m) - b • E m := by
  simp [symbol, Derivation.liftKaehlerDifferential_comp_D, symbolDerivation, commutator]

/-- The symbol is natural: an `S`-linear `α` with `α ∘ D = E` carries the symbol of `D` to the
symbol of `E`. -/
private lemma symbol_comp {P : Type*} [AddCommGroup P] [Module R P] [Module S P]
    [IsScalarTower R S P] (D : M →ₗ[R] P) (hD : D.IsDifferentialOperatorOfOrderLE S 1)
    (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) (α : P →ₗ[S] N)
    (hα : ∀ m : M, α (D m) = E m) : symbol E hE = α ∘ₗ symbol D hD :=
  tensor_ext fun b m => by simp [hα]

/-- The universal property of `D`, asserted for test modules in one universe, extends to test
modules in any smaller universe, by passing through `ULift`. -/
private lemma existsUnique_comp_eq_of_ulift {P : Type*} [AddCommGroup P] [Module R P]
    [Module S P] {D : M →ₗ[R] P}
    (huniv : ∀ (N : Type (max x t)) [AddCommGroup N] [Module R N] [Module S N]
      [IsScalarTower R S N] (E : M →ₗ[R] N), E.IsDifferentialOperatorOfOrderLE S 1 →
      ∃! α : P →ₗ[S] N, ∀ m : M, α (D m) = E m)
    {N : Type x} [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    (E : M →ₗ[R] N) (hE : E.IsDifferentialOperatorOfOrderLE S 1) :
    ∃! α : P →ₗ[S] N, ∀ m : M, α (D m) = E m := by
  obtain ⟨α, hα, huq⟩ := huniv (ULift.{t} N)
    ((ULift.moduleEquiv (R := S)).symm.toLinearMap.restrictScalars R ∘ₗ E)
    (isDifferentialOperatorOfOrderLE_postcomp _ hE)
  refine ⟨ULift.moduleEquiv.toLinearMap ∘ₗ α, fun m => by simpa using congrArg ULift.down (hα m),
    fun β hβ => ?_⟩
  have := huq ((ULift.moduleEquiv (R := S)).symm.toLinearMap ∘ₗ β) fun m => by simp [hβ m]
  ext p
  simpa using congrArg ULift.down (LinearMap.congr_fun this p)

end Symbol

/-! ### The explicit model of the module of principal parts -/

section Jet

variable (R : Type*) (S : Type u) (M : Type v) [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module S M]

/-- The explicit model of `P¹_{S/R}(M)`: the group `Ω[S⁄R] ⊗[S] M × M` with the twisted
`S`-action `s • (η, m) = (s • η + d s ⊗ₜ m, s • m)`. -/
private def Jet : Type max u v := (Ω[S⁄R] ⊗[S] M) × M

variable {R S M}

@[instance_reducible]
private noncomputable def Jet.instAddCommGroup : AddCommGroup (Jet R S M) :=
  inferInstanceAs (AddCommGroup ((Ω[S⁄R] ⊗[S] M) × M))

attribute [local instance] Jet.instAddCommGroup

private lemma Jet.ext' {x y : Jet R S M} (h₁ : x.1 = y.1) (h₂ : x.2 = y.2) : x = y :=
  Prod.ext h₁ h₂

private lemma Jet.fst_add (x y : Jet R S M) : (x + y).1 = x.1 + y.1 := rfl

private lemma Jet.snd_add (x y : Jet R S M) : (x + y).2 = x.2 + y.2 := rfl

private lemma Jet.fst_sub (x y : Jet R S M) : (x - y).1 = x.1 - y.1 := rfl

private lemma Jet.snd_sub (x y : Jet R S M) : (x - y).2 = x.2 - y.2 := rfl

private lemma Jet.fst_zero : (0 : Jet R S M).1 = 0 := rfl

private lemma Jet.snd_zero : (0 : Jet R S M).2 = 0 := rfl

/-- The twisted `S`-action on the model: `s • (η, m) = (s • η + d s ⊗ₜ m, s • m)`. -/
private noncomputable def Jet.smul (s : S) (x : Jet R S M) : Jet R S M :=
  (s • x.1 + KaehlerDifferential.D R S s ⊗ₜ[S] x.2, s • x.2)

private lemma Jet.smul_fst (s : S) (x : Jet R S M) :
    (Jet.smul s x).1 = s • x.1 + KaehlerDifferential.D R S s ⊗ₜ[S] x.2 := rfl

private lemma Jet.smul_snd (s : S) (x : Jet R S M) : (Jet.smul s x).2 = s • x.2 := rfl

private lemma Jet.one_smul' (x : Jet R S M) : Jet.smul (1 : S) x = x :=
  Jet.ext'
    (by simp only [Jet.smul_fst, one_smul, Derivation.map_one_eq_zero, zero_tmul, add_zero])
    (by simp only [Jet.smul_snd, one_smul])

private lemma Jet.mul_smul' (s t : S) (x : Jet R S M) :
    Jet.smul (s * t) x = Jet.smul s (Jet.smul t x) :=
  Jet.ext'
    (by
      simp only [Jet.smul_fst, Jet.smul_snd, Derivation.leibniz, mul_smul, add_tmul,
        TensorProduct.smul_tmul', TensorProduct.smul_tmul, smul_add]
      abel)
    (by simp only [Jet.smul_snd, mul_smul])

private lemma Jet.smul_zero' (s : S) : Jet.smul s (0 : Jet R S M) = 0 :=
  Jet.ext'
    (by simp only [Jet.smul_fst, Jet.fst_zero, Jet.snd_zero, smul_zero, tmul_zero, add_zero])
    (by simp only [Jet.smul_snd, Jet.snd_zero, smul_zero])

private lemma Jet.smul_add' (s : S) (x y : Jet R S M) :
    Jet.smul s (x + y) = Jet.smul s x + Jet.smul s y :=
  Jet.ext'
    (by
      simp only [Jet.smul_fst, Jet.fst_add, Jet.snd_add, smul_add, tmul_add]
      abel)
    (by simp only [Jet.smul_snd, Jet.snd_add, smul_add])

private lemma Jet.add_smul' (s t : S) (x : Jet R S M) :
    Jet.smul (s + t) x = Jet.smul s x + Jet.smul t x :=
  Jet.ext'
    (by
      simp only [Jet.smul_fst, Jet.fst_add, map_add, add_smul, add_tmul]
      abel)
    (by simp only [Jet.smul_snd, Jet.snd_add, add_smul])

private lemma Jet.zero_smul' (x : Jet R S M) : Jet.smul (0 : S) x = 0 :=
  Jet.ext' (by simp only [Jet.smul_fst, Jet.fst_zero, zero_smul, map_zero, zero_tmul, add_zero])
    (by simp only [Jet.smul_snd, Jet.snd_zero, zero_smul])

@[instance_reducible]
private noncomputable def Jet.instModuleS : Module S (Jet R S M) where
  smul := Jet.smul
  one_smul := Jet.one_smul'
  mul_smul := Jet.mul_smul'
  smul_zero := Jet.smul_zero'
  smul_add := Jet.smul_add'
  add_smul := Jet.add_smul'
  zero_smul := Jet.zero_smul'

attribute [local instance] Jet.instModuleS

private lemma Jet.fst_smul (s : S) (x : Jet R S M) :
    (s • x).1 = s • x.1 + KaehlerDifferential.D R S s ⊗ₜ[S] x.2 := rfl

private lemma Jet.snd_smul (s : S) (x : Jet R S M) : (s • x).2 = s • x.2 := rfl

/-- The first map of the sequence of principal parts for the model: `x ↦ (-x, 0)`. -/
private noncomputable def Jet.inl : Ω[S⁄R] ⊗[S] M →ₗ[S] Jet R S M where
  toFun x := (-x, 0)
  map_add' x y :=
    Jet.ext' (by change -(x + y) = -x + -y; rw [neg_add]) (by change (0 : M) = 0 + 0; rw [add_zero])
  map_smul' s x :=
    Jet.ext'
      (by
        change -(s • x) = s • -x + KaehlerDifferential.D R S s ⊗ₜ[S] (0 : M)
        rw [tmul_zero, add_zero, smul_neg])
      (by change (0 : M) = s • (0 : M); rw [smul_zero])

private lemma Jet.inl_apply (x : Ω[S⁄R] ⊗[S] M) : Jet.inl (R := R) x = (-x, 0) := rfl

private lemma Jet.inl_injective : Function.Injective (Jet.inl (R := R) (S := S) (M := M)) := by
  intro x y h
  have h1 : -x = -y := congrArg Prod.fst h
  simpa using h1

end Jet

section JetOperator

variable {R : Type*} {S : Type u} {M : Type v} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]

attribute [local instance] Jet.instAddCommGroup Jet.instModuleS

@[instance_reducible]
private noncomputable def Jet.instModuleR : Module R (Jet R S M) :=
  inferInstanceAs (Module R ((Ω[S⁄R] ⊗[S] M) × M))

attribute [local instance] Jet.instModuleR

omit [IsScalarTower R S M] in
private lemma Jet.fst_smulR (r : R) (x : Jet R S M) : (r • x).1 = r • x.1 := rfl

omit [IsScalarTower R S M] in
private lemma Jet.snd_smulR (r : R) (x : Jet R S M) : (r • x).2 = r • x.2 := rfl

private theorem Jet.instIsScalarTower : IsScalarTower R S (Jet R S M) where
  smul_assoc r s x :=
    Jet.ext'
      (by
        simp only [Jet.fst_smul, Jet.fst_smulR, smul_assoc, Derivation.map_smul,
          TensorProduct.smul_tmul', smul_add])
      (by simp only [Jet.snd_smul, Jet.snd_smulR, smul_assoc])

attribute [local instance] Jet.instIsScalarTower

/-- The `R`-module `Jet R S M` is the product `Ω[S⁄R] ⊗[S] M × M`. -/
private noncomputable def Jet.equivProd : Jet R S M ≃ₗ[R] (Ω[S⁄R] ⊗[S] M) × M :=
  LinearEquiv.refl R _

/-- The universal differential operator of order at most `1` of the model: `m ↦ (0, m)`. -/
private noncomputable def Jet.D : M →ₗ[R] Jet R S M :=
  Jet.equivProd.symm.toLinearMap ∘ₗ LinearMap.inr R (Ω[S⁄R] ⊗[S] M) M

omit [IsScalarTower R S M] in
private lemma Jet.D_fst (m : M) : (Jet.D (R := R) (S := S) m).1 = 0 := rfl

omit [IsScalarTower R S M] in
private lemma Jet.D_snd (m : M) : (Jet.D (R := R) (S := S) m).2 = m := rfl

private lemma Jet.isDifferentialOperatorOfOrderLE :
    (Jet.D (R := R) (S := S) (M := M)).IsDifferentialOperatorOfOrderLE S 1 := by
  intro b g m
  refine Jet.ext' ?_ ?_
  · simp only [LinearMap.sub_apply, LinearMap.comp_apply, Algebra.lsmul_coe, Jet.fst_sub,
      Jet.snd_sub, Jet.fst_smul, Jet.snd_smul, Jet.D_fst, Jet.D_snd]
    simp
  · simp only [LinearMap.sub_apply, LinearMap.comp_apply, Algebra.lsmul_coe, Jet.snd_sub,
      Jet.snd_smul, Jet.D_snd]
    simp

/-- The symbol of the universal operator of the model is the injective map `x ↦ (-x, 0)`. -/
private lemma Jet.symbol_D :
    symbol (Jet.D (R := R) (S := S) (M := M)) Jet.isDifferentialOperatorOfOrderLE = Jet.inl :=
  tensor_ext fun b m =>
    Jet.ext'
      (by
        simp only [symbol_tmul_D, Jet.inl_apply, Jet.fst_sub, Jet.fst_smul, Jet.D_fst, Jet.D_snd]
        simp)
      (by
        simp only [symbol_tmul_D, Jet.inl_apply, Jet.snd_sub, Jet.snd_smul, Jet.D_snd]
        simp)

end JetOperator

/-! ### The sequence of principal parts -/

section Main

variable {R : Type*} {S : Type u} {M : Type v} {P : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
  [AddCommGroup P] [Module R P] [Module S P] [IsScalarTower R S P]

attribute [local instance] Jet.instAddCommGroup Jet.instModuleR Jet.instModuleS
  Jet.instIsScalarTower

/-- A universal differential operator of order at most `1` generates its target over `S`. -/
@[ega "IV 16.3.8" "Affine case with n = 1"]
private lemma span_range_eq_top (D : M →ₗ[R] P)
    (huniv : ∀ (N : Type (max u v w)) [AddCommGroup N] [Module R N] [Module S N]
      [IsScalarTower R S N] (E : M →ₗ[R] N), E.IsDifferentialOperatorOfOrderLE S 1 →
      ∃! α : P →ₗ[S] N, ∀ m : M, α (D m) = E m) :
    Submodule.span S (Set.range D) = ⊤ := by
  set T := Submodule.span S (Set.range D)
  have h := existsUnique_comp_eq_of_ulift huniv (0 : M →ₗ[R] P ⧸ T)
    (LinearMap.zero_isDifferentialOperatorOfOrderLE (S := S) 1)
  have h := h.unique (y₁ := T.mkQ) (y₂ := 0)
    (fun m => (Submodule.Quotient.mk_eq_zero T).mpr (Submodule.subset_span ⟨m, rfl⟩))
    (fun m => rfl)
  exact Submodule.eq_top_iff'.mpr fun p =>
    (Submodule.Quotient.mk_eq_zero T).mp (LinearMap.congr_fun h p)

omit [Algebra R S] [Module S M] [IsScalarTower R S M] [IsScalarTower R S P] in
/-- An `S`-linear map out of `P` is determined by its values on the image of `D`, in any
universe. -/
private lemma ext_of_comp_D {D : M →ₗ[R] P} (hspan : Submodule.span S (Set.range D) = ⊤)
    {N : Type*} [AddCommGroup N] [Module S N] {f g : P →ₗ[S] N} (h : ∀ m : M, f (D m) = g (D m)) :
    f = g :=
  LinearMap.ext_on hspan (by rintro x ⟨m, rfl⟩; exact h m)

public theorem solution {R : Type*} {S : Type u} {M : Type v} {P : Type w}
    [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
    [AddCommGroup P] [Module R P] [Module S P] [IsScalarTower R S P]
    (D : M →ₗ[R] P) (hD : D.IsDifferentialOperatorOfOrderLE S 1)
    (huniv : ∀ (N : Type (max u v w)) [AddCommGroup N] [Module R N] [Module S N]
      [IsScalarTower R S N] (E : M →ₗ[R] N), E.IsDifferentialOperatorOfOrderLE S 1 →
      ∃! α : P →ₗ[S] N, ∀ m : M, α (D m) = E m) :
    ∃ (ι : Ω[S⁄R] ⊗[S] M →ₗ[S] P) (π : P →ₗ[S] M),
      (∀ (b : S) (m : M), ι (KaehlerDifferential.D R S b ⊗ₜ[S] m) = D (b • m) - b • D m) ∧
      (∀ m : M, π (D m) = m) ∧
      Function.Injective ι ∧ Function.Exact ι π ∧ Function.Surjective π := by
  have hspan := span_range_eq_top D huniv
  -- the retraction `π`
  obtain ⟨π, hπ, -⟩ := existsUnique_comp_eq_of_ulift.{max u w, v, _, u, v, w} huniv
    ((LinearMap.id : M →ₗ[S] M).restrictScalars R)
    (isDifferentialOperatorOfOrderLE_succ (fun g m => by simp))
  refine ⟨symbol D hD, π, fun b m => symbol_tmul_D D hD b m, hπ, ?_, ?_, ?_⟩
  · -- injectivity, by transport from the explicit model
    obtain ⟨α, hα, -⟩ := existsUnique_comp_eq_of_ulift.{w, max u v, _, u, v, w} huniv Jet.D
      Jet.isDifferentialOperatorOfOrderLE
    have key : Jet.inl = α ∘ₗ symbol D hD := by
      rw [← Jet.symbol_D]
      exact symbol_comp D hD _ Jet.isDifferentialOperatorOfOrderLE α hα
    refine Function.Injective.of_comp (f := α) (g := symbol D hD) ?_
    rw [← LinearMap.coe_comp, ← key]
    exact Jet.inl_injective
  · -- exactness at `P`
    intro p
    constructor
    · intro hp
      obtain ⟨I, hI⟩ : ∃ I : Submodule S P, LinearMap.range (symbol D hD) = I := ⟨_, rfl⟩
      have hmem : ∀ (b : S) (m : M), D (b • m) - b • D m ∈ I := by
        intro b m
        exact hI ▸ ⟨KaehlerDifferential.D R S b ⊗ₜ[S] m, symbol_tmul_D D hD b m⟩
      have hDS : ∀ (b : S) (m : M), I.mkQ (D (b • m)) = b • I.mkQ (D m) := by
        intro b m
        have := (Submodule.Quotient.mk_eq_zero I).mpr (hmem b m)
        simpa [sub_eq_zero] using this
      let D' : M →ₗ[S] P ⧸ I :=
        { toFun := fun m => I.mkQ (D m)
          map_add' := fun x y => by simp
          map_smul' := fun b m => hDS b m }
      have hcomp : D' ∘ₗ π = I.mkQ := by
        refine ext_of_comp_D hspan fun m => ?_
        simp [D', hπ m]
      have hz : D' (π p) = 0 := by
        rw [hp, map_zero]
      have : I.mkQ p = 0 := by rw [← hcomp]; exact hz
      have hp' : p ∈ I := (Submodule.Quotient.mk_eq_zero I).mp this
      rw [← hI] at hp'
      exact hp'
    · rintro ⟨x, rfl⟩
      have : π ∘ₗ symbol D hD = 0 := by
        refine tensor_ext fun b m => ?_
        simp only [LinearMap.comp_apply, LinearMap.zero_apply, symbol_tmul_D, map_sub,
          map_smul, hπ]
        simp
      simpa using LinearMap.congr_fun this x
  · exact fun m => ⟨D m, hπ m⟩

end Main

end Stacks.PrincipalParts.ShortExactSequence

end

/-!
# The sequence of principal parts

Let `R → S` be a ring map and let `M` be an `S`-module. Call an `S`-module `P` together with an
`R`-linear map `D : M → P` a *universal differential operator of order at most `1`* on `M` when `D`
has order at most `1` relative to `R → S` (Definition 09CI) and every order-`≤ 1` operator
`E : M → N` into an `S`-module factors as `E = α ∘ D` for a unique `S`-linear `α : P → N`; that is,
when `α ↦ α ∘ D` is the canonical isomorphism `Hom_S(P, N) = Diff¹_{S/R}(M, N)` of Lemma 09CK, so
that `P` is a module of principal parts `P¹_{S/R}(M)` (Definition 09CL) and `D` is its universal
differential operator. Such a pair is unique up to unique isomorphism.

This file states that every such `P` sits in a short exact sequence
`0 → Ω[S⁄R] ⊗[S] M → P → M → 0`,
the *sequence of principal parts*. Its two maps are pinned by the source's own descriptions. For
`m : M` the map `b ↦ D (b • m) - b • D m` is an `R`-derivation `S → P`, so it is `b ↦ ι (d b ⊗ₜ m)`
for a unique `S`-linear `ι` on `Ω[S⁄R] ⊗[S] M`; and the inclusion
`Diff⁰_{S/R}(M, N) ⊆ Diff¹_{S/R}(M, N)` corresponds to the retraction `π` of `D`, the unique
`S`-linear map with `π ∘ D = id`.

## Main results

* `LinearMap.IsDifferentialOperatorOfOrderLE.exists_shortExact_principalParts`: the sequence of
  principal parts of an `S`-module `M`, with both of its maps characterised, is short exact.

## Implementation notes

The source builds `P¹_{S/R}(M)` first (Lemma 09CK, by generators and relations) and then states the
sequence for it. Here the sequence is stated for an *arbitrary* universal order-`≤ 1` differential
operator `D : M → P`, the universal property being taken as a hypothesis: that is what a module of
principal parts is, it determines `(P, D)` up to unique isomorphism, and the statement therefore
applies to every construction of `P¹_{S/R}(M)` rather than to one chosen model. The existence of a
universal `(P, D)` is Lemma 09CK and is a separate statement.

Both maps of the sequence are characterised, not merely asserted to exist: `Ω[S⁄R] ⊗[S] M` is
spanned over `S` by the elements `d b ⊗ₜ m`, and the universal property forces `P` to be generated
over `S` by the image of `D`, so the two displayed equations determine `ι` and `π` uniquely.
Functoriality in `M` is then formal: for `f : M →ₗ[S] M'` the map `φ : P → P'` obtained from
universality applied to `D' ∘ f` satisfies `φ ∘ ι = ι' ∘ (Ω[S⁄R] ⊗ f)` and `π' ∘ φ = f ∘ π`, both
being equalities of `S`-linear maps checked on those generators. Packaging this as naturality of a
functor `P¹_{S/R}(-)`, and the compatibility with a change of the ring map, is Remark 09CP.

The universal property is asked for test modules in `Type (max u v w)`, with `S : Type u`,
`M : Type v` and `P : Type w`. That universe contains `M`, `P`, the quotients of `P`, the module
`Ω[S⁄R] ⊗[S] M` and the free `S`-modules on `M`, which are the test objects the source's argument
uses (a free presentation of `M` and the snake lemma); a module of principal parts has the
universal property for test modules in every universe, so the hypothesis is available whenever
Lemma 09CK is.

Surjectivity of `π` is recorded separately although it is immediate from `π (D m) = m`, so that the
conclusion reads as the displayed short exact sequence.

Faithfulness. (1) No dead hypothesis: `hD` is what makes `D` an order-`≤ 1` operator and so what
makes the derivation `b ↦ D (b • m) - b • D m` and hence `ι` exist, while `huniv` is what makes `π`
exist and what forces exactness; dropping either leaves a statement that fails for, say, `D = 0`
into a large `P`. (2) The scalars and base are the source's: `D` and the test operators are
`R`-linear for the ring map `R → S`, order `≤ 1` is measured with `g` ranging over `S`, the
factorisations `α`, the maps `ι`, `π` and the tensor product `Ω[S⁄R] ⊗[S] M` are `S`-linear resp.
over `S`, and the `R`-actions are the restrictions along `R → S` by the scalar towers. (3) The two
canonical maps are pinned: `ι (d b ⊗ₜ m) = D (b • m) - b • D m` and `π (D m) = m`, which is the
content, exactness of an unspecified sequence being much weaker. (4) The instantiation is not
degenerate: for `M = S` one may take `P = Ω[S⁄R] × S` with `D b = (d b, b)` (Example 09CM), where
for `S = R[X]` the sequence is `0 → Ω[S⁄R] ⊗[S] S → Ω[S⁄R] × S → S → 0` with `Ω[S⁄R]` free of
rank `1`.

## References

* [Stacks 09CN](https://stacks.math.columbia.edu/tag/09CN), Lemma 10.133.6, in the section
  "Finite order differential operators" (Tag 09CH).
-/

@[expose] public section

open TensorProduct



namespace LinearMap.IsDifferentialOperatorOfOrderLE

/-- **Stacks 09CN.** Let `R → S` be a ring map and let `M` be an `S`-module. Let `D : M → P` be a
universal differential operator of order at most `1` on `M`, i.e. `D` has order at most `1` and
every order-`≤ 1` operator out of `M` factors uniquely through `D` by an `S`-linear map, so that
`P` is a module of principal parts `P¹_{S/R}(M)`. Then there is a short exact sequence
`0 → Ω[S⁄R] ⊗[S] M → P → M → 0`, the *sequence of principal parts*, whose first map sends
`d b ⊗ₜ m` to `D (b • m) - b • D m` and whose second map is the retraction of `D`. -/
@[stacks 09CN "Stated for an arbitrary universal order-≤ 1 differential operator `D : M → P` rather
than for a chosen construction of `P¹_{S/R}(M)`, whose existence is Lemma 09CK; both maps of the
sequence are pinned by equations, from which functoriality in `M` is formal. See the module
docstring.", sga "6 II AppII.1.2.4" "n = 1, ring setting"]
public theorem exists_shortExact_principalParts {R : Type*} {S : Type u} {M : Type v} {P : Type w}
    [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
    [AddCommGroup P] [Module R P] [Module S P] [IsScalarTower R S P]
    (D : M →ₗ[R] P) (hD : D.IsDifferentialOperatorOfOrderLE S 1)
    (huniv : ∀ (N : Type (max u v w)) [AddCommGroup N] [Module R N] [Module S N]
      [IsScalarTower R S N] (E : M →ₗ[R] N), E.IsDifferentialOperatorOfOrderLE S 1 →
      ∃! α : P →ₗ[S] N, ∀ m : M, α (D m) = E m) :
    ∃ (ι : Ω[S⁄R] ⊗[S] M →ₗ[S] P) (π : P →ₗ[S] M),
      (∀ (b : S) (m : M), ι (KaehlerDifferential.D R S b ⊗ₜ[S] m) = D (b • m) - b • D m) ∧
      (∀ m : M, π (D m) = m) ∧
      Function.Injective ι ∧ Function.Exact ι π ∧ Function.Surjective π :=
        by exact Stacks.PrincipalParts.ShortExactSequence.solution D hD huniv

end LinearMap.IsDifferentialOperatorOfOrderLE

end

/-!
# Principal parts as the diagonal neighbourhood of a module

Let `R → S` be a ring map, let `M` be an `S`-module, let `k : ℕ`, and let
`J = Ker(S ⊗[R] S → S)` be the kernel of the multiplication map, in Mathlib
`KaehlerDifferential.ideal R S`. This file proves that the `S`-module
`(S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)`, with `s` acting as multiplication by `s ⊗ₜ 1`, together with the
`R`-linear map `m ↦ class of 1 ⊗ₜ m`, is a module of principal parts of order `k` of `M`
(Definition 09CL); equivalently there is a canonical isomorphism
`Pᵏ_{S/R}(M) → (S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)` matching the universal differential operators.

The proof is the source's, organised around the bijection `LinearMap.liftBaseChangeEquiv` between
the `S`-linear maps `L : S ⊗[R] M → N` and the `R`-linear maps `M → N`, which sends `L` to `m ↦ L (1
⊗ₜ m)` and `D` to `g ⊗ₜ m ↦ g • D m`. Under it the commutator of `D` with `g ∈ S` corresponds to
composing `L` with multiplication by `1 ⊗ₜ g - g ⊗ₜ 1`, an `S`-linear endomorphism of `S ⊗[R] M`
because `S ⊗[R] S` is commutative (`Stacks.PrincipalParts.DiagonalQuotient.symm_comp_mulSMul`). The
source's displayed identity, that the `(k + 1)`-fold alternating sum attached to `g₀, …, g_k` is `∏ᵢ
(gᵢ ⊗ₜ 1 - 1 ⊗ₜ gᵢ)` applied to `1 ⊗ₜ m`, is thereby the statement that iterating `k + 1`
commutators of `D` corresponds to multiplying `L` by a product of `k + 1` generators of `J`, and
since `J` is generated by the elements `1 ⊗ₜ g - g ⊗ₜ 1` the two implications the source asks the
reader to check become one induction: `D` has order at most `k` if and only if `L` annihilates `J^{k
+ 1}(S ⊗[R] M)` (`Stacks.PrincipalParts.DiagonalQuotient.pow_ideal_le_ann_iff`, in the form used
`Stacks.PrincipalParts.DiagonalQuotient.pow_smul_top_le_ker_iff`). Applied to the quotient map it
says that `m ↦ class of 1 ⊗ₜ m` is a differential operator of order at most `k`, and applied to `L :
g ⊗ₜ m ↦ g • D m` for an operator `D` of order at most `k` it produces the factorisation of `D`
through the quotient, unique because `S ⊗[R] M` is generated over `S` by the elements `1 ⊗ₜ m`.

## Main results

* `Stacks.PrincipalParts.DiagonalQuotient.solution`: the statement of Lemma 0H90, that the quotient
  `(S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)` with `m ↦ class of 1 ⊗ₜ m` is a module of principal parts of
  order `k` of `M`.

## Implementation notes

Both implications of the source's proof are packaged as the single equivalence
`Stacks.PrincipalParts.DiagonalQuotient.pow_ideal_le_ann_iff`, an induction on `k` whose step is one
lemma, `Stacks.PrincipalParts.DiagonalQuotient.ideal_mul_le_ann_iff`: an ideal `A` satisfies `J · A
≤ ann L` exactly when `A` annihilates each of the maps `L ∘ (1 ⊗ₜ g - g ⊗ₜ 1) ·`. The source proves
the two implications separately, the second "by a computation similar to the one above".

The annihilator of `L` is used in the form of the ideal `Stacks.PrincipalParts.DiagonalQuotient.ann
L` of `S ⊗[R] S` of those `x` with `x • -` killed by `L`, which is an ideal precisely because `S
⊗[R] S` is commutative; this is what turns the source's "`J` is generated by elements of the form `g
⊗ 1 - 1 ⊗ g`" into a statement about ideal membership rather than about sums of products.
Multiplication by `x` is `Algebra.lsmul` for the `S`-algebra `S ⊗[R] S` acting on the `S`-module `S
⊗[R] M`, so that `ann L` inherits its ideal structure from `x ↦ x • -` being multiplicative and
additive.

Lemma 09CK is not used: the statement asserts of an explicit pair that it is a module of principal
parts, so the arrow of the source, obtained there from the universal property of `Pᵏ_{S/R}(M)`, is
here the isomorphism supplied by uniqueness of a representing pair.

## References

* [Stacks 0H90](https://stacks.math.columbia.edu/tag/0H90), Lemma 10.133.9, in the section
  "Finite order differential operators" (Tag 09CH). Definition 09CI is
  `LinearMap.IsDifferentialOperatorOfOrderLE` and Definition 09CL is
  `LinearMap.IsUniversalDifferentialOperatorOfOrderLE`.
* [Stacks 00RW](https://stacks.math.columbia.edu/tag/00RW) for the ideal `J`, which is
  `KaehlerDifferential.ideal`.
-/

@[expose] public section

open scoped TensorProduct



namespace Stacks.PrincipalParts.DiagonalQuotient

open LinearMap (commSMul commSMul_apply isDifferentialOperatorOfOrderLE_succ_iff
  isDifferentialOperatorOfOrderLE_zero_iff_commSMul_eq_zero)

/-! ### A product of ideals inside an ideal -/

section Colon

variable {T : Type*} [CommSemiring T]

/-- `I * A` lies in `K` exactly when `I` lies in the colon ideal `(K : A)`, so that such an
inclusion may be tested on generators of `I`. -/
private lemma mul_le_iff_le_colon (I A K : Ideal T) : I * A ≤ K ↔ I ≤ K.colon (A : Set T) := by
  rw [Ideal.mul_le]
  simp [Submodule.mem_colon, IsConcreteLE.le_iff, smul_eq_mul]

end Colon

/-! ### `S`-linear maps out of `S ⊗[R] M` and the operators they induce -/

section Tensor

variable {R : Type u} {S : Type v} {M : Type w} {N : Type t} [CommRing R] [CommRing S]
  [Algebra R S] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
  [IsScalarTower R S N]

/-- Two `S`-linear maps out of `S ⊗[R] M` agreeing on the elements `1 ⊗ₜ m` are equal, those
elements generating `S ⊗[R] M` over `S`: this is injectivity of
`LinearMap.liftBaseChangeEquiv.symm`. -/
private lemma ext_one_tmul {f g : (S ⊗[R] M) →ₗ[S] N}
    (h : ∀ m : M, f (1 ⊗ₜ[R] m) = g (1 ⊗ₜ[R] m)) : f = g :=
  (LinearMap.liftBaseChangeEquiv S).symm.injective (LinearMap.ext h)

/-- An `S`-linear map `L : S ⊗[R] M → N` is recovered from the operator `m ↦ L (1 ⊗ₜ m)` it
induces, as the `S`-linear extension of that operator. -/
private lemma liftBaseChange_comp_mk_one (L : (S ⊗[R] M) →ₗ[S] N) :
    (L.restrictScalars R ∘ₗ TensorProduct.mk R S M 1).liftBaseChange S = L :=
  (LinearMap.liftBaseChangeEquiv S).apply_symm_apply L

/-- An operator vanishes exactly when its `S`-linear extension does. -/
private lemma liftBaseChange_eq_zero_iff (D : M →ₗ[R] N) : D.liftBaseChange S = 0 ↔ D = 0 :=
  (LinearMap.liftBaseChangeEquiv S).map_eq_zero_iff

end Tensor

/-! ### Multiplication by an element of `S ⊗[R] S`, and the annihilator of a map -/

section Ann

variable {R : Type u} {S : Type v} {M : Type w} {N : Type t} [CommRing R] [CommRing S]
  [Algebra R S] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module S N]
  [Module (S ⊗[R] S) (S ⊗[R] M)] [IsScalarTower S (S ⊗[R] S) (S ⊗[R] M)]

/-- Multiplication by an element of `S ⊗[R] S` commutes with the action of `S` on `S ⊗[R] M`,
because `S ⊗[R] S` is commutative and `S` acts through it. -/
private lemma smulCommClass : SMulCommClass (S ⊗[R] S) S (S ⊗[R] M) where
  smul_comm x a e := by
    have key : ∀ e' : S ⊗[R] M, a • e' = (a • (1 : S ⊗[R] S)) • e' := fun e' => by
      rw [smul_assoc, one_smul]
    rw [key, key (x • e), ← mul_smul, ← mul_smul, mul_comm]

attribute [local instance] smulCommClass

/-- Multiplication on `S ⊗[R] M` by the elements of `S ⊗[R] S`, as an `S`-algebra map into the
`S`-linear endomorphisms: `Algebra.lsmul` for the `S`-algebra `S ⊗[R] S`, which is where the
`S`-linearity of multiplication by a fixed `x` comes from. -/
private noncomputable abbrev mulSMul : (S ⊗[R] S) →ₐ[S] Module.End S (S ⊗[R] M) :=
  Algebra.lsmul S S (S ⊗[R] M)

/-- The elements of `S ⊗[R] S` whose multiplication action on `S ⊗[R] M` is killed by `L`. This is
an ideal because `S ⊗[R] S` is commutative. -/
private def ann (L : (S ⊗[R] M) →ₗ[S] N) : Ideal (S ⊗[R] S) where
  carrier := {x | L ∘ₗ mulSMul x = 0}
  add_mem' {x y} hx hy := by
    change L ∘ₗ mulSMul (x + y) = 0
    rw [map_add, LinearMap.comp_add, hx, hy, add_zero]
  zero_mem' := by
    change L ∘ₗ mulSMul 0 = 0
    rw [map_zero, LinearMap.comp_zero]
  smul_mem' c x hx := by
    change L ∘ₗ mulSMul (c * x) = 0
    rw [mul_comm, map_mul, Module.End.mul_eq_comp, ← LinearMap.comp_assoc, hx,
      LinearMap.zero_comp]

private lemma mem_ann_iff {L : (S ⊗[R] M) →ₗ[S] N} {x : S ⊗[R] S} :
    x ∈ ann L ↔ L ∘ₗ mulSMul x = 0 := Iff.rfl

private lemma mem_ann_iff_forall {L : (S ⊗[R] M) →ₗ[S] N} {x : S ⊗[R] S} :
    x ∈ ann L ↔ ∀ e : S ⊗[R] M, L (x • e) = 0 := by
  simp [mem_ann_iff, LinearMap.ext_iff]

/-- Splitting off one factor: `y` annihilates `L` composed with multiplication by `x` exactly when
the product `x * y` annihilates `L`. -/
private lemma mem_ann_comp_mulSMul {L : (S ⊗[R] M) →ₗ[S] N} {x y : S ⊗[R] S} :
    y ∈ ann (L ∘ₗ mulSMul x) ↔ x * y ∈ ann L := by
  simp only [mem_ann_iff, map_mul, Module.End.mul_eq_comp, LinearMap.comp_assoc]

/-- An `S`-linear map `L` kills the submodule `I(S ⊗[R] M)` exactly when `I ≤ ann L`. -/
private lemma smul_top_le_ker_iff (I : Ideal (S ⊗[R] S)) (L : (S ⊗[R] M) →ₗ[S] N) :
    (I • (⊤ : Submodule (S ⊗[R] S) (S ⊗[R] M))).restrictScalars S ≤ LinearMap.ker L ↔
      I ≤ ann L := by
  constructor
  · intro h x hx
    refine mem_ann_iff_forall.2 fun e => h ?_
    rw [Submodule.restrictScalars_mem]
    exact Submodule.smul_mem_smul hx Submodule.mem_top
  · intro h z hz
    rw [Submodule.restrictScalars_mem] at hz
    refine Submodule.smul_induction_on hz (fun x hx e _ => mem_ann_iff_forall.1 (h hx) e)
      fun x y hx hy => ?_
    rw [LinearMap.mem_ker, map_add, LinearMap.mem_ker.1 hx, LinearMap.mem_ker.1 hy, add_zero]

/-- Membership of `J` in an ideal may be tested on the generators `1 ⊗ₜ g - g ⊗ₜ 1`. -/
private lemma ideal_le_iff (K : Ideal (S ⊗[R] S)) :
    KaehlerDifferential.ideal R S ≤ K ↔ ∀ g : S, (1 : S) ⊗ₜ[R] g - g ⊗ₜ[R] (1 : S) ∈ K := by
  rw [← KaehlerDifferential.span_range_eq_ideal R S, Ideal.span_le, Set.range_subset_iff]
  simp [SetLike.mem_coe]

/-- **One factor of `J` peeled off.** An ideal `A` satisfies `J · A ≤ ann L` exactly when `A`
annihilates each of the maps `L ∘ (1 ⊗ₜ g - g ⊗ₜ 1) · `. This is the induction step of
`Stacks.PrincipalParts.DiagonalQuotient.pow_ideal_le_ann_iff`, and it is where `J` being generated
by the elements `1 ⊗ₜ g - g ⊗ₜ 1` enters. -/
private lemma ideal_mul_le_ann_iff (A : Ideal (S ⊗[R] S)) (L : (S ⊗[R] M) →ₗ[S] N) :
    KaehlerDifferential.ideal R S * A ≤ ann L ↔
      ∀ g : S, A ≤ ann (L ∘ₗ mulSMul ((1 : S) ⊗ₜ[R] g - g ⊗ₜ[R] (1 : S))) := by
  rw [mul_le_iff_le_colon, ideal_le_iff]
  simp only [Submodule.mem_colon, IsConcreteLE.le_iff, SetLike.mem_coe, smul_eq_mul,
    mem_ann_comp_mulSMul]

end Ann

/-! ### Order at most `k` versus annihilating `J^{k + 1}` -/

section Key

variable {R : Type u} {S : Type v} {M : Type w} {N : Type t} [CommRing R] [CommRing S]
  [Algebra R S] [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
  [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
  [Module (S ⊗[R] S) (S ⊗[R] M)] [IsScalarTower S (S ⊗[R] S) (S ⊗[R] M)]
  (hsmul : ∀ (a b s : S) (m : M), (a ⊗ₜ[R] b) • (s ⊗ₜ[R] m) = (a * s) ⊗ₜ[R] (b • m))

attribute [local instance] smulCommClass

include hsmul

omit [IsScalarTower R S M] [IsScalarTower S (S ⊗[R] S) (S ⊗[R] M)] in
/-- The generator `1 ⊗ₜ g - g ⊗ₜ 1` of `J` acts on `1 ⊗ₜ m` by `1 ⊗ₜ (g • m) - g ⊗ₜ m`. -/
private lemma sub_smul_one_tmul (g : S) (m : M) :
    ((1 : S) ⊗ₜ[R] g - g ⊗ₜ[R] (1 : S)) • (1 ⊗ₜ[R] m : S ⊗[R] M)
      = 1 ⊗ₜ[R] (g • m) - g ⊗ₜ[R] m := by
  rw [sub_smul, hsmul, hsmul, one_mul, mul_one, one_smul]

/-- Taking the commutator of an operator `D` with `g` corresponds, on the `S`-linear extensions,
to composing with multiplication by the generator `1 ⊗ₜ g - g ⊗ₜ 1` of `J`. This is the source's
displayed identity for a single factor. -/
private lemma liftBaseChange_commSMul (D : M →ₗ[R] N) (g : S) :
    (commSMul D g).liftBaseChange S
      = D.liftBaseChange S ∘ₗ mulSMul ((1 : S) ⊗ₜ[R] g - g ⊗ₜ[R] (1 : S)) := by
  refine ext_one_tmul fun m => ?_
  change (commSMul D g).liftBaseChange S (1 ⊗ₜ[R] m)
      = D.liftBaseChange S (((1 : S) ⊗ₜ[R] g - g ⊗ₜ[R] (1 : S)) • (1 ⊗ₜ[R] m))
  rw [sub_smul_one_tmul hsmul, map_sub, LinearMap.liftBaseChange_one_tmul,
    LinearMap.liftBaseChange_one_tmul, LinearMap.liftBaseChange_tmul, commSMul_apply]

/-- **The key equivalence.** An `R`-linear map `D : M → N` is a differential operator of order at
most `n` relative to `R → S` if and only if its `S`-linear extension `g ⊗ₜ m ↦ g • D m` is
annihilated by `J^{n + 1}`, where `J = Ker(S ⊗[R] S → S)`.

This is the source's computation: the `(n + 1)`-fold alternating sum attached to `g₀, …, g_n` is
the product of the `n + 1` elements `gᵢ ⊗ₜ 1 - 1 ⊗ₜ gᵢ` acting on `1 ⊗ₜ m`, and `J` is generated
by those elements. Both implications of the source are this one induction, whose step is
`Stacks.PrincipalParts.DiagonalQuotient.ideal_mul_le_ann_iff`. -/
@[ega "IV 16.8.1" "special case",
  ega "IV 16.8.2",
  sga "3 VIIA 1.3" "Affine case",
  sga "3 VIIA 1.4.2" "d'' clause"]
private lemma pow_ideal_le_ann_iff (n : ℕ) (D : M →ₗ[R] N) :
    KaehlerDifferential.ideal R S ^ (n + 1) ≤ ann (D.liftBaseChange S) ↔
      D.IsDifferentialOperatorOfOrderLE S n := by
  induction n generalizing D with
  | zero =>
    rw [pow_one, ideal_le_iff, isDifferentialOperatorOfOrderLE_zero_iff_commSMul_eq_zero]
    exact forall_congr' fun g => by
      rw [mem_ann_iff, ← liftBaseChange_commSMul hsmul, liftBaseChange_eq_zero_iff]
  | succ n ih =>
    rw [pow_succ', ideal_mul_le_ann_iff, isDifferentialOperatorOfOrderLE_succ_iff]
    exact forall_congr' fun g => by rw [← liftBaseChange_commSMul hsmul, ih]

/-- The form in which the key equivalence is applied: the `S`-linear extension of `D` kills the
submodule `J^{k + 1}(S ⊗[R] M)` exactly when `D` is a differential operator of order at most
`k`. -/
private lemma pow_smul_top_le_ker_iff (k : ℕ) (D : M →ₗ[R] N) :
    ((KaehlerDifferential.ideal R S ^ (k + 1) •
        (⊤ : Submodule (S ⊗[R] S) (S ⊗[R] M))).restrictScalars S)
        ≤ LinearMap.ker (D.liftBaseChange S) ↔
      D.IsDifferentialOperatorOfOrderLE S k :=
  (smul_top_le_ker_iff _ _).trans (pow_ideal_le_ann_iff hsmul k D)

end Key

/-! ### Factorisation through a quotient of `S ⊗[R] M` -/

section LiftQ

variable {R : Type u} {S : Type v} {M : Type w} {N : Type t} [CommRing R] [CommRing S]
  [Algebra R S] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
  [IsScalarTower R S N]

/-- An `R`-linear map `D : M → N` whose `S`-linear extension to `S ⊗[R] M` vanishes on an
`S`-submodule `p` factors uniquely through `(S ⊗[R] M) ⧸ p`, compatibly with
`m ↦ class of 1 ⊗ₜ m`. Uniqueness holds because the classes of the elements `1 ⊗ₜ m` generate the
quotient over `S`. -/
private lemma existsUnique_comp_mkQ_one_tmul {p : Submodule S (S ⊗[R] M)} (D : M →ₗ[R] N)
    (h : p ≤ LinearMap.ker (D.liftBaseChange S)) :
    ∃! α : ((S ⊗[R] M) ⧸ p) →ₗ[S] N, ∀ m : M, α (p.mkQ (1 ⊗ₜ[R] m)) = D m := by
  have hlift : ∀ m : M, p.liftQ (D.liftBaseChange S) h (p.mkQ (1 ⊗ₜ[R] m)) = D m := fun m => by
    rw [Submodule.mkQ_apply, Submodule.liftQ_apply, LinearMap.liftBaseChange_one_tmul]
  refine ⟨p.liftQ (D.liftBaseChange S) h, hlift, fun α hα => ?_⟩
  refine Submodule.linearMap_qext _ (ext_one_tmul fun m => ?_)
  change α (p.mkQ (1 ⊗ₜ[R] m)) = p.liftQ (D.liftBaseChange S) h (p.mkQ (1 ⊗ₜ[R] m))
  rw [hα, hlift]

end LiftQ

/-! ### The lemma -/

section Main

variable {R : Type u} {S : Type v} {M : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]

/-- **Stacks 0H90.** Let `R → S` be a ring map, let `M` be an `S`-module, let `k : ℕ` and let
`J = Ker(S ⊗[R] S → S)` be the kernel of the multiplication map. Then the `S`-module
`(S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)`, with `s` acting as multiplication by `s ⊗ₜ 1`, together with
the `R`-linear map `m ↦ class of 1 ⊗ₜ m`, is a module of principal parts of order `k` of `M`. -/
public theorem solution [Module (S ⊗[R] S) (S ⊗[R] M)] [IsScalarTower S (S ⊗[R] S) (S ⊗[R] M)]
    (hsmul : ∀ (a b t : S) (m : M), (a ⊗ₜ[R] b) • (t ⊗ₜ[R] m) = (a * t) ⊗ₜ[R] (b • m)) (k : ℕ) :
    (((KaehlerDifferential.ideal R S ^ (k + 1) •
          (⊤ : Submodule (S ⊗[R] S) (S ⊗[R] M))).restrictScalars S).mkQ.restrictScalars R ∘ₗ
        TensorProduct.mk R S M 1).IsUniversalDifferentialOperatorOfOrderLE S k := by
  set p : Submodule S (S ⊗[R] M) :=
    (KaehlerDifferential.ideal R S ^ (k + 1) •
      (⊤ : Submodule (S ⊗[R] S) (S ⊗[R] M))).restrictScalars S with hp
  refine ⟨(pow_smul_top_le_ker_iff hsmul k _).mp ?_,
    fun N _ _ _ _ E hE => existsUnique_comp_mkQ_one_tmul E
      ((pow_smul_top_le_ker_iff hsmul k E).mpr hE)⟩
  rw [liftBaseChange_comp_mk_one]
  exact p.ker_mkQ.ge

end Main

end Stacks.PrincipalParts.DiagonalQuotient

end

/-!
# Principal parts as the diagonal neighbourhood of a module

Let `R → S` be a ring map, let `M` be an `S`-module and let `k : ℕ`. Let
`J = Ker(S ⊗[R] S → S)` be the kernel of the multiplication map, in Mathlib
`KaehlerDifferential.ideal R S`. The tensor product `S ⊗[R] M` is a module over `S ⊗[R] S`, by
`(a ⊗ₜ b) • (t ⊗ₜ m) = a t ⊗ₜ b • m`, and the result proved here is that the quotient
`(S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)`, an `S`-module through the left factor — that is, `s` acting as
multiplication by `s ⊗ₜ 1` — together with the `R`-linear map `m ↦ class of 1 ⊗ₜ m`, is a module
of principal parts of order `k` of `M` in the sense of Definition 09CL: the map is a differential
operator of order at most `k` relative to `R → S`, and every such operator out of `M` factors
uniquely `S`-linearly through it.

This is the source's assertion. The source displays a canonical isomorphism
`Pᵏ_{S/R}(M) → (S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)` carrying the universal differential operator of
order `k` to `m ↦ class of 1 ⊗ₜ m`; since a module of principal parts is unique up to unique
isomorphism, saying that the right hand side, with that map, *is* one is the same statement with
the isomorphism supplied by uniqueness rather than constructed, and it pins the map.

For `M = S` the quotient is the ring `(S ⊗[R] S)/J^{k + 1}` of the `k`-th order neighbourhood of
the diagonal, whose behaviour under a formally étale extension is Lemma 0H93.

## Main results

* `LinearMap.isUniversalDifferentialOperatorOfOrderLE_mkQ_comp_mk_one`: the class map
  `m ↦ class of 1 ⊗ₜ m` into `(S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)` is a universal differential
  operator of order at most `k` for `M` relative to `R → S`.

## Implementation notes

The conclusion is `LinearMap.IsUniversalDifferentialOperatorOfOrderLE` (Definition 09CL) applied
to the explicit map `Submodule.mkQ ∘ₗ TensorProduct.mk R S M 1`, rather than an `∃ e, …` for an
`S`-linear equivalence out of a chosen `Pᵏ_{S/R}(M)`. The two say the same thing and this form is
the sharper one: it identifies the pair (module, universal operator), from which the source's
isomorphism and its compatibility with the universal operators follow by uniqueness of a
representing pair, whereas an isomorphism asserted for one chosen construction would have to be
transported to every other. No term `Pᵏ_{S/R}(M)` occurs in this development, by the same choice.

The `(S ⊗[R] S)`-module structure on `S ⊗[R] M` is a hypothesis, pinned by `hsmul`, and not an
instance. It cannot be one: it restricts along the two factors to two different `Module S`
structures on `S ⊗[R] M`, multiplication in the left factor and the action through `M`, and it is
the first of these that Mathlib has as an instance. The hypothesis assumes nothing, because
`hsmul` determines the action: the elements `a ⊗ₜ b` generate `S ⊗[R] S` and the elements
`t ⊗ₜ m` generate `S ⊗[R] M` additively, so two module structures satisfying `hsmul` agree. It is
also satisfiable for every `R → S` and `M`: take `Module.compHom` along the `R`-algebra map
`S ⊗[R] S →ₐ[R] Module.End R (S ⊗[R] M)` that `Algebra.TensorProduct.lift` builds from
`Algebra.lsmul R R (S ⊗[R] M)` and `(Module.End.lTensorAlgHom R M S).comp (Algebra.lsmul R R M)`,
whose images commute. `IsScalarTower S (S ⊗[R] S) (S ⊗[R] M)` likewise follows from `hsmul`, and
is asked for so that `J^{k + 1} • ⊤`, an `S ⊗[R] S`-submodule, can be read as the `S`-submodule
`J^{k + 1}(S ⊗[R] M)` that the quotient is taken by.

Which of the two `S`-actions the target carries is part of the statement, not a convention: it is
the left-factor one, `s ⊗ₜ 1`, as the source says. For the other one the assertion is false as
soon as `k ≥ 1`, since `m ↦ class of 1 ⊗ₜ m` would then be `S`-linear, hence an operator of
order `0`.

The exponent is the source's `k + 1`, tied to the order `k` of the operators; unlike the exponent
in Lemma 0H93 it is not a free parameter.

The hypotheses are the weakest under which the statement can be read: `R`, `S` commutative rings
with `S` an `R`-algebra, as `J` requires, and `M` an `S`-module whose `R`-structure is the
restriction, by `IsScalarTower R S M`, as in Definition 09CI.

Faithfulness. (1) No dead hypothesis: `k` occurs both as the exponent and as the order bound, and
the action hypothesis and its tower are what make the quotient in the conclusion meaningful; no
finiteness, flatness or smoothness is assumed, as none is in the source. (2) The scalars and base
are the source's: `J` is the kernel of the multiplication map of `S ⊗[R] S` over `R`, the operator
`m ↦ class of 1 ⊗ₜ m` is `R`-linear and not `S`-linear, the factorisations are `S`-linear, and the
`S`-action on the target is through `s ⊗ₜ 1`; replacing `R` by `S` in the tensor product would
collapse the target to `M`. (3) The canonical map is pinned, not merely asserted to exist: the
universal operator is the explicit composite of `TensorProduct.mk R S M 1` with the quotient map,
which is the source's `m ↦ class of 1 ⊗ₜ m`, and the source's isomorphism is then the unique
`S`-linear map compatible with the two universal operators. (4) The instantiation is not
degenerate: the action hypothesis is satisfiable for every `R → S` and every `M`, by the witness
above, which was checked by compiling, and the conclusion depends on `k` — at `k = 0` the target
is `M` itself, `J(S ⊗[R] M)` being the kernel of `S ⊗[R] M → M`, and the operator is the
identity, whereas at `k = 1`, `R = ℤ` and `S = M = ℤ[X]`, it is an extension of `ℤ[X]` by
`Ω[ℤ[X]⁄ℤ]` through which `d/dX` factors.

## References

* [Stacks 0H90](https://stacks.math.columbia.edu/tag/0H90), Lemma 10.133.9, in the section
  "Finite order differential operators" (Tag 09CH). Definition 09CI is
  `LinearMap.IsDifferentialOperatorOfOrderLE`, Definition 09CL is
  `LinearMap.IsUniversalDifferentialOperatorOfOrderLE`, and existence of a module of principal
  parts is Lemma 09CK.
* [Stacks 00RW](https://stacks.math.columbia.edu/tag/00RW), `Ω[S⁄R] = J/J²`, whose ideal `J` is
  `KaehlerDifferential.ideal`.
-/

@[expose] public section

open scoped TensorProduct



namespace LinearMap

variable {R : Type u} {S : Type v} {M : Type w} [CommRing R] [CommRing S] [Algebra R S]
  [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]

/-- **Stacks 0H90.** Let `R → S` be a ring map, let `M` be an `S`-module, let `k : ℕ` and let
`J = Ker(S ⊗[R] S → S)` be the kernel of the multiplication map. Then the `S`-module
`(S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)`, with `s` acting as multiplication by `s ⊗ₜ 1`, together with
the `R`-linear map `m ↦ class of 1 ⊗ₜ m`, is a module of principal parts of order `k` of `M`:
that map is a differential operator of order at most `k` relative to `R → S` and every such
operator out of `M` factors uniquely `S`-linearly through it. Equivalently, there is a canonical
isomorphism `Pᵏ_{S/R}(M) → (S ⊗[R] M)/J^{k + 1}(S ⊗[R] M)` carrying the universal differential
operator of order `k` to `m ↦ class of 1 ⊗ₜ m`. -/
@[stacks 0H90 "Stated as: the quotient, with the map `m ↦ class of 1 ⊗ₜ m`, is a module of
principal parts of order `k` (Definition 09CL), which supplies the source's canonical isomorphism
by uniqueness of a representing pair and pins the map. The `S ⊗[R] S`-action on `S ⊗[R] M` is the
hypothesis `hsmul`, which determines it; it cannot be an instance, as it restricts to two
different `Module S (S ⊗[R] M)` structures. See the module docstring.",
  ega "IV 16.8.2" "factorization of D",
  sga "3 VIIA 1.4.1" "affine case",
  ega "IV 16.8.1" "special case"]
public theorem isUniversalDifferentialOperatorOfOrderLE_mkQ_comp_mk_one
    [Module (S ⊗[R] S) (S ⊗[R] M)] [IsScalarTower S (S ⊗[R] S) (S ⊗[R] M)]
    (hsmul : ∀ (a b t : S) (m : M), (a ⊗ₜ[R] b) • (t ⊗ₜ[R] m) = (a * t) ⊗ₜ[R] (b • m)) (k : ℕ) :
    (((KaehlerDifferential.ideal R S ^ (k + 1) •
          (⊤ : Submodule (S ⊗[R] S) (S ⊗[R] M))).restrictScalars S).mkQ.restrictScalars R ∘ₗ
        TensorProduct.mk R S M 1).IsUniversalDifferentialOperatorOfOrderLE S k :=
    by exact Stacks.PrincipalParts.DiagonalQuotient.solution hsmul k

end LinearMap

end
