module

public import Mathlib.Algebra.Ring.Hom.InjSurj
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.RingTheory.Finiteness.Nakayama
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.Ideal.Over
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Local rings of bounded residue degree over the points of a subring of a field

Let `R` be a commutative ring, `k` a field which is an `R`-algebra with `R → k` injective,
and `σ : A → k` an injective `R`-algebra map, so that `A` is a domain. Suppose `f ∈ R` and
`e₁, …, e_d ∈ A` are such that every `a ∈ A` satisfies `f ^ m • a ∈ R e₁ + ⋯ + R e_d` for some
`m`; in other words `A[1/f]` is generated by `d` elements as an `R[1/f]`-module.

Then for every maximal ideal `𝔪` of `R` with `f ∉ 𝔪` there is a maximal ideal `z` of `A` lying
over `𝔪` (by Nakayama's lemma: `𝔪 A ≠ A`), and the localization `O = A_z` is a local domain
with an injective `R`-algebra map `O → k` extending `σ`, whose maximal ideal lies over `𝔪` and
whose residue field `A / z` is spanned over `R / 𝔪` by the images of `e₁, …, e_d`, so it is a
finite extension of `R / 𝔪` of degree at most `d`.

## Main results

* `Ideal.map_ne_top_of_forall_pow_smul_mem_span`: `𝔪 A ≠ A`.
* `exists_isLocalRing_finrank_residueField_le`: the local ring `O` above.
* `Ideal.Quotient.finite_and_finrank_le_of_forall_pow_smul_mem_span` and
  `Ideal.isMaximal_of_liesOver_of_forall_pow_smul_mem_span`: more generally, for every prime
  `P` of `A` over `𝔪`, the domain `A / P` is spanned over `R / 𝔪` by the images of
  `e₁, …, e_d`, so it is a field of degree at most `d` over `R / 𝔪`.
-/

@[expose] public section

universe u

open IsLocalRing

/-- If `f ^ a • x` and `f ^ b • y` lie in a submodule `P`, then so does `f ^ (a + b) • (x + y)`. -/
theorem Submodule.pow_add_smul_add_mem {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (P : Submodule R M) (f : R) {x y : M} {a b : ℕ} (hx : f ^ a • x ∈ P) (hy : f ^ b • y ∈ P) :
    f ^ (a + b) • (x + y) ∈ P := by
  rw [smul_add, pow_add]
  refine P.add_mem ?_ ?_
  · rw [mul_comm, mul_smul]
    exact P.smul_mem _ hx
  · rw [mul_smul]
    exact P.smul_mem _ hy

/-- Let `σ : A → k` be an `R`-algebra map to a field with `R → k` injective, and let
`e : Fin d → A` be such that every `a ∈ A` has `f ^ m • a ∈ span R (range e)` for some `m`.
Then for every maximal ideal `𝔪` of `R` with `f ∉ 𝔪`, the extension `𝔪 A` is a proper ideal.
This is Nakayama's lemma applied to the finitely generated `R`-module `span R (range e)`. -/
theorem Ideal.map_ne_top_of_forall_pow_smul_mem_span {R A k : Type*} [CommRing R]
    [CommRing A] [Field k] [Algebra R A] [Algebra R k] (σ : A →ₐ[R] k)
    (hι : Function.Injective (algebraMap R k)) {f : R} {d : ℕ} (e : Fin d → A)
    (he : ∀ a : A, ∃ m : ℕ, f ^ m • a ∈ Submodule.span R (Set.range e))
    (𝔪 : Ideal R) [h𝔪 : 𝔪.IsMaximal] (hf : f ∉ 𝔪) : 𝔪.map (algebraMap R A) ≠ ⊤ := by
  set N := Submodule.span R (Set.range e)
  obtain ⟨g, i, hi, hgi⟩ := h𝔪.exists_inv hf
  have key : ∀ n ∈ N, ∀ M : ℕ, f ^ M • n ∈ 𝔪 • N → n ∈ 𝔪 • N := by
    intro n hn M hM
    have h1 : (g * f) ^ M - 1 ∈ 𝔪 := by
      have hgf : g * f = 1 - i := by rw [← hgi]; ring
      rw [hgf, ← Ideal.Quotient.eq_zero_iff_mem]
      simp [Ideal.Quotient.eq_zero_iff_mem.mpr hi]
    have hn' : n = g ^ M • (f ^ M • n) - ((g * f) ^ M - 1) • n := by
      rw [smul_smul, sub_smul, one_smul, mul_pow]
      abel
    rw [hn']
    exact Submodule.sub_mem _ (Submodule.smul_mem _ _ hM) (Submodule.smul_mem_smul h1 hn)
  intro htop
  have h1 : (1 : A) ∈ 𝔪 • (⊤ : Submodule R A) := by
    rw [Ideal.smul_top_eq_map, htop]
    trivial
  have hle : N ≤ 𝔪 • N := by
    intro n hn
    have hw : ∀ w ∈ 𝔪 • (⊤ : Submodule R A), ∃ M : ℕ, f ^ M • (w * n) ∈ 𝔪 • N := by
      intro w hw
      refine Submodule.smul_induction_on hw ?_ ?_
      · intro μ hμ a _
        obtain ⟨M, hM⟩ := he (a * n)
        exact ⟨M, by rw [smul_mul_assoc, smul_comm]; exact Submodule.smul_mem_smul hμ hM⟩
      · rintro x y ⟨a, ha⟩ ⟨b, hb⟩
        exact ⟨a + b, by rw [add_mul]; exact Submodule.pow_add_smul_add_mem _ _ ha hb⟩
    obtain ⟨M, hM⟩ := hw 1 h1
    rw [one_mul] at hM
    exact key n hn M hM
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul 𝔪 N
    (Submodule.fg_span (Set.finite_range e)) hle
  obtain ⟨m, hm⟩ := he 1
  have h0 := congrArg σ (hr _ hm)
  rw [map_zero, map_smul, map_smul, map_one, smul_smul, Algebra.smul_def, mul_one,
    ← (algebraMap R k).map_zero] at h0
  have hmem : r * f ^ m ∈ 𝔪 := hι h0 ▸ 𝔪.zero_mem
  rcases h𝔪.isPrime.mem_or_mem hmem with h | h
  · exact h𝔪.ne_top ((Ideal.eq_top_iff_one _).2 (by simpa using 𝔪.sub_mem h hr1))
  · exact hf (h𝔪.isPrime.mem_of_pow_mem _ h)

/-- Let `σ : A → k` be an injective `R`-algebra map to a field with `R → k` injective, and let
`e : Fin d → A` be such that every `a ∈ A` has `f ^ m • a ∈ span R (range e)` for some `m`.
Then for every maximal ideal `𝔪` of `R` with `f ∉ 𝔪` there is a local domain `O` with
`R`-algebra maps `β : A → O` and `γ : O → k`, `γ` injective and `γ ∘ β = σ`, whose maximal
ideal lies over `𝔪` and whose residue field is a finite extension of `R / 𝔪` of degree at
most `d`. Here `O` is the localization of `A` at a maximal ideal over `𝔪`. -/
theorem exists_isLocalRing_finrank_residueField_le {R A k : Type u} [CommRing R]
    [CommRing A] [Field k] [Algebra R A] [Algebra R k] (σ : A →ₐ[R] k)
    (hσ : Function.Injective σ) (hι : Function.Injective (algebraMap R k)) {f : R} {d : ℕ}
    (e : Fin d → A) (he : ∀ a : A, ∃ m : ℕ, f ^ m • a ∈ Submodule.span R (Set.range e))
    (𝔪 : Ideal R) [h𝔪 : 𝔪.IsMaximal] (hf : f ∉ 𝔪) :
    ∃ (O : Type u) (_ : CommRing O) (_ : IsLocalRing O) (_ : IsDomain O) (_ : Algebra R O)
      (β : A →ₐ[R] O) (γ : O →ₐ[R] k), Function.Injective γ ∧ γ.comp β = σ ∧
      (maximalIdeal O).comap (algebraMap R O) = 𝔪 ∧
      ∃ (_ : Algebra (R ⧸ 𝔪) (ResidueField O)),
        IsScalarTower R (R ⧸ 𝔪) (ResidueField O) ∧
        Module.Finite (R ⧸ 𝔪) (ResidueField O) ∧
        Module.finrank (R ⧸ 𝔪) (ResidueField O) ≤ d := by
  obtain ⟨z, hz, hzle⟩ := Ideal.exists_le_maximal _
    (Ideal.map_ne_top_of_forall_pow_smul_mem_span σ hι e he 𝔪 hf)
  have hcomap : z.comap (algebraMap R A) = 𝔪 :=
    (h𝔪.eq_of_le (Ideal.IsPrime.comap _).ne_top (Ideal.map_le_iff_le_comap.mp hzle)).symm
  have : IsDomain A := Function.Injective.isDomain σ.toRingHom hσ
  let O := Localization.AtPrime z
  have hunit : ∀ y : z.primeCompl, IsUnit (σ.toRingHom y) := by
    refine fun y => isUnit_iff_ne_zero.mpr fun h => y.2 ?_
    have : (y : A) = 0 := hσ (by rw [map_zero]; exact h)
    rw [this]
    exact z.zero_mem
  let γ₀ : O →+* k := IsLocalization.lift (M := z.primeCompl) hunit
  have hγ₀ : ∀ a, γ₀ (algebraMap A O a) = σ a := IsLocalization.lift_eq hunit
  let γ : O →ₐ[R] k :=
    { γ₀ with
      commutes' := fun r => by
        change γ₀ (algebraMap R O r) = _
        rw [IsScalarTower.algebraMap_apply R A O, hγ₀, σ.commutes] }
  have hinjA : Function.Injective (algebraMap A O) :=
    IsLocalization.injective O
      (le_nonZeroDivisors_of_noZeroDivisors fun h => Ideal.mem_primeCompl_iff.mp h z.zero_mem)
  have hγinj : Function.Injective γ := by
    change Function.Injective γ₀
    refine (IsLocalization.lift_injective_iff hunit).mpr fun x y => ?_
    exact hinjA.eq_iff.trans hσ.eq_iff.symm
  have : IsDomain O := Function.Injective.isDomain γ.toRingHom hγinj
  let β : A →ₐ[R] O := IsScalarTower.toAlgHom R A O
  have hγβ : γ.comp β = σ := AlgHom.ext hγ₀
  have hmax : (maximalIdeal O).comap (algebraMap R O) = 𝔪 := by
    have h := Localization.AtPrime.under_maximalIdeal (I := z)
    rw [Ideal.under_def] at h
    rw [IsScalarTower.algebraMap_eq R A O, ← Ideal.comap_comap, h, hcomap]
  refine ⟨O, inferInstance, inferInstance, inferInstance, inferInstance, β, γ, hγinj, hγβ,
    hmax, ?_⟩
  let F := ResidueField O
  have hker : ∀ x ∈ 𝔪, algebraMap R F x = 0 := by
    intro x hx
    rw [IsScalarTower.algebraMap_apply R O F, ResidueField.algebraMap_eq,
      residue_eq_zero_iff, ← Ideal.mem_comap, hmax]
    exact hx
  let alg : Algebra (R ⧸ 𝔪) F := (Ideal.Quotient.lift 𝔪 (algebraMap R F) hker).toAlgebra
  let := Ideal.Quotient.field 𝔪
  have htower : IsScalarTower R (R ⧸ 𝔪) F :=
    .of_algebraMap_eq fun r => (Ideal.Quotient.lift_mk 𝔪 (algebraMap R F) hker).symm
  have hsurj : Function.Surjective (algebraMap A F) := Ideal.algebraMap_residueField_surjective z
  let φ : A →ₗ[R] F := (IsScalarTower.toAlgHom R A F).toLinearMap
  let S := Submodule.span (R ⧸ 𝔪) (Set.range (φ ∘ e))
  have hspan : S = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨a, rfl⟩ := hsurj x
    obtain ⟨m, hm⟩ := he a
    have h1 : φ (f ^ m • a) ∈ S := by
      have h : φ (f ^ m • a) ∈ Submodule.span R (Set.range (φ ∘ e)) := by
        rw [Set.range_comp, ← Submodule.map_span]
        exact Submodule.mem_map_of_mem hm
      exact Submodule.span_le_restrictScalars R (R ⧸ 𝔪) _ h
    set c := Ideal.Quotient.mk 𝔪 f
    have hc : c ≠ 0 := fun h => hf (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have h2 : φ (f ^ m • a) = c ^ m • algebraMap A F a := by
      rw [LinearMap.map_smul, ← map_pow, ← algebraMap_smul (R ⧸ 𝔪) (f ^ m)]
      rfl
    have h3 : algebraMap A F a = c⁻¹ ^ m • (c ^ m • algebraMap A F a) := by
      rw [smul_smul, ← mul_pow, inv_mul_cancel₀ hc, one_pow, one_smul]
    rw [h3]
    exact S.smul_mem _ (h2 ▸ h1)
  refine ⟨alg, htower, Module.finite_def.mpr (hspan ▸ Submodule.fg_span (Set.finite_range _)),
    ?_⟩
  calc Module.finrank (R ⧸ 𝔪) F = Module.finrank (R ⧸ 𝔪) (⊤ : Submodule (R ⧸ 𝔪) F) :=
        (finrank_top (R ⧸ 𝔪) F).symm
    _ = Module.finrank (R ⧸ 𝔪) S := by rw [hspan]
    _ ≤ Fintype.card (Fin d) := finrank_range_le_card _
    _ = d := Fintype.card_fin d

/-- Let `e : Fin d → A` be such that every `a ∈ A` has `f ^ m • a ∈ span R (range e)` for some
`m`. For a maximal ideal `𝔪` of `R` with `f ∉ 𝔪` and an ideal `P` of `A` lying over `𝔪`, the
quotient `A ⧸ P` is spanned over `R ⧸ 𝔪` by the images of the `e i`: it is a finite
`R ⧸ 𝔪`-module of rank at most `d`. -/
theorem Ideal.Quotient.finite_and_finrank_le_of_forall_pow_smul_mem_span {R A : Type*}
    [CommRing R] [CommRing A] [Algebra R A] {f : R} {d : ℕ} (e : Fin d → A)
    (he : ∀ a : A, ∃ m : ℕ, f ^ m • a ∈ Submodule.span R (Set.range e))
    (𝔪 : Ideal R) [𝔪.IsMaximal] (P : Ideal A) [P.LiesOver 𝔪] (hf : f ∉ 𝔪) :
    Module.Finite (R ⧸ 𝔪) (A ⧸ P) ∧ Module.finrank (R ⧸ 𝔪) (A ⧸ P) ≤ d := by
  let := Ideal.Quotient.field 𝔪
  let F := A ⧸ P
  have hsurj : Function.Surjective (algebraMap A F) := Ideal.Quotient.mk_surjective
  let φ : A →ₗ[R] F := (IsScalarTower.toAlgHom R A F).toLinearMap
  let S := Submodule.span (R ⧸ 𝔪) (Set.range (φ ∘ e))
  have hspan : S = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨a, rfl⟩ := hsurj x
    obtain ⟨m, hm⟩ := he a
    have h1 : φ (f ^ m • a) ∈ S := by
      have h : φ (f ^ m • a) ∈ Submodule.span R (Set.range (φ ∘ e)) := by
        rw [Set.range_comp, ← Submodule.map_span]
        exact Submodule.mem_map_of_mem hm
      exact Submodule.span_le_restrictScalars R (R ⧸ 𝔪) _ h
    set c := Ideal.Quotient.mk 𝔪 f
    have hc : c ≠ 0 := fun h => hf (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have h2 : φ (f ^ m • a) = c ^ m • algebraMap A F a := by
      rw [LinearMap.map_smul, ← map_pow, ← algebraMap_smul (R ⧸ 𝔪) (f ^ m)]
      rfl
    have h3 : algebraMap A F a = c⁻¹ ^ m • (c ^ m • algebraMap A F a) := by
      rw [smul_smul, ← mul_pow, inv_mul_cancel₀ hc, one_pow, one_smul]
    rw [h3]
    exact S.smul_mem _ (h2 ▸ h1)
  refine ⟨Module.finite_def.mpr (hspan ▸ Submodule.fg_span (Set.finite_range _)), ?_⟩
  calc Module.finrank (R ⧸ 𝔪) F = Module.finrank (R ⧸ 𝔪) (⊤ : Submodule (R ⧸ 𝔪) F) :=
        (finrank_top (R ⧸ 𝔪) F).symm
    _ = Module.finrank (R ⧸ 𝔪) S := by rw [hspan]
    _ ≤ Fintype.card (Fin d) := finrank_range_le_card _
    _ = d := Fintype.card_fin d

/-- Let `e : Fin d → A` be such that every `a ∈ A` has `f ^ m • a ∈ span R (range e)` for some
`m`. A prime ideal `P` of `A` lying over a maximal ideal `𝔪` of `R` with `f ∉ 𝔪` is maximal:
`A ⧸ P` is a domain of finite dimension over the field `R ⧸ 𝔪`. -/
theorem Ideal.isMaximal_of_liesOver_of_forall_pow_smul_mem_span {R A : Type*}
    [CommRing R] [CommRing A] [Algebra R A] {f : R} {d : ℕ} (e : Fin d → A)
    (he : ∀ a : A, ∃ m : ℕ, f ^ m • a ∈ Submodule.span R (Set.range e))
    (𝔪 : Ideal R) [𝔪.IsMaximal] (P : Ideal A) [P.IsPrime] [P.LiesOver 𝔪] (hf : f ∉ 𝔪) :
    P.IsMaximal := by
  let := Ideal.Quotient.field 𝔪
  have := (Ideal.Quotient.finite_and_finrank_le_of_forall_pow_smul_mem_span e he 𝔪 P hf).1
  have : Algebra.IsIntegral (R ⧸ 𝔪) (A ⧸ P) := Algebra.IsIntegral.of_finite _ _
  exact Ideal.Quotient.maximal_of_isField P
    (isField_of_isIntegral_of_isField' (R := R ⧸ 𝔪) (Field.toIsField _))
