module

public import Mathlib.RingTheory.DedekindDomain.Dvr
public import Mathlib.RingTheory.DedekindDomain.Ideal.Basic
public import StacksFrontier.RingTheory.DedekindDomain.PrimeFactorization

/-!
# Equivalent characterizations of Dedekind domains

The Stacks project defines a Dedekind domain (tag 034W) as a domain in which every nonzero ideal
is a product of nonzero prime ideals, uniquely up to permutation; this is
`IsStacksDedekindDomain`, the conjunction of `IsDomain` and the factorization condition
`HasUniquePrimeIdealFactorization` (which on its own does not force `R` to be a domain). This
file shows that the definition agrees with Mathlib's `IsDedekindDomain` and proves the
characterizations of tag 034X.

## Main results

* `isStacksDedekindDomain_iff_isDedekindDomain`: the Stacks definition (tag 034W) agrees with
  Mathlib's `IsDedekindDomain`.

* `HasUniquePrimeIdealFactorization.isDedekindDomain`: a domain with unique factorization of
  nonzero ideals into nonzero primes is a Dedekind domain in the sense of Mathlib.
* `Stacks.isDedekindDomain_iff_isDiscreteValuationRing_atMaximal`: a domain is Dedekind if and
  only if it is Noetherian and its localizations at nonzero maximal ideals are DVRs.
* `Stacks.isDedekindDomain_iff_isIntegrallyClosed_ringKrullDim_le_one`: a domain is Dedekind if
  and only if it is Noetherian, integrally closed and of Krull dimension at most one.
* `Stacks.hasUniquePrimeIdealFactorization_tfae`: tag 034X.

## Implementation notes

The definition of tag 034W does not assume that `R` is Noetherian, so the implication
(1) ⇒ (2) is the substantial one. Following the Stacks project, for a nonzero prime `p` we pick
`x ∈ p` with `x ∉ p ^ 2` and show, by factoring the ideals `(x, y ^ 2)` for `y ∈ p`, that `x`
generates `p` after localizing at `p`. Factoring `(x)` then exhibits `p` as a factor of a nonzero
principal ideal, so `p` is invertible. Hence every nonzero fractional ideal is invertible, which
is Mathlib's `isDedekindDomain_iff_mul_inv_cancel`; this replaces the appeal to tags 09ME and
05KG.

## References

* [Stacks Project, Tag 034W](https://stacks.math.columbia.edu/tag/034W)
* [Stacks Project, Tag 034X](https://stacks.math.columbia.edu/tag/034X)
-/

@[expose] public section

open IsLocalRing FractionalIdeal
open scoped nonZeroDivisors

namespace HasUniquePrimeIdealFactorization

variable {R : Type*} [CommRing R]

/-- Let `p` be a prime ideal and `f` a multiset of ideals whose product lies in `p` and contains
an element `x ∉ p ^ 2`. Then exactly one member `P` of `f` lies in `p`, and the product
of `f` and `P` generate the same ideal of the localization at `p`. -/
theorem exists_map_prod_eq_map {p : Ideal R} [p.IsPrime] {f : Multiset (Ideal R)}
    (hle : f.prod ≤ p) {x : R} (hx : x ∈ f.prod) (hx2 : x ∉ p ^ 2) :
    ∃ P ∈ f, P ≤ p ∧ f.prod.map (algebraMap R (Localization.AtPrime p)) =
      P.map (algebraMap R (Localization.AtPrime p)) := by
  classical
  set S := Localization.AtPrime p
  set g := f.filter (· ≤ p)
  set h := f.filter (fun Q => ¬Q ≤ p)
  have hgh : f.prod = g.prod * h.prod := by rw [← Multiset.prod_add, Multiset.filter_add_not]
  -- An ideal not contained in `p` becomes the unit ideal after localizing at `p`.
  have hh : h.prod.map (algebraMap R S) = ⊤ := by
    rw [← Ideal.mapHom_apply, map_multiset_prod, ← Ideal.one_eq_top]
    refine Multiset.prod_eq_one fun J hJ => ?_
    obtain ⟨Q, hQ, rfl⟩ := Multiset.mem_map.mp hJ
    obtain ⟨q, hqQ, hqp⟩ := IsConcreteLE.not_le_iff_exists.mp (Multiset.mem_filter.mp hQ).2
    exact (Ideal.one_eq_top (R := S)).symm ▸ Ideal.eq_top_of_isUnit_mem _
      (Ideal.mem_map_of_mem _ hqQ) (IsLocalization.map_units S (⟨q, hqp⟩ : p.primeCompl))
  -- At least one member of `f` lies in `p`, and at most one since `x ∉ p ^ 2`.
  have hg0 : Multiset.card g ≠ 0 := by
    obtain ⟨Q, hQf, hQp⟩ := (Ideal.IsPrime.multiset_prod_le ‹_›).mp hle
    exact (Multiset.card_pos_iff_exists_mem.mpr ⟨Q, Multiset.mem_filter.mpr ⟨hQf, hQp⟩⟩).ne'
  have hg2 : ¬2 ≤ Multiset.card g := by
    intro h2
    have hle2 : f.prod ≤ p ^ 2 :=
      calc f.prod ≤ g.prod := hgh ▸ Ideal.mul_le_inf.trans inf_le_left
        _ ≤ p ^ Multiset.card g :=
          Multiset.prod_le_pow_card g p fun Q hQ => (Multiset.mem_filter.mp hQ).2
        _ ≤ p ^ 2 := Ideal.pow_le_pow_right h2
    exact hx2 (hle2 hx)
  obtain ⟨P, hP⟩ := (Multiset.card_eq_one (s := g)).mp (by omega)
  have hPg : P ∈ g := hP ▸ Multiset.mem_singleton_self P
  refine ⟨P, (Multiset.mem_filter.mp hPg).1, (Multiset.mem_filter.mp hPg).2, ?_⟩
  rw [hgh, Ideal.map_mul, hh, Ideal.mul_top, hP, Multiset.prod_singleton]

/-- The fractional ideal generated by a nonzero element of the fraction field is a unit. -/
private theorem isUnit_spanSingleton_of_ne_zero {K : Type*} [Field K] [Algebra R K]
    [IsFractionRing R K] {y : K} (hy : y ≠ 0) : IsUnit (spanSingleton R⁰ y) :=
  .of_mul_eq_one (spanSingleton R⁰ y⁻¹) <| by
    rw [← map_mul, mul_inv_cancel₀ hy, map_one]

variable (H : HasUniquePrimeIdealFactorization R)
include H

/-- Under unique factorization of nonzero ideals into nonzero primes, every nonzero prime `p`
divides a nonzero principal ideal: `p * J = (x)` with `x ≠ 0`. -/
theorem exists_mul_eq_span_singleton {p : Ideal R} [hp : p.IsPrime] (hp0 : p ≠ ⊥) :
    ∃ (x : R) (J : Ideal R), x ≠ 0 ∧ p * J = Ideal.span {x} := by
  classical
  set S := Localization.AtPrime p
  have hdisj : ∀ {P : Ideal R}, P ≤ p → Disjoint (p.primeCompl : Set R) P :=
    fun hP => Set.disjoint_left.mpr fun _ ha haP => ha (hP haP)
  -- `p ≠ p ^ 2`, by uniqueness of the factorization of `p`.
  have hsq : p ^ 2 ≠ p := by
    intro h
    have h1 := (H p hp0).unique (y₁ := {p}) (y₂ := {p, p})
      ⟨by simpa using ⟨hp, hp0⟩, by simp⟩ ⟨by simp [hp, hp0],
        by rw [Multiset.insert_eq_cons, Multiset.prod_cons, Multiset.prod_singleton, ← sq, h]⟩
    simpa using congrArg Multiset.card h1
  obtain ⟨x, hxp, hx2⟩ :=
    IsConcreteLE.exists_of_lt (lt_of_le_of_ne (Ideal.pow_le_self two_ne_zero) hsq)
  have hx0 : x ≠ 0 := by rintro rfl; exact hx2 (zero_mem _)
  -- For `y ∈ p`, the ideal `(x, y ^ 2)` is prime after localizing, so `y ∈ x S`.
  have key : p ≤ ((Ideal.span {x}).map (algebraMap R S)).comap (algebraMap R S) := by
    intro y hy
    set I := Ideal.span {x, y ^ 2}
    have hxI : x ∈ I := Ideal.subset_span (by simp)
    have hI0 : I ≠ ⊥ := fun h => hx0 (by simpa [h] using hxI)
    have hIp : I ≤ p := Ideal.span_le.mpr <| by
      simp [Set.insert_subset_iff, hxp, p.pow_mem_of_mem hy 2 two_pos]
    obtain ⟨f, ⟨hf, hfI⟩, -⟩ := H I hI0
    obtain ⟨P, hPf, hPp, hmap⟩ :=
      exists_map_prod_eq_map (hfI ▸ hIp) (hfI ▸ hxI) hx2
    rw [hfI] at hmap
    have hPS : (P.map (algebraMap R S)).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint p.primeCompl S P (hf P hPf).1 (hdisj hPp)
    have hy2 : algebraMap R S y ^ 2 ∈ P.map (algebraMap R S) := by
      rw [← hmap, ← map_pow]; exact Ideal.mem_map_of_mem _ (Ideal.subset_span (by simp))
    have hyI : algebraMap R S y ∈ I.map (algebraMap R S) := hmap ▸ hPS.mem_of_pow_mem 2 hy2
    rw [Ideal.map_span, Set.image_pair, Ideal.mem_span_pair, map_pow] at hyI
    obtain ⟨a, b, hab⟩ := hyI
    have hyM : algebraMap R S y ∈ maximalIdeal S :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff S p y).mpr hy
    obtain ⟨u, hu⟩ : IsUnit (1 - b * algebraMap R S y) :=
      isUnit_one_sub_self_of_mem_nonunits _ ((mem_maximalIdeal _).mp (Ideal.mul_mem_left _ b hyM))
    have hux : (u : S) * algebraMap R S y = a * algebraMap R S x := by
      rw [hu]; linear_combination -hab
    rw [Ideal.mem_comap, Ideal.map_span, Set.image_singleton, Ideal.mem_span_singleton']
    exact ⟨↑u⁻¹ * a, by rw [mul_assoc, ← hux, Units.inv_mul_cancel_left]⟩
  -- Factor `(x)`: its unique member inside `p` is `p` itself.
  obtain ⟨f, ⟨hf, hfx⟩, -⟩ := H (Ideal.span {x}) (by simpa using hx0)
  obtain ⟨P, hPf, hPp, hmap⟩ := exists_map_prod_eq_map
    (hfx ▸ Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxp))
    (hfx ▸ Ideal.mem_span_singleton_self x) hx2
  rw [hfx] at hmap
  have hPeq : P = p := by
    refine le_antisymm hPp ?_
    calc p ≤ (p.map (algebraMap R S)).comap (algebraMap R S) := Ideal.le_comap_map
      _ ≤ (P.map (algebraMap R S)).comap (algebraMap R S) :=
        Ideal.comap_mono (hmap ▸ Ideal.map_le_iff_le_comap.mpr key)
      _ = P := IsLocalization.under_map_of_isPrime_disjoint p.primeCompl S (hf P hPf).1 (hdisj hPp)
  exact ⟨x, (f.erase p).prod, hx0, by rw [← hfx, Multiset.prod_erase (hPeq ▸ hPf)]⟩

/-- Under unique factorization of nonzero ideals into nonzero primes, every nonzero ideal is
invertible as a fractional ideal. -/
theorem isUnit_coeIdeal {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K] {I : Ideal R}
    (hI : I ≠ ⊥) : IsUnit (I : FractionalIdeal R⁰ K) := by
  obtain ⟨f, ⟨hf, rfl⟩, -⟩ := H I hI
  have hcoe : ((f.prod : Ideal R) : FractionalIdeal R⁰ K) =
      (f.map fun P : Ideal R => (P : FractionalIdeal R⁰ K)).prod :=
    map_multiset_prod (coeIdealHom R⁰ K) f
  rw [hcoe, IsUnit.multisetProd_iff]
  intro J hJ
  obtain ⟨P, hP, rfl⟩ := Multiset.mem_map.mp hJ
  have := (hf P hP).1
  obtain ⟨x, J, hx, hJ⟩ := H.exists_mul_eq_span_singleton (hf P hP).2
  have hu := isUnit_spanSingleton_of_ne_zero (R := R) (y := algebraMap R K x) (by simpa using hx)
  rw [← coeIdeal_span_singleton, ← hJ, coeIdeal_mul] at hu
  exact isUnit_of_mul_isUnit_left hu

/-- **Stacks 034X, (1) ⇒ Mathlib**: a domain in which every nonzero ideal factors uniquely as a
product of nonzero prime ideals (tag 034W) is a Dedekind domain in the sense of Mathlib. -/
theorem isDedekindDomain [IsDomain R] : IsDedekindDomain R := by
  refine (isDedekindDomain_iff_mul_inv_cancel (K := FractionRing R)).mpr fun I hI => ?_
  rw [mul_inv_cancel_iff_isUnit (FractionRing R)]
  obtain ⟨a, J, ha, rfl⟩ := exists_eq_spanSingleton_mul I
  have hJ : J ≠ ⊥ := by rintro rfl; exact hI (by simp)
  exact (isUnit_spanSingleton_of_ne_zero (inv_ne_zero (by simpa using ha))).mul
    (H.isUnit_coeIdeal hJ)

end HasUniquePrimeIdealFactorization

/-- A ring is a Dedekind domain in the sense of the Stacks project (tag 034W) if and only if it is
a Dedekind domain in the sense of Mathlib. -/
theorem isStacksDedekindDomain_iff_isDedekindDomain (R : Type*) [CommRing R] :
    IsStacksDedekindDomain R ↔ IsDedekindDomain R :=
  ⟨fun ⟨_, H⟩ => H.isDedekindDomain,
    fun _ => ⟨inferInstance, hasUniquePrimeIdealFactorization_of_isDedekindDomain R⟩⟩

namespace Stacks

variable {R : Type*} [CommRing R] [IsDomain R]

/-- A domain is a Dedekind domain if and only if it is Noetherian and its localization at every
nonzero maximal ideal is a discrete valuation ring. Compare
`isDedekindDomain_iff_isDiscreteValuationRing_atPrime`, which uses all nonzero primes. -/
theorem isDedekindDomain_iff_isDiscreteValuationRing_atMaximal :
    IsDedekindDomain R ↔ IsNoetherianRing R ∧
      ∀ (m : Ideal R) [m.IsMaximal], m ≠ ⊥ → IsDiscreteValuationRing (Localization.AtPrime m) := by
  rw [isDedekindDomain_iff_isDiscreteValuationRing_atPrime]
  refine ⟨fun ⟨hN, h⟩ => ⟨hN, fun m _ hm => h m hm inferInstance⟩, fun ⟨hN, h⟩ => ⟨hN, ?_⟩⟩
  intro p hp hpp
  -- A nonzero prime `p` inside a maximal ideal `q` equals `q`, since `R_q` has one nonzero prime.
  obtain ⟨q, hq, hpq⟩ := p.exists_le_maximal hpp.ne_top
  have hq0 : q ≠ ⊥ := ne_bot_of_le_ne_bot hp hpq
  let f := (IsLocalization.orderIsoOfPrime q.primeCompl (Localization.AtPrime q)).symm
  let P := f ⟨p, hpp, hpq.disjoint_compl_left⟩
  let Q := f ⟨q, hq.isPrime, Set.disjoint_left.mpr fun _ a => a⟩
  have hinj : Function.Injective (algebraMap R (Localization.AtPrime q)) :=
    IsLocalization.injective (Localization.AtPrime q) q.primeCompl_le_nonZeroDivisors
  have hp1 : P.1 ≠ ⊥ := fun x => hp ((p.map_eq_bot_iff_of_injective hinj).mp x)
  have hq1 : Q.1 ≠ ⊥ := fun x => hq0 ((q.map_eq_bot_iff_of_injective hinj).mp x)
  obtain ⟨_, huq⟩ :=
    (IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime (Localization.AtPrime q)).mp (h q hq0)
  obtain rfl : p = q := Subtype.val_inj.mpr <| f.injective <|
    Subtype.val_inj.mp (huq.unique ⟨hp1, P.2⟩ ⟨hq1, Q.2⟩)
  exact h p hp

/-- A domain is a Dedekind domain if and only if it is Noetherian, integrally closed (normal) and
of Krull dimension at most one. -/
theorem isDedekindDomain_iff_isIntegrallyClosed_ringKrullDim_le_one :
    IsDedekindDomain R ↔ IsNoetherianRing R ∧ IsIntegrallyClosed R ∧ ringKrullDim R ≤ 1 := by
  have hdim : Ring.DimensionLEOne R ↔ ringKrullDim R ≤ 1 := by
    have e : Ring.KrullDimLE 1 R ↔ ringKrullDim R ≤ 1 := by
      exact_mod_cast Ring.krullDimLE_iff (R := R) (n := 1)
    rw [← e, Ring.krullDimLE_one_iff_of_noZeroDivisors]
    exact ⟨fun h _ hI hIp => h.maximalOfPrime hI hIp, fun h => ⟨fun hI hIp => h _ hI hIp⟩⟩
  refine ⟨fun _ => ⟨inferInstance, inferInstance, hdim.mp inferInstance⟩, ?_⟩
  rintro ⟨_, _, h⟩
  have := hdim.mpr h
  exact {}

/-- **Stacks 034X**. For a ring `R` the following are equivalent:
1. `R` is a Dedekind domain in the sense of tag 034W: a domain in which every nonzero ideal is a
   product of nonzero prime ideals, uniquely up to permutation;
2. `R` is a Noetherian domain and `R_𝔪` is a discrete valuation ring for every nonzero maximal
   ideal `𝔪`;
3. `R` is a Noetherian normal domain of Krull dimension at most one.

In (2) the domain hypothesis is an existential binder, so that it is available as an instance
when stating that the localizations are discrete valuation rings. -/
@[stacks 034X]
theorem hasUniquePrimeIdealFactorization_tfae (R : Type*) [CommRing R] :
    [IsDomain R ∧ HasUniquePrimeIdealFactorization R,
      ∃ _ : IsDomain R, IsNoetherianRing R ∧
        ∀ (m : Ideal R) [m.IsMaximal], m ≠ ⊥ → IsDiscreteValuationRing (Localization.AtPrime m),
      IsDomain R ∧ IsNoetherianRing R ∧ IsIntegrallyClosed R ∧ ringKrullDim R ≤ 1].TFAE := by
  tfae_have 1 → 2 := by
    rintro ⟨_, H⟩
    have := H.isDedekindDomain
    exact ⟨‹_›, isDedekindDomain_iff_isDiscreteValuationRing_atMaximal.mp this⟩
  tfae_have 2 → 3 := by
    rintro ⟨_, h⟩
    exact ⟨‹_›, isDedekindDomain_iff_isIntegrallyClosed_ringKrullDim_le_one.mp
      (isDedekindDomain_iff_isDiscreteValuationRing_atMaximal.mpr h)⟩
  tfae_have 3 → 1 := by
    rintro ⟨_, h⟩
    have := isDedekindDomain_iff_isIntegrallyClosed_ringKrullDim_le_one.mpr h
    exact ⟨‹_›, hasUniquePrimeIdealFactorization_of_isDedekindDomain R⟩
  tfae_finish

end Stacks
