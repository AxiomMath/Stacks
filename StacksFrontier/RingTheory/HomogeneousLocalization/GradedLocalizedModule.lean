module

public import Mathlib.Algebra.GradedMulAction
public import Mathlib.Algebra.Module.GradedModule
public import Mathlib.Algebra.Module.LocalizedModule.Basic
public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The grading of the localization of a graded module at a homogeneous element

Let `S = ⨁_{i ≥ 0} 𝒜 i` be a graded ring, let `M = ⨁_{j ∈ ℤ} 𝒨 j` be a `ℤ`-graded `S`-module, and
let `f ∈ 𝒜 d` be homogeneous. The localization `M_f = M[1/f]` is then `ℤ`-graded: the degree-`e`
part consists of the fractions `x / f ^ n` with `x` homogeneous of degree `e + n · d`, and

$$ M_f = \bigoplus_{e \in \mathbf{Z}} (M_f)_e. $$

Each graded piece is stable under the degree-zero subring `S₍f₎` of `S_f`, so this is a
decomposition of `S₍f₎`-modules.

## Main definitions

* `Stacks.GradedLocalization.gradedPiece` — the degree-`e` part of `M_f`, as an additive subgroup
  of `M_f`.

## Main results

* `Stacks.GradedLocalization.mem_gradedPiece_iff` — **the description of a graded piece**: for `f`
  homogeneous of degree `d`, the subgroup generated by the degree-`e` fractions is already the set
  of them, so an element of `M_f` has degree `e` exactly when it is `x / f ^ n` with
  `x ∈ 𝒨 (e + n · d)`. What makes this true is that two such fractions have a common denominator.
* `Stacks.GradedLocalization.smul_mem_gradedPiece` — every piece is stable under `S₍f₎`, so the
  grading is by `S₍f₎`-submodules.
* `Stacks.GradedLocalization.isInternal_gradedPiece` — **`M_f` is the direct sum of its graded
  pieces**; `gradedDecomposition` packages this as a `DirectSum.Decomposition`.
* `Stacks.GradedLocalization.gradedPiece_shift` — the degree-`a` part of `M_f` is the degree-zero
  part of the localization of the shifted module `M(a)`.

## Implementation notes

**Why additive subgroups.** The pieces are stated as `AddSubgroup (LocalizedModule.Away f M)`
rather than as submodules over the degree-zero ring `S₍f₎ = HomogeneousLocalization.Away 𝒜 f`.
`M_f` is an `S₍f₎`-module only by restriction of scalars along `S₍f₎ → S_f`, an instance that has
to be carried in the *type* of a submodule-valued family; an additive subgroup needs none of that,
and `DirectSum.Decomposition` is stated for any `SetLike` family with `AddSubmonoidClass`. The
stability under `S₍f₎` is `smul_mem_gradedPiece`.

**The degree of `f` is not part of the definition.** As in
`AlgebraicGeometry.GradedModuleDegreeZeroLocalization`, `gradedPiece` quantifies over the degree
`d` of `f` existentially, so that it is well formed for any `f` whatever. When `f` really is
homogeneous of degree `d` the description is independent of that choice, which is the content of
`mem_gradedPiece_iff`: a nonzero homogeneous element has a unique degree, and when `f ^ n = 0` the
localization is trivial.

**Independence.** That a vanishing finite sum of homogeneous elements has vanishing summands is
proved by clearing denominators: finitely many fractions of degrees `e₁, …, e_r` may be written
over one denominator `f ^ N` (`exists_common_denominator`), and their numerators are then
homogeneous of the *distinct* degrees `eₖ + N · d`, so the decomposition of `M` itself separates
them (`eq_zero_of_sum_eq_zero_of_homogeneous`). Multiplying by the further power of `f` that
witnesses the vanishing in the localization shifts all those degrees by the same amount, so they
stay distinct. This is why no hypothesis on `d` — in particular not `0 < d` — is needed anywhere
in this file.

## References

* [Stacks Project, Tag 01M6](https://stacks.math.columbia.edu/tag/01M6)
* [Stacks Project, Tag 01XT](https://stacks.math.columbia.edu/tag/01XT)
-/

@[expose] public section

universe u v w t

open DirectSum

namespace LocalizedModule

variable {S : Type u} [CommRing S] {M : Type v} [AddCommGroup M] [Module S M]

/-- A finite sum of fractions with a common denominator is the fraction of the sum. -/
theorem sum_mk {ι : Type*} {P : Submonoid S} (t : Finset ι) (g : ι → M) (s : P) :
    (∑ i ∈ t, LocalizedModule.mk (g i) s) = LocalizedModule.mk (∑ i ∈ t, g i) s := by
  classical
  induction t using Finset.induction with
  | empty => simp
  | insert a t ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, LocalizedModule.mk_add_mk, ← smul_add]
      exact LocalizedModule.mk_cancel_common_left s s _

/-- A fraction whose numerator is annihilated by a power of `f` vanishes in `M_f`. -/
theorem mk_eq_zero_of_pow_smul_eq_zero {f : S} {n k : ℕ} {x : M} (h : (f ^ k) • x = 0) :
    LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) = 0 := by
  rw [← LocalizedModule.zero_mk (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f)]
  refine LocalizedModule.mk_eq.2 ⟨⟨f ^ k, ⟨k, rfl⟩⟩, ?_⟩
  simp only [Submonoid.smul_def, smul_zero, smul_smul]
  rw [mul_comm, ← smul_smul, h, smul_zero]

/-- Conversely, the numerator of a vanishing fraction is annihilated by a power of `f`. -/
theorem exists_pow_smul_eq_zero_of_mk_eq_zero {f : S} {n : ℕ} {x : M}
    (h : LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) = 0) :
    ∃ k : ℕ, (f ^ k) • x = 0 := by
  rw [← LocalizedModule.zero_mk (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f)] at h
  obtain ⟨u, hu⟩ := LocalizedModule.mk_eq.1 h
  obtain ⟨j, hj⟩ := u.2
  refine ⟨j + n, ?_⟩
  have hu' : ((u : S)) • ((f ^ n) • x) = 0 := by
    simpa [Submonoid.smul_def] using hu
  rw [← hj] at hu'
  rwa [pow_add, mul_smul]

end LocalizedModule

/-- The grading action of a non-negative ring degree on an integer module degree: the degree of
`a • x` is `deg a + deg x`. -/
local instance instVAddNatIntGradedLocalizedModule : VAdd ℕ ℤ where
  vadd n z := (n : ℤ) + z

namespace Stacks.GradedLocalization

/-- The degree arithmetic of the grading: a numerator of degree `e + b · d` multiplied by an
element of degree `a · d` has degree `e + (a + b) · d`. -/
private theorem vadd_degree (a b d : ℕ) (e : ℤ) :
    (a • d : ℕ) +ᵥ (e + b • (d : ℤ)) = e + ((a + b) • (d : ℤ)) := by
  show ((a • d : ℕ) : ℤ) + (e + b • (d : ℤ)) = e + ((a + b) • (d : ℤ))
  simp only [nsmul_eq_mul]
  push_cast
  ring

/-! ### The graded pieces

The definition needs none of the grading axioms: it is a family of additive subgroups attached to
any two families `𝒜`, `𝒨` of subsets. -/

section Defs

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type t}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] (𝒜 : ℕ → σ) [SetLike τ M] (𝒨 : ℤ → τ)

/-- The degree-`e` part of the localization `M_f` of a `ℤ`-graded module `M` at a homogeneous
element `f`: the additive subgroup generated by the fractions `x / f ^ n` whose numerator is
homogeneous of degree `e + n · deg f`.

The degree of `f` is quantified existentially, so that the definition makes sense for any `f`;
`Stacks.GradedLocalization.mem_gradedPiece_iff` shows that for `f` homogeneous of degree `d` the
degree may always be taken to be `d`, and that the generated subgroup is already the set of such
fractions. For `e = 0` this is the degree-zero localization `M₍f₎`. -/
@[ega "II 2.2.1",
  ega "II 2.2.7" "special case",
  ega "II 2.5.1" "partial",
  ega "II 8.2.1" "partial",
  ega "III 2.1.2" "partial", sga "6 VI 2.3.2" "special case"]
def gradedPiece (f : S) (e : ℤ) : AddSubgroup (LocalizedModule.Away (R := S) f M) :=
  AddSubgroup.closure
    {z | ∃ (d n : ℕ) (_ : f ∈ 𝒜 d) (x : M),
      x ∈ 𝒨 (e + n • (d : ℤ)) ∧
        z = LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f)}

/-- A degree-`e` fraction lies in the degree-`e` part. -/
theorem mk_mem_gradedPiece {f : S} {d n : ℕ} (hf : f ∈ 𝒜 d) {e : ℤ} {x : M}
    (hx : x ∈ 𝒨 (e + n • (d : ℤ))) :
    LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) ∈ gradedPiece 𝒜 𝒨 f e :=
  AddSubgroup.subset_closure ⟨d, n, hf, x, hx, rfl⟩

/-- **Shifting the grading shifts the degree.** The degree-`e` part of `M_f` is the degree-`e - a`
part of the localization of the shifted module `M(a)`, whose grading is `i ↦ 𝒨 (i + a)`. In
particular `e = a` gives the degree-`a` part of `M_f` as the *degree-zero* part of the
localization of `M(a)`. -/
@[ega "II 8.2.7" "partial"]
theorem gradedPiece_shift (f : S) (a e : ℤ) :
    gradedPiece 𝒜 (fun i => 𝒨 (i + a)) f e = gradedPiece 𝒜 𝒨 f (e + a) := by
  refine congrArg AddSubgroup.closure (Set.ext fun z => ?_)
  have h (d n : ℕ) : e + n • (d : ℤ) + a = e + a + n • (d : ℤ) := by ring
  constructor <;> rintro ⟨d, n, hf, x, hx, rfl⟩ <;>
    exact ⟨d, n, hf, x, by simpa only [h] using hx, rfl⟩

/-- Multiplying a degree-`e + b · d` element by `f ^ a` gives a degree-`e + (a + b) · d` element. -/
private theorem pow_smul_mem [SetLike.GradedMonoid 𝒜] [SetLike.GradedSMul 𝒜 𝒨] {f : S}
    {d : ℕ} (hf : f ∈ 𝒜 d) (a b : ℕ) {e : ℤ} {x : M} (hx : x ∈ 𝒨 (e + b • (d : ℤ))) :
    (f ^ a) • x ∈ 𝒨 (e + (a + b) • (d : ℤ)) := by
  have h := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) (SetLike.pow_mem_graded a hf) hx
  rwa [vadd_degree a b d e] at h

end Defs

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type t}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒜 : ℕ → σ) [GradedRing 𝒜]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒜 𝒨]

omit [Decomposition 𝒨] in
/-- **The elements of a graded piece.** For `f` homogeneous of degree `d`, an element of `M_f` has
degree `e` exactly when it is a fraction `x / f ^ n` with `x` homogeneous of degree `e + n · d`:
the generating set of `gradedPiece` is already an additive subgroup, because two such fractions
can be put over a common denominator.

This generalizes `AlgebraicGeometry.ProjectiveSpectrum.mem_degreeZero_iff` from `e = 0` to every
degree. -/
theorem mem_gradedPiece_iff {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) (e : ℤ)
    (y : LocalizedModule.Away (R := S) f M) :
    y ∈ gradedPiece 𝒜 𝒨 f e ↔
      ∃ (n : ℕ) (x : M), x ∈ 𝒨 (e + n • (d : ℤ)) ∧
        y = LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) := by
  classical
  constructor
  · refine AddSubgroup.closure_induction
      (p := fun y _ => ∃ (n : ℕ) (x : M), x ∈ 𝒨 (e + n • (d : ℤ)) ∧
        y = LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f)) ?_ ?_ ?_ ?_
    · rintro y ⟨d', n, hf', x, hx, rfl⟩
      by_cases hfn : f ^ n = 0
      · have : Subsingleton (LocalizedModule.Away (R := S) f M) :=
          LocalizedModule.subsingleton (S := Submonoid.powers f) (M := M) (by
            rw [← hfn]; exact ⟨n, rfl⟩)
        exact ⟨0, 0, by simp, Subsingleton.elim _ _⟩
      · have hdeg : n • d' = n • d :=
          DirectSum.degree_eq_of_mem_mem 𝒜
            (SetLike.pow_mem_graded n hf') (SetLike.pow_mem_graded n hf) hfn
        have hdeg' : n • (d' : ℤ) = n • (d : ℤ) := by
          simpa [nsmul_eq_mul] using congrArg (fun k : ℕ => (k : ℤ)) hdeg
        exact ⟨n, x, hdeg' ▸ hx, rfl⟩
    · exact ⟨0, 0, by simp, by simp⟩
    · rintro y z - - ⟨n, x, hx, rfl⟩ ⟨m, w, hw, rfl⟩
      refine ⟨n + m, (f ^ m) • x + (f ^ n) • w, add_mem ?_ ?_, ?_⟩
      · rw [add_comm n m]
        exact pow_smul_mem 𝒜 𝒨 hf m n hx
      · exact pow_smul_mem 𝒜 𝒨 hf n m hw
      · rw [LocalizedModule.mk_add_mk]
        congr 1
        exact Subtype.ext (by simp [pow_add])
    · rintro y - ⟨n, x, hx, rfl⟩
      exact ⟨n, -x, neg_mem hx, (LocalizedModule.mk_neg (m := x)).symm⟩
  · rintro ⟨n, x, hx, rfl⟩
    exact mk_mem_gradedPiece 𝒜 𝒨 hf hx

omit [Decomposition 𝒨] in
/-- **Every graded piece is stable under the degree-zero subring `S₍f₎`.** Hence the grading of
`M_f` is a grading by `S₍f₎`-submodules; with `isInternal_gradedPiece` this is the decomposition
of `M_f` as an `S₍f₎`-module. -/
@[ega "II 2.2.7" "partial"]
theorem smul_mem_gradedPiece {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) (e : ℤ)
    (a : HomogeneousLocalization.Away 𝒜 f) {y : LocalizedModule.Away (R := S) f M}
    (hy : y ∈ gradedPiece 𝒜 𝒨 f e) : a.val • y ∈ gradedPiece 𝒜 𝒨 f e := by
  obtain ⟨n, x, hx, rfl⟩ := (mem_gradedPiece_iff 𝒜 𝒨 hf e y).1 hy
  obtain ⟨m, b, hb, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf a
  rw [HomogeneousLocalization.Away.val_mk, LocalizedModule.mk_smul_mk]
  have hdeg : b • x ∈ 𝒨 (e + (m + n) • (d : ℤ)) := by
    have h := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := 𝒨) hb hx
    rwa [vadd_degree m n d e] at h
  have hden : (⟨f ^ m, ⟨m, rfl⟩⟩ : Submonoid.powers f) * ⟨f ^ n, ⟨n, rfl⟩⟩ =
      (⟨f ^ (m + n), ⟨m + n, rfl⟩⟩ : Submonoid.powers f) := Subtype.ext (by simp [pow_add])
  rw [hden]
  exact mk_mem_gradedPiece 𝒜 𝒨 hf hdeg

/-! ### The direct sum decomposition -/

omit [AddSubgroupClass τ M] [Decomposition 𝒨] in
/-- **Raising the denominator of a homogeneous fraction.** A degree-`e` fraction over `f ^ n` is
also a degree-`e` fraction over `f ^ N` for every `N ≥ n`, with numerator multiplied by
`f ^ (N - n)`. -/
theorem exists_eq_mk_of_le {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) {e : ℤ} {n N : ℕ} (hn : n ≤ N)
    {x : M} (hx : x ∈ 𝒨 (e + n • (d : ℤ))) :
    ∃ x' : M, x' ∈ 𝒨 (e + N • (d : ℤ)) ∧
      LocalizedModule.mk x (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) =
        LocalizedModule.mk x' (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f) := by
  refine ⟨(f ^ (N - n)) • x, ?_, ?_⟩
  · simpa only [Nat.sub_add_cancel hn] using pow_smul_mem 𝒜 𝒨 hf (N - n) n hx
  · refine LocalizedModule.mk_eq.2 ⟨1, ?_⟩
    simp only [Submonoid.smul_def, one_smul, smul_smul, ← pow_add]
    rw [Nat.add_sub_cancel' hn]

omit [Decomposition 𝒨] in
/-- **A finite family of homogeneous elements has a common denominator.** Finitely many
homogeneous elements of `M_f`, of any degrees, may be written as fractions over a single power
`f ^ N`. -/
theorem exists_common_denominator {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) (t : Finset ℤ)
    (y : ℤ → LocalizedModule.Away (R := S) f M) (hy : ∀ e ∈ t, y e ∈ gradedPiece 𝒜 𝒨 f e) :
    ∃ N : ℕ, ∀ e ∈ t, ∃ x : M, x ∈ 𝒨 (e + N • (d : ℤ)) ∧
      y e = LocalizedModule.mk x (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f) := by
  classical
  induction t using Finset.induction with
  | empty => exact ⟨0, fun e he => absurd he (Finset.notMem_empty e)⟩
  | insert a t ha ih =>
      obtain ⟨N, hN⟩ := ih fun e he => hy e (Finset.mem_insert_of_mem he)
      obtain ⟨n, x, hx, hxa⟩ :=
        (mem_gradedPiece_iff 𝒜 𝒨 hf a (y a)).1 (hy a (Finset.mem_insert_self a t))
      refine ⟨max N n, fun e he => ?_⟩
      rcases Finset.mem_insert.1 he with rfl | he
      · obtain ⟨x', hx', hmk⟩ := exists_eq_mk_of_le 𝒜 𝒨 hf (le_max_right N n) hx
        exact ⟨x', hx', hxa.trans hmk⟩
      · obtain ⟨x₀, hx₀, hmk₀⟩ := hN e he
        obtain ⟨x', hx', hmk⟩ := exists_eq_mk_of_le 𝒜 𝒨 hf (le_max_left N n) hx₀
        exact ⟨x', hx', hmk₀.trans hmk⟩

/-- **A vanishing finite sum of homogeneous elements of distinct degrees has vanishing
summands**, read off from the decomposition of `M`. -/
theorem eq_zero_of_sum_eq_zero_of_homogeneous {ι : Type*} (t : Finset ι) (g : ι → ℤ)
    (hg : Set.InjOn g t) (w : ι → M) (hw : ∀ i ∈ t, w i ∈ 𝒨 (g i))
    (hsum : (∑ i ∈ t, w i) = 0) {i₀ : ι} (hi₀ : i₀ ∈ t) : w i₀ = 0 := by
  classical
  have hdec : (∑ i ∈ t, (decompose 𝒨) (w i)) = 0 := by
    have h : (∑ i ∈ t, (DirectSum.decomposeAddEquiv 𝒨) (w i)) = 0 := by
      rw [← map_sum, hsum, map_zero]
    simpa only [DirectSum.decomposeAddEquiv_apply] using h
  have happ : (∑ i ∈ t, ((decompose 𝒨) (w i)) (g i₀)) = 0 := by
    have h := congrArg (DFinsupp.evalAddMonoidHom (β := fun i : ℤ => ↥(𝒨 i)) (g i₀)) hdec
    rwa [map_sum, map_zero] at h
  have hsingle : ∀ j ∈ t, j ≠ i₀ → ((decompose 𝒨) (w j)) (g i₀) = 0 := by
    intro j hj hji
    rw [DirectSum.decompose_of_mem 𝒨 (hw j hj)]
    exact DirectSum.of_eq_of_ne _ _ _ fun h => hji (hg hi₀ hj h).symm
  rw [Finset.sum_eq_single_of_mem i₀ hi₀ hsingle,
    DirectSum.decompose_of_mem 𝒨 (hw i₀ hi₀), DirectSum.of_eq_same] at happ
  simpa using congrArg (fun v : 𝒨 (g i₀) => (v : M)) happ

/-- **Independence of the graded pieces of `M_f`.** A vanishing finite sum of homogeneous elements
of distinct degrees in the localization has vanishing summands. -/
theorem eq_zero_of_sum_eq_zero {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) (t : Finset ℤ)
    (y : ℤ → LocalizedModule.Away (R := S) f M) (hy : ∀ e ∈ t, y e ∈ gradedPiece 𝒜 𝒨 f e)
    (hsum : (∑ e ∈ t, y e) = 0) {e₀ : ℤ} (he₀ : e₀ ∈ t) : y e₀ = 0 := by
  classical
  obtain ⟨N, hN⟩ := exists_common_denominator 𝒜 𝒨 hf t y hy
  have hall : ∀ e : ℤ, ∃ u : M, e ∈ t → (u ∈ 𝒨 (e + N • (d : ℤ)) ∧
      y e = LocalizedModule.mk u (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f)) := by
    intro e
    by_cases he : e ∈ t
    · obtain ⟨u, hu, hmk⟩ := hN e he
      exact ⟨u, fun _ => ⟨hu, hmk⟩⟩
    · exact ⟨0, fun h => absurd h he⟩
  choose z hz using hall
  have hzmem : ∀ e ∈ t, z e ∈ 𝒨 (e + N • (d : ℤ)) := fun e he => (hz e he).1
  have hzmk : ∀ e ∈ t, y e =
      LocalizedModule.mk (z e) (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f) :=
    fun e he => (hz e he).2
  have hsum' : LocalizedModule.mk (∑ e ∈ t, z e)
      (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f) = 0 := by
    rwa [← LocalizedModule.sum_mk, ← Finset.sum_congr rfl hzmk]
  obtain ⟨k, hk⟩ := LocalizedModule.exists_pow_smul_eq_zero_of_mk_eq_zero hsum'
  have hzero : (f ^ k) • z e₀ = 0 := by
    refine eq_zero_of_sum_eq_zero_of_homogeneous 𝒨 t (fun e => e + (k + N) • (d : ℤ))
      (fun a _ b _ h => add_right_cancel h) (fun e => (f ^ k) • z e) (fun e' he' => ?_) ?_ he₀
    · exact pow_smul_mem 𝒜 𝒨 hf k N (hzmem e' he')
    · rw [← Finset.smul_sum, hk]
  rw [hzmk e₀ he₀]
  exact LocalizedModule.mk_eq_zero_of_pow_smul_eq_zero hzero

/-- **`M_f` is the direct sum of its graded pieces.** For `f` homogeneous of degree `d`, the
localization of a `ℤ`-graded module at `f` is the internal direct sum of the additive subgroups
`gradedPiece 𝒜 𝒨 f e`, `e ∈ ℤ`. -/
theorem isInternal_gradedPiece {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) :
    DirectSum.IsInternal (gradedPiece 𝒜 𝒨 f) := by
  classical
  have hval : ∀ ξ : DirectSum ℤ fun e => ↥(gradedPiece 𝒜 𝒨 f e),
      (DirectSum.coeAddMonoidHom (gradedPiece 𝒜 𝒨 f)) ξ =
        ∑ e ∈ DFinsupp.support ξ, ((ξ e : LocalizedModule.Away (R := S) f M)) := fun ξ => by
    conv_lhs => rw [← DirectSum.sum_support_of ξ]
    rw [map_sum]
    exact Finset.sum_congr rfl fun e _ => DirectSum.coeAddMonoidHom_of _ e (ξ e)
  constructor
  · rw [injective_iff_map_eq_zero]
    intro ξ hξ
    refine DFinsupp.ext fun e => ?_
    by_cases he : e ∈ DFinsupp.support ξ
    · refine Subtype.ext (eq_zero_of_sum_eq_zero 𝒜 𝒨 hf (DFinsupp.support ξ)
        (fun e => ((ξ e : LocalizedModule.Away (R := S) f M)))
        (fun e _ => (ξ e).2) ?_ he)
      rwa [← hval ξ]
    · exact DFinsupp.notMem_support_iff.1 he
  · refine LocalizedModule.induction_on ?_
    intro x s
    obtain ⟨n, hn⟩ := s.2
    obtain rfl : s = (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) := Subtype.ext hn.symm
    have hmem (j : ℤ) : LocalizedModule.mk (((decompose 𝒨 x) j : M))
        (⟨f ^ n, ⟨n, rfl⟩⟩ : Submonoid.powers f) ∈ gradedPiece 𝒜 𝒨 f (j - n • (d : ℤ)) :=
      mk_mem_gradedPiece 𝒜 𝒨 hf (by rw [sub_add_cancel]; exact ((decompose 𝒨 x) j).2)
    refine ⟨∑ j ∈ DFinsupp.support (decompose 𝒨 x),
      DirectSum.of _ (j - n • (d : ℤ)) ⟨_, hmem j⟩, ?_⟩
    rw [map_sum, Finset.sum_congr rfl fun j _ =>
      DirectSum.coeAddMonoidHom_of (gradedPiece 𝒜 𝒨 f) (j - n • (d : ℤ)) ⟨_, hmem j⟩,
      LocalizedModule.sum_mk, DirectSum.sum_support_decompose 𝒨 x]

/-- The `ℤ`-grading of `M_f`, as a `DirectSum.Decomposition`. -/
@[reducible] noncomputable def gradedDecomposition {f : S} {d : ℕ} (hf : f ∈ 𝒜 d) :
    DirectSum.Decomposition (gradedPiece 𝒜 𝒨 f) :=
  (isInternal_gradedPiece 𝒜 𝒨 hf).chooseDecomposition _

end Stacks.GradedLocalization

