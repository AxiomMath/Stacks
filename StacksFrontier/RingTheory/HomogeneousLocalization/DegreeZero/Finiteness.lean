/-!
# Finiteness of the degree-zero localizations

If the graded `R`-algebra `S` is of finite type over `R` and `f ∈ S_d` is homogeneous with
`d ≥ 1`, then `S_(f)` is of finite type over `R` (`homogeneousLocalization_away_finiteType`), and
for a finite graded `S`-module `M` the degree-zero localization `M_(f)` is a finite
`S_(f)`-module (`moduleLocalization_away_finite`), Stacks Tag 07Z2.
-/

@[expose] public section

open DirectSum

attribute [local instance] instVAddNatInt

section MainStatements

variable {R S M : Type*}
variable [CommRing R] [CommRing S] [Algebra R S]
variable [AddCommGroup M] [Module R M] [Module S M] [IsScalarTower R S M]
variable (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜]
variable (ℳ : ℤ → Submodule R M) [DirectSum.Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ]
variable (f : S) (d : ℕ)

/-- **Tag 07Z2, part 1.**
Let `S` be a graded `R`-algebra of finite type over `R`, and let `f ∈ S_d` be
homogeneous with `d ≥ 1`.  Then the degree-`0` localization `S_(f)` is of finite
type over `R` (a finitely generated `R`-algebra). -/
@[stacks 07Z2 "(1)"]
theorem homogeneousLocalization_away_finiteType (hf : f ∈ 𝒜 d) [Algebra.FiniteType R S] :
    Algebra.FiniteType R (SLoc 𝒜 f) := by
  -- The structure map of `SLoc 𝒜 f` is the composite `R → 𝒜 0 → S_(f)`
  -- (`HomogeneousLocalization.algebraMap_eq_fromZeroRingHom_comp`).  We factor it:
  --   • `R → 𝒜 0` is of finite type      (`gradeZero_finiteType`, the key sub-lemma);
  --   • `𝒜 0 → S_(f)` is of finite type   (Mathlib `HomogeneousLocalization.Away.finiteType`,
  --     which needs `Algebra.FiniteType (𝒜 0) S`, obtained from `Algebra.FiniteType R S`
  --     by restricting scalars along the tower `R → 𝒜 0 → S`);
  -- and conclude by `RingHom.FiniteType.comp`.
  have hgz : Algebra.FiniteType R (𝒜 0) := gradeZero_finiteType 𝒜
  have : Algebra.FiniteType (𝒜 0) S := Algebra.FiniteType.of_restrictScalars_finiteType R (𝒜 0) S
  have hRA0 : (algebraMap R (𝒜 0)).FiniteType := RingHom.finiteType_algebraMap.mpr hgz
  have hA0Away : (algebraMap (𝒜 0) (HomogeneousLocalization.Away 𝒜 f)).FiniteType :=
    HomogeneousLocalization.Away.finiteType f d hf
  rw [← RingHom.finiteType_algebraMap,
    HomogeneousLocalization.algebraMap_eq_fromZeroRingHom_comp,
    ← HomogeneousLocalization.algebraMap_eq]
  exact RingHom.FiniteType.comp hA0Away hRA0

/-!
### `M_(f)` is finitely generated as an `S_(f)`-submodule of `M_f`

*Informal proof.*  By hypothesis `M` is a finite graded `S`-module, so
it is generated as an `S`-module by finitely many **homogeneous** elements
`x₁, …, x_m`, say `xⱼ ∈ ℳ (eⱼ)` (we may take the generators homogeneous, by
replacing each generator by its finitely many homogeneous components, using the
decomposition `DirectSum.Decomposition ℳ`).  Likewise `S` is a finitely
generated `R`-algebra, generated by finitely many homogeneous elements
`g₁, …, gₙ` with `gᵢ ∈ 𝒜 δᵢ`.

A generic element of `M_(f)` is, by the correctness characterisation
`mem_MLoc_iff`, a degree-`0` fraction `y / f^N` with `y ∈ ℳ (N·d)` and `N ≥ 0`.
Write `y = Σⱼ sⱼ · xⱼ` with `sⱼ ∈ S`; projecting onto the homogeneous component
of degree `N·d` we may assume each `sⱼ` homogeneous of degree `N·d − eⱼ`, hence a
homogeneous polynomial in the `gᵢ`: an `R`-combination of monomials
`g₁^{a₁} ⋯ gₙ^{aₙ}` with `Σᵢ aᵢ δᵢ = N·d − eⱼ`.  Thus `y / f^N` is an
`S_(f)`-combination (indeed an `R`-combination times degree-`0` fractions) of the
fractions `g₁^{a₁} ⋯ gₙ^{aₙ} · xⱼ / f^N`.

**Exponent reduction.**  Whenever some `aᵢ ≥ d`, the degree-`0` element
`gᵢ^{d} / f^{δᵢ} ∈ S_(f)` can be factored out of the fraction, lowering `aᵢ` by
`d` while staying inside `M_(f)` (this uses `deg f = d`, i.e. `hf : f ∈ 𝒜 d`, so
that the resulting numerator stays in the correct graded piece, and `hd : 1 ≤ d`
so the denominators add up).  Iterating, every generator can be rewritten as an
`S_(f)`-multiple of one with all `aᵢ < d`.  Consequently `M_(f)` is generated as
an `S_(f)`-module by the **finite** set
`{ g₁^{a₁} ⋯ gₙ^{aₙ} · xⱼ / f^{Nⱼ(a)} : 1 ≤ j ≤ m, 0 ≤ aᵢ < d }`,
where for each tuple `(a, j)` the exponent `Nⱼ(a)` is the unique `N` with
`N·d = Σᵢ aᵢ δᵢ + eⱼ` (when such an `N ≥ 0` exists; otherwise that fraction is
omitted).  This is a finite set, so `M_(f)` is finitely generated.

This is the module analogue of Mathlib's ring-level statements
`HomogeneousLocalization.Away.span_mk_prod_pow_eq_top` and
`adjoin_mk_prod_pow_eq_top`.

#### Low-level algebra of the degree-`0` fractions `deg0frac`

The next four lemmas record the basic behaviour of `deg0frac f n x = x / f^n` under
addition, the zero numerator, scalar multiplication by a homogeneous `Away.mk`,
and scalar multiplication by a degree-`0` ring element.  They are the building
blocks of the exponent-reduction argument for `MLoc_fg`.
-/

/-- `deg0frac` is additive in the numerator (common denominator `f^n`). -/
theorem deg0frac_add (n : ℕ) (x y : M) :
    deg0frac f n (x + y) = deg0frac f n x + deg0frac f n y := by
  unfold deg0frac
  rw [LocalizedModule.mk_add_mk, LocalizedModule.mk_eq]
  refine ⟨1, ?_⟩
  have hsmul : ∀ (s : Submonoid.powers f) (m : M), s • m = (s : S) • m := fun _ _ => rfl
  simp only [hsmul, Submonoid.coe_mul, Submonoid.coe_one, smul_add, ← mul_smul]

/-- `deg0frac` of the zero numerator is `0`. -/
theorem deg0frac_zero (n : ℕ) : deg0frac f n (0 : M) = 0 := by
  unfold deg0frac; rw [LocalizedModule.zero_mk]

set_option linter.unusedSectionVars false in
/-- Multiplying `deg0frac f n x` by the degree-`0` fraction `a / f^m`
(`a ∈ 𝒜 (m·d)`, packaged as `Away.mk 𝒜 hf m a ha`) gives `(a • x) / f^(m+n)`.
This is the key step in factoring monomials out of a fraction. -/
theorem scalar_deg0frac {m : ℕ} {a : S} (hf : f ∈ 𝒜 d) (ha : a ∈ 𝒜 (m • d)) (n : ℕ) (x : M) :
    (HomogeneousLocalization.Away.mk 𝒜 hf m a ha) • deg0frac f n x =
      deg0frac f (m + n) (a • x) := by
  have hsmul :
    (HomogeneousLocalization.Away.mk 𝒜 hf m a ha) • deg0frac f n x =
      (HomogeneousLocalization.Away.mk 𝒜 hf m a ha).val • deg0frac f n x :=
    rfl
  rw [hsmul, HomogeneousLocalization.Away.val_mk]
  unfold deg0frac
  rw [LocalizedModule.mk_smul_mk]
  congr 1
  apply Subtype.ext
  show f ^ m * f ^ n = f ^ (m + n)
  rw [pow_add]

/-- A degree-`0` ring scalar `r : 𝒜 0` acting on the numerator equals the
`S_(f)`-scalar `algebraMap (𝒜 0) (Away 𝒜 f) r` acting on the fraction. -/
theorem deg0frac_smul_grade0 (hf : f ∈ 𝒜 d) (r : 𝒜 0) (n : ℕ) (x : M) :
    deg0frac f n ((r : S) • x) =
      (algebraMap (𝒜 0) (HomogeneousLocalization.Away 𝒜 f) r) • deg0frac f n x := by
  have hr : (r : S) ∈ 𝒜 (0 • d) := by simp
  have := scalar_deg0frac 𝒜 f d hf hr n x
  rw [zero_add] at this
  rw [← this]
  congr 1
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.algebraMap_eq]
  show Localization.mk (r : S) ⟨f ^ 0, _⟩ = HomogeneousLocalization.val _
  simp only [HomogeneousLocalization.fromZeroRingHom]
  congr 1; apply Subtype.ext; simp

set_option linter.unusedSectionVars false in
/-- A finite graded `S`-module `M` is generated as an `S`-module by finitely many
*homogeneous* elements.

*Proof sketch.*  Take any finite `S`-generating set `s`.  Replace each `x ∈ s` by
the finite family of its homogeneous components `(DirectSum.decompose ℳ x i : M)`,
`i ∈ (decompose ℳ x).support`.  The union `J` of all these components is finite,
each member is homogeneous (lies in `ℳ i`), and `x = Σ_i (decompose ℳ x i)` lies
in the `S`-span of `J`; hence `span S J ⊇ span S s = ⊤`. -/
theorem MLoc_homog_module_gens [Module.Finite S M] :
    ∃ (J : Finset M), (∀ x ∈ J, ∃ n : ℤ, x ∈ ℳ n) ∧ Submodule.span S (↑J : Set M) = ⊤ := by
  classical
  -- A finite S-spanning set `s`.
  obtain ⟨s, hs⟩ := (Module.finite_def.mp ‹Module.Finite S M›)
  -- Replace each generator by its homogeneous components.
  refine
    ⟨s.biUnion
        (fun x =>
          (DirectSum.decompose ℳ x).support.image (fun i => (DirectSum.decompose ℳ x i : M))),
      ?_, ?_⟩
  · -- each member is homogeneous
    intro y hy
    rw [Finset.mem_biUnion] at hy
    obtain ⟨x, _, hy⟩ := hy
    rw [Finset.mem_image] at hy
    obtain ⟨i, _, rfl⟩ := hy
    exact ⟨i, SetLike.coe_mem _⟩
  · -- spanning
    rw [eq_top_iff, ← hs, Submodule.span_le]
    intro x hx
    rw [SetLike.mem_coe, ← DirectSum.sum_support_decompose ℳ x]
    refine Submodule.sum_mem _ (fun i hi => ?_)
    apply Submodule.subset_span
    rw [Finset.coe_biUnion]
    refine Set.mem_iUnion₂.mpr ⟨x, hx, ?_⟩
    rw [Finset.coe_image]
    exact Set.mem_image_of_mem _ hi

/-- The candidate finite generating set for `M_(f)`, built from homogeneous module
generators `x j ∈ ℳ (e j)` and homogeneous ring generators `v i ∈ 𝒜 (δ i)`: the
degree-`0` fractions `((∏ i, v i ^ a i) • x j) / f ^ N` whose denominator exponent
satisfies `N < B'`, whose exponent `a i` vanishes at every degree-`0` generator
(`δ i = 0`), and whose numerator degree `∑ i, a i * δ i + e j` equals `N * d`. -/
def Gset {ιJ ι' : Type*} [Fintype ι'] (B' : ℕ) (x : ιJ → M) (e : ιJ → ℤ) (v : ι' → S)
    (δ : ι' → ℕ) : Set (LocalizedModule (Submonoid.powers f) M) :=
  {y |
    ∃ (j : ιJ) (a : ι' → ℕ) (N : ℕ),
      (∀ i, δ i = 0 → a i = 0) ∧
        N < B' ∧
        ((∑ i, a i • δ i : ℕ) : ℤ) + e j = (N • d : ℕ) ∧ y = deg0frac f N ((∏ i, v i ^ a i) • x j)}

/-- Lowering the exponent `a i₀` by `k` splits `k * w i₀` off the weighted sum `∑ i, a i * w i`. -/
private theorem sum_mul_eq_mul_add_sum_update {ι : Type*} [Fintype ι] [DecidableEq ι]
    (a w : ι → ℕ) (i₀ : ι) (k : ℕ) (hk : k ≤ a i₀) :
    ∑ i, a i * w i = k * w i₀ + ∑ i, Function.update a i₀ (a i₀ - k) i * w i := by
  have h : ∑ i ∈ Finset.univ.erase i₀, Function.update a i₀ (a i₀ - k) i * w i =
      ∑ i ∈ Finset.univ.erase i₀, a i * w i :=
    Finset.sum_congr rfl fun i hi => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hi)]
  rw [← Finset.add_sum_erase _ (fun i => a i * w i) (Finset.mem_univ i₀),
    ← Finset.add_sum_erase _ (fun i => Function.update a i₀ (a i₀ - k) i * w i)
      (Finset.mem_univ i₀), h, Function.update_self]
  have : a i₀ * w i₀ = k * w i₀ + (a i₀ - k) * w i₀ := by rw [← add_mul]; congr 1; omega
  omega

/-- Lowering the exponent `a i₀` by `k` splits `v i₀ ^ k` off the monomial `∏ i, v i ^ a i`. -/
private theorem prod_pow_eq_pow_mul_prod_update {ι A : Type*} [Fintype ι] [DecidableEq ι]
    [CommMonoid A] (v : ι → A) (a : ι → ℕ) (i₀ : ι) (k : ℕ) (hk : k ≤ a i₀) :
    ∏ i, v i ^ a i = v i₀ ^ k * ∏ i, v i ^ Function.update a i₀ (a i₀ - k) i := by
  have h : ∏ i ∈ Finset.univ.erase i₀, v i ^ Function.update a i₀ (a i₀ - k) i =
      ∏ i ∈ Finset.univ.erase i₀, v i ^ a i :=
    Finset.prod_congr rfl fun i hi => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hi)]
  rw [← Finset.mul_prod_erase _ (fun i => v i ^ a i) (Finset.mem_univ i₀),
    ← Finset.mul_prod_erase _ (fun i => v i ^ Function.update a i₀ (a i₀ - k) i)
      (Finset.mem_univ i₀), h, Function.update_self, ← mul_assoc, ← pow_add,
    Nat.add_sub_cancel' hk]

/-- The exponent-reduction induction: every monomial fraction
`((∏ i, v i ^ a i) • x j) / f ^ N` whose numerator has degree `N * d` lies in the
`S_(f)`-span of `Gset f d B' x e v δ`.  The induction is on `∑ i, a i`: a
degree-`0` generator is pulled out as an `S_(f)`-scalar, and once `N ≥ B'` some
exponent `a i₀` of positive-degree `v i₀` must exceed `d`, so the degree-`0`
element `v i₀ ^ d / f ^ δ i₀` factors out and lowers `∑ i, a i` by `d`. -/
theorem gen_mem_span {ιJ ι' : Type*} [Fintype ι'] (B' : ℕ) (x : ιJ → M) (e : ιJ → ℤ) (v : ι' → S)
    (δ : ι' → ℕ) (hf : f ∈ 𝒜 d) (hd : 1 ≤ d) (hv : ∀ i, v i ∈ 𝒜 (δ i)) (hBδ : ∀ i, δ i ≤ B')
    (hBdeg : ∀ j : ιJ, ((d - 1 : ℕ) * (∑ i, δ i) : ℤ) + e j < (B' : ℤ) * d) (j : ιJ) (a : ι' → ℕ)
    (N : ℕ) (hdeg : ((∑ i, a i • δ i : ℕ) : ℤ) + e j = (N • d : ℕ)) :
    deg0frac f N ((∏ i, v i ^ a i) • x j) ∈
      Submodule.span (HomogeneousLocalization.Away 𝒜 f) (Gset f d B' x e v δ) := by
  classical
    -- Strong induction on σ = ∑ a_i.
    induction hσ : (∑ i, a i) using Nat.strong_induction_on generalizing a N with
  | _ n IH =>
    -- Factor `v i₀ ^ k` out of the monomial: the common step of both cases below.
    have step : ∀ (i₀ : ι') (k m : ℕ), 1 ≤ k → k ≤ a i₀ → m ≤ N → k * δ i₀ = m * d →
        v i₀ ^ k ∈ 𝒜 (m • d) → deg0frac f N ((∏ i, v i ^ a i) • x j) ∈
          Submodule.span (HomogeneousLocalization.Away 𝒜 f) (Gset f d B' x e v δ) := by
      intro i₀ k m hk hka hmN hkm hmem
      have hsum := sum_mul_eq_mul_add_sum_update a (fun _ => 1) i₀ k hka
      have hsumδ := sum_mul_eq_mul_add_sum_update a δ i₀ k hka
      simp only [mul_one] at hsum
      simp only [smul_eq_mul] at hdeg
      have hdeg' : ((∑ i, Function.update a i₀ (a i₀ - k) i • δ i : ℕ) : ℤ) + e j =
          ((N - m) • d : ℕ) := by
        have h1 : (N - m) * d + m * d = N * d := by rw [← add_mul, Nat.sub_add_cancel hmN]
        simp only [smul_eq_mul]
        omega
      have hfact : deg0frac f N ((∏ i, v i ^ a i) • x j) =
          (HomogeneousLocalization.Away.mk 𝒜 hf m (v i₀ ^ k) hmem) •
            deg0frac f (N - m) ((∏ i, v i ^ Function.update a i₀ (a i₀ - k) i) • x j) := by
        rw [scalar_deg0frac 𝒜 f d hf hmem, Nat.add_sub_cancel' hmN,
          prod_pow_eq_pow_mul_prod_update v a i₀ k hka, mul_smul]
      rw [hfact]
      apply Submodule.smul_mem
      exact IH (n - k) (by omega) _ (N - m) hdeg' (by omega)
    by_cases hZ : ∃ i₀, δ i₀ = 0 ∧ 1 ≤ a i₀
    · obtain ⟨i₀, hδ0, ha1⟩ := hZ
      exact step i₀ 1 0 le_rfl ha1 (Nat.zero_le _) (by simp [hδ0]) (by simpa [hδ0] using hv i₀)
    · -- ¬ Case Z:  ∀ i, δ i = 0 → a i = 0
      push Not at hZ
      have hZ0 : ∀ i, δ i = 0 → a i = 0 := fun i h => by
        by_contra hc; exact absurd (hZ i h) (by omega)
      by_cases hN : N < B'
      · -- terminal: in Gset
        exact Submodule.subset_span ⟨j, a, N, hZ0, hN, hdeg, rfl⟩
      · -- Case A: N ≥ B', find i₀ ∈ P with a i₀ ≥ d
        push Not at hN -- B' ≤ N
        -- degree relation as integers: ∑ a_i δ_i + e_j = N*d
        have hNd : ((∑ i, a i • δ i : ℕ) : ℤ) + e j = (N : ℤ) * d := by
          rw [hdeg, smul_eq_mul]; push_cast; ring
        -- there is i₀ with a i₀ ≥ d (and necessarily δ i₀ > 0)
        have hexists : ∃ i₀, d ≤ a i₀ ∧ 0 < δ i₀ := by
          by_contra hcon
          push Not at hcon
          -- then ∑ a_i δ_i ≤ (d-1) ∑ δ_i
          have hbound : (∑ i, a i • δ i) ≤ (d - 1) * ∑ i, δ i := by
            rw [Finset.mul_sum]
            apply Finset.sum_le_sum
            intro i _
            rw [smul_eq_mul]
            by_cases hδi : 0 < δ i
            · have hai : a i ≤ d - 1 := by
                have := hcon i; omega
              gcongr
            · have hδ0 : δ i = 0 := by omega
              rw [hδ0]; simp
          -- combine with N ≥ B' and hBdeg to derive contradiction
          have h1 : (N : ℤ) * d ≤ ((d - 1 : ℕ) * ∑ i, δ i : ℤ) + e j := by
            rw [← hNd]
            have : ((∑ i, a i • δ i : ℕ) : ℤ) ≤ ((d - 1 : ℕ) * ∑ i, δ i : ℤ) := by
              exact_mod_cast hbound
            linarith
          have h2 := hBdeg j
          have h3 : (B' : ℤ) * d ≤ (N : ℤ) * d := by
            apply mul_le_mul_of_nonneg_right _ (by positivity)
            exact_mod_cast hN
          linarith
        obtain ⟨i₀, ha_d, hδpos⟩ := hexists
        refine step i₀ d (δ i₀) hd ha_d (le_trans (hBδ i₀) hN) (mul_comm _ _) ?_
        have := SetLike.pow_mem_graded d (hv i₀)
        rwa [smul_eq_mul, mul_comm] at this

omit [IsScalarTower R S M] [GradedAlgebra 𝒜] in
/-- For `b ∈ 𝒜 i` homogeneous, the degree-`n` component of `b • y` is `b` times the
degree-`n - i` component of `y`. -/
theorem decompose_smul_left_mem {i : ℕ} {b : S} (hb : b ∈ 𝒜 i) (y : M) (n : ℤ) :
    (DirectSum.decompose ℳ (b • y) n : M) =
      b • (DirectSum.decompose ℳ y ((n : ℤ) - (i : ℤ)) : M) := by
  classical
    -- reduce to homogeneous y
    induction y using DirectSum.Decomposition.inductionOn ℳ with
  | zero => simp
  | homogeneous m =>
    rename_i mi
    have hby : b • (m : M) ∈ ℳ ((i : ℤ) + mi) := by
      have := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ) hb m.property
      simpa using this
    by_cases hnm : n = (i : ℤ) + mi
    · subst hnm
      rw [DirectSum.decompose_of_mem_same ℳ hby]
      rw [show ((i : ℤ) + mi) - (i : ℤ) = mi by ring]
      rw [DirectSum.decompose_of_mem_same ℳ m.property]
    · rw [DirectSum.decompose_of_mem_ne ℳ hby (Ne.symm hnm)]
      rw [DirectSum.decompose_of_mem_ne ℳ m.property
          (by
            intro h; apply hnm; omega)]
      simp
  | add y1 y2 h1 h2 =>
    rw [smul_add, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, h1, h2,
      DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, smul_add]

omit [IsScalarTower R S M] in
/-- For `y ∈ ℳ e` homogeneous and `c : S` arbitrary, the degree-`i + e` component of
`c • y` is the degree-`i` component of `c` acting on `y`. -/
theorem proj_smul {e : ℤ} {y : M} (hy : y ∈ ℳ e) (c : S) (i : ℕ) :
    (DirectSum.decompose ℳ (c • y) ((i : ℤ) + e) : M) = (DirectSum.decompose 𝒜 c i : S) • y := by
  classical
    induction c using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | homogeneous m =>
    rename_i mi
    -- m : 𝒜 mi, element (m : S)
    have := decompose_smul_left_mem 𝒜 ℳ (b := (m : S)) m.property y ((i : ℤ) + e)
    rw [show ((i : ℤ) + e) - (mi : ℤ) = ((i : ℤ) - mi) + e by ring] at this
    rw [this]
    by_cases hmi : mi = i
    · subst hmi
      rw [DirectSum.decompose_of_mem_same 𝒜 m.property]
      rw [show ((mi : ℤ) - mi) + e = e by ring, DirectSum.decompose_of_mem_same ℳ hy]
    · rw [DirectSum.decompose_of_mem_ne 𝒜 m.property hmi]
      by_cases hde : ((i : ℤ) - mi) + e = e
      · -- then i = mi, contradiction
        exfalso; apply hmi; omega
      · rw [DirectSum.decompose_of_mem_ne ℳ hy
            (by
              intro h; exact hde h.symm)]
        simp
  | add c1 c2 h1 h2 =>
    rw [add_smul, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, h1, h2,
      DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, add_smul]

omit ℳ in
omit [Decomposition ℳ] [SetLike.GradedSMul 𝒜 ℳ] in
/-- The homogeneous-scalar form of `gen_mem_span`: if `b ∈ 𝒜 s` is homogeneous with
`s + e j = N * d`, then `(b • x j) / f ^ N` lies in the `S_(f)`-span of
`Gset f d B' x e v δ`.  One expands `b` as an `𝒜 0`-combination of the monomials
`∏ i, v i ^ a i` of degree `s` and applies `gen_mem_span` to each. -/
theorem gen_mem_span_homog {ιJ ι' : Type*} [Fintype ι'] (B' : ℕ) (x : ιJ → M) (e : ιJ → ℤ)
    (v : ι' → S) (δ : ι' → ℕ) (hf : f ∈ 𝒜 d) (hd : 1 ≤ d) (hv : ∀ i, v i ∈ 𝒜 (δ i))
    (hadj : Algebra.adjoin (𝒜 0) (Set.range v) = ⊤) (hBδ : ∀ i, δ i ≤ B')
    (hBdeg : ∀ j : ιJ, ((d - 1 : ℕ) * (∑ i, δ i) : ℤ) + e j < (B' : ℤ) * d) (j : ιJ) (s : ℕ)
    (b : S) (hb : b ∈ 𝒜 s) (N : ℕ) (hdeg : (s : ℤ) + e j = (N • d : ℕ)) :
    deg0frac f N (b • x j) ∈
      Submodule.span (HomogeneousLocalization.Away 𝒜 f) (Gset f d B' x e v δ) := by
  classical
  -- ring expansion of b into monomials of degree s
  have hexp :
    b ∈
      Submodule.span (𝒜 0)
        {m : S | ∃ (ai : ι' → ℕ), (∑ i, ai i • δ i = s) ∧ m = ∏ i, v i ^ ai i} := by
    have hbspan : b ∈ Submodule.span (𝒜 0) (Submonoid.closure (Set.range v) : Set S) := by
      rw [← Algebra.adjoin_eq_span, hadj]; trivial
    have key :
      (DirectSum.decompose 𝒜 b s : S) ∈
        Submodule.span (𝒜 0)
          {m : S | ∃ (ai : ι' → ℕ), (∑ i, ai i • δ i = s) ∧ m = ∏ i, v i ^ ai i} := by
      clear hb hdeg
      induction hbspan using Submodule.span_induction with
      | mem a ha =>
        obtain ⟨ai, rfl⟩ := Submonoid.exists_of_mem_closure_range _ _ ha
        by_cases H : ∑ i, ai i • δ i = s
        · have hmem : (∏ i, v i ^ ai i) ∈ 𝒜 s :=
            H ▸ SetLike.prod_pow_mem_graded _ _ _ _ fun i _ => hv i
          rw [DirectSum.decompose_of_mem_same 𝒜 hmem]
          exact Submodule.subset_span ⟨ai, H, rfl⟩
        · have hmem : (∏ i, v i ^ ai i) ∈ 𝒜 (∑ i, ai i • δ i) :=
            SetLike.prod_pow_mem_graded _ _ _ _ fun i _ => hv i
          rw [DirectSum.decompose_of_mem_ne 𝒜 hmem H]; simp
      | zero => simp
      | add x y _ _ hx
        hy =>
        rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
        exact Submodule.add_mem _ hx hy
      | smul r x _
        hx =>
        rw [show r • x = (r : S) * x from rfl,
          DirectSum.coe_decompose_mul_of_left_mem_zero 𝒜 r.property,
          show (r : S) * (DirectSum.decompose 𝒜 x s : S) = r • (DirectSum.decompose 𝒜 x s : S) from
            rfl]
        exact Submodule.smul_mem _ r hx
    rwa [DirectSum.decompose_of_mem_same 𝒜 hb] at key
  -- now push deg0frac N (c • x_j) through the span
  have main :
    ∀
      c ∈
        Submodule.span (𝒜 0)
          {m : S | ∃ (ai : ι' → ℕ), (∑ i, ai i • δ i = s) ∧ m = ∏ i, v i ^ ai i},
      deg0frac f N (c • x j) ∈
        Submodule.span (HomogeneousLocalization.Away 𝒜 f) (Gset f d B' x e v δ) := by
    intro c hc
    induction hc using Submodule.span_induction with
    | mem c hc =>
      obtain ⟨ai, hai, rfl⟩ := hc
      have hdeg' : ((∑ i, ai i • δ i : ℕ) : ℤ) + e j = (N • d : ℕ) := by
        rw [hai]; exact hdeg
      exact gen_mem_span 𝒜 f d B' x e v δ hf hd hv hBδ hBdeg j ai N hdeg'
    | zero =>
      rw [zero_smul, deg0frac_zero]; exact Submodule.zero_mem _
    | add c1 c2 _ _ h1 h2 =>
      rw [add_smul, deg0frac_add]; exact Submodule.add_mem _ h1 h2
    | smul r c _
      h =>
      rw [show (r • c) • x j = (r : S) • (c • x j) from by
          rw [smul_assoc]; rfl, deg0frac_smul_grade0 𝒜 f d hf]
      exact Submodule.smul_mem _ _ h
  exact main b hexp

omit [IsScalarTower R S M] in
include 𝒜 in
/-- The vanishing companion to `proj_smul`: for `y ∈ ℳ e` homogeneous and `c : S`,
every component of `c • y` in a degree `n < e` is zero. -/
theorem proj_smul_vanish {e : ℤ} {y : M} (hy : y ∈ ℳ e) (c : S) (n : ℤ) (hne : n < e) :
    (DirectSum.decompose ℳ (c • y) n : M) = 0 := by
  classical
    induction c using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | homogeneous m =>
    rename_i mi
    have hby : (m : S) • (y : M) ∈ ℳ ((mi : ℤ) + e) := by
      have := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ) m.property hy
      simpa using this
    rw [DirectSum.decompose_of_mem_ne ℳ hby
        (by
          intro h; omega)]
  | add c1 c2 h1 h2 =>
    have hadd : (c1 + c2) • y = c1 • y + c2 • y := add_smul c1 c2 y
    rw [hadd, DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, h1, h2, add_zero]

include ℳ in
/-- Normal form: every defining generator `y / f ^ N` of `M_(f)`, with `y ∈ ℳ (N * d)`,
lies in the `S_(f)`-span of `Gset f d B' x e v δ`.  One writes `y` as an `S`-combination
of the module generators `x j`, keeps only the degree-`N * d` component of each summand
(`proj_smul`, `proj_smul_vanish`) and applies `gen_mem_span_homog`. -/
theorem deg0frac_mem_span {ιJ ι' : Type*} [Finite ιJ] [Fintype ι'] (B' : ℕ) (x : ιJ → M)
    (e : ιJ → ℤ) (v : ι' → S) (δ : ι' → ℕ) (hf : f ∈ 𝒜 d) (hd : 1 ≤ d) (hv : ∀ i, v i ∈ 𝒜 (δ i))
    (hxe : ∀ j, x j ∈ ℳ (e j)) (hxspan : Submodule.span S (Set.range x) = ⊤)
    (hadj : Algebra.adjoin (𝒜 0) (Set.range v) = ⊤) (hBδ : ∀ i, δ i ≤ B')
    (hBdeg : ∀ j : ιJ, ((d - 1 : ℕ) * (∑ i, δ i) : ℤ) + e j < (B' : ℤ) * d) (N : ℕ) (y : M)
    (hy : y ∈ ℳ (N • (d : ℤ))) :
    deg0frac f N y ∈ Submodule.span (HomogeneousLocalization.Away 𝒜 f) (Gset f d B' x e v δ) := by
  classical
  have : Fintype ιJ := Fintype.ofFinite ιJ
  -- write y as ∑ c j • x j
  have hytop : y ∈ Submodule.span S (Set.range x) := by
    rw [hxspan]; trivial
  obtain ⟨c, hc⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).mp hytop
  -- y = decompose ℳ y (N•d)
  have hydecomp : y = (DirectSum.decompose ℳ y (N • (d : ℤ)) : M) :=
    (DirectSum.decompose_of_mem_same ℳ hy).symm
  -- expand
  have hsum :
    (DirectSum.decompose ℳ y (N • (d : ℤ)) : M) =
      ∑ j, (DirectSum.decompose ℳ ((c j) • x j) (N • (d : ℤ)) : M) := by
    have hy2 : y = ∑ j, c j • x j := by
      rw [← hc];
      rw [Finsupp.sum_fintype _ _
          (by
            intro j; simp)]
    rw [hy2]
    induction (Finset.univ : Finset ιJ) using Finset.induction with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, DirectSum.decompose_add, DirectSum.add_apply,
        Submodule.coe_add, ih]
  rw [hydecomp, hsum, deg0frac]
  rw [show
      (LocalizedModule.mk (∑ j, (DirectSum.decompose ℳ ((c j) • x j) (N • (d : ℤ)) : M))
          (⟨f ^ N, ⟨N, rfl⟩⟩ : Submonoid.powers f)) =
        deg0frac f N (∑ j, (DirectSum.decompose ℳ ((c j) • x j) (N • (d : ℤ)) : M))
      from rfl]
  rw [show
      deg0frac f N (∑ j, (DirectSum.decompose ℳ ((c j) • x j) (N • (d : ℤ)) : M)) =
        ∑ j, deg0frac f N (DirectSum.decompose ℳ ((c j) • x j) (N • (d : ℤ)) : M)
      from by
      induction (Finset.univ : Finset ιJ) using Finset.induction with
      | empty => simp [deg0frac_zero]
      | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, deg0frac_add, ih]]
  apply Submodule.sum_mem
  intro j _
  -- handle each j
  by_cases hle : e j ≤ N • (d : ℤ)
  · -- N•d ≥ e_j: use proj_smul + gen_mem_span_homog
    set mj := (N • (d : ℤ) - e j).toNat with hmj
    have hmjcast : (mj : ℤ) = N • (d : ℤ) - e j := by
      rw [hmj]; omega
    have heq2 : ((mj : ℤ) + e j) = N • (d : ℤ) := by
      rw [hmjcast]; ring
    have hproj := proj_smul 𝒜 ℳ (hxe j) (c j) mj
    rw [heq2] at hproj
    rw [hproj]
    have hbmem : (DirectSum.decompose 𝒜 (c j) mj : S) ∈ 𝒜 mj := SetLike.coe_mem _
    have hdeg2 : (mj : ℤ) + e j = (N • d : ℕ) := by
      rw [heq2]; simp only [nsmul_eq_mul, smul_eq_mul]; push_cast; ring
    exact gen_mem_span_homog 𝒜 f d B' x e v δ hf hd hv hadj hBδ hBdeg j mj _ hbmem N hdeg2
  · -- N•d < e_j: component is zero
    push Not at hle
    rw [proj_smul_vanish 𝒜 ℳ (hxe j) (c j) (N • (d : ℤ)) hle, deg0frac_zero]
    exact Submodule.zero_mem _

/-- The generating set `Gset f d B' x e v δ` is finite: there are finitely many indices
`j`, the denominator exponent is bounded by `N < B'`, and the degree constraint bounds
each exponent `a i` by `B' * d + sup_j |e j|`. -/
theorem Gset_finite {ιJ ι' : Type*} [Finite ιJ] [Fintype ι'] (B' : ℕ) (x : ιJ → M) (e : ιJ → ℤ)
    (v : ι' → S) (δ : ι' → ℕ) : (Gset f d B' x e v δ).Finite := by
  classical
  have : Fintype ιJ := Fintype.ofFinite ιJ
  -- bound on exponents
  set C : ℕ := B' * d + Finset.univ.sup (fun j => (e j).natAbs) with hC
  -- the index set as a subset of ιJ × (ι' → ℕ) × ℕ
  apply
    Set.Finite.subset
      (Set.Finite.image
        (fun p : ιJ × (ι' → ℕ) × ℕ => deg0frac f p.snd.snd ((∏ i, v i ^ p.snd.fst i) • x p.fst))
        (Set.Finite.prod (Set.finite_univ)
          (Set.Finite.prod (Set.Finite.pi (fun _ => Set.finite_Iic C)) (Set.finite_Iio B'))))
  rintro y ⟨j, a, N, hZ, hN, hdegr, rfl⟩
  refine ⟨(j, a, N), ⟨Set.mem_univ _, ?_, ?_⟩, rfl⟩
  · -- ∀ i ∈ univ, a i ∈ Iic C
    intro i _
    simp only [Set.mem_Iic]
    by_cases hδi : δ i = 0
    · rw [hZ i hδi]; exact Nat.zero_le _
    · -- a i ≤ a i * δ i ≤ ∑ ≤ N*d + |e j|
      have hδ1 : 1 ≤ δ i := Nat.one_le_iff_ne_zero.mpr hδi
      have hai_le : a i ≤ a i • δ i := by
        rw [smul_eq_mul]; nlinarith [hδ1]
      have hle_sum : a i • δ i ≤ ∑ k, a k • δ k :=
        Finset.single_le_sum (f := fun k => a k • δ k) (fun k _ => Nat.zero_le _)
          (Finset.mem_univ i)
      -- ∑ a δ = N*d - e_j  (as int); so ∑ ≤ N*d + |e_j|
      have hint : ((∑ k, a k • δ k : ℕ) : ℤ) = (N • d : ℕ) - e j := by
        rw [← hdegr]; ring
      have hbound : (∑ k, a k • δ k) ≤ N * d + (e j).natAbs := by
        have : ((∑ k, a k • δ k : ℕ) : ℤ) ≤ ((N * d + (e j).natAbs : ℕ) : ℤ) := by
          rw [hint]; push_cast
          rw [smul_eq_mul]; push_cast
          have h2 := neg_le_abs (e j)
          linarith
        exact_mod_cast this
      have hNd : N * d ≤ B' * d := Nat.mul_le_mul_right _ (le_of_lt hN)
      have hsup : (e j).natAbs ≤ Finset.univ.sup (fun j => (e j).natAbs) :=
        Finset.le_sup (f := fun j => (e j).natAbs) (Finset.mem_univ j)
      calc
        a i ≤ a i • δ i := hai_le
        _ ≤ ∑ k, a k • δ k := hle_sum
        _ ≤ N * d + (e j).natAbs := hbound
        _ ≤ B' * d + Finset.univ.sup (fun j => (e j).natAbs) := by omega
        _ = C := by rw [hC]
  · simp only [Set.mem_Iio]; exact hN

/-- **The finite generating set.**
There is a *finite* set `G ⊆ M_f` of degree-`0` fractions whose `S_(f)`-span is
exactly `MLoc 𝒜 ℳ f d`.  This is the module analogue of Mathlib's ring lemma
`HomogeneousLocalization.Away.span_mk_prod_pow_eq_top`.

*Proof sketch.*
- Fix homogeneous module generators `x_j ∈ ℳ e_j` (`MLoc_homog_module_gens`) and
  homogeneous `R`-algebra generators `v_i ∈ 𝒜 δ_i` with
  `Algebra.adjoin (𝒜 0) {v_i} = ⊤`
  (`GradedAlgebra.exists_finset_adjoin_eq_top_and_homogeneous`).
- **Normal form.** A spanning vector `deg0frac N x` (`x ∈ ℳ (N·d)`) is an
  `S_(f)`-combination of the monomial fractions
  `T(a,j,N) := deg0frac N ((∏ v_i^{a_i}) • x_j)` with `Σ a_i δ_i + e_j = N·d`:
  write `x = Σ s_j x_j` with homogeneous `s_j`, expand each `s_j ∈ 𝒜 s`
  (`s = N·d − e_j`) as an `𝒜 0`-combination of monomials `∏ v_i^{a_i}`, and pull
  the `𝒜 0`-coefficients and the degree-`0` generators (`δ_i = 0`) out as
  `S_(f)`-scalars (`deg0frac_smul_grade0`, `deg0frac_add`, `deg0frac_zero`).
- **The finite set.**  Put `Δ = max δ_i` and use the uniform bound
  `B' = max(Δ, ⌈((d−1)·Σ_{δ_i>0} δ_i + max_j e_j)/d⌉ + 1)`.  Let
  `G := { T(a,j,N) : N < B', a_i = 0 for δ_i = 0, Σ a_i δ_i + e_j = N·d }`.
  `G` is finite (finitely many `j`, `N < B'`, and the degree constraint bounds the
  `a_i` with `δ_i > 0`); and `G ⊆ MLoc` since each `T(a,j,N)` is `deg0frac N y`
  with `y ∈ ℳ (N·d)` (`deg0frac_mem_MLoc`).
- **`MLoc ≤ span G`.**  Strong induction on `σ(a) = Σ_{δ_i>0} a_i`: if `N < B'`
  then `T(a,j,N) ∈ G`; else some `a_{i₀} ≥ d` with `i₀` of positive degree, and
  `N ≥ B' ≥ Δ ≥ δ_{i₀}`, so the factoring identity `scalar_deg0frac` gives
  `T(a,j,N) = (Away.mk hf δ_{i₀} (v_{i₀}^d)) • T(a',j,N−δ_{i₀})` with
  `σ(a') = σ(a) − d < σ(a)`; conclude by the induction hypothesis.  The
  implication `N ≥ B' ⇒ N ≥ δ_{i₀}` is what keeps the denominator exponent `N`
  nonnegative, which the naive set cut out by `a_i < d` alone fails to do when the
  module degrees `e_j` are negative.
- Conclude `span (S_(f)) G = MLoc`. -/
theorem MLoc_exists_finite_spanning_set (hf : f ∈ 𝒜 d) (hd : 1 ≤ d) [Algebra.FiniteType R S]
    [Module.Finite S M] :
    ∃ (G : Finset (MLocAll f (M := M))),
      Submodule.span (SLoc 𝒜 f) (↑G : Set (MLocAll f (M := M))) = MLoc 𝒜 ℳ f d := by
  classical
  -- finite type over 𝒜 0
  have hgz : Algebra.FiniteType R (𝒜 0) := gradeZero_finiteType 𝒜
  have : Algebra.FiniteType (𝒜 0) S := Algebra.FiniteType.of_restrictScalars_finiteType R (𝒜 0) S
  -- homogeneous module generators
  obtain ⟨J, hJhom, hJspan⟩ := MLoc_homog_module_gens (S := S) (ℳ := ℳ) (M := M)
  -- homogeneous ring generators over 𝒜 0
  obtain ⟨sgen, hadjs, hshom⟩ := GradedAlgebra.exists_finset_adjoin_eq_top_and_homogeneous (𝒜 := 𝒜)
  -- index types
  set ιJ := (↥J) with hιJ
  set ι' := (↥sgen) with hι'
  -- module gens function and degrees
  set x : ιJ → M := Subtype.val with hxdef
  have hxe_ex : ∀ j : ιJ, ∃ n : ℤ, x j ∈ ℳ n := fun j => hJhom j.val j.property
  set e : ιJ → ℤ := fun j => (hxe_ex j).choose with hedef
  have hxe : ∀ j : ιJ, x j ∈ ℳ (e j) := fun j => (hxe_ex j).choose_spec
  have hxspan : Submodule.span S (Set.range x) = ⊤ := by
    rw [hxdef, Subtype.range_coe]; exact hJspan
  -- ring gens function and degrees
  set v : ι' → S := Subtype.val with hvdef
  have hv_ex : ∀ i : ι', ∃ n : ℕ, v i ∈ 𝒜 n := fun i => by
    obtain ⟨n, hn⟩ := hshom i.val i.property; exact ⟨n, hn⟩
  set δ : ι' → ℕ := fun i => (hv_ex i).choose with hδdef
  have hv : ∀ i : ι', v i ∈ 𝒜 (δ i) := fun i => (hv_ex i).choose_spec
  have hadj : Algebra.adjoin (𝒜 0) (Set.range v) = ⊤ := by
    rw [hvdef, Subtype.range_coe]; exact hadjs
  -- the bound B'
  set B' : ℕ :=
    Finset.univ.sup δ + (d - 1) * (∑ i, δ i) + Finset.univ.sup (fun j => (e j).natAbs) + 1 with
    hB'def
  have hBδ : ∀ i, δ i ≤ B' := by
    intro i
    have : δ i ≤ Finset.univ.sup δ := Finset.le_sup (Finset.mem_univ i)
    rw [hB'def]; omega
  have hBdeg : ∀ j : ιJ, ((d - 1 : ℕ) * (∑ i, δ i) : ℤ) + e j < (B' : ℤ) * d := by
    intro j
    have hej : e j ≤ ((e j).natAbs : ℤ) := Int.le_natAbs
    have hsupN : (e j).natAbs ≤ Finset.univ.sup (fun j => (e j).natAbs) :=
      Finset.le_sup (f := fun j => (e j).natAbs) (Finset.mem_univ j)
    have hsup : ((e j).natAbs : ℤ) ≤ ((Finset.univ.sup (fun j => (e j).natAbs) : ℕ) : ℤ) := by
      exact_mod_cast hsupN
    have hBd : (B' : ℤ) ≤ (B' : ℤ) * d := by
      have : (1 : ℤ) ≤ d := by exact_mod_cast hd
      nlinarith [Nat.cast_nonneg (α := ℤ) B']
    have hB'big :
      ((d - 1 : ℕ) * (∑ i, δ i) : ℤ) + ((Finset.univ.sup (fun j => (e j).natAbs) : ℕ) : ℤ) <
        (B' : ℤ) := by
      rw [hB'def]; push_cast; nlinarith [Nat.cast_nonneg (α := ℤ) (Finset.univ.sup δ)]
    linarith
  -- finiteness
  have hfin := Gset_finite f d B' x e v δ
  refine ⟨hfin.toFinset, ?_⟩
  rw [hfin.coe_toFinset]
  -- span Gset = MLoc
  apply le_antisymm
  · -- span Gset ≤ MLoc
    rw [Submodule.span_le]
    rintro y ⟨j, a, N, hZ, hN, hdegr, rfl⟩
    -- v^a • x_j ∈ ℳ (N•d)
    have hmem : ((∏ i, v i ^ a i) • x j) ∈ ℳ (N • (d : ℤ)) := by
      have hpow : (∏ i, v i ^ a i) ∈ 𝒜 (∑ i, a i • δ i) :=
        SetLike.prod_pow_mem_graded _ _ _ _ fun i _ => hv i
      have hsmem := SetLike.GradedSMul.smul_mem (A := 𝒜) (B := ℳ) hpow (hxe j)
      have hdegeq : ((∑ i, a i • δ i : ℕ) : ℤ) + e j = (N • (d : ℤ)) := by
        rw [hdegr, nsmul_eq_mul, nsmul_eq_mul]; push_cast; ring
      have : ((∑ i, a i • δ i : ℕ) +ᵥ e j) = N • (d : ℤ) := by
        rw [vadd_nat_int]; exact hdegeq
      rwa [this] at hsmem
    exact deg0frac_mem_MLoc 𝒜 ℳ f d N _ hmem
  · -- MLoc ≤ span Gset
    rw [MLoc, Submodule.span_le]
    rintro y ⟨n, z, hz, rfl⟩
    exact deg0frac_mem_span 𝒜 ℳ f d B' x e v δ hf hd hv hxe hxspan hadj hBδ hBdeg n z hz

/-- `M_(f)` is a finitely generated `S_(f)`-submodule of `M_f`, when `S` is of finite
type over `R`, `M` is a finite graded `S`-module and `f ∈ 𝒜 d` with `1 ≤ d`. -/
theorem MLoc_fg (hf : f ∈ 𝒜 d) (hd : 1 ≤ d) [Algebra.FiniteType R S] [Module.Finite S M] :
    (MLoc 𝒜 ℳ f d).FG :=
  MLoc_exists_finite_spanning_set 𝒜 ℳ f d hf hd

/-- **Tag 07Z2, part 2.**
Under the same hypotheses, if moreover `M` is a finite (finitely generated)
graded `S`-module — with grading `ℳ` satisfying `M = ⨁_n ℳ n`
(`DirectSum.Decomposition ℳ`) and the compatibility `𝒜 i · ℳ j ⊆ ℳ (i + j)`
(`SetLike.GradedSMul 𝒜 ℳ`) — then the degree-`0` localization `M_(f)` is a
finite `S_(f)`-module. -/
@[stacks 07Z2 "(2)"]
theorem moduleLocalization_away_finite (hf : f ∈ 𝒜 d) (hd : 1 ≤ d) [Algebra.FiniteType R S]
    [Module.Finite S M] : Module.Finite (SLoc 𝒜 f) (MLoc 𝒜 ℳ f d) := by
  -- `Module.Finite (S_(f)) ↥(MLoc …)` is equivalent to finite generation of the
  -- submodule `MLoc …` (`Module.Finite.iff_fg`); the latter is `MLoc_fg`.
  exact Module.Finite.iff_fg.mpr (MLoc_fg 𝒜 ℳ f d hf hd)

end MainStatements
