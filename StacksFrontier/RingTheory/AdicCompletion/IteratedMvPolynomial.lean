module

public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.RingTheory.Polynomial.Basic
public import StacksFrontier.RingTheory.AdicCompletion.Algebraization
public import StacksFrontier.RingTheory.AdicCompletion.MapOfPowLe

/-!
# `A⟨x, y⟩ = (A⟨x⟩)⟨y⟩`: the completed polynomial algebra is iterated

Let `A` be a commutative ring and `𝔞 ⊆ A` a finitely generated ideal.  Write `A⟨x⟩` for the
`𝔞`-adic completion of `A[x_σ]`.  This file proves that completing in the variables `x_σ` and
then in the variables `y_τ` is the same as completing in both at once:

```
A⟨y_τ, x_σ⟩  ≅  (A⟨x_σ⟩)⟨y_τ⟩
```

as `A`-algebras, where on the right the ideal completed along is again the one generated by
`𝔞`.  This is the sentence *"`A[x_1, …, x_r, y_1, …, y_s]^∧` is `A[x]^∧[y]^∧`"* that the proof
of **Stacks 0ALM** uses to combine a presentation `B = A⟨x⟩/J` with a presentation
`C = B⟨y⟩/J'` into a single presentation `C = A⟨x, y⟩/K`.

The proof is level by level: the `A`-algebra map `A[y, x] → (A⟨x⟩)[y]` is bijective modulo
the `n`-th power of the ideal generated by `𝔞`, because (i) rearranging the variables is
`MvPolynomial.sumAlgEquiv`, and (ii) a polynomial in `y` with coefficients in `A⟨x⟩` agrees
coefficientwise, modulo `𝔞ⁿ`, with one whose coefficients are polynomials — that is
`AdicCompletion.exists_sub_mem_map_pow` applied in each coefficient — while a polynomial in
`y, x` whose image has all coefficients in `𝔞ⁿ·A⟨x⟩` already has all its coefficients in
`𝔞ⁿ·A[x]`, because `A[x] → A⟨x⟩` detects `𝔞ⁿ`.  Compatible equivalences on all the
infinitesimal neighbourhoods then give one of the completions,
`adicCompletionAlgEquivOfQuotientEquiv`.

## Main definitions

* `AdicCompletion.mvPolynomialMap` — the map `R[y_τ] → (R̂_𝔟)[y_τ]` on coefficients.
* `AdicCompletion.mvPolynomialQuotientAlgEquiv` — that map is an isomorphism modulo `𝔟ⁿ`.
* `AdicCompletion.iteratedMvPolynomialAlgEquiv` — **`A⟨y_τ, x_σ⟩ ≅ (A⟨x_σ⟩)⟨y_τ⟩`**.

## Main results

* `AdicCompletion.algebraMap_mem_map_pow_iff` — `R → R̂_𝔟` detects `𝔟ⁿ`.
* `AdicCompletion.iteratedMvPolynomialAlgEquiv_of` — the isomorphism sends the canonical
  image of a polynomial to the canonical image of its rearrangement, which is what pins it
  down on the variables.

## References

* [Stacks Project, Tag 0ALM](https://stacks.math.columbia.edu/tag/0ALM)
* [Stacks Project, Tag 0AJP](https://stacks.math.columbia.edu/tag/0AJP)
-/

@[expose] public noncomputable section

open MvPolynomial

namespace AdicCompletion

universe u v w

/-! ## The canonical map detects the powers of the ideal -/

section Detection

variable {R : Type v} [CommRing R] (I : Ideal R)

/-- The canonical map `R → R̂_I` detects membership in `Iⁿ`: the image of `a` lies in the
ideal generated by `Iⁿ` in the completion only if `a` already lies in `Iⁿ`.  This is the
injectivity half of `R ⧸ Iⁿ ≅ R̂_I ⧸ Iⁿ R̂_I`, the surjectivity half being
`AdicCompletion.exists_sub_mem_map_pow`. -/
public theorem algebraMap_mem_map_pow_iff (hI : I.FG) (n : ℕ) (a : R) :
    algebraMap R (AdicCompletion I R) a ∈ (I ^ n).map (algebraMap R (AdicCompletion I R)) ↔
      a ∈ I ^ n := by
  have hof : algebraMap R (AdicCompletion I R) a = AdicCompletion.of I R a := by
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply]
  have hsm : ((I ^ n) • (⊤ : Submodule R (AdicCompletion I R))) =
      Submodule.restrictScalars R ((I ^ n).map (algebraMap R (AdicCompletion I R))) :=
    Ideal.smul_top_eq_map (I ^ n)
  have key : AdicCompletion.of I R a ∈ (I ^ n) • (⊤ : Submodule R (AdicCompletion I R)) ↔
      a ∈ I ^ n := by
    rw [pow_smul_top_eq_ker_eval hI, LinearMap.mem_ker, AdicCompletion.eval_of]
    refine (Submodule.Quotient.mk_eq_zero _).trans ?_
    simp
  rw [← key, hsm, Submodule.restrictScalars_mem, hof]

end Detection

/-! ## Completing the coefficients of a polynomial ring -/

section Coefficients

variable {A : Type u} [CommRing A] {R : Type v} [CommRing R] [Algebra A R]
  (𝔟 : Ideal R) (τ : Type w)

/-- The map `R[y_τ] → (R̂_𝔟)[y_τ]` completing the coefficients. -/
public def mvPolynomialMap :
    MvPolynomial τ R →ₐ[A] MvPolynomial τ (AdicCompletion 𝔟 R) :=
  MvPolynomial.mapAlgHom ((Algebra.ofId R (AdicCompletion 𝔟 R)).restrictScalars A)

/-- Completing the coefficients is `MvPolynomial.map` along the canonical map. -/
public theorem mvPolynomialMap_apply (p : MvPolynomial τ R) :
    mvPolynomialMap (A := A) 𝔟 τ p =
      MvPolynomial.map (algebraMap R (AdicCompletion 𝔟 R)) p :=
  rfl

/-- Each coefficient of the completed polynomial is the image of the original coefficient. -/
@[simp] public theorem coeff_mvPolynomialMap (p : MvPolynomial τ R) (m : τ →₀ ℕ) :
    (mvPolynomialMap (A := A) 𝔟 τ p).coeff m =
      algebraMap R (AdicCompletion 𝔟 R) (p.coeff m) := by
  rw [mvPolynomialMap_apply, MvPolynomial.coeff_map]

/-- Completing the coefficients sends a constant `C a` to the constant at the image of `a`. -/
@[simp] public theorem mvPolynomialMap_C (a : R) :
    mvPolynomialMap (A := A) 𝔟 τ (MvPolynomial.C a) =
      MvPolynomial.C (algebraMap R (AdicCompletion 𝔟 R) a) := by
  rw [mvPolynomialMap_apply, MvPolynomial.map_C]

/-- Completing the coefficients fixes each variable `X i`. -/
@[simp] public theorem mvPolynomialMap_X (i : τ) :
    mvPolynomialMap (A := A) 𝔟 τ (MvPolynomial.X i) = MvPolynomial.X i := by
  rw [mvPolynomialMap_apply, MvPolynomial.map_X]

/-- A polynomial lies in the ideal generated by `𝔟ⁿ` exactly when all its coefficients
do. -/
public theorem mem_map_algebraMap_mvPolynomial_iff {n : ℕ} {p : MvPolynomial τ R} :
    p ∈ ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ R))) ↔ ∀ m, p.coeff m ∈ 𝔟 ^ n := by
  rw [MvPolynomial.algebraMap_eq]
  exact MvPolynomial.mem_map_C_iff

/-- The same criterion over the completion: a polynomial with coefficients in `R̂_𝔟` lies in
the ideal generated by `𝔟ⁿ` exactly when all its coefficients lie in `𝔟ⁿ R̂_𝔟`. -/
public theorem mem_map_algebraMap_mvPolynomial_completion_iff {n : ℕ}
    {q : MvPolynomial τ (AdicCompletion 𝔟 R)} :
    q ∈ ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R)))) ↔
      ∀ m, q.coeff m ∈ (𝔟 ^ n).map (algebraMap R (AdicCompletion 𝔟 R)) := by
  have htower : (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R))) =
      (MvPolynomial.C : AdicCompletion 𝔟 R →+* _).comp
        (algebraMap R (AdicCompletion 𝔟 R)) := by
    rw [IsScalarTower.algebraMap_eq R (AdicCompletion 𝔟 R)
      (MvPolynomial τ (AdicCompletion 𝔟 R)), MvPolynomial.algebraMap_eq]
  rw [htower, ← Ideal.map_map]
  exact MvPolynomial.mem_map_C_iff

variable {𝔟 τ}

/-- Completing the coefficients carries the ideal generated by `𝔟ⁿ` into the ideal generated
by `𝔟ⁿ`. -/
public theorem le_comap_mvPolynomialMap (n : ℕ) :
    ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ R))) ≤
      Ideal.comap (mvPolynomialMap (A := A) 𝔟 τ)
        ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R)))) := by
  intro p hp
  rw [mem_map_algebraMap_mvPolynomial_iff] at hp
  rw [Ideal.mem_comap, mem_map_algebraMap_mvPolynomial_completion_iff]
  intro m
  rw [coeff_mvPolynomialMap]
  exact Ideal.mem_map_of_mem _ (hp m)

/-- Conversely, a polynomial whose completion lies in the ideal generated by `𝔟ⁿ` is already
there: this is `AdicCompletion.algebraMap_mem_map_pow_iff` in each coefficient. -/
public theorem comap_mvPolynomialMap_le (hb : 𝔟.FG) (n : ℕ) :
    Ideal.comap (mvPolynomialMap (A := A) 𝔟 τ)
        ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R)))) ≤
      ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ R))) := by
  intro p hp
  rw [Ideal.mem_comap, mem_map_algebraMap_mvPolynomial_completion_iff] at hp
  rw [mem_map_algebraMap_mvPolynomial_iff]
  intro m
  have hm := hp m
  rw [coeff_mvPolynomialMap] at hm
  exact (algebraMap_mem_map_pow_iff 𝔟 hb n _).mp hm

/-- Polynomials with coefficients in `R` are dense in polynomials with coefficients in
`R̂_𝔟`, modulo the ideal generated by `𝔟ⁿ`.  The induction is over the polynomial: a constant
is handled by `AdicCompletion.exists_sub_mem_map_pow`, and multiplying by a variable or
adding does not leave the image. -/
public theorem exists_mk_mvPolynomialMap_eq (hb : 𝔟.FG) (n : ℕ)
    (q : MvPolynomial τ (AdicCompletion 𝔟 R)) :
    ∃ p : MvPolynomial τ R,
      Ideal.Quotient.mk ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R))))
          (mvPolynomialMap (A := A) 𝔟 τ p) =
        Ideal.Quotient.mk ((𝔟 ^ n).map
          (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R)))) q := by
  classical
  induction q using MvPolynomial.induction_on with
  | C z =>
    obtain ⟨a, ha⟩ := exists_sub_mem_map_pow 𝔟 hb n z
    refine ⟨MvPolynomial.C a, (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr ?_⟩
    have hC : mvPolynomialMap (A := A) 𝔟 τ (MvPolynomial.C a) - MvPolynomial.C z =
        MvPolynomial.C (algebraMap R (AdicCompletion 𝔟 R) a - z) := by
      rw [mvPolynomialMap_C, map_sub]
    rw [hC, mem_map_algebraMap_mvPolynomial_completion_iff]
    intro m
    rcases eq_or_ne 0 m with rfl | hm
    · simpa [MvPolynomial.coeff_C, neg_sub] using Submodule.neg_mem _ ha
    · simp [MvPolynomial.coeff_C, hm]
  | add p q hp hq =>
    obtain ⟨p', hp'⟩ := hp
    obtain ⟨q', hq'⟩ := hq
    refine ⟨p' + q', ?_⟩
    rw [map_add, map_add, hp', hq', ← map_add]
  | mul_X p i hp =>
    obtain ⟨p', hp'⟩ := hp
    refine ⟨p' * MvPolynomial.X i, ?_⟩
    rw [map_mul, mvPolynomialMap_X, map_mul, hp', ← map_mul]

/-- **Completing the coefficients is an isomorphism modulo `𝔟ⁿ`**: `R[y]/𝔟ⁿ ≅ R̂_𝔟[y]/𝔟ⁿ`. -/
public def mvPolynomialQuotientAlgEquiv (hb : 𝔟.FG) (n : ℕ) :
    (MvPolynomial τ R ⧸ ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ R)))) ≃ₐ[A]
      (MvPolynomial τ (AdicCompletion 𝔟 R) ⧸
        ((𝔟 ^ n).map (algebraMap R (MvPolynomial τ (AdicCompletion 𝔟 R))))) :=
  AlgEquiv.ofBijective
    (Ideal.quotientMapₐ (R₁ := A) _ (mvPolynomialMap (A := A) 𝔟 τ) (le_comap_mvPolynomialMap n))
    ⟨Ideal.quotientMap_injective' (H := le_comap_mvPolynomialMap (A := A) n)
        (comap_mvPolynomialMap_le hb n),
      fun y => by
        obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨p, hp⟩ := exists_mk_mvPolynomialMap_eq (A := A) hb n q
        exact ⟨Ideal.Quotient.mk _ p, hp⟩⟩

end Coefficients

/-! ## Transport of a completion along an algebra equivalence -/

section Congr

variable {A : Type u} [CommRing A] {R : Type v} [CommRing R] [Algebra A R]
  {S : Type w} [CommRing S] [Algebra A S]

/-- The level-`n` reduction of an `A`-algebra equivalence matching two ideals. -/
public def congrQuotientEquiv {I : Ideal R} {J : Ideal S} (f : R ≃ₐ[A] S)
    (hIJ : J = I.map (f : R →+* S)) (n : ℕ) : (R ⧸ I ^ n) ≃ₐ[A] (S ⧸ J ^ n) :=
  Ideal.quotientEquivAlg (I ^ n) (J ^ n) f (by rw [hIJ, Ideal.map_pow])

/-- The level-`n` reductions of an equivalence are compatible with the transition maps. -/
public theorem congrQuotientEquiv_factorPow {I : Ideal R} {J : Ideal S} (f : R ≃ₐ[A] S)
    (hIJ : J = I.map (f : R →+* S)) {m n : ℕ} (h : m ≤ n) (x : R ⧸ I ^ n) :
    Ideal.Quotient.factorPow J h (congrQuotientEquiv f hIJ n x) =
      congrQuotientEquiv f hIJ m (Ideal.Quotient.factorPow I h x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- The defining identity of `adicCompletionAlgEquivOfQuotientEquiv` on the level-`n`
reductions: its reduction modulo `J ^ n` is `e n` applied to the reduction modulo `I ^ n`. -/
public theorem evalₐ_adicCompletionAlgEquivOfQuotientEquiv (I : Ideal R) (J : Ideal S)
    (e : ∀ n : ℕ, (R ⧸ I ^ n) ≃ₐ[A] (S ⧸ J ^ n))
    (he : ∀ {m n : ℕ} (h : m ≤ n) (x : R ⧸ I ^ n),
      Ideal.Quotient.factorPow J h (e n x) = e m (Ideal.Quotient.factorPow I h x))
    (n : ℕ) (x : AdicCompletion I R) :
    evalₐ J n (adicCompletionAlgEquivOfQuotientEquiv I J e he x) = e n (evalₐ I n x) := by
  refine evalₐ_liftAlgHom J _ (fun {m n} hmn => AlgHom.ext fun y => ?_) n x
  have hy := he hmn (evalₐ I n y)
  rw [factor_evalₐ I hmn] at hy
  simpa using hy

/-- An `A`-algebra equivalence `R ≃ S` matching two ideals induces one of their adic
completions, computed on the canonical images of `R`. -/
public def congrAlgEquiv {I : Ideal R} {J : Ideal S} (f : R ≃ₐ[A] S)
    (hIJ : J = I.map (f : R →+* S)) :
    AdicCompletion I R ≃ₐ[A] AdicCompletion J S :=
  adicCompletionAlgEquivOfQuotientEquiv I J (congrQuotientEquiv f hIJ)
    (congrQuotientEquiv_factorPow f hIJ)

/-- `congrAlgEquiv f hIJ` sends the canonical image of `p : R` to the canonical image of `f p`. -/
@[simp] public theorem congrAlgEquiv_of {I : Ideal R} {J : Ideal S} (f : R ≃ₐ[A] S)
    (hIJ : J = I.map (f : R →+* S)) (p : R) :
    congrAlgEquiv f hIJ (of I R p) = of J S (f p) :=
  ext_evalₐ fun n => by
    rw [show evalₐ J n (congrAlgEquiv f hIJ (of I R p)) =
        congrQuotientEquiv f hIJ n (evalₐ I n (of I R p)) from
      evalₐ_adicCompletionAlgEquivOfQuotientEquiv I J _ _ n _, evalₐ_of, evalₐ_of]
    exact Ideal.quotientEquivAlg_mk _ _ _ _

end Congr

/-! ## The iterated completed polynomial algebra -/

section Iterated

/-- Along an `A`-algebra map, the ideal generated by `𝔞` goes to the ideal generated by
`𝔞`. -/
public theorem map_algHom_eq {A : Type u} [CommRing A] {R : Type v} [CommRing R]
    [Algebra A R] {S : Type w} [CommRing S] [Algebra A S] (𝔞 : Ideal A) (f : R →ₐ[A] S) :
    (𝔞.map (algebraMap A R)).map (f : R →+* S) = 𝔞.map (algebraMap A S) := by
  rw [Ideal.map_map, f.comp_algebraMap]

/-- Along an `A`-algebra map, the ideal generated by `𝔞ⁿ` goes to the ideal generated by
`𝔞ⁿ`. -/
public theorem map_pow_algHom_eq {A : Type u} [CommRing A] {R : Type v} [CommRing R]
    [Algebra A R] {S : Type w} [CommRing S] [Algebra A S] (𝔞 : Ideal A) (f : R →ₐ[A] S)
    (n : ℕ) :
    ((𝔞.map (algebraMap A R)) ^ n).map (f : R →+* S) = (𝔞.map (algebraMap A S)) ^ n := by
  rw [Ideal.map_pow, map_algHom_eq]

/-- In a tower `A → R → S`, the ideal generated by `𝔞ⁿ` in `S` is generated by the ideal it
generates in `R`. -/
public theorem map_pow_algebraMap_tower {A : Type u} [CommRing A] {R : Type v} [CommRing R]
    [Algebra A R] {S : Type w} [CommRing S] [Algebra A S] [Algebra R S]
    [IsScalarTower A R S] (𝔞 : Ideal A) (n : ℕ) :
    ((𝔞.map (algebraMap A R)) ^ n).map (algebraMap R S) = (𝔞.map (algebraMap A S)) ^ n := by
  exact map_pow_algHom_eq 𝔞 (IsScalarTower.toAlgHom A R S) n

variable {A : Type u} [CommRing A] (𝔞 : Ideal A) (σ : Type v) (τ : Type w)

/-- The ideal generated by `𝔞` in the polynomial ring on the variables `σ`. -/
public abbrev mvPolynomialIdeal : Ideal (MvPolynomial σ A) :=
  𝔞.map (algebraMap A (MvPolynomial σ A))

/-- The completed polynomial algebra `A⟨x_σ⟩`: the `𝔞`-adic completion of `A[x_σ]`. -/
public abbrev completedMvPolynomial :=
  AdicCompletion (mvPolynomialIdeal 𝔞 σ) (MvPolynomial σ A)

/-- Rearranging the variables of `A[y_τ, x_σ]` into `A[x_σ][y_τ]` and then completing the
coefficients: the `A`-algebra map `A[y_τ, x_σ] → (A⟨x_σ⟩)[y_τ]`. -/
public def iterateMvPolynomial :
    MvPolynomial (τ ⊕ σ) A →ₐ[A] MvPolynomial τ (completedMvPolynomial 𝔞 σ) :=
  (mvPolynomialMap (A := A) (mvPolynomialIdeal 𝔞 σ) τ).comp
    (MvPolynomial.sumAlgEquiv A τ σ).toAlgHom

/-- **`A[y_τ, x_σ] → (A⟨x_σ⟩)[y_τ]` is an isomorphism modulo the `n`-th power of the ideal
generated by `𝔞`.**  Rearranging the variables is an isomorphism outright, and completing
the coefficients is one modulo `𝔞ⁿ` by `AdicCompletion.mvPolynomialQuotientAlgEquiv`. -/
public def iteratedQuotientAlgEquiv (h𝔞 : 𝔞.FG) (n : ℕ) :
    (MvPolynomial (τ ⊕ σ) A ⧸ (𝔞.map (algebraMap A (MvPolynomial (τ ⊕ σ) A))) ^ n) ≃ₐ[A]
      (MvPolynomial τ (completedMvPolynomial 𝔞 σ) ⧸
        (𝔞.map (algebraMap A (MvPolynomial τ (completedMvPolynomial 𝔞 σ)))) ^ n) :=
  (Ideal.quotientEquivAlg _ ((𝔞.map
        (algebraMap A (MvPolynomial τ (MvPolynomial σ A)))) ^ n)
      (MvPolynomial.sumAlgEquiv A τ σ)
      (map_pow_algHom_eq 𝔞 (MvPolynomial.sumAlgEquiv A τ σ).toAlgHom n).symm).trans
    ((Ideal.quotientEquivAlgOfEq A
        (map_pow_algebraMap_tower (R := MvPolynomial σ A)
          (S := MvPolynomial τ (MvPolynomial σ A)) 𝔞 n).symm).trans
      ((mvPolynomialQuotientAlgEquiv (A := A)
          (h𝔞.map (algebraMap A (MvPolynomial σ A))) n).trans
        (Ideal.quotientEquivAlgOfEq A
          (map_pow_algebraMap_tower (R := MvPolynomial σ A)
            (S := MvPolynomial τ (completedMvPolynomial 𝔞 σ)) 𝔞 n))))

/-- On the class of a polynomial, the level-`n` equivalence is the rearrangement followed by
completion of the coefficients. -/
public theorem iteratedQuotientAlgEquiv_mk (h𝔞 : 𝔞.FG) (n : ℕ)
    (p : MvPolynomial (τ ⊕ σ) A) :
    iteratedQuotientAlgEquiv 𝔞 σ τ h𝔞 n
        (Ideal.Quotient.mk ((𝔞.map (algebraMap A (MvPolynomial (τ ⊕ σ) A))) ^ n) p) =
      Ideal.Quotient.mk _ (iterateMvPolynomial 𝔞 σ τ p) :=
  rfl

/-- The level-`n` equivalences are compatible with the transition maps of the two towers. -/
public theorem iteratedQuotientAlgEquiv_factorPow (h𝔞 : 𝔞.FG) {m n : ℕ} (h : m ≤ n)
    (x : MvPolynomial (τ ⊕ σ) A ⧸ (𝔞.map (algebraMap A (MvPolynomial (τ ⊕ σ) A))) ^ n) :
    Ideal.Quotient.factorPow _ h (iteratedQuotientAlgEquiv 𝔞 σ τ h𝔞 n x) =
      iteratedQuotientAlgEquiv 𝔞 σ τ h𝔞 m (Ideal.Quotient.factorPow _ h x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- **`A⟨y_τ, x_σ⟩ ≅ (A⟨x_σ⟩)⟨y_τ⟩`.**  Completing a polynomial algebra in two groups of
variables at once is the same as completing in one group and then in the other — the
identification used by the proof of Stacks 0ALM to combine a presentation of `B` over `A` in
the variables `x` with one of `C` over `B` in the variables `y`. -/
public def iteratedMvPolynomialAlgEquiv (h𝔞 : 𝔞.FG) :
    completedMvPolynomial 𝔞 (τ ⊕ σ) ≃ₐ[A]
      AdicCompletion (𝔞.map (algebraMap A (MvPolynomial τ (completedMvPolynomial 𝔞 σ))))
        (MvPolynomial τ (completedMvPolynomial 𝔞 σ)) :=
  adicCompletionAlgEquivOfQuotientEquiv _ _ (iteratedQuotientAlgEquiv 𝔞 σ τ h𝔞)
    (iteratedQuotientAlgEquiv_factorPow 𝔞 σ τ h𝔞)

/-- The identification `A⟨y, x⟩ ≅ (A⟨x⟩)⟨y⟩` sends the canonical image of a polynomial to the
canonical image of its rearrangement.  This pins the map down on the variables: `x_i ↦ x_i`
and `y_j ↦ y_j`. -/
@[simp] public theorem iteratedMvPolynomialAlgEquiv_of (h𝔞 : 𝔞.FG)
    (p : MvPolynomial (τ ⊕ σ) A) :
    iteratedMvPolynomialAlgEquiv 𝔞 σ τ h𝔞 (of _ _ p) = of _ _ (iterateMvPolynomial 𝔞 σ τ p) :=
  ext_evalₐ fun n => by
    rw [show evalₐ _ n (iteratedMvPolynomialAlgEquiv 𝔞 σ τ h𝔞 (of _ _ p)) =
        iteratedQuotientAlgEquiv 𝔞 σ τ h𝔞 n (evalₐ _ n (of _ _ p)) from
      evalₐ_adicCompletionAlgEquivOfQuotientEquiv _ _ _ _ n _, evalₐ_of, evalₐ_of,
      iteratedQuotientAlgEquiv_mk]

/-- The rearrangement sends an outer variable `y_j` to `y_j`. -/
@[simp] public theorem iterateMvPolynomial_X_inl (j : τ) :
    iterateMvPolynomial 𝔞 σ τ (MvPolynomial.X (Sum.inl j)) = MvPolynomial.X j := by
  simp [iterateMvPolynomial]

/-- The rearrangement sends an inner variable `x_i` to the constant `x_i` of `A⟨x_σ⟩`. -/
@[simp] public theorem iterateMvPolynomial_X_inr (i : σ) :
    iterateMvPolynomial 𝔞 σ τ (MvPolynomial.X (Sum.inr i)) =
      MvPolynomial.C (algebraMap (MvPolynomial σ A) (completedMvPolynomial 𝔞 σ)
        (MvPolynomial.X i)) := by
  simp [iterateMvPolynomial]

end Iterated

/-! ## The case of finitely many variables -/

section Fin

variable {A : Type u} [CommRing A] (𝔞 : Ideal A)

/-- The reindexing `Fin s ⊕ Fin r ≃ Fin (r + s)` putting the `s` outer variables after the
`r` inner ones. -/
public def finSumEquiv (r s : ℕ) : Fin s ⊕ Fin r ≃ Fin (r + s) :=
  (Equiv.sumComm (Fin s) (Fin r)).trans finSumFinEquiv

/-- **`A⟨x₁, …, x_r, y₁, …, y_s⟩ ≅ (A⟨x₁, …, x_r⟩)⟨y₁, …, y_s⟩`**, the form in which the proof
of Stacks 0ALM uses `AdicCompletion.iteratedMvPolynomialAlgEquiv`. -/
public def finIteratedMvPolynomialAlgEquiv (h𝔞 : 𝔞.FG) (r s : ℕ) :
    completedMvPolynomial 𝔞 (Fin (r + s)) ≃ₐ[A]
      AdicCompletion
        (𝔞.map (algebraMap A (MvPolynomial (Fin s) (completedMvPolynomial 𝔞 (Fin r)))))
        (MvPolynomial (Fin s) (completedMvPolynomial 𝔞 (Fin r))) :=
  (congrAlgEquiv (MvPolynomial.renameEquiv A (finSumEquiv r s)).symm
      (map_algHom_eq 𝔞
        (MvPolynomial.renameEquiv A (finSumEquiv r s)).symm.toAlgHom).symm).trans
    (iteratedMvPolynomialAlgEquiv 𝔞 (Fin r) (Fin s) h𝔞)

/-- The identification of `AdicCompletion.finIteratedMvPolynomialAlgEquiv` on the canonical
image of a polynomial. -/
public theorem finIteratedMvPolynomialAlgEquiv_of (h𝔞 : 𝔞.FG) (r s : ℕ)
    (p : MvPolynomial (Fin (r + s)) A) :
    finIteratedMvPolynomialAlgEquiv 𝔞 h𝔞 r s (of _ _ p) =
      of _ _ (iterateMvPolynomial 𝔞 (Fin r) (Fin s)
        (MvPolynomial.rename (finSumEquiv r s).symm p)) := by
  have hcongr := congrAlgEquiv_of (A := A)
    (I := mvPolynomialIdeal 𝔞 (Fin (r + s))) (J := mvPolynomialIdeal 𝔞 (Fin s ⊕ Fin r))
    (MvPolynomial.renameEquiv A (finSumEquiv r s)).symm
    (map_algHom_eq 𝔞 (MvPolynomial.renameEquiv A (finSumEquiv r s)).symm.toAlgHom).symm p
  rw [finIteratedMvPolynomialAlgEquiv, AlgEquiv.trans_apply, hcongr,
    iteratedMvPolynomialAlgEquiv_of]
  rfl

end Fin

end AdicCompletion

