universe u v w t

/-!
# Split exactness of the adic completion of a short exact sequence with flat quotient

Let `R` be a commutative ring, `I ⊆ R` an ideal and `0 → K → P → M → 0` a short exact sequence
of `R`-modules with `M` flat over `R` and `M/IM` projective over `R ⧸ I`. Then the sequence of
`I`-adic completions `0 → K^∧ → P^∧ → M^∧ → 0` is split exact.

Everything is read off the reductions `0 → K/IⁿK → P/IⁿP → M/IⁿM → 0`. Flatness of `M` says
that `IⁿP ∩ K = IⁿK`, so each of these is short exact; injectivity and exactness of the completed
sequence are then immediate, an element of `K^∧` being a compatible family of preimages. For the
splitting, `M/IⁿM` is projective over `R ⧸ Iⁿ` (Stacks 05CG applied to the nilpotent ideal
generated by `I` in `R ⧸ Iⁿ`), and the source's construction produces compatible splittings
`sₙ : M/IⁿM → P/IⁿP`: given `sₙ`, the submodule `Pₙ₊₁ = {x ∈ P | x mod IⁿP ∈ Im sₙ}` still
surjects onto `M`, so projectivity of `M/Iⁿ⁺¹M` splits `Pₙ₊₁/Iⁿ⁺¹Pₙ₊₁ → M/Iⁿ⁺¹M`, and the
composite with `Pₙ₊₁/Iⁿ⁺¹Pₙ₊₁ → P/Iⁿ⁺¹P` is an `sₙ₊₁` reducing to `sₙ`. The limit of the `sₙ` is
the required section, and it is `R^∧`-linear because each `sₙ` is `R ⧸ Iⁿ`-linear.

## Main results

* `Stacks.AdicCompletion.SplitShortExact.solution`: the statement of Stacks Tag 05D3.

## Implementation notes

The splittings are carried as `R`-linear maps between the reductions rather than as
`R ⧸ Iⁿ`-linear ones: the transition maps `M/Iⁿ⁺¹M → M/IⁿM` are maps between modules over two
different rings, so `R` is the only base over which the whole tower is stated uniformly.
`R ⧸ Iⁿ`-linearity is not lost by this — the action of `R ⧸ Iⁿ` on `M/IⁿM` is induced by the
action of `R` (`mk_ideal_smul`), so every `R`-linear map between reductions is automatically
`R ⧸ Iⁿ`-linear, which is what makes the limit `R^∧`-linear.

Stacks 05CG is applied over the ring `R ⧸ Iⁿ` to the ideal `J` generated there by `I`, which is
nilpotent because `Jⁿ` is the image of `Iⁿ`. Its two hypotheses are read off `M`: the reduction
`M/IⁿM` is flat over `R ⧸ Iⁿ` because flatness is stable under base change, and reducing it once
more by `J` returns `M/IM` over `(R ⧸ Iⁿ) ⧸ J = R ⧸ I`. The second identification is the one place
a computation is needed: the preimage in `M` of `J · (M/IⁿM)` is `IM`, because `IⁿM ⊆ IM`, so the
composite `M → M/IⁿM → (M/IⁿM)/J(M/IⁿM)` is surjective with kernel `IM`; the corresponding
identification of the rings is `DoubleQuot.quotQuotEquivQuotOfLE`.

Where the source shows that `Pₙ₊₁/Iⁿ⁺¹Pₙ₊₁ → M/Iⁿ⁺¹M` is surjective and omits the details, the
argument used here proves the stronger `g (Pₙ₊₁) = M`: a preimage of `y` may be corrected by an
element of `IⁿP`, which does not leave `Pₙ₊₁` and is enough because `g (IⁿP) = IⁿM`.

## References

* [Stacks Project, Tag 05D3](https://stacks.math.columbia.edu/tag/05D3)
-/

namespace Stacks.AdicCompletion.SplitShortExact



section Tower

variable {A : Type*} [CommRing A] (J : Ideal A) {N : Type*} [AddCommGroup N] [Module A N]

/-- The class of `r` in `A ⧸ J` acts on `N/JN` the way `r` does. -/
private lemma mk_smul_eq_smul (r : A) (y : N ⧸ (J • ⊤ : Submodule A N)) :
    Ideal.Quotient.mk J r • y = r • y := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  rfl

end Tower

section Transfer

/-- Projectivity transfers along a ring isomorphism together with a compatible additive
isomorphism of modules. -/
theorem projective_of_ringEquiv {A B : Type*} [Semiring A] [Semiring B] (σ : A ≃+* B)
    {N : Type*} [AddCommMonoid N] [Module A N] {N' : Type*} [AddCommMonoid N'] [Module B N']
    (φ : N ≃+ N') (hφ : ∀ (a : A) (x : N), φ (a • x) = σ a • φ x)
    (h : Module.Projective A N) : Module.Projective B N' := by
  have := h
  have := RingHomInvPair.of_ringEquiv σ
  have := RingHomInvPair.of_ringEquiv_symm σ
  exact Module.Projective.of_equiv (σ := (σ : A →+* B)) (σ' := (σ.symm : B →+* A))
    { toFun := φ, invFun := φ.symm, map_add' := φ.map_add, map_smul' := hφ,
      left_inv := φ.left_inv, right_inv := φ.right_inv }

end Transfer

section Reductions

variable {R : Type*} [CommRing R] (I : Ideal R)

/-- Reduction modulo an ideal preserves surjectivity. -/
private lemma reduceModIdeal_surjective {A B : Type*} [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] (J : Ideal R) {φ : A →ₗ[R] B}
    (hφ : Function.Surjective φ) : Function.Surjective (LinearMap.reduceModIdeal J φ) := by
  intro y
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  obtain ⟨a, rfl⟩ := hφ b
  exact ⟨Submodule.Quotient.mk a, rfl⟩

/-- Reduction modulo an ideal is functorial. -/
private lemma reduceModIdeal_comp {A B C : Type*} [AddCommGroup A] [Module R A] [AddCommGroup B]
    [Module R B] [AddCommGroup C] [Module R C] (J : Ideal R) (φ : A →ₗ[R] B) (ψ : B →ₗ[R] C)
    (x : A ⧸ (J • ⊤ : Submodule R A)) :
    LinearMap.reduceModIdeal J ψ (LinearMap.reduceModIdeal J φ x) =
      LinearMap.reduceModIdeal J (ψ ∘ₗ φ) x := by
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rfl

/-- The transition maps of the tower of reductions commute with reduction of a linear map. -/
private lemma transitionMap_reduceModIdeal {A B : Type*} [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] (φ : A →ₗ[R] B) {m n : ℕ} (hmn : m ≤ n)
    (x : A ⧸ (I ^ n • ⊤ : Submodule R A)) :
    AdicCompletion.transitionMap I B hmn (LinearMap.reduceModIdeal (I ^ n) φ x) =
      LinearMap.reduceModIdeal (I ^ m) φ (AdicCompletion.transitionMap I A hmn x) := by
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rfl

/-- The transition maps of the tower of reductions compose. -/
private lemma transitionMap_trans {A : Type*} [AddCommGroup A] [Module R A] {a b c : ℕ}
    (hab : a ≤ b) (hbc : b ≤ c) (x : A ⧸ (I ^ c • ⊤ : Submodule R A)) :
    AdicCompletion.transitionMap I A hab (AdicCompletion.transitionMap I A hbc x) =
      AdicCompletion.transitionMap I A (hab.trans hbc) x := by
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rfl

/-- The transition map from a level to itself is the identity. -/
private lemma transitionMap_self {A : Type*} [AddCommGroup A] [Module R A] {a : ℕ} (h : a ≤ a)
    (x : A ⧸ (I ^ a • ⊤ : Submodule R A)) : AdicCompletion.transitionMap I A h x = x := by
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rfl

/-- The zeroth reduction is trivial. -/
private lemma subsingleton_quotient_pow_zero {A : Type*} [AddCommGroup A] [Module R A] :
    Subsingleton (A ⧸ (I ^ 0 • ⊤ : Submodule R A)) := by
  refine ⟨fun a b => ?_⟩
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ a
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ b
  rw [Submodule.Quotient.eq, pow_zero, Ideal.one_eq_top, Submodule.top_smul]
  exact Submodule.mem_top

/-- The class of `r` in `R ⧸ (J • ⊤)` acts on `B/JB` the way `r` does. This is the action along
which the module structure of `AdicCompletion I B` over `AdicCompletion I R` is defined. -/
private lemma mk_ideal_smul (J : Ideal R) {B : Type*} [AddCommGroup B] [Module R B] (r : R)
    (z : B ⧸ (J • ⊤ : Submodule R B)) :
    Ideal.Quotient.mk (J • ⊤ : Ideal R) r • z = r • z := by
  exact mk_smul_eq_smul J r z

/-- Every `R`-linear map between reductions modulo `J` is semilinear for the action of
`R ⧸ (J • ⊤)`. -/
private lemma smul_reduce (J : Ideal R) {A B : Type*} [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B]
    (φ : (A ⧸ (J • ⊤ : Submodule R A)) →ₗ[R] B ⧸ (J • ⊤ : Submodule R B))
    (a : R ⧸ (J • ⊤ : Ideal R)) (y : A ⧸ (J • ⊤ : Submodule R A)) :
    φ (a • y) = a • φ y := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [mk_ideal_smul, map_smul, mk_ideal_smul]

end Reductions

section Main

variable {R : Type u} [CommRing R] (I : Ideal R) {K : Type v} {P : Type w} {M : Type t}
variable [AddCommGroup K] [Module R K] [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M]
variable {f : K →ₗ[R] P} {g : P →ₗ[R] M}

/-- Flatness of `M` makes each reduction `M/IⁿM` flat over `R ⧸ Iⁿ`. -/
private lemma flat_quotient_pow [Module.Flat R M] (n : ℕ) :
    Module.Flat (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M)) := by
  have := Module.Flat.baseChange R (R ⧸ I ^ n) M
  exact Module.Flat.of_linearEquiv
    (LinearEquiv.extendScalarsOfSurjective (R := R) (S := R ⧸ I ^ n)
      (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective)
      (TensorProduct.quotTensorEquivQuotSMul M (I ^ n))).symm

/-- Each reduction `M/IⁿM` is projective over `R ⧸ Iⁿ`. This is Stacks 05CG applied to the ring
`R ⧸ Iⁿ` and the nilpotent ideal generated there by `I`. -/
private lemma projective_quotient_pow [Module.Flat R M]
    (hM : Module.Projective (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M))) (n : ℕ) :
    Module.Projective (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M)) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have := subsingleton_quotient_pow_zero (R := R) (A := M) I
    have := Module.Free.of_subsingleton (R ⧸ I ^ 0) (M ⧸ (I ^ 0 • ⊤ : Submodule R M))
    infer_instance
  have hIn : I ^ n ≤ I := Ideal.pow_le_self hn.ne'
  have hnpow : (I ^ n • ⊤ : Submodule R M) ≤ (I • ⊤ : Submodule R M) :=
    Submodule.smul_mono_left hIn
  set J : Ideal (R ⧸ I ^ n) := I.map (Ideal.Quotient.mk (I ^ n)) with hJ
  have hnil : IsNilpotent J := ⟨n, by rw [hJ, ← Ideal.map_pow]; simp⟩
  have : Module.Flat (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M)) := flat_quotient_pow I n
  refine Module.Flat.projective_of_isNilpotent_of_projective_quotient_smul_top hnil ?_
  have hsmulR : ∀ (r : R)
      (z : (M ⧸ (I ^ n • ⊤ : Submodule R M)) ⧸
        (J • ⊤ : Submodule (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M)))),
      Ideal.Quotient.mk (I ^ n) r • z = r • z := by
    intro r z
    exact algebraMap_smul (R ⧸ I ^ n) r z
  set π : M →ₗ[R] (M ⧸ (I ^ n • ⊤ : Submodule R M)) ⧸
      (J • ⊤ : Submodule (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M))) :=
    LinearMap.restrictScalars R (Submodule.mkQ _) ∘ₗ (I ^ n • ⊤ : Submodule R M).mkQ with hπdef
  have hπ : Function.Surjective π := by
    intro z
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    exact ⟨x, rfl⟩
  have hmk : ∀ (r : R) (x : M),
      (Submodule.Quotient.mk (r • x) : M ⧸ (I ^ n • ⊤ : Submodule R M)) =
        Ideal.Quotient.mk (I ^ n) r • Submodule.Quotient.mk x :=
    fun r x => (mk_smul_eq_smul (I ^ n) r (Submodule.Quotient.mk x)).symm
  have hrep : ∀ w ∈ (J • ⊤ : Submodule (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M))),
      ∃ z ∈ (I • ⊤ : Submodule R M),
        (Submodule.Quotient.mk z : M ⧸ (I ^ n • ⊤ : Submodule R M)) = w := by
    intro w hw
    refine Submodule.smul_induction_on hw ?_ ?_
    · intro j hj y _
      obtain ⟨r, hr, rfl⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).1 hj
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
      exact ⟨r • x, Submodule.smul_mem_smul hr Submodule.mem_top, hmk r x⟩
    · rintro a b ⟨z₁, h₁, rfl⟩ ⟨z₂, h₂, rfl⟩
      exact ⟨z₁ + z₂, add_mem h₁ h₂, by rw [Submodule.Quotient.mk_add]⟩
  have hmem : ∀ z : M, (Submodule.Quotient.mk z : M ⧸ (I ^ n • ⊤ : Submodule R M)) ∈
      (J • ⊤ : Submodule (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M))) ↔
      z ∈ (I • ⊤ : Submodule R M) := by
    intro z
    refine ⟨fun h => ?_, fun h => ?_⟩
    · obtain ⟨z', hz', hzz'⟩ := hrep _ h
      have hsub : z - z' ∈ (I ^ n • ⊤ : Submodule R M) := by
        rw [← Submodule.Quotient.eq]
        exact hzz'.symm
      simpa using add_mem (hnpow hsub) hz'
    · refine Submodule.smul_induction_on h ?_ ?_
      · intro r hr x _
        rw [hmk]
        exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top
      · intro a b ha hb
        rw [Submodule.Quotient.mk_add]
        exact add_mem ha hb
  have hker : LinearMap.ker π = (I • ⊤ : Submodule R M) := by
    ext z
    rw [LinearMap.mem_ker]
    show (Submodule.Quotient.mk (Submodule.Quotient.mk z) : _) = 0 ↔ _
    rw [Submodule.Quotient.mk_eq_zero]
    exact hmem z
  set φ := (Submodule.quotEquivOfEq _ _ hker.symm).trans (π.quotKerEquivOfSurjective hπ)
    with hφdef
  refine projective_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hIn).symm φ.toAddEquiv ?_ hM
  intro a x
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [mk_smul_eq_smul, DoubleQuot.quotQuotEquivQuotOfLE_symm_mk]
  show φ (r • x) = _
  rw [φ.map_smul]
  show _ = Ideal.Quotient.mk _ (Ideal.Quotient.mk (I ^ n) r) • φ x
  rw [mk_smul_eq_smul, hsmulR]

/-- Flatness of `M` in the form `IⁿP ∩ K = IⁿK`: if `f z` lies in `J • P` then `z` lies in
`J • K`, for every ideal `J`. -/
private lemma mem_smul_top_of_apply_mem [Module.Flat R M] (hf : Function.Injective f)
    (hfg : Function.Exact f g) (hg : Function.Surjective g) (J : Ideal R) {z : K}
    (hz : f z ∈ (J • ⊤ : Submodule R P)) : z ∈ (J • ⊤ : Submodule R K) := by
  have hmem : f z ∈ LinearMap.ker g ⊓ (J • ⊤ : Submodule R P) :=
    ⟨by simpa using hfg.apply_apply_eq_zero z, hz⟩
  rw [LinearMap.ker_inf_smul_top_eq_smul_of_flat J g hg, hfg.linearMap_ker_eq,
    LinearMap.range_eq_map, ← Submodule.map_smul''] at hmem
  exact (Submodule.comap_map_eq_of_injective hf _).le hmem

/-- The reduction of `f` modulo `Iⁿ` is injective. -/
private lemma reduceModIdeal_injective [Module.Flat R M] (hf : Function.Injective f)
    (hfg : Function.Exact f g) (hg : Function.Surjective g) (n : ℕ) :
    Function.Injective (LinearMap.reduceModIdeal (I ^ n) f) := by
  intro a b hab
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ a
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ b
  rw [LinearMap.reduceModIdeal_apply, LinearMap.reduceModIdeal_apply,
    Submodule.Quotient.eq] at hab
  rw [Submodule.Quotient.eq]
  exact mem_smul_top_of_apply_mem hf hfg hg (I ^ n) (by rwa [map_sub])

/-- The inductive step of the source's construction: a splitting of `P/IⁿP → M/IⁿM` lifts to a
splitting of `P/Iⁿ⁺¹P → M/Iⁿ⁺¹M` reducing to it. -/
private lemma exists_splitting_succ (hg : Function.Surjective g)
    (hproj : ∀ n : ℕ, Module.Projective (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M)))
    (n : ℕ) (s : (M ⧸ (I ^ n • ⊤ : Submodule R M)) →ₗ[R] P ⧸ (I ^ n • ⊤ : Submodule R P))
    (hs : ∀ x, LinearMap.reduceModIdeal (I ^ n) g (s x) = x) :
    ∃ t : (M ⧸ (I ^ (n + 1) • ⊤ : Submodule R M)) →ₗ[R] P ⧸ (I ^ (n + 1) • ⊤ : Submodule R P),
      (∀ x, LinearMap.reduceModIdeal (I ^ (n + 1)) g (t x) = x) ∧
      ∀ x, AdicCompletion.transitionMap I P (Nat.le_succ n) (t x) =
        s (AdicCompletion.transitionMap I M (Nat.le_succ n) x) := by
  classical
  set P₁ : Submodule R P :=
    Submodule.comap (I ^ n • (⊤ : Submodule R P)).mkQ (LinearMap.range s) with hP₁
  have hmemP₁ : ∀ q : P, q ∈ P₁ ↔
      Submodule.Quotient.mk (p := (I ^ n • ⊤ : Submodule R P)) q ∈ LinearMap.range s :=
    fun _ => Iff.rfl
  have hsurj : Function.Surjective (g ∘ₗ P₁.subtype) := by
    intro y
    obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective (I ^ n • (⊤ : Submodule R P))
      (s (Submodule.Quotient.mk y))
    have hgp : g p - y ∈ (I ^ n • ⊤ : Submodule R M) := by
      rw [← Submodule.Quotient.eq, ← LinearMap.reduceModIdeal_apply (I := I ^ n) g p, hp, hs]
    have hmap : g p - y ∈ Submodule.map g (I ^ n • (⊤ : Submodule R P)) := by
      rwa [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.2 hg]
    obtain ⟨q, hq, hgq⟩ := hmap
    refine ⟨⟨p - q, ?_⟩, ?_⟩
    · rw [hmemP₁, Submodule.Quotient.mk_sub, (Submodule.Quotient.mk_eq_zero _).2 hq, sub_zero]
      exact ⟨_, hp.symm⟩
    · simp only [LinearMap.comp_apply, Submodule.subtype_apply, map_sub, hgq]
      abel
  have := hproj (n + 1)
  obtain ⟨u, hu⟩ := Module.projective_lifting_property
    (LinearMap.reduceModIdeal (I ^ (n + 1)) (g ∘ₗ P₁.subtype))
    (LinearMap.id (R := R ⧸ I ^ (n + 1)) (M := M ⧸ (I ^ (n + 1) • ⊤ : Submodule R M)))
    (reduceModIdeal_surjective (I ^ (n + 1)) hsurj)
  set ι := LinearMap.reduceModIdeal (I ^ (n + 1)) P₁.subtype with hι
  have hgι : ∀ z, LinearMap.reduceModIdeal (I ^ (n + 1)) g (ι z) =
      LinearMap.reduceModIdeal (I ^ (n + 1)) (g ∘ₗ P₁.subtype) z := fun z => by
    rw [hι, reduceModIdeal_comp]
  have hrange : ∀ z, AdicCompletion.transitionMap I P (Nat.le_succ n) (ι z) ∈
      LinearMap.range s := by
    intro z
    obtain ⟨p, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    have hz : AdicCompletion.transitionMap I P (Nat.le_succ n) (ι (Submodule.Quotient.mk p)) =
        Submodule.Quotient.mk (p : P) := rfl
    rw [hz]
    exact (hmemP₁ _).1 p.2
  have e1 : ∀ x, LinearMap.reduceModIdeal (I ^ (n + 1)) g (ι (u x)) = x := fun x => by
    rw [hgι]
    exact LinearMap.congr_fun hu x
  refine ⟨LinearMap.restrictScalars R (ι ∘ₗ u), e1, fun x => ?_⟩
  · obtain ⟨m, hm⟩ := hrange (u x)
    have key : m = AdicCompletion.transitionMap I M (Nat.le_succ n) x := by
      calc m = LinearMap.reduceModIdeal (I ^ n) g (s m) := (hs m).symm
        _ = LinearMap.reduceModIdeal (I ^ n) g
              (AdicCompletion.transitionMap I P (Nat.le_succ n) (ι (u x))) := by rw [hm]
        _ = AdicCompletion.transitionMap I M (Nat.le_succ n)
              (LinearMap.reduceModIdeal (I ^ (n + 1)) g (ι (u x))) :=
            (transitionMap_reduceModIdeal I g (Nat.le_succ n) _).symm
        _ = _ := by rw [e1 x]
    rw [LinearMap.restrictScalars_apply, LinearMap.comp_apply, ← hm, key]

/-- The source's compatible system of splittings `sₙ : M/IⁿM → P/IⁿP`. -/
private lemma exists_compatible_splittings (hg : Function.Surjective g)
    (hproj : ∀ n : ℕ, Module.Projective (R ⧸ I ^ n) (M ⧸ (I ^ n • ⊤ : Submodule R M))) :
    ∃ s : (n : ℕ) → (M ⧸ (I ^ n • ⊤ : Submodule R M)) →ₗ[R] P ⧸ (I ^ n • ⊤ : Submodule R P),
      (∀ n x, LinearMap.reduceModIdeal (I ^ n) g (s n x) = x) ∧
      ∀ (m n : ℕ) (hmn : m ≤ n) x, AdicCompletion.transitionMap I P hmn (s n x) =
        s m (AdicCompletion.transitionMap I M hmn x) := by
  classical
  have h0 : ∀ x, LinearMap.reduceModIdeal (I ^ 0) g
      ((0 : (M ⧸ (I ^ 0 • ⊤ : Submodule R M)) →ₗ[R] P ⧸ (I ^ 0 • ⊤ : Submodule R P)) x) = x := by
    have := subsingleton_quotient_pow_zero (R := R) (A := M) I
    exact fun x => Subsingleton.elim _ _
  have hstep : ∀ (n : ℕ) (s : {s : (M ⧸ (I ^ n • ⊤ : Submodule R M)) →ₗ[R]
        P ⧸ (I ^ n • ⊤ : Submodule R P) //
        ∀ x, LinearMap.reduceModIdeal (I ^ n) g (s x) = x}),
      ∃ t : {t : (M ⧸ (I ^ (n + 1) • ⊤ : Submodule R M)) →ₗ[R]
          P ⧸ (I ^ (n + 1) • ⊤ : Submodule R P) //
          ∀ x, LinearMap.reduceModIdeal (I ^ (n + 1)) g (t x) = x},
        ∀ x, AdicCompletion.transitionMap I P (Nat.le_succ n) (t.1 x) =
          s.1 (AdicCompletion.transitionMap I M (Nat.le_succ n) x) := by
    intro n s
    obtain ⟨t, ht1, ht2⟩ := exists_splitting_succ I hg hproj n s.1 s.2
    exact ⟨⟨t, ht1⟩, ht2⟩
  choose F hF using hstep
  set σ : (n : ℕ) → {s : (M ⧸ (I ^ n • ⊤ : Submodule R M)) →ₗ[R]
      P ⧸ (I ^ n • ⊤ : Submodule R P) // ∀ x, LinearMap.reduceModIdeal (I ^ n) g (s x) = x} :=
    fun n => Nat.rec ⟨0, h0⟩ (fun k ih => F k ih) n with hσ
  have hσsucc : ∀ n x, AdicCompletion.transitionMap I P (Nat.le_succ n) ((σ (n + 1)).1 x) =
      (σ n).1 (AdicCompletion.transitionMap I M (Nat.le_succ n) x) := fun n => hF n (σ n)
  refine ⟨fun n => (σ n).1, fun n => (σ n).2, ?_⟩
  intro m n hmn
  induction n, hmn using Nat.le_induction with
  | base => intro x; rw [transitionMap_self, transitionMap_self]
  | succ n hmn ih =>
      intro x
      rw [← transitionMap_trans I hmn (Nat.le_succ n), hσsucc, ih,
        transitionMap_trans]

end Main

/-- Completion preserves a short exact sequence whose quotient is flat. This is the exactness
part of Stacks Tag 0315 (3); unlike `solution` below it does not assume that the reduction of the
quotient is projective, because no splitting is asserted. -/
public theorem shortExact_solution {R : Type u} [CommRing R]
    (I : Ideal R) {K : Type v} {P : Type w} {M : Type t} [AddCommGroup K] [Module R K]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M] [Module.Flat R M]
    {f : K →ₗ[R] P} {g : P →ₗ[R] M} (hf : Function.Injective f)
    (hfg : Function.Exact f g) (hg : Function.Surjective g) :
    Function.Injective (AdicCompletion.map I f) ∧
      Function.Exact (AdicCompletion.map I f) (AdicCompletion.map I g) ∧
      Function.Surjective (AdicCompletion.map I g) := by
  classical
  have hinj : ∀ n : ℕ, Function.Injective (LinearMap.reduceModIdeal (I ^ n) f) :=
    reduceModIdeal_injective I hf hfg hg
  refine ⟨?_, ?_, AdicCompletion.map_surjective I hg⟩
  · intro x y hxy
    refine AdicCompletion.ext fun n => hinj n ?_
    simpa only [AdicCompletion.map_val_apply] using congrArg (fun z => z.val n) hxy
  · refine fun y => ⟨fun hy => ?_, ?_⟩
    · have hyn : ∀ n, LinearMap.reduceModIdeal (I ^ n) g (y.val n) = 0 := fun n => by
        simpa only [AdicCompletion.map_val_apply, AdicCompletion.val_zero_apply] using
          congrArg (fun z => z.val n) hy
      choose c hc using fun n =>
        (LinearMap.reduceModIdeal_exact (I ^ n) f g hfg hg (y.val n)).1 (hyn n)
      have hcompat : ∀ {m n : ℕ} (hmn : m ≤ n),
          AdicCompletion.transitionMap I K hmn (c n) = c m := by
        intro m n hmn
        refine hinj m ?_
        rw [← transitionMap_reduceModIdeal, hc, hc]
        exact y.2 hmn
      refine ⟨(⟨c, hcompat⟩ : AdicCompletion I K), AdicCompletion.ext fun n => ?_⟩
      exact (AdicCompletion.map_val_apply I f _).trans (hc n)
    · rintro ⟨x, rfl⟩
      refine AdicCompletion.ext fun n => ?_
      rw [AdicCompletion.map_val_apply, AdicCompletion.map_val_apply, reduceModIdeal_comp,
        hfg.linearMap_comp_eq_zero]
      simp

/-- Completion of a short exact sequence `0 → K → P → M → 0` with `M` flat and `M/IM` projective
over `R ⧸ I` is again short exact, and `AdicCompletion.map I g` has a section. -/
public theorem solution {R : Type u} [CommRing R]
    (I : Ideal R) {K : Type v} {P : Type w} {M : Type t} [AddCommGroup K] [Module R K]
    [AddCommGroup P] [Module R P] [AddCommGroup M] [Module R M] [Module.Flat R M]
    {f : K →ₗ[R] P} {g : P →ₗ[R] M} (hf : Function.Injective f) (hfg : Function.Exact f g)
    (hg : Function.Surjective g)
    (hM : Module.Projective (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M))) :
    Function.Injective (AdicCompletion.map I f) ∧
      Function.Exact (AdicCompletion.map I f) (AdicCompletion.map I g) ∧
      ∃ s : AdicCompletion I M →ₗ[AdicCompletion I R] AdicCompletion I P,
        AdicCompletion.map I g ∘ₗ s = LinearMap.id := by
  obtain ⟨hinj, hex, -⟩ := shortExact_solution I hf hfg hg
  refine ⟨hinj, hex, ?_⟩
  obtain ⟨s, hs1, hs2⟩ := exists_compatible_splittings I hg
    (projective_quotient_pow I hM)
  refine ⟨{ toFun := fun x => ⟨fun n => s n (x.val n), fun {m n} hmn => ?_⟩
            map_add' := fun x y => ?_
            map_smul' := fun r x => ?_ }, ?_⟩
  · rw [hs2 m n hmn]
    exact congrArg _ (x.2 hmn)
  · exact AdicCompletion.ext fun n => by
      simp only [AdicCompletion.val_add_apply]
      exact map_add _ _ _
  · refine AdicCompletion.ext fun n => ?_
    simp only [AdicCompletion.smul_eval, RingHom.id_apply]
    exact smul_reduce (I ^ n) (s n) (r.val n) (x.val n)
  · refine LinearMap.ext fun x => AdicCompletion.ext fun n => ?_
    rw [LinearMap.comp_apply, AdicCompletion.map_val_apply, LinearMap.id_apply]
    exact hs1 n (x.val n)

end Stacks.AdicCompletion.SplitShortExact

