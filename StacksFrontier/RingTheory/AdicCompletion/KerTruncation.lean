module

public import Mathlib
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.AdicCompletion.KerEval

/-!
# The kernel of a truncation of an adic completion

For a finitely generated ideal `I` of a ring `L`, the kernel of the `n`-th truncation
`L^∧_I → L ⧸ I ^ n` is the ideal generated by `I ^ n` in the completion.

The equality of ideals for every `n` is `AdicCompletion.ker_evalₐ_eq_map_pow`, in
`StacksFrontier.RingTheory.AdicCompletion.KerEval`; this file draws the consequence that the
completion has the same adic truncations as the ring.

## Main results

* `AdicCompletion.bijective_quotientMapOfPow`: consequently `L ⧸ I ^ n → L^∧_I ⧸ I ^ n L^∧_I`
  is bijective, so the completion has the same adic truncations as `L`.
-/

@[expose] public noncomputable section

namespace AdicCompletion

universe u

variable {L : Type u} [CommRing L] (I : Ideal L) (n : ℕ)

/-- **The completion has the same adic truncations as the ring.** The canonical map
`L ⧸ I ^ n → L^∧_I ⧸ I ^ n L^∧_I` is bijective: the `n`-th truncation `L^∧_I → L ⧸ I ^ n` is
surjective with kernel exactly `I ^ n L^∧_I`, so it inverts the canonical map. -/
public theorem bijective_quotientMapOfPow (hI : I.FG) :
    Function.Bijective
      (IsScalarTower.toAlgHom L (L ⧸ I ^ n)
        (AdicCompletion I L ⧸
          Ideal.map (algebraMap L (AdicCompletion I L)) (I ^ n))) := by
  have hevalₐ : ∀ a : L, AdicCompletion.evalₐ I n (algebraMap L (AdicCompletion I L) a) =
      Ideal.Quotient.mk (I ^ n) a := fun a => (AdicCompletion.evalₐ I n).commutes a
  have key : ∀ (a : L) (x : AdicCompletion I L),
      (IsScalarTower.toAlgHom L (L ⧸ I ^ n)
        (AdicCompletion I L ⧸ Ideal.map (algebraMap L (AdicCompletion I L)) (I ^ n)))
          (Ideal.Quotient.mk (I ^ n) a) = Ideal.Quotient.mk _ x ↔
        AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) a := by
    intro a x
    change Ideal.Quotient.mk _ (algebraMap L (AdicCompletion I L) a) = _ ↔ _
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, ← AdicCompletion.ker_evalₐ_eq_map_pow I hI n,
      RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub,
      hevalₐ, sub_eq_zero, eq_comm]
  constructor
  · intro z w hzw
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective w
    exact (hevalₐ a).symm.trans ((key b _).mp hzw.symm)
  · intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
    exact ⟨Ideal.Quotient.mk (I ^ n) a, (key a x).mpr ha.symm⟩

end AdicCompletion

end
