module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import StacksFrontier.RingTheory.DividedPowers.Extend
import StacksCore.Tactic.EgaSgaAttribute

/-!
# `p`-adic completion is functorial for additive and for bilinear maps

Let `R` be a commutative ring and let `p` be a natural number.  Completion along an arbitrary
ideal `I` is functorial only for `R`-linear maps: an additive map `f : X →+ Y` need not satisfy
`f (Iⁿ X) ⊆ Iⁿ Y`, so it induces nothing on the towers.  Along the ideal `(p)` it does, because
`(p)ⁿ` is generated by the *integer* `pⁿ`: the submodule `(p)ⁿ • X` is the subgroup `pⁿ X`
(`Crystalline.PAdicCompletion.mem_pow_smul_top_iff`), and every additive map is `ℤ`-linear.

This file makes that observation into the two constructions the completed crystalline objects are
built from.

* `Crystalline.PAdicCompletion.mapAddHom` sends an additive map `f : X →+ Y` to an additive map
  `X^∧ →+ Y^∧` between the `p`-adic completions, level by level.  It is what carries the de Rham
  differential of [Stacks, Tag 07HZ] — which is linear over the base ring and emphatically not
  over the ring being differentiated — to the completed forms.  Were the map `R`-linear one would
  use `AdicCompletion.map`; for an additive one there is no such thing, and working at the levels
  is what replaces it.  Source and target may be modules over two *different* rings `R` and `S`,
  with nothing relating the two scalar actions: it is the integer `pⁿ` that cuts out the level on
  either side, so no compatibility is needed.  `Crystalline.PAdicCompletion.mapRingHom` is the
  consequence for a ring map `R →+* S`, whose levels `R/pⁿR → S/pⁿS` are ring maps.
* `Crystalline.PAdicCompletion.mapBilinear` sends an `R`-bilinear map
  `b : X →ₗ[R] Y →ₗ[R] Z` to a bilinear map `X^∧ →ₗ[R^∧] Y^∧ →ₗ[R^∧] Z^∧`, again level by
  level.  This cannot be `AdicCompletion.map`: completion is not monoidal, so there is no map
  `X^∧ ⊗ Y^∧ → (X ⊗ Y)^∧` to push `b` along.  It is what carries the wedge product of forms to
  the completed forms, and the bilinearity it produces is over the *completed* ring `R^∧`, which
  is what the completed de Rham complex needs.

Both constructions are pinned by their behaviour on the dense image of the uncompleted module:
`mapAddHom_of`, `mapBilinear_of_of`, and the uniqueness statements `mapAddHom_eq_of_val` and
`mapBilinear_eq_of_val`.

## Main definitions

* `Crystalline.PAdicCompletion.levelMap` — the level-`pⁿ` reduction of an additive map.
* `Crystalline.PAdicCompletion.mapAddHom` — **the `p`-adic completion of an additive map**,
  between modules over two base rings.
* `Crystalline.PAdicCompletion.mapRingHom` — **the `p`-adic completion of a ring map**
  `R →+* S`, as a ring map `R^∧ →+* S^∧`.
* `Crystalline.PAdicCompletion.levelMapBilinear` — the level-`pⁿ` reduction of a bilinear map.
* `Crystalline.PAdicCompletion.mapBilinear` — **the `p`-adic completion of a bilinear map**, as a
  bilinear map over the completed ring.

## Main results

* `Crystalline.PAdicCompletion.mem_pow_smul_top_iff` — **`(p)ⁿ • X` is the subgroup `pⁿ X`.**
* `Crystalline.PAdicCompletion.map_mem_pow_smul_top` — hence an additive map preserves the levels.
* `Crystalline.PAdicCompletion.mapAddHom_of`, `Crystalline.PAdicCompletion.mapAddHom_id`,
  `Crystalline.PAdicCompletion.mapAddHom_comp`, `Crystalline.PAdicCompletion.mapAddHom_add` —
  functoriality and additivity in the map.
* `Crystalline.PAdicCompletion.mapAddHom_eq_adicCompletionMap` — on an `R`-linear map it agrees
  with `AdicCompletion.map`, so nothing is a second construction of an existing thing.
* `Crystalline.PAdicCompletion.mapAddHom_eq_of_val` and
  `Crystalline.PAdicCompletion.mapBilinear_eq_of_val` — locality at the levels together with the
  value on the image of the uncompleted module determines the result.

## References

* [Stacks Project, Tag 07HZ](https://stacks.math.columbia.edu/tag/07HZ)
* [Stacks Project, Lemma 60.17.3, Tag 07JG](https://stacks.math.columbia.edu/tag/07JG)
-/

@[expose] public section

open DividedPowers

universe u u' u'' v w t

namespace Crystalline

namespace PAdicCompletion

variable (p : ℕ) (R : Type u) [CommRing R]

/-! ### The levels of a `p`-adic filtration -/

section Levels

variable {X : Type v} [AddCommGroup X] [Module R X]

/-- **The level-`n` submodule of the `p`-adic filtration is the subgroup `pⁿ X`.**  The ideal
`(p)ⁿ` is generated by the single element `(p : R)ⁿ`, which is the image of the integer `pⁿ`, so
multiplying by it is taking an `ℕ`-multiple.  This is the reason additive maps descend to the
levels. -/
public theorem mem_pow_smul_top_iff (n : ℕ) (z : X) :
    z ∈ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) ↔ ∃ y : X, z = (p ^ n : ℕ) • y := by
  constructor
  · intro hz
    refine Submodule.smul_induction_on hz ?_ ?_
    · intro c hc y _
      rw [pAdicIdeal, Ideal.span_singleton_pow] at hc
      obtain ⟨e, rfl⟩ := Ideal.mem_span_singleton'.mp hc
      exact ⟨e • y, by rw [mul_comm, mul_smul, ← Nat.cast_pow, Nat.cast_smul_eq_nsmul]⟩
    · rintro a b ⟨u, rfl⟩ ⟨v, rfl⟩
      exact ⟨u + v, (smul_add _ u v).symm⟩
  · rintro ⟨y, rfl⟩
    rw [← Nat.cast_smul_eq_nsmul R]
    refine Submodule.smul_mem_smul ?_ Submodule.mem_top
    rw [pAdicIdeal, Ideal.span_singleton_pow, Nat.cast_pow]
    exact Ideal.mem_span_singleton_self _

/-- **An additive map preserves the levels of a `p`-adic filtration, even between modules over
two different base rings.**  It is `ℤ`-linear, and by
`Crystalline.PAdicCompletion.mem_pow_smul_top_iff` the level is cut out on either side by
multiplication by the integer `pⁿ`, which is what makes the two filtrations correspond with no
compatibility between the two scalar actions. -/
public theorem map_mem_pow_smul_top (S : Type u') [CommRing S] {Y : Type w} [AddCommGroup Y]
    [Module S Y] (f : X →+ Y) (n : ℕ) {z : X}
    (hz : z ∈ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X)) :
    f z ∈ (pAdicIdeal (A := S) p ^ n • ⊤ : Submodule S Y) := by
  obtain ⟨y, rfl⟩ := (mem_pow_smul_top_iff p R n z).mp hz
  exact (mem_pow_smul_top_iff p S n _).mpr ⟨f y, by rw [map_nsmul]⟩

/-- The transition map of a `p`-adic completion fixes the class of an element. -/
public theorem transitionMap_mk {m n : ℕ} (hmn : m ≤ n) (y : X) :
    AdicCompletion.transitionMap (pAdicIdeal (A := R) p) X hmn (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk y := by
  simp [AdicCompletion.transitionMap]

end Levels

/-! ### The completion of an additive map -/

section Additive

variable (S : Type u') [CommRing S] {X : Type v} [AddCommGroup X] [Module R X]
  {Y : Type w} [AddCommGroup Y] [Module S Y]

/-- The level-`pⁿ` reduction of an additive map.  Source and target are modules over two
*different* base rings: the reduction exists all the same, because on either side the level is
cut out by the integer `pⁿ`. -/
public noncomputable def levelMap (f : X →+ Y) (n : ℕ) :
    X ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) →+
      Y ⧸ (pAdicIdeal (A := S) p ^ n • ⊤ : Submodule S Y) :=
  QuotientAddGroup.lift (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X).toAddSubgroup
    (((pAdicIdeal (A := S) p ^ n • ⊤ : Submodule S Y).mkQ).toAddMonoidHom.comp f)
    (fun y hy ↦ by
      rw [AddMonoidHom.mem_ker]
      change Submodule.Quotient.mk (f y) = (0 : Y ⧸ (pAdicIdeal (A := S) p ^ n • ⊤))
      rw [Submodule.Quotient.mk_eq_zero]
      exact map_mem_pow_smul_top p R S f n hy)

@[simp] public theorem levelMap_mk (f : X →+ Y) (n : ℕ) (y : X) :
    levelMap p R S f n (Submodule.Quotient.mk y) = Submodule.Quotient.mk (f y) := rfl

/-- The level-`pⁿ` reduction is additive in the map. -/
public theorem levelMap_add (f g : X →+ Y) (n : ℕ) :
    levelMap p R S (f + g) n = levelMap p R S f n + levelMap p R S g n := by
  refine AddMonoidHom.ext fun z ↦ ?_
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) z
  simp only [levelMap_mk, AddMonoidHom.add_apply, Submodule.Quotient.mk_add]

/-- The level-`pⁿ` reduction of the zero map is zero. -/
public theorem levelMap_zero (n : ℕ) : levelMap p R S (0 : X →+ Y) n = 0 := by
  refine AddMonoidHom.ext fun z ↦ ?_
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) z
  simpa only [levelMap_mk, AddMonoidHom.zero_apply] using
    (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.zero_mem _)

/-- **The `p`-adic completion of an additive map**, as a function: at every level `pⁿ` it is the
level-`pⁿ` reduction of the map. -/
public noncomputable def mapAddHomFun (f : X →+ Y) (z : AdicCompletion (pAdicIdeal (A := R) p) X) :
    AdicCompletion (pAdicIdeal (A := S) p) Y :=
  ⟨fun n ↦ levelMap p R S f n (z.val n), by
    intro m n hmn
    obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective
      (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) (z.val n)
    have hzm : z.val m = Submodule.Quotient.mk y := by
      rw [← z.property hmn, ← hy, transitionMap_mk p R hmn]
    change AdicCompletion.transitionMap (pAdicIdeal (A := S) p) Y hmn
        (levelMap p R S f n (z.val n)) = levelMap p R S f m (z.val m)
    rw [hzm, ← hy, levelMap_mk, levelMap_mk, transitionMap_mk]⟩

@[simp] public theorem mapFun_val (f : X →+ Y) (n : ℕ)
    (z : AdicCompletion (pAdicIdeal (A := R) p) X) :
    (mapAddHomFun p R S f z).val n = levelMap p R S f n (z.val n) := rfl

/-- **The `p`-adic completion of an additive map.**  Completion along an arbitrary ideal is
functorial only for linear maps; along `(p)` it is functorial for additive maps, because the
levels are cut out by the integer `pⁿ`.  For the same reason the source and the target may be
modules over two different rings `R` and `S`, with nothing relating the two scalar actions:
`AdicCompletion.map` is the case of one ring and a linear map, and even
`Crystalline.adicCompletionMapₛₗ`, which handles a semilinear map along a ring map carrying one
ideal into the other, asks for that ring map, which this does not. -/
public noncomputable def mapAddHom (f : X →+ Y) :
    AdicCompletion (pAdicIdeal (A := R) p) X →+ AdicCompletion (pAdicIdeal (A := S) p) Y :=
  AddMonoidHom.mk' (mapAddHomFun p R S f) (fun z w ↦ by
    refine AdicCompletion.ext fun n ↦ ?_
    rw [AdicCompletion.val_add_apply]
    change levelMap p R S f n ((z + w).val n) =
      levelMap p R S f n (z.val n) + levelMap p R S f n (w.val n)
    rw [AdicCompletion.val_add_apply, map_add])

@[simp] public theorem mapAddHom_val (f : X →+ Y) (n : ℕ)
    (z : AdicCompletion (pAdicIdeal (A := R) p) X) :
    (mapAddHom p R S f z).val n = levelMap p R S f n (z.val n) := rfl

/-- The completion of an additive map commutes with the canonical map from the uncompleted
module. -/
@[simp] public theorem mapAddHom_of (f : X →+ Y) (y : X) :
    mapAddHom p R S f (AdicCompletion.of (pAdicIdeal (A := R) p) X y) =
      AdicCompletion.of (pAdicIdeal (A := S) p) Y (f y) :=
  AdicCompletion.ext fun _ ↦ rfl

/-- **The completion of an additive map is determined** by its locality at the levels together
with the value of the map on a representative.  Nothing in the construction is a choice. -/
public theorem mapAddHom_eq_of_val (f : X →+ Y)
    (g : AdicCompletion (pAdicIdeal (A := R) p) X →+ AdicCompletion (pAdicIdeal (A := S) p) Y)
    (h : ∀ (n : ℕ) (z : AdicCompletion (pAdicIdeal (A := R) p) X) (y : X),
      z.val n = Submodule.Quotient.mk y → (g z).val n = Submodule.Quotient.mk (f y)) :
    g = mapAddHom p R S f := by
  refine AddMonoidHom.ext fun z ↦ AdicCompletion.ext fun n ↦ ?_
  obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) (z.val n)
  rw [h n z y hy.symm, mapAddHom_val, ← hy, levelMap_mk]

/-- The completion of a composite is the composite of the completions, across three base
rings. -/
public theorem mapAddHom_comp (T : Type u'') [CommRing T] {Z : Type t} [AddCommGroup Z]
    [Module T Z] (f : X →+ Y) (g : Y →+ Z) :
    mapAddHom p R T (g.comp f) = (mapAddHom p S T g).comp (mapAddHom p R S f) := by
  refine (mapAddHom_eq_of_val p R T (g.comp f)
    ((mapAddHom p S T g).comp (mapAddHom p R S f)) ?_).symm
  intro n z y hz
  simp only [AddMonoidHom.coe_comp, Function.comp_apply, mapAddHom_val, hz, levelMap_mk]

/-- The completion of a sum of additive maps is the sum of their completions. -/
public theorem mapAddHom_add (f g : X →+ Y) :
    mapAddHom p R S (f + g) = mapAddHom p R S f + mapAddHom p R S g := by
  refine AddMonoidHom.ext fun z ↦ AdicCompletion.ext fun n ↦ ?_
  rw [mapAddHom_val, levelMap_add, AddMonoidHom.add_apply, AddMonoidHom.add_apply,
    AdicCompletion.val_add_apply, mapAddHom_val, mapAddHom_val]

/-- The completion of the zero map is zero. -/
public theorem mapAddHom_zero : mapAddHom p R S (0 : X →+ Y) = 0 := by
  refine AddMonoidHom.ext fun z ↦ AdicCompletion.ext fun n ↦ ?_
  rw [mapAddHom_val, levelMap_zero, AddMonoidHom.zero_apply, AddMonoidHom.zero_apply,
    AdicCompletion.val_zero_apply]

end Additive

/-! ### The one-ring case: comparison with `AdicCompletion.map` -/

section OneRing

variable {X : Type v} [AddCommGroup X] [Module R X] {Y : Type w} [AddCommGroup Y] [Module R Y]

/-- The completion of the identity is the identity. -/
public theorem mapAddHom_id : mapAddHom p R R (AddMonoidHom.id X) = AddMonoidHom.id _ :=
  (mapAddHom_eq_of_val p R R (AddMonoidHom.id X) (AddMonoidHom.id _)
    (fun _ _ _ hz ↦ hz)).symm ▸ rfl

/-- **On an `R`-linear map the construction agrees with `AdicCompletion.map`**, so it is not a
second completion of an existing notion but an extension of it to maps that are merely
additive. -/
public theorem mapAddHom_eq_adicCompletionMap (f : X →ₗ[R] Y) :
    mapAddHom p R R f.toAddMonoidHom =
      (AdicCompletion.map (pAdicIdeal (A := R) p) f).toAddMonoidHom := by
  refine (mapAddHom_eq_of_val p R R f.toAddMonoidHom _ ?_).symm
  intro n z y hz
  show (AdicCompletion.map (pAdicIdeal (A := R) p) f z).val n = Submodule.Quotient.mk (f y)
  rw [AdicCompletion.map_val_apply, hz]
  rfl

end OneRing

/-! ### The completion of a ring map -/

section RingMap

variable (S : Type u') [CommRing S]

/-- **The `p`-adic completion of a ring map**, as a ring map `B^∧ →+* C^∧`.  The additive part is
`Crystalline.PAdicCompletion.mapAddHom`, which exists because `(p)ⁿ` is cut out by the integer
`pⁿ` on either side; multiplicativity and unitality are then read off at each level, where they
are those of `f` itself.

This is what a map of *completed* de Rham complexes needs that
`Crystalline.adicCompletionMapₛₗ` does not supply: a comparison of completed forms is semilinear
over the map of the **uncompleted** rings `B → C`, while the complexes are built over the
completed rings `B^∧` and `C^∧`, so the ring map between those has to exist before the
semilinearity can be restated over it.

Mathlib's `AdicCompletion.liftRingHom` is a different construction: it assembles a compatible
family of ring maps `R →+* S ⧸ Iⁿ` into a map `R →+* S^∧`, for one ideal of one ring, and so says
nothing about a ring map between two completions taken along two ideals. -/
@[sga "1 IV 5.8" "special case"]
public noncomputable def mapRingHom (f : R →+* S) :
    AdicCompletion (pAdicIdeal (A := R) p) R →+* AdicCompletion (pAdicIdeal (A := S) p) S where
  toFun := mapAddHom p R S f.toAddMonoidHom
  map_zero' := map_zero _
  map_add' := map_add _
  map_one' := by
    refine AdicCompletion.ext fun n ↦ ?_
    rw [mapAddHom_val]
    change levelMap p R S f.toAddMonoidHom n (Submodule.Quotient.mk 1) = _
    rw [levelMap_mk]
    change (Submodule.Quotient.mk (f 1) :
      S ⧸ (pAdicIdeal (A := S) p ^ n • ⊤ : Submodule S S)) = _
    rw [map_one]
    rfl
  map_mul' x y := by
    refine AdicCompletion.ext fun n ↦ ?_
    obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective
      (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R R) (x.val n)
    obtain ⟨b, hb⟩ := Submodule.Quotient.mk_surjective
      (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R R) (y.val n)
    have hxy : (x * y).val n = Submodule.Quotient.mk (a * b) := by
      rw [AdicCompletion.val_mul, ← ha, ← hb]
      rfl
    rw [mapAddHom_val, hxy, levelMap_mk, AdicCompletion.val_mul, mapAddHom_val,
      mapAddHom_val, ← ha, ← hb, levelMap_mk, levelMap_mk]
    change (Submodule.Quotient.mk (f (a * b)) :
      S ⧸ (pAdicIdeal (A := S) p ^ n • ⊤ : Submodule S S)) = _
    rw [map_mul]
    rfl

@[simp] public theorem mapRingHom_val (f : R →+* S) (n : ℕ)
    (x : AdicCompletion (pAdicIdeal (A := R) p) R) :
    (mapRingHom p R S f x).val n = levelMap p R S f.toAddMonoidHom n (x.val n) := rfl

/-- The completion of a ring map commutes with the canonical map from the uncompleted ring. -/
@[simp] public theorem mapRingHom_of (f : R →+* S) (a : R) :
    mapRingHom p R S f (AdicCompletion.of (pAdicIdeal (A := R) p) R a) =
      AdicCompletion.of (pAdicIdeal (A := S) p) S (f a) :=
  mapAddHom_of p R S f.toAddMonoidHom a

/-- The completion of a ring map is its completion as an additive map. -/
public theorem mapRingHom_toAddMonoidHom (f : R →+* S) :
    (mapRingHom p R S f).toAddMonoidHom = mapAddHom p R S f.toAddMonoidHom := rfl

end RingMap

/-! ### The completion of a bilinear map -/

section Bilinear

variable {X : Type v} [AddCommGroup X] [Module R X] {Y : Type w} [AddCommGroup Y] [Module R Y]
  {Z : Type t} [AddCommGroup Z] [Module R Z]

/-- The level-`pⁿ` reduction of a bilinear map.  A bi-additive map kills `pⁿ` in either slot, so
it descends to the levels in both variables at once. -/
public noncomputable def levelMapBilinear (b : X →ₗ[R] Y →ₗ[R] Z) (n : ℕ) :
    X ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) →+
      (Y ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y) →+
        Z ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Z)) :=
  QuotientAddGroup.lift (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X).toAddSubgroup
    (AddMonoidHom.mk' (fun x ↦ levelMap p R R (b x).toAddMonoidHom n) (fun x x' ↦ by
      have hsum : (b (x + x')).toAddMonoidHom =
          (b x).toAddMonoidHom + (b x').toAddMonoidHom := by
        refine AddMonoidHom.ext fun y ↦ ?_
        change b (x + x') y = b x y + b x' y
        rw [map_add, LinearMap.add_apply]
      rw [hsum, levelMap_add]))
    (fun x hx ↦ by
      rw [AddMonoidHom.mem_ker]
      refine AddMonoidHom.ext fun z ↦ ?_
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective
        (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y) z
      obtain ⟨x', rfl⟩ := (mem_pow_smul_top_iff p R n x).mp hx
      have hval : b ((p ^ n : ℕ) • x') y = (p ^ n : ℕ) • b x' y := by
        rw [map_nsmul]
        rfl
      change Submodule.Quotient.mk (b ((p ^ n : ℕ) • x') y) =
        (0 : Z ⧸ (pAdicIdeal (A := R) p ^ n • ⊤))
      rw [hval, Submodule.Quotient.mk_eq_zero]
      exact (mem_pow_smul_top_iff p R n _).mpr ⟨b x' y, rfl⟩)

@[simp] public theorem levelMapBilinear_mk_mk (b : X →ₗ[R] Y →ₗ[R] Z) (n : ℕ) (x : X) (y : Y) :
    levelMapBilinear p R b n (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk (b x y) := rfl

/-- The level-`pⁿ` reduction of a bilinear map is linear over `R ⧸ (p)ⁿ` in its first
variable. -/
public theorem levelMapBilinear_smul_left (b : X →ₗ[R] Y →ₗ[R] Z) (n : ℕ)
    (c : R ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R R))
    (u : X ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X))
    (v : Y ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y)) :
    levelMapBilinear p R b n (c • u) v = c • levelMapBilinear p R b n u v := by
  obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R R) c
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) u
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y) v
  change Submodule.Quotient.mk (b (r • x) y) = Submodule.Quotient.mk (r • b x y)
  rw [map_smul, LinearMap.smul_apply]

/-- The level-`pⁿ` reduction of a bilinear map is linear over `R ⧸ (p)ⁿ` in its second
variable. -/
public theorem levelMapBilinear_smul_right (b : X →ₗ[R] Y →ₗ[R] Z) (n : ℕ)
    (c : R ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R R))
    (u : X ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X))
    (v : Y ⧸ (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y)) :
    levelMapBilinear p R b n u (c • v) = c • levelMapBilinear p R b n u v := by
  obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R R) c
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) u
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y) v
  change Submodule.Quotient.mk (b x (r • y)) = Submodule.Quotient.mk (r • b x y)
  rw [map_smul]

/-- **The `p`-adic completion of a bilinear map**, as a function of two completed arguments: at
every level `pⁿ` it is the level-`pⁿ` reduction of the map. -/
public noncomputable def mapBilinearFun (b : X →ₗ[R] Y →ₗ[R] Z)
    (z : AdicCompletion (pAdicIdeal (A := R) p) X)
    (w : AdicCompletion (pAdicIdeal (A := R) p) Y) :
    AdicCompletion (pAdicIdeal (A := R) p) Z :=
  ⟨fun n ↦ levelMapBilinear p R b n (z.val n) (w.val n), by
    intro m n hmn
    obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective
      (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) (z.val n)
    obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective
      (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y) (w.val n)
    have hzm : z.val m = Submodule.Quotient.mk x := by
      rw [← z.property hmn, ← hx, transitionMap_mk p R hmn]
    have hwm : w.val m = Submodule.Quotient.mk y := by
      rw [← w.property hmn, ← hy, transitionMap_mk p R hmn]
    change AdicCompletion.transitionMap (pAdicIdeal (A := R) p) Z hmn
        (levelMapBilinear p R b n (z.val n) (w.val n)) =
      levelMapBilinear p R b m (z.val m) (w.val m)
    rw [hzm, hwm, ← hx, ← hy, levelMapBilinear_mk_mk, levelMapBilinear_mk_mk,
      transitionMap_mk]⟩

@[simp] public theorem mapBilinearFun_val (b : X →ₗ[R] Y →ₗ[R] Z) (n : ℕ)
    (z : AdicCompletion (pAdicIdeal (A := R) p) X)
    (w : AdicCompletion (pAdicIdeal (A := R) p) Y) :
    (mapBilinearFun p R b z w).val n = levelMapBilinear p R b n (z.val n) (w.val n) := rfl

/-- **The `p`-adic completion of an `R`-bilinear map**, as a bilinear map over the completed ring
`R^∧`.  Completion is not monoidal, so this is not `AdicCompletion.map` of anything: it is built
level by level, and the resulting bilinearity over `R^∧` is read off from the level-`pⁿ`
bilinearity over `R ⧸ (p)ⁿ`. -/
public noncomputable def mapBilinear (b : X →ₗ[R] Y →ₗ[R] Z) :
    AdicCompletion (pAdicIdeal (A := R) p) X →ₗ[AdicCompletion (pAdicIdeal (A := R) p) R]
      AdicCompletion (pAdicIdeal (A := R) p) Y →ₗ[AdicCompletion (pAdicIdeal (A := R) p) R]
        AdicCompletion (pAdicIdeal (A := R) p) Z where
  toFun z :=
    { toFun := mapBilinearFun p R b z
      map_add' := fun w w' ↦ by
        refine AdicCompletion.ext fun n ↦ ?_
        rw [mapBilinearFun_val, AdicCompletion.val_add_apply, map_add,
          AdicCompletion.val_add_apply, mapBilinearFun_val, mapBilinearFun_val]
      map_smul' := fun c w ↦ AdicCompletion.ext fun n ↦ by
        have h1 : (mapBilinearFun p R b z (c • w)).val n =
            levelMapBilinear p R b n (z.val n) (c.val n • w.val n) := by
          rw [mapBilinearFun_val, AdicCompletion.smul_eval]
        have h2 : (c • mapBilinearFun p R b z w).val n =
            c.val n • levelMapBilinear p R b n (z.val n) (w.val n) := by
          rw [AdicCompletion.smul_eval, mapBilinearFun_val]
        change (mapBilinearFun p R b z (c • w)).val n =
          (c • mapBilinearFun p R b z w).val n
        rw [h1, h2]
        exact levelMapBilinear_smul_right p R b n (c.val n) (z.val n) (w.val n) }
  map_add' z z' := by
    refine LinearMap.ext fun w ↦ AdicCompletion.ext fun n ↦ ?_
    change levelMapBilinear p R b n ((z + z').val n) (w.val n) = _
    rw [AdicCompletion.val_add_apply, map_add, AddMonoidHom.add_apply]
    rfl
  map_smul' c z := by
    refine LinearMap.ext fun w ↦ AdicCompletion.ext fun n ↦ ?_
    have h1 : (mapBilinearFun p R b (c • z) w).val n =
        levelMapBilinear p R b n (c.val n • z.val n) (w.val n) := by
      rw [mapBilinearFun_val, AdicCompletion.smul_eval]
    have h2 : (c • mapBilinearFun p R b z w).val n =
        c.val n • levelMapBilinear p R b n (z.val n) (w.val n) := by
      rw [AdicCompletion.smul_eval, mapBilinearFun_val]
    change (mapBilinearFun p R b (c • z) w).val n = (c • mapBilinearFun p R b z w).val n
    rw [h1, h2]
    exact levelMapBilinear_smul_left p R b n (c.val n) (z.val n) (w.val n)

@[simp] public theorem mapBilinear_apply (b : X →ₗ[R] Y →ₗ[R] Z)
    (z : AdicCompletion (pAdicIdeal (A := R) p) X)
    (w : AdicCompletion (pAdicIdeal (A := R) p) Y) :
    mapBilinear p R b z w = mapBilinearFun p R b z w := rfl

@[simp] public theorem mapBilinear_val (b : X →ₗ[R] Y →ₗ[R] Z) (n : ℕ)
    (z : AdicCompletion (pAdicIdeal (A := R) p) X)
    (w : AdicCompletion (pAdicIdeal (A := R) p) Y) :
    (mapBilinear p R b z w).val n = levelMapBilinear p R b n (z.val n) (w.val n) := by
  rw [mapBilinear_apply, mapBilinearFun_val]

/-- The completion of a bilinear map commutes with the canonical maps from the uncompleted
modules. -/
@[simp] public theorem mapBilinear_of_of (b : X →ₗ[R] Y →ₗ[R] Z) (x : X) (y : Y) :
    mapBilinear p R b (AdicCompletion.of (pAdicIdeal (A := R) p) X x)
        (AdicCompletion.of (pAdicIdeal (A := R) p) Y y) =
      AdicCompletion.of (pAdicIdeal (A := R) p) Z (b x y) := by
  refine AdicCompletion.ext fun n ↦ ?_
  rw [mapBilinear_val]
  rfl

/-- **The completion of a bilinear map is determined** by its locality at the levels together
with the value of the map on representatives. -/
public theorem mapBilinear_eq_of_val (b : X →ₗ[R] Y →ₗ[R] Z)
    (g : AdicCompletion (pAdicIdeal (A := R) p) X →
      AdicCompletion (pAdicIdeal (A := R) p) Y → AdicCompletion (pAdicIdeal (A := R) p) Z)
    (h : ∀ (n : ℕ) (z : AdicCompletion (pAdicIdeal (A := R) p) X)
      (w : AdicCompletion (pAdicIdeal (A := R) p) Y) (x : X) (y : Y),
      z.val n = Submodule.Quotient.mk x → w.val n = Submodule.Quotient.mk y →
        (g z w).val n = Submodule.Quotient.mk (b x y))
    (z : AdicCompletion (pAdicIdeal (A := R) p) X)
    (w : AdicCompletion (pAdicIdeal (A := R) p) Y) :
    g z w = mapBilinear p R b z w := by
  refine AdicCompletion.ext fun n ↦ ?_
  obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R X) (z.val n)
  obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective
    (pAdicIdeal (A := R) p ^ n • ⊤ : Submodule R Y) (w.val n)
  rw [h n z w x y hx.symm hy.symm, mapBilinear_val, ← hx, ← hy, levelMapBilinear_mk_mk]

end Bilinear

