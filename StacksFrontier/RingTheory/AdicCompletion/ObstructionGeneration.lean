module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.Completeness
public import Mathlib.RingTheory.AdicCompletion.Functoriality
public import StacksFrontier.RingTheory.AdicCompletion.NoetherianRing
public import StacksFrontier.RingTheory.Module.FiniteFromAdicReduction
public import StacksFrontier.RingTheory.Noetherian.CommutingShifts

/-!
# Obstruction modules over the completion, and eventual generation in degree one

Let `I = (f_l)` be an ideal of a Noetherian ring `A`, let `V` and `E₀, E₁, …` be `A`-modules, and
suppose given maps `μ_a : V → E_n` for `a ∈ I ^ (n + 1)`, linear in `a`, and shifts
`ρ_l : E_n → E_{n+1}` with `ρ_l ∘ μ_a = μ_{f_l a}`. In the proof of [Stacks, Tag 0EJI] these are
`V = H¹(U, F)`, `E_n = H¹(U, I^{n+1} F)` for `F = lim F_n`, `μ_a` and `ρ_l` the maps on cohomology
induced by multiplication by `a` and by `f_l`; the source considers the submodules
`Ob'_n ⊆ lim_N H¹(U, I^{n+1} F_N)` generated by the images of `Ob = lim_N H¹(U, F_N)` and
observes that `⨁ₙ Ob'_n` is a finite graded module over the Rees algebra of `I`.

Here the role of the limit modules is played by the `I`-adic completions `E_n^∧` and `V^∧`, which
are modules over the completion `A^∧`, and `Ob'_n` becomes the `A^∧`-submodule
`P_n = ∑_{a ∈ I^{n+1}} μ_a^∧(V^∧)` of `E_n^∧`. When `V / IV` is a finite `A`-module, `V^∧` is a
finite `A^∧`-module ([Stacks, Tag 031D] in the form of the surjectivity of completed maps), so
`⨁ₙ P_n` is generated in degree zero by a finite `A^∧`-module. Since `A^∧` is Noetherian, every
shift-stable family of `I`-power torsion `A`-submodules `D_n ⊆ P_n` — these are automatically
`A^∧`-submodules — is generated in degree one above some degree. This is the input `hgen` of
`Stacks.Cohomology.EventualLifting.isMittagLefflerCategorical_of_eventualLifting`.

## Main definitions

* `Stacks.AdicObstruction.obstructionSpan` — the `A^∧`-submodule `P_n` of `E_n^∧`.

## Main results

* `Stacks.AdicObstruction.smul_mem_of_pow_smul_eq_bot` — an `I`-power torsion `A`-submodule of an
  `A^∧`-module is stable under `A^∧`.
* `Stacks.AdicObstruction.exists_eventual_sum_shift_of_adicCompletion` — eventual generation in
  degree one of stable families of `I`-power torsion submodules over `A^∧`.
* `Stacks.AdicObstruction.finite_quotient_smul_top_of_ker_le` — finiteness of `M / IM` from a map
  with finite image whose kernel lies in `IM`.
* `Stacks.AdicObstruction.of_mem_obstructionSpan`, `map_mem_obstructionSpan`,
  `exists_eq_sum_map_of_mem_obstructionSpan`, `finite_obstructionSpan_zero` and
  `exists_eventual_sum_shift_of_obstructionSpan` — the properties of the `P_n`.

## References

* [Stacks Project, Tag 0EJI](https://stacks.math.columbia.edu/tag/0EJI)
* [Stacks Project, Tag 031D](https://stacks.math.columbia.edu/tag/031D)
-/

@[expose] public noncomputable section

universe u v w

namespace Stacks.AdicObstruction

variable {A : Type u} [CommRing A] (I : Ideal A)

/-! ### Truncations of elements of the completion -/

/-- An element of `A^∧` differs from the image of an element of `A` by an element of
`I ^ n • A^∧`. -/
theorem exists_sub_algebraMap_mem (hI : I.FG) (n : ℕ) (b : AdicCompletion I A) :
    ∃ a : A, b - algebraMap A (AdicCompletion I A) a ∈
      (I ^ n • ⊤ : Submodule A (AdicCompletion I A)) := by
  obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective (I ^ n • ⊤ : Submodule A A) (b.val n)
  refine ⟨a, ?_⟩
  rw [AdicCompletion.pow_smul_top_eq_ker_eval hI, LinearMap.mem_ker, map_sub,
    AdicCompletion.algebraMap_apply, AdicCompletion.eval_of, AdicCompletion.eval_apply,
    sub_eq_zero, ← ha]
  rfl

/-! ### Torsion submodules are stable under the completion -/

/-- **An `I`-power torsion submodule is an `A^∧`-submodule.** If `M` is an `A^∧`-module and
`D ⊆ M` an `A`-submodule with `I ^ m D = 0`, then `D` is stable under `A^∧`: an element `b` of
`A^∧` acts on `D` as its representative modulo `I ^ m`. -/
theorem smul_mem_of_pow_smul_eq_bot (hI : I.FG) {M : Type w} [AddCommGroup M] [Module A M]
    [Module (AdicCompletion I A) M] [IsScalarTower A (AdicCompletion I A) M]
    (D : Submodule A M) {m : ℕ} (hD : I ^ m • D = ⊥) (b : AdicCompletion I A) {x : M}
    (hx : x ∈ D) : b • x ∈ D := by
  have hzero : ∀ y ∈ (I ^ m • ⊤ : Submodule A (AdicCompletion I A)), y • x = 0 := by
    intro y hy
    refine Submodule.smul_induction_on hy (fun c hc β _ => ?_) (fun y₁ y₂ h₁ h₂ => ?_)
    · have hcx : c • x = 0 := by
        have h : c • x ∈ I ^ m • D := Submodule.smul_mem_smul hc hx
        rwa [hD, Submodule.mem_bot] at h
      rw [smul_assoc]
      calc c • β • x = (algebraMap A (AdicCompletion I A) c * β) • x := by
            rw [mul_smul, algebraMap_smul]
        _ = (β * algebraMap A (AdicCompletion I A) c) • x := by rw [mul_comm]
        _ = β • c • x := by rw [mul_smul, algebraMap_smul]
        _ = 0 := by rw [hcx, smul_zero]
    · rw [add_smul, h₁, h₂, add_zero]
  obtain ⟨a, ha⟩ := exists_sub_algebraMap_mem I hI m b
  have hb := hzero _ ha
  rw [sub_smul, sub_eq_zero, algebraMap_smul] at hb
  rw [hb]
  exact D.smul_mem _ hx

/-! ### Eventual generation over the completion -/

variable {I}

/-- **Eventual generation in degree one for `I`-power torsion families.** Let `O_n` be
`A^∧`-modules with commuting `A^∧`-linear shifts `μ_l : O_n → O_{n+1}`, and `P_n ⊆ O_n`
`A^∧`-submodules generated in degree zero by the shifts, with `P_0` finite over `A^∧`. Then every
shift-stable family of `A`-submodules `D_n ⊆ P_n` with `I ^ (n + 1) D_n = 0` is generated in
degree one above some degree.

The `D_n`, being `I`-power torsion, are `A^∧`-submodules (`smul_mem_of_pow_smul_eq_bot`), and
`A^∧` is Noetherian, so `Stacks.CommutingShifts.exists_eventual_sum_shift` applies over `A^∧` to
the graded module `⨁ₙ P_n`. -/
theorem exists_eventual_sum_shift_of_adicCompletion [IsNoetherianRing A]
    {O : ℕ → Type w} [∀ n, AddCommGroup (O n)] [∀ n, Module A (O n)]
    [∀ n, Module (AdicCompletion I A) (O n)] [∀ n, IsScalarTower A (AdicCompletion I A) (O n)]
    {L : Type*} [Fintype L] (μ : L → ∀ n, O n →ₗ[AdicCompletion I A] O (n + 1))
    (hcomm : ∀ l l' n x, μ l (n + 1) (μ l' n x) = μ l' (n + 1) (μ l n x))
    (P : ∀ n, Submodule (AdicCompletion I A) (O n)) (hP0 : Module.Finite (AdicCompletion I A) (P 0))
    (hPμ : ∀ l n x, x ∈ P n → μ l n x ∈ P (n + 1))
    (hPgen : ∀ n x, x ∈ P (n + 1) → ∃ y : L → O n, (∀ l, y l ∈ P n) ∧ x = ∑ l, μ l n (y l))
    (D : ∀ n, Submodule A (O n)) (hDP : ∀ n, D n ≤ (P n).restrictScalars A)
    (hDμ : ∀ l n x, x ∈ D n → μ l n x ∈ D (n + 1)) (hDann : ∀ n, I ^ (n + 1) • D n = ⊥) :
    ∃ c, ∀ n, c ≤ n → ∀ x ∈ D (n + 1),
      ∃ y : L → O n, (∀ l, y l ∈ D n) ∧ x = ∑ l, μ l n (y l) := by
  classical
  have hI : I.FG := Ideal.fg_of_isNoetherianRing I
  let B := AdicCompletion I A
  let N : ℕ → Type w := fun n => P n
  let ν : L → ∀ n, N n →ₗ[B] N (n + 1) := fun l n =>
    ((μ l n).comp (P n).subtype).codRestrict (P (n + 1)) fun x => hPμ l n x x.2
  let DB : ∀ n, Submodule B (O n) := fun n =>
    { carrier := D n
      add_mem' := (D n).add_mem
      zero_mem' := (D n).zero_mem
      smul_mem' := fun b x hx => smul_mem_of_pow_smul_eq_bot I hI (D n) (hDann n) b hx }
  let D' : ∀ n, Submodule B (N n) := fun n => (DB n).comap (P n).subtype
  have : Module.Finite B (N 0) := hP0
  obtain ⟨c, hc⟩ := Stacks.CommutingShifts.exists_eventual_sum_shift (A := B) (N := N) ν
    (fun l l' n x => Subtype.ext (hcomm l l' n x))
    (fun n x => by
      obtain ⟨y, hy, hsum⟩ := hPgen n x x.2
      refine ⟨fun l => ⟨y l, hy l⟩, Subtype.ext ?_⟩
      rw [hsum, Submodule.coe_sum]
      rfl)
    D' (fun l n x hx => hDμ l n x hx)
  refine ⟨c, fun n hn x hx => ?_⟩
  obtain ⟨y, hyD, hsum⟩ := hc n hn ⟨x, hDP (n + 1) hx⟩ hx
  refine ⟨fun l => y l, hyD, ?_⟩
  have h := congrArg Subtype.val hsum
  rw [Submodule.coe_sum] at h
  exact h

/-! ### Finiteness over the completion -/

/-- `M / IM` is finite over `A` as soon as some map out of `M` with finite image has its kernel
inside `IM`. -/
theorem finite_quotient_smul_top_of_ker_le {M Q : Type w} [AddCommGroup M] [Module A M]
    [AddCommGroup Q] [Module A Q] (π : M →ₗ[A] Q) (hker : LinearMap.ker π ≤ I • ⊤)
    (hfin : Module.Finite A (LinearMap.range π)) :
    Module.Finite A (M ⧸ (I • ⊤ : Submodule A M)) := by
  have : Module.Finite A (M ⧸ LinearMap.ker π) :=
    Module.Finite.equiv (LinearMap.quotKerEquivRange π).symm
  exact Module.Finite.of_surjective (Submodule.factor hker) (Submodule.factor_surjective hker)


/-! ### The obstruction submodules -/

section Obstruction

variable [IsNoetherianRing A] {L : Type*} [Fintype L] (f : L → A)
  {E : ℕ → Type w} [∀ n, AddCommGroup (E n)] [∀ n, Module A (E n)]
  {V : Type w} [AddCommGroup V] [Module A V]
  (μ : ∀ n, ↥(I ^ (n + 1)) →ₗ[A] V →ₗ[A] E n) (ρ : L → ∀ n, E n →ₗ[A] E (n + 1))

/-- **The obstruction submodule** `P_n = ∑_{a ∈ I^{n+1}} μ_a^∧(V^∧)` of `E_n^∧`. -/
def obstructionSpan (n : ℕ) : Submodule (AdicCompletion I A) (AdicCompletion I (E n)) :=
  ⨆ a : ↥(I ^ (n + 1)), LinearMap.range (AdicCompletion.map I (μ n a))

omit [IsNoetherianRing A] in
/-- The image in the completion of an element of `∑ₐ μ_a(V)` lies in `P_n`. -/
theorem of_mem_obstructionSpan (n : ℕ) {x : E n}
    (hx : x ∈ ⨆ a : ↥(I ^ (n + 1)), LinearMap.range (μ n a)) :
    AdicCompletion.of I (E n) x ∈ obstructionSpan μ n := by
  refine Submodule.iSup_induction _ (motive := fun x => AdicCompletion.of I (E n) x ∈
    obstructionSpan μ n) hx (fun a y hy => ?_) ?_ (fun y z hy hz => ?_)
  · obtain ⟨v, rfl⟩ := hy
    rw [← AdicCompletion.map_of]
    exact Submodule.mem_iSup_of_mem a ⟨_, rfl⟩
  · simp
  · rw [map_add]
    exact Submodule.add_mem _ hy hz

omit [IsNoetherianRing A] [Fintype L] in
/-- The completed shifts carry `P_n` into `P_{n+1}`. -/
theorem map_mem_obstructionSpan (hfI : ∀ l, f l ∈ I)
    (hρμ : ∀ l n (a : ↥(I ^ (n + 1))), (ρ l n).comp (μ n a) =
      μ (n + 1) ⟨f l * a, by rw [pow_succ']; exact Ideal.mul_mem_mul (hfI l) a.2⟩)
    (l : L) (n : ℕ) {x : AdicCompletion I (E n)} (hx : x ∈ obstructionSpan μ n) :
    AdicCompletion.map I (ρ l n) x ∈ obstructionSpan μ (n + 1) := by
  refine Submodule.iSup_induction _ (motive := fun x => AdicCompletion.map I (ρ l n) x ∈
    obstructionSpan μ (n + 1)) hx (fun a y hy => ?_) ?_ (fun y z hy hz => ?_)
  · obtain ⟨v, rfl⟩ := hy
    rw [← LinearMap.comp_apply, AdicCompletion.map_comp, hρμ]
    exact Submodule.mem_iSup_of_mem _ ⟨v, rfl⟩
  · simp
  · rw [map_add]
    exact Submodule.add_mem _ hy hz

omit [IsNoetherianRing A] in
/-- **Generation in degree one.** Every element of `P_{n+1}` is `∑_l ρ_l^∧(y_l)` with `y_l ∈ P_n`:
an element of `I ^ (n + 2)` is `∑_l f_l b_l` with `b_l ∈ I ^ (n + 1)`. -/
theorem exists_eq_sum_map_of_mem_obstructionSpan (hf : I = Ideal.span (Set.range f))
    (hρμ : ∀ l n (a : ↥(I ^ (n + 1))), (ρ l n).comp (μ n a) =
      μ (n + 1) ⟨f l * a, by
        rw [pow_succ']
        exact Ideal.mul_mem_mul (hf ▸ Ideal.subset_span ⟨l, rfl⟩) a.2⟩)
    (n : ℕ) {x : AdicCompletion I (E (n + 1))} (hx : x ∈ obstructionSpan μ (n + 1)) :
    ∃ y : L → AdicCompletion I (E n), (∀ l, y l ∈ obstructionSpan μ n) ∧
      x = ∑ l, AdicCompletion.map I (ρ l n) (y l) := by
  classical
  have hfI : ∀ l, f l ∈ I := fun l => hf ▸ Ideal.subset_span ⟨l, rfl⟩
  let Q : Submodule (AdicCompletion I A) (AdicCompletion I (E (n + 1))) :=
    ⨆ l, (obstructionSpan μ n).map (AdicCompletion.map I (ρ l n))
  -- `Q` is the set of the sums in question.
  have hQ : ∀ z ∈ Q, ∃ y : L → AdicCompletion I (E n), (∀ l, y l ∈ obstructionSpan μ n) ∧
      z = ∑ l, AdicCompletion.map I (ρ l n) (y l) := by
    intro z hz
    refine Submodule.iSup_induction _ (motive := fun z => ∃ y : L → AdicCompletion I (E n),
      (∀ l, y l ∈ obstructionSpan μ n) ∧ z = ∑ l, AdicCompletion.map I (ρ l n) (y l)) hz
      (fun l w hw => ?_) ?_ (fun w₁ w₂ h₁ h₂ => ?_)
    · obtain ⟨t, ht, rfl⟩ := hw
      refine ⟨Pi.single l t, fun l' => ?_, ?_⟩
      · rcases eq_or_ne l' l with rfl | h
        · simpa using ht
        · simp [h]
      · rw [Finset.sum_eq_single l (fun l' _ h => by simp [h])
          (fun h => absurd (Finset.mem_univ l) h)]
        simp
    · exact ⟨0, fun _ => Submodule.zero_mem _, by simp⟩
    · obtain ⟨y₁, hy₁, rfl⟩ := h₁
      obtain ⟨y₂, hy₂, rfl⟩ := h₂
      exact ⟨y₁ + y₂, fun l => Submodule.add_mem _ (hy₁ l) (hy₂ l), by
        simp [map_add, Finset.sum_add_distrib]⟩
  refine hQ x ((iSup_le fun a => ?_ : obstructionSpan μ (n + 1) ≤ Q) hx)
  rintro _ ⟨v, rfl⟩
  have ha : (a : A) ∈ I ^ (n + 1) • Submodule.span A (Set.range f) := by
    rw [← Ideal.span, ← hf, Ideal.smul_eq_mul, ← pow_succ]
    exact a.2
  obtain ⟨c, hc, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp ha
  have hdecomp : a = ∑ l, (⟨f l * c l, by
      rw [pow_succ']
      exact Ideal.mul_mem_mul (hfI l) (hc l)⟩ : ↥(I ^ (n + 1 + 1))) := by
    apply Subtype.ext
    rw [Submodule.coe_sum, ← hsum, Finsupp.sum_fintype _ _ (fun _ => by simp)]
    exact Finset.sum_congr rfl fun l _ => by rw [smul_eq_mul, mul_comm]
  rw [hdecomp, map_sum, map_sum, LinearMap.sum_apply]
  refine Submodule.sum_mem _ fun l _ => ?_
  rw [← hρμ l n ⟨c l, hc l⟩, ← AdicCompletion.map_comp, LinearMap.comp_apply]
  exact Submodule.mem_iSup_of_mem l ⟨_, Submodule.mem_iSup_of_mem ⟨c l, hc l⟩ ⟨v, rfl⟩, rfl⟩

/-- **`P_0` is finite over `A^∧`** when `V / IV` is finite over `A`. -/
theorem finite_obstructionSpan_zero (hf : I = Ideal.span (Set.range f))
    (hV : Module.Finite A (V ⧸ (I • ⊤ : Submodule A V))) :
    Module.Finite (AdicCompletion I A) (obstructionSpan μ 0) := by
  classical
  have hfI : ∀ l, f l ∈ I := fun l => hf ▸ Ideal.subset_span ⟨l, rfl⟩
  have hf1 : ∀ l, f l ∈ I ^ (0 + 1) := fun l => by simpa using hfI l
  have hVfin := Module.Finite.adicCompletion_of_finite_quotient_smul_top
    (Ideal.fg_of_isNoetherianRing I) V hV
  let Q : Submodule (AdicCompletion I A) (AdicCompletion I (E 0)) :=
    ⨆ l, LinearMap.range (AdicCompletion.map I (μ 0 ⟨f l, hf1 l⟩))
  have hQ : Q.FG := Submodule.fg_iSup _ fun l => by
    rw [LinearMap.range_eq_map]
    exact (Module.Finite.fg_top).map _
  have hle : obstructionSpan μ 0 ≤ Q := by
    refine iSup_le fun a => ?_
    rintro _ ⟨v, rfl⟩
    have ha : (a : A) ∈ Submodule.span A (Set.range f) := by
      rw [← Ideal.span, ← hf]
      simpa using a.2
    obtain ⟨c, hc⟩ := Submodule.mem_span_range_iff_exists_fun A |>.mp ha
    have hdecomp : a = ∑ l, c l • (⟨f l, hf1 l⟩ : ↥(I ^ (0 + 1))) := by
      apply Subtype.ext
      rw [Submodule.coe_sum, ← hc]
      rfl
    rw [hdecomp, map_sum, map_sum, LinearMap.sum_apply]
    refine Submodule.sum_mem _ fun l _ => ?_
    rw [map_smul, map_smul, LinearMap.smul_apply, ← LinearMap.map_smul_of_tower]
    exact Submodule.mem_iSup_of_mem l ⟨_, rfl⟩
  have : IsNoetherian (AdicCompletion I A) Q := isNoetherian_of_fg_of_noetherian Q hQ
  have := isNoetherian_of_le hle
  infer_instance

/-- **Eventual generation in degree one inside the obstruction submodules.** Every family of
`A`-submodules `D_n ⊆ P_n`, stable under the completed shifts and killed by `I ^ (n + 1)`, is
generated in degree one above some degree. -/
theorem exists_eventual_sum_shift_of_obstructionSpan (hf : I = Ideal.span (Set.range f))
    (hV : Module.Finite A (V ⧸ (I • ⊤ : Submodule A V)))
    (hρμ : ∀ l n (a : ↥(I ^ (n + 1))), (ρ l n).comp (μ n a) =
      μ (n + 1) ⟨f l * a, by
        rw [pow_succ']
        exact Ideal.mul_mem_mul (hf ▸ Ideal.subset_span ⟨l, rfl⟩) a.2⟩)
    (hρcomm : ∀ l l' n, (ρ l (n + 1)).comp (ρ l' n) = (ρ l' (n + 1)).comp (ρ l n))
    (D : ∀ n, Submodule A (AdicCompletion I (E n)))
    (hDP : ∀ n, D n ≤ (obstructionSpan μ n).restrictScalars A)
    (hDμ : ∀ l n x, x ∈ D n → AdicCompletion.map I (ρ l n) x ∈ D (n + 1))
    (hDann : ∀ n, I ^ (n + 1) • D n = ⊥) :
    ∃ c, ∀ n, c ≤ n → ∀ x ∈ D (n + 1),
      ∃ y : L → AdicCompletion I (E n), (∀ l, y l ∈ D n) ∧
        x = ∑ l, AdicCompletion.map I (ρ l n) (y l) :=
  exists_eventual_sum_shift_of_adicCompletion (fun l n => AdicCompletion.map I (ρ l n))
    (fun l l' n x => by
      rw [← LinearMap.comp_apply (AdicCompletion.map I (ρ l (n + 1))),
        AdicCompletion.map_comp, hρcomm, ← AdicCompletion.map_comp, LinearMap.comp_apply])
    (obstructionSpan μ) (finite_obstructionSpan_zero f μ hf hV)
    (fun l n x hx =>
      map_mem_obstructionSpan f μ ρ (fun l => hf ▸ Ideal.subset_span ⟨l, rfl⟩) hρμ l n hx)
    (fun n x hx => exists_eq_sum_map_of_mem_obstructionSpan f μ ρ hf hρμ n hx)
    D hDP hDμ hDann

end Obstruction

end Stacks.AdicObstruction

end
