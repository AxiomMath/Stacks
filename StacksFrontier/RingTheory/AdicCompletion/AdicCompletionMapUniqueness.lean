module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.Completeness
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import StacksFrontier.RingTheory.AdicCompletion.DvrValuedPoints
public import StacksFrontier.RingTheory.AdicCompletion.PermanenceOfProperties

/-!
# Uniqueness of the induced map on adic completions

Let `f : A →+* B` be a ring homomorphism carrying an ideal `J ⊆ A` into an ideal `I ⊆ B`. The
map `adicCompletionMap f J I hf : AdicCompletion J A →+* AdicCompletion I B` is the induced map
on adic completions. This file records that it is compatible with the structural maps from the
base rings, and that — for a finitely generated `J` — it is the *only* ring homomorphism with
that compatibility. Consequently, if any ring equivalence between the two completions is
compatible with `f` on the base, then `adicCompletionMap f J I hf` is itself bijective.

## Main results

* `eq_adicCompletionMap_of_apply_algebraMap`: a ring homomorphism out of `AdicCompletion J A`
  is determined by its restriction to the image of `A`.
* `bijective_adicCompletionMap_of_exists_ringEquiv`: the existence of a compatible ring
  equivalence forces the induced map to be bijective.
* `sub_mem_of_apply_algebraMap_sub_mem`: a congruence between two maps out of a completion that
  holds on the image of the base holds everywhere, provided both maps carry the relevant step of
  the filtration into the modulus.

## Implementation notes

The completion is Mathlib's inverse-limit model `AdicCompletion`, and the projections to the
truncations are `AdicCompletion.evalₐ`. Two elements of a completion agree as soon as all their
truncations agree (`AdicCompletion.ext_evalₐ`), so the uniqueness statement is proved one level
`n` at a time: an arbitrary `z` is approximated by `algebraMap A _ a` modulo the kernel at level
`n`, which for finitely generated `J` is exactly the ideal generated by the image of `J ^ n` by
`AdicCompletion.ker_evalₐ_eq_map_pow`.

Only the *easy* inclusion `Ideal.map (algebraMap B _) (I ^ n) ≤ RingHom.ker (evalₐ I n)` is
needed on the target side, and that inclusion holds with no finiteness hypothesis on `I`; it is
isolated as `evalₐ_eq_zero_of_mem_map_algebraMap` precisely so that `I.FG` is not required.
-/

@[expose] public noncomputable section

universe u v

/-- The truncation `AdicCompletion I B → B ⧸ I ^ n` kills the ideal generated by the image of
`I ^ n`. This is the inclusion of `ker_evalₐ_eq_map` that needs no finiteness hypothesis. -/
private lemma evalₐ_eq_zero_of_mem_map_algebraMap {B : Type v} [CommRing B] (I : Ideal B)
    (n : ℕ) {b : AdicCompletion I B}
    (hb : b ∈ Ideal.map (algebraMap B (AdicCompletion I B)) (I ^ n)) :
    AdicCompletion.evalₐ I n b = 0 := by
  have h : Ideal.map (algebraMap B (AdicCompletion I B)) (I ^ n) ≤
      RingHom.ker (AdicCompletion.evalₐ I n).toRingHom := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker]
    change AdicCompletion.evalₐ I n (algebraMap B (AdicCompletion I B) r) = 0
    have hval : AdicCompletion.evalₐ I n (algebraMap B (AdicCompletion I B) r) =
        Ideal.Quotient.mk (I ^ n) r := by
      rw [AdicCompletion.algebraMap_apply]
      simp
    rw [hval]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
  exact RingHom.mem_ker.mp (h hb)

/-- A ring homomorphism `g` out of `AdicCompletion J A` which agrees with `f` on the image of the
base carries the ideal generated by the image of `J ^ n` into the ideal generated by the image of
`I ^ n`. This uses only the compatibility of `g` with the structural maps. -/
private lemma map_map_algebraMap_le {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    (f : A →+* B) (J : Ideal A) (I : Ideal B) (hf : J.map f ≤ I) (n : ℕ)
    (g : AdicCompletion J A →+* AdicCompletion I B)
    (hg : ∀ a : A, g (algebraMap A (AdicCompletion J A) a) =
      algebraMap B (AdicCompletion I B) (f a)) :
    Ideal.map g (Ideal.map (algebraMap A (AdicCompletion J A)) (J ^ n)) ≤
      Ideal.map (algebraMap B (AdicCompletion I B)) (I ^ n) := by
  rw [Ideal.map_map, Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap, RingHom.comp_apply, hg a]
  refine Ideal.mem_map_of_mem _ ?_
  have hpow : Ideal.map f (J ^ n) ≤ I ^ n := by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono hf n
  exact hpow (Ideal.mem_map_of_mem f ha)

/-- A ring homomorphism out of an adic completion is determined by its restriction to the base:
if `g` agrees with `f` on the image of `A`, then `g` is `adicCompletionMap f`. -/
theorem eq_adicCompletionMap_of_apply_algebraMap {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] (f : A →+* B) (J : Ideal A) (I : Ideal B) (hf : J.map f ≤ I)
    (hJ : J.FG) (g : AdicCompletion J A →+* AdicCompletion I B)
    (hg : ∀ a : A, g (algebraMap A (AdicCompletion J A) a) =
      algebraMap B (AdicCompletion I B) (f a)) :
    g = adicCompletionMap f J I hf := by
  have hcomp : ∀ a : A, adicCompletionMap f J I hf (algebraMap A (AdicCompletion J A) a) =
      algebraMap B (AdicCompletion I B) (f a) := fun a ↦ by
    simpa using RingHom.congr_fun (adicCompletionMap_comp_algebraMap f J I hf) a
  refine RingHom.ext fun z ↦ AdicCompletion.ext_evalₐ fun n ↦ ?_
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n z)
  have hmem : z - algebraMap A (AdicCompletion J A) a ∈
      Ideal.map (algebraMap A (AdicCompletion J A)) (J ^ n) := by
    rw [← AdicCompletion.ker_evalₐ_eq_map_pow J hJ n, RingHom.mem_ker]
    change AdicCompletion.evalₐ J n (z - algebraMap A (AdicCompletion J A) a) = 0
    have hval : AdicCompletion.evalₐ J n (algebraMap A (AdicCompletion J A) a) =
        Ideal.Quotient.mk (J ^ n) a := by
      rw [AdicCompletion.algebraMap_apply]
      simp
    rw [map_sub, hval, ha, sub_self]
  have h1 := evalₐ_eq_zero_of_mem_map_algebraMap I n
    (map_map_algebraMap_le f J I hf n g hg (Ideal.mem_map_of_mem g hmem))
  have h2 := evalₐ_eq_zero_of_mem_map_algebraMap I n
    (map_map_algebraMap_le f J I hf n (adicCompletionMap f J I hf) hcomp
      (Ideal.mem_map_of_mem _ hmem))
  rw [map_sub, map_sub, hg a, sub_eq_zero] at h1
  rw [map_sub, map_sub, hcomp a, sub_eq_zero] at h2
  rw [h1, h2]

/-- If some ring equivalence between the two adic completions is compatible with `f` on the base,
then `adicCompletionMap f` is itself bijective. -/
theorem bijective_adicCompletionMap_of_exists_ringEquiv {A : Type u} {B : Type v}
    [CommRing A] [CommRing B] (f : A →+* B) (J : Ideal A) (I : Ideal B) (hf : J.map f ≤ I)
    (hJ : J.FG) (e : AdicCompletion J A ≃+* AdicCompletion I B)
    (he : ∀ a : A, e (algebraMap A (AdicCompletion J A) a) =
      algebraMap B (AdicCompletion I B) (f a)) :
    Function.Bijective (adicCompletionMap f J I hf) := by
  rw [← eq_adicCompletionMap_of_apply_algebraMap f J I hf hJ e.toRingHom he]
  exact e.bijective

/-- **A congruence on the base propagates to the whole completion.** Two ring homomorphisms out
of `AdicCompletion J A` which agree modulo an ideal `K` on the image of `A`, and which both
carry the `n`-th step of the filtration into `K`, agree modulo `K` at every element.

The point is that `A` is dense in `AdicCompletion J A` modulo the `n`-th filtration step, so an
arbitrary element differs from one coming from `A` by something both maps send into `K`. -/
theorem sub_mem_of_apply_algebraMap_sub_mem {A C : Type u} [CommRing A] [CommRing C]
    (J : Ideal A) (hJ : J.FG) (n : ℕ) (K : Ideal C) (g₁ g₂ : AdicCompletion J A →+* C)
    (hbase : ∀ a : A, g₁ (algebraMap A (AdicCompletion J A) a) -
      g₂ (algebraMap A (AdicCompletion J A) a) ∈ K)
    (h₁ : Ideal.map g₁ (Ideal.map (algebraMap A (AdicCompletion J A)) (J ^ n)) ≤ K)
    (h₂ : Ideal.map g₂ (Ideal.map (algebraMap A (AdicCompletion J A)) (J ^ n)) ≤ K)
    (z : AdicCompletion J A) : g₁ z - g₂ z ∈ K := by
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n z)
  have hmem : z - algebraMap A (AdicCompletion J A) a ∈
      Ideal.map (algebraMap A (AdicCompletion J A)) (J ^ n) := by
    rw [← AdicCompletion.ker_evalₐ_eq_map_pow J hJ n, RingHom.mem_ker]
    change AdicCompletion.evalₐ J n (z - algebraMap A (AdicCompletion J A) a) = 0
    have hval : AdicCompletion.evalₐ J n (algebraMap A (AdicCompletion J A) a) =
        Ideal.Quotient.mk (J ^ n) a := by
      rw [AdicCompletion.algebraMap_apply]
      simp
    rw [map_sub, hval, ha, sub_self]
  have hsplit : g₁ z - g₂ z =
      (g₁ (z - algebraMap A (AdicCompletion J A) a)) -
        (g₂ (z - algebraMap A (AdicCompletion J A) a)) +
      (g₁ (algebraMap A (AdicCompletion J A) a) -
        g₂ (algebraMap A (AdicCompletion J A) a)) := by
    rw [map_sub, map_sub]; ring
  rw [hsplit]
  exact K.add_mem
    (K.sub_mem (h₁ (Ideal.mem_map_of_mem _ hmem)) (h₂ (Ideal.mem_map_of_mem _ hmem)))
    (hbase a)

end
