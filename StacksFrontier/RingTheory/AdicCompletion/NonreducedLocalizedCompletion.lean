/-!
# A nonreduced completion of a principal localization

Completion along an ideal `I = (b)` of a Noetherian local domain `B` can destroy reducedness
after a principal localization: there is a two-dimensional Noetherian local domain `B`, complete
for a principal ideal `(b)`, and an element `f` of its maximal ideal outside `(b)`, such that the
`(b)`-adic completion `C = (B_f)^` of the localization `B_f` is nonreduced, and remains
nonreduced after inverting `b`.

The ring is a power series ring. Take the characteristic-two discrete valuation ring `D` of
`StacksFrontier.RingTheory.AnalyticallyUnramified.Counterexample`, in which some `a ∈ D` becomes a
square only in the completion of `D`, let `R = D[T]/(T² - a)` and let `B = R⟦x⟧`. Then `B` is a
two-dimensional Noetherian local domain and it is complete for the principal ideal generated by
`b = πx`, where `π` is a uniformizer of `D`. Inverting `f = x` makes `b` and `π` differ by a
unit, so the `(b)`-adic completion of `B_f` receives the `π`-adic completion of `D`, hence
receives a second square root of `a` besides the image of `T`; the two differ by a nonzero
element of square zero, and it stays nonzero after inverting `b` because `b` is a nonzerodivisor
and the completion is flat.

## Main results

* `PowerSeries.isAdicComplete_span_singleton_C_mul_X`: a power series ring is complete for the
  ideal generated by the product of its variable with a scalar.
* `PowerSeries.ringKrullDim_eq_two_of_isDiscreteValuationRing`: the power series ring over a
  discrete valuation ring is two-dimensional.
* `exists_nonreduced_adicCompletion_localization_away`: **Stacks 0GHI**, the example itself.

## Implementation notes

The completion of `B_f` is `AdicCompletion` for the extension of `(b)` to `Localization.Away f`,
and the last localization inverts the image of `b` under the canonical map from `B` to that
completion; the statement therefore mentions no completion of a localization other than
`AdicCompletion`.

The comparison map `D^ → (B_f)^` between adic completions along `𝔪_D ↦ (b)` is
`Stacks.Nagata.PthRootDescent.mapAdicCompletion`, and the obstruction to the two square roots
being equal is `Stacks.Nagata.PthRootDescent.root_sub_algebraMap_notMem`: the coefficient of
the adjoined root in the canonical degree-`< 2` representative is a unit, so the root is not
congruent to an element of `D` modulo `𝔪_D · R`.

## References

* [Stacks Project, Tag 0GHI](https://stacks.math.columbia.edu/tag/0GHI)
* [Stacks Project, Tag 00PB](https://stacks.math.columbia.edu/tag/00PB), the source of the
  discrete valuation ring
-/

@[expose] public section

universe u

open scoped LaurentSeries
open PowerSeries

/-- A congruence modulo a power of a principal ideal is divisibility by the power of its
generator. -/
theorem exists_sub_eq_pow_mul_of_sModEq_span_singleton {A : Type*} [CommRing A] {b x y : A}
    {n : ℕ} (h : x ≡ y [SMOD (Ideal.span {b}) ^ n • (⊤ : Submodule A A)]) :
    ∃ g, x - y = b ^ n * g := by
  have hmem := SModEq.sub_mem.mp h
  rw [Ideal.smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow] at hmem
  exact Ideal.mem_span_singleton.mp hmem

/-- A nonzero element of square zero survives localization at a nonzerodivisor, so that
localization is not reduced. -/
theorem not_isReduced_localization_away_of_isRegular {A : Type*} [CommRing A] {z r : A}
    (hz : z ≠ 0) (hz2 : z ^ 2 = 0) (hr : IsRegular r) : ¬ IsReduced (Localization.Away r) := by
  intro hred
  have hinj : Function.Injective (algebraMap A (Localization.Away r)) :=
    IsLocalization.injective (M := Submonoid.powers r) _
      (Submonoid.powers_le.mpr hr.mem_nonZeroDivisors)
  exact (map_ne_zero_iff _ hinj).mpr hz (IsNilpotent.eq_zero ⟨2, by rw [← map_pow, hz2, map_zero]⟩)

/-- A flat algebra map sends nonzerodivisors to nonzerodivisors. -/
theorem IsRegular.algebraMap_of_flat {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]
    [Module.Flat A S] {r : A} (h : IsRegular r) : IsRegular (algebraMap A S r) := by
  have hreg : IsSMulRegular S r := Module.Flat.isSMulRegular_of_isRegular (R := A) (M := S) h
  refine ⟨fun x y hxy => hreg ?_, fun x y hxy => hreg ?_⟩
  · simpa [Algebra.smul_def] using hxy
  · simpa only [Algebra.smul_def, mul_comm (algebraMap A S r)] using hxy

/-- In a ring where `2 = 0`, two elements with the same square differ by an element of square
zero. -/
theorem sq_sub_eq_zero_of_two_eq_zero {A : Type*} [CommRing A] (h2 : (2 : A) = 0) {x y : A}
    (h : x ^ 2 = y ^ 2) : (x - y) ^ 2 = 0 := by
  rw [sub_sq, h, h2, zero_mul, zero_mul, sub_zero, ← two_mul, h2, zero_mul]

namespace PowerSeries

/-- The coefficient of `x ^ (d + m)` in `(c x) ^ m * g` is `c ^ m` times that of `x ^ d` in
`g`. -/
theorem coeff_add_C_mul_X_pow_mul {R : Type*} [CommRing R] (c : R) (m d : ℕ)
    (g : PowerSeries R) : coeff (d + m) ((C c * X) ^ m * g) = c ^ m * coeff d g := by
  rw [mul_pow, ← map_pow, mul_assoc, coeff_C_mul, coeff_X_pow_mul]

/-- The coefficients of `(c x) ^ m * g` below degree `m` vanish. -/
theorem coeff_C_mul_X_pow_mul_of_lt {R : Type*} [CommRing R] (c : R) {m d : ℕ} (h : d < m)
    (g : PowerSeries R) : coeff d ((C c * X) ^ m * g) = 0 := by
  rw [mul_pow, ← map_pow, mul_assoc, coeff_C_mul, coeff_X_pow_mul']
  simp [not_le_of_gt h]

/-- Congruent power series modulo a power of `(c x)` have equal coefficients below that power. -/
private theorem coeff_eq_of_sModEq_span_C_mul_X {R : Type*} [CommRing R] (c : R)
    {x y : PowerSeries R} {n j : ℕ} (hj : j < n)
    (h : x ≡ y [SMOD (Ideal.span {C c * (X : PowerSeries R)}) ^ n •
      (⊤ : Submodule (PowerSeries R) (PowerSeries R))]) :
    coeff j x = coeff j y := by
  obtain ⟨g, hg⟩ := exists_sub_eq_pow_mul_of_sModEq_span_singleton h
  have hh := congrArg (coeff j) hg
  rw [map_sub, coeff_C_mul_X_pow_mul_of_lt c hj] at hh
  exact sub_eq_zero.mp hh

/-- A formal power series ring is Hausdorff for the ideal generated by the product of its
variable with a scalar. -/
theorem isHausdorff_span_singleton_C_mul_X {R : Type*} [CommRing R] (c : R) :
    IsHausdorff (Ideal.span {C c * (X : PowerSeries R)}) (PowerSeries R) := by
  refine ⟨fun z hz => PowerSeries.ext fun j => ?_⟩
  simpa using coeff_eq_of_sModEq_span_C_mul_X c (Nat.lt_succ_self j) (hz (j + 1))

/-- A formal power series ring is precomplete for the ideal generated by the product of its
variable with a scalar: the variable forces each coefficient of a Cauchy sequence to stabilize. -/
theorem isPrecomplete_span_singleton_C_mul_X {R : Type*} [CommRing R] (c : R) :
    IsPrecomplete (Ideal.span {C c * (X : PowerSeries R)}) (PowerSeries R) := by
  refine ⟨fun f hf => ?_⟩
  let L : PowerSeries R := PowerSeries.mk fun i => coeff i (f (i + 1))
  refine ⟨L, fun n => ?_⟩
  have hdiv (i : ℕ) : ∃ g, f n - f (i + n + 1) = (C c * X) ^ n * g :=
    exists_sub_eq_pow_mul_of_sModEq_span_singleton (hf (show n ≤ i + n + 1 by omega))
  let q : PowerSeries R := PowerSeries.mk fun i => coeff i (Classical.choose (hdiv i))
  rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow]
  refine Ideal.mem_span_singleton.mpr ⟨q, PowerSeries.ext fun j => ?_⟩
  by_cases hj : n ≤ j
  · have hq : coeff (j - n) q = coeff (j - n) (Classical.choose (hdiv (j - n))) := by simp [q]
    have hL : coeff ((j - n) + n) L = coeff ((j - n) + n) (f ((j - n) + n + 1)) := by simp [L]
    rw [← Nat.sub_add_cancel hj]
    calc
      coeff ((j - n) + n) (f n - L) = coeff ((j - n) + n) (f n - f ((j - n) + n + 1)) := by
        rw [map_sub, map_sub, hL]
      _ = coeff ((j - n) + n) ((C c * X) ^ n * Classical.choose (hdiv (j - n))) :=
        congrArg (coeff ((j - n) + n)) (Classical.choose_spec (hdiv (j - n)))
      _ = coeff ((j - n) + n) ((C c * X) ^ n * q) := by
        rw [coeff_add_C_mul_X_pow_mul, coeff_add_C_mul_X_pow_mul, hq]
  · have hzero : coeff j ((C c * X) ^ n * q) = 0 :=
      coeff_C_mul_X_pow_mul_of_lt c (Nat.lt_of_not_ge hj) q
    have hh := coeff_eq_of_sModEq_span_C_mul_X c (Nat.lt_succ_self j)
      (hf (show j + 1 ≤ n by omega))
    have hL : coeff j L = coeff j (f (j + 1)) := by simp [L]
    simp [map_sub, hzero, hL, hh]

/-- A formal power series ring is complete for the ideal generated by the product of its variable
with a scalar. The variable forces each coefficient of a Cauchy sequence to stabilize, and the
scalar factor keeps the tails in the required ideal power. -/
theorem isAdicComplete_span_singleton_C_mul_X {R : Type*} [CommRing R] (c : R) :
    IsAdicComplete (Ideal.span {((C c) * (X : PowerSeries R))}) (PowerSeries R) := by
  have := isHausdorff_span_singleton_C_mul_X c
  have := isPrecomplete_span_singleton_C_mul_X c
  exact ⟨⟩

/-- The variable of a power series ring over a local ring lies in its maximal ideal. -/
theorem X_mem_maximalIdeal_of_isLocalRing {R : Type*} [CommRing R] [IsLocalRing R] :
    (X : PowerSeries R) ∈ IsLocalRing.maximalIdeal (PowerSeries R) := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
  simp

/-- Over a domain, the variable is not a multiple of `c x` for a nonunit `c`. -/
theorem X_notMem_span_C_mul_X {R : Type*} [CommRing R] [IsDomain R] {c : R} (hc : ¬ IsUnit c) :
    (X : PowerSeries R) ∉ Ideal.span {C c * X} := by
  intro hmem
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton.mp hmem
  have hcancel : C c * g = 1 := by
    apply mul_left_cancel₀ (X_ne_zero (R := R))
    calc
      X * (C c * g) = C c * X * g := by ring
      _ = X := hg.symm
      _ = X * 1 := (mul_one X).symm
  exact hc (by simpa using isUnit_iff_constantCoeff.mp (isUnit_iff_exists_inv.mpr ⟨g, hcancel⟩))

/-- The power series ring over a discrete valuation ring is two-dimensional: its maximal ideal is
generated by the variable together with a uniformizer, which bounds the dimension above, and the
dimension of a power series ring is at least one more than that of the coefficient ring. -/
theorem ringKrullDim_eq_two_of_isDiscreteValuationRing {D : Type*} [CommRing D] [IsDomain D]
    [IsDiscreteValuationRing D] : ringKrullDim (PowerSeries D) = 2 := by
  obtain ⟨π, hπirr⟩ := IsDiscreteValuationRing.exists_irreducible D
  have hgen : IsLocalRing.maximalIdeal D = Ideal.span {π} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπirr
  have hDdim : ringKrullDim D = 1 := IsDiscreteValuationRing.ringKrullDim_eq_one D
  have hDspanle : (IsLocalRing.maximalIdeal D).spanFinrank ≤ 1 := by
    rw [hgen]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton π)).trans (by simp)
  have hDspange : 1 ≤ (IsLocalRing.maximalIdeal D).spanFinrank := by
    have h := ringKrullDim_le_spanFinrank_maximalIdeal D
    rw [hDdim] at h
    exact_mod_cast h
  have hmap := IsLocalRing.map_maximalIdeal_of_surjective
    (PowerSeries.constantCoeff : PowerSeries D →+* D) PowerSeries.constantCoeff_surj
  have hspanle :=
    PowerSeries.spanFinrank_le_spanFinrank_map_constantCoeff_add_one_of_X_mem
      (X_mem_maximalIdeal_of_isLocalRing (R := D))
  rw [hmap, Nat.le_antisymm hDspanle hDspange] at hspanle
  have hlower := ringKrullDim_succ_le_ringKrullDim_powerseries (R := D)
  rw [hDdim] at hlower
  exact le_antisymm ((ringKrullDim_le_spanFinrank_maximalIdeal _).trans (by exact_mod_cast hspanle))
    (by exact_mod_cast hlower)

/-- The power series ring over a domain finite and faithful over a discrete valuation ring is
two-dimensional. -/
theorem ringKrullDim_eq_two_of_finite {D R : Type*} [CommRing D] [IsDomain D]
    [IsDiscreteValuationRing D] [CommRing R] [IsDomain R] [Algebra D R] [Module.Finite D R]
    [FaithfulSMul D R] : ringKrullDim (PowerSeries R) = 2 := by
  let : Module.Finite (PowerSeries D) (PowerSeries R) :=
    Stacks.Nagata.PowerSeriesAscent.module_finite_powerSeries
  have : Algebra.IsIntegral (PowerSeries D) (PowerSeries R) := inferInstance
  have : FaithfulSMul (PowerSeries D) (PowerSeries R) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr
      (PowerSeries.map_injective _ (FaithfulSMul.algebraMap_injective D R))
  rw [← Algebra.IsIntegral.ringKrullDim_eq (PowerSeries D) (PowerSeries R)]
  exact ringKrullDim_eq_two_of_isDiscreteValuationRing

/-- The variable becomes a unit in the Laurent series ring. -/
theorem isUnit_ofPowerSeries_X {R : Type*} [CommRing R] :
    IsUnit (HahnSeries.ofPowerSeries ℤ R X) := by
  rw [HahnSeries.ofPowerSeries_X]
  exact isUnit_iff_exists_inv.mpr ⟨HahnSeries.single (-1 : ℤ) (1 : R), by
    rw [HahnSeries.single_mul_single]
    simp⟩

/-- Inverting the variable of a power series ring identifies the principal ideal generated by
`c x` with that generated by `c`. -/
theorem map_span_C_mul_X_localizationAway {R : Type*} [CommRing R] (c : R) :
    (Ideal.span {C c * X}).map
        (algebraMap (PowerSeries R) (Localization.Away (X : PowerSeries R))) =
      Ideal.span {algebraMap (PowerSeries R) (Localization.Away (X : PowerSeries R)) (C c)} := by
  rw [Ideal.map_span, Set.image_singleton, map_mul,
    Ideal.span_singleton_mul_right_unit (IsLocalization.Away.algebraMap_isUnit _)]

/-- After inverting the variable, a constant `r` is a multiple of a constant `c` only if it
already is in the coefficient ring, as the constant coefficient of a Laurent series shows. -/
theorem algebraMap_C_notMem_span_localizationAway {R : Type*} [CommRing R] {r c : R}
    (h : r ∉ Ideal.span {c}) :
    algebraMap (PowerSeries R) (Localization.Away (X : PowerSeries R)) (C r) ∉
      Ideal.span {algebraMap (PowerSeries R) (Localization.Away (X : PowerSeries R)) (C c)} := by
  intro hmem
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hmem
  let φ : Localization.Away (X : PowerSeries R) →+* LaurentSeries R :=
    IsLocalization.Away.lift (g := HahnSeries.ofPowerSeries ℤ R) X isUnit_ofPowerSeries_X
  have hφ (s : R) : φ (algebraMap (PowerSeries R) _ (C s)) = HahnSeries.C s :=
    (IsLocalization.Away.lift_eq _ _ _).trans (HahnSeries.ofPowerSeries_C _)
  have hcoeff := congrArg (fun t => (φ t).coeff 0) hq
  have hleft : (φ (algebraMap (PowerSeries R) _ (C r))).coeff 0 = r := by
    rw [hφ]
    simp
  have hright : (φ (algebraMap (PowerSeries R) _ (C c) * q)).coeff 0 = c * (φ q).coeff 0 := by
    rw [map_mul, hφ, HahnSeries.C_apply, HahnSeries.single_zero_mul_eq_smul,
      HahnSeries.coeff_smul, smul_eq_mul]
  exact h (Ideal.mem_span_singleton.mpr ⟨_, hleft.symm.trans (hcoeff.trans hright)⟩)

/-- Let `t` be a square root in `R` of `a ∈ D` that is not congruent to an element of `D` modulo
`𝔪_D R`, and suppose `a` has a square root in the completion of `D`. Then the completion of
`R⟦x⟧[1/x]` along `(π x)` is nonreduced, and stays so after inverting `π x`. -/
theorem not_isReduced_adicCompletion_localization_away_X {D R : Type*} [CommRing D]
    [IsLocalRing D] [CharP D 2] [CommRing R] [IsDomain R] [IsNoetherianRing R] [Algebra D R]
    {a π : D} {t : R} {α : AdicCompletion (IsLocalRing.maximalIdeal D) D}
    (hα : α ^ 2 = algebraMap D _ a) (ht : t ^ 2 = algebraMap D R a)
    (htd : ∀ d : D, t - algebraMap D R d ∉ (IsLocalRing.maximalIdeal D).map (algebraMap D R))
    (hπ : IsLocalRing.maximalIdeal D = Ideal.span {π}) (hπ0 : algebraMap D R π ≠ 0) :
    let b : PowerSeries R := C (algebraMap D R π) * X
    let Cx := AdicCompletion
      ((Ideal.span {b}).map (algebraMap (PowerSeries R) (Localization.Away (X : PowerSeries R))))
      (Localization.Away (X : PowerSeries R))
    ¬ IsReduced Cx ∧ ¬ IsReduced (Localization.Away (algebraMap (PowerSeries R) Cx b)) := by
  intro b Cx
  let Sx := Localization.Away (X : PowerSeries R)
  let Jx := (Ideal.span {b}).map (algebraMap (PowerSeries R) Sx)
  have hD (x : D) : algebraMap D Sx x = algebraMap (PowerSeries R) Sx (C (algebraMap D R x)) :=
    (IsScalarTower.algebraMap_apply D R Sx x).trans
      (IsScalarTower.algebraMap_apply R (PowerSeries R) Sx _)
  have hJspan : Jx = Ideal.span {algebraMap D Sx π} := by
    rw [hD]
    exact map_span_C_mul_X_localizationAway _
  have hIMap : (IsLocalRing.maximalIdeal D).map (algebraMap D Sx) ≤ Jx :=
    (by rw [hπ, Ideal.map_span, Set.image_singleton, hJspan] :
      (IsLocalRing.maximalIdeal D).map (algebraMap D Sx) = Jx).le
  let ψ := Stacks.Nagata.PthRootDescent.mapAdicCompletion _ Jx hIMap
  let β : Cx := algebraMap Sx Cx (algebraMap (PowerSeries R) Sx (C t))
  have hψa : (ψ α) ^ 2 = algebraMap Sx Cx (algebraMap D Sx a) := by
    rw [← map_pow, hα, Stacks.Nagata.PthRootDescent.mapAdicCompletion_of hIMap]
  have hβa : β ^ 2 = algebraMap Sx Cx (algebraMap D Sx a) := by
    change (algebraMap R Cx t) ^ 2 = _
    rw [← map_pow, ht]
    exact (IsScalarTower.algebraMap_apply D R Cx a).symm.trans
      (IsScalarTower.algebraMap_apply D Sx Cx a)
  have h2 : (2 : Cx) = 0 := by
    rw [← map_ofNat (algebraMap D Cx) 2, CharTwo.two_eq_zero, map_zero]
  have hzsq : (β - ψ α) ^ 2 = 0 := sq_sub_eq_zero_of_two_eq_zero h2 (hβa.trans hψa.symm)
  have hz : β - ψ α ≠ 0 := by
    obtain ⟨d, hd⟩ :=
      Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal D) 1 α)
    intro hz0
    have h1 : AdicCompletion.evalₐ Jx 1 (ψ α) =
        Ideal.Quotient.mk (Jx ^ 1) (algebraMap D Sx d) := by
      rw [Stacks.Nagata.PthRootDescent.evalₐ_mapAdicCompletion hIMap 1 α, ← hd,
        Ideal.quotientMap_mk]
    have heq : Ideal.Quotient.mk (Jx ^ 1) (algebraMap (PowerSeries R) Sx (C t)) =
        Ideal.Quotient.mk (Jx ^ 1) (algebraMap D Sx d) := by
      rw [← h1, ← sub_eq_zero.mp hz0]
      exact (AdicCompletion.evalₐ_of Jx 1 _).symm
    rw [Ideal.Quotient.eq, pow_one, hJspan, hD, hD, ← map_sub, ← map_sub] at heq
    exact algebraMap_C_notMem_span_localizationAway (fun hm => htd d
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.mem_map_of_mem _
        (hπ ▸ Ideal.mem_span_singleton_self π : π ∈ IsLocalRing.maximalIdeal D))) hm)) heq
  have hb0 : b ≠ 0 :=
    mul_ne_zero (by simpa using (PowerSeries.C_injective (R := R)).ne hπ0) PowerSeries.X_ne_zero
  have : IsDomain Sx := IsLocalization.Away.isDomain Sx (PowerSeries.X_ne_zero (R := R))
  have hlocalinj : Function.Injective (algebraMap (PowerSeries R) Sx) :=
    IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors
      (PowerSeries.X_ne_zero (R := R)))
  have : IsNoetherianRing Sx := inferInstance
  have : Module.Flat Sx Cx := inferInstance
  have hbSx : IsRegular (algebraMap (PowerSeries R) Sx b) :=
    IsRegular.of_ne_zero (by simpa using hlocalinj.ne hb0)
  exact ⟨fun _ => hz (IsNilpotent.eq_zero ⟨2, hzsq⟩),
    not_isReduced_localization_away_of_isRegular hz hzsq (hbSx.algebraMap_of_flat (S := Cx))⟩

end PowerSeries

/-- **Stacks 0GHI.** There is a local Noetherian two-dimensional domain `B`, complete with
respect to a principal ideal `I = (b)`, and an element `f` of its maximal ideal outside `I`, such
that the `I`-adic completion `C = (B_f)^` of the principal localization `B_f` is nonreduced, and
even such that `C[1/b]` is nonreduced. -/
@[stacks 0GHI]
theorem exists_nonreduced_adicCompletion_localization_away :
    ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B) (_ : IsLocalRing B)
      (_ : IsNoetherianRing B) (b f : B),
      ringKrullDim B = 2 ∧
        IsAdicComplete (Ideal.span {b}) B ∧
        f ∈ IsLocalRing.maximalIdeal B ∧
        f ∉ Ideal.span {b} ∧
        (let C := AdicCompletion
            ((Ideal.span {b}).map (algebraMap B (Localization.Away f)))
            (Localization.Away f);
          (¬ IsReduced C) ∧
            (¬ IsReduced (Localization.Away (algebraMap B C b)))) := by
  classical
  obtain ⟨D, K, hDcomm, hDdom, hDlocal, hDnoeth, hDdvr, hDchar, hKfield, hDK, hDfrac,
      a, α, hα, hnotroot⟩ :=
    exists_charTwo_isDiscreteValuationRing_sq_in_adicCompletion_not_in_fractionField
      (ULift.{u} (ZMod 2))
  let : CommRing D := hDcomm
  let : IsDomain D := hDdom
  let : IsLocalRing D := hDlocal
  let : IsNoetherianRing D := hDnoeth
  let : IsDiscreteValuationRing D := hDdvr
  let : CharP D 2 := hDchar
  let : Field K := hKfield
  let : Algebra D K := hDK
  let : IsFractionRing D K := hDfrac
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨π, hπirr⟩ := IsDiscreteValuationRing.exists_irreducible D
  let R := AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C a)
  have hmono : (Polynomial.X ^ 2 - Polynomial.C a : Polynomial D).Monic :=
    Polynomial.monic_X_pow_sub_C a (by decide)
  have : IsDomain R := Stacks.Nagata.PthRootDescent.isDomain_adjoinRoot_of_monic (K := K) hmono (by
    simpa using X_pow_sub_C_irreducible_of_prime Nat.prime_two hnotroot)
  have : IsLocalRing R := Stacks.Nagata.PthRootDescent.isLocalRing_adjoinRoot (p := 2) a
  have : Module.Finite D R := hmono.finite_adjoinRoot
  have hDR : Function.Injective (algebraMap D R) :=
    Stacks.Nagata.PthRootDescent.algebraMap_adjoinRoot_injective (by decide) a
  have : FaithfulSMul D R := (faithfulSMul_iff_algebraMap_injective D R).mpr hDR
  have : IsNoetherianRing R := inferInstance
  refine ⟨PowerSeries R, inferInstance, inferInstance, inferInstance, inferInstance,
    C (algebraMap D R π) * X, X, PowerSeries.ringKrullDim_eq_two_of_finite (D := D),
    PowerSeries.isAdicComplete_span_singleton_C_mul_X _,
    PowerSeries.X_mem_maximalIdeal_of_isLocalRing,
    PowerSeries.X_notMem_span_C_mul_X fun h => hπirr.not_isUnit
      ((Stacks.Nagata.PthRootDescent.isUnit_algebraMap_iff a π).mp h), ?_⟩
  exact PowerSeries.not_isReduced_adicCompletion_localization_away_X (R := R)
    (t := AdjoinRoot.root _) hα
    (Stacks.Nagata.PthRootDescent.root_pow_eq a)
    (Stacks.Nagata.PthRootDescent.root_sub_algebraMap_notMem (by decide) a)
    ((IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπirr)
    ((map_ne_zero_iff _ hDR).mpr hπirr.ne_zero)

end
