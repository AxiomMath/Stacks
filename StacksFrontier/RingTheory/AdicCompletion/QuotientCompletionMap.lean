module

public import Mathlib.RingTheory.AdicCompletion.LocalRing
public import Mathlib.RingTheory.AdicCompletion.Noetherian
public import StacksFrontier.RingTheory.AdicCompletion.NoetherianRing

/-!
# The completion of a quotient of a local ring

Let `R` be a local ring and `I ⊆ R` an ideal with `R ⧸ I` local. The maximal-ideal-adic towers
of `R` and of `R ⧸ I` are compared level by level by `quotientLevelMap`, and the comparison of
the completions assembled from those level maps is `adicCompletionMapQuotient`. It is
surjective, and its kernel is the ideal generated by `I` in the completion of `R`.
-/

@[expose] public section

open IsLocalRing

/-- **Stacks 05GH.** The completion of a Noetherian local ring along its maximal ideal is again
a Noetherian ring. -/
public theorem isNoetherianRing_adicCompletion (R : Type*) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] : IsNoetherianRing (AdicCompletion (maximalIdeal R) R) :=
  (completion_noetherian R (maximalIdeal R) inferInstance
    (maximalIdeal R).fg_of_isNoetherianRing).1

/-- The `n`-th step of the adic filtration of a quotient of a local ring. -/
public theorem pow_smul_top_quotient_eq_map {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] (n : ℕ) :
    ((maximalIdeal (R ⧸ I)) ^ n • ⊤ : Ideal (R ⧸ I)) =
      ((maximalIdeal R) ^ n).map (Ideal.Quotient.mk I) := by
  rw [smul_eq_mul, Ideal.mul_top,
    ← IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective, Ideal.map_pow]

/-- The level-`n` comparison map `R ⧸ 𝔪ⁿ → (R ⧸ I) ⧸ 𝔪_{R ⧸ I}ⁿ` between the two adic towers. -/
public def quotientLevelMap {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] (n : ℕ) :
    R ⧸ ((maximalIdeal R) ^ n • ⊤ : Ideal R) →+*
      (R ⧸ I) ⧸ ((maximalIdeal (R ⧸ I)) ^ n • ⊤ : Ideal (R ⧸ I)) :=
  Ideal.Quotient.lift _ ((Ideal.Quotient.mk _).comp (Ideal.Quotient.mk I))
    (by
      intro a ha
      rw [smul_eq_mul, Ideal.mul_top] at ha
      simp only [RingHom.coe_comp, Function.comp_apply, Ideal.Quotient.eq_zero_iff_mem,
        pow_smul_top_quotient_eq_map I n]
      exact Ideal.mem_map_of_mem _ ha)

/-- The level map `quotientLevelMap` sends the class of `a` in `R ⧸ 𝔪ⁿ` to the class of the image
of `a` in `R ⧸ I`. -/
public theorem quotientLevelMap_mk {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] (n : ℕ) (a : R) :
    quotientLevelMap I n (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (Ideal.Quotient.mk I a) :=
  rfl

/-- The level map `quotientLevelMap` kills the class of `a` exactly when `a ∈ I + 𝔪ⁿ`. -/
public theorem quotientLevelMap_eq_zero_iff {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] (n : ℕ) (a : R) :
    quotientLevelMap I n (Ideal.Quotient.mk _ a) = 0 ↔ a ∈ I ⊔ (maximalIdeal R) ^ n := by
  have hcb : Ideal.comap (Ideal.Quotient.mk I) (⊥ : Ideal (R ⧸ I)) = I := by
    rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  rw [quotientLevelMap_mk, Ideal.Quotient.eq_zero_iff_mem, pow_smul_top_quotient_eq_map I n, ←
    Ideal.mem_comap, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, hcb, sup_comm]

/-- If `a` dies in the level `n` quotient, then `a` is congruent modulo `𝔪ⁿ` to an element of
`I`. -/
private theorem exists_mem_sub_mem_pow_of_quotientLevelMap_eq_zero {R : Type*} [CommRing R]
    [IsLocalRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)] {n : ℕ} {a : R}
    (h : quotientLevelMap I n (Ideal.Quotient.mk _ a) = 0) :
    ∃ i ∈ I, a - i ∈ (maximalIdeal R) ^ n := by
  obtain ⟨i, hi, t, ht, hit⟩ := Submodule.mem_sup.mp ((quotientLevelMap_eq_zero_iff I n a).mp h)
  refine ⟨i, hi, ?_⟩
  rwa [show a - i = t by linear_combination -hit]

/-- Every element of `(R ⧸ I) ⧸ 𝔪_{R ⧸ I}ⁿ` is the image under `quotientLevelMap` of the class of
some element of `R`. -/
public theorem quotientLevelMap_comp_mk_surjective {R : Type*} [CommRing R] [IsLocalRing R]
    (I : Ideal R) [IsLocalRing (R ⧸ I)] (n : ℕ) :
    Function.Surjective fun r : R => quotientLevelMap I n (Ideal.Quotient.mk _ r) := by
  intro z
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective w
  exact ⟨r, rfl⟩

/-- The comparison ring map `R^ → (R ⧸ I)^` between the completion of `R` and the completion of
`R ⧸ I`, assembled from the level maps `quotientLevelMap`. -/
public def adicCompletionMapQuotient {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [IsLocalRing (R ⧸ I)] :
    AdicCompletion (maximalIdeal R) R →+* AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I)
    where
  toFun x :=
    ⟨fun n => quotientLevelMap I n (x.val n), by
      intro p q hpq
      change
        AdicCompletion.transitionMap (maximalIdeal (R ⧸ I)) (R ⧸ I) hpq
            (quotientLevelMap I q (x.val q)) =
          quotientLevelMap I p (x.val p)
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (x.val q)
      have hxp : x.val p = Ideal.Quotient.mk _ a := by
        rw [← x.property hpq, ← ha]
        exact AdicCompletion.transitionMap_ideal_mk _ hpq a
      rw [← ha, hxp, quotientLevelMap_mk, quotientLevelMap_mk]
      exact AdicCompletion.transitionMap_ideal_mk _ hpq _⟩
  map_one' := by
    refine AdicCompletion.ext fun n => ?_
    change quotientLevelMap I n ((1 : AdicCompletion (maximalIdeal R) R).val n) = _
    rw [AdicCompletion.val_one, map_one, AdicCompletion.val_one]
  map_mul' x y := AdicCompletion.ext fun n => map_mul (quotientLevelMap I n) (x.val n) (y.val n)
  map_zero' := by
    refine AdicCompletion.ext fun n => ?_
    change quotientLevelMap I n ((0 : AdicCompletion (maximalIdeal R) R).val n) = _
    rw [AdicCompletion.val_zero_apply, map_zero, AdicCompletion.val_zero_apply]
  map_add' x y := AdicCompletion.ext fun n => map_add (quotientLevelMap I n) (x.val n) (y.val n)

/-- The level-`n` component of the comparison map of completions is the level map
`quotientLevelMap`. -/
public theorem completionQuotientMap_val
    {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)]
    (x : AdicCompletion (maximalIdeal R) R) (n : ℕ) :
    (adicCompletionMapQuotient I x).val n = quotientLevelMap I n (x.val n) :=
  rfl

/-- The level-`n` component of the image of `r` in the completion of `R` is the class of `r` in
`R ⧸ 𝔪ⁿ`. -/
public theorem val_algebraMap {R : Type*} [CommRing R] [IsLocalRing R] (r : R) (n : ℕ) :
    (algebraMap R (AdicCompletion (maximalIdeal R) R) r).val n = Ideal.Quotient.mk _ r :=
  rfl

/-- The comparison map `R^ → (R ⧸ I)^` is surjective: a compatible family of elements of the
tower of `R ⧸ I` lifts to a Cauchy sequence in `R`, adjusting the lift at each step by an element
of `I`. -/
public theorem adicCompletionMapQuotient_surjective {R : Type*} [CommRing R] [IsLocalRing R]
    (I : Ideal R) [IsLocalRing (R ⧸ I)] : Function.Surjective (adicCompletionMapQuotient I) := by
  intro y
  have hstep :
    ∀ (n : ℕ) (r : R),
      ∃ s : R,
        quotientLevelMap I n (Ideal.Quotient.mk _ r) = y.val n →
          s - r ∈ (maximalIdeal R) ^ n ∧
            quotientLevelMap I (n + 1) (Ideal.Quotient.mk _ s) = y.val (n + 1) := by
    intro n r
    by_cases h : quotientLevelMap I n (Ideal.Quotient.mk _ r) = y.val n
    · obtain ⟨u, hu⟩ := quotientLevelMap_comp_mk_surjective I (n + 1) (y.val (n + 1))
      have hun : quotientLevelMap I n (Ideal.Quotient.mk _ u) = y.val n := by
        rw [← y.property (Nat.le_succ n), ← hu]
        change
          _ =
            AdicCompletion.transitionMap (maximalIdeal (R ⧸ I)) (R ⧸ I) (Nat.le_succ n)
              (quotientLevelMap I (n + 1) (Ideal.Quotient.mk _ u))
        rw [quotientLevelMap_mk, quotientLevelMap_mk]
        exact (AdicCompletion.transitionMap_ideal_mk _ (Nat.le_succ n) _).symm
      have hz : quotientLevelMap I n (Ideal.Quotient.mk _ (u - r)) = 0 := by
        rw [map_sub, map_sub, hun, h, sub_self]
      obtain ⟨i, hi, hir⟩ := exists_mem_sub_mem_pow_of_quotientLevelMap_eq_zero I hz
      refine ⟨u - i, fun _ => ⟨?_, ?_⟩⟩
      · rwa [show u - i - r = u - r - i by ring]
      · have hi' : Ideal.Quotient.mk I i = 0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hi
        rw [map_sub, map_sub, quotientLevelMap_mk I (n + 1) i, hi', map_zero, sub_zero]
        exact hu
    · exact ⟨r, fun h' => absurd h' h⟩
  obtain ⟨a0, ha0⟩ := quotientLevelMap_comp_mk_surjective I 0 (y.val 0)
  choose F hF using hstep
  let a : ℕ → R := fun n => Nat.rec (motive := fun _ => R) a0 (fun k r => F k r) n
  have hkey : ∀ n, quotientLevelMap I n (Ideal.Quotient.mk _ (a n)) = y.val n := by
    intro n
    induction n with
    | zero => exact ha0
    | succ n ih => exact (hF n (a n) ih).2
  have hinc : ∀ n, a (n + 1) - a n ∈ (maximalIdeal R) ^ n := fun n => (hF n (a n) (hkey n)).1
  have hcauchy : ∀ p q : ℕ, p ≤ q → a q - a p ∈ (maximalIdeal R) ^ p := by
    intro p q hpq
    induction q, hpq using Nat.le_induction with
    | base => simp
    | succ q hpq ih =>
      rw [show a (q + 1) - a p = (a (q + 1) - a q) + (a q - a p) by ring]
      exact add_mem (Ideal.pow_le_pow_right hpq (hinc q)) ih
  refine ⟨⟨fun n => Ideal.Quotient.mk _ (a n), ?_⟩, AdicCompletion.ext hkey⟩
  intro p q hpq
  rw [AdicCompletion.transitionMap_ideal_mk, Ideal.Quotient.eq, smul_eq_mul, Ideal.mul_top]
  exact hcauchy p q hpq

/-- The kernel of the comparison map `R^ → (R ⧸ I)^` is the ideal generated by `I`. -/
public theorem ker_adicCompletionMapQuotient {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)] :
    RingHom.ker (adicCompletionMapQuotient I) =
      I.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) := by
  have hker :
    ∀ (n : ℕ) (z : AdicCompletion (maximalIdeal R) R),
      z.val n = 0 →
        z ∈ ((maximalIdeal R) ^ n).map (algebraMap R (AdicCompletion (maximalIdeal R) R)) := by
    intro n z hz
    have h1 :
      z ∈ ((maximalIdeal R) ^ n • ⊤ : Submodule R (AdicCompletion (maximalIdeal R) R)) := by
      rw [AdicCompletion.pow_smul_top_eq_ker_eval (maximalIdeal R).fg_of_isNoetherianRing]
      exact
        LinearMap.mem_ker.mpr
          (by
            rw [AdicCompletion.eval_apply]; exact hz)
    rw [Ideal.smul_top_eq_map] at h1
    exact h1
  have hIne : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have hIle : I ≤ maximalIdeal R := le_maximalIdeal hIne
  have hJle :
    I.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) ≤
      maximalIdeal (AdicCompletion (maximalIdeal R) R) := by
    rw [AdicCompletion.maximalIdeal_eq_map]
    exact Ideal.map_mono hIle
  have hJne : I.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) ≠ ⊤ := fun h =>
    (maximalIdeal.isMaximal (AdicCompletion (maximalIdeal R) R)).ne_top (top_le_iff.mp (h ▸ hJle))
  have := (completion_noetherian R (maximalIdeal R) inferInstance
    (maximalIdeal R).fg_of_isNoetherianRing).1
  have hloc :
    IsLocalRing
      (AdicCompletion (maximalIdeal R) R ⧸
        I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) :=
    have : Nontrivial _ := Ideal.Quotient.nontrivial_iff.mpr hJne
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have hpow :
    ∀ n : ℕ,
      ((maximalIdeal R) ^ n).map (algebraMap R (AdicCompletion (maximalIdeal R) R)) =
        (maximalIdeal (AdicCompletion (maximalIdeal R) R)) ^ n := by
    intro n
    rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_pow]
  refine le_antisymm ?_ ?_
  · intro x hx
    rw [RingHom.mem_ker] at hx
    have hstep :
      ∀ n : ℕ,
        Ideal.Quotient.mk (I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) x ∈
          ((maximalIdeal (AdicCompletion (maximalIdeal R) R)) ^ n).map
            (Ideal.Quotient.mk (I.map (algebraMap R (AdicCompletion (maximalIdeal R) R)))) := by
      intro n
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (x.val n)
      have h0 : quotientLevelMap I n (Ideal.Quotient.mk _ a) = 0 := by
        have h1 := congrArg (fun z : AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I) => z.val n) hx
        simp only [AdicCompletion.val_zero_apply] at h1
        rw [ha]
        simpa only [completionQuotientMap_val] using h1
      obtain ⟨i, hi, hai⟩ := exists_mem_sub_mem_pow_of_quotientLevelMap_eq_zero I h0
      have hval : (x - algebraMap R (AdicCompletion (maximalIdeal R) R) i).val n = 0 := by
        rw [AdicCompletion.val_sub, Pi.sub_apply, ← ha, val_algebraMap, ← map_sub,
          Ideal.Quotient.eq_zero_iff_mem, smul_eq_mul, Ideal.mul_top]
        exact hai
      have hmem := hker n _ hval
      rw [hpow n] at hmem
      have hx' :
        x =
          algebraMap R (AdicCompletion (maximalIdeal R) R) i +
            (x - algebraMap R (AdicCompletion (maximalIdeal R) R) i) := by
        ring
      rw [hx', map_add,
        (Ideal.Quotient.eq_zero_iff_mem).mpr
          (Ideal.mem_map_of_mem _ hi :
            algebraMap R (AdicCompletion (maximalIdeal R) R) i ∈
              I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))),
        zero_add]
      exact Ideal.mem_map_of_mem _ hmem
    have hh :
      IsHausdorff
        (maximalIdeal
          (AdicCompletion (maximalIdeal R) R ⧸
            I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))))
        (AdicCompletion (maximalIdeal R) R ⧸
          I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) :=
      inferInstance
    have hzero :
      Ideal.Quotient.mk (I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))) x = 0 := by
      refine hh.haus _ (fun n => ?_)
      rw [SModEq.zero, smul_eq_mul, Ideal.mul_top,
        ← IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective, ←
        Ideal.map_pow]
      exact hstep n
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hzero
  · rw [Ideal.map_le_iff_le_comap]
    intro r hr
    simp only [Ideal.mem_comap, RingHom.mem_ker]
    refine AdicCompletion.ext fun n => ?_
    change
      quotientLevelMap I n ((algebraMap R (AdicCompletion (maximalIdeal R) R) r).val n) =
        (0 : AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I)).val n
    rw [val_algebraMap, AdicCompletion.val_zero_apply]
    exact (quotientLevelMap_eq_zero_iff I n r).mpr (Ideal.mem_sup_left hr)

/-- The completion of `R ⧸ I` along its maximal ideal is the quotient of the completion of `R` by
the ideal generated by `I`. This is the identification `(R ⧸ I)^ = R^ ⧸ I R^`, that is, exactness
of completion (Stacks 00MB) in the shape the arguments downstream use it. -/
public theorem nonempty_ringEquiv_adicCompletion_quotient {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)] :
    Nonempty
      (AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I) ≃+*
        (AdicCompletion (maximalIdeal R) R ⧸
          I.map (algebraMap R (AdicCompletion (maximalIdeal R) R)))) :=
  ⟨(RingHom.quotientKerEquivOfSurjective (adicCompletionMapQuotient_surjective I)).symm.trans
      (Ideal.quotEquivOfEq (ker_adicCompletionMapQuotient I))⟩

/-- The comparison map `R^ → (R ⧸ I)^` is compatible with the maps from `R` and from `R ⧸ I` to
their completions. -/
public theorem completionQuotientMap_algebraMap
    {R : Type*} [CommRing R] [IsLocalRing R] (I : Ideal R) [IsLocalRing (R ⧸ I)] (r : R) :
    adicCompletionMapQuotient I (algebraMap R (AdicCompletion (maximalIdeal R) R) r) =
      algebraMap (R ⧸ I) (AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I))
        (Ideal.Quotient.mk I r) :=
  AdicCompletion.ext fun _ => rfl

end
