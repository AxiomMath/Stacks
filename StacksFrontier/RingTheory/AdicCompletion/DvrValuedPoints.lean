/-!
# Complete discrete valuation rings dominating a faithfully flat adic algebra

Let `A` be a Noetherian ring, `I ⊆ A` an ideal and `C` an `A`-algebra which is `IC`-adically
complete and whose reductions `C/IⁿC` are flat and of finite type over `A/Iⁿ`, faithfully flat
for `n = 1`. This file produces, for every complete discrete valuation ring `R` carrying a
continuous `A`-algebra structure, an extension `R ⊂ W` of complete discrete valuation rings
together with an `A`-algebra map `C → W`. It is the commutative-algebra content of the
rig-surjectivity criterion of Stacks 0AQX.

## Main results

* `Module.Flat.of_flat_adic_reductions`: flatness of `C` over `A` from flatness of all the
  reductions `C/IⁿC` over `A/Iⁿ`.
* `Module.FaithfullyFlat.of_faithfullyFlat_reduction`: faithful flatness from faithful
  flatness of the first reduction.
* `Module.FaithfullyFlat.of_adicCompletion_map`: faithful flatness of the `IP`-adic
  completion of a faithfully flat algebra `P`.
* `exists_isAdicComplete_isDiscreteValuationRing_of_faithfullyFlat`: a Noetherian faithfully
  flat algebra over a discrete valuation ring admits a map to a complete discrete valuation
  ring extension of the base, of controlled cardinality.
* `exists_isAdicComplete_isDiscreteValuationRing_ringHom`: the statement described above,
  which is what the geometric criterion consumes.

## Implementation notes

All the existential statements bind their own `Algebra` instances, and the proofs supply them
explicitly as `RingHom.toAlgebra` of a composition rather than relying on instance search to
compose the structures: a discrete valuation ring produced by Stacks 00PH is a
`Subalgebra` of a fraction field, and the induced scalar tower over the original base is not
found by unification.

The cardinality bookkeeping is the one the big fppf site of a formal algebraic space needs:
all the rings produced stay below a fixed strong prelimit cardinal `κ > ℵ₀`, which is closed
under `lam ↦ lam ^ ℵ₀` by `Cardinal.power_aleph0_lt_of_isStrongPrelimit` and therefore under
passing to adic completions.

## References

* [Stacks Project, Tag 0AQX](https://stacks.math.columbia.edu/tag/0AQX)
* [Stacks Project, Tag 00PH](https://stacks.math.columbia.edu/tag/00PH)
* [Stacks Project, Tag 0523](https://stacks.math.columbia.edu/tag/0523)
-/

@[expose] public section

open Cardinal

universe u v

namespace Module.Flat

/-- If every reduction `M/IⁿM` of an adically complete algebra is flat over `A/Iⁿ`, then the
algebra is flat. The local criterion of Stacks 0523 applies at every maximal ideal, all of
which contain the ideal generated by `I` because the algebra is complete. -/
@[sga "3 X 4.3" "more general"]
theorem of_flat_adic_reductions {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]
    [IsNoetherianRing A] [IsNoetherianRing C] (I : Ideal A)
    [IsAdicComplete (I.map (algebraMap A C)) C]
    (hflat : ∀ n : ℕ, Module.Flat (A ⧸ I ^ n) (C ⧸ (I ^ n).map (algebraMap A C))) :
    Module.Flat A C := by
  have hquot (n : ℕ) : Module.Flat (A ⧸ I ^ (n + 1))
      (C ⧸ (I ^ (n + 1) • (⊤ : Submodule A C))) := by
    have := hflat (n + 1)
    exact Module.Flat.of_linearEquiv <| LinearEquiv.extendScalarsOfSurjective
      (R := A) (S := A ⧸ I ^ (n + 1)) Ideal.Quotient.mk_surjective <|
      (Submodule.quotEquivOfEq _ _ (Ideal.smul_top_eq_map _)).trans
        (Submodule.Quotient.restrictScalarsEquiv A ((I ^ (n + 1)).map (algebraMap A C)))
  apply Module.flat_of_isLocalized_maximal (R := A) (S := C) C
    (fun P _ => LocalizedModule P.primeCompl C)
    (fun P _ => LocalizedModule.mkLinearMap P.primeCompl C)
  intro P hP
  have hIP : I.map (algebraMap A C) ≤ P :=
    (IsAdicComplete.le_jacobson_bot (I.map (algebraMap A C))).trans
      (sInf_le ⟨bot_le, hP⟩)
  exact Module.Flat.of_flat_quotient_pow I C hquot P hIP
    (LocalizedModule P.primeCompl C) (LocalizedModule.mkLinearMap P.primeCompl C)

end Module.Flat

namespace Module.FaithfullyFlat

/-- A flat algebra is faithfully flat as soon as its reduction modulo an ideal contained in
the Jacobson radical is faithfully flat: every maximal ideal of the base contains that ideal,
so it is detected in the reduction. -/
theorem of_faithfullyFlat_reduction {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]
    [Module.Flat A C] (I : Ideal A) (hI : I ≤ Ideal.jacobson ⊥)
    [Module.FaithfullyFlat (A ⧸ I) (C ⧸ I.map (algebraMap A C))] :
    Module.FaithfullyFlat A C := by
  refine ⟨fun m hm => ?_⟩
  have hIm : I ≤ m := hI.trans (sInf_le ⟨bot_le, hm⟩)
  let J := I.map (algebraMap A C)
  let m₀ := m.map (Ideal.Quotient.mk I)
  have hm₀ : m₀ ≠ ⊤ := by
    intro h
    have hc := congrArg (Ideal.comap (Ideal.Quotient.mk I)) h
    exact hm.ne_top (by simpa [m₀, Ideal.comap_map_mk hIm] using hc)
  intro htop
  have hmC : m.map (algebraMap A C) = ⊤ := by
    rw [Ideal.smul_top_eq_map] at htop
    exact (Submodule.restrictScalars_eq_top_iff _ _ _).mp htop
  have hmap : m₀.map (algebraMap (A ⧸ I) (C ⧸ J)) = ⊤ := by
    rw [Ideal.map_map]
    change m.map ((Ideal.Quotient.mk J).comp (algebraMap A C)) = ⊤
    rw [← Ideal.map_map, hmC, Ideal.map_top]
  have hcomap := Ideal.comap_map_eq_self_of_faithfullyFlat (B := C ⧸ J) m₀
  rw [hmap, Ideal.comap_top] at hcomap
  exact hm₀ hcomap.symm

/-- Reduction modulo an ideal preserves faithful flatness. -/
theorem quotient_map {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]
    [Module.FaithfullyFlat A C] (I : Ideal A) :
    Module.FaithfullyFlat (A ⧸ I) (C ⧸ I.map (algebraMap A C)) :=
  Module.FaithfullyFlat.of_linearEquiv _ _
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor C I).toLinearEquiv

end Module.FaithfullyFlat

namespace AdicCompletion

/-- The reductions of the `IP`-adic completion of an `R`-algebra `P` modulo the powers of `I`
agree with those of `P` itself. -/
noncomputable def quotPowMapEquiv {R P : Type*} [CommRing R] [CommRing P] [Algebra R P]
    (I : Ideal R) (hI : I.FG) (n : ℕ) :
    (AdicCompletion (I.map (algebraMap R P)) P ⧸
      (I ^ n).map (algebraMap R (AdicCompletion (I.map (algebraMap R P)) P))) ≃ₗ[R ⧸ I ^ n]
      (P ⧸ (I ^ n).map (algebraMap R P)) := by
  let J := I.map (algebraMap R P)
  let Q := AdicCompletion J P
  let φ : Q →ₐ[R] P ⧸ (I ^ n).map (algebraMap R P) :=
    ((Ideal.quotientEquivAlgOfEq P (Ideal.map_pow _ _ _).symm).toAlgHom.comp
      (AdicCompletion.evalₐ J n)).restrictScalars R
  have hφ : Function.Surjective φ := by
    intro x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    refine ⟨AdicCompletion.of J P p, ?_⟩
    change Ideal.Quotient.factor (le_of_eq (Ideal.map_pow (algebraMap R P) I n).symm)
      (AdicCompletion.evalₐ J n (AdicCompletion.of J P p)) = _
    rw [AdicCompletion.evalₐ_of]
    rfl
  have hker : RingHom.ker φ.toRingHom = (I ^ n).map (algebraMap R Q) := by
    change RingHom.ker (((Ideal.quotientEquivAlgOfEq P
      (Ideal.map_pow (algebraMap R P) I n).symm).toRingHom).comp
      (AdicCompletion.evalₐ J n).toRingHom) = _
    rw [RingHom.ker_comp_of_injective _ (AlgEquiv.injective _),
      ker_evalₐ_eq_map_pow J (hI.map _) n]
    simp only [J, ← Ideal.map_pow, Ideal.map_map]
    congr 1
  let e : (Q ⧸ (I ^ n).map (algebraMap R Q)) ≃ₐ[R]
      (P ⧸ (I ^ n).map (algebraMap R P)) :=
    (Ideal.quotientEquivAlgOfEq R hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hφ)
  exact LinearEquiv.extendScalarsOfSurjective Ideal.Quotient.mk_surjective e.toLinearEquiv

/-- An adic completion has at most `#P ^ ℵ₀` elements: it embeds into the product of the
quotients by the powers of the ideal. -/
theorem mk_le_pow_aleph0 {P : Type u} [CommRing P] (J : Ideal P) :
    #(AdicCompletion J P) ≤ (#P) ^ ℵ₀ := by
  have hi : Function.Injective
      (fun x : AdicCompletion J P => fun n => AdicCompletion.evalₐ J n x) :=
    fun x y h => AdicCompletion.ext_evalₐ (I := J) (fun n => congrFun h n)
  calc
    #(AdicCompletion J P) ≤ #(∀ n : ℕ, P ⧸ J ^ n) := mk_le_of_injective hi
    _ = Cardinal.prod (fun n : ℕ => #(P ⧸ J ^ n)) := mk_pi _
    _ ≤ Cardinal.prod (fun _ : ℕ => #P) := prod_le_prod _ _ (fun n =>
      mk_le_of_surjective (Ideal.Quotient.mk_surjective (I := J ^ n)))
    _ = (#P) ^ ℵ₀ := by simp

/-- An adic completion of a ring of cardinality below a strong prelimit `kappa > ℵ₀` again has
cardinality below `kappa`. -/
private theorem mk_lt_of_isStrongPrelimit {P : Type u} [CommRing P] (J : Ideal P)
    {kappa : Cardinal.{u}} (hk : aleph0 < kappa) (hsl : IsStrongPrelimit kappa)
    (hP : #P < kappa) : #(AdicCompletion J P) < kappa :=
  (mk_le_pow_aleph0 J).trans_lt (Cardinal.power_aleph0_lt_of_isStrongPrelimit hk hsl hP)

end AdicCompletion

namespace Module.FaithfullyFlat

/-- The `IP`-adic completion of a faithfully flat algebra `P` over a Noetherian ring is
faithfully flat, provided `I` lies in the Jacobson radical and the completion is
Noetherian. -/
@[sga "1 IV 3.2" "sufficiency"]
theorem of_adicCompletion_map {R P : Type*} [CommRing R] [CommRing P] [Algebra R P]
    [IsNoetherianRing R] [Module.FaithfullyFlat R P]
    (I : Ideal R) (hI : I ≤ Ideal.jacobson ⊥)
    [IsNoetherianRing (AdicCompletion (I.map (algebraMap R P)) P)] :
    Module.FaithfullyFlat R (AdicCompletion (I.map (algebraMap R P)) P) := by
  let Q := AdicCompletion (I.map (algebraMap R P)) P
  have : IsAdicComplete (I.map (algebraMap R Q)) Q := by
    rw [IsScalarTower.algebraMap_eq R P Q, ← Ideal.map_map]
    exact AdicCompletion.isAdicComplete_self _ ((Ideal.fg_of_isNoetherianRing I).map _)
  have hred (n : ℕ) : Module.FaithfullyFlat (R ⧸ I ^ n)
      (Q ⧸ (I ^ n).map (algebraMap R Q)) := by
    have := Module.FaithfullyFlat.quotient_map (A := R) (C := P) (I ^ n)
    exact Module.FaithfullyFlat.of_linearEquiv _ _
      (AdicCompletion.quotPowMapEquiv I (Ideal.fg_of_isNoetherianRing I) n)
  have : Module.Flat R Q :=
    Module.Flat.of_flat_adic_reductions I (fun n => (hred n).toFlat)
  have : Module.FaithfullyFlat (R ⧸ I) (Q ⧸ I.map (algebraMap R Q)) := by
    convert hred 1 using 1 <;> rw [pow_one]
  exact Module.FaithfullyFlat.of_faithfullyFlat_reduction I hI

end Module.FaithfullyFlat

/-- A composite of two local ring maps in a scalar tower is local. -/
private theorem isLocalHom_algebraMap_of_tower (R S T : Type*) [CommRing R] [CommRing S]
    [CommRing T] [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap S T)] :
    IsLocalHom (algebraMap R T) := by
  rw [IsScalarTower.algebraMap_eq R S T]
  exact RingHom.isLocalHom_comp _ _

/-- **Stacks 00PH over a discrete valuation ring.** A Noetherian local ring `T` which is flat
and local over a discrete valuation ring `R` admits a local `R`-algebra map to a discrete
valuation ring extension `V` of `R`, with `#V` controlled by `#T`.

Going down (available because `T` is flat over `R`) produces a prime `q` of `T` inside the
maximal ideal and lying over `(0)`; the quotient `T ⧸ q` is then a Noetherian local domain
containing `R`, dominated by `R` and not a field, so Stacks 00PH applies to it. -/
theorem exists_isDiscreteValuationRing_isExtension_of_flat
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (T : Type v) [CommRing T] [IsNoetherianRing T] [IsLocalRing T]
    [Algebra R T] [Module.Flat R T] [IsLocalHom (algebraMap R T)]
    (kappa : Cardinal.{v}) (hk : aleph0 < kappa) (hT : #T < kappa) :
    ∃ (V : Type v) (_ : CommRing V) (_ : IsDomain V) (_ : IsDiscreteValuationRing V)
      (_ : Algebra R V) (_ : IsDiscreteValuationRing.IsExtension R V)
      (g : T →ₐ[R] V), IsLocalHom g.toRingHom ∧ #V < kappa := by
  have hm : (IsLocalRing.maximalIdeal T).LiesOver (IsLocalRing.maximalIdeal R) :=
    ⟨(IsLocalRing.maximalIdeal_comap _).symm⟩
  obtain ⟨q, -, hq, hqR⟩ := Ideal.exists_ideal_le_liesOver_of_le
    (p := (⊥ : Ideal R)) (q := IsLocalRing.maximalIdeal R)
    (IsLocalRing.maximalIdeal T) bot_le
  have hqR' : q.comap (algebraMap R T) = ⊥ := hqR.over.symm
  have hinj : Function.Injective (algebraMap R (T ⧸ q)) := by
    rw [RingHom.injective_iff_ker_eq_bot, IsScalarTower.algebraMap_eq R T (T ⧸ q),
      ← RingHom.comap_ker]
    change (RingHom.ker (Ideal.Quotient.mk q)).comap (algebraMap R T) = ⊥
    rw [Ideal.mk_ker, hqR']
  have : IsLocalRing (T ⧸ q) := IsLocalRing.of_surjective' (Ideal.Quotient.mk q)
    Ideal.Quotient.mk_surjective
  have hTQ : IsLocalHom (algebraMap T (T ⧸ q)) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have : IsLocalHom (algebraMap R (T ⧸ q)) := isLocalHom_algebraMap_of_tower R T (T ⧸ q)
  have hQnf : ¬ IsField (T ⧸ q) := by
    obtain ⟨pi, hpim, hpi⟩ := (IsLocalRing.maximalIdeal R).ne_bot_iff.mp
      (IsDiscreteValuationRing.not_a_field R)
    intro hQ
    have hpiQ : algebraMap R (T ⧸ q) pi ≠ 0 := fun h => hpi (hinj (by simpa using h))
    obtain ⟨b, hb⟩ := hQ.mul_inv_cancel hpiQ
    exact hpim (isUnit_of_map_unit (algebraMap R (T ⧸ q)) pi (IsUnit.of_mul_eq_one b hb))
  obtain ⟨V, hV, -, hlocal⟩ :=
    exists_isDiscreteValuationRing_isFractionRing_of_not_isField
      (R := T ⧸ q) (FractionRing (T ⧸ q)) (L := FractionRing (T ⧸ q)) hQnf
  let : Algebra R V := ((algebraMap (T ⧸ q) V).comp (algebraMap R (T ⧸ q))).toAlgebra
  have htower : IsScalarTower R (T ⧸ q) V := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : FaithfulSMul R (T ⧸ q) := (faithfulSMul_iff_algebraMap_injective R _).mpr hinj
  have : FaithfulSMul R V := FaithfulSMul.trans R (T ⧸ q) V
  have : IsLocalHom (algebraMap R V) := isLocalHom_algebraMap_of_tower R (T ⧸ q) V
  have : IsDiscreteValuationRing.IsExtension R V := ⟨⟩
  have hgLocal : IsLocalHom
      ((IsScalarTower.toAlgHom R (T ⧸ q) V).comp (Ideal.Quotient.mkₐ R q)).toRingHom :=
    RingHom.isLocalHom_comp (algebraMap (T ⧸ q) V) (algebraMap T (T ⧸ q))
  refine ⟨V, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    (IsScalarTower.toAlgHom R (T ⧸ q) V).comp (Ideal.Quotient.mkₐ R q), hgLocal, ?_⟩
  · refine lt_of_le_of_lt (mk_le_of_injective
      (f := fun x : V => (x : FractionRing (T ⧸ q))) Subtype.val_injective) ?_
    refine lt_of_le_of_lt
      (Cardinal.mk_le_of_isLocalization (nonZeroDivisors (T ⧸ q)) (FractionRing (T ⧸ q))) ?_
    exact max_lt hk ((mk_le_of_surjective (Ideal.Quotient.mk_surjective (I := q))).trans_lt hT)

/-- The complete version of `exists_isDiscreteValuationRing_isExtension_of_flat`: completing
the discrete valuation ring it produces at the maximal ideal keeps it a discrete valuation
ring extension of `R` (Stacks 0AP1), makes it complete, and keeps it small because a strong
prelimit cardinal above `ℵ₀` is closed under `lam ↦ lam ^ ℵ₀`. -/
theorem exists_isAdicComplete_isDiscreteValuationRing_of_flat
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (T : Type v) [CommRing T] [IsNoetherianRing T] [IsLocalRing T]
    [Algebra R T] [Module.Flat R T] [IsLocalHom (algebraMap R T)]
    (kappa : Cardinal.{v}) (hk : aleph0 < kappa) (hsl : IsStrongPrelimit kappa)
    (hT : #T < kappa) :
    ∃ (W : Type v) (_ : CommRing W) (_ : IsDomain W) (_ : IsDiscreteValuationRing W)
      (_ : Algebra R W) (_ : IsDiscreteValuationRing.IsExtension R W)
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal W) W)
      (g : T →ₐ[R] W), IsLocalHom g.toRingHom ∧ #W < kappa := by
  obtain ⟨V, hVring, hVdomain, hVdvr, hRV, hVext, g, hg, hVcard⟩ :=
    exists_isDiscreteValuationRing_isExtension_of_flat R T kappa hk hT
  obtain ⟨hWdomain, hWdvr⟩ := isDiscreteValuationRing_iff_adicCompletion_maximalIdeal.mp
    ⟨hVdomain, hVdvr⟩
  have hfaith : FaithfulSMul R (AdicCompletion (IsLocalRing.maximalIdeal V) V) :=
    FaithfulSMul.trans R V _
  have hloc : IsLocalHom (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal V) V)) :=
    isLocalHom_algebraMap_of_tower R V _
  refine ⟨AdicCompletion (IsLocalRing.maximalIdeal V) V, inferInstance, inferInstance,
    inferInstance, inferInstance, ⟨⟩, inferInstance,
    (IsScalarTower.toAlgHom R V (AdicCompletion (IsLocalRing.maximalIdeal V) V)).comp g,
    RingHom.isLocalHom_comp
      (algebraMap V (AdicCompletion (IsLocalRing.maximalIdeal V) V)) g.toRingHom,
    AdicCompletion.mk_lt_of_isStrongPrelimit _ hk hsl hVcard⟩

/-- A Noetherian faithfully flat algebra `T` over a discrete valuation ring `R` admits a map
to a complete discrete valuation ring extension of `R`: faithful flatness provides a prime of
`T` over the maximal ideal of `R`, and localizing there gives a Noetherian local ring to which
`exists_isAdicComplete_isDiscreteValuationRing_of_flat` applies. -/
theorem exists_isAdicComplete_isDiscreteValuationRing_of_faithfullyFlat
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (T : Type v) [CommRing T] [IsNoetherianRing T] [Algebra R T] [Module.FaithfullyFlat R T]
    (kappa : Cardinal.{v}) (hk : aleph0 < kappa) (hsl : IsStrongPrelimit kappa)
    (hT : #T < kappa) :
    ∃ (W : Type v) (_ : CommRing W) (_ : IsDomain W) (_ : IsDiscreteValuationRing W)
      (_ : Algebra R W) (_ : IsDiscreteValuationRing.IsExtension R W)
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal W) W),
      Nonempty (T →ₐ[R] W) ∧ #W < kappa := by
  obtain ⟨q, hq, hqR⟩ := Ideal.exists_isPrime_liesOver_of_faithfullyFlat
    (B := T) (IsLocalRing.maximalIdeal R)
  have : IsLocalHom (algebraMap R (Localization.AtPrime q)) := by
    refine ⟨fun r hr => ?_⟩
    rw [IsScalarTower.algebraMap_apply R T (Localization.AtPrime q)] at hr
    have hnot : algebraMap R T r ∉ q :=
      (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime q) q _).mp hr
    rw [← IsLocalRing.notMem_maximalIdeal, hqR.over]
    exact hnot
  obtain ⟨W, hWring, hWdomain, hWdvr, hRW, hWext, hWcomplete, g, -, hWcard⟩ :=
    exists_isAdicComplete_isDiscreteValuationRing_of_flat R (Localization.AtPrime q) kappa hk hsl
      ((Cardinal.mk_le_of_isLocalization q.primeCompl (Localization.AtPrime q)).trans_lt
        (max_lt hk hT))
  exact ⟨W, hWring, hWdomain, hWdvr, hRW, hWext, hWcomplete,
    ⟨g.comp (IsScalarTower.toAlgHom R T (Localization.AtPrime q))⟩, hWcard⟩

/-- A tensor product of two rings of cardinality below an uncountable `kappa` again has
cardinality below `kappa`: every element is a finite sum of pure tensors. -/
theorem Cardinal.mk_tensorProduct_lt {A C R : Type u} [CommRing A] [CommRing C] [CommRing R]
    [Algebra A C] [Algebra A R] (kappa : Cardinal.{u}) (hk : aleph0 < kappa)
    (hC : #C < kappa) (hR : #R < kappa) : #(TensorProduct A C R) < kappa := by
  have hF : Function.Surjective
      (fun l : List (C × R) => (l.map fun x => x.1 ⊗ₜ[A] x.2).sum) := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul c r => exact ⟨[(c, r)], by simp⟩
    | add x y hx hy =>
      obtain ⟨lx, rfl⟩ := hx
      obtain ⟨ly, rfl⟩ := hy
      exact ⟨lx ++ ly, by simp⟩
  refine (mk_le_of_surjective hF).trans_lt ?_
  rw [mk_list_eq_max_mk_aleph0, mk_prod, lift_id, lift_id]
  exact max_lt ((mul_le_max _ _).trans_lt (max_lt (max_lt hC hR) hk)) hk

attribute [local instance] Algebra.TensorProduct.rightAlgebra in
/-- **The lifting step of Stacks 0AQX.** Let `A` be a ring, `I ⊆ A` an ideal and `C` a
faithfully flat `A`-algebra which is `IC`-adically complete with reduction of finite type over
`A ⧸ I`. Let `R` be a complete discrete valuation ring which is an `A`-algebra carrying `I`
into its maximal ideal. Then there is an extension `R ⊂ W` of complete discrete valuation
rings and a ring map `C → W` over `A`.

The completed base change `(C ⊗[A] R)^` along `A → R` is Noetherian by Stacks 0AJQ and
faithfully flat over `R`, so
`exists_isAdicComplete_isDiscreteValuationRing_of_faithfullyFlat` applies to it. -/
theorem exists_isAdicComplete_isDiscreteValuationRing_ringHom
    {A C R : Type u} [CommRing A] [CommRing C] [CommRing R]
    [Algebra A C] [Algebra A R] [Module.FaithfullyFlat A C]
    [IsDomain R] [IsDiscreteValuationRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    (I : Ideal A) [IsAdicComplete (I.map (algebraMap A C)) C]
    [Algebra.FiniteType (A ⧸ I) (C ⧸ I.map (algebraMap A C))]
    (hmap : I.map (algebraMap A R) ≤ IsLocalRing.maximalIdeal R)
    (kappa : Cardinal.{u}) (hk : aleph0 < kappa) (hsl : IsStrongPrelimit kappa)
    (hC : #C < kappa) (hR : #R < kappa) :
    ∃ (W : Type u) (_ : CommRing W) (_ : IsDomain W) (_ : IsDiscreteValuationRing W)
      (_ : Algebra R W) (_ : IsDiscreteValuationRing.IsExtension R W)
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal W) W)
      (g : C →+* W), g.comp (algebraMap A C) =
        (algebraMap R W).comp (algebraMap A R) ∧ #W < kappa := by
  set P := TensorProduct A C R with hP
  set m := IsLocalRing.maximalIdeal R with hm
  set Q := AdicCompletion (m.map (algebraMap R P)) P with hQdef
  have hnoeth : IsNoetherianRing Q :=
    Rig.isNoetherianRing (Rig.completedBaseChangeObj I m 1 Nat.one_pos
      (by simpa only [pow_one] using hmap) (Ideal.fg_of_isNoetherianRing m)
      (Rig.AdicFiniteTypeAlgebra.of C inferInstance))
  have hPff : Module.FaithfullyFlat R P :=
    Module.FaithfullyFlat.of_linearEquiv _ _
      (Algebra.TensorProduct.commRight A R C).symm.toLinearEquiv
  have hQff : Module.FaithfullyFlat R Q :=
    Module.FaithfullyFlat.of_adicCompletion_map m (IsAdicComplete.le_jacobson_bot m)
  have hQcard : #Q < kappa := AdicCompletion.mk_lt_of_isStrongPrelimit _ hk hsl
    (Cardinal.mk_tensorProduct_lt kappa hk hC hR)
  obtain ⟨W, hWring, hWdomain, hWdvr, hRW, hWext, hWcomplete, ⟨g⟩, hWcard⟩ :=
    exists_isAdicComplete_isDiscreteValuationRing_of_faithfullyFlat R Q kappa hk hsl hQcard
  refine ⟨W, hWring, hWdomain, hWdvr, hRW, hWext, hWcomplete,
    g.toRingHom.comp ((algebraMap P Q).comp
      (Algebra.TensorProduct.includeLeft : C →ₐ[A] P).toRingHom), ?_, hWcard⟩
  ext a
  change g (algebraMap P Q (Algebra.TensorProduct.includeLeft (algebraMap A C a))) = _
  have hin : (Algebra.TensorProduct.includeLeft : C →ₐ[A] P) (algebraMap A C a) =
      algebraMap R P (algebraMap A R a) :=
    congrArg (fun f : A →+* P => f a)
      (Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap (R := A) (A := C) (B := R))
  rw [hin, ← IsScalarTower.algebraMap_apply R P Q]
  exact g.commutes _

end
