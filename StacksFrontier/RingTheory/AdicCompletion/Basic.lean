/-!
# Adic completions and adic completeness

Results on `I`-adic completions and `I`-adic completeness of modules over a commutative ring.

## Main results

* `adicCompletion_of_surjective_of_forall_span_singleton_surjective`: for `I = (f₁, …, f_r)`,
  if each `M → limₙ M/fᵢⁿM` is surjective, so is `M → limₙ M/IⁿM`.
* `isAdicComplete_of_le_of_fg_of_isAdicComplete`: for ideals `I ⊆ J` with `I` finitely
  generated, a `J`-adically complete module is `I`-adically complete.
* `agreement_of_completions` and `completeness_preserved`: ideals `I`, `J` with `I^c ⊆ J` and
  `J^d ⊆ I` give isomorphic completions, and the same notion of completeness.
* `main_theorem_031a`: for `M` complete and `K ⊆ M`, `M ⧸ K` is complete iff
  `K = ⋂ₙ (K + IⁿM)`.
* `isAdicComplete_of_iInf_smul_eq_bot`: a finite module over a complete ring is complete as
  soon as `⋂ₙ IⁿM = 0`.

## Surjectivity onto the completion for a finitely generated ideal

Let `A` be a commutative ring and `M` an `A`-module, and let `I = (f₁, …, f_r)` be a
finitely generated ideal. If the canonical map `M → limₙ M/fᵢⁿM` is surjective for each
`i`, then the canonical map `M → limₙ M/IⁿM` is surjective.

### Notation

For an ideal `J` and `n ≥ 0`, the submodule `JⁿM ⊆ M` generated by the products `a • m`
with `a ∈ Jⁿ` and `m ∈ M` is written `J ^ n • (⊤ : Submodule A M)`. For a single element
`f` we have `fⁿM = (f)ⁿM = (fⁿ)M`, since `(f)ⁿ = (fⁿ)` for a principal ideal.

The inverse limit `limₙ M/JⁿM` of the tower `⋯ → M/Jⁿ⁺¹M → M/JⁿM` — whose transition
maps are the canonical surjections coming from `JᵐM ⊆ JⁿM` for `n ≤ m` — is
`AdicCompletion J M`, the submodule of compatible families in `∏ n, M ⧸ J ^ n • ⊤`. The
canonical `A`-linear map `M → AdicCompletion J M` sending `x` to `(x + JⁿM)ₙ` is
`AdicCompletion.of J M`.

When `r = 0` the ideal is `(0)`, the hypothesis is vacuous, and the statement still
holds: the completion of `M` at the zero ideal is `M`.
-/

@[expose] public section

open AdicCompletion

/-- **Upper cofinality inclusion** `(f_1^n, …, f_r^n) M ⊆ I^n M`, with `I = span (range f)`. -/
theorem span_pow_range_smul_top_le
    {A : Type*} [CommRing A] (M : Type*) [AddCommGroup M] [Module A M]
    {r : ℕ} (f : Fin r → A) (n : ℕ) :
    (Ideal.span (Set.range (fun i => f i ^ n))) • (⊤ : Submodule A M)
      ≤ (Ideal.span (Set.range f)) ^ n • (⊤ : Submodule A M) := by
  apply Submodule.smul_mono_left
  rw [Ideal.span_le, Set.range_subset_iff]
  intro i
  have hmem : f i ∈ Ideal.span (Set.range f) := Ideal.subset_span ⟨i, rfl⟩
  exact Ideal.pow_mem_pow hmem n

/-- **Lower cofinality inclusion** `I^{rn} M ⊆ (f_1^n, …, f_r^n) M`, with `I = span (range f)`
and `r > 0`. -/
theorem pow_span_range_smul_top_le
    {A : Type*} [CommRing A] (M : Type*) [AddCommGroup M] [Module A M]
    {r : ℕ} (hr : 0 < r) (f : Fin r → A) (n : ℕ) :
    (Ideal.span (Set.range f)) ^ (r * n) • (⊤ : Submodule A M)
      ≤ (Ideal.span (Set.range (fun i => f i ^ n))) • (⊤ : Submodule A M) := by
  apply Submodule.smul_mono_left
  rw [Submodule.span_pow, Ideal.span_le]
  intro x hx
  rw [Set.mem_pow] at hx
  obtain ⟨g, hg⟩ := hx
  choose c hc using fun i => (g i).property
  have hx_eq : x = ∏ i, f (c i) := by
    rw [← hg, List.prod_ofFn]
    exact (Finset.prod_congr rfl (fun i _ => hc i)).symm
  have hpigeon : ∃ j : Fin r, n ≤ (Finset.univ.filter (fun i => c i = j)).card := by
    by_contra h
    push Not at h
    have hsum : ∑ j : Fin r, (Finset.univ.filter (fun i => c i = j)).card = r * n := by
      rw [← Finset.card_eq_sum_card_fiberwise (fun i _ => Finset.mem_univ (c i))]
      simp [Finset.card_univ]
    have hle : ∑ j : Fin r, (Finset.univ.filter (fun i => c i = j)).card
        ≤ ∑ _j : Fin r, (n - 1) :=
      Finset.sum_le_sum fun j _ => Nat.le_sub_one_of_lt (h j)
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hle
    rw [hsum] at hle
    rcases Nat.eq_zero_or_pos n with hn | hn
    · exact absurd (h ⟨0, hr⟩) (by simp [hn])
    · nlinarith [Nat.sub_lt hn (by norm_num : 0 < 1)]
  obtain ⟨j, hj⟩ := hpigeon
  have hdvd : f j ^ n ∣ x := by
    rw [hx_eq]
    have hfib : ∏ i, f (c i)
        = ∏ j' : Fin r, ∏ i ∈ Finset.univ.filter (fun i => c i = j'), f (c i) := by
      rw [Finset.prod_fiberwise]
    rw [hfib]
    have hfactor : ∏ i ∈ Finset.univ.filter (fun i => c i = j), f (c i)
        = f j ^ (Finset.univ.filter (fun i => c i = j)).card := by
      rw [Finset.prod_congr rfl
        (fun i hi => by simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi; rw [hi]),
        Finset.prod_const]
    refine dvd_trans (pow_dvd_pow (f j) hj) ?_
    rw [← hfactor]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_univ j)
  have hmem : f j ^ n ∈ Ideal.span (Set.range fun i => f i ^ n) :=
    Ideal.subset_span ⟨j, rfl⟩
  obtain ⟨k, rfl⟩ := hdvd
  exact Ideal.mul_mem_right k _ hmem

/-- Partial sums of terms lying in `S` between `N` and `N'` are congruent modulo `S`. -/
private theorem sum_range_smodEq_of_mem {A : Type*} [CommRing A] {M : Type*} [AddCommGroup M]
    [Module A M] (S : Submodule A M) (w : ℕ → M) {N N' : ℕ} (h : N ≤ N')
    (hw : ∀ k ∈ Finset.Ico N N', w k ∈ S) :
    ∑ k ∈ Finset.range N, w k ≡ ∑ k ∈ Finset.range N', w k [SMOD S] := by
  rw [SModEq.sub_mem, ← Finset.sum_range_add_sum_Ico _ h, sub_add_cancel_left, neg_mem_iff]
  exact Submodule.sum_mem _ hw

/-- Precompleteness of the finitely generated ideal `I = span (range f)` follows from
precompleteness of each principal ideal `(f i)`. -/
theorem isPrecomplete_span_range_of_forall_singleton
    {A : Type*} [CommRing A] (M : Type*) [AddCommGroup M] [Module A M]
    {r : ℕ} (f : Fin r → A)
    (hp : ∀ i, IsPrecomplete (Ideal.span {f i}) M) :
    IsPrecomplete (Ideal.span (Set.range f)) M := by
  rcases Nat.eq_zero_or_pos r with hr | hr
  · have hbot : Ideal.span (Set.range f) = ⊥ := by
      subst hr
      simp
    rw [hbot]
    infer_instance
  · set I := Ideal.span (Set.range f) with hI
    set J : ℕ → Submodule A M :=
      fun n => (Ideal.span (Set.range (fun i => f i ^ n))) • (⊤ : Submodule A M) with hJdef
    set P : Fin r → ℕ → Submodule A M :=
      fun i n => (Ideal.span {f i})^n • (⊤ : Submodule A M) with hP
    have lower := fun n => pow_span_range_smul_top_le M hr f n
    have upper := fun n => span_pow_range_smul_top_le M f n
    have decomp : ∀ (n : ℕ) (x : M), x ∈ J n →
        ∃ y : Fin r → M, (∀ i, y i ∈ P i n) ∧
          x = ∑ i, y i := by
      intro n x hx
      have hJeq : J n = ⨆ i, (Ideal.span {f i ^ n}) • (⊤ : Submodule A M) := by
        rw [hJdef]
        simp only
        rw [Ideal.span_range_eq_iSup, Submodule.iSup_smul]
      rw [hJeq] at hx
      rw [Submodule.mem_iSup_iff_exists_finsupp] at hx
      obtain ⟨c, hc, hsum⟩ := hx
      refine ⟨fun i => c i, fun i => ?_, ?_⟩
      · rw [hP]; simp only; rw [Ideal.span_singleton_pow]; exact hc i
      · rw [← hsum, Finsupp.sum_fintype]; intro i; rfl
    constructor
    intro g hg
    set h : ℕ → M := fun m => g (r * m) with hh
    have hcauchyJ : ∀ {m p : ℕ}, m ≤ p → h m ≡ h p [SMOD J m] := by
      intro m p hmp
      have h1 : g (r * m) ≡ g (r * p) [SMOD I ^ (r * m) • (⊤ : Submodule A M)] :=
        hg (by exact Nat.mul_le_mul_left r hmp)
      exact SModEq.mono (lower m) h1
    have hd : ∀ k, h k ≡ h (k+1) [SMOD J k] := fun k => hcauchyJ (Nat.le_succ k)
    have hdmem : ∀ k, h (k+1) - h k ∈ J k := by
      intro k
      have hk := (hd k)
      rw [SModEq.sub_mem] at hk
      have hk2 : -(h k - h (k+1)) ∈ J k := (J k).neg_mem hk
      simpa using hk2
    choose w hw1 hw2 using fun k => decomp k (h (k+1) - h k) (hdmem k)
    set s : Fin r → ℕ → M := fun i N => ∑ k ∈ Finset.range N, w k i with hs
    have htel : ∀ N, h N = h 0 + ∑ i, s i N := by
      intro N
      induction N with
      | zero => simp [hs]
      | succ n ih =>
          have hstep : ∑ i, s i (n+1) = (∑ i, s i n) + (h (n+1) - h n) := by
            rw [hw2 n]
            rw [← Finset.sum_add_distrib]
            apply Finset.sum_congr rfl
            intro i _
            rw [hs]
            simp only
            rw [Finset.sum_range_succ]
          rw [hstep, ← add_assoc, ← ih]
          abel
    have hsCauchy : ∀ i, ∀ {N N' : ℕ}, N ≤ N' →
        s i N ≡ s i N' [SMOD P i N] := by
      intro i N N' hNN'
      refine sum_range_smodEq_of_mem _ (fun k => w k i) hNN' fun k hk => ?_
      exact Submodule.smul_mono_left (Ideal.pow_le_pow_right (Finset.mem_Ico.mp hk).1) (hw1 k i)
    have key : ∀ i, ∃ L : M, ∀ n,
        s i n ≡ L [SMOD P i n] := by
      intro i
      have hc : ∀ {N N' : ℕ}, N ≤ N' →
          s i N ≡ s i N' [SMOD (Ideal.span {f i}) ^ N • (⊤ : Submodule A M)] := by
        intro N N' hNN'
        have := hsCauchy i hNN'
        rwa [hP] at this
      have hlift := (hp i).prec (f := fun N => s i N) (fun {N N'} hh' => hc hh')
      obtain ⟨Li, hLi⟩ := hlift
      refine ⟨Li, fun n => ?_⟩
      have := hLi n
      rw [hP]
      simpa using this
    choose Li hLi using key
    set L : M := h 0 + ∑ i, Li i with hL
    have hPiJ : ∀ i N, P i N ≤ J N := by
      intro i N
      rw [hJdef, hP]; simp only
      rw [Ideal.span_singleton_pow]
      apply Submodule.smul_mono_left
      apply Ideal.span_mono
      intro x hx
      simp only [Set.mem_singleton_iff] at hx
      exact ⟨i, by rw [hx]⟩
    have hhL : ∀ N, h N ≡ L [SMOD I ^ N • (⊤ : Submodule A M)] := by
      intro N
      have hJN : h N ≡ L [SMOD J N] := by
        rw [SModEq.sub_mem]
        have heq : h N - L = ∑ i, (s i N - Li i) := by
          rw [htel N, hL]
          rw [Finset.sum_sub_distrib]
          abel
        rw [heq]
        apply Submodule.sum_mem
        intro i _
        have hmem : (s i N - Li i) ∈ P i N := by
          have hsmod := hLi i N
          rwa [SModEq.sub_mem] at hsmod
        exact hPiJ i N hmem
      have hup : J N ≤ I ^ N • (⊤ : Submodule A M) := upper N
      exact SModEq.mono hup hJN
    refine ⟨L, fun n => ?_⟩
    have h1 : g n ≡ g (r * n) [SMOD I ^ n • (⊤ : Submodule A M)] :=
      hg (Nat.le_mul_of_pos_left n hr)
    have h2 : g (r * n) ≡ L [SMOD I ^ n • (⊤ : Submodule A M)] := hhL n
    exact SModEq.trans h1 h2

/-- If `I` is generated by the finite family `f_1, …, f_r`, indexed here by `Fin r`, and
the canonical map `M → limₙ M/f_i^n M` is surjective for each `i`, then the canonical map
`M → limₙ M/I^n M` is surjective. -/
@[stacks 090S]
theorem adicCompletion_of_surjective_of_forall_span_singleton_surjective
    {A : Type*} [CommRing A] (M : Type*) [AddCommGroup M] [Module A M]
    {r : ℕ} (f : Fin r → A)
    (hf : ∀ i, Function.Surjective (AdicCompletion.of (Ideal.span {f i}) M))
    (I : Ideal A) (hI : I = Ideal.span (Set.range f)) :
    Function.Surjective (AdicCompletion.of I M) := by
  have hprec : ∀ i, IsPrecomplete (Ideal.span {f i}) M := fun i =>
    AdicCompletion.of_surjective_iff.mp (hf i)
  subst hI
  have : IsPrecomplete (Ideal.span (Set.range f)) M :=
    isPrecomplete_span_range_of_forall_singleton M f hprec
  exact AdicCompletion.of_surjective _ M

/-!
## Adic completeness passes to a smaller finitely generated ideal

Throughout, `A` is a commutative unital ring, `I ⊆ A` an ideal and `M` an `A`-module. For
`n ∈ ℕ` the ideal power `I ^ n` has `I ^ 0 = A`, and `IⁿM`, written `I ^ n • ⊤`, is the
submodule of `M` generated by the products `a • m` with `a ∈ Iⁿ` and `m ∈ M`.

The submodules `IⁿM` form a decreasing filtration `M = I⁰M ⊇ I¹M ⊇ ⋯`, and for `m ≥ n`
the canonical surjection `M/IᵐM → M/IⁿM` makes `(M/IⁿM)` an inverse system indexed by
`ℕ`. The `I`-adic completion of `M` is the inverse limit `M^_I = limₙ M/IⁿM`, which is
`AdicCompletion I M`, together with the canonical completion map `c_I : M → M^_I`. The
module `M` is `I`-adically complete when `c_I` is an isomorphism; equivalently `M` is
separated, `⋂ₙ IⁿM = 0`, and every `I`-adic Cauchy sequence converges. These two halves
are `IsHausdorff I M` and `IsPrecomplete I M`, and their conjunction is
`IsAdicComplete I M`.

Let `I ⊆ J ⊆ A` be ideals. If `M` is `J`-adically complete and `I` is finitely
generated, then `M` is `I`-adically complete.
-/

@[expose] public section

open Submodule

-- `IsAdicComplete` is separatedness together with precompleteness.
example {A : Type*} [CommRing A] (I : Ideal A) (M : Type*) [AddCommGroup M]
    [Module A M] : IsAdicComplete I M ↔ IsHausdorff I M ∧ IsPrecomplete I M :=
  isAdicComplete_iff I M

/-- Decompose an element of `(span P) • N` (with `P` a finite set) as an explicit
finite sum `∑ p ∈ P, p • g p` with coefficients `g p ∈ N`. -/
theorem mem_span_smul_decomp {A : Type*} [CommRing A] (P : Finset A)
    {M : Type*} [AddCommGroup M] [Module A M]
    (N : Submodule A M) (y : M) (hy : y ∈ (Ideal.span (P : Set A)) • N) :
    ∃ g : A → M, (∀ p ∈ P, g p ∈ N) ∧ y = ∑ p ∈ P, p • g p := by
  refine Submodule.smul_induction_on hy ?_ ?_
  · intro r hr n hn
    rw [Ideal.span, Submodule.mem_span_finset] at hr
    obtain ⟨c, _, hc⟩ := hr
    refine ⟨fun p => c p • n, fun p _ => N.smul_mem _ hn, ?_⟩
    rw [← hc, Finset.sum_smul]
    apply Finset.sum_congr rfl
    intro p _
    rw [smul_smul, smul_eq_mul, mul_comm (c p) p]
  · rintro x z ⟨gx, hgx, hx⟩ ⟨gz, hgz, hz⟩
    refine ⟨fun p => gx p + gz p, fun p hp => N.add_mem (hgx p hp) (hgz p hp), ?_⟩
    rw [hx, hz, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro p _
    rw [smul_add]

/-- Let `A` be a (commutative, unital) ring, and let `I ⊆ J ⊆ A` be ideals.
If `M` is `J`-adically complete and `I` is a finitely generated ideal, then
`M` is `I`-adically complete. -/
@[stacks 090T, ega "0 7.2.3" "special case", ega "0 7.2.4" "Case M = A"]
theorem isAdicComplete_of_le_of_fg_of_isAdicComplete
    {A : Type*} [CommRing A] {I J : Ideal A} (hIJ : I ≤ J)
    {M : Type*} [AddCommGroup M] [Module A M]
    (hM : IsAdicComplete J M) (hI : I.FG) :
    IsAdicComplete I M := by
  have mono : ∀ (K L : Ideal A), K ≤ L → ∀ n,
      (K ^ n • (⊤ : Submodule A M)) ≤ (L ^ n • (⊤ : Submodule A M)) := by
    intro K L h n
    exact Submodule.smul_mono (pow_le_pow_left' h n) le_rfl
  rw [isAdicComplete_iff]
  refine ⟨⟨?_⟩, ⟨?_⟩⟩
  · intro x hx
    apply hM.toIsHausdorff.haus x
    intro n
    have := hx n
    rw [SModEq.zero] at this ⊢
    exact mono I J hIJ n this
  · intro f hf
    obtain ⟨L, hL⟩ : ∃ L, ∀ n, f n ≡ L [SMOD J ^ n • (⊤ : Submodule A M)] := by
      apply hM.toIsPrecomplete.prec
      intro m n hmn
      have := hf hmn
      rw [SModEq.sub_mem] at this ⊢
      exact mono I J hIJ m this
    refine ⟨L, fun k => ?_⟩
    rw [SModEq.sub_mem, ← neg_mem_iff, neg_sub]
    obtain ⟨P, hP⟩ : ∃ P : Finset A, Ideal.span (P : Set A) = I ^ k :=
      (Ideal.FG.pow hI : (I ^ k).FG)
    set g : ℕ → M := fun n => f (n + 1) - f n with hg
    have hgmem : ∀ n, g n ∈ (I ^ n • (⊤ : Submodule A M)) := by
      intro n
      have := hf (m := n) (n := n + 1) (Nat.le_succ n)
      rw [SModEq.sub_mem] at this
      simpa [hg, neg_sub] using (Submodule.neg_mem _ this)
    have hdecomp : ∀ t, ∃ h : A → M,
        (∀ p ∈ P, h p ∈ (I ^ t • (⊤ : Submodule A M))) ∧
        g (k + t) = ∑ p ∈ P, p • h p := by
      intro t
      have hmem : g (k + t) ∈ (Ideal.span (P : Set A)) • (I ^ t • (⊤ : Submodule A M)) := by
        have : (Ideal.span (P : Set A)) • (I ^ t • (⊤ : Submodule A M))
            = (I ^ (k + t) • (⊤ : Submodule A M)) := by
          rw [hP, ← Submodule.mul_smul, ← pow_add]
        rw [this]
        exact hgmem (k + t)
      exact mem_span_smul_decomp P _ _ hmem
    choose h hh1 hh2 using hdecomp
    set D : ℕ → A → M := fun N p => ∑ t ∈ Finset.range N, h t p with hD
    have hwexist : ∀ p ∈ P, ∃ w, ∀ N, D N p ≡ w [SMOD J ^ N • (⊤ : Submodule A M)] := by
      intro p hp
      apply hM.toIsPrecomplete.prec
      intro N N' hNN'
      refine sum_range_smodEq_of_mem _ (h · p) hNN' fun t ht => ?_
      exact Submodule.pow_smul_top_le J M (Finset.mem_Ico.mp ht).1 (mono I J hIJ t (hh1 t p hp))
    choose w hw using hwexist
    set S : M := ∑ p ∈ P.attach, (p.val : A) • w p.val p.property with hS
    have hS4 : S ∈ (I ^ k • (⊤ : Submodule A M)) := by
      rw [hS]
      exact Submodule.sum_mem _ fun p _ =>
        Submodule.smul_mem_smul (hP ▸ Submodule.subset_span p.property) Submodule.mem_top
    have hS1 : ∀ N, f (k + N) - f k = ∑ t ∈ Finset.range N, g (k + t) := by
      intro N
      induction N with
      | zero => simp
      | succ n ih =>
        rw [Finset.sum_range_succ, ← ih, hg]
        have : k + (n + 1) = k + n + 1 := by omega
        rw [this]
        simp only []
        abel
    have hS2 : ∀ N, (∑ t ∈ Finset.range N, g (k + t))
        = ∑ p ∈ P.attach, (p.val : A) • D N p.val := by
      intro N
      rw [Finset.sum_attach P (fun p => p • D N p)]
      simp only [hh2, hD]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro p hp
      rw [Finset.smul_sum]
    have hPartial : ∀ N, f (k + N) - f k = ∑ p ∈ P.attach, (p.val : A) • D N p.val :=
      fun N => (hS1 N).trans (hS2 N)
    have hS3 : L - f k = S := by
      have hsub : (L - f k) - S = 0 := by
        apply hM.toIsHausdorff.haus
        intro N
        rw [SModEq.zero]
        have h1 : L - f (k + N) ∈ (J ^ N • (⊤ : Submodule A M)) :=
          Submodule.pow_smul_top_le J M (Nat.le_add_left N k) (SModEq.sub_mem.mp (hL (k + N)).symm)
        have h3 : (∑ p ∈ P.attach, (p.val:A) • D N p.val) - S ∈
            (J ^ N • (⊤ : Submodule A M)) := by
          rw [hS, ← Finset.sum_sub_distrib]
          apply Submodule.sum_mem
          intro p hp
          have hd : D N p.val - w p.val p.property ∈ (J ^ N • (⊤ : Submodule A M)) := by
            have := hw p.val p.property N; rwa [SModEq.sub_mem] at this
          rw [← smul_sub]
          exact Submodule.smul_mem _ p.val hd
        have key : (L - f k) - S
            = (L - f (k+N)) + ((f (k+N) - f k) - ∑ p ∈ P.attach, (p.val:A) • D N p.val)
              + ((∑ p ∈ P.attach, (p.val:A) • D N p.val) - S) := by abel
        rw [key, hPartial N, sub_self, add_zero]
        exact Submodule.add_mem _ h1 h3
      exact sub_eq_zero.mp hsub
    rw [hS3]
    exact hS4

/-!
## Cofinal ideals give the same completion

Throughout, `R` is a commutative unital ring, `I, J ⊆ R` are ideals and `M` is an
`R`-module.

The `I`-adic completion of `M` is the inverse limit `M^_I = limₙ M/IⁿM` of the tower of
quotients, whose transition maps for `m ≥ n` are the canonical surjections
`M/IᵐM → M/IⁿM`; the canonical `R`-linear map `ι_I : M → M^_I` sends `m` to
`(m mod IⁿM)ₙ`. In Mathlib these are `AdicCompletion I M` and `AdicCompletion.of I M`,
and the submodule `IⁿM` is written `I ^ n • ⊤`. The module `M` is `I`-adically complete
when `ι_I` is an isomorphism; equivalently `M` is separated, `⋂ₙ IⁿM = 0`, and
complete, which Mathlib packages as `IsAdicComplete I M = IsHausdorff I M` together
with `IsPrecomplete I M`.

Suppose there are integers `c, d > 0` with `Iᶜ ⊆ J` and `J^d ⊆ I`, so that `I` and `J`
define the same adic topology. Then:

* for every `R`-module `M` there is a canonical `R`-linear isomorphism `M^_I ≅ M^_J`
  compatible with the canonical maps from `M`; and
* `M` is `I`-adically complete if and only if it is `J`-adically complete.
-/

@[expose] public section

namespace Stacks.AdicCompletionComparison

open AdicCompletion

/-- The submodule inclusion `I^(c*n) M ⊆ J^n M` coming from `I^c ⊆ J`. -/
theorem incl {R : Type*} [CommRing R] (I J : Ideal R)
    {c : ℕ} (hIJ : I ^ c ≤ J)
    (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ) :
    (I ^ (c * n)) • (⊤ : Submodule R M) ≤ (J ^ n) • ⊤ :=
  Submodule.smul_mono (by rw [pow_mul]; exact pow_le_pow_left' hIJ n) le_rfl

/-- The comparison `R`-linear map `M^_I → M^_J` induced by `I^c ⊆ J`: at level
`n` we take the level-`c*n` component of the `I`-adic completion and push it
along the inclusion `I^(c*n) M ⊆ J^n M`. -/
noncomputable def cmap {R : Type*} [CommRing R] (I J : Ideal R)
    {c : ℕ} (hIJ : I ^ c ≤ J)
    (M : Type*) [AddCommGroup M] [Module R M] :
    AdicCompletion I M →ₗ[R] AdicCompletion J M where
  toFun x := ⟨fun n => Submodule.factor (incl I J hIJ M n) (AdicCompletion.eval I M (c * n) x), by
    intro m n hmn
    have hev : AdicCompletion.eval I M (c * m) x
        = AdicCompletion.transitionMap I M (Nat.mul_le_mul_left c hmn)
            (AdicCompletion.eval I M (c * n) x) := by
      have := AdicCompletion.transitionMap_comp_eval I M (Nat.mul_le_mul_left c hmn)
      exact (congrFun (congrArg DFunLike.coe this) x).symm
    change AdicCompletion.transitionMap J M hmn
        (Submodule.factor (incl I J hIJ M n) (AdicCompletion.eval I M (c * n) x))
      = Submodule.factor (incl I J hIJ M m) (AdicCompletion.eval I M (c * m) x)
    rw [hev]
    set z := AdicCompletion.eval I M (c * n) x with hz
    obtain ⟨y, hy⟩ := Submodule.mkQ_surjective (I ^ (c * n) • (⊤ : Submodule R M)) z
    rw [← hy]
    simp only [AdicCompletion.transitionMap, Submodule.factor_mk]⟩
  map_add' x y := by
    apply Subtype.ext; funext n; simp only [map_add]; rfl
  map_smul' r x := by
    apply Subtype.ext; funext n; simp only [map_smul, RingHom.id_apply]; rfl

/-- Computing the level-`n` component of `cmap`. -/
theorem eval_cmap {R : Type*} [CommRing R] (I J : Ideal R)
    {c : ℕ} (hIJ : I ^ c ≤ J)
    (M : Type*) [AddCommGroup M] [Module R M] (x : AdicCompletion I M) (n : ℕ) :
    AdicCompletion.eval J M n (cmap I J hIJ M x)
      = Submodule.factor (incl I J hIJ M n) (AdicCompletion.eval I M (c * n) x) := rfl

/-- The two comparison maps are mutually inverse. -/
theorem cmap_cmap {R : Type*} [CommRing R] (I J : Ideal R)
    {c d : ℕ} (hc : 0 < c) (hd : 0 < d) (hIJ : I ^ c ≤ J) (hJI : J ^ d ≤ I)
    (M : Type*) [AddCommGroup M] [Module R M] (x : AdicCompletion I M) :
    cmap J I hJI M (cmap I J hIJ M x) = x := by
  apply AdicCompletion.ext
  intro n
  change AdicCompletion.eval I M n (cmap J I hJI M (cmap I J hIJ M x)) = AdicCompletion.eval I M n x
  rw [eval_cmap J I hJI M (cmap I J hIJ M x) n, eval_cmap I J hIJ M x (d * n)]
  have hn : n ≤ c * (d * n) := by
    calc n ≤ d * n := Nat.le_mul_of_pos_left n hd
      _ ≤ c * (d * n) := Nat.le_mul_of_pos_left _ hc
  rw [show AdicCompletion.eval I M n x = AdicCompletion.transitionMap I M hn
      (AdicCompletion.eval I M (c * (d * n)) x) from
        (AdicCompletion.transitionMap_comp_eval_apply I M hn x).symm]
  exact Submodule.factor_comp_apply _ _ _

/-- Compatibility of `cmap` with the canonical maps from `M`. -/
theorem cmap_of {R : Type*} [CommRing R] (I J : Ideal R)
    {c : ℕ} (hIJ : I ^ c ≤ J)
    (M : Type*) [AddCommGroup M] [Module R M] (m : M) :
    cmap I J hIJ M (AdicCompletion.of I M m) = AdicCompletion.of J M m := by
  apply AdicCompletion.ext
  intro n
  change AdicCompletion.eval J M n (cmap I J hIJ M (AdicCompletion.of I M m))
      = AdicCompletion.eval J M n (AdicCompletion.of J M m)
  rw [eval_cmap I J hIJ M (AdicCompletion.of I M m) n,
    AdicCompletion.eval_of I M (c * n) m, AdicCompletion.eval_of J M n m,
    Submodule.factor_mk]

/-- Hausdorffness transfers along `J^d ⊆ I`. -/
theorem haus_imp {R : Type*} [CommRing R] (I J : Ideal R)
    {d : ℕ} (hJI : J ^ d ≤ I)
    (M : Type*) [AddCommGroup M] [Module R M] (h : IsHausdorff I M) :
    IsHausdorff J M := by
  refine ⟨fun x hx => h.haus x (fun n => ?_)⟩
  rw [SModEq.zero]
  have hxn := hx (d * n)
  rw [SModEq.zero] at hxn
  exact incl J I hJI M n hxn

/-- Precompleteness transfers under same-topology hypotheses. -/
theorem prec_imp {R : Type*} [CommRing R] (I J : Ideal R)
    {c d : ℕ} (hc : 0 < c) (hd : 0 < d)
    (hIJ : I ^ c ≤ J) (hJI : J ^ d ≤ I)
    (M : Type*) [AddCommGroup M] [Module R M] (h : IsPrecomplete I M) :
    IsPrecomplete J M := by
  refine ⟨fun f hf => ?_⟩
  obtain ⟨L, hL⟩ := h.prec (f := fun n => f (d * n)) fun hmn =>
    SModEq.mono (incl J I hJI M _) (hf (Nat.mul_le_mul_left d hmn))
  refine ⟨L, fun n => ?_⟩
  have h1 : f n ≡ f (d * (c * n)) [SMOD J ^ n • (⊤ : Submodule R M)] :=
    hf ((Nat.le_mul_of_pos_left n hc).trans (Nat.le_mul_of_pos_left _ hd))
  exact h1.trans (SModEq.mono (incl I J hIJ M n) (hL (c * n)))

end Stacks.AdicCompletionComparison

/-- Under the hypotheses `I^c ⊆ J` and
`J^d ⊆ I` (with `c, d > 0`), for every `R`-module `M` there is a canonical
`R`-linear isomorphism between the `I`-adic and `J`-adic completions of `M`,
compatible with the canonical maps from `M`. -/
@[stacks 0319]
theorem agreement_of_completions
    {R : Type*} [CommRing R] (I J : Ideal R)
    {c d : ℕ} (hc : 0 < c) (hd : 0 < d)
    (hIJ : I ^ c ≤ J) (hJI : J ^ d ≤ I)
    (M : Type*) [AddCommGroup M] [Module R M] :
    ∃ e : AdicCompletion I M ≃ₗ[R] AdicCompletion J M,
      e.toLinearMap.comp (AdicCompletion.of I M) = AdicCompletion.of J M := by
  refine
    ⟨LinearEquiv.ofLinearMap (Stacks.AdicCompletionComparison.cmap I J hIJ M)
      (Stacks.AdicCompletionComparison.cmap J I hJI M)
    (LinearMap.ext fun x => Stacks.AdicCompletionComparison.cmap_cmap J I hd hc hJI hIJ M x)
    (LinearMap.ext fun x => Stacks.AdicCompletionComparison.cmap_cmap I J hc hd hIJ hJI M x), ?_⟩
  exact LinearMap.ext fun m => Stacks.AdicCompletionComparison.cmap_of I J hIJ M m

/-- Under the hypotheses `I^c ⊆ J` and `J^d ⊆ I` (with `c, d > 0`), an
`R`-module `M` is `I`-adically complete if and only if it is `J`-adically
complete. -/
@[stacks 0319 "in particular"]
theorem completeness_preserved
    {R : Type*} [CommRing R] (I J : Ideal R)
    {c d : ℕ} (hc : 0 < c) (hd : 0 < d)
    (hIJ : I ^ c ≤ J) (hJI : J ^ d ≤ I)
    (M : Type*) [AddCommGroup M] [Module R M] :
    IsAdicComplete I M ↔ IsAdicComplete J M := by
  constructor
  · intro h
    have := Stacks.AdicCompletionComparison.haus_imp I J hJI M h.toIsHausdorff
    have := Stacks.AdicCompletionComparison.prec_imp I J hc hd hIJ hJI M h.toIsPrecomplete
    exact ⟨⟩
  · intro h
    have := Stacks.AdicCompletionComparison.haus_imp J I hIJ M h.toIsHausdorff
    have := Stacks.AdicCompletionComparison.prec_imp J I hd hc hJI hIJ M h.toIsPrecomplete
    exact ⟨⟩

/-!
## Adic completeness of a quotient of an adically complete module

Let `R` be a commutative ring, `I ⊆ R` an ideal, `M` an `I`-adically complete
`R`-module and `K ⊆ M` a submodule. The two conditions

1. `K = ⋂ₙ (K + IⁿM)`, and
2. `M ⧸ K` is `I`-adically complete

are equivalent.

### Notation

The submodule `IⁿM ⊆ M`, the image of `Iⁿ ⊗[R] M → M`, is written `I ^ n • ⊤`, and the
sum `K + IⁿM` is the join `K ⊔ (I ^ n • ⊤)`. Since every `K + IⁿM` contains `K`, the
inclusion `K ⊆ ⋂ₙ (K + IⁿM)` is automatic; condition (1) asserts it is an equality.

Recall that `IsAdicComplete I M` is the conjunction of

* `IsHausdorff I M`: `x ≡ 0 [SMOD IⁿM]` for all `n` implies `x = 0`, equivalently
  `⋂ₙ IⁿM = 0`; and
* `IsPrecomplete I M`: every Cauchy sequence `(fₙ)` — one with `f m ≡ f n [SMOD IᵐM]`
  whenever `m ≤ n` — has a limit `L`, i.e. `f n ≡ L [SMOD IⁿM]` for all `n`.

Together they say that the canonical map `M → M^ = limₙ M/IⁿM` is an isomorphism.
-/

@[expose] public section

/-- For an $I$-adically complete module $M$ and a submodule $K$, the equality
$K = \bigcap_n (K + I^n M)$ holds if and only if the quotient $M/K$ is
$I$-adically complete. -/
@[stacks 031A]
theorem main_theorem_031a {R : Type*} [CommRing R] (I : Ideal R) (M : Type*)
    [AddCommGroup M] [Module R M] [IsAdicComplete I M] (K : Submodule R M) :
    (K = ⨅ n : ℕ, (K ⊔ (I ^ n • ⊤ : Submodule R M))) ↔ IsAdicComplete I (M ⧸ K) := by
  have hmap : ∀ n : ℕ, Submodule.map K.mkQ (I ^ n • ⊤ : Submodule R M)
      = (I ^ n • ⊤ : Submodule R (M ⧸ K)) := fun n => by
    rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ]
  have bridge : ∀ (n : ℕ) (m : M),
      (K.mkQ m ≡ 0 [SMOD (I ^ n • ⊤ : Submodule R (M ⧸ K))]) ↔ m ∈ K ⊔ (I ^ n • ⊤ : Submodule R
          M) := by
    intro n m
    rw [SModEq.zero]
    rw [← hmap, ← Submodule.mem_comap, Submodule.comap_map_eq, Submodule.ker_mkQ, sup_comm]
  have hprec : IsPrecomplete I (M ⧸ K) := by
    constructor
    intro f hf
    have hstep : ∀ n : ℕ, ∃ a : M, a ∈ (I ^ n • ⊤ : Submodule R M) ∧ K.mkQ a = f n - f (n+1) := by
      intro n
      have hsm : f n ≡ f (n+1) [SMOD (I ^ n • ⊤ : Submodule R (M ⧸ K))] := hf (Nat.le_succ n)
      have hmem : f n - f (n+1) ∈ (I ^ n • ⊤ : Submodule R (M ⧸ K)) := SModEq.sub_mem.mp hsm
      rw [← hmap, Submodule.mem_map] at hmem
      obtain ⟨a, ha, hae⟩ := hmem
      exact ⟨a, ha, hae⟩
    choose a ha hae using hstep
    obtain ⟨g0, hg0⟩ := K.mkQ_surjective (f 0)
    set g : ℕ → M := fun n => g0 - (Finset.range n).sum a with hg
    have hpi : ∀ n, K.mkQ (g n) = f n := by
      intro n
      simp only [hg, map_sub, map_sum, hae]
      rw [Finset.sum_range_sub' f n, hg0]
      abel
    have hcauchy : ∀ {p q : ℕ}, p ≤ q → g p ≡ g q [SMOD (I ^ p • ⊤ : Submodule R M)] := by
      intro p q hpq
      rw [SModEq.sub_mem]
      have : g p - g q = ∑ k ∈ Finset.Ico p q, a k := by
        simp only [hg]
        rw [Finset.sum_Ico_eq_sub a hpq]
        abel
      rw [this]
      exact Submodule.sum_mem _ fun k hk =>
        Submodule.pow_smul_top_le I M (Finset.mem_Ico.mp hk).1 (ha k)
    obtain ⟨L, hL⟩ := IsPrecomplete.prec (IsAdicComplete.toIsPrecomplete) hcauchy
    refine ⟨K.mkQ L, fun n => ?_⟩
    rw [← hpi n]
    have := (hL n).map K.mkQ
    rwa [hmap] at this
  constructor
  · intro h1
    have hhaus : IsHausdorff I (M ⧸ K) := by
      constructor
      intro x hx
      obtain ⟨m, rfl⟩ := K.mkQ_surjective x
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      have : m ∈ ⨅ n : ℕ, (K ⊔ (I ^ n • ⊤ : Submodule R M)) := by
        rw [Submodule.mem_iInf]
        intro n
        exact (bridge n m).mp (hx n)
      rw [← h1] at this
      exact this
    have := hprec
    exact IsAdicComplete.mk
  · intro h2
    have hhaus : IsHausdorff I (M ⧸ K) := h2.toIsHausdorff
    apply le_antisymm
    · rw [le_iInf_iff]; intro n; exact le_sup_left
    · intro m hm
      rw [Submodule.mem_iInf] at hm
      have hx : ∀ n, K.mkQ m ≡ 0 [SMOD (I ^ n • ⊤ : Submodule R (M ⧸ K))] := by
        intro n
        exact (bridge n m).mpr (hm n)
      have : K.mkQ m = 0 := hhaus.haus _ hx
      rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this

/-!
## Adic completeness of a finite module over a complete ring

Let `R` be a commutative ring, `I ⊆ R` an ideal and `M` an `R`-module. The `I`-adic
completeness conditions are taken with respect to the descending filtration `IⁿM`,
where `IⁿM` is the submodule `I ^ n • ⊤` of `M`, and the congruence `x ≡ y [SMOD IⁿM]`
means `x - y ∈ IⁿM`. Recall the three notions, all of which Mathlib already provides:

* `IsHausdorff I M`: `M` is `I`-adically separated, i.e. `x ≡ 0 [SMOD IⁿM]` for every
  `n` forces `x = 0`; equivalently `⋂ₙ IⁿM = 0`.
* `IsPrecomplete I M`: every Cauchy sequence converges — for `f : ℕ → M` with
  `f m ≡ f n [SMOD IᵐM]` whenever `m ≤ n`, there is an `L` with `f n ≡ L [SMOD IⁿM]`
  for all `n`.
* `IsAdicComplete I M`: both of the above; equivalently the canonical map
  `M → M^ = limₙ M/IⁿM` is an isomorphism.

If `R` is `I`-adically complete, `M` is a finite `R`-module, and `⋂ₙ IⁿM = 0`, then `M`
is `I`-adically complete.
-/

@[expose] public section

/-- A finite module `M` over an `I`-adically complete ring `R` is itself `I`-adically
complete as soon as `⋂ₙ IⁿM = 0`. -/
@[stacks 031B]
theorem isAdicComplete_of_iInf_smul_eq_bot
    {R : Type*} [CommRing R] (I : Ideal R)
    {M : Type*} [AddCommGroup M] [Module R M]
    [IsAdicComplete I R] [Module.Finite R M]
    (h : ⨅ n : ℕ, (I ^ n • (⊤ : Submodule R M)) = ⊥) :
    IsAdicComplete I M := by
  have hHaus : IsHausdorff I M := by
    constructor
    intro x hx
    have hmem : x ∈ ⨅ n : ℕ, (I ^ n • (⊤ : Submodule R M)) := by
      rw [Submodule.mem_iInf]
      intro n
      have := hx n
      rw [SModEq.sub_mem] at this
      simpa using this
    rw [h] at hmem
    simpa using hmem
  have hsurj : Function.Surjective (AdicCompletion.of I M) := by
    have hR : Function.Surjective (AdicCompletion.of I R) :=
      (AdicCompletion.of_bijective I R).surjective
    have hT := AdicCompletion.ofTensorProduct_surjective_of_finite I M
    intro y
    obtain ⟨t, rfl⟩ := hT y
    induction t using TensorProduct.inductionOn with
    | tmul r m =>
        obtain ⟨s, rfl⟩ := hR r
        refine ⟨s • m, ?_⟩
        rw [AdicCompletion.ofTensorProduct_tmul]
        exact (AdicCompletion.ext_iff.mpr (congrFun rfl))
    | add x z hx hz =>
        obtain ⟨a, ha⟩ := hx
        obtain ⟨b, hb⟩ := hz
        refine ⟨a + b, ?_⟩
        rw [map_add, map_add, ha, hb]
  have hPre : IsPrecomplete I M := AdicCompletion.of_surjective_iff.mp hsurj
  exact @IsAdicComplete.mk _ _ _ _ _ _ hHaus hPre

end
end
end
end
end

-- Adic completeness (Tag 0317) is Mathlib's `IsAdicComplete`; that `M → M^ = limₙ M/IⁿM` is
-- an isomorphism is `AdicCompletion.of_bijective_iff`, and `⋂ IⁿM = 0` is `IsHausdorff`.
add_to_stacks 0317 "`M → M^` is an isomorphism" AdicCompletion.of_bijective_iff
