module

public import StacksFrontier.RingTheory.AdicCompletion.NoetherianRing.GradedNoetherian
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Completion for Noetherian rings

From the Noetherianity of the associated-graded module, every ideal `K` of a ring `S` with `J`
finitely generated and `S ⧸ J` Noetherian admits a finite family with the single-step
approximation property (`exists_approx_generators`); completeness turns that family into a
generating set (`fg_of_approx_generators`). Hence a ring complete with respect to a finitely
generated ideal `J` with `S ⧸ J` Noetherian is Noetherian (`noetherian_of_isAdicComplete_fg`),
and the `I`-adic completion of `R` with `R ⧸ I` Noetherian and `I` finitely generated is
Noetherian and `I R^∧`-adically complete (`completion_noetherian`, Stacks 05GH).
-/

@[expose] public section


open AdicCompletion

/-- **Leading-form finiteness: the Noetherian core of Stacks 05GH.**

Given generators `a : Fin t → S` of `J` and `S ⧸ J` Noetherian, every ideal `K ⊆ S` admits a
finite family `f : Fin r → S` of elements of `K` with orders `d` (`f k ∈ J^(d k)`) having the
single-step approximation property: for every `N` and every `x ∈ K ∩ J^N` there are
coefficients `s k ∈ J^(N - d k)` with `x - ∑ k, s k * f k ∈ J^(N+1)`.

The leading forms of `K` span a `P`-submodule `L` of the Noetherian `P`-module
`grModule S J` (`P = MvPolynomial (Fin t) (S ⧸ J)`), so `L` is finitely generated; a finite
set of homogeneous leading forms of `K` therefore spans it, and lifting these gives the
family `f` with orders `d`.  Projecting the resulting `P`-linear relation to degree `N` and
reading off `S`-coefficients (`component_smul_lof`) produces the witnesses `s`. -/
lemma leadingForm_core
    (S : Type*) [CommRing S] (J : Ideal S) (t : ℕ) (a : Fin t → S)
    (ha : J = Ideal.span (Set.range a)) (hquot : IsNoetherianRing (S ⧸ J))
    (K : Ideal S) :
    ∃ (r : ℕ) (f : Fin r → S) (d : Fin r → ℕ),
      (∀ k, f k ∈ K) ∧ (∀ k, f k ∈ J ^ (d k)) ∧
      (∀ (N : ℕ) (x : S), x ∈ K → x ∈ J ^ N →
        ∃ s : Fin r → S, (∀ k, s k ∈ J ^ (N - d k)) ∧ x - ∑ k, s k * f k ∈ J ^ (N + 1)) := by
  classical
  let := grModulePModule S J t a ha
  set P := MvPolynomial (Fin t) (S ⧸ J) with hP
  have : IsNoetherianRing P := MvPolynomial.isNoetherianRing
  have hNoeth : IsNoetherian P (grModule S J) := grModule_noetherian S J t a ha hquot
  -- homogeneous injection (S-linear)
  set lf : ∀ (n : ℕ), grPiece S J n → grModule S J :=
    fun n x => (DirectSum.lof S ℕ (fun n => grPiece S J n) n x : grModule S J) with hlf
  -- the set of all homogeneous leading forms of K
  set Lset : Set (grModule S J) :=
    {y | ∃ (n : ℕ) (w : (J ^ n : Ideal S)), (w : S) ∈ K ∧ y = lf n (grMk S J n w)} with hLset
  -- the P-submodule generated by the homogeneous leading forms
  set L : Submodule P (grModule S J) := Submodule.span P Lset with hLdef
  -- L is finitely generated (Noetherian module)
  have hLfg : L.FG := IsNoetherian.noetherian L
  -- a finite subset of the homogeneous leading forms already spans L
  obtain ⟨T, hTsub, hTspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset Lset).mp hLfg
  -- index T by Fin r
  set r := T.card with hr
  set e : Fin r ≃ {x // x ∈ T} := (T.equivFin).symm with he
  set g : Fin r → grModule S J := fun k => (e k : grModule S J) with hg
  -- each generator is a homogeneous leading form of K
  have hgLset : ∀ k, g k ∈ Lset := fun k => hTsub (e k).property
  -- choose the degree and lifted witness for each generator
  have hchoose : ∀ k, ∃ (n : ℕ) (w : (J ^ n : Ideal S)),
      (w : S) ∈ K ∧ g k = lf n (grMk S J n w) := hgLset
  choose nn ww hwwK hwwval using hchoose
  -- the family `f`, orders `d`
  refine ⟨r, fun k => (ww k : S), nn, hwwK, fun k => (ww k).property, ?_⟩
  -- span over Fin r equals L
  have hgspan : Submodule.span P (Set.range g) = L := by
    rw [hLdef, hTspan]
    congr 1
    rw [hg]
    ext y
    constructor
    · rintro ⟨k, rfl⟩; exact (e k).property
    · intro hy; exact ⟨e.symm ⟨y, hy⟩, by simp⟩
  intro N x hxK hxJ
  -- the leading form of x is in Lset hence in L = span P (range g)
  have hxLset : lf N (grMk S J N ⟨x, hxJ⟩) ∈ Lset := ⟨N, ⟨x, hxJ⟩, hxK, rfl⟩
  have hxL : lf N (grMk S J N ⟨x, hxJ⟩) ∈ Submodule.span P (Set.range g) := by
    rw [hgspan, hLdef]; exact Submodule.subset_span hxLset
  rw [Submodule.mem_span_range_iff_exists_fun P] at hxL
  obtain ⟨pp, hpp⟩ := hxL
  -- for each generator, read off the degree-N coefficient `s k`
  have hcoef : ∀ k, ∃ (s : S) (hs : s ∈ (J ^ (N - nn k) : Ideal S)),
      DirectSum.component S ℕ (fun n => grPiece S J n) N
          (grModuleRingHom S J t a ha (pp k)
            (DirectSum.lof S ℕ (fun n => grPiece S J n) (nn k) (grMk S J (nn k) (ww k))))
        = grMk S J N ⟨s * (ww k), mul_pow_sub_mem S J N (nn k) s (ww k) hs (ww k).property⟩ :=
    fun k => component_smul_lof S J t a ha N (nn k) (ww k) (pp k)
  choose ss hss hsval using hcoef
  refine ⟨ss, hss, ?_⟩
  -- project the span relation to degree N
  have hproj : grMk S J N ⟨x, hxJ⟩
      = ∑ k, grMk S J N
          ⟨ss k * (ww k), mul_pow_sub_mem S J N (nn k) (ss k) (ww k) (hss k) (ww k).property⟩ := by
    have hcompx : DirectSum.component S ℕ (fun n => grPiece S J n) N
        (lf N (grMk S J N ⟨x, hxJ⟩)) = grMk S J N ⟨x, hxJ⟩ := by
      rw [hlf]; exact DirectSum.component.lof_self S N _
    rw [← hcompx, ← hpp, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    -- p k • g k = grModuleRingHom (p k) (lof (nn k) (grMk (ww k)))
    have hsmul : pp k • g k
        = grModuleRingHom S J t a ha (pp k)
            (DirectSum.lof S ℕ (fun n => grPiece S J n) (nn k) (grMk S J (nn k) (ww k))) := by
      rw [hwwval k, hlf]
      rfl
    rw [hsmul, hsval k]
  exact sub_sum_mem_of_grMk_eq_sum S J N Finset.univ ⟨x, hxJ⟩ _ hproj

/-- **Leading-form finiteness, in `⨆`/`⊔` form.**  Given generators `a : Fin t → S` of `J`
and `S ⧸ J` Noetherian, every ideal `K` admits a finite family `f : Fin r → S` of elements of
`K` with orders `d` (`f k ∈ J^(d k)`) such that every `x ∈ K ∩ J^N` lies in
`(⨆ k, J^(N - d k) • span {f k}) ⊔ J^(N+1)`.

This is the `⨆`/`⊔` repackaging of `leadingForm_core`: for `x ∈ K ∩ J^N`, write
`x = (∑ s_k f_k) + z` with `s_k ∈ J^(N - d_k)` and `z ∈ J^(N+1)`; each
`s_k f_k ∈ J^(N-d_k) • span {f_k}`, so the sum lies in the `⨆`. -/
lemma leadingForm_fg
    (S : Type*) [CommRing S] (J : Ideal S) (t : ℕ) (a : Fin t → S)
    (ha : J = Ideal.span (Set.range a)) (hquot : IsNoetherianRing (S ⧸ J))
    (K : Ideal S) :
    ∃ (r : ℕ) (f : Fin r → S) (d : Fin r → ℕ),
      (∀ k, f k ∈ K) ∧ (∀ k, f k ∈ J ^ (d k)) ∧
      (∀ (N : ℕ) (x : S), x ∈ K → x ∈ J ^ N →
        x ∈ (⨆ k : Fin r, (J ^ (N - d k)) • Ideal.span {f k}) ⊔ J ^ (N + 1)) := by
  classical
  -- Elementary assembly from the explicit `∃ s` combination of `leadingForm_core`.
  obtain ⟨r, f, d, hfK, hfJ, happrox⟩ := leadingForm_core S J t a ha hquot K
  refine ⟨r, f, d, hfK, hfJ, ?_⟩
  intro N x hxK hxJ
  obtain ⟨s, hsJ, hz⟩ := happrox N x hxK hxJ
  -- `x = (∑ k, s k * f k) + (x - ∑ k, s k * f k)`, the first summand in the `⨆`,
  -- the second in `J^(N+1)`.
  rw [Submodule.mem_sup]
  refine ⟨∑ k, s k * f k, ?_, x - ∑ k, s k * f k, hz, by ring⟩
  -- each `s k * f k ∈ J^(N - d k) • span {f k} ≤ ⨆ …`
  exact Submodule.sum_mem _ fun k _ => Submodule.mem_iSup_of_mem k
    (Submodule.mem_smul_span_singleton.2 ⟨s k, hsJ k, rfl⟩)

/-- The single-step approximation property for an ideal `K`, stated with explicit witnesses:
given generators `a : Fin t → S` of `J` and `S ⧸ J` Noetherian, there is a finite family
`f : Fin r → S` of elements of `K` with orders `d` (`f k ∈ J^(d k)`) such that every
`x ∈ K ∩ J^N` satisfies `x - ∑ k, s k * f k ∈ J^(N+1)` for some `s k ∈ J^(N - d k)`.

This unpacks the `⨆`/`⊔` membership of `leadingForm_fg` into the explicit coefficients. -/
alias gradedLeading_fg := leadingForm_core

/-- **Leading-form generators (the Noetherian / Hilbert-basis content).**
If `J` is finitely generated and `S ⧸ J` is Noetherian, then for every ideal `K`
there is a finite family `f : Fin r → S` of elements of `K` with orders `d`
(`f k ∈ J^(d k)`) satisfying the single-step approximation property.

Reduction: extract a finite generating family `a : Fin t → S` of `J` from `hJ`
(`Submodule.fg_iff_exists_fin_generating_family` / `Ideal.FG`), then apply
`gradedLeading_fg`. -/
lemma exists_leading_generators
    (S : Type*) [CommRing S] (J : Ideal S) (hJ : J.FG) (hquot : IsNoetherianRing (S ⧸ J))
    (K : Ideal S) :
    ∃ (r : ℕ) (f : Fin r → S) (d : Fin r → ℕ),
      (∀ k, f k ∈ K) ∧ (∀ k, f k ∈ J ^ (d k)) ∧
      (∀ (N : ℕ) (x : S), x ∈ K → x ∈ J ^ N →
        ∃ s : Fin r → S, (∀ k, s k ∈ J ^ (N - d k)) ∧ x - ∑ k, s k * f k ∈ J ^ (N + 1)) := by
  -- Stacks 05GH / Hilbert basis on gr_J(S).  The degenerate cases r = 0, N < d_k (where
  -- J^0 = ⊤), K = ⊥/⊤ and J = ⊥/⊤ are all covered by the statement as written.
  -- Extract a finite generating family of J from hJ, then apply gradedLeading_fg.
  obtain ⟨t, a, ha⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hJ
  exact gradedLeading_fg S J t a ha.symm hquot K

/-- The algebraic half of Stacks 05GH: if `J` is finitely generated and `S ⧸ J` is
Noetherian, then every ideal `K ⊆ S` admits a finite family `f : Fin r → S` of elements of
`K` with orders `d` (`f k ∈ J^(d k)`) satisfying the single-step approximation property.
No completeness hypothesis is needed. -/
alias exists_approx_generators := exists_leading_generators

/-- Congruence modulo `J ^ n • ⊤` in the ring `S` is membership of the difference in `J ^ n`. -/
private lemma smodEq_pow_smul_top_iff {S : Type*} [CommRing S] (J : Ideal S) (n : ℕ) {x y : S} :
    x ≡ y [SMOD J ^ n • (⊤ : Submodule S S)] ↔ x - y ∈ J ^ n := by
  rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]

/-- Analytic heart (Cauchy convergence via completeness): if a finite family
`f : Fin r → S` of elements of `K` with orders `d` has the approximation
property, then `K` is finitely generated (in fact generated by the `f k`). -/
lemma fg_of_approx_generators
    (S : Type*) [CommRing S] (J : Ideal S) (hcomp : IsAdicComplete J S)
    (K : Ideal S) (r : ℕ) (f : Fin r → S) (d : Fin r → ℕ)
    (hfK : ∀ k, f k ∈ K) (hfJ : ∀ k, f k ∈ J ^ (d k))
    (happrox : ∀ (N : ℕ) (x : S), x ∈ K → x ∈ J ^ N →
        ∃ s : Fin r → S, (∀ k, s k ∈ J ^ (N - d k)) ∧ x - ∑ k, s k * f k ∈ J ^ (N + 1)) :
    K.FG := by
  -- The conclusion is K = span (range f).
  -- Iterate `happrox` (telescoping) to build J-Cauchy partial sums for each k;
  -- IsPrecomplete (hcomp.toIsPrecomplete) gives limits c k with
  -- x - ∑ k, c k * f k ∈ J^(M+1) for all M; IsHausdorff (hcomp.toIsHausdorff)
  -- forces it to 0, so K = span (range f).
  classical
  have hKeq : K = Ideal.span (Set.range f) := by
    apply le_antisymm
    swap
    · rw [Ideal.span_le]; rintro x ⟨k, rfl⟩; exact hfK k
    intro x hxK
    -- Build remainder sequence with proofs.
    let F : (N : ℕ) → { y : S // y ∈ K ∧ y ∈ J ^ N } :=
      fun N => Nat.rec (⟨x, hxK, by simp⟩ : { y : S // y ∈ K ∧ y ∈ J ^ 0 })
        (fun N ih =>
          let h := happrox N ih.val ih.property.left ih.property.right
          ⟨ih.val - ∑ k, h.choose k * f k,
            Ideal.sub_mem _ ih.property.left
              (Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (hfK k)),
            h.choose_spec.right⟩) N
    let rem : ℕ → S := fun N => (F N).val
    let scoef : ℕ → Fin r → S :=
      fun N => (happrox N (F N).val (F N).property.left (F N).property.right).choose
    have hrem0 : rem 0 = x := rfl
    have hremJ : ∀ N, rem N ∈ J ^ N := fun N => (F N).property.right
    have hrec : ∀ N, rem (N+1) = rem N - ∑ k, scoef N k * f k := fun N => rfl
    have hscoefJ : ∀ N k, scoef N k ∈ J ^ (N - d k) := fun N k =>
      (happrox N (F N).val (F N).property.left (F N).property.right).choose_spec.left k
    -- partial sums
    let σ : Fin r → ℕ → S := fun k M => ∑ N ∈ Finset.range M, scoef N k
    -- telescoping
    have htel : ∀ M, x - ∑ k, σ k M * f k = rem M := by
      have key : ∀ M, ∑ k, σ k M * f k = x - rem M := by
        intro M
        induction M with
        | zero => simp [hrem0, σ]
        | succ M ih =>
          have hstep : ∀ k, σ k (M+1) * f k = σ k M * f k + scoef M k * f k := by
            intro k; simp only [σ]; rw [Finset.sum_range_succ, add_mul]
          rw [Finset.sum_congr rfl (fun k _ => hstep k), Finset.sum_add_distrib, ih, hrec M]
          ring
      intro M; rw [key M]; ring
    -- per-k limits via precompleteness
    have := hcomp.toIsPrecomplete
    have hlimk : ∀ k, ∃ c : S, ∀ M, σ k (M + d k) - c ∈ J^M := by
      intro k
      have hcompat : ∀ {m n : ℕ}, m ≤ n →
          (fun M => σ k (M + d k)) m ≡
            (fun M => σ k (M + d k)) n [SMOD J^m • (⊤:Submodule S S)] := by
        intro m n hmn
        rw [smodEq_pow_smul_top_iff, ← neg_sub, neg_mem_iff]
        simp only [σ]
        rw [← Finset.sum_Ico_eq_sub _ (Nat.add_le_add_right hmn _)]
        refine Ideal.sum_mem _ fun N hN => ?_
        have hNge : m + d k ≤ N := (Finset.mem_Ico.mp hN).left
        exact Ideal.pow_le_pow_right (by omega : m ≤ N - d k) (hscoefJ N k)
      obtain ⟨L, hL⟩ := IsPrecomplete.prec' (fun M => σ k (M + d k)) (fun {m n} h => hcompat h)
      refine ⟨L, fun M => ?_⟩
      exact (smodEq_pow_smul_top_iff J M).1 (hL M)
    choose c hc using hlimk
    -- per-k term bound
    have hterm : ∀ P k, (σ k P - c k) * f k ∈ J^P := by
      intro P k
      rcases Nat.lt_or_ge P (d k) with h | h
      · have hfk : f k ∈ J^P := Ideal.pow_le_pow_right (le_of_lt h) (hfJ k)
        exact Ideal.mul_mem_left _ _ hfk
      · have hlim : σ k P - c k ∈ J^(P - d k) := by
          have := hc k (P - d k); rwa [Nat.sub_add_cancel h] at this
        have h2 : (σ k P - c k) * f k ∈ J^(P - d k) * J^(d k) := Ideal.mul_mem_mul hlim (hfJ k)
        rw [← pow_add, Nat.sub_add_cancel h] at h2
        exact h2
    -- Hausdorff: x - ∑ c k f k = 0
    have := hcomp.toIsHausdorff
    have hfinal : x - ∑ k, c k * f k = 0 := by
      apply IsHausdorff.haus' (I := J)
      intro P
      rw [smodEq_pow_smul_top_iff, sub_zero]
      have hsplit : x - ∑ k, c k * f k
          = (x - ∑ k, σ k P * f k) + ∑ k, (σ k P - c k) * f k := by
        have hh : ∀ k, (σ k P - c k) * f k = σ k P * f k - c k * f k := fun k => by ring
        rw [Finset.sum_congr rfl (fun k _ => hh k), Finset.sum_sub_distrib]
        ring
      rw [hsplit, htel P]
      exact add_mem (hremJ P) (Ideal.sum_mem _ fun k _ => hterm P k)
    rw [sub_eq_zero.mp hfinal]
    exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
  rw [hKeq]
  exact Submodule.fg_span (Set.finite_range f)

/-- A commutative ring `S` that is complete with respect to a finitely generated ideal `J`
and whose quotient `S / J` is Noetherian is itself Noetherian.

This is the abstract kernel of Stacks 05GH.  Every ideal `K ⊆ S` is finitely generated: the
algebraic half (`exists_approx_generators`, via the Hilbert basis theorem on the associated
graded module) produces a finite family in `K` with the single-step approximation property,
and the analytic half (`fg_of_approx_generators`, via completeness) shows that family
generates `K`. -/
@[ega "0 7.2.6" "special case", ega "0 7.2.8" "sufficiency", ega "I 10.6.4" "special case"]
lemma noetherian_of_isAdicComplete_fg
    (S : Type*) [CommRing S] (J : Ideal S)
    (hJ : J.FG) (hcomp : IsAdicComplete J S) (hquot : IsNoetherianRing (S ⧸ J)) :
    IsNoetherianRing S := by
  -- All three hypotheses are used; the degenerate cases J = ⊤, ⊥ are handled by the
  -- Hausdorff condition bundled into `IsAdicComplete`.
  rw [isNoetherianRing_iff_ideal_fg]
  intro K
  obtain ⟨r, f, d, hfK, hfJ, happrox⟩ := exists_approx_generators S J hJ hquot K
  exact fg_of_approx_generators S J hcomp K r f d hfK hfJ happrox

-- needed: without it `ker_evalOneₐ_eq_map` fails: Tactic `rewrite` failed: Did not find an
-- occurrence of the pat…

/-- `R^∧ / (I R^∧) ≅ R / I`, which is Noetherian by hypothesis `h1`.

Proof outline: `evalOneₐ I : R^∧ →ₐ[R] R / I` is surjective (`AdicCompletion.evalOneₐ_surjective`),
so `RingHom.quotientKerEquivOfSurjective` gives a ring isomorphism
`R^∧ / ker (evalOneₐ I) ≃+* R / I`.  Rewrite the kernel using
`ker_evalOneₐ_eq_map` to identify it with `J = I.map ι`, obtaining
`R^∧ / J ≃+* R / I`.  Conclude with `isNoetherianRing_of_ringEquiv` applied to
the inverse equivalence together with `h1 : IsNoetherianRing (R / I)`. -/
lemma completion_quot_noetherian
    (R : Type*) [CommRing R] (I : Ideal R)
    (h1 : IsNoetherianRing (R ⧸ I)) (h2 : I.FG) :
    IsNoetherianRing ((AdicCompletion I R) ⧸ (I.map (algebraMap R (AdicCompletion I R)))) := by
  rw [← AdicCompletion.ker_evalOneₐ_eq_map I h2]
  exact isNoetherianRing_of_ringEquiv (R ⧸ I)
    (RingHom.quotientKerEquivOfSurjective
      (f := (evalOneₐ I).toRingHom) (evalOneₐ_surjective I)).symm

/-- Let `I` be an ideal of a commutative ring `R` with `R / I` Noetherian and `I` finitely
generated.  Then the `I`-adic completion `R^∧ = AdicCompletion I R` is a Noetherian ring, and
it is complete with respect to `I R^∧ = I.map (algebraMap R (AdicCompletion I R))`. -/
@[stacks 05GH,
  ega "0 7.3.1" "more general",
  ega "0 7.6.11" "more general",
  ega "0 7.6.18" "partial",
  ega "I 10.6.4" "special case",
  ega "I 10.8.6" "special case",
  ega "IV 8.11.4" "partial", sga "3 VIIB 5.5.2" "Noetherianity of Â", sga "3 X 4.0" "partial"]
theorem completion_noetherian
    (R : Type*) [CommRing R] (I : Ideal R)
    (h1 : IsNoetherianRing (R ⧸ I)) (h2 : I.FG) :
    IsNoetherianRing (AdicCompletion I R) ∧
    IsAdicComplete (I.map (algebraMap R (AdicCompletion I R))) (AdicCompletion I R) := by
  set S := AdicCompletion I R
  set J := I.map (algebraMap R (AdicCompletion I R)) with hJdef
  -- Conjunct (2): `IsAdicComplete J S` is Stacks 05GG (available in Mathlib).
  have hcomp : IsAdicComplete J (AdicCompletion I R) := by
    rw [hJdef, IsAdicComplete.map_algebraMap_iff]
    exact AdicCompletion.isAdicComplete h2
  refine ⟨?_, hcomp⟩
  -- Conjunct (1): Noetherianness via the abstract kernel lemma.
  refine noetherian_of_isAdicComplete_fg S J ?_ hcomp ?_
  · -- `J = I.map ι` is finitely generated because `I` is.
    exact Ideal.FG.map h2 _
  · -- `S / J ≅ R / I` is Noetherian.
    exact completion_quot_noetherian R I h1 h2

end
