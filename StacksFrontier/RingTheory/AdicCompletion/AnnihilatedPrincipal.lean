module

public import StacksFrontier.RingTheory.AdicCompletion.NoetherianRing
public import StacksFrontier.RingTheory.AdicCompletion.QuotientDimensionSplit
public import StacksFrontier.RingTheory.CohenMacaulay.Dimension
public import StacksFrontier.RingTheory.CohenMacaulay.FlatLocalHom
public import StacksFrontier.RingTheory.CohenMacaulay.Localization
public import StacksFrontier.RingTheory.Depth.Dimension
public import StacksFrontier.RingTheory.Depth.RingEquiv
public import StacksFrontier.RingTheory.RegularLocalRing.Basic

/-!
# Depth in the completion of a local ring along an element annihilating an ideal

Let `C` be a Noetherian local ring, let `f ∈ 𝔪_C` and let `Ĉ` be the `f`-adic completion of `C`,
with `f̂` the image of `f`. Let `𝔨 ⊆ C` be an ideal killed by `f`, and let `M` be a `Ĉ`-module
isomorphic to `Ĉ`. At a prime `𝔭` of `Ĉ` not containing `f̂` the element `f̂` becomes a unit, so
`𝔨 Ĉ_𝔭 = 0` and `Ĉ_𝔭` is a local ring of `Ĉ ⧸ 𝔨 Ĉ`. This file reads off the depth of `M_𝔭` in two
situations.

## Main results

* `Stacks.AdicCompletionAnnihilated.exists_prime_depth_localizedModule_eq_zero`: if `𝔨` is a
  prime not containing `f` and `𝔪_C` is contained in the radical of `𝔨 + (f)`, there is a prime
  `𝔭` of `Ĉ` not containing `f Ĉ`, such that the set of primes containing `𝔭 + f Ĉ` is exactly
  `{𝔪_C Ĉ}`, and at which `M_𝔭` has depth zero.
* `Stacks.AdicCompletionAnnihilated.exists_ringKrullDim_quotient_eq_and_le_depth_add`: if
  `C ⧸ 𝔨` is a regular local ring of dimension at least `d`, then at every prime `𝔭` of `Ĉ` not
  containing `f Ĉ` the ring `Ĉ ⧸ 𝔭` has finite dimension `e` and `d ≤ depth(M_𝔭) + e`.

## References

* [Stacks Project, Tag 00NA](https://stacks.math.columbia.edu/tag/00NA)
* [Stacks Project, Tag 00NB](https://stacks.math.columbia.edu/tag/00NB)
* [Stacks Project, Tag 00R5](https://stacks.math.columbia.edu/tag/00R5)
-/

universe u

@[expose] public section

open IsLocalRing

namespace Stacks.AdicCompletionAnnihilated

/-- If `f` kills `𝔨` and the image of `f` in a `C`-algebra `S` lies outside a prime `q`, then
`q` contains `𝔨 S`. -/
private theorem map_le_of_mul_eq_zero {C S : Type*} [CommRing C] [CommRing S] [Algebra C S]
    {f : C} {𝔨 : Ideal C} (h𝔨 : ∀ k ∈ 𝔨, f * k = 0) {q : Ideal S} [q.IsPrime]
    (hf : algebraMap C S f ∉ q) : 𝔨.map (algebraMap C S) ≤ q := by
  rw [Ideal.map_le_iff_le_comap]
  intro k hk
  refine (‹q.IsPrime›.mem_or_mem ?_).resolve_left hf
  rw [← map_mul, h𝔨 k hk, map_zero]
  exact q.zero_mem

/-- If `f` kills `𝔨` and the image of `f` in a `C`-algebra `S` lies outside a prime `q`, then
`𝔨 S` becomes zero in `S_q`. -/
private theorem map_map_localization_eq_bot {C S : Type*} [CommRing C] [CommRing S] [Algebra C S]
    {f : C} {𝔨 : Ideal C} (h𝔨 : ∀ k ∈ 𝔨, f * k = 0) (q : Ideal S) [q.IsPrime]
    (hf : algebraMap C S f ∉ q) :
    (𝔨.map (algebraMap C S)).map (algebraMap S (Localization.AtPrime q)) = ⊥ := by
  rw [Ideal.map_map, Ideal.map_eq_bot_iff_le_ker]
  intro k hk
  rw [RingHom.mem_ker, RingHom.comp_apply, IsLocalization.map_eq_zero_iff q.primeCompl]
  exact ⟨⟨algebraMap C S f, hf⟩, by rw [← map_mul, h𝔨 k hk, map_zero]⟩

/-- The depth of `M_q` for a module `M` isomorphic to `S` is the depth of the local ring `S_q`. -/
private theorem depth_localizedModule_eq {S : Type*} [CommRing S] (q : Ideal S) [q.IsPrime]
    {M : Type*} [AddCommGroup M] [Module S M] (e : M ≃ₗ[S] S) :
    Module.depth (Localization.AtPrime q) (maximalIdeal (Localization.AtPrime q))
        (LocalizedModule q.primeCompl M) =
      Module.depth (Localization.AtPrime q) (maximalIdeal (Localization.AtPrime q))
        (Localization.AtPrime q) :=
  Module.depth_eq_depth_of_linearEquiv _
    (IsLocalizedModule.mapEquiv q.primeCompl (LocalizedModule.mkLinearMap q.primeCompl M)
      (Algebra.linearMap S (Localization.AtPrime q)) (Localization.AtPrime q) e)

/-- The ideal generated by the maximal ideal of `C` is the maximal ideal of the `J`-adic
completion, for `J ≤ 𝔪_C`. -/
private theorem isMaximal_map_maximalIdeal {C : Type u} [CommRing C] [IsNoetherianRing C]
    [IsLocalRing C] {J : Ideal C} (hJ : J ≤ maximalIdeal C) :
    ((maximalIdeal C).map (algebraMap C (AdicCompletion J C))).IsMaximal :=
  AdicCompletion.isMaximal_map_of_le J (maximalIdeal C) hJ (Ideal.fg_of_isNoetherianRing J)

/-- **A prime of the completion at which the depth vanishes.** Let `C` be a Noetherian local
ring, `f ∈ 𝔪_C`, and `Ĉ` the `J`-adic completion of `C` for `J = (f)`. Let `𝔨` be a prime of `C`
with `f ∉ 𝔨`, `f 𝔨 = 0` and `𝔪_C ⊆ √(𝔨 + (f))`, and let `M` be a `Ĉ`-module isomorphic to `Ĉ`.
Then there is a prime `𝔭` of `Ĉ` not containing `J Ĉ` such that `𝔪_C Ĉ` is the only prime
containing both `𝔭` and `J Ĉ`, and such that `depth(M_𝔭) = 0`. -/
theorem exists_prime_depth_localizedModule_eq_zero {C : Type u} [CommRing C] [IsNoetherianRing C]
    [IsLocalRing C] (J : Ideal C) {f : C} (hJ : J = Ideal.span {f}) (hf : f ∈ maximalIdeal C)
    (𝔨 : Ideal C) [𝔨.IsPrime] (hf𝔨 : f ∉ 𝔨) (h𝔨 : ∀ k ∈ 𝔨, f * k = 0)
    (hrad : maximalIdeal C ≤ (𝔨 ⊔ Ideal.span {f}).radical)
    (M : Type*) [AddCommGroup M] [Module (AdicCompletion J C) M]
    (eM : M ≃ₗ[AdicCompletion J C] AdicCompletion J C) :
    ∃ p : PrimeSpectrum (AdicCompletion J C),
      ¬ J.map (algebraMap C (AdicCompletion J C)) ≤ p.asIdeal ∧
      {q : Ideal (AdicCompletion J C) | q.IsPrime ∧ p.asIdeal ≤ q ∧
          J.map (algebraMap C (AdicCompletion J C)) ≤ q} =
        {(maximalIdeal C).map (algebraMap C (AdicCompletion J C))} ∧
      Module.depth (Localization.AtPrime p.asIdeal)
          (maximalIdeal (Localization.AtPrime p.asIdeal))
          (LocalizedModule p.asIdeal.primeCompl M) = 0 := by
  subst hJ
  set Ĉ := AdicCompletion (Ideal.span {f}) C
  have h𝔨m : 𝔨 ≤ maximalIdeal C := le_maximalIdeal ‹𝔨.IsPrime›.ne_top
  have hnil : algebraMap C Ĉ f ∉ (𝔨.map (algebraMap C Ĉ)).radical := by
    rintro ⟨n, hn⟩
    let φ : Ĉ →+* C ⧸ Ideal.span {f} ^ (n + 1) :=
      (AdicCompletion.evalₐ (Ideal.span {f}) (n + 1)).toRingHom
    have hφ : φ.comp (algebraMap C Ĉ) = Ideal.Quotient.mk (Ideal.span {f} ^ (n + 1)) :=
      (AdicCompletion.evalₐ (Ideal.span {f}) (n + 1)).comp_algebraMap
    have h1 : φ (algebraMap C Ĉ f ^ n) ∈ (𝔨.map (algebraMap C Ĉ)).map φ :=
      Ideal.mem_map_of_mem _ hn
    rw [Ideal.map_map, hφ, ← map_pow, ← RingHom.comp_apply, hφ,
      Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at h1
    obtain ⟨k, hk, hkf⟩ := h1
    rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton'] at hkf
    obtain ⟨c, hc⟩ := hkf
    have hmem : f ^ n * (1 + c * f) ∈ 𝔨 := by
      rwa [show f ^ n * (1 + c * f) = k by linear_combination hc]
    rcases ‹𝔨.IsPrime›.mem_or_mem hmem with h | h
    · exact hf𝔨 (‹𝔨.IsPrime›.mem_of_pow_mem n h)
    · have h1 : (1 : C) ∈ maximalIdeal C := by
        have := (maximalIdeal C).sub_mem (h𝔨m h) ((maximalIdeal C).mul_mem_left c hf)
        rwa [add_sub_cancel_right] at this
      exact (maximalIdeal.isMaximal C).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  rw [Ideal.radical_eq_sInf, Submodule.mem_sInf] at hnil
  push Not at hnil
  obtain ⟨P, ⟨hKP, hPprime⟩, hfP⟩ := hnil
  obtain ⟨p, hp, hpP⟩ := Ideal.exists_minimalPrimes_le hKP
  have hpprime : p.IsPrime := hp.1.1
  have hfp : algebraMap C Ĉ f ∉ p := fun h ↦ hfP (hpP h)
  have hKp : 𝔨.map (algebraMap C Ĉ) ≤ p := hp.1.2
  refine ⟨⟨p, hpprime⟩, fun h ↦ hfp (h (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self f))),
    ?_, ?_⟩
  · have hJm : Ideal.span {f} ≤ maximalIdeal C := (Ideal.span_singleton_le_iff_mem _).mpr hf
    have hmax := isMaximal_map_maximalIdeal hJm
    ext q
    refine ⟨fun ⟨hq, hpq, hJq⟩ ↦ ?_, fun hq ↦ ?_⟩
    swap
    · rw [Set.mem_singleton_iff] at hq
      subst hq
      have := Stacks.AdicCompletionDimension.isLocalRing_adicCompletion_of_le_maximalIdeal _ hJm
      refine ⟨hmax.isPrime, ?_, Ideal.map_mono hJm⟩
      have h := le_maximalIdeal hpprime.ne_top
      rwa [← IsLocalRing.eq_maximalIdeal hmax] at h
    rw [Set.mem_singleton_iff]
    have hle : (maximalIdeal C).map (algebraMap C Ĉ) ≤ q := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      obtain ⟨n, hn⟩ := hrad hm
      have hmn : algebraMap C Ĉ m ^ n ∈ q := by
        rw [← map_pow]
        exact (Ideal.map_sup _ _ _).trans_le (sup_le (hKp.trans hpq) hJq)
          (Ideal.mem_map_of_mem _ hn)
      exact hq.mem_of_pow_mem n hmn
    exact (hmax.eq_of_le hq.ne_top hle).symm
  · change Module.depth (Localization.AtPrime p) (maximalIdeal (Localization.AtPrime p))
      (LocalizedModule p.primeCompl M) = 0
    rw [depth_localizedModule_eq p eM]
    have hmin : p ∈ minimalPrimes Ĉ := by
      refine ⟨⟨hpprime, bot_le⟩, fun q hq hqp ↦ ?_⟩
      have : q.IsPrime := hq.1
      exact hp.2 ⟨hq.1, map_le_of_mul_eq_zero h𝔨 (fun h ↦ hfp (hqp h))⟩ hqp
    have hdim : ringKrullDim (Localization.AtPrime p) = 0 := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height p (Localization.AtPrime p),
        Ideal.height_eq_zero_iff.mpr hmin]
      rfl
    have hI : maximalIdeal (Localization.AtPrime p) •
        (⊤ : Submodule (Localization.AtPrime p) (Localization.AtPrime p)) ≠ ⊤ := by
      simpa using (maximalIdeal.isMaximal (Localization.AtPrime p)).ne_top
    have h := (Module.depth_le_supportDim _ _ (Localization.AtPrime p) hI).trans
      (Module.supportDim_le_ringKrullDim _ _)
    rw [hdim] at h
    exact nonpos_iff_eq_zero.mp (by exact_mod_cast h)

/-- **A lower bound for the depth in the completion.** Let `C` be a Noetherian local ring,
`f ∈ 𝔪_C`, and `Ĉ` the `J`-adic completion of `C` for `J = (f)`. Let `𝔨` be an ideal of `C` with
`f 𝔨 = 0` such that `C ⧸ 𝔨` is a regular local ring of dimension at least `d`, and let `M` be a
`Ĉ`-module isomorphic to `Ĉ`. Then for every prime `𝔭` of `Ĉ` not containing `J Ĉ`, the ring
`Ĉ ⧸ 𝔭` has finite dimension `e` and `d ≤ depth(M_𝔭) + e`. -/
theorem exists_ringKrullDim_quotient_eq_and_le_depth_add {C : Type u} [CommRing C]
    [IsNoetherianRing C] [IsLocalRing C] (J : Ideal C) {f : C} (hJ : J = Ideal.span {f})
    (hf : f ∈ maximalIdeal C) (𝔨 : Ideal C) (h𝔨 : ∀ k ∈ 𝔨, f * k = 0)
    [IsRegularLocalRing (C ⧸ 𝔨)] {d : ℕ} (hd : (d : WithBot ℕ∞) ≤ ringKrullDim (C ⧸ 𝔨))
    (M : Type*) [AddCommGroup M] [Module (AdicCompletion J C) M]
    (eM : M ≃ₗ[AdicCompletion J C] AdicCompletion J C)
    (p : PrimeSpectrum (AdicCompletion J C))
    (hp : ¬ J.map (algebraMap C (AdicCompletion J C)) ≤ p.asIdeal) :
    ∃ e : ℕ, ringKrullDim (AdicCompletion J C ⧸ p.asIdeal) = e ∧
      (d : ℕ∞) ≤ Module.depth (Localization.AtPrime p.asIdeal)
          (maximalIdeal (Localization.AtPrime p.asIdeal))
          (LocalizedModule p.asIdeal.primeCompl M) + e := by
  subst hJ
  set Ĉ := AdicCompletion (Ideal.span {f}) C
  set P := p.asIdeal
  have hJm : Ideal.span {f} ≤ maximalIdeal C := (Ideal.span_singleton_le_iff_mem _).mpr hf
  have hloc : IsLocalRing Ĉ :=
    Stacks.AdicCompletionDimension.isLocalRing_adicCompletion_of_le_maximalIdeal _ hJm
  have hmĈ : maximalIdeal Ĉ = (maximalIdeal C).map (algebraMap C Ĉ) :=
    (IsLocalRing.eq_maximalIdeal (isMaximal_map_maximalIdeal hJm)).symm
  have hfp : algebraMap C Ĉ f ∉ P := by
    intro h
    apply hp
    rwa [Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff]
  set K := 𝔨.map (algebraMap C Ĉ)
  have hKP : K ≤ P := map_le_of_mul_eq_zero h𝔨 hfp
  have h𝔨top : 𝔨 ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have h𝔨m : 𝔨 ≤ maximalIdeal C := le_maximalIdeal h𝔨top
  have hKm : K ≤ maximalIdeal Ĉ := by rw [hmĈ]; exact Ideal.map_mono h𝔨m
  have : Nontrivial (Ĉ ⧸ K) := FlatLocalCatenary.quot_nontrivial_of_le hKm
  have : IsLocalRing (Ĉ ⧸ K) := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have : Module.Flat (C ⧸ 𝔨) (Ĉ ⧸ K) := FlatLocalCatenary.flat_quot 𝔨
  have hmax : (maximalIdeal (C ⧸ 𝔨)).map (algebraMap (C ⧸ 𝔨) (Ĉ ⧸ K)) =
      maximalIdeal (Ĉ ⧸ K) := by
    rw [← FlatLocalCatenary.map_maximalIdeal_quot 𝔨, Ideal.map_map,
      FlatLocalCatenary.algebraMap_quot_comp, ← Ideal.map_map, ← hmĈ,
      FlatLocalCatenary.map_maximalIdeal_quot]
  have : IsLocalHom (algebraMap (C ⧸ 𝔨) (Ĉ ⧸ K)) :=
    ((IsLocalRing.local_hom_TFAE _).out 1 3).mpr (le_of_eq hmax)
  have hdim : ringKrullDim (C ⧸ 𝔨) = ringKrullDim (Ĉ ⧸ K) :=
    Stacks.FlatLocalDimension.ringKrullDim_eq_of_flat_of_map_maximalIdeal_eq hmax
  have hCMD : Module.IsMaximalCohenMacaulay (C ⧸ 𝔨) (C ⧸ 𝔨) :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      (C ⧸ 𝔨)).2
  have hCMT : Module.IsMaximalCohenMacaulay (Ĉ ⧸ K) (Ĉ ⧸ K) :=
    (Module.isMaximalCohenMacaulay_self_and_ringKrullDim_eq_of_flat hCMD
      (Or.inr hdim.symm.le)).1
  set P' := P.map (Ideal.Quotient.mk K)
  have : P'.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hKP
  have hsplit := hCMT.ringKrullDim_eq_height_add_ringKrullDim_quotient P'
  rw [ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hKP), ← hdim] at hsplit
  have hcomap : P'.comap (Ideal.Quotient.mk K) = P := by
    rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
      ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    exact sup_eq_left.mpr hKP
  have : P'.LiesOver P := ⟨hcomap.symm⟩
  have hsub : Algebra.algebraMapSubmonoid (Ĉ ⧸ K) P.primeCompl = P'.primeCompl :=
    Ideal.algebraMapSubmonoid_primeCompl_of_liesOver_surjective _ P Ideal.Quotient.mk_surjective
  have : IsLocalization P'.primeCompl
      (Localization.AtPrime P ⧸ K.map (algebraMap Ĉ (Localization.AtPrime P))) :=
    hsub ▸ inferInstance
  let e₁ : (Localization.AtPrime P ⧸ K.map (algebraMap Ĉ (Localization.AtPrime P))) ≃+*
      Localization.AtPrime P :=
    (Ideal.quotEquivOfEq (map_map_localization_eq_bot h𝔨 P hfp)).trans
      (RingEquiv.quotientBot _)
  have : IsLocalRing (Localization.AtPrime P ⧸ K.map (algebraMap Ĉ (Localization.AtPrime P))) :=
    e₁.symm.isLocalRing
  have hCMQ := hCMT.of_isLocalization_atPrime P'
    (Localization.AtPrime P ⧸ K.map (algebraMap Ĉ (Localization.AtPrime P)))
  have hdepth : (Module.depth (Localization.AtPrime P) (maximalIdeal (Localization.AtPrime P))
      (LocalizedModule P.primeCompl M) : WithBot ℕ∞) = P'.height := by
    rw [depth_localizedModule_eq P eM, ← Module.depth_self_eq_of_ringEquiv e₁]
    exact hCMQ.trans (IsLocalization.AtPrime.ringKrullDim_eq_height P' _)
  have : Nontrivial (Ĉ ⧸ P) := Ideal.Quotient.nontrivial_iff.mpr p.isPrime.ne_top
  have : IsLocalRing (Ĉ ⧸ P) := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  obtain ⟨r, hr⟩ : ∃ r : ℕ∞, ringKrullDim (Ĉ ⧸ P) = r :=
    WithBot.ne_bot_iff_exists.mp (ringKrullDim_ne_bot) |>.imp fun _ h ↦ h.symm
  have hN := IsRegularLocalRing.spanFinrank_maximalIdeal (R := C ⧸ 𝔨)
  rw [← hN, hr] at hsplit
  rw [← hN] at hd
  have hsplit' : ((maximalIdeal (C ⧸ 𝔨)).spanFinrank : ℕ∞) = P'.height + r := by
    exact_mod_cast hsplit
  have hrtop : r ≠ ⊤ := by
    rintro rfl
    rw [add_top] at hsplit'
    exact ENat.natCast_ne_top _ hsplit'
  refine ⟨r.toNat, ?_, ?_⟩
  · rw [hr, ← ENat.natCast_toNat hrtop]
    rfl
  · have hdepth' : Module.depth (Localization.AtPrime P) (maximalIdeal (Localization.AtPrime P))
        (LocalizedModule P.primeCompl M) = P'.height := by exact_mod_cast hdepth
    rw [hdepth', ENat.natCast_toNat hrtop, ← hsplit']
    exact_mod_cast hd

end Stacks.AdicCompletionAnnihilated
