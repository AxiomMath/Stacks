module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import Mathlib.RingTheory.AdicCompletion.Completeness

/-!
# The kernel of an evaluation of an adic completion

For a finitely generated ideal `I` of a ring `R`, the kernel of the algebra map
`AdicCompletion.evalₐ I n` onto the truncation `R ⧸ I ^ n` is the `n`-th power of the ideal
generated by `I` in the completion.

## Main results

* `AdicCompletion.ker_evalₐ`: the kernel of `evalₐ I n` is the `n`-th power of the image of `I`.
* `AdicCompletion.ker_evalₐ_eq_map_pow`: the kernel of `evalₐ I n` is the image of `I ^ n`.
-/

@[expose] public section

namespace AdicCompletion

/-- The kernel of `AdicCompletion.evalₐ I n` is the `n`-th power of the image of `I` in
`AdicCompletion I R`, for `I` finitely generated. -/
theorem ker_evalₐ {R : Type*} [CommRing R] (I : Ideal R) (hI : I.FG) (n : ℕ) :
    RingHom.ker (AdicCompletion.evalₐ I n).toRingHom =
      (I.map (algebraMap R (AdicCompletion I R))) ^ n := by
  ext x
  have he : AdicCompletion.evalₐ I n x = 0 ↔ AdicCompletion.eval I R n x = 0 := by
    change (Ideal.quotientEquivAlgOfEq R (show (I ^ n • ⊤ : Ideal R) = I ^ n by simp))
      (AdicCompletion.eval I R n x) = 0 ↔ _
    exact map_eq_zero_iff _ (AlgEquiv.injective _)
  rw [RingHom.mem_ker]
  change AdicCompletion.evalₐ I n x = 0 ↔ _
  rw [he, ← LinearMap.mem_ker,
    ← AdicCompletion.pow_smul_top_eq_ker_eval hI, ← Ideal.map_pow,
    Ideal.smul_top_eq_map]
  rfl

/-- The kernel of `AdicCompletion.evalₐ I n` is the image of `I ^ n` in `AdicCompletion I R`, for
`I` finitely generated. -/
theorem ker_evalₐ_eq_map_pow {R : Type*} [CommRing R] (I : Ideal R) (hI : I.FG) (n : ℕ) :
    RingHom.ker (AdicCompletion.evalₐ I n).toRingHom =
      (I ^ n).map (algebraMap R (AdicCompletion I R)) := by
  rw [ker_evalₐ I hI n, Ideal.map_pow]

end AdicCompletion
