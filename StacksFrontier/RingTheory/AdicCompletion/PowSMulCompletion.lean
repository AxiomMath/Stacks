module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.AdicCompletion.KerEval
public import StacksFrontier.RingTheory.AdicCompletion.QuotPow

/-!
# The completion of `IⁿM` and the remaining parts of Stacks 05GG

Let `R` be a ring, let `I ⊆ R` be an ideal and let `M` be an `R`-module, and write
`M^∧ = lim M/IⁿM` for the `I`-adic completion. Stacks 05GG says that, for `I` finitely generated,
`M^∧` is `I`-adically complete and `IⁿM^∧ = Ker(M^∧ → M/IⁿM) = (IⁿM)^∧`, and in particular that
`R^∧` is `I`-adically complete, `IⁿR^∧ = (Iⁿ)^∧` and `R^∧/IⁿR^∧ = R/Iⁿ`. Mathlib proves and tags
part (1) (`AdicCompletion.isAdicComplete`) and the first equality of part (2)
(`AdicCompletion.pow_smul_top_eq_ker_eval`). This file supplies the rest and registers every part
under the tag.

## Main definitions

* `AdicCompletion.ofPowSMulEquivKerEval`: for any ideal `I`, the isomorphism of `R`-modules
  `(IⁿM)^∧ ≃ Ker(M^∧ → M/IⁿM)` given by the completion of the inclusion `IⁿM ⊆ M`. This is the
  second equality of part (2); it rests on Mathlib's `AdicCompletion.ofPowSMul_injective` and
  `AdicCompletion.restrictScalars_range_ofPowSMul_eq_ker_eval`, which this file also registers.
* `AdicCompletion.quotMapPowAlgEquiv`: for a finitely generated ideal `I`, the isomorphism of
  `R`-algebras `R^∧/IⁿR^∧ ≃ R/Iⁿ` induced by `AdicCompletion.evalₐ`.

## Main results

* `AdicCompletion.map_pow_eq_range_map_subtype`: for a finitely generated ideal `I`, the ideal
  `IⁿR^∧` of `R^∧` generated by `Iⁿ` is the image of the completion `(Iⁿ)^∧ → R^∧` of the
  inclusion `Iⁿ ⊆ R`, which is injective by `AdicCompletion.map_subtype_pow_injective`.

## Implementation notes

The source's `IⁿM` is `I ^ n • (⊤ : Submodule R M)`, its `(IⁿM)^∧` is
`AdicCompletion I ↥(I ^ n • ⊤ : Submodule R M)` viewed inside `M^∧` through
`AdicCompletion.ofPowSMul`, and its projection `M^∧ → M/IⁿM` is `AdicCompletion.eval I M n`. For
`M = R` the source's `Iⁿ` is the ideal `I ^ n` itself, its `IⁿR^∧` is the ideal
`(I ^ n).map (algebraMap R R^∧)` it generates in `R^∧`, and its `(Iⁿ)^∧` is
`AdicCompletion I ↥(I ^ n)` inside `R^∧` through the completion of `(I ^ n).subtype`.

The source's `n ≥ 1` is dropped: every statement here holds for `n = 0` as well. The statements
that need no finiteness of `I` are stated without it.

The remaining assertion of the "in particular", that `R^∧` is `I`-adically complete, is part (1),
`AdicCompletion.isAdicComplete`, at `M = R`; and `M^∧/IⁿM^∧ ≃ M/IⁿM` for an arbitrary `M` is
`AdicCompletion.quotPowSMulTopEquiv`, registered here too.

## References

* [Stacks Project, Tag 05GG](https://stacks.math.columbia.edu/tag/05GG)

## Tags

adic completion, finitely generated ideal
-/

@[expose] public section

namespace AdicCompletion

/-- **Stacks 05GG**, the second equality of part (2), as an isomorphism. Let `R` be a ring, `I` an
ideal of `R` and `M` an `R`-module. The completion `(IⁿM)^∧ → M^∧` of the inclusion `IⁿM ⊆ M`
is injective with image the kernel of the projection `M^∧ → M/IⁿM`, so it is an isomorphism of
`R`-modules `(IⁿM)^∧ ≃ Ker(M^∧ → M/IⁿM)`. No finiteness of `I` is needed. -/
public noncomputable def ofPowSMulEquivKerEval {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ) :
    AdicCompletion I ↥(I ^ n • ⊤ : Submodule R M) ≃ₗ[R] LinearMap.ker (eval I M n) :=
  (LinearEquiv.ofInjective ((ofPowSMul I M n).restrictScalars R) (ofPowSMul_injective I n)).trans
    (LinearEquiv.ofEq _ _ ((LinearMap.range_restrictScalars _).trans
      (restrictScalars_range_ofPowSMul_eq_ker_eval I)))

/-- The isomorphism `ofPowSMulEquivKerEval` is the completion of the inclusion `IⁿM ⊆ M`. -/
@[simp]
public theorem coe_ofPowSMulEquivKerEval_apply {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [Module R M] (n : ℕ)
    (x : AdicCompletion I ↥(I ^ n • ⊤ : Submodule R M)) :
    (ofPowSMulEquivKerEval I M n x : AdicCompletion I M) = ofPowSMul I M n x :=
  rfl

/-- **Stacks 05GG**, the concluding "in particular", part `(Iⁿ)^∧ ⊆ R^∧`: for an ideal `I` of a ring
`R`, the completion `(Iⁿ)^∧ → R^∧` of the inclusion `Iⁿ ⊆ R` is injective. No finiteness of `I`
is needed. -/
public theorem map_subtype_pow_injective {R : Type*} [CommRing R] (I : Ideal R) (n : ℕ) :
    Function.Injective (map I (I ^ n).subtype) := by
  have key : ∀ N : Submodule R R, N = I ^ n • ⊤ → Function.Injective (map I N.subtype) := by
    rintro N rfl
    exact ofPowSMul_injective I n
  exact key _ (by simp)

/-- **Stacks 05GG**, the concluding "in particular", `IⁿR^∧ = (Iⁿ)^∧`: for a finitely generated
ideal `I` of a ring `R`, the ideal of `R^∧` generated by `Iⁿ` is the image of the completion
`(Iⁿ)^∧ → R^∧` of the inclusion `Iⁿ ⊆ R`. -/
public theorem map_pow_eq_range_map_subtype {R : Type*} [CommRing R] {I : Ideal R} (hI : I.FG)
    (n : ℕ) :
    (I ^ n).map (algebraMap R (AdicCompletion I R)) = LinearMap.range (map I (I ^ n).subtype) := by
  have key : ∀ N : Submodule R R, N = I ^ n • ⊤ →
      LinearMap.range (map I N.subtype) = LinearMap.range (ofPowSMul I R n) := by
    rintro N rfl
    rfl
  rw [key _ (by simp)]
  apply Submodule.restrictScalars_injective R
  rw [← Ideal.smul_top_eq_map, pow_smul_top_eq_ker_eval hI]
  exact (restrictScalars_range_ofPowSMul_eq_ker_eval I).symm

/-- **Stacks 05GG**, the concluding "in particular", `R^∧/IⁿR^∧ = R/Iⁿ`: for a finitely generated
ideal `I` of a ring `R`, the projection `R^∧ → R/Iⁿ` induces an isomorphism of `R`-algebras from
the quotient of `R^∧` by the ideal generated by `Iⁿ` onto `R/Iⁿ`. -/
public noncomputable def quotMapPowAlgEquiv {R : Type*} [CommRing R] {I : Ideal R} (hI : I.FG)
    (n : ℕ) :
    (AdicCompletion I R ⧸ (I ^ n).map (algebraMap R (AdicCompletion I R))) ≃ₐ[R] R ⧸ I ^ n :=
  (Ideal.quotientEquivAlgOfEq R (ker_evalₐ_eq_map_pow I hI n).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (surjective_evalₐ I n))

/-- The isomorphism `quotMapPowAlgEquiv` sends the class of `x ∈ R^∧` to its image `evalₐ I n x`
in `R/Iⁿ`. -/
@[simp]
public theorem quotMapPowAlgEquiv_mk {R : Type*} [CommRing R] {I : Ideal R} (hI : I.FG) (n : ℕ)
    (x : AdicCompletion I R) :
    quotMapPowAlgEquiv hI n (Ideal.Quotient.mk _ x) = evalₐ I n x :=
  rfl

end AdicCompletion

