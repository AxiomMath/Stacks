module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.RingTheory.Noetherian.Basic

/-!
# Kernels in a graded module over a polynomial ring are generated in bounded degree

Let `R` be a Noetherian ring and `M₀, M₁, …` finite `R`-modules with `r + 1` families of
`R`-linear maps `τᵢ : Mₙ ⟶ Mₙ₊₁` that commute with one another — a graded module over the
polynomial ring `R[T₀, …, T_r]` all of whose variables have degree one.  If the family is
generated in degrees `≤ N`, that is `Mₙ₊₁ = ∑ᵢ τᵢ(Mₙ)` for `n ≥ N`, then the kernels
`Kₙ = ker(τ_r : Mₙ ⟶ Mₙ₊₁)` of the last map, with the other maps, are again generated in bounded
degree: there is an `N'` with `Kₙ₊₁ = ∑_{i < r} τᵢ(Kₙ)` for `n ≥ N'`.

This is the finite generation of a graded submodule of a finitely generated graded module over
`R[T₀, …, T_r]`, in the case of the kernel of the last variable.

## Main results

* `Stacks.CommutingFamilyAlgebra.exists_ker_le_iSup_map_ker`: the kernel generation.

## The argument

The total module `T = ⨁ₙ Mₙ` carries the commuting endomorphisms `shift τᵢ` raising the degree by
one, hence an action of `P = R[T₀, …, T_r]` through the commutative subalgebra of `End_R(T)` they
generate.  `T` is a finite `P`-module (it is generated by the finitely many generators of the
`Mₙ` with `n ≤ N`), so, `P` being Noetherian, the `P`-submodule `ker(shift τ_r)` is generated by a
finite set.  Every polynomial is a constant plus `∑ᵢ Tᵢ qᵢ`, so above the degrees occurring in the
generators the degree-`(n + 1)` part of `ker(shift τ_r)` lies in `∑ᵢ τᵢ` of its degree-`n` part,
and `τ_r` contributes nothing there.

## References

* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
-/

@[expose] public noncomputable section

open DirectSum

universe u v

namespace Stacks.CommutingFamilyAlgebra

variable {R : Type u} [CommRing R] {M : ℕ → Type v} [∀ n, AddCommGroup (M n)]
  [∀ n, Module R (M n)] {r : ℕ}

/-- The endomorphism of `⨁ₙ Mₙ` raising the degree by one through `τ : Mₙ ⟶ Mₙ₊₁`. -/
def shift (τ : ∀ n, M n →ₗ[R] M (n + 1)) : Module.End R (⨁ n, M n) :=
  DirectSum.toModule R ℕ _ fun n => (DirectSum.lof R ℕ M (n + 1)).comp (τ n)

/-- The shift sends `x ∈ Mₙ` in degree `n` to `τ x ∈ Mₙ₊₁` in degree `n + 1`. -/
theorem shift_lof (τ : ∀ n, M n →ₗ[R] M (n + 1)) (n : ℕ) (x : M n) :
    shift τ (DirectSum.lof R ℕ M n x) = DirectSum.lof R ℕ M (n + 1) (τ n x) :=
  DirectSum.toModule_lof R n x

/-- The degree-`(n + 1)` component of a shift is the image of the degree-`n` component. -/
theorem component_succ_shift (τ : ∀ n, M n →ₗ[R] M (n + 1)) (n : ℕ) (x : ⨁ n, M n) :
    DirectSum.component R ℕ M (n + 1) (shift τ x) = τ n (DirectSum.component R ℕ M n x) := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | of k y =>
    rw [← DirectSum.lof_eq_of R, shift_lof]
    by_cases h : k = n
    · subst h
      rw [DirectSum.component.lof_self, DirectSum.component.lof_self]
    · rw [DirectSum.component.of, DirectSum.component.of, dif_neg (by omega), dif_neg h,
        map_zero]
  | add x y hx hy => simp only [map_add, hx, hy]

/-- A shift has no degree-zero component. -/
theorem component_zero_shift (τ : ∀ n, M n →ₗ[R] M (n + 1)) (x : ⨁ n, M n) :
    DirectSum.component R ℕ M 0 (shift τ x) = 0 := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | of k y =>
    rw [← DirectSum.lof_eq_of R, shift_lof, DirectSum.component.of, dif_neg (by omega)]
  | add x y hx hy => simp only [map_add, hx, hy, add_zero]

/-- Shifts along commuting families of maps commute. -/
theorem shift_mul_shift_comm (τ σ : ∀ n, M n →ₗ[R] M (n + 1))
    (h : ∀ n, (σ (n + 1)).comp (τ n) = (τ (n + 1)).comp (σ n)) :
    shift σ * shift τ = shift τ * shift σ := by
  apply DirectSum.linearMap_ext
  intro n
  refine LinearMap.ext fun x => ?_
  simp only [LinearMap.comp_apply, Module.End.mul_apply, shift_lof]
  exact congrArg (DirectSum.lof R ℕ M (n + 1 + 1)) (LinearMap.congr_fun (h n) x)

/-- Every multivariate polynomial is its constant coefficient plus a combination of the
variables. -/
theorem exists_eq_C_add_sum_X_mul {k : ℕ} (p : MvPolynomial (Fin k) R) :
    ∃ q : Fin k → MvPolynomial (Fin k) R,
      p = MvPolynomial.C (MvPolynomial.constantCoeff p) + ∑ i, MvPolynomial.X i * q i := by
  have hmem : p - MvPolynomial.C (MvPolynomial.constantCoeff p) ∈
      Ideal.span (Set.range (MvPolynomial.X : Fin k → MvPolynomial (Fin k) R)) := by
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    by_contra hne
    have hm0 : m = 0 := Finsupp.ext fun i => by
      by_contra hi
      exact hne ⟨i, Set.mem_univ i, hi⟩
    subst hm0
    rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_C,
      if_pos rfl, ← MvPolynomial.constantCoeff_eq, sub_self] at hm
    exact hm rfl
  obtain ⟨q, hq⟩ := Ideal.mem_span_range_iff_exists_fun.1 hmem
  refine ⟨q, ?_⟩
  rw [← sub_eq_iff_eq_add', ← hq]
  exact Finset.sum_congr rfl fun i _ => mul_comm _ _

/-- **Kernels of the last map of a generated commuting family are generated in bounded degree.**

Let `R` be Noetherian, `Mₙ` finite `R`-modules and `τ₀, …, τ_r : Mₙ ⟶ Mₙ₊₁` commuting families of
`R`-linear maps with `Mₙ₊₁ = ∑ᵢ τᵢ(Mₙ)` for `n ≥ N`.  Then there is an `N'` such that for every
`n ≥ N'` the kernel of `τ_r : Mₙ₊₁ ⟶ Mₙ₊₂` is contained in `∑_{i < r} τᵢ(ker(τ_r : Mₙ ⟶ Mₙ₊₁))`. -/
theorem exists_ker_le_iSup_map_ker [IsNoetherianRing R] [∀ n, Module.Finite R (M n)]
    (τ : Fin (r + 1) → ∀ n, M n →ₗ[R] M (n + 1))
    (hcomm : ∀ i j n, (τ j (n + 1)).comp (τ i n) = (τ i (n + 1)).comp (τ j n))
    {N : ℕ} (hgen : ∀ n, N ≤ n → ⨆ i, LinearMap.range (τ i n) = ⊤) :
    ∃ N', ∀ n, N' ≤ n → LinearMap.ker (τ (Fin.last r) (n + 1)) ≤
      ⨆ i : Fin r, (LinearMap.ker (τ (Fin.last r) n)).map (τ i.castSucc n) := by
  classical
  set sh : Fin (r + 1) → Module.End R (⨁ n, M n) := fun i => shift (τ i) with hsh
  set 𝔄 := Algebra.adjoin R (Set.range sh)
  have : IsMulCommutative 𝔄 := Algebra.isMulCommutative_adjoin R <| by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ -
    exact shift_mul_shift_comm (τ j) (τ i) (hcomm j i)
  let : CommRing 𝔄 := { (inferInstance : Ring 𝔄) with mul_comm := mul_comm' }
  let φ : MvPolynomial (Fin (r + 1)) R →ₐ[R] 𝔄 :=
    MvPolynomial.aeval fun i => ⟨sh i, Algebra.subset_adjoin ⟨i, rfl⟩⟩
  let ψ : MvPolynomial (Fin (r + 1)) R →+* Module.End R (⨁ n, M n) :=
    (𝔄.val.comp φ).toRingHom
  let : Module (MvPolynomial (Fin (r + 1)) R) (⨁ n, M n) := Module.compHom _ ψ
  have hsmul : ∀ (p : MvPolynomial (Fin (r + 1)) R) (t : ⨁ n, M n), p • t = ψ p t :=
    fun _ _ => rfl
  have hψX : ∀ i, ψ (MvPolynomial.X i) = sh i := fun i => by
    simp [ψ, φ, MvPolynomial.aeval_X]
  have hψC : ∀ (c : R) (t : ⨁ n, M n), ψ (MvPolynomial.C c) t = c • t := fun c t => by
    simp [ψ, φ, Algebra.algebraMap_eq_smul_one]
  have hψcomm : ∀ p, ψ p * sh (Fin.last r) = sh (Fin.last r) * ψ p := fun p =>
    congrArg Subtype.val (mul_comm' (φ p) ⟨sh (Fin.last r), Algebra.subset_adjoin ⟨_, rfl⟩⟩)
  -- The total module is finite over the polynomial ring.
  have hfin : Module.Finite (MvPolynomial (Fin (r + 1)) R) (⨁ n, M n) := by
    choose g hg using fun n => (Module.Finite.fg_top (R := R) (M := M n))
    refine ⟨⟨(Finset.range (N + 1)).biUnion fun n => (g n).image (DirectSum.lof R ℕ M n), ?_⟩⟩
    set P := Submodule.span (MvPolynomial (Fin (r + 1)) R)
      (((Finset.range (N + 1)).biUnion fun n => (g n).image (DirectSum.lof R ℕ M n) :
        Finset (⨁ n, M n)) : Set (⨁ n, M n)) with hP
    have hspan : ∀ n (s : Set (M n)), (∀ x ∈ s, DirectSum.lof R ℕ M n x ∈ P) →
        ∀ x ∈ Submodule.span R s, DirectSum.lof R ℕ M n x ∈ P := by
      intro n s hs x hx
      induction hx using Submodule.span_induction with
      | mem y hy => exact hs y hy
      | zero => simp
      | add y z _ _ hy hz => rw [map_add]; exact P.add_mem hy hz
      | smul c y _ hy =>
        simpa [hsmul, hψC] using P.smul_mem (MvPolynomial.C c) hy
    have hdeg : ∀ n (x : M n), DirectSum.lof R ℕ M n x ∈ P := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro x
        by_cases hn : n ≤ N
        · refine hspan n _ (fun y hy => Submodule.subset_span ?_) x (by rw [hg n]; trivial)
          simp only [Finset.coe_biUnion, Finset.coe_range, Finset.coe_image, Set.mem_iUnion,
            Set.mem_image, Finset.mem_coe, Set.mem_Iio]
          exact ⟨n, by omega, y, hy, rfl⟩
        · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
          refine hspan _ _ (fun y hy => ?_) x
            (by rw [← Submodule.iSup_eq_span, hgen m (by omega)]; trivial)
          obtain ⟨i, z, rfl⟩ := Set.mem_iUnion.1 hy
          have : DirectSum.lof R ℕ M (m + 1) (τ i m z) =
              (MvPolynomial.X i : MvPolynomial (Fin (r + 1)) R) • DirectSum.lof R ℕ M m z := by
            rw [hsmul, hψX, hsh, shift_lof]
          rw [this]
          exact P.smul_mem _ (ih m (by omega) z)
    rw [eq_top_iff]
    rintro t -
    induction t using DirectSum.induction_on with
    | zero => exact P.zero_mem
    | of n x => rw [← DirectSum.lof_eq_of R]; exact hdeg n x
    | add x y hx hy => exact P.add_mem hx hy
  -- The kernel of the last shift is a finitely generated submodule.
  let K : Submodule (MvPolynomial (Fin (r + 1)) R) (⨁ n, M n) :=
    { carrier := {t | sh (Fin.last r) t = 0}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_setOf_eq, map_add] at *
        rw [ha, hb, add_zero]
      zero_mem' := by simp
      smul_mem' := fun p t ht => by
        simp only [Set.mem_setOf_eq] at *
        rw [hsmul, ← Module.End.mul_apply, ← hψcomm, Module.End.mul_apply, ht, map_zero] }
  obtain ⟨G, hG⟩ : K.FG := IsNoetherian.noetherian K
  refine ⟨G.sup fun t => (DFinsupp.support t).sup id, fun n hn y hy => ?_⟩
  have hyK : DirectSum.lof R ℕ M (n + 1) y ∈ K := by
    show sh (Fin.last r) _ = 0
    rw [hsh, shift_lof, LinearMap.mem_ker.1 hy, map_zero]
  rw [← hG] at hyK
  obtain ⟨c, hc⟩ := (Submodule.mem_span_finset).1 hyK
  have hcomp := congrArg (DirectSum.component R ℕ M (n + 1)) hc.2
  rw [DirectSum.component.lof_self, map_sum] at hcomp
  rw [← hcomp]
  refine Submodule.sum_mem _ fun t ht => ?_
  have htK : t ∈ K := hG ▸ Submodule.subset_span ht
  obtain ⟨q, hq⟩ := exists_eq_C_add_sum_X_mul (c t)
  -- The degree-`(n + 1)` component of `t` vanishes, `n + 1` exceeding its degrees.
  have ht0 : DirectSum.component R ℕ M (n + 1) t = 0 := by
    rw [← DirectSum.apply_eq_component]
    by_contra hne
    have hmem : n + 1 ∈ DFinsupp.support t := DFinsupp.mem_support_iff.2 hne
    have h1 : n + 1 ≤ (DFinsupp.support t).sup id := Finset.le_sup (f := id) hmem
    have h2 : (DFinsupp.support t).sup id ≤ G.sup fun t => (DFinsupp.support t).sup id :=
      Finset.le_sup (f := fun t => (DFinsupp.support t).sup id) ht
    omega
  rw [hsmul, hq, map_add, map_sum, LinearMap.add_apply, LinearMap.sum_apply, map_add, hψC,
    map_smul, ht0, smul_zero, zero_add, map_sum]
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [map_mul, hψX, Module.End.mul_apply, hsh, component_succ_shift]
  -- The degree-`n` component of an element of `K` lies in the kernel of the last map.
  have hzK : ∀ k, DirectSum.component R ℕ M n (ψ (q k) t) ∈
      LinearMap.ker (τ (Fin.last r) n) := fun k => by
    rw [LinearMap.mem_ker, ← component_succ_shift]
    have : ψ (q k) t ∈ K := by rw [← hsmul]; exact K.smul_mem _ htK
    exact (congrArg _ this).trans (map_zero _)
  induction i using Fin.lastCases with
  | last =>
    rw [LinearMap.mem_ker.1 (hzK (Fin.last r))]
    exact Submodule.zero_mem _
  | cast j => exact Submodule.mem_iSup_of_mem j ⟨_, hzK j.castSucc, rfl⟩

end Stacks.CommutingFamilyAlgebra

end
