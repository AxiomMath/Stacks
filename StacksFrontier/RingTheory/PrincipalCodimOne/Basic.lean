module

public import Mathlib.RingTheory.Ideal.UFD
public import Mathlib.RingTheory.Lasker
public import Mathlib.RingTheory.UniqueFactorizationDomain.GCDMonoid
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Unmixed ideals of height one in a unique factorization domain are principal

Let `R` be a Noetherian unique factorization domain and let `I ⊆ R` be an ideal all of whose
associated primes have height one.  This file proves that `I` is principal.

This is the algebraic content of the statement that a closed subscheme of projective space over
a Noetherian UFD which has no embedded points and all of whose irreducible components have
codimension one is cut out by a single equation: "no embedded points" says that every associated
prime of the defining ideal is minimal, and "every component has codimension one" says that
every minimal prime has height one, so together the hypothesis of
`Stacks.RingTheory.PrincipalCodimOne.isPrincipal_of_forall_associatedPrimes_height_eq_one`
holds.  Mathlib's `UniqueFactorizationMonoid.isPrincipal_of_height_eq_one` is the special case in
which `I` is itself prime; the content here is the passage from a prime to an arbitrary unmixed
ideal, which is where the primary decomposition is used.

The argument is the usual one.  Take a minimal primary decomposition `I = ⨅ q` (Lasker--Noether,
available in Mathlib as `Submodule.isLasker`).  By the first uniqueness theorem the radicals of
the components are exactly the associated primes of `I`, so each `√q` has height one and is
therefore principal, generated by a prime element `π`.  A `π`-primary ideal is a power `(π ^ n)`:
splitting off the largest power of `π` from an element of `q` and using primarity shows that the
minimal `n` with `π ^ n ∈ q` generates.  Finally a finite intersection of principal ideals in a
UFD is principal, because `(a) ⊓ (b) = (lcm a b)`.

## Main results

* `Stacks.RingTheory.PrincipalCodimOne.inf_span_singleton`: in a GCD monoid,
  `(a) ⊓ (b) = (lcm a b)`.
* `Stacks.RingTheory.PrincipalCodimOne.isPrincipal_finsetInf`: a finite infimum of principal
  ideals of a UFD is principal.
* `Stacks.RingTheory.PrincipalCodimOne.IsPrimary.isPrincipal_of_radical_eq_span_singleton`:
  a primary ideal whose radical is generated by a prime element is a power of that element.
* `Stacks.RingTheory.PrincipalCodimOne.isPrincipal_of_forall_associatedPrimes_height_eq_one`:
  an ideal of a Noetherian UFD all of whose associated primes have height one is principal.
* `Stacks.RingTheory.PrincipalCodimOne.associatedPrimes_eq_singleton_of_isPrime`: the associated
  primes of a prime ideal are exactly that ideal.
* `Stacks.RingTheory.PrincipalCodimOne.isPrincipal_of_isPrime_of_height_eq_one`: the resulting
  recovery of `UniqueFactorizationMonoid.isPrincipal_of_height_eq_one`, which also shows the
  hypothesis of the preceding theorem is satisfiable.

## Implementation notes

The hypothesis is phrased with `Submodule.associatedPrimes I`, the set of primes of the form
`√(I : x)` for `x : R`, which is the notion the Lasker--Noether API in Mathlib is stated for.

## References

* [Stacks Project, Tag 0AFT](https://stacks.math.columbia.edu/tag/0AFT)
* [Stacks Project, Tag 0BXL](https://stacks.math.columbia.edu/tag/0BXL)
-/

@[expose] public section

namespace Stacks.RingTheory.PrincipalCodimOne

variable {R : Type*} [CommRing R]

/-- In a GCD monoid the intersection of two principal ideals is generated by the least common
multiple of the generators. -/
theorem inf_span_singleton [IsDomain R] [GCDMonoid R] (a b : R) :
    (Ideal.span {a} ⊓ Ideal.span {b} : Ideal R) = Ideal.span {lcm a b} := by
  ext x
  simp [Submodule.mem_inf, Ideal.mem_span_singleton, lcm_dvd_iff]

/-- A finite infimum of principal ideals of a unique factorization domain is principal. -/
theorem isPrincipal_finsetInf [IsDomain R] [UniqueFactorizationMonoid R]
    (t : Finset (Ideal R)) (h : ∀ q ∈ t, q.IsPrincipal) :
    (t.inf id).IsPrincipal := by
  classical
  let _ := UniqueFactorizationMonoid.toGCDMonoid R
  induction t using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert q t hq ih =>
    obtain ⟨a, ha⟩ := h q (Finset.mem_insert_self q t)
    obtain ⟨b, hb⟩ := ih fun r hr => h r (Finset.mem_insert_of_mem hr)
    refine ⟨lcm a b, ?_⟩
    rw [Finset.inf_insert, id_eq, ha, hb]
    exact inf_span_singleton a b

/-- A primary ideal whose radical is generated by a prime element `π` is the ideal generated by
the least power of `π` that it contains; in particular it is principal. -/
theorem IsPrimary.isPrincipal_of_radical_eq_span_singleton [IsDomain R]
    [UniqueFactorizationMonoid R] {q : Ideal R} (hq : q.IsPrimary) {π : R} (hπ : Prime π)
    (hrad : q.radical = Ideal.span {π}) : q.IsPrincipal := by
  classical
  have hmem : π ∈ q.radical := by
    rw [hrad]
    exact Ideal.mem_span_singleton_self π
  have hex : ∃ m : ℕ, π ^ m ∈ q := hmem
  set n := Nat.find hex
  refine ⟨π ^ n, le_antisymm ?_ ?_⟩
  · -- `q ≤ (π ^ n)`
    intro a ha
    rcases eq_or_ne a 0 with rfl | ha0
    · simp
    obtain ⟨k, c, hc, hak⟩ := WfDvdMonoid.max_power_factor ha0 hπ.irreducible
    have hcrad : c ∉ q.radical := by rwa [hrad, Ideal.mem_span_singleton]
    have hpk : π ^ k ∈ q :=
      ((Ideal.isPrimary_iff.mp hq).2 (hak ▸ ha : π ^ k * c ∈ q)).resolve_right hcrad
    rw [Ideal.mem_span_singleton]
    exact hak ▸ (pow_dvd_pow π (Nat.find_min' hex hpk)).mul_right c
  · -- `(π ^ n) ≤ q`
    rw [Ideal.span_singleton_le_iff_mem]
    exact Nat.find_spec hex

/-- **Stacks 0BXL, algebraic core.** Let `R` be a Noetherian unique factorization domain and let
`I ⊆ R` be an ideal all of whose associated primes have height one.  Then `I` is principal.

This generalizes `UniqueFactorizationMonoid.isPrincipal_of_height_eq_one`, which is the case of a
prime ideal, to an arbitrary unmixed ideal of height one. -/
@[ega "IV 21.12.9" "special case", ega "IV 21.7.7" "Direction"]
theorem isPrincipal_of_forall_associatedPrimes_height_eq_one [IsDomain R] [IsNoetherianRing R]
    [UniqueFactorizationMonoid R] {I : Ideal R}
    (h : ∀ p ∈ Submodule.associatedPrimes I, p.height = 1) : I.IsPrincipal := by
  classical
  obtain ⟨t, ht⟩ :=
    Submodule.IsLasker.exists_isMinimalPrimaryDecomposition (Submodule.isLasker R R) I
  rw [← ht.inf_eq]
  refine isPrincipal_finsetInf t fun q hq => ?_
  have hqp : q.IsPrimary := ht.primary hq
  have hradmem : q.radical ∈ Submodule.associatedPrimes I := by
    simpa [Submodule.colon_univ] using ht.mem_associatedPrimes hq
  have hprime : q.radical.IsPrime := Ideal.isPrime_radical hqp
  have hheight : q.radical.height = 1 := h _ hradmem
  obtain ⟨π, hπ⟩ := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hheight
  have hπ' : q.radical = Ideal.span {π} := by simpa using hπ
  have hπ0 : π ≠ 0 := by
    rintro rfl
    exact Ideal.ne_bot_of_height_eq_one hheight (by simpa using hπ')
  exact IsPrimary.isPrincipal_of_radical_eq_span_singleton hqp
    ((Ideal.span_singleton_prime hπ0).mp (hπ' ▸ hprime)) hπ'

/-- The only associated prime of a prime ideal is itself: `√(p : x)` is `p` when `x ∉ p` and is
`⊤`, hence not prime, when `x ∈ p`. -/
theorem associatedPrimes_eq_singleton_of_isPrime (p : Ideal R) [hp : p.IsPrime] :
    Submodule.associatedPrimes p = {p} := by
  have key : ∀ x : R, x ∉ p → (Submodule.colon p {x}).radical = p := by
    intro x hx
    convert hp.radical
    ext y
    simp only [Submodule.mem_colon_singleton, smul_eq_mul]
    exact ⟨fun h => (hp.mem_or_mem h).resolve_right hx, fun h => p.mul_mem_right _ h⟩
  have top : ∀ x : R, x ∈ p → Submodule.colon p {x} = ⊤ := by
    intro x hx
    rw [eq_top_iff]
    intro y _
    simpa [Submodule.mem_colon_singleton] using p.mul_mem_left y hx
  ext q
  simp only [Set.mem_singleton_iff, Submodule.AssociatePrimes.mem_iff]
  constructor
  · rintro ⟨hq, x, rfl⟩
    by_cases hx : x ∈ p
    · rw [top x hx] at hq
      exact absurd (Ideal.radical_top R) hq.ne_top'
    · exact key x hx
  · rintro rfl
    exact ⟨hp, 1, (key 1 hp.one_notMem).symm⟩

/-- `isPrincipal_of_forall_associatedPrimes_height_eq_one` recovers
`UniqueFactorizationMonoid.isPrincipal_of_height_eq_one` when the ideal is prime; in particular
its hypothesis is satisfiable. -/
@[ega "IV 21.12.9" "special case"]
theorem isPrincipal_of_isPrime_of_height_eq_one [IsDomain R] [IsNoetherianRing R]
    [UniqueFactorizationMonoid R] (p : Ideal R) [p.IsPrime] (hp : p.height = 1) :
    p.IsPrincipal :=
  isPrincipal_of_forall_associatedPrimes_height_eq_one <| by
    rw [associatedPrimes_eq_singleton_of_isPrime p]
    rintro q rfl
    exact hp

end Stacks.RingTheory.PrincipalCodimOne

end
