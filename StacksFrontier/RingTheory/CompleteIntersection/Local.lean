open IsLocalRing RingTheory.Sequence TensorProduct

namespace LocalCompleteIntersections

variable {A B : Type*} [CommRing A] [CommRing B]

/-- Alias of `Stacks.CohenMacaulay.PolynomialAlgebra.isMaximalCohenMacaulay_self_congr`. -/
private alias isMaximalCohenMacaulay_self_congr :=
  Stacks.CohenMacaulay.PolynomialAlgebra.isMaximalCohenMacaulay_self_congr

end LocalCompleteIntersections

/-- The ideal generated by a regular sequence is proper. -/
theorem RingTheory.Sequence.IsRegular.ofList_ne_top {T : Type*} [CommRing T] {l : List T}
    (h : IsRegular T l) : Ideal.ofList l ≠ ⊤ := fun htop ↦
  h.top_ne_smul (by rw [htop, Submodule.top_smul])

/-- The quotient of a local ring by a proper ideal is local. -/
private theorem isLocalRing_quotient_of_ne_top {T : Type*} [CommRing T] [IsLocalRing T]
    {I : Ideal T} (hI : I ≠ ⊤) : IsLocalRing (T ⧸ I) :=
  haveI := Ideal.Quotient.nontrivial_iff.mpr hI
  .of_surjective' _ Ideal.Quotient.mk_surjective

/-- Krull's height theorem for a proper ideal `I` of a Noetherian local ring `T`, with the
dimensions of `T` and `T/I` written as natural numbers. -/
private theorem exists_natCast_ringKrullDim_le_add_spanFinrank {T : Type*} [CommRing T]
    [IsLocalRing T] [IsNoetherianRing T] {I : Ideal T} (hI : I ≠ ⊤) :
    ∃ d e : ℕ, ringKrullDim T = d ∧ ringKrullDim (T ⧸ I) = e ∧ d ≤ e + I.spanFinrank := by
  have := isLocalRing_quotient_of_ne_top hI
  obtain ⟨d, hd⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim T
  obtain ⟨e, he⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim (T ⧸ I)
  have h := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank I
    ((le_maximalIdeal hI).trans ((maximalIdeal_le_jacobson ⊥).trans_eq Ideal.jacobson_bot))
  rw [hd, he] at h
  exact ⟨d, e, hd, he, by exact_mod_cast h⟩

/-- In a Noetherian local ring, a regular sequence is at most as long as the minimal number of
generators of the ideal it generates. -/
theorem RingTheory.Sequence.IsRegular.length_le_spanFinrank_ofList {T : Type*} [CommRing T]
    [IsLocalRing T] [IsNoetherianRing T] {l : List T} (h : IsRegular T l) :
    l.length ≤ (Ideal.ofList l).spanFinrank := by
  have := isLocalRing_quotient_of_ne_top h.ofList_ne_top
  obtain ⟨d, e, hd, he, h₂⟩ := exists_natCast_ringKrullDim_le_add_spanFinrank h.ofList_ne_top
  have h₁ := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular l h
  rw [hd, he] at h₁
  have h₁' : e + l.length = d := by exact_mod_cast h₁
  omega

/-- A list generating the image of an ideal under a surjective ring map lifts to a list of
elements of the ideal. -/
theorem Ideal.exists_forall_mem_map_eq_of_ofList_eq_map {S T : Type*} [CommRing S] [CommRing T]
    {f : S →+* T} (hf : Function.Surjective f) {J : Ideal S} {l : List T}
    (hl : Ideal.ofList l = J.map f) : ∃ ls : List S, (∀ x ∈ ls, x ∈ J) ∧ ls.map f = l := by
  have hmem : ∀ x ∈ l, ∃ y ∈ J, f y = x := fun x hx ↦
    (Ideal.mem_map_iff_of_surjective f hf).1 (hl ▸ Ideal.subset_span hx)
  choose! g hg using hmem
  refine ⟨l.map g, fun y hy ↦ ?_, ?_⟩
  · obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hy
    exact (hg x hx).1
  · rw [List.map_map]
    conv_rhs => rw [← List.map_id l]
    exact List.map_congr_left fun x hx ↦ (hg x hx).2

/-- If `X` generates `J` and every element of `X` outside `F` vanishes modulo `m`, then the image
of `J` modulo `m` is generated by the image of `X ∩ F`. -/
theorem Ideal.map_mk_eq_span_image_inter {S : Type*} [CommRing S] {m J : Ideal S} {X F : Set S}
    (hX : Submodule.span S X = J) (hXF : ∀ x ∈ X \ F, Ideal.Quotient.mk m x = 0) :
    J.map (Ideal.Quotient.mk m) = Ideal.span (Ideal.Quotient.mk m '' (X ∩ F)) := by
  refine le_antisymm ?_ (Ideal.span_le.2 ?_)
  · rw [Ideal.map_le_iff_le_comap, ← hX]
    refine Submodule.span_le.2 fun x hx ↦ ?_
    by_cases hxF : x ∈ F
    · exact Ideal.subset_span ⟨x, ⟨hx, hxF⟩, rfl⟩
    · rw [SetLike.mem_coe, Ideal.mem_comap, hXF x ⟨hx, hxF⟩]
      exact zero_mem _
  · rintro _ ⟨x, hx, rfl⟩
    exact Ideal.mem_map_of_mem _ (hX ▸ Submodule.subset_span hx.1)

/-- A ring map out of a local ring is local as soon as the image of the maximal ideal is proper. -/
theorem IsLocalRing.isLocalHom_of_map_maximalIdeal_ne_top {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] {f : R →+* S} (h : (maximalIdeal R).map f ≠ ⊤) : IsLocalHom f :=
  ⟨fun r hr ↦ by
    by_contra h'
    exact h (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ ((mem_maximalIdeal r).2 h')) hr)⟩

/-- Over a local ring, every family spanning a finite module has a subfamily of at most
`spanFinrank` members which still spans. -/
theorem IsLocalRing.exists_subset_span_eq_top_ncard_le {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] {N : Submodule R M} (hN : N.FG) {ι : Type*} (v : ι → N)
    (hv : Submodule.span R (Set.range v) = ⊤) :
    ∃ s : Set ι, Submodule.span R (v '' s) = ⊤ ∧ s.ncard ≤ N.spanFinrank := by
  have : Module.Finite R N := Module.Finite.iff_fg.mpr hN
  have := (map_tensorProduct_mk_eq_top (N := Submodule.span R (Set.range v))).mpr hv
  rw [← Submodule.span_image, ← Set.range_comp, eq_top_iff, ← SetLike.coe_subset_coe,
    Submodule.top_coe] at this
  have hsp : Submodule.span (ResidueField R)
      (Set.range (TensorProduct.mk R (ResidueField R) N 1 ∘ v)) = ⊤ :=
    eq_top_iff.2 (this.trans (Submodule.span_subset_span _ _ _))
  obtain ⟨κ, a, ha, hsp', hli⟩ := exists_linearIndependent' (ResidueField R)
    (TensorProduct.mk R (ResidueField R) N 1 ∘ v)
  rw [hsp] at hsp'
  let b := Module.Basis.mk hli hsp'.ge
  have : Finite κ := Module.Finite.finite_basis b
  refine ⟨Set.range a, ?_, ?_⟩
  · rw [← Set.range_comp]
    exact span_eq_top_of_tmul_eq_basis (v ∘ a) b (fun i ↦ by simp [b])
  · rw [Set.ncard_range_of_injective ha, ← Module.finrank_eq_nat_card_basis b,
      Module.finrank_eq_spanFinrank_of_free,
      TensorProduct.spanFinrank_top_eq_of_residueField _ hN]

/-- Over a local ring, every set generating a finitely generated submodule contains a generating
subset of at most `spanFinrank` elements. -/
theorem IsLocalRing.exists_subset_span_eq_ncard_le {R M : Type*} [CommRing R] [IsLocalRing R]
    [AddCommGroup M] [Module R M] {N : Submodule R M} (hN : N.FG) {X : Set M}
    (hX : Submodule.span R X = N) :
    ∃ X' ⊆ X, Submodule.span R X' = N ∧ X'.ncard ≤ N.spanFinrank := by
  have hXN : X ⊆ N := hX ▸ Submodule.subset_span
  let v : X → N := fun x ↦ ⟨x, hXN x.2⟩
  have hv : Submodule.span R (Set.range v) = ⊤ := by
    apply Submodule.map_injective_of_injective N.injective_subtype
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
    convert hX
    ext x
    simp [v]
  obtain ⟨s, hs, hcard⟩ := IsLocalRing.exists_subset_span_eq_top_ncard_le hN v hv
  refine ⟨Subtype.val '' s, by simp, ?_, ?_⟩
  · have := congrArg (Submodule.map N.subtype) hs
    rwa [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.image_comp] at this
  · rwa [Set.ncard_image_of_injective _ Subtype.val_injective]

open LocalCompleteIntersections in
/-- **A complete intersection over a field is a Cohen–Macaulay local ring.** Writing the ring as
`R/(f_1, …, f_c)` with `R` regular local and `f_1, …, f_c` a regular sequence, `R` is
Cohen–Macaulay (Lemma 00NQ) and the quotient of a Cohen–Macaulay local ring by a regular sequence
is again Cohen–Macaulay (Proposition 02JN). -/
@[stacks 00SB "The pointwise half of the lemma: Cohen-Macaulayness of a single complete
intersection local ring over `k`, stated as `Module.IsMaximalCohenMacaulay` over itself as in
00ND.", ega "0 17.1.3" "Cohen–Macaulay"]
theorem IsCompleteIntersection.isMaximalCohenMacaulay {k : Type*} [Field k] {A : Type*}
    [CommRing A] [IsNoetherianRing A] [IsLocalRing A] [Algebra k A]
    (h : IsCompleteIntersection k A) : Module.IsMaximalCohenMacaulay A A := by
  obtain ⟨R, _, _, _, _, fs, hfs, ⟨e⟩⟩ := h
  have hR : Module.IsMaximalCohenMacaulay R R :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay R).2
  have hmem : ∀ x ∈ fs, x ∈ maximalIdeal R := fun x hx ↦
    IsLocalRing.le_maximalIdeal hfs.ofList_ne_top (Ideal.subset_span hx)
  obtain ⟨_, hCM, -⟩ :=
    ((hR.isRegular_iff_ringKrullDim_add_length_eq_ringKrullDim fs hmem).2 hfs).2 fs.length le_rfl
  exact (isMaximalCohenMacaulay_self_congr
    (e.toRingEquiv.trans (Ideal.quotEquivOfEq (by rw [List.take_length])))).mpr hCM

/-- **A local complete intersection over a field is Cohen–Macaulay.** Let `k` be a field and let
`S` be a local complete intersection over `k`. Then every local ring `S_𝔮` of `S` at a prime is a
Cohen–Macaulay local ring, `depth(S_𝔮) = dim(S_𝔮)`. -/
@[stacks 00SB "Cohen-Macaulayness of the Noetherian ring `S` (Definition 00NC) is spelled out as a
condition on its localizations at primes, each being `Module.IsMaximalCohenMacaulay` over itself,
as in 00ND. The finite type hypothesis is omitted, being a consequence of
`IsLocalCompleteIntersection`. See the module docstring."]
theorem IsLocalCompleteIntersection.isMaximalCohenMacaulay_localization
    {k : Type*} [Field k] {S : Type*} [CommRing S] [Algebra k S]
    (h : IsLocalCompleteIntersection k S) (q : Ideal S) [q.IsPrime] :
    Module.IsMaximalCohenMacaulay (Localization.AtPrime q) (Localization.AtPrime q) := by
  have : Algebra.FiniteType k S := by
    obtain ⟨s, hs, hg⟩ := h
    exact Algebra.FiniteType.of_span_eq_top_target s hs fun g hgs ↦
      (hg g hgs).finiteType
  have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing k S
  have : IsNoetherianRing (Localization.AtPrime q) :=
    IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
  have key := (IsLocalCompleteIntersection.tfae k S).out 1 2
  exact (key.mp h q (Localization.AtPrime q)).isMaximalCohenMacaulay

/-- In a commutative square with `R → A` a surjection of local rings, the maximal ideals of `A`
and of `R` generate the same ideal of `B`. -/
theorem IsLocalRing.map_maximalIdeal_algebraMap_eq_of_surjective {R S A B : Type*} [CommRing R]
    [CommRing S] [CommRing A] [CommRing B] [Algebra R S] [Algebra R A] [Algebra A B]
    [Algebra S B] [Algebra R B] [IsScalarTower R A B] [IsScalarTower R S B] [IsLocalRing R]
    [IsLocalRing A] (hA : Function.Surjective (algebraMap R A)) :
    (maximalIdeal A).map (algebraMap A B) =
      ((maximalIdeal R).map (algebraMap R S)).map (algebraMap S B) := by
  rw [← map_maximalIdeal_of_surjective _ hA, Ideal.map_map, Ideal.map_map,
    ← IsScalarTower.algebraMap_eq, ← IsScalarTower.algebraMap_eq]

/-- The closed fibre of `S → B` over `A`, for `B = S/J`, is the quotient of the closed fibre
`S/𝔪S` by the image of `J`. -/
theorem ringKrullDim_quotient_map_eq_of_surjective {S B : Type*} [CommRing S] [CommRing B]
    {f : S →+* B} (hf : Function.Surjective f) (m : Ideal S) {L : Ideal (S ⧸ m)}
    (hL : L = (RingHom.ker f).map (Ideal.Quotient.mk m)) :
    ringKrullDim (B ⧸ m.map f) = ringKrullDim ((S ⧸ m) ⧸ L) := by
  set ψ₁ := (Ideal.Quotient.mk (m.map f)).comp f
  set ψ₂ := (Ideal.Quotient.mk L).comp (Ideal.Quotient.mk m)
  have hψ₁ : Function.Surjective ψ₁ := Ideal.Quotient.mk_surjective.comp hf
  have hψ₂ : Function.Surjective ψ₂ :=
    Ideal.Quotient.mk_surjective.comp Ideal.Quotient.mk_surjective
  have hker : RingHom.ker ψ₁ = RingHom.ker ψ₂ := by
    rw [← RingHom.comap_ker, ← RingHom.comap_ker, Ideal.mk_ker, Ideal.mk_ker, hL,
      Ideal.comap_map_of_surjective' _ hf, Ideal.comap_map_of_surjective' _
        Ideal.Quotient.mk_surjective, Ideal.mk_ker, sup_comm]
  exact ringKrullDim_eq_of_ringEquiv (((RingHom.quotientKerEquivOfSurjective hψ₁).symm.trans
    (Ideal.quotEquivOfEq hker)).trans (RingHom.quotientKerEquivOfSurjective hψ₂))

open Module.Flat in
/-- **Lemma 00ME for local algebras.** Let `B` be flat over the local ring `A` and `T` a
Noetherian local `A`-algebra. An `A`-algebra map `u : T → B` with `u⁻¹(𝔪_A B) ⊆ 𝔪_A T` is
injective. -/
theorem IsLocalRing.injective_of_comap_map_maximalIdeal_le {A T B : Type*} [CommRing A]
    [CommRing T] [CommRing B] [Algebra A T] [Algebra A B] [IsLocalRing A] [IsLocalRing T]
    [IsNoetherianRing T] [IsLocalHom (algebraMap A T)] [Module.Flat A B] (u : T →ₐ[A] B)
    (hu : ((maximalIdeal A).map (algebraMap A B)).comap u ≤
      (maximalIdeal A).map (algebraMap A T)) :
    Function.Injective u := by
  refine (injective_and_flat_quotient_range_of_injective_mapQ_maximalIdeal_of_isNoetherianRing
      (R := A) (S := T) (N := T) (M := B) u.toLinearMap ?_).1
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro x hx
  obtain ⟨t, rfl⟩ := Submodule.mkQ_surjective _ x
  rw [LinearMap.mem_ker, Submodule.mkQ_apply, Submodule.mapQ_apply,
    Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_map, Submodule.restrictScalars_mem] at hx
  rw [Submodule.mem_bot, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
  exact hu hx

/-- **Lemma 00ME in a flat square.** Let `R → S` and `A → B` be as in
`exists_isRegular_ofList_eq_ker_algebraMap_of_flat`, with `B` flat over `A`. An ideal `K` of `S`
with `IS ⊆ K ⊆ J` and `J ⊆ K + 𝔪_R S` is equal to `J`. -/
theorem IsLocalRing.ker_algebraMap_eq_of_le_sup_of_flat {R S A B : Type*} [CommRing R]
    [CommRing S] [CommRing A] [CommRing B] [Algebra R S] [Algebra R A] [Algebra A B]
    [Algebra S B] [Algebra R B] [IsScalarTower R A B] [IsScalarTower R S B] [IsLocalRing R]
    [IsLocalRing S] [IsNoetherianRing S] [IsLocalRing A] [IsLocalRing B]
    [IsLocalHom (algebraMap A B)] [Module.Flat A B]
    (hA : Function.Surjective (algebraMap R A)) (hB : Function.Surjective (algebraMap S B))
    {K : Ideal S} (hKJ : K ≤ RingHom.ker (algebraMap S B))
    (hIK : (RingHom.ker (algebraMap R A)).map (algebraMap R S) ≤ K)
    (hJK : RingHom.ker (algebraMap S B) ≤ K ⊔ (maximalIdeal R).map (algebraMap R S)) :
    RingHom.ker (algebraMap S B) = K := by
  refine le_antisymm ?_ hKJ
  have : IsLocalRing (S ⧸ K) :=
    isLocalRing_quotient_of_ne_top (ne_top_of_le_ne_top (RingHom.ker_ne_top _) hKJ)
  -- the `A`-algebra structure of `S/K`
  let g : R →+* S ⧸ K := (Ideal.Quotient.mk K).comp (algebraMap R S)
  have hg : RingHom.ker (algebraMap R A) ≤ RingHom.ker g := fun r hr ↦ by
    rw [RingHom.mem_ker, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hIK (Ideal.mem_map_of_mem _ hr)
  let φ : A →+* S ⧸ K := (algebraMap R A).liftOfSurjective hA ⟨g, hg⟩
  have hφ : ∀ r, φ (algebraMap R A r) = Ideal.Quotient.mk K (algebraMap R S r) := fun r ↦
    RingHom.liftOfRightInverse_comp_apply _ _ _ _ r
  let : Algebra A (S ⧸ K) := φ.toAlgebra
  let u₀ : S ⧸ K →+* B := Ideal.Quotient.lift K (algebraMap S B) fun s hs ↦ hKJ hs
  have hu₀φ : ∀ a, u₀ (φ a) = algebraMap A B a := fun a ↦ by
    obtain ⟨r, rfl⟩ := hA a
    rw [hφ]
    change algebraMap S B (algebraMap R S r) = _
    rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R A B]
  let u : S ⧸ K →ₐ[A] B := { u₀ with commutes' := hu₀φ }
  have : IsLocalHom (algebraMap A (S ⧸ K)) := ⟨fun a ha ↦ by
    have h := ha.map u
    rw [u.commutes] at h
    exact isUnit_of_map_unit (algebraMap A B) a h⟩
  have hmAT : (maximalIdeal A).map (algebraMap A (S ⧸ K)) =
      ((maximalIdeal R).map (algebraMap R S)).map (Ideal.Quotient.mk K) := by
    rw [← map_maximalIdeal_of_surjective _ hA, Ideal.map_map, Ideal.map_map]
    congr 1
    ext r
    exact hφ r
  have hu : Function.Injective u := injective_of_comap_map_maximalIdeal_le u fun x hx ↦ by
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [map_maximalIdeal_algebraMap_eq_of_surjective (S := S) (B := B) hA,
      Ideal.mem_comap] at hx
    rw [hmAT, Ideal.mem_quotient_iff_mem_sup]
    change algebraMap S B s ∈ _ at hx
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective' _ hB] at hx
    exact sup_le le_sup_left (hJK.trans (sup_le le_sup_right le_sup_left)) hx
  exact fun j hj ↦ Ideal.Quotient.eq_zero_iff_mem.1 (hu (by rwa [map_zero]))

/-- **Nakayama selection.** If `J = (f_1, …, f_n) + IS` in a Noetherian local `R`-algebra `S`
with `R → S` injective, then `J = (f_1, …, f_n) + (g_1, …, g_t)S` for finitely many `g_i ∈ I`,
with `t + μ(J̄) ≤ μ(J)` where `J̄` is the image of `J` modulo any ideal `m ⊇ IS`. -/
theorem IsLocalRing.exists_finite_subset_sup_span_eq_ncard_add_le {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] [IsNoetherianRing R] [IsLocalRing S] [IsNoetherianRing S]
    (hinj : Function.Injective (algebraMap R S)) {I : Ideal R} {m : Ideal S}
    (hIm : I.map (algebraMap R S) ≤ m) {J : Ideal S} (fs : List S)
    (hJ : J = Ideal.ofList fs ⊔ I.map (algebraMap R S)) :
    ∃ G : Set R, G.Finite ∧ G ⊆ I ∧ J = Ideal.ofList fs ⊔ Ideal.span (algebraMap R S '' G) ∧
      G.ncard + (J.map (Ideal.Quotient.mk m)).spanFinrank ≤ J.spanFinrank := by
  obtain ⟨T, hTfin, hTspan⟩ := Submodule.fg_def.1 (IsNoetherian.noetherian I)
  set F : Set S := {x | x ∈ fs}
  set X : Set S := F ∪ algebraMap R S '' T with hX
  have hXfin : X.Finite := (List.finite_toSet fs).union (hTfin.image _)
  have hXspan : Submodule.span S X = J := by
    rw [hX, Submodule.span_union]
    change Ideal.span F ⊔ Ideal.span (algebraMap R S '' T) = J
    rw [← Ideal.map_span, show Ideal.span T = I from hTspan, hJ]
  obtain ⟨X', hX'X, hX'span, hX'card⟩ :=
    IsLocalRing.exists_subset_span_eq_ncard_le (IsNoetherian.noetherian J) hXspan
  have hX'fin : X'.Finite := hXfin.subset hX'X
  set P' := X' ∩ F
  set Q' := X' \ F
  have hQ' : Q' ⊆ algebraMap R S '' T := fun x hx ↦ (hX'X hx.1).resolve_left hx.2
  have hQ'm : ∀ x ∈ Q', Ideal.Quotient.mk m x = 0 := fun x hx ↦ by
    obtain ⟨t, ht, rfl⟩ := hQ' hx
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hIm (Ideal.mem_map_of_mem _ (hTspan ▸ Ideal.subset_span ht))
  have hX'J : X' ⊆ J := fun x hx ↦ hX'span ▸ Submodule.subset_span hx
  have himG : algebraMap R S '' (T ∩ algebraMap R S ⁻¹' Q') = Q' :=
    (Set.image_inter_preimage _ _ _).trans (Set.inter_eq_right.2 hQ')
  refine ⟨T ∩ algebraMap R S ⁻¹' Q', hTfin.inter_of_left _,
    fun t ht ↦ hTspan ▸ Ideal.subset_span ht.1, ?_, ?_⟩
  · rw [himG]
    refine le_antisymm ?_ (sup_le (hJ ▸ le_sup_left) (Ideal.span_le.2 fun x hx ↦ hX'J hx.1))
    rw [← hX'span, ← Set.inter_union_sdiff X' F, Submodule.span_union]
    exact sup_le_sup_right (Submodule.span_mono Set.inter_subset_right) _
  · have hP'fin : P'.Finite := hX'fin.subset Set.inter_subset_left
    have h1 : (J.map (Ideal.Quotient.mk m)).spanFinrank ≤ P'.ncard := by
      rw [Ideal.map_mk_eq_span_image_inter hX'span hQ'm]
      exact (Submodule.spanFinrank_span_le_ncard_of_finite (hP'fin.image _)).trans
        (Set.ncard_image_le hP'fin)
    have h2 : (T ∩ algebraMap R S ⁻¹' Q').ncard = Q'.ncard := by
      conv_rhs => rw [← himG]
      exact (Set.ncard_image_of_injective _ hinj).symm
    have h3 : P'.ncard + Q'.ncard = X'.ncard :=
      Set.ncard_inter_add_ncard_sdiff_eq_ncard X' F hX'fin
    omega

/-- **Descent along a flat quotient.** Let `R → S` be a local homomorphism of local rings and `L`
a proper ideal of `S` with `S/L` flat over `R`. If `G ⊆ I` and `IS ⊆ L + GS`, then `I` is
generated by `G`. -/
theorem IsLocalRing.eq_span_of_map_le_sup_of_flat {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [IsLocalRing R] [IsLocalRing S] [IsLocalHom (algebraMap R S)] {L : Ideal S}
    (hL : L ≠ ⊤) [Module.Flat R (S ⧸ L)] {I : Ideal R} {G : Set R} (hGI : G ⊆ I)
    (hIG : I.map (algebraMap R S) ≤ L ⊔ Ideal.span (algebraMap R S '' G)) :
    I = Ideal.span G := by
  refine le_antisymm (fun r hr ↦ ?_) (Ideal.span_le.2 hGI)
  have : IsLocalRing (S ⧸ L) := isLocalRing_quotient_of_ne_top hL
  have : IsLocalHom (algebraMap S (S ⧸ L)) := .of_surjective _ Ideal.Quotient.mk_surjective
  have : IsLocalHom (algebraMap R (S ⧸ L)) := by
    rw [IsScalarTower.algebraMap_eq R S (S ⧸ L)]
    infer_instance
  have : Module.FaithfullyFlat R (S ⧸ L) := Module.FaithfullyFlat.of_flat_of_isLocalHom
  rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := S ⧸ L) (Ideal.span G), Ideal.mem_comap,
    IsScalarTower.algebraMap_eq R S (S ⧸ L), ← Ideal.map_map, Ideal.map_span]
  have h := Ideal.mem_map_of_mem (algebraMap S (S ⧸ L)) (hIG (Ideal.mem_map_of_mem _ hr))
  rwa [Ideal.map_sup, Ideal.Quotient.algebraMap_eq, Ideal.map_quotient_self, bot_sup_eq] at h

/-- **Krull's height theorem, as a dimension count.** Let `I = (G)` be a proper ideal of a
Noetherian local ring `R`, generated by a finite set `G`. If `dim R + a = dim (R/I) + b` and
`|G| + a ≤ b`, then `dim (R/I) + |G| = dim R`. -/
theorem IsLocalRing.ringKrullDim_quotient_add_ncard_eq_of_le {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] {I : Ideal R} (hI : I ≠ ⊤) {G : Set R}
    (hGfin : G.Finite) (hIG : I = Ideal.span G) {a b : ℕ}
    (hab : ringKrullDim R + (a : WithBot ℕ∞) = ringKrullDim (R ⧸ I) + b) (hle : G.ncard + a ≤ b) :
    ringKrullDim (R ⧸ I) + (G.ncard : WithBot ℕ∞) = ringKrullDim R := by
  obtain ⟨d, e, hd, he, h₁⟩ := exists_natCast_ringKrullDim_le_add_spanFinrank hI
  have hμ : I.spanFinrank ≤ G.ncard := by
    rw [hIG]
    exact Submodule.spanFinrank_span_le_ncard_of_finite hGfin
  rw [hd, he] at hab ⊢
  have h₂ : d + a = e + b := by exact_mod_cast hab
  exact_mod_cast (show e + G.ncard = d by omega)

/-- **Dimension count in a flat square.** In the setting of
`exists_isRegular_ofList_eq_ker_algebraMap_of_flat`, with `A` and `B` local and the maps of the
square local, if `J` is generated by a regular sequence of length `c` and its image `J̄` in
`S/𝔪_R S` by one of length `c̄`, then `dim R + c̄ = dim A + c`. -/
theorem IsLocalRing.ringKrullDim_add_length_eq_of_flat
    {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra A B] [Algebra S B] [Algebra R B]
    [IsScalarTower R A B] [IsScalarTower R S B]
    [IsLocalRing R] [IsNoetherianRing R] [IsLocalRing S] [IsNoetherianRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap A B)]
    [Module.Flat R S] [Module.Flat A B]
    (hA : Function.Surjective (algebraMap R A)) (hB : Function.Surjective (algebraMap S B))
    {rs : List S} (hrs : IsRegular S rs) (hrsJ : Ideal.ofList rs = RingHom.ker (algebraMap S B))
    {rs' : List (S ⧸ (maximalIdeal R).map (algebraMap R S))}
    (hrs' : IsRegular (S ⧸ (maximalIdeal R).map (algebraMap R S)) rs')
    (hrs'J : Ideal.ofList rs' = (RingHom.ker (algebraMap S B)).map (Ideal.Quotient.mk _)) :
    ringKrullDim R + (rs'.length : WithBot ℕ∞) = ringKrullDim A + rs.length := by
  have : IsNoetherianRing A := isNoetherianRing_of_surjective R A _ hA
  have : IsNoetherianRing B := isNoetherianRing_of_surjective S B _ hB
  have : Nontrivial ((S ⧸ (maximalIdeal R).map (algebraMap R S)) ⧸ Ideal.ofList rs') :=
    Ideal.Quotient.nontrivial_iff.mpr hrs'.ofList_ne_top
  have : Nontrivial (S ⧸ (maximalIdeal R).map (algebraMap R S)) :=
    (Ideal.Quotient.mk (Ideal.ofList rs')).domain_nontrivial
  have : IsLocalRing (S ⧸ (maximalIdeal R).map (algebraMap R S)) :=
    .of_surjective' _ Ideal.Quotient.mk_surjective
  have : IsLocalRing ((S ⧸ (maximalIdeal R).map (algebraMap R S)) ⧸ Ideal.ofList rs') :=
    isLocalRing_quotient_of_ne_top hrs'.ofList_ne_top
  obtain ⟨dR, hdR⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim R
  obtain ⟨dS, hdS⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim S
  obtain ⟨dA, hdA⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim A
  obtain ⟨dB, hdB⟩ := Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim B
  obtain ⟨dSb, hdSb⟩ :=
    Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim
      (S ⧸ (maximalIdeal R).map (algebraMap R S))
  obtain ⟨dBb, hdBb⟩ :=
    Stacks.RegularLocalRing.KernelRegularity.exists_natCast_eq_ringKrullDim
      ((S ⧸ (maximalIdeal R).map (algebraMap R S)) ⧸ Ideal.ofList rs')
  -- `dim B + c = dim S` and `dim B̄ + c̄ = dim S̄`
  have h1 : dB + rs.length = dS := by
    have h := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hrs
    rw [ringKrullDim_eq_of_ringEquiv ((Ideal.quotEquivOfEq hrsJ).trans
      (RingHom.quotientKerEquivOfSurjective hB)), hdB, hdS] at h
    exact_mod_cast h
  have h2 : dBb + rs'.length = dSb := by
    have h := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs' hrs'
    rw [hdBb, hdSb] at h
    exact_mod_cast h
  -- Lemma 00ON, twice
  have h3 : dS = dR + dSb := by
    have h : ringKrullDim S =
        ringKrullDim R + ringKrullDim (S ⧸ (maximalIdeal R).map (algebraMap R S)) :=
      ringKrullDim_eq_add_ringKrullDim_closedFibre R S inferInstance
    rw [hdS, hdR, hdSb] at h
    exact_mod_cast h
  have h4 : dB = dA + dBb := by
    have h : ringKrullDim B =
        ringKrullDim A + ringKrullDim (B ⧸ (maximalIdeal A).map (algebraMap A B)) :=
      ringKrullDim_eq_add_ringKrullDim_closedFibre A B inferInstance
    rw [map_maximalIdeal_algebraMap_eq_of_surjective (S := S) (B := B) hA,
      ringKrullDim_quotient_map_eq_of_surjective hB _ hrs'J, hdB, hdA, hdBb] at h
    exact_mod_cast h
  rw [hdR, hdA]
  exact_mod_cast (show dR + rs'.length = dA + rs.length by omega)

/-- **The dimension count of Lemma 02JP.** In the setting of
`IsLocalRing.ringKrullDim_add_length_eq_of_flat`, if `I` is generated by a finite set `G` with
`|G| + μ(J̄) ≤ μ(J)`, then `dim (R/I) + |G| = dim R`. -/
theorem IsLocalRing.ringKrullDim_quotient_ker_add_ncard_eq_of_flat
    {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra A B] [Algebra S B] [Algebra R B]
    [IsScalarTower R A B] [IsScalarTower R S B]
    [IsLocalRing R] [IsNoetherianRing R] [IsLocalRing S] [IsNoetherianRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap A B)]
    [Module.Flat R S] [Module.Flat A B]
    (hA : Function.Surjective (algebraMap R A)) (hB : Function.Surjective (algebraMap S B))
    {rs : List S} (hrs : IsRegular S rs) (hrsJ : Ideal.ofList rs = RingHom.ker (algebraMap S B))
    {rs' : List (S ⧸ (maximalIdeal R).map (algebraMap R S))}
    (hrs' : IsRegular (S ⧸ (maximalIdeal R).map (algebraMap R S)) rs')
    (hrs'J : Ideal.ofList rs' = (RingHom.ker (algebraMap S B)).map (Ideal.Quotient.mk _))
    {G : Set R} (hGfin : G.Finite) (hIG : RingHom.ker (algebraMap R A) = Ideal.span G)
    (hGcard : G.ncard + ((RingHom.ker (algebraMap S B)).map
      (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S)))).spanFinrank ≤
        (RingHom.ker (algebraMap S B)).spanFinrank) :
    ringKrullDim (R ⧸ RingHom.ker (algebraMap R A)) + (G.ncard : WithBot ℕ∞) =
      ringKrullDim R := by
  have h₁ := Stacks.RegularLocalRing.QuasiRegular.spanFinrank_ofList_le rs
  have h₂ := hrs'.length_le_spanFinrank_ofList
  rw [hrsJ] at h₁
  rw [hrs'J] at h₂
  refine ringKrullDim_quotient_add_ncard_eq_of_le (RingHom.ker_ne_top _) hGfin hIG
    (a := rs'.length) (b := rs.length) ?_ (by omega)
  rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hA)]
  exact ringKrullDim_add_length_eq_of_flat hA hB hrs hrsJ hrs' hrs'J

/-- **Generators of `I` in a flat square.** In the setting of
`IsLocalRing.ringKrullDim_add_length_eq_of_flat`, if the image `J̄` of `J` in `S/𝔪_R S` is
generated by a regular sequence, then `I` is generated by a finite set `G` with
`|G| + μ(J̄) ≤ μ(J)`. -/
theorem IsLocalRing.exists_finite_ker_algebraMap_eq_span_of_flat
    {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra A B] [Algebra S B] [Algebra R B]
    [IsScalarTower R A B] [IsScalarTower R S B]
    [IsLocalRing R] [IsNoetherianRing R] [IsLocalRing S] [IsNoetherianRing S]
    [IsLocalRing A] [IsLocalRing B] [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap A B)]
    [Module.Flat R S] [Module.Flat A B]
    (hA : Function.Surjective (algebraMap R A)) (hB : Function.Surjective (algebraMap S B))
    {rs' : List (S ⧸ (maximalIdeal R).map (algebraMap R S))}
    (hrs' : IsRegular (S ⧸ (maximalIdeal R).map (algebraMap R S)) rs')
    (hrs'J : Ideal.ofList rs' = (RingHom.ker (algebraMap S B)).map (Ideal.Quotient.mk _)) :
    ∃ G : Set R, G.Finite ∧ RingHom.ker (algebraMap R A) = Ideal.span G ∧
      G.ncard + ((RingHom.ker (algebraMap S B)).map
        (Ideal.Quotient.mk ((maximalIdeal R).map (algebraMap R S)))).spanFinrank ≤
          (RingHom.ker (algebraMap S B)).spanFinrank := by
  set mS := (maximalIdeal R).map (algebraMap R S)
  set I := RingHom.ker (algebraMap R A)
  set J := RingHom.ker (algebraMap S B) with hJdef
  have hIm : I ≤ maximalIdeal R := le_maximalIdeal (RingHom.ker_ne_top _)
  have hIJ : I.map (algebraMap R S) ≤ J := Ideal.map_le_iff_le_comap.2 fun r hr ↦ by
    rw [Ideal.mem_comap, hJdef, RingHom.mem_ker, ← IsScalarTower.algebraMap_apply,
      IsScalarTower.algebraMap_apply R A B, (RingHom.mem_ker).1 hr, map_zero]
  have : Module.FaithfullyFlat R S := Module.FaithfullyFlat.of_flat_of_isLocalHom
  -- lift the regular sequence of the fibre to `J`
  obtain ⟨fs, hfsJ, hfsmap⟩ := Ideal.exists_forall_mem_map_eq_of_ofList_eq_map
    (f := Ideal.Quotient.mk mS) Ideal.Quotient.mk_surjective hrs'J
  have hfsleJ : Ideal.ofList fs ≤ J := Ideal.span_le.2 hfsJ
  -- Lemma 00MG
  have hflat : Module.Flat R (S ⧸ Ideal.ofList fs) := by
    have := (Module.Flat.isRegular_and_flat_quotient_ofList_take_of_isRegular_maximalIdeal
      (fs := fs) (by rwa [hfsmap])).2 fs.length
    rwa [List.take_length] at this
  have hJle : J ≤ Ideal.ofList fs ⊔ mS := fun j hj ↦ by
    rw [← Ideal.mem_quotient_iff_mem_sup, Ideal.map_ofList, hfsmap, hrs'J]
    exact Ideal.mem_map_of_mem _ hj
  -- `J = (f_1, …, f_c̄) + IS`, by Lemma 00ME
  have hJeq : J = Ideal.ofList fs ⊔ I.map (algebraMap R S) :=
    ker_algebraMap_eq_of_le_sup_of_flat hA hB (sup_le hfsleJ hIJ) le_sup_right
      (hJle.trans (sup_le_sup_right le_sup_left _))
  -- Nakayama
  obtain ⟨G, hGfin, hGI, hGJ, hGcard⟩ := exists_finite_subset_sup_span_eq_ncard_add_le
    (m := mS) (FaithfulSMul.algebraMap_injective R S) (Ideal.map_mono hIm) fs hJeq
  -- faithful flatness of `S/(f_1, …, f_c̄)`
  exact ⟨G, hGfin, eq_span_of_map_le_sup_of_flat (ne_top_of_le_ne_top (RingHom.ker_ne_top _)
    hfsleJ) hGI (hIJ.trans hGJ.le), hGcard⟩

/-- **Descent of regular sequences along a flat square of local rings.** Let
```
B ← S
↑   ↑
A ← R
```
be a commutative square of rings in which `R` is a Cohen–Macaulay Noetherian local ring, `S` is
a Noetherian local ring, `A = R/I` and `B = S/J` are quotients, and `R → S` and `A → B` are flat.
If `J` is generated by a regular sequence, and the image `J̄` of `J` in `S̄ = S/𝔪_R S` is
generated by a regular sequence, then `I` is generated by a regular sequence.

The quotients are encoded by the surjectivity of `R → A` and `S → B`, the ideals `I` and `J`
being their kernels. See the module docstring. -/
@[stacks 02JP "The square is `IsScalarTower R A B` and `IsScalarTower R S B` with `R → A` and
`S → B` surjective, `I` and `J` being their kernels, and `J̄` is the image of `J` in
`S ⧸ 𝔪_R S`. Stated more generally than the source: `R` is only assumed Cohen-Macaulay
(regular local rings are, by 00NQ), and `S̄` is not assumed regular, which the argument does not
use. `S` is assumed Noetherian, as the source's appeals to 00MG and 00ME require. See the module
docstring."]
theorem exists_isRegular_ofList_eq_ker_algebraMap_of_flat
    {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
    [Algebra R S] [Algebra R A] [Algebra A B] [Algebra S B] [Algebra R B]
    [IsScalarTower R A B] [IsScalarTower R S B]
    [IsLocalRing R] [IsNoetherianRing R] [IsLocalRing S] [IsNoetherianRing S]
    [Module.Flat R S] [Module.Flat A B]
    (hR : Module.IsMaximalCohenMacaulay R R)
    (hA : Function.Surjective (algebraMap R A)) (hB : Function.Surjective (algebraMap S B))
    (hJ : ∃ rs : List S, IsRegular S rs ∧ Ideal.ofList rs = RingHom.ker (algebraMap S B))
    (hJbar : ∃ rs : List (S ⧸ (maximalIdeal R).map (algebraMap R S)),
      IsRegular (S ⧸ (maximalIdeal R).map (algebraMap R S)) rs ∧
        Ideal.ofList rs = (RingHom.ker (algebraMap S B)).map (Ideal.Quotient.mk _)) :
    ∃ rs : List R, IsRegular R rs ∧ Ideal.ofList rs = RingHom.ker (algebraMap R A) := by
  classical
  set mS := (maximalIdeal R).map (algebraMap R S)
  obtain ⟨hs, hhs, hhsJ⟩ := hJ
  obtain ⟨fbs, hfbs, hfbsJ⟩ := hJbar
  -- `A` and `B` are local, and all the maps of the square are local homomorphisms
  have hJne : RingHom.ker (algebraMap S B) ≠ ⊤ := hhsJ ▸ hhs.ofList_ne_top
  have : Nontrivial B := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    exact hJne ((Ideal.eq_top_iff_one _).2 (Subsingleton.elim _ _))
  have : IsLocalRing B := .of_surjective' _ hB
  have : Nontrivial A := (algebraMap A B).domain_nontrivial
  have : IsLocalRing A := .of_surjective' _ hA
  have : Nontrivial ((S ⧸ mS) ⧸ Ideal.ofList fbs) :=
    Ideal.Quotient.nontrivial_iff.mpr hfbs.ofList_ne_top
  have : Nontrivial (S ⧸ mS) := (Ideal.Quotient.mk (Ideal.ofList fbs)).domain_nontrivial
  have : IsLocalHom (algebraMap R S) :=
    isLocalHom_of_map_maximalIdeal_ne_top (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  have : IsLocalHom (algebraMap S B) := .of_surjective _ hB
  have : IsLocalHom (algebraMap R B) := by
    rw [IsScalarTower.algebraMap_eq R S B]
    infer_instance
  have : IsLocalHom (algebraMap A B) := ⟨fun a ha ↦ by
    obtain ⟨r, rfl⟩ := hA a
    rw [← IsScalarTower.algebraMap_apply] at ha
    exact (isUnit_of_map_unit _ _ ha).map _⟩
  obtain ⟨G, hGfin, hIG, hGcard⟩ := exists_finite_ker_algebraMap_eq_span_of_flat hA hB hfbs hfbsJ
  have hofList : Ideal.ofList hGfin.toFinset.toList = RingHom.ker (algebraMap R A) := by
    rw [hIG, Ideal.ofList]
    exact congrArg Ideal.span (Set.ext fun x ↦ by simp)
