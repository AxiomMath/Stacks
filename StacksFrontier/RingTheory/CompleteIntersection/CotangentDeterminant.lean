module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Algebra.Module.Projective.Determinant.Free
public import StacksFrontier.Homology.TwoTermComplex.DeterminantLine
public import StacksFrontier.RingTheory.CompleteIntersection.RelativeConormal

/-!
# The determinant of the naive cotangent complex of a square complete intersection

Let `P` present `B = A[x_1, …, x_n]/(f_1, …, f_n)` as a relative global complete intersection
with as many relations as variables. The naive cotangent complex of `P` is the two-term complex
`(f)/(f)² → ⨁ᵢ B dxᵢ`, and the conormal module `(f)/(f)²` is free on the classes of the
relations (Stacks 00SV (3)). In the basis of the relation classes and the basis `dxᵢ` the
differential is the Jacobian matrix `∂f_j/∂x_i`, so both terms are free of rank `n` and the
complex has rank zero. Hence its determinant line is free of rank one, generated by the
isomorphism carrying the wedge of the relation classes to the wedge of the `dxᵢ`, and the
canonical section of the determinant line is the Jacobian determinant times that generator.

## Main definitions

* `Algebra.Presentation.relationJacobiMatrix`: the Jacobian matrix of a presentation with as many
  relations as variables.
* `Algebra.Presentation.cotangentDeterminantBasis`: the determinant line of the naive cotangent
  complex, as a free module of rank one.
* `Algebra.Presentation.HasJacobianDelta`: the local Jacobian picture of the determinant of the
  naive cotangent complex, as one predicate on the presentation.

## Main results

* `Algebra.Presentation.toMatrix_cotangentComplex_eq_relationJacobiMatrix`: the differential of
  the naive cotangent complex is the Jacobian matrix.
* `Algebra.Presentation.isRankZero_cotangentComplex`: the naive cotangent complex has rank zero.
* `Algebra.Presentation.coe_cotangentDeterminantBasis_apply`: the generator of the determinant
  line carries the wedge of the relation classes to the wedge of the `dxᵢ`.
* `Algebra.Presentation.delta_cotangentComplex_eq`: the canonical section of the determinant line
  is the Jacobian determinant times the generator.
* `Algebra.Presentation.hasJacobianDelta`: the three preceding statements bundled, as the
  predicate `Algebra.Presentation.HasJacobianDelta` on the presentation.

## Implementation notes

The conormal basis is not canonical as a term, so the statements take an arbitrary basis of the
conormal module together with the hypothesis pinning its vectors to the relation classes; that
hypothesis determines the basis uniquely, and
`Algebra.Presentation.exists_basis_cotangent_relation` supplies one. The determinant line and its
canonical section are the general constructions of More on Algebra, Section 0FJI, as
`TwoTermComplex.determinantLine` and `TwoTermComplex.delta`; nothing here is special to the
complete intersection except the two bases.

## References

* [Stacks Project, Tag 0FKC](https://stacks.math.columbia.edu/tag/0FKC)
* [Stacks Project, Section 15.124 (Tag 0FJI)](https://stacks.math.columbia.edu/tag/0FJI)
-/

namespace Algebra

open MvPolynomial

universe u v

@[expose] public section

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

/-- The cotangent space of a finite family of generators is a finite module, being free on the
differentials of the generators. -/
instance Generators.finite_cotangentSpace {ι : Type*} [Finite ι] (P : Generators A B ι) :
    Module.Finite B P.toExtension.CotangentSpace :=
  Module.Finite.of_basis P.cotangentSpaceBasis

/-- The conormal module of a relative global complete intersection is free, on the classes of the
relations. -/
instance Presentation.free_cotangent {ι : Type*} [Finite ι] {c : ℕ}
    (P : Presentation A B ι (Fin c)) [P.IsRelativeGlobalCompleteIntersection] :
    Module.Free B P.toExtension.Cotangent := by
  obtain ⟨b, -⟩ := P.exists_basis_cotangent_relation
  exact Module.Free.of_basis b

/-- The conormal module of a relative global complete intersection is a finite module, being free
on the classes of the relations. -/
instance Presentation.finite_cotangent {ι : Type*} [Finite ι] {c : ℕ}
    (P : Presentation A B ι (Fin c)) [P.IsRelativeGlobalCompleteIntersection] :
    Module.Finite B P.toExtension.Cotangent := by
  obtain ⟨b, -⟩ := P.exists_basis_cotangent_relation
  exact Module.Finite.of_basis b

variable {n : ℕ} (P : Presentation A B (Fin n) (Fin n))

/-- The Jacobian matrix of a presentation with as many relations as variables: its `(i, j)` entry
is the partial derivative of the `j`-th relation by the `i`-th variable, read in the presented
algebra. -/
noncomputable def Presentation.relationJacobiMatrix : Matrix (Fin n) (Fin n) B :=
  Matrix.of fun i j ↦ aeval P.val (pderiv i (P.relation j))

/-- The `(i, j)` entry of the Jacobian matrix is the partial derivative of the `j`-th relation by
the `i`-th variable. -/
theorem Presentation.relationJacobiMatrix_apply (i j : Fin n) :
    P.relationJacobiMatrix i j = aeval P.val (pderiv i (P.relation j)) :=
  rfl

/-- In a basis of the conormal module given by the classes of the relations and the basis `dxᵢ`
of the cotangent space, the differential of the naive cotangent complex is the Jacobian matrix. -/
@[stacks 0FKC "NL_{B/A} is the two-term complex (f)/(f)^2 -> sum_i B dx_i: its differential,
in the basis of the relation classes and the basis dx_i, is the matrix df_j/dx_i"]
theorem Presentation.toMatrix_cotangentComplex_eq_relationJacobiMatrix
    (b : Module.Basis (Fin n) B P.toExtension.Cotangent)
    (hb : ∀ i, b i = Extension.Cotangent.mk ⟨P.relation i, P.relation_mem_ker i⟩) :
    LinearMap.toMatrix b P.cotangentSpaceBasis P.toExtension.cotangentComplex =
      P.relationJacobiMatrix := by
  ext i j
  rw [LinearMap.toMatrix_apply, hb j, Extension.cotangentComplex_mk,
    Generators.cotangentSpaceBasis_repr_one_tmul]
  rfl

variable [P.IsRelativeGlobalCompleteIntersection]

/-- The naive cotangent complex of a relative global complete intersection with as many relations
as variables has rank zero: both of its terms are free of rank the number of variables. -/
@[stacks 0FKC "the two terms of NL_{B/A} have equal rank, so delta(NL_{B/A}) is defined"]
theorem Presentation.isRankZero_cotangentComplex :
    TwoTermComplex.IsRankZero P.toExtension.cotangentComplex := by
  obtain ⟨b, -⟩ := P.exists_basis_cotangent_relation
  exact fun p ↦ ProjectiveDeterminant.rankAtStalk_eq_of_bases b P.cotangentSpaceBasis p

/-- The determinant line of the naive cotangent complex of a relative global complete
intersection with as many relations as variables, as a free module of rank one on the
isomorphism matching a basis of the conormal module with the basis `dxᵢ`. -/
@[stacks 0FKC "det(L_{B/A}) is free of rank one"]
noncomputable def Presentation.cotangentDeterminantBasis
    (b : Module.Basis (Fin n) B P.toExtension.Cotangent) :
    Module.Basis (Fin 1) B (TwoTermComplex.determinantLine P.toExtension.cotangentComplex) :=
  ProjectiveDeterminant.basisHom b P.cotangentSpaceBasis

/-- The generator of the determinant line of the naive cotangent complex carries the wedge of the
classes of the relations to the wedge of the `dxᵢ`. -/
@[stacks 0FKC "the generator of det(L_{B/A}) is dx_1 ^ ... ^ dx_n tensor
(f-bar_1 ^ ... ^ f-bar_n)^{tensor -1}: it carries the wedge of the relation classes to the
wedge of the dx_i"]
theorem Presentation.coe_cotangentDeterminantBasis_apply
    (b : Module.Basis (Fin n) B P.toExtension.Cotangent)
    (hb : ∀ i, b i = Extension.Cotangent.mk ⟨P.relation i, P.relation_mem_ker i⟩) (k : Fin 1)
    (x : ProjectiveDeterminant.module (R := B) (M := P.toExtension.Cotangent))
    (hx : (x : ExteriorAlgebra B P.toExtension.Cotangent) =
      ExteriorAlgebra.ιMulti B n
        fun j ↦ Extension.Cotangent.mk ⟨P.relation j, P.relation_mem_ker j⟩) :
    ((P.cotangentDeterminantBasis b k x :
        ProjectiveDeterminant.module (R := B) (M := P.toExtension.CotangentSpace)) :
          ExteriorAlgebra B P.toExtension.CotangentSpace) =
      ExteriorAlgebra.ιMulti B n P.cotangentSpaceBasis := by
  rw [Presentation.cotangentDeterminantBasis, ProjectiveDeterminant.basisHom_apply,
    LinearEquiv.coe_coe, ProjectiveDeterminant.coe_basisEquiv_apply, hx,
    ExteriorAlgebra.map_apply_ιMulti]
  congr 1
  funext j
  rw [Function.comp_apply, ← hb j]
  simp

/-- The canonical section of the determinant line of the naive cotangent complex is the Jacobian
determinant times the generator given by the classes of the relations and the `dxᵢ`. -/
@[stacks 0FKC "delta(NL_{B/A}) = det(df_j/dx_i) . dx_1 ^ ... ^ dx_n tensor
(f-bar_1 ^ ... ^ f-bar_n)^{tensor -1}. Not a tautology: `TwoTermComplex.delta` is the
pre-existing general construction `ProjectiveDeterminant.map`, defined with no reference to
any Jacobian or basis, and this computes it in the two ordered bases"]
theorem Presentation.delta_cotangentComplex_eq
    (b : Module.Basis (Fin n) B P.toExtension.Cotangent)
    (hb : ∀ i, b i = Extension.Cotangent.mk ⟨P.relation i, P.relation_mem_ker i⟩) (k : Fin 1) :
    TwoTermComplex.delta P.toExtension.cotangentComplex P.isRankZero_cotangentComplex =
      P.relationJacobiMatrix.det • P.cotangentDeterminantBasis b k := by
  rw [Presentation.cotangentDeterminantBasis, ProjectiveDeterminant.basisHom_apply]
  change ProjectiveDeterminant.map _ P.toExtension.cotangentComplex = _
  rw [ProjectiveDeterminant.map_eq_det_toMatrix_smul_basisEquiv b P.cotangentSpaceBasis,
    P.toMatrix_cotangentComplex_eq_relationJacobiMatrix b hb]

/-- The local Jacobian picture of the determinant of the naive cotangent complex: the conormal
module has a basis of relation classes in which the differential of the naive cotangent complex
is the Jacobian matrix and the canonical section of the determinant line is the Jacobian
determinant times the corresponding generator. -/
def Presentation.HasJacobianDelta : Prop :=
  ∃ b : Module.Basis (Fin n) B P.toExtension.Cotangent,
    (∀ i, b i = Extension.Cotangent.mk ⟨P.relation i, P.relation_mem_ker i⟩) ∧
    (LinearMap.toMatrix b P.cotangentSpaceBasis P.toExtension.cotangentComplex =
      P.relationJacobiMatrix) ∧
    (TwoTermComplex.delta P.toExtension.cotangentComplex P.isRankZero_cotangentComplex =
      P.relationJacobiMatrix.det • P.cotangentDeterminantBasis b 0)

/-- A relative global complete intersection presentation with as many relations as variables has
the local Jacobian picture of the determinant of its naive cotangent complex. -/
@[stacks 0FKC "the four assertions bundled for one square relative global complete
intersection presentation"]
theorem Presentation.hasJacobianDelta : P.HasJacobianDelta := by
  obtain ⟨b, hb⟩ := P.exists_basis_cotangent_relation
  exact ⟨b, hb, P.toMatrix_cotangentComplex_eq_relationJacobiMatrix b hb,
    P.delta_cotangentComplex_eq b hb 0⟩

/-! ### The conormal basis -/

-- The conormal module `(f_1, …, f_n)/(f_1, …, f_n)^2` is free on the classes of the relations.
add_to_stacks 0FKC "the conormal module (f_1, ..., f_n)/(f_1, ..., f_n)^2 is free on the \
classes f-bar_i" Algebra.Presentation.exists_basis_cotangent_relation

end

end Algebra
