module

public import StacksFrontier.RingTheory.CompleteIntersection.RingMap.Defs
public import StacksFrontier.RingTheory.Koszul.Localization
public import StacksFrontier.RingTheory.Koszul.Regular

/-!
# A presentation with weakly regular kernel makes a ring map a local complete intersection

If `R → A` is presented by `n` variables modulo an ideal generated by a weakly regular sequence,
then it is a local complete intersection homomorphism in the sense of
`RingHom.IsLocalCompleteIntersection` ([Stacks, Tag 07D0]).

A regular sequence is Koszul-regular, [Stacks, Tag 062F], and the ideal it generates is a
Koszul-regular *ideal* ([Stacks, Tag 07CV (2)]) because the localization away from `1` already
exhibits the required generators, localization being flat.

## Main results

* `RingHom.isLocalCompleteIntersection_of_isWeaklyRegular_ker`
-/

@[expose] public section

namespace RingHom

universe u v

/-- The ideal generated by a Koszul-regular sequence is a Koszul-regular ideal: the localization
away from `1` is generated by the images of the sequence, which stay Koszul-regular because
localization is flat. -/
private theorem isKoszulRegularIdeal_span_range_of_isKoszulRegular {P : Type u} [CommRing P]
    {r : ℕ} (g : Fin r → P) (hg : Koszul.IsKoszulRegular g) :
    Ideal.IsKoszulRegular (Ideal.span (Set.range g)) := by
  intro q _
  have : Module.Flat P (Localization.Away (1 : P)) :=
    IsLocalization.flat _ (Submonoid.powers (1 : P))
  refine ⟨1, q.isPrime.one_notMem, r,
    fun i ↦ algebraMap P (Localization.Away (1 : P)) (g i),
    Koszul.isKoszulRegular_map_of_flat g hg, ?_⟩
  rw [Ideal.map_span, ← Set.range_comp]
  rfl

/-- **A presentation whose kernel is generated by a weakly regular sequence makes the map a local
complete intersection.**  Let `π : R[T₀, …, Tₙ₋₁] → A` be a surjection over `f : R → A` whose
kernel is generated by a weakly regular sequence.  Then `f` is a local complete intersection
homomorphism.

Finite type is the surjectivity of `π`, and the kernel is a Koszul-regular ideal because a
regular sequence is Koszul-regular ([Stacks, Tag 062F]) and the ideal generated by a
Koszul-regular sequence is a Koszul-regular ideal. -/
theorem isLocalCompleteIntersection_of_isWeaklyRegular_ker {R A : Type u} [CommRing R]
    [CommRing A] (f : R →+* A) (n : ℕ) (π : MvPolynomial (Fin n) R →+* A)
    (hcomm : π.comp (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) = f)
    (hπ : Function.Surjective π) {xs : List (MvPolynomial (Fin n) R)}
    (hreg : RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin n) R) xs)
    (hker : RingHom.ker π = Ideal.ofList xs) :
    f.IsLocalCompleteIntersection := by
  let := f.toAlgebra
  let α : MvPolynomial (Fin n) R →ₐ[R] A :=
    { π with
      commutes' := fun r => by
        rw [RingHom.algebraMap_toAlgebra, MvPolynomial.algebraMap_eq]
        exact RingHom.congr_fun hcomm r }
  -- the sequence as a function on `Fin xs.length`
  let g : Fin xs.length → MvPolynomial (Fin n) R := fun i => xs[i]
  have hspan : Ideal.span (Set.range g) = Ideal.ofList xs := by
    refine congrArg Ideal.span (Set.ext fun x => ?_)
    rw [Set.mem_range]
    constructor
    · rintro ⟨i, rfl⟩
      exact List.getElem_mem i.isLt
    · intro hx
      obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
      exact ⟨⟨i, hi⟩, rfl⟩
  have hkoszul : Koszul.IsKoszulRegular g :=
    (Koszul.isKoszulRegularOn_self_iff g).mp
      (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular.1
        (by rwa [show List.ofFn g = xs from List.ofFn_getElem]))
  refine ⟨Algebra.FiniteType.of_surjective α hπ, n, α, hπ, ?_⟩
  rw [show α.toRingHom = π from rfl, hker, ← hspan]
  exact isKoszulRegularIdeal_span_range_of_isKoszulRegular g hkoszul

end RingHom
