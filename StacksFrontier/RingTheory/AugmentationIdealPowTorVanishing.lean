/-!
# Tor against the powers of an augmentation ideal of a polynomial ring

Let `B` be a commutative ring, `σ` a type, `T = MvPolynomial σ B` and `g : σ → B`. Write
`ε = eval₂Hom (RingHom.id B) g : T →+* B` for the evaluation at `g` and `K = RingHom.ker ε`
for the augmentation ideal of `T` at `g`. Regarding `B` as a `T`-module through `ε`, the
inclusion `K ^ (n + 1) ⊆ K ^ n` induces the zero map on `Tor_i^T(B, -)` in every degree, and
therefore so does `K ^ m ⊆ K ^ n` whenever `n < m`.

This is the translated form of the vanishing of Tag 08RE, which is the same statement for the
ideal generated by the variables, that is, for the augmentation at `g = 0`.

## Main results

* `MvPolynomial.tor_map_augmentationIdeal_pow_succ_eq_zero`: the map
  `Tor_i^T(M, K ^ (n + 1)) → Tor_i^T(M, K ^ n)` induced by the inclusion is zero, in every
  degree `i`, for every `n`, and for every module `M` on which `K` acts as zero.
* `MvPolynomial.tor_map_augmentationIdeal_pow_eq_zero_of_lt`: the map
  `Tor_i^T(M, K ^ m) → Tor_i^T(M, K ^ n)` induced by the inclusion is zero whenever `n < m`.

## Implementation notes

The augmentation ideal at `g` is carried onto the ideal of the variables by the `B`-algebra
automorphism `X s ↦ X s - C (g s)` of `T`, so the statement is the statement of Tag 08RE
transported along a ring automorphism of `T`. That transport is the bulk of the file, and it
is carried out for an arbitrary ring isomorphism `ε : R ≃+* S`, as follows.

Restriction of scalars `F = ModuleCat.restrictScalars ε` is an additive equivalence of
categories which preserves homology, hence sends a projective resolution to a projective
resolution, and the obvious map `F M ⊗[R] F N → F (M ⊗[S] N)` is an isomorphism, natural in
both variables. Vanishing of the map induced on `Tor_i(M, -)` by a morphism `f : N ⟶ N'` is
equivalent, for any chosen projective resolution `Q` of the *first* variable `M`, to vanishing
of the map induced on `H_i` by tensoring `Q` with `f`; this uses the balancing isomorphism
`Tor_iso_Tor'` together with `ProjectiveResolution.leftDerived_app_eq`, and it is an
equivalence rather than an implication, so it serves both to extract the homology statement
from Tag 08RE and to feed the transported statement back in. In between, the two tensored
complexes are identified degreewise by the monoidality isomorphism.

## References

* [Stacks Project, Tag 08RF](https://stacks.math.columbia.edu/tag/08RF)
* [Stacks Project, Tag 08RE](https://stacks.math.columbia.edu/tag/08RE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory

universe u v w

/-! ### Transport of Tor along a ring isomorphism -/

namespace StacksDraft.AugmentationTor

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

variable {R S : Type w} [CommRing R] [CommRing S]

/-- Restriction of scalars along a ring isomorphism is semilinearly the identity. -/
private def restrictEquiv (ε : R ≃+* S) (M : ModuleCat.{w} S) :
    LinearEquiv (σ' := (ε.symm : S →+* R)) (ε : R →+* S)
      ((ModuleCat.restrictScalars ε.toRingHom).obj M) M where
  toFun := id
  invFun := id
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Tensor products commute with restriction of scalars along a ring isomorphism. -/
private def restrictTensorIso (ε : R ≃+* S) (M N : ModuleCat.{w} S) :
    (ModuleCat.restrictScalars ε.toRingHom).obj M ⊗
        (ModuleCat.restrictScalars ε.toRingHom).obj N ≅
      (ModuleCat.restrictScalars ε.toRingHom).obj (M ⊗ N) := by
  let t := TensorProduct.congr (restrictEquiv ε M) (restrictEquiv ε N)
  letI : Module R (M ⊗ N : ModuleCat.{w} S) :=
    Module.compHom (M ⊗ N : ModuleCat.{w} S) ε.toRingHom
  exact LinearEquiv.toModuleIso { __ := t.toAddEquiv, map_smul' := t.map_smul' }

/-- The tensor comparison is natural in the first variable. -/
private lemma restrictTensorIso_hom_naturality_left (ε : R ≃+* S) {M M' : ModuleCat.{w} S}
    (φ : M ⟶ M') (N : ModuleCat.{w} S) :
    (restrictTensorIso ε M N).hom ≫ (ModuleCat.restrictScalars ε.toRingHom).map (φ ▷ N) =
      ((ModuleCat.restrictScalars ε.toRingHom).map φ ▷
        (ModuleCat.restrictScalars ε.toRingHom).obj N) ≫ (restrictTensorIso ε M' N).hom := by
  apply ModuleCat.hom_ext
  apply TensorProduct.ext
  ext x y
  rfl

/-- The tensor comparison is natural in the second variable. -/
private lemma restrictTensorIso_hom_naturality_right (ε : R ≃+* S) (M : ModuleCat.{w} S)
    {N N' : ModuleCat.{w} S} (f : N ⟶ N') :
    ((ModuleCat.restrictScalars ε.toRingHom).obj M ◁
          (ModuleCat.restrictScalars ε.toRingHom).map f) ≫ (restrictTensorIso ε M N').hom =
      (restrictTensorIso ε M N).hom ≫ (ModuleCat.restrictScalars ε.toRingHom).map (M ◁ f) := by
  apply ModuleCat.hom_ext
  apply TensorProduct.ext
  ext x y
  rfl

/-- A morphism conjugate to a zero morphism by isomorphisms is zero. -/
private lemma eq_zero_of_isoConj {C : Type*} [Category C] [HasZeroMorphisms C]
    {D₁ D₂ H₁ H₂ : C} (a : D₁ ≅ H₁) (b : D₂ ≅ H₂) (x : H₁ ⟶ H₂)
    (h : a.hom ≫ x ≫ b.inv = 0) : x = 0 := by
  calc x = a.inv ≫ (a.hom ≫ x ≫ b.inv) ≫ b.hom := by simp
    _ = 0 := by rw [h]; simp

/-- A natural isomorphism of functors carries a vanishing map to a vanishing map. -/
private lemma map_eq_zero_of_iso {C D : Type*} [Category C] [Category D] [HasZeroMorphisms D]
    {F G : C ⥤ D} (e : F ≅ G) {X Y : C} {f : X ⟶ Y} (h : F.map f = 0) : G.map f = 0 := by
  rw [← cancel_epi (e.hom.app X), ← e.hom.naturality f, h, zero_comp, comp_zero]

/-- Vanishing of the map induced on `Tor_i(M, -)` by `f` can be checked on any chosen
projective resolution of `M`: it is equivalent to vanishing of the map induced on `H_i` by
tensoring that resolution with `f`. -/
private lemma tor_map_eq_zero_iff (R : Type w) [CommRing R] (M N N' : ModuleCat.{w} R)
    (f : N ⟶ N') (i : ℕ) (Q : ProjectiveResolution M) :
    ((Tor (ModuleCat.{w} R) i).obj M).map f = 0 ↔
      (HomologicalComplex.homologyFunctor (ModuleCat.{w} R) (ComplexShape.down ℕ) i).map
        ((NatTrans.mapHomologicalComplex ((tensoringRight (ModuleCat.{w} R)).map f)
          (ComplexShape.down ℕ)).app Q.complex) = 0 := by
  have hflip : ((Tor (ModuleCat.{w} R) i).obj M).map f = 0 ↔
      ((Tor' (ModuleCat.{w} R) i).obj M).map f = 0 :=
    ⟨map_eq_zero_of_iso ((Tor_iso_Tor' R i).app M),
      map_eq_zero_of_iso ((Tor_iso_Tor' R i).app M).symm⟩
  have key : ((Tor' (ModuleCat.{w} R) i).obj M).map f =
      (Q.isoLeftDerivedObj ((tensoringRight (ModuleCat.{w} R)).obj N) i).hom ≫
        (HomologicalComplex.homologyFunctor (ModuleCat.{w} R) (ComplexShape.down ℕ) i).map
          ((NatTrans.mapHomologicalComplex ((tensoringRight (ModuleCat.{w} R)).map f)
            (ComplexShape.down ℕ)).app Q.complex) ≫
        (Q.isoLeftDerivedObj ((tensoringRight (ModuleCat.{w} R)).obj N') i).inv := by
    change (NatTrans.leftDerived ((tensoringRight (ModuleCat.{w} R)).map f) i).app M = _
    exact ProjectiveResolution.leftDerived_app_eq _ Q i
  rw [hflip, key]
  refine ⟨eq_zero_of_isoConj _ _ _, fun h => ?_⟩
  rw [h, zero_comp, comp_zero]
  rfl

/-- Restriction of scalars along a ring isomorphism sends a chain map inducing zero on `H_i`
to a chain map inducing zero on `H_i`. -/
private lemma homologyMap_restrictScalars_eq_zero (ε : R ≃+* S)
    {K L : ChainComplex (ModuleCat.{w} S) ℕ} (ψ : K ⟶ L) (i : ℕ)
    (h : (HomologicalComplex.homologyFunctor (ModuleCat.{w} S) (ComplexShape.down ℕ) i).map ψ
      = 0) :
    (HomologicalComplex.homologyFunctor (ModuleCat.{w} R) (ComplexShape.down ℕ) i).map
      (((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
        (ComplexShape.down ℕ)).map ψ) = 0 := by
  let F : ModuleCat.{w} S ⥤ ModuleCat.{w} R := ModuleCat.restrictScalars ε.toRingHom
  have : F.PreservesHomology := inferInstance
  have key := ShortComplex.mapHomologyIso_hom_naturality
    ((HomologicalComplex.shortComplexFunctor (ModuleCat.{w} S) (ComplexShape.down ℕ) i).map ψ) F
  have hz : ShortComplex.homologyMap
      ((HomologicalComplex.shortComplexFunctor (ModuleCat.{w} S)
        (ComplexShape.down ℕ) i).map ψ) = 0 := h
  rw [hz, F.map_zero, comp_zero] at key
  change ShortComplex.homologyMap (F.mapShortComplex.map
    ((HomologicalComplex.shortComplexFunctor (ModuleCat.{w} S)
      (ComplexShape.down ℕ) i).map ψ)) = 0
  rw [← cancel_mono ((((HomologicalComplex.shortComplexFunctor (ModuleCat.{w} S)
    (ComplexShape.down ℕ) i).obj L).mapHomologyIso F).hom), key, zero_comp]

/-- The degreewise tensor comparison, as an isomorphism of chain complexes. -/
private def restrictTensorComplexIso (ε : R ≃+* S) (K : ChainComplex (ModuleCat.{w} S) ℕ)
    (N : ModuleCat.{w} S) :
    (((tensoringRight (ModuleCat.{w} R)).obj
        ((ModuleCat.restrictScalars ε.toRingHom).obj N)).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj
        (((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj K) ≅
      ((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
        (ComplexShape.down ℕ)).obj
        ((((tensoringRight (ModuleCat.{w} S)).obj N).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj K) :=
  HomologicalComplex.Hom.isoOfComponents (fun j => restrictTensorIso ε (K.X j) N)
    (fun j j' _ => restrictTensorIso_hom_naturality_left ε (K.d j j') N)

/-- Transport of the vanishing of a Tor map along a ring isomorphism. -/
private lemma tor_map_restrictScalars_eq_zero (ε : R ≃+* S) (M N N' : ModuleCat.{w} S)
    (f : N ⟶ N') (i : ℕ) (Q : ProjectiveResolution M)
    (h : ((Tor (ModuleCat.{w} S) i).obj M).map f = 0) :
    ((Tor (ModuleCat.{w} R) i).obj ((ModuleCat.restrictScalars ε.toRingHom).obj M)).map
      ((ModuleCat.restrictScalars ε.toRingHom).map f) = 0 := by
  have h0 := (tor_map_eq_zero_iff S M N N' f i Q).mp h
  refine (tor_map_eq_zero_iff R _ _ _ ((ModuleCat.restrictScalars ε.toRingHom).map f) i
    ((ModuleCat.restrictScalars ε.toRingHom).mapProjectiveResolution Q)).mpr ?_
  have hsq : (NatTrans.mapHomologicalComplex
        ((tensoringRight (ModuleCat.{w} R)).map
          ((ModuleCat.restrictScalars ε.toRingHom).map f)) (ComplexShape.down ℕ)).app
        (((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj Q.complex) ≫
        (restrictTensorComplexIso ε Q.complex N').hom =
      (restrictTensorComplexIso ε Q.complex N).hom ≫
        ((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
          (ComplexShape.down ℕ)).map
          ((NatTrans.mapHomologicalComplex ((tensoringRight (ModuleCat.{w} S)).map f)
            (ComplexShape.down ℕ)).app Q.complex) := by
    refine HomologicalComplex.hom_ext _ _ fun j => ?_
    exact restrictTensorIso_hom_naturality_right ε (Q.complex.X j) f
  have hzero : (HomologicalComplex.homologyFunctor (ModuleCat.{w} R)
        (ComplexShape.down ℕ) i).map
      (((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
        (ComplexShape.down ℕ)).map
        ((NatTrans.mapHomologicalComplex ((tensoringRight (ModuleCat.{w} S)).map f)
          (ComplexShape.down ℕ)).app Q.complex)) = 0 :=
    homologyMap_restrictScalars_eq_zero ε _ i h0
  have : IsIso ((HomologicalComplex.homologyFunctor (ModuleCat.{w} R)
      (ComplexShape.down ℕ) i).map (restrictTensorComplexIso ε Q.complex N').hom) :=
    inferInstance
  change (HomologicalComplex.homologyFunctor (ModuleCat.{w} R) (ComplexShape.down ℕ) i).map
      ((NatTrans.mapHomologicalComplex
          ((tensoringRight (ModuleCat.{w} R)).map
            ((ModuleCat.restrictScalars ε.toRingHom).map f)) (ComplexShape.down ℕ)).app
        (((ModuleCat.restrictScalars ε.toRingHom).mapHomologicalComplex
          (ComplexShape.down ℕ)).obj Q.complex)) = 0
  rw [← cancel_mono ((HomologicalComplex.homologyFunctor (ModuleCat.{w} R)
      (ComplexShape.down ℕ) i).map (restrictTensorComplexIso ε Q.complex N').hom),
    ← Functor.map_comp, hsq, Functor.map_comp, hzero, comp_zero, zero_comp]

/-- Isomorphic data give the same vanishing of a Tor map. -/
private lemma tor_map_eq_zero_of_iso (R : Type w) [CommRing R]
    {X X' N₁ N₂ N₁' N₂' : ModuleCat.{w} R} (u : X ≅ X') (a : N₁' ≅ N₁) (b : N₂ ≅ N₂')
    (f : N₁ ⟶ N₂) (i : ℕ) (h : ((Tor (ModuleCat.{w} R) i).obj X).map f = 0) :
    ((Tor (ModuleCat.{w} R) i).obj X').map (a.hom ≫ f ≫ b.hom) = 0 := by
  have hfz : ((Tor (ModuleCat.{w} R) i).obj X').map f = 0 :=
    map_eq_zero_of_iso ((Tor (ModuleCat.{w} R) i).mapIso u) h
  rw [Functor.map_comp, Functor.map_comp, hfz, zero_comp, comp_zero]

end StacksDraft.AugmentationTor

/-! ### Translation of the variables -/

namespace MvPolynomial

variable {σ : Type v} {B : Type u} [CommRing B]

/-- The `B`-algebra automorphism of `MvPolynomial σ B` sending `X s` to `X s - C (g s)`. -/
private def translate (g : σ → B) : MvPolynomial σ B ≃ₐ[B] MvPolynomial σ B :=
  AlgEquiv.ofAlgHom (aeval fun s => X s - C (g s)) (aeval fun s => X s + C (g s))
    (by ext s; simp) (by ext s; simp)

/-- `translate g` as a ring isomorphism. -/
private def translateRingEquiv (g : σ → B) : MvPolynomial σ B ≃+* MvPolynomial σ B :=
  (translate g).toRingEquiv

private lemma translate_apply (g : σ → B) (p : MvPolynomial σ B) :
    translate g p = aeval (fun s => X s - C (g s)) p := rfl

@[simp]
private lemma translate_X (g : σ → B) (s : σ) : translate g (X s) = X s - C (g s) := by
  simp [translate_apply]

@[simp]
private lemma translateRingEquiv_apply (g : σ → B) (p : MvPolynomial σ B) :
    translateRingEquiv g p = translate g p := rfl

@[simp]
private lemma translateRingEquiv_symm_apply (g : σ → B) (p : MvPolynomial σ B) :
    (translateRingEquiv g).symm p = (translate g).symm p := rfl

/-- Evaluating at `g` after translating by `g` is evaluating at `0`. -/
private lemma eval₂Hom_translate (g : σ → B) (p : MvPolynomial σ B) :
    eval₂Hom (RingHom.id B) g (translate g p) = eval₂Hom (RingHom.id B) (0 : σ → B) p := by
  have h : (eval₂Hom (RingHom.id B) g).comp (translateRingEquiv g).toRingHom =
      eval₂Hom (RingHom.id B) (0 : σ → B) := by
    apply ringHom_ext
    · intro a
      change eval₂Hom (RingHom.id B) g (translate g (C a)) = _
      simp [translate_apply]
    · intro s
      change eval₂Hom (RingHom.id B) g (translate g (X s)) = _
      simp
  exact DFunLike.congr_fun h p

/-- Evaluating at `0` after untranslating by `g` is evaluating at `g`. -/
private lemma eval₂Hom_translate_symm (g : σ → B) (p : MvPolynomial σ B) :
    eval₂Hom (RingHom.id B) (0 : σ → B) ((translate g).symm p) =
      eval₂Hom (RingHom.id B) g p := by
  conv_rhs => rw [← AlgEquiv.apply_symm_apply (translate g) p]
  rw [eval₂Hom_translate]

/-- The augmentation ideal at `g` is generated by the elements `X s - C (g s)`. -/
private lemma span_range_X_sub_C_eq_ker (g : σ → B) :
    Ideal.span (Set.range fun s => (X s - C (g s) : MvPolynomial σ B))
      = RingHom.ker (eval₂Hom (RingHom.id B) g) := by
  refine le_antisymm (Ideal.span_le.2 ?_) fun p hp => ?_
  · rintro _ ⟨s, rfl⟩
    simp [SetLike.mem_coe, RingHom.mem_ker]
  · have key : ∀ q : MvPolynomial σ B, q - C (eval₂Hom (RingHom.id B) g q) ∈
        Ideal.span (Set.range fun s => (X s - C (g s) : MvPolynomial σ B)) := by
      intro q
      induction q using MvPolynomial.induction_on with
      | C a => simp
      | add x y hx hy =>
        have hadd : x + y - C (eval₂Hom (RingHom.id B) g (x + y))
            = (x - C (eval₂Hom (RingHom.id B) g x)) + (y - C (eval₂Hom (RingHom.id B) g y)) := by
          rw [map_add, map_add]
          ring
        rw [hadd]
        exact Ideal.add_mem _ hx hy
      | mul_X x s hx =>
        have hmul : x * X s - C (eval₂Hom (RingHom.id B) g (x * X s))
            = x * (X s - C (g s)) + (x - C (eval₂Hom (RingHom.id B) g x)) * C (g s) := by
          simp only [map_mul, eval₂Hom_X']
          ring
        rw [hmul]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨s, rfl⟩))
          (Ideal.mul_mem_right _ _ hx)
    have hp' := key p
    rwa [RingHom.mem_ker.1 hp, map_zero, sub_zero] at hp'

/-- Translation carries the ideal of the variables onto the augmentation ideal at `g`. -/
private lemma map_translate_span_range_X (g : σ → B) :
    Ideal.map (translateRingEquiv g).toRingHom
        (Ideal.span (Set.range (X : σ → MvPolynomial σ B)))
      = RingHom.ker (eval₂Hom (RingHom.id B) g) := by
  rw [Ideal.map_span, ← Set.range_comp, ← span_range_X_sub_C_eq_ker g]
  simp [Function.comp_def]

/-- Translation carries the `n`-th power of the ideal of the variables onto `K ^ n`. -/
private lemma map_translate_span_range_X_pow (g : σ → B) (n : ℕ) :
    Ideal.map (translateRingEquiv g).toRingHom
        (Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n)
      = RingHom.ker (eval₂Hom (RingHom.id B) g) ^ n := by
  rw [Ideal.map_pow, map_translate_span_range_X]

/-- Untranslation carries `K ^ n` back onto the `n`-th power of the ideal of the variables. -/
private lemma map_translate_symm_ker_pow (g : σ → B) (n : ℕ) :
    Ideal.map (translateRingEquiv g).symm.toRingHom
        (RingHom.ker (eval₂Hom (RingHom.id B) g) ^ n)
      = Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ n := by
  have hcomp : ((translateRingEquiv g).symm.toRingHom.comp
      (translateRingEquiv g).toRingHom) = RingHom.id (MvPolynomial σ B) := by
    refine RingHom.ext fun p => ?_
    simp
  rw [← map_translate_span_range_X_pow g n, Ideal.map_map, hcomp, Ideal.map_id]

/-! ### The vanishing -/

/-- **The translated form of Tag 08RE.** Let `T = MvPolynomial σ B`, let `g : σ → B` and let
`K` be the augmentation ideal of `T` at `g`, that is, the kernel of the evaluation at `g`.  For
any `T`-module on which `K` acts as zero -- equivalently, for any `B`-module regarded as a
`T`-module through the evaluation at `g` -- the inclusion `K ^ (n + 1) ⊆ K ^ n` induces the zero
map on `Tor_i^T` in every degree. -/
theorem tor_map_augmentationIdeal_pow_succ_eq_zero
    (B : Type u) [CommRing B] (σ : Type v) (g : σ → B) (i n : ℕ)
    (M : ModuleCat.{max u v} (MvPolynomial σ B))
    (hM : ∀ r ∈ RingHom.ker (eval₂Hom (RingHom.id B) g), ∀ m : M, r • m = 0) :
    ((Tor (ModuleCat.{max u v} (MvPolynomial σ B)) i).obj M).map
      (ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right (Nat.le_succ n) :
          RingHom.ker (eval₂Hom (RingHom.id B) g) ^ (n + 1) ≤
            RingHom.ker (eval₂Hom (RingHom.id B) g) ^ n))) = 0 := by
  classical
  let I₀ : Ideal (MvPolynomial σ B) := Ideal.span (Set.range (X : σ → MvPolynomial σ B))
  let Kg : Ideal (MvPolynomial σ B) := RingHom.ker (eval₂Hom (RingHom.id B) g)
  let ε : MvPolynomial σ B ≃+* MvPolynomial σ B := (translateRingEquiv g).symm
  let F : ModuleCat.{max u v} (MvPolynomial σ B) ⥤ ModuleCat.{max u v} (MvPolynomial σ B) :=
    ModuleCat.restrictScalars ε.toRingHom
  let M₀ : ModuleCat.{max u v} (MvPolynomial σ B) :=
    (ModuleCat.restrictScalars (translateRingEquiv g).toRingHom).obj M
  have hmem : ∀ (m : ℕ) (x : MvPolynomial σ B), x ∈ I₀ ^ m → translate g x ∈ Kg ^ m := by
    intro m x hx
    change translate g x ∈ RingHom.ker (eval₂Hom (RingHom.id B) g) ^ m
    rw [← map_translate_span_range_X_pow g m]
    exact Ideal.mem_map_of_mem _ hx
  have hmem' : ∀ (m : ℕ) (y : MvPolynomial σ B), y ∈ Kg ^ m → (translate g).symm y ∈ I₀ ^ m := by
    intro m y hy
    change (translate g).symm y ∈ Ideal.span (Set.range (X : σ → MvPolynomial σ B)) ^ m
    rw [← map_translate_symm_ker_pow g m]
    exact Ideal.mem_map_of_mem _ hy
  have hM₀ : ∀ r ∈ I₀, ∀ m : M₀, r • m = 0 := by
    intro r hr m
    have h1 := hmem 1 r (by rwa [pow_one])
    rw [pow_one] at h1
    exact hM (translate g r) h1 (m : M)
  have h08 : ((Tor (ModuleCat.{max u v} (MvPolynomial σ B)) i).obj M₀).map
      (ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right (Nat.le_succ n) : I₀ ^ (n + 1) ≤ I₀ ^ n))) = 0 :=
    MvPolynomial.tor_map_variableIdeal_pow_succ_eq_zero B σ i n M₀ hM₀
  have htrans := StacksDraft.AugmentationTor.tor_map_restrictScalars_eq_zero ε M₀
    (ModuleCat.of (MvPolynomial σ B) (I₀ ^ (n + 1) : Ideal (MvPolynomial σ B)))
    (ModuleCat.of (MvPolynomial σ B) (I₀ ^ n : Ideal (MvPolynomial σ B)))
    (ModuleCat.ofHom (Submodule.inclusion
      (Ideal.pow_le_pow_right (Nat.le_succ n) : I₀ ^ (n + 1) ≤ I₀ ^ n))) i
    (projectiveResolution M₀) h08
  let isoK : ∀ m : ℕ,
      F.obj (ModuleCat.of (MvPolynomial σ B) (I₀ ^ m : Ideal (MvPolynomial σ B))) ≅
        ModuleCat.of (MvPolynomial σ B) (Kg ^ m : Ideal (MvPolynomial σ B)) := fun m =>
    { hom := ModuleCat.homEquiv.symm
        { toFun := fun x => ⟨translate g x.val, hmem m x.val x.2⟩
          map_add' := fun x y => Subtype.ext (by
            change translate g (x.val + y.val) = translate g x.val + translate g y.val
            exact map_add _ _ _)
          map_smul' := fun t x => Subtype.ext (by
            change translate g ((translate g).symm t * x.val) = t * translate g x.val
            rw [map_mul, AlgEquiv.apply_symm_apply]) }
      inv := ModuleCat.homEquiv.symm
        { toFun := fun y => ⟨(translate g).symm y.val, hmem' m y.val y.2⟩
          map_add' := fun x y => Subtype.ext (by
            change (translate g).symm (x.val + y.val)
              = (translate g).symm x.val + (translate g).symm y.val
            exact map_add _ _ _)
          map_smul' := fun t y => Subtype.ext (by
            change (translate g).symm (t * y.val)
              = (translate g).symm t * (translate g).symm y.val
            exact map_mul _ _ _) }
      hom_inv_id := by
        refine ModuleCat.hom_ext (LinearMap.ext fun x => Subtype.ext ?_)
        change (translate g).symm (translate g x.val) = x.val
        rw [AlgEquiv.symm_apply_apply]
      inv_hom_id := by
        refine ModuleCat.hom_ext (LinearMap.ext fun y => Subtype.ext ?_)
        change translate g ((translate g).symm y.val) = y.val
        rw [AlgEquiv.apply_symm_apply] }
  let isoM : F.obj M₀ ≅ M :=
    ((ModuleCat.restrictScalarsEquivalenceOfRingEquiv
      (translateRingEquiv g)).unitIso.app M).symm
  have hcomp : (isoK (n + 1)).inv ≫ F.map (ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right (Nat.le_succ n) : I₀ ^ (n + 1) ≤ I₀ ^ n))) ≫ (isoK n).hom =
      ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right (Nat.le_succ n) : Kg ^ (n + 1) ≤ Kg ^ n)) := by
    refine ModuleCat.hom_ext (LinearMap.ext fun y => ?_)
    refine Subtype.ext ?_
    change translate g ((translate g).symm y.val) = y.val
    simp
  have hiso := StacksDraft.AugmentationTor.tor_map_eq_zero_of_iso (MvPolynomial σ B) isoM
    (isoK (n + 1)).symm (isoK n) (F.map (ModuleCat.ofHom (Submodule.inclusion
      (Ideal.pow_le_pow_right (Nat.le_succ n) : I₀ ^ (n + 1) ≤ I₀ ^ n)))) i htrans
  rwa [Iso.symm_hom, hcomp] at hiso

/-- **The `k`-fold form.** With `K` the augmentation ideal of `MvPolynomial σ B` at `g`, the
inclusion `K ^ m ⊆ K ^ n` induces the zero map on `Tor_i^T` in every degree whenever `n < m`,
for any module on which `K` acts as zero. -/
theorem tor_map_augmentationIdeal_pow_eq_zero_of_lt
    (B : Type u) [CommRing B] (σ : Type v) (g : σ → B) (i n m : ℕ) (hnm : n < m)
    (M : ModuleCat.{max u v} (MvPolynomial σ B))
    (hM : ∀ r ∈ RingHom.ker (eval₂Hom (RingHom.id B) g), ∀ x : M, r • x = 0) :
    ((Tor (ModuleCat.{max u v} (MvPolynomial σ B)) i).obj M).map
      (ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right hnm.le :
          RingHom.ker (eval₂Hom (RingHom.id B) g) ^ m ≤
            RingHom.ker (eval₂Hom (RingHom.id B) g) ^ n))) = 0 := by
  let Kg : Ideal (MvPolynomial σ B) := RingHom.ker (eval₂Hom (RingHom.id B) g)
  have hstep : ((Tor (ModuleCat.{max u v} (MvPolynomial σ B)) i).obj M).map
      (ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right (Nat.le_succ n) : Kg ^ (n + 1) ≤ Kg ^ n))) = 0 :=
    tor_map_augmentationIdeal_pow_succ_eq_zero B σ g i n M hM
  have hsplit : (ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right hnm.le : Kg ^ m ≤ Kg ^ n)) :
      ModuleCat.of (MvPolynomial σ B) (Kg ^ m : Ideal (MvPolynomial σ B)) ⟶
        ModuleCat.of (MvPolynomial σ B) (Kg ^ n : Ideal (MvPolynomial σ B))) =
      ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right hnm : Kg ^ m ≤ Kg ^ (n + 1))) ≫
      ModuleCat.ofHom (Submodule.inclusion
        (Ideal.pow_le_pow_right (Nat.le_succ n) : Kg ^ (n + 1) ≤ Kg ^ n)) :=
    ModuleCat.hom_ext (LinearMap.ext fun _ => rfl)
  rw [hsplit, Functor.map_comp, hstep, comp_zero]

end MvPolynomial

