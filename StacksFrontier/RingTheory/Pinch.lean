module

public import Mathlib.Order.KrullDimension
public import Mathlib.RingTheory.Ideal.GoingUp
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Noetherian.OfPrime
public import Mathlib.RingTheory.Spectrum.Prime.Basic

/-!
# The pinch of a semilocal ring at two maximal ideals

Let `B` be a commutative ring whose maximal ideals are exactly two distinct ideals `m` and `n`,
and let `φ : B ⧸ n ≃+* B ⧸ m` be an isomorphism of residue fields. The *pinch* of `B` along `φ`
is the subring

`A = {b ∈ B | b mod m = φ (b mod n)}`

obtained by identifying the two closed points of `Spec B` along `φ`. It contains the Jacobson
radical `J = m ⊓ n` of `B`, which is an ideal of both rings.

## Main results

* `Stacks.Pinch.isLocalRing_pinch`: `A` is local, with maximal ideal `J`
  (`Stacks.Pinch.maximalIdeal_pinch`).
* `Stacks.Pinch.module_finite_pinch`: `B` is a finite `A`-module, generated by `1` and an
  element `e` with `e ≡ 1 mod m`, `e ≡ 0 mod n`.
* `Stacks.Pinch.isNoetherianRing_pinch`: if `B` is Noetherian, so is `A`.
* `Stacks.Pinch.isLocalization_atPrime`: at a non-maximal prime `Q` of `B` the rings agree:
  `B_Q` is the localization of `A` at `Q ∩ A`.
* `Stacks.Pinch.exists_comap_eq`, `Stacks.Pinch.comap_le_comap_iff`: the primes of `A` other than
  the closed point are exactly the traces of the non-maximal primes of `B`, with the same order.
* `Stacks.Pinch.coheight_comap`, `Stacks.Pinch.height_comap`: hence heights and coheights of
  non-maximal primes are unchanged by pinching.
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace Stacks.Pinch

variable {B : Type u} [CommRing B] (m n : Ideal B) (φ : B ⧸ n ≃+* B ⧸ m)

/-- The pinch of `B` along `φ : B ⧸ n ≃+* B ⧸ m`: the subring of elements `b` with
`b mod m = φ (b mod n)`. -/
def pinch : Subring B :=
  (Ideal.Quotient.mk m).eqLocus ((φ : B ⧸ n →+* B ⧸ m).comp (Ideal.Quotient.mk n))

/-- Membership in the pinch. -/
theorem mem_pinch_iff {b : B} :
    b ∈ pinch m n φ ↔ Ideal.Quotient.mk m b = φ (Ideal.Quotient.mk n b) :=
  Iff.rfl

/-- The Jacobson radical `m ⊓ n` is contained in the pinch. -/
theorem mem_pinch_of_mem_inf {b : B} (hb : b ∈ m ⊓ n) : b ∈ pinch m n φ := by
  rw [mem_pinch_iff, Ideal.Quotient.eq_zero_iff_mem.2 hb.1, Ideal.Quotient.eq_zero_iff_mem.2 hb.2,
    map_zero]

variable {m n φ}

/-- An element of the pinch lies in `m` if and only if it lies in `n`. -/
theorem mem_left_iff_mem_right {b : B} (hb : b ∈ pinch m n φ) : b ∈ m ↔ b ∈ n := by
  rw [mem_pinch_iff] at hb
  rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem (I := n), hb,
    EmbeddingLike.map_eq_zero_iff]

/-- The algebra map from the pinch to `B` is the inclusion. -/
theorem algebraMap_pinch : algebraMap (pinch m n φ) B = (pinch m n φ).subtype :=
  rfl

/-- Every prime of the pinch is the trace of a prime of `B`, as `B` is integral over the pinch. -/
private theorem exists_isPrime_comap_eq [Module.Finite (pinch m n φ) B]
    (q : Ideal (pinch m n φ)) [q.IsPrime] :
    ∃ Q : Ideal B, Q.IsPrime ∧ Q.comap (pinch m n φ).subtype = q := by
  obtain ⟨Q, -, hQ, hQq⟩ := Ideal.exists_ideal_over_prime_of_isIntegral q (⊥ : Ideal B)
    (Ideal.comap_bot_le_of_injective _ Subtype.val_injective)
  exact ⟨Q, hQ, hQq⟩

variable [m.IsMaximal] [n.IsMaximal]

/-- If `m ≠ n`, there is an element `e` with `e ≡ 1 mod m` and `e ≡ 0 mod n`. -/
theorem exists_mk_eq_one_mk_eq_zero (hmn : m ≠ n) :
    ∃ e : B, Ideal.Quotient.mk m e = 1 ∧ Ideal.Quotient.mk n e = 0 := by
  obtain ⟨i, hi, j, hj, hij⟩ := Ideal.isCoprime_iff_exists.1 (Ideal.isCoprime_of_isMaximal hmn)
  refine ⟨j, ?_, Ideal.Quotient.eq_zero_iff_mem.2 hj⟩
  rw [eq_sub_of_add_eq' hij, map_sub, map_one, Ideal.Quotient.eq_zero_iff_mem.2 hi, sub_zero]

/-- If `m ≠ n`, the composite `pinch m n φ → B → B ⧸ m` is surjective. -/
theorem exists_mem_pinch_mk_eq (hmn : m ≠ n) (c : B ⧸ m) :
    ∃ a ∈ pinch m n φ, Ideal.Quotient.mk m a = c := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective c
  obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (φ.symm (Ideal.Quotient.mk m x))
  obtain ⟨e, he1, he0⟩ := exists_mk_eq_one_mk_eq_zero hmn
  exact ⟨x * e + y * (1 - e), by simp [mem_pinch_iff, he1, he0, hy], by simp [he1]⟩

/-- An element of the pinch outside `m ⊓ n` is a unit of the pinch. -/
theorem isUnit_of_notMem (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    {a : pinch m n φ} (ha : (a : B) ∉ m ⊓ n) : IsUnit a := by
  have hm : (a : B) ∉ m := fun h => ha ⟨h, (mem_left_iff_mem_right a.2).1 h⟩
  have hn : (a : B) ∉ n := fun h => ha ⟨(mem_left_iff_mem_right a.2).2 h, h⟩
  have hu : IsUnit (a : B) := by
    by_contra h
    obtain ⟨M, hM, haM⟩ := exists_max_ideal_of_mem_nonunits h
    rcases hmax M hM with rfl | rfl
    exacts [hm haM, hn haM]
  obtain ⟨u, hu⟩ := hu
  have hv : (↑u⁻¹ : B) * a = 1 := hu ▸ u.inv_mul
  have hvA : (↑u⁻¹ : B) ∈ pinch m n φ := by
    rw [mem_pinch_iff]
    refine left_inv_eq_right_inv (a := Ideal.Quotient.mk m (a : B)) ?_ ?_
    · rw [← map_mul, hv, map_one]
    · rw [(mem_pinch_iff m n φ).1 a.2, ← map_mul, ← map_mul, mul_comm (a : B), hv, map_one,
        map_one]
  exact isUnit_iff_exists_inv'.2 ⟨⟨_, hvA⟩, Subtype.ext hv⟩

/-- The non-units of the pinch are exactly its elements in `m ⊓ n`. -/
theorem mem_nonunits_pinch_iff (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    {a : pinch m n φ} : a ∈ nonunits (pinch m n φ) ↔ (a : B) ∈ m ⊓ n := by
  refine ⟨fun h => by_contra fun ha => h (isUnit_of_notMem hmax ha), fun ha hu => ?_⟩
  exact (Ideal.IsMaximal.ne_top ‹m.IsMaximal›)
    (Ideal.eq_top_of_isUnit_mem _ ha.1 (hu.map (pinch m n φ).subtype))

variable (φ) in
/-- The pinch is a local ring. -/
theorem isLocalRing_pinch (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n) :
    IsLocalRing (pinch m n φ) := by
  have : Nontrivial B := ⟨⟨0, 1, fun h => (Ideal.IsMaximal.ne_top ‹m.IsMaximal›)
    ((Ideal.eq_top_iff_one _).2 (h ▸ m.zero_mem))⟩⟩
  refine IsLocalRing.of_nonunits_add fun a b ha hb => ?_
  rw [mem_nonunits_pinch_iff hmax] at ha hb ⊢
  exact add_mem ha hb

/-- The maximal ideal of the pinch is `m ⊓ n`. -/
theorem maximalIdeal_pinch (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    [IsLocalRing (pinch m n φ)] :
    maximalIdeal (pinch m n φ) = (m ⊓ n).comap (pinch m n φ).subtype := by
  ext a
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_pinch_iff hmax, Ideal.mem_comap]
  rfl

/-- The trace on the pinch of a maximal ideal of `B` is the maximal ideal of the pinch. -/
theorem comap_eq_maximalIdeal_of_isMaximal (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    [IsLocalRing (pinch m n φ)] (Q : Ideal B) (hQ : Q.IsMaximal) :
    Q.comap (pinch m n φ).subtype = maximalIdeal (pinch m n φ) := by
  rw [maximalIdeal_pinch hmax]
  ext a
  simp only [Ideal.mem_comap, Subring.coe_subtype, Ideal.mem_inf]
  rcases hmax Q hQ with rfl | rfl
  · exact ⟨fun h => ⟨h, (mem_left_iff_mem_right a.2).1 h⟩, And.left⟩
  · exact ⟨fun h => ⟨(mem_left_iff_mem_right a.2).2 h, h⟩, And.right⟩

variable (φ) in
/-- `B` is a finite module over the pinch, generated by `1` and an element `e` with
`e ≡ 1 mod m`, `e ≡ 0 mod n`. -/
theorem module_finite_pinch (hmn : m ≠ n) : Module.Finite (pinch m n φ) B := by
  classical
  obtain ⟨e, he1, he0⟩ := exists_mk_eq_one_mk_eq_zero hmn
  refine ⟨⟨({1, e} : Finset B), eq_top_iff.2 fun b _ => ?_⟩⟩
  obtain ⟨a, ha, ha'⟩ := exists_mem_pinch_mk_eq (φ := φ) hmn (φ (Ideal.Quotient.mk n b))
  obtain ⟨a', ha2, ha2'⟩ := exists_mem_pinch_mk_eq (φ := φ) hmn
    (Ideal.Quotient.mk m b - φ (Ideal.Quotient.mk n b))
  have hna : Ideal.Quotient.mk n a = Ideal.Quotient.mk n b :=
    φ.injective (by rw [← (mem_pinch_iff m n φ).1 ha, ha'])
  have ht : b - a - a' * e ∈ pinch m n φ := by
    refine mem_pinch_of_mem_inf m n φ (Ideal.mem_inf.2 ⟨?_, ?_⟩)
    · rw [← Ideal.Quotient.eq_zero_iff_mem]
      simp [ha', ha2', he1]
    · rw [← Ideal.Quotient.eq_zero_iff_mem]
      simp [hna, he0]
  have hb : b = ((⟨b - a - a' * e, ht⟩ + ⟨a, ha⟩ : pinch m n φ) • (1 : B) +
      (⟨a', ha2⟩ : pinch m n φ) • e) := by
    show b = (b - a - a' * e + a) * 1 + a' * e
    ring
  rw [hb]
  exact add_mem (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

variable (φ) in
/-- An ideal of `B` contained in `m ⊓ n` (hence in the pinch) is finitely generated over the
pinch, when `B` is Noetherian. -/
theorem fg_comap_of_le_inf [IsNoetherianRing B] (hmn : m ≠ n) (I : Ideal B) (hI : I ≤ m ⊓ n) :
    (I.comap (pinch m n φ).subtype).FG := by
  have := module_finite_pinch φ hmn
  have h1 : (I.restrictScalars (pinch m n φ)).FG :=
    Submodule.FG.restrictScalars (IsNoetherian.noetherian I)
  refine Submodule.fg_of_fg_map_injective (Algebra.linearMap (pinch m n φ) B)
    Subtype.val_injective ?_
  convert h1 using 1
  ext b
  refine ⟨?_, fun hb => ⟨⟨b, mem_pinch_of_mem_inf m n φ (hI hb)⟩, hb, rfl⟩⟩
  rintro ⟨a, ha, rfl⟩
  exact ha

variable (φ) in
/-- If `B` is Noetherian, so is the pinch. -/
theorem isNoetherianRing_pinch [IsNoetherianRing B] (hmn : m ≠ n)
    (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n) : IsNoetherianRing (pinch m n φ) := by
  have := module_finite_pinch φ hmn
  have := isLocalRing_pinch φ hmax
  refine IsNoetherianRing.of_prime fun q hq => ?_
  obtain ⟨Q, -, hQq⟩ := exists_isPrime_comap_eq q
  have hle : q ≤ (m ⊓ n).comap (pinch m n φ).subtype := by
    rw [← maximalIdeal_pinch hmax]
    exact le_maximalIdeal hq.ne_top
  have : q = (Q ⊓ (m ⊓ n)).comap (pinch m n φ).subtype := by
    rw [Ideal.comap_inf, hQq]
    exact (inf_eq_left.2 hle).symm
  rw [this]
  exact fg_comap_of_le_inf φ hmn _ inf_le_right

variable (m n) in
/-- A non-maximal prime of `B` does not contain `m ⊓ n`. -/
theorem exists_mem_inf_notMem (Q : Ideal B) [Q.IsPrime] (hQ : ¬ Q.IsMaximal) :
    ∃ s ∈ m ⊓ n, s ∉ Q := by
  by_contra! h
  rcases (Ideal.IsPrime.inf_le ‹_›).1 h with h | h
  · exact hQ ((Ideal.IsMaximal.eq_of_le ‹m.IsMaximal› (Ideal.IsPrime.ne_top ‹_›) h) ▸ ‹_›)
  · exact hQ ((Ideal.IsMaximal.eq_of_le ‹n.IsMaximal› (Ideal.IsPrime.ne_top ‹_›) h) ▸ ‹_›)

/-- The trace on the pinch of a non-maximal prime of `B` is not the maximal ideal. -/
theorem comap_isPrime_ne_maximalIdeal (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    [IsLocalRing (pinch m n φ)] (Q : Ideal B) [Q.IsPrime] (hQ : ¬ Q.IsMaximal) :
    Q.comap (pinch m n φ).subtype ≠ maximalIdeal (pinch m n φ) := by
  obtain ⟨s, hs, hsQ⟩ := exists_mem_inf_notMem m n Q hQ
  intro h
  have : (⟨s, mem_pinch_of_mem_inf m n φ hs⟩ : pinch m n φ) ∈ maximalIdeal (pinch m n φ) := by
    rw [maximalIdeal_pinch hmax]
    exact hs
  rw [← h] at this
  exact hsQ this

variable (φ) in
/-- At a non-maximal prime `Q` of `B`, the localization `B_Q` is the localization of the pinch
at the trace of `Q`. -/
theorem isLocalization_atPrime (Q : Ideal B) [Q.IsPrime] (hQ : ¬ Q.IsMaximal) :
    IsLocalization.AtPrime (Localization.AtPrime Q) (Q.comap (pinch m n φ).subtype) := by
  obtain ⟨s, hs, hsQ⟩ := exists_mem_inf_notMem m n Q hQ
  have hsA : ∀ b : B, s * b ∈ pinch m n φ := fun b =>
    mem_pinch_of_mem_inf m n φ (Ideal.mul_mem_right b _ hs)
  have halg : ∀ a : pinch m n φ, algebraMap (pinch m n φ) (Localization.AtPrime Q) a =
      algebraMap B (Localization.AtPrime Q) a := fun a =>
    IsScalarTower.algebraMap_apply (pinch m n φ) B (Localization.AtPrime Q) a
  rw [IsLocalization.AtPrime, isLocalization_iff]
  refine ⟨fun y => ?_, fun z => ?_, fun {x y} hxy => ?_⟩
  · rw [halg]
    exact IsLocalization.map_units (Localization.AtPrime Q) (⟨y, y.2⟩ : Q.primeCompl)
  · obtain ⟨⟨b, u⟩, h⟩ := IsLocalization.surj Q.primeCompl z
    refine ⟨⟨⟨s * b, hsA b⟩, ⟨⟨s * u, hsA u⟩, ?_⟩⟩, ?_⟩
    · exact fun h' => (Ideal.IsPrime.mem_or_mem ‹_› h').elim hsQ u.2
    · simp only [halg, map_mul]
      rw [← h]
      ring
  · rw [halg, halg] at hxy
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := Q.primeCompl) hxy
    refine ⟨⟨⟨s * c, hsA c⟩, fun h' => (Ideal.IsPrime.mem_or_mem ‹_› h').elim hsQ c.2⟩, ?_⟩
    apply Subtype.ext
    simp only [Subring.coe_mul]
    rw [mul_assoc, hc, ← mul_assoc]

/-- For primes `Q, Q'` of `B` with `Q'` not maximal, the traces on the pinch compare as
`Q` and `Q'` do. -/
theorem comap_le_comap_iff (Q Q' : Ideal B) [Q'.IsPrime] (hQ' : ¬ Q'.IsMaximal) :
    Q.comap (pinch m n φ).subtype ≤ Q'.comap (pinch m n φ).subtype ↔ Q ≤ Q' := by
  refine ⟨fun h x hx => ?_, fun h => Ideal.comap_mono h⟩
  obtain ⟨s, hs, hsQ'⟩ := exists_mem_inf_notMem m n Q' hQ'
  have hsx : (⟨s * x, mem_pinch_of_mem_inf m n φ (Ideal.mul_mem_right x _ hs)⟩ :
      pinch m n φ) ∈ Q.comap (pinch m n φ).subtype :=
    Ideal.mul_mem_left Q s hx
  exact (Ideal.IsPrime.mem_or_mem ‹_› (h hsx : s * x ∈ Q')).resolve_left hsQ'

/-- If the traces of `Q` and a non-maximal prime `Q'` are strictly ordered, so are `Q` and `Q'`. -/
private theorem lt_of_comap_lt_comap {Q Q' : Ideal B} [Q'.IsPrime] (hQ' : ¬ Q'.IsMaximal)
    (h : Q.comap (pinch m n φ).subtype < Q'.comap (pinch m n φ).subtype) : Q < Q' :=
  lt_of_le_of_ne ((comap_le_comap_iff Q Q' hQ').1 h.le) fun he => h.ne (by rw [he])

variable (φ) in
/-- Taking traces on the pinch is strictly monotone on primes of `B`. -/
theorem comap_lt_comap {Q Q' : Ideal B} [Q.IsPrime] [Q'.IsPrime] (h : Q < Q') :
    Q.comap (pinch m n φ).subtype < Q'.comap (pinch m n φ).subtype := by
  have hQ : ¬ Q.IsMaximal := fun hQ => h.ne (hQ.eq_of_le (Ideal.IsPrime.ne_top ‹_›) h.le)
  exact lt_of_le_of_ne (Ideal.comap_mono h.le) fun he =>
    h.not_ge ((comap_le_comap_iff Q' Q hQ).1 he.ge)

variable (φ) in
/-- Every prime of the pinch other than its maximal ideal is the trace of a non-maximal prime
of `B`. -/
theorem exists_comap_eq (hmn : m ≠ n) (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    [IsLocalRing (pinch m n φ)] (q : Ideal (pinch m n φ)) [q.IsPrime]
    (hq : q ≠ maximalIdeal (pinch m n φ)) :
    ∃ Q : Ideal B, Q.IsPrime ∧ ¬ Q.IsMaximal ∧ Q.comap (pinch m n φ).subtype = q := by
  have := module_finite_pinch φ hmn
  obtain ⟨Q, -, hQ, hQq⟩ := Ideal.exists_ideal_over_prime_of_isIntegral q (⊥ : Ideal B)
    (Ideal.comap_bot_le_of_injective _ Subtype.val_injective)
  exact ⟨Q, hQ, fun hQm => hq (hQq.symm.trans (comap_eq_maximalIdeal_of_isMaximal hmax Q hQm)),
    hQq⟩

variable (φ) in
/-- Taking traces on the pinch, as a strictly monotone map of prime spectra. -/
def comapPrimeSpectrum (p : PrimeSpectrum B) : PrimeSpectrum (pinch m n φ) :=
  ⟨p.asIdeal.comap (pinch m n φ).subtype, inferInstance⟩

/-- Taking traces on the pinch is strictly monotone on prime spectra. -/
theorem strictMono_comapPrimeSpectrum : StrictMono (comapPrimeSpectrum (m := m) (n := n) φ) :=
  fun _ _ h => comap_lt_comap φ (show _ < _ from h)

variable (φ) in
/-- A prime of the pinch strictly above the trace of a prime `p` of `B` is the trace of a prime
strictly above `p`. -/
theorem exists_lt_comapPrimeSpectrum_eq (hmn : m ≠ n)
    (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n) (p : PrimeSpectrum B)
    (b : PrimeSpectrum (pinch m n φ)) (h : comapPrimeSpectrum φ p < b) :
    ∃ p' : PrimeSpectrum B, p < p' ∧ comapPrimeSpectrum φ p' = b := by
  have := isLocalRing_pinch φ hmax
  have h' : p.asIdeal.comap (pinch m n φ).subtype < b.asIdeal := h
  by_cases hb : b.asIdeal = maximalIdeal (pinch m n φ)
  · have hp : ¬ p.asIdeal.IsMaximal := fun hp =>
      h'.ne ((comap_eq_maximalIdeal_of_isMaximal hmax _ hp).trans hb.symm)
    obtain ⟨M, hM, hpM⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    have hlt : p.asIdeal < M := lt_of_le_of_ne hpM fun he => hp (he ▸ hM)
    exact ⟨⟨M, hM.isPrime⟩, hlt,
      PrimeSpectrum.ext ((comap_eq_maximalIdeal_of_isMaximal hmax M hM).trans hb.symm)⟩
  · obtain ⟨Q', hQ'p, hQ'm, hQ'⟩ := exists_comap_eq φ hmn hmax b.asIdeal hb
    exact ⟨⟨Q', hQ'p⟩, lt_of_comap_lt_comap (φ := φ) hQ'm (hQ' ▸ h'), PrimeSpectrum.ext hQ'⟩

/-- A prime of the pinch strictly below the trace of a non-maximal prime `p` of `B` is the trace
of a non-maximal prime strictly below `p`. -/
private theorem exists_lt_of_lt_comapPrimeSpectrum (hmn : m ≠ n)
    (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n) (p : PrimeSpectrum B)
    (hp : ¬ p.asIdeal.IsMaximal) (b : PrimeSpectrum (pinch m n φ))
    (h : b < comapPrimeSpectrum φ p) :
    ∃ p' : PrimeSpectrum B, p' < p ∧ ¬ p'.asIdeal.IsMaximal ∧ comapPrimeSpectrum φ p' = b := by
  have := isLocalRing_pinch φ hmax
  have h' : b.asIdeal < p.asIdeal.comap (pinch m n φ).subtype := h
  have hb : b.asIdeal ≠ maximalIdeal (pinch m n φ) := fun hb =>
    h'.not_ge (by rw [hb]; exact le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance))
  obtain ⟨Q', hQ'p, hQ'm, hQ'⟩ := exists_comap_eq φ hmn hmax b.asIdeal hb
  exact ⟨⟨Q', hQ'p⟩, lt_of_comap_lt_comap (φ := φ) hp (hQ' ▸ h'), hQ'm, PrimeSpectrum.ext hQ'⟩

variable (φ) in
/-- Pinching does not change coheights: the coheight of the trace on the pinch of a prime `Q`
of `B` is the coheight of `Q`. -/
theorem coheight_comap (hmn : m ≠ n) (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    (Q : Ideal B) [Q.IsPrime] :
    Order.coheight (⟨Q.comap (pinch m n φ).subtype, inferInstance⟩ :
      PrimeSpectrum (pinch m n φ)) = Order.coheight (⟨Q, inferInstance⟩ : PrimeSpectrum B) :=
  (Order.coheight_eq_of_strictMono (comapPrimeSpectrum φ) strictMono_comapPrimeSpectrum
    (exists_lt_comapPrimeSpectrum_eq φ hmn hmax) ⟨Q, inferInstance⟩).symm

variable (φ) in
/-- Pinching does not change heights of non-maximal primes: the height of the trace on the pinch
of a non-maximal prime `Q` of `B` is the height of `Q`. -/
theorem height_comap (hmn : m ≠ n) (hmax : ∀ q : Ideal B, q.IsMaximal → q = m ∨ q = n)
    (Q : Ideal B) [Q.IsPrime] (hQ : ¬ Q.IsMaximal) :
    Order.height (⟨Q.comap (pinch m n φ).subtype, inferInstance⟩ :
      PrimeSpectrum (pinch m n φ)) = Order.height (⟨Q, inferInstance⟩ : PrimeSpectrum B) := by
  let α := {p : PrimeSpectrum B // ¬ p.asIdeal.IsMaximal}
  let g : α → PrimeSpectrum (pinch m n φ) := fun p => comapPrimeSpectrum φ p.1
  have hg : StrictMono g := strictMono_comapPrimeSpectrum.comp (Subtype.strictMono_coe _)
  have h1 : Order.height (⟨⟨Q, inferInstance⟩, hQ⟩ : α) =
      Order.height (⟨Q, inferInstance⟩ : PrimeSpectrum B) := by
    refine Order.height_eq_of_strictMono Subtype.val (Subtype.strictMono_coe _)
      (fun a b hb => ?_) _
    have hb' : b.asIdeal < a.1.asIdeal := hb
    exact ⟨⟨b, fun hbm => hb'.ne (hbm.eq_of_le a.1.isPrime.ne_top hb'.le)⟩, hb, rfl⟩
  have h2 : Order.height (⟨⟨Q, inferInstance⟩, hQ⟩ : α) =
      Order.height (g ⟨⟨Q, inferInstance⟩, hQ⟩) := by
    refine Order.height_eq_of_strictMono g hg (fun p b h => ?_) _
    obtain ⟨p', hp', hp'm, rfl⟩ := exists_lt_of_lt_comapPrimeSpectrum hmn hmax p.1 p.2 b h
    exact ⟨⟨p', hp'm⟩, hp', rfl⟩
  rw [← h1, h2]
  rfl

end Stacks.Pinch
