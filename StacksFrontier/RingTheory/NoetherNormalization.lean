@[expose] public section

/-- **Stacks 00OY** (Noether normalization). Let `k` be a field and let `S` be a nonzero
commutative `k`-algebra generated by a finite set `s`. Then there are `r : ℕ` and `y : Fin r → S`
with every `y i` in the `ℤ`-subalgebra of `S` generated by `s`, such that the `k`-algebra map
`MvPolynomial (Fin r) k →ₐ[k] S` sending `X i` to `y i` is injective and finite; the number `r`
is the Krull dimension of `S`. -/
@[stacks 00OY "Stated for a nonzero `k`-algebra with a finite generating set `s` rather than for a
presentation `k[x_1, …, x_n]/I`, the source's `ℤ`-subalgebra being `Algebra.adjoin ℤ s`; the map
`k[y_1, …, y_r] → S` is pinned as `MvPolynomial.aeval y`. See the module docstring."]
public theorem exists_finite_inj_aeval_ringKrullDim_eq_of_adjoin_eq_top (k : Type*) {S : Type*}
    [Field k] [CommRing S] [Nontrivial S] [Algebra k S] {s : Set S} (hs : s.Finite)
    (hgen : Algebra.adjoin k s = ⊤) :
    ∃ (r : ℕ) (y : Fin r → S), (∀ i, y i ∈ Algebra.adjoin ℤ s) ∧
      Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin r) k →ₐ[k] S) ∧
      (MvPolynomial.aeval y : MvPolynomial (Fin r) k →ₐ[k] S).Finite ∧
      ringKrullDim S = r := by exact Stacks.RingTheory.NagataNormalization.solution k hs hgen

end

/-!
# Noether normalization over a domain

Let `R` be a domain and let `S` be an `R`-algebra of finite type with `R → S` injective. This file
proves Stacks 07NA: there are `d : ℕ`, an `R`-subalgebra `S'` of `S`, elements
`y_1, …, y_d ∈ S'` and a nonzero `f ∈ R` such that `R[Y_1, …, Y_d] → S'`, `Y_i ↦ y_i`, is
injective and finite, and every element of `S` lies in `S'` after multiplication by a power of
`f` (that is, `S'_f ≅ S_f`).

The proof is the source's. Pick generators `x_1, …, x_n` of `S` over `R`, let `K` be the fraction
field of `R` and let `S_K = S ⊗_R K`, realized here as the localization of `S` at the image of
`R \ {0}`. The images of the `x_i` generate `S_K` over `K`, so Noether normalization over a field
(Stacks 00OY) gives `y_1, …, y_d ∈ S_K`, lying in the `ℤ`-subalgebra generated by those images
and hence in the image of `S`, with `K[y_1, …, y_d] → S_K` injective and finite. A finite ring
map is integral, so each `x_i` is integral over `K[y_1, …, y_d]` in `S_K`; clearing the
denominators of a monic polynomial killing it and then clearing the `R`-torsion that separates `S`
from `S_K` produces a nonzero `c_i ∈ R` with `c_i x_i` integral over `R[y_1, …, y_d]` *in `S`*.
With `f = ∏ c_i` the subalgebra `S' = R[y_1, …, y_d, f x_1, …, f x_n]` is then of finite type and
integral over `R[y_1, …, y_d]`, hence finite over it, and `f ^ N x ∈ S'` for every `x ∈ S`, since
`x` is a polynomial in the `x_i` of some degree `N`.

## Main results

* `Stacks.RingTheory.GenericNormalization.solution`: the statement of Stacks 07NA.

## Implementation notes

The clearing of denominators and of torsion is
`Stacks.RingTheory.GenericNormalization.exists_mem_smul_isIntegralElem_aeval`, which carries the
hard part of the proof: it is `IsIntegral.exists_multiple_integral_of_isLocalization` (applied to
`MvPolynomial (Fin d) K` as the localization of `MvPolynomial (Fin d) R` at the image of `R \ {0}`
under `MvPolynomial.C`) followed by `IsLocalization.exists_isIntegral_smul_of_isIntegral_map`. Both
of those are stated for the algebra structures induced by the maps in play, which are introduced as
local instances inside the proofs; the statements of the lemmas of this file speak of
`RingHom.IsIntegralElem` of the explicit maps instead, so that no such structure appears in a
signature. For the same reason the fact that the elements integral over an `R`-algebra map form an
`R`-subalgebra, which Mathlib has as `integralClosure`, is restated here as
`Stacks.RingTheory.GenericNormalization.isIntegralElem_of_mem_adjoin`.

That the `f`-power multiples of `S` end up in `S'` is
`Stacks.RingTheory.GenericNormalization.exists_pow_smul_mem_of_mem_adjoin`, which says of any
subalgebra `S'` containing `f • s` that it contains an `f`-power multiple of every element of
`Algebra.adjoin R s`: the exponent is the degree of `x` as a polynomial in the generators.

The main argument is
`Stacks.RingTheory.GenericNormalization.exists_subalgebra_finite_of_isLocalization`, stated for
arbitrary models `K` and `T` of the fraction field and of `S ⊗_R K`, as Mathlib does for
localizations; `solution` instantiates it at `Localization (nonZeroDivisors R)` and at the
localization of `S` at `Algebra.algebraMapSubmonoid S (nonZeroDivisors R)`.

## References

* [StacksProject 07NA](https://stacks.math.columbia.edu/tag/07NA)
-/

namespace Stacks.RingTheory.GenericNormalization

open MvPolynomial

/-! ### Integrality over an `R`-algebra map -/

section Integral

variable {R A S : Type*} [CommRing R] [CommRing A] [CommRing S] [Algebra R A] [Algebra R S]

/-- The elements of `S` integral over an `R`-algebra map `φ : A →ₐ[R] S` form an `R`-subalgebra of
`S`: if every element of `s` is integral over `φ`, so is every element of `Algebra.adjoin R s`. -/
private lemma isIntegralElem_of_mem_adjoin (φ : A →ₐ[R] S) {s : Set S}
    (hs : ∀ w ∈ s, φ.toRingHom.IsIntegralElem w) {v : S} (hv : v ∈ Algebra.adjoin R s) :
    φ.toRingHom.IsIntegralElem v := by
  let : Algebra A S := φ.toRingHom.toAlgebra
  have : IsScalarTower R A S := .of_algebraMap_eq' (by ext a; simp [RingHom.algebraMap_toAlgebra])
  exact Algebra.adjoin_le (S := (integralClosure A S).restrictScalars R) hs hv

/-- Being integral over an `R`-algebra map is preserved by multiplication by a scalar from `R`. -/
private lemma isIntegralElem_smul (φ : A →ₐ[R] S) {w : S}
    (h : φ.toRingHom.IsIntegralElem w) (b : R) : φ.toRingHom.IsIntegralElem (b • w) := by
  refine isIntegralElem_of_mem_adjoin φ (s := {w}) (fun v hv ↦ ?_) ?_
  · rw [Set.mem_singleton_iff] at hv
    exact hv ▸ h
  · rw [Algebra.smul_def]
    exact mul_mem (Subalgebra.algebraMap_mem _ b) (Algebra.subset_adjoin rfl)

end Integral

/-! ### Localizing `S` at the image of a submonoid of `R` -/

section Nontrivial

variable {R S T : Type*} [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra S T]

/-- A localization of `S` at the image of a submonoid `M` of `R` not containing `0` is nontrivial,
`R → S` being injective. -/
private lemma nontrivial_of_isLocalization (M : Submonoid R) (hM : (0 : R) ∉ M) [FaithfulSMul R S]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) T] : Nontrivial T := by
  refine nontrivial_of_ne (1 : T) 0 fun h ↦ hM ?_
  rw [show (1 : T) = algebraMap S T 1 by simp] at h
  obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (Algebra.algebraMapSubmonoid S M) T 1).mp h
  obtain ⟨a, haM, ha⟩ := Submonoid.mem_map.mp m.2
  rw [mul_one, ← ha] at hm
  rwa [FaithfulSMul.algebraMap_injective R S (hm.trans (map_zero (algebraMap R S)).symm)] at haM

end Nontrivial

/-! ### The square `R → S → T`, `R → K → T` -/

section Square

variable {R S K T : Type*} [CommRing R] [CommRing S] [CommRing K] [CommRing T] [Algebra R S]
  [Algebra R K] [Algebra S T] [Algebra R T] [Algebra K T] [IsScalarTower R S T]
  [IsScalarTower R K T]

/-- The two ways around the square `R → S → T`, `R → K → T` after adjoining `d` variables:
the polynomial map `R[Y] → K[Y]` followed by `Y_i ↦ z_i / 1` is `Y_i ↦ z_i` followed by
`S → T`. -/
private lemma comp_map_aeval_eq {d : ℕ} (z : Fin d → S) :
    ((aeval fun i ↦ algebraMap S T (z i) : MvPolynomial (Fin d) K →ₐ[K] T) :
        MvPolynomial (Fin d) K →+* T).comp (MvPolynomial.map (algebraMap R K))
      = (algebraMap S T).comp (aeval z : MvPolynomial (Fin d) R →ₐ[R] S) := by
  refine MvPolynomial.ringHom_ext (fun a ↦ ?_) (fun i ↦ ?_)
  · simp [← IsScalarTower.algebraMap_apply]
  · simp

/-- Injectivity of `R[Y_1, …, Y_d] → S`, `Y_i ↦ z_i`, follows from injectivity of
`K[Y_1, …, Y_d] → T`, `Y_i ↦ z_i / 1`, whenever `R → K` is injective. -/
private lemma injective_aeval_of_injective_aeval_map (hRK : Function.Injective (algebraMap R K))
    {d : ℕ} {z : Fin d → S} (h : Function.Injective (aeval fun i ↦ algebraMap S T (z i) :
      MvPolynomial (Fin d) K →ₐ[K] T)) :
    Function.Injective (aeval z : MvPolynomial (Fin d) R →ₐ[R] S) := by
  refine Function.Injective.of_comp (f := algebraMap S T) ?_
  rw [show (algebraMap S T) ∘ (aeval z : MvPolynomial (Fin d) R →ₐ[R] S)
      = (aeval fun i ↦ algebraMap S T (z i) : MvPolynomial (Fin d) K →ₐ[K] T)
        ∘ (MvPolynomial.map (algebraMap R K)) from
    congrArg (fun φ : MvPolynomial (Fin d) R →+* T ↦ (φ : _ → T)) (comp_map_aeval_eq z).symm]
  exact h.comp (MvPolynomial.map_injective _ hRK)

section

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- If the image of `x : S` in the localization `T` of `S` at the image of a submonoid `M` of `R`
is integral over `K[Y_1, …, Y_d]`, where `K` is the localization of `R` at `M` and
`Y_i ↦ z_i / 1`, then `c • x` is integral over `R[Y_1, …, Y_d]`, `Y_i ↦ z_i`, for some
`c ∈ M`. -/
private lemma exists_mem_smul_isIntegralElem_aeval (M : Submonoid R) [IsLocalization M K]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) T] {d : ℕ} {z : Fin d → S} {x : S}
    (h : (aeval fun i ↦ algebraMap S T (z i) :
        MvPolynomial (Fin d) K →ₐ[K] T).toRingHom.IsIntegralElem (algebraMap S T x)) :
    ∃ c ∈ M,
      (aeval z : MvPolynomial (Fin d) R →ₐ[R] S).toRingHom.IsIntegralElem (c • x) := by
  let : Algebra (MvPolynomial (Fin d) R) S := (aeval z : _ →ₐ[R] S).toRingHom.toAlgebra
  let : Algebra (MvPolynomial (Fin d) K) T :=
    (aeval fun i ↦ algebraMap S T (z i) : _ →ₐ[K] T).toRingHom.toAlgebra
  let : Algebra (MvPolynomial (Fin d) R) T :=
    ((algebraMap S T).comp (aeval z : _ →ₐ[R] S).toRingHom).toAlgebra
  have : IsScalarTower (MvPolynomial (Fin d) R) S T := .of_algebraMap_eq' rfl
  have : IsScalarTower R (MvPolynomial (Fin d) R) S := .of_algebraMap_eq' (by
    ext a; simp [RingHom.algebraMap_toAlgebra])
  have : IsScalarTower (MvPolynomial (Fin d) R) (MvPolynomial (Fin d) K) T :=
    .of_algebraMap_eq' (comp_map_aeval_eq z).symm
  have hsub : Algebra.algebraMapSubmonoid S (M.map (C : R →+* MvPolynomial (Fin d) R))
      = Algebra.algebraMapSubmonoid S M := Algebra.algebraMapSubmonoid_map_map M
  have : IsLocalization
      (Algebra.algebraMapSubmonoid S (M.map (C : R →+* MvPolynomial (Fin d) R))) T := by
    rw [hsub]; infer_instance
  have hpush : ∀ (a : MvPolynomial (Fin d) R) (w : S),
      algebraMap S T (a • w) = a • algebraMap S T w := fun a w ↦ by
    simp [Algebra.smul_def, IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) R) S T]
  obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
    (M.map (C : R →+* MvPolynomial (Fin d) R)) (algebraMap S T x) h
  rw [Submonoid.smul_def, ← hpush] at hm
  obtain ⟨m₂, hm₂, hint⟩ := IsLocalization.exists_isIntegral_smul_of_isIntegral_map
    (M.map (C : R →+* MvPolynomial (Fin d) R)) hm
  rw [smul_smul] at hint
  obtain ⟨c, hcM, hc⟩ := Submonoid.mem_map.mp (mul_mem hm₂ m.2)
  refine ⟨c, hcM, ?_⟩
  rw [← hc, show (C c : MvPolynomial (Fin d) R) = algebraMap R (MvPolynomial (Fin d) R) c from rfl,
    IsScalarTower.algebraMap_smul] at hint
  exact hint

end

/-- The `K`-subalgebra of the localization `T` of `S` at the image of a submonoid `M` of `R`
generated by the image of a set of `R`-algebra generators of `S` is everything, `K` being the
localization of `R` at `M`. -/
private lemma adjoin_image_eq_top (M : Submonoid R) [IsLocalization M K]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) T] {s : Set S}
    (hs : Algebra.adjoin R s = ⊤) : Algebra.adjoin K (algebraMap S T '' s) = ⊤ := by
  have himg : ∀ w : S, algebraMap S T w ∈ Algebra.adjoin K (algebraMap S T '' s) := by
    intro w
    have hw : w ∈ Algebra.adjoin R s := hs ▸ Algebra.mem_top
    induction hw using Algebra.adjoin_induction with
    | mem x hx => exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
    | algebraMap a =>
        rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R K T]
        exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  refine top_unique fun t _ ↦ ?_
  obtain ⟨⟨x, m⟩, hxm⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid S M) t
  obtain ⟨a, haM, ha⟩ := Submonoid.mem_map.mp m.2
  obtain ⟨u, hu⟩ := IsLocalization.map_units K (⟨a, haM⟩ : M)
  have hmT : algebraMap S T (m : S) = algebraMap K T (u : K) := by
    rw [← ha, hu, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  have ht : t = algebraMap S T x * algebraMap K T ((u⁻¹ : Kˣ) : K) := by
    rw [← hxm, hmT, mul_assoc, ← map_mul, Units.mul_inv, map_one, mul_one]
  rw [ht]
  exact mul_mem (himg x) (Subalgebra.algebraMap_mem _ _)

end Square

/-! ### Assembling the subalgebra -/

section Assemble

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- A subalgebra of finite type over `R` all of whose elements are integral over `R[Y_1, …, Y_d]`,
`Y_i ↦ z_i`, is finite over it (Stacks 02JJ, in the form needed here). -/
private lemma finite_aeval_of_isIntegralElem {d : ℕ} {S' : Subalgebra R S} {z : Fin d → S}
    (hz : ∀ i, z i ∈ S') (hFT : Algebra.FiniteType R S')
    (hint : ∀ v ∈ S',
      (aeval z : MvPolynomial (Fin d) R →ₐ[R] S).toRingHom.IsIntegralElem v) :
    (aeval (fun i ↦ (⟨z i, hz i⟩ : S')) : MvPolynomial (Fin d) R →ₐ[R] S').Finite := by
  let : Algebra (MvPolynomial (Fin d) R) S' :=
    (aeval (fun i ↦ (⟨z i, hz i⟩ : S')) : _ →ₐ[R] S').toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin d) R) S' := .of_algebraMap_eq' (by
    ext a; simp [RingHom.algebraMap_toAlgebra])
  have := hFT
  have : Algebra.FiniteType (MvPolynomial (Fin d) R) S' :=
    Algebra.FiniteType.of_restrictScalars_finiteType R _ _
  have hcomp : ((S'.val : S' →+* S).comp
      (aeval (fun i ↦ (⟨z i, hz i⟩ : S')) : MvPolynomial (Fin d) R →ₐ[R] S').toRingHom)
      = (aeval z : MvPolynomial (Fin d) R →ₐ[R] S).toRingHom :=
    congrArg AlgHom.toRingHom (MvPolynomial.comp_aeval _ S'.val)
  have : Algebra.IsIntegral (MvPolynomial (Fin d) R) S' := by
    refine ⟨fun v ↦ RingHom.IsIntegralElem.of_map (g := (S'.val : S' →+* S))
      Subtype.val_injective ?_⟩
    change ((S'.val : S' →+* S).comp
      (aeval (fun i ↦ (⟨z i, hz i⟩ : S')) :
        MvPolynomial (Fin d) R →ₐ[R] S').toRingHom).IsIntegralElem (v : S)
    rw [hcomp]
    exact hint v v.2
  exact Algebra.IsIntegral.finite

/-- `R[Y_1, …, Y_d] → S'` is injective as soon as its composite with the inclusion of the
subalgebra `S'` in `S` is. -/
private lemma injective_aeval_of_injective_aeval_val {d : ℕ} {S' : Subalgebra R S} {y : Fin d → S'}
    (h : Function.Injective (aeval (fun i ↦ (y i : S)) : MvPolynomial (Fin d) R →ₐ[R] S)) :
    Function.Injective (aeval y : MvPolynomial (Fin d) R →ₐ[R] S') := by
  refine Function.Injective.of_comp (f := (S'.val : S' → S)) ?_
  rw [show (S'.val : S' → S) ∘ (aeval y : MvPolynomial (Fin d) R →ₐ[R] S')
      = (aeval (fun i ↦ (y i : S)) : MvPolynomial (Fin d) R →ₐ[R] S) from
    congrArg (fun ψ : MvPolynomial (Fin d) R →ₐ[R] S ↦ (ψ : _ → S))
      (MvPolynomial.comp_aeval _ S'.val)]
  exact h

/-- A subalgebra containing `f • w` for every `w` in a generating set `s` contains an `f`-power
multiple of every element of `Algebra.adjoin R s`: the exponent is the degree of that element as a
polynomial in the generators. -/
private lemma exists_pow_smul_mem_of_mem_adjoin {S' : Subalgebra R S} {f : R} {s : Set S}
    (hs : ∀ w ∈ s, f • w ∈ S') {x : S} (hx : x ∈ Algebra.adjoin R s) :
    ∃ n : ℕ, f ^ n • x ∈ S' := by
  induction hx using Algebra.adjoin_induction with
  | mem w hw => exact ⟨1, by rw [pow_one]; exact hs w hw⟩
  | algebraMap a => exact ⟨0, by rw [pow_zero, one_smul]; exact S'.algebraMap_mem a⟩
  | add u v _ _ hu hv =>
      obtain ⟨n, hn⟩ := hu
      obtain ⟨m, hm⟩ := hv
      refine ⟨n + m, ?_⟩
      rw [smul_add, show f ^ (n + m) • u = f ^ m • (f ^ n • u) by
          rw [smul_smul, ← pow_add, add_comm],
        show f ^ (n + m) • v = f ^ n • (f ^ m • v) by rw [smul_smul, ← pow_add]]
      exact add_mem (Subalgebra.smul_mem _ hn _) (Subalgebra.smul_mem _ hm _)
  | mul u v _ _ hu hv =>
      obtain ⟨n, hn⟩ := hu
      obtain ⟨m, hm⟩ := hv
      exact ⟨n + m, by rw [pow_add, ← smul_mul_smul_comm]; exact mul_mem hn hm⟩

end Assemble

