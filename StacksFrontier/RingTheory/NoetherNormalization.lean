/-- Stacks 07NA for given models `K` of the fraction field of `R` and `T` of `S ⊗_R K`. -/
private theorem exists_subalgebra_finite_of_isLocalization (R S : Type*) [CommRing R] [IsDomain R]
    [CommRing S] [Algebra R S] [FaithfulSMul R S] [Algebra.FiniteType R S] (K T : Type*) [Field K]
    [Algebra R K] [IsLocalization (nonZeroDivisors R) K] [CommRing T] [Algebra S T] [Algebra R T]
    [Algebra K T] [IsScalarTower R S T] [IsScalarTower R K T]
    [IsLocalization (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)) T] :
    ∃ (d : ℕ) (S' : Subalgebra R S) (y : Fin d → S') (f : R), f ≠ 0 ∧
      Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin d) R →ₐ[R] S') ∧
      (MvPolynomial.aeval y : MvPolynomial (Fin d) R →ₐ[R] S').Finite ∧
      ∀ x : S, ∃ n : ℕ, f ^ n • x ∈ S' := by
  classical
  obtain ⟨g, hg⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra R S).FG)
  have : Nontrivial T :=
    nontrivial_of_isLocalization (S := S) (nonZeroDivisors R) zero_notMem_nonZeroDivisors
  -- Noether normalization over `K` for `T = S ⊗_R K`
  obtain ⟨r, y, hyZ, hyinj, hyfin, -⟩ :=
    exists_finite_inj_aeval_ringKrullDim_eq_of_adjoin_eq_top K (S := T)
      (g.finite_toSet.image (algebraMap S T)) (adjoin_image_eq_top (nonZeroDivisors R) hg)
  -- the `y i` lie in a `ℤ`-subalgebra generated by the image of `S`, hence come from `S`
  have hylift : ∀ i, ∃ w : S, algebraMap S T w = y i := fun i ↦
    Algebra.adjoin_le (S := (algebraMap S T).toIntAlgHom.range)
      (by rintro _ ⟨w, _, rfl⟩; exact ⟨w, rfl⟩) (hyZ i)
  choose z hz using hylift
  -- clear denominators and torsion: `c x • x` is integral over `R[Y_1, …, Y_r]` in `S`
  have hcgen : ∀ x ∈ g, ∃ c ∈ nonZeroDivisors R,
      (aeval z : MvPolynomial (Fin r) R →ₐ[R] S).toRingHom.IsIntegralElem (c • x) := fun x _ ↦
    exists_mem_smul_isIntegralElem_aeval (nonZeroDivisors R)
      (by rw [funext hz]; exact RingHom.Finite.to_isIntegral hyfin _)
  choose! c hcM hcint using hcgen
  set f : R := ∏ x ∈ g, c x with hfdef
  have hf0 : f ≠ 0 := Finset.prod_ne_zero_iff.mpr fun x hx ↦ nonZeroDivisors.ne_zero (hcM x hx)
  have hfint : ∀ x ∈ g,
      (aeval z : MvPolynomial (Fin r) R →ₐ[R] S).toRingHom.IsIntegralElem (f • x) := by
    intro x hx
    rw [show f • x = (∏ w ∈ g.erase x, c w) • (c x • x) by
      rw [smul_smul, hfdef, ← Finset.mul_prod_erase g c hx, mul_comm]]
    exact isIntegralElem_smul _ (hcint x hx) _
  -- `S' = R[y_1, …, y_r, f x_1, …, f x_n]`
  set gens : Set S := Set.range z ∪ (fun w ↦ f • w) '' (g : Set S) with hgens
  have hzS' : ∀ i, z i ∈ Algebra.adjoin R gens := fun i ↦
    Algebra.subset_adjoin (by rw [hgens]; exact Or.inl ⟨i, rfl⟩)
  have hfS' : ∀ w ∈ (g : Set S), f • w ∈ Algebra.adjoin R gens := fun w hw ↦
    Algebra.subset_adjoin (by rw [hgens]; exact Or.inr ⟨w, hw, rfl⟩)
  have hgint : ∀ w ∈ gens,
      (aeval z : MvPolynomial (Fin r) R →ₐ[R] S).toRingHom.IsIntegralElem w := by
    rw [hgens]
    rintro w (⟨i, rfl⟩ | ⟨w, hw, rfl⟩)
    · rw [show z i = (aeval z : MvPolynomial (Fin r) R →ₐ[R] S).toRingHom (X i) by simp]
      exact RingHom.isIntegralElem_map
        (f := (aeval z : MvPolynomial (Fin r) R →ₐ[R] S).toRingHom)
    · exact hfint w hw
  refine ⟨r, Algebra.adjoin R gens, fun i ↦ ⟨z i, hzS' i⟩, f, hf0,
    injective_aeval_of_injective_aeval_val
      (injective_aeval_of_injective_aeval_map (K := K) (T := T)
        (IsLocalization.injective K le_rfl) (by rw [funext hz]; exact hyinj)),
    finite_aeval_of_isIntegralElem hzS' (Algebra.FiniteType.adjoin_of_finite
      ((Set.finite_range z).union (g.finite_toSet.image _)))
      fun v hv ↦ isIntegralElem_of_mem_adjoin _ hgint hv,
    fun x ↦ exists_pow_smul_mem_of_mem_adjoin hfS' (hg ▸ Algebra.mem_top)⟩

/-- **Stacks 07NA** (Noether normalization over a domain). -/
public theorem solution (R S : Type*) [CommRing R]
    [IsDomain R] [CommRing S] [Algebra R S] [FaithfulSMul R S] [Algebra.FiniteType R S] :
    ∃ (d : ℕ) (S' : Subalgebra R S) (y : Fin d → S') (f : R), f ≠ 0 ∧
      Function.Injective (MvPolynomial.aeval y : MvPolynomial (Fin d) R →ₐ[R] S') ∧
      (MvPolynomial.aeval y : MvPolynomial (Fin d) R →ₐ[R] S').Finite ∧
      ∀ x : S, ∃ n : ℕ, f ^ n • x ∈ S' :=
  exists_subalgebra_finite_of_isLocalization R S (Localization (nonZeroDivisors R))
    (Localization (Algebra.algebraMapSubmonoid S (nonZeroDivisors R)))

end Stacks.RingTheory.GenericNormalization

/-!
# Noether normalization over a domain

Let `R` be a domain and let `S` be an `R`-algebra of finite type whose structure map `R → S` is
injective. Then `R → S` can be factored as `R → R[y_1, …, y_d] → S' → S` by injective maps, with
`S'` an `R`-subalgebra of `S` which is finite over the polynomial ring `R[y_1, …, y_d]`, in such a
way that `S'` and `S` agree after inverting a single nonzero `f ∈ R`: `S'_f ≅ S_f` (Stacks 07NA).
So a finite type extension of a domain is generically — over a dense open of `Spec R` — finite over
an affine space.

The source's proof picks generators `x_1, …, x_n` of `S` over `R`, applies Noether normalization
over the fraction field `K` of `R` (Lemma 00OY) to `S ⊗_R K` to get `y_1, …, y_d ∈ S` with
`K[y_1, …, y_d] → S ⊗_R K` finite injective, clears the denominators of monic polynomials killing
the `x_i` over `K[y_1, …, y_d]` into a single nonzero `f ∈ R`, and takes for `S'` the
`R`-subalgebra generated by the `y_j` together with the elements `f x_i`, which are integral over
`R[y_1, …, y_d]` by the monic polynomials `f ^ deg P_i * P_i (T / f)`.

## Main results

* `exists_subalgebra_finite_inj_aeval_pow_smul_mem`: Noether normalization over a domain, in the
  form: there are `d`, an `R`-subalgebra `S'` of `S` finite over `R[y_1, …, y_d]` by an injective
  map, and a nonzero `f ∈ R` such that every element of `S` lies in `S'` after multiplication by a
  power of `f`.

## Implementation notes

The chain of the source, `R → R[y_1, …, y_d] → S' → S`, is realized by taking `S'` to be a
`Subalgebra R S`, so that the last map is the inclusion `S'.val` and is injective for free, and by
taking the middle map to be `MvPolynomial.aeval y` for elements `y : Fin d → S'`, which is the map
the source names (`y_i ↦ y_i`); injectivity of `R → R[y_1, …, y_d]` is `MvPolynomial.C_injective`
for the nontrivial ring `R` and is likewise not restated. Injectivity of `aeval y` into `S'` is
equivalent to injectivity of the composite into `S`. Finiteness is `AlgHom.Finite`, as in the
Mathlib sibling `exists_finite_inj_algHom_of_fg`, which is this statement for a field base, where
`S' = S` and no `f` is needed.

The source's conclusion `S'_f ≅ S_f` is stated in the equivalent elementary form
`∀ x : S, ∃ n, f ^ n • x ∈ S'`. Localization at the powers of `f` is exact, so `S'_f → S_f` is
injective whatever `S'` is, and the content of the isomorphism is its surjectivity, that is, that
every `x ∈ S` becomes `f ^ (-n)` times an element of `S'`; the elementary form says this on the
nose, with no `f`-torsion allowance, and is what the source's proof produces (`x_i = (f x_i) / f`
with `f x_i ∈ S'`) and what a user of the lemma reads off it (More on Algebra, Lemma 07PH uses
exactly `g ^ (p N) f ∈ B'`). It also avoids naming models of the two localizations, and gives the
isomorphism `S'_f ≅ S_f` for every such pair of models.

The integer `d` is left unpinned, as in the source. It is nonetheless determined:
`S ⊗_R K ≅ K ⊗_{R_f} S_f ≅ K ⊗_{R_f} S'_f` is finite and injective over `K[y_1, …, y_d]`, because
`K` is flat over `R_f`, so `dim (S ⊗_R K) = d` by Lemma 00OK; an induction on that dimension
(Lemma 051R) derives the value rather than reading it off the statement.

Faithfulness. (1) No hypothesis is idle. `FaithfulSMul R S` is not merely used but forced by the
conclusion, since every `R`-subalgebra of `S` receives `algebraMap R S` and `aeval y` restricted to
the constants is that map. `Algebra.FiniteType R S` is needed: for `S = R[x_1, x_2, …]` in
countably many variables no subalgebra finite over a polynomial ring in finitely many variables can
contain a power multiple of every element. `IsDomain R` is needed, and not only to make "`f ≠ 0`" a
genericity condition: for `R = k × k` and `S = k[x] × k[y, z]` the statement fails, because a
nonzero `f` is either a unit — and then `S' = S` must be finite over one `R[y_1, …, y_d]`, forcing
the two factors to have the same dimension — or, up to units, `f = (1, 0)`, in which case `S'`
contains `k[x] × k` and no injective finite `R[y_1, …, y_d] → S'` exists (for `d = 0` the first
factor is too big, for `d ≥ 1` injectivity fails in the second factor). (2) The scalars and the
base are the source's: the polynomial ring is over `R` and not over its fraction field, the
finiteness asserted is over that polynomial ring, `S'` is an `R`-subalgebra of `S`, `f` is an
element of `R`, and `•` is the `R`-action on `S` induced by `algebraMap R S`. (3) The maps the
source names are pinned: `R[y_1, …, y_d] → S'` is `MvPolynomial.aeval y` for the exhibited elements
`y`, and `S' → S` is the inclusion of the exhibited subalgebra; the existential quantifies over
`d`, `S'`, `y` and `f` only. (4) The instantiation is not degenerate: for `R = ℤ` and `S = ℤ[1/2]`,
which is of finite type over `ℤ` by `S = ℤ[x] / (2 x - 1)`, take `d = 0`, `S' = ⊥ = ℤ` and `f = 2`;
every element of `ℤ[1/2]` is `2 ^ (-n)` times an integer, and here `f` is necessarily a nonunit and
`S' ≠ S`, since `S` itself is not finite over `ℤ`.

