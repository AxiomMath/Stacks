/-!
# Generic freeness for a finitely presented module (051S)

This file proves `Module.FinitePresentation.exists_ne_zero_free_localizedModule_away` (Stacks 051S):
for a finitely presented module over a finitely presented algebra over a domain `R`, the
localization `M_f` is free over `R_f` for some nonzero `f ∈ R`. The proof descends the data to a
domain of finite type over `ℤ` and applies 051R there. The overview of Stacks section 051Q and its
implementation notes are the module docstring of
`StacksFrontier.Algebra.Category.Ring.Epi.GenericFlatness.Noetherian`.
-/

@[expose] public section

/-! ### Generic freeness for a finitely presented module (051S) -/

section
open TensorProduct

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The base change of a finite free module: `B ⊗[A] (Fin t → A) = (Fin t → B)`. -/
private theorem isBaseChange_pi {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (t : ℕ) :
    IsBaseChange B
      (LinearMap.pi fun i : Fin t => (Algebra.linearMap A B).comp (LinearMap.proj i)) := by
  refine IsBaseChange.of_equiv (TensorProduct.piScalarRight A B B (Fin t)) fun x => ?_
  rw [TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul]
  funext i
  simp only [LinearMap.pi_apply, LinearMap.coe_comp, Function.comp_apply, LinearMap.proj_apply,
    Algebra.linearMap_apply, Algebra.smul_def, mul_one]

/-- The base change of a quotient module. If `W` is the base change of `W₀` along `A → B` and
`K ≤ W` is the `B`-submodule generated by the image of `K₀ ≤ W₀`, then `W ⧸ K` is the base
change of `W₀ ⧸ K₀`. -/
private theorem isBaseChange_liftQ
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {W₀ W : Type*} [AddCommGroup W₀] [Module A W₀]
    [AddCommGroup W] [Module A W] [Module B W] [IsScalarTower A B W]
    {ψ : W₀ →ₗ[A] W} (hψ : IsBaseChange B ψ)
    {K₀ : Submodule A W₀} {K : Submodule B W}
    (hK : K = Submodule.span B (ψ '' K₀))
    (φ : (W₀ ⧸ K₀) →ₗ[A] (W ⧸ K))
    (hφ : ∀ w : W₀, φ (K₀.mkQ w) = K.mkQ (ψ w)) :
    IsBaseChange B φ := by
  apply IsBaseChange.of_lift_unique
  intro Q _ _ _ _ u
  -- `Submodule.liftQ` needs the target to be a group; a module over the ring `B` is one.
  let _ : AddCommGroup Q := Module.addCommMonoidToAddCommGroup B
  set q : W →ₗ[B] Q := hψ.lift (u ∘ₗ K₀.mkQ)
  have hqψ : ∀ w : W₀, q (ψ w) = u (K₀.mkQ w) := fun w => hψ.lift_eq _ w
  have hφ' : ∀ w : W₀, φ (Submodule.Quotient.mk w) = Submodule.Quotient.mk (ψ w) := hφ
  have hle : K ≤ LinearMap.ker q := by
    rw [hK, Submodule.span_le]
    rintro _ ⟨w, hw, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, hqψ]
    rw [show K₀.mkQ w = 0 from (Submodule.Quotient.mk_eq_zero _).mpr hw, map_zero]
  refine ⟨K.liftQ q hle, ?_, ?_⟩
  · ext w
    simp only [LinearMap.coe_comp, LinearMap.coe_restrictScalars, Function.comp_apply,
      Submodule.mkQ_apply, hφ']
    rw [K.liftQ_apply q (ψ w)]
    exact hqψ w
  · intro F hF
    have hmk : F ∘ₗ K.mkQ = q := by
      refine hψ.algHom_ext _ _ fun w => ?_
      simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply]
      rw [← hφ' w]
      simpa [hqψ w] using
        congrArg (fun (f : (W₀ ⧸ K₀) →ₗ[A] Q) => f (Submodule.Quotient.mk w)) hF
    refine LinearMap.ext fun x => ?_
    obtain ⟨w, rfl⟩ := K.mkQ_surjective x
    exact (congrArg (fun (f : W →ₗ[B] Q) => f w) hmk).trans (K.liftQ_apply q w).symm

/-- **A base change followed by an isomorphism is a base change.** If `f : M →ₗ[R] N` presents `N`
as the base change of `M` along `R → S` and `e : N ≃ₗ[S] Q`, then `e ∘ f` presents `Q` as that
base change. -/
private theorem isBaseChange_equiv_comp {R S M N Q : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    [AddCommGroup Q] [Module R Q] [Module S Q] [IsScalarTower R S Q] {f : M →ₗ[R] N}
    (h : IsBaseChange S f) (e : N ≃ₗ[S] Q) :
    IsBaseChange S ((e.toLinearMap.restrictScalars R).comp f) :=
  (IsBaseChange.iff_of_equiv_comm (.refl R M) e rfl).mp h

/-- **A base change over a pushout of base rings is a base change over the base.** Let `A` be the
pushout of `R₀ → R` along `R₀ → A₀`, and let `φ : W₀ →ₗ[A₀] W` present `W` as the base change of
`W₀` along `A₀ → A`. Then `φ` presents `W` as the base change of `W₀` along `R₀ → R` as well,
`Algebra.IsPushout.cancelBaseChange` identifying `A ⊗[A₀] W₀` with `R ⊗[R₀] W₀`. -/
private theorem isBaseChange_restrictScalars_of_isPushout (R₀ R A₀ A : Type*) [CommRing R₀]
    [CommRing R] [CommRing A₀] [CommRing A] [Algebra R₀ R] [Algebra R₀ A₀] [Algebra R₀ A]
    [Algebra R A] [Algebra A₀ A] [IsScalarTower R₀ R A] [IsScalarTower R₀ A₀ A]
    [Algebra.IsPushout R₀ R A₀ A] {W₀ W : Type*} [AddCommGroup W₀] [Module R₀ W₀] [Module A₀ W₀]
    [IsScalarTower R₀ A₀ W₀] [AddCommGroup W] [Module R₀ W] [Module R W] [Module A₀ W] [Module A W]
    [IsScalarTower R₀ R W] [IsScalarTower R₀ A₀ W] [IsScalarTower A₀ A W] [IsScalarTower R A W]
    {φ : W₀ →ₗ[A₀] W} (hφ : IsBaseChange A φ) :
    IsBaseChange R (φ.restrictScalars R₀) :=
  IsBaseChange.of_equiv
    ((Algebra.IsPushout.cancelBaseChange R₀ R A₀ A W₀).symm ≪≫ₗ hφ.equiv.restrictScalars R)
    fun x => by simp

/-- A multivariate polynomial all of whose coefficients lie in a subalgebra is the image of a
polynomial over that subalgebra. -/
private theorem exists_map_eq_of_coeff_mem {σ R : Type*} [CommRing R]
    (R₀ : Subalgebra ℤ R) (q : MvPolynomial σ R) (hq : ∀ m, q.coeff m ∈ R₀) :
    ∃ q₀ : MvPolynomial σ R₀, MvPolynomial.map (algebraMap R₀ R) q₀ = q := by
  classical
  refine ⟨∑ m ∈ q.support, MvPolynomial.monomial m ⟨q.coeff m, hq m⟩, ?_⟩
  rw [map_sum]
  conv_rhs => rw [MvPolynomial.as_sum q]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [MvPolynomial.map_monomial]
  rfl

/-- Spans are unchanged by first spanning over the smaller ring. -/
private theorem span_image_span {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {W₀ W : Type*} [AddCommGroup W₀] [Module A W₀] [AddCommGroup W] [Module A W] [Module B W]
    [IsScalarTower A B W] (ψ : W₀ →ₗ[A] W) (s : Set W₀) :
    Submodule.span B (ψ '' (Submodule.span A s : Set W₀)) = Submodule.span B (ψ '' s) := by
  refine le_antisymm ?_ (Submodule.span_mono (Set.image_mono Submodule.subset_span))
  rw [Submodule.span_le]
  rintro _ ⟨x, hx, rfl⟩
  induction hx using Submodule.span_induction with
  | mem x h => exact Submodule.subset_span ⟨x, h, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => simpa using Submodule.add_mem _ hx hy
  | smul a x _ hx =>
      simp only [SetLike.mem_coe] at hx ⊢
      rw [map_smul]
      exact Submodule.smul_of_tower_mem _ a hx

/-- Restricting scalars of a module along an algebra map gives a scalar tower. -/
private theorem isScalarTower_compHom {B C M : Type*} [CommSemiring B] [CommSemiring C]
    [Algebra B C] [AddCommMonoid M] [Module C M] :
    letI : Module B M := Module.compHom M (algebraMap B C)
    IsScalarTower B C M :=
  letI : Module B M := Module.compHom M (algebraMap B C)
  ⟨fun x y z => by rw [Algebra.smul_def]; exact mul_smul _ _ _⟩

/-- If `B` acts on `M` through `C`, then a scalar tower `A → C → M` with `A → B → C` gives a scalar
tower `A → B → M`. -/
private theorem isScalarTower_of_isScalarTower_right {A B C M : Type*} [CommSemiring A]
    [CommSemiring B] [CommSemiring C] [Algebra A B] [Algebra B C] [Algebra A C]
    [IsScalarTower A B C] [AddCommMonoid M] [Module A M] [Module B M] [Module C M]
    [IsScalarTower A C M] [IsScalarTower B C M] : IsScalarTower A B M :=
  IsScalarTower.of_algebraMap_smul fun r x => by
    rw [← IsScalarTower.algebraMap_smul C (algebraMap A B r) x,
      ← IsScalarTower.algebraMap_apply, algebraMap_smul]

/-- **Generic freeness descends along a base change of the base ring.** If `M` is the base change
of `M₀` along `R₀ → R` and the localization of `M₀` at the powers of `f₀ : R₀` is free over
`(R₀)_{f₀}`, then every localization of `M` at the powers of the image of `f₀` in `R` is free over
the corresponding localization of `R`. -/
private theorem free_of_isBaseChange {R₀ R M₀ M : Type*}
    [CommRing R₀] [CommRing R] [Algebra R₀ R]
    [AddCommGroup M₀] [Module R₀ M₀]
    [AddCommGroup M] [Module R₀ M] [Module R M] [IsScalarTower R₀ R M]
    {φ : M₀ →ₗ[R₀] M} (hφ : IsBaseChange R φ) {f₀ : R₀}
    (hfree : Module.Free (Localization.Away f₀) (LocalizedModule (Submonoid.powers f₀) M₀))
    (Rf : Type*) [CommRing Rf] [Algebra R Rf]
    [IsLocalization.Away (algebraMap R₀ R f₀) Rf]
    (Mf : Type*) [AddCommGroup Mf] [Module R₀ Mf] [Module R Mf] [Module Rf Mf]
    [IsScalarTower R₀ R Mf] [IsScalarTower R Rf Mf]
    (g : M →ₗ[R] Mf)
    [IsLocalizedModule (Submonoid.powers (algebraMap R₀ R f₀)) g] :
    Module.Free Rf Mf := by
  let : Algebra R₀ Rf := ((algebraMap R Rf).comp (algebraMap R₀ R)).toAlgebra
  have : IsScalarTower R₀ R Rf := IsScalarTower.of_algebraMap_eq' rfl
  have : IsScalarTower R₀ Rf Mf := IsScalarTower.of_algebraMap_smul fun r x => by
    rw [IsScalarTower.algebraMap_apply R₀ R Rf, algebraMap_smul, algebraMap_smul]
  have hunit : ∀ y : Submonoid.powers f₀, IsUnit (algebraMap R₀ Rf (y : R₀)) := by
    rintro ⟨y, k, rfl⟩
    rw [show algebraMap R₀ Rf (f₀ ^ k) = algebraMap R Rf ((algebraMap R₀ R f₀) ^ k) by
      rw [map_pow, IsScalarTower.algebraMap_apply R₀ R Rf, map_pow]]
    exact IsLocalization.map_units (M := Submonoid.powers (algebraMap R₀ R f₀)) Rf
      ⟨(algebraMap R₀ R f₀) ^ k, k, rfl⟩
  let : Algebra (Localization.Away f₀) Rf :=
    (IsLocalization.lift (M := Submonoid.powers f₀) (S := Localization.Away f₀) hunit).toAlgebra
  have : IsScalarTower R₀ (Localization.Away f₀) Rf :=
    IsScalarTower.of_algebraMap_eq fun x => (IsLocalization.lift_eq hunit x).symm
  let : Module (Localization.Away f₀) Mf :=
    Module.compHom Mf (algebraMap (Localization.Away f₀) Rf)
  have : IsScalarTower (Localization.Away f₀) Rf Mf := isScalarTower_compHom
  have : IsScalarTower R₀ (Localization.Away f₀) Mf :=
    isScalarTower_of_isScalarTower_right (C := Rf)
  have : Module.Free (Localization.Away f₀) (LocalizedModule (Submonoid.powers f₀) M₀) := hfree
  have hψ₀ : IsBaseChange (Localization.Away f₀)
      (LocalizedModule.mkLinearMap (Submonoid.powers f₀) M₀) :=
    IsLocalizedModule.isBaseChange (Submonoid.powers f₀) (Localization.Away f₀)
      (LocalizedModule.mkLinearMap (Submonoid.powers f₀) M₀)
  have hg : IsBaseChange Rf g :=
    IsLocalizedModule.isBaseChange (Submonoid.powers (algebraMap R₀ R f₀)) Rf g
  have hcomp : IsBaseChange Rf ((g.restrictScalars R₀).comp φ) := hφ.comp hg
  have hbc : IsBaseChange Rf (hψ₀.lift ((g.restrictScalars R₀).comp φ)) :=
    hψ₀.of_comp (by rw [IsBaseChange.lift_comp]; exact hcomp)
  exact Module.Free.of_equiv hbc.equiv

namespace Module.FinitePresentation

set_option synthInstance.maxHeartbeats 400000 in
-- The descent carries the module structures of four rings — `R₀`, `R`, `R₀[x]`, `R[x]` — at once:
-- the searches for the `R₀`-module structures on the localizations of `(R₀[x])^t ⧸ K₀` do not
-- terminate within the default instance budget (40000 is still too little), and the descent as a
-- whole does not elaborate within the default heartbeat budget (400000 is still too little).
set_option maxHeartbeats 600000 in
/-- **Stacks 051S** (generic freeness). Let `R` be a domain, let `S` be an `R`-algebra of finite
presentation and let `M` be an `S`-module of finite presentation. Then there is a nonzero `f ∈ R`
such that the localization `M_f` is a free `R_f`-module.

Write `S = P/I` with `P = R[x_1, …, x_n]`, so that `M ≅ P^t/K` with `K` finitely generated, and let
`R₀ ⊆ R` be the `ℤ`-subalgebra generated by the coefficients of generators of `K`. Then `R₀` is a
domain of finite type over `ℤ`, hence Noetherian, and `M` is the base change along `R₀ → R` of the
finite `R₀[x]`-module `M₀` defined by the descended generators, so 051R applies over `R₀`. -/
@[stacks 051S "The localizations are abstract: the conclusion asserts freeness over every model
`Rf` of `R_f` and `Mf` of `M_f`, pinned by `IsLocalization.Away` and `IsLocalizedModule`. The
`R`-module structure on `M` is the one induced by `R → S`. See the module docstring.",
  ega
  "IV 8.9.4" "affine, free case",
  ega "IV 8.9.4.1",
  ega "IV 8.9.4" "affine, free case",
  ega "IV 11.4.6" "special case",
  ega "IV 6.9.2" "more general", sga "1 IV 6.7" "more general"]
public theorem exists_ne_zero_free_localizedModule_away
    {R S M : Type*} [CommRing R] [IsDomain R] [CommRing S] [Algebra R S]
    [Algebra.FinitePresentation R S] [AddCommGroup M] [Module R M] [Module S M]
    [IsScalarTower R S M] [Module.FinitePresentation S M] :
    ∃ f : R, f ≠ 0 ∧ ∀ (Rf : Type*) [CommRing Rf] [Algebra R Rf] [IsLocalization.Away f Rf]
      (Mf : Type*) [AddCommGroup Mf] [Module R Mf] [Module Rf Mf] [IsScalarTower R Rf Mf]
      (g : M →ₗ[R] Mf) [IsLocalizedModule (Submonoid.powers f) g],
      Module.Free Rf Mf := by
  classical
  obtain ⟨n, alg, halg, hker⟩ := Algebra.FinitePresentation.out (R := R) (A := S)
  let : Algebra (MvPolynomial (Fin n) R) S := alg.toRingHom.toAlgebra
  have : IsScalarTower R (MvPolynomial (Fin n) R) S :=
    IsScalarTower.of_algebraMap_eq fun r => (alg.commutes r).symm
  let : Module (MvPolynomial (Fin n) R) M :=
    Module.compHom M (algebraMap (MvPolynomial (Fin n) R) S)
  have : IsScalarTower (MvPolynomial (Fin n) R) S M := isScalarTower_compHom
  have : IsScalarTower R (MvPolynomial (Fin n) R) M :=
    isScalarTower_of_isScalarTower_right (C := S)
  have : Module.FinitePresentation (MvPolynomial (Fin n) R) S :=
    Module.finitePresentation_of_surjective
      (Algebra.linearMap (MvPolynomial (Fin n) R) S) halg hker
  have : Module.FinitePresentation (MvPolynomial (Fin n) R) M :=
    Module.FinitePresentation.trans _ M S
  obtain ⟨t, K, e, hKfg⟩ := Module.FinitePresentation.exists_fin (MvPolynomial (Fin n) R) M
  obtain ⟨w, hw⟩ := hKfg
  -- the finite set of coefficients of the generators of `K`
  set cs : Set R := ⋃ (i : (w : Finset (Fin t → MvPolynomial (Fin n) R))) (j : Fin t),
      (fun m => ((i : Fin t → MvPolynomial (Fin n) R) j).coeff m) ''
        (((i : Fin t → MvPolynomial (Fin n) R) j).support : Set (Fin n →₀ ℕ))
  have hcsfin : cs.Finite :=
    Set.finite_iUnion fun _ => Set.finite_iUnion fun _ =>
      Set.Finite.image _ (Finset.finite_toSet _)
  set R₀ : Subalgebra ℤ R := Algebra.adjoin ℤ cs with hR₀
  have hmemR₀ : ∀ x ∈ cs, x ∈ R₀ := fun x hx => hR₀ ▸ Algebra.subset_adjoin hx
  have : Algebra.FiniteType ℤ ↥R₀ := hR₀ ▸ Algebra.FiniteType.adjoin_of_finite hcsfin
  have : IsNoetherianRing ↥R₀ := Algebra.FiniteType.isNoetherianRing ℤ ↥R₀
  have hlift : ∀ (i : (w : Finset (Fin t → MvPolynomial (Fin n) R))) (j : Fin t),
      ∃ q₀ : MvPolynomial (Fin n) ↥R₀, MvPolynomial.map (algebraMap ↥R₀ R) q₀
        = (i : Fin t → MvPolynomial (Fin n) R) j := by
    intro i j
    refine exists_map_eq_of_coeff_mem R₀ _ fun m => ?_
    by_cases hm : m ∈ (((i : Fin t → MvPolynomial (Fin n) R) j)).support
    · exact hmemR₀ _ (Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨j, ⟨m, hm, rfl⟩⟩⟩)
    · rw [MvPolynomial.notMem_support_iff] at hm
      rw [hm]
      exact zero_mem _
  choose v₀ hv₀ using hlift
  set ψ : (Fin t → MvPolynomial (Fin n) ↥R₀) →ₗ[MvPolynomial (Fin n) ↥R₀]
      (Fin t → MvPolynomial (Fin n) R) :=
    LinearMap.pi fun i => (Algebra.linearMap (MvPolynomial (Fin n) ↥R₀)
      (MvPolynomial (Fin n) R)).comp (LinearMap.proj i) with hψdef
  have hψ : IsBaseChange (MvPolynomial (Fin n) R) ψ := hψdef ▸ isBaseChange_pi t
  set K₀ : Submodule (MvPolynomial (Fin n) ↥R₀) (Fin t → MvPolynomial (Fin n) ↥R₀) :=
    Submodule.span _ (Set.range v₀) with hK₀
  have hψv : ∀ i, ψ (v₀ i) = (i : Fin t → MvPolynomial (Fin n) R) := by
    intro i
    funext j
    rw [hψdef]
    exact hv₀ i j
  have hKspan : K = Submodule.span (MvPolynomial (Fin n) R) (ψ '' K₀) := by
    rw [hK₀, span_image_span, ← hw]
    congr 1
    rw [← Set.range_comp]
    refine Set.Subset.antisymm (fun y hy => ?_) (fun x hx => ?_)
    · have hyw : y ∈ w := hy
      exact ⟨⟨y, hyw⟩, by simpa only [Function.comp_apply] using hψv ⟨y, hyw⟩⟩
    · obtain ⟨i, rfl⟩ := hx
      simpa only [Function.comp_apply, hψv i, Finset.mem_coe] using i.2
  have hle : K₀ ≤ LinearMap.ker ((K.mkQ.restrictScalars (MvPolynomial (Fin n) ↥R₀)).comp ψ) := by
    intro x hx
    simp only [LinearMap.mem_ker, LinearMap.coe_comp, LinearMap.coe_restrictScalars,
      Function.comp_apply]
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hKspan]
    exact Submodule.subset_span ⟨x, hx, rfl⟩
  have hbcP : IsBaseChange (MvPolynomial (Fin n) R)
      (K₀.liftQ ((K.mkQ.restrictScalars (MvPolynomial (Fin n) ↥R₀)).comp ψ) hle) :=
    isBaseChange_liftQ hψ hKspan _ fun _ => rfl
  let : Module (MvPolynomial (Fin n) ↥R₀) M :=
    Module.compHom M (algebraMap (MvPolynomial (Fin n) ↥R₀) (MvPolynomial (Fin n) R))
  have : IsScalarTower (MvPolynomial (Fin n) ↥R₀) (MvPolynomial (Fin n) R) M :=
    isScalarTower_compHom
  have : IsScalarTower ↥R₀ (MvPolynomial (Fin n) ↥R₀) M := by
    refine IsScalarTower.of_algebraMap_smul fun r x => ?_
    rw [← IsScalarTower.algebraMap_smul (MvPolynomial (Fin n) R),
      ← IsScalarTower.algebraMap_apply ↥R₀ (MvPolynomial (Fin n) ↥R₀) (MvPolynomial (Fin n) R),
      IsScalarTower.algebraMap_apply ↥R₀ R (MvPolynomial (Fin n) R),
      IsScalarTower.algebraMap_smul (MvPolynomial (Fin n) R)]
    rfl
  have hbcM : IsBaseChange (MvPolynomial (Fin n) R)
      ((e.symm.toLinearMap.restrictScalars (MvPolynomial (Fin n) ↥R₀)).comp
        (K₀.liftQ ((K.mkQ.restrictScalars (MvPolynomial (Fin n) ↥R₀)).comp ψ) hle)) :=
    isBaseChange_equiv_comp hbcP e.symm
  have hbcR : IsBaseChange R
      (LinearMap.restrictScalars ↥R₀
        ((e.symm.toLinearMap.restrictScalars (MvPolynomial (Fin n) ↥R₀)).comp
          (K₀.liftQ ((K.mkQ.restrictScalars (MvPolynomial (Fin n) ↥R₀)).comp ψ) hle))) :=
    isBaseChange_restrictScalars_of_isPushout ↥R₀ R (MvPolynomial (Fin n) ↥R₀)
      (MvPolynomial (Fin n) R) hbcM
  have : Module.Finite (MvPolynomial (Fin n) ↥R₀)
      ((Fin t → MvPolynomial (Fin n) ↥R₀) ⧸ K₀) :=
    Module.Finite.of_surjective K₀.mkQ K₀.mkQ_surjective
  obtain ⟨f₀, hf₀, hfree⟩ := Module.exists_ne_zero_free_localizedModule_away
    (R := ↥R₀) (S := MvPolynomial (Fin n) ↥R₀)
    (M := (Fin t → MvPolynomial (Fin n) ↥R₀) ⧸ K₀)
  refine ⟨algebraMap ↥R₀ R f₀, fun h => hf₀ (by simpa using h), ?_⟩
  intro Rf _ _ _ Mf _ _ _ _ g _
  exact free_of_isBaseChange hbcR
    (hfree (Localization.Away f₀)
      (LocalizedModule (Submonoid.powers f₀) ((Fin t → MvPolynomial (Fin n) ↥R₀) ⧸ K₀))
      (LocalizedModule.mkLinearMap (Submonoid.powers f₀) _)) Rf Mf g

end Module.FinitePresentation

