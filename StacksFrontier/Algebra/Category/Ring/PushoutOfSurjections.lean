module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.CategoryTheory.ConcreteCategory.EpiMono
public import StacksFrontier.AlgebraicGeometry.FormalSpace.Affine.CartesianColimit

/-!
# A square of commutative rings with surjective parallel edges is a pushout

A commutative square of rings
```
R --f--> S
|        |
g        a
v        v
T --b--> U
```
in which `f` and `b` are surjective and the kernel of `b` is generated by the image of the kernel
of `f` is a pushout square.  Both conditions are needed: the surjectivity of `b` forces the
comparison map out of `U` to be unique, the surjectivity of `f` transports it across the other
edge, and the identity `ker b = g(ker f) · T` is what lets a cocone descend along `b`.

Over a surjection with kernel `I` the square expresses `U = T ⊗[R] R/I = T/I·T`, which is the
form in which the quotient squares of an inverse system of thickenings, or the squares
`𝒪(U) = 𝒜(U) ⊗_{𝒜(V)} 𝒪(V)` of a square-zero extension of a structure sheaf, are recognised as
cartesian after applying `Spec`.

The converse holds too, and is here as well: in *any* pushout square whose edge `f` is
surjective the opposite edge `b` is surjective and its kernel is generated by the image of
`ker f`.  That is the form in which a pushout square presents `U` as the quotient `T/(ker f)·T`
without the quotient having been built, and it is what lets a consumer holding only a pushout
square read off a surjection with a named kernel.

## Main results

* `AlgebraicGeometry.FormalSpace.CartesianColimit.isPushout_of_surjective_of_ker_eq`: the square
  is a pushout.
* `CommRingCat.surjective_of_isPushout_of_surjective`: **in a pushout square the edge opposite a
  surjection is surjective.**
* `CommRingCat.ker_eq_map_ker_of_isPushout_of_surjective`: **and its kernel is generated by the
  image of the kernel of that surjection**, so the two conditions of
  `AlgebraicGeometry.FormalSpace.CartesianColimit.isPushout_of_surjective_of_ker_eq`
  are not merely sufficient but necessary.

## Implementation notes

The descent along `b` is `RingHom.liftOfSurjective`, which needs exactly `ker b ≤ ker q` for the
cocone leg `q` out of `T`; that inclusion is `Ideal.map_le_iff_le_comap` applied to the
hypothesis on the kernels together with the commutativity of the square.  The square is built
with `CategoryTheory.IsPushout.mk'`, whose two obligations are the uniqueness and the existence
of the comparison map.

The two converses share their whole content, which is the comparison isomorphism
`U ≅ T ⧸ (ker f)·T`: the literal quotient of `T` by the extended ideal sits in a pushout square
over the same span, by
`AlgebraicGeometry.FormalSpace.CartesianColimit.isPushout_of_surjective_of_ker_eq` itself
with `Ideal.mk_ker`, and two pushout squares over one span are identified by
`CategoryTheory.IsPushout.isoIsPushout`.  Surjectivity and the kernel then transfer across an
isomorphism, which is where `CategoryTheory.ConcreteCategory.isIso_iff_bijective` is used.
-/

@[expose] public section

open CategoryTheory Limits
open AlgebraicGeometry.FormalSpace.CartesianColimit (isPushout_of_surjective_of_ker_eq)

universe u

namespace CommRingCat

/-- **The comparison isomorphism of a pushout along a surjection with the literal quotient.**
In a pushout square whose edge `f : R ⟶ S` is surjective, the opposite corner `U` is
`T ⧸ (ker f)·T`, by an isomorphism carrying the edge `b : T ⟶ U` to the quotient map.

The literal quotient sits in a pushout square over the same span by
`AlgebraicGeometry.FormalSpace.CartesianColimit.isPushout_of_surjective_of_ker_eq` — its kernel
condition is `Ideal.mk_ker` and the missing edge out of `S` is `RingHom.liftOfSurjective` — and
two pushout squares over one span are identified by `CategoryTheory.IsPushout.isoIsPushout`. -/
private theorem exists_iso_quotient_of_isPushout_of_surjective
    {R S T U : CommRingCat.{u}} {f : R ⟶ S} {g : R ⟶ T} {a : S ⟶ U} {b : T ⟶ U}
    (H : IsPushout f g a b) (hf : Function.Surjective f.hom) :
    ∃ e : U ≅ CommRingCat.of (T ⧸ (RingHom.ker f.hom).map g.hom),
      b = CommRingCat.ofHom
        (Ideal.Quotient.mk ((RingHom.ker f.hom).map g.hom)) ≫ e.inv := by
  have hle : RingHom.ker f.hom ≤
      RingHom.ker ((Ideal.Quotient.mk ((RingHom.ker f.hom).map g.hom)).comp g.hom) :=
    fun _ hx => Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_map_of_mem _ hx)
  let v : S ⟶ CommRingCat.of (T ⧸ (RingHom.ker f.hom).map g.hom) :=
    CommRingCat.ofHom (f.hom.liftOfSurjective hf
      ⟨(Ideal.Quotient.mk ((RingHom.ker f.hom).map g.hom)).comp g.hom, hle⟩)
  have hw : f ≫ v =
      g ≫ CommRingCat.ofHom (Ideal.Quotient.mk ((RingHom.ker f.hom).map g.hom)) :=
    CommRingCat.hom_ext (RingHom.liftOfSurjective_comp _ _ _)
  have H2 : IsPushout f g v
      (CommRingCat.ofHom (Ideal.Quotient.mk ((RingHom.ker f.hom).map g.hom))) :=
    isPushout_of_surjective_of_ker_eq f g v _ hw hf Ideal.Quotient.mk_surjective
      Ideal.mk_ker
  exact ⟨H.isoIsPushout _ _ H2, (Iso.eq_comp_inv _).2 (H.inr_isoIsPushout_hom _ _ H2)⟩

/-- **In a pushout square of commutative rings the edge opposite a surjection is
surjective.**  This is the converse half of the surjectivity hypothesis of
`AlgebraicGeometry.FormalSpace.CartesianColimit.isPushout_of_surjective_of_ker_eq`: the
corner `U` is the quotient `T ⧸ (ker f)·T`, and `b` is the quotient map up to an isomorphism. -/
theorem surjective_of_isPushout_of_surjective
    {R S T U : CommRingCat.{u}} {f : R ⟶ S} {g : R ⟶ T} {a : S ⟶ U} {b : T ⟶ U}
    (H : IsPushout f g a b) (hf : Function.Surjective f.hom) :
    Function.Surjective b.hom := by
  obtain ⟨e, hb⟩ := exists_iso_quotient_of_isPushout_of_surjective H hf
  rw [hb]
  exact (((ConcreteCategory.isIso_iff_bijective e.inv).mp inferInstance).2).comp
    Ideal.Quotient.mk_surjective

/-- **In a pushout square of commutative rings the kernel of the edge opposite a surjection is
generated by the image of the kernel of that surjection.**  Together with
`CommRingCat.surjective_of_isPushout_of_surjective` this is the exact converse of
`AlgebraicGeometry.FormalSpace.CartesianColimit.isPushout_of_surjective_of_ker_eq`, so that a
consumer holding a pushout square along a surjection may read off the presentation
`U = T ⧸ (ker f)·T` of its fourth corner. -/
theorem ker_eq_map_ker_of_isPushout_of_surjective
    {R S T U : CommRingCat.{u}} {f : R ⟶ S} {g : R ⟶ T} {a : S ⟶ U} {b : T ⟶ U}
    (H : IsPushout f g a b) (hf : Function.Surjective f.hom) :
    RingHom.ker b.hom = (RingHom.ker f.hom).map g.hom := by
  obtain ⟨e, hb⟩ := exists_iso_quotient_of_isPushout_of_surjective H hf
  have hinj : Function.Injective e.inv.hom :=
    ((ConcreteCategory.isIso_iff_bijective e.inv).mp inferInstance).1
  refine Ideal.ext fun x => ?_
  rw [RingHom.mem_ker, hb]
  show e.inv.hom ((Ideal.Quotient.mk ((RingHom.ker f.hom).map g.hom)) x) = 0 ↔ _
  rw [← map_zero e.inv.hom, hinj.eq_iff, Ideal.Quotient.eq_zero_iff_mem]

end CommRingCat

end
