module

public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.CategoryTheory.Limits.Preserves.Filtered
public import Mathlib.CategoryTheory.Limits.Types.Filtered

/-!
# A ring as the filtered colimit of its finite-type `ℤ`-subalgebras

Every commutative ring is the filtered colimit of the finite-type `ℤ`-subalgebras generated by
its finite subsets, the diagram being indexed by `Finset R` under inclusion.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace CommRingCat

/-- The diagram of the finite-type `ℤ`-subalgebras of a ring, indexed by the finite subsets
generating them. -/
def finiteSubalgebras (R : CommRingCat.{u}) : Finset R ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (Algebra.adjoin ℤ (s : Set R))
  map h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom h)))).toRingHom

/-- The cocone on the finite-type `ℤ`-subalgebras of a ring given by their inclusions. -/
def finiteSubalgebrasCocone (R : CommRingCat.{u}) : Cocone (finiteSubalgebras R) where
  pt := R
  ι := { app := fun s ↦ CommRingCat.ofHom (Algebra.adjoin ℤ (s : Set R)).val.toRingHom }

/-- A ring is the filtered colimit of its finite-type `ℤ`-subalgebras: every element lies in the
subalgebra generated by itself, and two elements of a subalgebra agreeing in the ring are
equal. -/
noncomputable def finiteSubalgebrasIsColimit (R : CommRingCat.{u}) :
    IsColimit (finiteSubalgebrasCocone R) := by
  classical
  let := reflectsColimit_of_reflectsIsomorphisms (finiteSubalgebras R) (forget CommRingCat)
  exact isColimitOfReflects (forget CommRingCat) (Types.FilteredColimit.isColimitOf' _ _
    (fun x ↦ ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_singleton_self x)⟩, rfl⟩)
    fun i x y h ↦ ⟨i, 𝟙 i, congrArg _ (Subtype.ext h)⟩)

end CommRingCat

end
