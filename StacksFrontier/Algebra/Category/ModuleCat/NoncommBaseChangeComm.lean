module

public import StacksFrontier.Algebra.Category.ModuleCat.NoncommExtendScalars

/-!
# The relative tensor product along a homomorphism of commutative rings

`Stacks.NoncommChangeOfRings.BaseChange f M` is the relative tensor product `B ⊗[A] M` for an
arbitrary ring homomorphism `f : A →+* B`, as a quotient of `B ⊗[ℤ] M`. When `A` and `B` are
commutative and `f` is the structure map of an algebra, Mathlib's `TensorProduct A B M` is
available as well, and the two are the same module. This file identifies them.

Both constructions are needed: the base-change description of the sections of a pullback of
presheaves of modules is written with `BaseChange`, since a presheaf of rings on a site is not
assumed commutative, while statements about sections of modules on schemes are written with
`TensorProduct`.

## Main definitions

* `Stacks.NoncommChangeOfRings.baseChangeTensorEquiv`: the additive equivalence
  `B ⊗[A] M ≃+ B ⊗[A] M` between the relative tensor product along the structure map of a
  commutative algebra and Mathlib's tensor product, carrying `tmul b m` to `b ⊗ₜ m`. Both sides
  are `B`-modules and the map is `B`-linear, but only the additive structure is recorded.

## Main results

* `Stacks.NoncommChangeOfRings.baseChangeTensorEquiv_tmul` and
  `Stacks.NoncommChangeOfRings.baseChangeTensorEquiv_symm_tmul`: its values on pure tensors.
-/

@[expose] public section

open scoped TensorProduct

namespace Stacks.NoncommChangeOfRings

universe u₁ u₂ v

variable {A : Type u₁} [CommRing A] {B : Type u₂} [CommRing B] [Algebra A B]
  {M : Type v} [AddCommGroup M] [Module A M]

/-- The unit `m ↦ 1 ⊗ m` of Mathlib's tensor product, as a map semilinear over the structure
map of the algebra. -/
def tensorUnitₛₗ : M →ₛₗ[algebraMap A B] B ⊗[A] M where
  toFun m := (1 : B) ⊗ₜ[A] m
  map_add' m m' := TensorProduct.tmul_add _ m m'
  map_smul' a m := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, ← TensorProduct.smul_tmul,
      ← Algebra.algebraMap_eq_smul_one]

/-- `Stacks.NoncommChangeOfRings.tensorUnitₛₗ` sends `m` to `1 ⊗ₜ m`. -/
@[simp]
theorem tensorUnitₛₗ_apply (m : M) : tensorUnitₛₗ (A := A) (B := B) m = (1 : B) ⊗ₜ[A] m := rfl

/-- The map `B ⊗[A] M ⟶ B ⊗[A] M` from the relative tensor product of
`Stacks.NoncommChangeOfRings.BaseChange` to Mathlib's, `b ⊗ m ↦ b ⊗ m`. -/
def toTensor : BaseChange (algebraMap A B) M →ₗ[B] B ⊗[A] M :=
  desc (algebraMap A B) tensorUnitₛₗ

/-- `Stacks.NoncommChangeOfRings.toTensor` sends `tmul b m` to `b ⊗ₜ m`. -/
@[simp]
theorem toTensor_tmul (b : B) (m : M) :
    toTensor (A := A) (tmul (algebraMap A B) b m) = b ⊗ₜ[A] m := by
  rw [toTensor, desc_tmul, tensorUnitₛₗ_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]

/-- The biadditive map underlying `Stacks.NoncommChangeOfRings.ofTensor`. -/
def ofTensorAux : B →+ M →+ BaseChange (algebraMap A B) M where
  toFun b :=
    { toFun m := tmul (algebraMap A B) b m
      map_zero' := tmul_zero _ b
      map_add' := tmul_add _ b }
  map_zero' := AddMonoidHom.ext fun m => zero_tmul (algebraMap A B) m
  map_add' b b' := AddMonoidHom.ext fun m => add_tmul (algebraMap A B) b b' m

/-- The map `B ⊗[A] M ⟶ B ⊗[A] M` from Mathlib's tensor product to the relative tensor product
of `Stacks.NoncommChangeOfRings.BaseChange`, `b ⊗ m ↦ b ⊗ m`. -/
def ofTensor : B ⊗[A] M →+ BaseChange (algebraMap A B) M :=
  TensorProduct.liftAddHom ofTensorAux fun a b m => by
    change tmul (algebraMap A B) (a • b) m = tmul (algebraMap A B) b (a • m)
    rw [Algebra.smul_def, mul_comm, tmul_smul]

/-- `Stacks.NoncommChangeOfRings.ofTensor` sends `b ⊗ₜ m` to `tmul b m`. -/
@[simp]
theorem ofTensor_tmul (b : B) (m : M) :
    ofTensor (b ⊗ₜ[A] m) = tmul (algebraMap A B) b m := rfl

/-- The relative tensor product along the structure map of a commutative algebra is additively
equivalent to Mathlib's tensor product, by the map carrying `tmul b m` to `b ⊗ₜ m`. Both are
generated by pure tensors subject to the same relations, and the two maps carrying pure tensors to
pure tensors are mutually inverse. -/
def baseChangeTensorEquiv : BaseChange (algebraMap A B) M ≃+ B ⊗[A] M where
  toFun := ⇑(toTensor (A := A) (M := M))
  invFun := ⇑(ofTensor (A := A) (M := M))
  map_add' := (toTensor (A := A) (M := M)).map_add
  left_inv x := by
    refine induction_on (algebraMap A B)
      (motive := fun x => ofTensor (toTensor (A := A) x) = x) x ?_ (fun b m => ?_)
      (fun y z hy hz => ?_)
    · rw [map_zero, map_zero]
    · rw [toTensor_tmul, ofTensor_tmul]
    · rw [map_add, map_add, hy, hz]
  right_inv z := by
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul b m => rw [ofTensor_tmul, toTensor_tmul]
    | add z z' hz hz' => rw [map_add, map_add, hz, hz']

/-- `Stacks.NoncommChangeOfRings.baseChangeTensorEquiv` sends `tmul b m` to `b ⊗ₜ m`. -/
@[simp]
theorem baseChangeTensorEquiv_tmul (b : B) (m : M) :
    baseChangeTensorEquiv (A := A) (tmul (algebraMap A B) b m) = b ⊗ₜ[A] m :=
  toTensor_tmul b m

/-- The inverse of `Stacks.NoncommChangeOfRings.baseChangeTensorEquiv` sends `b ⊗ₜ m` to
`tmul b m`. -/
@[simp]
theorem baseChangeTensorEquiv_symm_tmul (b : B) (m : M) :
    (baseChangeTensorEquiv (A := A) (M := M)).symm (b ⊗ₜ[A] m) =
      tmul (algebraMap A B) b m := rfl

end Stacks.NoncommChangeOfRings

end
