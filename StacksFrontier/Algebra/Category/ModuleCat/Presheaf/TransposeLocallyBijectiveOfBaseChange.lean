module

public import Mathlib.CategoryTheory.Sites.LocallyBijective
public import StacksFrontier.Algebra.Category.ModuleCat.Presheaf.CartesianRestriction
public import StacksFrontier.AlgebraicGeometry.Crystalline.SmallSite.ComparisonSurjectivity
public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.RestrictScalarsBaseChange

/-!
# Local bijectivity of the transpose of a comparison with a direct image, from base changes

Let `F : C ⥤ D` be a functor, `φ : S ⟶ F.op ⋙ R` a morphism of presheaves of commutative rings,
`P` a presheaf of `S`-modules on `C`, `Q` a presheaf of `R`-modules on `D` and
`ψ : P ⟶ (pushforward φ).obj Q` a comparison with the direct image. Its transpose
`ψ^♯ : (pullback φ).obj P ⟶ Q` has no description on sections: Mathlib's `pullback` is only the
left adjoint of the direct image. This file shows that `ψ^♯` is nevertheless locally injective
and locally surjective for a Grothendieck topology on `D` as soon as the *base change maps*

`R(W) ⊗_{S(V)} P(V) ⟶ Q(W)`,  `o ⊗ g ↦ o • Q(a)(ψ g)`,

attached to the arrows `a : W ⟶ F(V)` of a "good" class are injective, resp. surjective, provided
the good arrows are numerous enough: every object of `D` is covered by sources of good arrows,
every `F(V)` is covered by good arrows factoring through `F` of an arrow into `V`, and two good
arrows out of one object are locally dominated by a third.

The input that makes this work with no description of the pullback is the generation statement
`PresheafOfModules.generatedSubmodule_unit_eq_top`: the pullback is generated by the image of the
unit. The sections which, locally, lie in the image of the base change map of a good arrow form a
sub-presheaf of modules containing that image, hence everything; and on such sections `ψ^♯` is
read through the base change maps.

This is the shape of the flat base change property of Stacks 0762 for the comparison `c_φ` of
Stacks 06WC: the good arrows are those between affine objects of small étale sites, and the base
change maps are those of quasi-coherent modules.

## Main definitions

* `PresheafOfModules.TransposeLocalization.pairRingHom`: the ring map `S(V) ⟶ R(W)` along an arrow
  `a : W ⟶ F(V)`.
* `PresheafOfModules.TransposeLocalization.pairBaseChange`: the base change map
  `R(W) ⊗_{S(V)} P(V) ⟶ Q(W)` of `ψ` along `a`.

## Main results

* `PresheafOfModules.TransposeLocalization.isLocallyInjective_transpose`: the transpose is locally
  injective when the base change maps of the good arrows are injective.
* `PresheafOfModules.TransposeLocalization.isLocallySurjective_transpose`: the transpose is
  locally surjective when they are surjective.
* `PresheafOfModules.TransposeLocalization.isLocallyGood`: every section of the pullback lies
  locally in the image of the base change map of a good arrow.

## References

* [Stacks Project, Tag 06WC](https://stacks.math.columbia.edu/tag/06WC)
* [Stacks Project, Tag 0762](https://stacks.math.columbia.edu/tag/0762)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe v v₁ v₂ u₁ u₂ u

namespace PresheafOfModules.TransposeLocalization

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] {F : C ⥤ D}
  {R : Dᵒᵖ ⥤ CommRingCat.{u}} {S : Cᵒᵖ ⥤ CommRingCat.{u}}
  (φ : S ⋙ forget₂ CommRingCat RingCat ⟶ F.op ⋙ R ⋙ forget₂ CommRingCat RingCat)

/-- The ring map `S(V) ⟶ R(W)` along an arrow `a : W ⟶ F(V)`: the component of `φ` at `V`
followed by the restriction of `R` along `a`. -/
def pairRingHom {W : D} {V : C} (a : W ⟶ F.obj V) : S.obj (op V) →+* R.obj (op W) :=
  (R.map a.op).hom.comp ((φ.app (op V)).hom : S.obj (op V) →+* R.obj (op (F.obj V)))

/-- The ring map along `a` sends `s` to the restriction along `a` of `φ` applied to `s`. -/
theorem pairRingHom_apply {W : D} {V : C} (a : W ⟶ F.obj V) (s : S.obj (op V)) :
    pairRingHom φ a s = R.map a.op (φ.app (op V) s) :=
  rfl

variable {P : PresheafOfModules.{max v u} (S ⋙ forget₂ CommRingCat RingCat)}
  {Q : PresheafOfModules.{max v u} (R ⋙ forget₂ CommRingCat RingCat)}
  (ψ : P ⟶ (pushforward.{max v u} φ).obj Q)

/-- The component of `ψ` at `V`, with values read in the sections of `Q` over `F(V)`. -/
abbrev comp (V : C) (m : P.obj (op V)) : Q.obj (op (F.obj V)) :=
  ψ.app (op V) m

/-- The restriction of `Q` along an arrow `a : W ⟶ W'`, with values read in the sections of
`Q` over `W`. -/
abbrev res {W W' : D} (a : W ⟶ W') (y : Q.obj (op W')) : Q.obj (op W) :=
  Q.map a.op y

omit ψ in
/-- Restriction along `a` is additive. -/
theorem res_add {W W' : D} (a : W ⟶ W') (y y' : Q.obj (op W')) :
    res a (y + y') = res a y + res a y' :=
  map_add (Q.map a.op).hom y y'

omit ψ in
/-- Restriction along `a` commutes with subtraction. -/
theorem res_sub {W W' : D} (a : W ⟶ W') (y y' : Q.obj (op W')) :
    res a (y - y') = res a y - res a y' :=
  map_sub (Q.map a.op).hom y y'

omit ψ in
/-- Restriction along the identity is the identity. -/
theorem res_id {W : D} (y : Q.obj (op W)) : res (𝟙 W) y = y := by
  change Q.map (𝟙 W).op y = y
  rw [op_id, PresheafOfModules.map_id]
  rfl

omit ψ in
/-- Restriction along `a` is semilinear over the restriction of `R` along `a`. -/
theorem res_smul {W W' : D} (a : W ⟶ W') (r : R.obj (op W')) (y : Q.obj (op W')) :
    res a (r • y) = (R.map a.op r) • res a y :=
  PresheafOfModules.map_smul Q a.op r y

/-- The component of `ψ` at `V` is additive. -/
theorem comp_add (V : C) (m m' : P.obj (op V)) :
    comp φ ψ V (m + m') = comp φ ψ V m + comp φ ψ V m' :=
  map_add (ψ.app (op V)).hom m m'

/-- The component of `ψ` at `V` is semilinear over the component of `φ` at `V`. -/
theorem comp_smul (V : C) (s : S.obj (op V)) (m : P.obj (op V)) :
    comp φ ψ V (s • m) = (φ.app (op V) s) • comp φ ψ V m :=
  (ψ.app (op V)).hom.map_smul s m

/-- The semilinear map `P(V) ⟶ Q(W)`, `g ↦ Q(a)(ψ g)`, along an arrow `a : W ⟶ F(V)`. -/
def pairGenerator {W : D} {V : C} (a : W ⟶ F.obj V) :
    (P.obj (op V) : ModuleCat (S.obj (op V))) ⟶
      (ModuleCat.restrictScalars (pairRingHom φ a)).obj (Q.obj (op W) : ModuleCat (R.obj (op W))) :=
  ModuleCat.ofHom (X := (P.obj (op V) : ModuleCat (S.obj (op V))))
    (Y := (ModuleCat.restrictScalars (pairRingHom φ a)).obj
      (Q.obj (op W) : ModuleCat (R.obj (op W))))
    { toFun := fun m => res a (comp φ ψ V m)
      map_add' := fun m m' => by
        change res a (comp φ ψ V (m + m')) =
          res a (comp φ ψ V m) + res a (comp φ ψ V m')
        rw [comp_add, res_add]
      map_smul' := fun s m => by
        change res a (comp φ ψ V (s • m)) =
          (pairRingHom φ a s) • res (Q := Q) a (comp φ ψ V m)
        rw [comp_smul, res_smul]
        rfl }

/-- The map `pairGenerator` sends `m` to the restriction along `a` of `ψ m`. -/
theorem pairGenerator_apply {W : D} {V : C} (a : W ⟶ F.obj V) (m : P.obj (op V)) :
    pairGenerator φ ψ a m = res a (comp φ ψ V m) :=
  rfl

/-- **The base change map** `R(W) ⊗_{S(V)} P(V) ⟶ Q(W)`, `o ⊗ g ↦ o • Q(a)(ψ g)`, of the
comparison `ψ` along an arrow `a : W ⟶ F(V)`: the adjoint transpose of `pairGenerator` under
extension and restriction of scalars. -/
def pairBaseChange {W : D} {V : C} (a : W ⟶ F.obj V) :
    (ModuleCat.extendScalars (pairRingHom φ a)).obj (P.obj (op V) : ModuleCat (S.obj (op V))) ⟶
      (Q.obj (op W) : ModuleCat (R.obj (op W))) :=
  ((ModuleCat.extendRestrictScalarsAdj (pairRingHom φ a)).homEquiv _ _).symm (pairGenerator φ ψ a)

open scoped ChangeOfRings in
/-- The base change map on a pure tensor. -/
theorem pairBaseChange_tmul {W : D} {V : C} (a : W ⟶ F.obj V) (o : R.obj (op W))
    (m : P.obj (op V)) :
    (pairBaseChange φ ψ a).hom (o ⊗ₜ[S.obj (op V), pairRingHom φ a] m) =
      o • res a (comp φ ψ V m) := by
  let adj := ModuleCat.extendRestrictScalarsAdj (pairRingHom φ a)
  have hone : (pairBaseChange φ ψ a).hom ((1 : R.obj (op W)) ⊗ₜ[S.obj (op V), pairRingHom φ a] m) =
      res a (comp φ ψ V m) :=
    congrArg (fun g => g m) ((adj.homEquiv _ _).apply_symm_apply (pairGenerator φ ψ a))
  have hsm := (pairBaseChange φ ψ a).hom.map_smul o
    ((1 : R.obj (op W)) ⊗ₜ[S.obj (op V), pairRingHom φ a] m)
  exact (congrArg (fun c => (pairBaseChange φ ψ a).hom
      (c ⊗ₜ[S.obj (op V), pairRingHom φ a] m)) (mul_one o).symm).trans
    (hsm.trans (congrArg (fun z => o • z) hone))

open scoped ChangeOfRings in
/-- The image of the base change map is the `R(W)`-submodule spanned by the restrictions along
`a` of the image of `ψ`. -/
theorem range_pairBaseChange {W : D} {V : C} (a : W ⟶ F.obj V) :
    LinearMap.range (pairBaseChange φ ψ a).hom =
      Submodule.span (R.obj (op W)) (Set.range fun m => res a (comp φ ψ V m)) := by
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    induction z using TensorProduct.inductionOn with
    | tmul o m =>
      refine (congrArg (· ∈ Submodule.span (R.obj (op W))
        (Set.range fun m => res a (comp φ ψ V m))) (pairBaseChange_tmul φ ψ a o m)).mpr ?_
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨m, rfl⟩)
    | add z w hz hw =>
      refine (congrArg (· ∈ Submodule.span (R.obj (op W))
        (Set.range fun m => res a (comp φ ψ V m))) (map_add (pairBaseChange φ ψ a).hom z w)).mpr ?_
      exact Submodule.add_mem _ hz hw
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨m, rfl⟩
    exact ⟨(1 : R.obj (op W)) ⊗ₜ[S.obj (op V), pairRingHom φ a] m,
      (pairBaseChange_tmul φ ψ a 1 m).trans (one_smul _ _)⟩

omit ψ in
/-- Restriction along `a` after restriction along `b` is restriction along `a ≫ b`. -/
theorem res_comp {W W' W'' : D} (a : W ⟶ W') (b : W' ⟶ W'') (y : Q.obj (op W'')) :
    res a (res b y) = res (a ≫ b) y := by
  change Q.map a.op (Q.map b.op y) = Q.map (a ≫ b).op y
  rw [op_comp, PresheafOfModules.map_comp_apply]

/-- The component of `ψ` commutes with the restriction maps: `ψ` is a morphism into the direct
image. -/
theorem comp_naturality {V V' : C} (b : V' ⟶ V) (m : P.obj (op V)) :
    comp φ ψ V' (P.map b.op m) = res (F.map b) (comp φ ψ V m) :=
  congrArg (fun f => f m) (congrArg (fun g => (ConcreteCategory.hom g)) (ψ.naturality b.op))

/-- **Restricting the image of a base change map.** If `a' : W' ⟶ F(V')` dominates the
restriction along `t : W' ⟶ W` of `a : W ⟶ F(V)`, through `b : V' ⟶ V`, the restriction along
`t` carries the image of the base change map of `a` into the image of that of `a'`. -/
theorem res_mem_range_pairBaseChange {W W' : D} {V V' : C} (a : W ⟶ F.obj V)
    (a' : W' ⟶ F.obj V') (t : W' ⟶ W) (b : V' ⟶ V) (hab : a' ≫ F.map b = t ≫ a)
    {y : Q.obj (op W)} (hy : y ∈ LinearMap.range (pairBaseChange φ ψ a).hom) :
    res t y ∈ LinearMap.range (pairBaseChange φ ψ a').hom := by
  rw [range_pairBaseChange] at hy ⊢
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨m, rfl⟩ := hy
    refine Submodule.subset_span ⟨P.map b.op m, ?_⟩
    change res a' (comp φ ψ V' (P.map b.op m)) = res t (res a (comp φ ψ V m))
    rw [comp_naturality, res_comp, res_comp, hab]
  | zero => exact (congrArg (· ∈ _) (map_zero (Q.map t.op).hom)).mpr (Submodule.zero_mem _)
  | add y y' _ _ hy hy' =>
    rw [res_add]
    exact Submodule.add_mem _ hy hy'
  | smul r y _ hy =>
    rw [res_smul]
    exact Submodule.smul_mem _ _ hy

section Transpose

variable [(pushforward.{max v u} φ).IsRightAdjoint]

/-- The transpose `ψ^♯ : (pullback φ).obj P ⟶ Q` of `ψ`. -/
abbrev transpose : (pullback.{max v u} φ).obj P ⟶ Q :=
  ((pullbackPushforwardAdjunction.{max v u} φ).homEquiv P Q).symm ψ

variable (P) in
/-- The unit `P ⟶ (pushforward φ).obj ((pullback φ).obj P)` of the pullback. -/
abbrev unitPullback : P ⟶ (pushforward.{max v u} φ).obj ((pullback.{max v u} φ).obj P) :=
  (pullbackPushforwardAdjunction.{max v u} φ).unit.app P

/-- The transpose sends the image of the unit to the image of `ψ`. -/
theorem transpose_comp_unitPullback (V : C) (m : P.obj (op V)) :
    (transpose φ ψ).app (op (F.obj V)) (comp φ (unitPullback φ P) V m) = comp φ ψ V m := by
  have h := (pullbackPushforwardAdjunction.{max v u} φ).homEquiv_unit (X := P) (Y := Q)
    (f := transpose φ ψ)
  rw [Equiv.apply_symm_apply] at h
  exact (congrArg (fun g => (ConcreteCategory.hom (g.app (op V))) m) h).symm

/-- The transpose of `ψ` carries the base change map of the unit to the base change map of
`ψ`. -/
theorem transpose_pairBaseChange_unitPullback {W : D} {V : C} (a : W ⟶ F.obj V)
    (z : (ModuleCat.extendScalars (pairRingHom φ a)).obj
      (P.obj (op V) : ModuleCat (S.obj (op V)))) :
    (transpose φ ψ).app (op W) ((pairBaseChange φ (unitPullback φ P) a).hom z) =
      (pairBaseChange φ ψ a).hom z := by
  induction z using TensorProduct.inductionOn with
  | tmul o m =>
    refine (congrArg _ (pairBaseChange_tmul φ (unitPullback φ P) a o m)).trans ?_
    refine Eq.trans ?_ (pairBaseChange_tmul φ ψ a o m).symm
    refine ((transpose φ ψ).app (op W)).hom.map_smul o _ |>.trans ?_
    congr 1
    exact (PresheafOfModules.naturality_apply (transpose φ ψ) a.op _).trans
      (congrArg (res a) (transpose_comp_unitPullback φ ψ V m))
  | add z w hz hw =>
    refine (congrArg _ (map_add (pairBaseChange φ (unitPullback φ P) a).hom z w)).trans ?_
    refine (map_add _ _ _).trans ?_
    exact (congrArg₂ (· + ·) hz hw).trans (map_add (pairBaseChange φ ψ a).hom z w).symm

end Transpose


section RingSquare

open scoped ChangeOfRings

/-- **Base change maps along a square of rings with invertible vertical maps.** Let
`a : A ⟶ A'` and `b : B ⟶ B'` be ring maps and `α : A ≃ B`, `β : A' ≃ B'` ring isomorphisms with
`β ∘ a = b ∘ α`, let `g : M ⟶ N` be `b`-semilinear between a `B`-module and a `B'`-module, and let
`g'` be the same map read as `a`-semilinear through `α` and `β`. If the base change map
`B' ⊗_B M ⟶ N` of `g` is bijective, so is the base change map `A' ⊗_A M ⟶ N` of `g'`. -/
theorem bijective_homEquiv_symm_of_ringEquiv {A A' B B' : Type u} [CommRing A] [CommRing A']
    [CommRing B] [CommRing B'] (a : A →+* A') (b : B →+* B') (α : A ≃+* B) (β : A' ≃+* B')
    (hsq : ∀ t, β (a t) = b (α t)) (αh : A →+* B) (βh : A' →+* B')
    (hα : ∀ t, α t = αh t) (hβ : ∀ t, β t = βh t)
    {M : ModuleCat.{max v u} B} {N : ModuleCat.{max v u} B'}
    (g : M ⟶ (ModuleCat.restrictScalars b).obj N)
    (g' : (ModuleCat.restrictScalars αh).obj M ⟶
      (ModuleCat.restrictScalars a).obj ((ModuleCat.restrictScalars βh).obj N))
    (hg : ∀ m : M, (g' m : N) = (g m : N))
    (hb : Function.Bijective
      (((ModuleCat.extendRestrictScalarsAdj b).homEquiv _ _).symm g).hom) :
    Function.Bijective
      (((ModuleCat.extendRestrictScalarsAdj a).homEquiv _ _).symm g').hom := by
  let _ : Module A A' := Module.compHom _ a
  let _ : Module B B' := Module.compHom _ b
  let _ : Module A M := Module.compHom _ αh
  let uu := Stacks.RingSquare.tensorMap (P := M) a b α β hsq (fun _ _ => rfl) (fun _ _ => rfl)
    (fun t x => by
      change αh t • x = α t • x
      rw [hα])
  have hu : Function.Bijective uu := Stacks.RingSquare.bijective_tensorMap _ _ _ _ _ _ _ _
  let κb := ((ModuleCat.extendRestrictScalarsAdj b).homEquiv _ _).symm g
  let κa := ((ModuleCat.extendRestrictScalarsAdj a).homEquiv _ _).symm g'
  have hone : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (f : R →+* R')
      {X : ModuleCat.{max v u} R}
      {Y : ModuleCat.{max v u} R'} (k : X ⟶ (ModuleCat.restrictScalars f).obj Y) (c : R') (x : X),
      ((ModuleCat.extendRestrictScalarsAdj f).homEquiv _ _).symm k (c ⊗ₜ[R, f] x) = c • k x := by
    intro R R' _ _ f X Y k c x
    have h1 : ((ModuleCat.extendRestrictScalarsAdj f).homEquiv _ _).symm k
        ((1 : R') ⊗ₜ[R, f] x) = k x :=
      congrArg (fun l => l x)
        (((ModuleCat.extendRestrictScalarsAdj f).homEquiv _ _).apply_symm_apply k)
    have hsm := (((ModuleCat.extendRestrictScalarsAdj f).homEquiv _ _).symm k).hom.map_smul c
      ((1 : R') ⊗ₜ[R, f] x)
    exact (congrArg (fun d => (((ModuleCat.extendRestrictScalarsAdj f).homEquiv _ _).symm k).hom
      (d ⊗ₜ[R, f] x)) (mul_one c).symm).trans (hsm.trans (congrArg (fun z => c • z) h1))
  have hcomp : ∀ z, κb.hom (uu z) = κa.hom z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul c m =>
      refine (hone b g (β c) m).trans ?_
      refine Eq.trans ?_ (hone a g' c m).symm
      rw [hβ c]
      exact congrArg (fun y : N => βh c • y) (hg m).symm
    | add z z' hz hz' =>
      refine Eq.trans (congrArg _ (map_add uu z z')) ?_
      refine (map_add κb.hom _ _).trans ?_
      exact (congrArg₂ (· + ·) hz hz').trans (map_add κa.hom z z').symm
  refine ⟨fun z₁ z₂ hz => hu.1 (hb.1 ((hcomp z₁).trans (hz.trans (hcomp z₂).symm))),
    fun y => ?_⟩
  obtain ⟨w', hw'⟩ := hb.2 y
  obtain ⟨z, hz⟩ := hu.2 w'
  exact ⟨z, (hcomp z).symm.trans ((congrArg κb.hom hz).trans hw')⟩

end RingSquare

section Covering

variable {C' : Type*} [Category* C'] (J : GrothendieckTopology C')

/-- A presieve generating a covering sieve, followed on each of its arrows by a presieve generating
a covering sieve, generates a covering sieve. -/
theorem generate_bind_mem {X : C'} {P : Presieve X} (hP : Sieve.generate P ∈ J X)
    {R : ∀ ⦃Y : C'⦄ ⦃f : Y ⟶ X⦄, P f → Presieve Y}
    (hR : ∀ ⦃Y : C'⦄ ⦃f : Y ⟶ X⦄ (h : P f), Sieve.generate (R h) ∈ J Y) :
    Sieve.generate (Presieve.bind P R) ∈ J X := by
  refine J.transitive hP _ fun Y f hf => ?_
  obtain ⟨Z, e, t, ht, rfl⟩ := hf
  refine J.superset_covering ?_ (J.pullback_stable e (hR ht))
  rintro W g ⟨W', e', r, hr, hgr⟩
  exact ⟨W', e', r ≫ t, ⟨Z, r, t, ht, hr, rfl⟩, by rw [← Category.assoc, hgr, Category.assoc]⟩

/-- If the objects with a property `Aff` cover every object, the arrows of a covering sieve with
source satisfying `Aff` generate a covering sieve. -/
theorem generate_aff_mem {Aff : C' → Prop}
    (hAff : ∀ X : C', Sieve.generate (fun (Y : C') (_ : Y ⟶ X) => Aff Y) ∈ J X)
    {X : C'} {T : Sieve X} (hT : T ∈ J X) :
    Sieve.generate (fun (Y : C') (f : Y ⟶ X) => Aff Y ∧ T f) ∈ J X := by
  refine J.transitive hT _ fun Y f hf => ?_
  refine J.superset_covering ?_ (hAff Y)
  rintro W g ⟨W', e, g', hg', rfl⟩
  exact ⟨W', e, g' ≫ f, ⟨hg', T.downward_closed hf g'⟩, by rw [Category.assoc]⟩

end Covering

section Local

variable [(pushforward.{max v u} φ).IsRightAdjoint] (J : GrothendieckTopology D)
  (Aff : D → Prop) (Good : ∀ {W : D} {V : C}, (W ⟶ F.obj V) → Prop)

/-- **The hypotheses on the good arrows.** `Aff` is a class of objects of `D` covering every
object; a good arrow has source in `Aff` and stays good after precomposition with an arrow from
an object of `Aff`; the sources of good arrows cover every object; every `F(V)` is covered by good
arrows factoring through `F` of an arrow into `V`; and two good arrows out of one object are
dominated, on a covering of it, by a third. -/
structure GoodArrows : Prop where
  /-- The objects satisfying `Aff` cover every object of `D`. -/
  aff_cover : ∀ W : D, Sieve.generate (fun (W₀ : D) (_ : W₀ ⟶ W) => Aff W₀) ∈ J W
  /-- The source of a good arrow satisfies `Aff`. -/
  aff_of_good : ∀ {W : D} {V : C} (a : W ⟶ F.obj V), Good a → Aff W
  /-- Precomposing a good arrow with an arrow whose source satisfies `Aff` gives a good arrow. -/
  good_comp : ∀ {W W' : D} {V : C} (g : W' ⟶ W) (a : W ⟶ F.obj V), Good a → Aff W' →
    Good (g ≫ a)
  /-- The sources of good arrows cover every object of `D`. -/
  cover : ∀ W : D, Sieve.generate (fun (W₀ : D) (_ : W₀ ⟶ W) =>
    ∃ (V₀ : C) (a₀ : W₀ ⟶ F.obj V₀), Good a₀) ∈ J W
  /-- Every `F.obj V` is covered by good arrows followed by `F.map` of an arrow into `V`. -/
  gen : ∀ V : C, Sieve.generate (fun (W₀ : D) (t : W₀ ⟶ F.obj V) =>
    ∃ (V₀ : C) (a₀ : W₀ ⟶ F.obj V₀) (b : V₀ ⟶ V), Good a₀ ∧ a₀ ≫ F.map b = t) ∈ J (F.obj V)
  /-- Two good arrows out of `W` are dominated, on a covering of `W`, by a third good arrow. -/
  pair : ∀ {W : D} {V₁ V₂ : C} (a₁ : W ⟶ F.obj V₁) (a₂ : W ⟶ F.obj V₂), Good a₁ → Good a₂ →
    Sieve.generate (fun (W₀ : D) (t : W₀ ⟶ W) => ∃ (V₀ : C) (a₀ : W₀ ⟶ F.obj V₀) (b₁ : V₀ ⟶ V₁)
      (b₂ : V₀ ⟶ V₂), Good a₀ ∧ a₀ ≫ F.map b₁ = t ≫ a₁ ∧ a₀ ≫ F.map b₂ = t ≫ a₂) ∈ J W

variable (P) in
/-- A section of the pullback **lies locally in the image of good base change maps** when the
arrows along which its restriction lies in the image of the base change map of the unit along a
good arrow generate a covering sieve. -/
def IsLocallyGood {W : D} (s : ((pullback.{max v u} φ).obj P).obj (op W)) : Prop :=
  Sieve.generate (fun (W₀ : D) (t : W₀ ⟶ W) => ∃ (V₀ : C) (a₀ : W₀ ⟶ F.obj V₀), Good a₀ ∧
    res t s ∈ LinearMap.range (pairBaseChange φ (unitPullback φ P) a₀).hom) ∈ J W

variable {J Aff Good}

/-- Restriction of a good image along an arrow from an object of `Aff`. -/
theorem res_mem_range_of_good (hG : GoodArrows J Aff Good) {W W' : D} {V : C}
    (a : W ⟶ F.obj V) (ha : Good a) (g : W' ⟶ W) (hW' : Aff W')
    {y : ((pullback.{max v u} φ).obj P).obj (op W)}
    (hy : y ∈ LinearMap.range (pairBaseChange φ (unitPullback φ P) a).hom) :
    ∃ (V₀ : C) (a₀ : W' ⟶ F.obj V₀), Good a₀ ∧
      res g y ∈ LinearMap.range (pairBaseChange φ (unitPullback φ P) a₀).hom :=
  ⟨V, g ≫ a, hG.good_comp g a ha hW',
    res_mem_range_pairBaseChange φ (unitPullback φ P) a (g ≫ a) g (𝟙 V)
      (by rw [F.map_id, Category.comp_id]) hy⟩

variable (P J Aff Good) in
/-- **The sections lying locally in the image of good base change maps**, as a sub-presheaf of
modules of the pullback. -/
def goodSubmodule (hG : GoodArrows J Aff Good) : ((pullback.{max v u} φ).obj P).Submodule where
  obj X :=
    { carrier := {s | IsLocallyGood φ P J Good (W := X.unop) s}
      add_mem' := by
        intro s₁ s₂ h₁ h₂
        have hR := generate_aff_mem J hG.aff_cover (J.intersection_covering h₁ h₂)
        refine J.superset_covering ?_ (generate_bind_mem J hR (R := fun W₁ f hf =>
          fun (W₀ : D) (t : W₀ ⟶ W₁) => ∃ (V₀ : C) (a₀ : W₀ ⟶ F.obj V₀), Good a₀ ∧
            res t (res f s₁) ∈ LinearMap.range (pairBaseChange φ (unitPullback φ P) a₀).hom ∧
            res t (res f s₂) ∈ LinearMap.range (pairBaseChange φ (unitPullback φ P) a₀).hom)
          fun W₁ f hf => ?_)
        · rintro W₀ _ ⟨W₂, e, t, ⟨W₁, t', f, hf, ⟨V₀, a₀, hga₀, hm₁, hm₂⟩, rfl⟩, rfl⟩
          refine ⟨W₂, e, t' ≫ f, ⟨V₀, a₀, hga₀, ?_⟩, rfl⟩
          rw [← res_comp, res_add, res_add]
          exact Submodule.add_mem _ hm₁ hm₂
        · obtain ⟨hW₁, ⟨Z₁, e₁, t₁, ⟨V₁, a₁, hga₁, hm₁⟩, rfl⟩, ⟨Z₂, e₂, t₂, ⟨V₂, a₂, hga₂, hm₂⟩,
            he⟩⟩ := hf
          obtain ⟨Va₁, b₁, hgb₁, hb₁⟩ := res_mem_range_of_good φ hG a₁ hga₁ e₁ hW₁ hm₁
          obtain ⟨Va₂, b₂, hgb₂, hb₂⟩ := res_mem_range_of_good φ hG a₂ hga₂ e₂ hW₁ hm₂
          refine J.superset_covering ?_ (hG.pair b₁ b₂ hgb₁ hgb₂)
          rintro W₀ _ ⟨W₃, e₃, t₃, ⟨V₀, a₀, c₁, c₂, hga₀, hc₁, hc₂⟩, rfl⟩
          refine ⟨W₃, e₃, t₃, ⟨V₀, a₀, hga₀, ?_, ?_⟩, rfl⟩
          · rw [← res_comp e₁ t₁]
            exact res_mem_range_pairBaseChange φ (unitPullback φ P) b₁ a₀ t₃ c₁ hc₁ hb₁
          · rw [← he, ← res_comp e₂ t₂]
            exact res_mem_range_pairBaseChange φ (unitPullback φ P) b₂ a₀ t₃ c₂ hc₂ hb₂
      zero_mem' := by
        refine J.superset_covering ?_ (hG.cover X.unop)
        rintro W₀ _ ⟨W₁, e, t, ⟨V₀, a₀, hga₀⟩, rfl⟩
        exact ⟨W₁, e, t, ⟨V₀, a₀, hga₀,
          (congrArg (· ∈ _) (map_zero (((pullback.{max v u} φ).obj P).map t.op).hom)).mpr
            (Submodule.zero_mem _)⟩, rfl⟩
      smul_mem' := by
        intro r s hs
        refine J.superset_covering ?_ hs
        rintro W₀ _ ⟨W₁, e, t, ⟨V₀, a₀, hga₀, hm⟩, rfl⟩
        refine ⟨W₁, e, t, ⟨V₀, a₀, hga₀, ?_⟩, rfl⟩
        change res t (r • s) ∈ _
        rw [res_smul]
        exact Submodule.smul_mem _ _ hm }
  map {X Y} f := by
    intro s hs
    have hR := generate_aff_mem J hG.aff_cover (J.pullback_stable f.unop hs)
    refine J.superset_covering ?_ hR
    rintro W₀ _ ⟨W₁, e, t, ⟨hW₁, ⟨W₂, e', t', ⟨V₀, a₀, hga₀, hm⟩, het⟩⟩, rfl⟩
    obtain ⟨V₁, a₁, hga₁, hm₁⟩ := res_mem_range_of_good φ hG a₀ hga₀ e' hW₁ hm
    refine ⟨W₁, e, t, ⟨V₁, a₁, hga₁, ?_⟩, rfl⟩
    change res t (res f.unop s) ∈ _
    rw [res_comp, ← het, ← res_comp]
    exact hm₁

/-- **Every section of the pullback lies locally in the image of good base change maps**, as soon
as the good arrows satisfy `PresheafOfModules.TransposeLocalization.GoodArrows`. The good
sections form a sub-presheaf of modules containing the image of the unit, and the pullback is
generated by that image (`PresheafOfModules.generatedSubmodule_unit_eq_top`). -/
theorem isLocallyGood (hG : GoodArrows J Aff Good) {W : D}
    (s : ((pullback.{max v u} φ).obj P).obj (op W)) :
    IsLocallyGood φ P J Good s := by
  have hle : generatedSubmodule φ (unitPullback φ P) ≤ goodSubmodule φ P J Aff Good hG := by
    refine generatedSubmodule_le φ (unitPullback φ P) fun X m => ?_
    refine J.superset_covering ?_ (hG.gen X.unop)
    rintro W₀ _ ⟨W₁, e, t, ⟨V₀, a₀, b, hga₀, hb⟩, rfl⟩
    refine ⟨W₁, e, t, ⟨V₀, a₀, hga₀, ?_⟩, rfl⟩
    rw [range_pairBaseChange]
    refine Submodule.subset_span ⟨P.map b.op m, ?_⟩
    change res a₀ (comp φ (unitPullback φ P) V₀ (P.map b.op m)) =
      res t (comp φ (unitPullback φ P) X.unop m)
    rw [comp_naturality, res_comp, hb]
  rw [generatedSubmodule_unit_eq_top (P := P) φ] at hle
  exact hle (op W) (Submodule.mem_top (x := s))

/-- **The transpose is locally injective** for `J` as soon as the base change maps of the good
arrows are injective, the good arrows satisfying
`PresheafOfModules.TransposeLocalization.GoodArrows`. -/
theorem isLocallyInjective_transpose (hG : GoodArrows J Aff Good)
    (hinj : ∀ {W : D} {V : C} (a : W ⟶ F.obj V), Good a →
      Function.Injective (pairBaseChange φ ψ a).hom) :
    Presheaf.IsLocallyInjective J ((PresheafOfModules.toPresheaf _).map (transpose φ ψ)) := by
  refine ⟨fun {X} x y hxy => ?_⟩
  let M := ((pullback.{max v u} φ).obj P).obj (op X.unop)
  let x' : M := x
  let y' : M := y
  let s : M := x' - y'
  have hc : (transpose φ ψ).app (op X.unop) s = 0 := by
    change ((transpose φ ψ).app (op X.unop)).hom (x' - y') = 0
    rw [map_sub]
    exact sub_eq_zero.2 hxy
  refine J.superset_covering ?_ (isLocallyGood (J := J) (Good := Good) φ hG (W := X.unop) s)
  rintro W₀ _ ⟨W₁, e, t, ⟨V₀, a₀, hga₀, z, hz⟩, rfl⟩
  have hκ : (pairBaseChange φ ψ a₀).hom z = 0 := by
    rw [← transpose_pairBaseChange_unitPullback, hz]
    exact (PresheafOfModules.naturality_apply (transpose φ ψ) t.op s).trans
      ((congrArg (res t) hc).trans (map_zero (Q.map t.op).hom))
  rw [hinj a₀ hga₀ (hκ.trans (map_zero _).symm), map_zero] at hz
  have hsub : res t s = 0 := hz.symm
  change res t (x' - y') = 0 at hsub
  rw [res_sub] at hsub
  change res (e ≫ t) x' = res (e ≫ t) y'
  rw [← res_comp, ← res_comp, sub_eq_zero.1 hsub]

/-- **The transpose is locally surjective** for `J` as soon as the base change maps of the good
arrows are surjective and the sources of the good arrows cover. -/
theorem isLocallySurjective_transpose
    (hsurj : ∀ {W : D} {V : C} (a : W ⟶ F.obj V), Good a →
      Function.Surjective (pairBaseChange φ ψ a).hom)
    (hcov : ∀ W : D, Sieve.generate (fun (W₀ : D) (_ : W₀ ⟶ W) =>
      ∃ (V₀ : C) (a₀ : W₀ ⟶ F.obj V₀), Good a₀) ∈ J W) :
    Presheaf.IsLocallySurjective J ((PresheafOfModules.toPresheaf _).map (transpose φ ψ)) := by
  refine ⟨fun {W} y => ?_⟩
  refine J.superset_covering ?_ (hcov W)
  rintro W₀ _ ⟨W₁, e, t, ⟨V₀, a₀, hga₀⟩, rfl⟩
  obtain ⟨z, hz⟩ := hsurj a₀ hga₀ (res t y)
  exact (Presheaf.imageSieve _ y).downward_closed
    ⟨(pairBaseChange φ (unitPullback φ P) a₀).hom z,
      (transpose_pairBaseChange_unitPullback φ ψ a₀ z).trans hz⟩ e

end Local

end PresheafOfModules.TransposeLocalization

