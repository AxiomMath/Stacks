module

public import Mathlib.RingTheory.TensorProduct.DirectLimitFG
public import Mathlib.SetTheory.Cardinal.Arithmetic
public import StacksFrontier.AlgebraicGeometry.Descent.AssociatedModule.CartesianTransport

/-!
# Small cartesian sub-presheaves of a cartesian presheaf of modules

Let `R` be a presheaf of commutative rings on a category `C` and let `M` be a presheaf of
`R`-modules which is *cartesian*: for every arrow `g : X ⟶ Y` of `Cᵒᵖ` the base-change comparison
`R(Y) ⊗_{R(X)} M(X) ⟶ M(Y)` is an isomorphism.  Suppose `C` is essentially small, presented by a
small family of representatives `r : I → Cᵒᵖ` meeting every isomorphism class.  This file proves
that every section of `M` lies in a cartesian sub-presheaf of modules `K ⊆ M` whose values at the
representatives have cardinality at most a bound `μ` depending only on `C` and `R`.

This is the bounded-generation step of the Grothendieck property of quasi-coherent modules on a
category fibred in groupoids (**Stacks 0781**, part (1)): a quasi-coherent module is a cartesian
presheaf of modules on the affine objects, and the sub-presheaves produced here are again
cartesian, hence again quasi-coherent.

## Implementation notes

A sub-presheaf `K` is cartesian as soon as, along every arrow `g : X ⟶ Y`,

* every section of `K(Y)` is an `R(Y)`-combination of restrictions of sections of `K(X)`, and
* a finite sum `∑ bᵢ ⊗ kᵢ` in `R(Y) ⊗ K(X)` whose image `∑ bᵢ • g^*kᵢ` vanishes in `M(Y)` is
  already zero in `R(Y) ⊗ K(X)`.

Both are finitary, and both can be forced by adding finitely many sections at a time: the first
by adding the coefficients of a presentation of the section, which exists because `M` is
cartesian, and the second by adding the generators of a finitely generated submodule of `M(X)`
over which the sum already vanishes, which exists because tensor products commute with directed
unions of submodules (`TensorProduct.eq_zero_of_fg_of_subtype_eq_zero`).  Doing so for all arrows
between representatives and all data at once, countably often, and taking the union, gives the
sub-presheaf at the representatives; its value at an arbitrary object is the span of the
restrictions of its values at representatives.

## Main definitions

* `Stacks.PresheafOfModules.closureFamily`: the countable closure of a family of submodules at
  the representatives under restriction, presentation and vanishing witnesses.
* `Stacks.PresheafOfModules.closureSubmodule`: the sub-presheaf of modules it generates.

## Main results

* `Stacks.PresheafOfModules.exists_list_eq_sum_of_isIso`: along an arrow over which `M` is
  cartesian, every section of the target is a finite combination of restrictions.
* `Stacks.PresheafOfModules.exists_fg_tensor_eq_zero_of_isIso`: along such an arrow, a finite sum
  of pure tensors whose image vanishes already vanishes over a finitely generated submodule.
* `Stacks.PresheafOfModules.mk_closure_le`: the closure of a family of submodules of cardinality
  at most `μ` has cardinality at most `μ`.
* `Stacks.PresheafOfModules.bijective_restrictionBaseChange_closureSubmodule_of_iso`: the
  sub-presheaf generated by the closure is cartesian along every arrow.
* `Stacks.PresheafOfModules.exists_small_cartesian_submodule`: every section of a cartesian
  presheaf of modules lies in a cartesian sub-presheaf of modules of cardinality at most `μ` at
  the representatives.

## References

* [Stacks Project, Tag 0781](https://stacks.math.columbia.edu/tag/0781)
* [Stacks Project, Tag 077K](https://stacks.math.columbia.edu/tag/077K)
-/

@[expose] public section

open CategoryTheory Opposite TensorProduct

universe u₁ u

namespace Stacks.PresheafOfModules

variable {C : Type u₁} [Category.{u} C] {R : Cᵒᵖ ⥤ CommRingCat.{u}}
  (M : PresheafOfModules.{u} (R ⋙ forget₂ CommRingCat RingCat))

omit [Category.{u} C] in
/-- Every element of a tensor product is a finite sum of pure tensors. -/
theorem exists_list_eq_sum_tmul {S T N : Type u} [CommRing S] [AddCommGroup T] [Module S T]
    [AddCommGroup N] [Module S N] (t : T ⊗[S] N) :
    ∃ L : List (T × N), t = (L.map fun p => p.1 ⊗ₜ[S] p.2).sum := by
  induction t using TensorProduct.induction_on with
  | zero => exact ⟨[], by simp⟩
  | tmul a n => exact ⟨[(a, n)], by simp⟩
  | add t t' ht ht' =>
    obtain ⟨L, rfl⟩ := ht
    obtain ⟨L', rfl⟩ := ht'
    exact ⟨L ++ L', by simp⟩

section Witnesses

variable {X Y : Cᵒᵖ} (g : X ⟶ Y)

/-- The sum `∑ bᵢ • g^*mᵢ` of the restrictions along `g` of a finite list of sections, weighted by
coefficients of the target. -/
noncomputable def restrictionSum (L : List (R.obj Y × M.obj X)) : M.obj Y :=
  (L.map fun p => p.1 • sectionMap M g p.2).sum

/-- The restriction sum of a concatenation is the sum of the restriction sums. -/
theorem restrictionSum_append (L L' : List (R.obj Y × M.obj X)) :
    restrictionSum M g (L ++ L') = restrictionSum M g L + restrictionSum M g L' := by
  simp [restrictionSum]

/-- **The base-change comparison of a finite sum of pure tensors** is the corresponding
combination of restrictions. -/
theorem exists_list_restrictionBaseChange_eq (t : (ModuleCat.extendScalars (R.map g).hom).obj
    (M.obj X)) :
    ∃ L : List (R.obj Y × M.obj X),
      (restrictionBaseChange.{u₁, u, u, u} M g).hom t = restrictionSum M g L := by
  induction t using TensorProduct.induction_on with
  | zero => exact ⟨[], (map_zero _).trans (by simp [restrictionSum])⟩
  | tmul a m =>
    exact ⟨[(a, m)], (restrictionBaseChange_tmul' M g a m).trans (by simp [restrictionSum])⟩
  | add t t' ht ht' =>
    obtain ⟨L, hL⟩ := ht
    obtain ⟨L', hL'⟩ := ht'
    exact ⟨L ++ L', (map_add _ t t').trans ((congrArg₂ (· + ·) hL hL').trans
      (restrictionSum_append M g L L').symm)⟩

/-- **Along an arrow over which `M` is cartesian, every section of the target is a finite
combination of restrictions of sections of the source.** -/
theorem exists_list_eq_sum_of_isIso [IsIso (restrictionBaseChange.{u₁, u, u, u} M g)]
    (x : M.obj Y) : ∃ L : List (R.obj Y × M.obj X), x = restrictionSum M g L := by
  obtain ⟨t, rfl⟩ := ((ConcreteCategory.isIso_iff_bijective
    (restrictionBaseChange.{u₁, u, u, u} M g)).1 inferInstance).2 x
  exact exists_list_restrictionBaseChange_eq M g t

/-- The coefficient ring of the target of `g`, as a module over the coefficient ring of the
source: the left factor of the base-change comparison along `g`. -/
noncomputable abbrev coeff : ModuleCat.{u} (R.obj X) :=
  (ModuleCat.restrictScalars (R.map g).hom).obj (ModuleCat.of (R.obj Y) (R.obj Y))

/-- The base-change comparison of a finite sum of pure tensors. -/
theorem restrictionBaseChange_sum_tmul (L : List (R.obj Y × M.obj X)) :
    (restrictionBaseChange.{u₁, u, u, u} M g).hom
        ((L.map fun p => (p.1 : coeff (R := R) g) ⊗ₜ[R.obj X] p.2).sum) =
      restrictionSum M g L := by
  induction L with
  | nil => exact (map_zero _).trans (by simp [restrictionSum])
  | cons p L ih =>
    have h2 : restrictionSum M g (p :: L) = p.1 • sectionMap M g p.2 + restrictionSum M g L := by
      simp [restrictionSum]
    rw [h2]
    refine (map_add _ _ _).trans (congrArg₂ (· + ·) ?_ ih)
    exact restrictionBaseChange_tmul' M g p.1 p.2

/-- The finite sum of pure tensors attached to a list of coefficients and sections of a
submodule. -/
noncomputable def tensorSum (N : Submodule (R.obj X) (M.obj X)) (L : List (R.obj Y × N)) :
    coeff (R := R) g ⊗[R.obj X] N :=
  (L.map fun p => (p.1 : coeff (R := R) g) ⊗ₜ[R.obj X] p.2).sum

/-- The sections of a submodule underlying a list of coefficients and sections. -/
abbrev listVal {N : Submodule (R.obj X) (M.obj X)} (L : List (R.obj Y × N)) :
    List (R.obj Y × M.obj X) :=
  L.map fun p => (p.1, (p.2 : M.obj X))

/-- Along an inclusion `N ≤ N'` of submodules, the image of `tensorSum M g N L` is the tensor sum
over `N'` of the included list. -/
theorem lTensor_tensorSum {N N' : Submodule (R.obj X) (M.obj X)} (h : N ≤ N')
    (L : List (R.obj Y × N)) :
    LinearMap.lTensor (coeff (R := R) g) (Submodule.inclusion h) (tensorSum M g N L) =
      tensorSum M g N' (L.map fun p => (p.1, Submodule.inclusion h p.2)) := by
  induction L with
  | nil => simp [tensorSum]
  | cons p L ih =>
    simp only [tensorSum, List.map_cons, List.sum_cons, map_add] at ih ⊢
    rw [ih]
    rfl

/-- `listVal` is injective. -/
theorem listVal_injective {N : Submodule (R.obj X) (M.obj X)} :
    Function.Injective (listVal M (Y := Y) (N := N)) := by
  refine List.map_injective_iff.2 ?_
  rintro ⟨a₁, a₂⟩ ⟨b₁, b₂⟩ h
  simp only [Prod.mk.injEq] at h
  rw [h.1, Subtype.ext h.2]

/-- Attaching membership proofs to a list of sections of a submodule and forgetting them again
gives back the list. -/
private theorem listVal_attach_map {A : Type u} (f : A → M.obj X)
    {N : Submodule (R.obj X) (M.obj X)} (L : List (R.obj Y × A)) (h : ∀ p ∈ L, f p.2 ∈ N) :
    listVal M (L.attach.map fun p => (p.1.1, (⟨f p.1.2, h p.1 p.2⟩ : N))) =
      L.map fun p => (p.1, f p.2) := by
  simp only [listVal, List.map_map]
  conv_rhs => rw [← List.attach_map_subtype_val L, List.map_map]
  rfl

/-- The base-change comparison of the image in `R(Y) ⊗ M(X)` of a sum of pure tensors over a
submodule is the corresponding combination of restrictions. -/
theorem restrictionBaseChange_lTensor_tensorSum (N : Submodule (R.obj X) (M.obj X))
    (L : List (R.obj Y × N)) :
    (restrictionBaseChange.{u₁, u, u, u} M g).hom
        (LinearMap.lTensor (coeff (R := R) g) N.subtype (tensorSum M g N L)) =
      restrictionSum M g (listVal M L) := by
  have h : LinearMap.lTensor (coeff (R := R) g) N.subtype (tensorSum M g N L) =
      ((listVal M L).map fun p => (p.1 : coeff (R := R) g) ⊗ₜ[R.obj X] p.2).sum := by
    simp only [tensorSum, map_list_sum, listVal, List.map_map, Function.comp_def]
    exact congrArg List.sum (List.map_congr_left fun p _ => LinearMap.lTensor_tmul _ _ _ _)
  rw [h]
  exact restrictionBaseChange_sum_tmul M g _

/-- **Vanishing over a finitely generated submodule.**  Along an arrow over which `M` is
cartesian, a finite combination of restrictions which vanishes comes from a sum of pure tensors
which already vanishes over a finitely generated submodule containing the sections involved, and
hence over every larger submodule. -/
theorem exists_fg_tensor_eq_zero_of_isIso [IsIso (restrictionBaseChange.{u₁, u, u, u} M g)]
    (L : List (R.obj Y × M.obj X)) (hL : restrictionSum M g L = 0) :
    ∃ Q : Submodule (R.obj X) (M.obj X), Q.FG ∧ (∀ p ∈ L, p.2 ∈ Q) ∧
      ∀ (N : Submodule (R.obj X) (M.obj X)), Q ≤ N → ∀ L' : List (R.obj Y × N),
        listVal M L' = L → tensorSum M g N L' = 0 := by
  classical
  let P : Submodule (R.obj X) (M.obj X) :=
    Submodule.span (R.obj X) {m | m ∈ L.map Prod.snd}
  have hPfg : P.FG := Submodule.fg_span (List.finite_toSet _)
  have hLP : ∀ p ∈ L, p.2 ∈ P := fun p hp =>
    Submodule.subset_span (List.mem_map.2 ⟨p, hp, rfl⟩)
  let L₀ : List (R.obj Y × P) := L.attach.map fun p => (p.1.1, ⟨p.1.2, hLP p.1 p.2⟩)
  have hL₀ : listVal M L₀ = L :=
    (listVal_attach_map M id L hLP).trans (by simp)
  let t₀ := tensorSum M g P L₀
  have h₁ : LinearMap.lTensor (coeff (R := R) g) P.subtype t₀ = 0 := by
    apply ((ConcreteCategory.isIso_iff_bijective
      (restrictionBaseChange.{u₁, u, u, u} M g)).1 inferInstance).1
    refine (restrictionBaseChange_lTensor_tensorSum M g P L₀).trans ?_
    rw [hL₀, hL]
    exact (map_zero _).symm
  let u₀ := TensorProduct.comm (R.obj X) (coeff (R := R) g) P t₀
  have h₂ : LinearMap.rTensor (coeff (R := R) g) P.subtype u₀ = 0 := by
    rw [LinearMap.rTensor_comm, h₁, map_zero]
  obtain ⟨Q, hPQ, hQ, hQ₀⟩ := TensorProduct.eq_zero_of_fg_of_subtype_eq_zero hPfg h₂
  refine ⟨Q, hQ, fun p hp => hPQ (hLP p hp), fun N hQN L' hL' => ?_⟩
  have hL'eq : L' = L₀.map fun p => (p.1, Submodule.inclusion (hPQ.trans hQN) p.2) := by
    apply listVal_injective M
    rw [hL', listVal, List.map_map]
    exact hL₀.symm
  rw [hL'eq, ← lTensor_tensorSum M g (hPQ.trans hQN) L₀]
  have h₃ : tensorSum M g P L₀ = TensorProduct.comm (R.obj X) P (coeff (R := R) g) u₀ := by
    simp [u₀, t₀]
  have h₄ : Submodule.inclusion (hPQ.trans hQN) =
      Submodule.inclusion hQN ∘ₗ Submodule.inclusion hPQ := by
    ext; rfl
  rw [h₃, LinearMap.lTensor_comm, h₄, LinearMap.rTensor_comp_apply, hQ₀, map_zero, map_zero]

end Witnesses

section Cardinal

open Cardinal

/-- A sigma type over an index of cardinality at most an infinite `μ`, with fibres of cardinality
at most `μ`, has cardinality at most `μ`. -/
theorem mk_sigma_le_of_le {α : Type u} {β : α → Type u} {μ : Cardinal.{u}} (hμ : ℵ₀ ≤ μ)
    (hα : #α ≤ μ) (hβ : ∀ a, #(β a) ≤ μ) : #(Σ a, β a) ≤ μ := by
  rw [mk_sigma]
  calc sum (fun a => #(β a)) ≤ sum (fun _ : α => μ) := sum_le_sum _ _ hβ
    _ = #α * μ := sum_const' α μ
    _ ≤ μ * μ := mul_le_mul_left hα μ
    _ = μ := mul_eq_self hμ

/-- A union indexed by a type of cardinality at most an infinite `μ`, of sets of cardinality at
most `μ`, has cardinality at most `μ`. -/
theorem mk_iUnion_le_of_le {α ι : Type u} {s : ι → Set α} {μ : Cardinal.{u}} (hμ : ℵ₀ ≤ μ)
    (hι : #ι ≤ μ) (hs : ∀ i, #(s i) ≤ μ) : #(⋃ i, s i) ≤ μ :=
  (mk_iUnion_le_sum_mk.trans (sum_le_sum _ _ hs)).trans
    ((sum_const' ι μ).le.trans ((mul_le_mul_left hι μ).trans (mul_eq_self hμ).le))

/-- A product of two types of cardinality at most an infinite `μ` has cardinality at most `μ`. -/
theorem mk_prod_le_of_le {α β : Type u} {μ : Cardinal.{u}} (hμ : ℵ₀ ≤ μ) (hα : #α ≤ μ)
    (hβ : #β ≤ μ) : #(α × β) ≤ μ := by
  rw [mk_prod, lift_id, lift_id]
  exact (mul_le_mul' hα hβ).trans (mul_eq_self hμ).le

/-- The span of a set of cardinality at most an infinite `μ`, over a ring of cardinality at most
`μ`, has cardinality at most `μ`: its elements are the values of finite lists of coefficients and
generators. -/
theorem mk_span_le_of_le {A N : Type u} [Ring A] [AddCommGroup N] [Module A N] {S : Set N}
    {μ : Cardinal.{u}} (hμ : ℵ₀ ≤ μ) (hA : #A ≤ μ) (hS : #S ≤ μ) :
    #(Submodule.span A S) ≤ μ := by
  let φ : List (A × S) → N := fun L => (L.map fun p => p.1 • (p.2 : N)).sum
  have hsmul : ∀ (a : A) (L : List (A × S)), φ (L.map fun p => (a * p.1, p.2)) = a • φ L := by
    intro a L
    induction L with
    | nil => simp [φ]
    | cons p L ih =>
      simp only [φ, List.map_cons, List.sum_cons] at ih ⊢
      rw [ih, mul_smul, smul_add]
  have hsub : ∀ x ∈ Submodule.span A S, x ∈ Set.range φ := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx => exact ⟨[(1, ⟨x, hx⟩)], by simp [φ]⟩
    | zero => exact ⟨[], by simp [φ]⟩
    | add x y _ _ hx hy =>
      obtain ⟨L, rfl⟩ := hx
      obtain ⟨L', rfl⟩ := hy
      exact ⟨L ++ L', by simp [φ]⟩
    | smul a x _ hx =>
      obtain ⟨L, rfl⟩ := hx
      exact ⟨L.map fun p => (a * p.1, p.2), hsmul a L⟩
  calc #(Submodule.span A S) ≤ #(Set.range φ) := mk_le_mk_of_subset hsub
    _ ≤ #(List (A × S)) := mk_range_le
    _ ≤ max ℵ₀ #(A × S) := mk_list_le_max _
    _ ≤ μ := max_le hμ (mk_prod_le_of_le hμ hA hS)

end Cardinal

section Closure

open Cardinal

variable (hM : ∀ {X Y : Cᵒᵖ} (g : X ⟶ Y), IsIso (restrictionBaseChange.{u₁, u, u, u} M g))
  {I : Type u} (r : I → Cᵒᵖ)

/-- A family of submodules of the values of `M` at the representatives. -/
abbrev Family := ∀ i : I, Submodule (R.obj (r i)) (M.obj (r i))

/-- A chosen presentation of a section of the target of `g` as a combination of restrictions. -/
noncomputable def surjWit {X Y : Cᵒᵖ} (g : X ⟶ Y) (x : M.obj Y) : List (R.obj Y × M.obj X) :=
  (haveI := hM g; exists_list_eq_sum_of_isIso M g x).choose

/-- A section of the target of `g` is the combination of restrictions given by `surjWit`. -/
theorem surjWit_spec {X Y : Cᵒᵖ} (g : X ⟶ Y) (x : M.obj Y) :
    x = restrictionSum M g (surjWit M hM g x) :=
  (have := hM g; exists_list_eq_sum_of_isIso M g x).choose_spec

/-- A chosen finitely generated submodule over which a vanishing combination of restrictions
already vanishes as a sum of pure tensors; `⊥` if the combination does not vanish. -/
noncomputable def vanWit {X Y : Cᵒᵖ} (g : X ⟶ Y) (L : List (R.obj Y × M.obj X)) :
    Submodule (R.obj X) (M.obj X) := by
  classical
  exact if h : restrictionSum M g L = 0 then
    (haveI := hM g; exists_fg_tensor_eq_zero_of_isIso M g L h).choose else ⊥

/-- The submodule `vanWit M hM g L` is finitely generated. -/
theorem vanWit_fg {X Y : Cᵒᵖ} (g : X ⟶ Y) (L : List (R.obj Y × M.obj X)) :
    (vanWit M hM g L).FG := by
  classical
  unfold vanWit
  split_ifs with h
  · exact (have := hM g; exists_fg_tensor_eq_zero_of_isIso M g L h).choose_spec.1
  · exact Submodule.fg_bot

/-- If the combination of restrictions of `L` vanishes, then the corresponding sum of pure tensors
vanishes over every submodule containing `vanWit M hM g L`. -/
theorem vanWit_spec {X Y : Cᵒᵖ} (g : X ⟶ Y) (L : List (R.obj Y × M.obj X))
    (h : restrictionSum M g L = 0) (N : Submodule (R.obj X) (M.obj X))
    (hN : vanWit M hM g L ≤ N) (L' : List (R.obj Y × N)) (hL' : listVal M L' = L) :
    tensorSum M g N L' = 0 := by
  classical
  have hspec := (have := hM g; exists_fg_tensor_eq_zero_of_isIso M g L h).choose_spec
  have hv : vanWit M hM g L =
      (have := hM g; exists_fg_tensor_eq_zero_of_isIso M g L h).choose := by
    unfold vanWit
    rw [dif_pos h]
  exact hspec.2.2 N (hv ▸ hN) L' hL'

/-- The sections added at one stage of the closure at the representative `i`: restrictions of
the sections at all representatives, the coefficients of the chosen presentations of the
sections at all representatives along all arrows out of `i`, and the generators of the chosen
finitely generated submodules along all arrows out of `i`. -/
def gens (P : Family M r) (i : I) : Set (M.obj (r i)) :=
  Set.range (fun q : (Σ j : I, (r j ⟶ r i) × P j) => sectionMap M q.2.1 q.2.2) ∪
    (⋃ q : (Σ j : I, (r i ⟶ r j) × P j),
      {m | m ∈ (surjWit M hM q.2.1 (q.2.2 : M.obj (r q.1))).map Prod.snd}) ∪
    ⋃ q : (Σ j : I, (r i ⟶ r j) × List (R.obj (r j) × P i)),
      (vanWit M hM q.2.1 (listVal M q.2.2) : Set (M.obj (r i)))

/-- One stage of the closure. -/
def step (P : Family M r) : Family M r := fun i => P i ⊔ Submodule.span _ (gens M hM r P i)

/-- The stages of the closure of an initial family. -/
def stage (P₀ : Family M r) : ℕ → Family M r
  | 0 => P₀
  | n + 1 => step M hM r (stage P₀ n)

/-- The closure of an initial family: the union of its stages. -/
def closureFamily (P₀ : Family M r) : Family M r := fun i => ⨆ n, stage M hM r P₀ n i

variable (P₀ : Family M r)

/-- Each stage of the closure is contained in the next. -/
theorem stage_le_succ (n : ℕ) (i : I) : stage M hM r P₀ n i ≤ stage M hM r P₀ (n + 1) i :=
  le_sup_left

/-- The stages of the closure form an increasing sequence of submodules. -/
theorem stage_mono (i : I) : Monotone fun n => stage M hM r P₀ n i :=
  monotone_nat_of_le_succ fun n => stage_le_succ M hM r P₀ n i

/-- Each stage is contained in the closure. -/
theorem stage_le_closure (n : ℕ) (i : I) : stage M hM r P₀ n i ≤ closureFamily M hM r P₀ i :=
  le_iSup (fun n => stage M hM r P₀ n i) n

/-- A section lies in the closure if and only if it lies in some stage. -/
theorem mem_closure_iff (i : I) (x : M.obj (r i)) :
    x ∈ closureFamily M hM r P₀ i ↔ ∃ n, x ∈ stage M hM r P₀ n i :=
  Submodule.mem_iSup_of_directed _ (stage_mono M hM r P₀ i).directed_le

/-- The sections added at stage `n` lie in stage `n + 1`. -/
theorem gens_le_succ (n : ℕ) (i : I) :
    gens M hM r (stage M hM r P₀ n) i ⊆ stage M hM r P₀ (n + 1) i :=
  fun _ hm => (le_sup_right : _ ≤ step M hM r (stage M hM r P₀ n) i)
    (Submodule.subset_span hm)

/-- Every finite list of sections of the closure lies in one stage. -/
theorem exists_stage_of_list (i : I) {β : Type*} (L : List (β × closureFamily M hM r P₀ i)) :
    ∃ n, ∀ p ∈ L, (p.2 : M.obj (r i)) ∈ stage M hM r P₀ n i := by
  induction L with
  | nil => exact ⟨0, by simp⟩
  | cons p L ih =>
    obtain ⟨n, hn⟩ := ih
    obtain ⟨m, hm⟩ := (mem_closure_iff M hM r P₀ i _).1 p.2.2
    refine ⟨max n m, fun q hq => ?_⟩
    rcases List.mem_cons.1 hq with rfl | hq
    · exact stage_mono M hM r P₀ i (le_max_right n m) hm
    · exact stage_mono M hM r P₀ i (le_max_left n m) (hn q hq)

/-- The sections added at stage `n` lie in the closure. -/
private theorem gens_subset_closure (n : ℕ) (i : I) :
    gens M hM r (stage M hM r P₀ n) i ⊆ closureFamily M hM r P₀ i :=
  fun _ hm => stage_le_closure M hM r P₀ (n + 1) i (gens_le_succ M hM r P₀ n i hm)

/-- **The closure is stable under restriction** along the arrows between representatives. -/
theorem sectionMap_mem_closure {i j : I} (g : r j ⟶ r i) {x : M.obj (r j)}
    (hx : x ∈ closureFamily M hM r P₀ j) : sectionMap M g x ∈ closureFamily M hM r P₀ i := by
  obtain ⟨n, hn⟩ := (mem_closure_iff M hM r P₀ j x).1 hx
  exact gens_subset_closure M hM r P₀ n i (Or.inl (Or.inl ⟨⟨j, g, ⟨x, hn⟩⟩, rfl⟩))

/-- **Every section of the closure is a combination of restrictions of sections of the closure**,
along every arrow between representatives. -/
theorem exists_list_closure {i j : I} (g : r i ⟶ r j) {x : M.obj (r j)}
    (hx : x ∈ closureFamily M hM r P₀ j) :
    ∃ L : List (R.obj (r j) × M.obj (r i)), (∀ p ∈ L, p.2 ∈ closureFamily M hM r P₀ i) ∧
      x = restrictionSum M g L := by
  obtain ⟨n, hn⟩ := (mem_closure_iff M hM r P₀ j x).1 hx
  refine ⟨surjWit M hM g x, fun p hp => ?_, surjWit_spec M hM g x⟩
  exact gens_subset_closure M hM r P₀ n i
    (Or.inl (Or.inr (Set.mem_iUnion.2 ⟨⟨j, g, ⟨x, hn⟩⟩, List.mem_map.2 ⟨p, hp, rfl⟩⟩)))

/-- **A vanishing combination of restrictions of sections of the closure already vanishes in the
tensor product over the closure**, along every arrow between representatives. -/
theorem tensorSum_closure_eq_zero {i j : I} (g : r i ⟶ r j)
    (L : List (R.obj (r j) × closureFamily M hM r P₀ i))
    (hL : restrictionSum M g (listVal M L) = 0) :
    tensorSum M g (closureFamily M hM r P₀ i) L = 0 := by
  obtain ⟨n, hn⟩ := exists_stage_of_list M hM r P₀ i L
  let Lₙ : List (R.obj (r j) × stage M hM r P₀ n i) :=
    L.attach.map fun p => (p.1.1, ⟨p.1.2, hn p.1 p.2⟩)
  have hLₙ : listVal M Lₙ = listVal M L := listVal_attach_map M Subtype.val L hn
  refine vanWit_spec M hM g (listVal M Lₙ) (hLₙ ▸ hL) _ (fun m hm => ?_) L hLₙ.symm
  exact gens_subset_closure M hM r P₀ n i (Or.inr (Set.mem_iUnion.2 ⟨⟨j, g, Lₙ⟩, hm⟩))

section Bound

variable {μ : Cardinal.{u}} (hμ : ℵ₀ ≤ μ) (hI : #I ≤ μ) (hR : ∀ i, #(R.obj (r i)) ≤ μ)
  (hHom : ∀ i j, #(r i ⟶ r j) ≤ μ)
include hμ hI hR hHom

/-- If a family has values of cardinality at most `μ`, then so do the sections added to it at one
stage. -/
theorem mk_gens_le (P : Family M r) (hP : ∀ i, #(P i) ≤ μ) (i : I) :
    #(gens M hM r P i) ≤ μ := by
  have hfin : ∀ {α : Type u} (L : List α), #{a | a ∈ L} ≤ μ := fun L =>
    (mk_le_aleph0_iff.2 (List.finite_toSet L).countable).trans hμ
  have h1 : #(Set.range (fun q : (Σ j : I, (r j ⟶ r i) × P j) => sectionMap M q.2.1 q.2.2)) ≤
      μ :=
    mk_range_le.trans (mk_sigma_le_of_le hμ hI fun j => mk_prod_le_of_le hμ (hHom j i) (hP j))
  have h2 : #(⋃ q : (Σ j : I, (r i ⟶ r j) × P j),
      {m | m ∈ (surjWit M hM q.2.1 (q.2.2 : M.obj (r q.1))).map Prod.snd}) ≤ μ :=
    mk_iUnion_le_of_le hμ (mk_sigma_le_of_le hμ hI fun j => mk_prod_le_of_le hμ (hHom i j) (hP j))
      fun _ => hfin _
  have h3 : #(⋃ q : (Σ j : I, (r i ⟶ r j) × List (R.obj (r j) × P i)),
      (vanWit M hM q.2.1 (listVal M q.2.2) : Set (M.obj (r i)))) ≤ μ := by
    refine mk_iUnion_le_of_le hμ (mk_sigma_le_of_le hμ hI fun j => ?_) fun q => ?_
    · refine mk_prod_le_of_le hμ (hHom i j) ((mk_list_le_max _).trans ?_)
      exact max_le hμ (mk_prod_le_of_le hμ (hR j) (hP i))
    · obtain ⟨S, hS⟩ := vanWit_fg M hM q.2.1 (listVal M q.2.2)
      show #(vanWit M hM q.2.1 (listVal M q.2.2) : Set (M.obj (r i))) ≤ μ
      rw [← hS]
      refine mk_span_le_of_le hμ (hR i) ((mk_le_mk_of_subset fun x hx => ?_).trans
        (hfin S.toList))
      simpa using hx
  refine (mk_union_le _ _).trans ((add_le_add ((mk_union_le _ _).trans
    (add_le_add h1 h2)) h3).trans ?_)
  rw [add_eq_self hμ, add_eq_self hμ]

/-- If the initial family has values of cardinality at most `μ`, then so does every stage. -/
theorem mk_stage_le (hP₀ : ∀ i, #(P₀ i) ≤ μ) (n : ℕ) (i : I) :
    #(stage M hM r P₀ n i) ≤ μ := by
  induction n generalizing i with
  | zero => exact hP₀ i
  | succ n ih =>
    have heq : stage M hM r P₀ (n + 1) i = Submodule.span (R.obj (r i))
        ((stage M hM r P₀ n i : Set (M.obj (r i))) ∪ gens M hM r (stage M hM r P₀ n) i) := by
      rw [Submodule.span_union, Submodule.span_eq]
      rfl
    rw [heq]
    exact mk_span_le_of_le hμ (hR i) ((mk_union_le _ _).trans
      ((add_le_add (ih i) (mk_gens_le M hM r hμ hI hR hHom _ ih i)).trans (add_eq_self hμ).le))

/-- If the initial family has values of cardinality at most `μ`, then so does its closure. -/
theorem mk_closure_le (hP₀ : ∀ i, #(P₀ i) ≤ μ) (i : I) :
    #(closureFamily M hM r P₀ i) ≤ μ := by
  have : (closureFamily M hM r P₀ i : Set (M.obj (r i))) =
      ⋃ n : ULift.{u} ℕ, (stage M hM r P₀ n.down i : Set (M.obj (r i))) := by
    ext x
    simp only [SetLike.mem_coe, Set.mem_iUnion]
    rw [mem_closure_iff]
    exact ⟨fun ⟨n, h⟩ => ⟨⟨n⟩, h⟩, fun ⟨n, h⟩ => ⟨n.down, h⟩⟩
  show #(closureFamily M hM r P₀ i : Set (M.obj (r i))) ≤ μ
  rw [this]
  exact mk_iUnion_le_of_le hμ ((mk_le_aleph0_iff.2 inferInstance).trans hμ) fun n =>
    mk_stage_le M hM r P₀ hμ hI hR hHom hP₀ n.down i

end Bound

section Subpresheaf

variable (P₀ : Family M r)

/-- **The sub-presheaf generated by the closure**: at an object `X`, the span of the restrictions
to `X` of the sections of the closure at all representatives. -/
def closureSubmodule : M.Submodule where
  obj X := Submodule.span _ {x | ∃ (i : I) (g : r i ⟶ X) (k : closureFamily M hM r P₀ i),
    x = sectionMap M g (k : M.obj (r i))}
  map {X Y} f := by
    refine Submodule.span_le.2 ?_
    rintro x ⟨i, g, k, rfl⟩
    refine Submodule.subset_span ⟨i, g ≫ f, k, ?_⟩
    exact sectionMap_comp M g f (k : M.obj (r i))

/-- A section of the closure at a representative lies in the sub-presheaf it generates. -/
theorem mem_closureSubmodule_of_mem {i : I} {x : M.obj (r i)}
    (hx : x ∈ closureFamily M hM r P₀ i) : x ∈ (closureSubmodule M hM r P₀).obj (r i) :=
  Submodule.subset_span ⟨i, 𝟙 _, ⟨x, hx⟩, (sectionMap_id M x).symm⟩

/-- At a representative, the sub-presheaf generated by the closure is contained in the closure. -/
theorem closureSubmodule_obj_le (i : I) :
    (closureSubmodule M hM r P₀).obj (r i) ≤ closureFamily M hM r P₀ i := by
  refine Submodule.span_le.2 ?_
  rintro x ⟨j, g, k, rfl⟩
  exact sectionMap_mem_closure M hM r P₀ g k.2

/-- At a representative, the sub-presheaf generated by the closure is the closure. -/
theorem closureSubmodule_obj_eq (i : I) :
    (closureSubmodule M hM r P₀).obj (r i) = closureFamily M hM r P₀ i :=
  le_antisymm (closureSubmodule_obj_le M hM r P₀ i)
    fun _ hx => mem_closureSubmodule_of_mem M hM r P₀ hx

/-- The value of a combination of restrictions in a sub-presheaf, computed in the ambient
presheaf. -/
theorem restrictionSum_toPresheafOfModules_val (K : M.Submodule) {X Y : Cᵒᵖ} (g : X ⟶ Y)
    (L : List (R.obj Y × K.toPresheafOfModules.obj X)) :
    (show K.obj Y from restrictionSum K.toPresheafOfModules g L).1 =
      restrictionSum M g (L.map fun p => (p.1, (show K.obj X from p.2).1)) := by
  induction L with
  | nil => rfl
  | cons p L ih => exact congrArg₂ (· + ·) rfl ih

/-- **The sub-presheaf generated by the closure is cartesian along the arrows between
representatives.** -/
theorem bijective_restrictionBaseChange_closureSubmodule {i j : I} (g : r i ⟶ r j) :
    Function.Bijective (restrictionBaseChange.{u₁, u, u, u}
      (closureSubmodule M hM r P₀).toPresheafOfModules g) := by
  set K := closureSubmodule M hM r P₀
  have heq := closureSubmodule_obj_eq M hM r P₀ i
  constructor
  · refine (injective_iff_map_eq_zero (restrictionBaseChange.{u₁, u, u, u}
      K.toPresheafOfModules g).hom).2 fun t ht => ?_
    obtain ⟨L, rfl⟩ := exists_list_eq_sum_tmul (S := R.obj (r i)) (T := coeff (R := R) g)
      (N := K.toPresheafOfModules.obj (r i)) t
    have h1 : restrictionSum K.toPresheafOfModules g L = 0 :=
      (restrictionBaseChange_sum_tmul K.toPresheafOfModules g L).symm.trans ht
    have h2 := (restrictionSum_toPresheafOfModules_val M K g L).symm.trans
      (congrArg (fun z : K.obj (r j) => (z : M.obj (r j))) h1)
    let L'' : List (R.obj (r j) × closureFamily M hM r P₀ i) :=
      L.map fun p => (p.1, Submodule.inclusion heq.le p.2)
    have h3 : tensorSum M g _ L'' = 0 :=
      tensorSum_closure_eq_zero M hM r P₀ g L'' (by
        refine Eq.trans ?_ h2
        simp only [L'', listVal, List.map_map]
        rfl)
    have hLL : (L''.map fun p => (p.1, Submodule.inclusion heq.ge p.2)) = L := by
      simp only [L'', List.map_map]
      conv_rhs => rw [← List.map_id L]
      rfl
    have h4 := lTensor_tensorSum M g heq.ge L''
    rw [hLL, h3, map_zero] at h4
    exact h4.symm
  · intro y
    obtain ⟨L, hLmem, hL⟩ := exists_list_closure M hM r P₀ g
      ((closureSubmodule_obj_le M hM r P₀ j) y.2)
    let L' : List (R.obj (r j) × K.toPresheafOfModules.obj (r i)) :=
      L.attach.map fun p => (p.1.1, (⟨p.1.2, heq.ge (hLmem p.1 p.2)⟩ : K.obj (r i)))
    refine ⟨(L'.map fun p => (p.1 : coeff (R := R) g) ⊗ₜ[R.obj (r i)] p.2).sum, ?_⟩
    refine (restrictionBaseChange_sum_tmul K.toPresheafOfModules g L').trans ?_
    apply Subtype.ext
    refine (restrictionSum_toPresheafOfModules_val M K g L').trans ?_
    refine Eq.trans ?_ hL.symm
    congr 1
    exact (listVal_attach_map M id L fun p hp => heq.ge (hLmem p hp)).trans (by simp)

/-- **The sub-presheaf generated by the closure is cartesian**, along every arrow, as soon as the
representatives meet every isomorphism class. -/
theorem bijective_restrictionBaseChange_closureSubmodule_of_iso
    (hr : ∀ X : Cᵒᵖ, ∃ i, Nonempty (r i ≅ X)) {X Y : Cᵒᵖ} (g : X ⟶ Y) :
    Function.Bijective (restrictionBaseChange.{u₁, u, u, u}
      (closureSubmodule M hM r P₀).toPresheafOfModules g) := by
  obtain ⟨i, ⟨eX⟩⟩ := hr X
  obtain ⟨j, ⟨eY⟩⟩ := hr Y
  exact (bijective_restrictionBaseChange_iff_of_arrowIso
    (closureSubmodule M hM r P₀).toPresheafOfModules (eX.hom ≫ g ≫ eY.inv) g eX.hom eY.hom
    (by simp)).1 (bijective_restrictionBaseChange_closureSubmodule M hM r P₀ _)

end Subpresheaf

include hM in
/-- **Every section of a cartesian presheaf of modules lies in a small cartesian sub-presheaf.**
Let `M` be cartesian along every arrow, and let `r : I → Cᵒᵖ` be a family of representatives
meeting every isomorphism class, with `μ` an infinite cardinal bounding the number of
representatives, the coefficient rings at the representatives, and the arrows between them.
Then every section of `M` at a representative lies in a sub-presheaf of modules `K ⊆ M` which is
again cartesian along every arrow and whose values at the representatives have cardinality at
most `μ`. -/
theorem exists_small_cartesian_submodule (hr : ∀ X : Cᵒᵖ, ∃ i, Nonempty (r i ≅ X))
    {μ : Cardinal.{u}} (hμ : ℵ₀ ≤ μ) (hI : #I ≤ μ) (hR : ∀ i, #(R.obj (r i)) ≤ μ)
    (hHom : ∀ i j, #(r i ⟶ r j) ≤ μ) (i₀ : I) (s : M.obj (r i₀)) :
    ∃ K : M.Submodule, s ∈ K.obj (r i₀) ∧ (∀ i, #(K.obj (r i)) ≤ μ) ∧
      ∀ {X Y : Cᵒᵖ} (g : X ⟶ Y),
        IsIso (restrictionBaseChange.{u₁, u, u, u} K.toPresheafOfModules g) := by
  classical
  let P₀ : Family M r := Function.update (fun _ => ⊥) i₀ (Submodule.span _ {s})
  have hP₀ : ∀ i, #(P₀ i) ≤ μ := by
    intro i
    by_cases h : i = i₀
    · subst h
      simp only [P₀, Function.update_self]
      exact mk_span_le_of_le hμ (hR i) ((mk_singleton s).le.trans (one_le_aleph0.trans hμ))
    · simp only [P₀, Function.update_of_ne h]
      exact (mk_le_one_iff_set_subsingleton.2 (by simp)).trans (one_le_aleph0.trans hμ)
  refine ⟨closureSubmodule M hM r P₀, ?_, fun i => ?_, fun g => ?_⟩
  · refine mem_closureSubmodule_of_mem M hM r P₀ (stage_le_closure M hM r P₀ 0 i₀ ?_)
    show s ∈ P₀ i₀
    simp only [P₀, Function.update_self]
    exact Submodule.subset_span rfl
  · rw [closureSubmodule_obj_eq]
    exact mk_closure_le M hM r P₀ hμ hI hR hHom hP₀ i
  · exact (ConcreteCategory.isIso_iff_bijective _).2
      (bijective_restrictionBaseChange_closureSubmodule_of_iso M hM r P₀ hr g)

end Closure

end Stacks.PresheafOfModules

